	file.0000000000000001.title: "&dSUBLIME&r",
	quest.0022039254A619AF.title: "stal",
	quest.018617A825529B98.quest_desc: ["A quick snack made with Sea Grass."],
	quest.02EEDAA7A8F99A1F.title: "chirp",
	quest.031183625E446959.quest_desc: [
		"THe Hero's Medallion stores experience for you.",
		"",
		"Right-Clicking reclaims the levels.",
		"",
		"Shift + Right-Clicking toggles auto absorbtion."
	],
	quest.038888DA99DA0045.quest_desc: [
		"The Crimson Pinewood is a denser version of the regular Crimson Forest.",
		"",
		"Wall Moss and Warts cover the floor and wall surfaces."
	],
	quest.03FAF745AF18EBC7.quest_desc: [
		"Arcane Lanterns adds magical lanterns with special powers and effects!",
		"",
		"To begin, craft a Lantern Maker and place the proper catalysts on it by right-clicking.",
		"",
		"Once all the catalysts are present, place a lantern on top of the Lantern Maker!"
	],
	quest.040A122866A75B6E.quest_desc: [
		"THe Serpent Staff causes slowness to mobs around you, makes mobs ignore you, and can throw slime balls that poison enemies hit.",
		"",
		"It can also drain life from an enemy that is hit."
	],
	quest.042E8502901FA625.quest_desc: [
		"The Infernal Claw will absorb fire damage at the cost of hunger.",
		"",
		"This does not apply to lava."
	],
	quest.043F16B5E5DDE024.quest_desc: [
		"The Nether Jungle is home to a host of new flora.",
		"",
		"In this case, the floor is poison, not lava.",
		"",
		"2 new complete wood sets can be found here."
	],
	quest.05003E4DE713D28D.quest_desc: ["An open overhead canopy."],
	quest.0513D028F1FCCF67.title: "Precipice",
	quest.069356452F5C793A.quest_desc: [
		"Worms, Minnows, and Leeches can be used as bait.",
		"",
		"Bait increases the chance of catching fish."
	],
	quest.069356452F5C793A.title: "Bait",
	quest.06B7DD78CCFB602E.quest_desc: [
		"The Ender Staff allows you to teleport in various ways using Ender Pearls as fuel.",
		"",
		"Shift + Right-Clicking set the staff to auto absord Ender Pearls. Shift + mouse wheel changes modes.",
		"",
		"Pearl Mode throws an Ender Pearl like normal.",
		"",
		"Eye Mode throws an Ender Pearl in a straight line with no fall off.",
		"",
		"Wraith Mode allows you to teleport to a Node."
	],
	quest.06E5D2DC90CDF14E.quest_desc: ["2x base storage value for the drawer."],
	quest.0850840BBAE4FDC0.quest_desc: [
		"A wide assortment of burgers and sides are available to craft through The Burger Mod!",
		"",
		"These are the ones made with beef."
	],
	quest.0850840BBAE4FDC0.title: "Beef Burgers",
	quest.085A3D92D054294C.quest_desc: ["Shimmerweave Fabric is crafted by right-clicking with Woven Leather on a filled Glacial Basin."],
	quest.08BF7BFEE44BFCEB.quest_desc: [
		"Locate a Trial Chamber to test your might against various mobs!",
		"",
		"Use keys to unlock vaults for special rewards.",
		"",
		"Want a tougher challenge with better rewards?",
		"",
		"Take on Ominous Trials by entering with the Bad Omen effect."
	],
	quest.09074A0668C0A629.quest_desc: ["The Gender Bone is used to change the gender of your pup."],
	quest.09925DD2236E7CE5.quest_desc: [
		"Bliss shaders are included with Sublime.",
		"",
		"It is highly recommended to play with shaders enabled, if possible."
	],
	quest.09B65F1B9C13F0C4.quest_desc: ["The Interdiction Torch is a light source that forcefully repels all mobs from its area."],
	quest.0AD56074644EC3D0.quest_desc: ["256x base storage value for the drawer."],
	quest.0AF1580B30A50EA5.quest_desc: [
		"In Sublime, you can have jobs to received bonuses and buffs!",
		"",
		"Press J to bring up the selection menu.",
		"",
		"You can start with 2 jobs for free.",
		"",
		"Mastering jobs will unlock special items to utilize."
	],
	quest.0BA65D0C8332AB8C.quest_desc: [
		"The End Stone Smelter is used to blast ores with increased return!",
		"",
		"It is also used to create different metal alloys!"
	],
	quest.0C02D9B6E4872336.quest_desc: [
		"The Glowing Grasslands are covered in flora including the Lumecorn.",
		"",
		"Lumecorn can be utilized to make decorative lighting."
	],
	quest.0C649F18D0221ABA.quest_desc: ["I'll take the Turtle Soup and make it snappy."],
	quest.0CCCA200AF3D4FDD.quest_desc: [
		"Aeternium Ingots are an alloy created in the End Stone Smelter combining a Terminite Ingot and a Netherite Ingot.",
		"",
		"Terminite Armor can be upgraded in a Smithing table with an Aeternium Ingot and Smithing Template."
	],
	quest.0CED719FD568A4ED.quest_desc: [
		"Tarot Cards are found in loot chests across all dimensions.",
		"",
		"The Tarot Deck will store all of the Tarot Cards you find into one Curios slot.",
		"",
		"You can enable and disable a Tarot Card by holding it and right-clicking."
	],
	quest.0CED719FD568A4ED.title: "Tarot Cards",
	quest.0D55B74F6CD0E720.title: "far",
	quest.0D717A9B6B59721E.quest_desc: [
		"The Crafting Terminal allows you to see, add, and remove all the items connected to the Inventory Connector.",
		"",
		"It also includes a crafting grid."
	],
	quest.0DC2CCC3FDDB95E6.quest_desc: [
		"An Elytra can be upgraded into an Armored Elytra.",
		"",
		"Use a Smithing Table to combine an Elytra, Aeternium Ingot, and Aeternium Smithing Template."
	],
	quest.0E1D03129CEC7DB6.quest_desc: ["The Crimson Glowing Forest is very bright and golden compared to the other crimson biomes."],
	quest.0FA7B6336EF4FB25.quest_desc: ["Inventory Cables are used to connect inventories over long distances to the Inventory Connector."],
	quest.0FB38D6CD15EFAC5.quest_desc: [
		"A portable take on the classic.",
		"",
		"The Pocket Jukebox can play discs and albums from your inventory!"
	],
	quest.100C6710EFE77F53.quest_desc: ["Enclosed tent with a door."],
	quest.10CAB4D384CF3306.quest_desc: [
		"In order to make Aeternium tools and armor, a Aeternium Anvil is required!",
		"",
		"The anvil functions the same except an Aeternium Smithing Template is required.",
		"",
		"Aeternium has stronger stats than Netherite."
	],
	quest.1123329C32D898E8.quest_desc: [
		"The Infernal Tear converts items into experience.",
		"",
		"Shift + Right-Clicking will have the tear absorb the item you have the most of and convert them into experience.",
		"",
		"JEI can show the conversion rates."
	],
	quest.11367DD1E8C921E7.quest_subtitle: "Better End",
	quest.11367DD1E8C921E7.title: "Eo Dracona",
	quest.11FFF7EB44E7A593.quest_desc: [
		"A Warp Plate is used to teleport to another specific Warp Plate.",
		"",
		"When placed, the Warp Plate will generate an Attuned Shard.",
		"",
		"Swap the 2 Attuned Shards between Warp Plates for 2-way travel.",
		"",
		"Warp Plates work interdimensionally.",
		"",
		"They also teleport mobs."
	],
	quest.12BC9DD3638FE800.quest_desc: [
		"The Rod of Lyssa, when cast, will gather all items in an area.",
		"",
		"When reeled in, it will pull all those items to you.",
		"",
		"You can also use this to disarm enemies by holding shift when casting."
	],
	quest.13684D2080C422B4.quest_desc: ["The Nether Mushroom Forest is covered in new types of mild, fungi, and mushrooms."],
	quest.149640D86AB45960.quest_desc: [
		"The Crystal Mountains are a breathtaking biome covered in Crystal Moss and giant crystal nodes.",
		"",
		"Harvesting the crystal nodes yield Aurora Crystal Shards that have a multitude of uses."
	],
	quest.14C2D13EE4F19190.quest_desc: [
		"The Inventory Configurator allows you to configure how chests interact with the Inventory Connector.",
		"",
		"It will also show you painted blocks."
	],
	quest.1593BF21FC8238EF.quest_desc: [
		"Special Reliquary component that has a small chance to drop when killing a slime.",
		"",
		"They also have a small chance to be found in loot chests."
	],
	quest.15D7BD4FB11AB610.quest_desc: [
		"Kill the Iceologer.",
		"",
		"He hides in a small cabin deep in snowy biomes."
	],
	quest.160FB7205F8D517A.quest_desc: ["You have the freedom to place fences, walls, and windows diagonally!"],
	quest.16307C5EC56614E2.quest_desc: [
		"The Reinforced Hang Glider allows you to float slowly through the air.",
		"",
		"It has almost triple the durability of the basic Hang Glider."
	],
	quest.16437E2307E01EAE.quest_desc: [
		"Ah, the good ol' days!",
		"",
		"Brutes, Piglins, and Hoglins all await your arrival.",
		"",
		"Just don't touch anything. They hate that."
	],
	quest.171E27287A928D42.quest_desc: [
		"The Altar of Light will grow a Glowstone Block when provided with 3 Redstone Dust.",
		"",
		"While it does take an extended period of time to grow the Glowstone Block, it is a way to get glowstone without going to the Nether."
	],
	quest.1791C1060D2914EF.quest_subtitle: "BetterEnd",
	quest.1791C1060D2914EF.title: "Grasping at Stars",
	quest.187098F9501AFBAF.title: "13",
	quest.18F244E3A6AFF803.quest_desc: [
		"The Dry Shrubland has a floor covered in plant life and small Lucernia Tree.",
		"",
		"Lucernia has a complete wood set."
	],
	quest.19030FEE06A43388.quest_desc: [
		"The classic.",
		"",
		"Plays music discs and albums."
	],
	quest.1935F033F028AE2E.quest_desc: [
		"The Whistle is used to give your pup different commands.",
		"",
		"Shift + Right-Clicking will open the menu and list the commands."
	],
	quest.1A0AD3B7EB78D5E4.quest_desc: [
		"Floral Enchantment adds Flower Bushes and Flower Vines for each flower in Minecraft.",
		"",
		"It also adds different pots, baskets, and even Flower Crowns."
	],
	quest.1AC3CB471DA943D1.quest_desc: [
		"The Lantern Woods are covered in a reddish vegetation and moss.",
		"",
		"The large Lucernia Trees grow Filalux which can be turned into a lantern block."
	],
	quest.1B824FFEF93E8F90.quest_desc: [
		"The Advanced Magnet will draw in items and XP within a 11 blocks radius.",
		"",
		"It can also utilize a filter."
	],
	quest.1B85AE4FB1684062.quest_desc: ["Terminite Ingots are an alloy created in the End Stone Smelter combining an Iron Ingot and Ender Dust."],
	quest.1C06D1D7513EA844.quest_desc: [
		"Consult the Wildex for taming information.",
		"",
		"Prairie Dogs will bark to alert the player to threats.",
		"",
		"They can also dig random items out of the ground."
	],
	quest.1C09EA37B3B2FAAC.title: "ward",
	quest.1C35323503A73652.quest_desc: [
		"Gowling Water does damage to undead enemies.",
		"",
		"It is thrown like a splash potion."
	],
	quest.1C3BE04B7C93195A.quest_desc: [
		"Magma Land is covered with magma blocks, red sand, and lava as the floor.",
		"",
		"Magma Flowers and Blue Obsidian also generate here."
	],
	quest.1C52130D7B3D7555.quest_desc: ["The Hang Glider allows you to float slowly through the air."],
	quest.1D7EB5D696221946.quest_desc: [
		"The Energizer Stick provides your pup with the following: ",
		"",
		"- Glowing (5s)",
		"- Speed VII (10s)",
		"- Regeneration III (5s)"
	],
	quest.1DF7AE2AB8DBDBFA.quest_desc: [
		"Aphrodite's Serum makes animals breed.",
		"",
		"It is thrown like a splash potion."
	],
	quest.1F37C54A978CAF54.quest_desc: [
		"A wide assortment of burgers and sides are available to craft through The Burger Mod!",
		"",
		"These are the ones made with cod."
	],
	quest.1F37C54A978CAF54.title: "Cod Burgers",
	quest.2008101F77ACB001.quest_desc: [
		"Visit the golden glow of the Amber Lands!",
		"",
		"Helix Trees can be found here and have a complete wood set.",
		"",
		"You can also mine Amber Ore here."
	],
	quest.200C285AFB47F915.quest_desc: [
		"In order to make Terminite tools and armor, a Terminite Anvil is required!",
		"",
		"The anvils function the same except a Terminite Smithing Template is required.",
		"",
		"Terminite has stats similar to Diamond."
	],
	quest.201AC918FE9DBE5C.quest_desc: [
		"The Unbound Scroll is used to teleport to a specific Waystone.",
		"",
		"Right-Click a Waystone with the scroll to bind it.",
		"",
		"The scroll is consumed on use."
	],
	quest.209DAD58F8DBEBDE.quest_desc: [
		"Use a Training Treat on a tamed wolf to train it.",
		"",
		"This makes your dog practically immortal.",
		"",
		"Shift + Right-Clicking your dog will bring up their menu!"
	],
	quest.210066B0C63574A8.quest_desc: [
		"MrCrayfish's Furniture mod adds over 440 functional and cosmetic decorative blocks.",
		"",
		"It even provides an electricity system for lights and lightswitches.",
		"",
		"Search @refurbished in JEI."
	],
	quest.213BEBA055430004.quest_desc: [
		"Special Reliquary component that has a small chance to drop when killing a witch.",
		"",
		"They also have a small chance to be found in loot chests."
	],
	quest.221372BE0147CB37.quest_desc: ["Basic, open-ended tent."],
	quest.228D1BB2CFB8A243.title: "Lava Chicken",
	quest.228DFD0E06B98C05.quest_desc: [
		"Compacting Drawers are drawers that store and convert an item to it's condensed or non-condensed form.",
		"",
		"For example, storing Iron Ingots will also display how many Iron Blocks and Iron Nuggets are available."
	],
	quest.228FB60B785CFB8C.quest_desc: [
		"&bShimmersteel Pickaxe&r:",
		"Fortune III when mining gems and dust.",
		"",
		"&bShimmersteel Axe&r:",
		"Right-Click copper to force oxidation.",
		"",
		"&bShimmersteel Shovel&r:",
		"Inherent Silk Touch",
		"",
		"&bShimmersteel Hoe&r:"
	],
	quest.228FB60B785CFB8C.title: "Shimmersteel Tools",
	quest.22B6DCD8B228CF3E.quest_desc: [
		"Albums hold up to 8 music discs for convenient storage!",
		"",
		"You can also play an Album on a Jukebox and it will function like a playlist!",
		"",
		"Albums can be dyed any color."
	],
	quest.22F4EEDEB17FC12C.quest_desc: [
		"Consult the Wildex for taming information.",
		"",
		"Vicuna can be sheared for yellow, orange, white, or brown wool."
	],
	quest.230DA0C79442F300.quest_desc: [
		"Consult the Wildex for taming information.",
		"",
		"Springhares can dig up random items.",
		"",
		"They also can block search in a small radius. ",
		"",
		"They will let out a loud squeak alerting you to rare blocks nearby (emerald, diamond, amethyst etc)."
	],
	quest.2385042AE3090C27.quest_desc: ["When placed on water, the Lilypad of Fertility will make all nearby plants passively grow faster."],
	quest.23BB79B3EEFC0999.quest_desc: [
		"The Wart Forest is covered with Nether Wart.",
		"",
		"A new complete wood set can be found here."
	],
	quest.2445ED77E1F5828C.quest_desc: ["Press M to bring up the world map."],
	quest.245F653701C5B2B3.quest_desc: ["Just don't microwave it in the office."],
	quest.24E2F25D08AD3F8D.quest_desc: [
		"The Soul Plains is a biome covered in Soul Sand and a new block, Soul Sandstone.",
		"",
		"Soul Sandstone is a decorative block that can be turned into bricks and walls."
	],
	quest.2583F43DEAF66CF5.quest_desc: [
		"Beautify adds custo decorative blocks that add function to your builds.",
		"",
		"New lights, lattices, flower pots, window blinds, and so much more!"
	],
	quest.25E19B8AC325B505.quest_desc: [
		"The Old Fungiwoods biome is covered in more fungi.",
		"",
		"There are giant brown and red mushrooms throughout the terrain."
	],
	quest.26636F409E53D141.quest_desc: ["Copper tools and equipment is now an early game bridge between stone and iron!"],
	quest.26636F409E53D141.title: "Copper Equipment",
	quest.26D980900603132D.quest_desc: [
		"Summon and slay The Wither.",
		"",
		"There are no changes to this fight."
	],
	quest.2778DB8D15D69999.quest_desc: [
		"The Kraken Shell absorbs drowning damage at the cost of hunger.",
		"",
		"It also provides dark vision while under water."
	],
	quest.27E617CC6214737F.quest_desc: [
		"Ender Tendril Seeds are found in loot chests.",
		"",
		"You plant them under a block like Glowberries. Their flowers appear every 4 blocks.",
		"",
		"They slowly grow Ender Pearls. Breaking the tendril will always drop a seed."
	],
	quest.27F0C530CCE0C0B8.quest_desc: [
		"Sublime's Overworld is packed with structures to explore and wildlife to encounter!",
		"",
		"The quests here serve as a reminder of vanilla or modded experiences available in the Overworld."
	],
	quest.285483919920EE89.quest_desc: ["The Concealment Key will show or hide item labels."],
	quest.289CD6318234FAB1.quest_desc: [
		"The Sulphur Springs are generated similar to lush caves utilizing water and Brimstone.",
		"",
		"Giant geysers also generate here.",
		"",
		"Sulphuric Rock generates under the geysers."
	],
	quest.295A5B023AE63978.quest_desc: [
		"Travel to the Nether Pyramid and gather some additional loot!",
		"",
		"Just watch your step and mind residents."
	],
	quest.2A30A771FFC0FC04.quest_desc: [
		"The Ice Magus Rod throws snowballs as a ranged projectile that does damage.",
		"",
		"It uses snowballs as ammo and can be shift + right-clicked to auto absorb snowballs in your inventory."
	],
	quest.2A62C56791191F8D.quest_desc: [
		"The Ice Starfields coinsist of giant Emerald Ice clusters in the form of a star.",
		"",
		"Careful, it's very, very cold there."
	],
	quest.2A8EC3F913BD3846.quest_desc: ["The Waystone allows teleportation to other activated Waystones at the cost of experience."],
	quest.2AC77376AF5A09B9.quest_desc: [
		"The Dragon Graveyard has large, mossy obsidian mounts.",
		"",
		"This obsidian is covered with varied fungi."
	],
	quest.2B524E575A1439B8.quest_desc: [
		"These travel commands are available if they suit your playstyle.",
		"",
		"\"/sethome name\" to set a home location.",
		"",
		"\"/home name\" to teleport to your home location.",
		"",
		"\"/back\" to teleport to your previous location/death."
	],
	quest.2B524E575A1439B8.title: "Home and Back",
	quest.2B806DDD73424DBD.title: "cat",
	quest.2CA80D650AFF7BA9.quest_desc: [
		"THe Void Tear holds a near-infinite amount of one item.",
		"",
		"Right-Clicking makes the tear absorb the item you are carrying the most of.",
		"",
		"Shift + Right-Clicking makes the tear auto absord that item going forward."
	],
	quest.2E0FF203A269929C.quest_desc: [
		"Consult the Wildex for taming information.",
		"",
		"When tamed, the Harp Seal will assist in combat.",
		"",
		"It will also hunt fish if it is injured."
	],
	quest.2EC457AC7DEE864D.quest_desc: [
		"Pups can play fetch with a Throw Bone, Throw Stick, or Frisbee!",
		"",
		"In addition, there are over 40 cosmetics and costumes to dress your pup in!"
	],
	quest.2EDE2C3FD8472F87.quest_desc: [
		"Special Reliquary component that has a small chance to drop when killing a skeleton.",
		"",
		"They also have a small chance to be found in loot chests."
	],
	quest.309711EB2CE65A83.quest_desc: [
		"The Potion of Fertility causes plants to grow.",
		"",
		"It is used like a splash potion."
	],
	quest.3118E23398DFC641.quest_desc: [
		"Consult the Wildex for taming information.",
		"",
		"The Glare will show you areas that are dark enough for monsters to spawn."
	],
	quest.311FA31EE45D96B2.quest_desc: [
		"To create an Auroral Snowlette, make a Snow Golem and then right-click with an Aurora Shard.",
		"",
		"The Snowlette is a mini companion that follows you around and can be healed with snowballs."
	],
	quest.311FA31EE45D96B2.title: "Auroral Snowlette",
	quest.314F04CCB6DC52AA.quest_desc: [
		"If you want a more aesthetically pleasing way to use the Inventory Cables, you can craft ones that can be painted!",
		"",
		"The Paint Kit allows you to select a block and then paint the Inventory Cable to look like that block."
	],
	quest.315BFB4A8817FF57.quest_desc: [
		"Sick of boats but still want to explore the ocean?",
		"",
		"Want to build an underwater base without worrying about silly things like air?",
		"",
		"Find and saddle up a Nautilus!",
		"",
		"Keep it safe with armor, too."
	],
	quest.315BFB4A8817FF57.title: "Nautilus",
	quest.31C63F22D9B7AD7E.quest_desc: [
		"The Coin of Fortune draws in items and experience similar to a magnet.",
		"",
		"Shift + Right-Clicking will activate and deactivate the coin."
	],
	quest.32172A0A8C247FAC.quest_desc: ["Moderately increases the speed and jump height of your horse."],
	quest.3259DE69A7FF2C87.quest_desc: [
		"Shears of Winter are used to harvest leaves on a tree in an area.",
		"",
		"It will also AOE shear sheep!"
	],
	quest.325C71628E18BAA4.quest_desc: [
		"The Wraith Node is the target that the Ender Staff will teleport to when in wraith mode.",
		"",
		"It must be right-clicked with the Ender Staff in wraith mode to link."
	],
	quest.3264C0C4279CCE06.quest_desc: [
		"Special Reliquary component that has a small chance to drop when killing a blaze.",
		"",
		"They also have a small chance to be found in loot chests."
	],
	quest.334FFA752960F035.quest_desc: [
		"Special Reliquary component that has a small chance to drop when killing a creeper.",
		"",
		"They also have a small chance to be found in loot chests."
	],
	quest.338A3FBC93A3F898.quest_desc: ["Night Lights adds a variety of new Fairy Lights and Night Lights to your world!"],
	quest.34D38B56415D20AB.quest_desc: ["Increases the speed and jump height of your horse."],
	quest.35101A28BF65D6CB.quest_desc: ["The Witherless Rose protects you from the withering effect."],
	quest.352AC044A81FF56F.quest_desc: [
		"Storage Drawers provides drawers to help with storing and sorting large amounts of items!",
		"",
		"Drawers come in all vanilla wood types and 1x1, 1x2, and 2x2 variants.",
		"",
		"Right-Clicking a drawer will store the item in your hand.",
		"",
		"Right-Clicking x2 will store all of that from your inventory.",
		"",
		"Left-Clicking removes an item from the drawer.",
		"",
		"Shift + Left-Clicking removes up to a stack of the item from the drawer."
	],
	quest.352AC044A81FF56F.title: "Storage Drawers",
	quest.35CD4A38E7C19003.quest_desc: ["The Explorer's Compass will help you locate any structure."],
	quest.35F814751CF4F6F3.quest_desc: ["The Painted Mountains consist of layers of End Stone, Violecite, and Flavolite."],
	quest.361B31F88FFDADA3.quest_desc: [
		"Frozen Petals are dropped from mature Aurora Blooms!",
		"",
		"Aurora Blooms sprout during Aurora Events and grow throughout the night.",
		"",
		"They will disappear as the sun rises so harvest as many as you can."
	],
	quest.3641AECCAE951D53.quest_desc: [
		"The Neon Oasis is comprised of patchy vegetation and End Stone Dust.",
		"",
		"it is also home to the Neon Cactus."
	],
	quest.36564B85103C9905.quest_desc: [
		"The Holy Hand Grenade is a throw item that does large damage to anything nearby.",
		"",
		"However, it does not break blocks or damage the player."
	],
	quest.36F5DDEB5798D572.quest_desc: [
		"The Twilight Cloak will turn you invisible when in sufficient darkness.",
		"",
		"Shift + Right-Clicking enables and disables the cloak."
	],
	quest.36FBB5E4910E3C28.quest_desc: [
		"The Kami Treat provides your pup bonus levels after reaching level 60.",
		"",
		"It maxes out at level 30."
	],
	quest.37665C4B7ECCB637.quest_desc: ["There are a multitude of items and bones to help you with your pup!"],
	quest.3803C92DCD542BA2.quest_desc: [
		"Consult the Wildex for taming information.",
		"",
		"When tamed, the mouse will assist in combat.",
		"",
		"It will beg for food on occassion.",
		"",
		"If provided Rotten Flesh, its attacks could inflict poison."
	],
	quest.38BD5AD570A100B9.quest_desc: ["These empty, abandoned villages are beautiful and ready to be looted!"],
	quest.394C78DC2E6E2489.quest_desc: [
		"Consult the Wildex for taming information.",
		"",
		"When tamed, the Fennec Fox will carry items in its mouth.",
		"",
		"If the item is food and it becomes injured, it will eat to heal itself.",
		"",
		"Also hunts rabbits and chickens."
	],
	quest.3A2452FC54179994.quest_desc: [
		"Find a Dried Ghast in the Soul Sand Valley!",
		"",
		"Rehydrating this adorable version of the Ghast can take you to new heights!"
	],
	quest.3ADD438AD10047D6.quest_desc: [
		"Take to the skies with a beautiful set of wings of your choice!",
		"",
		"Crafting and drinking one of these potions will grow the respective wings.",
		"",
		"Use ` to activate and deactivate flight",
		"",
		"If you decide you no longer want your wings, simply bottle some Bat Blood and chug it down!",
		"",
		"NOTE: When one wing quest is completed, all of the wing quests will complete. It is not a bug."
	],
	quest.3B1FC9C28D49CCEB.quest_desc: [
		"The End is completely overhauled with new biomes, structures, and more!",
		"",
		"The quests here serve as a reminder of vanilla or modded experiences available in the End."
	],
	quest.3B78D17A40B87EFE.quest_desc: [
		"Auroral is a beautiful magic mod focused around Aurora Events in cold biomes!",
		"",
		"It also comes with this handy manual that details everything about the mod!"
	],
	quest.3BF04BA1F37CFE03.quest_desc: [
		"In your inventory is a Wildex.",
		"",
		"It allows you to document every mob your world.",
		"",
		"To document a mob, either look at it through the provided Spyglass or kill it.",
		"",
		"The Wildex will update with all details about the mob including spawning, breeding, taming, health, and more!"
	],
	quest.3C087C346242A4ED.quest_desc: ["The Super Treat can level your pup up to level 40."],
	quest.3C81F8BFA79E1C1E.quest_desc: ["The Cross of Mercy is a weapon that deals bonus damage to undead creatures."],
	quest.3CE80D982716B5BC.quest_desc: [
		"Magic Bane is a weapon that gets stronger the more it is enchanted.",
		"",
		"It also increases the odds of receiving Reliquary specific mob drops when slaying enemies."
	],
	quest.3D4CED91F3AD2640.quest_desc: [
		"The Angelheart Vial prevents you from dying once similar to a Totem of Undying.",
		"",
		"It must be in your inventory to activate."
	],
	quest.3D6652CBD187811F.quest_desc: [
		"Cincinnasite drops from Cincinnasite Ore.",
		"",
		"It's used to make beautiful decorations and useful gear."
	],
	quest.3E34731600A90D3F.quest_desc: [
		"Glowing Bread completely restores your hunger and saturation.",
		"",
		"It also is very fast to eat."
	],
	quest.3E6E71489FEEE53E.quest_desc: [
		"The Dog Bed will respawn your pup if they somehow fall into the void.",
		"",
		"Shift + Right-Clicking with empty hands will designate the pup to the bed when it is close.",
		"",
		"1 bed per pup.",
		"",
		"You can also use the Whistle to help if you have multiple pups."
	],
	quest.3ED1C1C1BD94E295.quest_desc: ["An additional food item offered by the Burger Mod."],
	quest.3F01D82ADE3CF563.quest_desc: [
		"The Wireless Terminal allows you to access the terminal on your Inventory Connector storage from up to 16 blocks away!",
		"",
		"You must be able to see the terminal to access it."
	],
	quest.3F3264917A0B771D.quest_desc: ["Greatly increases the speed and jump height of your horse."],
	quest.3FD550D1B6F0ACE9.quest_desc: [
		"The Salamander's Eye will block blaze fireballs, reflect ghast fireballs, and put out fire around you.",
		"",
		"it can be held in the off-hand."
	],
	quest.40333FADB8E2D5B1.quest_desc: [
		"Special Reliquary component that has a small chance to drop when killing a guardian.",
		"",
		"They also have a small chance to be found in loot chests."
	],
	quest.403F9C1B027BD598.quest_desc: [
		"The Blossoming Spires are vibrant and colorful!",
		"",
		"The Tenanea Tree can be found here and has a complete wood set."
	],
	quest.414455D11E27634A.quest_desc: ["Umbra Valleys are made of Umbralith that's covered in a white fungus called Pallidum."],
	quest.419C24C774B3AA16.quest_desc: [
		"Consult the Wildex for taming information.",
		"",
		"The Red River Hog will sometimes eat grass searching for seeds and leave them behind.",
		"",
		"They can also sneeze out slime balls."
	],
	quest.41DDBD6415E0A61C.quest_desc: [
		"Consult the Wildex for taming information.",
		"",
		"The Owl likes to party just like the Parrot."
	],
	quest.41ED2E6B7C59E5A0.quest_desc: [
		"Consult the Wildex for taming information.",
		"",
		"The Goose will assist you in combat and can be given a weapon.",
		"",
		"The Goose can also be given a weapon."
	],
	quest.428A71B511455EC9.quest_desc: [
		"THe Phoenix Down will prevent you from dying once, restoring you to full health and hunger, and reverting to an Angelic Feather.",
		"",
		"It also gives you jump boost and prevents fall damage at the cost of hunger."
	],
	quest.42957CDB5AAB0931.quest_desc: [
		"The Nether is completely overhauled with new biomes, structures, and more!",
		"",
		"The quests here serve as a reminder of vanilla or modded experiences available in the Nether."
	],
	quest.430751272866E77D.quest_desc: [
		"An Aeternium Hammer is required to create Aeternium tools and armor.",
		"",
		"A Leather Wrapped Stick, Aeternium Smithing Template, and Aeternium Hammer Head will make the Aeternium Hammer."
	],
	quest.433E7C918C8EF92D.quest_desc: [
		"The Nether Swamplands floor is made up of lava pools, Soul Soil, and Nether Reeds.",
		"",
		"Massive Willow Trees are often found here."
	],
	quest.43E55EB06E05F9CD.quest_desc: ["Inventory Cable Connectors are placed on a inventory that is going to be using Inventory Cables to connect to Inventory Connector."],
	quest.4469426FD6CBD8A5.quest_desc: [
		"Consult the Wildex for taming information.",
		"",
		"Ducks lay eggs and drop feathers.",
		"",
		"They love water and music."
	],
	quest.44B0B7741271EEC5.quest_desc: [
		"The Infusion Ritual can convert Polished Flavolite into Runed Flavolite.",
		"",
		"This block can be used to complete the Ruined Portal found in the End.",
		"",
		"Be sure to have enough!",
		"",
		"Bring 6 Eternal Crystals with you to place on the Pedestals to activate the portal!"
	],
	quest.453CA53A7C66D646.quest_desc: [
		"Consult the Wildex for taming information.",
		"",
		"The health of the Red Panda increases from 8 to 25 when tamed.",
		"",
		"It can also assist in combat."
	],
	quest.45979CA611D2D62D.quest_desc: ["The Nature's Compass will help you locate any biome."],
	quest.45B49190237E0A8B.quest_desc: [
		"Use a Fillet Knife with a fish to create a Raw Fish FIllet.",
		"",
		"The amount of fillets depends on the type of the fish!"
	],
	quest.45BD02835A6198DB.quest_desc: [
		"Consult the Wildex for taming information.",
		"",
		"Attackers will get poked by quills.",
		"",
		"It has increased armor."
	],
	quest.4633FAA6B3EBB561.quest_desc: [
		"A wide assortment of burgers and sides are available to craft through The Burger Mod!",
		"",
		"These are the ones made with chicken."
	],
	quest.4633FAA6B3EBB561.title: "Chicken Burgers",
	quest.468A69D2E733AAB5.quest_desc: [
		"A Return Scroll will teleport you to the nearest Waystone that you have activated.",
		"",
		"The scroll is consumed on use."
	],
	quest.472A9A50A6836271.quest_desc: [
		"The Chorus Forest biome has a dark ambience.",
		"",
		"The Pythadendron Tree can be found there which has a complete wood set."
	],
	quest.4763EA8BE971B63B.quest_desc: [
		"The Inventory Connector is the main hub that combines all connecting inventories.",
		"",
		"Any chests that are touching it, chests that are touching chests that are touching it, or are connected to it by other means is added to the main hub.",
		"",
		"Note: Turn cosmetic chests into vanilla chests by placing them into any crafting grid. The Inventory Connector will then recognize the chests."
	],
	quest.4763EA8BE971B63B.title: "Tom's Simple Storage",
	quest.47B0E7DFDEE58F08.quest_desc: [
		"The Flooded Deltas are, well... flooded with lava.",
		"",
		"They contain Blackstone Stalacites and Black Glazed Terracotta."
	],
	quest.47FEB8748AC6B358.quest_desc: [
		"A wide assortment of burgers and sides are available to craft through The Burger Mod!",
		"",
		"These are the ones made with Salmon."
	],
	quest.47FEB8748AC6B358.title: "Salmon Burgers",
	quest.4844AD258884B6F3.quest_desc: ["Shimmering Ice is a glowing ice that never melts and keeps crops hydrated."],
	quest.48465828DEBF2E1E.quest_desc: [
		"Macaw's Suite includes an extensive collection of decorative and building options.",
		"",
		"Below are the following mods included:",
		"",
		"- Macaw's Bridges",
		"- Macaw's Doors",
		"- Macaw's Fences and Walls",
		"- Macaw's Furniture",
		"- Macaw's Lights and Lamps",
		"- Macaw's Paths and Pavings",
		"- Macaw's Roofs",
		"- Macaw's Stairs",
		"- Macaw's Trapdoors",
		"- Macaw's Windows"
	],
	quest.48651C9DBF1DBD9A.quest_desc: [
		"Shift + Right Clicking on most mobs and blocks with empty hands will pick them up to be carried.",
		"",
		"This includes chests!"
	],
	quest.48E75BDBE0622423.quest_desc: [
		"The Drawer Controller turns simple drawers into a storage system.",
		"",
		"A controller touching drawers can be right-clicked x2 and all currently stored items from your inventory will be stored in the drawers.",
		"",
		"Drawers can chain to other drawers that eventually touch the controller.",
		"",
		"Essentially, you could have a wall of Storage Drawers connected to a controller. "
	],
	quest.48FC06A01A5D6DD1.quest_desc: [
		"Consult the Wildex for taming information.",
		"",
		"Snow Leopards will hunt other mobs.",
		"",
		"They will assist you in combat."
	],
	quest.49591E314CEAA227.quest_desc: [
		"Need help sorting your storage?",
		"",
		"Craft a Copper Golem or 12!",
		"",
		"Copper Golems will take items out of Copper Chests and do 1 of 2 things:",
		"",
		"- Place item in nearby empty wooden chests",
		"- Place item in nearby wooden chest containing the item",
		"",
		"Don't forget to clean or wax them!"
	],
	quest.49591E314CEAA227.title: "Copper Golem",
	quest.49BD54A17F0F156E.quest_desc: ["The Old Warped woods has larger and less frequent vegetation compared to its vanilla counterpart."],
	quest.49EAA8784F938A77.quest_desc: [
		"Take on the Ender Dragon.",
		"",
		"Don't forget bottles and torches!"
	],
	quest.4AEAA5AD783DBCCC.quest_desc: ["4x base storage value for the drawer."],
	quest.4B28C8E734C9BB7C.quest_desc: ["Waystones is a mod that allows various types of travel between Waystones."],
	quest.4B45B68A9ABE1499.quest_desc: [
		"The Bone Reef is a beautiful biome decorated with Mushroom Grass and Bone Structures.",
		"",
		"It is home to such flora as the Feather Fern and Nether Reed."
	],
	quest.4B9A991F344ED5E3.quest_desc: ["An ingredient in various different Burger Mod recipes."],
	quest.4CA5514700E8931C.quest_desc: [
		"The Rending Gale uses feathers as power to perform various functions.",
		"",
		"Push mode will push enemies away.",
		"",
		"Pull mode will pull enemies towards you.",
		"",
		"Flight mode allows you to fly.",
		"",
		"During a thunderstorm, you can also call down lightning strikes.",
		"",
		"Shift + Right-Clicking turns on auto absorbtion."
	],
	quest.4CF3FD22DBDD726A.quest_desc: [
		"A wide assortment of burgers and sides are available to craft through The Burger Mod!",
		"",
		"These are the ones made with mutton."
	],
	quest.4CF3FD22DBDD726A.title: "Mutton Burgers",
	quest.4D9FD0AB63AF370C.title: "Tears",
	quest.4DB7AC263B57E455.quest_desc: [
		"Find an Ancient City and find a ton of loot and experience!",
		"",
		"Just make sure you do it quietly. The Warden listens closely."
	],
	quest.4E8239D370E38B23.quest_desc: [
		"Special Reliquary component that has a small chance to drop when killing a spider.",
		"",
		"They also have a small chance to be found in loot chests."
	],
	quest.4EAFEE1748EB9E07.quest_desc: ["The Training Treat can level your pup up to level 20."],
	quest.4F8DB21E1E9CE58C.quest_desc: [
		"The Destruction Catalyst uses gunpowder as ammo to destroy blocks similar to TNT by right-clicking.",
		"",
		"Shift + Right-Clicking toggles auto absorbtion."
	],
	quest.5029953350870FD0.title: "strad",
	quest.50BA04FDA6FB7C86.quest_desc: [
		"The Advanced Wireless Terminal can be shift + right-clicked on a Terminal connected to an Inventory Connector.",
		"",
		"This will allow you to access that inventory from up to 64 blocks away."
	],
	quest.5116FC5AEE09B426.quest_desc: ["Crafting component for all Storage Drawer upgrades."],
	quest.525E2DE4F48D1D3C.quest_desc: [
		"The Infernal Chalice stores lava and protects you from lava damage.",
		"",
		"Shift + Right-Clicking will switch between bucket and drain mode.",
		"",
		"The lava protection comes at the cost of hunger."
	],
	quest.528844750FEA3005.quest_desc: [
		"Kill the Evoker. Please.",
		"",
		"This vexing mob is usually found in Woodland Mansions."
	],
	quest.52B0FFB1EAEA3DD1.quest_desc: [
		"Use the brush on sand and gravel that looks a little \"suspicious\" to find interesting loot!",
		"",
		"If you are in a Warm Ocean Ruin, you may even find a Sniffer egg!"
	],
	quest.52B0FFB1EAEA3DD1.title: "Archeology",
	quest.53121695B5B0D0AB.quest_desc: [
		"The Hearthwood Log is a campfire that burns for 7 IRL days.",
		"",
		"It also grants frostbite immunity to nearby entities.",
		"",
		"It acts as a catalyst for Aurora Events.",
		"",
		"They can be crafted and naturally generate."
	],
	quest.5340153433F33090.quest_desc: [
		"Additional Lights adds over 200 light variations across 6 types of stone.",
		"",
		"It also provides light, fire, or sould fire options."
	],
	quest.53520B89FB26DC43.title: "mall",
	quest.53AB72150F144859.quest_desc: [
		"Consult the Wildex for taming information.",
		"",
		"When tamed, the Meerkat will assist in combat.",
		"",
		"It is also adorable."
	],
	quest.5452374A56964E84.quest_desc: [
		"The Food Bowl will automatically feed the pup when its nourishment is too low.",
		"",
		"Right-Click the bowl for the GUI.",
		"",
		"Pups will not eat raw food from the bowl. Cooking is required."
	],
	quest.548275588334FCF7.quest_desc: ["Shows how full a drawer is in relation to the capacity."],
	quest.56167219BA458CD9.quest_desc: ["Breeding Bones are the only way to breed Trained Dogs."],
	quest.56247FCFE8AA3698.quest_desc: [
		"Sojourner's Staff allows you to place torches from a distance.",
		"",
		"It uses torches as fuel and costs more torches the further away you are placing them.",
		"",
		"Shift + Right-Clicking will turn on auto absorbtion."
	],
	quest.5704AD6ABB862834.quest_desc: [
		"The Shadow Forest is a grim and dark biome with flora that require you to watch your step.",
		"",
		"It is also home to the Dragon Tree which comes with a complete wood set."
	],
	quest.574C9C4F8F3E7600.quest_desc: ["There are also iron, gold, diamond and Neptunian Fillet Knives!"],
	quest.57EAEDE442FDC6D8.quest_desc: [
		"Shift + Right-Clicking on your Trained Dog will bring up their menu.",
		"",
		"The menu includes things such as:",
		"",
		"- Modes: Docile, Wander, Aggressive etc",
		"- Nourishment: Keep your pup fed!",
		"- Talents: Upgrades for your pup!",
		"- Breed and name change.",
		"- And more!",
		"",
		"There is a lot to explore in the menu!"
	],
	quest.57EAEDE442FDC6D8.title: "Dog Menu",
	quest.584A8E5CC0F2C4CF.quest_desc: ["Lean-to tent with open front."],
	quest.58CA9AA24EE88D41.quest_desc: ["64x base storage value for the drawer."],
	quest.595A8101A13F95B7.quest_desc: ["Illuminates drawer labels to be seen in the dark."],
	quest.597970B9BA29A294.quest_desc: [
		"The Master Treat can level your pup up to level 60.",
		"",
		"This is the maximum normal level."
	],
	quest.5A450FC5DDAC4925.quest_subtitle: "Doggy Talents",
	quest.5A450FC5DDAC4925.title: "Valse Du Petit Chien",
	quest.5A925A8EFA6DDF24.quest_desc: [
		"The Emperor's Chalice is a portable infinite water source.",
		"",
		"Shift + Right-Clicking will activate place/absorb.",
		"",
		"Don't drink it."
	],
	quest.5AFBDB32BE2FD73D.quest_desc: [
		"The Umbrella Jungle is home to the massive Umbrella Tree!",
		"",
		"Umbrella trees have membranes that can be bottled, bouncey physics, and a complete wood set.",
		"",
		"In addition, Jellyshrooms generate here which also have their own complete wood set."
	],
	quest.5B1B9E15207E39FE.quest_desc: ["Shimmersteel Ingots are crafted by right-clicking with Unrefined Shimmersteel on a filled Glacial Basin."],
	quest.5B3024C7DA8A0463.title: "Creator (Music Box)",
	quest.5B7FCC8F48924929.quest_desc: [
		"Bottled Bat Blood is used to remove wings you have already grown.",
		"",
		"You are able to grow new wings with another potion."
	],
	quest.5BD43C10600A678A.quest_desc: [
		"The Amnesia Bone allows you to either change ownership, untrain a pup, or untrain a talent.",
		"",
		"Right-Click the Amnesia Bone on your dog to open the menu."
	],
	quest.5C00A74A05E883C6.quest_desc: [
		"The Megalake Grove generates large lakes with lotus plants.",
		"",
		"The lotus plants can be harvested to make Endlotus logs which have a complete wood set.",
		"",
		"The Megalake Grove also contains Lacugrove Trees which have a complete wood set, too!"
	],
	quest.5C042D99FB475B1F.quest_desc: [
		"Special Reliquary component that has a small chance to drop when killing a zombie.",
		"",
		"They also have a small chance to be found in loot chests."
	],
	quest.5C7B181FD3C8759A.quest_desc: [
		"Fishing Line is a cosmetic addition to your Fishing Rod.",
		"",
		"Place it with any color dye in a crafting grid to dye it."
	],
	quest.5D44AD68D5205FC9.quest_desc: [
		"Infusion Rituals magically craft components and magic items using Pedestals!",
		"",
		"You can craft powerful enchantments, upgrade your Elytra, and even upgrade Terminite Armor into Crystalite Armor!",
		"",
		"Use JEI to see all of the different ritual recipes available."
	],
	quest.5D5B96C17976192E.quest_desc: [
		"Special Reliquary component that has a small chance to drop when killing a squid.",
		"",
		"They also have a small chance to be found in loot chests."
	],
	quest.5E032322CC3BBDAD.title: "Pigstep",
	quest.5EA3A4A9AD7825F2.quest_subtitle: "Additional Additions",
	quest.5EA3A4A9AD7825F2.title: "0308",
	quest.5EBE4E085702C98E.quest_desc: [
		"The Magnet will draw in items and XP within a 5 blocks radius.",
		"",
		"Shift + Right-Click to toggle activation."
	],
	quest.5EFA881B7DD0F9EE.quest_desc: [
		"Aurora Events are the key to Auroral and progressing.",
		"",
		"The book details everything that can happen during an Aurora Event.",
		"",
		"Here are a few important things:",
		"",
		"- Glacial Basins collect Liquid Aura.",
		"- Aurora Blooms sprout on snow.",
		"- Shimmersteel Gear slowly repairs."
	],
	quest.5EFA881B7DD0F9EE.title: "Aurora Events",
	quest.5F80CA5715BD6FD6.quest_desc: [
		"Consult the Wildex for taming information.",
		"",
		"When tamed, the Narwhal will assist in combat.",
		"",
		"It will let out a warning sound if its owner is being targeted.",
		"",
		"It does not teleport to the player."
	],
	quest.607A50C793DE0085.quest_desc: ["The city at the end stands tall in the emptiness of the void."],
	quest.60B0A7F93930B61D.quest_desc: ["An additional food item offered by the Burger Mod."],
	quest.60BAE0D2D28AD44C.quest_desc: ["Ridiculously increases the speed and jump height of your horse."],
	quest.60C22D704F80C024.quest_desc: [
		"Find the Wildfire within it's Citadel within the Nether.",
		"",
		"I highly recommend fire resisitance to buy time to take the Wildfire's shields down."
	],
	quest.6122BD6946408F60.quest_desc: ["Just like Inventory Cables, Inventory Cable Connectors can also be framed and painted!"],
	quest.61246F8B73D76E09.quest_desc: [
		"This Smithing Template is used to create Shimmersteel tools and Shimmerweave Armor!",
		"",
		"It can be crafted or looted from cold biome loot chests."
	],
	quest.612DB8B5F9F83CD6.quest_desc: [
		"The Gravel Desert is a rather uneventful biome that contains some new flora.",
		"",
		"It's a very thorny biome to traverse."
	],
	quest.61EBC4F566278CF4.quest_desc: [
		"During Aurora Events, the Aurora Nautilus has a chance to spawn.",
		"",
		"Lure them near you with Aurora Shards and use the shards to tame them.",
		"",
		"They do not need a saddle. Shift + Right-Click will change their mode to sit or follow.",
		"",
		"Yes, they fly."
	],
	quest.621E6F7D067C2423.quest_desc: [
		"Select the Talents tab at the bottom of your pups menu to access the talent tree.",
		"",
		"Your pup starts with 15 points and can further level with treats!",
		"",
		"There are a lot of really cool and useful talents your pup can learn!"
	],
	quest.621F732902031F8B.quest_desc: [
		"Looking for a stylish option for tools and equipment without sacrificing quality?",
		"",
		"Rose Gold offers protection levels between iron and diamond and looks good doing it."
	],
	quest.621F732902031F8B.title: "Rose Gold Equipment",
	quest.627686F4C58E8A24.quest_desc: [
		"The Smith Hammer is used in the Thallasium Anvil with Thallasium Ingots to create tool heads and armor plates!",
		"",
		"Tool heads placed in the same anvil with a stick and a Smithing Template for Thallasium to create the tool.",
		"",
		"Armor plates can be used in a normal crafting table."
	],
	quest.627686F4C58E8A24.title: "Thallasium Anvil",
	quest.6288B61A68DA6626.quest_desc: [
		"Unless you plan to live in a snow biome, you'll want to make sure you craft these items before heading out.",
		"",
		"Blue Ice is used to craft the Glacial Basin.",
		"",
		"Unrefined Shimmersteel is used to create Shimmersteel Ingots in Glacial Basins.",
		"",
		"Woven Leather is used to create Shimmerweave Fabric in Glacial Basins."
	],
	quest.6288B61A68DA6626.title: "Preparation",
	quest.62F189DD40EAF414.quest_desc: [
		"Simply Tents provides various tents that create small (3x3ish), portable locations.",
		"",
		"Make sure the area is clear before placing a tent.",
		"",
		"If you decide you want to move the tent, simply Shift + Right-Click it.",
		"",
		"Right-Click with dye to change colors. ",
		"",
		"Right-Click with a log/plank to change the frame.",
		"",
		"Canvas Walls can be used to expand the tent."
	],
	quest.6315A5B4699A77F9.quest_desc: [
		"Rope adds a convenient way to traverse verticle terrain.",
		"",
		"It works like Scaffolding but in reverse!",
		"",
		"Clicking the top block will have the Rope drop down further."
	],
	quest.63CF2C81E15BE62D.quest_desc: [
		"Horses have a plethora of quality live improvements including:",
		"",
		"- Equip lead. Right-Click fence to leash",
		"- Copper Horn to bind/summon ",
		"- Swimming",
		"- Boating",
		"- Less leave collision",
		"- Mining speed",
		"- Step Height",
		"- Limited wandering"
	],
	quest.63CF2C81E15BE62D.title: "Horses",
	quest.63D6AA602B315095.quest_desc: [
		"Discover the beautiful Nether City!",
		"",
		"It is packed with loot, secrets, and some royal guards."
	],
	quest.64285A59259F4212.quest_desc: [
		"Elevators will teleport you to other elevators that are above or below you.",
		"",
		"They can be dyed and disguised."
	],
	quest.64285A59259F4212.title: "Elevators",
	quest.64BB6EE0C6493408.quest_desc: [
		"Rechiseled adds the ability to customize an extensive number of block patterns in Minecraft.",
		"",
		"Right-Click with the Chisel and place your block choice inside!"
	],
	quest.651A42F243652FAD.quest_subtitle: "Additional Additions",
	quest.651A42F243652FAD.title: "1507",
	quest.660CFBC12F05348D.quest_desc: [
		"The Harvest Rod uses Bone Meal as energy to perform different functions depending on the mode it's in.",
		"",
		"Shift + Right-Clicking will have the Harvest Rod auto absorb Bone Meal in your inventory.",
		"",
		"Mode 1 functions as a Hoe.",
		"",
		"Mode 2 plants seeds.",
		"",
		"Mode 3 bone meals crops."
	],
	quest.66150463668FB2F8.quest_desc: [
		"Reliquary adds powerful magical trinkets, weapons, and items to the world.",
		"",
		"While all of the items can be crafted, some can also be found in loot chests."
	],
	quest.666E72988C6CD9B3.quest_desc: ["Save the villagers from certain death by completing a raid!"],
	quest.668296237892EFCE.title: "Creator",
	quest.66FA189CE08FCF7A.quest_desc: [
		"The Nether Fortrees stands waiting for its next adventurer!",
		"",
		"Step up and claim the riches it holds."
	],
	quest.679E2C026AEBDF1E.quest_desc: [
		"Comforts adds sleeping bags and hammocks!",
		"",
		"These allow you to sleep without setting your spawn point."
	],
	quest.686077406EFB153B.quest_desc: [
		"Fantasy's Furniture provide beautiful, themed furniture sets and decorations.",
		"",
		"Themed sets include:",
		"",
		"- Bone",
		"- Decorations",
		"- Dunmer",
		"- Necrolord",
		"- Nordic",
		"- Royal",
		"- Venthyr",
		"",
		"This Furniture Station is used to craft everything in the mod.",
		"",
		"It simply requires Wool/Plank blocks and Clay Balls."
	],
	quest.68B40899C8C18BC7.quest_desc: [
		"The Angelic Feather reduces fall damage while costing hunger.",
		"",
		"It also increases your jump height."
	],
	quest.68CA2263277A7D6F.quest_desc: [
		"The Lantern of Paranoia will place torches around you where it is dark.",
		"",
		"Shift + Right-Clicking will activate the lantern.",
		"",
		"You must have torches for the lantern to work."
	],
	quest.68CD017E53AF1860.quest_desc: [
		"Find and slay the Illusioner.",
		"",
		"He lives in a Cabin in Taiga biomes."
	],
	quest.696282BC23E6932A.quest_desc: [
		"Special Reliquary component that has a small chance to drop when killing a enderman.",
		"",
		"They also have a small chance to be found in loot chests."
	],
	quest.69D3095BF4137675.title: "11",
	quest.6B5CE65C9B8DFA16.quest_desc: [
		"The Nether Grasslands is home to a plethora of new vegetation.",
		"",
		"For example, the Ink Bush can be grown and cooked for black dye."
	],
	quest.6BFFCA2D549C99CB.title: "wait",
	quest.6C5C54CB7C71F092.quest_desc: [
		"The Upside Down Forest is aptly named.",
		"",
		"All flora in the biome grows down from the ceiling.",
		"",
		"New trees with complete wood sets can be found here."
	],
	quest.6C6190EB887103FB.quest_subtitle: "Friends and Foes",
	quest.6C6190EB887103FB.title: "Around the Corner",
	quest.6CA1ACD6D25CE33E.quest_desc: ["An ingredient in various different Burger Mod recipes."],
	quest.6CFBDDD480EC100F.quest_desc: [
		"&bShimmersteel Sword&r:",
		"Applies slowness and executes low-HP mobs",
		"",
		"&bShimmersteel Bow&r:",
		"Fires Star-Shots using snowballs as ammo."
	],
	quest.6D99045B25A10F26.quest_subtitle: "BetterEnd",
	quest.6D99045B25A10F26.title: "Strange and Alien",
	quest.6E9E8089D9FDE011.quest_desc: [
		"There are 9 different hooks that can be added to your fishing rod.",
		"",
		"Hooks can imrpove durability loss, improve luck, and even catch multiple fish at once!"
	],
	quest.6E9E8089D9FDE011.title: "Hooks",
	quest.6EF0BA2EC5702B2B.quest_desc: [
		"Item Filters are used to specify what can go into or out of a specific chest connected to the Inventory Connector.",
		"",
		"There are 3 types of Item Filters."
	],
	quest.6F1E89CE22DD743D.quest_desc: [
		"The Touchstone of Midas will use glowstone as power to repair gold equipment.",
		"",
		"Shift + Right-Clicking will enable auto absorbtion."
	],
	quest.6F2AC6DFB286D2D1.quest_desc: ["2048x base storage value for the drawer."],
	quest.6F9B123AB99FA3B6.title: "Relic",
	quest.6FCCF5F63B84433D.quest_desc: ["The Quantify Key will show or hide the quantity of an item in a drawer."],
	quest.70CFF67582E10820.quest_desc: ["Taming a vanilla Minecraft Wolf is the first step to creating your Trained Dog!"],
	quest.719E70E61AD775E7.quest_desc: [
		"The Spear is a tiered weapons that can perform slow jab attacks.",
		"",
		"However, it really shines when being held to do charge attacks on a mount.",
		"",
		"This combos well with the horse shoes available for horses."
	],
	quest.719E70E61AD775E7.title: "Spears",
	quest.71A6169AA16C9E5F.quest_desc: ["Aurora Shards are crafted by right-clicking with a Frozen Petal on a filled Glacial Basin."],
	quest.71AB3635167C5E56.quest_desc: [
		"The Foggy Mushroom land is home to giant Mossy Glowshrooms.",
		"",
		"These massive Glowshrooms come with their own complete wood set."
	],
	quest.71C971BCA8AAA368.quest_desc: [
		"The Warp Scroll brings up the list of all Waystones you have activated allowing you to select one to teleport to.",
		"",
		"The scroll is consumed on use."
	],
	quest.72A25DDD1B018054.quest_desc: [
		"Take on the Elder Guardian that dwells in the Ocean Monument!",
		"",
		"I wonder if a Nautilus with a Spear would be useful in this fight?"
	],
	quest.737D54A425278A9C.quest_desc: [
		"The Dust Wastelands are a lonely, empty biome.",
		"",
		"It only contains End Stone Dust."
	],
	quest.739CA8433FBB8704.title: "otherside",
	quest.73D2FA92D3D6D291.quest_desc: [
		"Aquaculture adds new fish, preparation methods, and fishing tools to your world.",
		"",
		"It also adds new fishing treasure loot including Neptunium Armor and Tools."
	],
	quest.73D2FA92D3D6D291.title: "Aquaculuture",
	quest.740D04F3053B1C09.quest_desc: [
		"The Tackle Box allows you customize your Fishing Rod with bait, hooks, bobbers, and fishing line.",
		"",
		"It also has a small storage area."
	],
	quest.74145C55415B2787.quest_desc: [
		"A Minecraft Beacon within 8 blocks of a storage terminal  will extend the range of Wireless and Advanced Wireless Terminals based on the level.",
		"",
		"Lvl 1: Same dimension access",
		"Lvl 4: Any dimension access"
	],
	quest.7540B1CD8CE6A76D.quest_desc: [
		"Ender Shards are dropped by mining Ender Ore.",
		"",
		"They are used in the anvil to create Ender Dust."
	],
	quest.75D7356AF2977DBB.quest_desc: [
		"The Pyromancer's Staff can light fires, shoot blaze fire, and shoot ghast fireballs.",
		"",
		"It also has the Salamander's Eye effect, which can be disabled by shift + right-clicking.",
		"",
		"It uses Blaze Powder and Firecharges as fuel depending on which fire you want to shoot."
	],
	quest.761832FDD9D0F962.quest_desc: [
		"A Ruined Portal?",
		"",
		"In the End?",
		"",
		"Interesting..."
	],
	quest.76621AA3FEAEA212.quest_desc: [
		"The Bobber is a cosmetic addition to your Fishing Rod.",
		"",
		"Place it with any color dye in a crafting grid to dye it."
	],
	quest.77523D9C173C5A55.quest_desc: [
		"Consult the Wildex for taming information.",
		"",
		"The Lion can roar which makes all nearby mobs run away.",
		"",
		"It will eat meat from the ground to heal."
	],
	quest.7792DD1F04E52034.quest_desc: ["Inventory Trim is a block that can be used to connect inventories that have a space between them."],
	quest.78A1EE2113B8BF9A.title: "mellohi",
	quest.7924C0BA5BF2DA14.quest_desc: [
		"Backpacked provides a unique and customizable backpack experience.",
		"",
		"Instead of upgrading your backpack with resources, you use experience to unlock storage slots, augment slots, and slots to wear more backpacks!",
		"",
		"In addition, you unlock backpack styles by completing different objectives within your world!",
		"",
		"All objectives are listed within the backpack itself."
	],
	quest.7924C0BA5BF2DA14.title: "Backpacked",
	quest.79360F35BD93F7F7.title: "5",
	quest.7953F751DFB201F8.quest_desc: [
		"Consult the Wildex for taming information.",
		"",
		"Sea Otters are slower on land than water.",
		"",
		"They will assist you in combat."
	],
	quest.79D2D3E7FA79D89E.quest_desc: ["An ingredient in various different Burger Mod recipes."],
	quest.7A33EA2983C87487.quest_desc: [
		"When held in your main hand or off-hand, the Aurora Lanter provides immunity to the darkness debuff.",
		"",
		"Comes in pretty handy in the Deep Dark."
	],
	quest.7A7F8BC6CD6855A8.quest_desc: [
		"The Drawer Key locks and unlocks drawers.",
		"",
		"This will keep an item locked to a drawer even if you've used the last one."
	],
	quest.7AA3D8DF938596EF.quest_desc: [
		"The Worm Farm is used like a Composter.",
		"",
		"Once filled, the Worm Farm will generate worms that you can use as bait."
	],
	quest.7AB694A7FA8F327D.quest_desc: [
		"Nether Ruby drops from mining the respective ore.",
		"",
		"It is used to make powerful gear."
	],
	quest.7AD9555B7B668BAE.quest_desc: ["Find the mysterious Pale Garden to encounter the Creaking!"],
	quest.7AE3C306893D95C1.quest_desc: ["An additional food item offered by the Burger Mod."],
	quest.7BB70E51F0B988E0.quest_desc: [
		"The Charm Belt stores any mob charms that you craft.",
		"",
		"A Charm is an item crafted that prevents that specific mob from noticing you.",
		"",
		"For example, Zombies will ignore you when you have a Zombie Charm equipped."
	],
	quest.7C303A0D9279B7AF.quest_subtitle: "BetterEnd",
	quest.7C303A0D9279B7AF.title: "Endseeker",
	quest.7C4949FDF78CEEB0.quest_desc: ["The Treat Bag is used to feed your pup from a distance!"],
	quest.7C94C068C2708887.quest_desc: ["16x base storage value for the drawer."],
	quest.7CE329532B63BFE1.quest_desc: [
		"Special Reliquary component that has a small chance to drop when killing a snow golem.",
		"",
		"They also have a small chance to be found in loot chests."
	],
	quest.7D72F38F8F6B9354.quest_desc: [
		"Thallasium is a useful resource mined from Thallasium ore!",
		"",
		"However, it does require a few steps to use.",
		"",
		"Thallasium has stats similar to Iron."
	],
	quest.7DBA420E68B972AB.quest_desc: [
		"&bShimmerweave Goggles&r:",
		"Makes nearby hostile mobs glow.",
		"",
		"&bShimmerweave Tunic&r:",
		"Automatically extinguishes fire.",
		"",
		"&bShimmerweave Leggings&r:",
		"Speed boost on snow and soul sand.",
		"",
		"&bShimmerweave Skates&r:",
		"Ice Skating, Frost Walker, lava to obsidian, fall immunity on ice."
	],
	quest.7DBA420E68B972AB.title: "Shimmerweave Armor Set",
	quest.7E283931DF2DB2DB.quest_desc: ["Destroys excess items in the drawer."],
	quest.7E4D2A82CB8FA9A6.quest_desc: [
		"Consult the Wildex for taming information.",
		"",
		"When tamed, the Crow will assist in combat.",
		"",
		"It will also pick up and bring you items from the ground."
	],
	quest.7E607483486D0100.quest_desc: [
		"Craft 1 Infusion Pedestal and 8 regular Pedestals of your choice.",
		"",
		"Place the 8 Pedestals around the Infusion Pedestal in a circle.",
		"",
		"There should be a 2 block space between the Infusion Pedestal and each Pedestal in a cardinal direction."
	],
	quest.7E607483486D0100.title: "Infusion Pedestals",
	quest.7EB72850C77D1F4F.quest_desc: [
		"Consult the Wildex for taming information.",
		"",
		"The Sugar Glider will scream if you are being targeted by a mob."
	],
	quest.7ECE56C45F39A318.quest_desc: [
		"Special Reliquary component that has a small chance to drop when killing a bat.",
		"",
		"They also have a small chance to be found in loot chests."
	],
	quest.7F24014BB805B6C8.title: "blocks",
	quest.7F65BCE896221499.quest_desc: ["8x base storage value for the drawer."],
	quest.7F7FDCC70AAC0E12.quest_subtitle: "Additional Additions",
	quest.7F7FDCC70AAC0E12.title: "1007",
	quest.7FCA4141749799C8.quest_desc: ["The Glow Stick is a throwable light source that also works underwater!"],
	quest.7FD459CAD0996DB6.quest_desc: [
		"A wide assortment of burgers and sides are available to craft through The Burger Mod!",
		"",
		"These are the ones made with pork."
	],
	quest.7FD459CAD0996DB6.title: "Pork Burgers",
	quest.7FE1599B2BB5F9C3.quest_desc: [
		"Sublime is a modpack focused on the beauty of the world with a touch of magic!",
		"",
		"This includes animals, structures, animations and so much more.",
		"",
		"While not everything in the world is friendly, most hostile encounters occur when you decide they should.",
		"",
		"Enjoy!"
	],
