				id: "67786B99B8015936"
				item: {
					components: {
						"minecraft:writable_book_content": {
							pages: [
								{
									raw: "this was a man......, who once lived , who once had a life , but what is he now , what im i looking at , nothing but a lump of meat that screams at me trying to cause hurt.\n\nIt begins as a hushed frequency, a tremor in the collective pulse.\n\n"
								}
								{
									raw: "It does not break the skin; it dissolves the boundary between self and echo. To witness it is to become it—a silent inheritance passed through a glance, turning every shared breath into a sacred, terminal communion."
								}
							]
						}
					}
					count: 1
					id: "minecraft:writable_book"
