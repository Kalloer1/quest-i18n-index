{
	chapter.0C77713C9E0486E8.title: " &a&lChapter 2"
	chapter.49001691E87B5D90.title: " &a&lChapter 1"
	file.0000000000000001.title: " &f&lFantasy RPG"
	quest.006FA8D32BD64B60.quest_desc: ["&fThe &anecropolis ballista &fis a massive ranged &aweapon &fwith incredible power. &fIt cannot be crafted and must be found within dangerous structures or dropped by bosses. &fIts shots can devastate enemies with ease. &fA weapon worthy of legends."]
	quest.006FA8D32BD64B60.quest_subtitle: "&7Unleash siege-level destruction"
	quest.006FA8D32BD64B60.title: "&5&lQuest: &r&eNecropolis Ballista"
	quest.007E858026484EFC.quest_desc: ["&fHidden within the remains of a fallen dragon lies a source of immense &apower. &fBy extracting the &aice dragon heart &fyou obtain a crucial component for advanced forging. &fThis rare item is required to craft the &adragonforge core &finfused with ice. &fOnly those who endure the cold can claim such a powerful artifact."]
	quest.007E858026484EFC.quest_subtitle: "&7Claim the Ice Dragon's essence"
	quest.007E858026484EFC.title: "&5&lQuest: &r&eHeart of the Frozen Core"
	quest.02694EAE2D26B2C2.quest_subtitle: "&7Find the End Ship"
	quest.02694EAE2D26B2C2.title: "&5&lQuest: &r&eEnd Ship"
	quest.029137AD5A2BE2BF.quest_desc: ["&fThe &aAqua Set &fis a magical armor forged mainly from &akelp, &fchanneling the calm yet relentless force of water. &fWhile wearing it, your &awater power &fis increased by &a25%, &fmaking it an excellent choice for mages who follow the tides. &fUnlike the basic Elemental Set, this armor can be &aupgraded &fusing &anetherite &fand a special smithing template. &fIts true strength is revealed to those who refine it beyond its original form."]
	quest.029137AD5A2BE2BF.quest_subtitle: "&7Craft armor infused with the power of water"
	quest.029137AD5A2BE2BF.title: "&5&lQuest: &r&eAqua Set"
	quest.034243CD7B4F44DC.quest_desc: ["&fIn the depths of darkness hunts the deadly &anight prowler, &fa creature empowered by the night. &fIts speed and unpredictability make it a dangerous &athreat. &fStay &acareful &fand do not let the shadows consume you. &fOnly the prepared can survive its hunt."]
	quest.034243CD7B4F44DC.quest_subtitle: "&7Defeat the shadow of the night"
	quest.034243CD7B4F44DC.title: "&5&lQuest: &r&eNight Prowler"
	quest.04F49A7F4A58EA2B.quest_desc: ["&fFrom rare resources comes a weapon of pure &apower. &fThe &anightfall &frequires &averglas &fand a soul to be forged. &fIts dark energy enhances your combat potential. &fOnly those who embrace the shadows can wield it."]
	quest.04F49A7F4A58EA2B.quest_subtitle: "&7Craft a weapon of darkness"
	quest.04F49A7F4A58EA2B.title: "&5&lQuest: &r&eNightfall"
	quest.054225F80316E273.quest_desc: ["&fFrom the darkest places comes the &ashadow assassin scythe, &fa deadly and rare &aweapon. &fIt cannot be crafted and must be discovered or obtained from bosses. &fIts strikes are swift and lethal. &fA perfect tool for those who move unseen."]
	quest.054225F80316E273.quest_subtitle: "&7Claim the weapon of silent death"
	quest.054225F80316E273.title: "&5&lQuest: &r&eShadow Assassin Scythe"
	quest.05460276F04B2ACA.quest_desc: ["&fA powerful &aChaos Monarch &femerges as a dangerous threat, wielding chaotic magic and dark &apower. &fThis undead sorcerer can summon deadly &aminions &fduring battle to overwhelm you. &fStay &aalert &fand control the fight before it spirals out of control. &fDefeating it will prove your strength against chaos itself."]
	quest.05460276F04B2ACA.quest_subtitle: "&7Defeat the undead sorcerer of chaos"
	quest.05460276F04B2ACA.title: "&5&lQuest: &r&eChaos Monarch"
	quest.057C250E40DA00FD.quest_desc: ["&fUnlike common relics, &aWater Orb &fdoes not grant direct stat increases. &fInstead, it may activate temporary &acombat effects &fduring battle that can prove decisive in the right moment. &fIt is a rare relic obtained only from &aloot chests &for by defeating dangerous &abosses."]
	quest.057C250E40DA00FD.quest_subtitle: "&7Obtain a relic with powerful combat effects"
	quest.057C250E40DA00FD.title: "&5&lQuest: &r&eWater Orb"
	quest.057E6C48BA6A16CA.quest_desc: ["&fWith the force of flames behind it, this tool grants unmatched &apower. &fThe &afire dragonsteel pickaxe &fmines through even the toughest materials with great &aefficiency. &fNothing can resist its heated strength. &fIt turns effort into ease."]
	quest.057E6C48BA6A16CA.quest_subtitle: "&7Craft a fire dragonsteel pickaxe"
	quest.057E6C48BA6A16CA.title: "&5&lQuest: &r&eFire Dragonsteel Pickaxe"
	quest.058B503F8EC03093.quest_desc: ["&fUnlike common relics, &aEagle Eye &foffers no simple stat bonus. &fIts power lies in temporary &acombat effects &fthat can trigger at key moments, giving you an important edge in battle. &fIt can only be found in &aloot chests &for by defeating mighty &abosses."]
	quest.058B503F8EC03093.quest_subtitle: "&7Obtain a relic with powerful combat effects"
	quest.058B503F8EC03093.title: "&5&lQuest: &r&eEagle Eye"
	quest.05974470BFFABD60.quest_desc: ["&fThe &aDripstone Necklace &fis a more common magical accessory that offers modest but useful bonuses. &fIt increases your &amaximum health &fand enhances your &areflect attack, &fmaking it a solid choice for survivability and counterattacks."]
	quest.05974470BFFABD60.quest_subtitle: "&7Craft a simple necklace with defensive power"
	quest.05974470BFFABD60.title: "&5&lQuest: &r&eDripstone Necklace"
	quest.0631DED46464FF7D.quest_subtitle: "&7Find the Bandit Towers"
	quest.0631DED46464FF7D.title: "&5&lQuest: &r&eBandit Towers"
	quest.06BE56E7F4F434C1.quest_subtitle: "&7Find the Better Fortresses"
	quest.06BE56E7F4F434C1.title: "&5&lQuest: &r&eBetter Fortresses"
	quest.06F4E47FE20759A3.quest_subtitle: "&7Obtain the Corrupted Eye"
	quest.06F4E47FE20759A3.title: "&5&lQuest: &r&eCorrupted Eye"
	quest.088FB81B8E9EA695.quest_desc: ["&fTo face the dangers of this world, you will need proper &aprotection. &fIron can be found within &amountains &for deep inside caves just below the surface. &fWith enough of it, you can craft a full set of &airon armor &fto greatly increase your chances of survival. &fA well-equipped adventurer is far harder to defeat."]
	quest.088FB81B8E9EA695.quest_subtitle: "&7Strength for the battles ahead"
	quest.088FB81B8E9EA695.title: "&5&lQuest: &r&eForged in Iron"
	quest.08A5846B61398655.quest_desc: ["&fHidden in dangerous places lies the &acataclysm's edge, &fa weapon of pure &apower. &fIt can only be obtained through exploration or defeating strong enemies. &fIts destructive force is unmatched. &fFew are worthy of wielding it."]
	quest.08A5846B61398655.quest_subtitle: "&7Obtain a weapon of destruction"
	quest.08A5846B61398655.title: "&5&lQuest: &r&eCataclysm's Edge"
	quest.0917C53E63C92D1F.quest_subtitle: "&7Obtain a gemstone mined from varied magical ores"
	quest.0917C53E63C92D1F.title: "&5&lQuest: &r&eSapphire"
	quest.091FC3DD9FE241D3.quest_subtitle: "&7Craft an upgraded staff empowered by air and netherite"
	quest.091FC3DD9FE241D3.title: "&5&lQuest: &r&eNetherite Wind Staff"
	quest.094F662AE0616188.quest_desc: ["&fWith &aSapphire, &fyou can craft sturdy rings and necklaces that increase your &amaximum health. &fThese accessories provide greater survivability for adventurers who must endure the dangers ahead."]
	quest.094F662AE0616188.quest_subtitle: "&7Craft rings and necklaces that increase maximum health"
	quest.094F662AE0616188.title: "&5&lQuest: &r&eSapphire Accessories"
	quest.0A3BCCC02B9FC2F9.quest_desc: ["&fBeyond steel and strength, this vast world is filled with ancient &amagic &fwaiting to be uncovered. &fYou will explore mysterious places, face powerful &abosses &fand uncover hidden secrets. &fAlong the way, you will obtain enchanted &agear &fwith abilities tied to different elements. &fThose who master these forces will wield powers beyond imagination."]
	quest.0A3BCCC02B9FC2F9.quest_subtitle: "&7Discover the magic within the world"
	quest.0A3BCCC02B9FC2F9.title: "&5&lQuest: &r&eArcane Awakening"
	quest.0AFD63767C5BB8B1.quest_subtitle: "&7Find the Catacombs"
	quest.0AFD63767C5BB8B1.title: "&5&lQuest: &r&eCatacombs"
	quest.0BC03E0589949994.quest_desc: ["&fThe &aNetherite Aqua Set &fcan be reforged into its final &aAscended form &fby using the &aSuperior Armor &fsmithing template and the rare &aWarden's Lost Crystal. &fThis powerful crystal can be found in loot chests or obtained by defeating mighty foes such as the &aWarden &for the &aEnder Dragon. &fOnce upgraded, the set gains an additional &a5% &fwater power, raising its total bonus from &a30% to 35%. &fThis is the true pinnacle of armor for those who master the tides."]
	quest.0BC03E0589949994.quest_subtitle: "&7Forge the ultimate form of water armor"
	quest.0BC03E0589949994.title: "&5&lQuest: &r&eAscended Aqua Set"
	quest.0C6A70C1719A8075.quest_desc: ["&fThe &aNetherite Terra Set &fcan be reforged into its final &aAscended form &fby using the &aSuperior Armor &fsmithing template and the rare &aWarden's Lost Crystal. &fThis powerful crystal can be found in loot chests or obtained by defeating mighty foes such as the &aWarden &for the &aEnder Dragon. &fOnce upgraded, the set gains an additional &a5% &fearth power, raising its total bonus from &a30% to 35%. &fThose whose will is as unshakable as stone will uncover the final strength hidden within."]
	quest.0C6A70C1719A8075.quest_subtitle: "&7Forge the ultimate form of earth armor"
	quest.0C6A70C1719A8075.title: "&5&lQuest: &r&eAscended Terra Set"
	quest.0C757ED3FA6A4992.quest_desc: ["&fBy merging refined netherite with iron, you unlock a new level of &apower. &fThe &anetherite-iron ingot &fallows you to upgrade your equipment even further. &fArmor enhanced with it grants increased &aresistance &fand a unique ability against phantoms. &fEven the skies will no longer threaten you."]
	quest.0C757ED3FA6A4992.quest_subtitle: "&7Combine strength and resilience"
	quest.0C757ED3FA6A4992.title: "&5&lQuest: &r&eNetherite-Iron Ingot"
	quest.0D7C8B4F7DDAAFEA.quest_subtitle: "&7Find the Abandoned Temple"
	quest.0D7C8B4F7DDAAFEA.title: "&5&lQuest: &r&eAbandoned Temple"
	quest.0D8A93494D61C1A5.quest_subtitle: "&7Obtain the Rogue Eye"
	quest.0D8A93494D61C1A5.title: "&5&lQuest: &r&eRogue Eye"
	quest.0DF6B45977ABBC29.quest_desc: ["&fWith this fusion, your gear reaches a new level of &apower. &fUpgrade your armor using the &anetherite-emerald ingot &fto improve its &aresistance. &fThis set lets you face endermen without fear. &fEven their gaze cannot challenge you."]
	quest.0DF6B45977ABBC29.quest_subtitle: "&7Upgrade your armor with emerald fusion"
	quest.0DF6B45977ABBC29.title: "&5&lQuest: &r&eNetherite-Emerald Armor"
	quest.0E534C747F5DE1F2.quest_desc: ["&fHarnessing the energy of fire, even farming gains new &apower. &fThe &afire dragonsteel hoe &fprepares land with unmatched &aefficiency. &fIt ensures your resources grow as steadily as your strength. &fMastery extends beyond the battlefield."]
	quest.0E534C747F5DE1F2.quest_subtitle: "&7Craft a fire dragonsteel hoe"
	quest.0E534C747F5DE1F2.title: "&5&lQuest: &r&eFire Dragonsteel Hoe"
	quest.0EF1224480AE5C14.quest_desc: ["&fDeep within the champion's tomb rests the feared &aDraugr, &fan ancient warrior bound to undeath. &fThough it does not possess great &ahealth, &fit wields a blade that grows stronger depending on the time of day. &fStay &aalert &fand choose your moment wisely to strike. &fDefeating it will prove your skill against a seasoned fighter."]
	quest.0EF1224480AE5C14.quest_subtitle: "&7Defeat the fallen Draugr warrior"
	quest.0EF1224480AE5C14.title: "&5&lQuest: &r&eOld Champion"
	quest.0F387AF5DBF5F171.quest_subtitle: "&7Craft a wand infused with the power of earth"
	quest.0F387AF5DBF5F171.title: "&5&lQuest: &r&eTerra Wand"
	quest.0F72DD9205AE4757.quest_desc: ["&fEmpowered by icy essence, this tool holds great &apower. &fThe &aice dragonsteel axe &fdelivers strong blows with controlled &astrength. &fIt performs well in both combat and gathering. &fIts cold edge cuts clean and true."]
	quest.0F72DD9205AE4757.quest_subtitle: "&7Craft an ice dragonsteel axe"
	quest.0F72DD9205AE4757.title: "&5&lQuest: &r&eIce Dragonsteel Axe"
	quest.106870ECE1AF1459.quest_subtitle: "&7Find the Skeleton Dungeon"
	quest.106870ECE1AF1459.title: "&5&lQuest: &r&eSkeleton Dungeon"
	quest.1082FFD35DF5ED60.quest_desc: ["&fBy reforging the &aWind Set &fwith &anetherite &fand a special smithing template, you can unlock its stronger &aNetherite form. &fThis upgraded armor keeps its connection to the skies while amplifying its elemental power. &fIts air power bonus rises from &a25% to 30%, &fgranting an additional &a5% &fcompared to the base set. &fOnly those who follow the currents can truly awaken its full potential."]
	quest.1082FFD35DF5ED60.quest_subtitle: "&7Upgrade your air armor with netherite"
	quest.1082FFD35DF5ED60.title: "&5&lQuest: &r&eNetherite Wind Set"
	quest.108990BC7FDF2D43.quest_desc: ["&fScattered across the world are unique &arelics &fwith forms inspired by ancient creatures. &fThese items grant powerful &abonus &fto both magical and physical abilities. &fIf you choose the path of magic, you must carefully decide which &astats &fto enhance based on your element. &fTrue mastery comes from understanding your power."]
	quest.108990BC7FDF2D43.quest_subtitle: "&7Harness the power of mystical artifacts"
	quest.108990BC7FDF2D43.title: "&5&lQuest: &r&eAncient Relics"
	quest.110FE8E77484E7CB.quest_desc: ["&fDeep within hidden caves lies the fearsome &afire dragon, a creature of immense power and destruction. &fIts &aflames &fcan reduce even the strongest warriors to ashes in seconds. &fTo face it, you must be fully &aprepared &fand ready for a brutal battle. &fDefeating this beast will prove your strength and mark the beginning of your legend."]
	quest.110FE8E77484E7CB.quest_subtitle: "&7Defeat the Fire Dragon"
	quest.110FE8E77484E7CB.title: "&5&lQuest: &r&eFlame Conqueror"
	quest.1187CC93697EDA75.quest_desc: ["&fBefore facing the dangers of the night, you must be properly &aprepared. &fUsing iron, you can craft a reliable &aweapon &fcapable of dealing with hostile creatures. &fAn &airon sword &fwill greatly increase your chances in combat. &fEvery warrior needs a blade to begin their journey."]
	quest.1187CC93697EDA75.quest_subtitle: "&7Craft your first Iron Sword"
	quest.1187CC93697EDA75.title: "&5&lQuest: &r&eBlade of Survival"
	quest.118F0E846E2979F1.quest_desc: ["&fInfused with blazing energy, this tool holds immense &apower. &fThe &afire dragonsteel axe &fstrikes with powerful force and great &astrength. &fWhether in battle or gathering, it excels in every task. &fIts flames leave nothing standing for long."]
	quest.118F0E846E2979F1.quest_subtitle: "&7Craft a fire dragonsteel axe"
	quest.118F0E846E2979F1.title: "&5&lQuest: &r&eFire Dragonsteel Axe"
	quest.11BA1BF6F62B947C.quest_subtitle: "&7Find the Lightning Dragon Cave"
	quest.11BA1BF6F62B947C.title: "&5&lQuest: &r&eLightning Dragon Cave"
	quest.1271A813F44C2E77.quest_subtitle: "&7Obtain a gemstone mined from varied magical ores"
	quest.1271A813F44C2E77.title: "&5&lQuest: &r&eRuby"
	quest.12A05CD6CD93149A.quest_desc: ["&fUnder the burning light roams the fearsome &aday stalker, &fa relentless entity of great &apower. &fIts presence dominates the battlefield with overwhelming strength. &fYou must remain &aalert &fand endure its relentless attacks. &fDefeating it proves your dominance even under the light."]
	quest.12A05CD6CD93149A.quest_subtitle: "&7Defeat the hunter of the daylight"
	quest.12A05CD6CD93149A.title: "&5&lQuest: &r&eDay Stalker"
	quest.12EA3B6EB90BB838.quest_desc: ["&fThe fusion of netherite and emerald results in a unique source of &apower. &fThe &anetherite-emerald ingot &fcan enhance your equipment beyond its limits. &fArmor upgraded with it grants high &aresistance &fand lets you look at endermen without provoking them. &fEven the End bends to your presence."]
	quest.12EA3B6EB90BB838.quest_subtitle: "&7Face the gaze of the End"
	quest.12EA3B6EB90BB838.title: "&5&lQuest: &r&eNetherite-Emerald Ingot"
	quest.12F20AEAB62CC89A.quest_desc: ["&fAmong the greatest beings of this world are the &adragons, &fcreatures of immense &apower &fand presence. &fThey can be raised and nurtured, allowing you to obtain valuable &ascales &fused with their essence. &fThese are essential to craft dragonsteel equipment. &fMastering them marks your transition into a new stage of strength."]
	quest.12F20AEAB62CC89A.quest_subtitle: "&7Majestic creatures of fire, ice and storm"
	quest.12F20AEAB62CC89A.title: "&5&lQuest: &r&eDragons of Power"
	quest.13407EFF82852D86.quest_desc: ["&fAs night falls, the most common threat begins to appear. &fThe slow but relentless &azombies &fwill test your ability to survive. &fDefeat at least 10 of them to prove your growing &astrength &fin combat. &fEvery battle fought brings you closer to mastering this world."]
	quest.13407EFF82852D86.quest_subtitle: "&7Defeat 10 Zombies"
	quest.13407EFF82852D86.title: "&5&lQuest: &r&eFirst Blood"
	quest.135FB1F74ABD49F6.quest_desc: ["&fNot all enemies fight up close. &fThe deadly &askeletons &fattack from a distance with precise arrows. &fDefeat 10 of them to improve your &areflexes &fand combat awareness. &fLearning to close the gap is key to survival."]
	quest.135FB1F74ABD49F6.quest_subtitle: "&7Defeat 10 Skeletons"
	quest.135FB1F74ABD49F6.title: "&5&lQuest: &r&eBones to Dust"
	quest.136593EE0835DFF7.quest_desc: ["&fFrom the depths rises the colossal &ablackstone golem, &fa being of immense &apower. &fIts hardened body grants extreme &aresistance &fagainst most attacks. &fEach step it takes shakes the ground beneath you. &fOnly the strongest can bring down this ancient guardian."]
	quest.136593EE0835DFF7.quest_subtitle: "&7Defeat the ancient stone guardian"
	quest.136593EE0835DFF7.title: "&5&lQuest: &r&eBlackstone Golem"
	quest.1377085EF11DE06C.quest_subtitle: "&7Find the Medieval Nether Dome"
	quest.1377085EF11DE06C.title: "&5&lQuest: &r&eNether Dome"
	quest.13C148CEB016F289.quest_desc: ["&fIn the cold depths of isolated caves dwells the terrifying &aice dragon, a master of frost and control. &fIts freezing breath can slow and weaken any unprepared adventurer. &fOnly those who are truly &aprepared &fcan survive this encounter. &fDefeat this creature and claim victory over the power of ice."]
	quest.13C148CEB016F289.quest_subtitle: "&7Defeat the Ice Dragon"
	quest.13C148CEB016F289.title: "&5&lQuest: &r&eFrozen Tyrant"
	quest.13C441D6C39F2A85.quest_desc: ["&fSome weapons cannot be crafted, only &adiscovered. &fThe &achampion's greatsword &fcan be found within ancient structures or dropped by powerful foes. &fIt carries immense &apower &ffrom past battles. &fOnly true explorers will claim such a weapon."]
	quest.13C441D6C39F2A85.quest_subtitle: "&7Find the blade of a fallen hero"
	quest.13C441D6C39F2A85.title: "&5&lQuest: &r&eChampion's Greatsword"
	quest.13D94D233C5758CE.quest_subtitle: "&7Craft a staff that channels the four primal elements"
	quest.13D94D233C5758CE.title: "&5&lQuest: &r&eElemental Staff"
	quest.142267F6259A23DD.quest_subtitle: "&7Find the Lich Tower"
	quest.142267F6259A23DD.title: "&5&lQuest: &r&eLich Tower"
	quest.1680B36E09F7CEC7.quest_desc: ["&fWithin a Nether arena lies the fearsome &agauntlet, &fa creature of overwhelming &apower. &fIts explosive strength and ranged attacks can quickly defeat you if you stay &aclose. &fTo damage it, you must find and break its &aweak point &fhidden at its center. &fOnly then will the true battle begin."]
	quest.1680B36E09F7CEC7.quest_subtitle: "&7Defeat the explosive powerhouse"
	quest.1680B36E09F7CEC7.title: "&5&lQuest: &r&eThe Gauntlet"
	quest.16E835D6D0202CFB.quest_subtitle: "&7Obtain a magical wand infused with water power"
	quest.16E835D6D0202CFB.title: "&5&lQuest: &r&eAqua Wand"
	quest.1A30DEC773ACC378.quest_desc: ["&fInfused with the force of storms, this tool carries immense &apower. &fThe &alightning dragonsteel axe &fdelivers fast and powerful strikes with great &astrength. &fIt excels in both combat and gathering tasks. &fIts speed makes it truly deadly."]
	quest.1A30DEC773ACC378.quest_subtitle: "&7Craft a lightning dragonsteel axe"
	quest.1A30DEC773ACC378.title: "&5&lQuest: &r&eLightning Dragonsteel Axe"
	quest.1BBDD61F838504C8.quest_desc: ["&fFrom the defeat of a powerful ruler, you obtain a relic of pure &apower. &fThe &acape of chaos &fgrants immunity to &adecay &fand spreads withering energy to nearby enemies. &fIts presence weakens all who stand too close. &fOnly those who conquer chaos can truly wield it."]
	quest.1BBDD61F838504C8.quest_subtitle: "&7Claim the mantle of the Chaos Monarch"
	quest.1BBDD61F838504C8.title: "&5&lQuest: &r&eCape of Chaos"
	quest.1C4420ABC41A44D3.quest_desc: ["&fBeyond physical weapons, this world offers powerful &amagic &ftools such as staffs and wands. &fMany can be crafted using natural or mining &aresources, &fwhile others require rare weapons obtained from loot or bosses. &fEach one channels a unique elemental &apower &fin combat. &fChoosing the right weapon defines your path as a mage."]
	quest.1C4420ABC41A44D3.quest_subtitle: "&7Master staffs and elemental power"
	quest.1C4420ABC41A44D3.title: "&5&lQuest: &r&eArcane Weapons"
	quest.1C8432EFE6BE62AD.quest_subtitle: "&7Find the Castle"
	quest.1C8432EFE6BE62AD.title: "&5&lQuest: &r&eCastle"
	quest.1CB944AF5C182C55.quest_subtitle: "&7Obtain the Evil Eye"
	quest.1CB944AF5C182C55.title: "&5&lQuest: &r&eEvil Eye"
	quest.1E5AF41F805FB326.quest_desc: ["&fAfter facing common enemies, you will need stronger &aprotection &fto survive what comes next. &fCrafting a full set of &adiamond armor &fwill greatly increase your chances in dangerous encounters. &fMore powerful &amobs &fcan be found within structures and dungeons, rarely on the surface. &fOnly a well-prepared adventurer can face these threats."]
	quest.1E5AF41F805FB326.quest_subtitle: "&7Prepare for greater threats"
	quest.1E5AF41F805FB326.title: "&5&lQuest: &r&eDiamond Protection"
	quest.1E8BBE86DD78EAFE.quest_desc: ["&fUnlike common relics, &aLiandry's Torment &fdoes not grant simple stat bonuses. &fInstead, it can trigger powerful temporary &acombat effects &fthat may turn the tide of battle. &fThese rare relics are only found in &aloot chests &for by defeating mighty &abosses."]
	quest.1E8BBE86DD78EAFE.quest_subtitle: "&7Obtain a relic with powerful combat effects"
	quest.1E8BBE86DD78EAFE.title: "&5&lQuest: &r&eLiandry's Torment"
	quest.1EA122C765D18EF9.quest_desc: ["&fInfused with the force of storms, this tool carries immense &apower. &fThe &alightning dragonsteel axe &fdelivers fast and powerful strikes with great &astrength. &fIt excels in both combat and gathering tasks. &fIts speed makes it truly deadly."]
	quest.1EA122C765D18EF9.quest_subtitle: "&7Craft a lightning dragonsteel axe"
	quest.1EA122C765D18EF9.title: "&5&lQuest: &r&eLightning Dragonsteel Axe"
	quest.1EAF64D5AC3942D1.quest_desc: ["&fThe &asoul reaper &fis a dark entity that feeds on the essence of others. &fIts attacks carry a dangerous &apower &fthat can weaken your defenses. &fYou must stay &aalert &fand avoid prolonged combat. &fDefeating it will free the souls it has taken."]
	quest.1EAF64D5AC3942D1.quest_subtitle: "&7Defeat the harvester of souls"
	quest.1EAF64D5AC3942D1.title: "&5&lQuest: &r&eSoul Reaper"
	quest.1EB21423DDA5CE47.quest_desc: ["&fThe &aNetherite Wind Set &fcan be reforged into its final &aAscended form &fby using the &aSuperior Armor &fsmithing template and the rare &aWarden's Lost Crystal. &fThis powerful crystal can be found in loot chests or obtained by defeating mighty foes such as the &aWarden &for the &aEnder Dragon. &fOnce upgraded, the set gains an additional &a5% &fair power, raising its total bonus from &a30% to 35%. &fOnly those who truly command the skies can unlock its ultimate potential."]
	quest.1EB21423DDA5CE47.quest_subtitle: "&7Forge the ultimate form of air armor"
	quest.1EB21423DDA5CE47.title: "&5&lQuest: &r&eAscended Wind Set"
	quest.1F81E2CAD0E789C2.quest_subtitle: "&7Find the Ice Dragon Cave"
	quest.1F81E2CAD0E789C2.title: "&5&lQuest: &r&eIce Dragon Cave"
	quest.1FAF617A2FB51609.quest_desc: ["&fAt the source of the void's energy lies the dangerous &avoid blossom. &fThis creature cannot be harmed by &aranged attacks &fsuch as bows, forcing you into close combat. &fBe extremely &acareful &fwhen approaching, as it is just as deadly up close. &fOnly those with true courage can destroy this entity."]
	quest.1FAF617A2FB51609.quest_subtitle: "&7Defeat the flower of the void"
	quest.1FAF617A2FB51609.title: "&5&lQuest: &r&eVoid Blossom"
	quest.1FB4F6D1A6B64CB7.quest_subtitle: "&7Craft a staff infused with the power of water"
	quest.1FB4F6D1A6B64CB7.title: "&5&lQuest: &r&eAqua Staff"
	quest.1FE13C2526457B5D.quest_subtitle: "&7Find the Coliseum"
	quest.1FE13C2526457B5D.title: "&5&lQuest: &r&eColiseum"
	quest.208D1A09FDB78090.quest_subtitle: "&7Craft a wand infused with the essence of water"
	quest.208D1A09FDB78090.title: "&5&lQuest: &r&eKelp Wand"
	quest.20F8853D790DC762.quest_desc: ["&fUnlike common relics, &aGuardian Angel &fdoes not focus on permanent stat bonuses. &fIts value comes from unique temporary &acombat effects &fthat can become decisive when survival is at stake. &fIt is a rare treasure found only in &aloot chests &for by defeating mighty &abosses."]
	quest.20F8853D790DC762.quest_subtitle: "&7Obtain a relic with powerful combat effects"
	quest.20F8853D790DC762.title: "&5&lQuest: &r&eGuardian Angel"
	quest.227631E14AED5DBB.quest_desc: ["&fAs you defeat enemies, some may drop mysterious &asoul stars &fholding fragments of their essence. &fThese items will guide you to hidden towers where greater challenges await. &fBy placing them on the &asummoning stones &fyou can call forth powerful bosses. &fKeep them safe, their &apower &fis the key to greater battles."]
	quest.227631E14AED5DBB.quest_subtitle: "&7Collect the essence of fallen enemies"
	quest.227631E14AED5DBB.title: "&5&lQuest: &r&eSoul Stars"
	quest.233C1A14B2AB44A7.quest_desc: ["&fWith the new ingot, you can enhance your gear with greater &apower. &fUpgrade your netherite armor using the &anetherite-iron ingot &fto increase its &aresistance. &fThis set grants a unique advantage against phantoms. &fThe skies will no longer hunt you."]
	quest.233C1A14B2AB44A7.quest_subtitle: "&7Upgrade your armor with iron fusion"
	quest.233C1A14B2AB44A7.title: "&5&lQuest: &r&eNetherite-Iron Armor"
	quest.247A895AE1BC5F20.quest_subtitle: "&7Obtain the Magical Eye"
	quest.247A895AE1BC5F20.title: "&5&lQuest: &r&eMagical Eye"
	quest.24A0C41727F6C469.quest_subtitle: "&7Craft an upgraded staff empowered by earth and netherite"
	quest.24A0C41727F6C469.title: "&5&lQuest: &r&eNetherite Terra Staff"
	quest.252F15FFDCD05BFB.quest_desc: ["&fTo control the fury of storms, you must construct the proper &astructure. &fBuild the forge and insert the &adragonforge core &fat its heart. &fA nearby &alightning dragon &fwill channel its energy to power the forge. &fOnly then will you unlock the ability to forge dragonsteel ingots."]
	quest.252F15FFDCD05BFB.quest_subtitle: "&7Activate the Lightning Dragonforge Core"
	quest.252F15FFDCD05BFB.title: "&5&lQuest: &r&eForge of Storms"
	quest.255FE43001933473.quest_subtitle: "&7Craft an upgraded wand empowered by earth and netherite"
	quest.255FE43001933473.title: "&5&lQuest: &r&eNetherite Terra Wand"
	quest.2570722C8252DD1F.quest_subtitle: "&7Find Typhon"
	quest.2570722C8252DD1F.title: "&5&lQuest: &r&eTyphon"
	quest.25A6230187C32032.quest_desc: ["&fBeyond the overworld lies the dangerous Nether, a land filled with &ahazards &fand rare resources. &fBy exploring it, you can find &aancient debris &fwhich can be refined using gold to create netherite ingots. &fThis material grants incredible &aresistance &fand durability. &fIt is essential for crafting the most powerful equipment."]
	quest.25A6230187C32032.quest_subtitle: "&7Forge power from the depths of the Nether"
	quest.25A6230187C32032.title: "&5&lQuest: &r&eNetherite Ingots"
	quest.25FC701CDEAB4A1B.quest_desc: ["&fAn unknown presence manifests as &athe eye, &fa mysterious entity filled with unnatural &apower. &fIts gaze alone can unsettle even the most experienced warriors. &fStay &aalert &fas its attacks are unpredictable and strange. &fFacing it means confronting something beyond understanding."]
	quest.25FC701CDEAB4A1B.quest_subtitle: "&7Face the watcher beyond reality"
	quest.25FC701CDEAB4A1B.title: "&5&lQuest: &r&eThe Eye"
	quest.267E78DBC994F074.quest_subtitle: "&7Obtain a gemstone mined from varied magical ores"
	quest.267E78DBC994F074.title: "&5&lQuest: &r&eAquamarine"
	quest.273B9D4F8D3163EB.quest_desc: ["&fHarnessing the power of ice requires more than strength, it demands the correct &astructure. &fAssemble the forge and place the &adragonforge core &fwithin it. &fA nearby &aice dragon &fmust channel its freezing breath to activate the forge. &fWith it, you will be able to craft powerful dragonsteel ingots."]
	quest.273B9D4F8D3163EB.quest_subtitle: "&7Activate the Ice Dragonforge Core"
	quest.273B9D4F8D3163EB.title: "&5&lQuest: &r&eForge of Frost"
	quest.27DF43C6040CFA80.quest_subtitle: "&7Find the Illager Fort"
	quest.27DF43C6040CFA80.title: "&5&lQuest: &r&eIllager Fort"
	quest.2854C49966AA0C9B.quest_desc: ["&fHidden within the world lies the &achampion's graves, &fa place filled with ancient &apower. &fIt is here where the &aOld Champion &frests, waiting for those brave enough to face him. &fYou must explore and stay &aalert &fto uncover its location. &fOnly then can you challenge the fallen warrior."]
	quest.2854C49966AA0C9B.quest_subtitle: "&7Find the resting place of a fallen warrior"
	quest.2854C49966AA0C9B.title: "&5&lQuest: &r&eChampion's Graves"
	quest.28801CEE374D7900.quest_desc: ["&fFrom the depths of nothingness emerges the &avoid shadow, &fa being of pure &apower. &fIt moves unpredictably and strikes with overwhelming force. &fYou must remain &aalert &fto survive its relentless attacks. &fDefeating it proves mastery over the darkest forces of this world."]
	quest.28801CEE374D7900.quest_subtitle: "&7Defeat the embodiment of the void"
	quest.28801CEE374D7900.title: "&5&lQuest: &r&eVoid Shadow"
	quest.291104A2B8752B12.quest_desc: ["&fFrom the darkest corners emerges the &anight shade, &fa spectral entity that ignores physical barriers. &fIt can pass through &awalls &fand strike when you least expect it. &fStay &aalert &fand rely on timing to face this elusive foe. &fDefeating it proves you can fight what cannot be touched."]
	quest.291104A2B8752B12.quest_subtitle: "&7Defeat the wandering specter"
	quest.291104A2B8752B12.title: "&5&lQuest: &r&eNight Shade"
	quest.29BC3F924F668D49.quest_subtitle: "&7Find the Lush Mineshaft"
	quest.29BC3F924F668D49.title: "&5&lQuest: &r&eLush Mineshaft"
	quest.2B276B6A77F698EA.quest_desc: ["&fThe &aViking Rune Ring &fis a sturdy accessory that strengthens both your &afury power &fand your &aattack damage. &fThough made from more common ingredients, it remains a valuable choice for aggressive fighters who favor direct combat."]
	quest.2B276B6A77F698EA.quest_subtitle: "&7Craft a ring that empowers fury and attack"
	quest.2B276B6A77F698EA.title: "&5&lQuest: &r&eViking Rune Ring"
	quest.2B31B827ADDFAD99.quest_desc: ["&fCombining netherite with gold creates a material of refined &apower. &fThe &anetherite-gold ingot &fenables powerful upgrades to your gear. &fArmor forged with it grants strong &aresistance &fand allows you to walk among piglins unnoticed. &fSometimes power comes with influence."]
	quest.2B31B827ADDFAD99.quest_subtitle: "&7Harness the favor of piglins"
	quest.2B31B827ADDFAD99.title: "&5&lQuest: &r&eNetherite-Gold Ingot"
	quest.2BA4641CC8C93C22.quest_desc: ["&fUnlike common relics, &aMikael's Blessing &frelies on special temporary &aeffects &frather than direct stat increases. &fThese rare powers may provide critical support when the battle reaches its hardest moments. &fIt can only be obtained from &aloot chests &for by defeating dangerous &abosses."]
	quest.2BA4641CC8C93C22.quest_subtitle: "&7Obtain a relic with powerful combat effects"
	quest.2BA4641CC8C93C22.title: "&5&lQuest: &r&eMikael's Blessing"
	quest.2BB3274032552981.quest_subtitle: "&7Obtain a gemstone mined from varied magical ores"
	quest.2BB3274032552981.title: "&5&lQuest: &r&eTopaz"
	quest.2BBE4CFC2982897F.quest_desc: ["&fFrom the cold remains of ancient beasts comes a power few can control. &fThe legendary &adragonsteel armor &fof ice grants unmatched &adefense &fand resilience against the harshest threats. &fWearing it proves you have overcome the fury of a &aice dragon &fand claimed your place among the greatest hunters."]
	quest.2BBE4CFC2982897F.quest_subtitle: "&7Power forged from ice and conquest"
	quest.2BBE4CFC2982897F.title: "&5&lQuest: &r&eFrozen Dominion"
	quest.2BC61E872AC3391C.quest_desc: ["&fForged from dark essence, this weapon grants immense &apower. &fThe &adarkin blade &fcan disable &ashields &fand steal life from enemies with each strike. &fIt also unleashes a devastating &aimpact &fwhen you leap and strike the ground near your target. &fIt requires the &abloodthirster &fto be crafted, evolving it into something far more dangerous."]
	quest.2BC61E872AC3391C.quest_subtitle: "&7Forge a weapon of overwhelming power"
	quest.2BC61E872AC3391C.title: "&5&lQuest: &r&eDarkin Blade"
	quest.2EA410C222994E3E.quest_desc: ["&fOnly those who have faced and defeated mighty dragons can wield such &apower. &fThe legendary &adragonsteel armor &fforged from fire dragon essence offers unmatched &aresistance &fand strength. &fCrafting it proves you are no longer a mere survivor, but a feared &adragon hunter &fwhose name echoes across the land."]
	quest.2EA410C222994E3E.quest_subtitle: "&7Proof of a true dragon hunter"
	quest.2EA410C222994E3E.title: "&5&lQuest: &r&eDragonsteel Ascension"
	quest.2F1574B643B77BD9.quest_desc: ["&fWith netherite in your hands, you can now create equipment of immense &apower. &fCraft a full set of &anetherite armor &fto gain exceptional &aresistance &fand durability. &fThis armor marks your transition into the late stages of your journey. &fFew threats will stand against you now."]
	quest.2F1574B643B77BD9.quest_subtitle: "&7Forge the strongest standard armor"
	quest.2F1574B643B77BD9.title: "&5&lQuest: &r&eNetherite Armor"
	quest.2F6B17FFF0F7B87B.quest_subtitle: "&7Obtain a gemstone mined from varied magical ores"
	quest.2F6B17FFF0F7B87B.title: "&5&lQuest: &r&eMalachite"
	quest.2FC0DD9001BF49D4.quest_desc: ["&fBy reforging the &aAqua Set &fwith &anetherite &fand a special smithing template, you can unlock its stronger &aNetherite form. &fThis upgraded armor preserves its bond with water while increasing its magical potential beyond the original design. &fIts water power bonus rises from &a25% to 30%, &fgranting an additional &a5% &fcompared to the base set. &fThose who master the tides will find even greater strength in its refined form."]
	quest.2FC0DD9001BF49D4.quest_subtitle: "&7Upgrade your water armor with netherite"
	quest.2FC0DD9001BF49D4.title: "&5&lQuest: &r&eNetherite Aqua Set"
	quest.2FFB3AD118E7EF89.quest_desc: ["&fForged with dark essence, this weapon grants a dangerous &apower. &fThe &abloodthirster &fallows you to steal &alife &ffrom your enemies with each strike. &fIn prolonged battles, this effect can keep you alive against strong foes. &fBut remember, such power often comes with a cost."]
	quest.2FFB3AD118E7EF89.quest_subtitle: "&7Craft a blade that feeds on life"
	quest.2FFB3AD118E7EF89.title: "&5&lQuest: &r&eBloodthirster"
	quest.302CBB6326DEB6AA.quest_subtitle: "&7Find the Fire Dragon Cave"
	quest.302CBB6326DEB6AA.title: "&5&lQuest: &r&eFire Dragon Cave"
	quest.32010EE9944EE079.quest_subtitle: "&7Obtain a gemstone mined from varied magical ores"
	quest.32010EE9944EE079.title: "&5&lQuest: &r&eTanzanite"
	quest.32084B1B5D5F4DE1.quest_desc: ["&fRoaming the Nether, the &apiglin beast &fis a fierce creature with immense &apower. &fIts aggressive nature and strong attacks make it a serious &athreat. &fStay &aprepared &fand do not underestimate its strength. &fOnly skilled fighters can bring it down."]
	quest.32084B1B5D5F4DE1.quest_subtitle: "&7Defeat the brute of the Nether"
	quest.32084B1B5D5F4DE1.title: "&5&lQuest: &r&ePiglin Beast"
	quest.320976F0B2DE2437.quest_desc: ["&fSilent and dangerous, the &acreepers &fare known for their explosive nature. &fOne mistake can cost you everything if you are not &acareful. &fDefeat 10 of them while avoiding their blasts. &fPrecision and timing will be your greatest allies."]
	quest.320976F0B2DE2437.quest_subtitle: "&7Defeat 10 Creepers"
	quest.320976F0B2DE2437.title: "&5&lQuest: &r&eUnstable Threat"
	quest.324F4E6D64BAEFCE.quest_desc: ["&fLurking in darkness, the swift &aspiders &fcan climb and strike from unexpected angles. &fDefeat 10 of them to sharpen your &aawareness &fand reaction speed. &fThe shadows hide many dangers, but you are learning to overcome them."]
	quest.324F4E6D64BAEFCE.quest_subtitle: "&7Defeat 10 Spiders"
	quest.324F4E6D64BAEFCE.title: "&5&lQuest: &r&eCreeping Shadows"
	quest.3280D1D090C4014B.quest_subtitle: "&7Obtain the Guardian Eye"
	quest.3280D1D090C4014B.title: "&5&lQuest: &r&eGuardian Eye"
	quest.33359EEDCEB83799.quest_desc: ["&fUnlike common relics, &aMardroeme Mushroom &fgrants no direct stat bonuses. &fInstead, it has a chance to activate unique temporary &aeffects &fduring combat that can dramatically change the outcome of battle. &fIt is only found in &aloot chests &for as a reward from powerful &abosses."]
	quest.33359EEDCEB83799.quest_subtitle: "&7Obtain a relic with powerful combat effects"
	quest.33359EEDCEB83799.title: "&5&lQuest: &r&eMardroeme Mushroom"
	quest.3385325B621AEBF3.quest_desc: ["&fThe &aTopaz Fox Figurine &fis a cunning relic filled with unstable magical energy. &fIt grants bonuses to both &aarcane &fand &afire power, &fmaking it a perfect choice for mages who wield destructive and unpredictable forces."]
	quest.3385325B621AEBF3.quest_subtitle: "&7Craft a relic with arcane and fire power"
	quest.3385325B621AEBF3.title: "&5&lQuest: &r&eTopaz Fox Figurine"
	quest.3405D83DD5F466A9.quest_desc: ["&fNot all enemies are as weak as the ones you faced before. &fThe &awithered demons &fpossess greater &ahealth &fand deal significant damage in combat. &fWith proper armor and preparation, they can be defeated. &fThese creatures may drop a valuable &ademon heart &fused with dark power."]
	quest.3405D83DD5F466A9.quest_subtitle: "&7Defeat these corrupted creatures"
	quest.3405D83DD5F466A9.title: "&5&lQuest: &r&eWithered Demons"
	quest.34B943D2D0C93EC8.quest_desc: ["&fTo begin forging your magical armor, you must first create the &aElemental Essence, &fa vital material infused with natural &apower. &fIt is crafted using resources gathered from the world, combining the raw energy of nature into a form that can be shaped. &fThis essence serves as the &afoundation &ffor creating mystical armor sets tied to elemental forces. &fMastering its creation is the first step toward becoming a true wielder of arcane power."]
	quest.34B943D2D0C93EC8.quest_subtitle: "&7Craft the foundation of magical armor"
	quest.34B943D2D0C93EC8.title: "&5&lQuest: &r&eElemental Essence"
	quest.34BA26247A7CAA4E.quest_desc: ["&fA being of pure corruption, the &aaccursed lord &fwields immense &apower. &fIts attacks are devastating and its presence alone inspires fear. &fYou must be fully &aprepared &fto face such a dark entity. &fDefeating it marks you as a conqueror of cursed forces."]
	quest.34BA26247A7CAA4E.quest_subtitle: "&7Defeat the ruler of the damned"
	quest.34BA26247A7CAA4E.title: "&5&lQuest: &r&eAccursed Lord"
	quest.35F915DFB3702475.quest_desc: ["&fThis rare &aweapon &fis known for its relentless nature in battle. &fThe &acrossbow of relentless strikes &fcan only be obtained through exploration or powerful enemies. &fIts attacks come with unmatched &apower. &fFew can endure its barrage."]
	quest.35F915DFB3702475.quest_subtitle: "&7Find the weapon of endless assault"
	quest.35F915DFB3702475.title: "&5&lQuest: &r&eCrossbow of Relentless Strikes"
	quest.39041C5B33C65D56.quest_desc: ["&fThe &aTanzanite Bat Figurine &fis a dark and mysterious relic infused with ancient magic. &fIt grants bonuses to both &aice &fand &asoul power, &fmaking it well suited for those who command cold, death and forgotten energies."]
	quest.39041C5B33C65D56.quest_subtitle: "&7Craft a relic with ice and soul power"
	quest.39041C5B33C65D56.title: "&5&lQuest: &r&eTanzanite Bat Figurine"
	quest.39193A0865895BC5.quest_desc: ["&fAmong the harsh lands emerges the towering &afrost giant, &fa being of immense &apower. &fIts icy abilities can freeze you in place and drain your &astrength &fover time. &fYou must be well &aprepared &fto withstand the cold and its devastating attacks. &fOnly the strongest can bring down this frozen titan."]
	quest.39193A0865895BC5.quest_subtitle: "&7Defeat the frozen colossus"
	quest.39193A0865895BC5.title: "&5&lQuest: &r&eFrost Giant"
	quest.39467EC3658E9529.quest_desc: ["&fThe &aNetherite Viking Rune Ring &fis the stronger evolution of the Viking Rune Ring. &fIt grants higher bonuses to both &afury power &fand &aattack damage, &fmaking it a superior option for those who seek greater offensive strength."]
	quest.39467EC3658E9529.quest_subtitle: "&7Craft an upgraded ring with greater fury power"
	quest.39467EC3658E9529.title: "&5&lQuest: &r&eNetherite Viking Rune Ring"
	quest.39585ED1C7BFEDF9.quest_desc: ["&fThe &aNetherite Viking Rune Necklace &fis the enhanced form of the Viking Rune Necklace. &fIt provides stronger bonuses to both &afury power &fand &aattack damage, &foffering a greater edge to warriors who embrace relentless combat."]
	quest.39585ED1C7BFEDF9.quest_subtitle: "&7Craft an upgraded necklace with greater fury power"
	quest.39585ED1C7BFEDF9.title: "&5&lQuest: &r&eNetherite Viking Rune Necklace"
	quest.39B0ACDD8BC77EFF.quest_desc: ["&fAs battles grow tougher, you will need stronger &adefense. &fThe &adiamond kite shield &foffers high durability and powerful &aparry potential. &fEquipped in your off-hand, it increases your &aarmor &fand survivability. &fA true companion for dangerous encounters."]
	quest.39B0ACDD8BC77EFF.quest_subtitle: "&7Strong protection for serious fights"
	quest.39B0ACDD8BC77EFF.title: "&5&lQuest: &r&eDiamond Kite Shield"
	quest.3A1031A6BCEB368F.quest_desc: ["&fIn intense combat, a good defense is as important as &aattack. &fThe &airon kite shield &foffers solid protection and allows you to perform &aparry &fwith proper timing. &fEquipping it in your off-hand grants extra &aarmor &fto increase your survivability. &fA dependable tool for any adventurer."]
	quest.3A1031A6BCEB368F.quest_subtitle: "&7A reliable defense for early battles"
	quest.3A1031A6BCEB368F.title: "&5&lQuest: &r&eIron Kite Shield"
	quest.3B9D025A5F85B890.quest_subtitle: "&7Find the Sand Ruins"
	quest.3B9D025A5F85B890.title: "&5&lQuest: &r&eSand Ruins"
	quest.3BC417C3DC08B6C3.quest_desc: ["&fUnlike common relics, &aZhonya's Hourglass &fdoes not simply raise your stats. &fIts strength lies in special temporary &acombat effects &fthat may save you in the most dangerous moments. &fSuch relics are only obtained through &aloot chests &for by defeating fearsome &abosses."]
	quest.3BC417C3DC08B6C3.quest_subtitle: "&7Obtain a relic with powerful combat effects"
	quest.3BC417C3DC08B6C3.title: "&5&lQuest: &r&eZhonya's Hourglass"
	quest.3C104C829238FFC5.quest_desc: ["&fSome equipment cannot be crafted, only &adiscovered. &fThe &avalkyrie bulwark &fcan be found within hidden structures across the world. &fIt offers exceptional &adefense &fand powerful parry capabilities. &fOnly true explorers will uncover this legendary shield."]
	quest.3C104C829238FFC5.quest_subtitle: "&7A legendary shield lost in the world"
	quest.3C104C829238FFC5.title: "&5&lQuest: &r&eValkyrie Bulwark"
	quest.3C5CB85ADC81812E.quest_desc: ["&fForged in freezing conditions, this weapon carries immense &apower. &fThe &aice dragonsteel sword &fstrikes with chilling force against any foe. &fIts frozen edge enhances your &astrength &fin combat. &fFew can withstand its icy bite."]
	quest.3C5CB85ADC81812E.quest_subtitle: "&7Craft an ice dragonsteel sword"
	quest.3C5CB85ADC81812E.title: "&5&lQuest: &r&eIce Dragonsteel Blade"
	quest.3ED25FF2A92E459B.quest_subtitle: "&7Craft an upgraded wand empowered by water and netherite"
	quest.3ED25FF2A92E459B.title: "&5&lQuest: &r&eNetherite Aqua Wand"
	quest.3FB30581D261AC71.quest_desc: ["&fThe &areturning knight &fis no ordinary foe, as it refuses to fall like others. &fDriven by an unknown &apower, &fit returns to battle even after being defeated. &fYou must remain &acareful &fand finish the fight completely. &fOnly then will you prove your strength against an unending will."]
	quest.3FB30581D261AC71.quest_subtitle: "&7Defeat the warrior who rises again"
	quest.3FB30581D261AC71.title: "&5&lQuest: &r&eReturning Knight"
	quest.3FC76C05C4AE61A6.quest_desc: ["&fWith the power of &aElemental Essence, &fyou can now forge the &aElemental Set, &fa magical armor bound to the four primal forces of &awater, fire, earth &fand &aair. &fWhile wearing it, your elemental power is increased by &a20% &facross all four elements, making it a versatile choice for any aspiring mage. &fHowever, this set cannot be &aupgraded, &fso its strength remains fixed. &fIt is a balanced beginning for those who wish to walk the path of elemental mastery."]
	quest.3FC76C05C4AE61A6.quest_subtitle: "&7Craft armor attuned to the four primal elements"
	quest.3FC76C05C4AE61A6.title: "&5&lQuest: &r&eElemental Set"
	quest.400DE2D959ABF7FF.quest_subtitle: "&7Obtain a gemstone mined from varied magical ores"
	quest.400DE2D959ABF7FF.title: "&5&lQuest: &r&eCitrine"
	quest.404ADC4BFA035F60.quest_desc: ["&fEven the ground yields to the power of flames. &fThe &afire dragonsteel shovel &flets you gather materials with incredible &aefficiency. &fIts heated edge cuts through terrain effortlessly. &fNo obstacle will slow your progress."]
	quest.404ADC4BFA035F60.quest_subtitle: "&7Craft a fire dragonsteel shovel"
	quest.404ADC4BFA035F60.title: "&5&lQuest: &r&eFire Dragonsteel Shovel"
	quest.408E27085B089B4F.quest_desc: ["&fYou find yourself in a &amedieval &fand &amagical &fworld, filled with forgotten lands and untold stories. &fAcross vast landscapes lie &adungeons &fwaiting to be uncovered, each hiding dangers and rewards alike. &fBeware of the many &amonsters &fthat roam these lands, for they guard treasures of great value. &fFrom breathtaking views to hidden secrets, this world is yours to explore... if you are prepared."]
	quest.408E27085B089B4F.quest_subtitle: "&7A land of mystery and freedom"
	quest.408E27085B089B4F.title: "&5&lQuest: &r&eA World Unwritten"
	quest.424CCEA5C211E705.quest_desc: ["&fUnlike common relics, &aShurelya's Battlesong &fgrants unique temporary &abattle effects &finstead of simple stat increases. &fWhen activated, these effects can provide the momentum needed to overcome a deadly encounter. &fIt can only be found in &aloot chests &for by defeating powerful &abosses."]
	quest.424CCEA5C211E705.quest_subtitle: "&7Obtain a relic with powerful combat effects"
	quest.424CCEA5C211E705.title: "&5&lQuest: &r&eShurelya's Battlesong"
	quest.42A845A769C241AC.quest_subtitle: "&7Obtain the Nether Eye"
	quest.42A845A769C241AC.title: "&5&lQuest: &r&eNether Eye"
	quest.44F58F4BFA9718B0.quest_desc: ["&fA weapon touched by celestial forces, the &astar's edge &fholds incredible &apower. &fIt cannot be crafted and must be found in rare locations or dropped by bosses. &fIts origin is unknown, but its strength is undeniable. &fA true relic of the cosmos."]
	quest.44F58F4BFA9718B0.quest_subtitle: "&7Wield the power of the stars"
	quest.44F58F4BFA9718B0.title: "&5&lQuest: &r&eStar's Edge"
	quest.45079188E318EDEA.quest_desc: ["&fThe &aMalachite Honeybadger &fis a magical relic shaped after a fierce creature of the wild. &fLike other malachite artifacts, it grants bonuses to &aearth &fand &anature power, &fmaking it a strong choice for those who draw strength from the natural world."]
	quest.45079188E318EDEA.quest_subtitle: "&7Craft a relic with earth and nature power"
	quest.45079188E318EDEA.title: "&5&lQuest: &r&eMalachite Honeybadger"
	quest.4568E9B62DF93174.quest_subtitle: "&7Find the Medieval Nether Castle"
	quest.4568E9B62DF93174.title: "&5&lQuest: &r&eNether Castle"
	quest.45A7CD1FBAA4BE00.quest_desc: ["&fUnlike common relics, &aFrozen Heart &fdoes not simply increase your attributes. &fInstead, it may activate temporary &acombat effects &fthat can greatly influence the outcome of battle. &fIt is a rare relic found only in &aloot chests &for by defeating powerful &abosses."]
	quest.45A7CD1FBAA4BE00.quest_subtitle: "&7Obtain a relic with powerful combat effects"
	quest.45A7CD1FBAA4BE00.title: "&5&lQuest: &r&eFrozen Heart"
	quest.462343F7F192DC30.quest_desc: ["&fUnlike common relics, &aSunfire Cape &frelies on unique activation effects rather than permanent stat increases. &fIts temporary &abattle bonuses &fcan provide a crucial advantage when the fight grows desperate. &fIt can only be obtained from &aloot chests &for by defeating powerful &abosses."]
	quest.462343F7F192DC30.quest_subtitle: "&7Obtain a relic with powerful combat effects"
	quest.462343F7F192DC30.title: "&5&lQuest: &r&eSunfire Cape"
	quest.4625249140E8D920.quest_subtitle: "&7Craft a wand infused with the power of air"
	quest.4625249140E8D920.title: "&5&lQuest: &r&eWind Wand"
	quest.46C1D46B66E3F0B7.quest_desc: ["&fThe &aMetallic Wolf Figurine, &fforged with &aRuby, &fis a relic that embodies aggression and strength. &fLike other ruby artifacts, it increases your &aattack power, &fmaking it an ideal companion for warriors and offensive battlemages."]
	quest.46C1D46B66E3F0B7.quest_subtitle: "&7Craft a relic that enhances attack power"
	quest.46C1D46B66E3F0B7.title: "&5&lQuest: &r&eMetallic Wolf Figurine"
	quest.471AE7F1EADFAE98.quest_desc: ["&fThrough a complex process, the &amolten demon heart &fcan be shaped into a &ademonite chunk &fand then smelted into a powerful ingot. &fThe &acrimson ingot &fholds immense &apower &fand is used to craft dark weapons and armor. &fThese grant strong &aresistance &fagainst dangerous creatures. &fOnly those who master darkness can wield it."]
	quest.471AE7F1EADFAE98.quest_subtitle: "&7Refine the essence of dark power"
	quest.471AE7F1EADFAE98.title: "&5&lQuest: &r&eCrimson Ingot"
	quest.474126736E2361AE.quest_desc: ["&fNot all threats rely on brute &apower. &fThe &agorgon &fpossesses a deadly gaze capable of turning enemies to stone. &fYou must stay &acareful &fand avoid direct eye contact during battle. &fEven a moment of distraction can seal your fate."]
	quest.474126736E2361AE.quest_subtitle: "&7Defeat the petrifying creature"
	quest.474126736E2361AE.title: "&5&lQuest: &r&eGorgon"
	quest.4824D1083EDF1153.quest_desc: ["&fThe &aCitrine Cat Figurine &fis a radiant relic tied to warmth and restoration. &fIt enhances both &alight &fand &ahealing power, &fmaking it especially valuable for healers, protectors and supportive spellcasters."]
	quest.4824D1083EDF1153.quest_subtitle: "&7Craft a relic with light and healing power"
	quest.4824D1083EDF1153.title: "&5&lQuest: &r&eCitrine Cat Figurine"
	quest.48BD253D590E0C00.quest_desc: ["&fWith &aJade, &fyou can craft magical rings and necklaces that increase your &aranged damage. &fThese accessories are especially useful for hunters, archers and those who strike from afar."]
	quest.48BD253D590E0C00.quest_subtitle: "&7Craft rings and necklaces that enhance ranged damage"
	quest.48BD253D590E0C00.title: "&5&lQuest: &r&eJade Accessories"
	quest.49518C79FAA4A5E5.quest_desc: ["&fThrough the use of ancient methods, you can infuse greater &apower &finto existing relics. &fBy upgrading the &ahallowheart &fin a smithing table using a &asoul &fand a template, it transforms into something far stronger. &fThe infused version grants high &aresistance &fand immunity to certain negative effects. &fIt is a true blessing for those who endure great battles."]
	quest.49518C79FAA4A5E5.quest_subtitle: "&7Enhance a relic with sacred power"
	quest.49518C79FAA4A5E5.title: "&5&lQuest: &r&eInfused Hallowheart"
	quest.4A2A0828E3539A9E.quest_subtitle: "&7Craft an upgraded staff empowered by water and netherite"
	quest.4A2A0828E3539A9E.title: "&5&lQuest: &r&eNetherite Aqua Staff"
	quest.4AEDE2E56F86C72B.quest_desc: ["&fEven in death, a dragon's body retains incredible &apower. &fBy using a bottle, you can gather the valuable &adragon blood &ffrom its remains. &fThe blood of a &alightning dragon &fis required to forge advanced dragonsteel. &fIt pulses with energy, as if the storm still lives within it."]
	quest.4AEDE2E56F86C72B.quest_subtitle: "&7Extract the blood of a Lightning Dragon"
	quest.4AEDE2E56F86C72B.title: "&5&lQuest: &r&eEssence of Storms"
	quest.4AF2BE5CFDA1FFA1.quest_desc: ["&fThe remains of a fallen dragon still carry immense &apower. &fWith a simple bottle, you can collect the rare &adragon blood &ffrom its corpse. &fThe blood of an &aice dragon &fis essential to craft powerful dragonsteel. &fIts cold essence holds a strength that few can withstand."]
	quest.4AF2BE5CFDA1FFA1.quest_subtitle: "&7Extract the blood of an Ice Dragon"
	quest.4AF2BE5CFDA1FFA1.title: "&5&lQuest: &r&eEssence of Frost"
	quest.4D8978ECD90EF9FA.quest_desc: ["&fWithin the remains of a defeated dragon lies a core of immense &apower. &fBy extracting the &alightning dragon heart &fyou gain a vital component for advanced forging. &fThis rare item is required to craft the &adragonforge core &finfused with lightning. &fIts energy still crackles within, waiting to be unleashed."]
	quest.4D8978ECD90EF9FA.quest_subtitle: "&7Claim the Lightning Dragon's essence"
	quest.4D8978ECD90EF9FA.title: "&5&lQuest: &r&eHeart of the Storm"
	quest.4EB0C35C39A96C78.quest_desc: ["&fEmpowered by storm energy, this tool grants incredible &apower. &fThe &alightning dragonsteel pickaxe &fbreaks blocks with unmatched &aefficiency. &fIts energy surges through every strike. &fNothing can stand in its path for long."]
	quest.4EB0C35C39A96C78.quest_subtitle: "&7Craft a lightning dragonsteel pickaxe"
	quest.4EB0C35C39A96C78.title: "&5&lQuest: &r&eLightning Dragonsteel Pickaxe"
	quest.4F1B85F60B664841.quest_desc: ["&fWithin the remains of a fallen dragon lies a source of immense &apower. &fBy carefully extracting the &afire dragon heart &fwith the right tools, you obtain a vital component for advanced forging. &fThis rare item is required to craft the &adragonforge core &fused with fire energy. &fOnly true hunters can claim such a prize from the ashes of a dragon."]
	quest.4F1B85F60B664841.quest_subtitle: "&7Claim the Fire Dragon's core"
	quest.4F1B85F60B664841.title: "&5&lQuest: &r&eHeart of the Inferno"
	quest.4F42A18E7820B10A.quest_desc: ["&fFrom the remains of a powerful foe, you can claim true &apower. &fUsing the &acrown of the Chaos Monarch, &fa netherite helmet and a &atemplate, &fyou can forge the Chaos Helmet. &fThis piece grants powerful &abuffs &fand strong resistance against damage. &fOnly those who conquer chaos can wear it."]
	quest.4F42A18E7820B10A.quest_subtitle: "&7Forge the crown of chaos"
	quest.4F42A18E7820B10A.title: "&5&lQuest: &r&eChaos Helmet"
	quest.4FE322FF4275ADBF.quest_desc: ["&fWith &aAquamarine, &fyou can craft mystical rings and necklaces that strengthen the forces of &awater &fand &aair. &fThese accessories favor agile spellcasters who command flowing and adaptive elements."]
	quest.4FE322FF4275ADBF.quest_subtitle: "&7Craft rings and necklaces with water and air power"
	quest.4FE322FF4275ADBF.title: "&5&lQuest: &r&eAquamarine Accessories"
	quest.502E770CE254A637.quest_desc: ["&fThis is the peak of equipment &apower. &fUsing the &anetherite-diamond ingot &fyou can upgrade your armor to its highest form. &fIt grants unmatched &aresistance &fand combines all special abilities into one set. &fYou have become nearly unstoppable."]
	quest.502E770CE254A637.quest_subtitle: "&7Achieve the ultimate armor set"
	quest.502E770CE254A637.title: "&5&lQuest: &r&eNetherite-Diamond Armor"
	quest.51720365D24038F6.quest_subtitle: "&7Find the Gauntlet Arena"
	quest.51720365D24038F6.title: "&5&lQuest: &r&eGauntlet Arena"
	quest.5239CEE1A959744C.quest_subtitle: "&7Obtain the Witch Eye"
	quest.5239CEE1A959744C.title: "&5&lQuest: &r&eWitch Eye"
	quest.52D21F8CE9580AB5.quest_subtitle: "&7Find the Wishing Well"
	quest.52D21F8CE9580AB5.title: "&5&lQuest: &r&eWishing Well"
	quest.53A0D1C3658C8311.quest_desc: ["&fHidden within rare and dangerous caves awaits the mighty &alightning dragon, a creature fueled by the energy of storms. &fIts devastating strikes can overwhelm even the strongest defenses. &fYou must be fully &aprepared &fand ready to endure its fury. &fDefeating it will prove your mastery against the forces of the storm."]
	quest.53A0D1C3658C8311.quest_subtitle: "&7Defeat the Lightning Dragon"
	quest.53A0D1C3658C8311.title: "&5&lQuest: &r&eStormbreaker"
	quest.54FD2D9E0412BFEF.quest_desc: ["&fWith &aTopaz, &fyou can craft enchanted rings and necklaces that empower both &aarcane &fand &afire magic. &fThese accessories are well suited for mages who wield destructive and unstable forces."]
	quest.54FD2D9E0412BFEF.quest_subtitle: "&7Craft rings and necklaces with arcane and fire power"
	quest.54FD2D9E0412BFEF.title: "&5&lQuest: &r&eTopaz Accessories"
	quest.55C947C290797168.quest_desc: ["&fThe &aSapphire Turtle Figurine &fis a sturdy relic that represents endurance and protection. &fIt increases your &amaximum health, &fgranting greater survivability for adventurers who must withstand the dangers of battle."]
	quest.55C947C290797168.quest_subtitle: "&7Craft a relic that increases maximum health"
	quest.55C947C290797168.title: "&5&lQuest: &r&eSapphire Turtle Figurine"
	quest.563CA31B0E757EE7.quest_desc: ["&fDeep within the End awaits the mysterious &aobsidilith, &fa being of immense &apower. &fIts hardened form grants it powerful &adefense &fthat cannot be easily broken. &fYou must discover its &aweakness &fand exploit it to deal damage. &fOnly those who understand its nature can bring it down."]
	quest.563CA31B0E757EE7.quest_subtitle: "&7Defeat the obsidian entity of the End"
	quest.563CA31B0E757EE7.title: "&5&lQuest: &r&eObsidilith"
	quest.572D13E9035E58C3.quest_desc: ["&fWith &aRuby, &fyou can craft powerful rings and necklaces that strengthen your &aattack power. &fThese accessories are perfect for warriors and battlemages who rely on raw offensive strength."]
	quest.572D13E9035E58C3.quest_subtitle: "&7Craft rings and necklaces that enhance attack power"
	quest.572D13E9035E58C3.title: "&5&lQuest: &r&eRuby Accessories"
	quest.5756A8188D44CEF2.quest_desc: ["&fThe power of a dragon can be shaped, but only through the right &astructure. &fBuild the forge using the required blocks and place the &adragonforge core &fat its center. &fA nearby &afire dragon &fmust fuel it with its flames to bring the forge to life. &fOnly then can you create the legendary dragonsteel ingots."]
	quest.5756A8188D44CEF2.quest_subtitle: "&7Activate the Fire Dragonforge Core"
	quest.5756A8188D44CEF2.title: "&5&lQuest: &r&eForge of Flames"
	quest.575DDB7EC69AAEFD.quest_subtitle: "&7Obtain a magical staff infused with earth power"
	quest.575DDB7EC69AAEFD.title: "&5&lQuest: &r&eTerra Staff"
	quest.5775E9EE864A56FF.quest_desc: ["&fThe &aCactus Ring &fis a simple magical accessory crafted from common materials. &fLike the Dripstone Necklace, it increases your &amaximum health &fand improves your &areflect attack, &foffering reliable protection in battle."]
	quest.5775E9EE864A56FF.quest_subtitle: "&7Craft a simple ring with defensive power"
	quest.5775E9EE864A56FF.title: "&5&lQuest: &r&eCactus Ring"
	quest.58057B81D0B34EDA.quest_desc: ["&fTo reach the End, you must collect a set of unique &aeyes &fscattered across the world. &fSome can be crafted, while others are obtained from &abosses &for found in hidden loot. &fThese relics hold ancient &apower &fand are required to activate the portal. &fOnly those who gather them all may enter the unknown."]
	quest.58057B81D0B34EDA.quest_subtitle: "&7Gather the keys to another dimension"
	quest.58057B81D0B34EDA.title: "&5&lQuest: &r&eEyes of the End"
	quest.58082B7F30B1E8B2.quest_desc: ["&fEven frozen ground bends to this &apower. &fThe &aice dragonsteel shovel &flets you gather materials with smooth &aefficiency. &fIts edge glides through terrain with ease. &fNo surface can resist its touch."]
	quest.58082B7F30B1E8B2.quest_subtitle: "&7Craft an ice dragonsteel shovel"
	quest.58082B7F30B1E8B2.title: "&5&lQuest: &r&eIce Dragonsteel Shovel"
	quest.58594C42A7BA0C99.quest_desc: ["&fUnlike common relics, &aMejai's Soulstealer &fdoes not grant simple stat bonuses. &fInstead, it can trigger powerful temporary &acombat effects &fthat may become decisive in difficult encounters. &fThese rare relics are only found in &aloot chests &for by defeating mighty &abosses."]
	quest.58594C42A7BA0C99.quest_subtitle: "&7Obtain a relic with powerful combat effects"
	quest.58594C42A7BA0C99.title: "&5&lQuest: &r&eMejai's Soulstealer"
	quest.58745A37B0FCBF9C.quest_subtitle: "&7Obtain a gemstone mined from varied magical ores"
	quest.58745A37B0FCBF9C.title: "&5&lQuest: &r&eJade"
	quest.5913CBDF971DA3AF.quest_desc: ["&fThrough rare materials, you can forge weapons of immense &apower. &fThe &agaleforce &frequires &averglas &fand a soul to be crafted. &fThis weapon embodies speed and precision in combat. &fOnly those who master movement can wield it effectively."]
	quest.5913CBDF971DA3AF.quest_subtitle: "&7Craft a weapon of wind and speed"
	quest.5913CBDF971DA3AF.title: "&5&lQuest: &r&eGaleforce"
	quest.596C6DD71B1273DC.quest_subtitle: "&7Obtain a magical staff infused with air power"
	quest.596C6DD71B1273DC.title: "&5&lQuest: &r&eWind Staff"
	quest.59DF477034F980C5.quest_desc: ["&fAs night falls, the world becomes far more &adangerous &fand unforgiving. &fHostile creatures emerge from the shadows, making survival much harder for an unprepared adventurer. &fCrafting a &abed &fwill allow you to skip the night and face the world under safer conditions. &fA moment of &arest &fcan be the difference between life and death."]
	quest.59DF477034F980C5.quest_subtitle: "&7Avoid the dangers of the night"
	quest.59DF477034F980C5.title: "&5&lQuest: &r&eRest for the Journey"
	quest.5A9D4360688BBC9C.quest_desc: ["&fThe ultimate fusion of materials creates unmatched &apower. &fThe &anetherite-diamond ingot &fcombines the strengths of all previous variants. &fArmor enhanced with it grants maximum &aresistance &fand protection against multiple threats. &fYou now stand above nearly all dangers."]
	quest.5A9D4360688BBC9C.quest_subtitle: "&7Unite all powers into one"
	quest.5A9D4360688BBC9C.title: "&5&lQuest: &r&eNetherite-Diamond Ingot"
	quest.5B6B7191047CE7A6.quest_desc: ["&fAfter defeating a dragon, its body still holds great &apower. &fUsing a bottle, you can extract the precious &adragon blood &ffrom its remains. &fThe blood of a &afire dragon &fis a key component to forge the legendary dragonsteel. &fHandle it carefully, for it contains the essence of pure destruction."]
	quest.5B6B7191047CE7A6.quest_subtitle: "&7Extract the blood of a Fire Dragon"
	quest.5B6B7191047CE7A6.title: "&5&lQuest: &r&eEssence of Flame"
	quest.5BB399A6E44864FF.quest_desc: ["&fBy reforging the &aTerra Set &fwith &anetherite &fand a special smithing template, you can unlock its stronger &aNetherite form. &fThis upgraded armor deepens its bond with the earth, granting greater resilience and magical force. &fIts earth power bonus rises from &a25% to 30%, &fgranting an additional &a5% &fcompared to the base set. &fThose who stand firm like stone will uncover the true strength hidden within."]
	quest.5BB399A6E44864FF.quest_subtitle: "&7Upgrade your earth armor with netherite"
	quest.5BB399A6E44864FF.title: "&5&lQuest: &r&eNetherite Terra Set"
	quest.5C3039C93C56B3DC.quest_desc: ["&fInfused with the strength of frost, this tool grants great &apower. &fThe &aice dragonsteel pickaxe &fbreaks through materials with remarkable &aefficiency. &fEven the hardest blocks yield to its frozen edge. &fIt is a tool of precision and endurance."]
	quest.5C3039C93C56B3DC.quest_subtitle: "&7Craft an ice dragonsteel pickaxe"
	quest.5C3039C93C56B3DC.title: "&5&lQuest: &r&eIce Dragonsteel Pickaxe"
	quest.5CD8BBEF84EE998B.quest_desc: ["&fTo reach the peak of defense, you must enhance your gear with &apower. &fUpgrade your &adiamond kite shield &fusing it with netherite using a &atemplate. &fThe result grants superior durability, stronger &aparry &fand increased &aarmor. &fThis shield is built for the most intense battles."]
	quest.5CD8BBEF84EE998B.quest_subtitle: "&7Upgrade your shield to ultimate defense"
	quest.5CD8BBEF84EE998B.title: "&5&lQuest: &r&eNetherite Kite Shield"
	quest.5D28F2DD31942A14.quest_desc: ["&fThe massive &acyclops &frelies on raw &apower &fto crush its enemies. &fIts immense size and strength make it a dangerous opponent. &fHowever, it has limited vision, giving you a chance if you stay &acareful. &fUse its weakness wisely to defeat it."]
	quest.5D28F2DD31942A14.quest_subtitle: "&7Defeat the one-eyed giant"
	quest.5D28F2DD31942A14.title: "&5&lQuest: &r&eCyclops"
	quest.5DD09E8FED928044.quest_subtitle: "&7Obtain the Lost Eye"
	quest.5DD09E8FED928044.title: "&5&lQuest: &r&eLost Eye"
	quest.5E38D8BE93C2A2A3.quest_desc: ["&fThe &aRuby Serpent Figurine &fis a magical relic infused with the fierce energy of ruby. &fIt strengthens your &aattack power, &foffering a reliable offensive bonus for those who prefer direct and deadly combat."]
	quest.5E38D8BE93C2A2A3.quest_subtitle: "&7Craft a relic that enhances attack power"
	quest.5E38D8BE93C2A2A3.title: "&5&lQuest: &r&eRuby Serpent Figurine"
	quest.5F86DC70784BDD56.quest_desc: ["&fAmong the rarest treasures are the &agreater relics, &fartifacts that grant exceptional &abuffs &ffor combat. &fThese powerful items cannot be crafted and are only found as &aloot &fin dungeons, structures or by defeating bosses. &fTheir strength can greatly enhance your capabilities. &fOnly the most determined will obtain them."]
	quest.5F86DC70784BDD56.quest_subtitle: "&7Discover artifacts of superior power"
	quest.5F86DC70784BDD56.title: "&5&lQuest: &r&eGreater Relics"
	quest.5F927A286E6F1EC8.quest_subtitle: "&7Obtain the Black Eye"
	quest.5F927A286E6F1EC8.title: "&5&lQuest: &r&eBlack Eye"
	quest.6034DA770A936A5E.quest_desc: ["&fAfter defeating the ancient &aDraugr, &fyou can claim its legendary &asword. &fThe &adraugr blade &fgrows stronger depending on the time of day, making it a unique &aweapon &fin combat. &fMastering its power requires awareness of your surroundings. &fOnly true warriors can wield it effectively."]
	quest.6034DA770A936A5E.quest_subtitle: "&7Claim the weapon of the fallen champion"
	quest.6034DA770A936A5E.title: "&5&lQuest: &r&eDraugr Blade"
	quest.60E5AE278DEA6407.quest_desc: ["&fThe &aAquamarine Koi-Carp Figurine &fis a mystical relic inspired by the graceful flow of water and wind. &fIt grants bonuses to both &awater &fand &aair power, &ffavoring spellcasters who rely on adaptable and fluid elemental magic."]
	quest.60E5AE278DEA6407.quest_subtitle: "&7Craft a relic with water and air power"
	quest.60E5AE278DEA6407.title: "&5&lQuest: &r&eAquamarine Koi-Carp Figurine"
	quest.6129CA3656FDB61A.quest_desc: ["&fFrom the remains of powerful enemies, you may obtain a &ademon heart &ffilled with dark energy. &fThis item can be used to craft the deadly &abloodlust &fweapon, capable of granting unique combat abilities. &fIt can also be smelted into a &amolten core &ffor further uses. &fHandle it carefully, its &apower &fis not without risk."]
	quest.6129CA3656FDB61A.quest_subtitle: "&7Harness the power of a fallen demon"
	quest.6129CA3656FDB61A.title: "&5&lQuest: &r&eDemon Heart"
	quest.619853CA47493C29.quest_desc: ["&fForged within crackling energy, this weapon holds immense &apower. &fThe &alightning dragonsteel sword &fstrikes with blinding speed and force. &fIts charged edge enhances your &astrength &fin combat. &fFew can react fast enough to survive its strikes."]
	quest.619853CA47493C29.quest_subtitle: "&7Craft a lightning dragonsteel sword"
	quest.619853CA47493C29.title: "&5&lQuest: &r&eLightning Dragonsteel Blade"
	quest.61A31F2DE255E080.quest_desc: ["&fEmpower your equipment with refined &apower. &fUsing the &anetherite-gold ingot &fyou can upgrade your netherite armor to gain more &aresistance. &fThis set allows you to move among piglins without conflict. &fNot all battles must be fought."]
	quest.61A31F2DE255E080.quest_subtitle: "&7Upgrade your armor with gold fusion"
	quest.61A31F2DE255E080.title: "&5&lQuest: &r&eNetherite-Gold Armor"
	quest.626BCAEBA9E3C71E.quest_subtitle: "&7Find the Scorched Mines"
	quest.626BCAEBA9E3C71E.title: "&5&lQuest: &r&eScorched Mines"
	quest.631AE9C90DF3E686.quest_subtitle: "&7Find the Gold Dungeon"
	quest.631AE9C90DF3E686.title: "&5&lQuest: &r&eGold Dungeon"
	quest.63C7172A3056E87F.quest_desc: ["&fThe &aTerra Set &fis forged mainly from &apointed dripstone, &fa material shaped by the enduring force of the earth. &fWhile wearing it, your &aearth power &fis increased by &a25%, &fmaking it the perfect armor for those who command stone and soil. &fLike the other elemental sets, it can be &aupgraded &fusing &anetherite &fand a special smithing template to unlock greater resilience. &fIts strength reflects the unshakable will of the land itself."]
	quest.63C7172A3056E87F.quest_subtitle: "&7Craft armor rooted in the strength of earth"
	quest.63C7172A3056E87F.title: "&5&lQuest: &r&eTerra Set"
	quest.63DB0533F92179A6.quest_desc: ["&fForged in the heart of blazing flames, this weapon carries immense &apower. &fThe &afire dragonsteel sword &funleashes devastating attacks upon your enemies. &fIts burning essence enhances your &astrength &fin battle. &fFew can stand against its heat."]
	quest.63DB0533F92179A6.quest_subtitle: "&7Craft a fire dragonsteel sword"
	quest.63DB0533F92179A6.title: "&5&lQuest: &r&eFire Dragonsteel Blade"
	quest.64D883B4FD2B4F64.quest_subtitle: "&7Obtain a magical staff infused with celestial power"
	quest.64D883B4FD2B4F64.title: "&5&lQuest: &r&eAether Staff"
	quest.65A98C0D6A3613E0.quest_desc: ["&fThe &aViking Rune Necklace &fgrants the same martial strength as its ring counterpart, enhancing both &afury power &fand &aattack damage. &fIt is a practical accessory for warriors who wish to strike harder in battle."]
	quest.65A98C0D6A3613E0.quest_subtitle: "&7Craft a necklace that empowers fury and attack"
	quest.65A98C0D6A3613E0.title: "&5&lQuest: &r&eViking Rune Necklace"
	quest.662D8F569B6BD694.quest_desc: ["&fAfter defeating the mighty &aEnder Dragon, &fit leaves behind a rare &atrophy. &fThe &adragon egg &fstands as proof of your victory and immense &apower. &fFew adventurers ever obtain such a prize. &fIt is a symbol of mastery over the End."]
	quest.662D8F569B6BD694.quest_subtitle: "&7Claim the ultimate trophy"
	quest.662D8F569B6BD694.title: "&5&lQuest: &r&eDragon Egg"
	quest.663384D3143F528F.quest_desc: ["&fWith &aCitrine, &fyou can craft radiant rings and necklaces that enhance the power of &alight &fand &ahealing. &fThese accessories are invaluable for those who protect, restore and support others in battle."]
	quest.663384D3143F528F.quest_subtitle: "&7Craft rings and necklaces with light and healing power"
	quest.663384D3143F528F.title: "&5&lQuest: &r&eCitrine Accessories"
	quest.66FDB49E583647DB.quest_desc: ["&fWith the calm strength of frost, even farming gains new &apower. &fThe &aice dragonsteel hoe &fprepares land with steady &aefficiency. &fIt brings balance and control to your resources. &fTrue mastery is found in every task."]
	quest.66FDB49E583647DB.quest_subtitle: "&7Craft an ice dragonsteel hoe"
	quest.66FDB49E583647DB.title: "&5&lQuest: &r&eIce Dragonsteel Hoe"
	quest.673BE7938F2A4D12.quest_desc: ["&fGuided by lunar energy, the &amoonknight &fis a disciplined and deadly &awarrior. &fIts precise attacks and control over battle make it a formidable opponent. &fStay &aalert &fand adapt to its fighting style. &fVictory against it proves true mastery in combat."]
	quest.673BE7938F2A4D12.quest_subtitle: "&7Defeat the warrior of the moon"
	quest.673BE7938F2A4D12.title: "&5&lQuest: &r&eMoonknight"
	quest.6791A45F45BD53A0.quest_desc: ["&fForged with powerful materials, this weapon holds great &apower. &fThe &aleviathan axe &frequires &averglas &fand a soul to be crafted. &fIts strikes carry overwhelming force and icy strength. &fA true weapon for those who dominate in battle."]
	quest.6791A45F45BD53A0.quest_subtitle: "&7Craft a weapon of frozen might"
	quest.6791A45F45BD53A0.title: "&5&lQuest: &r&eLeviathan Axe"
	quest.67E6BCE0683B1A00.quest_desc: ["&fA powerful &alich &fhas risen, twisting the world into endless night until it is defeated. &fThis undead mage is cunning and dangerous, capable of appearing &abehind you &fwhen you least expect it. &fStay &aalert &fand do not lower your guard during the battle. &fOnly by defeating it will the night finally end."]
	quest.67E6BCE0683B1A00.quest_subtitle: "&7Defeat the undead sorcerer"
	quest.67E6BCE0683B1A00.title: "&5&lQuest: &r&eThe Lich King"
	quest.68208905F4C81EF4.quest_desc: ["&fAmong the rarest weapons lies the &aheavy crossbow of the phoenix. &fThis powerful ranged &aweapon &fcan only be obtained through exploration or boss encounters. &fIt carries the essence of rebirth and destruction. &fA true treasure for any adventurer."]
	quest.68208905F4C81EF4.quest_subtitle: "&7Claim the power of rebirth"
	quest.68208905F4C81EF4.title: "&5&lQuest: &r&eHeavy Crossbow of the Phoenix"
	quest.685C19B56E3432F8.quest_desc: ["&fForged for relentless combat, the &adual-blade butcher &fis a rare and deadly &aweapon. &fIt cannot be crafted and must be found in structures or earned from bosses. &fIts speed and brutality overwhelm enemies. &fOnly skilled fighters can master it."]
	quest.685C19B56E3432F8.quest_subtitle: "&7Find the twin blades of carnage"
	quest.685C19B56E3432F8.title: "&5&lQuest: &r&eDual-blade Butcher"
	quest.68E6EB8CEF2B2CB1.quest_desc: ["&fA terrifying creature known as &asoulmass &femerges with overwhelming &apower. &fThis four-armed monster is both strong and relentless in close combat. &fIf you get too close, its presence will &aslow you down &fmaking escape difficult. &fStay &aalert &fand choose your distance wisely to defeat it."]
	quest.68E6EB8CEF2B2CB1.quest_subtitle: "&7Defeat the four-armed abomination"
	quest.68E6EB8CEF2B2CB1.title: "&5&lQuest: &r&eSoulmass"
	quest.695DBA9F0C58311A.quest_subtitle: "&7Obtain the Old Eye"
	quest.695DBA9F0C58311A.title: "&5&lQuest: &r&eOld Eye"
	quest.6AD99CDBE8E857BE.quest_subtitle: "&7Obtain the Cursed Eye"
	quest.6AD99CDBE8E857BE.title: "&5&lQuest: &r&eCursed Eye"
	quest.6B3897CAFB486097.quest_desc: ["&fAmong the many secrets of this world lies a strange &aflower &fconnected to unknown forces. &fThe &avoid lily &fcan be crafted and placed to reveal hidden paths. &fWhen planted, it releases subtle &aparticles &fthat guide you toward a greater source. &fFollow their trail, for they lead to something far more powerful."]
	quest.6B3897CAFB486097.quest_subtitle: "&7Craft a flower of mysterious origin"
	quest.6B3897CAFB486097.title: "&5&lQuest: &r&eVoid Lily"
	quest.6BB5834419D494BF.quest_subtitle: "&7Craft a wand shaped by the strength of earth"
	quest.6BB5834419D494BF.title: "&5&lQuest: &r&eClay Wand"
	quest.6C29AE4F5ADE6F8A.quest_subtitle: "&7Obtain the Cold Eye"
	quest.6C29AE4F5ADE6F8A.title: "&5&lQuest: &r&eCold Eye"
	quest.6CB6856B4884FCA0.quest_subtitle: "&7Find the Obsidilith Arena"
	quest.6CB6856B4884FCA0.title: "&5&lQuest: &r&eObsidilith Arena"
	quest.6CBABE53D83486CB.quest_desc: ["&fBorn from the fury of the skies, this armor represents a power few have ever controlled. &fThe mighty &adragonsteel armor &fof lightning grants incredible &aspeed &fand destructive potential. &fOnly those who have defeated a &alightning dragon &fcan forge it, proving themselves as true masters of the storm."]
	quest.6CBABE53D83486CB.quest_subtitle: "&7Harness the power of lightning"
	quest.6CBABE53D83486CB.title: "&5&lQuest: &r&eStormforged Legend"
	quest.6D94ADEA402B250C.quest_desc: ["&fEven the ground yields to the force of storms. &fThe &alightning dragonsteel shovel &flets you gather materials with incredible &aefficiency. &fIts energy flows through every movement. &fNo terrain can slow your progress."]
	quest.6D94ADEA402B250C.quest_subtitle: "&7Craft a lightning dragonsteel shovel"
	quest.6D94ADEA402B250C.title: "&5&lQuest: &r&eLightning Dragonsteel Shovel"
	quest.6ECE0C714B30442C.quest_desc: ["&fBeyond all known lands lies the &aEnd, &fa dimension filled with mystery and ancient &apower. &fIts vast emptiness hides unknown dangers and dark secrets. &fWithin it resides an &aancient dragon &fthat watches over this realm. &fPrepare yourself before entering, for this place is unlike any other."]
	quest.6ECE0C714B30442C.quest_subtitle: "&7Enter a realm beyond the world"
	quest.6ECE0C714B30442C.title: "&5&lQuest: &r&eThe End"
	quest.6EDA90976CD1E7DF.quest_desc: ["&fAt the heart of the End awaits the mighty &aEnder Dragon, &fthe most imposing creature of this dimension. &fFacing it alone is a true test of &apower &fand preparation. &fYou must be well &aprepared &fto survive its attacks and destroy its crystals. &fDefeating it marks one of the greatest achievements of any adventurer."]
	quest.6EDA90976CD1E7DF.quest_subtitle: "&7Defeat the ruler of the End"
	quest.6EDA90976CD1E7DF.title: "&5&lQuest: &r&eEnder Dragon"
	quest.6EE1849408F08A26.quest_desc: ["&fWith &aMalachite, &fyou can craft magical rings and necklaces that enhance the power of &aearth &fand &anature. &fThese accessories are ideal for those who seek balance, resilience and harmony with the natural world."]
	quest.6EE1849408F08A26.quest_subtitle: "&7Craft rings and necklaces with earth and nature power"
	quest.6EE1849408F08A26.title: "&5&lQuest: &r&eMalachite Accessories"
	quest.6EF0311CD7A6DE45.quest_desc: ["&fDeep within the Nether lies the &adecaying kingdom, &fa place consumed by ancient &apower. &fRuins and decay cover the land where the &aDecaying King &frules. &fYou must explore carefully and stay &aalert &fto survive its dangers. &fOnly those who find it can challenge its ruler."]
	quest.6EF0311CD7A6DE45.quest_subtitle: "&7Find the ruined realm in the Nether"
	quest.6EF0311CD7A6DE45.title: "&5&lQuest: &r&eDecaying Kingdom"
	quest.7007EC1CDCCA7274.quest_desc: ["&fA chilling presence takes form as the &arime spectre, &fa spirit of pure frost. &fThough it has low &ahealth, &fit freezes everything around it just by being near. &fStay &acareful &fand strike quickly before the cold overwhelms you. &fEven proximity to this entity is a deadly threat."]
	quest.7007EC1CDCCA7274.quest_subtitle: "&7Defeat the freezing spirit"
	quest.7007EC1CDCCA7274.title: "&5&lQuest: &r&eRime Spectre"
	quest.712417A7A491DED1.quest_desc: ["&fHidden somewhere in the world lies the &acathedral &fof resurrection, a place filled with ancient &apower. &fWithin its walls rests the means to summon the &areturning knight. &fYou must explore and remain &aalert &fto uncover its location. &fOnly those who find it can challenge what refuses to stay dead."]
	quest.712417A7A491DED1.quest_subtitle: "&7Find the place of eternal return"
	quest.712417A7A491DED1.title: "&5&lQuest: &r&eCathedral of Resurrection"
	quest.71A48004F6F463EB.quest_desc: ["&fThe &aWind Set &fis crafted with the power of &awind charges, &fgranting its wearer the swiftness and freedom of the skies. &fWhile equipped, your &aair power &fis increased by &a25%, &fmaking it ideal for those who embrace the path of wind magic. &fThis set can also be &aupgraded &fusing &anetherite &fand a special smithing template, unlocking even greater potential. &fOnly those who master the currents can truly wield its power."]
	quest.71A48004F6F463EB.quest_subtitle: "&7Craft armor blessed by the force of air"
	quest.71A48004F6F463EB.title: "&5&lQuest: &r&eWind Set"
	quest.72703CE840B2866A.quest_subtitle: "&7Obtain a legendary staff of elemental mastery"
	quest.72703CE840B2866A.title: "&5&lQuest: &r&eAvatar's Staff"
	quest.731F2947C1705A64.quest_subtitle: "&7Craft a wand touched by the swiftness of air"
	quest.731F2947C1705A64.title: "&5&lQuest: &r&eFeather Wand"
	quest.736F4A1D4C505C5E.quest_subtitle: "&7Obtain the Wither Eye"
	quest.736F4A1D4C505C5E.title: "&5&lQuest: &r&eWither Eye"
	quest.73EC15B40A21CFAF.quest_desc: ["&fThe &aJade Hawk Figurine &fis a sharp and elegant relic that favors precision from afar. &fLike other jade artifacts, it increases your &aranged damage, &fmaking it ideal for archers, hunters and long-range fighters."]
	quest.73EC15B40A21CFAF.quest_subtitle: "&7Craft a relic that enhances ranged damage"
	quest.73EC15B40A21CFAF.title: "&5&lQuest: &r&eJade Hawk Figurine"
	quest.742B1C2106C43CE2.quest_subtitle: "&7Find the Ice Mineshaft"
	quest.742B1C2106C43CE2.title: "&5&lQuest: &r&eIce Mineshaft"
	quest.74DCDA12B9CC526D.quest_desc: ["&fWith &aTanzanite, &fyou can craft mysterious rings and necklaces that empower &aice &fand &asoul magic. &fThese accessories are suited for those who wield cold, death and forgotten energies."]
	quest.74DCDA12B9CC526D.quest_subtitle: "&7Craft rings and necklaces with ice and soul power"
	quest.74DCDA12B9CC526D.title: "&5&lQuest: &r&eTanzanite Accessories"
	quest.760D6AE03E71EA3D.quest_desc: ["&fNot all shields are made equal, some combine protection with &astyle. &fThe &agolden kite shield &fprovides decent defense while allowing precise &aparry. &fWhen held in your off-hand, it grants additional &aarmor &fto keep you protected. &fA worthy upgrade for a growing warrior."]
	quest.760D6AE03E71EA3D.quest_subtitle: "&7Refined defense with elegant design"
	quest.760D6AE03E71EA3D.title: "&5&lQuest: &r&eGolden Kite Shield"
	quest.7BA715471BCF42F9.quest_subtitle: "&7Find the Silver Dungeon"
	quest.7BA715471BCF42F9.title: "&5&lQuest: &r&eSilver Dungeon"
	quest.7CE41ADC6A599824.quest_desc: ["&fThe legendary &atempest &fis a weapon infused with storm &apower. &fIt can only be found in hidden structures or obtained from powerful enemies. &fIts strikes are swift and devastating. &fOnly those who master the storm can wield it."]
	quest.7CE41ADC6A599824.quest_subtitle: "&7Harness the fury of the storm"
	quest.7CE41ADC6A599824.title: "&5&lQuest: &r&eTempest"
	quest.7D0BB431CF405750.quest_subtitle: "&7Find the Red Desert Mineshaft"
	quest.7D0BB431CF405750.title: "&5&lQuest: &r&eRed Desert Mineshaft"
	quest.7DD8DEF4178568FC.quest_subtitle: "&7Craft an upgraded wand empowered by air and netherite"
	quest.7DD8DEF4178568FC.title: "&5&lQuest: &r&eNetherite Wind Wand"
