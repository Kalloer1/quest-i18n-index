	quest.60D4967678A6512E.title: "Cartographer of the Abyss"
	quest.610B78585D49D389.title: "Beginning the Journey"
	quest.6111C6A96EFE1CD7.quest_desc: [
		"Accept this gift from the modpack creator. Set out on your journey alongside your feathered friend. Press X to call it."
		"{entity:minecraft:horse ent_size:0.5 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.6111C6A96EFE1CD7.title: "A Mount for Your Journey"
	quest.6115C10A8AA82B70.quest_desc: [
		"It is time to end the tribe's rule. Find the Ogre King in the heart of the Fort and defeat him. The fight has multiple phases, so enter prepared for a true boss battle."
		"{entity:kingsandmonsters:ogre_lord ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:USE_GLOBAL width:100 height:100 align:center}"
	]
	quest.6115C10A8AA82B70.title: "The Ogre King"
	quest.6189945F00D4163B.quest_desc: ["The King will not simply wait while you invade his fortress. Overcome the Royal Defence and defeat the elite defenders blocking the path to the throne."]
	quest.6189945F00D4163B.title: "The King's Defence"
	quest.620B3C75FD8328BF.title: "Cartographer of the Abyss"
	quest.6236BF4105CFE821.quest_desc: ["Chance to Drop When Defeating an Ogre Archer"]
	quest.62609EBEC6F9855D.title: "The Forgotten Returns"
	quest.63077C20BE340FE4.quest_desc: ["Juice can quench thirst. Time, patience, and fermentation can turn it into something completely different."]
	quest.63077C20BE340FE4.quest_subtitle: "build a fermentation barrel."
	quest.63077C20BE340FE4.title: "The Art of Fermentation"
	quest.631329F8DD049D63.title: "Common Coin"
	quest.6332C7553A62E032.title: "The Forgotten City"
	quest.638B1E71897A1D9D.title: "The Emerald Sword"
	quest.64866AD89BC491CC.quest_desc: ["In the depths, where even the smallest sound can awaken something terrible, an unusual creature hides among the sculk. Perhaps it is worth risking one more cast."]
	quest.64866AD89BC491CC.quest_subtitle: "Explore the depths of the Deep Dark and catch an Epic-rarity Sculkfish."
	quest.64866AD89BC491CC.title: "An Epic Catch"
	quest.6509CAD3333A1BBD.quest_desc: ["One catch can be luck. Several different species are the beginning of a true collection."]
	quest.6509CAD3333A1BBD.quest_subtitle: "Expand your fishing journal by discovering different Starcatcher species."
	quest.6509CAD3333A1BBD.title: "The Collector"
	quest.653A54438966436B.quest_desc: ["Rune Used to Craft Armor"]
	quest.6553ABC67A66A3DB.title: "Descending into the Undergarden"
	quest.66030CBE136901E4.quest_desc: ["Rune Used to Craft Armor"]
	quest.668872E31E432776.title: "Opening the Skies"
	quest.66C911A45FBB62D8.quest_desc: ["Rune Used to Craft Armor"]
	quest.66DF7016A2E9BEB3.title: "Titan Ore"
	quest.66E7928D2A646E5E.quest_desc: ["Producing one bottle was only a demonstration. Different ingredients and grape varieties can result in completely different drinks."]
	quest.66E7928D2A646E5E.quest_subtitle: "produce two different wines."
	quest.66E7928D2A646E5E.title: "Two Faces of the Vine"
	quest.6735FA2CF258371D.quest_desc: [
		"The world is bound by ancient seals."
		""
		"For ages, guardians kept their greatest powers dormant. Iron, gold, diamond, and even forces far beyond them are tied to creatures that must be defeated before those powers can be released."
		""
		"Your journey begins small, but soon goes beyond the limits of the known world. Frozen oceans, forgotten depths, celestial realms, and unknown dimensions hide creatures and civilizations that existed long before you."
		""
		"With every enemy defeated, a new power is released — but something even greater awakens in its place."
		""
		"The death of the Ender Dragon breaks the final balance and begins a new age. Colossi, calamities, and entities once dormant begin to emerge, while worlds beyond your own become accessible."
		""
		"In the end, only one question will remain:"
		""
		"will you be just another adventurer... or will you become the King of Aetherbound?"
	]
	quest.6735FA2CF258371D.title: "Lore"
	quest.6749D6E03CC0B2F2.title: "Portal to Cavaryn"
	quest.67540C80200695AA.quest_desc: ["Locate the Ogre Fort and breach its walls. Bring plenty of food, potions, and equipment: this will not be a quick invasion."]
	quest.67540C80200695AA.title: "The Ogre Fortress"
	quest.682F24BC7537FB9E.title: "The Portal Guardian"
	quest.69E5FFE3BA8C6253.quest_desc: ["Place the panel in front of the connector "]
	quest.6A725A1654C89B42.quest_desc: [
		"A warrior remained caught between life and death for far too long. What remains of his honor now shares the same body with something much darker."
		"{entity:legendary_monsters:posessed_paladin ent_size:0.7 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.6A725A1654C89B42.quest_subtitle: "find the Abandoned Crypt and defeat the Possessed Paladin. In the second phase, he transforms into Orion, The Fractured Omen. The encounter rewards a Corrupted Soul and Soul Great Sword."
	quest.6A725A1654C89B42.title: "The Paladin's Soul"
	quest.6A79F7ADB4583853.title: "Supreme Armor"
	quest.6AA30C4B8C6A7A9D.quest_desc: ["The Ender Pearl is a component used to craft Ender Spells."]
	quest.6B1C89636C5A15AA.title: "Tracks in the Snow"
	quest.6B1EA0A4E997D028.title: "The Guardian of the Depths"
	quest.6B3A1E2586FEE6F6.title: "A Forgotten Place"
	quest.6BC56D683346BF17.quest_desc: ["They say the waters hide a treasure granted by Neptune himself. Few anglers ever see it — and fewer still manage to bring it to the surface."]
	quest.6BC56D683346BF17.quest_subtitle: "Obtain a Neptune’s Bounty through Aquaculture fishing."
	quest.6BC56D683346BF17.title: "Neptune's Treasure"
	quest.6BDC672084788368.quest_desc: ["Find the Boss Summoner, but do not use it yet."]
	quest.6D475E6F9A96ADD7.title: "Powers Claimed"
	quest.6D68660D2CEFB064.title: "The Lost Sword"
	quest.6DF9495A1206DC56.title: "Evolution"
	quest.6E5978CEF9AAD7D8.quest_desc: ["End of the Chapter. From this point on, you will enter HARDMODE. The Dragon's death shook the foundations of the world. Powers that had remained dormant now begin to awaken. The world has entered a new age."]
	quest.6E5978CEF9AAD7D8.title: "Lord of the Stars"
	quest.6E95452F5D512EA9.quest_desc: [
		"The Nether preserved the remains of a creature that should have been dead for thousands of years. Its bones are still hungry."
		"{entity:legendary_monsters:skeletosaurus ent_size:0.6 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.6E95452F5D512EA9.quest_subtitle: "look for a Skeletosaurus Nest in the Soul Sand Valley and defeat the Skeletosaurus. Its Dinosaur Bones can be used to craft weapons and shields."
	quest.6E95452F5D512EA9.title: "Bones That Still Walk"
	quest.6EE6E62ADE9725F5.title: "Ready for Adventure"
	quest.6F2410B072873A07.title: "The Umvuthana Grove"
	quest.6F3672EB184F4456.title: "Descending into the Undergarden"
	quest.6F3BFCAD194AE1D9.title: "The Harbinger of Ruin"
	quest.6F63A30ECA06752E.title: "The Colossus"
	quest.705F8EC3DDECA6B4.quest_desc: ["Knowing the waters is just as important as knowing how to cast a line. Some species appear only in specific places, times, and conditions."]
	quest.705F8EC3DDECA6B4.quest_subtitle: "Obtain the Starcatcher Guide and check the information about fish that can be found throughout the world."
	quest.7108066E664EB0AA.title: "The Hammer of the Titans"
	quest.7131BA8E95B7F1CA.title: "Frozen Arena"
	quest.7141365593916C91.quest_desc: [
		"Something roams the station's corridors without rest. Ever since you entered, it has known exactly where you are."
		"{entity:legendary_monsters:annihilation_pursuer ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.7141365593916C91.quest_subtitle: "kill the Annihilation Pursuer"
	quest.7141365593916C91.title: "Pursuit in the Void"
	quest.71571F0D987D986A.title: "Inverted Gravity"
	quest.716215A5E83F6A72.title: "Heart of Arion"
	quest.71BA6BF2BD021957.quest_desc: [
		"Deep beneath the Nether, an ancient warrior still guards a forgotten hall.  "
		"Helvar is no beast driven by hunger or instinct. He watches his opponent, closes every opening, and punishes every careless strike. Countless warriors entered his arena believing strength alone would be enough.  "
		"Enter the Underworld and prove them wrong."
		"{entity:block_factorys_bosses:underworld_knight ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.71BA6BF2BD021957.quest_subtitle: "Descend to the Underworld Fortress and challenge Helvar."
	quest.71BA6BF2BD021957.title: "The Knight Beneath the World"
	quest.71D92FFCC6D2AD26.quest_desc: ["Rune Used to Craft Armor"]
	quest.72214E08328973A3.quest_desc: ["This is no ordinary fishing rod. With it, the waters reveal species you would never find with your old equipment."]
	quest.72214E08328973A3.quest_subtitle: "Use your new rod and catch a Driftfin in the waters of the Overworld."
	quest.72214E08328973A3.title: "A New Way to Fish"
	quest.7339D51241310813.title: "Stone and Coal"
	quest.7375858C84100327.title: "Armor"
	quest.73826580A38C8E37.quest_desc: ["This is the automatic storage guide. Start by placing 10 barrels on the ground"]
	quest.73826580A38C8E37.title: "Automatic Storage"
	quest.73B9E8D2C1F86096.quest_desc: ["Ink is used in the Scroll Forge to create Spells. The rarity of the ink determines the rarity of the Spell created."]
	quest.73B9E8D2C1F86096.title: "Ink"
	quest.755191A49F166FAB.title: "Wine Cellar"
	quest.75B6260E92D81DD0.title: "The Catacombs"
	quest.75EA10BEA47F4E71.quest_desc: ["Across fields and forests grow fruits that seem ordinary at first glance. To those who know their true value, however, every bunch can be the beginning of a new tradition."]
	quest.75EA10BEA47F4E71.quest_subtitle: "find your first grape varieties."
	quest.75EA10BEA47F4E71.title: "The First Vines"
