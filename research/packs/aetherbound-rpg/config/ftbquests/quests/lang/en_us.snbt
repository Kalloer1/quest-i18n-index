	quest.799304D183D1D3A0.title: "Sealed Flask"
	quest.79AFCF1A801CC5F2.quest_desc: ["In the depths of the End, two corrupted creatures have awakened among forgotten ruins: the Chorusent, born from the twisted roots of the Chorus, and the Mimic Shulker, a living trap that feeds on careless travelers. You will have to defeat both and prove that you are ready to face the true horrors of the End."]
	quest.79AFCF1A801CC5F2.quest_subtitle: "Defeat the 2 Guardians of the End. (Optional Quest)"
	quest.79AFCF1A801CC5F2.title: "The Guardians of the End"
	quest.79EB16CA73D5484C.title: "The End Draws Near"
