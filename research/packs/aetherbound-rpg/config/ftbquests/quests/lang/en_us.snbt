	quest.3880A3D3C985A9C2.title: "The Three Calamities"
	quest.392C6D44E681BE80.quest_desc: ["Use the Arcane Anvil to upgrade your Spells, increasing their power and making them even more effective."]
	quest.392C6D44E681BE80.title: "Upgrading Spells"
	quest.3A3B6EFEA9AEBD37.title: "The First Hardmode Challenge"
	quest.3ADFE611F3F817D7.quest_desc: ["The Blood Vial is a component used to craft Blood Spells."]
	quest.3AFDB88E3DEA15E4.title: "Cloud Arena"
	quest.3B3C6C81BC94015B.quest_desc: ["Rune Used to Craft Armor"]
	quest.3B8FB873EECDB91D.quest_desc: ["Chance to Drop When Defeating an Ogre Mage"]
	quest.3BFD20AD08D71735.title: "Stone Arena"
	quest.3C03E249B643EBE4.title: "Opening the Depths"
	quest.3CA467A4FD94D513.quest_desc: [
		"The cold of these lands does not come from snow alone. Something ancient rests in the temple, freezing everything that draws near."
		"{entity:legendary_monsters:frostbitten_golem ent_size:0.6 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.3CA467A4FD94D513.quest_subtitle: "find the Frostbitten Temple, defeat the Frostbitten Golem, and obtain the Frozen Rune."
	quest.3CA467A4FD94D513.title: "The Frozen Heart"
	quest.3E109F085B32D56C.title: "Cloud Armor"
	quest.3E8FFCA47BC24177.quest_desc: ["Face the Mother of the Labyrinth. She appears underwater and is extremely rare: she has a 0.5% chance to appear alongside an Anglerfish"]
	quest.3EB4BEF45DEDF96E.title: "The Monastery Courtyard"
	quest.3F8C7D04146DD201.quest_desc: [
		"Craft your first Spellbook to begin your journey as a Mage!"
		""
		"To learn more about Spellbooks, click the “Info” icon below this Quest."
	]
	quest.3F8C7D04146DD201.title: "First Spellbook"
	quest.3FDE4C3960124DC3.quest_desc: ["Use to Summon the Obliterator"]
	quest.400DF2BD3FE407E9.quest_desc: [
		"In this chapter, you will learn the fundamentals of magic and how to grow into a true Mage."
		""
		"You will discover Spellbooks, learn how to craft and upgrade Spells, use Ink, Staffs, Upgrade Orbs, and important resources such as Arcane Essence and Cinder Essence."
		""
		"You will also learn how to use essential structures such as the Inscription Table, Scroll Forge, Arcane Anvil, and Alchemist Cauldron."
		""
		"Master these tools and resources to strengthen your magic and continue your journey."
	]
	quest.400DF2BD3FE407E9.title: "Introduction to Magic"
	quest.401FF8BAD9D8453C.quest_desc: ["Staffs provide bonuses to your spells while equipped, increasing their power or granting benefits specific to each school."]
	quest.401FF8BAD9D8453C.title: "Staffs"
	quest.4070559CD1A958E4.quest_desc: ["Hooking a fish is easy. Mastering the line without making a single mistake requires precision, patience, and control."]
	quest.4070559CD1A958E4.quest_subtitle: "Complete at least 1 Perfect Catch in the Starcatcher fishing minigame."
	quest.4070559CD1A958E4.title: "Perfect Catch"
	quest.40BA76D1AB6EE399.quest_desc: ["{entity:armageddon_mod:zoranththe_forgotten_one ent_size:0.8 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"]
	quest.40BA76D1AB6EE399.title: "The Forgotten One"
	quest.418E0A74661A800E.title: "Preparation for Battle"
	quest.42FCAB00C0BB4540.quest_desc: ["The Blaze Rod is a component used to craft Fire Spells."]
	quest.4368D42986D8E4EA.title: "Three-Bolt Armor"
	quest.43C835E8482D302E.title: "The Paradise of Elythia"
	quest.4491CBDB6C707635.quest_desc: [
		"This compass makes it easy to find biomes. Craft one; you will use it often throughout your journey."
		"{image:kubejs:textures/quests/chapters/naturecompass.png width:100 height:50 align:center click_action:none:}"
	]
	quest.4491CBDB6C707635.title: "Locate Biomes"
	quest.449B09F71ED6F917.quest_desc: ["A good rod is only the beginning. Hooks, bobbers, and bait can completely change what you find in the water."]
	quest.449B09F71ED6F917.quest_subtitle: "Obtain your first Hook, Bobber, and Bait to prepare your fishing equipment."
	quest.449B09F71ED6F917.title: "Tools of the Trade"
	quest.449E6B86AF1A9833.quest_desc: [
		"Above the mountains, the clouds hide an ancient god. Thunder does not announce its arrival. It is its voice."
		"{entity:legendary_monsters:cloud_golem ent_size:0.7 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.449E6B86AF1A9833.quest_subtitle: "find the Cloudy Temple and defeat Cumulonimbus, the Cloud Golem. It has different phases and rewards the Air Rune and Atmospheric Boots."
	quest.449E6B86AF1A9833.title: "Lord of Storms"
	quest.452257A7EE8324FD.title: "The Wither Scythe"
	quest.45C47D956FBF921B.title: "Fragments of the Past"
	quest.45EBD32CDA61BF2F.title: "Builders' Amulet"
	quest.467D36502B911D48.title: "Jungle Arena"
	quest.46A80FACE8E0B76D.quest_desc: [
		"After defeating the Ogre King from Chapter 2, you find among his belongings an ancient royal symbol tied to a king who should have been dead for centuries."
		""
		"His fall seems to have awakened something in the depths."
		""
		"Find the Catacombs and defeat the Dead King before his ancient reign returns."
	]
	quest.46A80FACE8E0B76D.title: "The Dead King"
	quest.46E0A0A3E949910D.title: "The Veil of Oblivion"
	quest.46F9D13F99E3A668.title: "Reinforced Echo"
	quest.47056FB9433771BE.quest_desc: ["After defeating the 3 Guardians of the Overworld, one final Guardian remains. Find and defeat it."]
	quest.47056FB9433771BE.quest_subtitle: "Defeat the Forgotten Guardian. (Optional Quest)"
	quest.47056FB9433771BE.title: "The Forgotten Guardian"
	quest.47267E01F6F2320D.quest_desc: ["The Echo Shard is a component used to craft Eldritch Spells."]
	quest.4739457096DFD045.quest_desc: ["Below are a few quests about mobs and how to obtain food"]
	quest.4739457096DFD045.title: "Mobs and Food"
	quest.47F52549B95BB882.quest_desc: ["Use the Inscription Table to add new Spells to your Spellbook and expand your magical arsenal."]
	quest.47F52549B95BB882.title: "Adding Spells"
	quest.4814504E9592378E.title: "Zoranth's Helmet"
	quest.484996BDBE43E4A2.quest_desc: ["This parachute will make exploring The Aether easier. Good luck!"]
	quest.484996BDBE43E4A2.title: "Parachute"
	quest.48B01D7E2DCDA2EB.quest_desc: [
		"Defeat the Goblin to gain access to gold!"
		"{entity:armageddon_mod:the_gobelin_lord ent_size:0.7 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.48B01D7E2DCDA2EB.title: "A Strange Coin"
	quest.490CDCFAF21D7B71.quest_desc: [
		"Spellbooks are essential for any Mage. They allow you to store and use your Spells, making them the main way to access your magic during the adventure."
		""
		"Better books have more Spell slots and may provide additional magical bonuses."
		""
		"Below, you can view the different Spellbooks available and learn about their characteristics."
	]
	quest.490CDCFAF21D7B71.title: "The Spellbooks"
	quest.4945E3C27D8DAE94.title: "Amulet of Convergence"
	quest.497AF824AB0510F3.quest_desc: [
		"Maledictus, the cursed knight, carries a dark power capable of turning his curse into magic."
		""
		"Defeat Maledictus from Chapter 4 and claim his essence. Only then will you be able to begin mastering Maledictus's spells."
		"{entity:cataclysm:maledictus ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.497AF824AB0510F3.title: "Maledictus's Curse"
	quest.4A17DF10D2C770CE.quest_desc: ["Mark the location of your portal on the World Map (M), because the only way back to the Overworld is through the portal you came from."]
	quest.4A17DF10D2C770CE.title: "The Other Side"
	quest.4A6D94627BF0C167.title: "Ultra Coin"
	quest.4ACFC4970DAD0C41.quest_desc: [
		"In Aetherbound RPG, some of the main keybinds are:"
		""
		"View your origin: O"
		"Primary and secondary origin abilities: G / H / J"
		"Roll: Alt"
		"Lock camera: Press the middle mouse button (scroll wheel)"
		"Call Mount: X"
		"Select Iron's spell: R"
		"Cast spell: V"
		"Open backpack: B"
		"Map: M"
		"Skill tree: K"
		""
		"I recommend checking the game's Controls menu before beginning your journey."
	]
	quest.4ACFC4970DAD0C41.title: "Keybinds"
	quest.4B2203DFD23F3366.quest_desc: ["Use the Scroll Forge to create new Spells and expand your magical arsenal."]
	quest.4B2203DFD23F3366.title: "Creating Spells"
	quest.4B832440C71D0CA5.quest_desc: ["Three ancient guardians have awakened in forgotten lands: one protects lost ruins, another was consumed by nature itself, and the last remains sealed in ice. You will have to face all three and prove that you are ready for even greater dangers."]
	quest.4B832440C71D0CA5.quest_subtitle: "Defeat the 3 Guardians of the Overworld. (Optional Quest)"
	quest.4B832440C71D0CA5.title: "The Guardians of the Overworld"
	quest.4B958C39EEADD203.title: "Heart of Elvenite"
	quest.4BBF5A83F754432D.title: "Gravitite"
	quest.4BF8930546CE4BBC.quest_desc: ["Craft a connector and place it on top of a barrel/chest"]
	quest.4C325CB55AD93CA6.quest_desc: [
		"The desert hides more than forgotten ruins.  "
		"Beneath the scorching sands, something ancient follows every step taken on the surface. Travelers speak of violent tremors, pools of poison, and a creature that strikes before its prey can even see it coming.  "
		"Find the buried ruins and put an end to Sirok, the Sandworm."
		"{entity:block_factorys_bosses:sandworm ent_size:0.03 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.4C325CB55AD93CA6.quest_subtitle: "Find the buried ruins and put an end to Sirok. (Optional Quest)"
	quest.4C325CB55AD93CA6.title: "Beneath the Scorching Sands"
	quest.4CA67D848385C729.quest_desc: ["Rune Used to Craft Armor"]
	quest.4CB5870711862DAB.title: "Preparation for Battle"
	quest.4CB83B2B72E74CF2.quest_desc: ["Use the Upgrade to increase a Spellbook's Spell capacity"]
	quest.4CB83B2B72E74CF2.title: "Spell Slot Upgrade"
	quest.4CE47AC0E92C42A7.title: "Alpha Mantis"
	quest.4CFFB7081027FD2F.quest_desc: ["Locate structures with this compass"]
	quest.4D2D811D8848A318.title: "Ultra Mysterious Gift"
	quest.4D5B535A8CC80ECC.title: "Entering the Starlight Realm"
	quest.4E1497FEDE833D92.title: "Preparation for Battle"
	quest.4E62042C34197F7C.title: "Preparation for Battle"
	quest.4F3FDC09C91F3AB2.quest_desc: ["Rune Used to Craft Armor"]
	quest.4F4FACC9874B92ED.title: "The Three Calamities"
	quest.4FAA0CD2DD59F750.quest_desc: ["The Ogre King's army is made up of different fighters. Defeat an Ogre Grunt and an Ogre Archer to learn about the forces protecting the kingdom."]
	quest.4FAA0CD2DD59F750.title: "The King's Soldiers"
	quest.4FE5662580CBC2B2.title: "The Infested Dimension"
	quest.503088E4804DEFE6.title: "Eldorath's Axe"
	quest.5054CE63C3729CD5.quest_desc: ["Every angler begins with a first cast. Perhaps the waters have something special waiting for you."]
	quest.5054CE63C3729CD5.quest_subtitle: "Catch anything using a regular Fishing Rod. After your first catch, something new may appear in your hands."
	quest.5054CE63C3729CD5.title: "First Catch"
	quest.515A02258E548206.quest_desc: [
		"Take a pet on your journey. To tame more hamsters, find one and feed it Sliced Cucumber."
		"{entity:adorablehamsterpets:hamster ent_size:0.5 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.515A02258E548206.title: "A Friend for Your Journey"
	quest.517DCCE8A924B3EE.quest_desc: ["A tribe of Ogres controls part of these lands. Explore the world until you find signs of their presence. Prepare yourself before entering their territory, because Ogres protect one another and do not easily forget those who provoke them."]
	quest.517DCCE8A924B3EE.title: "Ogre Territory"
	quest.518DF209FB8F53C1.title: "Sun Mold"
	quest.521946BBFE710117.title: "Lord of the Forgotten Depths"
	quest.528357402133E1AF.quest_desc: ["{entity:antarchy:kraken ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"]
	quest.52D3D9A42D5421E5.quest_desc: [
		"Beneath the seas of fire lives something that learned to survive where no creature should."
		"{entity:legendary_monsters:lava_eater ent_size:0.6 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.52D3D9A42D5421E5.quest_subtitle: "find the Lava Eater's Nest, defeat the Lava Eater, and collect its hides. Three are enough to begin crafting fire equipment."
	quest.52D3D9A42D5421E5.title: "The Lava Beast"
	quest.5304EE5FEB32D630.quest_desc: ["The waters change from place to place — and so do their inhabitants. Anyone who wishes to master fishing must learn where each species lives."]
	quest.5304EE5FEB32D630.quest_subtitle: "Catch three species found in different environments."
	quest.5304EE5FEB32D630.title: "Fish of Many Waters"
	quest.53120D2739D1A871.title: "Outpost Leaders"
	quest.5315F30948376707.quest_desc: ["Your journal still has empty spaces. Instead of waiting for a new species to find your hook by chance, perhaps it is time to let the bait itself show you the way."]
	quest.5315F30948376707.quest_subtitle: "Use a Seeking Worm while fishing to help find species you have not yet discovered."
	quest.5315F30948376707.title: "In Search of the Unknown"
	quest.53B7A3003BC06F25.title: "Secret Drop"
	quest.54115BCC04549A0F.quest_desc: [
		"The Dragon's death opened the way to islands that had remained untouched. Among them, something was consumed by the Chorus until it lost its original form."
		"{entity:legendary_monsters:endersent ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.54115BCC04549A0F.quest_subtitle: "find the Ancient Tower Remains on the outer islands and defeat the Endersent/Chorusent. The Chorus Crystal it drops unlocks equipment tied to this progression."
	quest.54115BCC04549A0F.title: "The Chorus Infection"
	quest.5424845E7F0C40F6.quest_desc: ["Rune Used to Craft Armor"]
	quest.54981AAFD283186D.title: "Zoranth's Hand"
	quest.54D45420A42EFA33.quest_desc: ["The barrel worked silently while you continued your journey. Now the time has come to open your first bottle."]
	quest.54D45420A42EFA33.quest_subtitle: "produce your first wine."
	quest.54D45420A42EFA33.title: "The First Bottle"
	quest.5531D08CE1B574EC.title: "Bone Arena"
	quest.5540045E5A9A6F78.title: "Soul Arena"
	quest.55D03438D126C1AF.quest_desc: ["The Emerald is a component used to craft Evocation Spells."]
	quest.55DA2D526DC4835F.quest_desc: ["Some caves hide fruit that seems to hold its own light. Perhaps that glow can survive the fermentation process as well."]
	quest.55DA2D526DC4835F.quest_subtitle: "produce Sun-kissed Wine."
	quest.55DA2D526DC4835F.title: "Light Inside the Bottle"
	quest.56800FDFA9ED70CD.quest_desc: ["Grapes from cold lands have traits that ordinary vines could never reproduce. With a little snow, perhaps it is possible to bottle winter itself."]
	quest.56800FDFA9ED70CD.quest_subtitle: "produce Eiswein."
	quest.56800FDFA9ED70CD.title: "Wine of the Frozen Lands"
	quest.56A885BCF529BE88.title: "Common Mysterious Gift"
	quest.5708CD7FC80C92AD.title: "Life in the Depths"
	quest.577E6DFF2DD2497C.quest_desc: [
		"Craft the Explorer's Compass; you will use it often throughout your journey"
		"{image:kubejs:textures/quests/chapters/explorercompass.png width:100 height:50 align:center click_action:none:}"
	]
	quest.577E6DFF2DD2497C.title: "Locate Structures"
	quest.57C2A720695D14DF.quest_desc: ["For some, rain is a reason to put away the rod and seek shelter. For others, it is exactly the right time to start fishing."]
	quest.57C2A720695D14DF.quest_subtitle: "Take advantage of a storm and catch a Rainfin."
	quest.57C2A720695D14DF.title: "Rain or Shine"
	quest.57D79CAC51EE6627.quest_desc: ["Buy a golem to help you in battle"]
	quest.57D79CAC51EE6627.title: "Buy a Golem"
	quest.57F905E39AC866E0.title: "The Aether Coal"
	quest.58CE386ED93B2984.quest_desc: [
		"Among forgotten ruins, a stone creature has remained motionless for ages. They say the sheer weight of its anchor crushed everyone who tried to cross the stronghold."
		"{entity:legendary_monsters:ancient_guardian ent_size:0.6 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.58CE386ED93B2984.quest_subtitle: "find the Ancient Stronghold, defeat the Ancient Guardian, and obtain the Anchor Handle."
	quest.58CE386ED93B2984.title: "The Ancient Guardian"
	quest.5924A580099FFA9A.quest_desc: ["This structure is underground and has an ice tunnel connecting the surface to the Shelter"]
	quest.5936F649F2FB6764.quest_desc: ["I recommend checking the hamster guide to learn everything about them"]
	quest.5936F649F2FB6764.title: "Hamster Guide"
	quest.5953E646AD2E4781.quest_desc: [
		"A tower scorched by centuries of flame rises above the horizon.  "
		"Its halls are filled with the remains of those who tried to reach the top before you, but the true ruler waits at the summit. Fire is its weapon, the tower is its throne, and even the ground beneath your feet may not survive the battle.  "
		"Climb the Dragon Tower and defeat Ashlord, the Infernal Dragon."
		"{entity:block_factorys_bosses:infernal_dragon ent_size:0.7 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.5953E646AD2E4781.quest_subtitle: "Climb the Dragon Tower and defeat Ashlord, the Infernal Dragon."
	quest.5953E646AD2E4781.title: "The Infernal Crown"
	quest.598FAFB74B677C82.quest_desc: ["With the Ogre King defeated, his old control over the ore is gone. Find Bog Iron Ore, mine Raw Bog Iron, and turn it into Bog Iron."]
	quest.598FAFB74B677C82.title: "The Bog Ore"
	quest.5A11325AA2B7D452.title: "Armor from Another Age"
	quest.5A239C4C8FA37A22.quest_subtitle: "Defeat the Beheaded Knight and the Resurrected Knight"
	quest.5A2AEB6CEF698D35.title: "Preparation for Battle"
	quest.5AA173774CED29EC.quest_desc: ["Turn Bog Iron Ore into Ingots"]
	quest.5AA173774CED29EC.title: "Bog Iron"
	quest.5AA3B6C87521B87F.title: "The Bell"
	quest.5AAA618B781F4301.quest_desc: ["The surface waters no longer hide many secrets from you. Perhaps it is time to cast your line where light barely reaches."]
	quest.5AAA618B781F4301.quest_subtitle: "Descend into the depths of the world and catch an Aquamarine Pike."
	quest.5AAA618B781F4301.title: "The Deepest Cast"
	quest.5AD830EAAFF8FD99.title: "Preparation for Battle"
	quest.5B4D4D8299CAEF70.quest_desc: ["{image:kubejs:textures/quests/chapters/strangecoin.png width:100 height:50 align:center click_action:none:}"]
	quest.5B4D4D8299CAEF70.title: "Preparation for Battle"
	quest.5B8CE9E1CE17BAAA.quest_desc: ["A golden glow appears beneath the surface. This is not just another rare species — it is a catch few anglers will ever be lucky enough to find."]
	quest.5B8CE9E1CE17BAAA.quest_subtitle: "Catch your first Starcatcher Golden Fish."
	quest.5B8CE9E1CE17BAAA.title: "The Golden Catch"
	quest.5B9579C5B05C6ED3.quest_desc: ["Not every fishing trip needs water. In the far reaches of the End, even the void can hide creatures waiting for a line cast into the unknown."]
	quest.5B9579C5B05C6ED3.quest_subtitle: "Travel to the outer islands of the End and catch a Chorus Minnow by fishing in the air."
	quest.5B9579C5B05C6ED3.title: "Angler of Other Worlds"
	quest.5BBB1538B5B5920D.quest_desc: ["Rune Used to Craft Armor"]
	quest.5C02F8153DA0369A.title: "The Call of the Depths"
	quest.5C2D3BA6631F0965.quest_desc: ["{image:kubejs:textures/quests/chapters/fierywither.png width:100 height:50 align:center click_action:none:}"]
	quest.5C2D3BA6631F0965.title: "Preparation for Battle"
	quest.5C3F590774DF77E5.quest_desc: [
		"Use the Boss Summoner and defeat Captain Cornelia."
		"{entity:aquamirae:captain_cornelia ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.5C7CD0096605602E.title: "Preparation for Battle"
	quest.5CDE9AD1BAD0712A.title: "Legends of the Overworld"
	quest.5D1A98F8485BDCDF.title: "Your First Bed"
	quest.5E6E6346692250D8.title: "The Void Blossom"
	quest.5EBB91B382544DC0.title: "Blood Armor"
	quest.5EC40A7CE5D13E91.quest_desc: [
		"This modpack was created by one person and took a great deal of work; if you can and would like to support development, you can click below:"
		""
		"ko-fi.com/kyuu_"
		""
		"Thank you for your attention and for any donation."
	]
	quest.5EC40A7CE5D13E91.title: "Buy Me a Coffee"
	quest.5EF90FB49A6004D3.quest_desc: [
		"🌟 Thanks for Playing!"
		""
		"If you made it this far, thank you so much for playing my modpack! ❤"
		""
		"This project was made entirely by me, from creating the progression and organizing the quests and chapters to every detail of the adventure. It took a lot of work and a great deal of time to get everything the way I wanted."
		""
		"I hope you had fun, explored every dimension, faced the bosses, and enjoyed this journey as much as I enjoyed creating it."
		""
		"If you enjoyed the modpack and want to help keep the project alive, any donation through Ko-fi is greatly appreciated! ☕❤"
		""
		"Donations help support development and make future updates, new content, improvements, and fixes possible for the modpack."
		""
		"Thank you for your support and for playing!"
		""
		"See you on the next adventure. ⚔"
	]
	quest.5EF90FB49A6004D3.title: "King of Aetherbound"
	quest.5F9FA0432B7ECA81.quest_desc: ["The Note Block is a component used to craft Music Spells."]
	quest.5FD185025CC423A8.quest_desc: ["What began with a few wild grapes has become a true art. From Overworld vines to fruit found beyond it, your cellar now holds memories from your entire journey."]
	quest.5FD185025CC423A8.quest_subtitle: "become a Master Winemaker."
	quest.5FD185025CC423A8.title: "Master Winemaker"
	quest.6057DE1171DEA45B.title: "Resources"
	quest.60616D59B9FB05E3.title: "A New Horizon"
