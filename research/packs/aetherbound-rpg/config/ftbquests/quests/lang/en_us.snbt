		"{entity:block_factorys_bosses:yeti ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
