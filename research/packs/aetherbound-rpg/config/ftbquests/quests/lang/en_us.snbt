	quest.78A8A4197649B0DE.title: "Golden Plate"
	quest.78D0F342BE94BE5E.quest_desc: ["Do you regret the origin/class you chose at the beginning of your journey? Take these 2 orbs to change your origin/class. Remember that you will not be able to change again after 2 uses."]
	quest.78D0F342BE94BE5E.title: "Change Class"
