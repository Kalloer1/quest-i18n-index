	quest.7CE78C921F327ED3.quest_desc: ["Cinder Essence is used to craft Upgrade Orbs, which are essential for strengthening your magical equipment."]
	quest.7D093A501C312186.title: "The Aether Stone"
	quest.7D2FD0B0D96DDCA6.title: "Zenithian Skull"
	quest.7D34F132CBF31623.title: "A Forgotten Place"
	quest.7DF29134059E1F8B.quest_desc: ["A calm lake and an open ocean may seem like nothing more than stretches of water, but completely different creatures live beneath their surfaces."]
	quest.7DF29134059E1F8B.quest_subtitle: "Catch a Driftfin in a lake and a Sea Bass in ocean waters."
	quest.7DF29134059E1F8B.title: "Know Your Waters"
	quest.7E306489B915B4DC.quest_desc: [
		"Arcane Essence is one of the main resources in Iron's Spells 'n Spellbooks. It is used to craft magical materials and equipment, including Arcane Cloth and Arcane Ingots."
		""
		"You can find it by exploring structures and defeating magical creatures. Always collect and keep it when you find some — it will be very important throughout your journey."
	]
	quest.7E4504183939E194.quest_desc: ["In Aetherbound, you can build air transportation to make exploration easier; it is quite simple. Nearby, you will find a few quests to create your first aircraft. To learn more about the mod, type @aircraft in JEI."]
	quest.7E4504183939E194.title: "Air Transportation"
