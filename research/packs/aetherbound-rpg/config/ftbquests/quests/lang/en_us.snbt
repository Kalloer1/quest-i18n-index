	quest.767EDA6A5C66805C.title: "On the Trail of the Fallen Warrior"
	quest.76A9470675FEC4EF.quest_desc: ["Welcome to the fisherman's guide! Here you will become a true angler"]
	quest.76A9470675FEC4EF.title: "Fisherman's Guide"
	quest.76D8D4F7CD644BA4.quest_desc: ["There are many types of weapons available in Aetherbound RPG. Choose the weapon that suits you best and craft one!"]
	quest.76D8D4F7CD644BA4.title: "Multiple Choices"
	quest.770D5F42CC2FE19A.title: "Power of Doom"
	quest.771E03A821C3A109.title: "A Welcome Gift"
	quest.773A38883BD816A0.title: "Fish"
	quest.77775ABCCB931FFC.quest_desc: ["When the sun disappears, the waters do not become empty. Some creatures simply wait for darkness to arrive before they begin to move."]
	quest.77775ABCCB931FFC.quest_subtitle: "Catch a Drifting Bream during a night fishing trip."
	quest.77775ABCCB931FFC.title: "Night Fishing"
