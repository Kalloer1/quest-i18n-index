	quest.12BAE6A81A9BE794.title: "§eStack Upgrade"
	quest.12BBEFE477FCD639.quest_desc: [
		"The Portstone offers a more advanced teleportation option."
		""
		"Using Create's mechanical crafting, combine Brass Casings, Warp Stones, Fluix Crystals, Quantum Links, and an Echo Shard to create this powerful teleportation device."
		""
		"Unlike waystones, portstones can only teleport to waystones or other portstones, but cannot be teleported to."
	]
	quest.12BBEFE477FCD639.title: "One-Way Teleporter"
	quest.12BE4EBECF60E611.quest_subtitle: "8x base storage capacity"
	quest.12C789BF2D021A55.quest_subtitle: "When placed in front of the Encased Fan this allows it to smoke items."
	quest.12DD5309B494FF27.quest_desc: [
		"The §bTotem of Torrent§r provides a speed boost when used."
		""
		"Right-click with it to gain a significant speed boost for a short duration."
		""
		"Great for quick escapes or covering large distances quickly."
	]
	quest.133696D3887F1B9D.title: "Enter &5The End&r"
	quest.1341BA9AD66E8888.title: "Already Automated: Infernal Mechanism"
	quest.13909E500FAF8868.quest_desc: [
		"§7With §fPineapple Delight§7, you can automate tropical treats!"
		""
		"§7Setting up pineapple processing lines allows for refreshing drinks and tangy dishes."
		""
		"§fSetup:§7"
		"§71. Create automated §fpineapple§7 farms using §fsprinklers§7"
		"§72. Slice pineapples with the §fslicer§7 into rings and chunks"
		"§73. Process into juice using §fmixers§7 and basins"
		"§74. Create tropical dishes like §fpineapple pizza§7 with §fcooking pots§7"
		""
		"§fTIP:§7 Pineapple juice can be bottled and transported using fluid systems for further recipes!"
	]
	quest.13909E500FAF8868.title: "Tropical Food Factory"
	quest.139DAA6E8CF4267A.quest_desc: [
		"At the bottom of the inventory, you may have noticed a search bar."
		""
		"This is the &dJust Enough Items&r, or &dJEI&r, search bar. "
		""
		"If you type \"Wood\", for example, the &dJEI &ritem list at the right of the screen will show all items with \"Wood\" in the name."
		""
		"Adding a @ at the start of the search query will show the items from a specific mod, for example @Adorn"
		""
		"To favorite an item, press &bA &rwhile hovering over it in the &dJEI &ritem list."
	]
	quest.139DAA6E8CF4267A.quest_subtitle: "Read my description!"
	quest.139DAA6E8CF4267A.title: "&bJust Enough Items (JEI)"
	quest.13A7E4D92775A07B.quest_desc: [
		"The Enchanted Tangle is a magical forest biome with glowing flora and mysterious ambiance."
		""
		"§6Features:"
		"§7• Luminescent plants"
		"§7• Magical atmosphere"
		"§7• Unique mushrooms"
		""
		"This mystical biome seems to be touched by ancient magic, creating an otherworldly environment perfect for magical builds."
	]
	quest.13A7E4D92775A07B.title: "Magical Forest"
	quest.13AC8C979DAF7630.quest_desc: [
		"§7Add sound to your computer systems with §fSpeakers§7!"
		""
		"§7These devices can play notes and custom sounds, allowing you to create alert systems, musical compositions, or ambient noise for your bases."
		""
		"§7Use the §fspeaker.playNote()§7 and §fspeaker.playSound()§7 APIs to control your audio experience."
	]
	quest.13AC8C979DAF7630.title: "Sound Systems"
	quest.13B495F64F5C9D48.quest_desc: ["Grind this stuff up in &6crushing wheels&r to make the dust, which you'll use to make &6steel&r."]
	quest.13B495F64F5C9D48.quest_subtitle: "A better version of coal."
	quest.13D0C3A396600BC2.quest_subtitle: "A Minecart that can fit many things."
	quest.13D4FF6929AE8D8F.quest_subtitle: "An item that allows for increased reach."
	quest.13E39EE147F3A618.quest_subtitle: "Make a sword"
	quest.13E39EE147F3A618.title: "Ready for combat"
	quest.13EDB94BAC780438.quest_subtitle: "Collect some sweet berries"
	quest.145B5B0452755778.quest_desc: [
		"§7Create Netherrack by combining §fCinder Flour§7, §fCobblestone§7, and §fLava§7 in a §fHeated Mixer§7."
		""
		"§7This process yields 2 Netherrack, making it efficient for continuous production loops."
		""
		"§7Automate this process to ensure a steady supply for your factory."
	]
	quest.145B5B0452755778.title: "Cinder Flour + Cobblestone + Lava → Netherrack"
	quest.1471C34FF9AFF488.quest_desc: ["Spawns: Slime chunks / Hp: 50 (Big), 20 (Small) / Attack: 6 (Big) 3 (Small) / Repaired: Slimeballs / Drops: 1-3 slimeballs (Small)"]
	quest.14B9BD4CA8B8C1B2.quest_desc: [
		"§7In addition to Crystal Canyons, the Galosphere mod enhances other underground areas with Lichen Caves."
		""
		"§7These mysterious caverns are filled with unique lichen growths that cling to walls and ceilings."
		""
		"§7Some varieties of lichen glow softly, creating an ethereal atmosphere in these otherwise dark spaces."
		""
		"§7Explore these caves to discover the different varieties of lichen and their unique properties."
	]
	quest.14B9BD4CA8B8C1B2.title: "Lichen Caves"
	quest.14E0A5E1BA5DFA57.title: "Generating heat"
	quest.14FCB5F442B68F9B.quest_subtitle: "Become a walking blast furnace"
	quest.1510968FA820C57C.quest_subtitle: "They're just green, okay?"
	quest.1511BEF5725A6F63.quest_desc: [
		"With the &6enchanting guide&r you can give it a book that you want it to store the enchantment of."
		""
		"Once you have done that, you can then shift and click a &ablaze burner&r to turn it into a &ablaze enchanter&r this will make it so it can receive liquid xp to be able to enchant items."
		""
		"To give it the item you want it to enchant you can either right click the &ablaze enchanter&r or setup a belt line with it placed somewhere in the middle of it"
	]
	quest.1511BEF5725A6F63.quest_subtitle: "Enchanting with create"
	quest.1514D2B88E673FCD.title: "Item Vault"
	quest.1518168983CDCE47.quest_desc: [
		"§7You should already have automated cogwheel production from Chapter 2."
		""
		"§7If you need a refresher, the process is:"
		"§71. Place planks and shafts into your system"
		"§72. Use a §fDeployer §7to combine them"
		""
		"§7Tip: Make sure your cogwheel automation is working efficiently - you'll need plenty of them for sealed mechanisms!"
	]
	quest.1518168983CDCE47.title: "Reusing Cogwheel Automation"
	quest.15185E1EB8C7CA37.quest_desc: ["Your image has transparency? No problem, use a graffiti and spray it on every wall!"]
	quest.152333F57A5C1913.quest_subtitle: "Crafts plates into rods and rods into wires."
	quest.153C2830E21BD9AE.title: "Shulkers FTW"
	quest.155F388D56FB4A5F.quest_subtitle: "Blocks that can fell trees or allow contraptions to fell trees. As well as some crafting recipes like cutting blocks or stripping logs."
	quest.155F388D56FB4A5F.title: "Non-Portable Chainsaw"
	quest.155FBDDA1C6194CA.quest_subtitle: "Lets you turn off parts of contraptions while they are formed."
	quest.156AA919AC78D534.quest_desc: [
		"&6Elevators&r are a really fun way to travel vertically."
		""
		"&6Mr Beardstone&r has done a video on how to make one, feel free to check it out"
	]
	quest.156AA919AC78D534.quest_subtitle: "Vertical travel"
	quest.157A196529FFB48F.quest_desc: [
		"An addon of Aquaculture 2."
		""
		"Add some content about lava and nether."
		""
		"Also have some food, weapon, etc."
	]
	quest.15BC85799CE854FE.quest_desc: ["This is how you find the night lich structure. "]
	quest.15F53F788D18518A.title: "Build Industrial Blasting"
	quest.16019B0E7C9A1FBA.quest_desc: [
		"§7Sculk Grime creates more of itself in the mixing process, allowing for infinite scaling."
		""
		"§7For every 1 Sculk Grime input in the mixing recipe, you get 2 back - a 100% profit!"
		""
		"§7This self-replicating feature is perfect for large-scale automation."
	]
	quest.16019B0E7C9A1FBA.title: "Sculk Grime 🔃"
	quest.1629D6ABF6D114D3.quest_desc: [
		"§7What exploration would be complete without planting your flag to claim new territory? Since ancient times, explorers have marked their discoveries with symbols of their origin."
		""
		"§7Your flag represents:"
		"§7• A symbol of humanity's expansion beyond Earth"
		"§7• A marker visible from orbit to locate your base"
		"§7• A rallying point for future explorers"
		"§7• A statement of your identity in the cosmic frontier"
		""
		"§7Choose your design carefully - it will be photographed and remembered as humanity's first mark on another world."
		""
		"§7While seemingly ceremonial, your flag serves practical purposes too - it can be seen from great distances in the airless lunar environment, helping you navigate back to your landing site."
	]
	quest.1629D6ABF6D114D3.title: "Banner of Discovery"
	quest.162A546C1F6B2CE2.title: "Create Railways Navigator"
	quest.166F4B6298CB6957.quest_desc: ["§7Using §fMechanical Crafter§7, combine §fCopper Sheets§7 with §fRedstone Torches§7 and §fZinc Sheets§7 to create §fCapacitors§7."]
	quest.166F4B6298CB6957.title: "Copper Sheet + Redstone Torch + Zinc Sheet -> Capacitor"
	quest.1674B0C70532E35D.quest_desc: [
		"§7Process §fFlint§7 in a §fCrushing Wheel§7 to create Gunpowder."
		""
		"§7This grinding process breaks down the dense material into a fine, explosive powder."
		""
		"§7Ensure proper containment for this potentially volatile substance."
	]
	quest.1674B0C70532E35D.title: "Flint → Gunpowder"
	quest.16A1EF1C33B4AC2B.quest_desc: ["True Ending dramatically overhauls the vanilla Ender Dragon. Fight a now much stronger Ender Dragon, with increased health, new attacks, and new phases that progressively up the dragon's difficulty. Through other additions like longer lasting dragon breath, particle ambience, and a climatic final hit, the Ender Dragon fight is now much more exciting and more satisfying to beat."]
	quest.16A674F9377E83F4.quest_desc: [
		"§6The Foundation of Technology"
		""
		"Iron is the cornerstone of your technological advancement. This crucial resource will power your journey from basic tools to advanced machinery."
		""
		"§7Where to Find Iron:"
		"§7• Most abundant between Y-levels 16 and 48"
		"§7• Look for exposed ore in caves and cliff faces"
		"§7• Use F3 to check your Y-level while mining"
		""
		"§c§lImportant:"
		"§7You'll need substantial amounts of iron for:"
		"§7• Create's mechanical components"
		"§7• Advanced machinery and automation"
		"§"
		""
		"§6Pro Tip: §7Start stockpiling iron early - you'll thank yourself later!"
	]
	quest.16A674F9377E83F4.title: "§eThe Iron Age"
	quest.16BBC50059227084.quest_desc: [
		"Etched provides new ways to play your own music right in Minecraft! Not only can you create custom records with full customization with the new Etching Table, Etched also provides new ways to play all discs. The new Album Jukebox lets you store up to 9 records which will play in order and on repeat unless powered by redstone, which then it'll pause and reset to the first disc. The Jukebox Minecart lets you play music on the rails with the ability to insert records into it with hoppers or, if the song is ended, restart the song with an activator rail!"
		""
		"📦 Features:"
		"The new bard profession for villagers with various musical trades."
		"New ways to play music such as the Jukebox Minecart, Album Jukebox, or Radio! Play songs on the go, live from a radio station, or multiple songs in order on repeat, just like an album."
		"Insert records into jukeboxes with hoppers! A parity feature from Bedrock."
		"Create your own custom records with the Etching Table! Provide a URL (supports SoundCloud, MP3, WAV, OGG, and Sound Events), a blank disc, and a label to decorate your disc."
	]
	quest.16BBC50059227084.quest_subtitle: "Make your own music disc´s."
	quest.16BBC50059227084.title: "Etched"
	quest.16C81211C6AB6FB9.quest_desc: [
		"The §bGuardian Fossil§r provides water breathing when held."
		""
		"This relic is perfect for underwater exploration and treasure hunting."
		""
		"Keep it in your off-hand to breathe underwater indefinitely."
	]
	quest.16CD1CC9F70A91AF.quest_subtitle: "Can be used to halve or double the rotational speed of connected chaindrives when recieving a redstone signal."
	quest.17407974E30F641D.quest_desc: [
		"Time to turn that wheat into flour using Create's millstone or mechanical press!"
		""
		"§6Simple milling setup:§r"
		"• Place a millstone connected to a power source"
		"• Feed wheat into the top"
		"• Collect flour from the bottom"
		""
		"This flour will be essential for your burger buns in the next steps."
	]
	quest.17407974E30F641D.title: "Flour Power"
	quest.1742597D48E37800.quest_desc: [
		"All of Create is based around Create, obviously, a steampunk mod that lets you build contraptions to do most things you can think of, just not how to do your laundry nor your homework, okay?"
		""
		"Create offers great guides for most of its items by hovering over them in REI or in your inventory and holding down 'W' to \"ponder\" the item, but sometimes it's just best to test each thing out, go big or go home, as the saying goes."
		""
		"Because of this, the chapter is mostly focused on letting you know what exists and giving you a rough outline of the progression of the mod, but at the same time, it will not handhold you all the way to the end since Create is a free for all sandbox mechanic mod. Get building and be smarter."
	]
	quest.1742597D48E37800.quest_subtitle: "&8[Click to read]"
	quest.1742597D48E37800.title: "&6Welcome to All of Create!"
	quest.1742A9042E70FCE5.quest_desc: ["Output voltage and power depends on RPM. More effective than using a generator on the output shaft, as it"]
	quest.1742A9042E70FCE5.quest_subtitle: "Directly integrate a generator into your engine."
	quest.1742A9042E70FCE5.title: "Attach an Alternator"
	quest.17487E5005CF4413.quest_subtitle: "Nether"
	quest.175099CF5696829E.quest_desc: [
		"&9Tasks &rare things that need to be done to complete a quest. If a task is an item, clicking on it will show its recipe."
		""
		"&6Rewards &rare what you get after completing all &9Tasks&r. Click to claim."
		""
		"The pin icon at the top right will pin a quest to your screen."
	]
	quest.175099CF5696829E.quest_subtitle: "Read my description!"
	quest.175099CF5696829E.title: "&6Quests"
	quest.1751BA085DBFF40C.quest_desc: ["L_Ender’s Cataclysm A major combat expansion adding difficult dungeons and powerful boss fights inspired by Minecraft Dungeons. Cataclysm introduces deadly arenas like the Burning Arena (home to Ignis, a blazing infernal boss) and the Crystal Archives (guarded by a magic-infused Illager mage). Each boss guards legendary artifacts – weapons and armor with game-changing abilities. These encounters are multi-phase, bullet-hell battles that will test your combat skills and preparedness to the fullest."]
	quest.17541CB8E37D10F1.quest_subtitle: "Generates energy(E) from kinetic energy, the amount generated is dependent on the rpm and caps at 256E/t"
	quest.175A5130B861267D.quest_subtitle: "No trees required. This rubber is chemically superior!"
	quest.178996586F76CDEA.quest_desc: [
		"§6Basic Backpack"
		""
		"Mobile storage solution!"
		""
		"§7Features:"
		"§7• 27 slots base storage"
		"§7• Wearable in chest slot"
		"§7• Hotkey accessible (B)"
		"§7• 1 upgrade slot"
		""
		"§6Advantages:"
		"§7• Portable storage"
		"§7• Keeps inventory on death"
		"§7• Access while equipped"
		""
		"§6Pro Tip: §7Make a spare backpack for mining trips!"
	]
	quest.178996586F76CDEA.title: "§eBasic Backpack"
	quest.17D3020E559009E3.quest_desc: [
		"When you place the &6water wheel&r you can flow water over it to start producing stress units, it will produce the same stress whether 1 or more sides are covered in water"
		""
		"You can change the aesthetic of the water wheel by right clicking it with a plank and it will appear like that plank type"
	]
	quest.17D3020E559009E3.quest_subtitle: "A method of generation stress"
	quest.17D72340CDE83499.quest_subtitle: "Now you can compress in a 3x3"
	quest.17D9E65A7C586747.quest_desc: ["Bosses of Mass Destruction Adds several new bosses to encounter, each with unique mechanics and lairs. Battle the Night Lich in its ominous tower, the Nether Gauntlet (a massive, animated hand) deep in the Nether, and other fearsome foes. These bosses drop exclusive loot and require careful strategy to defeat. They significantly enrich endgame combat, giving you reasons to prepare automations and gear up before taking them on."]
	quest.17D9E65A7C586747.quest_subtitle: "https://www.minecraft-guides.com/wiki/bosses-of-mass-destruction/"
	quest.17E16AA2AA420FCB.quest_desc: [
		"§7Process §fRed Sand§7 in a §fWashing Station§7 to extract Gold Nuggets."
		""
		"§7This essential extraction process provides the gold needed for various mechanisms and recipes."
		""
		"§7Create an efficient water flow system to automate this washing process."
	]
	quest.17E16AA2AA420FCB.title: "Red Sand → Gold Nugget"
	quest.1812A79944021D76.quest_subtitle: "Think of wires all connecting from several places into a single point."
	quest.1812A79944021D76.title: "Touch"
	quest.184976FBAD10DA79.quest_desc: [
		"&o\"Wait, they're finite?\"&r "
		""
		"Yes, but there is a config option to make them infinite."
	]
	quest.184976FBAD10DA79.quest_subtitle: "Use to check how much oil a deposit has."
	quest.18736449E1AADBCD.quest_desc: ["The &6brass casing&r is the upgrade of the &eandesite casing&r with it's ability to make better quality items for automation"]
	quest.18736449E1AADBCD.quest_subtitle: "The next generation of casing"
	quest.187518D514B536F4.quest_desc: ["The train controls are the block that is needed to allow your train to move once it's assembled. If you put 2 &6train controls&r in a single train then the train will be able to travel in both directions "]
	quest.187518D514B536F4.quest_subtitle: "Make a train move"
	quest.189C185A617C19D6.quest_desc: [
		"§fHaunting §7sand turns it into soul sand. "
		""
		"§fHaunting §7is done by placing an §fEncased Fan §7blowing into a soul campfire or soul fire, then blow that onto a §fConveyor Belt §7or §fDepot §7containing the item you want to §fHaunt§7. "
	]
	quest.189C185A617C19D6.title: "Sand -> Soul Sand"
	quest.189FA3843B2ACEBF.quest_desc: ["Enchant Infuser mod is installed."]
	quest.18A16A3873104A04.quest_desc: [
		"§7Deep beneath the Earth's crust lies the lifeblood of your space program - crude oil, formed from ancient organic matter over millions of years."
		""
		"§c§l*Eagle screeches in the distance* §fDID SOMEONE SAY OIL?"
		""
		"§7This viscous black liquid is §feasy to spot§7 in several locations:"
		"§7• §fFloating on ocean surfaces§7 as dark slicks - just scoop it up!"
		""
		"§7To extract this resource efficiently:"
		"§7• Simply place a pump or use a bucket directly on visible oil sources"
		"§7• Watch for the distinctive §fblack liquid with rainbow sheen§7 - that's freedom juice!"
		"§7• No need for complex exploration - oil practically §fwants to be found§7"
	]
	quest.18A16A3873104A04.title: "Black Gold"
	quest.18B2293D2F46A0ED.quest_desc: [
		"§7The Diesel Engine needs fuels to operate efficiently."
		""
		"§7Plant Oil can be processed from various plant materials using a Basin and Press."
		""
		"§7This is your starting point for diesel production, providing a renewable source of fuel."
	]
	quest.18B2293D2F46A0ED.title: "Plant Oil Production"
	quest.18DE842AEA1692A1.quest_desc: [
		"§7Red Sand is already automatically produced by your previous setups."
		""
		"§7This abundant resource is crucial for gold extraction and various crafting recipes."
	]
	quest.18DE842AEA1692A1.title: "Already Automated: Red Sand"
	quest.18FC3D21BB6EBF76.quest_desc: [
		"Electrical components attached together (without diodes) divide &3voltage&r among themselves, reducing the &2current&r each one gets as you add more things. "
		""
		"&6Diodes&r (as well as &epotentiometers&r and &etransformers&r) split the circuit into different parts, with the output recieving full voltage."
	]
	quest.18FC3D21BB6EBF76.quest_subtitle: "FULL BRIDGE RECTIFIER"
	quest.19166D31F298D0D5.quest_subtitle: "Basically an advanced sign that updates faster if provided with higher RPM. It's like a Bulletin Board you see in train stations that update."
	quest.19183F380B49F31C.quest_subtitle: "A very versitile machine that can pull and push entities aswell as wash, haunt, blast and smoke items. No, this is not for household use."
	quest.1922995814D125D0.quest_desc: [
		"§7To create deepslate:"
		""
		"§71. Smelt the cobbled deeslate using an §fEncased Fan"
		""
		"§7Alternatively, you can also find deepslate naturally in the lower levels of the world if you prefer mining."
	]
	quest.1922995814D125D0.title: "Cobbled Deepslate -> Deepslate"
	quest.195C3BE217EC80D9.title: "Create: Framed"
	quest.197C3CEA5911FDE7.quest_desc: [
		"§7Process §fGravel§7 using §fCrushing Wheels§7 to extract Flint."
		""
		"§7This extraction method efficiently separates the durable flint from common gravel."
		""
		"§7Integrate a sorting system to handle the byproducts of this crushing operation."
	]
	quest.197C3CEA5911FDE7.title: "Gravel → Flint"
	quest.198F2F99B664E425.quest_desc: [
		"§7Iron is a fundamental resource for creating §fCast Iron§7."
		""
		"§7If you haven't already automated iron production in Chapter 3, now would be a good time to review those quests and set up a reliable iron farm."
	]
	quest.198F2F99B664E425.title: "Iron Source"
	quest.1992DEA4F98A92BF.quest_desc: [
		"§7The Sparkle is a friendly crystalline creature that inhabits Crystal Canyons."
		""
		"§7These gentle beings float gracefully around crystal formations and emit a soft glow."
		""
		"§7Approach them carefully - they're curious but shy!"
		""
		"§7When feeling threatened, Sparkles can teleport away, so move slowly when observing them."
	]
	quest.1992DEA4F98A92BF.title: "Crystal Companions"
	quest.19936E26E71B5F68.quest_desc: [
		"Energy is input through the bottom face and output from the top. "
		""
		"Output voltage inherits the input voltage. If there is no input connection, it defaults to 12V."
	]
	quest.19936E26E71B5F68.quest_subtitle: "Stores energy."
	quest.19936E26E71B5F68.title: "Accumulator"
	quest.19B1A849EE98B04C.quest_subtitle: "Lets you see through the eyes of a conductor as well as control their movement."
	quest.19B21BCDEC611C29.quest_desc: ["The &6nature's compass&r is really helpful as it it will let you loacte any biome within the world, in any dimension."]
	quest.19B21BCDEC611C29.quest_subtitle: "The best way to find biomes"
	quest.19CA32D292E55BD3.quest_desc: [
		"Now that you have a comprehensive understanding of Create's railway system and the Railways Navigator, it's time to build something truly magnificent!"
		""
		"§7Project ideas:"
		"§7- Automated mining network with resource delivery"
		"§7- Passenger system connecting distant bases"
		"§7- Factory-to-storage logistics network"
		"§7- Scenic railway tour of your world"
		""
		"§7The possibilities are limited only by your imagination!"
	]
	quest.1A0A698D8C5C848E.quest_subtitle: "Make the eyes and throw them to find your way!"
	quest.1A2E1382C8D51599.quest_desc: [
		"§7Crystal chandeliers are exquisite lighting fixtures crafted from crystal clusters."
		""
		"§7These decorative items combine the beauty of both Allurite and Lumiere crystals."
		""
		"§7Hang them from your ceiling to create a magical, glowing centerpiece for any room."
		""
		"§7The gentle, colorful light they emit creates a beautiful ambiance for any build."
	]
	quest.1A2E1382C8D51599.title: "Crystal Chandeliers"
	quest.1A335FC317FADA0F.title: "Already Automated: Nether Quartz"
	quest.1A47C40F123A9E23.quest_desc: [
		"§d§lOre Processing Guide"
		""
		"This chapter will teach you how to maximize your ore yields through various processing methods. Each step can increase your output significantly!"
		""
		"§6Basic Yields (per ore block):"
		"§7• Mining without Fortune: 1 Raw Ore"
		"§7• Fortune I: Average 1.33 Raw Ore"
		"§7• Fortune II: Average 1.75 Raw Ore"
		"§7• Fortune III: Average 2.2 Raw Ore"
		""
		"§6Pro Tips:"
		"§7• Always use Fortune III for mining when possible"
		"§7• Set up automated processing early"
		"§7• Create mining drills can be enchanted!"
	]
	quest.1A47C40F123A9E23.title: "§d§lMaximizing Your Ore Yields"
	quest.1A541F8D6FF3C21B.quest_subtitle: "When placed in front of the Encased Fan this allows it to wash items.\\n\\nNotably soul sand into nether quartz."
	quest.1A72CD82CDA96C3D.quest_desc: ["Right click these items onto the engine. Keep in mind only one upgrade can be applied to each engine block."]
	quest.1A72CD82CDA96C3D.quest_subtitle: "VTEC engaged."
	quest.1A8BE37C33E3BB02.quest_desc: [
		"§d§lApplied Energistics 2"
		""
		"Welcome to the world of digital storage and automation!"
		""
		"§6Key Features:"
		"§7• Digital item storage"
		"§7• Auto-crafting"
		"§7• Item transport"
		"§7• Wireless access"
		""
		"§6Getting Started:"
		"§7• Find meteorites for resources"
		"§7• Create basic components"
		"§7• Build your first ME system"
		""
		"§6Pro Tips:"
		"§7• Plan your storage network"
		"§7• Automate component crafting"
		"§7• Use channels efficiently"
	]
	quest.1A8BE37C33E3BB02.title: "§d§lDigital Storage Network"
	quest.1A8BE37C33E3BB20.quest_desc: [
		"Welcome to §lChapter 2!"
		""
		"This chapter will take you through the basics of create, and explore other mods as well. "
		""
		"By the time youre done here you will have your first fully automated production line!"
	]
	quest.1A8BE37C33E3BB20.title: "2. Creating Something Amazing"
	quest.1AB5695E3FFA5338.title: "Make a &dNetherite Ingot&r"
	quest.1ABAF66FF1313E57.quest_desc: ["The &6hose pulley&r has the ability to pull liquids from the world to be transported, if the source the pulley is pulling from is larger than 10,000 blocks then it classes it as an infinite source of liquid"]
	quest.1ABAF66FF1313E57.quest_subtitle: "Moving Liquid"
	quest.1ABC2ADBFEF3144D.quest_subtitle: "Connectors insert/extract energy from/into blocks and wires are used to connect between connectors."
	quest.1AC0EC7056C0DCD4.quest_subtitle: "Craft any drawer"
	quest.1AD0B86153E9996E.quest_desc: [
		"The Black Eye is found in Buried Treasure chests."
		""
		"§7Find Buried Treasure maps from shipwrecks or ocean ruins."
		"§7Follow the X on the map to locate the buried chest."
		"§7Dig down at the X until you find the chest, usually buried in sand or gravel."
		""
		"§6Pro Tip: §7Can use the explorer's compass to find the structure buried treasure. "
		"{image:explorerscompass:item/explorerscompass_00 width:100 height:100 align:center}"
	]
	quest.1AD2B9B31F6182E3.quest_desc: [
		"The Maple Taiga features beautiful maple trees with distinctive colored leaves."
		""
		"§6Features:"
		"§7• Red and orange foliage"
		"§7• Maple trees"
		"§7• Autumn atmosphere"
		""
		"This biome has an eternal autumn feeling with its colorful landscape."
	]
	quest.1AD2B9B31F6182E3.title: "Autumn Woodland"
	quest.1AF4019667A352B1.quest_desc: ["The &6trim&r is a really handy utility block within the mod. It is used to link up drawers to eachother when they don't directly touch, it's pretty much a fake drawer as it cannot store any items within it but is still part of your total drawer network"]
	quest.1AF4019667A352B1.quest_subtitle: "Connect drawer without worrying of loosing items into them"
	quest.1AFE8D1CE55C1527.title: "Enter a &dBastion&r"
	quest.1B20AE98B71057DE.quest_desc: [
		"Create beautiful vintage train aesthetics with these Steam 'n' Rails components."
		""
		"§7Vintage train elements:"
		"§71. Steam whistles for authentic sound effects"
		"§72. Coal-fired bogeys for traditional steam look"
		"§73. Brass detailing on external components"
		"§74. Wood paneling for carriage exteriors"
		""
		"§7Tip: Use a combination of brass, copper, and dark wood to achieve an authentic vintage steam train appearance!"
	]
	quest.1B20AE98B71057DE.title: "Vintage Train Aesthetics"
	quest.1B41A4C6367C9D8F.quest_desc: [
		"§6Taverns and Villages"
		""
		"Villages are no longer simple collections of basic buildings. They now feature proper taverns, inns, and much more detailed structures."
		""
		"§7Enhanced village features:"
		"§7• Proper taverns with seating areas"
		"§7• Inns with guest rooms"
		"§7• More detailed crafting buildings"
		"§7• Improved farms and animal pens"
		""
		"§6Pro Tip: §7Villagers still follow vanilla professions, but their workplaces are now much more immersive and detailed."
	]
	quest.1B41A4C6367C9D8F.title: "A Warm Village Welcome"
	quest.1B41E78319E3E187.title: "Aluminum Cogwheels"
	quest.1B7A59DCF9AC2A48.quest_desc: [
		"The §bArcheology Table§r is the central workstation for all your archeological endeavors."
		""
		"With it, you can carefully clean your excavated finds and discover ancient artifacts!"
		""
		"Place it down and prepare to uncover the secrets of the past."
	]
	quest.1B7A59DCF9AC2A48.title: "Setting Up Shop"
	quest.1B92C8EC4060BDAC.quest_desc: [
		"The wrench is one of the most important tools in Create. It allows you to rotate blocks, dismantle contraptions, and adjust various settings."
		""
		"§7Tip: Right-click on Create blocks to rotate them, and shift-right-click to dismantle them without breaking them."
		""
		"§7Hold the wrench in your off-hand to see the rotation axis when placing blocks!"
	]
	quest.1B92C8EC4060BDAC.title: "The Engineer's Best Friend"
	quest.1B9B1BD4925D51CA.quest_desc: [
		"§7Expand your control center with automatic resource management!"
		""
		"§7Connect your ComputerCraft network to your §fAE2 system§7 using CCCBridge to create a smart factory that:"
		""
		"§7- §fMonitors stock levels§7 of important resources"
		"§7- §fAutomatically crafts§7 items when supplies are low"
		"§7- §fBalances production§7 across multiple systems"
		"§7- §fOptimizes energy usage§7 during idle times"
		""
		"§7This integration creates a truly self-sufficient base that manages itself!"
	]
	quest.1B9B1BD4925D51CA.title: "Smart Factory"
	quest.1B9D9380E2462CF1.quest_desc: ["Ancient civilizations left behind knowledge of explosives in the form of §bRusty Bombs§r."]
	quest.1B9E7D3F5A8C2E6D.quest_desc: [
		"Perfect for desert builds, the Sandy Waystone offers the same teleportation functionality with a desert aesthetic."
		""
		"Use sandstone as the base and follow the sequenced assembly process to create this desert-themed waystone."
	]
	quest.1B9E7D3F5A8C2E6D.title: "Desert Teleporter"
	quest.1B9FFD0E8EE347BF.quest_desc: [
		"§7Kelp farming has already been automated in your factory."
		""
		"§7You can leverage this existing system by connecting it to your new production chain."
		""
		"§7Simply route some of the kelp from your farm to the mixer that produces slime balls."
	]
	quest.1B9FFD0E8EE347BF.title: "Already Automated: Kelp"
	quest.1BAE590C1F42160D.quest_subtitle: "Press &c\"Z\"&r To see How to Build It"
	quest.1BAE590C1F42160D.title: "Build a Distillation"
	quest.1BB29574AFF6DF58.quest_desc: [
		"§7Sculk can be created by haunting §fMossy Cobblestone§7."
		""
		"§7Use §fSoul Fire§7 or other haunting methods from the Create mod to transform the moss into sculk."
		""
		"§7The haunting process infuses the moss with otherworldly properties, creating the sculk material."
	]
	quest.1BB29574AFF6DF58.title: "Mossy Cobblestone → Sculk"
	quest.1BBDABD283C63B92.quest_desc: [
		"§7Sculk-infused amethyst has unique properties that can be harnessed for advanced enchanting."
		""
		"§6The Sculk Enchanter:"
		"§7• Allows for unique Otherside-specific enchantments"
		"§7• Enables upgrading existing enchantments beyond normal limits"
		"§7• Consumes Echo Shards and experience as catalysts"
		""
		"§6Special enchantments:"
		"§7• Sculk Sense: Detect nearby entities through walls"
		"§7• Sonic Reverberation: Chance to stun opponents"
		"§7• Warden's Strength: Increased damage in low light"
		"§7• Echo Location: Highlights nearby valuable resources"
	]
	quest.1BBDABD283C63B92.title: "Advanced Enchanting"
	quest.1BC39EF3E9B62D5E.quest_desc: [
		"The trans-Neptunian objects represent the final frontier of our solar system. These distant worlds hold secrets and challenges unlike anything you've faced before."
		""
		"Eris, Makemake, and Haumea each offer unique environments and valuable resources."
		""
		"§7These distant worlds are the final test before you can truly call yourself a master of space exploration."
	]
	quest.1BC39EF3E9B62D5E.title: "The Trans-Neptunian Frontier"
	quest.1BEF48D2C9B8E130.quest_desc: [
		"§7Create's §fMixer§7 and §fBasin§7 combination is perfect for automating mixing recipes from §fFarmers Delight§7 and its addons."
		""
		"§fSetup:§7"
		"§71. Place a §fBasin§7 on solid ground"
		"§72. Position a §fMixer§7 above the basin and power it"
		"§73. Use §ffunnels/hoppers§7 to add ingredients to the basin"
		"§74. Add a §fchute§7 or §ffunnel§7 below to extract finished products"
		""
		"§7Try automating §fdough production§7 by having wheat flour and water mixed together in the basin!"
		""
		"§fTIP:§7 For recipes requiring heat, place a §fblaze burner§7 under the basin!"
	]
	quest.1BEF48D2C9B8E130.title: "Automated Mixing"
	quest.1BFE0FCD48DD1C61.quest_desc: ["The &6item drain&r has the ability to take liquid out of a container and then it stores it until it it is piped out into a container"]
	quest.1BFE0FCD48DD1C61.quest_subtitle: "Fluid extraction"
	quest.1C1623E431E4B7DE.quest_subtitle: "This block is actually goated for use with conveyor corners, in some orientations at least."
	quest.1C1D43D2DF09E7FF.quest_subtitle: "Takes fuel from adjacent tanks without pumps."
	quest.1C1D43D2DF09E7FF.title: "Draw Fuel Automatically"
	quest.1C668CE3D287CA22.quest_desc: ["The &6mechanical grindstone&r has the ability to take enchants off of armour and store the xp it collects as liquid xp that can then be solidified to be consumed to be used again, it will be really helpful to have at a mob farm for armour drops"]
	quest.1C668CE3D287CA22.quest_subtitle: "Liquid xp?"
	quest.1C7C5B31498DEC96.title: "Fly to the sky"
	quest.1C884C6D53A3B7A5.quest_desc: ["Attack: 18 / Hp: 360 / Repaired: Netherite scraps / Drops: 1-3 netherite scraps / Info: Right click with a gold bar to apply gold trim, turning piglins neutral - Remove with shears. Right click with lava to unlock the coal golem summon ability."]
	quest.1C901D6957027EB8.quest_subtitle: "Welcome to Create Central Kitchen, a mod offering more tools and methods to automate food processing for other mods in Create."
	quest.1CA119371C3C3FC7.title: "Caution Blocks"
	quest.1CB93A1822BC961D.quest_desc: [
		"§7Set up a §fLava Production System§7 using §fDripstone and Cauldrons§7 or an §fIgneous Extruder§7."
		""
		"§7Buffer large quantities in §fFluid Tanks§7 to ensure a steady supply."
	]
	quest.1CB93A1822BC961D.title: "Lava Production"
	quest.1CE6DB5F873483AF.quest_subtitle: "Chutes are used to transfer between inventories vertically."
	quest.1CFBDF8A36DB5208.quest_desc: [
		"§d§lChipped Guide"
		""
		"Discover the art of decoration with Chipped!"
		""
		"§6Main Features:"
		"§7• Workstations for various materials"
		"§7• Thousands of block variants"
		"§7• Enhanced building possibilities"
		"§7• Detailed decoration options"
	]
	quest.1CFBDF8A36DB5208.title: "§d§lChipped Decoration Guide"
	quest.1D03026968E6D320.quest_desc: [
		"§7Turtles are programmable robots that can move around and interact with the world."
		""
		"§7They can mine, build, farm, and fight - all through the power of code!"
		""
		"§7Equip them with tools to enhance their capabilities and set them to work on your tedious tasks."
	]
	quest.1D03026968E6D320.title: "Programmable Friends"
	quest.1D0610F89037F84B.quest_desc: [
		"§7If you followed the questline correctly in Chapter 3, you should already have Diorite automation set up."
		""
		"§7If not, refer back to those quests to establish a reliable diorite supply."
	]
	quest.1D0610F89037F84B.title: "Already Automated: Diorite"
	quest.1D267ADE18DD9817.quest_desc: [
		"The &6printer&r will take any enchanted book by right clicking on it to save the enchantments you want to print onto new books."
		""
		"As long as the printer is given enough liquid xp it will make a duplicate of the book you have given it"
		""
		"You can also duplicate books you have written in by giving it the written book, then giving the &6printer&r liquid ink &a(made in the mixer)&r"
	]
	quest.1D267ADE18DD9817.quest_subtitle: "Enchanted Book Duplication kind of"
	quest.1D270EBA3325F6BC.quest_desc: [
		"§7To set up a §fPumpjack§7. "
		""
		"§7For instructions on how to build a pumpjack, look at the ponder. "
	]
