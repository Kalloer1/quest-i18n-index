	quest.1DE428DE5A0AB47C.quest_desc: [
		"Funnel coal in the top and make sure you pump out the &eCO2&r."
		""
		"When it's finished processing the coal, the front doors will open and it will spit the &6coal coke&r out the front. It's a good idea to have hoppers or a belt there to catch it."
	]
	quest.1E05885058530B7D.quest_desc: [
		"These are just the minimum blocks you need to make a working pumpjack. "
		""
		"Just like any other create contraption, you can &asuperglue&r basically anything to a pumpjack, with the stipulation that the main arm is complete."
	]
	quest.1E05885058530B7D.quest_subtitle: "A normal looking pumpjack. Make sure to superglue it!"
	quest.1E05885058530B7D.title: "Pumpjack"
	quest.1E10F0CF4AD8ABBD.quest_desc: [
		"§6Natural Stone Masonry"
		""
		"Create rustic and natural-looking stone structures!"
		""
		"§7Try these techniques:"
		"§7• Mix cracked and mossy variants"
		"§7• Combine different stone types"
		"§7• Use stone brick pillars"
		"§7• Add vines for aged effect"
		""
		"§6Pro Tip: §7Perfect for castles, ruins, and medieval builds"
	]
	quest.1E10F0CF4AD8ABBD.title: "§eStone Masonry"
	quest.1E11F2E11FED3F66.quest_desc: [
		"§7Set up a §fLava Production System§7 using §fDripstone and Cauldrons§7 or an §fIgneous Extruder§7."
		""
		"§7For continuous flow, use §fMechanical Pumps§7 to extract lava from your production setup."
	]
	quest.1E11F2E11FED3F66.title: "Lava Production"
	quest.1E3E31094CEB7354.quest_desc: [
		"The final trophies in your collection represent the most distant and challenging worlds in our solar system."
		""
		"Displaying these globes shows that you've truly mastered space exploration and conquered the final frontier."
		""
		"§7A complete collection of all celestial globes is the mark of a true cosmic explorer."
	]
	quest.1E3E31094CEB7354.title: "Dwarf Planet Collection"
	quest.1E452DB4DCAD2939.title: "Obtain Crude Oil"
	quest.1E4A85A9E9E49BC6.quest_desc: [
		"Jupiter's harsh environment requires special resources and equipment."
		""
		"Collect Juperium, the unique metal found on Jupiter. This valuable material will be essential for crafting your Tier 5 rocket components."
		""
		"§7Juperium can be processed using standard Create mechanisms, but be prepared for the high gravity affecting your equipment."
	]
	quest.1E4A85A9E9E49BC6.title: "The Gas Giant"
	quest.1E91F0D9C45968DA.quest_subtitle: "Collect some cocoa beans"
	quest.1EB10CA4C9F718FE.quest_desc: [
		"§7Channel a portion of your automated §fRedstone Dust§7 to your Blaze Powder production."
		""
		"§7This essential component will be combined with other materials in a Superheated Mixer."
		""
		"§7Allocate sufficient quantities to maintain uninterrupted production of multiple recipes."
	]
	quest.1EB10CA4C9F718FE.title: "Redstone"
	quest.1EB1D93A86CBAC7D.quest_desc: [
		"Steam 'n' Rails adds the Conductor's Whistle for controlling trains remotely."
		""
		"§7To use a conductor's whistle:"
		"§71. Craft the whistle"
		"§72. Bind it to your train by right-clicking the train"
		"§73. Use the whistle to summon your train from anywhere"
		""
		"§7Tip: This is extremely useful for calling your train to your location when you don't want to walk back to it!"
	]
	quest.1EB1D93A86CBAC7D.title: "Remote Train Summoning"
	quest.1EC3F690CC0DAC15.quest_desc: [
		"Expand your menu with more options! Create automated production lines for:"
		""
		"§6New menu items:§r"
		"• Chicken sandwiches (Chicken + Bread)"
		"• Fish filets (Fish + Bread)"
		"• Veggie burgers (Plant-based alternatives)"
		"• Breakfast sandwiches (Eggs + Bread)"
		""
		"§6Bonus challenge:§r"
		"Create a system that can dynamically change which food it's producing based on a selection mechanism!"
	]
	quest.1EC3F690CC0DAC15.title: "Menu Expansion"
	quest.1F063D68BCDEAE95.quest_subtitle: "Sacrifice some storage space to hold liquids"
	quest.1F08C023EF656B55.quest_subtitle: "Become a walking food smoker"
	quest.1F224ED4009FDB73.quest_subtitle: "Will keep any item in the player inventory as full as possible"
	quest.1F2577642D25AFA0.quest_subtitle: "Used for filling rebar with liquid concrete."
	quest.1F2F0F774778F3B2.quest_desc: [
		"The Train Observer can detect and respond to passing trains."
		""
		"§7To use observers effectively:"
		"§71. Place them along your tracks"
		"§72. Connect to redstone components"
		"§73. They'll emit signals when trains pass by"
		""
		"§7Tip: Perfect for triggering station announcements, gates, or other automated systems!"
	]
	quest.1F2F0F774778F3B2.title: "Train Detection Systems"
	quest.1F3D84A971A7BD8B.quest_desc: ["Item allows you to TP back to your spawn point. Useful before you get waystones going. "]
	quest.1F4EB3A4D04A0D94.title: "Already Automated: Tuff"
	quest.1F58AA41F78BE2D7.quest_desc: [
		"The Magical Eye can be found in two ways:"
		"1. In Woodland Mansion chests"
		"2. Dropped by Evokers"
		""
		"§7Woodland Mansions are rare, large structures in Dark Forest biomes."
		"§7Evokers are hostile illager mages that spawn in Woodland Mansions."
		"§7Be well-prepared before exploring a mansion - they're full of dangers!"
		""
		"§6Pro Tip: §7You can buy a Woodland Mansion map from a Cartographer Villager. You can also get it via the quest"
		"{ \"text\": \"Tyros\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"7F5963067BF634EE\" } }"
	]
	quest.1F7F129C7C966484.quest_desc: ["In this page is all of the &astructures&r that you can find each &ctrim&r at"]
	quest.1F7F129C7C966484.quest_subtitle: "All the locations"
	quest.1F8510F9C7974FA1.quest_desc: [
		"&6Spice of Life: Carrot Edition "
		"A mod that rewards dietary variety by giving permanent health increases for trying new foods. As you sample different meals (say, bread, then steak, then a salad, etc.), you’ll notice your hearts gradually increase, reflecting improved nutrition. However, eating the same food repetitively yields diminishing returns. This encourages you to explore the diverse food options – including all the Farmer’s Delight dishes – rather than sticking to a single staple. Over time, you can significantly boost your max health by being an adventurous eater, which will help in tough battles."
		""
		"&5Spice of Life: Valheim Reforged "
		"Overhauls the food and stamina system inspired by the game Valheim. Instead of a hunger bar that you simply fill, foods provide stamina and health buffs and you can eat a limited number at once for stacked benefits. For example, you might eat a protein-rich meal to raise max health and a fruit dessert to boost stamina regeneration. The key is balancing different food types for an optimal combination. This system makes food choices more critical – you’ll plan your diet before a big expedition or boss fight for the best advantage. It meshes with Farmer’s Delight by giving all those complex meals meaningful roles."
	]
	quest.1F8510F9C7974FA1.title: "Food for your health!"
	quest.1F9E7D3B5A8C2E6D.quest_desc: [
		"Now that you have a basic teleportation network set up, it's time to create some portable teleportation tools!"
		""
		"The Warp Scroll is a one-time-use item that allows you to teleport to any waystone in your network from anywhere."
	]
	quest.1F9E7D3B5A8C2E6D.title: "Portable Teleportation Scroll"
	quest.1F9EC6F1F918E411.quest_desc: [
		"§7Route a portion of your automated §fRed Sand§7 production to your gold extraction process."
		""
		"§7This valuable resource will be washed to extract Gold Nuggets."
		""
		"§7Set up a dedicated line to ensure consistent supply for your Blaze Rod production."
	]
	quest.1F9EC6F1F918E411.title: "Red Sand"
	quest.1FCEADEF0E5436BD.quest_subtitle: "Press &c\"Z\"&r To see How to Build It"
	quest.1FCEADEF0E5436BD.title: "Build Coke "
	quest.1FE273AE15FB9F43.quest_subtitle: "Gives a redstone signal base on the least full slot"
	quest.1FF1ED3BD097DCC0.quest_desc: [
		"Funnels are the input/output components for Create machinery."
		""
		"§7Brass funnels have filtering capabilities and can be more precisely controlled."
		""
		"§7Use them to automate item movement into and out of your contraptions!"
	]
	quest.1FF1ED3BD097DCC0.title: "Input and Output"
	quest.1FF6AA4B49FD2432.quest_desc: [
		"§6Resource Management"
		""
		"Efficient storage and sorting is crucial for large-scale processing."
		""
		"§7Storage Solutions:"
		"§7• Bulk Storage"
		"§7• Smart Sorting"
		"§7• Buffer Chests"
		"§7• Overflow Management"
		""
		"§6Organization Tips:"
		"§7• Group similar materials"
		"§7• Label everything"
		"§7• Plan for expansion"
		"§7• Use item filters"
		""
		"§6Pro Tip: §7Build a central storage system near your processing area!"
	]
	quest.1FF6AA4B49FD2432.title: "§eStorage Solutions"
	quest.205DCDADC7B500B9.quest_subtitle: "A builder's best friend, this extension is going to be handy when reaching far and is perfect for building not only aesthetically, but also machinery with practicality."
	quest.20C0B4B05C8F4FC0.quest_desc: [
		"The &6mechanical crafter&r can be made into a multi block to craft different items, the biggest item it will need to craft is the crushing wheels"
		""
		"The largest size and shape of the crushing wheel is shown below with an X the O don't have any &6mechanical crafters&r"
		""
		"&6OXXXO&r"
		"&6XXXXX&r"
		"&6XXXXX&r"
		"&6XXXXX&r"
		"&6OXXXO&r"
	]
	quest.20C0B4B05C8F4FC0.quest_subtitle: "A large crafting table"
	quest.212085CF1702E53A.quest_desc: ["Abavuthana are the scourge of the savanna. These bird-like creatures scorch the ground they walk on and hunt animals with little restraint. They are one with the masks suspended in front of their glowing heads. In combat, Abavuthana take turns use their claws to slash at foes. Each hunting pack is led by an Umvuthana Raptor, which has extra long talons it uses to block attacks. Abavuthana make traversing the savanna quite dangerous, as they can surround their prey quickly and put up a good chase. When defeated, Abavuthana will sometimes drop their masks as items that the player can wear. Each mask bestows a different, small buff."]
	quest.2165E80C52C79992.quest_desc: [
		"Press &bR &rwhile hovering over an item to view its Recipe"
		""
		"Press &bU &rwhile hovering over an item to view its Uses"
		""
		"Press &bX &rto Crawl"
		""
		"Press &bRight Click &rwhile crouching to hold a block. (Useful for chests, doesn't work on all blocks)"
		""
		"Press &bC &rto Zoom"
		""
		"Press &bM &rto open the World Map"
		""
		"Press &bN &rto Create a New Waypoint"
		""
		"Press &bU&r to see Player Death History"
		""
		"Press &bO&r to view the Claiming Screen"
		"{@pagebreak}"
	]
	quest.2165E80C52C79992.quest_subtitle: "Read my description! Make sure to scroll down."
