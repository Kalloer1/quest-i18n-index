	quest.5AA9EBBF1BF0D22D.quest_desc: [
		"Neptune, the farthest gas giant from the Sun, contains valuable Neptunium for advanced technology."
		""
		"Craft a Tier 8 rocket to reach this distant world. Neptune's extreme conditions will require your most advanced equipment."
		""
		"§7The pressure and cold of Neptune create unique resources impossible to find elsewhere in the solar system."
	]
	quest.5AA9EBBF1BF0D22D.title: "Deep Blue Frontier"
	quest.5B480653F522270A.quest_desc: [
		"§7Process §fNetherrack§7 using §fCrushing Wheels§7 to produce Cinder Flour."
		""
		"§7This fine, fiery powder contains the essence of the Nether and is crucial for several advanced recipes."
		""
		"§7Design your automation to handle the heat-reactive properties of this material."
	]
	quest.5B480653F522270A.title: "Netherrack → Cinder Flour"
	quest.5B6E4C516786A1EF.quest_desc: [
		"Music sheets allow you to record and play back melodies."
