	quest.6859F2C39DD0235C.quest_desc: [
		"§7With sufficient §fDesh§7 collected, you can now craft a more advanced space vehicle."
		""
		"§7The §fRover§7 allows for faster travel across the lunar surface and can store oxygen."
		""
		"§7Explore the vast lunar landscape efficiently to discover hidden resources and lunar structures."
	]
