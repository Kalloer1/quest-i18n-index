	quest.1209EAFCD7457303.quest_subtitle: "Use to check for Crude Oil Deposits. Create Diesel Generators"
	quest.1210C5B720AE249F.quest_subtitle: "Made by crushing dirt in crushing wheels."
	quest.1241EA7167598A7B.quest_desc: ["§7Put your newly automated cobblestone into a §fCrusher §7or §fMillstone §7to turn it into gravel. "]
