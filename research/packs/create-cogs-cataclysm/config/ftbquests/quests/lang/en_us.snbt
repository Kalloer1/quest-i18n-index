	quest.3F98083A1EF33FD7.quest_desc: [
		"§6Iron Tier Storage"
		""
		"Your first storage upgrade!"
		""
		"§7Features:"
		"§7• Base: 27 slots"
		"§7• Upgrade: +18 slots"
