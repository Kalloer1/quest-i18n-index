	quest.1283AD09A6377D92.title: "Obtain Slag"
	quest.12913E20A87ABA1F.quest_subtitle: "Allows for the creation of contraptions that move up and down."
	quest.12BAE6A81A9BE794.quest_desc: [
		"§6Stack Upgrade"
		""
		"Increase stack sizes in your storage!"
		""
		"§7Features:"
		"§7• Tier 1-5: 2-32x stack size"
		"§7• Works with all storage types"
		"§7• Upgrades stack"
		""
		"§6Benefits:"
		"§7• Double storage capacity"
		"§7• Better space efficiency"
		"§7• Perfect for bulk items"
		""
		"§6Pro Tip: §7Use in barrels storing common blocks!"
