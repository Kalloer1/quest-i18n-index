	quest.228408168636F0BB.title: "Obtain a &6Ward Armour Trim&r"
	quest.22A0A97EA02AF527.quest_desc: [
		"The Rainbow Beach features colorful sand and a vibrant atmosphere."
		""
		"§6Features:"
		"§7• Multi-colored sand"
		"§7• Unique shoreline"
