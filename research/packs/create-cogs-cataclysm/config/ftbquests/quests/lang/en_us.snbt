	quest.3E8F51E28BFDE808.title: "Bun Basics"
	quest.3E903F2708893135.quest_desc: [
		"Congratulations, master archeologist! You've unearthed the secrets of the ancient world."
		""
		"You've discovered fossils, assembled totems, and found powerful artifacts with unique enchantments."
		""
		"Your archeological knowledge is unmatched, but there are always more mysteries waiting to be discovered..."
		""
		"Continue exploring the world and uncovering its hidden history!"
