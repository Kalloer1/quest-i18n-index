	quest.41BC665DC213A3C7.quest_subtitle: "Increase the area in which items come towards you"
	quest.41CDD42E11C16E90.quest_desc: [
		"Mars is a harsh world with valuable resources. Here you'll find Ostrum, the next material in your space progression."
		""
		"Key Martian features:"
		"- Ostrum ore for advanced components"
		"- No breathable atmosphere"
		"- More extreme day/night temperature variations"
		"- Martian villages and structures to explore"
		""
		"§7Warning: Mars dust storms can be dangerous. Be prepared for reduced visibility and harsh conditions."
	]
	quest.41CDD42E11C16E90.title: "The Red Planet"
	quest.4206216A5F414642.quest_subtitle: "With the power of dried kelp, mechanical belts are useful in moving items either in a straight line and diagonally. Make sure to stick one shaft on each end to connect so it will work."
	quest.4206216A5F414642.title: "Don't wear this, it's not for clothes."
