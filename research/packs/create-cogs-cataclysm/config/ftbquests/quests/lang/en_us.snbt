	quest.2C9CA65034E3BC7C.title: "§eAccessing Your Storage"
	quest.2CC2A316CF9D925B.quest_desc: ["§7Using a §fMechanical Crafter§7, combine §fRedstone Dust§7, §fPrinted Silicon§7 and §fPrinted Logic Circuit§7 to create §fLogic Processors§7."]
	quest.2CC2A316CF9D925B.title: "Redstone Dust + Printed Silicon + Printed Logic Circuit -> Logic Processor"
	quest.2CC43C68A8EECB8D.quest_subtitle: "The densest kinetic source. Although it also has the highest complexity, requiring a steady source of water and heat, and no this is not a steam locomotive like Thomas the Tank Engine."
	quest.2CC43C68A8EECB8D.title: "Full Steam Ahead!"
	quest.2CD6597AE3312F20.quest_desc: [
		"&3Steel vat&r plus heating required. "
		""
		"Will form nearly instantly in the &4naphtha&r vat, so for most cases you can think of liquid plastic being a direct result of naphtha."
	]
	quest.2CD6597AE3312F20.quest_subtitle: "Ah yes, the molten plastic brush."
	quest.2CEBFF442BCA297D.quest_desc: ["Tired of the overly pixelated, limited amount of paintings without a proper selection GUI? Immersive Paintings allows users to create their own, Minecraft-stylized paintings via drag and drop, screenshots, or by providing a URL. No resource pack required, Multiplayer friendly and easy to use."]
	quest.2D0B2D01669E88DD.quest_subtitle: "Simply a Potato Cannon."
	quest.2D20497D321CE107.title: "Rebar Concrete"
	quest.2D5D4E33C46A6D4F.quest_desc: [
		"§7Desh is a valuable lunar material with unique properties that make it ideal for advanced space technology."
		""
		"§7Mine §fMoon Desh Ore§7 and process it to craft specialized space equipment."
		""
		"§7This rare resource is crucial for tier 2 rockets and advanced life support systems."
	]
	quest.2D5D4E33C46A6D4F.title: "Lunar Mining: Desh"
	quest.2D6D94C21C3A5B4F.quest_desc: [
		"§7Route a portion of your automated §fTuff§7 production to your metal extraction process."
		""
		"§7This stone will be crushed to extract valuable Copper and Zinc Nuggets."
		""
		"§7Ensure a steady supply to keep your metal production lines operational."
	]
	quest.2D6D94C21C3A5B4F.title: "Tuff"
	quest.2D94489E09F8DD9C.quest_desc: [
		"The &3steel mechanism&r is used in many upcoming machines."
		""
		"Similar to the precision mechanism, it requires a &6heavy plate&r to have various items deployed onto it:"
		""
		"1. Steel cogwheel"
		"2. Nickel plate"
		"3. Large steel cogwheel"
		"4. Lead plate"
		"5. Screws"
		"6. Screwdriver"
		""
		"Do this twice for a 94% chance of getting a steel mechanism."
	]
	quest.2D94489E09F8DD9C.quest_subtitle: "Automate this or prepare to suffer."
	quest.2D94489E09F8DD9C.title: "&3Steel Mechanism"
	quest.2DCA30B19B8F361F.title: "Locate a &2Mansion&r"
	quest.2DCF9C41FA7D28E4.quest_desc: ["The &6train station&r is the part that makes trains work. You can create a train from within gui of the train station. It's other job is as the place where the train will stop along a route, these are the place you enter into the &etrain schedule&r as the stopping locations"]
	quest.2DCF9C41FA7D28E4.quest_subtitle: "Waypoints for trains"
	quest.2DEF812916A51C34.quest_desc: ["Found in veins in the nether."]
	quest.2DEF812916A51C34.quest_subtitle: "Yellow chemistry... eugh..."
	quest.2DF9A428CDDA39AD.quest_desc: [
		"CosmeticArmours introduces an assortment of new Armour sets and Accessories into your Minecraft worlds, each Armour piece prioritising aesthetic appeal whilst still maintaining its practicality for survival worlds!"
		""
		"All Armours are fully balanced to reflect the materials used in crafting, ensuring Armour progression remains balanced, whilst still allowing you to show off your unique individuality and style~"
	]
	quest.2E01A9C13915EEBC.quest_desc: [
		"§d§lGalosphere Guide"
		""
		"Discover the wonders of crystal caves!"
		""
		"§6Main Features:"
		"§7• New underground biomes"
		"§7• Silver and other resources"
		"§7• Unique crystal formations"
		"§7• Special tools and items"
		""
		"§7This chapter will guide you through discovering the magical crystal caves and harnessing the unique properties of allurite, lumiere, and silver."
	]
	quest.2E01A9C13915EEBC.title: "§d§lGalosphere Exploration Guide"
	quest.2E10D93D926631F6.quest_subtitle: "An item used to craft more advanced mechanical items."
	quest.2E232FE3E08A0E7F.quest_desc: ["You can place &6large cogwheels&r at 90 degrees to eachother and it will change the direction of rotation"]
	quest.2E232FE3E08A0E7F.quest_subtitle: "The larger of the cogwheels"
	quest.2E2B35309C0FA2D4.quest_desc: [
		"§7Process §fSugar Cane§7 in a §fCrushing Wheel§7 to produce Sugar."
		""
		"§7This refinement process breaks down the fibrous plant into sweet crystalline particles."
		""
		"§7Design an automated harvesting and processing system for a continuous supply."
	]
	quest.2E2B35309C0FA2D4.title: "Sugar Cane → Sugar"
	quest.2EAC9297D928AB46.quest_desc: ["Spawns: Villages / Hp: 40 / Repaired: Wheat / Drops: 1-4 Wheat / Info: Protects tilled soil from being trampled in a 10x10 radius."]
	quest.2EAE2F939F126031.quest_desc: [
		"§7Water is a fundamental resource needed throughout your automation processes."
		""
		"§7Set up a reliable water collection and distribution system using pipes and tanks."
		""
		"§7Infinite water sources are perfect for ensuring your automation never runs dry."
	]
	quest.2EAE2F939F126031.title: "Water Supply"
	quest.2ECEAFAF8FDFF38B.title: "Collect Swift Sneak 3"
	quest.2ED982AECD1576C0.quest_subtitle: "Be a walking DJ booth by playing music disks"
	quest.2F07087EE904E14F.quest_subtitle: "All Aboarrrrddddd!! Get that train ready and moving!"
	quest.2F09BCC384D847EC.quest_desc: [
		"§7Processor presses are essential tools for creating the §fbrains§7 of your ME system."
		""
		"§7These rare items can §fonly be found in meteorites§7 and are required to craft the various processors that power AE2 devices."
		""
		"§7There are four different press types, and you'll need §fall of them§7 to fully utilize AE2's capabilities."
	]
	quest.2F09BCC384D847EC.title: "Essential Presses"
	quest.2F29262F6B2950F9.quest_desc: [
		"§7Sterling armor is a powerful set of protective gear crafted from silver ingots."
		""
		"§7This armor offers excellent protection and has special properties against certain mobs."
		""
		"§7Complete the set for maximum protection during your underground expeditions."
		""
		"§7The Sterling Helmet has a unique feature - you can attach banners to it for a customized look!"
	]
	quest.2F29262F6B2950F9.title: "Sterling Protection"
	quest.2F381595DFCBD741.quest_desc: [
		"To claim and area you will need to open the &6Xaeros world map (Fullscreen one)&r"
		""
		"Then you can right click and highlight an area to claim whats highlighted"
		""
		"You can only claim in a 5x5 chunk area with the player in the middle, so to claim further afar from you, you will need to move around to claim them"
	]
	quest.2F381595DFCBD741.quest_subtitle: "Claim an area to protect your stuff"
	quest.2F45E942A7C54D32.quest_desc: [
		"§6Open Crate"
		""
		"Automate item extraction from your network!"
		""
		"§7Function:"
		"§7• Connected to your storage network"
		"§7• Automatically drops items below it"
		"§7• Can be controlled with redstone"
		""
		"§6Applications:"
		"§7• Feed items into machines"
		"§7• Create sorting systems"
		"§7• Automate crafting setups"
		""
		"§6Pro Tip: §7Combine with hoppers or other transport systems for complex automation!"
	]
	quest.2F45E942A7C54D32.title: "§eAutomated Extraction"
	quest.2F7B49FBDEAB1920.quest_desc: [
		"2 tiers of chunk loaders"
		"Brass chunk loader: configurable loading range (1x1 to 5x5)"
		"Andesite chunk loader: loads a single chunk"
		"Works on the ground, on trains and on contraptions"
		"Configurable via server configs"
		"Toggleable in-game via contraption controls"
		"Attaches to Train Stations for lag-friendly chunk loading"
		"Reliable chunk loading and unloading"
		"Lots of configs for customization"
		"Complete ponder scenes"
	]
	quest.2F8B0AD3A752BE32.quest_desc: [
		"§6The Mason Table"
		""
		"The Mason Table is your gateway to stone decoration. Place it down and interact with it to transform various stone blocks into beautiful decorative variants."
		""
		"§7Materials you can work with:"
		"§7• Stone types (stone, andesite, diorite, etc.)"
		"§7• Deepslate and blackstone"
		"§7• Bricks and terracotta"
		"§7• Concrete and more!"
		""
		"§6Pro Tip: §7Mix different stone variants to create textured walls with depth and character."
	]
	quest.2F8B0AD3A752BE32.title: "Stone Mastery"
	quest.2F98083A1EF33FD6.quest_desc: [
		"§6Basic Sophisticated Chest"
		""
		"Your first step into advanced storage!"
		""
		"§7Crafting:"
		"§7• Chest + Redstone Torch"
		"§7• Keeps contents when converting"
		""
		"§6Base Features:"
		"§7• 27 slots (same as regular chest)"
		"§7• 1 upgrade slot"
		"§7• Lock mechanism"
		""
		"§6Pro Tip: §7Make multiple chests early on!"
	]
	quest.2F98083A1EF33FD6.title: "§eBasic Sophisticated Chest"
	quest.2F9E7D1B5A3C8E6D.quest_desc: [
		"The Mossy Waystone functions just like a regular waystone but with a more weathered, ancient appearance."
		""
		"Use sequenced assembly with mossy stone bricks as the base, following a similar process to the standard waystone."
	]
	quest.2F9E7D1B5A3C8E6D.title: "Ancient Teleporter"
	quest.2FAB5055E8D01E34.quest_desc: [
		"§6Storage Upgrades"
		""
		"Basic storage expansion!"
		""
		"§7Available Tiers:"
		"§7• Basic: +9 slots"
		"§7• Iron: +18 slots"
		"§7• Gold: +27 slots"
		"§7• Diamond: +36 slots"
		"§7• Netherite: +45 slots"
		""
		"§6Usage:"
		"§7• Stackable in same container"
		"§7• Removable"
		"§7• Works in all storage types"
	]
	quest.2FAB5055E8D01E34.title: "§eStorage Upgrade Basics"
	quest.2FB2D75FBD305775.quest_desc: [
		"§7Create a data collection system that monitors your farms and machines!"
		""
		"§7Basic steps:"
		"§7- Use §fperipherals§7 to collect data from nearby blocks"
		"§7- Store information in a database file"
		"§7- Set up a §fweb server§7 using the §fhttp API§7"
		"§7- Create a dashboard with graphs and statistics"
		""
		"§7Advanced features:"
		"§7- §fTime-series data§7 with timestamps"
		"§7- §fInteractive charts§7 using the monitor touch input"
		"§7- §fAlerts§7 when production drops or items need restocking"
	]
	quest.2FB2D75FBD305775.title: "Farm Analytics"
	quest.2FC27385443DBF9E.quest_desc: [
		"Congratulations on building your first steam locomotive! You've taken your first steps into the world of railway engineering."
		""
		"§7This opens up a whole new chapter of possibilities with Create's railway system!"
		""
		"§7In the next chapter, you'll learn how to:"
		"§7- Create complex railway networks"
		"§7- Build automated cargo systems"
		"§7- Design high-speed passenger lines"
		"§7- Create advanced locomotive designs"
		"§7- And much more!"
	]
	quest.2FC27385443DBF9E.quest_subtitle: "A New Journey Begins"
	quest.2FC27385443DBF9E.title: "Locomotive Engineer"
	quest.2FD7CABE483D5B3B.quest_desc: ["§7If you have followed the quests correctly, you should already have automated this."]
	quest.2FE6B518A4A2B5EE.quest_desc: ["Made optional cause idk the oil deposit might be hidden under liquid oil."]
	quest.306E26FB7650939B.title: "Craft Exhaust"
	quest.30BFEE38D2D3F201.quest_desc: [
		"§7The Sonorous Staff is a powerful ranged weapon that channels sonic energy, similar to the Warden's sonic boom attack."
		""
		"§6Weapon capabilities:"
		"§7• Creates devastating sonic boom projectiles"
		"§7• Deals significant damage to groups of enemies"
		"§7• Can break certain blocks with its sonic force"
		"§7• Has a cooldown between uses"
		""
		"§cWarning: §7Using this staff will alert nearby sculk sensors and may attract unwanted attention. Use with caution."
	]
	quest.30BFEE38D2D3F201.title: "Sonic Devastation"
	quest.30C1D45E7545FA6C.quest_subtitle: "Connect with a heat source into a boiler heater, spreads heat across all pipes evenly unless pumped."
	quest.30D7DB66D96F6059.quest_subtitle: "\"I am you, but stronger.\""
	quest.30D9B5C7C15FF842.quest_desc: [
		"§6Witch Hut Overhaul"
		""
		"The humble swamp witch hut has been transformed into a proper witch's dwelling."
		""
		"§7New witch hut features:"
		"§7• Expanded living spaces"
		"§7• Brewing and potion areas"
		"§7• Mystical gardens with unique plants"
		"§7• Hidden secrets and treasures"
		""
		"§6Pro Tip: §7The enhanced witch huts often contain rare brewing ingredients and potion recipes you won't find elsewhere."
	]
	quest.30D9B5C7C15FF842.title: "Witch's Cauldron"
	quest.30F8AEAEF6B38D3D.title: "Already Automated: Planks"
	quest.31080DC3C6B9E9DE.quest_desc: [
		"Ribbits will add swamp villages full of tiny frog villagers called ribbits!"
		"These little guys will sometimes sit down in groups to play music, which you can join in with!"
		"Merchant and fisherman ribbits can be traded with for various items including the new ribbits plant blocks and maracas!"
		"Sorcerer ribbits will occasionally cast spells to buff the player, and all gardener ribbits will water crops! "
		"Ribbits will naturally return to their homes at night, but if you'd like to relocate them, you can reset their home point to their current position by right clicking them with amethyst."
	]
	quest.312320F8FF1FDF24.quest_subtitle: "An upgraded version of the Copper Diving Boots."
	quest.313840436A5DC394.quest_desc: [
		"Fill with carbon dioxide using a &6spout.&r"
		""
		"&4IMPORTANT!&r"
		"There are two different carbon dioxides in TFMG: &8\"Engine\" CO2&r which comes from engine exhaust, and &7\"Byproduct\" CO2&r which comes from coke ovens, blast furnaces, aluminum electrolysis and the arc furnace. "
		""
		"&oOnly the &7byproduct CO2&r&o can fill buckets or the extinguisher."
	]
	quest.313840436A5DC394.quest_subtitle: "Well now what?"
	quest.3163768E54FA4D87.quest_subtitle: "You know what a windmill is, right? This uses wind to spin around and generate SUs for use."
	quest.3163768E54FA4D87.title: "Don't get blown away"
	quest.318C9AC08545CD19.quest_desc: [
		"§7Welcome to the world of §fApplied Energistics 2§7! This advanced storage and automation system will revolutionize how you manage your resources."
		""
		"§7Follow this quest line to build your first §fME Network§7 and discover the power of digital storage."
		""
		"§7Prepare to step into the future of item management!"
	]
	quest.318C9AC08545CD19.title: "6. A Giant Leap For Mankind"
	quest.31A18C60AF67B0F8.quest_desc: ["§7If you have followed the quests correctly, you should already have automated this."]
	quest.31A18C60AF67B0F8.title: "Planks"
	quest.31D5E3120F1042E4.quest_desc: [
		"§7Lava is an essential fluid for creating §fSturdy Sheets§7."
		""
		"§7Set up a lava collection system using either buckets, mechanical pumps, or a nether portal for a more automated approach."
		""
		"§7Store the lava in tanks near your production area for easy access during crafting."
	]
	quest.31D5E3120F1042E4.title: "Lava"
	quest.31E271976FFEDE47.quest_desc: ["Make spiderless string by putting &6rubber&r in a stonecutter."]
	quest.31E271976FFEDE47.quest_subtitle: "We have replaced spiders as well."
	quest.320B728B064451F3.quest_desc: ["The Yeti appears in frozen tundras. It smashes the ground, throws chunks of ice and slows players with its freezing punches. Use the explorer's compass to find the Yeti Hideout."]
	quest.3279A8C7EF1A56A6.quest_desc: [
		"§7If you followed the questline correctly in Chapter 3, you should already have Nether Quartz automation set up."
		""
		"§7If not, refer back to those quests to establish a reliable quartz supply."
	]
	quest.3279A8C7EF1A56A6.title: "Already Automated: Nether Quartz"
	quest.3281BDCB53C2399A.quest_subtitle: "16x Stack Size"
	quest.328FEEA1A7803F0B.quest_desc: ["The &6diamond backpack&r is the upgrade of the &egold backpack&r. It has 108 storage slots and can hold 5 upgrades"]
	quest.328FEEA1A7803F0B.quest_subtitle: "Massive storage on the go"
	quest.3290DE81911F7ED9.quest_desc: ["§7If you have followed the quests correctly, you should already have automated this."]
	quest.329FDA714E07C053.quest_desc: [
		"§7Glow flares are brilliant illumination tools crafted with silver."
		""
		"§7When thrown, they stick to surfaces and emit a bright light for a period of time."
		""
		"§7Perfect for lighting up dark caves or marking exploration paths!"
		""
		"§7The light from flares can keep hostile mobs at bay, giving you time to mine or explore safely."
	]
	quest.329FDA714E07C053.title: "Illumination Innovation"
	quest.32BC196A33723DB5.quest_desc: ["§7Now put the stripped logs through a §fMechanical Saw §7to create planks. "]
	quest.32BC196A33723DB5.title: "Stripped Logs -> Planks"
	quest.32C1DFFE700A1CFF.quest_desc: [
		"§7From the fallen Warden emerges a pulsating organ - the §fHeart of the Deep§7. This otherworldly artifact throbs with eldritch energy, seemingly alive despite its host's demise."
		""
		"§7As you hold it, you sense its connection to the very sculk that infests the Ancient Cities. Ancient whispers hint that this heart is more than trophy - it's a key to worlds beyond our understanding."
		""
		"§7The rhythmic pulses align with strange archways found in the deepest chambers of the Ancient Cities. Perhaps these structures are dormant portals, waiting for the right catalyst to awaken."
		""
		"§7This artifact will unlock the path to vital resources for your space program - resources found only in the darkest reflection of our world."
	]
	quest.32C1DFFE700A1CFF.title: "The Beating Dark"
	quest.32D4AD5940C185C3.quest_subtitle: "Right click on a tank of lubrication to fill the can. Applying this to engines gives a roughly 30% fuel saving."
	quest.33120981D1D82B69.quest_desc: [
		"§7Copper bottles are essential components for sealed mechanisms."
		""
		"§7To craft them, you have two options:"
		""
		"§7Method 1 (Sheet Processing):"
		"§71. Process the sheets into bottles using mechanical crafting"
		""
		"§7Method 2 (Direct Pressing):"
		"§71. Place a §fCopper Block §7on a §fDepot"
		"§72. Use a §fMechanical Press §7to directly compress it into 3 copper bottles"
		""
		"§7Tip: The direct pressing method is more efficient for bulk production and doesn't require mechanical crafters!"
	]
	quest.33120981D1D82B69.title: "Copper Sheets -> Copper Bottles"
	quest.3327DF76E2D580C2.quest_desc: ["§7If you have followed the quests correctly, you should already have automated this."]
	quest.33355975E5FA189C.quest_desc: ["Combat Roll A small but game-changing addition: the ability to dodge-roll out of harm’s way. By pressing a key (default “R”), you can roll in the direction you’re moving, granting brief invulnerability frames to evade attacks. This brings a skill-based defensive maneuver to combat, akin to many action RPGs. Whether you’re avoiding a Creeper’s blast or a boss’s swing, a timely combat roll can mean the difference between life and death. Mastering it will make you feel like a nimble warrior, not just a walking tank."]
	quest.33355975E5FA189C.title: "'R' to Dodge"
	quest.33836F7B213ECADC.quest_subtitle: "I drink it up!"
	quest.33836F7B213ECADC.title: "I drink your milkshake!"
	quest.33AC0DF796A77FB3.title: "Water"
	quest.33CB035EBCACB8DA.quest_desc: ["Animal pens mod is installed for passive mobs. "]
	quest.340CD4DDF6C53F1B.quest_desc: [
		"Create Aquatic Ambitions is a Create Mod Addon that introduces new machines, processes, and production lines inspired by the ocean. Harness the power of the conduit to transform byproducts into valuable resources and building blocks — and make more materials renewable in the process!"
		""
		"Features:"
		""
		"Conduit Channeling: A new fan processing type which uses am active conduit as the catalyst"
		"Conduit Cage: a machine used for granting/removing effects and also simplyifying chanelling setups."
		"Guardianless Prismarine: Channeling Flint has a chance to give you prismarine shards!"
		"Fully Renewable Copper: Now obtainable from prismarine! Shoutout to @DubbEck for the original recipes!"
		"Coral Revival and Farming: Dead coral can be revived via channeling and harvested with harvesters."
		"Sponge Duping: Dry sponges can be channeled for a chance to obtain extras"
		"Easier Nautilus: Nautilus Shells can be obtained from Limestone"
		"Craftable Tridents: Use Spiky shells and prismarine alloy rods to get the sea's most powerful weapon!"
		"Ponder: The Conduit and Conduit Cage have ponders to explain all their uses"
	]
	quest.3420F1B4E03F818F.quest_desc: ["§7To create §fCopper Sheets§7, you'll need to process copper ingots through a §fMechanical Press§7."]
	quest.3420F1B4E03F818F.title: "Copper Ingot -> Copper Sheet"
	quest.3436754A9BA6BB78.quest_desc: ["This is the menu that will allow you to customise what people are able to do within your party's claim"]
	quest.3436754A9BA6BB78.quest_subtitle: "It's &6'&r by default"
	quest.345EEBD0D6C065D6.quest_subtitle: "Chicken Egg Generator"
	quest.34C409E6FF596E2A.quest_desc: [
		"The &6train schedule&r is helpful as you can decide what order a train goes from station to station and how long it is at the station before it departs for the next station."
		""
		"You can right click a mob on a &ered seat&r that is next to the train controls to set that mob as the train conductor and they will follow the train schedule"
	]
	quest.34C409E6FF596E2A.quest_subtitle: "Decide when trains move"
	quest.34CEF09EC1981B7B.quest_desc: ["§7To create §fCertus Quartz Dust§7, you'll need to crush Certus Quartz Crystals using §fCrushing Wheels§7."]
	quest.34CEF09EC1981B7B.title: "Certus Quartz Crystal -> Certus Quartz Dust"
	quest.34CF8CC6400ACAB7.quest_desc: ["When you place a &9windmill bearing&r down you can place a plank on top of it to be able to connect the &bsails&r to"]
	quest.34CF8CC6400ACAB7.quest_subtitle: "An alternative stress source to water"
	quest.34CF8CC6400ACAB7.title: "Windmill Bearing"
	quest.34DAAF880FC0F5BB.title: "Deepfry Churros"
	quest.34F0546BB611261E.quest_desc: [
		"§7Congratulations on fully automating the production of §fCalculation Mechanisms§7!"
		""
		"§7These complex components are essential for advanced AE2 machinery and represent a significant achievement in your automation journey."
		""
		"§7With this automated production line set up, you now have a reliable supply of these valuable mechanisms to power your ME network's expansion."
	]
	quest.34F0546BB611261E.title: "Fully Automated Calculation Mechanism"
	quest.34F1CCD3657C617F.quest_desc: [
		"§6Nether Reactor Core"
		""
		"An iconic block from Minecraft Pocket Edition's early days!"
		""
		"§7In the old days, this block would:"
		"§7• Generate a small Nether-like structure"
		"§7• Spawn pigmen and various Nether items"
		"§7• Eventually turn into obsidian"
		""
		"§6Pro Tip: §7Use this as a centerpiece for retro builds or as a decorative power core"
	]
	quest.34F1CCD3657C617F.title: "§eNether Reactor Core"
	quest.356D2DFFDDFCA7D6.quest_desc: [
		"§7Train bogeys are the building blocks for creating custom trains."
		""
		"§7To create a simple train:"
		"§71. Place bogeys on your tracks (use different types for different behaviors)"
		"§72. Add a §fTrain Door§7 for passenger entry/exit"
		"§73. Add a §fTrain Controls§7 component so you can drive it"
		""
		"§7Tip: Different bogey types have different characteristics - experiment to find what works best for your railway!"
	]
	quest.356D2DFFDDFCA7D6.title: "Building Blocks"
	quest.35B96F4A231FE50E.quest_subtitle: "Collect a melon slice"
	quest.35BB0498DD5DC544.quest_desc: [
		"&bHyper enchanting&r let's you go above the normal enchantment limit in the base game."
		""
		"To be able to mix it you will need to super heart a &6blaze burner below the basin and mixer&r you do this by feeding the &6blaze burner&r a blaze cake. You will get 10% of the liquid xp back in &bhyper experience liquid&r"
		""
		"You can pump the &bhyper experience liquid&r into the blaze enchanter and then give when enchanting it will enchant the tool 1 level higher than the book given to the &6blaze enchanter&r"
	]
	quest.35BB0498DD5DC544.quest_subtitle: "In a mixer you need liquid xp, a lapis and a glow ink sac"
	quest.35D8FC8B7EDDA961.quest_desc: [
		"§d§lBlockus Guide"
		""
		"Explore a world of creative building materials!"
		""
		"§6Main Features:"
		"§7• Hundreds of new decorative blocks"
		"§7• New building materials in many styles"
		"§7• Variants of vanilla blocks"
		"§7• Unique construction options"
	]
	quest.35D8FC8B7EDDA961.title: "§d§lBlockus Building Guide"
	quest.36057360ADDD3B23.title: "Obtain a &eDune Armour Trim&r"
	quest.3612EB73B9709015.quest_desc: ["The &6precision mechanism&r is used in making some more advanced items like the &6rotational speed controller&r and it requires a gold sheet to have 3 items deployed onto it in a specific order of small cogwheel then large cogwheel and lastely an iron nugget. That process is repeated 5x and has an 80% chance to work at the end"]
	quest.3612EB73B9709015.quest_subtitle: "Used in some crafting recipes"
	quest.362B7BDB588D8744.quest_desc: [
		"§7Steam engines convert heat and water into rotational force - much more powerful than water wheels or windmills!"
		""
		"§7To set up a steam engine:"
		"§71. Place a §fBlaze Burner §7below §fFluid Tanks §7filled with water"
		"§72. Place the §fSteam Engine §7on the side of the tank"
		"§73. Connect a §fShaft §7to the engine to transfer the rotation"
		""
		"§7Tip: Keep your blaze burners well-fed for consistent power!"
	]
	quest.362B7BDB588D8744.title: "Steam Power"
	quest.36333946E623F193.quest_desc: [
		"§7The §fAnimatronic§7 is a programmable character that brings your code to life."
		""
		"§7Unlike other CCCBridge components, the animatronic doesn't control machines - instead, §fit can move and perform facial expressions§7 based on your code."
		""
		"§7Program it to §fdance§7, §fwelcome visitors§7, or §fperform sequences§7 to add character to your base."
		""
		"§7With some creative coding, you can create entertaining performances or helpful visual indicators for your systems!"
	]
	quest.36333946E623F193.title: "Programmable Animations"
	quest.36766831FDA775FD.quest_desc: ["Make sure you filter the recipe in the basin or else you'll end up with a quarter stack of iron trapdoors."]
	quest.36766831FDA775FD.quest_subtitle: "Made in a heated basin with a press."
	quest.3686BAC07C9F5E22.title: "Make a crafting table"
	quest.3691C2CCD07E20EE.quest_desc: ["Make in any vat type."]
	quest.3691C2CCD07E20EE.quest_subtitle: "Used for making &cn&6e&bo&dn&r tubes."
	quest.3691C2CCD07E20EE.title: "&cN&6e&bo&dn"
	quest.36B199E0CEF0266B.quest_desc: [
		"§7Tuff is already automatically produced by your previous setups."
		""
		"§7This versatile stone is an excellent source of copper and zinc when processed."
	]
	quest.36B199E0CEF0266B.title: "Already Automated: Glowstone Dust"
	quest.36B9FAA397DF04D1.quest_desc: [
		"Glacio is the first planet you'll encounter in the Proxima Centauri system. Despite its brutally cold conditions, it has breathable oxygen, allowing you to survive without a space suit (though you'll still need cold protection)."
		""
		"Key Glacio features:"
		"- Breathable atmosphere (but extremely cold)"
		"- Ice and snow-covered terrain"
		"- Unique flora and fauna"
		"- Special resources for advanced technology"
		""
		"§7Tip: While you don't need oxygen, the extreme cold will still damage you without proper protection."
	]
	quest.36B9FAA397DF04D1.title: "Ice World"
	quest.36CEFAF382E9540E.quest_desc: [
		"§7Within the most ancient chambers lies a dormant gateway - the §fSculk Portal Frame§7. When the Heart of the Deep touches it, reality tears open."
		""
		"§7Beyond this threshold lies the §fOtherside§7 - a twisted mirror of our world consumed by sculk. This realm of perpetual twilight is the wellspring from which all sculk corruption originates."
		""
		"§7Survival essentials:"
		"§7• Pack redundant equipment and emergency supplies"
		"§7• Stay vigilant for §fSculk Snappers§7 camouflaged in the terrain"
		"§7• Avoid the §fShattered§7 - twisted entities of immense power"
		"§7• Listen for the distinctive sounds of §fShriek Worms§7 that can call forth Wardens"
		"§7• Be aware that familiar potions and effects behave unpredictably in this realm"
		""
		"§7This perilous journey is necessary - only here can you find the resources to fuel your cosmic ambitions."
	]
	quest.36CEFAF382E9540E.title: "Through the Veil"
	quest.36F65982BE4A1FFC.quest_desc: [
		"The Jacaranda Jungle is filled with beautiful purple-flowering jacaranda trees."
		""
		"§6Features:"
		"§7• Purple jacaranda trees"
		"§7• Flowering canopy"
		"§7• Lush vegetation"
		""
		"When in bloom, these trees create a stunning purple canopy."
	]
	quest.36F65982BE4A1FFC.title: "Purple Haze"
	quest.3736B545828490F1.quest_subtitle: "Some fluids can be infinity extracted from the world as long as the pool the hose pulley is extracting from contains 10000 or more source blocks.\\n\\nYou can search in REI for the fluids that apply using by typing \"$create:bottomless\""
	quest.37544C908274BA4E.quest_desc: ["Advancement Frames is a very simple mod which allows you to display your hard earned Advancements."]
	quest.37780B44FB58F21E.quest_subtitle: "Pour and let dry."
	quest.378996586F76CDEC.quest_desc: [
		"§6Gold Backpack"
		""
		"Superior mobile storage!"
		""
		"§7Storage:"
		"§7• Base: 81 slots"
		"§7• 3 upgrade slots"
		"§7• Gold trim"
		""
		"§6Features:"
		"§7• Large capacity"
		"§7• Multiple upgrades"
		"§7• Quick access buttons"
		""
		"§6Pro Tip: §7Great for long expeditions!"
	]
	quest.378996586F76CDEC.title: "§eGold Backpack"
	quest.37E008F32DD7BD7B.quest_desc: [
		"Steam 'n' Rails adds semaphores - visual indicators for your train signals."
		""
		"§7To use semaphores effectively:"
		"§71. Place them adjacent to track signals"
		"§72. Configure their appearance and behavior"
		"§73. They'll provide clear visual feedback about signal status"
		""
		"§7Tip: Semaphores make it easier to see signal status from a distance, especially useful for complex networks!"
	]
	quest.37E008F32DD7BD7B.title: "Visual Signal Indicators"
	quest.3800DE3ED160E84B.quest_desc: [
		"§7To create §fCertus Quartz Crystals§7, you'll need to mix the following ingredients in a §fMixer Basin§7:"
		""
		"§7- §fNether Quartz§7"
		"§7- §fWater§7"
		"§7- §fAmethyst Shards§7"
		""
		"§7When properly combined, these components will form the pure crystals essential for AE2 technology."
		""
		"§7Ensure your mixer is well-supplied with all three ingredients for continuous production."
	]
	quest.3800DE3ED160E84B.title: "Nether Quartz + Water + Amethyst Shard -> Certus Quartz Crystal"
	quest.385C156051820A7B.quest_subtitle: "Stores pressurized air for usage with a diving helmet. In other words, the oxygen needed to breathe underwater."
	quest.3887DB2CA518BC26.quest_subtitle: "A useful block for building contraptions."
	quest.38B059A326764C85.quest_subtitle: "Automatically changes the tool when looking at a block"
	quest.38BAD1C65DDD69A3.quest_desc: [
		"§6Desert Temples Evolved"
		""
		"Desert Temples have been transformed from simple pyramids into proper ancient complexes."
		""
		"§7Enhanced temple features:"
		"§7• Multiple chambers and corridors"
		"§7• Hieroglyphics and lore elements"
		"§7• Additional traps beyond the pressure plate"
		"§7• Hidden treasure rooms"
		""
		"§6Pro Tip: §7Watch your step! The new temples have much more sophisticated trap systems than just the TNT room from vanilla."
	]
	quest.38BAD1C65DDD69A3.title: "Pharaoh's Pyramid"
	quest.38F7D6C5B76A6733.quest_subtitle: "Can be extended to make a larger engine."
	quest.390CA48CD622B19F.title: "Deepfry a snack"
	quest.3912A8C624291335.quest_desc: [
		"§fMixing §7iron nuggets and andesite will give you andesite alloy. "
		""
		"§7Tip: You will need tons of this for other stuff as well, so store all excess andesite alloy somewhere safe. "
	]
	quest.3912A8C624291335.title: "Andesite + Iron Nuggets -> Andesite Alloy"
	quest.392A957B73679053.quest_desc: ["Supplementaries A grab-bag of useful gadgets and decorative items to enrich your world. It also adds small touches such as jars, flags, and hanging lamps to give builds detail. Many of its contraptions can integrate with Create’s redstone or motion, adding functionality to your mechanical builds."]
	quest.392A957B73679053.quest_subtitle: "Supplementaries is in the modpack :3"
	quest.392A957B73679053.title: "Supplementaries"
	quest.39AD444F5F568CC9.quest_subtitle: "The key to show or hide quanity on drawers"
	quest.39B2360EF1977650.quest_desc: [
		"§7Set up an automated §fChicken Farm§7 to collect Eggs."
		""
		"§7These eggs are a crucial ingredient in several recipes, including the Blaze Cake Base."
		""
		"§7Design a collection system that gathers eggs without harming the chickens."
	]
	quest.39B2360EF1977650.title: "Eggs"
	quest.39C61CCA20494D37.quest_desc: [
		"§7These components help you obtain fluids from the world:"
		""
		"§7§fHose Pulley §7- Lowers into liquid sources to extract unlimited amounts"
		"§7- Perfect for accessing large bodies of water/lava"
		""
		"§7§fItem Drain §7- Extracts fluid from fluid-containing items"
		"§7- Place items on top to drain their contents"
		""
		"§7Tip: Use a hose pulley over an ocean or river for infinite water supply!"
	]
	quest.39C61CCA20494D37.title: "Gathering Liquid"
	quest.39C8F58FA945D7B0.quest_desc: [
		"§6Town Square Design"
		""
		"Create a beautiful town center with decorative pathways!"
		""
		"§7Design elements to include:"
		"§7• Central fountain or statue"
		"§7• Patterned stone paths"
		"§7• Decorative benches"
		"§7• Lamp posts and planters"
		""
		"§6Pro Tip: §7Use different path patterns to indicate different areas"
	]
	quest.39C8F58FA945D7B0.title: "§eTown Square Designer"
	quest.39CF18F0C2B06818.quest_subtitle: "A multi-block structure that lets you store large amounts of energy."
	quest.39DF9DB8444EE446.quest_desc: [
		"§7Grime Dust is created by smoking a §fGrime Ball§7 in a §fFurnace§7 or §fSmoker§7."
		""
		"§7This refining process transforms the raw grime into a usable powder for our luminous mixture."
		""
		"§7Set up an automated cooking system to process Grime Balls efficiently."
	]
	quest.39DF9DB8444EE446.title: "Grime Ball → Grime Dust"
	quest.39E6CA577F59AB93.quest_subtitle: "Destroys items when the draw gets full"
	quest.39E865F0D72CF9B8.quest_subtitle: "A Shaft is another basic but important machinery part that is required to make anything move with rotation. You can also extend the shaft to make it longer and affect more than one contraption that requires rotation."
	quest.39E865F0D72CF9B8.title: "Rod of Constant Rotation"
	quest.3A1FD20417D15F80.quest_desc: ["&6Super glue&r is the key part of all create multi blocks as it makes sure all the parts stay as one when the machine is started"]
	quest.3A1FD20417D15F80.quest_subtitle: "Getting stuck in"
	quest.3A1FD20417D15F80.title: "Super Glue"
	quest.3A27E71555DD0887.title: "Obtain an &6Elytra&r"
	quest.3A28BAA22C3312C5.quest_desc: [
		"§7Lichen moss growth can be harvested and crafted into a variety of decorative blocks."
		""
		"§7These natural decorations are perfect for adding organic texture to your underground builds."
		""
		"§7Try combining different lichen varieties to create unique aesthetic combinations."
		""
		"§7Some lichen varieties can be placed on the ceiling and will hang down, creating beautiful natural drapery."
	]
	quest.3A28BAA22C3312C5.title: "Lichen Decorations"
	quest.3A621F88A364C373.quest_desc: [
		"Welcome to CraftDonalds - where you'll build an automated burger empire from scratch!"
		""
		"In this questline, you'll progress from basic farming to fully automated burger production lines worthy of a fast-food kingdom."
		""
		"§6Key goals:§r"
		"• Set up sustainable farms for all burger ingredients"
		"• Create processing stations for each component"
		"• Automate the assembly line with Create mod"
		"• Scale up to a true burger empire!"
		""
		"§oAre you ready to super-size your automation skills?§r"
	]
	quest.3A621F88A364C373.title: "Welcome to CraftDonalds!"
	quest.3A663DCCCB6717F2.quest_desc: [
		"§6The Power of Wood"
		""
		"Wood is more than just a basic resource - it's the foundation of your early game progression and Create's mechanical power systems."
		""
		"§7Sustainable Practices:"
		"§7• Plant saplings for renewable resources"
		"§7• Different wood types offer unique aesthetics"
		"§7• Create tree farms for automation"
		""
		"§c§lFuture Uses:"
		"§7• Mechanical power generation"
		"§7• Building materials"
		"§7• Create contraptions"
		"§7• Tool crafting"
		""
		"§6Pro Tip: §7Establish a tree farm early for sustainable resources!"
	]
	quest.3A663DCCCB6717F2.title: "§eWooden Foundations"
	quest.3A6A5C7F0F5467E6.quest_desc: [
		"§7To create biodiesel, you'll need to build a distillation tower."
		""
		"§7The Distillation Tower is a multi-block structure that processes crude oil into various products."
		""
		"§7Ensure you have enough space to build this tall structure properly."
	]
	quest.3A6A5C7F0F5467E6.title: "Distillation Process"
	quest.3A78583BF3E90632.quest_desc: ["Attack: 3 / Hp: 15 / Repaired: Honeycomb / Info: Light with flint and steel to enable attacks, right-click to sit (sitting state increases defense and removes knockback)"]
	quest.3A7E5A2D7C36F61A.quest_desc: [
		"§7Crystal Canyons are magnificent underground biomes adorned with beautiful crystal formations."
		""
		"§7These rare caves can be found deep underground, typically between Y-levels -40 and 0."
		""
		"§7Keep an eye out for the distinct glow of crystals while mining - they'll guide you to these majestic caverns."
		""
		"§7The ambient sounds and atmosphere of these caves are entirely unique - listen for the gentle tinkling of crystals."
	]
	quest.3A7E5A2D7C36F61A.title: "Crystal Discoveries"
	quest.3A861B21F4724A9A.quest_subtitle: "Use on a Diesel Engine make it faster. Create Diesel Generators"
	quest.3A8BE37C33E3BB04.quest_desc: [
		"§6Basic Components"
		""
		"Essential crafting materials!"
		""
		"§7Key Items:"
		"§7• Charged Certus (Create Charging)"
		"§7• Fluix Crystal"
		"§7• Certus Dust"
		"§7• Pure Crystals"
		""
		"§6Pro Tip: §7Automate crystal growth with water!"
	]
	quest.3A8BE37C33E3BB04.title: "§eBasic Components"
	quest.3A8E6D9C1F7B5A2E.quest_desc: [
		"The standard Waystone is your basic teleportation block."
		""
		"Create a Waystone using Create's sequenced assembly. This complex process requires a Warp Stone, AE2 Quantum Link, Chromatic Compound, and lava."
		""
		"Place waystones throughout the world to create a teleportation network."
	]
	quest.3A8E6D9C1F7B5A2E.title: "Basic Teleportation Block"
	quest.3A95793467582862.quest_subtitle: "Muscle-powered copter. Give it a good push and off it flies!"
	quest.3A9DD6EF2779DCBF.quest_desc: [
		"Venus is the hottest planet in our solar system with a corrosive atmosphere. Its extreme conditions make it challenging to explore, but the rewards are substantial."
		""
		"Key Venusian features:"
		"- Calorite ore for interstellar travel"
		"- Extreme temperatures"
		"- Acid rain"
		"- Dense, unbreathable atmosphere"
		""
		"§7Warning: Standard space suits will not provide enough protection! Ensure you have Netherite-tier space equipment."
	]
	quest.3A9DD6EF2779DCBF.title: "Extreme Heat"
	quest.3AB842532BE0F734.quest_desc: [
		"§6Advanced Processing Setup"
		""
		"Create: Metalwork enables advanced ore processing with significantly better yields."
		""
		"§7Required Components:"
		"§7• Basin for processing"
		"§7• Blaze Burner for heat"
		"§7• Mechanical Mixer for combining"
		""
		"§6Processing Yields:"
		"§7• Crushed Ore → 2 Ingots (doubled!)"
		"§7• Additional chance for bonus nuggets"
		"§7• Compatible with all metal ores"
		""
		"§c§lImportant Notes:"
		"§7• Requires heated blaze burner"
		"§7• Processing takes longer than basic smelting"
		"§7• Higher energy requirement"
		""
		"§6Pro Tip: §7This method gives the highest base yield per ore!"
	]
	quest.3AB842532BE0F734.title: "§eAdvanced Ore Processing"
	quest.3AC7E5501D390A15.quest_desc: [
		"§6Inventory Connector"
		""
		"The foundation of your storage network!"
		""
		"§7Function:"
		"§7• Place on any inventory (chest, barrel, etc.)"
		"§7• Creates a connection point for your network"
		"§7• Multiple connectors can be linked together"
		""
		"§6Tips:"
		"§7• Each connector can access the inventory it's attached to"
		"§7• Start with just one connector on a chest"
		"§7• Build your network outward from here"
	]
	quest.3AC7E5501D390A15.title: "§eThe Network Foundation"
	quest.3ACBE9B17453B4B5.quest_subtitle: "Sleep at night without setting spawn"
	quest.3ACBE9B17453B4B5.title: "Craft a sleeping bag"
	quest.3AD21B9218FB019D.quest_subtitle: "Make noise with steam!"
	quest.3AD21B9218FB019D.title: "Create: Sound of Steam"
	quest.3AE35D77108AA350.quest_desc: [
		"The §bTotem of Growth§r accelerates crop growth in the surrounding area."
		""
		"When placed, it will randomly bonemeal crops within a 5-block radius."
		""
		"Perfect for creating efficient farms without constant manual intervention."
	]
	quest.3B0464B43F3FF8C5.quest_desc: [
		"Now that you have a basic shelter, it's time to start processing resources!"
		"Craft a furnace to smelt ores and cook food. You'll need some coal for fuel and raw iron to begin your technological journey."
		""
		"This is your first step towards creating more advanced machinery and tools."
	]
	quest.3B0464B43F3FF8C5.title: "Getting Started with Smelting"
	quest.3B10D08C32C3CC77.quest_desc: [
		"§6Legacy Utility Blocks"
		""
		"Practical blocks from Minecraft's past!"
		""
		"§7These blocks include:"
		"§7• Original stonecutter design"
		"§7• Beta crafting table texture"
		"§7• Early furnace designs"
		"§7• Classic utility blocks"
		""
		"§6Pro Tip: §7Create a workshop using only legacy blocks for an authentic feel"
	]
	quest.3B10D08C32C3CC77.title: "§eLegacy Utility Blocks"
	quest.3B10D31EFD80798C.quest_subtitle: "Lets you create your own custom functional clock."
	quest.3B1CA60E21C0B278.quest_subtitle: "Pour and let dry."
	quest.3B76AD708C591A48.quest_desc: [
		"The &6mechanical press&r is used for a lot of different things, like making sheets or some recipes using a basin"
		""
		"The &6depot&r is used to hold items on one block"
	]
	quest.3B76AD708C591A48.quest_subtitle: "Helpful for making a lot of things"
	quest.3B76AD708C591A48.title: "Mechanical Press and Depot"
	quest.3B7AB34E91675754.quest_desc: [
		"§7Welcome to the §fAutomating The Kitchen§7 chapter!"
		""
		"§7In this section, we'll explore how to automate your food production using §fCreate§7 and §fFarmers Delight§7 along with its many add-ons."
		""
		"§7By the end of this chapter, you'll have fully automated food production lines yielding delicious meals with minimal manual effort!"
	]
	quest.3B7AB34E91675754.title: "Automating The Kitchen"
	quest.3B7F55A6A3374B8A.quest_desc: [
		"§7Create a full end-to-end automation system for complex meals!"
		""
		"§fExample - Hamburger Automation:§7"
		"§71. Grow §fwheat§7 (for buns) and §fbeef§7 (manual or with mob farm)"
		"§72. Slice wheat into flour → mix with water → bake into bread"
		"§73. Process beef into minced beef → cook into burger patties"
		"§74. Use §fDeployers§7 to combine bread and patties"
		""
		"§7Challenge yourself to automate meals from these addons:"
		"§7- §fCultural Delights§7 (sushi, corn, eggplant dishes)"
		"§7- §fRustic Delight§7 (unique fruits and vegetables)"
		"§7- §fExpanded Delight§7 (new cooking possibilities)"
		"§7- §fPineapple Delight§7 (tropical flavors)"
		"§7- §fVegan Delight§7 (plant-based alternatives)"
	]
	quest.3B7F55A6A3374B8A.title: "Complex Meal Automation"
	quest.3B925864D243F779.quest_subtitle: "Blocks that allow contraptions to harvest crops."
	quest.3BBA3F89DD4C1E47.quest_desc: [
		"The distant dwarf planet Pluto is one of the most challenging destinations in the solar system."
		""
		"With temperatures reaching -229°C and classified as a Tier 9 planet, you'll need your most advanced technology to survive."
		""
		"Build a Tier 9 rocket using rare Plutonite material to reach this frozen world."
		""
		"§7Pluto's unique resources will be essential for reaching the absolute limits of space technology."
	]
	quest.3BBA3F89DD4C1E47.title: "To the Edge of Sol"
	quest.3BE94C7FE561FF4A.quest_desc: ["Using a &ecreate&r mixer, blend &6sulfuric acid&r with a &6copper ingot&r"]
	quest.3BE94C7FE561FF4A.quest_subtitle: "Somehow turns into bone meal when crushed."
	quest.3BF442790F0F281C.quest_desc: [
		"The &6train signal&r helps with keeping trains from going the wrong way as a train won't pass over a &6train signal&r if it is facing the wrong direction."
		"The &6signal&r can be made a 2 way &6signal&r by having one on either side of the track, having a 2 way &6signal&r will make it so a train can pass it if the scheduled station is on the other side"
	]
	quest.3BF442790F0F281C.quest_subtitle: "Help's with train flow"
	quest.3BFA35BDE765A1B0.quest_desc: [
		"§6Legacy Block Display"
		""
		"Create a comprehensive showcase of Minecraft's evolution!"
		""
		"§7Display features to include:"
		"§7• Comparison of old vs. new textures"
		"§7• Timeline of major Minecraft versions"
		"§7• Interactive elements explaining each block"
		"§7• Educational signs about game history"
		""
		"§6Pro Tip: §7Organize by version (Alpha, Beta, Release) for a history lesson"
	]
	quest.3BFA35BDE765A1B0.title: "§eLegacy Texture Showcase"
	quest.3C1124B6D07371F8.quest_desc: [
		"The §bChicken Fossil§r grants the power of slow falling when held."
		""
		"Perfect for exploring tall structures or mountainous regions without fear of fall damage."
		""
		"Place it in your off-hand to benefit from its effects while keeping your main hand free."
	]
	quest.3C1E7E02FDDFF8E3.quest_subtitle: "If you know how Create's item vault and filters work, this is similar."
	quest.3C23A1851007745E.quest_desc: [
		"§6Valuable Legacy Ores"
		""
		"The original designs for precious mineral ores!"
		""
		"§7These blocks include:"
		"§7• Beta gold ore texture"
		"§7• Original diamond ore pattern"
		"§7• Classic lapis lazuli ore"
		"§7• Nostalgic redstone ore"
		""
		"§6Pro Tip: §7Use these in underground treasure rooms for a classic feel"
	]
	quest.3C23A1851007745E.title: "§ePrecious Legacy Ores"
	quest.3C3B55530B49DCE1.quest_desc: [
		"With Ostrum from Mars, you can now craft your Tier 3 Rocket! This advanced spacecraft can withstand extreme heat, allowing you to visit Venus and Mercury."
		""
		"These hot planets hold the rare resource Calorite, which you'll need for interstellar travel."
		""
		"§7Warning: Venus and Mercury have extremely high temperatures that require special protection."
	]
	quest.3C3B55530B49DCE1.title: "Into the Inferno"
	quest.3C67BDE80F43FF9E.quest_subtitle: "Lets you charge certain items."
	quest.3C765D427B3A39D6.quest_desc: [
		"The Lost Eye is found in Abandoned Mineshafts."
		""
		"§7Explore deep underground to find winding wooden tunnels and structures."
		"§7Check minecart chests throughout the mineshaft."
		"§7Watch out for Cave Spiders spawning from Spider Spawners!"
		""
		"§6Pro Tip: §7Bring torches to light your way and prevent mob spawning. You can also get the eye from"
		"{ \"text\": \"this quest.\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"3E903F2708893135\" } }"
	]
	quest.3C8D7AC057CE833F.quest_desc: [
		"The Undead Eye is crafted using several undead materials:"
		""
		"§7Required ingredients:"
		"§7• Undead Soul (from Skeleton Horses)"
		"§7• Bone"
		"§7• Ghast Tear"
		"§7• Rotten Flesh"
		"§7• Phantom Membrane"
		""
		"§7Combine all these ingredients in a crafting table to create this powerful eye."
		""
		"§6Pro Tip: §7The Phantom Membrane can be obtained by killing Phantoms that spawn when you haven't slept for 3+ nights."
	]
	quest.3CAA0B93CE0D600A.quest_desc: [
		"Distilling heavy oil helps to squeeze more fuel out of your refinery, as well as provide a new product: &elubrication oil&r."
		""
		"The heavy oil distilling setups can have a different number of outputs."
		""
		"The minimum size of three outputs &eLubrication oil&r, &6Diesel&r, and half of the &0Heavy oil&r (so back in it goes...)"
		""
		"Adding an output gives you &9Kerosene&r"
		""
		"Adding another output gives you &4Naphtha&r"
	]
	quest.3CAA0B93CE0D600A.quest_subtitle: "C'mon, babe, it's time for your 3pm distillation."
	quest.3CB4B1762593C5D1.quest_desc: [
		"§7Many addons for §fFarmers Delight§7 include unique crops and ingredients:"
		""
		"§7• §fCultural Delights§7: Adds §fcorn§7, §feggplants§7, §fcucumbers§7 for sushi and more"
		"§7• §fRustic Delight§7: Introduces §fapples§7, §folives§7, and §ftomatoes§7 for rustic dishes"
		"§7• §fExpanded Delight§7: Adds new food combinations and unique recipes"
		"§7• §fFestive Delight§7: Seasonal treats and decorative foods"
		"§7• §fEnd's Delight§7: End-themed ingredients and meals"
		""
		"§7Create automated farms for these special crops using the same techniques!"
	]
	quest.3CB4B1762593C5D1.title: "Specialty Crop Automation"
	quest.3CC9CED47DB12043.quest_desc: [
		"§7The spout is essential for precisely filling containers with fluids:"
		""
		"§71. Place the spout above a §fDepot §7or §fBelt"
		"§72. Connect it to your fluid network using §fFluid Pipes"
		"§73. Items placed below will be filled with the fluid"
		""
		"§7Perfect for filling bottles, buckets, or any container that needs precise fluid amounts!"
	]
	quest.3CC9CED47DB12043.title: "Spouting"
	quest.3D11842DDDE1D396.quest_subtitle: "Terminoloy:\\n\\nStress Units(SU) a number that describes how much stress something generates or requires to run.\\n\\n"
	quest.3D11842DDDE1D396.title: "I'm so stressed! I need to measure it!"
	quest.3D123C120209CAE5.quest_desc: [
		"§7This Moon Cobblestone represents the beginning of a production loop."
		""
		"§7One unit will be recycled back into the mixer to catalyze the creation of more Moon Cobblestone."
		""
		"§7This self-sustaining cycle produces additional units with each iteration."
	]
	quest.3D123C120209CAE5.title: "Moon Cobblestone 🔃"
	quest.3D53527A1E99B3CC.quest_desc: ["Create: Bells and Whistles is an add-on for the Create mod that focuses on the player experience, adding 36 new decorative and utility blocks. "]
	quest.3D6A771583B33400.title: "Use an Compressor to process materials"
	quest.3D6EDD203D801977.quest_desc: ["§7Shafts are made thrugh putting andesite alloy through a §fMechanical Saw§7."]
	quest.3D6EDD203D801977.title: "Andesite Alloy -> Shafts"
	quest.3D7AC56800858EBE.quest_desc: [
		"§7Steam whistles aren't just for show - they can be used to create musical signals when powered!"
		""
		"§7Place them on a steam engine setup and control them with redstone to create different notes."
		""
		"§7Perfect for adding audio alerts to your factories or creating musical contraptions."
	]
	quest.3D7AC56800858EBE.title: "Musical Generators"
	quest.3D8F19BA309B6850.quest_desc: [
		"Spyglass Improvements is a mod that add various functionality and improvements to the vanilla minecraft spyglass."
		""
		"Features:"
		"Compatibility with Equipment Slot mods such as Accessories, Trinkets and Curios API."
		"Spyglass Zoom using mouse scroll wheel."
		"Quick access to the Spyglass by pressing 'Z'."
		"Different Spyglass overlays."
		"Hide crosshair while scoping."
		"Enable smooth camera while scoping"
		""
		""
		"Useful Spyglass "
		"This mod allows players to view information on mobs when viewing them through a spyglass, such as their name, health, armor, and hostility."
	]
	quest.3DE38636656DD1F6.quest_subtitle: "Okay, I may be exaggerating a little, but redstone also plays a vital role to Create that the blocks in here make redstone contraptions more compact but also a bit more complicated, have fun studying."
	quest.3DE38636656DD1F6.title: "Redstone + Create = Complicated"
	quest.3DF1A18E53DA334D.quest_desc: [
		"The encased fan has multiple uses depending on how you set it up:"
		""
		"§71. Blowing air to push entities"
		"§72. Creating soul fire/soul campfire to haunt items"
		"§73. Blowing through water to wash items"
		"§74. Blowing through lava to smelt items"
		""
		"§7Experiment with different setups to unlock its full potential!"
	]
	quest.3DF1A18E53DA334D.title: "Multi-Purpose Fan"
	quest.3DF5A83D85C2A3E2.quest_desc: ["Spawn: Villages / Hp: 40 / Repaired: Wooden planks / Drops: 40% 1-3 cod, 1-5 wheat, 1-5 iron nugget, 1-5 gold nugget, 1-5 flint, 1-5 carrot. 20% 1-2 iron ingot, 1-2 gold ingot, 1-2 emerald, iron helmet / Info: Drop emeralds to barter."]
	quest.3E10D349E202CC89.quest_subtitle: "Aesthetic trapdoor"
	quest.3E4307D69D1AE237.title: "Already Automated: Zinc Ingot"
	quest.3E49941B0AEAB604.quest_desc: [
		"§6Basic Smelting"
		""
		"The simplest processing method is direct smelting. While quick, it provides the lowest yield."
		""
		"§7Yields per Raw Ore:"
		"§7• 1 Raw Ore → 1 Ingot"
		"§7• No bonus outputs"
		"§7• Fastest processing method"
		""
		"§c§lDownsides:"
		"§7• Lowest possible yield"
		"§7• No secondary resources"
		"§7• Wastes potential bonuses"
		""
		"§6Pro Tip: §7Only use direct smelting when you need resources quickly!"
	]
	quest.3E49941B0AEAB604.title: "§eBasic Smelting"
	quest.3E51B3A2DFF3330B.quest_desc: [
		"The deployer acts as a mechanical arm that can place blocks, use tools, or interact with other blocks."
		""
		"§7Essential for complex automation sequences!"
		""
		"§7It can use tools like shears, shovels, or even right-click with items like bone meal."
	]
	quest.3E51B3A2DFF3330B.title: "Mechanical Hands"
	quest.3E666752E4B40376.quest_desc: [
