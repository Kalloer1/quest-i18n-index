	quest.216A404B2C75EE3A.quest_desc: [
		"§7Combine §fCopper Ingots§7 and §fZinc Ingots§7 in a §fHeated Mixer§7 to create Brass Ingots."
		""
		"§7This alloy formation requires precise temperature control for optimal results."
		""
		"§7Design your mixing station to maintain the ideal heat level throughout the process."
	]
	quest.216A404B2C75EE3A.title: "Copper Ingot + Zinc Ingot → Brass Ingot"
	quest.21800FC0CDC937CB.quest_desc: [
		"Can make much higher voltages and power than the puny generator."
		""
		"Components assembled in a &6mechanical crafter&r with lots of aluminum and steel."
		""
		"Surround the rotor with the stators to complete the multiblock."
		""
		"{@pagebreak}"
		"&30RPM - 70RPM&r"
		"No electricity generation"
		""
		"&371RPM - 256RPM&r"
		"Linear voltage rise from 12V - 2232kV"
		"Constant current limit of 24.6A, thus power output ranges from 295W - 54.9kW"
	]
