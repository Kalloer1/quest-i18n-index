	quest.3FA6E83C4CFE398B.quest_desc: [
		"The §bTotem of Radiance§r is a powerful artifact that provides protection against hostile mobs."
		""
		"When placed, it damages hostile mobs within a 10-block radius and makes them glow, making them easy to spot."
		""
		"Perfect for securing your base or creating safe zones while exploring dangerous areas."
	]
	quest.3FAD68C07ECBE467.quest_desc: [
		"§6Filter Upgrades"
		""
		"Control what enters your storage!"
		""
		"§7Types Available:"
		"§7• Basic Filter"
		"§7• Advanced Filter"
		"§7• Magnet Filter"
		"§7• Tag Filter"
		""
		"§6Features:"
		"§7• Whitelist/Blacklist"
		"§7• NBT matching"
		"§7• Fuzzy matching"
	]
	quest.3FAD68C07ECBE467.title: "§eFilter Upgrades"
	quest.3FBCBA4D984B3B5D.quest_desc: [
		"The Track Coupler allows you to connect trains together."
		""
		"§7To couple trains:"
		"§71. Craft the Track Coupler"
		"§72. Use it on one train, then on another"
		"§73. The trains will be linked and move together"
		""
		"§7Tip: This allows you to create multi-part trains with specialized cars for different functions!"
	]
	quest.3FBCBA4D984B3B5D.title: "Multi-Car Trains"
	quest.3FCF170202621BEC.quest_desc: [
		"§7To ensure a steady supply of wheat, you'll need to set up an automated wheat farm."
		""
		"§7Use mechanical harvesters, or other automated farming methods."
	]
	quest.4007D36163F8555E.quest_subtitle: "Grinding it all down to dust."
	quest.403A0491D1B2C51E.title: "Locate a &2Jungle Pyramid&r"
	quest.40489A0C3B300E84.quest_desc: [
		"§7After setting up your distillation tower, you can now produce §fDiesel§7, a high-efficiency fuel."
		""
		"§7It accepts the same fuels as the standard diesel engine but generates more power from each."
		""
		"§7Use this engine when you need to power multiple contraptions or machines with higher energy requirements."
		""
		"§7Its modular design allows for easier maintenance and integration into more complex power networks."
	]
	quest.405A318D640D514E.quest_desc: [
		"The blast stove can take in &6furnace gas&r, so your furnace can be self sufficient without sacrificing more coal to make creosote."
		""
		"Place a hatch on top of the furnace hole to collect the gas. Don't worry about blocking it up; you can still insert ingredients by funneling them into this hatch."
	]
	quest.405A318D640D514E.quest_subtitle: "A second hatch!"
	quest.405A318D640D514E.title: "Getting Fancy with your Furnace"
	quest.408C34432E394C2B.quest_subtitle: "Extension cables, but instead of electricity, it is essentially an item cable."
	quest.408D9361AF8AA499.quest_subtitle: "A simple machine with massive potential. Can place blocks but also use items on blocks/entities."
	quest.408FEA3651ADF8D3.quest_desc: [
		"§7The zenith of food automation - a fully automated meal delivery system!"
		""
		"§fSetup:§7"
		"§71. Create a menu selection system using §fredstone§7"
		"§72. When a meal is selected, §fmechanical arms§7 gather ingredients"
		"§73. Ingredients are processed and cooked automatically"
		"§74. Final meals are delivered via §fbelts/chutes§7"
		""
		"§7Perfect for a Minecraft restaurant or base-wide meal distribution!"
