	quest.2376C0DBCD541C9B.title: "Steel Cogwheels"
	quest.2390580FE814BD81.quest_desc: [
		"Place the &6surface scanner&r on top of the &6machine input&r and power it. "
		""
		"The 25 lights on the top represent the 25 chunks nearest to the scanner, with the middle light being the chunk it's in. They light up if at least one &6oil deposit&r is found in the corresponding chunk. "
		""
		"Unfortunately, it cannot give you any further guidance. Start digging!"
	]
	quest.2390580FE814BD81.quest_subtitle: "Ping! Ping! Ping!"
	quest.23B659BB7A0952CB.quest_desc: [
		"§7Logs are the primary ingredient for rubber production."
		""
		"§7Your automated tree farm should be producing a steady supply of logs."
		""
		"§7Tip: Consider setting up item sorting to direct a portion of your log production specifically to your rubber manufacturing line."
	]
	quest.23B659BB7A0952CB.title: "Logs for Rubber Production"
	quest.23BDBF277A2A72A6.quest_desc: [
		"§7Red Sand can be produced by crushing §fGranite§7 blocks in a §fCrusher§7."
		""
		"§7This creates a renewable source of Red Sand without needing to mine desert biomes."
		""
		"§7Set up a crushing station with item collectors to gather the Red Sand efficiently."
	]
	quest.23BDBF277A2A72A6.title: "Granite → Red Sand"
	quest.23CB7BB3C6E8AD30.quest_subtitle: "Even a caveman with a hand crank can make this."
	quest.23CB7BB3C6E8AD30.title: "Creosote, Furnace Gas Cylinder"
	quest.23CE15494C9AA25C.quest_desc: [
		"Neptune's deep blue atmosphere hides a dynamic world of extreme winds and unique resources."
		""
		"Key features:"
		"• High gravity"
		"• No oxygen"
		"• Extremely cold temperatures"
		"• Valuable Neptunium deposits"
		""
		"The materials you collect here will be crucial for reaching the most distant objects in our solar system."
	]
	quest.23CE15494C9AA25C.title: "The Blue Giant"
	quest.23D1935F6FBE0303.quest_subtitle: "Same as the Andesite Track Switch but also allows for switching for scheduled trains."
	quest.2458735D1811D82C.quest_subtitle: "Each block of turbine engine requires 4 of these."
	quest.24E234AFB1CE8B59.title: "Obtain Steel"
	quest.24FD5FE4188AA2A7.quest_desc: [
		"§7The Soul Elytra is an enhanced version of the standard Elytra, infused with sculk essence to provide improved flight capabilities."
		""
		"§6Enhanced features:"
		"§7• More durable than standard Elytra"
		"§7• Better flight control and maneuverability"
		"§7• Special boost ability (activated while flying)"
		"§7• Reduced fall damage when landing"
		""
		"§cWarning: §7The boost ability has a cooldown period. Use it strategically to maximize its effectiveness."
	]
	quest.24FD5FE4188AA2A7.title: "Soul-Bound Wings"
	quest.252245F4C408B9C9.quest_desc: ["&6Brass&r is the start of the next generation of create, it allows for crafting many more advanced options"]
