	quest.3B367B197438601C.quest_desc: ["Obtain Storm's Edge and dash like lightning"]
	quest.3C1E44BB29655B3E.quest_desc: ["spawns in the labrynth as its protecter, killing it will open up the hall to pray for spirits"]
	quest.3CB1E967386A4851.title: "Stellar - gold"
	quest.3CB834647CE59C74.quest_desc: [
		"Fule with morkite and right click to have a fast multi-tool"
		""
		"you can upgrade the drill with rare materials such as, carmot stone (extra fortune) and prometheum bouquet (passive mending)"
	]
	quest.3D1C0F80B74B27D5.quest_subtitle: "Arrive at a Lighthouse"
	quest.3D896B541475DA04.title: "Royal Galas"
	quest.3DC4AD73C4A9B5BF.quest_desc: ["Clears all negitive effects"]
	quest.3ECA226F08D5195F.quest_desc: ["Hidden among hills and valleys, the monastery stands as a quiet refuge in a world of rising danger. Here, villagers tend to simple lives of prayer and work, untouched by Illager conquest. Though the halls hold little in the way of treasure, their sturdy walls and peaceful company make this an ideal sanctuary for weary adventurers."]
	quest.3ECA226F08D5195F.quest_subtitle: "Find a Monastery"
	quest.3F1CBB7E60BE2736.quest_desc: ["Obtain Icewhisper"]
	quest.3F5910EFF08D4AB0.quest_desc: [
		"like a totem of undying but with a cooldown"
		""
		"leaves a creeper explosion when about to die"
		"gives fire resistance, regen and absorbtion"
	]
	quest.3F865CB1B3C8EE7B.title: "Humanity Forgotten"
	quest.3FCC0282BAAEA6AD.quest_desc: [
		"An Orc Lord will evolve into an Orc Disaster when it reaches 200k EP"
		""
		"Obtaining EP"
		"- Orc Lords gain EP when they kill nearby mobs."
		"- Summoned Orcs give their Orc Lord EP and Armour Points upon killing mobs."
		"- An Orc Lord consuming summoned Orcs will also not grant them any EP or Armour Points."
	]
	quest.4057ACD1CBC438E5.quest_desc: ["Obtain the legendary Sword on a Stick!"]
	quest.40885BD4B47360D6.quest_desc: ["Place the altar of infusion and surround it with 6 pillasr of x3 Altar pillars then put an Altar Tip on each pillar Finally, Fill in al of the altar pillars with gold blocks"]
