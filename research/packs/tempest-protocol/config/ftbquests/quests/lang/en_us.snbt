	quest.6817F3E2D036C3C8.quest_desc: [
		"Stray cats sprint away from any player within 7 blocks, and avoid players within 16 blocks. However, they slowly approach a player holding raw cod or salmon within 10 blocks, allowing the player to feed and tame it. If the player turns too quickly or stops holding the fish within 6 blocks, the cat flees and does not attempt to approach the player for a few seconds."
		"{@pagebreak}"
		"When the player sleeps, tamed cats move toward their owner and sleep near them. When the player wakes, their tamed cats also wake. There is a 70% chance for a tamed cat to give the player a gift after they wake up, but only if the player sleeps at night; if the player sleeps during a thunderstorm during the daytime, or if the tamed cat has been ordered to sit, the player receives no gift. See next pages for list of drops."
		"{@pagebreak}"
		"&9Common&r"
		"- Rabbit Hide"
		"- Rabbit Foot"
		"- Raw Chicken"
		"- Feather"
		"- Rotten Flesh"
		"- String"
		"- Phantom Membrane"
		"- Melon Slice"
		"{@pagebreak}"
		"&6Slightly Rare&r"
		"- Diamond"
		"- Golden Apple"
		"- Golden Carrot"
		"- Totem of Undying"
		"{@pagebreak}"
		"&dRare&r"
		"- Amethyst Shard"
		"- Heart of the Sea"
		"- Wither Skeleton Skull"
		"- Echo Shard"
		"- Sponge"
		"- Trial Key (1.21+)"
		"{@pagebreak}"
		"&4Extremely Rare&r"
		"- End Crystal"
		"- Nautilus Shell"
		"- Nether Star"
		"- Ominous Bottle (1.21+) "
	]
	quest.6817F3E2D036C3C8.title: "BFF"
	quest.6833A35134B174DE.title: "Nature Spell Book"
	quest.6858E25E510AE0FA.quest_desc: ["Drifting through the skies like a colossal squid, this otherworldly airship bristles with defenses. Phantom-riding monstrosities circle its hull, while fish-like warriors astride hoglins guard its decks. To face the Conqueror is to battle a skyborne legion. And only the strongest will claim victory."]
	quest.6858E25E510AE0FA.quest_subtitle: "Find a Heavenly Conqueror"
	quest.68629FA63DAA64A8.quest_desc: ["Obtain Soulrender"]
