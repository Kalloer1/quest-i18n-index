	quest.1936A6D13852789A.quest_desc: [
		"Use the following command to teleport back to spawn:-"
		""
		"&l/trigger darkspawn&r"
	]
	quest.1A0D2433C6FA49AB.title: "Tomb Of Frost"
	quest.1A461C4DB6D97C1E.quest_desc: [
		"Find the Starlight Portal Ruins structure in the overworld and fight The Gatekeeper."
		""
		"Find the bosses using the Seeking Eye, follow the instructions on the Starlight Story in the new dimension..."
	]
	quest.1A58F7D73A215329.quest_desc: [
		"WELCOME. This channel will give you tips and some explanations on mechanics, However if you ever get confused or cant find the info here you can check the mods wiki here: &9&l&nhttps://tensura.wiki.gg&r&r&r"
		"its where most of this quest chapter gets its info from"
		""
		"After picking your race you may spawn in one of 3 locations"
		"&2The Overworld&r"
		"&6The Labyrinth&r"
		"&4Hell&r"
		""
		"If you don't like your race or spawn you can change your race with a race reset scroll or character Reset scroll"
	]
	quest.1B609EB915C9B813.quest_desc: [
		"Buy it from a master cleric"
		""
		"A holy talisman said to protect its owner from bad luck"
	]
	quest.1C375606107C117F.quest_subtitle: "Find Keep Kayra"
	quest.1C381035DDF5FE70.quest_desc: ["Can be found in hell"]
	quest.1CCA31D9352C60E6.quest_desc: ["Clustered around a towering central “grandmother” mushroom, these villages appear quaint from afar. Yet the villagers within are far more aggressive than their old-world counterparts, hiding a cunning fierceness beneath their colorful caps. Approach with caution as this village may welcome the unwary only to spring its traps."]
	quest.1CCA31D9352C60E6.quest_subtitle: "Find a mushroom village"
	quest.1CEF2A38948010A2.quest_desc: ["Out on the open seas, the &6Illagers&r have taken to the waves, commandeering massive galleys and swift corsairs. Their sails cast long shadows, and their cannons roar with fury. Only the bravest dare to board, for fortune favors those who seize it."]
	quest.1CEF2A38948010A2.quest_subtitle: "Find an Illager Corsair or an Illager Galley"
	quest.1D244505FBDF461D.quest_desc: ["Allows setting up a simple trading machine with one trade. Items can be inserted or extracted on the configured sides."]
	quest.1D8090835DE90CDB.quest_desc: [
		"Exploration is the main focus of End Remastered, and to reach the End and beat the Ender Dragon, you will have to find 16 custom eyes by exploring vanilla structures and fighting vanilla bosses. Once you have at least &l12&r eyes, you can follow them until you reach the Stronghold. You have to put the &l12&r custom eyes in the portal in order to open it. If there's a vanilla eye of ender in one of the frames, you can remove it by right clicking on it with a custom eye."
		"{@pagebreak}"
		"The Eyes are a really important part of End Remastered, just like Vanilla Ender Eyes, they allow you to activate the portal to the End. However, unlike Vanilla Ender Eyes, they are not dropped by Endermen, but must be found by exploring, fighting and mining."
	]
	quest.1D8090835DE90CDB.title: "Beginning?"
	quest.1DBE70C472B3237C.quest_desc: ["Give your self a lot of effects with a gem of promise in off hand"]
	quest.1DF7B04A7635D16A.title: "Schematic"
	quest.1E1AC78F100BE5BF.quest_desc: ["+4 armor"]
	quest.1EAA9B834E400BD8.quest_desc: [
		"When named, the 'owner' (who named you) will siphon souls for TDL awakening from the named player."
		""
		"Naming requires the target to have HP lower than 25% of Max HP (configurable) or have the Fear effect (caused by the Namer). These are ignored in creative mode or if the target for naming is below 1% of the namer's EP."
		""
		"Also ignored if the target is tamed by the player. Through normal Minecraft Taming or via Mind Control Skills. i.e. Charm"
		""
		"&4&lNOTE: Evolution through naming a player can only be granted if: The target player is prior to their second to last evolution, and the target player does not require an awakening for their next evolution&r&r"
		"{@pagebreak}"
		"&4&n&lSubdue (-)&r&r&r: Costs 0.5 × the target’s EP in your current Magicule."
		""
		"– e.g. naming a 1 000 EP creature costs 500 Magicule."
		""
		"– Boosts the target’s EP by +50 % (1 000 → 1 500 EP), tames/subordinates it, and heals it to full."
		""
		"– No chance to permanently drain your max Magicule."
		""
		""
		"&6&n&lEvolve (=)&r&r&r: Costs 1.5 × the target’s EP in your current Magicule."
		""
		"- e.g. naming a 1 000 EP creature costs 1 500 Magicule."
		""
		"- +150 % EP (1 000 → 2 500 EP), tames/subordinates it, heals to full, and **evolves** if an evolution exists."
		""
		"- 10% chance to permanently reduce your max Magicule by exactly the naming cost."
		""
		"&2&n&lEndow (+)&r&r&r: Costs 9 × the target’s EP in your current Magicule."
		""
		"- e.g. naming a 1 000 EP creature costs 9 000 Magicule."
		""
		"- +900 % EP (1 000 → 10 000 EP), tames/subordinates it, heals to full, and evolves if possible."
		"&1"
		"- EP gain is capped by the config’s `maxEPGain` (default 1,000,000)."
		""
		"- 30% chance to permanently reduce your max Magicule by exactly the naming cost."
		""
		"&1&nEndow works differently with Players&r&r"
		"- Each skill unlearnt has 50% to gain a certain amount of learning points [50% to get 25 - 25% to get 50 - 20% to get 75 - 5% to get 100]"
		""
		"- Non-magicule based alignments (not Holy/Chaos/Majin) will also use aura for naming if there is not enough magicule."
	]
	quest.1EB1005ED8C6BAC6.quest_desc: [
		"&6Levels of wands:&r"
		"&7Stone wand&r: 16 block limit."
		"&9Iron wand&r: 32 block limit."
		"&bDiamond wand&r: 64 block limit."
		"&zNetherite wand&r: 256 block limit."
	]
	quest.1EBE361CF38807E6.title: "Essence Of Eventide"
	quest.1F10BC33D22328BD.quest_desc: ["Time has claimed this once-sacred site, leaving its halls cracked and overgrown. Now, ghostly skeletons and trickster illusioners linger within, guarding little more than shadows of former glory. Though its dangers are real, the temple’s sturdy walls make it a tempting refuge for those seeking a foothold in this hostile world."]
	quest.1F10BC33D22328BD.quest_subtitle: "Find an Abandoned Temple"
	quest.1F3B1A473084AF20.quest_desc: [
		"Found in Pillager Outposts"
		""
		"The eye of a greedy king faded in solitude. Legend says it will bring infinite fortune to its owner"
	]
	quest.1F48364353E54B88.quest_subtitle: "Part of the Elemental Might set"
	quest.21426F5EEC922866.quest_desc: ["Half-submerged in the oceans lie the petrified remains of a colossal beast, its skeletal form stretching farther than the eye can follow. Was it a creature of the deep, dragged ashore in ages past—or did it fall from the heavens themselves? No records remain, only questions carved into stone."]
	quest.21426F5EEC922866.quest_subtitle: "Find a Typhon"
	quest.216A4BCE6A7CCCC6.quest_desc: [
