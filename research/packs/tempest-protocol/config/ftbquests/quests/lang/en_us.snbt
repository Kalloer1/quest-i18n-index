	quest.7235F52B87EE9E92.title: "Leather"
	quest.724FA2010666E491.quest_desc: [
		"Stand on a Diamond Block, equip a Diamond Sword in main hand slot and begin to alternate it from main hand to offhand (press F).  The cost is 3 XP Levels. Each 3 XP Level will spin the XP Wheel and give you a rare prize. Some spins may not be so lucky and reward basic prizes while some may give you enchanting bottles which you can use to get more XP back. The more you spin the more you win!"
		"Check out the Casino chapter and XP casino for more information."
	]
	quest.727F994148B634C6.quest_desc: ["Kill The Decaying King"]
	quest.728D4F708AD289DE.quest_desc: [
		"Your Gear will evolve with you (only Tensura gear), indoing so it will gain engravings that boost your gear adn give you some effects"
		""
		"youll gain engravings when your gear reaches:"
		"50,000 EP for First Engraving"
		"250,000 EP for Second Engraving"
		"1,000,000 EP For Third Engraving"
		""
		"{@pagebreak}"
		"&l&2&nCommon Engravings&r&r&r"
		""
		"&2&lSwift&r&r"
		"Increases the weapon's damage, attack range and attack speed"
		""
		"&2&lSturdy&r&r"
		"Increases the weapon's damage and equipment's durability, and makes the item invulnerable to environmental damage. (One of the two engravings avaliable to shields, with the Tempest Scale Shield featuring Magical Interference as other avaliable engraving)"
		""
		"&2&lCrushing&r&r"
		"Increases the weapon's damage along with damage dealt to Armor at the cost of durability"
		"{@pagebreak}"
		"&2&l&nUncommon Engravings&r&r&r"
		""
		"&2&lMagic Weapon&r&r"
