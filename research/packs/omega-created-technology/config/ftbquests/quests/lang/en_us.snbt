	chapter_group.44C8A9130BFD9883.title: "The important stuff"
	quest.0000000000001001.quest_desc: [
		"Craft or obtain **The Oracle Index**."
		""
		"This guide book explains Oritech's animated multiblock assembly rules and machine addon porting."
	]
	quest.0000000000001001.quest_subtitle: "In-Game Documentation"
	quest.0000000000001001.title: "1. The Oracle Index"
	quest.0000000000001002.quest_desc: [
		"Oritech uses **Nickel** (Y=40 to -65) as its core structural metal and **Platinum** (End / deepslate Y=-20 to -60) for high-tier superconductors."
		""
		"Gather Raw Nickel and Fluxite Crystals to begin."
	]
	quest.0000000000001002.quest_subtitle: "Foundation Materials"
	quest.0000000000001002.title: "2. Mining Nickel & Platinum"
	quest.0000000000001003.quest_desc: [
		"Combine Nickel Ingots and Iron/Steel to forge **Magnetic Coils** and **Motors**."
		""
		"These are essential micro-components present in almost all Tier 1 machine recipes."
	]
	quest.0000000000001003.quest_subtitle: "Basic Components"
	quest.0000000000001003.title: "3. Magnetic Coils & Motors"
	quest.0000000000001004.quest_desc: [
		"Machines in Oritech consist of a **Machine Block Base** combined with a **Machine Core**."
		""
		"The final machine's processing speed and stats scale based on the mathematical average tier of attached cores."
	]
	quest.0000000000001004.quest_subtitle: "Assembly Architecture"
	quest.0000000000001004.title: "4. Machine Hulls & Core Tiers"
	quest.0000000000001005.quest_desc: [
		"Construct a **Basic Generator Block**."
		""
		"Burn solid fuels like coal or charcoal to generate Redstone Flux (RF/FE) for your primary network."
	]
	quest.0000000000001005.quest_subtitle: "Early RF Power"
	quest.0000000000001005.title: "5. Energy Generation: Basic Combustion"
	quest.0000000000001006.quest_desc: [
		"Craft standard **Energy Pipes** to distribute power."
		""
		"Standard energy pipes support up to 10,000 RF/t throughput and automatically link adjacent Oritech machines."
	]
	quest.0000000000001006.quest_subtitle: "10,000 RF/t Capacity"
	quest.0000000000001006.title: "6. Energy Cable Network"
	quest.0000000000001007.quest_desc: ["Build an **Energy Storage / Acceptor Block** to cache excess grid power and prevent brownouts during heavy operation cycles."]
	quest.0000000000001007.quest_subtitle: "Grid Buffering"
	quest.0000000000001007.title: "7. Energy Storage Buffer"
	quest.0000000000001008.quest_desc: [
		"Build the **Pulverizer** (32 RF/t base draw)."
		""
		"Grind raw ores into dust for double yield, pulverize Coal into Coal Dust, and process Quartz into Quartz Dust for Silicon."
	]
	quest.0000000000001008.quest_subtitle: "Ore & Material Grinding"
	quest.0000000000001008.title: "8. Pulverizer: Dust Processing"
	quest.0000000000001009.quest_desc: [
		"Construct the **Electric Foundry**."
		""
		"Use it to blend powders and ingots into advance-grade Oritech metal alloys and carbon-bonded structures."
	]
	quest.0000000000001009.quest_subtitle: "High Thermal Synthesis"
	quest.0000000000001009.title: "9. Electric Foundry: Alloy Smelting"
	quest.0000000000001010.quest_desc: [
		"Build the **Centrifuge Block**."
		""
		"It separates complex chemical mixtures, converts bio-matter into sludge, and isolates heavy radioactive isotopes."
	]
	quest.0000000000001010.quest_subtitle: "Fluid Extractions"
	quest.0000000000001010.title: "10. Centrifuge: Liquid/Solid Separation"
	quest.0000000000001011.quest_desc: [
		"Craft **Item Pipes**."
		""
		"Pipes default to input mode. Right-click the connection point touching a container to switch it into **Export Mode**."
	]
	quest.0000000000001011.quest_subtitle: "Logistics Basics"
	quest.0000000000001011.title: "11. Item Pipes & Extraction Logic"
	quest.0000000000001012.quest_desc: [
		"Attach an **Item Filter** to any pipe connection."
		""
		"It provides 12 sorting slots with whitelist/blacklist toggles to direct item flows precisely."
	]
	quest.0000000000001012.quest_subtitle: "Whitelisting & Blacklisting"
	quest.0000000000001012.title: "12. Item Filters"
	quest.0000000000001013.quest_desc: [
		"Craft **Fluid Pipes** and **Fluid Storage Tanks**."
		""
		"Fluid pipes transport liquids smoothly with zero entities to ensure server-side tick performance."
	]
	quest.0000000000001013.quest_subtitle: "Hydro-Transport"
	quest.0000000000001013.title: "13. Fluid Pipes & Storage Tanks"
	quest.0000000000001014.quest_desc: [
		"Craft **Speed Addons**."
		""
		"Attach them to open machine addon ports to drastically accelerate operation speeds at the cost of higher RF consumption."
	]
	quest.0000000000001014.quest_subtitle: "Overclocking Machine Ticks"
	quest.0000000000001014.title: "14. Speed Addon"
	quest.0000000000001015.quest_desc: ["Craft **Efficiency Addons** to reduce energy draw per tick, balancing high-speed overclocks."]
	quest.0000000000001015.quest_subtitle: "Energy Optimization"
	quest.0000000000001015.title: "15. Efficiency Addon"
	quest.0000000000001016.quest_desc: ["Attach a **Machine Addon Extender** to machine sides to expand the maximum number of installable addon modules."]
	quest.0000000000001016.quest_subtitle: "Expanding Attachment Slots"
	quest.0000000000001016.title: "16. Machine Addon Extender"
	quest.0000000000001017.quest_desc: ["Pulverize Nether Quartz into Quartz Dust, then smelt it down to produce pure **Silicon**."]
	quest.0000000000001017.quest_subtitle: "Micro-electronics Setup"
	quest.0000000000001017.title: "17. Silicon & Quartz Dust"
	quest.0000000000001018.quest_desc: [
		"Fabricate **Processing Units** and build the **Assembler**."
		""
		"The Assembler acts as Oritech's main automated workstation, unlocking high-tier component recipes with reduced material cost."
	]
	quest.0000000000001018.quest_subtitle: "Automated Power Crafting"
	quest.0000000000001018.title: "18. Processing Units & The Assembler"
	quest.0000000000001019.quest_desc: [
		"Upgrade your machine cores to **Advanced Machine Cores** (Tier 2)."
		""
		"Attach these cores to existing machines to permanently increase base processing speeds and unlock Tier 2 recipes."
	]
	quest.0000000000001019.quest_subtitle: "Mid-Game Frame Upgrade"
	quest.0000000000001019.title: "19. Tier 2: Advanced Machine Core"
	quest.0000000000001020.quest_desc: [
		"Locate surface **Crude Oil Springs** (spawning naturally every 120-350 chunks)."
		""
		"Pump Crude Oil into fluid containers for chemical refining."
	]
	quest.0000000000001020.quest_subtitle: "Fossil Fuel Extraction"
	quest.0000000000001020.title: "20. Oil Prospecting & Crude Oil Springs"
	quest.0000000000001021.quest_desc: [
		"Process Crude Oil into Fuel and **Plastic Sheets**."
		""
		"Plastic is vital for advanced wiring, high-capacity energy storage, and suit construction."
	]
	quest.0000000000001021.quest_subtitle: "Petrochemical Chain"
	quest.0000000000001021.title: "21. Oil Refinery & Plastic"
	quest.0000000000001022.quest_desc: [
		"Build the **Fuel Generator Block**."
		""
		"Burn refined oil fuels or crop-processed Biofuel. Fully upgraded with Speed Addons, a single Fuel Generator outputs massive base RF."
	]
	quest.0000000000001022.quest_subtitle: "High-Efficiency RF"
	quest.0000000000001022.title: "22. Fuel Generator & Biofuel Route"
	quest.0000000000001023.quest_desc: [
		"Craft a **Drone Port (Takeoff)** and **Drone Port (Landing)**."
		""
		"Drones transport items across unlimited distances between bound ports."
	]
	quest.0000000000001023.quest_subtitle: "Long-Distance Logistics"
	quest.0000000000001023.title: "23. Drone Takeoff & Landing Ports"
	quest.0000000000001024.quest_desc: [
		"Craft the **Target Designator**."
		""
		"Shift-right-click the destination landing port, then right-click the takeoff port to pair them. Flight time takes ~30 seconds."
	]
	quest.0000000000001024.quest_subtitle: "Drone Flight Path Binding"
	quest.0000000000001024.title: "24. Target Designator Binding"
	quest.0000000000001025.quest_desc: [
		"Build the **Enderic Laser Arm** and **Laser Target Block**."
		""
		"Laser Arms shoot focused energy beams at target blocks to harvest resources, mine blocks, or power specialized receivers."
	]
	quest.0000000000001025.quest_subtitle: "Targeted Block Interactors"
	quest.0000000000001025.title: "25. Enderic Laser Arm"
	quest.0000000000001026.quest_desc: ["Craft specialized laser heads: **Destroyer Block** (mining), **Tree Cutter** (logging), **Fertilizer Block**, and **Placer Block**."]
	quest.0000000000001026.quest_subtitle: "Farming, Cutting & Harvesting"
	quest.0000000000001026.title: "26. Laser Sub-Modules"
	quest.0000000000001027.quest_desc: [
		"Construct the **Deepslate Laser Drill** multiblock."
		""
		"Position it over deepslate layers and fire Laser Arms into it to generate infinite ore outputs without destroying terrain."
	]
	quest.0000000000001027.quest_subtitle: "Automated Ore Extraction"
	quest.0000000000001027.title: "27. Deepslate Laser Drill"
	quest.0000000000001028.quest_desc: ["Locate naturally generated bedrock ore nodes in the world and place a **Bedrock Extractor** over them for permanent renewable ore veins."]
	quest.0000000000001028.quest_subtitle: "Endgame Ore Extraction"
	quest.0000000000001028.title: "28. Bedrock Extractor & Resource Nodes"
	quest.0000000000001029.quest_desc: ["Build **Particle Accelerator Rings** and assemble a circular multiblock accelerator ring."]
	quest.0000000000001029.quest_subtitle: "Subatomic Physics"
	quest.0000000000001029.title: "29. Particle Accelerator Ring"
	quest.0000000000001030.quest_desc: ["Attach the **Accelerator Motor** to inject particles and the **Accelerator Sensor** to detect high-speed collisions."]
	quest.0000000000001030.quest_subtitle: "Collision Control"
	quest.0000000000001030.title: "30. Accelerator Motor & Sensor"
	quest.0000000000001031.quest_desc: ["Place the **Particle Collector** to harvest subatomic fragments produced during collisions, yielding exotic materials."]
	quest.0000000000001031.quest_subtitle: "Exotic Particle Harvesting"
	quest.0000000000001031.title: "31. Particle Collector & Fluxite Synthesis"
	quest.0000000000001032.quest_desc: ["Combine exotic collision particles and advanced circuitry into **Superior Machine Cores** (Tier 3)."]
	quest.0000000000001032.quest_subtitle: "Peak Machine Framework"
	quest.0000000000001032.title: "32. Tier 3: Superior Machine Core"
	quest.0000000000001033.quest_desc: ["Purify raw Uranium in centrifuges to isolate **Uranium Fuel Pellets** for nuclear power."]
	quest.0000000000001033.quest_subtitle: "Radioactive Preparation"
	quest.0000000000001033.title: "33. Uranium Processing Chain"
	quest.0000000000001034.quest_desc: ["Build the **Nuclear Reactor Controller**, **Reactor Walls**, and **Reactor Fuel Ports** to form the reactor shell."]
	quest.0000000000001034.quest_subtitle: "Atomic Fission Core"
	quest.0000000000001034.title: "34. Nuclear Reactor Controller"
	quest.0000000000001035.quest_desc: ["Assemble **Reactor Fuel Rods**, **Double Rods**, and **Quad Rods** for maximum neutron flux density."]
	quest.0000000000001035.quest_subtitle: "Core Fuel Grid"
	quest.0000000000001035.title: "35. Fuel Rods & Double/Quad Assemblies"
	quest.0000000000001036.quest_desc: ["Install **Neutron Reflectors**, **Reactor Heat Absorbers**, **Heat Vents**, and **Heat Pipes** inside the reactor matrix to prevent catastrophic meltdown."]
	quest.0000000000001036.quest_subtitle: "Thermal & Radiation Balance"
	quest.0000000000001036.title: "36. Neutron Reflectors & Heat Absorbers"
	quest.0000000000001037.quest_desc: ["Craft the **Manhattan Module** and **Low-Yield Nuclear Device** for high-energy destructive tests."]
	quest.0000000000001037.quest_subtitle: "Atomic Detonation Tech"
	quest.0000000000001037.title: "37. Low-Yield Nuclear Explosion Device & Manhattan Module"
	quest.0000000000001038.quest_desc: [
		"Process Platinum into **Superconductors**."
		""
		"Superconductors transfer up to 4,194,304 RF/t. Note: Superconductors cannot directly connect to standard Energy Pipes; the run must be 100% Superconductor end-to-end."
	]
	quest.0000000000001038.quest_subtitle: "4,194,304 RF/t Grid Cables"
	quest.0000000000001038.title: "38. Platinum Refining & Superconductors"
	quest.0000000000001039.quest_desc: [
		"Construct the **Atomic Resonator Block** multiblock."
		""
		"It performs quantum transmutaion on base metals under immense superconductor energy draw."
	]
	quest.0000000000001039.quest_subtitle: "Pinnacle Energy Processing"
	quest.0000000000001039.title: "39. Atomic Resonator Multiblock"
	quest.0000000000001040.quest_desc: [
		"Craft the full **Exosuit Set** (Helmet, Chestplate, Leggings, Boots)."
		""
		"Runs on internal RF power and provides fall damage mitigation, night vision, speed boosts, and environmental protection."
	]
	quest.0000000000001040.quest_subtitle: "Power Armor"
	quest.0000000000001040.title: "40. Exosuit Armor Set"
	quest.0000000000001041.quest_desc: ["Install cybernetic augmentation modules into your character for permanent passive buffs powered directly by worn Exosuit batteries."]
	quest.0000000000001041.quest_subtitle: "Direct Body Upgrades"
	quest.0000000000001041.title: "41. Cybernetic Player Augmentation"
	quest.0000000000001042.quest_desc: [
		"Craft the **Prometheum Pickaxe** and **Prometheum Battleaxe**."
		""
		"Equipped with 5,000,000 RF internal batteries, supporting enchantments like Unbreaking, Sharpness, and Efficiency."
	]
	quest.0000000000001042.quest_subtitle: "High-Tier Powered Tools"
	quest.0000000000001042.title: "42. Prometheum Tools"
	quest.0000000000001043.quest_desc: ["Craft the **Enderic Railgun** and **Electric Mace** for heavy kinetic ranged strikes and high-voltage shock melee damage."]
	quest.0000000000001043.quest_subtitle: "Advanced Ordnance"
	quest.0000000000001043.title: "43. Enderic Railgun & Electric Mace"
	quest.0000000000001044.quest_desc: ["Build the **Arcane Catalyst** and **Stabilized Enchanter** to infuse gear with custom controlled enchantment ranks using RF power."]
	quest.0000000000001044.quest_subtitle: "Arcane Technology"
	quest.0000000000001044.title: "44. Arcane Catalyst & Stabilized Enchanter"
	quest.0000000000001045.quest_desc: [
		"Assemble the **Spawner Cage** and **Spawner Controller**."
		""
		"Insert mob souls to build high-speed powered automated mob spawners."
	]
	quest.0000000000001045.quest_subtitle: "Mob Farming Machinery"
	quest.0000000000001045.title: "45. Spawner Controller & Spawner Cage"
	quest.0000000000001046.quest_desc: ["Process **Soul Flowers** in the **Tainted Refinery** to synthesize corrupted catalysts for late-game recipes."]
	quest.0000000000001046.quest_subtitle: "Biological Transmutation"
	quest.0000000000001046.title: "46. Tainted Refinery & Soul Flower"
	quest.0000000000001047.quest_desc: ["Craft **Industrial Glass** and decorative structural blocks for clear base viewports and clean multi-block enclosures."]
	quest.0000000000001047.quest_subtitle: "Factory Aesthetics"
	quest.0000000000001047.title: "47. Industrial Glass & Connected Textures"
	quest.0000000000001048.quest_desc: ["Craft powered **Ceiling Lights** and large multi-block animated **Hangar Doors**."]
	quest.0000000000001048.quest_subtitle: "Base Automation Architecture"
	quest.0000000000001048.title: "48. Ceiling Lights & Hangar Doors"
	quest.0000000000001049.quest_desc: ["Achieve maximum machine performance by chaining **Machine Addon Extenders** and filling every slot with Tier-3 Speed Addons for >2,600% speed."]
	quest.0000000000001049.quest_subtitle: "Peak Automation Challenge"
	quest.0000000000001049.title: "49. Overclocking 2600% Processing Limit"
	quest.0000000000001050.quest_desc: ["Connect 4 Bedrock Extractors to Drone Ports and Superconductors to automate infinite ore delivery to your central hub."]
	quest.0000000000001050.quest_subtitle: "Infinite Material Grid"
	quest.0000000000001050.title: "50. Fully Automated Bedrock Grid"
	quest.0000000000001051.quest_desc: ["You have mastered every system in Oritech: nuclear energy, subatomic physics, laser drilling, cybernetic augmentations, and logistics!"]
	quest.0000000000001051.quest_subtitle: "Complete Mod Mastery"
	quest.0000000000001051.title: "51. MASTER OF ORITECH"
	quest.0000000000001052.quest_desc: ["With Oritech complete, use your Superconductors and Atomic Resonators as the bridge into the pack's Creative End Goal!"]
	quest.0000000000001052.quest_subtitle: "Endgame Integration Bridge"
