		""
		"We managed to free the &#2ECC71World&f from the evil of &#7F8C8DSloth&f..."
		""
		"Now let's fight &#9B59B6Pride&f!"
	]
	quest.08FF5285EC6022B8.quest_subtitle: "Laziness personified!"
	quest.08FF5285EC6022B8.title: "Walking Bed"
	quest.09704689C2A7497D.quest_desc: [
		"Light this &#9B59B6Portal&f..."
		""
		"These &#8B0000Creatures&f came here because of something much greater... I can't explain it. It feels like nothing is &#3498DBReal&f, even after seeing everything in this world. Even its formation is different! It's something from &#8E44ADBeyond&f!"
	]
	quest.09704689C2A7497D.quest_subtitle: "Lighting up"
	quest.0A181EFA5FF0023A.quest_desc: ["This is the &#8B0000Eye&f we needed! Now let's build the Altar of &#7F8C8DSloth&f!"]
	quest.0A181EFA5FF0023A.quest_subtitle: "A weird eye"
	quest.0B71F7BA5B576C17.quest_desc: [
		"HAHAHA! Did that &#E74C3CHurt&f?"
		""
		"So tell me... are you ready to live through your &#9B59B6Nightmare&f again?"
