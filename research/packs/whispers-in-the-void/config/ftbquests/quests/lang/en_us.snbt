	quest.0F2C59F14A6192B4.title: "Gluttony"
	quest.0F68806DB35B6B0C.quest_desc: [
		"Ah, &#9B59B6Pride&f... Kid, this is something that destroyed many &#E74C3CFamilies&f, even tearing siblings apart..."
		""
		"Pride plagues this &#8B0000World&f in unimaginable ways. Families destroyed by pride, friendships broken... The sin of &#9B59B6Pride&f is extremely &#E74C3CStrong&f and &#3498DBIntelligent&f!"
	]
	quest.0F68806DB35B6B0C.quest_subtitle: "Ladies and Gentlemen"
	quest.0F68806DB35B6B0C.title: "Pride"
	quest.10EC62B144D83FB4.quest_desc: [
		"&#2ECC71Envy&f has already killed siblings... and in this world, it couldn't be any different."
		""
		"The sin of &#2ECC71Envy&f came to plague the entire &#8B0000World&f and destroy families and friendships!"
		""
		"We need to defeat the sin of &#2ECC71Envy&f and free this world from &#8B0000Evil&f!"
