	quest.6CC2BB731A8213DB.quest_subtitle: "Car"
	quest.6CC2BB731A8213DB.title: "Stars of Thought"
	quest.6D09ED46C48D5C32.quest_subtitle: "BOOOOOOM"
	quest.6D09ED46C48D5C32.title: "Stars of Thought"
