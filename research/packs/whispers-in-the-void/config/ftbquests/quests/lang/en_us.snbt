	quest.2ACEC4DF85198DEB.quest_subtitle: "A helmet for adventures"
	quest.2BE559B841E96B64.quest_desc: [
		"&#2ECC71Envy&f... because of it, many had everything and then lost it all..."
		""
		"Usually, envy comes from desiring something you still cannot &#F1C40FAchieve&f..."
		""
		"Anyway! This is the &#E74C3CEnd&f of it. Let's continue on our &#3498DBPath&f."
	]
	quest.2BE559B841E96B64.quest_subtitle: "It is the end of envy"
	quest.2C4E491DD63FBD94.quest_desc: [
		"Follow the &#F1C40FImage&f below and build the Altar of the &#E74C3CDevil&f."
		""
		"Once the &#9B59B6Altar&f is complete, click the Soul Candle with the Flint and Steel."
		""
		"&#3498DBRequired&f Blocks:"
		""
		"19 Soul Soil"
		"4 Wither Skeleton Skulls"
		"1 Soul Candle"
		""
		"{image:ftbquests:textures/gui/devil.png width:120 height:100 align:center click_action:none:}"
	]
	quest.2C4E491DD63FBD94.quest_subtitle: "Altar"
	quest.2C5DA00777A48B9A.quest_desc: ["To truly get started, we need some &#3498DBTools&f! We know &#8B5A2BWood&f isn't strong, but it's only the &#2ECC71Beginning&f!"]
	quest.2C5DA00777A48B9A.quest_subtitle: "Basic tools!"
	quest.2C5DA00777A48B9A.title: "Wooden Tools"
	quest.2CF5821B21962416.quest_subtitle: "I am one of them!"
	quest.2CF5821B21962416.title: "Stars of Thought"
	quest.2DAB01DBA4A59056.quest_desc: ["Something is &#E74C3CRavaging&f the &#FF5733Nether&f. I suspect it's the last of the &#8B0000Monsters&f we've been facing... the &#9B59B6Protector&f of the Kraken, Dragon, Sirok, and Yeti!"]
	quest.2DAB01DBA4A59056.quest_subtitle: "Returning to the Nether"
	quest.2DBFD5ABFB91BA32.quest_desc: [
		"Consumed by &#9B59B6Pride&f, the Captain let her emotions take control, driven by the &#F1C40FGreed&f to always want more."
		""
		"She tried to reach a &#8E44ADCursed&f island, but as punishment from God, The Maze Mother appeared and stopped her ship from reaching the island, dragging her down to the depths of the &#3498DBSea&f!"
	]
	quest.2DBFD5ABFB91BA32.quest_subtitle: "A lost caption..."
	quest.2E72CEA6686FAAAD.quest_desc: [
		"The &#8B0000Sinners&f have turned the world upside down. &#9B59B6Creatures&f are appearing from places we never even imagined..."
		""
		"Find a &#F1C40FNest&f in the &#E6B86ADesert&f!"
	]
	quest.2E72CEA6686FAAAD.quest_subtitle: "Something suspicious in the sand"
	quest.2E927011981FCCE0.quest_desc: [
		"Begin: This world was taken over and destroyed by &#8B0000Sinners&f! We lost what mattered most and what could have saved us as &#3498DBHumanity&f... we lost &#8B0000Fear&f!"
		""
		"We allowed ourselves to be consumed by &#FF8C00Gluttony&f, &#9B59B6Pride&f, &#FFD700Greed&f, &#2ECC71Envy&f, &#FF1493Lust&f, &#7F8C8DSloth&f, and &#E74C3CWrath&f."
		""
		"Our &#8B0000World&f is lost..."
	]
	quest.2E927011981FCCE0.quest_subtitle: "Vices and desires"
	quest.2EB1CB34B7F0F82F.quest_desc: ["As a &#F1C40FReward&f for defeating the Fallen Knight, we have a chance to obtain the &#9B59B6Smithing&f Template. It works just like Netherite, but we use Netherite Armor + Smithing Template + &#34495EDark&f Metal!"]
	quest.2EB1CB34B7F0F82F.quest_subtitle: "Better + Better"
	quest.2F6960A9559CF94D.quest_desc: ["Something &#9B59B6Strange&f really is happening... This &#F1C40FArena&f is incredibly large and &#E74C3CDangerous&f! We need to &#3498DBExplore&f it!"]
	quest.2F6960A9559CF94D.quest_subtitle: "An arena at the bottom of the Nether"
	quest.2F955E854768F07A.quest_desc: [
		"I won't &#E74C3CAccept&f this. I'm coming after you, no matter who you are!"
		""
		"I've already faced the &#8B0000Strongest&f monsters in this world, and you'll be just another one! Just you wait, &#9B59B6Ghost&f! I'll find out who you are!"
	]
	quest.2F955E854768F07A.quest_subtitle: "Punishing"
	quest.2F955E854768F07A.title: "Stars of Hope"
	quest.30C931CC7249C5FD.quest_desc: [
		"&#F1C40FGreed&f put these &#E74C3CDemons&f in our path, and we mastered them! HAHAHA!"
		""
		"Now let's go after its &#8B0000Servant&f!"
		""
		"To defeat the &#9B59B6Obsidilith&f, we'll need to return to The End."
	]
	quest.30C931CC7249C5FD.quest_subtitle: "Something calls to us"
	quest.316E5E734BA1C0E7.quest_desc: ["An &#F1C40FIncredible&f pickaxe that can have a level 5 &#9B59B6Enchantment&f!"]
	quest.316E5E734BA1C0E7.quest_subtitle: "Fortune 5"
	quest.31750CEC99060822.quest_desc: [
		"&#34495EDark&f Metal is a precious and &#F1C40FRare&f material. We can obtain its Pieces by killing:"
		""
		"Barrel Zombies, Bonescaller, Door Knights, Diamond Termites, Missionary, Nightmare Stalker, Skeleton Thrasher, Spirit Guide, and Zombie Bruiser."
	]
	quest.31750CEC99060822.quest_subtitle: "Catching drops"
	quest.31ED812DF45C9945.quest_desc: ["We need some &#85C1E9Glass&f Bottles to collect the &#8B0000Blood&f of creatures. Just keep a Glass Bottle in your inventory and hit creatures with the &#7F8C8DSickle&f."]
	quest.31ED812DF45C9945.quest_subtitle: "Collecting blood"
	quest.328BAC8BFDCAC4C4.quest_desc: [
		"The &#8B0000Sinners&f have shaken the &#2ECC71World&f! We can notice something truly &#9B59B6Strange&f..."
		""
		"This Wither Skeleton looks &#E74C3CDifferent&f!"
	]
	quest.328BAC8BFDCAC4C4.quest_subtitle: "A knight"
	quest.330886E603B2752B.title: "Terrible Armor"
	quest.3363C13FEE9F260F.quest_desc: [
		"Once the &#9B59B6Altar&f is ready, we'll need to click on the Honey Block with the &#E74C3CHeart&f."
		""
		"But be &#FF5733Careful&f, kid... &#FF8C00Gluttony&f is dangerous and will try to devour you in every possible way! Stay &#3498DBPrepared&f and &#E74C3CStrong&f!"
	]
	quest.3363C13FEE9F260F.quest_subtitle: "Heart in hand"
	quest.3364051A0004EFF3.quest_desc: [
		"A &#9B59B6Dream&f? I don't think so, kid..."
		""
		"You don't &#3498DBRemember&f anything? You just appeared here, and I'm nothing more than a &#8E44ADVoice&f inside your head\\"
	]
	quest.3364051A0004EFF3.quest_subtitle: "Dream"
	quest.33BA7AAC6E88BBEA.quest_desc: ["The &#85C1E9Gauntlet&f of Skor, a &#F1C40FUnique&f artifact that functions as both a &#E74C3CMelee&f weapon and a &#7F8C8DShield&f. Left-clicking applies a &#3498DBFreezing&f effect."]
	quest.33BA7AAC6E88BBEA.quest_subtitle: "Ice Cold fist!"
	quest.343E51575BBBE264.quest_desc: [
		"During the &#34495ENight&f, a &#8B0000Monster&f that grew because of the sinners reveals itself!"
		""
		"We need to become &#E74C3CStronger&f!"
	]
	quest.343E51575BBBE264.quest_subtitle: "Getting ready for the night"
	quest.343E51575BBBE264.title: "Iron Armor"
	quest.348AEB5F077A10E9.quest_desc: [
		"Some believe that &#7F8C8DSloth&f took over young people because of &#3498DBPhones&f and easy access to everything..."
		""
		"What do I think? I believe the &#8B0000World&f has been lost for many years, and the decade we're living in was simply chosen to be the &#E74C3CEnd&f of it all!"
	]
	quest.348AEB5F077A10E9.quest_subtitle: "Why did this start?"
	quest.348AEB5F077A10E9.title: "Diamond Tools"
	quest.34A4F831A311F011.quest_desc: ["Find the &#E74C3CCaptain&f of the ship. He guards this &#F1C40FHorn&f! Defeat him and take the Horn!"]
	quest.34A4F831A311F011.quest_subtitle: "Playing the Horn"
	quest.3516AE047122A140.quest_desc: [
		"This &#F1C40FIncredible&f sword is extremely &#E74C3CPowerful&f and sharp."
		""
		"Its &#9B59B6Special&f ability is activated by holding down the right mouse button. The player charges the sword for about 3 seconds, then releases it to fire a volley of up to seven &#3498DBSword&f waves in rapid succession, with each projectile dealing 5 &#E74C3CDamage&f."
	]
	quest.3516AE047122A140.quest_subtitle: "The hero's sword!"
	quest.352E509700853952.quest_desc: [
		"&#7F8C8DSloth&f began to spread mostly among young people. None of them wanted to do anything anymore, only stay on their &#3498DBPhones&f."
		""
		"Because of this, &#F1C40FJobs&f were left vacant and cities began to die, with people becoming desperate because nothing was getting done..."
		""
		"A &#8B0000Terror&f unlike anything ever seen before... &#7F8C8DSloth&f killed many young people."
	]
	quest.352E509700853952.quest_subtitle: "Deep sleep"
	quest.352E509700853952.title: "Sloth"
	quest.358D69F538B30936.quest_desc: ["To obtain this &#9B59B6Stone&f, you need to throw Andesite into the &#FF5733Spirit&f Fire!"]
	quest.358D69F538B30936.quest_subtitle: "Just because it's white doesn't mean it's not from hell."
	quest.358D69F538B30936.title: "Otherstone"
	quest.358EBBDBB21D15F6.quest_subtitle: "A flashing white and red light..."
	quest.358EBBDBB21D15F6.title: "Stars of Thought"
	quest.36641D54E44310E4.quest_subtitle: "Better tools!"
	quest.36641D54E44310E4.title: "Netherite Tools"
	quest.3688305630D5F91D.quest_subtitle: "He got what he deserved!"
	quest.3688305630D5F91D.title: "Stars of Thought"
	quest.36F6D86A585CF359.quest_desc: [
		"This &#8B0000Monster&f, born from our sins, loves to &#FFD700Steal&f things."
		""
		"So when you find it, make sure to be &#E74C3CCareful&f. It will steal your &#7F8C8DSword&f, so bring a &#2ECC71Spare&f!"
	]
	quest.36F6D86A585CF359.quest_subtitle: "A monster"
	quest.3708C44201809BE4.quest_desc: ["The disease of &#FF8C00Gluttony&f was something &#8B0000Terrifying&f... We don't know how it came to this. Maybe it started when we began using &#7F8C8DIron&f to slaughter animals and get &#F1C40FFood&f!"]
	quest.3708C44201809BE4.quest_subtitle: "You don't eat iron!"
	quest.3708C44201809BE4.title: "Iron Ingot"
	quest.37FCE6248FA22F1C.quest_desc: [
		"As a pleasant &#F1C40FSurprise&f, The Maze Mother is a &#E74C3CMonster&f that devours everything in her path."
		""
		"We need to find and &#8B0000Eliminate&f her too."
		""
		"For The Maze Mother to be drawn to you, stay in the &#9B59B6Labyrinth&f for at least 30 minutes!"
	]
	quest.37FCE6248FA22F1C.quest_subtitle: "Finding Mom!"
	quest.381043E5D4003216.quest_subtitle: "Sin and Sinners"
	quest.381043E5D4003216.title: "Stars of Thought"
	quest.38BE757D2FCEFE9C.quest_subtitle: "It's his fault!"
	quest.38BE757D2FCEFE9C.title: "Stars of Thought"
	quest.39F25102BE158695.quest_desc: ["As a drop from the &#8B0000Betrayed&f Guzzler, we can get this strange &#7F8C8DSickle&f and use it as a weapon. It has &#9B59B6Incredible&f power!"]
	quest.39F25102BE158695.quest_subtitle: "In Pursuit of Blood"
	quest.3AD4D97798109C82.quest_desc: [
		"Something is &#E74C3CPreventing&f us from reaching &#7F8C8DSloth&f..."
		""
		"The sin of &#7F8C8DSloth&f is putting something in our way. We need to reach these &#9B59B6Structures&f and find it."
	]
	quest.3AD4D97798109C82.quest_subtitle: "Something is preventing..."
	quest.3B819FDD387914AC.quest_desc: ["The &#9B59B6Kraken&f's Trident will be extremely &#F1C40FUseful&f! With it, we can fight from long &#3498DBDistances&f and deal some serious &#E74C3CDamage&f!"]
	quest.3B819FDD387914AC.quest_subtitle: "A new weapon"
	quest.3C5A840E98C05ACD.quest_desc: [
		"&#F1C40FAmazing&f, isn't it? We can combine parts of a dead rabbit and &#2ECC71Resurrect&f it."
		""
		"To do this, we need to make a Rabbit Full Body, and while it's &#34495EDark&f outside, we need to place it on a Clinical Stretch. After a few seconds, &#3498DBLightning&f will strike, resurrecting the rabbit."
		""
		"Once it's alive (or dead), we can &#F1C40FTame&f it with carrots."
		""
		"There are several &#E74C3CMobs&f we can do this with. We just need to gather their body parts."
	]
	quest.3C5A840E98C05ACD.quest_subtitle: "An undead rabbit"
	quest.3D40CBA65B41B0FF.quest_desc: [
		"A &#E74C3CMonster&f that rises from the ground and unleashes a powerful beam from its mouth... This can only be a &#9B59B6Dream&f or something like that. I still don't know what this could be. We need to &#F1C40FInvestigate&f!"
		""
		"Defeat the &#34495EWarden&f."
	]
	quest.3D40CBA65B41B0FF.quest_subtitle: "Slow steps"
	quest.3D48FB1627D4F5F3.quest_desc: ["We can obtain the &#9B59B6Gauntlet&f, an artifact dropped when &#E74C3CSirok&f is defeated! It shoots &#2ECC71Poison&f and is incredibly &#F1C40FPowerful&f!"]
	quest.3D48FB1627D4F5F3.quest_subtitle: "A weapon?"
	quest.3DE56F16D5EEE98A.quest_subtitle: "We grew up so fast!"
	quest.3DE56F16D5EEE98A.title: "Stars of Thought"
	quest.3EE1496C2515B6C5.quest_desc: [
		"As a final &#8B0000Breath&f, the demon of &#9B59B6Pride&f tried to take over our lands!"
		""
		"We need to find a &#7F8C8DStructure&f where a strange &#2ECC71Plant&f is hidden..."
	]
	quest.3EE1496C2515B6C5.quest_subtitle: "Pointing!"
	quest.40F5382BEF5C0CED.quest_desc: [
		"Understand, kid, &#9B59B6Everything&f repeats itself... the old and the new. This problem has happened before, trust me... I've been here for &#F1C40FLonger&f than you can imagine."
		""
		"Get some &#8E44ADObsidian&f. We're going to the &#E74C3CNether&f!"
	]
	quest.40F5382BEF5C0CED.quest_subtitle: "Old cycles..."
	quest.40F5382BEF5C0CED.title: "Obsidian"
	quest.412CF537133BAAB1.quest_subtitle: "Duplicating ores"
	quest.414B226E8278BCA8.quest_desc: [
		"Some &#9B59B6Strange&f things are happening to the world..."
		""
		"We don't know if the sin of &#F1C40FGreed&f is responsible, but there's something strange about all of this..."
		""
		"Let's start &#3498DBInvestigating&f! Begin with a Flint and Steel and break some grass to obtain Demon Seeds."
	]
	quest.414B226E8278BCA8.quest_subtitle: "The other side of the occult..."
	quest.41BE6D3E447B674D.quest_subtitle: "Lucke..."
	quest.41BE6D3E447B674D.title: "Stars of Thought"
	quest.42C97EB507E80D02.quest_subtitle: "That was exactly what we needed!"
	quest.4433E4C33892F219.quest_desc: [
		"Imagine how many &#9B59B6Dreams&f were shattered and ruined because of &#FFD700Greed&f, &#FF1493Lust&f..."
		""
		"&#8B0000Sin&f is an evil that affects everyone and has always been here, but we allowed ourselves to be consumed by it..."
		""
		"Craft a &#7F8C8DHoe&f so we can grow some &#2ECC71Food&f, and beware of &#FF8C00Gluttony&f!"
	]
	quest.4433E4C33892F219.quest_subtitle: "Interrupted dreams"
	quest.44E5433C20C33EC2.quest_desc: ["&#3498DBRest&f in peace... &#8B0000Brother&f..."]
	quest.44E5433C20C33EC2.quest_subtitle: "Create a grave for Locke"
	quest.44E5433C20C33EC2.title: "Memorial"
	quest.451ED8659F9C8639.quest_desc: [
		"It seems these &#E74C3CMonsters&f that appeared because of the &#8B0000Sinners&f are everywhere, even in the &#85C1E9Ice&f..."
		""
		"Before we continue to face &#9B59B6Pride&f, let's head to the &#3498DBSnow&f."
	]
	quest.451ED8659F9C8639.quest_subtitle: "A danger on the ice"
	quest.45E1A965630189DA.quest_desc: ["Clearly, these followers of &#9B59B6Azazel&f are cowards who fled the real world to hide in the arms of a god who lives in &#E74C3CHell&f... Funny, isn't it? They ran away from &#8B0000Sin&f, yet now they live in pure &#8B0000Sin&f!"]
	quest.45E1A965630189DA.quest_subtitle: "A more dangerous Nether..."
	quest.45E1A965630189DA.title: "Find Mansion Nether"
	quest.46539E45AE8ED1C2.quest_desc: [
		"The followers of &#9B59B6Azazel&f built this massive &#8B0000Temple&f..."
		""
		"It is divided into &#F1C40FThree&f zones:"
		""
		"The &#7F8C8DCursed&f Quarries - The first area we enter. Here, we discover that some villagers have been kidnapped, and we need to defeat the &#E74C3CManipulators&f to free them."
		""
		"The &#9B59B6Secret&f City - An important area where Azazel's subjects live. In this area, we can find a &#2ECC71Doctor&f who gives us potions and a &#F1C40FBlacksmith&f who can repair our tools!"
	]
	quest.46539E45AE8ED1C2.quest_subtitle: "Three zones"
	quest.46539E45AE8ED1C2.title: "Zones"
	quest.46AD5D0EF80E65AC.quest_desc: ["We need to collect all &#8B0000Three&f types of blood, and to collect the &#3498DBWinged&f type, we can get it by hitting chickens, bats, hoglins, and other creatures of this kind!"]
	quest.46AD5D0EF80E65AC.quest_subtitle: "Winged"
	quest.46D14382C7DA386A.quest_subtitle: "Place it in the center of the ritual"
	quest.4857DE357980AEB1.quest_desc: ["Who is this calling me? Is my name Locke?"]
	quest.4857DE357980AEB1.quest_subtitle: "\"Locke, come here! Let's play\""
	quest.4857DE357980AEB1.title: "Stars of Thought"
	quest.48909FA431899D2A.quest_subtitle: "Regrets?"
	quest.48909FA431899D2A.title: "Stars of Thought"
	quest.48995C64C9650658.quest_desc: [
		"This small &#8B0000Monster&f can help us fight other &#E74C3CMonsters&f. Just fill it with Flesh of Demise and place three mob drops in the three middle slots! Each &#F1C40FDrop&f has a different effect."
		""
		"- Creeper's organ will make your creature very &#2ECC71Unstable&f, and if it dies, it will implode."
		""
		"- Iron Golem's organ gives it greater &#7F8C8DResistance&f and immunity to deadly falls."
		""
		"- Slime's organ allows your flesh son to &#2ECC71Replicate&f into two identical clones if it dies."
		""
		"- Enderman's organ makes your creature less tangible, allowing it to &#9B59B6Dodge&f attacks by teleporting elsewhere."
		""
		"- Strider's organ makes your Gulbèr's skin drier and &#FF5733Fire&f resistant, but makes it hydrophobic."
		""
		"- Ravager's organ gives the creature incredible &#E74C3CStrength&f."
		""
		"- Blaze's organ boils your creature's blood to such a high temperature that it releases burning &#FF5733Steam&f around itself."
		""
		"- Spider's organ makes your creature's blood so &#2ECC71Acidic&f that it poisons anyone it touches."
		""
		"- Snow Golem's organ puts your Gulbèr's blood between a solid and liquid state, allowing it to survive at very low &#85C1E9Temperatures&f and freeze anything, from the ground to its enemies."
	]
	quest.48995C64C9650658.quest_subtitle: "A little monster"
	quest.499650CEB8381E95.quest_subtitle: "You were light"
	quest.499650CEB8381E95.title: "Stars of Thought"
	quest.499D5FB9BA0DDD2C.quest_desc: ["To obtain the &#9B59B6Abyssal&f Amethyst, defeat The Maze Mother!"]
	quest.499D5FB9BA0DDD2C.quest_subtitle: "Mom's Template"
	quest.4A2D837C26C98D89.quest_desc: [
		"He was all I had. He was the one who took care of me, and because of one stupid &#E74C3CFight&f..."
		""
		"My drunk uncle did that, and I lost my only &#3498DBFamily&f... my only &#8B0000Brother&f..."
	]
	quest.4A2D837C26C98D89.quest_subtitle: "Lucke"
	quest.4A2D837C26C98D89.title: "Stars of Hope"
	quest.4A5FAB9AF43925B0.quest_desc: [
		"What do you think has always been every rich person's greatest &#FF1493Desire&f? The answer is easy... something that &#F1C40FMoney&f can't buy. HAHAHA!"
		""
		"LET'S BRING THINGS BACK TO &#2ECC71LIFE&f AROUND HERE!"
		""
		"Start with a Clinical Stretch."
	]
	quest.4A5FAB9AF43925B0.quest_subtitle: "Reliving things"
	quest.4B890CE2CF44ECE6.quest_desc: [
		"Luck? Luck? &#F1C40FLUCKKKKK&f, WHERE ARE YOU? CAN YOU HEAR ME?"
		""
		"Why is everything so &#34495EDark&f?"
	]
	quest.4B890CE2CF44ECE6.quest_subtitle: "A Frankenstein horse"
	quest.4BAD65AAB6D60C10.quest_subtitle: "I did that"
	quest.4BAD65AAB6D60C10.title: "Stars of Thought"
	quest.4C5150207C45C800.quest_desc: [
		"Whose &#F1C40FHero&f? Anyway, we can finally put an end to this! These &#E74C3CMonsters&f that appeared because of the &#8B0000Sinners&f..."
		""
		"Let's face this &#7F8C8DFool&f!"
		""
		"But be &#F1C40FCareful&f! Don't be fooled by his low &#E74C3CHealth&f. &#9B59B6Helvar&f is extremely strong and &#3498DBFast&f!"
	]
	quest.4C5150207C45C800.quest_subtitle: "Hero Helvar"
	quest.4C62D67811176E61.quest_desc: [
		"Follow the &#F1C40FImage&f below and build the &#FF8C00Gluttony&f Altar."
		""
		"Once the &#9B59B6Altar&f is complete, click the Honey Block with the &#E74C3CHeart&f."
		""
		"&#3498DBRequired&f Blocks:"
		""
		"25 Hay Blocks"
		"4 Emerald Blocks"
		"4 Cakes"
		"1 Honey Block"
		""
		""
		"{image:ftbquests:textures/gui/wistiver.png width:150 height:100 align:center}"
	]
	quest.4C62D67811176E61.quest_subtitle: "Building!"
	quest.4C62D67811176E61.title: "Altar"
	quest.4C9ED7412BA38D1F.quest_desc: ["To create some better &#2ECC71Undead&f, we need more &#E74C3CImportant&f body parts. For that, we can use the Extractor on an undead body with a pair of Tweezers!"]
	quest.4C9ED7412BA38D1F.quest_subtitle: "Removing pieces"
	quest.4D92AC7AE4548665.quest_desc: ["We need to collect all &#8B0000Three&f types of blood, and to collect the &#2ECC71Primary&f type, we can get it by hitting pigs, sheep, cows, and other creatures of this kind!"]
	quest.4D92AC7AE4548665.quest_subtitle: "Primary"
	quest.4F30D26D4E8B3F73.quest_subtitle: "Use na extractor"
	quest.4F3436559D9F7B93.quest_subtitle: "We need to stay strong against Azazel!"
	quest.4F3436559D9F7B93.title: "Netherite Armor"
	quest.4F5D4628D584990A.quest_desc: [
		"Now, with &#7F8C8DAshes&f and &#8B0000Blood&f, we can combine everything and create a bucket of blood. It will be &#F1C40FEssential&f to find and put an end to the first &#E74C3CSin&f!"
		""
		"This blood has &#9B59B6Incredible&f powers. It can &#2ECC71Heal&f you while you're inside it! But be careful, remember that too much of anything can be harmful! Don't overdo it, or the &#8B0000Blood&f may punish you!"
	]
	quest.4F5D4628D584990A.quest_subtitle: "Storing blood"
	quest.4FDB3EC8F14BD961.quest_desc: [
		"Don't &#E74C3CDrink&f that! The potion we made is used to store the current &#3498DBWeather&f and time of day."
		""
		"Let's put it into practice. Find a &#8E44ADDark&f Temple and climb up to the Environmental Accumulator. Check if the current weather is what you want, then drop this potion vial on top of the &#9B59B6Environmental&f Accumulator."
		""
		"It will store the current &#3498DBWeather&f, allowing us to throw the vial on the ground whenever we want and change the weather!"
	]
	quest.4FDB3EC8F14BD961.quest_subtitle: "Drinking the potion?"
	quest.5030F2FF27EB4B05.quest_desc: [
		"I believe you can &#2ECC71Help&f us. That's the only reason why you appeared here."
		""
		"That's the only &#3498DBExplanation&f... We need to defeat the &#E74C3CSeven&f monsters of the &#8B0000Deadly&f sins, and in the meantime, survive in this completely &#7F8C8DLost&f and corrupted world!"
	]
	quest.5030F2FF27EB4B05.quest_subtitle: "A desolate world"
	quest.5030F2FF27EB4B05.title: "7 pecados"
	quest.50D59002C103F474.quest_desc: [
		"What's the &#9B59B6Meaning&f of this? A massive &#E74C3CHand&f is standing in our way... We need to defeat it and use its &#8B0000Eye&f to create the Altar of &#7F8C8DSloth&f!"
		""
		"To summon the massive &#E74C3CHand&f, break all the blocks of its &#7F8C8DCocoon&f and summon the hand!"
	]
	quest.50D59002C103F474.quest_subtitle: "A hand?"
	quest.51429F1717CC767B.quest_subtitle: "It was for you!"
	quest.51429F1717CC767B.title: "Stars of Thought"
	quest.528DCDF09C04F637.quest_desc: ["To make this &#9B59B6Stone&f, you'll need to throw Diorite into the Spirit Fire, and it will become something from another &#8E44ADWorld&f!"]
	quest.528DCDF09C04F637.quest_subtitle: "A stone from hell"
	quest.528DCDF09C04F637.title: "Otherrock"
	quest.531E3CCF036BEEA2.quest_desc: [
		"Unfortunately, to defeat and put an end to &#8B0000Sin&f, we need to &#E74C3CSin&f ourselves, and that may come at a great cost!"
		""
		"Now we need a &#ECF0F1Sword&f made from bones. When we strike a living creature with this sword, we can obtain a new &#F1C40FDrop&f."
	]
	quest.531E3CCF036BEEA2.quest_subtitle: "Extracting more and more"
	quest.5497A88817916B34.title: "&6Dark Metal Armor"
	quest.55E73F9A3CC005B0.quest_desc: [
		"Plant the Demon Dream Seeds and harvest their &#9B59B6Fruit&f. After that, eat it and you'll see..."
		""
		"Everything looks the &#7F8C8DSame&f? Strange, I could've sworn it would be something different. We'll find out in the future."
		""
		"Here, in the book of &#9B59B6Ghosts&f that live inside the minds of dead people, it says..."
		""
		"\"The fruit will allow you to see things from the &#8E44ADOccult&f.\""
	]
	quest.55E73F9A3CC005B0.quest_subtitle: "An exotic fruit"
	quest.566FB5A182413AC6.quest_desc: [
		"&#8E44ADRituals&f are the key to the occult world and the best way to bring things from the &#9B59B6Occult&f into our world!"
		""
		"We can start with the ritual to summon the &#E74C3CFoliot&f, the first demon!"
		""
		"Draw on the ground using Chalk in the pattern shown in the &#F1C40FDictionary&f and place the candles!"
		""
		"(Use the Dictionary to guide you through the markings on the ground.)"
	]
	quest.566FB5A182413AC6.quest_subtitle: "Aviar Circle"
	quest.569DF0E7B6658F18.quest_desc: [
		"Something &#9B59B6Strange&f is happening... It feels like we're trapped in our &#34495ESubconscious&f, and our &#3498DBMemories&f keep getting lost. I don't know why we keep losing focus..."
		""
		"Anyway, let's go to &#9B59B6The&f End and look for the sin of &#FF1493Lust&f there. It's not in this world!"
	]
	quest.569DF0E7B6658F18.quest_subtitle: "Okay, this is REALLY CONFUSING."
	quest.56AD976768018BCF.quest_desc: [
		"What is this supposed to be? This &#9B59B6World&f has gone crazy."
		""
		"Is this what &#F1C40FGreed&f prepared for us? What is this supposed to be? It feels like a faint &#3498DBMemory&f of something that went &#E74C3CWrong&f..."
	]
	quest.56AD976768018BCF.quest_subtitle: "????"
	quest.56DC9E96C07353D6.quest_desc: [
		"This enormous &#E74C3CWorm&f is cruel! It bursts out of the ground and charges toward players to &#8B0000Bite&f them!"
		""
		"It's a very &#F1C40FPowerful&f boss!"
	]
	quest.56DC9E96C07353D6.quest_subtitle: "A monster beneath one's feet"
	quest.56F201B5E1B3D60F.quest_desc: [
		"HAHAHAHA!"
		""
		"You wanted to take out the &#E74C3CAnger&f from losing your &#3498DBBrother&f on your uncle..."
	]
	quest.56F201B5E1B3D60F.quest_subtitle: "Don't you remember?"
	quest.56F201B5E1B3D60F.title: "Stars of Thought"
	quest.57000B8AC0A6E51D.quest_desc: ["Be &#E74C3CCareful&f if you're near villages and walking around with &#D4A017Bread&f in your hand. We don't know if anyone there carries the sin of &#FF8C00Gluttony&f within them..."]
	quest.57000B8AC0A6E51D.quest_subtitle: "Fighting against sin"
	quest.57000B8AC0A6E51D.title: "Bread"
	quest.5706DB607D98B2B3.quest_desc: [
		"Well, I didn't explain some things before... but we're going to deal with some &#8B0000Dark&f things and a lot of &#E74C3CBlood&f."
		""
		"But that's for later. For now, we're going to control &#3498DBTime&f. Incredible, isn't it? Which &#9B59B6Sin&f could this be? Hahaha"
		""
		"First, craft this &#85C1E9Vial&f!"
	]
	quest.5706DB607D98B2B3.quest_subtitle: "Controlling time"
	quest.586441A473475D0F.quest_desc: [
		"The &#9B59B6Kraken&f latched onto the underside of a pirate ship and &#8E44ADHypnotized&f the pirates."
		""
		"Find the Kraken's ship and defeat the &#E74C3CPirates&f to summon the Kraken and unleash its &#8B0000Wrath&f!"
		""
		"The battle is &#F1C40FFrenetic&f! Use the ship's &#7F8C8DCannons&f to take down the Kraken. Destroy all its &#E74C3CTentacles&f, then face its &#8B0000Head&f!"
	]
	quest.586441A473475D0F.quest_subtitle: "A huge monster"
	quest.58BC53BD10B0F4CC.quest_subtitle: "I was asleep..."
	quest.58BC53BD10B0F4CC.title: "Stars of Thought"
	quest.5BCAFACC56F77E3B.quest_desc: ["To remove any &#9B59B6Curse&f, deposit &#8B0000Blood&f and place the item in the &#3498DBPurifier&f."]
	quest.5BCAFACC56F77E3B.quest_subtitle: "Cleansing curses!"
	quest.5BE434255B6AE558.quest_subtitle: "A party? We love cake!"
	quest.5BE434255B6AE558.title: "Stars of Thought"
	quest.5C9A021CDAA4D476.quest_subtitle: "1, 2, 3, 4..."
	quest.5C9A021CDAA4D476.title: "Stars of Thought"
	quest.5C9F5BEB0BAE9570.quest_desc: ["Upon entering the &#9B59B6Tower&f, we'll need to &#E74C3CFight&f some &#F1C40FGuards&f!"]
	quest.5C9F5BEB0BAE9570.quest_subtitle: "Dragon guards!"
	quest.5C9F5BEB0BAE9570.title: "Kill Ashlord Guard"
	quest.5CF5337AEAD03BC3.quest_desc: [
		"The &#8B0000Sins&f are ravaging our &#2ECC71World&f. Even after destroying most of them, something is &#9B59B6Wrong&f!"
		""
		"We'll need to use their own &#E74C3CEvil&f against them! Let's perform &#8E44ADRituals&f and summon &#E74C3CDemons&f to put an end to this once and for all!"
	]
	quest.5CF5337AEAD03BC3.quest_subtitle: "Rituals and spirits!"
	quest.5CF5337AEAD03BC3.title: "Candle"
