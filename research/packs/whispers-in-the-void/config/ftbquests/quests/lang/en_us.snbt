	quest.6E4844ED0979A1D5.quest_subtitle: "Confronting the subject"
	quest.700A8E206F85AAED.quest_desc: ["I think the &#E74C3CDragon&f forgot to spit out the last &#7F8C8DHelmet&f of the soldier it devoured... Looks like &#FF8C00Gluttony&f is to blame for this!"]
