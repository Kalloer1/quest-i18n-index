	quest.629E95E0A7FD7271.quest_subtitle: "Wrath..."
	quest.629E95E0A7FD7271.title: "Stars of Thought"
	quest.65B1A1FFC6316672.quest_desc: ["&#7F8C8DStone&f Age? If you gave those crazy people the chance, they'd probably eat this &#7F8C8DStone&f too! Hahaha"]
	quest.65B1A1FFC6316672.quest_subtitle: "Improving features"
	quest.65E4CF9828A2CC14.quest_subtitle: "Alone again..."
	quest.65E4CF9828A2CC14.title: "Stars of Thought"
	quest.6629B2AAAEDE0681.quest_desc: [
		"We have freed this &#2ECC71World&f from &#FF8C00Gluttony&f... but this is only &#F1C40FOne&f of the seven..."
