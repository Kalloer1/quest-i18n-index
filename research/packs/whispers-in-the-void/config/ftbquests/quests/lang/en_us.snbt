		"We need to put an end to this and bring &#3498DBPeace&f to the world!"
		""
		"As we can see, there are many new &#E74C3CMonsters&f! Let's go after some of them!"
	]
	quest.68110DF196A5D548.quest_subtitle: "A desolate world"
	quest.68110DF196A5D548.title: "Decrepit Skeleton"
	quest.6894751A06022DBA.quest_desc: [
