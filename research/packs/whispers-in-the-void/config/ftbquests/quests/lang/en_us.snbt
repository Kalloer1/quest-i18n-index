	quest.04035E39ADF82BAF.title: "Stars of Thought"
	quest.055A634A9565AE22.quest_desc: [
		"So you were &#3498DBSleeping&f and woke up here? Hahaha"
		""
		"So I'm inside your &#9B59B6Mind&f... or maybe I'm a &#ECF0F1Ghost&f whispering in your ear, or maybe you're &#8B0000Dead&f. Hahaha"
		""
		"There are so many &#F1C40FPossibilities&f! I'm just kidding, kid... You fell into this world with a &#3498DBMission&f: save our &#2ECC71World&f!"
	]
	quest.055A634A9565AE22.quest_subtitle: "I was asleep...."
	quest.055A634A9565AE22.title: "Lembranças?"
	quest.063953E19F8A9B6A.quest_subtitle: "I miss you, my dear brother"
	quest.063953E19F8A9B6A.title: "Stars of Thought"
	quest.06E96AC3F5C5FA9C.quest_desc: [
		"To face the sin of &#2ECC71Envy&f, we'll need to be truly &#8B0000Evil&f..."
		""
		"Unfortunately, this will be necessary for us to continue, but it won't make us evil or cause us to fall into &#E74C3CSin&f. Well, not us, hahaha... &#F1C40FYou&f. I'm just something inside your head."
		""
		"To begin, combine a &#8E44ADDark&f Gem with an apple. Look for the Dark Gem in &#7F8C8DCaves&f."
	]
	quest.06E96AC3F5C5FA9C.quest_subtitle: "Your dark side"
	quest.0759C984DF9A62FC.quest_desc: [
		"I believe I can finally &#3498DBRest&f in peace..."
		""
		"I've always made it this far, but I was never able to defeat the &#E74C3CDevil&f and escape this &#9B59B6Cycle&f."
		""
		"Even after breaking the cycle, I'll remain trapped here!"
		""
		"I hope to find you on the other &#F1C40FSide&f, my &#3498DBBrother&f..."
	]
	quest.0759C984DF9A62FC.quest_subtitle: "Eternal end"
	quest.0759C984DF9A62FC.title: "Stars of Hope"
	quest.0856E57D2B324ECE.quest_desc: [
		"THAT'S NOT &#E74C3CTRUE&f! HE KILLED MY &#3498DBBROTHER&f!"
		""
		"HE GOT WHAT HE &#8B0000DESERVED&f!"
	]
	quest.0856E57D2B324ECE.quest_subtitle: "Nothing is as it is"
	quest.0856E57D2B324ECE.title: "Stars of Hope"
	quest.08FF5285EC6022B8.quest_desc: [
