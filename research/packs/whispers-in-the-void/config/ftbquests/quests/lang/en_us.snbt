	quest.5E69D958C8B9FAB7.quest_subtitle: "Precious!"
	quest.5E72B3ADD7D246B0.quest_subtitle: "You will never come back"
	quest.5E72B3ADD7D246B0.title: "Stars of Thought"
	quest.5EC884C97C05806E.quest_desc: [
		"Everything has a &#F1C40FPurpose&f, hahaha."
		""
		"We need to get back on track and destroy the sin of &#2ECC71Envy&f..."
		""
		"It sent one of its &#8B0000Servants&f for us to face first. Let's go after it! In &#85C1E9Cold&f biomes, we can find the Lich Tower."
		""
		"Follow the &#9B59B6Soul&f Stars."
	]
	quest.5EC884C97C05806E.quest_subtitle: "It seems crazy, doesn't it?"
	quest.5F682144D1588BCA.quest_desc: ["You're &#3498DBYoung&f, kid, and you can't let this affect you! Get up and find some &#85C1E9Diamonds&f. We need to go to the &#E74C3CNether&f!"]
	quest.5F682144D1588BCA.quest_subtitle: "Overcoming laziness"
	quest.5F682144D1588BCA.title: "Diamond"
	quest.5F6D0FDC6CEFBE7C.quest_desc: [
		"Another &#8B0000Evil&f has come to an end..."
		""
		"&#FF1493Lust&f has met its end, but what did it &#E74C3CCost&f? What have we done?"
		""
		"The &#34495EEnd&f of all this is near... We need to be &#F1C40FCareful&f. Your head must be hurting! Prepare yourself for the next &#8B0000Sin&f."
	]
	quest.5F6D0FDC6CEFBE7C.quest_subtitle: "The end of the giant!"
	quest.5FD565829BD398B0.quest_desc: ["Place these &#F1C40FBowls&f near the ritual to hold the items for the &#8B0000Sacrifice&f!"]
	quest.5FD565829BD398B0.quest_subtitle: "Place the ritual offerings"
	quest.5FD565829BD398B0.title: "Sacrificial Bowl"
	quest.6013F01C57ADD847.quest_desc: ["Grab the &#E74C3CKraken&f's Tooth, and we'll create something &#F1C40FAmazing&f!"]
	quest.6013F01C57ADD847.quest_subtitle: "Huge tooth"
	quest.6055C7D9C0542131.quest_subtitle: "Where am I?"
	quest.6055C7D9C0542131.title: "Stars of Thought"
	quest.60F84D2A4C9EEDE2.quest_subtitle: "Cool head"
	quest.614A263EEE110395.quest_desc: ["With the &#E74C3CDragon&f Bone, we can craft some incredibly &#F1C40FPowerful&f armor!"]
	quest.614A263EEE110395.quest_subtitle: "An extremely strong bone"
	quest.629E95E0A7FD7271.quest_desc: [
		"&#9B59B6Ironic&f, isn't it? Being trapped inside a body with something &#8E44ADWhispering&f in your mind..."
