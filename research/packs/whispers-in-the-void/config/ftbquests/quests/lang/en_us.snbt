	quest.5D18794516CD9B73.quest_subtitle: "A new fire"
	quest.5D18794516CD9B73.title: "Spirit Fire"
	quest.5D454AE4289A3F4D.quest_subtitle: "I will avenge you!"
	quest.5D454AE4289A3F4D.title: "Stars of Thought"
