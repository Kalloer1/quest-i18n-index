	]
	quest.6629B2AAAEDE0681.quest_subtitle: "The Monster of Gluttony"
	quest.6629B2AAAEDE0681.title: "Wistiver"
	quest.6702159B4BBDFECB.quest_desc: ["We can use this &#7F8C8DKnife&f to obtain some Tallow, and for that, we'll need to &#8B0000Sacrifice&f some animals!"]
