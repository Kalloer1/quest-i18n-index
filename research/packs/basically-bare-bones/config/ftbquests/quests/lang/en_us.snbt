	quest.0370695F2F7E107C.quest_desc: [
		"You can keep your bed at home with this nifty mod"
		""
		"Travel with your sleeping bag or hammock and nails to make the nights fly by without resetting your respawn points."
	]
	quest.0370695F2F7E107C.quest_subtitle: "Keep your bed at home!"
	quest.0370695F2F7E107C.title: "Sleeping on your Adventures"
	quest.0EE6280EE148ACC5.title: "Visit a Badlands"
	quest.16F4D256FD10768E.quest_desc: [
		"Playing with Friends without making a full server"
		""
		" How to start E4MC: "
		"  Press ESC, click \"Open To Lan\", click \"start LAN World\", give your friends the &agreen IP&r."
		""
		" How to Join with E4MC:"
		"  Open your matching modpack and version to your friend's, go to \"&2Multiplayer&r\", click \"&2Direct Connect&r\" and put the IP your friend gives into the box, Join."
		""
		"&bBONUS&r: If you want to turn on commands you can use E4MC to turn them on after creating your world."
	]
	quest.16F4D256FD10768E.quest_subtitle: "Free ways to play with friends"
	quest.19D4FBB94290AA6C.quest_desc: [
		"Welcome to the Chipped Mod!"
		""
		"This mod allows you to add different textures to your blocks."
		""
		"How to use: "
		"►Place on ground, right click to open"
		"►Click on item in your inventory that you wish to modify."
		"►Left side shows how it looks in different angles and configurations."
		"►Right side lets you pick what option you like."
	]
	quest.2341EADD0DFA61DA.quest_desc: [
		"Happy Mail Time!"
		""
		"Mailboxes allow you to send stacks of items to yourself or your friends."
		""
		"Each mailbox can have its own name, and can be used all over your world, with friends or just wanting one at different bases or farms you decide to make."
		""
		"The mailbox from clutter does not work with Mail Time, but it does have some small storage."
		""
		"Use a post box to send mail to the other mailboxes in your world."
	]
	quest.2341EADD0DFA61DA.quest_subtitle: "Not just for socializing"
	quest.2341EADD0DFA61DA.title: "Happy Mail"
	quest.260925246B12EAD3.quest_desc: [
		"Shaders are off by default as not all computers are able to handle them."
		""
		"How to enable shaders:"
		" Click esc, video settings, click the &dshader packs&r button on the top right of the screen. Choose a shader to enable."
		""
		"How to edit shaders:"
		" Click on &eshader settings&r button from the shaders menu, feel free to mess around with settings and different shaders. Each shader and its settings will all be different and affect your game in different ways."
	]
	quest.260925246B12EAD3.quest_subtitle: "Where to find them"
	quest.397DEC92A565C609.quest_desc: ["A glassblower workbench can give you all different varieties to your glass materials."]
	quest.397DEC92A565C609.quest_subtitle: "Keep Out: Hot Glass"
	quest.41B0420A2BC68722.quest_desc: ["Carpenters Workbenches are used for making variants of wooden materials."]
	quest.41B0420A2BC68722.quest_subtitle: "Warning: Sharp Blades"
	quest.47DD5DB72FF39AF4.quest_desc: [
		"You can now right click to harvest all your crops!"
		" No need to replant as this will allow you to collect your matured crops and start the process again. "
	]
	quest.47DD5DB72FF39AF4.quest_subtitle: "Quick Harvasting"
	quest.47DD5DB72FF39AF4.title: "Harvesting"
	quest.4DA7236D76AADEED.quest_desc: ["Botanist Workbench is a table you can use to make different varieties of your favorite plants! "]
	quest.4DA7236D76AADEED.quest_subtitle: "Stop and smell the roses"
	quest.4E63DE38F62449C2.quest_desc: ["Looms can give you different textures to your wool blocks."]
	quest.4E63DE38F62449C2.quest_subtitle: "Warning: Fluffies flying in the Air."
	quest.506D0FC85E392E33.quest_subtitle: "Hardcore Redstoner"
	quest.54C41D8A0ABB613D.quest_desc: [
		"A faster way to sort your inventory"
		""
		"By default, your middle mouse button (scroll wheel) being clicked will automatically sort your inventory."
		""
		"You can also hold shift and right click over items to move them from chest to inventory or inventory to chest."
		""
		"If you prefer different buttons, it can be changed from the &acontrols&r button listed in the ESC menu. "
	]
	quest.5901C7ED4319F72C.quest_desc: [
		"Bags of Holding are similar to the vanilla bundles, the difference is you can upgrade them, and put full stacks of items in them."
		""
		"Hold in main hand, right click, it'll bring up a menu to view and modify what you have in your bag of holding."
		""
		"Vanilla bundles do have dyable varients if you prefer the normal ones as well."
	]
	quest.5901C7ED4319F72C.title: "Bags of Holding"
	quest.5ADCE4994491BC85.quest_desc: ["Biomes that Minecraft gives by default"]
	quest.61F70774C66E1030.title: "Visit the Plains"
	quest.62882BD221E33FC9.quest_desc: [
		"&eLanterns&r now have uses outside of just decoration!"
		""
		"Once you have your lantern, open your inventory and click the icon located on the top right of your player, place your lantern in the belt slot."
		""
		"You now have a portable light and allows you to keep both hands free for your journey"
	]
	quest.62882BD221E33FC9.quest_subtitle: "Aquire a lantern"
	quest.66C97F738BB33B03.quest_desc: ["Scroll over the left side of your screen to open the chapter's menu of your questbook."]
	quest.66C97F738BB33B03.quest_subtitle: "How to navigate your questbook"
	quest.66C97F738BB33B03.title: "Basics"
	quest.6ECFD997514CCD79.quest_desc: ["Trowels are used to add variation to your builds without having to manually switch items to place. Think of it as a randomizer tool for adding details and make your builds feel less bland."]
	quest.6FCEFC89B1C3D0D1.title: "Find a Sheep"
	quest.70F280BB1BBA0704.quest_desc: [
		"Upon death, your items on your person will be kept safe in a grave for you to retrieve once you are able to return to it."
		""
		"The grave will not despawn on its own till you reach back to it."
	]
	quest.70F280BB1BBA0704.quest_subtitle: "RIP"
