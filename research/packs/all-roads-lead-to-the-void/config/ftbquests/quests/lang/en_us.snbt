	quest.3B4DA4B43631B5E9.quest_desc: [
		"You can’t trigger a raid in this small box… how about the End instead?"
		""
		"Using a Warp Plate, you can transport villagers to the End."
		"To create a village, you need:"
		""
		"- 3 adult villagers"
		"- 3 beds"
		"- 3 doors"
		"- A bell"
		""
		"It is recommended to enclose the villagers so they don’t get killed."
	]
	quest.3C8ADCC73F795B2C.title: "Chain Acceleration"
	quest.3C9536A3B06FD5A1.quest_desc: ["How each item in Nature's Aura works is explained in Book of Natural Aura"]
	quest.3C9536A3B06FD5A1.title: "Ritual of the Forest"
	quest.3D56FB8A1E377071.title: "Tier 3 seeds"
	quest.40A4D4053E68875C.quest_desc: [
		"This book can store an &lunlimited&r number of mod guidebooks. To add one, simply craft it together with this book in a crafting table."
		""
		"After that, right-click to choose which book to open. To remove the selected book, left-click in the air."
	]
	quest.427B3BD46F6E7C55.quest_desc: ["This key can hold an &lunlimited&r number of wrenches (using a crafting table), and when you hover over a specific block, it changes its shape to match the wrench required for that block."]
	quest.4534F58EE8914CCD.title: "Flasks"
	quest.45423696DE9DE992.quest_desc: ["While a mob model is inside it, killing that mob will level up the model. The more leveled the model is, the higher the chance it will produce a mob prediction instead of the dimension prediction for that mob."]
	quest.46013C36E3CAFB61.quest_desc: [
		"If a beacon is placed near the terminal, it expands the interaction range:"
		""
		"Levels 1–3: accessible anywhere within the same dimension"
		"Level 4: accessible across all dimensions"
	]
	quest.46337D54ED5DD144.quest_desc: ["To learn how to summon mobs, check the crafting recipe for their spawn eggs (works for cows, chickens, sheep, villagers, and pillagers)."]
	quest.48587BC458C406E9.quest_desc: [
		"1. FTB Ultimine installed — hold ~."
		"2. Squat Grow installed — spamming Shift will make nearby plants grow."
		"3. You can harvest a crop by simply right-clicking it."
		"4. Open quests with Enter."
		"5. To avoid getting lost in progression, check your quests."
	]
	quest.49C6A99F89A000F3.quest_desc: ["To obtain lava, right-click on bedrock while holding at least one flint in either hand. There is a 50% chance that lava will appear on the bedrock, but be careful — one of the flints may break!"]
	quest.4B5E305119D319D8.quest_desc: ["Can be obtained by using a chisel on bedrock"]
	quest.4D1B7C1D2530D651.quest_desc: ["Go to the Hostile Neural Networks chapter. Using the machines from this mod, you can obtain mob drops in large quantities!"]
	quest.4FA1B09AF0EC3EC6.quest_desc: ["The leaves of this tree will gradually decay, releasing an aura."]
	quest.503164329695B7F2.title: "Red Matter Things"
	quest.50ADEE18F6E9161F.quest_desc: ["Place it in front of a tree, and it will start extracting latex. Supplying energy will speed up the process."]
	quest.51427F6828552D3F.title: "Soulstrider's Equipment"
