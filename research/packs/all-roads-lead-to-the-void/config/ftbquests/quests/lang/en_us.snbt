	quest.5A22A49585238647.title: "Yeti Armor"
	quest.5B23019A8A15F26D.quest_desc: ["How each item in Ars Nouveau works is explained in the Tattered Tome."]
	quest.5B5515AA6A613D0B.quest_desc: ["Sometimes, instead of a regular pillager, one may spawn holding an ominous bottle. Bottles can also be obtained using vault"]
	quest.5D4DAB532EE42389.quest_desc: ["By breaking leaves with a crook, you can obtain a silkworm. If you place it into leaves, wait, and then break the infested leaves with a crook, you can get string."]
	quest.63299C47155CCBB8.title: "Elemental essences"
	quest.655C0CB82B18F39F.quest_desc: [
		"To create a storage network, you need to:"
		""
		"1. Place any inventories (for example, chests)"
		"2. Connect them using Inventory Cables and lead them to an Inventory Connector"
		"3. Place a Storage Terminal on the connector"
		"4. (optional) Link a Wireless Terminal to it"
	]
	quest.65BE032714BCF15A.quest_desc: ["Can be obtained by using a chisel on bedrock"]
