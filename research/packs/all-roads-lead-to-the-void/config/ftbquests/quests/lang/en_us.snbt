	quest.0981309BE485382B.quest_desc: ["Time In a Bottle will accumulate time while it’s in your inventory or in a Curios slot. You can then spend it on a block by pressing Shift + RMB to speed it up. Pressing it again speeds it up further, and each subsequent press increases the speed up to ×256."]
	quest.0A21F47F2BC4714B.quest_desc: ["The Portal Gun allows you to quickly teleport from one place to another."]
	quest.0A4E0099E9531490.quest_desc: ["Latex + Water + Energy = Rubber!"]
	quest.0B61B64A9B820E0A.quest_desc: [
		"&cThe Nether&r has become as empty as the &aOverworld&r. But fortresses and bastions &lstill generate&r here!"
		""
		"P.S. You might want to get Elytra first, but it’s not required."
	]
