	quest.17FB3405901A2288.quest_desc: [
		"Welcome to a place you can’t escape from… probably."
		""
		"&lAll Roads Lead to the Void&r is a survival experience in a confined space with minimal resources, where you literally create everything from nothing."
		""
		"On one of the walls, you’ll notice a strange block — the Bedrock Metamorpher. It allows you to convert certain items into others."
		""
		"&l&oSo… &4let’s begin!&r&r"
		"{image:arlita:item/blindness width:40 height:40 align:center}"
	]
	quest.181481513287E3A1.quest_desc: ["Easter Egg :)"]
	quest.188240AD7CB9E234.title: "Dark Matter Things"
	quest.1C146E3B4FB7B3B6.quest_desc: [
		"&o4 &5elder relics&f, each with a unique ability:&r"
		""
		"&lElderspera&r: Press Enter (numpad) to switch you to spectator mode, but after returning to survival, you will be sacrificed."
		""
		"&lGloowyst&r: Highlights all nearby mobs."
		""
		"&lRestiaron&r: Press , (numpad) to protect yourself, but it will also highlight you."
		""
		"&lTimestiar&r: Press + (numpad) to freeze all mobs around you."
	]
