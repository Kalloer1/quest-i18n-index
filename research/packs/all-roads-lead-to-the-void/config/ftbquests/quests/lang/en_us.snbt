	quest.56F8CA1BF543F360.quest_subtitle: "Now it’s time to truly break matter!"
	quest.5711EB39543CABE4.quest_desc: ["Kill any passive mobs near this block to generate an aura."]
	quest.571EC5E451BA93AD.quest_desc: ["Right-click + Shift on Tier 2 metamorpher with netherite ingot"]
	quest.58C574F2459827A3.quest_desc: ["By placing any mob (including yourself) into an alchemical cauldron, blood will begin to accumulate in it. Right-click it with an empty bottle to collect it."]
