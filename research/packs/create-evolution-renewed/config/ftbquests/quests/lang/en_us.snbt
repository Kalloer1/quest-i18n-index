	quest.0057091087F93369.quest_subtitle: "Decoration Block"
	quest.00ACD837E30165B3.quest_desc: ["Generates rotational energy from FE. Can act as a peripheral for ComputerCraft. Enables bridging between electrical mods and Create's kinetic systems."]
	quest.00ACD837E30165B3.quest_subtitle: "Turns FE into rotational force"
	quest.00D4D974BDB2CE18.quest_subtitle: "Decoration Block"
	quest.00D9CE4397D427BC.quest_subtitle: "Decoration Block"
	quest.00F44F4FA88A59F9.quest_desc: ["When given rotational force, the Rope Winch winds attached rope in or out, raising and lowering whatever hangs from it. Pair it with a Rope Connector to link contraptions."]
	quest.00F44F4FA88A59F9.quest_subtitle: "Reels rope in and out"
	quest.012DFCAD0BAAE1EC.quest_subtitle: "Decoration Block"
	quest.0164D7D89151BAC5.quest_subtitle: "Decoration Block"
	quest.016DE6F430DD8293.quest_desc: ["[ { \"text\": \"Create Gunsmithing\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"7A9EC265305FC6D1\" } } ]"]
	quest.018C899D0D27FAF7.quest_desc: [
		"Much like a Lever, the Powered Latch can be right-clicked to turn it on or off. It emits a redstone signal that can be toggled on or off by other signals."
		""
		"When powered from the side, the Powered Latch is turned off. When powered from the back, the Powered Latch is turned on."
	]
	quest.018C899D0D27FAF7.quest_subtitle: "The Powered Latch emits a redstone signal that can be toggled on or off by other signals."
	quest.01B70D4768B7450D.quest_subtitle: "Decoration Block"
	quest.01B852D1F40D9E4B.quest_desc: ["A dense, heavy stone used as a basic mortar round. Crude but effective for lobbing at enemies over walls."]
	quest.021AF20A6B63F0B0.quest_subtitle: "Decoration Block"
	quest.02E1214A73069308.quest_desc: ["Thorium is mined from Thorium Ore and refined into the radioactive fuel that powers nuclear reactors."]
	quest.02E1214A73069308.quest_subtitle: "Raw fuel for nuclear power"
	quest.0354DB37FD2030EE.quest_desc: ["Biofuel refined from biomass and seed oil - a more efficient liquid fuel than seed oil for your burners."]
	quest.0354DB37FD2030EE.quest_subtitle: "An efficient flammable liquid"
	quest.038C1B51E29482E4.quest_subtitle: "Decoration Block"
	quest.03C35DD849D39960.quest_subtitle: "Decoration Block"
	quest.03CB4B44E73A22B3.quest_desc: ["Detects how far away nearby Redstone Links are. Open its config to set a minimum and maximum range, turning distance into an analog Redstone signal."]
	quest.03CB4B44E73A22B3.quest_subtitle: "Senses the distance to a Redstone Link"
	quest.0402E92EB181F281.quest_subtitle: "Decoration Block"
	quest.0488989FD7F5AF42.quest_desc: ["Obtained by putting an Iron Ingot in a Rolling Mill."]
	quest.0488989FD7F5AF42.quest_subtitle: "Crafting component."
	quest.0495E9DC993B07ED.quest_desc: ["The Conductor's Whistle lets you whistle commands to nearby Conductors and trains - a handy tool for crewing and directing your railway."]
	quest.0495E9DC993B07ED.quest_subtitle: "Signal your trains and conductors"
	quest.04B2B0351546810E.quest_subtitle: "Decoration Block"
	quest.04BF2BB47D90E214.quest_desc: ["Right-click on any block to set the coordinates."]
	quest.0537A184C9C87B76.quest_desc: ["A more powerful magnet built up in layers, with greater magnetic force than the Redstone Magnet."]
	quest.0537A184C9C87B76.quest_subtitle: "Stronger layered magnet"
	quest.053FDD5AD459D89A.quest_desc: ["The Propeller Bearing attaches to the block in front of it and turns any valid set of sails into a thrust-producing propeller. More sails mean more efficient thrust; reverse the spin to reverse the push."]
	quest.053FDD5AD459D89A.quest_subtitle: "Spins propellers to make thrust"
	quest.05B0ED6E96F9C98F.quest_desc: ["Use a deployer to put the Seat on the chassis."]
	quest.06474AE970E3263B.quest_desc: ["These three filters slot into the Network Controller. The Identification Filter excludes specific players and ships from autotargeting; the Detection Filter hides chosen mob and entity types; the Targeting Filter enables autotargeting and sets how it behaves."]
	quest.06474AE970E3263B.quest_subtitle: "Decide what the network sees and shoots"
	quest.06474AE970E3263B.title: "Filters"
	quest.06738D4C5672FC30.quest_subtitle: "Decoration Block"
	quest.067F616B9FBFF858.quest_desc: ["A decorative panel with a diagonal 'slashed' cut, for adding colour and detail to trains, carriages and stations. Available in all sixteen dye colours."]
	quest.067F616B9FBFF858.quest_subtitle: "Decorative train panelling"
	quest.06C3F8867FB76CD3.quest_subtitle: "Decoration Block"
	quest.07439BFD3361B311.quest_subtitle: "Decoration Block"
	quest.0756F9AE5F2C72EF.quest_desc: ["&dSpeed&r refers to how quickly a rotational component is spinning; it is measured in Rotations Per Minute (RPM) and can be seen with a Speedometer."]
	quest.0756F9AE5F2C72EF.title: "&dSpeed"
	quest.075E97B2BB5F93DF.quest_desc: ["Items cannot be added or removed by the player, but by components such as Chutes, Funnels, and Item Hatches."]
	quest.075E97B2BB5F93DF.quest_subtitle: "By default, each Item Vault block has a storage space of 20 stacks."
	quest.07774C6EA6E662CA.quest_desc: ["An upgraded Energiser that processes items faster, producing overcharged materials at a greater rate."]
	quest.07774C6EA6E662CA.quest_subtitle: "Faster, higher-tier energiser"
	quest.07CD5DFEA3D079F7.quest_subtitle: "Decoration Block"
	quest.07E534217E6F57AD.quest_subtitle: "Decoration Block"
