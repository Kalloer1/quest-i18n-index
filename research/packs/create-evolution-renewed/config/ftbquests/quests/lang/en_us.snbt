	quest.0BBE6CADED48A971.quest_desc: [
		"Click a Stock Link with the Stock Ticker to connect it to that network. Place a Mob in a Seat or a Blaze Burner behind the Stock Ticker to turn it into a Stock Keeper."
		""
		"The Stock Keeper can see all the items on the network. The UI displays how many Stock Links are connected. If the Stock Keeper is left unlocked, players can search the network, request items, and give their requests an Address to be sent to."
		""
		"If the Stock Keeper is locked, other players will not be able to access its UI. The Stock Keeper will still be able to accept Shopping Lists."
	]
	quest.0BBE6CADED48A971.quest_subtitle: "A Stock Ticker is used to request items from a Logistics Network."
	quest.0C23D806E2E32342.quest_subtitle: "Decoration Block"
	quest.0C84748F861F2036.quest_desc: ["A control stick that takes over your mouse to tilt on two axes and transmits on configurable Redstone Link frequencies - the natural way to hand-fly an aircraft."]
	quest.0C84748F861F2036.quest_subtitle: "Two-axis flight stick"
	quest.0C893A47E35B7F5D.quest_desc: ["The Bayonet attaches to a weapon and adds a melee stab, so you are never defenceless at point-blank range."]
	quest.0C893A47E35B7F5D.quest_subtitle: "Blade fixed to your firearm"
	quest.0C8F501F6BDFFB92.quest_desc: ["Obtained by putting a Gold Ingot in a Rolling Mill."]
	quest.0C8F501F6BDFFB92.quest_subtitle: "Crafting component."
	quest.0CFCA0E2A5DAC0EF.quest_subtitle: "Decoration Block"
	quest.0D07BA73F633A641.quest_desc: [
		"Once you find an ore vein place the Sample Drill. Once it has finished click it with the atlas. "
		""
		"Your Ore Vein Atlas now has all of the vein details, allowing you to filter with this vein. "
	]
	quest.0D11F4CFEADCA66D.quest_desc: [
