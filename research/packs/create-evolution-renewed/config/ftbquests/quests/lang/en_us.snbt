	quest.08181F01FCC216B0.quest_subtitle: "Decoration Block"
	quest.0834527ED1C0E83B.quest_desc: ["Allows FE to be carried into and used inside Create contraptions."]
	quest.0834527ED1C0E83B.quest_subtitle: "Moves FE on and off contraptions"
	quest.0840C62E91BAD7FE.quest_desc: ["Assign Redstone Link frequencies to its keys and the Linked Typewriter lets you fire them like a control panel, taking over movement and bound keys while active. A full cockpit in one block."]
	quest.0840C62E91BAD7FE.quest_subtitle: "Keyboard for Redstone Link frequencies"
	quest.0862532B03A09F0A.quest_subtitle: "Decoration Block"
	quest.089F935634066F2C.quest_subtitle: "Decoration Block"
	quest.08AF9A4BF08A3178.quest_desc: [
		"A Nixie Tube may be used to display Redstone signal strength of the connected redstone component. It will display the highest connected signal strength."
		""
		"When right clicked with a named Name Tag or a Clipboard with text, the Nixie Tube as well as adjacent Nixie Tubes will display the text."
	]
	quest.08AF9A4BF08A3178.quest_subtitle: "The Nixie Tube is a block that can display text or numbers."
	quest.08E454B4D7404865.quest_desc: ["Longer barrels tighten the Shotgun's spread and extend its effective range, making it useful past point-blank."]
	quest.08E454B4D7404865.quest_subtitle: "Shotgun range upgrade"
	quest.0935AFDD2EC55212.quest_desc: ["A decorative panel with a diagonal 'slashed' cut, for adding colour and detail to trains, carriages and stations. Available in all sixteen dye colours."]
	quest.0935AFDD2EC55212.quest_subtitle: "Decorative train panelling"
	quest.09BE3D92053AE1F8.quest_desc: ["When attempting to place the Roller on the top face of a block, it will be placed one block above it, similarly to a Mechanical Mixer or Mechanical Press. Though it appears to take up a few blocks of space, it only takes up one. There is also Placement Assist functionality, allowing for easy placement of Rollers to either of two sides of a roller. The Roller can be picked up by sneak using a Wrench on it."]
	quest.09BE3D92053AE1F8.quest_subtitle: "The Mechanical Roller can be used on Contraptions to clear and pave a path."
	quest.09C30D87FA134FCB.quest_desc: ["Fed oxygen from an Electrolyzer, the Oxygen Diffuser fills an airtight submarine with breathable air, using more the larger the vessel. Activate it with a Redstone signal."]
	quest.09C30D87FA134FCB.quest_subtitle: "Fills your sub with breathable air"
	quest.0A74B10BE687F032.quest_desc: ["The Gunsmithing Bench is used to craft weapons"]
	quest.0A90DA31CA402DF7.quest_desc: ["A cylindrical, boiler-shaped block for building the body of steam locomotives. Comes in all sixteen dye colours to match your livery."]
	quest.0A90DA31CA402DF7.quest_subtitle: "Decorative boiler block"
	quest.0A9BABB3943B966E.quest_desc: ["An upgraded Launcher that fires Rockets in rapid succession instead of one at a time."]
	quest.0A9BABB3943B966E.quest_subtitle: "Automatic rocket launcher"
	quest.0ABCC30DE11FCCB2.quest_subtitle: "Decoration Block"
	quest.0AC15613BD86D48F.quest_desc: ["A decorative panel with a diagonal 'slashed' cut, for adding colour and detail to trains, carriages and stations. Available in all sixteen dye colours."]
	quest.0AC15613BD86D48F.quest_subtitle: "Decorative train panelling"
	quest.0B3E3CDFD6607DE0.quest_subtitle: "Decoration Block"
	quest.0B7FC480B3025463.quest_subtitle: "Decoration Block"
	quest.0B8148DAF5CC9DF1.quest_desc: ["Holds wire for connecting high-current connectors. Right-click two connectors to run a wire between them while keeping the spool."]
	quest.0B8148DAF5CC9DF1.quest_subtitle: "Stores high-current wire"
	quest.0B8814167E371927.quest_subtitle: "Decoration Block"
	quest.0B9964971081961A.quest_subtitle: "Decoration Block"
