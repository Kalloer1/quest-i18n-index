	quest.696631A7286A38E8.quest_desc: [""]
	quest.696631A7286A38E8.quest_subtitle: "Engine that drives automatic weapons"
	quest.69816C16E81355E8.quest_desc: ["A clutch that uncouples after a set delay when the network is overstressed. Can be reset with a wrench"]
	quest.6986767827914A8E.quest_subtitle: "Decoration Block"
	quest.698D5738EA593FFC.quest_subtitle: "Decoration Block"
	quest.6A0B52B4AA96B42E.quest_desc: ["The Pneumatic Hammer uses compressed air to deliver heavy, knockback-heavy blows. Its head can be swapped between stone, iron, diamond and netherite."]
	quest.6A0B52B4AA96B42E.quest_subtitle: "Air-powered melee smasher"
	quest.6A25B4076E0CC9CD.quest_desc: ["Link it to a Monitor, then set a start and end point to define a safe zone. Targets inside that region are left alone, keeping friendly bases out of the line of fire."]
	quest.6A25B4076E0CC9CD.quest_subtitle: "Marks an area off-limits to your guns"
	quest.6A2D63867E5FDE2A.quest_subtitle: "Decoration Block"
	quest.6A6CEE66F2315D7B.quest_subtitle: "Decoration Block"
	quest.6B4961271FD5583C.quest_subtitle: "Decoration Block"
	quest.6B589BB205485486.quest_subtitle: "Decoration Block"
	quest.6B7188472F6ED6AF.quest_desc: ["Assign this item to a redstone link frequency slot to match any item in that slot, including air."]
	quest.6B8966D7EA9BB5FB.quest_desc: ["Hand cranks with a cogwheel installed. Handy for gear ratios and tight spaces"]
	quest.6BC833A2D916A0DC.quest_desc: ["Docking Connectors link in pairs: extend two toward each other, and once aligned they lock together into a rigid connection - perfect for docking ships or modular builds."]
	quest.6BC833A2D916A0DC.quest_subtitle: "Auto-aligning rigid coupler"
	quest.6C02188DA80AEDAD.quest_subtitle: "Decoration Block"
	quest.6C049540C64342A8.quest_desc: ["Create Slice \\& Dice enables a variety of features to create better compatibility between mostly &aFarmer's Delight&r and &6Create&r. While it is designed to work with &aFarmer's Delight&r, it does work without it and also adds some compatibility features for other mods."]
	quest.6CD96328B7567F46.quest_desc: ["The Mechanical Harvester will harvest all mature crops it comes in contact with while moving forward."]
	quest.6CD96328B7567F46.quest_subtitle: "The Mechanical Harvester is a component used on &3Contraptions&r to harvest crops."
	quest.6CEAED7D28C9A033.quest_desc: ["A decorative panel with a diagonal 'slashed' cut, for adding colour and detail to trains, carriages and stations. Available in all sixteen dye colours."]
	quest.6CEAED7D28C9A033.quest_subtitle: "Decorative train panelling"
	quest.6D03D3B4D83C1840.quest_desc: [
		"Right click the front of a Mechanical Crafter with a Wrench to change the direction it sends items during crafting. "
		""
		"Mechanical Crafters can be automatically filled by Funnels or Hoppers."
		""
		"On the back and sides of Mechanical Crafters, a Wrench can be used to connect or disconnect the inventory of two adjacent crafters. Crafters can share inventories while not participating in the same crafting recipe."
		""
		"Items can also be inserted or removed by hand."
		""
		"Each Mechanical Crafter has an internal gear that can only be powered by adjacent Mechanical Crafters or any size Cogwheel. This means only 1 Mechanical Crafter in a setup needs to be powered by a Cogwheel."
		""
		"When powered by rotational force and either powered with Redstone or all crafter slots are filled, Mechanical Crafters will send their items to adjacent crafters. For a successful recipe, the items must eventually meet in one crafter. Once all of the items reach the final Crafter, they will turn into the product."
	]
	quest.6D03D3B4D83C1840.quest_subtitle: "Mechanical Crafters are machines that can automatically craft items."
	quest.6D3A3A4F218C6E3E.quest_subtitle: "Decoration Block"
	quest.6D53565E445D72D8.quest_subtitle: "Decoration Block"
	quest.6D5FC3B862D27741.quest_desc: ["A netherite-reinforced magnet with the greatest force and reach - the pinnacle of New Age's magnet line."]
	quest.6D5FC3B862D27741.quest_subtitle: "The strongest magnet"
	quest.6DE8ACA4F08C420E.quest_desc: ["Transfer stress capacity from one network to another while keeping the networks separate. Guarantees that the source network will not be affected when the destination network is overstressed."]
	quest.6DFDDCD9C698FB1D.quest_subtitle: "Decoration Block"
	quest.6E0B19BE3664D674.quest_subtitle: "Decoration Block"
	quest.6E2033C9979AEC0B.quest_desc: ["A basic magnet and the start of New Age's magnet line, used to craft stronger magnets and electrical components."]
	quest.6E2033C9979AEC0B.quest_subtitle: "Entry-level magnet"
	quest.6E3CE8CCE59764E6.quest_desc: ["A decorative panel with a diagonal 'slashed' cut, for adding colour and detail to trains, carriages and stations. Available in all sixteen dye colours."]
	quest.6E3CE8CCE59764E6.quest_subtitle: "Decorative train panelling"
	quest.6E4549AB2029BB05.quest_subtitle: "Decoration Block"
	quest.6E4C87C949D196E1.quest_desc: ["Crush a Feather or any Arror between two Crushing Wheels"]
	quest.6E5EE3BD432FB23E.quest_desc: ["Electrical Connectors allows you to connect a device to other blocks with wirings"]
	quest.6E5EE3BD432FB23E.quest_subtitle: "Wire devices into your power grid"
	quest.6E6E53606F529491.quest_desc: ["A cylindrical, boiler-shaped block for building the body of steam locomotives. Comes in all sixteen dye colours to match your livery."]
	quest.6E6E53606F529491.quest_subtitle: "Decorative boiler block"
	quest.6E8C6A4A07957E5A.quest_desc: [
		"When Rotational Force is given to the Hose Pully, it can extend the hose infinitely. Reversing the Rotational Force will retract the hose back to the block. The hose of the Hose Pully must be extended by at least one block before it can function."
		""
		"A Fluid Pump is required for the hose to drain or flood liquids."
		""
		"-If a fluid is pumped out, it will drain a body of liquid down to the level of the hose. If multiple hose pulleys draw from the same source, it will effectively expedite the drainage process, provided that the pipe's capacity is maintained."
		""
		"-If a fluid is pumped in, it will flood a room of any size, with the hose marking the highest point of flooding."
	]
	quest.6E8C6A4A07957E5A.quest_subtitle: "The Hose Pulley lets down a hose that can drain bodies of liquids."
	quest.6F6527213B0E0620.quest_subtitle: "Decoration Block"
	quest.6F79A45B3B7C7922.quest_subtitle: "Decoration Block"
	quest.6F8DCE5AA76BBABA.quest_desc: ["A pressed sheet of zinc, used as a crafting ingredient for several electrical components."]
	quest.6F8DCE5AA76BBABA.quest_subtitle: "Crafting component."
	quest.6FE2FE40C2F60183.quest_desc: ["Relays rotation in two directions independently."]
	quest.6FFD93A35CC9EC5C.quest_subtitle: "Decoration Block"
	quest.700F7947C77D45D5.quest_subtitle: "Decoration Block"
	quest.70560303EAB0C0B2.quest_desc: ["Placed under a Cannon Mount and linked to the network, it automatically adjusts the cannon's pitch (up-and-down aim) to line up with the selected target."]
	quest.70560303EAB0C0B2.quest_subtitle: "Controls the elevation of a cannon mount"
	quest.705C8ABB2339A5D5.quest_desc: ["Hold right-click to grab the Steering Wheel and move your mouse to turn it, giving precise rotational output. Comparators can read its angle or whether it is in use."]
	quest.705C8ABB2339A5D5.quest_subtitle: "Hands-on rotational control"
	quest.705E20D143863DAB.quest_subtitle: "Decoration Block"
	quest.707D6AB682807C7A.quest_subtitle: "Decoration Block"
	quest.70B2D00A76DCDB5C.quest_desc: ["A flexible diode that can output precisely timed redstone pulses according to a configured sequence"]
	quest.70F9706FF1886CB2.quest_desc: ["The Reactor Fuel Inserter allows you to insert fuel into the reactor."]
	quest.70F9706FF1886CB2.quest_subtitle: "Feeds fuel into the reactor"
	quest.7157002074776C07.quest_desc: ["Give the Navigation Table a Navigation Item and it emits a Redstone signal pointing toward that destination - the basis for autopilots and heading indicators."]
	quest.7157002074776C07.quest_subtitle: "Points the way to a destination"
	quest.716864737F3D10B2.quest_desc: ["These barrels turn the Flintlock into a blunderbuss, firing a short-range spread of shot. The long version trades some spread for extra reach."]
	quest.716864737F3D10B2.quest_subtitle: "Flintlock spread barrels"
	quest.7191A49B5D5BF7B7.quest_desc: ["Provides directional thrust when powered by Redstone and fuelled with Turpentine. Straightforward propulsion for getting a contraption moving."]
	quest.7191A49B5D5BF7B7.quest_subtitle: "Fuel-burning directional thruster"
	quest.719218CEA358D540.quest_desc: ["Right-click the ground to place a Train Track facing away from you. Train tracks can be placed in eight different directions corresponding to the closest of the four cardinal direction and 45° increments in between. Tracks may also be placed on the side of blocks that have no blocks immediately above them. These tracks will have a 45° vertical incline. Break tracks using any pickaxe or by right clicking with a wrench while sneaking. Breaking with any other item will cause a track to disappear."]
	quest.719218CEA358D540.quest_subtitle: "Train Tracks are special blocks used to support Trains."
	quest.71FB3EA8CB37A038.quest_desc: ["A consumable item applied to Blaze Burners to enable them to burn liquid fuels, e.g. bioethanol or seed oil."]
	quest.71FB3EA8CB37A038.quest_subtitle: "Feeds liquid fuel to a Blaze Burner"
	quest.720FCE76832BE25A.quest_subtitle: "Decoration Block"
	quest.72237232F1B2318E.quest_desc: ["A classic peaked Conductor's Cap worn as a hat. Conductors are a signature feature of Steam 'n' Rails - and the cap comes in every colour."]
	quest.72237232F1B2318E.quest_subtitle: "Wearable conductor's hat"
	quest.723479C71262BA85.quest_desc: ["A decorative panel with a diagonal 'slashed' cut, for adding colour and detail to trains, carriages and stations. Available in all sixteen dye colours."]
	quest.723479C71262BA85.quest_subtitle: "Decorative train panelling"
	quest.727968EAA2864242.quest_desc: ["Right click a Ghast with an empty Chunk Loader to capture it."]
	quest.72A6685CACCD207B.quest_desc: ["Gatling Rounds feed the spinning barrels. The Piercing variant trades some impact for the ability to bore through armour."]
	quest.72A6685CACCD207B.quest_subtitle: "Ammunition for the Gatling"
	quest.7322A19FDA5B78E1.quest_desc: ["The Valve Handle functions much like the Hand Crank, though the amount and direction it rotates with one use can be adjusted in its Value Settings Screen."]
	quest.732D1A96512F2BFD.quest_desc: [
		"The Steam Engine is a block that provides Rotational Force. It outputs the highest Stress Unit (SU) capacity of all the survival-mode power-generating blocks. It converts the pressure caused by heating Water in a Fluid Tank into Rotational Force, allowing for large scale item production and multiple &3Contraptions&r to be powered."
		""
		"Steam Engines use heated Water for power and are placed on Fluid Tanks, which are then used as a boiler. A Shaft can be used on the engine to create a kinetic output. The direction of said output can be adjusted through the Value Settings on the side of the engine."
		""
		"Increasing the total power generated requires that one or more of the three characteristics (heat, size, water) of the Fluid Tank boiler be increased. This will increase the boiler's level to the lowest level reached by any of the three characteristics, increasing the maximum amount of SU Steam Engines are capable of generating from the boiler. A single Steam Engine can only extract up to 16,384 SU (The equivalent of 1 boiler level). To combat this, multiple Steam Engines can be attached to a single boiler to extract more power; however, this will not increase the total power generated by the boiler."
		""
		""
		"The tank size is the basic characteristic of a steam boiler. The required dimensions are affected by the heat supplied. For a passive steam engine (level 0) the boiler must be a 2x2 fluid tank of preferably one block height (making it any higher will be a waste of resources). For an active steam engine (level 1 or higher) the boiler must have 4 blocks per heat level. For example, a level 1 boiler must have a tank made of at least 4 fluid tank blocks, a level 9 boiler must be made of at least 36 blocks and a level 18 boiler (maximum achievable) must be at least made of 72 blocks."
		""
		""
		"A steam boiler requires heat to function. Heat sources must be placed underneath the boiler tank in order to affect it. All passive heat sources generate the same amount of heat. More heat can be generated with the help of Blaze Burners, which produce varying amounts of heat depending on their state."
	]
	quest.732D1A96512F2BFD.quest_subtitle: "The Steam Engine is a block that provides Rotational Force."
	quest.734E4CFD2426E4F4.quest_desc: ["Heat Pipes can be used to spread heat around."]
	quest.734E4CFD2426E4F4.quest_subtitle: "Carries heat between blocks"
	quest.73D645ADC3165165.quest_desc: [
		""
		"[ { \"text\": \"Create Power Loader\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"727968EAA2864242\" } } ]"
	]
	quest.73DA0AB42872978D.quest_desc: ["Select a Train Track then place the Switch nearby to direct trains passing over its marker. Use it to send the route right, or sneak-use to send it left."]
	quest.73DA0AB42872978D.quest_subtitle: "Redstone-controlled track junction"
	quest.73F308184A32F95D.quest_desc: [
		""
		"[ { \"text\": \"Create Crafts and Additions\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"43E4EE94BB396A7C\" } } ]"
	]
	quest.7416CB3F773510C6.quest_desc: ["A decorative panel with a diagonal 'slashed' cut, for adding colour and detail to trains, carriages and stations. Available in all sixteen dye colours."]
	quest.7416CB3F773510C6.quest_subtitle: "Decorative train panelling"
	quest.7417FEE6B105B0E2.quest_subtitle: "Decoration Block"
	quest.743C84D1D94C5670.quest_subtitle: "The Brass Funnel is a block that can extract or insert items into inventories"
	quest.745A055A8E60444F.quest_desc: [
		"The Entity Block is at the moment bugged and it will crush your world if you build it and &nuse&r it."
		""
		"&mRight click on a fluid tank with a thermostat to convert it into a Fractional Distillation Tower."
		"&mUsed to convert crude oil into various resources. Diesel can fuel your blaze burners.&r &mKerosene can be converted into Ethylene, which can be turned into Polymers, a new material used to craft high-tier guns.&r&r"
	]
	quest.745A055A8E60444F.quest_subtitle: "&l&n&4BUGGED, DON'T BUILD IT&r&r&r"
	quest.745A055A8E60444F.title: "Fractional Distillation Tower"
	quest.74A7B0B9D9EB1B23.quest_desc: [
		"The lamp can be activated with a redstone pulse. They will continue to emit a redstone signal afterwards. If multiple Rose Quartz Lamps are adjacent, activating one lamp will turn off other lamps up to 16 blocks away. They will emit a Redstone Comparator signal depending on how far away the comparator is to the active lamp."
		""
		"Lamps can also be toggled manually with a Wrench. Using this, multiple adjacent lamps can be on at once."
	]
	quest.74AD9C3B54878FDB.quest_desc: ["A Propeller Bearing that tries to keep its propeller pointed upright, ideal for helicopters and stabilising top-heavy builds. A Redstone signal resets its tilt to level."]
	quest.74AD9C3B54878FDB.quest_subtitle: "Self-levelling propeller bearing"
	quest.74C5CD7971637A60.quest_subtitle: "Decoration Block"
	quest.74C6ABAB8291BC3B.quest_desc: ["When powered, extends a redstone pulse for a specified time, much like a Redstone Repeater. The time can be set in its Value Settings Screen accessed by holding right-click. It can be set to extend a signal for 2 ticks up to 60 minutes. The settings can also be copied and pasted onto other extenders or Pulse Repeaters by using a Clipboard."]
	quest.74C8309747174D8C.quest_desc: ["A drum magazine for the Shotgun, holding many more shells so you can keep firing far longer between reloads."]
	quest.74C8309747174D8C.quest_subtitle: "Shotgun capacity upgrade"
	quest.7524EFB1D33B92E0.quest_subtitle: "Decoration Block"
	quest.752D65C71706BDE7.quest_subtitle: "Decoration Block"
	quest.75383CA7EADFA8F5.quest_subtitle: "Decoration Block"
	quest.7540DDBD4DB959BD.quest_subtitle: "Decoration Block"
	quest.756E05D2EDB0D69E.quest_subtitle: "Decoration Block"
	quest.75DDDB65930D90BB.quest_subtitle: "Decoration Block"
	quest.763A7822DE6E05FA.quest_desc: [
		""
		"[ { \"text\": \"Create Big Cannons\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"1C33870BEE8D21BA\" } } ]"
	]
	quest.7655E21D5CFB174C.quest_desc: ["The wolf is summoned by equipping the Mechanical Wolf Link in the Curios Head Slot."]
	quest.768789FEB6EBB8F8.quest_desc: [
		"A Blaze Burner is a heating component that is required for certain Mixing recipes. It can be used for heating Steam Engines, Bulk Smoking, Bulk Smelting, and as a decorative light source."
		""
		"Blaze Burners must have Blazes in them to function. To put a Blaze in an Empty Blaze Burner, right-click on a Blaze while holding an Empty Blaze Burner. Alternatively, an Empty Blaze Burner can be filled by right-clicking on a Blaze Spawner. This method can be repeated without risk of destroying the Blaze Spawner."
		""
		"Right-clicking a Blaze Burner with any item that can be used as Furnace fuel will temporarily put it in a Heated state. Right-clicking a Blaze Burner with a Blaze Cake will temporarily put it in a Super-Heated state."
		""
		"The Blaze inside changes its size and texture depending on the amount of fuel provided, following the phases:"
		""
		"Phase 1 — Smouldering — Does not provide any heat for mixing. This is the default state when placing the Burner or when the fuel runs out."
		"Phase 2 — Heated/Kindled — Enables recipes that require heating. Lasts for the fuel's burn time and provides 1 heating level to Steam Engines per Blaze Burner"
		"Phase 3 — Super-Heated/Seething — Enables every Mixing recipe and provides 2 heating levels to Steam Engines per Blaze Burner. Only achievable using the Blaze Cake. Always lasts for 160 seconds. The Blaze Burner cannot be re-fed during this phase."
	]
	quest.76919513DA354DBC.quest_desc: [
		"The Gearbox can relay rotational power in four horizontal directions. The vertical counterpart, like the normal version, can relay power in four vertical directions. "
		""
		"When receiving input from any input side (sides with a shaft shape), the Gearbox will output/relay &arotational power&r in opposite spin for all of the remaining sides. In another word, when the input is clockwise, the output on the other 3 sides will be anti-clockwise, and vice-versa."
	]
	quest.76919513DA354DBC.quest_subtitle: "The Gearbox is a block used to transfer Rotational power in 4 directions, either horizontally or vertically."
	quest.769EFC34C1F05AFC.quest_subtitle: "Decoration Block"
	quest.76CF45AA7A6A107E.quest_desc: ["Standard Revolver Rounds for everyday use, plus Piercing Rounds that punch through armour and tougher foes."]
	quest.76CF45AA7A6A107E.quest_subtitle: "Ammunition for the Revolver"
	quest.76E15279798C3BBB.quest_subtitle: "Decoration Block"
	quest.7703F0CA1A8AB6F9.quest_desc: ["Andesite Alloy is a material used in Andesite Casing and simple kinetic blocks of Create. Among its many functions, it is an essential ingredient for crafting Shafts and both regular and large Cogwheels. Andesite Alloy is the most basic component construction material in Create."]
	quest.77538A08DA40D357.quest_desc: ["Connect a Large Cogwheel to a Small Cogwheel, allowing you to change the speed of your Contraption "]
	quest.7769B67962F5842E.quest_desc: ["[ { \"text\": \"Create Steam 'n' Rails\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"632C20063AEF5BE5\" } } ]"]
	quest.77B2C22D776D1B60.quest_desc: ["Connects Forge Energy blocks with low-current wires to transfer power across your build."]
	quest.77B2C22D776D1B60.quest_subtitle: "Low-current power node"
	quest.77C016A83AD73399.quest_desc: ["Allows the player to controll a Brass Drone"]
	quest.77C3D285E52CCA0E.quest_desc: [""]
	quest.77C3D285E52CCA0E.quest_subtitle: "Table Cloths can be used to sell items to other players."
	quest.77DB80B70AA648B9.quest_subtitle: "Decoration Block"
	quest.783A9F94A33BDA01.quest_desc: ["Mounted Crossbow gives ranged support"]
	quest.787735334C76F312.quest_subtitle: "Decoration Block"
	quest.78E10AA674653EFE.quest_desc: ["Activate a Waystone to add it to your network, then teleport between discovered Waystones - a fast way to get between your airfields and bases."]
	quest.78E10AA674653EFE.quest_subtitle: "Fast-travel anchor point"
	quest.7917E75BBA3F0614.quest_desc: [
		"First, use the display link on a Display Block to link it. Then place it on the Source Block that will be read from. Though it will link to any block, not every block can act as a display or source. "
		""
		"Right click the link to access its interface. Additional labels can be added to the output text through this interface. Some sources provide multiple options for formatting the text. Once the interface settings are accepted, the green light on the display link will start blinking, indicating transmission of information to the display blocks."
	]
	quest.7917E75BBA3F0614.quest_subtitle: "A Display Link is used to get information from a block and send it to blocks that can display it."
	quest.791D998A97FB6138.quest_desc: [""]
	quest.791D998A97FB6138.quest_subtitle: "Crafting component."
	quest.7939BC69EF3BB4B4.quest_subtitle: "Decoration Block"
	quest.794C0CD2DA500874.quest_desc: ["The Portable Engine generates rotational force by burning fuel, giving your contraption power without a fixed kinetic hookup. It can run either direction and be fed fuel automatically."]
	quest.794C0CD2DA500874.quest_subtitle: "Compact onboard power source"
	quest.794ED2661B8E4621.quest_desc: ["Allows the player to fly, move and swim faster. Works with water and fuel."]
	quest.79820F087CB4B43D.quest_subtitle: "Decoration Block"
	quest.7993CF479F55FB32.quest_subtitle: "Decoration Block"
	quest.79E01F6906DA951A.quest_desc: ["Automatically refills gadgets and armor that use water."]
	quest.79ECE3A166EC3503.quest_desc: [
		""
		"[ { \"text\": \"Create New Age\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"4FDF302D1E8EFA59\" } } ]"
	]
	quest.7A5892B422756F95.quest_desc: ["Use a deployer to put the Bumper on the chassis."]
	quest.7A9EC265305FC6D1.quest_desc: ["Create: Gunsmithing lets you assemble modular firearms from frames, chambers, barrels and engines. Craft a weapon, load it with the right ammunition, and bolt on attachments to reshape how it fires."]
	quest.7A9EC265305FC6D1.quest_subtitle: "Build your own firearms, piece by piece"
	quest.7AA7094E591A373B.quest_desc: ["A gearbox with all 4 sides spinning in the same direction"]
	quest.7AAB0FDFAB0979F3.quest_desc: ["The Steam Whistle can be placed on Fluid Tanks. The Tank must have a heat source beneath it for the Whistle to function. It can be activated by Redstone. Right click with a Whistle in hand to extend it. The Whistle can be extended up to 12 times, playing up to 13 notes per octave. Use a Wrench to change the octave; 3 octaves are available. Engineer's Goggles can be used to view the current note."]
	quest.7AAB0FDFAB0979F3.quest_subtitle: "The Steam Whistle is a musical block activated by redstone."
	quest.7B1ED64FF75CBD29.quest_subtitle: "Decoration Block"
	quest.7B58F7BBFA93F655.quest_subtitle: "Decoration Block"
	quest.7B6E46D719CFB570.quest_desc: ["An empty spool for handling wires. Right-click two linked connectors to remove their wire and wind it back up."]
	quest.7B6E46D719CFB570.quest_subtitle: "Reusable wire spool"
	quest.7B92C9925325A603.quest_subtitle: "Decoration Block"
	quest.7B9EE1A765FB668A.quest_desc: ["[ { \"text\": \"Engineer's Goggles\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"3A2633B6030BBC52\" } } ]"]
	quest.7BD3E1592E06D507.quest_desc: ["Place the Radar Bearing, attach a Radar Receiver in front of it, then add Dishes or Plates. Power the bearing with rotational force to spin the assembly and start scanning."]
	quest.7BD3E1592E06D507.quest_subtitle: "Spins the radar to sweep the area"
	quest.7BF2DDD8FDAFECE4.quest_subtitle: "Decoration Block"
	quest.7C074B5E2A0EAA63.quest_desc: [
		"To assemble a Train, the train must have at least one set of controls that face forward relative to the Train Station the train is created at. If a non-player conductor is desired, a Blaze Burner or Seat must be placed directly behind the controls."
		""
		"On a Train, Train Controls can be right clicked to take control of the Train. The player's ordinary movement options will affect the Train instead. Use the controls again or sneak to stop. Hold left or right at a fork to choose a path. Use the scroll wheel to adjust maximum speed. Hold jump to approach and align at a Station. If a Steam Whistle is attached, press the sprint key to blow it."
	]
	quest.7C074B5E2A0EAA63.quest_subtitle: "Train Controls are required in the creation of Trains."
	quest.7C0D7726F7350FCB.quest_subtitle: "Decoration Block"
	quest.7C4AC46B25F36F42.quest_desc: ["Most of the descriptions on this quest page are taken from create.fandom.com under the CC BY-SA license"]
	quest.7C5E7060FAB3A110.quest_desc: [
		"Create: Copycats+ is a Minecraft addon for the Create that brings together the features of several preceding “copycat” mods into a single, unified package. "
		""
		"It adds a wide range of customizable decorative blocks and items—known as \"copycats\"—that take on the textures and properties of other blocks while providing new shapes and functionalities."
	]
	quest.7C8B60D396CDAC80.quest_desc: ["The core component of any artillery piece. Must be crafted with care—imperfections can lead to catastrophic failure when fired!"]
	quest.7C95B87737AE885F.quest_subtitle: "Decoration Block"
	quest.7D795E76018CDBD5.quest_desc: ["Use a deployer to put the Exhaust Pipe on the chassis."]
	quest.7D8A6959DA3F5E94.quest_subtitle: "Decoration Block"
	quest.7DF6FD2B69C8F93F.quest_desc: ["A sturdy platform that allows cannons to pivot and aim. Provides stability while enabling precise adjustments for elevation and direction"]
	quest.7E1BCD3A6AE20348.quest_subtitle: "Decoration Block"
	quest.7E2188DA059C8005.quest_desc: [
		"Redstone links transfer redstone signals across long distances, keeping their redstone signal strength. When powered, a sending link causes receiving Redstone Links with matching frequency to emit redstone. The signal strength is kept. Receivers will output the strongest redstone strength received from sending links."
		""
		"The frequency can be changed by right clicking the link's slots with an item or block. Assign an item or block to at least one of the two frequency slots, and the redstone link will only send or receive signals to or from links with matching frequency slots."
	]
	quest.7E2188DA059C8005.quest_subtitle: "The Redstone Link is used to send and receive redstone signals to other links."
	quest.7E7202497F167C39.quest_desc: ["Like the burner, the Steam Vent fills a balloon - but with steam, and it needs heat, water and boiler space just like a Steam Engine. Powered with Redstone, multiple vents can share one balloon."]
	quest.7E7202497F167C39.quest_subtitle: "Steam-powered balloon lift"
	quest.7E9F178C0647E20C.quest_desc: [
		"Create Dynamic Village is an addon for Create that adds four new professions for villagers:"
		""
		"- &6&nMechanical Engineer&r&r -- Buys \\& sells Create contraption parts"
		""
		"- &6&nHydraulic Engineer&r&r -- Buys \\& sells Create fluid management parts; pipes, pumps, diving gear etc."
		""
		"- &n&6Train Mechanic&r&r -- Buys \\& sells Create train system parts"
		""
		"- &n&6Miner&r&r -- Buys \\& sells Create mining equipment, as well as minerals/metals"
	]
	quest.7EB06EEB27C8DAD6.quest_subtitle: "Decoration Block"
	quest.7EB37F2B215C10DC.quest_subtitle: "Decoration Block"
	quest.7EBF1BA8E3CD24D5.quest_subtitle: "Decoration Block"
	quest.7EC1397C6E9D7E2A.quest_desc: ["A machine used to tap infinite fluid reservoirs (instead of ore veins). When placed in a chunk containing an infinite fluid vein, and connected to rotational power and piping, it continuously generates fluid. "]
	quest.7ECADAFE1A8EE5DF.quest_subtitle: "Decoration Block"
	quest.7EEA09630CE62CE6.quest_desc: ["Right‑click while holding it to scan chunks, revealing where you can place extraction machinery"]
	quest.7EEA09630CE62CE6.quest_subtitle: "Ore Vein Finder is a tool used for finding infinite fluid and ore veins in Create Ore Excavation add-on."
	quest.7EF33147EAB0130A.quest_desc: ["The Swivel Bearing attaches to the block in front of it and assembles a glued group into a Simulated Contraption when powered. Rotation passes straight through it, and Redstone can unlock it to spin freely."]
	quest.7EF33147EAB0130A.quest_subtitle: "Rotating mount for simulated builds"
	quest.7F121F8D77B8FBA0.quest_subtitle: "Decoration Block"
	quest.7F5D32DA7E8D094F.quest_desc: ["[ { \"text\": \"Clutch\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"35639D4A6DDF6FF9\" } } ]"]
	quest.7FB9E9293C962C34.quest_subtitle: "Decoration Block"
	quest.7FBF4F777DFF824A.quest_desc: ["An upgraded Solar Heating Plate that captures more daylight, producing heat faster than the basic version."]
	quest.7FBF4F777DFF824A.quest_subtitle: "Stronger solar heat collector"
	quest.7FEAE5D507495637.quest_desc: ["The Gyroscope works to keep a contraption level and stable, resisting unwanted roll and pitch. Engineer's goggles show its current stability."]
	quest.7FEAE5D507495637.quest_subtitle: "Automatic stabiliser block"
