	quest.0D158BAE5A38798A.quest_desc: ["Allows the player to fly, move and swim faster. Works with water"]
	quest.0D2A68789BF0E3E2.quest_subtitle: "Decoration Block"
	quest.0D64DF0EB98C9690.quest_subtitle: "Decoration Block"
	quest.0D66BC7C5944593E.quest_subtitle: "Decoration Block"
	quest.0D84377B8557480E.quest_desc: ["Right-click a Simulated Contraption with the Diagram to open a visual breakdown of the forces acting on it - lift, thrust, weight and more - so you can work out why it won't fly right."]
	quest.0D84377B8557480E.quest_subtitle: "Inspect the forces on your craft"
	quest.0DCDD36966636D1E.quest_subtitle: "Decoration Block"
	quest.0DDFA97B2CCEC0B5.quest_subtitle: "Decoration Block"
	quest.0DEEA086C9B29217.quest_desc: ["Create Furnitures is a mod that enhances your Minecraft experience by adding industrial-style furniture! If you're a fan of the Create mod, this mod perfectly complements your builds by introducing tables, chairs, and stools in various materials and colors. Perfect for decorating workshops, dining rooms, or cozy steampunk corners!"]
	quest.0DFB345FC3022432.quest_desc: [
		"[ { \"text\": \"Create Interiors\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"4581823B7CB90873\" } } ]"
		""
		""
		"Yes, you have to make all the furniture in every color :)"
	]
	quest.0DFB345FC3022432.title: "Create Interiors"
	quest.0E5FC39E6C71A872.quest_desc: [
		"A &6&oshaft&r&r can be used to connect two mechanical components such that the rotation of one rotates the other."
		""
		"When two mechanical components are connected to each other by a shaft, any &2rotational force&r provided to either component will be provided to the other component in addition to that &dspeed&r. As such, if both components provide stress, this can cause the machine to become overstressed."
	]
	quest.0E5FC39E6C71A872.quest_subtitle: "The shaft is a basic mechanical component in Create. "
	quest.0E5FC39E6C71A872.title: "&l&6Shaft"
	quest.0E78B1230C3C72FF.quest_desc: ["A precise, space-saving lever: right-click and drag to set its analog Redstone output. A Wrench inverts the signal, making it ideal as a throttle for engines and burners."]
	quest.0E78B1230C3C72FF.quest_subtitle: "Compact analog Redstone source"
	quest.0EE2E9EB6DC01E34.quest_subtitle: "The Precision Mechanism is one of many Crafting Components."
	quest.0F350D71442844CC.quest_subtitle: "Decoration Block"
	quest.0F38A68481CF104F.quest_subtitle: "Decoration Block"
	quest.0FEE05D17B88BAA0.quest_subtitle: "Decoration Block"
	quest.1017233885BB0793.quest_desc: ["Using brass you are able to upgrade your copper backtank to a jetpack, using the pressurized air inside to propel yourself through the air."]
	quest.103D729D5E2D57CA.quest_subtitle: "Decoration Block"
	quest.104F5EA4EB94E7BC.quest_desc: ["A larger Bayonet for heavy weapons, adding a powerful melee strike to launchers and the like."]
	quest.104F5EA4EB94E7BC.quest_subtitle: "Oversized weapon blade"
	quest.105F557611E5A1B2.quest_subtitle: "Decoration Block"
	quest.106C8ECB590FA10C.quest_desc: ["Mount the Scope on a firearm to aim down sights and zoom in, making long-range shots far easier to land."]
	quest.106C8ECB590FA10C.quest_subtitle: "Weapon attachment for zooming in"
	quest.10D73ECEC48C238F.quest_desc: ["A decorative panel with a diagonal 'slashed' cut, for adding colour and detail to trains, carriages and stations. Available in all sixteen dye colours."]
	quest.10D73ECEC48C238F.quest_subtitle: "Decorative train panelling"
	quest.113E1D3C37C63088.quest_desc: ["Obtained by putting a Gold Sheet in a Rolling Mill."]
	quest.113E1D3C37C63088.quest_subtitle: "Crafting component."
	quest.113EB654AC951E00.quest_subtitle: "Decoration Block"
	quest.1149E806E09A2907.quest_subtitle: "Decoration Block"
	quest.11A671DBEB7F78C9.quest_desc: ["Functions similar to the mechanical press, right click this machine with a template, place a metal/composite sheet underneath it and it will produce parts according to the template. Shift+Right click with an empty hand to remove the attached template."]
	quest.11C4A42A7CF3ECC5.quest_subtitle: "Decoration Block"
	quest.11C71C10990E8731.quest_desc: ["A directional thruster that can also yaw and pitch, vectoring its thrust under Redstone control. Each side has a signal input that tilts it toward that direction; runs on FE energy."]
	quest.11C71C10990E8731.quest_subtitle: "Thruster that aims itself"
	quest.11F75DD040DB17D5.quest_subtitle: "Decoration Block"
	quest.1238442EB5F11C85.quest_subtitle: "Decoration Block"
	quest.134B26C2E1C8A942.quest_subtitle: "Decoration Block"
	quest.135E27A19B935CD7.quest_desc: [
		"Right-click the chain of a Chain Conveyor to set the frogport’s target, then place the frogport. Frogports can be placed up to 4 blocks to the side and down from their target chain."
		""
		"The frogport will only take packages that match its address. The address can be set by right-clicking the placed frogport or in it's UI. "
		""
		"The frogport will only send packages that don’t match its address unless its set to “only send packages” in its UI."
	]
	quest.135E27A19B935CD7.quest_subtitle: "Package Frogports are used to move Cardboard Packages from and to Chain Conveyors."
	quest.13709C8FE062A3E8.quest_subtitle: "Decoration Block"
	quest.13782C30B48A2E4F.quest_desc: ["&cStress&r is the amount of energy mechanical components need to run and is shared across all components that are connected together in a network; it is measured in Stress Units (SU). The &cstress&r requirement or production of a certain component can be seen by looking at it wearing Engineer's Goggles and the total &cstress&r of a network can be measured with a Stressometer."]
	quest.13782C30B48A2E4F.title: "&cStress"
	quest.138A8C0EFBD15ECD.quest_subtitle: "Decoration Block"
	quest.139328F8641818F5.quest_desc: ["Explosive Rockets for the Launcher. The Small Rocket is a lighter charge for faster, lower-yield shots."]
	quest.139328F8641818F5.quest_subtitle: "Ammunition for launchers"
	quest.13A4E7CB941F105C.quest_desc: ["Mounted on a Radar Bearing, the Receiver gathers the signal from the attached Dishes and Plates. Every radar contraption needs exactly one Receiver to work."]
	quest.13A4E7CB941F105C.quest_subtitle: "The core of a radar contraption"
	quest.13EC05BE3F4F7CF4.quest_desc: ["A Semaphore is placed on a pole above a Train Signal and physically shows that signal's current state with a moving arm, so you can read your network at a glance."]
	quest.13EC05BE3F4F7CF4.quest_subtitle: "Visual train signal indicator"
	quest.1407EB3E7053F429.quest_desc: ["A hybrid crafting block that combines both rotational power and electricity to produce advanced items, including magnets and upgraded materials. It will energize items in belts or depots under it."]
	quest.1407EB3E7053F429.quest_subtitle: "Energises items with power and rotation"
	quest.1472CD31A689D536.quest_desc: ["A mechanical breech that securely seals the rear of a cannon. Allows for faster reloading compared to traditional muzzle-loading designs."]
	quest.147FC2959F9FC5F5.quest_desc: [
		"&6Trains&r are &3&3Contraptions&r&r that travel on Train Tracks."
		""
		"Assembly"
		"1) Place the track and right-click it with a station block. Place the station block near the track."
		""
		"2) Right click on the station and select \"Create Train\" to enter assembly mode (blue flag shown on station)."
		""
		"3) Place one or more Train Casings on the track where indicated with blue. The casings will turn into bogeys."
		""
		"4) When assembled, each bogey will automatically become coupled together as part of the train."
		" "
		"5) Place a Train Controls block facing the direction dictated by the station. Place a Seat or Blaze Burner behind the controls for the driver."
		""
		"6) Use Block Attachment Utilities such as Super Glue to connect all parts together (green highlight)."
		""
		"7) When finished, use the Station's interface to attempt to assemble the Train. If a Train fails to assemble, an error will be shown in the Station's interface. Common errors are detailed below."
	]
	quest.147FC2959F9FC5F5.quest_subtitle: "Train Casings are used for locomotive transportation."
	quest.14BF7274FD72C650.quest_subtitle: "Decoration Block"
	quest.1536FAF4533B14B5.quest_desc: ["Vectors its thrust like a Vector Thruster but runs on pumped liquid fuel instead of FE. Pipe fuel into it from below and throttle it with Redstone."]
	quest.1536FAF4533B14B5.quest_subtitle: "Liquid-fuelled vectoring thruster"
	quest.154E9FD4B949BE3B.quest_subtitle: "Decoration Block"
	quest.15BDA3D9B6B28C8E.quest_subtitle: "Decoration Block"
	quest.15DC91086C8F20D4.quest_subtitle: "Decoration Block"
	quest.166E91F5D0498A1C.quest_subtitle: "Decoration Block"
	quest.16A1D6FB8DB6A528.quest_subtitle: "Decoration Block"
	quest.16CCD2BE50B84D2D.quest_desc: ["Tesla Tail delivers electric retaliation"]
	quest.16D59B5EAA220E3B.quest_subtitle: "Decoration Block"
	quest.16DB6ABA82040A72.quest_subtitle: "Decoration Block"
	quest.172BBA1DCEDD6B3A.quest_desc: ["Flexible wirings that carry electrical current across your setup. They enable power transfer between generators, motors, energisers, and other energy devices"]
	quest.172BBA1DCEDD6B3A.quest_subtitle: "Crafting component"
	quest.177C0E37A35A14F4.quest_desc: [
		"When Powered by kinetics:"
		""
		"Starts rotating the attached structure towards the current hour. If an independent second structure exists in front of the first one, it will serve as the minute hand."
		""
		"The Value Settings Screen can be accessed from the side of the block, and can be used to change the order of the hands or switch to a 24-hour reading resembling the Clock item."
	]
	quest.177C0E37A35A14F4.quest_subtitle: "The Clockwork Bearing is an advanced version of the Mechanical Bearing for rotating up to two clock hands according to the current in-game time."
	quest.17D0698D08215065.quest_desc: ["A cylindrical, boiler-shaped block for building the body of steam locomotives. Comes in all sixteen dye colours to match your livery."]
	quest.17D0698D08215065.quest_subtitle: "Decorative boiler block"
	quest.17DC15D630B68361.quest_desc: ["The Chamber Belt feeds the Revolver from an ammo belt, greatly increasing how many rounds it can fire before reloading."]
	quest.17DC15D630B68361.quest_subtitle: "Revolver capacity upgrade"
	quest.17DCE87DC09D628D.quest_desc: ["The entity teleporter can teleport any entity to a entity teleporter receiver.  It uses telejuice as fuel.  To link it to a entity teleporter receiver, use a TP link."]
	quest.17E2FDDC3AF13ED1.quest_subtitle: "Decoration Block"
	quest.17E782AB29435F2A.quest_desc: ["Throw the Rope Connector to attach a rope to a distant anchor, linking it back to a Rope Winch. A quick way to tether to terrain or another contraption."]
	quest.17E782AB29435F2A.quest_subtitle: "Throw a rope to an anchor point"
	quest.182EBAFAD48AA85E.quest_desc: [
		"&n&l&aCreate Evolution&r&r&r is a Create-based modpack where your goal is to build complex machines, kinetic factories, and even massive trains using the power of &n&lCreate 6.0&r&r and its best addons. "
		""
		"You'll start small, but soon you'll be automating farms, powering entire systems, and building beautiful contraptions that move, mine, and craft for you."
	]
	quest.1837076B0EA3C11A.quest_desc: [
		"A Mechanical Belt is a mechanical component that conveys rotation and moves items and entities."
		""
		"Placing a Belt requires at least two &6Shafts&r. Place the Belt by right-clicking on the first shaft and then right clicking the second. Regardless of the length, this only consumes one mechanical belt. Both shafts must face the same direction."
		""
		"A Mechanical Belt can be placed over any number of Shafts arranged horizontally, vertically, or diagonally (45° towards the y axis) in a single line, provided that no obstructions are present and that the total length is no longer than twenty blocks. The Mechanical Belt also require that the two shafts face the same direction."
	]
	quest.18594A0013B696D4.quest_desc: ["Outputs a Redstone signal based on its orientation, emitted downhill by default. Use its value boxes to set the angle of maximum signal - great for auto-levelling."]
	quest.18594A0013B696D4.quest_subtitle: "Reads your tilt and orientation"
	quest.1876601DA32D8FFD.quest_desc: ["Increase the armor and the health of the wolf and gives him fire immunity"]
	quest.187FE6A1129EFDC9.quest_desc: ["High-arcing projectiles meant for indirect fire. Mortar rounds trade velocity for loft, allowing them to strike targets behind cover or atop walls."]
	quest.18DE1971E66D39E8.quest_subtitle: "Decoration Block"
	quest.18DEEA2136F90546.quest_desc: ["You can found blueprints in dungeons"]
	quest.191A2F855396BDCD.quest_desc: ["Automatically refills gadgets and armor that use fuel."]
	quest.197AB0E07A40512F.quest_subtitle: "The Water Wheel is a source of rotational power. It generates Rotational Force when water flows over it."
	quest.19CA43E37C9DFD02.quest_desc: ["A decorative panel with a diagonal 'slashed' cut, for adding colour and detail to trains, carriages and stations. Available in all sixteen dye colours."]
	quest.19CA43E37C9DFD02.quest_subtitle: "Decorative train panelling"
	quest.19F98EEB9FD2AA5A.quest_desc: ["A cylindrical, boiler-shaped block for building the body of steam locomotives. Comes in all sixteen dye colours to match your livery."]
	quest.19F98EEB9FD2AA5A.quest_subtitle: "Decorative boiler block"
	quest.1A39BEF8AE87A47A.quest_desc: ["The Reactor Heat Vent will collect heat from the reactor and distribute it to connected pipes."]
	quest.1A39BEF8AE87A47A.quest_subtitle: "Bleeds heat away from the reactor"
	quest.1A61ABEC34369F47.quest_desc: ["A gearshift that changes rotation direction unless powered"]
	quest.1A7A743DC5970B6D.quest_subtitle: "Decoration Block"
	quest.1A860155658FC9FD.quest_subtitle: "Decoration Block"
	quest.1A8C05A7097D795F.quest_desc: [""]
	quest.1A9E3C04FD1175B0.quest_desc: ["The Boiler Heater acts the same way as a blaze burner, however it uses heat instead of burnable fuel."]
	quest.1A9E3C04FD1175B0.quest_subtitle: "Heats boilers using piped heat"
	quest.1AA59324FF59C543.quest_desc: ["A decorative panel with a diagonal 'slashed' cut, for adding colour and detail to trains, carriages and stations. Available in all sixteen dye colours."]
	quest.1AA59324FF59C543.quest_subtitle: "Decorative train panelling"
	quest.1B04A295850D0F00.quest_subtitle: "The Train Observer is used to detect passing Trains."
	quest.1B46271C2C22D0F4.quest_desc: ["The Splitter Barrel fans the Nailgun's output into several nails per shot, spraying them across a wider arc."]
	quest.1B46271C2C22D0F4.quest_subtitle: "Nailgun barrel upgrade"
	quest.1B65E8BE91A087DA.quest_desc: [
		"After placing a Chain Conveyor, they can be connected to other Chain Conveyors by right-clicking them with a Chain. The selection can be cleared by right-clicking the Chain Conveyor again. "
		""
		"The maximum distance at which chain conveyors can be placed is 32 blocks, can add 8 blocks to the side if it is 32 blocks away."
		""
		"The maximum angle at which chain conveyors can connect with elevation difference is 45°, this allows an approximate ratio of 2 horizontal blocks to one vertical block. the maximum possible straight slope is 30L by 14H center to center."
	]
	quest.1B65E8BE91A087DA.quest_subtitle: "The Chain Conveyor is used to transport Cardboard Packages."
	quest.1B7E32BFF923587C.quest_subtitle: "Decoration Block"
	quest.1C0C32B31CEBFFE7.title: "Placards"
	quest.1C2A78D2E27BB4D4.quest_subtitle: "Decoration Block"
	quest.1C33870BEE8D21BA.quest_desc: ["The lifeblood of any artillery piece. Whether simple stone shots or high-explosive shells, ammunition must be carefully crafted to ensure reliability—and avoid misfires!"]
	quest.1C8376900AE4279D.quest_desc: ["Compact big cannon propellant that can be filled with various levels of more powerful propellant."]
	quest.1CB771DFCD8E6104.quest_subtitle: "Decoration Block"
	quest.1D00D782B8F0B6D6.quest_desc: [
		"The Mechanical Mixer is powered by an internal cogwheel, and will behave as one to any adjacent components, relaying and reversing rotation sideways."
		""
		"The Mixer requires a minimum rotational speed of 30 RPM from its power source to work. Mixers will process ingredients faster the more speed it is given."
		""
		"To work, a Mixer must be placed directly above a Basin, with a 1 block gap. When a valid recipe is inserted by throwing the ingredients in the Mixer, the Mixer will automatically combine the ingredients."
	]
	quest.1D00D782B8F0B6D6.quest_subtitle: "The Mechanical Mixer is a mechanical component that applies Mixing recipes and shapeless Crafting recipes to items in Basins."
	quest.1D197B1919452187.quest_desc: ["A compact Redstone Link that adds wireless redstone to buttons, levers, and linked levers without using extra block space"]
	quest.1D25F4E1ABD9FBC6.quest_desc: ["Obtained by energizing diamond"]
	quest.1D25F4E1ABD9FBC6.quest_subtitle: "Crafting item"
	quest.1D4E2D891761080F.quest_desc: ["Reactor Rods allow the nuclear reaction to take place."]
	quest.1D4E2D891761080F.quest_subtitle: "Holds the fuel that drives fission"
	quest.1DBA8DD396081924.quest_desc: ["The Interfaces must be placed facing each other at 1-2 blocks apart, one on a Contraption with Fluid Tanks and one stationary. A Fluid Pump is required to insert or extract liquid from the Contraption. To pump liquids to another tank, simply connect the stationary interface and the fluid tank with fluid pipes, although pumps are required to move the liquids."]
	quest.1DBA8DD396081924.quest_subtitle: "The Portable Fluid Interface is used to insert or extract from the fluid inventory of a Contraption."
	quest.1DE518F08CA41569.quest_subtitle: "Decoration Block"
	quest.1E01AC22D5903AD1.quest_desc: ["Hand cranks with a cogwheel installed. Handy for gear ratios and tight spaces"]
	quest.1E10DF8C6E1DB362.quest_subtitle: "Decoration Block"
	quest.1E7AEBE54E36EC20.quest_subtitle: "Decoration Block"
	quest.1F36CF5D11E08839.quest_desc: ["Connects Forge Energy blocks with high-current wires, moving far more power than a Small Connector."]
	quest.1F36CF5D11E08839.quest_subtitle: "High-current power node"
	quest.1FA5F057BD19565D.quest_desc: [
		"[ { \"text\": \"Create Deco\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"55F4BB16DB93C01E\" } } ]"
		""
		"Yes, you have to craft all the decorations :)"
	]
	quest.1FDBAB8FCE901BB3.quest_desc: ["A cylindrical, boiler-shaped block for building the body of steam locomotives. Comes in all sixteen dye colours to match your livery."]
	quest.1FDBAB8FCE901BB3.quest_subtitle: "Decorative boiler block"
	quest.1FDBB75ECD39FB24.quest_desc: [
		"The Item Drain can hold up to 1500mb of fluid at a time. A Fluid Pump is needed to extract the fluid."
		""
		"A Basin will automatically deposit output fluids into an Item Drain placed near it."
	]
	quest.1FDBB75ECD39FB24.quest_subtitle: "The Item Drain drains fluid from items such as buckets and bottles inserted onto it."
	quest.200C7DCA8C9775E8.quest_subtitle: "Decoration Block"
	quest.204DC04BB63BE796.quest_subtitle: "Decoration Block"
	quest.2098E696235F3F72.quest_subtitle: "Decoration Block"
	quest.20E81D9330FA1564.quest_desc: ["With a contraption that can fly, the next step is control. The blocks beyond cover steering, sensors and Redstone-link controls for piloting your machine."]
	quest.20E81D9330FA1564.quest_subtitle: "Steer, sense and command your craft"
	quest.212E674A67684837.quest_subtitle: "Decoration Block"
	quest.21495368D43E2A78.quest_subtitle: "Decoration Block"
	quest.215D766150B54B17.quest_desc: ["Holds wire for connecting low-current connectors. Right-click two connectors to string a wire between them while keeping the spool."]
	quest.215D766150B54B17.quest_subtitle: "Stores low-current wire"
	quest.2162DB844DCC7459.quest_desc: ["You can found blueprints in dungeons"]
	quest.218D2983736284D7.quest_desc: [
		"Schematics can be used in the Schematicannon or Deployers. Before use, a Schematic's coordinates must be selected by right clicking and adjusting the position with the controls on screen. Shift right click to open an interface for entering exact Coordinates."
		""
		"Right click two blocks with the Schematic And Quill to select the area to be copied to the schematic. Right click again to name, save, and/or upload the schematic."
		""
		"Saving the Schematic uploads it to the schematics file, allowing the Schematic And Quill to be used again. Save and Upload makes the Schematic And Quill usable in a Schematicannon or Deployer without the need of a Schematic Table."
		""
		"Shift right click to remove the selection. Hold ctrl to highlight a block in midair and Scroll to adjust the distance. Once two blocks are selected, look at the selection's faces and ctrl-scroll to adjust the size."
		""
		"If a Schematic is saved, it can be copied onto an Empty Schematic with a Schematic Table. This can be done across worlds."
	]
	quest.218D2983736284D7.title: "Schematics"
	quest.2190A7DE1035B4A3.quest_desc: ["Right click a Ghast with an empty Chunk Loader to capture it."]
	quest.2199F0DE2FBE29E3.quest_desc: ["Automatically transform Cutting Board recipes that uses knife into Sawing recipes."]
	quest.21A830CC8DAD6566.quest_desc: [
		"Right-click a Train Track, then place the Station within 15 blocks of the track. It can only create Trains if placed on a straight Track, and Bogeys may only be placed on a 3 block long straight track."
		""
		"In the interface, the Station can be named; these names are how non-player conducted Trains will identify stations. A conductor cannot be instructed to navigate to a station that is named the same as the station they are currently at, and will otherwise choose the closest accessible station out of multiple stations with the same name."
		""
		"The name will also show up on a Map if it is used on the station, similarly to Banners."
	]
	quest.21A830CC8DAD6566.quest_subtitle: "Train Stations are used to create, disassemble, and guide Trains."
	quest.21B40BEC30B40491.quest_desc: [
		"While held, funnels prevent the player from accessing inventories, instead placing them. Sneak right clicking with a Funnel places it in input mode."
		""
		"Using a Wrench on the funnel switches it between input and output mode. Redstone can be applied to stop the funnel from inputting or outputting. Right-clicking a funnel on a Mechanical Belt causes it to extend one block forward."
	]
	quest.21B40BEC30B40491.quest_subtitle: "The Andesite Funnel is used to extract or insert materials into inventories, similar in nature to the Brass Funnel."
	quest.21B40BEC30B40491.title: "Funnel"
	quest.21E6582F7CFB0C50.quest_desc: ["A nuclear reactor is a great way to generate large amounts of heat."]
	quest.21E6582F7CFB0C50.quest_subtitle: "Builds the shell of a nuclear reactor"
	quest.220D373752A1C70A.quest_desc: ["The Network Controller is the central block every network is built around. Connect Monitors, Radars and Weapon Networks to it with Data Links, and insert Filter items to control what it can see and target."]
	quest.220D373752A1C70A.quest_subtitle: "The heart of the radar network"
	quest.2224562C0A197981.quest_desc: [
		"&l<< General >>&r"
		"&5&l<< Automation >>&r&r"
		"&3&l<< Decoration >>&r&r"
		"&2&l<< Utilities >>&r&r"
		"&4&l<< Vehicles >>&r&r"
		"&b&lCreate Aeronautics&r&r"
		""
		"&a&lCreate Evolution&r&r"
		""
		"&l&n&4BUGGED, DON'T CRAFT&r&r&r"
	]
	quest.224B05FA6B4DDAC3.quest_subtitle: "Decoration Block"
	quest.22A7A43271207EDE.quest_desc: ["Create a Train with at least 6 Carriages"]
	quest.22AC3C79141AB3FC.quest_desc: ["Obtained by putting an Electrum Sheet in a Rolling Mill."]
	quest.22AC3C79141AB3FC.quest_subtitle: "Crafting component."
	quest.22EADF4D0392DDBF.quest_subtitle: "Decoration Block"
	quest.232BDFE44283C641.quest_desc: ["The top-tier Electric Motor, providing the highest rotational output and stress capacity for demanding machinery."]
	quest.232BDFE44283C641.quest_subtitle: "The most powerful electric motor"
	quest.23333F57CC56FE69.quest_desc: ["A machine that converts electrical energy back into rotational force, allowing it to power Create machinery using electricity."]
	quest.23333F57CC56FE69.quest_subtitle: "Turns electricity back into rotation"
	quest.23A9A2D399A7BF94.quest_desc: [
		"The Elevator Pulley moves much like the Rope Pulley and shares certain functionalities. Unlike the Rope Pulley, it can phase through blocks, and will not turn back into blocks unless the Pulley is right-clicked."
		""
		"An Elevator Pulley requires a single horizontal Redstone Contact to be on the contraption in order to assemble. If more than one is added, the Elevator will not assemble. If either of these conditions are not met, a corresponding error message will be displayed while looking at the Elevator Pulley."
	]
	quest.23A9A2D399A7BF94.quest_subtitle: "An Elevator Pulley is a Contraption useful for creating multi-floor elevators easily."
	quest.2479F1DB0C7B4227.quest_subtitle: "Decoration Block"
	quest.24CFA0022432887E.quest_desc: [
		"When placed by the player, the Threshold Switch will attempt to orient itself toward an adjacent inventory. If multiple or no inventories are present, the Threshold Switch may orient itself toward the player and can be adjusted as normal using the Wrench. At present, it cannot be oriented vertically."
		""
		"Item thresholds can be set to determine when the redstone signal turns on or off. When the Switch is first placed, it stays off until it reaches 75% inventory, then stays on until it reaches 25% inventory."
		""
		"The chest icon represents how full the inventory is, as well as the current signal state (on/off) depending on which lane the chest icon is in. The arrows represent inventory thresholds, illustrated by the chest icon switching lanes upon reaching the arrow."
		""
		"The signal can be inverted by clicking the button showing two opposing arrows next to the lower threshold bar."
	]
	quest.24CFA0022432887E.quest_subtitle: "The Threshold Switch measures how full an inventory is and can emit a Redstone signal at adjustable thresholds."
	quest.24DDED464AE48E05.quest_subtitle: "Reverses outgoing Rotational Force when a Redstone signal is applied."
	quest.24EF403EFD9364EA.quest_subtitle: "Decoration Block"
	quest.2580602D7B567F11.quest_desc: [""]
	quest.25B581A958F22442.quest_desc: ["The Optical Sensor fires its own beam and emits a Redstone signal when a block obstructs it, with strength based on how close that block is - handy as an altimeter or proximity sensor."]
	quest.25B581A958F22442.quest_subtitle: "Detects blocks in its line of sight"
	quest.25F85A44A7263CE2.quest_subtitle: "Decoration Block"
	quest.261ABBDC3DABD8B3.quest_desc: ["A clutch that is only coupled if the input spins in the correct direction as configured"]
	quest.266333887C50549A.quest_subtitle: "Decoration Block"
	quest.267D46D6C7A4135D.quest_desc: ["Use the Data Link to connect components: radars to monitors, controllers to mounts, or whole networks together. Blue links mark a Radar Network, red links a Weapon Network."]
	quest.267D46D6C7A4135D.quest_subtitle: "Wires the radar network together"
	quest.26FC1ECA5BD96A5A.quest_subtitle: "Decoration Block"
	quest.2714522D47F8DF76.quest_subtitle: "Decoration Block"
	quest.27501BB6D880313F.quest_subtitle: "Decoration Block"
	quest.27C77E7A13ADCD22.quest_desc: ["An upgraded Electric Motor with more rotational force and stress capacity than the Basic Motor."]
	quest.27C77E7A13ADCD22.quest_subtitle: "Stronger electric motor"
	quest.27D967F82EA5FCB6.quest_desc: ["The Shotgun fires Shotgun Rounds in a wide spread, devastating up close. Drums, pumps and assorted barrels change its capacity, reload speed and spread."]
	quest.27D967F82EA5FCB6.quest_subtitle: "Close-range spread of pellets"
	quest.28051E5A4E16EEB3.quest_subtitle: "Decoration Block"
	quest.28F474CD6C235765.quest_desc: ["A decorative panel with a diagonal 'slashed' cut, for adding colour and detail to trains, carriages and stations. Available in all sixteen dye colours."]
	quest.28F474CD6C235765.quest_subtitle: "Decorative train panelling"
	quest.295355BB9EAD84CE.quest_subtitle: "Decoration Block"
	quest.297482217403729E.quest_desc: ["The Fire Controller emits a Redstone signal the moment its linked Cannon Mount is correctly aligned with the target, letting you trigger firing automatically."]
	quest.297482217403729E.quest_subtitle: "Pulls the trigger when on target"
	quest.297D9D3AFF54F578.quest_subtitle: "Decoration Block"
	quest.2A1672C12095B77D.quest_desc: ["When powered, emits one short redstone pulse after a specified delay. The delay can be set in its Value Settings Screen accessed by holding right-click. It can be set to delay from 2 ticks to 60 minutes. The delay can also be copied and pasted onto other repeaters or Pulse Extenders by using a Clipboard."]
	quest.2A1672C12095B77D.quest_subtitle: "Sends a pulse after delaying for a specified time."
	quest.2A404708E175235F.quest_desc: [
		"Fluids can be stored and extracted from fluid tanks via Fluid Pipe. The fluid pipes can be placed on any face of the fluid tank: top, bottom, or sides. The window of a tank can be toggled with a Wrench."
		""
		"The direction of flow in the fluid pipe indicates whether fluids will be put into the tank or extracted from the tank; if fluid is flowing towards the tank, the fluid will be stored in the tank. Likewise, if a fluid pipe is flowing away from the tank (via Mechanical Pump), then fluid from the tank will be extracted into that pipe."
	]
	quest.2A404708E175235F.quest_subtitle: "The Fluid Tank is a fluid storage mechanism that can store up to 8 buckets of fluid per block."
	quest.2A551BE1F400D395.quest_desc: ["Powered by rotation and connected to Ballast Tanks by pipes, the Ballast Vent manages their water to dive or surface. It must touch the sea; reverse the rotation to drain water back out."]
	quest.2A551BE1F400D395.quest_subtitle: "Pumps water in and out of ballast"
	quest.2A633229781DDBFC.quest_desc: ["Fill Ballast Tanks with water to sink and empty them to rise. The more tanks, the more weight they can drive up or down - a heavy sub needs plenty of them."]
	quest.2A633229781DDBFC.quest_subtitle: "Lets a submarine rise and sink"
	quest.2A6ECCE28B9C64FB.quest_desc: ["An aerial brass companion that follows the player if they hava a controller."]
	quest.2AD699385AFD7EC6.quest_desc: ["The Flintlock is the starting firearm, loaded with Paper Cartridges. Slow to reload but cheap to make, it is the base for many barrel and chamber upgrades."]
	quest.2AD699385AFD7EC6.quest_subtitle: "A simple single-shot black-powder pistol"
	quest.2ADDA74C73C08DB2.quest_desc: ["A gearbox where the rotation direction of all 4 sides are independently configurable"]
	quest.2AF85A5EE9A8CCBA.quest_desc: ["A clutch that is only coupled if the input RPM is faster than a configurable threshold"]
	quest.2B034CFAB4E61883.quest_desc: ["Spreading barrels widen the shot pattern, blanketing a larger area up close at the cost of range."]
	quest.2B034CFAB4E61883.quest_subtitle: "Shotgun spread upgrade"
	quest.2B3A70E34CB0CE21.quest_desc: ["Automatically refills gadgets and armor that use fuel."]
	quest.2B66C393EA75E762.quest_desc: ["The pocket dimension remote sends players to a small room in a custom dimension made for testing or storing machines or blocks."]
	quest.2B78716AFA762871.quest_subtitle: "Decoration Block"
	quest.2B860A075CE180C0.quest_desc: ["The strongest Energiser, charging items at the highest speed for large-scale overcharged-material production."]
	quest.2B860A075CE180C0.quest_subtitle: "Top-tier energiser"
	quest.2BAB0966D120FD5B.quest_subtitle: "Decoration Block"
	quest.2BCD965B53AA7702.quest_subtitle: "Decoration Block"
	quest.2C1CBD078BDBA583.quest_desc: ["The lever emits a redstone signal with an adjustable strength. Right click to make it higher, shift right click to make it lower. The current signal strength can be viewed by looking at the lever while wearing Engineer's Goggles."]
	quest.2C1CBD078BDBA583.quest_subtitle: "The Analog Lever is used to emit a variable signal via player input."
	quest.2C249B79E1B80CBB.quest_desc: ["Right-click on a receiver to set the coordinates."]
	quest.2C585F7EFC9B3380.quest_desc: ["Pull the pin and throw: the Frag Grenade detonates after a short fuse, scattering shrapnel over a wide area."]
	quest.2C585F7EFC9B3380.quest_subtitle: "Throwable explosive"
	quest.2CD70FCC8B119D7A.quest_desc: ["The Brown arrow symbols on the pump indicate the direction of flow. The flow direction can be changed by using a Wrench. When a wrench is used, the entire valve will appear to have rotated 180 degrees. The brown directional arrows will appear on the other side of the pump's gear."]
	quest.2CD70FCC8B119D7A.quest_subtitle: "Mechanical Pumps will move fluid in only one direction at a time."
	quest.2CF12EE122D19969.quest_desc: ["Detects the angle to nearby Redstone Links: a Link straight ahead gives full signal, while shallower angles give weaker output - useful for homing and alignment."]
	quest.2CF12EE122D19969.quest_subtitle: "Senses the bearing to a Redstone Link"
	quest.2D120A624CB6E71F.quest_subtitle: "Decoration Block"
	quest.2D48935A2672EB8B.quest_desc: ["The Blazegun burns fuel to throw a continuous jet of flame at close range, setting everything in its path alight."]
	quest.2D48935A2672EB8B.quest_subtitle: "Sprays a stream of fire"
	quest.2D5881A96D74E6CE.quest_subtitle: "Decoration Block"
	quest.2D690C364D0A6EBB.quest_desc: ["The Monitor shows detected targets on a radar screen. Link it to a Network Controller with a Data Link, then click targets on the screen for your weapons to aim at."]
	quest.2D690C364D0A6EBB.quest_subtitle: "Displays everything the radar detects"
	quest.2D70F503EA6F2994.quest_desc: ["Pre-built propellers you can mount straight onto a Propeller Bearing. Both spin up into thrust - the more sail area, the better they pull."]
	quest.2D70F503EA6F2994.quest_subtitle: "Ready-made propeller blades"
	quest.2DDEE427631057EE.quest_subtitle: "Decoration Block"
	quest.2E04E637DF99BB5A.quest_subtitle: "Decoration Block"
	quest.2E2AE972B1AABC41.quest_subtitle: "Decoration Block"
	quest.2E8B8DBE61162084.quest_desc: [
		"They can be filtered to only allow certain items through, and be stopped with a redstone signal. Unlike funnels, they can insert and extract at the same time, but can only function vertically."
		""
		"When directly below an inventory, the Filter slot doubles as a Value Settings diode, much like the Brass Funnel. The Chute can be adjusted to extract up to or exactly a set amount of items. The Value Settings of a Smart Chute will be saved even when the inventory above is destroyed, though this has no effect on the Chute's behavior when not under an inventory."
	]
	quest.2E8B8DBE61162084.quest_subtitle: "Smart Chutes behave similarly to Brass Funnels."
	quest.2EEEC66CD4A82F71.quest_desc: ["Increase the armor of the wolf"]
	quest.2F0B0D4401AA455E.quest_desc: [
		"A Wrench can be used to give the tunnel windows."
		""
		"The Tunnel does not stop items on the belt from being processed by an Encased Fan, but does stop the airflow from going beyond the belt."
		""
		"Andesite Tunnels can also be used to separate single items from passing stacks to side outputs."
	]
	quest.2F0B0D4401AA455E.quest_subtitle: "A decorative Tunnel for Mechanical Belts."
	quest.2F0B0D4401AA455E.title: "Tunnel"
	quest.2F6B432512FA2A65.quest_desc: ["Attach to any inventory to expand its surface area. Great for access in tight spaces and smart setups with threshold switches."]
	quest.2F7927F6017F4F61.quest_subtitle: "Decoration Block"
	quest.2F7C30CFCD7A1215.quest_desc: ["A powered Laser Pointer emits a laser that a Laser Sensor detects when unobstructed - a clean way to send a Redstone signal across a gap, or to trip when something blocks the beam."]
	quest.2F7C30CFCD7A1215.quest_subtitle: "Redstone over a beam of light"
	quest.2FF2B3FE18ABCB2D.quest_desc: ["Mounted Light emits illumination"]
	quest.300A77D1A972AC59.quest_desc: ["A cylindrical, boiler-shaped block for building the body of steam locomotives. Comes in all sixteen dye colours to match your livery."]
	quest.300A77D1A972AC59.quest_subtitle: "Decorative boiler block"
	quest.302D29E43E9C9A94.quest_desc: [
		"When placed adjacent to any inventory, Packagers can create Cardboard Packages from the inventory they’re attached to. The process does not require extra materials."
		""
		"When powered with a redstone signal, the packager attempts to fill the package as much as possible. A Cardboard Package has 9 slots of inventory. Placing a written sign on the Packager labels the created Cardboard Package with an address to be sent to."
	]
	quest.302D29E43E9C9A94.quest_subtitle: "The Packager is used to create Cardboard Packages."
	quest.3087A48BAF370918.quest_subtitle: "Decoration Block"
	quest.30A84C6A54BD336E.quest_desc: [
		"A stationary Mechanical Drill will break blocks in the block in front of it with a time in seconds of (45 x Hardness)/RPM and will hurt entities in an area around it."
		""
		"A Mechanical Drill moved by &3Contraptions&r will break blocks and damage entities with which it collides without needing a direct supply of Rotational Force."
		""
		"The time it takes for a Mechanical Drill to break a block is based on the Contraption's speed and the block's Hardness value. The damage dealt to entities is also based on the Contraption's speed."
	]
	quest.30A84C6A54BD336E.quest_subtitle: "The Mechanical Drill is a block used to break blocks."
	quest.30AE6897560E6C83.quest_desc: ["Symmetric Sails produce only drag, not lift. Angled against the airflow they slow and turn a contraption, making them perfect for control and stabilising surfaces. They also snap together for easy windmills, and dye to any colour."]
	quest.30AE6897560E6C83.quest_subtitle: "Drag surface for steering and stability"
	quest.30DD5E8D2F10797B.quest_subtitle: "Decoration Block"
	quest.30F4C647F289C629.quest_desc: ["[ { \"text\": \"Create Radars\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"43D55282EF608566\" } } ]"]
	quest.31272DC7D6BB93F1.quest_desc: ["A cylindrical, boiler-shaped block for building the body of steam locomotives. Comes in all sixteen dye colours to match your livery."]
	quest.31272DC7D6BB93F1.quest_subtitle: "Decorative boiler block"
	quest.3170383261F4ED60.quest_subtitle: "Decoration Block"
	quest.318E6E97C7B24074.quest_subtitle: "Decoration Block"
	quest.31BE1CBEE49C518D.quest_desc: [
		"The Sprinkler is a block which, when provided with a fluid using a pipe, will distribute it in a small area below."
		"Different fluids can have different effects."
		""
		"-Lava applies a small amount of fire damage to entities below"
		"-Water makes the area below wet, making the world think it's raining there."
		"-Potions apply their affect for a short duration to entities below"
		"-Liquid Fertilizer, applies a bonemeal affect to blocks."
	]
	quest.3218D5377A9D9373.quest_subtitle: "Decoration Block"
	quest.32387E8E41A570F3.quest_desc: ["A wooden end-beam for train cars fitted with a Link 'n Pin coupler. Click it with planks to change the wood, and dye it to taste."]
	quest.32387E8E41A570F3.quest_subtitle: "Wooden headstock with a coupler"
	quest.32543D43C10B908A.quest_subtitle: "Decoration Block"
	quest.32CE815B4AE226A7.quest_desc: ["Select a Train Track, then place the Coupler nearby. It joins or splits trains without disassembling them; use a wrench to set the gap and to cycle between coupling, decoupling, or both."]
	quest.32CE815B4AE226A7.quest_subtitle: "Couple and decouple trains on the move"
	quest.330AEE6657D71B98.quest_desc: ["Crush any Netherite item between two Crushing Wheels"]
	quest.330AEE6657D71B98.title: "Netherite Shard"
	quest.343CBD6F1DF829A4.quest_subtitle: "Decoration Block"
	quest.3495F5EFD3BB85A5.quest_subtitle: "Decoration Block"
	quest.349AF0A9826EF920.quest_desc: ["Refined Nuclear Fuel made from Radioactive Thorium, loaded into Reactor Rods to drive the fission reaction."]
	quest.349AF0A9826EF920.quest_subtitle: "Fuel for the reactor core"
	quest.350F81A0F8E205A8.quest_subtitle: "Decoration Block"
	quest.3562111D841CF498.quest_desc: [
		"The Sequenced Gearshift can be given up to 5 commands at a time. Each command can be adjusted by hovering over them and scrolling in the interface."
		""
		"The first column consists of the commands Turn by angle, Turn by Piston, Timed Delay, Await New Redstone Pulse, and End. The first two are simply different measurements of rotation, the third makes the Gearshift wait before proceeding to the next command, while the fourth stops the sequence until the Gearshift receives another pulse."
		""
		"The second column adjusts the measurements for each command."
		""
		"The third column adjusts speed and direction."
	]
	quest.3562111D841CF498.quest_subtitle: "The Sequenced Gearshift allows finer control over Rotational power, allowing multiple changes to the rotation over a period of time."
	quest.35639D4A6DDF6FF9.quest_desc: ["When the Clutch is not activated, it will transfer rotation like a Shaft. When it is activated, it will stop transferring rotation."]
	quest.35639D4A6DDF6FF9.quest_subtitle: "Stops outgoing rotation when a redstone signal is applied."
	quest.35895F3FBB5729CC.quest_subtitle: "Decoration Block"
	quest.35BC6997EC5EFC02.quest_desc: ["With a Generator Coil and Carbon Brushes ready, you can start building motors and energisers to put your electricity to work."]
	quest.35BC6997EC5EFC02.quest_subtitle: "Your first electrical machines"
	quest.35C37231C1C86294.quest_desc: [
		"Super Glue has two ways to be used: Block by Block Mode and Area Mode. You can mix both methods on the same contraption."
		""
		"Every time you use the glue, it loses one durability point. You can enchant it with Unbreaking and Mending to make it last longer."
		""
		"In Block by Block Mode, the glue works like a Slimeball. Right-clicking a Linear or Radial Chassis applies glue to one face, letting you attach other blocks. To remove the glue from a chassis, sneak and right-click with an empty hand."
		""
		"In Area Mode, you can glue a group of blocks that are already placed. Start by right-clicking one corner of the section, then move to the opposite corner. A green box will show the selected area. Right-click again to glue the blocks. If you want to cancel, sneak and right-click. The second corner can be up to 24 blocks away, and the total volume can be up to 2312 blocks. No matter how big the selection is, it only uses one durability point. Overlapping glued areas will merge while keeping their shape. You can’t select the face of a chassis in Area Mode—it will switch to Block by Block Mode instead. To avoid this, click the side of the chassis instead."
	]
	quest.35C37231C1C86294.quest_subtitle: "Super Glue holds structures in &3Contraptions&r together."
	quest.35C37231C1C86294.title: "&aSuper Glue"
	quest.35DCDAD0D682D173.quest_desc: [
		""
		"[ { \"text\": \"Create Goggles\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"7B9EE1A765FB668A\" } } ]"
	]
	quest.35F24F6E403AADA1.quest_desc: ["A gearbox with shafts on all 6 sides. Conceptually uses the same internal mechanism as Parallel Gearbox, so top and bottom spins at half speed"]
	quest.3617DE87C4E1BCB9.quest_desc: ["The Hand Crank generates a small amount of &aRotational Force&r through player interaction."]
	quest.362A97A645F66E98.quest_subtitle: "Decoration Block"
	quest.364EC3CEAF5E7C0A.quest_desc: ["Flexible wirings that carry electrical current across your setup. They enable power transfer between generators, motors, energisers, and other energy devices"]
	quest.364EC3CEAF5E7C0A.quest_subtitle: "Crafting component"
	quest.365991A48CDEC367.quest_subtitle: "Decoration Block"
	quest.36760F31374EB61E.quest_desc: ["Seed Oil pressed from seeds - a basic liquid fuel that Blaze Burners can drink once fitted with a Straw."]
	quest.36760F31374EB61E.quest_subtitle: "A simple flammable liquid"
	quest.36823A164BAC5DAB.quest_subtitle: "Decoration Block"
	quest.36A0FF0E41D07FA5.quest_desc: ["Flexible wirings that carry electrical current across your setup. They enable power transfer between generators, motors, energisers, and other energy devices"]
	quest.36A0FF0E41D07FA5.quest_subtitle: "Crafting component"
	quest.36C12A39A071A6E2.quest_desc: ["Mob Radar highlights nearby hostiles"]
	quest.36C254F62F5C0600.quest_desc: ["A decorative panel with a diagonal 'slashed' cut, for adding colour and detail to trains, carriages and stations. Available in all sixteen dye colours."]
	quest.36C254F62F5C0600.quest_subtitle: "Decorative train panelling"
	quest.36C7A185BBD7793F.quest_subtitle: "Decoration Block"
	quest.36D68FE6D787432A.quest_subtitle: "Decoration Block"
	quest.37470C1074D26F54.quest_subtitle: "Decoration Block"
	quest.376B7DE621CAB6FB.quest_subtitle: "Decoration Block"
	quest.37744FC6B3FEC91C.quest_subtitle: "Decoration Block"
	quest.37F5736AE870A237.quest_desc: ["Placed under a Cannon Mount and linked to the network, it automatically turns the cannon's yaw (left-and-right aim) to track the selected target."]
	quest.37F5736AE870A237.quest_subtitle: "Controls the rotation of a cannon mount"
	quest.380EAB5C20B79421.quest_subtitle: "Decoration Block"
	quest.3843E8F66DE41E4A.quest_subtitle: "Decoration Block"
	quest.384E1F8C7B6B590B.quest_desc: ["The Revolver fires Revolver Rounds from a rotating cylinder, six shots before reloading. It accepts upgrades like long barrels, chamber belts and auto-fire."]
	quest.384E1F8C7B6B590B.quest_subtitle: "A six-shot repeating sidearm"
	quest.3885C5AF41E9AC61.quest_subtitle: "Decoration Block"
	quest.3888CBB0389365F8.quest_desc: ["Flexible wirings that carry electrical current across your setup. They enable power transfer between generators, motors, energisers, and other energy devices"]
	quest.3888CBB0389365F8.quest_subtitle: "Crafting component"
	quest.388F1D60D40F63B7.quest_desc: ["The Gatling unloads Gatling Rounds at a furious rate from a 100-round supply. Built for suppressing fire, it pairs well with drum magazines and iron sights."]
	quest.388F1D60D40F63B7.quest_subtitle: "High-capacity spinning-barrel gun"
	quest.38AD5F8E550EAE93.quest_subtitle: "Decoration Block"
	quest.38CDA0888E1222A5.quest_subtitle: "Decoration Block"
	quest.38E9C4DB82B1279A.quest_desc: [
		"While stationary, certain items can be applied to the block's filter. If it has a filter, it will only affect that contraption actor. If powered with a redstone signal before and while it is assembled, the contraption actors will start out disabled. Keep in mind that redstone and levers assembled on &3Contraptions&r have no effect."
		""
		"While on an assembled Contraption, Contraption Controls can be right-clicked to enable and disable certain Contraption Actors."
	]
	quest.38E9C4DB82B1279A.quest_subtitle: "Contraption Controls are used to control Contraption Actors."
	quest.38EC378844976A93.quest_desc: ["Augments your HUD with extra information about placed components - stress, propeller thrust and airflow, lifting-gas data and more. Essential reading while tuning a flying machine."]
	quest.38EC378844976A93.quest_subtitle: "Engineer's goggles for aircraft"
	quest.39124F73B82400F4.quest_desc: ["Converts rotational energy from Create machines into FE at approximately 75% efficiency, allowing energy feedback."]
	quest.39124F73B82400F4.quest_subtitle: "Turns rotation into FE"
	quest.3942693AC85D4BA5.quest_subtitle: "Decoration Block"
	quest.397463A72646B6E1.quest_subtitle: "Decoration Block"
	quest.398299220A1A3895.quest_subtitle: "Decoration Block"
	quest.398BA75CFB6FB80E.quest_subtitle: "Decoration Block"
	quest.39B1210D4B069FD6.quest_subtitle: "Decoration Block"
	quest.39C4C92457767F18.quest_subtitle: "Decoration Block"
	quest.39E3C2D99DD35934.quest_desc: ["A light sail block for contraptions that copies the look of any material you apply to it. Comes in wider sizes too, for shaping big wings and aerofoils."]
	quest.39E3C2D99DD35934.quest_subtitle: "Lightweight copycat sail block"
	quest.3A2633B6030BBC52.quest_desc: ["While worn, the Engineer's Goggles will show the stress impact of the viewed machine while it is running. They will also give numbers and highlight the current rotation when looking at a Stressometer or Speedometer. Additionally, they show how much fluid is in a tank along with the total storage capacity of the tank."]
	quest.3A2633B6030BBC52.quest_subtitle: "Engineer's Goggles are a wearable item that allow the user to see more details about placed machines."
	quest.3A526F4EAF77091F.quest_desc: ["An automated loader that rams ammunition into a cannon’s breech. Requires rotational force to operate and ensures consistent reloading."]
	quest.3A5BF29CC2D01DCF.quest_subtitle: "Decoration Block"
	quest.3A60017A8CE7DCC4.quest_subtitle: "Decoration Block"
	quest.3AE1748998242726.quest_desc: [
		""
		"[ { \"text\": \"Create Bells and Whistles\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"61F76D3FF8262A54\" } } ]"
	]
	quest.3B13D36A4F35C461.quest_subtitle: "Decoration Block"
	quest.3B730A7FADE609EB.quest_desc: ["A buffer stop that caps the end of a track, marking where the line terminates. Can be dyed by clicking with dye."]
	quest.3B730A7FADE609EB.quest_subtitle: "End-of-line stop block"
	quest.3B73F2EBCCD1884C.quest_desc: ["Automatically refills gadgets and armor that use water."]
	quest.3C2A896C6CD20F37.quest_subtitle: "Decoration Block"
	quest.3C50C3A24410BC3C.quest_subtitle: "Decoration Block"
	quest.3C6E18AC535941AB.quest_desc: [
		"Click a Stock Link with the Factory Gauge to link it to that network. Up to 4 Factory Gauges can be placed in one block."
		""
		"The Factory Gauge can be set to monitor an item by either putting the item in its Filter slot or setting the item in the UI. After the item is set, the main UI becomes available."
		""
		"An Address to send the requested package to can be set in the UI. This allows the package to be sorted to the proper location. An expiration time for Promises can be set."
		""
		"The UI displays the storage level set in the Value Settings Screen and the amount of open Promises. Value Settings Screen Hold right click to open the Value Settings Screen and adjust the amount of the item to maintain in storage. This can be set between any amount (*) or up to 100 items or stacks."
	]
	quest.3C6E18AC535941AB.quest_subtitle: "The Factory Gauge is used to send requests through a Logistics Network to maintain an amount of an item in the linked storage."
	quest.3C7E5C34E73D540A.quest_subtitle: "Decoration Block"
	quest.3C8DB1D9EFD2D61C.quest_subtitle: "Decoration Block"
	quest.3C9CA12BBFE38D67.quest_subtitle: "Decoration Block"
	quest.3CA5DFF1105281D6.quest_desc: ["A multiblock energy storage device for FE—used to buffer or store power for later use or smoothing out fluctuations."]
	quest.3CA5DFF1105281D6.quest_subtitle: "Multiblock FE battery"
	quest.3CA678F45B241AA6.quest_desc: ["Thorium processed into its radioactive form - a step toward crafting Nuclear Fuel. Handle with care."]
	quest.3CA678F45B241AA6.quest_subtitle: "Enriched, radioactive thorium"
	quest.3CBCC5392095BA97.quest_subtitle: "Decoration Block"
	quest.3CF4E2C7995F6550.quest_desc: ["[ { \"text\": \"Create Connected\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"0221FE72F998600E\" } } ]"]
	quest.3D410A0C549DF290.quest_desc: ["A special moldable sand used for casting cannon parts. When packed around a pattern in a casting table, it forms the hollow shape needed to pour molten metal into."]
	quest.3DABBC295F8A8491.quest_desc: ["A decorative panel with a diagonal 'slashed' cut, for adding colour and detail to trains, carriages and stations. Available in all sixteen dye colours."]
	quest.3DABBC295F8A8491.quest_subtitle: "Decorative train panelling"
	quest.3DD31828D9BB77F2.quest_desc: ["Crush any Diamond item between two Crushing Wheels"]
	quest.3E2F2B5AC8E36B91.quest_subtitle: "Decoration Block"
	quest.3EB0E7153013F10C.quest_desc: ["Use a deployer to put the Kart Motor on the chassis."]
	quest.3ECC524616BA2DCD.quest_desc: ["A cylindrical, boiler-shaped block for building the body of steam locomotives. Comes in all sixteen dye colours to match your livery."]
	quest.3ECC524616BA2DCD.quest_subtitle: "Decorative boiler block"
	quest.3EDE6A8D45B59544.quest_desc: ["Self-contained cartridges built for rapid-fire autocannons. Compact, fast-loading, and deadly in sustained bursts—perfect for suppressing enemy advances."]
	quest.3EE5BE3E543ABBD6.quest_subtitle: "Decoration Block"
	quest.3EF7DE98852E959C.quest_subtitle: "Decoration Block"
	quest.3F07EDD7B6338C36.quest_subtitle: "Decoration Block"
	quest.3FABA7C4ABBD3813.quest_desc: ["A rapid-fire breech mechanism designed for autocannons. Feeds and fires rounds in quick succession when powered."]
	quest.40295A58589A7250.quest_desc: ["Create: Love and War aims to blend the crafting and infrastructure of Create, with the firepower of Flan's mod, to create a “old school cool” gun mod with a focus on survival and crafting progression."]
	quest.4057912E322E9DBD.quest_subtitle: "Decoration Block"
	quest.4058BCBC7493D7BB.quest_desc: ["A convenient alternative to Super Glue: click two points to make a glued box, then Ctrl-scroll to resize it. Unlike Super Glue it won't form unwanted connections on complex builds."]
	quest.4058BCBC7493D7BB.quest_subtitle: "Selective glue for contraptions"
	quest.40E750430BD7FD79.quest_desc: ["[ { \"text\": \"Create New Furnitures\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"0DEEA086C9B29217\" } } ]"]
	quest.40F8FF1E85694FD4.quest_desc: ["Obtained by putting a Copper Sheet in a Rolling Mill."]
	quest.40F8FF1E85694FD4.quest_subtitle: "Crafting component."
	quest.40FB7ECF967AE45A.quest_desc: ["Unpowered, it behaves like an Encased Cogwheel. Feed it an analog Redstone signal and it slows the cogwheel relative to the shaft, letting Redstone fine-tune rotation speed."]
	quest.40FB7ECF967AE45A.quest_subtitle: "Redstone-controlled gearbox"
	quest.4154C3D38114568D.quest_subtitle: "Decoration Block"
	quest.4181323BF72047A9.quest_desc: [
		"Right-click a valid conductor with a schedule to give it to them. A conductor must either be a mob Seated directly in front of Train Controls on an assembled Train or a Blaze Burner positioned similarly."
		""
		"3 types of commands can be added."
		""
		"&nTravel to Station&r - Navigate to a specified Train Station."
		"&nUpdate Schedule Title&r - Name of route as displayed by the Train Station summary in the Display Link."
		"&nLimit Max Speed &r- Change max speed when traveling to a station."
	]
	quest.4181323BF72047A9.quest_subtitle: "Train Schedules are used to instruct non-player Train conductors."
	quest.41E21358995A0078.quest_desc: ["Regenerative Casing slowly heals the wolf over time"]
	quest.41E9AE1746036791.quest_subtitle: "Decoration Block"
	quest.41E9FC34375A4762.quest_subtitle: "Decoration Block"
	quest.42195C45933ACA1E.quest_desc: ["Central Kitchen is a mod offering more tools and methods to automate food processing for other mods in Create."]
	quest.421EA2CE61003DA1.quest_desc: ["Allows the player to fly, move and swim faster. Works with fuel."]
	quest.4266BF7FCE3B4330.quest_desc: [
		"The Cogwheel is a basic mechanical component in Create that relays rotation."
		""
		"The Large Cogwheel is a larger variant of the cogwheel that can relay rotation around corners and power Rotation Speed Controllers."
		""
		"Cogwheels have three main methods of interlocking:"
		""
		"- Two Cogwheels interlock when placed next to each other (not diagonally) and facing the same direction. When rotational force is provided to one of the cogwheels, the force will be provided to the other Cogwheel at the same speed but in the opposite direction."
		""
		"-Two Large Cogwheels interlock when placed perpendicular to each other, effectively changing its axis and direction, but not its speed."
		""
		"-A Cogwheel and a Large Cogwheel interlock when placed diagonally to each other and facing the same direction. The Large Cogwheel will rotate at half the speed of the Cogwheel."
	]
	quest.4266BF7FCE3B4330.title: "Cogwheels"
	quest.4272553A76B98C8A.quest_subtitle: "Decoration Block"
	quest.4279B2C4BD52ED14.quest_subtitle: "Decoration Block"
	quest.428643ABDE915454.quest_desc: ["The Auto Fire mechanism lets the Revolver fire continuously while held, trading careful aimed shots for raw rate of fire."]
	quest.428643ABDE915454.quest_subtitle: "Revolver fire-rate upgrade"
	quest.4294F26E8D2BA9CB.quest_desc: ["A transparent variant of Reactor Casing, for building windows into your reactor while keeping it sealed."]
	quest.4294F26E8D2BA9CB.quest_subtitle: "See-through reactor wall"
	quest.431EC43C4F988CF1.quest_desc: ["Carbon Brushes keep electrical contact with spinning parts. A key ingredient for motors and Generator Coils."]
	quest.431EC43C4F988CF1.quest_subtitle: "Contact brushes for motors and coils"
	quest.434A32B75ADC9EDA.quest_subtitle: "Decoration Block"
	quest.4383C171599FFDEC.quest_desc: [
		""
		"[ { \"text\": \"Create Teleporters\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"7DBD8E66451BD4DA\" } } ]"
	]
	quest.43902B53F47A8770.quest_subtitle: "Crafting component."
	quest.439DF3FDD2E418EA.quest_subtitle: "Decoration Block"
	quest.43D5364C7603F129.quest_desc: [
		"The Slicer is a machine similar to the Mechanical Mixer or Mechanical Press. It automatically registers all cutting recipes from Farmer's Delight. In that sense, it is an automatic Cutting Board."
		""
		"In order to use it, the correct tool has to be placed into the machine, using Right-Click. By default, only knives and axes are allowed."
	]
	quest.43D55282EF608566.quest_desc: ["Create: Radar adds a full detection and weapons-control network. Build spinning radar dishes to scan the area, wire them to monitors through Data Links, and let auto-aiming controllers point your cannons at whatever the radar sees."]
	quest.43D55282EF608566.quest_subtitle: "Detect, track and target with radar"
	quest.43E4EE94BB396A7C.quest_desc: ["A crafting machine used to shape rods and wires, essential for electrical component construction."]
	quest.43E4EE94BB396A7C.quest_subtitle: "Rolls ingots into rods and wires"
	quest.44194CEF6E737561.quest_desc: ["Autocannon ammunition that is more effective against entities."]
	quest.445EA2148F9B31E6.quest_desc: ["The Launcher fires Rockets that explode on impact - heavy ordnance for tearing through groups of enemies or fortifications."]
	quest.445EA2148F9B31E6.quest_subtitle: "Shoulder-fired rocket launcher"
	quest.449AB1FA8A928BF2.quest_desc: [
		""
		"[ { \"text\": \"Create Mechanical Companion\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"7655E21D5CFB174C\" } } ]"
	]
	quest.44AF361FFD44C532.quest_desc: ["A full spread of Shotgun ammo: standard pellets, Incendiary rounds that ignite targets, and Flechette rounds - with a tougher steel version - that fire armour-piercing darts."]
	quest.44AF361FFD44C532.quest_subtitle: "Ammunition for the Shotgun"
	quest.4505622C1471A71F.quest_subtitle: "Decoration Block"
	quest.4512B97451C2221F.quest_desc: ["The Mechanical Arm can take or deposit items from various blocks within a 5 block radius of where it is placed. A placed Mechanical Arm's selected blocks can be viewed by hovering over it with a Wrench. The Mechanical Arm is capable of transferring up to a stack of items at once."]
	quest.4512B97451C2221F.quest_subtitle: "The Mechanical Arm is a block used to transfer items."
	quest.45389293F537AB71.quest_subtitle: "Decoration Block"
	quest.4546E59E305FA58C.quest_subtitle: "Decoration Block"
	quest.4567FAE026077E3E.quest_desc: ["The item teleporter can teleport a stack of items to an item teleporter receiver.  It uses telejuice as fuel.  To link it to an item teleporter receiver, use a TP link."]
	quest.45770072CFE9C70F.quest_desc: ["Heavy, powerful rounds designed for direct-fire cannons. Ranging from solid shot for smashing fortifications to explosive shells for devastating area damage."]
	quest.457D2B870376D2FE.quest_subtitle: "Decoration Block"
	quest.4581823B7CB90873.quest_subtitle: "Decoration Block"
	quest.459E24BD2F3DB8C7.quest_subtitle: "Decoration Block"
	quest.45BA5B8A785E1B82.quest_desc: [
		"Using a Wrench on a component will rotate the component around the face with which you interacted."
		""
		"Using a Wrench on a component, redstone component, rail or vanilla rail variant will dismantle it and place it in your inventory. Any block which can be rotated or otherwise interacted with using right click must be dismantled while sneaking."
		""
		"Hovering over certain configurable components will allow configuration by scrolling."
		""
		"For certain components such as the Linear Chassis, ctrl can be held to configure all connected components at once."
	]
	quest.45BA5B8A785E1B82.quest_subtitle: "The Wrench is a tool used to rotate, dismantle and configure components"
	quest.45D1E4AD19D56356.quest_subtitle: "Decoration Block"
	quest.45D5802C64FBAC40.quest_subtitle: "Decoration Block"
	quest.45FADC0FF7BF9A58.quest_desc: ["A cylindrical, boiler-shaped block for building the body of steam locomotives. Comes in all sixteen dye colours to match your livery."]
	quest.45FADC0FF7BF9A58.quest_subtitle: "Decorative boiler block"
	quest.46004D01A142777E.quest_subtitle: "Smart Fluid Pipes can be used to allow only a certain liquid to pass through them."
	quest.4623694A2DBB1542.quest_subtitle: "Decoration Block"
	quest.4692806B2567E677.quest_subtitle: "Decoration Block"
	quest.46BBBC2AE23D9E77.quest_subtitle: "Decoration Block"
	quest.46C99C4ABD414586.quest_subtitle: "Decoration Block"
	quest.46D3B104FDA42E44.quest_subtitle: "Decoration Block"
	quest.46F87864666E33F0.quest_subtitle: "Decoration Block"
	quest.47745C8FF94FF640.quest_subtitle: "Decoration Block"
	quest.47A8E06BD832A6AF.quest_desc: ["A decorative panel with a diagonal 'slashed' cut, for adding colour and detail to trains, carriages and stations. Available in all sixteen dye colours."]
	quest.47A8E06BD832A6AF.quest_subtitle: "Decorative train panelling"
	quest.482B7634F42B4D71.quest_subtitle: "Decoration Block"
	quest.48604F54874176D0.quest_subtitle: "Decoration Block"
	quest.4861419A7B1821DE.quest_subtitle: "Decoration Block"
	quest.489B3BC42C93DE24.quest_subtitle: "Decoration Block"
	quest.48D6A12A1FBD6D16.quest_desc: ["Basin Foundry Lids are used to melt down metals for cannon casting"]
	quest.48F9C017C806DF66.quest_desc: ["A cylindrical, boiler-shaped block for building the body of steam locomotives. Comes in all sixteen dye colours to match your livery."]
	quest.48F9C017C806DF66.quest_subtitle: "Decorative boiler block"
	quest.4905CD63121F13EA.quest_desc: ["Automatically refills gadgets and armor that use fuel."]
	quest.4941F57A0BC50DE6.quest_desc: ["Leave a Train Seat over 5000 blocks away from where you started travelling"]
	quest.495C3C490E5F0C1F.quest_desc: ["Drives a submarine through the water when spun. Excellent underwater, but useless out in the open air."]
	quest.495C3C490E5F0C1F.quest_subtitle: "Underwater propulsion"
	quest.49603BFCDB242BC2.title: "Decals"
	quest.497B68AABAA5281A.quest_subtitle: "Decoration Block"
	quest.497E077E0D3B64A4.quest_desc: ["[ { \"text\": \"Create Aeronautics\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"6142979F2E5E54E5\" } } ]"]
	quest.49D9442F89A06EA6.quest_desc: ["A decorative panel with a diagonal 'slashed' cut, for adding colour and detail to trains, carriages and stations. Available in all sixteen dye colours."]
	quest.49D9442F89A06EA6.quest_subtitle: "Decorative train panelling"
	quest.4A22534045841AE4.quest_desc: ["A copper spool strung with festive lights. Works like a Copper Spool for low-current wiring, but far merrier."]
	quest.4A22534045841AE4.quest_subtitle: "Festive low-current spool"
	quest.4A47E558AD90EB64.quest_desc: ["Provides an interface to access two inventories simultaneously. Also comes with filter slots to quickly sort incoming items."]
	quest.4A7F96E62A5845C5.quest_desc: [
		"Mechanical Pistons are a Contraption that will collide with unmovable blocks."
		""
		"To extend, the Piston must have Piston Extension Poles at the end as well as Rotational power. The maximum extension pole length is 64 blocks, and this can be changed in the Config."
		""
		"When the rotation is reversed, the piston will retract. The end must be made sticky with a Slimeball to bring the pushed blocks back with it."
	]
	quest.4A7F96E62A5845C5.quest_subtitle: "The Mechanical Piston is a piston that can push &3Contraptions&r when powered with Rotational Power."
	quest.4AA6E52423B4A264.quest_desc: ["Redstone Magnets attract or repel other magnets - opposite poles pull together, like poles push apart. Toggle them to latch contraptions together or fling them apart."]
	quest.4AA6E52423B4A264.quest_subtitle: "Magnet you can switch with Redstone"
	quest.4B004B3ADE6EC396.quest_desc: ["Standard big cannon propellant"]
	quest.4B151EB06E665C09.quest_subtitle: "Decoration Block"
	quest.4B25616E0908ABB5.quest_subtitle: "Decoration Block"
	quest.4B4E27C7DF1C753A.quest_subtitle: "Decoration Block"
	quest.4B7AF631F982F9A5.quest_desc: ["Powered by FE and supplied with water, the Electrolyzer produces the oxygen your Oxygen Diffuser needs to keep a crew breathing underwater."]
	quest.4B7AF631F982F9A5.quest_subtitle: "Turns water into oxygen"
	quest.4B900A64C051C07F.quest_subtitle: "Decoration Block"
	quest.4B976C143EDA4317.quest_desc: [
		"Casings are blocks used throughout many crafting recipes in Create, as well as for decoration and aesthetic purposes."
		""
		"There are four types of Casings: Andesite Casings are mainly used in basic &3Contraptions&r."
		""
		"Casings can only be crafted through physically applying a valid alloy or ingot to any Stripped variant of Log or Wood. The logs will convert themselves into the casing."
		""
		"Mechanical Belts, Shafts, and Cogwheels can be encased in most casings, creating a decoration around the encased block. Copper casings, however, can be used only on Fluid Pipes. Likewise, a fluid pipe will not accept any other kind of casing."
	]
	quest.4B976C143EDA4317.title: "&l&6Andesite Casing"
	quest.4BB13C80196FD034.quest_desc: [
		"&l&6Create&r&r is a highly versatile and visually engaging mod for Minecraft that adds a wide range of mechanical components and automation tools. Unlike traditional tech mods, &6&lCreate&r&r focuses on kinetic power, allowing players to build complex machines using gears, shafts, belts, and rotating mechanisms. From automatic farms and item sorters to moving &3&lContraptions&r&r and trains, the mod enables creativity through motion and engineering principles."
		""
		"One of the standout features of Create is the in-game tutorial system known as &n&oPonder&r&r. By holding the &nW&r key while hovering over a modded item in the inventory, players can view animated demonstrations that explain how the item works. Ponder makes learning the mod both intuitive and immersive, turning the process of understanding complex mechanics into an enjoyable experience that blends seamlessly with gameplay."
	]
	quest.4BB13C80196FD034.quest_subtitle: "Create"
	quest.4BB13C80196FD034.title: "&l&6Create"
	quest.4BC778CA91E06E6C.quest_desc: ["Craftable magnetic items with increasing capacity and range. Used in generator coils and energiser crafting to enhance electrical performance."]
	quest.4BC778CA91E06E6C.quest_subtitle: "Magnetic ore block"
	quest.4BE8715B5216E26F.quest_subtitle: "Crafting component."
	quest.4C7CD3858A2BE870.quest_desc: [
		"The Mechanical Press is a mechanical component that applies Pressing, Packing, and Compacting recipes to items below it. It is used to press Ingots into Sheets, which are important ingredients for higher-level components."
		""
		"The Mechanical Press is powered by an internal Shaft, accessed from two opposite sides. Much like Shafts, Presses will relay rotation along their axis. It processes items faster when it receives faster &arotational power&r."
	]
	quest.4C8DDA689FE8369D.quest_desc: ["A bucket of Levitite Blend, the fluid that crystallises into Levitite. Cast it and apply heat to start the reaction, which then spreads through the whole pool."]
	quest.4C8DDA689FE8369D.quest_subtitle: "Liquid that becomes anti-gravity crystal"
	quest.4CAC3786D1E665E1.quest_subtitle: "Decoration Block"
	quest.4CD822763FCBF7EF.quest_desc: ["Outputs a Redstone signal based on its speed, emitted away from the direction of motion. Set the speed for maximum signal in its value box."]
	quest.4CD822763FCBF7EF.quest_subtitle: "Reads how fast you're moving"
	quest.4D927A321278CF28.quest_desc: ["A machine that extracts infinite underground ores when placed within a chunk that contains a vein. It must be fitted with a mechanical drill and powered with at least 30 RPM of rotational force (higher speeds increase production rate). The extracted raw ores are output using funnels and the machine auto‑stops at 16 internal units."]
	quest.4D998F75DA4690FA.quest_subtitle: "Decoration Block"
	quest.4E5BFAA7E55C6A83.quest_subtitle: "Decoration Block"
	quest.4E5C6F23628A9982.quest_desc: ["Encased chain drives may be placed side by side either vertically or horizontally to form a chain passing rotational power among all the blocks. The blocks must touch on their sides (not axis to side) and be in a single straight line to form a chain. The axes of the encased chain drives may be all parallel or blocks can be rotated to orient the axis perpendicularly. Encased chain drives can also pass &arotational power&r through their rotating axis, but this is not a continuation of the same chain."]
	quest.4E5C6F23628A9982.quest_subtitle: "The Encased Chain Drive is a block that can transfer rotation much like the Mechanical Belt."
	quest.4E8EE0AB4FC2C8D6.quest_subtitle: "Decoration Block"
	quest.4EBBEFC2579A8440.quest_subtitle: "Decoration Block"
	quest.4EC20D5D0EEC1DF7.quest_desc: ["[ { \"text\": \"Hand Crank\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"3617DE87C4E1BCB9\" } } ]"]
	quest.4EC499B88FBFA01C.quest_desc: ["Stores kinetic stress for later use. Retains charge in item form to enable long-distance energy transport. Battery capacity, RPM at discharge and stress impact values are all configurable."]
	quest.4F1FA866A2F510A1.quest_desc: ["Obtained by putting an Electrum Ingot in a Rolling Mill."]
	quest.4F1FA866A2F510A1.quest_subtitle: "Crafting component."
	quest.4F2F6E31C38DA17F.quest_desc: ["Automatically refills gadgets and armor that use water."]
	quest.4F38ABDB12AD7680.quest_desc: [
		"When held, the Extendo Grip increases the player's reach by 4 blocks and increases knockback. When held in the offhand, these bonuses are retained."
		""
		"When the Extendo Grip is used to break blocks, place blocks, or hit mobs, it will lose durability regardless of whether it's in the main or offhand unless used in conjunction with a filled Copper Backtank and Netherite Backtank, in which case the tank's air is used instead."
		""
		"Much like super glue and sandpaper, it can be enchanted with unbreaking and mending books."
	]
	quest.4F3D30ADFE877038.quest_desc: ["[ { \"text\": \"Create\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"4BB13C80196FD034\" } } ]"]
	quest.4F99F8D62C2E9D33.quest_subtitle: "Decoration Block"
	quest.4FCCEB8B6A6AA643.quest_desc: ["Stores a small charge of energy - a core ingredient in electric motors, alternators and other powered machines."]
	quest.4FCCEB8B6A6AA643.quest_subtitle: "Crafting component."
	quest.4FDF302D1E8EFA59.quest_desc: ["Create New Age is an addon for the Create mod that adds integration with electricity. It does so by adding multiblock structures that resemble their reallife counter-parts. Furthermore, create: new age doesn't stop at electricity and also adds nuclear power to create."]
	quest.4FDF302D1E8EFA59.quest_subtitle: "Electricity and nuclear power for Create"
	quest.500FA9792456C013.quest_desc: ["The Physics Assembler turns a glued group of blocks into a Simulated Contraption - a real, physics-driven object you can fly, sink or drive. Glue blocks together, then hold right-click and pull the lever to assemble."]
	quest.500FA9792456C013.quest_subtitle: "The heart of every simulated contraption"
	quest.504757B76E9743CB.quest_subtitle: "Decoration Block"
	quest.50CE0BD7B0BC4017.quest_desc: ["Fluid Valves can be switched between open and closed by providing Rotational Force to the side. This is often done with a Valve Handle or Gearshift. A set of directional arrows on the side of the valve will also rotate to indicate whether the valve is open or closed."]
	quest.50CE0BD7B0BC4017.quest_subtitle: "Fluid valves can be used to close or open the flow in a pipe."
	quest.5111785DAB2ECFB9.quest_subtitle: "Decoration Block"
	quest.513D6027ECB7D891.quest_subtitle: "Decoration Block"
	quest.516292716B400BDB.quest_subtitle: "Decoration Block"
	quest.518BE9C73EEA15E8.quest_subtitle: "Decoration Block"
	quest.519F769CD09D01B1.quest_subtitle: "Decoration Block"
	quest.51CCB7ACFD7B45F1.quest_desc: [""]
	quest.51CCB7ACFD7B45F1.quest_subtitle: "Brass Casings are used in more advanced machines."
	quest.51D077F9C830AA69.quest_subtitle: "Decoration Block"
	quest.525B3ED31D6C1C95.quest_subtitle: "Decoration Block"
	quest.5287D9F564797135.quest_desc: ["Generates thrust when spun and automatically pitches along one axis to try to face upwards. Right-click with a Wrench to reverse the direction it pushes."]
	quest.5287D9F564797135.quest_subtitle: "Propeller that aims its own thrust"
	quest.52A593D191365A78.quest_desc: ["Placed on a sub-level (a contraption), the Claim Block lets you claim and protect that vessel, keeping your hard-built airship safe from griefing."]
	quest.52A593D191365A78.quest_subtitle: "Protect your airship as a claim"
	quest.52EEC531B25E99CB.quest_desc: [
		""
		"[ { \"text\": \"Create Trading Floor\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"5856137738C5229F\" } } ]"
	]
	quest.52F31F54165F1184.quest_desc: ["A decorative panel with a diagonal 'slashed' cut, for adding colour and detail to trains, carriages and stations. Available in all sixteen dye colours."]
	quest.52F31F54165F1184.quest_subtitle: "Decorative train panelling"
	quest.53839611482E91A6.quest_desc: ["Solar panels that capture daylight to generate heat energy."]
	quest.53839611482E91A6.quest_subtitle: "Generates heat from sunlight"
	quest.53C002F2ABE538B0.quest_subtitle: "Decoration Block"
	quest.53C0234C053BF0CF.quest_desc: [
		"Place a Stock Link to start a new Logistics Network. Right-click a placed Stock Link before placement to share that link’s network. Place the link on a Packager to connect the packager’s connected inventory to the network."
		""
		"Stock Links have no range limitations, but the chunk they’re in must be loaded in order to be seen by the network."
		""
		"Stock Links can receive and transmit requests through the Logistics Network."
	]
	quest.53C0234C053BF0CF.quest_subtitle: "The Stock Link is used to connect Packagers to Logistics Networks."
	quest.53E4FA4FC288F2C4.quest_subtitle: "Decoration Block"
	quest.53FD572EEA1B8583.quest_subtitle: "Decoration Block"
	quest.541F19F64E5106E5.quest_desc: [
		"The Pulse Timer sends a redstone signal repeatedly with a set amount of time between each pulse. It can be disabled by powering it with a redstone signal."
		""
		"The interval can be set in its Value Settings Screen accessed by holding right-click. The delay can be set between 2 ticks and 60 minutes. The settings can also be copied and pasted to other Pulse Timers, Pulse Repeaters, or Pulse Extenders by using a Clipboard."
	]
	quest.541F19F64E5106E5.quest_subtitle: "The Pulse Timer is used to pulse repeatedly at a set interval."
	quest.5452569B53AF9228.quest_subtitle: "Decoration Block"
	quest.54589F10802DFE16.quest_desc: ["A clutch that is uncoupled unless powered"]
	quest.545EE18B03F3A125.quest_desc: [
		""
		"[ { \"text\": \"Create Jetpacks\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"491A4EA9E2AE2783\" } } ]"
	]
	quest.546C27255A22817C.quest_desc: ["Enables advanced mobility: Quantum Drive allows short-range teleportation."]
	quest.54E2B7BC6C3019C4.quest_desc: ["Provides directional thrust when powered by Redstone and supplied with FE energy - clean, fuel-free propulsion if you have the electricity to spare."]
	quest.54E2B7BC6C3019C4.quest_subtitle: "Electric directional thruster"
	quest.553A2C5D3773DF27.quest_desc: ["Dishes and Plates are added around the Receiver on a radar contraption. Each one increases detection range, and the two types can be freely mixed for the look you want."]
	quest.553A2C5D3773DF27.quest_subtitle: "Extend the range of your radar"
	quest.554C4AA8E303848B.quest_subtitle: "Decoration Block"
	quest.55BFEE429ED3C0B1.quest_desc: ["The Nailgun rapidly spits Nails using compressed air, fed from a large magazine. Upgrade it with a splitter barrel or a steam engine for sustained fire."]
	quest.55BFEE429ED3C0B1.quest_subtitle: "Rapid-fire nail thrower"
	quest.55CB7F7C1F982DBF.quest_desc: [
		"The wand has a range of 50 blocks."
		""
		"Shift right click to adjust the wand's settings. It can be set to \"Mirror Once, Rectangular, or Octagonal,\" and told what axis to mirror along."
		""
		"Right click on the ground to place the wand. Right click again to place it elsewhere. While on the Mirror Once or Rectangular settings, the orientation can also be adjusted in-world. Right click on the air or remove the Wand from the hotbar to remove the wand from the world."
		""
		"Place or destroy blocks around the wand to have it mirror the action to the other side(s). Placing takes the appropriate blocks from the inventory, and destroying spawns all the items at the block destroyed by the player."
	]
	quest.55CB7F7C1F982DBF.quest_subtitle: "The Wand Of Symmetry is a helpful building tool that mirrors blocks placed."
	quest.55F444C86FD5516C.quest_desc: ["A small piece of electrum, the conductive alloy used throughout Create: Crafts and Additions. Nine nuggets make an ingot."]
	quest.55F444C86FD5516C.quest_subtitle: "Crafting component."
	quest.55F4BB16DB93C01E.quest_desc: ["Create Deco is the best mod around for taking your industrial, urban, or steampunk builds to the next level. With everything from catwalks to cage lamps and shipping containers to sheet metal, Create Deco integrates flawlessly with the existing selection of building blocks in Create."]
	quest.5660F00EE9B988BB.quest_desc: ["A cylindrical, boiler-shaped block for building the body of steam locomotives. Comes in all sixteen dye colours to match your livery."]
	quest.5660F00EE9B988BB.quest_subtitle: "Decorative boiler block"
	quest.566D6390193DD77D.quest_desc: [
		"Brass Tunnels may be used on mechanical belts for four functions: 1) purely decorative, 2) splitting streams of items to multiple destinations, 3) sorting streams of items, and 4) combining multiple streams of items. Each tunnel can have an input or output portal. The status of being an input or output depends purely on the direction of the belt touching a given side."
		""
		"Tunnels which are placed immediately next to each other are automatically treated as a group, in most cases collecting from all inputs and distributing to all outputs. The way that items are distributed is controlled by the tunnels' value setting. Item stacks from different inputs will not be combined prior to distributing."
	]
	quest.566D6390193DD77D.quest_subtitle: "A Brass Tunnel is a machine that can only be placed on Mechanical Belts."
	quest.56B5C0FE19AAEF4B.quest_subtitle: "Decoration Block"
	quest.56C8010167A4B825.quest_subtitle: "Decoration Block"
	quest.56E21CF6CEE76C4C.quest_subtitle: "Decoration Block"
	quest.570DC20BFC4E3E0C.quest_desc: ["Obtained by energizing gold"]
	quest.570DC20BFC4E3E0C.quest_subtitle: "Crafting item"
	quest.5722DD2B679A479E.quest_subtitle: "Decoration Block"
	quest.583AC516A10C9711.quest_subtitle: "Decoration Block"
	quest.5856137738C5229F.quest_desc: ["The Trading Depot Block can be used to automatically trade with villagers over the day."]
	quest.588415583F6D634E.quest_subtitle: "Decoration Block"
	quest.58B8821DCF4DDC81.quest_desc: [
		""
		"[ { \"text\": \"Create Copycats+\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"7C5E7060FAB3A110\" } } ]"
	]
	quest.58E158C8F2C04BEB.quest_desc: ["Heat Levitite Blend to crystallise it into Levitite. Attach enough Levitite to a contraption and it floats - though on its own it can't gain altitude, and it resists slow movement far more than fast."]
	quest.58E158C8F2C04BEB.quest_subtitle: "Crystallise Blend into floating crystal"
	quest.59742E14B716CDB0.quest_desc: ["You can use a Heat Pump to pump heat in any direction you want."]
	quest.59742E14B716CDB0.quest_subtitle: "Directs heat where you need it"
	quest.59993E6A76D3511F.quest_desc: ["The Reactor Heat Vent draws heat out of a running reactor and feeds it into connected Heat Pipes, keeping the core under control."]
	quest.59993E6A76D3511F.quest_subtitle: "Bleeds heat away from the reactor"
	quest.599CBC177D3D745D.quest_desc: ["Right-click a Rope Winch and a Rope Connector with the Rope Coupling to attach them with rope. Use Shears to cut the rope later."]
	quest.599CBC177D3D745D.quest_subtitle: "Ties rope to a winch or connector"
	quest.599EF0E99664A03B.quest_desc: ["You can found blueprints in dungeons"]
	quest.5A2450162FD24F7E.quest_desc: [
		"Two Crushing Wheels must be placed next to each other horizontally or vertically one block apart. Both wheels must be given opposite rotational force. Any items to be crushed must be inserted where the wheels rotate inwards."
		""
		"Crushing wheels can be automated by placing a hopper at the top directly between the wheels and either a depot or conveyor belt below."
	]
	quest.5A2450162FD24F7E.quest_subtitle: "Crushing Wheels applie Crushing recipes to any items inserted from the direction they are spinning away from."
	quest.5A2450162FD24F7E.title: "Crushing Wheels"
	quest.5A643C5226143CB9.quest_desc: ["A massive spinning copper coil paired with powerful magnets, converting rotational kinetic energy into electrical power. It serves as the foundational power generator for your grid."]
	quest.5A643C5226143CB9.quest_subtitle: "Turns rotation into electricity"
	quest.5AB03B0A601002AA.quest_desc: [""]
	quest.5AF1979C8EE3249D.quest_subtitle: "Decoration Block"
	quest.5B057D497F07981D.quest_subtitle: "Decoration Block"
	quest.5B20D67059C6ACBD.quest_desc: ["A cylindrical, boiler-shaped block for building the body of steam locomotives. Comes in all sixteen dye colours to match your livery."]
	quest.5B20D67059C6ACBD.quest_subtitle: "Decorative boiler block"
	quest.5B42670C93888FC4.quest_subtitle: "Decoration Block"
	quest.5B44C72D8A598AD2.quest_subtitle: "Decoration Block"
	quest.5B63F1DDEF9ABFF4.quest_desc: ["A longer barrel for the Revolver, boosting range and accuracy in exchange for slightly slower handling."]
	quest.5B63F1DDEF9ABFF4.quest_subtitle: "Revolver barrel upgrade"
	quest.5BE34A7DF70B1E7F.quest_subtitle: "Decoration Block"
	quest.5C2108BD3DEEB0E6.quest_desc: [
		"The Spout is a block used for filling liquid containers such as bottles or buckets, or crafting with liquids."
		""
		"The Spout can be filled with up to 1 bucket of any one liquid via Fluid Pipes, and it will empty some of its fluid onto compatible items that pass under it via a Conveyor Belt or Depot. "
		""
		"The spout takes 1 second to process an item regardless of the amount of fluid used, though delay between fills may be caused by the time it takes the spout to fill back up."
	]
	quest.5C2CF0E0CC94347D.quest_subtitle: "Decoration Block"
	quest.5C363998DB5B46F4.quest_subtitle: "Decoration Block"
	quest.5C673A5296FD9379.quest_desc: ["A cylindrical, boiler-shaped block for building the body of steam locomotives. Comes in all sixteen dye colours to match your livery."]
	quest.5C673A5296FD9379.quest_subtitle: "Decorative boiler block"
	quest.5C6E945F38EA9846.quest_desc: ["The Wheel Mount fits wheel-like items so a contraption can roll along the ground; power it from the top to brake or from the side to steer. Tires come in small, standard, large and monstrous sizes for any terrain."]
	quest.5C6E945F38EA9846.quest_subtitle: "Wheels for ground vehicles"
	quest.5C6E945F38EA9846.title: "Tires"
	quest.5CA8F8A195AD24D8.quest_desc: [
		"Use the drawing press to convert brass sheets into bullet casings. By drawing a brass sheet multiple times, various types of bullet casing can be produced, from pistol casings, to rifle, grenade and artillery shell casings."
		""
		"Once you have a casing, use a deployer to fill it with gunpowder, and then insert a metal nugget to complete the bullet."
	]
	quest.5CCAE584BC13C4E3.quest_subtitle: "Decoration Block"
	quest.5D0B237AC1C177CA.quest_desc: ["When provided with heat from below a Stirling Engine will start to slowly rotate."]
	quest.5D0B237AC1C177CA.quest_subtitle: "Turns heat into rotation"
	quest.5D745773CEA7E388.quest_desc: ["The Rock Cutting Wheel chews through stone. A Borehead bearing needs at least one to dig - the foundation of mechanical tunnel-boring machines."]
	quest.5D745773CEA7E388.quest_subtitle: "Drilling wheel for tunnel-boring rigs"
	quest.5DC411437882B19D.quest_desc: ["A mountable launcher you can ride: load it with Throwable Rope Connectors and fire ropes to anchors, with Redstone control for hands-free firing and release."]
	quest.5DC411437882B19D.quest_subtitle: "Block-mounted rope harpoon"
	quest.5E0465DA39B3354D.quest_subtitle: "Decoration Block"
	quest.5E0D162FB2932A41.quest_subtitle: "Decoration Block"
	quest.5E56F602B8815496.quest_desc: [
		"Right-click a Stock Link or a Stock Ticker with the Redstone Requester to connect it to the Logistics Network, then place it."
		""
		"The Redstone Requester’s request can be configured in its menu. It can request up to 256 of 9 different item types to be delivered to a specified Address."
		""
		"When powered with a redstone signal, the requester makes the request set in its UI. If the desired items are not found on the network, the request is not made."
	]
	quest.5E56F602B8815496.quest_subtitle: "The Redstone Requester is used to request Cardboard Packages from linked Packagers."
	quest.5E6F48677A198FEE.quest_subtitle: "Decoration Block"
	quest.5EE479F3CFBBB5DF.quest_desc: ["A cylindrical, boiler-shaped block for building the body of steam locomotives. Comes in all sixteen dye colours to match your livery."]
	quest.5EE479F3CFBBB5DF.quest_subtitle: "Decorative boiler block"
	quest.5F078EEB6F883E37.quest_desc: ["Extra Chambers let the Flintlock hold and fire several charges before reloading, easing its biggest weakness."]
	quest.5F078EEB6F883E37.quest_subtitle: "Flintlock capacity upgrade"
	quest.5F5ACAA9FF2DF350.quest_subtitle: "Decoration Block"
	quest.5FA0FD61BDF44067.quest_desc: ["Enables advanced mobility: Booster Rocket provides a speed burst."]
	quest.60055D1DE16D8F03.title: "Kart"
	quest.6072830A6998AA20.quest_subtitle: "Decoration Block"
	quest.6083C27BDAD82105.quest_subtitle: "Decoration Block"
	quest.6098C7276359A9C5.quest_subtitle: "Decoration Block"
	quest.60DBF181ED929607.quest_desc: ["Charges electric gear and also can emit damaging electric arcs towards players and mobs—a functional offensive and utility block."]
	quest.60DBF181ED929607.quest_subtitle: "Charges gear and zaps enemies"
	quest.61348E2551E8AD6C.quest_desc: [
		"For the Rotation Speed Controller to work, it must be paired with a Large Cogwheel. The Rotation Speed Controller, when powered by the Large Cogwheel, outputs any desired speed of rotational force from its sides. It also does the opposite; when powered from its sides, it controls the speed of the Large Cogwheel."
		""
		"The rotation speed and direction can be changed in the Value Settings Screen at the front or the back of the machine. The speed can be set to a maximum of 256rpms clockwise or counter-clockwise."
	]
	quest.61348E2551E8AD6C.quest_subtitle: "The Rotation Speed Controller is a mechanical component that allows the player to precisely control rotational speed."
	quest.6142979F2E5E54E5.quest_desc: ["Create: Aeronautics and its companion mods let you build airships, balloons, planes and submarines as fully simulated, physics-driven contraptions. This chapter takes you from your first propeller to a steerable flying machine."]
	quest.6142979F2E5E54E5.quest_subtitle: "Take to the skies"
	quest.614345CE5AB038B6.quest_subtitle: "Crafting component."
	quest.617EBC25B0F97965.quest_desc: [
		""
		"[ { \"text\": \"Create Slice and Dice\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"6C049540C64342A8\" } } ]"
	]
	quest.61A3BF6B8D5F92EC.quest_desc: [""]
	quest.61A3BF6B8D5F92EC.quest_subtitle: "Heavy launcher variant"
	quest.61F76D3FF8262A54.quest_desc: ["Create Bells \\& Whistles is an addon for the Create mod that focuses on the player experience, adding new decorative and utility blocks specifically suited for Create builds \\& contraptions."]
	quest.61F76D3FF8262A54.title: "Create: Bells \\& Whistles"
	quest.626580DB654F128D.quest_subtitle: "The Millstone is capable of applying milling recipes to any valid items inserted from above."
	quest.62671BDA7C583957.quest_desc: ["Biomass made from organic matter, the intermediate step toward biofuel and solid biomass pellets."]
	quest.62671BDA7C583957.quest_subtitle: "Compostable fuel base"
	quest.62DB74C03D100293.quest_subtitle: "Decoration Block"
	quest.62E16AC3521529A6.quest_desc: ["A shoulder Stock steadies a firearm, reducing recoil and spread for more accurate, controlled fire."]
	quest.62E16AC3521529A6.quest_subtitle: "Weapon attachment for stability"
	quest.62F1177325B16068.quest_desc: ["An electrum spool for high-current connections, holding wire to link high-current connectors together."]
	quest.62F1177325B16068.quest_subtitle: "Stores high-current wire"
	quest.62FA8647798A15EE.quest_subtitle: "Decoration Block"
	quest.632C20063AEF5BE5.quest_desc: ["Create: Steam 'n' Rails builds on Create's train system with new couplers, signals and track tools, plus a whole palette of Locometal blocks for styling your locomotives and rolling stock."]
	quest.632C20063AEF5BE5.quest_subtitle: "Expanding Create's trains and tracks"
	quest.632D1A4B5C9F4222.title: "&l&4Redstone"
	quest.634F7742AA16EB11.quest_desc: ["The Link 'n Pin is a cosmetic coupler placed at the end of a train car, giving the join between carriages an authentic old-railway look. Purely decorative."]
	quest.634F7742AA16EB11.quest_subtitle: "Decorative coupler for train ends"
	quest.6350ADB7540C368D.quest_desc: [
		"If the Smart Observer is placed with the front facing a container such as a Mechanical Belt, Funnel or Fluid Pipe, it will emit a Redstone signal when an item is detected inside. A Smart Observer will also emit a signal if the block placed in front of it matches the filter."
		""
		"If a Filter is applied to the Smart Observer, it will only emit a redstone signal when the item in the filter is detected."
	]
	quest.6350ADB7540C368D.quest_subtitle: "The Smart Observer is a machine that emits a redstone signal dependent on the block or items inside a container in front of it."
	quest.63E5A6F388AA25D9.quest_subtitle: "Decoration Block"
	quest.63E8F78EEA3063F7.quest_desc: ["[ { \"text\": \"Gearshift\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"24DDED464AE48E05\" } } ]"]
	quest.63EDF003DE31445F.quest_desc: ["Magnetite charged to a high magnetic flux, used to craft the strongest magnets and advanced components."]
	quest.63EDF003DE31445F.quest_subtitle: "High-strength magnetic block"
	quest.642230FC856DE526.quest_desc: ["An end-beam (headstock) for rolling stock fitted with a Link 'n Pin coupler. As a copycat block it takes on the texture of whatever material you apply to it."]
	quest.642230FC856DE526.quest_subtitle: "Headstock that copies any block"
	quest.6444F64F434D7D25.quest_subtitle: "Decoration Block"
	quest.648B1D6ACDC7A6F2.quest_desc: [
		"Disassemble your old equipment, be it tools, weapons or armor, into ingots, nuggets, and shards."
		"Break down most wood block variants into sticks, including blocks from other mods."
		"Are you afraid of accidentally dropping an iron block into the crusher? Don't be, now it will just split into ingots. The same applies to most other \"compact\" blocks."
		"Rails, iron bars, bowls, identical music records and all of the things that fill up your inventory after looting some modded dungeons are now useful."
		"After building a redstone scheme you have any extra repeaters and pistons that are now left lying around? Not a problem anymore."
	]
	quest.64AB5CCDD9860DD8.quest_desc: ["Obtained by putting an Iron Sheet in a Rolling Mill."]
	quest.64AB5CCDD9860DD8.quest_subtitle: "Crafting component."
	quest.64B39D946D7DAD8A.quest_desc: ["Riveted Locometal is the base material of Steam 'n' Rails, crafted into boilers, headstocks and the many decorative panels that give locomotives their classic riveted-iron look."]
	quest.64B39D946D7DAD8A.quest_subtitle: "The signature train-building block"
	quest.64CF1354946D22B8.quest_subtitle: "Decoration Block"
	quest.64E075328853897B.quest_subtitle: "Decoration Block"
	quest.64F3F33955B72D60.quest_subtitle: "Decoration Block"
	quest.652442BDE0602E91.quest_desc: ["A powerful drill designed to bore out cannon barrels with precision."]
	quest.654FBC78D1C3B35D.quest_desc: ["Outputs a Redstone signal based on elevation - by default, the higher you go the stronger the signal. Set the minimum and maximum altitudes in its UI."]
	quest.654FBC78D1C3B35D.quest_subtitle: "Reads your height in the air"
	quest.65715BCC3BF025C1.quest_desc: ["When powered with Redstone, the Hot Air Burner gradually fills the Envelope above it with lift-giving hot air. The input panel sets its maximum output, and several burners can feed one balloon."]
	quest.65715BCC3BF025C1.quest_subtitle: "Fills your balloon with hot air"
	quest.66103C97558260D3.quest_subtitle: "Decoration Block"
	quest.66108B4F2DBF2E3F.quest_desc: ["Obtained by putting a Copper Ingot in a Rolling Mill."]
	quest.66108B4F2DBF2E3F.quest_subtitle: "Crafting component."
	quest.663F89822E1FF951.quest_desc: ["Obtained by energizing iron"]
	quest.663F89822E1FF951.quest_subtitle: "Crafting item"
	quest.66934314E00ED53C.quest_subtitle: "Decoration Block"
	quest.66AA867F65118548.quest_subtitle: "Decoration Block"
	quest.66C3C169307A8025.quest_desc: ["Allows the player to fly, move and swim faster. Works with water"]
	quest.66D9F91519D52482.quest_desc: ["Blaze Cake is an item that can be fed to a Blaze Burner in order to make it Super-Heated."]
	quest.675A9530C02D7A94.quest_desc: ["Unpowered it passes no rotation. Power the straight side to relay rotation, or the reverse side to flip its direction - Redstone control over which way things spin."]
	quest.675A9530C02D7A94.quest_subtitle: "Redstone-controlled rotation reverser"
	quest.67671FD1B34E7314.quest_subtitle: "Decoration Block"
	quest.67C7CBC848DBCC0C.quest_subtitle: "Decoration Block"
	quest.67DCAD0D8E27D742.quest_subtitle: "Decoration Block"
	quest.67E3DE0BBB66C30B.quest_subtitle: "Decoration Block"
	quest.6803BF9EAF78335C.quest_desc: ["A cylindrical, boiler-shaped block for building the body of steam locomotives. Comes in all sixteen dye colours to match your livery."]
	quest.6803BF9EAF78335C.quest_subtitle: "Decorative boiler block"
	quest.680DB44761CE8160.quest_desc: ["A cylindrical, boiler-shaped block for building the body of steam locomotives. Comes in all sixteen dye colours to match your livery."]
	quest.680DB44761CE8160.quest_subtitle: "Decorative boiler block"
	quest.6832CFEAFA7922E8.quest_desc: ["A device that produces immense stress when powered, halting the network by overstressing it"]
	quest.68331DDD9F01BDC5.quest_desc: ["Works with fuel."]
	quest.683F038B42039EB4.quest_subtitle: "Decoration Block"
	quest.686DA5E275A9290B.quest_desc: ["Use a deployer to put the wheels on the chassis."]
	quest.686DA5E275A9290B.title: "Kart Wheels"
	quest.6876FDE87B1F5A99.quest_desc: ["The Musket Barrel lengthens the Flintlock for greater range and accuracy, turning the pistol into a proper long gun."]
	quest.6876FDE87B1F5A99.quest_subtitle: "Flintlock barrel upgrade"
	quest.6887C6B7ED8727B3.quest_desc: ["Envelope blocks enclose an airtight volume that generates lift when filled with hot air. Seal off a space with them, fill it from below, and your contraption starts to rise. Right-click with dye to recolour."]
	quest.6887C6B7ED8727B3.quest_subtitle: "Builds the balloon that lifts you"
	quest.69189C6AF7556602.quest_subtitle: "Decoration Block"
	quest.6938ECBB2B767300.quest_desc: ["The automatic loader cycles shells for you, raising the Shotgun's rate of fire compared to manual pumping."]
	quest.6938ECBB2B767300.quest_subtitle: "Shotgun reload upgrade"
	quest.695CC32ED98F11B3.quest_desc: [
