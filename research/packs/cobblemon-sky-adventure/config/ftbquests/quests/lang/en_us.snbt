	quest.0261928EE8B92A11.quest_desc: [
		"To obtain Entei you need to craft a \"Entei Treat\", for which you will require multiple cobblemon berries and a \"Poketreat Box\" which the Entrepreneur Villager sometimes sells."
		""
		"Once you have the treat, you need to find the Burned Tower (you can track it using the Arc Phone) and place the treat at the Entei Pedestal and a level 40 Entei will spawn, with a 2% chance of it being a shiny."
	]
	quest.0261928EE8B92A11.title: "Entei"
	quest.030EA9C8C9E85B11.quest_desc: ["The Ouranium Coal will smelt 6 144 items."]
	quest.0401A0F40DFE89FC.quest_desc: ["The Magenta Collector [MK4] will generate 160 EMC/s, +40 EMC/s for each relay, which can transfer 2 560 EMC/s."]
	quest.0401A0F40DFE89FC.title: "Collector MK4"
	quest.0419738E9E7FC1C3.quest_desc: [
		"Keep shiny charm on inventories to boost your shiny odds!"
		""
		"With it, the shiny rate is now 1/2042."
	]
	quest.0578F3D1ACB4A9A0.quest_desc: [
		"Gamble pokemons ? "
		"Yes you read right, use 5 diamonds in this machine and a random pokemon will spawn. "
	]
	quest.059D8C6D75F5100B.quest_desc: ["Craft some Ornium Essence with Insanium and Awakend Supremium essence."]
	quest.059D8C6D75F5100B.title: "Ornium Essence"
	quest.068283EC87F29C88.quest_desc: [
		"To obtain Cosmog you must collect by right-clicking with a \"Cosmic Bag\", 50 \"Cosmic Dust\" which you can find in The End. "
		""
		"Once you collect your 50th cosmic dust a level 5 Cosmog will spawn, with a 2% chance of it being a shiny."
		""
		"After capturing it Cosmog will evolve into Cosmoem at level 43 and Cosmoem will evolve at level 53, where you'll have to choose to either evolve it into Lunala or Solgaleo."
	]
	quest.068283EC87F29C88.title: "Cosmog / Lunala / Solgaleo"
	quest.06A85ABC741087EA.quest_desc: ["To obtain Zacian you must find the Sword Temple (you can track it using the Arc Phone) and by using a \"Totem of Undying\" and a \"Rusted Sword\" (which you can craft or download datapacks available at the Mega Showdown Discord that add other ways to obtain it) at the Zacian Pedestals a level 60 Zacian will spawn, with a 2% chance of it being a shiny."]
	quest.06A85ABC741087EA.title: "Zacian"
	quest.07265972A0400487.quest_desc: ["Upgraded RS crafters are available to craft, assuming your server admin hasn't disabled some of them. Iron, Gold, Diamond, and Netherite crafters are in the pack and offer a huge boost to space and speed over the default RS Crafters"]
	quest.07265972A0400487.quest_subtitle: "Upgraded crafters are available, if your server allows them"
