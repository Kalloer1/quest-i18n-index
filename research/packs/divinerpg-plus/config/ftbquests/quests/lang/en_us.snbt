	quest.03BE3834F54A1C4E.quest_desc: [
		"Place down the root, connect it with a link and use any storage blocks next to the link. "
		""
		"Place storage request table next to the root."
		""
		"Now you can access your items and craft with them."
		""
		"Remotes work as long as you link it to your storage setup and can be used in any distance or dimension."
		""
		"Press \"&eI&f\" to open storage when a remote is your inventory."
		""
		"{image:kubejs:textures/misc/storage.png width:240 height:135 align:center click_action:none:}"
	]
