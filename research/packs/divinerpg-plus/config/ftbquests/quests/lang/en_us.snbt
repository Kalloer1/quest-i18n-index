	quest.7CE716625D7F4D6D.quest_desc: [
		"Ability 1: Repeated lightning strikes will happen next to the player."
		""
		"Ability 2: Raglok will darken the players screen for 10 seconds to the point where the player can barely see."
		""
		"Ability 3: Raglok will cause it to rain down tonnes of particles onto the floor, the particles on the floor can either be dangerous or helpful."
		""
		"Ability 4: Raglok will slow down the player for 5 seconds. During this period, Raglok will have much larger knock-back than usual."
	]
