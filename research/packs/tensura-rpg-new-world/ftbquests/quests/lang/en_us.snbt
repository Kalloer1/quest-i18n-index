		""
		"Form a Lesser or higher Wind spirit contract."
	]
	quest.5A01000000000005.quest_subtitle: "A Lesser pact with Wind"
	quest.5A01000000000005.title: "Lesser Wind"
	quest.5A01000000000006.quest_desc: [
		"Not every pact is made beneath the light. Darkness has its own spirit path. Begin with a Lesser contract and learn where this element fits your character."
		""
		"Form a Lesser or higher Darkness spirit contract."
	]
	quest.5A01000000000006.quest_subtitle: "A Lesser pact with Darkness"
	quest.5A01000000000006.title: "Lesser Darkness"
	quest.5A01000000000007.quest_desc: [
