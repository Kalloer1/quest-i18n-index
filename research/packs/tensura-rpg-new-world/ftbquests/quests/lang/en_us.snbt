		"Defeat 1 x Hinata Sakaguchi (Tensura: Reincarnated)."
		"Target entity: tensura:hinata_sakaguchi. You must receive kill credit."
	]
	quest.6A01000000000007.quest_subtitle: "Another milestone in your journey through the Cardinal World"
	quest.6A01000000000007.title: "Boss Trial: Hinata Sakaguchi"
	quest.6A01000000000008.quest_desc: [
