	quest.5A0100000000000A.quest_subtitle: "A Greater pact with Flame"
	quest.5A0100000000000A.title: "Greater Flame"
	quest.5A0100000000000B.quest_desc: [
		"A grimoire turns curiosity into practice. Craft the Novice Spell Book and begin discovering how Ars Nouveau builds its spells."
		""
		"The book recipe includes a book plus an iron sword, axe, pickaxe and shovel."
	]
	quest.5A0100000000000B.quest_subtitle: "Craft your foundational grimoire of arcane glyphs"
	quest.5A0100000000000B.title: "&5Ars Nouveau: Novice Spell Book"
	quest.5A0100000000000C.quest_desc: [
		"The first pages no longer hold every art you wish to study. Upgrade your Novice book to open the apprentice tier of glyphs."
		""
		"Use the installed book-upgrade recipe: novice book, obsidian, diamonds, quartz blocks and blaze rods."
	]
	quest.5A0100000000000C.quest_subtitle: "Upgrade your grimoire to harness Tier 2 arcane glyphs"
	quest.5A0100000000000C.title: "&dApprentice Spell Book: Tier 2 Glyphs"
	quest.5A0100000000000D.quest_desc: [
		"An arcane workshop needs a place to store its Source. Set down a Source Jar, then provide a generation method to fill it."
		""
		"Consult the recipe or source shown in JEI as you prepare this step."
		"Source generation and relay transport are separate systems; a Source Jar alone does not generate Source."
	]
	quest.5A0100000000000D.quest_subtitle: "Capture and store raw liquid Source energy"
	quest.5A0100000000000D.title: "&bMana Containment: Source Jar"
	quest.5A0100000000000E.quest_desc: [
		"Every spell begins with an art you have learned. Build the Scribes Table and use it with your spell book to study glyphs."
		""
		"The Scribes Table recipe uses archwood logs, archwood slabs and gold nuggets."
	]
	quest.5A0100000000000E.quest_subtitle: "Transcribe new glyphs and bind enchanted scrolls"
	quest.5A0100000000000E.title: "&eThe Scribe's Atelier"
	quest.5A0100000000000F.quest_desc: [
		"A quiet chamber can become the heart of magical preparation. Use the Imbuement Chamber for the transformations its recipes describe."
		""
	]
	quest.5A0100000000000F.quest_subtitle: "Infuse raw minerals into concentrated Source Gems"
	quest.5A0100000000000F.title: "&dSource Transmutation"
	quest.5A01000000000010.quest_desc: [
		"Arrange your workshop for a deliberate kind of enchantment. The apparatus works with an Arcane Core and surrounding pedestals; each recipe determines the other requirements."
		""
	]
	quest.5A01000000000010.quest_subtitle: "Synthesize high-tier magical artifacts and runic gear"
	quest.5A01000000000010.title: "&5Ritual Alchemy: Enchanter's Apparatus"
	quest.5A01000000000011.quest_desc: [
		"An arcanist's journey deserves more than ordinary travelling clothes. Obtain the robes; this milestone asks for that piece rather than a complete equipped set."
		""
		"Consult the recipe or source shown in JEI as you prepare this step."
		"Only the robes item is checked; wearing it or owning the full set is not required."
	]
