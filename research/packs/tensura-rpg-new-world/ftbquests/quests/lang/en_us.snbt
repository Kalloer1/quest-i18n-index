	quest.0DB1000000000001.quest_desc: [
		"Your chosen arts help define the adventurer you become. Study the paths open to your race and build, then decide which deserve mastery."
		"Acquisition requirements appear in the skill menu. Each skill is optional; connected second steps ask for mastery."
		"Begin this chapter after completing Reincarnation and the Voice of the World."
	]
	quest.0DB1000000000001.quest_subtitle: "Another milestone in your journey through the Cardinal World"
	quest.0DB1000000000001.title: "Choose Your Skill Path"
	quest.0DB1000000000002.quest_desc: [
		"Some dangers announce themselves before they can be seen."
		""
		"Using magicule to sense entities around."
		"Learn Magic Sense. Check its acquisition conditions in the skill menu."
	]
	quest.0DB1000000000002.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB1000000000002.title: "Magic Sense"
	quest.0DB1000000000003.quest_desc: [
		"Let Magic Sense become a mastered art, rather than a lesson you have only begun."
		""
		"Use Magic Sense until it is mastered. Learning it is only the first step."
	]
	quest.0DB1000000000003.quest_subtitle: "Master your chosen art"
	quest.0DB1000000000003.title: "Master Magic Sense"
	quest.0DB1000000000004.quest_desc: [
		"Knowledge can be as valuable as the weapon in your hand."
		""
		"Assess the strength of your opponents to gain insight into their overall strength."
		"Learn Analytical Appraisal. Check its acquisition conditions in the skill menu."
	]
	quest.0DB1000000000004.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB1000000000004.title: "Analytical Appraisal"
	quest.0DB1000000000005.quest_desc: [
		"For a spellcaster, the mind is part of the battlefield."
		""
		"Increase the speed at which you think to cast magic more quickly as well as to increase your reaction speed."
		"Learn Thought Acceleration. Check its acquisition conditions in the skill menu."
	]
	quest.0DB1000000000005.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB1000000000005.title: "Thought Acceleration"
	quest.0DB1000000000006.quest_desc: [
		"The road between two places need not always be walked."
		""
		"Tear space asunder granting yourself and your allies safe passage."
		"Learn Spatial Motion. Check its acquisition conditions in the skill menu."
	]
	quest.0DB1000000000006.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB1000000000006.title: "Spatial Motion"
	quest.0DB1000000000007.quest_desc: [
		"Prepare more than one layer of defence for the trials ahead."
		""
		"Protect yourself with a multitude of powerful defensive barriers."
		"Learn Multilayer Barrier. Check its acquisition conditions in the skill menu."
	]
	quest.0DB1000000000007.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB1000000000007.title: "Multilayer Barrier"
	quest.0DB1000000000008.quest_desc: [
		"Survival is an art worth learning before your next great trial."
		""
		"Speed up your body's natural regeneration to increase your survivability."
		"Learn Self Regeneration. Check its acquisition conditions in the skill menu."
	]
	quest.0DB1000000000008.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB1000000000008.title: "Self Regeneration"
	quest.0DB1000000000009.quest_desc: [
		"Let Self Regeneration become a mastered art, rather than a lesson you have only begun."
		""
		"Use Self Regeneration until it is mastered. Learning it is only the first step."
	]
	quest.0DB1000000000009.quest_subtitle: "Master your chosen art"
	quest.0DB1000000000009.title: "Master Self Regeneration"
	quest.0DB100000000000A.quest_desc: [
		"Even water can become part of an adventurer's arsenal."
		""
		"Shoot out a blade of water which flies in a straight line."
		"Learn Water Blade. Check its acquisition conditions in the skill menu."
	]
	quest.0DB100000000000A.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB100000000000A.title: "Water Blade"
	quest.0DB100000000000B.quest_desc: [
		"Let Water Blade become a mastered art, rather than a lesson you have only begun."
		""
		"Use Water Blade until it is mastered. Learning it is only the first step."
	]
	quest.0DB100000000000B.quest_subtitle: "Master your chosen art"
	quest.0DB100000000000B.title: "Master Water Blade"
	quest.0DB100000000000C.quest_desc: [
		"Companions offer reasons to seek another way of communicating."
		""
		"Give orders to tames when looking at them through commands."
		"Learn Telepathy. Check its acquisition conditions in the skill menu."
	]
	quest.0DB100000000000C.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB100000000000C.title: "Telepathy"
	quest.0DB100000000000D.quest_desc: [
		"The wilds hold dangers no ordinary blade can parry."
		""
		"Ignore weaker poisons or reduce the damage from more potent toxins."
		"Learn Poison Resistance. Check its acquisition conditions in the skill menu."
	]
	quest.0DB100000000000D.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB100000000000D.title: "Poison Resistance"
	quest.0DB100000000000E.quest_desc: [
		"A guiding intellect can become an art of its own."
		""
		"Improve your cognitive skills to learn and cast faster, become able to appraise targets and use analysis to copy skills and process materials to craft or clone items or equipment."
		"Learn Great Sage. Check its acquisition conditions in the skill menu."
	]
	quest.0DB100000000000E.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB100000000000E.title: "Great Sage"
	quest.0DB100000000000F.quest_desc: [
		"Let Great Sage become a mastered art, rather than a lesson you have only begun."
		""
		"Use Great Sage until it is mastered. Learning it is only the first step."
	]
	quest.0DB100000000000F.quest_subtitle: "Master your chosen art"
	quest.0DB100000000000F.title: "Master Great Sage"
	quest.0DB1000000000010.quest_desc: [
		"Begin a path through one of Tensura's distinctive arts."
		""
		"Become the monster you were meant to be. Eat all. Analyze, craft and refine items, gain access to a spatial storage and mimic entities."
		"Learn Predator. Check its acquisition conditions in the skill menu."
	]
	quest.0DB1000000000010.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB1000000000010.title: "Predator"
	quest.0DB1000000000011.quest_desc: [
		"The path of consumption reaches beyond its first lesson."
		""
		"Absorb all in your path. None can win. Receive and provide skills, gain access to a spatial storage and mimic entities."
		"Learn Gluttony. Check its acquisition conditions in the skill menu."
	]
	quest.0DB1000000000011.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB1000000000011.title: "Gluttony"
	quest.0DB1000000000012.quest_desc: [
		"Not every art belongs to a single familiar form."
		""
		"Craft, decraft, customize items and absorb strength from weakened enemies."
		"Learn Degenerate. Check its acquisition conditions in the skill menu."
	]
	quest.0DB1000000000012.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB1000000000012.title: "Degenerate"
	quest.0DB1000000000013.quest_desc: [
		"An adventurer's life also has room for restoration."
		""
		"Mend wounds with a touch or unleash devastating afflictions, capable of both salvation and suffering."
		"Learn Healer. Check its acquisition conditions in the skill menu."
	]
	quest.0DB1000000000013.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB1000000000013.title: "Healer"
	quest.0DB1000000000014.quest_desc: [
		"Let the traveller's art become part of your chosen road."
		""
		"Move freely through space, teleport large distances or create spatial gates. Manipulate stardust to deal immense damage."
		"Learn Traveler. Check its acquisition conditions in the skill menu."
	]
	quest.0DB1000000000014.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB1000000000014.title: "Traveler"
	quest.0DB1000000000015.quest_desc: [
		"This art belongs to the possibilities of creation."
		""
		"Create any Unique Skill and use it for a limited amount of time."
		"Learn Creator. Check its acquisition conditions in the skill menu."
	]
	quest.0DB1000000000015.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB1000000000015.title: "Creator"
	quest.0DB1000000000016.quest_desc: [
		"The spider's tale has its own darker arts."
		""
		"Decently more lethal than Poison."
		"Learn Deadly Poison. Check its acquisition conditions in the skill menu."
	]
	quest.0DB1000000000016.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB1000000000016.title: "Deadly Poison"
	quest.0DB1000000000017.quest_desc: [
		"Learn another art of the labyrinth's spider lineage."
		""
		"Grants the user night vision, cobweb immunity and special climbing."
		"Learn Spider Movement. Check its acquisition conditions in the skill menu."
	]
	quest.0DB1000000000017.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB1000000000017.title: "Spider Movement"
	quest.0DB1000000000018.quest_desc: [
		"Another guise can become part of a creature's story."
		""
		"Become more human-like."
		"Learn Humanification. Check its acquisition conditions in the skill menu."
	]
	quest.0DB1000000000018.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB1000000000018.title: "Humanification"
	quest.0DB1000000000019.quest_desc: [
		"An armament need not always begin in an ordinary forge."
		""
		"Allows the user to create unique weapons to wield."
		"Learn Weapon Creation. Check its acquisition conditions in the skill menu."
	]
	quest.0DB1000000000019.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB1000000000019.title: "Weapon Creation"
	quest.0DB100000000001A.quest_desc: [
		"Let Weapon Creation become a mastered art, rather than a lesson you have only begun."
		""
		"Use Weapon Creation until it is mastered. Learning it is only the first step."
	]
	quest.0DB100000000001A.quest_subtitle: "Master your chosen art"
	quest.0DB100000000001A.title: "Master Weapon Creation"
	quest.0DB100000000001B.quest_desc: [
		"The labyrinth's later trials call for more than curiosity."
		""
		"Keep going."
		"Learn Resolve. Check its acquisition conditions in the skill menu."
	]
	quest.0DB100000000001B.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB100000000001B.title: "Resolve"
	quest.0DB100000000001C.quest_desc: [
		"A long journey is written one difficult step at a time."
		""
		"Shine like a comet, until you burnout."
		"Learn Perseverance. Check its acquisition conditions in the skill menu."
	]
	quest.0DB100000000001C.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB100000000001C.title: "Perseverance"
	quest.0DB100000000001D.quest_desc: [
		"Crystal is more than a mineral in this addon's arts."
		""
		"Summon a cloud of crystal dust that obscures vision and damages enemies within its area."
		"Learn Crystal Dust. Check its acquisition conditions in the skill menu."
	]
	quest.0DB100000000001D.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB100000000001D.title: "Crystal Dust"
	quest.0DB100000000001E.quest_desc: [
		"Follow the crystalline path toward another art of protection."
		""
		"The golem's outer layer is composed of hyper-compressed, high-purity crystals. This shell acts as a multi-layered filter that can bend, split, and neutralize magical energy upon contact."
		"Learn Refractive Shell. Check its acquisition conditions in the skill menu."
	]
	quest.0DB100000000001E.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB100000000001E.title: "Refractive Shell"
	quest.0DB100000000001F.quest_desc: [
		"The crystalline arts hold an offensive branch as well."
		""
		"Summon a blade of pure light that can cut through almost anything. The blade's power increases with the user's mastery of the skill."
		"Learn Photon Blade. Check its acquisition conditions in the skill menu."
	]
	quest.0DB100000000001F.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB100000000001F.title: "Photon Blade"
	quest.0DB1000000000020.quest_desc: [
		"Seek the art at the centre of this crystalline path."
		""
		"The golem's core is a unique crystalline structure that resonates with the world's magic. By attuning to this core, the golem can temporarily enhance its abilities, gaining increased strength, speed, and magical resistance for a short duration."
		"Learn Resonant Core. Check its acquisition conditions in the skill menu."
	]
	quest.0DB1000000000020.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB1000000000020.title: "Resonant Core"
	quest.0DB1000000000021.quest_desc: [
		"Let Resonant Core become a mastered art, rather than a lesson you have only begun."
		""
		"Use Resonant Core until it is mastered. Learning it is only the first step."
	]
	quest.0DB1000000000021.quest_subtitle: "Master your chosen art"
	quest.0DB1000000000021.title: "Master Resonant Core"
	quest.0DB1000000000022.quest_desc: [
		"Reflection gives this skill path another chapter."
		""
		"A unique skill that allows the user to reflect and absorb incoming attacks, converting them into stored energy for future use."
		"Learn Total Reflection. Check its acquisition conditions in the skill menu."
	]
	quest.0DB1000000000022.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB1000000000022.title: "Total Reflection"
	quest.0DB1000000000023.quest_desc: [
		"Another combat art waits within this addon's branch."
		""
		"A unique skill that allows the user to unleash devastating attacks."
		"Learn Devastator. Check its acquisition conditions in the skill menu."
	]
	quest.0DB1000000000023.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB1000000000023.title: "Devastator"
	quest.0DB1000000000024.quest_desc: [
		"Some journeys turn inward before reaching beyond the familiar world."
		""
		"Manifest a private inner dimension. A skin-only echo of you remains outside; if it dies, you return to where it fell. Activate again to leave and rejoin your echo."
		"Learn Inner World. Check its acquisition conditions in the skill menu."
	]
	quest.0DB1000000000024.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB1000000000024.title: "Inner World"
	quest.0DB1000000000025.quest_desc: [
		"A steady mind prepares you for unfamiliar arts."
		""
		"Through rigorous study of the grimoire you discovered, you are now able to subconsciously absorb surrounding magicules."
		"Learn Concentrator. Check its acquisition conditions in the skill menu."
	]
	quest.0DB1000000000025.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB1000000000025.title: "Concentrator"
	quest.0DB1000000000026.quest_desc: [
		"Let this Nightmare art join your character's studies."
		""
		"Combining Aura and Magic results in a mystic art... Not even the antithesis to skills can resist."
		"Learn Mystic Aura. Check its acquisition conditions in the skill menu."
	]
	quest.0DB1000000000026.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB1000000000026.title: "Mystic Aura"
	quest.0DB1000000000027.quest_desc: [
		"The Nightmare branch offers another protective art."
		""
		"Create a layered barrier that unites the properties of the Multilayer Barrier Skill and Fault Field."
		"Learn Multidimensional Barrier. Check its acquisition conditions in the skill menu."
	]
	quest.0DB1000000000027.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB1000000000027.title: "Multidimensional Barrier"
	quest.0DB1000000000028.quest_desc: [
		"Space and time belong to this path's stranger pages."
		""
		"A spacetime package that supersedes Spatial Domination. Inflict devastating spatial damage, warp reality, and move through space at will."
		"Learn Spacetime Manipulation. Check its acquisition conditions in the skill menu."
	]
	quest.0DB1000000000028.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB1000000000028.title: "Spacetime Manipulation"
	quest.0DB1000000000029.quest_desc: [
		"Infinity is one road through the Nightmare arts."
		""
		"§3Infinity is a unique and incredibly powerful Enchantment-Type Unique Skill. Its effects are so outside the norm of most magic, that it's been called §4unfair §3and §echeating."
		"Learn Infinity. Check its acquisition conditions in the skill menu."
	]
	quest.0DB1000000000029.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB1000000000029.title: "Infinity"
	quest.0DB100000000002A.quest_desc: [
		"Another ambition leads toward the art named Snatch."
		""
		"§4Snatch §3is both an Enchantment-Type and Stealth-Type Unique Skill that allows the user to §0rob §3objects and even the abilities of others without ever laying a finger on them. This §8intangible attack §3slips through §9barriers, §7armor, and §8defenses alike, making it §4lethal §3in the hands of someone who knows how to use it. When wielded correctly, it's less a skill and more a §cviolation of reality."
		"Learn Snatch. Check its acquisition conditions in the skill menu."
	]
	quest.0DB100000000002A.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB100000000002A.title: "Snatch"
	quest.0DB100000000002B.quest_desc: [
		"Let Sunshine mark a possible direction for your build."
		""
		"§6Sunshine §3is a Unique Skill of the §cDestruction §3and §eEnchantment §3Types. It radiates overwhelming heat and light, empowering the user as the sun rises, reaching its peak at noon. During this time, the user's destructive power and enchanted abilities surge to their maximum potential, turning them into an unstoppable force under the daylight."
		"Learn Sunshine. Check its acquisition conditions in the skill menu."
	]
	quest.0DB100000000002B.quest_subtitle: "Discover an art for your chosen path"
	quest.0DB100000000002B.title: "Sunshine"
	quest.1A01000000000001.quest_desc: [
		"You have crossed into the Cardinal World, where an unfamiliar body and unfamiliar arts await. Before seeking a greater destiny, learn to keep this new life alive."
		"Find Hipokute Grass and inspect your race and skills in the Tensura status menu. Your key bindings are listed in Controls."
	]
	quest.1A01000000000001.quest_subtitle: "Press [B] to inspect your spiritual status"
	quest.1A01000000000001.title: "Reincarnation and the Voice of the World"
	quest.1A01000000000002.quest_desc: [
		"Even an unfamiliar world offers a remedy to those who learn its herbs. Hipokute is your first step toward a dependable healing supply."
		""
		"Consult the recipe or source shown in JEI as you prepare this step."
	]
	quest.1A01000000000002.quest_subtitle: "Another milestone in your journey through the Cardinal World"
	quest.1A01000000000002.title: "Herbal Alchemy: Hipokute Grass"
	quest.1A01000000000003.quest_desc: [
		"A small vial can decide whether your first expedition ends in triumph or a hurried retreat. Gather these early restoratives before venturing farther."
		""
		"Consult the recipe or source shown in JEI as you prepare this step."
	]
	quest.1A01000000000003.quest_subtitle: "Brew a basic restorative draft"
	quest.1A01000000000003.title: "Basic Concoctions: Low Potion"
	quest.1A01000000000004.quest_desc: [
		"As the dangers grow, humble herbs give way to more refined medicine. Prepare High Potions for the trials ahead."
		""
		"The installed refining recipe uses Hipokute Grass and its configured container; inspect JEI."
	]
	quest.1A01000000000004.quest_subtitle: "Synthesize a 98% pure healing panacea"
	quest.1A01000000000004.title: "Potent Elixirs: High Potion"
	quest.1A01000000000005.quest_desc: [
		"Some journeys call for the finest remedy you can obtain. Seek a Full Potion before trusting your fate to another desperate battle."
		""
		"The installed refining recipe uses Hipokute Flower; inspect JEI."
	]
	quest.1A01000000000005.quest_subtitle: "Total cellular and stamina regeneration"
	quest.1A01000000000005.title: "Miraculous Panacea: Full Potion"
	quest.1A01000000000006.quest_desc: [
		"Before the great calamities, prove yourself against the world's smaller monsters."
		""
		"Defeat 5 x Slime (Tensura: Reincarnated)."
		"Target entity: tensura:slime. You must receive kill credit."
		"Minecraft slimes do not count toward this trial."
	]
	quest.1A01000000000006.quest_subtitle: "Defeat Slime from Tensura: Reincarnated"
	quest.1A01000000000006.title: "Predator's Trial: Slime Hunt"
	quest.1A01000000000007.quest_desc: [
		"The forest is not yours merely because you entered it. Face the direwolves in your path."
		""
		"Defeat 3 x Direwolf (Tensura: Reincarnated)."
		"Target entity: tensura:direwolf. You must receive kill credit."
	]
	quest.1A01000000000007.quest_subtitle: "Another milestone in your journey through the Cardinal World"
	quest.1A01000000000007.title: "Direwolf Hunt: Defend the Outpost"
	quest.1A01000000000008.quest_desc: [
		"Not every encounter with the forest's tribes ends in peace. This trial records combat victories, rather than protection or naming."
		""
		"Defeat 3 x Goblin (Tensura: Reincarnated)."
		"Target entity: tensura:goblin. You must receive kill credit."
	]
	quest.1A01000000000008.quest_subtitle: "Defeat Goblin from Tensura: Reincarnated"
	quest.1A01000000000008.title: "Goblin Skirmish: Three Victories"
	quest.1A01000000000009.quest_desc: [
		"Beneath a creature's simple form may lie a valuable magical catalyst. Obtain a Slime Core and keep it for the crafts that call for one."
		""
	]
	quest.1A01000000000009.quest_subtitle: "Extract an intact biological magic core"
	quest.1A01000000000009.title: "Crystalline Catalyst: Slime Core"
	quest.1A0100000000000A.quest_desc: [
		"Magic leaves its mark even on the earth. These stones introduce the materials that shape the Cardinal World."
		""
		"Consult the recipe or source shown in JEI as you prepare this step."
	]
	quest.1A0100000000000A.quest_subtitle: "Mine deep glowing veins below Y=0"
	quest.1A0100000000000A.title: "Magicule Minerals: Magic Stone"
	quest.1A0100000000000B.quest_desc: [
		"Before you can shape enchanted metal, learn the ordinary forge. Mine raw iron and smelt it into ingots; four will supply this first undertaking."
		""
	]
	quest.1A0100000000000B.quest_subtitle: "Another milestone in your journey through the Cardinal World"
	quest.1A0100000000000B.title: "Smelting Foundations: Iron Ingots"
	quest.1A0100000000000C.quest_desc: [
		"Let this milestone become another page in the record of your adventures."
		""
		"Name a mob through the Tensura naming system to earn the native advancement. Consult Controls for your assigned naming key."
	]
	quest.1A0100000000000C.quest_subtitle: "Target a subordinate and press [N] to bestow a Name"
	quest.1A0100000000000C.title: "Bestowing a Name"
	quest.1A0100000000000D.quest_desc: [
		"A chosen art need not bind every future decision. Keep this scroll as an option for reconsidering your skills, rather than a ritual you must perform now."
		""
		"Consult the recipe or source shown in JEI as you prepare this step."
		"Using the reset scroll is optional. This quest does not detect or require a reset."
	]
	quest.1A0100000000000D.quest_subtitle: "Keep a Skill Reset Scroll for an optional change of path"
	quest.1A0100000000000D.title: "Realigning Destiny: Skill Reset Scroll"
	quest.1A0100000000000E.quest_desc: [
		"Another life lies within reach, but changing your lineage deserves thought. Obtain the scroll without using it unless you wish to start that path anew."
		""
		"Consult the recipe or source shown in JEI as you prepare this step."
		"Using the reset scroll is optional. Back up your world before experimenting with a different race."
	]
	quest.1A0100000000000E.quest_subtitle: "Keep a Race Reset Scroll for an optional new lineage"
	quest.1A0100000000000E.title: "Reincarnating Anew: Race Reset Scroll"
	quest.1A0100000000000F.quest_desc: [
		"Some veins carry more than the promise of ordinary metal. Gather Magic Ore as a foundation for later crafts."
		""
	]
	quest.1A0100000000000F.quest_subtitle: "Mine intact blocks of concentrated Magic Ore"
	quest.1A0100000000000F.title: "Excavating Deep Deposits: Magic Ore"
	quest.1A01000000000010.quest_desc: [
		"The first magical alloy marks the beginning of a smith's craft. Prepare Low Magisteel in the kiln before shaping your first equipment."
		""
		"Kiln mixing uses the installed iron/magisteel recipe (iron 8, magisteel 4). These are recipe fluid amounts, not inventory ingot counts."
	]
	quest.1A01000000000010.quest_subtitle: "Smelt iron infused with 10% magicule saturation"
	quest.1A01000000000010.title: "Magical Metallurgy: Low Magisteel Ingot"
	quest.1A01000000000011.quest_desc: [
		"A warrior needs a blade, and a smith needs a place to shape it. Establish your Smithing Bench, then follow the equipment recipes."
		""
	]
	quest.1A01000000000011.quest_subtitle: "Construct Kurobe's dedicated armament forge"
	quest.1A01000000000011.title: "Kurobe's Workshop: The Smithing Bench"
	quest.1A01000000000012.quest_desc: [
		"Your next expedition needs both a tool for the depths and a blade for what waits there. Prepare a Low Magisteel Pickaxe and Sword."
		""
		"Consult the recipe or source shown in JEI as you prepare this step."
	]
	quest.1A01000000000012.quest_subtitle: "Prepare a Low Magisteel Pickaxe and Sword"
	quest.1A01000000000012.title: "Vanguard Kit: Pickaxe and Sword"
	quest.1A01000000000013.quest_desc: [
		"The forge rewards precision as much as patience. Refine your supply into High Magisteel for the next generation of weapons."
		""
		"Kiln mixing uses iron 5 and magisteel 16; inspect the kiln recipe in JEI."
	]
	quest.1A01000000000013.quest_subtitle: "Forge 50% magicule-saturated military steel"
	quest.1A01000000000013.title: "Refined Purity: High Magisteel Ingot"
	quest.1A01000000000014.quest_desc: [
		"Loose shards become a compact reserve for your workshop. Bind nine Magic Ore Shards together; raw Magic Ore is a different ingredient."
		""
		"Craft the compact block with nine Magic Ore Shards, not nine raw Magic Ore items."
	]
	quest.1A01000000000014.quest_subtitle: "Bind nine Magic Ore Shards into a compact reserve"
	quest.1A01000000000014.title: "Compressed Reserves: Magic Ore Block"
	quest.1A01000000000015.quest_desc: [
		"A traveller need not reveal every secret of their presence. Keep the Anti-Magic Mask among the tools of a cautious adventurer."
		""
		"Consult the recipe or source shown in JEI as you prepare this step."
	]
	quest.1A01000000000015.quest_subtitle: "Obtain the mask for your travelling kit"
	quest.1A01000000000015.title: "Spiritual Concealment: Anti-Magic Mask"
	quest.1A01000000000016.quest_desc: [
		"The ore you gathered is ready to take the shape of a weapon. Forge a High Magisteel Sword to close this first chapter."
		""
		"Consult the recipe or source shown in JEI as you prepare this step."
	]
	quest.1A01000000000016.quest_subtitle: "Forge your blade before facing the great trials"
	quest.1A01000000000016.title: "Vanguard Capstone: High Magisteel Sword"
	quest.2A01000000000001.quest_desc: [
		"Every incarnation carries more than one future. These lineages chart the forms your journey may take, not a demand to live every life."
		"Choose your character's family. Record each form before evolving again, since these quests check your current race."
		"Begin this chapter after completing Reincarnation and the Voice of the World."
	]
	quest.2A01000000000001.quest_subtitle: "Another milestone in your journey through the Cardinal World"
	quest.2A01000000000001.title: "The Wheel of Reincarnation"
	quest.2A01000000000002.quest_desc: [
		"A modest body can conceal a remarkable destiny. This lineage follows the changing forms of the slime."
		""
		"Reach Slime to record this stage of your lineage."
		"Open the evolution menu to check the conditions for this form."
	]
