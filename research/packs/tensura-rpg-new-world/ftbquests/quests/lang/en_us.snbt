	quest.4A01000000000018.title: "Lineage Chronicle: Complete a Route"
	quest.5A01000000000001.quest_desc: [
		"Two doors lead into these arcane studies: a bond with spirits, and a grimoire shaped by practice. Neither asks you to abandon the other."
		"Each spirit column follows one element from Lesser to Lord. Links open the same quests recorded in Spirit Ascension, with no second reward. The grimoire path follows Ars Nouveau."
		"Begin this chapter after completing Reincarnation and the Voice of the World."
	]
	quest.5A01000000000001.quest_subtitle: "Spiritual Contracts  Arcane Glyph Sorcery"
	quest.5A01000000000001.title: "&6&lThe Dual Pillars of Magic"
	quest.5A01000000000002.quest_desc: [
		"Flame answers the traveller drawn to the warmth and danger of fire. Begin with a Lesser contract and learn where this element fits your character."
		""
		"Form a Lesser or higher Flame spirit contract."
	]
	quest.5A01000000000002.quest_subtitle: "A Lesser pact with Flame"
	quest.5A01000000000002.title: "Lesser Flame"
	quest.5A01000000000003.quest_desc: [
		"Water offers a bond tied to the element that shapes rivers and seas. Begin with a Lesser contract and learn where this element fits your character."
		""
		"Form a Lesser or higher Water spirit contract."
	]
	quest.5A01000000000003.quest_subtitle: "A Lesser pact with Water"
	quest.5A01000000000003.title: "Lesser Water"
	quest.5A01000000000004.quest_desc: [
		"Earth is the element of a patient pact, rooted in the world beneath your feet. Begin with a Lesser contract and learn where this element fits your character."
		""
		"Form a Lesser or higher Earth spirit contract."
	]
	quest.5A01000000000004.quest_subtitle: "A Lesser pact with Earth"
	quest.5A01000000000004.title: "Lesser Earth"
	quest.5A01000000000005.quest_desc: [
