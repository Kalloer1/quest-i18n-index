	quest.6A01000000000008.quest_subtitle: "Another milestone in your journey through the Cardinal World"
	quest.6A01000000000008.title: "Boss Trial: Charybdis"
	quest.6A01000000000009.quest_desc: [
		"Beyond the familiar roads stands a cathedral of the Silver Night. Seek its map before approaching the trial of Luminous Valentine."
		""
	]
	quest.6A01000000000009.quest_subtitle: "Locate Castle Night Rose in the gothic peaks of Lubelius"
	quest.6A01000000000009.title: "The Silver Night Cathedral"
	quest.6A0100000000000A.quest_desc: [
		"The Silver Night leads to its sovereign. Defeat Luminous Valentine to record this great trial."
		""
		"Defeat 1 x Luminous Valentine (Tensura NEB)."
		"Target entity: tensura_neb:luminous_valentine. You must receive kill credit."
	]
	quest.6A0100000000000A.quest_subtitle: "Another milestone in your journey through the Cardinal World"
	quest.6A0100000000000A.title: "Boss Trial: Luminous Valentine"
	quest.6A0100000000000B.quest_desc: [
		"An encounter with Ifrit is a trial written in flame. Enter prepared and earn the victory yourself."
		""
		"Defeat 1 x Ifrit (Tensura: Reincarnated)."
		"Target entity: tensura:ifrit. You must receive kill credit."
	]
	quest.6A0100000000000B.quest_subtitle: "Another milestone in your journey through the Cardinal World"
	quest.6A0100000000000B.title: "Boss Trial: Ifrit"
	quest.6A0100000000000C.quest_desc: [
		"At the end of these trials waits the storm's own name. Face the NEB version of Veldora Tempest."
		""
		"The Nightmare Sentient Veldora variant is a different entity and does not count for this NEB Veldora trial."
		"Defeat 1 x Veldora (Tensura NEB)."
		"Target entity: tensura_neb:veldora. You must receive kill credit."
	]
	quest.6A0100000000000C.quest_subtitle: "Another milestone in your journey through the Cardinal World"
	quest.6A0100000000000C.title: "Boss Trial: Veldora Tempest"
	quest.6A0100000000000D.quest_desc: [
		"After the great trials, keep one final safeguard close at hand. Obtain a Totem of Undying for dangers still ahead."
		""
		"Consult the recipe or source shown in JEI as you prepare this step."
	]
	quest.6A0100000000000D.quest_subtitle: "Another milestone in your journey through the Cardinal World"
	quest.6A0100000000000D.title: "Conqueror of the Seven Trials"
	quest.7A01000000000001.quest_desc: [
		"The later road is shaped by your incarnation's strength, your equipment and the awakening you pursue. Bring these preparations together."
		"Hero and Demon Lord are alternative paths. EP, Soul Points and vanilla experience are separate measures."
		"Begin this chapter after completing Trials of the Demon Lords and Cataclysms."
	]
	quest.7A01000000000001.quest_subtitle: "The three supreme pillars of celestial omnipotence"
	quest.7A01000000000001.title: "Forging Godhood"
	quest.7A01000000000002.quest_desc: [
		"Your incarnation's strength is measured beyond the equipment you carry."
		""
		"Reach 400,000 maximum EP."
	]
	quest.7A01000000000002.quest_subtitle: "Another milestone in your journey through the Cardinal World"
	quest.7A01000000000002.title: "Existence Milestone: 400,000 EP"
	quest.7A01000000000003.quest_desc: [
		"The Harvest Festival's road asks for Soul Points, rather than a tally of ordinary victories."
		""
		"Reach 10000 Soul Points."
	]
	quest.7A01000000000003.quest_subtitle: "Another milestone in your journey through the Cardinal World"
	quest.7A01000000000003.title: "Soul Harvest: A 10,000-Point Reserve"
	quest.7A01000000000004.quest_desc: [
		"The Harvest Festival marks a turning point in the Demon Lord path. Prepare for the awakening itself."
		""
		"Reach the Tensura awakening state: Demon Lord."
	]
	quest.7A01000000000004.quest_subtitle: "Another milestone in your journey through the Cardinal World"
	quest.7A01000000000004.title: "Harvest Festival: Demon Lord Awakening"
	quest.7A01000000000005.quest_desc: [
		"Your incarnation's strength is measured beyond the equipment you carry."
		""
		"Reach 1,000,000 maximum EP."
	]
	quest.7A01000000000005.quest_subtitle: "Cross into the legendary Million Class of the Octagram"
	quest.7A01000000000005.title: "Cataclysmic Entity: 1,000,000 EP"
	quest.7A01000000000006.quest_desc: [
		"Your incarnation's strength is measured beyond the equipment you carry."
		""
		"Reach 5,000,000 maximum EP."
	]
	quest.7A01000000000006.quest_subtitle: "Surpass mortal and demon lord boundaries to rival the True Dragons"
	quest.7A01000000000006.title: "True Dragon Magnitude: 5,000,000 EP"
	quest.7A01000000000007.quest_desc: [
		"True craftsmanship asks for metal of greater purity. Build a reserve of Pure Magisteel for later armaments."
		""
	]
	quest.7A01000000000007.quest_subtitle: "Refine High Magisteel into iridescent Pure Magisteel"
	quest.7A01000000000007.title: "Master Metallurgy: Pure Magisteel"
	quest.7A01000000000008.quest_desc: [
		"A champion's blade begins long before the battle, at the forge. Shape Pure Magisteel into a Great Sword for the coming trials."
		""
		"Consult the recipe or source shown in JEI as you prepare this step."
	]
	quest.7A01000000000008.quest_subtitle: "Forge the colossal Pure Magisteel Greatsword"
	quest.7A01000000000008.title: "Blade of the Champion"
	quest.7A01000000000009.quest_desc: [
		"Power is of little comfort without protection. Forge a Pure Magisteel Chestplate before challenging more dangerous foes."
		""
		"Consult the recipe or source shown in JEI as you prepare this step."
	]
	quest.7A01000000000009.quest_subtitle: "Forge the Pure Magisteel Chestplate"
	quest.7A01000000000009.title: "Aegis of Tempest"
	quest.7A0100000000000A.quest_desc: [
		"At the far end of the forge's path lies Hihi'irokane. Gather this advanced metal for a seasoned adventurer's armaments."
		""
		"Consult the recipe or source shown in JEI as you prepare this step."
	]
	quest.7A0100000000000A.quest_subtitle: "Smelt the legendary scarlet metal that never rusts or breaks"
	quest.7A0100000000000A.title: "Primordial Metal: Hihi'irokane"
	quest.7A0100000000000B.quest_desc: [
		"Let rare metal become something that stands between you and danger. Craft a Hihi'irokane Chestplate."
		""
	]
	quest.7A0100000000000B.quest_subtitle: "Forge the self-regenerating Hihi'irokane Chestplate"
	quest.7A0100000000000B.title: "Genesis Armament: Celestial Plate"
	quest.7A0100000000000C.quest_desc: [
		"Standard crafting grids cannot bind celestial metals. Construct the Smithing Table to prepare for divine upgrades."
		""
	]
	quest.7A0100000000000C.quest_subtitle: "Prepare the sacred anvil for advanced metallurgy"
	quest.7A0100000000000C.title: "Sacred Smithing: The Smithing Table"
	quest.7A0100000000000D.quest_desc: [
		"Ancient templates provide the structural matrix required to fuse indestructible elements. Acquire a Netherite Upgrade Smithing Template."
		""
	]
	quest.7A0100000000000D.quest_subtitle: "Secure the ancient smithing template"
	quest.7A0100000000000D.title: "Sacred Archetype: Netherite Template"
	quest.7A0100000000000E.quest_desc: [
		"Pure metals require pure magicule saturation to awaken their latent divinity. Obtain a High Quality Magic Crystal."
		""
	]
	quest.7A0100000000000E.quest_subtitle: "Condense high-density magicules for godlike equipment"
	quest.7A0100000000000E.title: "Magicule Matrix: High Quality Magic Crystal"
	quest.7A0100000000000F.quest_desc: [
		"The final stage of forging godhood requires life energy that transcends mortality. Obtain Dragon Essence."
		""
	]
	quest.7A0100000000000F.quest_subtitle: "Harness the primordial essence of True Dragons"
	quest.7A0100000000000F.title: "Apex Catalyst: Dragon Essence"
	quest.7A01000000000010.quest_desc: [
		"An arm worthy of a True Dragon or Awakened Demon Lord. Forge the legendary Hihi'irokane Great Sword to claim absolute martial supremacy."
		""
	]
	quest.7A01000000000010.quest_subtitle: "Forge the world-cleaving Hihi'irokane blade"
	quest.7A01000000000010.title: "Genesis Armament: Hihi'irokane Great Sword"
	quest.7A01000000000012.quest_desc: [
		"Your chronicle reaches its final seal where strength, craftsmanship and proven equipment meet. Bring these three pillars together to close this ascent."
		""
		"Complete True Dragon Magnitude: 5,000,000 EP, Genesis Armament: Celestial Plate, and Genesis Armament: Hihi'irokane Great Sword. All three milestones are required."
		"Keep one Hihi'irokane Ingot in your inventory to complete the final objective. This entry does not require every race, skill or spirit path."
	]
	quest.7A01000000000012.quest_subtitle: "Unite strength, celestial armour and the Hihi'irokane Great Sword"
	quest.7A01000000000012.title: "Godhood Realized: The Three-Pillar Milestone"
