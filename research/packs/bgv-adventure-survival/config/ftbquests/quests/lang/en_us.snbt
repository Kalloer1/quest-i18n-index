	quest.699C8E14223E8223.quest_subtitle: "A strong magical energy still persists within the Rotten Spell Book."
	quest.6A111AA679FD828A.quest_desc: [
		"The Hour hand indicates the current in-game hour while the minute hand ticks every irl second."
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"Its output can be read with a comparator which will give off a signal from 0 to 15 that is proportional to the in-game time which is from 0 to 24."
		"Gives off a block update detectable by an observer each time an in-game hour passes."
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"Clicking on it will display the current time."
		"Like all clocks does not work in the nether."
	]
