	quest.5227EAB65D2DDAD7.quest_desc: [
		"Can store up to 12 cookie like items."
		"Just like cages it can store and capture small mobs."
		"Jars can store up to 12 bottles (or 3k mb) of fluids."
		"Can drink directly from jars, both in item and block form."
	]
	quest.5227EAB65D2DDAD7.quest_subtitle: "Can store cookie like items and fluid."
	quest.52722741E16ADD55.quest_subtitle: "Throw a ball of fire, exploding and dealing massive damage on impact."
	quest.52722741E16ADD55.title: "Fireball"
	quest.52B6BBD4B11D3FC7.quest_desc: ["It's on by default."]
	quest.52B6BBD4B11D3FC7.quest_subtitle: "Gives off a light output that is inversely proportional to its current redstone power."
	quest.52B6BBD4B11D3FC7.title: "Redstone Illuminator"
	quest.52B98FB81E05F53B.quest_subtitle: "The Lightning school is centered around concentrated damage."
	quest.52B98FB81E05F53B.title: "Lightning magic"
	quest.52C7C09BB8289628.quest_subtitle: "BloodThe Blood school is themed around evil; you will find elements of necromancy, wither, and blood magic here, with spells focusing on damage that buffs the caster."
	quest.52C7C09BB8289628.title: "Blood magic"
	quest.531E3FF1F2865C67.quest_subtitle: "Transferring Heat"
	quest.535E4493E31C40F9.quest_desc: [
		"Can be turned on/off by redstone signal or by pressing RMB."
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"If placed next to a fluid containing block show a visual fluid tray right below it if it's active."
		"Can extract items from the inventory below and spill them right below its nozzle with a one second interval."
		"Once it's connected to a fluid containing block behind it can pour those fluids in any possible fluid container block below it. This will only be possible in 250mb increment."
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"Can also interact with blocks below such as concrete powder, dirt (turns to mud) and sugar block."
		"Can dump fluids in sponges effectively voiding them. The same can already be done with lava cauldrons making them ideal \"trash can\" solutions."
	]
	quest.535E4493E31C40F9.quest_subtitle: "Powerful multi purpose block."
	quest.535E4493E31C40F9.title: "Faucet"
	quest.539DF0D4702A77F9.quest_subtitle: "Cast a storm of light around you, creating a defensive walls."
	quest.539DF0D4702A77F9.title: "Solar Storm"
	quest.53A61B0852F62612.title: "Glowing Mushroom Fields"
	quest.53B561A1AFD1FE0E.quest_desc: [
		"If you look down - creates columns around you."
		"If you look to the side - creates a long strip of columns in the direction of your gaze."
	]
	quest.53B561A1AFD1FE0E.quest_subtitle: "Creates columns that deal damage to enemies."
	quest.53DC9A5CF68C84D5.quest_desc: [
		"The quality of the ink affects the power of the scrolls created."
		"Some scrolls only require high-quality ink."
		""
		"They're also craftable!"
	]
	quest.53DC9A5CF68C84D5.quest_subtitle: "Used to create magic scrolls."
	quest.53DC9A5CF68C84D5.title: "Inks"
	quest.53FE99A7964783F7.quest_subtitle: "Some transmuted items can provide permanent buffs."
	quest.54922EBD779EF184.quest_subtitle: "Target one of your magic summons to cause them to explode, killing them instantly, and dealing large damage in the area around them. The summon's remaining health boosts the damage dealt and radius of explosion."
	quest.54922EBD779EF184.title: "Sacrifice"
	quest.54A40A2595B71613.quest_subtitle: "Now you can mine hellstone in the nether."
	quest.54A40A2595B71613.title: "Evil Pickaxe"
	quest.54FA294EAFF09CCF.quest_subtitle: "The Ender school is themed around all things arcane and mystical, with spells that range from damage to utility to mobility."
	quest.54FA294EAFF09CCF.title: "Ender magic"
	quest.55C80A1A9A0C7EF2.quest_desc: [
		"Can move any entities (objects, monsters, players, etc.)"
		"Additionally, entities lose their attraction power while interacting with &aStranded Membrane Block&r."
	]
	quest.55C80A1A9A0C7EF2.quest_subtitle: "Moves objects that come into contact with it."
	quest.5610804960A23D97.quest_desc: [
		"Once powered it will initiate a rotation action which will take time depending on the signal strength it is receiving."
		"The rotation action will continue regardless if the block is powered or not and it's indicated by a red light on the block itself."
		"Rotation frequency (or speed for entities) depends on the redstone power the block has."
		"Rotation period starts at 4 ticks for 15 power and increases linerily until it reaches 60 ticks at 1 power."
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"Toggling the block by right clicking will reverse the rotation direction."
		"Can shuffle inventory content when rotating any inventory block over the horizonta axis."
		"Also constantly rotates entities that are standing on it (only works when facing upwards)."
	]
	quest.5610804960A23D97.quest_subtitle: "Rotates blocks."
	quest.5610804960A23D97.title: "Turn Table"
	quest.5626E43438CCA6BF.quest_desc: [
		"All basic &3Spell Books&r can be crafted from a combination of vanilla and arcane materials."
		"Each futher tier crafted increases the slot count of the spell book and often comes with extra bonuses, increasing the power and quantity of spells it can contain."
	]
	quest.5626E43438CCA6BF.quest_subtitle: "Can hold multiple spells."
	quest.5626E43438CCA6BF.title: "Basic Spell Books"
	quest.5682C80C63F1A63B.quest_subtitle: "Find a golden key by defeating a mother slime in the dungeon."
	quest.56C07209A8A2139E.quest_subtitle: "Shoot a bolt of concentrated arcane magic. Also a trademark of every wizard."
	quest.56C07209A8A2139E.title: "Magic Missile"
	quest.56EED3C96B90A092.quest_desc: [
		"Can be powered with redstone, by right-clicking or by stepping on."
		"When powered will push air infront of it with frequency that is proportional to its redstone power. All the effects here described are affected by this."
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"When pushing air it will push entities that are infront of it away, up to a 5 blocks distance."
		"Speeds up furnace-like blocks that are right next to it."
		"Refreshes fire blocks in-front of it. Fire blocks that are up to a 2 blocks distance will be kept alive indefinitely."
		"Can speed up copper aging if placed right next to one."
		"If placed in front of a wet sponge that is in contact with a soap block they are able to blow bubbles!"
	]
	quest.56EED3C96B90A092.quest_subtitle: "Push air infront of it."
	quest.56EED3C96B90A092.title: "Bellows"
