	]
	quest.603877AB96321F1A.title: "Water Turns Into Brine"
	quest.60900097890FB07F.quest_desc: [
		"Craft the Ruby Laser to detect entities and blocks in its path. "
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"Its beam is invisible unless you wear Ruby Lenses on your head. "
		""
		"Alternatively, place Glass directly in front of the Ruby Laser to make its beam visible. "
		"Stained Glass tints the laser beam."
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"Its block output is proportional to how close the block or entity is. "
		""
		"The laser beam detects block hitboxes. Right-clicking the laser will turn it Tinted, making it only detect blocks and not entities. "
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"Placing Tinted Glass in the path of the laser will shorten it's range without redstone output. Currently only works with Tinted mode."
	]
	quest.60900097890FB07F.quest_subtitle: "Detecting Entities With Optics"
