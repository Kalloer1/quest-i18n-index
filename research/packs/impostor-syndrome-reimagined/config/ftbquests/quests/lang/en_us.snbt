	quest.00000000000000A4.title: "&6Gold&r Leaf"
	quest.00000000000000A8.quest_desc: ["&aNature's Aura&r is about the aura in the world around you: rituals and machines use it, and generators put it back. It all starts with &aBrilliant Fiber&r."]
	quest.00000000000000A8.quest_subtitle: "Brilliant Fiber"
	quest.00000000000000A8.title: "Welcome to &aNature's Aura&r"
