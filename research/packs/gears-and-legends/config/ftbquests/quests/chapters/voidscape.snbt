			x: 0.0d
			y: 1.5d
		}
		{
			dependencies: ["1000000000002601"]
			description: [
				"O vazio está infestado de anomalias. Os **Nulls** são criaturas agressivas que rondam a dimensão."
				""
				"Abata essas entidades para coletar seus resíduos e matérias biológicas corrompidas (como Ossos Carbonizados e Tendões), que serão vitais para a sua forja."
			]
			id: "1000000000002620"
			rewards: [{
