	quests: [
		{
			description: [
				"O fundo do mundo não é o fim."
				""
				"Para acessar a dimensão do Voidscape, você não precisa de um portal tradicional de obsidiana. O segredo é a gravidade e o vazio."
				""
				"**Como Entrar:** Vá até a última camada do Overworld (Y = -60) e fique em pé diretamente sobre um bloco de Bedrock por alguns segundos. A escuridão irá puxá-lo. Alternativamente, você pode simplesmente pular no vazio nas ilhas do The End!"
			]
			id: "1000000000002601"
			rewards: [{
				id: "3000000000002601"
				type: "xp_levels"
				xp_levels: 5
			}]
			shape: "gear"
			size: 1.5d
			tasks: [{
				dimension: "voidscape:void"
				id: "12DDE98560550B06"
				type: "dimension"
			}]
			title: "O Salto no Vazio"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["1000000000002601"]
			description: ["A escuridão se materializa em suas mãos. Ao entrar na dimensão, comece a minerar e explorar para encontrar os cristais que brilham no escuro. Eles são a matéria-prima de tudo."]
			id: "1000000000002602"
			rewards: [{
				count: 2
