		}
		{
			dependencies: ["1000000000002602"]
			description: ["A bancada de trabalho padrão não suporta a física do abismo. Construa a Voidic Forge para conseguir processar os cristais e transformar os restos orgânicos dos Nulls em ligas metálicas."]
			id: "1000000000002603"
