	quest.5500000000000001.quest_desc: ["O AE2 transforma itens físicos em dados. Tudo começa minerando Quartzo de Certus (Certus Quartz) nas cavernas."]
	quest.5500000000000001.title: "A Era Digital"
	quest.5500000000000003.quest_desc: ["Alguns cristais já vêm da terra crepitando com energia eletrostática."]
	quest.5500000000000003.title: "Certus Carregado"
	quest.5500000000000005.quest_desc: ["A tecnologia dos processadores caiu do espaço. Siga a bússola até achar uma cratera de meteoro!"]
	quest.5500000000000005.title: "Bússola de Meteorito"
	quest.5500000000000007.quest_desc: ["A crosta indestrutível do meteoro. Quebre-a para chegar ao baú no centro."]
	quest.5500000000000007.title: "Sky Stone"
	quest.5500000000000009.quest_desc: ["Encontre os 4 Moldes (Presses) no centro do meteoro: Lógica, Engenharia, Cálculo e Silicone."]
	quest.5500000000000009.title: "Os Moldes Antigos"
	quest.550000000000000C.quest_desc: ["Jogue Certus Carregado, Redstone e Quartzo do Nether numa poça de água. Eles vão reagir e virar Fluix!"]
	quest.550000000000000C.title: "O Nascimento do Fluix"
	quest.550000000000000E.quest_desc: ["A espinha dorsal de tudo. Cresça o pó na água para formar os cristais condutores de dados."]
	quest.550000000000000E.title: "Cristal Fluix"
	quest.5500000000000010.quest_desc: ["O cabo mais básico. Transfere energia e até 8 canais (máquinas) simultaneamente."]
	quest.5500000000000010.title: "Cabo de Vidro"
	quest.5500000000000012.quest_desc: ["O AE2 precisa de energia. Conecte cabos elétricos normais aqui para convertê-los em energia AE."]
	quest.5500000000000012.title: "Receptor de Energia"
	quest.5500000000000014.quest_desc: ["Não tem energia elétrica? Sem problemas. Engate engrenagens do Create neste gerador e crie energia AE girando-o!"]
	quest.5500000000000014.title: "Create AE Generator"
	quest.5500000000000016.quest_desc: ["A prensa de circuitos. Coloque os Moldes do meteoro aqui dentro e insira Ouro, Diamante ou Certus para estampar."]
	quest.5500000000000016.title: "O Inscriber"
	quest.5500000000000018.quest_desc: ["Uma prensa mecânica que usa a rotação do Create para estampar os circuitos muito mais rápido!"]
	quest.5500000000000018.title: "Create: Kinetic Inscriber"
	quest.550000000000001A.quest_desc: ["Assente o Molde de Silicone e queime silicone para criar as bases de todos os processadores."]
	quest.550000000000001A.title: "Silicone Impresso"
	quest.550000000000001C.quest_desc: ["Junte um circuito impresso (Ouro/Diamante), um Silicone Impresso e Redstone no Inscriber. Estes processadores são exigidos em TODAS as máquinas do AE2."]
	quest.550000000000001C.title: "Cérebros Digitais (Processadores)"
	quest.550000000000001F.quest_desc: ["Esse cabo tem LEDs que mostram visualmente quantos canais (de 0 a 8) estão sendo usados na sua rede. Essencial para não bugar a fábrica."]
	quest.550000000000001F.title: "Cabo Inteligente"
	quest.5500000000000021.quest_desc: ["A Placa-Mãe. Sem isso, sua rede aceita no máximo 8 máquinas. Cada face do Controller fornece 32 canais extras!"]
	quest.5500000000000021.title: "ME Controller"
	quest.5500000000000023.quest_desc: ["O armário dos HDs digitais. Cada ME Drive comporta até 10 Células de Armazenamento. Insira discos aqui e os itens vão para a nuvem."]
	quest.5500000000000023.title: "A Servidora (ME Drive)"
	quest.5500000000000025.quest_desc: ["O monitor do seu computador. É aqui que você vê todos os milhões de itens guardados no ME Drive."]
	quest.5500000000000025.title: "ME Terminal"
	quest.5500000000000027.title: "Célula 1k"
	quest.5500000000000029.title: "Célula 4k"
	quest.550000000000002B.title: "Célula 16k"
	quest.550000000000002D.title: "Célula 64k"
	quest.550000000000002F.quest_desc: ["Você quebrou a barreira física do armazenamento. Esse chip guarda a fábrica inteira dentro dele."]
	quest.550000000000002F.title: "A MegaCell (1M)"
	quest.5500000000000031.quest_desc: ["O melhor bloco do jogo. Uma bancada de trabalho que pega os itens direto do ME Drive sozinho enquanto você clica."]
	quest.5500000000000031.title: "Terminal de Criação"
	quest.5500000000000033.quest_desc: ["A porta de entrega. Encoste isso numa máquina do Create (como a bacia ou prensa), ensine a receita, e a rede mandará os itens para lá sozinha."]
	quest.5500000000000033.title: "Pattern Provider"
	quest.5500000000000035.quest_desc: ["Encoste no Provider. Ele crafita itens de bancada normais (gravetos, baús, blocos) na velocidade da luz."]
	quest.5500000000000035.title: "Assembler Molecular"
	quest.5500000000000037.quest_desc: ["Você grava o código do item aqui dentro e bota no Provider."]
	quest.5500000000000037.title: "Padrões (Receitas)"
	quest.5500000000000039.quest_desc: ["A memória RAM da rede. Necessária para a rede processar receitas de muitos passos."]
	quest.5500000000000039.title: "CPU de Autocrafting"
	quest.550000000000003B.quest_desc: ["Aumente a memória da sua CPU. Sem isso, a rede não consegue craftar itens complexos de uma vez."]
	quest.550000000000003B.title: "Armazenamento de Craft"
	quest.550000000000003D.quest_desc: ["Adicione isso ao cubo da CPU para a rede usar vários Assemblers ao mesmo tempo. Fica ultra rápido."]
	quest.550000000000003D.title: "Co-Processador"
	quest.550000000000003F.quest_desc: ["Ligue na rede. Emite sinal de internet Wi-Fi para você acessar a base pelo terminal de mão."]
	quest.550000000000003F.title: "Roteador Wireless"
	quest.5500000000000041.quest_desc: ["Todos os milhões de itens do MegaCells e da fábrica na palma da sua mão. Se tiver Booster Card, funciona até em outras dimensões."]
	quest.5500000000000041.title: "Terminal Portátil"
	quest.5500000000000043.quest_desc: ["O Condensador de Matéria. Jogue 256.000 cobblestones lá dentro para amassar tudo numa bolinha pesada."]
	quest.5500000000000043.title: "Lixeira Universal"
	quest.5500000000000045.quest_desc: ["Um buraco negro portátil. Criado pela gravidade do lixo esmagado."]
	quest.5500000000000045.title: "A Singularidade"
	quest.5500000000000047.quest_desc: ["Construa 2 anéis destes. Eles permitem que duas redes AE2 separadas conversem entre si sem NENHUM cabo, mesmo que uma esteja no Overworld e a outra no The End!"]
	quest.5500000000000047.title: "Anel Quântico"
	quest.550F9385BB7C6B71.title: "Matéria Abissal"
	quest.552AA1658EC051A3.title: "Alvo: Basalt Executioner"
	quest.559460A0F4224CB9.title: "Alvo: Jungle Skeleton"
	quest.5595D0A073494EE6.quest_desc: [
		"Uma caixa inteira de alto poder explosivo condensado."
		""
		"Muito mais forte que a TNT comum. Tenha certeza de estar bem longe antes de ativar esse caixote pesado."
	]
	quest.5595D0A073494EE6.title: "Caixote Explosivo"
	quest.55A42E89351968E8.title: "Pernach de Ouro"
	quest.55C4E6B5326969BB.title: "Alvo: Zebra"
	quest.55DA1F6C447BD545.quest_desc: [
		"Junte a Presa do Mapinguari com gravetos para criar o Quebra-Dentes."
		""
		"Esta ferramenta cava a uma velocidade alucinante e ataca muito rápido!"
	]
	quest.55DA1F6C447BD545.title: "O Quebra-Dentes"
	quest.55FFB0B05D6EC30A.quest_desc: ["O fim da jornada Vanilla. Obtenha a Netherite para iniciar a Forja Mítica."]
	quest.55FFB0B05D6EC30A.title: "A Base de Tudo"
	quest.5600000000000001.quest_desc: [
		"O Tom's Simple Storage é a sua rede de dados inicial. Ele não usa energia (FE) e custa apenas madeira e redstone!"
		""
		"O Inventory Connector é o coração da rede. Coloque-o encostado em uma parede de baús, e ele lerá todo o conteúdo deles simultaneamente."
	]
	quest.5600000000000001.title: "O Fim da Bagunça"
	quest.5600000000000002.quest_desc: ["O Inventory Cable conecta os baús mais distantes ao seu Conector central."]
	quest.5600000000000002.title: "Fiação de Madeira"
	quest.5600000000000003.quest_desc: ["O Storage Terminal é a sua tela. Ele permite ver, pesquisar e retirar itens de qualquer baú conectado à rede."]
	quest.5600000000000003.title: "O Monitor Inicial"
	quest.5600000000000004.quest_desc: ["O Inventory Hopper puxa ou empurra itens diretamente da sua rede de baús para fornalhas ou esteiras do Create!"]
	quest.5600000000000004.title: "Automação Básica"
	quest.5600000000000005.quest_desc: ["Dica de Ouro: O Tom's Storage se conecta nativamente ao Sophisticated Storage! Coloque o Conector encostado num Sophisticated Controller e acesse milhares de gavetas instantaneamente."]
	quest.5600000000000005.title: "Integração: Sophisticated"
	quest.5600000000000006.quest_desc: ["O Framed Cable permite que você aplique a textura de QUALQUER bloco nele, escondendo seus cabos perfeitamente dentro da parede!"]
	quest.5600000000000006.title: "Cabo Camuflado"
	quest.5600000000000007.quest_desc: ["Este conector permite ligar um cabo a um baú que esteja 'de costas' para a parede, sem precisar quebrar a estética da sala."]
	quest.5600000000000007.title: "Conector de Cabo"
	quest.5600000000000008.quest_desc: ["O Level Emitter emite um sinal de Redstone com base na quantidade de um item. Ex: 'Desligue a máquina se eu tiver mais de 100 ferros'."]
	quest.5600000000000008.title: "Lógica de Redstone"
	quest.5600000000000009.quest_desc: ["O Open Crate joga tudo que recebe da rede no chão. Perfeito para jogar itens em bacias ou esteiras do Create automaticamente!"]
	quest.5600000000000009.title: "Despejo Físico (Dropper)"
	quest.560000000000000A.quest_desc: ["O Proxy estende a face de um baú. Útil quando você tem muitos cabos e funis brigando por espaço no mesmo bloco."]
	quest.560000000000000A.title: "A Extensão (Proxy)"
	quest.560000000000000B.quest_desc: ["Para disfarçar o Framed Cable: segure o Paint Kit, clique Shift + Direita no bloco que você quer copiar, e depois clique no cabo!"]
	quest.560000000000000B.title: "Kit de Pintura"
	quest.560000000000000C.quest_desc: ["O Trim é puramente estético. Serve para conectar os blocos do mod visualmente sem que eles troquem dados entre si."]
	quest.560000000000000C.title: "Bloco de Acabamento"
	quest.560000000000000D.quest_desc: ["A evolução natural. O Crafting Terminal tem uma mesa de trabalho embutida e puxa os itens dos baús direto para a grade de craft!"]
	quest.560000000000000D.title: "A Bancada Definitiva"
	quest.560000000000000F.quest_desc: ["Insira este filtro dentro do Inventory Hopper para dizer exatamente quais itens devem ser sugados ou ignorados pela automação."]
	quest.560000000000000F.title: "Filtro Simples"
	quest.5600000000000010.quest_desc: ["O Tag Filter permite filtrar por categorias do Minecraft! Em vez de filtrar cada madeira, filtre a tag 'Todas as Madeiras' de uma vez."]
	quest.5600000000000010.title: "Filtro Avançado (Tags)"
	quest.5619D4E3888D35DA.title: "Alvo: Phoenix"
	quest.561FAC154D732F11.title: "Alvo: Librarian Skeleton"
	quest.564451315F479148.title: "Alvo: Phoenix"
	quest.56493499D61468FD.title: "Alvo: Crimson Walker"
	quest.5656AFADFFAA9112.title: "Alvo: Orca"
	quest.565FBD5FFC9C39D4.title: "Alvo: Hermit King"
	quest.568AD70265678BA6.title: "Alvo: Yeti"
	quest.569754DC6D9A1FD7.quest_desc: ["O §eLocation Card§r armazena pontos físicos (Shift + Botão Direito no ar)."]
	quest.569754DC6D9A1FD7.title: "Coordenadas Impressas"
	quest.56E5AD3A94E658A7.quest_desc: [
		"Quebre um Rubi na bancada de trabalho para obter Fragmentos de Rubi (Ruby Shards)."
		""
		"Eles são uma forma muito mais econômica e eficiente de fazer trocas (Bartering) com os Piglins do que gastar suas preciosas barras de ouro!"
	]
	quest.56E5AD3A94E658A7.title: "Economia Piglin"
	quest.5700000000000001.quest_desc: [
		"Cansado de aldeões fugindo, morrendo para zumbis ou causando lag no servidor?"
		""
		"Com os mods Easy Villagers e Easy Piglins, você pode simplesmente chegar perto de um deles, apertar **Sneak + Botão Direito** (ou a tecla configurada, geralmente 'V') e pegar o mob como um item no seu inventário!"
	]
	quest.5700000000000001.title: "Sequestro Legalizado"
	quest.5700000000000003.quest_desc: ["Vá ao Nether e capture um Piglin vivo. Lembre-se de usar uma peça de armadura de ouro para ele não te atacar antes de você guardá-lo no bolso!"]
	quest.5700000000000003.title: "O Porco Capitalista"
	quest.5700000000000005.quest_desc: ["O Barterer é uma máquina maravilhosa. Coloque o Piglin lá dentro e injete Ouro usando funis ou cabos. Ele ficará jogando os itens de escambo (Quartzo, Pérolas do Fim, Poções) na saída automaticamente para sempre!"]
	quest.5700000000000005.title: "Escambo Automático (Barterer)"
	quest.5700000000000007.quest_desc: ["Capture um Villager de uma vila. Ele será a base de todo o seu império industrial a partir de agora."]
	quest.5700000000000007.title: "O Funcionário"
	quest.5700000000000009.quest_desc: ["Coloque 2 Villagers aqui dentro e forneça comida (Pães, Cenouras ou Batatas). Eles vão gerar bebês Villagers infinitamente e guardá-los no estoque do bloco."]
	quest.5700000000000009.title: "Fazenda de Bebês (Breeder)"
	quest.570000000000000B.quest_desc: ["Bebês demoram para crescer. Coloque-os na Incubadora e a máquina fará com que eles se tornem adultos rapidamente, prontos para trabalhar!"]
	quest.570000000000000B.title: "Crescimento Acelerado (Incubator)"
	quest.570000000000000D.quest_desc: ["Coloque um Villager Fazendeiro (com composteira) e uma semente dentro deste bloco. Ele vai plantar e colher sozinho, gerando comida infinita para alimentar o seu Breeder!"]
	quest.570000000000000D.title: "Agricultura Fechada (Farmer)"
	quest.570000000000000F.quest_desc: ["Adeus fazendas de ferro gigantes e feias! Coloque 1 Villager adulto e 1 Zumbi aqui dentro. O pânico fará nascer Golems de Ferro virtuais que morrem na lava da máquina, gerando barras de ferro constantes!"]
	quest.570000000000000F.title: "Geração de Ferro (Iron Farm)"
	quest.5700000000000011.quest_desc: ["O segredo do desconto! Coloque um Villager, uma Maçã Dourada e uma Poção de Fraqueza. A máquina fará um Zumbi morder o aldeão e depois o curará automaticamente, diminuindo os preços dele para 1 Esmeralda!"]
	quest.5700000000000011.title: "Lavagem Cerebral (Converter)"
	quest.5700000000000013.quest_desc: ["Coloque o Villager curado (com preços baixos) dentro deste bloco. Ele ficará em segurança, nunca vai morrer e você pode trocar itens com ele como faria normalmente num espaço de 1x1."]
	quest.5700000000000013.title: "Balcão de Trocas (Trader)"
	quest.5700000000000015.quest_desc: [
		"O nível mais roubado do mod. O Auto Trader faz as trocas sozinho!"
		""
		"Selecione qual troca você quer que ele faça. Injete os itens de entrada (ex: Gravetos) com funis ou cabos, e ele cuspirá as Esmeraldas na velocidade máxima até os estoques recarregarem. Conecte no seu AE2 e seja rico!"
	]
	quest.5700000000000015.title: "A Bolsa de Valores (Auto Trader)"
	quest.57117B66A82A1617.title: "Alvo: Woodland Witchdoctor"
	quest.571D8F50A7312AC8.title: "Alvo: Cave Skeleton"
	quest.571DC6DDDE7C18E0.title: "Alvo: Zebra"
	quest.572A2B0B572E4607.title: "Alvo: Snow Skeleton"
	quest.576F727CA27B1DF7.title: "Alvo: Tree Ent"
	quest.577722BD1874CFF9.quest_desc: ["O Molde dos mares. Busca nas ruínas submersas."]
	quest.577722BD1874CFF9.title: "Molde: Água-Marinha"
	quest.578D0161E167924D.quest_desc: ["Variante de Ouro. Rápida mas frágil."]
	quest.578D0161E167924D.title: "Cutelo de Ouro"
	quest.579A8411D98532B8.title: "Item Avançado"
	quest.57B9CCF84B47A918.quest_desc: [
		"Para usar a energia em movimento, crie a §aChronon Cell§r."
		""
		"Mantenha-a no seu inventário! Ela vai armazenar a energia das suas máquinas e alimentar os Tempads e Upgrades."
	]
	quest.57B9CCF84B47A918.title: "Bateria Temporal"
	quest.5800000000000001.quest_desc: ["Faça um buraco de 2x2 na terra, encha de água, plante 12 flores (ou cogumelos) ao redor da borda inteira e jogue um Diamante na água. Um raio cairá e o portal se abrirá!"]
	quest.5800000000000001.title: "O Portal do Crepúsculo"
	quest.5800000000000003.quest_desc: ["A floresta é infinita. Faça um Magic Map usando uma Pena de Corvo, Torchberries (achadas em cavernas) e Papel. Ele revelará os ícones dos chefes ao seu redor!"]
	quest.5800000000000003.title: "Mapa Mágico"
	quest.5800000000000005.quest_desc: ["Encontre as Ruínas na Floresta Encantada. Alimente a Quest Ram com as 16 cores de lã diferentes do Minecraft para receber blocos preciosos e um troféu secreto!"]
	quest.5800000000000005.title: "Ovelha Mágica (Opcional)"
	quest.5800000000000007.quest_desc: ["Encontre um pátio de pedra (Naga Courtyard). A Naga é uma serpente gigante. Bata no corpo dela para diminuí-la. Pegue as escamas dela para liberar o acesso ao próximo chefe!"]
	quest.5800000000000007.title: "Chefe 1: A Naga"
	quest.5800000000000009.quest_desc: ["Invada a Torre do Lich. Ele tem escudos de ouro! Você precisa rebater as pérolas do Ender que ele atira de volta nele para quebrar os escudos. Matá-lo libera três caminhos diferentes no seu mapa!"]
	quest.5800000000000009.title: "Chefe 2: Twilight Lich"
	quest.580000000000000B.quest_desc: ["Caminho do Fogo: Vá ao Pântano, entre no Labirinto Subterrâneo e mate o Minoshroom. Ele dropará o Meef Stroganoff. COMA-O! Isso te deixará imune ao calor do Fire Swamp."]
	quest.580000000000000B.title: "O Pântano: Minoshroom"
	quest.580000000000000D.quest_desc: ["Sobreviva ao Fire Swamp e ache o covil. A Hydra reflete flechas! Atire ou bata APENAS quando ela abrir a boca para cuspir fogo. O Sangue Ardente (Fiery Blood) dela é valiosíssimo!"]
	quest.580000000000000D.title: "Chefe 3A: A Hydra"
	quest.580000000000000F.quest_desc: ["Caminho das Sombras: Vá até a Dark Forest, encontre a fortaleza dos goblins subterrânea (Stronghold) e derrote os 6 Cavaleiros Fantasmas. Isso abrirá a torre principal!"]
	quest.580000000000000F.title: "A Floresta Escura: Knight Phantoms"
	quest.5800000000000011.quest_desc: ["Suba até o topo da assustadora Dark Tower. Mate os pequenos ghasts perto das armadilhas para carregá-las. Quando a armadilha apitar, ative-a quando o Ur-Ghast gigante estiver perto para sugá-lo!"]
	quest.5800000000000011.title: "Chefe 3B: O Ur-Ghast"
	quest.5800000000000013.quest_desc: ["Caminho do Gelo: Vá à Snowy Forest. Ache a caverna dos yetis e enfrente o Alpha Yeti. O pelo que ele dropa (Yeti Fur) faz armaduras que te protegem da tempestade letal da montanha!"]
	quest.5800000000000013.title: "A Neve: Alpha Yeti"
	quest.5800000000000015.quest_desc: ["Escale o lindo (mas mortal) Palácio da Aurora. A Rainha da Neve voa em um trenó de gelo que anula danos por baixo. Suba nas plataformas e ataque-a na altura do rosto!"]
	quest.5800000000000015.title: "Chefe 3C: Snow Queen"
	quest.5800000000000017.quest_desc: ["A Convergência! Tendo matado a Hydra, o Ur-Ghast e a Snow Queen, a chuva ácida das Highlands parou. Encontre a Caverna dos Trolls, mate-os e ache o Baú com os Feijões Mágicos!"]
	quest.5800000000000017.title: "Os Feijões Mágicos"
	quest.5800000000000019.quest_desc: ["Plante o feijão mágico no Uberous Soil na caverna e ele crescerá até os céus. Suba pelo pé de feijão, encontre a Casa nas Nuvens, mate um Gigante e pegue a Picareta Gigante!"]
	quest.5800000000000019.title: "Acima das Nuvens"
	quest.580000000000001B.quest_desc: ["Desça das nuvens, volte à Caverna dos Trolls e ache o Cubo de Obsidiana Gigante. Use a Picareta Gigante para quebrá-lo e roubar a Lamp of Cinders lá de dentro!"]
	quest.580000000000001B.title: "A Lâmpada das Cinzas"
	quest.580000000000001D.quest_desc: ["O castelo sagrado é cercado por espinhos indestrutíveis que rasgam a sua carne. Equipe a Lamp of Cinders e queime os espinhos para abrir caminho até as portas do Final Castle. Parabéns, você zerou o crepúsculo!"]
	quest.580000000000001D.title: "O Platô Final (Thornlands)"
	quest.5818AFA9DE9C73E2.title: "Alvo: Arid Yeti"
	quest.582251FC8B563A1B.title: "Alvo: Zombified Cultist"
	quest.585C9D88B3C112EF.title: "Alvo: Piglin Executioner"
	quest.58768AC7B8A4698A.title: "Alvo: Piglin Cultist Archer"
	quest.58D4C537CB97506A.title: "Alvo: Piglin Cultist Rider"
	quest.58F77973D1200BF8.title: "Alvo: Witchdoctor"
	quest.5900000000000001.quest_desc: ["O oposto do Nether. Faça um portal de Glowstone (Pedra Luminosa) no formato do portal do Nether e jogue um Balde de Água dentro. Bem-vindo às ilhas flutuantes! Cuidado para não cair no vazio."]
	quest.5900000000000001.title: "O Paraíso Perdido"
	quest.5900000000000002.quest_desc: ["A madeira normal e a pedra do Overworld são fracas aqui. Minere Holystone para criar suas primeiras ferramentas aetherianas. Elas às vezes dropam Ambrosium!"]
	quest.5900000000000002.title: "A Pedra Sagrada"
	quest.5900000000000003.quest_desc: ["O Ambrosium é o 'carvão' do Aether. Ele é usado para tochas, como combustível no Altar e também pode ser comido para curar a sua vida em emergências!"]
	quest.5900000000000003.title: "A Energia do Éter"
	quest.5900000000000004.quest_desc: ["A Zanite é roxa e se comporta de forma estranha: ferramentas de Zanite ficam mais rápidas e fortes conforme a durabilidade delas diminui!"]
	quest.5900000000000004.title: "Minério de Zanite"
	quest.5900000000000005.quest_desc: ["A fornalha mágica. Coloque o Altar no chão, use Ambrosium como combustível e você poderá transformar minérios brutos em materiais puros ou consertar ferramentas!"]
	quest.5900000000000005.title: "O Altar de Encantamento"
	quest.5900000000000006.quest_desc: ["Minere o Gravitite Ore (ele flutua para cima se você quebrar os blocos em cima dele). Depois, asse-o no Altar com Ambrosium para criar a Gravitite Encantada, o metal mais forte do Aether!"]
	quest.5900000000000006.title: "Gravitite Encantada"
	quest.5900000000000007.quest_desc: ["Vestir o set completo de Gravitite permite que você dê saltos absurdos e não sofra dano de queda. Essencial para explorar as ilhas sem morrer."]
	quest.5900000000000007.title: "Armadura Antigravidade"
	quest.5900000000000008.quest_desc: ["Use tochas de Ambrosium na Incubadora para chocar os ovos de Moa que você encontrar pelo mundo. Moas são pássaros gigantes que permitem voar pelo Aether!"]
	quest.5900000000000008.title: "A Incubadora (Moas)"
	quest.5900000000000009.quest_desc: ["Quando o bebê Moa nascer, alimente-o com Aechor Petals (dropadas pelas plantas roxas venenosas). Coloque uma sela nele quando crescer para cruzar os céus!"]
	quest.5900000000000009.title: "O Pássaro Lendário"
	quest.590000000000000A.quest_desc: ["Com o addon Protect Your Moa, o seu pássaro finalmente está seguro! Você não precisa mais ter medo de perdê-lo para sempre caso ele morra no vazio. Aventure-se sem medo!"]
	quest.590000000000000A.title: "Protect Your Moa (Addon)"
	quest.590000000000000B.quest_desc: ["Graças ao addon Deep Aether, as ilhas agora possuem biomas insanos e novos minérios! O Skyjade é uma gema poderosa encontrada nessas novas florestas sombrias e radiantes."]
	quest.590000000000000B.title: "Deep Aether: Skyjade"
	quest.590000000000000C.quest_desc: ["O Stratus é o metal de alto nível do Deep Aether. Combine os minérios raros do addon para forjar ferramentas que rivalizam com as das Dungeons principais!"]
	quest.590000000000000C.title: "Deep Aether: Stratus"
	quest.590000000000000D.quest_desc: ["O Aether não está mais vazio! O addon Aether Villages espalha vilas maravilhosas pelas ilhas. Encontre os habitantes angelicais e troque esmeraldas por recursos únicos da dimensão."]
	quest.590000000000000D.title: "Aether Villages"
	quest.590000000000000E.quest_desc: ["Com o Explore Ruins, o Aether ganha templos abandonados, torres flutuantes e catacumbas secretas cheias de inimigos e baús esquecidos. Aventure-se!"]
	quest.590000000000000E.title: "Explore Ruins: Dungeons"
	quest.590000000000000F.quest_desc: ["Achou um anel ou colar com atributos ruins? A Reforging Table (do addon Treasure Reforging) permite gastar Zanite e Ambrosium para girar a roleta e conseguir atributos perfeitos nos seus acessórios!"]
	quest.590000000000000F.title: "Treasure Reforging"
	quest.5900000000000010.quest_desc: ["Encontre as enormes cavernas de pedra trabalhada nas ilhas. Derrote as Sentinelas e encontre o Slider (Um cubo com olhos gigante). Ataque-o com PICARETAS, não espadas! Pegue a chave de Bronze."]
	quest.5900000000000010.title: "1º Chefe: Masmorra de Bronze"
	quest.5900000000000011.quest_desc: ["Os templos nos céus (parecem panteões gregos). Derrote as Valquírias normais até conseguir 10 Medalhões. Dê os medalhões à Rainha Valquíria para desafiá-la. Ela voa e lança raios. Pegue a chave de Prata e o Machado dela!"]
	quest.5900000000000011.title: "2º Chefe: Masmorra de Prata"
	quest.5900000000000012.quest_desc: ["As peças de armadura da Rainha Valquíria dão a você o poder dos céus. Colete-as nas masmorras de prata!"]
	quest.5900000000000012.title: "Armadura da Valquíria"
	quest.5900000000000013.quest_desc: ["A Ilha Esférica com folhas douradas. O Sun Spirit (Espírito do Sol) governa este lugar. Ele é invencível a ataques normais. Para matá-lo, você deve rebater os blocos de gelo que ele lança de volta nele! O final glorioso do Aether."]
	quest.5900000000000013.title: "3º Chefe: Masmorra de Ouro"
	quest.5900000000000030.quest_desc: ["O metal definitivo da dimensão agora forjado como proteção."]
	quest.5900000000000030.title: "Capacete de Stratus"
	quest.5900000000000031.title: "Peitoral de Stratus"
	quest.5900000000000032.title: "Calça de Stratus"
	quest.5900000000000033.title: "Botas de Stratus"
	quest.5900000000000034.quest_desc: ["Combine gemas para criar acessórios de pescoço!"]
	quest.5900000000000034.title: "Pingente de Zanite"
	quest.5900000000000035.quest_desc: ["Luvas garantem proteção extra nas mãos e habilitam golpes mais eficientes."]
	quest.5900000000000035.title: "Luvas de Zanite"
	quest.5900000000000036.quest_desc: ["As capas são os acessórios de luxo do Éter. Elas voam com o vento e garantem bônus acrobáticos incríves!"]
	quest.5900000000000036.title: "Capa Deslizante"
	quest.5900000000000037.quest_desc: ["O conjunto sagrado das Valquírias."]
	quest.5900000000000037.title: "Capacete de Valquíria"
	quest.5900000000000038.title: "Calça de Valquíria"
	quest.5900000000000039.title: "Botas de Valquíria"
	quest.590000000000003A.quest_desc: [
		"Uma lâmina corrompida."
		""
		"A Vampire Blade drena a força vital dos monstros e cura você a cada acerto!"
	]
	quest.590000000000003A.title: "A Lâmina Vampírica"
	quest.590000000000003B.quest_desc: ["A arma abençoada suprema da masmorra."]
	quest.590000000000003B.title: "A Espada Sagrada"
	quest.590000000000003C.quest_desc: [
		"Forjada nas tempestades celestiais."
		""
		"A linha Stormforged representa um dos equipamentos mais poderosos dos addons do Éter."
	]
	quest.590000000000003C.title: "Capacete Stormforged"
	quest.590000000000003D.title: "Peitoral Stormforged"
	quest.590000000000003E.title: "Calça Stormforged"
	quest.590000000000003F.title: "Botas Stormforged"
	quest.591C0A0A245E590B.quest_desc: ["Cresce em geodos alaranjados sob desertos e terras ermas (Badlands)."]
	quest.591C0A0A245E590B.title: "Cristal: Topázio"
	quest.592B2A522FA15E08.title: "Alvo: Mushlin Spitter"
	quest.595E6FE32DAB38C6.title: "Warglaive de Diamante"
	quest.597BE4144366DFDF.title: "Alvo: Golden Hermit King"
	quest.598E3572ACC14B67.title: "Alvo: Scarecrow"
	quest.59C1798617E5EF28.title: "Alvo: Moss Zombie"
	quest.59CAD790BCFDFED2.title: "Cutelo de Ouro"
	quest.5A2F6347350A39BA.quest_desc: ["Com espadas de pedra e infligindo decomposição, os esqueletos do Wither patrulham os corredores. Consiga os crânios."]
	quest.5A2F6347350A39BA.title: "A Lâmina Sombria"
	quest.5A9E27CBF094B505.title: "Alvo: Piglin Executioner"
	quest.5AD7CDD8E51D3054.title: "Alvo: Snow Skeleton"
	quest.5AD9688E9D4F8C8A.title: "Alvo: Vile Gator"
	quest.5AE41430AECA2E9E.title: "Lança de Ouro"
	quest.5AE7CFC7B186D189.title: "Alvo: Desert Zombie"
	quest.5B06D0866405F2C3.quest_desc: [
		"Inacreditável!"
		""
		"Você completou TODAS as 54 caçadas individuais do mural. Nenhum monstro, variante ou besta gigante escapou da sua lâmina."
		""
		"Receba o prêmio máximo da Guilda."
	]
	quest.5B06D0866405F2C3.title: "Mestre do Bestiário"
	quest.5B556227982A7DD2.quest_desc: [
		"A fusão definitiva de poderes!"
		""
		"O addon Simply Swords: Cataclysm une o seu arsenal ao terrível mod L_Ender's Cataclysm."
		""
		"Agora pode forjar as armas usando 5 materiais apocalípticos. Cada um traz atributos e efeitos passivos únicos."
		""
		"**MECÂNICA DE RECICLAGEM:** Forjou a arma errada ou encontrou uma melhor no chão? Coloque a sua arma numa fornalha e derreta-a! Você recupera os lingotes (ingots) do material exato que a compõe, garantindo que o seu esforço nunca é perdido."
	]
	quest.5B556227982A7DD2.title: "O Cataclismo das Espadas"
	quest.5B6410585A4F109A.title: "Grandsword de Diamante"
	quest.5B8151BFBF1AD9B9.quest_desc: ["Bem-vindo ao Addon MegaCells. Uma única célula dessas guarda MILHÕES de itens."]
	quest.5B8151BFBF1AD9B9.title: "A MEGA Célula (1M)"
	quest.5B8A1AFF55B63C91.title: "Alvo: Moss Zombie"
	quest.5BBDE290A3137555.quest_desc: [
		"A chave para a Forja Mítica. O Necoium é um minério esverdeado encontrado nas ilhas flutuantes do The End."
		""
		"Atua como o catalisador universal. Precisarás dele para fundir qualquer outro cristal num lingote utilizável nos Moldes (Templates) de armadura."
	]
	quest.5BBDE290A3137555.title: "O Núcleo de Necoium"
	quest.5BD797F46F6DE61C.title: "Alvo: Piglin Cultist Rider"
	quest.5BDB8CD967F594CE.title: "Alvo: Glider"
	quest.5C05CFD1E3C2DCE9.quest_desc: [
		"O folclore brasileiro despertou no Minecraft."
		""
		"Prepare-se para explorar novos biomas, realizar rituais sombrios e caçar lendas para forjar equipamentos e feitiços absurdos."
	]
	quest.5C52BCCFC34A77AF.quest_desc: ["As trevas do Undergarden são opressivas. Encontre Ditchbulbs crescendo no chão. Elas emitem luz natural e podem ser usadas para criar poções de Visão Noturna poderosas ou Lanternas Ditchbulb eternas!"]
	quest.5C52BCCFC34A77AF.title: "Luz no Fim do Túnel"
	quest.5C64D18992E2E659.title: "Alvo: Bogged Shadow"
	quest.5C6F94223A7A81D1.quest_desc: ["O Level Emitter emite um sinal de Redstone com base na quantidade de um item na rede. Exemplo: 'Ativar máquina se eu tiver menos de 100 ferros'."]
	quest.5C6F94223A7A81D1.title: "Emissor de Nível"
	quest.5C8B679EBDEF695B.title: "Alvo: Statue Mimic"
	quest.5C9A137F653730C1.title: "Alvo: Magic Skeleton"
	quest.5CA06C9D3C66ED5D.title: "Alvo: Rare Phoenix"
	quest.5CDB40CCDE8A8687.quest_desc: ["A Convergência Total! Vestindo o set completo e inquebrável de Vanadium Steel, com o estômago cheio de elixires do caldeirão e empunhando pergaminhos mágicos antigos... Você transcendeu de um mero visitante para o novo Deus de Icaria!"]
	quest.5CDB40CCDE8A8687.title: "O Panteão de Icaria"
	quest.5CDBDB532E83CDCD.title: "Alvo: Crab"
	quest.5D0BB6404B4BE94C.quest_desc: [
		"A recompensa pelo domínio do combate."
		""
		"A Night Sword possui assustadores 14 de dano base. Ao focar num alvo distante e atacar, ela dispara um corte mágico ('Powerful Slash') que rasga o ar e acerta múltiplos inimigos!"
	]
	quest.5D0BB6404B4BE94C.title: "A Espada da Noite"
	quest.5D76BC32045F38CF.quest_desc: ["O Molde dos mares. Busca nas ruínas submersas."]
	quest.5D76BC32045F38CF.title: "Molde: Água-Marinha"
	quest.5D7DB0168AAB1099.title: "Entre no Abismo"
	quest.5D98B485A55E1B3D.title: "O Chamado do Abismo"
	quest.5DD5F39951208907.title: "Alvo: Desert Skeleton"
	quest.5DD61F8B70307CF0.quest_desc: [
		"Uma arma peculiar e incrivelmente útil."
		""
		"O Frozen Fist atira rajadas de ar frio, congela os inimigos aplicando lentidão brutal e ainda pode ser usado como um Escudo Defensivo ao segurar o botão direito!"
	]
	quest.5DD61F8B70307CF0.title: "Punho Gélido"
	quest.5E085BB648160D2E.quest_desc: [
		"A bruxa jacaré habita os pântanos. Ela é NEUTRA, não a ataque atoa!"
		""
		"Se você jogar o Saci Engarrafado para ela (tecla de atirar), ela devolverá o Cachimbo e o Chapéu mágicos."
	]
	quest.5E085BB648160D2E.title: "Encontre a Cuca"
	quest.5E197C2D032456C8.title: "Alvo: Swamp Skeleton"
	quest.5E2A294852E8E1E0.title: "Alvo: Zombified Cultist"
	quest.5E54E41088609142.quest_desc: [
		"A sua jornada para dominar o espaço-tempo começa com recursos básicos."
		""
		"Obtenha ferro para iniciar a fabricação das primeiras peças de tecnologia da Autoridade de Variância Temporal (TVA)."
	]
	quest.5E54E41088609142.title: "O Início da Linha do Tempo"
	quest.5E5D72880BFA1A65.title: "Grande Katana de Ouro"
	quest.5E6F78901A2B3C4D.quest_desc: [
		"As máquinas não funcionam sozinhas. Você precisa de Força Cinética (SU)."
		""
		"A Roda d'Água (Water Wheel) é a forma mais confiável de começar. Posicione-a na água corrente para que ela comece a girar e conecte um Eixo (Shaft) ao centro dela."
	]
	quest.5E6F78901A2B3C4D.title: "Gerando Energia Cinética"
	quest.5EEBB417890A9DBA.quest_desc: [
		"O Tempad básico tem limites. Faça um upgrade para o §8TVA Tempad§r."
		""
		"Ele possui maior eficiência energética, reduzindo o custo de Chronons por viagem, além de um tempo de recarga menor e capacidade de gerenciar melhor os marcadores."
	]
	quest.5EEBB417890A9DBA.title: "Eficiência da Agência"
	quest.5EF477CA79BA2206.title: "Alvo: Jungle Zombie"
	quest.5F3A8A01FCDC2D8E.quest_desc: [
		"Quer ver a mágica acontecer?"
		""
		"Equipe as Lentes de Rubi (Ruby Lens) na cabeça! Com elas equipadas, os feixes invisíveis dos Lasers de Rubi se tornarão visíveis no mundo."
		""
		"§bDica:§r Você também pode colocar blocos de Vidro Colorido (Stained Glass) na frente do Laser para tingir o feixe com cores diferentes!"
	]
	quest.5F3A8A01FCDC2D8E.title: "Visão Tecnológica"
	quest.5F3C629F641E833D.title: "Alvo: Bone Stalker"
	quest.5F4F2D64F6025F61.quest_desc: ["Variante de Ouro. Rápida mas frágil."]
	quest.5F4F2D64F6025F61.title: "Lâmina Dupla de Ouro"
	quest.5FBB7E7DF3BA3B7B.title: "Alvo: Swamp Skeleton"
	quest.5FE25BDFDCCE8DF6.quest_desc: ["A Armadura da Noite (Night Armor) é tão resistente quanto o ferro e vital para a sua progressão, pois o set concede bônus massivos de Recuperação de Movimento para você rolar mais rápido!"]
	quest.5FE25BDFDCCE8DF6.title: "Peitoral da Noite"
	quest.6000000000000001.quest_desc: ["Na versão 1.21.1, a Indústria do Encantamento foi totalmente reformulada! O primeiro passo é entender que a Experiência (XP) agora é um fluido industrial."]
	quest.6000000000000001.title: "A Magia é um Fluido"
	quest.6000000000000004.quest_desc: ["A Experience Lantern e o Experience Hatch sugam o XP do seu próprio corpo (ou de quem estiver perto) e o transformam em fluido nos canos!"]
	quest.6000000000000004.title: "Drenando Conhecimento"
	quest.6000000000000007.quest_desc: ["O Mechanical Grindstone raspa os encantamentos das armas e armaduras que passam por baixo dele na esteira, gerando XP líquido puro!"]
	quest.6000000000000007.title: "O Rebolo Mecânico"
	quest.600000000000000A.quest_desc: ["O Blaze Enchanter aplica encantamentos automaticamente. Forneça o livro guia, bombeie o XP e ele encantará os itens que passarem!"]
	quest.600000000000000A.title: "O Encantador Flamejante"
	quest.600000000000000D.quest_desc: ["Você precisará de um tanque gigante para armazenar todo esse XP líquido antes de distribuí-lo para as máquinas da sua fábrica."]
	quest.600000000000000D.title: "Tanque de Magia"
	quest.6000000000000010.quest_desc: ["A Impressora (Printer). Coloque um Livro Encantado no topo dela, bombeie XP líquido, e passe livros em branco na esteira por baixo para criar cópias infinitas do encantamento!"]
	quest.6000000000000010.title: "A Gráfica Mágica"
	quest.6000000000000013.quest_desc: ["Use as escamas para forjar a Armadura do Masticator! Um traje de combate biológico e assustador que te dará resistência brutal na exploração final das Catacumbas."]
	quest.6000000000000013.title: "Armadura Viva"
	quest.6000000000000015.quest_desc: ["Armas de fogo são inúteis aqui. O Slingshot é a principal arma de longa distância do mod. Use Blisterberries, Goo ou até mesmo pequenos Rotlings explosivos como munição!"]
	quest.6000000000000015.title: "O Estilingue Biológico"
	quest.6000000000000016.quest_desc: ["Ferramentas com Remendo (Mending) na esteira podem ser consertadas instantaneamente se passarem debaixo de um Spout (Bico) derramando XP líquido."]
	quest.6000000000000016.title: "Reparo Automático"
	quest.6000000000000019.quest_desc: ["O ápice da nova versão! O Blaze Forger permite que você funda encantamentos entre itens e livros com extrema precisão mecânica, substituindo totalmente a velha bigorna!"]
	quest.6000000000000019.title: "A Forja Flamejante"
	quest.600000000000001C.quest_desc: ["Lápis Lazuli é o catalisador. Misture-o com o XP líquido usando o Mechanical Mixer para criar algo além da compreensão mágica."]
	quest.600000000000001C.title: "O Ponto de Ignição"
	quest.600000000000001F.quest_desc: ["O fluido supremo. A Hiper-Experiência permite que o Blaze Enchanter e o Forger quebrem os limites do Minecraft, alcançando encantamentos além do nível máximo normal (Super Enchanting)!"]
	quest.600000000000001F.title: "Hiper-Experiência"
	quest.60730E0CF4CFF560.quest_desc: [
		"O ápice da evolução dos materiais. A Ametrina (Ametrine) é a joia suprema, banhada pela energia do Dragão e do próprio fim."
		""
		"Combinar seus equipamentos com o Template da Ametrina cria o set mais OP disponível no mod. Suas ferramentas quebram blocos numa velocidade insana e sua armadura o torna praticamente inatingível."
	]
	quest.60730E0CF4CFF560.title: "The End: O Poder Absoluto"
	quest.607D5476D0CBD458.quest_desc: [
		"Inacreditável!"
		""
		"Você completou TODAS as 54 caçadas individuais do mural. Nenhum monstro, variante ou besta gigante escapou da sua lâmina."
		""
		"Receba o prêmio máximo da Guilda."
	]
	quest.607D5476D0CBD458.title: "Mestre do Bestiário"
	quest.609A23A29FA36AC8.quest_desc: [
		"O Capelobo não aparece de dia. Você precisará atraí-lo."
		""
		"Consiga Sangue de Cachorro. Pode ser encontrado em baús das estruturas ou trocado com o Clérigo."
	]
	quest.609A23A29FA36AC8.title: "Isca Sombria"
	quest.60AD75F927F5ECBC.title: "Alvo: Yeti"
	quest.60BB745E67743D8F.title: "Alvo: Scarecrow"
	quest.60BDC452A34B6DC2.title: "Alvo: Cave Zombie"
	quest.6100000000000001.quest_desc: [
		"Sua jornada para dominar o espaço-tempo começa com recursos básicos."
		""
		"Obtenha ferro para iniciar a fabricação das primeiras peças de tecnologia da Autoridade de Variância Temporal (TVA)."
	]
	quest.6100000000000001.title: "O Início da Linha do Tempo"
	quest.6100000000000002.quest_desc: [
		"O dispositivo icônico da TVA. O Tempad padrão permite o teletransporte salvando coordenadas."
		""
		"No entanto, para ele funcionar, você precisará entender a infraestrutura de energia (Chronons) que alimenta esse maquinário."
	]
	quest.6100000000000002.title: "Portal de Bolso"
	quest.6100000000000003.quest_desc: [
		"Viagens no tempo e portais não são de graça. Elas consomem §aChronons§r."
		""
		"O §aMetronome§r é a sua primeira máquina de geração de energia. Forneça combustível a ele para que comece a extrair Chronons do ambiente. Sem ele, seu Tempad será apenas um peso de papel."
	]
	quest.6100000000000003.title: "Gerador de Chronons"
	quest.6100000000000004.quest_desc: [
		"O Metronome gera a energia, mas você precisa armazená-la para usar em campo."
		""
		"Crafte uma §aChronon Cell§r (Célula de Cronon). Mantenha este cartucho verde no seu inventário! Ele sugará a energia do Metronome e a fornecerá aos seus dispositivos portáteis sempre que você os usar."
	]
	quest.6100000000000004.title: "Bateria Temporal"
	quest.6100000000000005.quest_desc: [
		"O ferro normal não suporta viagens interdimensionais complexas sem derreter. Você precisa forjar o §7Time Steel§r (Aço Temporal)."
		""
		"Esta liga metálica avançada é o componente base para absolutamente todos os dispositivos pesados da TVA. Forje o suficiente para começar seu império."
	]
	quest.6100000000000005.title: "Aço Temporal"
	quest.6100000000000006.quest_desc: [
		"A infraestrutura pesada da TVA. O §6Time Door Projector§r cria um portal laranja gigante e transitável."
		""
		"Insira um Location Card configurado nele, garanta que há Chronons na sua célula, e ative-o com um sinal de Redstone (como uma alavanca) para abrir a 'Porta do Tempo' retangular."
	]
	quest.6100000000000006.title: "Projetor de Porta do Tempo"
	quest.6100000000000007.quest_desc: [
		"O projetor de porta precisa saber para onde apontar. O §eLocation Card§r armazena locais físicos no espaço-tempo."
		""
		"Segure a tecla Shift e clique com o botão direito (Shift+Right Click) no ar para salvar sua localização exata no cartão, depois insira-o no Projetor."
	]
	quest.6100000000000007.title: "Coordenadas Impressas"
	quest.6100000000000008.quest_desc: [
		"O computador definitivo da TVA. A §3Workstation§r é um bloco fixo que serve como central de comando."
		""
		"Ele funciona de forma similar ao Tempad de bolso, mas gerencia seus Location Cards e rotas com uma tela interativa."
	]
	quest.6100000000000008.title: "Centro de Comando"
	quest.6100000000000009.quest_desc: [
		"Caiu na lava e perdeu tudo? O §aTime Twister§r (Relógio Verde) resolve."
		""
		"Enquanto estiver no seu inventário, ele registra 'eventos' passivos (como a sua morte). Quando você revive, pode abrir o Time Twister para REBOBINAR a linha do tempo e criar um portal direto para o exato local e momento onde você morreu!"
	]
	quest.6100000000000009.title: "Enganando a Morte"
	quest.610000000000000A.quest_desc: [
		"As versões avançadas do Time Twister (§dTVA§r e §eHe Who Remains§r)."
		""
		"Eles guardam um histórico gigantesco das suas ações (não apenas a última morte) e reduzem drasticamente o custo de Chronons para rebobinar."
	]
	quest.610000000000000A.title: "Domínio do Passado"
	quest.610000000000000B.quest_desc: ["Um traje biológico que te dará resistência brutal na exploração final."]
	quest.610000000000000B.title: "Armadura Viva"
	quest.610000000000000C.quest_desc: [
		"Joga multiplayer? Se o seu amigo carregar o §cLocation Broadcaster§r, ele emitirá um sinal contínuo pela rede da TVA."
		""
		"Isso permite que você o encontre em qualquer dimensão."
	]
	quest.610000000000000C.title: "Sinalizador Multiversal"
	quest.610000000000000D.quest_desc: [
		"A outra metade do sistema de rastreio. O §2Screening Device§r capta o sinal dos Broadcasters."
		""
		"Com ele, você pode filtrar guildas, localizar amigos instantaneamente e abrir Time Doors diretas para resgatá-los."
	]
	quest.610000000000000D.title: "Radar da TVA"
	quest.610000000000000E.quest_desc: [
		"O Tempad básico tem limites. Atualize para o §8TVA Tempad§r."
		""
		"Ele consome muito menos energia por salto, carrega mais rápido e é essencial para os viajantes profissionais."
	]
	quest.610000000000000E.title: "Upgrade Profissional"
	quest.610000000000000F.quest_desc: [
		"O Artefato Supremo do Multiverso."
		""
		"O §eHe Who Remains Tempad§r é um achado lendário. Geralmente encontrado em baús das End Cities (Cidades do Fim). Aquele que o possui ganha teletransporte sem custo algum de Chronons e sem tempo de espera. Absoluto."
	]
	quest.610000000000000F.title: "Aquele Que Permanece"
	quest.610185740FC7F4B1.title: "Espada Longa de Ouro"
	quest.612BC2100498C948.title: "Alvo: Revenant"
	quest.61BB47C7D2851FAB.quest_desc: ["A máquina que entrega os itens. Encoste isso num Crafter do Create ou Fornalha, coloque a receita dentro, e a rede injetará os itens quando você pedir!"]
	quest.61BB47C7D2851FAB.title: "Pattern Provider"
	quest.61D92658A2450BFE.title: "Alvo: Red Mummy"
	quest.61FCC22B87C99A05.title: "Alvo: Piglin Cultist Rider"
	quest.62020E516A1789F3.title: "Alvo: Pottergeist"
	quest.6202DC8BF61A9C2C.quest_desc: ["A melhor invenção do mundo. Um terminal com uma bancada de trabalho embutida que acessa todos os itens da rede automaticamente."]
	quest.6202DC8BF61A9C2C.title: "Terminal de Criação"
	quest.6232AED7F3B835A7.quest_desc: ["Crie as Fontes Decorativas de Chocolate! Elas não são só enfeite: você pode mergulhar frutas (como Sweet Berries e maçãs) diretamente no jato de chocolate que jorra da máquina para fazer fondues instantâneos!"]
	quest.6232AED7F3B835A7.title: "A Fonte de Cacau"
	quest.62583D3322942B5F.quest_desc: ["O Storage Terminal é a sua tela. Conecte-o na rede de cabos e você poderá ver, pesquisar e retirar qualquer item de qualquer baú conectado à rede."]
	quest.62583D3322942B5F.title: "O Monitor Inicial"
	quest.626C95780A772C51.title: "Alvo: Red Mummy"
	quest.626D63B369B05564.title: "Alvo: Jungle Skeleton"
	quest.629D911EF4701CFC.quest_desc: ["O Molde dos mares. Busque nas ruínas submersas."]
	quest.629D911EF4701CFC.title: "Molde: Água-Marinha"
	quest.62BF5F31F820B54D.quest_desc: ["O minério que move o mundo. Forje sua primeira armadura e escudo."]
	quest.62C13844185ECE5A.quest_desc: ["Chegamos ao The End. O Molde definitivo esconde-se nas Cidades do Fim."]
	quest.62C13844185ECE5A.title: "Molde: Ametrina"
	quest.62C592CB0CBEEA2E.title: "Alvo: Mummy"
	quest.62C700B78C57BC2B.quest_desc: ["O Create: Ratatouille é a sua estrela Michelin mecânica. Use funis inteligentes e correias transportadoras para lavar os ingredientes, cortá-los em serras adaptadas e enviar tudo para as máquinas de embalagem. Marmitas industriais feitas em massa!"]
	quest.62C700B78C57BC2B.title: "Fábrica Culinária (Ratatouille)"
	quest.62CE93607DEB2582.title: "Alvo: Magic Skeleton"
	quest.6300000000000001.quest_desc: ["O Undergarden é um reino sem luz localizado abaixo do Bedrock. Construa um portal com Stone Bricks no formato do portal do Nether. Forje o Catalyst (Diamante, Ferro e Ouro) e ative a moldura."]
	quest.6300000000000001.title: "Descida às Trevas"
	quest.6300000000000002.quest_desc: ["Depthrock é a pedra fundamental da dimensão. Todas as ferramentas iniciais do Undergarden devem ser feitas combinando Depthrock com gravetos da própria dimensão (nada do Overworld funciona direito)."]
	quest.6300000000000002.title: "A Pedra Profunda"
	quest.6300000000000003.quest_desc: ["A madeira do Overworld apodrece rápido aqui. Colete madeira de Smogstem ou Wigglewood para fazer os cabos firmes das suas novas ferramentas."]
	quest.6300000000000003.title: "Flora Subterrânea"
	quest.6300000000000004.quest_desc: ["Cuidado ao pisar nos pântanos sombrios. O chão é fofo e criaturas letais espreitam sob a névoa. As Gloomgourds (abóboras sombrias) crescem por aqui."]
	quest.6300000000000004.title: "O Pântano Podre"
	quest.6300000000000005.quest_desc: ["O equivalente ao Ferro nesta dimensão, mas muito mais denso e pesado. O Cloggrum é essencial para você sobreviver aos seus primeiros combates reais."]
	quest.6300000000000005.title: "Cloggrum (Nível 1)"
	quest.6300000000000006.quest_desc: ["Encontre Ditchbulbs crescendo direto no chão rochoso. Elas emitem luz natural fortíssima e podem ser usadas para criar Lanternas Ditchbulb eternas!"]
	quest.6300000000000006.title: "Luz no Fim do Túnel"
	quest.6300000000000007.quest_desc: ["A dimensão é infestada pelos Rotspawn, monstros em decomposição. Derrote os Rotwalkers e as imensas Rotbeasts para coletar Fragmentos Utéricos (Utheric Shards)!"]
	quest.6300000000000007.title: "A Praga Apodrecida"
	quest.6300000000000008.quest_desc: ["Armas forjadas com Froststeel aplicam o efeito de Lentidão (Slowness) aos inimigos. Excelente para parar o avanço das feras mais velozes do abismo!"]
	quest.6300000000000008.title: "Froststeel (Nível 2)"
	quest.6300000000000009.quest_desc: ["As Espadas de Utherium causam dano massivo (+1.5x) contra qualquer inimigo da classe Rotspawn. É a lâmina perfeita para desbravar as catacumbas."]
	quest.6300000000000009.title: "Utherium (Nível 3)"
	quest.630000000000000A.quest_desc: ["O Slingshot (Estilingue) é a principal arma de longa distância. Use Pedrinhas (Depthrock Pebbles), Blisterberries ou Goo Balls como munição para castigar os monstros de longe!"]
	quest.630000000000000A.title: "Arma Biológica"
	quest.630000000000000B.quest_desc: ["Além da podridão, você enfrentará os Brutes: primatas gigantes e brutais que protegem o território. Desvie de seus golpes esmagadores e roube suas Presas (Brute Tusks)."]
	quest.630000000000000B.title: "O Brutamontes"
	quest.630000000000000C.quest_desc: ["A Convergência! Você está armado e forjado nas trevas. Desça até as Catacombs, enormes labirintos de pedra no subsolo habitados pela elite morta-viva da dimensão."]
	quest.630000000000000C.title: "As Catacumbas"
	quest.630000000000000D.quest_desc: [
		"Na câmara final aguarda o Forgotten Guardian, um pilar massivo de pedra arcana armado com feitiços letais."
		""
		"A missão será concluída **automaticamente** assim que você der o golpe de misericórdia nele e o jogo te der a Conquista!"
	]
	quest.630000000000000D.title: "Chefe: Forgotten Guardian"
	quest.630000000000000E.quest_desc: ["Você o derrotou! Agora, use o loot dele para forjar o poder absoluto. As armas da classe Forgotten quebram qualquer bloco num piscar de olhos e representam o topo da cadeia alimentar da dimensão."]
	quest.630000000000000E.title: "O Arsenal Esquecido"
	quest.631251C6CAA3CBBA.title: "Alvo: Revenant"
	quest.63275988CA864F57.title: "Alvo: Piglin Cultist Archer"
	quest.633A155BC5442B2C.title: "Alvo: Revenant"
	quest.63518F10D6AE54AA.title: "Pernach de Ouro"
	quest.636E32F2A7DB88AF.title: "Alvo: Swamp Zombie"
	quest.63787D8106818265.title: "Alvo: Zombified Cultist"
	quest.638DFDD45AB1ACB1.quest_desc: [
		"Frio, denso e perdido nas almas. A Safira (Sapphire) só pode ser encontrada nos biomas de §bSoul Sand Valley§r (Vale das Areias das Almas)."
		""
		"Ela é incrivelmente profunda, gerando apenas entre as §bcamadas Y=0 e Y=6§r. Você precisará de paciência e muito cuidado com as lavas escondidas e os Ghasts para minerar essa joia gélida."
	]
	quest.638DFDD45AB1ACB1.title: "Nether: O Frio das Almas"
	quest.63BA411E00692615.title: "Alvo: Cave Zombie"
	quest.63BB9889EA1C67C2.title: "Alvo: Bone Stalker"
	quest.63C3E3C900FCF950.quest_desc: [
		"Quando o Saci aparecer, clique nele com a Peneira para prendê-lo."
		""
		"Seja rápido! Troque para o Frasco de Vidro e clique nele novamente para engarrafá-lo antes que fuja!"
	]
	quest.63C3E3C900FCF950.title: "Saci Engarrafado"
	quest.63CE1E222B26C3DD.quest_desc: [
		"Coloque uma Fogueira das Almas no chão e clique nela segurando o Sangue de Cachorro."
		""
		"O ritual invocará o Capelobo. Mate-o para obter a sua Garra!"
	]
	quest.63CE1E222B26C3DD.title: "O Ritual da Fera"
	quest.63D89C6E9E641A1F.title: "Lâmina Invertida de Diamante"
	quest.63DD56C4927040F3.title: "Alvo: Piglin Cultist Leader"
	quest.63F48A48912AE56F.title: "Alvo: Bogged Bone Stalker"
	quest.63F92109F805C917.quest_desc: [
		"O grande desafio da Galosphere."
		""
		"No fundo do Santuário, você enfrentará o temível Boss Berserker! Ele causa explosões no solo e possui a terrível Maldição de Halite, que transforma Golens e os seus Pets de estimação em Estátuas de Sal Rosa!"
	]
	quest.63F92109F805C917.title: "A Maldição de Halite"
	quest.641B48E4931FF239.quest_desc: ["A sobremesa da sua fábrica. O Create: Chocolate Fountain permite que você derreta chocolate nos Mixers e o bombeie através de canos líquidos (Fluid Pipes) direto para Fontes de Chocolate decorativas. Mergulhe frutas ali e divirta-se!"]
	quest.641B48E4931FF239.title: "A Fonte de Chocolate"
	quest.64309A317DC3DA25.title: "Alvo: Orca"
	quest.6457EB868E6D61E4.quest_desc: [
		"Coloque uma Fogueira das Almas (Soul Campfire) no chão e clique com o botão direito nela segurando o Sangue de Cachorro."
		""
		"O cheiro vai invocar a fera humanoide. Derrote o Capelobo e colete a sua Língua (pode ser cozida e comida) e a sua Garra!"
	]
	quest.6457EB868E6D61E4.title: "O Ritual da Fera"
	quest.6467F0E86BF1B865.title: "Alvo: Cave Zombie"
	quest.6480C60FB054C9B2.quest_desc: ["Cozinhe o Macarrão de Ender Pearl ou assee a grandiosa Torta de Chorus Fruit (Chorus Fruit Pie). Atenção: as propriedades instáveis dessas comidas exóticas podem te dar flutuação ou até te teletransportar aleatoriamente enquanto você mastiga!"]
	quest.6480C60FB054C9B2.title: "O Pique-Nique do The End"
	quest.64AA56B14BBB2C2D.quest_desc: ["Bem-vindo ao Nether. Caça este molde nos Bastiões."]
	quest.64AA56B14BBB2C2D.title: "Molde: Rubi"
	quest.6500000000000001.quest_desc: ["Uma energia desconhecida começou a surgir no mundo. Fragmentos do Abyss podem ser encontrados em cavernas profundas e são o primeiro passo para acessar o poder dessa dimensão."]
	quest.6500000000000001.title: "O Chamado do Abismo"
	quest.6500000000000002.quest_desc: ["A matéria bruta do Abyss é instável, mas extremamente poderosa. Você precisará coletar grandes quantidades para avançar no mod."]
	quest.6500000000000002.title: "Matéria Abissal"
	quest.6500000000000003.quest_desc: ["Ao refinar os materiais do Abyss, você estabiliza sua energia, criando lingotes utilizáveis em armas e equipamentos avançados."]
	quest.6500000000000003.title: "Refinamento Abissal"
	quest.6500000000000004.quest_desc: ["Estruturas misteriosas começaram a surgir pelo mundo. Elas contêm pistas sobre a origem do Abyss e recompensas valiosas."]
	quest.6500000000000004.title: "Sinais do Abyss"
	quest.6500000000000005.quest_desc: ["As ruínas do Abyss são perigosas, mas guardam tecnologia e conhecimento esquecidos."]
	quest.6500000000000005.title: "Ruínas Abissais"
	quest.6500000000000006.quest_desc: ["Os materiais do Abyss podem ser usados para criar dispositivos e ferramentas com propriedades únicas."]
	quest.6500000000000006.title: "Tecnologia Abissal"
	quest.6500000000000007.quest_desc: ["Este dispositivo concentra energia do Abyss. Ele será essencial para progressões futuras."]
	quest.6500000000000007.title: "Dispositivo Instável"
	quest.6500000000000008.quest_desc: ["Você explorou, refinou e dominou a tecnologia do Abyss. Agora todos os caminhos convergem para um único objetivo: poder."]
	quest.6500000000000008.title: "Convergência do Conhecimento"
	quest.6500000000000009.quest_desc: ["Armas do Abyss são extremamente poderosas e necessárias para enfrentar criaturas da dimensão."]
	quest.6500000000000009.title: "Arma Abissal"
	quest.650000000000000A.quest_desc: ["Criaturas do Abyss são agressivas e evoluídas. Derrote algumas para provar seu domínio."]
	quest.650000000000000A.title: "Predadores do Abismo"
	quest.650000000000000B.quest_desc: ["O Abyss é uma dimensão hostil, cheia de perigos e recompensas. Entre por sua conta e risco."]
	quest.650000000000000B.title: "Entrando no Abyss"
	quest.650000000000000C.quest_desc: ["O governante do Abyss representa o ápice do mod. Derrotá-lo significa dominar completamente essa dimensão."]
	quest.650000000000000C.title: "Overlord do Abyss"
	quest.650FFEC14EBD18E7.quest_desc: ["Transfere até 8 Canais (Channels) da sua rede."]
	quest.650FFEC14EBD18E7.title: "Cabo de Vidro"
	quest.654821FB3BF854F5.quest_desc: ["Variante de Ouro. Rápida mas frágil."]
	quest.654821FB3BF854F5.title: "Grão-Martelo de Ouro"
	quest.654C0793E3FC8482.title: "Célula de 64k"
	quest.65529A4818F394DA.title: "Alvo: Scarecrow"
	quest.659022134B589688.title: "Alvo: Zombified Cultist"
	quest.65B2356D30063AAA.quest_desc: ["A forja suprema. Combine os Forgotten Ingots com gravetos de madeira arcana. Ferramentas Forgotten quebram os blocos de toda a dimensão quase que instantaneamente, e as espadas batem tão forte que as feras do Undergarden se curvam perante você. A escuridão foi dominada."]
	quest.65B2356D30063AAA.title: "O Arsenal Esquecido"
	quest.65D8FC458BED3ECB.quest_desc: [
		"O subsolo nunca mais será o mesmo."
		""
		"O mod Galosphere adiciona três novos biomas massivos, novos monstros, estruturas perdidas e engenharia explosiva."
		""
		"Prepare suas picaretas e tochas. Escolha o seu caminho e desbrave os segredos das profundezas!"
	]
	quest.65DC135208E813F7.quest_desc: ["Alguns cristais de Certus já vêm carregados com energia eletrostática. Eles brilham sutilmente."]
	quest.65DC135208E813F7.title: "Certus Carregado"
	quest.65E1E1B2561C8AEB.title: "Alvo: Phoenix"
	quest.65FBD0244B2C7EEB.quest_desc: [
		"O Metronome gera a energia, mas você precisa armazená-la para usar em campo."
		""
		"Crafte uma §aChronon Cell§r. Enquanto ela estiver no seu inventário, ela armazenará os Chronons gerados pelas suas máquinas e fornecerá energia para os seus Tempads e portais."
	]
	quest.65FBD0244B2C7EEB.title: "Bateria Temporal"
	quest.6600000000000001.quest_desc: ["O caminho para o Abismo não requer rituais complexos, apenas materiais puros. Construa a moldura do portal usando Quartzo Liso (Smooth Quartz) e, em vez de fogo, acenda-o jogando um Balde de Lava no interior."]
	quest.6600000000000001.title: "A Fenda de Quartzo"
	quest.6600000000000002.quest_desc: ["Ao atravessar, você encontrará um mundo subterrâneo forrado por pedras escuras e musgos alienígenas. Sua primeira tarefa é minerar os blocos base da dimensão para garantir sua sobrevivência."]
	quest.6600000000000002.title: "A Escuridão Profunda"
	quest.6600000000000003.quest_desc: ["As únicas fontes de cor aqui são os estranhos fungos, vinhas e cristais que crescem pelo chão (azuis, roxos e laranjas). Colete essas amostras para entender a biologia da dimensão."]
	quest.6600000000000003.title: "Flora Bioluminescente"
	quest.6600000000000004.quest_desc: ["Cravado nas paredes escuras, você notará veios de um vermelho intenso. Minere para obter o Crimsonite Bruto, o primeiro metal exclusivo das profundezas."]
	quest.6600000000000004.title: "Minério de Crimsonite"
	quest.6600000000000005.quest_desc: ["Derreta o minério bruto na fornalha para criar os Lingotes de Crimsonite. Eles são a base para o seu primeiro upgrade de equipamento abissal."]
	quest.6600000000000005.title: "Forja Escarlate"
	quest.6600000000000006.quest_desc: ["Crie lâminas e picaretas incrivelmente afiadas usando o metal vermelho. Elas cortam as pedras abissais com muito mais facilidade."]
	quest.6600000000000006.title: "Ferramentas de Crimsonite"
	quest.6600000000000007.quest_desc: ["Proteja-se. A armadura de Crimsonite oferece excelente defesa física contra qualquer perigo que você encontre explorando as cavernas."]
	quest.6600000000000007.title: "Armadura de Crimsonite"
	quest.6600000000000008.quest_desc: ["Procure pelos raríssimos minérios roxos brilhantes. O Amaryllium é uma gema preciosa que concentra a energia latente do Abismo em forma de coração."]
	quest.6600000000000008.title: "O Coração Roxo"
	quest.6600000000000009.quest_desc: ["Processe o material roxo para convertê-lo em Lingotes de Amaryllium. Este é o metal de mais alto nível descoberto nesta dimensão."]
	quest.6600000000000009.title: "Liga de Amaryllium"
	quest.660000000000000A.quest_desc: ["Uma espada forjada de Amaryllium. Leve, indestrutível e capaz de dilacerar a escuridão. O auge do seu poder ofensivo no mod."]
	quest.660000000000000A.title: "O Arsenal das Profundezas"
	quest.660000000000000B.quest_desc: ["O domínio total da dimensão. Vestir a armadura completa de Amaryllium prova que você conquistou as profundezas do abismo e transformou seus minérios no seu maior escudo."]
	quest.660000000000000B.title: "Armadura de Amaryllium"
	quest.6630FB4981AAE8DE.title: "Alvo: Desert Skeleton"
	quest.663B7AA92CC147FE.title: "Alvo: Magic Skeleton"
	quest.663D10CA174D3B4A.title: "Alvo: Piglin Cultist Archer"
	quest.666633099E79CBD9.title: "Alvo: Cave Zombie"
	quest.666E5E0B5CDAE955.quest_desc: ["Forjada com Ancient Metal. Alta durabilidade e atributos sólidos do Cataclysm[cite: 18]."]
	quest.666E5E0B5CDAE955.title: "Rapieira Ancestral"
	quest.6684B392EB118751.quest_desc: ["Forjada com Cursium. Tem a chance de aplicar Accursed Rage, aumentando brutalmente o seu dano[cite: 18]!"]
	quest.6684B392EB118751.title: "Espada Longa Amaldiçoada"
	quest.66A1B90D41D89B5C.title: "Alvo: Snow Skeleton"
	quest.66B01B3B53E249D3.quest_desc: ["Jogue a Singularidade e Pó de Ender no chão, e detone uma TNT perto. Elas se tornarão conectadas quanticamente!"]
	quest.66B01B3B53E249D3.title: "Singularidade Quântica"
	quest.6700000000000001.quest_desc: ["Para entrar nesta dimensão bizarra, você precisa ser encolhido. Encontre uma Colmeia de Abelhas (Bee Nest ou Beehive) no Overworld e jogue uma Pérola do Ender (Ender Pearl) nela! Você será sugado para dentro do mundo do mel."]
	quest.6700000000000001.title: "O Portal de Cera"
	quest.6700000000000002.quest_desc: ["Bem-vindo ao Bumblezone! O mundo inteiro é feito de mel e cera. AVISO: Se você bater em uma abelha ou quebrar blocos de mel perto delas, você ativará a 'Ira da Colmeia' e TODAS as abelhas da dimensão vão caçar você. Use frascos de vidro com cuidado!"]
	quest.6700000000000002.title: "Cuidado Onde Pisa"
	quest.6700000000000003.quest_desc: ["Procure por cristais laranjas brilhantes pelas cavernas de cera. Eles são essenciais para criar equipamentos de ponta no mod e curam muito a sua fome."]
	quest.6700000000000003.title: "Cristais de Mel"
	quest.6700000000000004.quest_desc: ["Mire nas flores gigantes de cristal ou minere blocos de pólen para conseguir Pollen Puffs. Você pode jogar isso em flores para multiplicá-las ou nas abelhas para buffá-las!"]
	quest.6700000000000004.title: "Pólen Mágico"
	quest.6700000000000005.quest_desc: ["Uma estrutura perigosa e confusa! Procure pelas entradas do Cell Maze. Dentro dele há baús com loots raríssimos, mas o labirinto é desenhado para te desorientar."]
	quest.6700000000000005.title: "O Labirinto (Cell Maze)"
	quest.6700000000000006.quest_desc: ["Com os cristais e ferrões (dropados das abelhas irritadas ou achados em baús), você pode forjar a lança e a armadura do Bumblezone. Elas te dão afinidade com as abelhas!"]
	quest.6700000000000006.title: "Armadura do Enxame"
	quest.6700000000000007.quest_desc: ["A Convergência! Explore a dimensão até encontrar o imponente Throne Pillar. No topo desta megaestrutura espiral, cercada de guardas de elite, reside Vossa Majestade Imperial."]
	quest.6700000000000007.title: "O Pilar do Trono"
	quest.6700000000000008.quest_desc: ["Não a ataque! A Bee Queen é pacífica. Clique com o botão direito nela para abrir seu menu de trocas e missões. Ela pedirá que você faça tarefas pela dimensão (como alimentar filhotes ou trazer flores raras)."]
	quest.6700000000000008.title: "A Rainha das Abelhas"
	quest.6700000000000009.quest_desc: ["A recompensa final. Ao completar missões e trocas suficientes com a Rainha, ela lhe concederá a Essence of the Bees. Este artefato místico concede imunidade à Ira da Colmeia, aumento de velocidade e acesso ao poder total da dimensão!"]
	quest.6700000000000009.title: "A Essência Real"
	quest.67090E39C4D67273.title: "Alvo: Piglin Executioner"
	quest.673B18EDFD5CCC09.quest_desc: ["Encontrado exclusivamente na Floresta Carmesim. A fusão com Necoium estabiliza o seu calor."]
	quest.673B18EDFD5CCC09.title: "Cristal: Rubi"
	quest.6756493252C93B38.quest_desc: ["Extrai o Peridoto sob florestas e cavernas verdejantes (Lush Caves). Funde-o com Necoium!"]
	quest.6756493252C93B38.title: "Cristal: Peridoto"
	quest.6762A196D158FC3E.quest_desc: ["Cresce em geodos alaranjados sob desertos e terras ermas (Badlands)."]
	quest.6762A196D158FC3E.title: "Cristal: Topázio"
	quest.6768FAD6B2E60ECC.title: "Alvo: Forest Zombie"
	quest.677F0DDF63CDBEA6.quest_desc: [
		"A criatura mais temida e rara das selvas densas. O Mapinguari tem a força para destruir blocos e esmagar jogadores."
		""
		"Ao derrotá-lo, você pode obter a sua Presa e o seu Olho místico. (O olho, quando usado, concede resistências absurdas contra efeitos negativos!)"
	]
	quest.677F0DDF63CDBEA6.title: "A Besta da Selva"
	quest.67BA7800106EEE65.quest_desc: [
		"Um braseiro decorativo e extremamente útil."
		""
		"Ficar na área de alcance de um Ruby Brazier aceso aplicará passivamente o efeito de Resistência ao Fogo (Fire Resistance) em você, protegendo-o de qualquer acidente."
	]
	quest.67BA7800106EEE65.title: "Aura Protetora"
	quest.67D2CA60ECA544D1.title: "Alvo: Piglin Executioner"
	quest.67E7EB60E821CB28.quest_desc: [
		"Como o rubi do Nether está derretido, você não pode usá-lo imediatamente. Crafte o Freezer!"
		""
		"Esta máquina usa gelo para resfriar os Rubis Derretidos e transformá-los em Rubis sólidos."
		""
		"§eDica de Ouro:§r O Freezer também tem outras utilidades! Ele transforma Creme de Magma em Gosma de Slime e resfria Blocos de Magma transformando-os em Obsidian."
	]
	quest.67E7EB60E821CB28.title: "A Máquina de Gelo"
	quest.67F1309684333897.quest_desc: [
		"O receptor do sinal. Com o §2Screening Device§r (Dispositivo de Rastreio), você capta o sinal de qualquer jogador que esteja usando o Broadcaster."
		""
		"Isso permite que você abra um portal instantâneo para a localização exata do seu amigo, perfeito para resgates ou ataques. Pode ser filtrado por Times/Guildas!"
	]
	quest.67F1309684333897.title: "O Radar da TVA"
	quest.67FA7B96F5CE1530.quest_desc: [
		"O Rubinated Nether não adiciona apenas uma gema, ele adiciona um ecossistema inteiro de utilidades."
		""
		"A sua jornada começa procurando os Rubis Derretidos (Molten Rubies). Eles são gerados naturalmente nas profundezas, perto dos oceanos de lava ou escondidos nos Bastiões dos Piglins."
		""
		"§eAtenção:§r Eles estão fundidos à rocha do Nether. Use uma Picareta de Diamante!"
	]
	quest.67FA7B96F5CE1530.title: "A Gema Fervente"
	quest.6800000000000001.quest_desc: ["O Warden não é mais apenas um monstro a ser evitado, ele é a chave! Vá até a Ancient City (Cidade Ancestral) e enfrente o guardião cego. Ao ser derrotado, ele deixará cair o Heart of the Deep (Coração das Profundezas)."]
	quest.6800000000000001.title: "O Coração da Escuridão"
	quest.6800000000000002.quest_desc: ["No centro da Ancient City existe uma armação de portal gigante feita de Reinforced Deepslate. O truque é o seguinte: Limpe TODAS as veias de Sculk (Sculk Veins) de dentro do arco do portal. Com o centro limpo, clique com o Heart of the Deep na base para acender a fenda!"]
	quest.6800000000000002.title: "A Fenda Adormecida"
	quest.6800000000000003.quest_desc: ["Pule no portal. Bem-vindo a 'The Otherside' (O Outro Lado), a dimensão original de onde a infestação de Sculk surgiu. Um mundo sem céu, com florestas ecoantes e criaturas rastejantes. Traga poções de visão noturna!"]
	quest.6800000000000003.title: "The Otherside"
	quest.6800000000000004.quest_desc: ["Você pode continuar caçando Wardens para obter essas carapaças, mas na Otherside você também poderá encontrá-las vasculhando baús nas profundezas."]
	quest.6800000000000004.title: "A Carapaça do Monstro"
	quest.6800000000000005.quest_desc: ["Forje o equipamento de elite. A Armadura do Warden possui um nível de defesa massivo e vai afastar a vulnerabilidade constante que a dimensão impõe ao seu corpo."]
	quest.6800000000000005.title: "Armadura do Warden"
	quest.6800000000000006.quest_desc: ["A dimensão abriga os Echoing Forests e os Blooming Caverns. Minere as madeiras locais e a Gloomslate para ter blocos de construção resistentes ao abismo."]
	quest.6800000000000006.title: "A Flora Petrificada"
	quest.6800000000000007.quest_desc: ["Uma maravilha da engenharia de Redstone! O Sculk Transmitter capta as vibrações de sons ao redor e as transmite SEM FIO (Wireless) para outros sistemas. É a peça perfeita para criar portas secretas na sua base do Overworld!"]
	quest.6800000000000007.title: "Sculk Transmitter"
	quest.6800000000000008.quest_desc: ["Procure por minérios azulados brilhantes encravados nas paredes da Otherside. O Resonarium é o material precioso exclusivo deste mundo e pulsa com energia."]
	quest.6800000000000008.title: "Minério de Resonarium"
	quest.6800000000000009.quest_desc: ["A Armadura de Resonarium tem uma mecânica única: ela reduz brutalmente o dano que você recebe (cada peça anula 25% de dano). O custo? Ela absorve o impacto e perde durabilidade na velocidade da luz. Use apenas contra chefes!"]
	quest.6800000000000009.title: "Absorção Extrema"
	quest.680000000000000A.quest_desc: ["Derrote as novas monstruosidades do abismo, como os Sludges e os Stalkers, ou explore biomas para obter Soul Crystals (Cristais de Alma). Eles concentram os lamentos das almas presas na Otherside."]
	quest.680000000000000A.title: "Cristais e Almas"
	quest.680000000000000B.quest_desc: ["O Sonorous Staff é a arma mágica absoluta! Forjado com cristais de alma e o coração do abismo. Segure o botão direito para carregar e dispare o terrível 'Sonic Boom' do Warden, atravessando escudos e paredes para aniquilar o alvo! Pode ser encantado com Remendo (Mending)."]
	quest.680000000000000B.title: "O Cajado Sonoro"
	quest.680000000000000C.quest_desc: ["A Convergência! Você obteve as carapaças, o Resonarium e as magias de alma. Explore as trevas até encontrar o colossal Ancient Temple (Templo Ancestral). Mas tome extremo cuidado: quebrar os vasos do templo irá despertar o poderoso miniboss 'Shattered'!"]
	quest.680000000000000C.title: "O Templo Ancestral"
	quest.6888DBC74D7160C4.title: "Foice de Diamante"
	quest.6900000000000001.quest_desc: ["O Warden não é mais apenas um monstro a ser evitado, ele é a chave! Vá até a Ancient City (Cidade Ancestral) e enfrente o guardião cego. Ao ser derrotado, ele deixará cair o Heart of the Deep (Coração das Profundezas)."]
	quest.6900000000000001.title: "O Coração da Escuridão"
	quest.6900000000000002.quest_desc: ["No centro da Ancient City existe uma armação de portal gigante feita de Reinforced Deepslate. O truque é o seguinte: Limpe TODAS as veias de Sculk (Sculk Veins) de dentro do arco do portal. Com o centro limpo, clique com o Heart of the Deep na base para acender a fenda!"]
	quest.6900000000000002.title: "A Fenda Adormecida"
	quest.6900000000000003.quest_desc: ["Pule no portal. Bem-vindo a 'The Otherside' (O Outro Lado), a dimensão original de onde a infestação de Sculk surgiu. Um mundo sem céu, com florestas ecoantes e criaturas rastejantes. Traga poções de visão noturna!"]
	quest.6900000000000003.title: "The Otherside"
	quest.6900000000000004.quest_desc: ["Você pode continuar caçando Wardens para obter essas carapaças, mas na Otherside você também poderá encontrá-las vasculhando baús nas profundezas."]
	quest.6900000000000004.title: "A Carapaça do Monstro"
	quest.6900000000000005.quest_desc: ["Forje o equipamento de elite completo. A Armadura do Warden possui um nível de defesa massivo e vai afastar a vulnerabilidade constante que a dimensão impõe ao seu corpo."]
	quest.6900000000000005.title: "Armadura do Warden"
	quest.6900000000000006.quest_desc: ["A dimensão abriga as Echoing Forests e as Blooming Caverns. Minere as madeiras locais e a Gloomslate para ter blocos de construção resistentes ao abismo."]
	quest.6900000000000006.title: "A Flora Petrificada"
	quest.6900000000000007.quest_desc: ["Uma maravilha da engenharia de Redstone! O Sculk Transmitter capta as vibrações de sons ao redor e as transmite SEM FIO (Wireless) para outros sistemas. É a peça perfeita para criar portas secretas na sua base do Overworld!"]
	quest.6900000000000007.title: "Sculk Transmitter"
	quest.6900000000000008.quest_desc: ["Procure por minérios azulados brilhantes encravados nas paredes da Otherside. O Resonarium é o material precioso exclusivo deste mundo e pulsa com energia."]
	quest.6900000000000008.title: "Minério de Resonarium"
	quest.6900000000000009.quest_desc: ["Forje o set completo. A Armadura de Resonarium tem uma mecânica única: ela reduz brutalmente o dano que você recebe. O custo? Ela absorve o impacto e perde durabilidade na velocidade da luz. Use apenas contra chefes!"]
	quest.6900000000000009.title: "Absorção Extrema"
	quest.690000000000000A.quest_desc: ["Derrote as novas monstruosidades do abismo, como os Sludges e os Stalkers, ou explore biomas para obter Soul Crystals (Cristais de Alma). Eles concentram os lamentos das almas presas na Otherside."]
	quest.690000000000000A.title: "Cristais e Almas"
	quest.690000000000000B.quest_desc: ["O Sonorous Staff é a arma mágica absoluta! Forjado com cristais de alma e o coração do abismo. Segure o botão direito para carregar e dispare o terrível 'Sonic Boom' do Warden, atravessando escudos e paredes para aniquilar o alvo! Pode ser encantado com Remendo (Mending)."]
	quest.690000000000000B.title: "O Cajado Sonoro"
	quest.690000000000000C.quest_desc: ["A Convergência! Você obteve as armaduras, o Resonarium e as magias de alma. Explore as trevas até encontrar o colossal Ancient Temple (Templo Ancestral). Mas tome extremo cuidado: quebrar os vasos do templo irá despertar o poderoso miniboss 'Shattered'!"]
	quest.690000000000000C.title: "O Templo Ancestral"
	quest.690151A383EAD491.quest_desc: [
		"Escondido nas Cavernas de Sal Rosa, você pode tropeçar no Pink Salt Shrine (Santuário de Sal Rosa)."
		""
		"É uma masmorra traiçoeira, cheia de armadilhas mortais feitas de sal grosso e tesouros obscuros."
	]
	quest.690151A383EAD491.title: "O Santuário Proibido"
	quest.6929F6F117EDF14C.quest_desc: ["O monitor onde você enxerga e retira os itens guardados no ME Drive."]
	quest.6929F6F117EDF14C.title: "O Terminal"
	quest.69651F98C59A3909.title: "Warglaive de Ouro"
	quest.699920ABD840E02B.title: "Alvo: Frigid Gator"
	quest.69DD024962BF9F31.quest_desc: ["Invocado com crânios e areia das almas. O Wither destrói tudo ao seu redor. A Estrela do Nether será o troféu final de sua criação mecânica."]
	quest.69DD024962BF9F31.title: "O Deus Caído"
	quest.6A2929D6B996D320.title: "Alvo: Forest Skeleton"
	quest.6A29F35134CD0EEC.quest_desc: [
		"Oculto nas profundezas esmagadoras do oceano. A Água-Marinha (Aquamarine) é o seu passaporte para o domínio dos mares."
		""
		"Procure nos biomas de Deep Ocean. Com esta joia e seu respectivo Template, você ganha vantagens subaquáticas que fariam os próprios Guardiões sentirem inveja."
	]
	quest.6A29F35134CD0EEC.title: "Overworld: Água-Marinha"
	quest.6A3C51F201642013.title: "Lâmina Dupla de Ouro"
	quest.6A55A76916A64472.title: "Alvo: Forest Skeleton"
	quest.6A8F35CA14BE2833.quest_desc: ["Uma iguaria requintada. Esvazie a abóbora, recheie com carne e legumes nobres. Além do Nourishment gigantesco, ela decora salões de jantar como nenhuma outra comida."]
	quest.6A8F35CA14BE2833.title: "Banquete Nível 2: Abóbora Recheada"
	quest.6A9178FAD5F22AFF.quest_desc: ["O The End é frio, mas tem frutos mágicos. O Ender's Delight transforma as bizarras carapaças do Shulker e o pó de Enderman em especiarias. Prepare rolos de arroz envoltos em musgo do fim."]
	quest.6A9178FAD5F22AFF.title: "Sabores do Vazio"
	quest.6AC99F053EA24D2E.quest_desc: ["Ligue no sistema para emitir sinal de Wi-Fi. Coloque Infinity Booster Cards nele para acessar a base de qualquer dimensão!"]
	quest.6AC99F053EA24D2E.title: "Roteador Wireless"
	quest.6ADE4CAEFBC4D705.title: "Alvo: Forest Zombie"
	quest.6AE1332627E9C78F.title: "Alvo: Crimson Walker"
	quest.6B716B05B3754D8E.quest_desc: ["No centro do meteorito há um baú. Nele você encontrará os 4 moldes (Presses) necessários para criar cérebros digitais."]
	quest.6B716B05B3754D8E.title: "Os Moldes Perdidos"
	quest.6B86B7E19AD0632F.quest_desc: ["Forjada com Cursium. Tem a chance de aplicar Accursed Rage, aumentando brutalmente o seu dano[cite: 18]!"]
	quest.6B86B7E19AD0632F.title: "Rapieira Amaldiçoada"
	quest.6BBC469083B6B134.quest_desc: ["Encontrado exclusivamente na Floresta Carmesim (Nether)."]
	quest.6BBC469083B6B134.title: "Cristal: Rubi"
	quest.6BF0F64C1928DCC9.title: "Alvo: Desert Zombie"
	quest.6C0FB3973964320D.quest_desc: [
		"Quer controlo total sobre os seus portais físicos? O §bTime Door Marker§r (Marcador de Portal) é essencial."
		""
		"Use estes blocos para marcar o local exato onde o portal deve abrir, controlando onde os jogadores vão reaparecer e ligando-o à sua rede fixa de Projectors."
	]
	quest.6C0FB3973964320D.title: "Estrutura do Portal"
	quest.6C253A49565E0A1B.quest_desc: ["O Kettle (Caldeirão) é o ápice da sua culinária aqui. Ferva águas, jogue frutas icarianas, cogumelos nativos e restos de monstros para criar Caldos curativos e Elixires com buffs impossíveis de se achar no Minecraft Vanilla."]
	quest.6C253A49565E0A1B.title: "Alquimia (O Caldeirão)"
	quest.6C3A627A8E303C8B.title: "Alvo: Basalt Executioner"
	quest.6C5E721BDD33650C.title: "Alvo: Crimson Walker"
	quest.6C75072CEC60DBF4.title: "Chifres de Cervo (Ouro)"
	quest.6C8EAF77D5BC3245.title: "Peitoral Vermelho"
	quest.6CA9872C252A0476.title: "Grandsword de Ouro"
	quest.6CB63CB87DB6E6FD.title: "Foice de Ouro"
	quest.6CC4177A78370961.quest_desc: ["Guardiões das Fortalezas do Nether. Suas varas são necessárias para preparar poções e encontrar fortalezas do fim."]
	quest.6CC4177A78370961.title: "Chamas Flutuantes"
	quest.6CC69D7D66281B99.title: "Alvo: Cave Zombie"
	quest.6CCD525D3C4B1190.title: "Alvo: Piglin Cultist Archer"
	quest.6CCE1E27184BCF4A.title: "Chakram de Diamante"
	quest.6CDA4C863AC41532.title: "Alvo: Cave Zombie"
	quest.6CE0D6EA98BE2ACF.quest_desc: ["Escondido bem fundo no Soul Sand Valley (Vale das Areias das Almas)."]
	quest.6CE0D6EA98BE2ACF.title: "Cristal: Safira"
	quest.6CF7083723BC5AD6.quest_desc: ["Por que usar fios quando você tem engrenagens? O AE Generator (do addon) permite que você gire a máquina com força mecânica (SU) para alimentar a sua rede AE2 diretamente!"]
	quest.6CF7083723BC5AD6.title: "Create: AE Generator"
	quest.6CFCCD4C48F8CA5B.quest_desc: [
		"A arma suprema."
		""
		"Na Bancada de Ferraria, junte o Quebra-Dentes com o Couro Flamejante e uma Vara de Blaze. O Quebra-Fogo causa 10.5 de dano e incendeia os inimigos!"
	]
	quest.6CFCCD4C48F8CA5B.title: "A Arma de Fogo"
	quest.6D73BD1BB2AD38A5.quest_desc: [
		"O mod Rubinated Nether traz os rubis descartados pela Mojang de volta ao jogo!"
		""
		"Eles não servem para fazer ferramentas comuns, mas sim para utilidades incríveis. Você encontrará os Rubis Derretidos (Molten Rubies) nas profundezas do Nether, geralmente perto dos oceanos de lava ou nos Bastiões dos Piglins."
		""
		"Lembre-se: Use uma Picareta de Diamante para minerá-los!"
	]
	quest.6D73BD1BB2AD38A5.title: "A Gema Fervente"
	quest.6DABCC9857D7DBE6.title: "Alvo: Pottergeist"
	quest.6DAF69ED95B40B52.title: "Alvo: Magic Skeleton"
	quest.6DBDE1642AA55E5F.title: "Alvo: Piglin Cultist"
	quest.6E17D53FF438A94D.title: "Caçador do Abyss"
	quest.6E1DECB0A4FC3DCC.title: "Alvo: Tree Ent"
	quest.6E489666C579632F.quest_desc: [
		"A fusão definitiva de poderes!"
		""
		"O addon Simply Swords: Cataclysm une o seu arsenal ao terrível mod L_Ender's Cataclysm."
		""
		"Agora pode forjar as armas usando 5 materiais apocalípticos. Cada um traz atributos e efeitos passivos únicos."
		""
		"**MECÂNICA DE RECICLAGEM:** Forjou a arma errada ou encontrou uma melhor no chão? Coloque a sua arma numa fornalha e derreta-a! Você recupera os lingotes (ingots) do material exato que a compõe, garantindo que o seu esforço nunca é perdido."
	]
	quest.6E489666C579632F.title: "O Cataclismo das Espadas"
	quest.6E6B100B889EC442.title: "Alvo: Librarian Skeleton"
	quest.6E894FA613CE4048.title: "Alvo: Butterfly"
	quest.6E8F1BBA4EFEE82A.title: "Alvo: Piglin Ghost"
	quest.6E972611328D5746.quest_desc: ["O Molde supremo das ilhas do fim."]
	quest.6E972611328D5746.title: "Molde: Ametrina"
	quest.6EDCAEBC034465BC.title: "Alvo: Magic Zombie"
	quest.6EEDAA366B6C87EC.title: "Alvo: Frigid Gator"
	quest.6F55AC00C3EE15AE.title: "Alvo: Piglin Cultist"
	quest.6FA96642D447D4F3.quest_desc: ["Um cristal vermelho que pulsa de raiva. As ferramentas e espadas feitas de Utherium dão DANO MASSIVO (Multiplicador de +1.5x) contra qualquer inimigo da classe 'Rotspawn' (Monstros Apodrecidos do Undergarden). Use isso nas Catacumbas!"]
	quest.6FA96642D447D4F3.title: "Utherium (Nível 3)"
	quest.6FC6CC26CF04A5BA.quest_desc: [
		"A chave para a Forja Mítica. O Necoium é um minério esverdeado encontrado nas ilhas flutuantes do The End."
		""
		"Atua como o catalisador universal. Precisarás dele para fundir qualquer outro cristal num lingote utilizável nos Moldes (Templates) de armadura."
	]
	quest.6FC6CC26CF04A5BA.title: "O Núcleo de Necoium"
	quest.7000000000000001.quest_desc: [
		"Bem-vindo à Física Nuclear. Errar aqui significa transformar sua base numa cratera radioativa."
		""
		"Comece minerando: Chumbo (Lead) para proteção, e Autunita (Autunite) para o Urânio Bruto."
	]
	quest.7000000000000001.title: "A Era Atômica"
	quest.7000000000000004.quest_desc: ["O Chumbo (Lead) é o material que bloqueia a radiação. Derreta os minérios brutos em lingotes. Sem eles, você está morto antes mesmo de começar a montar a usina."]
	quest.7000000000000004.title: "O Escudo de Chumbo"
	quest.7000000000000005.quest_desc: ["O Chumbo (Lead) bloqueia a radiação. Derreta os minérios em lingotes imediatamente."]
	quest.7000000000000005.title: "O Escudo de Chumbo"
	quest.7000000000000006.quest_desc: ["Filtra as partículas radioativas do ar. Feito com chumbo."]
	quest.7000000000000006.title: "Capacete Hazmat"
	quest.7000000000000007.quest_desc: ["Filtra as partículas radioativas do ar."]
	quest.7000000000000007.title: "Capacete Hazmat"
	quest.7000000000000008.quest_desc: ["A peça central da sua segurança. Um colete pesado que protege seus órgãos vitais da radiação ionizante."]
	quest.7000000000000008.title: "Peitoral Hazmat"
	quest.7000000000000009.quest_desc: ["A peça central da sua segurança. Colete pesado de chumbo."]
	quest.7000000000000009.title: "Peitoral Hazmat"
	quest.700000000000000A.quest_desc: ["Protege contra a contaminação direta."]
	quest.700000000000000A.title: "Calças Hazmat"
	quest.700000000000000B.quest_desc: ["Isolamento contra a contaminação direta."]
	quest.700000000000000B.title: "Calças Hazmat"
	quest.700000000000000C.quest_desc: ["O chão de um reator pode estar severamente contaminado. Isole seus pés!"]
	quest.700000000000000C.title: "Botas Hazmat"
	quest.700000000000000D.quest_desc: ["O chão de um reator é mortal. Isole seus pés!"]
	quest.700000000000000D.title: "Botas Hazmat"
	quest.700000000000000E.quest_desc: [
		"ATENÇÃO: A partir daqui, você lidará com Urânio Enriquecido. A radiação causa dano celular irreversível e o efeito 'Altered Vision'."
		""
		"NUNCA manuseie combustível nuclear sem o traje completo equipado!"
	]
	quest.700000000000000E.title: "Proteção Total"
	quest.700000000000000F.quest_desc: [
		"ATENÇÃO: A partir daqui, você lidará com Enriched Yellowcake."
		""
		"Vista o traje completo ou a radiação o consumirá de dentro para fora!"
	]
	quest.700000000000000F.title: "Proteção Total"
	quest.7000000000000011.quest_desc: ["Jogue a Autunita (minério bruto) nas Crushing Wheels do Create para obter o Urânio Esmagado (Crushed Raw Uranium)."]
	quest.7000000000000011.title: "Moagem de Autunita"
	quest.7000000000000012.quest_desc: ["Moa a rocha para extrair o pó de urânio."]
	quest.7000000000000012.title: "Moagem de Autunita"
	quest.7000000000000013.quest_desc: ["A nova mecânica da 1.21.1! Crie um Enriching Campfire. Você usará o calor desta fogueira especial para purificar o urânio esmagado."]
	quest.7000000000000013.title: "Fogueira de Enriquecimento"
	quest.7000000000000014.quest_desc: ["Use esta fogueira especial para aquecer o pó e transformá-lo na base do combustível."]
	quest.7000000000000014.title: "Fogueira de Enriquecimento"
	quest.7000000000000015.quest_desc: [
		"Você conseguiu! O Yellowcake é o Urânio Enriquecido. Ele brilha, esquenta e emite radiação pura."
		""
		"Curiosidade: Na nova atualização, você pode tentar comê-lo... mas eu definitivamente não recomendo."
	]
	quest.7000000000000015.title: "Yellowcake (Bolo Amarelo)"
	quest.7000000000000016.quest_desc: ["O primeiro estágio do enriquecimento. Guarde com cuidado."]
	quest.7000000000000016.title: "Yellowcake (Bolo Amarelo)"
	quest.7000000000000017.quest_desc: ["Passe o Urânio bruto pelas Crushing Wheels do Create. Esse é o primeiro passo para o enriquecimento."]
	quest.7000000000000017.title: "Urânio Esmagado"
	quest.7000000000000018.quest_desc: ["Comprima o Yellowcake e coloque em cilindros para criar as Fuel Rods. É isso que vai para dentro do reator."]
	quest.7000000000000018.title: "Varetas de Combustível"
	quest.7000000000000019.quest_desc: ["Uranium Rods! Esse é o combustível que será injetado pelo Reactor Input."]
	quest.7000000000000019.title: "Varetas de Combustível"
	quest.700000000000001A.quest_desc: ["O Grafite atua como um 'moderador' nuclear. Ele segura os nêutrons e impede que sua base vire a próxima Chernobyl."]
	quest.700000000000001A.title: "Pó de Grafite"
	quest.700000000000001B.quest_desc: ["Sem isso, você construirá no escuro. Segure o Reactor Blueprint e aponte. Ele projetará um holograma indicando onde cada bloco exato da usina deve ser colocado."]
	quest.700000000000001B.title: "A Planta (Blueprint)"
	quest.700000000000001C.quest_desc: ["Use chumbo e grafite para fazer os Reactor Casings. O reator precisa estar selado com essas paredes para a radiação não escapar."]
	quest.700000000000001C.title: "Carcaça Blindada"
	quest.700000000000001D.quest_desc: ["Os Reactor Casings selam o reator. Forjados com Aço e Chumbo, eles garantem que a radiação letal do Enriched Yellowcake fique presa lá dentro."]
	quest.700000000000001D.title: "Carcaça Blindada"
	quest.700000000000001E.quest_desc: ["Quer olhar para o brilho mortal do núcleo em segurança? Use o Reactor Glass. Vidro comum vai derreter e deixar a radiação vazar."]
	quest.700000000000001E.title: "Vidro de Contenção"
	quest.700000000000001F.quest_desc: ["Use o Reactor Glass para poder observar o núcleo e as hastes em segurança."]
	quest.700000000000001F.title: "Vidro de Contenção"
	quest.7000000000000020.quest_desc: ["As Control Rods ficam no topo do reator. Se a temperatura subir muito, empurre elas para baixo mecanicamente para desacelerar a reação e evitar o derretimento!"]
	quest.7000000000000020.title: "Hastes de Controle"
	quest.7000000000000021.quest_desc: [
		"O antigo 'Control Rod' metálico não existe mais! Na física real, e nesta atualização, o material que absorve os nêutrons é o Grafite."
		""
		"Forje Graphite Rods (Varetas de Grafite) e posicione-as no topo do reator. Elas agem como as suas hastes de controle da usina."
	]
	quest.7000000000000021.title: "Varetas de Grafite (Controle)"
	quest.7000000000000022.quest_desc: [
		"Chegou a hora. Monte a estrutura."
		"Coloque o Reactor Core no centro. Insira as Varetas de Combustível, sele com a carcaça de chumbo e afunde as Hastes de Controle."
	]
	quest.7000000000000022.title: "O Coração Atômico"
	quest.7000000000000023.quest_desc: [
		"Tudo convergiu. Você tem as peças da gaiola, o controlador, as entradas e o combustível."
		""
		"Erga a estrutura baseada no Blueprint. Clique no Controller para ativar a máquina. Alimente o Input com Água e Urânio."
	]
	quest.7000000000000023.title: "A Montagem do Multibloco"
	quest.7000000000000025.quest_desc: ["Para não explodir, você precisa injetar refrigerante constantemente! Use canos para bombear Água (ou Água Pesada) para dentro da estrutura."]
	quest.7000000000000025.title: "Resfriamento Ativo"
	quest.7000000000000026.quest_desc: ["Ligue as bombas d'água! Injete água sem parar no reator ou a temperatura do Enriched Yellowcake derreterá tudo em um raio gigantesco."]
	quest.7000000000000026.title: "Resfriamento Ativo"
	quest.7000000000000027.quest_desc: [
		"Todo esse perigo tem um único objetivo: Fervura Suprema."
		""
		"A água que entra no reator vira vapor instantaneamente. Conecte caldeiras (Steam Engines) à saída de vapor e veja seus motores gerarem milhões de SU sem parar. Você venceu a engenharia!"
	]
	quest.7000000000000027.title: "Fissão Termonuclear"
	quest.7000000000000028.quest_desc: [
		"O reator está vivo."
		""
		"A água que entra pelo Input evapora violentamente e sai pelo Output como Vapor (Steam). Conecte Steam Engines na saída e veja o poder de milhões de SU dominarem sua fábrica!"
	]
	quest.7000000000000028.title: "Fissão Termonuclear"
	quest.7000000000000029.quest_desc: ["Para impedir que o reator evapore o seu mundo, você precisa injetar refrigerante constantemente. A Água Pesada (Heavy Water) é infinitamente superior à água normal."]
	quest.7000000000000029.title: "Resfriamento: Água Pesada"
	quest.700000000000002C.quest_desc: ["As Control Rods ficam na parte superior do Reator. Se a temperatura subir muito, use componentes mecânicos (Pistões do Create) para abaixar as hastes e frear a reação!"]
	quest.700000000000002C.title: "Haste de Controle"
	quest.700000000000002F.quest_desc: ["O Reactor Core. Posicione-o no centro da sua estrutura de Reactor Casings. Insira as Varetas de Urânio, ligue a injeção de água, levante as Hastes de Controle e fuja!"]
	quest.700000000000002F.title: "O Coração Atômico"
	quest.7000000000000030.quest_desc: ["A matéria prima altamente instável. Usar traje é obrigatório!"]
	quest.7000000000000030.title: "Enriched Yellowcake"
	quest.7000000000000032.quest_desc: ["Todo esse calor mortal tem um único propósito: ferver água a níveis absurdos. Conecte o calor do reator às caldeiras (Steam Engines) do Create. Você vai gerar Força Cinética (SU) em uma escala que fará suas rodas d'água parecerem brinquedos de criança. Bem-vindo ao Fim de Jogo."]
	quest.7000000000000032.title: "A Usina Termonuclear"
	quest.7000000000000033.quest_desc: ["O Reactor Controller. Coloque-o no local indicado pelo holograma. Quando construir a estrutura inteira ao redor dele, clique nele para formar o reator."]
	quest.7000000000000033.title: "O Cérebro (Controller)"
	quest.7000000000000035.quest_desc: ["Paredes de contenção. Forje Aço e Chumbo para fazer a carcaça blindada e os vidros de proteção térmica."]
	quest.7000000000000035.title: "A Gaiola (Casing e Glass)"
	quest.7000000000000038.quest_desc: ["Os Reactor Coolers ficam dentro da estrutura para estabilizar o calor. Se esquecer deles, é Meltdown na certa."]
	quest.7000000000000038.title: "Prevenção de Derretimento"
	quest.700000000000003A.quest_desc: [
		"Reactor Input: Conecte canos de água e funis jogando Varetas de Urânio AQUI."
		"Reactor Output: Puxe o Vapor (Steam) superaquecido por canos e extraia o lixo radioativo (Depleted Rods) por AQUI."
	]
	quest.700000000000003A.title: "Automação: Input / Output"
	quest.702ABD208C419179.title: "Alvo: Hermit King"
	quest.7041D55AD1F738D8.title: "Alvo: Crimson Walker"
	quest.706863330ADA3018.title: "Alvo: Pottergeist"
	quest.70956EB862FE701E.title: "Alvo: Basalt Executioner"
	quest.70AE9137002484D5.title: "Alvo: Rare Phoenix"
	quest.70C30216A1E8F6FA.title: "Alvo: Desert Zombie"
	quest.70D642A71EEB40E6.title: "Adaga Oculta de Diamante"
	quest.70E91A0F982BCC31.quest_desc: [
		"Múltiplas dinamites amarradas em um único feixe."
		""
		"Esta é a sua melhor amiga para mineração em massa e limpeza de terreno. Ela abre crateras consideráveis sem o perigo de um atraso de pavio tão longo."
	]
	quest.70E91A0F982BCC31.title: "Limpeza de Terreno"
	quest.70F267FADC738A08.title: "Alvo: Moss Zombie"
	quest.7100000000000001.quest_desc: ["A entrada para Icaria não é livre, e a chave está no inferno. Vá ao Nether e cace os 'Revenant Pyromancers', mortos-vivos encapuzados que atiram explosivos verdes. Derrote-os para roubar a Granada de Fogo Grego (Greek Fire Grenade)!"]
	quest.7100000000000001.title: "O Segredo do Nether"
	quest.7100000000000002.quest_desc: ["O portal para Icaria é uma obra de arte. Usando Blocos e Pilares de Quartzo, construa uma armação no formato de um arco grego (dois pilares espaçados de cada lado, conectados por lajes ou blocos em cima). Atire a Granada de Fogo Grego BEM no centro do arco para ativar a fenda!"]
	quest.7100000000000002.title: "Arquitetura Antiga"
	quest.7100000000000003.quest_desc: ["Pule no portal luminoso. Bem-vindo a Icaria! Um reino de ilhas flutuantes gigantescas, desertos de cristal, florestas vibrantes e ruínas de uma antiga civilização morta-viva. Muito cuidado para não cair no vazio infinito do céu!"]
	quest.7100000000000003.title: "O Paraíso em Ruínas"
	quest.7100000000000004.quest_desc: ["O subsolo destas ilhas é rico, mas dividido em camadas rígidas de pedra. Nas camadas superiores, minere Chalkos (Cobre) e Kassiteros (Estanho). Eles são fracos sozinhos, mas formam a base metálica do mod."]
	quest.7100000000000004.title: "A Era do Bronze Icariano"
	quest.7100000000000005.quest_desc: ["Esqueça as fornalhas normais. A Forge (Forja de Icaria) é uma estação industrial onde a verdadeira metalurgia acontece. Use-a para derreter minérios brutos com mais eficiência e, principalmente, fundir dois metais diferentes em Ligas (Alloys) poderosas!"]
	quest.7100000000000005.title: "A Forja Autêntica"
	quest.7100000000000006.quest_desc: ["Desça até as camadas abissais mais densas de Icaria e minere Sideros e Vanadium. Ao fundir os dois na sua Forja, você criará o Vanadium Steel, o metal mais afiado e indestrutível de toda a dimensão."]
	quest.7100000000000006.title: "O Aço Supremo (Vanadium)"
	quest.7100000000000007.quest_desc: ["A fauna e flora locais são letais e mágicas. Escorpiões brilhantes chamados Arachnes e bestas pesadas espreitam os campos. Cace-os e colete recursos biológicos raros antes que eles acabem com você!"]
	quest.7100000000000007.title: "Predadores de Cristal"
	quest.7100000000000008.quest_desc: ["O Kettle (Caldeirão) é o ápice da sua culinária aqui. Ferva águas, jogue frutas icarianas, cogumelos nativos e restos de monstros para criar Caldos curativos e Elixires com buffs impossíveis de se achar no Minecraft Vanilla."]
	quest.7100000000000008.title: "Alquimia (O Caldeirão)"
	quest.7100000000000009.quest_desc: ["Os mortos-vivos (Revenants) patrulham vilas gregas destruídas. Invada esses locais sagrados, derrote os Capitães e abra os baús. Seu prêmio? Pergaminhos (Scrolls) que permitem atirar Mísseis Mágicos ou dominar a Antigravidade usando mana!"]
	quest.7100000000000009.title: "Ruínas e Feitiçaria"
	quest.710000000000000A.quest_desc: ["A Convergência! Vestido em Aço de Vanadium, empunhando magias de antigravidade e com o corpo infundido de elixires de alquimia. Você desbravou os mortos-vivos e a fauna letal, tornando-se o deus vivo que rege as ilhas flutuantes!"]
	quest.710000000000000A.title: "O Panteão (Mestre de Icaria)"
	quest.7112BC5D437DD071.quest_desc: ["Encontre o Molde nas estruturas do Overworld."]
	quest.7112BC5D437DD071.title: "Molde: Peridoto"
	quest.7118D8CD79242453.title: "Alvo: Revenant"
	quest.7133EDD3B3BB434C.quest_desc: ["Variante de Diamante. Excelente dano e durabilidade."]
	quest.7133EDD3B3BB434C.title: "Katana de Diamante"
	quest.715CF3921FA1C36F.quest_desc: ["A Convergência! Você se armou com metais poderosos e armaduras resistentes. Procure as enormes construções retangulares no subsolo profundo chamadas Catacombs. O labirinto lá dentro é habitado pela elite da podridão. Desça até a sala central."]
	quest.715CF3921FA1C36F.title: "As Catacumbas"
	quest.718156E5B857424E.title: "Alvo: Arid Yeti"
	quest.71C283448BC4F95E.title: "Alabarda de Ouro"
	quest.71D077CE24393A32.title: "Alvo: Cave Skeleton"
	quest.7200000000000001.quest_desc: ["O primeiro passo ocorre no Nether. Você precisa caçar os 'Revenant Pyromancers', esqueletos com túnicas que lançam frascos explosivos. Derrote-os para roubar a Granada de Fogo Grego (Greek Fire Grenade), o ignitor do seu portal."]
	quest.7200000000000001.title: "O Fogo Grego"
	quest.7200000000000002.quest_desc: ["Construa um portal no formato clássico, mas usando Blocos e Pilares de Quartzo. Ao invés de um isqueiro, atire a sua Granada de Fogo Grego contra a estrutura para abrir a passagem dimensional."]
	quest.7200000000000002.title: "A Fenda de Quartzo"
	quest.7200000000000003.quest_desc: ["Bem-vindo a Icaria! Um arquipélago colossal nos céus. Aqui, a sobrevivência depende de dominar a forja de ligas metálicas (Alloys) e entender o ecossistema agressivo das ilhas."]
	quest.7200000000000003.title: "O Paraíso em Ruínas"
	quest.7200000000000004.quest_desc: ["A fornalha do Vanilla não serve para os metais pesados daqui. Construa a Forge (Forja). Ela possui múltiplos slots e serve exclusivamente para derreter e fundir dois minérios diferentes em uma Liga (Alloy)."]
	quest.7200000000000004.title: "A Forja Icariana"
	quest.7200000000000005.quest_desc: ["Nas camadas mais altas das ilhas, você encontrará minérios de Chalkos (Cobre Icariano) e Kassiteros (Estanho). Sozinhos, eles fazem ferramentas muito frágeis, mas são a base da sua metalurgia."]
	quest.7200000000000005.title: "Minérios Base: Chalkos e Kassiteros"
	quest.7200000000000006.quest_desc: ["Coloque Chalkos e Kassiteros juntos na Forja. O calor extremo fundirá os dois, criando o Orichalcum (uma espécie de Bronze/Ouro super resistente). Com ele, você poderá minerar a próxima camada de pedras."]
	quest.7200000000000006.title: "Liga Nível 1: Orichalcum"
	quest.7200000000000007.quest_desc: ["Com sua picareta de Orichalcum, desça para a camada média. Cave nas profundezas até encontrar Sideros (Ferro Icariano) e o raríssimo Molybdenum. Esses metais exigem temperaturas absurdas."]
	quest.7200000000000007.title: "Minérios Densos: Sideros e Molybdenum"
	quest.7200000000000008.quest_desc: ["Funda o Sideros com o Molybdenum na sua Forja. O resultado é o Molybdenum Steel (Aço de Molibdênio), uma liga cinza-prateada com durabilidade incrível e dano letal."]
	quest.7200000000000008.title: "Liga Nível 2: Molybdenum Steel"
	quest.7200000000000009.quest_desc: ["O minério mais escasso de Icaria, escondido nas camadas mais baixas (perto do vazio). Minere o Vanadium usando sua nova picareta de aço. Você precisará de mais Sideros para acompanhá-lo."]
	quest.7200000000000009.title: "O Metal Abissal: Vanadium"
	quest.720000000000000A.quest_desc: ["O ápice da metalurgia icariana! Funda Vanadium com Sideros. O Vanadium Steel é o material definitivo (azul brilhante). Ferramentas feitas com ele são quase inquebráveis."]
	quest.720000000000000A.title: "Liga Nível 3: Vanadium Steel"
	quest.720000000000000B.quest_desc: ["A fauna insetóide: Enfrente os Arachnes (escorpiões enormes que disparam veneno) e os Myrmekes (formigas mutantes de colônia). Cace-os para extrair patas, mandíbulas e toxinas para a alquimia."]
	quest.720000000000000B.title: "Enxames Alienígenas"
	quest.720000000000000C.quest_desc: ["As feras maiores: Os Aeternae são touros encouraçados com ossos expostos, e os Argan Hounds são predadores rápidos. Cuidado ao cruzar os desertos de cristal e florestas densas!"]
	quest.720000000000000C.title: "Feras com Carapaça"
	quest.720000000000000D.quest_desc: ["Construa o Kettle (Caldeirão). Coloque água e ferva os restos biológiocos dos monstros que você caçou junto com frutas nativas. É assim que você fará os melhores elixires e sopas de cura contínua do mod."]
	quest.720000000000000D.title: "O Caldeirão de Caça"
	quest.720000000000000E.quest_desc: ["As antigas vilas gregas são guardadas pelos Revenants, uma civilização morta-viva. Enfrente os soldados, os Pyromancers e os temíveis Capitães Revenant (Revenant Captains)."]
	quest.720000000000000E.title: "Os Donos das Ruínas"
	quest.720000000000000F.quest_desc: ["Limpar os postos avançados Revenant permite saquear os baús sagrados. Encontre os Magic Scrolls (Pergaminhos Mágicos), que te dão a habilidade de conjurar projéteis e feitiços de defesa sem gastar durabilidade!"]
	quest.720000000000000F.title: "Segredos Arcanos"
	quest.7200000000000010.quest_desc: ["O feitiço mais procurado. Com o pergaminho de Antigravity, você pode manipular a gravidade das ilhas, permitindo escalar terrenos íngremes e salvar-se de quedas no vazio infinito."]
	quest.7200000000000010.title: "Magia de Antigravidade"
	quest.720B363D1C7C5339.quest_desc: ["Hora de provar seu valor. Prepare um Frango Inteiro com cebolas e batatas e asse-o no forno ou na panela gigante. Ele pode ser colocado na mesa e rende dezenas de refeições nobres."]
	quest.720B363D1C7C5339.title: "Banquete Nível 1: Frango Assado"
	quest.721B56C09EF043D0.quest_desc: ["Variante de Diamante. Excelente dano e durabilidade."]
	quest.721B56C09EF043D0.title: "Claymore de Diamante"
	quest.722BB0F7124D58D5.quest_desc: ["O Molde do vazio gélido do Nether."]
	quest.722BB0F7124D58D5.title: "Molde: Safira"
	quest.722E6EDD0EC0C1F4.title: "Alvo: Zombified Cultist"
	quest.7231C2866998E01F.quest_desc: ["Combine Pó de Blaze e Pérolas de Ender. Encontre o portal, destrua os cristais de cura e abata a guardiã suprema do Vazio."]
	quest.7231C2866998E01F.title: "A Libertação do Fim"
	quest.725164AF0EEB900D.title: "Portal do Abyss"
	quest.728DE1A882DE25AE.quest_desc: [
		"O Verme de Areia mergulha no chão e salta agressivamente para te engolir, além de cuspir poças de ácido letal."
		""
		"Acorde-o com a Ancient Trial Key e esquive-se exatamente no momento em que ele for saltar!"
	]
	quest.728DE1A882DE25AE.title: "O Verme de Areia"
	quest.72E112B66B116F66.title: "Alvo: Desert Skeleton"
	quest.730F404C5ACFC24A.title: "Alvo: Golden Hermit King"
	quest.7318B911FECF96C9.title: "Alvo: Revenant"
	quest.732AC7A162599896.quest_desc: ["Variante de Ouro. Rápida mas frágil."]
	quest.732AC7A162599896.title: "Foice de Ouro"
	quest.7330F7AEF41D87D6.quest_desc: ["O §aTime Twister§r regista mortes e permite rebobinar a linha do tempo para voltar ao local onde morreu."]
	quest.7330F7AEF41D87D6.title: "Enganando a Morte"
	quest.7333ADDBD4054B30.title: "Cutelo de Diamante"
	quest.7342B2B982721CBB.title: "Alvo: Statue Mimic"
	quest.7346F162D59C95C7.quest_desc: ["O cristal supremo gerado nas ilhas flutuantes externas do Vazio."]
	quest.7346F162D59C95C7.title: "Cristal: Ametrina"
	quest.737149E3EA530677.title: "Alvo: Zebra"
	quest.737B3C71344796B1.quest_desc: [
		"O Freezer esconde utilidades fantásticas além de esfriar rubis!"
		""
		"Experimente colocar outros itens quentes do Nether dentro dele. Ele transforma §aCreme de Magma em Gosma de Slime§r, e congela os duros Blocos de Magma transformando-os em Obsidian perfeita! Se usar blocos de Neve, consegue o raro Gelo Compactado."
	]
	quest.737B3C71344796B1.title: "Alquimia Gélida"
	quest.739DB512CC31E8FF.quest_desc: ["A gema suprema banhada na energia do The End."]
	quest.739DB512CC31E8FF.title: "Cristal: Ametrina"
	quest.73AFB84C670EAFDB.quest_desc: [
		"A encarnação do inverno!"
		""
		"Use a Ancient Trial Key no altar de neve. O Yeti congela com os seus golpes e dá saltos esmagadores. Use lava a seu favor para derreter a vida da fera."
	]
	quest.73AFB84C670EAFDB.title: "O Yeti"
	quest.73B0FD191E4CDB20.quest_desc: [
		"O Topázio cresce em belíssimos geodos subterrâneos espalhados pelo Overworld. Não passe reto se vir blocos brilhando em tons de cobre/laranja!"
		""
		"§eO Poder Supremo do Topázio:§r Ao forjar o set completo, você ganha o efeito 'Item Mastery'. O dano de durabilidade de §lTODAS§r as ferramentas e armas na sua mão será drasticamente reduzido! É o sonho de qualquer construtor e minerador."
	]
	quest.73B0FD191E4CDB20.title: "Overworld: Mestre dos Itens"
	quest.73CD0F6631D36D56.title: "Alvo: Librarian Skeleton"
	quest.7400000000000001.quest_desc: ["Bem-vindo à revolução gastronômica! Esqueça a carne assada sem graça da fornalha. O Farmer's Delight e suas expansões transformam a comida na sua maior fonte de poder. Para começar, faça a Tábua de Corte (Cutting Board). Ela é a bancada principal onde você vai picar vegetais, filetar peixes e desossar carnes."]
	quest.7400000000000001.title: "O Mestre Cuca"
	quest.7400000000000002.quest_desc: ["A faca é a extensão do braço do chef. Além de ser usada na Tábua de Corte, a faca é excelente para colher plantações mais rápido e, se usada para matar animais, garante drops extras de carne, couro e penas!"]
	quest.7400000000000002.title: "O Fio da Lâmina"
	quest.7400000000000003.quest_desc: ["Para cozinhar, você precisa de ingredientes frescos. Explore o mundo para encontrar tomates, repolhos, cebolas e arroz. Dica de ouro: crie Rich Soil (Terra Rica) usando lixo orgânico; as plantas crescem incrivelmente rápido e não precisam ser aradas ou hidratadas!"]
	quest.7400000000000003.title: "A Horta Orgânica"
	quest.7400000000000004.quest_desc: ["O Stove (Fogão) é a sua nova fornalha. Ele não tem interface de baú: basta colocar até 6 itens crus em cima dele e eles vão fritar lentamente na chapa. Perfeito para o café da manhã com ovos e bacon!"]
	quest.7400000000000004.title: "Fogo Caipira (Fogão)"
	quest.7400000000000005.quest_desc: ["Coloque a Cooking Pot (Panela) em cima do Fogão (Stove) ou de uma Fogueira. Esta é a máquina principal do mod. Ela permite misturar até 6 ingredientes diferentes na água (ou leite) para criar ensopados, caldos e refeições que dão o buff 'Nourishment' (Nutrição), impedindo sua fome de cair por muito tempo!"]
	quest.7400000000000005.title: "A Panela Mágica"
	quest.7400000000000006.quest_desc: ["A Skillet (Frigideira) é portátil. Coloque-a sobre um fogo para fritar alimentos de forma rápida e elegante. Mas o seu maior segredo é o combate: bater nos inimigos com a frigideira causa um dano excelente e um som de 'BONK' hilário e satisfatório!"]
	quest.7400000000000006.title: "O Frigideiro de Batalha"
	quest.7400000000000007.quest_desc: ["Cozinheiros acumulam muitos ingredientes. Graças ao Storage Delight, você pode construir armários rústicos (Cabinets) maravilhosos que se conectam e escondem seus potes e temperos de forma muito mais bonita que os baús tradicionais."]
	quest.7400000000000007.title: "A Despensa Perfeita"
	quest.7400000000000008.quest_desc: ["Com o Farmer's Pizzeria, você pode abrir sua própria cantina italiana! O Pizza Oven (Forno de Pizza) precisa ser abastecido com lenha (Logs). Quando aceso, ele assa discos de massa em tempo recorde."]
	quest.7400000000000008.title: "Mamma Mia! (Pizzaria)"
	quest.7400000000000009.quest_desc: ["Use trigo e água na Tábua de Corte ou na Panela para criar a Wheat Dough (Massa). Com a massa base, você adiciona o molho de tomate (feito no fogão) para preparar os discos crus de pizza."]
	quest.7400000000000009.title: "Mão na Massa"
	quest.740000000000000A.quest_desc: ["Adicione queijos, carnes, pimentões ou calabresa ao seu disco cru e asse-o no forno. Você pode colocar a pizza quente direto na mesa. Use sua Faca para cortar fatias e servir seus amigos! Uma pizza inteira enche o estômago de uma vila inteira."]
	quest.740000000000000A.title: "A Pizza Suprema"
	quest.740000000000000B.quest_desc: ["Bem-vindo ao mod Brewin' and Chewin'. O Keg (Barril de Fermentação) é onde a magia líquida acontece. Coloque maçãs, trigo ou mel junto com água para iniciar o processo de fermentação. O barril é sensível à temperatura!"]
	quest.740000000000000B.title: "A Taverna Aberta"
	quest.740000000000000C.quest_desc: ["Leite e tempo. Esse é o segredo do Flaxen Cheese (Queijo). Ele precisa maturar. Assim como as pizzas, você pode colocar as enormes Rodas de Queijo em cima do balcão e cortar fatias generosas para os seus clientes."]
	quest.740000000000000C.title: "O Queijo Maturado"
	quest.740000000000000D.quest_desc: ["Junto com o barril de fermentação, o Kaleidoscope Tavern permite que você construa um bar real! Canecas de madeira, chopes, cidras e coquetéis. Algumas bebidas te dão a coragem necessária para enfrentar os chefões do Undergarden."]
	quest.740000000000000D.title: "Mestre dos Coquetéis"
	quest.740000000000000E.quest_desc: ["Quem disse que o inferno não tem alta gastronomia? Com o My Nether's Delight, você pode caçar Hoglins e Striders para cozinhar Espetinhos de Magma, Ensopado de Cogumelos Carmesim e um imponente Hoglin Recheado assado direto no fogo!"]
	quest.740000000000000E.title: "O Sabor do Inferno"
	quest.740000000000000F.quest_desc: ["Ender's Delight. Filetar a dura carapaça do Shulker e preparar Macarrão de Ender Pearl. As tortas e doces feitos de Chorus Fruit são tão mágicos que às vezes comê-los teletransporta o jogador para longe do perigo!"]
	quest.740000000000000F.title: "O Prato do Vazio"
	quest.7400000000000010.quest_desc: ["Hora de juntar o Farmer's Delight com as máquinas gigantes do Create! O Create: Central Kitchen transforma o jogo. Agora você pode colocar os Deployers (Braços Mecânicos) para cortar na Tábua de Corte e usar o Mixer no Heated Basin (Bacia Aquecida) para ferver dezenas de ensopados por segundo!"]
	quest.7400000000000010.title: "Cozinha Industrial (Central Kitchen)"
	quest.741913414B53CB11.title: "Pernach de Diamante"
	quest.744F5B47C1D27474.quest_desc: [
		"Finalmente, a Gema Pura e cristalizada."
		""
		"Este item central abre portas para 5 ramificações diferentes de sobrevivência: Economia, Redstone, Defesa, Decoração e Controle de Lava."
	]
	quest.744F5B47C1D27474.title: "O Cristal de Rubi"
	quest.745E1465746F5E70.quest_desc: ["Um cristal de extrema mobilidade escondido no subsolo das ilhas do Vazio."]
	quest.745E1465746F5E70.title: "Cristal: Jade"
	quest.745FD472BF124C7B.title: "Alvo: Zombified Cultist"
	quest.748EBB537DD68977.quest_desc: [
		"Nas ruínas, procure por buracos na parede (Burrows). Eles são a casa das Toupeiras (Moles) do mod!"
		""
		"§eMissão de Mineração:§r As toupeiras vão sair cavando pelo subsolo e, de tempos em tempos, retornarão ao buraco deixando para trás uma Mining Pouch (Bolsa de Mineração) lotada de itens para você resgatar!"
	]
	quest.748EBB537DD68977.title: "Os Garimpeiros Naturais"
	quest.7495CB9EB11F1CCB.quest_desc: [
		"O ferro normal não suporta viagens interdimensionais sem derreter. Você precisa forjar o §7Time Steel§r (Aço Temporal)."
		""
		"Esta liga metálica avançada é o componente base para absolutamente todos os dispositivos de alto nível da TVA. Forje o suficiente para começar seu império."
	]
	quest.7495CB9EB11F1CCB.title: "Aço Temporal"
	quest.74992904C49CB2F9.quest_desc: [
		"Cansado de bombas normais? Crafte a Mesa de Combustão (Combustion Table)!"
		""
		"Coloque sua bomba nela e adicione modificadores:"
		"§a• Gosma de Slime:§r Faz a bomba quicar nas paredes."
		"§f• Linha:§r Aumenta o tempo do pavio."
		"§c• Pólvora:§r Aumenta o raio de destruição da explosão!"
	]
	quest.74992904C49CB2F9.title: "Mestre da Demolição"
	quest.749972C0177F9369.title: "Alvo: Woodland Witchdoctor"
	quest.74C8BE32B782D790.quest_desc: ["Não olhe nos olhos. As pérolas deles são a chave para a dimensão final."]
	quest.74C8BE32B782D790.title: "Olhares Proibidos"
	quest.74D69981D4732D6A.quest_desc: [
		"Procure por torres gigantes no Overworld."
		""
		"A subida é infestada por Dragon Guards e Flaming Skeletons. Uma Poção de Resistência ao Fogo é vital aqui!"
	]
	quest.74D69981D4732D6A.title: "A Torre Flamejante"
	quest.74E9979E537E5ADA.title: "Alvo: Warped Spitter"
	quest.74F7305972D42456.title: "Alvo: Revenant"
	quest.7500000000000001.quest_desc: ["O marco zero da sua carreira. A Tábua de Corte (Cutting Board) é onde os ingredientes brutos ganham forma. Com ela no chão, você usará facas para picar legumes e desossar animais. É o fim da era de comer carne assada pura da fornalha."]
	quest.7500000000000001.title: "O Início da Jornada"
	quest.7500000000000002.quest_desc: ["Forje a sua primeira faca. Além de ser sua ferramenta de trabalho na Tábua de Corte, ela corta plantações muito mais rápido e garante drops bônus (como bacon, couro e penas extras) se usada para abater animais."]
	quest.7500000000000002.title: "A Faca do Chef"
	quest.7500000000000003.quest_desc: ["Para a alta gastronomia, você precisa dos melhores ingredientes. Misture lixo orgânico para criar Rich Soil (Terra Rica). Plantações colocadas aqui crescem em velocidade recorde, não precisam de água e a terra não precisa ser arada."]
	quest.7500000000000003.title: "Agricultor de Elite"
	quest.7500000000000004.quest_desc: ["Explore o mundo e encontre sementes de repolho e cebola. O repolho é a base de charutos e saladas, enquanto a cebola traz o sabor necessário para os ensopados de carne e caldos robustos."]
	quest.7500000000000004.title: "A Colheita Verde"
	quest.7500000000000005.quest_desc: ["O Arroz (Rice) só pode ser plantado em terra submersa por águas rasas (como nos pântanos). Ele é vital para receitas asiáticas, sushis e para o arroz frito especial. Cultive com sabedoria."]
	quest.7500000000000005.title: "O Arrozal Sagrado"
	quest.7500000000000006.quest_desc: ["Chega de fogueiras primitivas. O Stove (Fogão) permite colocar até 6 itens simultâneos na chapa superior para fritá-los devagar e com segurança. Essencial para o preparo de carnes seladas e ovos estalados."]
	quest.7500000000000006.title: "O Fogo Controlado (Fogão)"
	quest.7500000000000007.quest_desc: ["O coração da culinária manual. Coloque a Cooking Pot sobre o Fogão. Com ela, você mistura até 6 ingredientes complexos em um líquido (água ou leite) para preparar caldos que curam a vida e dão o buff de Nutrição prolongada."]
	quest.7500000000000007.title: "A Panela dos Milagres"
	quest.7500000000000008.quest_desc: ["O caminho da pizzaria começa pela massa. Misture água com trigo para fazer a Wheat Dough (Massa de Trigo). Em seguida, fatie tomates para criar o molho encorpado. Estes dois formam o Disco Cru de Pizza."]
	quest.7500000000000008.title: "Mamma Mia! O Início"
	quest.7500000000000009.quest_desc: ["A forma rústica de assar. Construa o Pizza Oven, abasteça-o com lenha e acenda. Ele é feito sob medida para assar seus discos de pizza recheados (cru) e transformá-los em refeições completas para a sua vila."]
	quest.7500000000000009.title: "Forno Tradicional Italiano"
	quest.750000000000000A.quest_desc: ["Por que assar uma pizza se você pode assar MIL? O Forno do Create: Ratatouille é uma revolução industrial. Ele se conecta às esteiras mecânicas. Jogue discos de massa crua na esteira, passe-os por baixo dos jatos de calor deste forno automatizado e veja as pizzas saindo assadas sem você mexer um dedo!"]
	quest.750000000000000A.title: "O Forno Industrial (Ratatouille)"
	quest.750000000000000B.quest_desc: ["O resultado da sua automação ou esforço. A pizza inteira pode ser colocada no chão ou numa mesa. Use a sua faca nela para cortar as fatias. Nutrição perfeita, sabor imbatível. Sua cantina agora é uma potência!"]
	quest.750000000000000B.title: "A Pizza Suprema"
	quest.750000000000000C.quest_desc: ["Do outro lado da cozinha, temos o bar. O Brewin' and Chewin' traz o Keg (Barril). Adicione maçãs, trigo, mel e água. O barril é sensível à temperatura (coloque fontes de calor ou frio perto) para fermentar cervejas, hidromel e vinhos!"]
	quest.750000000000000C.title: "O Barril da Taverna"
	quest.750000000000000D.quest_desc: ["Deixe baldes de leite coagulando nas condições certas para criar gigantescas Rodas de Queijo (Flaxen Cheese). Coloque a roda na despensa para maturar e ganhar sabor. Elas também podem ser fatiadas e servidas puras."]
	quest.750000000000000D.title: "Maturando Queijos"
	quest.750000000000000E.quest_desc: ["Sirva com classe. O Kaleidoscope Tavern permite engarrafar coquetéis, chopes em canecas de madeira rústicas e destilados fortes. Bebidas quentes aquecem no frio, e cervejas geladas dão a coragem (buffs) necessária para invadir masmorras."]
	quest.750000000000000E.title: "Kaleidoscope Tavern"
	quest.750000000000000F.quest_desc: ["O verdadeiro taverneiro sabe se defender. A Skillet não frita apenas bifes; bata nos arruaceiros do seu bar com ela! O som de frigideira batendo em armadura e o empurrão absurdo que ela dá fazem desta uma das armas mais cômicas do jogo."]
	quest.750000000000000F.title: "Frigideira Assassina"
	quest.7500000000000010.quest_desc: ["O inferno tem os melhores temperos picantes. O My Nether's Delight permite extrair carne de Hoglins e caçar Striders (cuidado com o magma). Pique fungos carmesins na tábua de corte para acompanhar as carnes infernais."]
	quest.7500000000000010.title: "Cardápio do Submundo"
	quest.7516D954388A7B2A.title: "Khopesh de Diamante"
	quest.75171B64380B8732.quest_desc: [
		"Procure por igrejas abandonadas nos biomas de Planícies."
		""
		"A Mula Sem Cabeça incendeia tudo ao redor. Derrote-a para conseguir o Couro Flamejante."
	]
	quest.75171B64380B8732.title: "A Igreja em Chamas"
	quest.75656EC3F778FED2.quest_desc: ["Você pediu a lista completa, caçador. Aqui estão as 54 ameaças isoladas da Série Luminous. Elas foram separadas em 4 colunas. Todas estão liberadas: cace-os na ordem que os encontrar pelo mundo!"]
	quest.75656EC3F778FED2.title: "O Fichário Completo"
	quest.756D73F2CF7CF9B5.title: "Alvo: Butterfly"
	quest.75E486CBDE710381.quest_desc: [
		"Para avançar aos céus, a armação e o tecido devem evoluir. Crafte a lona reforçada com ferro."
		""
		"O Planador de Ferro reduz significativamente a taxa de queda, permitindo que você voe muito mais longe antes de tocar o chão."
	]
	quest.75E486CBDE710381.title: "Planador de Ferro"
	quest.7600000000000001.quest_desc: ["O marco zero da sua carreira. A Tábua de Corte (Cutting Board) é onde os ingredientes brutos ganham forma. Com ela no chão, você usará facas para picar legumes e desossar animais. É o fim da era de comer carne assada pura da fornalha."]
	quest.7600000000000001.title: "O Início da Jornada"
	quest.7600000000000002.quest_desc: ["Forje a sua primeira faca. Além de ser sua ferramenta de trabalho na Tábua de Corte, ela corta plantações muito mais rápido e garante drops bônus (como bacon, couro e penas extras) se usada para abater animais."]
	quest.7600000000000002.title: "A Faca do Chef"
	quest.7600000000000003.quest_desc: ["Para a alta gastronomia, você precisa dos melhores ingredientes. Misture lixo orgânico para criar Rich Soil (Terra Rica). Plantações colocadas aqui crescem em velocidade recorde, não precisam de água e a terra não precisa ser arada."]
	quest.7600000000000003.title: "Agricultor de Elite"
	quest.7600000000000004.quest_desc: ["Chega de fogueiras primitivas. O Stove (Fogão) permite colocar até 6 itens simultâneos na chapa superior para fritá-los devagar e com segurança. Essencial para o preparo de carnes seladas e ovos estalados."]
	quest.7600000000000004.title: "O Fogo Controlado (Fogão)"
	quest.7600000000000005.quest_desc: ["Explore o mundo e encontre sementes de repolho e cebola. O repolho é a base de charutos e saladas, enquanto a cebola traz o sabor necessário para os ensopados de carne e caldos robustos."]
	quest.7600000000000005.title: "A Colheita Verde"
	quest.7600000000000006.quest_desc: ["O Arroz (Rice) só pode ser plantado em terra submersa por águas rasas. Ele é vital para receitas orientais e para o arroz frito especial. Cultive com sabedoria."]
	quest.7600000000000006.title: "O Arrozal Sagrado"
	quest.7600000000000007.quest_desc: ["O coração da culinária manual. Coloque a Cooking Pot sobre o Fogão. Com ela, você mistura até 6 ingredientes complexos em um líquido para preparar caldos que curam a vida e dão o buff de Nutrição prolongada."]
	quest.7600000000000007.title: "A Panela dos Milagres"
	quest.7600000000000008.quest_desc: ["Cozinheiros acumulam muitos ingredientes. Construa armários rústicos (Cabinets) maravilhosos que se conectam e escondem seus potes e temperos de forma muito mais bonita que os baús tradicionais."]
	quest.7600000000000008.title: "A Despensa Perfeita"
	quest.7600000000000009.quest_desc: ["O caminho da pizzaria começa pela massa. Misture água com trigo para fazer a Wheat Dough (Massa de Trigo). Em seguida, fatie tomates para criar o molho encorpado. Estes dois formam o Disco Cru de Pizza."]
	quest.7600000000000009.title: "Mamma Mia! O Início"
	quest.7600000000000010.quest_desc: ["A fusão perfeita: Farmer's Delight encontra as máquinas do Create! O Central Kitchen permite que braços mecânicos (Deployers) usem facas na tábua de corte sozinhos e que as panelas sejam automatizadas!"]
	quest.7600000000000010.title: "Central Kitchen (Automação)"
	quest.7600000000000011.quest_desc: ["Do outro lado da cozinha, temos o bar. Adicione maçãs, trigo, mel e água no Keg (Barril). Controle a temperatura externa para fermentar cervejas, hidromel e vinhos que concedem status positivos!"]
	quest.7600000000000011.title: "O Barril da Taverna"
	quest.7600000000000012.quest_desc: ["A forma rústica de assar. Construa o Pizza Oven, abasteça-o com lenha e acenda. Ele assa seus discos de pizza cruos em refeições completas perfeitas para fatiar na mesa."]
	quest.7600000000000012.title: "Forno Tradicional Italiano"
	quest.7600000000000013.quest_desc: ["O The End é frio, mas tem frutos mágicos. Filete a carapaça do Shulker e faça Macarrão de Ender Pearl. Frutos de Chorus dão origem a bolos místicos."]
	quest.7600000000000013.title: "Sabores do Vazio"
	quest.7600000000000014.quest_desc: ["Prepare sua linha de montagem com esteiras e funis inteligentes. Lave os vegetais e fatie-os com serras mecânicas para alimentar sua indústria."]
	quest.7600000000000014.title: "Ratatouille: Preparo"
	quest.7600000000000015.quest_desc: ["A base dos grandes banquetes. Recheie um frango inteiro com vegetais aromáticos e asse-o na panela ou no forno para colocá-lo no centro da mesa."]
	quest.7600000000000015.title: "Assados Básicos"
	quest.7600000000000016.quest_desc: ["A sobremesa da sua fábrica. Derreta cacau e açúcar nos Mixers Mecânicos para gerar fluidos de chocolate puro nas suas tubulações."]
	quest.7600000000000016.title: "Chocólatra Industrial"
	quest.7600000000000017.quest_desc: ["O inferno tem os melhores temperos picantes. Cace Hoglins e Striders para fazer espetinhos. Pique fungos carmesins na tábua de corte e prepare-se para o calor."]
	quest.7600000000000017.title: "Cardápio do Submundo"
	quest.7600000000000018.quest_desc: ["Deixe baldes de leite coagulando nas condições certas para criar gigantescas Rodas de Queijo. Coloque a roda na despensa para maturar e ganhar sabor."]
	quest.7600000000000018.title: "Maturando Queijos"
	quest.7600000000000019.quest_desc: ["Por que assar uma pizza se você pode assar MIL? O Forno do Create se conecta às esteiras. Jogue discos de massa na esteira e veja as pizzas saindo assadas automaticamente!"]
	quest.7600000000000019.title: "O Forno Industrial (Ratatouille)"
	quest.7600000000000020.quest_desc: ["Sirva com classe! Engarrafe coquetéis, chopes em canecas de madeira rústicas e destilados fortes. Algumas bebidas dão a coragem necessária para invadir masmorras."]
	quest.7600000000000020.title: "Kaleidoscope Tavern"
	quest.7600000000000021.quest_desc: ["A pizza perfeita, pronta na esteira. Coloque na mesa, corte em fatias e alimente sua vila inteira com uma única fornada."]
	quest.7600000000000021.title: "A Pizza Suprema"
	quest.7600000000000022.quest_desc: ["Assei a grandiosa Torta de Chorus Fruit. Comer suas fatias pode te teletransportar para longe do perigo!"]
	quest.7600000000000022.title: "O Pique-Nique do The End"
	quest.7600000000000023.quest_desc: ["O ápice da engenharia mecânica. Máquinas que lavam, cozinham, assam e embalam refeições inteiras e marmitas em ritmo industrial!"]
	quest.7600000000000023.title: "Fábrica Culinária"
	quest.7600000000000024.quest_desc: ["Uma iguaria que exige precisão. Esvazie uma abóbora inteira e recheie com a mais fina carne, ovos e especiarias."]
	quest.7600000000000024.title: "Banquete: Abóbora Recheada"
	quest.7600000000000025.quest_desc: ["Crie as Fontes Decorativas de Chocolate! Mergulhe frutas diretamente no jato de chocolate que jorra da máquina para fazer fondues."]
	quest.7600000000000025.title: "A Fonte de Cacau"
	quest.7600000000000026.quest_desc: ["A obra-prima do inferno. Prepare o imponente Hoglin Recheado assado inteiro nas chamas do Nether."]
	quest.7600000000000026.title: "Banquete Diabólico"
	quest.7600000000000027.quest_desc: ["O verdadeiro taverneiro sabe se defender. Bata nos arruaceiros do seu bar com a frigideira quente para dar um empurrão brutal!"]
	quest.7600000000000027.title: "Frigideira Assassina"
	quest.7600000000000028.quest_desc: [
		"O Santo Graal da Gastronomia! O Presunto Glaceado com Mel (Honey Glazed Ham) exige que você integre tudo o que aprendeu."
		""
		"Para destravar esta missão, você precisou finalizar com sucesso as 7 grandes vertentes culinárias deste mundo (Pizza, Ender, Máquinas, Assados, Chocolate, Nether e Taverna). Você é o mestre absoluto de todos os fornos e esteiras do servidor. Vida longa ao Chef!"
	]
	quest.7600000000000028.title: "O Supremo MasterChef"
	quest.761C654C10B0E8F5.quest_desc: [
		"O gigante letal que habita as selvas densas e persegue suas presas à noite."
		""
		"A força dele quebra até pedras e vai partir para cima de você com tudo. Derrote-o para conquistar o seu Olho e a sua Presa."
	]
	quest.761C654C10B0E8F5.title: "O Rei da Selva"
	quest.76394E372ED159E0.title: "Refinamento"
	quest.7664164554C8A7FE.title: "Alvo: Butterfly"
	quest.76AB6B21B8C9592F.quest_desc: [
		"O mundo foi tomado por titãs."
		""
		"O Bosses' Rise introduz batalhas no estilo RPG de ação. O combate não foca em esmagar o botão de ataque, mas em esquivar, defender e punir os chefes no momento certo!"
	]
	quest.76AB6B21B8C9592F.title: "A Ascensão dos Chefes"
	quest.76D6E3DC9009F20F.quest_desc: ["Minere no fundo dos oceanos profundos."]
	quest.76D6E3DC9009F20F.title: "Cristal: Água-Marinha"
	quest.76DBF8288BD881B9.title: "Alvo: Revenant"
	quest.76EE01BBCA6740B0.title: "Alvo: Basalt Executioner"
	quest.7700000000000001.quest_desc: ["Bem-vindo ao mundo! A sua primeira e mais importante tarefa é quebrar a madeira das árvores com as próprias mãos. A madeira é a fundação de tudo o que você construirá."]
	quest.7700000000000001.title: "O Despertar"
	quest.7700000000000002.quest_desc: ["Crie uma Picareta de Madeira e minere a pedra ao seu redor. Isso permitirá que você crie fornalhas e ferramentas muito mais duráveis e rápidas."]
	quest.7700000000000002.title: "A Idade da Pedra"
	quest.7700000000000003.quest_desc: ["Procure por veios de minério de ferro nas cavernas e derreta-os na sua fornalha. O Ferro é o primeiro metal real do jogo, abrindo as portas para armaduras, baldes, escudos e maquinários."]
	quest.7700000000000003.title: "Revolução do Ferro"
	quest.7700000000000004.quest_desc: ["Não explore as cavernas sem proteção. Crie um Escudo (sua melhor defesa contra flechas e explosões de Creeper) e vista peças de armadura de ferro."]
	quest.7700000000000004.title: "Defesa Básica"
	quest.7700000000000005.quest_desc: ["Desça até as camadas mais profundas do mundo (próximo à Bedrock ou Deepslate) e encontre os raros Diamantes. A Picareta de Diamante é essencial para minerar os blocos mais duros do jogo."]
	quest.7700000000000005.title: "O Brilho Azul"
	quest.7700000000000006.quest_desc: ["Com diamantes, obsidian e um livro, crie a Mesa de Encantamentos. Ao cercá-la com estantes de livros, você poderá gastar sua experiência (XP) para fortalecer suas armas e ferramentas com magias."]
	quest.7700000000000006.title: "Mesa de Encantamentos"
	quest.7700000000000007.quest_desc: ["Jogue água sobre um lago de lava estático. O choque térmico criará a Obsidian, o bloco mais resistente do Overworld. Use sua Picareta de Diamante para minerar pelo menos 10 blocos."]
	quest.7700000000000007.title: "Lágrimas da Terra"
	quest.7700000000000008.quest_desc: ["Construa um retângulo de Obsidian de pelo menos 4x5 e acenda-o com um Isqueiro (Flint and Steel). Atravesse o portal para entrar no Nether, uma dimensão escaldante de lava e perigos constantes."]
	quest.7700000000000008.title: "Os Portões do Inferno"
	quest.7700000000000009.quest_desc: ["Explore o Nether até encontrar as imensas Fortalezas de Tijolos Vermelhos. Lá dentro, você encontrará os Blazes. Mate-os para coletar suas Varetas (Blaze Rods), essenciais para criar poções e olhos mágicos."]
	quest.7700000000000009.title: "A Fortaleza de Fogo"
	quest.770000000000000A.quest_desc: ["Cace Endermans à noite no Overworld ou procure-os nas Florestas Distorcidas (Warped Forests) do Nether. Colete as Pérolas do Fim (Ender Pearls). Elas são a outra metade da chave para o dragão."]
	quest.770000000000000A.title: "Caçador das Sombras"
	quest.770000000000000B.quest_desc: ["A Convergência! Transforme as Blaze Rods em Blaze Powder e misture-as com as Ender Pearls na sua bancada. O resultado é o Olho do Fim (Eye of Ender). Ele servirá como uma bússola mágica: jogue-o para o alto e siga a direção que ele apontar."]
	quest.770000000000000B.title: "O Olho Que Tudo Vê"
	quest.770000000000000C.quest_desc: ["Siga os Olhos do Fim até eles afundarem no chão. Cave para baixo até encontrar a Stronghold (Fortaleza). É um labirinto escuro cheio de bibliotecas, prisões e celas. Seu objetivo é achar a Sala do Portal."]
	quest.770000000000000C.title: "O Labirinto Subterrâneo"
	quest.770000000000000D.quest_desc: ["Coloque os Olhos do Fim nas molduras vazias do portal dentro da Stronghold. O vácuo negro se abrirá. Pule dentro dele para viajar para a dimensão final do jogo. Não há volta, a menos que você morra ou vença."]
	quest.770000000000000D.title: "O Fim"
	quest.770000000000000E.quest_desc: [
		"O clímax da sua jornada! Destrua os Cristais do Fim no topo das torres de Obsidian para impedir que o Ender Dragon se cure. Depois, ataque-o com tudo o que você tem."
		""
		"A missão será concluída **automaticamente** assim que você der o golpe fatal no Dragão e o portal de volta para casa se abrir!"
	]
	quest.770000000000000E.title: "Liberte o Fim"
	quest.7700A43B62C49C87.title: "Alvo: Snow Zombie"
	quest.7731DFDCC6EDE41C.quest_desc: ["O Inventory Cable conecta os baús mais distantes ao seu Conector. Você pode passar esses cabos por toda a sua base para unificar o armazenamento."]
	quest.7731DFDCC6EDE41C.title: "Fiação de Madeira"
	quest.7785AC13E33AE0F5.title: "Alvo: Magic Skeleton"
	quest.77A6D336C47E9B26.title: "Alvo: Witchdoctor"
	quest.77BBD26263B27B55.title: "Alvo: Snow Skeleton"
	quest.77C2A5E996FCDB6E.title: "Arma Abissal"
	quest.7805CDC479136AD7.quest_desc: ["Encontra o Molde nas estruturas do Overworld."]
	quest.7805CDC479136AD7.title: "Molde: Peridoto"
	quest.788BFC4B1E1BB98F.title: "Alvo: Arid Yeti"
	quest.789C361E6D14C8E3.title: "Alvo: Jungle Skeleton"
	quest.78D8C39C72CEE587.title: "Alvo: Jungle Skeleton"
	quest.78F16BF92F441FF5.title: "Alvo: Jungle Skeleton"
	quest.7900000000000001.quest_desc: ["Bem-vindo ao Mural de Contratos Luminous! A fauna e os mortos-vivos do mundo sofreram mutações brilhantes e se dividiram em 4 categorias de ameaça. Assine o quadro para liberar os contratos de extermínio por bioma e especialidade."]
	quest.7900000000000001.title: "O Mural de Caça"
	quest.7900000000000002.quest_desc: ["A vida animal também sofreu alterações místicas. Você precisará catalogar (abater) essas criaturas pacíficas mas exóticas para estudo."]
	quest.7900000000000002.title: "Contrato: Fauna Brilhante"
	quest.7900000000000003.quest_desc: ["Nem tudo que brilha é vivo. Sombras rastejantes e estátuas que ganham vida assolam as noites e bibliotecas abandonadas."]
	quest.7900000000000003.title: "Contrato: Anomalias da Superfície"
	quest.7900000000000004.quest_desc: ["Pântanos e Selvas abrigam zumbis e esqueletos adaptados à umidade extrema. Extermine-os."]
	quest.7900000000000004.title: "Contrato: Podridão Úmida"
	quest.7900000000000005.quest_desc: ["Do calor do deserto à frieza das cavernas profundas. Estas variantes resistem aos extremos da terra."]
	quest.7900000000000005.title: "Contrato: Pó e Escuridão"
	quest.7900000000000006.quest_desc: ["Nos picos nevados e nas torres dos magos, o frio e o arcano reanimaram os mortos com poderes aprimorados."]
	quest.7900000000000006.title: "Contrato: Magia e Gelo"
	quest.7900000000000007.quest_desc: ["A própria floresta normal esconde mortos-vivos camuflados entre a vegetação densa."]
	quest.7900000000000007.title: "Contrato: Troncos Podres"
	quest.7900000000000008.quest_desc: ["Uma facção extremista dos Piglins foi formada. Abata seus membros, de arqueiros a líderes e cavaleiros."]
	quest.7900000000000008.title: "Contrato: A Seita Suína"
	quest.7900000000000009.quest_desc: ["Os bosques Carmesim e Distorcido do Nether geraram os letais Mushlins e fantasmas de piglins amaldiçoados."]
	quest.7900000000000009.title: "Contrato: Infestação Fúngica"
	quest.790000000000000A.quest_desc: ["O inferno guarda entidades terríveis como os Crimson Walkers, Gliders e poltergeists das almas torturadas."]
	quest.790000000000000A.title: "Contrato: Horrores das Cinzas"
	quest.790000000000000B.quest_desc: ["Os mini-chefes da natureza acordaram. Ents ancestrais, espantalhos possuídos e feiticeiros da floresta o aguardam."]
	quest.790000000000000B.title: "Elite: Terrores Naturais"
	quest.790000000000000C.quest_desc: ["Os reis mortos voltaram a andar. Múmias de diferentes eras e os Reis Eremitas guardam os desertos."]
	quest.790000000000000C.title: "Elite: Soberanos de Areia"
	quest.790000000000000D.quest_desc: ["Jacarés monstruosos nos pântanos e os infames Yetis nas nevascas mais rigorosas. A caça pesada começou."]
	quest.790000000000000D.title: "Elite: Predadores de Sangue Frio"
	quest.790000000000000E.quest_desc: ["O ápice dos Beasts. De perseguidores de ossos a carrascos Piglins e a mítica Fênix. Este é o teste definitivo da sua espada."]
	quest.790000000000000E.title: "Elite: Asas e Machados"
	quest.790000000000000F.quest_desc: [
		"Inacreditável!"
		""
		"Você limpou o Overworld e o Nether inteiro. Abateu todas as 14 variantes de mortos-vivos, expurgou as mutações fúngicas, massacrou a Seita dos Piglins e derrotou dezenas de bestas colossais."
		""
		"A Guilda saúda você como o Maior Caçador da História do Servidor!"
	]
	quest.790000000000000F.title: "A Purificação Luminosa"
	quest.791DD09D657A66E4.title: "Alvo: Forest Zombie"
	quest.7932B958668842C2.quest_desc: ["Bem-vindo ao Nether. Cace este molde nos Bastiões."]
	quest.7932B958668842C2.title: "Molde: Rubi"
	quest.7965B77231BBB1C2.title: "Alvo: Jungle Zombie"
	quest.7997539DC5E63D63.title: "Alvo: Bogged Shadow"
	quest.799985E61AAF4B7D.title: "Alvo: Crab"
	quest.79AF0C7F58445578.title: "Alvo: Vile Gator"
	quest.79C560AED07313DD.quest_desc: [
		"Caiu na lava? Caiu no vazio? O §aTime Twister§r (Relógio Verde) salva a sua vida."
		""
		"Este dispositivo passivamente registra eventos críticos na sua linha do tempo (como mortes ou mudanças de dimensão). Se algo der errado, ative-o para REBOBINAR o tempo, abrindo um portal de volta exatamente para o momento e local do evento registrado. Recupere seus itens perdidos!"
	]
	quest.79C560AED07313DD.title: "Rebobinando a Morte"
	quest.79E05F563145D538.quest_desc: [
		"O início do seu arsenal explosivo começa com a clássica TNT do Minecraft."
		""
		"A partir dela, você pode criar explosivos de arremesso e detonadores muito mais versáteis e seguros de se usar."
	]
	quest.79E05F563145D538.title: "Explosão Clássica"
	quest.79F4BE627F20A94C.title: "Alvo: Jungle Skeleton"
	quest.79FC02F85AC0E6B3.quest_desc: [
		"O Rubi cristalizado perfeito."
		""
		"A partir daqui, o seu arsenal se divide: você pode criar utilitários de defesa para a sua base, itens para lidar com a lava ou focar na engenharia avançada de Lasers."
	]
	quest.79FC02F85AC0E6B3.title: "O Rubi"
	quest.7A00000000000001.quest_desc: [
		"A sua jornada para dominar o espaço-tempo começa com recursos básicos."
		""
		"Obtenha ferro para iniciar a fabricação das primeiras peças de tecnologia da Autoridade de Variância Temporal (TVA)."
	]
	quest.7A00000000000001.title: "O Início da Linha do Tempo"
	quest.7A00000000000002.quest_desc: [
		"A tecnologia da TVA não pode ser adivinhada. O §6Knowledge Projector§r atua como o manual oficial."
		""
		"Coloque-o no chão para projetar hologramas das receitas e entender o fluxo dos Chronons."
	]
	quest.7A00000000000002.title: "O Manual do Viajante"
	quest.7A00000000000003.quest_desc: [
		"As viagens não são de graça. O §aMetronome§r é a sua primeira máquina de energia."
		""
		"Alimente-o para que ele comece a gerar §aChronons§r, o combustível de tudo o que fará a seguir."
	]
	quest.7A00000000000003.title: "Gerador de Chronons"
	quest.7A00000000000004.quest_desc: [
		"Para usar a energia em movimento, crie a §aChronon Cell§r."
		""
		"Mantenha-a no seu inventário! Ela vai armazenar a energia das suas máquinas e alimentar os Tempads e Upgrades."
	]
	quest.7A00000000000004.title: "Bateria Temporal"
	quest.7A00000000000005.quest_desc: [
		"O ferro normal derrete nas fendas do tempo. Forje o §7Time Steel§r (Aço Temporal)."
		""
		"Esta liga é a fundação para o Tempad, Upgrades e Portais Fixos."
	]
	quest.7A00000000000005.title: "Aço Temporal"
	quest.7A00000000000006.quest_desc: ["O §eLocation Card§r armazena pontos físicos (Shift + Botão Direito no ar)."]
	quest.7A00000000000006.title: "Coordenadas Impressas"
	quest.7A00000000000007.quest_desc: [
		"A joia da coroa. O §6Tempad§r abre uma Time Door de bolso à sua frente."
		""
		"Ele armazena os seus cartões de localização e consome Chronons da sua Célula."
	]
	quest.7A00000000000007.title: "O Portal de Bolso"
	quest.7A00000000000008.quest_desc: ["O Tempad básico pode evoluir. O §8TVA Tempad§r reduz o custo de Chronons e o tempo de recarga."]
	quest.7A00000000000008.title: "Upgrade Profissional"
	quest.7A00000000000009.quest_desc: [
		"O Artefato Supremo do Multiverso."
		""
		"O §eHe Who Remains Tempad§r é um loot raro de End Cities. Custo ZERO de energia e ZERO tempo de recarga. Absoluto."
	]
	quest.7A00000000000009.title: "Aquele Que Permanece"
	quest.7A0000000000000A.quest_desc: ["O computador definitivo da TVA. A §3Workstation§r é um hub de base fixo."]
	quest.7A0000000000000A.title: "Centro de Comando"
	quest.7A0000000000000B.quest_desc: [
		"Acha que o Tempad tem pouca memória? O §bRepository Upgrade§r expande a capacidade de armazenamento."
		""
		"Instale-o para poder guardar muito mais Cartões de Localização (Location Cards) no seu dispositivo."
	]
	quest.7A0000000000000B.title: "Expansão de Memória"
	quest.7A0000000000000C.quest_desc: ["A infraestrutura pesada da TVA. O §6Time Door Projector§r usa Redstone para gerar uma fenda do tempo fixa com o Location Card inserido."]
	quest.7A0000000000000C.title: "Projetor de Porta do Tempo"
	quest.7A0000000000000D.quest_desc: [
		"Quer controlo total sobre os seus portais físicos? O §bTime Door Marker§r (Marcador de Portal) é essencial."
		""
		"Use estes blocos para marcar o local exato onde o portal deve abrir, controlando onde os jogadores vão reaparecer e ligando-o à sua rede fixa de Projectors."
	]
	quest.7A0000000000000D.title: "Estrutura do Portal"
	quest.7A0000000000000E.quest_desc: ["Joga com amigos? Se eles carregarem o §cLocation Broadcaster§r, emitirão um sinal pela rede."]
	quest.7A0000000000000E.title: "Sinalizador Multiversal"
	quest.7A0000000000000F.quest_desc: ["O §2Screening Device§r capta o sinal dos Broadcasters para encontrar jogadores na rede."]
	quest.7A0000000000000F.title: "Radar da TVA"
	quest.7A00000000000010.quest_desc: [
		"O upgrade definitivo para multiplayer! O §dPlayer Teleport Upgrade§r é instalado no Tempad."
		""
		"Combinado com os dados do Screening Device, este Upgrade altera a função do seu Tempad, permitindo focar diretamente na assinatura de outro jogador e abrir um portal direto para ele."
	]
	quest.7A00000000000010.title: "Portal para Jogadores"
	quest.7A00000000000011.quest_desc: ["O §aTime Twister§r regista mortes e permite rebobinar a linha do tempo para voltar ao local onde morreu."]
	quest.7A00000000000011.title: "Enganando a Morte"
	quest.7A00000000000012.quest_desc: ["Versões TVA e HWR do Time Twister. Histórico infinito e quase custo zero de ativação."]
	quest.7A00000000000012.title: "Domínio do Passado"
	quest.7A00000000000013.quest_desc: [
		"Um dispositivo simples de marcação rápida. O §3Chronomark§r funciona como um relógio salva-vidas."
		""
		"Marque uma localização antes de iniciar um combate perigoso. Se a situação apertar, ative-o para retornar rapidamente."
	]
	quest.7A00000000000013.title: "Ponto de Retorno Rápido"
	quest.7A2D7F61229A9270.quest_desc: ["Para sobreviver à noite, você precisa limpar os arredores. Prove seu valor abatendo as ameaças básicas."]
	quest.7A2D7F61229A9270.title: "O Bestiário Noturno"
	quest.7A46713F4A618FA8.title: "Claymore de Diamante"
	quest.7A623F268E8E20B2.quest_desc: ["O subsolo destas ilhas é rico, mas dividido em camadas rígidas de pedra. Nas camadas superiores, minere Chalkos (Cobre) e Kassiteros (Estanho). Eles são fracos sozinhos, mas formam a base metálica do mod."]
	quest.7A623F268E8E20B2.title: "A Era do Bronze Icariano"
	quest.7ABE99BE610F05E0.title: "Alvo: Mushlin Bumper"
	quest.7AC19CCFAD9E67F8.title: "Alvo: Vile Gator"
	quest.7AD5666C799C88EA.title: "Alvo: Swamp Zombie"
	quest.7AEB1F6515F0D188.title: "Estruturas Abissais"
	quest.7AF1F073C6AED927.title: "Alvo: Crab"
	quest.7AF656E0466C62B8.quest_desc: [
		"Quer ver as linhas de segurança da sua base?"
		""
		"Equipe a Lente de Rubi (Ruby Lens) no capacete! Ao usá-la, a luz infravermelha dos lasers no ambiente se tornará magicamente visível para os seus olhos, permitindo que você desvie das armadilhas."
	]
	quest.7AF656E0466C62B8.title: "Visão Tecnológica"
	quest.7B1313676D51C7B2.title: "Alvo: Bogged Shadow"
	quest.7B3154266653340F.quest_desc: [
		"Quando avistar o Saci, seja extremamente rápido!"
		""
		"Clique com o botão direito nele usando a Peneira. Assim que ele ficar preso sob ela, troque rapidamente para o Frasco de Vidro e clique nele novamente para engarrafá-lo antes que ele escape!"
	]
	quest.7B3154266653340F.title: "Saci Engarrafado"
	quest.7B3D20E645C5735D.title: "Sai de Diamante"
	quest.7B464079DB23B859.title: "Alvo: Magic Zombie"
	quest.7B677CBE5D86B617.title: "Alvo: Zombified Cultist"
	quest.7B682A52B19B6F6A.title: "Lâmina Invertida de Diamante"
	quest.7BB3E16DC868AED2.title: "Alvo: Woodland Witchdoctor"
	quest.7BF5869594FA887C.title: "Alvo: Snow Zombie"
	quest.7C12C582ADBDCE39.quest_desc: ["Você pediu a lista completa, caçador. Aqui estão as 54 ameaças isoladas da Série Luminous. Elas foram separadas em 4 colunas. Todas estão liberadas: cace-os na ordem que os encontrar pelo mundo!"]
	quest.7C12C582ADBDCE39.title: "O Fichário Completo"
	quest.7C1864EFF9F8F849.title: "Alvo: Orca"
	quest.7C34047F20CBAEF2.quest_desc: [
		"O icônico dispositivo laranja da TVA. O §6Tempad§r é um portal de bolso."
		""
		"Ele abre uma interface (GUI) onde você pode salvar infinitos locais. Ao escolher um destino, ele consome Chronons da sua Chronon Cell (no inventário) e projeta uma Time Door temporária na sua frente."
		""
		"Nunca mais perca as coordenadas da sua casa ou de spawners importantes."
	]
	quest.7C34047F20CBAEF2.title: "O Portal de Bolso"
	quest.7C3CD891F9DA356B.quest_desc: ["O ME Drive é a sua gaveta digital. Ele pode abrigar até 10 Células de Armazenamento. É aqui que seus itens físicos viram dados."]
	quest.7C3CD891F9DA356B.title: "A Servidora (ME Drive)"
	quest.7C54AD82144F94E8.title: "Alvo: Mushlin Spitter"
	quest.7C785DF14E574FCC.quest_desc: [
		"O ápice da forja Vanilla."
		""
		"Mas a Netherite pura não suporta o poder dos cristais míticos. Precisarás de um agente de ligação encontrado apenas no fim de tudo."
	]
	quest.7C785DF14E574FCC.title: "A Base Imperfeita"
	quest.7CF3674DE234E7FF.title: "Alvo: Jungle Skeleton"
	quest.7D2EC81C8E164131.title: "Alvo: Bogged Bone Stalker"
	quest.7D38ACD3F97DC149.title: "Alvo: Cave Skeleton"
	quest.7D7A5A4D6D144B58.title: "Alvo: Jungle Skeleton"
	quest.7D839FA962B45DAF.quest_desc: [
		"A terceira bioma são as Lichen Caves (Cavernas de Líquen)."
		""
		"Diferente da escuridão do sal, estas cavernas são vivas, úmidas e forradas de vegetação verdejante brilhante e cipós no teto."
	]
	quest.7D839FA962B45DAF.title: "O Jardim Subterrâneo"
	quest.7DA594F42442F6CB.title: "Alvo: Jungle Zombie"
	quest.7DC7F8DB4445E237.title: "Alvo: Hermit King"
	quest.7DDB8D25F814C8F9.quest_desc: [
		"Forjado nas profundezas do Nether. O Planador de Netherite é o suprassumo da engenharia de voo livre."
		""
		"Praticamente indestrutível, com a melhor taxa de planeio possível. Você domina os ventos como um verdadeiro mestre dos céus."
	]
	quest.7DDB8D25F814C8F9.title: "O Mestre dos Céus"
	quest.7DE1501CB6190F61.title: "Alvo: Snow Zombie"
	quest.7DFF1A60817ED7E0.title: "Alvo: Rare Phoenix"
	quest.7E17DFFEF19FAE77.title: "Alvo: Zebra"
	quest.7E4B1087C9C8591C.quest_desc: ["Do addon ExtendedAE! Este Inscriber armazena itens em massa e processa stacks inteiros de uma vez só."]
	quest.7E4B1087C9C8591C.title: "Inscriber Avançado"
	quest.7E59B6BA7CDD9B0D.quest_desc: [
		"Com a Presa, você pode forjar o Quebra-Dentes."
		""
		"Esta ferramenta quebra blocos de pedra e minérios em uma velocidade insana. Além disso, ela dá velocidade de ataque bônus em combate!"
	]
	quest.7E59B6BA7CDD9B0D.title: "O Quebra-Dentes"
	quest.7E6971DE4CCDFBAC.title: "Alvo: Bogged Bone Stalker"
	quest.7E7709E7BAD40942.quest_desc: ["Nos grandes desertos, procure por ruínas de arenito e vasos quebrados."]
	quest.7E7709E7BAD40942.title: "O Despertar da Areia"
	quest.7E9237890E124976.title: "Alvo: Scarecrow"
	quest.7EA646570A150E72.title: "Alvo: Hermit King"
	quest.7EFA7D22419C02E7.quest_desc: ["A moeda de troca dos Piglins e a base para maçãs douradas."]
	quest.7F038B63B3BA52C7.title: "Alabarda de Diamante"
	quest.7F18868266C6C9D0.quest_desc: [
		"§cAviso Supremo:§r O Warden não foi feito para ser morto, mas como você é um guerreiro de Elite com Netherite, vá em frente."
		""
		"Encontre uma Cidade Ancestral (Ancient City) e faça bastante barulho. Ele virá das profundezas do Sculk."
	]
	quest.7F18868266C6C9D0.title: "O Eco do Pesadelo"
	quest.7F1B7C2254DBC73B.quest_desc: ["Forjada com Cursium. Tem a chance de aplicar Accursed Rage, aumentando brutalmente o seu dano!"]
	quest.7F1B7C2254DBC73B.title: "Lança Amaldiçoada"
	quest.7F7A7324E369B03F.title: "Alvo: Orca"
	quest.7F979ED2154E7CBB.title: "Alvo: Zebra"
	quest.7FA7AE447334AD8C.title: "Alvo: Mushlin Bumper"
	quest.7FB0CEE76C3B8715.title: "Convergência"
	quest.7FD6CFB38AA01125.title: "Alvo: Snow Skeleton"
	quest.7FED771723EFA5C2.quest_desc: [
		"Esta arma viva atira dardos venenosos."
		""
		"O grande segredo: Se VOCÊ estiver envenenado durante qualquer batalha do jogo, clicar com o botão direito fará a arma 'sugar' o veneno de si mesmo para se recarregar, curando o seu status!"
	]
	quest.7FED771723EFA5C2.title: "O Dardo do Verme"
