	quest.4000000000000501.quest_desc: ["Forjada com Ignitium. Dano de fogo incrivelmente alto e poder de queimadura baseado no Ignis."]
	quest.4000000000000501.title: "Rapieira de Ignitium"
	quest.4000000000000502.quest_desc: ["Forjada com Ignitium. Dano de fogo incrivelmente alto e poder de queimadura baseado no Ignis."]
	quest.4000000000000502.title: "Sai de Ignitium"
