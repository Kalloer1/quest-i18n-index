	quest.4BC5704D3390FB18.title: "Alvo: Piglin Cultist"
	quest.4BC65FCDC01527ED.title: "Alvo: Crimson Walker"
	quest.4BF1AB4DEB849FF9.quest_desc: [
		"Cansado de andar a pé ou depender de cavalos? Antes de sonhar com a Elytra, você pode dominar os céus com os Planadores."
		""
		"A sua primeira asa começa com a lona básica. Salte de lugares altos e segure para planar suavemente pelo mundo!"
	]
	quest.4BF1AB4DEB849FF9.title: "O Primeiro Voo"
	quest.4BF94B6685273CB0.quest_desc: [
		"A verdadeira dança das espadas."
		""
		"Ao usar a Chave, o Underworld Knight surge. Ele tem 150 de vida e combos terríveis. Dica de Mestre: Após ele desferir uma série de golpes, ficará atordoado (de joelhos). Essa é a sua única chance de puni-lo!"
	]
	quest.4BF94B6685273CB0.title: "O Cavaleiro do Submundo"
	quest.4BFC87585EA2C52D.quest_desc: ["Você pediu a lista completa, caçador. Aqui estão as 54 ameaças isoladas da Série Luminous. Elas foram separadas em 4 colunas. Todas estão liberadas: cace-os na ordem que os encontrar pelo mundo!"]
	quest.4BFC87585EA2C52D.title: "O Fichário Completo"
	quest.4C42D5FDCEE96A5F.quest_desc: [
		"O gigante letal que habita as selvas densas e persegue suas presas à noite."
		""
		"A força dele quebra até pedras e vai partir para cima de você com tudo. Derrote-o para conquistar o seu Olho e a sua Presa."
	]
	quest.4C42D5FDCEE96A5F.title: "O Rei da Selva"
	quest.4C46B74635DC8BE1.title: "Claymore de Ouro"
	quest.4C57C3454B019379.title: "Alvo: Crab"
	quest.4CCCC9174918C77F.quest_desc: ["Seus lamentos ecoam pelas lavas. Rebata suas bolas de fogo para conseguir a lágrima regenerativa."]
	quest.4CCCC9174918C77F.title: "O Lamento do Inferno"
	quest.4CE60EC3AA02D5EC.quest_desc: [
		"Três vezes mais poder de destruição amarrado por um barbante."
		""
		"O feixe de dinamites causa uma explosão muito maior. Ideal para mineração em massa rápida ou para limpar áreas grandes do mapa."
	]
	quest.4CE60EC3AA02D5EC.title: "Feixe de Dinamites"
