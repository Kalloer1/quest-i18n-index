	quest.360F4AE28CFAF4B7.title: "Alvo: Desert Skeleton"
	quest.36192295E820DA59.title: "Alvo: Statue Mimic"
	quest.365E61D246CAD488.quest_desc: ["O Molde supremo das ilhas do fim."]
	quest.365E61D246CAD488.title: "Molde: Ametrina"
	quest.36772E2308FCF079.title: "Alvo: Statue Mimic"
	quest.367CF0CE5F10A65B.title: "Chifres de Cervo (Ouro)"
	quest.369ADF8A3E7C2C72.title: "Alvo: Pottergeist"
	quest.36BF18DDA31830EE.title: "Alvo: Crab"
	quest.36CE30995ABCA438.quest_desc: ["Seu primeiro teste de combate corpo a corpo. Sobreviva aos mortos-vivos."]
	quest.36CE30995ABCA438.title: "A Carne Podre"
	quest.3700000000000001.quest_desc: [
		"A Forja acabou de ser expandida!"
		""
		"O addon Simply More Swords traz 10 novos tipos de armas para complementar o seu estilo de luta, desde a Lâmina Invertida (Backhand Blade) até ao Bastão (Quarterstaff)."
		""
		"Forje os modelos básicos e eleve-os até ao máximo poder Rúnico. O seu arsenal nunca esteve tão versátil!"
	]
	quest.3700000000000001.title: "A Nova Forja"
	quest.3700000000000002.quest_desc: ["A Lâmina Invertida privilegia velocidade extrema e ataques surpresa."]
	quest.3700000000000002.title: "Lâmina Invertida de Ferro"
	quest.3700000000000003.quest_desc: ["Uma adaga alternativa, letal e rápida para curtas distâncias."]
	quest.3700000000000003.title: "Adaga Oculta de Ferro"
	quest.3700000000000004.quest_desc: ["Chifres de Cervo. Duas armas usadas para desviar e contra-atacar."]
	quest.3700000000000004.title: "Chifres de Cervo (Ferro)"
	quest.3700000000000005.quest_desc: ["A Montante Gigante. Lenta, mas com uma área de varredura colossal."]
	quest.3700000000000005.title: "Grandsword de Ferro"
	quest.3700000000000006.quest_desc: ["O longo alcance da Katana fundido com peso adicional."]
	quest.3700000000000006.title: "Grande Katana de Ferro"
	quest.3700000000000007.quest_desc: ["O topo do alcance. Mantenha qualquer criatura perigosa afastada."]
	quest.3700000000000007.title: "Grande Lança de Ferro"
	quest.3700000000000008.quest_desc: ["A Khopesh agarra e retalha. O meio termo perfeito entre foice e espada."]
	quest.3700000000000008.title: "Khopesh de Ferro"
	quest.3700000000000009.quest_desc: ["Lança de Cavalaria. Excelente para perfurar armaduras."]
	quest.3700000000000009.title: "Lança de Cavalaria (Ferro)"
	quest.370000000000000A.title: "Expansão de Impacto"
	quest.370000000000000B.quest_desc: ["O Pernach é uma maça flangeada focada em destruir escudos e armaduras pesadas."]
	quest.370000000000000B.title: "Pernach de Ferro"
	quest.370000000000000C.quest_desc: ["O Bastão. Extrema velocidade e dano de impacto em área."]
	quest.370000000000000C.title: "Bastão de Ferro"
	quest.370000000000000E.quest_desc: [
		"As ferramentas de entalhe (Carvers) permitem modificar e reparar as relíquias únicas."
		""
		"Use o **Runefused Carver** para aplicar modificações rúnicas padronizadas e libertar o poder selado nas armas que encontrar nos baús."
	]
	quest.370000000000000E.title: "O Mestre Entalhador"
	quest.370000000000000F.quest_desc: [
		"O entalhe do submundo."
		""
		"Se a sua arma lendária ainda não possui um Soquete do Nether (Nether Socket), o **Netherfused Carver** fará esse trabalho perfeitamente. Extraia ainda mais poder do seu arsenal!"
	]
	quest.370000000000000F.title: "A Gema do Submundo"
	quest.3700000000000013.quest_desc: [
		"O Mestre da Extensão."
		""
		"Recuperou as 36 novas Lendas Adormecidas e dominou os 10 novos estilos de combate. Você não é apenas um guerreiro, é o Deus da Forja!"
	]
	quest.3700000000000013.title: "Colecionador da Nova Forja"
	quest.3700000000000020.title: "Lenda: Ruptured Idol"
