	quest.46000000000001A3.title: "Perneiras Drakthal"
	quest.46000000000001A4.title: "Botas Drakthal"
	quest.465A87BFF60523D7.title: "Alvo: Moss Zombie"
	quest.46B4F5D05143894B.quest_desc: ["A evolução natural. O Crafting Terminal tem uma mesa de trabalho embutida. Ele puxa os itens automaticamente dos baús para a grade de craft. O melhor amigo do jogador!"]
	quest.46B4F5D05143894B.title: "A Bancada Definitiva"
	quest.46C2BD95C49AD1E3.title: "Alvo: Cave Skeleton"
	quest.46D05069A46B728B.title: "Alvo: Forest Zombie"
	quest.46F61A1A727CA9E3.title: "Alvo: Cave Skeleton"
	quest.4700000000000001.quest_desc: [
		"A Arte da Arqueria moderna."
		""
		"O Xtra Arrows expande o seu arsenal com dezenas de flechas de utilidade, combate e exploração."
		""
		"Para fabricar estas maravilhas, você precisará de componentes auxiliares, como o Controlador de Gravidade (Gravity Controller), Revestimentos e o Kit Magnético (Magnet Kit)."
	]
	quest.4700000000000001.title: "Engenharia de Flechas"
	quest.4700000000000011.quest_desc: [
		"A base da progressão militar."
		"A flecha de ferro representa o Tier Intermediário, superando a flecha de sílex comum."
	]
	quest.4700000000000011.title: "Tier Intermediário"
	quest.4700000000000012.quest_desc: [
		"O Tier Especial."
		"As flechas douradas possuem atributos excelentes para receber encantamentos superiores."
	]
	quest.4700000000000012.title: "Tier Especial (Ouro)"
	quest.4700000000000013.quest_desc: [
		"O Tier Avançado."
		"Um poder de perfuração tremendo, as flechas de diamante causam estragos maciços."
	]
	quest.4700000000000013.title: "Tier Avançado (Diamante)"
	quest.4700000000000014.quest_desc: [
		"A supremacia balística."
		"O Tier Elite. Estas flechas não só causam o dano máximo, como também são imunes ao fogo e não se queimam na lava!"
	]
	quest.4700000000000014.title: "Tier Elite (Netherite)"
	quest.4700000000000021.quest_desc: ["Gera uma detonação de área ao atingir alvos ou blocos."]
	quest.4700000000000021.title: "Explosive Arrow"
	quest.4700000000000022.quest_desc: ["Invoca relâmpagos no ponto atingido."]
	quest.4700000000000022.title: "Lightning Arrow"
	quest.4700000000000023.quest_desc: ["Drena HP do inimigo para curar o jogador (Vampirismo)."]
	quest.4700000000000023.title: "Life Steal Arrow"
	quest.4700000000000024.quest_desc: ["Atravessa obstáculos ou causa dano mágico do tipo Vex."]
	quest.4700000000000024.title: "Vexing Arrow"
	quest.4700000000000025.quest_desc: ["Aplica o estado de congelamento e reduz mobilidade."]
	quest.4700000000000025.title: "Freezing Arrow"
	quest.4700000000000026.quest_desc: ["Projétil guiado que persegue a entidade mais próxima."]
	quest.4700000000000026.title: "Tracking Arrow"
	quest.4700000000000027.quest_desc: ["Dano focado ou mecânica de decapitação maciça."]
	quest.4700000000000027.title: "Headless Arrow"
	quest.4700000000000031.quest_desc: ["Teletransporta o atirador para o ponto de impacto."]
	quest.4700000000000031.title: "Ender Arrow"
	quest.4700000000000032.quest_desc: ["Flecha elástica que ricocheteia em superfícies sólidas."]
	quest.4700000000000032.title: "Slime Arrow"
	quest.4700000000000033.quest_desc: ["Manipula a gravidade do alvo ou mantém trajetória retilínea sem queda."]
	quest.4700000000000033.title: "Gravity Arrow"
	quest.4700000000000034.quest_desc: ["Atrai itens e XP próximos para o local onde a flecha atingir."]
	quest.4700000000000034.title: "Magnetic Arrow"
	quest.4700000000000035.quest_desc: ["Otimizada para ignorar a resistência da água no combate subaquático."]
	quest.4700000000000035.title: "Atlantean Arrow"
	quest.4700000000000041.quest_desc: ["Coloca tochas comuns à distância."]
	quest.4700000000000041.title: "Torch Arrow"
	quest.4700000000000042.quest_desc: ["Coloca tochas das almas à distância."]
	quest.4700000000000042.title: "Soul Torch Arrow"
	quest.4700000000000043.quest_desc: ["Iluminação remota que posiciona lanternas."]
	quest.4700000000000043.title: "Lantern Arrow"
	quest.4700000000000044.quest_desc: ["Posiciona lanternas das almas no impacto."]
	quest.4700000000000044.title: "Soul Lantern Arrow"
	quest.4700000000000045.quest_desc: ["Ativa mecanismos colocando uma tocha de redstone."]
	quest.4700000000000045.title: "Redstone Torch Arrow"
	quest.4700000000000046.quest_desc: ["Apaga incêndios e remove o efeito de fogo das entidades."]
	quest.4700000000000046.title: "Extinguishing Arrow"
	quest.4700000000000051.quest_desc: ["Inicia o modo de reprodução em animais à distância."]
	quest.4700000000000051.title: "Breeding Arrow"
	quest.4700000000000052.quest_desc: ["Efeito de domesticação ou pacificação (Amor) aos alvos."]
	quest.4700000000000052.title: "Cupid's Arrow"
	quest.4700000000000053.quest_desc: ["Prende criaturas atingidas com um laço (lead)."]
	quest.4700000000000053.title: "Leashing Arrow"
