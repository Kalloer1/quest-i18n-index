	quest.095506DB943376A3.title: "Warglaive de Diamante"
	quest.097291EC57487D95.quest_desc: ["A receita digital. Você codifica o que quer fabricar nestes padrões."]
	quest.097291EC57487D95.title: "O Padrão Vazio"
	quest.0972C454A55BF22C.title: "Alvo: Jungle Zombie"
	quest.098902012A13C284.quest_desc: ["Forjada com Cursium. Tem a chance de aplicar Accursed Rage, aumentando brutalmente o seu dano!"]
	quest.098902012A13C284.title: "Rapieira Amaldiçoada"
	quest.09B3B05DD00877FD.title: "Alvo: Warped Spitter"
	quest.09B8133CF9B61CCA.title: "Alvo: Golden Hermit King"
	quest.09E18CF6539E9FFD.title: "Alvo: Warped Spitter"
	quest.09EE3E958B661508.quest_desc: [
		"Para quando você precisa de alcance extra e destruição imprevisível."
		""
		"A Dinamite Quicante (Bouncy Dynamite) rebate nas paredes como uma bola de borracha. Perfeita para jogar em corredores escuros de minas ou atirar por cima de muros sem se expor!"
	]
	quest.09EE3E958B661508.title: "Efeito Rebote"
	quest.09F0259462815918.title: "Alvo: Mushlin Spitter"
