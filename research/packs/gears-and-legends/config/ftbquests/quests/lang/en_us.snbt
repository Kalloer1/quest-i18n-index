	quest.5246EBE1D4C69C5A.quest_desc: [
		"Crafte os Livros em Branco na Bancada de Ferraria usando drops dos chefes."
		""
		"Clique com o botão direito na Cuca segurando o livro em branco. Ela ativará a magia para você lançar feitiços absurdos!"
	]
	quest.5246EBE1D4C69C5A.title: "O Domínio da Magia"
	quest.5254B9345D87BBDA.title: "Alvo: Rare Phoenix"
	quest.52577FF150D59361.quest_desc: [
		"Cansado de fabricar explosivos do zero? O mod adiciona uma nova profissão de Villager: o Demolidor (Demolitionist)!"
		""
		"Para transformar um Villager desempregado, você precisa da bancada de trabalho específica do mod (geralmente a Demolition Table ou Dynamite Crate)."
		""
		"Tranque um Villager com esta mesa e você poderá comprar todas as dinamites em troca de esmeraldas!"
	]
	quest.527C0BCA6B3701A5.quest_desc: [
		"O Artefato Supremo. O §eHe Who Remains Tempad§r (Tempad Daquele Que Permanece) raramente é craftado, sendo geralmente encontrado como um loot raríssimo em Cidades do Fim (End Cities)."
		""
		"Quem o possui dita as regras do multiverso: §eEle tem custo ZERO de energia e ZERO tempo de recarga§r. Teleporte infinito e absoluto."
	]
	quest.527C0BCA6B3701A5.title: "Aquele Que Permanece"
