	quest.413673FDC7136F16.quest_desc: ["O Molde de jade encontra-se nas Cidades do Fim."]
	quest.413673FDC7136F16.title: "Molde: Jade"
	quest.414D70AFC1CB5D4D.quest_desc: ["A madeira quebra, a pedra resiste. Melhore suas ferramentas e construa sua primeira fornalha."]
	quest.4155405516E90D59.quest_desc: ["Variante de Diamante. Excelente dano e durabilidade."]
	quest.4155405516E90D59.title: "Lança de Diamante"
	quest.41B22FEE95A34323.quest_desc: ["Forjada com Cursium. Tem a chance de aplicar Accursed Rage, aumentando brutalmente o seu dano!"]
	quest.41B22FEE95A34323.title: "Cutelo Amaldiçoado"
	quest.41B37EE883B1E69D.quest_desc: ["Fio grosso. Transfere até 32 Canais de uma vez só!"]
	quest.41B37EE883B1E69D.title: "Cabo Denso"
	quest.4200000000000001.quest_desc: [
		"A revolução do seu inventário começa aqui!"
		""
		"A mochila básica de couro é o equivalente a um baú normal, oferecendo 27 espaços de armazenamento e 1 slot de Upgrade."
	]
	quest.4200000000000001.title: "A Revolução do Inventário"
	quest.4200000000000002.quest_desc: [
		"O coração de todas as suas modificações."
		""
		"A Base de Upgrade (Upgrade Base) é necessária para criar as 39 funções avançadas visíveis à direita."
	]
	quest.4200000000000002.title: "Núcleo Tecnológico"
	quest.4200000000000011.quest_desc: ["Esta mochila oferece 54 espaços (um Baú Duplo) e contém 2 slots dedicados para Upgrades."]
	quest.4200000000000011.title: "Mochila de Ferro"
	quest.4200000000000012.quest_desc: ["A Mochila de Ouro aumenta o seu armazenamento para 81 slots massivos e liberta 3 slots de Upgrades para a sua gestão."]
	quest.4200000000000012.title: "Mochila de Ouro"
	quest.4200000000000013.quest_desc: ["A Mochila de Diamante oferece 108 espaços de inventário e 5 slots de Upgrades, permitindo automação extrema."]
	quest.4200000000000013.title: "Mochila de Diamante"
	quest.4200000000000014.quest_desc: ["Inacreditáveis 120 espaços e 7 slots de upgrade. Além disso, é totalmente imune a fogo e lava!"]
	quest.4200000000000014.title: "O Cofre de Netherite"
	quest.4200000000000021.quest_desc: [
		"O aspirador ambulante."
		""
		"O Pickup Upgrade recolhe automaticamente os itens em que você pisa diretamente para a mochila."
		"A versão Avançada adiciona 16 slots de filtro e regras de correspondência (NBT, Tags) para controlo absoluto!"
	]
	quest.4200000000000021.title: "A Recolha Automática"
	quest.4200000000000022.quest_desc: [
		"Puxe os tesouros para si."
		""
		"O Magnet Upgrade tem um alcance base de 3 blocos. A versão Avançada eleva esse raio para 5 blocos, sugando os itens caídos para a segurança do seu cofre."
	]
	quest.4200000000000022.title: "O Magnetismo"
	quest.4200000000000023.quest_desc: [
		"Nunca mais perca tempo numa luta."
		""
		"O Feeding Upgrade alimenta-o instantaneamente assim que sentir fome, consumindo as refeições da mochila."
		"O Refill repõe a sua barra de atalhos (hotbar) quando uma pilha de blocos ou tochas acaba."
	]
	quest.4200000000000023.title: "O Kit de Sobrevivência"
	quest.4200000000000024.quest_desc: [
		"O faz-tudo suíço."
		""
		"Adicione o Crafting Upgrade para ter uma mesa de trabalho 3x3 em movimento."
		"E para não perder tempo a escavar, o Tool Swapper troca a ferramenta na sua mão automaticamente para a melhor picareta/pá disponível para o bloco!"
	]
	quest.4200000000000024.title: "As Ferramentas de Bolso"
