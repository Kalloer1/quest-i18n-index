	quest.0A80CFE0BED7F41B.title: "Espada Longa de Ouro"
	quest.0A9C9CB71DD29560.quest_desc: [
		"Inacreditável!"
		""
		"Você completou TODAS as 54 caçadas individuais do mural. Nenhum monstro, variante ou besta gigante escapou da sua lâmina."
		""
		"Receba o prêmio máximo da Guilda."
	]
	quest.0A9C9CB71DD29560.title: "Mestre do Bestiário"
	quest.0AA6B12B72CEF138.title: "Alvo: Piglin Cultist"
	quest.0AA8433AEB8BB82F.quest_desc: ["A rede AE2 precisa de energia. O Energy Acceptor converte FE/RF convencional em energia AE pura."]
	quest.0AA8433AEB8BB82F.title: "Receptor de Energia"
	quest.0AADF708C3D3DB09.title: "Alvo: Desert Skeleton"
	quest.0AEBD545749EAD64.title: "Alvo: Warped Spitter"
	quest.0AF61CE871D2F6B5.quest_desc: ["Variante de Diamante. Excelente dano e durabilidade."]
	quest.0AF61CE871D2F6B5.title: "Espada Longa de Diamante"
	quest.0B07D8AD1BE6A889.quest_desc: ["Um cristal de extrema mobilidade escondido no subsolo das ilhas do Vazio."]
	quest.0B07D8AD1BE6A889.title: "Cristal: Jade"
	quest.0B67193666F629F3.title: "Alvo: Bogged Shadow"
	quest.0B74EBE22E43A444.quest_desc: [
		"Viagens no tempo não são de graça. Elas consomem §aChronons§r (Cronons), a energia temporal bruta."
		""
		"O §aMetronome§r é a sua primeira máquina de geração de energia. Forneça combustível a ele para que comece a extrair Chronons do ambiente. Sem ele, sua jornada acaba aqui."
	]
	quest.0B74EBE22E43A444.title: "Gerador de Chronons"
	quest.0B838D2044AAE801.title: "Alvo: Warped Spitter"
	quest.0B86A2046D40C162.title: "Alvo: Mushlin Bumper"
	quest.0B88DF22869F2E3F.title: "Alvo: Mushlin Spitter"
	quest.0B93A1CD1CC6BD83.title: "Alvo: Glider"
	quest.0B9BB69253159E2B.title: "Overlord do Abyss"
	quest.0B9FF27FC2BE158C.title: "Alvo: Red Mummy"
	quest.0BA92C81E28CEE45.quest_desc: ["Ossos pesados do titã caído, a base da forja da armadura."]
	quest.0BA92C81E28CEE45.title: "Ossos de Dragão"
	quest.0BDF85D7665B09A0.quest_desc: [
		"Janelas bonitas, mas indestrutíveis."
		""
		"O Vidro de Rubi tem um tom escarlate lindo e é 100% à prova de explosões (Blast-proof). Uma base feita com esses vidros ignorará completamente Creepers, TNTs e ataques de Ghast."
	]
	quest.0BDF85D7665B09A0.title: "Blindagem Escarlate"
	quest.0C3C770136A51D63.title: "Alvo: Cave Skeleton"
	quest.0C53BF918C9510EA.quest_desc: [
		"A bruxa jacaré habita uma cabana nos pântanos. Ela é uma entidade NEUTRA, NÃO a ataque!"
		""
		"Se você dropar o seu Saci na Garrafa para ela no chão (usando a tecla de atirar itens), ela te devolverá o Chapéu e o Cachimbo mágicos do Saci."
		"Mas a verdadeira utilidade dela é ativar feitiços..."
	]
	quest.0C53BF918C9510EA.title: "A Feiticeira Jacaré"
	quest.0C623690C28C5B73.title: "Grande Katana de Diamante"
	quest.0CA162D43D0AB2A8.title: "Alvo: Mushlin Spitter"
	quest.0D202CC61287DBB5.quest_desc: ["O Santo Graal da Gastronomia! O Presunto Glaceado com Mel (Honey Glazed Ham) exige que você integre os porcos das suas fazendas, a colheita, o mel, o fogo e a precisão da sua Panela. Este prato prova que você é o mestre absoluto de todos os fornos, caldeirões, barris e esteiras do servidor. Parabéns, Chef!"]
	quest.0D202CC61287DBB5.title: "O Supremo MasterChef"
	quest.0D2B6EA87D974AA8.title: "Alvo: Butterfly"
	quest.0D3C72849979930C.quest_desc: [
		"Sua jornada para dominar o espaço-tempo começa com recursos básicos."
		""
		"Obtenha ferro para iniciar a fabricação das primeiras peças de tecnologia da Autoridade de Variância Temporal (TVA)."
	]
	quest.0D3C72849979930C.title: "O Início da Linha do Tempo"
	quest.0D47FE0018A8778D.title: "Alvo: Swamp Zombie"
	quest.0D5D9A538ED5631C.quest_desc: [
		"O Laser de Rubi possui mecânicas avançadas com vidro Vanilla!"
		""
		"§e1. Clique com o Botão Direito no Laser:§r Ele entra no 'Modo Tinted', detectando apenas blocos colocados, ignorando entidades."
		"§e2. Vidro Colorido:§r Coloque Stained Glass na frente dele para mudar a cor do feixe."
		"§e3. Vidro Fumê (Tinted Glass):§r Encurta o feixe do laser, permitindo controle milimétrico!"
	]
	quest.0D5D9A538ED5631C.title: "Calibração e Lentes de Vidro"
	quest.0D7B0E834E266DC1.title: "Alvo: Scarecrow"
	quest.0D7FD28EF075F41E.title: "Alvo: Piglin Ghost"
	quest.0D8010BA1314D5B1.title: "Alvo: Snow Skeleton"
	quest.0DB818F1EACA53D7.title: "Alvo: Arid Yeti"
	quest.0DBA566A2FF7728C.title: "Alvo: Hermit King"
	quest.0DD6B08CEE572242.quest_desc: ["Variante de Ouro. Rápida mas frágil."]
	quest.0DD6B08CEE572242.title: "Adaga de Ouro"
	quest.0DE7D7E2F8A4D5A1.title: "Alvo: Jungle Skeleton"
	quest.0DF7AA4044A02FD4.title: "Alvo: Bogged Shadow"
	quest.0E14239CFAA565D7.quest_desc: ["Para disfarçar o Framed Cable, segure o Paint Kit, clique Shift + Direita no bloco que você quer copiar a textura (ex: Parede de Pedra), e depois clique no cabo!"]
	quest.0E14239CFAA565D7.title: "Kit de Pintura"
	quest.0E1E508572E43EAD.title: "Katana de Diamante"
	quest.0E68F3CBB5EC3248.quest_desc: [
		"Desça ao Nether e encontre a imensa Arena do Submundo (Underworld Arena)."
		""
		"Cuidado: A estrutura é massiva e o combate já começa nos corredores!"
	]
	quest.0E68F3CBB5EC3248.title: "O Coliseu Flamejante"
	quest.0E871F9FB0969278.title: "Alvo: Forest Skeleton"
	quest.0E8896F5BEF8888B.quest_desc: ["Uma iguaria que exige precisão. Esvazie uma abóbora inteira, recheie com a mais fina carne, ovos e especiarias. Coloque esta obra de arte no centro da sala para garantir saciedade máxima a todos ao redor."]
	quest.0E8896F5BEF8888B.title: "Banquete Real: Abóbora Recheada"
	quest.0E898387B09C66A1.title: "Alvo: Piglin Cultist"
	quest.0EAB95F28A58F733.quest_desc: [
		"Para capturar o mestre dos redemoinhos, você precisará de equipamento adequado."
		""
		"Crafte uma Peneira e mantenha um Frasco de Vidro vazio preparado na sua barra de acesso rápido."
	]
	quest.0EAB95F28A58F733.title: "Preparando a Armadilha"
	quest.0EC68A5AFE371C09.title: "Elmo Vermelho"
	quest.0F181EA3DBD84D71.quest_desc: [
		"O mod possui decorações que emitem luz vermelha, como Lanternas e Lâmpadas de Lava (Lava Lamps), mas o destaque vai para o Lustre (Chandelier)."
		""
		"O Lustre de Rubi tem uma física oculta: se você quebrar o bloco acima dele, ele despenca como um Dripstone, empalando e esmagando jogadores e monstros que estiverem embaixo!"
	]
	quest.0F181EA3DBD84D71.title: "Decoração Mortal"
	quest.0F209281693FFB10.quest_desc: [
		"Inacreditável!"
		""
		"Você completou todas as 54 caçadas individuais do mural. Nenhum monstro, variante ou besta gigante escapou da sua lâmina."
		""
		"Receba o prêmio máximo da Guilda."
	]
	quest.0F209281693FFB10.title: "Mestre do Bestiário"
	quest.0F32EEE503D2BD2E.title: "Alvo: Forest Skeleton"
	quest.0F6216E046B4F370.quest_desc: ["Forjada com Black Steel. Estatísticas de alto nível baseadas nos Draugr[cite: 18]."]
	quest.0F6216E046B4F370.title: "Rapieira Sombria"
	quest.0F71CF7B9ED4AD3F.title: "Alvo: Piglin Cultist Leader"
	quest.0F836B5B361CAF0A.title: "Alvo: Frigid Gator"
	quest.0F9B7BAB0CA85D84.title: "Alvo: Bone Stalker"
	quest.0F9CBF0666175DE6.title: "Alvo: Shadow"
	quest.0FA3540EDF0DD52E.quest_desc: [
		"A infraestrutura de teletransporte pesada. Coloque o §6Time Door Projector§r no chão da sua base."
		""
		"§bComo Usar:§r Insira um Location Card configurado nele. Forneça energia (Chronons) e ative-o com um sinal de Redstone. Ele abrirá uma 'Time Door' (Porta do Tempo) retangular e laranja! Basta atravessar o portal físico para ser teletransportado."
	]
	quest.0FA3540EDF0DD52E.title: "Portal Estático"
	quest.0FA37C078D726845.title: "Alvo: Piglin Cultist Leader"
	quest.0FF0F785D120D523.title: "Alvo: Frigid Gator"
	quest.1000000000000001.quest_desc: ["Tudo começa aqui. A Liga de Andesito (Andesite Alloy) é o material base para 90% das máquinas. Misture Andesito com Pepitas de Ferro ou Zinco."]
	quest.1000000000000001.title: "A Semente da Indústria"
	quest.1000000000000002.quest_desc: ["Os Óculos de Engenheiro (Goggles) são obrigatórios. Com eles, você vê quanta energia (SU) cada máquina está gerando ou consumindo."]
	quest.1000000000000002.title: "Visão de Raio-X"
	quest.1000000000000003.quest_desc: ["A Wrench gira blocos do Create e quebra máquinas instantaneamente se você usar Shift + Clique Direito."]
	quest.1000000000000003.title: "A Chave Mestra"
	quest.1000000000000004.quest_desc: ["Eixos (Shafts) são os fios de energia do Create. Transferem força em linha reta."]
	quest.1000000000000004.title: "Transferindo Rotação"
	quest.1000000000000005.quest_desc: ["Transferem energia lateralmente para outros eixos."]
	quest.1000000000000005.title: "Engrenagens Simples"
	quest.1000000000000006.quest_desc: ["A Engrenagem Grande (Large Cogwheel) é o segredo da velocidade. Conecte uma grande em uma pequena para dobrar a velocidade da rotação!"]
	quest.1000000000000006.title: "Acelerando as Coisas"
	quest.1000000000000007.quest_desc: ["A Gearbox muda a direção da rotação em ângulos de 90 graus."]
	quest.1000000000000007.title: "Curva de 90 Graus"
	quest.1000000000000008.quest_desc: ["A Hand Crank gera força girando-a com a mão. Gasta muita fome!"]
	quest.1000000000000008.title: "Energia Manual"
	quest.1000000000000009.quest_desc: ["A Water Wheel é sua fonte inicial. Coloque água escorrendo sobre ela."]
	quest.1000000000000009.title: "O Poder das Águas"
	quest.1000000000000010.quest_desc: ["Gera significativamente mais força que a versão menor, mas gira mais devagar."]
	quest.1000000000000010.title: "Rodas Gigantes"
	quest.1000000000000011.quest_desc: ["Cole Velas (Sails) no rolamento do moinho. Quanto mais blocos colados, mais energia!"]
	quest.1000000000000011.title: "Energia Eólica"
	quest.1000000000000012.quest_desc: ["Transforma lingotes em Placas (Sheets). Coloque-a sobre um bloco e jogue itens embaixo."]
	quest.1000000000000012.title: "Prensa Mecânica"
	quest.1000000000000013.quest_desc: ["Mói itens básicos. Ótima para transformar trigo em farinha."]
	quest.1000000000000013.title: "O Moinho de Pedra"
	quest.1000000000000014.quest_desc: ["Coloque 2 Eixos no chão, pegue Alga Desidratada (Kelp) e clique em ambos para formar uma Correia (Belt)."]
	quest.1000000000000014.title: "Automação: Esteiras"
	quest.1000000000000015.quest_desc: ["Funis de Andesito movem 1 item por vez entre baús e esteiras."]
	quest.1000000000000015.title: "Extraindo e Inserindo"
	quest.1000000000000016.quest_desc: ["Escondem os itens e transferem itens em linha reta entre esteiras paralelas."]
	quest.1000000000000016.title: "Túneis de Andesito"
	quest.1000000000000017.quest_desc: ["Tubos (Chutes) deixam itens caírem em baús ou esteiras."]
	quest.1000000000000017.title: "Gravidade ao seu Favor"
	quest.1000000000000018.quest_desc: ["Cofres (Item Vaults). Faça um cubo de 3x3x3 para criar um inventário colossal."]
	quest.1000000000000018.title: "Armazenamento Maciço"
	quest.1000000000000019.quest_desc: ["Se a corrente de ar passar por Água, ela 'lava' minérios. Fogo 'assa' comidas. Lava 'funde' os minérios!"]
	quest.1000000000000019.title: "O Ventilador Encapsulado"
	quest.1000000000000020.quest_desc: ["O Basin é o caldeirão. Nele, você jogará ingredientes para criar ligas avançadas."]
	quest.1000000000000020.title: "A Bacia de Misturas"
	quest.1000000000000021.quest_desc: ["Coloque ACIMA do Basin. Ele desce e mistura os itens contidos na bacia."]
	quest.1000000000000021.title: "O Misturador Mecânico"
	quest.1000000000000022.quest_desc: ["Feito com Quartzo e Redstone. Lave-o e lixe-o (Sandpaper) para polir."]
	quest.1000000000000022.title: "Preparando Eletrônicos"
	quest.1000000000000023.quest_desc: ["Electron Tubes são o 'cérebro' do maquinário inteligente do Create."]
	quest.1000000000000023.title: "O Tubo de Elétrons"
	quest.1000000000000024.quest_desc: ["Use o Empty Blaze Burner em um Blaze para prendê-lo. Coloque EMBAIXO da Bacia e dê carvão."]
	quest.1000000000000024.title: "Cativando o Calor"
	quest.1000000000000025.quest_desc: ["Com o Blaze Burner aceso sob o Basin, use o Mixer para juntar Cobre e Zinco."]
	quest.1000000000000025.title: "A Era do Latão (Brass)"
	quest.1000000000000026.quest_desc: ["Extrai até 64 itens. Tem um slot para Filtros!"]
	quest.1000000000000026.title: "O Funil Inteligente"
	quest.1000000000000027.quest_desc: ["Brass Tunnels dividem itens para várias esteiras e aceitam filtros por saída."]
	quest.1000000000000027.title: "Distribuição Elegante"
	quest.1000000000000028.quest_desc: ["Deixa cair apenas quantidades exatas ou itens filtrados."]
	quest.1000000000000028.title: "Tubo Inteligente"
	quest.1000000000000029.quest_desc: ["O Mechanical Crafter faz as receitas especiais. Junte vários na parede."]
	quest.1000000000000029.title: "A Bancada Gigante"
	quest.1000000000000030.quest_desc: ["Duas rodas moem minérios dobrando seu rendimento."]
	quest.1000000000000030.title: "Roda de Esmagamento"
	quest.1000000000000031.quest_desc: ["A Super Cola (Super Glue) gruda blocos para se moverem juntos em engenhocas."]
	quest.1000000000000031.title: "Construções em Movimento"
	quest.1000000000000032.quest_desc: ["Faz construções girarem. Perfeito para fazendas circulares!"]
	quest.1000000000000032.title: "A Rotação Estrutural"
	quest.1000000000000033.quest_desc: ["Pistões Mecânicos empurram estruturas usando Polos de Extensão."]
	quest.1000000000000033.title: "Movimento Linear"
	quest.1000000000000034.quest_desc: ["Quebram pedras. Coloque-as em engenhocas móveis para fazer máquinas devoradoras."]
	quest.1000000000000034.title: "Broca Demolidora"
	quest.1000000000000035.quest_desc: ["Em um carrinho, derruba árvores inteiras de uma vez pela base!"]
	quest.1000000000000035.title: "Serraria Portátil"
	quest.1000000000000036.quest_desc: ["O Deployer simula cliques do jogador. Ele ataca, planta e monta blocos."]
	quest.1000000000000036.title: "O Operário Metálico"
	quest.1000000000000037.quest_desc: ["Pipes movem fluidos. Precisam de pressão."]
	quest.1000000000000037.title: "Tubulação Perfeita"
	quest.1000000000000038.quest_desc: ["A Bomba Mecânica empurra fluidos pelos canos."]
	quest.1000000000000038.title: "Pressão Hidráulica"
	quest.1000000000000039.quest_desc: ["Tanks armazenam líquidos. Forme tanques gigantes de até 3x3 de base."]
	quest.1000000000000039.title: "Reserva de Fluidos"
	quest.1000000000000040.quest_desc: ["O ápice da energia mecânica. Ferva água no Fluid Tank usando Blaze Burners e Steam Engines!"]
	quest.1000000000000040.title: "O Motor a Vapor"
	quest.1000000000000041.quest_desc: ["Use o Deployer para 'bater' Ligas de Andesito em Madeira Descascada. O Andesite Casing é vital para maquinários avançados."]
	quest.1000000000000041.title: "Revestimentos (Casings)"
	quest.1000000000000042.quest_desc: ["Cobre na Madeira Descascada! Usado muito em máquinas de fluidos."]
	quest.1000000000000042.title: "Revestimento de Cobre"
	quest.1000000000000043.quest_desc: ["A porta de entrada para a tecnologia de Trens e Elevadores. Latão na Madeira Descascada!"]
	quest.1000000000000043.title: "Revestimento de Latão"
	quest.1000000000000044.quest_desc: ["O Train Casing (ou Railway Casing) é feito combinando Brass Casing com itens resistentes. Usado para criar estações e bogies."]
	quest.1000000000000044.title: "A Base do Trem"
	quest.1000000000000045.quest_desc: ["Train Tracks podem fazer curvas perfeitas e subidas inclinadas. Feitos na Prensa ou Crafter."]
	quest.1000000000000045.title: "Os Trilhos do Futuro"
	quest.1000000000000046.quest_desc: ["Coloque a Estação sobre o trilho. Clique nela com a Wrench para criar um novo trem do zero!"]
	quest.1000000000000046.title: "A Estação Ferroviária"
	quest.1000000000000047.quest_desc: ["Cole este bloco dentro do seu trem. Sente-se num banco, olhe para os controles e acelere apertando W!"]
	quest.1000000000000047.title: "Controles de Pilotagem"
	quest.1000000000000048.quest_desc: ["Como carregar o trem? Coloque uma Interface no trem e outra na Estação (com 1 bloco de distância). Elas se conectam sozinhas quando o trem para!"]
	quest.1000000000000048.title: "Interface Móvel (Itens)"
	quest.1000000000000049.quest_desc: ["O mesmo princípio da interface de itens, mas transfere tanques inteiros de água, lava ou combustível do trem para a estação e vice-versa."]
	quest.1000000000000049.title: "Interface Móvel (Fluidos)"
	quest.1000000000000050.quest_desc: ["Chega de escadas. A Elevator Pulley puxa e desce cabines inteiras criadas com a Super Glue!"]
	quest.1000000000000050.title: "A Roldana de Elevador"
	quest.1000000000000051.quest_desc: ["Essencial para Elevadores. Coloque um na cabine e outro na parede de cada andar para o elevador saber exatamente onde parar."]
	quest.1000000000000051.title: "Contato de Redstone"
	quest.1000000000000052.quest_desc: ["O Redstone Link usa pares de itens (ex: 2 maçãs) como 'senha' de frequência para transmitir sinal de redstone por todo o mapa."]
	quest.1000000000000052.title: "Redstone Sem Fio"
	quest.1000000000000053.quest_desc: ["Em vez de Liga/Desliga, esta alavanca manda forças de sinal de 1 a 15, permitindo controles precisos (perfeito com Speed Controllers)."]
	quest.1000000000000053.title: "Alavanca Analógica"
	quest.1000000000000054.quest_desc: ["O Sequenced Gearshift permite que você crie rotinas: Ex: 'Gire 90 graus, espere 5 segundos, inverta, pare'. Essencial para pontes levadiças."]
	quest.1000000000000054.title: "Programador de Rotação"
	quest.1000000000000055.quest_desc: ["Chega de gambiarras com engrenagens grandes e pequenas. Ponha uma Engrenagem Grande em cima disso e digite exatamente a velocidade (RPM) que você quer que saia dela!"]
	quest.1000000000000055.title: "Controlador de Velocidade"
	quest.1000000000000056.quest_desc: ["Quando este bloco recebe Redstone, ele simplesmente corta a transmissão de energia cinética."]
	quest.1000000000000056.title: "A Embreagem (Clutch)"
	quest.1000000000000057.quest_desc: ["Quando recebe sinal de Redstone, o Gearshift inverte imediatamente a direção da rotação. Útil para elevadores rudimentares."]
	quest.1000000000000057.title: "Marcha Ré (Gearshift)"
	quest.1000000000000058.quest_desc: ["Coloque-o em um baú, tanque ou estação, aponte para um Display Board e ele transmitirá informações (ex: Quantidade de itens ou Tempo do trem) ao vivo!"]
	quest.1000000000000058.title: "Conexão de Dados (Display Link)"
	quest.1000000000000059.quest_desc: ["Junte vários Display Boards na parede para criar telões incríveis de estação de trem ou inventário. O Display Link envia dados para eles."]
	quest.1000000000000059.title: "Telas e Letreiros"
	quest.1000000000000060.quest_desc: ["Pequenos tubos retrô. Com uma Name Tag, você pode escrever texto neles, ou conectá-los a um Display Link para mostrar números."]
	quest.1000000000000060.title: "Tubos Numéricos (Nixie)"
	quest.1000000000000061.quest_desc: ["O Spout injeta líquidos de forma precisa em itens que passem embaixo numa esteira (ex: maçãs douradas ou garrafas de XP)."]
	quest.1000000000000061.title: "Enchendo Garrafas"
	quest.1000000000000062.quest_desc: ["O Item Drain faz o oposto do Spout: ele pega itens molhados ou baldes e extrai o líquido deles de forma automática para os canos."]
	quest.1000000000000062.title: "Esvaziador de Itens"
	quest.1000000000000063.quest_desc: ["A Hose Pulley tem uma mangueira expansível que desce até o fundo do mundo. Ela drena (ou enche!) imensas piscinas de lava ou oceanos de água."]
	quest.1000000000000063.title: "Drenando Oceanos"
	quest.1000000000000064.quest_desc: ["O Copper Backtank armazena ar! Coloque no chão, gire com um Eixo (Shaft) em alta velocidade para encher. Vista como armadura para usar ferramentas movidas a ar ou respirar embaixo d'água."]
	quest.1000000000000064.title: "Mochila Pressurizada"
	quest.1000000000000065.quest_desc: ["Requer um Backtank equipado! O Potato Cannon atira qualquer vegetal do seu inventário. Batatas empurram, maçãs causam dano em área, etc."]
	quest.1000000000000065.title: "Arma de Batatas"
	quest.1000000000000066.quest_desc: ["A Extendo Grip (requer Backtank) permite que você quebre blocos, coloque itens e ataque a quase o dobro da distância normal!"]
	quest.1000000000000066.title: "O Braço Longo"
	quest.1000000000000068.quest_desc: ["O Mechanical Harvester, montado em engenhocas móveis, colhe plantações, guarda-as no baú da engenhoca e planta sementes automaticamente."]
	quest.1000000000000068.title: "Colheita Automática"
	quest.1000000000000069.quest_desc: ["O Mechanical Plough, em movimento, limpa neve, grama alta, trilhos soltos e até lança entidades para o lado sem machucar."]
	quest.1000000000000069.title: "Limpando o Caminho"
	quest.1000000000000070.quest_desc: ["Coloque-o na frente de uma engenhoca e ele aplaina o chão, preenche buracos e constrói estradas maravilhosas pavimentadas."]
	quest.1000000000000070.title: "O Rolo Compressor"
	quest.1000000000000071.quest_desc: ["O Sticker gruda o bloco em frente a ele SOMENTE quando recebe Redstone. Ótimo para garra mecânica."]
	quest.1000000000000071.title: "O Adesivo Elétrico"
	quest.1000000000000072.quest_desc: ["O Gantry Carriage se move para frente e para trás deslizando sobre Gantry Shafts. A direção muda com a rotação do eixo!"]
	quest.1000000000000072.title: "O Pórtico Deslizante"
	quest.1000000000000073.quest_desc: ["O sonho de todo construtor. Coloque no chão para definir um espelho, e tudo que você construir será duplicado (ou quadruplicado) no ar perfeitamente."]
	quest.1000000000000073.title: "Varinha de Simetria"
	quest.1000000000000074.quest_desc: ["O Encased Chain Drive permite ligar Eixos em paralelo sem usar engrenagens pesadas. Todas as polias conectadas giram na mesma velocidade e direção."]
	quest.1000000000000074.title: "Corrente Paralela"
	quest.1000000000000076.quest_desc: ["A versão 6.0 introduziu um sistema massivo de logística! Tudo começa com o Papelão (Cardboard). Use-o para começar sua frota de pacotes."]
	quest.1000000000000076.title: "A Era do Papelão"
	quest.1000000000000077.quest_desc: ["O Packager agrupa milhares de itens em uma única caixa. Conecte-o diretamente ao seu Cofre (Vault) ou baú usando um Item Hatch."]
	quest.1000000000000077.title: "O Empacotador (Packager)"
	quest.1000000000000079.quest_desc: ["Os maravilhosos Chain Conveyors movem caixas pelo ar! Conecte dois blocos a até 32 de distância. Eles transferem itens em ângulos absurdos e até carregam energia cinética."]
	quest.1000000000000079.title: "Transporte Aéreo"
	quest.1000000000000080.quest_desc: ["O Frogport puxa caixas da sua base e lança no Chain Conveyor. O Postbox recebe. Se as caixas tiverem um endereço, as máquinas farão o roteamento sozinhas!"]
	quest.1000000000000080.title: "Correios Automatizados"
	quest.1000000000000081.quest_desc: ["O Stock Link lê tudo dentro de um baú ou cofre. Coloque um Factory Gauge na parede e vincule-o ao link para exibir painéis digitais fantásticos do seu armazém!"]
	quest.1000000000000081.title: "Monitoramento de Estoque"
	quest.10043F7CC5EE72C3.title: "Alvo: Piglin Executioner"
	quest.1014E94E97A549B5.quest_desc: ["Variante de Ouro. Rápida mas frágil."]
	quest.1014E94E97A549B5.title: "Alabarda de Ouro"
	quest.1055437D2ABB593A.title: "Alvo: Swamp Zombie"
	quest.108604E4FDFD5723.quest_desc: ["O Molde do deserto. Focado em resistir ao desgaste."]
	quest.108604E4FDFD5723.title: "Molde: Topázio"
	quest.10A0DCB9E53EA544.title: "Lança de Cavalaria (Diamante)"
	quest.10C25E2309596801.title: "Alvo: Arid Yeti"
	quest.10D31498F009F4B6.title: "Alvo: Pottergeist"
	quest.10EAF93D579B88CA.quest_desc: [
		"Inacreditável!"
		""
		"Você completou TODAS as 54 caçadas individuais do mural. Nenhum monstro, variante ou besta gigante escapou da sua lâmina."
		""
		"Receba o prêmio máximo da Guilda."
	]
	quest.10EAF93D579B88CA.title: "Mestre do Bestiário"
	quest.1100000000000001.quest_desc: [
		"Bem-vindo ao arsenal mágico do mod Awesome Wands!"
		""
		"A mecânica aqui é direta e incrivelmente poderosa: você precisa forjar as Runas Elementais (as pedras esculpidas) e combiná-las para criar Varinhas com poderes devastadores."
		""
		"Escolha o seu caminho, crafte a runa correspondente e domine os elementos."
	]
	quest.1139B5CAA18FD6F8.quest_desc: ["O Molde do vazio gélido do Nether."]
	quest.1139B5CAA18FD6F8.title: "Molde: Safira"
	quest.11A9194A7F832B73.quest_desc: ["Escondido bem fundo no Soul Sand Valley (Vale das Areias das Almas)."]
	quest.11A9194A7F832B73.title: "Cristal: Safira"
	quest.11EEDBE203CF1706.title: "Grande Lança de Ouro"
	quest.122938850AF9B0BF.quest_desc: [
		"Uma janela com tonalidade vermelha belíssima que é completamente à prova de explosões (Blast-proof)."
		""
		"Perfeita para proteger sua base contra bolas de fogo de Ghasts e explosões de Creepers."
	]
	quest.122938850AF9B0BF.title: "Vidro Blindado"
	quest.12710F47199BD5DC.title: "Alvo: Swamp Zombie"
	quest.12720166BB2075F8.quest_desc: [
		"Use o Couro Flamejante dropado da Mula para aprimorar o seu Quebra-Dentes."
		""
		"Vá até a Bancada de Ferraria (Smithing Table) e junte o Quebra-Dentes + Couro Flamejante + Vara de Blaze. O resultado é o Quebra-Fogo, causando absurdos 10.5 de dano e incendiando qualquer monstro tocado!"
	]
	quest.12720166BB2075F8.title: "A Arma Suprema"
	quest.12788DB115BE2A01.title: "Alvo: Piglin Cultist Leader"
	quest.12DC6628C7328FA5.quest_desc: ["O Molde do deserto. Focado em resistir ao desgaste físico."]
	quest.12DC6628C7328FA5.title: "Molde: Topázio"
	quest.12FF3BBA2AA1E99A.quest_desc: ["Variante de Diamante. Excelente dano e durabilidade."]
	quest.12FF3BBA2AA1E99A.title: "Rapieira de Diamante"
	quest.130BB00364A0F405.title: "Alvo: Warped Spitter"
	quest.133660A6EA6A427D.title: "Alvo: Librarian Skeleton"
	quest.136C003FB39B83E7.title: "Alvo: Piglin Cultist Rider"
	quest.1380E6864B8C798E.quest_desc: ["A rocha negra e indestrutível que forma o meteorito. Quebre-a para chegar ao centro."]
	quest.1380E6864B8C798E.title: "Sky Stone"
	quest.138327C815BC5519.title: "Alvo: Warped Spitter"
	quest.138E2E127A375CB7.quest_desc: [
		"A tecnologia da TVA não pode ser adivinhada. O §6Knowledge Projector§r atua como o manual oficial."
		""
		"Coloque-o no chão para projetar hologramas das receitas e entender o fluxo dos Chronons."
	]
	quest.138E2E127A375CB7.title: "O Manual do Viajante"
	quest.13C40C9390AD058A.title: "Alvo: Mummy"
	quest.13EDD3708629E4C4.title: "Alvo: Bone Stalker"
	quest.1400000000000001.quest_desc: [
		"O Palladium (ou Silver/Prata em algumas versões) é o novo metal primário destas cavernas."
		""
		"Ao derretê-lo, poderá forjar uma armadura especial que lhe concede resistência a explosões e a habilidade de caminhar sobre a Neve Fofa (Powder Snow) sem se afundar!"
	]
	quest.1400000000000001.title: "O Metal Brilhante"
	quest.1400000000000002.quest_desc: [
		"Junte um Lingote de Prata/Paládio com qualquer peça de Armadura de Couro na Bancada de Ferraria (Smithing Table)."
		""
		"Você criará a Armadura de Sterling! Ela não só é incrivelmente estilosa, como te concede Resistência a Explosões nativa. (E você pode até pendurar um Banner no capacete!)"
	]
	quest.1400000000000002.title: "Proteção Sterling"
	quest.1400000000000003.quest_desc: ["As bombas de Palladium podem ser atiradas e causam explosões que não destroem blocos muito resistentes."]
	quest.1400000000000003.title: "Artilharia Mineira"
	quest.1400000000000004.quest_desc: [
		"Esta mesa permite-lhe melhorar as suas bombas!"
		""
		"Use Bolas de Slime para as fazer saltar, Fios (String) para atrasar o temporizador, ou mais Pólvora para aumentar colossalmente a área da explosão."
	]
	quest.1400000000000004.title: "Mesa de Combustão"
	quest.1400000000000005.quest_desc: ["Gerados habitualmente sob biomas frios, estes abismos maravilhosos são formados por enormes cristais de Allurite e Lumiere."]
	quest.1400000000000005.title: "Cânions de Cristal"
	quest.1400000000000006.quest_desc: [
		"Além da ametista comum, os cânions abrigam dois novos cristais magníficos:"
		""
		"§e• Lumiere:§r Cristais amarelos extremamente luminosos."
		"§d• Allurite:§r Cristais roxo-rosados de pura magia natural."
	]
	quest.1400000000000006.title: "Brilho Subterrâneo"
	quest.1400000000000007.quest_desc: [
		"A Lâmpada de Lumiere não serve apenas para iluminar!"
		""
		"Ela emite um sinal de Redstone cuja força aumenta de acordo com a quantidade de monstros (mobs) presentes ao seu redor. Uma ferramenta de segurança e automação incrível."
	]
	quest.1400000000000007.title: "O Radar de Monstros"
	quest.1400000000000008.quest_desc: ["Biomas escuros e húmidos, onde os fungos ganham proporções monstruosas e o líquen brilha intensamente nas paredes rochosas."]
	quest.1400000000000008.title: "Cavernas de Líquen"
	quest.1400000000000009.quest_desc: ["Um bioma subterrâneo repleto de estalactites e estalagmites com um tom rosa vibrante."]
	quest.1400000000000009.title: "Cavernas de Sal Rosa"
	quest.140000000000000A.quest_desc: [
		"Escondido nas Cavernas de Sal Rosa, você pode tropeçar no Pink Salt Shrine (Santuário de Sal Rosa)."
		""
		"É uma masmorra traiçoeira, cheia de armadilhas mortais feitas de sal grosso e tesouros obscuros."
	]
	quest.140000000000000A.title: "Tijolos de Sal"
	quest.140000000000000B.quest_desc: [
		"Cuidado ao explorar os recintos secretos deste bioma."
		""
		"Nas misteriosas estruturas chamadas Santuários de Sal Rosa (Pink Salt Shrines), você pode deparar-se com o Berserker!"
		"Ele é um Mini-Boss furioso e ancestral que espalha uma aura chamada 'Block Bane' ao seu redor."
		""
		"Prepare as suas melhores poções e enfrente esta fúria das profundezas!"
	]
	quest.140000000000000B.title: "O Culto do Berserker"
	quest.140000000000000C.quest_desc: [
		"A Lichen Cordyceps é uma planta aquática bastante especial."
		""
		"Se a consumir enquanto estiver a mergulhar, ela concede-lhe uma bolha de oxigénio extra, permitindo-lhe ultrapassar o limite de ar sem se afogar de imediato!"
	]
	quest.140000000000000C.title: "Fôlego Fúngico"
	quest.140000000000000D.quest_desc: [
		"Procure pelas estruturas de pedras antigas cobertas de musgo chamadas Forgotten Ruins (Ruínas Esquecidas)."
		""
		"Muitos mistérios e loots especiais do mod se escondem nestes corredores de tijolos seculares."
	]
	quest.140000000000000D.title: "Civilização Perdida"
	quest.140000000000000E.quest_desc: [
		"Nas ruínas, procure por buracos na parede (Burrows). Eles são a casa das Toupeiras (Moles) do mod!"
		""
		"§eMissão de Mineração:§r As toupeiras vão sair cavando pelo subsolo e, de tempos em tempos, retornarão ao buraco deixando para trás uma Mining Pouch (Bolsa de Mineração) lotada de itens para você resgatar!"
	]
	quest.140000000000000E.title: "Mochila de Mineração"
	quest.140000000000000F.quest_desc: [
		"O espólio de guerra contra o Boss!"
		""
		"O Saltbound Tablet é uma arma mágica impressionante. Ao ativá-lo, o amuleto conjura uma linha de pilares afiados de sal rosa que brotam diretamente do chão, espetando e causando danos terríveis a quem estiver no caminho!"
		""
		"Ele ainda pode receber os seus próprios encantamentos exclusivos:"
		"- **Enfeeble:** Aplica efeito de lentidão (Slowness) nos monstros atingidos."
		"- **Sustain:** Aumenta muito o tempo em que os pilares permanecem em campo."
		"- **Rupture:** Os pilares fragmentam-se e explodem em estilhaços afiados ao retraírem!"
	]
	quest.140000000000000F.title: "O Artefato de Sal"
	quest.1400000000000010.quest_desc: [
		"As Flares (Sinalizadores) são a melhor forma de mapear o escuro."
		""
		"Atire um Glow Flare ou um Spectre Flare para o fundo de uma ravina. Eles iluminam a área à medida que caem, revelando os perigos ocultos antes de você descer."
	]
	quest.1400000000000010.title: "A Luz do Abismo"
	quest.1400000000000011.quest_desc: [
		"Prenda o brilho mágico num frasco com o Bottled Flare (Sinalizador Engarrafado)."
		"Esta é uma excelente lanterna portátil para decoração rústica ou uso tático nas cavernas de sal e cristal."
	]
	quest.1400000000000011.title: "A Luz Engarrafada"
	quest.1400000000000012.quest_desc: [
		"Uma arma ágil e espetacular!"
		""
		"O Rope Dart (Dardo de Corda) pode ser arremessado a longas distâncias. Ele prende-se em entidades ou monstros, permitindo-lhe puxá-los diretamente na sua direção com um esticão letal."
	]
	quest.1400000000000012.title: "O Dardo de Corda"
	quest.1400000000000013.quest_desc: [
		"O pesadelo de cair em ravinas escuras acabou."
		""
		"A Burrow Anchor (Âncora de Escavação) fixa-se ao solo e permite que se desloque para baixo em segurança, funcionando como um cabo de descida para os abismos da Galosphere."
	]
	quest.1400000000000013.title: "A Descida Segura"
	quest.1400000000000015.quest_desc: [
		"As profundezas escondem segredos de ressonância acústica."
		""
		"Construa o Echo Altar (Altar do Eco) para manipular certas energias no subsolo, e utilize o Echo Bell (Sino do Eco) para mapear vibrações através das paredes da caverna!"
	]
	quest.1400000000000015.title: "Mecânicas de Som"
	quest.1400000000000016.title: "Sino do Vazio"
	quest.140FF16D05E2EB41.quest_desc: [
		"O troféu do matador de dragões."
		""
		"Serve como o capacete do set Draconiano. Oferece grande blindagem, Recuperação de Movimento e proteção contra fogo!"
	]
	quest.140FF16D05E2EB41.title: "Crânio de Dragão"
	quest.142D4622F7829686.quest_desc: ["Variante de Ouro. Rápida mas frágil."]
	quest.142D4622F7829686.title: "Warglaive de Ouro"
	quest.1441A04882BC0C23.quest_desc: [
		"Com os seus lingotes e pólvora, você forja a Silver Bomb (Bomba de Prata)."
		""
		"Um explosivo de arremesso que explode blocos de baixa resistência após um pequeno atraso."
	]
	quest.1441A04882BC0C23.title: "Explosão Controlada"
	quest.14BB25EF8D2DC4FA.quest_desc: ["Coloque este filtro dentro de um Inventory Hopper para dizer exatamente quais itens devem ser sugados ou ignorados."]
	quest.14BB25EF8D2DC4FA.title: "Filtro Simples"
	quest.14C56BF9B541D038.title: "Alvo: Swamp Skeleton"
	quest.1500000000000001.quest_desc: [
		"O folclore brasileiro despertou no Minecraft."
		""
		"Prepare-se para explorar novos biomas, realizar rituais sombrios e caçar lendas para forjar equipamentos e feitiços absurdos."
	]
	quest.15074C5C13138E28.title: "Alvo: Piglin Ghost"
	quest.15107F831299B727.quest_desc: [
		"Combine os seus fragmentos de Lumiere ou Allurite com pó de pedra luminosa (Glowstone) na bancada."
		""
		"Você forjará Lâmpadas de Cristal deslumbrantes que adicionam uma estética mística a qualquer construção."
	]
	quest.15107F831299B727.title: "Iluminação Majestosa"
	quest.1547026C97AEBDC4.quest_desc: ["Forjada com Cursium. Tem a chance de aplicar Accursed Rage, aumentando brutalmente o seu dano!"]
	quest.1547026C97AEBDC4.title: "Espada Longa Amaldiçoada"
	quest.1570BFE0CE60C753.title: "Alvo: Basalt Executioner"
	quest.159B5D12CDD3E172.title: "Chifres de Cervo (Diamante)"
	quest.159DB3CEB1BFB718.quest_desc: [
		"O gigante letal que habita as selvas densas e persegue suas presas à noite."
		""
		"A força dele quebra até pedras e vai partir para cima de você com tudo. Derrote-o para conquistar o seu Olho e a sua Presa bruta."
	]
	quest.159DB3CEB1BFB718.title: "O Rei da Selva"
	quest.15AB23FBF61D5071.title: "Alvo: Orca"
	quest.15C6D9B6D7B3005D.quest_desc: [
		"Sua primeira ferramenta de precisão."
		""
		"A Dinamite padrão pode ser arremessada. Ela gera uma explosão pequena e controlada, perfeita para abrir túneis ou explodir um pequeno grupo de zumbis sem destruir a montanha inteira ao seu redor."
	]
	quest.15C6D9B6D7B3005D.title: "Dinamite Básica"
	quest.15D4FA9EEB2423D4.quest_desc: ["Encoste isso num Pattern Provider. Ele é a 'bancada de trabalho rápida'. Crafa itens normais (como gravetos ou baús) instantaneamente."]
	quest.15D4FA9EEB2423D4.title: "Molecular Assembler"
	quest.15D99B36B9A93575.title: "Alvo: Piglin Cultist"
	quest.1600000000000001.quest_desc: [
		"A era da caminhada acabou! O mod Immersive Aircraft traz a revolução industrial para os céus do Minecraft."
		""
		"A sua primeira peça na linha de montagem é o Casco (Hull), forjado com madeira descascada e ferro."
	]
	quest.1600000000000001.title: "O Casco"
	quest.1600000000000002.quest_desc: [
		"Para domar os ventos, você precisa de Velas (Sail)."
		""
		"Feitas com carpete branco e linha, elas são leves e duráveis."
	]
	quest.1600000000000002.title: "As Velas"
	quest.1600000000000003.quest_desc: [
		"A tração primária da aeronáutica."
		""
		"Crafte várias Hélices (Propeller), pois quase todas as aeronaves exigem pelo menos uma."
	]
	quest.1600000000000003.title: "A Hélice"
	quest.1600000000000004.quest_desc: ["A câmara de pressão. Transforma calor bruto em energia de voo."]
	quest.1600000000000004.title: "A Caldeira"
	quest.1600000000000005.quest_desc: [
		"O coração da aviação moderna."
		""
		"Com ele, suas máquinas não dependerão mais do vento. Queime carvão ou lava para dominar os céus!"
	]
	quest.1600000000000005.title: "O Motor"
	quest.1600000000000006.quest_desc: [
		"O avanço tecnológico definitivo."
		""
		"As Engrenagens Industriais (Industrial Gears) não são veículos, mas sim o passaporte para criar as armas e os upgrades mais avançados da sua frota."
	]
	quest.1600000000000006.title: "Engrenagens Industriais"
	quest.1600000000000007.quest_desc: [
		"Uma engenhoca brilhante, mas que exige pernas fortes."
		""
		"Não usa motor. Você pedala para voar! Mas atenção: manter essa aeronave no ar consumirá a sua barra de fome (Hunger) velozmente."
	]
	quest.1600000000000007.title: "O Girodino"
	quest.1600000000000008.quest_desc: [
		"Um drone pessoal impulsionado a motor."
		""
		"Paira no ar de forma estável, tornando-se perfeito para substituir andaimes durante construções altas."
	]
	quest.1600000000000008.title: "Quadricóptero"
	quest.1600000000000009.quest_desc: [
		"A aeronave mais rápida e ágil do mod."
		""
		"Corta os céus em velocidades altas, mas exige um trecho plano (pista de pouso) para decolar."
	]
	quest.1600000000000009.title: "O Biplano"
	quest.160000000000000A.quest_desc: [
		"Lento, charmoso e muito fácil de manobrar."
		""
		"Comporta dois passageiros. Perfeito para transportar aquele Villager teimoso."
	]
	quest.160000000000000A.title: "Dirigível"
	quest.160000000000000B.quest_desc: [
		"Sacrifica velocidade por capacidade logística."
		""
		"Esta variante suporta baús gigantes conectados do lado de fora. A melhor escolha para esvaziar cavernas!"
	]
	quest.160000000000000B.title: "Dirigível de Carga"
	quest.160000000000000C.quest_desc: [
		"O leviatã de combate."
		""
		"Com 3 motores e blindagem reforçada, permite a instalação simultânea de múltiplos canhões e bombardeadores."
	]
	quest.160000000000000C.title: "Navio de Guerra"
	quest.160000000000000D.quest_desc: [
		"Não fique preso na cor padrão."
		""
		"Você pode personalizar as suas aeronaves utilizando Corantes e até Estandartes (Banners) para criar a sua própria pintura de guerra!"
	]
	quest.160000000000000D.title: "Customização: Cores"
	quest.160000000000000E.quest_desc: ["Cole o seu estandarte na lateral do veículo e domine os céus com estilo."]
	quest.160000000000000E.title: "Customização: Estandartes"
	quest.160000000000000F.quest_desc: [
		"Encanamento superior."
		""
		"Concede +10% de poder bruto ao motor da sua nave."
	]
	quest.160000000000000F.title: "Canos Resistentes"
	quest.1600000000000010.quest_desc: [
		"A evolução do ferro."
		""
		"Esta caldeira fornece um aumento substancial de +25% de velocidade de voo."
	]
	quest.1600000000000010.title: "Caldeira de Aço"
	quest.1600000000000011.quest_desc: [
		"Mais lento, porém sustentável."
		""
		"O Eco Engine corta a velocidade do veículo, mas o torna 75% mais eficiente no consumo de carvão!"
	]
	quest.1600000000000011.title: "Motor Ecológico"
	quest.1600000000000012.quest_desc: [
		"O motor absoluto."
		""
		"Concede incríveis +40% de potência, mas o consumo de combustível da sua nave sobe em 30%."
	]
	quest.1600000000000012.title: "Motor do Nether"
	quest.1600000000000013.quest_desc: [
		"O pneu ideal para decolagens."
		""
		"Instalar esse upgrade na sua aeronave torna o tempo de decolagem 50% mais rápido."
	]
	quest.1600000000000013.title: "Trem de Pouso Aprimorado"
	quest.1600000000000014.quest_desc: [
		"Aerodinâmica perfeita."
		""
		"Reduz a fricção com o ar em estrondosos 75%, tornando sua máquina extremamente manobrável."
	]
	quest.1600000000000014.title: "Hélice Aprimorada"
	quest.1600000000000015.quest_desc: [
		"Estabilidade total."
		""
		"Garante que ventos e tempestades não joguem mais a sua aeronave para os lados."
	]
	quest.1600000000000015.title: "O Giroscópio"
	quest.1600000000000016.quest_desc: [
		"Sobreviva ao fogo inimigo."
		""
		"Dobra a durabilidade e os pontos de vida da sua nave."
	]
	quest.1600000000000016.title: "Reforço de Casco"
	quest.1600000000000017.quest_desc: [
		"Precisão nos céus."
		""
		"Peça mecânica avançada para controles de direção."
	]
	quest.1600000000000017.title: "O Joystick"
	quest.1600000000000018.quest_desc: [
		"Apoio aéreo pesado!"
		""
		"Instale e coloque Pólvora (Gunpowder) no inventário da nave para disparar rajadas."
	]
	quest.1600000000000018.title: "Canhão Rotativo"
	quest.1600000000000019.quest_desc: [
		"Precisão mortal."
		""
		"Consome as flechas do inventário e dispara na velocidade do seu clique."
	]
	quest.1600000000000019.title: "Balestra Pesada"
	quest.160000000000001A.quest_desc: [
		"Bombardeio tático."
		""
		"Solta diretamente as TNTs que estiverem no compartimento de carga do veículo."
	]
	quest.160000000000001A.title: "Compartimento de Bombas"
	quest.160000000000001B.quest_desc: [
		"Veja muito além das nuvens."
		""
		"Lente potente para navegação segura e reconhecimento de área inimiga."
	]
	quest.160000000000001B.title: "Telescópio Aéreo"
	quest.161C0847DD836308.quest_desc: [
		"Para servidores e multiplayer, o §cLocation Broadcaster§r é incrível."
		""
		"Se o seu amigo deixar este item no inventário (ou slot de curio), ele começará a emitir um sinal constante da localização dele através das dimensões."
	]
	quest.161C0847DD836308.title: "Sinalizador Pessoal"
	quest.1621D148C852F0A3.title: "Bastão de Ouro"
	quest.16260AD567C4E886.quest_desc: [
		"Coloque uma Fogueira das Almas (Soul Campfire) no chão e clique com o botão direito nela segurando o Sangue de Cachorro."
		""
		"O cheiro vai invocar a fera humanoide. Derrote o Capelobo e colete a sua Língua (pode ser cozida) e a sua Garra afiada!"
	]
	quest.16260AD567C4E886.title: "O Ritual da Fera"
	quest.1636C8A6CD009F05.quest_desc: ["A fusão perfeita: Farmer's Delight encontra o mod Create! O Central Kitchen permite que você use o Heated Basin (Bacia Aquecida) e o Mixer Mecânico do Create para fazer receitas da Panela. Além disso, braços mecânicos (Deployers) podem usar facas na tábua de corte sozinhos!"]
	quest.1636C8A6CD009F05.title: "Central Kitchen (Automação Base)"
	quest.16EA5CFA658E6B65.title: "Alvo: Desert Zombie"
	quest.16FD7FBB2421EDB6.title: "Alvo: Desert Skeleton"
	quest.1700000000000001.quest_desc: [
		"Levante as âncoras! A era da navegação avançada começou."
		""
		"A primeira peça fundamental para a construção de qualquer embarcação do mod Small Ships é a Vela (Sail)."
		""
		"Produza velas suficientes para começar a montar a sua frota."
	]
	quest.1700000000000001.title: "A Era da Navegação"
	quest.1700000000000002.quest_desc: [
		"Sua primeira embarcação verdadeira."
		""
		"O Cog é um navio mercante de um mastro só. Ele é rápido, ágil e perfeito para explorar os oceanos iniciais ou transportar pequenas quantidades de carga."
	]
	quest.1700000000000002.title: "O Navio Mercante"
	quest.1700000000000004.quest_desc: [
		"Maior, mais larga e mais robusta."
		""
		"A Galé (Galley) é projetada para aguentar viagens oceânicas longas, permitindo transportar passageiros e muito mais loot no convés."
	]
	quest.1700000000000004.title: "A Galé"
	quest.1700000000000005.quest_desc: [
		"Liberte a fúria nórdica."
		""
		"O Drakkar (navio Viking) é longo, intimidador e corta as águas com uma velocidade surpreendente, ideal para ataques rápidos e exploração costeira."
	]
	quest.1700000000000005.title: "O Drakkar Nórdico"
	quest.1700000000000006.quest_desc: [
		"O orgulho da sua armada."
		""
		"A Briguentina (Brigg) é a embarcação definitiva do mod. Com múltiplos mastros, espaço massivo para canhões e carga, ela transforma você no verdadeiro rei dos mares."
	]
	quest.1700000000000006.title: "A Briguentina"
	quest.1700000000000007.quest_desc: [
		"Seu navio, suas regras."
		""
		"Você pode alterar a bandeira que fica no mastro principal do seu navio simplesmente segurando um Estandarte (Banner) e clicando com o botão direito nele!"
	]
	quest.1700000000000007.title: "Bandeira Pirata"
	quest.1700000000000008.quest_desc: [
		"Prepare-se para o combate ship-to-ship."
		""
		"Você pode montar Canhões (Cannons) nos espaços designados (mounts) do convés do seu navio. Mire com precisão e afunde a frota inimiga ou exploda bases costeiras!"
	]
	quest.1700000000000008.title: "Artilharia Naval"
	quest.1700000000000009.quest_desc: [
		"Para atirar, você precisa de munição pesada."
		""
		"Crafte Balas de Canhão (Cannonballs) e mantenha-as no seu inventário. Quando estiver operando o canhão no navio, a munição será consumida automaticamente ao disparar."
	]
	quest.1700000000000009.title: "Fogo no Buraco!"
	quest.170C46924253C2DD.title: "Célula de 16k"
	quest.1713D602DFAF14F8.title: "Alvo: Mushlin Bumper"
	quest.172B48A0C7B7D607.quest_desc: [
		"Sua fábrica cresceu demais. Baús não dão mais conta."
		""
		"O AE2 transforma matéria física em dados digitais. Tudo começa minerando Certus Quartz nas profundezas do mundo."
	]
	quest.172B48A0C7B7D607.title: "A Era da Informação"
	quest.172D9C0B61376E55.quest_desc: ["O computador definitivo da TVA. A §3Workstation§r é um hub de base fixo."]
	quest.172D9C0B61376E55.title: "Centro de Comando"
	quest.17F3AA2BFD019F92.quest_desc: [
		"Inacreditável!"
		""
		"Você completou TODAS as 54 caçadas individuais do mural. Nenhum monstro, variante ou besta gigante escapou da sua lâmina."
		""
		"Receba o prêmio máximo da Guilda."
	]
	quest.17F3AA2BFD019F92.title: "Mestre do Bestiário"
	quest.1800000000000001.quest_desc: [
		"A jornada para as estrelas começa no seu próprio mundo."
		""
		"Explore o Overworld até encontrar as antigas Ruínas do Portal Estelar. Você vai andar bastante, então forje uma Espada de Ferro para se proteger durante a busca!"
	]
	quest.1800000000000001.title: "A Busca pelo Portal"
	quest.1800000000000002.quest_desc: [
		"Lá nas ruínas do portal, você encontrará uma criatura enigmática conhecida como O Guardião (Gatekeeper)."
		""
		"Derrote-o em combate para provar o seu valor e reivindicar a chave de acesso à dimensão!"
	]
	quest.1800000000000002.title: "O Gatekeeper"
	quest.1800000000000003.quest_desc: [
		"Com o Orbe da Profecia (Orb of Prophecy) dropado pelo Guardião em mãos, volte à estrutura do portal."
		""
		"Limpe as vinhas que bloqueiam os blocos e clique com o botão direito segurando o Orbe (como se fosse isqueiro em um portal do Nether) para acender a fenda!"
	]
	quest.1800000000000003.title: "A Chave Dimensional"
	quest.1800000000000004.quest_desc: [
		"Atravesse o portal!"
		""
		"Bem-vindo ao Eternal Starlight, um mundo de céus escuros, plantas luminescentes e magias esquecidas. A sua presença na dimensão concluirá esta missão."
	]
	quest.1800000000000004.title: "A Dimensão Astral"
	quest.1800000000000006.quest_desc: [
		"Essencial para não se perder."
		""
		"O Seeking Eye (Olho Rastreador) é utilizado para localizar as masmorras e os chefes exatos que você precisa enfrentar para progredir."
	]
	quest.1800000000000006.title: "A Bússola Arcana"
	quest.1800000000000007.quest_desc: [
		"Explore o temível Pântano Sombrio (Dark Swamp)."
		""
		"Nas suas profundezas lamacentas, você encontrará o Nightfall Mud, escondendo segredos e minérios preciosos."
	]
	quest.1800000000000007.title: "Lama do Crepúsculo"
	quest.1800000000000008.quest_desc: [
		"Uma madeira azulada e mística da Floresta Estelar."
		""
		"Se você descascar as Toras de Torreya com um machado, tem uma alta chance de extrair Amaramber (Resina de Âmbar), essencial para diversos crafts."
	]
	quest.1800000000000008.title: "Floresta de Torreya"
	quest.1800000000000009.quest_desc: ["O âmbar precioso extraído diretamente das madeiras de Torreya descascadas."]
	quest.1800000000000009.title: "Âmbar Estelar"
	quest.180000000000000A.quest_desc: ["A Prata Profunda (Deepsilver) é o minério base da dimensão, equivalente ao Ferro."]
	quest.180000000000000A.title: "Prata Profunda"
	quest.180000000000000B.quest_desc: [
		"O mod possui um sistema de feitiços complexo!"
		""
		"Ao segurar o Orbe da Profecia nas mãos, pressione a tecla 'H' para alternar entre os seus Feitiços (Spells) destravados. Clique com o botão direito para conjurá-los! Derrotar o Golem repetidas vezes pode aprimorar suas magias."
	]
	quest.180000000000000B.title: "O Domínio Arcano"
	quest.180000000000000C.quest_desc: [
		"Habitantes enigmáticos da dimensão."
		""
		"Procure pelo Covil (Stranghoul Den) para encontrar esses NPCs únicos. Consiga algumas Esmeraldas para poder realizar trocas (barter) com eles ou até mesmo contratá-los como mercenários!"
	]
	quest.180000000000000C.title: "Comércio Sombrio"
	quest.180000000000000D.quest_desc: [
		"O Buscador (Seeker) é um monstro voador assustador que lembra uma lula."
		""
		"Ao derrotá-lo, você pode obter a sua arma característica: O Tentacle Spike, um chicote devastador!"
	]
	quest.180000000000000D.title: "O Predador dos Céus"
	quest.180000000000000E.quest_desc: [
		"O seu próximo grande desafio principal é a Forja do Golem (Golem Forge)."
		""
		"Este é um labirinto subterrâneo denso, cheio de armadilhas e loots exclusivos. Prepare-se fabricando Tochas para iluminar o caminho escuro e marcar por onde já passou!"
	]
	quest.180000000000000E.title: "O Labirinto Metálico"
	quest.180000000000000F.quest_desc: [
		"O Golem Estelar (Starlight Golem) é implacável."
		""
		"Ele fica completamente IMUNE a danos enquanto está atacando! Você deve desviar e atacá-lo apenas nos intervalos. Quando a vida dele cair abaixo de 20%, ele entrará na letal Fase 2. Destrua-o!"
	]
	quest.180000000000000F.title: "O Titã de Aço"
	quest.1800000000000010.quest_desc: [
		"Ao derrotar o Golem, você adquire a Bolsa de Tesouros contendo o Golem Steel Oxidado."
		""
		"Esse metal bruto deve ser limpo/derretido antes de se tornar utilizável."
	]
	quest.1800000000000010.title: "Ferrugem Estelar"
	quest.1800000000000011.quest_desc: ["Derreta o Aço Oxidado para obter o Golem Steel puro, necessário para as armas top de linha."]
	quest.1800000000000011.title: "Aço Puro do Golem"
	quest.1800000000000012.quest_desc: ["O espólio do Golem também revela a Fornalha de Liga (Alloy Furnace), uma estação de trabalho para criar misturas avançadas na dimensão."]
	quest.1800000000000012.title: "Fornalha Estelar"
	quest.1800000000000013.quest_desc: [
		"Forje uma das armas mais quebradas do mod."
		""
		"A Balestra de Cristal (Crystal Crossbow) causa dano de perfuração perpétuo por alguns segundos no inimigo que a flecha atingir!"
	]
	quest.1800000000000013.title: "Balestra de Cristal"
	quest.1800000000000014.quest_desc: [
		"O poder massivo do Golem em suas mãos."
		""
		"Esta espada colossal destrói hordas inteiras em um único golpe de varredura."
	]
	quest.1800000000000014.title: "Montante de Aço"
	quest.1800000000000015.quest_desc: [
		"O monstro mais temido da dimensão."
		""
		"A Monstruosidade Lunar (Lunar Monstrosity) causa um dano devastador e aplica a terrível infecção Estelar. Ela odeia o calor e fugirá se você usar lava contra ela. Ponha um fim neste pesadelo!"
	]
	quest.1800000000000015.title: "O Pesadelo Lunar"
	quest.1800000000000016.quest_desc: [
		"Anteriormente conhecido como Atalphaite."
		""
		"O Núcleo Estelar (Starcore) é um minério super raro de end-game, encontrado profundamente enterrado sob as paisagens e protegido pelas trevas."
	]
	quest.1800000000000016.title: "O Núcleo End-Game"
	quest.1800000000000017.quest_desc: [
		"O terror gélido."
		""
		"Vá para a Permafrost Forest. Procure nas cavernas (Y=41) por agrupamentos de cristais que parecem estalactites. Lá você encontrará a Glacite!"
	]
	quest.1800000000000017.title: "Fragmento de Glacite"
	quest.1800000000000018.quest_desc: [
		"A Armadura de Glacite congela o ar ao seu redor."
		""
		"Comece forjando o capacete de cristal absoluto."
	]
	quest.1800000000000018.title: "Capacete de Glacite"
	quest.1800000000000019.quest_desc: [
		"A rocha vulcânica do Starlight."
		""
		"A Thermal Springstone é encontrada nas profundezas mais quentes da dimensão. Esse material absorve um calor insano!"
	]
	quest.1800000000000019.title: "Pedra Termal"
	quest.180000000000001A.quest_desc: [
		"A armadura Termal é viva."
		""
		"Ao forjar a primeira peça, você sentirá o calor irradiando. Ela fornece aquecimento natural contra os perigos da dimensão."
	]
	quest.180000000000001A.title: "Capacete Termal"
	quest.180000000000001B.quest_desc: [
		"Olhe para cima!"
		""
		"De tempos em tempos, uma espetacular Chuva de Meteoros rasgará os céus da dimensão. Você também pode engatilhar esse evento atirando um Aetherstrike Rocket."
	]
	quest.180000000000001B.title: "Chuva de Meteoros"
	quest.180000000000001C.quest_desc: [
		"Eles vieram das estrelas."
		""
		"Durante a chuva de meteoros, uma aberração em forma de estrela chamada Creteor cairá dos céus. Ele explode como um Creeper! Cace-os impiedosamente."
	]
	quest.180000000000001C.title: "A Ameaça Espacial"
	quest.180000000000001D.quest_desc: [
		"Derrotar o Creteor garante a você a Creteor Hide (Pele de Creteor)."
		""
		"Esse couro espacial é a base de todas as armaduras do fim de jogo e a única coisa resistente o suficiente para aguentar o minério de meteoro."
	]
	quest.180000000000001D.title: "Pele de Creteor"
	quest.180000000000001E.quest_desc: ["Juntando a energia bruta dos meteoros com a pele resistente do Creteor, você consegue refinar o Aethersent Ingot!"]
	quest.180000000000001E.title: "O Lingote Cósmico"
	quest.180000000000001F.quest_desc: [
		"Visão Cósmica."
		""
		"O capacete de Aethersent concede propriedades de resistência celestial. O início do set mais glorioso do mod."
	]
	quest.180000000000001F.title: "Capacete de Aethersent"
	quest.1800000000000020.quest_desc: [
		"O ápice da riqueza celestial."
		""
		"Diamantes formados pela pressão colossal da própria dimensão. A ostentação máxima do mod."
	]
	quest.1800000000000020.title: "Diamante Estelar"
	quest.1800000000000021.quest_desc: [
		"O Peitoral Vulcânico."
		""
		"Cobre o seu peito com magma solidificado. O calor armazenado nesta peça é intimidador para qualquer inimigo."
	]
	quest.1800000000000021.title: "Peitoral Termal"
	quest.1800000000000022.quest_desc: ["Calças forjadas em chamas."]
	quest.1800000000000022.title: "Calça Termal"
	quest.1800000000000023.quest_desc: [
		"Botas que derretem o chão frio."
		""
		"Com o conjunto completo de Thermal Springstone, você se torna uma verdadeira fornalha ambulante."
	]
	quest.1800000000000023.title: "Botas Termais"
	quest.1800000000000024.quest_desc: [
		"Peitoral de Permafrost."
		""
		"Além da grande defesa física, este conjunto blindado possui propriedades que o tornam rígido e impenetrável."
	]
	quest.1800000000000024.title: "Peitoral de Glacite"
	quest.1800000000000025.quest_desc: ["Proteção Gélida absoluta para as pernas."]
	quest.1800000000000025.title: "Calça de Glacite"
	quest.1800000000000026.quest_desc: [
		"Caminhe seguro sobre o gelo e a escuridão."
		""
		"A propósito: o escudo da linha de Glacite possui uma mecânica única onde você não perde velocidade de movimento enquanto o mantém levantado!"
	]
	quest.1800000000000026.title: "Botas de Glacite"
	quest.1800000000000027.quest_desc: ["A durabilidade das estrelas cravada no seu peito."]
	quest.1800000000000027.title: "Peitoral de Aethersent"
	quest.1800000000000028.quest_desc: ["Fibras de meteoro unidas por pura maestria."]
	quest.1800000000000028.title: "Calça de Aethersent"
	quest.1800000000000029.quest_desc: [
		"A leveza do espaço profundo."
		""
		"Com o conjunto completo, você atingiu o topo da cadeia alimentar da dimensão. (Dica: Use esse mesmo minério para fazer as Flechas de Aethersent que perfuram múltiplos inimigos!)."
	]
	quest.1800000000000029.title: "Botas de Aethersent"
	quest.180000000000002A.quest_desc: [
		"A coroa das estrelas."
		""
		"Forjada com o material mais duro e raro da dimensão. Com este capacete, você reflete a própria luz celestial."
	]
	quest.180000000000002A.title: "Capacete Estelar"
	quest.180000000000002B.quest_desc: ["Peitoral forjado sob a pressão insana do subsolo dimensional. Resistência quase divina."]
	quest.180000000000002B.title: "Peitoral Estelar"
	quest.180000000000002C.quest_desc: ["Calças impenetráveis construídas com o diamante puro das estrelas."]
	quest.180000000000002C.title: "Calça Estelar"
	quest.180000000000002D.quest_desc: ["Caminhe com a leveza, a resistência e o brilho do cosmos. O set absoluto está completo!"]
	quest.180000000000002D.title: "Botas Estelares"
	quest.180000000000002E.quest_desc: [
		"Um inseto de beleza mortal e utilidade mágica."
		""
		"A Mariposa Cristalizada (Crystallized Moth) voa pelos ares soltando partículas brilhantes. Você pode interagir com ela pacificamente usando Gel de Cacto Lunaris (Lunaris Cactus Gel) ou caçá-la para forçar o drop de seus cristais exóticos e raros!"
	]
	quest.180000000000002E.title: "A Mariposa de Cristal"
	quest.180000000000002F.quest_desc: [
		"O poder das asas cravado na lâmina."
		""
		"Junte os fragmentos de cristal rosas e azuis dropados pela Mariposa Cristalizada para forjar uma espada incrivelmente afiada e imbuída com o poder puro da estática."
	]
	quest.180000000000002F.title: "A Espada de Cristal"
	quest.1800000000000030.quest_desc: [
		"As Aves de Fogo Estelar são criaturas majestosas."
		""
		"Se você encontrar um Ovo (Starfire Bird Egg) ou cruzar com essas aves, não as ataque! Alimente-as com Sementes. Elas voarão por um tempo e retornarão trazendo presentes inestimáveis para você, dropando-os no chão!"
	]
	quest.1800000000000030.title: "Ovo da Ave Estelar"
	quest.1800000000000031.quest_desc: [
		"O presente mais raro das Aves."
		""
		"As aves podem dropar o Fogo Estelar (Starfire), uma chama cósmica que nunca se apaga. Use-o na bancada para forjar o poderoso conjunto de armas de Starfire!"
	]
	quest.1800000000000031.title: "Fogo Estelar"
	quest.1800000000000032.quest_desc: [
		"O grande segredo da alquimia do deserto."
		""
		"Leve o seu Fogo Estelar até o bioma de Deserto Cristalizado (Crystallized Desert). Clique com o botão direito para atirar o fogo diretamente na areia! Ele transformará a areia instantaneamente em Flowglaze Bruto (Raw Flowglaze)!"
	]
	quest.1800000000000032.title: "A Magia do Flowglaze"
	quest.181A383F88BB36B5.title: "Alvo: Mummy"
	quest.18549DF0DA61C037.title: "Alvo: Zebra"
	quest.1856E36A0B9417E7.title: "Alvo: Shadow"
	quest.185DB3C92F11A75B.quest_desc: ["Escondido bem fundo no Soul Sand Valley. Uma gema tão fria que precisa de Necoium para não estilhaçar."]
	quest.185DB3C92F11A75B.title: "Cristal: Safira"
	quest.187D6E73F1F89B7E.title: "Alvo: Mummy"
	quest.18FD7C26718E9EB8.quest_desc: ["Cuidado ao pisar nos pântanos apodrecidos (Grongle e Barrens). O chão é fofo e criaturas nojentas espreitam sob a névoa. As Gloomgourds (Abóboras do submundo) crescem por aqui."]
	quest.18FD7C26718E9EB8.title: "O Pântano Podre"
	quest.1900000000000001.quest_desc: [
		"O Crepúsculo aguarda."
		""
		"Para criar o portal, faça um buraco de 2x2 na terra, encha de água e plante flores ou cogumelos em todos os blocos ao redor."
		""
		"Por fim, jogue um Diamante na água e afaste-se! Pular no portal concluirá esta missão."
	]
	quest.1900000000000001.title: "O Portal do Crepúsculo"
	quest.1900000000000002.quest_desc: [
		"O primeiro guardião."
		""
		"Encontre um pátio de pedra cercado por muros. A Naga é uma serpente gigante que destruirá os blocos ao seu redor. Mire na cabeça e derrote-a para avançar na progressão!"
	]
	quest.1900000000000002.title: "A Naga"
	quest.1900000000000003.quest_desc: [
		"A torre dos mortos."
		""
		"Ao encostar no Lich, você notará que ele tem escudos giratórios impenetráveis. Rebata as pérolas do end que ele atira de volta nele para quebrar os escudos antes de usar a espada!"
	]
	quest.1900000000000003.title: "O Lich do Crepúsculo"
	quest.1900000000000004.quest_desc: [
		"O Labirinto Subterrâneo do Pântano."
		""
		"Procure por uma colina natural e desça até a masmorra. Mate o gigante Minoshroom! DICA VITAL: Você DEVE comer a sopa (Meef Stroganoff) que ele dropa para ficar imune ao fogo do pântano e acessar a Hidra!"
	]
	quest.1900000000000004.title: "O Minoshroom"
	quest.1900000000000005.quest_desc: [
		"O monstro mais icônico do mod."
		""
		"A Hidra reflete quase todo o dano. A única forma de feri-la gravemente é atirar de volta as bolas de fogo que ela cospe ou atacá-la na boca vermelha quando ela abre para morder!"
	]
	quest.1900000000000005.title: "A Hidra"
	quest.1900000000000006.quest_desc: [
		"A Fortaleza dos Cavaleiros."
		""
		"Escondida sob a Floresta Escura. Ao achar o troféu na sala, coloque um troféu de chefe no pedestal para abrir a masmorra. Lá embaixo, enfrente a horda dos Cavaleiros Fantasmas!"
	]
	quest.1900000000000006.title: "Os Cavaleiros Fantasmas"
	quest.1900000000000007.quest_desc: [
		"No topo da Torre Negra reside o Ur-Ghast."
		""
		"Esta criatura gigante e bizarra solta lágrimas explosivas. Ative as armadilhas de Ghast na arena quando ele estiver perto para causar dano brutal!"
	]
	quest.1900000000000007.title: "O Ur-Ghast"
	quest.1900000000000008.quest_desc: [
		"O Senhor do Inverno."
		""
		"Entre na floresta congelada e ache a caverna central. O Alpha Yeti arremessará blocos de gelo maciços e chamará hordas de yetis menores."
	]
	quest.1900000000000008.title: "O Alpha Yeti"
	quest.1900000000000009.quest_desc: [
		"O Palácio da Aurora."
		""
		"Suba pelas escadarias de gelo até o topo. A Rainha da Neve (Snow Queen) voa num trenó de gelo. Ataque-a por baixo para quebrar o trenó e derrubá-la!"
	]
	quest.1900000000000009.title: "A Rainha da Neve"
	quest.190000000000000A.quest_desc: [
		"Você dominou a Hidra, o Ur-Ghast e a Rainha!"
		""
		"A maldição foi levantada. Dirija-se às Terras Altas (Highlands) e entre nas Cavernas dos Trolls. Lá, roube os Feijões Mágicos (Magic Beans) nos baús subterrâneos."
	]
	quest.190000000000000A.title: "As Cavernas dos Trolls"
	quest.190000000000000B.quest_desc: [
		"Plante o feijão no solo rico (Uberous Soil) e suba o pé de feijão gigante até as nuvens!"
		""
		"Encontre o Cloud Cottage e mate o Gigante Armadurado (Armored Giant) para progredir."
	]
	quest.190000000000000B.title: "Acima das Nuvens"
	quest.190000000000000C.quest_desc: [
		"O Gigante dropará a Picareta Gigante. Use-a nas Cavernas dos Trolls para quebrar o Obsidian Gigante e acessar o baú escondido."
		""
		"Lá estará a Lâmpada das Cinzas (Lamp of Cinders). Use-a nas Terras de Espinhos (Thornlands) para queimar os espinhos imortais até virarem cinzas e abrir o caminho!"
	]
	quest.190000000000000C.title: "As Terras de Espinhos"
	quest.190000000000000D.quest_desc: [
		"O ápice da jornada."
		""
		"Atravesse a muralha de cinzas para chegar ao Castelo Final. A estrutura imensa guarda os últimos mistérios (Aviso: O Chefe Final do Twilight Forest ainda está em desenvolvimento pelos autores do mod, mas chegar aos portões é o sinal de que você zerou a dimensão!)."
	]
	quest.190000000000000D.title: "O Castelo Final"
	quest.190000000000000E.quest_desc: [
		"Os Corvos voam pela dimensão do Crepúsculo."
		""
		"Mate-os para conseguir a Pena de Corvo, um ingrediente mágico essencial para o mapeamento da dimensão."
	]
	quest.190000000000000E.title: "Mensageiro Sombrio"
	quest.190000000000000F.quest_desc: [
		"Nunca ande às cegas."
		""
		"O Mapa Mágico revela o relevo da dimensão e estampa a cara de cada Chefão exatamente onde o covil deles está localizado!"
	]
	quest.190000000000000F.title: "O Mapa Mágico"
	quest.1900000000000010.quest_desc: [
		"As escamas da besta."
		""
		"Com elas, você pode forjar uma armadura leve que já vem encantada naturalmente da bancada de trabalho!"
	]
	quest.1900000000000010.title: "Escamas de Naga"
	quest.1900000000000011.quest_desc: ["Encontrando Raízes de Fígado (Liveroots) nas cavernas e misturando com ouro e ferro, você forja a Ironwood!"]
	quest.1900000000000011.title: "Madeira de Ferro"
	quest.1900000000000012.quest_desc: ["O Lich dropará um Cetro mágico de utilidade, que pode evocar zumbis, atirar magias ou sugar a vida dos inimigos."]
	quest.1900000000000012.title: "Magia Roubada"
	quest.1900000000000013.quest_desc: ["O Steeleaf é um material verde afiadíssimo encontrado em baús da dimensão, forjando armas com durabilidade imensa."]
	quest.1900000000000013.title: "Folha de Aço"
	quest.1900000000000014.quest_desc: ["Sem tomar essa sopa lendária, você morrerá queimado pelas maldições do Pântano de Fogo."]
	quest.1900000000000014.title: "Sopa de Centauro"
	quest.1900000000000015.quest_desc: [
		"O sangue fervente da besta."
		""
		"Pode ser misturado com Ferro na bancada para forjar o Fiery Ingot (Lingote Ardente)."
	]
	quest.1900000000000015.title: "Sangue Ardente"
	quest.1900000000000016.quest_desc: ["As armas da linha Fiery queimam os inimigos instantaneamente e a armadura incinera quem tentar te atacar corpo a corpo."]
	quest.1900000000000016.title: "Arsenal de Fogo"
	quest.1900000000000017.quest_desc: ["Restos do metal dos cavaleiros, essencial para abrir os bloqueios e forjar armaduras pesadas."]
	quest.1900000000000017.title: "Metal dos Cavaleiros"
	quest.1900000000000018.quest_desc: [
		"O minério vermelho artificial da Torre."
		""
		"Com o Carminite, você pode reconstruir os Reatores e as armadilhas exclusivas da Torre Negra na sua própria base!"
	]
	quest.1900000000000018.title: "A Energia Carminite"
	quest.1900000000000019.quest_desc: ["O Pelo Grosso do Alpha Yeti é a única coisa capaz de forjar a armadura de Yeti, que não só te protege, como encanta quem te ataca com lentidão gélida."]
	quest.1900000000000019.title: "Pelo Congelado"
	quest.190000000000001A.quest_desc: ["Ela dropa um dos arcos supremos: O Arco Triplo (dispara 3 flechas pelo preço de 1) ou o Arco Rastreador (as flechas perseguem os inimigos)!"]
	quest.190000000000001A.title: "O Arco da Aurora"
	quest.190000000000001B.quest_desc: [
		"Uma ferramenta tão massiva que chega a ser cômica."
		""
		"Ela é vital para quebrar blocos absurdamente grandes ou liberar passagens colossais."
	]
	quest.190000000000001B.title: "Picareta do Gigante"
	quest.190B6A9BD80E616E.quest_desc: [
		"A resistência cristalina perfeita. A lona de diamante é extremamente difícil de rasgar."
		""
		"Com o Planador de Diamante, você pode atravessar biomas inteiros a partir de uma montanha alta sem se preocupar em quebrar o equipamento no meio da jornada."
	]
	quest.190B6A9BD80E616E.title: "Asas Inquebráveis"
	quest.190C46CD6F316CF9.title: "Alvo: Mushlin Bumper"
	quest.1923536DCBE81597.title: "Alvo: Swamp Skeleton"
	quest.19339BE5B5BC91CB.title: "Alvo: Desert Zombie"
	quest.1941E4BCF46CFC12.title: "Khopesh de Diamante"
	quest.199E45D75A2954E0.title: "Grão-Martelo de Ouro"
	quest.19D86702E62670CE.title: "Alvo: Witchdoctor"
	quest.19F3AE7F33C802A8.title: "Alvo: Mummy"
	quest.1A0FDDC7F74AB200.title: "Alvo: Librarian Skeleton"
	quest.1A16A91C85B28ABC.title: "Grande Lança de Diamante"
	quest.1A22492620E4FB69.title: "Alvo: Mushlin Bumper"
	quest.1A2614EE587AC66F.title: "Lança de Cavalaria (Ouro)"
	quest.1A3855C5CC70FB62.title: "Alvo: Phoenix"
	quest.1A7285CC88E6B915.quest_desc: ["A infraestrutura pesada da TVA. O §6Time Door Projector§r usa Redstone para gerar uma fenda do tempo fixa com o Location Card inserido."]
	quest.1A7285CC88E6B915.title: "Projetor de Porta do Tempo"
	quest.1ABEF7970676DB99.title: "Alvo: Yeti"
	quest.1ACFB9936648FF06.title: "Alvo: Piglin Ghost"
	quest.1AFD1A9898021215.title: "Adaga de Diamante"
	quest.1AFF7CFA3C1C9596.title: "Alvo: Bone Stalker"
	quest.1B00C90BABE416FD.title: "Alvo: Piglin Executioner"
	quest.1B26BE2748EA784A.title: "Alvo: Red Mummy"
	quest.1B6B4FD647D47869.title: "Alvo: Swamp Skeleton"
	quest.1B7F70A9CEEA1322.title: "Alvo: Vile Gator"
	quest.1B86FADD079A8A39.quest_desc: ["Extrai o Peridoto sob florestas e cavernas verdejantes (Lush Caves). Funde-o com Necoium!"]
	quest.1B86FADD079A8A39.title: "Cristal: Peridoto"
	quest.1B88373F8C6838EC.title: "Alvo: Desert Skeleton"
	quest.1B96869908F56E32.quest_desc: ["O terror dos construtores. Mantenha distância e acerte antes que detonem!"]
	quest.1B96869908F56E32.title: "O Silêncio Explosivo"
	quest.1BA5FD659F6BB382.title: "Alvo: Golden Hermit King"
	quest.1BADC18D3BBF3AC9.title: "Alvo: Swamp Zombie"
	quest.1BD59A5405206F6D.title: "Alvo: Glider"
	quest.1C05976BDD3FF5DA.title: "Chifres de Cervo (Diamante)"
	quest.1C22328F98777A4C.quest_desc: ["Variante de Ouro. Rápida mas frágil."]
	quest.1C22328F98777A4C.title: "Lança de Ouro"
	quest.1C41FE7D711A83E9.title: "Alvo: Magic Zombie"
	quest.1C4C0DE7D0BC423C.title: "Alvo: Witchdoctor"
	quest.1C513D8329D8640E.title: "Alvo: Statue Mimic"
	quest.1C6F84B1C5740185.quest_desc: [
		"Procure pelas estruturas de pedras antigas cobertas de musgo chamadas Forgotten Ruins (Ruínas Esquecidas)."
		""
		"Muitos mistérios e loots especiais do mod se escondem nestes corredores de tijolos seculares."
	]
	quest.1C6F84B1C5740185.title: "Civilização Perdida"
	quest.1CC82BBB0466FE85.title: "Alvo: Swamp Skeleton"
	quest.1CE867B3711DBEE4.title: "Alvo: Golden Hermit King"
	quest.1D03B20763A2E899.quest_desc: ["O Lixeiro. Transforme blocos inúteis (como 256.000 cobblestones) em energia esmagadora."]
	quest.1D03B20763A2E899.title: "Condensador de Matéria"
	quest.1D03EB85993C3B0F.title: "Lança de Cavalaria (Ouro)"
	quest.1D472E5A13193C99.title: "Alvo: Woodland Witchdoctor"
	quest.1D5A76A15F43C98D.quest_desc: ["O cristal supremo gerado nas ilhas flutuantes externas do Vazio."]
	quest.1D5A76A15F43C98D.title: "Cristal: Ametrina"
	quest.1DE82FFD842FC856.title: "Alvo: Yeti"
	quest.1E05DCC879909215.quest_desc: [
		"As viagens não são de graça. O §aMetronome§r é a sua primeira máquina de energia."
		""
		"Alimente-o para que ele comece a gerar §aChronons§r, o combustível de tudo o que fará a seguir."
	]
	quest.1E05DCC879909215.title: "Gerador de Chronons"
	quest.1E138FD422EDC945.quest_desc: ["Cabos expostos são feios. O Framed Cable permite que você aplique a textura de QUALQUER bloco do jogo nele, escondendo-o na parede!"]
	quest.1E138FD422EDC945.title: "Cabo Camuflado (Framed)"
	quest.1E2726637377C2A1.title: "Alvo: Bone Stalker"
	quest.1E35F0D12E825D7B.quest_desc: ["Extraído do fundo dos oceanos e cavernas submersas."]
	quest.1E35F0D12E825D7B.title: "Cristal: Água-Marinha"
	quest.1E44C867A8A911D2.title: "Alvo: Magic Zombie"
	quest.1E47DFBD55D1F302.title: "Adaga Oculta de Ouro"
	quest.1E794F715F26F7E0.quest_desc: [
		"O Capelobo não aparece caminhando de dia. Ele precisa ser atraído."
		""
		"Consiga Sangue de Cachorro. Ele pode ser encontrado em baús das estruturas do mod ou trocado com o Villager Clérigo."
	]
	quest.1E794F715F26F7E0.title: "Isca de Sangue"
	quest.1E9E18E1599E44E3.quest_desc: [
		"Combata fogo com fogo!"
		""
		"A Soakstone age exatamente como uma esponja molhada, mas foi criada especificamente para sugar enormes quantidades de LAVA ao seu redor."
	]
	quest.1E9E18E1599E44E3.title: "A Esponja de Lava"
	quest.1EB423E31E8D629F.title: "Grandsword de Diamante"
	quest.1EE7A2466AEC4210.title: "Alvo: Witchdoctor"
	quest.1F0BA11BEF4D0ABA.title: "Alvo: Witchdoctor"
	quest.1F27C653BCE63EFD.quest_desc: ["Elas escalam paredes e atacam no escuro. Cuidado com o veneno das variantes menores."]
	quest.1F27C653BCE63EFD.title: "Tecendo a Morte"
	quest.1F42E91F60A13990.quest_desc: ["Bem-vindo ao Nether. Cace este molde nos bastiões."]
	quest.1F42E91F60A13990.title: "Molde: Rubi"
	quest.1F5636156B61EB94.title: "Alvo: Desert Zombie"
	quest.1F57513374B562D7.title: "Alvo: Bone Stalker"
	quest.1F5A9EB9571E1096.title: "Alvo: Piglin Ghost"
	quest.1F8E03612B3DA982.quest_desc: ["O Molde do vazio gélido do Nether."]
	quest.1F8E03612B3DA982.title: "Molde: Safira"
	quest.1F91E93360BA37DE.quest_desc: ["Minera no fundo dos oceanos profundos e funde com o teu Necoium."]
	quest.1F91E93360BA37DE.title: "Cristal: Água-Marinha"
	quest.1FB79F80FFEC5623.title: "Alvo: Piglin Cultist Leader"
	quest.2001B030682F032B.title: "Dimensão do Abyss"
	quest.2029FB6A76DD2166.title: "Alvo: Scarecrow"
	quest.2078A4562C6E8451.title: "Alvo: Glider"
	quest.20AE9130A6E7F507.quest_desc: ["A Dagger ataca incrivelmente rápido, perfeita para acertar monstros frágeis, mas cuidado: o seu alcance é muito menor que o de uma espada normal."]
	quest.20AE9130A6E7F507.title: "A Adaga"
	quest.20BEACA699CCC9A3.title: "Alvo: Swamp Zombie"
	quest.20D31DDD62635DED.quest_desc: ["Você pediu a lista completa, caçador. Aqui estão as 54 ameaças isoladas da Série Luminous. Elas foram separadas em 4 colunas. Todas estão liberadas: cace-os na ordem que os encontrar pelo mundo!"]
	quest.20D31DDD62635DED.title: "O Fichário Completo"
	quest.20DE2A1B67407F55.quest_desc: [
		"O ferro normal derrete nas fendas do tempo. Forje o §7Time Steel§r (Aço Temporal)."
		""
		"Esta liga é a fundação para o Tempad, Upgrades e Portais Fixos."
	]
	quest.20DE2A1B67407F55.title: "Aço Temporal"
	quest.2100000000000001.quest_desc: [
		"Oculto nas profundezas escuras."
		""
		"O Ovo Sombrio (Dark Egg) é encontrado exclusivamente nos baús das Ancient Cities (Cidades Ancestrais). Apesar de ter uma chance razoável (24%), evite acordar o Warden!"
	]
	quest.2100000000000001.title: "Ovo Sombrio"
	quest.2100000000000002.quest_desc: [
		"Guardado pelo ouro e pelos Piglins."
		""
		"O Ovo Dourado (Gilded Egg) só aparece nas Bastions (Bastiões). Foque nas Bastions do tipo Ponte (Bridge) ou Tesouro, pois outras partes da estrutura não geram este ovo!"
	]
	quest.2100000000000002.title: "Ovo Dourado"
	quest.2100000000000003.quest_desc: [
		"A lenda vermelha do Nether."
		""
		"O Red Egg tem a chance de aparecer nos baús das Fortalezas do Nether. Como a geração de baús nas Fortalezas é muito aleatória, você pode ter que explorar mais de uma para achar."
	]
	quest.2100000000000003.title: "Ovo Escarlate"
	quest.2100000000000004.quest_desc: [
		"Perdido nos abismos de pedra."
		""
		"O Wind Egg é achado com bastante frequência (32% de chance) nos baús dos Mineshafts (Minas Abandonadas). Leve uma Poção de Visão Noturna e explore os carrinhos!"
	]
	quest.2100000000000004.title: "Ovo do Vento"
	quest.2100000000000005.quest_desc: [
		"O mais raro, difícil e punitivo de todos."
		""
		"O Nature Egg se esconde nos Templos da Selva (Jungle Temples). O problema? Esses templos são raros e só possuem 2 baús! A chance de sair frustrado é imensa. Boa sorte!"
	]
	quest.2100000000000005.title: "Ovo da Natureza"
	quest.2100000000000006.quest_desc: [
		"Espalhado pela superfície."
		""
		"O Fire Egg pode ser saqueado em Mansões Assombradas (Woodland Mansions) ou nos Postos Avançados de Saqueadores (Pillager Outposts)."
	]
	quest.2100000000000006.title: "Ovo de Fogo"
	quest.2100000000000007.quest_desc: [
		"Com o ovo petrificado em mãos, você precisa aquecê-lo."
		""
		"Crafte o Inferno Cradle (Berço Infernal) usando Ferro e Pó de Blaze. Coloque-o no chão, insira o seu ovo e espere pacientemente por exatos 15 minutos (quase um ciclo inteiro de dia/noite)!"
	]
	quest.2100000000000007.title: "O Berço Infernal"
	quest.2100000000000008.quest_desc: [
		"Para abrigar a Fênix que nascerá, você precisa de um recipiente ultra-resistente."
		""
		"Forje a Lanterna Temperada (Tempered Lantern) usando Pó de Blaze, uma Lâmpada de Redstone e Ferro."
	]
	quest.2100000000000008.title: "Lanterna Temperada"
	quest.2100000000000009.quest_desc: ["Após os 15 minutos de espera no Berço Infernal, o ovo estará brilhante, quente e totalmente chocado (Warmed Egg)!"]
	quest.2100000000000009.title: "O Despertar"
	quest.210000000000000A.quest_desc: [
		"O selo definitivo."
		""
		"Combine o Ovo Aquecido com a Lanterna Temperada vazia na sua bancada (Crafting Table) ou inventário. Parabéns! Você agora possui uma Lanterna de Fênix."
		""
		"Basta usá-la como um item normal para invocar a sua montaria. Ela viaja a impressionantes 15 blocos por segundo e tem um cooldown de 30 segundos se for guardada de volta."
	]
	quest.210000000000000A.title: "O Vínculo Alado"
	quest.210000000000000B.quest_desc: [
		"A sua Fênix possui absurdos 60 corações de vida (6 fileiras na tela)."
		""
		"Atenção: Diferente de outros pets, você NÃO pode curá-la dando comida. Para restaurar a vida da Fênix, você deve arremessar Poções de Cura Arremessáveis (Splash Potion of Healing) nela, de preferência perto do chão para a poção não vazar."
	]
	quest.210000000000000B.title: "A Cura pelo Frasco"
	quest.210000000000000C.quest_desc: [
		"Domine os céus na ofensiva."
		""
		"A Fênix é excelente em combate não apenas pela mobilidade. O corpo massivo dela funciona como um escudo (body block) bloqueando projéteis de inimigos terrestres (como tiros de Shulkers e Esqueletos)."
		""
		"Equipe uma Besta (Crossbow) e atire do alto sem ser atingido!"
	]
	quest.210000000000000C.title: "Artilharia Voadora"
	quest.210000000000000D.quest_desc: [
		"A Lanterna perde durabilidade a cada vez que a Fênix é evocada ou guardada."
		""
		"Dica de Ouro: Você pode encantar a sua Lanterna de Fênix na bigorna com Inquebrável III (Unbreaking) e Remendo (Mending) para que ela nunca quebre!"
	]
	quest.210000000000000D.title: "A Preservação do Fogo"
	quest.210C99D4C5F63285.quest_desc: ["O poder da nuvem nas suas mãos. Acesse sua fábrica do Create e todos os milhões de itens do MegaCells a quilômetros de distância."]
	quest.210C99D4C5F63285.title: "Terminal Portátil"
	quest.2163D62E3DA9CE9E.title: "Alvo: Woodland Witchdoctor"
	quest.217EC92FB91681A5.title: "Exploração"
	quest.2195700F33C626B4.title: "Alvo: Orca"
	quest.219D5E9A899A6CFC.quest_desc: ["Na última câmara das Catacumbas aguarda o Forgotten Guardian, um pilar massivo de pedra arcaica armado com magias mortais e resistência colossal! Suas armas de Utherium farão a diferença aqui. Mate-o para obter o Ingot Perdido (Forgotten Ingot)!"]
	quest.219D5E9A899A6CFC.title: "Chefe: Forgotten Guardian"
	quest.21B423C21CCC6D6E.title: "Alvo: Golden Hermit King"
	quest.21CFEEED5154F776.title: "Alvo: Snow Skeleton"
	quest.2200000000000001.quest_desc: [
		"Bem-vindo ao Bosses' Rise!"
		""
		"Aqui, o combate corpo-a-corpo evolui. O item mais importante do início é o Ancient Iron Ingot. Você o consegue juntando Nuggets encontrados nos barris das torres dos chefes!"
	]
	quest.2200000000000001.title: "O Ferro Ancestral"
	quest.2200000000000002.quest_desc: [
		"A mecânica de ouro: O Combat Roll!"
		""
		"Ao apertar a tecla de esquiva (geralmente Z), você rola para fugir de ataques. O Enhanced Shield é essencial, pois ele aumenta a Recuperação de Movimento (Movement Recovery), permitindo que você desvie com mais frequência!"
	]
	quest.2200000000000002.title: "Domine a Esquiva"
	quest.2200000000000003.quest_desc: [
		"O Arsenal de Ferro Ancestral."
		""
		"Você pode forjar uma Dagger (rápida, mas com baixo alcance) ou juntar com Ouro para fazer a Large Sword (Lenta, mas com muito alcance e brutais 12 de dano)!"
	]
	quest.2200000000000003.title: "Lâmina Pesada"
	quest.2200000000000004.quest_desc: [
		"A Armadura dos Cavaleiros pode ser achada nas torres do dragão."
		""
		"O grande diferencial do Knight's Armor é que o set inteiro te concede mais Recuperação de Movimento para a sua esquiva (Combat Roll)!"
	]
	quest.2200000000000004.title: "A Armadura do Cavaleiro"
	quest.2200000000000005.quest_desc: [
		"As imensas torres de pedra."
		""
		"A subida é infestada por Dragon Guards e Flaming Skeletons (que deixam o chão pegando fogo como blocos de magma). Uma Poção de Resistência ao Fogo é OBRIGATÓRIA!"
	]
	quest.2200000000000005.title: "A Torre de Fogo"
	quest.2200000000000006.quest_desc: [
		"No topo da torre, a verdadeira batalha começa."
		""
		"O Infernal Dragon lança um sopro contínuo, bate no chão e usa a cauda (Tail Whip) para te arremessar longe ou pelos ares. Na Fase 2, ele vira um esqueleto gigante! Cuidado para não cair!"
	]
	quest.2200000000000006.title: "O Dragão Infernal"
	quest.2200000000000007.quest_desc: [
		"O troféu do matador de dragões."
		""
		"Pode ser vestido! Concede 3 pontos de armadura (equivalente a Netherite), Recuperação de Movimento e Estabilidade contra Queimaduras."
	]
	quest.2200000000000007.title: "Crânio de Dragão"
	quest.2200000000000008.quest_desc: ["Com os Ossos de Dragão, forje o Dragon Guard Shield (mais lento, porém com muita defesa) e a Armadura de Dragão para ganhar resistência passiva ao fogo!"]
	quest.2200000000000008.title: "Ossos e Armadura Escamada"
	quest.2200000000000009.quest_desc: [
		"Explore as tundras congeladas."
		""
		"Procure pelas imensas torres de Gelo Azul. Quando você ouvir o aviso de 'Presença Perigosa', prepare a sua espada e traga baldes de lava!"
	]
	quest.2200000000000009.title: "O Cume Glacial"
	quest.220000000000000A.quest_desc: [
		"A encarnação do inverno."
		""
		"O Yeti solta pedras de gelo, congela com o soco e bate violentamente no chão. Dica de ouro: Ele é muito fraco contra a Lava! Jogue baldes no pé dele para derreter sua vida."
	]
	quest.220000000000000A.title: "O Yeti"
	quest.220000000000000B.quest_desc: [
		"O prêmio pela vitória no frio."
		""
		"O Frozen Fist (Punho Congelado) pode ser usado como escudo para bloquear golpes e, ao bater nos inimigos, aplica o efeito de congelamento, deixando-os incrivelmente lentos!"
	]
	quest.220000000000000B.title: "O Punho Gélido"
	quest.220000000000000C.quest_desc: [
		"Viaje pelos grandes desertos e praias."
		""
		"Procure por estruturas de Sandstone (Ninho do Verme). A qualquer momento, o chão de areia vai ceder!"
	]
	quest.220000000000000C.title: "O Terror das Areias"
	quest.220000000000000D.quest_desc: [
		"O predador venenoso das dunas."
		""
		"O Sandworm mergulha na terra e salta para te engolir! Mantenha o escudo erguido quando ele for para baixo da terra. Leve baldes de leite, pois os tiros dele aplicam venenos fortes!"
	]
	quest.220000000000000D.title: "O Verme de Areia"
	quest.220000000000000E.quest_desc: [
		"A glândula venenosa da besta."
		""
		"O Desert Sandworm Dart atira dardos venenosos. Sua maior utilidade: Se você estiver envenenado, clicar com o botão direito fará o dardo CONSUMIR o veneno de você mesmo para se recarregar!"
	]
	quest.220000000000000E.title: "Dardo de Verme"
	quest.220000000000000F.quest_desc: [
		"Desça ao Nether."
		""
		"Procure pelos corredores gigantes de tijolos do Nether. Esta Arena é guardada dezenas de Soul Skeletons e Wither Knights mortais. Mate os guardas antes de focar na arena central!"
	]
	quest.220000000000000F.title: "A Arena do Inframundo"
	quest.2200000000000010.quest_desc: [
		"A verdadeira dança das espadas."
		""
		"O Underworld Knight tem 150 de vida e combos terríveis. Desvie! Após desferir sua sequência de ataques, ele ficará cansado e vulnerável (de joelhos). Essa é a sua única chance de atacá-lo!"
	]
	quest.2200000000000010.title: "O Cavaleiro do Submundo"
	quest.2200000000000011.quest_desc: [
		"A recompensa pelo domínio do combate."
		""
		"A Night Sword (Espada da Noite) possui assustadores 14 de dano base. Com o botão direito, você dispara a 'Powerful Slash', um corte mágico que rasga o ar e acerta múltiplos inimigos ao mesmo tempo!"
	]
	quest.2200000000000011.title: "A Espada da Noite"
	quest.2200000000000012.quest_desc: ["Derrote a guarda de elite da estrutura para limpar o caminho até a arena principal."]
	quest.2200000000000012.title: "Guardiões da Alma"
	quest.2200000000000013.quest_desc: [
		"Aproxime-se do centro da arena."
		""
		"O Cavaleiro do Submundo (Underworld Knight) possui impressionantes 150 pontos de vida, porta duas espadas e realiza investidas violentas e cortes mágicos de alma. A sua esquiva (Roll) será a diferença entre a vida e a morte aqui!"
	]
	quest.2200000000000013.title: "O Cavaleiro do Submundo"
	quest.2200000000000014.quest_desc: [
		"O triunfo sobre o mestre espadachim."
		""
		"A Espada do Cavaleiro (Knight Sword) possui um dano avassalador de 14. Além disso, ao focar a mira em um oponente distante e clicar com o botão esquerdo, ela dispara um corte mágico rasgando o ar e danificando hordas inteiras!"
	]
	quest.2200000000000014.title: "A Espada do Cavaleiro"
	quest.220000000000001A.quest_desc: ["O artefato místico necessário para despertar os horrores adormecidos do mundo da superfície."]
	quest.220000000000001A.title: "Chave do Desafio Ancestral"
	quest.220000000000001B.quest_desc: [
		"O artefato que ressoa com a energia ardente do Nether."
		""
		"É necessário para desafiar os mestres que residem nas chamas e na areia de almas."
	]
	quest.220000000000001B.title: "Chave do Desafio do Submundo"
	quest.220000000000001C.quest_desc: ["Com os ossos coletados da fera flamejante, inicie a forja de um conjunto lendário."]
	quest.220000000000001C.title: "Capacete de Ossos"
	quest.220000000000001D.title: "Peitoral de Ossos"
	quest.220000000000001E.title: "Calça de Ossos"
	quest.220000000000001F.title: "Botas de Ossos"
	quest.222BE6355FA0B583.quest_desc: ["O Open Crate é simples: tudo que a rede (ou o funil) mandar para ele será 'jogado' no chão como um item solto no mundo. Ótimo para jogar itens em esteiras do Create!"]
	quest.222BE6355FA0B583.title: "A Caixa Aberta (Dropper)"
	quest.222FFDB85FADA14D.title: "A MEGA Célula (4M)"
	quest.223766ED85839B60.title: "Pernach de Diamante"
	quest.226C756A61E49035.quest_desc: ["Variante de Ouro. Rápida mas frágil."]
	quest.226C756A61E49035.title: "Claymore de Ouro"
	quest.22C68E2B4029ABE1.quest_desc: [
		"Explore as tundras congeladas."
		""
		"Procure por um grande Espinho de Gelo cercado por ossos. Ao se aproximar, um aviso de 'Presença Perigosa' aparecerá."
	]
	quest.22C68E2B4029ABE1.title: "A Ameaça Glacial"
	quest.22C868E0A1C7716B.title: "Alvo: Piglin Ghost"
	quest.22E36162E779DC0B.title: "Alvo: Red Mummy"
	quest.22FC1BC4CE6DA2C9.quest_desc: ["Variante de Ouro. Rápida mas frágil."]
	quest.22FC1BC4CE6DA2C9.title: "Grande Machado de Ouro"
	quest.2300000000000001.quest_desc: [
		"O mundo foi tomado por titãs."
		""
		"O Bosses' Rise introduz batalhas no estilo RPG de ação. O combate não foca em esmagar o botão de ataque, mas em esquivar, defender e punir os chefes no momento certo!"
	]
	quest.2300000000000001.title: "A Ascensão dos Chefes"
	quest.2300000000000002.quest_desc: [
		"A mecânica de ouro: O Combat Roll!"
		""
		"Ao usar a tecla de rolamento (geralmente Z), você desvia de golpes fatais. O Enhanced Shield e a Night Armor são essenciais, pois aumentam a sua Recuperação de Movimento (Movement Recovery), permitindo rolar com mais frequência!"
	]
	quest.2300000000000002.title: "Domine a Esquiva"
	quest.2300000000000003.quest_desc: ["A Armadura da Noite (Night Armor) é tão resistente quanto o ferro e vital para a sua progressão, pois o set concede bônus massivos de Recuperação de Movimento para você rolar mais rápido!"]
	quest.2300000000000003.title: "Peitoral da Noite"
	quest.2300000000000004.quest_desc: [
		"Lenta, porém devastadora."
		""
		"A Large Sword causa impressionantes 12 de dano e possui Alcance de Entidade (Entity Reach) expandido. Você pode atingir os chefes de uma distância mais segura!"
	]
	quest.2300000000000004.title: "A Espada Colossal"
	quest.2300000000000005.quest_desc: ["A Dagger ataca incrivelmente rápido, sendo perfeita para acertar monstros frágeis, mas cuidado: seu alcance é muito menor que o de uma espada normal."]
	quest.2300000000000005.title: "A Adaga"
	quest.2300000000000006.quest_desc: ["Uma lâmina balanceada, confiável e muito estilosa para os confrontos de mid-game."]
	quest.2300000000000006.title: "A Espada do Guerreiro"
	quest.2300000000000007.quest_desc: [
		"Explore as tundras congeladas."
		""
		"Procure por um grande Espinho de Gelo cercado por ossos. Ao se aproximar, um aviso de 'Presença Perigosa' aparecerá. Pise nas partículas de neve no chão para invocar o chefe!"
	]
	quest.2300000000000007.title: "A Ameaça Glacial"
	quest.2300000000000008.quest_desc: [
		"A encarnação do inverno!"
		""
		"O Yeti congela com seus golpes e dá saltos esmagadores. Ao chegar na metade da vida, ele inicia a Fase 2 e arremessa blocos de gelo velozes! Use lava a seu favor para derreter a vida da fera."
	]
	quest.2300000000000008.title: "O Yeti"
	quest.2300000000000009.quest_desc: [
		"Uma arma peculiar e incrivelmente útil."
		""
		"O Frozen Fist atira rajadas de ar frio, congela os inimigos aplicando lentidão brutal e ainda pode ser usado como um Escudo Defensivo ao segurar o botão direito!"
	]
	quest.2300000000000009.title: "Punho Gélido"
	quest.230000000000000A.quest_desc: [
		"Nos grandes desertos, procure por ruínas de arenito e vasos quebrados."
		""
		"O mesmo aviso de perigo surgirá. Encontre as partículas de areia rodopiantes no chão e pise nelas para acordar o monstro!"
	]
	quest.230000000000000A.title: "O Despertar da Areia"
	quest.230000000000000B.quest_desc: [
		"O Verme de Areia mergulha no chão e salta agressivamente para te engolir, além de cuspir poças de ácido letal na areia."
		""
		"Esquive-se exatamente no momento em que ele for saltar do chão!"
	]
	quest.230000000000000B.title: "O Verme de Areia"
	quest.230000000000000C.quest_desc: [
		"Esta arma viva atira dardos venenosos nos oponentes."
		""
		"O grande segredo do dardo: Se VOCÊ estiver envenenado durante qualquer batalha do jogo, clicar com o botão direito fará a arma 'sugar' o veneno de você para se recarregar, curando o seu status!"
	]
	quest.230000000000000C.title: "O Dardo do Verme"
	quest.230000000000000D.quest_desc: [
		"Procure por torres gigantes no Overworld."
		""
		"A subida é infestada por Dragon Guards e Flaming Skeletons (que deixam poças de fogo no chão). Uma Poção de Resistência ao Fogo é vital aqui!"
	]
	quest.230000000000000D.title: "A Torre Flamejante"
	quest.230000000000000E.quest_desc: [
		"No topo da torre, o pesadelo começa."
		""
		"O Infernal Dragon lança sopros contínuos de fogo, morde e usa a cauda para te arremessar. Com 1/3 de vida, ele troca de pele, fica mais rápido e começa a quebrar o chão sob os seus pés!"
	]
	quest.230000000000000E.title: "O Dragão Infernal"
	quest.230000000000000F.quest_desc: [
		"O troféu do matador de dragões."
		""
		"O Crânio serve como um capacete excelente que reduz o tempo de queimadura e melhora sua esquiva! Ele também dropa os Ossos de Dragão."
	]
	quest.230000000000000F.title: "O Crânio Escamado"
	quest.2300000000000010.quest_desc: [
		"Com os Ossos de Dragão, você forja o resto do conjunto."
		""
		"A Dragon Bone Armor te dá uma gigantesca resistência passiva a queimaduras, enquanto o Dragon Guard Shield reduz a sua velocidade, mas bloqueia quase tudo."
	]
	quest.2300000000000010.title: "Armadura de Dragão"
	quest.2300000000000011.quest_desc: [
		"Desça ao Nether e encontre a imensa Arena do Submundo."
		""
		"O local é vigiado por Soul Skeletons velozes e pelos terríveis Wither Knights, que aplicam o efeito de Wither nos seus golpes. Limpe o pátio!"
	]
	quest.2300000000000011.title: "O Coliseu Flamejante"
	quest.2300000000000012.quest_desc: [
		"A verdadeira dança das espadas."
		""
		"O Underworld Knight faz combos rápidos e investidas letais. Dica de Mestre: Acerte-o com um arco ou espada no momento certo; com alguns acertos ele ficará atordoado (de joelhos). Essa é a sua única chance de puni-lo!"
	]
	quest.2300000000000012.title: "O Cavaleiro do Submundo"
	quest.2300000000000013.quest_desc: [
		"A recompensa pelo domínio do combate."
		""
		"A Night Sword (Espada da Noite) possui assustadores 14 de dano base. Ao focar em um alvo distante e atacar, ela dispara um corte mágico ('Powerful Slash') que rasga o ar e acerta múltiplos inimigos!"
	]
	quest.2300000000000013.title: "A Espada da Noite"
	quest.2300000000000014.quest_desc: ["Peitoral forjado a partir dos ossos do Dragão Infernal."]
	quest.2300000000000014.title: "Peitoral de Dragão"
	quest.2300000000000015.quest_desc: ["Calças draconianas que completam o conjunto superior."]
	quest.2300000000000015.title: "Calça de Dragão"
	quest.2300000000000016.quest_desc: ["Botas escamadas. Com o set completo vestido, você garante uma defesa brutal e estabilidade ímpar contra queimaduras!"]
	quest.2300000000000016.title: "Botas de Dragão"
	quest.2300000000000017.quest_desc: [
		"A chave para os desafios da superfície."
		""
		"A Ancient Trial Key é estritamente necessária para invocar os grandes chefões do Overworld. Sem ela, os altares permanecerão adormecidos!"
	]
	quest.2300000000000017.title: "Chave do Desafio Ancestral"
	quest.2300000000000018.quest_desc: [
		"A chave para o abismo."
		""
		"A Underworld Trial Key é usada exclusivamente para invocar o Cavaleiro do Submundo no centro da arena."
		""
		"Você deve caçá-la patrulhando os corredores da Dungeon! Ela tem chance de ser dropada ao derrotar os Wither Knights, os rápidos Soul Skeletons e os temíveis Ashlord Guards."
	]
	quest.2300000000000018.title: "Chave do Desafio do Submundo"
	quest.2300000000000020.quest_desc: [
		"As ruínas cravadas na pedra."
		""
		"Explore as montanhas rochosas e procure pela arena circular. Prepare o seu equipamento e use a Chave Ancestral para despertar o colosso adormecido!"
	]
	quest.2300000000000020.title: "O Altar de Pedra"
	quest.2300000000000021.quest_desc: [
		"O grande mestre símio."
		""
		"Tongbi The Sculptor empunha um pilar gigante que usa para desferir golpes em área devastadores e saltos esmagadores. A sua janela de ataque é curta: role no momento em que o pilar bater no chão e puna-o!"
	]
	quest.2300000000000021.title: "Tongbi, O Escultor"
	quest.2300000000000022.quest_desc: [
		"A arma que moldou as montanhas."
		""
		"O Pilar do Escultor é uma arma massiva e imponente, capaz de varrer múltiplos inimigos de uma vez com o seu peso e alcance titânicos."
	]
	quest.2300000000000022.title: "O Pilar do Escultor"
	quest.2307C45ABB43E2B3.title: "Dominador do Abyss"
	quest.2318FBDAA48F93F8.title: "Alvo: Orca"
	quest.2344189FB32AB5BB.quest_desc: [
		"A mecânica de ouro: O Combat Roll!"
		""
		"Ao usar a tecla de rolamento (geralmente Z), você desvia de golpes fatais. O Enhanced Shield e a Night Armor são essenciais, pois aumentam a sua Recuperação de Movimento (Movement Recovery), permitindo rolar com mais frequência!"
	]
	quest.2344189FB32AB5BB.title: "Domine a Esquiva"
	quest.23601D70F9AE8178.title: "Alvo: Butterfly"
	quest.2384819DC52700DE.quest_desc: ["O Molde do vazio gélido do Nether."]
	quest.2384819DC52700DE.title: "Molde: Safira"
	quest.239F64ABAF2E7802.quest_desc: ["Clique Shift + Botão Direito no seu Crafting Terminal com este aparelho para vinculá-lo. Agora você acessa seus baús de longe!"]
	quest.239F64ABAF2E7802.title: "A Nuvem (Wi-Fi)"
	quest.23A58651583CA832.title: "Alvo: Piglin Executioner"
	quest.23ABC357552057C6.title: "Alvo: Basalt Executioner"
	quest.23D0D6C5A8889474.quest_desc: [
		"A segunda bioma fantástica são as Pink Salt Caves (Cavernas de Sal Rosa)."
		""
		"Um ambiente arenoso e salgado de cor rosa choque, perfeito para blocos de construção exóticos."
	]
	quest.23D0D6C5A8889474.title: "Mina de Sal"
	quest.23E3FEECF515ADF2.quest_desc: ["O Advanced Wireless Terminal é o ápice do mod. Ele quebra as leis da física: tem alcance infinito e funciona em QUALQUER dimensão! Esteja no The End ou no Nether, seus baús estarão com você."]
	quest.23E3FEECF515ADF2.title: "Conexão Interdimensional"
	quest.23F4B5E0121671D9.quest_desc: ["O Create: Ratatouille eleva o nível. Crie uma linha de montagem perfeita com esteiras que levam os vegetais para serem fatiados por serras e depois despejados nos funis inteligentes. A fábrica de enlatados e marmitas está viva!"]
	quest.23F4B5E0121671D9.title: "Automatizando o Ratatouille"
	quest.2400000000000001.quest_desc: [
		"O mundo agora abriga criaturas com inteligência e poderes sem precedentes."
		""
		"Cada fera do Mowzie's Mobs exige estratégia. Você não pode simplesmente atacar cegamente; precisará explorar suas fraquezas, desviar e usar o terreno a seu favor!"
	]
	quest.2400000000000001.title: "O Códice de Mowzie"
	quest.2400000000000002.quest_desc: [
		"A câmara esquecida no subsolo."
		""
		"O Ferrous Wroughtnaut é um cavaleiro gigante imune a todos os ataques frontais. Provoque-o até ele realizar o ataque de esmagamento vertical. Quando o machado dele ficar preso no chão, corra para as costas dele e ataque o ponto fraco exposto!"
	]
	quest.2400000000000002.title: "O Cavaleiro de Ferro"
	quest.2400000000000003.quest_desc: [
		"O Machado de Mil Metais (Axe of a Thousand Metals)."
		""
		"Uma arma indestrutível. Ao segurar o botão direito, você golpeia o chão causando uma onda de choque sísmica ao seu redor!"
	]
	quest.2400000000000003.title: "O Machado Terremoto"
	quest.2400000000000004.quest_desc: [
		"O elmo do colosso."
		""
		"Garante blindagem extrema e nega totalmente qualquer tipo de knockback (repulsão) enquanto vestido!"
	]
	quest.2400000000000004.title: "Capacete de Ferro Fundido"
	quest.2400000000000005.quest_desc: [
		"A tribo solar na Savana."
		""
		"Barako repousa em seu trono no centro da vila. Ele lança raios solares orbitais, lasers concentrados e convoca infinitos Barakoas para defende-lo. Mantenha-se em movimento constante!"
	]
	quest.2400000000000005.title: "Barako, o Chefe do Sol"
	quest.2400000000000006.quest_desc: [
		"A face da divindade."
		""
		"Vestir esta máscara passará a liderança da tribo para você! Os Barakoas não te atacarão mais, e você poderá invocar os seus próprios guerreiros da tribo para te defender."
	]
	quest.2400000000000006.title: "O Visage do Sol"
	quest.2400000000000007.quest_desc: [
		"A besta adormecida nas planícies de gelo."
		""
		"O Frostmaw dorme protegendo um cristal. Se você tentar roubá-lo de forma descuidada ou atacá-lo, ele despertará com fúria cega, desferindo golpes esmagadores e rajadas de nevasca!"
	]
	quest.2400000000000007.title: "O Frostmaw"
	quest.2400000000000008.quest_desc: [
		"A magia do inverno absoluto."
		""
		"Ao segurar o botão direito, o Cristal de Gelo canaliza uma tempestade de neve à sua frente, congelando instantaneamente qualquer entidade no caminho!"
	]
	quest.2400000000000008.title: "Cristal de Gelo"
	quest.2400000000000009.quest_desc: [
		"Explorando as cavernas, você pode encontrar um cristal brilhante correndo."
		""
		"O Grottol é um caranguejo de cristal imune a todo tipo de arma. A ÚNICA forma de matá-lo é acertando-o com uma Picareta!"
	]
	quest.2400000000000009.title: "O Cristal Vivo"
	quest.240000000000000A.quest_desc: ["Nas florestas e pântanos cobertos pelas árvores, almas luminosas flutuam pacificamente."]
	quest.240000000000000A.title: "As Lanternas Flutuantes"
	quest.240000000000000B.quest_desc: [
		"O extrato deixado para trás pelas Lanternas."
		""
		"Ao comer a Glowing Jelly, você ganha Visão Noturna temporária, perfeita para explorar cavernas sem tochas."
	]
	quest.240000000000000B.title: "Gelatina Luminosa"
	quest.240000000000000C.quest_desc: [
		"A armadilha mortal das selvas."
		""
		"O Foliaath é uma planta carnívora gigante que bloqueia ataques de perto. Dica de caçador: Jogue qualquer pedaço de carne no chão perto dele. Quando ele abrir a flor para comer, ataque com tudo!"
	]
	quest.240000000000000C.title: "O Foliaath"
	quest.240000000000000D.quest_desc: [
		"Plante a sua própria fera!"
		""
		"Coloque a semente no chão e alimente o broto jogando carne para ele a cada meio dia (tempo do jogo). Quando crescer totalmente, ele atacará monstros para defender a sua base!"
	]
	quest.240000000000000D.title: "Semente Carnívora"
	quest.240000000000000E.quest_desc: [
		"O dragão serpentino dos penhascos e litorais."
		""
		"O Naga voa agilmente e atira poças de ácido letal. Quando ele mergulhar na sua direção, ataque exatamente na hora do impacto ou bata no cuspe de veneno dele para rebater de volta no ar!"
	]
	quest.240000000000000E.title: "A Serpente Alada"
	quest.240000000000000F.quest_desc: [
		"O espólio peçonhento do Naga."
		""
		"A Presa de Naga (Naga Fang) pode ser usada como um punhal rápido para envenenar os inimigos ou utilizada na destilaria para preparar magias exóticas."
	]
	quest.240000000000000F.title: "A Presa Envenenada"
	quest.2400000000000010.quest_desc: [
		"O berço abandonado da magia da Terra (Geomancia)."
		""
		"Escondido nas altas montanhas, o imenso Monastério é defendido por elementais rochosos chamados Bluffs. Elimine-os pelo caminho e recolha suas varas mágicas!"
	]
	quest.2400000000000010.title: "O Monastério da Terra"
	quest.2400000000000011.quest_desc: [
		"O último mestre monge."
		""
		"Tongbi aguarda no pátio do monastério. Você pode entregar os drops do Bluff para ele e iniciar o Desafio de Parkour flutuante, OU atacá-lo diretamente, enfrentando a fúria esmagadora das pedras e pilares que ele levanta do chão!"
	]
	quest.2400000000000011.title: "Tongbi, O Escultor"
	quest.2400000000000012.quest_desc: [
		"O poder absoluto da Geomancia nas suas mãos."
		""
		"A Earthrend Gauntlet (Manopla de Fenda-Terra) permite levantar rochas como plataformas voadoras, escavar buracos de arremesso em paredes ou esmagar o chão em um tremor massivo de pedregulhos!"
	]
	quest.2400000000000012.title: "A Manopla de Fenda-Terra"
	quest.2400000000000013.quest_desc: [
		"Os espólios cerimoniais do mestre geomante."
		""
		"Vestir as Soothsayer's Garments e empunhar o Sculptor Staff marcam a conclusão do seu treinamento de magia terrena."
	]
	quest.2400000000000013.title: "Cajado do Escultor"
	quest.242806465E3D503B.quest_desc: ["Pule no portal luminoso. Bem-vindo a Icaria! Um reino de ilhas flutuantes gigantescas, desertos de cristal, florestas vibrantes e ruínas de uma antiga civilização morta-viva. Muito cuidado para não cair no vazio infinito do céu!"]
	quest.242806465E3D503B.title: "O Paraíso em Ruínas"
	quest.24281973BBBABFF4.title: "Alvo: Crab"
	quest.242AEB6D34830D2E.quest_desc: ["O símbolo máximo de riqueza e durabilidade. Com o diamante, os segredos mais profundos do jogo se abrem para você."]
	quest.242F772F10CAA4C0.title: "Alvo: Tree Ent"
	quest.244DA5DF94213662.quest_desc: ["O Quantum Ring. Construa dois desses portais pelo mapa, coloque as singularidades emparelhadas neles, e sua rede AE2 se comunicará através das dimensões sem usar um único cabo!"]
	quest.244DA5DF94213662.title: "Anel Quântico"
	quest.245A7F62D6EAB795.quest_desc: ["O Inventory Proxy atua como uma 'extensão' do baú. Se você tem um baú e quer conectar vários cabos ou funis nele, coloque o Proxy encostado no baú e ligue os cabos no Proxy!"]
	quest.245A7F62D6EAB795.title: "A Extensão (Proxy)"
	quest.24ADDE1ECAE51E4C.title: "Alvo: Yeti"
	quest.24C21ED0D7D8E085.quest_desc: [
		"A tecnologia da TVA é complexa demais para ser adivinhada. O §6Knowledge Projector§r (Projetor de Conhecimento) atua como o manual oficial do mod."
		""
		"Coloque-o no chão ou use-o para entender as receitas e o funcionamento da energia temporal."
	]
	quest.24C21ED0D7D8E085.title: "O Manual do Viajante"
	quest.2500000000000001.quest_desc: [
		"O mundo foi fraturado por feras antigas."
		""
		"O L's Cataclysm exige o máximo das suas habilidades. Abaixo estão listados os 8 grandes Titãs do mod, organizados do mais fraco (esquerda) ao mais desafiador (direita). Para encontrá-los, você precisará craftar os seus respectivos Olhos Mágicos (Eyes)."
	]
	quest.2500000000000001.title: "A Era do Cataclismo"
	quest.2500000000000002.quest_desc: ["**DICA DE OURO:** Basta segurar este Olho na sua mão e **clicar com o botão direito no ar**! Você será instantaneamente teleportado para a forja da Soul Blacksmith."]
	quest.2500000000000002.title: "O Olho da Besta"
	quest.2500000000000003.quest_desc: [
		"Um titã revestido de Netherite."
		""
		"A Monstruosidade arremessa lava, bate violentamente no chão e tem uma armadura absurdamente grossa. Cuidado com as erupções vulcânicas sob seus pés!"
	]
	quest.2500000000000003.title: "A Monstruosidade"
	quest.2500000000000004.quest_desc: [
		"Com o chifre do monstro, você forja a Infernal Forge."
		""
		"Uma arma de esmagamento tão massiva que faz o próprio chão tremer ao seu comando!"
	]
	quest.2500000000000004.title: "A Forja Infernal"
	quest.2500000000000005.quest_desc: ["**DICA DE OURO:** Basta segurar este Olho na sua mão e **clicar com o botão direito**! Você será instantaneamente teleportado para a Burning Arena."]
	quest.2500000000000005.title: "O Olho de Chamas"
	quest.2500000000000006.quest_desc: [
		"O líder absoluto do fogo."
		""
		"Ignis é rápido, impiedoso e ataca em múltiplas fases usando Escudo e Espada. Destrua-o para tomar o poder supremo do Nether."
	]
	quest.2500000000000006.title: "Ignis, o Lorde"
	quest.2500000000000007.quest_desc: [
		"O metal que arde mais que as próprias estrelas."
		""
		"O Ignitium Ingot permite forjar uma armadura infinitamente superior ao Netherite e armas de fogo eternas."
	]
	quest.2500000000000007.title: "Ignitium"
	quest.2500000000000008.quest_desc: ["**DICA DE OURO:** Basta segurar este Olho na sua mão e **clicar com o botão direito**! Você será instantaneamente teleportado para os portões da Ruined Citadel no Fim."]
	quest.2500000000000008.title: "O Olho do Vazio"
	quest.2500000000000009.quest_desc: [
		"O Mestre do Vazio."
		""
		"O Ender Guardian não mostrará misericórdia. Ele atira mísseis cósmicos, possui um escudo giratório impenetrável e se teletransporta furiosamente."
	]
	quest.2500000000000009.title: "O Guardião do Fim"
	quest.250000000000000A.quest_desc: [
		"A Essência de Buracos Negros."
		""
		"O Void Core é a chave para forjar a Void Forge e a espetacular Manopla de Guarda, que manipula o campo gravitacional ao seu redor!"
	]
	quest.250000000000000A.title: "O Núcleo do Vazio"
	quest.250000000000000B.quest_desc: ["**DICA DE OURO:** Basta segurar este Olho na sua mão e **clicar com o botão direito**! Você mergulhará instantaneamente na Cidade Submersa."]
	quest.250000000000000B.title: "O Olho do Abismo"
	quest.250000000000000C.quest_desc: [
		"O deus dos mares."
		""
		"O combate na água contra o Leviathan será claustrofóbico e os lasers de plasma dele são letais! A movimentação rápida e o controle de oxigênio são cruciais."
	]
	quest.250000000000000C.title: "The Leviathan"
	quest.250000000000000D.quest_desc: [
		"As garras das profundezas."
		""
		"A Tidal Claws permite cortes extremamente rápidos, garantindo um dash mortal e muita agilidade debaixo d'água."
	]
	quest.250000000000000D.title: "Garras das Marés"
	quest.250000000000000E.quest_desc: ["**DICA DE OURO:** Basta segurar este Olho na sua mão e **clicar com o botão direito**! Você será levado direto às esteiras de produção da Ancient Factory."]
	quest.250000000000000E.title: "O Olho da Máquina"
	quest.250000000000000F.quest_desc: [
		"A máquina do juízo final construída com resquícios de Wither."
		""
		"The Harbinger dispara mísseis perseguidores, lasers vermelhos da morte e ataca com golpes mecânicos difíceis de se esquivar."
	]
	quest.250000000000000F.title: "The Harbinger"
	quest.2500000000000010.quest_desc: [
		"O metal profano e tecnológico."
		""
		"O Witherite Ingot é essencial para a confecção da armadura mecânica e das armas a laser de destruição em massa deixadas pelo Harbinger."
	]
	quest.2500000000000010.title: "Witherite"
	quest.2500000000000011.quest_desc: ["**DICA DE OURO:** Basta segurar este Olho na sua mão e **clicar com o botão direito**! As portas amaldiçoadas da Cursed Pyramid se abrirão para você."]
	quest.2500000000000011.title: "O Olho do Deserto"
	quest.2500000000000012.quest_desc: [
		"Um colosso esquelético coberto de areia e magia negra."
		""
		"O Ancient Remnant bate incrivelmente forte, conjura tempestades de areia e invoca exércitos de mortos. Esmague-o para purificar as dunas."
	]
	quest.2500000000000012.title: "O Titã de Areia"
	quest.2500000000000013.quest_desc: ["Um artefato pesado de puro poder ancestral, capaz de forjar um equipamento lendário do deserto."]
	quest.2500000000000013.title: "Crânio Ancestral"
	quest.2500000000000014.quest_desc: ["**DICA DE OURO:** Basta segurar este Olho na sua mão e **clicar com o botão direito**! Você será transportado para o centro gélido da Frost Prison."]
	quest.2500000000000014.title: "O Olho Congelado"
	quest.2500000000000015.quest_desc: [
		"Um lorde Draugr esquecido no gelo."
		""
		"Maledictus domina a Frost Prison. Ele desperta legiões de mortos-vivos, conjura nevascas cegantes e dispara magias de gelo letais. Use os pilares do ambiente para quebrar a linha de visão das magias dele!"
	]
	quest.2500000000000015.title: "Maledictus"
	quest.2500000000000016.quest_desc: [
		"O metal amaldiçoado extraído do gelo."
		""
		"Com o Cursium Ingot, as armas e equipamentos letais da tundra podem ser finalmente forjadas, garantindo controle glacial em batalha."
	]
	quest.2500000000000016.title: "Cursium"
	quest.2500000000000017.quest_desc: ["**DICA DE OURO:** Basta segurar este Olho na sua mão e **clicar com o botão direito**! A ira da tempestade te levará direto para a Acrópole (Acropolis)."]
	quest.2500000000000017.title: "O Olho da Tempestade"
	quest.2500000000000018.quest_desc: [
		"O terror absoluto dos mares e das tempestades."
		""
		"Scylla aguarda na Acrópole. Uma monstruosidade marinha impiedosa com tentáculos massivos, ataques baseados em relâmpagos elétricos e fortes correntes de água. A agilidade máxima e o preparo total são exigidos aqui para não ser destroçado!"
	]
	quest.2500000000000018.title: "Scylla"
	quest.2500000000000019.quest_desc: [
		"A essência pura dos furacões."
		""
		"Ao obter a Essence of the Storm, você detém o poder de controlar os relâmpagos e as marés. Ela é usada para forjar as armas supremas da tempestade!"
	]
	quest.2500000000000019.title: "Essência da Tempestade"
	quest.250000000000001A.quest_desc: [
		"A Convergência Absoluta."
		""
		"Você massacrou as oito ameaças primordiais do universo. Dominou o Fogo, o Vazio, os Oceanos, as Máquinas, as Areias do Tempo, as Prisões de Gelo e as Tempestades Marítimas."
		""
		"Não há mais nenhum titã que ouse cruzar o seu caminho. As relíquias que você reuniu provam que o verdadeiro Cataclismo... é você. O mundo agora repousa sob o seu domínio absoluto."
	]
	quest.250000000000001A.title: "O Fim de uma Era"
	quest.250000000000001B.quest_desc: [
		"O reino puro da destruição."
		""
		"Acenda o portal e pise na Dimensão do Cataclismo. A sobrevivência aqui não é garantida, mas as recompensas finais o colocarão como um verdadeiro Deus deste mundo!"
	]
	quest.250000000000001B.title: "A Dimensão do Cataclismo"
	quest.256AB9780204A88F.quest_desc: [
		"Antes de montar as dinamites, você precisa fabricar a embalagem (Wrapper) que vai segurar a pólvora."
		""
		"Este papel especial vermelho garante a estabilidade do seu explosivo na hora do arremesso."
	]
	quest.256AB9780204A88F.title: "Embalagem Explosiva"
	quest.2574521A71CFE35E.quest_desc: [
		"Você dominou as feras do Brasil."
		""
		"Agora você tem os ingredientes necessários (Olho do Mapinguari, Couro Flamejante, etc.) para transmutar e criar os Livros Mágicos (Spell Books) do mod, que te darão habilidades além da imaginação Vanilla!"
	]
	quest.25A232E77AAC8F72.quest_desc: [
		"A clássica lenda dos redemoinhos. O Saci é um ser místico ágil, conhecido por suas travessuras e ilusões."
		""
		"Fique atento aos ventos e prepare uma boa arma de ataque rápido para conseguir pegá-lo!"
	]
	quest.25A232E77AAC8F72.title: "O Garoto do Gorro Vermelho"
	quest.25B91A6B3ACC56F4.title: "Alvo: Mushlin Bumper"
	quest.25CC7489334F4826.title: "Alvo: Pottergeist"
	quest.25E821EE46278EC2.quest_desc: [
		"Acha que o Tempad tem pouca memória? O §bRepository Upgrade§r expande a capacidade de armazenamento."
		""
		"Instale-o para poder guardar muito mais Cartões de Localização (Location Cards) no seu dispositivo."
	]
	quest.25E821EE46278EC2.title: "Expansão de Memória"
	quest.2600000000000001.quest_desc: [
		"O folclore não é apenas um conjunto de histórias... é real, e está sedento por sangue."
		""
		"O mod Myths and Legends adiciona criaturas com mecânicas únicas baseadas em lendas de várias culturas. A força bruta nem sempre resolverá os seus problemas. Prepare-se para explorar e descobrir os segredos sombrios do mundo!"
	]
	quest.2600000000000001.title: "Mitos e Lendas"
	quest.2600000000000002.quest_desc: [
		"Nos picos rochosos e encostas de pedra, estátuas repousam durante o dia."
		""
		"Assim que a noite cai, a Gárgula ganha vida! Ela é **completamente imune a flechas e poções**, forçando-o a lutar corpo a corpo. Cuidado: os ataques dela criam ondas de choque e têm 15% de chance de o petrificar!"
	]
	quest.2600000000000002.title: "O Vigilante Noturno"
	quest.2600000000000003.quest_desc: [
		"O núcleo de pedra da fera."
		""
		"Ao destruir Gárgulas, recolherá os seus fragmentos. Estes pedaços densos e mágicos são usados para forjar o arsenal rochoso."
	]
	quest.2600000000000003.title: "Fragmentos de Gárgula"
	quest.2600000000000004.quest_desc: [
		"Uma arma tão pesada que quebra o próprio solo."
		""
		"O Machado da Gárgula (Gargoyle Axe) permite libertar uma onda de choque sísmica que atira os seus inimigos pelos ares, imitando a habilidade do próprio monstro!"
	]
	quest.2600000000000004.title: "O Machado da Gárgula"
	quest.2600000000000005.quest_desc: ["Defesa absoluta e impenetrável. Forjado com os fragmentos densos, este escudo aguenta impactos titânicos."]
	quest.2600000000000005.title: "O Escudo Inquebrável"
	quest.2600000000000006.quest_desc: [
		"Aventure-se nas ruínas esquecidas (Ancient Vestiges)."
		""
		"Lá encontrará as Armaduras Possuídas (Possessed Armor). Movidas por magia negra, elas são **totalmente imunes a repulsão (knockback)**. Se tentarem fechar a distância consigo, não há como empurrá-las para trás!"
	]
	quest.2600000000000006.title: "Os Fantasmas de Metal"
	quest.2600000000000007.quest_desc: [
		"Ao derrotar os espíritos das ruínas, obterá fragmentos assombrados."
		""
		"Derreta os pedaços corrompidos para purificá-los e convertê-los no formidável Lingote de Alma Vinculada (Bound Soul Ingot)!"
	]
	quest.2600000000000007.title: "A Liga das Almas"
	quest.2600000000000008.quest_desc: [
		"Equipe a escuridão."
		""
		"Utilize os lingotes mágicos para forjar a Bound Soul Armor. Uma proteção pesada que carrega o legado fantasmagórico dos antigos guardiões."
	]
	quest.2600000000000008.title: "Armadura Fantasma"
	quest.2600000000000009.quest_desc: [
		"Uma praga astuta nas planícies do Nether."
		""
		"Os Imps parecem frágeis (com apenas 5 de vida), mas são o diabo em forma de monstro! Disparam bolas de fogo, infligem o efeito Wither e, o pior de tudo: **quando você mata um Imp, ele clona-se em mais dois no exato momento da morte!**"
	]
	quest.2600000000000009.title: "A Praga Infernal"
	quest.260000000000000B.quest_desc: ["Um coração ardendo com chamas eternas (Fire Heart) e as relíquias mágicas dropadas pelas abominações do submundo."]
	quest.260000000000000B.title: "Coração de Chamas"
	quest.260000000000000C.quest_desc: [
		"A lenda mais temível."
		""
		"Procure nos desertos e badlands até encontrar a rara estrutura: O Altar dos Mortos (Altar of the Dead). Esta pedra mística é a passagem entre o mundo dos vivos e a lenda espectral."
	]
	quest.260000000000000C.title: "O Altar do Deserto"
	quest.260000000000000D.quest_desc: [
		"Para chamar a lenda, precisará de preparar o ritual."
		""
		"Construa o Amuleto Vinculador de Almas (Soulbinder Amulet). Quando a noite cobrir o deserto, utilize o amuleto no Altar dos Mortos!"
	]
	quest.260000000000000D.title: "O Amuleto Sombrio"
	quest.260000000000000E.quest_desc: [
		"O arauto da perdição (350 de vida)."
		""
		"O Charro Negro (The Black Charro) emerge sob a cobertura da escuridão. Ele irá zombar da sua fraqueza no chat! Ele atira Orbes Umbrais, teletransporta-se para quebrar a sua guarda e invoca exércitos de mortos-vivos (Condemned Souls) para o oprimir. Não falhe."
	]
	quest.260000000000000E.title: "O Charro Negro"
	quest.260000000000000F.quest_desc: [
		"O prémio pela derrota da lenda viva."
		""
		"O 'Sussurro das Sombras' (Umbras Whisper) canaliza o próprio vazio num artefacto mortal, permitindo-lhe disparar projéteis de pura escuridão contra os seus inimigos."
	]
	quest.260000000000000F.title: "Sussurro das Sombras"
	quest.2600000000000010.quest_desc: [
		"O Predador das Neves."
		""
		"Nos biomas congelados (Tundra, Neve), um uivo anuncia a morte. O Amarok é um lobo colossal que SÓ spawna durante as noites de Lua Cheia (Full Moon)! Ele é 100% imune a qualquer tipo de magia e dano de congelamento. Equipe-se bem para esta caçada letal."
	]
	quest.2600000000000010.title: "O Amarok"
	quest.2600000000000011.quest_desc: [
		"Com a pele (Hide) e a essência do lobo gigante, você pode forjar o traje supremo dos caçadores invernais."
		""
		"A Frosthowl Armor carrega o espírito das caçadas nortenhas sob a luz das estrelas."
	]
	quest.2600000000000011.title: "Armadura do Uivo Gélido"
	quest.2600000000000012.quest_desc: [
		"Nas grandes planícies (Meadows), você pode encontrar o O Velho Acampamento (Old Camp)."
		""
		"Esta estrutura quebrada e cheia de teias de aranha abriga o temível Possessed Armor Inquisitor, a elite das armaduras mortas!"
	]
	quest.2600000000000012.title: "O Velho Acampamento"
	quest.2600000000000013.quest_desc: [
		"O guardião implacável de 120 de Vida e 12 de Dano."
		""
		"O Inquisidor não sofre nenhum tipo de repulsão. A sua grande fraqueza? Sempre que você o acerta, há 10% de chance dele ficar completamente atordoado (Stunned)!"
	]
	quest.2600000000000013.title: "O Inquisidor Possuído"
	quest.2600000000000014.quest_desc: [
		"Forjada para os atiradores espectrais e combatentes velozes."
		""
		"Com os Cursed Cores deixados pelo Inquisidor, você pode forjar a Soulpiercer Armor, uma proteção que sussurra através do véu dos vivos."
	]
	quest.2600000000000014.title: "Armadura do Atirador de Almas"
	quest.2600000000000015.quest_desc: [
		"A fúria abissal do Nether."
		""
		"Abaddon é um lorde demoníaco perigoso. Prepare seu arsenal e derrote-o para extrair o seu precioso núcleo infernal (Core of Abaddon)."
	]
	quest.2600000000000015.title: "O Demônio do Abismo"
	quest.2600000000000016.quest_desc: [
		"Nascido da fúria infernal."
		""
		"O Molten Fist é uma manopla maravilhosa que rasga a terra. Ao clicar com o botão direito, você dispara 8 espinhos de magma letais!"
		""
		"DICA: O tempo de recarga cai de 8 segundos para meros 2 segundos se você a utilizar perto de uma fonte de calor extremo (como um lago de lava)!"
	]
	quest.2600000000000016.title: "O Punho Derretido"
	quest.26069F56DA4AC638.quest_desc: [
		"Uma caixa inteira entupida de explosivos. O impacto de larga escala do mod."
		""
		"Usada para arrasar estruturas ou montanhas. O Caixote tem um raio de explosão massivo, então plante-o e corra muito rápido."
	]
	quest.26069F56DA4AC638.title: "O Caixote da Destruição"
	quest.260BC57FF54D17EB.title: "O Chamado do Abismo"
	quest.264AE6FF01979B21.title: "Alvo: Swamp Skeleton"
	quest.265345B11F565AF8.title: "Alvo: Piglin Ghost"
	quest.26607F7259FE5A66.quest_desc: ["Chegamos ao The End. O Molde definitivo se esconde nas Cidades do Fim."]
	quest.26607F7259FE5A66.title: "Molde: Ametrina"
	quest.26772E8E764BDBAA.title: "Alvo: Revenant"
	quest.269CBA56679E3A4C.quest_desc: ["Cresça as sementes na água. Este cristal é a base de todas as máquinas de ponta da sua rede."]
	quest.269CBA56679E3A4C.title: "O Cristal Fluix"
	quest.26A5F6819911D073.quest_desc: [
		"Lenta, porém devastadora."
		""
		"A Large Sword causa impressionantes 12 de dano e possui Alcance de Entidade expandido. Você pode atingir os chefes de uma distância mais segura!"
	]
	quest.26A5F6819911D073.title: "A Espada Colossal"
	quest.26BA1F047EBDBB7F.quest_desc: ["O Create: Chocolate Fountain traz a confeitaria para a fábrica. Derreta cacau e açúcar nos Mixers, transforme em chocolate líquido e bombeie-o através de tubulações (Fluid Pipes) para encher tanques enormes."]
	quest.26BA1F047EBDBB7F.title: "Chocólatra Industrial"
	quest.2700000000000001.quest_desc: [
		"O teste supremo de sobrevivência em ondas!"
		""
		"Ao usar uma Pérola de Portal (Gate Pearl) no chão, uma fenda se abre. Você deve matar os monstros antes do tempo acabar, ou um raio fechará o portal e você perderá o loot restante."
		""
		"**DICA DE MESTRE:** Se você estiver SEGURANDO uma espada com o encantamento de Saque (Looting) na sua mão exatamente no momento em que a onda termina e o loot é distribuído, o encantamento será aplicado a todos os prêmios do portal multiplicando seus ganhos!"
	]
	quest.2700000000000001.title: "O Desafio das Ondas"
	quest.2700000000000002.quest_desc: [
		"A invasão da guarda corrompida."
		""
		"O Gateway of Overworldly Knights traz inimigos blindados. **ATENÇÃO:** Este portal possui penalidades (Penalties) ativas! Se você falhar ou o tempo acabar, você receberá Cegueira por 20 segundos e duas Bruxas serão invocadas para te punir!"
	]
	quest.2700000000000002.title: "Cavaleiros da Superfície"
	quest.2700000000000003.quest_desc: [
		"O teste de controle de grupo (Crowd Control)."
		""
		"O Slime Gateway vai lotar a sua tela de gosmas. Como eles se dividem ao morrer e ficam menores e mais chatos de acertar, uma arma com dano em área (Sweeping Edge) é absolutamente necessária para não estourar o tempo da onda!"
	]
	quest.2700000000000003.title: "A Horda Gosmenta"
	quest.2700000000000004.quest_desc: [
		"O teste de contenção."
		""
		"O Enderman Gateway é perigoso por uma mecânica: o teleporte. Se a arena for muito aberta e um Enderman sumir da sua vista (Out of Bounds), o tempo vai correr e você vai falhar. Construa um teto baixo ou lute num espaço fechado!"
	]
	quest.2700000000000004.title: "A Invasão do Fim"
	quest.2700000000000005.quest_desc: [
		"O teste do calor e da sobrevivência aérea."
		""
		"No Blaze Gateway, a cada onda os Blazes recebem mais Vida e Armadura. Eles vão fritar a arena com bolas de fogo. Poções de Resistência ao Fogo e um arco robusto são a chave para a vitória."
	]
	quest.2700000000000005.title: "O Portal de Chamas"
	quest.2700000000000006.quest_desc: [
		"A invasão da elite saqueadora."
		""
		"The Emerald Grove Gateway atrai Vindicators implacáveis, Evokers com as suas magias de chão e Bruxas. Uma arena brutal de sobrevivência que te recompensa com pilhas de Esmeraldas e Totens da Imortalidade."
	]
	quest.2700000000000006.title: "O Bosque das Esmeraldas"
	quest.2700000000000007.quest_desc: [
		"A guarda pesada do Nether."
		""
		"O Gateway of the Hellish Fortress te joga contra Wither Skeletons aplicando decomposição, Magma Cubes gigantes se dividindo em dezenas menores e hordas de Blazes. Uma verdadeira guerra!"
	]
	quest.2700000000000007.title: "A Fortaleza Infernal"
	quest.2700000000000009.quest_desc: [
		"O inferno não tem fim."
		""
		"O Endless Blaze Gateway escalará o poder das chamas infinitamente, roubando também o tempo máximo da sua onda a cada 5 fases. Empunhe sua espada com Saque (Looting) e enfrente o fogo até não aguentar mais!"
	]
	quest.2700000000000009.title: "O Fogo Infinito"
	quest.2702FB9AF5570A80.title: "Alvo: Arid Yeti"
	quest.27B158C553C00AEB.title: "Alvo: Rare Phoenix"
	quest.27D6381D10C5C130.title: "Alvo: Bogged Bone Stalker"
	quest.27DFDAF581444E6E.quest_desc: ["O início das MegaCells / ExtendedAE!"]
	quest.27DFDAF581444E6E.title: "Célula de 256k"
	quest.27F1461B1B1BBAF5.title: "Alvo: Butterfly"
	quest.2800000000000001.quest_desc: [
		"O Knight Quest muda a forma como você forja equipamentos."
		""
		"Em vez de apenas minerar, derrote as novas criaturas do mod (como o Swamp Man, Gremlin e os Cavaleiros) para obter as Small Essences (Essências Menores). Junte 4 delas numa bancada de trabalho para formar uma Great Essence!"
	]
	quest.2800000000000001.title: "A Caçada Começa"
	quest.2800000000000002.quest_desc: [
		"O coração da progressão mágica do mod."
		""
		"Crafte o Cálice de Cobre (Copper Chalice). Para energizá-lo, você deve clicar com o botão direito nele segurando as suas Great Essences. Assim, obterá o Cálice Preenchido (Filled Grail)!"
	]
	quest.2800000000000002.title: "O Cálice de Cobre"
	quest.2800000000000003.quest_desc: [
		"Com o Filled Grail em mãos, você tem a chave para forjar as armaduras mais poderosas do jogo."
		""
		"Quase todas as armaduras do mod exigem o Graal, uma peça de armadura base e um item especial (como Maçãs Douradas, Bambu, etc). Use o JEI para ver as receitas!"
	]
	quest.2800000000000003.title: "O Graal Preenchido"
	quest.2800000000000004.quest_desc: [
		"Existem dezenas de armaduras únicas, superiores ao Netherite!"
		""
		"A Veteran Armor oferece um aumento massivo de dano e resistência. Outras opções incluem a Warlord (protege os seus aliados), Bat (dá visão noturna), Dragon (imune a bafo de dragão) e Straw (respiração infinita na água)."
	]
	quest.2800000000000004.title: "A Forja do Veterano"
	quest.2800000000000005.quest_desc: [
		"Até mesmo armaduras puramente temáticas e estéticas estão presentes."
		""
		"A Hollow Armor transforma-o no icónico Cavaleiro de Hollow Knight! Explore as receitas para encontrar os visuais mais incríveis para o seu personagem."
	]
	quest.2800000000000005.title: "O Cavaleiro Vazio"
	quest.2800000000000006.quest_desc: [
		"Nos desertos, selvas e cavernas, o Ratman espreita."
		""
		"Ele lança chuvas de flechas venenosas e usa bombas de fumo para ficar invisível quando a sua vida cai pela metade. Elimine-o para obter o precioso Olho de Ratman (Ratman Eye)!"
	]
	quest.2800000000000006.title: "O Olho do Rato"
	quest.2800000000000007.quest_desc: [
		"Uma das melhores espadas do jogo para sobrevivência."
		""
		"Com o olho do Ratman, você forja a Paladin Sword. Ela ataca super rápido, causa 10 de dano base, regenera passivamente a sua vida e a grande cartada: se você cair abaixo de 50% de HP, ela garante 5 SEGUNDOS de Imortalidade total!"
	]
	quest.2800000000000007.title: "A Lâmina do Paladino"
	quest.2800000000000008.quest_desc: [
		"**AVISO DE COMBATE:**"
		""
		"Se você vir um Ghostling (um pequeno fantasma voador), MATE-O PRIMEIRO! Ele concede Resistência V a todos os outros monstros próximos, tornando-os praticamente imortais. A boa notícia é que a luz do sol queima os Ghostlings imediatamente."
	]
	quest.2800000000000008.title: "O Fantasma Suporte"
	quest.2800000000000009.quest_desc: [
		"Você pode construir o seu próprio aliado de guerra!"
		""
		"Faça uma estrutura em 'T' usando Blocos de Ouro e coloque uma Jack o'Lantern no topo (exatamente como se faz um Golem de Ferro). Você criará o Samheim!"
		""
		"Dome-o dando-lhe Great Essences. A parte mais legal? Você pode equipar armaduras do mod nele segurando Shift + Clique no Golem!"
	]
	quest.2800000000000009.title: "O Golem Samheim"
	quest.280000000000000A.quest_desc: [
		"A preparação para a Batalha Suprema."
		""
		"Para enfrentar o chefe do mod, você precisará combinar o seu Filled Grail (Cálice Preenchido) com uma Radiant Essence num altar/poço para invocar o chefe."
	]
	quest.280000000000000A.title: "A Essência Radiante"
	quest.280000000000000B.quest_desc: [
		"O grande invocador do caos."
		""
		"O temível **Netherman** possui 450 de HP e ataca em 3 fases brutais:"
		"1. Fogo: Queimaduras e poças de lava."
		"2. Gelo: Congelamento e clones ilusórios."
		"3. Escuridão: Teleportes, bombas sombrias e penalidades de status!"
	]
	quest.280000000000000B.title: "As Três Fases do Caos"
	quest.280000000000000C.quest_desc: [
		"O poder absoluto sobre as suas armas."
		""
		"A Chaotic Essence deixada por **Netherman** NÃO é usada para craftar itens. Ela é usada para **POTENCIALIZAR** as suas armas do arsenal!"
		""
		"Coloque a sua espada e a essência numa bancada mágica do mod para desbloquear Habilidades Passivas e Ativas (como o Modo de Fúria que te dá resistência, ou um aumento fixo de +20% de dano base). As habilidades ativas são consumidas ao clicar com o botão direito!"
	]
	quest.280000000000000C.title: "A Essência Caótica"
	quest.280000000000000D.quest_desc: ["As essências dos monstros permitem forjar um arsenal vasto, com armas para todos os estilos de combate: desde golpes lentos e devastadores até cortes velozes e precisos!"]
	quest.280000000000000D.title: "O Arsenal do Cavaleiro"
	quest.280000000000000E.quest_desc: [
		"Pesada, formidável e brutal."
		""
		"A Cleaver desfere golpes massivos, sendo a arma perfeita para enfrentar chefes quando combinada com a Essência Caótica!"
	]
	quest.280000000000000E.title: "O Cutelo"
	quest.280000000000000F.quest_desc: [
		"Alcance e precisão de um samurai."
		""
		"A Uchigatana permite atacar os inimigos mantendo uma distância segura, além de possuir uma velocidade de corte excelente."
	]
	quest.280000000000000F.title: "Uchigatana"
	quest.2800000000000010.quest_desc: [
		"Uma lâmina curta e perversa."
		""
		"O Kukri é ideal para fechar a distância rapidamente e aplicar uma enxurrada de golpes nos oponentes."
	]
	quest.2800000000000010.title: "Kukri"
	quest.2800000000000011.quest_desc: [
		"A lâmina curva dos antigos reis."
		""
		"A Khopesh tem um formato exótico que prende os inimigos e desfere cortes limpos e letais."
	]
	quest.2800000000000011.title: "Khopesh"
	quest.2800000000000012.quest_desc: [
		"A arma de um inseto guerreiro de um reino esquecido..."
		""
		"O Nail (Ferrão) é a lendária lâmina de Hollow Knight. Empunhe-a juntamente com a Hollow Armor para ter a build completa do cavaleiro vazio!"
	]
	quest.2800000000000012.title: "O Ferrão"
	quest.2803D1EDA6C3D118.quest_desc: [
		"Cansado de ter 50 baús espalhados e não achar nada? O Tom's Simple Storage é a sua rede de dados inicial, que não precisa de energia elétrica para funcionar!"
		""
		"Comece fazendo o Inventory Connector. Coloque-o encostado em uma parede de baús (como os do Sophisticated Storage) para que ele leia tudo o que está dentro deles."
	]
	quest.2803D1EDA6C3D118.title: "O Fim da Bagunça"
	quest.281EDEA82B1F203D.title: "Alvo: Witchdoctor"
	quest.2820231DA5F89B74.quest_desc: [
		"Você não pode forjar um rubi líquido. A tecnologia base deste mod é o Freezer."
		""
		"Esta máquina consome Gelo para congelar a gema incandescente de volta ao seu estado sólido."
	]
	quest.2820231DA5F89B74.title: "A Máquina de Gelo"
	quest.2882814E233D2E64.title: "Alvo: Jungle Zombie"
	quest.288F072CABE94883.title: "Alvo: Rare Phoenix"
	quest.28DA47FD65F6ED44.quest_desc: [
		"Use a sua Ancient Trial Key no altar do topo."
		""
		"O Infernal Dragon lança sopros contínuos de fogo e usa a cauda para te arremessar. Com 1/3 de vida, ele troca de pele e começa a quebrar o chão sob os seus pés!"
	]
	quest.28DA47FD65F6ED44.title: "O Dragão Infernal"
	quest.28E00E1633E2BFA2.quest_desc: [
		"Procure por igrejas abandonadas nos biomas de Planícies (Plains)."
		""
		"Lá você enfrentará a Mula Sem Cabeça, um boss terrível com duas fases, capaz de arremessar jogadores pro alto e incendiar a área toda."
	]
	quest.28E00E1633E2BFA2.title: "A Igreja em Chamas"
	quest.28EFE7A3F3E34014.quest_desc: [
		"Forjado nas chamas e detritos do Nether."
		""
		"Lembre-se: Na versão atual, você precisa do 'Smithing Template' (Molde de Forja) encontrado nos Bastiões para aplicar a Netherite."
	]
	quest.2900000000000001.quest_desc: [
		"O mundo já não é seguro quando o sol se põe. Esqueça tudo o que sabia sobre a sobrevivência básica."
		""
		"As criaturas deste mod não andam apenas na sua direção; elas esquivam-se, bloqueiam, invocam lacaios e caçam-no invisíveis."
		""
		"**O SEU PRIMEIRO TESTE:**"
		"Enfrente um Door Knight (Cavaleiro da Porta). Ele usa uma porta de metal como escudo impenetrável! Dica de sobrevivência: Você **precisa** de usar um Machado (Axe) para desarmar a sua defesa, ou atear-lhe fogo!"
		""
		"**Segredos e Easter Eggs:**"
		"Explore o mundo para encontrar Lápides comemorativas dos criadores, e tente usar farinha de osso (Bone Meal) numa abóbora normal... coisas terríveis podem acontecer!"
	]
	quest.2900000000000001.title: "O Batismo de Sangue"
	quest.2900000000000002.quest_desc: [
		"A lenda que ganha vida entre 25 de Outubro e 5 de Novembro (ou invocada por si)."
		""
		"**Sir Pumpkin Head** é um mini-boss formidável que o fará suar frio. O combate divide-se em três fases:"
		"• **Fase 1 (Montado):** Ele cavalga um corcel profano. Ataca corpo a corpo e inflige 'Bundle of the Soul', um efeito que o abranda e causa dano massivo."
		"• **Fase 2 (A Pé):** O cavalo ataca-o separadamente. Sir Pumpkin começa a disparar abóboras explosivas e invoca os mortais 'Mr. Pumpkins'."
		"• **Fase 3 (Decapitado):** A sua cabeça solta-se do corpo! O corpo ataca corpo a corpo enquanto a cabeça voadora dispara de cima. Destrua a Cabeça!"
	]
	quest.2900000000000002.title: "O Cavaleiro Abóbora"
	quest.2900000000000003.quest_desc: [
		"Os despojos da primeira vitória."
		""
		"Ao derrotar Sir Pumpkin Head, você pode adquirir a **Pumpkin Staff**, que consome sementes de abóbora para disparar projéteis explosivos em área e evocar um Mr. Pumpkin aliado que bloqueia as magias dos inimigos."
		""
		"Pode também dropar a **Soul Saber**, uma espada com encantos únicos que aplica Estratificação de Alma (Soul Stratification) — quanto mais vida o monstro tiver, maior o dano que sofre quando o efeito acaba."
	]
	quest.2900000000000003.title: "O Cajado Explosivo"
	quest.2900000000000004.quest_desc: [
		"O catalisador do ritual sombrio."
		""
		"O **Transmuting Elixir** é a poção da alquimia proibida. Ao clicar com o botão direito numa 'Infernal Evil Pumpkin' (Abóbora Maligna Infernal) com este elixir na mão, irá evocar a entidade máxima do Halloween."
	]
	quest.2900000000000004.title: "Elixir da Transmutação"
	quest.2900000000000005.quest_desc: [
		"O pesadelo definitivo do End Game."
		""
		"O **Lord Pumpkin Head** exige armadura de topo e poções. A sua mecânica pune a sua força:"
		"• Ele aplica **Infernal Flame**, um fogo letal que ignora a água (só poções de Resistência ao Fogo o salvam)."
		"• Abaixo de metade da vida, ele aplica a **Living Bomb Curse**, que limpa todos os seus buffs e o explode brutalmente de dentro para fora."
	]
	quest.2900000000000005.title: "O Lorde do Halloween"
	quest.2900000000000006.quest_desc: [
		"As recompensas dignas de um deus da morte."
		""
		"O Lorde garante-lhe o arsenal completo das abóboras:"
		"• **Pumpkin Pistol:** Dispara balas flamejantes (Pumpkin Bullets) instantâneas."
		"• **Pumpkin Staff:** Cajado que atira abóboras explosivas em área."
		"• **Soul Bane:** A evolução letal da espada Soul Saber, aplicando 'Estratificação de Alma' e Fogo Infernal."
	]
	quest.2900000000000006.title: "O Arsenal do Lorde"
	quest.2900000000000007.quest_desc: [
		"Nem o Natal está a salvo do Caos."
		""
		"**Krampus** é o juiz impiedoso dos jogadores. Ele aparece para punir nas épocas festivas ou biomas gelados. A sua inteligência foca-se em caçá-lo implacavelmente enquanto usa agilidade extrema."
	]
	quest.2900000000000007.title: "O Terror Festivo (Krampus)"
	quest.2900000000000008.quest_desc: [
		"Um presente encharcado em sangue e magia."
		""
		"O **Creepy Gift** cai de criaturas festivas como o Krampus. A sua genialidade:"
		"**A Mecânica de Naughtiness (Maldade):** O loot baseia-se no seu histórico. Se você matar muitos aldeões ou animais, o seu medidor de maldade sobe, e o Presente dar-lhe-á apenas carvão. Se for honrado, poderá receber diamantes e doces raros!"
	]
	quest.2900000000000008.title: "Presente Assustador"
	quest.2900000000000009.quest_desc: [
		"Os doces do submundo."
		""
		"O Holiday Candy regenera barras inteiras de fome, mas o **Magical Holiday Candy** é uma iguaria absoluta, permitindo comer a qualquer momento e curando exaustão num instante."
	]
	quest.2900000000000009.title: "Os Doces Mágicos"
	quest.290000000000000A.quest_desc: [
		"O caçador que você não consegue ver."
		""
		"A partir da terceira noite no seu mundo, um som aterrorizante rasgará o ar. O **Nightmare Stalker** caminha invisível. Apenas dois olhos brilhantes flutuam na escuridão. Ele deteta a sua presença a uns impressionantes 70 blocos de distância!"
		""
		"**O Olhar do Terror:** O grito dele causa Cegueira, Wither, Escuridão e Drenagem Mágica (Magic Depletion), impedindo-o de usar poções e varinhas defensivas. O Stalker torna-se mais forte a cada dia que passa no seu mundo, atingindo o pico de letalidade após o dia 100!"
	]
	quest.290000000000000A.title: "O Espreitador Noturno"
	quest.290000000000000B.quest_desc: ["As garras retiradas do cadáver do Espreitador são cravadas de magia negra. Colete os seus crânios, a sua pele e a 'Monster Flesh' contaminada."]
	quest.290000000000000B.title: "Garras do Pesadelo"
	quest.290000000000000C.quest_desc: [
		"A foice do Ceifador Negro."
		""
		"A **Nightmare Scythe** é a arma antichefe definitiva. Com uma baixa velocidade de ataque, mas cada golpe inflige Cegueira, Wither e Drenagem Mágica no inimigo, ao mesmo tempo que CURA o jogador. "
		""
		"**O Efeito Secreto:** Golpear chefes mágicos com esta foice impede-os temporariamente de se teletransportarem ou invocarem minions (excelente contra o Bonescaller e Pumpkin Heads)!"
	]
	quest.290000000000000C.title: "A Foice dos Sonhos"
	quest.290000000000000D.quest_desc: [
		"A indumentária do caçador oculto."
		""
		"Costurada com peles (Monster Skin), crânios do Stalker e Dark Metal, a **Nightmare Armor** é a 'build' final para os magos. Ela reduz o 'cooldown' (tempo de recarga) e aumenta a duração das armas mágicas como as Pistolas e Varinhas do mod. Adicionalmente, concede bónus absurdos de velocidade no escuro!"
	]
	quest.290000000000000D.title: "O Conjunto Pesadelo"
	quest.290000000000000E.quest_desc: [
		"A seita espalha-se pela noite."
		""
		"O **Missionary** é um mini-boss espiritual que começa a aparecer depois do décimo dia de sobrevivência. Ele é sempre escoltado por guardas zumbis aldeões. "
		""
		"**Mecânicas da Seita:** Ao receber o primeiro golpe, ele altera imediatamente o clima para Chuva para apagar incêndios e dificultar a sua vida. Dispara projéteis mágicos que fazem brotar Presas de Evocador do chão, e teletransporta-se de imediato quando tentam cercá-lo. Use o efeito Drenagem Mágica para bloquear a sua fuga!"
	]
	quest.290000000000000E.title: "O Missionário"
	quest.290000000000000F.quest_desc: [
		"Os totens dos sacerdotes."
		""
		"O Missionary e as estruturas das trevas contêm Amuletos (Charms) extremamente valiosos. Cada um requer Espíritos Etéreos (Ethereal Spirits) no inventário para ser carregado e ativado. Quando usado, concede 1 minuto de um buff absoluto!"
		""
		"• **Charm of Fury:** Dá-lhe Rampage Nível 2 e cura imediata."
		"• **Charm of Stealth:** Invisibilidade máxima."
		"• **Charm of Endurance:** Enche a saturação e dá velocidade."
	]
	quest.290000000000000F.title: "Os Amuletos de Poder"
	quest.2900000000000010.quest_desc: [
		"O núcleo canalizador de exércitos mortos."
		""
		"O **Orb of the Summoner** é dropado pelo Missionary ou pelo Supreme Bonescaller. Esta esfera poderosa é o ingrediente base para craftar os cajados mais fortes."
	]
	quest.2900000000000010.title: "O Orbe do Invocador"
	quest.2900000000000011.quest_desc: [
		"Na Dark Tower (Torre Sombria) encontrará as forjas proibidas."
		""
		"Derrote o Fallen Chaos Knight (imune a flechas) para obter o Molde (Smithing Template) necessário para forjar o metal das trevas."
	]
	quest.2900000000000011.title: "O Molde Caído"
	quest.2900000000000012.quest_desc: [
		"A coroa dos campeões! Existem 4 Chapéus únicos:"
		""
		"1. **Missionary Hat:** Invoca um esqueleto bebé aliado ao receber dano!"
		"2. **Spiritual Guide Sombrero:** Fortalece massivamente todos os esqueletos que você evocar."
		"3. **Lord Pumpkinhead's Hat:** Deixa-o imune a fogo e tira o tempo de recarga da Pumpkin Pistol!"
		"4. **Damned Demoman's Hat:** A MALDIÇÃO. Não pode ser retirado. Se a sua vida ficar baixa, VOCÊ DETONA E EXPLODE. Uma roleta russa na sua cabeça!"
	]
	quest.2900000000000012.title: "Os 4 Chapéus Místicos"
	quest.2900000000000013.quest_desc: ["Protege a sua mente contra a magia caótica e o efeito Wither."]
	quest.2900000000000013.title: "Elmo de Metal Negro"
	quest.2900000000000014.quest_desc: [
		"A peça central da fúria."
		""
		"Combinar o set completo garante imunidade a Wither. Mas a genialidade reside no **Modo Rampage**: Se a sua vida cair abaixo de 3 corações, você ganha instantaneamente Nível 5 de Rampage (+15 de Dano base e +100% de Velocidade de Movimento)! Você torna-se o monstro."
	]
	quest.2900000000000014.title: "Peitoral de Metal Negro"
	quest.2900000000000015.quest_desc: ["Forjadas nas forjas sombrias para suportar os impactos de golens e titãs."]
	quest.2900000000000015.title: "Calças de Metal Negro"
	quest.2900000000000016.quest_desc: ["Passos pesados de ferro, imunes à decomposição das areias do nether."]
	quest.2900000000000016.title: "Botas de Metal Negro"
	quest.2900000000000021.quest_desc: [
		"O caçador que você não consegue ver."
		""
		"A partir da terceira noite, um som aterrorizante rasgará o ar. O **Nightmare Stalker** caminha invisível. Apenas os seus olhos flutuam na escuridão. O seu olhar causa Cegueira e Wither."
	]
	quest.2900000000000021.title: "O Espreitador Invisível"
	quest.2900000000000022.quest_desc: ["Peles podres e crânios fantasmagóricos formam a base da armadura arcana do mod."]
	quest.2900000000000022.title: "Despojos do Pesadelo"
	quest.2900000000000023.quest_desc: ["O Capuz do Pesadelo permite-lhe enxergar e mover-se incrivelmente rápido na ausência de luz!"]
	quest.2900000000000023.title: "Capuz do Pesadelo"
	quest.2900000000000024.quest_desc: [
		"O manto mestre do mago das trevas."
		""
		"Vestir o set Nightmare Chestplate amplifica o poder e reduz absurdamente o tempo de recarga (Cooldown) de TODAS as armas mágicas do mod, como a Foice e as Pistolas de Abóbora!"
	]
	quest.2900000000000024.title: "Veste do Pesadelo"
	quest.2900000000000025.quest_desc: ["Costurada com pele de monstros, protege contra as maldições da noite."]
	quest.2900000000000025.title: "Calças do Pesadelo"
	quest.2900000000000026.quest_desc: ["Passos furtivos e silenciosos como o próprio caçador invisível."]
	quest.2900000000000026.title: "Botas do Pesadelo"
	quest.2900000000000027.quest_desc: [
		"O ceifador implacável."
		""
		"A **Nightmare Scythe** causa Cegueira e Wither, e drena a vida dos inimigos para curá-lo a cada golpe! Golpear chefes mágicos com esta foice impede-os temporariamente de se teletransportarem ou invocarem lacaios!"
	]
	quest.2900000000000027.title: "A Foice dos Sonhos"
	quest.2900000000000031.quest_desc: [
		"A seita espalha-se pela noite."
		""
		"O **Missionary** é um mini-boss espiritual que altera o clima para Chuva ao ser atacado (para apagar os seus fogos e dificultar a visão). Teletransporta-se constantemente. Use armas de Drenagem Mágica para o prender no lugar!"
	]
	quest.2900000000000031.title: "O Missionário"
	quest.2900000000000032.quest_desc: [
		"O núcleo canalizador."
		""
		"O Orb of the Summoner é a gema necessária para os grandes cajados do mod."
	]
	quest.2900000000000032.title: "Orbe do Invocador"
	quest.2900000000000033.quest_desc: ["O **Bonescaller Staff** permite-lhe invocar exércitos de esqueletos bebés aliados que dizimam monstros e desaparecem após 1 minuto!"]
	quest.2900000000000033.title: "A Magia da Seita"
	quest.2900000000000041.quest_desc: [
		"O bebedor de almas corrompido."
		""
		"O **Lifestealer** regenera pedaços massivos de saúde ao atingir você. Use ataques em área e explosivos para negar a cura vampírica dele."
	]
	quest.2900000000000041.title: "O Sugador de Vidas"
	quest.2900000000000042.quest_desc: [
		"O arsenal alquímico do caos."
		""
		"Use o seu Dark Atrium e outros reagentes arcanos para criar um arsenal de arremessáveis destrutivos:"
		"• **Phantom Bomb:** Explode e divide-se em mais DUAS bombas menores!"
		"• **Intoxicating Bomb:** Uma granada de gás venenoso e náusea."
		"• **Stimulating Bomb:** Granada de controle com efeitos em área."
	]
	quest.2900000000000042.title: "As Bombas do Caos"
	quest.2900000000000043.quest_desc: [
		"O coração arcano das trevas."
		""
		"O Dark Atrium é um núcleo orgânico e sombrio obtido das criaturas mais vis. Ele serve como base alquímica para forjar os explosivos do caos."
	]
	quest.2900000000000043.title: "O Átrio Sombrio"
	quest.2900000000000051.quest_desc: [
		"Os litorais também são brutais."
		""
		"Cace os caranguejos e obtenha a carapaça de espinhos."
	]
	quest.2900000000000051.title: "Carapaça Espinhosa"
	quest.2900000000000052.quest_desc: ["O elmo da retaliação passiva. Devolve parte do dano recebido diretamente aos atacantes corpo a corpo!"]
	quest.2900000000000052.title: "Elmo Espinhoso"
	quest.2900000000000053.quest_desc: [
		"O Peitoral da Vingança."
		""
		"Combinado com o elmo, reflete danos imensos (com encantamento Thorns, chega a devolver 10 de dano) e garante-lhe imunidade total às armadilhas de concha."
	]
	quest.2900000000000053.title: "Peitoral Espinhoso"
	quest.2900000000000061.quest_desc: [
		"A lâmina que condena as almas."
		""
		"A evolução letal da espada Soul Saber. Ela aplica 'Estratificação de Alma' e Fogo Infernal simultaneamente, dizimando chefes com grandes poças de vida."
	]
	quest.2900000000000061.title: "Perdição das Almas"
	quest.2900000000000062.quest_desc: [
		"Magia pura da plantação maldita."
		""
		"O Pumpkin Staff é um cajado de poder absurdo que atira abóboras explosivas em área, varrendo hordas de monstros num piscar de olhos."
	]
	quest.2900000000000062.title: "Cajado de Abóbora"
	quest.2900000000000063.quest_desc: [
		"A arma de fogo do Lorde."
		""
		"A Pumpkin Pistol dispara tiros flamejantes instantâneos. Combinada com o 'Lord Pumpkinhead's Hat', ela perde todo o tempo de recarga!"
	]
	quest.2900000000000063.title: "Pistola de Abóbora"
	quest.2900000000000064.quest_desc: [
		"A pólvora das trevas."
		""
		"Para descarregar a fúria da Pumpkin Pistol, você precisará fabricar e carregar estas Pumpkin Bullets (Balas de Abóbora) no seu inventário."
	]
	quest.2900000000000064.title: "Munição Infernal"
	quest.2900000000000071.quest_desc: [
		"Os doces do submundo obtidos nos Presentes Assustadores!"
		""
		"O Holiday Candy normal regenera barras inteiras de fome, mas o **Magical Holiday Candy** é uma iguaria absoluta, permitindo comer a qualquer momento (mesmo de barriga cheia) e curando a sua exaustão num instante."
	]
	quest.2900000000000071.title: "Os Doces Mágicos"
	quest.2900000000000072.quest_desc: [
		"Tesouros perdidos do caos."
		""
		"Ao explorar o mundo e abrir baús de loot, você pode deparar-se com estes três Easter Eggs bizarros (Rotten, Spiritual e Monstrous). Cada um deles guarda segredos e recompensas temáticas baseadas na sua origem profana!"
	]
	quest.2900000000000072.title: "Os Ovos Sombrios"
	quest.2900000000000073.quest_desc: [
		"A imortalidade tem um preço."
		""
		"O Death Totem salva-o da morte iminente, tal como o Totem da Imortalidade normal, curando-o rapidamente e dando-lhe força."
		""
		"Contudo, a penalidade do caos é severa: ele drena quase toda a sua fome (Saturação) e aplica 'Drenagem Mágica' (Magic Depletion), impedindo que você use magias defensivas ou até mesmo outro totem logo a seguir!"
	]
	quest.2900000000000073.title: "O Totem da Morte"
	quest.2901A5B0AA618D2A.title: "Alvo: Golden Hermit King"
	quest.2931DF2F37E4897C.quest_desc: [
		"Acenda e arremesse!"
		""
		"A Dinamite básica é perfeita para limpar grupos de monstros à distância ou abrir buracos em cavernas sem precisar sacrificar blocos inteiros (como a TNT faz)."
	]
	quest.2931DF2F37E4897C.title: "Dinamite Básica"
	quest.297CBF5D8BB2AE15.title: "Alvo: Basalt Executioner"
	quest.2981108DAF2FC1F2.quest_desc: [
		"A joia da coroa. O §6Tempad§r abre uma Time Door de bolso à sua frente."
		""
		"Ele armazena os seus cartões de localização e consome Chronons da sua Célula."
	]
	quest.2981108DAF2FC1F2.title: "O Portal de Bolso"
	quest.298CD309CFEFF21F.title: "Alvo: Forest Zombie"
	quest.29A48097B59D5167.title: "Exploração"
	quest.29BDA40454809F28.quest_desc: [
		"A ditadora do Vazio. Destrua os cristais antes de focar na criatura."
		""
		"A verdadeira jornada de um jogador de Minecraft culmina aqui, libertando The End do seu reinado."
	]
	quest.29BDA40454809F28.title: "Liberte o Fim"
	quest.29BF86840F91D2B1.quest_desc: ["Esqueça as fornalhas normais. A Forge (Forja de Icaria) é uma estação industrial onde a verdadeira metalurgia acontece. Use-a para derreter minérios brutos com mais eficiência e, principalmente, fundir dois metais diferentes em Ligas (Alloys) poderosas!"]
	quest.29BF86840F91D2B1.title: "A Forja Autêntica"
	quest.29CEA9B30480B57F.quest_desc: ["As chamas do inferno abrigam criaturas implacáveis. Defenda-se e consiga as varas de Blaze e as Lágrimas de Ghast."]
	quest.29CEA9B30480B57F.title: "O Bestiário Infernal"
	quest.29CEFD55BA72892F.title: "Alvo: Bogged Shadow"
	quest.29F1A15B7CB3B71D.quest_desc: [
		"Para capturar o mestre dos redemoinhos, crafte uma Peneira."
		""
		"Mantenha um Frasco de Vidro na mão para a próxima etapa."
	]
	quest.29F1A15B7CB3B71D.title: "A Peneira"
	quest.2A38E2B8A2B10058.title: "Alvo: Magic Skeleton"
	quest.2A6B9BAEA9C986DD.title: "Alvo: Zombified Cultist"
	quest.2A986EB7D4B5C37E.quest_desc: [
		"Inacreditável!"
		""
		"Você completou TODAS as 54 caçadas individuais do mural. Nenhum monstro, variante ou besta gigante escapou da sua lâmina."
		""
		"Receba o prêmio máximo da Guilda."
	]
	quest.2A986EB7D4B5C37E.title: "Mestre do Bestiário"
	quest.2AC710B9A58B9E98.title: "Alvo: Swamp Skeleton"
	quest.2AEAA325ABD4C066.quest_desc: [
		"O deus da destruição invocado pelos jogadores. Evocá-lo requer três crânios de Wither Skeleton e Areia das Almas."
		""
		"A Estrela do Nether é a chave para os Sinalizadores."
	]
	quest.2AEAA325ABD4C066.title: "O Murchar"
	quest.2AF633E6A6B7E675.title: "Lança de Diamante"
	quest.2B13576C6A9A5FB9.quest_desc: [
		"O folclore brasileiro não é mais apenas história para dormir. As florestas do Minecraft agora abrigam feras místicas e entidades mágicas."
		""
		"Prepare-se para explorar novos biomas, realizar trocas misteriosas e caçar as lendas para forjar equipamentos com habilidades únicas, como a Foice da Lua de Sangue (BloodMoon Sickle) e os Livros Mágicos."
	]
	quest.2B3C4D5E6F78901A.quest_desc: [
		"Bem-vindo à era da engenharia! No Create, quase tudo exige a Liga de Andesito (Andesite Alloy). "
		""
		"Misture Andesito com Pepitas de Ferro ou Zinco. Este é o seu primeiro passo para a automação."
	]
	quest.2B3C4D5E6F78901A.title: "A Era das Engrenagens"
	quest.2B665CEB007FA3E9.quest_desc: ["Minério muito encontrado nas cavernas e utilizado em vastas areas da sua aventura."]
	quest.2B665CEB007FA3E9.title: "Era do cobre"
	quest.2B952BB56A01EE71.title: "Alvo: Swamp Zombie"
	quest.2BD8F20E3578A0E2.quest_desc: [
		"Um dispositivo simples de marcação rápida. O §3Chronomark§r funciona como um relógio salva-vidas."
		""
		"Marque uma localização antes de iniciar um combate perigoso. Se a situação apertar, ative-o para retornar rapidamente."
	]
	quest.2BD8F20E3578A0E2.title: "Ponto de Retorno Rápido"
	quest.2BEDB184EAF1F1B2.title: "Alvo: Pottergeist"
	quest.2C22FDA96B765C21.title: "Alvo: Frigid Gator"
	quest.2C48C96E35A74606.quest_desc: ["Variante de Diamante. Excelente dano e durabilidade."]
	quest.2C48C96E35A74606.title: "Chakram de Diamante"
	quest.2C557741B52B37B1.quest_desc: [
		"Nos Cânions, habitam pequenas e fofas criaturas chamadas Sparkles."
		""
		"§bMecânica Única:§r Se você pegar uma Picareta e clicar com o botão direito na cauda brilhante deles, você extrai o cristal sem machucá-los! O cristal demora alguns minutos para crescer de novo, mas você pode acelerar o processo alimentando o Sparkle com Glow Lichen (Líquen Brilhante)."
	]
	quest.2C557741B52B37B1.title: "O Pecuária de Cristais"
	quest.2C62D1A82B8FA5E9.title: "Grande Katana de Ouro"
	quest.2C66122B692C9A01.title: "Alvo: Moss Zombie"
	quest.2C980BD540713D27.quest_desc: ["Ele não deveria ser caçado. Ele não enxerga, mas escuta cada passo seu. Aventure-se nas Cidades Ancestrais e enfrente o pesadelo de Sculk face a face."]
	quest.2C980BD540713D27.title: "O Eco do Pesadelo"
	quest.2CA394741E3D93A9.title: "Alvo: Moss Zombie"
	quest.2CC3215A42C35B66.title: "Alvo: Snow Zombie"
	quest.2D205EC68668B69E.quest_desc: ["A obra-prima do inferno. Prepare o imponente Hoglin Recheado (Stuffed Hoglin) assado inteiro nas chamas. A carne dele fumegante é capaz de encher a barra de saturação de vários jogadores que estiverem minerando quartzo ou lutando contra Piglins."]
	quest.2D205EC68668B69E.title: "Banquete Diabólico"
	quest.2D3C126F50075721.title: "Alvo: Vile Gator"
	quest.2D57785585D884A9.title: "Alvo: Mushlin Bumper"
	quest.2D5B59684D3122D1.title: "Alvo: Scarecrow"
	quest.2D853F2196DD1222.title: "Alvo: Witchdoctor"
	quest.2D8EE88059720545.title: "Rapieira de Ouro"
	quest.2DB143A802BECE9E.quest_desc: [
		"O auge da engenharia do mod."
		""
		"O Laser de Rubi emite um feixe invisível que atravessa o ar. Ele envia um sinal de Redstone toda vez que uma entidade ou bloco cruzar o caminho! A força do sinal depende do quão perto a pessoa passou da base do laser."
	]
	quest.2DB143A802BECE9E.title: "Sensor de Movimento a Laser"
	quest.2DB80A0397C9732A.title: "Arma Abissal"
	quest.2DBCBAFBF7704B31.title: "Bastão de Ouro"
	quest.2DFBE209990DE067.title: "Alvo: Snow Zombie"
	quest.2E273C4F80F6DDC0.title: "Khopesh de Ouro"
	quest.2E3A16DE775D1EF9.quest_desc: [
		"Uma fera metamorfa com corpo humanoide e cabeça de tamanduá/lobo. O Capelobo é implacável."
		""
		"§eComo Encontrar:§r Ele não aparece andando livremente de dia. Para enfrentar essa lenda, você precisa realizar um pequeno ritual clicando com o botão direito numa Fogueira das Almas (Soul Campfire)!"
	]
	quest.2E3A16DE775D1EF9.title: "O Ritual do Capelobo"
	quest.2E4837E5E873FC61.quest_desc: ["Você pediu a lista completa, caçador. Aqui estão as 54 ameaças isoladas da Série Luminous. Elas foram separadas em 4 colunas. Todas estão liberadas: cace-os na ordem que os encontrar pelo mundo!"]
	quest.2E4837E5E873FC61.title: "O Fichário Completo"
	quest.2E630A25EAB70745.title: "Alvo: Tree Ent"
	quest.2E7B04BA0CD87F18.title: "Alvo: Yeti"
	quest.2E84F6097B1A0F97.title: "Alvo: Phoenix"
	quest.2EADE1D83B56A564.title: "Alvo: Forest Skeleton"
	quest.2EBCBF44B0617631.quest_desc: ["Variante de Diamante. Excelente dano e durabilidade."]
	quest.2EBCBF44B0617631.title: "Grão-Martelo de Diamante"
	quest.2EDF65CB357CF9AF.quest_desc: [
		"O Artefato Supremo do Multiverso."
		""
		"O §eHe Who Remains Tempad§r é um loot raro de End Cities. Custo ZERO de energia e ZERO tempo de recarga. Absoluto."
	]
	quest.2EDF65CB357CF9AF.title: "Aquele Que Permanece"
	quest.2F08E4C43728EED8.title: "Alvo: Crab"
	quest.2F1D49CC0B5B7CA5.quest_desc: ["A gravidade em um item. Criado ao colapsar milhares de itens no Condensador de Matéria."]
	quest.2F1D49CC0B5B7CA5.title: "A Singularidade"
	quest.2F4B448315DD1716.title: "Primeira Arma"
	quest.2F522954209E020B.quest_desc: ["Encontre o Molde em estruturas do Overworld ou crafte a sua cópia."]
	quest.2F522954209E020B.title: "Molde: Peridoto"
	quest.2F849274F719A2AE.quest_desc: [
		"A Bruxa do Pântano com rosto de jacaré."
		""
		"A Cuca é uma entidade neutra! Ela não te atacará a menos que você a provoque. Você pode usar pergaminhos (Strange Trade Scroll) para realizar trocas valiosas com ela, ou pode arriscar a própria vida enfrentando-a para saquear seus itens."
	]
	quest.2F849274F719A2AE.title: "A Feiticeira Jacaré"
	quest.2F935ADBA3E0D6B0.title: "Alvo: Phoenix"
	quest.2FAB272E0C46A492.quest_desc: ["Encontrado exclusivamente na Floresta Carmesim (Nether), escondido sob a lava."]
	quest.2FAB272E0C46A492.title: "Cristal: Rubi"
	quest.3000000000000001.quest_desc: [
		"Uma pausa para a paz e a fofura!"
		""
		"Explore os biomas de Pântano (e às vezes Florestas Escuras ou Taigas) para encontrar as Vilas Ribbit. Elas são compostas por lindas casas em formato de cogumelo habitadas por pequenos e simpáticos sapos bípodes."
		""
		"**A Nova Economia:**"
		"Esqueça as esmeraldas! Os Ribbits não ligam para elas. A moeda oficial desta vila são os **Fragmentos de Ametista** (Amethyst Shards). Guarde os seus cristais roxos para negociar as maravilhas do pântano com eles!"
	]
	quest.3000000000000001.title: "A Vila dos Sapos"
	quest.3000000000000002.quest_desc: [
		"O protetor mágico da vila."
		""
		"Procure pelos Ribbits Feiticeiros (Sorcerers) que vivem nas torres altas de cogumelo. Eles são incrivelmente gentis! De tempos em tempos, eles atiram poções benéficas gratuitamente nos jogadores que se aproximam, garantindo buffs como Super Pulo (Jump Boost), Velocidade ou Força."
	]
	quest.3000000000000002.title: "O Feiticeiro"
	quest.3000000000000003.quest_desc: [
		"O seu novo melhor amigo na agricultura."
		""
		"O Ribbit Jardineiro adora cuidar das plantas. Ter um (ou vários) destes perto das suas plantações é excelente, pois eles aplicam o efeito de Farinha de Osso (Bone Meal) nas colheitas próximas, acelerando o crescimento de forma automática e natural!"
	]
	quest.3000000000000003.title: "O Jardineiro"
	quest.3000000000000004.quest_desc: [
		"O mestre das águas turvas."
		""
		"O Ribbit Pescador senta-se na beira da água com uma vara de pescar (que tem uma física incrivelmente bem feita e balança!). Pode trocar as suas Ametistas com ele. Dica de ouro: se tiver sorte nas trocas, ele pode vender-lhe Baldes com Axolotes!"
	]
	quest.3000000000000004.title: "O Pescador"
	quest.3000000000000005.quest_desc: [
		"O viajante que traz as maravilhas botânicas."
		""
		"Procure pelo Mercador (Merchant) na vila. Ele carrega uma mochilinha e possui um catálogo rotativo de itens exclusivos do mod que você pode comprar em troca dos seus fragmentos de Ametista!"
	]
	quest.3000000000000005.title: "O Comerciante"
	quest.3000000000000006.quest_desc: [
		"A solução mais adorável para evitar danos de queda!"
		""
		"A Umbrella Leaf (Folha Guarda-Chuva) pode ser comprada no mercador. Se você cair de um lugar alto, basta segurá-la para planar suavemente até ao chão, exatamente como os sapinhos fazem quando pulam das suas torres!"
	]
	quest.3000000000000006.title: "Folha Guarda-Chuva"
	quest.3000000000000007.quest_desc: [
		"Flora e iluminação exclusivas."
		""
		"Adquira as incríveis Swamp Lanterns (Lanternas do Pântano), que podem ser penduradas de cabeça para baixo ou pousadas no chão. Também pode arranjar as Lush Lily Pads, que são vitórias-régias lindas e enormes sobre as quais você pode caminhar livremente pelas águas."
	]
	quest.3000000000000007.title: "Decoração do Pântano"
	quest.3000000000000008.quest_desc: [
		"A mecânica mais incrível e genial deste mod!"
		""
		"Se você comprar as **Maracas** e começar a tocá-las perto de Ribbits normais (ou se eles ficarem muito entediados), a mágica acontece:"
		""
		"Eles vão juntar-se em grupos de até 4, sacar instrumentos reais (Bateria, Violoncelo, Flauta e Violão clássico) e começar a tocar uma música 100% sincronizada! Se um sapo se afastar, a música para, e ele corre de volta para o grupo para continuarem o concerto. É de aquecer o coração!"
	]
	quest.3000000000000008.title: "A Sinfonia Musical"
	quest.3000000000000009.quest_desc: ["A mistura perfeita para a carcaça dos maquinários elétricos."]
	quest.3000000000000009.title: "A Base do Latão"
	quest.300000000000000B.quest_desc: ["Esta máquina especial puxa lingotes e placas, afinando-os até virarem arames finíssimos."]
	quest.300000000000000B.title: "O Moinho de Rolos"
	quest.300000000000000D.quest_desc: ["Fio de cobre. Transmite energia FE, mas tem perda em longas distâncias."]
	quest.300000000000000D.title: "Fiação Básica"
	quest.300000000000000F.quest_desc: ["Fio de ouro. Sem perdas e transfere grandes pacotes de energia."]
	quest.300000000000000F.title: "Fiação de Alta Tensão"
	quest.3000000000000011.quest_desc: ["A ferramenta essencial. Clique com ela em dois conectores para puxar o fio entre eles."]
	quest.3000000000000011.title: "O Carretel (Spool)"
	quest.3000000000000013.quest_desc: ["Coloque isso nas máquinas de outros mods (como o AE2) para injetar a energia elétrica neles."]
	quest.3000000000000013.title: "Conector Estático"
	quest.3000000000000015.quest_desc: ["A ponte de ida! Conecte as rodas d'água do Create na base dele, e ele gerará Eletricidade (FE) no topo. Ligue um fio e espalhe!"]
	quest.3000000000000015.title: "O Alternador (Geração)"
	quest.3000000000000017.quest_desc: ["A ponte de volta! Injete eletricidade nele por um fio, e o eixo dele começará a girar. Perfeito para automatizar máquinas longe dos rios sem precisar fazer dezenas de eixos."]
	quest.3000000000000017.title: "Motor Elétrico (Consumo)"
	quest.3000000000000019.quest_desc: ["O Accumulator. Você pode montar um cubo gigante juntando vários desses para armazenar milhões de RF para quando o vento parar ou a água secar."]
	quest.3000000000000019.title: "Banco de Baterias"
	quest.300000000000001B.quest_desc: ["Entrando no mod New Age. As Carbon Brushes são usadas para raspar e coletar energia de geradores em rotação."]
	quest.300000000000001B.title: "Coletor Estático"
	quest.300000000000001D.quest_desc: ["Uma pedra magnética maciça. É o coração de uma usina hidrelétrica avançada. Faça girar rápido!"]
	quest.300000000000001D.title: "O Magneto (Rotor)"
	quest.300000000000001F.quest_desc: ["Coloque essas bobinas AO REDOR do bloco de Magnetita que está girando. Elas captarão a alteração do campo magnético e gerarão energia insana!"]
	quest.300000000000001F.title: "Bobina Geradora (Estator)"
	quest.3000000000000021.quest_desc: ["Tubos de calor. Transmitem temperaturas extremas (de lava ou caldeiras) sem deixar o bloco esquentar por fora."]
	quest.3000000000000021.title: "Termodinâmica"
	quest.3000000000000023.quest_desc: ["Placas solares que aquecem os tubos de calor durante o dia. Energia 100% passiva e limpa!"]
	quest.3000000000000023.title: "Energia Solar Básica"
	quest.3000000000000025.quest_desc: ["O Energiser. Jogue muita, MAS MUITA eletricidade nele, e coloque um minério embaixo. O laser vai sobrecarregar o material, criando metais fundidos impossíveis na natureza!"]
	quest.3000000000000025.title: "Laser Energético"
	quest.3000000000000101.quest_desc: [
		"O subsolo guarda segredos que não deveriam ser perturbados. Para iniciar sua jornada nas anomalias de Qliphoth, você precisará coletar os fragmentos de energia corrompida."
		""
		"§cAviso de Preparação:§r"
		"Não desça sem no mínimo uma armadura de Diamante/Netherite encantada. Os inimigos que guardam esses cristais batem forte."
	]
	quest.3000000000000101.title: "A Raiz da Corrupção"
	quest.3000000000000102.quest_desc: [
		"Com os fragmentos em mãos, você pode forjar a Balança e o Astrolábio. Estes não são apenas itens decorativos, mas as ferramentas que alinharão as dimensões para você."
		""
		"Construa uma base segura usando os blocos escuros da dimensão para proteger seu altar."
	]
	quest.3000000000000102.title: "Ferramentas do Oculto"
	quest.3000000000000103.quest_desc: [
		"O Olho Esmeralda. Ele rastreia e abre o portal para o Covil do Verme Mecânico."
		""
		"§eDica de Combate:§r"
		"Este chefe se move rapidamente. Armas do 'Simply Swords' com alcance (Reach) maior, ou um bom arco com flechas explosivas serão seus melhores amigos. Traga poções de velocidade!"
	]
	quest.3000000000000103.title: "Visão do Verme"
	quest.3000000000000104.quest_desc: ["Você sobreviveu à fúria mecânica. A carcaça dessa besta prova sua força."]
	quest.3000000000000104.title: "Sucata Gigante"
	quest.3000000000000105.quest_desc: [
		"O Olho do Vazio (Roxo). A chave para acessar o domínio do Cubo Aracnídeo."
		""
		"§eDica de Combate:§r"
		"Entidades do vazio geralmente causam efeitos de status terríveis. Se você tiver um amuleto que remova debuffs (como do Artifacts ou Relics), equipe-o agora. Escudos são vitais."
	]
	quest.3000000000000105.title: "Visão do Vazio"
	quest.3000000000000106.quest_desc: ["A geometria do caos foi quebrada. O núcleo da aranha cibernética é seu."]
	quest.3000000000000106.title: "Colapso Geométrico"
	quest.3000000000000107.quest_desc: [
		"O Olho do Triunfo (Ciano). Invoca o Guardião, a entidade máxima de Qliphoth."
		""
		"§eDica de Combate:§r"
		"Este é o desafio final. Ele usa ataques corpo-a-corpo devastadores. Prepare poções de Força II, Regeneração, e tenha suas armas mais fortes do pack totalmente reparadas."
	]
	quest.3000000000000107.title: "Visão do Guardião"
	quest.3000000000000108.quest_desc: ["Você derrubou o Guardião de Qliphoth. A dimensão agora reconhece o seu poder."]
	quest.3000000000000108.title: "A Queda do Rei"
	quest.3000000000000109.quest_desc: [
		"Tendo derrotado os três lordes mecânicos-sombrios, você reuniu os materiais necessários para forjar a Manopla."
		""
		"O poder absoluto de Qliphoth agora está literalmente nas suas mãos."
	]
	quest.3000000000000109.title: "O Poder Absoluto"
	quest.3000000000000201.quest_desc: [
		"O universo de Qliphoth Awakening possui dimensões seladas, guardadas por entidades de imenso poder: As Sephiroth Invertidas."
		""
		"Para acessar as arenas de cada um desses chefes (Chesed, Malkuth e Geburah), você precisa craftar o olho correspondente e §eclicar com o botão direito do mouse no ar§r. Isso te teletransportará instantaneamente para a dimensão deles."
		""
		"§cAviso:§r Prepare-se muito bem antes de clicar. Não há volta fácil."
	]
	quest.3000000000000201.title: "Bem-vindo a Qliphoth"
	quest.3000000000000202.quest_desc: [
		"O primeiro guardião que você deve desafiar. Crafte o Olho de Chesed e segure-o firme."
		""
		"Ao clicar com o botão direito, você será puxado para a dimensão de Chesed. Esteja pronto para intensas mecânicas de esquiva e poderosos ataques em área."
	]
	quest.3000000000000202.title: "Visão da Misericórdia Distorcida"
	quest.3000000000000203.quest_desc: [
		"A arena caiu em silêncio. Chesed foi derrotado."
		""
		"Você agora possui o Troféu de Chesed. Se teve sorte, também conseguiu a cobiçada §bPhase Sphere§r, que te permite atravessar paredes e terrenos sólidos!"
	]
	quest.3000000000000203.title: "A Queda de Chesed"
	quest.3000000000000204.quest_desc: [
		"O segundo desafio é Malkuth. Seu olho te levará a uma dimensão brutal."
		""
		"Malkuth é infame pelos seus combos corpo-a-corpo implacáveis. Ter uma defesa extremamente alta e reflexos rápidos são essenciais. Clique com o botão direito no olho para entrar."
	]
	quest.3000000000000204.title: "Visão do Reino Sombrio"
	quest.3000000000000205.quest_desc: [
		"Você sobreviveu à velocidade assustadora de Malkuth e reivindicou o seu troféu."
		""
		"Sua verdadeira recompensa pode ser a §cEmberfrost Gauntlet§r, uma arma que funciona como gancho para atrair entidades e realizar esmagamentos devastadores nos blocos!"
	]
	quest.3000000000000205.title: "O Domínio de Malkuth"
	quest.3000000000000206.quest_desc: [
		"O ápice da dificuldade: Geburah. O olho te lançará em uma das lutas mais difíceis e recompensadoras do modpack."
		""
		"A arena de Geburah não perdoa erros. Tenha poções preparadas, a melhor armadura de combate corpo a corpo que puder forjar e foco absoluto. Clique no olho apenas quando estiver 100% pronto."
	]
	quest.3000000000000206.title: "Visão da Severidade"
	quest.3000000000000207.quest_desc: [
		"Inacreditável. Você superou a provação de Geburah e obteve o troféu máximo."
		""
		"Com o poder da Severidade ao seu lado, você agora deve ter acesso aos itens de evocação das mini-torretas de Geburah para lutar ao seu lado."
	]
	quest.3000000000000207.title: "A Queda do Mais Forte"
	quest.3000000000000208.quest_desc: [
		"Chesed, Malkuth e Geburah caíram perante você. As dimensões caóticas de Qliphoth agora reconhecem o seu poder incontestável."
		""
		"Parabéns por dominar as anomalias do universo."
	]
	quest.3000000000000301.quest_desc: [
		"As dimensões seladas de Qliphoth abrigam três lordes cabalísticos: Chesed, Malkuth e Geburah."
		""
		"Para enfrentá-los, crafte o Olho respectivo e §eclique com o botão direito do mouse no ar§r para ser teleportado para a arena deles."
		""
		"Esses deuses não apenas dropam troféus, mas seus Núcleos (Cores) e Armas que detêm o poder de alterar as leis da física no Minecraft."
	]
	quest.3000000000000302.quest_desc: ["Crafte o Olho de Chesed e segure firme. Ao clicar com o botão direito, você será puxado para a dimensão do primeiro lorde."]
	quest.3000000000000302.title: "Visão de Chesed"
	quest.3000000000000303.quest_desc: [
		"Chesed caiu. Do seu corpo, você extraiu o Troféu e o §eLighting Core§r."
		""
		"O Lighting Core pulsa com energia de luz e sculk pura, a força motriz das mecânicas dessa dimensão."
	]
	quest.3000000000000303.title: "A Luz Corrompida"
	quest.3000000000000304.quest_desc: [
		"Sua recompensa suprema por abater Chesed: a §bPhase Sphere§r."
		""
		"Assim como a vibração do sculk se move pelo chão, esta esfera permite que você viaje através de terrenos sólidos sem qualquer obstrução! Use-a para atravessar paredes de masmorras ou montanhas em segundos."
	]
	quest.3000000000000304.title: "Domínio do Terreno"
	quest.3000000000000305.quest_desc: ["O segundo desafio. O Olho de Malkuth te jogará em uma arena térmica. Prepare-se para lutar por sua vida."]
	quest.3000000000000305.title: "Visão de Malkuth"
	quest.3000000000000306.quest_desc: [
		"Você dominou a tempestade de golpes. Obtenha seu troféu e o §cIce and Fire Core§r."
		""
		"Este núcleo instável contém as temperaturas extremas que Malkuth usou contra você."
	]
	quest.3000000000000306.title: "Choque Térmico"
	quest.3000000000000307.quest_desc: [
		"Você agora possui a terrível §cEmberfrost Gauntlet§r. Ela herda os combos de Malkuth."
		""
		"§eComo usar:§r"
		"- §bMão Direita:§r Gancho em blocos. Te puxa e cria um esmagamento devastador ao aterrissar."
		"- §cMão Esquerda:§r Gancho em entidades. Te puxa para o alvo, aplica um ataque automático e te joga para trás na segurança."
		""
		"§dDICA PRO:§r Trocar a manopla entre a mão direita e esquerda reseta o cooldown instantaneamente. Combe infinitamente!"
	]
	quest.3000000000000307.title: "Combos Infinitos"
	quest.3000000000000308.quest_desc: ["O Ápice da Severidade. Não clique com o botão direito neste Olho a menos que você tenha as melhores armaduras do pack."]
	quest.3000000000000308.title: "Visão de Geburah"
	quest.3000000000000309.quest_desc: [
		"O deus da Severidade tombou perante a sua força bruta."
		""
		"Pegue o Troféu e o incrivelmente denso §6Justice Core§r, o núcleo responsável pelo julgamento implacável da arena."
	]
	quest.3000000000000309.title: "Severidade e Julgamento"
	quest.3000000000000310.quest_desc: [
		"A arma final de Geburah. O §6Divine Gear§r não é uma espada, é um exército portátil."
		""
		"Ao usar este item, você invoca pequenas torretas (seus próprios 'mini-Geburahs'). Elas atacarão automaticamente os inimigos ao redor e, o melhor de tudo: §epriorizam o último alvo que você atacou§r. Perfeito para derreter outros chefes!"
	]
	quest.3000000000000310.title: "Exército de um Homem Só"
	quest.3000000000000311.quest_desc: [
		"Você coletou as Armas Supremas e os Núcleos de poder de Chesed, Malkuth e Geburah."
		""
		"Você não é mais um sobrevivente; você é uma anomalia em pé de igualdade com as entidades que destruiu."
	]
	quest.3006ADDF1BE16B2E.quest_desc: ["Forjado nas chamas e detritos. A liga metálica mais forte do jogo."]
	quest.301A260E704E9346.quest_desc: ["Variante de Diamante. Excelente dano e durabilidade."]
	quest.301A260E704E9346.title: "Alabarda de Diamante"
	quest.30409C4A9E81218A.quest_desc: ["Minere Peridoto no subsolo do Overworld (geralmente sob florestas e Lush Caves)."]
	quest.30409C4A9E81218A.title: "Cristal: Peridoto"
	quest.308A6D644668D149.quest_desc: [
		"O TNT Vanilla é muito caótico. Ele destrói minérios e estraga construções."
		""
		"Com o Dynamites Overhaul, você vai usar o TNT como base para criar explosivos muito mais precisos e amigáveis para mineração."
	]
	quest.308A6D644668D149.title: "O Fim do Caos"
	quest.309A4EE78086A8C0.title: "Lâmina Invertida de Ouro"
	quest.30B06C9125444EC2.quest_desc: ["O conhecimento dos processadores veio do espaço. Siga a bússola até encontrar uma cratera de meteorito."]
	quest.30B06C9125444EC2.title: "Bússola de Meteorito"
	quest.30D869272800A493.title: "Alvo: Cave Zombie"
	quest.30F7F409B28FFD4D.title: "Alvo: Forest Zombie"
	quest.3100000000000001.quest_desc: [
		"A clarividência mineral começa aqui!"
		""
		"O PotionMaster permite que crie poções para ver minérios através das paredes. Mas não pode simplesmente atirar um minério para um suporte de poções."
		""
		"O seu primeiro passo é fabricar o **Pilão (Pestle)**. Esta ferramenta não se gasta com o uso e servirá para esmagar os minérios numa bancada de trabalho, transformando-os em pó bruto."
	]
	quest.3100000000000001.title: "A Arte da Moagem"
	quest.3100000000000002.quest_desc: [
		"O segredo da extração perfeita."
		""
		"Depois de juntar o seu Pilão com um minério na bancada de trabalho para obter o Pó do Minério (Ore Powder), a magia ainda não está pronta!"
		""
		"Tem de levar esse pó até uma **Fornalha** e assá-lo. O resultado será o **Pó Calcinado (Calcinated Powder)**. Só este pó purificado a altas temperaturas pode ser destilado com Poções Estranhas (Awkward Potions) para lhe conceder a visão de Raio-X legalizada!"
	]
	quest.3100000000000002.title: "A Purificação pelo Fogo"
	quest.3100000000000003.quest_desc: [
		"O combustível básico revelado."
		""
		"Destile este pó numa Poção Estranha (Awkward Potion) para criar a **CoalSight Potion**. Ideal para quando precisa de abastecer rapidamente a sua base com combustível e não quer escavar pedra inútil."
	]
	quest.3100000000000003.title: "Pó de Carvão Calcinado"
	quest.3100000000000004.quest_desc: [
		"A era da eletricidade e do bronze."
		""
		"A **CopperSight Potion** iluminará todos os veios de cobre ao seu redor. Perfeito para quem usa mods de tecnologia ou adora construções industriais."
	]
	quest.3100000000000004.title: "Pó de Cobre Calcinado"
	quest.3100000000000005.quest_desc: [
		"A espinha dorsal de qualquer império."
		""
		"Produza a **IronSight Potion** e todo o ferro nas cavernas brilhará com uma aura intensa. A sua falta de equipamento de ferro acabou agora mesmo."
	]
	quest.3100000000000005.title: "Pó de Ferro Calcinado"
	quest.3100000000000006.quest_desc: [
		"A riqueza brilhante."
		""
		"A **GoldSight Potion** é excelente para juntar ouro rapidamente, seja para maçãs douradas, negociações com Piglins ou troca de moedas."
	]
	quest.3100000000000006.title: "Pó de Ouro Calcinado"
	quest.3100000000000007.quest_desc: [
		"A luz no inferno."
		""
		"O Pó Calcinado de Quartzo permite-lhe criar a **QuartzSight Potion**. Facilita imenso a recolha rápida de experiência e de materiais brancos de construção no Nether."
	]
	quest.3100000000000007.title: "Pó de Quartzo Calcinado"
	quest.3100000000000008.quest_desc: [
		"A fonte da magia."
		""
		"Sem Lápis-Lazúli, não há encantamentos. A **LapisSight Potion** guia-o direto à fonte da magia azul nas profundezas das cavernas."
	]
	quest.3100000000000008.title: "Pó de Lápis Calcinado"
	quest.3100000000000009.quest_desc: [
		"O sangue das máquinas."
		""
		"Precisar de dezenas de packs de Redstone para circuitos lógicos já não será um pesadelo graças à **RedstoneSight Potion**."
	]
	quest.3100000000000009.title: "Pó de Redstone Calcinado"
	quest.310000000000000A.quest_desc: [
		"O monopólio do mercado."
		""
		"Encontrar esmeraldas nas montanhas costuma ser difícil, mas a **EmeraldSight Potion** transformá-lo-á no jogador mais rico das vilas."
	]
	quest.310000000000000A.title: "Pó de Esmeralda Calcinado"
	quest.310000000000000B.quest_desc: [
		"O sonho de todo o mineiro."
		""
		"Moe, asse e destile! A **DiamondSight Potion** permite-lhe ver diamantes através das paredes na camada das ardósias (Deepslate). A sua busca pela armadura perfeita acabou de se tornar mil vezes mais rápida."
	]
	quest.310000000000000B.title: "Pó de Diamante Calcinado"
	quest.310000000000000C.quest_desc: [
		"O terror do Nether foi domado."
		""
		"O supremos dos pós! A **NetheriteSight Potion** acaba com a necessidade de explodir dezenas de camas na lava. Beba a poção e os Detritos Ancestrais (Ancient Debris) brilharão nas paredes do submundo!"
	]
	quest.310000000000000C.title: "Pó de Netherite Calcinado"
	quest.310000000000000D.quest_desc: [
		"Não deixe o efeito acabar a meio de um túnel!"
		""
		"As poções normais de visão duram um tempo muito limitado. Se quiser aproveitar verdadeiramente a sua mineração e o custo destes pós, não se esqueça de adicionar **Redstone** às poções prontas no Suporte de Poções."
		""
		"Isso criará a versão Prolongada (Extended) da Poção, permitindo que minere durante muito mais tempo sem precisar de carregar frascos extra no inventário."
	]
	quest.310000000000000D.title: "Duração Estendida"
	quest.3106E0E3FACFF894.title: "Alvo: Tree Ent"
	quest.311CCE7D59B3AEEB.title: "Alvo: Hermit King"
	quest.3136815A001842E6.title: "Alvo: Bogged Shadow"
	quest.3138EBC9BE44E0B6.quest_desc: ["A madeira normal não tem poder aqui. As árvores do Undergarden (Smogstem e Wigglewood) são imunes ao ambiente hostil. Colete essa madeira para fazer cabos de ferramentas que suportam os minérios da dimensão."]
	quest.3138EBC9BE44E0B6.title: "Flora Subterrânea"
	quest.31D4E7161D29EEAD.quest_desc: ["O minério que move o mundo. O ferro forja armaduras, espadas e os primeiros maquinários complexos."]
	quest.31F4F1C8059D8700.title: "Alvo: Pottergeist"
	quest.31F8C3D73CEA5B02.quest_desc: ["Você pediu a lista completa, caçador. Aqui estão as 54 ameaças isoladas da Série Luminous. Elas foram separadas em 4 colunas. Todas estão liberadas: cace-os na ordem que os encontrar pelo mundo!"]
	quest.31F8C3D73CEA5B02.title: "O Fichário Completo"
	quest.3200000000000001.quest_desc: [
		"O início humilde da mineração em área."
		""
		"Em vez de escavar bloco por bloco, os martelos quebram uma área de 3x3. O **Stone Hammer** (Martelo de Pedra) é o seu primeiro passo no early-game. A durabilidade é baixa, mas poupará muito tempo a abrir os seus primeiros túneis!"
	]
	quest.3200000000000001.title: "Martelo de Pedra"
	quest.3200000000000002.quest_desc: [
		"A espinha dorsal da automação manual."
		""
		"O **Iron Hammer** traz uma velocidade de mineração decente e durabilidade suficiente para longas viagens às cavernas. É a ferramenta padrão (3x3) para qualquer mineiro respeitável."
	]
	quest.3200000000000002.title: "Martelo de Ferro"
	quest.3200000000000003.quest_desc: [
		"Velocidade ofuscante, fragilidade de vidro."
		""
		"Tal como as ferramentas normais, o **Gold Hammer** minera muito mais depressa do que o ferro, quebrando a área 3x3 quase instantaneamente. O problema? A durabilidade evapora-se. Ideal para ser encantado com Inquebrável (Unbreaking)!"
	]
	quest.3200000000000003.title: "Martelo de Ouro"
	quest.3200000000000004.quest_desc: [
		"O rei do mid-game."
		""
		"O **Diamond Hammer** é onde a brincadeira fica séria. Velocidade fantástica, capaz de minerar todos os minérios do jogo e uma durabilidade formidável que o vai acompanhar durante semanas."
	]
	quest.3200000000000004.title: "Martelo de Diamante"
	quest.3200000000000005.quest_desc: [
		"O topo da engenharia base."
		""
		"O **Netherite Hammer** funde a dureza do diamante com as propriedades do submundo. É imune à lava e quebra pedras como se fossem papel."
	]
	quest.3200000000000005.title: "Martelo de Netherite"
	quest.3200000000000006.quest_desc: [
		"O segredo para expandir o seu poder."
		""
		"O limite 3x3x1 é apenas o começo. O mod fornece **Cores** (Núcleos) especiais: o *Impact Core*, o *Reinforced Core* e o *Destruction Core*."
		""
		"Você deve usar estes núcleos numa bancada de trabalho juntamente com o seu martelo base (seja ele de Ferro, Diamante, etc.) para fazer o upgrade para os 'Tiers' superiores de destruição!"
	]
	quest.3200000000000006.title: "Os Núcleos de Expansão"
	quest.3200000000000007.quest_desc: [
		"Adicionando profundidade aos seus golpes."
		""
		"Ao usar um *Impact Core* no seu martelo, você forja o **Impact Hammer**. A grande diferença é que ele não minera apenas uma parede plana de 3x3x1, mas sim um cubo maciço de **3x3x3**!"
		""
		"Isso significa que você destrói 27 blocos num único golpe, abrindo túneis perfeitamente simétricos e profundos instantaneamente."
	]
	quest.3200000000000007.title: "Martelo de Impacto (3x3x3)"
	quest.3200000000000008.quest_desc: [
		"Expandindo o horizonte."
		""
		"Aplicando um *Reinforced Core*, você cria o **Reinforced Hammer**. Esta evolução aumenta drasticamente a área de quebra, passando de 3x3 para um gigantesco **5x5x1**."
		""
		"Você vai quebrar 25 blocos planos por clique! É a ferramenta definitiva para escavar grandes salões e limpar áreas vastas no subsolo."
	]
	quest.3200000000000008.title: "Martelo Reforçado (5x5)"
	quest.3200000000000009.quest_desc: [
		"A montanha vai chorar."
		""
		"O topo absoluto do mod. Usando o *Destruction Core*, você dá origem ao apocalíptico **Destruction Hammer**."
		""
		"Dependendo do material usado (Diamante/Netherite), ele atinge um escopo irreal de **5x5x3** ou até **5x5x5**. Isso significa vaporizar até 125 blocos de uma única vez. É poder puro e bruto nas suas mãos."
	]
	quest.3200000000000009.title: "Martelo de Destruição Absoluta"
	quest.320000000000000A.quest_desc: [
		"Não perca a sua obra-prima!"
		""
		"Sabe o melhor dos martelos do Just Hammers? **Eles nunca quebram.** Quando a durabilidade chega a 1, a ferramenta simplesmente para de funcionar."
		""
		"Vá a uma Bigorna e coloque o material do martelo (ex: Diamante para martelos de Diamante) para o reparar totalmente sem perder os seus encantamentos épicos de Fortune e Efficiency!"
	]
	quest.320000000000000A.title: "A Lei da Bigorna"
	quest.320000000000000C.quest_desc: [
		"O segredo para expandir o seu poder."
		""
		"Para evoluir o seu martelo nas linhas desta grelha, você precisa forjar os **Núcleos (Cores)**: Impact, Reinforced e Destruction."
		""
		"Combine o núcleo com o martelo na bancada de trabalho para multiplicar a área destruída!"
	]
	quest.320000000000000C.title: "Os Núcleos de Expansão"
	quest.3200000000000100.quest_desc: ["O início humilde. Quebra **3x3x1** blocos de uma só vez. Ideal para o início do jogo."]
	quest.3200000000000100.title: "Martelo de Pedra"
	quest.3200000000000110.quest_desc: ["Aplica o Impact Core. Quebra um cubo de **3x3x3** (27 blocos)!"]
	quest.3200000000000110.title: "Impacto de Pedra"
	quest.3200000000000120.quest_desc: ["Aplica o Reinforced Core. Quebra uma parede de **5x5x1** (25 blocos) num clique."]
	quest.3200000000000120.title: "Reforçado de Pedra"
	quest.3200000000000130.quest_desc: ["A junção dos dois poderes! Quebra uma área insana de **5x5x3** (75 blocos)."]
	quest.3200000000000130.title: "Impacto Reforçado (Pedra)"
	quest.3200000000000140.quest_desc: ["A destruição total de Pedra. Vaporiza um cubo de **5x5x5** (125 blocos) de uma vez, mas prepare-se para o reparar com frequência!"]
	quest.3200000000000140.title: "Destruição de Pedra"
	quest.3200000000000200.quest_desc: ["O pilar da mineração em massa. Quebra **3x3x1** e minera quase tudo."]
	quest.3200000000000200.title: "Martelo de Ferro"
	quest.3200000000000210.quest_desc: ["Profundidade adicionada. Quebra **3x3x3** (27 blocos) de pedra sem suar."]
	quest.3200000000000210.title: "Impacto de Ferro"
	quest.3200000000000220.quest_desc: ["Abre paredes colossais de **5x5x1** instantaneamente."]
	quest.3200000000000220.title: "Reforçado de Ferro"
	quest.3200000000000230.quest_desc: ["Combinando alcance e profundidade: **5x5x3** (75 blocos). Ideal para escavar túneis de metropolitanos!"]
	quest.3200000000000230.title: "Impacto Reforçado (Ferro)"
	quest.3200000000000240.quest_desc: ["Limpa áreas de **5x5x5** (125 blocos). Um colosso de aço nas suas mãos."]
	quest.3200000000000240.title: "Destruição de Ferro"
	quest.3200000000000300.quest_desc: ["Extremamente rápido, mas frágil. Quebra **3x3x1**."]
	quest.3200000000000300.title: "Martelo de Ouro"
	quest.3200000000000310.quest_desc: ["Velocidade da luz num raio de **3x3x3**."]
	quest.3200000000000310.title: "Impacto de Ouro"
	quest.3200000000000320.quest_desc: ["Velocidade insana em **5x5x1** blocos."]
	quest.3200000000000320.title: "Reforçado de Ouro"
	quest.3200000000000330.quest_desc: ["Limpa **5x5x3** num piscar de olhos. Obrigatório encantar com Unbreaking!"]
	quest.3200000000000330.title: "Impacto Reforçado (Ouro)"
	quest.3200000000000340.quest_desc: ["Destrói **5x5x5** a uma velocidade perigosa. Cuidado para não quebrar a sua base sem querer!"]
	quest.3200000000000340.title: "Destruição de Ouro"
	quest.3200000000000400.quest_desc: ["O Rei das Cavernas. Extrema durabilidade e força (Quebra **3x3x1**)."]
	quest.3200000000000400.title: "Martelo de Diamante"
	quest.3200000000000410.quest_desc: ["Aprofundando a escavação. Quebra **3x3x3** (27 blocos) de minérios preciosos sem quebrar rapidamente."]
	quest.3200000000000410.title: "Impacto de Diamante"
	quest.3200000000000420.quest_desc: ["Paredes de **5x5x1** abertas com o poder do diamante."]
	quest.3200000000000420.title: "Reforçado de Diamante"
	quest.3200000000000430.quest_desc: ["O trator perfeito. Limpa **5x5x3** (75 blocos) com durabilidade formidável."]
	quest.3200000000000430.title: "Impacto Reforçado (Diamante)"
	quest.3200000000000440.quest_desc: ["125 blocos de uma vez. O Diamond Destruction Hammer é a ferramenta que separa os aprendizes dos mestres construtores!"]
	quest.3200000000000440.title: "Destruição de Diamante"
	quest.3200000000000500.quest_desc: ["Imune à lava. Inquebrável (quase). A arma definitiva (Quebra **3x3x1**)."]
	quest.3200000000000500.title: "Martelo de Netherite"
	quest.3200000000000510.quest_desc: ["Quebra **3x3x3** (27 blocos). O pesadelo do Netherrack."]
	quest.3200000000000510.title: "Impacto de Netherite"
	quest.3200000000000520.quest_desc: ["Derruba secções de **5x5x1** de lava secada sem pestanejar."]
	quest.3200000000000520.title: "Reforçado de Netherite"
	quest.3200000000000530.quest_desc: ["Escava montanhas aos bocados de **5x5x3** (75 blocos). O colosso inabalável."]
	quest.3200000000000530.title: "Impacto Reforçado (Netherite)"
	quest.3200000000000540.quest_desc: [
		"O Mjolnir do Minecraft."
		""
		"O **Netherite Destruction Hammer** devora áreas incrivelmente grandes de **5x5x5** (125 blocos) a cada clique. A montanha treme diante de quem empunha este deus de metal."
	]
	quest.3200000000000540.title: "A Destruição Apocalíptica"
	quest.32029370FEB050CA.title: "Alvo: Statue Mimic"
	quest.320961CB21A136CA.title: "Alvo: Yeti"
	quest.3231FEF10674F27A.title: "Alvo: Desert Zombie"
	quest.324A41FD87670879.title: "Alvo: Piglin Cultist Rider"
	quest.325D56632876FC4B.quest_desc: ["Desça até as camadas abissais mais densas de Icaria e minere Sideros e Vanadium. Ao fundir os dois na sua Forja, você criará o Vanadium Steel, o metal mais afiado e indestrutível de toda a dimensão."]
	quest.325D56632876FC4B.title: "O Aço Supremo (Vanadium)"
	quest.32805837E347D1F3.quest_desc: [
		"O problema da dinamite normal é que ela rola e quica. A Dinamite Pegajosa (Sticky Dynamite) resolve isso com um pouco de gosma de Slime."
		""
		"Arremesse-a contra tetos, paredes ou diretamente na cara de um Creeper. Ela grudará instantaneamente onde bater antes de explodir!"
	]
	quest.32805837E347D1F3.title: "Fixação Explosiva"
	quest.32A6EE79F046172C.quest_desc: ["Mostra visualmente quantos canais estão sendo usados no fio."]
	quest.32A6EE79F046172C.title: "Cabo Inteligente"
	quest.32AF23B1A3A1D8A1.title: "Alvo: Vile Gator"
	quest.32BA59E01B683F84.title: "Alvo: Glider"
	quest.32BA78D12556B6BF.title: "Alvo: Moss Zombie"
	quest.32C14B91D7C32B92.title: "Alvo: Forest Zombie"
	quest.32DEFF84DD78AE0B.quest_desc: ["Variante de Diamante. Excelente dano e durabilidade."]
	quest.32DEFF84DD78AE0B.title: "Cutelo de Diamante"
	quest.32E926DA106CD47C.quest_desc: [
		"Criada para o caos incendiário."
		""
		"Além de causar dano em área com a explosão, esta variante espalha fogo por todo o raio de impacto. Excelente para lidar com hordas de zumbis ou limpar florestas rapidamente."
	]
	quest.32E926DA106CD47C.title: "Chuva de Fogo"
	quest.3300000000000001.quest_desc: [
		"A beleza mora nos detalhes."
		""
		"O mod Ecologics não quer transformar o seu jogo num RPG louco; o seu objetivo é restaurar e trazer nova vida aos biomas clássicos do Minecraft!"
		""
		"Prepare-se para explorar um mundo onde a flora e a fauna interagem consigo de formas surpreendentes e extremamente úteis."
	]
	quest.3300000000000001.title: "A Natureza Viva"
	quest.3300000000000002.quest_desc: [
		"Olhe para cima!"
		""
		"As praias agora possuem belíssimos Coqueiros (Coconut Trees). Mas tenha cuidado: os cocos maduros podem cair e atingir a sua cabeça! Quando quebram no chão, soltam fatias de coco que removem efeitos negativos (tal como o leite faria)."
	]
	quest.3300000000000002.title: "A Sombra do Coqueiro"
	quest.3300000000000003.quest_desc: [
		"Surpresa cascudinha!"
		""
		"Às vezes, um coco que cai não é comida... é um Caranguejo do Coco (Coconut Crab)! Eles são pacíficos até você os atacar. A carapaça deles aguenta muita pancada, mas se a quebrar, eles fogem de medo e largam a Garra (Crab Claw). A garra pode ser comida ou usada como Tesoura (Shears)!"
	]
	quest.3300000000000003.title: "O Eremita Casca-Grossa"
	quest.3300000000000004.quest_desc: [
		"A fortaleza em miniatura."
		""
		"Caminhando pela areia encontrará Conchas (Seashells). Junte-as para construir um Castelo de Areia! A sua função não é apenas estética: se colocar o castelo por cima de um Ovo de Tartaruga, ele fica protegido contra os pisões dos zombies, garantindo que as tartaruguinhas consigam nascer!"
	]
	quest.3300000000000004.title: "Castelos na Areia"
	quest.3300000000000005.quest_desc: [
		"Uma nova sombra verdejante."
		""
		"As Planícies (Plains) agora abrigam as Nogueiras (Walnut Trees). Além de fornecerem um novo tipo de madeira escura excelente para construção, as suas folhas deixam cair Nozes (Walnuts)."
	]
	quest.3300000000000005.title: "O Pomar da Planície"
	quest.3300000000000006.quest_desc: [
		"Os melhores reflorestadores do jogo!"
		""
		"Esquilos (Squirrels) habitam as planícies. Se os alimentar com Nozes, eles ganham a sua confiança. Um esquilo que confia em si vai ativamente apanhar qualquer muda de árvore (Sapling) que estiver caída no chão e plantá-la por perto! É jardinagem 100% automática!"
	]
	quest.3300000000000006.title: "Os Jardineiros Felpudos"
	quest.3300000000000007.quest_desc: [
		"Cuidado onde pisa!"
		""
		"Os lagos gelados e rios nevados agora contêm manchas de Gelo Fino (Thin Ice). Se você pular nele, ele racha. Se você pisar num Gelo Fino já rachado... ele quebra e você vai tomar um banho gelado perigoso!"
	]
	quest.3300000000000007.title: "Gelo Quebradiço"
	quest.3300000000000008.quest_desc: [
		"A fofura suprema da tundra."
		""
		"Pinguins! Eles nascem em grandes grupos. O grande truque de sobrevivência é: ficar perto de um grupo de pelo menos 4 pinguins concede-lhe o efeito de **Regeneração** constante de vida!"
		""
		"Pode alimentá-los com peixe cru para os ver felizes e reproduzi-los."
	]
	quest.3300000000000008.title: "A Cura do Grupo"
	quest.3300000000000009.quest_desc: [
		"Uma poção hilariante e útil!"
		""
		"Quando um pinguim bebé cresce e vira adulto, ele solta Penas de Pinguim (Penguin Feather). Use-as no seu Suporte de Poções para destilar a **Potion of Sliding** (Poção de Deslizamento)."
		""
		"Com esta poção ativa, **todos os blocos** do jogo (até relva ou pedra) se comportam como Gelo Azul, permitindo-lhe deslizar e ganhar velocidade em qualquer lugar!"
	]
	quest.3300000000000009.title: "Deslizamento Mágico"
	quest.330000000000000A.quest_desc: [
		"Uma delícia perigosa das areias."
		""
		"No topo dos Cactos gigantes agora crescem Figos-da-Índia (Prickly Pears). Você pode colhê-los, mas se comê-los crus, vai levar dano na boca! Coloque-os na fornalha para remover os espinhos e ter um lanche perfeito no deserto."
	]
	quest.330000000000000A.title: "O Fruto do Cacto"
	quest.330000000000000B.quest_desc: [
		"As relíquias escondidas nas areias."
		""
		"Ao explorar o deserto, pode encontrar Ruínas repletas de Vasos Antigos (Pots). Para pegar no loot dentro deles, precisa parti-los!"
		""
		"**Dica de Engenheiro:** Pode mudar o padrão do vaso usando uma picareta com Shift + Clique. Se ligar um comparador a ele, o vaso emite sinal de redstone baseado na quantidade de itens que lá colocar!"
	]
	quest.330000000000000B.title: "Vasos de Saque"
	quest.330000000000000C.quest_desc: [
		"Justiça para a Azaleia!"
		""
		"Sempre foi estranho as árvores de Azaleia nas Lush Caves darem madeira de carvalho normal... O Ecologics conserta isso! Agora a Azaleia tem a sua própria madeira rosa suave (Azalea Log), perfeita para construções delicadas."
	]
	quest.330000000000000C.title: "Madeira de Azaleia"
	quest.332F6BEB9F68D518.title: "Alvo: Forest Zombie"
	quest.333D2AA43FD523B8.quest_desc: ["Minera no fundo dos oceanos profundos e funde com o teu Necoium."]
	quest.333D2AA43FD523B8.title: "Cristal: Água-Marinha"
	quest.33600FF7BF18E29A.quest_desc: [
		"Uma entidade amaldiçoada que incendeia tudo ao seu redor. A Mula sem Cabeça ataca com fogo implacável e arremessa os oponentes."
		""
		"Sobreviva às chamas e derrote-a para conseguir a sua Caveira decorativa e o cobiçado Couro Flamejante (Flaming Leather)!"
	]
	quest.33600FF7BF18E29A.title: "A Maldição de Fogo"
	quest.336C75682197AB2A.title: "Alvo: Piglin Cultist Archer"
	quest.336DB4FEFF7AF64E.quest_desc: ["Você precisa de 'Memória RAM' para a rede processar crafts complexos. Junte Crafting Units em um cubo e adicione as Storage Bytes."]
	quest.336DB4FEFF7AF64E.title: "CPU de Autocrafting"
	quest.3378E5D464E19A43.quest_desc: [
		"O gigante letal das selvas. Ele esmaga pedras e jogadores com a mesma facilidade."
		""
		"Cace-o à noite nas selvas densas para conseguir a sua Presa."
	]
	quest.3378E5D464E19A43.title: "O Rei da Selva"
	quest.33E7699D6C57C004.title: "Matéria Abissal"
	quest.3400000000000001.quest_desc: [
		"O terror bate à porta da sua vila."
		""
		"O mod **Raids Enhanced** transforma as invasões dos Illagers num verdadeiro teatro de guerra! Ele adiciona novos Mini-Chefes únicos às ondas de ataque da Raid."
		""
		"Cada um destes chefões exige uma estratégia de combate completamente diferente. Prepare as suas muralhas, poções e escudos, pois os saqueadores agora vêm por terra, pelo ar e até pelo subsolo!"
	]
	quest.3400000000000001.title: "A Invasão Aprimorada"
	quest.3400000000000002.quest_desc: [
		"A morte vem dos céus."
		""
		"O **Raider Blimp** (Dirigível) é uma unidade de assalto aéreo. Ele consegue focar em 7 alvos ao mesmo tempo (3 de cada lado e 1 diretamente abaixo dele). A sua única esperança é usar os pontos cegos da máquina para atacar!"
		""
		"Se conseguir abater esta maravilha da engenharia, ele dropará 'Blimp Parts' (Peças de Dirigível). Combine essas peças com um barco normal numa bancada de trabalho e crie o **seu próprio dirigível** para voar!"
	]
	quest.3400000000000002.title: "Ameaça dos Céus"
	quest.3400000000000003.quest_desc: [
		"A arma de destruição maciça dos Illagers."
		""
		"O **Golem Of Last Resort** (Golem do Último Recurso) é uma versão corrompida e gigantesca de um Golem de Ferro."
		""
		"**Táticas de Combate:** Guarde o seu arco. Ele é 100% IMUNE a flechas e a ataques à distância! Terá de o enfrentar no corpo a corpo enquanto se desvia dos seus 3 ataques em área. Pior ainda: ele destrói os blocos ao seu redor como se fosse um Wither. Cuidado com a sua base!"
	]
	quest.3400000000000003.title: "O Titã de Ferro"
	quest.3400000000000004.quest_desc: [
		"O mago das tempestades."
		""
		"O **Zapper** ataca à distância usando a fúria dos raios. Ele possui um ataque massivo em área de onde você precisa obrigatoriamente de se esquivar."
		""
		"**O Perigo Oculto:** Não confie no seu escudo! O segundo ataque especial dele derrete e destrói o seu escudo em meros segundos. Seja rápido e agressivo para não virar churrasco!"
	]
	quest.3400000000000004.title: "O Mago da Tempestade"
	quest.3400000000000005.quest_desc: [
		"Uma invasão vinda debaixo dos seus pés."
		""
		"A **Raider Drill** (Broca Saqueadora) é uma máquina tática que escava pelo subsolo e irrompe no meio da vila de forma aleatória, invocando logo de seguida entre 2 a 3 Illagers novos. Ficará debaixo de terra novamente se não for atacada rapidamente."
		""
		"**Como Destruir:** A broca tem apenas 5 de HP, mas tem uma armadura absurdamente espessa. Para lhe dar 1 ponto de dano, você precisa de lhe acertar 3 vezes seguidas! Ao ser destruída, a máquina recompensa-o com um Livro Encantado aleatório para a sua Picareta."
	]
	quest.3400000000000005.title: "O Terror Subterrâneo"
	quest.3409A392893284F9.title: "Alvo: Red Mummy"
	quest.342C26B2C644949D.title: "Alvo: Forest Skeleton"
	quest.34797E6732328754.title: "Alvo: Bogged Bone Stalker"
	quest.3500000000000001.quest_desc: [
		"Acabou a tortura dos barcos e dos carrinhos de mina!"
		""
		"Transportar animais ou Aldeões no Minecraft Vanilla é uma das tarefas mais frustrantes do jogo. O mod **Mob Catcher** resolve isso de forma elegante, permitindo que capture qualquer criatura para o seu inventário e a solte onde quiser."
		""
		"**Preservação Total:** Quando captura um mob, o item guarda tudo! A vida atual, o nome que lhe deu com a etiqueta, a cor da coleira e, mais importante ainda, as **trocas exatas e a profissão do Villager**. É só clicar com o botão direito na entidade para a capturar e clicar no chão para a libertar!"
	]
	quest.3500000000000001.title: "O Mestre das Feras"
	quest.3500000000000002.quest_desc: [
		"A ferramenta de resgate amigável."
		""
		"O **Diamond Mob Catcher** é desenhado exclusivamente para capturar criaturas pacíficas. Ele funciona em todos os animais de quinta, lulas, peixes, golens e Aldeões."
		""
		"**Estratégia de Base:** Use-o para raptar (quer dizer, resgatar!) os melhores aldeões das vilas distantes e trazê-los de imediato para a sua sala de trocas no conforto do seu inventário, sem precisar de barcos que atravessam montanhas!"
	]
	quest.3500000000000002.title: "Capturador de Passivos"
	quest.3500000000000003.quest_desc: [
		"Prendendo o perigo num frasco."
		""
		"O **Netherite Mob Catcher** é a evolução focada no combate e na contenção de ameaças. Com ele, você pode capturar criaturas hostis (Zumbis, Esqueletos, Creepers, Endermen, etc.)."
		""
		"**Aplicações Táticas:**"
		"• Guarde um Zumbi em segurança para fazer a conversão de Aldeões (Zombification) mais tarde e conseguir super descontos de esmeraldas."
		"• Capture um monstro raro para colocar numa jaula de exposição na sua base."
		"• *Nota:* Por questões de balanceamento de jogo, este item **NÃO funciona em Bosses** (como o Wither ou o Ender Dragon)."
	]
	quest.3500000000000003.title: "Capturador de Hostis"
	quest.3527FA68A94811E2.title: "Alvo: Forest Skeleton"
	quest.358B3880B795143A.title: "Katana de Ouro"
	quest.35AB5465D0276100.quest_desc: [
		"Nas profundezas, você encontrará um novo minério brilhante: A Prata (chamada de Paládio nas versões mais recentes do mod)."
		""
		"Derreta esse minério para criar os lingotes que servirão de base para a engenharia da Galosphere."
	]
	quest.35AB5465D0276100.title: "O Metal Precioso"
	quest.35CE345A610D6869.title: "Alvo: Jungle Zombie"
	quest.35F4C7E4531F799E.quest_desc: ["A joia da coroa! O Presunto Glaceado com Mel (Honey Glazed Ham) é o prato mais complexo e recompensador de toda a gastronomia. Exige tempo, ingredientes raros e amor pela cozinha. Você uniu a taverna, os fornos, o mel do Bumblezone e as máquinas do Create para dominar a arte do alimento. Vida longa ao Chef!"]
	quest.35F4C7E4531F799E.title: "O MasterChef Supremo"
	quest.3600000000000001.quest_desc: [
		"O combate nunca mais será o mesmo."
		""
		"O Simply Swords expande o arsenal do Minecraft de forma absurda. Cada arma tem o seu próprio peso, alcance (reach) e tempo de recuperação."
		""
		"Pode forjar todas as armas base usando materiais vanilla. Escolha o seu estilo de combate: prefere atacar rápido e esquivar, ou esmagar hordas inteiras com um único golpe lento e pesado?"
	]
	quest.3600000000000001.title: "O Novo Arsenal"
	quest.3600000000000002.quest_desc: ["As Lâminas Ágeis. Velocidade de ataque permite combos letais."]
	quest.3600000000000002.title: "Adaga de Ferro"
	quest.3600000000000003.quest_desc: ["A Rapieira ataca num padrão de estocada. Alcance maior e ataques rápidos."]
	quest.3600000000000003.title: "Rapieira de Ferro"
	quest.3600000000000004.quest_desc: ["A Sai é uma arma de desvio ultrarrápida. Excelente para a segunda mão."]
	quest.3600000000000004.title: "Sai de Ferro"
	quest.3600000000000005.quest_desc: ["O Cutelo permite varrer inimigos próximos com grande fluidez."]
	quest.3600000000000005.title: "Cutelo de Ferro"
	quest.3600000000000006.quest_desc: ["A Espada Longa possui mais alcance (reach) e um ataque de varredura mais amplo."]
	quest.3600000000000006.title: "Espada Longa de Ferro"
	quest.3600000000000007.quest_desc: ["A Katana aumenta a velocidade do golpe e o dano crítico."]
	quest.3600000000000007.title: "Katana de Ferro"
	quest.3600000000000008.quest_desc: ["A Lâmina Dupla atinge os inimigos num arco de quase 180 graus."]
	quest.3600000000000008.title: "Lâmina Dupla de Ferro"
	quest.3600000000000009.quest_desc: ["A Lança tem um dos maiores alcances do jogo. Espete inimigos à distância!"]
	quest.3600000000000009.title: "Lança de Ferro"
	quest.360000000000000A.quest_desc: ["As Armas Pesadas compensam a lentidão com um dano base avassalador."]
	quest.360000000000000A.title: "Claymore de Ferro"
	quest.360000000000000B.quest_desc: ["O Grande Machado quebra as defesas inimigas e causa dano em área massivo."]
	quest.360000000000000B.title: "Grande Machado de Ferro"
	quest.360000000000000C.quest_desc: ["A Foice possui um padrão de ataque em leque impressionante."]
	quest.360000000000000C.title: "Foice de Ferro"
	quest.360000000000000D.quest_desc: ["A Alabarda combina a força do machado com a estocada da lança."]
	quest.360000000000000D.title: "Alabarda de Ferro"
	quest.360000000000000E.quest_desc: [
		"Onde a magia encontra a forja."
		""
		"As armas Relíquia/Únicas não podem ser construídas. Apenas podem ser encontradas em baús de tesouro."
		""
		"Estas armas lendárias perdem durabilidade. Terá de encontrar uma **Gema Rúnica** e usá-la na Bigorna para as reparar!"
	]
	quest.360000000000000E.title: "A Forja Ancestral"
	quest.360000000000000F.quest_desc: ["Uma montante demoníaca que possui uma habilidade ativa capaz de erupcionar o chão ao seu redor, causando explosões e fogo!"]
	quest.360000000000000F.title: "Lenda: Brimstone"
	quest.3600000000000010.quest_desc: ["Canaliza a energia das tempestades. Ao ativar o seu poder especial, relâmpagos caem dos céus diretamente sobre os inimigos."]
	quest.3600000000000010.title: "Lenda: Stormbringer"
	quest.3600000000000011.quest_desc: ["Aplica lentidão severa aos inimigos. A sua habilidade ativa liberta uma onda de congelamento."]
	quest.3600000000000011.title: "Lenda: Frostfall"
	quest.3600000000000013.quest_desc: [
		"A dedicação e exploração compensaram."
		""
		"Se você reuniu todas estas lendas (desde a Soulkeeper e Whisperwind até à Enigma e Caelestis), você tornou-se o Colecionador Supremo da Forja. Nenhuma criatura deste mundo se atreverá a olhar nos seus olhos."
	]
	quest.3600000000000013.title: "O Colecionador de Relíquias"
	quest.3600000000000014.quest_desc: ["O Chakram é uma arma exótica arremessável que retorna à sua mão."]
	quest.3600000000000014.title: "Chakram de Ferro"
	quest.3600000000000015.quest_desc: ["A Warglaive possui lâminas em ambas as extremidades."]
	quest.3600000000000015.title: "Warglaive de Ferro"
	quest.3600000000000016.quest_desc: ["O Greathammer é a arma mais lenta, capaz de quebrar escudos e obliterar alvos."]
	quest.3600000000000016.title: "Grão-Martelo de Ferro"
