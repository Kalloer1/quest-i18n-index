	]
	quest.4000000000000999.title: "O Senhor do Fim do Mundo"
	quest.400684270E608447.title: "Alvo: Orca"
	quest.403F95AED3733CD6.title: "Alvo: Tree Ent"
	quest.404190ADD864B4FE.quest_desc: ["Toda lenda tem um começo humilde. Soque a árvore, faça sua primeira bancada e prepare-se para desbravar o mundo."]
	quest.4059690285BEA5E3.quest_desc: ["Os mortos-vivos (Revenants) patrulham vilas gregas destruídas. Invada esses locais sagrados, derrote os Capitães e abra os baús. Seu prêmio? Pergaminhos (Scrolls) que permitem atirar Mísseis Mágicos ou dominar a Antigravidade usando mana!"]
	quest.4059690285BEA5E3.title: "Ruínas e Feitiçaria"
	quest.408217E6C9B98068.title: "Alvo: Piglin Cultist Archer"
	quest.409AB8264B138818.title: "Alvo: Shadow"
	quest.40B4756ECA5E6224.title: "Caçador"
	quest.40B91D35701D331D.title: "Alvo: Statue Mimic"
	quest.40E0EF9FB54AAF3B.title: "Alvo: Warped Spitter"
	quest.4100000000000001.quest_desc: [
		"A música nasce de coisas simples."
		""
		"Para começar a sua jornada musical no Immersive Melodies, tudo o que precisa de fazer é apanhar um Lingote de Cobre (Copper Ingot)."
		"Ao fazer isso, todas as receitas dos instrumentos mágicos serão instantaneamente desbloqueadas e ficarão visíveis no seu livro de receitas Vanilla!"
	]
	quest.4100000000000001.title: "A Inspiração de Cobre"
	quest.4100000000000002.quest_desc: [
		"O Conservatório da Vila está oficialmente aberto!"
		""
		"Para se tornar o Maestro da Vila, você não pode apenas saber que os instrumentos existem. Você deve forjar e possuir todos eles."
		""
		"Esta missão rastreia a obtenção dos 11 instrumentos visíveis no seu atlas de receitas. Use as receitas desbloqueadas com o Cobre e complete a sua coleção!"
	]
	quest.4100000000000002.title: "O Maestro da Vila"
	quest.4100000000000003.quest_desc: [
		"Você não está limitado às 25 músicas do mod!"
		""
		"O Immersive Melodies suporta arquivos **.MIDI** e **.ABC**. Existem milhões destes arquivos espalhados pela internet de todas as músicas que possa imaginar."
		""
		"Para tocar a sua própria música, basta arrastar (drag and drop) o arquivo MIDI ou ABC diretamente para a janela do jogo enquanto segura o instrumento, ou usar datapacks!"
	]
	quest.4100000000000003.title: "O Maestro (Arquivos Customizados)"
	quest.4100000000000004.quest_desc: [
		"A música é melhor quando partilhada."
		""
		"Este mod funciona na perfeição em Multiplayer! Você pode juntar os seus amigos, cada um com o seu instrumento favorito, e sincronizarem-se para formar uma banda de verdade."
		""
		"Ou... pode simplesmente tocar a música mais irritante que encontrar enquanto invade a base deles."
	]
	quest.4100000000000004.title: "A Banda do Servidor"
	quest.4100000000000005.quest_desc: [
		"A sua música toca até os corações dos animais."
		""
		"Experimente tocar uma das suas melodias perto de papagaios. Sim, os passarinhos (birbs) vão começar a dançar ao som da sua atuação!"
	]
	quest.4100000000000005.title: "O Público Alado"
	quest.4100000000000011.title: "A Flauta"
	quest.4100000000000012.title: "O Alaúde"
