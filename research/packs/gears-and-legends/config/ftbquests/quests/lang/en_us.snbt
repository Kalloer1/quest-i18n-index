	quest.5000000000000001.quest_desc: ["O cobre é a alma da eletricidade inicial. Você precisará de muito."]
	quest.5000000000000001.title: "O Condutor Básico"
	quest.5000000000000003.quest_desc: ["Zinco para criar latão."]
	quest.5000000000000003.title: "Liga de Resistência"
	quest.5000000000000005.quest_desc: ["Ouro puro para evitar perda de energia."]
	quest.5000000000000005.title: "Condutor Supremo"
