	quest.423C06A264C035B7.title: "Alvo: Crimson Walker"
	quest.4243432794B910DB.quest_desc: [
		"O upgrade definitivo para multiplayer! O §dPlayer Teleport Upgrade§r é instalado no Tempad."
		""
		"Combinado com os dados do Screening Device, este Upgrade altera a função do seu Tempad, permitindo focar diretamente na assinatura de outro jogador e abrir um portal direto para ele."
	]
	quest.4243432794B910DB.title: "Portal para Jogadores"
	quest.4294971B21F4CCD4.quest_desc: [
		"A Joia da Natureza. O Peridoto pode ser encontrado nas profundezas do Overworld, geralmente associado a biomas florais e florestas."
		""
		"Obtenha o cristal e o Template do Peridoto para imbuir sua armadura com a vitalidade e a resistência da terra."
	]
	quest.4294971B21F4CCD4.title: "Overworld: Peridoto"
	quest.42AD7CAD3529731A.quest_desc: ["O Masticator é uma besta formidável com cara de aranha que vaga livremente pelos pântanos soltando teias e veneno! Derrote-o e esfolhe sua carcaça para obter as Escamas do Masticator."]
	quest.42AD7CAD3529731A.title: "Mini-Chefe: O Masticator"
	quest.42C1FD460E95A091.quest_desc: ["Variante de Ouro. Rápida mas frágil."]
	quest.42C1FD460E95A091.title: "Sai de Ouro"
	quest.4300000000000001.quest_desc: [
		"O fim da desorganização!"
		""
		"O Sophisticated Storage eleva a sua base a um nível industrial."
		"Comece por forjar os blocos básicos. Os Baús oferecem um visual clássico, enquanto os Barris são perfeitos para paredes compactas, pois não precisam de espaço livre em cima para abrir!"
		""
		"*(Dica: Não precisa de partir o bloco para o melhorar. Pode criar um item chamado 'Tier Upgrade' e clicar com o botão direito no baú/barril para o evoluir no lugar!)*"
	]
	quest.4300000000000001.title: "A Evolução do Armazém"
	quest.4300000000000002.quest_desc: [
		"O chip de processamento das suas caixas."
		""
		"A Base de Upgrade (Upgrade Base) é necessária para criar qualquer função avançada visível à direita."
	]
	quest.4300000000000002.title: "Núcleo Tecnológico"
	quest.4300000000000011.quest_desc: ["Um salto substancial. O Baú de Ferro expande drasticamente os seus slots de inventário e desbloqueia 2 slots de Upgrade."]
	quest.4300000000000011.title: "Baú de Ferro"
	quest.4300000000000012.quest_desc: ["Ouro puro! Mais capacidade de armazenamento e 3 slots perfeitos para começar a automatizar com filtros e compactadores."]
	quest.4300000000000012.title: "Baú de Ouro"
	quest.4300000000000013.quest_desc: ["A central de triagem. Oferece espaço massivo e 5 slots de Upgrades."]
	quest.4300000000000013.title: "Baú de Diamante"
	quest.4300000000000014.quest_desc: ["A fortaleza estática. Capacidade máxima (120 slots), 7 slots de upgrade e total imunidade contra explosões de Creepers e fogo!"]
	quest.4300000000000014.title: "Baú de Netherite"
	quest.4300000000000021.quest_desc: ["O Barril de Ferro traz as mesmas vantagens do baú, mas com o design frontal clássico! 2 Slots de Upgrade."]
	quest.4300000000000021.title: "Barril de Ferro"
	quest.4300000000000022.quest_desc: ["Mais luxuoso e espaçoso! O Barril de Ouro conta com 3 Slots de Upgrade para automação rápida."]
	quest.4300000000000022.title: "Barril de Ouro"
	quest.4300000000000023.quest_desc: ["A espinha dorsal das grandes indústrias. O Barril de Diamante oferece armazenamento de sobra e 5 Slots de Upgrade."]
	quest.4300000000000023.title: "Barril de Diamante"
	quest.4300000000000024.quest_desc: ["O cilindro indestrutível! Capacidade inigualável com 7 slots de upgrade e totalmente imune ao fogo e à lava!"]
	quest.4300000000000024.title: "Barril de Netherite"
	quest.4300000000000031.quest_desc: ["Forjado com blocos de Ferro. Multiplica a capacidade de itens empilhados (stack) de cada slot."]
	quest.4300000000000031.title: "Stack Upgrade (Ferro)"
	quest.4300000000000032.quest_desc: ["Forjado com blocos de Ouro. Maior capacidade de empilhamento para mega projetos."]
	quest.4300000000000032.title: "Stack Upgrade (Ouro)"
	quest.4300000000000033.quest_desc: ["Forjado com blocos de Diamante. Torna a criação de enormes silos numa realidade."]
	quest.4300000000000033.title: "Stack Upgrade (Diamante)"
	quest.4300000000000034.quest_desc: ["A compressão divina. Requer blocos de Netherite e permite armazenar pilhas colossais num só slot de armazém!"]
	quest.4300000000000034.title: "Stack Upgrade (Netherite)"
	quest.4300000000000041.quest_desc: ["O armazém recolhe itens atirados no chão à sua volta."]
	quest.4300000000000041.title: "Pickup Upgrade"
	quest.4300000000000042.quest_desc: ["Adiciona 16 filtros e controlo detalhado sobre o que é recolhido."]
	quest.4300000000000042.title: "Adv. Pickup Upgrade"
	quest.4300000000000043.quest_desc: ["O armazém puxa itens ativamente para o seu alcance (3 blocos)."]
	quest.4300000000000043.title: "Magnet Upgrade"
	quest.4300000000000044.quest_desc: ["O armazém estende a força magnética até 5 blocos de distância."]
	quest.4300000000000044.title: "Adv. Magnet Upgrade"
	quest.4300000000000045.quest_desc: ["O armazém injeta/extrai itens dos inventários adjacentes como se fosse um funil (hopper)."]
	quest.4300000000000045.title: "Hopper Upgrade"
	quest.4300000000000046.quest_desc: ["Transferência massiva e ultrarrápida com filtros extremamente rigorosos."]
	quest.4300000000000046.title: "Adv. Hopper Upgrade"
	quest.4300000000000047.quest_desc: ["Limita a caixa a aceitar apenas os itens selecionados."]
	quest.4300000000000047.title: "Filter Upgrade"
	quest.4300000000000048.quest_desc: ["Múltiplos filtros, tags do jogo e proteção NBT."]
	quest.4300000000000048.title: "Adv. Filter Upgrade"
	quest.4300000000000049.quest_desc: ["Comprime pepitas/lingotes na sua versão de Bloco automaticamente."]
	quest.4300000000000049.title: "Compacting Upgrade"
	quest.430000000000004A.quest_desc: ["Permite definir receitas personalizadas 2x2 ou 3x3 para compressão imediata."]
	quest.430000000000004A.title: "Adv. Compacting"
	quest.430000000000004B.quest_desc: ["Aniquila permanentemente itens que correspondam ao filtro (excelente para mob farms)."]
	quest.430000000000004B.title: "Void Upgrade"
	quest.430000000000004C.quest_desc: ["Filtros avançados para nunca apagar acidentalmente o que é valioso."]
	quest.430000000000004C.title: "Adv. Void Upgrade"
	quest.430000000000004D.quest_desc: ["Suga os itens do jogador que está a interagir para o armazém."]
	quest.430000000000004D.title: "Deposit Upgrade"
	quest.430000000000004E.quest_desc: ["Envia itens estritamente correspondentes ao filtro avançado."]
	quest.430000000000004E.title: "Adv. Deposit Upgrade"
	quest.4300000000000053.quest_desc: ["A unidade atua também como uma fornalha interior."]
	quest.4300000000000053.title: "Smelting Upgrade"
	quest.4300000000000054.quest_desc: ["Puxa o carvão e os minérios para se fundir a si próprio."]
	quest.4300000000000054.title: "Auto-Smelting"
	quest.4300000000000055.quest_desc: ["Um defumador contido na sua caixa de arrumação."]
	quest.4300000000000055.title: "Smoking Upgrade"
	quest.4300000000000056.quest_desc: ["As carnes são assadas automaticamente se houver combustível."]
	quest.4300000000000056.title: "Auto-Smoking"
	quest.4300000000000057.quest_desc: ["Um alto-forno na gestão da sua base."]
	quest.4300000000000057.title: "Blasting Upgrade"
	quest.4300000000000058.quest_desc: ["O rei da refinação automática de minérios no armazém."]
	quest.4300000000000058.title: "Auto-Blasting"
	quest.4300000000000059.quest_desc: ["Interage e extrai fluidos adjacentes para os tanques."]
	quest.4300000000000059.title: "Pump Upgrade"
	quest.430000000000005A.quest_desc: ["Controlo rígido de que tipo de líquido é permitido entrar ou sair."]
	quest.430000000000005A.title: "Adv. Pump Upgrade"
	quest.430000000000005B.quest_desc: ["Mesa de trabalho embutida no inventário."]
	quest.430000000000005B.title: "Crafting Upgrade"
	quest.430000000000005C.quest_desc: ["Corta e esculpe blocos de pedra e cobre direto do armazenamento."]
	quest.430000000000005C.title: "Stonecutter Upgrade"
	quest.430000000000005D.quest_desc: ["Transforme o seu cofre de valor num enorme Jukebox musical!"]
	quest.430000000000005D.title: "Jukebox Upgrade"
	quest.4300000000000060.quest_desc: ["A unidade adquire a habilidade de armazenar rios de experiência líquida!"]
	quest.4300000000000060.title: "XP Pump Upgrade"
	quest.4305283F297B9564.quest_desc: ["Minério encontrado nas zonas congeladas (Frostfields). Armas forjadas com Froststeel aplicam o efeito de Lentidão (Slowness) em quem for golpeado. Excelente para parar as bestas velozes do abismo!"]
	quest.4305283F297B9564.title: "Froststeel (Nível 2)"
	quest.431A46A31EEF7246.quest_desc: [
		"O Ouro pode ser frágil para ferramentas, mas sua magia e maleabilidade criam um planador com aerodinâmica fantástica."
		""
		"Embora a durabilidade não seja o seu forte, a velocidade com que você corta o ar vai te surpreender."
	]
	quest.431A46A31EEF7246.title: "Voo Dourado"
	quest.432B04A939279930.title: "Alvo: Cave Zombie"
	quest.438E78F03500BEFE.title: "Lança de Cavalaria (Diamante)"
	quest.43DA1B91EFB29D51.quest_desc: [
		"Assim como os Tempads, você pode aprimorar seu Time Twister para as versões §dPurple (TVA)§r ou §eGolden (He Who Remains)§r."
		""
		"Eles guardam um histórico de eventos muito maior (podendo voltar várias 'mortes' atrás) e a versão final custa quase nada para ser ativada."
	]
	quest.43DA1B91EFB29D51.title: "Histórico Multiversal"
	quest.43F422B1DB3074D2.quest_desc: ["Forjada com Cursium. Tem a chance de aplicar Accursed Rage, aumentando brutalmente o seu dano[cite: 18]!"]
	quest.43F422B1DB3074D2.title: "Katana Amaldiçoada"
	quest.4400000000000001.quest_desc: [
		"O início do poder cristalizado."
		""
		"Para dominar o Gemforged, você precisará reunir minérios mágicos como Bloodstone, Gravitium, Nyxite e Prismyte[cite: 17, 18, 19, 21]."
		""
		"Materiais intermediários como o Shimmer Powder (Pó Mágico) e o avançado Yasharium Ingot são a chave para fundir estes cristais e preparar as suas armas finais!"
	]
	quest.4400000000000001.title: "Os Ingredientes Mágicos"
	quest.4400000000000002.quest_desc: [
		"A Forja é o seu altar."
		""
		"As armas e artefatos não se fazem apenas na mesa de trabalho. Você precisará encontrar e utilizar os Moldes (Smithing Templates) específicos na Mesa de Metalurgia para canalizar o poder das gemas nos seus equipamentos!"
		"Existem moldes para Daggers, Bows, Staffs, Charms, Totems e Horns."
	]
	quest.4400000000000002.title: "A Arte da Metalurgia"
	quest.4400000000000003.quest_desc: [
		"O controlo da gravidade nas suas mãos."
		""
		"O Gravity Horn permite-lhe manipular a levitação ao seu redor, sendo uma ferramenta mágica essencial para o controlo do campo de batalha."
	]
	quest.4400000000000003.title: "O Chifre da Gravidade"
	quest.4400000000000004.quest_desc: ["Mande-me as fotos ou a lista das ferramentas para eu preencher a árvore completa e manter a nossa obra-prima de missões perfeita!"]
	quest.4400000000000004.title: "Mais Segredos a Revelar"
	quest.4400000000000011.quest_desc: [
		"Uma arma para quem caminha nas sombras."
		""
		"Forjada com Nyxite (a gema sombria) [cite: 19], a Shadowstep Dagger permite-lhe realizar um avanço rápido (dash) ou teleporte de curto alcance, garantindo ataques furtivos mortais[cite: 5]."
	]
	quest.4400000000000011.title: "Passos Sombrios"
	quest.4400000000000012.quest_desc: [
		"A lâmina tóxica."
		""
		"Feita com a temível gema Venomyte [cite: 23], a Venomfang Blade garante que todos os inimigos que provarem do seu fio de corte sofram com o efeito potente de Veneno[cite: 10]."
	]
	quest.4400000000000012.title: "A Lâmina Venenosa"
	quest.4400000000000013.quest_desc: [
		"Não há onde se esconder."
		""
		"O Ghost Bow é um arco fantástico feito com Nyxite. Ele dispara flechas que ignoram barreiras físicas, atravessando blocos ou entidades[cite: 6]!"
		"Maximize o seu dano criando a munição de elite: Nyxite Arrows[cite: 16]."
	]
	quest.4400000000000013.title: "O Arco Fantasma"
	quest.4400000000000021.quest_desc: [
		"O poder solar."
		""
		"Usando Phoenixtone, forje o Phoenixfire Staff[cite: 20]. Ele atira projéteis de chamas devastadores e pode imbuir o efeito de ressurreição/cura 'Phoenix' em batalha[cite: 7]."
	]
	quest.4400000000000021.title: "Chamas da Fénix"
	quest.4400000000000022.quest_desc: [
		"Controle o deserto."
		""
		"O Sandburst Staff utiliza as areias do tempo para repelir agressivamente os inimigos ou causar danos em grande área ao seu redor[cite: 8]."
	]
	quest.4400000000000022.title: "Explosão de Areia"
	quest.4400000000000023.quest_desc: [
		"Os céus obedecem-lhe."
		""
		"Canalizado através do cristal Prismyte [cite: 21], o Thunder Prism é um artefato puro que liberta energia elétrica formidável, saltando de inimigo em inimigo através de raios de luz[cite: 9]!"
	]
	quest.4400000000000023.title: "Prisma do Trovão"
	quest.4400000000000031.quest_desc: [
		"O controlo do campo de batalha."
		""
		"Forjado com o denso Gravitium[cite: 18], a Gravity Horn é uma buzina mágica impressionante. Ao tocá-la, altera a gravidade para puxar inimigos na sua direção ou empurrá-los para longe[cite: 14]!"
	]
	quest.4400000000000031.title: "Chifre da Gravidade"
	quest.4400000000000032.quest_desc: [
		"A natureza a seu favor."
		""
		"Este Totem usa as energias da gema Verdantite para criar uma área de cura massiva e suporte para si e os seus aliados durante batalhas difíceis[cite: 15]."
	]
	quest.4400000000000032.title: "Totem Verdejante"
	quest.4400000000000033.quest_desc: [
		"A bênção das chamas."
		""
		"Um amuleto essencial que lhe concede proteção contra o fogo e regeneração de vida passiva sem precisar de poções[cite: 13]."
	]
	quest.4400000000000033.title: "Amuleto da Fénix"
	quest.4400000000000034.quest_desc: [
		"Congelamento imediato."
		""
		"Este amuleto imbui os seus ataques corpo a corpo com o efeito 'Glacial Fist', tornando os seus golpes capazes de congelar e lentificar os alvos[cite: 11]."
	]
	quest.4400000000000034.title: "Amuleto Glacial"
	quest.4400000000000035.quest_desc: [
		"Desperte a Fúria!"
		""
		"Perfeito para combates de curta distância, aumenta passivamente os seus atributos ofensivos ou aplica o poderoso estado de 'Rage' ao seu personagem[cite: 12]."
	]
	quest.4400000000000035.title: "Amuleto de Batalha"
	quest.4459D9D1B2790D50.title: "Alvo: Shadow"
	quest.445B85F7A95F5D03.quest_desc: ["Variante de Ouro. Rápida mas frágil."]
	quest.445B85F7A95F5D03.title: "Chakram de Ouro"
	quest.445DA74B2DD9D595.quest_desc: ["Depthrock é a pedra fundamental da dimensão. Todas as ferramentas iniciais do Undergarden devem ser feitas combinando Depthrock com gravetos de madeira Smogstem/Wigglewood."]
	quest.445DA74B2DD9D595.title: "A Pedra Profunda"
	quest.44CDEF3AE1CD7C10.quest_desc: ["O Inscriber normal é lento e chato. O Kinetic Inscriber (do Create Applied Kinetics) usa energia rotacional para estampar processadores em altíssima velocidade!"]
	quest.44CDEF3AE1CD7C10.title: "Create: Prensa Cinética"
	quest.44D3A107C9BE78D6.quest_desc: ["A madeira quebra, a pedra resiste. Com isso, os monstros básicos começarão a ser um problema real."]
	quest.44FC86B844763A2A.quest_desc: ["A placa-mãe. Cada face do ME Controller fornece 32 canais. Você pode construir um cubo gigante de até 7x7x7 para redes industriais infinitas."]
	quest.44FC86B844763A2A.title: "O Cérebro (Controller)"
	quest.4500000000000001.quest_desc: [
		"As lendas ganham vida."
		""
		"Explorando os recantos mais profundos ou derrotando feras ancestrais, você encontrou um Ovo de Drakvyrn Vermelho (Red Drakvyrn Egg)!"
		"O que será necessário para chocar esta criatura majestosa e torná-la sua aliada?"
	]
	quest.4500000000000001.title: "A Lenda dos Drakvyrns"
	quest.4500000000000002.quest_desc: [
		"Para explorar os ninhos destas feras, você precisará de uma iluminação especial."
		""
		"A Tocha Abissal (Abyssal Torch) emite uma luz mística que afasta as trevas e guia o seu caminho."
	]
	quest.4500000000000002.title: "A Luz do Abismo"
	quest.4500000000000003.quest_desc: [
		"O material base da forja dracónica."
		""
		"Reúna as escamas/lingotes das feras para começar a fabricar o seu equipamento supremo."
	]
	quest.4500000000000003.title: "O Sangue da Fera"
	quest.4500000000000011.quest_desc: ["Proteção absoluta para a cabeça, forjada com o poder dos Drakvyrns."]
	quest.4500000000000011.title: "Elmo Dracónico"
	quest.4500000000000012.quest_desc: ["A couraça que suporta o fogo e os golpes mais duros."]
	quest.4500000000000012.title: "Peitoral Dracónico"
	quest.4500000000000013.quest_desc: ["Agilidade e defesa fundidas num só equipamento."]
	quest.4500000000000013.title: "Perneiras Dracónicas"
	quest.4500000000000014.quest_desc: ["Passos pesados e firmes para explorar as piores cavernas."]
	quest.4500000000000014.title: "Botas Dracónicas"
	quest.4500000000000021.quest_desc: ["Uma lâmina sedenta por batalha, desenhada para abater monstros de elite."]
	quest.4500000000000021.title: "Espada Dracónica"
	quest.4500000000000022.quest_desc: ["A ferramenta suprema para rasgar minérios na velocidade da luz."]
	quest.4500000000000022.title: "Picareta Dracónica"
	quest.4500000000000023.quest_desc: ["Corte árvores inteiras ou esmague os escudos inimigos."]
	quest.4500000000000023.title: "Machado Dracónico"
	quest.4500000000000024.quest_desc: ["A pá mais resistente já forjada."]
	quest.4500000000000024.title: "Pá Dracónica"
	quest.451D7848A6E42C0A.title: "Alvo: Butterfly"
	quest.45411B85CAEE5278.title: "Alvo: Phoenix"
	quest.4585299286092BE5.title: "Alvo: Revenant"
	quest.45B7E04AC1782E90.quest_desc: [
		"O folclore brasileiro despertou no Minecraft."
		""
		"Prepare-se para explorar novos biomas, realizar rituais sombrios e caçar lendas para forjar equipamentos e feitiços absurdos."
	]
	quest.45EBEBC2485A930D.title: "Sai de Ouro"
	quest.4600000000000001.quest_desc: [
		"Nos bosques e planícies floridas, você encontrará ninhos guardados por pequenos dragões agressivos chamados Draklets."
		""
		"Derrote-os para obter as suas presas (Teeth), chifres (Horns) e escamas (Scutes). Com eles, pode forjar a perigosa Adaga de Draklet (Draklet Dagger) que aplica veneno nos inimigos!"
	]
	quest.4600000000000001.title: "Caçador de Draklets"
	quest.4600000000000002.quest_desc: [
		"Você não precisa de matar todos! Pode domesticar um Draklet selvagem utilizando Carne Crua no Osso (Raw Meat On A Bone)."
		""
		"Ele irá segui-lo para todo o lado, atacará os seus inimigos e pode ser equipado com armaduras para pet!"
	]
	quest.4600000000000002.title: "O Primeiro Companheiro"
	quest.4600000000000003.quest_desc: [
		"Nas montanhas e florestas, procure por gigantescas estruturas antigas de pedra em formato de mão."
		""
		"No topo da mão, usando pelo menos uma Picareta de Diamante, quebre o pedestal e recolha o Ovo Ancestral (Ancient Egg)."
	]
	quest.4600000000000003.title: "A Mão do Drakvyrn"
	quest.4600000000000004.quest_desc: [
		"Para chocar o ovo, você deve recriar o ambiente infernal destes dragões."
		""
		"Coloque um bloco de Netherrack no chão, coloque o Ovo por cima e acenda os 4 lados do bloco com fogo (usando um Isqueiro). Espere um pouco... e o Drakvyrn adulto irá nascer!"
	]
	quest.4600000000000004.title: "O Ritual de Fogo"
	quest.4600000000000005.quest_desc: [
		"Do espólio do grande dragão caído, você recolheu a Ignition Breath Ball e ossos fortíssimos."
		""
		"Forje o Cajado da Ignição (Ignition Staff)! Esta arma brutal é híbrida: bate com força letal de perto e dispara grandes bolas de fogo aos inimigos de longe."
	]
	quest.4600000000000005.title: "Cajado da Ignição"
	quest.4600000000000006.quest_desc: [
		"Com os ossos dracónicos recolhidos, forje a brutal Foice (Scythe)!"
		"Ela tem força equiparada ao diamante mas com um alcance de ataque muito maior!"
	]
	quest.4600000000000006.title: "Armas de Osso"
	quest.4600000000000007.quest_desc: ["Estes dragões sem asas caminham a alta velocidade na neve. Quando montados, podem correr por cima da água solidificando-a!"]
	quest.4600000000000007.title: "Os Drozens Glaciais"
	quest.4600000000000008.quest_desc: ["A Frosted Drozen Spear atira projéteis gelados que aplicam Lentidão III ao seu alvo."]
	quest.4600000000000008.title: "A Lança de Gelo"
	quest.4600000000000009.quest_desc: ["Os Draekhalde espalham cegueira a quem os tenta atacar. Eles largam a Sandy Toxin e as Escamas do Deserto."]
	quest.4600000000000009.title: "Os Draekhalde"
	quest.460000000000000A.quest_desc: ["A Cimitarra da Miragem (Scimitar of the Mirage) é incrivelmente poderosa e aplica o efeito de Cegueira aos oponentes."]
	quest.460000000000000A.title: "Miragens e Areia"
	quest.460000000000000B.quest_desc: ["O dragão aquático é raríssimo e caça nas profundezas do oceano."]
	quest.460000000000000B.title: "O Drakthal Abissal"
	quest.460000000000000C.quest_desc: [
		"A Abyssal Rapier permite dar um veloz 'Dash' para a frente debaixo de água."
		"As Tochas Abissais iluminam perfeitamente os oceanos!"
	]
	quest.460000000000000C.title: "Senhor dos Mares"
	quest.460000000000000D.quest_desc: ["O Ancient Ring permite-lhe guiar plenamente os Drakvyrns. Sente-os clicando ao mesmo tempo que se agacha (SNEAK)."]
	quest.460000000000000D.title: "O Anel de Controlo"
	quest.4600000000000100.quest_desc: [
		"Os Drakvyrns existem em dezenas de variantes por todos os biomas."
		""
		"Cace todas as cores, recolha as escamas e forje cada conjunto de armadura. Complete esta gigantesca galeria de arte dracónica para provar a sua supremacia!"
	]
	quest.4600000000000100.title: "A Grande Forja Dracónica"
	quest.4600000000000113.title: "Perneiras Vermelhas"
	quest.4600000000000114.title: "Botas Vermelhas"
