	quest.4B78BF8EC6A9C524.title: "Alvo: Swamp Skeleton"
	quest.4B95E0DE4718479F.quest_desc: ["O Co-Processador permite que a rede use várias máquinas ao mesmo tempo para o mesmo craft. Velocidade total!"]
