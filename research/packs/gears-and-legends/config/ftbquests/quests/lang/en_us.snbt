	quest.5000000000000007.title: "Prensagem"
	quest.5000000000000009.quest_desc: ["Cobre e zinco. O material perfeito para os alternadores."]
	quest.5000000000000009.title: "Base das Máquinas"
	quest.500000000000000B.quest_desc: ["O Rolling Mill estica as placas até virarem arames."]
	quest.500000000000000B.title: "O Afinador"
