	quest.7176E0C2FCCDBB6E.quest_desc: ["Train the custom &5Chaos Guardian Data Model&r and run it in a Simulation Chamber. A successful simulation produces a dedicated prediction that the Loot Fabricator can convert into a &6Dragon Heart&r. This creates a renewable source for late-game Draconic Fusion Crafting without making Chaos Shards farmable."]
	quest.7176E0C2FCCDBB6E.quest_subtitle: "Simulate chaos, preserve progression"
	quest.7176E0C2FCCDBB6E.title: "&#B026FF» &fChaos Guardian Prediction &#B026FF«"
