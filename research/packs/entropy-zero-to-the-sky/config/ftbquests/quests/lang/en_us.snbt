	quest.40BC67BDEE15D1DE.title: "&dSource Gems"
	quest.40C5C355B6DA1893.quest_desc: ["The Pocket Generator is a handheld generator that uses burnable items to charge items and tools in the player's inventory, the Pocket Generator is compatible with the Fuel Canister."]
