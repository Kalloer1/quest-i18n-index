	quest.3DEA6BCF3DD509D9.title: "§3» §bEnhancement Offset §3«"
	quest.3DEF6BC2C123E676.quest_desc: ["An adjustable version, with the &6Dominion Wand&r, as always. Also accepts all of those cool lenses that are coming up."]
	quest.3DEF6BC2C123E676.quest_subtitle: "That was targeted"
	quest.3DF6354F7AC8D4A4.quest_desc: ["Install the &eAdvanced Upgrade&r to push compatible machines beyond their base limits. Upgrade power delivery before increasing operating speed."]
