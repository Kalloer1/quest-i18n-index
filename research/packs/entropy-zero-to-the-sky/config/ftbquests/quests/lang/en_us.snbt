	quest.22912689D30ACC2D.title: "§b» §fCrafting Unit §3«"
	quest.2296CE4418AE62D4.quest_desc: ["Assemble &bAllthemodium Hat&r for &lArcane Protection&r. It provides magical defense that trades simple armor values for specialized effects. Compare its protection, power cost and utility before replacing your current set."]
	quest.2296CE4418AE62D4.quest_subtitle: "Armor piece"
	quest.2296CE4418AE62D4.title: "&#C786FF» &fAllthemodium Hat &#C786FF«"
