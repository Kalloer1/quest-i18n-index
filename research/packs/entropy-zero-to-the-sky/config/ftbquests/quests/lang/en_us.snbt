	quest.03C059DFF8F1BF41.quest_desc: ["Assemble &bEmerald Chestplate&r for &lLiving & Composite Armor&r. It provides alternative protection built from cultivated, flexible or unusual materials. Compare its protection, power cost and utility before replacing your current set."]
	quest.03C059DFF8F1BF41.quest_subtitle: "Armor piece"
