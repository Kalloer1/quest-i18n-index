	quest.79D6F21C1E1D1749.quest_desc: ["A controlled barrel recipe turns water and lava into obsidian without risking the island's only lava source. Keep several blocks for portals and early machines."]
	quest.79D6F21C1E1D1749.quest_subtitle: "Water meeting lava"
	quest.79D6F21C1E1D1749.title: "&#38BDF8» &fObsidian, Safely &#38BDF8«"
	quest.79E30114ED8870EE.quest_desc: ["Build &bSteel Sword&r as part of &lEngineered Weapons&r. It supports technical weapons designed around advanced materials and energy. Treat it as infrastructure: automate its materials before relying on it for repeated work."]
	quest.79E30114ED8870EE.quest_subtitle: "Weapon"
	quest.79E30114ED8870EE.title: "&#62D7E8» &fSteel Sword &#62D7E8«"
