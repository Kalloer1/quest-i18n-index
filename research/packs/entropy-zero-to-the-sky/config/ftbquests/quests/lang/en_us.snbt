	quest.7A979BEB20C9591E.title: "&a»&r &fCheckpoint&a «"
	quest.7A98FCB88B49E8B5.quest_desc: ["An upgrade module used to fine-tune item, fluid or energy routing."]
	quest.7A98FCB88B49E8B5.quest_subtitle: "Logistics upgrade"
	quest.7A98FCB88B49E8B5.title: "&a»&r &fFlight Card&a «"
	quest.7AADB58621BC1254.quest_desc: ["The Forge Hammer and the Hammer will save you a lot of resources early game by allowing you to turn ingots into plates and other different shapes at a reduced cost! Eventually you'll use Steam to do this for you, but early on this will help you save costs while you work towards your automation."]
	quest.7AADB58621BC1254.title: "Forge and Hammer"
	quest.7AB08C8214B636A7.quest_desc: ["Build Pattern Encoding Terminal and integrate it into the appropriate ME subsystem. Keep the network modular so later upgrades remain easy to automate."]
	quest.7AB08C8214B636A7.title: "§b» §fPattern Encoding Terminal §3«"
	quest.7AB5B92CD5934106.quest_desc: [
		"The compressor is going to be a pinch point in this mod. It has a lot of processes it can do. "
		""
		"This block allows you to automate the things you have been doing on the forge."
		""
		"You will likely want multiple of these doing different things. (plate creation, curved plate creation, ring creation)"
	]
	quest.7ACE24AC62D35199.quest_desc: ["&7Five constellations test production, engineering, combat, exploration and advanced crafting. Each has &6Bronze&r, &fSilver&r and &eGold&r milestones.\n\nEvery reward is an &dEntropy Token&r. Combine a token with the required previous-tier item to obtain a premium end-of-mod upgrade. No trophy, singularity or creative item is involved."]
	quest.7ACE24AC62D35199.title: "&#D946EF» &fEntropy Trials &#D946EF«"
	quest.7AD6E01ED01E6F13.quest_desc: ["A checkpoint marking your progress through this chapter."]
	quest.7AD6E01ED01E6F13.quest_subtitle: "Checkpoint"
	quest.7AD6E01ED01E6F13.title: "&a»&r &fCheckpoint&a «"
	quest.7ADE214373DE135F.quest_desc: ["Cultivate Creeper as part of the Tier progression. Automate harvesting before expanding into the next resource group."]
	quest.7ADE214373DE135F.quest_subtitle: "Farming"
	quest.7ADE214373DE135F.title: "§d» §fCreeper §5«"
	quest.7ADFD864139BF2F2.quest_desc: [
		"Welcome to &6Entropy Zero: To The Sky&r. Beneath this tiny island is nothing but the void, so every block and every resource matters."
		""
		"This chapter teaches the complete opening loop: protect the island, multiply its resources, create water and lava, process ores, then generate your first power."
		""
		"Read each quest before crafting. Many recipes and mechanics differ from ordinary Minecraft. &bJEI&r is your best companion whenever you need to check a recipe."
	]
	quest.7ADFD864139BF2F2.quest_subtitle: "Your Entropy Zero journey begins here"
	quest.7ADFD864139BF2F2.title: "&#00D4FF» &fAwakening Above the Void &#00D4FF«"
