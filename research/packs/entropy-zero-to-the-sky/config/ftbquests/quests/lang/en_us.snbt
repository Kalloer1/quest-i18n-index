	quest.7ECC000000000001.quest_desc: [
		"&7Processor production now uses &6Create &7exclusively."
		"&7Build a Mechanical Press and a Deployer to begin."
	]
	quest.7ECC000000000001.quest_subtitle: "&7The new processor workshop"
	quest.7ECC000000000001.title: "&6» &eCreate Processor Workshop &6«"
	quest.7ECC000000000002.quest_desc: [
		"&7Place the Universal Press in the Deployer hand."
		"&7It is retained by every printing recipe."
