	quest.3CB05026BC4C5577.quest_desc: [
		"&b◆ &fEntropy Industry &8• &7Digital Protocol"
		""
		"Blastproof Alloy Plate is a strategic digital resource. Produce it in repeatable batches, keep a buffered stock, and route the line into storage before unlocking the next process."
	]
	quest.3CB05026BC4C5577.quest_subtitle: "Crafting material"
	quest.3CB05026BC4C5577.title: "&a»&r &fBlastproof Alloy Plate&a «"
	quest.3CB5A80BD323727E.quest_desc: ["A useful item for progressing through this chapter."]
	quest.3CB5A80BD323727E.quest_subtitle: "Item"
	quest.3CB5A80BD323727E.title: "&a»&r &fAndesite Cell&a «"
	quest.3CB6DC5B09C62CFE.quest_desc: ["&5Ender Gates&r are used to transfer power wirelessly to and from an adjacent block into the &7Ender Network&r.\\n\\nThink of these like wireless access points to your wireless network of power.\\n\\nNote: You can only add &apower storage capacity&r using an Ender Cell."]
	quest.3CB7884B7B32CF00.quest_desc: ["Getting your first &bEther Gas&r might be a little bit scary.\\n\\n&bEther Gas&r is made from drilling a Wither, using a Fluid Drill with a &5Purple Lens&r.\\n\\nBut don't worry about the Wither, Industrial Foregoing has a machine just to help you with that task. The &4Stasis Chamber&r is a machine that freezes in place anything that is on top of it in a 3x3 area, including the Wither.\\n\\n&cHope you don't run out of power, because if you do... I hope you're ready to fight the &0Wither&c. Because of this, I recommend using some kind of Wither-Proof Glass, such as Tinted Glass from Mob Grinding Utils, or Crystalix Glass with Reinforced Mode enabled.&c"]
	quest.3CB7884B7B32CF00.quest_subtitle: "Ether Gas? Huh?"
	quest.3CB7AB928D3E1CC6.quest_desc: ["A rare crystal or gem used in advanced crafting or magical recipes."]
	quest.3CB7AB928D3E1CC6.quest_subtitle: "Rare material"
	quest.3CB7AB928D3E1CC6.title: "&a»&r &fCrystal Blazing&a «"
	quest.3CB8F5F1D33C8F9F.quest_desc: ["Same as the previous quest, just more, a lot more."]
	quest.3CB8F5F1D33C8F9F.title: "Wyvern Large Shield Capacity Module"
	quest.3CBB78C9B8D3665E.quest_desc: [
		"&lAbility Type:&r Passive"
		""
		"&lAbility Function:&r"
		""
		"Reduces the detection range of hostile mobs."
	]
	quest.3CBF4D703AA17199.quest_desc: ["&a&lProductive Farming&r is the (at the time of making this) the newest Productive Mod. \\n\\nThis Mod brings an auto Farm Multiblock Structure, new Crops, and more Flowers and dye Colors for them! \\n\\nIt also works hand-in-hand with &6&lProductive Bees&r and &l&cD&6y&ee&an&ba&dm&ci&6c&es&r!"]
	quest.3CBF4D703AA17199.quest_subtitle: "How many Mods is he going to make?"
	quest.3CBF4D703AA17199.title: "&a&lProductive Farming"
	quest.3CCBE9BBCA8ADA38.quest_desc: ["Used to transmit power, fluid or items between machines and devices."]
	quest.3CCBE9BBCA8ADA38.quest_subtitle: "Power transport"
	quest.3CCBE9BBCA8ADA38.title: "&a»&r &fSupercharged Coil&a «"
	quest.3CD657695136434F.quest_desc: ["Build Inscriber and integrate it into the appropriate ME subsystem. Keep the network modular so later upgrades remain easy to automate."]
	quest.3CD657695136434F.title: "§b» §fInscriber §3«"
	quest.3CDF1981A930B6C5.quest_desc: [
		"The &aKinetic Bridge&f transfers stress from one network to another."
		""
		"You can control exactly how much stress is transferred to the secondary network inside its interface."
		""
		"Stress capacity is still shared between both networks, but an &2Overstress Clutch&f won't stall the main network if the secondary network would cause an overstress."
	]
	quest.3CDF1981A930B6C5.title: "§6» §eKinetic Bridge §6«"
	quest.3CE3CDB9C93CBDAD.quest_desc: ["Moves items, fluids or energy in or out of a connected inventory."]
