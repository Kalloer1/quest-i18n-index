	quest.5401B18217772D6C.quest_desc: ["The &eHeat Exchanger&r moves heat between fluids and helps recover energy from demanding thermal processes. This is a key Electric Era automation milestone."]
	quest.5401B18217772D6C.title: "&b» &fHeat Exchanger &b«"
	quest.5408B401317E94E4.quest_desc: ["A mystical item tied to this chapter's magic system."]
	quest.5408B401317E94E4.quest_subtitle: "Magic item"
	quest.5408B401317E94E4.title: "&a»&r &fGlyph Harvest&a «"
	quest.5408C57600A556AE.quest_desc: ["Tired of vanilla droppers needing redstone and throwing items everywhere? Try the &aSimple Dropper&r! You can precisely control quantity and throughput with these."]
	quest.5408C57600A556AE.title: "&aSimple Dropper"
	quest.540B857F043C24D5.quest_desc: ["The Bioreactor produces &5Biofuel&r with &9Water&r and a bunch of different materials (check JEI for all valid Bioreactor Inputs). The more types of materials you provide, the more efficient the Bioreactor is at producing &5Biofuel&r.\\n\\nThe Biofuel Generator uses &5Biofuel&r made from the &5Bioreactor&r to generate FE."]
	quest.540B857F043C24D5.title: "Bio Power"
	quest.540F3CA118762DDB.quest_desc: ["The &cFeeding Trough&r is a Block added by &a&lProductive Farming&r. \\n\\nIt has 9 Inventory Slots each that can hold a Stack of &cAnimal Feed&r that needs to be Piped in. \\n\\nWhat sort of &cAnimal Feed&r? \\n\\nAnything that is used to Breed 2 Animals (of the same species) will do! Wheat? Yeah! Bamboo? Yeah! Just make sure Bamboo is Planted near them."]
	quest.540F3CA118762DDB.quest_subtitle: "Item"
	quest.540F3CA118762DDB.title: "&cFeeding Trough"
	quest.54169B69725C49DF.quest_desc: ["Place your Liquid Plastic onto the ground or store some in a Chest with a Heat Frame attached and there's your &3Plastic Sheet&r!"]
	quest.54169B69725C49DF.quest_subtitle: "Finally!"
	quest.54169B69725C49DF.title: "&fPlastic"
	quest.541D270451DA4320.quest_desc: ["Used to build and power your railway network."]
	quest.541D270451DA4320.quest_subtitle: "Railway"
