	quest.7FA34CEB41A4D9F5.quest_desc: ["Build §bFire Clay Bricks§r and connect it to the appropriate Entropy production line. Check JEI for the customized recipe, then automate the process before advancing along this branch."]
	quest.7FA34CEB41A4D9F5.title: "§b» §fFire Clay Bricks §3«"
	quest.7FABB77A60E7962C.quest_desc: ["Assemble &bRefined Obsidian Chestplate&r for &lIndustrial Armor&r. It provides powered protection built for factories and hazardous engineering. Compare its protection, power cost and utility before replacing your current set."]
	quest.7FABB77A60E7962C.quest_subtitle: "Armor piece"
	quest.7FABB77A60E7962C.title: "&#55C7E8» &fRefined Obsidian Chestplate &#55C7E8«"
	quest.7FB12EC3A5888123.quest_desc: ["The &3Tube Junction&r gives you more control over the transportation of your pressure by allowing you to move your Pressure Tubes in more directions."]
	quest.7FB12EC3A5888123.quest_subtitle: "No, go this way!"
	quest.7FB3CF462ECBDD75.quest_desc: ["A mystical item tied to this chapter's magic system."]
	quest.7FB3CF462ECBDD75.quest_subtitle: "Magic item"
