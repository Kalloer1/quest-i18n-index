	quest.3CE3CDB9C93CBDAD.title: "&a»&r &fPart Interface Crafting&a «"
	quest.3CE3D9245F8EC005.quest_desc: ["The fourth MEGA tier of storage component, providing &e67108864&f (65536k) bytes of storage."]
	quest.3CE3D9245F8EC005.quest_subtitle: "x4^3"
	quest.3CE3D9245F8EC005.title: "64M Storage Component"
	quest.3CE5A863271DF6D2.quest_desc: ["A brewed concoction with a magical effect when consumed."]
	quest.3CE5A863271DF6D2.quest_subtitle: "Alchemy"
	quest.3CE5A863271DF6D2.title: "&a»&r &fPotion Brewer&a «"
	quest.3CE72DAF431269CD.quest_desc: [
		"&e◆ &fEntropy Industry &8• &7Electric Protocol"
		""
		"Polarizer is a key processing station in the Entropy electric production line. Give it dedicated inputs and outputs, keep one recipe running to build efficiency, then duplicate the line when throughput becomes the bottleneck."
	]
	quest.3CE72DAF431269CD.quest_subtitle: "Processing machine"
	quest.3CE72DAF431269CD.title: "&a»&r &fPolarizer&a «"
	quest.3CF25E652ACE48CF.quest_desc: ["A useful item for progressing through this chapter."]
	quest.3CF25E652ACE48CF.quest_subtitle: "Item"
	quest.3CF25E652ACE48CF.title: "&a»&r &fCell Component 16m&a «"
	quest.3CF32F2314839B1D.quest_desc: [
		"Getting tired of your budding Certus Quartz and Entroized Fluix decaying? We can fix it! With this Crystal Fixer, you can fix Budding Certus Crystals with Charged Certus Quartz, and Entroized Fluix with Ender Dust."
		""
		"It even has a small chance to make Flawless Budding Certus Quartz."
	]
	quest.3CF32F2314839B1D.title: "Get-Yer-Crystals-Fixed: The Crystal Fixer"
	quest.3CFD798362605880.quest_desc: [
		"&lAbility Type:&r Passive"
		""
		"&lAbility Function:&r"
		""
		"Makes Potion Arrows fired by the Bow have a Splash effect, hitting multiple targets in an area."
	]
	quest.3CFE522A4B7CC2EC.quest_desc: [
		"The &3Reinforced Chest&r is a blast-proof Chest with 36 slots. Not Double Chest-able. Also works like a Shulker Box."
		"{image:entropy:textures/questpics/pneumaticcraft/reinforced_chest_ui.png width:200 height:100 align:center}"
	]
	quest.3CFE522A4B7CC2EC.quest_subtitle: "Better than your Everyday Chest"
	quest.3D0FE8A0EA0E9177.quest_desc: ["Welcome to &lChapter 2&r! \\n\\nYou should now have access to most of the simplest Materials, now we can start venturing into other Mods and Farms. \\n\\nDid you forget it is an &6&lATM Modpack&r? You'll need Farms!"]
	quest.3D0FE8A0EA0E9177.title: "&lThe Cool Parts"
	quest.3D1796B4F460DBBF.quest_desc: ["Connect separate network sections while controlling direction and access. Use the omni-directional version when data must travel freely between branches."]
	quest.3D1796B4F460DBBF.title: "§3» §bConnector Omni Directional §3«"
	quest.3D18304923D46061.quest_desc: [
		"Harvests daylight to produce RF without consuming any resource."
		"Blazing tier."
	]
	quest.3D18304923D46061.quest_subtitle: "Blazing · Daylight RF generator"
	quest.3D18304923D46061.title: "&a»&r &bBlazing &fSolar Panel&a «"
