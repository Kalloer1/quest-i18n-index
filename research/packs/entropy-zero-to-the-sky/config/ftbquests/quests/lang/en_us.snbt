	quest.2EE8FCB63A338BC4.quest_desc: [
		"The &zRainbow Furnace&r needs quite literally every other Furnace to Craft. 8 &zRainbow Plating&r and 1 &zRainbow Core&r gives us the best Furnace we could imagine!"
		""
		"Yes it takes 20 Ticks to smelt or 1 Second to smelt, but it doesn't smelt 1 item. How many items you ask? How many are in a stack of items?"
	]
	quest.2EE8FCB63A338BC4.title: "&zRainbow Furnace"
	quest.2EF0C033C540A7B1.quest_desc: [
		"&e◆ &fEntropy Industry &8• &7Electric Protocol"
		""
		"Ruby Processing marks a required step in the Entropy electric industrial route. Complete it as part of a repeatable production chain instead of crafting only a single copy by hand."
	]
