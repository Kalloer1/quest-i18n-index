	quest.7ECC000000000002.quest_subtitle: "&7One press for every processor"
	quest.7ECC000000000002.title: "&5» &dUniversal Press &5«"
	quest.7ECC000000000003.quest_desc: [
		"&7You now have two valid production routes. The &bAE2 Inscriber&r keeps its original x1 recipe, while a &6Create Mechanical Press&r produces &ax2 Printed Silicon&r from the same input."
		"&7Use the Inscriber for a compact early setup or Create when your factory needs continuous high-throughput production."
	]
	quest.7ECC000000000003.quest_subtitle: "&7Inscriber x1 • Create x2"
	quest.7ECC000000000003.title: "&b» &3Printed Silicon &b«"
	quest.7ECC000000000004.quest_desc: ["&7Logic, Calculation, Engineering and addon prints retain their original machine recipes. The industrial alternative uses the reusable &dUniversal Press&r in a Deployer and returns &ax2 prints&r per material."]
	quest.7ECC000000000004.quest_subtitle: "&7Original recipes or Create x2"
	quest.7ECC000000000004.title: "&6» &eProcessor Prints &6«"
	quest.7ECC000000000005.quest_desc: ["&7Apply each addon print to Printed Silicon with a second Deployer."]
	quest.7ECC000000000005.quest_subtitle: "&7Second Deployer operation"
	quest.7ECC000000000005.title: "&d» &5Advanced Processors &d«"
