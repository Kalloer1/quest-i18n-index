	quest.7FF617DC8394D83B.title: "&#FFD700» &fEngineering: Gold &#FFD700«"
	quest.C210000000000001.quest_desc: ["The Magmatic Generator turns your renewable lava into a steady supply of Forge Energy. Keep the crucible running and give the generator a buffer before attaching machines."]
	quest.C210000000000001.title: "&#F97316» &fHarnessing Lava &#F97316«"
	quest.C210000000000002.quest_desc: ["Energy Pipes move FE from generators to machines. Use the Pipez wrench on the generator side to set extraction, then verify that power reaches the destination."]
	quest.C210000000000002.title: "&#EAB308» &fThe First Power Line &#EAB308«"
	quest.C210000000000003.quest_desc: ["The Metallurgic Infuser is the entrance to Mekanism. It combines base materials with redstone, carbon and other infuse types to create alloys and circuits."]
	quest.C210000000000003.title: "&#7C3AED» &fInfusing the Future &#7C3AED«"
	quest.C210000000000004.quest_desc: ["Mekanism cables form a clean internal power network. Their tier controls transfer capacity, so leave room to upgrade busy lines later."]
	quest.C210000000000004.title: "&#06B6D4» &fUniversal Cables &#06B6D4«"
	quest.C210000000000005.quest_desc: ["An Energy Cube absorbs excess generation and supplies machines when demand spikes. Place it between generation and the main cable network."]
	quest.C210000000000005.title: "&#3B82F6» &fStore the Current &#3B82F6«"
	quest.C210000000000006.quest_desc: ["The Enrichment Chamber improves several material-processing recipes and prepares enriched infuse materials. It is the first machine that truly reduces waste."]
	quest.C210000000000006.title: "&#22C55E» &fEnrich the Yield &#22C55E«"
	quest.C210000000000007.quest_desc: ["The Crusher automates transformations that previously depended on hammers or manual crafting. Connect power and reserve dedicated input and output inventories."]
	quest.C210000000000007.title: "&#EF4444» &fMechanical Crushing &#EF4444«"
	quest.C210000000000008.quest_desc: ["Your island now produces, transports and stores energy while running its first processing line. Confirm this milestone to unlock island-wide automation."]
	quest.C210000000000008.title: "&#F97316» &fIndustry Online &#F97316«"
	quest.C310000000000001.quest_desc: ["Item and fluid pipes are the veins of an automated island. Separate inputs from outputs and use the wrench to configure extraction only where it is required."]
	quest.C310000000000001.title: "&#14B8A6» &fMove Everything &#14B8A6«"
	quest.C310000000000002.quest_desc: ["A Stone Generator continuously produces blocks into an inventory above it. Feed that inventory into your processing line and manual pebble collection becomes history."]
	quest.C310000000000002.title: "&#64748B» &fStone Without Hands &#64748B«"
	quest.C310000000000003.quest_desc: ["The Sophisticated Storage Controller links nearby compatible storage blocks. Organize resources by function before uncontrolled automation fills every chest."]
	quest.C310000000000003.title: "&#D97706» &fOne Storage Network &#D97706«"
	quest.C310000000000004.quest_desc: ["The Plant Sower replants a managed field automatically. Supply power, seeds and a clear working area beneath the machine."]
	quest.C310000000000004.title: "&#84CC16» &fPlanting on Schedule &#84CC16«"
	quest.C310000000000005.quest_desc: ["Pair a Plant Gatherer with the sower to complete the farming loop. Route harvested seeds back into planting and send the useful output to storage."]
	quest.C310000000000005.title: "&#22C55E» &fHarvest Without Rest &#22C55E«"
	quest.C310000000000006.quest_desc: ["Inferium begins the Mystical Agriculture route. Treat the first seeds as infrastructure: expand them before spending essence on equipment."]
	quest.C310000000000006.title: "&#A855F7» &fEssence Takes Root &#A855F7«"
	quest.C310000000000007.quest_desc: ["The Mob Crusher converts a safe spawning chamber into automated drops and essence. Keep the killing room sealed and provide sufficient storage."]
	quest.C310000000000007.title: "&#DC2626» &fControlled Hostility &#DC2626«"
	quest.C310000000000008.quest_desc: ["Stone, crops, mob drops and storage now operate as connected systems. Confirm the milestone to begin expansion beyond the island."]
	quest.C310000000000008.title: "&#10B981» &fThe Island Sustains Itself &#10B981«"
	quest.C410000000000001.quest_desc: ["Gather enough obsidian for a Nether portal while keeping spare blocks for machines. Build the frame somewhere isolated from fragile automation."]
	quest.C410000000000001.title: "&#7C3AED» &fA Frame Through Reality &#7C3AED«"
	quest.C410000000000002.quest_desc: ["A flint and steel turns the obsidian frame into your first stable dimensional gateway. Bring blocks, food and a return route before entering."]
	quest.C410000000000002.title: "&#F97316» &fIgnite the Threshold &#F97316«"
	quest.C410000000000003.quest_desc: ["Cross into the Nether and establish a protected arrival point. The terrain may not behave like a conventional world, so keep the skyblock production routes available."]
	quest.C410000000000003.title: "&#EF4444» &fInto the Nether &#EF4444«"
	quest.C410000000000004.quest_desc: ["Blaze rods unlock brewing, stronger machines and Eyes of Ender. Secure a repeatable source rather than relying on a single expedition."]
	quest.C410000000000004.title: "&#F59E0B» &fFire in Solid Form &#F59E0B«"
	quest.C410000000000005.quest_desc: ["Collect several ender pearls from your mob systems, sieving routes or other supported production. Later recipes consume them in large quantities."]
	quest.C410000000000005.title: "&#A855F7» &fPearls from the Dark &#A855F7«"
	quest.C410000000000006.quest_desc: ["Combine blaze powder and ender pearls into Eyes of Ender. These components mark the transition from survival infrastructure to dimensional progression."]
	quest.C410000000000006.title: "&#06B6D4» &fEyes Beyond the Sky &#06B6D4«"
	quest.C410000000000007.quest_desc: ["Raw Allthemodium is the first proof that your island has reached the wider progression of the pack. It opens specialized equipment and the routes leading toward the endgame materials."]
	quest.C410000000000007.title: "&#FFD700» &fThe First Allthemodium &#FFD700«"
	quest.C410000000000008.quest_desc: ["The tutorial mainline is complete. Continue through the specialized mod chapters, gather the six elemental shards, and converge on the Entropy Fragment in Endgame Shards."]
	quest.C410000000000008.title: "&#FF8C00» &fThe Endgame Path Opens &#FF8C00«"
	quest.E300000000000001.quest_desc: [
		"&7Before beginning your journey, create or join a &bSkyblock team&7."
		""
		"&fValidate this quest and claim its reward to open the Skyblock interface automatically."
		""
		"&8You can reopen it anytime with &b/skyblock gui&8."
	]
	quest.E300000000000001.subtitle: "&7Initialize your island expedition"
	quest.E300000000000001.title: "&#00D4FF» &fCreate Your Skyblock Team &#00D4FF«"
