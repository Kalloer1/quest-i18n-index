	quest.1A00000000000001.quest_desc: [
		"Welcome to &bGeOre&r!"
		""
		"GeOre introduces &dBudding Ore Blocks&r for virtually all vanilla, modded, and endgame ores."
		""
		"In this modpack, Budding Blocks are created using the &eProductive Metalworks Casting Basin&r by pouring molten metals over base blocks."
		""
		"Once created, Budding Blocks continuously grow ore clusters and shards indefinitely!"
	]
	quest.1A00000000000001.quest_subtitle: "Block Casting Ore Geodes"
	quest.1A00000000000001.title: "&a»&r &fGeOre and Metalworks Intro&a «"
	quest.1A00000000000002.quest_desc: [
		"Cast your first Budding blocks using molten base metals in the &eCasting Basin&r!"
		""
		"&7Ores Included:&r"
		"&7•&r &fBudding Iron&r"
		"&7•&r &cBudding Copper&r"
		"&7•&r &eBudding Gold&r"
		"&7•&r &8Budding Coal&r"
	]
	quest.1A00000000000002.quest_subtitle: "Iron, Copper, Gold and Coal"
	quest.1A00000000000002.title: "&a»&r &fTier 1: Base Metals&a «"
	quest.1A00000000000003.quest_desc: [
		"Cast basic mineral geodes by pouring liquefied minerals into your Casting Basin."
		""
		"&7Minerals Included:&r"
		"&7•&r &cBudding Redstone&r"
		"&7•&r &9Budding Lapis&r"
		"&7•&r &fBudding Quartz&r"
	]
	quest.1A00000000000003.quest_subtitle: "Redstone, Lapis and Quartz"
	quest.1A00000000000003.title: "&a»&r &fTier 1: Base Minerals&a «"
	quest.1A00000000000004.quest_desc: [
		"Pour molten modded metals into your Casting Basin to craft tech and industrial Budding blocks."
		""
		"&7Industrial Metals Included:&r"
		"&7•&r &7Tin, Lead, Silver, Nickel, Zinc, Aluminum&r"
		"&7•&r &bOsmium, Uranium, Uraninite, Platinum&r"
	]
	quest.1A00000000000004.quest_subtitle: "Tech and Industrial Metal Geodes"
	quest.1A00000000000004.title: "&a»&r &fTier 2: Modded Ores&a «"
	quest.1A00000000000005.quest_desc: [
		"Cast rare gem geodes in the Productive Metalworks Casting Basin."
		""
		"&7Precious Gems Included:&r"
		"&7•&r &bBudding Diamond&r"
		"&7•&r &aBudding Emerald&r"
		"&7•&r &cBudding Ruby&r"
		"&7•&r &9Budding Sapphire&r"
		"&7•&r &eBudding Topaz&r"
		"&7•&r &8Budding Black Quartz&r"
	]
	quest.1A00000000000005.quest_subtitle: "Diamonds, Emeralds and Rare Gems"
	quest.1A00000000000005.title: "&a»&r &fTier 2: Precious Gems&a «"
	quest.1A00000000000006.quest_desc: [
		"Mastering the &eProductive Metalworks Casting Basin&r is essential!"
		""
		"Melt high-tier fluids in your Foundry, set a base stone in the Casting Basin below the Faucet, and pour liquid metals to solidify them into infinite Budding GeOre Blocks!"
	]
	quest.1A00000000000006.quest_subtitle: "Fluid Metal Casting Process"
	quest.1A00000000000006.title: "&a»&r &fMetalworks Casting Basin&a «"
