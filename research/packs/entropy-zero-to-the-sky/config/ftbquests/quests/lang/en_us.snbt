	quest.7FD5FCEFE3697A7C.quest_desc: ["Acquire the &eSteam Farmer&r to complete this Electric Era milestone. Check its recipes and automate the required materials before moving deeper into the chapter."]
	quest.7FD5FCEFE3697A7C.title: "&b» &fSteam Farmer &b«"
