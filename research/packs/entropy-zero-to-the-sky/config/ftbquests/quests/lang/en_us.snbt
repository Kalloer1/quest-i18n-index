	quest.232A06C9FF0EE7B2.quest_subtitle: "Automating Menril"
	quest.2331E407E82138AB.quest_desc: ["Integrated Tunnels moves items, fluids and energy through the same logic network. Importers pull resources; exporters push them toward a target."]
	quest.2331E407E82138AB.title: "§3» §bIntegrated Tunnels §3«"
	quest.2338E5269CA23C91.quest_desc: ["The &3Netherite Drill Bit&r is the best Drill Bit, it's even better than the Diamond Drill Bit."]
