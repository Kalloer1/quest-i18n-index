	quest.5BC9A7DF475C788B.quest_subtitle: "Component"
	quest.5BC9A7DF475C788B.title: "&a»&r &fAugment Factory&a «"
	quest.5BCA3F716348ECCD.quest_desc: ["The &9Energy Hopper&r will charge any chargeable item inside of the inventory of the block it is pointed to, like a chest."]
	quest.5BD5737703F3F077.quest_desc: ["Ferricore anchors this stage of the Entropy material chain. Ferricore Form it by spreading Goo across Iron Blocks using tier one goo or higher. Ferricore ore benefits from Fortune."]
	quest.5BD5737703F3F077.title: "Ferricore"
