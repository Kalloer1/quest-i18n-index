	quest.02F85FB89DE65206.quest_desc: ["Build the &bSingularity Compressor&r at a Mystical Agriculture Infusion Altar.\n\nIt condenses a massive quantity of one material into a reusable singularity."]
	quest.02F85FB89DE65206.quest_subtitle: "Foundation Machine"
	quest.02F85FB89DE65206.title: "&#38BDF8» &fSingularity Compressor &#38BDF8«"
