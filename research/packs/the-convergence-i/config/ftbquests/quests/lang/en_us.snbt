	file.0000000000000001.title: "The Convergence"
	quest.0046779192734A8F.quest_desc: ["Drop Chromatic Compound into a beacon beam."]
	quest.0077EBCEFF0C75E7.quest_desc: ["&lCheck Ponder&r"]
	quest.00D47787B02F7B42.quest_desc: ["&lEnergy Transmitter&r - a phantom rotational power transmitter. Supply rotational power to one, set the second one to the same frequency as the first, and the power applied to the first will be transferred to the second."]
	quest.00ED8BDD4D0FD04A.quest_desc: ["Accelerate to the required speed (1 unit on the Speedometer) so that Dormant turns into Charged."]
	quest.0120EE4223F65D95.quest_desc: [
		"&lAndesite Funnel&r can cover conveyor belts."
		""
		"Also, if it is placed at a conveyor intersection, then out of all items that enter it, exactly 1 will be sent to the side, while the rest will continue moving forward."
	]
	quest.0168E7E355DCA092.quest_desc: ["The Magmatic Generator is the most efficient generator at this stage of the game. It produces 40 FE per tick and requires lava to generate energy"]
	quest.01A571C2E662E5A5.quest_desc: [
		"&lCongratulations. You have converged all mods into a single item, whose power can transfer you into &5Creative mode&r.&r"
		""
		"To switch into Creative, right-click while holding the item in your hand. To return to Survival, right-click again."
		""
		"For faster switching, place this item in the Curios slot “The True Creativity”, then press the bound key (default: NumPad “End”) to toggle between Creative and Survival modes."
		"{@pagebreak}"
		"&lThanks for playing this modpack!"
		"I hope you enjoyed your experience.&r"
		"&oYour &3PI7&r.&r"
		"{@pagebreak}"
		"&oOr… is this not the end?...&r"
		"{@pagebreak}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"We will see it soon...\",\"font\":\"runelic:runelic\"}]}"
	]
	quest.01D7920708F0AD7C.quest_desc: ["&lChute&r works like a hopper, but without an inventory, and it transports up to 16 items at once."]
	quest.01E3249F44EFEC7A.title: "Clay"
	quest.022523F42E60B671.quest_desc: ["Allows you to breed and crossbreed bees."]
	quest.0275882D0DC74E81.quest_desc: ["Allows faster block placement"]
	quest.02AD377FAB6E0719.title: "Counter"
	quest.03267BEC9859AC99.quest_desc: ["This ring protects the player from the Levitation effect, and each time it removes it, the player receives 1 full level"]
	quest.0331277B6562AB01.quest_desc: ["If there is a villager, a golden apple, and a potion of weakness, it converts the villager into a zombie, and then back into a villager to give them trading discounts."]
	quest.04632CABF3B98A42.quest_desc: ["Using &lLaser Drills&r and &lOre Laser Base&r from &lIndustrial Foregoing&r, you can generate Eternal Singulariries using Infinity Catalyst as the base."]
	quest.04632CABF3B98A42.title: "Generating Eternal Singularities"
	quest.0467895E65BCB2C3.quest_subtitle: "Convergence of all Tech"
	quest.058000A54ECA8A9A.quest_desc: [
		"&lMob Masher&r - when it receives a redstone signal, it starts spinning and deals damage to all mobs that touch it."
		"&lAbsorption Hopper&r - attracts items and experience orbs. It can be configured to output items or experience in one of 6 directions (into an inventory such as a chest)."
		"&lTinted Glass&r - blocks light from passing through."
	]
	quest.058000A54ECA8A9A.title: "Advanced Mob Grinding"
	quest.059E34799868C7E7.quest_desc: ["Automatically builds a Wither if it has the required materials."]
	quest.06662DA6FC44E1A9.quest_desc: ["&lTransporter&r moves items from one container to another, but it cannot extract items from another Transporter."]
	quest.0746A35E9E7DDA7F.quest_desc: [
		"&l&7Andesite Casings&r&r can be used to cover shafts, cogwheels, and conveyor belts. They can also be used for decorative purposes."
		""
		"To craft them, right-click a stripped log or wood block while holding Andesite Alloy in your hand."
	]
	quest.077BB60FEC99FFD0.quest_desc: [
		"To build the &lClibano&r, construct the following structure:"
		"{image:atm:textures/questpics/convergence/clibano.png width:200 height:100 align:center}"
		"Then right-click the Clibano Core while holding Mundabitur Dust in your hand."
	]
	quest.077BB60FEC99FFD0.title: "Clibano"
	quest.07CED37BC7692F2B.quest_desc: ["Turns the prediction into loot from mobs."]
	quest.0907EDC40F6F7C90.quest_desc: ["&lCheck Ponder&r"]
	quest.0958B28B61711DDE.quest_desc: [
		"Apothic Enchanting has 3 attributes: Eterna, Quanta, and Arcana."
		""
		"- &aEterna&r determines the enchantment level itself. For example, if Eterna = 30, the enchantment level will be 30."
		"- &cQuanta&r affects randomness. For example, enchantments can roll much better than the Eterna level, but they can also be much worse."
		"- &5Arcana&r affects the amount and rarity of enchantments. For example, with high Arcana, powerful enchantments can appear more often, and an item can have more enchantments at once."
		"{@pagebreak}"
		"There is also the concept of &lInfusion&r. It is when an item can be upgraded through enchantment, but it requires specific levels of Eterna, Quanta, and Arcana to perform the infusion."
	]
	quest.09C94B18E85640F4.quest_desc: ["Kill mobs to fill the Extractor with blood. Make sure that Auto-Supply mode is enabled."]
	quest.09E7AE7305C03B18.quest_desc: ["Enchants books using experience, lapis lazuli, and a special item."]
	quest.09FD168D4DB013A9.quest_desc: [
		"Breaking leaves with a &lCrook&r may drop &lsilkworms&r."
		""
		"&lSilkworms&r can be placed into other leaves to &linfect&r them."
		"Once infected, the leaves can be broken with a &lCrook&r to obtain &lstrings&r."
	]
	quest.0A47CA5D6C1AC076.quest_desc: ["Attracts items"]
	quest.0AAE36CB15B466C3.quest_desc: [
		"&lStock Link&r, when placed, creates a new stock network. It can also be linked to another stock network before being placed."
		""
		"For more details, check &lPonder&r."
	]
	quest.0AB1188D5D8B5693.quest_desc: ["Reduces noise generated by machines"]
	quest.0B332E427D7C73B0.title: "&6Initiator:&r Dark Matter"
	quest.0B71F8E167D881D2.quest_desc: ["Increases interaction range"]
	quest.0C02E462A121AF6C.quest_desc: ["Right-click a broken item with this item to repair it."]
	quest.0C2E777E0262BF0C.quest_desc: [
		"&lMechanical Crafter&r can be used both for normal recipes and for ones that don’t fit on a regular crafting table."
		""
		"Using a &lWrench&r, you can control how items move from one slot to another. To complete a recipe, all required items must arrive in the correct order at a single output. Optionally, you can place a storage container at the output so crafted items are inserted into it automatically."
		""
		"To learn more, check the &lPonder&r."
	]
	quest.0C67CFEA7D3E75CE.quest_desc: ["If applied to an item, it will not disappear after death."]
	quest.0D131526BDC279FF.quest_desc: ["Increases the efficiency of chemical-using machines"]
	quest.0D21A326651C9909.quest_desc: [
		"&lLogic Cables&r connect logistics components in a network."
		""
		"A &lwrench&r can break both components and cables, and also rotate blocks"
	]
	quest.0DB8909F39A59B4D.quest_desc: ["{image:atm:textures/questpics/convergence/empowerer.png width:200 height:150 align:center}"]
	quest.0DE0CD7EFC30268D.quest_desc: ["{image:powah:textures/gui/book/images/player_transmitter.png width:200 height:120 align:center}"]
	quest.0DECACD0D1420ACF.title: "MekaSuit"
	quest.0E52392E83EB860D.quest_desc: ["Grants the owner flight &o&7(like in Creative mode)&r&r"]
	quest.0E5DCE48DBF4ADDE.quest_desc: ["Gain experience (or right-click while holding the item) to put the experience into the capsule."]
	quest.0E62A00F02BDBFC6.quest_desc: [
		"Step 1:"
		"{image:atm:textures/questpics/convergence/step1.png width:150 height:100 align:center}"
		"{@pagebreak}"
		"Step 2:"
		"{image:atm:textures/questpics/convergence/step2.png width:150 height:100 align:center}"
		"{@pagebreak}"
		"Step 3:"
		"{image:atm:textures/questpics/convergence/step3.png width:150 height:100 align:center}"
		"{@pagebreak}"
		"Step 4, right-click with wrench on core and place terminal nearby:"
		"{image:atm:textures/questpics/convergence/step4.png width:150 height:100 align:center}"
		"To leave press C"
	]
	quest.0E62A00F02BDBFC6.title: "&2Cyberspace"
	quest.0E7D5EF134ABF8CD.quest_desc: ["Right-click in the &lOverworld&r while holding a &lBottle and Cork&r to collect &aSunlight&r into the bottle."]
	quest.0EAF507EEA7ADD17.quest_desc: ["Increases the maximum Blood capacity of the Blood Infuser."]
	quest.0F43A29A0C21F40E.quest_desc: ["&lDrying Basin&r dries fluids and blocks."]
	quest.0F88CCAB79ECCC10.quest_desc: ["{image:powah:textures/gui/book/images/energizing.png width:200 height:120 align:center}"]
	quest.104315A8617C1FE2.quest_desc: ["{image:powah:textures/gui/book/images/furnator.png width:200 height:120 align:center}"]
	quest.1045418E218B2849.title: "Skeleton: Self-Aware"
	quest.10690892ACEB9452.quest_desc: ["{image:powah:textures/gui/book/images/energy_cell.png width:200 height:120 align:center}"]
	quest.1069B16A30138BBD.quest_desc: ["Can capture any leashable entities"]
	quest.106A2E827B9C771A.quest_subtitle: "End Power"
	quest.119051D6846F6B79.quest_desc: ["Can capture most entities"]
	quest.11B182426AF86B1D.quest_desc: ["Pulls nearby items toward itself (min: 1 block, max: 6 blocks)"]
	quest.11B7AD1053C0D1E9.quest_desc: ["Place the equipment made from essence here, then put the augment there to apply it to the equipment (hover over the augment to see what equipment it can be applied to)."]
	quest.11DA9480369D1D46.quest_desc: ["Place a Bottler with empty bottles, release a bee above it, and crush it using a downward-facing piston. Centrifuge the Bottle of Squashed Bee Material to obtain Gene Samples."]
	quest.11DA9480369D1D46.title: "Making Genes"
	quest.12451FF8B4462D2C.quest_desc: [
		"In a &lPorcelain Crucible&r, you can generate lava from any type of stone. Simply place 4 blocks inside it and wait—eventually it will produce 1 bucket of lava. The process can be sped up by placing a heat source underneath the crucible."
		""
		"To view the available heat sources, hover over the crucible and press &lU&r."
	]
	quest.1263F0823526DA8A.quest_desc: [
		"&lChunk Loader&r, as the name suggests, keeps chunks loaded."
		""
		"To work, it requires at least 30 RPM of rotational power supplied from below. The higher the rotation speed, the more chunks are loaded (up to 25)."
	]
	quest.12B25A8DB019151A.quest_desc: ["Provide energy, configure the blocks you want to mine, set the minimum and maximum height, and press Start. The Digital Miner will begin mining the selected blocks."]
	quest.12B8F789B5CE8D47.quest_desc: [
		"&lME Wireless Access Point&r can be connected to an ME Network to allow remote access to your ME Terminal."
		""
		"For better range, place &lWireless Boosters&r nearby. They increase the signal range up to 528 blocks."
		""
		"Then link a &lWireless Universal Termina&rl by placing it into the designated slot. After charging it, you'll be able to remotely access and manage the items stored in your ME network."
	]
	quest.12B8F789B5CE8D47.title: "Wireless Terminal"
	quest.131239E04B0C92B3.quest_desc: ["Crafts items automatically"]
	quest.13308F6C550A8834.quest_desc: ["Drop a Charged Certus Quartz Crystal, Nether Quartz, and Redstone Dust into water to create a &lFluix Crystal&r"]
	quest.134C75E0A0558FBE.quest_desc: ["By sifting dirt, you can obtain &lmycelium spores&r and g&lrass seeds&r. If you use either the spores or the seeds on dirt, you will obtain either mycelium or a grass block respectively"]
	quest.13816CE1935B63E5.quest_desc: ["The name speaks for itself: it is a portable Dashboard."]
	quest.13A70B04726AB0F0.quest_desc: [
		"Teleports you to the &2Nexus&r world. The higher the Tier of the Portal Core, the larger the ratio between blocks in the normal world and the Nexus (similar to how in the Nether 1 block equals 8 blocks in the overworld)."
		""
		"To activate it, press “Generate link”. Then you can press “Teleport” to go to the Nexus."
		""
		"If you surround the Core with Chrono Blocks and then press “Light Portal”, the portal will activate."
	]
	quest.13E651CF6787D75A.title: "Steel"
	quest.13E9D2EC5970923F.quest_desc: ["In &lMarket&r you can buy seeds and saplings."]
	quest.141FCECA6357FDB5.quest_desc: [
		"Place an Emerald Block on the &lAlchemancy Forge&r (without sneaking) to transform it into an &lAlchemancy Catalyst&r."
		""
		"To transmute items, place the item on the Forge and right-click the Catalyst."
	]
	quest.141FCECA6357FDB5.quest_subtitle: "And item transmutation"
	quest.143AAA52270F9DAC.quest_desc: ["Drop Chromatic Compound into the void."]
	quest.14D17BA6E2F98DB7.quest_desc: ["Slices items into a single chip."]
	quest.14E889AABD736FC1.quest_subtitle: "Auto-hammer"
	quest.151F9196D6994535.quest_desc: ["End Cake teleports you to the End dimension when eaten. However, it only has 1 bite, so if you want more, right-click it with Ender Pearls to add additional bites."]
	quest.15413129021B4B9B.title: "RM Armor"
	quest.16CC68D91CDDA75B.quest_desc: ["Drops from completing &lGateway of Apothic Pinnacle&r. It lasts for an infinite number of waves, but every &l100&r waves you receive a &lSigil of Supremancy&r as a reward, which is the most overpowered item in &lApotheosis&r."]
	quest.16CCF578DD4C9412.quest_desc: [
		"&lReaders&r read information about the type of objects they are designed for."
		"&lDisplay Panel&r visualizes the value of a variable."
	]
	quest.173F4570126CEF36.quest_desc: ["If there is food and 2 villagers, a baby villager will appear after some time."]
	quest.1754452986287E26.quest_desc: ["Create a ritual using the Tablet of Summon Wilden, but before activating it, add the 3 ingredients dropped by Wildens."]
	quest.175F4E53CDA6EF7E.quest_desc: ["Mixing witch water and lava in a barrel produces netherrack"]
	quest.17AB4228AB7563AF.quest_desc: ["Weaken a mob using a potion, then it can be captured in a &lSoul Catcher&r. After that, supply regeneration potion and rotational power to a &lMechanical Spawner&r containing the soul, to spawn the mob whose soul was captured."]
	quest.17E036D3929354AD.quest_desc: ["Allows plants to grow in a single block"]
	quest.1800D400C97DC17F.quest_desc: ["Infinity Water Block"]
	quest.182755677E101328.quest_desc: ["Right-click a block to add it to the filter."]
	quest.183714E33FB50C7E.quest_subtitle: "Nether Power"
	quest.1850863B933D0AA2.quest_desc: [
		"&lYou find yourself on a single island in the sky.&r"
		"Apart from a tree and some ground, there is nothing here, but your task is to &6progress&r. By completing quests and exploring various mods, you will eventually &lconverge all mods into a single item...&r &obut that is still far away.&r"
		"For now, try checking &aChapter I&r and see what you need to do to &lprogress further.&r"
	]
	quest.18D38AF6D33222AE.quest_desc: ["{image:powah:textures/gui/book/images/magmator.png width:200 height:120 align:center}"]
	quest.18D54521D040E531.quest_desc: ["&lHeavy&r is a property found on many items, but the most convenient source of it is Anvil."]
	quest.18D54521D040E531.title: "Heavy"
	quest.18E67DE7E5227280.quest_desc: ["&lExtreme Crafting Table&r – a 9×9 crafting table used for Extreme Crafting."]
	quest.19455CABC10E9DA6.quest_desc: ["Allows &lTreasure Enchantments&r, such as Mending, to appear."]
	quest.195965B42221FB02.quest_desc: [
		"&lDissolution Chamber&r is a crafting table alternative that can also use fluids."
		""
		"Some items required later will be created using it."
	]
	quest.197EAD897FC715A4.quest_desc: ["Use on mobs to collect DNA"]
	quest.19AD73C72CDBD645.quest_desc: ["Separates heavy water from regular water"]
	quest.19C602EF7F54984D.quest_desc: ["To get &lMenril Resin&r, place a Menril Log in the Squeezer. Then place the bucket of resin into the Drying Basin to dry it."]
	quest.1A25BF3F8D8A8B9B.quest_desc: ["Place it on the ground to create a column of air that lifts entities upward."]
	quest.1A734D3B2616662D.quest_desc: ["Creates a small pocket dimension"]
	quest.1AAE56DBCAEDA720.quest_desc: ["Right-click in the &lNether&r while holding a &lBottle and Cork&r to collect &4Ghosts&r into the bottle."]
	quest.1ABA8B5CC24D9BEF.quest_desc: [
		"Replaces dirt and grass blocks in a 5×5 area with Delightful Dirt."
		""
		"Peaceful mobs have a much higher spawn rate on it during the day."
	]
	quest.1ABD1B0F316A5E81.quest_desc: ["Extracts souls from &lSoul Sand&r, changing it to &lSoulless Sand&r."]
	quest.1AC34A816F9121AE.quest_subtitle: "Convergence of Coals"
	quest.1AD2F39442A82543.quest_desc: ["Places water or lava, or removes fluids, using &#98FF3Aexperience&r."]
	quest.1BE93817EA5B58FB.quest_subtitle: "Now you’re starting to cross the line…"
	quest.1BF763118FA76C2F.quest_desc: ["Farms crops automaticlly"]
	quest.1C1AD20D1948D58F.quest_subtitle: "Convergence of Power"
	quest.1C385EEA9A45E11F.title: "Fortress"
	quest.1C58CD7DFE4A34ED.quest_desc: ["Increases speed of machines"]
	quest.1CE27CCA8E183243.quest_desc: ["To add a Sigil to an item, simply place them together in a Smithing Table."]
	quest.1CE5C5F9F7249CB9.quest_desc: ["&lNether Crafting Table&r – a 5×5 crafting table used for Nether Crafting."]
	quest.1D252FA2F62F1C2B.quest_desc: [
		"Working as Flint and Steel"
		"&l&cBe careful — it sets everything around it on fire if it is in your inventory!"
	]
	quest.1DA4F2A2CC779B81.quest_desc: ["Rename it on an anvil, then &oshift + right-click&r it to enter the dimension inside it. To leave break any floor block"]
	quest.1DA4F2A2CC779B81.title: "&l&5Ars Nouveau:&r Planarium   "
	quest.1DEC5F74410775E5.quest_desc: ["All properties and how to obtain them are listed here."]
	quest.1E09D426204B4EBE.quest_desc: ["If all 16 Mycelial Generators are placed within its radius and all of them are generating energy, &lMycelial Reactor&r will start producing a huge amount of energy."]
	quest.1E1EB6E43E2A899C.quest_desc: [
		"&oWell… you’ve come quite far…&r &lwhich means there is no way back now.&r"
		"&cIt’s time to bring all the mods together into one Convegrence.&r"
	]
	quest.1E1EB6E43E2A899C.title: "&l&5To Next Chapter    "
	quest.1E3F4AAE435E64BD.title: "Zombie: Self-Aware"
	quest.1E6C73E48D527128.quest_desc: ["&#63EBFFPlutonium&r is obtained by extracting it from Nuclear Waste using an Isotopic Centrifuge."]
	quest.1ECD99EAB1BBB257.quest_desc: ["{image:powah:textures/gui/book/images/thermo_generator.png width:200 height:120 align:center}"]
	quest.1FA8D9E2033B0177.quest_desc: ["&lSculk Crafting Table&r – a 3×3 crafting table used for Sculk Crafting."]
	quest.1FAD54EFB87F5AAE.quest_desc: ["Place the ingredients in the 4 pedestals and the essences in the 4 vessels. Put the initiator in the center and activate the center with a redstone signal or using a Wand."]
	quest.1FB03FFCCE52B1DA.quest_desc: [
		"&lBrass Funnel&r is almost the same as the Andesite Funnel, but it has a filter and can move up to 64 items at once, and this can be configured."
		""
		"It has two modes: &lUp to&r and &lExactly&r. In the first mode, it will extract or insert any amount of items up to the specified limit. In the second mode, it will move exactly the specified amount of items."
	]
	quest.1FB3687CBD70C726.quest_desc: ["Trader in one block"]
	quest.1FCEBC26037DBD10.quest_subtitle: "The Final Goal"
	quest.1FCEBC26037DBD10.title: "Gem Armor"
	quest.200C3B3B97721822.quest_desc: ["To obtain &lEther Gas&r, you need to slow down the Wither using a Stasis Chamber. Then place a Fluid Laser Base and a Laser Drill above it to extract the gas from the Wither."]
	quest.208CF739C8A071C7.quest_desc: ["Allows you to carry chests."]
	quest.20E948F488205812.quest_desc: ["Increases or decreases the insomnia level accordingly."]
	quest.21002D64A1759A8F.quest_desc: ["Generates stone or cobblestone as needed"]
	quest.212224DE2C538563.quest_desc: ["If used on a chicken, it will produce the spawn egg corresponding to the DNA stored on the swab."]
	quest.215C46B996E58FCC.quest_desc: ["Grows plants around itself. Requires a hoe and a storage block above it."]
	quest.216C414D366FD9D4.quest_desc: ["Raises baby bees while they are inside a Bee Cage"]
	quest.216CF8AA2EA3C033.quest_desc: ["Place the ingredients on the pedestals, put the initiator in the center, and then activate the center with a redstone signal or using a Wand."]
	quest.2213D9EC067B7A4E.quest_desc: [
		"Mob farming is an important aspect, since mobs can drop valuable loot, especially at higher World Tier levels. To make this easier, there is a mod called &lMob Grinding Utils.&r"
		""
		"[ { \"text\": \"To Chapter\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"67415ADBE590E9FF\" } } ]"
	]
	quest.2213D9EC067B7A4E.title: "Mob Farming"
	quest.222E1E1FD28DEEC1.quest_desc: [
		"The Wither is a fairly dangerous early-game boss, so there’s a useful trick to defeat it."
		""
		"In the End, under the bedrock fountain, dig out a small room. Find the block at coordinates X:0 Z:0, then place soul sand or soul soil there. From that point, place another soul sand/soul soil block one block forward, and then two more branching to the sides. Finally, place the three Wither skulls - not on top of the blocks, but in front of them."
		""
		"This will cause the Wither to spawn inside the fountain, where it gets trapped, making it easy to defeat."
	]
	quest.222E1E1FD28DEEC1.title: "Kill Wither"
	quest.2389BDAE09E03D42.quest_desc: ["&lFluid Transmitter&r - a phantom fluid transmitter. Insert fluid into one, set the second one to the same frequency as the first, and the fluid in the first will be transferred to the second."]
	quest.23AC3D4B60A10185.quest_desc: [
		"&lEnergiser&r charges items placed on the Depot underneath it."
		""
		"&lAdvanced Energiser&r has the following stats: 16 FE/t per 10 RPM, stores 100K FE."
	]
	quest.23AFA9DA63505541.quest_desc: ["To use the &lSqueezer&r, place it down, insert a block or item into it, then jump on the Squeezer so the press compresses the block (or item). After that, the resources will drop out. To reset it, use a redstone signal."]
	quest.23B2F9905E560873.quest_desc: ["&lItem Transmitter&r - a phantom item transmitter. Insert items into one, set the second one to the same frequency as the first, and the items in the first will be transferred to the second."]
	quest.23B9237E9A2F8393.quest_desc: ["&lItem Vault&r can store a large number of items. It can be expanded, with a maximum size of 9×3×3, and in general the maximum length is the width &o(or height)&r multiplied by 3."]
	quest.23E5777088E1FBDC.quest_desc: [
		"&lEnergiser&r charges items placed on the Depot underneath it."
		""
		"&lReinforced Energiser&r has the following stats: 64 FE/t per 10 RPM, stores 1M FE."
	]
	quest.24C7BB69804FE8A1.quest_desc: [
		"Press &lC&r to create spells."
		"Press &lM&r to select a spell (1–10)."
		"Press &lZ&r and &lX&r to switch between spells."
		"Right-click to cast the spell."
	]
	quest.24DC127D898FD317.quest_desc: ["Projects a hologram of the world area."]
	quest.2562EC2BAB50B8CE.title: "Bastion"
	quest.256FBEB73EE2C219.quest_desc: [
		"&lInfusion&r is a way to transfer the properties of one item onto another item."
		""
		"To use it, place &lInfusion Pedestals&r within a 1-block radius of the previously placed Forge and Catalyst."
		""
		"Place the items whose properties you want to transfer onto the pedestals. Put the main item on the Forge and right-click the Catalyst. After that, the properties of the pedestal items will be transferred to the main item."
		""
		"Examples:"
		""
		"Apple + Diamond = Edible Diamond"
		"Sword + Pickaxe = A pickaxe that can both attack and mine."
	]
	quest.259C989BC949BDF3.quest_desc: ["Place an Arcane Core, put an Enchanting Apparatus on top of it, and place pedestals around it. The recipes require source."]
	quest.25FFC753EE4270D3.quest_desc: ["{image:powah:textures/gui/book/images/solar_panel.png width:200 height:120 align:center}"]
	quest.2606E270A490E819.quest_desc: ["Automatically crafts the selected recipe."]
	quest.2627FD9E4B70E869.quest_desc: ["Haven: Obtain any Affix item, which can occasionally drop from mobs. Don't forget to activate it with Ctrl + T."]
	quest.2627FD9E4B70E869.title: "World Tier: Haven"
	quest.26729EFAC5C784A0.quest_desc: ["Ascent: Wear a full armor set and use an Uncommon Affix item tool."]
	quest.26729EFAC5C784A0.title: "World Tier: Ascent"
	quest.27197BD5FCE54FBB.quest_desc: ["&lCheck Ponder&r"]
	quest.271C0F2F59D93702.quest_desc: ["Crushing items and blocks"]
	quest.2725AFAFC56189C5.quest_desc: ["Right-click on an entity to build a &lData Model&r."]
	quest.273A669E22148C63.quest_desc: ["&lAccumulator&r is a storage for energy. Its size limitation is the same as fluid tanks - 3×3 with unlimited height."]
	quest.27608BE34E6FC470.quest_desc: ["Within a 1-block radius around itself, it removes all fluids."]
	quest.27EF2B29B139849A.quest_desc: ["Catches nearby bees if it has Bee Cages inside."]
	quest.2818E1C552C906D3.quest_desc: ["Collects items around it"]
	quest.28567C71149074AE.quest_desc: [
		"Congratulations."
		"You survived the fall of Earth."
		"To this island in the sky, They brought you after death."
		"The Higher Ones, whose faces none have ever seen before,"
		"Created life where nothing living ruled the world no more."
		"You were never sent here by mistake or destiny denied —"
		"You were the chosen one, the flaw in fate to rectify."
		"{@pagebreak}"
		"The Earth was burned and turned to ash,"
		"One island only stayed at last."
		"And all your trials, your loss, your glory,"
		"Were leading to a single story:"
		"To bring the world to life once more,"
		"Restore the oceans, plains, and shores."
		"For this, a gift to you was given —"
		"To rise unto the rank of Heaven."
		"But there was hardship."
		"{@pagebreak}"
		"Yet you, hero, overcame."
		"You reached the end and earned your name."
		"And through the Convergence of every might,"
		"You gained a spark of True Creative Light."
		"This gift can help the world survive —"
		"Enter Creation, bring it back to life."
		"{@pagebreak}"
		"What comes next is yours to choose."
		"You may remain and heal the world,"
		"Or leave it all and still move forward."
		"The choice is yours, and yours alone —"
		"Don’t fear the path your heart has shown."
		"But if you choose to stay and fight,"
		"Great deeds still wait beyond this night."
	]
	quest.28567C71149074AE.quest_subtitle: "The End is Never The End"
	quest.28567C71149074AE.title: "The Island Poem"
	quest.289E17106724C66B.quest_desc: ["Throwing a Nether Core into the End void will give you a &lVoid Gem&r. The important part is to look at the void air while doing so - otherwise, the gem will not be obtained."]
	quest.28BB4F2568F2AC52.quest_desc: ["&lCheck Ponder&r"]
	quest.291E474E0ED8E87C.quest_desc: ["Uses Rarity Materials to upgrade Gems."]
	quest.291FDC525FA193CC.quest_desc: [
		"&lYou can increase rotational speed using cogwheels.&r"
		""
		"To do this, place a large cogwheel first, and then connect a small cogwheel diagonally in any direction."
		""
		"If rotational power is applied to the shaft of the large cogwheel, the small cogwheel will rotate 2 times faster. However, if the power is applied to the small cogwheel instead, the large cogwheel will rotate 2 times slower."
	]
	quest.291FDC525FA193CC.title: "Speeding Up kinetics with Cogwheels"
	quest.29425F89A9629392.quest_subtitle: "Convergence of all Resource Generation"
	quest.296B4817A1752DF2.quest_desc: ["Crucibles can be used to compost plants into water"]
	quest.29B0C81A32F4A274.quest_desc: ["Transforms items into other items using the Molecular Metamorpher."]
	quest.2A07D0D835C7F2B4.quest_desc: [
		"&l&6Create&r&r runs entirely on &lkinetic power&r, which can be generated by a variety of generators. This power can also be increased, but you'll learn more about that later."
		""
		"You can learn about any &l&6Create&r machine by hovering over it and holding &lW&r to &lPonder&r."
		"{@pagebreak}"
		"If using a block is too difficult to explain in text, the description will say \"&lCheck Ponder&r\""
	]
	quest.2A86820B680A63E0.quest_desc: [
		"This is a skyblock world, so the Nether is also void. Bastions and fortresses still generate, but they are much more dangerous now: since mobs have nowhere else to spawn, they all spawn inside the same structures, making them heavily populated."
		""
		"You can build your way around, or - if you have already defeated the dragon - use Elytra to fly and search for structures."
	]
	quest.2A86820B680A63E0.title: "The Nether"
	quest.2AA8AF47AB60E2EB.quest_subtitle: "Just 72 Nether Stars. That’s still not much."
	quest.2ABC24FE01FA64CA.quest_desc: ["Infinity Water Source"]
	quest.2ABC24FE01FA64CA.title: "Sink"
	quest.2AEB72CF0E4B26D2.title: "Tyr Armor"
	quest.2B15D1DE87DB8CF0.quest_desc: ["Allows you to see the &lAura level&r around you."]
	quest.2B689CFDE59BE8A7.quest_desc: ["Right-click with the Extractor to pour out the blood, then collect it with a bucket."]
	quest.2B6B36BA17F853F8.quest_desc: [
		"&lHydraulic Press&r is a better version of the standard Press."
		""
		"It has two modes:"
		""
		"&lPressing&r - If a Depot is placed underneath and lava is supplied, it will press items on the Depot. The amount of lava affects performance. For example, with 1 bucket of lava it can press up to 64 items at once."
		""
		"&lHydraulic Compaction&r - Requires a Basin underneath and compresses items, blocks, and fluids into new blocks."
	]
	quest.2B816476C65A21D2.quest_desc: [
		"&lAtomic Deconstructor&r, if it has energy, will fire a beam. To function, it requires lenses. If standard lenses are used, it will perform normal recipes."
		""
		"To learn what other lenses do, check their descriptions."
	]
	quest.2BC0F6CF0BCA6DCB.quest_desc: ["Used to attract solitary bees to nests"]
	quest.2BC1F78A33B713A3.quest_desc: [
		"This shelf adds &lQuantic Stability&r."
		""
		"This attribute prevents &lQuanta&r from making enchantments worse than the Eterna level, while still allowing them to roll higher than the Eterna level."
	]
	quest.2BC5BB26928C81CB.quest_desc: ["&lCheck Ponder&r"]
	quest.2C183C53D5F351CD.quest_desc: [
		"&lTo assemble a train:&r"
		""
		"1. Build a railway track"
		"2. While holding a Station, right-click any block of the track and place the station nearby"
		"3. In the station interface, click “Create New Train”"
		"4. A blue outline will appear. Click it while holding Train Casing"
		"5. Build the train on the resulting Bogey"
		"6. Don’t forget to add a seat and Train Controls to the train"
		"7. Glue the train together using Super Glue"
		"8. In the station interface, click “Assemble Train”"
		"9. If everything is done correctly, the train will be assembled and you will be able to control it"
	]
	quest.2C183C53D5F351CD.title: "Train"
	quest.2C1F506C7760BDC6.quest_desc: ["To obtain the &lVoidic Upgrade&r, you need to do the same as with the Void Gem: throw a Netherite Upgrade into the void of the End."]
	quest.2CDAEB0B9D667B43.title: "Spider: Self-Aware"
	quest.2CF72646077045BF.quest_desc: [
		"Compresses items into singularities. Requires &l10,000 items&r to create one singularity."
		"Can be upgraded, which will reduce the required number of items (except for the first upgrade)."
	]
	quest.2D29B7E1FE450903.quest_desc: [
		"To create a &lOffering Platform&r, place an &lOffering Table&r in the center and surround it with Poppies (see the book for the exact setup)."
		""
		"Then place the required items on the table and drop a &lSpirit of Calling&r on top of it."
	]
	quest.2D8BF11A3CCCD9D2.quest_desc: ["Creates Wildens. Kill them to obtain ingredients."]
	quest.2DF89F259CD4A10D.quest_desc: [
		"&lAndesite Funnel&r can exist in two variants - on a conveyor belt and without one."
		""
		"&lWithout a conveyor belt&r, the Funnel has two modes, input and output, which can be switched using a Wrench. The Funnel attaches to any storage and can either extract items from it or insert items into it."
		""
		"&lOn a conveyor belt&r, the Funnel can also extract or insert items into storage, but this behavior depends on the belt’s movement direction rather than being switched with a Wrench."
	]
	quest.2E08563376632AF2.quest_desc: ["&lMetallurgic Infuser&r allows you to &cinfuse&r chemicals into items. For example, you can load &lRedstone&r as the chemical and infuse it into a &lCopper Ingot&r to create an &lInfused Alloy&r."]
	quest.2E9C4FADC26C9931.quest_desc: ["Right-click with an active effect to add it to the filter."]
	quest.2ECB543483F804A7.quest_desc: ["Enriching Items and blocks"]
	quest.2EE02EE7B2A409CC.quest_desc: ["With them, if the beam reaches a block, it will create a large amount of fire."]
	quest.2F1ACC375F18E810.quest_desc: ["If there is a baby villager, it will grow up after some time."]
	quest.2F253177237C7284.quest_desc: ["Pinnacle: Wear a full armor set and use an Epic Affix item tool, and kill the Ender Dragon."]
	quest.2F2936D782230703.quest_desc: [
		"&lHas two modes: Smelting and Alloying.&r"
		""
		"- Smelting works like a furnace, but uses energy instead of fuel."
		"- Alloying combines resources to create alloys."
	]
	quest.2F5E1C7BA4EF0600.quest_desc: [
		"Place a &lDrive Array&r and create a &bnew network&r or connect it to an existing one. Insert up to 12 Drives inside it. Then place a &lDashboard&r anywhere and connect it to the same network as the Array."
		""
		"Depending on the number and tier of Drives, the virtual network will have &6more available slots&r. To store items in it, simply put them into the Dashboard like a regular chest."
	]
	quest.2F5E1C7BA4EF0600.title: "QIO Inventory"
	quest.2F751CA724EC5DA4.quest_desc: ["Right-click a mob to add it to the filter."]
	quest.2FB21A928B3D6A1F.quest_desc: [
		"Hold &lW&r while hovering over any &lSPS&r block to view its &lPonder&r, which explains how to build it."
		""
		"&lThe SPS&r &o&7(Supercritical Phase Shifter)&r converts &lPolonium&r into &#A50EFFAntimatter&r, but it requires an &lenormous&r amount of energy. Make sure you have a powerful power generation setup before using it."
	]
	quest.2FB21A928B3D6A1F.title: "Building a SPS"
	quest.3086E30FCBF3A360.quest_desc: ["{image:powah:textures/gui/book/images/ender_cell.png width:200 height:120 align:center}"]
	quest.3098FE991661E866.quest_desc: ["Kill mobs using a &lSoulium Dagger&r while having a &lSoul Jar&r in your inventory to fill it with the souls of mobs (only one mob type per Soul Jar)."]
	quest.3098FE991661E866.title: "Collecting Souls"
	quest.30C0C97FF21A91CB.title: "Wither Skeleton: Self-Aware"
	quest.31B033D189C783E6.quest_desc: ["&lSpeedometer&r measures the speed applied to it, while &lStressometer&r measures the stress (capacity and load) of the network."]
	quest.31B346B315F4DBFD.quest_desc: ["Generates kinetic energy using source."]
	quest.31C57B818CC82713.quest_desc: [
		"&lHose Pulley&r can fill or empty large volumes of fluids. One side receives rotational power to reel in or unwind, while the other side supplies or extracts fluids."
		""
		"For visualization, check &lPonder&r."
	]
	quest.3205752D1A51B92D.quest_desc: [
		"Bees will not attack you while you are wearing the helmet."
		""
		"Additionally, there is a 30% chance that a &lKamikazBee&r will spawn when you are hit."
	]
	quest.3246B5409A47809C.quest_desc: ["If you connect a Tap to a Tank, and the tank contains liquid experience, it will drip through the tap as experience orbs when the tap is enabled."]
	quest.3270CA20ADF65CC3.quest_desc: ["Constantly applies the effect from its filter."]
	quest.3291140CB9E0996C.quest_desc: ["Spawns mobs using a &lSoul Vial&r (right-click the spawner with it to bind it) or using the mob type stored in a &lBroken Spawner&r."]
	quest.329D180C447E7D30.quest_desc: ["Drop a &lDark Gem&r into Blood, and after some time it will turn into a &lDark Power Gem&r, consuming the Blood in the process."]
	quest.32E81C7EE573A49C.quest_subtitle: "Magnetic Power"
	quest.3353912916ED6EC3.quest_desc: ["This item must remain in your inventory for about an hour. After that, it will stabilize."]
	quest.33E8DF582A99FE21.quest_desc: ["Grants Malice's Touch to one of the Affix Item stats."]
	quest.340E646D7BD62783.quest_desc: [
		"To obtain an XP Bucket, connect an Absorption Hopper to an XP Tank. When enough experience has been collected from mobs killed within the hopper's range, you can collect it with a bucket."
		""
		"Pour this bucket into the XP Solidifier and place a Mould inside. The experience will be converted into XP Jelly Baby."
		""
		"It will be useful later."
	]
	quest.342720B5D3F5ED55.quest_desc: ["&lCheck Ponder&r"]
	quest.345C9A390317712B.quest_desc: ["Can store up to 1024 items when placed in an ME Drive or ME Chest."]
	quest.3476B03B4B722D68.quest_desc: ["{image:powah:textures/gui/book/images/energy_cable.png width:200 height:120 align:center}"]
	quest.34F44F3D63EFDC21.quest_desc: [
		"&lInscriber&r works using &lPresses&r. The required Press is shown in the recipe."
		""
		"Some recipes do not require a Press."
	]
	quest.354CACC24A66E2F6.quest_desc: [
		"&l&#020220Train Casings&r&r can be used to cover shafts, cogwheels, and conveyor belts. They can also be used for decorative purposes."
		""
		"To craft them, right-click a Brass Casing while holding Sturdy Sheet in your hand."
	]
	quest.358E130FCBCC5024.quest_desc: ["&lME Terminal&r can be connected to any ME Cable. It allows you to view and manage items in Cells stored in an ME Chest or ME Drive."]
	quest.359057595A5560AD.quest_desc: ["&lSturdy&r is a property found on many items, but the most convenient source of it is Andesite."]
	quest.359057595A5560AD.title: "Sturdy"
	quest.35946AF71262935C.quest_desc: ["Hold Right Click to create a beam that freezes Spirits."]
	quest.35F593BE37FEE9FF.quest_subtitle: "Convergence of Ingots"
	quest.3637AA15D069DF0E.quest_desc: ["If linked to an obelisk, stepping on it will grant the player &#98FF3eexperience&r at a selected rate."]
	quest.363F65D97ED88853.quest_desc: [
		"By default, an item can have a maximum of 4 properties."
		""
		"However, using a &lNether Star&r, you can remove this limitation and add more properties to the item."
	]
	quest.363F65D97ED88853.title: "&lLimit Break   "
	quest.366D3E74D6206188.quest_desc: ["&lFactories&r are upgraded versions of regular machines. They can perform multiple operations at once, have higher processing speed, increased energy capacity, and other improved stats."]
	quest.36BF85BD415A375F.quest_desc: ["[ { \"text\": \"To Chapter\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"6F61F5AB90E1FC01\" } } ]"]
	quest.36BF85BD415A375F.title: "Iron Furnaces"
	quest.3727D27C231868CF.quest_desc: ["Hold Right Click to create a beam that damages Spirits."]
	quest.37602C0DEF4C4EC2.quest_desc: [
		"Using a hammer, you can break blocks."
		""
		"The block progression is as follows:"
		"&lStone → Cobblestone → Gravel → Sand → Dust&r"
		""
		"Gravel can be obtained not only from cobblestone, but also from any other type of stone, for example andesite or diorite."
	]
	quest.3772EE1658909580.quest_desc: ["Voidic Pickaxe &lcan break bedrock&r. To do this, right-click the bedrock block with the pickaxe."]
	quest.37BE08EB52AFD6AA.quest_desc: [
		"The ring can be activated with Shift + Right Click, after which various effects will be applied to you."
		""
		"When the ring is activated, &lVengeance Spirits&r will also appear much more frequently when killing mobs than before."
	]
	quest.37FE416521FF38B5.quest_subtitle: "Convergence of all Utility"
	quest.385694A1E35E18AE.quest_desc: ["&lItem Drain&r, if an item is placed on it, will drain it. The resulting fluid can then be extracted using pipes."]
	quest.387332E175B57F1B.quest_subtitle: "Convergence of all Magic"
	quest.38B71C5C65298336.quest_desc: [
		"&lPowah&r is a mod that adds a wide variety of generators, methods for transferring energy, and energy storage systems."
		""
		"[ { \"text\": \"To Chapter\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"002D20017A320E7C\" } } ]"
	]
	quest.38B71C5C65298336.title: "&l&0Powah "
	quest.38DCDCB9D0EDB11B.quest_desc: ["Can catch bees without breaking when releasing them."]
	quest.3971F97CDB4622E4.quest_desc: ["Drop a &lBlank Pearl&r with both &lDepth Dweller&r and &lUndying&r properties into the void to obtain a &lVoid Pearl&r."]
	quest.3971F97CDB4622E4.title: "Voidborn"
	quest.39872A5893AC305E.quest_desc: ["With them, if a suitable block is placed in front of the beam, it will be converted into an ore."]
	quest.3995B181CE8D70CB.quest_desc: ["A 3×2×2 multiblock that crushes blocks if it has energy."]
	quest.39A2EE93B8E3D7A0.title: "&l&5Ars Nouveau:&r Planarium   "
	quest.39AF9F392DB9A93C.quest_desc: ["&lMotor&r generates rotational power when energy is supplied. Using a Wrench, its speed can be adjusted, but its maximum stress capacity is very small."]
	quest.39CF1D906F15BC53.quest_subtitle: "Convergence of all Storage"
	quest.39DEF540CB80DEF9.quest_subtitle: "Completed"
	quest.39E07664BF1AE71B.quest_desc: ["Killing mobs gives you a chance to obtain &lGems&r from them."]
	quest.39FB1894745F5BC9.quest_desc: ["Kill a Vengeance Spirit to obtain it."]
	quest.3A6DEF0671431398.quest_desc: ["If contains energy, will make player faster"]
	quest.3A75D9031395B4BF.quest_desc: ["Trash Can, but without filters"]
	quest.3B182679B61254BF.quest_desc: ["These blocks generate &lAura&r. To learn how they work, check the &lBook of Natural Aura&r."]
	quest.3B97DD26787943A3.quest_desc: [
		"&l&#FF5638Copper Casings&r&r can be used to cover pipes. They can also be used for decorative purposes."
		""
		"To craft them, right-click a stripped log or wood block while holding Copper Ingot in your hand."
	]
	quest.3BF3834CE78A9200.quest_desc: ["&#39FF9APolonium&r is produced by exposing Nuclear Waste to sunlight in a Solar Neutron Activator."]
	quest.3C7400183363089D.quest_desc: [
		"&lMechanical Belt&r allows you to create conveyor belts. To do this, right-click the first shaft, then right-click the second shaft. If the indicator is green, the belt can be created; if it is red, it cannot be created in that location."
		""
		"When rotational power is supplied to either shaft, the belt starts functioning, transferring rotational power to the other shaft, which can also be used for power transmission &o(and of course, belts transport items as well)&r"
	]
	quest.3CB84027A10FFEAF.quest_desc: ["Drying Basin, which using energy"]
	quest.3CBA19A1BD87ACA8.title: "Infinity Blood"
	quest.3D03BAF936414B41.title: "Scuba Equipment"
	quest.3D122DDE4BFE9C8D.quest_desc: ["With them, if an enchanted item and a book are placed in the beam’s path, the item will be disenchanted, and the book will receive its enchantment."]
	quest.3D9D05D9BD8F184E.quest_desc: ["Squeezer, which using energy"]
	quest.3DB4CB1AAEB0A288.quest_desc: [
		"Build a closed structure made of &lBricks&r, but leave the inside hollow. Then place a &lSpirit Furnace&r anywhere inside or near the structure."
		""
		"If everything is built correctly, the Bricks will turn red, indicating that the structure is valid."
		"{@pagebreak}"
		"&lSpirit Furnace&r allows you to revive Vengeance Spirits using Blood and kill them to obtain their resources."
	]
	quest.3DB4CB1AAEB0A288.quest_subtitle: "Abusing Spirits"
	quest.3DB4CB1AAEB0A288.title: "Spirit Furnace"
	quest.3E1F9A3CC950E996.quest_desc: ["After some time, spilled Blood will become &lHardened Blood&r. Then mine it while holding Flint and Steel in your hand to obtain shards"]
	quest.3E56CC0F8F9141FC.quest_desc: [
		"&lMekanism&r is a mod that allows you to create mega armor, produce antimatter, and introduces a wide variety of machines that can be used to automate and extract many different resources."
		""
		"[ { \"text\": \"To Chapter\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"65EDE4C0454DDF93\" } } ]"
	]
	quest.3E56CC0F8F9141FC.title: "&l&8Mekanism  "
	quest.3E5BB9A1FA6B785D.quest_subtitle: "Deep Power"
	quest.3E677932ED70292E.quest_desc: [
		"Using a &lsieve and mesh&r, you can sift blocks. To insert a mesh into a sieve, right-click the sieve while holding the mesh. To remove the mesh, shift + right-click with an empty hand."
		""
		"To sift blocks, hold the desired block in your hand and hold right-click on the sieve. The better the mesh, the &lhigher&r the chance of obtaining valuable items. &lHowever, be careful:&r just because an item can be sifted with one mesh doesn’t necessarily mean it can be sifted with another, &oso make sure to check the recipes!&r"
	]
	quest.3E9191E6A350C494.quest_desc: ["&lMechanical Generator&r generates one type of stone. To set it, place the desired stone as a filter. The higher the rotation speed, the more blocks will be generated."]
	quest.3F0C74019A4D542D.quest_subtitle: "Auto-compactor"
	quest.3FD5E51487799D64.quest_desc: ["Stores fluids"]
	quest.3FFC51F1B556DDEC.quest_desc: ["&lAlternator&r converts rotational power supplied to it into energy."]
	quest.402590931D96D5E7.title: "Connector"
	quest.40C74FA3E08C5779.quest_desc: ["Working as Flint and Steel"]
	quest.410338B232BD8289.quest_desc: ["&lLogic Programmer&r allows you to configure a Variable Card. You can choose a block, item, redstone signal, Boolean value, and many other types of values."]
	quest.411583D4CBD5FF98.quest_desc: ["{image:powah:textures/gui/book/images/energy_hopper.png width:200 height:120 align:center}"]
	quest.41500DE6FDD645D1.title: "Wither Skeleton Bee"
	quest.416FB220D400342D.quest_desc: [
		"Right-click on leaves with &lBrilliant Fiber&r to turn them into &lGolden Leaves&r. Golden Leaves have 4 stages &o(from 0 to 3)&r, and they can only be harvested at stage 3."
		""
		"You can check the current stage using &lF3&r."
	]
	quest.41D4DEB7E0932698.quest_desc: ["Frontier: Wear a full armor set and use an Affix item tool, and kill an Affix Boss (strong mobs highlighted with an affix)."]
	quest.41D4DEB7E0932698.title: "World Tier: Frontier"
	quest.421675EEB4E5EAAD.quest_desc: ["Right-click in the &lEnd&r while holding a &lBottle and Cork&r to collect &8Darkness&r into the bottle."]
	quest.4224EE0206206450.quest_desc: [
		"Drop &lDark Matter&r and &lCorrupti Dust&r nearby to create a &lBlack Hole&r."
		""
		"It absorbs experience orbs and later produces an &lXpetrified Orb&r."
	]
	quest.4224EE0206206450.title: "Black Hole"
	quest.422F276CF2C659C9.quest_desc: ["Keeps a machine's chunk loaded"]
	quest.4251DF50F79ED7C2.quest_desc: [
		"Terminal connects to inventories through Interfaces within the same logistics network, after which all connected inventories become accessible through the Terminal."
		"{image:atm:textures/questpics/convergence/terminal.png width:210 height:120 align:center}"
	]
	quest.42539C48AE915F5C.quest_desc: ["The only way to obtain a &lNetherite Upgrade&r is by finding it in a &lBastion&r. However, you only need one, since it can be duplicated using netherrack and 7 diamonds."]
	quest.4257BE960863C130.quest_desc: ["Allows you to augment specific stats of an Affix item."]
	quest.426F3ACA4F650B46.title: "Mesh"
	quest.427EC19F1FC4F763.quest_desc: ["&lMillstone&r is used for grinding items. To use it, insert or drop items into it. After some time, the processed output can be collected by right-clicking it."]
	quest.42C6CAFC7C28E914.quest_desc: ["&lGold Engine&r is an endgame engine that generates 128 RPM by itself and provides 19968 stress units."]
	quest.42C75073C06753CC.quest_desc: [
		"&lDeployer&r simulates player interactions. It can press buttons, place blocks, and attack mobs."
		""
		"If a &lDepot&r is placed underneath it, it can interact with it to process recipes."
	]
	quest.4359C5ECCA5D39EF.quest_desc: ["Right-click it to open the network. Then press O at any time (even without holding the item) to open the infinite inventory. Time-space fragments will generate there."]
	quest.43F2B2235BEA8A07.quest_desc: [
		"To build the &lHephaestus Forge&r, construct the following structure:"
		"{image:atm:textures/questpics/convergence/forge.png width:200 height:100 align:center}"
		"&oNote: The blocks underneath the pedestals and the smithing table are Gilded Chiseled Polished Darkstone.&r"
		""
		"Then right-click the Smithing Table while holding Mundabitur Dust in your hand."
	]
	quest.43F2B2235BEA8A07.title: "Hephaestus Forge"
	quest.4485D23448BADB91.quest_desc: ["&lFluid Tank&r can store fluids. To increase its capacity, simply add more tanks. The maximum size is a 3×3 structure with unlimited height."]
	quest.4487800F46B15D10.quest_desc: ["You can place books with enchantments that you do not want to appear during enchanting here."]
	quest.44DF20C039CABD8F.quest_desc: ["Prevents mob spawning within a cubed volume around itself."]
	quest.44E3F73AB80847E4.quest_desc: [
		"These 3 blocks will help you interact with the &lQIO network&r."
		""
		"&lExporter&r – place an inventory below it, set a filter &o(or enable the no-filter mode)&r, and it will export filtered items into that inventory."
		""
		"&lImporter&r – place an inventory below it, set a filter &o(or enable the no-filter mode)&r, and it will import filtered items from the inventory into the network."
		""
		"&lRedstone Adapter&r – can detect the amount of a specific item type stored in the network."
		""
		"&l&4Important&r: For these blocks to work, they must be connected to the same network as the Drive Array."
	]
	quest.44E3F73AB80847E4.title: "QIO Utilities"
	quest.44FF48A6617756CE.quest_desc: ["{image:powah:textures/gui/book/images/reactor.png width:200 height:120 align:center}"]
	quest.45168CF7AAA83BAD.quest_desc: ["RMB in The Nether with a planet card"]
	quest.4517A4B9E492648B.quest_desc: ["Allows you to use &lNatural Ritual&r to transform certain items into others."]
	quest.45697073C7BE772B.quest_desc: ["Pouring witch water into a barrel and then right-clicking it with sand will produce soul sand"]
	quest.456E7B5A7DC79C2B.quest_desc: ["{image:powah:textures/gui/book/images/energy_discharger.png width:200 height:120 align:center}"]
	quest.45A6786363DA24DB.quest_desc: [
		"You can duplicate the &lEternal Singularity&r using Sequence Assembly from Create. I recommend doing this, because crafting another one from scratch will take much longer."
		""
		"&oNote: Eternal Singularity cannot be dropped, so use a depot, or a chest + chute, or similar methods for inserting it into the process.&r"
	]
	quest.45BD16FF1C9EF52C.quest_desc: ["If this upgrade is applied to a helmet, your health will regenerate while you are in water."]
	quest.46AE62FC3408517C.quest_desc: ["Right-click with the spell book to open the glyph crafting menu. Select a glyph, then place the required items for the glyph on the table. After that, right-click with the glyph to learn it."]
	quest.46F4BCA17F5B9B8C.quest_desc: ["Fluids can be transported through pipes, but not on their own - they require a Pump."]
	quest.47018956BFC72D92.quest_desc: ["RMB in Overworld with a planet card"]
	quest.4774D9ED48CA97D8.quest_desc: ["Stores 1024 buckets"]
	quest.482EA4FBFC075634.quest_desc: ["&lElectric Motor&r converts energy supplied to it into rotational power."]
	quest.4869B2D0B14D9A39.title: "Draco Arcanus Armor"
	quest.48760DB507C283DA.quest_desc: ["Can capture most entities and then bind them to spawners"]
	quest.491F8ED8AB2F0268.quest_desc: ["&l&cBe careful — it sets everything around it on fire if it is in your inventory!"]
	quest.49772C0FE7CA564A.quest_subtitle: "Convergence of all Endgame"
	quest.49AA75DC958F0405.quest_desc: ["Here are a few things that might make your gameplay easier"]
	quest.49D6B18798999B05.quest_desc: [
		"Drink it to replenish your &lAureal&r."
		""
		"It is required for some abilities."
	]
	quest.49FC2D1B38C3E296.quest_desc: [""]
	quest.4A464D4E1DF2DAB6.quest_desc: ["Generates energy using honey"]
	quest.4A67D1AFB91C7B2B.quest_desc: ["&lME Controller&r is the center of an ME network. When supplied with power, it distribute energy to all connected devices."]
	quest.4A820284F4A6B02F.quest_desc: ["&lNetherite Engine&r is an endgame engine that generates 256 RPM by itself and provides 99840 stress units."]
	quest.4A91295D5D33B464.quest_desc: ["Summit: Wear a full armor set and use a Rare Affix item tool, and kill the Wither"]
	quest.4A91295D5D33B464.title: "World Tier: Summit"
	quest.4B26F80D751BAA52.quest_desc: [
		"Using a 64k or 256k ME Storage Component, you can compress items into&l Matter Balls&r."
		""
		"To do this, place the Storage Component and change its mode from \"Destroy Items\" to \"Condense into matter balls\"."
		""
		"Then insert 256 items to create one Matter Ball."
		""
		"There is also the \"Condense into singularities\" mode, which requires 256,000 items to create one Singularity."
	]
	quest.4BDE0D56608D5B64.quest_desc: ["Using Rarity Materials and a Sigil of Rebirth, it can turn regular items into Affix items."]
	quest.4C33276D8A38F8F1.quest_desc: [
		"To locate ore veins, you first need an &lOre Vein Finder&r. Right-click with it, and it will tell you whether there are veins nearby. It reports:"
		""
		"- &lFound in Chunk&r - a vein is located in the current chunk"
		"- &lFound nearby&r - a vein is located in nearby chunks &o(usually within ~400 blocks)&r"
		"- &lFound traces of&r - traces of a vein in distant chunks &o(usually within ~1500 blocks)&r"
		""
		"If you move in the correct direction, the \"nearby\" and \"traces of\" indicators will decrease."
		"{@pagebreak}"
		"After you find a vein, place a &lSample Drill&r in that chunk. Put a &lCopper Backtank&r on top and activate the Drill with right-click. After drilling, right-click the Drill with an &lAtlas&r in hand to record the vein’s coordinates."
	]
	quest.4C33276D8A38F8F1.title: "Finding Ore Veins"
	quest.4CB35D1F78AC86EA.quest_desc: ["If this upgrade is applied to an item, mining blocks with it will mine a 3×3 area at once."]
	quest.4CC7EF6F0A5EE827.quest_desc: ["Place the mob’s Data Model here, after which it will be turned into either a prediction of that mob or a generalized version. The more mobs of this type you have killed, the higher the chance of getting a prediction of that mob"]
	quest.4CFEAF9F50F081AE.title: "Racks"
	quest.4D915EA68606BDF4.quest_desc: ["Fill jetpack with Hydrogen to fly"]
	quest.4DE076B4DA265AAB.quest_desc: [
		"&lMechanical Bearing&r attaches the block in front of it. To add more blocks, they need to be glued together using &lSuper Glue&r."
		""
		"When rotational force is applied, Bearing will rotate the attached blocks."
	]
	quest.4E7A70D777093E41.title: "&6Initiator:&r Dark Gem"
	quest.4EB55063ED134854.title: "Power of Creative"
	quest.4EC4FA2BFB7419D9.quest_desc: ["&lMechanical Pump&r, when supplied with rotational power, moves fluids through pipes in the direction of the pump (as indicated by the arrows on its sides)."]
	quest.4F3D702516F92C42.quest_desc: [
		"&lCreate&r is a technological mod without energy (excluding addons). Everything works purely through kinetics, and Create allows you to easily automate almost any production process."
		""
		"[ { \"text\": \"To Chapter\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"2A07D0D835C7F2B4\" } } ]"
	]
	quest.4F3D702516F92C42.title: "&l&eCreate  "
	quest.4F45F9A15394D057.quest_desc: ["Build the &lTeleporter frame&r (4 blocks high and 3 blocks wide), then place the &lTeleporter&r block in the bottom center block. Set a frequency and build another Teleporter with the same frequency. Provide energy to both, and they will teleport between each other."]
	quest.4F816F767C867A88.quest_desc: [
		"Can be thrown at a mob to annihilate it."
		""
		"It is also used to create unique tools"
	]
	quest.4F89C1220061E00B.title: "Boiler"
	quest.4F9876C1147C67A4.quest_desc: ["Infinity Milk Source"]
	quest.4FB779AB11814AD7.title: "Draconic Bee"
	quest.4FC54644A9D01423.quest_desc: ["&lMechanical Extruder&r generates blocks using rotational power. If there are blocks or fluids on the left and right that match a recipe, the Extruder will start generating blocks. Some recipes require a &lBrass Mechanical Extruder&r, and others may depend on conditions such as &lbiome&r, &lspeed&r, or &lY-coordinate&r."]
	quest.4FC65E2E735131B7.quest_desc: ["Shift+Right-Click on a villager, to catch it"]
	quest.4FD5FE52A27C57DE.quest_desc: ["&lStasis Chamber&r applies a slowing effect to the mob above it, preventing it from escaping."]
	quest.4FE8B8E47071AECE.quest_desc: ["Place a barrel on mycelium, fill it with water, and wait for it to transform into &lwitch water&r"]
	quest.4FEC2443BB1CD88B.quest_desc: ["Links drawers together, allowing pipes to insert or extract any items from the connected storage."]
	quest.5017A763FF2FBE93.quest_desc: ["Increases the maximum Blood capacity of the Blood Infuser."]
	quest.501C23B295BE6606.quest_desc: [
		"&6Engineer’s Goggles&r let you view additional information about Create machines, such as their &lStress Impact&r and S&ltress Capacity&r."
		""
		"&7Wrench&r can be used to configure certain machines. It can also rotate nearly every &l&6Create&r&r block and instantly break &l&6Create&r machines by Shift + right-clicking them."
	]
	quest.501C23B295BE6606.title: "Create Tools"
	quest.502AAB5F66B63B65.quest_desc: ["Rename it on an anvil, then &oshift + right-click&r it to enter the dimension inside it. To leave break any floor block"]
	quest.514017C030F9CCFE.quest_desc: ["Place amethyst or lapis lazuli inside, and after some time it will turn into a source gem."]
	quest.51C87E37BAB1D5C7.title: "Cooking Table"
	quest.51E1490F7BD58651.quest_desc: ["Allows you to use &lNatural Ritual&r to crush items and blocks."]
	quest.52C38C6E7192E9AD.quest_desc: ["Increases energy efficiency and capacity"]
	quest.5442BF058D91A4E7.quest_desc: [
		"Replaces dirt and grass blocks in a 5×5 area with Dreadful Dirt."
		""
		"Hostile mobs have a much higher spawn rate on it during the night."
	]
	quest.544FFA317F091BF3.quest_desc: ["{image:atm:textures/questpics/convergence/forest_ritual.png width:200 height:100 align:center}"]
	quest.544FFA317F091BF3.title: "Ritual of The Forest"
	quest.545A894A46CAAE60.quest_desc: ["&lFluid Interface&r allows you to pour fluids into liquid containers simply by right-clicking it with a bucket or another storage item."]
	quest.5467013EBAC3B85D.quest_desc: ["Use &bBulk Haunting&r to transform an oak sapling into a Menril Sapling."]
	quest.54CAAF435F738E85.quest_desc: ["Place &lNeurocell&r, &lImprinter&r, and &lReformer&r, connect them using &lNeurolink&r, put a &lbioscanner&r inside the Neurocell, and then place a mob (or yourself) on the Imprinter. The mob will die, and the bioscanner will be filled with the mob’s biodata. Then the Reformer will start developing a copy of the mob. After it is spawned, a second one will start developing, and so on."]
	quest.553D62451DEA92CD.quest_desc: ["Open the Deep Learner with right-click, place the Data Model of the mob inside it, equip it in the Curios slot, and then kill those mobs to level up the Data Model."]
	quest.5649ECF2FD92EAD0.quest_desc: [
		"To use the &lAltar of Birthing&r, build the required platform (see the book for details) and drop the required items onto the altar."
		""
		"If everything is correct, the items will disappear and the summoned mob will appear."
	]
	quest.566A4F38514CD96A.quest_desc: ["&lVoidic Sword&r is not only stronger than a Netherite sword, but also has a 10% chance to drop a soul with each hit. These souls will be useful later in the game."]
	quest.573D8F65E525E2A1.quest_desc: ["When placed facing a tree, it extracts Latex from it. If supplied with energy, the process will be faster."]
	quest.57B07DF3104FADDF.quest_subtitle: "Auto-sieve"
	quest.585B5018C9E22A51.quest_desc: ["Workbench for creating metal components."]
	quest.589B2B6327C11F01.quest_desc: [
		"&lTo generate electricity in Create: New Age, you need to:&r"
		""
		"1. Place a Generator Coil"
		"2. Place 12 magnet blocks around it"
		"3. Supply rotational power to the Generator Coil"
		"4. Place Carbon Brushes in front of the Coil"
		"5. Connect the energy receiver and the Brushes using Electrical Connectors and wires"
	]
	quest.589B2B6327C11F01.title: "Generating Power"
	quest.58D78D22A23D5EBC.quest_desc: ["Allows you to place two &9por&r&6tals&r and teleport between them"]
	quest.590AA800FEB93949.quest_desc: ["Removes the affixed name from an item"]
	quest.5966A82EC8DA6414.quest_desc: [
		"&lEnergiser&r charges items placed on the Depot underneath it."
		""
		"&lBasic Energiser&r has the following stats: 4 FE/t per 10 RPM, stores 10K FE."
	]
	quest.5A3669DC2A2DC7BF.title: "Blaze: Self-Aware"
	quest.5AB9B0B75A6C6187.quest_desc: ["Drop &lGem(s)&r on the ground and drop an Anvil on top of them."]
	quest.5B05E4DB39465504.quest_desc: ["Stores experience"]
	quest.5BB761546CBD1D83.title: "Elemental Seeds"
	quest.5C66DA87F0D8780C.quest_desc: ["If this upgrade is applied to an item, blocks mined with it will be automatically smelted."]
	quest.5CB52E4CD6A3AA06.quest_desc: ["RMB on bookshelves to infect them."]
	quest.5D4AA934CD09A37D.quest_desc: [
		"This block allows &3item replication&r using an &lEnd Charge&r."
		""
		"Place the item in the first slot, put the End Charge in the second slot, then press the Replicate button. The charge will be consumed, &land instead of 1 item, you will receive 2.&r"
	]
	quest.5D58FCAD088C6F3D.quest_desc: ["{image:atm:textures/questpics/convergence/nature_ritual.png width:200 height:110 align:center}"]
	quest.5D58FCAD088C6F3D.title: "Natural Ritual"
	quest.5D706A5B7E232257.quest_desc: [
		"&e/sethome [name]&r – sets a home point with the name &e[name]&r"
		"&e/home [name]&r – teleports you to the home point named &e[name]&r"
		"&e/setwarp [name]&r – sets a warp with the name &e[name]&r"
		"&e/warp [name]&r – teleports you to the warp named &e[name]&r"
		"&e/enderchest&r – gives remote access to your ender chest"
		"&e/nickname [nickname]&r – sets a custom nickname &e[nickname]&r"
		"&e/spawn&r – teleports you to the spawn point"
		"&e/tpa [player]&r – sends a teleport request to a player &e[player]&r"
		"&e/tpahere [player]&r – sends a request to teleport player &e[player]&r to you"
	]
	quest.5D7E7AD1EADC91C0.quest_desc: [
		"&lLaser Drill&r uses a &lLaser Base&r to generate resources."
		""
		"The setup should look like this:"
		""
		"- A Laser Base with Lenses installed."
		"- Laser Drills placed facing away from the Laser Base (in the opposite direction)."
		"- The Laser Drills must be supplied with energy."
		""
		"Depending on the Lens placed in the Laser Base, different materials can be generated from the general resource pool."
	]
	quest.5D7FFA439059F5A8.quest_desc: ["&lDiamond Engine&r is an endgame engine that generates 192 RPM by itself and provides 49920 stress units."]
	quest.5DB2E7A022A7575F.quest_desc: ["Shoots mobs using Aureal"]
	quest.5EA3A0CBE08768C7.quest_desc: ["Works as Furnace, but working on energy"]
	quest.5EA4F183CBC03C49.quest_desc: ["Using &lLaser Drills&r and &lOre Laser Base&r from &lIndustrial Foregoing&r, you can generate Infinity Nuggets using Infinity Block as the base."]
	quest.5EA4F183CBC03C49.title: "Generating Infinity Ingots"
	quest.5EDEE7CF972EB417.quest_desc: ["Allows you to remove individual enchantments from an item."]
	quest.5F93EFB068A3CE80.quest_desc: ["Disables all natural spawns in a 25×25 chunk area, but disables other filters."]
	quest.6025E820FBD35C02.quest_desc: ["&lCheck Ponder&r"]
	quest.6069468C474318C6.quest_desc: [
		"This enchantment gives you a chance to obtain a &lCorrupt Soul&r when killing mobs."
		""
		"Killing the Corrupt Soul will allow you to obtain it as an item."
	]
	quest.6079A9A2B9AA8FD3.quest_desc: [
		"&lMechanical Mixer&r can mix items and liquids. To do this, a &lBasin&r must be placed one block below it."
		""
		"Some recipes require &oheating&r - for this, a &lBlaze Burner&r must be placed under the &lBasin&r and fed with any fuel. For &osuper-heating&r, a &lBlaze Cake&r is required as fuel."
		""
		"To obtain a &lBlaze Burner&r, right-click a &lBlaze&r with an empty burner in hand."
	]
	quest.60A228AA58170D38.quest_desc: ["Mixing lava and witch water in a barrel produces blackstone"]
	quest.60CBBD8CBD92CC3E.quest_desc: ["Attached to an inventory, fluid storage, or energy storage in a logistics network."]
	quest.6116F405E27EBF71.quest_desc: ["&lSAG Mills items and blocks.&r The output can be increased by using different Grinding Balls."]
	quest.612977916D080C09.quest_desc: [
		"Place the Box, take the Focus, and optionally equip the Glasses. Then use the Focus to pull the Vengeance Spirit into the box to trap it."
		""
		"Once the lid closes, you can break the box."
	]
	quest.612977916D080C09.title: "Catching Spirits"
	quest.613CF09E9428DE34.quest_desc: ["Prevents mobs from filtered types from spawning in nearby chunks."]
	quest.616B85AAE36E49C2.quest_desc: ["&lSmart Chute&r is a regular Chute but with an item filter and the ability to be closed."]
	quest.616FB99306EBCE07.quest_desc: ["&lEcho Cake&r is an upgraded version of &lBlaze Cake&r. Like Blaze Cake, it provides superheating, but it burns three times longer."]
	quest.61B0504BBA94BF16.quest_desc: ["Use it on a chicken to obtain a Rotten Egg"]
	quest.61F5A4BD53CE7503.quest_desc: ["&lUndying&r is a property found on 2 items, but the most convenient source of it is End Crystal."]
	quest.61F5A4BD53CE7503.title: "Undying"
	quest.620D884F055DD8C3.quest_desc: ["&lSmart Pipes&r has a filter. You can place a bucket of a fluid into it, and then only that fluid will be allowed to pass through the pipe."]
	quest.6290B1DEC67CD961.quest_desc: ["By filling a barrel with lava and then right-clicking it with glowstone, you can obtain end stone."]
	quest.62A7A83F61A5B741.quest_desc: [
		"&lDrilling Machine&r works only when you first make sure there is an ore vein in the chunk."
		""
		"Then place the drill. Supply rotational power to machine. Use conveyors to extract the output. Some resources require drilling fluid, which also needs to be supplied."
		""
		"For visualization, check &lPonder&r."
	]
	quest.62D0E9756DB0F931.title: "Wither Skeleton Skulls"
	quest.62DBD0C93AB5423E.title: "The End"
	quest.62EC74A2D030B398.quest_desc: ["Prevents breaking blocks from the filter and killing mobs from the filter."]
	quest.62F35D91213A15C3.quest_desc: ["&lMotor Extension&r, when placed behind a Motor, increases the motor’s maximum stress capacity."]
	quest.63089609F32127FC.quest_desc: [
		"Adds a socket to an item. To add a Gem to an item later, it must have an available socket."
		""
		"Gems are added the same way as Sigils."
	]
	quest.631759675A210C93.quest_desc: ["Creates items using &#98FF3eexperience&r"]
	quest.631E2F92A7F2FF40.quest_desc: ["A Bee Nest has a 5% chance of generating when growing a tree if there is a flower nearby."]
	quest.639CE5DDB4889556.quest_desc: [
		"There are two types of Cell storage:"
		""
		"- &lME Chest&r – Stores a single Cell and allows you to access its contents directly through the block."
		"- &lME Drive&r – Stores up to 10 Cells, but their contents cannot be accessed directly through the block."
	]
	quest.63CB710C18CB177C.quest_desc: ["Gather your first piece of wood and begin this long journey"]
	quest.64C4D13FD8A796E1.title: "Kill Ender Dragon"
	quest.64FB5CB750C721A2.title: "Cabinet"
	quest.65E412943D3E03D1.quest_desc: ["Using &lLaser Drills&r and &lOre Laser Base&r from &lIndustrial Foregoing&r, you can generate Neutronium Piles using Neutronium Block as the base."]
	quest.65E412943D3E03D1.title: "Generating Neutronium"
	quest.662C5B49121AABEF.quest_desc: ["Grow plants near it so that it can accumulate source. If there is a source jar nearby, the source will be transferred into it."]
	quest.664CCAA3DA580D56.title: "Enderman: Self-Aware"
	quest.66C7A33D9CDC6FCB.quest_desc: ["It automatically grows plants."]
	quest.672BAFD46A68FE0B.quest_desc: ["If there is a villager, iron golems will spawn, and they will immediately burn in lava, producing iron and poppies in the output."]
	quest.67415ADBE590E9FF.quest_desc: [
		"&lFan&r - pushes mobs when it receives a redstone signal."
		"&lSpikes&r - kill mobs."
		"&lConveyor&r - moves mobs in the direction of the conveyor."
	]
	quest.67415ADBE590E9FF.title: "Mob Grinding"
	quest.6757A658FBD71E7E.quest_desc: ["Blow up a &zRainbow Furnace&r to obtain"]
	quest.67A772D8EB233375.quest_desc: ["Now you are free to do whatever you want. You can build a city, remade the Otherworld or go further. Now this is &lyour&r game."]
	quest.67A772D8EB233375.quest_subtitle: "Freedom"
	quest.681E3134BF06B284.quest_desc: [
		"&lBrass Funnel&r can cover conveyor belts."
		""
		"Also, if it is placed at a conveyor intersection, it will split items according to the mode selected on top of it."
		""
		"It has filters on each side. If a filter is set on the input side, it will only accept items that match that filter. If a filter is set on any of the three output sides, it will distribute items to the sides whose filters they match."
		""
		"They can also be placed in a row and still distribute items across conveyors depending on the selected mode."
		""
		"For more details, check &lPonder&r."
	]
	quest.69164AFE0261395C.quest_desc: ["&lAntiprotonic Nucleosynthesizer&r &o(try pronouncing that)&r converts certain items into others using &lantiprotons&r &o(represented by &lAntimatter&r &oin this case)&r&r and energy."]
	quest.6988043188756ADB.quest_desc: ["Break this block to obtain the basic &lAE2&r tools."]
	quest.69ED23795227CFD4.quest_desc: ["Use it on a chicken to obtain a Golden Egg"]
	quest.6A3BBC9767042189.title: "Sulfur Dust"
	quest.6A9AB544765FE961.quest_desc: [
		"Using a &lCrushing Hammer&r and allowed ores (or raw materials) in crafting can yield additional resources."
		""
		"To see which ores can be crushed with this hammer, check the recipes by hovering over it and pressing &lU&r."
	]
	quest.6A9AB544765FE961.title: "Crushing Ores"
	quest.6AD1E7C6D57F1E5F.quest_desc: ["Kills mobs in front of it, collecting &lPink Slime&r."]
	quest.6AE5168CEA1B57D2.quest_desc: ["If a redstone signal is applied, it ignites a fire above itself."]
	quest.6B9741D2C9A58C26.quest_desc: ["Stores 32 buckets"]
	quest.6BC281E391270165.title: "Creeper: Self-Aware"
	quest.6C23015FC68DDDA1.quest_desc: ["Breaks down &lAffix items&r and &lGems&r to obtain &lRarity Materials&r and &lGem Dust&r, respectively."]
	quest.6C5ED719863AAC7C.quest_desc: ["&lCobblestone Engine&r is an endgame engine that generates 32 RPM by itself and provides 4992 stress units."]
	quest.6CD83E0EA086F578.title: "Chapter II"
	quest.6CE345AFED4F7B71.quest_desc: ["Removes Curses from an item&l"]
	quest.6CFB315467FE3C96.quest_desc: ["Can store up to 262144 items when placed in an ME Drive or ME Chest."]
	quest.6D06CDF035D493DD.quest_desc: [
		"Collects neutronium using... time. There are 2 ways to speed up the process:"
		"1) Easier, but slower – make many collectors."
		"2) Harder, but faster – upgrade the collector, which requires a lot of resources."
	]
	quest.6D06CDF035D493DD.quest_subtitle: "Now We Playing Waiting Game"
	quest.6DBC68D94724EFB2.quest_desc: ["If you notice a bug, please join my &9Discord&r channel and then report the bug in &7#bug-reports&r."]
	quest.6DC3CFAB99B9005D.quest_desc: ["Captures mobs using &lAureal&r"]
	quest.6E2A5A3C7398D43D.quest_desc: ["Allows you to see Vengeance Spirits."]
	quest.6E537056B28420DD.quest_desc: ["Using Rarity Materials and a Sigil of Rebirth, it can turn regular items into Affix items."]
	quest.6E7448BC4F83B30E.quest_desc: ["Trades automaticlly"]
	quest.6E7F4B153653D34F.quest_desc: [
		"Hold &lW&r while hovering over any reactor block to view its &lPonder&r, which explains how to build the reactor."
		""
		"To run the reactor, it must have a coolant, which is usually Water. Supply it through an &lInput Only port&r."
		""
		"You also need to remove the used coolant. If you use Water as the coolant, the used coolant will be &lSteam&r. If you do not need the Steam, simply pipe it from the &lOutput Coolant port&r into a Fluid Trash Can."
		""
		"The reactor also requires fissile fuel, which must be supplied through another &lInput Only port&r."
		""
		"Finally, you must extract the produced &lNuclear Waste&r. Extract it from the &lOutput Waste port&r and send it into a &lWaste Barrel&r."
		""
		"Don't forget to configure the reactor's &lBurn Rate&r. The default value is very low, so increase it as needed. However, do not set it too high, or the reactor may explode. It can also explode if it runs out of coolant, so using an infinite water source from &lXYCraft&r or &lCooking for Blockheads&r is highly recommended."
		""
		"&l&cNever break a Waste Barrel while it contains Nuclear Waste, as it will release a large amount of radiation.&r"
		""
		"Radiation will naturally decay over time. To protect yourself from radiation damage, wear a &lHazmat Suit&r."
		""
		"Once everything is ready, press &lStart&r to activate the reactor. Press &lScram&r to safely shut it down."
	]
	quest.6E7F4B153653D34F.title: "Building a Fission Reactor"
	quest.6E96DEB38D235F85.quest_desc: ["To create an infinite water source, you don’t necessarily need two buckets. One bucket and one bone meal are enough: place two blocks, pour water onto the upper one, and apply bone meal to the lower one. Due to seagrass generating, two water source blocks will form, which can then be moved to create an infinite water source."]
	quest.6EE471012E011C65.quest_desc: ["This ring allows the player to fly like in Creative mode"]
	quest.6EFB4E2A2C055BF0.quest_desc: ["&lSpout&r can fill items with fluids. For this to work, a &lDepot&r must be placed underneath the Spout, and the Spout itself must contain the required fluid."]
	quest.6F0EA002DA33998C.quest_desc: ["Use a &lSoul Vial&r on a mob to capture its soul. You can later release it to summon the mob again or use it in crafting recipes."]
	quest.6F568DED11FA5ED8.quest_desc: [
		"&lModification Station&r allows you to install various Units onto the &lMekaSuit&r and &lMekaTool&r."
		""
		"&lChargepad&r allows you to charge your armor and items in your inventory simply by standing on it."
	]
	quest.6FB75DA3A18ABAA5.quest_desc: ["Overcharges every affix on an affix item"]
	quest.70164C00D6268374.quest_desc: ["Used to Fuel the Reforging Table"]
	quest.70201203D04A8828.quest_desc: [
		"&lCrushing Wheels&r do not work alone - you need 2 of them (they are crafted as a pair, by the way)."
		""
		"To make them work, place them next to each other, then supply rotational power to each one. It is important that both wheels rotate in opposite directions, toward the center."
		""
		"If you drop items on top of the wheels &o(or supply them through a Chute)&r, the items will be crushed &o(up to 64 at a time)&r and dropped out underneath the wheels. From there, they can be collected manually, or using a Chute or a conveyor belt."
	]
	quest.7031694BFBBC79B5.quest_desc: ["Removes all gems from an item"]
	quest.707366A09113A86D.quest_desc: [
		"&lPackager&r packages items from the connected storage into a package. To do this, supply a redstone signal to it."
		""
		"If there is a sign placed on the Packager with text, it will be used as the package’s address."
		""
		"For more details, check &lPonder&r."
	]
	quest.7114D259B45A3555.quest_desc: ["Stirs Honeycombs to turn them into materials."]
	quest.71A0894937A067B9.quest_desc: ["A 3×3×4 hollow multiblock that smelts iron items into steel ingots if it has fuel."]
	quest.71DEC089B458B5FC.quest_desc: [
		"The &lPlanet Simulation Chamber&r processes a planet when supplied with items and energy, allowing you to extract resources from it later."
		""
		"To learn how to build it, check the next page or hold G while hovering over the Planet Simulator Controller in your inventory."
		"{@pagebreak}"
	]
	quest.725F1ED259C7CFD8.quest_desc: ["With them, it will instantly kill the mob in front of it."]
	quest.727B789C11584743.quest_desc: ["Explode TNT near the dropped Singularity and Ender Pearl to create a Quantum Entangled Singularity."]
	quest.72BA8BE2350EACBE.quest_desc: [
		"&lAdjustable Chain Gearshift&r can increase rotational speed."
		""
		"To do this, supply rotational power to the block and activate it with a redstone signal. Then, if you attach an &lEncased Chain Drive&r to any side except the front, its rotational speed will be doubled."
	]
	quest.72BE7FF8B92E5CF8.quest_desc: ["Using energy, Latex, and Water, it creates &lDry Rubber&r."]
	quest.72C612695D1EAD9B.quest_desc: ["ME network work using ME Cables, which connect all components together."]
	quest.72EAE60D9852AF7C.quest_desc: ["&lAdvanced Beehive&r differs from a regular one by having an interface and not requiring a campfire to collect Honey or Honeycombs"]
	quest.7306669747B1BA03.quest_desc: ["Controls rotational speed. Supply rotational power to it, then place a large cogwheel on top. Set the desired speed on the screen. The cogwheel on top will then rotate at that speed."]
	quest.73E94CC99A45FDDD.quest_desc: ["Works as Storage Drawer"]
	quest.743D664B52D3EC23.quest_desc: [
		"&lQuantum Bridges&r are a way to connect ME Networks across any distance."
		""
		"To create one, build a Bridge in one location:"
		""
		"- Place 8 Quantum Rings in a circle."
		"- Place a Quantum Link Chamber in the center."
		"- Connect it to your ME Network."
		""
		"Then build a second Bridge anywhere else."
		""
		"Place one of the previously created &lEntangled Singularities&r into each bridge."
		"Important: Both Entangled Singularities must come from the same craft and not from different crafts."
		""
		"After that, you can place an ME Terminal near the second bridge, and all items from the original ME Network will be accessible there."
	]
	quest.743D664B52D3EC23.title: "Quantum Bridges"
	quest.756697A84ABE6422.quest_desc: [
		"Enchanting Clues allow you to see more enchantments that will be applied to the item."
		""
		"If Clues = 0, only 1 enchantment is visible."
		"If Clues = 1, 2 enchantments are visible."
	]
	quest.75D241709C8C6935.quest_desc: ["If applied to an item, it will make it unbreakable."]
	quest.75F9E77D308BD645.quest_desc: ["Writes what it is intended for."]
	quest.7639BA6B21A65BED.quest_desc: ["Drop fuel items near it so that it can generate source. If there is a source jar nearby, the source will be transferred into it."]
	quest.76AE84BB2B4B6D49.title: "&6Initiator:&r Shadow Steel"
	quest.76EBE98B56BC3E63.quest_desc: ["Place the magical armor on the table, then add the thread to apply it to the armor"]
	quest.77101B157C03E8C1.quest_desc: [
		"&lMechanical Press&r can press and compress items."
		""
		"In pressing mode, there must be a &lDepot&r placed one block directly underneath it. If a valid recipe is found, the press will process the item on the depot - for example, turning an iron ingot into an iron sheet."
		""
		"In compressing mode, there must be a &lBasin&r placed one block directly underneath it. If a valid recipe is found, it will compress items into a single output - for example, turning 9 iron ingots into an iron block."
	]
	quest.7713D7B12DE9A0A5.quest_desc: ["Links two items together, allowing them to transform between each other."]
	quest.7713D7B12DE9A0A5.title: "Entangled"
	quest.772D3BA7EAA956A9.quest_desc: ["Right-click a player to add them to the filter."]
	quest.7733FB336905CEE8.quest_desc: [
		"Spawns mobs in a 3×3×1 area."
		""
		"Requires a Spawn Egg, XP Jelly Babies, and a redstone signal to operate. The spawn radius can be adjusted."
		""
		"Each spawned mob consumes 1 Jelly Baby."
	]
	quest.774961D278B47281.quest_desc: [
		"Right-click with the Tablet to create a ritual. Then right-click again to activate the ritual."
		""
		"To find out what each Tablet does, hover over it and hold Shift (this does not work in the quest window; use the JEI window instead)."
	]
	quest.777BB8168033D68B.quest_subtitle: "Convergence of Sorrow"
	quest.783708DD76F0596F.quest_desc: ["&lIron Engine&r is an endgame engine that generates 64 RPM by itself and provides 9984 stress units."]
	quest.786F877159FA8FC4.quest_desc: ["Convert Y&lellow Cake Uranium&r into U&lranium Oxide&r, then combine it with &lHydrofluoric Acid&r to create U&lranium Hexafluoride&r. Finally, place it into an &lIsotopic Centrifuge&r to process it into &0&lFissile Fuel&r."]
	quest.79D2D8D5D7BFF7ED.quest_desc: ["Expels other players from nearby chunks."]
	quest.7A7621A040885AB9.quest_desc: ["The true power of &5Creative&r"]
	quest.7A864487E3B89506.quest_desc: ["To obtain the &lDepth Dweller&r property, apply both Sturdy and Heavy properties to an item &lat the same time&r."]
	quest.7AD026DC0D00362B.quest_desc: [
		"To use the &lSqueezer&r, place it down, insert a block or item into it, then jump on the Squeezer so the press compresses the block (or item). After that, the resources will drop out. To reset it, use a redstone signal."
		""
		"The Squeezer allows you to obtain more resources from materials. For example, iron ore can yield 2 to 3 raw iron."
	]
	quest.7AFF78A7E5E2C83A.quest_desc: ["Can catch bees, but breaks when releasing them."]
	quest.7B4F79C7235D9B92.quest_desc: [
		"&lMechanical Drill&r will break the block in front of it. The higher the rotation speed, the faster it will do so."
		""
		"If Drill is placed on a moving contraption, it will break blocks in front of it, and if there is an available inventory, it will store the items inside it."
	]
	quest.7B7F117984A59B54.quest_desc: ["By sifting dirt, you can obtain &lstone pebbles&r. To get dirt, you &odon’t&r necessarily need to break your island — just make a barrel, place any compostable item inside it, such as saplings or leaves, and it will eventually turn into dirt."]
	quest.7BE26A61BFB023BB.quest_desc: ["To obtain obsidian, you don’t necessarily need a diamond pickaxe. Simply mix lava and water in a barrel"]
	quest.7BEA7744EA29101D.quest_desc: ["Place two of them, give them the same name, and they will teleport to each other."]
	quest.7BFCD0A73BB84823.quest_desc: ["Increases the maximum Blood capacity of the Blood Infuser."]
	quest.7C926CBD1D11973F.quest_desc: ["With them, the beam will dye colored blocks."]
	quest.7CD938A54A03B605.quest_desc: ["&lEnd Crafting Table&r – a 7×7 crafting table used for End Crafting."]
	quest.7D2A93047E5FCBFF.quest_desc: ["Smelts 3 items at once using energy, extracting Essence from them."]
	quest.7D332CE7378AA91D.quest_desc: ["Obtained from infected bookshelves when they decay or are broken."]
	quest.7D3AD440124246C2.quest_desc: [
		"&l&6Brass Casings&r&r can be used to cover shafts, cogwheels, and conveyor belts. They can also be used for decorative purposes."
		""
		"To craft them, right-click a stripped log or wood block while holding Brass Ingot in your hand."
	]
	quest.7D4299410A2AD5C3.quest_desc: ["&lEncased Fan&r blows air onto items in front of it. It can use many different modules, for example lava for &6smelting&r, water for &9washing&r, or campfire for &8smoking&r."]
	quest.7D5B03B431D38F73.quest_desc: [
		"&lMystical Agriculture&r is the main way of obtaining resources in this modpack. This mod allows you to acquire almost any resource using seeds."
		""
		"[ { \"text\": \"To Chapter\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"216CF8AA2EA3C033\" } } ]"
	]
	quest.7D5B03B431D38F73.title: "&l&aMystical Agriculture     "
	quest.7D7D160A036C90F8.quest_desc: [
		"&lMechanical Arm&r can move items from a Depot or conveyor belt to a Depot, conveyor belt, or Blaze Burner."
		""
		"Before placing it, right-click the input, then right-click twice on all outputs."
	]
	quest.7DBA7999957E6197.quest_desc: ["RMB in The End with a planet card"]
	quest.7E7CA93F254148EA.quest_desc: [
		"This generator does not do anything on its own, but if you place a &lblock&r inside it, it will start generating that block. The higher the generator tier, &lthe faster the production speed.&r"
		""
		"To see which blocks can be generated, check the recipes by hovering over the generator and pressing &lU&r."
	]
	quest.7F4EB7DA8CED8514.quest_desc: ["Stores 2K of a single item."]
	quest.7FB6DE04A4194DB9.quest_desc: ["Stores time while in the player’s inventory; this time can later be spent to &lspeed up&r machines by &o2x, 4x, 8x, 16x, 32x, 64x, 128x, or 256x&r, each level consuming &nmore&r stored time"]
	quest.7FEF727E16D61FCE.quest_desc: ["Used to Fuel the Augmenting Table"]
