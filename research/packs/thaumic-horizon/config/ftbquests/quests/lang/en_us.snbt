	quest.22E064EA1FBAFB0F.quest_desc: [
		"&4&oFor the time being the pack is pretty kitchen sink but goals and quests will be added and updated with each modpack update&r"
		""
		"&4&oCustom content will also be added and game mechanics adjusted over time.&r"
	]
	quest.22E064EA1FBAFB0F.quest_subtitle: "Rome was not built in a day."
	quest.22E064EA1FBAFB0F.title: "&4Pack Is In Beta&r"
	quest.40A2F702D84DC94D.quest_desc: [
		"&4Suggestions and Bugs&r"
		""
		"&oIf you find that you have any suggestions or come across any bugs in game that need patched please report these issues to our Discord in the form of a ticket to get them fixed quick!&r"
