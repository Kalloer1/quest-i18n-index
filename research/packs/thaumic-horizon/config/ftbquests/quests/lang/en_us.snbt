	quest.40A2F702D84DC94D.title: "&4Suggestions and Bugs&r"
	quest.5790C7F3236A9238.quest_desc: ["&o&4There will be a skill tree implemented into the pack to motivate players to gain experience and continue playing, it is currently a W.I.P and will be announced in the changelogs when completed, this quest chapter will also been redesigned to break down the Skill Tree.&r"]
	quest.5790C7F3236A9238.quest_subtitle: "Information about the Skill Tree [W.I.P]"
	quest.5ED8D976AC5D2BF0.quest_subtitle: "Permanent Night Vision"
	quest.5F69382770C89635.quest_desc: [
		"&9Experiment with Magic 🔮 &r"
		""
		"&oArcane energies swirl around you. Do you dare to harness their power before even understanding them?&r"
	]
	quest.5F69382770C89635.title: "&9Experiment with Magic 🔮 &r"
	quest.6111AA439C1ED08F.quest_desc: [
		"&dSeek Knowledge 📖 &r"
		""
		"&oStrange books and ancient scrolls hint at forgotten magic. Maybe there's more to this world than meets the eye...&r"
	]
	quest.6111AA439C1ED08F.title: "&dSeek Knowledge 📖 &r"
	quest.6FDD75FC45B24DAF.quest_desc: [
		"&l&aGather Resources 🌿 &r"
		""
		"&oStart by punching trees, collecting food, and crafting the essentials for survival. Even the most powerful wizards start somewhere!&r"
	]
	quest.6FDD75FC45B24DAF.title: "&l&aGather Resources 🌿 &r"
	quest.6FE4DA28B23E3B48.quest_desc: [
		"&l&dYou awaken in a strange world, the air thick with a faint shimmer of magic. &r"
		""
		"&oThe land before you stretches with endless possibilities—mystical forests, crumbling ruins, and towering mountains pulsing with arcane energy. Something about this place feels... different. Magic hums beneath your feet, waiting to be understood.&r"
		""
		"&o&cYou must decide how to begin your journey.&r"
		""
		""
	]
	quest.6FE4DA28B23E3B48.title: "&4The Beginning&r"
	quest.7DB8B261555C451B.quest_desc: [
		"&l&4Hey, I’m Rogue_Light,&r "
		""
		"&dCreator of Thaumic Horizon! &r"
		""
		"&oI’ve always loved modded Minecraft, especially the mix of magic and technology. This modpack is my way of bringing that vision to life—expanding Thaumcraft-inspired progression with fresh mechanics and new adventures. &r"
		""
		"&oWhether you’re here to master arcane arts or automate the impossible, I hope you enjoy the journey as much as I enjoyed creating it!&r"
	]
	quest.7DB8B261555C451B.quest_subtitle: "Meet The Developer!"
	quest.7DB8B261555C451B.title: "Rogue_Light"
}
