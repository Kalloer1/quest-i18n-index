	file.0000000000000001.title: "&6&lForbidden: &bEngine Of Conquest"
	quest.000BE9DC2C9D3FE7.quest_desc: ["&6The&r Brass Chestplate is part of the Brass Suit from Create Stuff 'N Additions. It is crafted with &b8&r Brass Ingots and has 400 durability, making it the most durable piece of the &bstandard&r brass armor set."]
	quest.000BE9DC2C9D3FE7.quest_subtitle: "Protection built for the factory"
	quest.000C959368903F8B.quest_desc: [
		"&dThe&r Scarecrow Hat is part of the Scarecrow Armor set in Iron's Spells 'n Spellbooks. When equipped, it provides &b+3&r Armor and &b+75&r Max Mana."
		""
		"Craft this unusual magical hat from a Leather Cap and a Carved Pumpkin, and embrace the &bmysterious&r power of the scarecrow."
	]
	quest.000C959368903F8B.quest_subtitle: "Embrace the strange magic of the scarecrow"
	quest.000FC26B648D7721.quest_desc: ["&aObtain&r an Ignitium Ingot from the Cataclysm mod. Forged from the &blegendary&r metal of the Nether, Ignitium is primarily obtained after defeating Ignis and is used to craft some of the &bstrongest&r weapons, armor, and relics in Cataclysm."]
	quest.000FC26B648D7721.quest_subtitle: "Forge metal born from the Lord of Fire"
	quest.00105AA28075F66E.quest_desc: ["&aObtain&r The Immolator from the Cataclysm mod. This &blegendary&r weapon carries the power of flames, burning enemies with every strike and &brepresenting&r the destructive force of the Nether. Only &bwarriors&r who have conquered the fires of the Burning Arena can &bclaim&r such a weapon."]
	quest.00105AA28075F66E.quest_subtitle: "A blade forged in the heart of the inferno"
	quest.00105AA28075F66E.title: "&cThe Immolator"
	quest.0019C8CF26C8D6E6.quest_desc: ["&6Nixie&r Tubes are Create's compact digital display. They can show text and numbers using a Name Tag, and &bmultiple&r tubes can be placed together to create longer displays. They can also display the strength of a Redstone signal, from 0 to 15, making them useful for counters, timers, status indicators and other automated systems. Nixie Tubes can be dyed to &bchange&r their display color and can &breceive&r information through Display Links."]
	quest.0019C8CF26C8D6E6.quest_subtitle: "Let the numbers speak"
	quest.003A8D9C85DB66D9.quest_desc: ["&dSets&r targets on &bfire&r when your bullets hit, adding extra burning damage over time."]
	quest.003A8D9C85DB66D9.quest_subtitle: "Light them up"
	quest.005C13436B51FF2D.quest_subtitle: "More Armor"
	quest.006D79A07FE206CC.quest_desc: ["&6A&r simple lamp that glows when you pass &bcurrent&r through it. It needs a current-limiting resistor or it breaks right after lighting up."]
	quest.006D79A07FE206CC.quest_subtitle: "Glows when powered"
	quest.008D567C087C638C.quest_desc: [
		"The Amaramber Pickaxe is a &amining&r tool from Eternal Starlight &bintroduced&r in version 0.4.2 as part of the Amaramber equipment set."
		""
		"&aIt&r is &bused&r for standard mining progression within the Starlight dimension and is crafted from Amaramber materials obtained from Torreya-related &bresources&r."
	]
	quest.008D567C087C638C.quest_subtitle: "Amber mining tool"
	quest.009F54FC4421820A.quest_desc: ["&dArcane&r Ingot is an important crafting material in Iron's Spells 'n Spellbooks. It is made by condensing Arcane Essence and is used in &badvanced&r magical crafting, including powerful &bequipment&r and Weapon Parts."]
	quest.009F54FC4421820A.quest_subtitle: "Condense magical essence into a powerful arcane metal"
	quest.00AA36F8E1AB4842.quest_desc: [
		"&dFire&r Rune is a crafting ingredient in Iron's Spells 'n Spellbooks, used for advanced &bFire-related&r crafting, including Fire Upgrade Orbs. It is the &bFire-school&r version of a Runestone."
		""
		"&bCreate&r a Fire Rune by combining a Blank Runestone with 8 Blaze Rods. Blaze Rods are the Fire Focus of the mod."
	]
	quest.00AA36F8E1AB4842.quest_subtitle: "Infuse a runestone with the blazing power of Fire magic"
	quest.00ABC8F7876F68AD.quest_subtitle: "Yummy!"
	quest.00C2B4287BE62369.quest_desc: ["&6The&r Gilded Quartz Shovel is part of the Gilded Quartz tool set from Create Stuff 'N Additions. It has 1644 durability and is designed as a powerful &balternative&r to standard shovels. It is crafted &busing&r Polished Rose Quartz, Iron Sheets, Gold and a Quality Tool Handle. The Gilded Quartz tools are known for their &bincreased&r mining and attack speed."]
	quest.00C2B4287BE62369.quest_subtitle: "Dig with a golden touch"
	quest.00D9C1D70B5E3AC3.quest_desc: [
		"&dSpellbreaker&r is a powerful imbued sword in Iron's Spells 'n Spellbooks. It can be &bimbued&r with 1 spell and comes with Counterspell I as its imbued spell."
		""
		"When held in the main hand, it provides &b10&r Attack Damage, &b1.8&r Attack Speed and &b+15%&r Cooldown Reduction. Counterspell I costs &b50&r Mana and has a &b5-second&r cooldown."
		""
		"It is a &bcraftable&r weapon introduced alongside the Weapon Parts system."
	]
	quest.00D9C1D70B5E3AC3.quest_subtitle: "Strike down enemy magic with a blade forged for counterspells"
	quest.00E3EBCB9222F522.quest_desc: [
		"&aThe&r Thermal Springstone Chestplate is a protective armor piece from Eternal Starlight crafted &busing&r Thermal Springstone Ingots."
		""
		"Thermal Springstone &aarmor&r ignites attacking enemies and provides significant protection against fire damage, making it &buseful&r in hazardous hot environments."
	]
	quest.00E3EBCB9222F522.quest_subtitle: "Flame-resistant body armor"
	quest.00FC2A0CB2BA8D1E.quest_subtitle: "Yummy!"
	quest.011376CB499B67C9.quest_desc: ["&6Craft&r the Card Inscriber and create unique scripted Cards. Insert a Card and configure its code to register information onto it. The &bresulting&r card can be checked with the Card Reader, while the card's &bscript&r can be inspected using the Magnifying Glass. Cards are registered to the player who creates them, &bpreventing&r another player from simply reproducing the same scripted card."]
	quest.011376CB499B67C9.quest_subtitle: "Program your own cards"
	quest.011394DC44B442FC.quest_subtitle: "Yummy!"
	quest.01195E83FF391E1C.quest_desc: ["&6Obtain&r a Smart Chute from Create. It is an advanced version of the Chute that allows you to filter which &bitems&r are extracted, making it &buseful&r for automated storage and sorting systems. Combined with a Filter, List Filter, or Attribute Filter, it can selectively move specific items while &bleaving&r the rest behind."]
	quest.01195E83FF391E1C.quest_subtitle: "Sort your items with precision"
	quest.013488785BFC139B.quest_subtitle: "More Armor"
	quest.013CEB32007F6505.quest_desc: ["&dThe&r Cowboy Hat has a special ability: when you &bkill&r something with a gun, your gun is instantly reloaded. It has a cooldown before it can trigger again, so make every kill count."]
	quest.013CEB32007F6505.quest_subtitle: "Reload on the spot"
	quest.0150B552F3BB0296.quest_subtitle: "Yummy!"
	quest.01510311E42F692C.quest_desc: ["&aCraft&r a Cursium Chestplate from the Cataclysm mod. This &bpowerful&r chest armor is created by upgrading a Netherite Chestplate with a Cursium &bUpgrade&r Smithing Template and a Cursium Ingot in a Smithing Table. It is part of the Cursium armor set and provides powerful &babilities&r when equipped."]
	quest.01510311E42F692C.quest_subtitle: "Armor forged from cursed souls"
	quest.0185F48F7668F433.quest_desc: [
		"&9&lThe&r&r Limited Oak Barrel I is an early storage option from Sophisticated Storage. While its capacity is limited, it &bprovides&r a practical and compact place to keep your items organized."
		""
		"&bUse&r it as a stepping stone toward larger and &bmore&r advanced storage containers as your storage system grows."
	]
	quest.0185F48F7668F433.quest_subtitle: "A compact barrel with room for improvement"
	quest.0191B94C2BBEE2BE.quest_desc: [
		"The Thallasium Sword Handle is a crafting component used to assemble a Thallasium Sword at the &aSmithing Table&r."
		""
		"It's combined with a Thallasium tool head via the &bTool Assembly&r Smithing Template."
	]
	quest.0191B94C2BBEE2BE.quest_subtitle: "Grip for a Thallasium blade"
	quest.019BF7D04AEEDC5F.quest_desc: ["&aDefeat&r 3 Deepling Priests from the Cataclysm mod. These powerful aquatic enemies &buse&r magic attacks and can be found among the Deepling &bstructures&r in the deep ocean. Defeating them helps clear the &bdangerous&r inhabitants of the underwater ruins."]
	quest.019BF7D04AEEDC5F.quest_subtitle: "Defeat the ocean's dark shamans"
	quest.019BF7D04AEEDC5F.title: "Kill Deepling Priest"
	quest.01C20F39FB43985D.quest_desc: [
		"&l&9Improve&r&r the efficiency of compatible Refined Storage devices with the Stack Upgrade. It &ballows&r devices to process or transfer larger quantities of items at once, reducing the number of operations &bneeded&r and making your automated systems more efficient."
		""
		"Install it in a &bcompatible&r device and let your network handle resources in larger batches."
	]
	quest.01C20F39FB43985D.quest_subtitle: "Handle more items with every operation"
	quest.020BB6244390D975.quest_desc: ["&6Obtain&r a Sticker from Create. It is a mechanical attachment block used to temporarily stick blocks to moving Contraptions. When &bactivated&r with a Redstone signal, it extends and attaches to the block in front of it, allowing that block to move with the contraption. Stickers are especially useful for smaller, selective &battachments&r where Super Glue would be excessive."]
	quest.020BB6244390D975.quest_subtitle: "Stick your contraptions together"
	quest.02497D0A52780F58.title: "The modpack creator is sick"
	quest.024B506A6251907A.quest_desc: [
		"&dThe&r Ring of Invisibility is a humorous curio from Iron's Spells 'n Spellbooks. Despite &bits&r name, it does not make the &bwearer&r invisible — the ring itself is the invisible one."
		""
		"A &bmysterious&r little joke hidden among the magical curios of the mod."
	]
	quest.024B506A6251907A.quest_subtitle: "The ring is invisible, but the joke is not"
	quest.0253E8C650B6D950.quest_desc: [
		"&eNot&r every artifact has to be useful."
		""
		"The Whoopee Cushion &boccasionally&r makes a farting sound when you start sneaking. That's it. No hidden power, no secret ability — just pure childish comedy."
		""
		"&bSneak&r quietly. Or don't."
	]
	quest.0253E8C650B6D950.quest_subtitle: "Sneak quietly. Or don't."
	quest.02541FC2E84A51F8.quest_desc: ["&6Obtain&r a Gearshift from Create. It normally transmits &brotational&r force like a Shaft, but when it receives a Redstone signal, it reverses the &bdirection&r of the outgoing rotation. This makes it useful for &bcontrolling&r the direction of mechanical systems."]
	quest.02541FC2E84A51F8.quest_subtitle: "Reverse the flow of power"
	quest.0266D98A5FBF3790.quest_desc: [
		"&6Not&r every aircraft needs a powerful engine. The Gyrodyne relies on human power and requires a good initial push to &bget&r its rotor spinning, while the Quadrocopter &btakes&r a more experimental approach with four propellers mounted on a bamboo frame."
		""
		"Build both aircraft and &bexperience&r two very different ways of taking to the skies."
	]
	quest.0266D98A5FBF3790.quest_subtitle: "From human power to four spinning rotors."
	quest.0266D98A5FBF3790.title: "Gyrodyne \\& Quadrocopter"
	quest.0268C80107F12D7A.quest_desc: [
		"&eWhy&r walk when you can run?"
		""
		"Running Shoes increase your movement speed by &b40%&r while sprinting and let you step over &bone-block-high&r obstacles without jumping. Perfect for travelling quickly across the world without &bconstantly&r stopping for terrain."
		""
		"&bKeep&r running. Nothing stands in your way."
	]
	quest.0268C80107F12D7A.quest_subtitle: "Run faster. Step higher"
	quest.027736EF66F1B626.quest_subtitle: "Upgrade+"
	quest.0289A9A5C9B1631E.quest_desc: ["Gold&a enhances&r your armor with unique properties. These leggings may not offer the highest defense, but they provide useful bonuses and flexibility in &bcombat&r."]
	quest.0289A9A5C9B1631E.quest_subtitle: "Agility and style"
	quest.0289A9A5C9B1631E.title: "Gold Netherite Leggings"
	quest.028BB0FE39A10D3E.quest_desc: ["&6Obtain&r a Wand of Symmetry from Create. It is a powerful building tool that &bautomatically&r mirrors blocks you place or &bdestroy&r across a selected axis or pattern. It supports Mirror Once, Rectangular, and Octagonal modes, making it especially useful for symmetrical buildings and large structures. Its &bdefault&r range is 50 blocks."]
	quest.028BB0FE39A10D3E.quest_subtitle: "Build twice as fast"
	quest.028FF00496C34DB2.quest_desc: [
		"&aCraft&r a Photo Album to &bstore&r your Developed Film Rolls and Photographs."
		"Organize your photos and easily access them for viewing or projection with the Interplanar Projector."
	]
	quest.028FF00496C34DB2.quest_subtitle: "Keep your memories safe"
	quest.02AAF18545E544D1.quest_desc: [
		"&dPrismatic&r Knight Chestplate is part of the Prismatic Knight Armor set, the &bstrongest&r armor set in Crystal Chronicles."
		""
		"It is &bcrafted&r using a Divine Soulshard from Iron’s Spells ’n Spellbooks and can be created by upgrading the chestplate from any &benhanced&r Crystal Chronicles armor set. The Prismatic Knight Armor &brepresents&r the final and most powerful stage of the Crystal Chronicles armor progression."
	]
	quest.02AAF18545E544D1.quest_subtitle: "The ultimate chestplate forged from the power of the Crystal Chronicles"
	quest.02D89EF9720A17CC.quest_desc: ["&dBloody&r Vellum is a crafting ingredient added to Iron's Spells 'n Spellbooks. It is made using Hogskin and Blood in the Alchemist Cauldron and is used in recipes for powerful &bblood-related&r magical equipment, &bincluding&r the Vampiric Spell Book."]
	quest.02D89EF9720A17CC.quest_subtitle: "Infuse ancient parchment with the essence of blood"
	quest.02DB1F6B9D031153.quest_subtitle: "Yummy!"
	quest.02E0B3B8DCD33635.quest_desc: [
		"The Deepsilver Pickaxe is a &amining&r tool from Eternal Starlight crafted &busing&r Deepsilver Ingots."
		""
		"It &aserves&r as an early-to-mid progression pickaxe used in swamp and Nightfall regions, &boffering&r durability between iron and diamond tiers."
	]
	quest.02E0B3B8DCD33635.quest_subtitle: "Swamp mining tool"
	quest.02E1B47EAEDBA692.quest_subtitle: "More Armor"
	quest.02FD2A409C20DF22.quest_desc: [
		"&aCraft&r a Fishing Rod and discover the countless treasures &bhidden&r beneath the water's surface. While &bfish&r are the most common catch, patient anglers may reel in enchanted books, valuable equipment, or other unexpected rewards."
		""
		"&aFishing&r is more than a reliable source of food—it is a peaceful way to &bgather&r rare loot and prepare for the &badventures&r that await across rivers, lakes, and vast oceans."
	]
	quest.02FD2A409C20DF22.quest_subtitle: "Cast your line into the unknown"
	quest.02FD2A409C20DF22.title: "Fishing Rod"
	quest.0302A490E961138F.quest_subtitle: "Yummy!"
	quest.030FE9082358AAB5.quest_desc: [
		"&9&lYou&r&r don't have to replace every chest and barrel to build a digital storage system. External Storage allows your Refined Storage network to &baccess&r items stored in connected inventories as if they were part of the network."
		""
		"Connect it to a chest, barrel or another &bcompatible&r storage block and let Refined Storage access its &bcontents&r directly. A great way to expand your network without moving everything into storage disks."
	]
	quest.030FE9082358AAB5.quest_subtitle: "Connect existing storage to your digital network"
	quest.031177D7283A6D4A.quest_desc: [
		"&9&lBefore&r&r creating a storage disk, you &bneed&r a proper housing to hold its components together. Storage Housing is a key crafting component &bused&r to create storage disks for your Refined Storage network."
		""
		"Craft one and &btake&r the first step toward expanding your digital storage capacity."
	]
	quest.031177D7283A6D4A.quest_subtitle: "Build the foundation for your storage disks"
	quest.0313789839DC5379.quest_desc: [
		"&dEmpty&r Upgrade Orb is the base material used to craft the different Upgrade Orbs in Iron's Spells 'n Spellbooks. It can be transformed into &bspecialized&r orbs such as Fire, Ice, Lightning, Holy, Blood, Evocation, Nature, Ender, Mana, Protection and Cooldown Upgrade Orbs."
		""
		"&bUse&r Empty Upgrade Orbs to &bbegin&r upgrading magical equipment at the Arcane Anvil."
	]
	quest.0313789839DC5379.quest_subtitle: "The foundation for powerful magical upgrades"
	quest.03195A236D34AD1B.quest_desc: [
		"&eThe&r water doesn't have to slow you down."
		""
		"Flippers dramatically improve your swimming speed, letting you &bmove&r through water with far greater agility. With them equipped, you'll be able to explore oceans, rivers and underwater &bstructures&r much faster. By default, they provide &b+100%&r swimming speed."
		""
		"&bDive&r in. The water is yours."
	]
	quest.03195A236D34AD1B.quest_subtitle: "Swim like you were born for it"
	quest.031D6C4EFA6F9ACB.quest_desc: ["&dGives&r each shot a chance to &brefund&r the ammo it used, stretching your magazine further."]
	quest.031D6C4EFA6F9ACB.quest_subtitle: "Never run dry"
	quest.0354FE634B3BA6EB.quest_desc: ["&aSimple Voice Chat&r lets you talk to other players in-game using your microphone. Your voice can be heard only by players nearby, making interactions more immersive and realistic. You can adjust microphone &bsettings&r, volume, and proximity in the mod’s settings menu. Make sure your mic is properly set up so everyone can hear you clearly."]
	quest.0354FE634B3BA6EB.quest_subtitle: "Read This First!"
	quest.0354FE634B3BA6EB.title: "&aSimple Voice Chat"
	quest.0361ECBFF743E37B.quest_desc: ["&6The&r Layered Magnet is an advanced magnetic component from Create: New Age. By combining multiple magnetic materials into layers, it provides the strength &bneeded&r for more advanced electrical and &bpower-generating&r technologies. Upgrade your magnetic setup and prepare for the &bnext&r stage of your factory's electrical progression."]
	quest.0361ECBFF743E37B.quest_subtitle: "Stack up the magnetic force"
	quest.036BD1517ACB7B22.quest_desc: [
		"&aThe&r Fiery Ingot is one of the most &bvaluable&r crafting materials in the Twilight Forest. Forged using the mystical essence of the Hydra, it contains immense heat and magical energy, allowing &bskilled&r smiths to create &bequipment&r capable of withstanding the harshest battles."
		""
		"&aWeapons&r and armor &bcrafted&r from Fiery Ingots are renowned for their exceptional durability and blazing power, making them an essential upgrade for adventurers preparing to challenge the strongest &bcreatures&r hidden within the Twilight Forest."
	]
	quest.036BD1517ACB7B22.quest_subtitle: "Forged in the flames of the Hydra"
	quest.036D672ABA4A9608.quest_desc: ["&aObtain&r the Blazing Grips from the Cataclysm mod. These &blegendary&r gauntlets are &binfused&r with the power of the Nether's eternal flames, allowing their wearer to unleash devastating fiery attacks. A worthy trophy for those who &bconquer&r the infernal realm."]
	quest.036D672ABA4A9608.quest_subtitle: "Grip the flames without fear"
	quest.036DBC8E98B9BD89.quest_desc: ["&6Obtain&r a Train Casing from Create. It is one of the key components required to &bbuild&r trains and railway infrastructure. A Train Casing is made by &bapplying&r a Sturdy Sheet to a Brass Casing"]
	quest.036DBC8E98B9BD89.quest_subtitle: "Forge the foundation of your railway empire"
	quest.03826AFFC76629E2.quest_desc: ["&aObtain&r the Cursed Bow from the Cataclysm mod. This &bpowerful&r ranged weapon is dropped by Maledictus in the Frosted Prison. It is a &bunique&r bow with special attacks that ignore &bnormal&r damage protection mechanics."]
	quest.03826AFFC76629E2.quest_subtitle: "A bow cursed with dark power"
	quest.03826AFFC76629E2.title: "&dCursed Bow"
	quest.0390D4F9CEDAD5CC.quest_desc: [
		"&dPyromancer&r Boots are part of the Pyromancer Armor set in Iron's Spells 'n Spellbooks. When worn, they provide &b+3&r Armor, &b+125&r Max Mana, &b+10%&r Fire Spell Power and &b+5%&r Spell Power."
		""
		"They are &bcrafted&r or upgraded using Fire Rune, Wizard Boots and Arcane Essence in the current version."
	]
	quest.0390D4F9CEDAD5CC.quest_subtitle: "Walk through the flames with the power of Fire magic"
	quest.03B1C538ED56A66F.quest_subtitle: "More Armor"
	quest.03B2155FDB3E1844.quest_desc: [
		"Sometimes building is not enough — you also need to clear space."
		"The Destruction Template allows your Construction Stick to break multiple blocks at once, making large clearing tasks much easier."
		""
		"Use this upgrade to remove blocks quickly and prepare areas for new builds."
	]
	quest.03B2155FDB3E1844.quest_subtitle: "Break Blocks Faster"
	quest.03C2520CBD4C3309.quest_desc: [
		"&dThe&r Book of R'lyeh is a powerful spellbook from the Cataclysm Spellbook Addon for Iron's Spells 'n Spellbooks. It provides &b12&r spell slots, &b+30%&r Abyssal Spell Power and &b+300&r Max Mana, making it an exceptional &bchoice&r for a mage devoted to the terrifying power of the abyss."
		""
		"Wield this forbidden tome and &bembrace&r the eldritch forces hidden beyond the depths."
	]
	quest.03C2520CBD4C3309.quest_subtitle: "Unleash the abyssal power of the deep"
	quest.03C4AE7A97E285C2.quest_desc: ["&aObtain&r Lacrima, a rare material from L_Ender’s Cataclysm. The &bmaterial&r is part of Cataclysm’s crafting resources; the mod has also received updates &bspecifically&r changing Lacrima's appearance."]
	quest.03C4AE7A97E285C2.quest_subtitle: "A tear of ancient power"
	quest.03CB549D5D816498.quest_desc: ["&6The&r Heap of Experience is an experience crafting material from Create Stuff 'N Additions. It is crafted by combining 9 Experience Nuggets and is &bused&r as a component for crafting the mod's experience-based tools and equipment. Stock up on these heaps to &bprepare&r for more advanced &bexperience&r technology."]
	quest.03CB549D5D816498.quest_subtitle: "Gather your knowledge"
	quest.03D75A772FA1D39F.quest_desc: [
		"&9&lTired&r&r of running out of inventory space? The Backpack gives you extra storage that you can carry wherever you go. It can be worn on your back, &bopened&r directly from your inventory or placed in the world when you need a proper storage container."
		""
		"And this is only the &bbeginning&r — upgrade your backpack to increase its capacity and unlock powerful upgrades."
	]
	quest.03D75A772FA1D39F.quest_subtitle: "Your storage, wherever your adventure takes you"
	quest.03F1250FD8A16DA3.quest_subtitle: "Upgrade+"
	quest.042954A042B740AF.quest_desc: [
		"&aObtain&r the Tool Assembly Smithing Template, used at a Smithing Table to combine a Better End tool head with a handle into a finished &btool&r."
		""
		"It's a core part of crafting Thallasium, Terminite, and Aeternium tools and &bweapons&r."
	]
	quest.042954A042B740AF.quest_subtitle: "Piecing a tool together"
	quest.0438C4A2D6F5CB01.quest_subtitle: "More Armor"
	quest.044A7AA5CB774CEC.quest_desc: ["&dA&r valuable crafting material &bused&r in various recipes for weapons, equipment and other special items in Hazen N Stuff."]
	quest.044A7AA5CB774CEC.quest_subtitle: "A dark material used for powerful crafting"
	quest.045B48F33E0F4F13.quest_desc: ["&6Craft&r the Magnifying Glass and &buse&r it to inspect scripted Cards. With a Card in your off-hand, the Magnifying Glass lets you view the card's script, making it easier to examine and understand &bprogrammed&r cards in Create: Misc \\& Things."]
	quest.045B48F33E0F4F13.quest_subtitle: "Inspect the secrets inside"
	quest.0473C3BA0E426525.quest_desc: ["&dYour&r bullets create a &bpoison&r cloud on hit and poison the target."]
	quest.0473C3BA0E426525.quest_subtitle: "Poison cloud"
	quest.0480BA45729F5784.quest_desc: [
		"&dRare&r Ink is the third tier of magical ink in Iron's Spells 'n Spellbooks. It is used in the Scroll Forge to create &bRare-rarity&r spell scrolls and in the Arcane Anvil to upgrade scrolls requiring Rare Ink."
		""
		"Find this &bvaluable&r ink in magic structures or obtain it from powerful magical creatures."
	]
	quest.0480BA45729F5784.quest_subtitle: "A refined essence for powerful magic"
	quest.0480BA45729F5784.title: "&bRare Ink"
	quest.049EE80BF0B3E210.quest_desc: ["&6Obtain&r an Encased Fan from Create. When powered by rotational force, it &bgenerates&r an air current that can push or pull entities. With the right &bprocessing&r setup, its airflow can also perform Bulk Blasting, Smoking, Washing, and Haunting, making it one of Create's most versatile &bprocessing&r components."]
	quest.049EE80BF0B3E210.quest_subtitle: "Harness the power of moving air"
	quest.04A61F614DD87EC4.quest_desc: ["&6An&r electric bell that makes sound when you &bpower&r it. Use it as an alarm for faults or overloads."]
	quest.04A61F614DD87EC4.quest_subtitle: "An alarm bell"
	quest.04A6BA7CF2878664.quest_desc: [
		"As you &aprogress&r through Eternal Starlight, stronger &bcreatures&r and rarer resources begin to appear."
		"Among the most important are the refined Aethersent Ingot and the rare &aCreator&r Hide — materials tied to advanced &acrafting&r and higher-tier &bprogression&r."
		""
		"&aObtaining&r both proves that you are moving beyond basic survival and entering the more dangerous stages of the dimension."
	]
	quest.04A6BA7CF2878664.quest_subtitle: "Resources of the deeper dimension"
	quest.04A6BA7CF2878664.title: "&6Advanced Starlight Materials"
	quest.04A8EA39E3354930.quest_desc: [
		"Within the vibrant &blands&r of Eternal Starlight, the Scarlet Forest stands out with its deep red vegetation and striking atmosphere."
		"This &abiome&r is rich in unique resources but also filled with dangerous creatures that thrive in its dense environment."
		""
		"&aExploring&r it will expand your knowledge of the dimension and unlock new &bopportunities&r for progression."
	]
	quest.04A8EA39E3354930.quest_subtitle: "Crimson wilderness"
	quest.04A8EA39E3354930.title: "&cScarlet Forest"
	quest.04BE87C434B821DA.quest_desc: [
		"&eWhy&r settle for &bordinary&r jumps when you can bounce like a rabbit?"
		""
		"Bunny Hoppers increase your jump height by one block, letting you jump up to &b2&r blocks high. They also &bprotect&r you from fall damage, making high jumps much safer."
		""
		"Leap over &bobstacles&r and land without fear."
	]
	quest.04BE87C434B821DA.quest_subtitle: "Jump higher. Fall safer"
	quest.04D1B2AE5F05F374.quest_desc: [
		"&eThe&r power of the Wither can be &bterrifying&r — but what if you could wield it yourself?"
		""
		"The Withered Bracelet &bgives&r your melee attacks a chance to inflict Wither on your enemies. A single strike can leave your &bopponent&r slowly wasting away long after you've hit them."
		""
		"&bStrike&r them. Wither them. Finish the fight."
	]
	quest.04D1B2AE5F05F374.quest_subtitle: "Let decay become your weapon"
	quest.04DD4560D9BA7C06.quest_desc: [
		"&aThe&r Malarite Spear is an early-game weapon from Eternal Starlight, crafted &busing&r Malarite found in swamp biomes."
		""
		"&aIt&r is part of the basic &bprogression&r tier and provides extended reach in melee combat."
	]
	quest.04DD4560D9BA7C06.quest_subtitle: "Swamp ranged melee weapon"
	quest.04F277210CE487DC.quest_desc: ["&aObtain&r the Meat Shredder from L_Ender’s Cataclysm. This &bpowerful&r weapon is associated with The Harbinger and has a unique ability that bypasses the normal damage-invulnerability time of enemies. It was specifically updated to ignore Damage Time, making it &bespecially&r effective &bagainst&r Cataclysm bosses."]
	quest.04F277210CE487DC.quest_subtitle: "Tear through the strongest foes"
	quest.04F277210CE487DC.title: "&cMeat Shredder"
	quest.04F410EADCF1F37E.quest_desc: [
		"&dPaladin&r Leggings are the Crystal Chronicles upgraded version of Priest Leggings from Iron’s Spells ’n Spellbooks."
		""
		"They are upgraded using a Divinite Shard, &btransforming&r the original Priest Armor into the powerful Paladin Armor set. The Divinite Shard infuses the armor with the power of Holy magic, strengthening the &bwearer&r and their divine abilities."
	]
	quest.04F410EADCF1F37E.quest_subtitle: "An enhanced form of Priest Leggings, empowered by Divine energy"
	quest.050EC00E93BAA558.quest_desc: ["&aDefeat&r The Harbinger from L_Ender’s Cataclysm. Face this powerful ancient machine hidden deep &bbeneath&r the Overworld and overcome its &bdevastating&r arsenal. Destroy The Harbinger and prove that you are ready to challenge the &bgreatest&r threats of Cataclysm."]
	quest.050EC00E93BAA558.quest_subtitle: "Awakened from the depths"
	quest.050EC00E93BAA558.title: "&l&fThe &cHarbinger"
	quest.051669E86A9ACBA9.quest_desc: ["&6Obtain&r a Sturdy Sheet from Create. It is an advanced material used in important Create constructions, &bespecially&r trains and other heavy-duty components. &bIts&r production involves Powdered Obsidian and Lava, followed by repeated &bprocessing&r with a Mechanical Press."]
	quest.051669E86A9ACBA9.quest_subtitle: "Forge a material built to endure"
	quest.0518B57201351D29.quest_subtitle: "Upgrade+"
	quest.0540825ACC29B90E.title: "Let's Go"
	quest.05492015A5B293E7.quest_desc: ["&dGives&r your bullets &bpiercing&r, letting them pass through targets to hit several enemies in a line."]
	quest.05492015A5B293E7.quest_subtitle: "Punch right through"
	quest.055849A6CD502B56.quest_desc: ["&aObtain&r the Azure Sea Shield from L_Ender’s Cataclysm. This shield is &bcrafted&r using Lacrima and gold. Besides normal shield protection, successfully blocking an attack can trigger a counter effect that &bknocks&r the attacker back, applies Slowness II to them, and grants you Strength II."]
	quest.055849A6CD502B56.quest_subtitle: "Turn the storm against your enemies"
	quest.055849A6CD502B56.title: "&bAzure Sea Shield"
	quest.0564322620D312AF.quest_desc: [
		"The Aeternium Axe is a top-tier &awoodcutting&r and combat tool, crafted from Aeternium — a material stronger than Netherite itself."
		""
		"It represents the &bpeak&r of Better End's tool progression."
	]
	quest.0564322620D312AF.quest_subtitle: "Woodcutting tool of the strongest tier"
	quest.056D02CAE000F853.quest_desc: ["&aThe&r Cutting Board is a useful kitchen tool from Farmer's Delight. It is &bused&r together with a knife to &bprocess&r and prepare various ingredients, allowing you to create components &bneeded&r for different recipes and meals."]
	quest.056D02CAE000F853.quest_subtitle: "A simple tool for preparing fresh ingredients"
	quest.057F00BCB3EB2790.quest_desc: [
		"&aCraft&r the Ironwood Axe using Ironwood Ingots infused with the magic of the Twilight Forest. Combining the durability of iron with the mystical power of the forest, this axe is an &bexcellent&r tool for harvesting wood and a dependable weapon when &bdanger&r arises."
		""
		"&aAs&r part of the Ironwood &bequipment&r set, it offers improved performance over conventional tools and prepares adventurers for the increasingly dangerous &bregions&r of the Twilight Forest."
	]
	quest.057F00BCB3EB2790.quest_subtitle: "An axe strengthened by ancient magic"
	quest.05818657116C1DC5.quest_subtitle: "Yummy!"
	quest.05825915587667CC.quest_desc: [
		"The Thermal Springstone Axe is a woodcutting tool &afrom&r Eternal Starlight crafted &busing&r Thermal Springstone Ingots."
		""
		"&aIt&r is used for harvesting wood in geothermal regions and serves as a mid-tier &bprogression&r tool with heat-resistant properties."
	]
	quest.05825915587667CC.quest_subtitle: "Geothermal woodcutting weapon"
	quest.0591697AFC04B55F.quest_subtitle: "More Weapon"
	quest.05A39F537E50F571.quest_desc: ["&aObtain&r the Tidal Claws from the Cataclysm mod. These legendary claw weapons are infused with the power of the sea, allowing their wielder to unleash swift and &bdevastating&r attacks. &bRecovered&r from the depths ruled by The Leviathan, they embody the relentless force of the ocean."]
	quest.05A39F537E50F571.quest_subtitle: "Strike with the fury of the tides"
	quest.05A39F537E50F571.title: "&5Tidal Claws"
	quest.05A9474567148510.quest_desc: ["&6Craft&r the Candy Cane Axe from Create: Confectionery and take on your woodcutting with a festive touch. It is &bpart&r of the Candy Cane Tools set, alongside the Candy Cane Pickaxe, Sword, Shovel, and Hoe."]
	quest.05A9474567148510.quest_subtitle: "Chop wood with a sugary twist"
	quest.05AAA2C58CA314CA.quest_desc: [
		"The Terminite Sword Handle is a crafting component used to assemble a Terminite Sword at the &aSmithing Table&r."
		""
		"Like other Better End handles, it's combined with a matching tool head to form the finished &bweapon&r."
	]
	quest.05AAA2C58CA314CA.quest_subtitle: "Grip for a Terminite blade"
	quest.05BB9E617CE2A084.quest_desc: ["&6Unlock&r the three &bessential&r connectors from Create Crafts \\& Additions: the Small Connector, Small Connector with Light and Large Connector. &bUse&r them to connect machines and electrical components with spools and transfer Forge Energy throughout your factory. The Small Connector &bsupports&r up to four connections, while the Large Connector can handle up to eight. The Small Connector with Light also &billuminates&r when powered."]
	quest.05BB9E617CE2A084.quest_subtitle: "Build the backbone of your electrical network"
	quest.05CC111803C94400.quest_subtitle: "More Armor"
	quest.05D350E2F170F039.quest_desc: ["&6Obtain&r a Brass Ingot from Create. Brass is one of the key materials for &badvanced&r Create machinery and logistics. It is produced by mixing Copper and Zinc in a heated Mechanical Mixer, yielding &b2&r Brass Ingots from &b1&r Copper Ingot and 1 Zinc Ingot."]
	quest.05D350E2F170F039.quest_subtitle: "Forge the metal of advanced creation"
	quest.05DA11CCAC46AABD.quest_subtitle: "More Armor"
	quest.05DC2F31D7534BC8.quest_desc: ["&eEvery&r machine starts with the right components! Clockwork &bGear&r is a basic crafting material used to create Clockwork technology. Obtain some gears and use them to &bbuild&r new devices, such as &bmechanical&r wings and advanced crossbows. It's time to start building your own arsenal!"]
	quest.05DC2F31D7534BC8.quest_subtitle: "The Foundation of Every Invention"
	quest.05F04C35F8D6C617.quest_desc: [
		"&aDiscover&r the Shadow Forest, a dark and foreboding biome with limited visibility and patches of &bMurkweed&r that cause blindness on touch."
		""
		"&bShadow Walkers&r stalk this biome from the darkness alongside Phantoms — stay alert, as danger here strikes without warning."
	]
	quest.05F04C35F8D6C617.quest_subtitle: "Where shadows watch you"
	quest.05F04C35F8D6C617.title: "Shadow Forest"
	quest.05F5772645C09695.quest_desc: [
		"&aThe&r Thermal Springstone Helmet is a fire-resistant armor piece from Eternal Starlight crafted &busing&r Thermal Springstone Ingots."
		""
		"&aEach&r piece of Thermal Springstone armor ignites attacking enemies and reduces incoming fire damage, making it highly effective in &bdangerous&r hot environments."
	]
	quest.05F5772645C09695.quest_subtitle: "Flame-resistant headgear"
	quest.05F5D6041BCA4AAD.quest_desc: ["&aObtain&r Abyssal Sacrifice from the Cataclysm mod. This &brare&r item is used to summon the Ancient Remnant of the ocean depths — the Leviathan. Gather the required &bmaterials&r and prepare for a powerful underwater battle."]
	quest.05F5D6041BCA4AAD.quest_subtitle: "A ritual item to summon the Leviathan"
	quest.05F5D6041BCA4AAD.title: "&dAbyssal Sacrifice"
	quest.05FD09EA7882DDBB.quest_desc: ["&aThe&r Diamond Grappling Hook is the diamond version of the grappling hook. &bUse&r it to move through the &bworld&r more efficiently, overcome obstacles, and reach &bhard-to-access&r places."]
	quest.05FD09EA7882DDBB.quest_subtitle: "The Next Level of Mobility"
	quest.0605E26686B45A03.quest_desc: ["&6The&r Smart Hopper is an advanced logistics block from Create: Dreams n' Desires. Use it to control and automate the &bmovement&r of items through your factory, giving you more precise control over your &bitem-processing&r systems. It was added in the 2.2a-BETA update and later &breceived&r fixes for item voiding and filter updates."]
	quest.0605E26686B45A03.quest_subtitle: "Smarter item handling"
	quest.061C1577D29C847B.quest_subtitle: "More Armor"
	quest.0627E419171E75B1.quest_desc: ["&6Obtain&r Super Glue from Create. This essential tool is used to attach blocks together so they can move as a single Contraption. It can glue &bindividual&r blocks or entire areas, making it especially useful for Linear Chassis, Radial Chassis, and other moving mechanisms. Super Glue has &b99&r durability and can be repaired or enhanced with Unbreaking and Mending."]
	quest.0627E419171E75B1.quest_subtitle: "Hold your creations together"
	quest.063E2E1953B794FB.quest_desc: ["&dA&r special Charm that &bgrants&r the wearer a powerful bonus."]
	quest.063E2E1953B794FB.quest_subtitle: "A prestigious charm of the Prefect"
	quest.063F7110F10ADAD2.quest_desc: ["&dA&r special Charm &bused&r to enhance the wearer’s abilities."]
	quest.063F7110F10ADAD2.quest_subtitle: "A powerful charm of the Legate"
	quest.0659AC4211264DED.quest_desc: [
		"&dPriest&r Leggings are part of the Priest Armor set in Iron's Spells 'n Spellbooks. When worn, they provide &b+6&r Armor, &b+125&r Max Mana, &b+10%&r Holy Spell Power and &b+5%&r Spell Power."
		""
		"They can be &bcrafted&r using 7 Arcane Cloth and 1 Holy Rune, or upgraded from Wizard Leggings with 1 Holy Rune and 1 Arcane Essence at a Smithing Table."
	]
	quest.0659AC4211264DED.quest_subtitle: "Channel the sacred power of Holy magic through your armor"
	quest.066C078E77AECA39.quest_desc: [
		"&dThe&r fusion of Celestisynth and arcane knowledge &bunlocks&r a new path of progression. The Celestial Genesis is a unique spellbook available only when &bused&r alongside Iron’s Spells ‘n Spellbooks. It &benhances&r Celestial Weapon Damage, reduces &bskill&r cooldowns, and improves mana regeneration. Discover the &bbalance&r between steel and magic, and surpass the limits of an ordinary warrior."
		""
		"&bN&r - Supernal Netherite Inogt"
		""
		"&bNW&r - SolarCrystal"
		""
		"&bW&r - Crimson Piece"
		" "
		"&bSW&r - Wintereis Shard"
		""
		"&bS&r - Starstuck Feather"
		""
		"&bSE&r - Starstuck Scrap"
		""
		"&bE&r - Eyebomination"
		""
		"&bNE&r - Lunar Scrap"
		""
		"&bINPUT&r - Ruined Book"
	]
	quest.066C078E77AECA39.quest_subtitle: "The Beginning of Celestial Magic"
	quest.066C078E77AECA39.title: "&l&cThe &6Ce&ale&bsti&9al &5Ge&dne&fsis"
	quest.0681FF596BE81B0D.quest_desc: ["&6Obtain&r the Engineer's Goggles from Create. These goggles reveal &badditional&r information about Create's kinetic systems and machinery, making them an &bessential&r tool for understanding and working with your mechanical creations."]
	quest.0681FF596BE81B0D.quest_subtitle: "See the machinery behind the machine"
	quest.06AFEA2405911077.quest_desc: ["&aCraft&r an anvil to start combining and repairing your tools and armor. With the anvil, you can also name your items and enchant them for greater &bpower&r."]
	quest.06AFEA2405911077.quest_subtitle: "Master of Metals"
	quest.06C1C8DE6D197849.quest_subtitle: "More Armor"
	quest.06C2B5EC54BC4A73.quest_desc: [
		"&aThe&r Scepter of Twilight is the most powerful &bmagical&r artifact dropped by the Twilight Lich. It represents the purest form of his corrupted magic, condensed into a single &bunstable&r but devastating weapon."
		""
		"&aUnlike&r the other scepters, this one channels raw twilight energy, allowing the wielder to &bunleash&r powerful magical &battacks&r that can overwhelm enemies quickly. However, its power is chaotic and must be &bhandled&r with care, as it draws from unstable arcane forces."
	]
	quest.06C2B5EC54BC4A73.quest_subtitle: "The true power of the Lich reclaimed"
	quest.06D3887B7690D265.quest_subtitle: "Yummy!"
	quest.06D49660A7DD972C.quest_desc: [
		"&dCultist&r Armor is the chestpiece of the Cultist armor set in Iron's Spells 'n Spellbooks. It provides &b+8&r Armor, &b+125&r Max Mana, &b+10%&r Blood Spell Power and &b+5%&r Spell Power."
		""
		"The full set consists of Cultist Hood, Cultist Armor, Cultist Leggings and Cultist Boots. The armor can be &bcrafted&r with 8 Arcane Cloth and 1 Blood Rune, or upgraded from Wizard Robes with a Blood Rune in a Smithing Table on newer versions."
	]
	quest.06D49660A7DD972C.quest_subtitle: "Embrace the dark power of Blood magic"
	quest.06EB08C27EF2299A.quest_desc: [
		"&l&9Give&r&r your storage container the ability to work like a stonecutter. The Stonecutter Upgrade lets you process compatible blocks directly from your storage, turning raw materials into slabs, stairs and other stonecutting products without &bneeding&r a separate workstation."
		""
		"Add this &bupgrade&r to your storage and make block processing more convenient and efficient."
	]
	quest.06EB08C27EF2299A.quest_subtitle: "Bring precision stonecutting to your storage"
	quest.071A27ADD8E0422C.quest_desc: ["&6A&r wearable battery. When worn it powers equipment that needs &benergy&r (Electro-Zapper, Electro-Baton, Portable Drill, Portable Saw). Placed and wired to power, it charges at a rate that depends on the supplied &bvoltage&r."]
	quest.071A27ADD8E0422C.quest_subtitle: "A wearable battery"
	quest.072353BCDB43A8B1.quest_desc: ["&6The&r Prismarine Alloy Rod is an advanced crafting component from Create: Aquatic Ambitions. It is &bused&r in the mod's aquatic &bprogression&r to create more advanced equipment and components. Combine the power of Prismarine with metalworking to &bprepare&r for the deeper stages of your oceanic technology."]
	quest.072353BCDB43A8B1.quest_subtitle: "Forge the strength of the ocean"
	quest.07355D601044047D.quest_desc: ["&aThe fusion&r of diamond and Netherite results in one of the strongest armors possible. This chestplate provides exceptional durability and defense, perfect for endgame &bchallenges&r."]
	quest.07355D601044047D.quest_subtitle: "Ultimate protection"
	quest.07355D601044047D.title: "Diamond Netherite Chestplate"
	quest.073AA617D30A4D9E.quest_desc: ["&6Obtain&r Train Controls from Create. They are an essential component for creating and operating trains. At &bleast&r one set of Train Controls must face forward relative to the Train Station &bduring&r assembly. Once the train is assembled, &bright-clicking&r the controls lets you take &bcontrol&r of the train and drive it using the usual movement keys."]
	quest.073AA617D30A4D9E.quest_subtitle: "Take the helm of your first train"
	quest.073C3DFAD5006E32.quest_desc: ["&dVoid&r Ripper is a weapon from Crystal Chronicles, &bassociated&r with the enhanced Voidwalker equipment. It channels the power of the Abyss and the dark energy of the Abyssal Crystal, &bmaking&r it a formidable weapon for those who command the powers of the void."]
	quest.073C3DFAD5006E32.quest_subtitle: "A devastating weapon infused with the power of the Abyss"
	quest.073E32C33BC19775.quest_desc: [
		"&dElectromancer&r Boots are part of the Electromancer Armor set in Iron's Spells 'n Spellbooks. When worn, they provide &b+3&r Armor, &b+125&r Max Mana, &b+10%&r Lightning Spell Power and &b+5%&r Spell Power."
		""
		"They can be &bcrafted&r from 4 Arcane Cloth and 1 Lightning Rune, or upgraded from Wizard Boots with 1 Lightning Rune and 1 Arcane Essence."
	]
	quest.073E32C33BC19775.quest_subtitle: "Harness the devastating power of Lightning magic"
	quest.07429AB709FA2768.quest_desc: [
		"&dPriest&r Robes are the chestpiece of the Priest Armor set in Iron's Spells 'n Spellbooks. When worn, they provide &b+8&r Armor, &b+125&r Max Mana, &b+10%&r Holy Spell Power and &b+5%&r Spell Power. They can also be imbued with 1 spell."
		""
		"They can be &bcrafted&r with 8 Arcane Cloth and 1 Holy Rune, or upgraded from Wizard Robes with 1 Holy Rune at a Smithing Table in Minecraft 1.20+."
	]
	quest.07429AB709FA2768.quest_subtitle: "Channel the sacred power of Holy magic"
	quest.074CA911A75DFFB6.quest_subtitle: "Yummy!"
	quest.0764B71B15F7C43E.quest_desc: ["&aCraft&r the Ignis Mage Robes and Winged Mage Robes from the Cataclysm: Spellbooks addon. &bThese&r powerful mage garments are infused with the power of Ignis, combining ancient fire magic with the &bknowledge&r of spellcasters. They represent the mastery of infernal flames and the &blegacy&r of the Lord of Fire."]
	quest.0764B71B15F7C43E.quest_subtitle: "The robes of the eternal flame mage"
	quest.0765B61205952B2F.quest_desc: [
		"&dEnder&r Upgrade Orb is an upgrade material in Iron's Spells 'n Spellbooks. When applied at the Arcane Anvil, it grants &b+5%&r Ender Spell Power."
		""
		"It is &bcrafted&r from 1 Empty Upgrade Orb and 8 Ender Runes. Ender Runes are the runestones associated with the Ender school of magic."
	]
	quest.0765B61205952B2F.quest_subtitle: "Infuse your equipment with the power of Ender magic"
	quest.076890D97AF1EA4A.quest_desc: [
		"&aThe&r Zombie Scepter is a dark magical &bartifact&r obtained from the Twilight Lich. Unlike defensive scepters, this one channels necrotic energy, allowing the wielder to summon or &bcontrol&r zombie minions during combat."
		""
		"&aIt&r is a corrupted &bfragment&r of the Lich’s magic, infused with undead essence and unstable power. While powerful, it is unpredictable and best &bused&r in controlled situations, especially against groups of enemies or dungeon encounters."
	]
	quest.076890D97AF1EA4A.quest_subtitle: "Command the undead remnants"
	quest.077B307FA89623CF.quest_desc: ["&6A&r high-power resistor for limiting &bcurrent&r in a circuit. Click its top to change the &bresistance&r. Current equals the &bvoltage&r across the resistor divided by its resistance (I = V / R)."]
	quest.077B307FA89623CF.quest_subtitle: "A high-power resistor"
	quest.078241021F81ACA5.quest_subtitle: "Yummy!"
	quest.0795CBD288E28F30.quest_subtitle: "Yummy!"
	quest.079D7EA37D839FEB.quest_desc: ["&aObtain&r the Soul Brazier from the Cataclysm: Spellbooks addon. This &blegendary&r magical weapon burns with &bspectral&r soul fire, allowing its wielder to channel the power of the damned into &bdevastating&r attacks. It is a relic forged from the darkest magic of Cataclysm."]
	quest.079D7EA37D839FEB.quest_subtitle: "Wield the cursed flames of lost souls"
	quest.079D7EA37D839FEB.title: "&bSoul Brazier"
	quest.07A205AC0642A0E3.title: "heeee"
	quest.07B3AF57F8DAAEF9.quest_desc: [
		"&aThe&r Flowglaze Bow is a ranged weapon from Eternal Starlight, part of the Flowglaze &bprogression&r tier."
		""
		"&aIn&r newer versions of the mod, its crafting requires smithing templates as part of the &badvanced&r smithing system introduced for late-game equipment."
	]
	quest.07B3AF57F8DAAEF9.quest_subtitle: "Flow-infused ranged weapon"
	quest.07DDAF6B2DCF77D7.quest_desc: ["&aObtain&r the Bloom Stone Staff from the Cataclysm: Spellbooks addon. &bAdd&r this powerful magical weapon to your collection and continue your &bjourney&r through the secrets and relics introduced by the addon."]
	quest.07DDAF6B2DCF77D7.quest_subtitle: "Channel the power of ancient stone"
	quest.07DDAF6B2DCF77D7.title: "&dBloom Stone Staff"
	quest.07EC2DA039C7F9F3.quest_desc: [
		"&aCraft&r an Iron Fishing Rod and &bleave&r ordinary equipment behind. Reinforced with iron, this sturdy rod is built to withstand countless casts and the &bstruggle&r of larger, more valuable fish lurking beneath the surface."
		""
		"&aAs&r your fishing &badventures&r take you across rivers, lakes, and the open ocean, dependable equipment becomes essential. The Iron Fishing Rod offers the durability needed for long expeditions and brings you one step closer to uncovering the rarest treasures &bhidden&r within the depths."
	]
	quest.07EC2DA039C7F9F3.quest_subtitle: "A stronger rod for greater catches"
	quest.07F433267D08D295.quest_desc: [
		"&dShadow-Walker&r Armor is the chestpiece of the Shadow-Walker Armor set in Iron's Spells 'n Spellbooks. When worn, it provides &b+8&r Armor, &b+125&r Max Mana, &b+10%&r Ender Spell Power and &b+5%&r Spell Power. It can also be imbued with 1 spell."
		""
		"It can be &bcrafted&r from 8 Arcane Cloth and 1 Ender Rune, or upgraded from Wizard Robes with 1 Ender Rune and 1 Arcane Essence."
	]
	quest.07F433267D08D295.quest_subtitle: "Channel the mysterious power of Ender magic"
	quest.07FE2CE9572AB625.title: "&l&eThe Wither"
	quest.081B6DB73E4777B5.quest_desc: ["&6The&r Straw is a utility item from Create Crafts \\& Additions. Apply it to a Blaze Burner to give the burner an &binternal&r 4000 mB fluid reservoir, allowing it to use flammable fluids as fuel. The fluid can be supplied manually or through a fluid pipe network, &bmaking&r it possible to automate Blaze Burner fueling without using solid fuel. In the current 1.21.1 version, the mod also includes an &balternative&r recipe for Straw."]
	quest.081B6DB73E4777B5.quest_subtitle: "Feed your Blaze Burner with fluids"
	quest.082128F728795E9F.quest_desc: ["&dA&r special orb &bused&r to upgrade melee &bequipment&r in Hazen N Stuff."]
	quest.082128F728795E9F.quest_subtitle: "A powerful orb for melee upgrades"
	quest.082B8652D0A208B8.quest_desc: ["&6A&r smaller version of the Rheostat: tune its value by interacting with it."]
	quest.082B8652D0A208B8.quest_subtitle: "A small rheostat"
	quest.082C1D5A7A144078.quest_subtitle: "Upgrade+"
	quest.083018556858E4EF.quest_desc: ["&aObtain&r the Music Disc: The Leviathan from the Cataclysm mod. This &brare&r music disc is an &bexclusive&r trophy dropped by The Leviathan, carrying the &bhaunting&r melody of the ruler of the abyss. It is a symbol of your victory over one of the most terrifying &bcreatures&r lurking beneath the ocean. The &bdisc&r has a 10% chance to drop from the boss."]
	quest.083018556858E4EF.quest_subtitle: "The song of the endless abyss"
	quest.0833C7E3E65AAAE7.quest_desc: ["&6Welcome&r to Create: Confectionery! &bTurn&r your Create factory into a delicious candy workshop. Process Crushed Cocoa, Cocoa Butter, and Cocoa Powder, then produce Black, White, and Ruby Chocolate, Caramel, Chocolate Candies, Marshmallows, Gingerbread, Hot Chocolate, Honey Candy, and more. Build automated &bproduction&r lines and discover the sweet side of Create."]
	quest.0833C7E3E65AAAE7.quest_subtitle: "    Build your own chocolate factory         "
	quest.0833C7E3E65AAAE7.title: "&l&6Welcome Create Confectionery"
	quest.0842D3CE6A2B2281.quest_desc: ["&aObtain&r the Excelsius Propulsion Greaves. Add this powerful piece of armor to your collection and continue your &bjourney&r through the advanced &bequipment&r of the Excelsius arsenal."]
	quest.0842D3CE6A2B2281.quest_subtitle: "Move with unstoppable force"
	quest.0862C996C549201A.quest_desc: [
		"&eA&r snack for miners with a taste for speed."
		""
		"The Onion Ring grants Haste &bII&r after eating, with the duration &bdepending&r on how much hunger the food restores. By default, every food point restored gives you &b6&r seconds of Haste II."
		""
		"&bFill&r your stomach. Then break through the stone."
	]
	quest.0862C996C549201A.quest_subtitle: "Eat well. Mine fast"
	quest.086451087EA205F9.quest_desc: [
		"&eAn&r ordinary umbrella? Not quite."
		""
		"This mysterious artifact can protect you from falling and keep you safely floating through the air. It also works as a shield, making it a surprisingly &buseful&r companion for any adventurer."
		""
		"&bOpen&r it up and take the leap."
	]
	quest.086451087EA205F9.quest_subtitle: "Who needs wings when you have an umbrella?"
	quest.087D2C80A582AB68.quest_subtitle: "Upgrade+"
	quest.088CA5E81F7D93BD.quest_subtitle: "Yummy!"
	quest.0890D3A0F5B2174C.quest_desc: ["&6A&r card on which you store a sequence of &bsignals&r to play back in the reader."]
	quest.0890D3A0F5B2174C.quest_subtitle: "A punch card"
	quest.08943C9B6BFE7A9B.quest_desc: ["&6Craft&r the Radar, an advanced utility from Create: Misc \\& Things. It uses the mod's Vibration Mechanism and provides a way to &bdetect&r activity around you, adding a useful sensing tool to your Create &bautomation&r and contraptions. The Radar was introduced as a new use for the Vibration Mechanism."]
	quest.08943C9B6BFE7A9B.quest_subtitle: "Detect what lies around you"
	quest.089B72C3DAA3542C.quest_desc: ["&6Take&r your mobility to the next level with the Brass Jetpack and its &bultimate&r upgrade, the Netherite Jetpack. The Brass Jetpack lets you fly using fuel and water, while the Netherite version takes things even further, allowing you to swim through lava. &bUpgrade&r your jetpack and take your factory &badventures&r beyond the ground."]
	quest.089B72C3DAA3542C.quest_subtitle: "From flight to lava"
	quest.089B72C3DAA3542C.title: "Brass \\& Netherite Jetpack"
	quest.08B2549AD67E546F.quest_desc: ["&6An&r advanced component needed for the Servo, FE Inverter, Multimeter, Portable Battery and the portable tools."]
	quest.08B2549AD67E546F.quest_subtitle: "An advanced component"
	quest.08C0A49E1ED441D4.quest_desc: [
		"&aCraft&r the Knightmetal Pickaxe using &brefined&r Knightmetal Ingots recovered from the Goblin Stronghold. Forged from one of the strongest alloys in the Twilight Forest, this pickaxe offers exceptional &bdurability&r and mining power, allowing you to break through even the toughest stone and uncover valuable &bresources&r hidden &bdeep&r underground."
		""
		"&aFavored&r by the &bancient&r knights who once defended the stronghold, the Knightmetal Pickaxe is built to endure countless expeditions. It is an indispensable tool for adventurers seeking the forgotten &btreasures&r buried beneath the Twilight Forest."
	]
	quest.08C0A49E1ED441D4.quest_subtitle: "Carve a path through ancient stone"
	quest.08DC50F3AF89E3E7.quest_desc: [
		"&aSummon &rand &adefeat&r the Wither."
		"This powerful boss is extremely dangerous, but defeating it will reward you with a &bNether Star&r."
	]
	quest.08DC50F3AF89E3E7.quest_subtitle: "Defeat the deadly boss"
	quest.08DC50F3AF89E3E7.title: "&eThe Wither"
	quest.08E22710D284F725.quest_desc: ["&aThe&r Golden Grappling Hook is a &bgold-crafted&r version of the grappling hook. Use the hook and rope to travel through the world and reach &bhard-to-access&r places."]
	quest.08E22710D284F725.quest_subtitle: "Farther and Higher"
	quest.090F03F66D7CD8D1.quest_desc: [
		"&aThe&r Malarite Sickle is an early-game harvesting tool from Eternal Starlight, crafted &busing&r Malarite found in swamp biomes."
		""
		"&aIt&r is part of the basic progression tier and is &bused&r for gathering plants and vegetation more efficiently."
	]
	quest.090F03F66D7CD8D1.quest_subtitle: "Swamp harvesting tool"
	quest.096861ABA052871E.title: "Easy"
	quest.0971A95BBAA2B1CD.quest_subtitle: "More Weapon"
	quest.0974073AA5404B5D.quest_desc: [
		"&l&9Why&r&r stop at one backpack? The Inception &bUpgrade&r allows you to store other backpacks inside your main backpack, giving you an entirely new level of portable storage."
		""
		"&bNested&r backpacks can still use their own upgrades, while upgrades in the main backpack can interact with their contents. Just remember: backpacks inside &bother&r backpacks cannot contain another backpack."
	]
	quest.0974073AA5404B5D.quest_subtitle: "A backpack inside a backpack"
	quest.097EBBC8499E3076.quest_desc: [
		"Blazes found in Nether Fortresses&b drop&r Blaze Rods, a crucial resource for progression."
		"They are used in brewing potions and crafting important items like Brewing Stands."
		"&aBe careful&r — Blazes attack from range with fireballs and can quickly overwhelm &bunprepared&r players."
	]
	quest.097EBBC8499E3076.quest_subtitle: "Essence of fire"
	quest.097EBBC8499E3076.title: "&eBlaze Rods"
	quest.099AC871FCA36CE5.quest_desc: ["&6Craft&r a Bar of Ruby Chocolate in Create: Confectionery and add a vibrant pink treat to your chocolate collection. Ruby chocolate is &bknown&r for its naturally pink colour and distinctive fruity, slightly tangy flavour."]
	quest.099AC871FCA36CE5.quest_subtitle: "A bright and fruity chocolate delight"
	quest.09A3711748C8B289.quest_subtitle: "Upgrade+"
	quest.09C6ABB4721DCED4.quest_subtitle: "More Armor"
	quest.09F5F2584FBCAB0C.quest_desc: ["&dA&r special rune &bused&r to craft Eldritch weapons and armor in Hazen N Stuff."]
	quest.09F5F2584FBCAB0C.quest_subtitle: "A rune infused with eldritch power"
	quest.09F6C51C3AE27198.quest_desc: ["&6Obtain&r a Copper Diving Helmet from Create. &bWhen&r worn together with a Backtank containing &bpressurized&r air, it allows you to breathe underwater. It is the basic diving helmet of Create and forms the &bfoundation&r for the upgraded Netherite Diving Helmet."]
	quest.09F6C51C3AE27198.quest_subtitle: "Breathe beneath the waves"
	quest.09F8EFEC97F7555A.quest_subtitle: "More Weapon"
	quest.09F91AADEBAF3476.quest_desc: [
		"&dThe&r Flimsy Journal is the basic starter spellbook of Iron's Spells 'n Spellbooks. Made from copper, paper and string, it provides 5 spell slots and is &bdesigned&r to hold Common-rarity spells."
		""
		"&bUse&r the Inscription Table to inscribe spells from scrolls into the journal and begin building your &bfirst&r magical loadout."
	]
	quest.09F91AADEBAF3476.quest_subtitle: "Begin your journey as a spellcaster"
	quest.09FF0133A36649F6.quest_desc: [
		"&aObtain&r a Neptunium Nugget, a rare &bfragment&r of one of the most valuable metals hidden beneath the oceans. Most adventurers will never encounter this precious material, as it can only be &bacquired&r through patience, skill, and a bit of luck while fishing."
		""
		"&aThough&r small in size, every Neptunium Nugget is a &bstep&r toward forging the legendary Neptunium equipment. &bCollect&r enough of these rare fragments, and the treasures of the sea will become yours."
	]
	quest.09FF0133A36649F6.quest_subtitle: "A treasure from the depths"
	quest.09FF0133A36649F6.title: "&bNeptunium Nugget"
	quest.0A09F74C4FEC156E.quest_desc: [
		"&aThe&r Petal Scythe is a &bmelee&r weapon from Eternal Starlight, associated with plant-based materials and mid-to-advanced &bprogression&r within the dimension."
		""
		"Its exact &acrafting&r or acquisition method is not clearly documented in available public sources and is likely tied to mod progression systems or &bJEI&r recipes."
	]
	quest.0A09F74C4FEC156E.quest_subtitle: "A weapon of nature"
	quest.0A09F74C4FEC156E.title: "&6Petal Scythe"
	quest.0A121590649514A9.quest_desc: ["&6Obtain&r a Smart Fluid Pipe from Create. Unlike a regular Fluid Pipe, it can be &bconfigured&r to &ballow&r only a specific fluid to pass through it. Place a bucket or bottle &bcontaining&r the desired fluid in its filter slot to define what the pipe accepts."]
	quest.0A121590649514A9.quest_subtitle: "Filter the flow with precision"
	quest.0A17802CCD07DA32.quest_subtitle: "More Armor"
	quest.0A20F0B19B603EC3.quest_desc: [
		"&eForged&r around a blazing core, the Fire Gauntlet turns &bevery&r melee attack into a weapon of fire."
		""
		"Enemies struck by your attacks are set ablaze for &b8&r seconds, leaving them to burn even after you've landed your hit."
		""
		"&bLet&r your enemies feel the heat."
	]
	quest.0A20F0B19B603EC3.quest_subtitle: "Turn every strike into a burning blow"
	quest.0A25AD3260056973.quest_desc: ["&6The&r Experience Axe is a special axe from Create Stuff 'N Additions. When you use it to chop blocks, it has a &bchance&r to &bgenerate&r an Experience Orb, giving you extra XP while gathering resources. It has 270 durability, an Iron mining level, deals 7 attack damage and has &b1.5&r attack speed. It is &bcrafted&r with 3 Heaps of Experience and 2 Zinc Tool Handles."]
	quest.0A25AD3260056973.quest_subtitle: "Chop your way to experience"
	quest.0A3472BE91C2FA28.quest_desc: [
		"&dCooldown&r Upgrade Orb is an upgrade material in Iron's Spells 'n Spellbooks. When applied at the Arcane Anvil, it grants &b+5%&r Cooldown Reduction. It can be applied to compatible &bequipment&r up to 3 times."
		""
		"It is &bcrafted&r from 1 Empty Upgrade Orb and 8 Cooldown Runes."
	]
	quest.0A3472BE91C2FA28.quest_subtitle: "Reduce the time between your most powerful spells"
	quest.0A3AC20EC825D19E.quest_desc: [
		"&aCraft&r a Light Hook, a mysterious fishing &bupgrade&r infused with a faint magical glow. Designed for explorers who venture into unknown waters, this unique hook represents the connection between ancient magic and the endless &bpossibilities&r of the ocean."
		""
		"&aThe&r seas hide countless secrets, and ordinary tools may not always be enough to uncover them. With the Light Hook &bequipped,&r you are prepared to continue your journey toward discovering the rarest &bcatches&r and forgotten treasures beneath the waves."
	]
	quest.0A3AC20EC825D19E.quest_subtitle: "A touch of magic beneath the waves"
	quest.0A4803FEFA2D989E.quest_desc: ["&6Obtain&r a Package Filter from Create. It is an advanced logistics &bcomponent&r introduced in Create 6.0, designed specifically for sorting Cardboard Packages. By &bconfiguring&r its filter, you can match package addresses or use Create's simplified pattern system to control where &bpackages&r are routed. It is crafted from 2 Zinc Nuggets and 1 Wool."]
	quest.0A4803FEFA2D989E.quest_subtitle: "Sort every package with precision"
	quest.0A6ACBEF747EF0A3.quest_desc: ["&6A&r PNP bipolar transistor, the counterpart of the NPN in switching and amplifying circuits."]
	quest.0A6ACBEF747EF0A3.quest_subtitle: "A PNP transistor"
	quest.0A6C124B3D87E963.quest_subtitle: "More Armor"
	quest.0A7D3FF686D990AB.quest_desc: ["&aObtain&r Dragon Bone from the Bosses' Rise mod. &bHarvested&r from the remains of the mighty Infernal Dragon, this &brare&r material is used to forge powerful dragon-themed weapons and armor, serving as proof that you have &bslain&r one of the world's greatest beasts"]
	quest.0A7D3FF686D990AB.quest_subtitle: "Claim the remains of an ancient dragon"
	quest.0A841B56D6727BC7.quest_desc: [
		"&aHidden&r within the terrain of Eternal Starlight, Raw Amaramber is a rare and valuable material infused with starlight energy."
		"It is used for crafting advanced items and &bprogressing&r deeper into the dimension’s technology and &bmagic&r."
		""
		"Gather enough of this resource to begin &bunlocking&r its potential."
	]
	quest.0A841B56D6727BC7.quest_subtitle: "A glowing resource"
	quest.0A841B56D6727BC7.title: "Raw Amaramber"
	quest.0A8DEABA13C07E1C.quest_desc: ["&dA&r special rune used as a crafting component for &bmelee-related&r equipment in Hazen N Stuff."]
	quest.0A8DEABA13C07E1C.quest_subtitle: "A rune used for melee-related crafting"
	quest.0A980F79E98B30F0.quest_subtitle: "Yummy!"
	quest.0AE0B1E1386816AA.quest_subtitle: "More Weapon"
	quest.0AF89AFB836129BB.quest_desc: ["&dYour&r bullets release &bchain lightning&r on hit, arcing to nearby enemies for extra damage."]
	quest.0AF89AFB836129BB.quest_subtitle: "Chain lightning"
	quest.0AFA66CC198F587A.quest_desc: [
		"Deep within the Nether lies the &aCitadel&r — a massive and dangerous structure filled with powerful magical enemies, traps, and arcane &bsecrets&r."
		"This&a ancient fortress&r is tied to dark spellcasters and contains rare loot for those brave enough to &bexplore&r it."
		""
		"&aPrepare&r carefully before entering, as the Citadel is heavily guarded and designed to test even experienced &badventurers&r."
	]
	quest.0AFA66CC198F587A.quest_subtitle: "A fortress of forbidden magic"
	quest.0AFA66CC198F587A.title: "&dCitadel"
	quest.0B0DFECF205BF01A.quest_subtitle: "Yummy!"
	quest.0B1AB6E3CFE150FB.quest_desc: ["&6Craft&r the Lava Spout Gun and use lava as your ammunition. Fill it with &b1,000&r mB of lava &busing&r a Spout, then fire liquid projectiles at your targets. Lava deals 2 damage and sets the target on fire for &b10&r seconds. The gun has 500 durability."]
	quest.0B1AB6E3CFE150FB.quest_subtitle: "Set your targets ablaze"
	quest.0B2DEA16075AAA6C.quest_desc: [
		"Deep within the &adangerous&r magical ruins tied to Iron's Spells 'n Spellbooks, an ancient force still lingers — the Echo of Tyros."
		"This entity is not fully alive, but a residual manifestation of powerful arcane energy left behind by a forgotten mage."
		""
		"It distorts reality around itself, unleashes unstable &bspells&r, and overwhelms intruders with chaotic &bmagic&r."
		"&aOnly&r those who can endure heavy magical pressure and react quickly to unpredictable attacks stand a chance of &bdefeating&r it."
	]
	quest.0B2DEA16075AAA6C.quest_subtitle: "A forgotten arcane remnant"
	quest.0B2DEA16075AAA6C.title: "&l&4Echo of Tyros"
	quest.0B364EB72E807776.quest_desc: ["&6The&r part of the armature where you usually connect the electrical load. Together with the rotors and the clutch it forms the part of the generator where &belectricity&r is made."]
	quest.0B364EB72E807776.quest_subtitle: "Collects the rotor's current"
	quest.0B6F95779C8C2BFB.quest_desc: ["&aObtain&r a Lockbox from Aquaculture 2. This rare fishing loot container can be &bfound&r while fishing and contains valuable rewards. &bOpen&r the Lockbox to discover the items hidden inside."]
	quest.0B6F95779C8C2BFB.quest_subtitle: "A secured fishing treasure"
	quest.0B7ECB6991AD3592.quest_desc: [
		"&aThe&r Ironwood Ingot is a unique material created through the magic of the Twilight Forest. Unlike ordinary metal, it is forged by combining iron with the enchanted &bessence&r of the forest, producing a resource both durable and deeply &bconnected&r to nature."
		""
		"&aIronwood&r Ingots are used to craft a complete set of armor, powerful tools, and dependable weapons. They represent an important milestone in your progression, providing equipment capable of overcoming the increasingly &bdangerous&r &bcreatures&r that inhabit the Twilight Forest."
	]
	quest.0B7ECB6991AD3592.quest_subtitle: "Where iron and nature become one"
	quest.0B84FCFCF17BA68C.quest_desc: ["&6The&r Nugget of Experience is a compact form of experience from Create: Enchantment Industry. It can be obtained through Create's &bautomated&r processing and can be converted into Liquid Experience, making it useful for storing and &btransporting&r experience in your factory. It is also &bused&r in recipes requiring concentrated experience."]
	quest.0B84FCFCF17BA68C.quest_subtitle: "A little bit of knowledge"
	quest.0BCDA917265F1D7A.quest_desc: [
		"&6Give&r your locomotive the unmistakable look of a steam engine. The Locometal Smokebox provides a rugged metal front, perfect for &bcompleting&r the boiler and giving your locomotive that classic industrial appearance."
		""
		"Build your smokebox and put the &bfinishing&r touch on your steam locomotive."
	]
	quest.0BCDA917265F1D7A.quest_subtitle: "A sturdy front for a powerful locomotive."
	quest.0BD3D868C8C5154E.quest_desc: [
		"Craft a &aCandle Holder&r to place your candles safely and decorate your home."
		"&bUse&r it to display your candles on tables, shelves, or anywhere you like."
	]
	quest.0BD3D868C8C5154E.quest_subtitle: "Display your candles in style"
	quest.0BD3D868C8C5154E.title: "Candle Holders"
	quest.0BE8BF3B79E93EED.quest_subtitle: "More Armor"
	quest.0BF49A67983B4591.quest_desc: [
		"&aDiscover&r the Umbrella Jungle, a dense biome overgrown with moss and towering fungal trees whose canopies spread like &bumbrellas&r."
		""
		"Hanging vines, ferns, and drifting jellyshroom spores fill the air — explore carefully among its &bthick&r foliage."
	]
	quest.0BF49A67983B4591.quest_subtitle: "Dense fungal jungle"
	quest.0BF49A67983B4591.title: "Umbrella Jungle"
	quest.0BF7E8B23E6281C4.quest_desc: [
		"&l&9Stop&r&r switching between your pickaxe, axe and shovel every few seconds. The Tool Swapper Upgrade &bautomatically&r swaps the tool in your hand for the most effective one when mining a block or attacking an entity. Your backpack &bkeeps&r the tools ready, while the correct one is &bbrought&r to your hand when needed."
		""
		"The Advanced Tool Swapper Upgrade gives you more control with filters and additional swapping options. It can also swap weapons when attacking and provides a &bconfigurable&r keybind for &bmanually&r switching to the appropriate tool based on the block or entity you're looking at."
	]
	quest.0BF7E8B23E6281C4.quest_subtitle: "Always have the right tool in your hand"
	quest.0BF7E8B23E6281C4.title: "Tool Swapper \\& Advanced Tool Swapper Upgrade"
	quest.0BFBD48AD0980F1C.quest_desc: [
		"&l&9Even&r&r the toughest backpack can meet an unfortunate end. The Everlasting Upgrade protects your backpack from almost every &bdanger&r — explosions, fire, lava and cactus can no longer &bdestroy&r it. Even if you drop it, it will never despawn, and throwing it into the void won't make it disappear."
		""
		"&bWith&r this upgrade, your most valuable supplies will always have a way back to you."
	]
	quest.0BFBD48AD0980F1C.quest_subtitle: "Make sure your backpack never gets lost again"
	quest.0BFCBB8F6D953863.quest_subtitle: "More Armor"
	quest.0C01EB4E1F38BEE7.quest_desc: [
		"&aWithin&r the dangerous regions of Eternal Starlight, Thermal Springstone can be refined into powerful &bingots&r infused with geothermal energy."
		"These materials are tied to advanced crafting and represent another step toward mastering the dimension’s rare resources."
		""
		"Its &bunstable&r heat makes it both valuable and &bdifficult&r to obtain."
	]
	quest.0C01EB4E1F38BEE7.quest_subtitle: "Forged in heat"
	quest.0C01EB4E1F38BEE7.title: "&6Thermal Springstone Ingot"
	quest.0C048727BD25F26A.quest_desc: ["&dEnables&r &bterrain&r damage on your bullets, so your shots can break blocks."]
	quest.0C048727BD25F26A.quest_subtitle: "Break through walls"
	quest.0C10DD586167DBB5.quest_desc: ["&dThe&r Ring of Expediency grants &b+15%&r Cast Time Reduction, allowing you to cast spells faster and react more quickly in combat. &bEquip&r it as a ring and make your spellcasting more responsive."]
	quest.0C10DD586167DBB5.quest_subtitle: "Cast your spells faster"
	quest.0C1803C14525AE15.quest_subtitle: "More Armor"
	quest.0C21A51D100A1AA7.quest_desc: [
		"&9&lTake&r&r your Refined Storage system further with the Upgrade. Upgrades allow you to &benhance&r compatible devices, improving their &bperformance&r and making your digital storage network more efficient."
		""
		"&bUse&r upgrades to expand the capabilities of your machines and get even more out of your automated storage system."
	]
	quest.0C21A51D100A1AA7.quest_subtitle: "Improve the capabilities of your storage network"
	quest.0C36F991D0F7520F.quest_desc: ["&6A&r component whose resistance depends on &bvoltage&r, used to protect circuits."]
	quest.0C36F991D0F7520F.quest_subtitle: "A varistor"
	quest.0C4E4DC0B4CC6CEE.quest_desc: [
		"&aCraft&r the Enchanted Membrane through an Infusion Ritual, using a Phantom Membrane and four Crystal Shards around an &bInfusion Pedestal&r."
		""
		"It's the key ingredient needed to infuse a regular Elytra into the &bCrystalite Elytra&r."
	]
	quest.0C4E4DC0B4CC6CEE.quest_subtitle: "A membrane touched by magic"
	quest.0C4E4DC0B4CC6CEE.title: "&dEnchanted Membrane"
	quest.0C6618DA74D4F147.quest_desc: [
		"The &aCarpenter’s Table&r allows you to transform wooden blocks into many decorative variants."
		"Use it to create detailed wooden structures and improve the look of your builds."
	]
	quest.0C6618DA74D4F147.quest_subtitle: "Shape the wood"
	quest.0C712D4FF4294787.quest_desc: [
		"Building in difficult places can be challenging."
		"The Angel Template allows your Construction Stick to place blocks even when there is no block to attach them to."
		""
		"This upgrade is perfect for building bridges, platforms, and structures high in the air."
	]
	quest.0C712D4FF4294787.quest_subtitle: "Build in the Air"
	quest.0C724DE572A05B76.title: "Villager 67.. yeah"
	quest.0C78A1F2DD0596B1.quest_desc: ["&aObtain&r a Trident. This rare weapon can be dropped by Drowned mobs holding one. It can be used as both a &bmelee&r and ranged weapon by throwing it, and it can be &benchanted&r with &bunique&r trident enchantments."]
	quest.0C78A1F2DD0596B1.quest_subtitle: "A weapon from the ocean depths"
	quest.0C78A1F2DD0596B1.title: "&dTrident"
	quest.0CA6C89B260ED21F.quest_desc: [
		"&dElectromancer&r Boots are the Crystal Chronicles upgraded version of the Electromancer Boots from Iron’s Spells ’n Spellbooks."
		""
		"They are &bupgraded&r using a Voltite Shard, which enhances the original Electromancer Armor set with additional crystalline power. The Voltite Shard channels the power of Lightning magic, creating a stronger version of the &boriginal&r Electromancer equipment."
	]
	quest.0CA6C89B260ED21F.quest_subtitle: "An enhanced form of Electromancer Boots, empowered by Voltite"
	quest.0CC11B3703C971A2.quest_subtitle: "More Armor"
	quest.0CD9609E318F9042.quest_subtitle: "More Armor"
	quest.0CEAEC791D4CD1F1.quest_desc: ["&6Obtain&r a Pulse Extender from Create. It extends a Redstone pulse for a &bconfigurable&r amount of time, allowing short signals to remain active long enough to control machines and other automated systems. Its duration can be adjusted from &b2&r ticks up to &b60&r minutes, and it can also be inverted to remain powered by default and produce a temporary shutdown pulse."]
	quest.0CEAEC791D4CD1F1.quest_subtitle: "Keep the signal alive"
	quest.0CF3683B8C127405.quest_subtitle: "More Armor"
	quest.0CFA16A0F5807E23.quest_desc: [
		"&aObtain&r the Gauntlet of Guard, dropped by the Ender Guardian upon defeat."
		""
		"It functions as both a &aweapon&r and armor piece with entity-attracting abilities, and can be upgraded further into the Gauntlet of Bulwark."
	]
	quest.0CFA16A0F5807E23.quest_subtitle: "Trophy of the citadel's boss"
	quest.0CFA16A0F5807E23.title: "&dGauntlet Of Guard"
	quest.0D0199257A097C8D.quest_desc: [
		"&aThe&r Starfire Hammer is a late-game heavy weapon from Eternal Starlight, part of the Starfire &bequipment&r tier."
		""
		"&aIt&r is designed for high-damage melee attacks and belongs to the advanced weapon set &bintroduced&r in the mod."
	]
	quest.0D0199257A097C8D.quest_subtitle: "Starlight heavy weapon"
	quest.0D01CBDB09778B1C.quest_desc: [
		"&aHigh&r above the Twilight Forest, atop the &bimmense&r Dark Tower, awaits one of the dimension's most terrifying rulers—the Ur-Ghast. This colossal floating &bhorror&r has twisted the tower into its personal fortress, filling its halls with &bdeadly&r machines, traps, and loyal servants."
		""
		"&aUnlike&r any &benemy&r you've faced before, the Ur-Ghast rarely stays within reach. It circles high above the arena, bombarding intruders with explosive fireballs while unleashing &bdeafening&r cries that echo across the skies. Victory demands patience, strategy, and precise timing, as you'll &bneed&r to lure the beast into range before striking."
		""
		"&aDefeating&r the Ur-Ghast proves that you have &bmastered&r both the dangers of the Dark Tower and the challenges of the Twilight Forest. Its &bdefeat&r marks another major step toward conquering the enchanted realm."
	]
	quest.0D01CBDB09778B1C.quest_subtitle: "Silence the screams above the clouds"
	quest.0D01CBDB09778B1C.title: "&cUrGhast"
	quest.0D0498EE73C343D9.quest_desc: ["&6The&r Heat Engine is one of the engines added by Create Stuff 'N Additions. It uses fuel to &bgenerate&r Heat Energy, which can be used to power compatible equipment from the mod. It is the main power source for &bequipment&r that relies on heat energy, making it an important step toward more &badvanced&r gear."]
	quest.0D0498EE73C343D9.quest_subtitle: "Turn fuel into power"
	quest.0D1378C905A60B53.quest_desc: [
		"&aCraft&r a Steeleaf Axe using the magical Steeleaf material found throughout the Twilight Forest. Infused with the forest's ancient magic, this axe is both a reliable tool for harvesting wood and a capable &bweapon&r against hostile creatures."
		""
		"&aAs&r part of the Steeleaf equipment set, it provides a significant upgrade over ordinary tools and will aid you throughout your &bexploration&r of the Twilight Forest."
	]
	quest.0D1378C905A60B53.quest_subtitle: "The enchanted woodcutter"
	quest.0D1CF27B3864527D.quest_subtitle: "More Armor"
	quest.0D203235B9A36E3F.quest_desc: [
		"&9&lGive&r&r your Refined Storage network a place to &bkeep&r its digital storage disks. The Disk Drive holds storage disks and makes their contents &bavailable&r to the rest of your network."
		""
		"Connect it to your system and start building a &bcentralized&r digital storage network capable of holding vast amounts of resources."
	]
	quest.0D203235B9A36E3F.quest_subtitle: "Store your digital resources on storage disks"
	quest.0D30AC3FA07898B9.quest_desc: [
		"&dCryomancer&r Coat is the chestpiece of the Cryomancer Armor set in Iron's Spells 'n Spellbooks. When worn, it provides &b+8&r Armor, &b+125&r Max Mana, &b+10%&r Ice Spell Power and &b+5%&r Spell Power. It can also be imbued with 1 spell."
		""
		"&bUpgrade&r Wizard Robes using 1 Ice Rune and 1 Arcane Essence to obtain Cryomancer Coat."
	]
	quest.0D30AC3FA07898B9.quest_subtitle: "Channel the freezing power of Ice magic"
	quest.0D566870D0BB04ED.quest_desc: [
		"&l&9Let&r&r your backpack take care of your hunger. The Feeding Upgrade automatically feeds you using food stored inside the backpack whenever you become hungry. You can configure filters to &bdecide&r which foods are allowed or blocked."
		""
		"The Advanced Feeding Upgrade gives you finer control over when you eat. It can prioritize food more efficiently to avoid wasting &bhunger&r points and offers additional conditions, including &bfeeding&r when you take damage."
	]
	quest.0D566870D0BB04ED.quest_subtitle: "Never worry about hunger again"
	quest.0D566870D0BB04ED.title: "Feeding \\& Advanced Feeding Upgrade"
	quest.0D5FCCF588C6D9C1.quest_subtitle: "More Armor"
	quest.0D64A726F990C937.quest_desc: [
		"&aCraft&r an Iron Fillet Knife and take your fishing &bequipment&r to the next level. Forged from sturdy iron, this reliable tool offers exceptional durability and precision, making it perfect for processing even the finest &bcatches&r from rivers, lakes, and the open sea."
		""
		"&aAs&r your adventures lead you toward rarer fish and &blegendary&r treasures, dependable equipment becomes essential. The Iron Fillet Knife ensures that every catch is processed efficiently, helping you &bmake&r the most of your time on the water."
	]
	quest.0D64A726F990C937.quest_subtitle: "Crafted for the seasoned angler"
	quest.0D89506DC26400A0.quest_desc: ["&6The&r Portable Drill is a fuel-powered multi-tool from Create Stuff 'N Additions. It has Diamond-tier &bmining&r level and mines faster than an Iron Pickaxe, while also functioning as an Axe and Shovel. Unlike normal tools, it has no durability and instead requires fuel and water to operate. With the &bappropriate&r enchantment, it can mine certain stone blocks in a &b3×3&r area."]
	quest.0D89506DC26400A0.quest_subtitle: "A drill you can take anywhere"
	quest.0DAB4700648EB3ED.quest_desc: ["&6Add&r the Redstone Detector Tube Attachment to your Hypertube system and expand its redstone capabilities. &bUse&r it to detect activity within the tube network and connect your &btransportation&r system to automated redstone mechanisms."]
	quest.0DAB4700648EB3ED.quest_subtitle: "Detect what passes through"
	quest.0DB8E810F8D979F6.quest_desc: [
		"&6Welcome&r to Create: Power Grid, an addon that brings real &belectricity&r to Create. Wire up devices, generate power from rotation or sunlight, and learn how &bvoltage&r, current and resistance work together."
		""
		"&6Follow&r the quests outward from here to learn wiring, generators, solar &bpower&r, electronics and portable tools."
	]
	quest.0DB8E810F8D979F6.quest_subtitle: "Power your world with electricity"
	quest.0DB8E810F8D979F6.title: "&l&6Welcome Create Power Grid"
	quest.0DCAEC79BEDE8BE6.quest_desc: [
		"The Aeternium Boots are crafted by upgrading Terminite Boots with an &aAeternium&r Forged Plate at a Smithing Table."
		""
		"They round out the full set of &bAeternium&r armor, Better End's strongest protective gear."
	]
	quest.0DCAEC79BEDE8BE6.quest_subtitle: "Boots of the strongest tier"
	quest.0DD0CBBAE885F488.quest_desc: ["&aCraft&r a Neptunium Axe from Aquaculture 2. This &bpowerful&r tool is made from Neptunium, a rare material obtained from fishing treasures. It offers high durability and efficiency, making it a &bvaluable&r addition to your &bcollection&r of advanced tools."]
	quest.0DD0CBBAE885F488.quest_subtitle: "A powerful tool from ocean treasures"
	quest.0DEB3110F27083E6.quest_desc: [
		"&eThe&r desert stretches endlessly ahead. Keep running, watch your &bsurroundings&r and avoid every cactus standing in your way."
		""
		"How far can you make it?"
	]
	quest.0DEB3110F27083E6.quest_subtitle: "Cross the desert without getting caught."
	quest.0E147AC3400C4889.quest_desc: [
		"Welcome to your &2new&r &aworld&r! "
		"This is your first &bstep&r in the adventure – explore your surroundings, gather basic resources, and prepare for the challenges ahead. Every journey begins with a single &bstep&r, and your &aworld&r is ready to be discovered!"
	]
	quest.0E147AC3400C4889.quest_subtitle: "First Steps into Adventure"
	quest.0E147AC3400C4889.title: "&l&2New &aWorld"
	quest.0E42F9CE105A4450.quest_desc: ["&eIt's&r time to unleash pure chaos! The Flamethrower allows you to set fire to anything in front of you. To &buse&r it, you must load it with Blaze Powder, which &bprovides&r up to 60 seconds of operation. &bStock&r up on fuel and show your enemies the power of mechanical fire!"]
	quest.0E42F9CE105A4450.quest_subtitle: "Let the Battlefield Burn!"
	quest.0E571930C417347F.quest_subtitle: "More Weapon"
	quest.0E5E4DC1A6A19DBF.quest_subtitle: "Yummy!"
	quest.0E69A4626C5865CC.quest_desc: ["&6The&r Copper Helmet is part of the Copper Suit added by Create Stuff 'N Additions. It provides the same armor value as an Iron Helmet, while offering &b1&r point of armor toughness and higher &bdurability&r than iron armor. The full Copper Suit can be repaired with Honeycombs in an Anvil, making copper a practical alternative to &bearly-game&r iron armor."]
	quest.0E69A4626C5865CC.quest_subtitle: "Simple protection, built with Create"
	quest.0E6F6D09770E2D70.title: "Hell Nah"
	quest.0E7ECBAB667CFD86.quest_desc: ["&6Provides&r &bheat&r to items processed in a Basin. Given enough &bpower&r, it reaches the highest heat level."]
	quest.0E7ECBAB667CFD86.quest_subtitle: "Heat for your basin"
	quest.0E7F4A989DB6342D.quest_desc: ["&eA&r Game Disc that lets you play Pong using the Game Console. Control your paddle and move it up and down to keep the ball from getting past you. Test your &breflexes&r and try to outlast your &bopponent&r by returning every shot."]
	quest.0E7F4A989DB6342D.quest_subtitle: "Keep the ball in play and beat your opponent!"
	quest.0E855DABB1FCD46B.quest_desc: [
		"Craft a &aLightroom&r to &bedit&r your Developed Film Rolls."
		"With it, you can adjust brightness, contrast, and colors before projecting your images."
	]
	quest.0E855DABB1FCD46B.quest_subtitle: "Edit your photos"
	quest.0E87AC6E1318D654.quest_subtitle: "More Armor"
	quest.0E8BB3913CB90410.quest_desc: ["&aObtain&r the Cursium Upgrade Smithing Template from the Cataclysm mod. This smithing template is &bused&r in a Smithing Table to upgrade Netherite &bequipment&r into Cursium equipment using Cursium Ingots"]
	quest.0E8BB3913CB90410.quest_subtitle: "Upgrade the power of Cursium"
	quest.0E92544484BC20B8.quest_desc: ["&dPoltergeist&r is a massive, heavy axe filled with Eyes of Ender. It is designed for massive burst damage. Its base materials mainly consist of Eyes of Ender and can be &bobtained&r through crafting."]
	quest.0E92544484BC20B8.quest_subtitle: "Spectral Power"
	quest.0E92544484BC20B8.title: "&l&aPoltergeist"
	quest.0EB8304741CB03C7.quest_subtitle: "More Armor"
	quest.0EC0971CBAF5ACAA.quest_desc: [
		"&aDeep&r within Eternal Starlight, a twisted &bstructure&r known as the Cursed Garden hides the Lunar Monstrosity."
		"&aThis&r maze-like area is overgrown with strange &bvegetation&r and filled with danger."
		""
		"To locate it, use the Seeking Eye while holding a natural item connected to the dimension in your off-hand."
		"&bOnly&r then will the Eye guide you to the &bcorrect&r location."
	]
	quest.0EC0971CBAF5ACAA.quest_subtitle: "Where the beast awaits"
	quest.0EC0971CBAF5ACAA.title: "Cursed Garden"
	quest.0ED1749C1B5B7583.quest_subtitle: "More Armor"
	quest.0EEE68FD056D8EA2.quest_desc: [
		"&dNature&r Rune is a crafting ingredient in Iron's Spells 'n Spellbooks, used for advanced &bNature-related&r crafting, including Nature Upgrade Orbs. The Nature school &buses&r Poisonous Potato as its magical Focus."
		""
		"&bCreate&r a Nature Rune by combining a Blank Runestone with 8 Poisonous Potatoes."
	]
	quest.0EEE68FD056D8EA2.quest_subtitle: "Infuse a runestone with the wild power of Nature magic"
	quest.0EF28169B581CC6E.quest_desc: ["&dVoid's&r Grasp is a weapon from Crystal Chronicles, &bassociated&r with the enhanced Voidwalker equipment. It channels the &bpower&r of the Abyss and its dark crystalline energy, making it a formidable &bweapon&r for wielders of void and shadow magic."]
	quest.0EF28169B581CC6E.quest_subtitle: "A dark weapon that harnesses the crushing power of the Abyss"
	quest.0EFC932492253DA8.quest_subtitle: "More Armor"
	quest.0F0122BB93E8B07B.quest_desc: ["&aDefeat&r 10 The Watchers from L_Ender’s Cataclysm. Hunt down these &bmysterious&r creatures and eliminate them one by one. Prove that you are strong &benough&r to face the dangers lurking within Cataclysm."]
	quest.0F0122BB93E8B07B.quest_subtitle: "Hunt the mysterious watchers"
	quest.0F0122BB93E8B07B.title: " The Watcher"
	quest.0F07C5A8E6D0432A.quest_desc: [
		"&l&9Your&r&r backpack is great for carrying loot, but eventually you'll &bneed&r to unload it. The Deposit Upgrade automatically transfers filtered items from your backpack into a nearby inventory, such as a chest or barrel, when you interact with it. It &bprovides&r 9 filter slots."
		""
		"The Advanced Deposit &bUpgrade&r expands this system with 16 filter slots and more precise filtering by item, mod, tag, NBT data and damage values. It can also be configured to deposit only items that &balready&r exist in the target inventory."
	]
	quest.0F07C5A8E6D0432A.quest_subtitle: "Empty your backpack with a single interaction"
	quest.0F07C5A8E6D0432A.title: "Deposit \\& Advanced Deposit Upgrade"
	quest.0F18BA8D8EBDDCB1.quest_desc: [
		"A pedestal is &bused&r to display items and decorations in your world."
		"Place your favorite item on a pedestal to show it off to everyone."
	]
	quest.0F18BA8D8EBDDCB1.quest_subtitle: "Display Your Treasures"
	quest.0F2A2810EA1946B1.quest_desc: ["&aObtain&r Burning Ashes from the Cataclysm mod. This ancient relic is &brequired&r to awaken Ignis within the Burning Arena. Without these smoldering ashes, the Lord of Fire will &bremain&r dormant upon his throne."]
	quest.0F2A2810EA1946B1.quest_subtitle: "The ember that awakens the Lord of Fire"
	quest.0F64E81EA2372255.quest_desc: [
		"&dPlagued&r Leggings are part of the Plagued Armor set in Iron's Spells 'n Spellbooks. When worn, they provide &b+6&r Armor, &b+125&r Max Mana, &b+10%&r Nature Spell Power and &b+5%&r Spell Power."
		""
		"They are &bcrafted&r by upgrading Wizard Leggings with 1 Nature Rune and 1 Arcane Essence."
	]
	quest.0F64E81EA2372255.quest_subtitle: "Channel the wild and poisonous power of Nature magic"
	quest.0F711B661EAE6F4F.quest_subtitle: "Yummy!"
	quest.0F73032F23C2CC85.quest_subtitle: "Yummy!"
	quest.0F7D9F42F177D44F.quest_desc: ["&6The&r Conduit is the core of Create: Aquatic Ambitions' aquatic automation system. When activated, it acts as a &bcatalyst&r for Conduit Channeling, allowing Create's fans to process materials through special aquatic recipes. It can transform byproducts into useful resources and is the &bkey&r to automating materials such as Prismarine, Coral and Copper."]
	quest.0F7D9F42F177D44F.quest_subtitle: "Harness the power of the ocean"
	quest.0F8686CA54D25658.quest_desc: [
		"&dScarecrow&r Boots are part of the Scarecrow Armor set in Iron's Spells 'n Spellbooks. &bThey&r provide &b+3&r Armor and &b+75&r Max Mana."
		""
		"Craft them &bfrom&r Hay Bales and complete your Scarecrow Armor set."
	]
	quest.0F8686CA54D25658.quest_subtitle: "Walk with the strange magic of the scarecrow"
	quest.0F889054E352287C.quest_desc: [
		"&dWizard&r Boots are &bpart&r of the basic Wizard Armor set in Iron's Spells 'n Spellbooks. When equipped, they provide &b+3&r Armor, &b+125&r Max Mana and &b+5%&r Spell Power."
		""
		"Complete the Wizard set and strengthen your magical abilities with &badditional&r mana and spell power."
	]
	quest.0F889054E352287C.quest_subtitle: "Walk the path of the arcane"
	quest.0FA493E56395172B.quest_subtitle: "Yummy!"
	quest.0FB04687C0F5D8B1.quest_desc: ["&aObtain&r Essence of the Storm from L_Ender’s Cataclysm. This &brare&r material is dropped by Scylla, with each defeat yielding 3–4 Essences of the Storm. It is used to &bcraft&r powerful Acropolis weapons, including &bAstrape&r and Ceraunus."]
	quest.0FB04687C0F5D8B1.quest_subtitle: "A fragment of the Storm Empress's power"
	quest.0FE1F9E9F024ECCD.quest_subtitle: "More Armor"
	quest.0FE76D3D0161BDBB.quest_subtitle: "More Armor"
	quest.0FF0C8FC476D8039.quest_desc: ["&aDefeat&r 10 Drowned. These underwater &bundead&r mobs spawn in oceans and rivers. They can drop useful items such as Rotten Flesh, Copper Ingots, Nautilus Shells, and &bTridents&r if they are holding one."]
	quest.0FF0C8FC476D8039.quest_subtitle: "Defeat the undead of the ocean"
	quest.0FF0C8FC476D8039.title: "Kill Drowned"
	quest.0FF66DA3887636F5.quest_desc: ["&6Craft&r the Inventory Bridge and Inventory Access Port to improve item &blogistics&r in your factory. The Inventory Access Port expands the &baccessible&r sides of an inventory, while the Inventory Bridge connects two inventories so they can be accessed simultaneously. Both are &bpart&r of Create: Connected."]
	quest.0FF66DA3887636F5.quest_subtitle: "Reach your inventories from anywhere"
	quest.0FF66DA3887636F5.title: "Inventory Bridge \\& Inventory Access Port"
	quest.1003FBB884B33A10.quest_subtitle: "Yummy!"
	quest.1009DDB3C044CEC1.quest_desc: [
		"&6No&r steam locomotive is complete without a proper boiler. The Locometal Boiler combines the rugged appearance of Locometal with the &bunmistakable&r shape of a classic steam locomotive boiler."
		""
		"Build it into your locomotive and &bgive&r your train the industrial heart it deserves."
	]
	quest.1009DDB3C044CEC1.quest_subtitle: "The heart of a steam locomotive."
	quest.101BDDA3CD5CF3FE.quest_desc: ["&dA&r common crafting material &bused&r in many recipes for tools, weapons and other &bequipment&r in Hazen N Stuff."]
	quest.101BDDA3CD5CF3FE.quest_subtitle: "A reliable material for crafting and equipment"
	quest.10399D121FFAF706.quest_desc: ["&aObtain&r the Fake Wadjet's Staff from the Cataclysm mod. This mysterious artifact resembles the weapon of Wadjet, the serpent guardian of the desert. Though not the &btrue&r staff, it still carries the &bremnants&r of ancient desert power."]
	quest.10399D121FFAF706.quest_subtitle: "A false relic of the desert serpent"
	quest.10399D121FFAF706.title: "&eFake Wadjet's Staff"
	quest.105089B860220491.quest_desc: ["&dHermomancer&r Chestplate is the chestpiece of the Hermomancer Armor set from Crystal Chronicles, an &baddon&r for Iron’s Spells ’n Spellbooks."]
	quest.105089B860220491.quest_subtitle: "Harness the power of the Hermomancer"
	quest.1075D7EB9D53E900.quest_subtitle: "Yummy!"
	quest.1076777CFF885694.quest_desc: ["&6Craft&r the 6-Way Gearbox and Vertical 6-Way Gearbox to create versatile kinetic connections in your factory. These gearboxes &bprovide&r multiple shaft connections, making it easier to distribute &brotational&r power through compact and complex &bmechanical&r setups. The Vertical 6-Way Gearbox has six shaft-facing sides, with the top and bottom rotating at half speed."]
	quest.1076777CFF885694.quest_subtitle: "Connect rotation from every side"
	quest.1076777CFF885694.title: "6-Way Gearboxes"
	quest.107FA2DB980BC9A8.quest_desc: [
		"&aAfter&r locating the &bhidden&r structure in Eternal Starlight, you must face its guardian — the Starlight Golem."
		"This powerful construct protects its domain with great strength and durability."
		""
		"&aDefeating&r it proves that you are ready to handle &aelite&r threats within the dimension."
	]
	quest.107FA2DB980BC9A8.quest_subtitle: "Break the construct"
	quest.107FA2DB980BC9A8.title: "&l&bStarlight &fGolem"
	quest.1086E751618DA8C1.quest_desc: ["&aObtain 5&r Prismarine Crystals. These items are &bdropped&r by Guardians and Elder Guardians and are &bused&r to craft Sea Lanterns and other decorative blocks."]
	quest.1086E751618DA8C1.quest_subtitle: "A treasure from ocean monuments"
	quest.1086E751618DA8C1.title: "Prismarine Crystals"
	quest.1087CF0DF2FE716F.quest_desc: ["&6Give&r your railway builds a distinct industrial finish with Flat Slashed Locometal. &bIts&r flat shape and slashed metal pattern &bmake&r it perfect for locomotive bodies, train cars and detailed railway structures."]
	quest.1087CF0DF2FE716F.quest_subtitle: "A clean, industrial surface with a rugged edge."
	quest.1089F103361EC854.quest_desc: ["Forge a full set of &airon armo&rr to protect yourself from the dangers ahead. Equip helmet, chestplate, leggings, and boots to survive tougher enemies and &bexplore&r confidently."]
	quest.1089F103361EC854.quest_subtitle: "Gear Up for Battle"
	quest.1089F103361EC854.title: "Iron Armor"
	quest.108C534782668B81.quest_desc: ["&aDefeat&r Wadjet from the Cataclysm mod. This powerful serpent-like mini-boss dwells within the Cursed Pyramid, guarding its ancient treasures with &bdevastating&r sand magic. Defeating Wadjet rewards you with &bAncient&r Metal Ingots, an essential material for crafting ancient equipment."]
	quest.108C534782668B81.quest_subtitle: "Slay the serpent guardian of the desert"
	quest.108C534782668B81.title: "&6Wad&ejet"
	quest.108CBE345FE0233C.quest_desc: ["&6The&r Hydraulic Engine is an engine from Create Stuff 'N Additions that uses water as its energy source. It is part of the mod's hydraulic technology and is &bused&r to power advanced Copper equipment, including &bhydraulic-powered&r gear. The engine is &bcrafted&r through Create's &bmechanical&r assembly process, using a Copper Sheet, Cogwheels, Large Cogwheels, Andesite Alloy and Water."]
	quest.108CBE345FE0233C.quest_subtitle: "Harness the power of water"
	quest.10D4A4A58AAAA36A.quest_desc: ["&6Converts&r redstone signals into &bresistance&r changes (like a potentiometer). Attached to a block it acts like a Redstone Comparator, and for some blocks it gives more precision."]
	quest.10D4A4A58AAAA36A.quest_subtitle: "Redstone into resistance"
	quest.10DB2DCC3B25FCCC.quest_desc: ["&aTravel&r to the Underworld Arena, a dangerous boss instance located in the &bdepths&r of the Bosses’Rise dimension. &aThis&r arena serves as a locked combat zone where powerful underworld bosses await &bchallengers&r."]
	quest.10DB2DCC3B25FCCC.quest_subtitle: "Boss arena access"
	quest.10DB2DCC3B25FCCC.title: "&3Underworld &fArena"
	quest.10DDBC906AAD23D7.quest_desc: [
		"&aDiscover&r the Umbra Valley, a dim and hazy biome built from &bUmbralith&r stone, tucked among the outer islands of the End."
		""
		"Its muted, shadowy terrain sets it apart from the brighter biomes of Better End — worth exploring for its &bunique&r resources."
	]
	quest.10DDBC906AAD23D7.quest_subtitle: "Valley cloaked in shadow"
	quest.10DDBC906AAD23D7.title: "Umbra Valley"
	quest.10E5A66E748CD6A2.quest_subtitle: "More Weapon"
	quest.10F061C6C982A43A.quest_desc: ["&aObtain&r the Necklace of the Desert from the Cataclysm mod. This &bancient&r artifact is found within the Cursed Pyramid and is required to awaken the Ancient Remnant, the powerful guardian &bhidden&r deep beneath the desert sands. Carry this relic and prepare for a battle &bagainst&r an &bancient&r force."]
	quest.10F061C6C982A43A.quest_subtitle: "The key to awakening an ancient power"
	quest.10F061C6C982A43A.title: "&dNecklace Of The Desert"
	quest.10F509A7074A38C3.quest_desc: ["&aDefeat&r a Snow Golem. Although normally a friendly creature, Snow Golems can be built by &bplacing&r a Carved Pumpkin on top of two Snow Blocks. They leave a &btrail&r of snow and throw snowballs at hostile mobs."]
	quest.10F509A7074A38C3.quest_subtitle: "A difficult decision in the snow"
	quest.10F509A7074A38C3.title: "Kill SnowGolem :("
	quest.10FBE8E0885F168D.quest_desc: [
		"Build a&a Nether Portal&r and enter the Nether."
		"This dangerous dimension is full of valuable resources, but also deadly &bcreatures&r."
	]
	quest.10FBE8E0885F168D.quest_subtitle: "Enter the dangerous dimension"
	quest.10FBE8E0885F168D.title: "&5Into the Nether"
	quest.11261ECC91B8E046.quest_subtitle: "Yummy!"
	quest.1129D9E0F8CEA9FC.quest_desc: [
		"&dArcane&r Cloth is an important crafting material in Iron's Spells 'n Spellbooks. It is &bcreated&r by condensing Arcane Essence and is used to craft &bpowerful&r magical equipment, including spellcaster armor."
		""
		"Arcane Cloth is especially important during &bmid-game&r progression, when you begin crafting stronger armor and &bexpanding&r your magical arsenal."
	]
	quest.1129D9E0F8CEA9FC.quest_subtitle: "Weave raw magical essence into enchanted fabric"
	quest.113B9F1863072735.quest_desc: [
		"&aUpgrade&r your fishing &bequipment&r by crafting a Stone Fillet Knife. Stronger and more durable than its wooden counterpart, this improved tool makes preparing your catches far more efficient, allowing you to extract &bvaluable&r resources with greater ease."
		""
		"&aEvery&r skilled angler &bknows&r that quality tools make all the difference. The Stone Fillet Knife is the next step toward mastering the art of fishing and making the most of the treasures hidden &bbeneath&r the water's surface."
	]
	quest.113B9F1863072735.quest_subtitle: "A sharper edge for cleaner cuts"
	quest.114820C8ED37783F.quest_desc: [
		"&9&lTake&r&r your Sophisticated Storage &bcontainer&r from the Iron Tier to the Gold Tier. This upgrade expands the capabilities of your storage and brings you closer to the highest &blevels&r of storage available."
		""
		"Strengthen your storage system and &bprepare&r it for even greater capacity and more powerful upgrades."
	]
	quest.114820C8ED37783F.quest_subtitle: "Give your storage a golden upgrade"
	quest.11A869A54AF60695.quest_desc: ["&6The&r Blaze Upgrade Smithing Template is used to upgrade a Blaze Burner into advanced &bBlaze-powered&r machines such as the Blaze Enchanter and Blaze Forger. It is associated with Create: Enchantment Industry and is found as loot in Nether &bFortresses&r and Bastion Remnants."]
	quest.11A869A54AF60695.quest_subtitle: "Upgrade the Blaze Burner"
	quest.11B8CE94B9C038C0.quest_desc: ["&dThe&r Amulet of Concentration makes &blong-cast&r spells uninterruptible. Equip it around your neck and maintain your &bspellcasting&r even when taking damage or facing other interruptions during a long cast."]
	quest.11B8CE94B9C038C0.quest_subtitle: "Cast powerful spells without losing your focus"
	quest.11D19C10264300EC.quest_desc: ["&6The&r Block of Experience is a compact form of Liquid Experience from Create: Enchantment Industry. It can be &bused&r as a concentrated source of experience in advanced enchanting processes and is also involved in the mod's Super &bEnchanting&r progression. In newer versions, &blightning&r can transform Experience Blocks as part of this progression."]
	quest.11D19C10264300EC.quest_subtitle: "Condense your knowledge"
	quest.11D562DD0F0F4BFB.quest_desc: ["&6Obtain&r a Mechanical Arm from Create. It is an advanced &bitem-transport&r component that can pick up and deposit items between inventories, belts, funnels, basins, and other compatible blocks within its working range. &bIts&r behavior can be configured with Round Robin, Forced Round Robin, or Prefer First modes, making it ideal for &bautomated&r sorting and production lines."]
	quest.11D562DD0F0F4BFB.quest_subtitle: "Automate the hands of your factory"
	quest.11E1446BE612A8A0.quest_desc: [
		"&9&lEvery&r&r Refined Storage network &bneeds&r a reliable source of power and control. The Controller is the central component of your storage network, providing the energy required to keep connected devices running."
		""
		"Connect your storage &bcomponents&r to the Controller and build the foundation of a powerful digital storage system."
	]
	quest.11E1446BE612A8A0.quest_subtitle: "The heart of your digital storage network"
	quest.11E4AC4D88C9D606.quest_subtitle: "Yummy!"
	quest.11F11DE2C2DFCD62.quest_desc: ["Obtain a Wrench from &aSupplementaries&r. This tool is essential for rotating and configuring machines or blocks from many tech &bmods&r."]
	quest.11F11DE2C2DFCD62.quest_subtitle: "Tools for Machines"
	quest.11F11DE2C2DFCD62.title: "Get Your Wrench"
	quest.12113DC3AD237125.quest_desc: ["&6Create&r the three basic metal rods used throughout Create Crafts \\& Additions: Copper Rod, Iron Rod and Gold Rod. These &brods&r are produced using the Rolling Mill and serve as important crafting &bcomponents&r for the mod's electrical parts, including wires, spools and connectors. One metal ingot produces &b2&r rods."]
	quest.12113DC3AD237125.quest_subtitle: "Shape the metal for electrical engineering"
	quest.122606911457B4EC.quest_desc: [
		"fawfafeaf"
		"{image:relics:textures/abilities/blazing_flask/bonfire.png width:100 height:100 align:center} aff aa f"
		"{@pagebreak}"
		"(new page placeholder text)"
	]
	quest.122606911457B4EC.quest_subtitle: "czesc"
	quest.122606911457B4EC.title: "czesc"
	quest.122964ACEB2F091B.quest_desc: [
		"&aThe&r Flowglaze Hoe is a farming tool from Eternal Starlight, belonging to the Flowglaze &bequipment&r tier."
		""
		"&aIt&r is &bused&r for farmland creation and is part of the mid-to-late game Flowglaze progression system."
	]
	quest.122964ACEB2F091B.quest_subtitle: "Flow farming tool"
	quest.1269F25E5558BE74.quest_desc: [
		"&eA&r good fisherman knows that patience is important. A great fisherman knows how to &bimprove&r his odds."
		""
		"The Angler's Hat &bincreases&r both Lure and Luck of the Sea by 1 level, making every cast a little more rewarding."
	]
	quest.1269F25E5558BE74.quest_subtitle: "Cast your line and let luck do the rest"
	quest.128E639A82FB1678.quest_desc: ["&6Craft&r a Dark Chocolate Glazed Marshmallow and combine a soft, fluffy marshmallow with a rich dark chocolate coating. It makes a &bperfect&r sweet treat for your Create: Confectionery collection. Chocolate-covered marshmallows are a classic &bconfection&r combining a soft marshmallow center with a chocolate shell."]
	quest.128E639A82FB1678.quest_subtitle: "A fluffy treat covered in rich dark chocolate"
	quest.12A5A3C5BB7BC3C8.quest_desc: [
		"The Aeternium Hoe is a top-tier &afarming&r tool forged from Aeternium, the strongest material added by Better End."
		""
		"It caps off the mod's tool progression alongside the rest of the &bAeternium&r set."
	]
	quest.12A5A3C5BB7BC3C8.quest_subtitle: "Farming tool of the strongest tier"
	quest.12A793014D8A05DE.quest_desc: [
		"&aDefeat&r the Ender Golem, a slow but powerful mini-boss found throughout the Ruined Citadel's upper levels, wielding melee and shockwave attacks."
		""
		"Each kill drops a &bVoid Core&r, used to summon damaging Void Runes and craft several of Cataclysm's void-themed items."
	]
	quest.12A793014D8A05DE.quest_subtitle: "Guardian of the citadel's upper floors"
	quest.12A793014D8A05DE.title: "&l&6Ender &dGolem"
	quest.12A9BF6B0380CF5B.quest_subtitle: "More Armor"
	quest.12AA6CA74CECB87F.quest_desc: [
		"The Terminite Sword is assembled from a Terminite tool head and sword handle at a Smithing Table, improving on the Thallasium blade."
		""
		"It's a stepping stone toward Better End's &astronger&r Aeternium sword."
	]
	quest.12AA6CA74CECB87F.quest_subtitle: "Blade of the second tier"
	quest.12CC277C4F032C68.title: "&l&aInfernal Dragon"
	quest.12CD30FECE9A575D.quest_desc: ["&aCraft&r Neptunium Leggings from Aquaculture 2. These powerful leggings are made from Neptunium, a rare &bmaterial&r obtained from fishing treasures. They provide strong &bprotection&r and are &bpart&r of the Neptunium armor set."]
	quest.12CD30FECE9A575D.quest_subtitle: "Armor forged from ocean treasures"
	quest.12E32506A5E233E5.quest_desc: [
		"&dElectromancer&r Chestplate is the Crystal Chronicles upgraded version of the Electromancer Robe from Iron’s Spells ’n Spellbooks."
		""
		"It is &bupgraded&r using a Voltite Shard, which enhances the original Electromancer Armor set with additional crystalline power. The Voltite Shard &bchannels&r the power of Lightning magic, creating a stronger version of the original Electromancer equipment."
	]
	quest.12E32506A5E233E5.quest_subtitle: "An enhanced form of Electromancer Robe, empowered by Voltite"
	quest.1302520A3595C738.quest_subtitle: "Upgrade+"
	quest.132151F1833DF82A.quest_desc: ["&6Obtain&r a Brass Hand from Create. It is an advanced crafting &bcomponent&r made from Andesite Alloy and Brass Sheets. The Brass Hand is used to craft important components such as the Deployer and Extendo Grip, making it an essential step toward &badvanced&r Create machinery."]
	quest.132151F1833DF82A.quest_subtitle: "Reach for advanced machinery"
	quest.13435A8982162B8F.quest_subtitle: "Upgrade+"
	quest.1343988144113072.quest_desc: [
		"&9&lTurn&r&r your Refined Storage network into an automated building system with the Constructor. It takes items from your network and places them &binto&r the world as blocks, allowing you to &bautomate&r construction and block placement."
		""
		"Connect it to your network, &bconfigure&r the desired blocks and let your digital storage system handle the building for you."
	]
	quest.1343988144113072.quest_subtitle: "Build blocks automatically from your storage network"
	quest.135B8AF8E5D61A92.quest_desc: [
		"&6A&r regular crossbow is useful on the ground, but the skies demand something heavier. The Heavy Crossbow &blaunches&r arrows with tremendous force, giving your aircraft a reliable weapon for dealing with threats from above."
		""
		"&bMount&r it to your aircraft, load it with arrows and take aim from the skies."
	]
	quest.135B8AF8E5D61A92.quest_subtitle: "A powerful crossbow built for aerial combat."
	quest.1372FFDD8D0EB4EB.quest_desc: [
		"&eThe&r Cowboy Hat grants a Speed II effect while worn, making your ridden mounts &bsignificantly&r faster. Whether you're crossing vast plains or &bescaping&r danger, every journey becomes a little quicker."
		""
		"&bMount&r up and hit the road."
	]
	quest.1372FFDD8D0EB4EB.quest_subtitle: "Ride faster. Ride farther"
	quest.13734D174BC106DD.quest_desc: ["&dThe&r Emerald Stoneplate Ring rewards you for defeating creatures by increasing the experience they drop by 25%. Equip it as a ring and &baccelerate&r your progression, enchanting and &bleveling&r by making every successful fight more rewarding."]
	quest.13734D174BC106DD.quest_subtitle: "Turn every victory into greater experience"
	quest.1382CCEE707BE5D5.quest_desc: [
		"&aThe Mace&r is a powerful weapon capable of dealing massive damage, especially when used with a falling attack."
		""
		"By striking enemies from above, you can unleash devastating blows that few creatures can survive. This weapon rewards &bskillful combat&r and &btiming&r."
		""
		"Craft your Mace and learn to use its crushing power in battle."
	]
	quest.1382CCEE707BE5D5.quest_subtitle: "Crushing Power"
	quest.1382CCEE707BE5D5.title: "The Mace"
	quest.1394098F76A762A2.quest_desc: ["&aDefeat&r the Haunter, one of the enemies encountered while &bexploring&r the Ancient Keep. Survive the &bencounter&r with this ghostly foe and continue &bfollowing&r the remnants of the Ancients. The Haunter was &badded&r to Archaion in update 1.3.0."]
	quest.1394098F76A762A2.quest_subtitle: "Specter of the Ancient Keep"
	quest.1394098F76A762A2.title: "Kill Haunter"
	quest.139E8751E5B11841.quest_desc: ["&6Obtain&r Cardboard Boots from Create. They are part of the Cardboard Armor set and provide &b1&r armor point with &b52&r durability. When the full set is worn and you sneak, you transform into a Cardboard Package, greatly reducing the distance at which &bhostile&r mobs can detect you."]
	quest.139E8751E5B11841.quest_subtitle: "Complete the cardboard disguise"
	quest.13A3AFA58B4A4C2D.quest_desc: [
		"&eSmall&r piston. Massive force."
		""
		"The Pocket Piston increases the knockback &bdealt&r by your attacks, sending enemies flying much farther than normal. It's perfect for keeping dangerous mobs at a distance — or simply &blaunching&r them off a cliff."
		""
		"Hit hard. Push harder."
	]
	quest.13A3AFA58B4A4C2D.quest_subtitle: "Send your enemies flying"
	quest.13AB6543B815AA7F.quest_desc: [
		"&aMagma&r &aCream&r is a brewing ingredient &acrafted&r from Blaze Powder and Slimeballs."
		"It is commonly used to create Potions of Fire Resistance, making it extremely &bvaluable&r for Nether &bexploration.&r"
		"Its unstable, molten nature makes it one of the key materials in fire-related alche&bmy.&r"
	]
	quest.13AB6543B815AA7F.quest_subtitle: "Fireproof alchemy ingredient"
	quest.13AB6543B815AA7F.title: "Magma Cream"
	quest.13AFC17AEAB3540C.quest_desc: ["&6A&r spark gap, a device for electrical discharges."]
	quest.13AFC17AEAB3540C.quest_subtitle: "A spark gap"
	quest.13B90ED29E48BA4D.quest_desc: ["&6Processes&r items placed beneath it: drop them, put them on a Depot or feed them on a belt, and it holds and processes them &bautomatically&r. This is how you make a Magnet."]
	quest.13B90ED29E48BA4D.quest_subtitle: "Processes items"
	quest.13C43784078199F2.quest_desc: ["&6Craft&r Hypertube Blocks and start building your &bhigh-speed&r transportation network. Connect them together to create routes through your factory and &bprepare&r them for Hypertube Entrances."]
	quest.13C43784078199F2.quest_subtitle: "Build the path"
	quest.13C8ECBAE2D492BE.quest_desc: ["&6Craft&r the Candy Cane Pickaxe from Create: Confectionery and take your mining to a sweeter level. It is one of the Candy Cane Tools &badded&r to the mod, alongside the Candy Cane Sword, Axe, Shovel, and Hoe."]
	quest.13C8ECBAE2D492BE.quest_subtitle: "Sweeten your mining"
	quest.13E10F2EDD56447C.quest_subtitle: "More Armor"
	quest.13E702AA3E4E825A.quest_desc: ["&6Obtain&r an Andesite Tunnel from Create. It is a transport component &bdesigned&r for Mechanical Belts, allowing &bitems&r to pass through while also providing options for splitting items from the belt to side outputs. It can also be &bused&r with Encased Fans without stopping belt processing."]
	quest.13E702AA3E4E825A.quest_subtitle: "Guide the flow of your factory"
	quest.13E84DCED53E11B5.quest_desc: ["&6The&r Industrial Fan is a powerful addition to your factory from Create: Dreams n' Desires. Built for larger-scale &bprocessing&r and ventilation, it provides stronger airflow for industrial &bapplications&r and helps you take your mechanical systems to the next level."]
	quest.13E84DCED53E11B5.quest_subtitle: "Increase the airflow"
	quest.13EC6BEF25B6D743.quest_desc: ["&6Measures&r &benergy&r used over time. In the menu, hover over the gauges to see usage in Wh or kWh. It sends a redstone pulse through a comparator every 1 Wh or 1 kWh (depending on mode), and reversed &bpower&r makes it count backwards. Changing the unit does not alter the value already measured."]
	quest.13EC6BEF25B6D743.quest_subtitle: "An energy meter"
	quest.13EF14F9C0C1AC10.quest_desc: [
		"&aThe&r Diamond Minotaur Axe is a legendary &bweapon&r once wielded by the mighty Minoshroom, ruler of the Labyrinth. Combining immense &bphysical&r strength with the unmatched sharpness of diamond, this massive axe delivers devastating blows &bcapable&r of cutting through even the toughest enemies."
		""
		"&aMore&r than just a trophy, it &bserves&r as proof that you have conquered one of the Twilight Forest's greatest challenges. Whether used against &bpowerful&r bosses or the countless monsters lurking within the forest, the Diamond Minotaur Axe is a &bweapon&r worthy of any seasoned adventurer."
	]
	quest.13EF14F9C0C1AC10.quest_subtitle: "The weapon of the Labyrinth's champion"
	quest.13F841C650DE1922.quest_desc: ["&6The&r Empty Schematic is used to load saved builds into Create's schematic system. Place it in a Schematic Table, select a saved .nbt schematic from your &bschematics&r folder, and the table will write the selected build onto the item. Once filled, the Schematic can be placed as a holographic blueprint and &bused&r with a Schematicannon to automatically construct the build."]
	quest.13F841C650DE1922.quest_subtitle: "A blueprint waiting to be filled"
	quest.1406E9E6FBEC722C.quest_desc: ["&dPaladin&r Shield is a defensive item from Crystal Chronicles, &bdesigned&r for the Paladin equipment set. It is associated with the Holy magic of the Paladin Armor and provides a sacred means of &bprotection&r for its wielder."]
	quest.1406E9E6FBEC722C.quest_subtitle: "A divine shield forged to protect the faithful"
	quest.141772EFE05F1C0B.quest_desc: ["&6Pushes&r back and stuns enemies if they are not too strong. While you wear a Portable Battery it uses no durability and drains &benergy&r from the battery. An integrated circuit &bboosts&r it for a limited number of uses."]
	quest.141772EFE05F1C0B.quest_subtitle: "An electric baton"
	quest.1420CB48C3207336.quest_desc: [
		"&aCraft&r the Fiery Helmet &busing&r Fiery Ingots forged from the Hydra's blazing essence. Tempered in magical fire, this helmet protects its wearer with both exceptional &bdurability&r and the lingering warmth of the legendary beast's power."
		""
		"&aAs&r part of the Fiery Armor set, it represents your growing mastery over the Twilight Forest's most &bdangerous&r creatures. Every spark radiating from its enchanted metal serves as a reminder of your &bvictory&r over the mighty Hydra."
	]
	quest.1420CB48C3207336.quest_subtitle: "Crowned in eternal flames"
	quest.143AC7705F09C9C4.quest_subtitle: "More Armor"
	quest.1443FDF618D734B2.quest_subtitle: "More Armor"
	quest.1449C2DE34E52C83.quest_desc: [
		"&dPyromancer&r Hat is the headpiece of the Pyromancer Armor set in Iron's Spells 'n Spellbooks. When worn, it provides &b+3&r Armor, &b+125&r Max Mana, &b+10%&r Fire Spell Power and &b+5%&r Spell Power."
		""
		"It can be &bcrafted&r with 5 Arcane Cloth and 1 Fire Rune, or upgraded from a Wizard Helmet using 1 Fire Rune at a Smithing Table in newer versions."
	]
	quest.1449C2DE34E52C83.quest_subtitle: "Master the blazing power of Fire magic"
	quest.144E7A9CA0852D69.quest_desc: [
		"&aThe&r Aethersent Hood is a mystical head armor piece from Eternal Starlight crafted &busing&r Aethersent Ingots."
		""
		"&aIt&r is part of the Aethersent armor progression associated with meteors and celestial &bmaterials&r found within the Starlight dimension."
	]
	quest.144E7A9CA0852D69.quest_subtitle: "Meteor-forged mystic hood"
	quest.145E8D98E3350178.quest_desc: [
		"&dPyromancer&r Robe is the chestpiece of the Pyromancer Armor set in Iron's Spells 'n Spellbooks. When worn, it provides &b+8&r Armor, &b+125&r Max Mana, &b+10%&r Fire Spell Power and &b+5%&r Spell Power. It can also be imbued with 1 spell."
		""
		"It can be &bcrafted&r from 8 Arcane Cloth and 1 Fire Rune, or upgraded from Wizard Robes with 1 Fire Rune using a Smithing Table."
	]
	quest.145E8D98E3350178.quest_subtitle: "Channel the blazing power of Fire magic"
	quest.14660EAC79654B6B.quest_desc: [
		"&eThe&r deeper you go, the harder it becomes to move through the water. Not with this charm."
		""
		"The Charm of Sinking allows you to move freely through fluids, making underwater &bexploration&r much easier. Dive &bstraight&r to the bottom and explore shipwrecks, ocean ruins and other submerged &btreasures&r without fighting against the water."
		""
		"Stop &bfighting&r the current. Embrace the depths."
	]
	quest.14660EAC79654B6B.quest_subtitle: "Descend into the depths"
	quest.149AA01535ACA800.quest_desc: ["&aObtain&r an Athame from the Cataclysm mod. This weapon is dropped by Deepling enemies and is used as a special &bmelee&r weapon. Defeat Deeplings to &bobtain&r this rare ocean weapon."]
	quest.149AA01535ACA800.quest_subtitle: "A ritual blade from the ocean depths"
	quest.14A9324E914715C5.quest_desc: ["&6Craft&r the Cross Connector to route two &bindependent&r rotational connections through the same block. It allows shafts to cross without their &brotational&r power interacting, making compact mechanical layouts much &beasier&r to build."]
	quest.14A9324E914715C5.quest_subtitle: "Cross shafts without mixing rotation"
	quest.14BE598376D7CE47.title: "&l&bSnowQueen"
	quest.14C6EA6A586F51B1.quest_subtitle: "Yummy!"
	quest.14C88377DBCABCB9.quest_desc: ["&aCraft&r a Black Steel Pickaxe from the Cataclysm mod. This powerful &btool&r is made using Black Steel and provides &bexcellent&r durability and mining efficiency. It is part of the Black Steel &bequipment&r set."]
	quest.14C88377DBCABCB9.quest_subtitle: "A mining tool forged from black steel"
	quest.14CF98F399532B33.quest_desc: ["&6Craft&r a White Chocolate Glazed Marshmallow by combining a soft, fluffy marshmallow with a smooth white chocolate coating. Add this sweet treat to your Create: Confectionery &bcollection&r and enjoy the &bperfect&r combination of creamy chocolate and airy marshmallow."]
	quest.14CF98F399532B33.quest_subtitle: "A fluffy treat covered in creamy white chocolate"
	quest.14DB7E9FB8A507A6.quest_desc: ["Craft a Diamond Shield to gain maximum protection from attacks."]
	quest.14DB7E9FB8A507A6.quest_subtitle: "Defend yourself with the strongest shield!"
	quest.14E4B6BAD5C61B69.quest_desc: ["&dThe&r Ring of Expulsion protects you with a passive magical burst. When you are attacked, it automatically releases an expulsive burst of air, pushing &bnearby&r enemies away. The ability has a &b2-second&r cooldown, making it a useful defensive tool for keeping enemies at a distance."]
	quest.14E4B6BAD5C61B69.quest_subtitle: "Repel those who dare to strike you"
	quest.14EB1FFC9489209C.title: "&l&6The &bMaledictus"
	quest.14EC8D406383CA77.quest_subtitle: "More Armor"
	quest.14EEA899999F4B52.quest_desc: ["&6Obtain&r an Analog Lever from Create. Unlike a normal lever, it can output any Redstone signal strength from 0 to 15. Right-click to &bincrease&r the signal strength and sneak-right-click to decrease it. When wearing Engineer’s Goggles, you can see the current &bsignal&r strength directly."]
	quest.14EEA899999F4B52.quest_subtitle: "Take control of the signal"
	quest.14F57DB930D2B243.quest_desc: [
		"&dMagehunter&r is a powerful sword in Iron's Spells 'n Spellbooks, wielded by the Vindicator on the second floor of an Archevoker Fort. It can &bnaturally&r drop when that Vindicator is defeated."
		""
		"When held in the main hand, Magehunter provides &b7&r Attack Damage, &b1.6&r Attack Speed, &b2.5&r Attack Range and &b+15%&r Spell Resistance."
	]
	quest.14F57DB930D2B243.quest_subtitle: "Hunt down those who dare to wield magic"
	quest.153782E196BAC609.quest_desc: ["&6Makes&r &belectricity&r from sunlight. It must point at the sun (the closer, the more &bpower&r) with direct light, since obstacles cut output sharply. It loses &befficiency&r in hot biomes. Panels placed next to each other form a multiblock."]
	quest.153782E196BAC609.quest_subtitle: "Power from the sun"
	quest.15431E0BCD88A88D.quest_desc: [
		"&dDecrepit&r Scythe is a powerful weapon in Iron's Spells 'n Spellbooks. When held in the main hand, it provides &b11&r Attack Damage and &b1.4&r Attack Speed."
		""
		"It can be &bupgraded&r into Hellrazor &busing&r 1 Timeless Slurry and 1 Pyrium Ingot."
	]
	quest.15431E0BCD88A88D.quest_subtitle: "Wield the ancient scythe of the fallen Fire King"
	quest.155698708D31061A.quest_desc: ["&aObtain 5&r Sponges. Sponges can be found inside Ocean Monuments in sponge rooms or obtained by &bdefeating&r Elder Guardians. They are used to absorb water and help with &bunderwater&r exploration."]
	quest.155698708D31061A.quest_subtitle: "A treasure from the ocean monument"
	quest.155698708D31061A.title: "Sponge!!!"
	quest.1558A3470622608C.quest_subtitle: "Yummy!"
	quest.155EC01438BFF295.quest_desc: ["&dTesla&r Rod is a weapon from Crystal Chronicles, associated with the enhanced Electromancer equipment. It &bharnesses&r the power of Lightning magic and Voltite, unleashing concentrated electrical energy against enemies."]
	quest.155EC01438BFF295.quest_subtitle: "A powerful arcane rod charged with the energy of Voltite"
	quest.15684C8DC5461821.quest_desc: ["&6The&r Generator Coil is a key component of the electrical system in Create: New Age. &bCombined&r with the appropriate generator setup, it allows &brotational&r power from Create to be converted into electrical energy. Build your first coil and take the next &bstep&r toward powering your factory with electricity."]
	quest.15684C8DC5461821.quest_subtitle: "Turn rotation into electricity"
	quest.15692C6648259269.quest_desc: ["&6Craft&r the Andesite Configurable Gearbox to gain more control over your kinetic connections. &bConfigure&r its shaft faces to route rotational power exactly where you need it, making compact and flexible mechanical layouts easier to build. It is &bpart&r of Create: Encased."]
	quest.15692C6648259269.quest_subtitle: "Configure your rotation"
	quest.1579479A9BDC15EF.quest_desc: ["&6Craft&r a Mechanical Press from Create. &bIt&r is one of the mod's most important early machines, &bused&r primarily to press Ingots into Sheets. When placed above a Basin, it can &balso&r perform Packing and Compacting recipes."]
	quest.1579479A9BDC15EF.quest_subtitle: "Forge metal with mechanical force"
	quest.15801FA5DAA3426E.quest_subtitle: "Yummy!"
	quest.1589DFF8D8B70BDB.quest_desc: [
		"&eSometimes&r being smaller has its advantages."
		""
		"The Charm of Shrinking &breduces&r your size to roughly half of your normal height. Become harder to spot, squeeze into tight spaces and see the world from a whole &bnew&r perspective."
		""
		"&bSmall&r body. Big adventure."
	]
	quest.1589DFF8D8B70BDB.quest_subtitle: "Become small. Think big"
	quest.1598143ABE2A3FE6.quest_desc: ["&aDefeat&r 5 Draugr from the Cataclysm mod. These undead warriors roam the Frosted Prison and will relentlessly &battack&r anyone who &benters&r their frozen domain."]
	quest.1598143ABE2A3FE6.quest_subtitle: "Defeat the frozen undead"
	quest.1598143ABE2A3FE6.title: "Kill Draugr"
	quest.15A0DA57EF17E2A8.quest_desc: ["&6The&r Blazing Cleaver is the weapon of the Blazing Kit from Create Stuff 'N Additions. It has 450 durability, deals 6.5 attack damage and has 1.5 attack speed. Its &battacks&r set mobs on fire, making it a powerful &bweapon&r for close combat."]
	quest.15A0DA57EF17E2A8.quest_subtitle: "Let your blade burn"
	quest.15A176491FE6C59D.quest_desc: ["&6Build&r a Windchest to manage the &bairflow&r and stops of your pipe organ. Windchests make it easier to control multiple organ stops on a larger scale, &bhelping&r you build more complex musical instruments."]
	quest.15A176491FE6C59D.quest_subtitle: "Give your organ its breath"
	quest.15A41616700124C0.quest_desc: ["&6Craft&r a Millstone from Create. It is an early mechanical processing machine that &buses&r rotational power to mill various items into &buseful&r materials. It can process items inserted from above and is a simpler alternative to the more &badvanced&r Crushing Wheels."]
	quest.15A41616700124C0.quest_subtitle: "Grind your way to better materials"
	quest.15A4D35BF2B8AFD9.quest_desc: [
		"&dThe&r Vampiric Spell Book is a powerful Blood magic spellbook from Iron's Spells 'n Spellbooks. It grants &b+1&r level to Blood Slash and Blood Step, while equipping it provides &b+10%&r Blood Spell Power, &b+10%&r Spell Resistance and &b+200&r Max Mana."
		""
		"Harness the &bpower&r of blood magic and become a more formidable spellcaster."
	]
	quest.15A4D35BF2B8AFD9.quest_subtitle: "Embrace the power of blood magic"
	quest.15AE326A4267692B.quest_subtitle: "Upgrade+"
	quest.15AE8E766962AD23.quest_desc: [
		"&6A&r simple gyroscope keeps your aircraft stable, but advanced engineering can do even more. The Advanced Gyroscope adds a mechanical &binstrument&r panel that lets you monitor your speed, pitch and warnings while in flight."
		""
		"&bInstall&r it and keep a close eye on your aircraft's condition as you take to the skies."
	]
	quest.15AE8E766962AD23.quest_subtitle: "Precision instruments for complete control."
	quest.15D6009B5D72CB2B.quest_desc: [
		"&dThe&r Apprentice's Spell Book is the gold-tier spellbook in Iron's Spells 'n Spellbooks. It provides &b8&r spell slots and grants &b+15%&r Cast Time Reduction and &b+50&r Max Mana while equipped."
		""
		"&bUpgrade&r from the Ironbound Tome and prepare yourself for more &badvanced&r magic. With additional spell slots, faster casting and more mana, this book gives you a significant &bboost&r in your magical progression."
	]
	quest.15D6009B5D72CB2B.quest_subtitle: "Step into the next stage of spellcasting"
	quest.15DB9273EF70A5A6.quest_desc: ["&dExplore&r Hazen N Stuff, discover new items and &bexpand&r your Minecraft adventure!"]
	quest.15DB9273EF70A5A6.quest_subtitle: "Discover new items and useful additions!"
	quest.15DB9273EF70A5A6.title: "&l&dWelcome Hazen 'N Stuff"
	quest.15EBC896DD9A8B6A.quest_desc: [
		"&aObtain&r the Leather Handle Attachment Smithing Template, used to attach a leather-wrapped stick to a tool head at the Smithing Table."
		""
		"It offers an early, cheaper alternative for &bassembling&r Better End tools before better handles are available."
	]
	quest.15EBC896DD9A8B6A.quest_subtitle: "A simpler handle"
	quest.15F29EF5F937029E.quest_subtitle: "More Armor"
	quest.16121596903B5B3A.quest_desc: [
		"&aDiscover&r the Blossoming Spires — islands and floating spires covered in lush pink and blue foliage, with &bpetals&r drifting from above."
		""
		"Tenanea trees grow here, and Silk Moths nest among the branches, making it one of the most &bpeaceful&r biomes in the End."
	]
	quest.16121596903B5B3A.quest_subtitle: "Floating spires in bloom"
	quest.16121596903B5B3A.title: "Blossoming Spires"
	quest.162239A6A7321602.quest_desc: ["&eCombine&r alchemy with technology! The Potion Sprayer allows you to shoot droplets of potions, spraying their effects onto your target. Simply aim and &bright-click&r to fire. The device &bconsumes&r only a fraction of the potion's duration, allowing you to use its effects more efficiently. &bPrepare&r your potions and put this ingenious invention to the test!"]
	quest.162239A6A7321602.quest_subtitle: "Alchemy Meets Machinery"
	quest.1639C5CF8C2E46DE.quest_desc: ["&6Zinc&r Boots are part of the Zinc Suit from Create Stuff 'N Additions. They provide an &balternative&r set of armor made from Zinc and have &b260&r durability. They are crafted using &b4&r Zinc Ingots."]
	quest.1639C5CF8C2E46DE.quest_subtitle: "Step into something stronger"
	quest.165A3D4899C7CE3E.quest_desc: [
		"&aDefeat&r the Ender Dragon, the original boss of the End and guardian of its central island."
		""
		"Slaying it opens the &bEnd Gateways&r leading to the outer islands, where Better End's biomes and &bresources&r truly begin."
	]
	quest.165A3D4899C7CE3E.quest_subtitle: "Face the guardian of the End"
	quest.165A3D4899C7CE3E.title: "&l&dEnder Dragon"
	quest.16660EB4BF922732.quest_subtitle: "More Armor"
	quest.1669DB82AD915EEC.title: "Villager SIGMA"
	quest.1696835CA5C1E502.quest_desc: [
		"&eWhy&r carry a furnace when your hands can do the work?"
		""
		"The Pickaxe Heater automatically smelts blocks as you mine them. Ores are turned &bdirectly&r into their smelted forms, while other blocks can also produce &buseful&r &bresults&r — like Logs becoming Charcoal and Sand becoming Glass."
		""
		"&bDig&r deep. The furnace comes with you."
	]
	quest.1696835CA5C1E502.quest_subtitle: "Mine it. Smelt it. Keep going"
	quest.16A91D6314BCEE89.quest_desc: ["&aObtain&r a Khopesh from the Cataclysm mod. This &bancient&r curved sword is wielded by Koboletons that inhabit the Desert Site. &bDefeat&r these skeletal guardians for a chance to claim their &bsignature&r weapon."]
	quest.16A91D6314BCEE89.quest_subtitle: "The curved blade of the desert guardians"
	quest.16C9E1B9DC493B42.quest_desc: ["&6Welcome&r to Create: Encased! This &baddon&r expands Create's casing system, allowing shafts, cogwheels and pipes to use a wide variety of casings. Build cleaner, more consistent-looking machinery while giving your kinetic systems a more &bindustrial&r appearance. The addon also includes &badditional&r encased components and compatibility features in newer versions."]
	quest.16C9E1B9DC493B42.quest_subtitle: "Give your machinery a proper casing"
	quest.16C9E1B9DC493B42.title: "&l&6Welcome Create Encased"
	quest.16CFE3EF0ABCF30E.quest_desc: [
		"&aStep&r through an End Portal and set foot in &bThe End&r — the dimension of endless void, floating islands, and the Ender Dragon."
		""
		"This is the &agateway&r to everything Better End has to offer, from strange new biomes to powerful &bpost-game&r equipment."
	]
	quest.16CFE3EF0ABCF30E.quest_subtitle: "Beyond the outer islands"
	quest.16CFE3EF0ABCF30E.title: "&l&dThe End"
	quest.16D17F7B20048399.quest_subtitle: "Yummy!"
	quest.1719197C39F46D1B.quest_desc: ["&dThe&r Musket is a long gun built from simple mechanical parts. Use it when you want to hit targets from a &bdistance&r instead of up close, and open its modifier menu to tune it to your playstyle."]
	quest.1719197C39F46D1B.quest_subtitle: "A classic long gun"
	quest.172786BB1D31B4AB.quest_desc: ["&aCraft&r the Cursium Mage Skirt from the Cataclysm: Spellbooks addon. Woven with the cursed &bessence&r of Cursium, this &benchanted&r garment completes the Cursium Mage set, allowing its wearer to fully embrace the &bforbidden&r power hidden within the Ancient Factory."]
	quest.172786BB1D31B4AB.quest_subtitle: "The final piece of forbidden attire"
	quest.17323CADFAE8D198.title: "Nice Good PRO"
	quest.174BA7516500B67A.quest_subtitle: "More Armor"
	quest.175A327DC1A4322B.quest_desc: [
		"&9&lTake&r&r your Refined Storage network with you wherever you go. The Wireless Grid gives you remote &baccess&r to your digital storage, allowing you to view, search for and manage your items without being directly &bconnected&r to the network."
		""
		"Pair it with a Wireless Transmitter and enjoy the freedom of &bmanaging&r your storage from a distance."
	]
	quest.175A327DC1A4322B.quest_subtitle: "Access your entire storage network from anywhere"
	quest.1762F955DD44424E.quest_subtitle: "Upgrade+"
	quest.176378DFBC009C93.quest_subtitle: "Upgrade+"
	quest.177D9D68B790740B.quest_subtitle: "More Weapon"
	quest.178C046DD22870A7.quest_desc: [
		"&aDeepsilver&r is one of the basic metals found in Eternal Starlight."
		"It can be smelted into ingots and used for tools, armor, and several utility recipes."
		""
		"Originally known as Swamp Silver, this material now &bgenerates&r across underground areas of the dimension."
	]
	quest.178C046DD22870A7.quest_subtitle: "Metal from the depths"
	quest.178C046DD22870A7.title: "&6Deepsilver Ingot"
	quest.17ADAF445CB8C8B0.quest_desc: ["&dA&r special rune &bused&r to craft Hydro weapons in Hazen N Stuff."]
	quest.17ADAF445CB8C8B0.quest_subtitle: "A rune infused with the power of water"
	quest.17CA7BF8E75A4B72.quest_desc: [
		"&9&lTake&r&r your Sophisticated Storage container from the Copper Tier to the Iron Tier. This upgrade improves your storage capabilities and brings you one &bstep&r closer to the most advanced storage tiers."
		""
		"Keep &bupgrading&r your containers and build a storage system capable of handling even the largest collections."
	]
	quest.17CA7BF8E75A4B72.quest_subtitle: "Forge your way to stronger storage"
	quest.17CCA970EE3B5224.quest_subtitle: "More Armor"
	quest.17DC5821AB6385E7.quest_subtitle: "Upgrade+"
	quest.1801803F06F75E60.quest_desc: ["&6Obtain&r Train Track from Create. Train Tracks are the foundation of Create's railway system and allow trains to &btravel&r between stations. They can be placed in straight lines, curves, and junctions, letting you build complex railway networks. A Train Station can be &bconnected&r to the track to &bbegin&r assembling trains."]
	quest.1801803F06F75E60.quest_subtitle: "Lay the foundation of your railway"
	quest.18037EBDF89FDA39.quest_subtitle: "More Armor"
	quest.1824205C75ADA826.quest_desc: [
		"Schalk Sticks are &bused&r in decorating and crafting advanced decorative items."
		"Craft one to begin creating unique patterns and designs in your world."
	]
	quest.1824205C75ADA826.quest_subtitle: "Craft your first decorative stick"
	quest.1824205C75ADA826.title: "Schalk Stick"
	quest.183B980DAE2FE750.quest_desc: ["&6Obtain&r a Train Signal from Create. Train Signals divide railway tracks into &bsections&r and control whether trains are &ballowed&r to enter them, helping prevent collisions and keeping automated rail networks organized. A &bsignal&r can also be configured as an Entry Signal or Cross Signal using a Wrench."]
	quest.183B980DAE2FE750.quest_subtitle: "Keep the railway running safely"
	quest.18461FDC254CB816.quest_desc: ["&6Obtain&r a Desk Bell, Peculiar Bell, and Haunted Bell from Create. Each bell has its own purpose: the Desk Bell can emit a Redstone pulse, the Peculiar Bell serves as a &bdecorative&r brass bell and can be transformed into a Haunted Bell, while the Haunted Bell can reveal areas where &bhostile&r mobs may spawn."]
	quest.18461FDC254CB816.quest_subtitle: "Ring the bells of creation"
	quest.185CD1A2FA6040DC.quest_desc: [
		"&l&9Never&r&r run out of the items you use most. The Refill Upgrade &bautomatically&r replenishes selected items in your inventory &busing&r supplies stored inside your backpack. It can keep up to 6 different items stocked wherever they are in your inventory."
		""
		"The Advanced Refill Upgrade takes things further, supporting up to 12 items and allowing you to choose exactly where &beach&r item should be refilled — anywhere in the inventory, the main hand, offhand, or a specific hotbar slot."
	]
	quest.185CD1A2FA6040DC.quest_subtitle: "Keep your essentials topped up at all times"
	quest.185CD1A2FA6040DC.title: "Refill \\& Advanced Refill Upgrade"
	quest.186B2F89052D3915.quest_desc: [
		"&aCraft&r the legendary Nether Star Hook, a fishing &bupgrade&r infused with the power of one of the rarest treasures in existence. Created from the remains of a fallen Wither, this extraordinary hook &brepresents&r the perfect combination of dangerous magic and advanced fishing mastery."
		""
		"&aOnly&r the bravest adventurers who have &bconquered&r the horrors of the Nether can obtain the materials required for such a powerful tool. With the Nether Star Hook, your fishing journey reaches a new level, &ballowing&r you to seek treasures worthy of a true master."
	]
	quest.186B2F89052D3915.quest_subtitle: "A piece of the Nether's power"
	quest.188625FB1A6A1EAD.quest_desc: [
		"&aThe&r Deepsilver Boots are protective footwear from Eternal Starlight crafted &busing&r Deepsilver Ingots."
		""
		"Deepsilver armor &aimproves&r movement speed, attack speed, and knockback resistance, while the complete set grants &bimmunity&r to several harmful effects."
	]
	quest.188625FB1A6A1EAD.quest_subtitle: "Swift silver footwear"
	quest.189216DAAD0170F1.quest_desc: ["&6Upgrade&r your solar heating with the Advanced Solar Heating Plate. This &bimproved&r version provides a &bstronger&r source of heat for your thermal systems, allowing you to build more efficient &bsetups&r and generate greater amounts of heat for your factory."]
	quest.189216DAAD0170F1.quest_subtitle: "Harness even more solar heat"
	quest.18952C22F2AFCFA7.quest_desc: [
		"&dCryomancer&r Boots are part of the Cryomancer Armor set in Iron's Spells 'n Spellbooks. When worn, they provide &b+3&r Armor, &b+125&r Max Mana, &b+10%&r Ice Spell Power and &b+5%&r Spell Power."
		""
		"They can be &bcrafted&r from 4 Arcane Cloth and 1 Ice Rune, or upgraded from Wizard Boots with 1 Ice Rune and 1 Arcane Essence."
	]
	quest.18952C22F2AFCFA7.quest_subtitle: "Walk through the frozen realm with the power of Ice magic"
	quest.189D73BFFD934933.quest_desc: ["&6Craft&r the Candy Cane Sword from Create: Confectionery and take on your enemies with a festive weapon. It is part of the Candy Cane Tools set &badded&r to the mod, alongside the Candy Cane Pickaxe, Axe, Shovel, and Hoe. The latest 1.20.1 &brelease&r includes the Candy Cane Tools."]
	quest.189D73BFFD934933.quest_subtitle: "A sweet blade for festive battles"
	quest.189F394C8BA85129.quest_desc: ["&6The&r Brass Cube is a special movable entity added by Create Stuff 'N Additions. It can be &bplaced&r in the world and acts as a solid object that can support other entities. It does not move on its own, but it can be picked up and &btransported&r with the Block Grabber. The Brass Cube is crafted using &b8&r Brass Ingots and &b1&r Netherite Ingot, making it a useful component for more &badvanced&r contraptions and machinery."]
	quest.189F394C8BA85129.quest_subtitle: "A solid piece of brass engineering"
	quest.18B3D07EC43ABBB0.quest_desc: [
		"&aLocate&r an End City, a tall structure of purpur blocks and end stone bricks that generates on the outer islands of the End."
		""
		"Guarded by Shulkers, these towers hold some of the best loot in the dimension — including Elytra and &bShulker Shells&r."
	]
	quest.18B3D07EC43ABBB0.quest_subtitle: "Towers of purpur and shulkers"
	quest.18B3D07EC43ABBB0.title: "&dEnd City"
	quest.18BA5F1590BDD5FD.quest_desc: ["&6Biomass&r is an organic fuel resource added by Create Crafts \\& Additions. It can be &bprocessed&r into Biomass Pellets and used as a fuel, providing a &brenewable&r way to power your factory. The mod also includes further &bprocessing&r into Bioethanol, giving biomass a useful role in your fuel production chain."]
	quest.18BA5F1590BDD5FD.quest_subtitle: "Turn organic matter into fuel"
	quest.18BE95E97E843ECC.quest_desc: ["&aObtain&r the Gauntlet of Bulwark from the Cataclysm mod. This &blegendary&r gauntlet channels the power of the Nether, allowing its wielder to unleash fiery shockwaves and control the &bbattlefield&r with overwhelming force. It is one of the signature relics of the infernal realm."]
	quest.18BE95E97E843ECC.quest_subtitle: "Command the flames to defend and destroy"
	quest.18BE95E97E843ECC.title: "&cGauntlet Of Bulwark"
	quest.18CB628FED0538D8.quest_desc: [
		"&dShriving&r Stone is a crafting material in Iron's Spells 'n Spellbooks used in an Anvil or Arcane Anvil to remove Imbuements and &bUpgrades&r from equipment. In newer versions, &busing&r it in the Arcane Anvil can also return the Upgrade Orbs &bused&r on the item."
		""
		"It is &bcrafted&r from 1 Raw Iron and 1 Amethyst Shard."
	]
	quest.18CB628FED0538D8.quest_subtitle: "Erase enchantments and reclaim your equipment"
	quest.18D23701DC40E769.quest_desc: ["&dThe&r Arquebus is a long-barreled firearm built with Clockwork Components. Obtaining one earns the Wikipedia Historian advancement, and its modifier slots let you make it truly your own."]
	quest.18D23701DC40E769.quest_subtitle: "A weapon from another age"
	quest.18E6C8C7E54DE095.quest_subtitle: "More Armor"
	quest.18F0B98EADA14792.quest_desc: ["&6Obtain&r Andesite Alloy, one of the fundamental materials in Create. It is &bused&r extensively in early mechanical components, including Shafts, Cogwheels, and Andesite Casings. &bIt&r can be crafted &busing&r Andesite and Iron Nuggets or Zinc Nuggets, or produced by mixing Andesite with an Iron or Zinc Nugget."]
	quest.18F0B98EADA14792.quest_subtitle: "The foundation of mechanical engineering"
	quest.18F0B98EADA14792.title: "Andesite Alloy"
	quest.1902F55A2E3FD6FD.quest_desc: ["&6Process&r Thorium into Radioactive Thorium and take the next step toward nuclear technology in Create: New Age. These &bmaterials&r are essential for progressing into the reactor branch and &bunlocking&r more advanced nuclear components."]
	quest.1902F55A2E3FD6FD.quest_subtitle: "Refine the power of the atom"
	quest.1902F55A2E3FD6FD.title: "Thorium Progression"
	quest.19036DBA141117A3.quest_desc: [
		"In Eternal Starlight, &aEther&r is a volatile substance that can be &bcollected&r in a bucket."
		"&aUnlike&r lava, it does not destroy items — but it is still &bdangerous&r to handle."
	]
	quest.19036DBA141117A3.quest_subtitle: "Dangerous essence"
	quest.193323B714918063.quest_desc: ["&aObtain&r the Wither Assault Shoulder Weapon from L_Ender’s Cataclysm. This &bpowerful&r ranged weapon fires Wither &bMissiles&r that deal damage, cause an explosion, and inflict Wither II. While sneaking, it can instead fire a Wither Grenade, creating a damaging &bexplosion&r and a cloud of Wither smoke."]
	quest.193323B714918063.quest_subtitle: "Unleash the power of the Wither"
	quest.193323B714918063.title: "&cWither Assault Shoulder Weapon"
	quest.1939D50868404EA2.quest_subtitle: "Upgrade+"
	quest.193D395B36B75F28.quest_subtitle: "More Armor"
	quest.196132151FD59708.quest_desc: ["&6Obtain&r a Shaft from Create. The Shaft is one of the most &bbasic&r mechanical components in the mod, &bused&r to transfer rotational force between connected components. It also serves as the &bfoundation&r for Mechanical Belts. One Andesite Alloy can be sawn into &b6&r Shafts, or &b2&r Andesite Alloy can be crafted into &b8&r Shafts."]
	quest.196132151FD59708.quest_subtitle: "The backbone of mechanical power"
	quest.196132151FD59708.title: "Shaft"
	quest.1977F95F83CD7190.quest_desc: ["&6The&r Spiky Shell is an aquatic crafting material added in Create: Aquatic Ambitions 2.0. It is used in the crafting of the Trident, &breplacing&r the old Polished Quartz Tine from earlier versions. Collect Spiky Shells to &bunlock&r one of the most powerful weapons of the sea."]
	quest.1977F95F83CD7190.quest_subtitle: "A weapon from the depths"
	quest.1978F7E664C6B9C8.quest_desc: ["Collect &a5 diamonds&r by exploring the deep layers of the world. Diamonds are extremely rare and are the foundation for crafting the best tools, weapons, and advanced equipment. Finding them means you’ve reached a new level of &bprogression&r."]
	quest.1978F7E664C6B9C8.quest_subtitle: "The most valuable underground resource"
	quest.1978F7E664C6B9C8.title: "&bDiamonds!"
	quest.1986376E0B2C0462.quest_desc: [
		"&aThe&r Seeking Eye is a special item used in Eternal Starlight to locate powerful &bbosses&r within the dimension."
		"When used, it guides you toward hidden threats that cannot be found through normal &aexploration&r."
	]
	quest.1986376E0B2C0462.quest_subtitle: "It shows the way"
	quest.1986376E0B2C0462.title: "&l&5Seeking Eye"
	quest.19A2B8AEEBEB630A.quest_desc: ["&6Craft&r the Piccolo pipe and add a bright, &bhigh-pitched&r voice to your pipe organ. Piccolo is one of the organ &bstops&r included in Create: Sound of Steam, alongside pipes such as Gedackt, Diapason and Gamba."]
	quest.19A2B8AEEBEB630A.quest_subtitle: "Add a bright, high-pitched voice"
	quest.19A822E3223E5218.quest_desc: ["&6The&r Copper Exoskeleton is a wearable piece of equipment from Create Stuff 'N Additions that enhances your physical abilities. It can provide Strength or Haste, &bmaking&r you more effective in combat and while working with tools. The exoskeleton is crafted &busing&r Create's mechanical crafting &bprocesses&r and requires hydraulic energy to operate."]
	quest.19A822E3223E5218.quest_subtitle: "Boost your strength and speed"
	quest.19CF5920F5C100DF.quest_desc: [
		"Craft a &aSleeping Bag&r to sleep safely without a bed."
		"Sleeping Bags let you set your spawn point and rest anywhere in the world."
	]
	quest.19CF5920F5C100DF.quest_subtitle: "Sleep anywhere"
	quest.19CF5920F5C100DF.title: "Sleeping Bag"
	quest.19EE02F8FACB74A7.quest_desc: [
		"&aCraft&r the Ironwood Boots using Ironwood Ingots &binfused&r with the ancient magic of the Twilight Forest. Forged to withstand the dangers of forgotten ruins and enchanted wilderness, these boots provide dependable protection while remaining comfortable enough for long &bexpeditions&r across the magical realm."
		""
		"&aAs&r the final piece of the Ironwood Armor set, they &bcomplete&r a balanced collection of equipment capable of carrying you through the many &bchallenges&r that await within the Twilight Forest."
	]
	quest.19EE02F8FACB74A7.quest_subtitle: "Stand firm on enchanted ground"
	quest.1A03C838956DBD18.quest_desc: ["&6Small&r contacts that go into &bswitches&r, fixtures and other parts."]
	quest.1A03C838956DBD18.quest_subtitle: "Contact pins"
	quest.1A0BA09F04CC257D.quest_desc: [
		"&dLeave&r the ordinary world behind and step into the realm of powerful spells, ancient knowledge and magical artifacts. Iron's Spells 'n Spellbooks brings a deep magic system to your adventure, giving you the &bpower&r to learn spells, wield &benchanted&r weapons and become a true master of the arcane."
		""
		"&bGather&r your first magical equipment, discover new spells and &bbegin&r your journey toward becoming a powerful spellcaster."
	]
	quest.1A0BA09F04CC257D.quest_subtitle: "Begin your journey into the world of magic"
	quest.1A0BA09F04CC257D.title: "&l&dWelcome Iron's Spell 'n Spellbooks         "
	quest.1A1748E3BE20CC81.quest_desc: ["&6Craft&r Metal Walkway Steps and start expanding your &bfactory's&r elevated walkways. These sturdy &bsteps&r are part of the transportation system &badded&r by Create: Escalated, helping you create practical routes around your factory."]
	quest.1A1748E3BE20CC81.quest_subtitle: "Build your path to the next level"
	quest.1A20DB140D7D7229.quest_subtitle: "More Armor"
	quest.1A3E117D9AC47513.quest_desc: [
		"The Thallasium Ingot is the base metal of Better End's tool and armor progression."
		""
		"Smelted from &bThallasium&r ore found across the End, it's forged into plating and tool heads using an Anvil and Smith Hammer."
	]
	quest.1A3E117D9AC47513.quest_subtitle: "Metal of the first tier"
	quest.1A412349DDF29366.quest_desc: ["&6A&r multi-purpose tool for anyone who wants to play with &belectricity&r. Held in hand, it probes &bvoltage&r between terminals or current flowing through wires (you switch the mode)."]
	quest.1A412349DDF29366.quest_subtitle: "A multi-purpose meter"
	quest.1A56BB38BDD9F25C.quest_desc: [
		"&eEvery&r adventure deserves a little companion."
		""
		"The Welcome Plushie is a small reminder that no &bjourney&r has to be taken alone. Keep it close, give it a &bplace&r in your home, and let it welcome you back after every expedition."
		""
		"A &bnew&r world awaits. Welcome home."
	]
	quest.1A56BB38BDD9F25C.quest_subtitle: "A warm welcome for every adventure"
	quest.1A56BB38BDD9F25C.title: "&f&lWelcome &9Plushie MOD"
	quest.1A5AD879324A92A5.quest_desc: ["&6The&r Copper Tools are a complete set of tools added by Create Stuff 'N Additions. They provide a copper-based &balternative&r for everyday work, giving you a full set of Pickaxe, Axe, Shovel, Hoe and Sword. Craft the &bcomplete&r set and put copper to work beyond your machinery"]
	quest.1A5AD879324A92A5.quest_subtitle: "A new edge for your tools"
	quest.1A5AD879324A92A5.title: "Copper Tools"
	quest.1A63793F65B24A75.quest_desc: [
		"&aThe&r Malarite Axe is an early-game tool from Eternal Starlight, crafted &busing&r Malarite from swamp-related biomes."
		""
		"&aIt&r belongs to the basic progression tier and is used for woodcutting and &bearly&r combat."
	]
	quest.1A63793F65B24A75.quest_subtitle: "Swamp woodcutting tool"
	quest.1A6C9BFFB7DE7FCC.quest_desc: [
		"&dLegendary&r Ink is the highest tier of magical ink in Iron's Spells 'n Spellbooks. It is found very rarely in magic structures or &bobtained&r from powerful magical creatures."
		""
		"&bUse&r it in the Scroll Forge to create Legendary Scrolls and &bunlock&r the most powerful levels of magic."
	]
	quest.1A6C9BFFB7DE7FCC.quest_subtitle: "The rarest essence of magical power"
	quest.1A6C9BFFB7DE7FCC.title: "&6Legendary Ink"
	quest.1A95FC4F73694D81.quest_desc: [
		"&9&lKeep&r&r your storage &borganized&r with the Filter Upgrade. It allows you to control which items can enter or leave your storage, making it easier to &bconnect&r your containers to automated item transport systems."
		""
		"The Advanced Filter Upgrade &bprovides&r more precise control over item movement, giving you additional filtering &boptions&r to determine exactly which items your storage should accept or provide."
	]
	quest.1A95FC4F73694D81.quest_subtitle: "Take complete control over your storage"
	quest.1A95FC4F73694D81.title: "Filter \\& Advanced Filter Upgrade"
	quest.1AB7F05CD50ED0F9.quest_desc: ["&dSanguine&r Edge is a weapon from Crystal Chronicles, an &baddon&r for Iron’s Spells ’n Spellbooks. Its crimson nature reflects the power of Blood magic, making it a formidable weapon for &bblood-focused&r builds."]
	quest.1AB7F05CD50ED0F9.quest_subtitle: "A blade steeped in the power of blood magic"
	quest.1ABE0E54542EAC0F.quest_subtitle: "More Armor"
	quest.1ACBC0809E193D2B.quest_desc: [
		"&aObtain&r a Gold Ingot by mining and smelting gold ore or by other means."
		"Gold is used in many crafting &brecipes&r and is especially useful in the Nether."
	]
	quest.1ACBC0809E193D2B.quest_subtitle: "A precious resource"
	quest.1ACBC0809E193D2B.title: "Gold Ingot"
	quest.1AE40FE5B2553236.quest_desc: ["&6Obtain&r a List Filter and a Nozzle from Create. The List Filter allows you to create a custom list of &bitems&r that a filtered transport component should allow or deny. The Nozzle is &bused&r with Create's item-transport systems to control and direct item movement, making both &buseful&r for more &bprecise&r factory logistics."]
	quest.1AE40FE5B2553236.quest_subtitle: "Control what flows through your factory"
	quest.1AE40FE5B2553236.title: "List Filter \\& Nozzle"
	quest.1AEF11A228882EA6.quest_desc: [
		"&aArctic&r Fur is a soft yet incredibly resilient &bmaterial&r gathered from the creatures that inhabit the icy reaches of the Twilight Forest. Its &bremarkable&r insulating properties make it one of the finest &bmaterials&r for crafting &bequipment&r capable of enduring the relentless cold."
		""
		"&aHighly&r prized by experienced adventurers, Arctic Fur is &bessential&r for creating the Arctic Armor set. Wearing equipment crafted from this rare pelt &ballows&r you to brave the frozen wilderness and continue your &bjourney&r toward the final challenges hidden within the Twilight Forest"
	]
	quest.1AEF11A228882EA6.quest_subtitle: "A cloak against the frozen winds"
	quest.1AF2481AB26B4EE7.quest_desc: [
		"&aIn this world&r, the End is not reached the usual way."
		"To unlock access to&d the End&r, you must gather 12 Eyes of Ender from End Remastered, each one representing a fragment of progression earned through your journey — exploration, story quests, and defeated bosses."
		""
		"These &beyes&r are not just crafted — they are earned. Each step of your adventure, from defeating powerful bosses to completing major story milestones, brings you closer to unlocking the End Portal."
		""
		"Only when all&e 12&r Eyes are &acollected&r will the final path &bopen&r."
	]
	quest.1AF2481AB26B4EE7.quest_subtitle: "Read This First!"
	quest.1AF2481AB26B4EE7.title: "&eEyes &dOf &cThe &9End"
	quest.1AFC9C32E846980F.quest_subtitle: "More Armor"
	quest.1AFDFB316B5358F7.quest_desc: ["&dCreates&r a &bgravity well&r where your bullet hits, dragging nearby creatures toward the impact point. Great for crowd control."]
	quest.1AFDFB316B5358F7.quest_subtitle: "Pull them together"
	quest.1B1A21C20E23AAC8.quest_desc: [
		"The &aTinkering Table&r allows you to experiment and craft various decorative block variants."
		"Use it to combine materials and create unique designs for your builds."
	]
	quest.1B1A21C20E23AAC8.quest_subtitle: "Experiment with blocks"
	quest.1B256CB91C3D4B7D.quest_desc: [
		"&aThe&r Starfire Shovel is a late-game digging tool from Eternal Starlight, part of the Starfire &bequipment&r tier."
		""
		"&aIt&r is used for excavation and terrain clearing, offering improved performance &bcompared&r to lower-tier tools."
	]
	quest.1B256CB91C3D4B7D.quest_subtitle: "Starlight excavation tool"
	quest.1B3A0190AE2DBAAF.quest_desc: ["&6Welcome&r to Create: Hypertubes! Build a &bhigh-speed&r transportation network using powered tubes and Hypertube Entrances. Connect different parts of your factory and launch yourself through the tubes for fast and seamless travel. The system &bintegrates&r directly with Create's &brotational&r power."]
	quest.1B3A0190AE2DBAAF.quest_subtitle: "    Travel at the speed of Create    "
	quest.1B3A0190AE2DBAAF.title: "&l&6Welcome Create Hypertube"
	quest.1B539D9A88A15B9E.quest_subtitle: "More Armor"
	quest.1B5ABB63DDABE534.quest_desc: ["&dYour&r bullets &bexplode&r on impact, damaging everything in a small radius."]
	quest.1B5ABB63DDABE534.quest_subtitle: "Explosive finish"
	quest.1B62BA7293AED04F.quest_desc: [
		"&6The&r railway is more than just a way to get from one place to another. Steam 'n' Rails expands Create's railway system with new tracks, signals, train equipment and &bdecorative&r details, giving you &beverything&r you need to build a truly impressive railway network."
		""
		"Lay new tracks, build proper stations, organize your &brailways&r and put your trains to work. Your railway empire starts here."
	]
	quest.1B62BA7293AED04F.quest_subtitle: "Take your railway network to the next level."
	quest.1B62BA7293AED04F.title: "&l&6Welcome Create Steam 'n' Rails"
	quest.1B82B436FBEDA07C.quest_subtitle: "Yummy!"
	quest.1B883679D57514B2.quest_desc: ["&aThe&r Bartering Station automates &btrading&r with piglins. Place gold ingots inside it, and the station will give them to nearby piglins and &bautomatically&r collect the items received in return."]
	quest.1B883679D57514B2.quest_subtitle: "Let the Piglins Work for You"
	quest.1B9B5991EA5ACAAB.quest_desc: [
		"&6A&r stronger aircraft means a safer journey. Hull Reinforcement doubles the durability of your aircraft, making it much more &bresistant&r to damage during demanding flights."
		""
		"Reinforce the hull and gi&bve&r your aircraft the durability it needs to withstand whatever the skies throw at it."
	]
	quest.1B9B5991EA5ACAAB.quest_subtitle: "Strengthen your aircraft and survive the roughest flights."
	quest.1B9BE01D79119189.quest_subtitle: "More Armor"
	quest.1BA82AB0BCEA7D8F.quest_desc: ["&6The&r Inverse Gearshift gives you greater control over &brotational&r power in Create: Dreams n' Desires. &bUse&r it to reverse the direction of rotation in your mechanical setups and create more &bflexible&r and compact factory designs."]
	quest.1BA82AB0BCEA7D8F.quest_subtitle: "Turn the rotation around"
	quest.1BBD702B010EF944.quest_desc: [
		"&6Sometimes&r the best way to deal with a &bproblem&r is from above. The Bomb Bay allows your aircraft to drop small TNT &bcharges&r from the sky, giving you a new way to handle targets and clear the ground below."
		""
		"Install the Bomb Bay, &btake&r to the skies and prepare your payload."
	]
	quest.1BBD702B010EF944.quest_subtitle: "Turn your aircraft into a flying bomber."
	quest.1BC410D696FF7D46.quest_desc: ["&6A&r lamp for warehouses and tall buildings. Right-click it with any &blight&r bulb to install one. Adjacent lamps can be connected, and one gives light level 15 on the top face of a block up to 16 blocks below."]
	quest.1BC410D696FF7D46.quest_subtitle: "A warehouse lamp"
	quest.1BD714B825A03EEC.quest_subtitle: "More Armor"
	quest.1BDB6377CEACF423.quest_desc: ["&6An&r attachment point for heavy &bwires&r."]
	quest.1BDB6377CEACF423.quest_subtitle: "A heavy wire post"
	quest.1BFE7189DCD0345B.quest_desc: ["&aCraft&r a Black Steel Targe from the Cataclysm mod. This &bsturdy&r shield is made using Black Steel and provides &breliable&r protection against &bpowerful&r enemies. It is part of the Black Steel equipment set."]
	quest.1BFE7189DCD0345B.quest_subtitle: "A shield forged from black steel"
	quest.1C00BDA0521E7A74.quest_subtitle: "More Armor"
	quest.1C1110E06AFFCBDB.quest_subtitle: "Yummy!"
	quest.1C281BF968E63FE9.quest_subtitle: "Yummy!"
	quest.1C48D11547020BCB.quest_desc: [
		"The &aBotanist Workbench&r allows you to transform plant-based blocks into many decorative variants."
		"Use it to create beautiful gardens and natural decorations."
	]
	quest.1C48D11547020BCB.quest_subtitle: "Shape nature"
	quest.1C4DB2C1CCA72180.quest_desc: ["&dPaladin&r Sword is a powerful weapon from Crystal Chronicles, created for the Paladin equipment line. It is &bassociated&r with the Holy magic of the Paladin Armor and is forged using the power of Divinite."]
	quest.1C4DB2C1CCA72180.quest_subtitle: "A sacred blade forged with the power of Divine energy"
	quest.1C4DBE7D26171AB4.quest_desc: ["&6Craft&r a Basin, one of the core processing blocks in Create. Basins hold items and fluids and are &bused&r together with &bmachines&r such as the Mechanical Mixer and Mechanical Press for Mixing, Packing, and Compacting recipes. They are especially important for advanced Create automation, including the &bproduction&r of Brass."]
	quest.1C4DBE7D26171AB4.quest_subtitle: "The heart of Create's processing systems"
	quest.1C524ED3FAF4A6AF.quest_subtitle: "More Armor"
	quest.1C6A7425F0A77464.quest_desc: [
		"&aCongratulations!&r"
		"You have completed all the quests in the Tutorial tab!"
		"Now you know the basics of the modpack, its mechanics, quests, and all useful features."
		"You can confidently move forward and explore the world using the knowledge you’ve gained."
		"Remember, you can always return to the tutorial if you want to refresh your skills."
	]
	quest.1C6A7425F0A77464.quest_subtitle: "Read This First!"
	quest.1C6A7425F0A77464.title: "&aComplete"
	quest.1C7BA20EE982F192.quest_desc: ["&6Toggles&r &belectricity&r with a kinetic input, so you can control it with Create machines."]
	quest.1C7BA20EE982F192.quest_subtitle: "A mechanical switch"
	quest.1C86202A43DC49D0.quest_subtitle: "Yummy!"
	quest.1C949DCB8C31C404.quest_desc: ["&6The&r Hydraulic Press brings powerful hydraulic &bprocessing&r to your factory. Use it to compact and process materials in ways &bbeyond&r the standard Create machinery. Build the press and &bunlock&r a new method of industrial processing."]
	quest.1C949DCB8C31C404.quest_subtitle: "Crush, compact and process"
	quest.1C9859ACCF9D8E58.quest_desc: ["&6Craft&r the Slime Cake, a fun food item from Create: Misc \\& Things. It was introduced as a replacement for the mod's former Slime Porridge, giving your factory a rather unusual dessert to &bproduce&r and enjoy."]
	quest.1C9859ACCF9D8E58.quest_subtitle: "A cake with a sticky surprise"
	quest.1CB99ED122C09615.quest_desc: [
		"&aDeep&r within the Nether, a terrifying creation of fire and metal awaits. The Netherite Monstrosity is a colossal being, born from ancient power and destruction. Its immense strength and devastating attacks&b make&r it one of the most dangerous foes you will ever face."
		""
		"&aPrepare&r yourself with the strongest armor, powerful weapons, and plenty of resources before challenging this beast. Only the most skilled warriors can hope to defeat it and claim victory."
	]
	quest.1CB99ED122C09615.quest_subtitle: "Defeat the giant of the Nether"
	quest.1CB99ED122C09615.title: "&l&cNetherite &6Monst&erosity"
	quest.1CC1AAF97A5660CE.quest_desc: ["&6Prepare&r a Pumpkin Milkshake and fill a bucket with it. Add this seasonal treat to your &bcollection&r of milkshakes and bring a little autumn flavor to your factory."]
	quest.1CC1AAF97A5660CE.quest_subtitle: "A taste of autumn in every sip"
	quest.1CDFDF05ED708612.quest_desc: [
		"&dAbyssal&r Crystal Shard is a rare upgrade material from Crystal Chronicles. It is used to &bupgrade&r the Shadow Walker Armor from Iron’s Spells ’n Spellbooks into the powerful Voidwalker Armor set."
		""
		"The shard &bchannels&r the power of the Abyss, infusing the original Shadow Walker equipment with dark crystalline energy. It is also used in the &bcreation&r of Void Ripper and Void's Grasp, weapons associated with the &benhanced&r Voidwalker equipment."
	]
	quest.1CDFDF05ED708612.quest_subtitle: "A dark crystal shard used to empower Shadow Walker equipment"
	quest.1CEB242A4864FFF7.quest_desc: [
		"&dThe&r Codex of Malice is a powerful Ice spellbook from Cataclysm: Spellbooks. It provides &b12&r spell slots, &b+30%&r Ice Spell Power and &b+300&r Max Mana."
		""
		"This sinister tome is made for &bspellcasters&r who want to push the destructive potential of Ice magic to its limits."
	]
	quest.1CEB242A4864FFF7.quest_subtitle: "Unleash the merciless power of frost"
	quest.1CF8EA752412335C.quest_desc: [
		"&dPyrium&r Staff is a powerful Fire staff in Iron's Spells 'n Spellbooks. When held in the main hand, it provides &b9&r Attack Damage, &b1.5&r Attack Speed, &b+15%&r Fire Spell Power, &b+10%&r Cast Time Reduction and &b+5%&r Spell Power."
		""
		"It is &bcrafted&r from 2 Pyrium Ingots, 1 Arcane Cloth and 1 Netherite Ingot."
	]
	quest.1CF8EA752412335C.quest_subtitle: "Wield the blazing power of Pyrium"
	quest.1D0B0A6FA4D976C9.quest_desc: [
		"&6Combine&r the industrial strength of Locometal with the distinctive look of copper. Copper Wrapped Locometal adds a refined metallic finish to your railway builds, making it perfect for locomotives, train cars and &bdetailed&r industrial structures."
		""
		"&bGive&r your train a touch of copper and make its design stand out."
	]
	quest.1D0B0A6FA4D976C9.quest_subtitle: "A rugged metal frame wrapped in polished copper."
	quest.1D15663F0B922976.quest_desc: ["&6The&r Reactor Glass is a transparent structural &bcomponent&r used when building a reactor in Create: New Age. It lets you keep the reactor &bvisible&r while maintaining the structure needed for &badvanced&r nuclear power generation."]
	quest.1D15663F0B922976.quest_subtitle: "Keep an eye on the core"
	quest.1D229A418DC6618C.quest_desc: [
		"&dEpic&r Ink is the fourth tier of magical ink in Iron's Spells 'n Spellbooks. It is used in the Scroll Forge to create &bEpic-rarity&r spell scrolls and for &bupgrading&r spells that require Epic Ink."
		""
		"This rare magical substance can be found in magic structures or &bobtained&r from powerful magical creatures."
	]
	quest.1D229A418DC6618C.quest_subtitle: "The essence of truly powerful magic"
	quest.1D229A418DC6618C.title: "&dEpic Ink"
	quest.1D34976E848CAAE7.quest_desc: [
		"&aObtain&r the Netherite Upgrade Smithing Template, the vanilla template also required by several late-game Better End recipes."
		""
		"It's needed alongside &bAeternium&r materials when forging some of the mod's strongest tools and weapons."
	]
	quest.1D34976E848CAAE7.quest_subtitle: "A familiar template, reused"
	quest.1D35D45AC3394DE1.quest_desc: ["&6Welcome&r to Create: Garnished! This Create addon expands your world with nine types of nuts, new trees, plants, foods, decorative blocks, and &badditional&r processing possibilities. Explore the world, gather ingredients, and automate your way from simple nuts to advanced Hadean variants with &bunique&r effects."]
	quest.1D35D45AC3394DE1.quest_subtitle: "  A feast of nuts and new ingredients"
	quest.1D35D45AC3394DE1.title: "&l&6Welcome Create Garnished"
	quest.1D5790D49EC30F25.quest_subtitle: "More Armor"
	quest.1D681F9FB5C22548.quest_desc: ["&aObtain&r Soul Render from the Cataclysm mod. This &bpowerful&r Cursium &bweapon&r is part of the end-game arsenal and &buses&r special soul-based attacks to strike enemies. Master this weapon to unleash its &bdestructive&r abilities."]
	quest.1D681F9FB5C22548.quest_subtitle: "A cursed blade of lost souls"
	quest.1D681F9FB5C22548.title: "&bSoul Render"
	quest.1D6D7790CF362359.quest_desc: [
		"The Amaramber Sickle is a &aharvesting&r tool from Eternal Starlight introduced in version 0.4.2 as part of the Amaramber &bequipment&r set."
		""
		"&aIt&r is used for efficiently gathering plants and &bvegetation&r in the Starlight dimension."
	]
	quest.1D6D7790CF362359.quest_subtitle: "Amber harvesting tool"
	quest.1D70602283A47145.quest_desc: ["&aCraft&r Cursium Boots from the Cataclysm mod. These &bpowerful&r boots are created by &bupgrading&r Netherite Boots with a Cursium Upgrade Smithing Template and a Cursium Ingot in a Smithing Table. They are &bpart&r of the Cursium armor set and grant the Ghostly &bWeightless&r ability, reducing fall damage and allowing a quick backdash ability."]
	quest.1D70602283A47145.quest_subtitle: "Move like a ghost of the abyss"
	quest.1D70C8CD5B8C7C41.quest_desc: [
		"&dNature&r Upgrade Orb is an upgrade material in Iron's Spells 'n Spellbooks. When applied at the Arcane Anvil, it grants &b+5%&r Nature Spell Power."
		""
		"It is &bcrafted&r from 1 Empty Upgrade Orb and 8 Nature Runes."
	]
	quest.1D70C8CD5B8C7C41.quest_subtitle: "Infuse your equipment with the power of Nature magic"
	quest.1D7DA6D04AF37CF3.quest_subtitle: "More Weapon"
	quest.1D84A1C6F75DDDA0.quest_desc: ["&6Welcome&r to Create: Dreams n' Desires! This addon brings together a &bcollection&r of new features, useful additions, and ideas &binspired&r by both old and new versions of Create. Explore new materials, blocks, recipes, and mechanics that expand your factory in unexpected ways."]
	quest.1D84A1C6F75DDDA0.quest_subtitle: "        Rediscover the forgotten creations             "
	quest.1D84A1C6F75DDDA0.title: "&l&6Welcome Create Dreams 'n Desires"
	quest.1D9564F2B67A4492.quest_desc: ["&6Obtain&r a Water Wheel from Create. When water flows around it, the wheel generates &brotational&r power, making it one of the simplest automatic power sources available early in Create. A standard Water Wheel produces &b8&r RPM and &b256&r SU of stress capacity."]
	quest.1D9564F2B67A4492.quest_subtitle: "Harness the power of flowing water"
	quest.1D971010A5D83B2A.quest_desc: [
		"&dThe&r Dragonskin Spell Book is the legendary spellbook dedicated to Ender magic. It provides &b12&r spell slots, &b+10%&r Ender Spell Power and &b+200&r Max Mana, making it a powerful &bchoice&r for spellcasters who specialize in Ender magic."
		""
		"Craft this powerful tome from Dragonskin &bobtained&r from the Ender Dragon and unlock the full potential of Ender spells."
	]
	quest.1D971010A5D83B2A.quest_subtitle: "Master the mysterious power of the End"
	quest.1DACD5972C6D4323.quest_subtitle: "Upgrade+"
	quest.1DB6458252560C0D.quest_desc: [
		"&aCraft&r the Yeti Jacket &busing&r the thick fur of the Alpha Yeti. Woven from one of the warmest materials in the Twilight Forest, this sturdy &bchestpiece&r provides exceptional protection while shielding its wearer from the &brelentless&r cold of the Glacier."
		""
		"&aAs&r the centerpiece of the Yeti Armor set, the jacket &bsymbolizes&r your victory over the Alpha Yeti and your ability to survive the harshest frozen environments. Its &benchanted&r fur retains heat &beven&r in the coldest climates, preparing you for the final trials that lie ahead."
	]
	quest.1DB6458252560C0D.quest_subtitle: "Wrapped in the warmth of the Glacier"
	quest.1DBE2B6695831DFF.quest_desc: ["&dEvoker's&r Twinblade is a weapon from Crystal Chronicles, associated with the Battle-Evoker equipment set. It channels the power of Evocation magic and &bcomplements&r the enhanced Archevoker &bequipment&r upgraded with Avaricite."]
	quest.1DBE2B6695831DFF.quest_subtitle: "A dual-bladed weapon infused with the power of Evocation"
	quest.1DC2B930AF7DC2DC.quest_desc: ["&6Turns&r the panels toward the sun and collects their output on its terminals. Place panels in front of the bearing and click to assemble. On its side you choose the layout: strings in &bparallel&r and panels per string (max 25 per string). More panels per string gives more &bvoltage&r, more strings gives more current."]
	quest.1DC2B930AF7DC2DC.quest_subtitle: "Tracks the sun"
	quest.1DC970C582A4E7FB.quest_desc: [
		"&aBeyond&r the normal world lies an &bancient&r dimension untouched by time — the Twilight Forest. Covered in eternal twilight, massive forests, forgotten ruins, and powerful creatures, this realm is filled with &bsecrets&r waiting to be uncovered."
		""
		"&aTo&r begin the journey, a magical portal must be created using nature itself. Once activated, it opens the path &bto&r one of the greatest &aadventure&r dimensions ever discovered."
	]
	quest.1DC970C582A4E7FB.quest_subtitle: "A portal to the eternal twilight"
	quest.1DC970C582A4E7FB.title: "&l&6The Twilight Forest&r"
	quest.1DCE04DB6C0EEF46.quest_desc: [
		"&aCraft&r the Knightmetal Helmet &busing&r refined Knightmetal Ingots forged from the legendary alloy of the Goblin Stronghold. Once worn by the fortress' fearless guardians, this helmet was designed to &bendure&r countless battles while &bprotecting&r its wearer from even the fiercest attacks."
		""
		"&aAs&r part of the Knightmetal Armor set, the helmet &brepresents&r the resilience and discipline of the ancient knights. Its reinforced &bconstruction&r and masterful craftsmanship make it an essential piece of equipment for any adventurer preparing to face the greatest dangers &bhidden&r within the Twilight Forest."
	]
	quest.1DCE04DB6C0EEF46.quest_subtitle: "The gaze of an ancient protector"
	quest.1DD6531D84052AB9.quest_desc: [
		"The Aeternium Helmet is crafted by upgrading a Terminite Helmet with an &aAeternium&r Forged Plate at a Smithing Table."
		""
		"As Better End's top-tier armor, it offers the best &bprotection&r in the mod, surpassing even Netherite."
	]
	quest.1DD6531D84052AB9.quest_subtitle: "Headgear of the strongest tier"
	quest.1DD72F4EDD4851D7.quest_desc: ["&aDefeat&r 5 Guardians. These hostile underwater mobs &bprotect&r Ocean Monuments and attack &bintruders&r with their laser beam. They drop Prismarine Shards, Prismarine Crystals, and raw fish."]
	quest.1DD72F4EDD4851D7.quest_subtitle: "Defend the ocean monument"
	quest.1DD72F4EDD4851D7.title: "Kill Guardian"
	quest.1DD88B8F1770755D.title: "You don't have the mental toughness"
	quest.1DF07E95DDAC558B.quest_desc: ["&aObtain&r the Excelsius Velocity Chestplate, Excelsius Adversary Chestplate, and Excelsius Oppressor Chestplate. Collect all three &bspecialized&r chestplates and &bcomplete&r another part of the Excelsius arsenal."]
	quest.1DF07E95DDAC558B.quest_subtitle: "Three armors, one path to power"
	quest.1DF1409120127162.quest_subtitle: "More Weapon"
	quest.1E0701BC18C2B6AD.quest_desc: ["&aFind&r the Amethyst Nest hidden within the Overworld. &bDeep&r inside lies the lair of the Amethyst Crab, a dangerous creature &bsurrounded&r by the power of amethyst. Locate its nest and prepare yourself &bfor&r the fight that awaits within."]
	quest.1E0701BC18C2B6AD.quest_subtitle: "Enter the lair of the crystal beast"
	quest.1E0701BC18C2B6AD.title: "&l&dAmethyst Nest"
	quest.1E0E8DFD39A68077.quest_desc: [
		"The Thallasium Forged Plate is crafted from a Thallasium Ingot at an Anvil using a Smith Hammer."
		""
		"Combined at a Smithing Table, it's used to assemble a full set of &aThallasium&r armor."
	]
	quest.1E0E8DFD39A68077.quest_subtitle: "Plating for Thallasium armor"
	quest.1E139593EB6DB93A.quest_desc: ["&aCraft&r the Ignitium Boots from the Cataclysm mod. Forged from the &blegendary&r Ignitium metal, these boots provide exceptional protection and allow their wearer to endure the dangers of the Nether. They are part of the powerful Ignitium armor set &bcreated&r from the remains of the &bLord&r of Fire."]
	quest.1E139593EB6DB93A.quest_subtitle: "Walk through the flames unbroken"
	quest.1E1AD9C05DD1A094.quest_desc: [
		"&dPyromancer&r Chestplate is the Crystal Chronicles upgraded version of the Pyromancer Chestplate from Iron’s Spells ’n Spellbooks."
		""
		"It is upgraded &busing&r a Volcanite Shard, which enhances the original Pyromancer Armor with additional crystalline power. The Volcanite Shard is &bused&r to upgrade the Iron’s Spells ’n Spellbooks Pyromancer Armor set into its Crystal Chronicles version."
	]
	quest.1E1AD9C05DD1A094.quest_subtitle: "An enhanced Pyromancer chestplate empowered by Volcanite"
	quest.1E1BCEA796C71DF8.quest_desc: ["&6The&r Experience Pickaxe is a special pickaxe from Create Stuff 'N Additions. When mining blocks, it has a chance to &bgenerate&r an Experience Orb, giving you additional experience while you work. It has 270 durability, an Iron mining level, 5 attack damage and 2.0 attack speed. It is crafted using 3 Heaps of &bExperience&r and 2 Zinc Tool Handles."]
	quest.1E1BCEA796C71DF8.quest_subtitle: "Mine your way to more experience"
	quest.1E209817FAB1FB06.quest_subtitle: "More Armor"
	quest.1E4B6AF851790D25.quest_desc: [
		"&aThe&r Starfire Hoe is a farming tool from Eternal Starlight, belonging to the Starfire &bequipment&r tier."
		""
		"&aIt&r is &bused&r for tilling soil and is part of the late-game Starfire tool set introduced in the mod."
	]
	quest.1E4B6AF851790D25.quest_subtitle: "Starlight farming tool"
	quest.1E6008069991B063.quest_desc: ["&dImproves&r your gun's &breload&r speed, so you spend less time with an empty magazine."]
	quest.1E6008069991B063.quest_subtitle: "Smooth action"
	quest.1E692E7FDC4BC436.quest_desc: ["&6The&r Mechanical Saw is a powerful cutting tool that uses rotational power to &bprocess&r materials and cut blocks. &bIt&r can perform many cutting recipes, including turning logs into planks and &bprocessing&r other materials. When attached to a moving Contraption, the saw can destroy suitable blocks and damage entities depending on the Contraption's speed, making it useful for automated &btree&r farms and other harvesting machines."]
	quest.1E692E7FDC4BC436.quest_subtitle: "Cut through anything in your way"
	quest.1E7200DC136FD7C4.quest_subtitle: "More Weapon"
	quest.1E916C61E5DE6AD3.title: ",,,"
	quest.1E91AFA0368460D9.quest_desc: [
		"&l&9Why&r&r stop to smelt your ores when your backpack can do it for you? The Smelting Upgrade adds a furnace directly to your backpack, allowing you to smelt items without placing one in the world. It still &brequires&r you to provide the fuel and manage the input and output yourself."
		""
		"Upgrade it to &bAuto-Smelting&r Upgrade and let your backpack handle everything automatically. It pulls in suitable items and fuel from the backpack and &bsends&r the finished products back into storage."
	]
	quest.1E91AFA0368460D9.quest_subtitle: "Turn your backpack into a furnace"
	quest.1E91AFA0368460D9.title: "Smelting \\& Auto-Smelting Upgrade"
	quest.1E94908B4E9FBA01.quest_desc: ["&6Lets&r &bcurrent&r flow in one direction only, so it protects a circuit from reverse current."]
	quest.1E94908B4E9FBA01.quest_subtitle: "A diode"
	quest.1EDD9DE31C9F29FE.quest_desc: ["&dA&r special Charm that &bgrants&r the wearer a powerful bonus."]
	quest.1EDD9DE31C9F29FE.quest_subtitle: "A prestigious charm of the Tribune"
	quest.1EEB30E456BBFD09.quest_desc: ["&aObtain&r Ceraunus, a powerful weapon from the Acropolis arsenal in L_Ender’s Cataclysm. Ceraunus is a massive anchor with &b16&r Attack Damage that can be thrown at enemies. While sneaking, it &bunleashes&r waves in a fan-shaped pattern. It is crafted using 2 Essence of the Storm and 3 Lacrima."]
	quest.1EEB30E456BBFD09.quest_subtitle: "Wield the fury of the storm"
	quest.1EEB30E456BBFD09.title: "&bCeraunus"
	quest.1EF8C927AACD9472.quest_subtitle: "Upgrade+"
	quest.1EFFE16C3E85DBCC.quest_desc: [
		"&9&lGive&r&r your storage the power of a blast furnace with the Blasting Upgrade. It allows compatible items to be processed &busing&r blast furnace recipes directly from your storage."
		""
		"&bUpgrade&r it further with the Auto-Blasting Upgrade to automate the entire process. Your storage can handle the input, fuel and finished &bproducts&r automatically, making large-scale processing faster and more convenient."
	]
	quest.1EFFE16C3E85DBCC.quest_subtitle: "Process materials at blazing speed"
	quest.1EFFE16C3E85DBCC.title: "Blasting \\& Auto-Blasting Upgrade"
	quest.1F010A331D33EB74.quest_desc: ["&6Craft&r the Diapason pipe and add one of the defining voices of a pipe organ to your instrument. The Diapason provides a strong, &bcharacteristic&r organ tone and is one of the core pipe stops available in Create: Sound of Steam."]
	quest.1F010A331D33EB74.quest_subtitle: "Give your organ its classic voice"
	quest.1F2444EB90AF2586.quest_desc: [
		"&aThe&r Starlit Diamond Chestplate is a high-tier armor piece from Eternal Starlight crafted &busing&r Starlit Diamonds."
		""
		"Starlit Diamond armor &aprovides&r protection comparable to Netherite while greatly increasing armor &btoughness&r and knockback resistance."
	]
	quest.1F2444EB90AF2586.quest_subtitle: "Celestial diamond body armor"
	quest.1F3816FACF9A8217.quest_desc: ["&dThe&r Heavy Chain is a necklace from Iron's Spells 'n Spellbooks that grants &b+15%&r Spell Resistance when equipped. Strengthen your defenses &bagainst&r hostile magic and become harder to &boverwhelm&r with enemy spells."]
	quest.1F3816FACF9A8217.quest_subtitle: "Stand strong against magical attacks"
	quest.1F5166D0102CAFC4.quest_desc: ["&6Obtain&r Cardboard Leggings from Create. They are part of the Cardboard Armor set and provide &b1&r armor point with 60 durability. When the &bcomplete&r set is worn and you sneak, you disguise yourself as a Cardboard Package, reducing the distance at which hostile mobs can &bdetect&r you."]
	quest.1F5166D0102CAFC4.quest_subtitle: "Complete the cardboard disguise"
	quest.1F5A077DC4F4FB7D.quest_subtitle: "More Armor"
	quest.1F6A03365EB7328B.quest_desc: [
		"&dMithril&r Scrap is a Rare crafting material in Iron's Spells 'n Spellbooks. It is obtained by blasting Raw Mithril and is &bused&r to craft Mithril Ingots and other &bpowerful&r mithril equipment."
		""
		"Mithril Scrap is an important step in the mithril progression, leading to some of the strongest magical &bequipment&r in the mod."
	]
	quest.1F6A03365EB7328B.quest_subtitle: "Refined fragments of legendary mithril"
	quest.1FA0021D2BBC3A9B.quest_desc: ["&6Obtain&r both the Speedometer and Stressometer from Create. The Speedometer measures the rotation speed of a kinetic system in &bRPM&r, while the Stressometer measures the system's &bKinetic Stress&r and available stress capacity. Together, they let you monitor whether your machinery is running at the right speed and whether your network is close to &bbecoming&r overstressed."]
	quest.1FA0021D2BBC3A9B.quest_subtitle: "Measure the power of your machines"
	quest.1FA0021D2BBC3A9B.title: "Speed/Stressometr"
	quest.1FA0CDB67BA1996F.quest_desc: ["&6Obtain&r an Andesite Funnel from Create. It is a basic item-transport &bcomponent&r used to move &bitems&r between inventories, Depots, and Mechanical Belts. &bIts&r direction can be adjusted with a Wrench, making it &buseful&r for controlling the flow of items through your factory."]
	quest.1FA0CDB67BA1996F.quest_subtitle: "Keep the items moving"
	quest.1FA13272B5A06A5F.quest_subtitle: "More Armor"
	quest.1FA2DCC92F14D525.quest_subtitle: "Upgrade+"
	quest.1FAF3113F25BC7C2.quest_desc: [
		"&aThe&r Flowglaze Scythe is a melee weapon from Eternal Starlight, belonging to the Flowglaze &bequipment&r tier."
		""
		"&aIt&r is designed for sweeping attacks and enhanced melee reach, forming part of the mid-to-late game &bweapon&r progression."
	]
	quest.1FAF3113F25BC7C2.quest_subtitle: "Flow reaping weapon"
	quest.1FBF1655BB9244A9.quest_subtitle: "Upgrade+"
	quest.1FCF06D2175FE302.title: "No problem"
	quest.1FFF06B304141346.title: "Bro"
	quest.20168D86B69961B4.quest_desc: [
		"&dCryomancer&r Boots are the Crystal Chronicles &bupgraded&r version of the Cryomancer Boots from Iron’s Spells ’n Spellbooks."
		""
		"They are upgraded using a Cryolite Shard, which &benhances&r the original Cryomancer Armor set with &badditional&r crystalline power. The Cryolite Shard strengthens the equipment with the power of Ice magic, &bcreating&r an improved version of the original Cryomancer gear."
	]
	quest.20168D86B69961B4.quest_subtitle: "An enhanced form of Cryomancer Boots, empowered by Cryolite"
	quest.2018043C0CE539B3.quest_desc: ["&aCraft&r a Black Steel Sword from the Cataclysm mod. This &bpowerful&r weapon is made &busing&r Black Steel and is designed to deal heavy damage against dangerous enemies. It is part of the Black Steel &bequipment&r set."]
	quest.2018043C0CE539B3.quest_subtitle: "A blade forged from black steel"
	quest.202D0805BE78404E.quest_desc: ["&6Obtain&r a Blaze Cake from Create. It is &bused&r to temporarily turn a Blaze Burner into its Super-Heated state, allowing the most demanding Basin recipes to be performed. A Blaze Cake is made by filling a Blaze Cake Base with &b250&r mB of Lava using a Spout. The Blaze Cake Base is &bcreated&r by compacting Egg, Sugar, and Cinder Flour."]
	quest.202D0805BE78404E.quest_subtitle: "Feed the flames of superheating"
	quest.2034876CE576F3FE.quest_subtitle: "More Armor"
	quest.2045C43F8B6916CB.quest_desc: [
		"&aCraft&r the Yeti Leggings &busing&r the thick fur of the Alpha Yeti. Woven from one of the warmest materials found in the Twilight Forest, these leggings offer &bexceptional&r protection while shielding their &bwearer&r from the relentless cold of the Glacier."
		""
		"&aAs&r an essential part of the Yeti Armor set, they provide the durability needed to survive the frozen &bwilderness&r and face the powerful creatures that dwell within it. Their enchanted fur preserves warmth even in the &bharshest&r conditions, ensuring you're always ready for the next challenge."
	]
	quest.2045C43F8B6916CB.quest_subtitle: "Endure the endless winter"
	quest.2065BE744E37E2A4.quest_desc: ["&6Craft&r a Ruby Chocolate Glazed Marshmallow by coating a soft marshmallow with Ruby Chocolate. It is one of the chocolate-glazed marshmallow variants &badded&r by Create: Confectionery, alongside dark and white chocolate versions."]
	quest.2065BE744E37E2A4.quest_subtitle: "A fluffy treat with a fruity ruby coating"
	quest.209857F6F9627A0E.quest_desc: ["&6Obtain&r a Threshold Switch from Create. It monitors how full an &binventory&r or fluid container is and emits a Redstone signal when configurable thresholds are reached. It also supports filtering, &ballowing&r you to monitor only specific items. This makes it useful for automatically stopping or starting machines when storage &breaches&r a chosen level."]
	quest.209857F6F9627A0E.quest_subtitle: "Control your factory by its limits"
	quest.209C02664C1D975B.quest_desc: ["&6Obtain&r a Rotation Speed Controller from Create. It provides &bprecise&r control over rotational speed and direction. When &bpaired&r with a Large Cogwheel, it can output a chosen rotation speed of up to &b256&r RPM in either direction, making it ideal for machines that require specific operating speeds."]
	quest.209C02664C1D975B.quest_subtitle: "Take precise control of rotation"
	quest.20BB591B2BF2A6DD.quest_desc: ["&6Obtain&r a Fluid Pipe from Create. Fluid Pipes transport liquids between tanks, machines, and other fluid-handling components. &bThey&r can carry only one type of fluid at a time, while Mechanical Pumps provide the force &bneeded&r to move fluids through the network. Pipes can also be converted into Windowed Fluid Pipes with a Wrench to &bobserve&r the fluid flowing inside."]
	quest.20BB591B2BF2A6DD.quest_subtitle: "The lifelines of your fluid network"
	quest.20BB591B2BF2A6DD.title: "Fluid Pipe"
	quest.20C6B1D1C1D8708D.quest_desc: [
		"&eTasks&r are actions you must complete to finish a quest."
		"If a task involves an item, clicking on it will display its recipe."
		"                                                                                           &cRewards&r can be claimed after completing all tasks — simply click to collect them."
		"                                                                                                  The pin icon in the top-right corner allows you to pin the &6quest&r to your screen."
	]
	quest.20C6B1D1C1D8708D.quest_subtitle: "Read This First!"
	quest.20C6B1D1C1D8708D.title: "&6FTB Quest"
	quest.20CF892CE03107AB.quest_subtitle: "More Armor"
	quest.20D12EB2551F7E26.quest_desc: ["&aObtain&r the Hellfire Forge from the Cataclysm: Spellbooks addon. This &blegendary&r magical weapon channels the &bdestructive&r power of infernal fire, allowing its wielder to unleash &bdevastating&r attacks fueled by the flames of the Nether. It was introduced as one of the newest relics in the addon alongside other endgame weapons."]
	quest.20D12EB2551F7E26.quest_subtitle: "Forge with the flames of the underworld"
	quest.20D12EB2551F7E26.title: "&6Hellfire &cForge"
	quest.20E897D283D7016D.title: "Villager PRO"
	quest.20F65C0D555D07F0.quest_desc: ["&6Prepare&r a smooth Vanilla Milkshake and add another &bclassic&r drink to your factory's food production. Combine the required ingredients and let Create: Dreams n' Desires &bhandle&r the mixing."]
	quest.20F65C0D555D07F0.quest_subtitle: "A timeless taste, freshly mixed"
	quest.20F767F224E2990E.quest_desc: [
		"&aThe&r Amaramber Mask is an armor piece from Eternal Starlight, crafted using Amaramber &bmaterials&r."
		""
		"&aIt&r is part of the Amaramber equipment &bprogression&r and serves as protective headgear."
	]
	quest.20F767F224E2990E.quest_subtitle: "Amber-forged headgear"
	quest.212129109C5F6E52.quest_desc: ["&aObtain&r a Fishing Line from Aquaculture 2. This component is &bused&r when crafting and upgrading fishing rods. Combine it with other fishing parts to create &bstronger&r and more advanced fishing equipment."]
	quest.212129109C5F6E52.quest_subtitle: "Essential fishing equipment"
	quest.2144EF088C0E18C0.quest_desc: [
		"Deep underground you may discover mysterious structures known as Trial Chambers."
		"Inside these dangerous halls, powerful mobs spawn from special trial spawners."
		""
		"If you survive the challenge, you will receive a Trial Key."
		"These keys can be used to open special vaults inside the chambers and claim valuable rewards."
		""
		"Defeat the enemies, complete the trial, and collect a &aTrial Key&r."
	]
	quest.2144EF088C0E18C0.quest_subtitle: "Rewards of the Chambers"
	quest.2144EF088C0E18C0.title: "Trial Keys"
	quest.215D6E89BAFD51E5.quest_desc: ["&6Prismarine&r Shards are an important resource in Create: Aquatic Ambitions. With Conduit Channeling, you can &bobtain&r Prismarine Shards from Flint, giving you a renewable way to produce Prismarine &bwithout&r relying on Guardians. This is one of the first &bsteps&r toward fully automating aquatic resources."]
	quest.215D6E89BAFD51E5.quest_subtitle: "Harness the ocean's resources"
	quest.215D8172E77FB95D.quest_desc: ["&6Create&r the three essential spool types from Create Crafts \\& Additions: Empty Spool, Copper Spool and Gold Spool. The Empty Spool is the base component &bused&r to create wired spools. Copper and Gold Spools can connect Connectors and transfer electrical energy between them. Copper Spools use &b4&r Copper Wires, while Gold Spools use &b4&r Gold Wires."]
	quest.215D8172E77FB95D.quest_subtitle: "Connect your electrical network"
	quest.2162C4558E290071.quest_desc: ["&6The&r Electric Motor is the counterpart to the Alternator in Create Crafts \\& Additions. It converts Forge Energy &b(FE)&r into rotational power, allowing electricity to &bdrive&r Create machinery. The motor can be configured to different RPM values, with higher speeds requiring more FE. It can generate up to &b2048&r SU of rotational force."]
	quest.2162C4558E290071.quest_subtitle: "Turn electricity into kinetic power"
	quest.218293AC8BB043AD.quest_desc: ["&6Obtain&r a Copper Backtank from Create. It stores pressurized air and can be &bfilled&r by applying &brotational&r force to the shaft on top of the tank. When worn together with a Diving Helmet, it provides Water Breathing underwater. It also &bpowers&r the Extendo Grip and Potato Cannon without &bconsuming&r their durability while the Backtank has air."]
	quest.218293AC8BB043AD.quest_subtitle: "Fill your lungs with pressurized air"
	quest.219496E39E637D9B.quest_subtitle: "Yummy!"
	quest.21AF2B7914DD5F83.quest_subtitle: "More Weapon"
	quest.21C32068BFCE19E5.quest_desc: [
		"The &atrees&r of the Torreya Forest in Eternal Starlight produce a unique type of wood known as Torreya Logs."
		"This material carries the essence of the ancient forest and can be &bused&r for crafting and building within the dimension."
		""
		"Collecting it marks your progress in &aexploring&r and utilizing the resources of this biome."
	]
	quest.21C32068BFCE19E5.quest_subtitle: "Ancient wood"
	quest.21C32068BFCE19E5.title: "Torreya Wood"
	quest.21E3EE5B89C198E0.title: "He?"
	quest.21F0D3F2645EFD91.quest_desc: ["&6A&r saw for wood. Powered by a Portable Battery it uses no durability, only energy, and with enough &bpower&r Shift harvests whole trees at once. An integrated circuit &bboosts&r it for a limited number of uses."]
	quest.21F0D3F2645EFD91.quest_subtitle: "A handheld saw"
	quest.21F652F622125F5F.quest_desc: ["&aCraft&r the Cursium Mage Greaves from the Cataclysm: Spellbooks addon. Forged from the cursed power of Cursium, these &benchanted&r greaves are an essential part of the Cursium Mage armor set, empowering their wearer with the dark magic once wielded by the &brulers&r of the &bAncient&r Factory."]
	quest.21F652F622125F5F.quest_subtitle: "Stride with the power of forbidden magic"
	quest.21F96D90B841A6C5.quest_desc: ["&aObtain&r a Box from Aquaculture 2. These &bcontainers&r can be found as fishing loot and may contain various valuable items. Open them to discover what &btreasures&r are &bhidden&r inside."]
	quest.21F96D90B841A6C5.quest_subtitle: "A mysterious fishing reward"
	quest.21FB3B9C98364B40.title: "yyy okey"
	quest.221C62C2D659A065.quest_desc: [
		"&dPyrium&r Ingot is a rare crafting material in Iron's Spells 'n Spellbooks. It can be found in Citadel Vaults. It is &bused&r to craft powerful items such as the Pyrium Staff, and to &bupgrade&r the Decrepit Scythe into the Hellrazor and the Decrepit Flamberge into the Legionnaire Flamberge."
		""
		"Pyrium Ingots can also be blasted to produce 5 Ancient Debris, making them a valuable &blate-game&r resource."
	]
	quest.221C62C2D659A065.quest_subtitle: "Claim the fiery metal of the Citadel"
	quest.2220A3339D628B97.quest_desc: ["&6A&r larger version of the rotor for stronger generators."]
	quest.2220A3339D628B97.quest_subtitle: "A larger rotor"
	quest.22239400DAC93BF3.quest_subtitle: "Yummy!"
	quest.222FFF8D4D1510B0.quest_desc: ["&aCraft&r the Bone Reptile Chestplate from the Cataclysm mod. Made from Ancient Metal Ingots and Koboleton Bones, this durable chestplate offers &bexcellent&r protection and knockback resistance, making it a reliable &breward&r for conquering the Cursed Pyramid."]
	quest.222FFF8D4D1510B0.quest_subtitle: "Armor forged from ancient bones"
	quest.223560DA5BB4A890.quest_subtitle: "Yummy!"
	quest.224D0A91A04F405B.quest_desc: ["&6Switches&r &belectricity&r using a redstone signal. It must be placed on the arrow-indicated edge."]
	quest.224D0A91A04F405B.quest_subtitle: "A redstone-driven relay"
	quest.226D2FF47293880B.quest_desc: [
		"&dSimple&r Mechanical Components are the first tier of gun hardware. They are used for early guns like the Musket and Blunderbuss and for many &butility&r modifiers such as scopes and bayonets."
		""
		"&dThey&r also lead to the next tier of &bcomponents&r."
	]
	quest.226D2FF47293880B.quest_subtitle: "Small gears for simple machines"
	quest.227B24AA6CB80442.quest_desc: [
		"&aThe Brewing Stand&r is the core station for potion brewing."
		"It allows you to combine water bottles with Nether Wart and other ingredients to create powerful potions that enhance combat, survival, and exploration."
		"With it, you &bunlock&r the full potential of alchemy in &aMinecraft.&r"
	]
	quest.227B24AA6CB80442.quest_subtitle: "Begin your alchemy"
	quest.227B24AA6CB80442.title: "&eBrewing Stand"
	quest.22819151DE1C53E4.quest_desc: ["&6Find&r and grow White Grapes in plains and forest biomes. Harvest them from grape bushes and use them as an &bingredient&r for producing White Wine and other winery &bproducts&r with Create's machinery."]
	quest.22819151DE1C53E4.quest_subtitle: "Start your path to fine wine"
	quest.229362E5765C8C86.quest_desc: ["&6Obtain&r a Factory Gauge from Create. This advanced logistics component can monitor the stock of items connected to a logistics network and can also be &bconfigured&r to automatically request items &bwhen&r their supply falls below a chosen threshold. Factory Gauges were introduced in Create 6.0 and are crafted &busing&r a Stock Link and a Precision Mechanism."]
	quest.229362E5765C8C86.quest_subtitle: "See the heartbeat of your factory"
	quest.22A0552643425901.quest_desc: [
		"&aCraft&r the Yeti Horned Helm &busing&r the thick fur of the Alpha Yeti and the mighty horns of the frozen beast. This &bimposing&r helmet embodies the strength and resilience of the Glacier's ruler, protecting its wearer while &binspiring&r fear in anyone who dares to stand against them."
		""
		"&aAs&r part of the Yeti Armor set, the Horned Helm offers outstanding protection and exceptional resistance to the bitter cold. Its &biconic&r horns serve as a reminder that you have conquered one of the Twilight Forest's most &bformidable&r guardians."
	]
	quest.22A0552643425901.quest_subtitle: "Wear the crown of the frozen king"
	quest.22BB86C77127CF6D.quest_desc: [
		"&eApparently&r, even the most fearless adventurers have one thing creepers can't stand."
		""
		"Kitty Slippers make creepers &bavoid&r you and run away, keeping those explosive green nightmares at a safe distance. In newer &bversions&r of Artifacts, they can also repel phantoms."
		""
		"&bWalk&r softly. Make creepers run."
	]
	quest.22BB86C77127CF6D.quest_subtitle: "Creepers know better than to mess with cats"
	quest.22D172A234AF9AF2.quest_desc: [
		"&9&lExpand&r&r the operating range of compatible Refined Storage devices with the Range Upgrade. It increases the distance at which supported devices can &binteract&r with your network, giving you more &bfreedom&r when designing and expanding your setup."
		""
		"Install it in a &bcompatible&r device and connect parts of your system from farther away."
	]
	quest.22D172A234AF9AF2.quest_subtitle: "Extend the reach of your network"
	quest.22DEA311E61D3E11.quest_desc: ["Craft &awooden tools&r such as an axe, pickaxe, and shovel. They are essential for gathering resources, mining, and preparing for future challenges. Wooden tools are your first step into &beffective&r crafting and exploration."]
	quest.22DEA311E61D3E11.quest_subtitle: "Start your adventure with basic tools"
	quest.22DEA311E61D3E11.title: "&#6A3B1DWooden &#A56701Tools"
	quest.22E209AA4D7515BA.quest_desc: [
		"As &adarkness&r falls over the lands of Eternal Starlight, Nightfall Spiders emerge from the shadows."
		"These creatures are fast, aggressive, and strike when visibility is at its lowest, making them especially dangerous during exploration."
		""
		"Facing them is a &atrue&r test of your &bcombat&r awareness in this unfamiliar world."
	]
	quest.22E209AA4D7515BA.quest_subtitle: "Hunters in the dark"
	quest.22E209AA4D7515BA.title: "Nightfall Spiders"
	quest.2309D500FCA63C7C.quest_desc: [
		"Gold enhances your &btools&r with special properties."
		"These &btools&r are not always the &astrongest&r, but they provide speed and unique advantages in certain &bsituations&r."
	]
	quest.2309D500FCA63C7C.quest_subtitle: "Fast and flexible"
	quest.2309D500FCA63C7C.title: "Gold Netherite Tools"
	quest.230EB3AA5E23547E.quest_desc: [
		"The Deepsilver Axe is a &awoodcutting&r and combat tool from Eternal Starlight crafted &busing&r Deepsilver Ingots."
		""
		"&aIt&r is used in swamp and Nightfall progression areas, offering higher durability than iron-tier tools while maintaining early-mid game &bmining&r level."
	]
	quest.230EB3AA5E23547E.quest_subtitle: "Swamp silver woodcutting tool"
	quest.2316B46DBEF1DDF0.quest_desc: [
		"&aThe&r Moonring Bow is a ranged weapon &bobtained&r from the Lunar Monstrosity boss inside the Cursed Garden in Eternal Starlight."
		""
		"&aIt&r is part of the boss loot &bpool&r and is guaranteed to drop when defeating the encounter."
	]
	quest.2316B46DBEF1DDF0.quest_subtitle: "Boss reward weapon"
	quest.2316B46DBEF1DDF0.title: "&6Moonring Bow"
	quest.2329437E93F1E7F2.quest_desc: [
		"&aCraft&r the legendary Neptunium Fishing Rod, the ultimate masterpiece of aquatic craftsmanship. Forged from the &bmythical&r metal hidden within the oceans, this extraordinary rod offers unmatched &bdurability&r and performance, making it the finest fishing rod an angler could ever wield."
		""
		"&aOnly&r those who have &buncovered&r the sea's rarest treasures are capable of crafting such an incredible tool. With the Neptunium Fishing Rod in hand, every cast is another chance to discover &blegendary&r catches and priceless treasures hidden beneath the waves."
	]
	quest.2329437E93F1E7F2.quest_subtitle: "Command the treasures of the deep"
	quest.232DA339B30AF081.quest_desc: [
		"&aThe&r Starfire Smithing Template is a smithing template &badded&r in Eternal Starlight."
		""
		"&aIt&r is &bused&r in the smithing table to apply Starfire-style armor trims, and is also required in crafting recipes for certain Starfire-related weapons and gear in newer versions of the mod."
	]
	quest.232DA339B30AF081.quest_subtitle: "Smithing progression item"
	quest.232DA339B30AF081.title: "&cStarfire Smithing Template"
	quest.233B3916BF0DE57B.quest_desc: [
		"&aCraft&r the Naga Scale Leggings using the scales collected from the defeated Naga. Designed for agility as well as protection, these leggings are an essential part of the Naga Scale armor set and will prepare you for the increasingly dangerous &bfoes&r that await within the Twilight Forest."
		""
		"&aForged&r from the remains of the forest's ancient guardian, they symbolize your first true &bstep&r toward conquering the mysteries of the Twilight Forest."
	]
	quest.233B3916BF0DE57B.quest_subtitle: "Protection woven from ancient scales"
	quest.233D06FBEB8CB016.quest_subtitle: "More Armor"
	quest.235A8D449115DAF7.quest_desc: ["&aObtain&r the Monstrous Helm from the Cataclysm mod. Forged from the &bremains&r of terrifying monsters, this &blegendary&r helmet grants its wearer the resilience and ferocity of the beasts that once roamed the world. A true trophy for those who &bconquer&r Cataclysm's greatest horrors."]
	quest.235A8D449115DAF7.quest_subtitle: "Wear the visage of a beast"
	quest.235A8D449115DAF7.title: "&cMonstrous Helm"
	quest.236DC13478565F28.quest_desc: ["&aDefeat&r 3 The Prowlers from L_Ender’s Cataclysm. These deadly &bcreatures&r are among the &bdangerous&r enemies added by Cataclysm. Track them down and prove that you can survive the hunt."]
	quest.236DC13478565F28.quest_subtitle: "Hunt the beast beneath the shadows"
	quest.236DC13478565F28.title: "The Prowler"
	quest.23769B7230C8FD71.quest_subtitle: "More Armor"
	quest.2378F690AD6E0E90.quest_desc: ["&aDefeat&r Ignis from the Cataclysm mod. Awakened within the Burning Arena, this &blegendary&r warrior commands the &bflames&r of the Nether with unmatched strength. Face his relentless attacks, survive the inferno, and prove yourself worthy by &bdefeating&r one of Cataclysm's greatest bosses."]
	quest.2378F690AD6E0E90.quest_subtitle: "Defeat the Lord of Fire"
	quest.2378F690AD6E0E90.title: "&l&cIgnis"
	quest.2397334E78B34973.quest_subtitle: "More Armor"
	quest.23AEC7F684ADDBA7.quest_desc: ["&6Switches&r high currents with a lower control &bvoltage&r. You can stack contactors into a switchboard, and only one needs to be powered."]
	quest.23AEC7F684ADDBA7.quest_subtitle: "A heavy-duty relay"
	quest.23B8606952D7DD5D.quest_desc: ["&6Obtain&r a Weighted Ejector from Create. It acts like a powered launch platform, &ballowing&r you to set a target &blocation&r and throw items or entities in a ballistic arc toward it. The target can be configured by sneaking and &bright-clicking&r the desired block."]
	quest.23B8606952D7DD5D.quest_subtitle: "Launch your items across the factory"
	quest.23BD856DF5543797.quest_subtitle: "More Armor"
	quest.23C4625691B57CBE.quest_subtitle: "More Armor"
	quest.23CCCF0C41814172.quest_desc: ["&6The&r Roll Table is a mechanical processing machine from Create: Dreams n' Desires. Use rotational power to roll and process &bmaterials&r into new forms, expanding your factory's &bmanufacturing&r capabilities."]
	quest.23CCCF0C41814172.quest_subtitle: "Shape materials with precision"
	quest.23DDA40A29793507.quest_desc: [
		"The Thermal Springstone Pickaxe is a mining tool from Eternal Starlight &acrafted&r &busing&r Thermal Springstone Ingots."
		""
		"&aIt&r is &bused&r for mid-tier mining progression and is resistant to heat-based environments, making it suitable for geothermal &bregions&r of the Starlight dimension."
	]
	quest.23DDA40A29793507.quest_subtitle: "Geothermal mining tool"
	quest.23E3C6A88D284556.quest_desc: [
		"&aCraft&r a Redstone Hook, a unique fishing &bupgrade&r that combines the ingenuity of engineering with the patience of an angler. Infused with redstone technology, this specialized hook represents a new approach to fishing, &busing&r clever mechanisms to improve your equipment."
		""
		"&aAs&r you continue &bexploring&r rivers, lakes, and oceans, innovation becomes just as important as experience. The Redstone Hook &bproves&r that even fishing can benefit from the power of invention."
	]
	quest.23E3C6A88D284556.quest_subtitle: "Engineering meets the art of fishing"
	quest.23FD898AC15E9267.quest_subtitle: "More Weapon"
	quest.2407D02EF84A2980.quest_subtitle: "Upgrade+"
	quest.240FEA275A842E71.quest_desc: [
		"&dThe&r Ironbound Tome is the next step after the Flimsy Journal in the standard spellbook progression. It provides &b6&r spell slots, giving you more &broom&r for spells as you continue developing your magical arsenal."
		""
		"&bUpgrade&r your spellbook and prepare yourself for more powerful magic and higher-tier spellbooks."
	]
	quest.240FEA275A842E71.quest_subtitle: "Forge a stronger vessel for your growing spell collection"
	quest.241160A16D32AD91.quest_desc: ["&6Obtain&r a Rope Pulley from Create. Powered by rotational force, it moves &battached&r blocks and &bstructures&r vertically. With Linear Chassis, Radial Chassis, or Super Glue, it can move entire contraptions &binstead&r of just a single block. Its rope can also be climbed."]
	quest.241160A16D32AD91.quest_subtitle: "Reach the depths"
	quest.241265877320A08F.quest_desc: ["&dMechanical&r Components are the second tier of gun hardware. They let you build &brevolver&r-style guns like the Six-Shooter and Blackpowder Revolver, and are the stepping stone to Clockwork Components."]
	quest.241265877320A08F.quest_subtitle: "Better parts for better guns"
	quest.24258C14DAF156AE.quest_desc: ["&6Safely&r switches a high-&bpower&r load. To close it you must wind it up first, then toggle its state with a &bredstone&r pulse. It can be opened again without winding it up."]
	quest.24258C14DAF156AE.quest_subtitle: "A high-power breaker"
	quest.2443A0C7BBA034EF.quest_desc: [
		"&dCultist&r Leggings are part of the Cultist Armor set in Iron's Spells 'n Spellbooks. When worn, they provide &b+6&r Armor, &b+125&r Max Mana, &b+10%&r Blood Spell Power and &b+5%&r Spell Power."
		""
		"They can be &bcrafted&r by combining Wizard Leggings, 1 Blood Rune and 1 Arcane Essence, or upgraded using a Smithing Table in supported versions."
	]
	quest.2443A0C7BBA034EF.quest_subtitle: "Channel the dark power of Blood magic through your armor"
	quest.2444C798BB7B0F33.quest_desc: [
		"&aAlong&r your journey you have gathered coins, and now it is time to &bspend&r them. The merchant &bsells&r goods you will not find in any dungeon: runes, Celestisynth materials and armor, celestial netherite ingots, and grappling hooks."
		""
		"You pay in Magic Coins. The &brarer&r the item, the more coins it costs, so spend them wisely."
	]
	quest.2444C798BB7B0F33.quest_subtitle: "Everything has its price."
	quest.245589F3966479B0.quest_desc: [
		"&aObtain&r the Ender Shard, dropped by breaking Ender Ore found scattered throughout many End biomes."
		""
		"It's used to craft End Dust in an Anvil, and is a required ingredient for the &bEternal Crystal&r Infusion Ritual."
	]
	quest.245589F3966479B0.quest_subtitle: "Shard from the End's ore"
	quest.245AF94431CA55DB.quest_desc: ["&6A&r gas-filled tube that fires when anode &bvoltage&r exceeds the strike voltage set by the grid. Once fired it keeps conducting even with a negative grid, and goes out only when anode &bcurrent&r drops or reverses. Power the heater first."]
	quest.245AF94431CA55DB.quest_subtitle: "A thyratron"
	quest.245AFE1A3A64D992.quest_subtitle: "More Armor"
	quest.247ADE12BB44823E.quest_subtitle: "More Armor"
	quest.2492B8315A80B873.quest_subtitle: "More Armor"
	quest.249B9A558C29C581.quest_desc: ["&6Create&r Cider &busing&r the Wine Cellar, the fully automatable workstation from Create: Winery. Process apple-based ingredients through your Create machinery and let the cellar handle the production. Cider is one of the beverage categories &bsupported&r by the mod's Wine Cellar."]
	quest.249B9A558C29C581.quest_subtitle: "Press, ferment, and enjoy the harvest"
	quest.249E932761EF5C0A.quest_subtitle: "More Armor"
	quest.249F1BCA8AFB5470.quest_desc: [
		"&aDeep&r within the frozen reaches of the Twilight Forest, &batop&r the icy Glacier, lives the Alpha Yeti—the undisputed ruler of the eternal winter. Towering over &bordinary&r Yetis, this colossal beast commands the &bfury&r of snow and ice, defending its frozen cave with overwhelming strength."
		""
		"&aThe&r Alpha Yeti is a relentless opponent, capable of hurling massive blocks of ice, &bcreating&r freezing shockwaves, and using its immense strength to crush careless adventurers. Surviving the battle &brequires&r powerful equipment, careful positioning, and the determination to endure the &bfreezing&r cold."
		""
		"&aDefeating&r the Alpha Yeti &bproves&r your mastery over the frozen wilderness and unlocks the path toward even greater &bchallenges&r hidden within the Twilight Forest."
	]
	quest.249F1BCA8AFB5470.quest_subtitle: "Conquer the ruler of the Frozen Glacier"
	quest.249F1BCA8AFB5470.title: "&bAlphaYeti"
	quest.24A8AB0875DCF41A.quest_desc: [
		"&aThe&r Starlit Diamond Leggings are high-tier armor from Eternal Starlight crafted &busing&r Starlit Diamonds."
		""
		"Starlit Diamond armor &aprovides&r protection comparable to Netherite while significantly &bimproving&r armor toughness and knockback resistance."
	]
	quest.24A8AB0875DCF41A.quest_subtitle: "Celestial diamond leg armor"
	quest.24AF87A2C9AB4139.quest_desc: ["&aLocate&r the Desert Site from the Cataclysm mod. This small desert structure generates in Desert biomes and is filled with deadly sandstone traps, hidden loot, and &bdangerous&r enemies. &bSearch&r every corner before descending into its depths."]
	quest.24AF87A2C9AB4139.quest_subtitle: "Explore a forgotten desert ruin"
	quest.24AF87A2C9AB4139.title: "&eDesert Site"
	quest.24BA201A1C6C0A7A.quest_desc: [
		"&aJourney&r beyond the green forests and &brolling&r plains to discover a land where snow never melts. The Snowy Biome is a harsh yet beautiful wilderness, covered in endless &bblankets&r of snow, frozen rivers, and towering icy peaks."
		""
		"&aDespite&r its peaceful appearance, these &bfrozen&r lands are home to dangerous creatures and valuable resources. Every step through the snow brings new opportunities for exploration, &bhidden&r structures, and &badventures&r waiting beneath the ice."
	]
	quest.24BA201A1C6C0A7A.quest_subtitle: "Step into the land of eternal winter"
	quest.24BA201A1C6C0A7A.title: "&lVisit the Snowy Biome"
	quest.24BEAD74CD174EEC.quest_desc: [
		"&9&lPreserve&r&r the blocks you &bmine&r with the Silk Touch Upgrade. It allows compatible machines and devices to harvest blocks using the Silk Touch enchantment, giving you the block itself instead of its usual drops."
		""
		"Perfect for &bcollecting&r valuable blocks that would otherwise be broken into different materials."
	]
	quest.24BEAD74CD174EEC.quest_subtitle: "Harvest blocks exactly as they are"
	quest.24C35F1018EF333F.quest_desc: [
		"&aThe&r Traveler's Wings are a remarkable piece of &bequipment&r crafted using the magical &bresources&r found within the Twilight Forest. Though they cannot grant true flight, they allow their wearer to glide safely across great distances, making &bexploration&r faster and far less dangerous."
		""
		"&aPerfect&r for crossing deep ravines, towering cliffs, and the vast canopy of the &benchanted&r forest, these wings offer unmatched mobility. With every leap, you'll discover new paths and &bhidden&r places that would &botherwise&r remain out of reach."
	]
	quest.24C35F1018EF333F.quest_subtitle: "Glide beyond the forest canopy"
	quest.24C6F98CFC322079.quest_subtitle: "Yummy!"
	quest.24D0091965A8DEA1.quest_desc: ["&6The&r Mechanical Grindstone is a powerful machine from Create: Enchantment Industry that brings the vanilla Grindstone into your factory. It can &bautomatically&r process items, remove enchantments and extract experience, while also providing an &badditional&r sanding function for compatible recipes. Connect it to Create's rotational power and automate your grinding and &benchantment-processing&r systems."]
	quest.24D0091965A8DEA1.quest_subtitle: "Automate grinding and disenchanting"
	quest.24DB004C6C3B742E.quest_desc: ["&6Craft&r Pinot Noir, an elegant red wine made from red grapes. In Create: Winery, it can be produced through the automated winemaking process &busing&r the Wine Cellar. Pinot Noir is traditionally known for its delicate &bred-fruit&r character and earthy, floral notes."]
	quest.24DB004C6C3B742E.quest_subtitle: "A refined red from delicate grapes"
	quest.251451E155779930.quest_desc: [
		"&eFalling&r short of a ledge? Just jump again."
		""
		"The &bCloud&r in a Bottle lets you perform a double jump while airborne, giving you an extra burst of mobility. It can also help save you from a dangerous fall if you time the &bsecond&r jump correctly."
		""
		"Sometimes, one &bjump&r simply isn't enough."
	]
	quest.251451E155779930.quest_subtitle: "A little extra lift"
	quest.2540A9BCFD7AA514.quest_subtitle: "More Armor"
	quest.254CBF98692FCBE8.quest_subtitle: "More Weapon"
	quest.254F2ECD9A982FEB.quest_desc: ["&6The&r Andesite Exoskeleton is a powered chestplate from Create Stuff 'N Additions &bdesigned&r to improve your efficiency. While worn, it provides Haste II and Weakness II, making mining &bsignificantly&r faster while reducing your combat effectiveness. It requires fuel to operate and has &b320&r durability. In the 2.0.1 version, it is &bcrafted&r through Mechanical Crafting using Andesite Alloy, Shafts, a Belt Connector, a Heat Engine, Zinc Ingots and Stone."]
	quest.254F2ECD9A982FEB.quest_subtitle: "Work harder, mine faster"
	quest.254FE9D920F37661.quest_desc: [
		"&eUnleash&r your wild side."
		""
		"The Feral Claws &bincrease&r your attack speed, allowing you to swing your weapons faster and tear through enemies before they have a chance to react. In the &bcurrent&r Artifacts version, they provide a &b40%&r attack speed bonus."
		""
		"&bLet&r your claws do the talking."
	]
	quest.254FE9D920F37661.quest_subtitle: "Strike faster. Strike harder"
	quest.255286B3896F7565.quest_subtitle: "More Armor"
	quest.2575FE3D87D1945D.quest_desc: ["&6The&r Alternator is one of the key machines in Create Crafts \\& Additions. It converts Create's &brotational&r power into Forge Energy (FE), allowing you to generate electricity directly from your &bfactory's&r kinetic machinery. In version 1.6.0 for NeoForge 1.21.1, it has shaft connections on both sides, making it easier to &bintegrate&r into your power setup. It requires at least &b32&r RPM to operate and has a &b5&r kFE internal energy buffer."]
	quest.2575FE3D87D1945D.quest_subtitle: "Turn kinetic power into electricity"
	quest.257874F4BC99414C.quest_desc: ["&6Obtain&r an Item Vault and an Item Silo. These storage solutions are &bdesigned&r for handling large quantities of items in &bautomated&r factories. Item Vaults can be connected into large storage structures, while Item Silos provide compact, vertical &bstorage&r in Create add-ons."]
	quest.257874F4BC99414C.quest_subtitle: "Store the wealth of your factory"
	quest.257874F4BC99414C.title: "Item Vault \\& Item Silo"
	quest.258C7824B863FC6B.quest_desc: [
		"&dThe&r Ring of Recovery enhances your spellcasting by reducing spell cooldowns by 15%. This allows you to use your most &bpowerful&r spells more frequently and keep the pressure on your enemies."
		""
		"&bEquip&r the ring and make every second between your spells count."
	]
	quest.258C7824B863FC6B.quest_subtitle: "Recover your spells faster"
	quest.258E07D6C6627C6D.quest_desc: [
		"These &btools&r combine Netherite strength with iron reliability."
		"They are a solid &aupgrade &rfrom diamond tools and a good foundation for deeper &bprogression&r."
	]
	quest.258E07D6C6627C6D.quest_subtitle: "Reliable beginnings"
	quest.258E07D6C6627C6D.title: "Iron Netherite Tools"
	quest.258F8395D8D45BB0.quest_desc: [
		"&aTrees&r in the Eternal Starlight dimension are infused with lunar energy."
		"Their logs, known as&b Lunar&r Logs, are a fundamental resource used for crafting tools, building structures, and progressing through this mysterious world."
		""
		"Gather enough of this wood to begin shaping your &bsurvival&r in the Starlight dimension."
	]
	quest.258F8395D8D45BB0.quest_subtitle: "Harvest the starlight trees"
	quest.258F8395D8D45BB0.title: "Lunar Wood"
	quest.25A98178C5A2A02F.quest_desc: [
		"&l&9Running&r&r out of power far from home can bring your adventure to a sudden halt. The Battery Upgrade adds energy storage directly to your backpack, allowing you to charge and discharge &bcompatible&r energy-based items while on the move."
		""
		"&bCharge&r your backpack and keep your powered tools and equipment ready for action wherever your journey takes you."
	]
	quest.25A98178C5A2A02F.quest_subtitle: "Keep your machines powered wherever you go"
	quest.25AFB0A69CE6B264.quest_desc: ["&6Design&r and write Circuit Schematics here. Components you want to place on the board must be in your inventory. Insert an empty schematic to save the design."]
	quest.25AFB0A69CE6B264.quest_subtitle: "A circuit design table"
	quest.25B4FEAFBBFEFDCE.quest_desc: ["&eDon't&r let your target escape! The Clockwork Arrow is a special arrow that automatically steers towards the nearest mob to your crosshair when fired. Take &badvantage&r of this remarkable technology to &bimprove&r your attacks and hit your enemies with greater precision!"]
	quest.25B4FEAFBBFEFDCE.quest_subtitle: "Mechanically Assisted Accuracy"
	quest.25BC90657571F33F.quest_desc: [
		"&aExplore&r the main island of the End — a barren stretch of end stone and obsidian pillars surrounding the central fountain."
		""
		"It's the first ground you'll stand on after arriving, and the &bstarting point&r for every expedition into the &bouter islands&r."
	]
	quest.25BC90657571F33F.quest_subtitle: "The central island"
	quest.25BC90657571F33F.title: "&l&eEnd"
	quest.25C8E0C001721567.quest_desc: ["&6Craft&r the Track Buffer and add a finishing touch to your railway. This decorative buffer is designed to be &bplaced&r at the end of a track, giving your stations, depots, and sidings a proper railway-style stopping point. In Create: Misc \\& Things, it is primarily a decorative block rather than a &bfunctional&r train brake."]
	quest.25C8E0C001721567.quest_subtitle: "Stop trains in their tracks"
	quest.25CFE8AC523454F9.quest_desc: ["&6Obtain&r Solid Corium and Corium, the &bdangerous&r products of an overheated nuclear reactor. Handle these materials with extreme &bcaution—they&r are a sign that something has gone seriously &bwrong&r inside the reactor."]
	quest.25CFE8AC523454F9.quest_subtitle: "Survive the meltdown"
	quest.25E15B862AC93653.quest_desc: [
		"&aMine&r Ancient Debris deep in the Nether."
		"This rare material can be smelted into &bNetherite Scrap&r and eventually turned into Netherite."
	]
	quest.25E15B862AC93653.quest_subtitle: "The rarest Nether resource"
	quest.25E15B862AC93653.title: "&6Ancient Debris"
	quest.26084DC3B8F5AEAF.quest_desc: ["Collect 8 &acoal&r and 16 &acobblestone&r, then craft a &afurnace&r. Coal will be your first fuel source, while stone allows you to create stronger tools and blocks. The furnace unlocks smelting and is a key step toward &bprogression&r."]
	quest.26084DC3B8F5AEAF.quest_subtitle: "Basic resources and your first furnace"
	quest.26084DC3B8F5AEAF.title: "&7Stone &8Progression"
	quest.26252B59DD543507.quest_desc: [
		"&9&lSay&r&r goodbye to overflowing chests and endless searching. Refined Storage brings your items into a powerful digital storage network, &ballowing&r you to access, organize and manage your entire &bcollection&r from a single system."
		""
		"Build your first storage network, connect your storage &bdisks&r and discover a whole new way to &bmanage&r your resources."
	]
	quest.26252B59DD543507.quest_subtitle: "Step into the world of digital storage"
	quest.26252B59DD543507.title: "&l&bWelcome Refined Storage"
	quest.2639E265A51A671F.quest_desc: ["&6Craft&r Honey Candy in Create: Confectionery and &badd&r a touch of sweetness to your factory. This treat is made &busing&r honey and can be enjoyed as a simple confection alongside the mod's many other sweets."]
	quest.2639E265A51A671F.quest_subtitle: "A sweet treat made with golden honey"
	quest.26688FEB91E1B67A.quest_desc: ["&6Converts&r Forge Energy into this mod's &belectricity&r. Use the control pin to set the output &bvoltage&r and improve conversion efficiency. It lets you feed your grid from other mods' machines."]
	quest.26688FEB91E1B67A.quest_subtitle: "A bridge from Forge Energy"
	quest.266B1BF54658D4B0.quest_desc: ["&6Protects&r your devices from too much &bcurrent&r: it burns when the current exceeds the set value. Put it in the circuit in front of the device you want to protect."]
	quest.266B1BF54658D4B0.quest_subtitle: "A fuse holder"
	quest.267CAA9E6F1A31D2.quest_desc: [
		"&aDeep&r within the dark depths of the world, the Underworld Knight stands as a cursed guardian of ancient power."
		"&aThis boss&r is heavily armored and extremely aggressive, using brutal melee attacks and relentless pressure to overwhelm its opponents."
		"Prepare strong gear and healing items before facing it, as the &bfight is long &rand &bdangerous&r."
	]
	quest.267CAA9E6F1A31D2.quest_subtitle: "The cursed guardian"
	quest.267CAA9E6F1A31D2.title: "&l&3Underworld Knight"
	quest.268BBA40E3EF5994.quest_subtitle: "More Armor"
	quest.2693FECFF203A6F9.quest_desc: ["&6Obtain&r a Fluid Tank from Create. It is used to store fluids and can be &bconnected&r to Fluid Pipes for &bautomated&r filling and extraction. Individual tanks hold up to 8 buckets (8,000 mB), and multiple tanks can be &bcombined&r into larger structures, reaching up to 3×32×3 blocks."]
	quest.2693FECFF203A6F9.quest_subtitle: "Store the lifeblood of your factory"
	quest.26A67F2654797A8B.quest_desc: [
		"&dThe&r Scarecrow Coat is part of the Scarecrow Armor set in Iron's Spells 'n Spellbooks. It provides &b+8&r Armor and &b+75&r Max Mana."
		""
		"Craft this &bunusual&r magical coat from Hay Bales and Leather, and embrace the &bmysterious&r power of the scarecrow."
	]
	quest.26A67F2654797A8B.quest_subtitle: "Embrace the strange magic of the scarecrow"
	quest.26B541AF546B8FFA.quest_desc: ["&6Obtain&r a Radial Chassis, Linear Chassis, and Secondary Linear Chassis from Create. These chassis are &bessential&r components for building moving contraptions. The Radial Chassis connects blocks within a radius, while the Linear Chassis &bconnects&r structures along a line. The Secondary Linear Chassis works like the Linear Chassis but does not connect to regular Linear Chassis, allowing separate sections of a &bcontraption&r to move independently."]
	quest.26B541AF546B8FFA.quest_subtitle: "Build the foundation of moving contraptions"
	quest.26B541AF546B8FFA.title: "All Chassis"
	quest.26E01323474AD157.quest_desc: [
		"&9&lYour&r&r storage network is becoming massive. The 64k Storage Disk provides a huge amount of digital storage capacity, &ballowing&r you to keep an enormous collection of resources within your Refined Storage system."
		""
		"Insert it into a Disk Drive and take another major &bstep&r toward building a truly massive digital storage network."
	]
	quest.26E01323474AD157.quest_subtitle: "Store an enormous amount of resources in one disk"
	quest.26EF0403229474B6.quest_desc: [
		"&aSearch&r the Nether and locate a Nether Fortress — a massive structure made of dark bricks, suspended over lava oceans."
		"These fortresses are extremely dangerous, filled with Blazes, Wither Skeletons, and other hostile mobs, but they are also essential for progression, as they contain valuable loot and resources needed for &bbrewing&r and &bsummoning bosses&r."
	]
	quest.26EF0403229474B6.quest_subtitle: "Ancient bastion of the Nether"
	quest.26EF0403229474B6.title: "&4Nether Fortress"
	quest.26FCC88CA508AA64.quest_desc: [
		"Chain of Souls is a &amysterious&r item from Eternal Starlight, associated with higher-tier progression and &bdimensional&r entities."
		""
		"Its exact acquisition &amethod&r is not clearly documented in available public sources and may &bdepend&r on loot tables, progression rewards, or JEI-based crafting within the mod."
	]
	quest.26FCC88CA508AA64.quest_subtitle: "Bound essence"
	quest.26FCC88CA508AA64.title: "&6Chain Of Souls"
	quest.2718707A2FF24FAF.quest_desc: [
		"&9&lThe&r&r Limited Oak Barrel IV continues the progression of compact storage in Sophisticated Storage. With &beven&r more capacity than the previous tiers, it provides plenty of room for expanding your collection while &bmaintaining&r the practical barrel design."
		""
		"Keep &bimproving&r your storage system and prepare for the next level of storage technology."
	]
	quest.2718707A2FF24FAF.quest_subtitle: "A larger step toward advanced storage"
	quest.27279EA6D60985B1.quest_subtitle: "Upgrade+"
	quest.273271508FA51035.quest_subtitle: "Upgrade+"
	quest.273B534C64F4D80E.quest_desc: ["&aObtain&r the Monstrous Wizard Hat from the Cataclysm: Spellbooks addon. Add this &bpowerful&r magical headpiece to your collection and continue your journey through the monstrous relics and &bforbidden&r magic introduced by the addon."]
	quest.273B534C64F4D80E.quest_subtitle: "Embrace the power of the monstrous mage"
	quest.273B534C64F4D80E.title: "&6Monstrous &eWizard Hat"
	quest.273C2DBE718BBCD0.quest_desc: [
		"&aDeep&r beneath the Twilight Forest lies the &bGoblin&r Stronghold, an ancient fortress consumed by darkness and time. Hidden within its grand tomb rests the Knight Phantoms, a group of spectral warriors who &bcontinue&r to guard their fallen king long after death."
		""
		"&aUnlike&r most bosses, the Knight Phantoms fight as a &bcoordinated&r group, surrounding their enemies with relentless attacks and refusing to give their opponents a moment to recover. Their spectral weapons, &bdisciplined&r formations, and overwhelming numbers make this encounter one of the greatest tests of skill in the Twilight Forest."
		""
		"&aOnly&r by defeating every &bPhantom&r Knight can you claim victory and continue your journey toward the final secrets hidden within the &benchanted&r realm."
	]
	quest.273C2DBE718BBCD0.quest_subtitle: "Defeat the forgotten guardians of the Goblin Stronghold"
	quest.273C2DBE718BBCD0.title: "&2Knight Phantom"
	quest.273C8343488350C5.quest_desc: ["&6The&r Copper Jetpack is a &bflight-capable&r chestplate from Create Stuff 'N Additions powered by hydraulic energy. It is &bfueled&r with water and allows you to fly through the air, giving you a much more mobile way to explore and work around your factory. It is crafted &busing&r 4 Copper Ingots, a Cogwheel, a Hydraulic Engine, 2 Fluid Tanks and an Andesite Alloy."]
	quest.273C8343488350C5.quest_subtitle: "Take flight with hydraulic power"
	quest.273DC287156455D1.quest_desc: ["&dHits&r have a chance to release a &bSoulfire Coin&r. Shooting a coin empowers and ricochets your bullets, and empowered shots deal extra soul damage that ignores &barmor&r."]
	quest.273DC287156455D1.quest_subtitle: "Spirit-powered bullets"
	quest.2741A59CB91C0F9E.quest_desc: [
		"&aHarvest&r the meat of the mighty Hydra and prepare one of the most nourishing meals in the Twilight Forest. The Hydra Chop is a rare delicacy obtained only after defeating the &blegendary&r beast, carrying with it a portion of the &bcreature's&r incredible vitality."
		""
		"&aWhen&r properly cooked, it restores a &blarge&r amount of hunger and provides &bexcellent&r nourishment for long expeditions. A meal fit for those who have proven themselves capable of slaying one of the forest's greatest monsters."
	]
	quest.2741A59CB91C0F9E.quest_subtitle: "A feast worthy of a dragonslayer"
	quest.2743EA3B926C7174.quest_desc: ["&6The&r Schematicannon is Create's automated construction machine. Load a positioned Schematic, supply it with Gunpowder, and place the required building materials in inventories &bnext&r to the cannon. It will then &bconstruct&r the schematic block by block, working from the bottom upward. A Book or Clipboard can be used to generate a &bmaterial&r checklist, while placement settings let you &bcontrol&r how existing blocks are handled. The cannon uses Gunpowder as fuel and &bconsumes&r it based on the number of blocks being placed."]
	quest.2743EA3B926C7174.quest_subtitle: "Build it without lifting a finger"
	quest.2758902B0ECCDE9B.quest_desc: ["&aDefeat&r 5 Cindaria from L_Ender’s Cataclysm and prove your &bstrength&r against these dangerous creatures."]
	quest.2758902B0ECCDE9B.quest_subtitle: "Hunt the Cindaria"
	quest.2758902B0ECCDE9B.title: "Cindaria"
	quest.277606BE5C92F2C4.quest_subtitle: "More Armor"
	quest.279AC2F5997E753D.quest_desc: ["&6The&r Blaze Enchanter is an advanced machine from Create: Enchantment Industry that turns Blaze power into automated enchanting. &bConfigure&r the desired enchantment using its filter, provide the required Liquid Experience, and let the machine enchant &bcompatible&r items automatically. It is one of the core machines for bringing fully &bautomated&r enchanting into your Create factory."]
	quest.279AC2F5997E753D.quest_subtitle: "Automate the art of enchanting"
	quest.27A6212CA26C7EE5.quest_subtitle: "More Armor"
	quest.27AF89C1E41CE68F.quest_desc: ["&6Craft&r a Bar of White Chocolate in Create: Confectionery and enjoy a smooth, creamy chocolate treat. &bAdd&r it to your confectionery production line and expand your &bcollection&r of chocolate bars alongside dark and ruby chocolate. White chocolate is made primarily from cocoa butter, sugar, and milk ingredients."]
	quest.27AF89C1E41CE68F.quest_subtitle: "A creamy classic for every sweet tooth"
	quest.27B58DE6B4A8F507.quest_subtitle: "Yummy!"
	quest.27B7F8713C375E65.quest_desc: ["&dRemoves&r &bgravity&r from your bullets, so they fly in a straight line instead of dropping over distance. Ideal for long-range shooting."]
	quest.27B7F8713C375E65.quest_subtitle: "Straight shots"
	quest.27C42E8855F9570E.quest_desc: [
		"&eThe&r Lucky Scarf grants an additional level of Fortune when mining, increasing the number of resources you can obtain from Fortune-dependent blocks. A simple &baccessory&r for those who want to &bmake&r every vein count."
		""
		"Put it on and make &bevery&r block count."
	]
	quest.27C42E8855F9570E.quest_subtitle: "A miner's best friend"
	quest.27E1F3AD0F733BC2.quest_desc: ["&aCraft&r a Mini Snowman from the Dusty Decorations mod. This decorative block is &bperfect&r for adding a festive winter atmosphere to your home, campsite, or snowy village."]
	quest.27E1F3AD0F733BC2.quest_subtitle: "A charming winter decoration"
	quest.27EA40EBC18A109F.quest_desc: [
		"&9&lThe&r&r Limited Oak Barrel III provides another step &bforward&r in your storage progression. With increased &bcapacity&r compared to the previous tiers, it gives you more room for your growing collection while retaining the compact form of a barrel."
		""
		"&bKeep&r expanding your storage capabilities and work your way toward the most powerful containers available."
	]
	quest.27EA40EBC18A109F.quest_subtitle: "Push your compact storage even further"
	quest.27FC1EE9736824E4.quest_desc: ["&6Craft&r the Vox Humana pipe and add its &bdistinctive&r reed voice to your pipe organ. Vox Humana is one of the &boriginal&r pipe types in Create: Sound of Steam and is classified as a reed pipe. In version 0.8, it is crafted through sequenced assembly &busing&r the mod's reed and tuning wire components."]
	quest.27FC1EE9736824E4.quest_subtitle: "Give your organ a human voice"
	quest.28000599322AC1CC.quest_desc: ["&dA&r special orb &bused&r to upgrade Shadow equipment in Hazen N Stuff."]
	quest.28000599322AC1CC.quest_subtitle: "An orb infused with the power of shadows"
	quest.281D9A7BFAE56D98.quest_desc: [
		"The Deepsilver Sword is a &aweapon&r from Eternal Starlight crafted &busing&r Deepsilver Ingots."
		""
		"&aIt&r is an early-to-mid progression weapon used in swamp and dark biome regions, providing a step above basic &bmaterials&r like Amaramber."
	]
	quest.281D9A7BFAE56D98.quest_subtitle: "Swamp steel blade"
	quest.284D660E93B059C4.quest_subtitle: "More Weapon"
	quest.284F646DF817CA47.quest_desc: [
		"&eWhy&r carry food when the earth itself can keep you going?"
		""
		"Rooted Boots slowly restore your hunger while walking on grass. By default, they restore 1 hunger point every 15 seconds. Eating while &bstanding&r on grass also triggers a bone meal effect on &bnearby&r plants, making these boots useful for both survival and farming."
		""
		"&bWalk&r with nature. Let it take care of you."
	]
	quest.284F646DF817CA47.quest_subtitle: "Let nature keep you fed"
	quest.284FCA69BD12F40A.quest_subtitle: "More Armor"
	quest.285B0A4BEF5565FA.quest_subtitle: "Yummy!"
	quest.285C86C0D8327492.quest_desc: [
		"&9&lMonitor&r&r the contents of your Refined Storage network with the Storage Monitor. It displays selected items and their current quantities, making it easy to &bkeep&r track of important &bresources&r without opening your main storage interface."
		""
		"&bUse&r it to create convenient status &bdisplays&r around your base and always know when your supplies are running low."
	]
	quest.285C86C0D8327492.quest_subtitle: "Keep an eye on your storage at a glance"
	quest.286FC21659BE8EB8.quest_subtitle: "Yummy!"
	quest.289307E6B572C1F8.quest_subtitle: "Yummy!"
	quest.28959A1FE12C57A8.quest_desc: [
		"&l&9A&r&r smithing table is useful, but carrying one everywhere isn't. The Smithing Upgrade adds a fully &bfunctional&r smithing table directly to your backpack, allowing you to upgrade your gear with smithing templates wherever you are."
		""
		"Keep your &bequipment&r up to date and perform smithing work on the go."
	]
	quest.28959A1FE12C57A8.quest_subtitle: "Upgrade your gear without leaving your backpack"
	quest.28BEB1B635328BA5.quest_desc: ["&dCrescentia&r is a shining sickle focused on &bdefensive&r buffs and continuous damage."]
	quest.28BEB1B635328BA5.quest_subtitle: "Crescent Moon"
	quest.28BEB1B635328BA5.title: "&l&5Crescentia"
	quest.28C9F7D8DB115F9E.quest_desc: ["&aThe&r Moonring Greatsword is a craftable weapon in some versions or modpack &bconfigurations&r of Eternal Starlight, related to lunar-themed progression."]
	quest.28C9F7D8DB115F9E.quest_subtitle: "Crystalline lunar weapon"
	quest.28C9F7D8DB115F9E.title: "&6Moonring Greatsword"
	quest.28E654549C75AC52.quest_desc: ["&6The&r Blaze Forger is the automated anvil of Create: Enchantment Industry. It &buses&r Blaze power to &bprocess&r items with enchantments, allowing you to apply, combine, split and remove enchantments using Create automation. It also supports Super Enchanting, letting you go beyond the normal limits of &benchantment&r levels when configured for it."]
	quest.28E654549C75AC52.quest_subtitle: "Forge enchantments beyond the ordinary"
	quest.28FC81C5F5D95D54.quest_desc: [
		"&aThe Nether&r Star is a rare and powerful item obtained from defeating the Wither."
		"It holds immense energy and is used to craft advanced blocks such as beacons, symbolizing mastery over one of the most &adangerous&r bosses in &bMinecraft&r."
	]
	quest.28FC81C5F5D95D54.quest_subtitle: "A power born from chaos"
	quest.28FC81C5F5D95D54.title: "&dNether Star"
	quest.28FF043041C789E9.quest_desc: ["&6The&r Block Picker is a utility tool from Create Stuff 'N Additions that allows you to pick up and move blocks that normally cannot be moved by hand. It is especially &buseful&r for &btransporting&r unusual blocks and setting up contraptions. In newer versions, the Block Picker uses the mod's Lifted Block entity &binstead&r of a Falling Block entity."]
	quest.28FF043041C789E9.quest_subtitle: "Move blocks that shouldn't move"
	quest.29051B96AAC37515.quest_desc: ["&6Craft&r the Centrifugal Clutch to automatically &bcontrol&r mechanical power based on rotational speed. The clutch engages when the input RPM exceeds its configured threshold and disconnects when the speed falls below it. The &bthreshold&r can be adjusted with the value panel, making it &buseful&r for automatic speed-based machinery."]
	quest.29051B96AAC37515.quest_subtitle: "Engage only when the speed is right"
	quest.2909A3AF6BF326B4.quest_subtitle: "Yummy!"
	quest.290A69031D71AA01.quest_desc: [
		"&dUncommon&r Ink is the second tier of magical ink in Iron's Spells 'n Spellbooks. It is &bused&r in the Scroll Forge to create &bUncommon-rarity&r spell scrolls."
		""
		"Find it in magical structures or &bobtain&r it from powerful magical creatures, then use it to craft stronger spells than those made with Common Ink."
	]
	quest.290A69031D71AA01.quest_subtitle: "A stronger essence for greater spells"
	quest.290A69031D71AA01.title: "&aUncommon Ink"
	quest.29129B91E5661646.quest_subtitle: "More Armor"
	quest.291B45D19468ED15.quest_desc: [
		"&aCraft&r the Fiery Pickaxe using Fiery Ingots forged from the blazing essence of the Hydra. Tempered in &bmagical&r flames, this exceptional tool combines incredible durability with the destructive power of fire, allowing it to tear through stone and ore with &bremarkable&r efficiency."
		""
		"&aThe&r Fiery Pickaxe is &bmore&r than a mining tool—it is a symbol of your mastery over the Hydra's power. Carrying the heat of the Fire Swamp within its enchanted metal, it will faithfully accompany you as you uncover the rarest &btreasures&r hidden beneath the Twilight Forest."
	]
	quest.291B45D19468ED15.quest_subtitle: "Carve through stone with blazing power"
	quest.294D9C192F40B07B.quest_desc: ["&dA&r valuable crafting material &bused&r in various recipes for powerful equipment and &bspecial&r items in Hazen N Stuff."]
	quest.294D9C192F40B07B.quest_subtitle: "A sacred material for powerful crafting"
	quest.2963A6D1EA6F1E6A.quest_desc: ["&aThe&r Hoglin Trophy is a decorative trophy from My Nether's Delight, serving as a &breminder&r of your adventures in the Nether and &bencounters&r with its dangerous creatures."]
	quest.2963A6D1EA6F1E6A.quest_subtitle: "A trophy commemorating a defeated Hoglin"
	quest.29730358A0A0855B.quest_desc: ["&6Thorium&r Ore is a radioactive resource used to progress toward the nuclear technology of Create: New Age. Mine it and process the ore to obtain Thorium, &bopening&r the path toward &badvanced&r reactor components and nuclear power generation."]
	quest.29730358A0A0855B.quest_subtitle: "Discover a new source of nuclear power"
	quest.2976D4E7CEB57815.quest_desc: ["&6Obtain&r an Andesite Casing, one of the fundamental building blocks of Create. It is &bused&r to craft &bmany&r early mechanical components, including the Mechanical Mixer, Mechanical Bearing, and other machines."]
	quest.2976D4E7CEB57815.quest_subtitle: "The first step into mechanical engineering"
	quest.2976D4E7CEB57815.title: "Andesite Casing"
	quest.2987C9E257AE142A.quest_desc: ["&6Obtain&r the Brown Toolbox from Create. This portable storage block provides &b8&r inventory slots, with each slot holding up to &b4&r stacks of items. When placed, nearby players can also access its contents remotely &busing&r the toolbox keybind. The Brown Toolbox is the &bdefault&r toolbox color."]
	quest.2987C9E257AE142A.quest_subtitle: "Keep your tools close at hand"
	quest.29C8541FE7881000.quest_subtitle: "Yummy!"
	quest.29D7C8E46B80572C.quest_desc: ["&6The&r Gantry Carriage is a moving contraption that travels along Gantry Shafts. Apply rotational power to the shaft to move the carriage along its path, with the direction depending on the shaft's rotation. Build your own &bmoving&r structures on the carriage to create things like automated farms, gantry cranes, elevators, or other linear machines. A Redstone signal can stop the &bcarriage&r and transfer rotation through its output, allowing multiple carriages and shafts to work together. Use a Wrench to change the &borientation&r of the Gantry Shafts and control the &bdirection&r of movement."]
	quest.29D7C8E46B80572C.quest_subtitle: "Move your machines in a straight line"
	quest.29D7C8E46B80572C.title: "Gantry Carriage \\& Gantry Shaft"
	quest.29DAC4F8DDC1ED91.quest_desc: [
		"&aCraft&r the Fiery Leggings using Fiery Ingots forged from the Hydra's blazing essence. &bReinforced&r by ancient magic and the endless flames of the Fire Swamp, these leggings provide &bexceptional&r protection while allowing you to move freely through the most dangerous &bregions&r of the Twilight Forest."
		""
		"&aAs&r an essential part of the Fiery Armor set, they embody the strength of the Hydra itself. Their &benchanted&r metal radiates warmth and resilience, ensuring you are prepared for the legendary foes that await &bbeyond&r the burning marshes."
	]
	quest.29DAC4F8DDC1ED91.quest_subtitle: "Forged in the heart of the Fire Swamp"
	quest.29EBACD0EC57DAD3.quest_desc: ["Craft all Chipped tables."]
	quest.29EBACD0EC57DAD3.quest_subtitle: "Craft all tables"
	quest.29EBACD0EC57DAD3.title: "Chipped Master"
	quest.29EC006C81866271.quest_desc: ["&aObtain&r an Ancient Metal Ingot from the Cataclysm mod. This rare &bmaterial&r is found within the Desert Site and Cursed Pyramid, where it can be obtained from Koboletons, Kobolediators, Wadjet, or by defeating the Ancient Remnant. Ancient Metal is &bused&r to craft the Ancient Spear, Bone Reptile Armor, and &bother&r ancient equipment."]
	quest.29EC006C81866271.quest_subtitle: "A relic forged by an ancient civilization"
	quest.29F326A8C981EF09.quest_desc: ["&dCinder&r Essence is a rare crafting material in Iron's Spells 'n Spellbooks. It is dropped by Ancient Knights and is primarily used to craft Upgrade Orbs, making it an important &bmaterial&r for &bupgrading&r magical equipment."]
	quest.29F326A8C981EF09.quest_subtitle: "Harness the burning essence of ancient knights"
	quest.29F3AFA9F07FB87E.quest_subtitle: "More Armor"
	quest.2A3347CB16530AEC.quest_desc: ["&6Insulated&r copper wire. You can &bdye&r it to tell circuits apart: right-click it with a dye or hold a dye in your offhand while placing. It is also an ingredient of the Copper Cord."]
	quest.2A3347CB16530AEC.quest_subtitle: "Copper with insulation"
	quest.2A3A4F53283AB71F.quest_desc: [
		"The Aeternium Ingot is forged in an &aEnd Stone Smeltery&r from a Terminite Ingot and a Netherite Ingot — or found as rare loot in structures like the End Village."
		""
		"It's the strongest material in Better End, used to craft equipment that &bsurpasses&r Netherite gear."
	]
	quest.2A3A4F53283AB71F.quest_subtitle: "Metal stronger than Netherite"
	quest.2A4C4819B7FA01C5.quest_desc: [
		"&aYour&r journey through the Twilight Forest has finally come to an end. From the humble Naga Courtyard to the frozen halls of the Aurora Palace, you have overcome every challenge this &dmagical&r &ddimension&r had to offer. Ancient beasts, forgotten kings, cursed fortresses, and &6legendary&r &bguardians&r all fell before your determination."
		""
		"&aAlong&r the way, you &bforged&r powerful equipment, uncovered long-lost treasures, mastered magical artifacts, and proved yourself worthy of wielding the relics of the Twilight Forest. Every victory brought you one step closer to the &cheart&r of this enchanted realm."
		""
		"&aWith&r the Snow Queen &4defeated&r and the dimension's &agreatest&r secrets revealed, your adventure stands as a testament to your courage, perseverance, and mastery. Though your path through the Twilight Forest has ended, countless new &aadventures&r still await beyond its borders."
	]
	quest.2A4C4819B7FA01C5.quest_subtitle: "The enchanted realm has been conquered"
	quest.2A4C4819B7FA01C5.title: "&l&6Complete Chapter"
	quest.2A777613CD50AEAD.quest_desc: ["&6Prepare&r a Vanilla Milkshake and fill a bucket with it. This &bsweet&r treat is one of the milkshake varieties found in Create: Dreams n' Desires, and can also &bplay&r a role in the mod's more &belaborate&r fluid recipes."]
	quest.2A777613CD50AEAD.quest_subtitle: "A classic taste for the factory"
	quest.2A81E1C8AB2A9318.quest_desc: [
		"&l&9Why&r&r leave your music &bbehind&r when you can carry it in your backpack? The Jukebox Upgrade turns your backpack into a portable jukebox, allowing you to play music discs directly from its upgrade tab."
		""
		"Take it a &bstep&r further with the Advanced Jukebox Upgrade. Store multiple discs, switch between tracks, shuffle your playlist and &benable&r repeat modes for continuous music wherever your adventure takes you."
	]
	quest.2A81E1C8AB2A9318.quest_subtitle: "Take your music with you wherever you go"
	quest.2A81E1C8AB2A9318.title: "Jukebox \\& Advanced Jukebox Upgrade"
	quest.2A849AF898939CE0.quest_desc: [
		"&aObtain&r the Void Assault Shoulder Weapon, created by fusing a Wither Assault Shoulder Cannon with Void Cores at the &aMechanical Fusion Anvil&r."
		""
		"It fires devastating projectiles, making it one of Cataclysm's most powerful &branged&r weapons."
	]
	quest.2A849AF898939CE0.quest_subtitle: "A cannon fused with the void"
	quest.2A849AF898939CE0.title: "&dVoid Assault Shoulder Weapon"
	quest.2A87A9B363740DF3.quest_subtitle: "More Armor"
	quest.2A923AE51C9DC9E3.quest_desc: [
		"&6WELCOME, ADVENTURER&r"
		""
		"You have entered a world shaped by two forces that were never meant to coexist."
		""
		"Industry and magic."
		""
		"For centuries, civilizations have attempted to understand the forces hidden beneath the earth, in the stars, and within living things. Some sought knowledge. Others sought power."
		""
		"Most of them paid a terrible price."
		""
		"You are about to discover why."
		"{@pagebreak}"
		"&6THE AGE OF STEAM&r"
		""
		"The world you know was not always filled with machines."
		""
		"Long ago, mankind relied on simple tools and crude mechanisms. Then came the discovery of kinetic engineering — the art of transferring motion through gears, shafts, belts and carefully designed machines."
		""
		"What began as a curiosity became an industrial revolution."
		""
		"Factories rose above the landscape. Railways connected distant cities. Enormous machines began to reshape mountains and rivers."
		""
		"Humanity had finally learned how to make the world move."
		"{@pagebreak}"
		"&6THE OTHER POWER&r"
		""
		"But machines were not the only force waiting to be discovered."
		""
		"Long before the first factory was built, ancient civilizations spoke of Arcana — an invisible force flowing through the world."
		""
		"Magic was unpredictable. It could heal or destroy. It could create life, bend matter, alter the mind or tear reality apart."
		""
		"For generations, magic and technology remained separate."
		""
		"Until someone discovered that they could be combined."
		"{@pagebreak}"
		"&6THE FIRST FUSION&r"
		""
		"The first experiments were considered impossible."
		""
		"Engineers began placing magical crystals inside machines. Mages learned to channel Arcana through mechanical devices. Steam engines became stronger. Automata began moving without human hands."
		""
		"Entire cities were powered by machines infused with magical energy."
		""
		"For a brief moment, humanity believed it had solved every problem."
		""
		"They were wrong."
		""
		"Something had noticed them."
		"{@pagebreak}"
		"&6THE FALL&r"
		""
		"No surviving record describes exactly what happened."
		""
		"One day, the great cities stopped communicating."
		""
		"Machines continued running without their creators. Factories burned for weeks. Portals appeared where no portals had been built. Creatures unknown to natural history emerged from beneath the earth."
		""
		"Then came the Silence."
		""
		"When it ended, entire civilizations were gone."
		""
		"Their machines remained."
		""
		"Their ruins remained."
		""
		"And whatever they had awakened remained as well."
		"{@pagebreak}"
		"&6THE WORLD TODAY&r"
		""
		"Centuries have passed."
		""
		"Nature has reclaimed the ruins, but the old world never truly disappeared."
		""
		"Abandoned factories still turn in forgotten valleys. Ancient laboratories hide beneath ruined cities. Ships powered by impossible engines cross distant oceans."
		""
		"Strange artifacts can be found in places untouched for generations."
		""
		"And beneath it all, the old machines continue to move."
		""
		"Slowly."
		""
		"Patiently."
		""
		"As if waiting for someone to return."
		"{@pagebreak}"
		"&6YOUR JOURNEY&r"
		""
		"You are not a hero."
		""
		"Not yet."
		""
		"You begin with nothing but curiosity, a pair of hands and whatever courage you can gather."
		""
		"Mine your first ores. Build your first machines. Learn how power moves through gears and circuits."
		""
		"But do not stop there."
		""
		"Study the Arcana. Explore forgotten structures. Search for artifacts. Travel beyond the borders of civilization."
		""
		"Every discovery will bring you closer to the truth."
		"{@pagebreak}"
		"&6A WORLD OF POSSIBILITIES&r"
		""
		"There is no single path."
		""
		"Become an engineer and build machines capable of reshaping the world."
		""
		"Become an alchemist and uncover the secrets hidden within matter."
		""
		"Become a mage and learn to manipulate forces that existed long before mankind."
		""
		"Become an explorer and uncover what remains of the civilizations that came before."
		""
		"Or become all of them."
		""
		"The world does not care which path you choose."
		""
		"It only cares where that path leads."
		"{@pagebreak}"
		"&6THE QUESTS&r"
		""
		"The path ahead will not always be obvious."
		""
		"Your quest book will serve as your guide. Follow its chapters, complete objectives and learn from every discovery."
		""
		"Some tasks will teach you the basics."
		""
		"Others will push you toward places where preparation means the difference between life and death."
		""
		"Do not treat the quests as simple instructions."
		""
		"They are fragments of a much larger story."
		""
		"And eventually, you may discover that someone has been guiding your journey from the very beginning."
		"{@pagebreak}"
		"&6ONE LAST WARNING&r"
		""
		"There are things in this world that should remain forgotten."
		""
		"Machines that were never meant to move."
		""
		"Magic that was never meant to be controlled."
		""
		"Doors that were never meant to be opened."
		""
		"You will eventually encounter them."
		""
		"When that happens, remember one thing:"
		""
		"Curiosity created this world."
		""
		"Greed nearly destroyed it."
		""
		"What you do with its secrets is up to you."
		""
		"Your adventure begins now."
	]
	quest.2A923AE51C9DC9E3.quest_subtitle: "Reading"
	quest.2A923AE51C9DC9E3.title: "&l&fLore"
	quest.2A971732D1809F14.quest_desc: [
		"&aDeep&r within the world of Eternal Starlight, the Torreya Forest grows with ancient, towering &atrees&r and a calm yet eerie atmosphere."
		"This biome may seem peaceful at &bfirst&r, but hidden dangers and valuable resources await those who explore it thoroughly."
		""
		"Discovering this forest is another step toward &bmastering&r the dimension."
	]
	quest.2A971732D1809F14.quest_subtitle: "Silent ancient woods"
	quest.2A971732D1809F14.title: "&dTorreya Forest"
	quest.2A9EB04C35C7C168.quest_desc: ["&6Zinc&r Leggings are part of the Zinc Suit from Create Stuff 'N Additions. They provide an &balternative&r armor option made from Zinc and have &b300&r durability. They are crafted using &b7&r Zinc Ingots."]
	quest.2A9EB04C35C7C168.quest_subtitle: "Complete the zinc protection"
	quest.2AB632D79C0A6DE1.quest_desc: ["&aObtain&r a Coral Spear from the Cataclysm mod. This weapon can be &bdropped&r by Deepling enemies and is &bused&r as a powerful melee weapon. Defeat Deeplings to collect this &brare&r ocean weapon."]
	quest.2AB632D79C0A6DE1.quest_subtitle: "A weapon from the coral depths"
	quest.2ABA024593945536.quest_desc: [
		"&dThe&r Blood Staff is a powerful Blood staff in Iron's Spells 'n Spellbooks. It is a &bcommon&r drop from the Dead King."
		""
		"When held in the main hand, it provides &b8&r Attack Damage, &b1&r Attack Speed, &b+15%&r Blood Spell Power, &b+10%&r Summon Damage and &b+5%&r Spell Power."
	]
	quest.2ABA024593945536.quest_subtitle: "Wield the crimson power of the Dead King"
	quest.2ABA462AA76F12F9.quest_subtitle: "Yummy!"
	quest.2ADB6FE1CB30828B.title: "Nice"
	quest.2ADCAA590F8E17E9.quest_desc: [
		"&aDiscover&r the Ice Starfield, a frozen stretch of the End covered in ice and glimmering, &bstar-like&r crystal formations."
		""
		"Its cold, open terrain hides resources found nowhere else among Better End's &bbiomes&r."
	]
	quest.2ADCAA590F8E17E9.quest_subtitle: "Frozen field of stars"
	quest.2ADCAA590F8E17E9.title: "Ice Starfield"
	quest.2ADD9599BDEC36C3.quest_desc: [
		"&9&lMake&r&r item collection effortless with the Pickup Upgrade. It &bautomatically&r picks up nearby dropped items and &bplaces&r them directly into your storage, helping you keep your inventory clear while gathering resources."
		""
		"The Advanced Pickup Upgrade gives you greater control over what gets collected, allowing you to &bconfigure&r filters and &bfine-tune&r the types of items that should be picked up."
	]
	quest.2ADD9599BDEC36C3.quest_subtitle: "Let your storage collect items for you"
	quest.2ADD9599BDEC36C3.title: "Pickup \\& Advanced Pickup Upgrade"
	quest.2AE274FE18DAE509.quest_desc: ["&eEven&r the most extraordinary machines can need repairs. Spawn the &bbroken&r mechanical dragonfly and &bprepare&r to restore it to working order. With the right clockwork gears, you can repair the Clockwork Dragonfly and gain a mechanical &bcompanion&r that lets you travel both on land and through the skies!"]
	quest.2AE274FE18DAE509.quest_subtitle: "A New Life for a Mechanical Dragonfly"
	quest.2AE9658758CD1656.quest_desc: ["&dEnables&r &bautomatic&r fire, letting you hold the trigger and keep shooting."]
	quest.2AE9658758CD1656.quest_subtitle: "Hold the trigger"
	quest.2AEABE985A375787.quest_subtitle: "More Weapon"
	quest.2AF99F2DD039BB8B.quest_desc: [
		"The Thallasium Chestplate is crafted from Thallasium Plating at a Smithing Table."
		""
		"It's part of the first set of &aarmor&r introduced by Better End."
	]
	quest.2AF99F2DD039BB8B.quest_subtitle: "Chestplate of the first tier"
	quest.2B04952C86C3FB6D.quest_subtitle: "More Armor"
	quest.2B19669AC2AF8EEE.quest_desc: ["&6Craft&r a Mechanical Mixer from Create. It &buses&r rotational power to process Mixing recipes and multi-item &bshapeless&r crafting recipes inside a Basin. The Mixer requires at least &b32&r RPM to operate and is &bessential&r for creating materials such as Brass Ingots."]
	quest.2B19669AC2AF8EEE.quest_subtitle: "Turn ingredients into something greater"
	quest.2B24D4A0F2A37C18.quest_desc: [
		"The Crystalite Boots are created through an Infusion Ritual — Terminite Boots, an Amber Gem, and Crystal Shards placed around an &aInfusion Pedestal&r."
		""
		"Once worn, they grant permanent &bSpeed I&r, making them ideal for exploring the End."
	]
	quest.2B24D4A0F2A37C18.quest_subtitle: "Boots born from infusion"
	quest.2B24D4A0F2A37C18.title: "&dCrystalite Boots"
	quest.2B2B279613C3F379.quest_desc: ["&6The&r Heat Pump allows you to &btransfer&r heat through your thermal network in Create: New Age. Use it together with Heat Pipes to move heat between different &bparts&r of your &bsetup&r and build more &badvanced&r heat-powered systems."]
	quest.2B2B279613C3F379.quest_subtitle: "Move heat with precision"
	quest.2B367C012076EE72.quest_desc: ["&dFrozen&r Bone is the Ice Focus in Iron's Spells 'n Spellbooks. It is dropped by Strays and can also be found in mod structures, with a higher &bchance&r in Mountain Tower loot. It is used to craft &bIce-school&r spells in the Scroll Forge, as well as items &bsuch&r as the Frost Rune and Frosted Helve."]
	quest.2B367C012076EE72.quest_subtitle: "Harness the freezing essence of the Strays"
	quest.2B56F9F02BA7AEB2.quest_desc: ["&aDefeat&r the Ancient Remnant from the Cataclysm mod. This &bcolossal&r ancient dragon-like guardian sleeps beneath the Cursed Pyramid, protecting the &bsecrets&r and treasures of a forgotten civilization. Awaken it with the Necklace of the Desert and prepare for a devastating battle against one of the &bstrongest&r desert bosses."]
	quest.2B56F9F02BA7AEB2.quest_subtitle: "Defeat the guardian of the forgotten desert"
	quest.2B56F9F02BA7AEB2.title: "&l&6Ancient &eRemnant"
	quest.2B5F6F6DC5688B94.quest_desc: [
		"Deep within the &aEternal Starlight&r dimension lies the Dense Forest — a thick, shadowed biome filled with towering vegetation and limited visibility."
		"Navigation becomes difficult here, and danger can appear suddenly from the dense surroundings."
		""
		"This &abiome&r is often the &bfirst&r true test of exploration &bskills&r in the new dimension."
	]
	quest.2B5F6F6DC5688B94.quest_subtitle: "Lost among the trees"
	quest.2B5F6F6DC5688B94.title: "&bDense Forest"
	quest.2B6972654421AE30.quest_desc: ["&6A&r special-purpose device that, under the right conditions, gives a very stable &bvoltage&r reference."]
	quest.2B6972654421AE30.quest_subtitle: "A regulator tube"
	quest.2B80E1852C650AD6.quest_subtitle: "Yummy!"
	quest.2B8FD70ED00C97CD.quest_desc: [
		"The Thallasium Hoe is a &afarming&r tool forged from Thallasium Ingots, used to prepare farmland."
		""
		"It's part of the earliest tier of Better End's &btool&r progression."
	]
	quest.2B8FD70ED00C97CD.quest_subtitle: "Farming tool of the first tier"
	quest.2BB0FB60CB5B2E7C.quest_desc: ["&6Needed&r for electric motors and generators. It is made when an Electromagnet processes Andesite Alloy, and an iron ingot lying near a &blightning&r strike also has a chance to get magnetized."]
	quest.2BB0FB60CB5B2E7C.quest_subtitle: "A natural magnet"
	quest.2BB57849AB8C3F99.quest_desc: [
		"&dAmethyst&r Rapier is a craftable imbued sword in Iron's Spells 'n Spellbooks. It can be imbued with 1 spell and comes with Echoing Strikes &bV&r already imbued."
		""
		"When held in the main hand, it provides &b8&r Attack Damage and &b2.3&r Attack Speed. Echoing Strikes V deals &b75%&r Damage, creates &b7&r Echoing Hits, costs &b90&r Mana and has a &b30-second&r cooldown."
		""
		"It is crafted &busing&r Amethyst Shards and Chains."
	]
	quest.2BB57849AB8C3F99.quest_subtitle: "Strike with the speed of resonating amethyst"
	quest.2BC45EC14C31CF98.quest_subtitle: "Yummy!"
	quest.2BD1540D539C2697.quest_subtitle: "More Armor"
	quest.2BD43313ACBB6D84.quest_desc: [
		"&eSnow&r is no &bobstacle&r when you know how to walk on it."
		""
		"Snowshoes &bincrease&r your movement speed on snow and allow you to walk safely across powdered snow without sinking. Perfect for &bexploring&r frozen biomes where ordinary boots would leave you stuck."
		""
		"&bStep&r lightly. The snow will hold you."
	]
	quest.2BD43313ACBB6D84.quest_subtitle: "Walk where the snow would swallow you"
	quest.2BE65A6041AC87BD.quest_subtitle: "More Armor"
	quest.2BEA0EC499751B7E.quest_desc: [
		"&9&lTake&r&r your Refined Storage network beyond simple item storage with the Autocrafting Upgrade. It enables your system to automatically craft &brequested&r items &busing&r stored resources and configured crafting patterns."
		""
		"&bSet&r up your crafting patterns, connect the required machines and let your network handle production for you. From &bbasic&r components to complex recipes, automation takes care of the work."
	]
	quest.2BEA0EC499751B7E.quest_subtitle: "Automate your crafting from start to finish"
	quest.2C077F925EB919B7.quest_desc: ["&aObtain&r a Sandworm Dart from the Bosses' Rise mod. This rare item is &bdropped&r by the Sandworm, the colossal predator that lurks beneath the desert sands. Claim this deadly trophy after &bdefeating&r the beast."]
	quest.2C077F925EB919B7.quest_subtitle: "A venomous trophy from the desert predator"
	quest.2C0FF89F850634EF.quest_desc: [
		"&9&lManage&r&r your automated crafting system with the Autocrafter Manager. It gives you greater control over the Autocrafters &bconnected&r to your Refined Storage network, making it easier to organize and manage &bcomplex&r crafting setups."
		""
		"&bUse&r it to keep your automated production organized and ensure your crafting network runs smoothly."
	]
	quest.2C0FF89F850634EF.quest_subtitle: "Take full control of your automated crafting"
	quest.2C18AB90FCF7553C.quest_subtitle: "More Armor"
	quest.2C23F02C83E2091F.quest_desc: [
		"The Aeternium Sword Handle is a crafting component used to assemble an Aeternium Sword at the &aSmithing Table&r."
		""
		"It's needed to complete Better End's &bstrongest&r bladed weapon."
	]
	quest.2C23F02C83E2091F.quest_subtitle: "Grip for an Aeternium blade"
	quest.2C2DAA65F0DCBFB6.quest_subtitle: "Yummy!"
	quest.2C32A8D56584EC9D.quest_subtitle: "Yummy!"
	quest.2C722B4A34985C44.quest_desc: ["&dSolaris&r is a flaming sword from Celestisynth. It is designed for mobility and &bcontinuous&r damage. The &bmaterial&r required to create it can be found in the Nether."]
	quest.2C722B4A34985C44.quest_subtitle: "Flame of the Sun"
	quest.2C722B4A34985C44.title: "&l&6Solaris"
	quest.2C735E9DB2A5A009.quest_desc: [
		"&9&lKeep&r&r your storage &bfree&r from unwanted items with the Void Upgrade. It automatically destroys items that match your configured filters, preventing &bunwanted&r resources from filling valuable storage space."
		""
		"The Advanced Void Upgrade provides more &bprecise&r filtering and greater control over which items are &bsent&r into the void, making it ideal for fully automated storage systems."
	]
	quest.2C735E9DB2A5A009.quest_subtitle: "Make unwanted items disappear forever"
	quest.2C735E9DB2A5A009.title: "Void \\& Advanced Void Upgrade"
	quest.2C7C0D132A3A82E6.quest_subtitle: "Yummy!"
	quest.2C92519EF7630B9E.quest_subtitle: "Yummy!"
	quest.2C9E9839B9EF169B.quest_desc: ["&6Sweet&r berries become an even better treat when covered in dark chocolate. Inject 250 mB of Dark Chocolate into Sweet Berries to create this &bdelicious&r combination. Each serving restores &b7&r hunger and &b11.2&r saturation, while granting Stimulation for &b6&r seconds."]
	quest.2C9E9839B9EF169B.quest_subtitle: "Sweet berries covered in rich dark chocolate."
	quest.2CB3E4E142A189BD.quest_subtitle: "More Weapon"
	quest.2CCE8F18ECC0B1D4.quest_desc: ["&6The&r Quality Tool Handle is a crafting component used in the recipes of certain tools from Create Stuff 'N Additions. It &breplaces&r the ordinary Stick in these recipes, providing a more specialized handle for &bhigher-quality&r equipment."]
	quest.2CCE8F18ECC0B1D4.quest_subtitle: "A better handle for better tools"
	quest.2D1A20BB5B5C9C8E.quest_subtitle: "Yummy!"
	quest.2D1B28A5BC4D0B0F.quest_desc: [
		"&9&lGive&r&r your storage the ability to smoke food with the Smoking Upgrade. It allows compatible items to be processed &busing&r the functionality of a smoker directly from your storage."
		""
		"&bTake&r it a step further with the Auto-Smoking Upgrade and automate the entire process. Let your storage handle the input, fuel and finished &bproducts&r while you focus on more important tasks."
	]
	quest.2D1B28A5BC4D0B0F.quest_subtitle: "Turn your storage into a portable smoker"
	quest.2D1B28A5BC4D0B0F.title: "Smoking \\& Auto-Smoking Upgrade"
	quest.2D43CCFE92FB407A.quest_desc: [
		"&aThe&r Thermal Springstone Leggings are protective leg armor from Eternal Starlight crafted &busing&r Thermal Springstone Ingots."
		""
		"&aEach&r piece of Thermal Springstone armor ignites attacking enemies and reduces incoming fire damage, providing excellent protection in hot and &bdangerous&r environments."
	]
	quest.2D43CCFE92FB407A.quest_subtitle: "Flame-resistant leg armor"
	quest.2D51FF8457909F5F.quest_desc: ["&6Welcome&r to Create: New Age! Expand your Create factory with electricity, motors, generators and heat-based technology. Harness &bmagnetic&r power, generate electricity from &brotational&r energy, transport and manage heat, and eventually unlock &bpowerful&r reactor technology. Build your electrical infrastructure step by step and bring your factory into a new &btechnological&r age."]
	quest.2D51FF8457909F5F.quest_subtitle: "    Power your factory with electricity"
	quest.2D51FF8457909F5F.title: "&l&6Welcome Create New Age"
	quest.2D5224DB95345E46.quest_desc: ["Craft an &aEnchanting Table&r to enhance your tools, weapons, and armor using magic. Enchanting greatly improves their effectiveness, durability, and grants special abilities. This is a crucial step in your progression and preparation for tougher challenges."]
	quest.2D5224DB95345E46.quest_subtitle: "Magic that empowers your gear"
	quest.2D5224DB95345E46.title: "&bEnchanting &cTable"
	quest.2D5F025642CA4CFA.quest_desc: ["&6Brass&r Boots are part of the Brass Suit from Create Stuff 'N Additions. They are &bcrafted&r from 4 Brass Ingots and have &b325&r durability, making them a durable piece of the brass armor set."]
	quest.2D5F025642CA4CFA.quest_subtitle: "Step into brass"
	quest.2D6E66D71EC8F571.quest_desc: [
		"&dHoly&r Upgrade Orb is an upgrade material in Iron's Spells 'n Spellbooks. When applied at the Arcane Anvil, it grants &b+5%&r Holy Spell Power."
		""
		"Craft it from 1 Empty Upgrade Orb and 8 Holy Runes. By default, Upgrade Orbs can be applied to an &bapplicable&r item up to 3 times."
	]
	quest.2D6E66D71EC8F571.quest_subtitle: "Infuse your equipment with the power of Holy magic"
	quest.2D9A16104E931363.quest_subtitle: "More Weapon"
	quest.2DA48695BE44AD3D.quest_desc: [
		"&dPyromancer&r Boots are an upgraded version of the Pyromancer Boots from Iron’s Spells ’n Spellbooks. They are enhanced using a Volcanite Shard, &binfusing&r the original Pyromancer equipment with additional crystalline power."
		""
		"Volcanite Shards are used to &bupgrade&r the Iron’s Spells ’n Spellbooks Pyromancer Armor set into its enhanced Crystal Chronicles version."
	]
	quest.2DA48695BE44AD3D.quest_subtitle: "An enhanced form of Pyromancer Boots, empowered by Volcanite"
	quest.2DA50FFFCEAC95A3.quest_subtitle: "Yummy!"
	quest.2DBE999CEB347B12.quest_desc: ["&aObtain&r a Bobber from Aquaculture 2. This fishing &baccessory&r is used to upgrade fishing rods and improve your fishing equipment. Combine it with the right materials to create specialized fishing rods with &bdifferent&r bonuses."]
	quest.2DBE999CEB347B12.quest_subtitle: "A small upgrade for better fishing"
	quest.2E03C166D14B0D0D.quest_subtitle: "More Armor"
	quest.2E0A9B0A60A0873A.quest_desc: [
		"The Terminite Helmet is crafted from Terminite Plating at a Smithing Table, offering improved protection over Thallasium."
		""
		"It's also the base piece used to craft the stronger &bCrystalite&r and &bAeternium&r helmets."
	]
	quest.2E0A9B0A60A0873A.quest_subtitle: "Headgear of the second tier"
	quest.2E0F5CFCE625F843.quest_desc: ["&6Obtain&r a Display Link from Create. &bIt&r reads information from compatible blocks and sends it to &bdisplay&r blocks such as Nixie Tubes, Display Boards, Signs, Hanging Signs, and Lecterns. It can display information such as item names, inventory levels, train status, rotation speed, stress, fluid information, and more. The default linking range is &b64&r blocks."]
	quest.2E0F5CFCE625F843.quest_subtitle: "Turn information into knowledge"
	quest.2E2A3EA2FE65E787.quest_desc: [
		"&aCraft&r the Arctic Leggings using soft Arctic Fur gathered from the &bfrozen&r wilderness of the Twilight Forest. Expertly stitched to preserve warmth while allowing &bcomplete&r freedom of movement, these leggings are built for adventurers who refuse to let the harsh &bclimate&r slow them down."
		""
		"&aAs&r an &bessential&r part of the Arctic Armor set, they provide dependable protection against the relentless cold and the dangers lurking within the Glacier. Every &bstep&r through the snow proves that neither ice nor &bfreezing&r winds can stop your journey toward the Twilight Forest's greatest challenges."
	]
	quest.2E2A3EA2FE65E787.quest_subtitle: "Stand strong against the endless frost"
	quest.2E2E94F1E53D44EE.quest_subtitle: "Yummy!"
	quest.2E2EF29BA660A19C.quest_desc: ["&6Craft&r the Gamba pipe and add another distinctive &bvoice&r to your pipe organ. Gamba is one of the original pipe types in Create: Sound of Steam, introduced alongside Gedackt, Diapason, Piccolo, Subbass, Trompette &band&r Nasard."]
	quest.2E2EF29BA660A19C.quest_subtitle: "Add a rich string-like voice"
	quest.2E35F2A4FAE14DFC.quest_desc: [
		"&aThe&r Deepsilver Leggings are protective leg armor from Eternal Starlight crafted &busing&r Deepsilver Ingots."
		""
		"Deepsilver armor &aincreases&r movement speed, attack speed, and knockback resistance, while the full set grants immunity to several &bnegative&r effects."
	]
	quest.2E35F2A4FAE14DFC.quest_subtitle: "Swift silver leg armor"
	quest.2E423B867205D22D.quest_desc: ["&6The&r Schematic and Quill lets you capture and save structures as Create schematic files. Right-click to select the first corner of an area, then select the &bopposite&r corner to define the structure. You can adjust the &bselection&r before saving it as an .nbt file in the schematics folder. Once saved, the structure can be loaded onto an Empty Schematic using a Schematic Table and later &bplaced&r or built with a Schematicannon."]
	quest.2E423B867205D22D.quest_subtitle: "Save your creations"
	quest.2E6D334A2AFD8D1A.quest_subtitle: "More Armor"
	quest.2E76E25C0E285936.quest_desc: [
		"&aSteeleaf&r is a mysterious material found within the Twilight Forest, hidden inside the hollow trunks of giant &btrees&r and other natural structures. Although it resembles an ordinary leaf, it possesses the strength of steel and the magic of the forest, making it an exceptional crafting material."
		""
		"&aSteeleaf&r can be used to craft a complete set of armor, durable tools, and reliable weapons, making it one of the first major equipment upgrades available &bwithin&r the Twilight Forest."
	]
	quest.2E76E25C0E285936.quest_subtitle: "A gift from the enchanted forest"
	quest.2EBBEB2B3FBF7ACC.quest_desc: ["Your journey into &aadvanced &r&bmaterials&r continues. These boots combine the resilience of Netherite with the reliability of iron, giving you better&a protection&r for long travels and dangerous encounters."]
	quest.2EBBEB2B3FBF7ACC.quest_subtitle: "Stronger steps"
	quest.2EBBEB2B3FBF7ACC.title: "Iron Netherite Boots"
	quest.2EC744419A904B68.quest_desc: ["&6Obtain&r a Hose Pulley from Create. It allows you to drain or fill large bodies of fluid by lowering and raising its hose. When &bconnected&r to a Mechanical Pump and Fluid Pipes, it can extract fluids from the world or &bdistribute&r them into large areas. Water and lava can normally be treated as &bbottomless&r fluid sources when the required conditions are met."]
	quest.2EC744419A904B68.quest_subtitle: "Harness the power of vast fluid reserves"
	quest.2ECD7AAF2A7D9A68.quest_desc: [
		"The Glacite Scythe is a &afrost-infused&r area weapon from Eternal Starlight crafted &busing&r Glacite Ingots."
		""
		"&aIt&r is &bused&r for wide-range melee attacks and applies slowing effects to enemies, making it &beffective&r for crowd control in cold biomes."
	]
	quest.2ECD7AAF2A7D9A68.quest_subtitle: "Frost area weapon"
	quest.2ECEB94C026B5EF5.quest_desc: ["&aObtain&r The Incinerator from the Cataclysm mod. Forged from the &blegendary&r power of Ignis, this &bdevastating&r greataxe engulfs enemies in scorching flames and leaves nothing but ashes in its wake. A weapon worthy of those who have &bconquered&r the Burning Arena."]
	quest.2ECEB94C026B5EF5.quest_subtitle: "Reduce all to ash"
	quest.2ECEB94C026B5EF5.title: "&cThe Incinerator"
	quest.2EF4BBA4470B35A0.quest_desc: [
		"&eSome&r forces are meant to be resisted."
		""
		"Steadfast Spikes &bmake&r you completely immune to knockback and reduce the &bslipperiness&r of ice &bbeneath&r your feet. Whether you're fighting powerful enemies or &bcrossing&r frozen terrain, these spikes keep you firmly in control."
		""
		"&bHold&r your ground. Nothing can push you back."
	]
	quest.2EF4BBA4470B35A0.quest_subtitle: "Stand your ground"
	quest.2EFCA294AB118D03.quest_desc: ["&dHermomancer&r Boots are part of the Hermomancer Armor set from Crystal Chronicles, an &baddon&r for Iron’s Spells ’n Spellbooks."]
	quest.2EFCA294AB118D03.quest_subtitle: "Harness the power of the Hermomander"
	quest.2F051F1116EFDD82.quest_desc: ["&aCraft&r Neptunium Chestplate from Aquaculture 2. This powerful chestplate is made from Neptunium, a &brare&r &bmaterial&r obtained from fishing treasures. It provides excellent &bprotection&r and is part of the Neptunium armor set."]
	quest.2F051F1116EFDD82.quest_subtitle: "Armor forged from ocean treasures"
	quest.2F05AAB8DC941C72.quest_desc: ["&aObtain&r Neptune's Bounty from Aquaculture 2. This &brare&r fishing loot item can be obtained while fishing and contains valuable ocean-related rewards. It is one of the &bspecial&r treasures that can be &bdiscovered&r during advanced fishing."]
	quest.2F05AAB8DC941C72.quest_subtitle: "A treasure from the depths"
	quest.2F05DFA770A02239.quest_subtitle: "More Armor"
	quest.2F0AC3A6DC8CC188.quest_desc: [
		"To &alocate&r the Lunar Monstrosity in Eternal Starlight, the Seeking Eye must be used with specific natural materials."
		""
		"&aHold&r the Seeking Eye in your main hand, and place one of the following items in your off-hand."
		"Only then will the Eye guide you toward the Cursed Garden — the structure where the boss resides."
		""
		"Valid items:"
		""
		"&bVines&r"
		"&bLunar Berries&r"
		"&bCave Moss / Cave Moss Block / Cave Moss Carpet&r"
		"&bRed Crystal Moss (Block / Carpet)&r"
		"&bBlue Crystal Moss (Block / Carpet)&r"
		"&bRed Crystal Roots&r"
		"&bBlue Crystal Roots&r"
		""
		"These &aitems&r resonate with the environment and allow the Eye to detect the correct location."
	]
	quest.2F0AC3A6DC8CC188.quest_subtitle: "Follow the lunar signal"
	quest.2F0AC3A6DC8CC188.title: "Find Boss"
	quest.2F2A2E6FBF977E41.quest_desc: ["&6The&r Reactor Casing is a structural component &bused&r to build the reactor in Create: New Age. Assemble the casing together with the &brequired&r reactor components to create a stable structure capable of handling the intense heat &bgenerated&r during nuclear power production."]
	quest.2F2A2E6FBF977E41.quest_subtitle: "Build the foundation of a reactor"
	quest.2F3A00428DA266F7.quest_desc: [
		"&dThe&r Wicked Bone Ring grants +1 Spell Projectile Ricochet, allowing compatible spell projectiles to ricochet an additional time. This &bpowerful&r curio can turn a single projectile into an even greater threat by letting it bounce &bbetween&r targets."
		""
		"The ring is an Ominous Dead King reward, making it a rare and valuable addition to any &bspellcaster's&r arsenal."
	]
	quest.2F3A00428DA266F7.quest_subtitle: "Make your spells ricochet between enemies"
	quest.2F3E7E519FD38CAD.quest_desc: ["&aDefeat&r the Deepslate Sentinel — a powerful guardian protecting the remnants of the &bancient&r civilizations. Face it in battle and prove that you are ready to delve deeper into the secrets of the Ancient Keep. In the current version of Archaion, its &bhealth&r has been increased to &b100&r HP, while its armor has been increased to 10"]
	quest.2F3E7E519FD38CAD.quest_subtitle: "Guardian of the Ancient Keep"
	quest.2F3E7E519FD38CAD.title: "Kill Deepslate Sentinel"
	quest.2F44A31E7A20C130.quest_desc: ["&aObtain&r the Unbreakable Skull from the Cataclysm mod. This ancient &bartifact&r is a rare trophy connected to the cursed warriors of the desert. Its unyielding nature &brepresents&r the strength of those who &bsurvived&r battles against ancient horrors."]
	quest.2F44A31E7A20C130.quest_subtitle: "A relic of unstoppable warriors"
	quest.2F55C2860311F78C.quest_desc: ["&aDefeat&r 15 Koboletons from the Cataclysm mod. These skeletal reptilian warriors inhabit the Desert Site, guarding its &bchambers&r and treasures. Eliminate them to safely &bexplore&r the ruins."]
	quest.2F55C2860311F78C.quest_subtitle: "Clear the ancient desert ruins"
	quest.2F55C2860311F78C.title: "Koboleton"
	quest.2F77BADABEAD5873.quest_subtitle: "More Weapon"
	quest.2F93E1B532D8E13B.quest_desc: [
		"&dEvocation&r Rune is a crafting ingredient in Iron's Spells 'n Spellbooks, used for advanced &bEvocation-related&r crafting, including Evocation Upgrade Orbs."
		""
		"&bCreate&r an Evocation Rune by combining a Blank Runestone with 8 Emeralds. Emeralds are the magical Focus for the Evocation school."
	]
	quest.2F93E1B532D8E13B.quest_subtitle: "Infuse a runestone with the power of Evocation magic"
	quest.2F9BC357C443A396.quest_desc: [
		"&bUsing&r the power of the Orb of Prophecy, you can now &aactivate&r the portal and enter a completely new dimension — a world filled with unknown dangers, strange biomes, and powerful secrets."
		""
		"This is the true &bbeginning&r of your journey into Eternal Starlight."
		"Be prepared — once you &bstep&r through, there is no turning back without risk."
	]
	quest.2F9BC357C443A396.quest_subtitle: "Step beyond the veil"
	quest.2F9BC357C443A396.title: "&l&bInto the &9Starlight"
	quest.2F9F0E46752067CF.quest_subtitle: "Upgrade+"
	quest.2FAD369DA5B5A3C1.quest_desc: [
		"&9&lYour&r storage system is about to become a lot more sophisticated. With powerful storage blocks and &bupgradeable&r backpacks, you can organize your items, expand your capacity and take your supplies with you wherever you go."
		""
		"From your &bbase&r to the deepest caves, keep everything organized and within reach."
	]
	quest.2FAD369DA5B5A3C1.quest_subtitle: "Smarter storage, wherever you go"
	quest.2FAD369DA5B5A3C1.title: "&l&bWelcome Sophisticated"
	quest.2FB6C3D80DBF4CC7.quest_desc: [
		"&6Give&r your locomotive a refined industrial &bappearance&r with the Copper Wrapped Locometal Boiler. Combining rugged Locometal with a copper exterior, this boiler is perfect for creating a &bdistinctive&r steam locomotive with a warm metallic finish."
		""
		"&bBuild&r it into your locomotive and let the copper shine."
	]
	quest.2FB6C3D80DBF4CC7.quest_subtitle: "Copper-clad power for a distinguished steam locomotive."
	quest.2FC72A4BCC38597D.quest_subtitle: "More Weapon"
	quest.2FCE923A68B9541A.quest_desc: [
		"Your journey is becoming more dangerous, and basic tools are no longer enough."
		"&aDiamonds allow you to craft&r stronger and more durable equipment that will help you mine faster and fight tougher enemies."
		""
		"With these powerful tools, gathering resources and defending yourself will become much easier."
	]
	quest.2FCE923A68B9541A.quest_subtitle: "A True Upgrade"
	quest.2FCE923A68B9541A.title: "Diamond Tools"
	quest.2FF11FA214BA1F33.quest_subtitle: "More Armor"
	quest.2FFD72500A1A1AD1.quest_desc: ["&aThe&r Echo Mace is a unique weapon tied to the &bmysteries&r of the ancient warriors. Obtaining it is another &bstep&r toward uncovering the remnants of a fallen civilization."]
	quest.2FFD72500A1A1AD1.quest_subtitle: "Obtain the Echo Mace"
	quest.2FFD72500A1A1AD1.title: "&bEcho Mace"
	quest.300FCFB0D0A8ABF6.quest_desc: [
		"&l&9Every&r&r great storage system &bneeds&r a solid foundation. The Upgrade Base is the essential component used to create powerful upgrades for your storage containers."
		""
		"Craft one and &bstart&r turning your ordinary storage into something far more sophisticated."
	]
	quest.300FCFB0D0A8ABF6.quest_subtitle: "The foundation of a better storage system"
	quest.30169528A9C24453.quest_desc: ["&aObtain&r the Wrath of the Desert from the Cataclysm mod. This &blegendary&r bow is a powerful ranged weapon &bconnected&r to the ancient desert civilization. Harness the power of sandstorms and strike your enemies from afar with the &bfury&r of the desert."]
	quest.30169528A9C24453.quest_subtitle: "The bow that commands the desert storm"
	quest.30169528A9C24453.title: "&eWrath Of The Desert"
	quest.301804DB605CE430.quest_desc: ["&dRainfall&r Serenity is a futuristic longbow that fires &blasers&r capable of piercing through targets. It is designed for dealing damage from long range. Its base material can be &bcrafted&r and brewed from Crescentia's base material."]
	quest.301804DB605CE430.quest_subtitle: "Rain of Stars"
	quest.301804DB605CE430.title: "&l&9Rainfall Serenity"
	quest.304BC5C3121C8725.quest_desc: ["&aObtain&r the Ignitium Upgrade Smithing Template from the Cataclysm mod. This &brare&r template is required to upgrade Netherite &bequipment&r into Ignitium gear, unlocking the full potential of the &blegendary&r metal forged in the fires of the Nether."]
	quest.304BC5C3121C8725.quest_subtitle: "Unlock the power of Ignitium"
	quest.305111084C34764F.quest_subtitle: "More Armor"
	quest.305E4A5E0198D58D.quest_desc: ["&6Craft&r the Card Reader and use it to validate scripted Cards &bcreated&r with the Card Inscriber. It checks the card's registered information and can provide a redstone output, making it &buseful&r for authentication and automated systems."]
	quest.305E4A5E0198D58D.quest_subtitle: "Validate your scripted cards"
	quest.309C1F26A5EA3BEC.quest_desc: ["&6Craft&r the Encased Chain Cogwheel and expand your kinetic &bnetwork&r with a compact chain-driven connection. It can &bconnect&r alongside other chain components, allowing &brotational&r power to travel through compact layouts and around corners. Its cogwheel can also connect to large cogwheels."]
	quest.309C1F26A5EA3BEC.quest_subtitle: "Connect rotation in every direction"
	quest.30AA2D41FD209797.quest_desc: [
		"&dThe&r Frostbranded Book is a &btop-tier&r Ice spellbook in Iron's Spells 'n Spellbooks. It provides &b12&r spell slots, &b+10%&r Ice Spell Power and &b+200&r Max Mana, making it an excellent choice for a mage specializing in frost magic."
		""
		"Craft this &bpowerful&r tome and harness the freezing forces of Ice magic."
	]
	quest.30AA2D41FD209797.quest_subtitle: "Command the freezing power of ice"
	quest.30B39FFA91754BFE.quest_desc: [
		"&dCryomancer&r Helmet is the Crystal Chronicles upgraded version of the Cryomancer Hood from Iron’s Spells ’n Spellbooks."
		""
		"It is &bupgraded&r using a Cryolite Shard, which &benhances&r the original Cryomancer Armor set with &badditional&r crystalline power. The Cryolite Shard strengthens the helmet with the power of Ice magic, creating an improved version of the original Cryomancer gear."
	]
	quest.30B39FFA91754BFE.quest_subtitle: "An enhanced form of Cryomancer Hood, empowered by Cryolite"
	quest.30BB8A9C18CFE18E.quest_desc: [
		"&aDefeat&r Endermaptera, small insect-like mobs that swarm throughout the Ruined Citadel."
		""
		"They drop &bVoid Jaws&r, the crafting ingredient needed to make Void Scatter Arrows."
	]
	quest.30BB8A9C18CFE18E.quest_subtitle: "Insects of the ruined halls"
	quest.30C281D293B85B4F.quest_desc: ["&dA&r rare crafting material used in various recipes for &bpowerful&r equipment and special items in Hazen N Stuff."]
	quest.30C281D293B85B4F.quest_subtitle: "A rare material for powerful crafting"
	quest.30CB87E7B9690B32.quest_desc: [
		"&9&lYour&r&r fluid storage has reached an enormous scale. The 4096B Fluid Storage Disk provides an immense &bamount&r of digital fluid storage, allowing your Refined Storage network to &bhold&r vast quantities of liquids in a single disk."
		""
		"Insert it into a Disk Drive and take your &bcentralized&r fluid storage system to an entirely new level."
	]
	quest.30CB87E7B9690B32.quest_subtitle: "Handle colossal reserves of fluids with ease"
	quest.30DB0BFD5B8949C8.quest_desc: ["&6Create&r Merlot, a classic red wine for your automated winery. &bUse&r the Wine Cellar to process the necessary ingredients and turn your grape harvest into another refined addition to your collection of wines. Create: Winery adds &bwine-themed&r recipes and a fully automatable Wine Cellar to Create."]
	quest.30DB0BFD5B8949C8.quest_subtitle: "Smooth, rich, and ready to mature"
	quest.30DFDB44C1070132.quest_subtitle: "More Armor"
	quest.30E351C55C201DF1.quest_desc: ["&6Craft&r the Tube Scanner &bAttachment&r and add redstone detection to your Hypertube network. When an entity passes through the tube, the attachment emits a redstone signal, allowing you to trigger doors, machines, lights, or other &bautomated&r systems."]
	quest.30E351C55C201DF1.quest_subtitle: "Detect every traveller"
	quest.30F4F283FB6379BB.quest_desc: [
		"&aCraft&r an Iron Hook, a reliable &bupgrade&r for any serious angler. Forged from sturdy iron, this hook is designed to withstand the pull of stronger catches and the &bchallenges&r of fishing in deeper waters."
		""
		"&aAs&r your journey takes you beyond simple &bfishing&r and toward the greatest treasures of the ocean, improving every part of your equipment &bbecomes&r essential. The Iron Hook is a small but important step toward mastering the seas."
	]
	quest.30F4F283FB6379BB.quest_subtitle: "A stronger grip beneath the waves"
	quest.30F8EBE91C2E26C0.quest_subtitle: "More Armor"
	quest.3109C994B3645D62.quest_desc: ["&aObtain&r a Witherite Ingot, a powerful alloy created from the fusion of the Wither’s power and the &btechnology&r of an ancient civilization. This rare &bmaterial&r is used to create advanced &bequipment&r and the Mechanical Fusion Anvil."]
	quest.3109C994B3645D62.quest_subtitle: "Forged from the essence of the Wither"
	quest.3109FC38A54D2EE5.quest_subtitle: "More Armor"
	quest.3124CC63454C3569.quest_desc: [
		"&9&lTake&r&r your fluid storage to the next level with the 1024B Fluid Storage Disk. With vastly increased capacity, it allows your Refined Storage network to &bhold&r enormous quantities of fluids while keeping everything &baccessible&r from a centralized system."
		""
		"Insert it &binto&r a Disk Drive and build a fluid storage network capable of handling even your largest reserves."
	]
	quest.3124CC63454C3569.quest_subtitle: "Store an incredible amount of fluids in one disk"
	quest.3127A14025718485.quest_desc: ["&6The&r Gatling Breaker is an advanced mechanical tool from Create: Dreams n' Desires. Designed for rapid block breaking, it delivers a &bcontinuous&r stream of mechanical force, making &blarge-scale&r excavation and automated mining much faster."]
	quest.3127A14025718485.quest_subtitle: "Break blocks at machine-gun speed"
	quest.312F446F79636DC4.quest_desc: ["&6Craft&r the Fan Smoking Catalyst and use it in an Encased Fan setup to perform bulk smoking without needing a campfire in the airflow. It acts as a &bdedicated&r catalyst for Create's smoking recipes, keeping the &bprocessing&r setup compact and clean. Create: Connected includes Fan Catalysts as &bpart&r of its feature set."]
	quest.312F446F79636DC4.quest_subtitle: "Smoke without the campfire"
	quest.314065C484AF5254.quest_subtitle: "Yummy!"
	quest.31420AEE989BC381.quest_desc: [
		"&aObtain&r a Shulker Shell, dropped by Shulkers found in End Cities."
		""
		"It's used to craft Shulker Boxes, and required as one of the ingredients for the Void Totem mod's &bTotem of Void Undying&r."
	]
	quest.31420AEE989BC381.quest_subtitle: "The secret to levitating stacks"
	quest.31420AEE989BC381.title: "Shulker Shell"
	quest.314735DD099CCAFC.quest_subtitle: "More Armor"
	quest.3171206E89391DEF.quest_desc: ["&6The&r Handheld Saw is a portable tool from Create: Dreams n' Desires &bdesigned&r for quick material processing. Keep it on hand when working around your factory and &buse&r it to handle &bcutting&r tasks without relying on a stationary machine."]
	quest.3171206E89391DEF.quest_subtitle: "Cut materials wherever you go"
	quest.31798839F4E5E6CF.quest_desc: [
		"&aSpider Eyes&r are dropped by spiders and cave spiders, and are commonly used in potion brewing."
		"They are a key ingredient for crafting negative effect potions such as Poison, Weakness, and Invisibility (when fermented)."
		"Handle them carefully — their toxic nature makes them &bdangerous&r even in &balchemical&r form."
	]
	quest.31798839F4E5E6CF.quest_subtitle: "Toxic brewing ingredient"
	quest.319E03DD80DA5441.quest_subtitle: "Yummy!"
	quest.31A114861FB09266.quest_desc: [
		"&dRing&r of Diffraction is a &bpowerful&r accessory from Crystal Chronicles."
		""
		"To &buse&r its full power, you must have the complete Prismatic Knight Armor set equipped. Once the full set is worn and the Ring of Diffraction is &bequipped&r, press R to change your current magic type."
		""
		"The ring &ballows&r the Prismatic Knight to switch &bbetween&r different types of magic, making the complete Prismatic Knight set extremely versatile."
	]
	quest.31A114861FB09266.quest_subtitle: "A prismatic ring that allows the wearer to change their magic type"
	quest.31A114861FB09266.title: "&l&cRi&6ng &eOf &aDi&bff&9ra&dct&5ion"
	quest.31A2EFE52AD1F45B.quest_desc: [
		"&9&lThe&r&r Oak Chest is one of the basic storage containers from Sophisticated Storage. It provides a reliable place to store your items while &bsupporting&r the mod's powerful upgrade system."
		""
		"&bUse&r it as the foundation for a storage setup that can later be expanded with larger capacities, automation and &bspecialized&r upgrades."
	]
	quest.31A2EFE52AD1F45B.quest_subtitle: "Start building your sophisticated storage system"
	quest.31ADB10258F9AA04.quest_desc: [
		"&6The&r standard Boiler is useful, but steel can &btake&r things further. The Steel Boiler provides your aircraft with greater power, allowing you to push your machine beyond its basic limits."
		""
		"Upgrade your boiler and prepare your aircraft for more &bdemanding&r flights."
	]
	quest.31ADB10258F9AA04.quest_subtitle: "More power for those who demand more from their aircraft."
	quest.31BF966ACD65359B.quest_desc: [
		"&dDivine&r Pearl is the Holy Focus in Iron's Spells 'n Spellbooks. It is &bused&r to create Holy spells in the Scroll Forge and to craft Holy Runes."
		""
		"Craft it from 1 Gold Ingot and 1 Amethyst Shard, or find it in magical structures. The Divine Pearl is the core &bfocus&r of Holy magic, which specializes in healing, support and buffs."
	]
	quest.31BF966ACD65359B.quest_subtitle: "Channel the sacred power of the Holy school"
	quest.31C9751A66E461AF.quest_desc: ["&dA&r special rune &bused&r to craft Shadow weapons and armor in Hazen N Stuff."]
	quest.31C9751A66E461AF.quest_subtitle: "A rune infused with the power of shadows"
	quest.31D8E8CBEEE1B7B7.quest_desc: [
		"&aCraft&r the Knightmetal Chestplate using refined Knightmetal &bIngots&r forged from the &blegendary&r alloy of the Goblin Stronghold. Once worn by the fortress' elite defenders, this formidable armor was built to withstand &brelentless&r assaults and protect its bearer in the fiercest battles."
		""
		"&aAs&r the centerpiece of the Knightmetal Armor set, the &bchestplate&r combines incredible &bdurability&r with exceptional protection. Forged for those who refuse to yield, it stands as a symbol of unwavering courage and the enduring &blegacy&r of the ancient knights of the Twilight Forest."
	]
	quest.31D8E8CBEEE1B7B7.quest_subtitle: "The armor of an unbreakable guardian"
	quest.31E2FF67DAA74439.quest_desc: [
		"&aCarminite&r is a mysterious magical material found within the Dark Tower. Created through forgotten &bexperiments&r and powered by ancient energy, it serves as the foundation for many of the tower's strange machines and &bmechanical&r creations."
		""
		"&aThis&r rare resource is essential for crafting &badvanced&r devices and powerful equipment unique to the Twilight Forest. By mastering the secrets of Carminite, you take another step toward understanding the forgotten &btechnology&r hidden within the Dark Tower."
	]
	quest.31E2FF67DAA74439.quest_subtitle: "The mysterious power of the Dark Tower"
	quest.31E5091B64509956.quest_desc: ["&6A&r coil is part of many devices: gauges, the electromagnet, rotors, motors and relays. Right-clicking two Create shafts with it makes a generator winding."]
	quest.31E5091B64509956.quest_subtitle: "A coil for many devices"
	quest.31F314955A039D53.quest_subtitle: "Upgrade+"
	quest.31F69C866AC1F37F.quest_desc: [
		"A &ashield&r is an &bessential&r tool for defending yourself against enemies."
		"It can block many attacks and protect you from arrows and melee damage."
		""
		"Craft a shield and use it to survive dangerous battles."
	]
	quest.31F69C866AC1F37F.quest_subtitle: "Block Incoming Attacks"
	quest.324156897AAC5D6B.quest_desc: ["&6The&r world looks different from above. Immersive Aircraft brings a collection of rustic, vanilla-style aircraft &bdesigned&r for travel, transport and exploration. From the classic Biplane to the &bpowerful&r Warship, there is an aircraft for every kind of pilot."]
	quest.324156897AAC5D6B.quest_subtitle: "Take to the skies and explore the world from above."
	quest.324156897AAC5D6B.title: "&l&6Welcome Immresive Aircraft"
	quest.324A2404CAE5D9F2.quest_desc: ["The Starlit Diamond Hoe is a &alate-game&r farming tool from Eternal Starlight, crafted using Starlit Diamond materials. It is used for preparing farmland in &badvanced&r biomes and represents the highest tier of farming progression &bbefore&r celestial-endgame materials."]
	quest.324A2404CAE5D9F2.quest_subtitle: "Late-game celestial farming tool"
	quest.324ACE5BF3AA1334.title: "woooo"
	quest.3258322768C3F151.quest_desc: ["&aCraft&r a Cursium Helmet from the Cataclysm mod. This powerful helmet is created by upgrading a Netherite Helmet with a Cursium &bUpgrade&r Smithing Template and a Cursium Ingot in a Smithing Table. It is part of the Cursium armor set and grants the &bGhost Vision&r ability, &ballowing&r you to reveal living entities through walls"]
	quest.3258322768C3F151.quest_subtitle: "See beyond the realm of the living"
	quest.325B1738E6BD1883.quest_desc: [
		"&aCraft&r a Safe to securely store your most valuable items."
		"Safes provide extra protection and help&b keep&r your resources organized and secure."
	]
	quest.325B1738E6BD1883.quest_subtitle: "Protect your valuables"
	quest.325B1738E6BD1883.title: "Safe"
	quest.325E233A78D94A7A.quest_desc: ["&6Craft&r the Candy Cane Shovel from Create: Confectionery and give your digging a festive touch. It is part of the Candy Cane Tools set, &badded&r alongside the Candy Cane Pickaxe, Axe, Sword, and Hoe."]
	quest.325E233A78D94A7A.quest_subtitle: "Dig with a sweet festive twist"
	quest.326849A066C4382D.quest_subtitle: "More Weapon"
	quest.32703A85EA177EB5.quest_subtitle: "Yummy!"
	quest.327FF2355EE63073.title: "GO"
	quest.3284081D45B07AF8.quest_desc: [
		"&dTimeless&r Slurry is a powerful crafting ingredient in Iron's Spells 'n Spellbooks. It is created in the Alchemist Cauldron by &bprocessing&r a Mundane Potion with an Echo Shard."
		""
		"This &bmysterious&r substance is required to upgrade the Decrepit Scythe into the Hellrazor and the Decrepit Flamberge &binto&r the Legionnaire Flamberge."
	]
	quest.3284081D45B07AF8.quest_subtitle: "A mysterious essence capable of transforming ancient weapons"
	quest.3286B298FA2FF4AC.quest_desc: ["&aThe&r Golden Trophy is a decorative trophy from My Nether's Delight. Its golden appearance makes it a striking &bdecoration&r and a great addition to your collection."]
	quest.3286B298FA2FF4AC.quest_subtitle: "A valuable golden trophy for your collection"
	quest.32929A14BDF323D1.quest_desc: ["&6Stairs&r of copper plating for building and decoration."]
	quest.32929A14BDF323D1.quest_subtitle: "Plating stairs"
	quest.32B6A7CA443F8DB5.quest_desc: ["&6Craft&r the Rohrflote pipe and expand your organ with another &bdistinctive&r flute stop. Rohrflote was &badded&r in Create: Sound of Steam 0.8.0 alongside six other new pipe types. It is a standard pipe stop rather than a reed pipe."]
	quest.32B6A7CA443F8DB5.quest_subtitle: "Add a clear and bright flute voice"
	quest.32C0207E83DBBDE3.quest_subtitle: "More Armor"
	quest.32C8DB1CF4737725.quest_desc: [
		"&aMeef&r Stroganoff is a hearty meal prepared using the rare Meef obtained from the Minoshroom. Rich in &bflavor&r and &bpacked&r with nutrients, this dish restores a large amount of hunger, making it the perfect meal before &bventuring&r deeper into the Twilight Forest."
		""
		"&aAlthough&r originally created from the meat of the &bLabyrinth's&r guardian, it has become a favorite meal among experienced adventurers seeking the &bstrength&r to face the dangers that lie ahead."
	]
	quest.32C8DB1CF4737725.quest_subtitle: "A hearty meal for fearless adventurers"
	quest.32D865C5E8120290.quest_desc: [
		"&dEvocation&r Upgrade Orb is an upgrade material in Iron's Spells 'n Spellbooks. When applied at the Arcane Anvil, it grants &b+5%&r Evocation Spell Power."
		""
		"It is &bcrafted&r from 1 Empty Upgrade Orb and 8 Evocation Runes."
	]
	quest.32D865C5E8120290.quest_subtitle: "Infuse your equipment with the power of Evocation magic"
	quest.32F1FBCC32A13EF3.quest_desc: [
		"&aDeep&r within the ruins of the Sunken City lurks one of the most terrifying &bcreatures&r ever to emerge from the abyss—the Leviathan. Awakened through an ancient ritual, this colossal sea monster commands the crushing pressure of the deep and wields &bdevastating&r abyssal magic against anyone &bfoolish&r enough to challenge it."
		""
		"&aThe&r battle is a true test of courage, preparation, and endurance. &bBetween&r its powerful jaws, sweeping tentacles, and deadly ranged attacks, few &badventurers&r survive long enough to &bwitness&r its downfall. Only the strongest warriors can claim victory over the ruler of the deep."
	]
	quest.32F1FBCC32A13EF3.quest_subtitle: "Conquer the ruler of the abyss"
	quest.32F1FBCC32A13EF3.title: "&l&5The Leviathan"
	quest.330476E04E2E98F1.quest_subtitle: "More Armor"
	quest.3305B00B00C05D3E.quest_desc: ["&6The&r Drone Controller is used to remotely control a Brass Drone. Pair it with your drone and take control of it from a distance, allowing you to &boperate&r your flying machine without having to &binteract&r with it directly. The Controller is crafted from &b4&r Brass Ingots and a Wireless Redstone Remote."]
	quest.3305B00B00C05D3E.quest_subtitle: "Take control from a distance"
	quest.331CF9517106F238.quest_desc: [
		"&aThe&r Crescent Spear is a &bmelee&r weapon from Eternal Starlight, associated with advanced progression and lunar-themed materials."
		""
		"Its exact &acrafting&r or acquisition method is not clearly documented in available public sources and may depend on JEI recipes, loot tables, or progression &bsystems&r within the mod."
	]
	quest.331CF9517106F238.quest_subtitle: "Moon-forged weapon"
	quest.331CF9517106F238.title: "&6Crescent Spear"
	quest.331F9072F848E6F9.quest_subtitle: "Upgrade+"
	quest.334715382080142C.quest_desc: ["&6Create&r a Bar of Dark Chocolate and enjoy one of the signature sweets from Create: Confectionery. The full chocolate bar can be eaten &bmultiple&r times and provides the Chocolated effect, making it both a tasty treat and a useful &bsnack&r for your adventures."]
	quest.334715382080142C.quest_subtitle: "A rich chocolate treat for your factory"
	quest.334735A30E13C3B7.quest_desc: ["&6Craft&r the Black Chocolate Bucket and store liquid Black Chocolate for use in your confectionery factory. Fill the bucket with chocolate &busing&r a Spout, then place the chocolate back into the world when needed. Chocolate buckets can also be drained into Create's fluid systems."]
	quest.334735A30E13C3B7.quest_subtitle: "Carry your chocolate wherever you go"
	quest.334BB22FEA032420.quest_desc: [
		"&l&9Your&r&r backpack can hold more than just items. The Tank Upgrade &badds&r fluid storage directly to your backpack, &ballowing&r you to carry water, lava and even fluids from other mods wherever you go."
		""
		"Fill and &bdrain&r the tank using fluid containers, or connect pipes when the backpack is placed in the world. Stack Upgrades can also increase its fluid capacity."
	]
	quest.334BB22FEA032420.quest_subtitle: "Carry an entire tank wherever you go"
	quest.33659C3E32075EE6.quest_desc: ["&6Create&r Cabernet Sauvignon, a rich and full-bodied red wine made from red grapes. In Create: Winery, it can be produced through the &bautomated&r winemaking process using the Wine Cellar. Cabernet Sauvignon is known for its &bdark-fruit&r character, firm tannins, and excellent aging potential."]
	quest.33659C3E32075EE6.quest_subtitle: "A bold classic from the vineyard"
	quest.3377B06DCFCF2653.quest_subtitle: "More Armor"
	quest.337FE86343F1B617.quest_subtitle: "More Armor"
	quest.33AB148F957977D0.quest_desc: ["&6The&r Brass Drone is a remotely &bcontrolled&r flying machine from Create Stuff 'N Additions. Turn it on with a right-click, then use the Drone Controller to control its movement from a distance. The drone can be &bupgraded&r with modules, including a Fan Module, Brass Drill, Vault Module and Magnet Module, giving it additional utility. If it lands, it stops flying until you take control and launch it again. The drone has &b6&r health points, so keep an eye on it while operating it."]
	quest.33AB148F957977D0.quest_subtitle: "Your eyes in the sky"
	quest.33B0E8E7730AF096.quest_desc: ["&6Craft&r the Nasard pipe and add another &bdistinctive&r stop to your pipe organ. Nasard is one of the &boriginal&r pipe types in Create: Sound of Steam, introduced alongside Gedackt, Diapason, Gamba, Piccolo, Subbass and Trompette."]
	quest.33B0E8E7730AF096.quest_subtitle: "Add a bright harmonic voice"
	quest.33B8071BA96D19CE.quest_desc: ["&aDefeat&r 5 Royal Draugr from the Cataclysm mod. These &belite&r undead warriors are stronger than ordinary Draugr and guard the depths of the Frosted Prison with powerful &bmelee&r attacks."]
	quest.33B8071BA96D19CE.quest_subtitle: "Defeat the elite of the frozen kingdom"
	quest.33B8071BA96D19CE.title: "Kill Royal Draugr"
	quest.33CC03E36372168D.quest_subtitle: "Yummy!"
	quest.33D9FA69D52EF86A.quest_desc: ["&6The&r casing most devices in this mod are built from: motors, gauges, fuses, contactors and more. You get it by applying a zinc ingot to an Andesite Casing."]
	quest.33D9FA69D52EF86A.quest_subtitle: "A conductive casing"
	quest.33F9F1682858EC41.quest_subtitle: "Upgrade+"
	quest.33FDF3929EC2EA6F.quest_subtitle: "More Armor"
	quest.34035A851B4A4368.quest_desc: ["&6The&r Fluid Gauge is a utility block from Create: Dreams n' Desires for monitoring fluid systems. Use it to keep track of fluids in your factory and make managing &blarge-scale&r fluid setups easier. In the &blatest&r 2.3a-BETA update, its display was also improved to show boiler statistics."]
	quest.34035A851B4A4368.quest_subtitle: "Keep an eye on your fluids"
	quest.34077458979AB44B.quest_desc: ["&6The&r vertical version of the commutator for vertically built generators."]
	quest.34077458979AB44B.quest_subtitle: "A vertical commutator"
	quest.342459F281DDE795.quest_desc: [
		"&bUse&r a Film Roll and process it to create a Developed Film Roll."
		"This allows you to view and project your captured photos using the &aInterplanar Projector&r."
	]
	quest.342459F281DDE795.quest_subtitle: "Turn your photos into memories"
	quest.342459F281DDE795.title: "Developed Film Roll"
	quest.3446602178E2A0B3.quest_desc: [
		"&dPlagued&r Coat is the chestpiece of the Plagued Armor set in Iron's Spells 'n Spellbooks. When worn, it provides &b+8&r Armor, &b+125&r Max Mana, &b+10%&r Nature Spell Power and &b+5%&r Spell Power. It can also be imbued with 1 spell."
		""
		"It can be &bcrafted&r from 8 Arcane Cloth and 1 Nature Rune, or made by combining Wizard Robes + Nature Rune + Arcane Essence."
	]
	quest.3446602178E2A0B3.quest_subtitle: "Channel the poisonous power of Nature magic"
	quest.349E7C15214FAEAC.quest_desc: ["&aCraft&r the Pharaoh's Sacred Hauberk from the Cataclysm: Spellbooks addon. This powerful mage chestpiece is part of the Pharaoh &bWizard&r Armor set, inspired by the Ancient Remnant and the forgotten kingdoms buried beneath the desert sands. It &benhances&r Sand magic and &bcomplements&r the Pharaoh's Wrath spell."]
	quest.349E7C15214FAEAC.quest_subtitle: "Vestments blessed by the ancient pharaohs"
	quest.34E70958A0464834.quest_subtitle: "Yummy!"
	quest.34FB7DBF4A3DD1D3.quest_subtitle: "Yummy!"
	quest.34FEE268EC380791.quest_desc: [
		"The Thallasium Axe is a &awoodcutting&r and combat tool forged from Thallasium Ingots at an Anvil with a Smith Hammer."
		""
		"It marks the start of Better End's tiered &bequipment&r progression."
	]
	quest.34FEE268EC380791.quest_subtitle: "Woodcutting tool of the first tier"
	quest.351EDBECCA323AE7.quest_desc: [
		"&dThe&r Villager Bible is the dedicated spellbook of Holy magic in Iron's Spells 'n Spellbooks. It provides &b10&r spell slots, &b+10%&r Holy Spell Power, &b+10%&r Cast Time Reduction and &b+200&r Max Mana."
		""
		"Obtaining it is part of a special quest involving the Evoker Fort, a translated book and the Priest. &bEquip&r the Bible and &bstrengthen&r your holy magic with faster casting and a larger mana pool."
	]
	quest.351EDBECCA323AE7.quest_subtitle: "Channel the power of holy magic"
	quest.3523B50535B3C1D3.quest_subtitle: "More Armor"
	quest.35302EBF03DA0C39.quest_desc: ["&6Filling&r Tanks are portable fluid containers from Create Stuff 'N Additions, &bdesigned&r to store water or other applicable fluids and supply them to &bequipment&r that uses fluid as fuel. They come in Small, Medium and Large sizes, holding 800 mB, 1600 mB and 3200 mB respectively. The larger tanks are crafted by upgrading the smaller one with Copper Ingots. In newer versions, the Filling Tank can &balso&r be filled using a Create Spout."]
	quest.35302EBF03DA0C39.quest_subtitle: "Carry your fuel wherever you go"
	quest.3536C832048D66FC.title: "Villager Basic"
	quest.3549A7E70D88AE61.quest_desc: [
		"&dCryolite&r Shard is a rare upgrade material from Crystal Chronicles. It is &bused&r to upgrade the Cryomancer Armor from Iron’s Spells ’n Spellbooks into its enhanced Crystal Chronicles version."
		""
		"The shard &bchannels&r the power of Ice magic, strengthening the original Cryomancer equipment with additional crystalline power. It is also used in the creation of Icicle Crusher, a weapon &bassociated&r with the enhanced Cryomancer equipment."
	]
	quest.3549A7E70D88AE61.quest_subtitle: "A frozen crystal shard that empowers Cryomancer equipment"
	quest.35805923D5A1F6E7.quest_desc: ["&6The&r Stirling Engine converts heat into rotational power. &bUse&r a temperature difference to &bgenerate&r mechanical energy and bring &banother&r source of power to your Create factory."]
	quest.35805923D5A1F6E7.quest_subtitle: "Turn heat into motion"
	quest.358AA0C44861DA9C.quest_subtitle: "Yummy!"
	quest.358FCC0ABB311959.quest_desc: ["&6Craft&r the Chocolate Spout Gun and &buse&r chocolate as your ammunition. Fill the gun with chocolate using a Spout, then fire chocolate &bprojectiles&r at your targets. The chocolate variant is one of the &badditional&r Spout Guns included in Create: Misc \\& Things."]
	quest.358FCC0ABB311959.quest_subtitle: "Sweeten your ammunition"
	quest.3593AEF66A049D45.quest_desc: ["&6Heats&r passing air flow if you supply enough &bpower&r. A higher &bvoltage&r makes the flow hot enough for bulk blasting, and the coil also allows faster bulk processing."]
	quest.3593AEF66A049D45.quest_subtitle: "Heats the air flow"
	quest.35953FC467B22FF4.quest_desc: [
		"&dArchevoker&r Leggings are part of the Archevoker Armor set in Iron's Spells 'n Spellbooks. When worn, they provide &b+6&r Armor, &b+125&r Max Mana, &b+10%&r Evocation Spell Power and &b+5%&r Spell Power."
		""
		"They can be &bcrafted&r using 7 Arcane Cloth and 1 Evocation Rune, or upgraded from Wizard Leggings with 1 Evocation Rune at a Smithing Table."
	]
	quest.35953FC467B22FF4.quest_subtitle: "Channel the arcane power of Evocation magic through your armor"
	quest.359F7C86BA7C1B40.quest_desc: [
		"The Aeternium Chestplate is crafted by upgrading a Terminite Chestplate with an &aAeternium&r Forged Plate at a Smithing Table."
		""
		"It's part of Better End's strongest armor set, tougher than anything found &bvanilla&r Minecraft has to offer."
	]
	quest.359F7C86BA7C1B40.quest_subtitle: "Chestplate of the strongest tier"
	quest.35DBA3484924C860.quest_desc: [
		"The Thallasium Boots are crafted from Thallasium Plating at a Smithing Table."
		""
		"They complete the first full set of &aBetter End&r armor."
	]
	quest.35DBA3484924C860.quest_subtitle: "Boots of the first tier"
	quest.35E6A94C4A13A93F.quest_desc: [
		"&aThe&r Deepsilver Chestplate is a protective armor piece from Eternal Starlight crafted &busing&r Deepsilver Ingots."
		""
		"Deepsilver armor &aimproves&r movement speed, attack speed, and knockback resistance, while the complete set grants immunity to multiple harmful &bstatus&r effects."
	]
	quest.35E6A94C4A13A93F.quest_subtitle: "Swift silver armor"
	quest.35EB1AF4A08681F9.quest_desc: ["&6Welcome&r to Create Stuff 'N Additions! This addon expands Create with new tools, gadgets and equipment designed to give you new ways to work, fight and &bmove&r around the world. From &bpowerful&r tools and utility gadgets to equipment that can help you jump, float or even fly, there is plenty to discover. Your first step is to explore the new &btechnology&r and see what Create can do for you."]
	quest.35EB1AF4A08681F9.quest_subtitle: "          More tools, more power, more possibilities    "
	quest.35EB1AF4A08681F9.title: "&l&6Welcome Create Stuff 'N Additions"
	quest.35EFE837F9540985.quest_desc: ["The Glacite Axe is a mid-tier &awoodcutting&r weapon from Eternal Starlight, &bcrafted&r from Glacite Ingots. It is used in cold biomes for both harvesting wood and combat, offering improved durability and efficiency compared to earlier-tier &bmaterials&r."]
	quest.35EFE837F9540985.quest_subtitle: "Frost woodcutting weapon"
	quest.35FCD20F5631136A.quest_subtitle: "More Weapon"
	quest.3604977F6F031F3C.quest_subtitle: "More Armor"
	quest.3610E6FEB72770D6.quest_subtitle: "More Armor"
	quest.3619D91EB5232401.quest_subtitle: "More Weapon"
	quest.3625311FE17EE28A.quest_desc: [
		"To properly &alocate&r the Starlight Golem in Eternal Starlight, you must use the Seeking Eye in a specific way."
		""
		"&aHold&r the Seeking Eye in your main hand, and at the same time place one of the required items in your off-hand."
		"Only then will the Eye guide you toward the correct location of the Golem."
		""
		"Valid &aoff-hand&r items:"
		""
		"&bRedstone&r"
		"&bGolem Steel Ingot&r"
		"&bOxidized Steel Ingot&r"
		""
		"Without the correct setup, the Eye will not lead you to this encounter."
	]
	quest.3625311FE17EE28A.quest_subtitle: "A guided summon"
	quest.3625311FE17EE28A.title: "Find Boss"
	quest.3634820CA6FD2B83.quest_desc: [
		"&aLocate&r the Ruined Citadel from the Cataclysm mod, a maze-like structure hidden on the outer islands of the End."
		""
		"Home to Endermaptera, Ender Golems, and trap blocks, it can be tracked down with an &bEye of Void&r crafted from Purpur, Shulker Shells, and an Eye of Ender."
	]
	quest.3634820CA6FD2B83.quest_subtitle: "Maze of purpur and traps"
	quest.3634820CA6FD2B83.title: "&l&dRuined Citadel"
	quest.36403C854D3B2DCE.quest_desc: [
		"&aObtain&r an End Crystal, the item used to heal the Ender Dragon and destroy obsidian pillars around the arena."
		""
		"It also serves as the base ingredient for crafting Better End's &bEternal Crystal&r through an Infusion Ritual."
	]
	quest.36403C854D3B2DCE.quest_subtitle: "Crystal of the End"
	quest.3645BEBA2FF8B974.quest_desc: ["&aCraft&r the Ancient Spear from the Cataclysm mod. Forged from Ancient Metal Ingots, this &blegendary&r weapon retains the power of ancient sand magic. Its special &bability&r launches a &bsandstorm&r projectile that damages enemies and inflicts Curse of the Desert II."]
	quest.3645BEBA2FF8B974.quest_subtitle: "Harness the power of the ancient sands"
	quest.364A7110B3B20F48.quest_desc: ["&aObtain&r the Excelsius Velocity Visor, Excelsius Adversary Visor, and Excelsius Oppressor Visor. Collect all three &bspecialized&r visors and prove your mastery over the &bdifferent&r paths of the Excelsius arsenal."]
	quest.364A7110B3B20F48.quest_subtitle: "Three visors, three paths to power"
	quest.366ADFEC023B0A7F.quest_desc: [
		"The Glacite Hoe is a &afarming&r tool from Eternal Starlight crafted &busing&r Glacite Ingots."
		""
		"&aIt&r is &bused&r to prepare farmland in cold biomes, representing mid-tier farming &bprogression&r with increased durability over earlier materials."
	]
	quest.366ADFEC023B0A7F.quest_subtitle: "Frost farming tool"
	quest.366E3BA33E060742.quest_desc: ["&6The&r Accumulator is an &benergy-storage&r block from Create Crafts \\& Additions. It stores Forge Energy (FE) and can be connected to your electrical network to save power for later use. It is especially &buseful&r for buffering energy between generators and machines with changing power demands. The &bcurrent&r NeoForge 1.21.1 release of Create Crafts \\& Additions is 1.6.0."]
	quest.366E3BA33E060742.quest_subtitle: "Store power for when you need it"
	quest.36A7E028835C70EF.quest_desc: [
		"&6Give&r your locomotives a proper industrial foundation. Riveted Locometal combines sturdy metal construction with rows of visible rivets, making it &bperfect&r for building rugged locomotive bodies, boilers and railway structures."
		""
		"A classic &bmaterial&r for a serious railway engineer."
	]
	quest.36A7E028835C70EF.quest_subtitle: "Built tough, one rivet at a time."
	quest.36BE3707A002FB69.quest_desc: [
		"&eExploring&r the depths is much easier when you don't have to worry about running out of air. The Snorkel lets you breathe underwater, giving you more time to &bexplore&r the ocean and uncover what lies beneath the surface."
		""
		"Dive in and &bstay&r underwater longer."
	]
	quest.36BE3707A002FB69.quest_subtitle: "Breathe beneath the waves"
	quest.36C7CFCB9119873F.quest_subtitle: "More Armor"
	quest.36CB0DC6E0BFECA2.quest_subtitle: "Yummy!"
	quest.36CFEE93D5653183.quest_desc: [
		"&dHellrazor&r is the upgraded form of the Decrepit Scythe in Iron's Spells 'n Spellbooks. It can be imbued with 1 spell and comes with Raise Hell &bIII&r already imbued."
		""
		"When held in the main hand, it provides &b13&r Attack Damage and &b1.4&r Attack Speed. Raise Hell &bIII&r deals &b15&r Damage, affects an &b8-block&r radius, casts &b3&r times, costs &b180&r Mana and has a &b12.5-second&r cooldown."
		""
		"&bUpgrade&r the Decrepit Scythe using 1 Timeless Slurry and 1 Pyrium Ingot."
	]
	quest.36CFEE93D5653183.quest_subtitle: "Unleash the infernal power of the ancient scythe"
	quest.36E1CA7A475EA71E.quest_desc: [
		"&aCraft&r the Steeleaf Pickaxe using the enchanted Steeleaf material found throughout the Twilight Forest. Combining remarkable durability with the magic of the forest, this pickaxe is an excellent &bchoice&r for mining valuable resources &bhidden&r beneath the ancient landscape."
		""
		"&aAs&r part of the Steeleaf equipment set, it offers a dependable upgrade for explorers preparing to face stronger enemies and uncover the deeper &bsecrets&r of the Twilight Forest."
	]
	quest.36E1CA7A475EA71E.quest_subtitle: "Mine with the strength of the forest"
	quest.36E84F21DF00EA0B.quest_subtitle: "Upgrade+"
	quest.36F89ABAEA7DE1E6.quest_subtitle: "More Armor"
	quest.36F9EB566E250DF0.quest_subtitle: "More Armor"
	quest.371A12D6E94E11E5.quest_subtitle: "More Armor"
	quest.371E519C071F5626.quest_desc: [
		"&aCraft&r the Eternal Crystal through an Infusion Ritual, using an End Crystal, four Ender Shards, and four Crystal Shards around an &aInfusion Pedestal&r."
		""
		"Placed on the six pedestals of an &bEternal Portal&r, it ignites the gateway back to the Overworld."
	]
	quest.371E519C071F5626.quest_subtitle: "Power to open an Eternal Portal"
	quest.371E519C071F5626.title: "&dEternal Crystal"
	quest.372C8BEB2A062663.quest_desc: [
		"&6Not&r every flight needs raw power. The Eco Engine is designed with efficiency in mind, reducing fuel &bconsumption&r at the cost of engine power. A perfect choice for long journeys where saving fuel matters more than speed."
		""
		"&bUpgrade&r your aircraft and make every drop of fuel count."
	]
	quest.372C8BEB2A062663.quest_subtitle: "Less fuel, longer journeys."
	quest.372E31F066FFAC31.quest_desc: [
		"&dDivine&r Soulshard is a rare crafting material in Iron's Spells 'n Spellbooks, &bassociated&r with the Holy school of magic. It is used in &badvanced&r crafting recipes for powerful Holy equipment and magical items."
		""
		"Seek out powerful holy enemies and magical structures to obtain this precious shard and continue your &bprogression&r toward stronger Holy magic."
	]
	quest.372E31F066FFAC31.quest_subtitle: "Harness the sacred essence of a fallen champion"
	quest.374BC40F43F0B18B.quest_desc: [
		"&9&lUpgrade&r&r your basic Sophisticated Storage container to the Copper Tier. &bThis&r upgrade increases the capabilities of your storage and gives you &baccess&r to more advanced storage options."
		""
		"A first step toward building a &bpowerful&r and highly customizable storage system."
	]
	quest.374BC40F43F0B18B.quest_subtitle: "Take your storage to the next tier"
	quest.374CD64FA84BBDA9.quest_desc: [
		"Traveling across the world can take a lot of time."
		"Waystones allow you to quickly &ateleport&r between locations you have already discovered."
		""
		"Once you activate a Waystone, it will be added to your network and you will be able to teleport to it from other Waystones."
		""
		"They are very useful for exploring, returning home, or moving between important places in your world."
		""
		"Craft and place your &bfirst Waystone&r."
	]
	quest.374CD64FA84BBDA9.quest_subtitle: "Fast Travel"
	quest.374CD64FA84BBDA9.title: "Waystone"
	quest.376A00BF686C345F.quest_desc: ["&6The&r Magnetite Block is an important material in Create: New Age, used as the &bfoundation&r for creating stronger magnetic components. Harness its magnetic &bproperties&r to progress toward &badvanced&r generators and electrical machinery."]
	quest.376A00BF686C345F.quest_subtitle: "The foundation of magnetic power"
	quest.376E0C8776474535.quest_desc: [
		"&aCraft&r the Phantom Helmet using the rare &btreasures&r claimed from the defeated Knight Phantoms. Once worn by the spectral guardians of the Goblin Stronghold, this &benchanted&r helmet still carries the strength and honor of the ancient warriors who defended the fortress long after death."
		""
		"&aAs&r part of the Phantom Armor set, it offers &bexceptional&r protection and serves as proof that you have overcome one of the Twilight Forest's most &bchallenging&r group battles."
	]
	quest.376E0C8776474535.quest_subtitle: "The crown of the fallen knights"
	quest.379A23CBBD48624B.quest_desc: ["&6Craft&r the Full Chocolate Bar in Create: Confectionery and enjoy it as a &blong-lasting&r food item. The bar can be eaten 16 times, restoring hunger and providing the Chocolated effect. In newer versions, it was &bchanged&r to behave more like real food."]
	quest.379A23CBBD48624B.quest_subtitle: "A chocolate bar made to keep you going"
	quest.379B7DD17002C62A.quest_desc: [
		"&aVenture&r beyond the central island and reach the outer End — the Small End Islands, End Midlands, and End Highlands, linked by End Gateways."
		""
		"Chorus trees, End Cities, and Shulkers can be found here, along with the doorway to Better End's new &bbiomes&r."
	]
	quest.379B7DD17002C62A.quest_subtitle: "The outer islands"
	quest.379B7DD17002C62A.title: "Normal End"
	quest.37A3B4D9529109AC.quest_desc: ["&6Obtain&r a Chute from Create. Chutes are used for vertical and diagonal item transport. Items normally move from the upper end to the lower end, and Chutes can directly &binteract&r with &binventories&r above and below them. Combined with an Encased Fan, they can also &bredirect&r the &bmovement&r of items and send them upward."]
	quest.37A3B4D9529109AC.quest_subtitle: "Let gravity do the work"
	quest.37B354D8FDE65AF7.quest_desc: [
		"&dBoreal&r Blade is a powerful magic Ice greatsword from Iron's Spells 'n Spellbooks. It can be &bimbued&r with 1 spell and comes with Frostbite &bIII&r as its imbued spell."
		""
		"When held in the main hand, it provides &b16&r Attack Damage and &b0.9&r Attack Speed. Frostbite III deals &b8&r Shatter Damage, lasts &b30&r seconds, costs &b100&r Mana and has a &b30-second&r cooldown."
		""
		"It is crafted &busing&r Mithril and Ice Venom, making it a powerful &blate-game&r Ice weapon."
	]
	quest.37B354D8FDE65AF7.quest_subtitle: "Wield the frozen power of the Ice Spider"
	quest.37B44781A6EBC519.quest_desc: [
		"&9&lA&r&r digital storage network is only as useful as the &bconnections&r between its components. Cable allows you to link Refined Storage devices together, carrying both power and network data &bbetween&r connected machines."
		""
		"&bUse&r cables to expand your network and connect controllers, storage devices, grids and other components into one unified system."
	]
	quest.37B44781A6EBC519.quest_subtitle: "Connect every part of your storage network"
	quest.37BEADEBB84C2E74.quest_desc: ["&6Craft&r the Roll Authoring Table and a Music Roll to begin &bcreating&r music for your mechanical organ. The Roll Authoring Table lets you &bprepare&r music rolls for the organ, opening the door to playing MIDI music inside Minecraft."]
	quest.37BEADEBB84C2E74.quest_subtitle: "Write your own music"
	quest.37D932844D831D19.quest_desc: [
		"&dLightning&r Upgrade Orb is an upgrade material in Iron's Spells 'n Spellbooks. When applied at the Arcane Anvil, it grants &b+5%&r Lightning Spell Power."
		""
		"It is crafted from 1 Empty Upgrade Orb and 8 Lightning Runes. Upgrade Orbs can be applied to compatible &bequipment&r to increase its magical power."
	]
	quest.37D932844D831D19.quest_subtitle: "Infuse your equipment with the power of Lightning magic"
	quest.37DE6085DECF222C.quest_desc: ["&6Obtain&r a Sequenced Gearshift from Create. It provides &bprecise&r control over rotational power by executing a programmed sequence of up to &b5&r commands. You can make it rotate by a set angle, move pistons or pulleys by a set distance, wait for a timed delay, or pause until another Redstone pulse is received. This makes it ideal for &bautomated&r and precisely timed contraptions."]
	quest.37DE6085DECF222C.quest_subtitle: "Program the motion"
	quest.37EF5D7EACBA8253.quest_subtitle: "More Armor"
	quest.3803F98209D3B03F.quest_desc: ["&6Craft&r the Fan Blasting Catalyst and use it with a &bfan-based&r processing setup to perform blasting recipes without needing a lava source. It provides a compact alternative to placing lava in front of the fan, making &bautomated&r blasting setups cleaner and easier to build."]
	quest.3803F98209D3B03F.quest_subtitle: "Blast without the lava"
	quest.380C98AC90E56CF5.quest_desc: [
		"&aThe&r Starlit Diamond Boots are high-tier footwear from Eternal Starlight crafted &busing&r Starlit Diamonds."
		""
		"Starlit Diamond armor &aprovides&r protection comparable to Netherite while significantly &bincreasing&r armor toughness and knockback resistance."
	]
	quest.380C98AC90E56CF5.quest_subtitle: "Celestial diamond footwear"
	quest.381A385CF39A6090.quest_subtitle: "Upgrade+"
	quest.382304CA67C02B09.quest_desc: [
		"&dPriest&r Boots are part of the Priest Armor set in Iron's Spells 'n Spellbooks. When worn, they provide &b+3&r Armor, &b+125&r Max Mana, &b+10%&r Holy Spell Power and &b+5%&r Spell Power."
		""
		"They can be &bcrafted&r from 4 Arcane Cloth and 1 Holy Rune, or upgraded from Wizard Boots with 1 Holy Rune at a Smithing Table."
	]
	quest.382304CA67C02B09.quest_subtitle: "Walk with the sacred power of Holy magic"
	quest.3828CC1FE903C799.quest_desc: [
		"&aCraft&r the Ice Sword, a weapon infused with the chilling magic of the Twilight Forest's frozen lands. Forged from &benchanted&r ice and &bancient&r magic, its blade carries the power of eternal winter, allowing &bevery&r strike to sap the warmth and strength from your enemies."
		""
		"&aThe&r Ice Sword is &bmore&r than a finely crafted weapon—it is a symbol of your mastery over the frozen wilderness. Whether facing blazing &bmonsters&r or powerful bosses, its icy edge &bensures&r your foes will feel the bite of the Glacier with every swing."
	]
	quest.3828CC1FE903C799.quest_subtitle: "Freeze your enemies where they stand"
	quest.383F9EE23C04C97C.quest_subtitle: "More Armor"
	quest.38459DCFB7E506F8.quest_desc: ["Craft&a candles&r using honeycombs and string. Candles can be placed to decorate your home and provide &blight&r during the night."]
	quest.38459DCFB7E506F8.quest_subtitle: "Light up your world!"
	quest.38459DCFB7E506F8.title: "Candles"
	quest.3848B9AC3BC949B2.quest_desc: ["&dBullets&r are the &bammunition&r for every gun. Keep them in your inventory and press the &breload&r key to fill a gun's magazine. Many modifiers are built from bullets too."]
	quest.3848B9AC3BC949B2.quest_subtitle: "Ammo for every gun"
	quest.3859C15424161DB6.quest_desc: [
		"&6A&r proper train is all about the details. Andesite, Copper and Brass Bogie Steps provide a practical way to climb aboard while adding a &bdistinct&r industrial touch to your train."
		""
		"&bCollect&r all three variants and give your trains the finishing touches they deserve."
	]
	quest.3859C15424161DB6.quest_subtitle: "Three metals, one step closer to a perfect train."
	quest.3865DC29C1F7A4A4.quest_subtitle: "More Armor"
	quest.3870EF72432AAB3C.quest_desc: [
		"The Aeternium Forged Plate is crafted from an Aeternium Ingot at an Anvil with a Smith Hammer."
		""
		"Combined with a piece of &bTerminite&r armor and the Aeternium Upgrade Template at a Smithing Table, it produces a piece of &bAeternium&r armor."
	]
	quest.3870EF72432AAB3C.quest_subtitle: "Plating for the strongest armor"
	quest.388B016386760B13.quest_desc: ["&dHermomancer&r Helmet is the headpiece of the Hermomancer Armor set from Crystal Chronicles, an &baddon&r for Iron’s Spells ’n Spellbooks."]
	quest.388B016386760B13.quest_subtitle: "Harness the power of the Hermomancer"
	quest.38A9AD20D4A6BF68.quest_desc: ["&dWizard&r Robes are &bpart&r of the basic Wizard Armor set in Iron's Spells 'n Spellbooks. They are crafted from Arcane Cloth and provide magical &bbonuses&r focused on increasing your mana and spell power."]
	quest.38A9AD20D4A6BF68.quest_subtitle: "Channel arcane power through your robes"
	quest.38E80402E9163612.quest_desc: [
		"The&a Loom Table&r allows you to create decorative variants of wool and fabric blocks."
		"Use it to craft colorful designs and decorate your builds."
	]
	quest.38E80402E9163612.quest_subtitle: "Weave new designs"
	quest.38F6639BB82B5D7B.quest_desc: ["&6The&r Gilded Quartz Sword is part of the Gilded Quartz tool set from Create Stuff 'N Additions. It has 1644 durability, deals 8 attack &bdamage&r and has 1.8 attack speed, making it a strong weapon for combat. It is &bcrafted&r from Polished Rose Quartz, Iron Sheets, Gold and a Zinc Tool Handle."]
	quest.38F6639BB82B5D7B.quest_subtitle: "Rose quartz with a golden edge"
	quest.390BA55ED5D0EABE.quest_desc: [
		"&6Give&r your railway &bstructures&r a solid industrial foundation. The Locometal Pillar brings the rugged look of locomotive &bmetal&r into a clean architectural form, perfect for supporting stations, bridges, workshops and other railway constructions."
		""
		"Build with Locometal and let your &brailway&r stand tall."
	]
	quest.390BA55ED5D0EABE.quest_subtitle: "Strong foundations for your railway empire."
	quest.391298DD11705526.quest_desc: [
		"&dPlagued&r Mask is the headpiece of the Plagued Armor set in Iron's Spells 'n Spellbooks. When worn, it provides &b+3&r Armor, &b+125&r Max Mana, &b+10%&r Nature Spell Power and &b+5%&r Spell Power."
		""
		"It is made by &bupgrading&r a Wizard Helmet with 1 Nature Rune and 1 Arcane Essence."
	]
	quest.391298DD11705526.quest_subtitle: "Channel the wild and poisonous power of Nature magic"
	quest.39171469D2398312.quest_desc: ["Gold &aenhances&r your gear with unique &bproperties&r. These boots may not be the toughest, but they offer agility and special advantages that can &bhelp&r you survive in tricky situations."]
	quest.39171469D2398312.quest_subtitle: "Light and swift"
	quest.39171469D2398312.title: "Gold Netherite Boots"
	quest.3928476B983E4DFE.quest_subtitle: "More Armor"
	quest.3933A4162A6BB223.quest_desc: [
		"&aCraft&r the Seeker Bow, a remarkable &bweapon&r infused with the enchanted magic of the Twilight Forest. Unlike ordinary bows, its arrows &bpossess&r an uncanny &bability&r to seek out nearby enemies, bending through the air to strike targets that would otherwise escape a perfect shot."
		""
		"&aForged&r for hunters who value precision &babove&r all else, the Seeker Bow transforms every arrow into a relentless pursuit. Whether fighting swift &bmonsters&r or elusive foes, this legendary &bweapon&r ensures that few enemies can outrun its enchanted arrows."
	]
	quest.3933A4162A6BB223.quest_subtitle: "No target can escape its aim"
	quest.3936B60A2971CE92.quest_desc: [
		"&aUpgrade&r your tools to Netherite using Netherite Ingots and Smithing Templates."
		"These tools are &bmore&r durable and efficient than diamond ones."
	]
	quest.3936B60A2971CE92.quest_subtitle: "Upgrade your tools"
	quest.3936B60A2971CE92.title: "Netherite Tools"
	quest.3938F9BC5003844F.quest_desc: ["&eA&r Game Disc that lets you play Flappy Bee &busing&r the Game Console. Control the bee, flap through the gaps and avoid the pipes to achieve the highest score. The disc can be obtained when a bee is &bkilled&r by a skeleton."]
	quest.3938F9BC5003844F.quest_subtitle: "Flap your bee and avoid the pipes!"
	quest.395995BE44311602.quest_desc: [
		"&aCraft&r the Purpur Pedestal, a decorative pillar block used to build the ring around an &aEternal Portal&r."
		""
		"It supports the Eternal Crystals that ignite the &bportal&r back to the Overworld."
	]
	quest.395995BE44311602.quest_subtitle: "A pillar for the ritual"
	quest.395995BE44311602.title: "Purpur Pedestal"
	quest.396C1060A1064C21.quest_desc: [
		"&aThe&r Flowglaze Axe is a tool and weapon from Eternal Starlight, belonging to the Flowglaze &bequipment&r tier."
		""
		"&aIt&r is crafted using Flowglaze materials and is part of the mod’s mid-to-late game &bprogression&r system."
	]
	quest.396C1060A1064C21.quest_subtitle: "Flow-forged axe"
	quest.396F8AD4C5B45321.quest_subtitle: "Upgrade+"
	quest.39760FFD4F770930.quest_subtitle: "Yummy!"
	quest.397F3A2525AC6915.quest_desc: ["&aObtain&r the Gauntlet of Maelstrom from the Cataclysm mod. This &blegendary&r weapon is a powerful gauntlet that unleashes devastating wind attacks, controlling the force of the storm &bagainst&r your enemies. It is a rare &btreasure&r obtained from the ocean depths and the creatures that rule them."]
	quest.397F3A2525AC6915.quest_subtitle: "Harness the power of the endless storm"
	quest.397F3A2525AC6915.title: "&eGauntlet Of Maelstrom"
	quest.3987DDC1C8ABFA24.quest_desc: [
		"&aThe&r Starfire Scythe is a late-game melee weapon from Eternal Starlight, part of the Starfire &bequipment&r tier."
		""
		"&aIt&r is designed for sweeping &battacks&r and enhanced combat reach compared to standard weapons."
	]
	quest.3987DDC1C8ABFA24.quest_subtitle: "Starlight reaping weapon"
	quest.39A8D3F548FACFD3.quest_desc: ["&6Craft&r the Crank Wheel and turn manual effort into mechanical power. Unlike a &bstandard&r Hand Crank, it includes a cogwheel, &ballowing&r it to connect directly to other gears and drive your kinetic network. It generates &b32&r RPM and provides a fixed &b256&r SU of stress capacity."]
	quest.39A8D3F548FACFD3.quest_subtitle: "Power your factory by hand"
	quest.39AF48307865E746.title: "oh sh*t"
	quest.39BB29B2BBB80DD4.quest_subtitle: "Yummy!"
	quest.39BE05FFC9EE9414.quest_desc: ["&6Craft&r the Pipe Base, one of the fundamental &bcomponents&r of the pipe organ system in Create: Sound of Steam. It provides the base for mounting your organ pipes and is an essential step toward building a &bcomplete&r mechanical organ. The Pipe Base was &bintroduced&r alongside the first organ pipe stops in the mod."]
	quest.39BE05FFC9EE9414.quest_subtitle: "Lay the foundation for your organ pipes"
	quest.39C6D650D7C5C931.quest_desc: ["&6The&r Cog Crank is a simple &bhand-powered&r component from Create: Dreams n' Desires. Use it to provide rotational force manually and get your Create machinery moving when no other power &bsource&r is available."]
	quest.39C6D650D7C5C931.quest_subtitle: "Get things moving"
	quest.39CCB7A19656B95D.quest_subtitle: "Upgrade+"
	quest.39E398990DAE6E8A.quest_subtitle: "More Armor"
	quest.39EE107B4B3B00A8.quest_desc: ["&6Fluxuated&r Magnetite is an advanced magnetic material from Create: New Age. Its enhanced magnetic properties make it an &bimportant&r component for &bhigher-tier&r electrical and magnetic machinery. &bUse&r it to push your power systems beyond their basic limits."]
	quest.39EE107B4B3B00A8.quest_subtitle: "Supercharge your magnetic technology"
	quest.39F8DB8A4BF19415.quest_subtitle: "Yummy!"
	quest.39FC1D6871E96DD4.quest_desc: ["&6Obtain&r a Flywheel from Create. It is a mechanical component associated with Create's rotational machinery. In modern &bversions&r of Create, the Flywheel is primarily a decorative component, as its former role in the Furnace Engine was removed; however, it remains part of Create's &bcollection&r of kinetic and mechanical components."]
	quest.39FC1D6871E96DD4.quest_subtitle: "Keep the motion turning"
	quest.3A03788C481BE56D.quest_desc: [
		"&aWithin&r Eternal Starlight, Starlight Crystal Blocks are dense formations of condensed &bcrystal&r energy."
		"However, they are not required for any major &bprogression&r or crafting systems — they exist mainly as a rare collectible and a display resource."
		""
		"Gathering them is optional and serves as a sign of exploration dedication rather than &bpower&r progression."
	]
	quest.3A03788C481BE56D.quest_subtitle: "Solidified starlight"
	quest.3A03788C481BE56D.title: "Starlight Crystal Blocks"
	quest.3A0F51CFED89CDBB.quest_desc: [
		"&dBattle-Evoker&r Leggings are the Crystal Chronicles upgraded version of Archevoker Leggings from Iron’s Spells ’n Spellbooks."
		""
		"They are &bupgraded&r using an Avaricite Shard, transforming the original Archevoker Armor into the powerful Battle-Evoker Armor set. The Avaricite Shard infuses the leggings with additional &bEvocation&r magic, creating a stronger &bcombat-focused&r version of the Archevoker gear."
	]
	quest.3A0F51CFED89CDBB.quest_subtitle: "An enhanced form of Archevoker Leggings, empowered by Avaricite"
	quest.3A241FDA02331592.quest_desc: ["&aDefeat&r 7 Glow Squid. These aquatic mobs can be &bfound&r in dark underwater areas, such as deep &boceans&r and underground water sources. Glow Squid drop Glow Ink Sac, which is &bused&r for glowing signs, item frames, and decorative purposes."]
	quest.3A241FDA02331592.quest_subtitle: "Hunt the glowing creatures of the deep"
	quest.3A241FDA02331592.title: "Kill Glow Squid"
	quest.3A3249BEAB99922C.quest_desc: [
		"At the highest &blevel&r of progression, this helmet offers unmatched durability and defense."
		"It is designed to protect you in the most &adangerous&r battles."
	]
	quest.3A3249BEAB99922C.quest_subtitle: "Peak protection"
	quest.3A3249BEAB99922C.title: "Diamond Netherite Helmet"
	quest.3A46EC4545D5CEA4.quest_desc: ["&aFind&r the Acropolis from L_Ender’s Cataclysm. This massive structure &bgenerates&r in the deep ocean and serves as the domain of Scylla, the Storm Empress. Use the Eye of Storm to &blocate&r the &bAcropolis&r and uncover the ancient stronghold hidden beneath the waves."]
	quest.3A46EC4545D5CEA4.quest_subtitle: "Discover the lost city beneath the waves"
	quest.3A46EC4545D5CEA4.title: "&l&bAcropolis"
	quest.3A6B03B108CF0AE5.quest_desc: ["&6The&r Deployer is one of Create's most versatile automation components. When powered, it extends its arm &b2&r blocks forward and simulates a player's interaction. By default, it performs right-click actions, allowing it to place blocks, &buse&r items, interact with machines, milk cows, shear sheep, strip logs, apply bone meal and much more. &bUse&r a Wrench on its front to switch it into Attack mode, letting it break blocks with tools or attack entities. Filters can restrict which items the Deployer uses, making it ideal for &bautomated&r production and contraptions."]
	quest.3A6B03B108CF0AE5.quest_subtitle: "Put automation to work"
	quest.3A6E892D4B563DF8.quest_desc: ["&6Craft&r the Fan Haunting Catalyst to perform haunting recipes &busing&r a &bfan-based&r processing setup. It provides a dedicated catalyst for the haunting process, letting you replace the usual soul fire setup with a compact &bcatalyst-based&r solution. The catalyst system is designed for Create's &bfan-processing&r mechanics."]
	quest.3A6E892D4B563DF8.quest_subtitle: "Haunt your factory's processing"
	quest.3A759AD208A1EF77.quest_subtitle: "More Armor"
	quest.3A82061A372BB75D.title: "&l&bStarlight &fGolem"
	quest.3A8CA2237E845799.quest_desc: ["&dEnables&r a &bbayonet&r charge: rush forward and run enemies through in melee. Kill something with one to earn You Brought What to a Gun Fight?"]
	quest.3A8CA2237E845799.quest_subtitle: "Charge!"
	quest.3A9BA82E032C71E9.quest_subtitle: "More Armor"
	quest.3A9EEC3EB88D8038.quest_subtitle: "More Weapon"
	quest.3AA8749706C97EA1.quest_desc: [
		"Golem Steel is an &aadvanced&r crafting material in Eternal Starlight obtained by refining Oxidized Golem Steel Ingots dropped &bfrom&r the Starlight Golem encounter."
		""
		"&aOnce&r refined, the ingot can be &bused&r for stronger equipment, weapons, tools, and additional crafting recipes added by the mod."
	]
	quest.3AA8749706C97EA1.quest_subtitle: "Refined construct metal"
	quest.3AA8749706C97EA1.title: "&dGolem Steel Ingot"
	quest.3AACA358B9373DF9.quest_desc: [
		"&eNot&r every threat comes from a sword."
		""
		"The Antidote Vessel weakens the effects of &bharmful&r status effects, drastically reducing how long they can remain on you. Poison, Wither and other negative effects become far less &bdangerous&r when this little vessel is at your side."
		""
		"Let the cure take care of the poison."
	]
	quest.3AACA358B9373DF9.quest_subtitle: "Let poison lose its bite"
	quest.3ABD2D8AD7ECE72B.quest_desc: ["&dArcane&r Rune is a crafting ingredient in Iron's Spells 'n Spellbooks. It is the rune associated with the Arcane school and is &bused&r in magical crafting. Runestones are created by &binfusing&r a Blank Runestone with 8 Focuses of the desired school."]
	quest.3ABD2D8AD7ECE72B.quest_subtitle: "Infuse a runestone with the pure essence of Arcane magic"
	quest.3ABE6F522019BDF4.quest_desc: [
		"Among the vibrant &alandscapes&r of Eternal Starlight, Scarlet &aTrees&r stand out with their deep red hue."
		"Their logs are a valuable resource used for crafting, building, and advancing through the dimension."
		""
		"Harvest enough &bScarlet&r Logs to expand your material options and continue your progression."
	]
	quest.3ABE6F522019BDF4.quest_subtitle: "Crimson strength"
	quest.3ABE6F522019BDF4.title: "Scarlet Wood"
	quest.3AC9F637627E7236.quest_desc: ["Collect and &aexperiment&r with various &bgadgets&r to help you in your adventures and challenges."]
	quest.3AC9F637627E7236.quest_subtitle: "Explore useful tools and devices"
	quest.3AC9F637627E7236.title: "Gadgets"
	quest.3ACEBFEA2B03424E.quest_subtitle: "More Armor"
	quest.3AE3CF39B3EF77BD.quest_subtitle: "More Armor"
	quest.3B02EFDAF46A1B09.quest_desc: [
		"At the bottom of the screen, you’ll see a search bar."
		"This is &dJust Enough Items (JEI)&r – a tool that helps you quickly find items in the game."
		"For example, if you type “Stone,” JEI will show all items related to stone on the right side of the screen."
		"By adding &e@&r before a word, you can filter items from a specific mod, for example &e@Addon&r."
		"To mark an item as a favorite, hover over it and press A – it will then always be easy to find."
	]
	quest.3B02EFDAF46A1B09.quest_subtitle: "Read This First!"
	quest.3B02EFDAF46A1B09.title: "&dJust Enough Items(JEI)"
	quest.3B032DF7438E7A1F.quest_desc: [
		"The Terminite Forged Plate is crafted from a Terminite Ingot at an Anvil using a Smith Hammer."
		""
		"It's the base component for crafting a full set of &aTerminite&r armor at the Smithing Table."
	]
	quest.3B032DF7438E7A1F.quest_subtitle: "Plating for Terminite armor"
	quest.3B15BF306A65F852.quest_desc: [
		"&9&lAutomate&r&r your crafting with the Autocrafter. It &buses&r stored crafting patterns to produce requested items automatically, taking &bresources&r directly from your Refined Storage network."
		""
		"&bConnect&r it to your network, provide the &brequired&r patterns and let your system handle crafting while you focus on bigger projects."
	]
	quest.3B15BF306A65F852.quest_subtitle: "Turn your storage network into a crafting machine"
	quest.3B18663875A93CD8.quest_desc: [
		"&aObtain&r the Void Forge from Cataclysm, an upgraded crafting weapon fused using Void Cores at the &aMechanical Fusion Anvil&r."
		""
		"It represents one of the mod's stronger late-game &bweapon&r upgrades."
	]
	quest.3B18663875A93CD8.quest_subtitle: "Fusing weapons with void power"
	quest.3B18663875A93CD8.title: "&dVoid Forge"
	quest.3B21F423411A58EA.quest_desc: ["&6The&r Experience Sword is a special weapon from Create Stuff 'N Additions. When you successfully hit a mob, it has a chance to &bgenerate&r an Experience Orb, &ballowing&r you to gain extra XP while fighting. It has 270 durability, deals 5.5 attack damage and has 2.0 attack speed. It is &bcrafted&r using 2 Heaps of Experience and 1 Zinc Tool Handle."]
	quest.3B21F423411A58EA.quest_subtitle: "Turn every fight into experience"
	quest.3B234BAB0CF6ABE7.quest_desc: [
		"&eWhy&r slow down when the water is in your way?"
		""
		"Aqua Dashers let you sprint &bacross&r the surface of fluids, allowing you to run over water without sinking. Perfect for crossing oceans, rivers and other watery obstacles without &bbreaking&r your stride."
		""
		"&bKeep&r running. The water won't stop you."
	]
	quest.3B234BAB0CF6ABE7.quest_subtitle: "Run where others would swim"
	quest.3B312E7CA4D99D86.quest_desc: [
		"The Glacite Pickaxe is a &amining&r tool from Eternal Starlight crafted &busing&r Glacite Ingots."
		""
		"&aIt&r is used for mid-tier mining progression in cold biomes, offering improved efficiency over earlier &bmaterials&r like Deepsilver and Amaramber."
	]
	quest.3B312E7CA4D99D86.quest_subtitle: "Frost mining tool"
	quest.3B346442DD872D2A.quest_desc: [
		"&aCraft&r Runed Flavolite, a variant of Flavolite gathered in the Painted Mountains and inscribed for ritual use."
		""
		"It's required to build the ring of an &aEternal Portal&r, the structure used to travel back to the Overworld from deep within the End."
	]
	quest.3B346442DD872D2A.quest_subtitle: "Stone that channels the ritual"
	quest.3B346442DD872D2A.title: "&dRuned Flavolite"
	quest.3B3E85DE3E5935B2.quest_desc: [
		"&aCraft&r the Knightmetal Greaves &busing&r &brefined&r Knightmetal Ingots forged from the legendary alloy of the Goblin Stronghold. Designed to protect a warrior's legs without &bsacrificing&r mobility, these greaves combine remarkable &bdurability&r with the masterful craftsmanship of the ancient knights."
		""
		"&aAs&r an essential part of the Knightmetal Armor set, they provide reliable &bprotection&r for every expedition through the Twilight Forest. Whether exploring forgotten ruins or facing powerful bosses, the &bKnightmetal Greaves&r ensure you can stand your ground against any threat."
	]
	quest.3B3E85DE3E5935B2.quest_subtitle: "Armor worthy of the fortress guardians"
	quest.3B48F8AFC5B3121E.quest_desc: ["&aCraft&r the Ignis Mage Leggings from the Cataclysm: Spellbooks addon. These &benchanted&r leggings are part of the Ignis Mage Robes set, &bcarrying&r the power of Ignis and the eternal flames of the Nether. They enhance the &bconnection&r between the wearer and the destructive force of fire magic."]
	quest.3B48F8AFC5B3121E.quest_subtitle: "Leggings forged from infernal magic"
	quest.3B559DC9EC7E4787.quest_desc: [
		"The Thermal Springstone Sword is a &afire-infused&r weapon from Eternal Starlight crafted &busing&r Thermal Springstone Ingots."
		""
		"&aIt&r deals moderate damage and applies a strong burning effect, making it &beffective&r against mobs in early-to-mid progression within the Starlight dimension."
	]
	quest.3B559DC9EC7E4787.quest_subtitle: "Geothermal burning blade"
	quest.3B5914CBE7904874.quest_desc: ["&6A&r bucket of acid, the liquid used to etch circuit boards and pour into batteries. Make acid in a Create mixer from &bredstone&r, blaze powder and water."]
	quest.3B5914CBE7904874.quest_subtitle: "Etching acid"
	quest.3B8820B3D65D3C3B.quest_subtitle: "More Weapon"
	quest.3B8DD58693FDC198.quest_subtitle: "Yummy!"
	quest.3B9B3230B794BAB4.quest_desc: ["&eA&r Game Disc that lets you play Blocktris using the Game Console. Place and rotate the falling pieces to fill &bcomplete&r lines and score points. &bUse&r A and D to move, W to rotate, S to move down, SPACE for a hard &bdrop&r and ENTER to hold a piece."]
	quest.3B9B3230B794BAB4.quest_subtitle: "Fit the pieces, clear the lines and get the highest score!"
	quest.3BA85A17B29682A9.quest_desc: [
		"&dWelcome&r to Iron's Arms 'n Artifice, a mod about &bfirearms&r and the clever gear that makes them deadly. Guns shoot &bbullets&r from a magazine that you refill with the reload key, and every gun has &bmodifier&r slots you can fill to change how it behaves."
		""
		"&dFollow&r the quests to craft ammo, build better guns and unlock modifiers for every playstyle."
	]
	quest.3BA85A17B29682A9.quest_subtitle: "             First we arm, then we artifice        "
	quest.3BA85A17B29682A9.title: "&d&lWelcome Iron's Arms 'n Artifice"
	quest.3BAF72E5640B7358.quest_desc: [
		"&eSometimes&r the best way to survive is to simply not be seen."
		""
		"This &bmysterious&r scarf makes its wearer invisible, hiding them from the world while leaving armor and held items visible. Perfect for sneaking past enemies, scouting &bdangerous&r places or simply vanishing when things get out of hand."
		""
		"&bStay&r unseen. Stay alive."
	]
	quest.3BAF72E5640B7358.quest_subtitle: "Disappear without a trace"
	quest.3BE25C828669ABC8.quest_desc: [
		"&dLegionnaire&r Flamberge is the upgraded version of the Decrepit Flamberge in Iron's Spells 'n Spellbooks. It has &b11&r Attack Damage, &b1.5&r Attack Speed and &b+4&r Armor."
		""
		"&bUpgrade&r the Decrepit Flamberge at a Smithing Table using 1 Timeless Slurry and 1 Pyrium Ingot."
	]
	quest.3BE25C828669ABC8.quest_subtitle: "Restore the ancient blade to its full fiery glory"
	quest.3BFCB485B9144396.quest_desc: [
		"&aCraft&r the Fiery Sword using Fiery Ingots forged from the blazing essence of the Hydra. This &blegendary&r weapon burns with an everlasting flame, striking enemies with both steel and fire. Every swing &bcarries&r the fury of the Fire Swamp, making it a fearsome choice &bagainst&r even the toughest foes."
		""
		"&aForged&r by combining masterful &bcraftsmanship&r with the Hydra's power, the Fiery Sword is a symbol of your triumph over one of the Twilight Forest's greatest challenges and a weapon worthy of the &badventures&r still to come."
	]
	quest.3BFCB485B9144396.quest_subtitle: "Unleash the flames of the Hydra"
	quest.3C0543DB0409499A.quest_subtitle: "Yummy!"
	quest.3C0E5701F69D9970.quest_desc: ["&aThe&r Echo Key allows you to open the Deepslate &bVaults&r hidden within the Ancient Keep. To obtain a key, face the challenges of the Deepslate Trials and defeat the &benemies&r you encounter. The vaults contain valuable items, materials, enchantments, and Echo Charges &bneeded&r for further progression."]
	quest.3C0E5701F69D9970.quest_subtitle: "Key to the Forgotten Vaults"
	quest.3C16E628EDD80C31.quest_desc: ["&6The&r Brass Tools are a complete tool set added by Create Stuff 'N Additions. The set includes a Pickaxe, Axe, Sword, Shovel and Hoe, giving you a &bdurable&r set of tools made from Create's brass. The tools have &b450&r durability and provide another &buseful&r application for brass &bbeyond&r building machinery."]
	quest.3C16E628EDD80C31.quest_subtitle: "Put brass to work"
	quest.3C16E628EDD80C31.title: "Brass Tools"
	quest.3C1D418D14110BE9.quest_desc: ["&6Calcium&r Rich Powder is a crafting ingredient added in Create: Aquatic Ambitions 2.0. It is used in several of the mod's &bnew&r recipes and helps expand the aquatic production chain, including recipes connected to Calcite and Spiky Shells. It was &bintroduced&r alongside the other &bmajor&r 2.0 features."]
	quest.3C1D418D14110BE9.quest_subtitle: "Enrich your aquatic production"
	quest.3C3332B54F1FF5D1.quest_subtitle: "Yummy!"
	quest.3C403AF9AB388DF7.quest_desc: ["&6The&r Gilded Quartz Pickaxe is a powerful pickaxe from Create Stuff 'N Additions, made from Polished Rose Quartz, Gold and an Iron Sheet. It has &b1644&r durability, an Obsidian &bmining&r level, and deals &b4&r attack damage with &b1.2&r attack speed. It can mine blocks such as Obsidian and Ancient Debris, making it a strong &balternative&r to a Diamond Pickaxe."]
	quest.3C403AF9AB388DF7.quest_subtitle: "A golden edge to rose quartz"
	quest.3C4734213A90B8AC.quest_desc: [
		"&6Aviation&r isn't just about power — efficiency matters too. Industrial Gears &bimprove&r the inner workings of your aircraft, reducing fuel consumption by 20%."
		""
		"Install them &binto&r your aircraft and make every drop of fuel last longer."
	]
	quest.3C4734213A90B8AC.quest_subtitle: "Precision engineering for more efficient flight."
	quest.3C5DE918135EB728.quest_desc: ["&aThe&r Explorer’s Compass is a navigation tool used to locate structures across the world. Your &btask&r is to obtain the compass and &buse&r it to find a chosen structure, guiding you directly toward its location."]
	quest.3C5DE918135EB728.quest_subtitle: "Obtain and use an Explorer’s Compass to locate a structure"
	quest.3C5FD7C5942F32A8.quest_desc: [
		"Within the shimmering &bregions&r of Eternal Starlight, Crystallized Moths drift through the air like fragments of light."
		"Despite their fragile appearance, they are hostile and can attack in &agroups&r when disturbed."
		""
		"&aTheir&r bodies are infused with &bstarlight&r crystals, making them both dangerous enemies and valuable sources of rare materials."
	]
	quest.3C5FD7C5942F32A8.quest_subtitle: "Glowing predators"
	quest.3C5FD7C5942F32A8.title: "Crystallized Moth"
	quest.3C7082F5ECB64ED5.quest_desc: [
		"The Starlit Diamond Sword is a &alate-game&r weapon from Eternal Starlight, crafted from Starlit Diamond &bmaterials&r introduced in version 0.5.0."
		""
		"&aIt&r serves as a significant &bupgrade&r over mid-tier gear such as Glacite and Springstone, providing stable high damage for late progression before reaching &btrue&r celestial-tier weapons."
	]
	quest.3C7082F5ECB64ED5.quest_subtitle: "Late-game celestial blade"
	quest.3C9063F2E85E5EBD.quest_desc: ["&6Turn&r your chocolate into a small, delicious treat. Fill a Caramel Bar, Chocolate Bar or White Chocolate Bar with 250 mB of Dark Chocolate to create Dark Chocolate Candy. A single &bpiece&r restores 8 hunger and 11 saturation."]
	quest.3C9063F2E85E5EBD.quest_subtitle: "A bite-sized treat filled with rich dark chocolate."
	quest.3C9828D3B974A763.quest_desc: ["&aObtain&r the Abyssal Egg from the Cataclysm mod. This mysterious relic originates from the domain of The Leviathan, carrying the &bessence&r of the endless abyss. It is one of the rarest &btreasures&r recovered from the deepest reaches of the ocean."]
	quest.3C9828D3B974A763.quest_subtitle: "A relic from the depths of the abyss"
	quest.3C9DA2A6505AC8DB.quest_desc: ["Gather a &afew&r wood logs from nearby trees. Wood is a fundamental resource, used to craft tools, furniture, and many other items essential for &bsurvival&r and &bexploring&r the world."]
	quest.3C9DA2A6505AC8DB.quest_subtitle: "Start your adventure by gathering basic resources"
	quest.3C9DA2A6505AC8DB.title: "&#A56701First &#6A3B1DWood"
	quest.3CB6D7A92AB424D6.quest_subtitle: "More Armor"
	quest.3CB705697C33FFE0.quest_desc: [
		"&9&lTurn&r&r your storage into a personal music station with the Jukebox Upgrade. It allows you to play music discs directly from your storage, giving you &baccess&r to your favorite tunes without &bneeding&r a separate jukebox."
		""
		"The Advanced Jukebox Upgrade expands your musical options, providing greater control over your music discs and &bplayback&r so you can enjoy your collection wherever your storage is placed."
	]
	quest.3CB705697C33FFE0.quest_subtitle: "Bring your favorite music to your storage"
	quest.3CB705697C33FFE0.title: "Jukebox \\& Advanced Jukebox Upgrade"
	quest.3CB7668BAAABA7E1.quest_desc: [
		"&dCultist&r Hood is the helmet from the Cultist Armor set in Iron's Spells 'n Spellbooks. When worn, it provides &b+3&r Armor, &b+125&r Max Mana, &b+10%&r Blood Spell Power and &b+5%&r Spell Power."
		""
		"It can be crafted from 5 Arcane Cloth and 1 Blood Rune, or upgraded from a Wizard Hood &busing&r a Blood Rune in a Smithing Table on current versions."
	]
	quest.3CB7668BAAABA7E1.quest_subtitle: "Channel the dark power of Blood magic"
	quest.3CD152D1AD3DC1BC.quest_desc: ["&6The&r Enchanting Template is a special item from Create: Enchantment Industry &bused&r in the mod's automated enchanting system. It is associated with the Blaze Enchanter and &ballows&r enchantments to be &bprocessed&r and applied through Create's machinery. In newer versions, the unenchanted Enchanting Template no longer has an &benchantment&r glint, making it easier to &bdistinguish&r from an enchanted template."]
	quest.3CD152D1AD3DC1BC.quest_subtitle: "Prepare for automated enchanting"
	quest.3CE36639F3E12DA3.quest_desc: [
		"The Aeternium Pickaxe is a top-tier &amining&r tool, stronger and more durable than Netherite thanks to its Aeternium components."
		""
		"Aeternium Ingots are forged from &bTerminite&r and Netherite, or found as rare loot in Better End structures."
	]
	quest.3CE36639F3E12DA3.quest_subtitle: "Mining tool of the strongest tier"
	quest.3CEE204304776F95.quest_desc: ["&aThe&r Nether Stove is a specialized cooking station from My Nether's Delight, &bdesigned&r for preparing food &busing&r ingredients found in the Nether. It brings the cooking mechanics of Farmer's Delight &binto&r the fiery depths of the Nether."]
	quest.3CEE204304776F95.quest_subtitle: "A fiery cooking station made for the Nether"
	quest.3CF0B31B8952042F.quest_desc: [
		"&aThe&r Scepter of Fortification is a &bpowerful&r magical artifact obtained from the Twilight Lich. It once belonged to the cursed sorcerer who ruled the Lich Tower and is &binfused&r with unstable defensive magic."
		""
		"&aThis&r scepter allows the user to create protective barriers or fortifications, making it a valuable tool for both combat and survival. However, its power is limited and &brequires&r careful use, as it draws directly from &bancient&r and unstable magic sources."
	]
	quest.3CF0B31B8952042F.quest_subtitle: "A fragment of the Lich’s lost power"
	quest.3CF5DD022720CDBD.quest_subtitle: "More Armor"
	quest.3D02C1DC3BAD13EC.quest_desc: ["&6Obtain&r a Precision Mechanism from Create. This advanced &bcrafting&r component is produced through &bSequenced&r Assembly using a Gold Sheet, Cogwheels, Large Cogwheels, and Iron Nuggets. It is an essential component for &badvanced&r machinery such as the Mechanical Arm, Extendo Grip, Potato Cannon, Rotation Speed Controller, Wand of Symmetry, and Train Controls."]
	quest.3D02C1DC3BAD13EC.quest_subtitle: "Master the art of precision"
	quest.3D048F3702C13593.quest_desc: [
		"&aDiscover&r the Glowing Grasslands, open fields covered in colorful plants and large flowers that &billuminate&r the terrain as fireflies drift by."
		""
		"Here you'll find Loom Corn, used to craft chandeliers, along with other materials tied to the biome's &bvibrant&r plant life."
	]
	quest.3D048F3702C13593.quest_subtitle: "Illuminated fields"
	quest.3D048F3702C13593.title: "Glowing Grasslands"
	quest.3D0D6BD228A40DB0.quest_desc: [
		"&aCraft&r a Diamond Hook, an exceptional upgrade &bdesigned&r for the most dedicated anglers. Forged with the strength of diamonds, this hook offers unmatched durability and reliability, allowing you to pursue rare &bfish&r and valuable treasures hidden within the deepest waters."
		""
		"&aOnly&r those who have &bmastered&r the art of fishing and gathered the finest materials can create such a remarkable tool. The Diamond Hook represents your dedication and prepares you for the greatest &bdiscoveries&r the oceans have to offer."
	]
	quest.3D0D6BD228A40DB0.quest_subtitle: "A flawless grip for legendary catches"
	quest.3D43A15A063440AC.quest_subtitle: "More Armor"
	quest.3D508229A4EF2EBA.quest_desc: ["&aThe&r Skillet is a cooking tool from Farmer's Delight &bused&r to fry and &bprepare&r different ingredients. It is &buseful&r for creating a variety of dishes and makes cooking more convenient and efficient."]
	quest.3D508229A4EF2EBA.quest_subtitle: "A handy pan for cooking a variety of meals"
	quest.3D6015E933436AD3.quest_desc: ["&6Obtain&r Netherite Diving Boots from Create. They are the upgraded version of the Diving Boots, providing &bbetter&r protection while retaining their special diving abilities. When worn, they make you descend faster in liquids, allow you to &bwalk&r and &bjump&r underwater, and prevent you from &bbeing&r affected by Mechanical Belts. They can be upgraded from Copper Diving Boots &busing&r a Netherite Ingot."]
	quest.3D6015E933436AD3.quest_subtitle: "Walk where the waters run deep"
	quest.3DA1BF04DF070E87.quest_subtitle: "More Weapon"
	quest.3DB00A7A20534E0E.quest_desc: ["&6Build&r the Mechanical Extruder and unlock a new way to &bautomate&r resource production. By using adjacent blocks and fluids together with &brotational&r power, the extruder can generate different blocks and items. The 1.21.1 version also supports recipe &brequirements&r such as speed, height, and biome, opening the door to more specialized production setups."]
	quest.3DB00A7A20534E0E.quest_subtitle: "Extrude your way to automation"
	quest.3DBBEF47766A607B.quest_desc: [
		"&aCraft&r the Ironwood Chestplate using Ironwood Ingots infused with the ancient magic of the Twilight Forest. Forged through the union of iron and enchanted forest energy, this chestplate &boffers&r exceptional durability and dependable protection for adventurers venturing into increasingly dangerous regions."
		""
		"&aAs&r the centerpiece of the Ironwood Armor set, it greatly enhances your &bsurvivability&r and prepares you for the powerful bosses and forgotten dungeons hidden throughout the Twilight Forest."
	]
	quest.3DBBEF47766A607B.quest_subtitle: "Protection forged from enchanted iron"
	quest.3DC56637C9258EAB.quest_desc: [
		"The Aeternium Anvil is required, along with a Netherite or Aeternium Smith Hammer, to work &aAeternium&r Ingots into plates and tool heads."
		""
		"It's the final crafting station needed to reach Better End's &bstrongest&r equipment tier."
	]
	quest.3DC56637C9258EAB.quest_subtitle: "Working the strongest metal"
	quest.3DCFD37B2600A64D.quest_desc: ["&dA&r special rune used for &bcrafting&r radiant equipment and items in Hazen N Stuff."]
	quest.3DCFD37B2600A64D.quest_subtitle: "A rune infused with radiant power"
	quest.3DE72CFC5A9D58D4.quest_desc: ["&6Gives&r your grid a 0 V &bground&r reference. You can use it to transfer &bpower&r, but be careful: with high potential and bad ground conditions the ground becomes electrified and damages nearby entities. Conductive blocks next to the rod improve the ground."]
	quest.3DE72CFC5A9D58D4.quest_subtitle: "A grounding rod"
	quest.3E02EDA7B1E00F3C.quest_desc: [
		"&aCraft&r the Knightmetal Axe using &brefined&r Knightmetal Ingots recovered from the Goblin Stronghold. Forged from an ancient alloy renowned for its unmatched resilience, this axe is equally effective at felling &btowering&r trees and cutting through heavily armored foes."
		""
		"&aIts&r razor-sharp edge and incredible durability reflect the craftsmanship of the forgotten knights who once &bdefended&r the Twilight Forest. Whether you're gathering resources or facing powerful enemies, the &bKnightmetal&r Axe is a dependable companion for every expedition."
	]
	quest.3E02EDA7B1E00F3C.quest_subtitle: "Forged for battle and timber alike"
	quest.3E1EF903B1766A34.quest_desc: ["&6A&r tool for removing &bwires&r. Right-click a wire to remove a hanging wire or a selected segment of a block wire; Shift + right-click removes the whole block wire. Keep it handy whenever you build wiring."]
	quest.3E1EF903B1766A34.quest_subtitle: "A tool for removing wires"
	quest.3E3A379D3259AC90.quest_subtitle: "More Armor"
	quest.3E5817559D2F96EE.quest_desc: [
		"&l&9Your&r&r backpack doesn't have to be filled with junk. The Void Upgrade automatically destroys items matching your filters, keeping unwanted drops from taking up &bvaluable&r storage space."
		""
		"Need more control? The Advanced Void Upgrade expands the filter system with more slots and &badditional&r filtering options, giving you precise control over what disappears into the void."
	]
	quest.3E5817559D2F96EE.quest_subtitle: "Turn unwanted items into nothing"
	quest.3E5817559D2F96EE.title: "Void \\& Advanced Void Upgrade"
	quest.3E615A7057AD51F8.quest_desc: [
		"&aThe&r Starfire Sword is a high-tier weapon from Eternal Starlight, crafted within the &bStarfire&r progression system."
		""
		"&aIt&r is created using smithing mechanics, requiring Starfire-related materials and &bprogression&r through the mod’s advanced content."
	]
	quest.3E615A7057AD51F8.quest_subtitle: "Forged by starlight"
	quest.3E7475004445436C.quest_desc: [
		"&dFloralite&r Shard is a rare crafting and upgrade material from Crystal Chronicles. It is &bused&r to &bupgrade&r the Plagued Armor from Iron’s Spells ’n Spellbooks into the powerful Venomous Crusader Armor set."
		""
		"The shard channels the power of Nature magic, transforming the &bplague-infused&r equipment into a stronger form with enhanced poisonous power. It is also connected to the creation of Poisonfang, a &bweapon&r of the Venomous Crusader."
	]
	quest.3E7475004445436C.quest_subtitle: "A toxic crystal shard that empowers the Plagued Armor"
	quest.3E8C0F1EF057758D.quest_desc: [
		"&dThe&r Wizard Hat and Wizard Hood are two variants of the same Wizard Armor headpiece in Iron's Spells 'n Spellbooks. Both provide &b+3&r Armor, &b+125&r Max Mana and &b+5%&r Spell Power."
		""
		"Craft either &bversion&r from Arcane Cloth and complete your Wizard &bset&r to strengthen your magical abilities."
	]
	quest.3E8C0F1EF057758D.quest_subtitle: "Choose your style and begin your path as a true wizard"
	quest.3E91EDA953E82973.quest_desc: ["&6Obtain&r a Copper Sheet from Create. &bIt&r is produced by using a Mechanical Press on a Copper Ingot and is an important &bcomponent&r for crafting Fluid Pipes, Copper Casings, Fluid Tanks, Hose Pulleys, and other Create components."]
	quest.3E91EDA953E82973.quest_subtitle: "Shape copper for greater creations"
	quest.3E91EDA953E82973.title: "Copper Sheet"
	quest.3EA64EDF89239B99.quest_desc: ["&6Stores&r &belectricity&r for later. As it discharges, its &bvoltage&r and resistance change."]
	quest.3EA64EDF89239B99.quest_subtitle: "Stores electricity"
	quest.3EACCB9717A18792.quest_desc: ["&aCraft&r a Block of Ancient Metal from the Cataclysm mod. This dense block is created by combining &b9&r Ancient Metal Ingots and represents a large collection of the &brare&r material recovered from &bancient&r desert civilizations."]
	quest.3EACCB9717A18792.quest_subtitle: "A monument forged from forgotten metal"
	quest.3EB5C38DB4E64A95.title: "Good"
	quest.3EC0F1242546B99D.quest_desc: [
		"&9&lSpeed&r&r up compatible Refined Storage devices with the Speed Upgrade. It increases the processing speed of &bsupported&r machines, allowing them to perform &btheir&r tasks more quickly and making your automated systems more efficient."
		""
		"Install it in a &bcompatible&r device and watch your network handle its work at a faster pace."
	]
	quest.3EC0F1242546B99D.quest_subtitle: "Make your network work faster"
	quest.3EC2174857A71EDC.quest_desc: [
		"&aThe&r Thermal Springstone Shovel is a digging tool from Eternal Starlight crafted &busing&r Thermal Springstone Ingots."
		""
		"It is used for &aexcavation&r in geothermal regions and represents mid-tier &bprogression&r in the Springstone equipment line."
	]
	quest.3EC2174857A71EDC.quest_subtitle: "Geothermal digging tool"
	quest.3ED18522AF559C2C.quest_subtitle: "More Armor"
	quest.3EDBE4F1B6766229.quest_desc: ["&aObtain&r the Spirit Sunderer from the Cataclysm: Spellbooks addon. This legendary weapon is imbued with dark spiritual energy, &ballowing&r its wielder to shatter the souls of enemies with &bdevastating&r strikes. It is a relic forged for those who have mastered the &bforbidden&r powers of Cataclysm. The item's recipe was updated in newer versions of the addon."]
	quest.3EDBE4F1B6766229.quest_subtitle: "Cleave through body and soul"
	quest.3EDBE4F1B6766229.title: "&bSpirit Sunderer"
	quest.3EF4816FC8FA1720.quest_desc: ["&6Craft&r the Slime Bucket to store Slime as a liquid. It is &bused&r in Create: Misc \\& Things for handling Slime Fluid and can be filled or emptied through the mod's fluid-processing mechanics. The mod's &bchangelog&r also includes fixes for the Slime Bucket emptying recipe."]
	quest.3EF4816FC8FA1720.quest_subtitle: "Store your slime in liquid form"
	quest.3EF99D3FF6FE02A9.quest_desc: [
		"Craft a &aCamera&r to &bstart&r taking photographs of your world."
		"Use it to document mobs, structures, and landscapes, and create your own album of discoveries."
	]
	quest.3EF99D3FF6FE02A9.quest_subtitle: "Capture the world around you"
	quest.3F01924DCEDFCDDF.quest_desc: ["&6Craft&r the Fan Sanding Catalyst to give an Encased Fan a sanding effect. Place it in the fan's airflow to perform bulk sanding without &bneeding&r sand as the catalyst. It was added to Create: Connected &bspecifically&r for compatibility with Create: Dreams \\& Desires."]
	quest.3F01924DCEDFCDDF.quest_subtitle: "Sand with nothing but air"
	quest.3F06982D4867D4BF.quest_desc: ["The Starlit Diamond Pickaxe is a &alate-game&r mining tool from Eternal Starlight, crafted from Starlit Diamond materials. It significantly improves mining &befficiency&r over Glacite and Springstone-tier tools and represents the final step &bbefore&r entering true celestial weapon progression."]
	quest.3F06982D4867D4BF.quest_subtitle: "Late-game celestial mining tool"
	quest.3F0BFA3B1F19E687.quest_subtitle: "More Armor"
	quest.3F1546190B6A6455.quest_subtitle: "More Armor"
	quest.3F233646744ED538.quest_subtitle: "Yummy!"
	quest.3F2A877CEDBEE653.quest_desc: [
		"&aCraft&r the Knightmetal Sword using refined Knightmetal &bIngots&r recovered from the Goblin Stronghold. Forged from an ancient alloy prized for its &bincredible&r strength, this sword embodies the martial legacy of the knights who once &bdefended&r the Twilight Forest from every threat."
		""
		"&aIts&r perfectly balanced blade delivers &bdevastating&r strikes while remaining exceptionally durable, making it one of the finest weapons available before the greatest challenges awaiting in the enchanted realm. With the &bKnightmetal&r Sword in hand, you carry the legacy of &bwarriors&r whose courage has endured through the ages."
	]
	quest.3F2A877CEDBEE653.quest_subtitle: "The blade of forgotten guardians"
	quest.3F3A3DE0D50F9E17.quest_desc: ["&aLocate&r the Cursed Pyramid from the Cataclysm mod. This massive &bdungeon&r rarely generates in Desert biomes and &bserves&r as the home of the Ancient Remnant. Inside, you'll encounter deadly traps, hidden chambers, Koboletons, Kobolediators, Wadjet, and valuable loot. To find the &bstructure&r more easily, craft and use the Eye of Desert, which &bpoints&r toward the nearest Cursed Pyramid"]
	quest.3F3A3DE0D50F9E17.quest_subtitle: "Seek the resting place of the Ancient Remnant"
	quest.3F3A3DE0D50F9E17.title: "&6Cursed Pyramid"
	quest.3F5A3A014131ECFB.quest_subtitle: "Upgrade+"
	quest.3F6285C1B5B1C201.quest_desc: [
		"&aObtain&r Crystal Shards, gathered by mining the glowing Aurora Crystal formations found in the &aCrystal Mountains&r."
		""
		"They're one of the most commonly used ingredients across Better End's &bInfusion Rituals&r."
	]
	quest.3F6285C1B5B1C201.quest_subtitle: "Shards of the Aurora Crystal"
	quest.3F7E8885F0AB8EE0.quest_desc: [
		"&9&lTake&r&r automation beyond storage with the Destructor. It automatically breaks blocks placed in front of it and sends the &bcollected&r drops back into your Refined Storage network."
		""
		"Connect it to your network and use it to automate resource collection, clearing areas or feeding &bmaterials&r into other automated systems."
	]
	quest.3F7E8885F0AB8EE0.quest_subtitle: "Break blocks and send the resources back to storage"
	quest.3F8479EB2D826221.quest_subtitle: "Yummy!"
	quest.3F8D08A9D5262E95.quest_desc: [
		"&dShadow-Walker&r Leggings are part of the Shadow-Walker Armor set in Iron's Spells 'n Spellbooks. When worn, they provide &b+6&r Armor, &b+125&r Max Mana, &b+10%&r Ender Spell Power and &b+5%&r Spell Power."
		""
		"They can be &bcrafted&r from 7 Arcane Cloth and 1 Ender Rune, or upgraded from Wizard Leggings with 1 Ender Rune at a Smithing Table in supported versions. Runestones are used to craft stronger school-specific armor."
	]
	quest.3F8D08A9D5262E95.quest_subtitle: "Channel the mysterious power of Ender magic through your armor"
	quest.3FBF365A6CA7396C.quest_desc: [
		"&eSometimes&r all you need is a little more power behind your punch."
		""
		"The Power Glove &bincreases&r the damage of your attacks by &b4&r points, turning every hit into a much heavier blow. Simple, brutal and effective."
		""
		"&bPut&r it on and hit harder."
	]
	quest.3FBF365A6CA7396C.quest_subtitle: "Power is in your hands"
	quest.3FC28E1387EC53BE.quest_desc: ["&aVisit&r every Nether biome and uncover the full diversity of this hostile dimension. &bFrom&r crimson &bforests&r to soul sand valleys, each biome holds unique dangers, resources, and secrets &bwaiting&r to be discovered."]
	quest.3FC28E1387EC53BE.quest_subtitle: "Explore every corner of the infernal dimension"
	quest.3FC28E1387EC53BE.title: "&l&cMaster of the Nether"
	quest.3FC55EE27A30FADB.quest_desc: [
		"The Crystalite Chestplate is created through an Infusion Ritual — a Terminite Chestplate, an Amber Gem, and Crystal Shards placed around an &aInfusion Pedestal&r."
		""
		"Once worn, it grants extra armor and permanent &bHaste I&r, making it one of Better End's top-tier armor pieces."
	]
	quest.3FC55EE27A30FADB.quest_subtitle: "Chestplate born from infusion"
	quest.3FC55EE27A30FADB.title: "&dCrystalite Chestplate"
	quest.3FC9AB54F29DC2C5.quest_desc: ["&6Upgrade&r your electric motors with the Basic Motor Extension and Advanced Motor Extension. &bThese&r components expand the capabilities of their re&bspective&r motor tiers, allowing you to build more &bpowerful&r and efficient electrical drive systems."]
	quest.3FC9AB54F29DC2C5.quest_subtitle: "Push your motors further"
	quest.3FE18FEA1B0B4889.quest_desc: ["&6The&r Fluid Hatch is a utility block added in Create: Dreams n' Desires. It provides a convenient way to insert and &bextract&r fluids from fluid tanks, making fluid handling easier in automated factory setups. It was &bintroduced&r alongside the Fluid Gauge in the 2.2a-BETA &bupdate&r for Minecraft 1.21–1.21.1."]
	quest.3FE18FEA1B0B4889.quest_subtitle: "Access your fluids with ease"
	quest.40067D14E89C9DBB.quest_desc: [
		"The Terminite Shovel is a &adigging&r tool forged from Terminite Ingots, offering improved durability over the Thallasium tier."
		""
		"It's used for excavation while working toward Better End's &bhigher-tier&r gear."
	]
	quest.40067D14E89C9DBB.quest_subtitle: "Digging tool, refined"
	quest.40209A8EB64D978A.quest_desc: [
		"&eLooking&r to get better deals from the villagers? This simple hat might be exactly what you need."
		""
		"Wearing the Villager Hat &bincreases&r your reputation with villagers, causing their trades to become cheaper. A small &bprice&r to pay for a much better bargain."
	]
	quest.40209A8EB64D978A.quest_subtitle: "A little charm goes a long way"
	quest.406A1AC2857DD193.quest_subtitle: "More Armor"
	quest.406FE853DF7C06B0.quest_subtitle: "Upgrade+"
	quest.4072857BFD478132.quest_desc: ["&aCraft&r a full set of iron tools – pickaxe, axe, and sword. These will help you gather resources faster and &bsurvive&r tougher challenges."]
	quest.4072857BFD478132.quest_subtitle: "Stronger Tools Ahead"
	quest.4072857BFD478132.title: "Iron Tools"
	quest.407DB3F12F46CA53.quest_desc: ["&6Craft&r the Empty Fan Catalyst and use it as a base for specialized fan-processing catalysts. Apply a compatible item to convert it into the &bcorresponding&r catalyst, allowing the same compact block to provide different effects when air from an Encased Fan passes through it. The &bcatalyst&r can later be returned to its empty state through crafting."]
	quest.407DB3F12F46CA53.quest_subtitle: "A blank canvas for fan processing"
	quest.4098CE9ADD68B6BC.quest_desc: [
		"&6A&r proper train &bdeserves&r a proper pilot. The Andesite Alloy Train Pilot brings the familiar Create aesthetic to the driver's position, giving your locomotive a distinctive industrial look."
		""
		"&bInstall&r it on your train and take the controls. The railway is yours to command."
	]
	quest.4098CE9ADD68B6BC.quest_subtitle: "Take control of your train in style."
	quest.40AECDBEEED9B76F.quest_desc: ["&6A&r wire made of gold. Needed for BJT transistors, and usable as ordinary wiring."]
	quest.40AECDBEEED9B76F.quest_subtitle: "Wire made of gold"
	quest.40BC86739EDE056D.quest_desc: ["&6Obtain&r a Pulse Timer from Create. It acts as a compact redstone clock, &brepeatedly&r emitting short Redstone pulses with a manually adjustable interval between them. The timing can be set from &b2&r ticks up to &b60&r minutes, making it useful for automated machines, farms, doors, and other timed contraptions. It can also be inverted to remain powered by default and produce short off-pulses."]
	quest.40BC86739EDE056D.quest_subtitle: "Master the rhythm of automation"
	quest.40D36BF2359F1C49.quest_desc: ["&6The&r vertical version of the housing. Use it when you build a generator vertically."]
	quest.40D36BF2359F1C49.quest_subtitle: "A vertical housing"
	quest.40D45535B1A846CF.quest_desc: ["&aCraft&r the Ignis Mage Hat from the Cataclysm: Spellbooks addon. This &benchanted&r headpiece is part of the Ignis Mage Robes set, infused with the &bpower&r of Ignis and the eternal flames of the Nether. It represents the &bmastery&r of fire magic and the legacy of the Lord of Fire."]
	quest.40D45535B1A846CF.quest_subtitle: "The crown of the flame sorcerer"
	quest.40F8ADF3428A2EDC.quest_desc: ["&dKeres&r is a cursed glaive with blood-red insignia etched into its blade. The weapon is particularly effective against &bhigh-HP&r targets. To obtain its base material, find Blood Monoliths in Nether Fortresses and defeat the Traversers that spawn there."]
	quest.40F8ADF3428A2EDC.quest_subtitle: "The Cursed Glaive"
	quest.40F8ADF3428A2EDC.title: "&l&cKeres"
	quest.41050CD762EB31A4.quest_desc: ["&6Obtain&r a Brass Sheet from Create. It is produced by pressing a Brass Ingot with a Mechanical Press and is an important material for &badvanced&r Create components such as Brass Casings, Brass Hands, Brass Tunnels, Mechanical Arms, and Redstone Links."]
	quest.41050CD762EB31A4.quest_subtitle: "Press brass into advanced components"
	quest.4109B752110879B4.quest_desc: ["&dA&r special ring that &bimproves&r the efficiency of the wearer."]
	quest.4109B752110879B4.quest_subtitle: "A ring that improves your magical efficiency"
	quest.412C1C81447406A5.quest_desc: ["&aCraft&r the Pharaoh's Sacred Skirt from the Cataclysm: Spellbooks addon. This &benchanted&r garment is part of the Pharaoh Wizard Armor set, inspired by the Ancient Remnant and the forgotten pharaohs buried beneath the desert. It enhances Sand &bmagic&r and completes the sacred &battire&r of the ancient rulers."]
	quest.412C1C81447406A5.quest_subtitle: "Complete the regalia of the desert kings"
	quest.413AEF73C243C26B.quest_desc: [
		"&6A&r long journey needs a reliable supply of fuel. The Fuel Tank stores liquid fuel directly on your train, &ballowing&r the locomotive to draw from it while travelling."
		""
		"&bInstall&r a Fuel Tank, fill it with fuel and keep your train &brunning&r wherever the tracks may lead."
	]
	quest.413AEF73C243C26B.quest_subtitle: "Keep your locomotive fueled for the journey ahead."
	quest.4159DC055AEBC63E.quest_desc: ["&aEliminate&r 15 Blazes from Nether Fortresses. These fire-based mobs are essential for progression into advanced potion brewing and End &baccess&r preparation."]
	quest.4159DC055AEBC63E.quest_subtitle: "Nether Fortress extermination"
	quest.4159DC055AEBC63E.title: "Blaze"
	quest.416A444335065180.quest_subtitle: "Yummy!"
	quest.416BA569BF21D6E7.quest_desc: ["&6Obtain&r an Empty Blaze Burner from Create. It is the first &bstep&r toward creating a functioning Blaze Burner, one of the &bessential&r heating components for advanced Create machinery. The Empty Blaze Burner can be filled by right-clicking a Blaze or Blaze Spawner with it. Once filled, it can &bprovide&r heat for heated and superheated recipes, including the production of Brass."]
	quest.416BA569BF21D6E7.quest_subtitle: "Capture the flame of creation"
	quest.417B1EC50CC12318.quest_subtitle: "More Armor"
	quest.418C4186A1C86543.quest_desc: [
		"&aThe&r Flowglaze Shovel is a digging tool from Eternal Starlight, belonging to the Flowglaze &bequipment&r tier."
		""
		"&aIt&r is used for excavation and terrain clearing as part of the mid-to-late game Flowglaze &bprogression&r system."
	]
	quest.418C4186A1C86543.quest_subtitle: "Flow excavation tool"
	quest.41964134B525775C.quest_subtitle: "Yummy!"
	quest.41B1E26A355F0D28.quest_desc: ["&6The&r Super Enchanting Template is an &badvanced&r item from Create: Enchantment Industry. It is created by pressing a Block of Super Experience with a Mechanical Press. The template is &bused&r for Super Enchanting, allowing &benchantments&r to be &btransferred&r or removed beyond normal limits. It must be &bprocessed&r using a Blaze Forger in Super Enchanting mode."]
	quest.41B1E26A355F0D28.quest_subtitle: "Go beyond the limits of ordinary enchantments"
	quest.41C3C5CD7A81B511.quest_subtitle: "Yummy!"
	quest.41C9A66CA85B6D10.quest_desc: ["&6The&r Basic Solar Heating Plate uses sunlight to &bgenerate&r heat for your thermal systems in Create: New Age. Connect it to Heat Pipes and &bbegin&r building a renewable heat source for your factory."]
	quest.41C9A66CA85B6D10.quest_subtitle: "Harness the heat of the sun"
	quest.41D05D51E88391EF.title: "&5&lThe Leviathan"
	quest.41D4A0A849FDE705.quest_desc: [
		"&aThe Ender Chest&r is a special storage block connected to the End."
		"Items stored inside are shared across all Ender Chests you place in the world, but only you can access them."
		"It is extremely useful for safely storing &bvaluable&r items during &bexploration &rand &bdangerous &r&badventures&r."
	]
	quest.41D4A0A849FDE705.quest_subtitle: "Personal dimensional storage"
	quest.41D4A0A849FDE705.title: "Ender Chest"
	quest.41D5492A3FB2B9DF.quest_desc: ["&dA&r special rune used for crafting &bhealth-related&r equipment in Hazen N Stuff."]
	quest.41D5492A3FB2B9DF.quest_subtitle: "A rune infused with vital energy"
	quest.41E15FB448BB13FC.quest_desc: [
		"&dCryomancer&r Hood is the headpiece of the Cryomancer Armor set in Iron's Spells 'n Spellbooks. When worn, it provides &b+3&r Armor, &b+125&r Max Mana, &b+10%&r Ice Spell Power and &b+5%&r Spell Power."
		""
		"It can be &bcrafted&r from 5 Arcane Cloth and 1 Ice Rune."
	]
	quest.41E15FB448BB13FC.quest_subtitle: "Master the freezing power of Ice magic"
	quest.41ED63552616BCF5.title: "&6&lIgnis"
	quest.42076947AD7E263F.quest_desc: [
		"&dPrismatic&r Knight Leggings are part of the Prismatic Knight Armor set, the &bstrongest&r armor set in Crystal Chronicles."
		""
		"They are &bcrafted&r using a Divine Soulshard from Iron’s Spells ’n Spellbooks and can be created by &bupgrading&r the leggings from any enhanced Crystal Chronicles armor set. The Prismatic Knight Armor &brepresents&r the final and most powerful stage of the Crystal Chronicles armor progression."
	]
	quest.42076947AD7E263F.quest_subtitle: "The ultimate leggings forged from the power of the Crystal Chronicles"
	quest.420C27578506FB64.quest_desc: ["&aObtain&r the Bloom Stone Greaves from the Cataclysm: Spellbooks addon. Add this &bpowerful&r piece of equipment to your collection and continue your journey through the secrets and &brelics&r introduced by the addon."]
	quest.420C27578506FB64.quest_subtitle: "Power born from ancient stone"
	quest.421737CC1BBE3105.quest_desc: ["&aObtain&r the Dragon Skull from the Bosses' Rise mod. This ancient &brelic&r is taken from the remains of a mighty dragon and serves as a symbol of victory over one of the most fearsome &bcreatures&r in the world. A true dragon hunter &bearns&r the right to claim such a trophy."]
	quest.421737CC1BBE3105.quest_subtitle: "A trophy from the fallen dragon"
	quest.422978F1319FC774.quest_desc: ["&aGold enhance&rs Netherite with unique properties. While not always the strongest, it brings special qualities that can aid you in &bdangerous situations&r."]
	quest.422978F1319FC774.quest_subtitle: "Power and elegance"
	quest.422978F1319FC774.title: "Gold Netherite Ingot"
	quest.42358ED7CCE6EBB3.quest_desc: ["&6Six&r Dark Chocolate Bars wrapped in paper create a Full Dark Chocolate Bar. This rich treat can be eaten up to 16 times, and every bite &bgrants&r the Stimulation effect for 5 seconds."]
	quest.42358ED7CCE6EBB3.quest_subtitle: "A rich dark chocolate bar, ready for sixteen indulgent bites."
	quest.424371C3AAC0A9EE.quest_desc: ["&bCreate&r the Starcatcher Hook to attach to your rod. This will allow you to catch fish more effectively and reel in rare &bfinds&r."]
	quest.424371C3AAC0A9EE.quest_subtitle: "Craft the fishing hook"
	quest.424371C3AAC0A9EE.title: "Starcatcher Hook"
	quest.425D0951904E068B.quest_desc: ["&6A&r decorative copper cladding for building. It is also used for the circuit design table and the solar panel bearing."]
	quest.425D0951904E068B.quest_subtitle: "Copper cladding"
	quest.426043824AFC8A77.quest_desc: ["&6Obtain&r a Clutch, Encased Chain Drive, and Adjustable Chain Gearshift from Create. Together, these &bcomponents&r give you greater control over rotational power: the Clutch can stop power &btransmission&r when powered by Redstone, the Encased Chain Drive transfers rotation through connected chains, and the Adjustable Chain Gearshift allows the &bspeed&r of those chains to be precisely adjusted &busing&r a Redstone signal."]
	quest.426043824AFC8A77.quest_subtitle: "Control the flow of mechanical power"
	quest.426DFA958D4BC450.quest_desc: [
		"&aThe&r Flowglaze Sword is a weapon from Eternal Starlight, part of the Flowglaze equipment &bprogression&r system."
		""
		"&aIt&r is crafted &busing&r Flowglaze materials and belongs to the mod’s mid-to-late game weapon tier."
	]
	quest.426DFA958D4BC450.quest_subtitle: "Flow-forged blade"
	quest.4284E40A2D236E99.quest_desc: ["&aLocate&r the Frosted Prison from the Cataclysm mod. This frozen structure is hidden within icy biomes and contains dangerous enemies, valuable loot, and a powerful &bchallenge&r waiting inside."]
	quest.4284E40A2D236E99.quest_subtitle: "Discover the frozen stronghold"
	quest.4284E40A2D236E99.title: "&6Find &3Frosted Prison"
	quest.4286344D3350D02E.quest_desc: ["&aObtain&r the Ring of Grudged from the Cataclysm mod. This rare Curios ring can be found in chests inside the &bAbandoned&r Temple structure. &bWhen&r equipped, it grants &b+10%&r Critical Damage."]
	quest.4286344D3350D02E.quest_subtitle: "A relic of forgotten ruins"
	quest.4286344D3350D02E.title: "&bRing Of Grudged"
	quest.428A768B5D2EEC62.quest_desc: ["&dYour&r bullets reel hit creatures &btowards&r you on a chain, up to a maximum range."]
	quest.428A768B5D2EEC62.quest_subtitle: "Get over here"
	quest.4295BC2776372EAB.quest_desc: ["&6Process&r Apples with a Mechanical Press to produce Apple Must. This freshly pressed apple juice is a key ingredient in Create: Winery, where it can be &bprocessed&r further into Cider using the Wine Cellar."]
	quest.4295BC2776372EAB.quest_subtitle: "Press the apples for the perfect start"
	quest.42DF3D7F94ED5105.quest_desc: ["&aObtain&r the Music Disc Scylla, a &brare&r record dropped by Scylla after her defeat. The disc plays “Scylla” by Rotch Gwylt, the music &bassociated&r with the battle against the Storm Empress."]
	quest.42DF3D7F94ED5105.quest_subtitle: "The song of the Storm Empress"
	quest.42FED4B781CBE750.quest_subtitle: "More Armor"
	quest.4310A3F0D103F3BB.quest_subtitle: "Yummy!"
	quest.431220B37B625AF7.quest_desc: [
		"&6When&r exploration isn't enough, bring the fight to the skies. The Warship is a massive aircraft built from copper and steel, &bequipped&r with four seats, a moving turret and six weapon mounts."
		""
		"Build this &bairborne&r fortress, arm it to the teeth and take control of the skies."
	]
	quest.431220B37B625AF7.quest_subtitle: "A flying fortress built to rule the skies."
	quest.4320C19B8F643761.quest_desc: ["&aEcho&r Charges can be f&bound&r inside the Deepslate Vaults hidden within the Ancient Keep. Gather enough of them to awaken the dormant &bmachine&r — The Last of Deepslate. Your &bjourney&r through the Ancient &bKeep&r has only just begun."]
	quest.4320C19B8F643761.quest_subtitle: "Energy of the Fallen"
	quest.432497F8917F0C59.quest_desc: [
		"&aObtain&r the Aeternium Upgrade Smithing Template, used at a Smithing Table to upgrade a full piece of Terminite armor into &bAeternium&r."
		""
		"Aeternium is the strongest material added by Better End, surpassing even &bNetherite&r."
	]
	quest.432497F8917F0C59.quest_subtitle: "Upgrading toward Aeternium"
	quest.4328D2F295C8640C.quest_desc: ["&6Obtain&r a Mechanical Crafter from Create. These machines work together to automatically craft items using rotational power. Multiple Crafters can be &bconnected&r into complex patterns, allowing you to automate recipes that are impossible to make with a normal Crafting Table, including &badvanced&r components such as Crushing Wheels, Extendo Grip, Potato Cannon, and Wand of Symmetry."]
	quest.4328D2F295C8640C.quest_subtitle: "Automate the art of crafting"
	quest.434B7CA4C1D5CCB0.quest_subtitle: "More Armor"
	quest.4351D7310BADF087.quest_desc: [
		"&dDivinite&r Shard is a rare crafting material from Crystal Chronicles. It is used to upgrade the Priest Armor from Iron’s Spells ’n Spellbooks into the &bpowerful&r Paladin Armor set."
		""
		"The shard channels the power of Holy magic, allowing the original Priest equipment to be &btransformed&r into its enhanced Paladin forms."
	]
	quest.4351D7310BADF087.quest_subtitle: "A divine crystal shard used to empower the Priest Armor"
	quest.43679C401B345C76.quest_desc: ["&6Prepare&r a delicious Chocolate Milkshake using the &bprocessing&r power of Create: Dreams n' Desires. A simple and sweet recipe that adds a tasty &bnew&r product to your factory's food production."]
	quest.43679C401B345C76.quest_subtitle: "A sweet blend of chocolate and cream"
	quest.4388CC49044CE26B.quest_desc: [
		"&eUsing&r the claiming map system, you can now claim chunks of the world as your own territory."
		"&aClaimed&r chunks are protected from other players and can be used to safely &bbuild,&r store items, and create your base without interference."
		"This is an important step toward establishing full control over your survival &aworld.&r"
	]
	quest.4388CC49044CE26B.quest_subtitle: "Read This First!"
	quest.4388CC49044CE26B.title: "&eClaiming Territory"
	quest.438E5892B8012353.title: "OMG AGAIN?!"
	quest.43B03B96D3B58837.quest_desc: ["&dThe&r Tricorne increases the &bdamage&r of the first shot fired from a full magazine. Wear it when you plan your shots carefully; a kill with that first shot earns Pistols at Dawn."]
	quest.43B03B96D3B58837.quest_subtitle: "Make the first shot count"
	quest.43B796678ABA8146.quest_desc: [
		"In the harsh &bregions&r of Eternal Starlight, Thirst Walkers roam aimlessly, driven by an &aunknown&r craving for energy or essence."
		"These hostile creatures are highly aggressive when approached and can quickly overwhelm unprepared players with their &bspeed&r and &brelentless&r attacks."
		""
		"&aDefeating&r them is necessary to survive deeper exploration in unstable environments."
	]
	quest.43B796678ABA8146.quest_subtitle: "Dry hunger in motion"
	quest.43B796678ABA8146.title: "Thirst Walker"
	quest.43BBA5365233F199.quest_desc: [
		"&9&lIncrease&r&r the yield of compatible mining operations with the Fortune I Upgrade. It allows supported machines and devices to benefit from the first level of Fortune, giving you a chance to obtain more &bresources&r when processing certain blocks."
		""
		"A &buseful&r upgrade for maximizing your resource production and making automated mining systems more rewarding."
	]
	quest.43BBA5365233F199.quest_subtitle: "Get more resources from every block"
	quest.43F59DEA9BF0CAD8.quest_subtitle: "More Armor"
	quest.44168C844B8DBABD.quest_desc: ["&aObtain&r Brontes from L_Ender’s Cataclysm. Brontes is one of the powerful weapons added to Cataclysm and belongs to the same heavy-hammer &barsenal&r as Ceraunus. The Cataclysm changelog &bspecifically&r notes that Brontes was added alongside an Ancient Spear configuration option."]
	quest.44168C844B8DBABD.quest_subtitle: "Wield the thunderous hammer"
	quest.44168C844B8DBABD.title: "&bBrontes"
	quest.442062D6B4CB62BC.quest_desc: ["&6Rose&r Quartz is a crafting material used throughout Create's progression. Its main purpose is to be polished with Sand Paper, producing Polished Rose Quartz. The polished version is an important &bingredient&r for Electron Tubes and Rose Quartz Lamps, as well as decorative Rose Quartz blocks. Rose Quartz can also be &bprocessed&r through Create's automation using a &bDeployer&r with Sand Paper."]
	quest.442062D6B4CB62BC.quest_subtitle: "A rose-tinted ingredient"
	quest.442463019B23DBA1.quest_desc: [
		"&9&lExpand&r&r your Refined Storage network with the Disk Interface. It allows storage disks to be accessed and managed through an external connection, giving you more &bflexibility&r when designing your digital storage system."
		""
		"&bUse&r it to connect compatible storage &bcomponents&r and create a more versatile setup for managing your storage disks."
	]
	quest.442463019B23DBA1.quest_subtitle: "Connect external storage directly to your network"
	quest.444F80A3A15EDAC9.quest_desc: ["&dThe&r Alchemist Cauldron is a magical workstation from Iron's Spells 'n Spellbooks. It can brew potions and elixirs, recycle spell scrolls into ink, &bupgrade&r ink to higher rarities, and &bproduce&r Blood Vials. It has 4 input and 4 output slots and requires water to operate."]
	quest.444F80A3A15EDAC9.quest_subtitle: "Master the art of magical alchemy"
	quest.445BBBB98EF2E005.quest_desc: [
		"&dElectromancer&r Robe is the chestpiece of the Electromancer Armor set in Iron's Spells 'n Spellbooks. When worn, it provides &b+8&r Armor, &b+125&r Max Mana, &b+10%&r Lightning Spell Power and &b+5%&r Spell Power. It can also be imbued with 1 spell."
		""
		"It can be &bcrafted&r from 8 Arcane Cloth and 1 Lightning Rune, or upgraded from Wizard Robes with 1 Lightning Rune at a Smithing Table in supported versions."
	]
	quest.445BBBB98EF2E005.quest_subtitle: "Channel the devastating power of Lightning magic"
	quest.4461D8E0E15DABBB.quest_subtitle: "More Armor"
	quest.446A261C6E77931A.quest_desc: ["&6Craft&r the Sticky Boots from Create: Misc \\& Things. While sneaking, they &bprotect&r you from fall damage from falls of up &bto&r 8 blocks. Hold sneak + jump to perform a powerful jump, reaching a maximum height of about &b4.125&r blocks. They provide &b3&r armor points and 1 armor toughness."]
	quest.446A261C6E77931A.quest_subtitle: "Stick to the ground, then leap away"
	quest.446FF4F9537F5FBB.quest_desc: ["Iron ingots are the foundation of many &btools&r, &bweapons&r, and &barmor&r. Smelt iron ore in a furnace to get these essential building blocks and prepare for your adventures ahead."]
	quest.446FF4F9537F5FBB.quest_subtitle: "Smelt It Right"
	quest.446FF4F9537F5FBB.title: "Molten Potential"
	quest.447A227260CFFD99.quest_subtitle: "Yummy!"
	quest.4480A44A95F9B8C0.quest_subtitle: "More Armor"
	quest.44827007A009AB60.quest_desc: ["&6Whip&r up a Chocolate Milkshake and &bfill&r a bucket with it. A delicious addition from Create: Dreams n' Desires, perfect for anyone who wants to &bbring&r a little sweetness into their factory."]
	quest.44827007A009AB60.quest_subtitle: "A sweet treat for the factory floor"
	quest.4499B939F0167AC3.quest_desc: ["&6Plays&r back a sequence of &bsignals&r: when it reads a hole it connects the common terminal to an output pin. It needs a kinetic input, and &brotation&r speed sets the reading speed. Cards can be inserted manually or &bautomatically&r."]
	quest.4499B939F0167AC3.quest_subtitle: "A punch card reader"
	quest.44C0D8A6DF8C5CE3.quest_subtitle: "More Armor"
	quest.44C37A25BA4D5570.quest_desc: ["&6The&r Crafting Blueprint lets you save crafting recipes and craft them on demand. Place it like a painting and &bright-click&r a slot to open its interface, then insert the ingredients to save a recipe. You can use Filters to allow multiple possible recipes for a slot. Once a recipe is saved, right-clicking the Blueprint crafts the item &busing&r available materials, while Shift + &bright-click&r crafts up to a full stack. &bLeft-clicking&r removes a saved recipe. The Blueprint can cover an area up to &b3×3&r blocks."]
	quest.44C37A25BA4D5570.quest_subtitle: "Save your recipes for later"
	quest.44D968C6F3BDF1DD.quest_desc: [
		"&eThe&r world is full of &btreasures&r waiting to be discovered. Artifacts are powerful relics that cannot simply be crafted — you must explore, search and take risks to &bobtain&r them."
		""
		"From ancient ruins to hidden campsites, every &bexpedition&r could lead you to something extraordinary. Keep your eyes open, because not &bevery&r chest is what it seems..."
		""
		"Collect these &bmysterious&r artifacts and discover what powers they hold."
	]
	quest.44D968C6F3BDF1DD.quest_subtitle: "Treasures beyond the ordinary."
	quest.44D968C6F3BDF1DD.title: "&f&lWelcome &6Artifacts"
	quest.44DD7D28A4508512.quest_desc: ["The undead roam the world after nightfall. Defeat &b20&r zombies and &b20&r skeletons to prove you can survive the night and face the basic dangers of the world. This is an important step toward becoming a true warrior."]
	quest.44DD7D28A4508512.quest_subtitle: "Cleanse the world of the undead"
	quest.44DD7D28A4508512.title: "&4Night Hunt"
	quest.44E1D5E415056898.quest_subtitle: "Yummy!"
	quest.44F1B8D4B6BCC1F1.quest_desc: [
		"{image:waystones:item/warp_stone width:100 height:100 align:center}"
		"vars"
	]
	quest.44F1B8D4B6BCC1F1.title: "JESTEM GEJEM"
	quest.44F9622D310E881A.quest_desc: [
		"&dBattle-Evoker&r Tunic is the Crystal Chronicles upgraded version of Archevoker Coat from Iron’s Spells ’n Spellbooks."
		""
		"It is &bupgraded&r using an Avaricite Shard, transforming the original Archevoker Armor into the powerful Battle-Evoker Armor set. The Avaricite Shard infuses the tunic with &badditional&r Evocation magic, creating a stronger &bcombat-focused&r version of the Archevoker gear."
	]
	quest.44F9622D310E881A.quest_subtitle: "An enhanced form of Archevoker Coat, empowered by Avaricite"
	quest.450E7B501081C4CE.quest_desc: ["&6Fueling&r Tanks are portable fuel containers from Create Stuff 'N Additions, &bdesigned&r to supply fuel to compatible equipment such as jetpacks and exoskeletons. They come in Small, Medium and Large sizes, &bwith&r capacities of 800 mB, 1600 mB and 3200 mB respectively. The larger versions are &bupgrades&r of the smaller tanks, giving you more fuel for longer adventures and longer &boperation&r of your powered equipment."]
	quest.450E7B501081C4CE.quest_subtitle: "Keep your machines running"
	quest.450E7B501081C4CE.title: "Fueling Tanks"
	quest.4530DE42E43FC68B.quest_desc: [
		"&l&9Some&r&r resources are simply too &bvaluable&r to ever run out of. The Survival Infinity Upgrade turns selected backpack slots into infinite sources of items. Any item placed into an affected slot can be extracted endlessly while the upgrade remains active."
		""
		"Unlike the &badmin-only&r Infinity Upgrade, this version is made for survival gameplay — but obtaining it is meant to be a true endgame achievement."
	]
	quest.4530DE42E43FC68B.quest_subtitle: "Turn your rarest resources into an endless supply"
	quest.4548E44B70A2AF8F.quest_subtitle: "Yummy!"
	quest.454B93C602615809.quest_desc: ["&dA&r special rune used for crafting &barchery-related&r equipment in Hazen N Stuff."]
	quest.454B93C602615809.quest_subtitle: "A rune infused with the power of archery"
	quest.4568300E5E2FD231.quest_subtitle: "More Armor"
	quest.456DDE7BE0D37214.quest_desc: ["&6Obtain&r a Portable Fluid Interface from Create. It allows fluids to be &btransferred&r between a &bstationary&r fluid system and the fluid inventory of a moving Contraption. Two interfaces must face each other, with one &battached&r to the contraption and the other remaining stationary. A Fluid Pump is &brequired&r to move the fluids."]
	quest.456DDE7BE0D37214.quest_subtitle: "Bring fluids wherever your contraption goes"
	quest.45893C5D648C164B.quest_desc: ["&6The&r Vault Component is a module for the Brass Drone that gives it &badditional&r inventory space. Install it on the drone to let it carry items while you control it remotely. This makes the Brass Drone useful not only for scouting, but also for &btransporting&r and collecting items from places that are &bdifficult&r to reach. The Vault Component is one of the available Brass Drone modules, alongside the Fan, Drill and Magnet modules."]
	quest.45893C5D648C164B.quest_subtitle: "Give your drone some storage"
	quest.4594F69974180053.quest_subtitle: "More Armor"
	quest.459FAFCD147C1A9E.quest_subtitle: "Upgrade+"
	quest.45AA767D92A64DFD.quest_subtitle: "More Armor"
	quest.45CC771F7380273D.quest_desc: ["&aObtain&r the Vitality Ankh from the Cataclysm mod. This ancient accessory is a powerful defensive &brelic&r that grants the wearer increased &bsurvivability&r and protects against deadly situations. It is forged from &brare&r materials and represents the mastery of ancient life energy."]
	quest.45CC771F7380273D.quest_subtitle: "A relic that defies death"
	quest.45D0E5A061585578.quest_desc: [
		"&dVoidwalker&r Boots are the Crystal Chronicles &bupgraded&r version of the Shadow Walker Boots from Iron’s Spells ’n Spellbooks."
		""
		"They are upgraded using an Abyssal Crystal Shard, &btransforming&r the original Shadow Walker Armor into the &bpowerful&r Voidwalker Armor set. The Abyssal Crystal Shard infuses the boots with the power of the Abyss, enhancing the dark and shadowy abilities of the original equipment."
	]
	quest.45D0E5A061585578.quest_subtitle: "An enhanced form of Shadow Walker Boots, empowered by Abyssal Crystal"
	quest.45D8B95FB70703AC.quest_desc: ["&6Craft&r the Brass Speaker and bring sound and &bannouncements&r to your Create builds. Use it to play sounds and send custom messages in chat, making it especially &buseful&r for train stations and &bautomated&r factories. The Brass Speaker uses the Vibration Mechanism in its crafting."]
	quest.45D8B95FB70703AC.quest_subtitle: "Make some noise"
	quest.45DAC58E4B0DB02C.quest_desc: ["&aThe&r Iron Grappling Hook lets you &buse&r a hook and rope to move through the world. By attaching it to &bsurfaces,&r you can traverse difficult areas more easily."]
	quest.45DAC58E4B0DB02C.quest_subtitle: "Reach Places You Couldn't Before"
	quest.45DF3A28B5316C54.quest_desc: [
		"&aCraft&r a Diamond Fillet Knife, the &bpinnacle&r of traditional fishing tools. Forged with an incredibly sharp diamond blade, it offers unmatched &bdurability&r and precision, making it the ideal companion for processing the rarest fish and treasures found beneath the waves."
		""
		"&aEvery&r experienced angler knows that exceptional catches deserve exceptional tools. With the Diamond Fillet Knife in hand, you're prepared to make the most of &bevery&r expedition, from peaceful rivers to the &bdeepest&r oceans."
	]
	quest.45DF3A28B5316C54.quest_subtitle: "The finest blade for the finest catches"
	quest.45E388EE28BC67BC.quest_desc: ["&6The&r electric version of the Create Mechanical Pump: pumps fluids through pipes, powered by &belectricity&r instead of rotation."]
	quest.45E388EE28BC67BC.quest_subtitle: "An electric pump"
	quest.45E8E9DAD1628F87.quest_desc: [
		"&dVenomous&r Crusader Chestplate is the Crystal Chronicles upgraded version of Plagued Coat from Iron’s Spells ’n Spellbooks."
		""
		"It is &bupgraded&r using a Floralite Shard, transforming the original Plagued Armor into the powerful Venomous Crusader Armor set. The Floralite Shard infuses the armor with the &bpower&r of Nature magic, strengthening its poisonous and &bplague-based&r abilities."
	]
	quest.45E8E9DAD1628F87.quest_subtitle: "An enhanced form of Plagued Coat empowered by Floralite"
	quest.45F0CAADA098BBBF.quest_desc: ["&6Upgrade&r to the Mechanical Brass Extruder and unlock the &badvanced&r side of mechanical extrusion. &bUnlike&r the basic Andesite Extruder, the Brass Extruder can handle advanced recipes that may consume input blocks, opening the way to more powerful &bautomated&r resource production."]
	quest.45F0CAADA098BBBF.quest_subtitle: "Unlock advanced extrusion"
	quest.45FC8958716277F7.quest_subtitle: "More Armor"
	quest.45FFE05FDCE9280E.quest_subtitle: "Yummy!"
	quest.4603A9AE94ABD38F.quest_subtitle: "More Armor"
	quest.460CFDEE95AACA8A.quest_desc: [
		"&aCraft&r the Infusion Pedestal, the core block of Better End's Infusion Ritual system."
		""
		"Arranged in groups around a central pedestal, these are used to craft items like the &aEnchanted Membrane&r, Eternal Crystal, and Crystalite armor."
	]
	quest.460CFDEE95AACA8A.quest_subtitle: "The heart of every ritual"
	quest.461EE4C67668870F.quest_subtitle: "More Armor"
	quest.46369185A5712874.quest_subtitle: "More Armor"
	quest.46379D4450E3BA1D.quest_subtitle: "Yummy!"
	quest.4642FD4A9F6EDA40.quest_desc: [
		"&aCraft&r the Ironwood Leggings using &bIronwood&r Ingots infused with the ancient magic of the Twilight Forest. Designed to balance protection and mobility, these leggings allow adventurers to move freely while staying well-defended against the many dangers hidden within the &benchanted&r wilderness."
		""
		"&aAs&r a key part of the Ironwood Armor set, they &bstrengthen&r your overall defense and help you endure the increasingly dangerous encounters found &bdeeper&r in the Twilight Forest."
	]
	quest.4642FD4A9F6EDA40.quest_subtitle: "Balanced protection for the wild forest"
	quest.465834E4C5B52BD4.quest_desc: ["&6Craft&r the Haunted Whistle and add an eerie voice to your pipe organ. &bIt&r is one of the seven pipe types &bintroduced&r in Create: Sound of Steam 0.8.0, giving your organ a distinctly haunting character."]
	quest.465834E4C5B52BD4.quest_subtitle: "Let the organ speak from beyond"
	quest.466864328518872B.quest_desc: ["&aAttach&r the Starcatcher Bobber to your rod to mark your fishing spot and improve your catch chances."]
	quest.466864328518872B.quest_subtitle: "Craft the bobber for your rod"
	quest.466864328518872B.title: "Starcatcher Bobber"
	quest.466C0D65B55765C6.quest_subtitle: "Upgrade+"
	quest.466FA806237D45DD.quest_desc: ["&6A&r vacuum tube for electronic circuits."]
	quest.466FA806237D45DD.quest_subtitle: "A barretter tube"
	quest.4684CE598586717F.quest_desc: ["&aThe&r Cooking Pot is an essential cooking tool from Farmer's Delight. It allows you to combine different ingredients and prepare a wide &bvariety&r of meals, making it a key part of your kitchen and food production."]
	quest.4684CE598586717F.quest_subtitle: "A versatile pot for preparing delicious dishes"
	quest.469476DDCF3FED28.quest_desc: [
		"The Mechanical Crossbow is an &aadvanced&r ranged weapon from Eternal Starlight, crafted &busing&r refined dimensional materials and construct-based engineering."
		""
		"It &aoffers&r a stronger alternative to standard ranged combat, rewarding players who have &bprogressed&r through the mod’s material and boss systems."
	]
	quest.469476DDCF3FED28.quest_subtitle: "Precision through engineering"
	quest.469476DDCF3FED28.title: "&6Mechanical Crossbow"
	quest.469B64421439E360.quest_desc: [
		"&6An&r aircraft needs more than an engine to take to the skies. The Propeller transforms the engine's power into forward thrust, keeping your aircraft &bmoving&r through the air."
		""
		"Craft your first &bPropeller&r and give your aircraft the push it needs to fly."
	]
	quest.469B64421439E360.quest_subtitle: "The force that pushes your aircraft forward."
	quest.46A69BCFF6744616.quest_desc: [
		"The &aMason Table&r allows you to turn stone blocks into many decorative variants."
		"Use it to create detailed stone structures and improve your buildings."
	]
	quest.46A69BCFF6744616.quest_subtitle: "Shape the stone"
	quest.46AA5260745A949E.quest_desc: [
		"&6Combine&r the rugged look of Locometal with the distinctive shine of brass. Brass Wrapped Locometal is perfect for adding elegant industrial &bdetails&r to locomotives, train cars and railway structures."
		""
		"&bGive&r your train a refined metallic finish and let the brass stand out."
	]
	quest.46AA5260745A949E.quest_subtitle: "Industrial strength with a touch of brass."
	quest.46BB2F4549949A32.quest_subtitle: "More Weapon"
	quest.46CA848218860D6D.quest_desc: [
		"&dBattle-Evoker&r Helmet is the Crystal Chronicles upgraded version of Archevoker Hat from Iron’s Spells ’n Spellbooks."
		""
		"It is &bupgraded&r using an Avaricite Shard, transforming the original Archevoker Armor into the powerful Battle-Evoker Armor set. The Avaricite Shard infuses the helmet with additional Evocation magic, &bcreating&r a stronger &bcombat-focused&r version of the Archevoker gear."
	]
	quest.46CA848218860D6D.quest_subtitle: "An enhanced form of Archevoker Hat, empowered by Avaricite"
	quest.46D584103F33AE01.quest_subtitle: "Yummy!"
	quest.46DD248B39004FF0.quest_desc: [
		"&9&lFree&r&r yourself from the &bneed&r to stay close to your Refined Storage network. The Wireless Transmitter extends the range of wireless devices, &ballowing&r you to access your digital storage system from farther away."
		""
		"Connect it to your network and expand the area in which your wireless grids and other devices can &bcommunicate&r with the system."
	]
	quest.46DD248B39004FF0.quest_subtitle: "Bring your network within wireless range"
	quest.47083ED15C0F3DE5.quest_desc: ["&aObtain&r a Treasure Chest from Aquaculture 2. This &bfishing&r loot container can be found while fishing and contains valuable items. Open the chest to &bcollect&r the rewards hidden inside."]
	quest.47083ED15C0F3DE5.quest_subtitle: "A valuable find from the depths"
	quest.470D4D1A09C0C455.quest_subtitle: "More Armor"
	quest.47134CF6AC532845.title: "What Are You Doing!!!"
	quest.47177AEEFEB5BD97.quest_desc: [
		"&l&9The&r&r Limited Oak Barrel II offers an improved storage option for your growing collection. With more capacity than its previous tier, it gives you &badditional&r room while keeping the compact design of the barrel."
		""
		"&bUpgrade&r your storage setup further and prepare for even larger and more capable containers."
	]
	quest.47177AEEFEB5BD97.quest_subtitle: "More storage without sacrificing compactness"
	quest.47328555E8FB2605.quest_desc: ["&aWelcome&r to Farmer's Delight, a mod that expands Minecraft's farming and cooking experience. Grow new crops, gather fresh ingredients, prepare &bdelicious&r meals and use new cooking tools to create a wide variety of food. Build your own farm, improve your kitchen and discover &beverything&r this mod has to offer!"]
	quest.47328555E8FB2605.quest_subtitle: "Discover a new world of farming, cooking and delicious food!"
	quest.47328555E8FB2605.title: "&l&aWelcome Farmer's Delight"
	quest.4732EEBDEAA4EC0C.quest_subtitle: "Yummy!"
	quest.4736643A29E3B4E4.quest_desc: [
		"&aHidden&r deep beneath the ocean's &bsurface&r lies the Ocean Monument, a colossal structure built by an ancient civilization long forgotten. Guarded by the relentless Elder Guardians and countless Guardians, this &bunderwater&r fortress conceals valuable treasures and mysteries waiting to be uncovered."
		""
		"&aReaching&r the monument is only the beginning. &bNavigating&r its maze-like halls while battling the dangers of the deep will test both your courage and your preparation. Few adventurers dare to &bchallenge&r the rulers of the ocean."
	]
	quest.4736643A29E3B4E4.quest_subtitle: "An ancient fortress beneath the waves"
	quest.4736643A29E3B4E4.title: "&3Find an Ocean Monument"
	quest.47384BA676BD425F.quest_desc: [
		"&6Your&r trains can carry more than &bpassengers&r and cargo — they can carry their own fuel supply. The Portable Fuel Interface allows you to transfer liquid fuel directly to fuel tanks mounted on a moving train."
		""
		"&bConnect&r it to your fuel system and keep your locomotives running wherever the tracks may lead."
	]
	quest.47384BA676BD425F.quest_subtitle: "Bring fuel directly to your moving trains."
	quest.473B6BB78E58CBB5.quest_desc: ["&dBreezebreaker&r is a sharp, tall and slim sword &bdesigned&r for mobility and burst damage."]
	quest.473B6BB78E58CBB5.quest_subtitle: "Blade of the Wind"
	quest.473B6BB78E58CBB5.title: "&l&fBreezebreaker"
	quest.476132B037ACA341.quest_desc: [
		"&dAvaricite&r Shard is a rare upgrade material from Crystal Chronicles. It is used to upgrade the Archevoker Armor from Iron’s Spells ’n Spellbooks into the powerful &bBattle-Evoker&r Armor set."
		""
		"The shard infuses the &boriginal&r Archevoker equipment with enhanced Evocation magic, &btransforming&r it into a stronger, combat-focused form. It is also &bassociated&r with the creation of Evoker's Twinblade."
	]
	quest.476132B037ACA341.quest_subtitle: "A powerful crystal shard used to enhance Archevoker equipment"
	quest.4779CB63122DE3F7.quest_subtitle: "More Armor"
	quest.477A3F928303BA4F.quest_desc: [
		"&aCombine&r Netherite Scrap with Gold Ingots to create a Netherite Ingot."
		"This powerful material is &bused&r to upgrade your strongest gear."
	]
	quest.477A3F928303BA4F.quest_subtitle: "The strongest material"
	quest.477A3F928303BA4F.title: "&6Netherite Ingot"
	quest.4789F9858918B0D7.quest_desc: ["&6The&r Bucket of Experience contains Liquid Experience from Create: Enchantment Industry. It allows experience to be stored and transported as a fluid, making it &buseful&r for feeding experience into machines such as the Blaze Forger and other &bexperience-processing&r equipment. The mod &bspecifically&r supports using the Experience Bucket with automated systems."]
	quest.4789F9858918B0D7.quest_subtitle: "Store experience in liquid form"
	quest.47A394FD8E54F490.quest_desc: ["&6Craft&r the Honey Spout Gun and &buse&r honey as your ammunition. Fill the gun with honey using a Spout, then fire honey &bprojectiles&r at your targets. The honey variant is one of the specialized Spout Guns &bavailable&r in Create: Misc \\& Things."]
	quest.47A394FD8E54F490.quest_subtitle: "Make your enemies stick around"
	quest.47ACEEFFEB611799.quest_desc: ["&6Obtain&r the Chorium Ingot, a special material added by Create: Encased. This unusual ingot is used in advanced recipes and machinery, making it an important resource for progressing through the mod's &bhigher-tier&r technology."]
	quest.47ACEEFFEB611799.quest_subtitle: "Forge the strange metal"
	quest.47AF5FEF0643AA7E.quest_desc: ["&6Craft&r the Hypertube Accelerator and increase the &bspeed&r of entities travelling through your Hypertube network. Place it along the tube system to give travellers an extra boost and make &blong-distance&r transportation even faster. The block is an actual part of Create: Hypertubes; the mod's changelog specifically &breferences&r fixes for the Accelerator block."]
	quest.47AF5FEF0643AA7E.quest_subtitle: "Push your transport to the limit"
	quest.47BADA4235535429.quest_desc: ["&eIt's&r time to increase your firepower! The Automatic Crossbow is a mechanical crossbow equipped with a &brotating&r barrel that automatically reloads arrows. With twice the reloading speed, you can unleash a rapid &bbarrage&r of projectiles and gain the upper hand in combat. Prepare your &bammunition&r and put this remarkable weapon to the test!"]
	quest.47BADA4235535429.quest_subtitle: "Rapid-Fire Mechanical Weapon"
	quest.47C268D0D0265CB4.quest_desc: [
		"&aComplete&r your Steeleaf tool collection by crafting the Steeleaf Hoe and Steeleaf Shovel. Forged from the enchanted Steeleaf material, these tools combine the resilience of steel with the magic of the Twilight Forest, making everyday &btasks&r faster and more efficient."
		""
		"&aWhether&r preparing farmland for crops or clearing paths through dirt and gravel, these tools will serve as reliable &bcompanions&r throughout your adventure."
	]
	quest.47C268D0D0265CB4.quest_subtitle: "Tools for cultivation and excavation"
	quest.47C268D0D0265CB4.title: "Steeleaf Farming Tools"
	quest.47CE8704CD58F8FF.quest_subtitle: "More Armor"
	quest.47D18D97CE66089B.quest_desc: [
		"&6Built&r for a locomotive that means business. The Iron Wrapped Locometal Boiler combines the rugged appearance of Locometal with a sturdy &biron-wrapped&r design, making it a perfect centerpiece for a heavy industrial steam locomotive."
		""
		"&bBuild&r the boiler, assemble your locomotive and put some serious steam power on the rails."
	]
	quest.47D18D97CE66089B.quest_subtitle: "Rugged ironwork for a powerful steam locomotive."
	quest.47D72FA088721244.quest_desc: [
		"&dThe&r Enchanted Spell Book is the diamond-tier spellbook of Iron's Spells 'n Spellbooks. It provides &b10&r spell slots and grants &b+100&r Max Mana when equipped, giving you more room for powerful magic and a larger mana pool."
		""
		"&bUpgrade&r from the Apprentice's Spell Book and prepare yourself for even greater magical power."
	]
	quest.47D72FA088721244.quest_subtitle: "Harness the power of enchanted knowledge"
	quest.47E301B12F8E97C0.quest_desc: ["&6The&r Brass Rod and Electrum Rod are metal components used in the crafting of advanced equipment and electrical &bcomponents&r in Create Crafts \\& Additions. Add both rods to your collection and prepare the &bmaterials&r needed for more &badvanced&r electrical engineering. Electrum Rods are &bpart&r of the mod's electrical component progression."]
	quest.47E301B12F8E97C0.quest_subtitle: "Prepare the metals for advanced engineering"
	quest.47E7E7128951C073.quest_subtitle: "Yummy!"
	quest.47EED74B95063F61.quest_desc: ["&dA&r powerful set of wings that grants the wearer the &bability&r to fly."]
	quest.47EED74B95063F61.quest_subtitle: "Majestic wings of divine power"
	quest.47F5CD437391B607.quest_desc: ["&6Obtain&r an Extendo Grip from Create. This powerful tool greatly &bincreases&r your block interaction and reach distance, making it easier to place, break, and interact with blocks from farther away. It can also be used in the off-hand alongside another tool, and &busing&r Extendo Grips in both hands extends the reach even further. When you wear a Copper or Netherite Backtank with pressurized air, its uses &bconsume&r the tank's air instead of the Grip's durability."]
	quest.47F5CD437391B607.quest_subtitle: "Reach beyond your limits"
	quest.4810A2E81F1B3318.quest_desc: [
		"Emeralds represent &bknowledge&r and &bvalue&r."
		"&aCombined &rwith Netherite, they create a helmet that stands out with both power and prestige."
	]
	quest.4810A2E81F1B3318.quest_subtitle: "Wisdom and wealth"
	quest.4810A2E81F1B3318.title: "Emerald Netherite Helmet"
	quest.4836CFA7D5E47849.quest_desc: [
		"The Amaramber Axe is a &awoodcutting&r tool from Eternal Starlight &bintroduced&r in version 0.4.2 as part of the Amaramber equipment set."
		""
		"&aIt&r is &bused&r for gathering wood from Torreya trees and serves as a basic &bprogression&r tool in the Starlight dimension."
	]
	quest.4836CFA7D5E47849.quest_subtitle: "Amber woodcutting tool"
	quest.483C2BFD70CED49A.quest_desc: [
		"The Deepsilver Sickle is a &aharvesting&r tool from Eternal Starlight crafted &busing&r Deepsilver Ingots."
		""
		"&aIt&r is &bused&r for efficiently gathering plants and vegetation in swamp and Nightfall regions, serving as an early-mid &bprogression&r tool in the Deepsilver set."
	]
	quest.483C2BFD70CED49A.quest_subtitle: "Swamp harvesting tool"
	quest.484C148B135F2DC6.quest_subtitle: "More Armor"
	quest.484C2F55E67F3802.quest_subtitle: "More Armor"
	quest.485AF245607835C0.quest_desc: [
		"The Deepsilver Shovel is a &adigging&r tool from Eternal Starlight crafted &busing&r Deepsilver Ingots."
		""
		"&aIt&r is used for excavation in swamp and Nightfall regions, offering higher durability than iron-tier tools while &bremaining&r part of early-mid progression."
	]
	quest.485AF245607835C0.quest_subtitle: "Swamp digging tool"
	quest.486E0292995D0A16.quest_desc: [
		"&dCultist&r Boots are part of the Cultist Armor set in Iron's Spells 'n Spellbooks. When worn, they provide &b+3&r Armor, &b+125&r Max Mana, &b+10%&r Blood Spell Power and &b+5%&r Spell Power."
		""
		"They can be &bcrafted&r from 4 Arcane Cloth and 1 Blood Rune, or upgraded from Wizard Boots with 1 Blood Rune at a Smithing Table in supported versions."
	]
	quest.486E0292995D0A16.quest_subtitle: "Walk the path of Blood magic"
	quest.4870F1D895BF5B67.quest_desc: ["&aDefeat&r 3 Deeplings from the Cataclysm mod. These hostile aquatic creatures can be found in underwater &bstructures&r and deep ocean areas. They are &bpart&r of the dangerous inhabitants of the ocean depths."]
	quest.4870F1D895BF5B67.quest_subtitle: "Defeat the creatures of the deep"
	quest.4870F1D895BF5B67.title: "Kill Deepling"
	quest.48889D7AC8BBD356.quest_desc: ["&6Build&r the Basic Energiser, Advanced Energiser, and Reinforced Energiser to &bprogress&r through the electrical &btechnology&r of Create: New Age. Each tier provides a stronger and more advanced way to use electricity in your factory. &bUpgrade&r your Energisers as your power &binfrastructure&r grows."]
	quest.48889D7AC8BBD356.quest_subtitle: "Charge up your production"
	quest.48889D7AC8BBD356.title: "Energiser Progression"
	quest.48A56DDDA5DA4979.quest_desc: ["&6Electron&r Tubes are advanced crafting components used to &bunlock&r many of Create's more complex machines and automation blocks. They are crafted from Polished Rose Quartz and an Iron Sheet. Electron Tubes are used in recipes for components such as the Deployer, Mechanical Crafter, Mechanical Roller, Sequenced Gearshift, Smart Chute, Smart Fluid Pipe, Nixie Tube and more. They &bdon't&r have a function on their own, but are an important step toward &badvanced&r Create automation."]
	quest.48A56DDDA5DA4979.quest_subtitle: "The key to advanced automation"
	quest.48A87C1B6721A46A.quest_desc: ["&eA&r Game Disc featuring TNT Swapper, a fast-paced game where you must &breact&r quickly and swap TNT to avoid &bgetting&r caught in the explosions. Test your reflexes and try to achieve the highest score."]
	quest.48A87C1B6721A46A.quest_subtitle: "Swap the TNT and survive the explosion!"
	quest.48B0380E8AFB165A.quest_desc: [
		"&aThe Grindstone&r is a simple yet powerful tool to repair and clean your weapons. Use it to remove enchantments or restore your gear’s sharpness."
		""
		"Collect it and put your combat skills to the test! Make sure your weapons are ready for any &bchallenge&r ahead."
	]
	quest.48B0380E8AFB165A.quest_subtitle: "Mastering the Grind"
	quest.48B0380E8AFB165A.title: "Sharpen Your Skills"
	quest.48CF25B2EA87230B.quest_desc: [
		"&aDeep&r within the dimension of Eternal Starlight, the Crystallized Desert stretches endlessly, its sands and terrain &binfused&r with shimmering &bcrystal&r energy."
		"The environment is harsh and unstable, but rich in rare crystalline resources and &bhidden&r dangers."
		""
		"&aExploring&r this biome is essential for advancing into higher-tier crafting and uncovering the secrets of starlight materials."
	]
	quest.48CF25B2EA87230B.quest_subtitle: "Glass of the stars"
	quest.48CF25B2EA87230B.title: "&5Crystallized Desert"
	quest.48D914252224225C.quest_desc: ["&6Obtain&r an Item Drain from Create. It is used to collect fluids from items such as buckets and bottles, making it useful for &bautomated&r fluid processing. Item Drains can also receive fluids from &bprocessing&r setups such as Basins and Crushing Wheels."]
	quest.48D914252224225C.quest_subtitle: "Collect what your machines leave behind"
	quest.48FEA157EC48231C.quest_desc: ["&aCraft&r a Neptunium Hoe from Aquaculture 2. This tool is made from Neptunium, a &brare material&r obtained from fishing treasures. It offers high &bdurability&r and &bcompletes&r the Neptunium tool set."]
	quest.48FEA157EC48231C.quest_subtitle: "A rare tool from ocean treasures"
	quest.4906468642C87C12.quest_subtitle: "More Weapon"
	quest.491DA89E2EE814B7.quest_desc: [
		"&aExploring the world&r can sometimes make it hard to find the biome you are looking for."
		"The Nature’s Compass helps you locate any biome in the world."
		""
		"Use it to search for rare environments, special resources, or new places to explore."
	]
	quest.491DA89E2EE814B7.quest_subtitle: "Find Any Biome"
	quest.491EA7E5B2C9DDAA.quest_subtitle: "Upgrade+"
	quest.493A5EACADDD3B6C.quest_desc: ["&eA&r Game Disc that lets you play Slime on the Game Console. Control your long slimy body, eat apples to &bincrease&r your score and avoid crashing into yourself. The disc can be &bobtained&r when a slime is killed by a skeleton."]
	quest.493A5EACADDD3B6C.quest_subtitle: "Control your slime and eat the apples!"
	quest.493BB012638A87A8.quest_desc: ["&6Craft&r a Depot from Create. &bIt&r acts as a stationary item-processing platform, allowing items to be placed on it and &binteracted&r with by machines such as the Mechanical Press and Mechanical Arm. &bItems&r placed on a Depot remain there until extracted by a player or another machine."]
	quest.493BB012638A87A8.quest_subtitle: "A platform for mechanical processing"
	quest.494086F68261B13C.quest_desc: ["&6Obtain&r a Train Observer from Create. &bIt&r detects when a train passes over its assigned &bsection&r of track and outputs a Redstone signal while the train is within its detection range. It can be used for railway crossings, alarms, doors, lights, and other &bautomated&r railway systems."]
	quest.494086F68261B13C.quest_subtitle: "Keep an eye on passing trains"
	quest.496205C04458BA6C.quest_subtitle: "Upgrade+"
	quest.49ADC9F715973002.quest_desc: [
		"&aCraft&r the Fiery Chestplate using Fiery Ingots forged from the Hydra's blazing essence. Infused with intense heat and &bancient&r magic, this armor offers exceptional protection while radiating the power of the &blegendary&r beast that once ruled the Fire Swamp."
		""
		"&aAs&r the centerpiece of the Fiery Armor set, the chestplate provides &bunmatched&r durability and symbolizes your triumph over one of the Twilight Forest's most fearsome bosses. With its burning strength at your side, few &benemies&r will dare stand in your way."
	]
	quest.49ADC9F715973002.quest_subtitle: "Wear the heart of the Hydra"
	quest.49BEE3A8084C246B.quest_desc: ["&6A&r special bulb that speeds up crop growth in an area when powered. Mount it above your field and wire it up."]
	quest.49BEE3A8084C246B.quest_subtitle: "Speeds up crops"
	quest.49C08FD7E6A4C52C.quest_desc: ["&aCraft&r a Black Steel Axe from the Cataclysm mod. This &bdurable&r tool is made using Black Steel and provides high &befficiency&r for chopping wood. It is part of the Black Steel &bequipment&r set."]
	quest.49C08FD7E6A4C52C.quest_subtitle: "A powerful tool forged from black steel"
	quest.49C486B2FF808B11.quest_desc: ["&6Limestone&r is a new resource from Create: Aquatic Ambitions. It can be processed using Conduit Channeling to obtain Nautilus Shells, providing a &brenewable&r way to acquire this otherwise &buncommon&r ocean treasure. It is also part of the mod's expanded aquatic resource progression."]
	quest.49C486B2FF808B11.quest_subtitle: "A stone with secrets from the deep"
	quest.49DB50F19942B35D.quest_desc: ["&aDefeat&r 3 Deepling Brutes from the Cataclysm mod. These powerful melee enemies are stronger &bvariants&r of Deeplings and can be found in Deepling underwater &bstructures&r and deep ocean areas."]
	quest.49DB50F19942B35D.quest_subtitle: "Defeat the strongest Deepling warriors"
	quest.49DB50F19942B35D.title: "Kill Deepling Brute"
	quest.49E14A4712AA4F09.quest_desc: ["&6Craft&r a Chocolate Glazed Marshmallow by coating a soft, fluffy marshmallow with chocolate. It is a sweet combination of a light marshmallow center and a rich chocolate coating, perfect for your Create: Confectionery collection. &bChocolate-coated&r marshmallows are a classic confection with many variations."]
	quest.49E14A4712AA4F09.quest_subtitle: "A fluffy treat covered in rich chocolate"
	quest.49E4501E720A0B70.quest_subtitle: "More Armor"
	quest.49E68A5767EA34D5.quest_desc: [
		"&9&lTake&r&r your Refined Storage network to the next level with the &b1k&r Storage Disk. This disk provides digital storage for up to 1,000 different item types, giving your &bnetwork&r a compact and efficient way to &bmanage&r your resources."
		""
		"Insert it into a Disk Drive and start filling your digital storage network with everything you collect."
	]
	quest.49E68A5767EA34D5.quest_subtitle: "Store your first thousand types of items"
	quest.49FE9EA0F48BF36D.quest_desc: ["&6Obtain&r a Netherite Diving Helmet from Create. It is the &bupgraded&r version of the Diving Helmet, providing underwater breathing when used with a Backtank and improved visibility while underwater. As a &bnetherite-tier&r item, it also has the durability and fire/lava resistance &bassociated&r with netherite equipment. The Netherite Diving Helmet was introduced in Create 0.5.1."]
	quest.49FE9EA0F48BF36D.quest_subtitle: "Descend where others cannot"
	quest.4A106AFA1714BD05.quest_desc: [
		"&dThe&r Ruined Book is an Epic magical item found within &bsculk-infested&r Ancient Cities. This &bmysterious&r tome is an important crafting component for powerful spellbooks, making it a valuable discovery for any aspiring spellcaster."
		""
		"&bSearch&r the ancient ruins, recover this forgotten knowledge and &buse&r it to advance your magical progression."
	]
	quest.4A106AFA1714BD05.quest_subtitle: "Recover forgotten knowledge from the ancient cities"
	quest.4A172CC6B6D3CEA6.quest_subtitle: "More Weapon"
	quest.4A20F570984048DC.quest_desc: [
		"&dBlank&r Runestone is the base material &bused&r to create the different school-specific runes in Iron's Spells 'n Spellbooks. It can be &bfound&r rarely in vanilla structures and more commonly in magical structures."
		""
		"&bUse&r 8 magical focuses to transform a Blank Runestone into a rune for a specific school of magic."
	]
	quest.4A20F570984048DC.quest_subtitle: "The foundation of every magical rune"
	quest.4A29CFB3B64223A9.quest_desc: ["&6A&r decorative ceiling block. You can add certain blocks to it to expand its functionality."]
	quest.4A29CFB3B64223A9.quest_subtitle: "A stylish ceiling"
	quest.4A2FF89D06467FF8.quest_desc: ["&6The&r Heat Pipe is a key component of the thermal system in Create: New Age. It allows heat to be transferred between machines and components, &bmaking&r it possible to build larger and more efficient &bheat-based&r setups. Use Heat Pipes to connect your heat sources with the machinery that &bneeds&r their power."]
	quest.4A2FF89D06467FF8.quest_subtitle: "Move heat where it matters"
	quest.4A3907C2223E07C1.quest_desc: ["&6The&r Rolling Mill is a kinetic machine from Create Crafts \\& Additions used to process metal into Rods and Wires. It is an important step in the mod's &belectrical&r progression, allowing you to prepare &bmaterials&r such as Copper, Iron, Gold, Brass and Electrum for electrical components. Power it with Create's rotational force and &bstart&r producing the components needed for your electrical network."]
	quest.4A3907C2223E07C1.quest_subtitle: "Roll metal into useful components"
	quest.4A49086B89A98BA7.quest_desc: ["&6Welcome&r to Create: Aquatic Ambitions! This addon expands Create with &baquatic-themed&r machines, processes and &bproduction&r chains. Harness the power of Conduits to automate Prismarine, Coral and Copper, revive Coral, produce renewable &bresources&r and discover new ways to bring the &btreasures&r of the ocean into your factory."]
	quest.4A49086B89A98BA7.quest_subtitle: "           Dive into a new world of automation      "
	quest.4A49086B89A98BA7.title: "&l&6Welcome Create Aquatic Ambitions"
	quest.4A57F38EC26647B5.quest_desc: [
		"&dShadow-Walker&r Boots are part of the Shadow-Walker Armor set in Iron's Spells 'n Spellbooks. When worn, they provide &b+3&r Armor, &b+125&r Max Mana, &b+10%&r Ender Spell Power and &b+5%&r Spell Power."
		""
		"They can be &bcrafted&r from 4 Arcane Cloth and 1 Ender Rune, or upgraded from Wizard Boots with 1 Ender Rune at a Smithing Table in supported versions."
	]
	quest.4A57F38EC26647B5.quest_subtitle: "Walk between worlds with the power of Ender magic"
	quest.4A57F57C824016CB.quest_desc: [
		"&aCraft&r a Note Hook, a unique fishing upgrade that blends &bcreativity&r with the art of angling. &bInspired&r by the sounds of music and the mysteries of the ocean, this &bunusual&r hook brings a touch of harmony to your fishing adventures."
		""
		"&aThe&r greatest explorers &bunderstand&r that every journey has its own rhythm. With the Note Hook, you continue expanding your collection of specialized &bfishing&r tools while uncovering the hidden wonders of the waters."
	]
	quest.4A57F57C824016CB.quest_subtitle: "A melody beneath the waves"
	quest.4A6C2910F457E665.quest_subtitle: "More Armor"
	quest.4A75D2C036284DCB.quest_desc: ["&6Stores&r a small amount of &belectricity&r. You place it in electronic circuits on a board."]
	quest.4A75D2C036284DCB.quest_subtitle: "A capacitor"
	quest.4AAFEDBF0AB83B90.quest_desc: [
		"&aThe&r Starfire Axe is a weapon from Eternal Starlight, &bbelonging&r to the Starfire equipment tier."
		""
		"&aIt&r is part of the mod’s advanced progression system and is crafted using Starfire &bmaterials&r introduced in late-game content."
	]
	quest.4AAFEDBF0AB83B90.quest_subtitle: "Starlight forged weapon"
	quest.4AB1DD95EB928F87.quest_desc: ["&6Create&r Champagne as a sparkling addition to your winery. Use the Wine Cellar and Create's machinery to process the necessary &bingredients&r and produce another refined beverage for your collection. Create: Winery adds wine-themed recipes and a fully automatable Wine Cellar for &bproducing&r wines and ciders."]
	quest.4AB1DD95EB928F87.quest_subtitle: "Celebrate the fruits of your winery"
	quest.4ABE2718DCC5D7EB.quest_desc: [
		"&dMana&r Upgrade Orb is an upgrade material in Iron's Spells 'n Spellbooks. When applied at the Arcane Anvil, it grants &b+50&r Max Mana."
		""
		"It can be &bapplied&r to compatible equipment, allowing you to significantly increase your maximum mana. By default, an applicable piece of &bequipment&r can receive up to 3 upgrades."
	]
	quest.4ABE2718DCC5D7EB.quest_subtitle: "Expand your mana pool beyond its limits"
	quest.4AE697EE6FBF5960.quest_desc: [
		"&eWhy&r walk around picking up every item when you can make them come to you?"
		""
		"The Universal Attractor pulls nearby dropped items toward you, &bmaking&r it much easier to collect loot, &bresources&r and anything else scattered across the ground."
		""
		"Let the world bring its &btreasures&r to you."
	]
	quest.4AE697EE6FBF5960.quest_subtitle: "Nothing stays out of reach"
	quest.4B01BC3CE092F66E.quest_subtitle: "More Armor"
	quest.4B1A61026D1EE612.title: "okey"
	quest.4B26401BFE038111.quest_desc: ["&6Welcome&r to Create: Enchantment Industry! This addon expands Create with new ways to handle experience and enchantments. &bStore&r and transport Liquid Experience, automate enchanting and disenchanting, repair Mending gear, and build &bmachines&r that bring the power of &benchantments&r into your factory."]
	quest.4B26401BFE038111.quest_subtitle: "         Bring enchantments into your factory              "
	quest.4B26401BFE038111.title: "&6&lWelcome Create Enchantment Industry"
	quest.4B35FBD711F6FCC5.quest_desc: [
		"&aThe&r Glacite Boots are cold-resistant footwear from Eternal Starlight crafted &busing&r Glacite materials."
		""
		"Glacite armor slows attacking &aenemies&r with icy effects and improves survival &bin&r freezing environments."
	]
	quest.4B35FBD711F6FCC5.quest_subtitle: "Frozen protective footwear"
	quest.4B4FC2AA2A20E7E3.quest_desc: [
		"The Terminite Anvil is used together with a Smith Hammer to shape Terminite Ingots into &aForged Plates&r and tool heads."
		""
		"It allows access to Terminite's improved &btools&r and armor."
	]
	quest.4B4FC2AA2A20E7E3.quest_subtitle: "Working the second tier of metal"
	quest.4B5A6B66CBDFA9E6.quest_desc: [
		"&aThe Multimeter&r is used in many crafting recipes for decorative workstations from Chipped."
		"These stations allow you to transform ordinary blocks into many decorative variants."
	]
	quest.4B5A6B66CBDFA9E6.quest_subtitle: "A tool for crafting stations"
	quest.4B5FB73C4D1282A6.quest_desc: [
		"The Thallasium Leggings are crafted from Thallasium Plating at a Smithing Table."
		""
		"They provide the entry-level protection of Better End's &aarmor&r line."
	]
	quest.4B5FB73C4D1282A6.quest_subtitle: "Leggings of the first tier"
	quest.4B77EA20C31AD953.quest_desc: ["&6Obtain&r a Turntable from Create. When powered with &brotational&r force, it rotates entities standing on top of it, including players and armor stands. It is crafted &busing&r a Shaft and a Wooden Slab."]
	quest.4B77EA20C31AD953.quest_subtitle: "Spin your creations into motion"
	quest.4BA6F9A3E87FDC34.quest_subtitle: "Upgrade+"
	quest.4BAB09ECE6C2C644.quest_desc: ["&6A&r complex device that needs some setup: provide 12 V between the Heater and Cathode pins and about 1000 V between the Anode and Cathode. Move the dot with the deflection coils and change the trace brightness with a negative Grid &bvoltage&r."]
	quest.4BAB09ECE6C2C644.quest_subtitle: "A cathode ray tube"
	quest.4BC1D4BCEDD0A03A.quest_desc: ["&aObtain&r The Annihilator from the Cataclysm mod. This powerful end-game weapon can be upgraded &busing&r the Mechanical &bFusion&r Anvil and is part of the &bstrongest&r arsenal available in the mod."]
	quest.4BC1D4BCEDD0A03A.quest_subtitle: "A devastating weapon of destruction"
	quest.4BC1D4BCEDD0A03A.title: "&bThe Annhilator"
	quest.4BC56D1B40AB327B.quest_subtitle: "More Weapon"
	quest.4BCF7A1B36B2B345.quest_desc: ["&eWelcome&r to the world of Clockwork! &bGet&r ready to discover extraordinary inventions, mechanical gadgets, and &badvanced&r technology. &bFrom&r the automatic crossbow to mechanical wings, there are plenty of possibilities waiting for you. Explore the available devices and discover how to &buse&r them on your adventure!"]
	quest.4BCF7A1B36B2B345.quest_subtitle: "Mechanics, Inventions, and New Possibilities"
	quest.4BCF7A1B36B2B345.title: "&l&fWelcome &eClockwork"
	quest.4BD01B57E5E269DE.quest_subtitle: "More Weapon"
	quest.4BDBD1D7C39E0037.quest_desc: [
		"&dPyromancer&r Helmet is the Crystal Chronicles upgraded version of the Pyromancer Helmet from Iron’s Spells ’n Spellbooks."
		""
		"It is upgraded using a Volcanite Shard, which &benhances&r the original Pyromancer Armor with &badditional&r crystalline power. Volcanite Shards are used to &bupgrade&r the Iron’s Spells ’n Spellbooks Pyromancer Armor set into its enhanced Crystal Chronicles version."
	]
	quest.4BDBD1D7C39E0037.quest_subtitle: "An enhanced Pyromancer helmet empowered by Volcanite"
	quest.4BE07CB092BABFF0.quest_subtitle: "Upgrade+"
	quest.4BE67B84445A1AB2.quest_desc: [
		"The Amaramber Shovel is a &adigging&r tool from Eternal Starlight introduced in version 0.4.2 as &bpart&r of the Amaramber equipment set."
		""
		"&aIt&r is &bused&r for excavating terrain and gathering soft blocks in the Starlight dimension."
	]
	quest.4BE67B84445A1AB2.quest_subtitle: "Amber digging tool"
	quest.4BE9919FC2DABEFA.title: "&l&dLunar Monstrosity"
	quest.4BF14CA9D2296730.quest_desc: [
		"&dHarness&r the power of mana with the Ring of Mana. This magical accessory helps support your spellcasting by providing additional &bmana-related&r benefits, making it a valuable piece of equipment for any aspiring mage."
		""
		"&bEquip&r the ring and strengthen your connection to the arcane arts as you continue mastering powerful spells."
	]
	quest.4BF14CA9D2296730.quest_subtitle: "Carry the power of mana wherever you go"
	quest.4C185288A6D081F5.quest_desc: [
		"This helmet &acombines&r Netherite durability with the reliability of iron."
		"It &aoffers&r solid protection while allowing you to stay focused during long battles and &bexploration&r."
	]
	quest.4C185288A6D081F5.quest_subtitle: "Clear vision, strong defense"
	quest.4C185288A6D081F5.title: "Iron Netherite Helmet"
	quest.4C3650C5A427761F.quest_desc: ["&6Craft&r the Viola pipe and expand your pipe organ with a distinctive &bstring-like&r voice. Viola was &bintroduced&r in Create: Sound of Steam 0.8.0 as one of seven new pipe types."]
	quest.4C3650C5A427761F.quest_subtitle: "Add a warm string-like voice"
	quest.4C3CFFC7F0F022AC.quest_subtitle: "More Weapon"
	quest.4C401993C8B782AA.quest_desc: ["&aObtain&r the Monstrous Flamberge from the Cataclysm: Spellbooks addon. This &blegendary&r greatsword channels overwhelming monstrous power and grants its wielder access to the &bunique&r Tectonic Tremble spell, &bdevastating&r anything that stands in its path. It is one of the signature magical &bweapons&r of the addon."]
	quest.4C401993C8B782AA.quest_subtitle: "Wield the blade of monstrous fury"
	quest.4C401993C8B782AA.title: "&cMonstrous Flamberge"
	quest.4C526EBA57193B1C.quest_subtitle: "More Armor"
	quest.4C59B91129B05AE5.quest_desc: [
		"&aGlass Bottles&r are essential for brewing potions."
		"They are used to collect water and serve as the base container for almost every potion in the game."
		"Without them, alchemy cannot begin, making them one of the first required items for brewing &bprogress&r."
	]
	quest.4C59B91129B05AE5.quest_subtitle: "Container for potions"
	quest.4C9297B792670B80.quest_desc: ["&6A&r motor with a speed controller: it spins at a constant speed, and the supplied &bvoltage&r sets the stress capacity and rotation direction."]
	quest.4C9297B792670B80.quest_subtitle: "A regulated motor"
	quest.4CB6A063431A3E1B.quest_desc: ["&dThe&r Clockwork Rifle is the most advanced gun in the mod, built from Clockwork Components and &bnetherite&r. Obtaining one earns the Tick-Tock advancement."]
	quest.4CB6A063431A3E1B.quest_subtitle: "Precision engineering"
	quest.4CBAA74AE9696366.quest_desc: ["&6Obtain&r a Mechanical Bearing, Windmill Bearing, and Clockwork Bearing from Create. These three bearings are specialized movement anchors &bused&r to create rotating Contraptions. The Mechanical Bearing rotates &battached&r structures using rotational power, the Windmill Bearing turns attached sails or sail-like blocks into a windmill that generates rotational power, and the Clockwork Bearing &brotates&r structures according to the in-game time, allowing you to build working clock hands."]
	quest.4CBAA74AE9696366.quest_subtitle: "Master the art of rotation"
	quest.4CC1743355211846.quest_subtitle: "More Weapon"
	quest.4CCEA5C17095D575.quest_desc: [
		"&dArcane&r Essence is the most common and one of the most important magical materials in Iron's Spells 'n Spellbooks. It can be found in vanilla and magical structures and is also &bobtained&r from magical enemies."
		""
		"Use Arcane Essence in a wide variety of crafting recipes, including the &bcreation&r of Arcane Cloth and Arcane Ingots. Gather plenty of it as you progress, because it becomes one of the most frequently &bneeded&r materials in magical crafting."
	]
	quest.4CCEA5C17095D575.quest_subtitle: "The foundation of magical craftsmanship"
	quest.4CDBE61718E72389.quest_desc: ["&6Craft&r the White Chocolate Bucket and store liquid White Chocolate for your confectionery factory. Use it to &btransport&r and handle white chocolate as part of your automated production lines in Create: Confectionery, which adds white, black, and ruby chocolate alongside other confectionery ingredients."]
	quest.4CDBE61718E72389.quest_subtitle: "Carry creamy sweetness wherever you go"
	quest.4CE33FC72CAC65CF.quest_desc: [
		"&aCraft&r the Arctic Hood using soft Arctic Fur gathered from the frozen wilderness of the Twilight Forest. &bCarefully&r tailored to provide warmth without restricting vision, this hood protects its wearer from biting winds and &brelentless&r snowfall."
		""
		"&aAs&r part of the Arctic Armor set, the Arctic Hood is &bdesigned&r for adventurers who venture into the &bcoldest&r regions of the Twilight Forest. Its enchanted fur traps heat while remaining lightweight, making it an ideal &bcompanion&r for long expeditions across the Glacier."
	]
	quest.4CE33FC72CAC65CF.quest_subtitle: "Shield yourself from the frozen winds"
	quest.4CE6AC5970FB638E.quest_desc: [
		"&6A&r standard propeller gets the job done, but there's always room for improvement. Reinforced with copper, the Enhanced Propeller &bdrastically&r reduces air resistance, allowing your aircraft to maintain its momentum more efficiently."
		""
		"&bUpgrade&r your propeller and cut through the air with ease."
	]
	quest.4CE6AC5970FB638E.quest_subtitle: "Less drag, more speed."
	quest.4CEB97C524D1D45C.quest_desc: ["&6The&r Mechanical Harvester is a Contraption component designed for &bautomated&r farming. When a moving Contraption passes over crops, the Harvester collects fully grown crops and their drops without &bdestroying&r the farmland. It can also harvest certain plant types such as sugar cane and other blocks registered as harvestable by Create. Use several Harvesters together on a moving farm to automate &blarge-scale&r crop production."]
	quest.4CEB97C524D1D45C.quest_subtitle: "Let the machine do the harvesting"
	quest.4CEFEE233D1B722D.quest_desc: [
		"&aThe&r Deepsilver Helmet is an armor piece from Eternal Starlight crafted &busing&r Deepsilver Ingots."
		""
		"Deepsilver armor increases &amovement&r speed, attack speed, and knockback resistance. Wearing the full set also grants immunity to several negative &bstatus&r effects."
	]
	quest.4CEFEE233D1B722D.quest_subtitle: "Swift silver headgear"
	quest.4CF55AADAB2218B8.quest_desc: [
		"&aDiscover&r the Amber Land — an orange-hued forest of tall, annular Helix trees and glowing high-leaf plants such as &bLanceleaf&r and Amber Root."
		""
		"It's the &bonly biome&r where Amber Ore naturally spawns, making it essential for gathering Amber Gems."
	]
	quest.4CF55AADAB2218B8.quest_subtitle: "Forest of twisting Helix trees"
	quest.4CF55AADAB2218B8.title: "Amber Land"
	quest.4CFCCBE2309E8EC2.quest_subtitle: "More Armor"
	quest.4D032F927E1EEA92.quest_desc: ["&6Contraption&r Controls let you &benable&r or &bdisable&r specific Contraption Actors while a contraption is assembled. Right-click the Controls to toggle supported components such as Mechanical Drills, Mechanical Saws, Deployers, Harvesters, Rollers, Funnels, Portable Storage Interfaces and Redstone Contacts. You can also apply a Filter while the block is stationary to make the Controls affect &bonly&r a specific type of actor. If the Controls receive a Redstone signal &bbefore&r and during assembly, the selected actors will start disabled."]
	quest.4D032F927E1EEA92.quest_subtitle: "Take control of your machine"
	quest.4D1B5D77205C0308.quest_desc: [
		"&dElectromancer&r Helmet is the Crystal Chronicles upgraded version of the Electromancer Hat from Iron’s Spells ’n Spellbooks."
		""
		"It is &bupgraded&r using a Voltite Shard, which enhances the original Electromancer Armor set with additional crystalline power. The Voltite Shard &bchannels&r the power of Lightning magic, creating a stronger &bversion&r of the original Electromancer equipment."
	]
	quest.4D1B5D77205C0308.quest_subtitle: "An enhanced form of Electromancer Hat, empowered by Voltite"
	quest.4D22EB48E8F809A1.quest_subtitle: "Upgrade+"
	quest.4D41297C9A7296E4.quest_desc: [
		"&aEmerald-infused&r tools represent rarity and efficiency."
		"They are powerful, durable, and a symbol of mastery over valuable &bresources&r."
	]
	quest.4D41297C9A7296E4.quest_subtitle: "Rare and powerful"
	quest.4D41297C9A7296E4.title: "Emerald Netherite Tools"
	quest.4D419B82842C08CD.quest_desc: ["&6Create&r Riesling, an elegant white wine for your automated winery. &bUse&r the Wine Cellar and Create machinery to process the necessary ingredients and turn your grape harvest into a refined Riesling. Create: Winery &badds&r grape processing and an automatable Wine Cellar to the Create experience."]
	quest.4D419B82842C08CD.quest_subtitle: "A crisp classic from the vineyard"
	quest.4D44B7D40397F514.quest_subtitle: "More Armor"
	quest.4D652344B212814A.quest_desc: ["&6Obtain&r a Mechanical Belt from Create. Belts connect Shafts to transfer &brotational&r power and can &btransport&r items and entities through your factory. They can be placed horizontally, vertically, or &bdiagonally&r between aligned shafts, making them one of the most useful tools for automation."]
	quest.4D652344B212814A.quest_subtitle: "Build the backbone of your factory"
	quest.4D6E5A2127330896.quest_desc: [
		"&9&lKeep&r&r your Refined Storage network under control with the Wrench. &bUse&r it to interact with and &bconfigure&r connected Refined Storage devices, making it easier to manage and adjust your setup."
		""
		"A simple but &bessential&r tool for anyone building and maintaining an advanced digital storage system."
	]
	quest.4D6E5A2127330896.quest_subtitle: "Configure and maintain your storage network"
	quest.4D73262F4F52510D.quest_subtitle: "More Weapon"
	quest.4D8BAB5CDE8BFBC0.quest_desc: ["&eMeet&r your new mining companion! The Clockwork Drill is a mechanical tool that mines in a straight line in the direction it faces. It &bcollects&r mined items in its own inventory, allowing you to &bfocus&r on other tasks. Keep in mind that the drill wears down with use and can be repaired using Clockwork Gears. &bActivate&r it and let machinery do the hard work!"]
	quest.4D8BAB5CDE8BFBC0.quest_subtitle: "Automated Mining"
	quest.4D8ED9083AD53A3F.quest_subtitle: "More Armor"
	quest.4DA1A9ADA6EAE341.quest_desc: [
		"&dThe&r Wandering Magician Hood is part of the early-game Wandering Magician Armor set in Iron's Spells 'n Spellbooks. It provides &b+2&r Armor and &b+25&r Max Mana."
		""
		"Craft it by combining a Leather Cap with Arcane Essence and &bbegin&r your journey into magical armor."
	]
	quest.4DA1A9ADA6EAE341.quest_subtitle: "Protect your mind with the first touch of arcane power"
	quest.4DBBB9179B1F7432.quest_desc: ["Rage of Stars is a mid-tier star-themed &aweapon&r from Eternal Starlight, used in the progression between elemental materials and &blate-game&r celestial gear. It focuses on burst magical damage and area star effects rather than &braw&r endgame power."]
	quest.4DBBB9179B1F7432.quest_subtitle: "Starlight mid-tier weapon"
	quest.4DE0FF6EF901B590.quest_desc: [
		"The Glacite Sword is a &afrost-infused&r weapon from Eternal Starlight crafted &busing&r Glacite Ingots."
		""
		"It is used in mid-tier &aprogression&r and applies a slowing effect to enemies, making it effective for crowd control in &bcold&r biomes of the Starlight dimension."
	]
	quest.4DE0FF6EF901B590.quest_subtitle: "Frost control blade"
	quest.4DEC36CB7610E0F7.quest_desc: [
		"&aCraft&r the Steeleaf Leggings using the enchanted Steeleaf material gathered throughout the Twilight Forest. Reinforced with the ancient magic of the forest, these leggings provide &bexcellent&r protection without sacrificing mobility, allowing you to travel safely through &bdangerous&r biomes, ancient ruins, and monster-filled dungeons."
		""
		"&aAs&r an important part of the Steeleaf Armor set, they &bstrengthen&r your defenses and prepare you for the greater challenges that await deeper within the Twilight Forest."
	]
	quest.4DEC36CB7610E0F7.quest_subtitle: "Protected by the spirit of the forest"
	quest.4E02E40EA466844E.title: "&l&3Underworld Knight"
	quest.4E0C8720F0AE3A90.quest_desc: ["&6Give&r sweet berries a luxurious twist with Ruby Chocolate. Inject 250 mB of Ruby Chocolate into Sweet Berries to create this &bcolorful&r treat. Each serving restores &b7&r hunger and &b11.2&r saturation, while granting the Saturation effect for &b2&r seconds."]
	quest.4E0C8720F0AE3A90.quest_subtitle: "Sweet berries coated in luxurious ruby chocolate."
	quest.4E1A28D72BD04D36.quest_desc: [
		"The Glacite Axe is a &awoodcutting&r tool from Eternal Starlight crafted &busing&r Glacite Ingots."
		""
		"&aIt&r is &bused&r for harvesting wood in cold biomes and provides improved durability and combat &befficiency&r compared to earlier-tier tools."
	]
	quest.4E1A28D72BD04D36.quest_subtitle: "Frost woodcutting tool"
	quest.4E433B7C8FE67C0D.quest_subtitle: "More Armor"
	quest.4E439D0CB3D14389.quest_desc: [
		"&aDiscover&r the Crystal Mountains, hilly islands with colorful, glowing crystal peaks rising from otherwise barren terrain."
		""
		"Mining the bright &bAurora Crystal&r formations here occasionally yields Crystal Shards, a key ingredient for Infusion Rituals."
	]
	quest.4E439D0CB3D14389.quest_subtitle: "Glowing crystal peaks"
	quest.4E439D0CB3D14389.title: "Crystal Mountains"
	quest.4E7437052378DF33.quest_desc: [
		"&9&lGive&r&r your storage the ability to smelt compatible items with the Smelting Upgrade. It allows you to process ores, food and other &bsmeltable&r materials directly from your storage without needing a separate furnace."
		""
		"Take automation further with the Auto-Smelt­ing Upgrade. It automatically handles the smelting process, including processing inputs, using fuel and storing the finished products, making &blarge-scale&r smelting simple and efficient."
	]
	quest.4E7437052378DF33.quest_subtitle: "Turn your storage into an automated furnace"
	quest.4E7437052378DF33.title: "Smelting \\& Auto-Smelting Upgrade"
	quest.4E7B79C12957DA08.quest_subtitle: "Yummy!"
	quest.4E9A266A0679029F.quest_desc: ["&6Obtain&r an Item Hatch from Create. Added in Create 6.0, the Item Hatch provides a convenient way to quickly deposit items into connected storage, such as an Item Vault. It is &bespecially&r useful for large &bautomated&r storage systems."]
	quest.4E9A266A0679029F.quest_subtitle: "Open the gateway to your storage"
	quest.4EAE91C552A83A04.quest_desc: ["&dBoosts&r the &bblowback&r of your shots, pushing you away from where you aim. Creative players can use it for mobility."]
	quest.4EAE91C552A83A04.quest_subtitle: "Blown back"
	quest.4EB976A42496C971.quest_desc: [
		"The Terminite Hammer is a heavy &atool&r and weapon forged from Terminite Ingots, used both at the Anvil and in combat for strong knockback strikes."
		""
		"Terminite is made by smelting a Thallasium Ingot with End Dust in an &bEnd Stone Smeltery&r."
	]
	quest.4EB976A42496C971.quest_subtitle: "Heavy tool and weapon, refined"
	quest.4EE25A746729E0D2.quest_desc: ["&dThe&r Bullet Box stores a large number of bullets in a single item, so you can carry plenty of &bammo&r without cluttering your inventory. Check its tooltip to see how many it can hold."]
	quest.4EE25A746729E0D2.quest_subtitle: "Carry more ammo"
	quest.4EECF73BD3E5F9F4.quest_desc: ["&dIncreases&r your gun's &bfire rate&r, so you can pull the trigger more often."]
	quest.4EECF73BD3E5F9F4.quest_subtitle: "Faster fingers"
	quest.4F01E4637FF19336.quest_desc: [
		"The Glacite Shield is a &adefensive&r item from Eternal Starlight crafted &busing&r Glacite materials."
		""
		"It &aprovides&r improved durability over the vanilla shield and offers better survivability in cold biomes where frost effects are &bcommon&r."
	]
	quest.4F01E4637FF19336.quest_subtitle: "Frost defense shield"
	quest.4F1FD5D36701CD85.quest_subtitle: "Yummy!"
	quest.4F3C4F623E85F5BC.quest_desc: [
		"&dTwilight&r Gale is a powerful crystalline spear infused with Lightning magic in Iron's Spells 'n Spellbooks. It has &b13&r Attack Damage and &b1.4&r Attack Speed and comes imbued with Volt Strike &bV&r."
		""
		"Twilight Gale can be thrown like a trident. Throwing it does not consume the weapon, but places it on a &b10-second&r cooldown. It can also be enchanted with Sword enchantments, Loyalty and Channeling."
	]
	quest.4F3C4F623E85F5BC.quest_subtitle: "Unleash the storm within a crystalline spear"
	quest.4F475C30FD8E2E6F.quest_subtitle: "More Weapon"
	quest.4F7D8B325F91CE45.quest_desc: ["&aObtain&r the Amethyst Crab Shell from the Cataclysm mod. This &brare&r shell is a trophy taken from the defeated Amethyst Crab, carrying the strength of the crystal beast and the &bpower&r of the Amethyst Nest."]
	quest.4F7D8B325F91CE45.quest_subtitle: "A shell forged by crystal and fury"
	quest.4F9326EC48083D49.quest_desc: ["&aEmeralds&r bring rarity and prestige to your equipment. Combined with Netherite, they create armor that stands out both in &bstrength&r and &buniqueness.&r"]
	quest.4F9326EC48083D49.quest_subtitle: "Value and strength"
	quest.4F9326EC48083D49.title: "Emerald Netherite Leggings"
	quest.4FA02401C47E388C.quest_desc: ["&6A&r variable transformer: change the &bvoltage&r ratio with a kinetic input, so you can smoothly step voltage up or down."]
	quest.4FA02401C47E388C.quest_subtitle: "A variable transformer"
	quest.4FB9D03981206026.quest_desc: [
		"&eSome&r &badventurers&r trust their weapons. Others trust their luck."
		""
		"The Superstitious Hat grants an additional &blevel&r of Looting when you kill an entity, giving you a better &bchance&r of getting valuable drops from your enemies."
		""
		"Maybe it's luck. Maybe &bit's&r the hat. Either way, don't take it off."
	]
	quest.4FB9D03981206026.quest_subtitle: "A little superstition never hurts"
	quest.4FBCF48A80687440.quest_desc: ["&aCraft&r Neptunium Helmet from Aquaculture 2. This powerful helmet is made from Neptunium, a rare &bmaterial&r obtained from fishing treasures. It provides strong &bprotection&r and is &bpart&r of the Neptunium armor set."]
	quest.4FBCF48A80687440.quest_subtitle: "Armor forged from ocean treasures"
	quest.4FBDDAEB4BB98D95.quest_desc: ["&6An&r NPN bipolar transistor, used in circuits for switching and amplifying &bsignals&r."]
	quest.4FBDDAEB4BB98D95.quest_subtitle: "An NPN transistor"
	quest.4FC6D49180163005.quest_subtitle: "More Weapon"
	quest.4FC749FD84D5C02E.quest_desc: ["Craft a &aLightning Rod&r. This block will protect your &bstructures&r from lightning strikes."]
	quest.4FC749FD84D5C02E.quest_subtitle: "Harness the Storm"
	quest.4FC749FD84D5C02E.title: "Catch the Lightning"
	quest.4FDE0D84FB894A08.quest_subtitle: "More Weapon"
	quest.4FF6113C0C5AB301.quest_desc: ["&6The&r Printer is a machine from Create: Enchantment Industry that lets you &bautomatically&r copy written books, enchanted books, name tags, train schedules and other supported items. It uses the &bappropriate&r blank item as the printing material and can &buse&r Liquid Experience when copying enchanted books. It can also copy &bpackage&r patterns or package addresses for Create logistics."]
	quest.4FF6113C0C5AB301.quest_subtitle: "Copy your most valuable creations"
	quest.5009B335115B7D24.quest_desc: ["&6Prepare&r a delicious Strawberry Milkshake and add a refreshing &bfruit-based&r drink to your factory's production line. Mix the required &bingredients&r and enjoy a sweet new creation from Create: Dreams n' Desires."]
	quest.5009B335115B7D24.quest_subtitle: "A fruity twist on a classic"
	quest.5040AEF744A85F14.quest_desc: ["&6Create&r Chardonnay, a refined white wine for your &bautomated&r winery. Use the Wine Cellar to process the necessary ingredients and turn your grape harvest into another addition to your &bcollection&r of white wines. Create: Winery adds wine-themed recipes, grape processing, and a fully automatable Wine Cellar."]
	quest.5040AEF744A85F14.quest_subtitle: "A crisp classic from the vineyard"
	quest.5044B5A42DC32D14.quest_desc: ["&6The&r Grapplin Whisk is a grappling tool that lets you hook onto blocks and pull &byourself&r toward them. Aim at a block and right-click to launch the hook, then right-click again to release it. It has a &bmaximum&r range of about &b75&r blocks and uses fuel while the hook is attached. It can be especially useful for quickly climbing structures, crossing gaps and moving through the world. The item also supports the Impact enchantment, which can deal &bdamage&r when colliding with entities at &bhigh&r speed."]
	quest.5044B5A42DC32D14.quest_subtitle: "Swing your way through the world"
	quest.504A757586C3B1F5.quest_subtitle: "Yummy!"
	quest.509BE69A1FDD93BB.quest_desc: ["&6The&r Brass Helmet is part of the Brass Suit added by Create Stuff 'N Additions. It is crafted from &b5&r Brass Ingots and has &b275&r durability, providing a more &badvanced&r armor option made from Create's brass."]
	quest.509BE69A1FDD93BB.quest_subtitle: "Protection worthy of brass"
	quest.50B0B99B8C384EE9.quest_desc: [
		"&aObtain&r the Void Staff from Cataclysm Spellbooks, a weapon tied to the void-themed content unlocked after clearing the &aRuined Citadel&r."
		""
		"It channels the energy of Void Cores into powerful ranged &battacks&r."
	]
	quest.50B0B99B8C384EE9.quest_subtitle: "A weapon of pure void energy"
	quest.50B0B99B8C384EE9.title: "&dVoid Staff"
	quest.50B1F5510C37DC14.quest_desc: ["&6Craft&r the Brass Gearbox and Vertical Brass Gearbox to gain precise control over rotational direction. Each shaft connection can be &bconfigured&r independently, letting you create compact and flexible kinetic networks. The Vertical Brass Gearbox provides the same &bfunctionality&r in a vertical arrangement."]
	quest.50B1F5510C37DC14.quest_subtitle: "Take control of every connection"
	quest.50B1F5510C37DC14.title: "Brass Gearboxes"
	quest.50CEF0918E92F0E6.quest_subtitle: "Yummy!"
	quest.50E77BBBABDD9FDF.title: "Mental"
	quest.510EA403E0E37E35.quest_desc: [
		"Iron gear is good, but it won’t keep you safe forever."
		"It’s time to upgrade your protection and craft a full set of &aDiamond Armor&r."
		""
		"Diamonds are one of the strongest materials in the Overworld, allowing you to survive stronger enemies and dangerous adventures. With this armor equipped, you will be ready for harder battles and deeper &bexploration&r."
	]
	quest.510EA403E0E37E35.quest_subtitle: "True Protection"
	quest.510EA403E0E37E35.title: "&bDiamond Armor"
	quest.51100C3A9844C57E.quest_desc: ["&aObtain&r a Coral Bardiche from the Cataclysm mod. This powerful &bweapon&r is dropped by Deepling &benemies&r and is known for its heavy attacks and &bunique&r design. Defeat Deeplings to collect this rare ocean weapon."]
	quest.51100C3A9844C57E.quest_subtitle: "A heavy weapon of the deep sea"
	quest.511627AE87E19763.quest_desc: [
		"&dPrismatic&r Knight Boots are p&bart&r of the Prismatic Knight Armor set, the strongest armor set in Crystal Chronicles."
		""
		"They are &bcrafted&r using a Divine Soulshard from Iron’s Spells ’n Spellbooks and can be created by &bupgrading&r the boots from any enhanced Crystal Chronicles armor set. This makes the Prismatic Knight set the final &bevolution&r of the Crystal Chronicles armor progression."
	]
	quest.511627AE87E19763.quest_subtitle: "The ultimate boots forged from the power of the Crystal Chronicles"
	quest.5118194319F816DC.quest_subtitle: "More Armor"
	quest.511F8FFA4608FC67.quest_desc: ["&6Turn&r a simple chocolate bar into a bite-sized treat. Inject 250 mB of Chocolate into a Caramel Bar, White Chocolate Bar or Dark Chocolate Bar &bto&r create Chocolate Candy. Each candy restores &b8&r hunger and &b11&r saturation."]
	quest.511F8FFA4608FC67.quest_subtitle: "A classic chocolate treat, small but delicious."
	quest.512380A29094424E.quest_desc: ["&dThe&r Fireward Ring grants complete immunity to fire, &bprotecting&r you from one of the most dangerous elements in the world. &bEquip&r it and walk through flames, lava and other sources of fire without fear."]
	quest.512380A29094424E.quest_subtitle: "Become immune to the flames"
	quest.5128F112C21A18E6.quest_desc: ["&6The&r basic wire for connecting device terminals. Current only flows when the circuit forms a complete &bloop&r. Every wire has resistance: the longer it is, the bigger the &bvoltage&r drop, and lost power turns into heat. Draw too much and the wire can overheat and break."]
	quest.5128F112C21A18E6.quest_subtitle: "The basis of every circuit"
	quest.512D2E05632955B4.quest_desc: ["&6Create&r the Gingerbread Man in Create: Confectionery and bring a little &bholiday&r magic to your factory. The mod &badds&r Gingerdough, Gingerbread, and the Gingerbread Man, with later versions also fixing and improving the little Gingerbread Man. It can even &bbecome&r a train conductor in Create builds."]
	quest.512D2E05632955B4.quest_subtitle: "Bring your gingerbread to life"
	quest.5134FF2EFACD3AD7.quest_desc: ["&6Craft&r the Blaze Balloon Cannon, a &bnew&r way to deploy the tiny Blaze Balloon. The cannon launches Blaze Balloons, which can attack &bnearby&r mobs and disappear after defeating their target. It was introduced as &bpart&r of the Blaze Balloon rework in Create: Misc \\& Things 4.0."]
	quest.5134FF2EFACD3AD7.quest_subtitle: "Send a little blaze into the sky"
	quest.51386C52D32866DB.quest_desc: ["&6A&r variable resistor: change its &bresistance&r with a kinetic input. In a self-excited generator it helps you control the output &bvoltage&r."]
	quest.51386C52D32866DB.quest_subtitle: "A variable resistor"
	quest.514CB6EB132BFD32.quest_desc: [
		"&aCraft&r the Ironwood Pickaxe using Ironwood Ingots infused with the ancient magic of the Twilight Forest. Designed for &bexplorers&r seeking rare resources, this enchanted pickaxe offers exceptional durability and mining efficiency, making it an invaluable companion for &bexpeditions&r into caves, ruins, and underground structures."
		""
		"&aAs&r part of the Ironwood equipment set, it marks another &bstep&r forward in your adventure, allowing you to gather the materials &bneeded&r for even greater challenges."
	]
	quest.514CB6EB132BFD32.quest_subtitle: "Uncover the forest's hidden treasures"
	quest.5168034C6C8B8360.quest_desc: ["&dReduces&r your gun's camera &brecoil&r, making it easier to stay on target between shots."]
	quest.5168034C6C8B8360.quest_subtitle: "Tame the recoil"
	quest.51CDB37B1C51C2A7.quest_desc: [
		"&dCryomancer&r Leggings are part of the Cryomancer Armor set in Iron's Spells 'n Spellbooks. When worn, they provide &b+6&r Armor, &b+125&r Max Mana, &b+10%&r Ice Spell Power and &b+5%&r Spell Power."
		""
		"They can be crafted from 7 Arcane Cloth and 1 Ice Rune, or &bupgraded&r from Wizard Leggings with 1 Ice Rune and 1 Arcane Essence."
	]
	quest.51CDB37B1C51C2A7.quest_subtitle: "Channel the freezing power of Ice magic through your armor"
	quest.51EB17B61F3779A7.quest_desc: [
		"&aThe&r Starlit Diamond Helmet is a high-tier armor piece from Eternal Starlight crafted us&bing&r Starlit Diamonds."
		""
		"Starlit Diamond armor offers &aprotection&r comparable to Netherite armor while providing increased &barmor&r toughness and knockback resistance."
	]
	quest.51EB17B61F3779A7.quest_subtitle: "Celestial diamond headgear"
	quest.51F2B327C73BD224.quest_desc: ["&6A&r relay that &bswitches&r two paths at once."]
	quest.51F2B327C73BD224.quest_subtitle: "A double-pole relay"
	quest.5204FCC2B0AA7609.quest_desc: ["&6Like&r a triode, with an extra screen grid (G2) for higher gain. First &bpower&r the heater; the screen must be positively biased for the tube to conduct."]
	quest.5204FCC2B0AA7609.quest_subtitle: "A pentode"
	quest.520FCAEED121844D.quest_subtitle: "Upgrade+"
	quest.5210EC97FDA6152E.quest_subtitle: "More Armor"
	quest.52410E0106CF5307.quest_subtitle: "Upgrade+"
	quest.5245F1F3ED39769B.quest_subtitle: "Yummy!"
	quest.52572710E4A97D40.quest_desc: [
		"&dBlood&r Vial is the Blood Focus in Iron's Spells 'n Spellbooks and is &bused&r to craft Blood spells. To obtain it, place a lit campfire beneath a cauldron and put a mob into the cauldron. The mob is cooked and the &bcauldron&r fills with blood, which can then be collected with glass bottles."
		""
		"Blood Vials are also used in crafting recipes for &bBlood-related&r magical items, including the Blood Rune and Ancient Codex."
	]
	quest.52572710E4A97D40.quest_subtitle: "Harvest the essence of blood magic"
	quest.52636AD2E262B7A3.quest_desc: [
		"&aCraft&r the Fiery Boots using Fiery Ingots forged from the Hydra's blazing essence. Imbued with the &brelentless&r heat of the Fire Swamp, these enchanted boots provide outstanding protection while carrying the spirit of the &blegendary&r beast with every step."
		""
		"&aAs&r the final piece of the Fiery Armor set, they &bcomplete&r one of the most powerful armor collections in the Twilight Forest. Forged in dragonfire and tempered by magic, they are a symbol of your triumph over the &bHydra&r and your readiness for the even greater dangers that await."
	]
	quest.52636AD2E262B7A3.quest_subtitle: "Walk through fire without fear"
	quest.5279778C7AE12A98.quest_desc: [
		"&eDeath&r doesn't always have to be the end."
		""
		"The Chorus Totem protects you from a fatal blow, &bteleporting&r you to another location instead of &bletting&r you die. The totem is consumed when it activates, so make sure you have one when things get dangerous."
		""
		"&bWhen&r death comes knocking, let the chorus carry you away."
	]
	quest.5279778C7AE12A98.quest_subtitle: "A second chance at the end"
	quest.527F8F06FBAE607C.quest_desc: [
		"&9&lExpand&r&r your Refined Storage &bnetwork&r by pulling items from external inventories. The Importer automatically extracts items from connected containers and sends them directly into your digital storage system."
		""
		"Connect it to a chest, barrel or another &bcompatible&r inventory and let your network handle the rest."
	]
	quest.527F8F06FBAE607C.quest_subtitle: "Bring items into your digital storage network"
	quest.528388990A969214.quest_desc: ["&6The&r Blazing Axe is part of the Blazing tool set from Create Stuff 'N Additions. It has 450 durability and &bautomatically&r smelts logs into charcoal when cutting wood. It also sets &battacked&r mobs on fire. The axe deals 8.5 attack damage with 1.0 attack speed."]
	quest.528388990A969214.quest_subtitle: "Turn wood into fuel"
	quest.52904ED7A755A219.quest_desc: ["&6Craft&r the Redstone Link Wildcard and &bgive&r your Redstone Links a flexible new way to match frequencies. Assign the Wildcard to a frequency slot and it will match any item in that slot, including air, &ballowing&r one link to interact with a much wider &brange&r of frequencies. It was added to Create: Connected 1.1.0."]
	quest.52904ED7A755A219.quest_subtitle: "Match any frequency"
	quest.529B0F155E680058.quest_desc: ["&6Build&r the Windchest Controller to control the &bairflow&r of your pipe organ. It works alongside the Windchest and is part of the &bsystem&r used to manage the organ's wind supply. In Create: Sound of Steam, Windchest Controllers can be placed similarly to fans, with their direction reversible &busing&r Shift while placing."]
	quest.529B0F155E680058.quest_subtitle: "Control the organ's airflow"
	quest.529D4F0288578416.quest_desc: [
		"&aThis&r is your first &bstep&r into a world full of adventures and challenges."
		"This quest will introduce you to the basics that will help you start your journey and explore more mechanics."
		"Take your time – learn everything step by step!"
	]
	quest.529D4F0288578416.quest_subtitle: "Read This First!"
	quest.529D4F0288578416.title: "&lWelcome"
	quest.52AA4866B4D21370.quest_desc: [
		"&dPriest&r Mask is the headpiece of the Priest Armor set in Iron's Spells 'n Spellbooks. When worn, it provides &b+3&r Armor, &b+125&r Max Mana, &b+10%&r Holy Spell Power and &b+5%&r Spell Power."
		""
		"It can be &bcrafted&r from 1 Holy Rune, 1 Wizard Helmet and 1 Arcane Essence, using the upgrade recipe."
	]
	quest.52AA4866B4D21370.quest_subtitle: "Channel the sacred power of Holy magic"
	quest.52CE94EE7C18F40D.quest_desc: ["&dUpgrade&r your Iron’s Spells ’n Spellbooks armor with special shards, discover powerful weapons, and reach the ultimate Prismatic Knight Armor. &bUse&r Divine Soulshard to create it and Ring of Diffraction + R to &bchange&r your magic type."]
	quest.52CE94EE7C18F40D.quest_subtitle: "Begin your journey through the ultimate magical upgrade system"
	quest.52CE94EE7C18F40D.title: "&l&dCrystal &bChronicles"
	quest.52CFCFB5A591BB4B.quest_subtitle: "Yummy!"
	quest.52D5B5205520E523.quest_desc: [
		"You have &atraveled&r through the many regions of Eternal Starlight, facing its creatures, gathering its resources, and uncovering its secrets."
		"From dense forests to crystal deserts, your &bjourney&r proves that you can survive and adapt to this alien world."
		""
		"This is not about a single task — it is about &aeverything&r you have accomplished."
	]
	quest.52D5B5205520E523.quest_subtitle: "Master the unknown"
	quest.52D5B5205520E523.title: "Starlight Explorer"
	quest.52DCB270B1BE149F.quest_subtitle: "Yummy!"
	quest.52E27F23DFB8AE00.quest_desc: [
		"&dVenomous&r Crusader Helmet is the Crystal Chronicles upgraded version of Plagued Mask from Iron’s Spells ’n Spellbooks."
		""
		"It is &bupgraded&r using a Floralite Shard, transforming the original Plagued Armor into the powerful Venomous Crusader Armor set. The Floralite Shard infuses the helmet with the &bpower&r of Nature magic, strengthening its poisonous and &bplague-based&r abilities."
	]
	quest.52E27F23DFB8AE00.quest_subtitle: "An enhanced form of Plagued Mask empowered by Floralite"
	quest.52E342A348772EC8.quest_desc: [
		"&dMithril&r Ingot is a Rare crafting material in Iron's Spells 'n Spellbooks. It is crafted from Mithril Scrap and is &bused&r to create powerful mithril &bequipment&r and weapons."
		""
		"Mithril is one of the most valuable materials in the mod, forming an important &bpart&r of late-game &bmagical&r progression."
	]
	quest.52E342A348772EC8.quest_subtitle: "Forge legendary equipment from refined mithril"
	quest.52FD0758E3C79ADA.title: "Serious?"
	quest.530A8C2E8DE698A5.quest_subtitle: "More Armor"
	quest.530BFD8610704834.quest_desc: ["&dCreatures&r hit one after another are &bchained&r together, keeping them close to each other."]
	quest.530BFD8610704834.quest_subtitle: "Link your targets"
	quest.534FBA8BC6F117F0.quest_subtitle: "Upgrade+"
	quest.5368EF5D6BBE0FE8.quest_desc: ["&eIt's&r time to upgrade your arsenal! The Scoped Crossbow is a &bmechanical&r crossbow equipped with a spyglass for more accurate aiming. Its arrows travel &bfaster&r and farther than those fired from a &bregular&r crossbow. Take advantage of its capabilities and strike your enemies from a safe distance!"]
	quest.5368EF5D6BBE0FE8.quest_subtitle: "Precision at Long Range"
	quest.5379AFF2231F2779.quest_subtitle: "More Armor"
	quest.5379F8CE6C8EE40C.quest_desc: ["&6Obtain&r Copper Diving Boots from Create. They are part of Create's diving gear and are designed for &bunderwater&r movement. When worn, they make you sink faster in liquids, prevent normal swimming, but allow you to walk and jump underwater. They also make you &bimmune&r to Mechanical Belts, which is &buseful&r when working around moving contraptions."]
	quest.5379F8CE6C8EE40C.quest_subtitle: "Walk beneath the waves"
	quest.53809B8ED22A6C98.quest_subtitle: "More Armor"
	quest.53849ECADC1162F5.quest_desc: [
		"&dIce&r Rune is a crafting ingredient in Iron's Spells 'n Spellbooks, used for advanced &bIce-related&r crafting, including Ice Upgrade Orbs. The Ice school uses Frozen Bone as its magical Focus."
		""
		"Create an Ice Rune by combining 1 Blank Runestone with 8 Frozen Bones. Runestones are made by &binfusing&r a Blank Runestone with 8 Focuses of the chosen school."
	]
	quest.53849ECADC1162F5.quest_subtitle: "Infuse a runestone with the freezing power of Ice magic"
	quest.5396A806C9436D51.quest_desc: ["&6Prepare&r a Glowberry Milkshake and bring the &bluminous&r taste of Glow Berries into your factory. This glowing variation adds a unique touch to your &bcollection&r of milkshake recipes from Create: Dreams n' Desires."]
	quest.5396A806C9436D51.quest_subtitle: "A glowing twist on a sweet classic"
	quest.5399D19A4428F46C.quest_desc: [
		"&eCooked&r to perfection — and somehow impossible to finish. Eternal Steak restores your hunger without being consumed, letting you &benjoy&r the same steak again and again."
		""
		"It does &bcome&r with one small catch: after eating, you'll have to wait 15 seconds before taking another bite."
	]
	quest.5399D19A4428F46C.quest_subtitle: "The meal that never ends"
	quest.53BE5E8D3A303F75.quest_desc: ["&6A&r zinc sheet needed for batteries, the potato battery and the capacitor. Make it with a Create press from a zinc ingot."]
	quest.53BE5E8D3A303F75.quest_subtitle: "A zinc sheet"
	quest.53C6333891CDEC6E.quest_desc: [
		"&bTake&r your first photograph using the Camera and store it on a &aFilm Roll&r."
		"Photographs can be developed and displayed using the Interplanar Projector."
	]
	quest.53C6333891CDEC6E.quest_subtitle: "Capture a moment"
	quest.53D7FCF5FF4DF4E8.quest_desc: ["&6Sand&r Paper is a simple but important processing tool in Create. Use it on items such as Rose Quartz to polish them into Polished Rose Quartz. Hold the Sand Paper in one hand and the item in the other, then hold &bright-click&r to polish it. The &bprocess&r can also be automated with a Deployer, making Sand Paper an important step toward &bautomating&r Create's more advanced components."]
	quest.53D7FCF5FF4DF4E8.quest_subtitle: "Polish your way to perfection"
	quest.53D7FCF5FF4DF4E8.title: "Any Sand Paper"
	quest.53EC04826E16C35D.quest_desc: ["&6The&r Golden Mixer is a kinetic machine added by the Create: Dreams n' Desires feature set. It is a specialized mixer used for processing recipes and is crafted &busing&r a Golden Whisk. The Golden Mixer &bexpands&r your factory's mixing capabilities with new &bprocessing&r possibilities."]
	quest.53EC04826E16C35D.quest_subtitle: "Mix with golden precision"
	quest.53F7BC75BF59E4F0.quest_subtitle: "More Weapon"
	quest.540AE69BCE928B52.quest_desc: [
		"&aCraft&r the Ice Bow, a weapon infused with the ancient magic of the Glacier. Every arrow fired from its &benchanted&r string carries the chilling &bessence&r of eternal winter, slowing enemies and leaving them &bvulnerable&r before they can reach you."
		""
		"&aFavored&r by skilled hunters and &bexplorers&r of the frozen wilderness, the Ice Bow offers unmatched control over the battlefield. &bWhether&r facing swift monsters or mighty bosses, its icy arrows ensure your enemies are caught in the grip of the Glacier."
	]
	quest.540AE69BCE928B52.quest_subtitle: "Strike from afar with the power of winter"
	quest.5410D37C4B979F14.quest_desc: ["&aDefeat&r Coralssus from the Cataclysm mod. This powerful &bocean&r boss is a massive coral &bcreature&r found in underwater environments. &bPrepare&r yourself for a difficult battle and overcome this guardian of the deep sea."]
	quest.5410D37C4B979F14.quest_subtitle: "Defeat the guardian of the coral depths"
	quest.5410D37C4B979F14.title: "Kill Coralssus"
	quest.54150A1175E277C9.quest_desc: [
		"The Thallasium Anvil is used together with a Smith Hammer to turn Thallasium Ingots into &aForged Plates&r and tool heads."
		""
		"It's the first crafting station in Better End's &bequipment&r progression."
	]
	quest.54150A1175E277C9.quest_subtitle: "Working the first tier of metal"
	quest.5442F0731BF3AFE2.quest_desc: [
		"&6Take&r your locomotive's industrial design one step further. Iron Wrapped Locometal combines the rugged appearance of Locometal with an &biron-wrapped&r construction, making it a great choice for sturdy locomotive bodies and detailed railway builds."
		""
		"Add it to your train and &bgive&r your locomotive a heavier, more mechanical appearance."
	]
	quest.5442F0731BF3AFE2.quest_subtitle: "Industrial strength wrapped in iron."
	quest.544E42DF89627778.quest_desc: [
		"Chipped &badds&r several special tools used for crafting decorative blocks and workstations."
		"Collect these tools to unlock more creative building options."
	]
	quest.544E42DF89627778.quest_subtitle: "Tools for decoration"
	quest.544E42DF89627778.title: "Chipped Tools"
	quest.5461386AA6C16AD2.quest_desc: ["&6The&r Copper Stool with Festive Lights is a &bdecorative&r piece that combines a copper stool with festive lighting. Use it to add a little &bextra&r character and atmosphere to your factory, workshop or living area."]
	quest.5461386AA6C16AD2.quest_subtitle: "Add some festive style to your factory"
	quest.54718DF7D28E91FA.quest_desc: ["&dRemoves&r &bunderwater&r drag, so your bullets fly straight and far even when submerged."]
	quest.54718DF7D28E91FA.quest_subtitle: "Shoot through water"
	quest.5472CD376AC38047.quest_desc: [
		"Craft a &aBrush&r to start painting and decorating your blocks."
		"With a brush, you can add patterns, colors, and personal touches to your creations."
	]
	quest.5472CD376AC38047.quest_subtitle: "Decorate with style"
	quest.5472CD376AC38047.title: "Brush Art"
	quest.5473370385EF24F5.quest_desc: [
		"&aCraft&r the legendary Neptunium Fillet Knife, the ultimate tool for any master angler. &bForged&r from the mythical metal &bhidden&r within the oceans, this extraordinary blade combines unmatched durability with razor-sharp precision, making it the finest fillet knife ever created."
		""
		"&aOnly&r those who have &buncovered&r the ocean's rarest treasures can wield such a masterpiece. With the Neptunium Fillet Knife, every catch can be processed with unrivaled efficiency, proving that you have truly &bmastered&r the art of fishing."
	]
	quest.5473370385EF24F5.quest_subtitle: "Forged from the treasures of the sea"
	quest.54760CB8A31B3C8F.quest_desc: ["&6Obtain&r Crushed Magma, a useful fuel item from Create: Misc \\& Things. It can be used as a furnace fuel source and is &bpowerful&r enough to smelt 12 items per piece."]
	quest.54760CB8A31B3C8F.quest_subtitle: "Turn magma into powerful fuel"
	quest.549C88615E62EA0F.quest_desc: [
		"&aDiscover&r the Painted Mountains, colorful mountain ranges rich in &bViolecite&r and Flavolite deposits."
		""
		"Its striking, multicolored stone makes it a key biome for gathering the materials behind Better End's &bportal&r rituals."
	]
	quest.549C88615E62EA0F.quest_subtitle: "Colorful stone peaks"
	quest.549C88615E62EA0F.title: "Painted Mountains"
	quest.54D2447B98F2DCD6.quest_desc: ["Craft a Golden Shield to withstand attacks more effectively and shine in battle."]
	quest.54D2447B98F2DCD6.quest_subtitle: "Upgrade your defense with a Golden Shield!"
	quest.54D8F46882E36BA9.quest_desc: [
		"&aCraft&r a Golden Fishing Rod, a refined tool &bworthy&r of the most dedicated anglers. Though forged from gold, this elegant rod is designed for those who seek rare catches and hidden treasures &brather&r than ordinary fish."
		""
		"&aWhether&r casting your line into a &bquiet&r river or the vast open sea, the Golden Fishing Rod stands as a symbol of experience and prosperity. Sometimes, the greatest &brewards&r belong to those willing to fish with the finest equipment."
	]
	quest.54D8F46882E36BA9.quest_subtitle: "Fish in style and fortune"
	quest.54E982A07A5CCEDF.quest_desc: [
		"&dCryomancer&r Chestplate is the Crystal Chronicles upgraded version of the Cryomancer Robe from Iron’s Spells ’n Spellbooks."
		""
		"It is &bupgraded&r using a Cryolite Shard, which enhances the original Cryomancer Armor set with additional crystalline power. The Cryolite Shard strengthens the chestplate with the &bpower&r of Ice magic, &bcreating&r an improved version of the original Cryomancer gear."
	]
	quest.54E982A07A5CCEDF.quest_subtitle: "An enhanced form of Cryomancer Robe, empowered by Cryolite"
	quest.54EA9D964A72868A.quest_desc: ["&6Obtain&r a Steam Engine from Create. It converts steam from a boiler into rotational power, providing one of the most &bpowerful&r sources of Stress Units (SU) for large Create factories. Steam Engines are powered by a fluid-tank boiler heated by &bsources&r such as Blaze Burners, with &bstronger&r heat and larger boilers allowing the engine to produce more power."]
	quest.54EA9D964A72868A.quest_subtitle: "Harness the power of steam"
	quest.54EE13A5502CC9C1.quest_desc: ["&dIncreases&r your bullets' &bdamage&r and &bspeed&r, but your gun kicks harder with more &brecoil&r."]
	quest.54EE13A5502CC9C1.quest_subtitle: "More boom"
	quest.5507A99644F53A2C.quest_desc: ["&bOpen&r the &aStarcatcher&r guide to understand how to catch fish, find rare species, and use special bait. Follow the instructions to become a &bskilled&r fisher!"]
	quest.5507A99644F53A2C.quest_subtitle: "Learn the basics of fishing"
	quest.55813BE1B345A5B2.quest_desc: [
		"The Thallasium Sword is Better End's entry-level bladed weapon, assembled from a Thallasium tool head and sword handle at a Smithing Table."
		""
		"It marks the start of the mod's &aweapon&r progression."
	]
	quest.55813BE1B345A5B2.quest_subtitle: "Blade of the first tier"
	quest.5583D946C8B6DE46.quest_desc: [
		"&dThe&r Amulet of Teleportation grants Evasion for 3 seconds after &busing&r a teleport spell. Use teleportation not only to reposition yourself, but &balso&r to briefly avoid incoming attacks and gain an advantage in combat."
		""
		"&bEquip&r the amulet and make every teleport a powerful defensive move."
	]
	quest.5583D946C8B6DE46.quest_subtitle: "Turn every teleport into a chance to evade"
	quest.558992CA0C2BFFEF.quest_subtitle: "More Armor"
	quest.558A08F7B05E46AC.quest_desc: [
		"&eThe&r world remembers its greatest warriors."
		""
		"Across forgotten kingdoms, &bfallen&r empires and distant civilizations, warriors once stood beneath banners that have long since turned to dust. Their &bweapons&r may have been lost, their &bkingdoms&r forgotten, but their armor survived."
		""
		"Now, pieces of those ancient legacies have found their way into your hands."
		""
		"From &bdisciplined&r warriors of ancient armies to legendary champions and mysterious guardians, every set carries the character of an age long gone."
		""
		"These are not &bmerely&r suits of armor."
		""
		"They are remnants of history."
	]
	quest.558A08F7B05E46AC.quest_subtitle: "Wear the legacy of those who came before"
	quest.558A08F7B05E46AC.title: "&f&lWelcome &cArmor Of The Ages"
	quest.55ABA8290A19DBBF.quest_desc: ["&dA&r special orb that enhances &bHydro-related&r abilities and equipment."]
	quest.55ABA8290A19DBBF.quest_subtitle: "An orb that strengthens Hydro power"
	quest.55C1255DEAEC2181.quest_desc: ["&eA&r special item from Simply Swords that can transform into a random &bunique&r weapon after being kept in your inventory."]
	quest.55C1255DEAEC2181.quest_subtitle: "A mysterious remnant transformed by the power of the End"
	quest.55C719DE189DDA9D.quest_desc: [
		"&dThe&r Scroll Forge is a magical crafting station in Iron's Spells 'n Spellbooks used to create spell scrolls. Combine Paper, Ink and a Focus to &bcreate&r a scroll from the chosen school of magic. The &btype&r of Ink determines the rarity and starting level of the spell."
		""
		"&bUse&r the Scroll Forge to expand your collection of spells and prepare powerful magic for your Spell Book."
	]
	quest.55C719DE189DDA9D.quest_subtitle: "Forge magical scrolls from ink, paper and magical focuses"
	quest.55C84DF3A8FE57AE.quest_desc: ["&6Obtain&r a Brass Tunnel and a Brass Funnel from Create. Both are &badvanced&r item-logistics components used for filtering and routing items through automated factories. Brass Funnels can filter specific items and control the &bamount&r transferred, while Brass Tunnels can split or merge item flows &bbetween&r multiple Mechanical Belts."]
	quest.55C84DF3A8FE57AE.quest_subtitle: "Master the flow of your factory"
	quest.55C84DF3A8FE57AE.title: "Brass Tunnel \\& Brass Funnel"
	quest.55CEDA5DBCD41E9B.quest_desc: ["&aDefeat&r 4 Ignited Berserkers from the Cataclysm mod. These &brelentless&r warriors patrol the Burning Arena, serving Ignis with &bunwavering&r loyalty. Overcome their brutal attacks to prove you are worthy of &bchallenging&r the Lord of Fire."]
	quest.55CEDA5DBCD41E9B.quest_subtitle: "Break the fury of the arena's champions"
	quest.55CEDA5DBCD41E9B.title: "Ignited Berserker"
	quest.55D18D15D658ECC0.quest_desc: [
		"&aThe&r Malarite Shovel is an early-game &bdigging&r tool from Eternal Starlight, crafted using Malarite from swamp biomes."
		""
		"&aIt&r belongs to the basic progression tier and is used for &bexcavation&r and terrain clearing."
	]
	quest.55D18D15D658ECC0.quest_subtitle: "Swamp digging tool"
	quest.55D6BD8708A61BAD.quest_desc: ["&6Give&r your railway builds a sturdy industrial finish with Flat Riveted Locometal. Its flat metal surface and rows of rivets &bmake&r it perfect for locomotive bodies, train cars and large railway structures."]
	quest.55D6BD8708A61BAD.quest_subtitle: "A clean surface with the strength of riveted steel."
	quest.55D9819EA5D790BA.quest_desc: ["The Starlit Diamond Shovel is a &alate-game&r utility tool from Eternal Starlight crafted from Starlit Diamond materials. It is &bused&r for efficient excavation in advanced biomes and represents the highest tier of digging tools before celestial-endgame &bprogression&r."]
	quest.55D9819EA5D790BA.quest_subtitle: "Late-game celestial digging tool"
	quest.55E4477DF09C4D63.quest_desc: [
		"&9&lBring&r&r remote sections of your Refined Storage &bsystem&r together with the Network Receiver. It receives the network connection from a Network Transmitter, allowing connected devices to &bcommunicate&r with the main network from a different location."
		""
		"&bUse&r it alongside a Network Transmitter to expand your network and connect &bdistant&r storage and automation systems."
	]
	quest.55E4477DF09C4D63.quest_subtitle: "Connect distant parts of your storage network"
	quest.55E719F937AAA6C3.quest_desc: ["At the highest level of &aprogression&r, these leggings provide exceptional durability and &bprotection&r. They are built to withstand the toughest battles you will face."]
	quest.55E719F937AAA6C3.quest_subtitle: "Peak defense"
	quest.55E719F937AAA6C3.title: "Diamond Netherite Leggings"
	quest.55E87AAB65B4CBBA.quest_desc: [
		"&dElectromancer&r Leggings are part of the Electromancer Armor set in Iron's Spells 'n Spellbooks. When worn, they provide &b+6&r Armor, &b+125&r Max Mana, &b+10%&r Lightning Spell Power and &b+5%&r Spell Power."
		""
		"They can be &bcrafted&r from 7 Arcane Cloth and 1 Lightning Rune, or upgraded from Wizard Leggings with 1 Lightning Rune and 1 Arcane Essence."
	]
	quest.55E87AAB65B4CBBA.quest_subtitle: "Channel the devastating power of Lightning magic through your armor"
	quest.55E9411DDD764F4D.quest_desc: ["&6Process&r Apples with a Mechanical Press to produce Apple Juice. It is one of the fruit juices added by Create: Winery and can be used in the mod's &bwinemaking&r and cider-production processes. Apple Juice was also updated to stand upright when &btransported&r on Create belts."]
	quest.55E9411DDD764F4D.quest_subtitle: "Freshly pressed from apples"
	quest.55F7405278F872FF.quest_desc: ["&dThe&r Signet of the Betrayer grants &b+10%&r Eldritch Spell Power. Its passive ability has a &b5-second&r cooldown and deals additional damage to creatures based on their maximum mana, making it &bespecially&r deadly against powerful spellcasters and mana-rich enemies."]
	quest.55F7405278F872FF.quest_subtitle: "Punish those who wield the power of mana"
	quest.5609B808A0001BBE.quest_desc: ["&6Give&r sweet berries a creamy upgrade. Inject 250 mB of White Chocolate into Sweet Berries to create this delicious treat. Each serving restores &b7&r hunger and &b11.2&r saturation, while &bgranting&r the Rest effect for &b30&r seconds."]
	quest.5609B808A0001BBE.quest_subtitle: "Sweet berries covered in smooth, creamy white chocolate."
	quest.560D1E175323518F.quest_desc: ["&aObtain 5&r Carved Pumpkins. Carved Pumpkins can be &bcreated&r by using Shears on a Pumpkin. They are used to craft Jack o'Lanterns, build Snow Golems and Iron Golems, or worn as a helmet to prevent Endermen from &bbecoming&r hostile when looked at."]
	quest.560D1E175323518F.quest_subtitle: "Prepare for winter"
	quest.560D1E175323518F.title: "&6Carved Pumpkin"
	quest.561582D2F38075E1.quest_subtitle: "Yummy!"
	quest.5627C108FDC37930.quest_desc: ["&aObtain&r a single Copper Ingot. Copper is an essential material for crafting early-game &btools&r, &bmachines&r, and &bcomponents&r."]
	quest.5627C108FDC37930.quest_subtitle: "The Basics of Copper"
	quest.5627C108FDC37930.title: "Copper Collector"
	quest.56591D1CEECED2B2.quest_desc: [
		"&aThe&r Thermal Springstone Boots are protective footwear from Eternal Starlight crafted &busing&r Thermal Springstone Ingots."
		""
		"&aAs&r part of the Thermal Springstone armor set, they ignite attacking enemies and help reduce incoming fire damage, making them effective in &bdangerous&r hot environments."
	]
	quest.56591D1CEECED2B2.quest_subtitle: "Flame-resistant footwear"
	quest.565F5F43CBF7E726.quest_desc: ["&dA&r rare crafting material &bused&r in various recipes for powerful &bequipment&r in Hazen N Stuff."]
	quest.565F5F43CBF7E726.quest_subtitle: "A rare cosmic material for advanced crafting"
	quest.56609D8BB013442F.quest_desc: ["&6Create&r Bordeaux, a refined wine inspired by the famous Bordeaux wine region. In Create: Winery, it can be presented as a premium wine produced through the winery's &bautomated&r processing and maturation system. Bordeaux is renowned for its long winemaking tradition and for wines &bmade&r from blends of different grape varieties."]
	quest.56609D8BB013442F.quest_subtitle: "A classic blend from the vineyards of France"
	quest.5669378A6EF63D6D.quest_desc: ["&dThe&r Six-Shooter is a revolver built for &brapid&r fire. Fan the hammer to unload shots in quick succession; firing 15 shots in one second earns the Fan the Hammer advancement."]
	quest.5669378A6EF63D6D.quest_subtitle: "Fan the hammer"
	quest.566E61618FCA03C5.title: "nah"
	quest.5672EEEB49F6A473.quest_desc: [
		"The Wand of Teleportation is a utility item &aassociated&r with Eternal Starlight, allowing the user to manipulate movement or position within the dimension."
		""
		"Its &aexact&r crafting &bmethod&r or acquisition source is not clearly &bdocumented&r in available public resources and may depend on &bJEI&r recipes, progression unlocks, or modpack-specific configurations."
	]
	quest.5672EEEB49F6A473.quest_subtitle: "Space bending artifact"
	quest.5672EEEB49F6A473.title: "&6 Wand Of Teleportation"
	quest.567423E20434C791.quest_desc: [
		"&6Built&r for both the skies and the seas, the Bamboo Hopper is a chunky three-seat aircraft equipped with pontoons for safe water landings. &bUnlike&r most aircraft, it won't sink when you touch down on water."
		""
		"Take it for a flight, land safely on the waves and &bexplore&r places other aircraft can't reach."
	]
	quest.567423E20434C791.quest_subtitle: "A sturdy aircraft that feels right at home on the water."
	quest.567559DC006F369A.quest_desc: ["&6Welcome&r to Create Crafts \\& Additions! This addon expands Create with an electrical &bsystem&r and new machines that allow you to generate, store and use &belectrical&r energy alongside Create's rotational power. Start by learning the basics of &belectricity&r and gradually connect it with your factory."]
	quest.567559DC006F369A.quest_subtitle: "     Bring electricity into your factory"
	quest.567559DC006F369A.title: "&l&6Create Crafts \\& Additions"
	quest.56767209670F77B3.quest_desc: ["&dThe&r Blackpowder Revolver is a revolver-style sidearm powered by blackpowder. Fill its &bmodifier&r slots to specialise it for the way you fight."]
	quest.56767209670F77B3.quest_subtitle: "Old-school firepower"
	quest.5685C252794B4F3F.quest_desc: [
		"&dWandering&r Magician Pants are part of the basic Wandering Magician Armor set in Iron's Spells 'n Spellbooks. They provide &b+5&r Armor and &b+25&r Max Mana."
		""
		"Craft them by combining Leather Pants with Arcane Essence. They are an excellent &bearly-game&r armor piece for gaining extra &bmana&r while maintaining solid protection."
	]
	quest.5685C252794B4F3F.quest_subtitle: "Carry the arcane power of a wandering mage"
	quest.56867D4FD824C102.quest_desc: [
		"&9&lThe&r&r Grid is your main interface for &binteracting&r with the Refined Storage network. Use it to view, search for and &bmanage&r every item stored within your connected storage system from one convenient location."
		""
		"Connect it to your network and say goodbye to &bsearching&r through countless chests. Everything you &bneed&r is now just a few clicks away."
	]
	quest.56867D4FD824C102.quest_subtitle: "Access your entire digital storage network"
	quest.568C6E2957D5C6D0.quest_desc: ["&6Build&r the Basic Motor, Advanced Motor, and Reinforced Motor to unlock the different &btiers&r of electric-powered rotation in Create: New Age. &bStart&r with a basic motor and work your way up to the &breinforced&r tier for more demanding machinery."]
	quest.568C6E2957D5C6D0.quest_subtitle: "Turn electricity into motion"
	quest.568C6E2957D5C6D0.title: "Motor Progession"
	quest.5691EF52308A9056.quest_desc: [
		"Brew a &aPotion&r of Fire Resistance to protect yourself from lava and fire."
		"This potion is essential for &bexploring&r the Nether safely."
	]
	quest.5691EF52308A9056.quest_subtitle: "Survive the flames"
	quest.5691EF52308A9056.title: "Fire Resistance Potion"
	quest.5692EB467C095DA0.quest_desc: [
		"&dEnergized&r Core is a crafting ingredient in Iron's Spells 'n Spellbooks, &bused&r to create the Rod o' Lightning. It is crafted from 1 Block of Copper and 8 Bottles o' Lightning."
		""
		"During a thunderstorm, use the Energized Core on a placed Lightning Rod to unleash a powerful lightning strike and &btransform&r the rod into the Rod o' Lightning."
	]
	quest.5692EB467C095DA0.quest_subtitle: "Harness the power of lightning"
	quest.569C0FB870AE4CD3.quest_desc: ["&6Welcome&r to Create: Misc \\& Things! This addon brings a collection of useful and fun additions that don't fit into a single theme. Build train &bstation&r speakers, traffic signs, card systems, sticky launchers, neon tubes, a Spout Gun, portable whistles, and more. Explore the extra tools and gadgets and find new ways to &bexpand&r your Create factory."]
	quest.569C0FB870AE4CD3.quest_subtitle: "  Useful, fun, and unexpected additions       "
	quest.569C0FB870AE4CD3.title: "&l&6Welcome Create Things and Misc"
	quest.56A4A9B3950792E1.quest_desc: [
		"&aObtain&r the Handle Attachment Smithing Template, used at a Smithing Table to combine a finished Better End tool head with its handle."
		""
		"It's a required step in assembling &bThallasium&r and &bTerminite&r tier tools and weapons."
	]
	quest.56A4A9B3950792E1.quest_subtitle: "Fitting handle to head"
	quest.56A94C1721F0E1FE.quest_desc: ["&6Craft&r the Posaune pipe and &badd&r a deep, powerful reed voice to your pipe organ. Posaune is one of the &boriginal&r organ stops in Create: Sound of Steam and received a full 5-octave range in version 0.8.0."]
	quest.56A94C1721F0E1FE.quest_subtitle: "Add a powerful brass voice"
	quest.56AEBAFE684B4F56.quest_desc: [
		"The Amaramber Hoe is a &afarming&r tool from Eternal Starlight introduced in version 0.4.2 as &bpart&r of the Amaramber equipment set."
		""
		"&aIt&r is &bused&r for preparing farmland and is part of early progression in the Starlight dimension."
	]
	quest.56AEBAFE684B4F56.quest_subtitle: "Amber farming tool"
	quest.56DDD6F89F2F8C3C.quest_subtitle: "More Armor"
	quest.56F1D6936CE849A0.quest_desc: ["&6Fill&r a Caramel Bar, Chocolate Bar or Dark Chocolate Bar with 250 mB of White Chocolate to create this creamy treat. Each candy &brestores&r 8 hunger and 11 saturation, while the white chocolate grants the Rest effect for 30 seconds."]
	quest.56F1D6936CE849A0.quest_subtitle: "A sweet little treat filled with smooth white chocolate."
	quest.56F5E38FDD172F6E.quest_desc: [
		"&dElectromancer&r Leggings are the Crystal Chronicles upgraded version of the Electromancer Leggings from Iron’s Spells ’n Spellbooks."
		""
		"They are upgraded using a Voltite Shard, which &benhances&r the original Electromancer Armor set with &badditional&r crystalline power. The Voltite Shard channels the power of Lightning magic, creating a stronger version of the original Electromancer equipment."
	]
	quest.56F5E38FDD172F6E.quest_subtitle: "An enhanced form of Electromancer Leggings, empowered by Voltite"
	quest.56F65FC29596EE7B.quest_desc: [
		"&aObtain&r the Amber Gem, crafted or found within Better End, most commonly gathered from &aAmber Ore&r in the Amber Land."
		""
		"Its main use lies in &bInfusion Rituals&r, though it can also be used to craft Eyes of Ender and decorative Amber Blocks."
	]
	quest.56F65FC29596EE7B.quest_subtitle: "A gem for the ritual"
	quest.56F6AC7979412477.quest_subtitle: "Yummy!"
	quest.56FD0D6D5CC0687D.quest_desc: ["&eA&r mysterious item from Simply Swords that can transform into unique weapons. Its &btransformation&r depends on the conditions and blocks involved, making it a valuable way to obtain powerful and &brare&r weapons."]
	quest.56FD0D6D5CC0687D.quest_subtitle: "A mysterious remnant containing the power of unique weapons"
	quest.571C4996415BE05B.quest_desc: ["&aEcho's&r Grace is a powerful item tied to the legacy of the ancient &binhabitants&r of the Ancient Keep. Claim its power and take another step &bforward&r on your journey through the remnants of the Ancients."]
	quest.571C4996415BE05B.quest_subtitle: "Legacy of the Fallen"
	quest.57333A2DDBD5C1F0.quest_subtitle: "More Armor"
	quest.573AC6B4F6A39CD2.quest_desc: ["&dWeapon&r Parts are a &bRare&r crafting material in Iron's Spells 'n Spellbooks. They are crafted from 3 Mithril Ingots and 2 Arcane Ingots and are used to craft &bpowerful&r magical weapons such as the Spellbreaker and Amethyst Rapier."]
	quest.573AC6B4F6A39CD2.quest_subtitle: "Forge the components of powerful magical weapons"
	quest.57424654EF8928B0.quest_desc: [
		"The Crystalite Leggings are created through an Infusion Ritual — Terminite Leggings, an Amber Gem, and Crystal Shards placed around an &aInfusion Pedestal&r."
		""
		"Wearing them grants an extra 2 hearts of &bmax health&r, on top of solid armor and toughness."
	]
	quest.57424654EF8928B0.quest_subtitle: "Leggings born from infusion"
	quest.57424654EF8928B0.title: "&dCrystalite Leggings"
	quest.57490E7B7125796F.quest_desc: ["&6Craft&r a Redstone Magnet by combining magnetite with Redstone. This stronger magnetic component is an important &bstep&r in the progression of Create: New Age, paving the way toward more &badvanced&r magnetic and electrical technology."]
	quest.57490E7B7125796F.quest_subtitle: "Give your magnets some power"
	quest.574BDD4179393D11.quest_desc: ["&aCraft&r a Neptunium Sword from Aquaculture 2. This powerful weapon is made from Neptunium, a rare &bmaterial&r obtained from fishing treasures. It is a durable and strong &bweapon&r that completes the Neptunium &bequipment&r set."]
	quest.574BDD4179393D11.quest_subtitle: "A blade forged from ocean treasures"
	quest.5767713EB40F707E.quest_subtitle: "Upgrade+"
	quest.578EB7E4CF7E3785.quest_desc: ["&6Process&r grapes with Create's machinery to produce Grape Juice, a key ingredient in the winemaking process. Use it as a base for &bproducing&r wine in the Wine Cellar, alongside the other ingredients &badded&r by Create: Winery."]
	quest.578EB7E4CF7E3785.quest_subtitle: "Freshly pressed and ready to ferment"
	quest.578FF9E18EF476F4.quest_subtitle: "More Armor"
	quest.57A5F443FB751E17.quest_subtitle: "More Armor"
	quest.57AE51A8BFF87D10.quest_desc: [
		"The Thallasium Helmet is crafted from Thallasium Plating at a Smithing Table."
		""
		"It's the entry point of Better End's &aarmor&r progression, offering more protection than iron."
	]
	quest.57AE51A8BFF87D10.quest_subtitle: "Headgear of the first tier"
	quest.57BFB10B88DC5500.quest_desc: [
		"&aThe Eye of Ender&r is crafted from Ender Pearls and Blaze Powder."
		"When thrown, it floats through the air and leads you toward a Stronghold — the hidden structure that contains the End Portal."
		"It is a crucial item for reaching the End dimension and facing the &bEnder Dragon&r."
	]
	quest.57BFB10B88DC5500.quest_subtitle: "Guide to the Stronghold(fake XD)"
	quest.57BFB10B88DC5500.title: "Eye of Ender"
	quest.57C7FEC533FD8170.quest_desc: ["&6Craft&r the Subbass pipe and add a deep, &bpowerful&r bass voice to your pipe organ. Subbass is one of the original pipe types in Create: Sound of Steam and is a &breed&r pipe. In version 0.8, it received the full &b5-octave&r range and is crafted through sequenced assembly."]
	quest.57C7FEC533FD8170.quest_subtitle: "Bring the deep tones to your organ"
	quest.57D98CCC6D30EAFE.quest_desc: [
		"The Amaramber Sword is a &aweapon&r from Eternal Starlight introduced in version 0.4.2 alongside &bother&r Amaramber tools."
		""
		"Amaramber &aequipment&r is connected to fiery effects and materials gathered from Torreya &btrees&r within the Starlight dimension."
	]
	quest.57D98CCC6D30EAFE.quest_subtitle: "Burning amber blade"
	quest.57DE931DE3C664AF.quest_desc: ["&6Obtain&r a Netherite Backtank from Create. It is the &bupgraded&r version of the Copper Backtank and stores &bcompressed&r air for use with the Diving Helmet, Extendo Grip and Potato Cannon. It can be filled by supplying rotational force to the tank. The Netherite version provides stronger protection and is &bresistant&r to fire and lava."]
	quest.57DE931DE3C664AF.quest_subtitle: "Carry the power to breathe anywhere"
	quest.57E1677E487D619A.quest_subtitle: "More Armor"
	quest.57FCD72ED4193436.quest_desc: [
		"&dVenomous&r Crusader Leggings are the Crystal Chronicles upgraded version of Plagued Leggings from Iron’s Spells ’n Spellbooks."
		""
		"They are &bupgraded&r using a Floralite Shard, transforming the original Plagued Armor into the powerful Venomous Crusader Armor set. The Floralite Shard &binfuses&r the armor with the power of Nature magic, strengthening its poisonous and &bplague-based&r abilities."
	]
	quest.57FCD72ED4193436.quest_subtitle: "An enhanced form of Plagued Leggings empowered by Floralite"
	quest.58044C7D45BE5862.quest_desc: ["&6The&r base of a transformer, on which you build windings."]
	quest.58044C7D45BE5862.quest_subtitle: "The transformer core"
	quest.5805A83D3AF0EE1E.quest_desc: [
		"&eDarkness&r is no longer something to fear. These goggles &bgrant&r the wearer night vision, making even the darkest caves and tunnels easy to navigate."
		""
		"Put &bthem&r on and let the darkness reveal itself."
	]
	quest.5805A83D3AF0EE1E.quest_subtitle: "See what hides in the darkness"
	quest.58070E79D47823BA.quest_desc: ["&6Obtain&r a Spout from Create. It can hold up to 1 bucket of fluid and &bdispense&r that fluid onto compatible items &bpassing&r underneath it on a Belt or Depot. This allows you to automate fluid-based crafting and filling recipes, such as &bmaking&r Blaze Cakes and other fluid-filled items."]
	quest.58070E79D47823BA.quest_subtitle: "Let the fluids shape your creations"
	quest.580D277648F9D193.quest_desc: ["&aLocate&r a Trial Chamber hidden deep beneath the Overworld. Built &bfrom&r tuff and copper, these ancient &bunderground&r halls are filled with deadly traps, Trial Spawners, Vaults, and powerful enemies awaiting anyone brave enough to enter. A Journeyman Cartographer can sell a Trial &bExplorer&r Map leading to the nearest chamber."]
	quest.580D277648F9D193.quest_subtitle: "Seek the proving grounds of forgotten warriors"
	quest.580D277648F9D193.title: "Trial Chambers"
	quest.580E7DE57206B9CC.quest_desc: ["&6The&r Zinc Helmet is part of the Zinc Suit from Create Stuff 'N Additions. It provides an &balternative&r set of armor made from Zinc, giving you another way to turn Create's resources into useful equipment. The helmet has &b220&r durability and is crafted from &b5&r Zinc Ingots."]
	quest.580E7DE57206B9CC.quest_subtitle: "A lighter layer of protection"
	quest.582F0AA40622C858.quest_desc: ["&aEcho's&r Grace is one of Archaion's key items, tied to the &blegacy&r of the Ancients. Obtain it and harness its power to continue your journey through the Ancient Keep and &buncover&r the secrets left behind by the &bancient&r civilization."]
	quest.582F0AA40622C858.quest_subtitle: "Grace of the Echo"
	quest.582F0AA40622C858.title: "&bEcho's Grace"
	quest.5855A31B7C59BC54.quest_desc: ["&6The&r Industrial Casing is a sturdy construction component from Create: Dreams n' Desires. Designed for &badvanced&r machinery and larger mechanical systems, it provides the industrial foundation &bneeded&r for more demanding factory builds."]
	quest.5855A31B7C59BC54.quest_subtitle: "Built for serious machinery"
	quest.5855AC82EE35329E.quest_desc: ["&6Obtain&r a Mechanical Pump from Create. It is a key component of the fluid &blogistics&r system, using &brotational&r power to push and pull fluids through connected Fluid Pipes. The pump can move fluids through a pipe network over a distance of up to &b15&r blocks before another pump is needed. Its pumping &bdirection&r can be changed with a Wrench."]
	quest.5855AC82EE35329E.quest_subtitle: "Make the fluids flow"
	quest.585E81760D56ED15.quest_subtitle: "More Weapon"
	quest.58707B7EB3185422.quest_subtitle: "Upgrade+"
	quest.5878011164766C2F.quest_desc: [
		"&aUpgrade&r your armor to a full Netherite set using Netherite Ingots and Smithing Templates."
		"This is the &astrongest&r armor available and will greatly&b improve&r your survivability."
	]
	quest.5878011164766C2F.quest_subtitle: "Ultimate protection"
	quest.5878011164766C2F.title: "Netherite Set"
	quest.587A4A7644A43502.quest_desc: ["&6Obtain&r a Copper Valve Handle from Create. It is a player-powered source of rotational force that lets you control the angle and direction of &brotation&r precisely. By default, each activation rotates it by &b45°,&r and its rotation can be configured to a &bdifferent&r angle. It produces &b32&r RPM and &b256&r SU."]
	quest.587A4A7644A43502.quest_subtitle: "Take precise control of rotation"
	quest.58850A645FBACBFE.quest_desc: ["&6Suspicious&r Rock is an aquatic resource added in Create: Aquatic Ambitions 2.0. It is part of the mod's new recipes and production chain, alongside Calcium Rich Powder and Spiky Shells. Discover and &bprocess&r this mysterious rock to &bunlock&r more of the ocean-themed progression."]
	quest.58850A645FBACBFE.quest_subtitle: "Something ancient lies within"
	quest.588AA795568CAA8B.quest_subtitle: "More Armor"
	quest.588BBD3F66AA2081.quest_desc: ["&bUse&r copper ingots and amethyst shards to craft a spyglass. It lets you zoom in and see distant places clearly."]
	quest.588BBD3F66AA2081.quest_subtitle: "Craft a Spyglass"
	quest.588BBD3F66AA2081.title: "Spyglass"
	quest.58CB5865C71C7CE9.quest_desc: [
		"&9&lThe&r&r Machine Casing is a fundamental component used to construct &badvanced&r Refined Storage machines and devices. It forms the framework that brings together the components needed for more complex automation."
		""
		"Craft one and &bprepare&r yourself for the next stage of your Refined Storage network."
	]
	quest.58CB5865C71C7CE9.quest_subtitle: "Build the foundation of advanced automation"
	quest.58DEB5354E203161.title: "..."
	quest.58EF3CB34B796886.quest_desc: [
		"&dWandering&r Magician Shoes are part of the basic Wandering Magician Armor set in Iron's Spells 'n Spellbooks. They provide &b+2&r Armor and &b+25&r Max Mana."
		""
		"They can be &bcrafted&r by combining Leather Boots with Arcane Essence, making them an accessible early-game piece of magical equipment."
	]
	quest.58EF3CB34B796886.quest_subtitle: "Begin your journey as a wandering spellcaster"
	quest.5909CFBF3019F400.quest_desc: ["A strong and dependable &aupgrade&r, this chestplate combines the durability of Netherite with the stability of iron. It offers solid &bprotection&r for long journeys and dangerous encounters."]
	quest.5909CFBF3019F400.quest_subtitle: "Reliable defense"
	quest.5909CFBF3019F400.title: "Iron Netherite Chestplate"
	quest.590BB110A333BB00.quest_desc: ["&dIcicle&r Crusher is a weapon from Crystal Chronicles, &bassociated&r with the enhanced Cryomancer equipment. It channels the power of Ice magic and the crystalline strength of Cryolite, making it a formidable weapon for &bfreezing&r and crushing enemies."]
	quest.590BB110A333BB00.quest_subtitle: "A devastating weapon forged from the freezing power of Cryolite"
	quest.591378335B70C02C.quest_desc: [
		"&aCraft&r the Phantom Chestplate from the &blegendary&r remains of the Knight Phantoms. Once worn by the spectral champions guarding the Goblin Stronghold, this enchanted armor still resonates with the &bunwavering&r resolve of warriors who refused to abandon their duty, even after death."
		""
		"&aAs&r the centerpiece of the Phantom Armor set, the chestplate offers outstanding &bprotection&r and symbolizes your victory over one of the Twilight Forest's most demanding encounters. Its ghostly craftsmanship makes it a prized possession for any &bseasoned&r adventurer."
	]
	quest.591378335B70C02C.quest_subtitle: "Armor worn by the spectral champions"
	quest.591E0B9694CC8ACF.quest_desc: ["&6Process&r Red Grapes with a Mechanical Press to obtain Red Grape Pomace. This is one of the by-products used in Create: Winery and forms &bpart&r of the automated winemaking process."]
	quest.591E0B9694CC8ACF.quest_subtitle: "Put your pressed grapes to good use"
	quest.592697AEA0303633.quest_desc: [
		"At the entrance to a mysterious dimension, a powerful guardian stands watch — &aThe Gatekeeper&r."
		"This entity protects access to the world of &bEternal Starlight&r, allowing only those strong enough to pass."
		""
		"Upon defeat, it drops a special &blootbag&r containing a crucial item such as the Orb of Prophecy, which is required to activate the portal."
		""
		"Without defeating the Gatekeeper, the path forward remains&b sealed&r."
	]
	quest.592697AEA0303633.quest_subtitle: "The path must be earned"
	quest.592697AEA0303633.title: "&bFirst Steps &9In Starlight"
	quest.5941E926825E0C69.quest_desc: [
		"Durability can limit how long you can build before repairing your tools."
		"The Unbreakable Template allows your Construction Stick to work without losing durability."
		""
		"With this upgrade, you can build for much longer without worrying about your tool breaking."
	]
	quest.5941E926825E0C69.quest_subtitle: "Tools That Never Break"
	quest.59442C166C65590F.title: "Nice"
	quest.594BD90AB78AB09B.quest_desc: ["&dGives&r your bullets a &bseeking&r pull, so they curve toward targets and are easier to land."]
	quest.594BD90AB78AB09B.quest_subtitle: "Bullets that find their mark"
	quest.5968131D1B6EC6FE.quest_desc: [
		"&dElectromancer&r Hat is the headpiece of the Electromancer Armor set in Iron's Spells 'n Spellbooks. When worn, it provides &b+3&r Armor, &b+125&r Max Mana, &b+10%&r Lightning Spell Power and &b+5%&r Spell Power."
		""
		"It can be &bcrafted&r from 5 Arcane Cloth and 1 Lightning Rune, or upgraded from Wizard Helmet with 1 Lightning Rune at a Smithing Table in supported versions."
	]
	quest.5968131D1B6EC6FE.quest_subtitle: "Master the devastating power of Lightning magic"
	quest.59697E8A236AE5E8.quest_desc: ["&6The&r most basic part of a generator: it makes &belectricity&r when spinning in the stator's magnetic field. You can extend the assembly by placing more rotors."]
	quest.59697E8A236AE5E8.quest_subtitle: "A spinning rotor"
	quest.5977D9C4172608DA.quest_desc: ["&aObtain&r the Bulwark of the Flame from the Cataclysm mod. This &blegendary&r shield is imbued with the power of Ignis, &ballowing&r its bearer to withstand devastating attacks while wielding the fury of the Nether. It stands as one of the &bgreatest&r relics forged in the Burning Arena."]
	quest.5977D9C4172608DA.quest_subtitle: "Stand unshaken before the inferno"
	quest.5977D9C4172608DA.title: "&cBulwark Of The Flame"
	quest.59A34CCE1A0539F9.quest_desc: ["&aCraft&r the Cursium Mage Breastplate and Winged Mage Breastplate from the Cataclysm: Spellbooks addon. &bInfused&r with the dark power of Cursium, these enchanted robes grant &bexceptional&r magical prowess while embodying the legacy of the cursed rulers who once commanded forbidden sorcery. The Winged Mage Breastplate represents the ultimate evolution of this &blegendary&r attire."]
	quest.59A34CCE1A0539F9.quest_subtitle: "Wear the robes of the cursed archmage"
	quest.59E8835D4066EC44.quest_desc: [
		"Malarite is a &abasic&r progression &bmaterial&r in Eternal Starlight found in swamp-like biomes."
		""
		"&aIt&r is used to craft early-game tools and weapons, forming the foundation of the mod’s &bprogression&r system."
	]
	quest.59E8835D4066EC44.quest_subtitle: "Swamp ore material"
	quest.59EDE9FFD9AC8195.quest_desc: [
		"&l&9Make&r&r your storage more efficient with the &bCompression&r Upgrade. It automatically compresses &bcompatible&r items into their compact forms, reducing the amount of storage space they require."
		""
		"&bPerfect&r for materials that quickly fill your containers, this upgrade keeps your storage organized while making better use of every available slot."
	]
	quest.59EDE9FFD9AC8195.quest_subtitle: "Turn excess materials into compact storage"
	quest.59F46A0A7AF23B02.quest_subtitle: "Yummy!"
	quest.59FE206DA8C33112.quest_desc: ["&aObtain&r a Coral Chunk from the Cataclysm mod. This &bmaterial&r is dropped by Coralssus and can be used for crafting items related to the ocean &bcontent&r of the mod."]
	quest.59FE206DA8C33112.quest_subtitle: "A piece of the coral depths"
	quest.5A0F1E0A29C82609.quest_desc: ["&aThis&r smithing template is associated with the Echo Mace. Obtain it to use it in the further crafting or &bupgrading&r process related to the Echo Mace."]
	quest.5A0F1E0A29C82609.quest_subtitle: "Obtain the Echo Mace Smithing Template"
	quest.5A216B4751249E91.quest_desc: ["&dPoisonfang&r is a weapon from Crystal Chronicles, associated with the Venomous Crusader equipment line. It &bchannels&r the power of Nature magic and the toxic energy of Floralite, &bmaking&r it a deadly &bchoice&r for those who wield poisonous magic."]
	quest.5A216B4751249E91.quest_subtitle: "A venomous weapon infused with the power of Nature"
	quest.5A408D048C70443B.quest_desc: ["&dYour&r bullets &bfreeze&r targets and burst into frozen &bshrapnel&r on hit."]
	quest.5A408D048C70443B.quest_subtitle: "Cold-blooded"
	quest.5A47265BA18F0E83.quest_desc: [
		"&9&lKeep&r&r your Refined Storage network secure with the Security Manager. It allows you to manage access to your network and control who can &binteract&r with your storage system."
		""
		"&bSet&r up security cards and permissions to protect your &bvaluable&r resources and keep unwanted users from accessing your network."
	]
	quest.5A47265BA18F0E83.quest_subtitle: "Protect your digital storage network"
	quest.5A473C2FDB2DD8B3.quest_desc: ["&6Craft&r the Caramel Bucket and Chocolate Bucket to transport liquid ingredients for your confectionery factory. &bUse&r them with Create's fluid systems to move caramel and chocolate between different stages of production. Create: Confectionery &badds&r caramel as well as black, white, and ruby chocolate to Create."]
	quest.5A473C2FDB2DD8B3.quest_subtitle: "Store the sweetest liquids"
	quest.5A473C2FDB2DD8B3.title: "Caramel Bucket \\& Chocolate Bucket"
	quest.5A5A487004ECA799.quest_subtitle: "Yummy!"
	quest.5A5B60BA157A17C8.quest_subtitle: "Upgrade+"
	quest.5A5C3C67CC12A21C.quest_subtitle: "Upgrade+"
	quest.5A7F96B24A411ECB.quest_desc: ["&dA&r special &baccessory&r that provides the wearer with harmonious magical power."]
	quest.5A7F96B24A411ECB.quest_subtitle: "A pendant that brings balance and harmony"
	quest.5A82A4E0A825BEFB.quest_desc: ["&dMakes&r bullets &bricochet&r off blocks, so you can hit enemies around corners. Kill something with a ricochet to earn Bank Shot."]
	quest.5A82A4E0A825BEFB.quest_subtitle: "Bank shots"
	quest.5A9C3BC0BE9975E4.quest_subtitle: "More Armor"
	quest.5AA26BFC94370303.quest_desc: ["&6Six&r White Chocolate Bars wrapped in paper make a proper Full White Chocolate Bar. It can be enjoyed up to 16 times, making it a &bconvenient&r and delicious treat. Each bite also provides the Rest effect."]
	quest.5AA26BFC94370303.quest_subtitle: "A smooth white chocolate bar made for more than one bite."
	quest.5AA62330741CAD92.quest_desc: [
		"The Terminite Chestplate is crafted from Terminite Plating at a Smithing Table."
		""
		"It serves as the base for upgrading into &bCrystalite&r or &bAeternium&r armor later on."
	]
	quest.5AA62330741CAD92.quest_subtitle: "Chestplate of the second tier"
	quest.5AA7A876F9E5EB5D.quest_desc: ["&aCraft&r the Dragon Bones Boots from the Bosses' Rise mod. &bForged&r from the bones of ancient dragons, these &blegendary&r boots provide exceptional protection and complete the Dragon Bones Armor set. They &bcarry&r the resilience of the creatures that once ruled the skies."]
	quest.5AA7A876F9E5EB5D.quest_subtitle: "Walk with the power of the ancient beasts"
	quest.5AACD9C11C399A36.quest_desc: ["&6The&r base of the carbon pile: place Blocks of Coal on top of it to assemble a Carbon Pile."]
	quest.5AACD9C11C399A36.quest_subtitle: "The pile's coil"
	quest.5AB7DAC0DEF2D1BE.quest_desc: ["&6The&r Conduit Cage is an advanced block from Create: Aquatic Ambitions that provides a more compact way to set up Conduit Channeling. It can also &bapply&r or remove effects from nearby players and mobs, &bdepending&r on the fluid or effect being used. In newer versions, it supports &badditional&r fluids such as Lava, Honey and Chocolate."]
	quest.5AB7DAC0DEF2D1BE.quest_subtitle: "Control the power of the Conduit"
	quest.5AC37ACA354D5843.quest_desc: ["&6Copper&r Boots are part of the Copper Suit from Create Stuff 'N Additions. They provide &b2&r armor points and 1 armor toughness, giving the same protection as Iron Boots while having higher durability. They have &b195&r durability and can be &brepaired&r with Honeycombs in an Anvil. The boots are crafted from &b4&r Copper Ingots."]
	quest.5AC37ACA354D5843.quest_subtitle: "Keep your feet protected"
	quest.5ACD097A25B0C50D.quest_desc: [
		"&aNether Wart&r is a vital resource found in Nether Fortresses."
		"It is the key ingredient for brewing most potions, starting with Awkward Potions. Without it, advanced alchemy is impossible."
		"Harvest it carefully and bring it back to your base to begin your brewing&b progress&r."
	]
	quest.5ACD097A25B0C50D.quest_subtitle: "Foundation of alchemy"
	quest.5ACD097A25B0C50D.title: "&cNether Wart"
	quest.5ADBF1BE660F348B.quest_desc: [
		"&aThe&r Glacite Chestplate is a cold-resistant armor piece from Eternal Starlight crafted &busing&r Glacite materials."
		""
		"Glacite armor slows attacking &aenemies&r with icy effects and improves &bsurvival&r in freezing environments."
	]
	quest.5ADBF1BE660F348B.quest_subtitle: "Frozen body armor"
	quest.5AE2EC9A70E5A140.quest_desc: [
		"&aObtain&r the Plate Upgrade Smithing Template, used at a Smithing Table to turn a &bForged Plate&r into a finished piece of Better End armor."
		""
		"Every Thallasium, Terminite, and Aeternium armor piece passes through this &bstep&r before it can be worn."
	]
	quest.5AE2EC9A70E5A140.quest_subtitle: "Turning plates into armor"
	quest.5AEA1A3CFBEA20D4.quest_subtitle: "More Armor"
	quest.5AFA9C63C5BFCE24.quest_subtitle: "More Armor"
	quest.5B05B9AC26B26B50.quest_desc: [
		"&aCraft&r the Steeleaf Boots using the &benchanted&r Steeleaf material found throughout the Twilight Forest. Strengthened by the forest's ancient magic, these boots provide reliable protection while remaining &blight&r enough for long journeys across dense forests, towering hills, and forgotten ruins."
		""
		"&aAs&r the final piece of the Steeleaf Armor set, they &bcomplete&r a dependable armor collection that will accompany you through the early &bstages&r of your Twilight Forest adventure."
	]
	quest.5B05B9AC26B26B50.quest_subtitle: "Walk the forest with confidence"
	quest.5B19160165B5E883.quest_subtitle: "More Armor"
	quest.5B27717ACCFE4A1C.quest_desc: ["&6Obtain&r Powdered Obsidian from Create. It is a special material used in more &badvanced&r Create crafting and processing."]
	quest.5B27717ACCFE4A1C.quest_subtitle: "Turn obsidian into something extraordinary"
	quest.5B3BD9C0124BD4F6.quest_desc: ["&6The&r Portable Energy Interface is an electrical component from Create Crafts \\& Additions used to transfer Forge Energy to and from moving Create contraptions. It allows a &bcontraption&r to connect to an &bexternal&r power network when the interfaces meet, making it ideal for electrically &bpowered&r trains and other moving machines."]
	quest.5B3BD9C0124BD4F6.quest_subtitle: "Bring power to moving contraptions"
	quest.5B3C917C779AC15A.quest_subtitle: "More Armor"
	quest.5B3F6ED494A819BA.quest_subtitle: "More Armor"
	quest.5B4AB17DADF25E18.quest_desc: [
		"&aEnder Pearls&r are mysterious items dropped by Endermen, creatures that wander between dimensions."
		"They are used for teleportation and are essential for reaching strongholds and eventually the End dimension."
		"Handle them &acarefully&r — using them incorrectly can cause &bfall damage&r or &bdangerous situations&r."
	]
	quest.5B4AB17DADF25E18.quest_subtitle: "Void-touched essence"
	quest.5B4AB17DADF25E18.title: "Ender Pearl"
	quest.5B6598F86409092E.quest_subtitle: "Yummy!"
	quest.5B835BD694026514.quest_desc: ["&6Craft&r the Fan Washing Catalyst and use it with an Encased Fan to &bperform&r bulk washing. It provides the washing &beffect&r without requiring a water source directly in front of the fan, making automated processing setups more compact. Create: Connected added Fan Washing Catalyst as one of its original &bfan-catalyst&r variants."]
	quest.5B835BD694026514.quest_subtitle: "Wash with a powerful stream of air"
	quest.5B87365C08C8CF57.quest_subtitle: "Upgrade+"
	quest.5B8F07E4708A1624.quest_desc: [
		"&9&lBring&r&r hopper functionality directly to your storage with the Hopper Upgrade. It allows your storage to &bautomatically&r insert and extract items, making it easier to connect containers and build automated &bitem-processing&r systems."
		""
		"The Advanced Hopper &bUpgrade&r provides greater control over item movement, allowing you to configure the direction and behavior of item transfers and work with &bmore&r complex storage automation."
	]
	quest.5B8F07E4708A1624.quest_subtitle: "Automate the flow of items through your storage"
	quest.5B8F07E4708A1624.title: "Hopper \\& Advanced Hopper Upgrade"
	quest.5BB761680A0E7A17.quest_desc: [
		"&dCryomancer&r Leggings are the Crystal Chronicles &bupgraded&r version of the Cryomancer Leggings from Iron’s Spells ’n Spellbooks."
		""
		"They are upgraded using a Cryolite Shard, which &benhances&r the original Cryomancer Armor set with additional crystalline power. The Cryolite Shard strengthens the equipment with the power of Ice magic, &bcreating&r an improved version of the original Cryomancer gear."
	]
	quest.5BB761680A0E7A17.quest_subtitle: "An enhanced form of Cryomancer Leggings, empowered by Cryolite"
	quest.5BD797DA1D2A7A9A.quest_subtitle: "Yummy!"
	quest.5BD9D1C1FC98C0BB.quest_subtitle: "More Armor"
	quest.5C00F1DF6D6FECF7.quest_desc: [
		"Lapis Lazuli is a &akey resource&r for enchanting your gear. Collect it to unlock the secrets ofare it carefully—its deep blue glow holds power for those who know how to use it."
		""
		"Bring some back and get ready to upgrade your &bweapons&r and &barmor&r."
	]
	quest.5C00F1DF6D6FECF7.quest_subtitle: "The Magical Stone"
	quest.5C00F1DF6D6FECF7.title: "Lapis Discovery"
	quest.5C04CC8F94D991CC.title: "@#$@$@"
	quest.5C0D6AE03AF04316.quest_desc: [
		"The Thallasium Pickaxe is a &amining&r tool forged from Thallasium Ingots using a Smith Hammer and Anvil."
		""
		"It's the entry point of Better End's tool progression, sitting above iron but below &bTerminite&r and &bAeternium&r."
	]
	quest.5C0D6AE03AF04316.quest_subtitle: "Mining tool of the first tier"
	quest.5C0FBC7EA0225092.quest_desc: [
		"&aThe&r Starfire Crossbow is a late-game ranged weapon from Eternal Starlight, belonging to the Starfire &bequipment&r tier."
		""
		"&aIt&r is designed for powerful ranged combat and is part of the advanced weapon set &bintroduced&r in the mod."
	]
	quest.5C0FBC7EA0225092.quest_subtitle: "Starlight ranged weapon"
	quest.5C11189FA69E30E9.quest_subtitle: "Upgrade+"
	quest.5C191BDEF5446D95.quest_subtitle: "Yummy!"
	quest.5C4B89BF93162426.quest_desc: ["&aDefeat&r Clawdian, a powerful mini-boss found within the Acropolis in L_Ender’s Cataclysm. Clawdian is a massive &bcrustacean&r warrior wielding a huge claw and guarding the ancient stronghold. Overcome its powerful attacks and &bclaim&r victory over one of the Acropolis' most dangerous guardians."]
	quest.5C4B89BF93162426.quest_subtitle: "Defeat the guardian of the Acropolis"
	quest.5C4B89BF93162426.title: "&cClawdian"
	quest.5C59481363324F17.quest_desc: [
		"&aThe&r Aethersent Cape is a mystical chest armor piece from Eternal Starlight crafted &busing&r Aethersent Ingots."
		""
		"&aIt&r belongs to the Aethersent progression associated with meteors and celestial &bmaterials&r found within the Starlight dimension."
	]
	quest.5C59481363324F17.quest_subtitle: "Celestial mystic armor"
	quest.5C78815176F253DA.title: "why"
	quest.5C859B9C308A2262.quest_desc: ["&aObtain&r the Infernal Forge from the Cataclysm mod. &bDropped&r by the mighty Netherite Monstrosity, this legendary weapon also functions as an unbreakable Netherite-tier pickaxe. By striking the ground, it unleashes a &bdevastating&r shockwave that knocks back enemies, shatters shields, and ignites nearby foes when its wielder is &bgravely&r wounde"]
	quest.5C859B9C308A2262.quest_subtitle: "Harness the fury of the Netherite Monstrosity"
	quest.5C859B9C308A2262.title: "&cInfernal Forge"
	quest.5C87FE353318F034.quest_desc: [
		"&dFire&r Upgrade Orb is an upgrade material in Iron's Spells 'n Spellbooks. When applied at the Arcane Anvil, it grants &b+5%&r Fire Spell Power."
		""
		"It is &bcrafted&r from 1 Empty Upgrade Orb and 8 Fire Runes. An applicable item can normally receive up to 3 upgrades."
	]
	quest.5C87FE353318F034.quest_subtitle: "Infuse your equipment with the power of Fire magic"
	quest.5C92BD84F58E0D9C.quest_desc: ["&dAdds&r &bleeching&r shots: they cost some of your &bhealth&r to fire, but deal bonus damage. Use them carefully."]
	quest.5C92BD84F58E0D9C.quest_subtitle: "Pay in blood"
	quest.5C92BECD1EED0AC4.quest_subtitle: "More Armor"
	quest.5C94947847B0880F.quest_desc: ["&eThe&r Capture Net allows you to catch animals and move them to &banother&r location. It is a useful tool for &bsafely&r relocating the inhabitants of the Naturalist world."]
	quest.5C94947847B0880F.quest_subtitle: "Capture a Wild Animal"
	quest.5C94947847B0880F.title: "&eCapture Net"
	quest.5C97748C4B702898.quest_desc: [
		"&aDeep&r beneath the Twilight Forest lies a sprawling &bunderground&r Labyrinth, home to one of its most formidable guardians—the Minoshroom. A fearsome fusion of a mighty &bminotaur&r and a massive mushroom, this beast has claimed the heart of the maze as its domain, crushing any &badventurer&r who dares to challenge it."
		""
		"&aFinding&r the Minoshroom is no easy task. You must first &bnavigate&r the twisting corridors of the Labyrinth, overcome its deadly traps, and survive the &bmonsters&r lurking within. Only then will you &bearn&r the chance to face the beast in its arena."
		""
		"&aDefeating&r the Minoshroom is a major milestone in your Twilight Forest adventure, rewarding you with &bvaluable&r loot and opening the path toward even greater challenges."
	]
	quest.5C97748C4B702898.quest_subtitle: "Conquer the guardian of the Labyrinth"
	quest.5C97748C4B702898.title: "&cMinoshroom"
	quest.5C99B6FEDC36090D.quest_desc: [
		"&6Every&r aircraft needs a reliable source of power. The Boiler turns fuel into the energy your machine needs to &bkeep&r its engine running and carry you through the skies."
		""
		"Build a Boiler, fuel your aircraft and get &bready&r for takeoff."
	]
	quest.5C99B6FEDC36090D.quest_subtitle: "The power source that keeps your aircraft moving."
	quest.5CA65A5C75C63568.quest_desc: ["&6Welcome&r to Create: Winery! &bGrow&r red and white grapes, process them with Create's machinery, and turn them into red wine, white wine, rosé, and cider. Build the fully automatable Wine Cellar and discover &bnew&r recipes and &binteractions&r between Create's mechanical systems and winemaking."]
	quest.5CA65A5C75C63568.quest_subtitle: "Build your own automated winery"
	quest.5CA65A5C75C63568.title: "&l&6Welcome Create Winery"
	quest.5CB2580A05B6ED7D.quest_desc: ["&aCraft&r the Cursium Mage Circlet from the Cataclysm: Spellbooks addon. Forged with the power of Cursium, this enchanted circlet is worn by &bmasters&r of dark magic, strengthening their &bspellcasting&r and serving as the centerpiece of the Cursium Mage armor set."]
	quest.5CB2580A05B6ED7D.quest_subtitle: "A crown infused with cursed sorcery"
	quest.5CB679CBBD78B0E7.quest_desc: ["&6The&r Blazing Pickaxe is a fiery tool from Create Stuff 'N Additions. It has 450 &bdurability&r and an Obsidian mining level, allowing it to mine Obsidian and Ancient Debris. Blocks that can be smelted are &bautomatically&r smelted when mined, although this means the tool does not benefit from Fortune. It also sets attacked mobs on fire."]
	quest.5CB679CBBD78B0E7.quest_subtitle: "Mine with the heat of the Nether"
	quest.5CBE694E060BB1B9.quest_desc: ["&6The&r Redstone Relay is an electrical component from Create Crafts \\& Additions that allows you to control the flow of electrical energy &busing&r a Redstone signal. It can be integrated into your electrical network to switch power on or off, making it useful for automated factories and &bRedstone-controlled&r machines."]
	quest.5CBE694E060BB1B9.quest_subtitle: "Let Redstone control your power"
	quest.5CD3EBB8D4853429.quest_subtitle: "Yummy!"
	quest.5CD948E420CD22EC.quest_desc: [
		"Press &bH&r – YDM’s Weapon Master"
		"Press &bZ&r – Perform a roll"
		"Press &bM&r – Open the world map"
		"Press &bO&r – Open the shader selection menu"
		"Press &bB&r – Open your backpack                                                             &lConfigure Any&r&b"
	]
	quest.5CD948E420CD22EC.quest_subtitle: "Read This First!"
	quest.5CD948E420CD22EC.title: "&bSettings Control"
	quest.5CE02F705DF1A5BE.quest_desc: ["&6The&r integrated circuit needed for the Electrical Gizmo. Deployed over compatible equipment, it &bboosts&r it for a limited number of uses."]
	quest.5CE02F705DF1A5BE.quest_subtitle: "An integrated circuit"
	quest.5CF67B714252B32C.quest_desc: [
		"&6Why&r settle for ordinary railways when you can take your trains above the ground? The Monorail Train Track introduces a &bcompletely&r different way to build your railway network, allowing you to create sleek elevated and &bsuspended&r railways."
		""
		"Lay your &bfirst&r monorail track and take your railway to new heights."
	]
	quest.5CF67B714252B32C.quest_subtitle: "One rail. A whole new way to travel."
	quest.5D0FDCEFB5BD7BB5.quest_desc: [
		"The Aeternium Shovel is a top-tier &adigging&r tool forged from Aeternium, offering the best durability in Better End's tool line."
		""
		"It's crafted using an &bAeternium Anvil&r and a Netherite or Aeternium Smith Hammer."
	]
	quest.5D0FDCEFB5BD7BB5.quest_subtitle: "Digging tool of the strongest tier"
	quest.5D186CD6AAD57073.quest_desc: ["&6The&r Display Board is a scalable information screen for your factory. &bIndividual&r boards can connect together into a display up to 32×32 blocks in size, with each block holding two lines of text. &bPower&r the board with at least &b32&r RPM to display text. You can write text directly using a Clipboard or Name Tag, color it with Dyes, or make it glow with Glow Ink Sacs. For automated information, use a Display Link to show data such as rotation speed, fluid levels, boiler status, item names and other &bmachine&r information. The items used to configure the text are not consumed."]
	quest.5D186CD6AAD57073.quest_subtitle: "Put your factory on display"
	quest.5D302C6DA0561BF4.quest_subtitle: "More Armor"
	quest.5D49B95246579A3D.quest_desc: ["&bUse materials&r to craft the Starcatcher Rod. This rod is your first step to catching fish and discovering rare aquatic &acreatures&r"]
	quest.5D49B95246579A3D.quest_subtitle: "Craft your first fishing rod"
	quest.5D6BA83890C17CFD.quest_desc: ["&6Craft&r the Sequenced Pulse Generator and take precise control over redstone timing. Program a sequence of instructions that runs &bwhen&r the block receives a redstone signal. It can perform &bsignal-strength&r comparisons, arithmetic and bitwise operations, making it a powerful tool for &badvanced&r automation. A Control Chip is required to craft it."]
	quest.5D6BA83890C17CFD.quest_subtitle: "Program your redstone signals"
	quest.5D764CDE02CECDFF.quest_desc: [
		"&9&lTake&r&r your resource production a step further with the Fortune II Upgrade. It provides the second level of Fortune to compatible operations, giving you an even greater &bchance&r of obtaining additional &bresources&r from supported blocks."
		""
		"&bUpgrade&r your automated systems and make every mining operation more rewarding."
	]
	quest.5D764CDE02CECDFF.quest_subtitle: "Increase your resource yield even further"
	quest.5D7E2401CA74F57E.quest_desc: [
		"&dThe&r Ignis Spellbook is a powerful Fire spellbook from Cataclysm: Spellbooks. It provides &b12&r spell slots, &b+30%&r Fire Spell Power and &b+300&r Max Mana, making it an excellent choice for a mage devoted to destructive fire magic."
		""
		"&bMaster&r the flames of Ignis and unleash devastating fire spells upon your enemies."
	]
	quest.5D7E2401CA74F57E.quest_subtitle: "Wield the devastating flames of Ignis"
	quest.5D8F5E6E65FB4E6F.quest_desc: ["&6Craft&r Wooden Walkway Steps to expand your factory's elevated walkways. These &bsteps&r are part of Create: Escalated's wooden &btransportation&r system, giving you a practical way to connect different &blevels&r of your factory."]
	quest.5D8F5E6E65FB4E6F.quest_subtitle: "Take the wooden route upward"
	quest.5D94D2A0B9B33F18.quest_desc: ["&6Craft&r the Prestant pipe and &bexpand&r your pipe organ with a strong, clear principal voice. Prestant is one of the organ stops &badded&r by Create: Sound of Steam in version 0.8.0."]
	quest.5D94D2A0B9B33F18.quest_subtitle: "Add a powerful principal voice"
	quest.5D9ECA964DCB5556.quest_desc: ["&6Craft&r the Kinetic Bridge and Kinetic Battery to gain greater control over your kinetic networks. The Kinetic Bridge transfers stress &bcapacity&r between two separate networks while keeping them isolated, protecting the source network if the &bdestination&r becomes overstressed. The Kinetic Battery stores kinetic stress for later use and retains its charge even as an item, &ballowing&r mechanical power to be transported over long distances."]
	quest.5D9ECA964DCB5556.quest_subtitle: "Store and transfer mechanical stress"
	quest.5D9ECA964DCB5556.title: "Kinetic Bridge \\& Kinetic Battery"
	quest.5DA5211A9A2240F3.quest_desc: ["&6Obtain&r the Slicer from Create: Slice \\& Dice. It is an automated cutting machine &bdesigned&r mainly for Farmer’s Delight recipes. It works similarly to Create’s Mechanical Mixer or Mechanical Press and &bautomatically&r registers cutting recipes, allowing you to automate &bprocesses&r normally done with a Cutting Board. The Slicer &brequires&r the appropriate tool, such as a Knife or Axe, to be &binserted&r into the machine."]
	quest.5DA5211A9A2240F3.quest_subtitle: "Automate the art of cutting"
	quest.5DD6D72E96F8A5D8.quest_desc: ["&aObtain&r a Cursium Ingot from the Cataclysm mod. This &brare&r &bmaterial&r is dropped by Maledictus in the Frosted Prison and is used to craft powerful Cursium &bequipment&r."]
	quest.5DD6D72E96F8A5D8.quest_subtitle: "A cursed metal from the frozen prison"
	quest.5DDE97F467CF6DB7.quest_subtitle: "More Armor"
	quest.5DE69F2C7802A979.quest_subtitle: "More Armor"
	quest.5DE8F69201253A50.quest_desc: ["The path beyond Netherite &bbegins&r here. By combining the strength of Netherite with iron, you &acreate&r a more durable and reliable material. This is only the first step toward even greater &bpower&r."]
	quest.5DE8F69201253A50.quest_subtitle: "A stronger foundation"
	quest.5DE8F69201253A50.title: "Iron Netherite Ingot"
	quest.5E16BAD64A4B17E2.quest_desc: ["&6Obtain&r a Train Schedule from Create. It allows you to program automated trains by &bdefining&r destinations, &btravel&r conditions, and speed limits. Schedules can include station destinations, delays, time-of-day conditions, cargo requirements, Redstone Links, player count, and more. They can also be &bconfigured&r to repeat continuously."]
	quest.5E16BAD64A4B17E2.quest_subtitle: "Put your railway on autopilot"
	quest.5E1FED1118233908.quest_desc: ["&6The&r Multimeter is a useful tool for working with the electrical systems &badded&r by Create: Dreams n' Desires. Use it to inspect electrical &bcomponents&r and better understand the power flowing &bthrough&r your factory's machinery."]
	quest.5E1FED1118233908.quest_subtitle: "Measure before you build"
	quest.5E22FAB8A62D6461.quest_desc: ["&6Craft&r the Gedeckt pipe and add a soft, &bflute-like&r voice to your pipe organ. Gedeckt is one of the original pipe types in Create: Sound of Steam. In version 0.8, its appearance was also &bchanged&r to show that it is a stopped pipe."]
	quest.5E22FAB8A62D6461.quest_subtitle: "Add a warm flute voice"
	quest.5E43E62B2B5C57F4.quest_desc: ["&aObtain&r the Belt of Beginner from the Cataclysm mod. &bThis&r simple belt provides two additional Curio slots for Skulls, allowing you to equip relics such as the Unbreakable Skull. Though modest in appearance, it &bmarks&r the beginning of your journey toward &bmastering&r ancient artifacts."]
	quest.5E43E62B2B5C57F4.quest_subtitle: "The first step toward greater relics"
	quest.5E45EBC3E36FDA4C.quest_desc: [
		"&9&lKeep&r&r an eye on your Refined Storage autocrafting jobs without being tied to your main network. The Wireless Autocrafting Monitor gives you remote access to active crafting tasks, allowing you to check their progress and manage your &bautomated&r production from a distance."
		""
		"&bConnect&r it to your network and stay in control of your crafting jobs wherever you are."
	]
	quest.5E45EBC3E36FDA4C.quest_subtitle: "Monitor your automated crafting from anywhere"
	quest.5E5745E799BB7B58.quest_subtitle: "More Armor"
	quest.5E5AA188F68E2B6E.quest_desc: ["&6Welcome&r to Create: Mechanical Extruder! Build your &bfirst&r mechanical extruder and discover a new way to automate the &bproduction&r of blocks and items. By combining adjacent blocks and fluids with rotational power, the extruder can generate &buseful&r resources and expand the &bpossibilities&r of your factory."]
	quest.5E5AA188F68E2B6E.quest_subtitle: "              Extrude your way to automation                       "
	quest.5E5AA188F68E2B6E.title: "&l&6Welcome Create Mechanical Extruder"
	quest.5E6192DF85596293.quest_desc: [
		"&l&9Why&r&r wait until you're in danger to reach for a potion? The Alchemy Upgrade automatically consumes potions, effect foods and even milk &bwhen&r your configured conditions are met. Whether you're underwater, sprinting or suffering from a negative effect, your backpack can react for you."
		""
		"The &bAdvanced&r Alchemy Upgrade takes this a step further, giving you more precise control over potion duration and effect levels."
	]
	quest.5E6192DF85596293.quest_subtitle: "Let your backpack handle your potions for you"
	quest.5E6192DF85596293.title: "Alchemy \\& Advanced Alchemy Upgrade"
	quest.5E6408A2CAC0321C.quest_desc: [
		"&aThe&r Glacite Helmet is a cold-resistant armor piece &bfrom&r Eternal Starlight crafted using Glacite materials."
		""
		"Glacite armor &ahelps&r protect against freezing environments and slows attacking enemies with &bicy&r effects."
	]
	quest.5E6408A2CAC0321C.quest_subtitle: "Frozen protective headgear"
	quest.5E70B9C39D63424E.quest_desc: ["&6The&r Capacitor is an energy-storage component from Create Crafts \\& Additions. It allows you to store Forge Energy &b(FE)&r and &buse&r that stored power when needed, making it useful for &bstabilizing&r and managing your factory's electrical network. In version 1.6.0 for NeoForge 1.21.1, the Capacitor can also be charged directly with FE."]
	quest.5E70B9C39D63424E.quest_subtitle: "Store electrical energy"
	quest.5E798A66A4A73131.quest_desc: ["&dMakes&r your bullets heavier, boosting their &bknockback&r at the cost of &bbullet speed&r."]
	quest.5E798A66A4A73131.quest_subtitle: "Heavier rounds"
	quest.5E87C003DBAC4CB9.quest_desc: [
		"&dVoidwalker&r Leggings are the Crystal Chronicles upgraded version of the Shadow Walker Leggings from Iron’s Spells ’n Spellbooks."
		""
		"They are &bupgraded&r using an Abyssal Crystal Shard, &btransforming&r the original Shadow Walker Armor into the powerful Voidwalker Armor set. The Abyssal Crystal Shard infuses the leggings with the power of the Abyss, &benhancing&r the dark and shadowy abilities of the original equipment."
	]
	quest.5E87C003DBAC4CB9.quest_subtitle: "An enhanced form of Shadow Walker Leggings, empowered by Abyssal Crystal"
	quest.5E97E01DAF94EF91.quest_subtitle: "More Armor"
	quest.5EA5A8B4E9C589F8.quest_desc: ["&6The&r Electrical Connector is a key component of the power network in Create: New Age. Use it to &bconnect&r electrical machines and transfer power between &bdifferent&r parts of your factory. Build a reliable &belectrical&r network and prepare for more advanced machinery."]
	quest.5EA5A8B4E9C589F8.quest_subtitle: "Connect your factory to the grid"
	quest.5EB82AFEBB1E761A.quest_desc: [
		"&l&9Make&r&r better use of your backpack's storage space with the Compacting Upgrade. It automatically compacts compatible items into their block or &bhigher-form&r equivalents and can unpack them again when needed."
		""
		"The Advanced Compacting Upgrade gives you greater control over the process, &ballowing&r you to &bconfigure&r which items are compacted and how the compacting system behaves."
	]
	quest.5EB82AFEBB1E761A.quest_subtitle: "Turn your overflowing storage into compact convenience"
	quest.5EB82AFEBB1E761A.title: "Compacting \\& Advanced Compacting Upgrade"
	quest.5EBE62F99616E6AF.quest_subtitle: "Yummy!"
	quest.5ED9D5ED047D6F17.quest_desc: [
		"Craft an &aInterplanar Projector&r to display your captured images in &b3D&r."
		"This device allows you to project photographs and share your discoveries in a unique way."
	]
	quest.5ED9D5ED047D6F17.quest_subtitle: "Project your discoveries"
	quest.5EF72A6EE9C86A28.quest_desc: ["&6Craft&r the Fan Ending Catalyst using Dragon's Breath and use it with an Encased Fan to perform Ending recipes. This catalyst provides a &bdedicated&r way to trigger the Ending process through &bfan-based&r automation."]
	quest.5EF72A6EE9C86A28.quest_subtitle: "End the process with dragon's breath"
	quest.5F1BA4438855750D.quest_subtitle: "Upgrade+"
	quest.5F231AF1EB93743D.quest_desc: ["&6Craft&r the Vibration Mechanism, an &badvanced&r component from Create: Misc \\& Things. It is used as a crafting ingredient for specialized items, including the Radar and Brass Speaker. Its recipe is made through &bsequenced&r assembly."]
	quest.5F231AF1EB93743D.quest_subtitle: "Turn vibrations into technology"
	quest.5F3F334D0E9F1EAC.quest_subtitle: "More Armor"
	quest.5F6AD59476EA9ED3.title: "Why?..."
	quest.5F8B310E8F347803.quest_desc: [
		"&eEvery&r wound you inflict can become a source of life."
		""
		"The Vampiric Glove gives your melee attacks a &b20%&r chance to restore health based on the &bdamage&r you deal. By default, it can absorb up to 6 health points per hit."
		""
		"&bDeal&r damage. Steal life. Keep fighting."
	]
	quest.5F8B310E8F347803.quest_subtitle: "Let your enemies feed your strength"
	quest.5F970C6B27659E02.quest_subtitle: "Yummy!"
	quest.5FAA5CF98B35F420.quest_subtitle: "Yummy!"
	quest.5FC1AFC00CD8479B.quest_desc: [
		"&6When&r your aircraft needs more than speed, bring some firepower along. The Rotary Cannon is an &bautomatic&r weapon mounted on a gyroscopic stabilizer, allowing you to unleash a steady stream of fire while flying."
		""
		"Load it with gunpowder, take aim and &bshow&r your enemies who rules the skies."
	]
	quest.5FC1AFC00CD8479B.quest_subtitle: "A rapid-fire weapon for controlling the skies."
	quest.5FC4294BFD859994.quest_desc: [
		"&dProtection&r Upgrade Orb is an upgrade material in Iron's Spells 'n Spellbooks. When applied at the Arcane Anvil, it grants &b+5%&r Spell Resistance."
		""
		"It is &bcrafted&r using 1 Empty Upgrade Orb and 8 Protective Runes. Upgrade Orbs can be applied to &bcompatible&r equipment, with the default limit being 3 upgrades per item."
	]
	quest.5FC4294BFD859994.quest_subtitle: "Strengthen your defenses against the forces of magic"
	quest.5FFAE598BCB1BF7E.quest_subtitle: "More Armor"
	quest.6008177DE90FE654.quest_desc: [
		"The Thermal Springstone Scythe is a &ahybrid&r weapon-tool from Eternal Starlight crafted &busing&r Thermal Springstone Ingots."
		""
		"&aIt&r is used for wide-range melee attacks and efficient harvesting, while also applying a burning &beffect&r to enemies as part of the Springstone weapon set."
	]
	quest.6008177DE90FE654.quest_subtitle: "Geothermal area weapon"
	quest.600F06E22F4352E0.quest_desc: ["&aCraft&r a Black Steel Hoe from the Cataclysm mod. This &bdurable&r tool is made &busing&r Black Steel and is part of the Black Steel equipment set."]
	quest.600F06E22F4352E0.quest_subtitle: "A farming tool forged from black steel"
	quest.601D4234CBB94226.quest_desc: [
		"&aCraft&r a Wooden Fillet Knife, a simple yet &bessential&r tool for any aspiring angler. While ordinary tools may catch fish, a fillet knife allows you to properly process your catches, yielding valuable &bresources&r and making the most of every successful fishing trip."
		""
		"&aThough&r humble in appearance, this wooden knife &bmarks&r the beginning of your journey into the world of fishing. With it in hand, you'll be ready to turn fresh catches into useful ingredients and supplies for the &badventures&r ahead."
	]
	quest.601D4234CBB94226.quest_subtitle: "Prepare your first catch"
	quest.601FAACE19CA2A4B.quest_desc: [
		"&eA&r &bdangerous&r journey awaits your five little frogs. Cross the tracks, dodge minecarts, jump over logs and avoid the &bturtles&r on your way home."
		""
		"Can you &bget&r all five frogs safely to the other side?"
	]
	quest.601FAACE19CA2A4B.quest_subtitle: "Get all five frogs home safely."
	quest.6027A8C8D707CB89.quest_desc: ["&6The&r Portable Storage Interface allows items to be transferred between a moving Contraption and stationary storage. Place two &bInterfaces&r facing each other with &b1–2&r blocks of &bspace&r between them, with one attached to the Contraption and the other remaining stationary. When they connect, the Contraption briefly stops and its &binventory&r becomes accessible from the stationary side. Use Funnels, Chutes or other transport components to insert or extract items. A Redstone &bsignal&r can immediately break the connection."]
	quest.6027A8C8D707CB89.quest_subtitle: "A doorway for your items"
	quest.6035DF6B8A51456F.quest_desc: [
		"&aDefeat&r the Ender Guardian, the boss hidden on the Ruined Citadel's lowest floor, awakened by approaching the Altar of Void."
		""
		"Its brutal second phase shatters the arena floor — defeating it rewards the &bGauntlet of Guard&r."
	]
	quest.6035DF6B8A51456F.quest_subtitle: "The citadel's final defender"
	quest.6035DF6B8A51456F.title: "&l&dEnder Guardian"
	quest.603A83BC4034259F.quest_desc: [
		"&9&lNever&r&r let your hunger slow you down. The Feeding Upgrade automatically provides food from your storage when you &bneed&r it, making sure you always have something ready to eat."
		""
		"The Advanced Feeding Upgrade gives you more control over the feeding system, allowing you to &bconfigure&r when food should be used and which food items should be prioritized."
	]
	quest.603A83BC4034259F.quest_subtitle: "Keep your food supplies ready whenever hunger strikes"
	quest.603A83BC4034259F.title: "Feeding \\& Advanced Feeding Upgrade"
	quest.6043D6ED38152913.quest_desc: ["&dClockwork&r Components are the top tier of gun hardware. They are needed for the Arquebus and the Clockwork Rifle, as well as &badvanced&r modifiers like the Mechanical Repeater and the Suppressor."]
	quest.6043D6ED38152913.quest_subtitle: "Precision for advanced weapons"
	quest.6054FC57CE0B4413.quest_desc: [
		"&aLeave&r the safety of the mainland behind and set sail toward the vast Ocean. Beneath its endless &bwaves&r lies a world filled with hidden treasures, mysterious ruins, dangerous creatures, and forgotten secrets &bwaiting&r to be uncovered."
		""
		"&aThe&r Ocean is far more than an endless &bexpanse&r of water. It is home to shipwrecks, underwater caves, coral reefs, and ancient monuments that reward those brave enough to explore its depths. Every voyage across the sea is the beginning of a &bnew&r adventure."
	]
	quest.6054FC57CE0B4413.quest_subtitle: "The endless sea awaits"
	quest.6054FC57CE0B4413.title: "&l&9Visit the Ocean"
	quest.6056ED356B65D891.quest_desc: [
		"&dThe&r Arcane Anvil is the most &bpowerful&r crafting station in Iron's Spells 'n Spellbooks. It is used to upgrade scrolls, improve equipment and imbue weapons with spells. It is an essential workstation for &blate-game&r magical progression."
		""
		"&bUse&r Upgrade Orbs to enhance applicable armor and Spell Books, combine scrolls with Ink to increase their level, and imbue &bweapons&r with magical spells."
	]
	quest.6056ED356B65D891.quest_subtitle: "Master the art of advanced magical enhancement"
	quest.605AAF1B7598F6A6.quest_desc: ["&aObtain&r the Sandstorm in a Bottle from the Cataclysm mod. This mysterious &bartifact&r contains the power of an &bancient&r desert storm, allowing its wielder to harness the force of the sands. It is a rare &btreasure&r connected to the forgotten civilizations buried beneath the desert."]
	quest.605AAF1B7598F6A6.quest_subtitle: "Capture the fury of the desert winds"
	quest.60630DEB2B6A5908.quest_desc: ["&6A&r standard bulb. Put it in a fixture and power it; with too low a &bvoltage&r it is dimmer. Right-click it with a dye to change its &blight&r color."]
	quest.60630DEB2B6A5908.quest_subtitle: "A standard bulb"
	quest.607D585BD717F67A.quest_desc: ["&6Craft&r the Steam Whistle and add another &bpowerful&r voice to your mechanical organ. In Create: Sound of Steam, the &bwhistle-based&r pipes are part of the organ system and can be used to expand the range of sounds your instrument can produce. The mod &bspecifically&r includes the Haunted Steam Whistle among its pipe types."]
	quest.607D585BD717F67A.quest_subtitle: "Let your organ speak with steam"
	quest.60834016DDE092EC.quest_desc: [
		"&aThe&r Aethersent Boots are mystical footwear from Eternal Starlight crafted &busing&r Aethersent Ingots."
		""
		"&aThey&r are part of the Aethersent progression connected to meteors and celestial &bmaterials&r found in the Starlight dimension."
	]
	quest.60834016DDE092EC.quest_subtitle: "Celestial mystic footwear"
	quest.60836A242C6AEDB2.quest_desc: ["&6Moves&r air using &belectricity&r. Direction and strength depend on the applied &bvoltage&r. Use it to cool hot components and circuit boards."]
	quest.60836A242C6AEDB2.quest_subtitle: "A fan on electricity"
	quest.608C22B016C2E757.quest_desc: ["&6Precisely&r controls mechanical movement with an electric signal: the control pin takes -5 to 5 V, mapping to -360° to 360° of &brotation&r."]
	quest.608C22B016C2E757.quest_subtitle: "Precise movement"
	quest.60953F1CB3065914.quest_desc: ["&dRaw&r Mithril is a Rare crafting material in Iron's Spells 'n Spellbooks. It is dropped when mining Mithril Ore and Deepslate Mithril Ore. Smelt it in a Blast Furnace to &bobtain&r Mithril Scrap, which is then &bused&r to craft Mithril Ingots and other powerful equipment."]
	quest.60953F1CB3065914.quest_subtitle: "Unrefined metal of ancient magical power"
	quest.60A628F3BCECB4F0.quest_desc: [
		"&aThe&r Malarite Sword is an early-game weapon from Eternal Starlight, crafted using Malarite &bobtained&r in the Dark Swamp region."
		""
		"&aIt&r is part of the basic progression tier of the mod and &buses&r a simple crafting recipe in the crafting table."
	]
	quest.60A628F3BCECB4F0.quest_subtitle: "Swamp-forged weapon"
	quest.60B86999CB28ED7B.quest_desc: ["&6Craft&r the Overstress Clutch as a safety mechanism for your kinetic network. When the network becomes overstressed, the clutch automatically disconnects after a &bconfigurable&r delay, &bpreventing&r the overload from continuing through the connected machinery. It can be reconnected with a wrench, and its delay can be &badjusted&r from the side. It also supports a comparator output &bwhen&r coupled and can be reset with a redstone pulse."]
	quest.60B86999CB28ED7B.quest_subtitle: "Shut down before the system breaks"
	quest.60D022BA2B9F98D3.quest_desc: ["&aWelcome&r to My Nether's Delight, an addon that brings the cooking and farming experience of Farmer's Delight into the Nether. Discover new Nether ingredients, &bunique&r foods, cooking recipes and &buseful&r culinary items inspired by the dangerous dimensions of Minecraft."]
	quest.60D022BA2B9F98D3.quest_subtitle: "Discover the fiery cuisine of the Nether!"
	quest.60D022BA2B9F98D3.title: "&l&aMy Nether's Delight"
	quest.60DD9FC925957248.quest_desc: ["&6Craft&r the Fan Seething Catalyst to perform seething recipes using an Encased Fan. It provides a dedicated catalyst for high-temperature fan &bprocessing&r and was added to Create: Connected as a &bcompatibility&r item for Create: Dreams \\& Desires."]
	quest.60DD9FC925957248.quest_subtitle: "Turn up the heat"
	quest.60DF6A58DAC3125E.quest_desc: [
		"&6Quest Book Troubleshooting&r"
		""
		"If the quest icon does not appear after opening your inventory, don't panic. This can occasionally happen due to shaders or the quest interface failing to load correctly."
		""
		"Solution:"
		""
		"Press R while in-game. This will reload the shaders and should also refresh the quest interface."
		""
		"After the reload, open your inventory again. The quest icon should appear normally."
		""
		"If the problem persists, try pressing R once more or restart the game."
		""
		"Keep this quest in mind — it may save you from unnecessary frustration later."
		"{@pagebreak}"
		"&6Need Help?&r"
		""
		"Not every problem has a simple solution. If you encounter an issue that isn't covered in this chapter, don't hesitate to ask for help."
		""
		"Report your problem on our Discord server."
		""
		"You can find the Discord link in the Tutorial section of the quest book."
		""
		"Something went wrong? Let us know."
	]
	quest.60DF6A58DAC3125E.quest_subtitle: "Simple solutions to common problems"
	quest.60DF6A58DAC3125E.title: "&f&lForbbiden Helper"
	quest.60E721A9A608B618.quest_desc: [
		"&aAmong&r the rarest treasures of Eternal Starlight are the mysterious Starlit Diamonds."
		"These &bgems&r are infused with celestial energy and represent a higher tier of material &aprogression&r within the dimension."
		""
		"&aFinding&r one is a sign that you have begun reaching the deeper and more dangerous parts of the Starlight world."
	]
	quest.60E721A9A608B618.quest_subtitle: "A crystal touched by the stars"
	quest.60E721A9A608B618.title: "&6Starlit Diamond"
	quest.60E9767AC825258B.quest_desc: [
		"&dThe&r Druidic Tome is an epic Nature spellbook focused on the power of the natural world. It provides &b10&r spell slots, &b+200&r Max Mana and &b+10%&r Nature Spell Power, making it an excellent choice for spellcasters specializing in Nature magic."
		""
		"&bEquip&r the tome and strengthen your &bconnection&r with the forces of nature."
	]
	quest.60E9767AC825258B.quest_subtitle: "Harness the power of nature"
	quest.60F96662688EDC1A.quest_desc: [
		"&aObtain&r the Music Disc: Ender Guardian, a rare drop from the Ender Guardian boss of the Ruined Citadel."
		""
		"Like other Cataclysm boss discs, it plays a &btheme&r tied to its dungeon when placed in a jukebox."
	]
	quest.60F96662688EDC1A.quest_subtitle: "A tune from the void"
	quest.60F96662688EDC1A.title: "Music Disc"
	quest.60FDFBDED2583D6F.quest_desc: ["&dEnables&r &bscoping&r: aim through a zoomed view for precise long-range shots."]
	quest.60FDFBDED2583D6F.quest_subtitle: "Zoom in"
	quest.6115A157E4A81A68.quest_desc: [
		"&dThe&r Poisonward Ring grants complete &bimmunity&r to poison, protecting you from poison effects and allowing you to face poisonous enemies and hazards without fear."
		""
		"&bEquip&r the ring and turn one of the most &bdangerous&r negative effects into a threat of the past."
	]
	quest.6115A157E4A81A68.quest_subtitle: "Become immune to poison"
	quest.61224C127468D17C.quest_desc: ["&dInferno&r Disc is a weapon from Crystal Chronicles. It is crafted &busing&r Volcanite Shards and is associated with the enhanced Pyromancer equipment introduced by the addon. Its fiery power makes it a natural &bweapon&r for wielders of Fire magic."]
	quest.61224C127468D17C.quest_subtitle: "A blazing disc forged from the power of Volcanite"
	quest.6122706161D768D9.quest_desc: [
		"&aCraft&r the Ironwood Helmet using Ironwood Ingots &binfused&r with the ancient magic of the Twilight Forest. Combining the strength of iron with the mystical &benergy&r of the enchanted forest, this helmet offers reliable protection while embodying the craftsmanship of a forgotten civilization."
		""
		"&aAs&r part of the Ironwood Armor set, it strengthens your defenses and &bprepares&r you for the dangerous creatures, dungeons, and &bbosses&r that await deeper within the Twilight Forest."
	]
	quest.6122706161D768D9.quest_subtitle: "Guard your mind with ancient magic"
	quest.61246DD0435F1D05.quest_desc: ["&aLocate&r a Desert biome. Vast stretches of sand, cacti, and ancient ruins await those willing to &bcross&r the scorching wilderness. The desert is home to &bvaluable&r structures such as Desert Pyramids, Desert Villages, and Desert Wells."]
	quest.61246DD0435F1D05.quest_subtitle: "Search the endless sands"
	quest.61246DD0435F1D05.title: "&l&eFind A Desert"
	quest.613B45640F884627.quest_desc: [
		"The Terminite Axe is a &awoodcutting&r and combat tool forged from Terminite Ingots, a step up from the Thallasium tier."
		""
		"While Terminite gear alone isn't the strongest, it's a required &bstepping stone&r toward Aeternium and Crystalite equipment."
	]
	quest.613B45640F884627.quest_subtitle: "Woodcutting tool, refined"
	quest.6140A6E97F827366.quest_desc: [
		"&aSomewhere&r within the world of Eternal Starlight, ancient structures hide powerful constructs known as Starlight Golems."
		"These locations are not easy to find and often require proper &buse&r of the Seeking Eye with the correct item."
		""
		"&aFollow&r the signal, uncover the structure, and discover what lies within."
	]
	quest.6140A6E97F827366.quest_subtitle: "Find what guards the ruins"
	quest.6140A6E97F827366.title: "Golem Forge"
	quest.614A03480EBFEF1A.quest_desc: ["&aCraft&r the Ignitium Elytra Chestplate from the Cataclysm mod. This &blegendary&r armor combines the protection of an Ignitium Chestplate with the mobility of an Elytra, creating one of the most powerful pieces of &bequipment&r forged from the metal of the Lord of Fire."]
	quest.614A03480EBFEF1A.quest_subtitle: "Armor forged from the flames of the Nether"
	quest.614ABD14341C88FE.quest_desc: [
		"&9&lPut&r&r your digital storage network to work with the Exporter. It &bautomatically&r extracts selected items from your Refined Storage &bnetwork&r and sends them into connected inventories."
		""
		"Connect it to a chest, machine or another compatible block and configure which items should be exported. A simple but &bessential&r component for building automated systems."
	]
	quest.614ABD14341C88FE.quest_subtitle: "Send items from your network wherever they are needed"
	quest.614CBA540862DF7D.quest_desc: [
		"&6Give&r your locomotive a tougher industrial &bappearance&r with Slashed Locometal. Its distinctive cut-metal pattern adds depth and character to your train while keeping the unmistakable Steam 'n' Rails aesthetic."
		""
		"&bUse&r it to add a final touch of rugged detail to your locomotive."
	]
	quest.614CBA540862DF7D.quest_subtitle: "A rugged finish for your locomotives."
	quest.6153B298AE74D818.quest_desc: [
		"&aThe&r Aethersent Bottoms are mystical leg armor from Eternal Starlight crafted &busing&r Aethersent Ingots."
		""
		"&aThey&r are part of the Aethersent progression tied to meteors and celestial &bmaterials&r found in the Starlight dimension."
	]
	quest.6153B298AE74D818.quest_subtitle: "Celestial mystic leggings"
	quest.615B240EC8017A1E.quest_desc: [
		"&aMalarite-related&r smithing &bprogression&r in Eternal Starlight uses smithing templates as part of weapon upgrade systems."
		""
		"&aThese&r templates are associated with upgrading or enhancing Malarite-tier weapons through the smithing table. Their acquisition is tied to &bprogression&r content and &bstructure&r loot within the dimension."
	]
	quest.615B240EC8017A1E.quest_subtitle: "Weapon upgrade artifact"
	quest.615B240EC8017A1E.title: "&5Malarite Smithing Template"
	quest.6160F754ACE16D63.title: "&l&cNetherite &6Monst&erosity"
	quest.617B7BE17022FC0F.quest_desc: [
		"&eWho&r has time to stop for a drink?"
		""
		"This &bstrange&r plastic hat makes eating and drinking much faster, letting you get back to the adventure without wasting precious time."
		""
		"&bPut&r it on, grab a drink and keep moving."
	]
	quest.617B7BE17022FC0F.quest_subtitle: "Drink faster. Eat faster. Keep moving"
	quest.617F700F91153D89.quest_desc: ["&6Welcome&r to Create. Discover the &bpower&r of mechanical engineering, rotating machinery, and automated systems. Start your journey by learning how to turn simple &bmaterials&r into complex machines and useful contraptions."]
	quest.617F700F91153D89.quest_subtitle: "A world of gears, machines, and endless possibilities"
	quest.617F700F91153D89.title: "&l&6Welcome Create"
	quest.618307252C357AAD.quest_desc: [
		"&aCraft&r the Ironwood Sword using Ironwood Ingots forged with the ancient magic of the Twilight Forest. This finely crafted blade combines the resilience of iron with the mystical power of the enchanted woods, creating a dependable weapon capable of &bstanding&r against the dangerous &bcreatures&r that roam the forest."
		""
		"&aAs&r one of the core weapons of the Ironwood equipment set, it provides a noticeable improvement in both &bdurability&r and combat performance, preparing you for the increasingly difficult bosses and &bdungeons&r that lie ahead."
	]
	quest.618307252C357AAD.quest_subtitle: "A blade forged from steel and forest magic"
	quest.61885962E531AC61.quest_desc: ["&aThe&r Waxed Hoglin Trophy is a preserved decorative version of the Hoglin Trophy. The wax helps protect it, &bmaking&r it a lasting decoration for your base."]
	quest.61885962E531AC61.quest_subtitle: "A preserved trophy of a defeated Hoglin"
	quest.6188D7490C607899.quest_subtitle: "More Armor"
	quest.618AD1A819B8105E.quest_desc: ["&aDefeat&r 5 Elite Draugr from the Cataclysm mod. These powerful undead &bwarriors&r are among the most dangerous defenders of the Frosted Prison. Defeat them to prove your &bstrength&r and continue your &bjourney&r through the frozen fortress."]
	quest.618AD1A819B8105E.quest_subtitle: "Defeat the prison's strongest warriors"
	quest.618AD1A819B8105E.title: "Kill Elite Draugr"
	quest.61913CFAB19D8C92.quest_desc: [
		"The &aGlassblower&r is a crafting station used to transform glass blocks into many decorative variants."
		"Experiment with different styles and give your builds a unique look."
	]
	quest.61913CFAB19D8C92.quest_subtitle: "Shape the glass"
	quest.61AE095F93EF5CAB.quest_desc: [
		"&aCraft&r the Steeleaf Chestplate using the enchanted Steeleaf material found throughout the Twilight Forest. Woven with the ancient magic of the forest, this chestplate provides dependable protection while remaining surprisingly lightweight, making it ideal for long expeditions through &bdangerous&r biomes and ancient ruins."
		""
		"&aAs&r the centerpiece of the Steeleaf armor set, it offers a significant defensive upgrade and prepares adventurers for the challenges that lie &bdeeper&r within the Twilight Forest."
	]
	quest.61AE095F93EF5CAB.quest_subtitle: "Armor infused with the forest's magic"
	quest.61AE17528CDE5C93.quest_desc: ["&6Create&r Zinfandel, a distinctive red wine for your automated winery. &bUse&r the Wine Cellar and Create's machinery to process your grapes and &bproduce&r another refined addition to your wine collection. Create: Winery is built around &bautomating&r grape processing and wine production."]
	quest.61AE17528CDE5C93.quest_subtitle: "A bold wine from the vineyard"
	quest.61B7DF42DC1D3DB1.quest_desc: [
		"&dShadow-Walker&r Mask is the headpiece of the Shadow-Walker Armor set in Iron's Spells 'n Spellbooks. When worn, it provides &b+3&r Armor, &b+125&r Max Mana, &b+10%&r Ender Spell Power and &b+5%&r Spell Power."
		""
		"It can be &bcrafted&r from 5 Arcane Cloth and 1 Ender Rune, or upgraded from a Wizard Helmet with 1 Ender Rune and 1 Arcane Essence in supported versions."
	]
	quest.61B7DF42DC1D3DB1.quest_subtitle: "Master the mysterious power of Ender magic"
	quest.61C2E8B8CEC84581.quest_desc: ["&eWelcome&r to Game Discs, a mod that adds a retro gaming console and classic minigames to Minecraft. Find Game Discs, &bcollect&r them and &buse&r the console to &bplay&r different games without leaving your Minecraft world."]
	quest.61C2E8B8CEC84581.quest_subtitle: "Bring classic games into Minecraft!"
	quest.61C2E8B8CEC84581.title: "&l&fWelcome &aGame Discs"
	quest.61D9AEB9EB5F4BB9.quest_subtitle: "More Armor"
	quest.61DBDB4C046CE058.title: "yyyyyyy"
	quest.61DDD281F01A10BB.quest_desc: ["&6Brass&r Leggings are part of the Brass Suit from Create Stuff 'N Additions. They are &bcrafted&r from &b7&r Brass Ingots and have &b375&r durability, making them a durable part of the brass armor set."]
	quest.61DDD281F01A10BB.quest_subtitle: "Complete the brass suit"
	quest.621ACFB71957DACF.quest_desc: [
		"&9&lMake&r&r collecting dropped items effortless with the Magnet Upgrade. It attracts nearby items and &bautomatically&r places them into your storage, &bkeeping&r your surroundings clean and your inventory free from clutter."
		""
		"The Advanced Magnet Upgrade expands the magnet's capabilities, giving you greater &brange&r and more control over which items are attracted. Use filters to make sure only the resources you &bactually&r want end up in your storage."
	]
	quest.621ACFB71957DACF.quest_subtitle: "Draw nearby items straight into your storage"
	quest.621ACFB71957DACF.title: "Magnet \\& Advanced Magnet Upgrade"
	quest.62474A1802B2E109.quest_subtitle: "Yummy!"
	quest.6248B75B2221B854.quest_subtitle: "Upgrade+"
	quest.62628FBCBA78E7E6.quest_desc: [
		"&dDecrepit&r Flamberge is a powerful two-handed sword wielded by Ancient Knights in Iron's Spells 'n Spellbooks. It can be &bnaturally&r dropped by them."
		""
		"When held in the main hand, it provides &b11&r Attack Damage, &b1.3&r Attack Speed and &b+4&r Armor. It can later be &bupgraded&r into the Legionnaire Flamberge using Timeless Slurry and a Pyrium Ingot."
	]
	quest.62628FBCBA78E7E6.quest_subtitle: "Wield the ancient blade of the forgotten knights"
	quest.6276AF4B828C53D9.quest_desc: [
		"&dIce&r Upgrade Orb is an upgrade material in Iron's Spells 'n Spellbooks. When applied at the Arcane Anvil, it grants &b+5%&r Ice Spell Power."
		""
		"It is &bcrafted&r from 1 Empty Upgrade Orb and 8 Ice Runes."
	]
	quest.6276AF4B828C53D9.quest_subtitle: "Infuse your equipment with the power of Ice magic"
	quest.62858FA44AA44E80.title: "BRO"
	quest.62AD3B71953D2BAC.title: "yh"
	quest.62B96FD0EF8229FC.quest_desc: [
		"&dThe&r Inscription Table is one of the most important magical workstations in Iron's Spells 'n Spellbooks. Use it to transfer spells from scrolls into your spellbook, &bpermanently&r adding them to &bavailable&r spell slots. You can also extract unlocked spells from a spellbook back into scrolls."
		""
		"The table occupies two blocks and is &bessential&r for building and managing your spellbook loadout. &bFind&r or craft a spellbook, collect scrolls and begin filling your book with the magic you want to master."
	]
	quest.62B96FD0EF8229FC.quest_subtitle: "Fill your spellbook with powerful spells"
	quest.62BA7685BF01904B.quest_desc: [
		"&6Flying&r isn't just about speed — stability matters too. The Gyroscope keeps your aircraft steady and completely &bremoves&r the effects of wind, making your flights more predictable and controlled."
		""
		"Install a Gyroscope and take &bcontrol&r of your aircraft with greater confidence."
	]
	quest.62BA7685BF01904B.quest_subtitle: "Keep your aircraft steady, no matter the wind."
	quest.62C6D37BDFF143BD.quest_desc: ["&6Craft&r the English Horn pipe and &bexpand&r your organ with its distinctive reed tone. English Horn is one of the pipe stops added in Create: Sound of Steam 0.8.0. As a reed pipe, it is crafted through &bsequenced&r assembly using the mod's reed and tuning wire components."]
	quest.62C6D37BDFF143BD.quest_subtitle: "Add a warm reed voice"
	quest.630CA9C23881A985.quest_desc: [
		"&dArchevoker&r Hat is the headpiece of the Archevoker Armor set in Iron's Spells 'n Spellbooks. When worn, it provides &b+3&r Armor, &b+125&r Max Mana, &b+10%&r Evocation Spell Power and &b+5%&r Spell Power."
		""
		"It can be &bcrafted&r from 5 Arcane Cloth and 1 Evocation Rune, or upgraded from a Wizard Helmet with 1 Evocation Rune at a Smithing Table."
	]
	quest.630CA9C23881A985.quest_subtitle: "Master the arcane power of Evocation magic"
	quest.6311D7362CCEBE8A.quest_desc: ["&6Build&r the Wine Cellar, the heart of your winery. This fully automatable workstation processes grape juice, apple must, and other &bingredients&r into Red Wine, White Wine, Rosé, and Cider. Connect funnels and Create machinery to &bautomate&r the entire winemaking process."]
	quest.6311D7362CCEBE8A.quest_subtitle: "Ferment, mature, and bottle your finest creations"
	quest.6319576F1AAF714B.title: "PRO"
	quest.632DB3C11495D9A1.quest_subtitle: "More Armor"
	quest.63387AF850FEAA94.quest_desc: [
		"&dAutoloader&r Crossbow is a unique ranged weapon in Iron's Spells 'n Spellbooks. It automatically loads the next available projectile from your inventory, including arrows and fireworks. &bCrouch-click&r to cancel the automatic loading."
		""
		"It can be &bfound&r as a rare reward in Ominous Vaults. It has 465 durability and can receive normal Crossbow enchantments."
	]
	quest.63387AF850FEAA94.quest_subtitle: "Never stop firing with an endless supply of projectiles"
	quest.636CD2E37C7B1F4E.quest_desc: [
		"&aCraft&r the Arctic Boots &busing&r soft Arctic Fur gathered from the frozen reaches of the Twilight Forest. &bDesigned&r to keep your feet warm while traversing snow and ice, these boots provide dependable &bprotection&r without sacrificing comfort or mobility."
		""
		"&aAs&r part of the Arctic Armor set, they are essential for surviving the unforgiving climate of the Glacier. Whether climbing &bfrozen&r cliffs or crossing endless snowy plains, the Arctic Boots will keep you &bmoving&r toward the final secrets of the Twilight Forest."
	]
	quest.636CD2E37C7B1F4E.quest_subtitle: "Leave no trail but determination"
	quest.638387B448672958.quest_desc: ["&aObtain&r an Ancient Metal Nugget from the Cataclysm mod. These fragments of ancient metal are commonly dropped by Koboletons and can also be &bfound&r throughout the Desert Site and Cursed Pyramid. Combine 9 Ancient Metal Nuggets to craft an &bAncient&r Metal Ingot, a key &bmaterial&r for ancient equipment."]
	quest.638387B448672958.quest_subtitle: "Fragments of a forgotten civilization"
	quest.639BD5444809C7EB.quest_desc: ["&aCraft&r the Bone Reptile Helmet from the Cataclysm mod. This &bunique&r helmet is crafted using Ancient Metal Ingots, Koboleton Bones, and a Kobolediator Skull, making it a true &btrophy&r earned by &bconquering&r the Cursed Pyramid."]
	quest.639BD5444809C7EB.quest_subtitle: "Wear the skull of the desert champion"
	quest.639CE862CC9E6065.quest_desc: ["&dBlackpowder&r is the base of nearly everything in this mod. It goes into &bbullets&r, guns and a large number of &bmodifiers&r, so always keep a healthy stock of it."]
	quest.639CE862CC9E6065.quest_subtitle: "The spark behind every shot"
	quest.63A8822AE7315353.quest_desc: ["&dThe&r Blunderbuss is a short-range scattergun. It is at its best against &bgroups&r or single targets up close, and putting many bullets into one target earns the Ventilated advancement."]
	quest.63A8822AE7315353.quest_subtitle: "Close-range chaos"
	quest.63CB8BC129A734C0.quest_subtitle: "Upgrade+"
	quest.63CF9DFE04D5CB1D.quest_desc: ["&6Measures&r the &btemperature&r of devices. Held, it shows the temperature of what you point at. Placed on a device, it measures its &bcurrent&r and maximum temperature over time."]
	quest.63CF9DFE04D5CB1D.quest_subtitle: "Measures temperature"
	quest.63E56C890C99BE64.quest_desc: [
		"&6Experimentation is part of the journey.&r"
		""
		"Not everything in this world will explain itself. Some machines need to be tested, some items have unexpected uses, and some mechanics can only be understood by trying them yourself."
		""
		"Combine things. Test machines. Try different tools. Explore unfamiliar systems."
		""
		"You will break things. You will make mistakes. That's how you learn."
		""
		"Don't be afraid to experiment — sometimes the most useful discovery is the one you weren't looking for."
	]
	quest.63E56C890C99BE64.quest_subtitle: "The best discoveries are rarely planned"
	quest.63E56C890C99BE64.title: "&l&fDon't Fear Experimentation"
	quest.63EF96C7B8FE5011.quest_desc: ["&6Process&r White Grapes with a Mechanical Press to &bobtain&r White Grape Pomace, a by-product of the winemaking process in Create: Winery. The pomace can be used in further processing and &bautomation&r alongside the other winery ingredients."]
	quest.63EF96C7B8FE5011.quest_subtitle: "Make use of every last grape"
	quest.6406B05C60A7BA67.quest_desc: [
		"The Armored Elytra is an upgraded Elytra reinforced with Better End materials, offering better durability while gliding."
		""
		"It can be repaired using an &aAeternium&r Ingot at an Anvil, or through the Mending enchantment."
	]
	quest.6406B05C60A7BA67.quest_subtitle: "Reinforced wings"
	quest.6423C49E7EC083E1.quest_desc: [
		"&aCraft&r a Gold Hook, a &brefined&r piece of fishing equipment created for anglers who seek more than ordinary catches. Crafted with precious gold, this hook &brepresents&r a balance between elegance and efficiency, helping you pursue the rare treasures hidden beneath the waves."
		""
		"&aThe&r ocean rewards &bthose&r who are prepared. With the Gold Hook as part of your equipment, you are one step closer to discovering the secrets of the deep and the &bvaluable&r finds waiting in unexplored waters."
	]
	quest.6423C49E7EC083E1.quest_subtitle: "A golden lure for ocean treasures"
	quest.64275AD4D0C56F95.quest_subtitle: "Upgrade+"
	quest.6439C150DA3F1E22.quest_subtitle: "More Armor"
	quest.6441CDA42F631D3C.quest_desc: ["&dA&r rare and valuable crafting material &bused&r in many different recipes throughout Hazen N Stuff."]
	quest.6441CDA42F631D3C.quest_subtitle: "A valuable material used in many powerful recipes"
	quest.6455DAC5C9E5DDFF.quest_desc: ["&6The&r Schematic Table is used to write saved .nbt schematics onto an Empty Schematic. Place the Empty Schematic in the input slot, &bselect&r a schematic from your schematics folder, and confirm the selection. The table uploads the structure data onto the item, turning it into a usable Schematic. Once loaded, the Schematic can be positioned as a holographic &bblueprint&r and built in Survival using a Schematicannon, or printed directly in Creative mode. The processing time depends on the &bsize&r of the selected structure."]
	quest.6455DAC5C9E5DDFF.quest_subtitle: "Turn blueprints into reality"
	quest.645C82A3532AED90.quest_desc: ["&6The&r Mechanical Drill uses rotational power to break blocks directly in front of it. The faster it spins, the &bfaster&r it mines. It can also damage entities that come into contact with the spinning drill. When mounted on a moving Contraption, it can &bautomatically&r break blocks along its path, &bmaking&r it perfect for mining machines, tunnel bores and automated quarries."]
	quest.645C82A3532AED90.quest_subtitle: "Dig deeper"
	quest.646116DDCB5D0803.quest_subtitle: "More Weapon"
	quest.64737A846B22061E.quest_desc: ["&aDefeat&r a Kobolediator from the Cataclysm mod. These powerful &belite&r warriors guard the depths of the Cursed Pyramid, wielding heavy &bweapons&r and protecting the path to the Ancient Remnant. &bDefeat&r one to prove your strength."]
	quest.64737A846B22061E.quest_subtitle: "Defeat the champion of the Cursed Pyramid"
	quest.64737A846B22061E.title: "Kobolediator"
	quest.6476156CB4ECE2D1.title: "Okey"
	quest.6478CCA843E198AA.quest_desc: [
		"&dVoidwalker&r Chestplate is the Crystal Chronicles &bupgraded&r version of the Shadow Walker Armor chestpiece from Iron’s Spells ’n Spellbooks."
		""
		"It is &bupgraded&r using an Abyssal Crystal Shard, transforming the original Shadow Walker Armor into the powerful Voidwalker Armor set. The Abyssal Crystal Shard infuses the chestplate with the power of the Abyss, enhancing the dark and shadowy &babilities&r of the original equipment."
	]
	quest.6478CCA843E198AA.quest_subtitle: "An enhanced form of Shadow Walker Armor, empowered by Abyssal Crystal"
	quest.648824143B6CB7EB.quest_desc: [
		"&dThe&r Rotten Spell Book is a rare piece of world loot in Iron's Spells 'n Spellbooks. When equipped as your spellbook, it provides &b8&r spell slots and grants &b+100&r Max Mana, but at the cost of &b-15%&r Spell Resistance."
		""
		"A corrupted tome with a dangerous trade-off: greater magical reserves in &bexchange&r for weaker protection against enemy spells."
	]
	quest.648824143B6CB7EB.quest_subtitle: "Embrace the corruption and gain forbidden power"
	quest.6489A7EA609347D8.quest_desc: ["&6Obtain&r any Seat from Create. Seats are available in &b16&r colors and can be &bused&r to sit on moving contraptions, making them especially useful for trains, vehicles, and other mechanical creations."]
	quest.6489A7EA609347D8.quest_subtitle: "Take a seat and enjoy the ride"
	quest.6489A7EA609347D8.title: "Create Seats"
	quest.64992BB68270DECF.quest_subtitle: "More Armor"
	quest.64A1134999AB1508.quest_desc: ["&6Craft&r a Shear Pin and add a simple safety mechanism to your kinetic network. When the connected system &bbecomes&r overstressed, the Shear Pin breaks and disconnects the network, preventing the overload from bringing down the entire setup. It is a consumable component, so keep &breplacements&r ready."]
	quest.64A1134999AB1508.quest_subtitle: "Let it break before everything does"
	quest.64A2E52F46697285.quest_desc: [
		"&aFar&r beneath the waves, where &bsunlight&r can no longer reach, lies the Sunken City—an immense underwater metropolis abandoned by time. Hidden within the deepest oceans, its ruined halls are &bguarded&r by terrifying creatures and ancient &bmagic&r that has endured for countless ages."
		""
		"&aLegends&r speak of an &bunspeakable&r horror sleeping at the city's heart, waiting for those reckless enough to disturb its slumber. Finding the Sunken City is the first step toward &buncovering&r one of the greatest secrets hidden beneath the sea. It naturally generates in Deep Ocean biomes and &bserves&r as the domain of The &bLeviathan&r."
	]
	quest.64A2E52F46697285.quest_subtitle: "The abyss hides an ancient civilization"
	quest.64A2E52F46697285.title: "&dFind the Sunken City"
	quest.64C33111DD58A498.quest_desc: [
		"&dVoidwalker&r Helmet is the Crystal Chronicles &bupgraded&r version of the Shadow Walker Mask from Iron’s Spells ’n Spellbooks."
		""
		"It is &bupgraded&r using an Abyssal Crystal Shard, transforming the original Shadow Walker Armor into the &bpowerful&r Voidwalker Armor set. The Abyssal Crystal Shard infuses the helmet with the power of the Abyss, enhancing the dark and shadowy &babilities&r of the original equipment."
	]
	quest.64C33111DD58A498.quest_subtitle: "An enhanced form of Shadow Walker Mask, empowered by Abyssal Crystal"
	quest.64CA1CB9C3613638.quest_desc: [
		"&9&lPrepare&r&r your Refined Storage network for &bautomated&r crafting with the Pattern Grid. It provides a dedicated interface for creating crafting patterns, allowing you to define recipes that your network can &buse&r later for automatic production."
		""
		"Connect it to your network, place the required ingredients into the grid and save the pattern for your &bfuture&r crafting automation."
	]
	quest.64CA1CB9C3613638.quest_subtitle: "Create and manage crafting patterns with ease"
	quest.64DB8A01416875C1.quest_desc: ["&6Lets&r you connect windings around a rotor at an angle, so the generator is cleaner and has fewer &bwires&r."]
	quest.64DB8A01416875C1.quest_subtitle: "A generator housing"
	quest.64EA1F8E5E62BF02.quest_desc: ["&dHermomancer&r Leggings are part of the Hermomancer Armor set from Crystal Chronicles, an &baddon&r for Iron’s Spells ’n Spellbooks."]
	quest.64EA1F8E5E62BF02.quest_subtitle: "Harness the power of the Hermomancer"
	quest.64EB7EE019147045.quest_desc: ["&6The&r Blazing Shovel is part of the Blazing Tools set from Create Stuff 'N Additions. It uses fire to process the blocks you break, &bautomatically&r smelting applicable drops as you mine. It also sets mobs on fire &bwhen&r you attack them, making it useful both for gathering resources and combat. The mod &bdescribes&r Blazing Tools as tools that melt blocks they break and burn mobs they hit."]
	quest.64EB7EE019147045.quest_subtitle: "Dig with the heat of the Nether"
	quest.64ECB881301B5C3F.quest_desc: ["&6Obtain&r a Chain Conveyor from Create. It is used to transport Cardboard Packages and can also transfer &brotational&r force across spaces where a Mechanical Belt cannot be used. Chain Conveyors are connected using Chains, allowing you to create &blong-distance&r transport networks."]
	quest.64ECB881301B5C3F.quest_subtitle: "Carry your factory across the gaps"
	quest.64EDDFF6EC5B218C.quest_subtitle: "Upgrade+"
	quest.64FC5CB2F3BE1398.quest_desc: ["&aDefeat&r 7 Squid. These peaceful ocean mobs can be found swimming in rivers and oceans. Squid drop Ink Sac, a &buseful&r material for crafting and &bcoloring&r items."]
	quest.64FC5CB2F3BE1398.quest_subtitle: "Hunt the creatures of the ocean"
	quest.64FC5CB2F3BE1398.title: "Kill Squid"
	quest.65034A7DC75B290A.quest_desc: ["&6Right-click&r fires a &blightning&r bolt that bounces between nearby enemies and splits the damage. While you wear a Portable Battery it uses no durability and drains &benergy&r from the battery instead. An integrated circuit &bboosts&r it for a limited number of uses."]
	quest.65034A7DC75B290A.quest_subtitle: "A lightning gun"
	quest.650669ADA78A35B5.quest_desc: ["&6Build&r the Hypertube Entrance to connect your factory to a &bhigh-speed&r transportation network. Power the entrance with a cogwheel and use it to launch players and other entities through connected Hypertubes. The &bentrance&r can also be configured with a wrench between different modes."]
	quest.650669ADA78A35B5.quest_subtitle: "Step into the fast lane"
	quest.650ECB3047B12DCA.quest_desc: ["&6A&r Bucket of Seed Oil contains Seed Oil, a fluid added by Create Crafts \\& Additions. Seed Oil is produced by processing seeds and can be &bused&r as a fuel for &bcompatible&r Create machinery, giving otherwise &bcommon&r seeds another useful purpose."]
	quest.650ECB3047B12DCA.quest_subtitle: "Turn seeds into useful fuel"
	quest.651F8F268D2CFC3E.quest_desc: ["&dA&r special orb that increases draw &bspeed&r by 5%."]
	quest.651F8F268D2CFC3E.quest_subtitle: "An orb that improves archery speed"
	quest.652588740098F721.quest_desc: [
		"&9&lIncrease&r&r the stacking capacity of items in your Sophisticated Storage containers with the Stack Upgrade Tier 1+. This upgrade lets compatible &bitems&r stack beyond their normal limit, allowing you to store more &bresources&r without using additional slots."
		""
		"A &bsimple&r upgrade that makes every storage container more &befficient&r and gives you more room for your growing collection."
	]
	quest.652588740098F721.quest_subtitle: "Make every stack hold even more"
	quest.6525C8D1AA1212CA.quest_subtitle: "More Weapon"
	quest.652855610941A655.quest_desc: ["&aCraft&r a Neptunium Shovel from Aquaculture 2. This powerful tool is made from Neptunium, a &brare&r &bmaterial&r obtained from fishing treasures. It provides high &bdurability&r and efficiency for digging and is part of the Neptunium equipment set."]
	quest.652855610941A655.quest_subtitle: "A powerful tool from ocean treasures"
	quest.6530A1F90F372190.quest_desc: ["&6Prepare&r a Pumpkin Milkshake and add a &bseasonal&r twist to your factory's drink production. Combine pumpkin with the &brequired&r ingredients to create this rich and creamy treat from Create: Dreams n' Desires."]
	quest.6530A1F90F372190.quest_subtitle: "A creamy taste of autumn"
	quest.6533F849759661AD.quest_subtitle: "More Armor"
	quest.653CC055797F0927.quest_desc: ["&dThe&r Ring of No Affinity gives you freedom from magical specialization, allowing you to &buse&r your magical equipment without being tied to a specific school of magic. It is an &bexcellent&r choice for spellcasters who prefer versatility and want to combine different magical abilities."]
	quest.653CC055797F0927.quest_subtitle: "Master every school without choosing a side"
	quest.6556684EFB044E69.quest_subtitle: "More Armor"
	quest.655AF2B574D2FA9E.quest_desc: ["&aCraft&r the Ignis Mage Greaves from the Cataclysm: Spellbooks addon. These &benchanted&r greaves are part of the Ignis Mace Armor set, inspired by the power of Ignis and the flames of the Nether. They combine ancient fire magic with powerful protection, allowing &bwarriors&r to wield the fury of the Burning Arena."]
	quest.655AF2B574D2FA9E.quest_subtitle: "Armor blessed by the Lord of Fire"
	quest.656410AFBCA6979B.quest_desc: [
		"&l&9Turn&r&r your backpack into a portable &bfluid-handling&r system. The Pump Upgrade allows fluids to be transferred between your backpack's tank and fluid storage or containers. The &bAdvanced&r Pump Upgrade takes it further, allowing interaction with fluid blocks in the world and containers held in your hand, as well as filtering which fluids can be moved."
		""
		"The &bExperience&r Pump Upgrade brings experience into the equation. Combined with a Tank Upgrade, it can store your experience as a fluid and automatically transfer it between you and your backpack according to your &bconfigured&r level. It can even help repair Mending equipment automatically."
	]
	quest.656410AFBCA6979B.quest_subtitle: "Master the flow of fluids and experience"
	quest.656410AFBCA6979B.title: "Pump, Advanced Pump \\& Experience Pump Upgrade"
	quest.6576B72D57A123E1.quest_desc: ["&aDefeat&r 5 Urchinkin from L_Ender’s Cataclysm. Hunt down these &bcreatures&r of the deep and eliminate them one by one. Prove your strength against the &bdangerous&r inhabitants of Cataclysm's oceans."]
	quest.6576B72D57A123E1.quest_subtitle: "Hunt the creatures of the deep"
	quest.6576B72D57A123E1.title: "Urchinkin"
	quest.658219533A6C93DB.quest_desc: ["&aCraft&r the Pharaoh's Sacred Greaves from the Cataclysm: Spellbooks addon. These &benchanted&r leggings are part of the Pharaoh Wizard Armor set, inspired by the Ancient Remnant and the forgotten rulers of the desert. They &benhance&r Sand magic and strengthen the wearer's magical abilities."]
	quest.658219533A6C93DB.quest_subtitle: "Walk with the power of the ancient pharaohs"
	quest.6591631711CE8C17.quest_subtitle: "More Armor"
	quest.6598FDE8CAE1D0F6.quest_desc: ["&6Craft&r the Spout Gun and use it to fire liquid projectiles. Fill it with a fluid using a Spout and unleash different effects &bdepending&r on the liquid used. Water deals damage, while lava, honey, chocolate, and slime can provide &badditional&r effects. The gun has 500 durability."]
	quest.6598FDE8CAE1D0F6.quest_subtitle: "Turn fluids into ammunition"
	quest.65A005EDC1864CE5.quest_desc: ["&6A&r digit or character module for displays. When powered it rotates half a number, and when &bpower&r is removed it finishes the turn. Reset: &bground&r the reset line and pulse the power again. Change its look and color in the design table."]
	quest.65A005EDC1864CE5.quest_subtitle: "A display module"
	quest.65A4B36C2E970552.quest_desc: [
		"&aCraft&r and activate a Beacon using a Nether Star and rare resources."
		"Beacons project powerful effects that can enhance your &babilities&r and protect your base, making them one of the most important endgame &bstructures&r."
	]
	quest.65A4B36C2E970552.quest_subtitle: "Power of the Nether Star"
	quest.65B7CFAFB7A0DCFA.quest_desc: [
		"&aCraft&r a Double Hook, an advanced fishing upgrade &bdesigned&r for anglers who want to maximize every cast. Featuring two hooks working together, this unique attachment increases your chances of &bdiscovering&r valuable catches and rare treasures hidden beneath the surface."
		""
		"&aA skilled&r fisherman knows that &bsuccess&r comes from preparation and the right equipment. The Double Hook represents a new level of fishing mastery, &ballowing&r you to make every expedition more rewarding and efficient."
	]
	quest.65B7CFAFB7A0DCFA.quest_subtitle: "Twice the chance, twice the reward"
	quest.65B87E469FB01B3D.quest_desc: [
		"&dArchevoker&r Coat is the chestpiece of the Archevoker Armor set in Iron's Spells 'n Spellbooks. When worn, it provides &b+8&r Armor, &b+125&r Max Mana, &b+10%&r Evocation Spell Power and &b+5%&r Spell Power. It can also be imbued with 1 spell."
		""
		"It can be &bcrafted&r from 8 Arcane Cloth and 1 Evocation Rune, or upgraded from Wizard Robes with 1 Evocation Rune at a Smithing Table."
	]
	quest.65B87E469FB01B3D.quest_subtitle: "Channel the arcane power of Evocation magic"
	quest.65C3AC81A5F2406B.quest_desc: ["&aDefeat&r The Maledictus from the Cataclysm mod. This &bpowerful&r boss can be &bfound&r inside the Frosted Prison, a frozen structure located in snowy biomes. Defeat this cursed &bwarrior&r to claim its powerful loot."]
	quest.65C3AC81A5F2406B.quest_subtitle: "The cursed warrior of the frozen prison"
	quest.65C3AC81A5F2406B.title: "&l&6The &3Male&bdictus"
	quest.65CD24700D1B39AD.quest_desc: ["&6The&r Burner Stock is a component from Create: Dreams n' Desires &bused&r in heat-based machinery. Add it to your &bsetup&r to support more advanced heating and &bprocessing&r systems in your factory."]
	quest.65CD24700D1B39AD.quest_subtitle: "Keep the heat under control"
	quest.65E959288A762976.quest_subtitle: "More Armor"
	quest.65F02A93627352C4.quest_desc: [
		"&dThe&r Desert Spellbook is a Unique Spell Book from Cataclysm Spellbooks for Iron's Spells 'n Spellbooks. It provides &b12&r spell slots, &b+300&r Max Mana, &b+20%&r Nature Spell Power and &b+30%&r Holy Spell Power."
		""
		"This powerful tome combines the forces of Nature and Holy magic, making it a versatile choice for a &bspellcaster&r who wants to wield both schools."
	]
	quest.65F02A93627352C4.quest_subtitle: "Command the sacred power of sand and nature"
	quest.65F189B0CAA91354.quest_desc: ["&6Obtain&r a Copper Casing from Create. Copper Casings are primarily &bused&r for fluid-related &bmachinery&r and can also be applied to Fluid Pipes to encase them and control &btheir&r connections. To make one, apply a Copper Ingot to a Stripped Log or Stripped Wood."]
	quest.65F189B0CAA91354.quest_subtitle: "Build the foundation of fluid engineering"
	quest.65F189B0CAA91354.title: "Copper Casing"
	quest.66087880D92A880A.quest_desc: [
		"&aThe&r Malarite Hoe is an early-game farming tool from Eternal Starlight, crafted using Malarite &bfound&r in swamp-related biomes."
		""
		"&aIt&r is part of the basic &bprogression&r tier and is used for creating farmland."
	]
	quest.66087880D92A880A.quest_subtitle: "Swamp farming tool"
	quest.6622CB6BC38C6B1E.quest_desc: ["&aCraft&r a Neptunium Bow from Aquaculture 2. This &bpowerful&r bow is made from Neptunium, a rare &bmaterial&r obtained from fishing treasures. It is a durable &branged&r weapon and part of the Neptunium equipment set."]
	quest.6622CB6BC38C6B1E.quest_subtitle: "A legendary weapon from ocean treasures"
	quest.663A815A2817F96D.quest_desc: ["&6The&r Experience Hatch is a utility block from Create: Enchantment Industry that connects directly to fluid storage. It allows you to &bstore&r your own experience as Liquid Experience and later take it back from the tank. It also has a configurable filter and can handle up to &b1000&r &bexperience&r points per interaction."]
	quest.663A815A2817F96D.quest_subtitle: "Turn your experience into a resource"
	quest.666263BF5B3188ED.quest_desc: ["Emerald-infused Netherite creates &aequipment&r that stands out both in power and rarity. These boots symbolize progress and mastery over &bvaluable&r resources."]
	quest.666263BF5B3188ED.quest_subtitle: "Wealth under your feet"
	quest.666263BF5B3188ED.title: "Emerald Netherite Boots"
	quest.6665071920CBBC1C.quest_desc: [
		"&aObtain&r an Elytra, the pair of dragon-like wings found aboard End Ships that lets you glide through the air."
		""
		"It's essential gear for exploring the End's scattered islands, and the base component behind Better End's upgraded &bArmored&r and &bCrystalite&r elytra."
	]
	quest.6665071920CBBC1C.quest_subtitle: "Wings from the End"
	quest.6665071920CBBC1C.title: "&dElytra"
	quest.6667B249D5254C4D.quest_desc: ["&aObtain&r the Bloom Stone Hat from the Cataclysm: Spellbooks addon. Add this &bpowerful&r piece of equipment to your collection and continue your journey through the secrets and relics &bintroduced&r by the addon."]
	quest.6667B249D5254C4D.quest_subtitle: "Power born from ancient stone"
	quest.6677A1EA8675283A.quest_desc: ["&dIce&r Venom Vial is a crafting material in Iron's Spells 'n Spellbooks. It is refined from Icy Fangs using an Alchemist Cauldron filled with water. It is &bused&r to craft powerful &bIce-related&r equipment, including the Frostbranded Book and Boreal Blade."]
	quest.6677A1EA8675283A.quest_subtitle: "Refine the deadly venom of the Ice Spider"
	quest.667FEFEDEE689AF0.quest_desc: ["&aObtain&r a Tackle Box from Aquaculture 2. This fishing loot container can be found while fishing and contains &bvarious&r fishing-related items, including &bequipment&r and useful resources for anglers."]
	quest.667FEFEDEE689AF0.quest_subtitle: "A fisherman's collection of tools"
	quest.6691D3606189D3DA.quest_desc: ["&aDefeat&r the Infernal Dragon, the final boss of the Bosses’Rise chapter. This &bbattle&r tests all skills acquired throughout progression — combat mastery, mobility, and survival under extreme pressure. Upon victory, the player obtains the &aOld Eye&r, a key artifact &brequired&r to unlock access to the End dimension."]
	quest.6691D3606189D3DA.quest_subtitle: "The Journey Continues"
	quest.6691D3606189D3DA.title: "&l&aInfernal Dragon"
	quest.66964C84F5EE3262.quest_desc: [
		"&aFind&r or obtain a Smithing Template to unlock powerful upgrades and armor trims."
		"These templates are required to upgrade gear like turning &bdiamond&r equipment into &bnetherite&r."
	]
	quest.66964C84F5EE3262.quest_subtitle: "Upgrade your gear"
	quest.66964C84F5EE3262.title: "&cSmithing &3Template"
	quest.66A49885BA41BD1F.quest_subtitle: "More Armor"
	quest.66CAC564E26FBAE0.quest_desc: [
		"&eFear&r can be useful when it keeps you alive."
		""
		"The Panic Necklace grants you a burst of Speed after taking damage, &bhelping&r you escape dangerous &bsituations&r or quickly get out of an enemy's reach. By default, the effect lasts 8 seconds at Speed I."
		""
		"When &bthings&r go wrong, run first and think later."
	]
	quest.66CAC564E26FBAE0.quest_subtitle: "Run when danger comes knocking"
	quest.66D7C5EB51D1040A.quest_subtitle: "More Armor"
	quest.66E439CB536F5C3B.quest_desc: [
		"&bF&aT&cB &fTeams&r allows you to play together with other players by creating or joining a &eteam.&r"
		""
		"Being in a team lets you share quest progress, claim chunks together, and manage permissions more easily."
		""
		"You can create a team, invite other players, or join an existing one using the &eTeams&r menu."
		""
		"Make sure to set up your team before continuing, as some &6quests&r may require you to be in one."
	]
	quest.66E439CB536F5C3B.quest_subtitle: "Read This First!"
	quest.66E439CB536F5C3B.title: "&bF&aT&cB &fTeams"
	quest.66F283168EBCC4B7.quest_desc: [
		"&l&9Need&r&r supplies from a chest without manually moving every stack? The Restock Upgrade lets your backpack pull &bselected&r items from an inventory such as a chest or barrel. Simply configure your filters and interact with the container to &btransfer&r the items you need. It provides 9 filter slots."
		""
		"The Advanced Restock &bUpgrade&r takes this further with 16 filter slots and more precise &bfiltering&r by item, mod, tag, NBT data and damage values. It can also be configured to only pull items that are already present in your backpack."
	]
	quest.66F283168EBCC4B7.quest_subtitle: "Keep your backpack stocked with everything you need"
	quest.66F283168EBCC4B7.title: "Restock \\& Advanced Restock Upgrade"
	quest.6703AAB2A5811460.quest_desc: ["&6Build&r the Tracker Bar to bring your music rolls to life. It reads Music Rolls and uses them to play &bMIDI&r music through your pipe organ. Place it in your &bsetup&r and let your mechanical organ &bperform&r automatically."]
	quest.6703AAB2A5811460.quest_subtitle: "Let the music roll"
	quest.6703DE08804ED1EA.quest_desc: [
		"&aThe&r Alchemist Robe is a mystical equipment item from Eternal Starlight, associated with alchemy&b progression&r."
		""
		"&aIt&r is part of the alchemist gear set and is used for enhancing exploration or alchemy-related mechanics &bdepending&r on version."
	]
	quest.6703DE08804ED1EA.quest_subtitle: "Mystic alchemy garment"
	quest.6714D962C898EF4E.quest_subtitle: "Upgrade+"
	quest.671842F0BC20C1B4.quest_desc: [
		"&aCraft&r the Knightmetal Boots &busing&r &brefined&r Knightmetal Ingots forged from the legendary alloy of the Goblin Stronghold. Built to endure long campaigns and the harshest battlefields, these boots provide &bexceptional&r protection while allowing their wearer to confidently traverse the &bdangerous&r lands of the Twilight Forest."
		""
		"&aAs&r the final piece of the Knightmetal Armor set, they complete the equipment once worn by the fortress' &bgreatest&r defenders. Every step echoes the legacy of the ancient knights, proving that you are worthy to carry their &bstrength&r into the battles ahead."
	]
	quest.671842F0BC20C1B4.quest_subtitle: "March with the strength of ancient knights"
	quest.67310D2BB1D9FE7B.quest_desc: [
		"The Terminite Boots are crafted from Terminite Plating at a Smithing Table."
		""
		"They complete the Terminite set, and form the base for Better End's &bhigher-tier&r armors."
	]
	quest.67310D2BB1D9FE7B.quest_subtitle: "Boots of the second tier"
	quest.673C7F23F4D60FAB.quest_desc: [
		"&6An&r aircraft is only as good as the machine that drives it. The Engine provides the power needed to leave the &bground&r and keep your aircraft moving through the skies."
		""
		"Build your &bfirst&r Engine and prepare it for your next flight."
	]
	quest.673C7F23F4D60FAB.quest_subtitle: "The heart that brings your aircraft to life."
	quest.676799C020566A5E.quest_desc: [
		"&dPyromancer&r Leggings are the Crystal Chronicles upgraded version of the Pyromancer Leggings from Iron’s Spells ’n Spellbooks."
		""
		"They are &bupgraded&r using a Volcanite Shard, which enhances the original Pyromancer Armor with additional crystalline power. Volcanite Shards are &bused&r to upgrade the Iron’s Spells ’n Spellbooks Pyromancer Armor set into its enhanced Crystal Chronicles version."
	]
	quest.676799C020566A5E.quest_subtitle: "An enhanced form of Pyromancer Leggings, empowered by Volcanite"
	quest.6768A5966AF25FA9.quest_desc: ["&6Obtain&r a Cardboard Helmet from Create. It is part of the Cardboard Armor set introduced in Create 6.0. The helmet &bprovides&r basic protection, but its real purpose is stealth: when wearing the full Cardboard Armor set and sneaking, you &bdisguise&r yourself as a Cardboard Package, greatly reducing the &bdistance&r at which hostile mobs can detect you."]
	quest.6768A5966AF25FA9.quest_subtitle: "Hide in plain sight"
	quest.676B2B0E361D13D7.quest_desc: ["&aDefeat&r the Sandworm from the Bosses' Rise mod. This colossal creature burrows beneath the desert, emerging without warning to &bambush&r anyone who dares cross its territory. Prepare for a brutal battle &bagainst&r one of the desert's greatest predators."]
	quest.676B2B0E361D13D7.quest_subtitle: "Defeat the beast beneath the sands"
	quest.676B2B0E361D13D7.title: "Sandworm"
	quest.67998704595BCC4C.quest_desc: [
		"&aObtain&r the Thallasium Upgrade Smithing Template, used at a Smithing Table to apply Thallasium-tier trims and recipes to compatible gear."
		""
		"It marks the first rung of Better End's &bequipment&r progression."
	]
	quest.67998704595BCC4C.quest_subtitle: "Upgrading toward Thallasium"
	quest.67C76975FF52E2B5.quest_desc: [
		"&aThe&r Energy Sword is a special weapon from Eternal Starlight, designed as a stronger late-game combat option &bcompared&r to standard tools and weapons."
		""
		"Its blade is &ainfused&r with concentrated dimensional energy, making it one of the more advanced weapons &bavailable&r within the mod’s progression system."
	]
	quest.67C76975FF52E2B5.quest_subtitle: "Power condensed into a blade"
	quest.67C76975FF52E2B5.title: "&6Energy Sword"
	quest.67D7D6884849D393.quest_desc: [
		"&aDefeating&r the Hydra rewards more than glory—it grants two of the rarest &bmaterials&r found within the Twilight Forest. Fiery Blood and Fiery Tears are infused with the immense power of the legendary beast, each &bcontaining&r a fragment of its fiery essence."
		""
		"&aThese&r extraordinary &bmaterials&r are &bessential&r for crafting powerful equipment and represent a significant step forward in your journey. By harnessing the Hydra's lingering power, you'll be ready to face the even greater &bdangers&r that await deeper within the Twilight Forest."
	]
	quest.67D7D6884849D393.quest_subtitle: "The burning essence of the Hydra"
	quest.67D8A2586E403063.quest_subtitle: "More Armor"
	quest.6831D45654EF4F8A.quest_desc: ["Gold brings &bunique&r traits to your armor. This chestplate may sacrifice some durability, but offers special &aadvantages&r that can turn the tide of battle."]
	quest.6831D45654EF4F8A.quest_subtitle: "Power with finesse"
	quest.6831D45654EF4F8A.title: "Gold Netherite Chestplate"
	quest.68327C24BAEA874D.quest_desc: ["&6The&r Reactor Heat Vent is a crucial component for &bmanaging&r the heat produced by a reactor in Create: New Age. It helps transfer &bexcess&r heat out of the reactor, keeping the system stable and preventing &bdangerous&r overheating."]
	quest.68327C24BAEA874D.quest_subtitle: "Keep the reactor under control"
	quest.68341879EEE5B467.quest_subtitle: "Yummy!"
	quest.683470EE5034462E.quest_desc: [
		"The Terminite Pickaxe is a &amining&r tool forged from Terminite Ingots, stronger than its Thallasium counterpart."
		""
		"Terminite serves as the bridge between &bThallasium&r and the far stronger &bAeternium&r and Crystalite tiers."
	]
	quest.683470EE5034462E.quest_subtitle: "Mining tool, refined"
	quest.6840B394A4AC9936.quest_desc: [
		"&l&9Why&r&r wait beside a Blast Furnace when your backpack can do the work for you? The Blasting Upgrade brings blast furnace &bfunctionality&r directly to your backpack, allowing you to process compatible items while on the move."
		""
		"Take it a step further with the Auto-Blasting Upgrade and let your backpack handle the entire &bprocess&r automatically."
	]
	quest.6840B394A4AC9936.quest_subtitle: "Blast your ores wherever you go"
	quest.6840B394A4AC9936.title: "Blasting \\& Auto-Blasting Upgrade"
	quest.684AF2A35919C085.quest_subtitle: "Upgrade+"
	quest.684E81287B3674D5.quest_desc: [
		"&9&lTurn&r&r your backpack into a portable smoker. The Smoking Upgrade allows you to cook food using the smoker's &bfunctionality&r directly from your backpack, without needing to place a smoker in the world."
		""
		"&bUpgrade&r it to Auto-Smoking Upgrade and let the process run automatically. Your backpack can handle the input, fuel and finished products for you, making food preparation quick and effortless &bwherever&r your adventure takes you."
	]
	quest.684E81287B3674D5.quest_subtitle: "Smoke your goods wherever you go"
	quest.684E81287B3674D5.title: "Smoking \\& Auto-Smoking Upgrade"
	quest.6851B51C5760CDDA.quest_desc: [
		"&9&lGive&r&r your storage the ability to handle potions with the Alchemy Upgrade. It allows compatible potion-related items to be &bmanaged&r directly from your storage, making it easier to organize and &bautomate&r your brewing supplies."
		""
		"The Advanced Alchemy &bUpgrade&r provides greater control over potion handling and automation, helping you manage your alchemical &bresources&r more efficiently."
	]
	quest.6851B51C5760CDDA.quest_subtitle: "Bring the power of alchemy into your storage"
	quest.6851B51C5760CDDA.title: "Alchemy \\& Advanced Alchemy Upgrade"
	quest.6854B15B483321FE.quest_desc: [
		"&dWizard&r Leggings are part of the basic Wizard Armor set in Iron's Spells 'n Spellbooks. &bWhen&r equipped, they provide &b+6&r Armor, &b+125&r Max Mana and &b+5%&r Spell Power."
		""
		"Craft them using 7 Arcane Cloth and &bcomplete&r your Wizard Armor set to strengthen your magical abilities."
	]
	quest.6854B15B483321FE.quest_subtitle: "Channel arcane power through every step"
	quest.68555B3DC6690DF4.quest_desc: [
		"The Deepsilver Hoe is a &afarming&r tool from Eternal Starlight crafted &busing&r Deepsilver Ingots."
		""
		"&aIt&r is used to prepare farmland in swamp and Nightfall regions, serving as an early-mid &bprogression&r farming tool with increased durability over iron."
	]
	quest.68555B3DC6690DF4.quest_subtitle: "Swamp farming tool"
	quest.687E9BB952FCD233.quest_desc: [
		"&6A&r true classic of aviation. The Biplane is fast, compact and built for a single pilot. Its controls take some practice, but once you get the hang of it, you'll have a reliable aircraft for travelling &bacross&r the world."
		""
		"Build your Biplane, take off and &bmaster&r the skies."
	]
	quest.687E9BB952FCD233.quest_subtitle: "A classic aircraft for those ready to take flight."
	quest.6883CBAE7DD14409.quest_desc: [
		"&dMithril&r Weave is a Rare crafting material in Iron's Spells 'n Spellbooks. It is &bcrafted&r from 5 Mithril Ingots and 4 Chains."
		""
		"This special mithril fabric is &bused&r to create powerful magical equipment, including Lightbringer's Chestplate and Boots of Speed."
	]
	quest.6883CBAE7DD14409.quest_subtitle: "Weave legendary mithril into powerful equipment"
	quest.6892D1939DE84589.quest_desc: [
		"&aCraft&r the Knightmetal Shield using &brefined&r Knightmetal Ingots forged from the ancient alloy of the Goblin Stronghold. Once carried by the elite defenders of the fortress, this shield was &bdesigned&r to withstand &brelentless&r assaults and protect its bearer in the fiercest battles."
		""
		"&aIts&r reinforced construction and exceptional &bdurability&r make it an ideal companion for explorers venturing into the most dangerous regions of the Twilight Forest. Whether blocking crushing blows or deflecting deadly projectiles, the Knightmetal Shield stands as a symbol of &bunwavering&r courage and resilience."
	]
	quest.6892D1939DE84589.quest_subtitle: "Stand firm against any foe"
	quest.68937C93D9B55460.quest_desc: [
		"&dPaladin&r Helmet is the Crystal Chronicles &bupgraded&r version of Priest Mask from Iron’s Spells ’n Spellbooks."
		""
		"It is &bupgraded&r using a Divinite Shard, transforming the original Priest Armor into the powerful Paladin Armor set. The Divinite Shard &binfuses&r the helmet with the power of Holy magic, creating a stronger version of the original Priest equipment."
	]
	quest.68937C93D9B55460.quest_subtitle: "An enhanced Priest helmet empowered by Divine energy"
	quest.689C7758F5C6772E.quest_desc: ["Craft a Netherite Shield to gain the strongest protection in the game. Perfect for surviving the toughest battles."]
	quest.689C7758F5C6772E.quest_subtitle: "The ultimate defense!"
	quest.68AE80687FAE04F4.quest_desc: [
		"&dIcy&r Fang is a crafting &bmaterial&r in Iron's Spells 'n Spellbooks. It is obtained from the deadly Ice Spider and can be processed into Mithril Scrap."
		""
		"&bUse&r Icy Fang as a step toward powerful mithril &bequipment&r and other advanced magical crafting."
	]
	quest.68AE80687FAE04F4.quest_subtitle: "Harvest the frozen fang of an icy predator"
	quest.68B352EF2A1FCB07.quest_desc: ["&6The&r Experience Lantern is a utility block from Create: Enchantment Industry that absorbs &bexperience&r from players and nearby XP orbs. It can also function as an actor on Create contraptions, allowing you to automate XP &bcollection&r and feed it into your &bexperience-processing&r system."]
	quest.68B352EF2A1FCB07.quest_subtitle: "Capture experience wherever you go"
	quest.68C6C3BACF4779BD.quest_desc: ["&6Obtain&r a Brass Casing from Create. &bIt&r is one of the main building blocks for advanced Create machinery and is &bused&r in components such as the Mechanical Arm, Rotation Speed Controller, Train Station, Train Signal, and Train Controls. To obtain it, apply a Brass Ingot to a Stripped Log or Stripped Wood."]
	quest.68C6C3BACF4779BD.quest_subtitle: "Build the core of advanced machinery"
	quest.68C6C3BACF4779BD.title: "Brass Casing"
	quest.68CCBF8FE865B642.quest_desc: ["&6Craft&r the Freewheel Clutch to control the &bdirection&r of rotational power in your kinetic network. It allows rotation to pass in one direction while preventing reverse rotation from being transferred back through the system. It is &bespecially&r useful for preventing unwanted &bback-driving&r in mechanical setups. The Freewheel Clutch is part of Create: Connected."]
	quest.68CCBF8FE865B642.quest_subtitle: "Keep rotation moving one way"
	quest.68D4320A3DE537A9.quest_desc: ["&6Craft&r the Water Spout Gun and &buse&r water as your ammunition. Fill the gun through a Spout, then fire streams of water at your targets. The Spout Gun is one of the weapons &badded&r by Create: Misc \\& Things, which supports different liquids as ammunition."]
	quest.68D4320A3DE537A9.quest_subtitle: "Put some pressure behind that water"
	quest.68DFCC2ADCE32C6B.quest_desc: ["&aObtain&r a Nautilus Shell. This rare ocean item can be &bfound&r while fishing, obtained from Drowned mobs &bholding&r one, or purchased from &bWandering&r Traders. It is used to craft a Conduit."]
	quest.68DFCC2ADCE32C6B.quest_subtitle: "A rare treasure from the ocean"
	quest.68E9562BE443782D.quest_desc: [
		"&eSome&r enemies learn the hard way."
		""
		"The Shock Pendant has a &bchance&r to call down a lightning bolt on an attacker whenever they hurt you. The lightning only affects your attacker, while the pendant &bprotects&r you from lightning damage itself."
		""
		"&bStrike&r me, and face the storm."
	]
	quest.68E9562BE443782D.quest_subtitle: "Let them regret striking you"
	quest.68F63E4158025641.quest_desc: [
		"&aThe&r Malarite Pickaxe is an early-game mining tool from Eternal Starlight, crafted using Malarite &bobtained&r in swamp-related biomes of the dimension."
		""
		"&aIt&r is part of the basic &bprogression&r tier and uses a standard crafting table recipe."
	]
	quest.68F63E4158025641.quest_subtitle: "Swamp mining tool"
	quest.68F6C0E3BCD500A4.quest_desc: ["&aDefeat&r 3 Deepling Anglers from the Cataclysm mod. These aquatic enemies are &bspecialized&r Deeplings that attack from a distance using fishing-related weapons. They can be found in Deepling underwater &bstructures&r and deep ocean areas."]
	quest.68F6C0E3BCD500A4.quest_subtitle: "Hunt the ocean's deadly fishermen"
	quest.68F6C0E3BCD500A4.title: "Kill Deepling Angler"
	quest.6901A957458D61AD.quest_subtitle: "Yummy!"
	quest.69137268E9C67BC9.quest_desc: ["&eThe&r Runic Tablet is a mysterious item connected to the ancient runes of Simply Swords. Its purpose is tied to the mod's &bunique&r weapon and magical systems."]
	quest.69137268E9C67BC9.quest_subtitle: "An ancient tablet containing mysterious runic power"
	quest.692378124DC9DDE3.quest_desc: ["&6Craft&r the Hohlflute pipe and expand your organ with its &bdistinctive&r flute tone. Hohlflute is one of the seven new pipe types &bintroduced&r in Create: Sound of Steam 0.8.0, alongside Prestant, English Horn, Rohrflote, Viola, Vox Celeste and the Haunted Steam Whistle."]
	quest.692378124DC9DDE3.quest_subtitle: "Add a rich, hollow flute voice"
	quest.694923685A97BACE.quest_desc: [
		"&aThe&r Twilight Lich is one of the major bosses of the Twilight Forest, residing in a massive, corrupted tower &bfilled&r with undead magic. Once a powerful ruler, he has become a twisted sorcerer who &bcommands&r armies of skeletons and dark magic to protect his domain."
		""
		"&aDefeating&r the Lich is a major milestone in your progression through the Twilight Forest. His fight &bintroduces&r complex mechanics involving shields, magical projectiles, and summoned minions, making it a true test of &bpreparation&r and skill."
	]
	quest.694923685A97BACE.quest_subtitle: "The cursed ruler of the dead tower"
	quest.694923685A97BACE.title: "&eTwilight Lich"
	quest.695BBD58965B44EE.quest_desc: ["&6A&r vacuum tube that amplifies &bsignals&r. First power the heater; with the anode positive, current flows from anode to cathode, and a small change in Grid &bvoltage&r gives a large change in anode current."]
	quest.695BBD58965B44EE.quest_subtitle: "A triode"
	quest.695CB66232D20E0F.quest_desc: ["&6Prepare&r a Glowberry Milkshake and fill a bucket with it. This luminous variation adds a magical touch to the milkshake collection and brings the &bunique&r flavor of Glow Berries into your &bfactory's&r food production."]
	quest.695CB66232D20E0F.quest_subtitle: "A glowing twist on a classic treat"
	quest.6961D7C0B301B307.quest_desc: ["&6The&r Heater &bconverts&r electrical energy into heat for your thermal systems in Create: New Age. Connect it to your electrical network and use Heat Pipes to &btransport&r the generated heat &bwhere&r it is needed."]
	quest.6961D7C0B301B307.quest_subtitle: "Turn electricity into heat"
	quest.6977E75496660973.quest_desc: ["&dIce&r Staff is a magical staff from Iron's Spells 'n Spellbooks. When held in the main hand, it provides &b5&r Attack Damage, &b1&r Attack Speed, &b+15%&r Ice Spell Power, &b+25%&r Mana Regeneration and &b+5%&r Spell Power."]
	quest.6977E75496660973.quest_subtitle: "Wield the freezing power of Ice magic"
	quest.698AA9335E119552.quest_desc: ["&6Obtain&r the Hand Crank from Create. This simple kinetic &bgenerator&r produces rotational force when manually operated. Hold right-click to rotate it counter-clockwise, or sneak while using it to &brotate&r it in the opposite direction. The Hand Crank operates at &b32&r RPM and &busing&r it consumes saturation."]
	quest.698AA9335E119552.quest_subtitle: "Power your machines by hand"
	quest.698F0C13ED7A92E1.quest_desc: [
		"The Glacite Shovel is a &adigging&r tool from Eternal Starlight crafted &busing&r Glacite Ingots."
		""
		"&aIt&r is used for &bexcavation&r in cold biomes, offering improved durability over earlier-tier tools and serving as part of mid-tier &bprogression&r."
	]
	quest.698F0C13ED7A92E1.quest_subtitle: "Frost digging tool"
	quest.6990F5C8EF979465.quest_desc: [
		"&eWho&r needs wings when you have a helium-filled flamingo?"
		""
		"The Helium Flamingo lets you swim through the air, giving you temporary flight and &ballowing&r you to move freely in any direction. But the effect doesn't last forever — after &b8&r seconds, you'll need to wait &b15&r seconds for the flamingo to recharge."
		""
		"&bGrab&r your flamingo and take to the skies."
	]
	quest.6990F5C8EF979465.quest_subtitle: "Defy gravity, one breath at a time"
	quest.69B9100DF4B8831A.quest_desc: ["&6Craft&r the Parallel Gearbox and Vertical Parallel Gearbox to transmit &brotational&r power between parallel shafts while keeping the connected shafts rotating in the same direction. The Vertical Parallel Gearbox provides the same &bfunction&r for vertically adjacent shafts, making compact kinetic &blayouts&r easier to build in Create: Connected."]
	quest.69B9100DF4B8831A.quest_subtitle: "Keep your rotation moving in the same direction"
	quest.69B9100DF4B8831A.title: "Parallel Gearboxes"
	quest.69C39BE1FF3DE0A1.quest_desc: ["&6Obtain&r Crushing Wheels from Create. They are a more &badvanced&r version of the Millstone, used to &bprocess&r items with powerful crushing recipes. A working setup requires two Crushing Wheels placed one block apart and rotating in opposite directions. They are &bespecially&r useful for &badvanced&r ore processing and automation."]
	quest.69C39BE1FF3DE0A1.quest_subtitle: "Break down the toughest materials"
	quest.69C7DE2B7796DBD0.quest_subtitle: "More Weapon"
	quest.69CA0BC5F6D5D28A.quest_subtitle: "More Armor"
	quest.69F1B3F1F1E9B771.quest_subtitle: "Yummy!"
	quest.69F582287C18DE1E.quest_desc: [
		"&aCraft&r a Heavy Hook, a powerful fishing upgrade designed for anglers who seek the &bbiggest&r catches beneath the waves. Built with strength and durability in mind, this sturdy hook is prepared to handle the struggle of powerful aquatic &bcreatures&r and valuable treasures hidden in the depths."
		""
		"&aThe&r ocean is filled with &bchallenges&r that test even the most experienced fishermen. With the Heavy Hook equipped, you are ready to face stronger catches and continue your pursuit of the greatest &bsecrets&r the seas have to offer."
	]
	quest.69F582287C18DE1E.quest_subtitle: "Built to withstand the strongest pulls"
	quest.69FC48647ED1F443.quest_desc: ["&6The&r Steam Engine is one of the three engines added by Create Stuff 'N Additions. It uses steam to generate rotational power, providing an alternative way to &bpower&r your Create machinery. It is part of the mod's progression toward powered &bequipment&r such as the Andesite Jetpack and Andesite Exoskeleton."]
	quest.69FC48647ED1F443.quest_subtitle: "Power your factory with steam"
	quest.6A069388E07D6A5C.quest_desc: ["&6Obtain&r a Blaze Burner from Create. Capture a Blaze inside the Empty Blaze Burner to create a &bfunctioning&r heat source. &bWhen&r fueled, it provides Heated power for Basin recipes, while feeding it a Blaze Cake upgrades it to Super-Heated, unlocking the most demanding heated recipes. Blaze Burners can also &bprovide&r heat for Steam Engine boilers."]
	quest.6A069388E07D6A5C.quest_subtitle: "Harness the power of the Blaze"
	quest.6A28DAB2D8E85D0D.quest_desc: [
		"&aThe&r Orb of Prophecy is a rare artifact tied to the power of the Gatekeeper in Eternal Starlight."
		"It is not just a collectible item — it is the key that unlocks the &bportal&r to the dimension and binds your progress to the fate of the Starlight world."
		""
		"Without it, the path forward remains sealed, no matter how far you &aexplore&r."
	]
	quest.6A28DAB2D8E85D0D.quest_subtitle: "Destiny’s key"
	quest.6A28DAB2D8E85D0D.title: "&fOrb &bOf &9Prophecy"
	quest.6A2EC7F1102FF295.quest_desc: [
		"&dThe&r Wandering Magician Robe is part of the basic Wandering Magician Armor set in Iron's Spells 'n Spellbooks. It provides &b+6&r Armor and &b+25&r Max Mana."
		""
		"Craft it by combining a Leather Tunic with Arcane Essence. It is an excellent early-game piece for gaining extra &bmana&r while maintaining solid protection."
	]
	quest.6A2EC7F1102FF295.quest_subtitle: "Begin your journey with the robes of a wandering mage"
	quest.6A3210C5212EC2F6.quest_desc: [
		"&l&9Stop&r&r filling your inventory with every item you walk over. The Pickup Upgrade automatically sends picked-up items directly into your backpack according to a &bconfigurable&r filter. It has 9 filter slots for deciding what should be collected."
		""
		"The &bAdvanced&r Pickup Upgrade gives you much more control, with &b16&r filter slots and support for &bfiltering&r by item, mod, tags, NBT data and durability. You can even configure it to pick up only items that already exist in your backpack."
	]
	quest.6A3210C5212EC2F6.quest_subtitle: "Let your backpack collect the loot for you"
	quest.6A3210C5212EC2F6.title: "Pickup \\& Advanced Pickup Upgrade"
	quest.6A457706C53B4F21.quest_subtitle: "More Weapon"
	quest.6A45CC6B4F13A555.quest_desc: [
		"The Aeternium Hammer is a heavy &atool&r and weapon forged from Aeternium, the strongest material Better End has to offer."
		""
		"Working Aeternium requires an &bAeternium Anvil&r along with a Netherite or Aeternium Smith Hammer."
	]
	quest.6A45CC6B4F13A555.quest_subtitle: "Heavy tool and weapon of the strongest tier"
	quest.6A57379127505A8C.quest_desc: ["&aThe&r Basket is a &buseful&r storage and transport item from Farmer's Delight. It can be used to keep and carry various food and &bcooking&r ingredients, making it a convenient addition to any farm or kitchen."]
	quest.6A57379127505A8C.quest_subtitle: "A handy container for storing and carrying food"
	quest.6A6E8447429510CB.quest_desc: [
		"&9&lTake&r&r your Sophisticated Storage container from the Diamond Tier to the Netherite Tier. This is the final tier upgrade, unlocking the highest level of storage &bcapabilities&r and completing the &bprogression&r of your container."
		""
		"&bUpgrade&r your storage with the unmatched durability of Netherite and create a container worthy of the most demanding storage systems."
	]
	quest.6A6E8447429510CB.quest_subtitle: "Reach the ultimate tier of storage"
	quest.6A6F7996C03EADAB.quest_desc: ["&6The&r Flamethrower is a fuel-powered weapon from Create Stuff 'N Additions that lets you &bcontinuously&r spray flames in front of you. It can ignite entities and, when its flames pass over certain dropped items, can process them &busing&r Create's bulk smelting or smoking recipes. It stores up to &b1600&r units of fuel and can be refilled using furnace fuels. The Hellfire &benchantment&r changes the flames to soul fire and allows them to ignite blocks."]
	quest.6A6F7996C03EADAB.quest_subtitle: "Bring the heat to your enemies"
	quest.6A810716A4940BAB.quest_desc: [
		"&dGraybeard&r Staff is one of the earliest magical staves in Iron's Spells 'n Spellbooks. When held in the main hand, it provides &b3&r Attack Damage and &b1&r Attack Speed, along with &b+10%&r Spell Power and &b+25%&r Mana Regeneration."
		""
		"It is &bcrafted&r using 1 Arcane Essence, 1 Wooden Shovel and 1 Iron Ingot. It is an excellent &bearly-game&r staff for improving mana regeneration and spell power."
	]
	quest.6A810716A4940BAB.quest_subtitle: "Begin your path with the staff of an old mage"
	quest.6A8C5DA0C8310A31.quest_desc: [
		"&aCraft&r the Totem of Void Undying from the Void Totem mod, made from a Totem of Undying, Chorus Fruit, Eyes of Ender, and Lapis Lazuli."
		""
		"Held in your hand, it &bteleports&r you back to solid ground the moment you fall into the void, saving you from an otherwise &bcertain&r death."
	]
	quest.6A8C5DA0C8310A31.quest_subtitle: "A second chance over the void"
	quest.6AA23C0F94F6F61C.quest_subtitle: "More Armor"
	quest.6AAC2BDD100B15F0.quest_subtitle: "More Armor"
	quest.6AD63FDA288F96BD.quest_subtitle: "More Armor"
	quest.6ADF66F72E06AAC5.quest_desc: [
		"&dLightning&r Rune is a crafting ingredient in Iron's Spells 'n Spellbooks, used for advanced &bLightning-related&r crafting, including Lightning Upgrade Orbs. The Lightning school &buses&r Bottle o' Lightning as its magical Focus."
		""
		"&bCreate&r a Lightning Rune by combining 1 Blank Runestone with 8 Bottles o' Lightning."
	]
	quest.6ADF66F72E06AAC5.quest_subtitle: "Infuse a runestone with the concentrated power of Lightning magic"
	quest.6AFD2661BE96DC29.quest_desc: ["&aObtain&r the Harbinger's Music Disc, containing Self-Destruct Sequence, the theme &bassociated&r with the battle &bagainst&r The Harbinger."]
	quest.6AFD2661BE96DC29.quest_subtitle: "The final melody of a dying machine"
	quest.6B0616C2B11B5ADD.quest_desc: [
		"&dPaladin&r Boots are the Crystal Chronicles upgraded version of Priest Boots from Iron’s Spells ’n Spellbooks."
		""
		"They are upgraded &busing&r a Divinite Shard, which transforms the original Priest Armor into the powerful Paladin Armor set. The Divinite Shard infuses the &bequipment&r with the power of Holy magic, creating a stronger form of the original Priest gear."
	]
	quest.6B0616C2B11B5ADD.quest_subtitle: "An enhanced form of Priest Boots, empowered by Divine energy"
	quest.6B0BD3A2DAC12945.quest_desc: ["&aObtain&r the Dragon Guard Shield from the Bosses' Rise mod. Forged from the &bremains&r of an ancient dragon, this legendary shield offers exceptional protection and embodies the &bunwavering&r strength of the &bcreatures&r that once ruled the skies. It is a prized relic for any warrior who survives the hunt."]
	quest.6B0BD3A2DAC12945.quest_subtitle: "Stand firm before the dragon's wrath"
	quest.6B2C9305EAE258A3.quest_desc: [
		"&dVolcanite&r Shard is a rare crafting and upgrade material from Crystal Chronicles. It is used to upgrade the Pyromancer Armor from Iron’s Spells ’n Spellbooks into its &benhanced&r Crystal Chronicles version."
		""
		"Volcanite Shard is also &bused&r in the creation of Inferno Disc, making it an important material for &bequipment&r focused on Fire magic."
	]
	quest.6B2C9305EAE258A3.quest_subtitle: "A volcanic crystal shard that empowers Pyromancer equipment"
	quest.6B2FF24D4AE7FFB7.quest_desc: ["&dA&r special rune &bused&r to craft Cosmic weapons and armor in Hazen N Stuff."]
	quest.6B2FF24D4AE7FFB7.quest_subtitle: "A rune infused with cosmic power"
	quest.6B386C4B7C12EEB4.quest_subtitle: "More Armor"
	quest.6B418B3D591AF926.quest_subtitle: "More Armor"
	quest.6B457385DA893C59.quest_desc: ["&6Copper&r Leggings are part of the Copper Suit from Create Stuff 'N Additions. They provide 5 armor points and &b1&r armor toughness, giving the same protection as Iron Leggings while having greater durability. They have &b225&r durability and can be repaired &busing&r Honeycombs in an Anvil. They are crafted from &b7&r Copper Ingots."]
	quest.6B457385DA893C59.quest_subtitle: "Solid protection from head to toe"
	quest.6B491C5DBC046984.quest_subtitle: "More Armor"
	quest.6B5A54DFFA845E0C.quest_subtitle: "Yummy!"
	quest.6B5FA49A9541E2C7.quest_desc: [
		"&dBlood&r Upgrade Orb is an upgrade material in Iron's Spells 'n Spellbooks. When applied at the Arcane Anvil, it grants &b+5%&r Blood Spell Power."
		""
		"It is crafted from 1 Empty Upgrade Orb and 8 Blood Runes. Upgrade Orbs can be applied to compatible &bequipment&r to increase its magical power."
	]
	quest.6B5FA49A9541E2C7.quest_subtitle: "Infuse your equipment with the power of Blood magic"
	quest.6B925D25127DCB4C.quest_desc: ["&aObtain&r Astrape, a powerful weapon from L_Ender’s Cataclysm. Astrape deals 10.5 attack damage and can launch a Lightning Spear when used. The spear deals lightning &bdamage&r and leaves behind a static &bfield&r that continues &bdamaging&r nearby creatures. It is crafted with 2 Essence of the Storm and 3 Lacrima."]
	quest.6B925D25127DCB4C.quest_subtitle: "Call down the fury of the heavens"
	quest.6B925D25127DCB4C.title: "&bAstrape"
	quest.6B99A186C173FB69.quest_subtitle: "More Armor"
	quest.6BA18CA5F164C18A.quest_desc: [
		"&dArtificer's&r Cane is a versatile magical staff from Iron's Spells 'n Spellbooks. When held in the main hand, it provides &b4&r Attack Damage and &b1&r Attack Speed, along with &b+10%&r Spell Power, &b+10%&r Cast Time Reduction and &b+10%&r Cooldown Reduction."
		""
		"Craft this &bpowerful&r arcane tool and improve the speed and efficiency of your spellcasting."
	]
	quest.6BA18CA5F164C18A.quest_subtitle: "Master the art of faster and more efficient spellcasting"
	quest.6BB1BCCE91450A21.quest_desc: ["&aThe&r Impact Pearl is a special Archaion item tied to &bteleportation&r mechanics. Harness its power to &btraverse&r the world of the Ancients on your journey."]
	quest.6BB1BCCE91450A21.quest_subtitle: "Echo of Impact"
	quest.6BEE4287A4B0BEB9.quest_desc: ["&dAquaflora&r is a very light blade with a pointed tip, adorned with plants and flowers. It focuses on area control and continuous damage. Its base &bmaterials&r mainly consist of plants and flowers found thr&boughout&r the Overworld."]
	quest.6BEE4287A4B0BEB9.quest_subtitle: "Blade of Nature"
	quest.6BEE4287A4B0BEB9.title: "&l&dAquaflora"
	quest.6BEFEB4AF8FAACEF.quest_desc: [
		"&dPlagued&r Boots are part of the Plagued Armor set in Iron's Spells 'n Spellbooks. When worn, they provide &b+3&r Armor, &b+125&r Max Mana, &b+10%&r Nature Spell Power and &b+5%&r Spell Power."
		""
		"They can be &bcrafted&r or upgraded using 1 Nature Rune, 1 Wizard Boots and 1 Arcane Essence."
	]
	quest.6BEFEB4AF8FAACEF.quest_subtitle: "Walk with the poisonous power of Nature magic"
	quest.6BF196CC5ABD3EDA.quest_desc: ["&aFind&r the Ancient Factory from the Cataclysm mod. Hidden deep underground, this forgotten structure holds &bdangerous&r machinery, valuable treasures, and the secrets of an ancient civilization. &bExplore&r its halls and prepare yourself for the powerful enemies that await within."]
	quest.6BF196CC5ABD3EDA.quest_subtitle: "Uncover the forgotten machinery"
	quest.6BF196CC5ABD3EDA.title: "&l&cAncient &eFactory"
	quest.6C06DA081E245BD2.quest_desc: ["&6Take&r your powered equipment to the next level with the Brass Exoskeleton and its upgraded Netherite Exoskeleton. The Brass &bExoskeleton&r enhances your abilities with powerful effects such as Strength or Haste, while the Netherite version takes the &btechnology&r even further as an endgame upgrade. The Netherite Exoskeleton was &badded&r to Create Stuff 'N Additions in version 2.1.4.a."]
	quest.6C06DA081E245BD2.quest_subtitle: "Power your body to the limit"
	quest.6C06DA081E245BD2.title: "Brass \\& Netherite Exoskeletons"
	quest.6C228387FFDE8B49.quest_desc: [
		"&dThe&r Flintlock is the simplest firearm in the mod and the perfect starting point. It shoots bullets, has &bmodifier&r slots you can fill, and teaches you the basics: aim, fire, then reload."
		""
		"&dFire&r one to earn the Arms advancement."
	]
	quest.6C228387FFDE8B49.quest_subtitle: "Your first firearm"
	quest.6C39723DAA360E3A.quest_desc: ["&dEvery&r shot fired in the last second adds bonus &bdamage&r, so sustained fire hits harder and harder."]
	quest.6C39723DAA360E3A.quest_subtitle: "Damage that builds"
	quest.6C3BF0CE848EB015.quest_subtitle: "Yummy!"
	quest.6C612E542824BA8D.quest_desc: [
		"&aThe&r Energy Boomerang is a ranged weapon from Eternal Starlight, appearing in advanced &bprogression&r of the mod."
		""
		"Its &aexact&r acquisition method is not clearly documented in available sources and is likely tied to higher-tier crafting, loot tables, or progression &brewards&r within the dimension."
	]
	quest.6C612E542824BA8D.quest_subtitle: "Unstable ranged weapon"
	quest.6C612E542824BA8D.title: "&6Energy Boomerang"
	quest.6C6DB945A0BB708D.quest_desc: [
		"&dThe&r Ancient Codex is the legendary netherite-tier spellbook of Iron's Spells 'n Spellbooks. It provides &b12&r spell slots, &b+20%&r Cooldown Reduction and &b+200&r Max Mana, making it one of the most powerful &bgeneral-purpose&r spellbooks available."
		""
		"Forge this &blegendary&r tome and take your spellcasting to its highest standard of power."
	]
	quest.6C6DB945A0BB708D.quest_subtitle: "Master the ancient secrets of magic"
	quest.6C7AD8E59D08C36E.quest_desc: [
		"&aCraft&r the Yeti Boots using the &bthick&r fur of the Alpha Yeti. Designed to withstand the harsh &bconditions&r of the Glacier, these sturdy boots keep their wearer warm while providing reliable &bprotection&r during long journeys across snow and ice."
		""
		"&aAs&r part of the Yeti Armor set, the boots complete the attire of those who have &bconquered&r the frozen wilderness. Every step is a reminder that even the endless winter could not stop your &badvance&r through the Twilight Forest."
	]
	quest.6C7AD8E59D08C36E.quest_subtitle: "Leave your mark in the snow"
	quest.6C898FB20C5AA890.quest_desc: ["Collect different types of bait to improve your chances of catching rare and &bvaluable fish&r."]
	quest.6C898FB20C5AA890.quest_subtitle: "Attract more fish with the right bait"
	quest.6C898FB20C5AA890.title: "Baits"
	quest.6C90E641B6B4C233.quest_desc: [
		"The &acombination&r of diamond and Netherite creates the most &aefficient&r tools possible."
		"They are built for endgame &bmining&r, &bcombat&r, and &bsurvival&r."
	]
	quest.6C90E641B6B4C233.quest_subtitle: "Ultimate efficiency"
	quest.6C90E641B6B4C233.title: "Diamond Netherite Tools"
	quest.6C97B56678EF8F02.quest_subtitle: "More Armor"
	quest.6CB208911EA0AA28.quest_desc: [
		"&dBlood&r Rune is a crafting ingredient in Iron's Spells 'n Spellbooks used for advanced &bBlood-related&r crafting, including Blood Upgrade Orbs. It is the &bBlood-school&r version of a Runestone."
		""
		"&bCreate&r a Blood Rune by combining a Blank Runestone with 8 Blood Vials. Blood Vials are the Blood Focus of the mod."
	]
	quest.6CB208911EA0AA28.quest_subtitle: "Infuse a runestone with the dark power of Blood magic"
	quest.6CB4F6B18847DB94.quest_desc: [
		"&eTired&r of carrying stacks of food everywhere you go?"
		""
		"This &bstrange&r piece of beef never gets consumed. Take a bite whenever you're hungry and it will always be there for the next one — &balthough&r you'll have to wait a little between meals."
		""
		"One steak. Endless meals."
	]
	quest.6CB4F6B18847DB94.quest_subtitle: "A steak that never runs out"
	quest.6CC2BC62154711B8.quest_desc: ["&dA&r valuable crafting &bmaterial&r from Hazen N Stuff, used in various recipes for powerful equipment and items."]
	quest.6CC2BC62154711B8.quest_subtitle: "A dark and powerful material for advanced crafting"
	quest.6CFCE3D5C2FE56FB.quest_desc: [
		"&aThe&r Flowglaze Smithing Template is a smithing item in Eternal Starlight &bused&r for upgrading Flowglaze-related equipment."
		""
		"&aIt&r cannot be crafted and is obtained as loot from chests found in specific structures within the dimension. It is &brequired&r for progression recipes involving Flowglaze gear."
	]
	quest.6CFCE3D5C2FE56FB.quest_subtitle: "Flow upgrade artifact"
	quest.6CFCE3D5C2FE56FB.title: "&aFlowglaze Smithing Template"
	quest.6D23296A1B69D601.quest_desc: ["&6Craft&r the Neon Tube and use it as a throwable torch. Toss it into dark areas to illuminate caves and other hard-to-reach places, or use it as a simple &bdecorative&r light source for your builds. It is one of the &bmiscellaneous&r blocks added by Create: Misc \\& Things."]
	quest.6D23296A1B69D601.quest_subtitle: "Light the way with a throwable torch"
	quest.6D35AA41F1EDF93C.quest_desc: [
		"&dPyromancer&r Leggings are part of the Pyromancer Armor set in Iron's Spells 'n Spellbooks. When worn, they provide &b+6&r Armor, &b+125&r Max Mana, &b+10%&r Fire Spell Power and &b+5%&r Spell Power."
		""
		"They can be &bcrafted&r using 7 Arcane Cloth and 1 Fire Rune, or upgraded from Wizard Leggings with 1 Fire Rune at a Smithing Table."
	]
	quest.6D35AA41F1EDF93C.quest_subtitle: "Channel the blazing power of Fire magic through your armor"
	quest.6D3897F037E10D8A.quest_desc: [
		"&aCraft&r the Arctic Jacket using soft Arctic Fur gathered from the &bfrozen&r reaches of the Twilight Forest. Carefully stitched to trap warmth while remaining light and flexible, this jacket &boffers&r reliable protection against both the bitter cold and the dangers hidden within the &bicy&r wilderness."
		""
		"&aAs&r the centerpiece of the Arctic Armor set, it is designed for &bexplorers&r who refuse to let the frozen climate halt their journey. With every layer of &benchanted&r fur, you'll be &bbetter&r prepared to survive the unforgiving lands that lead to the Twilight Forest's final challenges."
	]
	quest.6D3897F037E10D8A.quest_subtitle: "Face the cold without fear"
	quest.6D43B733CCC136CD.quest_desc: ["&6The&r Reactor Fuel Acceptor is a &bkey&r component of the reactor system in Create: New Age. It provides a controlled way to introduce fuel into the reactor, &ballowing&r it to operate and &bgenerate&r the heat needed for nuclear power production."]
	quest.6D43B733CCC136CD.quest_subtitle: "Feed the reactor"
	quest.6D5BFEC387663B94.quest_desc: [
		"&aKnightmetal&r is a rare alloy &brecovered&r from the ancient halls of the Goblin Stronghold. Forged by a long-lost civilization, this remarkable metal combines incredible durability with razor-sharp edges, making it &bideal&r for crafting powerful weapons, sturdy armor, and specialized tools."
		""
		"&aThe&r alloy still bears the &bmarks&r of its original creators, carrying the legacy of knights who once defended the Twilight Forest. Mastering &bKnightmetal&r marks another major step in your journey, granting access to equipment worthy of the realm's greatest warriors."
	]
	quest.6D5BFEC387663B94.quest_subtitle: "The metal of forgotten champions"
	quest.6D8F9DB6E34D1401.quest_desc: ["&eBefore&r you lie 29 medieval-style armor sets, from the Hero’s Armor to the Dark Lord Armor. To &bclaim&r them, prepare a netherite armor and Moon Crystals, because no &brecipe&r works without them. Start by &bcrafting&r your first crystal."]
	quest.6D8F9DB6E34D1401.quest_subtitle: "Medieval armor with the soul of legends"
	quest.6D8F9DB6E34D1401.title: "&l&fWelcome &dFantasy Armor"
	quest.6D90046D7E576A03.quest_desc: ["&aCraft&r Neptunium Boots from Aquaculture 2. These powerful boots are made from Neptunium, a rare &bmaterial&r obtained from fishing treasures. They provide strong &bprotection&r and are part of the Neptunium armor set."]
	quest.6D90046D7E576A03.quest_subtitle: "Armor forged from ocean treasures"
	quest.6D99EAA99DE859AB.quest_desc: ["&6The&r Tesla Coil is an &badvanced&r electrical machine from Create Crafts \\& Additions. It uses Forge Energy to charge compatible electrical items and can also damage &bPlayers&r and Mobs with electric shocks. In version 1.6.0 for NeoForge 1.21.1, the Tesla Coil also emits light while active and &bcorrectly&r reports its remaining operating time when its energy supply is running low."]
	quest.6D99EAA99DE859AB.quest_subtitle: "Charge with a shocking amount of power"
	quest.6DCA252DF7E9A442.quest_desc: [
		"&6Every&r train needs a proper way to get aboard. Door Steps provide a compact and &bpractical&r step for your entrances, while the Andesite, Copper and Brass variants let you match them to the style of your train."
		""
		"&bCollect&r all three variants and give your train doors the finishing touch."
	]
	quest.6DCA252DF7E9A442.quest_subtitle: "A small step that makes a big difference."
	quest.6DED96BA9D01194D.quest_desc: ["&6Obtain&r both a Cogwheel and a Large Cogwheel from Create. Cogwheels transfer rotational force &bbetween&r mechanical components, while combining a small and large cogwheel allows you to change rotational speed. A small cogwheel spins twice as fast when &bpowered&r by a large one, while the large cogwheel &brotates&r at half the speed."]
	quest.6DED96BA9D01194D.quest_subtitle: "Master the gears of mechanical power"
	quest.6DED96BA9D01194D.title: "Cogwheels"
	quest.6E06C9D850E82200.quest_desc: [
		"&l&9Give&r&r your storage the ability to handle fluids with the Pump Upgrade. It allows fluids to be transferred between your storage and &bconnected&r fluid systems, making automated fluid management much easier."
		""
		"The Advanced Pump Upgrade expands these capabilities with more control over fluid transfers and filtering options. The Experience Pump Upgrade takes things even further, allowing your storage to &bhandle&r experience and transfer it when needed."
	]
	quest.6E06C9D850E82200.quest_subtitle: "Master the flow of fluids and experience"
	quest.6E06C9D850E82200.title: "Pump, Advanced Pump \\& Experience Pump Upgrade"
	quest.6E08CDB6F8B04B85.quest_desc: [
		"&eWhy&r settle for ordinary rewards?"
		""
		"The Golden Hook &bincreases&r the amount of experience dropped by creatures by 75%, making every fight a little more rewarding. A simple artifact for &badventurers&r who want to squeeze every bit of experience out of their enemies."
		""
		"&bMore&r kills. More XP. More power."
	]
	quest.6E08CDB6F8B04B85.quest_subtitle: "Turn every kill into a little more experience"
	quest.6E18CA1095B24FC2.quest_desc: ["&6A&r two-strand cable that makes connecting things easier. Its ends attach to pairs of ordinary terminals and to most consumer devices. Split it with a Cord Junction and join it to single &bwires&r at Sockets."]
	quest.6E18CA1095B24FC2.quest_subtitle: "A two-strand cable"
	quest.6E20EEF9FF78206E.quest_desc: ["&dA&r special crafting &bmaterial&r used exclusively to craft Sacred item in Hazen N Stuff."]
	quest.6E20EEF9FF78206E.quest_subtitle: "A rare material for crafting Sacred items"
	quest.6E2E1132DC61E5F7.quest_desc: [
		"&dThe&r Greater Conjurer's Talisman grants &b+15%&r Summon Damage, making your summoned creatures more &bpowerful&r in combat. It also prevents summon spells from going on cooldown when their summons naturally time out."
		""
		"&bUpgrade&r your summoning magic and keep your conjured allies ready for battle."
	]
	quest.6E2E1132DC61E5F7.quest_subtitle: "Empower your summons and keep them fighting"
	quest.6E2F60D8F1FD2ACB.quest_desc: ["&dFrostbound&r is a shimmering scythe that appears to be made of ice. It is &bdesigned&r for area control and balanced damage."]
	quest.6E2F60D8F1FD2ACB.quest_subtitle: "Blade of Eternal Ice"
	quest.6E2F60D8F1FD2ACB.title: "&l&bFrostbound"
	quest.6E3796A9DA8F05DC.quest_desc: [
		"&6A&r good train is built with more than just &bengines&r and carriages. Grab Bars provide a practical way to climb aboard and move around your train, while their different &bmaterials&r let you match them to your build."
		""
		"&bCollect&r all three variants — Andesite, Brass and Copper — and add the finishing touches to your train."
	]
	quest.6E3796A9DA8F05DC.quest_subtitle: "Hold on tight and make every train feel complete."
	quest.6E4806E64F05905B.quest_desc: ["&6The&r Fan Component is a module for the Brass Drone from Create Stuff 'N Additions. Install it on a Brass Drone to give the drone an &badditional&r movement capability. It is one of the drone modules &bintroduced&r alongside the Brass Drone, including the Drill Head and Vault Component."]
	quest.6E4806E64F05905B.quest_subtitle: "Give your drone some lift"
	quest.6E537C91E3C6460F.quest_desc: [
		"&eLava&r doesn't have to be the end of the road."
		""
		"Strider Shoes allow you to &bstand&r on lava while sneaking, letting you cross Nether lakes and lava pools without falling in. They also &bprotect&r you from hot floor damage, such as damage from Magma Blocks."
		""
		"&bTread&r carefully. The lava won't stop you."
	]
	quest.6E537C91E3C6460F.quest_subtitle: "Walk where others would burn"
	quest.6E544C273282B915.title: "&l&9Hydra"
	quest.6E5852928DBF6ED0.quest_desc: [
		"The &aUnderminer&r is a specialized mining tool from Eternal Starlight."
		"It is listed as a dedicated digging/mining item &bused&r for resource extraction and advanced underground exploration."
		""
		"Exact &aacquisition&r depends on progression or loot sources within the mod."
	]
	quest.6E5852928DBF6ED0.quest_subtitle: "Deep mining tool"
	quest.6E5852928DBF6ED0.title: "&6Underminer"
	quest.6E780ADB22239DF7.quest_desc: [
		"The Aeternium Leggings are crafted by upgrading Terminite Leggings with an &aAeternium&r Forged Plate at a Smithing Table."
		""
		"They complete Better End's top armor tier, built for the most &bdangerous&r encounters."
	]
	quest.6E780ADB22239DF7.quest_subtitle: "Leggings of the strongest tier"
	quest.6E7E02CF0565B384.quest_subtitle: "More Armor"
	quest.6E98A4FCE3F28956.quest_desc: [
		"&dThe&r Grimoire of Evokation is a unique spellbook filled with powerful Evocation magic. It comes &bpre-inscribed&r with Fang Strike 6, Fang Ward 4 and Summon Vex 4. When equipped, it grants &b+10%&r Evocation Spell Power and &b+200&r Max Mana."
		""
		"This &brare&r grimoire can be &bobtained&r from Evokers or Archevokers. Wield it and turn the magic of the Evokers against your enemies."
	]
	quest.6E98A4FCE3F28956.quest_subtitle: "Command the magic of the Evokers"
	quest.6E9CB152EA753392.quest_desc: [
		"&aExplore &rthe Nether and locate a Bastion Remnant."
		"These dangerous structures are filled with Piglins, &bvaluable loot&r, and &bancient treasures&r."
	]
	quest.6E9CB152EA753392.quest_subtitle: "Find the Piglin stronghold"
	quest.6E9CB152EA753392.title: "&6Bastion &eRemnant"
	quest.6E9CF42B911A11A4.quest_desc: ["&aObtain&r the Ancient Remnant Music Disc from the Cataclysm mod. This &brare&r music disc is a unique trophy &bconnected&r to the Ancient Remnant, the ancient guardian of the Cursed Pyramid. Recover this forgotten &bmelody&r as proof of defeating one of the desert's greatest threats."]
	quest.6E9CF42B911A11A4.quest_subtitle: "A melody lost beneath the sands"
	quest.6EA3D5EB506CCEE7.quest_desc: [
		"Building large structures can take a lot of time."
		"Construction Sticks allow you to place multiple blocks at once, making building much faster and easier."
	]
	quest.6EA3D5EB506CCEE7.quest_subtitle: "Build Faster"
	quest.6EA3D5EB506CCEE7.title: "Construction Stick"
	quest.6EA9C38625CAF4F1.quest_desc: [
		"&aBlaze Powder&r is crafted from Blaze Rods and serves as an important ingredient in many brewing &brecipes&r."
		"It is also used to power Eyes of Ender, making it essential for locating Strongholds and progressing toward the End."
		"This fiery material is a key &bstep&r in mastering alchemy and dimensional travel."
	]
	quest.6EA9C38625CAF4F1.quest_subtitle: "Refined fire essence"
	quest.6EA9C38625CAF4F1.title: "Blaze Powder"
	quest.6EBEDBDF59557AFC.quest_desc: ["&dA&r special orb that &bincreases&r your maximum health by 5%."]
	quest.6EBEDBDF59557AFC.quest_subtitle: "An orb that increases your vitality"
	quest.6EC27F73D3545810.quest_desc: ["&dRemoves&r the &bblowback&r that pushes you backwards when you fire."]
	quest.6EC27F73D3545810.quest_subtitle: "Soak up the kick"
	quest.6EE1AB3433F08DC3.quest_subtitle: "Upgrade+"
	quest.6EE20B8BEC38306A.quest_desc: ["&6Craft&r the Mending Rune, a useful item from Create: Misc \\& Things. Use it to repair items that have the Mending enchantment by consuming &bexperience&r from your XP bar. The rune also has its own &bdurability&r system in newer versions."]
	quest.6EE20B8BEC38306A.quest_subtitle: "Restore your enchanted gear"
	quest.6EF082D1D7EC1E95.quest_subtitle: "Yummy!"
	quest.6EF8ED1E090A2BDF.quest_desc: ["&aDefeat&r Aptrgangr from the Cataclysm mod. This powerful undead &bboss&r can be found in the Frosted Prison and uses devastating &bmelee&r attacks. Prepare yourself for a difficult battle against one of the &bstrongest&r enemies of the frozen fortress."]
	quest.6EF8ED1E090A2BDF.quest_subtitle: "Defeat the undead guardian of the frozen prison"
	quest.6EF8ED1E090A2BDF.title: "Aptrgangr"
	quest.6EFF8F38EF2E56D8.quest_desc: [
		"&l&9Why&r&r settle for ordinary storage when you can create an endless supply? The Survival Infinity &bUpgrade&r allows you to designate items in your storage as infinite, letting you &bwithdraw&r them without depleting the stored amount."
		""
		"A powerful upgrade for those who have reached the end of their storage journey and want their most important &bresources&r to never run out."
	]
	quest.6EFF8F38EF2E56D8.quest_subtitle: "Make your most valuable resources last forever"
	quest.6F02A015F77B10ED.quest_desc: ["&dHemalite&r Shard is a rare crafting material from Crystal Chronicles. It is used to create the Sanguine Edge and to craft the Hermomancer Armor set by upgrading Cultist Armor. The shard carries the power of Blood magic, making it an essential material for &bblood-infused&r equipment."]
	quest.6F02A015F77B10ED.quest_subtitle: "A blood-infused crystal used to forge powerful Hemalite equipment"
	quest.6F0B2EE489B2B350.quest_desc: ["&6Obtain&r a Pulse Extender from Create. It extends a Redstone pulse for a &bconfigurable&r amount of time, allowing short signals to remain active long enough to control machines and other automated systems. Its duration can be adjusted from &b2&r ticks up to &b60&r minutes, and it can also be &binverted&r to remain powered by default and produce a temporary shutdown pulse."]
	quest.6F0B2EE489B2B350.quest_subtitle: "Keep the signal alive"
	quest.6F1A91F90359AAFB.quest_desc: ["&6The&r Mechanical Roller is a Contraption Actor designed to clear and pave paths. It has three modes: Clear Blocks and Pave, which breaks &bsuitable&r blocks and can replace them with a filtered block; Straight Fill Below, which fills spaces directly underneath; and Sloped Fill Below, which creates a sloped fill. Use a Filter to &bchoose&r which block the Roller places. It works while the &bContraption&r moves horizontally in the direction the Roller is facing."]
	quest.6F1A91F90359AAFB.quest_subtitle: "Build the road ahead"
	quest.6F1C1671731B5F06.quest_desc: [
		"The Crystalite Elytra is created through an Infusion Ritual using an Elytra, an Amber Gem, Enchanted Membranes, and Crystal Shards around an &aInfusion Pedestal&r."
		""
		"Worn with the full Crystalite set, it grants permanent &bRegeneration I&r on top of its own armor bonus."
	]
	quest.6F1C1671731B5F06.quest_subtitle: "Wings born from infusion"
	quest.6F1C1671731B5F06.title: "&dCrystalite Elytra"
	quest.6F232A26F0E2E273.quest_desc: ["&aObtain&r a Black Steel Ingot from the Cataclysm mod. This valuable material is &bused&r for crafting powerful weapons, armor, and equipment. It can be obtained from loot found in Cataclysm &bstructures&r and &bdefeated&r enemies."]
	quest.6F232A26F0E2E273.quest_subtitle: "A rare metal from frozen depths"
	quest.6F232A26F0E2E273.title: "&9Black Steel Ingot"
	quest.6F2A4EEABC255FE4.quest_subtitle: "Yummy!"
	quest.6F2D5D53FB939012.quest_desc: ["&dA&r special orb &bused&r to upgrade Cosmic equipment in Hazen N Stuff."]
	quest.6F2D5D53FB939012.quest_subtitle: "An orb infused with cosmic power"
	quest.6F2DEF08095B724C.quest_desc: ["&aThe&r Naga is the first major boss of the Twilight Forest and the guardian of the ancient Naga Courtyard. Defeating it marks the beginning of your journey through the dimension and unlocks the path to greater challenges. Though it may seem simple &bcompared&r to the foes ahead, underestimating the Naga can quickly lead to defeat."]
	quest.6F2DEF08095B724C.quest_subtitle: "The guardian of the Twilight Forest"
	quest.6F2DEF08095B724C.title: "&2Naga"
	quest.6F3FA05F0085411B.quest_desc: ["&6The&r Copper Magnet is a utility item and a Brass Drone module. When held, it slowly attracts nearby &bentities&r within a 4-block radius. Installed on a Brass Drone, it can be toggled &busing&r the Drone Controller. When active, the drone attracts nearby blocks, dropped items and entities, while &bcollected&r dropped items are stored inside the drone."]
	quest.6F3FA05F0085411B.quest_subtitle: "Pull everything closer"
	quest.6F439DAAF72A973C.quest_desc: [
		"&aThe&r Flowglaze Pickaxe is a mining tool from Eternal Starlight, part of the Flowglaze &bprogression&r tier."
		""
		"&aIt&r is crafted using Flowglaze &bmaterials&r and belongs to the mod’s mid-to-late game equipment system."
	]
	quest.6F439DAAF72A973C.quest_subtitle: "Flow-forged mining tool"
	quest.6F458F89F0C7BEB5.quest_desc: ["&6Obtain&r a Smart Observer from Create. It detects specific items or fluids in containers and can also detect a matching block &bplaced&r directly in front of it. When its filter conditions are met, it emits a Redstone signal, making it useful for &bautomated&r sorting, processing, and machine control. It can also be &bconnected&r to a Display Link to show information about the observed contents."]
	quest.6F458F89F0C7BEB5.quest_subtitle: "Watch the contents of your factory"
	quest.6F4A0425C3870A4F.quest_desc: [
		"&aComplete&r your Ironwood tool collection by crafting the Ironwood Hoe and Ironwood Shovel. Forged from Ironwood Ingots infused with the magic of the Twilight Forest, these tools make everyday tasks faster and more efficient while &bmaintaining&r the durability expected from enchanted equipment."
		""
		"&aWhether&r cultivating farmland or clearing paths through dirt, sand, and gravel, these tools are essential companions for every adventurer &bexploring&r the Twilight Forest."
	]
	quest.6F4A0425C3870A4F.quest_subtitle: "Prepare the land with enchanted craftsmanship"
	quest.6F4A0425C3870A4F.title: "Ironwood Utility Tools"
	quest.6F8761D2F89F0372.quest_subtitle: "More Armor"
	quest.6F9A5E6C090459E7.quest_desc: ["&6Build&r the Spud Sentry, a new defensive contraption added to Create: Dreams n' Desires. Put this &bpotato-powered&r sentry to work and give your factory an unusual way to deal with unwanted visitors. The Spud Sentry was &badded&r in Create: Dreams n' Desires 2.3a-BETA for Minecraft 1.21.1."]
	quest.6F9A5E6C090459E7.quest_subtitle: "Defend your factory with potatoes"
	quest.6FAEB69D37596618.quest_desc: ["&6Obtain&r a Cart Assembler from Create. &bPlaced&r on a rail and powered with Redstone, it can assemble blocks into a moving Minecart Contraption. It can also disassemble the contraption when the appropriate rail setup is used, &ballowing&r you to build mobile farms, machines, storage systems, and &bother&r moving creations."]
	quest.6FAEB69D37596618.quest_subtitle: "Put your machines on the move"
	quest.6FB249CCB42D948B.quest_subtitle: "Upgrade+"
	quest.6FBA5E25FD297832.quest_desc: ["&6A&r display you insert modules into: click an empty slot with a module and remove it with Shift + click. Click and hold a slot to change what the module displays, use a wrench to toggle the blanking page, and &bdye&r to change the color."]
	quest.6FBA5E25FD297832.quest_subtitle: "A modular display"
	quest.6FC589CAD68D5F0C.quest_subtitle: "More Armor"
	quest.6FD28B9BF9E8CCDA.quest_desc: ["&6Craft&r the Candy Cane in Create: Confectionery by mixing sugar and water with heat. This festive treat can be eaten to &brestore&r hunger and provides a short Haste effect."]
	quest.6FD28B9BF9E8CCDA.quest_subtitle: "A sweet little Christmas classic"
	quest.6FD3DE97948FF9A0.quest_desc: [
		"Sometimes you need to change blocks in an already built structure."
		"The Replacement Template allows your Construction Stick to replace existing blocks with new ones, making rebuilding and upgrading structures much easier."
		""
		"Use this upgrade to quickly modify your builds without breaking everything first."
	]
	quest.6FD3DE97948FF9A0.quest_subtitle: "Replace Blocks Easily"
	quest.6FD79C1CA4E34567.quest_subtitle: "More Armor"
	quest.6FDDB5076535054F.quest_desc: [
		"The &aAlchemy Bench&r allows you to create decorative variants of different blocks using mystical methods."
		"Experiment with materials and discover new styles for your builds."
	]
	quest.6FDDB5076535054F.quest_subtitle: "Transform your materials"
	quest.6FF58118772764FE.quest_desc: ["&aCraft&r the Dragon Bones Leggings from the Bosses' Rise mod. &bForged&r from the bones of ancient dragons, these legendary leggings provide powerful protection and embody the &bendurance&r of the &bcreatures&r that once ruled the skies. They are an essential part of the Dragon Bones Armor set."]
	quest.6FF58118772764FE.quest_subtitle: "Carry the strength of the ancient dragons"
	quest.7015C0190516B308.quest_subtitle: "More Weapon"
	quest.7026127DAD76EB74.quest_desc: [
		"&eGetting&r hit is sometimes unavoidable. Surviving the next hit is what matters."
		""
		"The Cross Necklace &bextends&r the brief period of invulnerability you receive after taking damage, giving you a little more time before you can be hurt again. By default, it adds 20 ticks — 1 second of &badditional&r invulnerability."
		""
		"When danger strikes, make &bevery&r moment of protection count."
	]
	quest.7026127DAD76EB74.quest_subtitle: "A second chance when every hit counts"
	quest.702BD2FE9B17086C.quest_desc: [
		"&aDiscover&r the Bismuth Formations, a biome added by Crystal Chronicles that appears within the End."
		""
		"Here you can gather &bBismuth&r to build a portal frame and, once assembled with a Bismuth Chisel, open a way into a vast &bunderground&r dimension tied to the Schools of Magic."
	]
	quest.702BD2FE9B17086C.quest_subtitle: "Where the schools of magic begin"
	quest.702BD2FE9B17086C.title: "Bismuth Formations"
	quest.70427EAC20FC848B.quest_desc: [
		"Within the eerie &alands&r of Eternal Starlight, Seekers hunt anything that moves."
		"They are fast, aggressive, and relentless — once they &bspot&r you, escape &abecomes&r difficult."
		""
		"Learning to fight them is &bessential&r for surviving deeper exploration in this dangerous dimension."
	]
	quest.70427EAC20FC848B.quest_subtitle: "Relentless pursuit"
	quest.70427EAC20FC848B.title: "Seeker"
	quest.7056B4CA80E9CA75.quest_desc: [
		"&aObtain&r a Phantom Membrane, dropped by Phantoms."
		""
		"Beyond repairing an Elytra, it's the base ingredient for crafting Better End's &bEnchanted Membrane&r through an Infusion Ritual."
	]
	quest.7056B4CA80E9CA75.quest_subtitle: "Wings of a fallen phantom"
	quest.705A370ACF2D3F25.quest_desc: ["&aCraft&r the Ignitium Leggings from the Cataclysm mod. Forged from the &blegendary&r Ignitium metal, these leggings provide incredible protection and represent the power of the Nether's flames. They are an essential part of the &bcomplete&r Ignitium Armor Set, created from the might of the &bLord&r of Fire."]
	quest.705A370ACF2D3F25.quest_subtitle: "Armor of the eternal inferno"
	quest.7066AD43EB0ADC06.quest_desc: [
		"&9&lStay&r&r informed about your Refined Storage autocrafting jobs with the Autocrafting Monitor. It displays active crafting requests and their progress, &ballowing&r you to quickly see what your network is currently producing."
		""
		"&bUse&r it to monitor complex crafting &bprocesses&r and keep your automated production under control."
	]
	quest.7066AD43EB0ADC06.quest_subtitle: "Keep track of every automated crafting job"
	quest.7070E5B28A04197E.quest_desc: ["&aCraft&r Cursium Leggings from the Cataclysm mod. These &bpowerful&r leggings are created by upgrading Netherite Leggings with a Cursium Upgrade Smithing Template and a Cursium Ingot in a Smithing Table. They are &bpart&r of the Cursium armor set and grant the Ethereal Form ability, giving a chance to dodge &bincoming&r attacks."]
	quest.7070E5B28A04197E.quest_subtitle: "Armor of the cursed warrior"
	quest.70763861AE1AC983.quest_desc: ["&6The&r Reactor Rod is a core component of the reactor system in Create: New Age. &bIt&r plays an &bessential&r role in the reactor's operation, working together with the fuel and heat-management components to generate the intense heat needed for &badvanced&r power production."]
	quest.70763861AE1AC983.quest_subtitle: "Harness the reactor's core"
	quest.7083BF753227DE31.quest_desc: ["&6Welcome&r to Create: Escalated! Take advantage of functional, &brotation-powered&r walkways and escalators to move around your factory in style. Build your own &bvertical&r transportation systems and make &bgetting&r around your factory faster and more convenient. Create: Escalated adds &bwalkways&r and escalators in two materials, powered by Create's rotational force."]
	quest.7083BF753227DE31.quest_subtitle: "    Take your factory to new heights"
	quest.7083BF753227DE31.title: "&l&6Welcome Create Escalated"
	quest.708A96BAB4E8D0ED.quest_desc: ["&6The&r Slime Helmet is part of the slime equipment from Create Stuff 'N Additions. It is &bdesigned&r to work together with the Slime Boots, &bgiving&r you a bouncy and safer way to move around. The helmet also has a special interaction with Elytra: it can prevent Elytra durability damage. The mod &bspecifically&r fixed the Slime Helmet's functionality in the 1.21.1 version."]
	quest.708A96BAB4E8D0ED.quest_subtitle: "Bounce without breaking"
	quest.70976C640A457C6E.quest_desc: ["&6Prepare&r a Strawberry Milkshake and fill a bucket with it. Add this sweet and &brefreshing&r drink to your growing &bcollection&r of milkshake recipes from Create: Dreams n' Desires."]
	quest.70976C640A457C6E.quest_subtitle: "Sweeten up the factory"
	quest.70A005B30CBCEB48.quest_desc: ["&aThe&r Netherite Grappling Hook is the &bhighest-tier&r version of the grappling hook. Use it to move &befficiently&r through the world and overcome &bhard-to-reach&r areas."]
	quest.70A005B30CBCEB48.quest_subtitle: "Power Worthy of the Nether"
	quest.70A2C0FAD2525DC3.quest_desc: [
		"&aObtain&r a full set of Chainmail Armor, a rare suit forged from &binterlocking&r iron rings. Unlike most armor, Chainmail cannot normally be crafted, making every piece a &bvaluable&r reward earned through exploration, combat, or trading."
		""
		"&aThough&r lighter than solid &bplate&r armor, Chainmail offers reliable protection and serves as a symbol of an &bexperienced&r adventurer. Completing the full set proves your willingness to seek out &btreasures&r beyond the crafting table."
	]
	quest.70A2C0FAD2525DC3.quest_subtitle: "Protection woven from iron"
	quest.70A2C0FAD2525DC3.title: "Chainmail Armor"
	quest.70AC11285D941F01.quest_desc: ["&6The&r Zinc Chestplate is part of the Zinc Suit &badded&r by Create Stuff 'N Additions. It provides an &balternative&r set of armor made from Zinc and has &b320&r durability. Craft it using &b8&r Zinc Ingots."]
	quest.70AC11285D941F01.quest_subtitle: "Stronger than it looks"
	quest.70BA04BBF382CAE6.quest_desc: [
		"&dThe&r Blaze Instruction Manual is a rare spellbook associated with the Fire school in Iron's Spells 'n Spellbooks. It provides &b10&r spell slots, &b+10%&r Fire Spell Power and &b+200&r Max Mana, making it an excellent choice for a mage &bspecializing&r in fire magic. It is a rare drop from Blazes."
		""
		"&bEquip&r the manual and unleash stronger fire spells while carrying a larger reserve of mana."
	]
	quest.70BA04BBF382CAE6.quest_subtitle: "Master the destructive power of fire"
	quest.70BBFCA56B2B7A3B.quest_desc: [
		"The Terminite Ingot is forged in an &aEnd Stone Smeltery&r by combining a Thallasium Ingot (or Iron Ingot) with End Dust."
		""
		"It can also rarely be found in Better End structures, and is used to craft &bstronger&r tools, armor, and anvils."
	]
	quest.70BBFCA56B2B7A3B.quest_subtitle: "Metal of the second tier"
	quest.70C45779F8D6D4C2.quest_desc: ["&dA&r special orb that &benhances&r Eldritch weapons and armor."]
	quest.70C45779F8D6D4C2.quest_subtitle: "An orb that strengthens Eldritch power"
	quest.70C963CA48DC1406.quest_desc: [
		"&l&9No&r&r more searching for a crafting table every time you need to make something. The Crafting Upgrade adds a &bbuilt-in&r crafting grid directly to your backpack, letting you craft wherever your adventure takes you."
		""
		"The &bcrafting&r grid keeps its items even when the backpack is closed and supports recipe filling through JEI, REI and EMI."
	]
	quest.70C963CA48DC1406.quest_subtitle: "A crafting table that travels with you"
	quest.70CC95DB7E5F0ACB.quest_desc: [
		"&aDiscover&r the Lantern Woods, a vibrant forest where flowers resembling glowing &blanterns&r hang from the trees and drift through the air."
		""
		"Its soft light makes it one of the more welcoming biomes of the End — a good place to gather &bresources&r safely."
	]
	quest.70CC95DB7E5F0ACB.quest_subtitle: "Forest of glowing lanterns"
	quest.70CC95DB7E5F0ACB.title: "Lantern Woods"
	quest.70CF4CD3D8FE3489.quest_desc: ["&6Mechanical&r Pistons &buse&r rotational power to extend and retract Piston Extension Poles, allowing them to push Create contraptions. The piston &bextends&r according to the number of Extension Poles attached to it, rather than &bmoving&r only one block at a time. With a Slimeball, it can be &bturned&r into a Sticky Mechanical Piston, allowing it to pull the pushed blocks back when retracting."]
	quest.70CF4CD3D8FE3489.quest_subtitle: "Push it further"
	quest.70CF4CD3D8FE3489.title: "Mechanical Piston \\& Sticky Mechanical Piston"
	quest.70EFEC783ADBE394.quest_subtitle: "More Armor"
	quest.70F0656B6D0E98EE.quest_subtitle: "Yummy!"
	quest.70F0A7670BA3DF20.quest_desc: ["&6A&r blank board for a circuit. Cut a wooden slab with a Create saw."]
	quest.70F0A7670BA3DF20.quest_subtitle: "A blank circuit"
	quest.7114C6B3463D3C25.quest_subtitle: "Upgrade+"
	quest.71216CD0DAB58DCB.quest_subtitle: "Upgrade+"
	quest.712C7D49715DBF88.quest_desc: ["&l&9No&r&r need to carry a stonecutter everywhere you travel. The Stonecutter Upgrade adds a fully functional stonecutter &bdirectly&r to your backpack, letting you process blocks without placing a workstation in the world. It also &bremembers&r your last recipe and automatically selects it again when you &binsert&r the same block, making repeated stonecutting much faster."]
	quest.712C7D49715DBF88.quest_subtitle: "Take precision stonecutting wherever you go"
	quest.71312A25176585F6.quest_desc: [
		"&9&lAs&r&r your collection continues to grow, a 16k Storage Disk gives your Refined Storage network the capacity it needs. With &bsignificantly&r more storage than the smaller tiers, it allows you to keep a huge amount of resources in a single digital storage system."
		""
		"&bInsert&r it into a Disk Drive and keep building toward even greater storage capacity."
	]
	quest.71312A25176585F6.quest_subtitle: "Take your digital storage to the next level"
	quest.7149C97501E38AF7.quest_subtitle: "More Armor"
	quest.714A619197D756CD.quest_desc: ["&aCraft&r the Mechanical Fusion Anvil from L_Ender’s Cataclysm. This powerful &bcrafting&r station combines high-tier weapons, armor, and rare &bmaterials&r to create upgraded equipment. &bIts&r recipe requires 6 Witherite Ingots, 2 Blocks of Redstone, and an Anvil."]
	quest.714A619197D756CD.quest_subtitle: "Forge the weapons of the ancient machine"
	quest.714A619197D756CD.title: "&cMechanical Fusion Anvil"
	quest.716CE65977CDDAD9.quest_desc: [
		"&aCraft&r the Steeleaf Helmet using the enchanted Steeleaf material discovered within the Twilight Forest. Forged from leaves strengthened by ancient forest magic, this helmet provides reliable protection while embodying the &bharmony&r between nature and craftsmanship."
		""
		"&aAs&r part of the Steeleaf Armor set, it offers an excellent balance of durability and defense, making it an ideal choice for adventurers preparing to &bexplore&r the deeper regions of the Twilight Forest."
	]
	quest.716CE65977CDDAD9.quest_subtitle: "A crown of enchanted leaves"
	quest.717404B34A4CA9E5.quest_subtitle: "Yummy!"
	quest.71824AC78C66F629.quest_desc: ["&dHogskin&r is a crafting material in Iron's Spells 'n Spellbooks, dropped by Hoglins. It is &bused&r to craft magical &bitems&r and can also be turned into Leather."]
	quest.71824AC78C66F629.quest_subtitle: "Harvest the hide of the Nether's wild beasts"
	quest.7184322815D40F10.quest_desc: [
		"&aAt&r the summit of the magnificent Aurora &bPalace&r awaits the Snow Queen, the final sovereign of the frozen lands and one of the most powerful rulers of the Twilight Forest. Surrounded by living ice and &bancient&r magic, she commands the fury of winter itself, refusing to let anyone claim the secrets &bhidden&r beyond her domain."
		""
		"&aThe&r Snow Queen is a &bmaster&r of aerial combat, shifting between multiple phases as she summons floating ice shields, rains deadly icicles upon her enemies, and unleashes &bdevastating&r blasts of &bfrozen&r magic. Only those who can adapt to every phase of the battle will be able to claim victory."
		""
		"&aDefeating&r the Snow Queen marks the &bcompletion&r of one of the Twilight Forest's greatest adventures. With the eternal winter finally broken, the &bpath&r to the deepest mysteries of the enchanted realm lies open before you."
	]
	quest.7184322815D40F10.quest_subtitle: "Bring an end to the eternal winter"
	quest.7184322815D40F10.title: "&l&bSnow&9Queen"
	quest.71C599C45F9993E4.quest_desc: [
		"&9&lThe&r&r Oak Barrel is a basic storage &bcontainer&r from Sophisticated Storage, offering a compact way to &borganize&r and store your items."
		""
		"&bThanks&r to the mod's upgrade system, the barrel can be expanded with additional storage capacity and &bspecialized&r upgrades, making it a versatile part of any storage setup."
	]
	quest.71C599C45F9993E4.quest_subtitle: "Compact storage with room to grow"
	quest.71DB07520840057B.quest_desc: ["&6Used&r to extend and split Copper Cords. Place it where a cord should branch or needs to be longer."]
	quest.71DB07520840057B.quest_subtitle: "Extend and split cords"
	quest.71F4EDD39B779AF9.quest_desc: ["&dAdds&r extra &bbullets&r to every shot, turning any gun into a spread weapon. Each bullet deals less &bdamage&r, so it shines up close."]
	quest.71F4EDD39B779AF9.quest_subtitle: "Many bullets, one shot"
	quest.71F98F53EE7BC8A4.quest_desc: ["&dA&r special crafting template used to create Flaming &bequipment&r in Hazen N Stuff."]
	quest.71F98F53EE7BC8A4.quest_subtitle: "A fiery template for powerful crafting"
	quest.71FD40B986C9AF50.quest_desc: ["&6Copper&r Wire is a basic electrical component from Create Crafts \\& Additions. It is produced using the Rolling Mill and is used to craft &belectrical&r components and connections. It forms one of the first &bsteps&r toward building your electrical network and &bconnecting&r machines that use Forge Energy."]
	quest.71FD40B986C9AF50.quest_subtitle: "Carry electricity through your factory"
	quest.722217A507114210.quest_desc: ["&6Craft&r the Sprinkler and give your crops a boost. When supplied &bwith&r diluted bonemeal, it accelerates plant growth within a &b5×5&r area, making it useful for compact automated farms. The Sprinkler was &bintroduced&r in Create: Misc \\& Things 4.0."]
	quest.722217A507114210.quest_subtitle: "Keep your crops growing"
	quest.723C50A0AF1A155C.quest_desc: ["&eIt's&r time to leave the ground behind! Clockwork Wings let you &btake&r to the air and unlock new ways to move around. Discover how these mechanical wings work and use them to explore the world from an &bentirely&r new perspective. The sky is yours to conquer!"]
	quest.723C50A0AF1A155C.quest_subtitle: "Take to the Skies"
	quest.724D1288AD744051.quest_desc: [
		"The Thermal Springstone Hammer is a &aheavy&r impact weapon from Eternal Starlight crafted &busing&r Thermal Springstone Ingots."
		""
		"&aIt&r delivers slow but powerful strikes with high knockback, making it effective for crowd control in mid-tier combat &bprogression&r."
	]
	quest.724D1288AD744051.quest_subtitle: "Geothermal impact weapon"
	quest.724FD4C593826FE9.quest_desc: [
		"&dPrismatic&r Knight Helmet is part of the Prismatic Knight Armor set, the strongest armor set in Crystal Chronicles."
		""
		"It is crafted &busing&r a Divine Soulshard from Iron’s Spells ’n Spellbooks and can be created by &bupgrading&r the helmet from any enhanced Crystal Chronicles armor set. The Prismatic Knight Armor &brepresents&r the final and most powerful stage of the Crystal Chronicles armor progression."
	]
	quest.724FD4C593826FE9.quest_subtitle: "The ultimate helmet forged from the power of the Crystal Chronicles"
	quest.7252812119B93C29.quest_desc: [
		"&aThe Cinderous Soulcaller&r is a powerful magical foe from the depths of Iron’s Spells ‘n Spellbooks."
		"This enemy manipulates fire and souls at the same time, creating &bdangerous&r attacks that can burn and drain your life essence."
		"Defeating it requires strong magical resistance and careful movement, as its abilities can overwhelm unprepared &badventurers&r."
	]
	quest.7252812119B93C29.quest_subtitle: "Flames and souls entwined"
	quest.7252812119B93C29.title: "&6Cinde&erous &7Soulcaller"
	quest.7256C1684DCFEE60.quest_desc: ["&eNaturalist&r brings a variety of animals to the Minecraft world, making its biomes feel &bmore&r alive and diverse. Discover &bnew&r species, observe their behavior, and explore the world of wildlife."]
	quest.7256C1684DCFEE60.quest_subtitle: "          Discover the Wildlife      "
	quest.7256C1684DCFEE60.title: "&f&lWelcome &aNaturalist"
	quest.7258712F5D2D8539.quest_subtitle: "More Armor"
	quest.7261635BE6E853F7.quest_desc: [
		"&aCraft&r the Tri-Bow, a masterfully &benchanted&r weapon forged with the magic of the Twilight Forest. Unlike an ordinary bow, every shot releases three arrows at once, allowing you to overwhelm enemies with a &bdevastating&r volley while maintaining remarkable accuracy."
		""
		"&aFavored&r by skilled archers and &blegendary&r hunters, the Tri-Bow excels against both groups of monsters and powerful bosses. Its unique &benchantment&r transforms a single arrow into a deadly barrage, proving that &bprecision&r and overwhelming firepower can exist in perfect harmony."
	]
	quest.7261635BE6E853F7.quest_subtitle: "One shot, three arrows"
	quest.7262CBE4093FBD31.quest_desc: ["&aObtain&r the Ignis Music Disc from the Cataclysm mod. This rare &bmusic&r disc is an exclusive trophy dropped by Ignis, the mighty &bruler&r of the Burning Arena. Recover this blazing melody as proof of your &bvictory&r over one of the Nether's greatest champions."]
	quest.7262CBE4093FBD31.quest_subtitle: "The echo of the Lord of Fire"
	quest.7268819963CA1643.quest_subtitle: "More Armor"
	quest.727317B8BF1A8C21.quest_desc: [
		"&aHidden&r within the blazing Fire Swamp dwells one of the most terrifying creatures in the Twilight Forest—the Hydra. This colossal, many-headed beast has ruled the scorched &bmarshlands&r for ages, &breducing&r anyone foolish enough to challenge it to ashes."
		""
		"&aEach&r of the Hydra's heads is capable of &bunleashing&r devastating attacks, from torrents of fire to powerful bites that can crush even the strongest warriors. As the battle progresses, the beast becomes even more dangerous, forcing you to stay alert and adapt to its &brelentless&r assault."
		""
		"&aDefeating&r the Hydra is a &bdefining&r moment in your adventure. Beyond proving your strength, it grants access to valuable treasures and brings you one step closer to uncovering the deepest &bsecrets&r of the Twilight Forest."
	]
	quest.727317B8BF1A8C21.quest_subtitle: "Slay the beast of the Fire Swamp"
	quest.727317B8BF1A8C21.title: "&9&lHydra"
	quest.727A8816DF2E0057.quest_subtitle: "More Weapon"
	quest.727BB2535A4613E5.quest_desc: ["&aObtain&r the Bloom Stone Skirt from the Cataclysm: Spellbooks addon. Add this powerful piece of equipment to your collection and continue your journey through the &bsecrets&r and &brelics&r introduced by the addon."]
	quest.727BB2535A4613E5.quest_subtitle: "Power born from ancient stone"
	quest.727FBC47B6C610E7.quest_desc: ["&6The&r Experience Shovel is a special shovel from Create Stuff 'N Additions. When mining blocks, it has a chance to &bgenerate&r an Experience Orb, giving you additional XP while &bgathering&r resources. It has 270 durability, an Iron mining level, deals 4 attack damage and has 1.7 attack speed. It is crafted &busing&r 3 Heaps of Experience and 2 Zinc Tool Handles."]
	quest.727FBC47B6C610E7.quest_subtitle: "Dig your way to more experience"
	quest.7282EA488D3599CE.quest_desc: ["&6The&r Copper Chestplate is part of the Copper Suit from Create Stuff 'N Additions. It provides &b6&r armor points and &b1&r armor toughness, matching the protection of an Iron Chestplate while offering higher durability. The chestplate has &b240&r durability and can be &brepaired&r with Honeycombs in an Anvil. It is crafted from &b8&r Copper Ingots."]
	quest.7282EA488D3599CE.quest_subtitle: "Reliable protection, powered by copper"
	quest.728C59A3A21CEDFE.quest_desc: ["&6Welcome&r to Create: Connected! This addon expands Create with quality-of-life blocks and technical components &bdesigned&r to make your factory more flexible. Discover new clutches, gearboxes, redstone components, rotated vaults and tanks, along with &benhancements&r to existing Create mechanics."]
	quest.728C59A3A21CEDFE.quest_subtitle: "Connect your factory like never before"
	quest.728C59A3A21CEDFE.title: "&l&6Welcome Create Connected"
	quest.729E05B09A10784F.quest_desc: [
		"&9&lYour&r&r fluid network is growing, and so should your &bstorage&r capacity. The 256B Fluid Storage Disk provides a &bmassive&r amount of digital fluid storage, allowing your Refined Storage network to hold far more liquids than the 64B tier."
		""
		"Insert it into a Disk Drive and keep &bexpanding&r your centralized fluid storage system."
	]
	quest.729E05B09A10784F.quest_subtitle: "Take your fluid storage to massive proportions"
	quest.72B645B303EDCEAF.quest_subtitle: "More Armor"
	quest.72D1FBC4D676696D.quest_desc: [
		"&dCommon&r Ink is the most basic magical ink in Iron's Spells 'n Spellbooks. It is used in the Scroll Forge to create Common-rarity spell scrolls, making it an &bessential&r resource for &bbeginning&r spellcasters."
		""
		"Find it in magical structures or obtain it from powerful magical creatures, then use it to begin building your &bcollection&r of spells."
	]
	quest.72D1FBC4D676696D.quest_subtitle: "The first step toward mastering magic"
	quest.72D4315ABFB04B00.quest_desc: [
		"&9&lTake&r&r control of how items are distributed through your Refined Storage network with the Regulator Upgrade. It helps maintain &bconfigured&r quantities of selected items in connected inventories, &bautomatically&r supplying or removing resources when needed."
		""
		"&bUse&r it to keep machines stocked, maintain precise item levels and create &breliable&r automated production systems."
	]
	quest.72D4315ABFB04B00.quest_subtitle: "Keep your automated storage perfectly balanced"
	quest.72D51A00E1D552EA.quest_desc: [
		"&aObtain&r the Terminite Upgrade Smithing Template, used at a Smithing Table to apply Terminite-tier upgrades to compatible tools and armor."
		""
		"Terminite sits between &bThallasium&r and &bAeternium&r, forged from Thallasium Ingots and End Dust."
	]
	quest.72D51A00E1D552EA.quest_subtitle: "Upgrading toward Terminite"
	quest.72E28BC9EFD626FD.quest_desc: [
		"&aThe&r Flowglaze Shield is a defensive item from Eternal Starlight, belonging to the Flowglaze &bequipment&r tier."
		""
		"&aIt&r is used for blocking incoming damage and forms part of the mid-to-late game Flowglaze &bprogression&r system."
	]
	quest.72E28BC9EFD626FD.quest_subtitle: "Flow defensive gear"
	quest.72F735CEFAEFB084.quest_desc: ["&6Craft&r the Ruby Chocolate Bucket and store liquid Ruby Chocolate for your confectionery factory. Use it to transport and handle ruby chocolate in automated &bproduction&r lines alongside the other chocolate varieties from Create: Confectionery. Ruby chocolate is known for its naturally pink &bcolour&r and fruity, slightly sour flavour."]
	quest.72F735CEFAEFB084.quest_subtitle: "Carry a vibrant sweetness wherever you go"
	quest.72F9FD1FB4160E14.quest_desc: ["&aCraft&r the Ignitium Helmet from the Cataclysm mod. Forged from the &blegendary&r Ignitium metal, this helmet &bprotects&r its wearer with the power of the Nether's eternal flames. It is a crucial piece of the &bIgnitium&r Armor Set, created from the remnants of the Lord of Fire."]
	quest.72F9FD1FB4160E14.quest_subtitle: "The crown of the infernal warrior"
	quest.72FB636CAA9777CD.quest_desc: [
		"&l&9Why&r&r carry a heavy anvil &bwhen&r your backpack can do the job? The Anvil Upgrade adds full anvil functionality directly to your backpack, allowing you to repair, rename and combine items without placing an anvil in the world."
		""
		"Keep your gear in top &bcondition&r and make quick repairs wherever you are."
	]
	quest.72FB636CAA9777CD.quest_subtitle: "Bring the anvil wherever your adventure takes you"
	quest.72FC9FCB998D4D92.quest_desc: ["&aLocate&r the Burning Arena from the Cataclysm mod. Hidden deep within the Nether, this colossal fortress is the domain of Ignis, one of the mightiest warriors of the &binfernal&r realm. Prepare yourself before entering, as only the &bstrongest&r adventurers can survive its blazing halls."]
	quest.72FC9FCB998D4D92.quest_subtitle: "Seek the throne of the Lord of Fire"
	quest.72FC9FCB998D4D92.title: "&l&6Burning &3Arena"
	quest.730AEE092EF6ACE0.quest_desc: [
		"Craft a &aCamera Stand&r to hold your camera in place for precise and steady shots."
		"&bUse&r it to capture detailed photos without worrying about moving the camera."
	]
	quest.730AEE092EF6ACE0.quest_subtitle: "Stabilize your shots"
	quest.7325805123A3A0A0.quest_desc: [
		"&dEnder&r Rune is a crafting ingredient in Iron's Spells 'n Spellbooks, &bused&r for advanced &bEnder-related&r crafting, including the Ender Upgrade Orb. The Ender school uses Ender Pearl as its magical Focus."
		""
		"&bCreate&r an Ender Rune by combining 1 Blank Runestone with 8 Ender Pearls."
	]
	quest.7325805123A3A0A0.quest_subtitle: "Infuse a runestone with the mysterious power of the End"
	quest.7326A1D524CC68F0.quest_desc: [
		"&9&lExpand&r&r your Refined Storage network with the Relay. It allows you to connect and extend your network across greater distances, helping you &breach&r devices and storage &bsystems&r that are farther away."
		""
		"&bUse&r the Relay to create a more flexible network layout and connect distant &bparts&r of your automated storage system."
	]
	quest.7326A1D524CC68F0.quest_subtitle: "Extend your network where cables cannot reach"
	quest.7337E3FD3B967AF3.quest_subtitle: "Yummy!"
	quest.733A8E5ACBBCCACD.quest_desc: [
		"&6Take&r aircraft control to the next level with an electronic flight display. The Electronic Gyroscope provides improved &bstabilization&r and completely eliminates the effects of wind, while its HUD keeps you informed about your speed, pitch and potential warnings during flight."
		""
		"&bInstall&r it, take off and keep every important detail under control."
	]
	quest.733A8E5ACBBCCACD.quest_subtitle: "Precision flight data, right before your eyes."
	quest.7351860AE2725AD2.quest_subtitle: "More Armor"
	quest.7358802FCC5E65C9.quest_subtitle: "More Weapon"
	quest.73614AFF4C52DABE.quest_desc: [
		"&9&lReach&r&r the highest level of Fortune with the Fortune III Upgrade. It provides Fortune III to compatible operations, giving you the greatest &bchance&r of obtaining &badditional&r resources from supported blocks."
		""
		"&bEquip&r your &bautomated&r systems with maximum Fortune and get the most out of every mining operation."
	]
	quest.73614AFF4C52DABE.quest_subtitle: "Maximize the yield from every mining operation"
	quest.7378F112C09BB03F.quest_desc: ["&6A&r smaller version of the Contactor. When you give it the configured &bvoltage&r it switches the normally open terminal, so a weaker signal can switch another circuit."]
	quest.7378F112C09BB03F.quest_subtitle: "A relay"
	quest.737EB4074AEB68A2.quest_subtitle: "More Armor"
	quest.738623F2EBA30C3C.quest_desc: ["&6The&r Omni Gearbox is a versatile mechanical component added by Create: Dreams n' Desires. It expands your factory's rotational &bsetups&r by providing a flexible way to connect and redirect mechanical power. &bUse&r it to create more compact and versatile kinetic networks. The Omni Gearbox was &badded&r in the 2.2a-BETA update for Minecraft 1.21–1.21.1."]
	quest.738623F2EBA30C3C.quest_subtitle: "Connect rotation from every direction"
	quest.73904E581F79BC87.quest_desc: ["Venture into the caves or mountains and find a shiny amethyst shard. These crystals are known for their magical energy and can be used for &acrafting powerful items&r."]
	quest.73904E581F79BC87.quest_subtitle: "Mine a Shard"
	quest.73904E581F79BC87.title: "Amethyst Shard"
	quest.73B9CB51E29B93C1.quest_subtitle: "More Armor"
	quest.73C49BF00B7BF875.quest_subtitle: "Yummy!"
	quest.73C4B1140491C2EF.quest_desc: [
		"&dThe&r Necronomicon is a unique spellbook dropped by the Dead King. It comes pre-inscribed with Blood Slash 5, Blood Step 5, Ray of Siphoning 5 and Blaze Storm 5. It also grants &b+2&r levels to Raise Dead and &b+200&r Max Mana when &bequipped&r as a Spell Book."
		""
		"Wield this &bforbidden&r tome and harness powerful blood magic while commanding the dead."
	]
	quest.73C4B1140491C2EF.quest_subtitle: "Command the forbidden power of the dead"
	quest.73D726572EA95ACF.quest_desc: ["&aCraft&r a Black Steel Shovel from the Cataclysm mod. This powerful tool is made using Black Steel and provides high &bdurability&r and &befficiency&r for digging. It is part of the Black Steel equipment set."]
	quest.73D726572EA95ACF.quest_subtitle: "A tool forged from black steel"
	quest.73EDF585EE03CE80.quest_subtitle: "More Armor"
	quest.73F194B01A86C9E1.quest_desc: ["&6Gold&r Wire is an electrical crafting component from Create Crafts \\& Additions. It is produced using the Rolling Mill by &bprocessing&r a Gold Sheet, yielding 2 Gold Wires. It is used in electrical components such as the Gold Spool and can also be used as an alternative to &bElectrum&r Wire in certain recipes."]
	quest.73F194B01A86C9E1.quest_subtitle: "Conduct electricity with precision"
	quest.74218BCBDC5E5E3D.quest_desc: ["&aThe fusion&r of diamond and Netherite results in extremely powerful gear. These boots provide top-tier &bprotection&r and &bdurability&r for the most &adangerous&r challenges."]
	quest.74218BCBDC5E5E3D.quest_subtitle: "Unmatched durability"
	quest.74218BCBDC5E5E3D.title: "Diamond Netherite Boots"
	quest.743E85C4F3586BBD.quest_desc: [
		"&aThe&r Starfire Pickaxe is a high-tier mining tool from Eternal Starlight, part of the Starfire &bprogression&r system."
		""
		"&aIt&r is crafted using smithing-based mechanics and advanced &bmaterials&r introduced in the late-game content of the mod."
	]
	quest.743E85C4F3586BBD.quest_subtitle: "Fire Mining!!!"
	quest.74482378B1AB4B4B.quest_desc: ["&6A&r bulb fixture: put a bulb in it and wire it up, and it turns &belectricity&r into light."]
	quest.74482378B1AB4B4B.quest_subtitle: "A bulb fixture"
	quest.744B6FFA4DA83F7E.quest_desc: [
		"&6A&r good takeoff is the beginning of every successful flight. Improved Landing Gear increases your aircraft's takeoff speed, &bhelping&r you get airborne faster and giving you a smoother start to your journey."
		""
		"&bUpgrade&r your landing gear and leave the ground with confidence."
	]
	quest.744B6FFA4DA83F7E.quest_subtitle: "Get off the ground faster."
	quest.746BB4F2E115CFEF.quest_desc: ["Craft a &acrafting&r table to combine resources into new items and tools. This essential crafting hub allows you to expand your crafting skills and prepare for further &bexploration&r of the world."]
	quest.746BB4F2E115CFEF.quest_subtitle: "Craft items and tools from the resources you’ve gathered"
	quest.746BB4F2E115CFEF.title: "&#A56701Crafting Table"
	quest.747470136FC85059.quest_desc: ["&aCraft&r the Dragon Bones Chestplate from the Bosses' Rise mod. Forged from the bones of ancient dragons, this &blegendary&r armor piece provides powerful protection and carries the strength of the &bcreatures&r that once dominated the skies. Only true dragon hunters can &bobtain&r such a relic."]
	quest.747470136FC85059.quest_subtitle: "Armor carved from the bones of dragons"
	quest.7476E50E470DE285.quest_desc: [
		"Some advanced tools can use energy instead of durability."
		"The Battery Template allows your Construction Stick to store and use energy for its actions."
		""
		"With this upgrade, your building tool can work using stored power, making it more efficient for large projects."
	]
	quest.7476E50E470DE285.quest_subtitle: "Power Your Tools"
	quest.7489E6B88FAFF41B.quest_subtitle: "More Weapon"
	quest.748C7C56B1BB12F6.quest_desc: ["&aObtain&r a Heart of the Sea. This rare ocean treasure can be found inside buried treasure chests. It is &bused&r to craft a Conduit, a powerful underwater device that provides special effects while &bexploring&r the ocean."]
	quest.748C7C56B1BB12F6.quest_subtitle: "A treasure hidden beneath the waves"
	quest.748FEE4E7397ED70.quest_subtitle: "More Armor"
	quest.7494DD3B639CE1B7.title: "&6&lAncient &eRemnant"
	quest.74998A2B2A9AC311.quest_desc: ["&6A&r wire made of iron. It is also an ingredient in &blight&r bulbs and Resistive Coils, so make a stock of it."]
	quest.74998A2B2A9AC311.quest_subtitle: "Wire made of iron"
	quest.74BD3FC9D5E94739.quest_desc: ["&6The&r Handheld Drill is a portable tool from Create: Dreams n' Desires that brings mechanical drilling into your hands. Use it for convenient material &bprocessing&r and construction work around your factory without &bneeding&r a stationary drill setup."]
	quest.74BD3FC9D5E94739.quest_subtitle: "Drill without the machinery"
	quest.74C3C62A7CE9ECCC.quest_subtitle: "More Armor"
	quest.74D4FA49F6DF2E75.quest_subtitle: "More Armor"
	quest.74FD5CCA87553E9B.quest_subtitle: "Yummy!"
	quest.7502E77917078A8E.quest_subtitle: "Yummy!"
	quest.750475178F4B4473.quest_desc: [
		"&aCraft&r the Steeleaf Sword from the enchanted Steeleaf material found throughout the Twilight Forest. Forged with the magic of the ancient woods, this weapon offers an excellent &bbalance&r of power and durability, making it a dependable companion for exploring dangerous dungeons and facing the creatures that inhabit the forest."
		""
		"&aAs&r one of the signature weapons of the Steeleaf equipment set, it is an important step toward conquering the many &bchallenges&r hidden within the Twilight Forest."
	]
	quest.750475178F4B4473.quest_subtitle: "A blade blessed by the ancient forest"
	quest.750789BAB1BA2BBF.quest_subtitle: "More Armor"
	quest.750CFECC6F6EFD90.quest_desc: ["&aCraft&r the Pharaoh's Sacred Headdress from the Cataclysm: Spellbooks addon. This mystical headpiece is part of the Pharaoh Wizard Armor set, &binspired&r by the Ancient Remnant and the forgotten rulers of the desert. It &benhances&r Sand magic and unlocks the full potential of the Pharaoh's equipment."]
	quest.750CFECC6F6EFD90.quest_subtitle: "Wear the crown of the ancient pharaoh"
	quest.752115DA021966D7.quest_desc: ["&6Give&r your confectionery a touch of luxury. Inject 250 mB of Ruby Chocolate into a Caramel Bar, Chocolate Bar or Dark Chocolate Bar to &bcreate&r Ruby Chocolate Candy. Each candy restores &b8&r hunger and &b11&r saturation, while the ruby chocolate grants the Saturation effect for &b2&r seconds."]
	quest.752115DA021966D7.quest_subtitle: "A delicate candy infused with exotic ruby chocolate."
	quest.752F4E175B03C0E2.quest_desc: ["&6Obtain&r a Cardboard Chestplate from Create. It is part of the Cardboard Armor set, with the chestplate providing &b1&r armor point and 64 durability. When the full set is worn and you sneak, you disguise yourself as a Cardboard Package, greatly reducing the &bdistance&r at which hostile mobs can &bdetect&r you."]
	quest.752F4E175B03C0E2.quest_subtitle: "Become one with the cargo"
	quest.753108DAB5FE74E0.quest_desc: [
		"&eEnder&r Pearls are useful, but constantly losing them can get expensive."
		""
		"The Warp Drive &bchanges&r the way you use them. Ender Pearls are not consumed when teleporting and no longer deal their usual teleportation damage. Instead, each &buse&r costs you some hunger."
		""
		"&bTravel&r farther. Keep your pearls."
	]
	quest.753108DAB5FE74E0.quest_subtitle: "Teleport without losing your pearls"
	quest.7536A8395948FB54.quest_subtitle: "Upgrade+"
	quest.753B6220292D7FD7.quest_subtitle: "Yummy!"
	quest.755FD1E86B82449C.quest_desc: ["&aEmeralds&r are a symbol of wealth, but when combined with Netherite, they become something much more. This material represents both &bstrength&r and rarity."]
	quest.755FD1E86B82449C.quest_subtitle: "Wealth meets power"
	quest.755FD1E86B82449C.title: "Emerald Netherite Ingot"
	quest.75681D5874E356F0.quest_desc: ["&eWelcome&r to Simply Swords, a mod that adds a wide variety of &bunique&r swords and weapons to Minecraft. Discover new fighting styles, powerful abilities and weapons &bdesigned&r to make combat more &bexciting&r and diverse."]
	quest.75681D5874E356F0.quest_subtitle: "Expand your arsenal with powerful new weapons!"
	quest.75681D5874E356F0.title: "&f&lWelcome &bSimply Swords"
	quest.756AA2DCD82FDA21.quest_desc: [
		"The Terminite Leggings are crafted from Terminite Plating at a Smithing Table."
		""
		"Like the rest of the set, they can later be upgraded into &bCrystalite&r or &bAeternium&r armor."
	]
	quest.756AA2DCD82FDA21.quest_subtitle: "Leggings of the second tier"
	quest.756B5163BBD5B247.quest_desc: ["Learn how to craft a Wooden Shield and protect yourself from incoming attacks."]
	quest.756B5163BBD5B247.quest_subtitle: "Craft your first shield to defend yourself!"
	quest.75731E4E0D6C19C9.quest_subtitle: "More Armor"
	quest.75779455A76440DA.quest_desc: ["&aObtain&r a Neptunium Ingot from Aquaculture 2. This rare material is obtained from fishing &btreasures&r and is &bused&r to craft powerful fishing equipment, including Neptunium tools, armor, and advanced fishing items."]
	quest.75779455A76440DA.quest_subtitle: "The rare metal of the ocean"
	quest.7580842FDD09E35C.quest_desc: ["&aObtain&r the Laser Gatling from L_Ender’s Cataclysm. This powerful ranged weapon fires the same devastating laser &btechnology&r associated with The Harbinger. The &bweapon&r uses Redstone as &bammunition&r and can ignite blocks when fired."]
	quest.7580842FDD09E35C.quest_subtitle: "Unleash the Harbinger's deadly firepower"
	quest.7580842FDD09E35C.title: "&cLaser Gatling"
	quest.75974D41A214001A.quest_desc: [
		"&aThe&r Glacite Leggings are cold-resistant armor from Eternal Starlight crafted &busing&r Glacite materials."
		""
		"Glacite armor slows attacking &aenemies&r with icy effects and provides increased &bprotection&r in freezing environments."
	]
	quest.75974D41A214001A.quest_subtitle: "Frozen leg armor"
	quest.75A696A9CED7243E.quest_desc: ["&aDefeat&r 3 Elder Guardians. These powerful &bunderwater&r mobs are found inside Ocean Monuments and protect them from intruders. They inflict &bMining&r Fatigue and drop valuable items, including Wet Sponge, &bPrismarine&r materials, and fish."]
	quest.75A696A9CED7243E.quest_subtitle: "Conquer the ocean monument guardians"
	quest.75A696A9CED7243E.title: "Kill Elder Guardian"
	quest.75B529873E7CAB78.quest_desc: ["&aObtain&r the Bloom Stone Chestplate and Bloom Stone Pauldrons from the Cataclysm: Spellbooks addon. Add both pieces of Bloom Stone equipment to your &bcollection&r and &bcontinue&r your &bjourney&r through the powerful relics of the addon."]
	quest.75B529873E7CAB78.quest_subtitle: "The armor of ancient stone"
	quest.75CA1FD77FBC5D6E.quest_desc: [
		"Within the &bmysterious&r lands of Eternal Starlight, Lone Star &aSkeletons&r wander under the dim glow of celestial light."
		"These hostile creatures strike from a distance and can quickly overwhelm unprepared explorers."
		""
		"Defeating them is a key s&btep&r in proving your ability to survive in this strange new dimension."
	]
	quest.75CA1FD77FBC5D6E.quest_subtitle: "Shadows of the Starlight"
	quest.75CA1FD77FBC5D6E.title: "LoneStar Skeletons"
	quest.75CA3A5B4CC0F125.quest_desc: [
		"&aCraft&r a full set of Leather Armor to begin your journey as a true adventurer. Made from leather &bgathered&r from livestock and wildlife, this lightweight armor offers basic protection while allowing &bcomplete&r freedom of movement."
		""
		"&aAlthough&r simple in design, Leather Armor is often the first step toward &bsurviving&r the &bdangers&r of the world. Every great hero begins somewhere, and this humble set marks the start of your adventure, &bpreparing&r you for the stronger equipment and greater challenges that lie ahead."
	]
	quest.75CA3A5B4CC0F125.quest_subtitle: "Your first line of defense"
	quest.75CA3A5B4CC0F125.title: "Leather Armor"
	quest.75D1344390F6374D.quest_desc: ["&6Ruby&r Chocolate is already a rare treat, but why stop at a single bite? Wrap six Ruby Chocolate Bars in paper to create a Full Ruby Chocolate Bar. It can be &benjoyed&r up to 16 times, making &bevery&r bite a little sweeter."]
	quest.75D1344390F6374D.quest_subtitle: "A luxurious ruby chocolate bar made to last."
	quest.75ED5EE9E0A7FC3C.quest_desc: ["&6Craft&r the Fan Freezing Catalyst and use it with an Encased Fan to perform bulk freezing. The catalyst gives the fan's &bairflow&r a freezing effect without &brequiring&r a separate powdered snow setup. It was added to Create: Connected 0.8.0 for compatibility with Create: Garnished and Create: Dreams \\& Desires."]
	quest.75ED5EE9E0A7FC3C.quest_subtitle: "Freeze with a breath of cold air"
	quest.75EFD84AC15FE957.quest_desc: [
		"&dVenomous&r Crusader Boots are the Crystal Chronicles upgraded version of Plagued Boots from Iron’s Spells ’n Spellbooks."
		""
		"They are &bupgraded&r using a Floralite Shard, transforming the original Plagued Armor into the powerful Venomous Crusader Armor set. The Floralite Shard infuses the equipment with the power of Nature magic, enhancing the poisonous and &bplague-based&r abilities of the original armor."
	]
	quest.75EFD84AC15FE957.quest_subtitle: "An enhanced form of Plagued Boots empowered by Floralite"
	quest.75F60AC23BFF24B4.quest_desc: ["&6Mines&r with the strength of a diamond. Powered by a Portable Battery it mines faster the longer you use it and uses no durability, only battery &benergy&r. An integrated circuit &bboosts&r it for a limited number of uses."]
	quest.75F60AC23BFF24B4.quest_subtitle: "A handheld drill"
	quest.75F84157D0F8BC1A.quest_desc: [
		"&aCraft&r a Gold Fillet Knife, an elegant tool &bfavored&r by anglers who appreciate both style and precision. While gold may not be the toughest material, its exceptional craftsmanship allows for swift and &befficient&r preparation of even the finest catches."
		""
		"&aWhether&r you're processing &bcommon&r fish or rare aquatic treasures, the Gold Fillet Knife proves that true mastery isn't measured only by strength, but also by finesse. A worthy addition to the toolkit of any &bdedicated&r fisherman."
	]
	quest.75F84157D0F8BC1A.quest_subtitle: "Luxury meets precision"
	quest.760CC342A5EB4846.quest_subtitle: "Yummy!"
	quest.760D1C0CD7518BCE.quest_desc: ["&6Craft&r the Trompette pipe and &badd&r a bold, powerful &breed&r voice to your pipe organ. Trompette is one of the reed pipes in Create: Sound of Steam and is crafted through sequenced assembly, &busing&r reed and tuning wire components."]
	quest.760D1C0CD7518BCE.quest_subtitle: "Add a powerful reed voice"
	quest.7620D2CD5D4B607F.quest_desc: [
		"The Crystalite Helmet is created through an Infusion Ritual — a Terminite Helmet, an Amber Gem, and Crystal Shards placed around an &aInfusion Pedestal&r."
		""
		"Once worn as part of the full set, it grants permanent &bRegeneration I&r."
	]
	quest.7620D2CD5D4B607F.quest_subtitle: "Helmet born from infusion"
	quest.7620D2CD5D4B607F.title: "&dCrystalite Helmet"
	quest.762A0B992C58D442.quest_desc: [
		"&dVoltite&r Shard is a rare upgrade material from Crystal Chronicles. It is used to &bupgrade&r the Electromancer Armor from Iron’s Spells ’n Spellbooks into its &benhanced&r Crystal Chronicles version."
		""
		"The shard &bchannels&r the power of Lightning magic, infusing the original Electromancer equipment with additional crystalline energy. It is also used in the creation of Volt Spear and Tesla Rod, weapons associated with the &benhanced&r Electromancer equipment."
	]
	quest.762A0B992C58D442.quest_subtitle: "A charged crystal shard that empowers Electromancer equipment"
	quest.762ECCD358FEDF52.quest_subtitle: "Yummy!"
	quest.76394F23CEE297D2.quest_desc: [
		"&dBattle-Evoker&r Boots are the Crystal Chronicles upgraded version of Archevoker Boots from Iron’s Spells ’n Spellbooks."
		""
		"They are &bupgraded&r using an Avaricite Shard, transforming the original Archevoker Armor into the powerful Battle-Evoker Armor set. The Avaricite Shard infuses the &bequipment&r with additional Evocation magic, creating a stronger combat-focused version of the Archevoker gear."
	]
	quest.76394F23CEE297D2.quest_subtitle: "An enhanced form of Archevoker Boots, empowered by Avaricite"
	quest.763A98BB26BB58BF.quest_desc: [
		"The Crystal Crossbow is a &aranged&r weapon from Eternal Starlight."
		"It belongs to the mod’s advanced equipment tier and is associated with crystalline &bmaterials&r found in the dimension."
		""
		"Exact &acrafting&r or acquisition methods are not clearly documented in available public sources and may depend on progression, JEI recipes, or specific loot tables &bwithin&r the mod."
	]
	quest.763A98BB26BB58BF.quest_subtitle: "A crystalline ranged weapon"
	quest.763A98BB26BB58BF.title: "&6Crystal Crossbow"
	quest.763B02AC59B861D6.quest_subtitle: "Upgrade+"
	quest.76412602849E8C38.quest_desc: ["&6Craft&r the Slime Spout Gun and use slime as your ammunition. Fill the gun with slime &busing&r a Spout, then fire slime &bprojectiles&r at your targets. The slime variant was &badded&r alongside the honey and chocolate Spout Guns in Create: Misc \\& Things."]
	quest.76412602849E8C38.quest_subtitle: "Make your enemies stick around"
	quest.765393B9D3FD9BE2.quest_desc: [
		"&9&lTake&r&r the convenience of Shulker Boxes to the &bnext&r level with Sophisticated Storage. This storage container &bprovides&r a compact and portable way to organize and transport large amounts of items."
		""
		"With &bsupport&r for Sophisticated Storage upgrades, it can be customized to fit your storage needs and become a powerful &bpart&r of your inventory and storage system."
	]
	quest.765393B9D3FD9BE2.quest_subtitle: "Expand your storage with portable containers"
	quest.7661EC252F3C2327.quest_desc: ["&6The&r Large Cog Crank is an upgraded &bhand-powered&r source of rotational force from Create: Dreams n' Desires. Its larger design provides a more substantial way to &bmanually&r drive your machinery, making it useful when you need extra &brotational&r power without setting up a full power source."]
	quest.7661EC252F3C2327.quest_subtitle: "More leverage, more power"
	quest.76A2E1D53091B6E4.quest_desc: ["&6The&r base of every generator: it weakly couples your &bkinetic&r network to the generator shaft. Redstone changes the coupling strength. To start a generator, feed the stator an excitation &bcurrent&r through a Device Connector, or build a self-excited one with a Rheostat."]
	quest.76A2E1D53091B6E4.quest_subtitle: "The generator clutch"
	quest.76A5662F1B3DAFE1.quest_desc: ["&6The&r Block of Super Experience is a powerful form of experience from Create: Enchantment Industry. It is &bcreated&r when lightning strikes a Block of Experience, &btransforming&r it into Super Experience. It can be used for Super Enchanting and can &balso&r be compacted into Nuggets of Super Experience. Unlike normal experience, Super Experience has no liquid form."]
	quest.76A5662F1B3DAFE1.quest_subtitle: "Transcend ordinary experience"
	quest.76AC125F870FA77F.quest_desc: [
		"&eForget&r the pickaxe. These reinforced claws are made for tearing through stone and earth."
		""
		"Digging Claws &bincrease&r your mining speed and raise your base mining level to Stone, allowing you to mine blocks that normally require at least a &bstone-tier&r tool even without holding one. By default, they provide a &b32-point&r mining speed bonus."
		""
		"&bPut&r them on and tear through the earth."
	]
	quest.76AC125F870FA77F.quest_subtitle: "Dig deeper. Faster"
	quest.76B7EFCD847F8806.quest_desc: ["&6Iron&r Wire is an electrical crafting component from Create Crafts \\& Additions. It is produced &busing&r the Rolling Mill and is used in recipes for various &belectrical&r components. Add it to your collection &balongside&r Copper Wire and the other metal wires needed to expand your electrical network."]
	quest.76B7EFCD847F8806.quest_subtitle: "Strengthen your electrical network"
	quest.76BEBF0AED6F72C9.quest_subtitle: "More Weapon"
	quest.76C0A64E5EDECF30.quest_desc: ["&6The&r Electrum Spool is an electrical component from Create Crafts \\& Additions used to connect &bcompatible&r Connectors and transfer electrical energy between them. One spool uses 4 Electrum Wires and 1 Empty Spool. When connected, it can &btransfer&r up to 5 kFE/t. Breaking a &bconnected&r connector returns &b4&r Electrum Wires."]
	quest.76C0A64E5EDECF30.quest_subtitle: "Connect your electrical network"
	quest.76EC8406BB62927F.quest_subtitle: "More Armor"
	quest.7724BB5F80C35C73.quest_desc: ["Obtain &aRaw Copper&r by mining copper ore underground. Copper is one of the first metals you’ll encounter and is used for crafting, decoration, and future technologies. This is an important step in learning how to mine and process &bmetals&r."]
	quest.7724BB5F80C35C73.quest_subtitle: "Your first encounter with metal"
	quest.7724BB5F80C35C73.title: "&3Raw &#FD6E01Copper"
	quest.772845DF9F6165B7.quest_desc: [
		"&aBoth&r Glacite Shards and Thioquartz Shards are &bcommon&r crafting materials found in Eternal Starlight."
		""
		"&aGlacite Shards&r are obtained from Glacite ore found underground in frozen regions and are mainly used for Glacite equipment and smithing trim colors."
		"&aThioquartz Shards&r are obtained from Thioquartz clusters growing inside crystal geodes and are mostly used for basic armor crafting and trim colors."
		""
		"&aNeither&r material is especially important for major progression, but both are useful early resources while &bexploring&r the dimension."
	]
	quest.772845DF9F6165B7.quest_subtitle: "Simple materials of the dimension"
	quest.772845DF9F6165B7.title: "&6Frozen and Sulfur Crystals"
	quest.7739C8981ACF110E.quest_desc: [
		"&eSome&r attacks deserve an answer."
		""
		"The Flame Pendant has a &bchance&r to set enemies that hurt you on fire. And when it does, the pendant briefly &bprotects&r you from fire, letting you turn your enemy's attack against them."
		""
		"&bStrike&r first, or get burned."
	]
	quest.7739C8981ACF110E.quest_subtitle: "Touch me, and feel the heat"
	quest.773A93DE2C083A08.quest_desc: ["As you continue &aupgrading&r your gear, these leggings provide a solid balance of durability and strength. Iron-infused Netherite offers reliable protection in most &bsituations&r."]
	quest.773A93DE2C083A08.quest_subtitle: "Reinforced protection"
	quest.773A93DE2C083A08.title: "Iron Netherite Leggings"
	quest.7743A465A3C79F1C.quest_desc: [
		"&aThe&r Scepter of Life Draining is one of the dark &bartifacts&r dropped by the Twilight Lich. It channels corrupted soul energy, allowing the wielder to drain health from &benemies&r and &brestore&r their own vitality in combat."
		""
		"&aThis&r scepter represents the most &baggressive&r form of the Lich’s magic, turning every attack into a source of healing. However, its power is unstable and feeds on the life force of living beings, making it a &bdangerous&r but powerful tool in prolonged battles."
	]
	quest.7743A465A3C79F1C.quest_subtitle: "Steal life from your enemies"
	quest.77516919D2A84805.quest_desc: ["&6Obtain&r a Fluid Valve from Create. It allows you to open or close the flow of fluids through a pipe network. The valve is &boperated&r by applying rotational force to its side, commonly using a Valve Handle or Gearshift. The arrows on the side &bindicate&r whether the valve is open or closed."]
	quest.77516919D2A84805.quest_subtitle: "Control the flow"
	quest.77881DD6C3F9A04C.quest_desc: ["&6Craft&r the Candy Cane Hoe from Create: Confectionery and give your farming a festive touch. It is &bpart&r of the Candy Cane Tools set, added alongside the Candy Cane Pickaxe, Axe, Sword, and Shovel."]
	quest.77881DD6C3F9A04C.quest_subtitle: "Grow your crops with a sugary twist"
	quest.779BF5DC4024CDE9.quest_desc: [
		"&6Not&r every aircraft needs to rely &bentirely&r on its engine. A Sail harnesses the wind to help your aircraft travel through the skies. A simple piece of equipment, but an essential part of classic airships."
		""
		"Craft your Sail and &bprepare&r your aircraft for the open skies."
	]
	quest.779BF5DC4024CDE9.quest_subtitle: "Let the wind carry you across the skies."
	quest.779F9785621E0BC0.quest_subtitle: "Yummy!"
	quest.77AF9B104B17F5C3.quest_desc: ["&eThe&r Moon Crystal is the &bfoundation&r of every armor in the Fantasy series. To craft one, surround an &bamethyst&r shard with nine glow ink sacs. Then &bcombine&r the crystal at a smithing table with a netherite armor piece and the right component to turn it into one of the legendary sets."]
	quest.77AF9B104B17F5C3.quest_subtitle: "The key to every fantasy armor"
	quest.77AF9B104B17F5C3.title: "&dMoon Crystal"
	quest.77B53DF48668E2BB.quest_desc: ["&6Obtain&r a Train Station from Create. It is used to create, assemble, disassemble, and manage trains. Place it next to a Train Track and &buse&r its interface to create a new train, name the station, and &bmanage&r train schedules. Stations are also essential for &bautomated&r railway networks using Train Schedules and Train Signals."]
	quest.77B53DF48668E2BB.quest_subtitle: "Build the gateway to your railway network"
	quest.77B5E4C6B8EE69C9.quest_desc: [
		"&eAfter&r everything you've been through, it's nice to hear something familiar."
		""
		"&bPut&r this disc in a jukebox and let its music fill the room. Whether you're &breturning&r from an &bexpedition&r or settling into your new home, every adventure deserves a soundtrack."
		""
		"Welcome back, adventurer."
	]
	quest.77B5E4C6B8EE69C9.quest_subtitle: "A song to welcome you home"
	quest.77B5E4C6B8EE69C9.title: "&l&fWelcome &eMusic Disc"
	quest.77BB3EBE888EE2F8.quest_desc: ["&6Obtain&r an Elevator Pulley from Create. It is a specialized contraption component used to build &bmulti-floor&r elevators. Unlike the Rope Pulley, it can move through blocks and synchronize with other Elevator Pulleys on the same level. With Redstone Contacts defining the floors and &boptional&r Contraption Controls, you can create a fully functional elevator system."]
	quest.77BB3EBE888EE2F8.quest_subtitle: "Rise above the limits"
	quest.77BED095AD4223B0.quest_desc: [
		"&dBottle&r o' Lightning is the Lightning Focus in Iron's Spells 'n Spellbooks. It is &bused&r to craft Lightning spells and Lightning-related equipment."
		""
		"To obtain one, use an empty bottle on a Charged Creeper. You can &bcreate&r a Charged Creeper using a Lightning Bolt spell, a Lightning Rod, or a Trident with Channeling."
	]
	quest.77BED095AD4223B0.quest_subtitle: "Capture the power of a thunderstorm"
	quest.77FFB5E674EC3F06.quest_desc: [
		"&aThe&r Amaramber Chestplate is a protective armor piece from Eternal Starlight, crafted using Amaramber &bmaterials&r."
		""
		"&aIt&r is part of the Amaramber armor progression and provides enhanced protection during &bexploration&r and combat."
	]
	quest.77FFB5E674EC3F06.quest_subtitle: "Amber-forged body armor"
	quest.78167587A2190E60.quest_desc: ["&aAwaken&r and defeat the Last of Deepslate — a powerful machine hidden within the Ancient Keep. It can be &bawakened&r using Echo Charges &bobtained&r from Deepslate Vaults. Defeating the boss marks the culmination of the challenge and rewards you with a valuable smithing template used to &bcreate&r a powerful weapon."]
	quest.78167587A2190E60.quest_subtitle: "The Last of the Ancients"
	quest.78167587A2190E60.title: "&l&bLast &3Of &fDeepslate"
	quest.782030F31C8C7045.quest_desc: ["&6Obtain&r a Zinc Ingot from Create. Zinc is an essential material used together with Copper to create Brass, one of the key materials for more &badvanced&r Create machinery and logistics. Zinc can be &bobtained&r by smelting Zinc Ore or Crushed Zinc Ore."]
	quest.782030F31C8C7045.quest_subtitle: "Forge the metal that binds creation together"
	quest.78405A333E6AB789.quest_desc: ["&6The&r Gilded Quartz Axe is part of the Gilded Quartz tool set from Create Stuff 'N Additions. It has 1644 durability, deals 8 attack damage and has 1.2 attack speed. It is crafted &busing&r Polished Rose Quartz, an Iron Sheet, Gold and Zinc Tool Handles. It is &bdesigned&r as a strong alternative to standard tools, &bcombining&r rose quartz with gold for improved performance."]
	quest.78405A333E6AB789.quest_subtitle: "Cut with the power of rose quartz"
	quest.78412F65ABE0A6E1.quest_subtitle: "Yummy!"
	quest.7852999D151D4577.quest_desc: [
		"&6Ordinary&r engines can only take you so far. The Nether Engine pushes your aircraft far beyond its limits, using the power of Nether &bmaterials&r to provide a massive boost in engine performance."
		""
		"The price of this power is fuel. A stronger engine demands &bmore&r of it — but when speed is what matters, sacrifices have to be made."
	]
	quest.7852999D151D4577.quest_subtitle: "Harness the power of the Nether."
	quest.785FDC18E2689C83.quest_desc: [
		"&dThe&r Silver Ring is a simple but valuable magical accessory from Iron's Spells 'n Spellbooks. It provides a solid foundation for your magical equipment and can become an important part of your &bjourney&r into the arcane arts."
		""
		"&bEquip&r the ring and take another step toward mastering the magical gear available to you."
	]
	quest.785FDC18E2689C83.quest_subtitle: "Begin your collection of magical accessories"
	quest.7876B4DDAC6F76F0.quest_desc: [
		"&6Give&r your locomotive a sleek and sturdy appearance with Plated Locometal. Its smooth metal plating is perfect for &badding&r clean industrial surfaces and polished details to your railway builds."
		""
		"&bUse&r Plated Locometal to give your locomotive the strong, finished look it deserves."
	]
	quest.7876B4DDAC6F76F0.quest_subtitle: "A clean metal finish for your locomotive."
	quest.787E61BD64245B94.quest_subtitle: "More Weapon"
	quest.78A69968A7134E7F.title: "uhhh"
	quest.78D6EE733F2A5C24.quest_desc: [
		"&dThe&r Amethyst Resonance Charm is a magical necklace from Iron's Spells 'n Spellbooks that increases your Mana Regeneration by &b15%&r while equipped. This allows you to recover mana faster and &breturn&r to spellcasting sooner."
		""
		"&bCraft&r the charm and strengthen your connection to the arcane forces flowing through your body."
	]
	quest.78D6EE733F2A5C24.quest_subtitle: "Regenerate your mana with amethyst resonance"
	quest.78E8137F10935F08.title: "Damn"
	quest.78EC6769CB15B15B.quest_subtitle: "More Armor"
	quest.790B8D1EDD719770.quest_desc: ["&6Obtain&r the Wrench from Create. This &bessential&r engineering tool allows you to rotate, dismantle, and configure many Create components. It is &bcrafted&r using a Golden Sheet, Cogwheel, and Stick."]
	quest.790B8D1EDD719770.quest_subtitle: "Shape the machines to your will"
	quest.791F1EDF06263CDA.quest_desc: [
		"&aObtain&r the thick fur of the Alpha Yeti, a rare &bmaterial&r taken from the mighty ruler of the Glacier. This extraordinary &bpelt&r has adapted to the harshest &bconditions&r imaginable, retaining warmth even in the coldest corners of the Twilight Forest."
		""
		"&aAlpha&r Yeti Fur is an essential crafting material &bused&r to create armor capable of protecting its wearer from freezing &btemperatures&r. More than just a trophy, it is proof that you have conquered one of the most powerful &bcreatures&r lurking within the frozen wilderness."
	]
	quest.791F1EDF06263CDA.quest_subtitle: "The warmth of the eternal winter"
	quest.7922B68C83D0916D.quest_desc: ["&6Craft&r the Brake to stop rotational machinery on demand. When powered, it &bapplies&r resistance to the connected kinetic network, allowing you to bring spinning components to a halt and control when your machinery runs. The Brake is one of the kinetic &bblocks&r included in Create: Connected."]
	quest.7922B68C83D0916D.quest_subtitle: "Bring your machinery to a halt"
	quest.79288D545C2DFDD7.quest_desc: ["&6Obtain&r both a Gearbox and a Vertical Gearbox from Create. Gearboxes redirect rotational power between &bdifferent&r axes. The &bstandard&r Gearbox handles horizontal directions, while the Vertical Gearbox allows &brotational&r power to be redirected between horizontal and vertical axes."]
	quest.79288D545C2DFDD7.quest_subtitle: "Turn the power in any direction"
	quest.7931258DEAC96F83.quest_desc: [
		"&aTenacious&r Petals are plant materials found in Eternal Starlight and are connected to the vegetation growing throughout the dimension."
		"They are mainly used in crafting recipes related to &bnatural&r resources and progression items from the mod."
		""
		"&aThese&r petals are one of many unique &bplants&r that make the dimension feel alive and alien."
	]
	quest.7931258DEAC96F83.quest_subtitle: "A resilient flower fragment"
	quest.7931258DEAC96F83.title: "&bTenacious Petal"
	quest.794215F11EAD7BA4.quest_desc: [
		"The Terminite Hoe is a &afarming&r tool forged from Terminite Ingots, used to prepare farmland more efficiently than Thallasium tools."
		""
		"It's part of Better End's mid-tier &bequipment&r progression."
	]
	quest.794215F11EAD7BA4.quest_subtitle: "Farming tool, refined"
	quest.7947F699605459FA.quest_desc: ["&aDefeat&r 3 Deepling Warlocks from the Cataclysm mod. These dangerous &baquatic&r enemies use dark magic and powerful attacks to defend their underwater territory. They can be &bfound&r among Deepling &bstructures&r in deep ocean areas."]
	quest.7947F699605459FA.quest_subtitle: "Defeat the dark magic of the deep"
	quest.7947F699605459FA.title: "Kill Deepling Warlock"
	quest.795598A64E80837D.quest_desc: ["&6Craft&r the Linked Transmitter to &bsend&r redstone signals wirelessly between linked components. It &bsupports&r the different button variants, levers and linked levers, allowing you to control distant machinery without running &bphysical&r redstone lines. It can also be attached to &bcompatible&r controls such as the Throttle Lever from Create: Aeronautics."]
	quest.795598A64E80837D.quest_subtitle: "Send redstone signals across your factory"
	quest.7960C5339897DA76.quest_desc: [
		"&dHoly&r Rune is a crafting ingredient in Iron's Spells 'n Spellbooks, &bused&r for advanced &bHoly-related&r crafting, including Holy Upgrade Orbs and Holy equipment."
		""
		"&bCreate&r a Holy Rune by surrounding a Blank Runestone with 8 Divine Pearls. Divine Pearl is the Holy Focus of the mod."
	]
	quest.7960C5339897DA76.quest_subtitle: "Infuse a runestone with the sacred power of Holy magic"
	quest.796FC1FC35689C77.quest_desc: [
		"&9&lExpand&r&r your Refined Storage network with the Network Transmitter. It &ballows&r you to connect and &bextend&r your network over greater distances, making it possible to build larger and more flexible storage systems."
		""
		"&bUse&r it to connect distant &bsections&r of your network and bring all your storage and automation devices together into one system."
	]
	quest.796FC1FC35689C77.quest_subtitle: "Extend your storage network beyond its limits"
	quest.79886FA0A6925681.quest_desc: ["&6A&r VFET transistor, a semiconductor for electronic circuits."]
	quest.79886FA0A6925681.quest_subtitle: "A VFET transistor"
	quest.7997AB49C57E3EE5.quest_desc: [
		"&6Take&r to the &bskies&r in a classic Airship. It may not be the fastest aircraft around, but its simple controls and two seats &bmake&r it an excellent choice for relaxed exploration and travel."
		"&bBuild&r your Airship, find an open stretch of land, and let the wind carry you above the world."
	]
	quest.7997AB49C57E3EE5.quest_subtitle: "A gentle ride through the skies."
	quest.79B6A938CD4B59AF.quest_desc: ["&aDefeat&r Scylla, one of the major bosses of L_Ender’s Cataclysm. She rules the Acropolis and commands &bdevastating&r storm-based attacks. Overcome the Storm Empress and claim &bvictory&r over one of Cataclysm’s most formidable bosses."]
	quest.79B6A938CD4B59AF.quest_subtitle: "Defeat the Storm Empress"
	quest.79B6A938CD4B59AF.title: "&l&bScylla"
	quest.79C4B465DE591473.quest_subtitle: "More Armor"
	quest.79D5A389CEAF290D.quest_desc: ["&dReduces&r the &bsound&r range of gunshots and hides the muzzle flash, helping you stay stealthy."]
	quest.79D5A389CEAF290D.quest_subtitle: "Quiet shots"
	quest.79D6957D9C4A05D9.quest_desc: ["&6Nuclear&r Fuel is the energy source &bused&r to operate the reactor in Create: New Age. Prepare the fuel and supply it to the reactor to &bbegin&r generating the intense heat required for nuclear &bpower&r production."]
	quest.79D6957D9C4A05D9.quest_subtitle: "Power the reactor"
	quest.79D7DC2B91A5DC8D.quest_desc: [
		"&aCraft&r the Naga Scale Tunic using the scales dropped by the mighty Naga. This lightweight chest armor provides excellent protection for the early stages of your adventure through the Twilight Forest and serves as proof of your first great &bvictory&r."
		""
		"&aThe&r Naga Scale armor is the first unique armor set available in the Twilight Forest and an important step toward overcoming the dangers that lie &bdeeper&r within the dimension."
	]
	quest.79D7DC2B91A5DC8D.quest_subtitle: "Armor forged from the fallen guardian"
	quest.79F2F7B1DA98476F.title: "Good"
	quest.79F669C9257F1E46.quest_desc: ["&dA&r special ingredient &bused&r in powerful crafting recipes in Hazen N Stuff."]
	quest.79F669C9257F1E46.quest_subtitle: "A rare and mysterious divine ingredient"
	quest.7A05048E63FCE38C.quest_desc: [
		"&aThe&r Alchemist Mask is a utility item from Eternal Starlight, associated with alchemy-themed &bprogression&r."
		""
		"&aIt&r is used as special equipment that enhances exploration or alchemical mechanics &bdepending&r on version."
	]
	quest.7A05048E63FCE38C.quest_subtitle: "Mystic alchemy gea"
	quest.7A0692A32E91438D.quest_desc: [
		"&6Give&r your steam locomotive a &brefined&r industrial look with the Brass Wrapped Locometal Boiler. Combining sturdy Locometal with elegant brass detailing, this boiler is perfect for building a locomotive that &bstands&r out from the crowd."
		""
		"&bAdd&r it to your locomotive and give your steam engine the polished finish it deserves."
	]
	quest.7A0692A32E91438D.quest_subtitle: "A brass-clad boiler for a truly distinguished locomotive."
	quest.7A0CAFF63C0ACEE5.quest_desc: [
		"&aRaw&r Amaramber can be refined into powerful ingots within Eternal Starlight."
		"These ingots contain concentrated starlight energy and are used for stronger equipment, &badvanced&r crafting, and higher-tier progression."
		""
		"&aCreating&r your first Amaramber Ingot marks a major &bstep&r forward in mastering the dimension’s resources."
	]
	quest.7A0CAFF63C0ACEE5.quest_subtitle: "Refined starlight metal"
	quest.7A0CAFF63C0ACEE5.title: "&6Amaramber Ingot"
	quest.7A136A2F2F73CC60.quest_desc: ["&6The&r Andesite Jetpack is a flight-capable chestplate from Create Stuff 'N Additions. It &buses&r steam power, &bgenerated&r from water and fuel, to propel you into the air. Hold Jump to fly upward and Jump + Shift to hover in place. The jetpack can reach up to around &b17&r blocks above the ground and has &b320&r durability. Keep an eye on its fuel, as running out while &bairborne&r will make you fall."]
	quest.7A136A2F2F73CC60.quest_subtitle: "Take to the skies with steam"
	quest.7A2C9DE914989B6E.quest_subtitle: "Yummy!"
	quest.7A56B0E3485A8F77.quest_desc: ["&6Create&r your first Blank Circuit and Copper Circuit. These &bbasic&r components form the foundation of the electrical technology in Create: New Age and will be &bneeded&r to build more &badvanced&r electrical machines and components."]
	quest.7A56B0E3485A8F77.quest_subtitle: "Start building your electrical systems"
	quest.7A56B0E3485A8F77.title: "Circuits"
	quest.7A9233E8C4FCD5E1.quest_desc: [
		"&aThe&r Block and Chain is a brutal &bweapon&r once wielded by the heavily armored Goblin Knights. A massive iron block attached to a sturdy chain, it sacrifices speed for &boverwhelming&r impact, capable of crushing &benemies&r and knocking aside anything standing in its path."
		""
		"&aThough&r difficult to master, those who &blearn&r to wield it gain access to one of the most unique weapons in the Twilight Forest. Every swing carries tremendous force, making it especially &beffective&r against heavily &barmored&r foes and large groups of enemies."
	]
	quest.7A9233E8C4FCD5E1.quest_subtitle: "Turn the enemy's strength against them"
	quest.7AA899604C3F48EE.quest_desc: [
		"The Starfall Longbow is a &aranged&r weapon from Eternal Starlight that enhances standard bow &bgameplay&r with a starfall mechanic."
		""
		"On hit, it summons falling &astars&r that strike the target after a short delay, dealing additional burst &bdamage&r in both single-target and small area combat."
	]
	quest.7AA899604C3F48EE.quest_subtitle: "Celestial ranged weapon"
	quest.7AB002298C6B5AF1.quest_desc: ["&6Craft&r the Large Crank Wheel to &bmanually&r power your kinetic network. Like the standard Crank Wheel, it combines a hand crank with a cogwheel, allowing it to connect directly to other gears. It generates &b32&r RPM and provides &b256&r SU of stress capacity while consuming player hunger when operated."]
	quest.7AB002298C6B5AF1.quest_subtitle: "More leverage, more power"
	quest.7AB25F6EF984EAB8.quest_desc: ["&6Craft&r the Bar of Caramel in Create: Confectionery and add a rich, golden treat to your collection of sweets. Caramel is made by heating sugar and is widely &bused&r in confectionery as a filling, topping, or candy."]
	quest.7AB25F6EF984EAB8.quest_subtitle: "A golden bar of pure sweetness"
	quest.7ACC76719A352665.quest_desc: ["&6A&r slab of copper plating for building and decoration."]
	quest.7ACC76719A352665.quest_subtitle: "A plating slab"
	quest.7AD7959BC45582DC.quest_desc: ["&6A&r simple electromechanical device that plots &bvoltage&r over time. Change the graph color by right-clicking it with a &bdye&r."]
	quest.7AD7959BC45582DC.quest_subtitle: "A voltage plotter"
	quest.7B02656C0420407C.quest_subtitle: "Yummy!"
	quest.7B2B79752ED8B4A0.quest_subtitle: "More Armor"
	quest.7B2CBAD13EF2925F.quest_desc: ["&6Windmill&r Sails are &bused&r to build Windmills and generate rotational power. Attach them to a Windmill Bearing to create the blades. A windmill needs at least &b8&r sail-like blocks to start rotating, and every additional &b8&r sails increases its speed and power output by &b1&r RPM and &b512&r SU. Windmill Sails automatically connect to the windmill and do not require Super Glue. They can also be dyed into &bdifferent&r colors."]
	quest.7B2CBAD13EF2925F.quest_subtitle: "Harness the wind"
	quest.7B40DD0CCBD39F33.quest_desc: ["&6Find&r and grow Red Grapes in Create: Winery. They can be &bharvested&r from grape bushes and &bprocessed&r with Create's machinery to produce Grape Pomace and Red Grape Juice, which can then be used to make Red Wine in the Wine Cellar. Red and white grapes are commonly found in plains and &bforest-type&r biomes."]
	quest.7B40DD0CCBD39F33.quest_subtitle: "Grow the heart of red wine"
	quest.7B47D1581C9650D6.quest_subtitle: "More Armor"
	quest.7B48C6EFAA54F4EB.quest_desc: ["&6Build&r the Keyboard Relay and connect a &bphysical&r piano keyboard to your computer to play your pipe organ in Create: Sound of Steam. It &btranslates&r keyboard input into notes for your organ, allowing you to &bperform&r music live."]
	quest.7B48C6EFAA54F4EB.quest_subtitle: "Play the organ with your own keyboard"
	quest.7B4B94DE562F4EEB.quest_desc: ["&6Craft&r Carbon Brushes, an &bessential&r component for electrical machines in Create: New Age. They work together with the &bgenerator&r system to transfer electrical energy from rotating machinery, helping turn your factory's mechanical power into &busable&r electricity."]
	quest.7B4B94DE562F4EEB.quest_subtitle: "Keep the current flowing"
	quest.7B51B7512923B8B3.quest_desc: ["&aObtain&r the Excelsius Propulsion Leggings. Add this powerful piece of armor to your collection and &bcontinue&r your journey through the &badvanced&r equipment of the Excelsius arsenal."]
	quest.7B51B7512923B8B3.quest_subtitle: "Harness the power of propulsion"
	quest.7B52E53809394AB6.quest_desc: [
		"&dRod&r o' Lightning is a Lightning staff from Iron's Spells 'n Spellbooks. When held in the main hand, it provides &b5&r Attack Damage, &b1&r Attack Speed, &b+15%&r Lightning Spell Power, &b+10%&r Cooldown Reduction and &b+5%&r Spell Power."
		""
		"It is crafted using an Energized Core on a Lightning Rod during a thunderstorm. The Energized Core itself is the &bspecial&r crafting ingredient for the staff."
	]
	quest.7B52E53809394AB6.quest_subtitle: "Channel the devastating power of lightning"
	quest.7B6FF34E241663B5.quest_desc: ["&aDefeat&r the Amethyst Crab from the Cataclysm mod. This powerful crystal-covered creature guards its &bnest&r with relentless fury. Overcome the beast and &bclaim&r victory over the guardian of the Amethyst Nest."]
	quest.7B6FF34E241663B5.quest_subtitle: "Defeat the guardian of the amethyst nest"
	quest.7B6FF34E241663B5.title: "&l&dAmethyst &fCrab"
	quest.7B879AD2714FE5D2.quest_desc: [
		"&l&9Stop&r&r chasing dropped items around the battlefield. The Magnet Upgrade pulls nearby items directly into your backpack, with a &bconfigurable&r filter to decide what gets collected."
		""
		"The Advanced Magnet Upgrade expands the collection &brange&r and provides more powerful &bfiltering&r options, including items, mods, tags, NBT data and durability. It also offers 16 filter slots instead of 9, making it much easier to control exactly what your backpack attracts."
	]
	quest.7B879AD2714FE5D2.quest_subtitle: "Let your backpack pull the loot to you"
	quest.7B879AD2714FE5D2.title: "Magnet \\& Advanced Magnet Upgrade"
	quest.7B8B1AEE1191A350.quest_desc: ["&aObtain&r the Blessed Amethyst Crab Meat from the Cataclysm mod. This &benhanced&r delicacy carries the mystical power of amethyst, transforming the flesh of the defeated Amethyst Crab into &bsomething&r far more extraordinary."]
	quest.7B8B1AEE1191A350.quest_subtitle: "A delicacy touched by crystal power"
	quest.7B988199727590B1.quest_subtitle: "More Armor"
	quest.7B9D480E0804CBD1.quest_desc: [
		"&aCraft&r Void Scatter Arrows, special ammunition made using Void Jaws dropped by Endermaptera in the Ruined Citadel."
		""
		"They're used with Cataclysm's ranged &bweapons&r for extra damage against enemies."
	]
	quest.7B9D480E0804CBD1.quest_subtitle: "Ammunition touched by the void"
	quest.7BA586AFA332049E.quest_subtitle: "Yummy!"
	quest.7BAC4062AE5CD961.quest_desc: ["&dThe&r Conjurer's Talisman is a necklace from Iron's Spells 'n Spellbooks that &bincreases&r your summoned creatures' damage by 15%. &bEquip&r it and make your summoned allies more powerful in combat, &bturning&r your conjurations into an even greater threat."]
	quest.7BAC4062AE5CD961.quest_subtitle: "Strengthen your summoned allies"
	quest.7BAD76F4A92FB434.quest_desc: ["&6Slime&r Boots are a special pair of boots from Create Stuff 'N Additions that &bgive&r you the properties of a Slime Block. When you land, they bounce you back into the air and completely &bprevent&r fall damage. They provide 2 armor points and have 65 durability. Interestingly, the boots do not lose &bdurability&r when they bounce you."]
	quest.7BAD76F4A92FB434.quest_subtitle: "Bounce your way to safety"
	quest.7BAE2E754EE4E451.quest_subtitle: "More Armor"
	quest.7BBB18C48105D22B.quest_desc: [
		"The Thallasium Hammer is a dual-purpose &atool&r — it works ingots at the Anvil, and doubles as a heavy melee weapon with strong knockback."
		""
		"It's the Thallasium tier's answer to Better End's unique &bHammer&r weapon class."
	]
	quest.7BBB18C48105D22B.quest_subtitle: "Heavy tool and weapon in one"
	quest.7BC2238AA1778A3D.quest_desc: [
		"The Golem Steel Greatsword is a heavy weapon &acrafted&r using Golem Steel Ingots obtained through the Starlight Golem &bprogression&r in Eternal Starlight."
		"It belongs to the &aadvanced&r weapon tier added by the mod and requires materials &bconnected&r to the Golem Forge encounter."
	]
	quest.7BC2238AA1778A3D.quest_subtitle: "A weapon of the constructs"
	quest.7BC2238AA1778A3D.title: "&6Golem Steal Greatsword"
	quest.7BEF6AD8FBE2A795.quest_desc: ["&aCraft&r a Neptunium Pickaxe from Aquaculture 2. This powerful &btool&r is made from Neptunium, a rare material obtained from fishing treasures. It offers high &bdurability&r and &bmining&r efficiency, making it a valuable upgrade for &badvanced&r equipment."]
	quest.7BEF6AD8FBE2A795.quest_subtitle: "A powerful tool from ocean treasures"
	quest.7C128C9AC8D74FE4.quest_desc: [
		"In the &adesert&r regions of Eternal Starlight, strange plants known as Lunaris Cacti grow under faint starlight."
		"These cactus-like organisms are adapted to the crystalline environment and are often used in &acrafting&r or resource &brefinement&r systems."
		""
		"&aHarvesting&r them safely is important, as their &bsharp&r and unstable &anature&r can still harm unprepared travelers."
	]
	quest.7C128C9AC8D74FE4.quest_subtitle: "Moonlit plant"
	quest.7C1AC05BA55FE29B.quest_desc: ["Emeralds&a symbolize&r wealth and rarity. When combined with Netherite, they &acreate&r a chestplate that is both powerful and highly &bvaluable&r."]
	quest.7C1AC05BA55FE29B.quest_subtitle: "Prestige and power"
	quest.7C1AC05BA55FE29B.title: "Emerald Netherite Chestplate"
	quest.7C391285F28322D1.quest_desc: [
		"The Thallasium Shovel is a &adigging&r tool forged from Thallasium Ingots, used for excavation and terrain clearing."
		""
		"It completes the basic set of Better End's &bThallasium&r tools."
	]
	quest.7C391285F28322D1.quest_subtitle: "Digging tool of the first tier"
	quest.7C61D4BF3076BBB3.quest_desc: ["&6Obtain&r a Large Water Wheel from Create. When water flows over or under it, the wheel generates &brotational&r power. Compared to a regular Water Wheel, it operates at &b4&r RPM and provides &b512&r SU of stress capacity, making it a slower but more powerful generator."]
	quest.7C61D4BF3076BBB3.quest_subtitle: "Harness even greater power from the water"
	quest.7C96D8A68EB11FB8.quest_desc: [
		"&eEvery&r attack comes with a price."
		""
		"The Thorn Pendant has a 45% chance to retaliate when an enemy &bdamages&r you, dealing 1–4 damage back to the attacker. It's the perfect &bchoice&r for anyone who wants their enemies to regret &bgetting&r too close."
		""
		"&bLet&r them strike. Let the thorns answer."
	]
	quest.7C96D8A68EB11FB8.quest_subtitle: "Hurt me, and you'll feel it too"
	quest.7C98F5E299CFF13A.quest_desc: [
		"Gold &aenhances&r your helmet with unique &bproperties&r."
		"While not the most durable, it provides useful bonuses and can be very effective in the right &bsituations&r."
	]
	quest.7C98F5E299CFF13A.quest_subtitle: "Light and adaptive"
	quest.7C98F5E299CFF13A.title: "Gold Netherite Helmet"
	quest.7C9D95994C9F48CB.quest_desc: ["&6Craft&r the Vox Celeste pipe and add its distinctive, celestial &btone&r to your pipe organ. Vox Celeste was &bintroduced&r in Create: Sound of Steam 0.8.0 as one of seven new pipe types."]
	quest.7C9D95994C9F48CB.quest_subtitle: "Add an ethereal voice to your organ"
	quest.7CAD28686DB99642.quest_desc: [
		"&dThe&r Ring of Visibility lets you see creatures affected by invisibility, revealing enemies that would otherwise remain hidden. It also protects you from the effects of Blindness and Darkness, making it especially useful when &bexploring&r dangerous and poorly lit areas."
		""
		"&bEquip&r the ring and keep your vision clear even when magic tries to take your sight away."
	]
	quest.7CAD28686DB99642.quest_subtitle: "See what darkness tries to hide"
	quest.7CB5942511E7673E.quest_desc: ["&aObtain&r Amethyst Crab Meat from the Cataclysm mod. &bTaken&r from the defeated Amethyst Crab, this unusual delicacy is a &bstrange&r reminder of the creature that once guarded the Amethyst Nest."]
	quest.7CB5942511E7673E.quest_subtitle: "A taste of the crystal beast"
	quest.7CC2AEE66DCC8412.quest_desc: [
		"&dScarecrow&r Leggings are part of the Scarecrow Armor set in Iron's Spells 'n Spellbooks. They provide &b+6&r Armor and &b+75&r Max Mana."
		""
		"Craft them &busing&r Hay Bales and Leather, and &bcomplete&r your Scarecrow Armor set."
	]
	quest.7CC2AEE66DCC8412.quest_subtitle: "Carry the strange power of the scarecrow"
	quest.7CC858E51115B273.quest_desc: [
		"The Thermal Springstone Hoe is a &afarming&r tool from Eternal Starlight crafted &busing&r Thermal Springstone Ingots."
		""
		"&aIt&r is &bused&r to prepare farmland in the geothermal regions of the Starlight dimension and belongs to the mid-tier &bprogression&r set."
	]
	quest.7CC858E51115B273.quest_subtitle: "Geothermal farming tool"
	quest.7CFD93F6BCF72CA8.quest_subtitle: "More Armor"
	quest.7D029F14471BEDF7.quest_desc: ["&aThe&r Skoglin Trophy is a decorative trophy from My Nether's Delight, allowing you to display a unique piece of &bNether-themed&r decoration in your base."]
	quest.7D029F14471BEDF7.quest_subtitle: "A trophy from the dangerous Nether"
	quest.7D1BEFA38EFB87B9.quest_desc: [
		"&9&lTake&r&r your digital storage to the next level with the Crafting Grid. It combines the convenience of the Grid with a crafting interface, &ballowing&r you to access your stored items and craft recipes without &bmanually&r retrieving materials."
		""
		"Connect it to your Refined Storage network and craft directly from your &bcentralized&r storage system."
	]
	quest.7D1BEFA38EFB87B9.quest_subtitle: "Craft anything directly from your digital storage"
	quest.7D386E5ADF45F118.quest_desc: [
		"Bookshelves are not just decoration—they boost your Enchanting Table, making your spells stronger and more effective."
		""
		"Collect enough bookshelves to surround your enchanting setup and maximize your &bmagical potential&r!"
	]
	quest.7D386E5ADF45F118.quest_subtitle: "Stack Up Your Wisdom"
	quest.7D386E5ADF45F118.title: "Knowledge is Power"
	quest.7D39644F07161EB6.quest_desc: ["&6Sweet&r berries are already delicious, but a little glaze makes them even better. Create both Caramel Glazed Berries and Chocolate Glazed Berries by &binjecting&r sweet berries with caramel and chocolate."]
	quest.7D39644F07161EB6.quest_subtitle: "Sweet berries made even better with caramel and chocolate."
	quest.7D39644F07161EB6.title: "Caramel Glazed Berries \\& Chocolate Glazed Beries"
	quest.7D6DBF46D57DD713.quest_subtitle: "Yummy!"
	quest.7DC412D85F2CC926.quest_desc: ["&aThe&r Stove is a cooking station from Farmer's Delight &bused&r to prepare a variety of dishes. Place &bingredients&r inside and use it to turn them into delicious meals, making it an essential part of any kitchen."]
	quest.7DC412D85F2CC926.quest_subtitle: "A useful cooking station for preparing delicious meals"
	quest.7DC9F6CA60817D5C.quest_desc: [
		"&aCraft&r a Diamond Fishing Rod, the &bpinnacle&r of traditional fishing equipment. Reinforced with diamond, this exceptional rod offers incredible &bdurability&r and reliability, allowing you to spend countless hours searching for the rarest fish and the greatest treasures &bhidden&r beneath the waves."
		""
		"&aFrom&r peaceful lakes to the &bdeepest&r oceans, the Diamond Fishing Rod is built for anglers who demand nothing less than excellence. With such a dependable tool in your hands, every cast brings you closer to &buncovering&r the ocean's greatest secrets"
	]
	quest.7DC9F6CA60817D5C.quest_subtitle: "The ultimate tool for every angler"
	quest.7DE87A4BA0CEBAC7.quest_desc: ["&aObtain&r the Berserker Soul Amulet from the Cataclysm mod. This rare Curios accessory can be &bfound&r in chests inside the &bAbandoned&r Spire structure. When equipped, it grants +15% Attack Damage, making it a &bvaluable&r item for melee-focused adventurers."]
	quest.7DE87A4BA0CEBAC7.quest_subtitle: "A relic of the Abandoned Spire"
	quest.7DE87A4BA0CEBAC7.title: "&bBerserker Soul Amulet"
	quest.7DF6F1C7A1FFB1AE.quest_subtitle: "Upgrade+"
	quest.7DF8F09C2658AB69.quest_desc: [
		"&eFire&r can be deadly, but this ancient skull offers a way to turn the heat against you."
		""
		"When you &btake&r fire damage, the Obsidian Skull grants you Fire Resistance for 30 seconds. Once activated, it enters a &b60-second&r cooldown before it can protect you again."
		""
		"Walk &bthrough&r the flames. Fear nothing."
	]
	quest.7DF8F09C2658AB69.quest_subtitle: "Face the flames without fear"
	quest.7DFE97839AF0EE7B.quest_desc: [
		"&dArchevoker&r Boots are part of the Archevoker Armor set in Iron's Spells 'n Spellbooks. When worn, they provide &b+3&r Armor, &b+125&r Max Mana, &b+10%&r Evocation Spell Power and &b+5%&r Spell Power."
		""
		"They are &bcrafted&r or upgraded using 1 Wizard Boots, 1 Evocation Rune and 1 Arcane Essence."
	]
	quest.7DFE97839AF0EE7B.quest_subtitle: "Harness the arcane power of Evocation magic"
	quest.7DFFB96E59705C93.quest_desc: [
		"The Aeternium Sword is assembled from an Aeternium tool head and sword handle at a Smithing Table."
		""
		"As Better End's strongest bladed weapon, it &asurpasses&r even Netherite swords in power."
	]
	quest.7DFFB96E59705C93.quest_subtitle: "Blade of the strongest tier"
	quest.7E191DA83D23336E.quest_subtitle: "Yummy!"
	quest.7E345451D20ABDBF.quest_desc: ["&6Electrum&r Wire is an electrical component from Create Crafts \\& Additions, used to transfer electrical energy between &bcompatible&r components. It is &bpart&r of the mod's electrical system, alongside connectors and other wiring components. Use it to build reliable &bconnections&r between your &belectrical&r machines and power network."]
	quest.7E345451D20ABDBF.quest_subtitle: "Carry electricity across your factory"
	quest.7E35AC9122466A50.quest_desc: [
		"&aHunt &rdown Wither Skeletons deep in Nether fortresses."
		"These dangerous undead warriors are stronger than normal skeletons and can inflict the Wither effect, making them a serious threat even for prepared adventurers."
		"They are also a key source of Wither Skeleton Skulls, needed for summoning the &bWither boss&r."
	]
	quest.7E35AC9122466A50.quest_subtitle: "Bones of the Nether"
	quest.7E35AC9122466A50.title: "Wither Skeletons"
	quest.7E3ED0BE284235C4.quest_desc: ["&dA&r special orb &bused&r to upgrade Radiance equipment in Hazen N Stuff."]
	quest.7E3ED0BE284235C4.quest_subtitle: "An orb infused with radiant power"
	quest.7E3FBF9FD8AAE62C.quest_desc: [
		"&l&9A&r&r bigger backpack is useful, but what if every stack could hold more? The Starter Stack Upgrade increases the &bmaximum&r number of items that can be &bstored&r in a single stack inside your backpack."
		""
		"Start &bexpanding&r your storage efficiency and make every slot count."
	]
	quest.7E3FBF9FD8AAE62C.quest_subtitle: "Make every slot hold more"
	quest.7E3FD26AAEDAF5C8.quest_desc: ["Craft an Iron Shield to better protect yourself from stronger enemies."]
	quest.7E3FD26AAEDAF5C8.quest_subtitle: "Upgrade your defense with an Iron Shield!"
	quest.7E5DC58F49F2247C.quest_desc: [
		"&9&lYour&r&r collection is growing, and your storage should grow with it. The 4k Storage Disk provides significantly more digital storage capacity than the 1k version, &ballowing&r you to keep more resources within your Refined Storage network."
		""
		"Insert it into a Disk Drive and &bcontinue&r expanding your digital storage system."
	]
	quest.7E5DC58F49F2247C.quest_subtitle: "Expand your digital storage capacity"
	quest.7E97A19892D67000.quest_desc: [
		"At the &aheart&r of the Cursed Garden in Eternal Starlight, the Lunar Monstrosity awaits."
		"This powerful boss cannot be damaged normally — its body must first be ignited to make it vulnerable."
		""
		"Only those who &bunderstand&r its &bweakness&r and survive the chaotic arena can defeat it."
	]
	quest.7E97A19892D67000.quest_subtitle: "               Burn the beast"
	quest.7E97A19892D67000.title: "&l&dLunar &bMonstrosity"
	quest.7E9AB07322B4C76F.quest_desc: ["&aCombining&r the two strongest materials creates something truly powerful. Diamond Netherite is one of the most advanced &bmaterials&r you can obtain."]
	quest.7E9AB07322B4C76F.quest_subtitle: "The ultimate fusion"
	quest.7E9AB07322B4C76F.title: "Diamond Netherite Ingot"
	quest.7EA0BB2A661CAF74.quest_desc: ["&aThe&r Zoglin Trophy is a decorative trophy from My Nether's Delight. It serves as a display of your &badventures&r in the Nether and can be placed as a reminder of &bdefeating&r one of its dangerous creatures."]
	quest.7EA0BB2A661CAF74.quest_subtitle: "A trophy commemorating a defeated Zoglin"
	quest.7EAA5FBC5D509380.quest_desc: [
		"&eA&r ridiculous hat with a surprisingly useful purpose."
		""
		"The &bNovelty&r Drinking Hat lets you eat and drink much faster, keeping you ready for whatever comes next. Perfect for adventurers who simply &brefuse&r to stand still."
		""
		"&bPut&r it on and never waste time on a drink again."
	]
	quest.7EAA5FBC5D509380.quest_subtitle: "Why stop for a drink when you can keep moving?"
	quest.7EB471CBE7F64C2F.quest_desc: [
		"&6When&r a regular Airship isn't enough, it's time to bring in the heavy lifter. The Cargo Airship is a &blarger&r variant designed to carry your supplies while you travel through the skies."
		""
		"Load it up, fuel the engine, and take your cargo &bwherever&r your next adventure leads."
	]
	quest.7EB471CBE7F64C2F.quest_subtitle: "More room, more cargo, more reasons to take to the skies."
	quest.7EC9E6436F61CA3C.quest_subtitle: "More Armor"
	quest.7ECB1BDBCA5D9161.quest_desc: ["&6The&r Omni Speed Controller is an advanced rotational component from Create: Dreams n' Desires. It &bfunctions&r as an in-line speed controller, allowing you to precisely control the rotational speed of a mechanical system. It is especially &buseful&r in compact and advanced Create &bcontraptions&r where direct speed control is needed."]
	quest.7ECB1BDBCA5D9161.quest_subtitle: "Control rotation with precision"
	quest.7EDD4D32BB876974.quest_subtitle: "More Armor"
	quest.7EDF3CA9D97E2642.quest_desc: [
		"&9&lItems&r&r aren't the only things your Refined Storage network can store. The 64B Fluid Storage Disk provides a huge amount of digital fluid storage, &ballowing&r you to keep large quantities of liquids within your network."
		""
		"&bInsert&r it into a Disk Drive and &bconnect&r your fluid systems to store and access your liquids from one centralized network."
	]
	quest.7EDF3CA9D97E2642.quest_subtitle: "Store massive amounts of fluids digitally"
	quest.7EED2CC7E07E2A1E.quest_desc: ["&6Turns&r &belectricity&r into rotation. The motor's speed depends on the &bvoltage&r you provide. Connect its shaft to Create machines."]
	quest.7EED2CC7E07E2A1E.quest_subtitle: "Electricity into rotation"
	quest.7EF5E5A1A6C395E5.quest_desc: [
		"&9&lPush&r&r your Sophisticated Storage container beyond Gold Tier and upgrade it to Diamond Tier. This powerful upgrade &bsignificantly&r improves your storage &bcapabilities&r and brings your container closer to the ultimate storage tiers."
		""
		"&bUpgrade&r your storage with the strength and prestige of diamond and prepare for the final &bstages&r of your storage progression."
	]
	quest.7EF5E5A1A6C395E5.quest_subtitle: "Take your storage to a brilliant new level"
	quest.7EF732C90BA7DB6D.quest_desc: [
		"&dPaladin&r Chestplate is the Crystal Chronicles &bupgraded&r version of Priest Robes from Iron’s Spells ’n Spellbooks."
		""
		"It is &bupgraded&r using a Divinite Shard, transforming the original Priest Armor into the powerful Paladin Armor set. The Divinite Shard &binfuses&r the armor with the power of Holy magic, creating a stronger form of the original Priest equipment."
	]
	quest.7EF732C90BA7DB6D.quest_subtitle: "An enhanced Priest chestplate empowered by Divine energy"
	quest.7F1027ED71B7F405.quest_desc: [
		"&dThe&r Frostward Ring grants immunity to freezing, protecting you from the effects of freezing temperatures and &bfrost-based&r hazards."
		""
		"&bEquip&r the ring and explore icy environments without being slowed down by the cold."
	]
	quest.7F1027ED71B7F405.quest_subtitle: "Become immune to the freezing cold"
	quest.7F35E9098DEB72C3.quest_subtitle: "More Armor"
	quest.7F36DEA0C5DA7B78.title: "No Way"
	quest.7F3C32860D751BAC.quest_desc: [
		"The Netherite Hammer is a heavy tool and weapon required, alongside the &aAeternium Anvil&r, to forge Aeternium equipment."
		""
		"Without it, working raw Aeternium into plates and &btool heads&r isn't possible."
	]
	quest.7F3C32860D751BAC.quest_subtitle: "The smith's hammer of Netherite"
	quest.7F62DF594F61A754.quest_desc: ["&6Obtain&r a Steam Whistle from Create. It is a musical block powered by steam and activated with Redstone. It can be &bplaced&r on Fluid Tanks, tuned to different notes, and extended to &bcreate&r different pitches. Steam Whistles can also be &binstalled&r on Trains and used as their signature whistle."]
	quest.7F62DF594F61A754.quest_subtitle: "Let the factory announce its arrival"
	quest.7F6DABCFDD09F335.quest_desc: ["&dVolt&r Spear is a weapon from Crystal Chronicles, &bassociated&r with the enhanced Electromancer equipment. It channels the power of Lightning magic and the electrical energy of Voltite, &bmaking&r it a powerful weapon for lightning-focused spellcasters."]
	quest.7F6DABCFDD09F335.quest_subtitle: "A lightning-charged spear forged with the power of Voltite"
	quest.7F6F028F8415FD4D.quest_desc: [
		"&aDiscover&r the Dragon Graveyards, a striking red biome scattered with broken, mossy obsidian pillars and glowing blue mushrooms."
		""
		"Fireflies drift through the air here, giving this eerie yet lively biome its distinctive &bScape&r."
	]
	quest.7F6F028F8415FD4D.quest_subtitle: "Resting place of fallen giants"
	quest.7F6F028F8415FD4D.title: "Dragon Graveyards"
	quest.7F70095415342E3E.quest_desc: ["&6The&r Zinc Tools are a complete set of tools added by Create Stuff 'N Additions. The set includes a Pickaxe, Axe, Sword, Shovel and Hoe, giving Zinc another &buseful&r purpose beyond the &bmachinery&r of Create. Craft the full set and put this versatile &bmaterial&r to work."]
	quest.7F70095415342E3E.quest_subtitle: "Put zinc to work"
	quest.7F70095415342E3E.title: "Zinc Tools"
	quest.7F79E892485837D5.quest_desc: [
		"&9&lKeep&r&r your storage system organized with the Filter Upgrade. It controls which items can be inserted into or extracted from your backpack through &bautomation&r such as hoppers, pipes and &bother&r item transport systems. The basic version provides 9 filter slots."
		""
		"The Advanced Filter Upgrade &bgives&r you much finer control with 16 filter slots and filtering by item, mod, tag, NBT data and durability. You can also choose whether the filter applies to items &bentering&r the backpack, leaving it, or both."
	]
	quest.7F79E892485837D5.quest_subtitle: "Take complete control over what enters and leaves your backpack"
	quest.7F79E892485837D5.title: "Filter \\& Advanced Filter Upgrade"
	quest.7F80BB691F39098A.quest_desc: ["&6Craft&r the Inverted Clutch and Inverted Gearshift to gain &breversed&r redstone control over your &bkinetic&r network. Unlike their normal counterparts, these components operate with inverted logic, making them useful when you want machinery to run by default and stop or change behavior when a &bredstone&r signal is applied. Both are part of Create: Connected."]
	quest.7F80BB691F39098A.quest_subtitle: "Reverse the redstone logic"
	quest.7F80BB691F39098A.title: "Inverted Clutch \\& Inverted Gearshift"
	quest.7F8E2B32B4DD5A06.quest_desc: ["&6Craft&r the Fan Ending Catalyst using a Dragon Head and &buse&r it with an Encased Fan to perform Ending recipes. Bring the power of the End into your automated &bfan-processing&r setups."]
	quest.7F8E2B32B4DD5A06.quest_subtitle: "Harness the power of the End"
	quest.7F96EEF096B64D00.quest_desc: ["&6A&r decorative wire that lights up when powered. Change its pattern by combining it with any number of dyes in the crafting table."]
	quest.7F96EEF096B64D00.quest_subtitle: "Decorative string lights"
	quest.7F9B93826B86334E.quest_desc: [
		"&6Sometimes&r the best way to explore is to look ahead. The Telescope offers twice the zoom of a standard Spyglass, giving you a &bclearer&r view of distant terrain, structures and anything else waiting beyond the horizon."
		""
		"&bMount&r it to your aircraft and keep your eyes on what lies ahead."
	]
	quest.7F9B93826B86334E.quest_subtitle: "See the world from a whole new perspective."
	quest.7FA998C2837BBED4.quest_desc: ["Obtain &aRaw Iron&r by mining iron ore underground. Iron is one of the most important &bmaterials&r in Minecraft, allowing you to craft durable tools, armor, and many useful items. This is a major step forward in your journey."]
	quest.7FA998C2837BBED4.quest_subtitle: "A key resource for progression"
	quest.7FA998C2837BBED4.title: "&#A9A9A9Raw &#E7E7E7Iron"
	quest.7FADE016969EDE00.quest_desc: ["&6Welcome&r to Create: Sound of Steam! This &baddon&r brings pipe organs to Create, with a wide variety of organ stops and musical components. Build your own mechanical organ and fill your &bfactory&r with music."]
	quest.7FADE016969EDE00.quest_subtitle: "     Bring your factory to life with music        "
	quest.7FADE016969EDE00.title: "&l&6Welcome Create Sound Of Steam"
	quest.7FB0BB3E24A7FADA.quest_desc: ["&6A&r manual switch for higher voltages than the LV Switch. Put it in the circuit and click it to toggle &belectricity&r."]
	quest.7FB0BB3E24A7FADA.quest_subtitle: "A medium-voltage switch"
	quest.7FEA532FECAEBCAD.quest_desc: [
		"&9&lEvery&r&r great backpack upgrade starts somewhere. The Upgrade Base is the essential component used to create a wide variety of upgrades, from item &bcollection&r and storage improvements to powerful utilities."
		""
		"Craft one and &bstart&r building your backpack exactly the way you want it."
	]
	quest.7FEA532FECAEBCAD.quest_subtitle: "The foundation for a better backpack"
	quest.7FFB253F69B7A1A1.quest_desc: [
		"Craft a &aFilm Roll&r to store photographs taken with your Camera."
		"Film Rolls are required to &bcapture images&r and later project them using your Interplanar Projector."
	]
	quest.7FFB253F69B7A1A1.quest_subtitle: "Capture your memories"
	quest.7FFB253F69B7A1A1.title: "Film Rolls"
