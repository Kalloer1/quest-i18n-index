	quest.0F34A64AB5336D4E.quest_desc: ["&bHeadstones&r are a category consisting of 5 items that are mainly used in a graveyard for &aburying/keeping dead villagers in to be revived&r later with a &6Staff of Life&r or &6Scythe&r."]
	quest.0F34A64AB5336D4E.title: "Headstones"
	quest.0F35AF004588B678.quest_subtitle: "The thing your train goes on. No tracks, no train."
	quest.0F35AF004588B678.title: "Train Tracks"
	quest.0F4D90B6F179C6C5.quest_desc: [
		"Has builtin create trains support:"
		"{image:kubejs:textures/ftb/nexus.png width:200 height:150 align:center}"
		"Allows traversal to the Nexus. Each portal core has it's own cordinate scale. The blocks traveled in the Nexus are multiplied by this scale when leaving the dimension. You can use it in an anvil to give your portal a namewhen placed. You can also disguise this block as another by using with a held block."
	]
	quest.0F4D90B6F179C6C5.quest_subtitle: "Coordinate Scale: 64x"
	quest.0F557594B68FDA80.quest_desc: [
		"The &bStaff of Life&r is an item used to &6revive villagers&r. To revive a villager, you &amust be holding the staff and right click the tombstone&r of that certain villager."
		"Note: that it can be used only &a5 times before it breaks&r."
	]
	quest.0F8E8DC3D0291D76.quest_subtitle: "A dyeable bobber that can be dyed like leather armor."
	quest.0F9CC22264DF80E8.quest_subtitle: "When powered, extends a redstone pulse for a specified time, much like a Redstone Repeater. The time can be set in its Value Settings Screen accessed by holding right-click. It can be set to extend a signal for 2 ticks up to 60 minutes. The settings can also be copied and pasted onto other extenders or Pulse Repeaters by using a Clipboard."
	quest.0FB4FFD361C5DF69.quest_subtitle: "It's just a seat, nothing more, nothing less. But if you're in a moving contraption, might as well glue it to the contraption so you can sit and move along with it. Don't superglue yourself to the seat."
	quest.0FB4FFD361C5DF69.title: "Seats"
	quest.0FBB5A02F560CAB9.quest_subtitle: "The Analog Lever is used to emit a variable signal."
	quest.0FC7A3A0AE391782.quest_desc: ["Make your way to the roof. There, you will find the Obsidian Altar. When an Eye of Ender is added, the Obsidilith will spawn, which looks like a monolith."]
	quest.0FCB25BA5EB5E745.quest_subtitle: "Chains together individual Minecarts, causing them to move as a group"
	quest.0FDDADFAB8BDD0CE.quest_subtitle: "Can be found in a chest after defeating the Nether Gauntlet"
	quest.0FE0FD5B603DC91C.quest_subtitle: "Here you can find all the items you need to jumpstart your Ae2 experience"
	quest.0FE0FD5B603DC91C.title: "&eLocate: &dMoon Dungeon"
	quest.0FF159F5802886EB.quest_subtitle: "Dropped by the infernal dragon boss located in the nexus dimension"
	quest.0FF39255BD5908AD.title: "Crush Nether Wart to obtain Spices"
	quest.10331210B10CF626.quest_subtitle: "Lets you use SU to break blocks, can also be attached to contraptions to make tunnel bores and the like."
	quest.10340A31F8CA7447.quest_desc: ["When operating on a contraption, it captures fish and other creatures (configurable in mod settings) that it encounters, collects nearby items, and automatically generates fishing loot that varies across different biomes (such as jungle-specific drops), mimicking traditional fishing rewards."]
	quest.10340A31F8CA7447.quest_subtitle: "Designed for contraptions, enabling automation within moving mechanical setups"
	quest.105DF76C41B29756.quest_desc: [
		"How to use Backpack:"
		""
		"Can be accessed by holding it in the Main hand and right-clicking"
		""
		"Equippable on the back by clicking the \"Equip\" button in the backpack GUI, located on the right side just above the player's inventory slots"
		""
		"Can be accessed when equipped by pressing a key (by default B)"
		"Curios compatibility makes the backpack equippable only by placing it in the \"Back\" slot"
		""
		"Can be placed in the world as a block, making its storage accessible via hoppers/pipes"
		""
		"Renders on the player's back when equipped"
	]
	quest.105DF76C41B29756.quest_subtitle: "Upgrading is done at a Smithing Table: Leather + Backpack + Tier Upgrade Item"
	quest.105F6F541CFC8E79.quest_desc: ["Craft a canteen to hold water"]
	quest.105F6F541CFC8E79.title: "Obtaining a Canteen"
	quest.10622C9E74C50A95.quest_subtitle: "Seats are used to allow multiple entities to ride a Contraption. Seats come in every color of Dye. They function much like a Boat in that they can be ridden by players and mobs"
