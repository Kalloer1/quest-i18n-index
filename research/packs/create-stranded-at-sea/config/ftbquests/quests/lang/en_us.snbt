	quest.27C06C60461A5476.title: "Deepfry fries"
	quest.27DB3C5B00A2886E.title: "Lava"
	quest.27EDE6F87D3FCA18.quest_desc: [" Recipe: Any Herring + Any Cabbage + Egg"]
	quest.27EDE6F87D3FCA18.quest_subtitle: "Gives Nourishment."
	quest.282443E08C5A1A0D.quest_desc: ["Mechanical Eyes function just like Eyes of Ender. Use them to guide you to the stronghold and open the portal to the End dimension. They're also a useful crafting material."]
	quest.282443E08C5A1A0D.title: "&2Energize: &fMechanical Eye"
