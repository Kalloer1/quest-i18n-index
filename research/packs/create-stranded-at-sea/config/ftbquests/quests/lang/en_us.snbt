	quest.1FF48426173E7D70.quest_subtitle: "View description to see custom trades"
	quest.201A63EF00DFF001.quest_subtitle: "Ropes are essentially reverse scaffolding: the can be continuously deployed downward from the same spot, and can be climbed without collision. This allows players to safely descend or ascend high altitudes, such as ravines or mountains."
	quest.205DCDADC7B500B9.quest_subtitle: "A builder's best friend, this extension is going to be handy when reaching far and is perfect for building not only aesthetically, but also machinery with practicality."
	quest.208ADE3D28CEB3E6.quest_subtitle: "Package Frogports are used to move Cardboard Packages from and to Chain Conveyors."
	quest.209E93F35F42133B.title: "&eObtain: &fMechanical Eye Ingredients"
	quest.21113F8DE68DEB6B.quest_desc: ["The &bWedding Ring&r is an item which allows you to &6marry someone&r. It is one of the two only ring types in Minecraft Comes Alive: Reborn."]
	quest.21113F8DE68DEB6B.quest_subtitle: "Must have 100 hearts or more to gift"
	quest.21257050C6608D6E.quest_subtitle: "The Energy Acceptor converts energy from external systems into AE and stores it in the network.The following energy systems are supported: Forge Energy / Redstone Flux 2 FE = 1 AE."
	quest.21257050C6608D6E.title: "Powering Your Network 1"
	quest.2135F52B53CA2889.quest_desc: ["This can be located by either using an explorer's compass or the traditional method with Mechanical Eyes (Eyes of Ender)."]
	quest.2135F52B53CA2889.title: "Locate: Stronghold"
	quest.2165E80C52C79992.quest_desc: [
		"Press &bR &rwhile hovering over an item to view its Recipe"
		""
		"Press &bU &rwhile hovering over an item to view its Uses"
		""
		"Press &bX &rto Crawl"
		""
		"Press &bRight Click &rwhile crouching to hold a block. (Useful for chests, doesn't work on all blocks)"
		""
		"Press &bC &rto Zoom"
		""
		"Press &bM &rto open the World Map"
		""
		"Press &bN &rto Create a New Waypoint"
		""
		"Press &bU&r to see Player Death History"
		""
		"Press &bO&r to view the Claiming Screen"
		"{@pagebreak}"
	]
	quest.2165E80C52C79992.quest_subtitle: "Read my description! Make sure to scroll down."
	quest.2165E80C52C79992.title: "&9Important Controls"
	quest.217341A24A1ECA37.quest_desc: [
		"Farmer's Delight introduces the following feasts:"
		"Roast Chicken"
		"Stuffed Pumpkin"
		"Honey Glazed Ham"
		"Shepherd's Pie"
		""
		"Feasts are not edible directly as an item; they must be placed down as a block first. When placed, players can use (right-click) them with Bowls to serve themselves with a consumable portion."
		""
		"The existing feasts in Farmer's Delight provide 4 servings in total. Plated feasts will also leave behind leftovers in the form of a dirty plate; right-clicking or mining it will retrieve the original Bowl, and any bones or food scraps left behind."
	]
	quest.217341A24A1ECA37.quest_subtitle: "Feasts are very large meals, which can be placed as a block to provide multiple servings to players."
	quest.219BD200A2F9F457.quest_desc: ["This can be located by either using an explorer's compass or the traditional method with Mechanical Eyes (Eyes of Ender)."]
	quest.219BD200A2F9F457.title: "&9Locate: &fStronghold"
	quest.219E307B851DB05A.quest_subtitle: "Lets you reverse the direction of rotation by applying redstone."
	quest.21A6AC286292BA6D.quest_subtitle: "No blaze burner needed! (only works on boilers if you didn't already notice the name)"
	quest.21D00F543014D0BC.quest_subtitle: "Mechanical Saws are powered through rotational force, and when placed down facing to the side they will automatically chop down wood blocks in front of them. When chopping down a tree or giant mushroom, it will automatically destroy the entire tree by only destroying the bottom-most block."
	quest.21D071C553C01CA3.quest_subtitle: "Fluid Cells are the same as Item Cells, but instead of storing items they store fluids."
	quest.21DD4EFBB31B669D.quest_subtitle: "An upgraded version of the Copper Backtank."
	quest.21FDF9422FC94E3D.quest_desc: ["Like the hunger bar the thirst bar adds an extra element of survival to the game"]
	quest.21FDF9422FC94E3D.title: "Thirst"
	quest.223C98FD928D10EA.quest_subtitle: "Use mechanical insulating to create nether wart block"
	quest.2246A107ECC3CBC5.quest_subtitle: "Ooh, this is a fun contraption! Okay, so this thing is used to build your structures automatically, provided that you have a structure printed out in your schematic paper. You just need to prepare gunpowder and a storage unit with the required materials to build what you want. Also use a clipboard, will ya? It'll take note of the materials for you."
	quest.227597F357AA480D.quest_subtitle: "Allows for the extraction of liquids from items."
	quest.22A5AF0446FCE645.quest_desc: ["Ponder the item for more information"]
	quest.22A5AF0446FCE645.quest_subtitle: "Copy your written book, enchanted book, name tag, train schedule and more."
	quest.230E8B3569AF31C2.title: "Cover yourself in oil"
	quest.231C8943A649FD16.quest_subtitle: "Apply a Distillation Controller to a Fluid tank to create a Distillation Tower."
	quest.236C77DB20FD41A5.quest_subtitle: "Animals listed here can randomly spawn anywhere among the seas on spawnable blocks of course"
	quest.23719A9810940AE0.quest_desc: ["This versatile tool can pull creatures or items toward you, or propel yourself toward blocks."]
	quest.23719A9810940AE0.quest_subtitle: "Fires harpoons using compressed gas from your backtank"
	quest.2376841B439006ED.quest_desc: [
		"Aquaculture add various mechanics that can boost your chances of catching something while your line is cast, for example, bait. You can use use bait to increase your chances of catching a fish."
		""
		"You can obtain Leeches and Minnows by fishing, and Worms in a worm farm."
	]
	quest.2376841B439006ED.quest_subtitle: "use bait to increase your chances of catching a fish"
	quest.238D143D7C4955F8.quest_subtitle: "Double: chance to catch two things. (10%)"
	quest.23B8C7247BD6063D.quest_subtitle: "Unlike trap nozzles and standard nozzles, the smart nozzle only affects items and won't interact with players or creatures."
	quest.23E494D48D76CE85.quest_subtitle: "The Train Observer is used to detect passing Trains."
	quest.23FDE89E5E8C4914.quest_desc: ["Can also be found by releasing Soul Stars. Undead mobs, such as Skeletons and Zombies, drop these items. And a lot will need to be defeated to obtain Soul Stars. They act a lot like Ender Pearls and will point toward a Lich Tower (if one is within a reasonable distance)."]
	quest.2413CF0189C80F94.quest_subtitle: "Nautilus Shells can be obtained from Limestone"
	quest.24A2F4E35BC90324.quest_desc: ["Throw a pearl into one of the gateways in the sky to travel to the outer End islands, where you can start exploring the End dimension and everything it has to offer."]
	quest.24A2F4E35BC90324.title: "&bUse: &fGateway"
	quest.24E234AFB1CE8B59.title: "Obtain Steel"
	quest.24E88C05F00647B1.quest_subtitle: "Train Controls are required in the creation of Trains."
	quest.24EB864DFD699A4C.quest_subtitle: "Chance on hit to absorb nearby souls, tougheningand slowing the attack speed of the wielder."
	quest.25057E3802F78FF4.quest_desc: ["Found in the End, accessible by activating an End Portal in a stronghold."]
	quest.25057E3802F78FF4.quest_subtitle: "The iconic final boss of Minecraft, a massive dragon residing in the End dimension."
	quest.2514AB3B7328A19F.quest_desc: ["This modpack consists of several &6bosses&r to enhance the adventure aspect of the game, encouraging players to defeat them to earn &ecoins&r and unique items useful for their &6automation setups&r."]
	quest.2514AB3B7328A19F.title: "&l&dBosses"
	quest.2524E7477AF77C7E.quest_subtitle: "Ponder Me"
	quest.252718F7C534BB18.quest_desc: ["From the surface to deepslate all caves are waterlogged. Because of this its recommended make a diving suits to make your mining endeavors easier."]
	quest.252718F7C534BB18.quest_subtitle: "Make your mining endeavors easier"
	quest.252718F7C534BB18.title: "&eCraft: &fDiving Suit"
	quest.2545476F450C03AD.quest_subtitle: "The Rope Pulley creates Contraptions much like a Mechanical Piston, but in only one direction and without the need for Piston Extension Poles."
	quest.2550A75D8A031F9E.quest_subtitle: "Press &c\"Z\"&r To see How to Build It"
	quest.2550A75D8A031F9E.title: "Build an Advanced Distillation"
	quest.2585E8C16C7EA545.quest_subtitle: "Easy"
	quest.259DBC1BA592EC11.quest_subtitle: "Chance on hit to ignite your targetand send them flying."
	quest.25E727CF92E96F29.quest_desc: ["Place a basin lid on a basin to enable passive processing. This process will create ethanol."]
	quest.260ABDA43FB1446E.quest_desc: ["These items &bwill help&r you &6manage&r your &avillagers&r."]
	quest.260ABDA43FB1446E.title: "Managment"
	quest.2616013086EDBE43.quest_desc: ["Dump lava (preferrably via an automated method) on the active molten vent and watch as the lava turns into the corresponding orestone."]
	quest.2616013086EDBE43.quest_subtitle: "Notice that the dormant molten vent is now an active molten vent by seeing the magma in it become brighter"
	quest.26A3FE3A6599FAE2.quest_subtitle: "While wielded, gain a frost aura that dealsdamage and slows enemies within X blocks."
	quest.26C695A33FE21E42.quest_subtitle: "Can be used to store Targeting Computers to reduce a rocket's Fuel Cost"
	quest.26D7ADB984AA5EB1.quest_subtitle: "Fast and rather reliable. Make sure your runway is long enough"
	quest.26E70D21F187E267.quest_subtitle: "Can be created after throwing a chromatic compound through a activate beacon beam"
	quest.273C875F21F7C266.title: "Lava"
	quest.27474DC1059FC89D.quest_subtitle: "A schematic with a pattern function"
	quest.27560376508D3057.quest_desc: ["A customizable version of the diesel engine, allowing for various upgrades and modifications."]
	quest.27560376508D3057.quest_subtitle: "Ponder Me"
	quest.2764B4CD3C86DF86.quest_subtitle: "Obtain Nether related items through custom automation trees, exploration, and trading with villagers"
	quest.2764B4CD3C86DF86.title: "The Nether Dimension is Disabled"
	quest.277591B8EC1EB984.quest_subtitle: "Difficult"
	quest.27BAA1F4DE80AC55.quest_subtitle: "Stores up to 200,000 AE. They do not accept power directly, but are used to add additional power storage to an already existing ME Network."
