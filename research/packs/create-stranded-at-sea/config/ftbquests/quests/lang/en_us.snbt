	quest.44A89246738B67CA.quest_desc: ["Congratulations on unlocking the Nether! Now you can obtain crucial items like blaze burners, cinder flour, blaze rods, and more, which are essential for many Create mod and other complex custom recipes."]
	quest.44AE17D3427B487C.quest_subtitle: "\"A fancier rope pulley\"\\n\\nAllows for the creation of elevators."
