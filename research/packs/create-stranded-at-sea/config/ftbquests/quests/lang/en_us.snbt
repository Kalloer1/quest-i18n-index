	quest.765245A57447337A.quest_subtitle: "View description to see custom trades"
	quest.76BA7F68F2A1D36D.quest_desc: [""]
	quest.76BA7F68F2A1D36D.quest_subtitle: "Can be Crafted from Materials Dropped By The Sandworm"
	quest.76C1B8BC5C9B7624.quest_subtitle: "The Encased Fan is a mechanical component that can create air streams. Encased Fans are used for moving entities, vertical transport of items, Bulk Washing, Bulk Blasting, Bulk Haunting, and Bulk Smoking."
	quest.76F2B8E82024B27F.quest_desc: [
		"Introducing... "
		""
		"Conduit Channeling: A new fan processing type which uses am active conduit as the catalyst"
	]
	quest.76F2B8E82024B27F.quest_subtitle: "a machine used for granting/removing effects and also simplyifying chanelling setups."
	quest.7719D15EF06F0CAC.title: "Locate: Nether Fortress"
	quest.774B103D8D61CBD9.quest_desc: [
		"How to use Backpack:"
		""
		"Can be accessed by holding it in the Main hand and right-clicking"
		""
		"Equippable on the back by clicking the \"Equip\" button in the backpack GUI, located on the right side just above the player's inventory slots"
		""
		"Can be accessed when equipped by pressing a key (by default B)"
		"Curios compatibility makes the backpack equippable only by placing it in the \"Back\" slot"
		""
		"Can be placed in the world as a block, making its storage accessible via hoppers/pipes"
		""
		"Renders on the player's back when equipped"
	]
	quest.774B103D8D61CBD9.quest_subtitle: "Upgrading is done at a Smithing Table: Leather + Backpack + Tier Upgrade Item"
	quest.776A87112BDD7E7A.quest_desc: ["Recipe: Tuna + Raw Pasta + Tomato Sauce + Any Mushroom"]
	quest.776A87112BDD7E7A.quest_subtitle: "Gives Nourishment."
	quest.776F0CA023690BC6.quest_subtitle: "Can display text or numbers."
	quest.77A2AC02B5A801CC.title: "&eVisit: &aOverworld"
	quest.77CDD065B0014F45.quest_desc: ["Using &6coins&r, you can increase your limit of &2claimable chunks&r."]
	quest.77CDD065B0014F45.quest_subtitle: "Claiming More Chunks with Coins"
	quest.77DDF57E9E43C076.title: "Use an Spring Coiling Machine to obtain a spring"
	quest.781B2A5A748A7D70.quest_desc: ["Larger versions of the diesel engine, providing more rotational power."]
	quest.781B2A5A748A7D70.quest_subtitle: "Ponder Me"
	quest.783697550B10B97D.quest_desc: [
		"Key Features:"
		"Package delivery system that reads address labels and send a bee with the packages to players or other Bee Ports"
		"Insert packages manually or automatically using Funnels, Chutes, or Hoppers"
		"Pull packages from adjacent inventories"
		"Push packages to adjacent inventories if:"
		"The address matches the Bee Port's configured addresses"
		"The Bee Port receives a redstone signal"
	]
	quest.783697550B10B97D.quest_subtitle: "The Bee Port is a specialized block that automates the delivery of Create mod Packages to players or other Bee Ports."
	quest.784AFC8271E47A9A.quest_subtitle: "The Radial Chassis is a block used to connect Contraptions."
	quest.784FB68F70299F18.quest_subtitle: "When placed on the Encased Fan the Nozzle changes the area of effect of the pushing/pulling into a sphere instead of a line."
	quest.785322C002100649.quest_subtitle: "Keep a network running at speed with a powered brake attached"
	quest.785322C002100649.title: "Overpowered"
	quest.7874D4D4BDA8BEEA.quest_subtitle: "Designed for oceanic creatures, suited for water-based mobs"
	quest.78919F4886644673.quest_subtitle: "Blend liquids with the use of a heated mixer and basin to create random spawn liquid"
	quest.78919F4886644673.title: "Ender Pearl and Blaze Rod"
	quest.78C93FD742EF774C.quest_desc: ["Dump lava (preferrably via an automated method) on the active molten vent and watch as the lava turns into the corresponding orestone."]
	quest.78C93FD742EF774C.quest_subtitle: "Notice that the dormant molten vent is now an active molten vent by seeing the magma in it become brighter"
	quest.78DB95A9FE47CB35.quest_subtitle: "Can hold a large amount of train tracks"
	quest.78FD1194BC340EF2.quest_desc: ["Soul Stars can be obtained by killing mobs and are used to summon the Nightlich boss."]
	quest.78FD1194BC340EF2.title: "&eObtain: &fSoul Stars"
	quest.79373E9AAF722303.quest_subtitle: "Collects eggs from chickens"
	quest.798CADF6B8930572.quest_subtitle: "A machine that can autocraft shapeless recepies aswell as mix things like potions.\\n\\nNeeds to rotate at at least 30 rpm to function"
	quest.7991B5D4970CDCFE.quest_subtitle: "A component required for making item storage cells. Storage Cells are one of the core mechanics of storage in Applied Energistics 2, there are three kinds: one for items, one for fluids, and one for regions of space. These ones store items only."
	quest.79CB6721CF8D4930.quest_desc: [" &bNeedle And Thread&r can &6change player's clothing&r."]
	quest.79CC43138648488B.quest_desc: ["Using &6coins&r, you can increase your limit of &2claimable chunks&r."]
	quest.79CC43138648488B.quest_subtitle: "Claiming More Chunks with Coins"
	quest.7A146D066FB94177.quest_subtitle: "Farm optimized for desert creatures, suited for arid mobs"
	quest.7A514B0859DA056B.quest_subtitle: "Ponder Me"
	quest.7A5A9731FCBE86A1.quest_desc: [""]
	quest.7A5A9731FCBE86A1.quest_subtitle: "Lanterns are crafted unlit"
	quest.7A5A9731FCBE86A1.title: "&bCraft: &fLantern"
	quest.7A6EA213B9F20D50.title: "&aVisit: &rMercury"
	quest.7B3913CCEBC7717D.quest_subtitle: "Gives off a redstone signal when detecting a train."
	quest.7B4FA7F70BB393A6.quest_subtitle: "The Mechanical Roller can be used on Contraptions to clear and pave a path."
	quest.7B5CD4D7812029DA.title: "&eLocate: &6Venus Bullet"
	quest.7B90A1A66B750F76.quest_subtitle: "Give your Blaze Burner a Enchanting Guide and turn it into a Blaze Enchanter"
	quest.7B90A1A66B750F76.title: "Blaze's New Job"
	quest.7B9D2F7F33818837.quest_subtitle: "Essentially the an upgrade to the millstone, provides some different recipes so it might be worth keeping both around."
	quest.7BC7D4057E57DB9F.quest_desc: ["Complete a Super Complex Automation Tree to obtain this item. See the overview of this tree in the Mechanisms questline."]
	quest.7BE3AAA9531B650B.quest_subtitle: "Crushing Wheels are the more advanced version of the Millstone. It applies Crushing recipes to any items inserted from the direction they are spinning away from."
	quest.7BF98C255DE79F59.quest_desc: ["Using &6coins&r, you can increase your limit of &2claimable chunks&r."]
	quest.7BF98C255DE79F59.quest_subtitle: "Claiming More Chunks with Coins"
	quest.7C015A2CA4645E7A.quest_subtitle: "The Adjustable Chain Gearshift functions similarly to Encased Chain Drive, but can change the speed of the output when powered with redstone."
	quest.7C0C87AECC742AC0.quest_subtitle: "Basically electricity = speed"
	quest.7C524B36AB0B9154.quest_subtitle: "Encase yourself in ice for Xs, rendering youimmune and granting you regeneration."
	quest.7C5CDB413D2EBD0C.quest_subtitle: "Copycat blocks allow you to make steps and panels out of things that typically cannot take those shapes."
	quest.7C77FA44B80B6BB4.quest_subtitle: "This mod requires cookies to work properly. Please insert them into the jar"
	quest.7C77FA44B80B6BB4.title: "Accept and Continue"
	quest.7C8E68BC8896C9B7.title: "&aVisit: &rOverworld"
	quest.7CAF95DAF8B2ABEC.quest_subtitle: "Blast trough the water to smelt items."
	quest.7CB9F98F12F286A3.quest_desc: [
		"1. Any animals you slay using a Knife are guaranteed to drop secondary items, such as Leather and Feathers."
		""
		"2. Grassy plants (grass, wheat, rice etc) cut with a Knife will occasionally yield Straw, a firm and useful fiber;"
		"They act as a modest melee weapon: swings faster than a sword for lesser damage."
		""
		"3. Later on, they are also useful for cutting and portioning ingredients when preparing meals."
		""
		"4. Knives are tiered like standard tools, except they cannot be made out of wood or stone. The simplest one you can make is the Flint Knife. Now is the time to find and dig up some gravel!"
	]
	quest.7CB9F98F12F286A3.quest_subtitle: "Knives are scavenging tools: they allow you to obtain a few more resources from both fauna and flora."
	quest.7CC7F87F89B378E6.quest_desc: ["The &bEngagement Ring&r can be &6gifted&r earlier than the Marriage Ring and will set both the player and the villager into the &aengaged relationship&r. Now, neither other villagers nor players can marry that villager."]
	quest.7CC7F87F89B378E6.quest_subtitle: "Must have 50 hearts to gift"
	quest.7CD315EEF62CFCC2.quest_subtitle: "Craft a Graphite"
	quest.7CD315EEF62CFCC2.title: "High Carbon Density"
	quest.7CE1C76E647907BC.quest_subtitle: "The Large Water Wheel is a bigger version of the Water Wheel."
	quest.7CE57418A40E58F2.quest_subtitle: "Connect Wires to connectors to transfer energy."
	quest.7D0671C49C20667F.quest_subtitle: "The Mechanical Drill is a block used to break blocks."
