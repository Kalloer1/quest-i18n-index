	quest.3FF259132A86D74A.title: "Lava"
	quest.4007D36163F8555E.quest_subtitle: "Grinding it all down to dust."
	quest.402CCCC50B86CFC3.quest_desc: ["A copper backtank can be used to supply the player with oxygen, allowing them to dive deep into the ocean. This item must be paired with a diving helmet in order to actually work. "]
	quest.402CCCC50B86CFC3.quest_subtitle: "With this, I can supply myself with an oxygen source to allow me to adventure to the bottom of the ocean and enable the ability to venture into the mines."
	quest.405521ABB6867AB3.quest_desc: ["Using &6coins&r, you can increase your limit of &2claimable chunks&r."]
