	quest.57F81BA8968902CD.quest_desc: [
		"&9Stats:"
		"SU:&r 2,048 passive or 16,384 active &6SU &r"
		"RPM: 16 passive or 64 active &bRPM&r"
		""
		"The &6steam engine&r is a block that provides rotational force. It offers the highest voltage unit (SU) capacity of all the power-generating blocks in Create. It converts the pressure generated by heating water in a fluid tank into rotational force, enabling the large-scale production of objects and the operation of multiple devices."
	]
	quest.57F81BA8968902CD.quest_subtitle: "[Click to read]"
	quest.57FB01D9FFEC551E.quest_desc: ["Use to check for &6Crude Oil&r Deposits."]
	quest.57FB01D9FFEC551E.quest_subtitle: "[Click to read]"
	quest.582EA988A80E74A2.quest_desc: [
		"&9Default Stats:&r 256SU and 8RPM"
		""
		"The Water Wheel is a source of rotational power. It generates Rotational Force when water flows over it."
		""
		"Total &6Stress Capacity&r or &6SU&r can be increased by adding more wheels in parallel how we explain in the Gear task"
		""
		"Water Wheels can also be powered by Lava, Chocolate, and Bubble Columns."
	]
	quest.582EA988A80E74A2.quest_subtitle: "[Click to read]"
	quest.5A08B1A8E28FF7D0.quest_desc: ["The &6chest suit&r needs to be oxygenated to avoid suffocation in space."]
	quest.5A08B1A8E28FF7D0.quest_subtitle: "[Click to read]"
	quest.5A08B1A8E28FF7D0.title: "&6Space Suit"
	quest.5A9A2DEBB335593B.quest_desc: ["By &bpumping&r &6oxygen&r through a &6pipe&r from behind, and having a &6chest space suit&r inside, it fills it with &boxygen&r."]
	quest.5A9A2DEBB335593B.quest_subtitle: "[Click to read]"
	quest.5A9A2DEBB335593B.title: "&6Oxygen Filler"
