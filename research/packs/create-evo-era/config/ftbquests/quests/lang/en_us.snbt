	quest.4A293666A27FADA4.title: "&6Tier 2&r MV Acumulator"
	quest.4A29ED62AE12A8EC.quest_desc: [
		"It's for making the &6reactor casing&r"
		""
		"And&6 Overcharged Ores&r"
	]
	quest.4A29ED62AE12A8EC.quest_subtitle: "[Clik to read]"
	quest.4A364B31D45BC575.quest_desc: [
		"&9What it does:&r Converts a group of blocks into a dynamic \"&bcontraption&r\" entity with real mass and collision.   "
		""
		"&9How it does it:&r When activated by &6redstone&r, it scans all connected blocks (via &6glue&r or chassis) and uses the &bSable physics engine&r to treat the entire structure as a single rigid body."
	]
	quest.4A364B31D45BC575.quest_subtitle: "[Click to read]"
	quest.4B814952188322C7.quest_desc: ["This is for the first &bmultiblock&r.It's crafted by mixing&6 clay balls, sand, and bricks&r."]
