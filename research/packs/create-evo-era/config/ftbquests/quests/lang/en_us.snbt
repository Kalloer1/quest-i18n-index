	]
	quest.543E481690357B76.quest_subtitle: "[Click to read]"
	quest.552140EE48B92C9F.quest_desc: ["The &6Inventory Hopper&r can pull items from inventories as &6chests&r, &6item vaults&r... Above it and push them into your &bstorage network&r."]
