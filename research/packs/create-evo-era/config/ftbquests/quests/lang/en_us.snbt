	quest.51AB283A559B1522.quest_subtitle: "[Click to read]"
	quest.51AB283A559B1522.title: "&6More..."
	quest.524C2B06230556DE.quest_subtitle: "Prevent shock damage when touched"
	quest.52C20216875029AD.quest_desc: [
		"You can equip them on your shoulder by holding + &b'º'&r (above TAB) while pressing&b R-click&r and &bcrouching&r."
		""
		"Keep holding if you want to equip more than one on your shoulder."
		"&6To remove them&r, press 'º' again while &bstanding&r."
		""
		"Press &b'G'&r once on your shoulder to throw them (this damages enemies)."
	]
	quest.52C20216875029AD.quest_subtitle: "[Click to read]"
	quest.52C20216875029AD.title: "&6Information"
	quest.52F6B0CB831D3B9B.quest_desc: [
		"The basic &6Conveyor Belt&r moves items in one direction. Use the &6Engineer’s Hammer&r to rotate direction. Shift-click with the hammer to toggle incline mode for going up one block height."
		""
		"I recommend you only use it for &bIE&r things."
	]
	quest.52F6B0CB831D3B9B.quest_subtitle: "[Click to read]"
	quest.530639AFC921B759.quest_desc: [
		"&6Connectors&r attach to machines and buildings to receive wires. Each connector tier must match its wire tier."
		""
		"Connectors can only connect to one wire each, so use them at endpoints. Use your Engineer’s Hammer to configure sides as&b input (blue)&r, &6output (orange)&r, or &4disabled&r"
	]
	quest.530639AFC921B759.quest_subtitle: "[Click to read]"
	quest.530639AFC921B759.title: "&6Connectors"
	quest.543E481690357B76.quest_desc: [
