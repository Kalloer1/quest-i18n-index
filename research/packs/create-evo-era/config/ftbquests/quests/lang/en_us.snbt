	quest.5AADE4F5222B6CC7.quest_subtitle: "[Click to read]"
	quest.5AAF9FBBE6C78942.quest_desc: ["The &6Level Emitter&r provides redstone integration capabilities for your&b storage network&r, allowing you to create automated responses based on inventory levels."]
	quest.5AAF9FBBE6C78942.quest_subtitle: "[Click to read]"
	quest.5B32BF2AFCBC081D.quest_desc: ["The &6Propeller Bearing&r is a Bearing to make a propeller, which can produce thrust. "]
	quest.5B32BF2AFCBC081D.quest_subtitle: "[Click to read]"
	quest.5B421D92A1D95A3C.quest_desc: [
		"The &bMetal Press&r stamps ingots into &6Plates, Rods, Wires,&r and other components using interchangeable Molds. "
		""
