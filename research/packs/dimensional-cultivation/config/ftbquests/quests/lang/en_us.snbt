{
	chapter.5EC0925000000001.title: "Sects and the Four Guardians"
	chapter.5EC0927A00000001.title: "Cultivation Trials and Optional Challenges"
	chapter.5EC1A70000000101.title: "Chapter 1 - Martial Warrior"
	chapter.5EC1A70000000102.title: "Chapter 2 - Martial Master"
	chapter.5EC1A70000000103.title: "Chapter 3 - Great Martial Master"
	chapter.5EC1A70000000104.title: "Chapter 4 - Martial Lord"
	chapter.5EC1A70000000105.title: "Chapter 5 - Martial King"
	chapter.5EC1A70000000106.title: "Chapter 6 - Martial Grandmaster"
	chapter.5EC1A70000000107.title: "Chapter 7 - Martial Emperor"
	chapter.5EC1A70000000108.title: "Chapter 8 - Martial Supreme"
	chapter.5EC1A70000000109.title: "Chapter 9 - Martial Sovereign"
	chapter.5EC1A7000000010A.title: "Chapter 10 - Martial God"
	chapter.5ECD100400000001.title: "Sect Life and Discoveries"
	chapter.5ECFA92400000001.title: "FAQ and Help"
	chapter_group.5EC1A70000000001.title: "Dimensional Cultivation"
	quest.016A977DBDA26048.quest_desc: [
		"Gather 162 Sovereign Blood Casings for the Heaven-Earth Blood Crucible. Use its structure preview for placement."
		""
		"Allow extra materials for the controller and blueprint recipes."
	]
	quest.016A977DBDA26048.title: "Sovereign Blood Casings"
	quest.01A0911225DC79B6.quest_desc: [
		"Follow the Primordial Tribulation Forge's layered JEI preview. Both fluid inputs are on the rear wall: use a Celestial or Divine input for each, holding 64,000 mB Liquid Ki and 64,000 mB Ancestral Dragon Blood separately."
		""
		"Fit at least one Divine Energy Input Hatch in the rear energy ports and supply 20,000,000 FE/t for the Primordial Dao Heart recipe. Keep the Draconic Reactor Core in the internal position shown by JEI; it does not need fuel or activation."
		""
		"Use a Big Item Input Bus or better: a Normal bus cannot hold all the ingredients at once."
	]
	quest.01A0911225DC79B6.title: "Build the Primordial Tribulation Forge"
	quest.021217CAED75B6B3.quest_desc: [
		"Make four Heavenforged Law Alloy Ingots in the Law Loom with Liquid Ki, Ancestral Dragon Blood and the listed items."
		""
		"Reserve these for the Heavenly Mandate and law-branch assemblies. They are distinct from Chaos Meridian Alloy."
	]
	quest.021217CAED75B6B3.title: "Engrave Heavenforged Law Alloy"
	quest.034381E1F9D0CE71.quest_desc: [
		"Make Spirit Silk in the Spirit Loom. Energize it with Meridian Binding Resin and a Redstone Block to produce two Scarlet Meridian Threads for 500,000 FE."
		""
		"Keep both silk and thread in your inventory until their separate tasks register."
	]
	quest.034381E1F9D0CE71.title: "Spin Scarlet Meridian Thread"
	quest.03D6E707341AF94E.quest_desc: [
		"Build the encoded Ancestral Reconstructor from its JEI structure. Supply mined remains, the other recipe ingredients, Liquid Ki and FE to produce Reanimated Remains."
		""
		"Need more raw remains for casings? Run 1 Ancestral Remains, 16 Bones, 4 Mortum Soul Filaments and 2 buckets of Liquid Ki through this machine to make 8 Ancestral Remains. Each batch takes 30 seconds at 1.8 million FE/t. Keep one remains to start the next batch."
		""
		"The quest checks both the controller and processed output."
	]
	quest.03D6E707341AF94E.title: "Ancestral Reconstructor"
	quest.04B1290095A06DAF.quest_desc: [
		"Prepare an Altar of Cleansing and the requested Holy Water. Vampirism's guide explains the altar; check JEI for the bottle tier accepted by Honeysuckle."
		""
		"You do not need to become a vampire. Keep three bottles for the quest to detect, then use the amount required by the recipe."
	]
	quest.0511D062E8779737.quest_desc: [
		"Craft 97 Mortum Resonance Casings using the table shown in JEI. Let the task detect them before building."
		""
		"Make additional casings for the controller recipe; the construction stock and crafting ingredients are separate costs."
	]
	quest.0511D062E8779737.title: "Mortum Resonance Casings"
	quest.052C60E660F9D3B0.quest_desc: [
		"Assemble the Apotheosis Keystone in the large crafting grid shown in JEI. Keep it for the Tenfold Apotheosis Altar."
		""
		"Check the final pill's remaining ingredients, including Genesis Dao, before dismantling any production lines."
	]
	quest.052C60E660F9D3B0.title: "Seal the Apotheosis Keystone"
	quest.05EDE50E31EC7448.quest_desc: [
		"Buy your first Mugwort from the Market from Farming for Blockheads. Each Mugwort costs 4 Wildwood Fragments; this is a Market trade, not the inventory coin shop."
		"Craft spare Mugwort into Mugwort Seeds and plant them on farmland for a renewable supply. Keep some plants or seeds instead of smelting everything."
		"Collect nineteen Mugwort for the first task, then smelt additional plants into nineteen Mugwort Ash. The Ash is needed for Soul-Tempering Salt."
	]
	quest.06E5403F52F37A26.quest_desc: [
		"Build the encoded Primordial Blood Refinery from its JEI preview. Place one Multiversal Fluid Tank in the center and leave the upper interior empty. The two fluid inputs sit at the rear, with a glass block between them."
		"Supply Living Blood and Dragon Vein Essence through separate input hatches, the Ancestral Memory Imprint through the item input, and FE through the energy hatches. The central tank is a structure block, not a recipe input."
		"The recipe needs 6,000,000 FE/t. Fit two Celestial energy inputs, or use a Divine input, and provide cables and generation that can sustain that draw."
		""
		"Collect a bucket of Ancestral Dragon Blood, then store it in bulk for the Regenerator and later multiblocks."
	]
	quest.06E5403F52F37A26.title: "Primordial Blood Refinery"
	quest.080C5BB2F252992B.quest_desc: ["Craft an Elite Crafting Table for its 7×7 grid. This is the table used for the Scarlet Anvil pill; follow JEI's full pattern and ingredient variants."]
	quest.081C8BE6CC7432AE.quest_desc: [
		"Use Draconic-tier Fusion Crafting with a Dragon Heart as catalyst. Put two each of Draconium Core, Weather Crystal, Eternal Stella and Tempered Spirit Steel Plate on the injectors."
		""
		"Each operation uses 24,000,000 FE and makes one Tribulation Dragonheart Core. Run four batches and keep all four cores for the final pill."
	]
	quest.081C8BE6CC7432AE.title: "Four Tribulation Hearts"
	quest.08AEACAB6E11E6D5.quest_desc: [
		"Build the encoded Dragon Vein Manipulator from its structure preview. Process the listed solid ingredients to obtain a bulk supply of Dragon Vein Essence."
		""
		"Install a fluid output hatch with enough capacity and drain it to the Blood Refinery's essence tank. Keep this separate from Living Blood."
	]
	quest.08AEACAB6E11E6D5.title: "Dragon Vein Manipulator"
	quest.09C9F53C31AB6AC2.quest_desc: [
		"Make Honeysuckle from Poison Spirit Bloom, Venom-Charged Spirit Jade, Refined Glowstone and Holy Water, following JEI."
		""
		"Build and supply a Ki Crystal Cultivator for the Lesser Ki Crystal. The quest checks the Honeysuckle, cultivator and crystal separately."
	]
	quest.09F10CD4B5EAFD0B.quest_desc: [
		"The Meridian Ki Reservoir stores Machine Ki; it does not generate it. Build a Liquid Ki Dynamo and feed it Liquid Ki from your Liquefier to produce the first supply."
		""
		"Link the Dynamo, Reservoir and consumers through Crystal Interfaces on an accessible channel. Check that the Reservoir's Ki bar fills before starting the forges. Machine Ki is separate from FE and your personal Ki."
	]
	quest.0A98969399E6180C.quest_desc: [
		"Use ordinary fire and the Artisan Relic in the Clibano to combine Eternal Ember with Spirit Silk into a Forgeheart Core."
		""
		"Then use the Matrix recipe's soul-fire conditions and Scarlet Meridian Thread. Detect both products before spending them; the Chapter 5 forge provides a later batch route."
	]
	quest.0A98969399E6180C.title: "Complete the Scarlet Anvil Matrix"
	quest.0D13CE5447DEB030.quest_desc: [
		"Assemble the Mortum Evolved Core from Mortum materials and advanced alloys in JEI's required crafting table."
		""
		"Use it in the Alloyer to make a Void-Tempered Dantian. It is a different component from the Awakened Synthetic Dantian Core."
	]
	quest.0D13CE5447DEB030.title: "Mortum Evolved Core"
	quest.0D2B13331B33C900.quest_desc: [
		"Build the complete Clibano multiblock using the Forbidden and Arcanus guide and install the Artisan Relic."
		""
		"Check the fire type for each recipe: Eternal Ember and Scarlet Anvil Matrix need soul fire; Forgeheart Core uses ordinary fire."
	]
	quest.0D67A3D7AA133B44.quest_desc: [
		"Run twelve Causality Thread batches in the Samsara Wheel. Each gives eight threads and consumes its items plus 16,000 mB Liquid Ki."
		""
		"The 96-thread task is an initial stockpile; keep producing for the later components."
	]
	quest.0D67A3D7AA133B44.title: "Spin Causality Threads"
	quest.0EBB3187FD474E41.quest_desc: ["Obtain Starlit Diamonds through Eternal Starlight's resource progression. Save some for Astral Meridian Ingots as well as equipment."]
	quest.0ECE7A960A742CF1.quest_desc: [
		"Make a Soul Stained Steel Scythe and use it to reap the spirits needed by Malum's Spirit Altar recipes."
		""
		"Collect separate stocks of Arcane, Sacred, Aerial, Aqueous and Eldritch Spirits. Check the matching creatures' drops in JEI; ordinary mob drops and XP do not replace spirits."
	]
	quest.1201438C7596BA7D.quest_desc: [
		"Energize Ender IO End Steel in Powah's Orb. Each Charged End Steel Ingot costs 750,000 FE."
		""
		"Use the charged ingots in the Spirit Steel plate recipe, and remove finished batches before changing Orb recipes."
	]
	quest.12A5A1DCE5DA1F2A.quest_desc: [
		"Combine the Eternal Starlight boss materials into Starforged Boss Essence using JEI's recipe."
		""
		"Complete the weapon collection tasks before consuming their items, and keep spares of weapons you want to use."
	]
	quest.13AA4F4C5ED5FFB2.quest_desc: [
		"Use Draconic Fusion Crafting to make Chaos Meridian Alloy with JEI's catalyst, injector ingredients and injector tier."
		""
		"Collect eight ingots for this task and make extra for the structures and components ahead."
	]
	quest.13AA4F4C5ED5FFB2.title: "Forge the Chaos Meridian Alloy"
	quest.14DCE886B290462B.quest_desc: [
		"Craft the encoded Heavenly Tribulation Crucible controller and assemble its complete JEI structure. It awakens your spare dormant core."
		""
		"Check the energy hatch capacity and recipe draw, and keep the Spirit Meridian Essence line supplied."
	]
	quest.14DCE886B290462B.title: "Heavenly Tribulation Crucible"
	quest.1543862BD2DC4BBB.quest_desc: [
		"Supply the Osmium Compressor with FE, its Osmium input and the item you want to process. Use it to make Refined Glowstone for spirit alchemy."
		""
		"If the recipe stalls, check the Osmium tank, input slots and side configuration for leftover or incompatible contents."
	]
	quest.171D4EEF9427CD49.quest_desc: [
		"Run ten Law Fragment operations in the Law Loom. Each gives one Tenfold Law Fragment and consumes its items plus 8,000 mB Liquid Ki."
		""
		"Collect ten identical fragments; you do not need ten different variants."
	]
	quest.171D4EEF9427CD49.title: "Engrave the Ten Universal Laws"
	quest.172692C9689122D0.quest_desc: ["Find a Poison Spirit Bloom in Iceika loot chests. Save it for the Honeysuckle recipe with Venom-Charged Spirit Jade, Refined Glowstone and Holy Water."]
	quest.18142BABE42E9BFF.quest_desc: [
		"Build Fire, Ice and Lightning Dragon Forges from Ice and Fire. Each needs a living dragon of the matching element breathing into its input."
		""
		"Use the three elemental recipes in JEI with Draconic Evolution Dragon Hearts to produce Infernal, Glacial and Tempest Dragonheart Ingots. These bootstrap your later Regenerator routes."
	]
	quest.18142BABE42E9BFF.title: "Dragon-Furnace Triad"
	quest.1AF296DC8337C41F.quest_desc: [
		"The Ki Infuser makes Ki-infused metals. Add the recipe's item, connect a working Machine Ki supply, and check that its Ki bar and progress increase."
		""
		"This is the single-block Ki Infuser, not the Scarlet Meridian Forge multiblock."
	]
	quest.1AF5985A23D8FF52.quest_desc: ["Assemble the Divine Body Embryo in the Ultimate Crafting Table. Keep it for processing in the Immortal Body Crucible."]
	quest.1AF5985A23D8FF52.title: "Assemble the Divine Body Embryo"
	quest.1BE6329C7A9A0C27.title: "Primordial Regenerator"
	quest.1D4B22295D89CB3D.quest_desc: [
		"Defeat both Densos and Reyvor. Each has a separate kill task."
		""
		"Collect their drops for Mortum components and prepare for the realm's amplified damage before either fight."
	]
	quest.1D4B22295D89CB3D.title: "Break the Twin Sovereigns"
	quest.22D4A82A0BEED0DA.quest_desc: [
		"Carry a Data Model in a Deep Learner while killing its matching mob until the model is ready for simulation. Put it and Prediction Matrices in a powered Simulation Chamber."
		""
		"Check the model's FE/t requirement and leave space for both prediction outputs. Dimensional models can need much more power than Overworld ones. The Loot Fabricator comes after Eternal Embers."
	]
	quest.22D4A82A0BEED0DA.title: "Simulate Living Realms"
	quest.251C2CC2EA84E6B0.quest_desc: [
		"Make the Heaven-Earth Blood Core in the Blood Crucible with the listed components, including replicated Ancestral Genomes, and 32,000 mB Ancestral Dragon Blood."
		""
		"Reserve the core for the pill and refill your blood supply."
	]
	quest.251C2CC2EA84E6B0.title: "Condense the Heaven-Earth Blood Core"
	quest.256B36315567A568.quest_desc: ["Craft a Dormant Ember from Purple Blaze, Soulfire Stone and a Fire Charge. Awaken it in the Clibano with soul fire and the Artisan Relic."]
	quest.257AE7DE38CDCC5D.quest_desc: [
		"Build the Six Paths Samsara Wheel from its JEI preview. Its two fluid inputs and two energy inputs sit on the rear wall, with Meridian Glass between the fluid inputs. Fit at least one Divine Energy Input Hatch to supply recipes drawing up to 16,000,000 FE/t."
		""
		"Use two Vacuum fluid input hatches: Immortal Meridian Bones need 32,000 mB Liquid Ki and 16,000 mB Ancestral Dragon Blood in separate tanks. Causality Threads only use Liquid Ki."
	]
	quest.257AE7DE38CDCC5D.title: "Raise the Six Paths Samsara Wheel"
	quest.27008F05812BC629.quest_desc: [
		"Process Unrefined Spirit Prisms with the other listed inputs in the Fivefold Soul Refinery. Each batch gives two Purified Spirits, so four batches supply this quest's eight."
		""
		"Maintain the FE and fluid supply throughout the recipe and keep the output bus clear."
	]
	quest.27A0D0775AE22BA4.quest_desc: [
		"Build the Primordial Regenerator with one Multiversal Fluid Tank inside, as shown in JEI. The rear wall has one fluid input between two energy inputs. Use a Vacuum fluid input or larger for up to 32,000 mB Ancestral Dragon Blood, and at least one Divine Energy Input Hatch for recipes drawing up to 10,000,000 FE/t."
		""
		"Its recipes include dragonheart materials and Awakened Dragon Marrow. Test one recipe at a time before adding automation."
	]
	quest.27A0D0775AE22BA4.title: "Primordial Regenerator"
	quest.27A15CAEE748CFC5.quest_desc: [
		"Enter Mortum, the final DivineRPG realm in this progression. Gather fragments and gems, then prepare for Densos and Reyvor."
		""
		"Establish a safe return point before exploring and test your defenses against ordinary enemies before attempting either boss."
	]
	quest.27A15CAEE748CFC5.title: "Enter Mortum"
	quest.28588DAC5FB28ABA.quest_desc: [
		"Gather 118 Primordial Tribulation Casings for the Forge's structure. Use its layered JEI preview for placement."
		""
		"Make extra casings for the controller, later recipes and the Apotheosis Altar."
	]
	quest.28588DAC5FB28ABA.title: "Primordial Tribulation Casings"
	quest.2B74FE3CFCDEF7DD.quest_desc: [
		"Run twenty-four Immortal Meridian Bone batches in the Samsara Wheel. Each gives four bones and consumes its items, 16,000 mB Ancestral Dragon Blood and 32,000 mB Liquid Ki."
		""
		"Keep the two fluids separate and maintain a bulk supply."
	]
	quest.2B74FE3CFCDEF7DD.title: "Rebuild Immortal Meridian Bones"
	quest.2E9C5E1C7FE4DE20.quest_desc: [
		"Craft Meridian Binding Resin using the three realm predictions around a Honeycomb Block. Each craft gives three resin; three crafts supply this quest's nine."
		""
		"Keep the simulations running, since several machines and components use this binder."
	]
	quest.2EF46B7008DE02C3.quest_desc: ["Craft Steel Casings using the recipe shown in JEI. Several pack recipes share them, including the Atomic Reconstructor and AE2 machinery, so keep a small reserve."]
	quest.3014558A26F0EF42.quest_desc: [
		"An optional Chapter 4 batch-processing upgrade. First make Eternal Embers, Forgeheart Cores and a Scarlet Anvil Matrix through the Clibano, then craft the Fivefold Soul Casings and controller in the Elite Crafting Table."
		""
		"Use the Heaven-Earth Ki Condenser to supply Liquid Ki. Supply the selected recipe's ingredients and FE, and export its products. The forge cannot make its own first construction components."
		""
		"Build from the controller's JEI preview. Keep both energy inputs, its item input/output buses and the Liquid Ki input hatch accessible to automation."
	]
	quest.3014558A26F0EF42.title: "Scarlet Meridian Forge"
	quest.312FDA0EF5E13BDC.quest_desc: [
		"Collect the five Eternal Starlight weapons shown in the tasks. Check their recipe and loot pages to plan the required encounters."
		""
		"Shattered Sword: defeat Lonestar Skeletons carrying the sword in Eternal Starlight. Their equipment drop has a 20% base chance after a player kill; Looting adds 1 percentage point per level (23% with Looting III). The dropped sword can be damaged and has its blade restored. The Gatekeeper does not drop this sword. See its Entity Drops page in JEI."
		""
		"Let each task detect its weapon before using it in Starforged Boss Essence. Make spares of any you want to keep as equipment."
	]
	quest.3552EA4ED63547B1.quest_desc: [
		"Place Draconic Evolution's Fusion Crafting Core and enough Fusion Crafting Injectors of the recipe's required tier. Power the injectors."
		""
		"Put the catalyst in the core and the surrounding ingredients on injectors as shown in JEI. Extended Crafting's similarly named Crafting Core is a different system."
	]
	quest.3658EF26BF9270FE.quest_desc: [
		"Build the Age-er and make the Gray Aging Catalyst. Right-click to open it, add the herb and catalyst in their slots, and fill its tank with Liquid Ki. JEI shows each catalyst tier's cost and time."
		""
		"Time in a Bottle has a Wildwood-gated recipe in this pack. Check JEI for its components."
	]
	quest.3711E4AF05675221.quest_desc: [
		"Return to Apalachia and defeat the Eternal Archer for Immortal Flesh. Complete both the kill and item tasks."
		""
		"Keep extra flesh for reconstruction and Awakened Dragon Marrow."
	]
	quest.3711E4AF05675221.title: "Immortal Flesh"
	quest.372D343A29611C71.quest_desc: [
		"Craft Fivefold Soul Casings in the 7×7 Elite Crafting Table. Each batch gives 32; the quest asks for 98, with further casings needed for the controller."
		""
		"Use the Refinery's structure preview for the complete construction bill and keep the spare casings."
	]
	quest.3860D9A452D3B0CF.quest_desc: [
		"Gather Mortum Fragments and craft Mortum Gems for your resonance casings and evolved core."
		""
		"A trained Mortum Data Model offers renewable fragments: run simulations with power and matrices, then fabricate the desired drops from successful predictions."
	]
	quest.3860D9A452D3B0CF.title: "Matter of the Dead Realm"
	quest.38AC3D90523A8416.quest_desc: [
		"Use Wyvern-tier Fusion Crafting Injectors with Adamant Ki Alloy as the catalyst and the listed Twilight ingredients."
		""
		"One 24,000,000 FE operation makes four Twilight Spirit Ingots. These join the Astral Meridian branch in your larger components."
	]
	quest.38AC3D90523A8416.title: "Bind the Twilight Meridians"
	quest.39068ED81F53990B.quest_desc: [
		"Craft Farmer's Delight's Cooking Pot using a Skyroot Water Bucket from the Aether, then place it over heat."
		""
		"Its Spirit Ginseng Root recipe supplies your first breakthrough pill."
	]
	quest.3AC9B68E1E94AB01.quest_desc: [
		"Gather 86 Law-Woven Casings for the Nine Heavens Law Loom. Follow its JEI structure page for the glass, internal blocks and ports."
		""
		"Once all your law recipes are finished, you can reuse some casings in the final altar. Empty inventories and tanks before dismantling."
	]
	quest.3AC9B68E1E94AB01.title: "Law-Woven Casings"
	quest.3B7C2402B10582CA.quest_desc: [
		"Run models associated with the Overworld, Nether and End to collect their realm predictions. These are the base simulation outputs, separate from mob-specific successful predictions."
		""
		"Gather the requested quantities for Meridian Binding Resin; no Loot Fabricator is needed for these outputs."
	]
	quest.3D6E01753B5475A9.quest_desc: [
		"Run the Ancestral Reconstructor's Memory Imprint recipe. One batch gives four imprints and uses 8,000 mB Liquid Ki plus its item inputs."
		""
		"Keep this line available for blood refinement and later ancestral recipes."
	]
	quest.3D6E01753B5475A9.title: "Recover Four Ancestral Memory Imprints"
	quest.3E5F8835182EF490.quest_desc: [
		"Right-click this art in the Shattered Meridian to locate Dragon Veins within 50 blocks. Follow the End Rod particles and collect Dragon Vein Stone."
		""
		"This is a handheld locating item, not one of the combat formations deployed from the Techniques menu."
	]
	quest.3E5F8835182EF490.title: "Dragon Vein Formation Art"
	quest.3EC54D95AEECAAD1.quest_desc: [
		"Run the Primordial Dao Heart recipe in the Tribulation Forge with its completed components and 64,000 mB each of Liquid Ki and Ancestral Dragon Blood."
		""
		"Collect the heart and reserve it for the final altar."
	]
	quest.3EC54D95AEECAAD1.title: "Condense the Primordial Dao Heart"
	quest.3F95C77E8BC5F16A.quest_desc: [
		"Search the Shattered Meridian for Ancestral Remains Ore and Petrified Living Blood. JEI shows their ore heights."
		""
		"Collect 16 ore blocks with a diamond-tier or better Silk Touch pickaxe. Without Silk Touch, Ancestral Remains Ore drops remains instead of the block; Fortune increases the yield. The Ancestral Reconstructor can grow more remains from your first sample."
		""
		"Collect 8 Petrified Living Blood blocks with a diamond-tier or better pickaxe; Silk Touch is not required. Reserve replacement blocks for fluid extraction."
	]
	quest.3F95C77E8BC5F16A.title: "Ancestral Strata"
	quest.3FB38D36270EF8F3.quest_desc: [
		"Craft an Ultimate Crafting Table in the 7×7 Elite Table using Purified Spirit, a Celestial Ki Alloy Block and the other JEI ingredients."
		""
		"Its 9×9 grid is used for the Mechanized Dantian and later large components."
	]
	quest.41AEBA7EFCBB962C.quest_desc: [
		"In an AE2 Inscriber, place Unrefined Spirit Prism above a Shadow Bar and Charged End Steel below it. Collect thirteen Tempered Spirit Steel Plates for the larger crafting formation."
		""
		"Use the unrefined prism here, not Chapter 5's Purified Spirit."
	]
	quest.41B9CB84B0334C0B.quest_desc: [
		"Follow the Heaven-Earth Blood Crucible's JEI structure. Keep the Draconic Reactor Core inside and use two Multiversal Fluid Tanks. The rear wall has one energy input and one fluid input; the side ports handle items. The internal tanks are structural blocks, not recipe input hatches."
		""
		"Use a Divine Energy Input Hatch for up to 14,000,000 FE/t and a Celestial or Divine Fluid Input Hatch for up to 64,000 mB Ancestral Dragon Blood. The Reactor Core does not need fuel or activation for this machine."
	]
	quest.41B9CB84B0334C0B.title: "Raise the Heaven-Earth Blood Crucible"
	quest.450005CE3D4701F0.quest_desc: [
		"Use Malum Spirit Infusion: Refined Soulstone is the central item, with Soul-Tempering Salt, Meridian Binding Resin, Amethyst and the spirits listed in JEI."
		""
		"Your first prism must use this altar route. Chapter 5's Fivefold Soul Refinery offers batch production and Purified Spirit after you can build it."
	]
	quest.450005CE3D4701F0.title: "Bind an Unrefined Spirit Prism"
	quest.4889B1D8AE77F4FF.quest_desc: [
		"Craft the Dragon Vein Prism in the table shown in JEI, using refined ancestral and dragonheart materials."
		""
		"Keep extra prisms for Awakened Dragon Marrow production."
	]
	quest.4889B1D8AE77F4FF.title: "Focus the Dragon Vein Prism"
	quest.4889BE9807F3CCBF.quest_desc: [
		"Prepare a Frozen Clock at time 1400 in the Overworld. In Eden, throw an Eden Heart into Divine Flame, then use that clock on the transformed flame to open the Wildwood rift."
		""
		"Bring and activate a Waystone on arrival. A permanent portal uses at least ten Wildwood Blocks in a Nether-portal-shaped frame, activated at its base with the same clock."
		""
		"&cWildwood enemies have 5× health and damage.&r Prepare accordingly, then find a Termasect Nest and defeat its boss for a Wildwood Heart."
	]
	quest.4889BE9807F3CCBF.title: "Opening the Wildwood Rift"
	quest.4F830DDE828F3C68.title: "Heaven-Earth Meridian Seal"
	quest.50C3151F1E6326FC.quest_desc: [
		"Run the custom Primordial Godspark collision recipe in your Oritech accelerator and collect the output at the Particle Collector."
		""
		"Gather forty before dividing them between the law and body branches. If production stalls, check ring formation, motor power and collector space."
	]
	quest.50C3151F1E6326FC.title: "Collide Forty Godsparks"
	quest.52AA1773856D2195.quest_desc: [
		"Attach Crystal Interfaces to your generator, storage and consuming machines, then select the same channel on each. You must own the channel or have permission to use it, and the interfaces must be within their tier's range."
		""
		"Interfaces transfer Ki but store none. The generator supplies it and the Reservoir or Ki Vault buffers it. Any machine side can accept an interface."
	]
	quest.53ECB922C67FF771.quest_desc: [
		"Enter the Twilight Forest using the pack's portal route. Bring food, a map and a return method."
		""
		"Follow the dimension's advancements for boss progression. Protected areas and environmental penalties can mean an earlier boss still needs to be defeated."
	]
	quest.551AAE0CDCB2459F.quest_desc: [
		"Build the Tenfold Apotheosis Altar from its JEI structure page. The rear wall has two fluid inputs and one Divine Energy Input Hatch in the middle. The item input and output remain on the sides."
		"Feed 128,000 mB Liquid Ki into a Divine Fluid Input Hatch and 64,000 mB Ancestral Dragon Blood into a separate Celestial or Divine Fluid Input Hatch. Two Celestial inputs are not enough: the Liquid Ki needs its own 128-bucket tank."
		""
		"Connect your power supply to the rear Divine Energy Input Hatch. The final recipe draws 24,000,000 FE/t for 6,000 ticks; your generator or stored-energy supply and cables must sustain that rate."
	]
	quest.551AAE0CDCB2459F.title: "Raise the Tenfold Apotheosis Altar"
	quest.592F4E7835758D57.quest_desc: ["Craft the Twilight Sovereign Crest from the boss trophies and materials shown in JEI. Keep the finished crest for the meridian assembly."]
	quest.5975D8CF33CDEB58.quest_desc: [
		"Use the Ki Forge to combine Ki-infused metals into stronger alloys. Work through JEI's chain toward Celestial Ki Alloy, keeping lower-tier metals available."
		""
		"Supply Machine Ki through your interface network and leave the output clear. A connected channel needs a generator or charged storage behind it."
	]
	quest.5BACB8AE62822C1A.quest_desc: [
		"Keep a physical Spirit Gathering Mantra Manual for the Spirit Loom recipe. Learning the method does not supply the item needed for crafting."
		""
		"Obtain a second copy if you also want to learn it."
	]
	quest.5E9FBB02B697730E.quest_desc: ["Assemble the Sovereign Blood Sigil in the large table shown in JEI. Reserve it for the Blood Crucible progression."]
	quest.5E9FBB02B697730E.title: "Write the Sovereign Blood Sigil"
	quest.5EC0925000000101.quest_desc: [
		"Find Azure Cloud Academy for Orthodox or Crimson Eclipse Academy for Demonic in Lost Cities. Use an Explorer's Compass there and select the academy by name."
		""
		"Azure Cloud has pale stone, grey roofs and sakura gardens. Crimson Eclipse has dark roofs and crimson timber. Follow the main courtyard to the rear teaching hall for the altar and master."
		""
		"Choose your path at the altar and speak to your own sect master. Both paths offer the same guardian progression, beginning at Martial Supreme."
	]
	quest.5EC0925000000101.title: "Find Your Sect Academy"
	quest.5EC0925000000102.quest_desc: [
		"At Martial Supreme, speak to your own sect master and accept the Jadeflame hunt before fighting. This quest's checkmark is only a guide."
		""
		"Craft and use the Shattered Meridian Seal, then locate a Jadeflame Spring with an Explorer's Compass in that dimension. Approaching in survival awakens its Qilin; Peaceful prevents spawning."
		""
		"For hunt credit, contribute cultivation damage or allied formation support as described in the cooperative-hunt guide."
	]
	quest.5EC0925000000102.title: "Accept the Jadeflame Covenant"
	quest.5EC0925000000103.quest_desc: [
		"Defeat the Qilin guarding a Jadeflame Spring. Use cultivation techniques; ordinary attacks do not hurt it. Its ward prevents flight, riding and escape teleportation during the fight."
		""
		"A qualifying accepted hunter receives a personal Jadeflame Heart. Leave a free inventory slot; otherwise delivery waits. An ordinary summoned Qilin does not count for the master's hunt."
		""
		"The guardian's death also unseals 25 buckets of Primordial Jade Essence. Bring buckets or pumps to collect this finite pool."
	]
	quest.5EC0925000000103.title: "Slay the Guardian"
	quest.5EC0925000000104.quest_desc: [
		"Return a Jadeflame Heart to your own sect master after earning hunt credit. First completion awards four Celestial Beast Imprints and 500 XP. Make inventory space before submitting."
		""
		"This unlocks the Phoenix contract. Extra hearts can be exchanged for four replacement imprints each, without repeating the mission XP."
		""
		"Keep samples for the Cinder Heaven Seal and Four Guardians Seal. Copying an imprint does not complete a guardian contract."
		"{@pagebreak}"
		"&6Copying guardian imprints&r"
		""
		"Put one imprint in a powered Identification Chamber's sample slot and a Memory Chip in a chip slot. Wait for 100% scanning, then move the chip to Chip Storage and request copies from the Replication Terminal."
		""
		"Each Celestial Beast Imprint costs 4,096 Quantum, 8,192 Living and 4,096 Precious matter: 16,384 total. Later guardian imprints use the same scanning method with their own costs."
		""
		"Use a Memory Chip for scanning, not a blank Matter Blueprint. Keep the remaining original samples safe."
	]
	quest.5EC0925000000104.title: "Receive the Beast Imprints"
	quest.5EC0925000000105.quest_desc: [
		"After the Qilin guardian dies, its sealed basin becomes 25 source buckets of Primordial Jade Essence. Collect it with buckets or pumps; sealed jade cannot be extracted before the fight."
		""
		"The pool does not refill. Save a seed bucket for the optional Dissolution Chamber renewal recipe, then use your seal to return."
	]
	quest.5EC0925000000105.title: "Harvest the Jade Spring"
	quest.5EC0925000000106.quest_desc: [
		"Convert Primordial Jade Essence to vapor in a Rotary Condensentrator at 1:1. Feed 1,000 mB vapor and one solid Antimatter Pellet into the Antiprotonic Nucleosynthesizer to make 16 Primordial Matter Crystals."
		""
		"Disintegrate the crystals for Quantum, Precious, Living, Ender and Metallic matter. The optional Primordial Matter: Your Replication Farm quest explains the renewal loop, timing and storage requirements."
	]
	quest.5EC0925000000106.title: "Condense Primordial Matter"
	quest.5EC0926000000110.quest_desc: [
		"Finish the Qilin covenant and reach Martial Supreme. Open your sect master's Phoenix tab and press Accept hunt before fighting."
		""
		"Craft the Cinder Heaven Seal and locate a Cinderwing Aerie in Cinder Heaven. A survival player approaching awakens the guardian; Peaceful prevents spawning."
		""
		"Prepare usable cultivation attacks and Ki recovery. Marking this quest complete does not accept the master's contract."
	]
	quest.5EC0926000000110.title: "Accept the Cinderwing Phoenix Hunt"
	quest.5EC0926000000111.quest_desc: [
		"Sidestep the Phoenix's glowing dash lane and attack during its landing recovery. Avoid the flame fan and marked cinder circles."
		""
		"Below 45% health it can rebirth once, recovering 18% of maximum health. Retreat from the expanding ring."
		""
		"Defeat a real Aerie guardian with an accepted contract and qualifying participation to receive your personal Phoenix Heartfeather. If your inventory is full, delivery waits for space."
	]
	quest.5EC0926000000111.title: "Hunt: Cinderwing Phoenix"
	quest.5EC0926000000112.quest_desc: [
		"Return a Phoenix Heartfeather to your own sect master after earning hunt credit. First completion awards four Phoenix Dao Imprints and 650 XP, unlocking the Dragon contract at Martial Sovereign."
		""
		"Scan an imprint with a Memory Chip as described in Receive the Beast Imprints. Each copy needs 8,192 Quantum, Living and Precious matter: 24,576 total."
		""
		"Reserve an imprint for the Four Guardians Seal and one for the Azure Expanse Seal. Extra trophies trade for replacement imprints without repeating mission XP."
	]
	quest.5EC0926000000112.title: "Attune the Phoenix Dao Imprint"
	quest.5EC0926000000120.quest_desc: [
		"Submit the Phoenix covenant and reach Martial Sovereign. Open your sect master's Dragon tab and press Accept hunt."
		""
		"Craft the Azure Expanse Seal, enter its realm and locate a Tidal Dragon Court. Prepare ranged cultivation attacks and Ki recovery before approaching the guardian."
	]
	quest.5EC0926000000120.title: "Accept the Tidal Azure Dragon Hunt"
	quest.5EC0926000000121.quest_desc: [
		"The Dragon fights at range. Avoid its tidal roar and sidestep the marked lanes of its three water lances. Five geysers target fixed circles around your earlier position; leave them before they erupt."
		""
		"Solid cover blocks these spells. Use the dry arena floor to keep moving and cast between warnings."
		""
		"An accepted hunt and qualifying participation in a real Court guardian kill award your personal Tide Dragon Pearl."
	]
	quest.5EC0926000000121.title: "Hunt: Tidal Azure Dragon"
	quest.5EC0926000000122.quest_desc: [
		"Return a Tide Dragon Pearl to your own sect master after earning hunt credit. First completion awards four Tidal Dao Imprints and 800 XP, unlocking Xuanwu's contract."
		""
		"A scanned imprint costs 8,192 each of Quantum, Living, Precious and Ender matter to copy: 32,768 total."
		""
		"Keep imprints for the Blackstone Reaches Seal and Four Guardians Seal. Extra trophies provide replacement imprints without repeating mission XP."
	]
	quest.5EC0926000000122.title: "Attune the Tidal Dao Imprint"
	quest.5EC0926000000130.quest_desc: [
		"Submit the Dragon covenant at Martial Sovereign. Open your sect master's Xuanwu tab and press Accept hunt."
		""
		"Craft the Blackstone Reaches Seal and locate a Blackstone Sanctuary in its realm. Xuanwu guards the final aspect: stability. Prepare cultivation attacks and healing before approaching."
	]
	quest.5EC0926000000130.title: "Accept the Blackstone Xuanwu Hunt"
	quest.5EC0926000000131.quest_desc: [
		"Xuanwu's Devouring Vortex pulls from 18 blocks away. It releases you for one second before an 11-block blast: run beyond the glowing boundary or take solid cover. The blast does not destroy terrain."
		""
		"Jump low shockwaves, avoid its bite and sidestep shell rushes. Rush recovery gives a 30% damage opening before armour; its tucked shell guard instead reduces incoming damage to 25%."
		""
		"An accepted hunt and qualifying participation in a real Sanctuary guardian kill award your personal Xuanwu Shell Fragment."
	]
	quest.5EC0926000000131.title: "Hunt: Blackstone Xuanwu"
	quest.5EC0926000000132.quest_desc: [
		"Return a Xuanwu Shell Fragment to your own sect master after earning hunt credit. First completion awards four Xuanwu Dao Imprints and 950 XP, completing the four covenants."
		""
		"A scanned imprint costs 8,192 each of Quantum, Living, Precious, Ender and Metallic matter to copy: 40,960 total."
		""
		"Keep one for the Four Guardians Seal. Extra trophies provide replacement imprints without repeating mission XP."
	]
	quest.5EC0926000000132.title: "Attune the Xuanwu Dao Imprint"
	quest.5EC0926000000140.quest_desc: [
		"Combine one Celestial Beast, Phoenix, Tidal and Xuanwu imprint in any arrangement in a normal crafting grid. Together they form one Four Guardians Seal."
		""
		"Use the seal at the center of the Genesis Dao blueprint in the Ultimate 9×9 Table. The seal cannot be scanned; replicate its four component imprints instead."
	]
	quest.5EC0926000000140.title: "Unite the Four Guardians"
	quest.5EC0926000000150.quest_desc: [
		"The Shattering split the celestial meridian into four aspects: the Qilin's life, the Phoenix's renewal, the Dragon's flow and Xuanwu's stability. Restore them in that order through your own sect master."
		""
		"Accept a hunt, defeat its guardian, then submit the physical trophy to unlock the next contract. A quest checkmark or replicated imprint does not advance the master's mission."
		""
		"Qilin and Phoenix require Martial Supreme. Dragon and Xuanwu require Martial Sovereign. Their four imprints combine into the seal used by the Chapter 10 Genesis Dao blueprint."
		"{@pagebreak}"
		"&6Travel and hunt rules&r"
		""
		"Each guardian has its own realm and reusable entrance seal. Accept its contract before travelling. Keep your seals for the return journey; arrival is above ground, but travelling beyond the landing area can require blocks or a boat."
		""
		"Only cultivation attacks damage guardians. Their 28-block ward blocks flight, riding and escape teleportation until the guardian dies. Death or logout releases your personal lock. Read How Cooperative Guardian Hunts Work in the trials branch before fighting with friends."
		""
		"Completed sanctums do not respawn guardians. For extra trophies, find another unvisited sanctum. Trophies cannot be replicated or disintegrated. Use R on a trophy in JEI for its drop page, or U for the master's reward."
	]
	quest.5EC0926000000150.title: "The Shattered Meridian: Four Covenants"
	quest.5EC0926000000151.quest_desc: [
		"Use your Cinder Heaven Seal after accepting the Phoenix hunt. Ember skies cover basalt peaks and lava seas; watch your footing and keep the seal for your return."
		""
		"Use an Explorer's Compass inside this realm to find a Cinderwing Aerie. The Phoenix's flame restores renewal to the meridian."
	]
	quest.5EC0926000000151.title: "Enter Cinder Heaven"
	quest.5EC0926000000152.quest_desc: [
		"After submitting the Phoenix trophy and accepting the Dragon hunt, use your Azure Expanse Seal."
		""
		"Bring a boat and building blocks for the sea between islands. Locate a Tidal Dragon Court with an Explorer's Compass in this realm; its arena has a dry fighting floor. The Dragon restores the meridian's flow."
	]
	quest.5EC0926000000152.title: "Enter the Azure Expanse"
	quest.5EC0926000000153.quest_desc: [
		"Use your Blackstone Reaches Seal after accepting Xuanwu's hunt. Bring light for its dark water and mossy deepslate highlands."
		""
		"Locate a Blackstone Sanctuary with an Explorer's Compass in this realm. Xuanwu provides the stability needed to hold the other three aspects together."
	]
	quest.5EC0926000000153.title: "Enter the Blackstone Reaches"
	quest.5EC0926000000160.quest_desc: [
		"After the Qilin covenant, craft the Cinder Heaven Seal in the Elite 7×7 Table. It uses a Celestial Beast Imprint, Infernal Dragonheart Ingots, Flame Essence, Supreme Ki Crystals, Void Mandalas and Dragon Vein Prisms."
		""
		"Accept the Phoenix hunt before using the seal. It is reusable: use it to enter Cinder Heaven and again inside to return. JEI shows the complete recipe."
	]
	quest.5EC0926000000160.title: "Craft the Cinder Heaven Seal"
	quest.5EC0926000000161.quest_desc: [
		"Craft the Azure Expanse Seal in an Ultimate 9×9 Table during early Chapter 10. Its ingredients include a Phoenix Dao Imprint, Glacial Dragonheart Ingots, Frost Essence, Celestial Ki Alloy, Sovereign Mandates and Chaos Meridian Alloy."
		""
		"Complete the Phoenix covenant and accept the Dragon hunt at Martial Sovereign before travelling. The seal is reusable and does not consume your Cinder Heaven Seal."
	]
	quest.5EC0926000000161.title: "Craft the Azure Expanse Seal"
	quest.5EC0926000000162.quest_desc: [
		"Craft the Blackstone Reaches Seal in the Ultimate 9×9 Table after developing the Chapter 10 law and bone lines. It uses a Tidal Dao Imprint, Charred Meridian Stone, Heavenforged Law Alloy, Sovereign Mandates, Causality Thread and Immortal Meridian Bone."
		""
		"Submit the Dragon trophy and accept Xuanwu's hunt before travelling. The reusable seal needs no Xuanwu trophy or Genesis Dao."
	]
	quest.5EC0926000000162.title: "Craft the Blackstone Reaches Seal"
	quest.5EC0926A00000101.quest_desc: [
		"Keep a seed bucket from a defeated Qilin's spring. In the Industrial Foregoing Dissolution Chamber, combine 1,000 mB Primordial Jade Essence with one Yin-Yang Breakthrough Catalyst."
		""
		"After 600 ticks—30 seconds before upgrades—you receive 2,000 mB essence and an Amethyst Shard. The catalyst is consumed. Keep the item output clear."
		""
		"Return 1,000 mB from output to input and send the other 1,000 mB to storage. Use a buffer so the loop keeps its seed supply. Continue feeding catalysts and FE; this recipe cannot produce the first sample."
	]
	quest.5EC0926A00000101.title: "Renew the Primordial Spring"
	quest.5EC0926A00000102.quest_desc: [
		"An optional high-yield matter farm for Quantum, Precious, Living, Ender and Metallic. Keep other farms for matter types outside that list."
		""
		"Renew Jade Essence with the Dissolution Chamber loop. Run it through a Rotary Condensentrator in Decondensentrating mode to make Primordial Jade Vapor at 1:1."
		""
		"Feed 1,000 mB vapor and one solid Antimatter Pellet into an Antiprotonic Nucleosynthesizer. One batch takes 800 ticks—40 seconds before upgrades—and makes 16 Primordial Matter Crystals. The vapor amount is per batch, not per tick."
		"{@pagebreak}"
		"&6Turning crystals into matter&r"
		""
		"Disintegrate the crystals. Each gives 8,192 of all five listed types: 40,960 total per crystal or 655,360 per batch of sixteen. Connect and drain every output; a full tank can stop the machine."
		""
		"Keep supplying FE, catalysts and solid antimatter. The crystals cannot be scanned and replicated. Reversing the Rotary conversion returns the liquid at 1:1 without increasing it."
		""
		"This farm supports late Replication costs but is optional for the guardian story."
	]
	quest.5EC0926A00000102.title: "Primordial Matter: Your Replication Farm"
	quest.5EC0926A00000103.quest_desc: [
		"An optional way to transport a vanilla Ender Dragon. Craft the Dragon Capture Vessel in a 5×5 Advanced Crafting Table; JEI shows its Chapter 6 recipe."
		""
		"Right-click a living dragon's body, head, wing or tail within normal reach to capture it. A full vessel glints and keeps the dragon's health, name and saved attributes. It cannot capture dying dragons or dragons carrying passengers."
		""
		"&cReleased dragons remain hostile and can destroy terrain. Prepare an arena away from your base.&r"
		"{@pagebreak}"
		"&6Releasing and reusing the vessel&r"
		""
		"Sneak-right-click a block with a clear, dry, loaded space 19 blocks wide, 12 high and 19 deep above it. A blocked release keeps the dragon safely inside. The empty vessel is reusable."
		""
		"Capturing the active End dragon opens its exit portal without spawning a replacement. Capture gives no kill XP, drops or kill advancement."
		""
		"The vessel cannot be replicated and accepts only vanilla Ender Dragons, not the cultivation guardians."
	]
	quest.5EC0926A00000103.title: "Contain the Ender Dragon"
	quest.5EC0926B00000101.quest_desc: [
		"Type /cultivation_help for a short tutorial with your current key bindings. Open Cultivation, click Meditate and stand still somewhere safe. Click Stop when you are ready to move."
		""
		"Watch cultivation progress and Ki rise. Progress advances your stage; Ki powers abilities. A cushion helps later, but is not required to begin."
		""
		"Try meditating, then check this quest off. Chapter 1 leads to your first breakthrough pill."
	]
	quest.5EC0926B00000101.title: "First Steps: Your First Breath"
	quest.5EC0926B00000102.quest_desc: [
		"Craft a Target Dummy with one Hay Bale above one Armour Stand. The task detects it without consuming it."
		""
		"Place it on a broad, lit platform away from pets, bees and other players. Test equipment here, then return with your first usable cultivation art."
	]
	quest.5EC0926B00000102.title: "First Steps: A Safe Practice Target"
	quest.5EC0926B00000103.quest_desc: [
		"Chapter 3 introduces the sect halls and academies in Lost Cities. Choose your path, obtain a suitable manual and right-click it once you meet its requirements."
		""
		"Open F8 > Techniques, equip an active art and stop meditating. Aim at your dummy and cast using the key shown in /cultivation_help. Weapon arts need a matching weapon in your main hand."
		""
		"Watch the Ki cost and cooldown, then meditate to recover. Check this off after a successful cast."
	]
	quest.5EC0926B00000103.title: "First Steps: Equip and Cast"
	quest.5EC0926B00000104.quest_desc: [
		"Reach Stage 9 and fill its cultivation bar, then use the pill for the next realm. Each numbered chapter provides a route to that pill."
		""
		"Confirm your realm in Cultivation, then revisit Techniques and your sect for eligible arts. Check this off after your first breakthrough; the checkmark itself grants nothing."
	]
	quest.5EC0926B00000104.title: "First Steps: Your Next Breakthrough"
	quest.5EC0927A00000101.quest_desc: [
		"This branch covers three activities: pill trials that unlock certain realms, optional Memory Courts that teach a lost art, and an optional Ascension battle after Martial God."
		""
		"Memory Courts are training courtyards in the four guardian dimensions. Each has a central floor block called a stele. Clear all four different exercises yourself to learn Fourfold Inedia Scripture, a permanent passive that keeps hunger and saturation full."
		""
		"You can finish the ten chapters, guardian contracts and Ascension without visiting a Memory Court. The court quests explain each exercise; the inheritance quest explains their shared reward."
		"{@pagebreak}"
		"&6Starting a pill trial&r"
		""
		"Reach Stage 9 with full cultivation and use the next realm's pill. Martial Lord, Martial Emperor and Martial God start trials; the other realm pills advance you directly."
		""
		"Prepare a flat, dry floor 25 blocks wide with three clear blocks above. Begin near the center, with healing and any required combat arts ready. Leave 50 blocks between simultaneous personal trials."
		""
		"&cOne pill is consumed when the trial starts. Failure, death, cancellation and logout do not refund it. Your realm and cultivation are preserved.&r Invalid ground or unmet requirements prevent entry without spending the pill."
		""
		"The teal ward blocks flight and escape; trying either does not fail you. Use /cultivation_trial cancel to concede. Wait 20 seconds after failure or cancellation before retrying."
	]
	quest.5EC0927A00000101.title: "Start Here: What Are These Trials?"
	quest.5EC0927A00000102.quest_desc: [
		"&6Orthodox&r attacks cost 15% less Ki. When an automatic shield triggers, cultivation attacks gain 20% damage for three seconds. Protective formations gain five percentage points of damage reduction. Counterattack after a block."
		""
		"&4Demonic&r cultivators build Fervor by alternating attack categories within six seconds. Each stack adds 6% cultivation damage and 5% damage taken, up to three stacks. Repeating a category restarts at one."
		""
		"While Fervor is active, direct cultivation hits on hostile enemies heal 5% of damage dealt, capped at 1% of maximum health per second. Reflections, allies and inner demons give no healing."
		""
		"Your chosen sect determines the bonus. Creative access to both paths does not combine them."
	]
	quest.5EC0927A00000102.title: "Your Sect's Combat Bonuses"
	quest.5EC0927A00000103.quest_desc: [
		"&6Martial Lord: Heavenly Lightning&r"
		""
		"&cA trial consumes its pill at the start, even if you fail. Prepare before using it.&r"
		""
		"At Great Martial Master Stage 9 with full cultivation, use the Lord pill. Survive six lightning strikes. Each orange circle marks your position about two seconds before the bolt lands. Move completely outside it, then prepare for the next mark."
		""
		"The lightning deals heavy damage. Bring healing and keep moving; no attack technique or formation is required."
		"{@pagebreak}"
		"&6Martial Emperor: Meridian Tempering&r"
		""
		"At Martial Grandmaster Stage 9 with full cultivation, use the Emperor pill. Survive 30 seconds of internal Qi damage, with one pulse each second, including the last."
		""
		"Start at full health with golden apples, regeneration potions and healing in your hotbar. Eat and heal early. Absorption, resistance and learned defenses can help."
		""
		"Movement does not avoid the damage. Watch the countdown and survive the final pulse. No attack, formation or Ki payment is required."
		"{@pagebreak}"
		"&6Martial God: Heaven and Earth Tribulation&r"
		""
		"At Martial Sovereign Stage 9 with full cultivation, use the God pill. Defeat three inner demons, with two minutes per round. Round 1 adds lightning, round 2 adds jumpable gold ground-waves, and round 3 combines both."
		""
		"Only cultivation attacks hurt them. Equip several usable arts and carry matching weapons so you can rotate attacks during cooldowns. No formation is required."
		""
		"Demons can copy your learned passive guards. A copied shield reduces one hit by 25%, then all copied shields share a 10-second recovery. The shield effect does not mean your attack was completely blocked."
	]
	quest.5EC0927A00000103.title: "How to Win Each Breakthrough"
	quest.5EC0927A00000104.quest_desc: [
		"Each hunter must accept the contract from their own sect master before the fight. Guardian hunts can be shared; pill trials are personal."
		""
		"To earn a trophy, deal at least 1% of the guardian's solo maximum health with cultivation attacks, or provide ten seconds of allied formation support. You must be alive, within 64 blocks and have contributed in the final 30 seconds."
		""
		"Qualifying hunters receive personal trophies. If an inventory is full, delivery waits for a free slot. Return the trophy to your master for the contract reward."
		"{@pagebreak}"
		"&6Fighting together and recovering a grave&r"
		""
		"Each extra contributing fighter adds 45% maximum health, up to six fighters. Avoid orange attack warnings and listen for the recovery chime: it signals a 30% damage opening."
		""
		"After death, you have 90 seconds to retrieve your grave without that guardian attacking or trapping you. Using a cultivation attack against it ends this grace. Other enemies and environmental hazards can still hurt you."
	]
	quest.5EC0927A00000104.title: "How Cooperative Guardian Hunts Work"
	quest.5EC0927A00000105.quest_desc: [
		"The Last Pilgrim gives away his final ration and sees the Qilin drawing life from bare earth. Recover this memory by practising lightning dodges."
		""
		"In Shattered Meridian, use an Explorer's Compass to find Jade Memory Court. With empty hands, right-click its central floor stele for instructions or sneak-right-click to begin. No pill, art or Ki is needed."
		""
		"Move outside each orange circle before lightning arrives about two seconds later. Survive all six marks within two minutes. Three practice hits end the attempt without damaging your health."
		""
		"Your first clear restores The Last Ration and gives four Jade Memory Lanterns. Use /cultivation_memory to track your four personal memories."
	]
	quest.5EC0927A00000105.title: "Memory I: The Last Ration"
	quest.5EC0927A00000106.quest_desc: [
		"The pilgrim learns to tend his inner ember without consuming the world around him. Recover this memory in a practice fight against your double."
		""
		"Locate Cinder Memory Court in Cinder Heaven. Equip usable combat arts in F8 > Techniques, refill Ki and bring matching weapons. Sneak-right-click the central stele with empty hands to start."
		""
		"Defeat the double within two minutes using cultivation attacks. It copies all your usable learned combat arts, including unequipped ones, and may copy passive guards. Dodge orange warnings and rotate your attacks."
		"{@pagebreak}"
		"&6Practice rules and reward&r"
		""
		"Three marked hits end the exercise instead of damaging your health. Your own attacks still spend their normal Ki and cooldowns. The ward blocks flight and escape; outside mobs and environmental hazards remain dangerous."
		""
		"Your first clear restores The Ember Within and gives four Cinder Memory Lanterns. This is a Memory Court exercise; the Martial Emperor pill uses the separate 30-second survival trial."
	]
	quest.5EC0927A00000106.title: "Memory II: The Ember Within"
	quest.5EC0927A00000107.quest_desc: [
		"On a shore between worlds, the pilgrim learns to return spent Qi through a closed circulation. Recover this memory by charging four stations."
		""
		"Locate Tidal Memory Court in the Azure Expanse. Equip a usable active art and bring Ki for at least four casts, plus a matching weapon if needed. Sneak-right-click the central stele with empty hands to start."
		""
		"Walk inside the gold circle and cast your equipped art. Defaults: Z for fist, X for palm, C for weapon. A successful cast lights the next station; charge all four within two minutes. No target needs to be hit."
		""
		"Cooldowns and Ki costs still apply. If a station does not charge, check your position, equipped art, Ki, cooldown and held weapon. Your first clear restores The Returning Tide and gives four Tidal Memory Lanterns."
	]
	quest.5EC0927A00000107.title: "Memory III: The Returning Tide"
	quest.5EC0927A00000108.quest_desc: [
		"At Xuanwu's feet, the pilgrim learns to hold the other lessons together. This exercise combines an active formation, four casts and lightning dodges."
		""
		"Locate Blackstone Memory Court in the Blackstone Reaches. Learn an eligible attack and a deployable formation: Three-Talisman Gathering Array or Eight Trigrams Spirit Formation for Orthodox, or Prismatic Reversal Ward for Demonic."
		""
		"Equip the attack and refill Ki for it and the formation. Sneak-right-click the central floor stele with empty hands to begin. No pill is spent."
		"{@pagebreak}"
		"&6Holding the vessel together&r"
		""
		"Equip a learned field in F8 > Techniques > Formation. Close the menu, stand on the central stele and press V to cast it. Keep it anchored at the court's center. Automatic shields such as Hexagonal Qi Bulwark do not count."
		""
		"With the field active, walk inside each gold circle and cast your equipped attack. Charge all four within two minutes. If the field expires, return to the center and redeploy when its cooldown allows."
		""
		"Leave orange lightning circles before they strike. Three practice hits end the exercise without health damage. Your first clear restores The Unbroken Vessel and gives four Blackstone Memory Lanterns."
	]
	quest.5EC0927A00000108.title: "Memory IV: The Unbroken Vessel"
	quest.5EC0927A00000109.quest_desc: [
		"Reach Martial God and finish all four guardian contracts by returning their trophies and claiming the master's rewards."
		""
		"Craft an Ascension Dais with one Genesis Dao, one Four Guardians Seal, four Primordial Matter Crystals and three Quartz Blocks. JEI shows the pattern."
		""
		"Place it flush with a flat, dry, 25-block-wide floor with three clear blocks above. Prepare health, Ki and combat arts, then sneak-right-click to start. The dais is reusable; no pill, formation or Memory Court completion is required."
	]
	quest.5EC0927A00000109.title: "Prepare the Optional Ascension Battle"
	quest.5EC0927A0000010A.quest_desc: [
		"The Ascension Dais challenges you to hold the guardians' four aspects together against your inner demons. Win three rounds, each with a two-minute limit."
		""
		"Round 1 adds orange lightning marks. Round 2 adds expanding gold ground-waves to jump over. Round 3 combines both. Defeat each demon with cultivation attacks to advance."
		""
		"&cThis fight deals real damage and can kill you. The ward blocks flight and escape. /cultivation_trial cancel concedes; no pill or ingredients are spent to enter.&r"
		"{@pagebreak}"
		"&6Combat and rewards&r"
		""
		"The demons copy your usable learned combat arts, including unequipped ones. Copied guards reduce one hit by 25% and then share a 10-second recovery. Bring multiple equipped attacks, matching weapons and enough Ki to rotate through cooldowns."
		""
		"Your first victory grants an Ascendant Insignia, Four Covenants Monument, cosmetic title and golden aura. Use the insignia to toggle the aura; sneak-use toggles the title. These rewards give no combat stats."
	]
	quest.5EC0927A0000010A.title: "Optional: Win the Ascension Battle"
	quest.5EC0927A0000010B.quest_desc: [
		"After earning Ascendant status, sneak-right-click the dais again for a rematch with tougher demons and faster lightning warnings."
		""
		"Defeat all three rounds within their timers. Cancelling or failing does not remove Ascendant status. Repeat victories award no additional items, XP or combat power."
	]
	quest.5EC0927A0000010B.title: "Optional: A Harder Rematch"
	quest.5EC0927A0000010C.quest_desc: [
		"Four memories reveal the Last Pilgrim's forgotten art: draw life from the world, renew its warmth, circulate without waste, and seal the vessel that holds it."
		""
		"Complete each of the four different Memory Courts yourself, in any order. The fourth memory automatically teaches Fourfold Inedia Scripture. Find it under F8 > Techniques > Body; it needs no manual or equipped slot."
		""
		"It keeps hunger and saturation full permanently, with no food or Ki upkeep. Both sects and unpledged cultivators can learn it."
		"{@pagebreak}"
		"&6What the inheritance does—and does not do&r"
		""
		"Normal food-based regeneration still applies when enabled, and golden apples remain edible for their effects. The art does not make you invulnerable or replace separate resources such as vampire blood."
		""
		"Memories and the art survive death, relogging and dimension travel. View your discoveries with /cultivation_memory. Repeating a court, receiving lanterns or sharing a team's quest completion cannot replace your own four clears."
		""
		"Lanterns are decorative first-clear rewards. The courts use no breakthrough pills; their ward prevents flight and escape. Outside hazards still hurt you. Use /cultivation_trial cancel to concede and wait 20 seconds after failure or cancellation before retrying."
	]
	quest.5EC0927A0000010C.title: "The Empty Bowl, the Boundless Breath"
	quest.5EC1013000000101.quest_desc: [
		"Craft the Market from Farming for Blockheads for a convenient source of seeds, saplings and other farming supplies."
		"Place it with room for its trader. Open it to browse the offers and bring the requested payment. JEI shows the Market recipe and available trades."
	]
	quest.5EC1013000000101.title: "The Farming Market"
	quest.5EC1013000000102.quest_desc: [
		"Press E to open your inventory, then click the shop button at the top left."
		"Spend the coins earned from quests here. Hover over an offer to check its price before buying. The shop is separate from the Farming for Blockheads Market."
	]
	quest.5EC1013000000102.title: "Where Is the Shop?"
	quest.5EC1013000000103.quest_desc: [
		"Gate Pearls from Gateways to Eternity can summon waves of mobs before you have a permanent mob farm. Search Gate Pearl in JEI and inspect the individual gateway and its recipe."
		"Use a pearl on a block in a large, clear, enclosed arena away from your base. Prepare equipment and space before opening a hostile gateway; waves have time limits and can fail if mobs escape or cannot spawn."
		"Start with a gateway whose ingredients and enemies suit your current progression. Endless gateways are not beginner encounters. Each pearl chooses a specific gateway; pearls are not interchangeable."
	]
	quest.5EC1013000000103.title: "Early Mobs with Gate Pearls"
	quest.5EC1013000000104.quest_desc: [
		"Craft the Sleep Charm from Dark Utilities and keep it in your normal player inventory to ward off insomnia and its phantom spawns."
		"A charm left in storage does not protect you. Existing phantoms and phantoms targeting other players do not instantly disappear; each player should carry their own charm."
	]
	quest.5EC1013000000104.title: "Sleep Charm: No More Insomnia"
	quest.5EC1013000000105.quest_desc: [
		"Craft the Cultivation Library to archive spare technique manuals. Learning a manual is permanent; storing a duplicate does not grant another copy of its effects."
		"Right-click with a manual to deposit it, or open the library with an empty hand. Search by name or item ID. Click a book to withdraw one, and shift-click books between the library and your inventory."
		"All six faces support item insertion and extraction. Hoppers and item pipes can transfer manuals; attach an AE2 Storage Bus to expose them to your ME network. Import/Export Buses also work through normal item transfer. Use filters to avoid moving books you want to keep."
		"There are 512 storage slots holding up to 4,096 identical copies each. Item data is kept separate; excess items are refused, never voided. Break and move the library to keep its archived books inside the block."
	]
	quest.5EC1013000000105.title: "Your Cultivation Library"
	quest.5EC1013000000106.quest_desc: [
		"Meditating gently grows a 5 by 5 garden centered on you."
		"Plain dirt beside grass can turn into grass blocks; grass can grow short grass and flowers where the block above is empty and sufficiently bright. The effect also works while meditating on a cushion."
		"It does not replace crops, farmland, machines or other occupied blocks, does not load nearby chunks, and respects player placement protection. This effect is separate from crouch-to-grow crops."
	]
	quest.5EC1013000000106.title: "Meditation Garden"
	quest.5EC1013000000110.quest_desc: [
		"Visit the End during Chapter 2, before making the Tyrian Steel needed for the Ki Crystal Cultivator. Follow JEI's Tyrian Steel ingredient chain; you do not need to wait for a later chapter to travel."
		"Craft the End Cake from TelePastries using the recipe in JEI, place it safely, then use it with an empty hand to travel. Dimension cakes are an alternative to building a portal; choose the TelePastries cake, not the disabled Ex Deorum version."
		"Prepare armor, blocks and a reliable return method before entering. An ordinary End portal also works where one is available. The dragon's exit portal is not active until the dragon is defeated."
		"Mark this guide complete when you are ready, then return to the Honeysuckle and Ki Crystal Cultivator branch."
	]
	quest.5EC1013000000110.title: "The End Before Ki Crystals"
	quest.5EC1A70000001101.quest_desc: [
		"Make the Martial Warrior pill in the Eidolon Worktable, filling its main grid and all four reagent slots. The Niotic Crystals come from Powah energizing and the Spirit Ginseng Root from the Cooking Pot."
		""
		"At Mortal Stage 9, fill the final cultivation bar and consume the pill to become a Martial Warrior. Detecting the item for the quest does not perform the breakthrough."
	]
	quest.5EC1A70000001101.title: "First Worktable Breakthrough"
	quest.5EC1A70000001102.quest_desc: [
		"Make the Martial Master pill in the completed Eden Source Altar with its item ingredients and Source supply."
		""
		"Reach Martial Warrior Stage 9, fill the final cultivation bar, then consume the pill. Keep the altar and Source farm for later recipes."
	]
	quest.5EC1A70000001102.title: "Break Through the Eden Meridian"
	quest.5EC1A70000001103.quest_desc: [
		"Use the Inscriber with Snow Lotus on top, Spatial Dantian Core in the middle, and a 1k ME Source Storage Cell containing 100,000 Source below."
		""
		"Reach Martial Master Stage 9, fill the final cultivation bar, then consume the Great Martial Master pill. Revisit your sect afterwards for eligible manuals."
	]
	quest.5EC1A70000001103.title: "Awaken the Spatial Dantian"
	quest.5EC1A70000001104.quest_desc: [
		"&c&lWARNING: this pill starts the Heavenly Lightning trial. One pill is spent at the start and is lost if you fail, die, cancel or log out.&r"
		""
		"Make the Martial Lord pill in a 7×7 Elite Crafting Table using the Scarlet Anvil recipe. Use Unrefined Spirit Prism, not Purified Spirit."
		""
		"At Great Martial Master Stage 9 with full cultivation, use the pill on a flat, dry floor at least 25 blocks wide with three clear blocks overhead."
		"{@pagebreak}"
		"&6Heavenly Lightning&r"
		""
		"Survive six lightning strikes. Each orange circle marks a strike about two seconds before it lands; move fully outside it and keep healing ready."
		""
		"The teal ward prevents flight and keeps you inside. Trying to fly or cross it does not itself fail the trial. Failure leaves your realm and cultivation intact, but does not return the pill."
	]
	quest.5EC1A70000001104.title: "Forge the Scarlet Anvil Pill"
	quest.5EC1A70000001105.quest_desc: [
		"Use Draconic-tier Fusion Crafting with the Heaven-Earth Meridian Seal as catalyst and all twelve injector ingredients shown in JEI. These include the Twin-Realm Meridian Core, Mechanized Dantian and four Tribulation Dragonheart Cores. Supply 96,000,000 FE."
		""
		"At Martial Lord Stage 9 with full cultivation, consume the finished Martial King pill."
	]
	quest.5EC1A70000001105.title: "Break Through: Martial King"
	quest.5EC1A70000001106.quest_desc: [
		"Supply the IFEU Infuser with two Yin-Yang Breakthrough Catalysts and 4,000 mB Liquid Dragon Breath, plus power."
		""
		"At Martial King Stage 9 with full cultivation, consume the Martial Grandmaster pill. Keep the comb, fluid and infusion lines running for later recipes."
	]
	quest.5EC1A70000001106.title: "Martial Grandmaster Breakthrough"
	quest.5EC1A70000001107.quest_desc: [
		"&c&lWARNING: this pill starts a challenge. One pill is consumed at the start and is lost if you fail, die, cancel or log out.&r"
		""
		"Process the Skythern Ascension Core with Antimatter in the Antiprotonic Nucleosynthesizer. Collect the pill, then reach Martial Grandmaster Stage 9 with full cultivation."
		""
		"Prepare a flat, dry floor at least 25 blocks wide with three clear blocks above. Use the pill near the center at full health to begin Meridian Tempering: survive 30 seconds of internal Qi damage."
		"{@pagebreak}"
		"&6Surviving Meridian Tempering&r"
		""
		"Put golden apples, regeneration potions and other healing supplies in your hotbar. Damage pulses once each second; eat and heal early. Absorption, resistance and learned defenses can help. No attack technique, formation or Ki payment is required."
		""
		"The damage follows you. Moving, jumping or crouching will not avoid it, and the red-gold pulses are not safe-zone markers. The teal ward prevents flight and escape."
		""
		"Survive the final pulse to become Martial Emperor. Failure keeps your realm and cultivation but loses the pill. If the floor or breakthrough requirements are invalid, the trial does not start and nothing is consumed."
	]
	quest.5EC1A70000001107.title: "Martial Emperor Breakthrough"
	quest.5EC1A70000001108.quest_desc: [
		"Make the Martial Supreme pill in the Evolved Mekanism Alloyer using the replicated Void Mandala and other listed ingredients."
		""
		"Consume it at Martial Emperor Stage 9 with full cultivation. Keep the spare Evolved Meridian Lattice and your Mortum production line for Chapter 9."
	]
	quest.5EC1A70000001108.title: "Martial Supreme Breakthrough"
	quest.5EC1A70000001109.quest_desc: [
		"Finish the Martial Sovereign pill in the Heaven-Earth Blood Crucible. Supply the Replicated Sovereign Mandate, both Awakened Dragon Marrows and the remaining JEI ingredients, fluid and FE."
		""
		"Consume the pill at Martial Supreme Stage 9 with full cultivation."
	]
	quest.5EC1A70000001109.title: "Martial Sovereign Breakthrough"
	quest.5EC1A7000000110A.quest_desc: [
		"&c&lWARNING: this pill starts a challenge. One pill is consumed at the start and is lost if you fail, die, cancel or log out.&r"
		""
		"Make the Martial God pill in the Tenfold Apotheosis Altar using the Keystone, Dao Heart, four Genesis Dao and the remaining recipe inputs."
		""
		"Reach Martial Sovereign Stage 9 with full cultivation. On a flat, dry, 25-block-wide floor with three clear blocks above, use the pill to begin the Heaven and Earth Tribulation. Defeat three inner demons, with two minutes for each round."
		"{@pagebreak}"
		"&6Preparing for the final fight&r"
		""
		"Use cultivation attacks; ordinary swings cannot hurt the demons. Equip several usable arts through F8 > Techniques and carry suitable weapons for your sword, saber and spear arts. No formation is required."
		""
		"A demon can copy your learned passive guards. A copied shield reduces one hit by 25%; all copied shields then share a 10-second recovery. Rotate attacks while your longer cooldowns recover."
		""
		"Round 1 adds lightning, round 2 adds jumpable gold ground-waves, and round 3 combines both. The ward prevents flight and escape. Winning grants Martial God; failure keeps your realm and cultivation but loses the pill."
	]
	quest.5EC1A7000000110A.title: "Martial God Breakthrough"
	quest.5EC1A70000001201.quest_desc: ["Crouch and hold right-click on dirt-like ground with an empty main hand to gather pebbles. Collect Stone Pebbles for Cobblestone; you do not need to mine away your island."]
	quest.5EC1A70000001201.title: "Search the Ground"
	quest.5EC1A70000001202.quest_desc: [
		"Your next breakthrough is Martial Master. Explore Eden, then Iceika, and use their materials in the Source-powered Eden Source Altar."
		""
		"Begin with DivineRPG's Overworld metals and the Ancient Entity. Keep your Imbuement Chamber, pedestals, Source Jars and crop farm working; they supply both the refined metals and the altar."
		""
		"The Divine Almanac is available from the Farming for Blockheads Market for one Emerald. Bring a Waystone when opening a temporary rift, or prepare the realm's permanent return portal before exploring."
	]
	quest.5EC1A70000001202.title: "The First Divine Realm"
	quest.5EC1A70000001203.quest_desc: [
		"This chapter combines AE2 and Mekanism automation with exploration in Lost Cities and the Otherside. Both branches feed the Spatial Dantian Core and your Great Martial Master pill."
		""
		"Start with a working ME storage network, then add autocrafting. In Lost Cities, you can also visit the sects and choose a combat path."
	]
	quest.5EC1A70000001203.title: "A Dantian Beyond Matter"
	quest.5EC1A70000001204.quest_desc: [
		"Travel from Eden to Wildwood for the next realm materials. Back home, use Malum spirits, Hostile Neural Networks predictions, the Clibano and Spirit Loom to prepare the Martial Lord pill."
		""
		"The final Scarlet Anvil recipe uses a 7×7 Elite Crafting Table. The Scarlet Meridian Forge and Heaven-Earth Ki Condenser can now automate repeat batches in this chapter; make the first components by hand."
	]
	quest.5EC1A70000001204.title: "The Scarlet Anvil Path"
	quest.5EC1A70000001205.quest_desc: [
		"Explore Eternal Starlight and the Twilight Forest while building a Machine Ki network and Fivefold Soul Refinery at home. Their boss materials, alloys and Purified Spirit come together in the Martial King pill."
		""
		"&cEnemies in both dimensions have 3× health and damage.&r Check your equipment and learned defenses before leaving."
	]
	quest.5EC1A70000001205.title: "The Twin-Realm Tribulation"
	quest.5EC1A70000001206.quest_desc: [
		"Build two matching production lines: Yin and Yang Bees make combs, Quantum Compressors turn the combs into singularities, and Fluid Extractors draw essence from singularity blocks. Solidify both fluids and combine them with the Apalachian Duality Elixir for the Martial Grandmaster pill."
		""
		"&cApalachia enemies have 10× health and damage.&r Prepare before challenging the Eternal Archer."
		""
		"Replication supplies Meridian Seeds for vessels and shells. Your Ki Liquefier provides the first Liquid Ki; the Heaven-Earth Ki Condenser is an optional bulk upgrade."
	]
	quest.5EC1A70000001206.title: "The Sixth Path: Perfect Duality"
	quest.5EC1A70000001207.quest_desc: [
		"Skythern exploration, chemical processing, Data Flow and Replication meet at the Celestial Meridian Weaver. Set up renewable Echo Shards, chemicals and enough power for its custom energy hatches."
		""
		"Build two Dormant Synthetic Dantian Cores: one for this chapter and one for Chapter 8."
		""
		"&cSkythern enemies have 15× health and damage. The Martial Emperor pill starts a survival trial; read its quest before using it.&r"
	]
	quest.5EC1A70000001207.title: "The Sky Above Heaven"
	quest.5EC1A70000001208.quest_desc: [
		"Bring the spare Dormant Synthetic Dantian Core from Chapter 7. Mortum materials, Evolved Mekanism alloys and the Heavenly Tribulation Crucible will awaken it for the Martial Supreme breakthrough."
		""
		"Develop the alloy and Soul Filament lines alongside exploration, then produce a Void Mandala and Void-Tempered Dantian."
		""
		"&cMortum enemies have 25× health and damage. Prepare your defenses and a reliable return route.&r"
	]
	quest.5EC1A70000001208.title: "The Realm of Mortum"
	quest.5EC1A70000001209.quest_desc: [
		"Right-click the Shattered Meridian Seal to enter its realm; use it inside to return. Keep the seal with you and establish a Waystone before exploring."
		""
		"Mine ancestral materials, extract Living Blood and Dragon Vein Essence, then build the reconstruction and blood-refining lines for your Sovereign pill. Complete the Qilin and Phoenix covenants in Sects and the Four Guardians alongside this chapter."
		""
		"&cThe realm has dangerous enemies, including amplified dragons. Prepare before travelling; the custom guardians require cultivation attacks.&r"
	]
	quest.5EC1A70000001209.title: "Enter the Shattered Meridian"
	quest.5EC1A7000000120A.quest_desc: [
		"Complete the Dragon and Xuanwu covenants after Qilin and Phoenix. Their combined imprints unlock the Genesis Dao blueprint."
		""
		"At home, build two branches: the Law Loom leads to the Heavenly Mandate, while the Body Crucible makes the Primordial Godbody. The Samsara Wheel supplies both."
		""
		"Combine their materials in the Tribulation Forge, then finish the pill in the Tenfold Apotheosis Altar. Keep the earlier fluid and power lines running. &cThe final breakthrough is a three-round combat trial.&r"
	]
	quest.5EC1A7000000120A.title: "The Last Mortal Step"
	quest.5EC1A70000001301.quest_desc: [
		"Craft four Stone Pebbles into Cobblestone. Save some for tools and a furnace."
		""
		"An Ex Deorum hammer breaks Cobblestone into Gravel, then Sand, then Dust. Each material has different Sieve drops, so check the resource you need in JEI before crushing the whole batch."
		""
		"Hammers and compressed hammers stop working at 1 durability instead of breaking. Repair them in a crafting grid or anvil with their own material: Planks, Cobblestone, Iron, Gold, Diamond or Netherite. Each material restores 25% durability."
	]
	quest.5EC1A70000001301.title: "Your First Cobblestone"
	quest.5EC1A70000001401.quest_desc: [
		"Put leaves or other compostable plants into an Ex Deorum Barrel to make Dirt. The wooden Crucible turns leaves into Water."
		""
		"These are processing blocks, not vanilla storage barrels. Use JEI to check accepted inputs. Lava needs the Porcelain Crucible from the later quest."
	]
	quest.5EC1A70000001401.title: "Barrel and Crucible"
	quest.5EC1A70000001501.quest_desc: [
		"Install a String Mesh by right-clicking the Sieve with it. Add a valid block, then keep right-clicking until sieving finishes."
		""
		"Check the Sieving tab in JEI for both the input block and required mesh. Gravel, Sand, Dust and Dirt have different drops, and some drops take several attempts."
	]
	quest.5EC1A70000001501.title: "Sieve and Basic Mesh"
	quest.5EC1A70000001601.quest_desc: [
		"Upgrade through the requested meshes, taking each into your inventory before using it in the next craft."
		""
		"Keep the older meshes until you have checked their drops: higher tiers do not necessarily include every lower-tier recipe. For a Compressed Sieve, use the compressed input and mesh shown in its JEI recipe."
	]
	quest.5EC1A70000001601.title: "Master Every Mesh"
	quest.5EC1A70000001701.quest_desc: [
		"Make lava in the Porcelain Crucible, then craft your first Cobblestone Generator. Place storage to collect its output and check that it is filling."
		""
		"This gives you a renewable supply to hammer and sieve without dismantling your island."
	]
	quest.5EC1A70000001701.title: "Cobblestone Generator"
	quest.5EC1A70000001801.quest_desc: [
		"Craft each generator tier and take it into your inventory before upgrading it. Use a Functional Storage drawer to hold the Cobblestone."
		""
		"Increase production as your hammering and sieving line grows; a faster generator cannot help when its output storage is full."
	]
	quest.5EC1A70000001801.title: "Master Every Generator"
	quest.5EC1A70000001901.quest_desc: [
		"Fire an Unfired Porcelain Crucible in a furnace, place the finished crucible over a valid heat source, and add Cobblestone. Collect the lava once it holds a bucket."
		""
		"JEI lists heat sources and their speeds. Keep flammable blocks away from the heat and make enough lava for your Cobblestone Generator."
	]
	quest.5EC1A70000001901.title: "A Bucket of Fire"
	quest.5EC1A70000001A01.quest_desc: [
		"Build and light an Obsidian portal, then enter the Nether. Bring food, blocks and a spare ignition tool, and mark your return portal."
		""
		"Nether resources and structure loot feed several early magic recipes. This quest checks the dimension visit."
	]
	quest.5EC1A70000001A01.title: "Into the Nether"
	quest.5EC1A70000001B01.quest_desc: [
		"Place Eidolon's Crucible over heat, add water, and follow the Pewter recipe in the Ars Ecclesia. This is a different block from the Ex Deorum Crucible."
		""
		"Add ingredients in the recipe's stages, waiting for each reaction before continuing. Pewter leads to Arcane Gold and the Worktable."
	]
	quest.5EC1A70000001B01.title: "Pewter Alchemy"
	quest.5EC1A70000001C01.quest_desc: [
		"Make Arcane Gold and an Eidolon Worktable. Its recipes use both the main grid and the separate reagent slots; fill both exactly as shown in JEI."
		""
		"Keep the Worktable for the Martial Warrior pill at the end of this chapter."
	]
	quest.5EC1A70000001C01.title: "The Magic Worktable"
	quest.5EC1A70000001D01.quest_desc: [
		"An optional collection of Budding GeOre. Leave its faces exposed so buds can grow, then harvest the mature clusters without destroying the budding block."
		""
		"Start with materials your base needs and fill out the collection later."
	]
	quest.5EC1A70000001D01.title: "Every Budding GeOre"
	quest.5EC1A70000001E01.quest_desc: [
		"Follow the Dark Power Gem chain in Origins of Darkness and JEI to build a Blood Infuser. It processes items using Blood rather than FE."
		""
		"Keep collecting Blood: the Corrupted Tear needed for the Aether costs more than one full extractor holds."
	]
	quest.5EC1A70000001E01.title: "Infusion of Blood"
	quest.5EC1A70000001F01.quest_desc: [
		"Infuse a Ghast Tear with 10,000 mB of Blood in the Blood Infuser. This recipe does not require a high-tier Promise."
		""
		"Keep the Corrupted Tear to activate your Glowstone portal. Water and ordinary Ghast Tears do not open the Aether portal in this pack."
	]
	quest.5EC1A70000001F01.title: "A Corrupted Key"
	quest.5EC1A70000003101.quest_desc: [
		"Build a Glowstone portal frame and activate the opening with a Corrupted Tear. Enter the Aether with food and building blocks, and secure your arrival point."
		""
		"Bring home a Skyroot Bucket. Filled with Water, it is an ingredient in the Cooking Pot recipe."
	]
	quest.5EC1A70000003101.title: "Journey to the Aether"
	quest.5EC1A70000003201.quest_desc: [
		"In a heated Farmer's Delight Cooking Pot, combine Beetroot, two Infernal Spirits and Earth Essence to make Spirit Ginseng Root."
		""
		"Grim Harvest explains how to reap the spirits with a Crude Scythe. Save the finished root for the Martial Warrior pill; it does not need to be found in the wild."
	]
	quest.5EC1A70000003201.title: "Spirit Ginseng Root"
	quest.5EC1A70000003301.quest_desc: [
		"Put the Source Gem in the Imbuement Chamber and place the Earth Essence recipe's three supporting ingredients on separate nearby Arcane Pedestals."
		""
		"An Agronomic Sourcelink gathers Source from crop growth. Keep a Source Jar within reach of the sourcelink and chamber, and grow crops to charge it."
	]
	quest.5EC1A70000003301.title: "Essence of Earth"
	quest.5EC1A70000003401.quest_desc: ["Craft Cognitive Alloy for Cognition's experience-storage devices. JEI has the pack's recipe; make enough for the Fountain, Obelisk and Attunement Staff in the next quest."]
	quest.5EC1A70000003401.title: "Cognitive Alloy"
	quest.5EC1A70000003501.quest_desc: [
		"The Experience Obelisk stores Minecraft XP. Build the Fountain and Attunement Staff alongside it, follow their tooltips to connect the setup, and test a small deposit and withdrawal."
		""
		"Stored XP is separate from Ki and cultivation progress. It will not advance your realm."
	]
	quest.5EC1A70000003501.title: "Store Your Experience"
	quest.5EC1A70000003601.quest_desc: [
		"Build a hollow 3×3×3 Colossal Chest from the required core and wall blocks, leaving the center empty. Connect its inventory to Tom's network and a Crafting Terminal."
		""
		"Use the Crafting Terminal, not the Storage Terminal. The quest's item counts are not a complete shell checklist. Test that the terminal can see an item in the chest before moving your storage."
	]
	quest.5EC1A70000003601.title: "Crafting Terminal and Colossal Chest"
	quest.5EC1A70000003701.quest_desc: [
		"Power an RFTools Builder, insert a configured Fortune Quarry Shape Card, and provide storage for the mined blocks. Preview a small test area before starting."
		""
		"Use a mining area away from your base. This task requires the Fortune Quarry card, not a plain Shape Card or a different quarry variant."
	]
	quest.5EC1A70000003701.title: "Fortune Quarry"
	quest.5EC1A70000003801.quest_desc: [
		"Start by making your island renewable: keep spare saplings, gather wood and pebbles, and turn leaves into water and compost. Build a safe platform before working with lava."
		""
		"On a server, create your island with /skyblock create <name>. Claim the Silent Gear blueprints below; /hqs shop opens the shop."
		""
		"Chapter 1 ends with the Martial Warrior pill. To use it, reach Mortal Stage 9 and fill the final cultivation bar. Ki is your energy reserve, not your cultivation progress."
		"{@pagebreak}"
		"&6Getting around the quest book&r"
		""
		"Pack defaults: K opens quests, F8 opens Cultivation, and F6 zooms. Type /cultivation_help for a short guide showing your current controls. FAQ and Help covers /home, recovery and key conflicts."
		""
		"Try meditation early, while your materials are processing. Quest lines show prerequisites; checkmarks acknowledge instructions, while item tasks check your inventory. Claim completed rewards from the quest window."
	]
	quest.5EC1A70000003801.title: "Create Your Island and Begin"
	quest.5EC1A70000003901.quest_desc: [
		"The Aether gives a 1.5× cultivation-speed bonus. Build a safe retreat there and meditate while your base processes materials."
		""
		"Aether dungeons and Nether structures can supply early manuals, up to Martial Warrior tier. Read each manual's realm and path requirements before trying to learn it."
	]
	quest.5EC1A70000003901.title: "Aether Cultivation"
	quest.5EC7202609150001.quest_desc: [
		"In Chapter 3, visit the Orthodox and Demonic sects in Lost Cities and compare their manuals before choosing a path. Right-click your chosen sect's altar to pledge; you can then craft its altar for your island."
		""
		"&cYour oath is permanent in Survival. You cannot use the opposing path's arts.&r Either path can complete the pack, and both offer flight and passive Ki recovery at Great Martial Master."
		""
		"The altar offers two one-time supply missions per chapter. Hand in the requested items for merit, then spend merit on manuals. Higher arts also require the listed realm and mission progress."
	]
	quest.5EC7202609150001.title: "Orthodox or Demonic?"
	quest.5EC7202609160801.quest_desc: [
		"Find Azure Cloud Hall or Azure Cloud Academy in Lost Cities. An Explorer's Compass can locate them. The Orthodox altar and master are in the rear central hall or pagoda."
		""
		"Right-click the blue altar and confirm the Orthodox oath. This unlocks the matching altar recipe, mission submissions and manuals."
		""
		"&cThe oath is permanent in Survival and blocks Demonic arts.&r This optional quest records your pledge; it does not require completing the Demonic branch."
	]
	quest.5EC7202609160801.title: "The Orthodox Path"
	quest.5EC7202609160811.quest_desc: [
		"Find Crimson Eclipse Hall or Crimson Eclipse Academy in Lost Cities with an Explorer's Compass. Look for the red altar in the main teaching hall."
		""
		"Right-click the altar and confirm the Demonic oath to unlock the matching altar recipe, mission submissions and manuals."
		""
		"&cThe oath is permanent in Survival and blocks Orthodox arts.&r This optional quest records your pledge; it does not require completing the Orthodox branch."
	]
	quest.5EC7202609160811.title: "The Demonic Path"
	quest.5EC7202609160901.quest_desc: [
		"Gather a Brazier, two Stone Hands and a Necrotic Focus. Use the Ars Ecclesia for the ritual layout, ingredients and activation; Stone Hands hold the offerings."
		""
		"For Soul Shards, use the Crystallization Ritual to sacrifice nearby undead. Zombified Piglins (pigmen) work for the sacrifice too."
		""
		"The four extra Stone Hands rewarded here expand your ritual setup. Keep it accessible for later Eidolon materials."
	]
	quest.5EC7202609160901.title: "Deadly Dealings"
	quest.5EC7202609160911.quest_desc: [
		"Carry a Blood Extractor while killing mobs until it holds 5,000 mB of Blood. Check the amount in its tooltip; an empty extractor will not count."
		""
		"You keep the filled extractor, and the reward supplies another. Save the Blood for the Dark Power Gem and Blood Infuser chain."
	]
	quest.5EC7202609160911.title: "The First Blood"
	quest.5EC7202609250101.quest_desc: [
		"Malum spirits come from kills made with a soul-reaping weapon. Craft a Crude Scythe: smelt Raw Soulstone into Refined Soulstone, then combine it with three Iron Ingots and two Sticks. JEI shows the pattern; Nether Soulstone Ore provides an early source."
		""
		"In the Nether, land the killing blow on a Blaze or Magma Cube with the scythe and collect its Infernal Spirits. An ordinary sword will not harvest them."
		""
		"The quest asks for one spirit, but each Spirit Ginseng Root needs two. Gather a few before returning to your Cooking Pot. The scythe and spirit tasks do not consume your items."
	]
	quest.5EC7202609250101.title: "Grim Harvest"
	quest.5ECD100400000101.quest_desc: [
		"Speak to an outer or inner disciple, instructor, alchemist, elder or venerable to open the sect services menu. The sect leader also offers the Guardian Covenants."
		""
		"Join the sect at its altar first. Training awards 20 merit and alchemy commissions award 12, using the same merit as the manual shop. Each service has a separate five-minute in-world reward cooldown."
		""
		"Start sparring or formation practice from the menu to enter the courtyard automatically. You do not need to move disciples. Read each exercise before starting."
		""
		"Tasks in this chapter name an action, such as winning sparring or solving a shrine. They complete automatically when you succeed; their icons are not items you need to hand in."
	]
	quest.5ECD100400000101.title: "Life Between Expeditions"
	quest.5ECD100400000102.quest_desc: [
		"Right-click a sect resident, choose Sparring, then Start sparring in courtyard. You are taken to the training ground; do not try to clear space around the NPC."
		""
		"Equip a usable cultivation attack, bring its weapon if needed, and refill your Ki. Defeat the reflection with cultivation techniques. It copies your learned attacks and defences."
		""
		"Orthodox: finish within two minutes with at most one marked hit to earn merit. Demonic: finish within 90 seconds; up to two marked hits are allowed. Three marked hits end either exercise."
		""
		"Practice marks do not damage health, but outside hazards can. No pill is spent. The ward prevents flight and leaving the ring. Use /cultivation_trial cancel to concede. Success awards 20 merit."
	]
	quest.5ECD100400000102.title: "The Sparring Instructor"
	quest.5ECD100400000103.quest_desc: [
		"Speak to a sect resident, open Formations and start practice. The menu takes you to the courtyard automatically."
		""
		"Learn a deployable formation: Three-Talisman Gathering Array or Eight Trigrams Spirit Formation for Orthodox; Prismatic Reversal Ward for Demonic. Automatic defensive shields do not count."
		""
		"Equip your formation in F8 > Techniques > Formation. Close the menu and press V at the centre to cast it. Walk to each of four gold circles and cast an equipped combat art. Dodge orange lightning marks; bring enough Ki for the field and four casts."
		""
		"Orthodox: two minutes, at most one marked hit for merit. Demonic: 90 seconds, at most two hits. Three hits end practice. No pill is spent; success awards 20 merit."
	]
	quest.5ECD100400000103.title: "Hold the Formation"
	quest.5ECD100400000104.quest_desc: [
		"Right-click a sect resident and choose Alchemy. The ledger lists two cultivation ingredients and the exact quantities. Gather them in your main inventory, then press Submit ingredients."
		""
		"Orders use spiritual roots, herbs, reeds and flowers, not ordinary potion ingredients. Early commissions need 48 herbs or roots in total. From Martial Lord onward, the ledger requests rarer ingredients such as Moondew Flowers, Frost Lotus Petals and Crimson Yang Ginseng. Check JEI for their sources."
		""
		"A full delivery consumes both ingredients and awards 12 merit. An incomplete delivery consumes nothing. There are three rotating orders at each tier for each path. The five-minute reward cooldown is shared across all desks and residents."
	]
	quest.5ECD100400000104.title: "Alchemy Commissions"
	quest.5ECD100400000105.quest_desc: [
		"Look for a glass-roofed sunken shrine in the Azure Expanse. Its enclosed stairway leads below the water into a dry chamber. This is a small optional landmark, not the Azure Dragon arena or a Tidal Memory Court."
		"Read the central bell. Right-click the surrounding valves to change their pressure from 0 to 3; the glowing bars show the setting. Follow the cardinal directions in the inscription, then return to the bell to check your solution."
		"Your first solution grants 16 Drowned Bell Mosaics and 16 Golden Carrots. Every player can solve it independently. Supplies wait if your inventory is full; revisit a cleared relic after making room."
	]
	quest.5ECD100400000105.title: "The Drowned Bell"
	quest.5ECD100400000106.quest_desc: [
		"The Ember Relay is a low, copper-inlaid platform in Cinder Heaven. Its flame is enclosed, so the puzzle itself does not burn you. The surrounding dimension can still be dangerous."
		"Read the relay, then rotate each of its four conduits with an empty-hand right-click. Their copper outlets show their direction. Follow the inscription to turn the ember inward around the ring, then return to the relay."
		"Your first solution grants 16 Ember Relay Mosaics and eight Fire Charges. These are supplies and decoration, not another crafting gate."
	]
	quest.5ECD100400000106.title: "Pass the Ember"
	quest.5ECD100400000107.quest_desc: [
		"Look for an enclosed stair entrance in the Blackstone Reaches. The Sealed Chronicle rests below the surface, away from Xuanwu's arena. Its four runes remember what each guardian restored."
		"Read the central chronicle to start, then touch the runes in the order described. Each rune tells you its name. A wrong choice resets the sequence without consuming anything. Reading the center starts over; another player's reading does not alter yours."
		"Your first complete reading grants 16 Sealed Chronicle Mosaics and eight Bottles o' Enchanting. Finding more copies does not repeat the reward."
	]
	quest.5ECD100400000107.title: "A Chronicle Beneath Stone"
	quest.5ECD100400000108.quest_desc: [
		"In Chapter 9, keep a sample of Ancestral Remains, Petrified Living Blood, Immortal Flesh and Charred Meridian Stone. Once the Ancestral Reconstructor is built, JEI shows seeded production for all four. Each recipe consumes the seed but produces more of the same resource."
		"Reserve one output to feed the next batch. Remains yield eight; Petrified Living Blood yields eight; Immortal Flesh yields four; Meridian Stone yields 32. Petrified blocks still feed Fluid Extractors for Living Blood."
		"The first samples and the Reconstructor must still be obtained normally. Set filters on separate input supplies; putting every seed type into one bus lets the machine choose any matching recipe. Ordinary construction stone can also be mined in bulk and smelted."
	]
	quest.5ECD100400000108.title: "Keep a Seed Sample"
	quest.5ECD100400000109.quest_desc: [
		"Plan the whole machine before starting its casing crafts. JEI's structure preview lists every block; controller recipes add their own cost. Use the custom energy hatches when the listed FE/t exceeds ordinary hatches, and give each different fluid its own input tank."
		"The Primordial Regenerator has larger seeded recipes: one Ancestral Remains sample becomes 64, or one Immortal Flesh becomes 16. Each batch takes 30 seconds at 8,000,000 FE/t and needs the other JEI ingredients. This scales production for the final construction chains without skipping their ingredients."
		"{@pagebreak}"
		"Keep the earlier farms running: the Spirit Geode Nursery grows a retained Ki Crystal seed, Hostile Neural Networks supplies supported mob resources, and your existing Replication blueprints cover their own unlocked materials. Do not build a new manual gathering loop where one of those systems already supplies the item."
		"Use an item bus with enough slots for every input and leave room in the output. The new resource recipes use at most eight buckets of any fluid; no custom machine recipe is allowed to require more than 128 buckets of one fluid per operation."
	]
	quest.5ECD100400000109.title: "Production for the Final Machines"
	quest.5ECFA92400000101.quest_desc: [
		"Use the First Steps row for hands-on practice, or open any answer below. These checkmarks only mark information as read; they do not unlock realms or accept missions."
		""
		"Type /cultivation_help for live key labels and an optional control preset with Preview and Restore. Individual bindings are under Options > Controls."
		""
		"Commands below describe pack defaults. Servers can change permissions, limits and cooldowns; chat autocomplete shows available commands."
	]
	quest.5ECFA92400000101.title: "Start Here: How to Use This FAQ"
	quest.5ECFA92400000102.quest_desc: [
		"Open Cultivation and click Meditate. Stay still in a safe place; click Stop before travelling or casting an art. Cultivation progress advances your stage, while Ki pays for abilities."
		""
		"Default keys: F8 opens Cultivation, K opens quests, V casts your equipped formation and F6 zooms. Your personal bindings are preserved; /cultivation_help shows the keys currently assigned."
		""
		"Learn cultivation-method manuals for their listed bonuses. Check each method's realm and path requirements."
	]
	quest.5ECFA92400000102.title: "How Do I Cultivate?"
	quest.5ECFA92400000103.quest_desc: [
		"Reach Stage 9 and fill the final cultivation bar, then consume the pill for the next realm. Later pills cannot skip realms, and completing a quest does not perform the breakthrough."
		""
		"&cThe Lord, Emperor and God pills start challenges and are consumed even if you fail. Read the pill's quest before using it.&r"
		""
		"If progress or Ki behaves unexpectedly, check the cultivation screen and your learned methods. Passive Ki recovery while moving is not supplied by every method."
	]
	quest.5ECFA92400000103.title: "Why Can't I Break Through?"
	quest.5ECFA92400000104.quest_desc: [
		"Find an Azure Cloud Hall or Academy for Orthodox, or a Crimson Eclipse Hall or Academy for Demonic, in Lost Cities. Use its sect altar to choose your allegiance."
		""
		"Your path controls which manuals and arts you can use. Opposing learned arts are sealed rather than deleted. Read the oath before choosing."
		""
		"Sect tributes consume the requested items and award merit once. Manuals can also require a particular realm and completed mission."
		"{@pagebreak}"
		"&6Creative and testing access&r"
		""
		"The Creative Cultivation Book unlocks both paths and teaches cultivation methods and martial arts. It has no recipe or loot source."
		""
		"It does not change your realm, sect oath or mission progress. Activation requirements still apply. This is an admin/testing item, not part of survival progression."
	]
	quest.5ECFA92400000104.title: "How Do I Choose a Sect?"
	quest.5ECFA92400000105.quest_desc: [
		"Learn a manual, then equip its active art in Cultivation > Techniques. Defaults: Z casts fist, X casts palm and C casts the held-weapon art. Sword, saber and spear arts need matching weapons."
		""
		"You must have enough Ki, a ready cooldown and the required realm, and must stop meditating. Aim before casting."
		""
		"Equip a learned field in F8 > Techniques > Formation. Close the menu, then press V to deploy it; press V again to dismiss the same field. Equipping is free; casting spends Ki. Read its radius, duration and cost. Automatic shields and other passive arts do not need deployment."
	]
	quest.5ECFA92400000105.title: "How Do I Use Martial Arts and Formations?"
	quest.5ECFA92400000106.quest_desc: [
		"Use /sethome base at a safe spot, then /home base to return. Replace base with your chosen name."
		""
		"Use /back for a previous teleport or death location, /tpa <player> to request a visit, /tpaccept to accept, and /spawn where enabled. A return destination can still be dangerous."
		""
		"Servers control home limits and cooldowns. /rtp is disabled in the skyblock Overworld and the End; use the island command instead."
	]
	quest.5ECFA92400000106.title: "How Do I Set a Home or Teleport Back?"
	quest.5ECFA92400000107.quest_desc: [
		"The pack is designed around a sky island. On a server, /skyblock create <name> creates yours; you only need to do this once. Follow the server's island controls for sharing."
		""
		"FTB quest teams, island membership and Ki-channel access are separate systems. Joining one does not grant the others automatically."
		""
		"For normal terrain in single-player, select the normal/default world type when creating a world. Do not alter an existing save's generator to convert it. Back up saves before updates."
	]
	quest.5ECFA92400000107.title: "Islands, Teams and World Types"
	quest.5ECFA92400000108.quest_desc: [
		"Return to your death location, using /back if available. Make inventory space and sneak over your own grave; you do not need to break it."
		""
		"Protection blocks destructive attacks and automation while allowing legitimate recovery. Server ownership permissions may still apply."
		""
		"If recovery fails, record the coordinates and dimension and contact staff. Avoid explosives or destructive machines; missing items may require a backup."
	]
	quest.5ECFA92400000108.title: "How Do I Recover My Grave?"
	quest.5ECFA92400000109.quest_desc: [
		"Vethea has its own inventory rules and protected dungeons. Leave valuable accessories at home before an unfamiliar visit."
		""
		"If you die in a protected area, sneak over your grave instead of breaking it."
		""
		"If building remains blocked after leaving a dungeon, check claims and team permissions. Report your location and exit route to staff; do not delete player data or repeatedly die to try to fix it."
	]
	quest.5ECFA92400000109.title: "Vethea: Inventory and Building Restrictions"
	quest.5ECFA9240000010A.quest_desc: [
		"In JEI, hover an item and press R for recipes, U for uses or A to bookmark it. Use this pack's recipes; other packs may change them."
		""
		"Hold G over a supported item until its guide opens. The tooltip indicates available pages. Some guides require their book or an unlocked entry, and not every mod supplies one."
		""
		"For machine recipes, check the exact resource types, amounts, sides, power and output space. A chemical input is different from an item or fluid input."
	]
	quest.5ECFA9240000010A.title: "Recipes and the Hold-G Guide Shortcut"
	quest.5ECFA9240000010B.quest_desc: [
		"Check every task and its count, including advancements and checkmarks. Take required items out of machines or networks into your inventory. Filled containers, encoded blueprints and named variants must match the task."
		""
		"For a locked quest, follow its dependency lines and finish the required earlier tasks. Claim rewards separately."
		""
		"Use /hqs shop for the quest shop. If a correct item still will not register, report the quest title, tooltip and pack version rather than resetting progress."
	]
	quest.5ECFA9240000010B.title: "Why Won't My Quest Complete?"
	quest.5ECFA9240000010C.quest_desc: [
		"Connect a Machine Ki generator, storage and consumers through Crystal Interfaces on the same accessible channel. Interfaces transfer Ki; Reservoirs and Ki Vaults store it."
		""
		"Check channel ownership, permissions, tier range and available Ki. Interfaces can attach to any side of compatible machines."
		""
		"Hover the machine's Ki bar for its stored amount and capacity. Vaults have no upgrade slots; use a higher tier or the vault-bank multiblock. Machine Ki, personal Ki, Liquid Ki and FE are separate resources."
	]
	quest.5ECFA9240000010C.title: "Ki Interfaces, Channels and Vaults"
	quest.5ECFA9240000010D.quest_desc: [
		"For a custom multiblock, use its encoded controller's JEI structure page and compare every layer, internal block and port. Read the controller's status message."
		""
		"A formed machine also needs inputs, output space and a suitable power supply. Check hatch capacity and FE/t: late machines need Celestial or Divine Energy Input Hatches."
		""
		"Compact Machines' room previews are disabled to avoid preview-related crashes. The rooms and normal access still work."
		""
		"For help, include the controller name, status text and clear layer screenshots. Empty inventories and tanks before dismantling."
	]
	quest.5ECFA9240000010D.title: "Multiblocks and Compact Machines"
	quest.5ECFA9240000010E.quest_desc: [
		"Custom chapter components use crafted, encoded Matter Blueprints. Detect the blueprint, transfer it to Chip Storage and request the item from the Replication Terminal. They do not need an original sample."
		""
		"Guardian imprints instead use scanning: put one in a powered Identification Chamber with a Memory Chip, wait for 100%, then move the chip to Chip Storage. Both routes need the correct matter types."
		""
		"For Hostile Neural Networks, check the model, Simulation Chamber and Loot Fabricator recipes. Custom sieve recipes have matching compressed versions; use JEI's required input and mesh."
	]
	quest.5ECFA9240000010E.title: "Replication, Data Models and Farming"
	quest.5ECFA9240000010F.quest_desc: [
		"Try lower render and simulation distances, fewer particles and no shaders. Leave RAM for Windows and background apps rather than assigning all installed memory to Minecraft."
		""
		"Heap usage rising and falling is normal garbage collection. JEI recipe-registration timing lines are informational; neither alone proves a crash or memory leak."
		"{@pagebreak}"
		"&6Reporting a useful bug&r"
		""
		"Include the pack version, single-player or server, exact steps, affected item or block, and screenshots. Attach the matching crash report and logs/latest.log. Redact tokens or personal addresses before sharing publicly."
		""
		"For performance issues, include total RAM and Minecraft's allocation. Keep client and server pack versions matched. Back up worlds before updating and remove superseded custom JARs rather than leaving duplicate versions installed."
	]
	quest.5ECFA9240000010F.title: "Loading, Performance and Reporting Bugs"
	quest.5ECFA92400000110.quest_desc: [
		"&6Hosting a world&r"
		""
		"e4mc lets friends join your single-player world over the internet. You do not need to set up router port forwarding."
		""
		"1. Load your world, press Esc, choose Open to LAN, then Start LAN World. Leave cheats off unless you want them enabled."
		""
		"2. Wait for e4mc to show an address in chat. Copy the full address and send it privately to your friends. Use that address, not just the local LAN port number."
		""
		"3. Your friends select Multiplayer > Direct Connection, paste the address into Server Address, then click Join Server."
		""
		"Keep your world open while you play together. Returning to the title screen or closing Minecraft ends the session for everyone."
		"{@pagebreak}"
		"&6Before friends join&r"
		""
		"Everyone needs the same Dimensional Cultivation release and matching gameplay mods. e4mc supplies the connection; it does not send your mods to other players."
		""
		"&cShare the address only with people you trust. It gives them a way to connect to your world.&r"
		""
		"No address, or an e4mc error? Check your internet connection, return to the title screen, reopen the world and use Open to LAN again. Share the latest address; it can change between sessions."
		""
		"Your computer runs the world for everyone. If it struggles, lower simulation distance and avoid exploring far apart at the same time."
		""
		"For a world that stays online while the host is away, use the matching dedicated server pack instead. This checkmark only marks the guide as read; multiplayer is optional."
	]
	quest.5ECFA92400000110.title: "Playing with Friends (e4mc)"
	quest.5F239340F51B8CC5.quest_desc: [
		"Build the Evolved Mekanism Alloyer and follow its alloy chain in JEI to Singular and Exoversal Alloys."
		""
		"Stock both types for the evolved components and final pill. They are distinct ingredients, not interchangeable tiers."
	]
	quest.5F239340F51B8CC5.title: "Evolved Mekanism"
	quest.60B252E76050E423.quest_desc: [
		"Obtain an Orb of Prophecy and follow Eternal Starlight's entry instructions to reach Starlight. The quest checks both the item and your visit."
		""
		"Mark a return point and keep its boss drops for Starforged Boss Essence."
	]
	quest.62B5C312D65D9D30.quest_desc: [
		"Follow the Nine Heavens Law Loom's JEI structure page. Both fluid inputs and both energy inputs are on the rear wall, with Meridian Glass between the fluid inputs. Keep the two fluids on separate lines; Vacuum inputs or larger hold enough."
		""
		"Fit at least one Divine Energy Input Hatch and fill the other energy-input position with an accepted hatch. Law Fragments use 12,000,000 FE/t; Heavenforged Law Alloy uses 16,000,000 FE/t and also needs Ancestral Dragon Blood. Supply that power continuously while crafting."
	]
	quest.62B5C312D65D9D30.title: "Nine Heavens Law Loom"
	quest.63928A0647466C36.quest_desc: [
		"Run six Mortum Soul Resonator batches to produce 48 Soul Filaments. Each operation gives eight and consumes its own items and Liquid Ki."
		""
		"Keep the output clear and make extra filaments for the Void Mandala blueprint."
	]
	quest.63928A0647466C36.title: "Mortum Soul Filaments"
	quest.639E7082194D24AE.quest_desc: [
		"In the Overworld, freeze a Clock in Icy Fire at time 18000. Bring it and a Waystone to Skythern."
		""
		"Throw a Skythern Heart into Divine Flame there, then use the Frozen Clock on the flame to open the Mortum rift. Activate your return point after arriving."
	]
	quest.639E7082194D24AE.title: "Open the Mortum Rift - Time 18000"
	quest.645FA6A841C024A0.quest_desc: [
		"Make the Ancestral Dragon Catalyst in the Primordial Regenerator. It is used in ancestral production and blueprint crafting."
		""
		"Check its JEI uses to plan your batch size alongside the Sovereign pill components."
	]
	quest.645FA6A841C024A0.title: "Ancestral Dragon Catalyst"
	quest.6465FAC1FB663DB3.quest_desc: [
		"Assemble the Mechanized Dantian in the Ultimate 9×9 Crafting Table. Prepare the full stock of alloys, plates and Purified Spirit before laying out the recipe."
		""
		"Keep it for advanced machinery and the Martial King pill. It is a crafting component, not a usable breakthrough item."
	]
	quest.67DBEBBAD49E4187.quest_desc: [
		"Assemble the Heavenly Mandate from the law-branch materials in the required crafting table."
		""
		"Use the exact item shown: this is not Chapter 9's replicated Sovereign Mandate."
	]
	quest.67DBEBBAD49E4187.title: "Write the Heavenly Mandate"
	quest.682BB4A347E5417D.quest_desc: [
		"Energize a Spirit Distillation Lens and craft the encoded Fivefold Soul Refinery controller. Follow every layer in its JEI preview, including the internal Spirit Altars, Beacon and ports."
		""
		"Supply items through the input bus, Liquid Ki through the fluid input hatch and FE through energy hatches. The internal altars are part of the structure, not the recipe input interface."
	]
	quest.68D1136899EDDA2E.quest_desc: ["Craft a Resentful Soul Shard from a Shadow Gem, Rotten Flesh, a Zombie Head and Eidolon's Zombie Heart. Save it for the Eden Source Altar."]
	quest.68DA4A2EDD0B3462.quest_desc: [
		"Face separate Fluid Extractors toward Petrified Living Blood and Dragon Vein Stone. Pipe Living Blood and Dragon Vein Essence into separate tanks."
		""
		"Collect a bucket of each for detection. Both source blocks are consumed over time; replace them to keep production running."
	]
	quest.68DA4A2EDD0B3462.title: "Extract the Living Veins"
	quest.693803B29AF15F04.quest_desc: [
		"Process the Divine Body Embryo in the Immortal Body Crucible with the listed materials, 32,000 mB Liquid Ki and 16,000 mB Ancestral Dragon Blood."
		""
		"Reserve the Primordial Godbody for the final crafting chain."
	]
	quest.693803B29AF15F04.title: "Reconstruct the Primordial Godbody"
	quest.6A9C8A864A834786.quest_desc: [
		"Use Wyvern-tier Fusion Crafting Injectors with Celestial Ki Alloy as the central catalyst and the listed Starlight ingredients around it."
		""
		"One 20,000,000 FE operation makes four Astral Meridian Ingots. Keep this production route for Chapter 6 vessels and Ki processing."
	]
	quest.6A9C8A864A834786.title: "Temper the Astral Meridians"
	quest.6B09586BCAE4C824.quest_desc: [
		"Gather 68 Samsara Woven Casings and let the quest detect them before building the Six Paths Samsara Wheel."
		""
		"Keep additional components for the controller recipe."
	]
	quest.6B09586BCAE4C824.title: "Samsara Woven Casings"
	quest.6C9E3826575E55C7.quest_desc: [
		"Process the spare Dormant Synthetic Dantian Core and the other listed ingredients in the Heavenly Tribulation Crucible with 16,000 mB Spirit Meridian Essence."
		""
		"The core is consumed. Keep the awakened result for the Void-Tempered Dantian chain."
	]
	quest.6C9E3826575E55C7.title: "Awaken the Synthetic Dantian"
	quest.6D9C2FBCBC27DF5F.quest_desc: [
		"Craft the Spirit Loom with a physical Spirit Gathering Mantra Manual. Right-click to open it, insert Spider Silk and fill its tank with Liquid Ki using a pipe or bucket."
		""
		"Before upgrades, one Spider Silk uses 250 mB Liquid Ki and takes five seconds. Save the Spirit Silk for Forgeheart Cores and Scarlet Meridian Thread."
	]
	quest.6DF307CAC62762CB.quest_desc: [
		"Process Thunderheart Ginseng in the Age-er with the required Aging Catalyst and Liquid Ki. Collect three Thousand-Year Ginseng Essences before spending them."
		""
		"Spirit Ginseng Root is a different herb. Keep the Age-er for later batches."
	]
	quest.6EC2A70000001001.quest_desc: [
		"Refine Raw Realmite, Raw Arlemite and Raw Rupee in an Ars Nouveau Imbuement Chamber, not a furnace. Put the raw metal inside and the supporting ingredients on nearby pedestals, with a charged Source Jar in range."
		""
		"Work in order: Realmite uses Iron, Earth Essence and a Source Gem; Arlemite uses Realmite, Earth Essence and Amethyst; Rupee uses Arlemite, Earth Essence and Diamond. Keep some of each ingot for the next recipe."
	]
	quest.6EC2A70000001001.title: "Metals of the Mortal Realm"
	quest.6EC2A70000001002.quest_desc: [
		"Craft a Mysterious Clock from a Clock, Corrupted Stones and a Hellstone Ingot. Use it to summon the Ancient Entity in an open area after preparing for the fight."
		""
		"Torridite Ore generates at Y 8–120. Configure a Scannable Block Module for it, insert the module into a charged Scanner, and scan nearby rock."
		""
		"For renewable Corrupted Shards, imbue an Amethyst Shard with Hellstone, Fire Essence, Soul Sand and a Fermented Spider Eye using 2,500 Source."
	]
	quest.6EC2A70000001002.title: "A Clock for the Ancient"
	quest.6EC2A70000001003.quest_desc: [
		"Defeat the Ancient Entity and collect its Sandslash and Divine Shards. You need nine shards to make the Divine Stone for the Eden portal chain."
		""
		"Let the quest detect the drops before crafting them. Summon the boss again if you are short on shards."
	]
	quest.6EC2A70000001003.title: "Defeat the Ancient Entity"
	quest.6EC2A70000001004.quest_desc: [
		"Build a Nether-portal-shaped frame using at least ten Snow Blocks. Throw an Ice Stone into fire at its base to create Icy Fire, then use a Snow Globe on that fire. The Ice Stone costs nine Ice Shards and is consumed."
		""
		"For Snow Blocks on your island, freeze a Water Bucket in an Aether Freezer. Use the Ice to craft Ice Seeds, grow them, then craft four Ice Essence in a cross for twelve Snow Blocks. The portal frame uses Snow Blocks, not Packed Ice."
	]
	quest.6EC2A70000001004.title: "Open the Iceika Portal"
	quest.6EC2A70000001005.quest_desc: [
		"Throw a Divine Stone into ordinary fire to create Divine Flame. Right-click the flame itself with a midday Frozen Clock to open the temporary Eden rift."
		""
		"The pack's Clock-and-four-Ice-Shards recipe makes the correct time-6000 variant. Enter Eden, then activate a Waystone or build its permanent portal from Eden Blocks so you can return safely."
	]
	quest.6EC2A70000001005.title: "Enter Eden"
	quest.6EC2A70000001006.quest_desc: [
		"Collect twelve Eden Fragments, four Eden Sparkles and an Eden Soul. Keep them in your inventory until their tasks register."
		""
		"These feed Eden equipment and the chapter's alchemy. Check their JEI uses before spending the whole supply on gems."
	]
	quest.6EC2A70000001006.title: "Harvest Eden's Essence"
	quest.6EC2A70000001007.quest_desc: [
		"Craft three Eden Fragments into an Eden Gem, then three Eden Gems into an Eden Chunk. Take both forms into your inventory for the quest."
		""
		"Reserve some for the Pickaxe, shield and altar components."
	]
	quest.6EC2A70000001007.title: "Condense Eden"
	quest.6EC2A70000001008.quest_desc: ["Forge an Eden Pickaxe and an Eden Aegis before challenging Sunstorm. Bring both through your inventory so the tasks register, then prepare armor, healing and a return route."]
	quest.6EC2A70000001008.title: "Arms of the Golden Realm"
	quest.6EC2A70000001009.quest_desc: [
		"Find Sunstorm's arena, prepare for the fight, and defeat the boss. Collect and keep its Eden Heart for the Martial Master pill."
		""
		"You will need another Heart for the Wildwood rift later, so mark the arena for a return visit."
	]
	quest.6EC2A70000001009.title: "Champion of Eden"
	quest.6EC3A70000001001.quest_desc: [
		"Craft and place a Lost City Cake, then use it to travel. Bring food, blocks and a return method: Lost Cities is permanently dark."
		""
		"Search for exploration materials and the Azure Cloud or Crimson Eclipse sects. Their oath quests are alternatives; choose only one allegiance."
	]
	quest.6EC3A70000001001.title: "Into the Lost Cities"
	quest.6EC3A70000001002.quest_desc: [
		"Find Jadeleaf Herb in Aether dungeon chests and Ironbone Root in Lost Cities' boss-guarded glass-sphere buildings. Keep both herbs for crafting."
		""
		"&cLost Cities has eternal night and enemies with 5× health and damage.&r Prepare an escape route before entering guarded buildings. You also need to visit the dimension yourself for this quest."
	]
	quest.6EC3A70000001002.title: "Relics of a Fallen World"
	quest.6EC3A70000001003.quest_desc: [
		"Find Certus Quartz and the four Inscriber presses in AE2 meteorites, using a Meteorite Compass to search. JEI also lists the pack's other Certus Quartz sources."
		""
		"Keep all four presses: they are reusable tools for processor production."
	]
	quest.6EC3A70000001003.title: "Crystals of Thought"
	quest.6EC3A70000001004.quest_desc: [
		"Power the Charger to make Charged Certus Quartz. Power the Inscriber and use its presses to print circuits and silicon."
		""
		"Follow the top, middle and bottom slot positions in JEI. When automating, check which slot each input side feeds."
	]
	quest.6EC3A70000001004.title: "The First Thought-Machines"
	quest.6EC3A70000001005.quest_desc: [
		"Make Charged Certus Quartz and Fluix Crystals. For each processor, print its circuit and silicon separately, then combine them with Redstone in the Inscriber."
		""
		"Logic, Calculation and Engineering Processors use different presses and materials. Keep supplies of all three for the ME network."
	]
	quest.6EC3A70000001005.title: "Three Processor Meridians"
	quest.6EC3A70000001006.quest_desc: [
		"Connect an ME Controller to power and cable, and add an ME Energy Cell as a buffer. Check that the network stays online before expanding it."
		""
		"The Energy Cell stores power, not items. If devices lose power or channels, trace their cable path back to the controller."
	]
	quest.6EC3A70000001006.title: "Heart of the Network"
	quest.6EC3A70000001007.quest_desc: [
		"Insert a 4k Item Storage Cell into a powered ME Drive and connect a Terminal. Test storing and retrieving an item."
		""
		"A Drive needs cells to hold items. Keep your old chests until the network is working, and take care when moving populated drives."
	]
	quest.6EC3A70000001007.title: "Memory Without Chests"
	quest.6EC3A70000001008.quest_desc: [
		"Connect a Terminal to your ME network. The Crafting Terminal adds a crafting grid using stored items; automated crafting needs the setup in the next quest."
		""
		"Test a small transfer when connecting old chests through storage buses or import systems."
	]
	quest.6EC3A70000001008.title: "Touch the Digital Dantian"
	quest.6EC3A70000001009.quest_desc: [
		"Use a Pattern Encoding Terminal to encode a crafting recipe. Put the pattern in a Pattern Provider beside a Molecular Assembler, and add a crafting CPU with Crafting Storage. Request the result from your Terminal."
		""
		"For machine recipes, encode a processing pattern instead and return the machine's output to the ME network. Molecular Assemblers handle crafting-table recipes."
	]
	quest.6EC3A70000001009.title: "Automated Refinement"
	quest.6EC3A7000000100B.quest_desc: [
		"Install the required ME Storage Component in a Matter Condenser and select Singularity output. Feed expendable items or fluid until it has enough matter; JEI shows the required component."
		""
		"&cCondenser inputs are destroyed.&r Use a renewable bulk supply and keep rare materials out. Save the Singularity for the Spatial Dantian Core."
	]
	quest.6EC3A7000000100B.title: "Condense a Singularity"
	quest.6EC3A7000000100C.quest_desc: [
		"Power a Metallurgic Infuser and Enrichment Chamber. The Infuser combines items with infusion material; the Enrichment Chamber makes more efficient infusion supplies."
		""
		"Configure item, infusion and output sides separately. Empty incompatible infusion material before switching recipes."
	]
	quest.6EC3A7000000100C.title: "Mechanical Meridians"
	quest.6EC3A7000000100D.quest_desc: [
		"Make Infused, Reinforced and Atomic Alloys in that order, changing the infusion material for each tier. Enriched ingredients make better use of the Infuser's supply."
		""
		"Craft Basic Control Circuits as well, and reserve these components for your Spatial Dantian Core."
	]
	quest.6EC3A7000000100D.title: "Three Layers of Infusion"
	quest.6EC3A7000000100E.quest_desc: [
		"Connect the Source Acceptor and ME Source Jar to your powered ME network and nearby Ars Source production. Check that Source is entering storage."
		""
		"These devices transfer Source; FE does not become Source. Keep your crops and Sourcelink supplied to fill the cell in the next quest."
	]
	quest.6EC3A7000000100E.title: "Source in the Network"
	quest.6EC3A7000000100F.quest_desc: [
		"Fill a 1k ME Source Storage Cell completely: it must contain 100,000 Source. Remove it from the network and check the tooltip."
		""
		"Both the quest and the final pill recipe require the full cell. Let the quest detect it before putting it into the Inscriber."
	]
	quest.6EC3A7000000100F.title: "A Full Spiritual Reservoir"
	quest.6EC3A70000001010.quest_desc: [
		"Combine the Singularity, Mekanism components, Greater Ki Crystal and exploration herbs into a Spatial Dantian Core, following JEI."
		""
		"The core is a crafting ingredient. Press it with Snow Lotus and the filled Source cell to make your pill."
	]
	quest.6EC3A70000001010.title: "Spatial Dantian Core"
	quest.6EC5A70000001001.quest_desc: ["Twilight Forest creatures and bosses are stronger than normal."]
	quest.6EC5A70000001001.title: "First Realm: Eternal Twilight"
	quest.6EC5A70000001002.quest_desc: ["The Ur-Ghast always drops the Mountain-Sheltering Body manual."]
	quest.6EC5A70000001002.title: "Tribulation of Burning Tears"
	quest.6EC5A70000001003.quest_desc: ["Find the Snow Queen in the Aurora Palace."]
	quest.6EC5A70000001003.title: "Tribulation of the Frozen Crown"
	quest.6EC5A70000001008.quest_desc: ["Defeat the Gatekeeper and use an Orb of Prophecy to reach Eternal Starlight."]
	quest.6EC5A70000001008.title: "Third Realm: Eternal Starlight"
	quest.6EC5A70000001009.title: "Seeds of Three Stellar Cycles"
	quest.6EC5A7000000100A.quest_desc: ["The Starlight Golem drops the Indestructible Golden Body manual."]
	quest.6EC5A7000000100A.title: "The Three Starlight Guardians"
	quest.6EC5A7000000100B.quest_desc: ["Look for Thunderheart Ginseng in high-tier treasure chests."]
	quest.6EC5A7000000100B.title: "One Blue Treasure"
	quest.6EC5A7000000100C.title: "Ultimate Formation Table"
	quest.6EC5A7000000100D.title: "Convergence of Three Realms"
	quest.6EC6101600001001.quest_desc: [
		"An optional Chapter 6 bulk alternative to the Quantum Compressor. Craft the controller, then open its JEI multiblock page for the 5 x 5 x 4 structure."
		"Three Ludicrous Input Buses hold 3 x 32 x 64 = 6,144 items. Supply 5,000 matching items across them: 2,048 + 2,048 + 904 is one valid split. Connect your automation to all three buses."
		"One batch gives one singularity at 200,000 FE/t for 600 ticks. The Ultimate Catalysts are used to craft the controller, not consumed each batch."
		"A crown may replace the centre roof casing for 2x / 4x / 8x speed at unchanged FE/t. The old compressor recipes are still available, including the cheaper 512-crystal Living Meridian recipe."
	]
	quest.6EC6101600001001.title: "Singularity Compression Chamber"
	quest.6EC6A70000001002.quest_desc: [
		"Use Yin Bees for Frost Combs and Yang Bees for Flame Combs in Advanced Beehives. Yin Bees pollinate Frost Lilies; Yang Bees pollinate Fire Lilies."
		""
		"Frost Lily: two Blue Ice, two Water Essences and one Greater Ki Crystal."
		""
		"Fire Lily: two Blaze Rods, two Fire Essences and one Greater Ki Crystal."
		""
		"JEI shows the 3×3 patterns."
		""
		"Keep the matching planted lily accessible, or put the lily item in a Feeding Slab. Simulation Upgrades use the normal Feeding Slab position for the hive. Lilies are reusable."
		"{@pagebreak}"
		"&6Plan for bulk production&r"
		""
		"The 64-comb objectives are only your first batch. Each Yin Frost or Yang Flame Singularity needs 5,000 matching combs. Establish both farms before making the full set."
		""
		"JEI's flowering pages show the correct lily for each bee. Source Gem Blocks are not their pollination target."
	]
	quest.6EC6A70000001002.title: "Frost and Flame Combs"
	quest.6EC6A70000001003.quest_desc: [
		"Supply the Quantum Compressor with FE, the recipe's catalyst and the correct comb. It accumulates the input count required by the singularity recipe."
		""
		"Use the Yin Frost and Yang Flame pages in JEI. Keep their batches separate so an incorrect input does not hold up the machine. The optional Singularity Compression Chamber processes full 5,000-item batches across three Ludicrous Input Buses; see its nearby quest."
	]
	quest.6EC6A70000001003.title: "Quantum Compression"
	quest.6EC6A70000001004.quest_desc: [
		"Make nine Yin Frost and nine Yang Flame Singularities. At 5,000 combs each, this needs 45,000 Frost Combs and 45,000 Flame Combs."
		""
		"The singularities share an item ID but have different stored types. Check their tooltips and let both tasks detect them before crafting the blocks."
	]
	quest.6EC6A70000001004.title: "Eighteen Singularities"
	quest.6EC6A70000001005.quest_desc: [
		"Craft nine matching singularities into a Yin Frost Singularity Block, then do the same for Yang Flame. Face a separate Fluid Extractor toward each block."
		""
		"Extraction gradually consumes the blocks. Keep making combs and singularities so you can replace them."
	]
	quest.6EC6A70000001005.title: "Twin Singularity Blocks"
	quest.6EC6A70000001006.quest_desc: [
		"Face each Fluid Extractor toward its matching singularity block and pipe the essence into a separate tank. Test the orientation before automating block replacement."
		""
		"Keep Yin and Yang fluids on separate lines, and replace blocks as they are depleted."
	]
	quest.6EC6A70000001006.title: "Siphon the Two Essences"
	quest.6EC6A70000001008.quest_desc: [
		"Use Industrial Foregoing's Dissolution Chamber for Ki Essence Processing. Supply FE, pipe the raw essence into its fluid tank, and add the recipe's solid ingredients."
		""
		"Empty incompatible fluid before changing from Frost to Flame. These recipes use raw Yin or Yang essence, not Liquid Ki or buckets in the item slots."
	]
	quest.6EC6A70000001008.title: "Ki Essence Processing Unit"
	quest.6EC6A70000001009.quest_desc: [
		"Run both Dissolution Chamber recipes: Yin fluid makes Solidified Frost Essence; Yang fluid makes Solidified Flame Essence."
		""
		"Collect eight of each. Reserve some for Harmonized Spirit Pellets as well as the balancing recipes."
	]
	quest.6EC6A70000001009.title: "Solidify Frost and Flame"
	quest.6EC6A7000000100A.quest_desc: [
		"Make a Frozen Clock at time 12000 in the Overworld. In Wildwood, throw a Wildwood Heart into the realm flame and activate it with that clock to reach Apalachia."
		""
		"Establish a return route and gather fragments for an Apalachia Gem. A trained Apalachia Data Model can provide a repeatable fragment supply."
	]
	quest.6EC6A7000000100A.title: "The Apalachian Rift"
	quest.6EC6A7000000100B.quest_desc: [
		"Find and defeat the Eternal Archer in Apalachia. Collect its Eternal Archer Statue and Apalachian Duality Elixir; both are separate quest objectives."
		""
		"The elixir drops once per kill alongside the boss's normal loot and Azure Aging Catalyst. Save it to balance Yin and Yang."
	]
	quest.6EC6A7000000100B.title: "Defeat the Eternal Archer"
	quest.6EC6A7000000100C.quest_desc: [
		"Combine both essence branches with the Apalachian boss material to make Balanced Yin-Yang Essence, following JEI."
		""
		"Save the required amount for your breakthrough before spending extras on the optional condenser."
	]
	quest.6EC6A7000000100C.title: "Balance Yin and Yang"
	quest.6EC6A7000000100D.quest_desc: [
		"Craft two Yin-Yang Breakthrough Catalysts from your balanced materials and pill shells. Keep both for detection."
		""
		"The final IFEU Infuser recipe consumes the pair together; the catalyst itself cannot be eaten for a breakthrough."
	]
	quest.6EC6A7000000100D.title: "Seal the Breakthrough Catalysts"
	quest.6EC6A7000000100E.quest_desc: [
		"Set up Industrial Foregoing's Fluid Laser Base with a Dragon Laser Lens in the End to collect Liquid Dragon Breath. Pipe it to the IFEU Infuser."
		""
		"The requested machine is Industrial Foregoing: Extra Upgrades' Infuser. Bottled Dragon's Breath cannot replace the liquid."
	]
	quest.6EC6A7000000100E.title: "Harvest Dragon Breath"
	quest.6EC6A70000001109.quest_desc: [
		"These optional Tier III Speed and Efficiency upgrades use your duality materials. Install them in a compatible machine's upgrade slots and check its Ki demand afterwards."
		""
		"Ki Vaults have no upgrade slots; increase storage through higher tiers or a vault bank."
	]
	quest.6EC6A70000001109.title: "Duality-Tuned Tier III Upgrades"
	quest.6EC6B70000001001.quest_desc: [
		"Craft Hollow Meridian Vessels from replicated seeds, Astral Meridian Ingots, Spirit Silk and Amethyst. Make at least four."
		""
		"These are consumable item components, not fluid containers. The IFEU Infuser saturates them with Liquid Ki."
		""
		"Each vessel now needs an Unobtainium Ingot from the Woot production chain."
	]
	quest.6EC6B70000001001.title: "Vessels for Living Ki"
	quest.6EC6B70000001002.quest_desc: [
		"In the IFEU Infuser, combine each Hollow Meridian Vessel with 1,000 mB Liquid Ki. Collect four Ki-Saturated Vessels before spending them."
		""
		"Use your earlier Ki Liquefier for the first supply. The optional Heaven-Earth Ki Condenser is not required."
	]
	quest.6EC6B70000001002.title: "Saturate the Meridian Vessels"
	quest.6EC6B70000001003.quest_desc: [
		"Craft Harmonized Spirit Pellets with a Ki-Saturated Vessel and both solidified essences. Each craft gives two pellets; collect eight."
		""
		"Their next step is Dragon-Tempered Pill Shells in the IFEU Infuser. Extra pellets can fuel the condenser's later high-output recipe."
	]
	quest.6EC6B70000001003.title: "Harmony in a Single Pellet"
	quest.6EC6B70000001004.quest_desc: [
		"You can build this machine during Chapter 4. Make the casings in an Extended Crafting Basic Table, then assemble its encoded controller with a Crafting Core and eight pedestals. Follow the controller's JEI structure."
		""
		"Start with a Lesser Ki Crystal, one bucket of Water and 2,000 FE/t: five seconds produces four buckets of Liquid Ki. The crystal is consumed. Fit two Reinforced-or-better energy inputs, one item input, one fluid input and the required Vacuum fluid output hatch."
		""
		"Drain the output into a tank feeding your Scarlet Meridian Forge. The old Liquefier remains useful while building. Greater/Supreme Crystal and Harmonized Pellet recipes remain higher-power upgrades; check their FE/t before switching."
	]
	quest.6EC6B70000001004.title: "Heaven-Earth Ki Condenser"
	quest.6EC6B70000001005.quest_desc: [
		"Infuse each Harmonized Spirit Pellet with 500 mB Liquid Dragon Breath in the IFEU Infuser. Eight shells need eight pellets and 4,000 mB of liquid."
		""
		"Drain leftover Liquid Ki before changing recipes. Save the shells for catalysts; bottled Dragon's Breath is not a substitute."
	]
	quest.6EC6B70000001005.title: "Dragon-Tempered Pill Shells"
	quest.6EC6D70000001001.quest_desc: [
		"Craft a blank Matter Blueprint, then use the Meridian Seed encoding recipe. It produces a fully encoded blueprint, not a seed. Let the quest detect it before transferring it."
		""
		"Connect Chip Storage, matter tanks, a Replicator and Replication Terminal on one working network. Sneak-right-click Chip Storage with the encoded blueprint, then request the physical Meridian Seed from the terminal. No scanned seed is needed."
		""
		"&6Per seed: 1,920 matter&r"
		""
		"Quantum 384 · Precious 768 · Living 512 · Ender 256."
	]
	quest.6EC6D70000001001.title: "Replicate a Meridian Seed"
	quest.6F66841AFB6D806E.quest_desc: ["Craft four Unwritten Dao Seeds in the Ultimate 9×9 Table. They are inputs for the accelerator's particle-collision recipe, not crops."]
	quest.6F66841AFB6D806E.title: "Prepare the Unwritten Dao"
	quest.70AF4B78394B217B.quest_desc: [
		"Craft two Evolved Meridian Lattices in the required large crafting grid and let the task detect both."
		""
		"Use one for the Void-Tempered Dantian and reserve the other for later progression."
	]
	quest.70AF4B78394B217B.title: "Assemble Two Evolved Meridian Lattices"
	quest.71483431FCDD4A30.quest_desc: ["Craft three Samsara Seals using JEI's large-table recipe. Let the task detect all three before using them in later components."]
	quest.71483431FCDD4A30.title: "Close the Three Samsara Seals"
	quest.715BDCF5A629D5A5.quest_desc: [
		"Follow the Immortal Body Crucible's JEI structure. The two fluid inputs and two energy inputs are on the rear wall. Use separate Vacuum fluid inputs or larger for Liquid Ki and Ancestral Dragon Blood. Fit at least one Divine Energy Input Hatch to supply 18,000,000 FE/t."
		""
		"Run the godbody recipe with the Divine Body Embryo and supporting materials."
	]
	quest.715BDCF5A629D5A5.title: "Immortal Body Crucible"
	quest.718671B2E5A114D5.quest_desc: ["Energize one String with 25,000 FE in Powah's Orb to make one Spider Silk. The Spirit Loom turns this into Spirit Silk for the forge chain."]
	quest.73CEA5EF16C34B87.quest_desc: [
		"Create eight Celestial Tribulation Sigils through Draconic Fusion Crafting. Match the required injector tier and ingredients in JEI."
		""
		"Collect the batch before committing it to the Dao Heart chain."
	]
	quest.73CEA5EF16C34B87.title: "Seal Eight Celestial Tribulations"
	quest.7624CE6C62E668EF.quest_desc: [
		"Gather 88 Immortal Bone Casings for the Immortal Body Crucible. Budget additional materials for its controller."
		""
		"After finishing every body recipe you need, empty the machine and recover casings for the final altar if desired."
	]
	quest.7624CE6C62E668EF.title: "Immortal Bone Casings"
	quest.78934EFD0E2EBFFD.quest_desc: [
		"Awaken nine Eternal Embers in the soul-fire Clibano with the Artisan Relic installed. Then craft a Loot Fabricator."
		""
		"Give the Fabricator a successful prediction and FE, and select a compatible loot output. Predictions come from the Simulation Chamber; the Fabricator converts them into loot."
	]
	quest.78934EFD0E2EBFFD.title: "Awaken Nine Eternal Embers"
	quest.79216222DFFF1F89.quest_desc: [
		"Use Oritech's Oracle Index guide to assemble a circular Particle Accelerator with powered motors and a Particle Collector. The task blocks are only part of the complete layout."
		""
		"Confirm that the ring forms and operates before loading your Unwritten Dao Seeds."
	]
	quest.79216222DFFF1F89.title: "Build the Circular Particle Accelerator"
	quest.7B61CF18D0962BE2.quest_desc: [
		"Collect all eight different Twilight Forest trophies shown below, following the dimension's advancement order."
		""
		"Keep them until the tasks register, then reserve the required trophies for the Twilight Sovereign Crest."
	]
	quest.7C64CAAC40C3E127.quest_desc: [
		"Set up a Malum Spirit Altar and its ingredient holders for the prism chain."
		""
		"Craft Soul-Tempering Salt from Mugwort Ash, Alchemical Calx, Pure Salt and Arcane Crystal Dust. Each craft gives four salts; keep a reserve for the prisms and later refinery."
	]
	quest.7C64CAAC40C3E127.title: "Temper the Soul Salts"
	quest.7D828CD8BCC10919.quest_desc: [
		"Craft the encoded Mortum Soul Resonator controller and follow its full JEI structure, including internal blocks and hatches."
		""
		"Supply items through the input bus, Liquid Ki through a fluid hatch and FE through an energy hatch. Match the hatch capacity and power supply to the selected recipe."
	]
	quest.7D828CD8BCC10919.title: "Build the Mortum Soul Resonator"
	quest.7E9856524E1B288C.quest_desc: [
		"In a powered Energizing Orb, combine two Jadeleaf Herbs, one Poisonous Vine and two Nether Quartz. Supply 500,000 FE to make one Venom-Charged Spirit Jade."
		""
		"Process one batch at a time and save the jade for Honeysuckle."
	]
	quest.7EC1A70000001011.quest_desc: [
		"Break leaves with an Ex Deorum Crook to find Silkworms. Use a Silkworm on leaves, let the infestation spread, then harvest the infested leaves with the Crook for String."
		""
		"Keep some uninfested trees for wood and saplings. Use the String to craft your first Sieve mesh."
		""
		"Crooks, Ex Deorum hammers, compressed hammers and Construction Sticks stop working at 1 durability instead of breaking. Repair them with their own material in a crafting grid or anvil; each material restores 25% durability. Wooden crooks accept Sticks or Planks, Bone Crooks use Bones, and wooden hammers use Planks. Names and enchantments are kept."
	]
	quest.7EC1A70000001011.title: "Silkworms and String"
	quest.7EC1A70000001012.quest_desc: [
		"Fill an Oak Crucible with leaves and wait for a bucket of Water. Repeat to fill two opposite corners of a 2×2 hole for an infinite water pool."
		""
		"Save water for Clay and the Porcelain Crucible, as well as your crops."
	]
	quest.7EC1A70000001012.title: "Water from Leaves"
	quest.7EC1A70000001013.quest_desc: [
		"Place a valid heat source below the Thermo Generator, supply Water, and connect Energy Cables to your machines. Check that it is producing FE."
		""
		"Liquid Ki is a stronger heat source when available, but you can start with a simpler heat source."
	]
	quest.7EC1A70000001013.title: "Harness Geothermal Power"
	quest.7EC1A70000001014.quest_desc: [
		"Place Energizing Rods within reach of an Energizing Orb and supply the rods with FE. Put one recipe's ingredients into the Orb."
		""
		"Let the recipe finish and remove its output before adding the next batch. More powered rods, or better rods, charge the Orb faster."
	]
	quest.7EC1A70000001014.title: "Energizing Lasers"
	quest.7EC1A70000001015.quest_desc: [
		"Energize the Niotic Crystal recipe in Powah's Orb. Powered rods must supply the full FE cost shown in JEI; slow progress usually means the setup needs more power."
		""
		"Save two Niotic Crystals for the Martial Warrior pill."
	]
	quest.7EC1A70000001015.title: "Niotic Crystals"
	quest.7EC1A70000001016.quest_desc: [
		"Right-click the cushion to sit, then start meditation from the Cultivation menu. Sneak to stand up."
		""
		"Seated cultivation gains 15% more progress and stacks with the Aether bonus. Place the cushion somewhere safe; simply standing beside it gives no bonus."
	]
	quest.7EC1A70000001016.title: "Cultivation Cushion"
	quest.7EC2A7000000100B.quest_desc: [
		"Enter Iceika after exploring Eden. Mark your arrival point and secure a return route before searching its settlements, workshops and catacombs."
		""
		"Watch for Snowflakes and the custom Poison Spirit Bloom in loot chests. Both are needed in this chapter."
	]
	quest.7EC2A7000000100B.title: "Enter Iceika"
	quest.7EC2A7000000100C.quest_desc: [
		"Gather nine Ice Shards and a Snowflake from Iceika, and smelt an Oxdrite Ingot for the Frozen Clock chain."
		""
		"You can also make three Ice Shards by imbuing an Amethyst Shard with Water Essence, Air Essence, Packed Ice and a Snow Block, using 3,000 Source. Three batches supply one Ice Stone."
	]
	quest.7EC2A7000000100C.title: "Treasures of the Frozen Realm"
	quest.7EC2A7000000100D.quest_desc: [
		"A Frozen Clock remembers the time at which it was made. To make one, throw a normal Clock into Icy Fire in the Overworld at the required time. Read its tooltip before travelling."
		""
		"Eden needs time 6000. This pack also has a crafting recipe for that midday clock: a Clock and four Ice Shards. Use it on Divine Flame in the Overworld."
		""
		"Rifts are temporary. Bring and activate a Waystone, or establish a permanent realm portal before exploring."
		"{@pagebreak}"
		"&6Clocks for the later realms&r"
		""
		"Make each clock in the Overworld, then use it in the preceding realm. Throw that realm's Heart into Divine Flame to transform it before using the clock."
		""
		"Wildwood: time 9000; Eden Heart in Eden."
		""
		"Apalachia: time 12000; Wildwood Heart in Wildwood."
		""
		"Skythern: time 15000; Apalachia Heart in Apalachia."
		""
		"Mortum: time 18000; Skythern Heart in Skythern."
		""
		"These later journeys belong to later chapters. An arbitrary Frozen Clock will not open every rift."
	]
	quest.7EC2A7000000100D.title: "Frozen Clock and the DivineRPG Rift Path"
	quest.7EC2A7000000100E.quest_desc: [
		"Craft the encoded Eden Source Altar controller, then follow its layer-by-layer structure preview in JEI. Fit the listed item buses and Ars Source input hatch in their marked positions."
		""
		"The complete four-layer altar needs 24 Meridian Glass and 39 Eden Planks, plus one each of the controller, Magic Workbench, item input bus, item output bus and Source input hatch. There are 12 glass blocks on each of the two middle layers."
		""
		"Feed items through the input bus and Source through the Source hatch; FE cables cannot supply Source. Keep the output bus clear and your Source farm running."
		""
		"The collection tasks cover the complete build. Tick the checkmark when you have assembled it and the controller reports that the structure is formed."
	]
	quest.7EC2A7000000100E.title: "Build the Eden Source Altar"
	quest.7EC2A7000000100F.quest_desc: [
		"Craft the encoded Ki Liquefier controller and follow its JEI structure preview, including the input, output and energy hatches. A blank controller will not count."
		""
		"Supply the crystal recipe through the item input and collect Liquid Ki from the fluid output. This is a machine fluid, separate from your personal Ki bar."
	]
	quest.7EC2A7000000100F.title: "Liquefy Crystallized Ki"
	quest.7EC3A70000001011.quest_desc: [
		"Defeat a Warden for its Heart of the Deep. In the Overworld, build a vertical 4×5 Reinforced Deepslate frame with an empty 2×3 opening. Right-click the inner edge with the Heart to activate it; the Heart is consumed."
		""
		"Explore the Deep Dark beneath Lost Cities for an Ancient City. The pack also provides a Reinforced Deepslate recipe in JEI if you want to build your own frame."
	]
	quest.7EC3A70000001011.title: "Silence the Warden and Forge the Portal"
	quest.7EC3A70000001012.quest_desc: ["Enter the Otherside through your activated portal and mark the return route. Search for Ice Lilies and Lily Flowers for the Snow Lotus recipe."]
	quest.7EC3A70000001012.title: "Into the Deep Dark"
	quest.7EC3A70000001013.quest_desc: [
		"Craft Snow Lotus from the Otherside flowers shown in JEI and keep one for the final Inscriber recipe."
		""
		"Eating it restores 100 Ki but consumes the flower and gives one minute of Frostbite. Make a spare if you want to use it for recovery."
	]
	quest.7EC3A70000001013.title: "Snow Lotus"
	quest.7EC5A70000001501.title: "Forge the Machine Meridian"
	quest.7EC5A70000001502.title: "Let Liquid Ki Turn the Wheel"
	quest.7EC5A70000001503.quest_desc: ["Crystal Interfaces can both fill and drain the Reservoir."]
	quest.7EC5A70000001503.title: "The Meridian Reservoir"
	quest.7EC5A70000001504.quest_desc: ["Use the same channel: INPUT beside the Ki source, OUTPUT beside the receiving machine. Supreme Interfaces work across dimensions."]
	quest.7EC5A70000001504.title: "Crystals Instead of Cables"
	quest.7EC5A70000001505.quest_desc: ["Works without fuel; output improves in other dimensions, especially Eternal Starlight."]
	quest.7EC5A70000001505.title: "Drink From the Heavens"
	quest.7EC5A70000001506.quest_desc: ["Install upgrades in the GUI's right-hand slots. Only the strongest installed speed bonus applies."]
	quest.7EC5A70000001506.title: "Refine the Formation"
	quest.7EC6101600001001.quest_desc: [
		"Late Chapter 7 luxury: craft the Infinite Data Cell in the 9 x 9 Ultimate Crafting Table after reaching the Skythern Ascension Core."
		"Combine four 256M Data Storage Components, 24 Skythern Starsteel Blocks, four Antimatter Pellets, four Ninefold Dantian Frames, 20 Radiance Alloys, 16 Celestial Meridian Matrices, four Replicated Astral Lattices, four Skythern Ascension Cores and one Data Flow Component Housing."
		"Use storage components, not filled cells. Establish finite Data Flow first; the materials can all be made before Chapter 8 without already owning this cell."
		"The crafted cell supplies unlimited Data Flow, Data and Echo and is pre-stabilized against its native first-acquisition overload. This is an optional branch, not a breakthrough requirement."
	]
	quest.7EC6101600001001.title: "Infinite Data, Finite Preparation"
	quest.7EC7A70000001001.quest_desc: [
		"In the Overworld, throw a Clock into Icy Fire at time 15000. Check its stored time, then take it and a Waystone to Apalachia."
		""
		"Throw an Apalachia Heart into the flame there to create Sky Fire. Right-click that flame with the Frozen Clock to open the temporary Skythern rift."
	]
	quest.7EC7A70000001001.title: "Open the Skythern Rift - Time 15000"
	quest.7EC7A70000001002.quest_desc: [
		"Enter Skythern and establish a return point. Gather fragments for Starsteel and prepare to fight Samek for the soul used in your Ascension Core."
		""
		"Keep access to the earlier realms; their materials still feed this chapter's recipes."
	]
	quest.7EC7A70000001002.title: "Enter Skythern"
	quest.7EC7A70000001003.quest_desc: [
		"Collect Skythern Fragments and craft Skythern Gems. Let both tasks detect before spending them on your material chain."
		""
		"For a renewable supply, train a Skythern Archer Data Model, run it in the Simulation Chamber, then use its successful predictions in the Loot Fabricator. Each fabrication yields 16 Skythern Fragments."
	]
	quest.7EC7A70000001003.title: "Sky-Realm Materials"
	quest.7EC7A70000001004.quest_desc: [
		"Defeat Samek and collect a Skythern Soul. Both the kill and item tasks must complete, so a borrowed soul alone is not enough."
		""
		"Keep the soul for the Skythern Ascension Core."
	]
	quest.7EC7A70000001004.title: "Defeat Samek"
	quest.7EC7A70000001005.quest_desc: [
		"Build and power an Antiprotonic Nucleosynthesizer. Supply Antimatter through its chemical input from Mekanism's SPS production chain."
		""
		"Check the recipe's energy demand before inserting the Ascension Core. Follow Mekanism's guide for reactor cooling and radioactive waste handling."
	]
	quest.7EC7A70000001005.title: "Antimatter Nucleosynthesis"
	quest.7EC7A70000001006.quest_desc: [
		"Combine one Dormant Synthetic Dantian Core with the Skythern ingredients in the required Extended Crafting table."
		""
		"The resulting Ascension Core goes into the Antiprotonic Nucleosynthesizer to make the pill. Leave your second dormant core in storage."
	]
	quest.7EC7A70000001006.title: "Skythern Ascension Core"
	quest.7EC7A70000001010.quest_desc: [
		"Build a Chemical Dissolution Chamber, Chemical Washer, Chemical Crystallizer and Pressurized Reaction Chamber. The first three process resonance slurry; the PRC makes the finished crystal live."
		""
		"Use chemical transport for slurry and gases, fluid pipes for Water, and power cables for FE. Configure each side and provide output space for every byproduct."
	]
	quest.7EC7A70000001010.title: "Build the Resonance Line"
	quest.7EC7A70000001011.quest_desc: [
		"Dissolve Echo Shards with Sulfuric Acid to make Raw Resonance Slurry. Wash it with Water, then crystallize the Clean Resonance Slurry into Meridian Crystals."
		""
		"Keep raw and clean slurry separate. Only the washed slurry belongs in the Crystallizer."
	]
	quest.7EC7A70000001011.title: "Crystallize Artificial Meridians"
	quest.7EC7A70000001012.quest_desc: [
		"Put a Meridian Crystal, Water and Ethene into the Pressurized Reaction Chamber. It produces a Living Meridian Crystal and Oxygen; give both outputs somewhere to go."
		""
		"For Spirit Meridian Essence, oxidize the living crystals into Qi Vapor, combine it with Polonium in the Chemical Infuser, then condense the Stabilized Qi in the Rotary Condensentrator."
		""
		"Polonium goes through the chemical input, not an item slot. The final one-way conversion is 1:1 and outputs a fluid."
	]
	quest.7EC7A70000001012.title: "Teach the Crystal to Live"
	quest.7EC7A70000001014.quest_desc: [
		"Make the Osmium Dantian, Refined Obsidian Dantian and Living Meridian singularities. The Chapter 6 Singularity Compression Chamber uses 5,000 matching items per singularity. The original Quantum Compressor recipes remain available; its Living Meridian recipe is cheaper at 512 crystals. Match the named variant in JEI."
		""
		"Automate Living Meridian Crystals before attempting that singularity; the demonstration batches are only the start."
	]
	quest.7EC7A70000001014.title: "Three Industrial Singularities"
	quest.7EC7A70000001015.quest_desc: [
		"Craft two Dormant Synthetic Dantian Cores in the table shown in JEI, using the industrial singularities and frames. Let the task detect both."
		""
		"Use one for the Skythern Ascension Core and reserve the other for Chapter 8."
	]
	quest.7EC7A70000001015.title: "Twin Dormant Dantians"
	quest.7EC7A70000001020.quest_desc: [
		"Craft the encoded Celestial Meridian Weaver controller and follow every layer of its JEI structure. Match its item buses, fluid hatches, energy inputs and internal blocks."
		""
		"&eUse a Celestial or Divine Energy Input Hatch. Standard tiers, including Ultimate, cannot supply these recipes.&r Fill both energy-input positions and connect your power to the custom hatch."
		""
		"Recipes draw 2,000,000–3,000,000 FE/t. Check the selected recipe against your hatch, cables and available energy. Items and fluids enter through their own ports, not the controller."
	]
	quest.7EC7A70000001020.title: "Celestial Meridian Weaver"
	quest.7EC7A70000001021.quest_desc: [
		"Run the Starsteel recipe in the Celestial Meridian Weaver with its items and Spirit Meridian Essence. Each batch yields two ingots, so four batches supply this task."
		""
		"Make extra for Starsteel Blocks used by larger recipes. Each block takes nine ingots."
	]
	quest.7EC7A70000001021.title: "Weave Skythern Starsteel"
	quest.7EC7A70000001022.quest_desc: [
		"Use the Weaver's thread recipe with Liquid Ki and its listed items. Four batches produce the sixteen Heavenwoven Meridian Threads needed here."
		""
		"This recipe uses Liquid Ki, not the Spirit Meridian Essence used for Starsteel."
	]
	quest.7EC7A70000001022.title: "Heavenwoven Meridians"
	quest.7EC7A70000001023.quest_desc: [
		"Produce two Ninefold Dantian Frames in the Celestial Meridian Weaver. Supply the physical Astral Lattices and Celestial Meridian Matrices made by your Replication and Data Reassembler lines."
		""
		"Each frame belongs in a Dormant Synthetic Dantian Core."
	]
	quest.7EC7A70000001023.title: "Ninefold Dantian Frames"
	quest.7EC7B70000001001.quest_desc: [
		"Use the IFEU Infuser to combine a Ki-Saturated Vessel with 1,000 mB Spirit Meridian Essence. Repeat four times for this task."
		""
		"Living Spirit Reservoirs are crafting components, not storage blocks. Supply the condensed essence fluid, not Stabilized Qi chemical."
	]
	quest.7EC7B70000001001.title: "Awaken the Spirit Reservoir"
	quest.7EC7D70000001001.quest_desc: [
		"Craft the encoded Astral Lattice blueprint in the Advanced 5×5 Table and let the quest detect it. Sneak-right-click Chip Storage with it, then request four physical Lattices from your Replication Terminal."
		""
		"Each Lattice costs 15,360 matter: 3,072 Quantum, 6,144 Precious, 4,096 Living and 2,048 Ender. Stock four times those amounts for this task. No scanned sample is needed."
	]
	quest.7EC7D70000001001.title: "Replicate the Astral Lattice"
	quest.7EC7DF0000001001.quest_desc: [
		"Connect a powered Data Extractor, Data Flow Storage Cell and Data Reassembler to the same online ME network. Feed the Extractor an ingredient from its JEI recipe category to generate Data Flow."
		""
		"Check the stored amount before using the Reassembler. Data Flow is its own resource; ordinary item-storage bytes, FE and Liquid Ki cannot replace it."
	]
	quest.7EC7DF0000001001.title: "A Flow of Living Data"
	quest.7EC7DF0000001002.quest_desc: [
		"Make four Celestial Meridian Matrices in the Data Reassembler using the listed items and Data Flow from your ME network. Reserve them for the Ninefold Dantian Frames."
		""
		"Encode this as a processing recipe for the Reassembler, not a crafting recipe for a Molecular Assembler."
	]
	quest.7EC7DF0000001002.title: "Celestial Meridian Matrix"
	quest.7EC8D70000001001.quest_desc: [
		"Craft the encoded Void Mandala blueprint in the Elite 7×7 Table. Let the quest detect it, transfer it to Chip Storage and request the Mandala from your Replication Terminal."
		""
		"One Mandala costs 61,440 matter: 12,288 Quantum, 24,576 Precious, 16,384 Living and 8,192 Ender. Each type must be available; surplus matter of another type cannot replace it."
	]
	quest.7EC8D70000001001.title: "Replicate the Void Mandala"
	quest.7EC9D70000001001.quest_desc: [
		"Craft the encoded Ancestral Genome blueprint in the Elite 7×7 Table, using Void Mandalas and the dragonheart materials. After detection, transfer it to Chip Storage and replicate four Genomes."
		""
		"Each costs 245,760 matter: 49,152 Quantum, 98,304 Precious, 65,536 Living and 32,768 Ender. Multiply those amounts by four for the full task."
	]
	quest.7EC9D70000001001.title: "Reconstruct the Ancestral Genome"
	quest.7EC9D71100001001.quest_desc: [
		"Craft the encoded Sovereign Mandate blueprint in the required large table. After detection, transfer it to Chip Storage and request the physical Mandate."
		""
		"It costs 983,040 matter: 196,608 Quantum, 393,216 Precious, 262,144 Living and 131,072 Ender. Connect sufficient storage for each type to the same Replication network."
	]
	quest.7EC9D71100001001.title: "Replicate the Sovereign Mandate"
	quest.7EC9D71100001002.quest_desc: [
		"Run the Primordial Regenerator's Awakened Dragon Marrow recipe with its ancestral inputs and 32,000 mB Ancestral Dragon Blood."
		""
		"One operation gives two marrows. Reserve both for the Martial Sovereign pill."
	]
	quest.7EC9D71100001002.title: "Awaken the Dragon Marrow"
	quest.7ECAD70000001001.quest_desc: [
		"Complete the four guardian covenants with your sect master. Combine one Celestial Beast, Phoenix, Tidal and Xuanwu imprint into a Four Guardians Seal for the center of the Genesis Dao blueprint. The hunts require at most Martial Sovereign."
		""
		"Craft the encoded blueprint in the Ultimate 9×9 Table, let the task detect it, then transfer it to Chip Storage. Replicate four Genesis Dao for the final pill."
		""
		"Each costs 7,864,320 matter: 1,572,864 each of Quantum, Precious, Living, Ender and Metallic. Stock four times those amounts and enough connected tank capacity."
	]
	quest.7ECAD70000001001.title: "Replicate the Laws of Creation"
	quest.7ED69205B4576644.quest_desc: [
		"Combine a Mortum Evolved Core, Evolved Meridian Lattice and Exoversal Alloy in the Evolved Mekanism Alloyer. Supply its required FE."
		""
		"Keep the Void-Tempered Dantian for the Martial Supreme pill; it is not itself a breakthrough item."
	]
	quest.7ED69205B4576644.title: "Temper the Dantian in the Void"
	quest.8C08100000000001.quest_desc: [
		"The Energizing Orb can now make Allthemodium without hunting for its ore. Charge two Gold Ingots, a Netherite Ingot, Hallowed Gold, a Greater Ki Crystal and an Eden Fragment with 250,000 FE. You get two ingots."
		""
		"Use an ingot in the Basic Crafting Table to make 16 Heaven-Earth Condenser Casings. Three batches cover the 38 casings in the structure and four in its controller recipe."
		""
		"The later block-based Orb recipe produces 18 ingots at once. It saves handling time, not gold or netherite."
	]
	quest.8C08100000000001.title: "The First Golden Meridian"
	quest.8C08100000000002.quest_desc: [
		"Make Vibranium in the Ender Crafter from Allthemodium, Ender Ingots, Starlit Diamonds and a Supreme Ki Crystal. Place Ender Alternators around the crafter to speed it up."
		""
		"The recipe makes two ingots. Keep a pair for each batch of Astral Meridian Ingots in Draconic Fusion Crafting. Your earlier boss discoveries still matter."
	]
	quest.8C08100000000002.title: "A Meridian Between Worlds"
	quest.8C08100000000003.quest_desc: [
		"Feed a Vibranium Ingot and a Woot Netherite Shard into the Woot Item Infuser. Four buckets of Enchanted Fluid and 1,000,000 FE turn them into one Unobtainium Ingot. Both ingredients are consumed."
		""
		"Woot factories supply the shard; its Enchantment Liquefier supplies the fluid from enchanted books. Use the Item Infuser for the final step, not the Factory Heart."
		""
		"Unobtainium now anchors each Hollow Meridian Vessel. Craft and collect an ingot before turning it into a vessel."
	]
	quest.8C08100000000003.title: "Tempered by the Factory"
	quest.8C08100000000004.quest_desc: [
		"Train a Hostile Neural Networks Data Model to Self-Aware. The model is a reusable selector: it stays in the input bus, keeping its training and name. Use one model at a time."
		""
		"Each ten-second batch uses one Prediction Matrix, 250 mB Liquid Ki and 4,096 FE/t to make four Malum spirits. Lower-tier models and predictions do not work."
		""
		"Zombie: Wicked. Skeleton: Arcane. Slime: Earthen. Guardian: Aqueous. Blaze: Infernal. Ghast: Aerial. Cow: Sacred. Enderman: Eldritch."
		""
		"Make two Soul Imprint Focuses in the Flux Crafter, powering nearby Flux Alternators with FE. Then use a Crafting Core and eight pedestals for the controller."
		""
		"Build the symmetric 5x5, four-layer chamber from its JEI preview. It has one item input, one item output, one Liquid Ki input and two Reinforced-or-better energy inputs."
		""
		"The first spirits and Unrefined Spirit Prisms still come from normal Malum play. This machine automates the ongoing supply; it does not replace your first discoveries."
	]
	quest.8C08100000000004.title: "Soul Imprint Chamber"
	quest.8C08100000000005.quest_desc: [
		"Occultism miners can now find Deepslate Replica Ore. Place a bound miner in a Dimensional Mineshaft; ordinary ore miners and the Ancient Eldritch miner both have a weighted chance to bring it back."
		""
		"It is an uncommon result, not a guaranteed drop per cycle. Process the ore using the recipes shown in JEI to supply your Replication machines and Meridian Seed blueprints."
	]
	quest.8C08100000000005.title: "Ore Beyond the World"
	quest.8C08200000000001.quest_desc: [
		"Use the Basic Crafting Table to weave Spirit Silk into a Hallowed Gold frame. One recipe makes four Meridian Lattices."
		""
		"Each lattice can turn eight Tinted Glass into sixteen Meridian Glass in the same table. Keep the rest for Geode Seed Matrices and Growth Cores. The ordinary glass recipe remains available."
	]
	quest.8C08200000000001.title: "Weaving a Meridian Lattice"
	quest.8C08200000000002.quest_desc: [
		"Combine amethyst, Ender Ingots, two Meridian Lattices and a Lesser Ki Crystal in an Ender Crafter. You get two Geode Seed Matrices."
		""
		"Place Ender Alternators near the crafter to speed up its work. This step uses time, not FE. The Lesser Crystal is consumed here; a crystal placed in the finished Nursery is not."
	]
	quest.8C08200000000002.title: "Stabilizing the Seed"
	quest.8C08200000000003.quest_desc: [
		"The Flux Crafter combines two Seed Matrices, two Lattices, four Redstone Blocks and a Greater Ki Crystal into two Resonant Growth Cores. Supply 250,000 FE through nearby Flux Alternators."
		""
		"Use both cores for the Nursery controller. More cores let the Flux Crafter produce eight Scarlet Meridian Threads per batch from four Spirit Silk and four Meridian Binding Resin, using 2,000,000 FE."
		""
		"In early Chapter 5, a core also enables a two-lens batch in Combination Crafting. It still needs Fluix Pearls, Greater Ki Crystals, Astral Weave and Unrefined Spirit Prisms; the total energy is 8,000,000 FE. The original Energizing Orb recipes remain available."
	]
	quest.8C08200000000003.title: "Charging a Growth Core"
	quest.8EC2A70000001011.quest_desc: [
		"Search unopened dungeon, hut, Groglin Village, and Gruzzorlug Village chests throughout Iceika."
