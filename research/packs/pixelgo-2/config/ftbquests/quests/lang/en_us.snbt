	quest.781B1B9C4BE3BE55.quest_desc: ["{quest.minions.description.16}"]
	quest.781B1B9C4BE3BE55.title: "{quest.minions.title.17}"
	quest.78B323245FFEC53B.quest_desc: [
		"&7The Infuser is the first real machine of &bMekanism&7, and the gateway to every other one. It takes an item and a &nchemical&r&7, and gives back something better."
		""
		"&6&lWhy it matters here&r"
		"&7It is what turns Pixelmon vitamins into &fAdd EV&7 and &fAdd IV&7 items — the hearts of the &6PixelGO&7 effect balls. Redstone infusion for EVs, diamond infusion for IVs."
		""
		"&e&lTip:&r &7Feed it &cRedstone&7 to fill its chemical tank. One block of redstone is worth ten dusts."
	]
	quest.78B323245FFEC53B.quest_subtitle: "&7Mekanism starts here, and so do the balls"
	quest.78B323245FFEC53B.title: "&b&lThe Metallurgic Infuser"
	quest.78BCB91742B6B5F4.quest_desc: [
		"&7The &6PixelGO Minions&7 mod adds &f11 enchantments&7 for farming and mining tools. None of them appears in an enchanting table, and none can be bought: they are &nbuilt&r&7, out of the very resources your minions pile up."
		""
		"&6&lThe three tiers&r"
		"&7- &aAdvanced Table&7 (5x5) — the two common books."
		"&7- &bElite Table&7 (7x7) — the four rare books."
		"&7- &dElite Table + Enchanted Mithril&7 — the five rarest."
		""
		"&e&lTip:&r &7One enchanted item = &f160 base resources&7. Get the minions running on the right resource &nbefore&r&7 opening a recipe."
	]
	quest.78BCB91742B6B5F4.quest_subtitle: "&7Eleven enchantments the vanilla table will never give you"
	quest.78BCB91742B6B5F4.title: "&6&lThe Minion Grimoire"
	quest.78C1271D0678127F.quest_desc: ["{quest.kanto.description.2}"]
	quest.78C25F5F1EFC72E1.quest_subtitle: "&7Catch &f&l50&r&7 Rock-type Pokémon"
	quest.78C25F5F1EFC72E1.title: "&e&lRock Collector"
	quest.7912927FF29427F1.quest_desc: [
		"&7The caught Pokémon has &f31 Speed IV&7 — the maximum. IVs cannot be trained away or improved without Hyper Training, so this is permanent perfection on one stat."
		""
		"&7&fAdd IV SPEED&7 costs &f4 Carbos&7 and a &bdiamond infusion&7 in the Metallurgic Infuser. Two per batch of three lids."
		""
		"&e&lTip:&r &7Catch the same species repeatedly with different IV balls and breed the results — the &fDestiny Knot&7 passes five IVs down."
	]
	quest.7912927FF29427F1.quest_subtitle: "&7A perfect 31, guaranteed"
	quest.7912927FF29427F1.title: "&e&lIV Speed Ball"
	quest.7931C133B2FED77A.quest_desc: ["{quest.minions.description.3}"]
	quest.7931C133B2FED77A.title: "{quest.minions.title.4}"
	quest.7957CFD388B13419.quest_desc: [
		"&7The first time you join you choose a &a&lTrainer&r&7 look and a background. That is the Origins screen, and it is &n&lpurely cosmetic&r&7 - no skill, no stat, no penalty, no wrong answer."
		""
		"&f&lO &8- &7look at your choice again"
		""
		"&e&lWHILE WE ARE ON KEYS"
		"&f&lK &8- &7the &a&lskill tree&r&7 &8- &7and the &5&lProjectE&r&7 tablet, much later, if you wear one"
		"&f&lN &8- &7the &b&lPokeNav&r&7, once you own one"
		"&f&lB &8- &7open your &6&lSophisticated Backpack&r&7, once you own one"
		"&f&lMiddle click &8- &7sort any inventory, anywhere"
		"&f&l[ &7and &f&l] &8- &7move a whole inventory in or out of a container"
		""
		"&7&oPick a look you like and get back to the island."
	]
	quest.7957CFD388B13419.quest_subtitle: "&7And a handful of other keys"
	quest.7957CFD388B13419.title: "&3&lYour Trainer"
	quest.79914D587EAE8140.quest_desc: ["{quest.kanto.description.9}"]
	quest.79914D587EAE8140.quest_subtitle: "{quest.kanto.subtitle.2}"
	quest.79914D587EAE8140.title: "{quest.kanto.title.6}"
