	quest.628AD12BCDE55F0C.title: "{quest.johto.title.2}"
	quest.6295A213F651A6C2.quest_desc: [
		"&e&lCHECK FIRST"
		"&b/pixelvalue &8- &7what is the stack in my hand worth? Free, and it tells you &obefore&r&7 you commit."
		""
		"&e&lTHEN SELL"
		"&b/pixelsell &8- &7sells the stack in your hand"
		"&b/pixelsell all &8- &7sells every sellable item you are carrying"
		""
		"&7The &a&lSell&r&7 button on your inventory screen does the same as &b/pixelsell all&7, and asks you to confirm first."
		""
		"&c&lWhat has no price cannot be sold. &7If the game tells you an item has no listed price, then no shop in the pack buys it - there is no second place to try."
		""
		"&7&oPrices come from the shops themselves. If a shop sells it, that shop buys it back, for less."
	]
	quest.6295A213F651A6C2.quest_subtitle: "&7Three ways, one price list"
	quest.6295A213F651A6C2.title: "&e&lSelling Anything"
	quest.62AA1F4E13ACF11C.quest_desc: ["{quest.sinnoh.description.3}"]
	quest.62F3B5752AA88892.quest_desc: [
		"&72 &fGlider Wings&7 (&8Dark Steel&7 + &fLeather&7) and one &8Dark Steel Ingot&7."
		""
		"&7Worn in the &6back slot&7: hold &fjump&7 while falling to glide. On a skyblock, this is your safety net."
	]
	quest.62F3B5752AA88892.quest_subtitle: "&7Dark Steel wings"
	quest.62F3B5752AA88892.title: "&d&lThe Glider"
	quest.635A6037AF448546.quest_desc: [
		"&7Ore into dust, dust into more ingots. On a skyblock, where every block of stone is sieved by hand, doubling is not a luxury — it is the difference between a Poké Ball and no Poké Ball."
		""
		"&e&lTip:&r &7It is also the machine that makes &fEnriched Redstone&7 and &fEnriched Diamond&7, the two chemicals the Infuser above runs on."
	]
	quest.635A6037AF448546.quest_subtitle: "&7Doubles your ore, and your patience"
	quest.635A6037AF448546.title: "&b&lThe Enrichment Chamber"
	quest.6365E38FDC55CF7C.quest_desc: [
		"&7Harvests crops and blocks without shattering them — the minion tool version of Silk Touch."
		""
		"&e&lTip:&r &7The book comes out at &fDelicate I&7 — the maximum level — straight from the table. Cheaper copies also drop from &6Mystery Boxes&7."
	]
	quest.6365E38FDC55CF7C.quest_subtitle: "&7Break it whole, or not at all"
	quest.6365E38FDC55CF7C.title: "&a&lDelicate I"
