	quest.31F1B9D035726B48.title: "&5&lDragon Collector"
	quest.32268051ABA54B7A.quest_desc: [
		"&7Harvesting one crop harvests the neighbours in a growing radius."
		""
		"&e&lTip:&r &7The book comes out at &fCrop Fever V&7 — the maximum level — straight from the table. Cheaper copies also drop from &6Mystery Boxes&7."
	]
	quest.32268051ABA54B7A.quest_subtitle: "&7The whole field at once"
