	quest.49AFEE5A6559E9B3.quest_desc: [
		"&7The caught Pokémon has &f31 Sp. Defence IV&7 — the maximum. IVs cannot be trained away or improved without Hyper Training, so this is permanent perfection on one stat."
		""
		"&7&fAdd IV SP. DEFENCE&7 costs &f4 Zinc&7 and a &bdiamond infusion&7 in the Metallurgic Infuser. Two per batch of three lids."
		""
		"&e&lTip:&r &7Catch the same species repeatedly with different IV balls and breed the results — the &fDestiny Knot&7 passes five IVs down."
	]
	quest.49AFEE5A6559E9B3.quest_subtitle: "&7A perfect 31, guaranteed"
	quest.49AFEE5A6559E9B3.title: "&b&lIV Sp. Defence Ball"
	quest.49C9CCA849B94243.quest_desc: ["{quest.ae2.description.11}"]
	quest.49CA8B80AA6D13FD.quest_desc: [
		"&7A cobble generator is a single block that produces cobblestone on its own, far faster than the old water and lava trick."
		""
		"&e&lUPGRADE LADDER"
		"&f&lWooden &8> &7&lStone &8> &f&lIron &8> &6&lGold &8> &b&lDiamond &8> &a&lEmerald &8> &8&lNetherite"
		""
		"&7You do not rebuild to go up a tier. You apply a &a&lcobble gen upgrade&r&7 to the generator where it stands."
		""
		"&7Point the output at a &d&lMinion&r&7, a compactor or a row of furnaces and you have the foundation of every machine in the pack."
	]
	quest.49CA8B80AA6D13FD.quest_subtitle: "&7Stop building water and lava"
	quest.49CA8B80AA6D13FD.title: "&7&lEndless Cobblestone"
