	quest.47094704FF2B7E83.quest_desc: ["&7Evolves at level &f&l40&r&7"]
	quest.47153CD891BC3037.quest_desc: [
		"&5&lEnder IO&r is built on a dust that has no crafting recipe at all: &d&lGrains of Infinity&r."
		""
		"&6&lThe skyblock way: the Sieve&r"
		"&7- Hammer &fCobblestone&7 into &fGravel&7, &fGravel&7 into &fSand&7, then &fSand&7 into &f&lDust&r&7."
		"&7- Sieve that &fDust&7 with any mesh and the grains drop straight out."
		"&7- Chance per mesh: &fString &a6%&7, &fFlint &a7%&7, &fIron &a9%&7, &6Gold &a11%&7, &bDiamond &a12%&7, &8Netherite &a13.5%&7."
		""
		"&6&lThe Ender IO way: Fire Crafting&r"
		"&7Light a fire on top of &fDeepslate&7 in the &fOverworld&7. When it burns out the block turns into &fCobblestone&7 and drops the dust. (&e40%&7)"
		"&7On &fBedrock&7 it is &a80%&7 for &a1-3&7 dust, and the block is never consumed."
		""
		"&e&lTip:&r &7Feed a &6Compressed Sieve&7 with &6Compressed Dust&7 to mass produce them: one block is sieved as &a7 dusts&7 at once."
	]
	quest.47153CD891BC3037.quest_subtitle: "&7No recipe, no ore - sieve it or burn it"
	quest.47153CD891BC3037.title: "&a&lGrains of Infinity"
	quest.472BD8EC0FDFE286.quest_desc: ["&7&d&lIvysaur&r&7 evolves at level &f&l32&r&7"]
	quest.472BD8EC0FDFE286.quest_subtitle: "Level Up"
	quest.473D3678B8871016.quest_desc: [
		"&7Dungeon Pokemon do not wait politely. Come within &c&l7 blocks&r&7 of one and it attacks - the battle starts on the spot."
		""
		"&7Chat names it first: &o&7A wild Gyarados blocks your path."
		""
		"&e&lELITE GUARDS"
		"&7From rank &7&lD&r&7 upward, some of the Pokemon in a room are &6&lelites&r&7 - visibly larger, and a real step up from the rest."
		""
		"&7&l- &d&lS&r&7 puts &f&l4&r&7 of them between you and the boss"
		"&7&l- &c&lSS&r&7 puts &f&l5"
		"&7&l- &6&lSSS&r&7 puts &f&l6"
		"&7&l- &4&lDEMON&r&7 puts &f&l7&r&7, and every one of them is a Legendary"
		""
		"&a&lThey can all be caught. &7A Gate is one of the best places in the pack to fill a Pokedex, because the level range is guaranteed and the spawns are dense."
	]
	quest.473D3678B8871016.quest_subtitle: "&7They see you at seven blocks"
