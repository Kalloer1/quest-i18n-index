		""
		"&e&lTeam:&r &fCradily&7, &fTangrowth&7, &fLilligant&7, &fBrambleghast"
		"&7IVs of &f&l20&r&7 in every stat, levels scaled to your strongest Pokémon."
		""
		"&7Beating them also pays &6&l800&r&7 PokéDollars. They won't battle you again for &f&l20 hours&r&7."
	]
	quest.7C2F5981C689FA9A.quest_subtitle: "&bTidal Spire &8- &7Floor 4"
	quest.7C4227C8ED5D0F0F.quest_desc: ["{quest.ae2.description.50}"]
	quest.7C58DE7ECA9FB023.quest_desc: ["&7&d&lRaboot&r&7 evolves at level &f&l35&r&7"]
	quest.7C58DE7ECA9FB023.title: "Evolve or Catch"
	quest.7C66F2FB4A45345C.quest_desc: [
		"{image:kubejs:textures/ftbquests/emc1.png width:100 height:100 align:1}"
		"&7To start generating your first EMC"
	]
	quest.7CA3EE0F1865A813.quest_desc: [
		"&7The dungeon is a set of rooms joined by corridors, cut from blackstone, deepslate and nether brick, lit by froglights and glowstone."
		""
		"&e&lTHREE KINDS OF ROOM"
		"&a&lStart &8- &7where the Gate puts you down"
		"&c&lCombat &8- &7Pokemon waiting for you"
		"&5&lBoss &8- &7the end of the run"
		""
		"&7The higher the rank, the more combat rooms and the more Pokemon in each. A rank &8&lE&r&7 has one or two rooms and five Pokemon. A rank &4&lDEMON&r&7 has up to &f&lten&r&7 rooms and &f&ltwenty eight&r&7 Pokemon."
		""
		"&7The Gate itself grows with the rank too - &f&l3&r&7 blocks tall at &8&lE&r&7, &f&l10&r&7 at &4&lDEMON&r&7. You can read the rank off the portal before you touch it."
		""
		"&7&oThe layout is generated fresh every time. There is no map to learn and no route to memorise."
	]
	quest.7CA3EE0F1865A813.quest_subtitle: "&7Rooms, corridors, no map"
	quest.7CA3EE0F1865A813.title: "&8&lInside the Dungeon"
	quest.7CB678547AC73D22.quest_desc: ["{quest.alola.description.3}"]
	quest.7CC927ED2F2FCC2C.quest_desc: [
		"&7Whatever you catch arrives with a &nmaxed&r&7 Sp. Defence EV spread: &f252&7 points, the per-stat cap."
		""
		"&7&fAdd EV SP. DEFENCE&7 comes from &fZinc&7 — the vitamin that trains this exact stat — infused with redstone in the &bMetallurgic Infuser&7. Pixelmon feeds Mekanism, Mekanism makes the ball."
		""
		"&e&lTip:&r &7EVs are capped at &f510 total&7. Two maxed stats is the whole budget — pick the two that matter and do not waste a third ball."
	]
	quest.7CC927ED2F2FCC2C.quest_subtitle: "&7252 EVs, the instant it is caught"
	quest.7CC927ED2F2FCC2C.title: "&b&lEV Sp. Defence Ball"
	quest.7D3137BD1580A6E6.quest_desc: ["&7After the bell is placed on the underside of a block, each dawn of the Minecraft day cycle, the bell will have a &f&l1&r&7% chance to begin ringing and glowing. When the bell activates the bell will have a guaranteed spawn for its respective legendary when the day reaches dusk"]
	quest.7D33B1E9F3A7C8FC.quest_desc: ["{quest.ae2.description.13}"]
	quest.7D370C49247374DA.quest_desc: ["{quest.ae2.description.24}"]
	quest.7D370C49247374DA.title: "Crafter"
	quest.7D79EBB46C7405B0.quest_desc: ["{quest.johto.description.9}"]
	quest.7D79EBB46C7405B0.title: "{quest.johto.title.2}"
	quest.7DE542F915D39386.quest_desc: [
		"&7Your island is small on purpose. Everything you will ever need can be made from what is already on it. The only trick is knowing what turns into what."
		""
		"&e&lTHE THREE THINGS YOU NEED FIRST"
		"&f1. &7A &a&lcobblestone generator&r&7 for infinite stone."
		"&f2. &7A &a&lsieve&r&7 to turn dirt, sand and gravel into ores and seeds."
		"&f3. &7A &a&lcrucible&r&7 to melt wood into lava, or stone into water."
		""
		"&7The chapter &e&lThe beginning&r&7 walks you through all three, step by step."
		""
		"&c&lDo not throw your dirt away. &7Cobblestone is infinite. Dirt is not, until the sieve is running."
	]
	quest.7DE542F915D39386.quest_subtitle: "&7Everything starts on this rock"
	quest.7DE542F915D39386.title: "&a&lYour Island"
	quest.7E1C496C54F39A49.quest_desc: [
		"&7Awarded by &f&lPiccolo&r&7, &oNamekian Tactician&r&7."
		"&7Found in the &6&lSolaris Spire&r&7, on &f&lfloor 4&r&7 of 7."
		""
		"&e&lTeam:&r &fVenusaur&7, &fCacturne&7, &fSerperior&7, &fTsareena"
		"&7IVs of &f&l20&r&7 in every stat, levels scaled to your strongest Pokémon."
		""
		"&7Beating them also pays &6&l700&r&7 PokéDollars. They won't battle you again for &f&l20 hours&r&7."
	]
	quest.7E1C496C54F39A49.quest_subtitle: "&6Solaris Spire &8- &7Floor 4"
	quest.7E74CD3DBCD0A57C.quest_desc: [
		"&7&oA season of work, folded into a single item.&r"
		""
		"&6&lWhy the pack uses them&r"
		"&c&lNo merchant sells these.&r &7They can only come out of your own field — which is exactly what makes them proof of work."
		""
		"&7Any raw crop counts: &awheat&7, &6carrot&7, &6potato&7, &aseeds&7, &amelon slice&7, &6pumpkin&7, &acane&7, &acactus&7, &6cocoa&7, &cmushroom&7, &cnether wart&7."
	]
	quest.7E74CD3DBCD0A57C.quest_subtitle: "&8A season of work in one item"
	quest.7E74CD3DBCD0A57C.title: "&b&lThe Enchanted Crop"
	quest.7EF2C9FFD6EF51F8.quest_desc: [
		"&7Catch rate &6x2&7 on everything."
		""
		"&e&lTip:&r &7When no situational ball applies, this is the answer."
	]
