	quest.1ECDA6495A0381B4.quest_desc: ["{quest.fossils.description.16}"]
	quest.1EEBF142EAB37295.quest_subtitle: "&7Catch &f&l50&r&7 Dark-type Pokémon"
	quest.1EEBF142EAB37295.title: "&5&lDark Collector"
	quest.1FA7945A456BBF70.quest_desc: ["&7Evolves at level &f&l39&r&7 during the night"]
	quest.1FB37577B2AA4ABF.quest_desc: [
		"&7Awarded by &f&lKen Kaneki&r&7, &oOne-Eyed Ghoul&r&7."
		"&7Found in the &5&lUmbral Spire&r&7, on &f&lfloor 5&r&7 of 7."
