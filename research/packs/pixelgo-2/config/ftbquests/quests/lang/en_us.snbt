	]
	quest.1D2BAE4EB8A46658.quest_desc: ["&7The tier above the &fFeather Ball&7: even more range and speed on the throw."]
	quest.1D2BAE4EB8A46658.quest_subtitle: "&7Hisui — flies further"
	quest.1D2BAE4EB8A46658.title: "&b&lWing Ball"
	quest.1DDAA51E9EC05C22.quest_desc: [
		"&7Awarded by &f&lKrillin&r&7, &oTurtle School Veteran&r&7."
		"&7Found in the &6&lSolaris Spire&r&7, on &f&lfloor 4&r&7 of 7."
		""
		"&e&lTeam:&r &fHitmonchan&7, &fMedicham&7, &fGigalith&7, &fFalinks"
		"&7IVs of &f&l20&r&7 in every stat, levels scaled to your strongest Pokémon."
		""
		"&7Beating them also pays &6&l700&r&7 PokéDollars. They won't battle you again for &f&l20 hours&r&7."
	]
	quest.1DDAA51E9EC05C22.quest_subtitle: "&6Solaris Spire &8- &7Floor 4"
	quest.1E7706CC9BD2D8D4.quest_desc: ["&7&d&lThwackey&r&7 evolves at level &f&l35&r&7"]
	quest.1E7706CC9BD2D8D4.title: "Evolve or Catch"
	quest.1E78D146165A9369.quest_desc: ["&7&d&lDartrix&r&7 evolves at level &f&l34&r&7"]
	quest.1E78D146165A9369.title: "Evolve or Catch"
	quest.1E798A5D78B41F05.quest_desc: [
		"&7The Combiner welds two stacks together and hands back finished balls — no bench, no player."
		""
		"&6&lThe detail that makes this possible&r"
		"&7Its main slot accepts a &f&lstrict component ingredient&r&7, so it can tell an &eUltra Ball&7 lid from a &5Master Ball&7 lid. A machine that ignored components would happily take your rarest lid and give back a Poké Ball."
		""
		"&6&lWhich route should you use?&r"
		"&7- &e&lBench&r&7 — cheaper, but by hand."
		"&7- &b&lCombiner&r&7 — costs a little more, but it runs while you sleep."
		""
		"&e&lTip:&r &7160 base resources per enchanted item. The strong balls are a minion problem long before they are a machine problem."
	]
	quest.1E798A5D78B41F05.quest_subtitle: "&7The assembly, without you"
	quest.1E798A5D78B41F05.title: "&b&lRoute 2 — The Combiner"
	quest.1EA5C1B3B819BF82.quest_desc: [
		"&7Awarded by &f&lTanjiro Kamado&r&7, &oTower Master&r&7."
		"&7Found in the &b&lTidal Spire&r&7, on &f&lfloor 7&r&7 of 7."
		""
		"&e&lTeam:&r &fLapras&7, &fMamoswine&7, &fAvalugg&7, &fBaxcalibur"
		"&7IVs of &f&l31&r&7 in every stat, levels scaled to your strongest Pokémon."
		""
		"&7Beating them also pays &6&l1250&r&7 PokéDollars. They won't battle you again for &f&l20 hours&r&7."
	]
