	quest.466152E3A665F0DF.quest_desc: [
		"&7&oFifteen hours of wheat, for four squares of woven iron.&r"
		""
		"&c&lThis is the wall.&r"
		"&7The certificate costs &e&l11 680&r &7units of crop — about &e&l15 hours&r &7of hand farming. Until you hold one, the sieve gives &nno metal at all&r&7."
		""
		"&6&lWhat it opens&r"
		"&8· &7Every &fore chunk&7 in the game: iron, gold, copper, tin, lead, silver, osmium, aluminium, platinum…"
		"&8· &bDiamonds&7, &aemeralds&7, &9lapis&7, &8coal&7, &credstone&7, &eglowstone&7, &fquartz"
		"&8· &fDeepslate Pebbles&7, &bPrismarine&7, &firon nuggets&7 straight out of dirt"
		""
		"&e&lTip:&r &7The four ingots are easiest &nbought&r&7: &a&l600&r &7each at the merchant. Farm, sell, buy iron, sieve."
	]
	quest.466152E3A665F0DF.quest_subtitle: "&cThe wall &8— &8and the first metal"
	quest.466152E3A665F0DF.title: "&e&lIron Mesh"
