	quest.1FEF95F1948FCB54.quest_desc: ["{quest.unova.description.4}"]
	quest.1FEF95F1948FCB54.title: "{quest.unova.title.3}"
	quest.2039404944210992.quest_desc: [
		"{image:kubejs:textures/ftbquests/emc1.png width:100 height:100 align:1}"
		"&7To start generating your first EMC"
	]
	quest.205861383D2207C4.quest_desc: [
		"&c&lA&r&7 is the first rank that can put a &6&lLegendary Pokemon&r&7 in the boss room."
		""
		"&e&lPOKEMON"
		"&7Level &f&l60 to 80&r&7. Base stat total capped at &f&l600&r&7."
		"&c&lLegendary bosses are allowed."
		""
		"&e&lDUNGEON"
		"&7&l- &f&l14&r&7 Pokemon in total"
		"&7&l- &f&l3 to 6&r&7 combat rooms"
		"&7&l- &f&l3&r&7 elite guards"
		"&7&l- &7a &f&llegendary&r&7 tier boss"
		""
		"&e&lHOW OFTEN"
		"&7Weight &f&l500&r&7 of &f&l10000&r&7 - &a&l5%&r&7 of all natural Gates, one in &f&l20&r&7."
		""
		"&e&lIN THE CHESTS"
		"&7Ten to sixteen Ultra Balls at a time. Dusk and Luxury Balls, and a chance at a &5&lBeast Ball&r&7. Full restores, max revives, max elixirs. XL candies, five to eight rare candies."
		"&a&lSilver and gold bottle caps&r&7, ability capsules, comet shards, relic gold, PP Max, lucky eggs, exp shares, and a rare &d&lability patch&r&7."
	]
	quest.205861383D2207C4.quest_subtitle: "&cLegendary bosses start here"
