	quest.753155DEE6C4A6F4.quest_desc: ["&7Every Ender IO machine has a &6capacitor slot&7. A better capacitor means &amore speed&7 and &amore energy buffer&7."]
	quest.753155DEE6C4A6F4.quest_subtitle: "&7Speed and efficiency in one slot"
	quest.753155DEE6C4A6F4.title: "&a&lBasic Capacitor"
	quest.75D6A6FD14B5A0E6.quest_desc: [
		"&7Pixelmon scatters its goods across dozens of shopkeeper NPCs, and each one only sells its own short list. The &b&lPortable Shop&r&7 collects all of them into a single menu."
		""
		"&e&lWHAT IS INSIDE"
		"&7Poke Marts, Day Care, TM sellers, evolution stones, plus the shops this pack adds:"
		"&7&l- &d&lMinion Tools&r&7, the only source of the hoes, axes and sickles"
		"&7&l- &d&lMinion Gear&r&7, compactors and solar panels"
		"&7&l- &d&lPoke Balls&r&7, the PixelGO balls, which no longer have recipes"
		"&7&l- &d&lGeneral Store&r&7, everything the Shop page offers"
		""
		"&7Right click it anywhere. &a&lYou never have to hunt for an NPC again."
	]
	quest.75D6A6FD14B5A0E6.quest_subtitle: "&7Every shopkeeper, in one slot"
	quest.75D6A6FD14B5A0E6.title: "&b&lThe Portable Shop"
	quest.760B901E7846BAC0.quest_desc: [
		"&7&oA black stone that glows faintly at night.&r"
		""
		"&6&lHow to use it&r"
		"&7&lRight-click&r&7 the Pokémon while holding the item."
		""
		"&e&lEvolutions&r"
		"&f- Nidorina &7→ &aNidoqueen"
		"&f- Nidorino &7→ &aNidoking"
		"&f- Clefairy &7→ &aClefable"
		"&f- Jigglypuff &7→ &aWigglytuff"
		"&f- Skitty &7→ &aDelcatty"
		"&f- Munna &7→ &aMusharna"
	]
	quest.7619CF1BA2185277.quest_desc: [
		"&7&oA catalogue, and suddenly the sky has a marketplace.&r"
		""
		"&6&lWhat it opens&r"
		"&7Every merchant in the pack, &nfrom anywhere&r&7: harvest tools, iron, Poké Balls, TMs, Mystery Boxes."
	]
