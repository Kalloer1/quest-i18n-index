	quest.4B6891EED5D77F77.quest_subtitle: "&5Umbral Spire &8- &7Floor 2"
	quest.4B886217219948D1.quest_desc: [
		"&7Every dungeon hides &f&l1&r&7 or &f&l2&r&7 loot chests. They are the reason you came."
		""
		"&e&lWHAT CLIMBS WITH THE RANK"
		"&7&l- &7&lBalls&r&7: Poke &8> &7Great &8> &7Ultra &8> &7Beast &8> &d&lMaster"
		"&7&l- &7&lHealing&r&7: potions &8> &7max potions &8> &7full restores"
		"&7&l- &7&lCandies&r&7: XS &8> &7S &8> &7M &8> &7L &8> &7XL, then &d&lRare Candy&r&7 by the stack"
		"&7&l- &7&lExtras&r&7: nuggets &8> &7evolution stones &8> &7bottle caps &8> &7ability patches"
		""
		"&c&lSearch every room before you fight the boss. &7Beating the boss opens the exit, and it is very easy to walk out of reflex with a chest still unopened behind you."
	]
	quest.4B886217219948D1.quest_subtitle: "&7One or two per dungeon"
	quest.4B886217219948D1.title: "&6&lThe Chests"
	quest.4BA09A9D3281C627.title: "{quest.unconventional_evolution.title.5}"
	quest.4BDCC282A13C0657.quest_desc: ["{quest.ae2.description.47}"]
	quest.4BEFC789E7DB79DE.quest_subtitle: "&6Legendary"
	quest.4C0552032AEEC74C.quest_subtitle: "&7Common"
	quest.4C1290476E35646A.quest_desc: [
		"&7Nine items, one per rank. Right click a &a&lblock&r&7 with one and a Gate of that rank opens on the spot. No waiting, no luck."
		""
		"&8&lE-Rank Gate Beacon &8- &7level 5-15"
		"&7&lD-Rank Gate Beacon &8- &7level 15-30"
		"&e&lC-Rank Gate Beacon &8- &7level 30-45"
		"&6&lB-Rank Gate Beacon &8- &7level 45-60"
		"&c&lA-Rank Gate Beacon &8- &7level 60-80"
		"&d&lS-Rank Gate Beacon &8- &7level 80-100"
		"&c&lSS-Rank Gate Beacon &8- &7level 100"
		"&6&lSSS-Rank Gate Beacon &8- &7level 100"
		"&4&lDEMON-Rank Gate Beacon &8- &7level 100, Legendaries only"
		""
		"&7The beacon is consumed. It needs open ground: if there is not enough room, the Gate refuses to open and the beacon stays in your hand."
		""
		"&e&lWHERE THEY COME FROM"
		"&7&l- &a&lGate chests&r&7 from rank &c&lSS&r&7 upward always hold one, always the rank below and sometimes the rank itself"
		"&7&l- &7Loot chests everywhere else carry them too, rarely, and the better the chest the better the rank"
		"&7&l- &a&lCrafting&r&7: every beacon is built around the one of the rank below - look it up in &6&lJEI"
		""
		"&7Rough odds per chest: about &f&l2%&r&7 for an &8&lE&8/&7&lD&8/&e&lC&r&7 beacon out of an armoury, &f&l1%&r&7 for &6&lB&8/&c&lA&r&7 out of a buried treasure, and &f&l0.2%&r&7 for anything &d&lS&r&7 or above."
		""
		"&c&lA DEMON beacon is still the hardest item in the pack. &7Out of a chest it is roughly one in a thousand three hundred, and only in the very best chests in the game. Crafting one means building every beacon below it first."
	]
	quest.4C1290476E35646A.quest_subtitle: "&7Open the rank you want"
	quest.4C1290476E35646A.title: "&b&lGate Beacons"
	quest.4C22C424514A4BEF.quest_subtitle: "&7Common"
	quest.4C37C66CB2F889B6.quest_desc: ["{quest.minions.description.5}"]
	quest.4C37C66CB2F889B6.title: "{quest.minions.title.6}"
	quest.4C68A177E6EF7E17.quest_desc: [
		"&7The &e&lYeta Wrench&r&7 is the Ender IO multi tool:"
		"&7- &fRight click&7 a machine to rotate it."
		"&7- &fShift + right click&7 to pick it up with its content."
		"&7- Use it on a &9conduit&7 to open its connection settings."
		""
		"&e&lTip:&r &7Keep it in your hotbar forever. You will need it on every single build."
	]
	quest.4C68A177E6EF7E17.quest_subtitle: "&7Rotate, dismantle, configure"
	quest.4C68A177E6EF7E17.title: "&a&lThe Yeta Wrench"
	quest.4C7DB06A6E741D58.quest_desc: ["{quest.minions.description.10}"]
	quest.4C7DB06A6E741D58.title: "{quest.minions.title.11}"
	quest.4CF558B65915256C.quest_desc: [
		"&7&oA special metallic film that hardens the body.&r"
		""
		"&6&lHow to use it&r"
		"&7&lRight-click&r&7 the Pokémon while holding the item."
		"&7It also works the classic way: &ftrade&7 the Pokémon while it holds the item."
		""
		"&e&lEvolutions&r"
		"&f- Onix &7→ &aSteelix"
		"&f- Scyther &7→ &aScizor"
	]
	quest.4CF558B65915256C.title: "{quest.unconventional_evolution.title.20}"
	quest.4D2F05A0603BFBD4.quest_subtitle: "&7Catch &f&l50&r&7 Ghost-type Pokémon"
	quest.4D2F05A0603BFBD4.title: "&5&lGhost Collector"
	quest.4D9363575263E08F.quest_subtitle: "&6Legendary"
	quest.4DAEF7EC8C41C5C5.quest_subtitle: "&7Defeat &f&l100&r&7 wild Pokémon"
	quest.4DAEF7EC8C41C5C5.title: "&c&lInto the Grass"
	quest.4DB58835EF9B6688.quest_desc: [
		"&6&lThis machine is the heart of the pack now.&r"
		""
		"&7It takes &nthree separate inputs&r&7, each in its own tank or slot:"
		"&7- an &fitem&7 — the apricorns, or the PixelGO effect item,"
		"&7- a &bfluid&7 — &bwater&7 or &clava&7, and that is the tier,"
		"&7- a &dpigment&7 — and that is the ball."
		""
		"&6&lWhy this machine and not another&r"
		"&7Because Mekanism ingredients carry a &f&lcount&r&7 on a &nsingle slot&r&7. Four apricorns means four apricorns in one slot — exactly what a pipe delivers. Machines that want one item per slot cannot be automated with a hopper, and that is why the first version of this chapter did not work."
		""
		"&e&lTip:&r &7The same machine makes &fHDPE Pellets&7 from substrate and ethene. You will need those two slots away from each other — build a second Chamber rather than swapping recipes."
	]
	quest.4DB58835EF9B6688.quest_subtitle: "&7One item, one fluid, one pigment, one lid"
	quest.4DB58835EF9B6688.title: "&6&lThe Pressurized Reaction Chamber"
	quest.4E63D06DFD6C3F4B.quest_desc: [
		"&7&oA thick, sturdy scale shed by a dragon.&r"
		""
		"&6&lHow to use it&r"
		"&7&lRight-click&r&7 the Pokémon while holding the item."
		"&7It also works the classic way: &ftrade&7 the Pokémon while it holds the item."
		""
		"&e&lEvolutions&r"
		"&f- Seadra &7→ &aKingdra"
	]
