	quest.248AEB01973858F5.quest_desc: ["&7The &a&lNetwork Receiver&r&7 is the block that receives a signal from the &a&lNetwork Transmitter&r&7."]
	quest.2496D6AA6B39C868.quest_desc: [
		"&6&lB&r&7 is where competitive items start dropping."
		""
		"&e&lPOKEMON"
		"&7Level &f&l45 to 60&r&7. Base stat total capped at &f&l540&r&7. No Legendaries."
		""
		"&e&lDUNGEON"
		"&7&l- &f&l12&r&7 Pokemon in total"
		"&7&l- &f&l3 to 5&r&7 combat rooms"
		"&7&l- &f&l2&r&7 elite guards"
		"&7&l- &7an &f&lepic&r&7 boss"
		""
		"&e&lHOW OFTEN"
		"&7Weight &f&l950&r&7 of &f&l10000&r&7 - &a&l9.5%&r&7 of all natural Gates, one in &f&l10&r&7."
		""
		"&e&lIN THE CHESTS"
		"&7Ultra, Dusk, Repeat and Luxury Balls. Max potions, full restores, max elixirs, max revives. L and XL candies, rare candies by the handful, PP Ups, big nuggets."
		"&a&lSilver bottle caps&r&7, an ability capsule, and the trade evolution items: razor claw, razor fang, kings rock, metal coat, dragon scale."
	]
	quest.2496D6AA6B39C868.quest_subtitle: "&7Gold. Held items and bottle caps."
	quest.2496D6AA6B39C868.title: "&6&lRank B"
	quest.24A2424988DE0125.quest_desc: [
		"&7&oA bent stick is the first tool of every sky island.&r"
		""
		"&6&lWhat drops&r"
		"&8· &fSilkworms &8— &7the start of the string chain"
		"&8· &7Far more &asaplings &7and &fsticks &7than by hand"
		""
		"&b&lThe string loop&r"
		"&7Put a silkworm back &nonto&r&7 a leaf block to infest it, wait, then crook the infested leaves for &fString&7."
		""
		"&e&lTip:&r &7Nine string make the &eString Mesh&7 — nothing in the sieve works without one."
	]
	quest.24A2424988DE0125.quest_subtitle: "&8Four sticks, and leaves stop being useless"
	quest.24A2424988DE0125.title: "&e&lThe Crook"
	quest.24B0222791BF1813.quest_desc: ["&7sneak right click on the dirt"]
	quest.24B0222791BF1813.quest_subtitle: "&7Crouch and right-click the dirt"
	quest.24B0222791BF1813.title: "&f&lPebbles"
	quest.24E11B669A3328E4.quest_desc: ["{quest.sinnoh.description.13}"]
	quest.24E11B669A3328E4.title: "{quest.sinnoh.title.2}"
	quest.2552C92F0E289F9F.quest_desc: [
		"&7Three &d&lBattle Towers&r&7 rise in the &a&lOverworld Mirror&r&7. Each one has &f&l7 floors&r&7 with &f&l4 Trainers&r&7 per floor: &f&l28&r&7 per tower, &f&l84&r&7 in all. Every Trainer you beat gives you &f&lone badge&r&7, and every badge on this page comes from one of them."
		""
		"&e&lTHE THREE TOWERS"
		"&6&lSolaris Spire &8- &7a gilded spire that drinks the sunrise"
		"&b&lTidal Spire &8- &7a coral fortress humming with the pulse of the deep"
		"&5&lUmbral Spire &8- &7a black obelisk where the last champions wait"
		""
		"&e&lFINDING THEM"
		"&7Towers generate on land in the Mirror (plains, forests, taigas, savannas, deserts, jungles, swamps, beaches, hills), about one every &f&l20 chunks&r&7, and each one is a random pick of the three. Never in the ocean."
		"&7The Mirror runs on the &c&ldimension timer&r&7. A tower is a long climb: go in with time to spare."
		""
		"&e&lHOW THE BATTLES WORK"
		"&7&l- &7Right-click a Trainer to challenge them. With a fainted team they turn you away, so &a&lheal first&r&7."
		"&7&l- &7Trainers &f&lcopy the level of your strongest Pokémon&r&7 and re-roll their moves to match. One over-levelled Pokémon pulls every Trainer up with it."
		"&7&l- &7The higher the floor, the better their IVs: &f&l8&r&7 on floor 1, &f&l31&r&7 on floor 7."
		"&7&l- &7Each win pays &6&lPokéDollars&r&7, more on every floor and more in the Tidal and Umbral Spires."
		"&7&l- &7A beaten Trainer won't battle you again for &f&l20 hours&r&7."
		"&7&l- &7Beat all 28 Trainers of a tower to receive its &d&lTrophy&r&7."
		""
		"&e&lREWARDS"
		"&7Hand each badge in on this page for a &a&lTier 2 Treasure Bag&r&7. The badge is consumed."
		"&7Once all &f&l84&r&7 are in, this quest gives you a &d&lrandom shiny Legendary&r&7 with &a&lperfect IVs&r&7. That is the end of the game."
		""
		"&e&lTip:&r &7Hover a badge before handing it in: its tooltip names the Trainer, the tower and the floor it comes from. Each badge quest on this page tells you the same, plus the Trainer's team."
	]
	quest.2552C92F0E289F9F.quest_subtitle: "&7Three towers, 84 Trainers, 84 badges"
	quest.2552C92F0E289F9F.title: "&d&lPokémon Master"
	quest.25D283B75E65F3BD.quest_desc: [
		"&7&oA stone that shines with its own light.&r"
		""
		"&6&lHow to use it&r"
		"&7&lRight-click&r&7 the Pokémon while holding the item."
		""
		"&e&lEvolutions&r"
		"&f- Togetic &7→ &aTogekiss"
		"&f- Roselia &7→ &aRoserade"
		"&f- Minccino &7→ &aCinccino"
		"&f- Floette &7→ &aFlorges"
	]
	quest.25E64F5099FC0D7A.quest_desc: ["&7&d&lBayleef&r&7 evolves at level &f&l32&r&7"]
	quest.25E64F5099FC0D7A.title: "Evolve or Catch"
	quest.25F4EC6A3C83F0EB.quest_desc: [
		"&d&lEvery single Poké Ball lid in this pack is paid for in pigment.&r"
		""
		"&7The Extractor squeezes a &fflower&7 or a &fdye&7 into liquid colour. A dandelion gives yellow, a poppy red, lapis blue — sixteen colours in all, and the ball you get depends on which one you pump in."
		""
		"&e&lTip:&r &7Put your &6flower minion&7 on a pipe straight into the Extractor and forget about it. Colour is the one input you will never have enough of."
	]
	quest.25F4EC6A3C83F0EB.quest_subtitle: "&7Colour is the currency of this chapter"
	quest.25F4EC6A3C83F0EB.title: "&d&lThe Pigment Extractor"
	quest.2622E4EDB478AE41.quest_subtitle: "&9Rare"
	quest.266B39C633E54DA7.title: "Acquire Gorebyss"
	quest.26CF780130C9A8D3.quest_subtitle: "&9Rare"
	quest.26E7F76690DCC918.quest_subtitle: "Level Up"
	quest.26E7F76690DCC918.title: "Evolve or Catch Blastoise"
	quest.26F11FEA478B4DAC.quest_desc: [
		"&7Sooner or later a &5&lGate&r&7 tears open near you. It is a doorway into a dungeon that only exists while somebody is inside it."
		""
		"&7&l- &f&lNine&r&7 ranks, &8&lE&r&7 through &4&lDEMON"
		"&7&l- &7The Pokemon inside are levelled to the rank"
		"&7&l- &7Find the boss, beat it, take the chests"
		"&7&l- &7From rank &c&lA&r&7 up, the boss can be a Legendary"
		""
		"&7On this map they open &a&lclose to you&r&7 - between &f&l3&r&7 and &f&l20&r&7 blocks away and within &f&l3&r&7 blocks of your own height, because skyblock placement is on. The game rolls once a minute and almost always succeeds, so you will usually be sitting at the cap of &f&l2&r&7 open Gates. An unused one closes after a full Minecraft day."
		""
		"&c&lThere is no way out until you beat the boss. &7Losing a battle ejects you and that dungeon is gone."
		""
		"&e&lWHERE THE PACK ENDS"
		"&7The last rank is &4&lDEMON&r&7: twenty eight level 100 Legendaries, seven of them elite guards, drawn from a hand written list with competitive natures and EV spreads."
		""
		"&4&lClear a Demon Gate and you have finished this modpack. &7There is nothing above it."
		""
		"&7It has its own chapter: &5&lPixelGO Gates&r&7. Read it before you walk into a red one."
	]
	quest.26F11FEA478B4DAC.quest_subtitle: "&7Dungeons that come to you"
	quest.26F11FEA478B4DAC.title: "&5&lGates"
