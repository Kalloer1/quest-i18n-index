	quest.3B5016BDED57B783.quest_desc: ["{quest.hoenn.description.4}"]
	quest.3B5016BDED57B783.title: "{quest.hoenn.title.3}"
	quest.3B89B5410E999E6D.quest_desc: [
		"&c&lThe Gate you walked through stays outside. &7There is no copy of it inside the dungeon. Until the boss is dead there is no exit at all."
		""
		"&e&lTHE THREE WAYS OUT"
		"&a&l1. &7&lBeat the boss.&r&7 The exit Gate opens in the boss room. You leave with everything."
		"&c&l2. &7&lLose a battle.&r&7 The dungeon ejects you on the spot. You keep what you already picked up and lose the rest - and that dungeon is gone for good."
		"&8&l3. &7An operator runs &b/pixelgate leave&r&7. That command needs permission level 2, so it is not something you can do for yourself."
		""
		"&c&lDo not enter a Gate you are not prepared to finish. &7Walking in underlevelled does not cost you time. It costs you the run."
		""
		"&7&oIf a dungeon is taken down while you are offline inside it, the game puts you back at spawn and says so in chat."
	]
	quest.3B89B5410E999E6D.quest_subtitle: "&4Read this one twice"
	quest.3B89B5410E999E6D.title: "&4&lThere Is No Back Door"
