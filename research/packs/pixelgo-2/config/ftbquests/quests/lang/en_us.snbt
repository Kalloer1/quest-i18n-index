	quest.62604960C94936F9.quest_desc: ["{quest.ae2.description.25}"]
	quest.62604960C94936F9.title: "{quest.ae2.title.4}"
	quest.62683632D69222D1.quest_desc: [
		"&7Soularium ingot and nuggets plus &fQuartz Dust&7 give &a2 chains&7 per craft."
		""
		"&7Four of them build the &5&lEnsouled Chassis&r&7."
