	quest.5D67F40D6B8E19A5.quest_desc: [
		"&7One room holds the boss. Chat announces it, and the Pokemon that rises is scaled up - larger than anything else in the dungeon."
		""
		"&e&lBOSS QUALITY BY RANK"
		"&8&lE &8- &7common"
		"&7&lD &7and &e&lC &8- &7rare"
		"&6&lB &8- &7epic"
		"&c&lA &8- &7legendary"
		"&d&lS&r&7, &c&lSS&r&7, &6&lSSS&r&7 and &4&lDEMON &8- &7ultimate"
		""
		"&c&lFrom rank A upward the boss can be an actual Legendary Pokemon. &7That is the fastest legendary encounter in the pack, and the hardest fight in it."
		""
		"&7In a &4&lDEMON&r&7 Gate there is no \"can be\" about it - the whole dungeon is drawn from a list of Legendaries, so the boss is one by definition."
		""
		"&a&lBeat it and the screen reads Dungeon Cleared. &7An &a&lexit Gate&r&7 opens in the boss room. Right click it and you go home with everything you picked up."
	]
	quest.5D67F40D6B8E19A5.quest_subtitle: "&7And the only door home"
	quest.5D67F40D6B8E19A5.title: "&5&lThe Boss"
	quest.5DBDF933C9610A23.quest_subtitle: "&aUncommon"
	quest.5DC3CBEE0A994222.quest_desc: ["&7Catch rate &bx3.5&7 against &9Water&7 and &aBug&7 types, &fx1&7 on anything else."]
	quest.5DC3CBEE0A994222.quest_subtitle: "&7For Water and Bug types"
	quest.5DC3CBEE0A994222.title: "&b&lNet Ball"
	quest.5DF252D342748189.quest_desc: [
		"&7Hit &fleaves&7 with the &eCrook&7 until a &f&lSilkworm&r &7drops."
		""
		"&6&lTurning them into string&r"
		"&7- Put the silkworms in a &fBarrel&7 to compost them into &fString&7."
		"&7- Or cook them: a &fCooked Silkworm&7 is edible in a pinch."
		""
		"&e&lTip:&r &7Four strings make the &eString Mesh&7 — the whole sieve chain starts here."
	]
	quest.5DF252D342748189.quest_subtitle: "&7No string without them"
	quest.5DF252D342748189.title: "&e&lSilkworms"
