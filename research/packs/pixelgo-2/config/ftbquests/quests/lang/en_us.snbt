	quest.0D7D36DDBD8DE87C.quest_subtitle: "&5Umbral Spire &8- &7Floor 2"
	quest.0D96D82C300049B3.quest_desc: [
		"&d&lWhatever you catch comes out shiny.&r &7No odds, no rolls, no charm stacking. This is the strongest ball the mod has."
		""
		"&c&lIt no longer asks for a Shiny Swapper.&r &7That made the ball worthless: the Swapper turns a caught Pokémon shiny on its own, so nobody would spend one to build a ball. It now runs on the &d&lStrong Shiny Lure&r&7 — the item that already attracts shinies — crafted from a &fStrong Lure Casing&7 plus &fStarf&7, &fLansat&7, &fLum&7 and &fApicot&7 berries. Berries regrow; the two items no longer compete."
		""
		"&a&lOne lure gives 3 lids, so 3 guaranteed shinies.&r &7The lure is a durability item and does not stack, which is why the recipe takes exactly one."
		""
		"&e&lTip:&r &7Throw it at something you have already weakened. A shiny you fail to catch is a shiny you may never see again."
	]
	quest.0D96D82C300049B3.quest_subtitle: "&7Guaranteed. Not a roll, a guarantee."
	quest.0D96D82C300049B3.title: "&d&lShiny Ball"
	quest.0DA4B6C86A8AEA48.quest_desc: [
		"&e&lC&r&7 is the rank most players farm. The stones alone justify it."
		""
		"&e&lPOKEMON"
		"&7Level &f&l30 to 45&r&7. Base stat total capped at &f&l500&r&7. No Legendaries."
		""
		"&e&lDUNGEON"
		"&7&l- &f&l10&r&7 Pokemon in total"
		"&7&l- &f&l2 to 4&r&7 combat rooms"
		"&7&l- &f&l2&r&7 elite guards"
		"&7&l- &7a &f&lrare&r&7 boss"
		""
		"&e&lHOW OFTEN"
		"&7Weight &f&l1700&r&7 of &f&l10000&r&7 - &a&l17%&r&7 of all natural Gates."
		""
		"&e&lIN THE CHESTS"
		"&7Ultra, Dusk, Quick and Timer Balls. Hyper and max potions, max ethers. M and L candies, rare candies, star pieces, PP Ups, big nuggets."
		"&a&lSix more evolution stones&r&7: moon, sun, dusk, dawn, shiny and ice."
	]
	quest.0DA4B6C86A8AEA48.quest_subtitle: "&7Yellow. The evolution stone run."
	quest.0DA4B6C86A8AEA48.title: "&e&lRank C"
	quest.0DA52074FB9E3D28.quest_desc: ["{quest.sinnoh.description.9}"]
	quest.0DA52074FB9E3D28.title: "{quest.sinnoh.title.2}"
	quest.0DBFCFF553957C4D.quest_subtitle: "&5Epic"
	quest.0DEA4CBE582778DC.quest_desc: [
		"&7Right click on the ground while holding some shards to start building the orb."
		"&7You'll need &f&l10&r&7 shards to make an orb"
		"&7Then you'll be able to transform &d&lKyogre&r&7 into it's primal form!"
	]
	quest.0E9470A009C52A27.quest_desc: [
		"&7Gates open on their own, around players. You never have to go looking for one."
		""
		"&e&lTHE NUMBERS"
		"&7&l- &7The game rolls once a &f&lminute&r&7, for each player"
		"&7&l- &7Each roll has a &f&l99%&r&7 chance to succeed"
		"&7&l- &7At most &f&l2&r&7 are open around you at once, so in practice you are always at the cap"
		"&7&l- &7Between &f&l3&r&7 and &f&l20&r&7 blocks away, within &f&l3&r&7 blocks of your height &8- &7skyblock placement, so they float"
		"&7&l- &7An unused Gate closes after &f&lone Minecraft day"
		""
		"&e&lWHICH RANK YOU GET"
		"&7These are weights, not percentages. Add them up and divide."
		""
		"&8&lE &8- &f3600&r&7    &7&lD &8- &f2600&r&7    &e&lC &8- &f1700"
		"&6&lB &8- &f950&r&7      &c&lA &8- &f500&r&7      &d&lS &8- &f300"
		"&c&lSS &8- &f200&r&7      &6&lSSS &8- &f100&r&7    &4&lDEMON &8- &f50"
		""
		"&7That is &f&l10000&r&7 in total, so a weight is its percentage times a hundred:"
		"&7&l- &d&lS&r&7 is one Gate in &f&l33"
		"&7&l- &c&lSS&r&7 is one in &f&l50"
		"&7&l- &6&lSSS&r&7 is one in &f&l100"
		"&7&l- &4&lDEMON&r&7 is one in &f&l200"
		""
		"&7Each endgame rank is &f&ltwice&r&7 as rare as the one below it, all the way to &4&lDEMON&r&7. That is the whole climb, and it is meant to be walked rather than won in a lottery."
	]
	quest.0E9470A009C52A27.quest_subtitle: "&7Roughly every four minutes"
	quest.0E9470A009C52A27.title: "&e&lWhen Do They Appear?"
	quest.0EA4D767B1A99CDA.quest_desc: ["&7Catch rate &fx1&7, but the Pokémon starts at &d150 friendship&7 instead of 70."]
