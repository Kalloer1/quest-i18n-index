	]
	quest.610F55A825E6F0E3.quest_subtitle: "&6Solaris Spire &8- &7Floor 7"
	quest.613532DBB47FFC75.quest_desc: [
		"&7Thank you for playing &5&lPixelGO &r&7- &3&lTo the Sky&r 2&7."
		""
		"&e&lWHERE AM I?"
		"&7You start on a small island, and that island is &a&lin the Overworld&r&7. There is no Void dimension and no portal to craft: this &oIS&r&7 the Overworld, and it is empty in every direction."
		"&c&lThere is no terrain and no ore anywhere in the world. &7Everything you will ever own has to come out of your island, through the &6&lsieve&r&7 and the &6&lcrucible&r&7."
		""
		"&7The Nether and the End are empty too, with two exceptions: &c&lNether Fortresses&r&7 still generate, and the End keeps its main island - so blazes, wither skeletons and the &5&ldragon&r&7 are all still reachable."
		""
		"&e&lCOMMANDS"
		"&b/pixelsell &8- &7sells the item in your hand"
		"&b/pixelsell all &8- &7sells every sellable item you are carrying"
		"&b/pixelvalue &8- &7tells you what an item is worth before you sell it"
		""
		"&7There is also a &a&lSell&r&7 button on your inventory screen. Same thing, one click."
		""
		"&e&lTHE REST OF THIS PAGE"
		"&7Every other quest here is a short card about one part of the pack. They cost you nothing: read one, tick it, take the reward."
		""
		"&3Tick every checkmark in this chapter to read the whole guide."
	]
	quest.613532DBB47FFC75.quest_subtitle: "&2Basic information about the pack. &4Please read."
	quest.613532DBB47FFC75.title: "&4&lInfo"
	quest.6154BB10414AA1A1.quest_desc: ["{quest.ae2.description.16}"]
	quest.61A2E44786F71B33.quest_desc: ["{quest.minions.description.4}"]
	quest.61A2E44786F71B33.title: "{quest.minions.title.5}"
	quest.61C9BC202F4ABBA4.quest_desc: [
		"&7&lD&r&7 is where elite guards start appearing and the chests start paying."
		""
		"&e&lPOKEMON"
		"&7Level &f&l15 to 30&r&7. Base stat total capped at &f&l450&r&7. No Legendaries."
		""
		"&e&lDUNGEON"
		"&7&l- &f&l8&r&7 Pokemon in total"
		"&7&l- &f&l2 to 3&r&7 combat rooms"
		"&7&l- &f&l1&r&7 elite guard"
		"&7&l- &7a &f&lrare&r&7 boss"
		""
		"&e&lHOW OFTEN"
		"&7Weight &f&l2600&r&7 of &f&l10000&r&7 - &a&l26%&r&7 of all natural Gates."
		""
		"&e&lIN THE CHESTS"
		"&7Great, Ultra and Quick Balls. Super and hyper potions, revives. S and M candies, nuggets, heart scales, rare candies."
		"&a&lAnd the four basic evolution stones&r&7: fire, water, thunder and leaf."
	]
	quest.61C9BC202F4ABBA4.quest_subtitle: "&7Green. The first real fight."
	quest.61C9BC202F4ABBA4.title: "&7&lRank D"
	quest.61E6FBC17CE652B9.quest_desc: ["&7Catch rate &fx1&7, but the Pokémon is &afully healed&7 the moment it is caught — HP, PP and status."]
	quest.61E6FBC17CE652B9.quest_subtitle: "&7Caught and patched up"
	quest.61E6FBC17CE652B9.title: "&d&lHeal Ball"
	quest.623BC4E03797741F.quest_desc: ["{quest.kalos.description.7}"]
	quest.623BC4E03797741F.title: "{quest.kalos.title.2}"
