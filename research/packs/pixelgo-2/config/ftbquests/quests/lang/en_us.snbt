	quest.59D16FCB900F73D3.quest_desc: [
		"&b&lPixelGO Radar&r&7 shows you what is spawning around you before you walk into it."
		""
		"&e&lOPEN THE FILTER"
		"&f&lF4&r&7 by default. Rebind it in Controls, under &7PixelGO - Radar&7."
		""
		"&e&lWHAT IT TRACKS"
		"&7&l- &b&lShiny&r&7 Pokemon"
		"&7&l- &6&lLegendary&r&7 Pokemon"
		"&7&l- &c&lBosses&r&7 and &d&lraids"
		"&7&l- &a&lPalettes&r&7 and special forms"
		"&7&l- &e&lPokeStops and PokeLoot&r&7 chests"
		"&7&l- &7NPCs"
		""
		"&7Search by name, gender, form, Tera type or palette. Turn the compass on and it points the way."
		""
		"&7&oLeave shiny tracking on permanently. It costs nothing and it will save you hours."
	]
	quest.59D16FCB900F73D3.quest_subtitle: "&7See what is out there first"
	quest.59D16FCB900F73D3.title: "&b&lThe Radar"
