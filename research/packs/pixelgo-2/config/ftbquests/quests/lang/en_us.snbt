	quest.47BAD1FE91D29C11.quest_subtitle: "&7For the ones you keep"
	quest.47BAD1FE91D29C11.title: "&8&lLuxury Ball"
	quest.47C5140C2B706068.quest_desc: ["{quest.ae2.description.17}"]
	quest.48099FE55AEC658A.quest_desc: [
		"&7Fill your bucket from the &bCrucible&7 (it melts &fleaves&7 and &fsaplings&7 into water) or from a &fBarrel&7 left out in the rain."
		""
		"&6&lThen build an infinite source&r"
		"&7Dig a &f2x2 hole&7, pour water in &etwo opposite corners&7: the two remaining blocks become an endless source."
		""
		"&e&lTip:&r &7Water is needed for &fclay&7, &fobsidian&7, the &aBotany Pots&7 and every farm that follows. Do this early."
	]
	quest.48099FE55AEC658A.quest_subtitle: "&7Fill the bucket, then never need it again"
	quest.48099FE55AEC658A.title: "&9&lA Water Source"
	quest.482300B2020582F1.quest_desc: ["&7The Hisuian craft of the &eUltra Ball&7 — &6x2&7 catch rate."]
	quest.482300B2020582F1.quest_subtitle: "&7Hisui — the strong one"
	quest.482300B2020582F1.title: "&e&lAncient Ultra Ball"
	quest.482F105C294DF281.quest_subtitle: "&9Rare"
	quest.48410732BE8F3E32.quest_desc: [
		"&7A harvested crop is replanted on the spot, straight from the drop."
		""
		"&e&lTip:&r &7The book comes out at &fReplenish I&7 — the maximum level — straight from the table. Cheaper copies also drop from &6Mystery Boxes&7."
	]
	quest.48410732BE8F3E32.quest_subtitle: "&7It replants behind you"
	quest.48410732BE8F3E32.title: "&b&lReplenish I"
	quest.48540AD0AD7D6498.quest_subtitle: "&6Legendary"
	quest.488A43C67D4A79EF.quest_desc: ["{quest.alola.description.9}"]
	quest.488A43C67D4A79EF.title: "{quest.alola.title.2}"
	quest.488D082BFE116A32.quest_desc: [
		"&7This pack adds &d&l13 enchantments&r&7 that do nothing for fighting mobs and everything for training Pokemon. They all come out of an ordinary &a&lenchanting table&r&7."
		""
		"&e&lHELMET"
		"&b&lPokedex Lens &8III &8- &7extra shiny rolls on Pokemon spawning near you"
		"&b&lVitality Aura &8III &8- &7heals your whole party over time"
		""
		"&e&lCHESTPLATE"
		"&b&lTrainers Focus &8IV &8- &7more experience for your Pokemon"
		"&b&lTraining Regimen &8III &8- &7more EVs after a battle"
		"&b&lPoke Scavenger &8III &8- &7chance to duplicate Pokemon drops"
		""
		"&e&lLEGGINGS"
		"&b&lBond of Friendship &8III &8- &7friendship for the whole party"
		"&b&lIncubators Warmth &8III &8- &7eggs hatch while you walk"
		"&b&lTreasure Hunter &8II &8- &7chance to duplicate Poke Loot"
		""
		"&e&lBOOTS"
		"&b&lCatchers Stride &8III &8- &7capture bonus on every ball you throw"
		"&b&lGreen Thumb &8III &8- &7more apricorns and berries per harvest"
		""
		"&e&lHELD IN HAND"
		"&b&lCatch Rate &8V &8- &7goes on the Poke Ball itself"
		"&b&lFossil Sense &8III &8- &7fossils turn up while you mine stone"
		"&b&lDeep Lure &8III &8- &7far less waiting while fishing"
		""
		"&c&lCatch Rate goes on the ball, not on you. &7Enchant your Ultra Balls before a legendary hunt."
	]
	quest.488D082BFE116A32.quest_subtitle: "&7Thirteen of them, and none are for combat"
	quest.488D082BFE116A32.title: "&5&lTrainer Enchantments"
	quest.4890D4E010232193.quest_desc: ["{quest.ae2.description.2}"]
	quest.48921A667DE149E5.quest_desc: ["&7Right click on the &a&lForces of Nature&r&7 to swap between their Incarnate and &a&lTherian Forms&r&7"]
