	quest.79AC62A1F1622400.quest_desc: [
		"&7Whatever you catch arrives with a &nmaxed&r&7 Attack EV spread: &f252&7 points, the per-stat cap."
		""
		"&7&fAdd EV ATTACK&7 comes from &fProtein&7 — the vitamin that trains this exact stat — infused with redstone in the &bMetallurgic Infuser&7. Pixelmon feeds Mekanism, Mekanism makes the ball."
		""
		"&e&lTip:&r &7EVs are capped at &f510 total&7. Two maxed stats is the whole budget — pick the two that matter and do not waste a third ball."
	]
	quest.79AC62A1F1622400.quest_subtitle: "&7252 EVs, the instant it is caught"
	quest.79AC62A1F1622400.title: "&c&lEV Attack Ball"
