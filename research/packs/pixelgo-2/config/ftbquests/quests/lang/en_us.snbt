	quest.32774808C5AD3499.quest_desc: ["{quest.kalos.description.5}"]
	quest.32774808C5AD3499.title: "{quest.kalos.title.2}"
	quest.32AE95993107F9AE.quest_desc: [
		"&7Whatever you catch arrives with a &nmaxed&r&7 HP EV spread: &f252&7 points, the per-stat cap."
		""
		"&7&fAdd EV HP&7 comes from &fHP Up&7 — the vitamin that trains this exact stat — infused with redstone in the &bMetallurgic Infuser&7. Pixelmon feeds Mekanism, Mekanism makes the ball."
		""
		"&e&lTip:&r &7EVs are capped at &f510 total&7. Two maxed stats is the whole budget — pick the two that matter and do not waste a third ball."
	]
	quest.32AE95993107F9AE.quest_subtitle: "&7252 EVs, the instant it is caught"
	quest.32AE95993107F9AE.title: "&a&lEV HP Ball"
	quest.32BA28B9DEBB9A01.quest_desc: [
		"&7&lConduits&r &7are the transport system of Ender IO. Several types can share the &6same block space&7."
		""
		"&e&lTip:&r &7Hide them behind a &9Conduit Facade&7 for a clean base."
	]
	quest.32BA28B9DEBB9A01.quest_subtitle: "&7Wires that hide inside your walls"
	quest.32BA28B9DEBB9A01.title: "&9&lEnergy Conduits"
	quest.32D8FEB9F5BB520F.quest_subtitle: "&5Epic"
	quest.3340939D9F115EF8.quest_desc: ["{quest.storage.description.8}"]
