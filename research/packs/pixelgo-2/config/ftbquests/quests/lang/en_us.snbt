	quest.210A69BA8493D45E.quest_subtitle: "&5Umbral Spire &8- &7Floor 6"
	quest.210D0D36A3C1FA37.quest_desc: [
		"&8&lE&r&7 is the tutorial Gate. Small, grey, and nearly harmless."
		""
		"&e&lPOKEMON"
		"&7Level &f&l5 to 15&r&7. Base stat total capped at &f&l400&r&7, so nothing fully evolved. No Legendaries."
		""
		"&e&lDUNGEON"
		"&7&l- &f&l5&r&7 Pokemon in total"
		"&7&l- &f&l1 to 2&r&7 combat rooms"
		"&7&l- &7no elite guards"
		"&7&l- &7a &f&lcommon&r&7 boss"
