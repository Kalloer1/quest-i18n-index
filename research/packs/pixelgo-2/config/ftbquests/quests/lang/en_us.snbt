	quest.01F7FA7779B69FC3.quest_desc: [
		"&7Every block mined is smelted on the spot: no furnace, no fuel."
		""
		"&e&lTip:&r &7The book comes out at &fSmelting Touch I&7 — the maximum level — straight from the table. Cheaper copies also drop from &6Mystery Boxes&7."
	]
	quest.01F7FA7779B69FC3.quest_subtitle: "&7Ore in, ingot out"
	quest.01F7FA7779B69FC3.title: "&d&lSmelting Touch I"
