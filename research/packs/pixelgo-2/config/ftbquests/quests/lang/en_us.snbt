	quest.649768118630178C.title: "&d&lAbsorb X"
	quest.65435AE512528199.quest_desc: [
		"&6&lThe chain&r"
		"&7&fCobblestone&7 → &fGravel&7 → &fSand&7 → &f&lDust&r&7, one hammer blow at a time."
		""
		"&6&lWhy you want it&r"
		"&7- Sieved dust gives &fbone meal&7, &fredstone&7, &fglowstone&7, &fgunpowder&7 and &fblaze powder&7."
		"&7- It is also the only source of &d&lGrains of Infinity&r&7, the dust that opens the whole &5Ender IO&7 chapter."
		""
		"&e&lTip:&r &7Automate it: a &fMechanical Hammer&7 or a &fCompressed Hammer&7 turns a stack into dust in seconds."
	]
