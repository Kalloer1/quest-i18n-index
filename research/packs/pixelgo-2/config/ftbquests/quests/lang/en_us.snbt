	quest.5A9CF92DA206A309.quest_desc: ["{quest.alola.description.1}"]
	quest.5B11C5DCED53DE14.quest_desc: [
		"&6&lEx Deorum&r&7 is the backbone of this pack. Two tools, and the whole periodic table comes out of them."
		""
		"&e&lTHE HAMMER"
		"&7Hold it and break a block by hand. Cobblestone becomes gravel, gravel becomes sand, sand becomes dust."
		""
		"&e&lTHE SIEVE"
		"&7Right click a sieve while holding dirt, gravel, sand or dust. Out come seeds, ores and clay. A sieve does nothing until you put a &a&lmesh&r&7 in it."
		""
		"&e&lMESH LADDER"
		"&f&lString &8> &7&lFlint &8> &f&lIron &8> &6&lGolden &8> &b&lDiamond &8> &8&lNetherite"
		""
		"&7Every mesh unlocks new drops &oand&r&7 improves the odds of everything below it. &c&lSome ores only ever come out of the netherite mesh."
		""
		"&7&oEx Compressum adds an auto hammer and an auto sieve once you have power. You will want both."
	]
	quest.5B11C5DCED53DE14.quest_subtitle: "&7How a skyblock actually works"
	quest.5B11C5DCED53DE14.title: "&6&lSieve and Hammer"
