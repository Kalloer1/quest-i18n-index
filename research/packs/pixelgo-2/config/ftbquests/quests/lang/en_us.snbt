	quest.2EB1030B97BAA8A9.quest_desc: [
		"&7Same job as the stone hammer, &amuch&7 more durable."
		""
		"&e&lTip:&r &7Hammers accept &fUnbreaking&7 and &fEfficiency&7 — an enchanted iron hammer will outlive a bare diamond one."
	]
	quest.2EB1030B97BAA8A9.quest_subtitle: "&7Faster, and it lasts"
	quest.2EB1030B97BAA8A9.title: "&b&lIron Hammer"
	quest.2EDD2A437DCC8056.quest_subtitle: "&9Rare"
	quest.2F01EDE0166B0EE7.quest_desc: [
		"&7Awarded by &f&lSentinel Ignis&r&7, &oTower Warden&r&7."
		"&7Found in the &6&lSolaris Spire&r&7, on &f&lfloor 3&r&7 of 7."
		""
		"&e&lTeam:&r &fLucario&7, &fMetagross&7, &fScizor&7, &fSteelix"
		"&7IVs of &f&l16&r&7 in every stat, levels scaled to your strongest Pokémon."
		""
		"&7Beating them also pays &6&l550&r&7 PokéDollars. They won't battle you again for &f&l20 hours&r&7."
	]
	quest.2F01EDE0166B0EE7.quest_subtitle: "&6Solaris Spire &8- &7Floor 3"
	quest.2F6AA1EC04F402B8.quest_subtitle: "&aUncommon"
	quest.2FEB49D07CBB5DC6.quest_desc: [
		"&7Awarded by &f&lSentinel Perla&r&7, &oTower Warden&r&7."
		"&7Found in the &b&lTidal Spire&r&7, on &f&lfloor 3&r&7 of 7."
		""
		"&e&lTeam:&r &fCofagrigus&7, &fGolurk&7, &fSableye&7, &fJellicent"
		"&7IVs of &f&l16&r&7 in every stat, levels scaled to your strongest Pokémon."
		""
		"&7Beating them also pays &6&l650&r&7 PokéDollars. They won't battle you again for &f&l20 hours&r&7."
	]
	quest.2FEB49D07CBB5DC6.quest_subtitle: "&bTidal Spire &8- &7Floor 3"
	quest.3017C38280468501.quest_desc: [
		"&7&oThe hardest three ingots you will ever gather.&r"
		""
		"&c&lThere is no ore yet.&r"
		"&7That iron comes from an exploration chest, a quest reward, or the merchant at &a&l600&r &7each."
		""
		"&6&lWhat you need it for&r"
		"&8· &bWater &8— &7the field"
		"&8· &cLava &8— &7the porcelain crucible"
	]
	quest.3017C38280468501.quest_subtitle: "&8Three iron, endless uses"
	quest.3017C38280468501.title: "&6&lFirst Bucket"
	quest.301EF332667BA5D1.quest_desc: [
		"&7The &6PixelGO - Ball&7 mod adds &f20&7 Poké Balls whose value is &nnot&r&7 their capture rate — every one of them sits at a flat &f10-20&7 bonus. What they do is rewrite the Pokémon the moment it is caught."
		""
		"&c&lAll twenty are tier 3 or 4.&r &7This row is late-game."
	]
	quest.301EF332667BA5D1.quest_subtitle: "&7Twenty balls that change the Pokémon, not the odds"
	quest.301EF332667BA5D1.title: "&6&lPixelGO Balls — The Effect Line"
	quest.3031E01437CB69AA.quest_desc: [
		"&7Awarded by &f&lZero Two&r&7, &oKlaxosaur Princess&r&7."
		"&7Found in the &5&lUmbral Spire&r&7, on &f&lfloor 5&r&7 of 7."
		""
		"&e&lTeam:&r &fDragonite&7, &fSalamence&7, &fHydreigon&7, &fDragapult"
		"&7IVs of &f&l24&r&7 in every stat, levels scaled to your strongest Pokémon."
		""
		"&7Beating them also pays &6&l1050&r&7 PokéDollars. They won't battle you again for &f&l20 hours&r&7."
	]
	quest.3031E01437CB69AA.quest_subtitle: "&5Umbral Spire &8- &7Floor 5"
	quest.30516D4482053E5F.quest_desc: ["&7Allows you to store one type of item in large quantities."]
	quest.3081598E10C4C1E7.quest_desc: [
		"&7Two &benchanted items&7 sit in the middle row of every hand-made ball — they are what used to be a stone button."
		""
		"&7One enchanted item is &f160&7 units of its base resource. A batch of three Poké Balls therefore costs &f320 cobblestone&7 — nothing at all once a &6Cobblestone Minion&7 runs, and everything if you try to mine it by hand."
		""
		"&c&lThis replaced the HDPE Sheet.&r &7Plastic meant building the whole bio-fuel line before your first Poké Ball, which was backwards. Minions come first in this pack, so the balls lean on minions."
		""
		"&e&lTip:&r &7A &6Super Compactor 3000&7 in a minion turns its output straight into the enchanted form. Fit one and the ball line feeds itself."
	]
	quest.3081598E10C4C1E7.quest_subtitle: "&7What holds a ball together"
	quest.3081598E10C4C1E7.title: "&7&lThe Enchanted Item"
	quest.30E509D0E21E39C3.quest_desc: [
		"&7&oA scale that shines in rainbow colours.&r"
		""
		"&6&lHow to use it&r"
		"&7&lRight-click&r&7 the Pokémon while holding the item."
		"&7It also works the classic way: &ftrade&7 the Pokémon while it holds the item."
		""
		"&e&lEvolutions&r"
		"&f- Feebas &7→ &aMilotic"
	]
	quest.30E509D0E21E39C3.title: "{quest.unconventional_evolution.title.16}"
