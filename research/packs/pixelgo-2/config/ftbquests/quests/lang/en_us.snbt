	quest.02A43D1177A89EF2.quest_desc: [
		"&7&oEverything you will ever build starts with six saplings.&r"
		""
		"&6&lWhat wood gives you&r"
		"&8· &fPlanks &7and &fsticks &8→ &ethe Crook&7, &ethe Sieve&7, &6the Barrel&7, &6the Crucible"
		"&8· &aLeaves &8→ &7silkworms, and compost for &fdirt"
		"&8· &fCharcoal &8→ &7your only fuel until the sieve gives ore"
		""
		"&e&lTip:&r &7Bind &6Ore Excavation&7 in the controls to fell a whole trunk in one go, and &fcrouch&7 next to a sapling to make it grow."
	]
	quest.02A43D1177A89EF2.quest_subtitle: "&8Your whole island fits in a tree"
	quest.02A43D1177A89EF2.title: "&a&lFirst Logs"
