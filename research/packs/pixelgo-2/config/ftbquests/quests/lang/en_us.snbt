	quest.004C17A18C6065EC.quest_desc: [
		"&7Awarded by &f&lConcierge Aya&r&7, &oTower Concierge&r&7."
		"&7Found in the &5&lUmbral Spire&r&7, on &f&lfloor 4&r&7 of 7."
