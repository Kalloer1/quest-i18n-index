	quest.6CC8B1CC7EF60F0E.quest_desc: [
		"&7A Minion is a small worker you place on your island. Give it a patch to work and it mines, chops or farms forever, including while you are offline."
		""
		"&e&lWHY THEY MATTER"
		"&7Minions are the only realistic road to the &5&lenchanted items&r&7 this pack gates its endgame behind. One enchanted item costs &c&l288&r&7 of the base item. One enchanted &oblock&r&7 costs &c&l2592&r&7."
		""
		"&e&lMAKE THEM FASTER"
		"&7&l- &a&lCompactor&r&7 compresses the output in place"
		"&7&l- &a&lSuper Compactor 3000&r&7 goes straight to enchanted items"
		"&7&l- &a&lSolar Panel&r&7 speeds them up while the sun is out"
		"&7&l- &a&lAuto Smelter&r&7 turns ore into ingots with no furnace"
		""
		"&c&lThe tools are not craftable. &7Hoes, axes and sickles come from the Minion Tools shop and nowhere else."
		""
		"&7The &d&lPixelGO Minions&r&7 chapter covers the whole ladder."
	]
	quest.6CC8B1CC7EF60F0E.quest_subtitle: "&7Workers that never stop"
	quest.6CC8B1CC7EF60F0E.title: "&d&lMinions"
