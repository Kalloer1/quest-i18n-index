	quest.39F0F74FC60EF4CD.quest_desc: [
		"&7Same idea, a full tier heavier — and it moves up to the &b&lElite Table&r&7."
		""
		"&7Twelve Infused Alloys means twelve trips through the &bMetallurgic Infuser&7. This book is a test of whether your Mekanism line runs on its own yet."
		""
		"&e&lTip:&r &7Put it on a &eQuick Ball&7 or a &cRepeat Ball&7 — balls whose bonus already applies in the right situation."
	]
	quest.39F0F74FC60EF4CD.quest_subtitle: "&7Halfway up the ladder"
	quest.39F0F74FC60EF4CD.title: "&d&lCatch Rate III"
	quest.39F847FDA152635C.quest_desc: ["{quest.alola.description.10}"]
	quest.39F847FDA152635C.title: "{quest.alola.title.2}"
	quest.3A096578AAB672EA.quest_subtitle: "&7Common"
	quest.3A3A6DFA24D77E09.quest_desc: [
		"&5Level V&7 is the cap declared by the mod. There is nothing above it."
		""
		"&7Eight enchanted diamonds and four enchanted mithril is &f1 280&7 diamonds and &f640&7 mithril. But the &5&lUltimate Control Circuits&r&7 are the real lock: each one is an atomic alloy on an elite circuit, and atomic alloy wants &5Refined Obsidian&7 and &5Polonium&7-grade patience."
		""
		"&c&lThis book is a project, not a craft.&r"
		""
		"&e&lTip:&r &7The enchantment sits on the &nball&r&7, and the ball is consumed on the throw. Enchant a stack you keep for legendaries."
	]
	quest.3A3A6DFA24D77E09.quest_subtitle: "&7The maximum the enchantment allows"
	quest.3A3A6DFA24D77E09.title: "&5&lCatch Rate V"
	quest.3A481C17C7F6FE9E.quest_desc: [
		"&d&lCatch Rate&r&7 is an enchantment from the &6PixelGO&7 mod. It goes on &nnothing but a Poké Ball&r&7, and adds a flat capture bonus to every throw."
		""
		"&e&lWhy a table and not a machine?&r"
		"&7Because a machine &ncannot send an enchanted book to the client&r&7 unless its recipe serialiser has registry access — and since 1.21 enchantments live in a datapack registry. Get that wrong and the recipe packet fails and every player is kicked on join. It happened once already in this pack."
		"&7The table is only the bench: &nthe ingredients are all Mekanism&r&7."
		""
		"&e&lTip:&r &7Levels &fII&7 and &fIV&7 are not crafted. Put two books of the level below on an &7&lanvil&r&7, exactly like any vanilla enchantment."
		""
		"&c&lNever put this book in a shop&r&7 — for exactly the same reason it cannot come out of a machine."
	]
	quest.3A481C17C7F6FE9E.quest_subtitle: "&7An enchantment that only fits a Poké Ball"
	quest.3A481C17C7F6FE9E.title: "&d&lCatch Rate I"
