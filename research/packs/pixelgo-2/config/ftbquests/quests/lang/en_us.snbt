	quest.33FE04A0F3A44A79.title: "Acquire Sneasler"
	quest.343DAE11210361DC.quest_desc: [
		"&6&lWhat it adds&r"
		"&7- &fAndesite&7, &fGranite&7 and &fDiorite&7 pebbles from dirt and gravel."
