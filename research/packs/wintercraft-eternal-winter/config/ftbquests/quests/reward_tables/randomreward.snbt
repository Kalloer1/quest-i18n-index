		{ id: "41EB539EF9CF65FE", item: { components: { "minecraft:written_book_content": { author: "A Very Bored Scribe", pages: [ { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"This page intentionally left blank.\\n\\nJust kidding, you just wasted a page flip.\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"Why are you still reading this?\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"The author of this book is not responsible for lost time.\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"Page 80. Still nothing.\\n\\nYou're really committed.\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"This book is like a box of chocolates. Empty.\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"Almost there... or are you?\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"If you're reading this, you have too much free time.\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"Congratulations! You've wasted several minutes of your life.\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"Page 180. You're not going to find a secret here.\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"The cake is a lie. So is this book.\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"\"" }, { raw: "\"You stare at the blank page, then flip it over just to be sure.\\n\\n...\\n\\nYeah, still nothing.\\n\\nCongratulations. You've officially read every single word in this book. All zero of them. \"" }, { raw: "\"That takes dedication. Or boredom. Probably both.\\n\\nThe sky is judging you extra hard for this one.\"" } ], resolved: 1b, title: { raw: "An Empty Book" } } }, count: 1, id: "minecraft:written_book" } }
