	quest.5332B76236D8079C.quest_desc: ["&lThe &bSpawner Modification&r system from Apotheosis allows players to fully customize&b&l mob spawners&r&r, transforming them into powerful resource-generating machines. Using special modifiers, you can adjust spawn rates, activation range, mob limits, and many other properties to create highly efficient farming setups.&r"]
	quest.53BCDACA3D52AE68.quest_desc: ["It is time to generate lava without relying on conventional methods. Place Magma Blocks in the Squeezer and jump on it repeatedly to squeeze the lava out. Use pipes or buckets to collect it."]
	quest.53D0A51EEF758509.quest_desc: [""]
	quest.5503DDB4C77245A6.title: "Platinum"
	quest.552A69EBBE7999D1.title: "Uranium"
	quest.55AB22FAD1AB90AD.quest_desc: ["This quest is currently under production and is not yet available. It will be added soon in future updates!"]
