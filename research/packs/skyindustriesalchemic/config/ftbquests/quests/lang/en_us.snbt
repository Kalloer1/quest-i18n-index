	quest.57717FC754C3C309.quest_desc: ["Right-click with the Silkworm on a tree leaf. Wait for the infestation to spread (the leaves will turn white) and then break them using your Crook to obtain String."]
	quest.57717FC754C3C309.title: "Silkworms"
	quest.5916BE6E6EEB914D.quest_desc: [""]
	quest.591965F3EDAE59F7.quest_desc: ["The farmer block contains a whole crop farm in a single block. This helps to reduce lag and save space."]
