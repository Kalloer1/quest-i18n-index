	quest.49D30991BE91329A.quest_desc: ["Prevents all spawns of specified mobs within the selected chunk range (1x1 to 5x5). Right click on a mob with a Mob Filter, then add the filter to the pylon to block that mob."]
	quest.49FDD64E107C451A.title: "Zinc"
