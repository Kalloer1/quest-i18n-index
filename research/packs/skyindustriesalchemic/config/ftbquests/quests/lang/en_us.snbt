	quest.3CC83FB66A8B4675.quest_desc: ["The Sieve is your primary way of gathering resources. Place a mesh inside it, then right-click with blocks like Dirt, Gravel, Sand, or Dust to sift them. Different meshes and blocks will yield different resources, so always check the recipes!"]
	quest.3CC83FB66A8B4675.title: "Wooden Sieve"
	quest.3CEC76436E61F413.title: "Elite Machines"
	quest.3D9D127B907341D4.quest_desc: ["The auto trader works exactly line the trader block, except it automatically trades items for you. You can also automatically put items in and take items out with a hopper. The cooldown between trades is fully configurable."]
	quest.3E93A53134AA988B.quest_desc: [""]
	quest.419C3A5DEFE98866.quest_desc: ["This quest is currently under production and is not yet available. It will be added soon in future updates!"]
