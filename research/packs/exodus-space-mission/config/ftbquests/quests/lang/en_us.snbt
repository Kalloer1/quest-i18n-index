		"&dMine Ostrum and unlock the secrets of Martian technology! ⚒🔥"
	]
	quest.442A7FCD8390AE72.quest_subtitle: "&eCollect x10 Ostrum from Mars."
	quest.442A7FCD8390AE72.title: "&6&lMars Mission: Ostrum Hunt"
	quest.45C02BA617A092FC.quest_desc: [
