	quest.58F63AEBB7F5241A.quest_desc: [
		"&fThe Water Separator is a key machine in Stellaris."
		"&aIt splits water into &bOxygen &aand &cHydrogen,&f both essential for your journey."
		"&bOxygen will keep you alive in space, while Hydrogen will later power advanced rockets and upgrades."
		"&dCraft your first Water Separator and prepare for true space survival!"
		""
		"{image:kubejs:textures/imagenestellaris/interfaz_water_separator.png width:100 height:100 align:center}"
	]
