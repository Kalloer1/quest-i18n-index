	quest.3523A4FBB2BB999C.title: "&b&lCraft an Oxygen Tank"
	quest.356CD9F06CC53464.quest_desc: [
		"&fYour next journey leads to the mysterious planet &dVenus&f."
		"&aPrepare carefully—its thick atmosphere, extreme heat, and dangerous terrain &fmake it one of the most hostile places in the solar system."
		"&bVenus is rich with rare ores and unique alien life, offering both risk and reward."
		"&dBrave the dangers of Venus and uncover its hidden treasures! 💫🪐"
	]
	quest.356CD9F06CC53464.quest_subtitle: "&eLaunch your Rocket and land on Venus."
	quest.356CD9F06CC53464.title: "&d&lTravel to Venus"
	quest.36C32C9F7271DB7B.quest_desc: [
		"&fThe Vacuumator removes moisture from food and seals it inside cans."
		"&aPlace cooked food and empty cans inside &fto produce preserved meals ready for your journey."
		"&bThese space rations will last much longer than normal food and are essential for survival on distant planets."
		"&dCraft a Vacuumator and start preparing food for your interstellar adventures! 🍗🚀"
	]
	quest.36C32C9F7271DB7B.quest_subtitle: "&eBuild a Vacuumator to preserve food for space travel."
	quest.36C32C9F7271DB7B.title: "&5&lCraft a Vacuumator"
	quest.4219936680C3A81D.quest_desc: [
		"&fMercury’s extreme conditions forged a unique variant of &7Iron Ore&f."
		"&aSeek it out as proof of your exploration on this hostile planet.&f"
