	quest.6657B2892F72C3EE.quest_desc: [
		"&fSteel is the foundation of your journey among the stars."
		"&aMine &8Steel Ore &aor smelt &7Heavy Iron &ainto steel ingots."
		"&bWith steel, you’ll be able to craft machines, pipes, cables, and even your very first rocket parts."
		"&dCollect at least ten ingots to continue advancing towards space exploration!"
		""
		"{image:kubejs:block/minando_steel_ore width:100 height:100 align:center}"
	]
	quest.6657B2892F72C3EE.quest_subtitle: "&eCollect x10 Steel Ingots to unlock your first steps in Stellaris technology."
	quest.6657B2892F72C3EE.title: "&8&lGather Steel Ingots"
	quest.68DBCC34C70AEF1A.quest_desc: [
		"&fOil is the key ingredient for producing rocket fuel."
		"&aWith the Oil Finder, you can scan the land &fto detect hidden oil reserves in your world."
		"&bUse it to locate a suitable spot before building your Pumpjack and refinery setup."
		"&dCraft the Oil Finder and take the first step toward fueling your journey to the stars!"
		""
		""
		"{image:kubejs:textures/imagenestellaris/oil_finder.png width:100 height:100 align:center}"
		"{image:kubejs:block/recolectando_petroleo width:100 height:100 align:center}"
	]
	quest.68DBCC34C70AEF1A.quest_subtitle: "&eCreate an Oil Finder to locate underground oil deposits."
	quest.68DBCC34C70AEF1A.title: "&6&lCraft an Oil Finder"
	quest.6B802D9F4E0A8A73.quest_desc: [
		"&fBeware the &5Star Crawlers&f, dangerous creatures that lurk among lunar craters."
		"&bHunt them down to protect your mission and claim dominance over the Moon."
		"&dFace the Star Crawlers and prove your courage! ✨🐛"
	]
	quest.6B802D9F4E0A8A73.quest_subtitle: "&eDefeat 2 Star Crawlers on the Moon."
	quest.6B802D9F4E0A8A73.title: "&5&lMoon Mission: Star Crawler Hunt"
	quest.6C4B5F02B8A6AFD0.quest_desc: [
		"&fThe Fuel Refinery is essential for transforming raw &aOil &finto &6Rocket Fuel&f."
		"&aPlace it next to your oil storage or connect it with pipes &fto feed in the oil."
		"&bMake sure the refinery is powered, and it will process the oil into fuel you can store in buckets or tanks."
		"&dCraft a Fuel Refinery and take the final step toward launching your first rocket!"
		""
		"{image:kubejs:textures/imagenestellaris/interfaz_fuel_refinery.png width:100 height:100 align:center}"
	]
	quest.6C4B5F02B8A6AFD0.quest_subtitle: "&eBuild a Fuel Refinery to convert oil into usable rocket fuel."
	quest.6C4B5F02B8A6AFD0.title: "&c&lCraft a Fuel Refinery"
	quest.7228C1E21A645EE9.quest_desc: [
		"&fVenus is inhabited by hostile &cPygros&f, aggressive creatures that will not hesitate to attack."
		"&aHunt them down &fto secure your exploration zone."
		"&bTheir presence marks the first challenge of surviving Venus."
		"&dDefeat the Pygros and show your strength! ⚔️🔥"
	]
	quest.7228C1E21A645EE9.quest_subtitle: "&eDefeat 3 Pygros on Venus."
	quest.7228C1E21A645EE9.title: "&c&lVenus Mission: Pygro Hunt"
	quest.72E4DF206C33D50D.quest_desc: [
		"&fThe Rocket Station is the core structure where your first rocket will be built."
		"&aCraft it and prepare the necessary materials for assembly."
		"&bThis station will guide you through the crafting of fins, nose cone, engine, and steel blocks."
		"&dBegin here—your path to the stars starts with the Rocket Station!"
		""
		"{image:kubejs:textures/imagenestellaris/interfaz_rocket_station.png width:100 height:100 align:center}"
	]
	quest.72E4DF206C33D50D.quest_subtitle: "&eBuild a Rocket Station to assemble your spacecraft."
	quest.72E4DF206C33D50D.title: "&b&lCraft a Rocket Station"
	quest.776DACB7E66AAE5A.quest_desc: [
		"&fYour Rocket cannot leave the ground without &6Rocket Fuel&f."
		"&aUse buckets of fuel from your refinery &fto pour them into the Rocket’s fuel tank."
		"&bMake sure to fill it completely—running out mid-flight will leave you stranded among the stars."
		"&dFuel your Rocket and get ready for liftoff! 🚀"
		""
		"{image:kubejs:block/metiendo_cubo_vacio_fuel_refinery width:100 height:100 align:center}"
	]
	quest.776DACB7E66AAE5A.quest_subtitle: "&eFill your Rocket with fuel to prepare for launch."
	quest.776DACB7E66AAE5A.title: "&6&lFuel the Rocket"
	quest.7789262E351217E5.quest_desc: [
		"&fDeep within Mercury’s crust lies &2Uranium&f, a powerful radioactive resource."
		"&aMine it carefully—it will be vital for advanced energy systems and rocket upgrades.&f"
		"&bHarness the energy of Uranium to push your technology further."
		"&dExtract Uranium and claim Mercury’s hidden power! ☢️⛏️"
	]
	quest.7789262E351217E5.quest_subtitle: "&eMine x5 Uranium on Mercury."
	quest.7789262E351217E5.title: "&2&lMercury Mission: Uranium Extraction"
