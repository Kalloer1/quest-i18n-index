	quest.1E09D59409A60C59.quest_desc: [
		"&fYour first destination beyond Earth is the &f&lMoon&f."
		"&aPrepare your Rocket with enough fuel and oxygen &fto survive the harsh environment."
		"&bThe Moon has lower gravity and unique resources like &7Dash Ingots&b, which are vital for advanced technology."
		"&dTake your first step on the Moon’s surface and begin your true space adventure! 🌙🚀"
	]
	quest.1E09D59409A60C59.quest_subtitle: "&eLaunch your Rocket and land on the Moon."
	quest.1E09D59409A60C59.title: "&f&lTravel to the Moon"
	quest.232968ADF31E68D5.quest_desc: [
		"&fMercury is home to the hostile &6Moglers&f, dangerous creatures adapted to the planet’s extreme heat."
		"&aFace them in combat &fto secure your place on this fiery world."
		"&bSurvive their attacks and prove your strength."
		"&dDefeat Moglers and tame the dangers of Mercury! 🔥👹"
	]
	quest.232968ADF31E68D5.quest_subtitle: "&eDefeat 2 Moglers on Mercury."
	quest.232968ADF31E68D5.title: "&6&lMercury Mission: Mogler Hunt"
	quest.23704640F0AC8363.quest_subtitle: "&eCollect x10 Desh, x10 Ice Shards, and see moon iron"
	quest.23704640F0AC8363.title: "&7&lMoon Mission: Resource Gathering"
	quest.24D25D43AD833305.quest_desc: [
		"&fPipes are essential for moving fluids between machines."
		"&aTier 1 Pipes &fallow you to transfer water from your pump into the Water Separator."
		"&bWithout them, your system won’t function and oxygen production will not be possible."
		"&dCraft at least three Tier 1 Pipes to set up your first fluid network!"
		""
		"{image:kubejs:block/poniendo_pipes_tier1 width:100 height:100 align:center}"
	]
	quest.24D25D43AD833305.quest_subtitle: "&eCraft x3 Tier 1 Pipes to transport fluids."
	quest.24D25D43AD833305.title: "&2&lCraft Tier 1 Pipes"
	quest.28074A1033B6FFAC.quest_desc: [
		"&fCables are essential for transferring energy between your generators and machines."
		"&aTier 1 Cables are made using &8Steel Nuggets &aand will allow you to connect your early setup, such as pumps and separators."
		"&bWith cables, your machines will finally come to life."
		"&dCraft at least ten to prepare your base for the path to the stars!"
		""
		"{image:kubejs:block/poniendo_cables_tier1 width:100 height:100 align:center}"
	]
