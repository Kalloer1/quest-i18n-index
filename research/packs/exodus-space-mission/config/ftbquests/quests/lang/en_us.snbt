	file.0000000000000001.title: " Exodus"
	quest.080F9094D84CB0F8.quest_desc: [
		"&fIn space, normal food won’t last long."
		"&aBy crafting cans, you can preserve meals &fand prepare them for storage in your spaceship."
		"&bUse nuggets and glass bottles to seal food inside, keeping it fresh and ready to eat on your journey."
		"&dCraft your first food cans and ensure you won’t go hungry among the stars! 🍖🚀"
	]
	quest.080F9094D84CB0F8.quest_subtitle: "&eCreate cans to safely store your food for space travel."
	quest.080F9094D84CB0F8.title: "&d&lCraft Food Cans"
	quest.0D4FBF34A1AFD894.quest_desc: [
		"&fAmong the rocky Martian terrain, rare &bMars Diamonds&f can be found."
		"&aThey shine brightly even under the red skies of Mars.&f"
		"&bSeek out these precious gems as proof of your exploration."
		"&dDiscover Mars Diamond and claim the riches of the cosmos! 💎🪐"
	]
	quest.0D4FBF34A1AFD894.quest_subtitle: "&eFind Mars Diamond ore."
	quest.0D4FBF34A1AFD894.title: "&b&lMars Mission: Diamond Discovery"
	quest.102BD5E1F415472A.quest_desc: [
		"&fWith your Rocket fully fueled and placed on the launch pad, it’s time to take off!"
		"&aRight-click to enter the Rocket, then press &eSPACE &ato start the countdown.&f"
		"&bAs the engines ignite, hold tight—your journey beyond the Overworld is about to begin."
		"&dBlast off and explore the stars! 🌌🚀"
