	]
	quest.55AD5F4C1CDDCE35.quest_subtitle: "&eBuild a Tier 1 Power Bank to store energy for your machines."
	quest.55AD5F4C1CDDCE35.title: "&9&lCraft a Tier 1 Power Bank"
	quest.55F40DA5E87CBEF7.quest_desc: [
		"&fDeep beneath the Martian crust lies &5Plutonium&f, a powerful radioactive resource."
		"&aMine it carefully—it is essential for advanced rocket upgrades and reactors.&f"
