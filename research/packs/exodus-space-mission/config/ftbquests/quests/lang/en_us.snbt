	quest.518D71CFF03E0A96.quest_desc: [
		"&fAn Oxygen Distributor allows you to fill enclosed rooms with oxygen."
		"&aPlace it inside your base and connect it to an oxygen supply &fto make a safe area for living on other planets."
		"&bThis machine is essential for long-term colonies beyond Earth."
		"&dCraft one and bring life to the void of space!"
	]
