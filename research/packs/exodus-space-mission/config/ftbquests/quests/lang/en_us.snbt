	quest.128AF83728356D60.title: "&9&lWelcome to the Stellaris Mod"
	quest.13253CAF5CE127D8.quest_desc: [
		"&fThe Moon is home to strange and hostile life forms."
		"&aYour first challenge is to face an &cAlien &fthat lurks in the lunar surface."
		"&bDefeat it to prove you can survive in hostile environments."
		"&dConquer your first extraterrestrial foe! 👽"
	]
	quest.13253CAF5CE127D8.quest_subtitle: "&eDefeat 1 Alien on the Moon."
	quest.13253CAF5CE127D8.title: "&8&lMoon Mission: Alien Encounter"
	quest.14B3B7C8792F190E.quest_desc: [
		"&fVenus holds unique variants of common ores, including &8Coal&f."
		"&aSeek out this resource to aid in energy production during your stay.&f"
		"&bFinding Venus Coal proves you are uncovering the planet’s hidden layers."
		"&dDiscover Venus Coal and fuel your journey! 🔥⛏️"
	]
	quest.14B3B7C8792F190E.quest_subtitle: "&eFind Venus Coal."
	quest.14B3B7C8792F190E.title: "&8&lVenus Mission: Coal Discovery"
	quest.16870D3095D49307.quest_desc: [
