		"{image:kubejs:textures/imagenestellaris/bomba_agua_rio_oceano.png width:150 height:100 align:center}"
	]
	quest.2B17A71A67B4BE5F.quest_subtitle: "&eBuild a Water Pump to supply fluids for your machines."
	quest.2B17A71A67B4BE5F.title: "&b&lCraft a Water Pump"
	quest.3045C474847930EF.quest_desc: [
		"&fIron on Mars is more resilient than Earth’s, forged under alien conditions."
		"&aMine it to craft stronger tools and machines &fneeded for your colony."
		"&bMars Iron will become the backbone of your technology on this planet."
		"&dSecure your iron supply and fortify your Martian base! ⛏🪐"
	]
	quest.3045C474847930EF.quest_subtitle: "&eCollect x10 Mars Iron."
	quest.3045C474847930EF.title: "&7&lMars Mission: Iron Supply"
	quest.3523A4FBB2BB999C.quest_desc: [
		"&fAn Oxygen Tank is essential for survival in space."
		"&aFill it using your Water Separator &fto carry oxygen wherever you go."
		"&bWhether exploring the Moon, Mars, or distant galaxies, your Oxygen Tank will keep you alive in places without air."
