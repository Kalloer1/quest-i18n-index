{
	chapter.42D8D6D8F074836C.title: "Through the Seasons"
	quest.045A84938748AB0E.quest_desc: ["In addition to farming crops, you can turn flowers into seeds and begin a big garden! Make sure to plant flowers that are in season, or else they'll have trouble growing."]
	quest.045A84938748AB0E.quest_subtitle: "You can grow flowers!"
	quest.045A84938748AB0E.title: "Growing Flowers"
	quest.04CD458783662E2C.quest_subtitle: "Catch 250 fish."
	quest.04CD458783662E2C.title: "Adept Angler"
	quest.053C629AAD01E2E8.quest_desc: ["Brew a potion of ice resistance to better endure the cold."]
	quest.053C629AAD01E2E8.quest_subtitle: "The cold never bothered me anyway."
	quest.0A22FA9491142381.quest_desc: ["Kill the Ender Dragon. Good for you!"]
	quest.0A22FA9491142381.quest_subtitle: "Good luck"
	quest.0A22FA9491142381.title: "Free the End"
	quest.0C5F2ACA4A524929.quest_desc: ["Crates are very rare treasures you can encounter while fishing. Who knows what could be inside?"]
	quest.0C5F2ACA4A524929.quest_subtitle: "Reel in a crate while fishing."
	quest.0C5F2ACA4A524929.title: "That's No Fish!"
	quest.0D900F0AED4AFBC7.quest_desc: ["Craft dragonfin boots by combining netherite boots, dragon's breath, and a dragon fish in a smithing table."]
	quest.0D900F0AED4AFBC7.quest_subtitle: "Double jumping!"
	quest.133F08D095876EE8.quest_desc: ["Collect every crop."]
	quest.133F08D095876EE8.quest_subtitle: "A good farmer grows a wide variety of crops."
	quest.133F08D095876EE8.title: "Master Farmer"
	quest.169DCFF5304B1264.quest_desc: ["Locate a Nether Fortress."]
	quest.169DCFF5304B1264.quest_subtitle: "It's dangerous!"
	quest.169DCFF5304B1264.title: "A Terrible Fortress"
	quest.18D7A8528F8022CF.quest_desc: ["Search for and obtain a soul sprout. When eaten, it provides temporary relief to the cold."]
	quest.18D7A8528F8022CF.quest_subtitle: "Cool down on the go!"
	quest.197EF939BA5FF9EC.quest_desc: ["Obtain a fishing rod. Fish are a good way of getting a reliable source of food when other options like plants or animals aren't available."]
	quest.197EF939BA5FF9EC.quest_subtitle: "Time to fish!"
	quest.197EF939BA5FF9EC.title: "Fishing 101"
	quest.2A9D5BD70C537562.quest_desc: ["Visit the Nether, a crucial next step to beat the game."]
	quest.2A9D5BD70C537562.quest_subtitle: "Is it hot in here?"
	quest.2A9D5BD70C537562.title: "The Nether"
	quest.31772D9004A9A0FB.quest_desc: ["The icebox can be used to freeze filled waterskins you put inside it. If you put a smokestack on it, it will cool the room."]
	quest.31772D9004A9A0FB.quest_subtitle: "A must-have for any hot day!"
	quest.319962C11CC4833F.quest_desc: ["Craft a thermolith, which detects the surrounding temperature and outputs a signal based on how hot it is. Useful for automating your home's temperature control or making other heat-based contraptions."]
	quest.319962C11CC4833F.quest_subtitle: "Redstone with temperature!"
	quest.32D210C3C3AB6010.quest_desc: ["While insulating armor you already crafted is an option, you can also craft goat fur armor to keep yourself warm."]
	quest.32D210C3C3AB6010.quest_subtitle: "Craft goat fur armor!"
	quest.32D210C3C3AB6010.title: "Goat Fur Armor"
	quest.358D67F16D81DC44.quest_desc: ["Craft a waterskin. When filled with water and used, it will quickly regulate the player's temperature."]
	quest.358D67F16D81DC44.quest_subtitle: "Like a water balloon!"
	quest.35F95C9A540C078B.quest_subtitle: "Catch 50 fish."
	quest.35F95C9A540C078B.title: "Apprentice Angler"
	quest.37243934BF65E2D8.quest_desc: ["The angling table can be used to add different hooks and lines to your fishing rod, each providing a different use."]
	quest.37243934BF65E2D8.quest_subtitle: "Juice up your fishing rod!"
	quest.394E5493868E70AC.quest_desc: ["Obtain a campfire, which can be used in cold areas to warm the player up. Campfires are the cheapest early game tool to regulate temperature. While fairly primitive, it will keep you alive."]
	quest.394E5493868E70AC.quest_subtitle: "This is a basic tool that should help you survive the winter."
	quest.394E5493868E70AC.title: "Begone, Cold!"
	quest.3BA8055A132C215C.quest_desc: ["Obtain a hearth. The hearth can be fueled using items like coal and ice. When activated using redstone, it regulates the temperature inside your home."]
	quest.3BA8055A132C215C.quest_subtitle: "Temperature relief guaranteed!"
	quest.414869FEF4C49F0C.quest_desc: ["Visit the End, the final frontier. Be careful, this dimension is very cold."]
	quest.414869FEF4C49F0C.quest_subtitle: "Or the beginning?"
	quest.414869FEF4C49F0C.title: "The End"
	quest.43FD02195E8A9164.quest_desc: ["This questbook will help you learn how to use the various features each mod provides. Don't use this book as a step-by-step tutorial on how to play the modpack. That's boring. Instead, use it as a tool to save you whenever you get stuck. Have fun!"]
	quest.43FD02195E8A9164.quest_subtitle: "It's time to get started!"
	quest.43FD02195E8A9164.title: "Through the Seasons"
	quest.44C1F6BA6DBA8DEC.quest_desc: ["Put down a Cooking Pot and start preparing meals!"]
	quest.44C1F6BA6DBA8DEC.quest_subtitle: "Yum!"
	quest.44C1F6BA6DBA8DEC.title: "Dinner's Served!"
	quest.46979CFF9DC96A13.quest_desc: ["Upgrading your fishing rod is a necessary step to catching better fish and items in unique areas."]
	quest.46979CFF9DC96A13.quest_subtitle: "A big upgrade!"
	quest.46979CFF9DC96A13.title: "Diamond Fishing Rod"
	quest.4A265FC21FE6A97A.quest_desc: ["Obtain one of every farmable flower and flower seed! You've got a green thumb!"]
	quest.4A265FC21FE6A97A.quest_subtitle: "So many colors!"
	quest.4A265FC21FE6A97A.title: "Botanist"
	quest.4AE39442C6823712.quest_desc: ["The boiler can be used to warm up filled waterskins you put inside it. If you put a smokestack on it, it will warm up the room."]
	quest.4AE39442C6823712.quest_subtitle: "Don't stick your hand in it."
	quest.4C38E8C7A18C2F78.quest_desc: ["While insulating armor you already crafted is an option, you can also craft chameleon scale armor. This armor set slowly adapts to the surrounding environment, providing a moderate amount warm or cold insulation depending on where you live. Useful for temperate areas with hot summers and cold winters."]
	quest.4C38E8C7A18C2F78.quest_subtitle: "Craft chameleon scale armor!"
	quest.4C38E8C7A18C2F78.title: "Chameleon Scale Armor"
	quest.4CA883C1E63944CC.quest_subtitle: "Catch 1000 fish."
	quest.4CA883C1E63944CC.title: "Experienced Angler"
	quest.5E61F83A67C41168.quest_desc: ["Hunting and gathering isn't sustainable year-round. The earlier you start a farm, the easier surviving will be!"]
	quest.5E61F83A67C41168.quest_subtitle: "One day, this will be a beautiful field!"
	quest.5E61F83A67C41168.title: "A Seedy Place"
	quest.65E6820883C76D7F.quest_subtitle: "Catch 5000 fish."
	quest.65E6820883C76D7F.title: "Master Angler"
	quest.661F180BC98267E5.quest_desc: ["Obtain a soulspring lamp. When held in the Nether dimension, it will cool the surrounding area. Use soul sprout to refuel the lamp. The soulspring lamp is a convenient tool to cool down in the Nether without needing to carry around waterskins."]
	quest.661F180BC98267E5.quest_subtitle: "Survive the heat of the Nether."
	quest.67C06A96DDA7C569.quest_desc: ["Craft a sewing table, which can be used to provide insulation for your armor and increase your resistance to extreme temperatures. You can insulate your armor using goat fur, wool, leather, hoglin hide, and chameleon molt."]
	quest.67C06A96DDA7C569.quest_subtitle: "Proper insulation is a necessity to survive many climates."
	quest.7194C26C2EAE8CDB.quest_desc: ["Collect one of every overworld sapling type. You can find many of them in special loot chests scattered across the land."]
	quest.7194C26C2EAE8CDB.quest_subtitle: "I speak for the trees."
	quest.7194C26C2EAE8CDB.title: "Forager of Trees"
	quest.76752A1205DC98B7.quest_desc: ["The soul campfire is a rudimentary way to cool yourself down in hot climates. Just place it down and stand next to it!"]
	quest.76752A1205DC98B7.quest_subtitle: "Save yourself from overheating!"
	quest.76752A1205DC98B7.title: "Begone, Heat!"
	quest.767EAF428B073347.quest_desc: ["Skillets let you cook on the go. Stand near heat, then hold food in your other hand!"]
	quest.767EAF428B073347.quest_subtitle: "Cooking on the go!"
	quest.767EAF428B073347.title: "Portable Cooking"
	quest.7B71E794B1D275D5.quest_desc: ["Successfully endure an entire year."]
	quest.7B71E794B1D275D5.quest_subtitle: "That wasn't so bad."
	quest.7E3827A6D9B903A5.quest_subtitle: "Catch 10 fish."
	quest.7E3827A6D9B903A5.title: "Novice Angler"
	quest.7FA16C114203442B.quest_desc: ["While insulating armor you already crafted is an option, you can also craft hoglin armor to keep yourself cool."]
	quest.7FA16C114203442B.quest_subtitle: "Craft hoglin armor!"
	quest.7FA16C114203442B.title: "Hoglin Armor"
	task.02697BDAD2AC8DE0.title: "Through the Seasons"
	task.191266986B0B19FC.title: "Spring After Autumn"
	task.35F0435A5692D01F.title: "test"
}
