	quest.8E24CFB7930561AD.quest_desc: [
		"&e&lOpen crates from the quest book&r"
		"&fThe three exchanges below are repeatable. Open the tier you want and submit one matching EliteTensura key. The matching virtual crate opens automatically. The shop runs EliteTensura's real crate-opening logic, including its configured reward pool, weights, skill handling, soul-point rewards, and opening screen.&r"
		""
		"&cSubmitting the key consumes it. The crate is not a physical item reward; the exchange immediately rolls and opens the matching virtual crate.&r"
		""
		"&a&lWhere keys come from&r"
		"&fKeys are not craftable. EliteTensura can award them from other crates, Calamity contribution payouts, wars, nation missions, chat trivia, server events, and administrator grants. Some sources can be disabled in the server configuration.&r"
	]
	quest.8E24CFB7930561AD.quest_subtitle: "Trade keys for immediate crate rolls"
	quest.8E24CFB7930561AD.title: "EliteTensura Crate Shop"
