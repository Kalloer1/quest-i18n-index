	]
	quest.685666AF6847AEF8.quest_subtitle: "Unique skill • TR: Nightmare"
	quest.685666AF6847AEF8.title: "Handler"
	quest.685C6210C9B5A9EB.quest_desc: [
		"&e&lWhat it does&r"
		"&fGain access to the intermediate Earth Spirit Magic and boost your earth attacks while buffing yourself and debuffing enemies.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Become a TR: Origins True Dragon and be assigned the unclaimed Earth elemental seat. The skill is granted automatically when that seat is assigned.&r"
		""
		"&f1. &eTR: Origins True Dragon route:&f become the True Dragon race and receive an unclaimed elemental seat. The addon randomly assigns one available Abyss, Earth, Scorch, Frost, or Storm seat; receiving Earth grants this skill automatically. Each elemental seat can have only one owner per world, so this route cannot be targeted reliably on an established server.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: Magic Earth Transform — completes when you learn it&r"
		"&8The tracker verifies the resulting skill; addon-specific counters and random rolls are not exposed to FTB Quests.&r"
	]
	quest.685C6210C9B5A9EB.quest_subtitle: "Extra skill • TenSura: Reincarnated"
	quest.685C6210C9B5A9EB.title: "Magic Earth Transform"
