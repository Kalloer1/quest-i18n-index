	quest.595962280EA22D1D.quest_desc: [
		"&e&lWhat it does&r"
		"&fSpeed up your body’s natural regeneration to increase your survivability.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Guaranteed kill grant (default config): defeat tensura:supermassive_slime; the Skill Obtain addon awards this skill at 100% default chance.&r"
		""
		"&f2. Guaranteed kill grant (default config): defeat tensura_neb:rimuru_ogre_fight; the Skill Obtain addon awards this skill at 100% default chance.&r"
		""
		"&f3. Guaranteed kill grant (default config): defeat tensura:orc_disaster; the Skill Obtain addon awards this skill at 100% default chance.&r"
		""
		"&f4. Choose or evolve into one of the races listed below. The race grants this skill automatically.&r"
		""
		"&f5. Automatic acquisition check: reach 500 combined kills across tensura:slime, tensura:metal_slime, and tensura:supermassive_slime. Trigger a normal EP update after satisfying it (for example by defeating another mob) so TenSura re-evaluates learnable skills.&r"
		""
		"&f6. Steal it from one of the mobs below with Gluttony. Either make the mob your subordinate and use Gluttony's skill-retrieval mode, or kill it with Corrosion mode. This only works for allowed Common, Extra, Intrinsic, or Resistance skills, and another mod can still block the attempt.&r"
		""
		"&6&lMobs that use it&r"
		"&fAxolotl (minecraft:axolotl); Crystal Glutton (magicule_glutton:crystal_glutton); Ender Dragon (minecraft:ender_dragon); Magicule Glutton (magicule_glutton:magicule_glutton); Metal Slime (tensura:metal_slime); Okami (mysticism:okami); Clawdian (cataclysm:clawdian); Ender Golem (cataclysm:ender_golem); Frostmaw (mowziesmobs:frostmaw); Hydra (twilightforest:hydra); Infernal Dragon (block_factorys_bosses:infernal_dragon); Lich (twilightforest:lich); Maledictus (cataclysm:maledictus); Sculptor (mowziesmobs:sculptor); Scylla (cataclysm:scylla); Snow Queen (twilightforest:snow_queen); The Leviathan (cataclysm:the_leviathan); Valkyrie Queen (aether:valkyrie_queen); Yeti (block_factorys_bosses:yeti)&r"
		"&fOrc Disaster (tensura:orc_disaster); Orc Lord (tensura:orc_lord); Slime (minecraft:slime); Slime (tensura:slime); The Dead King (irons_spellbooks:dead_king); Wither (minecraft:wither)&r"
		"&8A mob having the skill does not guarantee a drop. Use one of the learning methods above.&r"
		""
		"&d&lRaces that grant it&r"
		"&fAbyssal Dragonewt (ascension:abyssal_dragonewt); Ancient Giant (tensura:ancient_giant); Archangel (ascension:archangel); Ascended Djinn (ascension:ascended_djinn); Axolotl (trnightmare:axolotl); Axolotl Knight (trnightmare:axolotl_knight)&r"
		"&fAxolotl Steel Spirit (trnightmare:axolotl_steel_spirit); Axolotl Steel Spirit Dragon (trnightmare:axolotl_steel_dragon); Axolotl Water Spirit (trnightmare:axolotl_water_spirit); Axolotl Water Spirit Dragon (trnightmare:axolotl_water_dragon); Axolotl Wizard (trnightmare:axolotl_wizard); Beast Lord (tensura:beast_lord)&r"
		"&fBeastfolk (tensura:beastfolk); Blood Noble (ascension:blood_noble); Bog Ancient (ascension:bog_ancient); Chaos Dragon (ascension:chaos_dragon); Chaotic Deity (ascension:chaotic_deity); Corrupted Dragonkin (ascension:corrupted_dragonkin)&r"
		"&fCosmic Deity (ascension:cosmic_deity); Demon Slime (tensura:demon_slime); Divine Angel (ascension:divine_angel); Divine Beast (tensura:divine_beast); Divine Fox (stextras:divine_fox); Divine Fox (trnightmare:divine_fox)&r"
		"&fDivine Giant (tensura:divine_giant); Divine Oni (tensura:divine_oni); Divine Saiyan (elitetensura:divine_saiyan); Divine Tengu (mysticism:divine_tengu); Divine Vampire (tensura:divine_vampire); Elder Bloodfiend (ascension:elder_bloodfiend)&r"
		"&fEnder Dragonewt (ascension:ender_dragonewt); Enlightened Ogre (tensura:enlightened_ogre); Fallen Angel (ascension:fallen_angel); Fledgling Bloodfiend (ascension:fledgling_bloodfiend); Frog Monarch (ascension:frog_monarch); Ghoul (tensura:ghoul)&r"
		"&fGiant Dancer (trnightmare:giant_dancer); Giant Frog (ascension:giant_frog); Giant Warrior (trnightmare:giant_warrior); God Slime (tensura:god_slime); Greater Mystic Fox (trnightmare:greater_mystic_fox); High Class Saiyan (elitetensura:high_saiyan)&r"
		"&fInfinite Djinn (ascension:infinite_djinn); Kindred Bloodfiend (ascension:kindred_bloodfiend); Lesser Ender Dragon (trnightmare:lesser_ender_dragon); Lesser Fairy (trnightmare:lesser_fairy); Lesser Giant (trnightmare:lesser_giant); Lesser Goddess (trnightmare:lesser_goddess)&r"
		"&fLesser Mystic Fox (trnightmare:lesser_mystic_fox); Lower-Class Demon (trnightmare:lower_class_demon); Medium Ender Dragon (trnightmare:medium_ender_dragon); Metal Slime (tensura:metal_slime); Mystic Fox (stextras:mystic_fox); Mystic Oni (tensura:mystic_oni)&r"
		"&fNinehead (trnightmare:ninehead); Ninetail (stextras:ninetail); Ninetail (trnightmare:ninetail); Omniversal Djinn (ascension:omniversal_djinn); Orc Disaster (tensura:orc_disaster); Orc Lord (tensura:orc_lord)&r"
		"&fPhantom Djinn (ascension:phantom_djinn); Poison Toad (ascension:poison_toad); Primordial Djinn (ascension:primordial_djinn); Progenitor Bloodfiend (ascension:progenitor_bloodfiend); Royal Djinn (ascension:royal_djinn); Salamander (trnightmare:salamander)&r"
		"&fSalamander Assassin (trnightmare:salamander_assassin); Salamander Fire Spirit (trnightmare:salamander_fire_spirit); Salamander Fire Spirit Dragon (trnightmare:salamander_fire_dragon); Salamander Poison Spirit (trnightmare:salamander_poison_spirit); Salamander Poison Spirit Dragon (trnightmare:salamander_poison_dragon); Salamander Warlock (trnightmare:salamander_warlock)&r"
		"&fSeraphim (ascension:seraphim); Slime (tensura:slime); Soul Beast (stextras:soul_beast); Soul Beast (trnightmare:soul_beast); Sovereign Djinn (ascension:sovereign_djinn); Spirit Beast (tensura:spirit_beast)&r"
		"&fSpirit Oni (tensura:spirit_oni); Swamp Sovereign (ascension:swamp_sovereign); Tengu (mysticism:tengu); Tengu Saint (mysticism:tengu_saint); Trickster Djinn (ascension:trickster_djinn); Vampire (tensura:vampire)&r"
		"&fVampire Lord (tensura:vampire_lord); Vampire Overcomer (tensura:vampire_overcomer); Venom Lord (ascension:venom_lord); Void Dragonewt (ascension:void_dragonewt); Whisper Djinn (ascension:whisper_djinn); Wishbound Djinn (ascension:wishbound_djinn)&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: Self-Regeneration — completes when you learn it&r"
		"&8These tasks only track progress; they never grant or evolve a skill.&r"
	]
