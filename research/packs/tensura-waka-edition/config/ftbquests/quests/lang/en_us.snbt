	quest.5444336551D47536.quest_desc: [
		"&e&lWhat you need&r"
		"&eEP: &f400,000 &8(configurable default)&r"
		"&eBoss kills: &f4 &8(configurable default)&r"
		""
		"&e&lComes from&r"
		"&fBeast Lord&8 — Normal evolution&r"
		"&fBeastfolk&8 — Awakening evolution&r"
		""
		"&e&lWhere this path leads&r"
		"&fDivine Beast&8 — Normal evolution, Awakening evolution&r"
		""
		"&a&lHow to evolve&r"
		"&f1. Raise your base maximum EP to at least 400,000. Defeat eligible enemies to grow permanent Aura/Magicules, then reopen the TenSura evolution menu. Temporary or equipment bonuses may fill the displayed EP tracker without meeting this base-EP condition.&r"
		"&f2. Defeat 4 TenSura bosses. This evolution uses TenSura's lifetime boss-defeat count.&r"
		"&f3. Open the TenSura evolution menu and select this race. The quest does not perform the evolution for you.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Maximum EP: 400,000 — approximate: FTB reads total maximum EP; race checks base maximum EP&r"
		"&f• Bosses defeated: 4 — exact lifetime custom-stat counter; may predate this quest&r"
		"&f• Current race: Spirit Beast — checks your current race&r"
		"&8Trackers show your progress, but you still evolve through TenSura's evolution menu.&r"
		"&8Naming, body/form state, location conditions, item-use counts, and some addon counters cannot be tracked automatically. Follow the steps above whenever no tracker is shown.&r"
	]
	quest.5444336551D47536.quest_subtitle: "Evolution • TenSura: Reincarnated"
	quest.5444336551D47536.title: "Spirit Beast"
	quest.545152F56C748479.quest_desc: [
		"Defeat Vesper 100 times after this quest pack is installed."
		""
		"&aReward: &f+1,000 maximum EP&r"
		"&8This milestone tracks alongside the other kill goals for this mob, so every kill counts toward all of them.&r"
	]
	quest.545152F56C748479.title: "Vesper: 100 Kills"
	quest.546BC82CD2E16D8D.quest_desc: [
		"&e&lWhat you need&r"
		"&eRequires awakening"
		"&eMust be named"
		"&eRequires a physical body"
		""
		"&e&lComes from&r"
		"&fArch Angel&8 — Normal evolution, Awakening evolution, Harvest Festival evolution&r"
		"&fGreater Angel&8 — Awakening evolution&r"
		"&fLesser Angel&8 — Awakening evolution&r"
		""
		"&e&lWhere this path leads&r"
		"&fDivine Tengu&8 — Normal evolution&r"
		"&fSeraph&8 — Normal evolution, Awakening evolution&r"
		""
		"&a&lHow to evolve&r"
		"&f1. Awaken as either a True Demon Lord or a True Hero. The base requirement accepts either state; complete the matching TenSura awakening route first.&r"
		"&f2. Have another eligible player name you through TenSura's Naming interaction/key menu. An anvil-renamed name tag does not satisfy the stored existence-name check.&r"
		"&f3. Incarnate into a physical body first. The condition rejects TenSura spiritual-form state.&r"
		"&f4. Open the TenSura evolution menu and select this race. The quest does not perform the evolution for you.&r"
		""
		"&3&lQuest tracking&r"
		"&f• True Demon Lord or True Hero — exact TenSura awakening state&r"
		"&f• Current race: Cherub — checks your current race&r"
		"&8Trackers show your progress, but you still evolve through TenSura's evolution menu.&r"
		"&8Naming, body/form state, location conditions, item-use counts, and some addon counters cannot be tracked automatically. Follow the steps above whenever no tracker is shown.&r"
	]
	quest.546BC82CD2E16D8D.quest_subtitle: "Evolution • Mysticism"
	quest.546BC82CD2E16D8D.title: "Cherub"
	quest.5470D3B304B56B4E.quest_desc: [
		"&e&lWhat you need&r"
		"&eEP: &f180,000 &8(configurable default)&r"
		""
		"&e&lComes from&r"
		"&fGreater Pyre Wyrm&8 — Normal evolution&r"
		""
		"&e&lWhere this path leads&r"
		"&fSundeity Loong&8 — Normal evolution, Awakening evolution&r"
		""
		"&a&lHow to evolve&r"
		"&f1. Raise your base maximum EP to at least 180,000. Defeat eligible enemies to grow permanent Aura/Magicules, then reopen the TenSura evolution menu. Temporary or equipment bonuses may fill the displayed EP tracker without meeting this base-EP condition.&r"
		"&f2. Master Light Manipulation (mysticism:light_manipulation). Open its matching quest in the skill chapters for its learning and upgrade routes.&r"
		"&f3. Master Profaned Prominence (mysticism:profaned_prominence). Open its matching quest in the skill chapters for its learning and upgrade routes.&r"
		"&f4. Open the TenSura evolution menu and select this race. The quest does not perform the evolution for you.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Maximum EP: 180,000 — approximate: FTB reads total maximum EP; race checks base maximum EP&r"
		"&f• Master: Light Manipulation — exact TenSura ability state&r"
		"&f• Master: Profaned Prominence — exact TenSura ability state&r"
		"&f• Current race: Sunfire Lindwurm — checks your current race&r"
		"&8Trackers show your progress, but you still evolve through TenSura's evolution menu.&r"
		"&8Naming, body/form state, location conditions, item-use counts, and some addon counters cannot be tracked automatically. Follow the steps above whenever no tracker is shown.&r"
	]
	quest.5470D3B304B56B4E.quest_subtitle: "Evolution • Mysticism"
	quest.5470D3B304B56B4E.title: "Sunfire Lindwurm"
	quest.547A012E5121562B.quest_desc: [
		"&e&lWhat it does&r"
		"&fIt is the strongest offensive spell among the holy magic. The attack causes spiritrons to fall apart and disperse, erasing everything, both physical and spiritual.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Defeat Awakened Feldway in Survival. If you have already exhausted his exclusive authority rewards, he rolls a random Unique skill you do not own instead. This skill is in that pool, but the result is random, normal learning restrictions still apply, and Feldway's reward is normally once per player.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: Disintegration — completes when you learn it&r"
		"&8These tasks only track progress; they never grant or evolve a skill.&r"
	]
	quest.547A012E5121562B.quest_subtitle: "Unique skill • TR Arcane"
	quest.547A012E5121562B.title: "Disintegration"
	quest.547A523A63D6EAA8.quest_desc: [
		"Defeat Underzealot 10 times after this quest pack is installed."
		""
		"&aReward: &f+75 maximum EP&r"
		"&8This milestone tracks alongside the other kill goals for this mob, so every kill counts toward all of them.&r"
	]
	quest.547A523A63D6EAA8.title: "Underzealot: 10 Kills"
	quest.548A8E5BA3BB7663.quest_desc: [
		"&e&lWhat it does&r"
		"&fHarden your aura around you to block incoming attacks.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Find an unbound Battlewill Manual and hold use for at least 10 ticks. This art is one of the manual's 26 possible rolls. Manuals have a 50% injection chance in simple dungeons, mineshafts, hoglin-stable bastions, stronghold crossings, desert pyramids, igloos, selected trial chambers, ruined portals, large underwater ruins, and woodland mansions. They also appear in Dwarf Dojos, Lizardman Bedrooms, and Ant Nest archaeology. The manual is consumed even if learning fails.&r"
		""
		"&f2. Trade with a Battlewill Trainer dwarf at level 5. Its bound-manual trade tag explicitly includes this art; buy the named/glinting manual and hold use for at least 10 ticks.&r"
		""
		"&6&lMobs that use it&r"
		"&fAlways has this ability:&r"
		"&fLaplace (tensura_guild:laplace)&r"
		"&8Seeing a mob use this ability does not mean it can drop or teach it. Follow one of the methods above.&r"
		""
		"&3&lQuest tracking&r"
		"&fThe Learn task checks whether you currently know this ability. Extra mastery or EP tasks appear only when every valid route requires them.&r"
		"&8The book cannot predict random loot, shop rotations, manual rolls, taming chances, contract rolls, or uninterrupted training time.&r"
	]
	quest.548A8E5BA3BB7663.quest_subtitle: "Utility Battlewill Arts • TenSura: Reincarnated"
	quest.548A8E5BA3BB7663.title: "Diamond Path"
	quest.5491601D6D83FC89.quest_desc: [
		"&e&lWhat it does&r"
		"&fFreeze, stop and stagnate. Prevent hindering effects from applying to you and cause others to halt and solidify.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Defeat Awakened Feldway in Survival. If you have already exhausted his exclusive authority rewards, he rolls a random Unique skill you do not own instead. This skill is in that pool, but the result is random, normal learning restrictions still apply, and Feldway's reward is normally once per player.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: Coalescence — completes when you learn it&r"
		"&8These tasks only track progress; they never grant or evolve a skill.&r"
	]
	quest.5491601D6D83FC89.quest_subtitle: "Unique skill • Mysticism"
	quest.5491601D6D83FC89.title: "Coalescence"
	quest.54A0BA82099B66C6.quest_desc: [
		"&e&lWhat it does&r"
		"&f§7A unique skill of overwhelming water control. §bWet Like Water§7 grants Mirage, Water, and Ice Aspectual Magics. §9Mist§7 sets a substitute body, §3Rainfall§7 summons explosive water illusions, and §bSlip§7 lets you surge across water surfaces.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Defeat Awakened Feldway in Survival. If you have already exhausted his exclusive authority rewards, he rolls a random Unique skill you do not own instead. This skill is in that pool, but the result is random, normal learning restrictions still apply, and Feldway's reward is normally once per player.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: §3Deluge — completes when you learn it&r"
		"&8These tasks only track progress; they never grant or evolve a skill.&r"
	]
	quest.54A0BA82099B66C6.quest_subtitle: "Unique skill • TR: Nightmare"
	quest.54A0BA82099B66C6.title: "Deluge"
	quest.54AFB30476C28317.quest_desc: [
		"&e&lWhat it does&r"
		"&fShoot a shockwave of light energy to give nausea, blindness and slowness to all targets in a wide AOE.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Form a Greater-or-higher Light spirit contract. Find and tame a qualifying elemental spirit (the configured tame chance applies), or stand centered above a Praying Path and keep sneaking for its configured prayer time; a successful roll stores the higher contract and grants every Light Spiritual Magic through Greater, including this one.&r"
		""
		"&d&lSpirit contract&r"
		"&fElement: Light. Minimum contract level: Greater. A higher contract also grants this spell because grantSpiritMagic includes every matching spell at or below the stored level.&r"
		""
		"&6&lMobs that use it&r"
		"&fAlways has this ability:&r"
		"&fSeraph (trnightmare:seraph)&r"
		"&8Seeing a mob use this ability does not mean it can drop or teach it. Follow one of the methods above.&r"
		""
		"&3&lQuest tracking&r"
		"&fThe Learn task checks whether you currently know this ability. Extra mastery or EP tasks appear only when every valid route requires them.&r"
		"&8The book cannot predict random loot, shop rotations, manual rolls, taming chances, contract rolls, or uninterrupted training time.&r"
	]
	quest.54AFB30476C28317.quest_subtitle: "Spiritual Magic • TenSura: Reincarnated"
	quest.54AFB30476C28317.title: "Solar Flare"
	quest.54F60AF289E4A119.quest_desc: [
		"&e&lWhat it does&r"
		"&fUse your Divine Ki to amplify your battlewill to deal more damage and destroy weaker equipment.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Choose or evolve into one of the races listed below. The race grants this skill automatically.&r"
		""
		"&f2. Automatic acquisition check: use a race tagged Divine. Trigger a normal EP update after satisfying it (for example by defeating another mob) so TenSura re-evaluates learnable skills.&r"
		""
		"&f3. Steal it from one of the mobs below with Gluttony. Either make the mob your subordinate and use Gluttony's skill-retrieval mode, or kill it with Corrosion mode. This only works for allowed Common, Extra, Intrinsic, or Resistance skills, and another mod can still block the attempt.&r"
		""
		"&6&lMobs that use it&r"
		"&fLuminous Valentine (tensura_neb:luminous_valentine)&r"
		"&8A mob having the skill does not guarantee a drop. Use one of the learning methods above.&r"
		""
		"&d&lRaces that grant it&r"
		"&f6 Tailed Fox (ascension:six_tail_fox); 9 Tailed Fox (ascension:nine_tail_fox); Archangel (ascension:archangel); Ascended Djinn (ascension:ascended_djinn); Beholder (ascension:beholder); Chaos Dragon (ascension:chaos_dragon)&r"
		"&fChaos Metalloid (mysticism:chaos_metalloid); Chaotic Deity (ascension:chaotic_deity); Cosmic Deity (ascension:cosmic_deity); Death Tyrant (ascension:death_tyrant); Devil Doll (mysticism:devil_doll); Devil Lord (tensura:devil_lord)&r"
		"&fDiamond Sovereign (traddon:diamond_sovereign); Dissonance Deity (mysticism:dissonance_deity); Divine Angel (ascension:divine_angel); Divine Army Wasp (mysticism:divine_army_wasp); Divine Beast (tensura:divine_beast); Divine Bird (tensura:divine_bird)&r"
		"&fDivine Blue Centipede (mysticism:divine_blue_centipede); Divine Boar (tensura:divine_boar); Divine Chimera (trnightmare:divine_chimera); Divine Dragon (tensura:divine_dragon); Divine Dragon Lord (trnightmare:divine_dragon_lord); Divine Drone Beetle (mysticism:divine_drone_beetle)&r"
		"&fDivine Dwarf (tensura:divine_dwarf); Divine Elemental (mysticism:divine_elemental); Divine Elf (tensura:divine_elf); Divine Excelsius (mysticism:divine_excelsius); Divine Fighter (tensura:divine_fighter); Divine Fire Ant (mysticism:divine_fire_ant)&r"
		"&fDivine Fish (tensura:divine_fish); Divine Fox (trnightmare:divine_fox); Divine Gehenna Dragon (trnightmare:divine_gehenna_dragon); Divine Genasi (trarcane:divine_genasi); Divine Giant (tensura:divine_giant); Divine Hardshell Ant (mysticism:divine_hardshell_ant)&r"
		"&fDivine Human (tensura:divine_human); Divine Inferius (mysticism:divine_inferius); Divine King (ascension:divine_king); Divine Kitsune (ascension:divine_kitsune); Divine Lixivant Mantis (mysticism:divine_lixivant_mantis); Divine Loxodrome Scorpion (mysticism:divine_loxodrome_scorpion)&r"
		"&fDivine Majin Elemental (mysticism:divine_majin_elemental); Divine Oni (tensura:divine_oni); Divine Preying Mantis (mysticism:divine_preying_mantis); Divine Purple Centipede (mysticism:divine_purple_centipede); Divine Queen Wasp (mysticism:divine_queen_wasp); Divine Saiyan (elitetensura:divine_saiyan)&r"
		"&fDivine Singularity Scorpion (mysticism:divine_singularity_scorpion); Divine Skeleton (tensura:divine_skeleton); Divine Stag Beetle (mysticism:divine_stag_beetle); Divine Tengu (mysticism:divine_tengu); Divine Tiefling (trarcane:divine_tiefling); Divine Vampire (tensura:divine_vampire)&r"
		"&fDivine Wolf (mysticism:divine_wolf); Divine Yellow Centipede (mysticism:divine_yellow_centipede); Fairy Queen (trarcane:fairy_queen); Fallen (mysticism:fallen); Fallen Angel (ascension:fallen_angel); Fallen ReaperAberration (mysticism:fallen_seraph)&r"
		"&fFallen Seraph of Origin (trorigins:fallen_seraph_of_origin); Fallen of Origin (trorigins:fallen_of_origin); Frostwrought Leviathan (mysticism:frostwrought_leviathan); God Slime (tensura:god_slime); Guardian Of The Tree (trnightmare:guardian_of_the_tree); Heavenly Restriction (mysticism:heavenly_restriction)&r"
		"&fInfinite Djinn (ascension:infinite_djinn); Jedidiah (trnightmare:jedidiah); Jedidiah (trvirtuoso:jedidiah); Knight of Black (trnightmare:knight_black); Myrddin (trnightmare:myrddin); Myrddin (trvirtuoso:myrddin)&r"
		"&fMystic Angel (mysticism:mystic_angel); Mystic Angel of Origin (trorigins:mystic_angel_of_origin); Omniversal Djinn (ascension:omniversal_djinn); Primordial Devil Lord (trorigins:primordial_devil_lord); Primordial Djinn (ascension:primordial_djinn); Rimeblight Hydra (mysticism:rimeblight_hydra)&r"
		"&fRoyal Djinn (ascension:royal_djinn); Scorchtalon Wyvern (mysticism:scorchtalon_wyvern); Seraph (mysticism:seraph); Seraph of Origin (trorigins:seraph_of_origin); Seraphim (ascension:seraphim); Sovereign Djinn (ascension:sovereign_djinn)&r"
		"&fSun Wukong (ascension:sun_wukong); Sundeity Loong (mysticism:sundeity_loong); True Dragon (trorigins:true_dragon); True Dragonoid (mysticism:true_dragonoid); True Fairy King (trnightmare:true_fairy_king); Violence Deity (mysticism:violence_deity)&r"
		"&fWishbound Djinn (ascension:wishbound_djinn)&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: Divine Ki Release — completes when you learn it&r"
		"&8These tasks only track progress; they never grant or evolve a skill.&r"
	]
