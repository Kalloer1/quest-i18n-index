	quest.0451AD68EE3677F6.quest_desc: [
		"&e&lWhat it does&r"
		"&fInterferes with skills, magics, flight and transformation with mastery.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Choose or evolve into one of the races listed below. The race grants this skill automatically.&r"
		""
		"&f2. Steal it from one of the mobs below with Gluttony. Either make the mob your subordinate and use Gluttony's skill-retrieval mode, or kill it with Corrosion mode. This only works for allowed Common, Extra, Intrinsic, or Resistance skills, and another mod can still block the attempt.&r"
		""
		"&6&lMobs that use it&r"
		"&fCharybdis (tensura:charybdis); Megalodon (tensura:megalodon)&r"
		"&8A mob having the skill does not guarantee a drop. Use one of the learning methods above.&r"
		""
		"&d&lRaces that grant it&r"
		"&fContractor (trvirtuoso:contractor); Divine Bird (tensura:divine_bird); Enforcer (trnightmare:enforcer); Enforcer (trvirtuoso:enforcer); Fantasy Soul Insect (mysticism:fantasy_soul_insect); Harpy (tensura:harpy)&r"
		"&fHarpy Queen (tensura:harpy_queen); Magic Spirit Wolf (mysticism:magic_spirit_wolf); Myrddin (trnightmare:myrddin); Myrddin (trvirtuoso:myrddin); Spirit Bird (tensura:spirit_bird); Star Soul Insect (mysticism:star_soul_insect)&r"
		"&fTrickster (trnightmare:trickster); Trickster (trvirtuoso:trickster); Wanderer (trvirtuoso:wanderer)&r"
		""
		"&5&lUpgrades and unlocks&r"
		"&eCan evolve into / unlock:&r"
		"&f• Blockade (ascension:blockade) through Ascension automatic mastery unlock.&r &7Requirements: Master tensura:magic_jamming and defeat 30 Vexes.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: Magic Jamming — completes when you learn it&r"
		"&8These tasks only track progress; they never grant or evolve a skill.&r"
	]
	quest.0451AD68EE3677F6.quest_subtitle: "Extra skill • TenSura: Reincarnated"
	quest.0451AD68EE3677F6.title: "Magic Jamming"
