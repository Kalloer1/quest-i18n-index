	quest.57E2737DF4B56155.quest_desc: [
		"&e&lHow unlocking works&r"
		"&fElite Tensura checks title requirements from ordinary play: EP, kills, previous titles, awakening, alignment, learned or mastered skills, exploration, single-hit damage, deaths, claimed chunks, crafting, records, and other counters.&r"
		""
		"&fAll requirements listed for a title must be satisfied. Open the Elite Tensura Codex to inspect the live title entry; that screen is authoritative for the version and server configuration you are playing.&r"
	]
	quest.57E2737DF4B56155.title: "Unlocking Titles"
