	quest.7D3F33758A19B19F.quest_desc: [
		"Defeat Hippocamtus 1 time after this quest pack is installed."
		""
		"&aReward: &f+25 maximum EP&r"
		"&8This milestone tracks alongside the other kill goals for this mob, so every kill counts toward all of them.&r"
	]
	quest.7D3F33758A19B19F.title: "Hippocamtus: First Kill"
	quest.7D4510B3D9F9A9F2.quest_desc: [
		"&e&lWhat it does&r"
		"&fAs a young hero, you fancy yourself holier and more pure than others, in fact, you could be considered rather Chaste compared to a nun, and your attacks leave others feeling no better.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Defeat Awakened Feldway in Survival. If you have already exhausted his exclusive authority rewards, he rolls a random Unique skill you do not own instead. This skill is in that pool, but the result is random, normal learning restrictions still apply, and Feldway's reward is normally once per player.&r"
		""
		"&5&lUpgrades and unlocks&r"
		"&eCan evolve into / unlock:&r"
		"&f• ｢ Metatron, Lord of Purity ｣ (trnightmare:metatron) through TR: Nightmare Ultimate evolution.&r &7Requirements: See the full requirements on the target skill's page.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: Saint — completes when you learn it&r"
		"&8These tasks only track progress; they never grant or evolve a skill.&r"
	]
	quest.7D4510B3D9F9A9F2.quest_subtitle: "Unique skill • TR: Nightmare"
	quest.7D4510B3D9F9A9F2.title: "Saint"
	quest.7D524EC9A45F67F6.quest_desc: [
		"&e&lWhat you need&r"
		"&eEP: &f15,000,000 &8(configurable default)&r"
		""
		"&e&lEnd of this path&r"
		"&fThis is the end of this evolution path."
		""
		"&d&lSpecial progression route&r"
		"&fThis registered race is not reachable from the pack's normal starting-race evolution graph. It may require a special mechanic, command, mod-specific transformation, or another non-standard route."
		""
		"&a&lHow to evolve&r"
		"&f1. Raise your base maximum EP to at least 15,000,000. Defeat eligible enemies to grow permanent Aura/Magicules, then reopen the TenSura evolution menu. Temporary or equipment bonuses may fill the displayed EP tracker without meeting this base-EP condition.&r"
		"&f2. Open the TenSura evolution menu and select this race. The quest does not perform the evolution for you.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Maximum EP: 15,000,000 — approximate: FTB reads total maximum EP; race checks base maximum EP&r"
		"&f• Current race: Ultimate Slime — checks your current race&r"
		"&8Trackers show your progress, but you still evolve through TenSura's evolution menu.&r"
		"&8Naming, body/form state, location conditions, item-use counts, and some addon counters cannot be tracked automatically. Follow the steps above whenever no tracker is shown.&r"
	]
