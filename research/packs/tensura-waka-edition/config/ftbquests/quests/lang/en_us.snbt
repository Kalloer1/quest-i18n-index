	quest.11462E78632CC52E.title: "Demonic Dragon"
	quest.115646B9669340C4.quest_desc: [
		"&e&lWhat it does&r"
		"&fSeize your enemies' power or their summons. Steal their abilities and take control of their skills, draining their strength for your own.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Reincarnation roll: leave the skill unlocked, reincarnate/reset, and roll the configured starting Unique Skill pool. World uniqueness and the server's skill-count/cost rules still apply.&r"
		""
		"&f2. Defeat Awakened Feldway in Survival. If you have already exhausted his exclusive authority rewards, he rolls a random Unique skill you do not own instead. This skill is in that pool, but the result is random, normal learning restrictions still apply, and Feldway's reward is normally once per player.&r"
		""
		"&6&lMobs that use it&r"
		"&fHinata Sakaguchi (tensura:hinata_sakaguchi)&r"
		"&8A mob having the skill does not guarantee a drop. Use one of the learning methods above.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: Usurper — completes when you learn it&r"
		"&8These tasks only track progress; they never grant or evolve a skill.&r"
	]
	quest.115646B9669340C4.quest_subtitle: "Unique skill • TenSura: Reincarnated"
	quest.115646B9669340C4.title: "Usurper"
	quest.1187546BDFFB2067.quest_desc: [
		"&e&lWhat it does&r"
		"&fAn elemental draconic haki. Toggle Elemental Boon for damage, keep it in-slot for Elemental Guard, and hold it to release Dragon Haki. Gain an element on becoming an Element Dragon; the zombie dragon line forces Corrosion.&r"
		""
