	quest.69CB77C11FF0B493.quest_desc: [
		"&e&lWhat it does&r"
		"&fUltimate temptation — Tempt Control, All of Creation, Solicitation, Charm Domination, Severed Realm, and collapse arts.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Start with Seeker (tensura:seeker), then use TR: Nightmare Ultimate evolution. Follow the requirements below.&r"
		""
		"&f2. Start with Tempter (trnightmare:tempter), then use TR: Nightmare Ultimate evolution. Follow the requirements below.&r"
		""
		"&5&lUpgrades and unlocks&r"
		"&eStarts from:&r"
		"&f• Seeker (tensura:seeker) through TR: Nightmare Ultimate evolution.&r &7Requirements: See the full requirements on the target skill's page.&r"
		"&f• Tempter (trnightmare:tempter) through TR: Nightmare Ultimate evolution.&r &7Requirements: See the full requirements on the target skill's page.&r"
		"&eCan evolve into / unlock:&r"
		"&f• Spacetime Domination (trnightmare:spacetime_domination) through TR: Nightmare bespoke natural acquisition.&r &7Requirements: master Spacetime Manipulation; possess one compatible configured authority.&r"
		""
		"&c&lDetailed steps&r"
		"&f• TR: Nightmare requirements:&r"
		"&f• Master Seeker (tensura:seeker)&r"
		"&f• Master Tempter (trnightmare:tempter)&r"
		"&f• Master Multilayer Barrier (tensura:multilayer_barrier)&r"
		"&f• Name 25 subordinates&r"
		"&f• Master 50 Aspectual Magic spells&r"
		"&f• Win 10 village raids&r"
		"&f• Reach a maximum Magicule capacity of 940,000&r"
		"&f• Reach at least 940,000 maximum Magicule capacity (configurable default). UltimateEvolutionHelper checks capacity and does not spend it during this evolution helper.&r"
		"&f• The TR: Nightmare automatic-evolution gamerule must be enabled; satisfy the checklist, then trigger a normal EP update so the acquisition check runs.&r"
		"&f• The TR: Nightmare Nightmare Ultimates gamerule must be enabled.&r"
		"&f• This target's configurable ultimate-evolution switch must remain enabled.&r"
		"&f• A predecessor marked as a Directive Ego or Akashic Star Order imprint cannot be consumed by UltimateEvolutionHelper; clear or use that special state before attempting the normal replacement path.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: ｢ Azazel, Lord of Temptation ｣ — completes when you learn it&r"
		"&f• Master: Seeker — completes when mastered&r"
		"&f• Master: Tempter — completes when mastered&r"
		"&f• Master: Multilayer Barrier — completes when mastered&r"
		"&f• Village raids won: 10 — exact lifetime statistic used by this condition&r"
		"&f• Maximum Magicules: 940,000 — exact maximum-Magicule value used by the mod's condition&r"
		"&8These tasks only track progress; they never grant or evolve a skill.&r"
	]
	quest.69CB77C11FF0B493.quest_subtitle: "Ultimate skill • TR: Nightmare"
	quest.69CB77C11FF0B493.title: "｢ Azazel, Lord of Temptation ｣"
