	quest.7D0232442CB4601F.title: "Folgen: 100 Kills"
	quest.7D0F7E8708968FA0.quest_desc: [
		"&e&lReincarnation&r"
		"&fYour first login opens the reincarnation selection. Later, Reincarnation Magic can reopen race selection by sacrificing a configurable portion of your maximum Aura/Magicules. The mastered version uses the advanced race pool.&r"
		""
		"&e&lSoul Points&r"
		"&fSoul Points are not skill points. Demon Lord Seeds earn them from eligible kills and spend the required total during the Harvest Festival to awaken as a True Demon Lord.&r"
		""
		"&fThe base default awards 50% of eligible EP gain as souls and uses a 10,000-soul awakening requirement, but both are configurable. Excluded entities do not award souls, and a server may change the rate or requirement.&r"
	]
	quest.7D0F7E8708968FA0.title: "Reincarnation and Soul Points"
	quest.7D11502FBF27B397.quest_desc: [
		"&e&lWhat you need&r"
		"&eEP: &f800,000 &8(configurable default)&r"
		""
		"&e&lComes from&r"
		"&fBrown Fang&8 — Awakening evolution&r"
		"&fMystical Brown Fang&8 — Normal evolution&r"
		""
		"&e&lWhere this path leads&r"
		"&fDivine Wolf&8 — Normal evolution, Awakening evolution&r"
		""
		"&a&lHow to evolve&r"
		"&f1. Raise your base maximum EP to at least 800,000. Defeat eligible enemies to grow permanent Aura/Magicules, then reopen the TenSura evolution menu. Temporary or equipment bonuses may fill the displayed EP tracker without meeting this base-EP condition.&r"
		"&f2. Master Earth Domination (tensura:earth_domination). Open its matching quest in the skill chapters for its learning and upgrade routes.&r"
		"&f3. Open the TenSura evolution menu and select this race. The quest does not perform the evolution for you.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Maximum EP: 800,000 — approximate: FTB reads total maximum EP; race checks base maximum EP&r"
		"&f• Master: Earth Domination — exact TenSura ability state&r"
		"&f• Current race: Mountain Spirit Wolf — checks your current race&r"
		"&8Trackers show your progress, but you still evolve through TenSura's evolution menu.&r"
		"&8Naming, body/form state, location conditions, item-use counts, and some addon counters cannot be tracked automatically. Follow the steps above whenever no tracker is shown.&r"
	]
	quest.7D11502FBF27B397.quest_subtitle: "Evolution • Mysticism"
	quest.7D11502FBF27B397.title: "Mountain Spirit Wolf"
	quest.7D1A53A9610138AB.quest_desc: [
		"&e&lWhat it does&r"
		"&fA holy-element spell that strikes enemies with sanctified lightning.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Join the Adventurer Guild and complete commissions for Reputation Coins. At rank A, the rotating shop can offer this spell as a Random Magic Tome for 200 coins. You can buy one per refresh, and the shop refreshes every 7 Minecraft days by default. Buy the tome when this spell appears, then hold use for at least 10 ticks.&r"
		""
		"&f2. Search Wizard Tower chests for a bound tome. This spell appears in these tower pools: Rare Buried, Rare Rotted, Rare Ruined, Uncommon Burnt.&r"
		""
		"&3&lQuest tracking&r"
		"&fThe Learn task checks whether you currently know this ability. Extra mastery or EP tasks appear only when every valid route requires them.&r"
		"&8The book cannot predict random loot, shop rotations, manual rolls, taming chances, contract rolls, or uninterrupted training time.&r"
	]
	quest.7D1A53A9610138AB.quest_subtitle: "Other \\& Addon Magic • TR: Nightmare"
	quest.7D1A53A9610138AB.title: "Holy Lightning"
	quest.7D1F0D2254909E88.quest_desc: [
		"&fGather the required souls or human kills and trigger the Harvest Festival under your route's remaining conditions.&r"
		""
		"&fCompletion requires TenSura to record you as a True Demon Lord.&r"
	]
	quest.7D1F0D2254909E88.title: "Monster Route: Awaken as a True Demon Lord"
