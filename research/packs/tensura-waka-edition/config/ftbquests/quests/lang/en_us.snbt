	quest.7A166A50671A4C83.title: "Raycat: 10 Kills"
	quest.7A1B5DAD9E636D11.quest_desc: [
		"&e&lWhat it does&r"
		"&fIsolate and recreate a memory of matter around you, enabling the duplication of matter by altering the timeline retroactively.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Defeat Awakened Feldway in Survival. If you have already exhausted his exclusive authority rewards, he rolls a random Unique skill you do not own instead. This skill is in that pool, but the result is random, normal learning restrictions still apply, and Feldway's reward is normally once per player.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: Memory Recreation — completes when you learn it&r"
		"&8These tasks only track progress; they never grant or evolve a skill.&r"
	]
	quest.7A1B5DAD9E636D11.quest_subtitle: "Unique skill • TR: Starlight"
	quest.7A1B5DAD9E636D11.title: "Memory Recreation"
	quest.7A1C1940B3364FDF.quest_desc: [
		"&e&lA small visual warning&r"
		"&fWaka Edition's current development configuration enables TenSura's arachnophobia mode by default. It swaps supported TenSura spider entities, including Black Spider and Knight Spider, to friendlier models or textures.&r"
		""
		"&fTo use the normal spider appearance, open the TenSura settings from the Status Menu, find &eArachnophobia&f, and turn it off. This is a client-side visual option and does not change the creatures' combat behavior.&r"
	]
	quest.7A1C1940B3364FDF.title: "Arachnophobia Mode"
	quest.7A39094C2FF03A88.quest_desc: [
		"Defeat Bluff 10 times after this quest pack is installed."
