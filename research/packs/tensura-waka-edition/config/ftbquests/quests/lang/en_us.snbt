	quest.3F149400EDC7B6C3.quest_desc: [
		"&e&lWhat you need&r"
		"&eEP: &f250,000 &8(configurable default)&r"
		"&eConsumes item: &f100× Spider Eye"
		""
		"&e&lComes from&r"
