	quest.69636D8D3109BE87.quest_desc: [
		"&e&lWhat it does&r"
		"&fIgnore weaker gravity-based damage or reduce the damage from stronger attacks.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Choose or evolve into one of the races listed below. The race grants this skill automatically.&r"
		""
		"&f2. Steal it from one of the mobs below with Gluttony. Either make the mob your subordinate and use Gluttony's skill-retrieval mode, or kill it with Corrosion mode. This only works for allowed Common, Extra, Intrinsic, or Resistance skills, and another mod can still block the attempt.&r"
		""
		"&6&lMobs that use it&r"
		"&fCarrion (tensura_neb:carrion); Gravebound Colossus (elitetensura:gravebound_colossus)&r"
		"&8A mob having the skill does not guarantee a drop. Use one of the learning methods above.&r"
		""
		"&d&lRaces that grant it&r"
		"&fDemon Slime (tensura:demon_slime); Earthshaker Dancer (trnightmare:earthshaker_dancer); Fairy Prince (trnightmare:fairy_prince); God Slime (tensura:god_slime); Gravity Soul Insect (mysticism:gravity_soul_insect); Hell Rizer (trnightmare:hell_rizer)&r"
		"&fLesser Fairy (trnightmare:lesser_fairy); Metal Slime (tensura:metal_slime); Royal Demon (trnightmare:royal_demon); Ten Commandment (trnightmare:ten_commandments)&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: Gravity Attack Resistance — completes when you learn it&r"
		"&8These tasks only track progress; they never grant or evolve a skill.&r"
	]
	quest.69636D8D3109BE87.quest_subtitle: "Resistance skill • TenSura: Reincarnated"
	quest.69636D8D3109BE87.title: "Gravity Attack Resistance"
