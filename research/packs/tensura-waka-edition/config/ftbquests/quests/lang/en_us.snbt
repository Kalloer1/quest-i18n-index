	quest.622D64B3EBCC3AAA.title: "Creeper: 50 Kills"
	quest.623115D9E3697979.quest_desc: [
		"&e&lWhat you need&r"
		"&eEP: &f200,000 &8(configurable default)&r"
		""
		"&e&lComes from&r"
		"&fStar Wolf&8 — Normal evolution, Harvest Festival evolution&r"
		""
		"&e&lWhere this path leads&r"
		"&fStorm Spirit Wolf&8 — Normal evolution&r"
		""
		"&a&lHow to evolve&r"
		"&f1. Raise your base maximum EP to at least 200,000. Defeat eligible enemies to grow permanent Aura/Magicules, then reopen the TenSura evolution menu. Temporary or equipment bonuses may fill the displayed EP tracker without meeting this base-EP condition.&r"
		"&f2. Master Water Manipulation (tensura:water_manipulation). Open its matching quest in the skill chapters for its learning and upgrade routes.&r"
		"&f3. Master Wind Manipulation (tensura:wind_manipulation). Open its matching quest in the skill chapters for its learning and upgrade routes.&r"
		"&f4. Master Spatial Manipulation (tensura:spatial_manipulation). Open its matching quest in the skill chapters for its learning and upgrade routes.&r"
		"&f5. Open the TenSura evolution menu and select this race. The quest does not perform the evolution for you.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Maximum EP: 200,000 — approximate: FTB reads total maximum EP; race checks base maximum EP&r"
		"&f• Master: Water Manipulation — exact TenSura ability state&r"
		"&f• Master: Wind Manipulation — exact TenSura ability state&r"
		"&f• Master: Spatial Manipulation — exact TenSura ability state&r"
		"&f• Current race: Tempest Star Wolf — checks your current race&r"
		"&8Trackers show your progress, but you still evolve through TenSura's evolution menu.&r"
		"&8Naming, body/form state, location conditions, item-use counts, and some addon counters cannot be tracked automatically. Follow the steps above whenever no tracker is shown.&r"
	]
	quest.623115D9E3697979.quest_subtitle: "Evolution • Mysticism"
	quest.623115D9E3697979.title: "Tempest Star Wolf"
	quest.6243DD0C010D1748.quest_desc: [
