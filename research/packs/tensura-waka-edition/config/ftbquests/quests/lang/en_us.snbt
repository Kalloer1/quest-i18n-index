	quest.00096A368968232F.quest_desc: [
		"&e&lWhat it does&r"
		"&fAn endless sovereign that devours strength. Doubles EP gain, steals MP, weakens nearby foes, and enforces Infinite Imprisonment.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Automatic acquisition check: satisfy the skill's built-in automatic acquisition check. Trigger a normal EP update after satisfying it (for example by defeating another mob) so TenSura re-evaluates learnable skills.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: Kronairos, Lord of the Endless — completes when you learn it&r"
		"&8These tasks only track progress; they never grant or evolve a skill.&r"
	]
	quest.00096A368968232F.quest_subtitle: "Ultimate skill • Tensura More Skills"
	quest.00096A368968232F.title: "Kronairos, Lord of the Endless"
