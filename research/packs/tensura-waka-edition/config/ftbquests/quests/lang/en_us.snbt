	quest.1E79F936FF19FD9E.quest_desc: [
		"&e&lStarting stats and abilities&r"
		"&eStarting EP range: &f8,000–10,000 &8(from base Aura + Magicules)&r"
		"&eAura: &f2,500–3,500"
		"&eMagicules: &f5,500–6,500"
