	quest.52781F865D17CCB4.title: "Fox: First Kill"
	quest.52842D2717DC8741.quest_desc: [
		"&fUse the AllTheModium Teleport Pad from the End to reach The Beyond. This is the last step of the pack's AllTheModium travel chain.&r"
		""
		"&fDo not strand yourself: test the return trip before wandering far from the arrival point.&r"
	]
