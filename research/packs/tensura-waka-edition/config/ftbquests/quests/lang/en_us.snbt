	quest.24973309367E163D.quest_desc: [
		"&e&lWhat it does&r"
		"&fBoosts the power of Light abilities by a large amount.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Choose or evolve into one of the races listed below. The race grants this skill automatically.&r"
		""
		"&f2. Automatic acquisition check: raise EP above 2,000,000; then master ExtraMysticismSkills.LIGHT_MANIPULATION.get(). Trigger a normal EP update after satisfying it (for example by defeating another mob) so TenSura re-evaluates learnable skills.&r"
		""
		"&f1. &eTR: Origins True Dragon route:&f become the True Dragon race and receive an unclaimed elemental seat. The addon randomly assigns one available Abyss, Earth, Scorch, Frost, or Storm seat; receiving Scorch grants this skill automatically. Each elemental seat can have only one owner per world, so this route cannot be targeted reliably on an established server.&r"
		""
		"&d&lRaces that grant it&r"
		"&fFallen ReaperAberration (mysticism:fallen_seraph); Mystic Angel (mysticism:mystic_angel); Seraph (mysticism:seraph)&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: Light Domination — completes when you learn it&r"
		"&8These tasks only track progress; they never grant or evolve a skill.&r"
	]
	quest.24973309367E163D.quest_subtitle: "Extra skill • Mysticism"
	quest.24973309367E163D.title: "Light Domination"
