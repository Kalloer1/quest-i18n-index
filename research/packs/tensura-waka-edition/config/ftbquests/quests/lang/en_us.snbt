	quest.79BE348BFEC91426.title: "Fire Bolt"
	quest.79BF1289DA75EE18.quest_desc: [
		"&e&lWhat you need&r"
		"&eEP: &f400,000 &8(configurable default)&r"
		"&eConsumes item: &f5× Daemon Essence"
		""
		"&e&lComes from&r"
		"&fBlood Noble&8 — Normal evolution, Awakening evolution, Harvest Festival evolution&r"
		""
		"&e&lWhere this path leads&r"
		"&fProgenitor Bloodfiend&8 — Normal evolution, Awakening evolution, Harvest Festival evolution&r"
		""
		"&a&lHow to evolve&r"
		"&f1. Raise your base maximum EP to at least 400,000. Defeat eligible enemies to grow permanent Aura/Magicules, then reopen the TenSura evolution menu. Temporary or equipment bonuses may fill the displayed EP tracker without meeting this base-EP condition.&r"
		"&f2. Obtain 5 x Daemon Essence (tensura:daemon_essence): Defeat Arch Daemons (50%), Greater Daemons (10%), or Lesser Daemons (1%). It also appears in Hell Ruins chests and Hell Ruins archaeology. Then eat/use all 5; carrying them is not enough because this condition checks the item-used statistic.&r"
		"&f3. Open the TenSura evolution menu and select this race. The quest does not perform the evolution for you.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Maximum EP: 400,000 — approximate: FTB reads total maximum EP; race checks base maximum EP&r"
		"&f• Current race: Elder Bloodfiend — checks your current race&r"
		"&8Trackers show your progress, but you still evolve through TenSura's evolution menu.&r"
		"&8Naming, body/form state, location conditions, item-use counts, and some addon counters cannot be tracked automatically. Follow the steps above whenever no tracker is shown.&r"
	]
	quest.79BF1289DA75EE18.quest_subtitle: "Evolution • Ascension"
	quest.79BF1289DA75EE18.title: "Elder Bloodfiend"
	quest.79C0E5BB4C7701F5.quest_desc: [
		"&fAt 100,000 maximum EP, begin moving from random fights into structures, named enemies, raids, and bosses that match your gear.&r"
		""
		"&fKeep upgrading defense and utility alongside damage. Many later requirements care about mastery, counters, or awakening state rather than EP alone.&r"
	]
	quest.79C0E5BB4C7701F5.title: "Reach 100,000 Maximum EP"
