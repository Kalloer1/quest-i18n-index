	quest.03890CBE2706A0ED.title: "Lesser Convergence Aspectborn"
	quest.038C3C99118D26B9.quest_desc: [
		"&e&lWhat it does&r"
		"&f§oConcentrate your eyes on darkness, for only amidst dark shall there be light.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Automatic acquisition check: possess StarlightUniqueSkills.VESTIGES_OF_EIDOLONS.get(). Trigger a normal EP update after satisfying it (for example by defeating another mob) so TenSura re-evaluates learnable skills.&r"
		""
		"&f2. Defeat Awakened Feldway in Survival. If you have already exhausted his exclusive authority rewards, he rolls a random Unique skill you do not own instead. This skill is in that pool, but the result is random, normal learning restrictions still apply, and Feldway's reward is normally once per player.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: Light Remains — completes when you learn it&r"
		"&8These tasks only track progress; they never grant or evolve a skill.&r"
	]
	quest.038C3C99118D26B9.quest_subtitle: "Unique skill • TR: Starlight"
	quest.038C3C99118D26B9.title: "Light Remains"
	quest.038EEBE647E65B39.quest_desc: [
		"&fThe Ancient Factory trades open space for machinery and close-range pressure. Repair your gear before entering and bring a way to handle groups.&r"
		""
		"&fMark the exit as soon as you arrive; industrial rooms can look alike when retreating under pressure.&r"
	]
	quest.038EEBE647E65B39.title: "Tier 4: Breach the Ancient Factory"
