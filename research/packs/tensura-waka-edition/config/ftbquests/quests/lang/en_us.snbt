	quest.7208E5A144610606.quest_desc: [
		"&e&lWhat it does&r"
		"&fRelease a wide area of sleeping mist to paralyze targets.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Join the Adventurer Guild and complete commissions for Reputation Coins. At rank A, the rotating shop can offer this spell as a Random Magic Tome for 200 coins. You can buy one per refresh, and the shop refreshes every 7 Minecraft days by default. Buy the tome when this spell appears, then hold use for at least 10 ticks.&r"
		""
		"&f2. Search Wizard Tower chests for a bound tome. This spell appears in these tower pools: Common Frozen.&r"
		""
		"&f3. Level a Magic Instructor dwarf and check its offers. This spell can appear in these trade tiers: Medium Basic.&r"
		""
		"&6&lMobs that use it&r"
		"&fAlways has this ability:&r"
		"&fGreater Angel (trnightmare:greater_angel); Greater Daemon (tensura:greater_daemon); Greater Fallen (trnightmare:greater_fallen); Greater Phantom (trnightmare:greater_phantom)&r"
		"&fPrimordial Blanc (trnightmare:sentient_boss_blanc); Primordial Bleu (trnightmare:sentient_boss_bleu); Primordial Jaune (trnightmare:sentient_boss_jaune); Primordial Vert (trnightmare:sentient_boss_vert)&r"
		"&fPrimordial Violet (trnightmare:sentient_boss_violet); Sentient Boss Ancient Daemon (trnightmare:sentient_boss_ancient_daemon); Sentient Boss Noir (trnightmare:sentient_boss_noir); Sentient Boss Primordial Daemon (trnightmare:sentient_boss_primordial_daemon)&r"
		"&fMay roll this ability when it spawns:&r"
		"&fSentient Boss Gii Crimson (trnightmare:sentient_boss_gii_crimson)&r"
		"&8Seeing a mob use this ability does not mean it can drop or teach it. Follow one of the methods above.&r"
		""
		"&3&lQuest tracking&r"
		"&fThe Learn task checks whether you currently know this ability. Extra mastery or EP tasks appear only when every valid route requires them.&r"
		"&8The book cannot predict random loot, shop rotations, manual rolls, taming chances, contract rolls, or uninterrupted training time.&r"
	]
	quest.7208E5A144610606.quest_subtitle: "Aspectual Magic • TenSura: Reincarnated"
	quest.7208E5A144610606.title: "Sleep Mist"
	quest.721945BD66AA99E5.quest_desc: [
		"&e&lWhat it does&r"
