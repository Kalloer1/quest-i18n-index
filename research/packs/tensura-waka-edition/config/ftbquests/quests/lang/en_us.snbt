	quest.17C4A450F1F39392.title: "Lesser Angel: First Kill"
	quest.17CA6B0DD157D145.quest_desc: [
		"&e&lWhat it does&r"
		"&fCrush the mind of targets.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Join the Adventurer Guild and complete commissions for Reputation Coins. At rank A, the rotating shop can offer this spell as a Random Magic Tome for 200 coins. You can buy one per refresh, and the shop refreshes every 7 Minecraft days by default. Buy the tome when this spell appears, then hold use for at least 10 ticks.&r"
		""
		"&f2. Search Wizard Tower chests for a bound tome. This spell appears in these tower pools: Rare Buried, Rare Burnt, Rare Frozen, Rare Rotted, Rare Ruined.&r"
		""
		"&6&lMobs that use it&r"
		"&fAlways has this ability:&r"
		"&fSentient Boss Noir (trnightmare:sentient_boss_noir)&r"
		"&8Seeing a mob use this ability does not mean it can drop or teach it. Follow one of the methods above.&r"
		""
		"&3&lQuest tracking&r"
		"&fThe Learn task checks whether you currently know this ability. Extra mastery or EP tasks appear only when every valid route requires them.&r"
		"&8The book cannot predict random loot, shop rotations, manual rolls, taming chances, contract rolls, or uninterrupted training time.&r"
	]
	quest.17CA6B0DD157D145.quest_subtitle: "Aspectual Magic • TenSura: Reincarnated"
	quest.17CA6B0DD157D145.title: "Mental Crush"
	quest.17CAED7036DDABEA.quest_desc: [
		"Defeat Orc 100 times after this quest pack is installed."
		""
		"&aReward: &f+1,000 maximum EP&r"
		"&8This milestone tracks alongside the other kill goals for this mob, so every kill counts toward all of them.&r"
	]
	quest.17CAED7036DDABEA.title: "Orc: 100 Kills"
	quest.17F59C80F57CEFFF.quest_desc: [
		"&e&lWhat it does&r"
		"&fDissolve specific items to instantly consume them.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Choose or evolve into one of the races listed below. The race grants this skill automatically.&r"
		""
		"&f2. Steal it from one of the mobs below with Gluttony. Either make the mob your subordinate and use Gluttony's skill-retrieval mode, or kill it with Corrosion mode. This only works for allowed Common, Extra, Intrinsic, or Resistance skills, and another mod can still block the attempt.&r"
		""
		"&6&lMobs that use it&r"
		"&fMetal Slime (tensura:metal_slime); Slime (minecraft:slime); Slime (tensura:slime); Supermassive Slime (tensura:supermassive_slime)&r"
		"&8A mob having the skill does not guarantee a drop. Use one of the learning methods above.&r"
		""
		"&d&lRaces that grant it&r"
		"&fAxolotl (trnightmare:axolotl); Axolotl Knight (trnightmare:axolotl_knight); Axolotl Steel Spirit (trnightmare:axolotl_steel_spirit); Axolotl Steel Spirit Dragon (trnightmare:axolotl_steel_dragon); Axolotl Water Spirit (trnightmare:axolotl_water_spirit); Axolotl Water Spirit Dragon (trnightmare:axolotl_water_dragon)&r"
		"&fAxolotl Wizard (trnightmare:axolotl_wizard); Demon Slime (tensura:demon_slime); Divine Saiyan (elitetensura:divine_saiyan); God Slime (tensura:god_slime); High Class Saiyan (elitetensura:high_saiyan); Lesser Saiyan (elitetensura:lesser_saiyan)&r"
		"&fMedium Class Saiyan (elitetensura:medium_saiyan); Metal Slime (tensura:metal_slime); Salamander (trnightmare:salamander); Salamander Assassin (trnightmare:salamander_assassin); Salamander Fire Spirit (trnightmare:salamander_fire_spirit); Salamander Fire Spirit Dragon (trnightmare:salamander_fire_dragon)&r"
		"&fSalamander Poison Spirit (trnightmare:salamander_poison_spirit); Salamander Poison Spirit Dragon (trnightmare:salamander_poison_dragon); Salamander Warlock (trnightmare:salamander_warlock); Slime (tensura:slime)&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: Absorb \\\\& Dissolve — completes when you learn it&r"
		"&8These tasks only track progress; they never grant or evolve a skill.&r"
	]
	quest.17F59C80F57CEFFF.quest_subtitle: "Intrinsic skill • TenSura: Reincarnated"
	quest.17F59C80F57CEFFF.title: "Absorb \\& Dissolve"
	quest.180484D3A9BAE739.quest_desc: [
		"&e&lWhat you need&r"
		"&eEP: &f2,000,000 &8(configurable default)&r"
		""
		"&e&lComes from&r"
		"&fElemental Lord&8 — Normal evolution&r"
		""
		"&e&lEnd of this path&r"
		"&fThis is the end of this evolution path."
		""
		"&a&lHow to evolve&r"
		"&f1. Raise your base maximum EP to at least 2,000,000. Defeat eligible enemies to grow permanent Aura/Magicules, then reopen the TenSura evolution menu. Temporary or equipment bonuses may fill the displayed EP tracker without meeting this base-EP condition.&r"
		"&f2. Open the TenSura evolution menu and select this race. The quest does not perform the evolution for you.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Maximum EP: 2,000,000 — approximate: FTB reads total maximum EP; race checks base maximum EP&r"
		"&f• Current race: Divine Elemental — checks your current race&r"
		"&8Trackers show your progress, but you still evolve through TenSura's evolution menu.&r"
		"&8Naming, body/form state, location conditions, item-use counts, and some addon counters cannot be tracked automatically. Follow the steps above whenever no tracker is shown.&r"
	]
	quest.180484D3A9BAE739.quest_subtitle: "Final Evolution • Mysticism"
	quest.180484D3A9BAE739.title: "Divine Elemental"
