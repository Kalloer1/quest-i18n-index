		"&fDarkness Fang (mysticism:darkness_fang); Direwolf (mysticism:direwolf); Divine Vampire (tensura:divine_vampire); Divine Wolf (mysticism:divine_wolf); Frost Wolf (mysticism:frost_wolf); Glacier Spirit Wolf (mysticism:glacier_spirit_wolf)&r"
		"&fGreen Fang (mysticism:green_fang); Guitar Wolf (mysticism:guitar_wolf); Light Fang (mysticism:light_fang); Magic Spirit Wolf (mysticism:gale_spirit_wolf); Magic Spirit Wolf (mysticism:magic_spirit_wolf); Magic Spirit Wolf (mysticism:ocean_spirit_wolf)&r"
		"&fMolten Spirit Wolf (mysticism:molten_spirit_wolf); Mountain Spirit Wolf (mysticism:mountain_spirit_wolf); Mystical Black Fang (mysticism:mystical_black_fang); Mystical Black Fang (mysticism:mystical_blue_fang); Mystical Brown Fang (mysticism:mystical_brown_fang); Mystical Darkness Fang (mysticism:mystical_darkness_fang)&r"
		"&fMystical Green Fang (mysticism:mystical_green_fang); Mystical Light Fang (mysticism:mystical_light_fang); Mystical Purple Fang (mysticism:mystical_purple_fang); Mystical Red Fang (mysticism:mystical_red_fang); Nivalis Frost Wolf (mysticism:nivalis_frost_wolf); Penumbra Spirit Wolf (mysticism:penumbra_spirit_wolf)&r"
