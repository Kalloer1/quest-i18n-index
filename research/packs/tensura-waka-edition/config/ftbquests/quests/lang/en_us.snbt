	quest.4573DCB69D7BF411.quest_desc: [
		"&e&lUnlocked is not the same as active&r"
		"&fOpen the Elite Tensura Codex, find a title you have unlocked, and place it in an active title slot. Attribute bonuses are applied by the active-title manager, so simply unlocking a title is not enough.&r"
		""
		"&fThe installed configuration starts with 3 title slots, grants another slot every 2 resets, and caps the total at 10. Servers can change those values.&r"
	]
