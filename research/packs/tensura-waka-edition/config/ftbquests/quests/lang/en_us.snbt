	quest.541FDB7F4B9A87A2.quest_desc: [
		"&e&lWhat it does&r"
		"&fUltimate executioner. Toggle for silent movement; slot Remove, Dispel, Eraser, Necrosis, and Judgement in-slot actives.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Start with Murderer (tensura:murderer), then use TR: Nightmare Ultimate evolution. Follow the requirements below.&r"
		""
		"&5&lUpgrades and unlocks&r"
		"&eStarts from:&r"
		"&f• Murderer (tensura:murderer) through TR: Nightmare Ultimate evolution.&r &7Requirements: See the full requirements on the target skill's page.&r"
		""
		"&c&lDetailed steps&r"
		"&f• TR: Nightmare requirements:&r"
		"&f• Win 15 village raids&r"
		"&f• Master 25 total skills&r"
		"&f• Master Murderer (tensura:murderer)&r"
		"&f• Master Murderer (tensura:murderer).&r"
		"&f• Reach at least 500,000 maximum Magicule capacity (configurable default). UltimateEvolutionHelper checks capacity and does not spend it during this evolution helper.&r"
		"&f• The TR: Nightmare automatic-evolution gamerule must be enabled; satisfy the checklist, then trigger a normal EP update so the acquisition check runs.&r"
		"&f• The TR: Nightmare Nightmare Ultimates gamerule must be enabled.&r"
		"&f• This target's configurable ultimate-evolution switch must remain enabled.&r"
		"&f• A predecessor marked as a Directive Ego or Akashic Star Order imprint cannot be consumed by UltimateEvolutionHelper; clear or use that special state before attempting the normal replacement path.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: ｢ Sandalphon, Lord of Judgement ｣ — completes when you learn it&r"
		"&f• Village raids won: 15 — exact lifetime statistic used by this condition&r"
		"&f• Skills mastered (lifetime counter): 25 — optional approximate tracker&r"
		"&f• Master: Murderer — completes when mastered&r"
		"&f• Maximum Magicules: 500,000 — exact configured-default capacity gate used by UltimateEvolutionHelper&r"
		"&8These tasks only track progress; they never grant or evolve a skill.&r"
	]
	quest.541FDB7F4B9A87A2.quest_subtitle: "Ultimate skill • TR: Nightmare"
	quest.541FDB7F4B9A87A2.title: "｢ Sandalphon, Lord of Judgement ｣"
