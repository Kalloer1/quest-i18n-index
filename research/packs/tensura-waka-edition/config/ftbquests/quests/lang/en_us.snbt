	quest.0499DCA8F5FA6C4C.quest_subtitle: "Evolution • Mysticism"
	quest.0499DCA8F5FA6C4C.title: "Singularity Scorpion Insectar"
	quest.04A212757B1B6F1A.quest_desc: [
		"&e&lWhat it does&r"
		"&fThe Insects of the other world all possess this tough Exoskeleton. It grows together with the user, and even allows them to wear armor on top of it.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Choose or evolve into one of the races listed below. The race grants this skill automatically.&r"
		""
		"&f2. Steal it from one of the mobs below with Gluttony. Either make the mob your subordinate and use Gluttony's skill-retrieval mode, or kill it with Corrosion mode. This only works for allowed Common, Extra, Intrinsic, or Resistance skills, and another mod can still block the attempt.&r"
		""
		"&6&lMobs that use it&r"
		"&fArmy Wasp (tensura:army_wasp); Black Spider (tensura:black_spider); Cave Spider (minecraft:cave_spider); Knight Spider (tensura:knight_spider); Spider (minecraft:spider)&r"
		"&8A mob having the skill does not guarantee a drop. Use one of the learning methods above.&r"
		""
		"&d&lRaces that grant it&r"
		"&fAnt (mysticism:ant); Army Wasp (mysticism:army_wasp); Army Wasp Insectar (mysticism:army_wasp_insectar); Army Wasp Savant (mysticism:army_wasp_savant); Beetle (mysticism:beetle); Blue Centipede (mysticism:blue_centipede)&r"
		"&fBlue Centipede Insectar (mysticism:blue_centipede_insectar); Blue Centipede Savant (mysticism:blue_centipede_savant); Centipede (mysticism:centipede); Corrosion Soul Insect (mysticism:corrosion_soul_insect); Divine Army Wasp (mysticism:divine_army_wasp); Divine Blue Centipede (mysticism:divine_blue_centipede)&r"
		"&fDivine Drone Beetle (mysticism:divine_drone_beetle); Divine Fire Ant (mysticism:divine_fire_ant); Divine Hardshell Ant (mysticism:divine_hardshell_ant); Divine Lixivant Mantis (mysticism:divine_lixivant_mantis); Divine Loxodrome Scorpion (mysticism:divine_loxodrome_scorpion); Divine Preying Mantis (mysticism:divine_preying_mantis)&r"
		"&fDivine Purple Centipede (mysticism:divine_purple_centipede); Divine Queen Wasp (mysticism:divine_queen_wasp); Divine Singularity Scorpion (mysticism:divine_singularity_scorpion); Divine Stag Beetle (mysticism:divine_stag_beetle); Divine Yellow Centipede (mysticism:divine_yellow_centipede); Drone Beetle (mysticism:drone_beetle)&r"
		"&fDrone Beetle Insectar (mysticism:drone_beetle_insectar); Drone Beetle Savant (mysticism:drone_beetle_savant); Earth Soul Insect (mysticism:earth_soul_insect); Fantasy Soul Insect (mysticism:fantasy_soul_insect); Fire Ant (mysticism:fire_ant); Fire Ant Insectar (mysticism:fire_ant_insectar)&r"
		"&fFire Ant Savant (mysticism:fire_ant_savant); Flame Soul Insect (mysticism:flame_soul_insect); Gravity Soul Insect (mysticism:gravity_soul_insect); Hardshell Ant (mysticism:hardshell_ant); Hardshell Ant Insectar (mysticism:hardshell_ant_insectar); Hardshell Ant Savant (mysticism:hardshell_ant_savant)&r"
		"&fInsect (mysticism:insect); Lightning Soul Insect (mysticism:lightning_soul_insect); Lixivant Mantis (mysticism:lixivant_mantis); Lixivant Mantis Insectar (mysticism:lixivant_mantis_insectar); Lixivant Mantis Savant (mysticism:lixivant_mantis_savant); Loxodrome Scorpion (mysticism:loxodrome_scorpion)&r"
		"&fLoxodrome Scorpion Insectar (mysticism:loxodrome_scorpion_insectar); Loxodrome Scorpion Savant (mysticism:loxodrome_scorpion_savant); Mantis (mysticism:mantis); Paralysis Soul Insect (mysticism:paralysis_soul_insect); Poison Soul Insect (mysticism:poison_soul_insect); Preying Mantis (mysticism:preying_mantis)&r"
		"&fPreying Mantis Insectar (mysticism:preying_mantis_insectar); Preying Mantis Savant (mysticism:preying_mantis_savant); Purple Centipede (mysticism:purple_centipede); Purple Centipede Insectar (mysticism:purple_centipede_insectar); Purple Centipede Savant (mysticism:purple_centipede_savant); Queen Wasp (mysticism:queen_wasp)&r"
		"&fQueen Wasp Insectar (mysticism:queen_wasp_insectar); Queen Wasp Savant (mysticism:queen_wasp_savant); Scorpion (mysticism:scorpion); Singularity Scorpion (mysticism:singularity_scorpion); Singularity Scorpion Insectar (mysticism:singularity_scorpion_insectar); Singularity Scorpion Savant (mysticism:singularity_scorpion_savant)&r"
		"&fSpatial Soul Insect (mysticism:spatial_soul_insect); Stag Beetle (mysticism:stag_beetle); Stag Beetle Insectar (mysticism:stag_beetle_insectar); Stag Beetle Savant (mysticism:stag_beetle_savant); Star Soul Insect (mysticism:star_soul_insect); Steel Soul Insect (mysticism:steel_soul_insect)&r"
		"&fWasp (mysticism:wasp); Water Soul Insect (mysticism:water_soul_insect); Wind Soul Insect (mysticism:wind_soul_insect); Yellow Centipede (mysticism:yellow_centipede); Yellow Centipede Insectar (mysticism:yellow_centipede_insectar); Yellow Centipede Savant (mysticism:yellow_centipede_savant)&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: Exoskeleton — completes when you learn it&r"
		"&8These tasks only track progress; they never grant or evolve a skill.&r"
	]
