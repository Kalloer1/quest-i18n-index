	quest.531637592F027C37.quest_subtitle: "Final Evolution • Ascension"
	quest.531637592F027C37.title: "Chaos Dragon"
	quest.53289192D4917BC7.quest_desc: [
		"&e&lProtecting your base&r"
		"&fOpen the FTB Chunks map, select the claim tool, and click your base chunks. Claiming protects them; force-loading is a separate option that keeps allowed chunks active when you are away.&r"
		""
		"&e&lPlaying with friends&r"
		"&fCreate or join the same FTB Team, then review member roles and permissions. An ally is not automatically allowed to edit every claimed block, so test access before leaving valuables unattended.&r"
		""
		"&e&lUseful FTB Essentials commands&r"
		"&f/home, /sethome, /delhome, /listhomes, /tpa, /tpahere, /tpaccept, /tpdeny, /back, /spawn, and /rtp.&r"
		""
		"&e&lUseful TenSura commands&r"
		"&f/nameable true or false controls whether other players may name you. /evolve race attempts your available default race evolution. /evolve demonLord and /evolve hero begin the matching awakening when every requirement is met.&r"
		""
		"&f/ability toggle <skill> <true|false> changes one toggleable skill. /ability toggle all <true|false> changes every eligible ability; use the all command carefully when several sustained skills consume resources.&r"
		""
		"&8Command availability, home limits, teleport delays, and permissions are controlled by the server. Use /help if one is unavailable.&r"
	]
	quest.53289192D4917BC7.title: "Claims, Teams, and Useful Commands"
