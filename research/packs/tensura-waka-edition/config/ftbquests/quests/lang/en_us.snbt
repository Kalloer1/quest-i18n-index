	quest.298A84A463F28D55.quest_desc: [
		"&e&lWhat it does&r"
		"&f§5Devour all in your path — corrosion, spatial storage, food chain, chaos control, and gourmet mist.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Start with Gourmet (tensura:gourmet), then use TR: Nightmare Ultimate evolution. Follow the requirements below.&r"
		""
		"&f2. Start with Guardian (tensura:guardian), then use TR: Nightmare Ultimate evolution. Follow the requirements below.&r"
		""
		"&5&lUpgrades and unlocks&r"
		"&eStarts from:&r"
		"&f• Gourmet (tensura:gourmet) through TR: Nightmare Ultimate evolution.&r &7Requirements: See the full requirements on the target skill's page.&r"
		"&f• Guardian (tensura:guardian) through TR: Nightmare Ultimate evolution.&r &7Requirements: See the full requirements on the target skill's page.&r"
		""
		"&c&lDetailed steps&r"
		"&f• TR: Nightmare requirements:&r"
		"&f• Master Gourmet (tensura:gourmet)&r"
		"&f• Master Guardian (tensura:guardian)&r"
		"&f• Have 25 total subordinates&r"
		"&f• Reach a maximum Magicule capacity of 120,000&r"
		"&f• Reach at least 120,000 maximum Magicule capacity (configurable default). UltimateEvolutionHelper checks capacity and does not spend it during this evolution helper.&r"
		"&f• The TR: Nightmare automatic-evolution gamerule must be enabled; satisfy the checklist, then trigger a normal EP update so the acquisition check runs.&r"
		"&f• This target's configurable ultimate-evolution switch must remain enabled.&r"
		"&f• A predecessor marked as a Directive Ego or Akashic Star Order imprint cannot be consumed by UltimateEvolutionHelper; clear or use that special state before attempting the normal replacement path.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: ｢ Beelzebub, Lord of Gourmet ｣ — completes when you learn it&r"
		"&f• Master: Gourmet — completes when mastered&r"
		"&f• Master: Guardian — completes when mastered&r"
		"&f• Maximum Magicules: 120,000 — exact maximum-Magicule value used by the mod's condition&r"
		"&8These tasks only track progress; they never grant or evolve a skill.&r"
	]
	quest.298A84A463F28D55.quest_subtitle: "Ultimate skill • TR: Nightmare"
	quest.298A84A463F28D55.title: "｢ Beelzebub, Lord of Gourmet ｣"
