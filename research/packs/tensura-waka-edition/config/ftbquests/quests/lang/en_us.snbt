	quest.5D519F878C561F69.quest_desc: [
		"&e&lWhat it does&r"
		"&7The mod does not provide an effect description for this ability.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Defeat Awakened Feldway in Survival. If you have already exhausted his exclusive authority rewards, he rolls a random Unique skill you do not own instead. This skill is in that pool, but the result is random, normal learning restrictions still apply, and Feldway's reward is normally once per player.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: Void Archive — completes when you learn it&r"
		"&8These tasks only track progress; they never grant or evolve a skill.&r"
	]
	quest.5D519F878C561F69.quest_subtitle: "Unique skill • Tensura More Skills"
	quest.5D519F878C561F69.title: "Void Archive"
	quest.5D551C1D9DF85F69.quest_desc: [
		"&e&lWhat it does&r"
		"&fPull nearby dropped items toward you while held.&r"
		""
		"&a&lHow to get it&r"
		""
		"&fMaster Gravity Field. The addon checks once per second and grants Magnet automatically after Gravity Field reaches mastery.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: Magnet — completes when you learn it&r"
	]
	quest.5D551C1D9DF85F69.quest_subtitle: "Extra skill • Tensura Useful Ability"
	quest.5D551C1D9DF85F69.title: "Magnet"
	quest.5D6237E4FC2A4F93.quest_desc: [
		"&e&lWhat it does&r"
		"&fFine mastery over mixing Light, heat, and energy in all forms into every movement, accelerating to light speed.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Automatic acquisition check: possess tensura:commander. Trigger a normal EP update after satisfying it (for example by defeating another mob) so TenSura re-evaluates learnable skills.&r"
		""
		"&f2. Start with Commander (tensura:commander), then use TR: Nightmare Ultimate evolution. Follow the requirements below.&r"
		""
		"&5&lUpgrades and unlocks&r"
		"&eStarts from:&r"
		"&f• Commander (tensura:commander) through TR: Nightmare Ultimate evolution.&r &7Requirements: See the full requirements on the target skill's page.&r"
		""
		"&c&lDetailed steps&r"
		"&f• TR: Nightmare requirements:&r"
		"&f• Master Commander (tensura:commander)&r"
		"&f• Name 20 subordinates&r"
		"&f• Be at or below 0.6 of maximum HP when attempting evolution&r"
		"&f• Master Flame Domination (tensura:flame_domination)&r"
		"&f• Master Spatial Domination (tensura:spatial_domination)&r"
		"&f• Master Commander (tensura:commander).&r"
		"&f• Reach at least 350,000 maximum Magicule capacity (configurable default). UltimateEvolutionHelper checks capacity and does not spend it during this evolution helper.&r"
		"&f• The TR: Nightmare automatic-evolution gamerule must be enabled; satisfy the checklist, then trigger a normal EP update so the acquisition check runs.&r"
		"&f• The TR: Nightmare Nightmare Ultimates gamerule must be enabled.&r"
		"&f• This target's configurable ultimate-evolution switch must remain enabled.&r"
		"&f• A predecessor marked as a Directive Ego or Akashic Star Order imprint cannot be consumed by UltimateEvolutionHelper; clear or use that special state before attempting the normal replacement path.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: ｢ Amaterasu, Lord of Shimmering Flames ｣ — completes when you learn it&r"
		"&f• Master: Commander — completes when mastered&r"
		"&f• Master: Flame Domination — completes when mastered&r"
		"&f• Master: Spatial Domination — completes when mastered&r"
		"&f• Maximum Magicules: 350,000 — exact configured-default capacity gate used by UltimateEvolutionHelper&r"
		"&8These tasks only track progress; they never grant or evolve a skill.&r"
	]
	quest.5D6237E4FC2A4F93.quest_subtitle: "Ultimate skill • TR: Nightmare"
	quest.5D6237E4FC2A4F93.title: "｢ Amaterasu, Lord of Shimmering Flames ｣"
