	quest.02F500268FA42309.quest_desc: [
		"&e&lWhat you need&r"
		"&eEP: &f800,000 &8(configurable default)&r"
		""
		"&e&lComes from&r"
		"&fFairy&8 — Normal evolution&r"
		"&fLesser Fairy&8 — Harvest Festival evolution&r"
		""
		"&e&lWhere this path leads&r"
		"&fFairy Queen&8 — Normal evolution&r"
		""
		"&d&lSpecial progression route&r"
		"&fThis registered race is not reachable from the pack's normal starting-race evolution graph. It may require a special mechanic, command, mod-specific transformation, or another non-standard route."
		""
		"&a&lHow to evolve&r"
		"&f1. Raise your base maximum EP to at least 800,000. Defeat eligible enemies to grow permanent Aura/Magicules, then reopen the TenSura evolution menu. Temporary or equipment bonuses may fill the displayed EP tracker without meeting this base-EP condition.&r"
		"&f2. Open the TenSura evolution menu and select this race. The quest does not perform the evolution for you.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Maximum EP: 800,000 — approximate: FTB reads total maximum EP; race checks base maximum EP&r"
		"&f• Current race: Fairy Lord — checks your current race&r"
		"&8Trackers show your progress, but you still evolve through TenSura's evolution menu.&r"
		"&8Naming, body/form state, location conditions, item-use counts, and some addon counters cannot be tracked automatically. Follow the steps above whenever no tracker is shown.&r"
	]
	quest.02F500268FA42309.quest_subtitle: "Special / Non-standard Race • TR Arcane"
	quest.02F500268FA42309.title: "Fairy Lord"
	quest.0304D11F13EA5878.quest_desc: [
		"&e&lWhat it does&r"
		"&f§dManipulate the moods and fate of yourself and others — twist luck, defy death, and amplify your spirit.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Start with Tuner (tensura:tuner), then use TR: Nightmare Ultimate evolution. Follow the requirements below.&r"
		""
		"&5&lUpgrades and unlocks&r"
		"&eStarts from:&r"
		"&f• Tuner (tensura:tuner) through TR: Nightmare Ultimate evolution.&r &7Requirements: See the full requirements on the target skill's page.&r"
		""
		"&c&lDetailed steps&r"
		"&f• TR: Nightmare requirements:&r"
		"&f• Master Tuner (tensura:tuner)&r"
		"&f• Use Tuner (tensura:tuner)'s `destinyChangeUses` mechanic until its internal counter reaches 100&r"
		"&f• Reach a maximum Magicule capacity of 500,000&r"
		"&f• Reach at least 500,000 maximum Magicule capacity (configurable default). UltimateEvolutionHelper checks capacity and does not spend it during this evolution helper.&r"
		"&f• The TR: Nightmare automatic-evolution gamerule must be enabled; satisfy the checklist, then trigger a normal EP update so the acquisition check runs.&r"
		"&f• This target's configurable ultimate-evolution switch must remain enabled.&r"
		"&f• A predecessor marked as a Directive Ego or Akashic Star Order imprint cannot be consumed by UltimateEvolutionHelper; clear or use that special state before attempting the normal replacement path.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: ｢ Mood Maker, Lord of Psychology ｣ — completes when you learn it&r"
		"&f• Master: Tuner — completes when mastered&r"
		"&f• Maximum Magicules: 500,000 — exact maximum-Magicule value used by the mod's condition&r"
		"&8These tasks only track progress; they never grant or evolve a skill.&r"
	]
	quest.0304D11F13EA5878.quest_subtitle: "Ultimate skill • TR: Nightmare"
	quest.0304D11F13EA5878.title: "｢ Mood Maker, Lord of Psychology ｣"
