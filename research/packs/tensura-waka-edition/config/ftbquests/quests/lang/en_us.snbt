	quest.0C8DB3BE9768B0C3.quest_desc: [
		"&fThese races do not fit the normal difficulty ladder. Many are addon transformations, unusual variants, crossover forms, or destinations reached from a race line in another chapter.&r"
		""
		"&fTreat this chapter as a route reference rather than a list of equal starting choices. Check every quest's acquisition notes and follow its preserved connections wherever a registered evolution line exists.&r"
	]
	quest.0C8DB3BE9768B0C3.title: "About Special and Non-Standard Races"
