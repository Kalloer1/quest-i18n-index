	quest.48826B49DD82E0AF.quest_desc: [
		"&e&lWhat it does&r"
		"&fThe insatiable Ultimate evolved from Gluttony at the cost of Merciless. Devour, store, convert, and redistribute power through the Food Chain.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Start with Gluttony (tensura:gluttony), then use Elite Ultimate acquisition. Follow the requirements below.&r"
		""
		"&f2. Start with Merciless (tensura:merciless), then use Elite Ultimate acquisition. Follow the requirements below.&r"
		""
		"&f3. Elite Ultimate acquisition: Learn and master every prerequisite: tensura:gluttony, tensura:merciless. Reach at least 10,000,000 EP and awaken as either a True Demon Lord or a True Hero. Gain EP again so the normal skill-acquisition check runs. With the skill enabled, the addon grants the Ultimate automatically. Merciless is removed when Beelzebuth is learned.&r"
		""
		"&5&lUpgrades and unlocks&r"
		"&eStarts from:&r"
		"&f• Gluttony (tensura:gluttony) through Elite Ultimate acquisition.&r &7Requirements: master every listed prerequisite; EP at least 10,000,000; True Demon Lord OR True Hero; skill enabled.&r"
		"&f• Merciless (tensura:merciless) through Elite Ultimate acquisition.&r &7Requirements: master every listed prerequisite; EP at least 10,000,000; True Demon Lord OR True Hero; skill enabled.&r"
		""
		"&c&lImportant&r"
		"&8Elite requirementsEnabled=false bypasses the mastery/EP/awakening gate. Merciless is removed when Beelzebuth is learned.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: Beelzebuth, Lord of Gluttony — completes when you learn it&r"
		"&f• Maximum EP: 10,000,000 — exact default Elite EP gate&r"
		"&f• True Demon Lord or True Hero — exact True Demon Lord-or-True Hero gate&r"
		"&f• Master: Gluttony — exact current mastery required by Elite&r"
		"&f• Master: Merciless — exact current mastery required by Elite&r"
		"&8These tasks only track progress; they never grant or evolve a skill.&r"
	]
	quest.48826B49DD82E0AF.quest_subtitle: "Ultimate skill • Elite Tensura"
	quest.48826B49DD82E0AF.title: "Beelzebuth, Lord of Gluttony"
	quest.4888E334F4CB33CA.quest_desc: [
		"&e&lWhat it does&r"
