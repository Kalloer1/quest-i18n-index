	quest.74DFE7EA598CB221.quest_subtitle: "Extra skill • TenSura: Reincarnated"
	quest.74DFE7EA598CB221.title: "Hero Haki"
	quest.74E5E8E28A87CE3B.quest_desc: [
		"Defeat Vex 10 times after this quest pack is installed."
		""
		"&aReward: &f+75 maximum EP&r"
		"&8This milestone tracks alongside the other kill goals for this mob, so every kill counts toward all of them.&r"
