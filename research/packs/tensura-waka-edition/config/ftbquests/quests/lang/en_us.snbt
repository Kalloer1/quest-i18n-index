	quest.7D524EC9A45F67F6.title: "Ultimate Slime"
	quest.7D6E4FB336103E21.quest_desc: [
		"&e&lWhat it does&r"
		"&fSteal the vitality of your opponent and temporarily transform this skill into one of theirs to potentially turn the tables.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Choose or evolve into one of the races listed below. The race grants this skill automatically.&r"
		""
		"&f2. Steal it from one of the mobs below with Gluttony. Either make the mob your subordinate and use Gluttony's skill-retrieval mode, or kill it with Corrosion mode. This only works for allowed Common, Extra, Intrinsic, or Resistance skills, and another mod can still block the attempt.&r"
		""
		"&6&lMobs that use it&r"
		"&fGiant Bat (tensura:giant_bat); Vaelthorn, the Hollow Sovereign (elitetensura:lich_boss)&r"
		"&8A mob having the skill does not guarantee a drop. Use one of the learning methods above.&r"
		""
		"&d&lRaces that grant it&r"
		"&fBeholder (ascension:beholder); Blood Noble (ascension:blood_noble); Bog Ancient (ascension:bog_ancient); Cursed Dreadnaught (ascension:cursed_dreadnaught); Cursed Mariner (ascension:cursed_mariner); Davy Jones (ascension:davy_jones)&r"
		"&fDeath Tyrant (ascension:death_tyrant); Elder Bloodfiend (ascension:elder_bloodfiend); Fledgling Bloodfiend (ascension:fledgling_bloodfiend); Frog Monarch (ascension:frog_monarch); Gauth (ascension:gauth); Gazer (ascension:gazer)&r"
		"&fInfinite Djinn (ascension:infinite_djinn); Kindred Bloodfiend (ascension:kindred_bloodfiend); Mindwitness (ascension:mindwitness); Omniversal Djinn (ascension:omniversal_djinn); Phantom Corsair (ascension:phantom_corsair); Progenitor Bloodfiend (ascension:progenitor_bloodfiend)&r"
		"&fSovereign Djinn (ascension:sovereign_djinn); Spectator (ascension:spectator_gazer)&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: Drain — completes when you learn it&r"
		"&8These tasks only track progress; they never grant or evolve a skill.&r"
	]
	quest.7D6E4FB336103E21.quest_subtitle: "Intrinsic skill • TenSura: Reincarnated"
	quest.7D6E4FB336103E21.title: "Drain"
	quest.7D6F1C9EDF4425F5.quest_desc: [
		"Defeat Guard 25 times after this quest pack is installed."
		""
		"&aReward: &f+100 maximum EP&r"
