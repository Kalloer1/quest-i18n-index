	quest.7F68416B093D0512.quest_desc: [
		"&e&lWhat it does&r"
		"&fA faithful secret that binds your owner to your God and empowers holy manipulation.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Join another player's TR: Nightmare faith as a follower. When the faith system marks you Faithful, it grants Secret of Faith.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: Secret of Faith — completes when you learn it&r"
		"&8The tracker verifies the resulting skill; addon-specific counters and random rolls are not exposed to FTB Quests.&r"
	]
	quest.7F68416B093D0512.quest_subtitle: "Extra skill • TR: Nightmare"
	quest.7F68416B093D0512.title: "Secret of Faith"
