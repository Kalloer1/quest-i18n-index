	quest.58F597256C1967E9.quest_subtitle: "Evolution • TR: Nightmare"
	quest.58F597256C1967E9.title: "Wanderer"
	quest.5902E616EDFD1494.quest_desc: [
		"Defeat Legioner 25 times after this quest pack is installed."
		""
		"&aReward: &f+100 maximum EP&r"
