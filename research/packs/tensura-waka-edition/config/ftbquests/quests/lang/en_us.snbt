	quest.10AF184F634C4F84.quest_desc: [
		"&fMysticism links the Elemental Realm to the Labyrinth. Use the realm portal route or travel through the Labyrinth's high-altitude connection; falling below the Elemental Realm returns you to the Labyrinth.&r"
		""
		"&fThe realm has elemental biomes and its own magicule behavior. Mark a safe platform before exploring.&r"
	]
