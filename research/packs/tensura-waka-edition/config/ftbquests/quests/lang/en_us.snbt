	quest.2A6E6272CC380B27.quest_desc: [
		"&e&lStarting stats and abilities&r"
		"&eStarting EP range: &f3,000–5,000 &8(from base Aura + Magicules)&r"
		"&eAura: &f1,000–2,000"
		"&eMagicules: &f2,000–3,000"
		"&eIntrinsic skills: &fParalysis, Strength, Self-Regeneration"
		"&eRace modifiers: &fMax Health -6, Spiritual Health -20, Movement Speed -0.02"
		""
		"&e&lWhere this path leads&r"
		"&fVampire&8 — Normal evolution, Harvest Festival evolution&r"
		"&fVampire Lord&8 — Awakening evolution&r"
		""
		"&a&lHow to evolve&r"
		"&f1. Raise your base maximum EP to at least 3,000. Defeat eligible enemies to grow permanent Aura/Magicules, then reopen the TenSura evolution menu. Temporary or equipment bonuses may fill the displayed EP tracker without meeting this base-EP condition.&r"
		"&f2. Open the TenSura evolution menu and select this race. The quest does not perform the evolution for you.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Maximum EP: 3,000 — approximate: FTB reads total maximum EP; race checks base maximum EP&r"
		"&f• Current race: Ghoul — checks your current race&r"
		"&8Trackers show your progress, but you still evolve through TenSura's evolution menu.&r"
		"&8Naming, body/form state, location conditions, item-use counts, and some addon counters cannot be tracked automatically. Follow the steps above whenever no tracker is shown.&r"
	]
	quest.2A6E6272CC380B27.quest_subtitle: "Starting Reincarnation • TenSura: Reincarnated"
	quest.2A6E6272CC380B27.title: "Ghoul"
