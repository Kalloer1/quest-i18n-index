		"&f1. Choose or evolve into one of the races listed below. The race grants this skill automatically.&r"
		""
		"&d&lRaces that grant it&r"
		"&fAbyssal Dragonewt (ascension:abyssal_dragonewt); Arch Daemonic Dragon (trnightmare:arch_daemonic_dragon); Arch Dragon (trnightmare:arch_dragon); Chaos Dragon (ascension:chaos_dragon); Corrupted Dragon (ascension:corrupted_dragon); Corrupted Dragonkin (ascension:corrupted_dragonkin)&r"
		"&fCursed Dragon (ascension:cursed_dragon); Daemonic Dragon Lord (trnightmare:daemonic_dragon_lord); Death Dragon (trnightmare:death_dragon); Demon Dragon God (ascension:demon_dragon_god); Demonic Dragon (ascension:demonic_dragon); Devil Dragon Lord (trnightmare:devil_dragon_lord)&r"
		"&fDivine Dragon (tensura:divine_dragon); Divine Dragon Lord (trnightmare:divine_dragon_lord); Divine Gehenna Dragon (trnightmare:divine_gehenna_dragon); Divine Heavenly Dragon (trnightmare:divine_heavenly_dragon); Divine Netherite Dragon (trnightmare:divine_netherite_dragon); Divine Saiyan (elitetensura:divine_saiyan)&r"
		"&fDivine Void Dragon (trnightmare:divine_void_dragon); Dragon Lord (trnightmare:dragon_lord); Dragonewt (tensura:dragonewt); Dragonoid (mysticism:dragonoid); Element Dragon (trnightmare:element_dragon); Ender Dragon Prince (trnightmare:ender_dragon_prince)&r"
		"&fEnder Dragonewt (ascension:ender_dragonewt); Gehenna Dragon (trnightmare:gehenna_dragon); Heavenly Dragon (trnightmare:heavenly_dragon); High Class Saiyan (elitetensura:high_saiyan); Lesser Daemonic Dragon (trnightmare:lesser_daemonic_dragon); Lesser Dragon (trnightmare:lesser_dragon)&r"
		"&fLesser Ender Dragon (trnightmare:lesser_ender_dragon); Lesser Holy Dragon (trnightmare:lesser_holy_dragon); Lesser Nether Dragon (trnightmare:lesser_nether_dragon); Lesser Zombie Dragon (trnightmare:lesser_zombie_dragon); Medium Daemonic Dragon (trnightmare:medium_daemonic_dragon); Medium Dragon (trnightmare:medium_dragon)&r"
		"&fMedium Ender Dragon (trnightmare:medium_ender_dragon); Medium Holy Dragon (trnightmare:medium_holy_dragon); Medium Nether Dragon (trnightmare:medium_nether_dragon); Medium Zombie Dragon (trnightmare:medium_zombie_dragon); Netherite Dragon (trnightmare:netherite_dragon); Rimeblight Hydra (mysticism:rimeblight_hydra)&r"
		"&fRimefang Drake (mysticism:rimefang_drake); Saint Dragon (trnightmare:saint_dragon); Salamander Assassin (trnightmare:salamander_assassin); Salamander Poison Spirit (trnightmare:salamander_poison_spirit); Salamander Poison Spirit Dragon (trnightmare:salamander_poison_dragon); Scorchtail Salamander (mysticism:scorchtail_salamander)&r"
		"&fScorchtalon Wyvern (mysticism:scorchtalon_wyvern); Scrap Dragon (trnightmare:scrap_dragon); True Dragon (trorigins:true_dragon); True Dragonewt (tensura:true_dragonewt); True Dragonoid (mysticism:true_dragonoid); Void Dragon (trnightmare:void_dragon)&r"
		"&fVoid Dragonewt (ascension:void_dragonewt)&r"
