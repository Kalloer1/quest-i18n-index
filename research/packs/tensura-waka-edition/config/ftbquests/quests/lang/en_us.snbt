	quest.38948C373B95EA3A.quest_desc: [
		"&e&lCheck your controls before adventuring&r"
		"&fOpen Options → Controls → Key Binds and search the &eTensura: Reincarnated &fcategory. Modpacks can create conflicts, so resolve any red bindings before you rely on them in combat.&r"
		""
		"&e&lFinding a quest&r"
		"&fWhile the FTB Quests book is open, press &eCtrl+F&f. The installed FTB Quests version opens its built-in chapter/quest selector; type a skill or quest name and choose the result to jump directly to it.&r"
		""
		"&eDefault keys&r"
		"&f• B — Status Menu&r"
		"&f• N — Naming&r"
		"&f• Z / X / C — Ability Slots 1 / 2 / 3&r"
		"&f• Left Alt — Next Ability Mode&r"
		"&f• Previous Ability Mode — unbound by default&r"
		"&f• R — Race or Mount Ability&r"
		"&f• V — Dodge or Mount Descend&r"
		""
		"&8These are the mod's coded defaults. Your profile or another mod may have changed them.&r"
	]
	quest.38948C373B95EA3A.title: "Controls and Keybinds"
	quest.389AFB802222B907.quest_desc: [
		"&fLearn one magic ability you can use regularly, then train it to mastery. Mastery is often the actual evolution gate; ownership alone may not count.&r"
		""
		"&fThis tracks TenSura's lifetime magic-mastered statistic.&r"
	]
	quest.389AFB802222B907.title: "Master Your First Magic"
	quest.38A629F83A9F7522.quest_desc: [
