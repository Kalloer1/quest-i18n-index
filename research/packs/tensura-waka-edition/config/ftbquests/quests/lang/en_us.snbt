	quest.2A6FE46F24F1845D.title: "Mule: 100 Kills"
	quest.2A76B5D52A10880D.quest_desc: [
		"&e&lCommon counter traps&r"
		"&fKill requirements name a specific entity. EP requirements use your TenSura EP. Skill-held and skill-mastered requirements are different checks. Structure and biome requirements only count after Elite Tensura records the discovery.&r"
		""
		"&fSingle-hit damage is one hit, not total damage. Claimed-chunk requirements use FTB Chunks claims. Awakening requirements can mean any awakening, specifically True Demon Lord, or specifically True Hero.&r"
	]
	quest.2A76B5D52A10880D.title: "Understand Requirement Counters"
