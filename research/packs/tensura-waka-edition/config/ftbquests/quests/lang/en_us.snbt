	quest.65A633B2D835F626.title: "Zombie"
	quest.65A6FA7FED13E212.quest_desc: [
		"&e&lWhat it does&r"
		"&f§7Ultimate charity — upgraded Encore and Stockpile, Parallel Existence, optional Cardinal Acceleration, and Amplification with Thought Acceleration (non-stacking).&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Start with Endorse (trnightmare:endorse), then use TR: Nightmare Ultimate evolution. Follow the requirements below.&r"
		""
		"&5&lUpgrades and unlocks&r"
		"&eStarts from:&r"
		"&f• Endorse (trnightmare:endorse) through TR: Nightmare Ultimate evolution.&r &7Requirements: See the full requirements on the target skill's page.&r"
		"&eCan evolve into / unlock:&r"
		"&f• ｢ Cthugha, King of Divine Flame ｣ (trnightmare:cthugha) through TR: Nightmare Ultimate evolution.&r &7Requirements: See the full requirements on the target skill's page.&r"
		"&f• ｢ Agni, Lord of Blaze ｣ (trnightmare:agni) through TR: Nightmare Ultimate evolution.&r &7Requirements: See the full requirements on the target skill's page.&r"
		"&f• Joyful Manas (trnightmare:joyful_manas) through TR: Nightmare Ego-to-Manas naming.&r &7Requirements: matching Ultimate and Ego personality; social points > 225; Ego stage 4; successful naming.&r"
		""
		"&c&lDetailed steps&r"
		"&f• TR: Nightmare requirements:&r"
		"&f• Master Endorse (trnightmare:endorse)&r"
		"&f• Win 25 village raids&r"
		"&f• Raise custom statistic minecraft:cured_zombie_villager to 1&r"
		"&f• Reach at least 900,000 maximum Magicule capacity (configurable default). UltimateEvolutionHelper checks capacity and does not spend it during this evolution helper.&r"
		"&f• The TR: Nightmare automatic-evolution gamerule must be enabled; satisfy the checklist, then trigger a normal EP update so the acquisition check runs.&r"
		"&f• The TR: Nightmare Nightmare Ultimates gamerule must be enabled.&r"
		"&f• This target's configurable ultimate-evolution switch must remain enabled.&r"
		"&f• A predecessor marked as a Directive Ego or Akashic Star Order imprint cannot be consumed by UltimateEvolutionHelper; clear or use that special state before attempting the normal replacement path.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: ｢ Raguel, Lord of Charity ｣ — completes when you learn it&r"
		"&f• Master: Endorse — completes when mastered&r"
		"&f• Village raids won: 25 — exact lifetime statistic used by this condition&r"
		"&f• minecraft:cured_zombie_villager: 1 — optional approximate tracker&r"
		"&f• Maximum Magicules: 900,000 — exact configured-default capacity gate used by UltimateEvolutionHelper&r"
		"&8These tasks only track progress; they never grant or evolve a skill.&r"
	]
	quest.65A6FA7FED13E212.quest_subtitle: "Ultimate skill • TR: Nightmare"
	quest.65A6FA7FED13E212.title: "｢ Raguel, Lord of Charity ｣"
