	quest.7008C17011766FF7.quest_desc: [
		"&fFind a Black Spider Nest. Nests are a good early test of crowd control: block escape routes and avoid fighting the whole room from the center.&r"
		""
		"&fReturn later if you need the mob's drops or possession pool; destroying every useful spawner immediately can make future farming harder.&r"
	]
