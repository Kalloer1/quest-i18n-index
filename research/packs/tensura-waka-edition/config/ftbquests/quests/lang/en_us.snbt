	quest.0F53E105AA2C870A.quest_desc: [
		"&e&lStarting stats and abilities&r"
		"&eStarting EP range: &f1,800–3,100 &8(from base Aura + Magicules)&r"
		"&eAura: &f300–600"
		"&eMagicules: &f1,500–2,500"
		"&eIntrinsic skills: &fMagic Jamming"
		"&eRace modifiers: &fMax Health +10, Spiritual Health +5"
		""
		"&e&lWhere this path leads&r"
		"&fHarpy Queen&8 — Normal evolution, Harvest Festival evolution&r"
		"&fSpirit Bird&8 — Awakening evolution&r"
		""
		"&a&lHow to evolve&r"
		"&f1. Raise your base maximum EP to at least 1,800. Defeat eligible enemies to grow permanent Aura/Magicules, then reopen the TenSura evolution menu. Temporary or equipment bonuses may fill the displayed EP tracker without meeting this base-EP condition.&r"
		"&f2. Open the TenSura evolution menu and select this race. The quest does not perform the evolution for you.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Maximum EP: 1,800 — approximate: FTB reads total maximum EP; race checks base maximum EP&r"
		"&f• Current race: Harpy — checks your current race&r"
		"&8Trackers show your progress, but you still evolve through TenSura's evolution menu.&r"
		"&8Naming, body/form state, location conditions, item-use counts, and some addon counters cannot be tracked automatically. Follow the steps above whenever no tracker is shown.&r"
	]
	quest.0F53E105AA2C870A.quest_subtitle: "Starting Reincarnation • TenSura: Reincarnated"
	quest.0F53E105AA2C870A.title: "Harpy"
	quest.0F719ED8B04A760E.quest_desc: [
		"&e&lWhat it does&r"
		"&fAn intrinsic skill that rapidly restores health while in or near water.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Automatic acquisition check: master tensura:self_regeneration. Trigger a normal EP update after satisfying it (for example by defeating another mob) so TenSura re-evaluates learnable skills.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: Aquatic Regeneration — completes when you learn it&r"
		"&8These tasks only track progress; they never grant or evolve a skill.&r"
	]
	quest.0F719ED8B04A760E.quest_subtitle: "Intrinsic skill • TR: Nightmare"
	quest.0F719ED8B04A760E.title: "Aquatic Regeneration"
	quest.0F7C6EB3129FD254.quest_desc: [
		"Defeat Evil Centipede 5 times after this quest pack is installed."
		""
		"&aReward: &f+50 maximum EP&r"
		"&8This milestone tracks alongside the other kill goals for this mob, so every kill counts toward all of them.&r"
	]
	quest.0F7C6EB3129FD254.title: "Evil Centipede: 5 Kills"
	quest.0F82892470C30CFC.quest_desc: [
		"&e&lWhat it does&r"
		"&fBoosts Space abilities by a decent amount and manipulate space to empower your ranged attacks.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Choose or evolve into one of the races listed below. The race grants this skill automatically.&r"
		""
		"&f2. Automatic acquisition check: reach Space Spirit level 1. Trigger a normal EP update after satisfying it (for example by defeating another mob) so TenSura re-evaluates learnable skills.&r"
		""
		"&f3. Steal it from one of the mobs below with Gluttony. Either make the mob your subordinate and use Gluttony's skill-retrieval mode, or kill it with Corrosion mode. This only works for allowed Common, Extra, Intrinsic, or Resistance skills, and another mod can still block the attempt.&r"
		""
		"&f4. Start with Spatial Motion (tensura:spatial_motion), then use TenSura mastery unlock. Follow the requirements below.&r"
		""
		"&f1. &eTR: Origins True Dragon route:&f become the True Dragon race and receive an unclaimed elemental seat. The addon randomly assigns one available Abyss, Earth, Scorch, Frost, or Storm seat; receiving Abyss, Storm grants this skill automatically. Each elemental seat can have only one owner per world, so this route cannot be targeted reliably on an established server.&r"
		""
		"&6&lMobs that use it&r"
		"&fAkash (tensura:akash); Winged Cat (tensura:winged_cat)&r"
		"&8A mob having the skill does not guarantee a drop. Use one of the learning methods above.&r"
		""
		"&d&lRaces that grant it&r"
		"&fMystical Purple Fang (mysticism:mystical_purple_fang); Planet Spirit Wolf (mysticism:planet_spirit_wolf); Purple Fang (mysticism:purple_fang); Spatial Soul Insect (mysticism:spatial_soul_insect); Star Wolf (mysticism:star_wolf); Storm Spirit Wolf (mysticism:storm_spirit_wolf)&r"
		"&fTempest Star Wolf (mysticism:tempest_star_wolf)&r"
		""
		"&5&lUpgrades and unlocks&r"
		"&eStarts from:&r"
		"&f• Spatial Motion (tensura:spatial_motion) through TenSura mastery unlock.&r &7Requirements: Master tensura:spatial_motion; the source skill's onSkillMastered hook starts learning tensura:spatial_manipulation.&r"
		"&eCan evolve into / unlock:&r"
		"&f• Spatial Domination (tensura:spatial_domination) through TR: Nightmare Designer evolution recipe.&r &7Requirements: Own one of Designer/Astarte/Astaroth/Hand of Creation; input tensura:spatial_manipulation; possess tensura:spatial_manipulation; pay 100,000 MP. Result is weighted (weight 1).&r"
		"&f• Spatial Domination (tensura:spatial_domination) through TenSura mastery unlock.&r &7Requirements: Master tensura:spatial_manipulation; the source skill's onSkillMastered hook starts learning tensura:spatial_domination.&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: Spatial Manipulation — completes when you learn it&r"
		"&8These tasks only track progress; they never grant or evolve a skill.&r"
	]
	quest.0F82892470C30CFC.quest_subtitle: "Extra skill • TenSura: Reincarnated"
	quest.0F82892470C30CFC.title: "Spatial Manipulation"
