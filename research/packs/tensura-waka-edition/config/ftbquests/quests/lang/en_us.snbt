	quest.1DB7FC4CC22F8A56.quest_desc: [
		"&fExtreme race lines are long-term character projects. Their starts or later evolutions can be punishing and may rely on dangerous dimensions, advanced skills, awakenings, rare encounters, or narrow addon conditions.&r"
		""
		"&fRead the entire connected line before choosing one. The difficulty marker is informational and never replaces the exact conditions written on each race quest.&r"
	]
	quest.1DB7FC4CC22F8A56.title: "About Extreme Races"
	quest.1DD783A12AC8833E.quest_desc: [
		"&e&lWhat it does&r"
		"&fSlashing through space in a straight line, displacing entities or teleporting the caster.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Form a Greater-or-higher Space spirit contract. Find and tame a qualifying elemental spirit (the configured tame chance applies), or stand centered above a Praying Path and keep sneaking for its configured prayer time; a successful roll stores the higher contract and grants every Space Spiritual Magic through Greater, including this one.&r"
		""
		"&d&lSpirit contract&r"
		"&fElement: Space. Minimum contract level: Greater. A higher contract also grants this spell because grantSpiritMagic includes every matching spell at or below the stored level.&r"
		""
		"&6&lMobs that use it&r"
		"&fAlways has this ability:&r"
		"&fHinata Sakaguchi (tensura:hinata_sakaguchi)&r"
		"&8Seeing a mob use this ability does not mean it can drop or teach it. Follow one of the methods above.&r"
		""
		"&3&lQuest tracking&r"
		"&fThe Learn task checks whether you currently know this ability. Extra mastery or EP tasks appear only when every valid route requires them.&r"
		"&8The book cannot predict random loot, shop rotations, manual rolls, taming chances, contract rolls, or uninterrupted training time.&r"
	]
	quest.1DD783A12AC8833E.quest_subtitle: "Spiritual Magic • TenSura: Reincarnated"
	quest.1DD783A12AC8833E.title: "Swipe"
	quest.1DDD28DABA602B95.quest_desc: [
