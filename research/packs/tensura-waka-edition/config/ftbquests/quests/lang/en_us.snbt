	quest.5C702B85B17A013B.title: "Tier 3: Assault the Citadel"
	quest.5C794A25B1073E03.quest_desc: [
		"&e&lWhat it does&r"
		"&fBoosts the power of light abilities by a decent amount.&r"
		""
		"&a&lHow to get it&r"
		""
		"&f1. Choose or evolve into one of the races listed below. The race grants this skill automatically.&r"
		""
		"&f2. Automatic acquisition check: reach Light Spirit level 1. Trigger a normal EP update after satisfying it (for example by defeating another mob) so TenSura re-evaluates learnable skills.&r"
		""
		"&f1. &eTR: Origins True Dragon route:&f become the True Dragon race and receive an unclaimed elemental seat. The addon randomly assigns one available Abyss, Earth, Scorch, Frost, or Storm seat; receiving Scorch grants this skill automatically. Each elemental seat can have only one owner per world, so this route cannot be targeted reliably on an established server.&r"
		""
		"&d&lRaces that grant it&r"
		"&fAntumbra Spirit Wolf (mysticism:antumbra_spirit_wolf); Arch Angel (mysticism:arch_angel); Arch Fallen of Origin (trorigins:arch_fallen_of_origin); Cherub (mysticism:cherub); Divine Tengu (mysticism:divine_tengu); Fallen Arch Angel (mysticism:fallen_arch_angel)&r"
		"&fFallen Arch Angel of Origin (trorigins:fallen_origin_arch_angel); Fallen Cherub of Origin (trorigins:fallen_cherub_of_origin); Fallen Greater Angel (mysticism:fallen_greater_angel); Fallen Lesser Angel (mysticism:fallen_lesser_angel); Fallen Lord of Origin (trorigins:fallen_lord_of_origin); Fallen ReaperAberration (mysticism:fallen_seraph)&r"
		"&fFallen Seraph of Origin (trorigins:fallen_seraph_of_origin); Fallen SoulAberration (mysticism:fallen_cherub); Fallen of Origin (trorigins:fallen_of_origin); Greater Angel (mysticism:greater_angel); Lesser Angel (mysticism:lesser_angel); Light Fang (mysticism:light_fang)&r"
		"&fMystical Light Fang (mysticism:mystical_light_fang); Origin Arch Angel (trorigins:origin_arch_angel); Seraph (mysticism:seraph); Tengu (mysticism:tengu); Tengu Saint (mysticism:tengu_saint)&r"
		""
		"&3&lQuest tracking&r"
		"&f• Learn: Light Manipulation — completes when you learn it&r"
		"&8These tasks only track progress; they never grant or evolve a skill.&r"
	]
	quest.5C794A25B1073E03.quest_subtitle: "Extra skill • Mysticism"
	quest.5C794A25B1073E03.title: "Light Manipulation"
	quest.5C8A8634AE2631BC.quest_desc: [
		"&e&lWhat you need&r"
		"&eEP: &f500,000 &8(configurable default)&r"
