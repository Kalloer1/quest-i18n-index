	quest.21DFBBDCE7600F4E.quest_desc: [
		"&e&lStarting stats and abilities&r"
		"&eStarting EP range: &f1,800–3,100 &8(from base Aura + Magicules)&r"
		"&eAura: &f1,500–2,500"
		"&eMagicules: &f300–600"
		"&eIntrinsic skills: &fBeast Transformation, Self-Regeneration"
		"&eRace modifiers: &fMax Health +2, Spiritual Health +10, Movement Speed +0.05"
		""
		"&e&lWhere this path leads&r"
		"&fBeast Lord&8 — Normal evolution, Harvest Festival evolution&r"
		"&fSpirit Beast&8 — Awakening evolution&r"
