	file.0000000000000001.title: "You Like Food?"
	quest.00368B9D8D0AA41C.quest_desc: [
		"The goal is to make a perfect version of every sushi you can make in this mod!"
		"がんばろう!"
		""
		"&lSpecial Thanks to Lucius the Dragon for making the Quest Chapter&r"
	]
	quest.00368B9D8D0AA41C.title: "Questline Info!"
	quest.006F104FBAD475C1.quest_desc: [
		"This is the Infusion Crystal, this is the beginning crystal to all Mystical Agriculture recipes."
		""
		"Until you can make the Master Infusion Crystal this will be your friend for all Mystical Agriculture adventures."
		""
		"This is used to rank up the inferium essence into better ones so you can make the higher tier crops."
	]
	quest.00725DD56665EBBB.title: "Iron Knife"
	quest.00A2C18028AC2FEF.quest_desc: [
		"This is the &8Dungeon Stove&r and &aMonster Pot&r, two special blocks from the Dungeon's Delight mod."
		""
		"The &aMonster Pot&r is what allows you to create the different foods from Dungeon's Delight mod."
		""
		"But the &aMonster Pot&r needs a special type of Heat Source to use. Which is the &8Dungeon Stove&r. It can also be heated by Monster Spawners or Trial Spawners but the Dungeon Stove is the easiest."
		""
		"No other Stove or Heat Source will allow you to use the Monster Pot."
	]
	quest.00C72FEB874BB3BE.quest_desc: ["I swear this will be your &5Dream Kitchen&r, It really will be. "]
	quest.00C72FEB874BB3BE.quest_subtitle: "KITCHEN POWERR!!!!"
	quest.00C72FEB874BB3BE.title: "Your Dream Kitchen"
	quest.01BF46C7CA80B799.quest_desc: ["With blaze heater in hand, right click either a blaze or a blaze spawner to fill it."]
	quest.01CC339DD832A044.quest_desc: ["Cable is what connects everything together into one giant storage system. The most basic material, Quartz Enriched Copper, is used to craft these cables along with some other ingredients. "]
	quest.01CC339DD832A044.title: "CABLES!"
	quest.02E38530F841100D.quest_desc: [
		"Prudentium Essence also known as tier 2 essence. Used to craft Tier 2 seeds."
		""
		"All quests above this one are Tier 2 seeds that require Prudentium Essence."
	]
	quest.02E7312A32825D55.quest_desc: ["Once you have some basic ingredients, you can use this to make sushi!"]
	quest.032479E20F617615.quest_desc: ["To use the wireless grid you first need to charge it. Once it is charged you need to shift-right click it on the Controller and now it is connected to your system."]
	quest.0331D78D12670FF8.quest_desc: [
		"Essential Items used for the making of the better Crafting Tables. "
		""
		"To make the Catalysts you need the same type of components to be able to make them."
	]
	quest.04134A85CA8E5D96.quest_desc: ["Without this eye, the Evoker has no power"]
	quest.04139F75A6457D93.quest_desc: [
		"Arcane Essence is the most basic material you will need to craft a lot of items in Iron's Spells and Spellbooks. "
		""
		"This materials is used to craft Arcane Ingots and Arcane Cloths. "
		""
		"Arcane Cloths are essential materials used in the crafting of Mage Armors. "
		""
		"Arcane Essence is also used for other items like a compass or the Alchemist Cauldron. "
		""
		"Some metals also require the use of this material to be crafted. ]"
		""
		"Arcane Essence can be either obtained by killing monsters from Iron's Spells or finding it in Structures. "
	]
	quest.04601608E12D7E8D.quest_desc: [
		"These are the Packager blocks. The packager can be used to package items into a cardboard box with a redstone pulse. "
		""
		"You can then send the cardboard box to another packager and it will then un-package whatever items were inside into a connected inventory. "
		""
		"The Re-packager allows you to combine multiple cardboard boxes into one singular cardboard box, so you don't have multiple going to the same place at one time. "
	]
	quest.04601608E12D7E8D.title: "Packagers"
	quest.04A7FA52110CFC84.quest_desc: [
		"Magic beans can be found in the Troll Caves, in these Troll Caves are vaults, in the smaller versions of these vaults, magic beans can be found inside. "
		""
		"They can also drop from the Thorn Leaves surrounding the Final Castle. "
		""
		"Magic beans are required to get to the Island in the sky. Just plant the magic beans on the ground, underneath the island, and climb your way up. "
	]
	quest.04E6ECAD48C4F707.quest_desc: ["Gotta use a smoker for this one!"]
	quest.059698CD94247185.quest_desc: ["Made in the fermentation barrel with soy beans and water."]
	quest.05AF88DA30591959.quest_desc: ["This is the &lBrain&r of your entire Refined Storage System. You need this for your system to even work. "]
	quest.0609B91E45E78A54.quest_desc: [
		"Made using Flux Crafting, it is a key ingredient in the making of Enhanced Redstone Ingots. "
		""
		"To make this you need 4 Redstone Ingots and 1 Nether Star. "
	]
	quest.06B0F1B32C2F48EE.quest_desc: [
		"What the hell is a Rat Burger?"
		""
		"And why is this a thing?"
	]
	quest.0721E4660649D031.quest_desc: ["The knight phantoms can also be found in Underground Mazes but will be found in a different biome to where the Minoshroom maze is. "]
	quest.0788AC3B0FE17FE7.quest_desc: [
		"When lowered down, the pulley will extract fluids from where it ends up."
		""
		"(A large enough lava source (like in the Nether) is effectively infinite)"
	]
	quest.078EE371EAA70342.quest_desc: [
		"Who doesn't like a good Kangaroo Shank..."
		""
		"Not me"
	]
	quest.07D0C75AE6037241.quest_desc: [
		"Extended Crafting as it says Extends Crafting."
		"Extended Crafting adds four new tiers to the Crafting Table. "
		""
		"Basic"
		"Advanced"
		"Elite"
		"Ultimate"
		""
		"Basic being the size of a regular crafting table and all the way up to Ultimate Tier, a 9x9 crafting table. "
	]
	quest.0934D45E98C90971.quest_desc: ["Is onigiri sushi? Debate in the comments below"]
	quest.0934D45E98C90971.quest_subtitle: "Get it? Since it has an 'o' at the front?"
	quest.0954775C323A4430.quest_desc: ["Ruined Books are only found in the Deep Dark and are needed to craft any late-game Spell Books"]
	quest.0A27B83E5D8DF0DB.quest_desc: ["When it receives a signal, it sends the signal for a configurable length of time after a short delay."]
	quest.0AB7747D213A53DF.quest_desc: ["Carminite can be obtained after beating the Ur-Ghast"]
	quest.0B488CCA259A8FCD.quest_desc: ["Used to import items from your chests or anything storage related container into your refined storage system."]
	quest.0B5C4CC451024FBC.quest_desc: ["Ancient Eyes Scattered Across the World, Can You Find Them All?"]
	quest.0B5C4CC451024FBC.title: "The Lost Ancient Eyes"
	quest.0B8D0169517AB27C.quest_desc: ["Schematics are a way to save structures as .nbt files which can be used to then rebuild that structure in the world!"]
	quest.0BD85EB329961FF5.quest_desc: ["Works similarly to the vanilla repeater, but with a more highly configurable delay. It can delay the pulse it sends for as long as an hour!"]
	quest.0BF1A467C886E186.quest_desc: [
		"This is worse than the Moldy Bread!"
		""
		"Why would you eat this!?!?!?!??!"
	]
	quest.0C3EF92CF10F80B6.title: "End Gobber Armor"
	quest.0C545146FDCC83C7.quest_desc: ["Killing Endermite will reward you with Endermite meat which is a \"good\" food source. "]
	quest.0C6AF39695F5795B.quest_desc: [
		"This is the Improved Processor which is used to make some of the more advanced machines. They are also used for the more higher storage space disks."
		""
		"An important thing that Improved processors can craft is the Grid which is Essential for viewing your depositing and extracting your items from your storage system."
		""
		"To craft the Improved Processor you need to make its Raw Form and smelt it in a furnace. "
	]
	quest.0CC35861B639ADDE.quest_desc: ["Use the cleaver on the cutting board to cut up some fish and some fruit."]
	quest.0CC35861B639ADDE.title: "Chop Chop: Sushi Edition"
	quest.0CDE8E8F7AAD3CB1.quest_desc: ["Simple but effective."]
	quest.0CDE8E8F7AAD3CB1.quest_subtitle: "Dumplings' little brother"
	quest.0CE92B63D845BEE7.quest_desc: ["Item Vaults form multiblocks that store lots of blocks. However, you can't access items by hand, and must use contraptions for item input and output."]
	quest.0D1F37433A48BE2C.quest_desc: ["Can be used to configure the cables by switching the directions of cables or cutting one off so they intersect with each other."]
	quest.0D2DED2C87CD61D7.quest_desc: ["Use to learn one spell belonging to the &2Eldritch&r Spell Group"]
	quest.0DBFCC83E2CF4BDE.quest_desc: [
		"This allows NPCs to be conductors of trains."
		""
		"Any mob or blaze burner sitting in front of Train Controls is eligible to be a conductor by being right clicked by a configured schedule."
	]
	quest.0DC8D70EA05A7C08.quest_desc: [
		"Hammers are used to break shells if you have a turtle corpse. "
		""
		"Get a turtle corpse. Drain it of it's blood."
		""
		"Place drained Turtle Corpse on the Butcher's Table and right-click it with your hammer a lot till it says you need a Butcher's Knife to continue. "
	]
	quest.0DC8D70EA05A7C08.title: "Butcher's Hammer"
	quest.0DEC8687251D7855.quest_desc: [
		"Crafting Core are essential for Combination Crafting. But as of right now there is only one recipe for this type of crafting. "
		""
		"For combination crafting to work you need pedestals surrounding the Crafting Core"
		"           X               X"
		"    X                              X"
		"                    O"
		"    X                              X"
		"           X               X"
		""
		"Looks something like that. The Core is in the middle and the pedestals are two blocks out from it."
	]
	quest.0E6462AF0B4A15CB.quest_desc: [
		"Chain conveyors can be used to relay rotational force between other chain conveyors. Only one of them needs to be powered."
		""
		"Just need to to right-click a chain between two conveyors."
		"You can also ride the chain conveyors if you right-click with a wrench."
	]
	quest.0EE587F80C88EA75.quest_desc: ["put the dragon egg on a cutting board and right click with a nether star to get the special soup"]
	quest.0F687F5695C0EB6A.quest_desc: ["Made using the cutting board and cleaver."]
	quest.0F9F2795BB196A27.quest_desc: ["Mechanical Pistons have similar function to their vanilla counterparts. However, along with RF, they also need Piston Extension Poles to function. The more poles, the farther they can go."]
	quest.0FFC10FF583424A3.quest_desc: ["Chimken"]
	quest.106796AA8879A4CE.quest_desc: [
		"This is a Cutting Board from the Cutting Delight mod. "
		""
		"Its a Cutting Board that allows you to choose different options when cutting something, just in case something has a conflicting recipe. And allows you to choose which option you want."
	]
	quest.10F61EE371130949.quest_desc: ["Can be found sometimes in Iron's Spells and Spellbooks structures. "]
	quest.11CC1DE03112B42A.quest_desc: ["Those who followed this eye were never seen again; rumors say they found the great city of Atlantis, or lost their way trying"]
	quest.11E06E32F917DED0.quest_desc: [
		"Step 1: Dig a hole, 3-4 blocks should be good."
		"Step 2: Place the Jar at the bottom of the hole"
		"Step 3: Lure a cow into the Hole"
		"Step 4: Drop an Anvil on the cow....."
		"Step 5: You Did It!"
	]
	quest.11E06E32F917DED0.quest_subtitle: "Step by Step Process on how to get a Cow in a Jar"
	quest.127A1764323FD2DD.quest_desc: [
		"You did it! you made all of the noods!"
		"(from Farmer's Delight and co, that is...)"
	]
	quest.131C0A42CA1A0A8A.quest_desc: ["Also like the regular Grid but used to make patterns which are essential for auto-crafting. "]
	quest.1365AF6BAD3DB886.quest_desc: ["Made using the cutting board and cleaver."]
	quest.136BB11F77AD63FA.quest_desc: ["Used in the Scroll Forge to make Uncommon Spells."]
	quest.14239DB607929F1E.quest_desc: [
		"A special ingot only possible to be made inside of the Tier 3 crafting table or above."
		""
		""
		"Check JEI for the recipe."
	]
	quest.146AFB8870A7B6B9.quest_desc: [
		"Used to make Ice Upgrade Orbs that increase the damage of Ice Type Spells when on armor."
		""
		"They are also used to make Cyromancer Armor that has the same effect of the Upgrade Orb."
	]
	quest.14C6149E94B15A79.quest_desc: ["Holds pressurized air. Some equipment requires it to function. Other equipment may use pressurized air instead of using durability."]
	quest.15790B94139DFB25.quest_desc: ["The next boss you will be able to defeat. Can be found in large floating towers. The Twilight Lich can be found at the top of the tower."]
	quest.157FC5B3DA1DEB49.title: "Tuna"
	quest.159CD5F2114FC261.quest_subtitle: "Train Era?"
	quest.159CF68F9D1E2D77.quest_desc: ["Shrimp and tuna can be found in the ocean."]
	quest.159CF68F9D1E2D77.title: "Sushi Animal Products Quests"
	quest.1647157D4AB10082.quest_desc: ["Chop one food drop to get multiple smaller portions. This is a net positive I promise."]
	quest.1647157D4AB10082.title: "Chop Chop!"
	quest.16E2CCFAD240F4AB.quest_desc: ["The basis of rotating contraptions."]
	quest.17D3FAB9B7A89CDA.quest_desc: ["An important crafting ingredient."]
	quest.17E365E32D9DAA5D.quest_desc: [
		"You may have noticed, or not since you might be reading this first before doing anything."
		""
		"That Fishing now has a minigame!"
		""
		"With the help of the Stardew Fishing mod, it integrates the fishing mechanic from Stardew Valley."
		""
		"You want to keep the green bar surrounding the fish in the minigame by using left-click. Its better to click rather than to hold since you'll make the bar go way over the fish."
		""
		"Because of this the minigame is a bit difficult to get the hang of and it only gets worse depending on what fish it is since all the fish have different difficulties to them."
		""
		"This should work for all Fishing Rods in the game, including modded ones. "
		""
		"{image:stardew_fishing:textures/gui/minigame_backgrounds/minecraft/overworld.png width:150 height:150 align:center}"
	]
	quest.17F87C09BBB7B704.quest_desc: ["ITS A HAND"]
	quest.1847923668FEDF55.quest_desc: ["Prosperity Gemstones are used as a base material to craft the higher tier Essence Gemstones like Inferium or Imperium Gemstones."]
	quest.18550941F4C75E6C.quest_desc: ["Helpful storage block for sushi ingredients. It consolidates similar items."]
	quest.18E652DDC23E05C7.quest_desc: ["Can be crafted used Hogskin and Arcane Cloth"]
	quest.191F65CD6FF8BCE0.quest_desc: [
		"Radial Chassis connect to each other along the same axis."
		""
		"Connected to a Mechanical Bearing, they all rotate together with any attached structures."
	]
	quest.1943102BEC4DE734.quest_desc: ["Used to make soy sauce and cheese."]
	quest.195D1D8964CCBE2B.title: "Nether Gobber Tools"
	quest.1967302B71471936.title: "ALL THE CALIFORNIA ROLLS!!!!"
	quest.196C70397ED8BD1B.quest_desc: [
		"Essential items used for making the Crafting Tables along side other items inside of Extended Crafting."
		""
		"Key ingredients for the making of Catalysts."
	]
	quest.1A40A1A390E8B611.quest_desc: [
		"Before we can start Butchering the corpse, we need to drain the blood. We need a blood drain to collect all the blood."
		""
		"Just place the Blood Drain underneath where you placed the Hook and Chain."
		""
		"Now you'll need to hang your corpse, so just right-click the corpse onto the Hook and Chain."
		""
		"To drain the corpse of it's blood, just right-click it with your Butcher's Knife or any other tool like a sword. Blood will slowly start to drain from it."
		""
		"The blood will be collected in the Blood Drain, and you'll know its working when you see the Blood Drain filling up. "
		""
		"The blood draining will be done once you see your corpse turn a paler color or you see that the blood drain is no longer filling up."
	]
	quest.1A82254533CD9687.quest_desc: ["Rotates just like the Mechanical Bearing, except it does so according to the in game time of day."]
	quest.1B5F6CFC6394E478.quest_desc: [
		"Good Luck, Have Fun! "
		""
		"&oYou'll need it!&r"
	]
	quest.1BB37E4F53613731.quest_desc: [
		"Ew.... Moldy bread"
		""
		"Who would eat this stuff?"
	]
	quest.1BCEF2DF1AE89680.quest_desc: [
		"Used to make Holy Upgrade Orbs that increase the power of Holy Type Spells. This can be either damage or healing type factors. Since Holy spells are used for Healing and Damage."
		""
		"They are also used in the making of Priest Armor that has the same effect of the Upgrade Orbs"
		"with additional effects."
	]
	quest.1C58C4240DB9001A.quest_desc: ["A more advanced method of rotational force generation. The engine must be attached to a 4-block (at minimum) fluid tank with a steady source of water. A heat source (e.g.: campfires) is required as well. Use ponder for more information."]
	quest.1CAA199407E81C27.quest_desc: ["This eye is believed to have given our ancestors the knowledge of Redstone"]
	quest.1CE859864360C49E.quest_desc: [
		"Welcome to the Relics/Artifacts quest chapter!"
		""
		"This will have every single Artifact and Relic that you can collect in the world."
		"Have fun collecting them all!"
		""
		"&oP.S There are Relics for Twilight Forest and Ars Nouveau&r"
	]
	quest.1CFE9711FDC73A55.quest_desc: ["Nifty for keeping items in position."]
	quest.1D1B87C8D99555F4.title: "Nether Gobber Armor"
	quest.1D4BD6E9BACED908.quest_desc: [
		"Not your typical soda you would drink."
		""
		"It's got a hint of dragon's breath in it."
	]
	quest.1DA0E8D02404A870.quest_desc: [
		"Silicon is another basic material use to make another large portion of the machines here. "
		""
		"You'll need a lot of silicon as well as Quartz Enriched Iron so better get crafting and smelting"
		""
		"To get silicon all you need to do is just smelt some quartz inside of a furnace and BOOM! There you go, you got yourself some silicon."
	]
	quest.1DA0E8D02404A870.quest_subtitle: "Silicon"
	quest.1DA0E8D02404A870.title: "The making of a new material!"
	quest.1DA503D1C483B539.quest_desc: ["Connects and disconnects from contraptions depending on the redstone signal."]
	quest.1DDC3AB2C9BBBC35.quest_desc: ["made by cutting dragon meat on a cutting board"]
	quest.1E171EEDA7E7EE0E.quest_desc: [
		"Can have a filter for observation of specific blocks/items."
		""
		"They can send a pulse upon appearance of items on a conveyor belt, a filter block being placed in front of it, or the presence of a filter item in observed storage."
	]
	quest.1E4D9FE639C44A6D.quest_desc: ["Pulp is used to make cardboard, but not the cardboard used for packages."]
	quest.1F7AD398F9EE5D3E.quest_desc: [
		"Hogskin as the name implies can only be dropped by Hoglins in the Nether."
		""
		"Hogskin is an essential material required to craft the Rare and Epic Spell Books."
		""
		"These spell books are the &e&lEnchanted Spell Book&r&r and the &e&lApprentice's Spell Book&r&r."
	]
	quest.1FC8C0096ED3A918.quest_desc: [
		"Not useful as it is now. Place it in the world and wait for it to become rich soil."
		"Check JEI for tips on how to speed up the process!"
	]
	quest.1FD9BFE1BFA3940F.quest_desc: ["The minoshroom can be found in underground mazes. "]
	quest.2046F40C85C22F87.quest_desc: ["The exporter is used to export items out of your refined storage system into another storage container like a chest"]
	quest.20CCE8A6BE88FE65.quest_desc: ["Like a funnel but you can directly deposit your items in your hand by right-clicking the item hatch that is connected to an inventory."]
	quest.214DBD6958B0251D.quest_desc: [
		"The eye of a greedy king that faded in solitude; legend says it will bring infinite fortune to its owner"
		""
		"No one knows what lies in his fortune, all we can say its home to all the rare metals in the world"
	]
	quest.215E902FB7D6979F.quest_desc: ["Brass is an alloy of zinc and copper, and producing it requires heat. A blaze heater under the basin should do."]
	quest.215E902FB7D6979F.title: "Brass Ingot"
	quest.2215031FB89774C4.quest_desc: [
		"The encased fan does various useful things depending on which fluid is in front of it."
		"Ponder the encased fan for more detailed information."
	]
	quest.223C85E82D8A2833.quest_desc: [
		"&oFood...&r There is a lot of it in this pack. There is exactly &63163&r different foods to eat."
		""
		"Anyways there's a lot of it, that's all you need to know. To get some of that food. You may need to try harder to get it than other foods. "
		""
		"A lot of the foods have special crafting recipes especially farmer's delight which requires a cooking pot for most recipes. "
		""
		"Every 5 foods you eat, increases later on, You gain 2 hearts. "
		""
		"&lAs I am writing this you can gain 204 &4hearts&r!&r "
	]
	quest.223C85E82D8A2833.quest_subtitle: "About the Food"
	quest.22C00E131A341C73.quest_desc: ["One of the last artifacts left behind by the Iceologers before they all suddenly vanished from the world"]
	quest.22FE605044279867.quest_desc: [
		"Used to make Ender Upgrade Orbs that increase the damage of Ender Type Spells when used on armor."
		""
		"Also used to make the Shadow-Walker Armor that has the same effect as the Upgrade Orb."
	]
	quest.23174BA508047188.quest_desc: ["A step up from andesite casing."]
	quest.23174BA508047188.title: "Brass Casing (Brass Age)"
	quest.233F9F34C3313A72.quest_desc: [
		"Hello and welcome to Challenges!"
		""
		"All quests here are little challenges you can complete to get some good rewards. Some are easy, some are hard."
		""
		"Good Luck!"
	]
	quest.233F9F34C3313A72.title: "Challenges"
	quest.23D158BD9F927A2C.quest_desc: ["The item drain provides a way to input fluid into a Create setup with things like buckets, which you normally can't do."]
	quest.23D1B6DA4CCC4C0A.title: "Basic Item Movement/Placement"
	quest.23FC0DF4AE405585.quest_desc: ["Minecraft Cooking: Dough doesn't need egg or water if made in a pot."]
	quest.241BC099E2DED70F.quest_desc: ["Usually along side the Construction Core for Recipes but also used for the Recipe of Destructors. Which break blocks in front of them and directly send it into the system. "]
	quest.245570E10297D666.quest_desc: ["Rememberance of the past lives of those who live in death"]
	quest.2476D3CED8BD3452.quest_desc: [
		"Here we have Refined Storage. A storage mod where you can store all your items digitally in one block (kind of)."
		""
		"There is more than one block that you need to store your items but the block you put the items in is only one block. Get it?"
	]
	quest.2476D3CED8BD3452.quest_subtitle: "Chests no more"
	quest.24CBB90DDAE3E5C6.quest_desc: ["Enables access to and transfer of items to and from moving contraptions."]
	quest.24E8F14E9A8D7BCA.quest_desc: ["These are needed for a LOT of stuff in create. Prepare to make many more of these than this quest calls for."]
	quest.24E8F14E9A8D7BCA.title: "Andesite Casing (Andesite Age)"
	quest.2522FBDF0D58A3B2.quest_desc: ["The recipe makes not one but TWO dumplings! Lucius is a fan of these in the early game."]
	quest.2522FBDF0D58A3B2.quest_subtitle: "my beloved"
	quest.2522FBDF0D58A3B2.title: "Dumplings"
	quest.25AFC8F2DF9AFF94.quest_desc: ["Works the same way as brown mushroom colonies."]
	quest.25B21419F1C49F55.quest_desc: [
		"This mod has quite a bit going on, so the guide book is your friend."
		"Don't worry about losing it—this quest is repeatable! :)"
	]
	quest.25B21419F1C49F55.title: "Get a book!"
	quest.25C1FF65CCA62A23.quest_desc: ["Use a knife to kill a pig for a chance to get ham."]
	quest.25F133AD9EFE79A1.quest_desc: ["Pirates say it gave sight to the legendary Black pearl"]
	quest.261EEEFEDF5A8850.quest_desc: [
		"Protective Runes are used for Protection Upgrade Orbs."
		""
		"Protection Upgrade Orbs give Spell Resistance to the player whenever the Orb is used on armor."
	]
	quest.2645CFEB76DAF316.quest_desc: [
		"A basic material required to craft Black Iron Slates. Which are also an essential material required for crafting components."
		""
		"Black Iron is also an essential material required for crafting catalysts which are used to craft the tables themselves."
	]
	quest.26550EA178499F5C.quest_desc: [
		"One of three cutting boards. Make sure your kitchen has room for all of them!"
		"Hold items you're chopping in the off-hand to make your life easier."
	]
	quest.26C96D69B242A6AD.quest_desc: ["Dog Food?"]
	quest.26E0B3FCCC1D9F23.quest_desc: [
		"An Arcane anvil is used to combine magical items together. "
		""
		"With the Arcane anvil you can upgrade your spells, making it do more damage and other stuff."
		""
		"You can also upgrade your School's Armor with Upgrade Orbs. This also applies to Spellbooks as well using Upgrade Orbs to upgrade them to another level. "
		""
		"The last thing you can do with an Arcane Anvil is imbue weapons with spells. This only applies to swords though. For a imbuement you need a scroll with the type of spell you want to imbue. Keep in mind once you imbue it, the scroll disappears. Imbuements can be removed though with something called a Shriving Stone. "
		""
		"You can also imbue more than one spell but when imbuing something it is one at a time. "
	]
	quest.27C9A949196AACF3.quest_desc: ["This pupil is believed to have seen the ancient brewing recipes that were lost in time. "]
	quest.27E8F8D991EA68F1.quest_desc: ["A special type of infusion crafting that is called Awakening. It awakens the dormant powers of the Supremium Essence block to make Awakened Supremium. "]
	quest.27E8F8D991EA68F1.title: "Awakening"
	quest.281975344E715A2B.quest_desc: [
		"To get Nori Sheets, you need an iron block, a dried kelp block, and a piston. To get Nori Sheets you need to squish a dried kelp block onto a iron block. "
		""
		""
		"Just drop the Dried Kelp Block on a Iron Block and squish it with a piston. In return you should get Nori Sheets."
	]
	quest.2819EC82756B38C6.quest_desc: ["Made using the cutting board and cleaver."]
	quest.2828375B25EAC36C.quest_desc: [
		"Skin can be obtained by skinning a corpse. To skin the corpse, it needs to be a non-drained corpse. A fresh one if you will. "
		""
		"To skin a corpse, the setup is exactly the same as draining the blood. Needs to be placed on a Hook and Chain over a Blood Drain. Since as soon as you skin the corpse, blood with start to drain. "
		""
		"To skin the corpse, just right-click it with a skinning knife."
		""
		"Note: You will get a skinned Corpse but there isn't anything you can do with it, you can butcher it but it will get next to nothing. Not all Corpses need to be skinned."
	]
	quest.2828375B25EAC36C.title: "Animal Skin"
	quest.282C1E8AF916E8C8.quest_desc: ["Can be crafted using Hogskin and Arcane Essence."]
	quest.28371A0CAF8C5832.quest_desc: ["Works just like Stock Tickers but can order items from Stock Links of whatever the item is, with a redstone pulse."]
	quest.2874D100C5F82121.quest_desc: ["The most mechanical crafters you'll need for a single recipe is 25."]
	quest.287F1518369ACB53.quest_desc: ["Transports liquids. They require mechanical pumps to actually work."]
	quest.28C4151DFB9398BC.quest_desc: [
		"Not needed, but helpful."
		"Wasabi is spicy. In fact, it's so spicy that eating it makes lava feel lukewarm in comparison!  "
		"(Sushi with wasabi grants fire resistance)"
	]
	quest.2939C31ADAAE3ADA.quest_desc: ["These bad boys can double to triple your ore output. "]
	quest.2939C31ADAAE3ADA.quest_subtitle: "grindy wheel go brrr"
	quest.2A9251E6E3DF0837.quest_desc: [
		"These are the materials you need to craft each specific spell class scroll. Keep in mind each Scroll needs paper and a Ink. Doesn't matter what Ink it is, You need Ink to craft Scrolls. "
		""
		"&l&eDivine Pearl&r&r - Holy Spells"
		"&l&5Ender Pearl&r&r - Ender Spells"
		"&l&4Blood Vial&r&r - Blood Spells"
		"&l&2Emerald&r&r - Evocation Spells"
		"&l&1Echo Shard&r&r - Void Spells (Only &nLegendary Ink&r)"
		"&l&6Blaze Rod&r&r - Fire Spells"
		"&l&aPoisonous Potato&r&r - Poison Spells"
		"&l&bFrozen Bone&r&r - Ice Spells"
		"&l&3Lightning Bottle&r&r - Lightning Spells"
		""
		"Not all spell classes have all the rarities to them some don't rare spells."
	]
	quest.2AC721CD807495EC.quest_desc: [
		"These can be placed in bulk over slopes, around curves, and even into the Nether!"
		"If you have blocks in your offhand, those can bridge air gaps where you want to place tracks."
	]
	quest.2AD044C54F92E351.quest_desc: [
		"A different type of Cooking Pot from an addon mod."
		""
		"The Fiery Cooking Pot heats itself so you no longer need an oven or campfire underneath it. "
		""
		"It allows you to cook Twilight Forest Meals from Twilight Flavors and Delight much faster than in a normal Cooking Pot"
	]
	quest.2B3BFA072A70863F.quest_desc: ["The most common ink. Used in the Scroll Forge to make Common Spells."]
	quest.2B6ACC3E8C0C383A.quest_desc: ["Used for Train related things"]
	quest.2B984C483C72F213.quest_desc: ["These can form a single larger tank when placed in a recctangular formation."]
	quest.2BC34C6FB2F2B8F2.quest_desc: ["A material added by Refined Storage that is used to make cables and nothing else. "]
	quest.2CC511BF44C0E31A.quest_desc: ["Gives access to more configurations for Redstone Links."]
	quest.2D5A94B239E18A38.quest_desc: [
		"Now there are two options to butchering."
		""
		"&lA:&r You can either butcher it on the hook and chain after it's done draining "
		""
		"OR"
		""
		"&lB:&r You can shift right-click the corpse on the chain to collect it and butcher it on the Butcher's Table. You just need to place the corpse on the Table."
		""
		"To do either of those and to gather the meats, you just need to right-click the corpse with a butcher's knife until there is nothing left. "
		""
		"From my understanding there are different drops depending on which way you decide to butcher the corpse."
		""
		"&oP.S There are other Butcher's Tables like Wooden ones but for the quest we will simply use the metal one.&r"
	]
	quest.2DE806584D68B4BB.quest_desc: [
		"Supremium Essence is used to craft the Supremium Armor set as well craft the Tier 5 Seeds."
		""
		"All quests below are Tier 5 Seeds that can be crafted. "
	]
	quest.2E166E0F0733023F.quest_desc: [
		"Can be used to make Fire Essence which in turn can make a variety of things revolving around heat. "
		""
		"Later on it can be used to make Awakened Supremium, and the tools and armor."
	]
	quest.2E49CF6BADD79A60.quest_desc: ["It's just a block of cardboard. "]
	quest.2EA9050A5C2D4D1A.quest_desc: ["Can be crafted using normal paper and leather, but you need chains."]
	quest.2EB9AC04FE777FA0.quest_desc: ["Enables wireless transfer of redstone signals!"]
	quest.2F4E61F536050B18.quest_desc: ["Needed for many other basic machines."]
	quest.2F4E61F536050B18.title: "Iron Sheet (Basic Machines)"
	quest.2FAB0C78AC0A833A.quest_desc: [
		"Frogports can be used directly with Chain Conveyors and are used to deliver packages to other Frogports."
		""
		"You can assign more than one Frogport for a Chain Network. You can also assign addresses to each Frogport so the packages will arrive to that Frogport via the Chain Network."
		""
		"For a more in-depth explanation, please use the Ponder feature. It shows each use for the Frogports. "
	]
	quest.30387B01F4882D27.quest_desc: ["Used to make some the higher Storage Blocks. Storage Blocks are just another way for storage to be used. An alternative for using Storage Disks. "]
	quest.30EEF5763447087D.quest_desc: ["Legends say this eye once belonged to one of the great Sandworms"]
	quest.310389DF9EDCFC6B.quest_desc: ["Lots of recipes use cooked rice."]
	quest.31124DF2509018AB.quest_desc: ["Slower than its smaller counterpart, but with higher stress capacity."]
	quest.3138016BA847D3C9.quest_desc: [
		"Welcome to Mystical Agriculture!"
		""
		"A magic-themed crop mod used to make resources. Mystical Agriculture has been heavily blocked by progression in Ad Astra and other mods. "
	]
	quest.318DA2F5F84772DA.quest_desc: [
		"Hello,"
		""
		"As the Chapter says you need to"
		"&4&lKILL&r&r"
		"Different Monsters or Animals"
		"&lWhy?&r"
		"&oBecause I have no idea what else to make at this point&r"
		""
		"Anyways you will see a variety of quests in here asking you to kill different animals or monsters"
		"Each quest gives you a reward and they are repeatable so you can do those quests as many times as you want."
		""
		"&oI will make you kill 1000 axolotls&r"
	]
	quest.31CBB55120A01FB8.quest_desc: ["INFINITE FLUID STORAGE WOOOOOOO"]
	quest.31EEE126FF57C78E.quest_desc: [
		"Blank Runestones are used to make Runestones of course. "
		""
		"There are many different types of runestones like &6Fire&r, &bIce&r, &aNature&r, &5Ender&r, and &4Blood&r."
		""
		"Some Runes are used to make &nUpgrade Orbs&r meant for armor."
		""
		"Others are even used for the crafting of Armor."
		""
		"Runestones can either be found in structures across the world or by killing the &4&lDead King&r&r."
	]
	quest.31F8921034303977.quest_desc: ["Used to make the End Gobber Armor."]
	quest.31FFF574A36BF628.quest_desc: [
		"Used to connect external storages to your Refined Storage System. You can take items out of that storage might it might not get put back into that storage. "
		""
		"Can work well with Limited Barrels which act Storage Drawers. Also works great with Crates from Quark. "
	]
	quest.3215428B19B946FC.quest_desc: [
		"Used in the making of Blood Upgrade Orbs that increase the damage of Blood Type Spells."
		""
		"They are used to make Cultist Armor, which also increases the damage of Blood Type Spells."
	]
	quest.326D107819C5AB88.quest_desc: ["Here's a guide on how to use the Butchery Mod. A horrifying-ling great mod all about butchering animal corpses. "]
	quest.32E338F548160A28.quest_desc: ["It was lost by a demon in the battle between the Aether and the Nether"]
	quest.333B8D931E90D640.quest_desc: [
		"Fish drop tobiko (fish eggs, or roe) when killed."
		"Fun fact: Tobiko is actually one of several types of roe. More specifically, tobiko comes from flying fish! So this item should probably just be called roe instead. Oh well."
	]
	quest.334C2ACC4EA20C37.quest_desc: ["A Basic Material used for crafting most components inside of Extended Crafting."]
	quest.335C6E6DE7E2DE5E.quest_desc: [
		"All Spellbooks on the right are craftable spellbooks that can be either found or crafted. "
		""
		"They go in order as well"
	]
	quest.336ACD9A4075A938.quest_desc: ["Funnels move items to and from inventories."]
	quest.33C43D6289CD32A2.quest_desc: [
		"Not needed, but helpful."
		"Used to make soy sauce, which increases sushi effect levels by 1."
	]
	quest.33EE0A357990C7BF.quest_desc: ["Essential for creating multiblock contraptions."]
	quest.340E50F2971A0A62.quest_desc: ["Cores are used to craft a variety of machines and grids inside of Refined Storage."]
	quest.34FC0E731F8BAF6C.quest_desc: ["Here are some of the most basic resources you will need to get started. There are also materials that are used for late game crafting of &nSpellbooks.&r"]
	quest.3507461A7DF3725E.quest_desc: ["Made in the fermentation barrel with milk."]
	quest.35A2A231DACFF06D.quest_desc: ["Fills items below it with liquid."]
	quest.35EF0B3C63E23A1D.quest_desc: [
		"&oThis isnt hard right?&r"
		"Well unless you don't have a soul"
		""
		"You can find them in Jungles"
	]
	quest.35EF0B3C63E23A1D.quest_subtitle: "KILL"
	quest.35FF69A8B1D3D4EC.quest_desc: ["Required for your train to, well, be a train."]
	quest.364B6E0708A690D7.quest_desc: [
		"Used in the making of Evocation Upgrade Orbs. These orbs when put on armor can increase the damage of Evocation Type Spells."
		""
		"These Runes are also used in the making of the Archevoker Armor, which also increases the damage of Evocation Type Spells. "
	]
	quest.370253E36B4CFFF7.quest_desc: [
		"Quantum Compressors are the key block for making singularies. "
		"Those this machine does require power so make sure you have an ample power source to power this while its doing it's job"
	]
	quest.372AFA82451FE1A1.quest_desc: [
		"Now you can butcher boss corpses with the Butchery mod, but there's a slight problem..."
		""
		"Boss Corpses cannot be moved from where they lay and must be butchered on-site."
		""
		"So get your cleaver ready to butcher some Withers, Ender Dragons, and Wardens!"
	]
	quest.384F2FB711B8AC02.quest_desc: [
		"Analog Lever: Right click to increase its signal, and sneak right click to decrease it."
		""
		"Powered Latch: Signal from behind turns it on, signal from the side turns it off."
		""
		"Powered Toggle Latch: Alternates between on and off with every redstone signal."
	]
	quest.384F2FB711B8AC02.title: "Create Levers"
	quest.3870A66F81CEE0D0.quest_desc: ["Use an axe to strip logs on the cutting board for tree bark."]
	quest.393DB95230A16428.quest_desc: ["Fluid pipes, but you can apply filters to them. They will only allow the filter fluid to go through."]
	quest.394F7F54505A404B.quest_desc: [
		"If you have followed the directions, you should now have a drained corpse on your hook."
		""
		"To get the drained corpse, just shift right-click the corpse to obtain it. "
	]
	quest.394F7F54505A404B.title: "Drained Corpse"
	quest.39618F964DC0A09D.quest_desc: [
		"Can also be found in the middle of the Dark Forest in the Twilight Forest dimension. The tower the Ur-Ghast is in will be located in the middle of the Dark Forest, the Dark Forest will start to turn red once you reach the area."
		""
		"At the top of the tower is where the Ur-Ghast will be. "
	]
	quest.397229D31E0593D1.quest_desc: ["This is where you can view all of your ongoing autocrafts and where you can also cancel the autocrafts that are ongoing."]
	quest.397229D31E0593D1.title: "Autocrafting Monitor"
	quest.3B91100D8D56A2E6.quest_desc: ["To obtain the Ender Dragon Corpse you need to kill it with a Butcher's Knife or get the Butcher enchant on your weapon of choice. "]
	quest.3BECB55C415CDDE2.quest_desc: ["Books that are needed for quests"]
	quest.3CE38298004EF881.quest_desc: ["Can be used to make Air Essence which doesn't really make anything except for Awakened Supremium tools and Armor as well as the Essence itself."]
	quest.3CFF052B4AE39F9B.quest_desc: ["Blazes can't get enough of this cake! Feed this cake to heater-dwelling blazes, and they will become superheated."]
	quest.3CFF052B4AE39F9B.quest_subtitle: "then you'll have a cake!"
	quest.3CFF052B4AE39F9B.title: "If you do the cooking by the book,"
	quest.3D26AF425D91D276.quest_desc: ["Outputs a redstone signal if face-to-face with another Redstone Contact."]
	quest.3D33004FB9BCFBC5.quest_desc: [
		"Same as portable item interface, but for liquids."
		""
		"Enables transfer of fluids to and from moving contraptions."
	]
	quest.3D9BFA8AA96228DA.quest_desc: [
		"Welcome to the Iron Furnaces quest chapter"
		""
		"Here you can find all the different furnaces you can craft"
	]
	quest.3EFBDCD33CDE70F4.quest_desc: [
		"Used to craft some of the machines used like Grids."
		""
		"Recipe has been modified for a harder challenge to get into Refined Storage. "
	]
	quest.3F2F2843478964A7.quest_desc: [
		"This mod has support for Apotheosis, Curios, and Better Combat. "
		""
		"Spellbooks can have Apotheosis Affixs on them as well as other armors and weapons. "
		""
		"There is curios support for the many rings and necklaces avaliable in the mod. "
	]
	quest.3FAD08CE82F9F17B.quest_desc: ["The Nature Rune is used to make the Plagued Armor and used to make the Nature Upgrade Orbs."]
	quest.3FE633C09349A66E.quest_desc: [
		"So processor bindings are essential materials to make what are known as Processors. "
		""
		"Processors are another important material to make what are known as disks which help you have storage inside of your machine."
	]
	quest.3FE633C09349A66E.quest_subtitle: "Processor making"
	quest.400C9409D7E2CED5.title: "Gobber Armor"
	quest.40B1AE30DD8B547D.quest_desc: ["When placed on a Schematic Table, it loads a selected .nbt file."]
	quest.40E84E8AB8F52425.quest_desc: ["Great for growing crops. Also allows you to get mushroom colonies."]
	quest.414BE9E906648043.title: "Cheese California Rolls"
	quest.415E9ADF22F0EA43.quest_desc: ["Can be found in the large above ground cave structures, in the snowy biomes of the Twilight Forest. Be careful of the smaller yeti's that surround the Alpha Yeti."]
	quest.4188E255AA038922.quest_desc: [
		"The wrench is super useful. Trust me on this."
		""
		"Goggles show you the kinetic stress capacity and usage of blocks."
	]
	quest.4188E255AA038922.title: "Wrench and Goggles"
	quest.41C0CB9BFCDC3B36.quest_desc: [
		"Used to destroy blocks in front of them and then send that item into the system. Pairs great with the Constructor that places blocks in front of it. "
		""
		"Can really work well any automatic block making contraption like a Cobblestone generator. "
	]
	quest.41F075A52FA2ABE3.quest_desc: [
		"Arcane Cloths are essential material used for the making of many Armors in this mod. "
		""
		"This cloth is also used in the making of some late-game spellbooks that can be crafted. "
		""
		"Arcane Cloths can be crafted using Arcane Essence and any color of wool."
	]
	quest.4213E5A6B9B8B107.title: "Redstone Toggled"
	quest.423A6F7F020CE4DD.quest_desc: [
		"These are the various upgrades that can be used in your system. Mainly are to be used inside of the Importers, Exporters, Destructors, or Constructors."
		""
		"The names are pretty self-explanatory on what they do."
	]
	quest.42E9B3C8A1599F6C.quest_desc: [
		"The Alchemists Cauldron is a block that allows you to get Inks. You can also get potions from the Cauldron. "
		""
		"By putting scrolls into the Cauldron and few other requirements you can get the corresponding Ink based on the rank of your Scroll."
		""
		"By putting it in different flowers and glass bottles or awkward potions you can get various different potions depending on the flower you put in."
		""
		"To see the different recipes I suggest pressing U over the Alchemist Cauldron in JEI."
	]
	quest.432B54838C9A094E.quest_desc: [
		"Use in a smithing table to get remove a Spell Imbuement from your weapon."
		""
		"Once you remove it you will not get your spell back. "
	]
	quest.434AB89A5D2B00EC.quest_desc: [
		"With the Giant's Pickaxe, you will need to break into the Giant Obsidian Vault. The Giant Obsidian Vault can be found in those same Troll Caves. "
		""
		"Usually the Vault can be found right underneath the Sky Island/Cloud Cottage."
		""
		"Inside this vault will the Lamp of Cinders, this will help you burn your way through Thornlands to get to the Final Castle."
	]
	quest.43B86E28027CFEEC.quest_desc: ["This dust is dropped by killing the Wither or the Ender Dragon by having the Mystical Enlightenment enchant on your weapon. You must kill the boss with a essence weapon that has that enchant. Any other weapon will not work. "]
	quest.43DAD0EA9EE43F29.quest_desc: ["Similar to their andesite counterpart, but with more functionality. You can apply filters and specify how many items pass through at once."]
	quest.4412070D8C09664D.quest_desc: ["Lets you configure contraption behavior \"on the fly\"."]
	quest.4446BDD56D1D1343.quest_desc: ["Can only be obtained when defeating the Dead King. It does not drop all the time. "]
	quest.444BBC53C5C6811E.quest_desc: [
		"The Threshold Switch observes an inventory (of items or fluid). When the inventory exceeds the switch's threshold, it emits a redstone signal."
		""
		"This signal remains until the lower threshold is reached."
		""
		"The threshold values are configurable, and filters can also be applied so as to only count a specific item towards the threshold."
	]
	quest.4464A084DCB0D7B5.quest_desc: [
		"A whole lot of foods quests. Mainly interesting foods that I find hilarious or funny and want you to collect for absolutely no reason at all"
		""
		":)"
	]
	quest.449427B811450143.quest_desc: ["Can be found in the Fire Swamp. Will be located in the middle of the swamp. Beware of its multiple heads that can breathe fire. "]
	quest.44BE13CA008A2F7C.quest_desc: ["Train Stations serve as waypoints for your train network. They also are required for train (dis)assembly. Ponder for more info!"]
	quest.44F34A418EDE6AD8.quest_desc: [
		"Who knows what unknown power lies within this eye"
		"A mysterious eye that no ones knows how to find..."
	]
	quest.44FDAAA0329B06BD.quest_desc: ["Can be used to craft all of the previous essences, this crystal will not break no matter how many times it has been used."]
	quest.454D1ED3863798FF.quest_desc: [
		"Tertium Essence is used to make Tier 3 seeds. And Of Course Tertium Armor."
		""
		"All quests below this one are all Tier 3 seeds that can be crafted."
	]
	quest.459D17B3AE47173C.quest_desc: [
		"Mooshrooms..."
		""
		"Well I can say is good luck trying to find them. Unless your lucky and find the island straight away. "
	]
	quest.459D17B3AE47173C.quest_subtitle: "Mushrooms Galore!"
	quest.473C6C1BA82E23B9.quest_desc: [
		"An inscription table is used to inscribe a magic scroll into a spellbook. Spellbooks can be either crafted or found. Be careful though since some spells will not work in your spellbook if the rank is too low. "
		""
		"A Common Scroll can go into a Common Spellbook. But an Epic Scroll cannot go into a Common Spellbook. "
		""
		"Magic Scrolls can be found in chests throughout your world or can be crafted inside of a Scroll Forge. "
	]
	quest.473C6C1BA82E23B9.title: "Getting Started"
	quest.47A8CFBA530E4CFE.quest_desc: [
		"Inferium is the most basic essence in the mod and the 1st tier of essence. It is required to be used in order to craft the higher tier essences."
		""
		"All the seeds below this quest are tier 1 seeds and require inferium essence to be crafted."
	]
	quest.47B938A6EB50763A.quest_desc: [
		"Arcane Ingots are used in the making of Empty Upgrade Orbs. Which are needed to make specific spell class upgrade orbs. "
		""
		"These ingots are also used in the making of the Ultimate Ingot and can also be used to make the Ring of Mana which can increase your mana capacity by 100."
	]
	quest.47EDE6CF148A4BA5.quest_desc: ["The windmill is a pretty decent source of rotational force. It can also be nice to look at, if aesthetics is something you care about."]
	quest.47EDE6CF148A4BA5.title: "Create a Basic Windmill"
	quest.482F2B8E9424B99C.quest_desc: ["You did it! You made every single sushi in Sushi Go Crafting!"]
	quest.482F2B8E9424B99C.quest_subtitle: "(in this mod)"
	quest.482F2B8E9424B99C.title: "ALL THE SUSHI"
	quest.484FBC744037365E.quest_desc: ["Used for harvesting crops. Can be put onto Minecart Contraptions or attached Mechanical Bearing Contraptions"]
	quest.4855EE6F60290828.quest_desc: ["Why would you even think about killing an Allay?"]
	quest.48635D706539ED79.quest_desc: ["A powerful yet destructive artifact; the Piglins swore to protect it at the cost of their lives"]
	quest.48797D5A4ADA4B56.quest_desc: ["Like the regular grid but there is a crafting table so you can directly take items out and craft with it. Also works with the JEI \"+\" button for importing crafting recipes."]
	quest.48D55D5F9F67B8EB.quest_desc: ["It is told that it was forged by the first blacksmiths of time"]
	quest.497409275EE88344.quest_desc: [
		"Used to make any of the Entity type seeds in the mod. "
		""
		"To use the seed base you need to use Infusion Crafting."
	]
	quest.49CCF791617ABE59.quest_desc: ["Made inside of the Flux Crafter, to make Enhanced Redstone Ingots you need a Flux Star and 4 Redstone Ingots surrounding it inside of the Flux Crafter. "]
	quest.4A29FFF657700412.quest_desc: ["Found in the Nether and sometimes in the overworld on Basalt Beaches."]
	quest.4A4D25986BDA4D94.quest_desc: [
		"Patterns are essential if you want to auto-craft any item. To even make use of these Patterns you'll need a Pattern Grid. The pattern grid will help you put the desired crafting recipe into it. "
		""
		"Patterns can only use 3x3 crafting recipes so any recipes that are bigger than that will not work. They also only work for Crafting Tables. Any modded crafting station does not work."
	]
	quest.4A646F8D48004C17.quest_desc: ["The Ultimate Armor."]
	quest.4A646F8D48004C17.title: "Dragon Armor"
	quest.4A66DFFF1452A530.quest_desc: ["Here is the skinning knife, this allows you to obtain the skins of most animals within this mod, to find which ones allow this check JEI."]
	quest.4A66DFFF1452A530.title: "Skinning Knife"
	quest.4A7B39531DBB8970.quest_desc: [
		"This compass will point to the nearest Catacombs and lead you to it. "
		""
		"The catacombs is where the Dead King lies, Be careful on your journey."
	]
	quest.4ACC74EEBEF7766B.quest_desc: ["To obtain a Wither's Corpse you need to kill it with a Butcher's Knife or get the Butcher Enchant on your weapon of choice."]
	quest.4ACCED87EA1533F3.quest_desc: [
		"That's pretty much it for the main part of the Butchery Mod, there is a lot more to explore with these mod. Lots of other functional blocks you can craft as well like a display case or head mounts, or jars, etc. "
		""
		"Explore the mod a bit more, not everything is put into the Quest Chapter."
	]
	quest.4B67CEED2F261D09.quest_desc: ["Made using the cutting board and cleaver."]
	quest.4BDCA85CA09CD2F0.quest_desc: [
		"The Meat Grinder is used to obtain minced versions of meat though only currently Minced Beef and Lamb. So Cow and Sheep."
		""
		"To do this you need to place the meat grinder on the Butcher's Table. Next you'll need either some Cow Meat or Lamb/Sheep Meat to put into the Grinder. And you just right-click the meat on the grinder to place it in."
		""
		"Once done with that just hold right-click on the Grinder to start grinding the meat into mince meat. It will then ask you to cut the meat from the grinder once finished. "
		""
		"And now you either have Minced Beef or Minced Lamb."
	]
	quest.4BF1F94C3FA513F7.quest_desc: ["The Prosperity Seed Base will be the most important thing you need to make, it is used to make mostly every single seed in this mod. Except for the Entity type seeds, then you need the Soulium Seed Base."]
	quest.4C2AE860541562AE.quest_desc: ["Black Iron Frames are necessary to craft Quantum Compressors and Crafting Cores. "]
	quest.4CA1B94BAAA1B9FA.quest_desc: ["This here is dragon meat, obtained by butchering a dragon corpse."]
	quest.4D3EDA14941B2C99.quest_desc: ["Found abundantly in the End Dimension. Found on Main End Island and pretty much anywhere in the Outer End Islands."]
	quest.4D45B6349DA352D5.quest_desc: [
		"Disks are an important item for putting storage into your Refined Storage System. Without disks you wouldn't have have storage for your system. "
		""
		"To add disks to your system you first need a Disk Drive. This will allow you to put up to 8 disks into your system. "
		""
		"To make any of these disks you first need their Storage Parts. These Storage Parts are essential for making Storage Blocks or Disks. "
	]
	quest.4D45B6349DA352D5.title: "DISKS!!"
	quest.4DE0E08AB65D86B1.quest_desc: [
		"With this you can wirelessly check to see if your auto-crafting is actually doing its job."
		""
		"It's like the Autocrafting Monitor just handheld. Like the Grid. Handheld devices if you must."
		""
		"To connect it to your network just shift-right click it onto your Controller"
	]
	quest.4DEE31E12A9CA28A.quest_desc: [
		"Wireless Transmitters are used for accessing your system wireless of course. You just need a Wireless Grid to use said wireless system. "
		""
		"You just need to place the Wireless Transmitter anywhere on your system for it to work. You can also upgrade the range on it with some Range Upgrades."
		""
		"If you need to charge your wireless grids please make a charger from the &lChargers&r mod!"
	]
	quest.4E028BF1C4CF9A51.quest_desc: ["Can be used to make Empty Upgrade Orbs and Empty Portal Frames."]
	quest.4E4A6F80A7C7C9A3.title: "NOODS!"
	quest.4E72B74869583E43.quest_desc: [
		"&oYou like Mosquitos?&r No?"
		"&lWell too bad&r"
		"Better get over your fear and kill them all"
		""
		"I'll give you a pretty decent reward for doing this."
	]
	quest.4E72B74869583E43.quest_subtitle: "You like mosquitos? Well here's mosquitos on steroids!"
	quest.4E8E38FB2B0A2CD2.quest_desc: ["Made using the cutting board and cleaver."]
	quest.4EE229E07A4389E1.quest_desc: [
		"Not needed. I was going to say that it's helpful, but for some reason, you can't use sesame seeds on sushi at the moment."
		"Hopefully this will change in the future."
	]
	quest.4F0F1843BE71D0D9.quest_desc: ["Break grass with a knife to get straw!"]
	quest.4F1732A3AC58EC0E.quest_desc: ["gained by slaying the ender dragon"]
	quest.4F6252928FAAE642.quest_desc: [
		"Prosperity shards are only found in one way and that is by finding them in ore form. Prosperity ore can be found all over the overworld. "
		""
		"Prosperity shards are used for a number of things like Prosperity Gems and Ingots."
	]
	quest.4FFBDBD32B9114CB.quest_desc: [
		"The most basic Rune there is. "
		""
		"Used in the making of Mana Upgrade Orbs. "
	]
	quest.5032EDF888D0C8B0.quest_desc: [
		"Obtained by cutting Ender Pearls on a cutting board using a Knife of course."
		""
		"What else would you cut it with."
	]
	quest.503C8F7A4F675C1D.quest_desc: ["At a low enough light level, brown mushrooms on rich soil become colonies. Break with shears, otherwise you'll just get a bunch of brown mushrooms."]
	quest.507C793618CCCE2A.quest_desc: [
		"The skin rack, a way to turn animal skin into leather. "
		""
		"To do this you need a few ingredients."
		"1. The animal skin or in this case Pig Skin"
		"2. Salt, can be found in river biomes, make sure its from the Butcher mod"
		"3. A Wet Sponge"
		""
		""
		"How this works is you right-click the Pig Skin onto the Skin Rack."
		""
		"Next you have to wet the skin with a Wet Sponge while it is on the Rack."
		""
		"Now you need to rub salt onto the skin, make sure this is after you wet the skin already."
		""
		"Now you just need to wait approx. 2 minutes for it to turn into leather"
	]
	quest.50DF18CDA493FDFE.quest_desc: ["Place the ham and use a bowl to get yourself a plate!"]
	quest.5134341A073D305C.quest_desc: ["Seeds can be found in the world or as loot."]
	quest.5134341A073D305C.title: "Farmer's Delight Crops"
	quest.51C2934227E00AFE.quest_desc: [
		"Can be used to place blocks in front it, make sure to set the filter to make sure which blocks are going to be placed in front of them."
		""
		"Pairs great with the Destructor that destroys blocks in front of it. "
	]
	quest.520DCDAB098F940D.quest_desc: [
		"Dragonskin is an essential material required for the crafting a late-game spellbook. "
		""
		"This spellbook is called the &5&lDragonskin Spell Book&r&r."
		""
		"The dragonskin is dropped from the Ender Dragon, since it is the skin of it."
		""
		"The spell book is of legendary rating and can hold 10 spell slots inside of it. "
	]
	quest.5295EE8E638BE255.quest_desc: ["Can be configured to perform a series of actions upon receiving a redstone signal."]
	quest.532B6F61B0AC8769.title: "Other Materials"
	quest.535F5776C353C1A8.quest_subtitle: "poke poke"
	quest.537DB00F3062C534.quest_desc: ["Exactly what it says on the tin. Configurable RF!"]
	quest.53A3D87C7584A053.quest_desc: ["Used to make cheese."]
	quest.53A3D87C7584A053.title: "Milk"
	quest.53C680022DA4707A.quest_desc: [
		"To make Redstone Ingots they need to be made via the Combination Crafting way. "
		""
		"For how this is setup I suggest checking JEI on where the pedestals go and what materials are needed. "
	]
	quest.54389706C4C522B8.quest_desc: [
		"A compact way to change rotation direction and transfer rotational force in perpendicular directions. "
		""
		"Put a gearbox in a crafting grid to get a vertical gearbox, which can change directions on the vertical axis. You can always turn it back into a regular gearbox again."
	]
	quest.543A917FDA45B72C.quest_desc: [
		"Get them foxes they ate all of your chickens!"
		""
		"I swear they did!!"
		""
		"&lI'm not lying to you I promise&r"
	]
	quest.543A917FDA45B72C.quest_subtitle: "Those sneaky, sly things! THEY ATE MY CHICKENS"
	quest.547816D69F45E0E4.quest_desc: ["Prosperity Ingots are used as a base material to craft the higher tier Essence Ingots."]
	quest.54B08F4E0D60CE11.quest_desc: ["All of the functionality of the copper variant, plus netherite chestplate-level armor!"]
	quest.55229E838B8592BD.quest_desc: ["This pushes liquids through fluid pipes using rotational force."]
	quest.55A5D15956821636.quest_desc: ["Enables you to select and save a structure as a .nbt file for later use."]
	quest.55B46EDDA15D5205.quest_desc: [
		"Once you reach the center of the Thornlands, you will see the giant white castle in the center. "
		""
		"Just reach the castle and you essentially beat Twilight Forest. There is no final boss as of yet."
	]
	quest.55B824346335A8B4.title: "Cucumber California Rolls"
	quest.560B5235057AD9CE.title: "California Rolls"
	quest.568CAC3C54E76E85.quest_desc: ["Machine Casings are generally used to make some of the Machines for Refined Storage. Used for Grids and Controllers mainly but also used for other machines. "]
	quest.56A15C1CA48ED2DE.quest_desc: ["The crushing wheels' younger sibling."]
	quest.56A15C1CA48ED2DE.quest_subtitle: "On the grind"
	quest.56CCFDAC95D5AD50.quest_desc: [
		"Ender Crafting is another way of crafting which uses Ender Power instead. "
		""
		"To make this work you need Ender Alternators surrounding the Ender Crafting."
	]
	quest.5736D3CA56C49B62.quest_desc: [
		"Pickle Pie..."
		""
		"Sounds disgusting and don't want to think about whether or not it actually exists."
	]
	quest.57A80B11E790E686.quest_subtitle: "Blocks for transfer of RF"
	quest.57D72A1161055876.quest_desc: [
		"Do it"
		"&lDO IT&r"
		"I know you want to"
		"Just look at the reward you get"
		"Its tempting &4&lright?&r&r"
	]
	quest.57D72A1161055876.quest_subtitle: "Kill it"
	quest.588298A6228A2B3F.quest_desc: [
		"Used to make Lightning Upgrade Orbs that increase the damage of Lightning type spells."
		""
		"Also used to make Electromancer Armor that has the same effects of the Upgrade Orb."
	]
	quest.58A34806F21D8EE6.quest_desc: ["This is where you can manage all your autocrafters that are connected to your RS network."]
	quest.58A34806F21D8EE6.title: "Autocrafter Manager"
	quest.58A4D744DF1CEED8.quest_desc: ["Used for pressing down on either Iron or Gold to make their Sheets Counterparts."]
	quest.58A4D744DF1CEED8.quest_subtitle: "squeeeeeeeesh"
	quest.58BB68B1A1B64B18.quest_desc: ["For getting comfortable on the train :)"]
	quest.58BB68B1A1B64B18.title: "Seat"
	quest.59ABAC910E550AC4.quest_desc: ["Has witnessed destruction. Maybe it also witnessed your stuff disappear"]
	quest.59B0DDBBA472B2A9.quest_desc: ["Chutes move items to and from inventories vertically."]
	quest.5A13E9E33DF4EF7B.quest_desc: [
		"&oThis isn't that hard...&r"
		"I should make all the quests make you kill cute animals."
		""
		"Well kill the zombies and take you reward"
	]
	quest.5A13E9E33DF4EF7B.quest_subtitle: "meh, this isnt that interesting"
	quest.5A3B0ECF7811FD1E.quest_desc: ["The Ultimate Furnace Awaits You"]
	quest.5A3C36990BE0811C.quest_desc: ["A direct upgrade from Andesite Funnels. Instead of moving one item at a time, these can be configured to move up to a full stack at once."]
	quest.5A4B4837E5040710.quest_desc: ["Used to make exactly one (1) sushi recipe. Love that."]
	quest.5A89786BE6629FA6.quest_desc: ["As the name says its a crafting table but in your inventory. No need to place down a block anymore. "]
	quest.5AE60E1E518255A4.quest_desc: ["The Snow Queen can be found in the middle of these snowy biomes on top of a huge ice plateau. The Queen will be located in her Ice Tower at the top. "]
	quest.5B17D39CE6A48142.quest_desc: ["gained by slaying the enderdragon"]
	quest.5B37C8BD1FA9096C.quest_desc: [
		"Inks can be found in Magic Structures across the world. Such magic structures where you can find them are Wizard Towers. "
		""
		"Inks are used to craft scrolls inside of the Scroll Forge. "
	]
	quest.5B37C8BD1FA9096C.quest_subtitle: "Where's the Ink"
	quest.5BAAEA0E8104BC5D.quest_desc: ["The Ultimate Skewer!"]
	quest.5BBAB0FA5645E3D2.quest_desc: [
		"So the basic material to make pretty much any of the machines for Refined Storage is Quartz Enriched Iron."
		""
		"This iron is used to make a lot of the machines here. For example, the Controller which is essentially the brain of your whole storage setup."
	]
	quest.5BBAB0FA5645E3D2.quest_subtitle: "Quartz Enriched Iron"
	quest.5BBAB0FA5645E3D2.title: "The making of a new Iron!"
	quest.5C4F2961B13DC4AA.quest_desc: [
		"When pressing pulp, you can make cardboard. This cardboard can be used to make item frames, nametags, and can also be used as a fuel source."
		""
		"But the best part is that you can make a Cardboard Sword and Armor. "
	]
	quest.5D1C88DCF84C141D.quest_desc: [
		"Welcome to Refined Storage!"
		""
		"A digital storage mod..."
		""
		"This quest chapter will take you through Refined Storage so you can setup your very own Digital Storage network for all your storage needs!"
	]
	quest.5D3471BF880C107E.quest_desc: ["Needed for most basic fluid based recipes."]
	quest.5D3471BF880C107E.title: "Copper Sheet"
	quest.5D903E562E56F29F.quest_desc: [
		"Obtained from the Butchery Mod, just kill an Elder Guardian."
		""
		"You have to kill the Elder Guardian with a Butcher's Knife or get the Butcher Enchant to drop the Corpse"
	]
	quest.5E61ADAB02B8DBBF.quest_desc: [
		"Used to make Fire Upgrade Orbs that increase the damage of Fire Type spells when on armor."
		""
		"Also used to make Pyromancer Armor that has the same effects of the Upgrade Orb."
	]
	quest.5E832D2BC303B407.quest_desc: ["Used in the Scroll Forge to Epic Spells."]
	quest.5EA0196E5D336C23.quest_desc: [
		"Hello, I am Kade, creator of the pack, in this modpack you basically explore the world. Think of it as an adventure modpack but instead of fighting monsters and bosses you find food and eat it."
		""
		"You still fight bosses and monsters just the main point is FOOD. Fighting bosses and monsters is just a little side-effect to get cool food."
		""
		"Here are some items to help you out on your beginning journey. The Akashic Tome filled with all guidebooks, the food book to keep track of foods, and a backpack since inventory space filles up quickly. "
		""
		"This is a pretty laidback modpack where the main premise is to just farm, fight monsters every now and then, to get foods."
		""
		"So Enjoy!"
	]
	quest.5EA0196E5D336C23.quest_subtitle: "Some Information"
	quest.5F45CAC1AD55FE25.quest_desc: [
		"Very nifty! "
		"Flint is the most basic material you can use for knives."
	]
	quest.5F45CAC1AD55FE25.quest_subtitle: "\"A knife!\"   \"NO!\""
	quest.5F45CAC1AD55FE25.title: "Let me see what you have!"
	quest.5FC3DBDC4D1DDDCE.quest_desc: [
		"Configure its input(s) and output(s) locations before placing it."
		""
		"There's a lot you can do with the mechanical arm, so I recommend Pondering for more information."
	]
	quest.5FC820E01255EAC8.quest_desc: [
		"This Quest Chapter will cover the progression of Twilight Forest "
		""
		"As well as some of the foods you can create while your in Twilight Forest"
	]
	quest.603755748AD96A41.quest_desc: ["Press shift over the items for a description."]
	quest.603755748AD96A41.title: "Fun Doodads"
	quest.6049F4F6A94ABBDD.quest_desc: ["A Bison Burger, a little inhumane don't you think?"]
	quest.6090AC432FECFEA0.quest_desc: [
		"Unlike Andesite Tunnels, Brass Tunnels have functionality beyond decoration."
		""
		"Brass Tunnels can have applied filters, group different conveyor lines together, and split items into different directions on conveyor belts."
	]
	quest.61D14E88C86E156F.quest_desc: ["Ender Stars are made from the Ender Crafter. For the recipe to make Ender Stars please check JEI. Make sure to have at least one Ender Alternator around the Ender Crafter."]
	quest.62089DE554BB152F.quest_desc: ["Seaweed is in the ocean, and avocados are found on avocado trees which spawn in the world. Breaking grass gets you seeds for the rest of the crops."]
	quest.62089DE554BB152F.title: "Sushi Crops Quests"
	quest.62242C801E937A1B.quest_desc: [
		"The Almighty! The All-Knowing! "
		""
		"SUPREME PIZZA!!!"
		""
		"You'll never taste anything like this! EVER!"
	]
	quest.622DE638394DACED.quest_desc: ["place the dragon meat stew and then right click it with a bowl"]
	quest.6231B8495C1D123B.quest_desc: [
		"The most basic processor that is used to make Cores which are another essential items to make other machines"
		""
		"To make the Basic Processor you need to make its Raw form first. Then smelt the Raw Basic Processor in a Furnace to get its complete form."
	]
	quest.625A32DDC5D6546A.quest_desc: [
		"Generate rotational force by crankin' up a storm. It's far from optimal, but it's better than nothing. "
		"Make sure you have lots of food handy—cranking makes you very hungry very quickly."
	]
	quest.625A32DDC5D6546A.title: "Manual Labor"
	quest.6293DB8F2B7B3C20.quest_subtitle: "~the cake will end up crazy~"
	quest.6293DB8F2B7B3C20.title: "Never use a messy recipe"
	quest.6427E5DCC4C30C35.quest_desc: ["Can be made in the Awakening Altar. Please see JEI on how to do it."]
	quest.6509D94A7263AF7E.quest_desc: [
		"Made out of the heart of a Soul Vulture."
		""
		"I wonder how a soul would taste?"
	]
	quest.65AB0E0AAB5B45F6.quest_desc: ["Reach Day 500, simple as that."]
	quest.65C8EFCBB5EF52D4.quest_desc: ["Sushi Go Crafting has its own rice, but rice from other mods functions just as well!"]
	quest.65C8EFCBB5EF52D4.title: "Rice"
	quest.66562A219DB749AC.quest_desc: ["Most Farmer's Delight recipes are made in the cooking pot. Place the pot on the stove and you're good to go."]
	quest.66562A219DB749AC.title: "Cookin' Time!"
	quest.6671236D693D2509.quest_desc: ["Place a skillet on a campfire, and you can make campfire cooking recipes quickly and in bulk."]
	quest.670EC27E553CA8AB.quest_desc: [
		"Can be used to make Water Essence, which when made with Nature Essence, can be used to make a variety of different items. "
		""
		"Later on in the mod, water essence is used to make Awakened Supremium."
	]
	quest.679F8C3E8382023E.quest_desc: ["Find some gobber ore in the overworld. Comes in Stone or deepslate. Check JEI for more information"]
	quest.679F8C3E8382023E.title: "Intro to Gobber"
	quest.67A2141B6E16DB79.quest_desc: [
		"When connected to a train, Mechanical Rollers can clear terrain as well as filling in blocks."
		""
		"Ponder has more information on their functionality."
	]
	quest.67C578A237FAAED0.quest_desc: [
		"Advanced processors are used to make Crafting Grids, essentially allowing you to craft inside of your storage system. You can also craft higher disks. And storage parts as well. "
		""
		"To make the Advanced Processor, craft its Raw Form and then smelt it inside of a Furnace."
	]
	quest.67CF99D18DC78817.quest_desc: [
		"Stock Links can be linked with Packagers underneath them and a connected inventory. "
		""
		"To make them work you need a Stock Ticker which is used to order items from Stock Links that are connected to an inventory. "
		""
		"You can need to right-click a Stock Ticker to a Stock Link to connect to the Network. "
		""
		"For more information, use Ponder on both of them. "
	]
	quest.67CF99D18DC78817.title: "Stock Link and Ticker"
	quest.67FDDDFB0C124A68.quest_desc: [
		"This covers not just Farmer's Delight, but also the Farmer's Delight-adjacent mods."
		""
		"&lSpecial Thanks to Lucius the Dragon for making this Quest Chapter&r"
	]
	quest.68B27A65FF637243.quest_desc: [
		"This seed can be used to make Earth Essence, which at the moment can only be used to make two things. It can make Soul Soil."
		""
		"And Later on in the mod can be used to Awakened Supremium."
	]
	quest.696557CED3ADFC8D.quest_desc: [
		"The final processor which requires a nether star to make it. The Withering Processor. This processor is used to make the Storage Parts that go up in the millions."
		""
		"These processors are also used in the recipe for making the Infinite Storage and Fluid Disks. As well as the Creative Controller."
		""
		"Like the others you need to craft its Raw Form and smelt it inside of a Furnace."
	]
	quest.697423CE6BBBA360.quest_desc: [
		"All I can say is Good Luck and Have Fun!"
		""
		"&oDid I mention that they mimic your weapons and armor your using?&r"
	]
	quest.697423CE6BBBA360.quest_subtitle: "Shapeshifting Annoying Slimes in the End"
	quest.6977C935BD67B09B.quest_desc: ["The Naga can be found in the Hedge Maze, they can be found pretty commonly. Just look for an aboveground stone maze."]
	quest.6977C935BD67B09B.title: "Kill the Naga"
	quest.69A70A1DFB841993.quest_desc: [
		"A Scroll forge is used to craft different types of Scrolls inside of it. "
		""
		"Now the type of scroll you can craft depends on two different things. Ink and a Focus. The Ink determines the Rank of your spell, The Focus determines what school of spells it belongs to. "
		""
		"You will also need paper to craft scrolls but the paper is just the same as normal paper. "
	]
	quest.69AA73B09B742BC5.quest_desc: [
		"Cinder Essence can be obtained from killing Ancient Knights. "
		""
		"Ancient Knights are only found in the Ancient Battlegrounds which are found in the Nether."
		"Ancient Knights come in the form of a Armor Pile. When armor piles are broken, they spawn the Ancient Knights."
		""
		"Cinder Essence is used in the crafting of some metals and Emtpy Upgrade Orbs. "
	]
	quest.69D2A7FDB1B3D525.quest_desc: [
		"Raw Mithril can be found in the Overworld and is used to make Mithril Scraps, and eventually Mithril Ingots."
		""
		"Mithril is not used for much but the most important thing it can make is emtpy upgrade orbs."
	]
	quest.69FCCE6DE79CF1DC.quest_desc: [
		"I wonder where you get this from?"
		""
		""
		""
		"Only obtained by opening up the ??? Lootbox/Reward of this quest, but its a very small chance to get it."
	]
	quest.6A0B834333B217B7.quest_desc: [
		"Recovery Runes are used in the making of Cooldown Upgrades Orbs. "
		""
		"Cooldown Upgrade Orbs are meant to be used on armor to reduce the cooldown for using spells."
	]
	quest.6B2ED2C72005D5C6.quest_desc: [
		"You gotta do the cooking by the book,"
		""
		"You know you can't be lazy!"
	]
	quest.6B2ED2C72005D5C6.quest_subtitle: "~if the way is hazy~"
	quest.6B2ED2C72005D5C6.title: "It's a piece of cake to bake a pretty cake"
	quest.6B4903D1C5FAC2FE.quest_desc: [
		"All the processors you will need to make your machines and disks in the future! "
		""
		"All processors require a Processor Binding and Silicon. They need two other materials but each other requires different materials so look in JEI and see how they are made."
	]
	quest.6B6785CD568D089C.quest_desc: ["These spellbooks on the right are all spellbooks that cannot be crafted. They can be either found or dropped by a monster. "]
	quest.6B7DDC8E45E675BA.quest_desc: [
		"Train Signals are helpful for managing the logistics of train networks, especially with unmanned trains."
		""
		"Ponder for more information on the neat things you can do with them!"
	]
	quest.6C603C0973204475.title: "ALL THE NIGIRI"
	quest.6CBC1B330713C18B.quest_desc: ["These are all the maps you can make for Twilight Forest, they are not needed but will help a lot to find thing throughout the dimension."]
	quest.6CBC1B330713C18B.title: "Map Creation"
	quest.6CFFC371B8C2A5A0.quest_desc: ["You will need to make a Dried Kelp Block in order to make Nori Sheets."]
	quest.6DFF28C7C63DB2FB.title: "Farmer's Delight Noods"
	quest.6E329858C42D30A0.quest_desc: ["This is the Artifacts side of the Quest Chapter."]
	quest.6E32D549A7C2E942.quest_desc: [
		"This is a spit rotisserie which is used to cook whole corpses but only pig and cow corpses."
		""
		"For this to work you need to place it down and place a campfire underneath it. "
		""
		"Keep in mind that the corpse needs to be drained. Skinned Corpses do not work either."
		""
		"Right-click a drained corpse on the rotisserie to place it on there and to start the cooking process. Once done the corpse will be a different color and all you to do is punch it to obtain all the cooked meat. "
		""
		"It does &lNOT&r give you a cooked corpse, only the meats of whatever animal you put on it."
	]
	quest.6E3783809683656A.title: "Stock Ordering and Storing"
	quest.6EA41CE69AC35F4C.quest_desc: [
		"Hello, again... so uh here are some quests that can somewhat help you on what you can do in create if you dont know what to do at the moment."
		""
		"Soooooo... here are some things you can create there are no recipe changes for the mod so yea do whatever you want.... to your heart's desire I guess... create a factory idk"
		""
		"&oP.S.: Ponder is your friend. Quests may provide basic info, but when in doubt, check the Ponder info!&r"
		""
		"{@pagebreak}"
		""
		"&lSpecial Thanks to Lucius the Dragon for making the Quest Chapter&r"
	]
	quest.6EA41CE69AC35F4C.quest_subtitle: "Some information"
	quest.6EBD263C743E3226.quest_desc: [
		"Mechanical belts move items and entities on top of them. They attach to shafts."
		""
		"They also transfer Rotational Force with similar functionality to chain drives."
	]
	quest.6F0488E1935E300F.title: "Alex's Delight Noods"
	quest.6FD99B62C5BACFB8.quest_desc: ["Exactly what it says on the tin. It cooks rice when provided with water and furnace fuel."]
	quest.7030CA8133149623.quest_desc: ["place the grilled shulker on the ground and then right click it to get the plate of grilled shulker"]
	quest.704B2BE5903D9D6D.quest_desc: [
		"So all Grids, Controllers, Security Terminals, Disk Drives and Manipulators can be changed in color if you do not like the defauly coloration."
		""
		"Wireless Transmitters also can be changed in color if you want to change it. "
		""
		"Anything that was not mentioned in the questline I either forgot to put or I just don't know how to explain it."
	]
	quest.7076105F50BF36E2.quest_desc: [
		"Flux Alternators are needed to be around the Flux Crafter so the Crafter itself can actualy craft. It needs at least one Alternator for the crafting to begin. "
		""
		"For it to go faster at crafting I suggest crafting more Alternators."
	]
	quest.71674467E58D3673.quest_desc: ["Assembles and disassembles Minecart contraptions depending on redstone signal."]
	quest.72D058F24340734E.quest_desc: [
		"To make Ender Ingots you need to use Combination Crafting. "
		""
		"Please check JEI on how the pedestals are supposed to be setup and what materials you need to make it."
	]
	quest.72EA8E21814E15A3.quest_desc: ["Made using the cutting board and cleaver."]
	quest.73446E03763FAF3A.quest_desc: ["Ender Alternators are used for Ender Crafting. For Ender Crafting to work you need at least one Ender Alternator around the Ender Crafter. "]
	quest.738EFC14150F3883.quest_desc: ["Moves attached structures vertically. Rotation direction determines whether the rope moves up or down."]
	quest.7395E9DFB016768D.quest_desc: ["You for an array of different items. Such as Exporters and Importers. Also an essential material for Grids, Controllers, and Any other Blocks from Refined Storage. "]
	quest.73A6410F5E987AA2.quest_desc: ["kill a wild deer in the twilight forest"]
	quest.7444260114730136.quest_desc: ["Firstly, you'll need a Butcher's Knife to even get started on this mod."]
	quest.7444260114730136.title: "Butcher's Cleaver"
	quest.747F99071FE74757.quest_desc: [
		"&oThis shouldn't be too hard... Right?&r"
		""
		"I mean its not like they are like 3x times bigger than you or something"
		"Its not like they have 3x times the health."
		"Nooooooo...."
		"&oNever...&r"
		"..."
		""
		"&oGood Luck you'll need it&r"
	]
	quest.747F99071FE74757.quest_subtitle: "Big Mammal"
	quest.7485C19F6DB175F9.quest_desc: ["Used in the Scroll Forge to make Legendary Spells."]
	quest.74EA66D81B3A0880.quest_desc: ["Fragments of Forbidden Magic, belonged to the class of &2Eldritch&r"]
	quest.75015EE24BFCA715.quest_desc: ["dev quest so i dont have to re-do the entire akashic tome"]
	quest.7508EC4DB19014C9.quest_desc: [
		"Imperium Essence is used to Craft the Imperium Armor Set as well as Tier 4 seeds."
		""
		"All quests above are Tier 4 seeds that can be crafted."
	]
	quest.752A919089495F8F.quest_desc: [
		"This is an Autocrafter."
		""
		"Used to autocraft items in Furnaces, Smokers, Crafting Tables, etc. "
		""
		"To set up the autocrafter you have to put a pattern inside of the crafter first. "
		""
		"You can hook it up to your network for regular crafting table recipes by putting the crafter next to your controller. "
		""
		"For any other block you have to make sure the crafter is placed right next to block you want to autocraft, making sure its facing the correct way. "
	]
	quest.752A919089495F8F.title: "Autocrafter"
	quest.7535FE5F79EBD1CC.title: "Miner's Delight Noods"
	quest.757C6D31C5F02F88.quest_desc: ["A holy talisman said to protect its owner from bad luck"]
	quest.75AD12C5A7F83185.quest_desc: ["Visualizes the speed or stress for a connected contraption. They function with comparators."]
	quest.75AD12C5A7F83185.title: "Speedometer and Stressometer"
	quest.76ABBA173BCAF166.quest_desc: ["The basin goes beneath the mixer and holds ingredients for it."]
	quest.76ABBA173BCAF166.quest_subtitle: "whirrrrrrrrr"
	quest.773230C925010D42.quest_desc: [
		"Can move structures vertically between marked locations. So, an elevator."
		""
		"You'll need Redstone Contacts for the elevator to function. Check the Ponder for more information on constructing an elevator!"
	]
	quest.773F2477F30E5099.quest_desc: ["Can be obtained by killing Blazes."]
	quest.77480A3396F9972E.title: "Fortune II and III Upgrade"
	quest.77530FE4518B690A.quest_desc: ["Using gunpowder as fuel, the Schematicannon accesses attached inventories for blocks and will create the structure saved in a given schematic."]
	quest.7774E3A747C5BFDA.quest_desc: ["Andesite alloy is one of the most important resources for the Create mod. You're going to need a lot of it to make anything"]
	quest.7774E3A747C5BFDA.title: "Andesite Alloy"
	quest.77847A2BCA80F399.quest_desc: [
		"You can make the best weapon and armor set in the game (totally)"
		""
		"&oYou have to believe me&r"
		""
		"it can totally one shot everything (&oit cant&r)"
		""
		"So you should totally make it (&odont do it, its a waste of time and resources&r)"
		""
		"You can sneak and turn yourself into a cardboard box! "
		""
		"&lISNT THAT AMAZING!&r"
	]
	quest.780B4FCB445E6379.quest_desc: ["To make Ender Enhanced Ingots you need the Ender Crafter again. This time using the Ender Stars inside of the recipe. For the exact recipe please check JEI."]
	quest.7845E823D50D82DF.quest_desc: ["Used in the Scroll Forge to make Rare Spells."]
	quest.785093EF6892E256.quest_desc: [
		"With Refined Storage you can setup very basic Autocrafting for a some blocks of your "
		"choosing. "
		""
		"Refined Storage autocrafting is very simple and can't use it with most modded crafting blocks, you would have to use Applied Energistics 2 for more complex autocrafting."
	]
	quest.78611CADD26C4793.quest_desc: [
		"did someone say INFINITE STORAGEEE!!"
		""
		"why am i doing this to myself"
	]
	quest.787300DA9B071612.quest_desc: ["Crafted using Copper and a lot of leather. The most simple Spell Books there is. Perfect Early-Game Spell Book."]
	quest.78AD12CB967B27E1.title: "Gobber Tools"
	quest.78BF234361733CC7.quest_desc: ["The experiments of Twilight Forest."]
	quest.78BF234361733CC7.title: "The Experiments"
	quest.78CED4E78809631F.quest_desc: [
		"To progress further into the mod you will need an animal corpse, or monster, whichever you prefer."
		""
		"To get a corpse, you need to kill the animal with a Butcher's Knife, that will drop the corpse for you to use. "
		""
		"&oYou can also get the Butcher Enchant on your weapon to do the exact same thing&r"
	]
	quest.78CED4E78809631F.title: "Gather a Corpse/Carcass"
	quest.79876A0108CB888E.quest_desc: ["Used for certain fluid-manipulating blocks."]
	quest.79876A0108CB888E.title: "Copper Casing (Copper Age)"
	quest.79C45F3ADF485BE7.quest_desc: ["I wonder how you get this lootbox?"]
	quest.7A480F5DB3A2F532.quest_desc: ["Just make a Netherite Backpack."]
	quest.7A480F5DB3A2F532.title: "Make a Netherite Backpack"
	quest.7A8831B0718CE770.quest_desc: [
		"For the next part, you'll need a hook and chain. Setting this up is pretty simple."
		""
		"Place a chain about 4-5 blocks up from wherever your setting up."
		"Then right-click the hook on the chain to turn it into a Hook Block."
		""
		"This is where you will be hanging the corpse on!"
	]
	quest.7AB8BAE510FB1D7A.quest_desc: [
		"Basic Magician Armor for Early Game of Iron's Spells and Spellbooks. "
		""
		"An easy, early-game way to increase your mana capacity."
		""
		"To craft this armor all you need is leather armor and arcane essence and combine them in a smithing table. "
	]
	quest.7ACC353EFC742B94.quest_desc: ["The water wheel is a fairly rudimentary source of rotational force. It's better than cranking by hand, though."]
	quest.7AEA257C66CBFFCA.quest_desc: [
		"A Chorus Mousse."
		""
		"So interesting, but sounds weirdly delicious?"
	]
	quest.7B0753E355712607.quest_desc: ["Up on the sky island, the Giant's Pickaxe and Sword can be obtained by either looting the chest or killing the Giants that inhabit the island. "]
	quest.7B247EE0300DD064.quest_desc: ["It has seen many warriors drown into the depths of the sea"]
	quest.7BCDFCEC5C32A9C0.quest_desc: ["An important crafting component."]
	quest.7CDA6EBF63F794EB.quest_desc: ["Used to make Mithril Ingots. You need 4 of them to make one ingot."]
	quest.7D0E4D575AEA6C49.quest_desc: ["just do it, create one, it should be your life dream to create a kitchen in minecraft"]
	quest.7D0E4D575AEA6C49.quest_subtitle: "CREATE IT"
	quest.7D2AD1CDB4D99DE7.quest_desc: ["Made in the rice cooker."]
	quest.7D7BBC1F888F99E5.quest_desc: [
		"Craft the Archmage's Spellbook from Ars Nouveau, become the most powerful magician or wizard or whatever they call it in Ars Nouveau."
		""
		"Source Magician? Source Wizard? A Sage? i dont know"
	]
	quest.7D7BBC1F888F99E5.title: "Become an Archmage!"
	quest.7DB41379FBAB9A3B.quest_desc: [
		"Linear Chassis connect to other chassis facing the same direction without super glue."
		""
		"Super glue is needed to connect to other blocks, though."
		"Check Ponder for the specifics."
	]
	quest.7E7ABBE15AD3DF5F.quest_desc: ["Soulium dust can be found in ore form in the Nether Dimension. You can find the ore surrounded by patches of a brown stone called Soulstone. Soulium Ore is found in these Soulstone patches. "]
	quest.7E8E5092FD1F7C78.quest_desc: ["using the egg fragments craft it with obsidian and youll need this for the steamed dragon egg soup"]
	quest.7EA0FE5D360896AF.title: "End Gobber Tools"
	quest.7EB4892A5C8AA816.quest_desc: ["Obtained By Cutting a Chorus Fruit"]
	quest.7EC86A4961E1CA0A.quest_desc: ["This is the Relics side of the Quest Chapter."]
	quest.7F9E82A0FB126657.quest_desc: [
		"Flux Crafting, crafting using Redstone Flux. On your way to make Enhanced Redstone Ingots Flux Crafting will be a important step."
		""
		"The Flux Crafter is the main block needed to do any Flux Crafting. It goes in the middle of the Flux Alternators. "
		""
		"For Flux Crafting to work each Flux Alternator needs to be powered using &nRedstone Flux/Energy&r"
		""
		"An easy way to get energy is by making a Furnace from &nIron Furnaces&r into a Generator. To do that you need to make a Generator Upgrade for the Furnace and put it in the Furnace. The way it makes Energy is by burning any Fuel Source. Coal, Charcoal, Gobber Foo, any of those will work. Even Lava.  "
	]
	quest.7FB3DB89ADFA9442.quest_desc: [
		"Gantry Carriages attach to Gantry Shafts and move on them horizontally or vertically."
		""
		"A redstone signal stops the carriage's movement and instead rotates its output shaft for RF."
		""
	]
	quest.7FB95D8ABD866F96.quest_desc: [
		"Used to view any and all items currently in your system."
		"Also used for taking in and out items from your system."
	]
