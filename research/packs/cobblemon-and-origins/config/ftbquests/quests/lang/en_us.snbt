	quest.771A65408C70EFA7.quest_desc: ["Place a comparator on any side of a chiseled bookshelf, or the chiseled bookshelf against a comparator with the back of the comparator running into it."]
	quest.771A65408C70EFA7.quest_subtitle: "this actually works"
	quest.776F0CA023690BC6.quest_subtitle: "Can display text or numbers. This would be useful in making elevators too."
	quest.77C101CD787758D2.quest_desc: ["Have a cabbage, cabbage seed, cabbage leaf, and wild cabbage in the inventory."]
	quest.77D40B2750832907.quest_desc: [
		"&l&nHave the Nourishment status effect applied.&r&r"
		""
		"This prevents players from losing hunger or saturation through exhausting actions, such as running, jumping and attacking mobs. This effectively extends the hunger bar beyond its saturation limit, delaying the time before players need to eat again."
		""
		"&lThis can come from&r: Bacon and Eggs, Ratatouille, Grilled Salmon, Mushroom Rice, Pasta with Meatballs, Pasta with Mutton Chop, Steak and Potatoes, Fried Rice, Roast Chicken, Roasted Mutton Chops, Squid Ink Pasta, Vegetable Noodles"
	]
	quest.77DDF57E9E43C076.title: "Use an Spring Coiling Machine to obtain a spring"
	quest.782ACE01B2B5BC9B.quest_desc: ["Brush either suspicious sand or suspicious gravel and have any pottery sherd in the inventory. These two events can happen separately from one another."]
	quest.782ACE01B2B5BC9B.quest_subtitle: "how did that get there"
