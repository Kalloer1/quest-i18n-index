	quest.7D2EDEBE326CFCDE.quest_desc: [
		"Have rich soil in the inventory. "
		""
		"Expose organic compost to sunlight and water. This takes a considerable amount of time. "
		""
		"Rich soil promotes growth on crops as if they were randomly given bone meal. Rich farmland doesn't change back to normal soil even when jumped on. "
	]
	quest.7D2EDEBE326CFCDE.quest_subtitle: "I'm rich... in dirt"
