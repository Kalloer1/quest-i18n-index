	quest.3DA1CC6B1DFEA896.title: "Lapis Armor"
	quest.3DA4B90758C148EC.quest_desc: [
		"Creates a temporary &bWarp Portal&r when used on a block. The &6Stablized Warp Scroll&r is not consumed on use and can teleport between dimensions."
		""
		"Using a &6Stabilized Warp Scroll&r to create a &bWarp Portal&r will create a cross dimension &bWarp Portal&r, but consume the scroll. "
		""
		"This scroll may only be bound to a location a single time."
	]
	quest.3DA4B90758C148EC.quest_subtitle: "Cross-Dimensional Fast Travel"
	quest.3DB46440C912F357.quest_desc: [
		"&dThe Enchanter's Eye&r can be inscribed with a spell and linked to a &bScry Crystal&r."
		""
		"Using the linked &dEnchanter's Eye&r will cast the spell through the &bScry Crystal&r similar to a &eSpell Turret&r, except you are considered the caster."
	]
	quest.3DB46440C912F357.quest_subtitle: "Remote Spell Casting"
	quest.3E0403BB646B60E5.quest_desc: [
		"&dBlank Parchment's&r can have one spell inscribed onto them on a &6Scribe's Table&r."
		""
		"To inscribe the &dBlank Parchment&r, place on a &6Scribe's Table&r then cast the desired spell onto it."
		""
		"Now the parchment can be used to assign the inscribed spell onto a &bSpell Turret&r, or put into a &aSpell Binder&r (alternative spell book with special upgrade slots)."
	]
	quest.3E0403BB646B60E5.quest_subtitle: "Magic Paper"
