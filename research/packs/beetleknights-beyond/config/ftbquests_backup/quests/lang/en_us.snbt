	quest.6B4594A6DD3108B1.title: "Enchantment Library"
	quest.6B775EED67C164D8.title: "Stack of Terracotta"
	quest.6B8AE9CDDD9328F8.quest_desc: [
		"The &6Enchanting Table&r will take your equipment to the next level!"
		""
		"Placing Bookshelves around will provide stronger enchantments."
		""
		"With the addition of &9Apotheosis&r, enchanting is overhauled to operate with 3 main elements..."
		""
		"&aEterna&r: Enchanting power, More advanced bookshelves raise the max limit."
		""
		"&cQuanta&r: Chaotic influence, Increases the range and variety of power for better or worse."
		""
		"&dArcana&r: Enchantment rarity, Increases the chance of getting more enchants and higher rarity. "
		"- 2 enchants are guarenteed at 25%"
		"- 3 enchants are guarenteed at 75%"
	]
	quest.6B8AE9CDDD9328F8.quest_subtitle: "Enchantment!"
	quest.6B8AE9CDDD9328F8.title: "Enchantment?"
	quest.6B8EECE23FA84CF1.title: "Dragon's Breath"
	quest.6C2BA39638237CA2.quest_subtitle: "15 Armor"
	quest.6C2BA39638237CA2.title: "Warrior Armor"
