	quest.544C94C4C400B970.title: "The Slimeshroom"
	quest.54A6356C17B59AF7.quest_desc: [
		"A tool for configuring &9Source Relays&r and &aFamiliar Charms&r."
		""
		"To set a transfer path, use the &dDominion Wand&r on the object that you would like to take from, and then use it on the block you want to send to."
		""
		"For Example: To transfer from &bSource Jar 1&r to &6Source Jar 2&r"
		""
		"&bSource Jar 1&r -> &bSource Relay 1&r,"
		"&bSource Relay 1&r -> &6Source Relay 2&r,"
		"&6Source Relay 2&r -> &6Source Jar 2&r."
		""
		"To clear connections, &esneak + right-click&r on a &9Source Relay&r."
		""
		"You can switch to Strict mode using the radial menu (check keybinds), allowing to specify the side of the block to use. "
	]
	quest.54A6356C17B59AF7.quest_subtitle: "Magic Wrench?"
	quest.54A6356C17B59AF7.title: "Dominion Wand"
