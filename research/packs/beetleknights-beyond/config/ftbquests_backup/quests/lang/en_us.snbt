	quest.05CEF299CE744915.title: "Tips"
	quest.060B9D3E5AAA3F2A.quest_desc: [
		"The &6Enchanter's Fishing Rod&r will cast the inscribed spell as &dTouch&r. Hook an entity with the fishing rod and right-clicking will cast the spell until the line is broken."
		""
		"When inscribing a spell, do not give the spell a form it will be added automatically."
	]
	quest.0619955E80BA40E9.quest_desc: [
		"&6Training Treat&r is the first item you will need to start DTN (Unless you bought the &dStarter Bundle&r from the &aShop&r)"
		""
		"Using a &6Training Treat&r on a tamed dog or untamed wolf will change them into a tamed &bDTN Dog&r"
		""
		"Shift Right-Click your &aDTN Dog&r to open the DTN menu. You can use the &e\"A\"&r and &e\"D\"&r keys to switch pages in the menu"
		""
		"&6Training Treats&r are also used to increase your &bDTN Dog's&r level."
		""
		"Each treat raises your &bDTN Dog's&r level by 1 and provides an additional skill point."
		""
		"&6Training Treats&r can raise a &aDTN Dog's&r level up to &l&c20&r&r."
	]
	quest.0619955E80BA40E9.title: "Doggy Talents Next"
	quest.0625E5D48727B616.quest_desc: [
		"When you open your inventory you will see FTB's icons in the top left. Here's where you can find the Chunk Claim Manager."
		""
		"&aFTB Chunks: Claim Manager&r lets you eaily claim and force-load chunks. &bLeft-Click&r to claim, &bShift + Left-Click&r to force-load, and &bRight-Click&r to unclaim chunks."
		""
		"&eClaimed:&r Prevents mobs and non-allied/teammate players from griefing your chunks and interacting with blocks. Useful against charged creepers that might sneak up on you."
		""
		"&eForce-Loaded:&r These chunks remain loaded regardless of player proximity. Useful for farms. Necessary for wireless power and storage systems. Caution, Forcing the game to load too many chunks will impact performance, use force-loading only when necessary."
	]
	quest.0625E5D48727B616.quest_subtitle: "Protect Your Stuff"
	quest.0625E5D48727B616.title: "Chunk Claiming"
