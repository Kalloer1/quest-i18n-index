	]
	quest.76C73941D09FA45A.title: "Catacombs"
	quest.76D7788B0CE4B887.title: "+1 Back Slot"
	quest.76D7858D6F3485BF.quest_desc: [
		"&6Companions!&r mod adds 3 coins which can be found in various loot chest. These coins can be used in the &bFrog Bonanza&r or here in the quest shop."
		""
		"&aCopper Coin:&r Found in nearly any overworld loot chest."
		""
		"&cNether Coin:&r Found in Nether Fortress loot chest."
		""
		"&dEnd Coin:&r Found in End City loot chest."
		""
		"&n&cWarning:&r&r Addiction isn't the only risk playing the &bFrog Bonanza&r, some rolls may have explosive consequences or attract unwanted guest..."
	]
