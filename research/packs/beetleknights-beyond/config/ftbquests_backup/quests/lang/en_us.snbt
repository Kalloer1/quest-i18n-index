	quest.740D5FE26878EDAD.quest_subtitle: "Increase your /sethome limit to 4"
	quest.740D5FE26878EDAD.title: "Home Limit Upgrade 3"
	quest.74174517F49CAFE6.quest_desc: ["&dPotion Jar&r can store 100 potions. It is also used by the &9Wixie&r for auto-brewing, &bPotion Melder&r to combine potions, and can be used to apply potion effects to arrows."]
	quest.74174517F49CAFE6.quest_subtitle: "Big Potion Bottle"
	quest.741C09608EF2759C.quest_desc: [
		"&6Tag Item Filter&r allows you to filter by... tags!"
		""
		"Just stick an item into the slot on the filter and it will list every tag associated with that item."
		""
		"You can search the tag in &dE&r&aM&r&bI&r to see all the items with that tag."
	]
	quest.742DCDBEBCCD0402.title: "Prefab Tier 3"
	quest.7452BB639231B8A1.quest_subtitle: "36 Armor"
	quest.7452BB639231B8A1.title: "Awakened Supremium Armor"
	quest.74ACE3C54B66C1BB.quest_desc: [
		"&dTimer Spell Turrets&r will automatically fire on a timer. "
		""
		"Defaulted to 1 second, the time may be increased by right-clicking the block. "
		""
		"Punching will decrease the time. Sneaking will allow you to configure it in 10 second intervals."
		""
		"To prevent further changes, lock and unlock the turret using the &6Dominion Wand&r. "
		""
		"Setting the turret to 0 seconds or providing a redstone signal will disable it. "
	]
	quest.75A1C6B130A61C70.quest_desc: ["&6Golem Armor&r is expensive to craft, but very strong and indestructable!"]
