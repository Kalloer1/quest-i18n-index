	quest.12D351AA2DF6C21A.quest_desc: [
		"The &6Enchanter's Wand&r will cast the inscribed spell as a &dProjectile&r with &eAccelerate&r."
		""
		"When inscribing a spell, do not give the spell a form it will be added automatically."
	]
	quest.134E10B85D06CCB8.quest_desc: [
		"The &6Dyson Cube Project&r is simple. You craft &dBeams&r and &bSolar Sails&r then launch them into the sun to harness it's power."
		""
		"Each &bSolar Sail&r generates &a20&r &cFE/tick&r"
		""
		"Each &dBeam&r increases the amount of &bSolar Sails&r you can launch by 6"
		""
		"If you launch 10 &dBeams&r you can launch 60 &bSolar Sails&r and generate &a1200&r &cFE/tick&r."
		""
		"But you will need something to launch all these &dBeams&r and &bSolar Sails&r..."
	]
	quest.134E10B85D06CCB8.title: "Dyson Cube Project"
