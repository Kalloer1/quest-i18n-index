	quest.3BDFD6DBBD62C7BF.quest_desc: ["&cFire Infused Turret&r provides the same elemental boost and combos as the focus, as well as a 65% discount on spell cost."]
	quest.3CDA270284F77BC8.title: "Fortress of Fire"
	quest.3D33DD268881B3F6.quest_desc: [
		"&l&6Comforts&r&r"
		"&bSleeping Bags&r and &aHammocks&r!"
		""
		"&bSleeping Bag&r allows the player to sleep through the night without changing their respawn point."
		""
