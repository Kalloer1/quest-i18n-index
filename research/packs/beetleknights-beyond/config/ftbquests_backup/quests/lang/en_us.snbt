	quest.760925AE91133F6C.title: "Prudentium Armor"
	quest.7680B8B352477830.quest_desc: [
		"&6Runestones&r are the first step in mastering the various schools of magic."
		""
		"&6Runestones&r can be found rarely in vanilla structure loot chest, but more commonly within Iron's Spells structures and from slaying magical mobs."
		""
		"&6Runestones&r inscribed with a magical focus can be made blank with a &dShriving Stone&r."
	]
	quest.76C73941D09FA45A.quest_desc: [
		"The &6Catacombs&r are home to &cThe Dead King&r."
		""
