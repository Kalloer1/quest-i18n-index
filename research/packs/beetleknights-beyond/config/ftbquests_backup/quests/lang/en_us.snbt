	quest.0CAFB5BE2B9DFE9D.quest_desc: [
		"There are several &dBaubles&r that can be placed in a &6Maid's&r inventory to protect them under certain conditions."
		""
		"&eUltramarine Orb Elixir&r: Can be used 6 times to avoid a &6Maid's&r death."
		""
		"&bProtect Bauble&r: When the &6Maid&r receives the corresponding, the damage is prevented."
		""
		"&#226860Nimble Fabric&r: When a &6Maid&r is hit by a projectile they will teleport like an Enderman."
		""
		"&aItem Magnet&r: Increase the pickup range for a &6Maid&r."
		""
		"&cMute&r: Silences a &6Maid&r. (&6Maids&r can be silenced in their sound settings as well)"
		""
		"&9Gap&r: Wireless item transport between a selected inventory and the &6Maid's&r"
	]
	quest.0CB8D99FD8C125E6.quest_desc: [
		"Blocking damage with the &6Enchanter's Shield&r will trigger &bMana Regeneration&r and &bSpell Damage&r."
		""
		"&6Enchanter's Shield&r will use the wearers mana to repair itself."
	]
	quest.0CEB397B586BAECF.quest_subtitle: "A furnace is your first step into smelting, cooking, and refining basic materials"
	quest.0D043D35275D38FE.quest_desc: [
		"&l&cTouhou Little Maid&r&r"
		"Recruit helpful maids that can follow you, assist with tasks, and bring a little charm to your base."
		""
		"&7&lModular Golems&r&r"
		"Build custom golems from different materials and parts to create powerful companions for combat and utility."
		""
		"&6&lDoggy Talents Next&r&r"
		"Train loyal dogs with useful talents, giving them new abilities for travel, protection, and adventure."
		""
		"&b&lAlshanex's Familiars&r&r"
		"Summon magical familiars that travel with you and provide helpful abilities along the way."
	]
	quest.0D043D35275D38FE.quest_subtitle: "It's dangerous to go alone"
	quest.0D043D35275D38FE.title: "Intro to Pets"
	quest.0D51FF1724540430.quest_desc: [
		"&dSpell Turrets&r can be used to cast spells when given a redstone signal, functioning like a dispenser."
		""
		"&dSpell Turrets&r will accept spells that use &bTouch&r and &bProjectile&r."
		""
		"Spells may be set using an inscribed piece of &aSpell Parchment&r. "
		""
		"In order to cast spells, turrets will draw &9Source&r from nearby &9Source Jars&r."
		""
		"Turrets may use &bItem Pickup&r and &bPlace Block&r as long as an inventory is placed adjacent to this block."
	]
	quest.0D91534EFE74EF3E.title: "Boss Muffler"
	quest.0DC1F23419F38DAD.quest_subtitle: "The Ultimate Furnace Generator"
	quest.0DFC7CD04FC424F0.quest_desc: ["With a little &dArcane Essence&r you can turn boring &aLeather Armor&r into the &6Wandering Magician Armor&r. Tough as iron while granting bonus mana so you can cast more spells."]
