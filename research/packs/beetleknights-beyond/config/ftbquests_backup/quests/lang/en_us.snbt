	quest.13A3765D04280094.title: "Dune"
	quest.13D3F214D4713839.quest_desc: [
		"&6Hunter Familiar&r"
		""
		"&bBattle:&r specialized in attacking enemies with arrows, combined with swift moves."
		""
		"&bAbilities:&r"
		"&aWatcher:&r has the ability to protect the owner from enemies aiming at them, even if the owner has not noticed them."
		"&aSmelling Loot:&r the owner can right click them with any item to make them search for entities around that can drop the item, marking them for the owner to see."
		""
		"&bSpawn:&r can be found living in campsites all over forest biomes."
		""
		"&bFood:&r can be healed using wolf food."
	]
