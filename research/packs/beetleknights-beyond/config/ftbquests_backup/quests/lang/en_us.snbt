	quest.0E43A76A18BD28CA.quest_desc: ["A &6Flux Plug&r transfers energy into the &aFlux Network&r"]
	quest.0E43A76A18BD28CA.quest_subtitle: "Stick this on something that generates power"
	quest.0E6AF90548150E30.quest_desc: ["&6Framed Inventory Cable Connectors&r are the same as &dInventory Cable Connectors&r except that they can be hidden with a &bPaint Kit&r."]
