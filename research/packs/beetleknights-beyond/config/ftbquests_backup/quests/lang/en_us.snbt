	quest.7B2A6ACA6E409B58.quest_desc: [
		"&6&lIron Furnaces&r&r"
		"Upgrades the basic furnace into faster, stronger tiers that can smelt more efficiently as you progress."
	]
	quest.7B2A6ACA6E409B58.quest_subtitle: "25% Faster"
	quest.7B2A6ACA6E409B58.title: "Iron Furnaces"
	quest.7B4CCE4A0D45106F.quest_desc: [
		"&6Matter Network Pipes&r connect all your &dReplication&r machines in your &6Matter Network&r."
		""
		"They are capable of transferring &aMatter&r, &cPower&r, and even &eItems&r once you have a &bReplication Terminal&r."
	]
	quest.7B6ADA18EB886975.quest_desc: [
		"&6Bookwyrm Charms&r can be used on a &dStorage Lectern&r to increase the number of accessible inventories."
		""
		"Augment a &bRitual of Awakening&r with &aBook and Quills&r in order to obtain charms. "
		""
		"&6Bookwyrms&r can be dyed using white, &0black&r, &1blue&r, &2green&r, &4red&r, or &9purple&r dye."
	]
	quest.7B6ADA18EB886975.quest_subtitle: "Loyal Little Librarians"
	quest.7B707EF5D9494524.quest_desc: [
		"&6Illusionist Familiar&r"
		""
		"&bBattle:&r specialized in evocation magic, controlling enemies confusing them."
		""
		"&bAbilities:&r"
		"&aMagic Trick:&r when the owner has low health, illusionist will perform a magic trick that will hide their owner from the enemies."
		"&aDecoy:&r when they are low health, they will disappear leaving behind an explosive copy of them, taunting enemies around into attacking it."
		"&aPickpocket:&r when no one's watching and there are gold nuggets or emeralds on the floor, these little tricksters will take them for themselves."
		""
		"&bSpawn:&r illusionist spawn naturally disguised as other overworld familiars, use the &dMirror of Truth&r to make them reveal themselves."
		""
		"&bFood:&r can be healed using gold nuggets."
	]
	quest.7B707EF5D9494524.title: "Tame an Illusionist"
	quest.7B9BC64A58E69FAD.quest_subtitle: "Found in Woodland Mansions"
	quest.7BA010B2CCDF8319.quest_desc: [
		"The &6Command Wand&r is the single most important tool in &eModular Golems&r, second only to the golems themselves."
		""
		"This wand allows you to configure a golem’s &aCurios&r, adjust &bMovement Behavior&r, and access additional settings that control how each golem functions."
		""
		"Without it, most advanced golem customization and control is simply not possible."
		""
		"If golems are the muscle, the &6Command Wand&r is the brain."
	]
	quest.7BEE38842BD7B660.quest_subtitle: "Cast Tier 3 Glyphs"
	quest.7CB6433BA6140124.quest_desc: [
		"&6Scroll Forge&r is used to craft spells!"
		""
		"The &aInk&r used determines the rarity of the spell. The spell level will always be the lowest level of that rarity."
		""
		"You can not use an ink that is less rare than the minimum rarity of the scroll."
	]
	quest.7CB6433BA6140124.quest_subtitle: "Scroll Crafting"
	quest.7CB9E4917E0B328C.title: "Just Another Mining Dimension (End)"
	quest.7D7FA7C1A30FB4E9.title: "Ice Spider Den"
	quest.7ED8DAE89343A437.title: "Create"
	quest.7ED99487F76DFD5A.quest_subtitle: "20 Armor"
	quest.7ED99487F76DFD5A.title: "Diamond Armor"
	quest.7F2223226E1217B7.quest_desc: ["&6Time in a Bottle&r stores your playtime which can be used to accelerate the tick rate of blocks"]
	quest.7FE001F2CC40F793.quest_desc: [
		"&eGlyph Crafting:&r"
		"To craft a glyph place your &9Spell Book&r onto the &dScribe's Table&r select the glyph you want to create and provide the neccessary items. The &dScribe's Table&r will automatically pull from nearby chest."
		""
		"&eInscribing:&r"
		"Some equipment and items can be inscribed with a spell. To inscribe a spell place the equipment or item on a &dScribe's Table&r and cast the spell you want inscribed onto the &dScribe's Table&r."
	]
	quest.7FE001F2CC40F793.quest_subtitle: "Glyph Crafting and Inscribing"
