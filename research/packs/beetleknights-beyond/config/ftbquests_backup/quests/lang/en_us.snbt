	quest.76EBE7719CDBDDB6.title: "Witch Armor"
	quest.7722E4B4437387BD.title: "The Farmer"
	quest.77A70A60A73355E8.quest_desc: [
		"&6Summoner Familiar&r"
		""
		"&bBattle:&r specialized in eldritch magic and unknown arts, being able to summon creatures born in the shadows."
		""
		"&bAbilities:&r"
		"&aTrue Vision:&r has the ability to give night vision to the owner, in addition to making them immune to blindness and darkness effects."
		"&aDark Ritual:&r has the ability to deactivate Sculk Shriekers, hiding the owner from the warden."
		""
		"&bSpawn:&r can be found studying dark arts in their laboratory, located in the Ancient City."
		""
		"&bFood:&r can be healed using ancient knowledge fragments."
	]
	quest.77A70A60A73355E8.title: "Tame a Summoner"
	quest.782D13EDDB34AED4.quest_desc: [
		"&6Necromancer Familiar&r"
		""
		"&bBattle:&r specialized in blood magic, including necromancy abilities to summon the undead."
		""
		"&bAbilities:&r"
		"&aUndead Chaos:&r has the ability to make undead entities around go in a rampage, attacking nearby entities in confusion."
		"&aWitherify:&r has the ability to turn nearby skeletons into wither skeletons."
		""
		"&bSpawn:&r can be found studying the death in graveyards all over the Soul Sand Valleys."
		""
		"&bFood:&r can be healed using bones or blood vials."
	]
	quest.782D13EDDB34AED4.title: "Tame a Necromancer"
	quest.789AE1BC2CB2B89E.title: "Wither? I Hardly Know Her"
	quest.78CDE4A36A53C648.quest_desc: [
		"The &cPower Point&r is an important resource for &dAltar&r crafting."
		""
		"When you hold a &bGohei&r, you can see your &cPower Point&r amount in the upper left corner of the screen."
		""
		"The maximum amount of &cPower Points&r is 5, and getting more will not increase the amount."
		""
		"The &6Little Maids&r can pick up &cPower Points&r to repair all items in their inventory with the &aMending&r enchantment."
	]
	quest.78CDE4A36A53C648.title: "Touhou Little Maids"
