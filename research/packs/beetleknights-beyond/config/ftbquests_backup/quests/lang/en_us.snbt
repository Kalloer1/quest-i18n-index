	quest.3D627696DF803530.title: "Home Limit Upgrade 4"
	quest.3D80AB4323A72D67.quest_desc: [
		"&6FTB Essentials&r adds useful commands such as,"
		""
		"&b/sethome&r &e(home name)&r - Saves your current position as a teleport target"
		""
		"&b/home&r &e(home name)&r - Teleports the player to their saved home location"
		""
		"&b/delhome&r &e(home name)&r - Deletes a saved home location"
		""
		"&b/listhomes&r - List all saved homes"
	]
