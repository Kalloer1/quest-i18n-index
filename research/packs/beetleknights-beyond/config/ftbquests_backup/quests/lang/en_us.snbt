	quest.63AE3D21125D96FC.quest_desc: [
		"&6Familiar House&r can store up to 10 familiars."
		""
		"&6Familiar House&r has two modes:"
		"&aStore&r - lets you move familiars between yourself and the &6Familiar House&r."
		""
		"&aWander&r - Stored familiars will wander around the &6Familiar House&r within a set range up to 25 blocks."
		""
		"The &6Familiar House&r can only be broken in Store mode with no familiars stored."
	]
	quest.63CA882A424F973F.quest_desc: [
