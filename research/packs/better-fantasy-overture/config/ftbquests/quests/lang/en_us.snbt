	quest.0E0064BFC6DA61BF.quest_desc: [
		"&6Resource Crops&r planted on &aEssence Farmland&r will have a 10% chance to drop an additional seed. If they are planted on the corresponding &btier&r of farmland then they will have a 20% chance to drop an additional seed."
		""
		"&6Inferium Crops&r planted on &aEssence Farmland&r will have increased &aInferium Essence&r output. Each tier of farmland adds +50% to the base drop rate of 100%."
	]
	quest.0E0064BFC6DA61BF.quest_subtitle: "&aInferium Farmland&r works just like regular Farmland with some additional benefits for &6Resource Crops&r."
	quest.0E0064BFC6DA61BF.title: "&aInferium Farmland&r"
