	quest.10666466F589AF21.quest_desc: [
		"To use the &6Enchanting Apparatus&r, place any number of &6Arcane Pedestals&r within 3 blocks with their items."
		""
		"Once you have filled the pedestals, use the middle item on the &6Enchanting Apparatus&r block."
