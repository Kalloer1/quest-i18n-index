	quest.1311D56D9ED4AD74.quest_desc: [
		"&6The Mechanical Harvester will harvest all mature crops it comes in contact with while moving forward.&r"
		""
		"&6It will then either deposit the items to an inventory on the Contraption or, if no inventories are available&r, it will drop the items on to the ground. &6After harvesting, the plants will be reset to their initial growth state.&r"
	]
	quest.1311D56D9ED4AD74.quest_subtitle: "The Mechanical Harvester is a component used on Contraptions to harvest crops."
	quest.1311D56D9ED4AD74.title: "&6Mechanical Harvester&r"
	quest.132C8EF9E80579E1.quest_desc: [
		"The &bMeteorite Compass&r points at the nearest &6Mysterious Cube&r, which thus points it at the &6nearest meteorite&r. It's one of the first &bAE2 items&r you should make."
		""
		"In your looting of a &6meteorite&r, you will have found four \"presses\" from breaking the &6Mysterious Cube&r. These are used in the &bInscriber&r to make the &6three types of processor&r."
	]
	quest.132C8EF9E80579E1.quest_subtitle: "Inscribing Some Processors"
