	quest.23247F87FE856E0D.quest_subtitle: "Tier 1"
	quest.232A0EC7F1AF985B.quest_desc: [
		"&6Scylla has a total of 390 health points and 12 armor points. The battle takes place in multiple phases, which depend on her health levels.&r As her health decreases, her attacks grow more powerful, and she gains access to new attack options."
		""
		"&6Scylla primarily attacks using electrocution, and most of her moves inflict this type of damage.&r If the player is affected by the wetness effect, the damage is amplified, which can quickly turn the fight in her favor."
		""
		"&6In the fight, Scylla primarily uses her anchor as a weapon. She employs it for melee attacks and can pull the player closer, preventing their escape before delivering a powerful blow.&r Scylla can execute this attack from both the ground and the air."
	]
	quest.232A0EC7F1AF985B.quest_subtitle: "Scylla is my favorite Boss."
	quest.232A0EC7F1AF985B.title: "&bYou Are Very Terryfing!&r"
	quest.232F8F10F330A344.quest_desc: ["Deep Aether Content."]
	quest.232F8F10F330A344.quest_subtitle: "Nothing special..."
	quest.232F8F10F330A344.title: "Skyjade? What is it?"
	quest.2359673EC4BE010E.title: "&6Creaking Sorcerer Armor Set&r"
	quest.2390A943C6ECA610.quest_desc: [
		"&6Generates source&r by consuming potions from adjacent &6potion jars&r. "
		""
		"The amount of source varies per potion and is dependent on the complexity of the potion."
		""
		"&6Bonus source&r is given for the length and level of the potion with multipliers for each effect a potion contains. "
		""
		"Utilizing &6Wixies&r and &6Potion Melders&r is recommended for creating &6highly complex potions&r."
	]
	quest.2390A943C6ECA610.title: "&6Alchemical Sourcelink&r"
	quest.23B3CEEBC36255FD.quest_subtitle: "Tier 1"
	quest.23BC415BDA189561.quest_desc: [
		"A &6Wind Turbine's&r giant blades harness the force of the wind &6to generate power&r. "
		""
		"Each &6Wind Turbine&r requires a small 1x5x1 area. This block will generate the same power day and night, in sun or rain, but the turbine must have a clear view of the sky (over the rotor housing at the top of the tower)."
	]
	quest.23BC415BDA189561.title: "&bMy Favorite Block!&r"
	quest.23DA367960D08B49.quest_desc: [
		"&6Archwood Logs&r are the sturdy, magical timbers harvested from the vibrant Archwood trees found throughout the world."
		""
		"Infused with natural mana, these logs shimmer with colors corresponding to their type—&6Cascading&r, &6Flourishing&r, &6Blazing&r and &6Vexing&r."
		""
		"They serve as the foundational material for &6magical construction&r, crafting basic tools, and are the primary source for creating &6Archwood Planks&r and other arcane wooden components."
	]
	quest.23DA367960D08B49.quest_subtitle: "i bet you will find the biome"
	quest.23DA367960D08B49.title: "&dGetting New Materials!"
	quest.23DE4C945CC7860C.title: "&6Epic Ink&r"
	quest.23E23CC3F14AF05F.quest_subtitle: "better than other shield...?"
	quest.246AF09996C71B08.quest_desc: [
		"&6Used to craft scrolls.&r "
		""
		"&6The ink used determines the rarity of the spells.&r "
		""
		"The level will always be the lowest level of that rarity. "
		""
		"You cannot use an ink that is less rare than the minimum rarity of the scroll."
	]
	quest.246AF09996C71B08.quest_subtitle: "I need some crying obsidian"
	quest.246AF09996C71B08.title: "&6The Scroll Forge&r"
	quest.24E24AC70A6E97B8.quest_desc: ["Capacitors are &6essential for building basic reactors&r and &6upgrading energy infrastructure&r to higher tiers, such as &6Hardened&r."]
	quest.24E24AC70A6E97B8.title: "&fBasic Capacitor (Tiny)&r"
	quest.25199F5549CB2337.quest_subtitle: "I'll be generous, I guess..."
	quest.25199F5549CB2337.title: "&6All this with Looting III?&r"
