	quest.474E58379AC69CEF.quest_desc: [
		"&6To extend the Pistons must have Piston Extension Poles at the end as well as Rotational power.&r"
		""
		"&6When the rotation is reversed, the piston will retract.&r The end must be made sticky with a Slimeball to bring the pushed blocks back with it."
		""
		"&6A placed Mechanical Piston can be made sticky by right-clicking it with a Slimeball.&r"
		""
		"Multiple blocks can be pushed with the use of Block Attachment Utilities."
	]
	quest.474E58379AC69CEF.quest_subtitle: "These Mechanical Pistons can push Contraptions when powered with Rotational Power."
