	quest.32B7B1428678A353.quest_desc: [
		"&6Linear Chassis will automatically connect to adjacent and equally aligned chassis.&r "
		""
		"&6Slime Balls or Super Glue are needed to connect a column of other blocks to either of their piston-like surfaces.&r The Slime or Super Glue is not consumed on use. "
		""
		"A Wrench can be used to adjust the size of the column by hovering over the side and scrolling. "
		""
		"&6Hold ctrl with a Wrench to adjust all connected Chassis at once.&r "
		""
		"A Clipboard can also be used to view, copy, and paste the chassis' settings."
	]
	quest.32B7B1428678A353.quest_subtitle: "The Linear Chassis is one method of connecting up Contraptions."
	quest.32B7B1428678A353.title: "&6Linear Chassis&r"
