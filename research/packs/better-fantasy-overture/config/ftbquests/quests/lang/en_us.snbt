	quest.11704010861CDB9E.quest_desc: ["When connected to a component, &6the speed of the rotation is shown by a hand on the face of the Speedometer.&r The higher the hand is, the faster the rotation. &6By using Engineer's Goggles, this speed is quantified with a number.&r"]
	quest.11704010861CDB9E.quest_subtitle: "The Speedometer measures the speed of Rotational Force."
	quest.11704010861CDB9E.title: "&6Speedometer&r"
	quest.11AF47DB4B083A50.quest_desc: [
		"While held, &6funnels prevent the player from accessing inventories&r, instead placing them."
		""
		"&6Sneak right clicking with a Funnel places it in input mode.&r"
		""
		"Right-clicking a funnel on a Mechanical Belt causes it to extend one block forward."
		""
		"When attached to a Contraption, Andesite Funnels can drop items from the contraption's inventory or pick up items that collide with it."
	]
	quest.11AF47DB4B083A50.quest_subtitle: "The Andesite Funnel is used to extract or insert materials into inventories"
	quest.11AF47DB4B083A50.title: "&6Andesite Funnel&r"
