	quest.3ECF69B1A44C8462.title: "&9Another Smithing Template?&r"
	quest.3ED8A2DC86906211.quest_desc: [
		"The &6Chemical Dissolution Chamber&r is the first machine in the x5 ore processing setup. "
		""
		"It turns raw ores into slurry using &6Sulfuric Acid&r. "
		""
		"The machine uses 100 mB of sulfuric acid for every ore dissolved and outputs 1000 mb of slurry. "
		""
		"This slurry needs washing in the &6Chemical Washer&r. It is also used in the production of &6Fissile Fuel&r."
	]
	quest.3ED8A2DC86906211.title: "&bChemical Dissolution Chamber&r"
