	quest.36EA935E79F14E5C.title: "&bTo The Skyyyyyyy"
	quest.374364025001E441.title: "&6Seraph Visor Armor Set&r"
	quest.3760206370B72347.quest_subtitle: "remember that ATM stands for AllTheModium."
	quest.3760206370B72347.title: "&6What is your Favorite ATM Magic?&r"
	quest.376A9B97D9FC94A9.quest_desc: [
		"&6The staff is used by right-clicking on a tamed dragon in order to choose a command.&r "
		""
		"There are 3 action:"
		""
		"&6Escorting: The tamed dragon follows you around, from stage 2, they fly in circles as you walk instead of walking themselves.&r"
		""
		"&6Staying: The tamed dragon sits down and doesn't leave its place until clicked on again.&r"
		""
		"&6Wandering: The tamed dragon is free to wander wherever they go, however it won't leave its home position.&r The home position is set by holding shift and right-clicking on the dragon - the same way, it can be removed and changed."
	]
	quest.376A9B97D9FC94A9.quest_subtitle: "Make sure to Hatch a Dragon Egg before crafting this staff."
	quest.376A9B97D9FC94A9.title: "&6Listen To Me!&r"
	quest.37A1512C5AC14EBB.quest_subtitle: "ATM stands for AllTheModium"
	quest.37A1512C5AC14EBB.title: "&6Do You Believe in ATM Magic?&r"
	quest.37D44EA755334D5F.quest_subtitle: "After defeating Ender Dragon, you can proceed to find the Ender Guardian that resides in the Ruined Citadel."
	quest.37D44EA755334D5F.title: "&5BetterEnd Phase&r"
	quest.37F6D495BF259849.quest_subtitle: "Tier 6"
	quest.381990269F1D82FA.quest_desc: [
		"The &6Archmage's Spell Book&r is the ultimate grimoire for those who have reached the pinnacle of magical mastery."
		""
		"It possesses a massive &6mana capacity&r and the fastest possible &6regeneration&r, allowing for the near-constant use of high-level sorcery."
		""
		"By unlocking &6Tier 3 Glyphs&r, it grants access to the most devastating and reality-bending &6spells available&r, cementing the wielder's status as a true master of the arcane."
	]
	quest.381990269F1D82FA.quest_subtitle: "Glad you made it!"
	quest.381990269F1D82FA.title: "&dI Can Do Everything Now!"
	quest.3841230F70751AA9.quest_subtitle: "Tier 2"
	quest.3848FC81356FDCCA.quest_desc: ["&6Note that Ignis is important for the Storyline Progression.&r"]
	quest.3848FC81356FDCCA.quest_subtitle: "You can find Netherite Monstrosity and Ignis in BetterNether."
	quest.3848FC81356FDCCA.title: "&cBetterNether Phase&r"
	quest.38B476E2D05CEF32.quest_desc: [
		"&bProcessors&r are one of the &6primary ingredients in AE2 devices and machines&r. "
		""
		"They are also one of your &6first big automation&r challenges. "
		""
		"There are three &btypes of processor&r, made with gold, Certus Quartz Crystal, and diamond respectively. "
		""
		"They are made using presses in an &6Inscriber&r, in a multi-step process (usually achieved via a series of inscribers and filtered piping)."
	]
	quest.38B476E2D05CEF32.quest_subtitle: "Logic, Calculation, Engineering and...?"
	quest.38B476E2D05CEF32.title: "&bProcessors!&r"
	quest.393E5CF0897CA78D.quest_desc: ["You can't use &bEnder Eyes&r to find the &6Stronghold.&r"]
	quest.393E5CF0897CA78D.quest_subtitle: "are you really going to craft ender eyes using blaze powder?"
	quest.393E5CF0897CA78D.title: "&6This is not Vanilla&r"
	quest.394969E7F382BD3B.quest_subtitle: "Tier 2"
	quest.398339D6403FBCFC.quest_desc: [
		"&6Right-click the front of a Mechanical Crafter with a Wrench to change the direction it sends items during crafting.&r The Mechanical Crafters are only connected by this path."
		""
		"Mechanical Crafters &6can be automatically filled by Funnels or Hoppers&r."
		""
		"&6On the back and sides of Mechanical Crafters, a Wrench can be used to connect or disconnect the inventory of two adjacent crafters.&r Crafters can share inventories while not participating in the same crafting recipe."
		""
		"Items can also be inserted or removed by hand."
	]
	quest.398339D6403FBCFC.quest_subtitle: "Mechanical Crafters are machines that can automatically craft items."
	quest.398339D6403FBCFC.title: "&6Mechanical Crafter&r"
	quest.3991D006ED828F01.quest_desc: [
		"&6Osmium is one of the most important materials&r that is used to craft important functional blocks!"
		""
		"You can also check every content of Mekanism in JEI!"
