	quest.134A1A2BCCFAD076.quest_desc: [
		"The &6Metallurgic Infuser&r is used to infuse one substance into another. "
		""
		"It is an important machine because it produces components which are required for other machines and items. "
		""
		"For example, it transforms Iron Ingots into &6Enriched Iron and further into Steel using Coal&r. The machine is also used as a component to craft the &6Basic Infusing Factory&r."
	]
	quest.134A1A2BCCFAD076.title: "&bMettalurgic Infuser&r"
	quest.135522226FEF0412.quest_desc: [
		"&6The Spout can be filled with up to 1 bucket of any one liquid via Fluid Pipes&r, and it will empty some of &6its fluid onto compatible items that pass under it via a Conveyor Belt or Depot.&r "
		""
		"The spout takes 1 second to process an item regardless of the amount of fluid used, though delay between fills may be caused by the time it takes the spout to fill back up."
	]
	quest.135522226FEF0412.quest_subtitle: "The Spout is used for filling liquid containers such as bottles or buckets, or crafting with liquids."
	quest.135522226FEF0412.title: "&6Spout&r"
