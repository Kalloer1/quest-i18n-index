	quest.1860F6130AF155E8.quest_desc: [
		"&6Blaze Cake can be used to feed the Blaze Burner, making it Super-Heated.&r "
		""
		"The Blaze &6becomes Super-Heated for 160 seconds.&r It then turns into standard blaze, lasting for 250 seconds. Finally, the Blaze becomes smoldering, and does not provide any heat."
		""
		"This special cake is needed to get the &6&lZaka Star&r."
	]
	quest.1860F6130AF155E8.quest_subtitle: "Blaze Cake is used to fed a Blaze Burner in order to make it Super-Heated."
	quest.1860F6130AF155E8.title: "&6&lMy Favorite Cake!&r"
