	quest.6A640ADE0D558BD5.quest_desc: ["Well, I always wanted to celebrate &6Halloween&r in my life and this is the only way to celebrate it since in &6Italy&r, it doesn't do nothing except receiving kids at the door of your house asking for &6Trick or Treat?&r"]
	quest.6A640ADE0D558BD5.quest_subtitle: "BOOOOOOO"
