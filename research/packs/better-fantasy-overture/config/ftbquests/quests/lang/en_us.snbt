	quest.2F823F3824F5E708.quest_desc: [
		"&6Basic Universal Cable&r transmits energy between energy producers, storage blocks and energy consumers. "
		""
		"It is the lowest tier of cables provided by &bMekanism&r, with the lowest transfer rate and can transfer all supported forms of energy (RF, Tesla, Energy Units and MJ) between all associated machines. It is also used to craft the next tier of cable, the &6Advanced Universal Cable&r."
	]
	quest.2FC21251EDCA60A4.quest_desc: [
		"&6Placing a Belt requires at least two Shafts.&r "
		""
		"&6Place the Belt by right-clicking on the first shaft and then right clicking the second.&r "
		""
		"Regardless of the length, this only consumes one mechanical belt. &6Both shafts must face the same direction.&r"
