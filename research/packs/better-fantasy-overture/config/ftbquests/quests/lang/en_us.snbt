	quest.3FC6AFFF48F8F39D.title: "&dDiscover a BetterEnd City!"
	quest.3FD15003308E6D82.quest_desc: [
		"&bNether Reeds&r it spawns near lava and looks kinda like &6Blue Sugarcane&r."
