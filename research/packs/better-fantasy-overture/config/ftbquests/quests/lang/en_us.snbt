	quest.529BD3EA860C228D.quest_desc: ["The &aEnergizing Rod&r acts as a laser conduit, requiring power input from cables, and can be upgraded across several tiers (starter to nitro) for faster, more efficient energy transfer."]
	quest.52B048B2959D4E90.quest_desc: [
