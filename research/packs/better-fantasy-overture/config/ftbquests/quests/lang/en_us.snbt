	quest.477F2393A310EE1A.quest_subtitle: "There are only 2 dungeons in the BetterNether"
	quest.479820850DCF65FD.quest_desc: [
		"&6Ignis begins the battle with 450 Health Points, 10 Armor Points, and a base damage output of 14 points per attack.&r "
		""
		"The boss uses a unique damage scaling system that inflicts additional damage based on a percentage of the player’s maximum health."
		""
		"This mechanic ensures that even heavily armored players cannot simplify the encounter through defensive preparation alone. "
		""
		"&6The entity possesses a life-stealing ability&r that triggers upon landing successful sword attacks, replenishing its own vitality during combat."
	]
	quest.479820850DCF65FD.quest_subtitle: "You VS Ignis. Good Luck."
	quest.479820850DCF65FD.title: "&6Surely I'll Defeat You!&r"
