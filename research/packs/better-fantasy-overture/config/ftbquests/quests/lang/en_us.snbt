	file.0000000000000001.title: "&b&lMultiverse: Overture"
	quest.001324684DC4F1D2.quest_subtitle: "With the End Stone Smelter. you will be able to get Aeternium Ingot. Get Netherite and Terminite ingots and a Lava Bucket."
	quest.001324684DC4F1D2.title: "&dI need to cook now..."
	quest.002324950051A64E.quest_subtitle: "In this Arena resides the main Boss for proceed with the Storyline Progression."
	quest.002324950051A64E.title: "&6Storyline: The Burning Arena!&r"
	quest.002CF9E977616D2A.quest_desc: [
		"Welcome to &aPUAH!&r or... Uhm- &aPowah!&r"
		""
		"&aPowah&r is primarily focused on generating, storing, and transporting Forge Energy (FE/RF) across seven tiers, ranging from starter to &cNitro&r. "
		""
		"&6It provides diverse, upgradeable power solutions&r, including fuel-based Furnators, lava-fed Magmators, heat-based Thermo Generators, Solar Panels, and high-output Nuclear Reactors."
	]
	quest.002CF9E977616D2A.quest_subtitle: "Powah Powah Powah Powah Powah"
	quest.002CF9E977616D2A.title: "&aPowah&r: &fIntroduction!&r"
	quest.009B3DA51E6D36DC.quest_desc: [
		"You can play &6Cataclysm&r as you like it. "
		""
		"If you want to proceed with the main &6Storyline&r, you have to defeat Ignis and obtain a full &6Ignitium Set&r to upgrade it to &6AllTheModium&r. "
		""
		"This phase is important because it allows you to obtain as much protection as possible to face evert enemies of this Journey."
	]
	quest.009B3DA51E6D36DC.quest_subtitle: "If you're here, then it means you are doing a good work. One more Step."
	quest.009B3DA51E6D36DC.title: "&6Cataclysm before AllTheModium&r"
	quest.00CB3F86C4D84CED.quest_subtitle: "Can be found in BetterEnd after defeating the EnderDragon."
	quest.00CB3F86C4D84CED.title: "&dFind an Abandoned Village"
	quest.00E1A562304E82FE.quest_desc: [
		"&6Harvesters&r require &benergy&r to function. You can either provide energy via any &bForge Energy&r compatible energy transfer, or use the internal solid-fuel based generator."
		""
		"Once placed, the &6harvester&r will harvest a 3x3 area of crops in front of it. To increase the range of the Harvester, you can install a &6Machine Upgrade&r. Upgrades will also increase operation speed and internal energy storage capacity."
		""
		"The &6harvester&r can be disabled at any time with a &cRedstone signal&r."
	]
	quest.00E1A562304E82FE.quest_subtitle: "The &6Harvester&r is a machine that will auto-harvest crops and re-plant them. Items collected by the Harvester are placed into it's internal inventory."
	quest.010A95DDC3809E56.quest_desc: ["Requiring a special &4Soulium Seed Base&r and a filled &6Soul Jar&r of the target mob, obtained by killing them with a &4Soulium Dagger&r or using a &4Soul Extractor&r. They allow exponential growth of mob-related resources, but need &4Nether&r materials (Soulium) and specific mob soul collection, unlike basic resource seeds."]
	quest.010A95DDC3809E56.quest_subtitle: "&bMob Seeds&r let you farm specific mob drops (like &6Blaze Rods&r, &cRotten Flesh&r, &8Gunpowder&r) by growing crops on &aEssence Farmland&r."
	quest.010A95DDC3809E56.title: "Mob Seeds"
	quest.0110EBB9F9F58E52.quest_desc: [
		"The &6Novice Spell Book&r is your primary tool for entry into the world of magic. "
		""
		"It &6allows you&r to store, manage, and cast basic spells by combining various Glyphs."
		""
		"As a foundational item, it has a &6limited mana capacity&r and can only hold &6Tier 1 spells&r, making it the essential first step for any aspiring mage looking to manipulate the arcane."
	]
	quest.0110EBB9F9F58E52.quest_subtitle: "Can you imagine how much fun is Ars Nouveau?"
	quest.0110EBB9F9F58E52.title: "&dFirst Spell Book!"
	quest.017EA4167D0B2602.title: "&6Uncommon Ink&r"
	quest.01A2E7AEF02672AF.quest_desc: [
		"The &dRefined Obsidian Ingot&r is an ingot created by placing &6Refined Obsidian Dust&r into an &6Osmium Compressor&r fueled with Liquid Osmium (from Osmium Ingots)."
		""
		"Instead, the &6Glowstone Ingots&r are made by putting Glowstone in a &6powered Osmium Compressor&r with Glowstone in the top and &6Osmium Ingots&r in the bottom. Glowstone Ingots can be used for making Refined Glowstone blocks and &6Teleporter Frames&r."
	]
	quest.01A2E7AEF02672AF.quest_subtitle: "Other ingots wow"
	quest.01A2E7AEF02672AF.title: "&6Some Refined Ingots!&r"
	quest.01A474C138DBDFCB.title: "&6Cincinnasite armor set!&r"
	quest.01B20FE8484559DE.quest_desc: [
		"&aInferium Essence&r is used to craft many of the core items in the mod, including &6Resource Seeds&r, &6Essence Tools&r and &6Essence Armor&r."
		""
		"It can also be converted into higher &dtier essences&r using an &6Infusion Crystal&r, allowing you to create higher tiered seeds, tools and armor."
	]
	quest.01B20FE8484559DE.quest_subtitle: "&aInferium Essence&r is one of the key materials needed to craft &5Mystical Agriculture&r blocks and items."
	quest.01B20FE8484559DE.title: "&aInferium Essence&r"
	quest.01C3C18768714810.quest_desc: [
		"The &bMEGA Bulk Storage Cell&r provides &6near-infinite storage capacity&r for a &6single item type&r. "
		""
		"Designed for &6high-volume storage&r, these cells use a partitioning system to hold millions or billions of a specific item, often utilized in &6end-game&r setups to reduce lag compared to massive drawer arrays. "
	]
	quest.01C3C18768714810.quest_subtitle: "this is my favorite storage cell........."
	quest.01C3C18768714810.title: "&bMEGA Bulk Item Storage Cell&r"
	quest.01CCD9B39AD54694.title: "&6Tablet of Scrying&r"
	quest.022EABE0E328E108.quest_desc: ["                    1250 HP"]
	quest.022EABE0E328E108.quest_subtitle: "Can be easily found in Snow biomes"
	quest.022EABE0E328E108.title: "&bCold Eye"
	quest.025627F60E36E96F.quest_desc: [
		"&6Brass Tunnels may be used on mechanical belts:&r "
		""
		"&6- Splitting streams of items to multiple destinations.&r "
		""
		"&6- Sorting streams of items and combining multiple streams of items.&r "
		""
		"Each tunnel can have an input or output portal on each of its four sides in a variety of combinations. "
		""
		"&6The status of being an input or output depends purely on the direction of the belt touching a given side.&r A tunnel must straddle a belt, thus forcing at least one input and one output on opposite sides. "
		""
		"The other two sides may have belts abutting the tunnel forming either input or output portals."
	]
	quest.025627F60E36E96F.quest_subtitle: "A Brass Tunnel is a machine that can only be placed on Mechanical Belts."
	quest.025627F60E36E96F.title: "&6Brass Tunnel&r"
	quest.02B648D188AD9A95.quest_desc: [
		"The &b16M MEGA Storage Component&r is a &6high-capacity storage item&r, designed for storing &6vast quantities&r (16 million bytes) of a single item or limited item types. "
		""
		"It acts as a &6massive upgrade&r over &6standard 64k AE2 components for bulk storage&r, often requiring advanced materials like &6singularities&r to craft. "
	]
	quest.02B648D188AD9A95.quest_subtitle: "16M Storage"
	quest.02B648D188AD9A95.title: "&b16M MEGA Storage Component&r"
	quest.02D1F84396133F5D.quest_desc: ["Mine some &6Cincinnasite ores&r and put it into a Furnace."]
	quest.02D1F84396133F5D.quest_subtitle: "It really seems a gold ingot"
	quest.02D1F84396133F5D.title: "&6It looks like Gold...&r"
