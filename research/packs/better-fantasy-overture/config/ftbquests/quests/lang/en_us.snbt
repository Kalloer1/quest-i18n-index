	quest.667DC00B86B29515.quest_subtitle: "Tier 3"
	quest.66A64CAA54E080ED.quest_desc: [
		"As an ore-doubler, the &6Enrichment Chamber&r can be used by itself or as a part of the Mekanism ore processing system. It is also used as a component to craft the &6Purification Chamber&r and &6Pressurized Reaction Chamber&r."
		""
		"The &6Enrichment Chamber processes various materials&r depending on the tier of the ore-processing system. "
		""
		"Furthermore it has some &6unique recipes&r for different materials from other mods. "
		""
		"For example it can craft &bPure Certus Quartz Crystal&r from &bCertus Quartz Crystal from AE2&r."
	]
	quest.66A64CAA54E080ED.title: "&bEnrichment Chamber&r"
	quest.66D288301465D29A.quest_desc: ["This isn’t the typical Minecraft Vanilla experience. The hostile mobs you’ll find in &bBetter Fantasy: Overture&r are far from normal..."]
	quest.66D288301465D29A.title: "&bThis is not Vanilla&r"
	quest.66F41FCBAFA1A69E.quest_subtitle: "Tier 2"
	quest.6701E4BE04F96CED.quest_subtitle: "You just need to collect Dragon Bricks for every Dragonforge block. Don't forget to also take the dragon blood."
	quest.6701E4BE04F96CED.title: "&6This Works like a Furnace!&r"
