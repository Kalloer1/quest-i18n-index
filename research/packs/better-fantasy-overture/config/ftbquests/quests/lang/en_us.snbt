	quest.11C573303E502783.quest_desc: [
		"&bEnergy cells&r give a network more &6energy storage&r. "
		""
		"Some amount of energy buffer helps to smooth out spikes in energy draw when &6large amounts&r of items are inserted or extracted, and larger amounts of &6energy storage&r allow the network to run while energy isn't being generated (like at night with solar panels) or handle the massive instantaneous energy draw of &6spatial storage&r."
	]
	quest.11C573303E502783.quest_subtitle: "More Energy"
	quest.11C573303E502783.title: "&bEnergy Cells&r"
