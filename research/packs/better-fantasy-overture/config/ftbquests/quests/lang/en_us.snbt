	quest.3301B7C5EEBA4BB1.quest_subtitle: "Tier 5"
	quest.33224FD3CD3094D2.quest_desc: [
		"&l&bWelcome to Applied Energistics 2 (also known as AE2 or simply AE)&r "
		""
		"- This mod adds components and mechanics to provide &6logistics&r and &6storage solutions&r. "
		""
		"You can replace your massive room full of chests with a compact &6ME Network&r, but that's just the beginning of things. "
		""
		"&bApplied Energistics&r is meant to work with and allow &6automation&r. "
		""
		"You can &6set up your system&r to, with a single click, craft all of the prerequisites (and the final result) of a &6complex crafting chain&r, or keep certain quantities of &6items in stock&r, crafting more as needed, or &6simply transfer items around your base&r."
	]
	quest.33224FD3CD3094D2.quest_subtitle: "Infinity Storage..."
	quest.33224FD3CD3094D2.title: "&l&bApplied Energistics 2&r"
