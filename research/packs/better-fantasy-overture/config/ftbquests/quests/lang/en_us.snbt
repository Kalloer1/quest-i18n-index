	quest.678B9A12D7BB0EAF.quest_desc: [
		"&bThe Charger&r is used to create &bCharged Certus Quartz&r by &6consuming power&r, or to charge tools like the &6Charged Staff&r. &6It accepts energy (AE/FE)&r from the top/bottom or can be operated manually using a &6Wooden Crank&r."
		""
		"&bThe Inscriber&r is used to create &6processors&r (logic, engineering, calculation) and &6printed silicon by pressing materials&r with specific press plates. "
		""
		"It features 3 input slots (top, center, bottom) and 1 output, allowing automation via pipes/hoppers or &bME systems&r.  "
	]
	quest.678B9A12D7BB0EAF.quest_subtitle: "FE stands for Forge Energy"
	quest.678B9A12D7BB0EAF.title: "&bCharger and Inscriber&r"
