	quest.343B4F17D3F10179.quest_desc: [
		"&bPolymorphic Item Filter:&r Allows smart, dynamic sorting by only permitting items to enter a container if that specific item type is already present inside. It is used within Inventory Cable Connectors or Basic Inventory Hoppers to automatically organize storage, adapting to contents."
		""
		"&6Tag Item Filter:&r It is used within Inventory Hoppers or cables to filter items based on their ore dictionary tags rather than specific item IDs. It allows for advanced automation, such as sorting all wooden logs into one chest regardless of type, by placing it into the filter slot of a connector. "
	]
	quest.343B4F17D3F10179.quest_subtitle: "Read Description"
	quest.343B4F17D3F10179.title: "&6Other Item Filters&r"
