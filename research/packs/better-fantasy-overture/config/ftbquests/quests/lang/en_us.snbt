	quest.75E9C6D376A7D673.quest_desc: [
		"&6Chutes can extract items from inventories or belts immediately above them and insert or deposit items on inventories or belts below them.&r "
		""
		"&6Chutes will also collect items that fall upon them and will drop items into empty space if an inventory&r is not immediately below them. "
		""
		"Chutes may be stacked either pure vertically or in a vertical diagonal to form a pipe for moving items."
		""
		"&6And Smart Chutes allow the player to control the types of items passed and their stack size.&r"
	]
	quest.75E9C6D376A7D673.quest_subtitle: "Chutes transport items vertically, generally downward unless an encased fan is used to blow items upward."
	quest.75E9C6D376A7D673.title: "&6Chutes&r"
