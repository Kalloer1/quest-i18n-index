	quest.4109FBDE394B56B5.quest_desc: [
		"&6Pressurized Tubes&r are used to transport &6Gases&r. "
		""
		"Similar to their mechanical counterparts, they can be upgraded to higher tiers to increase the flow rate and capacity of pumped gases. "
		""
		"The &6Pump Rate&r limitation declared in the tooltip only regards the active pumping. "
		""
		"The &6Pipe can take in more if the Device can output itself&r and there is enough buffer in the network."
	]
	quest.411C5858B43101F7.quest_desc: ["&6HDPE Sheet&r is an ingredient used to create &6Plastic Blocks&r and &6Glow Panels&r."]
	quest.411C5858B43101F7.title: "&fHDPE Stuff&r"
	quest.411DDDED11008327.quest_subtitle: "Used to craft Ice Spells"
	quest.411DDDED11008327.title: "&6Frozen Bone&r"
	quest.4122ED3F41B4EA29.quest_desc: [
		"Cables are used to transfer power between machines... We already know that..."
		""
		"You can also change transfer mode of by right-clicking a cable using Wrench with Config mode selected."
	]
	quest.4122ED3F41B4EA29.quest_subtitle: "do you like cables right?"
	quest.4131614A6462650C.quest_subtitle: "This might help you fight the Ender Guardian, maybe."
