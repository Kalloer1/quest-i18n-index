	quest.4D38870AC550DDFF.title: "&dThere it is! Crystalite Protection!"
	quest.4D77CD6C097F72D7.quest_subtitle: "You can use the Sun Altar to change the weather and the time of day to your liking."
	quest.4D77CD6C097F72D7.title: "Obtain a Sun Altar"
	quest.4D83B67CBCF2688A.quest_desc: [
		"The &bCell Workbench&r allows you to &6configure storage cells&r and View Cells."
		""
		"You can add &bupgrade cards&r and configure \"partitions\" to filter what the cell will store."
		""
		"Items and fluids can be dragged into the slots from JEI/REI even if you don't actually have any of that item."
		""
		"Right-click with a fluid container (like a bucket or fluid tank) to set that fluid as a filter instead of the bucket or tank item."
	]
	quest.4D83B67CBCF2688A.quest_subtitle: "A workbench"
	quest.4D83B67CBCF2688A.title: "&bCell Workbench&r"
	quest.4DD0552B7D6C395D.quest_desc: [
		"&dMystical Agriculture&r is one of those mods that allows you to &6farm lots of resources&r by performing rituals, harvesting seeds, creating new seeds, farming everything."
		""
		"So this is gonna be a &6tough challenge&r because you're gonna need a lot of &dCreative Essence&r- Well, I mean every type of &6Essence&r if you wanna proceed and doing it in order without rushing into it."
	]
	quest.4DD0552B7D6C395D.quest_subtitle: "Farming...? Are you farming?"
	quest.4DD0552B7D6C395D.title: "&6King of Mystical Agriculture?"
	quest.4DDB44CAF9F37985.quest_desc: [
		"&6Ars Nouveau&r is a modern magic mod that allows players to craft their own &6unique spells&r, create magical artifacts, and automate their world through sorcery."
		""
		"Instead of finding &6pre-made spells&r, you build them using a flexible system of &6Glyphs&r that define what a spell does—such as launching a projectile, igniting a target, or teleporting the caster."
		""
		"It focuses on player creativity and integration with the world through magical familiars and &6mana-powered machinery&r."
	]
	quest.4DDB44CAF9F37985.quest_subtitle: "Read Description"
	quest.4DDB44CAF9F37985.title: "&fWelcome to &dArs Nouveau&f!"
	quest.4E188D8DC8CC0DCF.quest_subtitle: "Tier 5"
