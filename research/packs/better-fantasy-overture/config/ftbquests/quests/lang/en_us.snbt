	quest.6D7B6AB0C8D5F698.quest_desc: [
		"To obtain &dSource Gems&r, you must first build an &6Imbuement Chamber&r."
		""
		"An &6Imbuement Chamber&r imbues items inside it with &6Source&r, and will convert them to a new item."
		""
		"To obtain a &dSource Gem&r, place an Amethyst or Lapis inside your &6Imbuement Chamber&r and wait."
		""
		"Imbuement Chambers will consume source from nearby &6Source Jars&r to &6speed up&r any crafting. "
		""
		"Also, a &6Dowsing Rod&r can be used for finding Budding Amethyst &6early&r."
	]
	quest.6D7B6AB0C8D5F698.quest_subtitle: "C'mon this is easy, right?"
	quest.6D7B6AB0C8D5F698.title: "&dA New Gem!"
