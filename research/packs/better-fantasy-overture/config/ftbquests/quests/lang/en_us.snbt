	quest.4D38870AC550DDFF.quest_desc: [
		"&6Requires Terminite Armor Set to get full Crystalite set.&r"
		""
		"&6Recipe for the Crystalite Helmet:&r Terminite Hemet in the center Infusion Pedestal, an Amber Gem in the northern pedestal, and Crystal Shards in the east and west pedestals."
		""
		"&6Recipe for the Crystalite Chestplate:&r Terminite Chestplate in the middle Infusion Pedestal, an Amber Gem in the northern pedestal, and Crystal Shards in the northeast, southeast, southwest, and northwest pedestals."
		""
		"&6Recipe for the Crystalite Leggings:&r Terminite Leggings in the center infusion pedestal, an Amber Gem in the northern pedestal, and Crystal Shards in the east, south, and west pedestals."
		""
		"&6Recipe for the Crystalite Boots:&r Terminite Boots in the center Infusion Pedestal, an Amber Gem in the northern pedestal, and Crystal Shards in the east and west pedestals."
	]
