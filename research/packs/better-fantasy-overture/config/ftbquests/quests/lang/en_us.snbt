	quest.152B0C46145C6F82.title: "&fThere we are: &6Obsidian"
	quest.15B88BB0D2CB0CC3.quest_subtitle: "Tier Elemental"
	quest.15D088F70CEDAD11.quest_desc: [
		"How does it work: "
		""
		"&6Two Cogwheels interlock when placed next to each other (not diagonally) and facing the same direction.&r When rotational force is provided to one of the cogwheels, &6the force will be provided to the other Cogwheel at the same speed&r but in the opposite direction."
		""
		"&6And two Large Cogwheels interlock when placed perpendicular to each other&r, effectively changing its axis and direction, but not its speed."
		""
		"&6Remember: A Cogwheel and a Large Cogwheel interlock when placed diagonally to each other and facing the same direction.&r The Large Cogwheel will rotate at half the speed of the Cogwheel."
	]
	quest.15D088F70CEDAD11.quest_subtitle: "The Cogwheel is a basic mechanical component that relays rotation."
	quest.15D088F70CEDAD11.title: "&6&lCogwheels Are So Important&r"
	quest.15D34FFF7D661B6B.title: "&6Enchanted Spell Book&r"
	quest.162A68677BC3931B.quest_desc: [
