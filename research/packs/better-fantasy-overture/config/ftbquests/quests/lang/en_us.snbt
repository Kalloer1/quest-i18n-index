	quest.33EAB94D1BF09709.quest_desc: [
		"The &bME Fluid Storage Cell&r in AE2 is a specialized, high-capacity component designed to &6store liquids&r within an &bME network&r, inserting into &bME Drives&r or &bME Chests&r. "
		""
		"These &6cells&r hold up to &618 different types of fluids&r and &6manage capacity via fluid volume&r (measured in buckets) rather than byte-based storage, allowing for flexible liquid management. "
	]
	quest.33EAB94D1BF09709.quest_subtitle: "I really like AE2..."
	quest.33EAB94D1BF09709.title: "&bME Fluid Storage Cell&r"
