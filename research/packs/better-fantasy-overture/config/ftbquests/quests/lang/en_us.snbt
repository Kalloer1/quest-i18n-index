	quest.6E403F8B227C6B29.quest_desc: ["Robit acts as a crafting grid, a furnace, an anvil, a chest, or simply a cute little buddy. It is immune to fire, including the Flamethrower."]
	quest.6E403F8B227C6B29.quest_subtitle: "i remember robit very well..."
	quest.6E403F8B227C6B29.title: "&bOhhhh A Friendddd&r"
