{
	chapter.037923FB93E7ECA3.title: "§1Chapter 9 - Energy"
	chapter.068781BFE0793709.title: "§4Chapter 14 - Farming and Cooking"
	chapter.1000000000000000.title: "§cChapter 19 - Endgame"
	chapter.1100000000000000.title: "§6Chapter 16 - Extra quests 1"
	chapter.1200000000000000.title: "§eChapter 17 - Extra quests 2"
	chapter.1300000000000000.title: "§2Chapter 18 - Extra quests 3"
	chapter.1629F7331060AC82.title: "§3Chapter 8 - Advanced resource production"
	chapter.23B3A3F1217AE945.title: "§4Chapter 1 - Introduction of my own mod"
	chapter.2E7A8DA61B2DC338.title: "§dChapter 11 - Advanced automation and Logic"
	chapter.30195CD9EB6B07E3.title: "§9Chapter 10 - Mekanism"
	chapter.3E1904AB0CA2CD16.title: "§5Chapter 12 - RFTools and Dimensions"
	chapter.45BB385EDF4A67F2.title: "§aChapter 15 - Construction and aesthetic"
	chapter.466A9D05E7AEE2EF.title: "§4M§co§6d§ep§aa§bc§3k §9I§1n§5t§dr§4o§cd§6u§ec§at§bi§3o§9n"
	chapter.4B71395896195B76.title: "§cChapter 2 - First step, early game utils and some tips"
	chapter.5074EC6130B9A60F.title: "§aChapter 6 - Basic Automation and first pipes"
	chapter.5725E26C6B3A296F.title: "§6Chapter 3 - World Interaction"
	chapter.5D7B39C41FCFADE7.title: "§fChapter 13 - Exploration, equipment and mobility"
	chapter.66EF8D71F9991024.title: "§eChapter 4 - Mining and Furnaces"
	chapter.743EE0FF56832EEF.title: "§2Chapter 5 - Early/mid/end game storage"
	chapter.799AC03B188DD4D0.title: "§bChapter 7 - Actually Additions"
	file.0000000000000001.title: "AE2 vs RS neoforged"
	quest.0000000010A00000.quest_desc: [
		"You have automated everything."
		"You have infinite resources."
		"Now it is time to become a God."
		"This chapter requires insane amounts of materials. Hope your production lines are ready."
	]
	quest.0000000010A00000.quest_subtitle: "The Beginning of the End"
	quest.0000000010A00000.title: "&5End Game"
	quest.0000000010A00010.quest_desc: [
		"Found in the Deep Dark or the Mining Dimension."
		"It glows gold."
		"Required for the Teleport Pad to reach the 'Other' dimension."
	]
	quest.0000000010A00010.title: "&6Allthemodium"
	quest.0000000010A00011.quest_desc: [
		"Found in the Nether (Warped/Crimson forests)."
		"Needed for mid-tier Avaritia and Alloy tools."
	]
	quest.0000000010A00011.title: "&2Vibranium"
	quest.0000000010A00012.quest_desc: ["Found in the End or in the loot bag."]
	quest.0000000010A00012.title: "&dUnobtainium"
	quest.0000000010A00013.quest_desc: [
		"Mixing the impossible metals."
		"Used for the highest tier gear before Infinity."
	]
	quest.0000000010A00013.title: "&5The Ultimate Alloy"
	quest.0000000010A00020.quest_desc: [
		"Generates piles of Neutronium over time."
		"It is slow. Painfully slow."
		"You will need hundreds of these."
		"Time to scale up."
	]
	quest.0000000010A00020.title: "&8Neutronium Collector"
	quest.0000000010A00021.quest_desc: [
		"Dense matter."
		"The base component for all Infinity crafting."
	]
	quest.0000000010A00021.title: "&8Neutronium Ingot"
	quest.0000000010A00022.quest_desc: [
		"A 9x9 Crafting Table."
		"Required for Singularity recipes and Infinity Gear."
		"&cI'm looking for a way to automate it, sorry for now, but you have to enter the items manually."
	]
	quest.0000000010A00022.title: "&cExtreme Crafting"
	quest.0000000010A00023.quest_desc: [
		"Compress thousands of blocks into a single point using the Neutronium Compressor."
		"You need ALL types of singularities for the Catalyst."
		"Hook up your quarries and digital storage. You need millions of items."
	]
	quest.0000000010A00023.title: "&5Singularities"
	quest.0000000010A00024.quest_desc: [
		"The most expensive item in the game."
		"Combines the essence of everything."
		"The first step towards godhood."
		"&cFor crafting the Cosmic Meatball, you have to find some truffle. For find the first one, go in a forest whit a pig (you can use the Mob Inprisonment Tool) and feed the pig with a golden carrot. The pig start to search truffle. When it found the truffle, a particle effect will spawn.&r"
		"&aFor pig/hoglin ham, you have to kill one of them whit a knife (for farming this you can use a click machine). The pig have 50% drop chance, the hoglin have 100% chance."
	]
	quest.0000000010A00024.title: "&d&lInfinity Catalyst"
	quest.0000000010A00025.quest_desc: [
		"Forged from the Catalyst and Neutronium."
		"Used to craft the Infinity Armor and Tools."
	]
	quest.0000000010A00025.title: "&d&lInfinity Ingot"
	quest.0000000010A00026.quest_desc: [
		"You cannot die."
		"You cannot be hurt."
		"You can fly."
		"You are creative mode in survival."
	]
	quest.0000000010A00026.title: "&d&lInfinity Armor"
	quest.0000000010A00027.quest_desc: [
		"&bSword of the Cosmos:&r Kills anything in one hit. Even creative players."
		"&bWorld Breaker:&r Mines bedrock. Mines clusters of blocks instantly. Turns into a matter hammer."
	]
	quest.0000000010A00027.title: "&d&lTools of the Cosmos"
	quest.0000000010A00030.quest_desc: [
		"The key to Alchemy."
		"Press 'C' (default) to open the crafting grid."
		"Allows transmutation of blocks in the world and crafting of the Transmutation Table."
	]
	quest.0000000010A00030.title: "&ePhilosopher's Stone"
	quest.0000000010A00031.quest_desc: [
		"Burn items to learn them and store their EMC."
		"Pull items out using EMC."
		"Energy Matter Covalence is absolute."
	]
	quest.0000000010A00031.title: "&eTransmutation Table"
	quest.0000000010A00032.quest_desc: ["Start to collect EMC."]
	quest.0000000010A00032.title: "&eEMC Collector"
	quest.0000000010A00033.quest_desc: [
		"High EMC materials."
		"Used for high tier tools and armor (Gem Armor)."
	]
	quest.0000000010A00033.title: "&eDark and Red Matter"
	quest.0000000010A00034.quest_desc: [
		"Connect your EMC storage to your digital systems (AE2/RS/QIO)."
		"Input items to burn them for EMC."
		"Set an output item to generate it using stored EMC."
		"Essential for automating singularities."
	]
	quest.0000000010A00034.title: "&eEMC Links"
	quest.0000000010A00035.quest_desc: [
		"Stores infinite EMC."
		"The ultimate battery of the alchemist."
	]
	quest.0000000010A00035.title: "&eThe Final Star"
	quest.0000000010A00040.quest_desc: [
		"Infinite FE/RF."
		"Usually crafted using Avaritia/Extended Crafting tables or huge amounts of Antimatter."
		"Never worry about power again."
	]
	quest.0000000010A00040.title: "&dCreative Energy Cube"
	quest.0000000010A00041.quest_desc: [
		"Infinite Water, Lava, Sulfuric Acid, Antimatter Gas, Polonium..."
		"If you have a bucket/gauge of it, you can clone it infinitely."
	]
	quest.0000000010A00041.title: "&dCreative Fluids"
	quest.0000000010A00042.quest_desc: [
		"Creative Controllers for Refined Storage or AE2."
		"Infinite power for your network."
		"Often coupled with Creative Storage Disks for infinite item capacity."
	]
	quest.0000000010A00042.title: "&dCreative Digital Storage"
	quest.0000000011A00000.quest_desc: [
		"Tired of carrying 20 different guide books?"
		"Combine them all into the Akashic Tome."
		"&eUsage:&r Craft the Tome with a book. Right-click to select a book. Left-click the air to revert it back to the Tome."
	]
	quest.0000000011A00000.quest_subtitle: "Extra Part 1"
	quest.0000000011A00000.title: "&dAkashic Tome"
	quest.0000000011A00010.quest_desc: [
		"The builder's best friend."
		"This block can be placed in mid-air without needing a support block."
		"Perfect for starting skybases or placing lights in high ceilings."
		"Break it instantly with any tool (or hand) and it returns to inventory."
	]
	quest.0000000011A00010.title: "&bAngel Block"
	quest.0000000011A00020.quest_desc: [
		"Dropped by hostile mobs."
		"The first step to increasing your health."
		"Eat them to heal, or craft them into Canisters."
	]
	quest.0000000011A00020.title: "&cRed Hearts"
	quest.0000000011A00021.quest_desc: [
		"Craft Red Hearts into Canisters."
		"Equip in the Bauble/Curio slot to gain permanent extra hearts."
		"Max 10 canisters."
	]
	quest.0000000011A00021.title: "&cRed Canister"
	quest.0000000011A00022.quest_desc: [
		"Yellow Hearts drop from Bosses (Wither, etc.)."
		"Upgrade your Red Canisters to Yellow for even more health."
	]
	quest.0000000011A00022.title: "&eYellow Canister"
	quest.0000000011A00023.quest_desc: [
		"Green Hearts drop from the Ender Dragon."
		"The next tier of HP boost."
	]
	quest.0000000011A00023.title: "&aGreen Canister"
	quest.0000000011A00024.quest_desc: [
		"Blue Hearts drop from Evokers."
		"The final tier of Heart Canisters."
	]
	quest.0000000011A00024.title: "&9Blue Canister"
	quest.0000000011A00030.quest_desc: [
		"Hide your ugly cables."
		"Combine a Facade with any block to make it look like that block."
		"Works on almost any cable/pipe from any mod that supports the Facade API."
	]
	quest.0000000011A00030.title: "&7Cable Facades"
	quest.0000000011A00040.quest_desc: [
		"Better than Octadic."
		"Push your EnderIO machines further."
	]
	quest.0000000011A00040.title: "&2Allthemodium Capacitor"
	quest.0000000011A00041.quest_desc: [
		"The ultimate capacitor for EnderIO machines."
		"Insane speed and energy capacity."
	]
	quest.0000000011A00041.title: "&5Unobtainium Capacitor"
	quest.0000000011A00050.quest_desc: [
		"Test your damage."
		"Place the dummy and hit it."
		"It displays the DPS (Damage Per Second) and single-hit damage."
		"Can be dressed in armor to test penetration."
	]
	quest.0000000011A00050.title: "&eTarget Dummy"
	quest.0000000011A00060.quest_desc: [
		"The world of color."
		"This mod adds dozens of new intermediate colors (Aquamarine, Peal, Cherine, etc.)."
		"Every colored block (Wool, Concrete, Terracotta, Glass) has variants in these new colors."
	]
	quest.0000000011A00060.title: "&dDyenamics"
	quest.0000000011A00070.quest_desc: [
		"Found in the End by mining Enderite Ore."
		"The raw material for the strongest void-proof gear."
	]
	quest.0000000011A00070.title: "&5Enderite Scrap"
	quest.0000000011A00071.quest_desc: [
		"Combine Scraps to make Ingots."
		"Used for Smithing upgrades."
	]
	quest.0000000011A00071.title: "&5Enderite Ingot"
	quest.0000000011A00072.quest_desc: [
		"Upgrade your Netherite Armor using the Smithing Table."
		"Provides Knockback Resistance and Void protection (you float if you fall in the void)."
	]
	quest.0000000011A00072.title: "&5Enderite Armor"
	quest.0000000011A00073.quest_desc: [
		"Faster and more durable than Netherite."
		"Also fireproof and voidproof."
	]
	quest.0000000011A00073.title: "&5Enderite Tools"
	quest.0000000011A00080.quest_desc: [
		"Is your mob farm too loud?"
		"Place this block to mute specific sounds in an area."
		"You can also use the 'Sound Muffler Button' in your inventory to mute sounds client-side anywhere."
	]
	quest.0000000011A00080.title: "&8Sound Muffler"
	quest.0000000011A00090.quest_desc: [
		"Passive resource generation."
		"1. Place the Sluice."
		"2. Pump a fluid into the back (Water for dirt/sand/gravel, Lava for others)."
		"3. Insert a Mesh."
		"4. The Sluice will consume the block in front of it and produce resources."
	]
	quest.0000000011A00090.title: "&6Oak Sluice"
	quest.0000000011A00091.quest_desc: ["Faster processing speed."]
	quest.0000000011A00091.title: "&6Iron Sluice"
	quest.0000000011A00092.quest_desc: ["Very fast processing."]
	quest.0000000011A00092.title: "&6Diamond Sluice"
	quest.0000000011A00093.quest_desc: [
		"The fastest sluice."
		"Automate the feeding of blocks (like Gravel) into it for infinite ores."
	]
	quest.0000000011A00093.title: "&6Netherite Sluice"
	quest.0000000011A00094.quest_desc: [
		"Meshes determine what drops you get."
		"Cloth -> Iron -> Gold -> Diamond -> Netherite."
		"Higher tier meshes give rarer resources."
	]
	quest.0000000011A00094.title: "&6Meshes"
	quest.0000000012A00000.quest_desc: [
		"This chapter covers advanced mob farming tools and other essential utilities."
		"Mob Grinding Utils provides everything you need to automate mob drops and XP."
	]
	quest.0000000012A00000.quest_subtitle: "Extra Part 2"
	quest.0000000012A00000.title: "&2Mob Grinding Utils"
	quest.0000000012A00010.quest_desc: [
		"Classic mob killing blocks."
		"Mobs take damage when touching them."
		"Does not drop XP (unless player kill happens)."
	]
	quest.0000000012A00010.title: "&2Spikes"
	quest.0000000012A00011.quest_desc: [
		"The ultimate autonomous killer."
		"Requires Redstone signal to activate."
		"Has an internal inventory for upgrades."
		"Can drop player-only items and XP if upgraded."
	]
	quest.0000000012A00011.title: "&2Mob Masher"
	quest.0000000012A00012.quest_desc: [
		"Right-click the Mob Masher to insert upgrades."
		"&bSharpness:&r More damage."
		"&bLooting:&r More drops."
		"&bBeheading:&r Chance for mob heads."
	]
	quest.0000000012A00012.title: "&2Masher Upgrades"
	quest.0000000012A00013.quest_desc: [
		"Pushes mobs in the direction it faces."
		"Crucial for moving mobs into your spikes/masher without using water."
		"Can be upgraded to increase range (Width/Height/Distance)."
	]
	quest.0000000012A00013.title: "&2Mob Fan"
	quest.0000000012A00014.quest_desc: [
		"Vacuum cleaner for items and XP."
		"Sucks up everything in a configurable area (Offset settings in GUI)."
		"Outputs items to inventory (chest) and Fluids/XP to tank."
	]
	quest.0000000012A00014.title: "&2Absorption Hopper"
	quest.0000000012A00015.quest_desc: [
		"Stores Liquid XP (and other fluids)."
		"Place an XP Tap on the side to pour liquid XP into orbs for you to mend gear."
	]
	quest.0000000012A00015.title: "&2Singularity Tank and Tap"
	quest.0000000012A00016.quest_desc: [
		"Used to create Spawn Eggs."
		"1. Right-click a mob with the swab to collect DNA."
		"2. Craft Swab + Seeds + Bucket of XP = GM Chicken Feed."
	]
	quest.0000000012A00016.title: "&2Mob Swab"
	quest.0000000012A00017.quest_desc: [
		"Feed this to a Chicken."
		"The chicken explodes (don't worry, it's for science)."
		"It drops a Spawn Egg of the mob you swabbed."
		"Use the egg to change a Spawner type."
	]
	quest.0000000012A00017.title: "&2GM Chicken Feed"
	quest.0000000012A00020.quest_desc: [
		"JAMD: Just Another Mining Dimension."
		"A dimension dedicated to mining."
		"Usually flat, always day, no mobs (configurable)."
		"Great for Quarries and testing builds."
	]
	quest.0000000012A00020.title: "&7Mining Dimension"
	quest.0000000012A00040.quest_desc: [
		"Measure distances easily."
		"Right-click start point, right-click end point."
		"Tells you the X, Y, Z distance and total blocks."
	]
	quest.0000000012A00040.title: "&eTape Measure"
	quest.0000000012A00050.quest_desc: [
		"Buckets that hold more than 1 bucket."
		"Copper, Gold, Diamond, Obsidian, etc."
		"Useful for moving fluids manually without pipes."
	]
	quest.0000000012A00050.title: "&bMore Buckets"
	quest.0000000012A00060.quest_desc: [
		"The Omni-Wrench."
		"Combine all your mod wrenches (Crescent Hammer, Smart Wrench, Yeta Wrench, etc.) into this one item."
		"It automatically changes into the correct wrench when you look at a mod's block."
	]
	quest.0000000012A00060.title: "&9Morph-o-Tool"
	quest.0000000012A00070.quest_desc: [
		"Move chests without emptying them."
		"Right-click a chest with Paper and Tape."
		"Break the chest. It keeps its NBT data."
		"Place it down and right-click to unpack."
	]
	quest.0000000012A00070.title: "&ePacking Tape"
	quest.0000000013A00000.quest_desc: [
		"The final chapter of utilities."
		"Here we cover time manipulation, racial transformations, and inventory management."
		"These are the tools that make the game feel smooth."
	]
	quest.0000000013A00000.quest_subtitle: "Extra Part 3"
	quest.0000000013A00000.title: "&dQuality of Life and Magic"
	quest.0000000013A00010.quest_desc: [
		"Possibly the most powerful item in the pack."
		"1. Keep it in your inventory while you play."
		"2. It passively collects 'Time' (1 second = 1 second)."
		"3. Right-click a machine, crop, or block entity to spend time and accelerate it."
		"4. Click multiple times to increase speed: 2x, 4x, 8x, 16x, 32x."
		"&cWarning:&r Do not accelerate multiblocks recklessly, they might desync."
	]
	quest.0000000013A00010.title: "&eTime in a Bottle"
	quest.0000000013A00020.quest_desc: [
		"A magic mod focused on accessories and racial transformation."
		"Start by crafting Glowing Ingots."
		"Used to craft race potions and powerful rings."
	]
	quest.0000000013A00020.title: "&5Trinkets and Baubles"
	quest.0000000013A00021.quest_desc: [
		"You can change your race!"
		"Drink a Race Potion (or use the specific race item) to transform."
		"See the surrounding quests for details on each race."
	]
	quest.0000000013A00021.title: "&5Racial Transformation"
	quest.0000000013A00022.quest_desc: [
		"&aPros:&r Flight (creative style), Fire Breath (Keybind)."
		"&cCons:&r Uses Mana (XP Bar) to fly. Need to eat to regenerate Mana."
		"&eDiet:&r Meat."
	]
	quest.0000000013A00022.title: "&5Race: Dragon"
	quest.0000000013A00023.quest_desc: [
		"&aPros:&r Creative Flight (Low Mana cost), Tiny Size (1 block high), Climbing."
		"&cCons:&r Very low Health (Max 3-4 hearts), weaker attacks."
		"&eDiet:&r Sweet things (Sugar, Cookies, Glistering Melon)."
	]
	quest.0000000013A00023.title: "&5Race: Catnip"
	quest.0000000013A00024.quest_desc: [
		"&aPros:&r Faster movement, Step Assist (walk up blocks), Higher jump."
		"&cCons:&r Cannot wear heavy armor (Iron/Diamond reduces speed)."
		"&eDiet:&r Vegetables and Fruits."
	]
	quest.0000000013A00024.title: "&5Race: Elf"
	quest.0000000013A00025.quest_desc: [
		"&aPros:&r Massive Size, Higher Health, Stronger Attacks."
		"&cCons:&r Huge hitbox, slower, needs more food."
	]
	quest.0000000013A00025.title: "&5Race: Titan"
	quest.0000000013A00030.quest_desc: [
		"Negates fall damage completely."
		"Essential if you are playing as a Dragon/Fairy and run out of mana mid-air."
	]
	quest.0000000013A00030.title: "&5Stone of Inertia Null"
	quest.0000000013A00031.quest_desc: [
		"Grants underwater breathing and fast swim speed."
		"Essentially turns you into a Merfolk when in water."
	]
	quest.0000000013A00031.title: "&5Sea Stone"
	quest.0000000013A00032.quest_desc: [
		"Permanent Night Vision."
		"Never place a torch again."
	]
	quest.0000000013A00032.title: "&5Ring of Enchanted Eyes"
	quest.0000000013A00033.quest_desc: [
		"The ultimate Magnet."
		"Toggle it to attract items from far away."
		"Shift-Right click to configure settings (Instant pickup, range)."
	]
	quest.0000000013A00033.title: "&5Polarized Stone"
	quest.0000000013A00050.quest_desc: [
		"Stop organizing chests manually."
		"&eMiddle Click&r inside an inventory or chest to Sort it instantly."
		"You can configure sorting modes in the settings."
	]
	quest.0000000013A00050.title: "&6Inventory Essentials: Sorting"
	quest.0000000013A00051.quest_desc: [
		"Learn these to save hours:"
		"&eShift + Click:&r Move stack."
		"&eCtrl + Click:&r Move ALL items of that type."
		"&eSpace + Click:&r Move ALL items from inventory to chest (or vice versa)."
	]
	quest.0000000013A00051.title: "&6Inventory Essentials: Shortcuts"
	quest.000000005A000000.quest_desc: [
		"Gone are the days of random chests scattered around your base."
		"This chapter covers everything from upgraded chests and drawers to massive digital storage networks."
		"Choose your path: Physical or Digital (or both!)."
	]
	quest.000000005A000000.quest_subtitle: "Organizing the Chaos"
	quest.000000005A000000.title: "&bStorage Solutions"
	quest.000000005A000001.quest_desc: [
		"Drawers are perfect for storing large amounts of a single item (like Cobblestone, Dirt, or Crops)."
		"They can be upgraded with storage upgrades and void upgrades."
	]
	quest.000000005A000001.title: "&6Storage Drawers"
	quest.000000005A000002.quest_desc: [
		"The Controller connects all touching drawers."
		"Double-clicking an item on the controller will deposit all matching items from your inventory into the attached drawers."
	]
	quest.000000005A000002.title: "&6Drawer Controller"
	quest.000000005A000003.quest_desc: [
		"Stores items that can be compressed (e.g., Nuggets <-> Ingot <-> Block)."
		"Allows you to insert Ingots and withdraw Blocks or Nuggets automatically."
	]
	quest.000000005A000003.title: "&6Compacting Drawer"
	quest.000000005A000004.quest_desc: [
		"Similar to Storage Drawers but with a different aesthetic and upgrade system."
		"Features the Armory Cabinet for mass storing unstackable items."
	]
	quest.000000005A000004.title: "&6Functional Storage"
	quest.000000005A000005.quest_desc: ["A massive storage unit specifically for unstackable items like Swords, Bows, and Armor."]
	quest.000000005A000005.title: "&6Armory Cabinet"
	quest.000000005A000006.quest_desc: [
		"Sometimes you just need a really big chest."
		"Build a hollow cube of Chest Walls."
		"You need exactly one Colossal Chest Core and at least one Interface."
		"&eStructure:&r Hollow cube (e.g. 3x3x3)."
	]
	quest.000000005A000006.title: "&6Colossal Chests"
	quest.000000005A000007.quest_desc: [
		"Chests and Barrels that accept upgrades."
		"You can add Pickup upgrades, Smelting upgrades, Compacting upgrades, and more."
	]
	quest.000000005A000007.title: "&6Sophisticated Storage"
	quest.000000005A000008.quest_desc: [
		"Global storage linked by color."
		"Use dyes on the three wool pads on top of the chest to change its frequency."
		"Chests with the same color combination share inventory anywhere in the world."
	]
	quest.000000005A000008.title: "&6Ender Storage"
	quest.000000005A000009.quest_desc: [
		"Works just like the Ender Chest, but for fluids."
		"Essential for moving lava from the Nether or oil from pumps."
	]
	quest.000000005A000009.title: "&6Ender Tank"
	quest.000000005A00000A.quest_desc: [
		"A Pocket Storage Unit (PSU) holds items for you."
		"Higher tiers hold more items and types."
	]
	quest.000000005A00000A.title: "&6Pocket Storage"
	quest.000000005A00000B.quest_desc: [
		"Refined Storage converts items into digital data."
		"You need a Controller powered by FE (Forge Energy) to start."
		"Connect everything with cables."
	]
	quest.000000005A00000B.title: "&bRefined Storage"
	quest.000000005A00000C.quest_desc: [
		"The Grid allows you to see and interact with items in your system."
		"Upgrade to a Crafting Grid to craft directly from storage."
	]
	quest.000000005A00000C.title: "&bThe Grid"
	quest.000000005A00000D.quest_desc: [
		"The Disk Drive holds your Storage Disks."
		"Without disks, your system has no memory."
	]
	quest.000000005A00000D.title: "&bDisk Drive"
	quest.000000005A00000E.quest_desc: [
		"Craft your first Storage Disk."
		"The 1k disk is small, but it's a start."
		"You can retrieve the storage part by shift-right-clicking the disk in hand to upgrade it later."
	]
	quest.000000005A00000E.title: "&bStorage Disks"
	quest.000000005A00000F.quest_desc: [
		"Refined Storage ends at 64k."
		"ExtraStorage and ExtraDisks add much larger options, up to Infinite."
	]
	quest.000000005A00000F.title: "&bExtra Storage"
	quest.000000005A000010.quest_desc: [
		"Never run out of space again."
		"The Infinite Storage Disk allows unlimited items of any type."
	]
	quest.000000005A000010.title: "&bInfinite Storage"
	quest.000000005A000011.quest_desc: [
		"To access your system remotely, you need a Wireless Transmitter connected to your network."
		"It has a limited range by default."
		"You also need a Wireless Grid linked to your controller."
	]
	quest.000000005A000011.title: "&bWireless Access"
	quest.000000005A000012.quest_desc: [
		"The basic range upgrades are not enough."
		"The Infinity Card (for the transmitter) allows access from anywhere in the same dimension."
		"The Dimension Card allows access across dimensions."
	]
	quest.000000005A000012.title: "&bInfinite Range"
	quest.000000005A000013.quest_desc: [
		"Why carry multiple grids for items and fluids?"
		"The Universal Grid combines them into one convenient device."
	]
	quest.000000005A000013.title: "&bUniversal Grid"
	quest.000000005A000014.quest_desc: [
		"Standard Importers and Exporters can be slow."
		"Use Cable Tiers to craft Elite, Mega, and Ultra versions."
		"These move stacks of items per tick, drastically speeding up automation."
	]
	quest.000000005A000014.title: "&bCable Tiers"
	quest.000000005A000015.quest_desc: [
		"AE2 is a complex, channel-based storage system."
		"You start by finding Certus Quartz and charging it."
		"The Controller is a multiblock structure that provides channels for your devices."
		"&cTRY THE AE2 ADDON! Search in Jei:"
		"&c- appiedE"
		"&c- extendedAE&r"
		"&c- advancedAE&r"
		"&c- applied mekanistics&r"
		"&c- applied flux (for receive, send and storage energy, compatible with flux network)"
		"&c- ae2 wireless terminal&r"
		"&c- ae2 universal press&r"
		"&c- ae2 import and export card&r"
		"&c- me requester&r"
		"&eOther function available: "
		"&e- project extended advanced ae"
		"&e- ae2 crafting tree"
	]
	quest.000000005A000015.title: "&dApplied Energistics 2"
	quest.000000005A000016.quest_desc: [
		"You need to find Presses in meteorites (or craft them if recipes allow)."
		"Use the Inscriber to press circuits and processors used in almost every AE2 crafting recipe."
	]
	quest.000000005A000016.title: "&dProcessors"
	quest.000000005A000017.quest_desc: [
		"The ME Drive holds your Storage Cells."
		"Unlike RS, AE2 cells have a limit on item *types* (63 types per cell), so organization is key."
	]
	quest.000000005A000017.title: "&dME Drive"
	quest.000000005A000018.quest_desc: [
		"The standard cells range from 1k to 64k."
		"Shift-right click a cell to separate the component from the housing."
	]
	quest.000000005A000018.title: "&dStorage Cells"
	quest.000000005A000019.quest_desc: [
		"MegaCells adds cells that go way beyond 64k."
		"1M, 4M, up to 256M."
		"Requires Sky Steel, crafted in the inscriber."
	]
	quest.000000005A000019.title: "&dMega Cells"
	quest.000000005A00001A.quest_desc: [
		"Even more storage options with AE Additions."
		"Provides alternative high-tier cells for late game."
	]
	quest.000000005A00001A.title: "&dAE Additions"
	quest.000000005A00001B.quest_desc: [
		"Link your Wireless Terminal to the system in the Security Terminal."
		"Requires a Wireless Access Point connected to the network."
	]
	quest.000000005A00001B.title: "&dWireless AE2"
	quest.000000005A00001C.quest_desc: [
		"Insert the Infinity Card into your Wireless Access Point to remove range and dimension limits."
		"Requires a lot of energy!"
	]
	quest.000000005A00001C.title: "&dInfinite AE2 Range"
	quest.000000005A00001D.quest_desc: [
		"P2P Tunnels allow you to transport channels, items, fluids, or energy through a single cable connection."
		"Essential for managing the 32-channel limit of dense cables in large bases."
	]
	quest.000000005A00001D.title: "&dP2P Tunnels"
	quest.000000005A00001E.quest_desc: [
		"Cable Tiers works with AE2 as well!"
		"Use Elite, Mega, and Ultra buses to move items into your ME system instantly."
	]
	quest.000000005A00001E.title: "&dCable Tiers (AE2)"
	quest.000000008A000000.quest_desc: [
		"Why mine when you can farm?"
		"Mystical Agriculture allows you to grow almost any resource in the game."
		"It starts with Inferium and Prosperity Shards."
	]
	quest.000000008A000000.quest_subtitle: "&aGrowing Resources"
	quest.000000008A000000.title: "&5Mystical Agriculture"
	quest.000000008A000001.quest_desc: [
		"To create seeds, you need an Infusion Altar surrounded by 8 Infusion Pedestals."
		"Place the target seed/item in the center and the ingredients on the pedestals."
		"Apply a Redstone Signal to start crafting."
	]
	quest.000000008A000001.title: "&5Infusion Altar"
	quest.000000008A000002.quest_desc: [
		"The base essence."
		"Obtained from killing mobs or harvesting Inferium crops."
	]
	quest.000000008A000002.title: "&5Inferium Essence"
	quest.000000008A000003.quest_desc: ["Crafted using Inferium and an Infusion Crystal."]
	quest.000000008A000003.title: "&5Prudentium Essence"
	quest.000000008A000004.quest_desc: ["Getting stronger."]
	quest.000000008A000004.title: "&5Tertium Essence"
	quest.000000008A000005.quest_desc: ["Required for high tier seeds."]
	quest.000000008A000005.title: "&5Imperium Essence"
	quest.000000008A000006.quest_desc: [
		"The highest tier in the base mod."
		"Used for ultimate armor and tools."
	]
	quest.000000008A000006.title: "&5Supremium Essence"
	quest.000000008A000007.quest_desc: [
		"Added by Mystical Agradditions."
		"This is the pinnacle of resource generation."
		"Used for Creative-like flight and items."
	]
	quest.000000008A000007.title: "&5Insanium Essence"
	quest.000000008A000008.quest_desc: [
		"Craft a piece of Supremium armor."
		"You need this to install Augments."
	]
	quest.000000008A000008.title: "&5Supremium Armor"
	quest.000000008A000009.quest_desc: [
		"Install this augment into your Supremium Chestplate using a Tinkering Table."
		"Allows creative flight."
	]
	quest.000000008A000009.title: "&5Augment: Flight"
	quest.000000008A00000A.quest_desc: [
		"Drastically increases your movement speed."
		"Perfect for leggings or boots."
	]
	quest.000000008A00000A.title: "&5Augment: Speed"
	quest.000000008A00000B.quest_desc: ["Increases your max health significantly."]
	quest.000000008A00000B.title: "&5Augment: Health"
	quest.000000008A00000C.quest_desc: [
		"If you have too many seeds, don't throw them away."
		"The Reprocessor converts seeds back into their respective essence."
	]
	quest.000000008A00000C.title: "&5Seed Reprocessor"
	quest.000000008A00000D.quest_desc: [
		"A massive tech mod focused on farming, mob grinding, and material processing."
		"Almost everything requires &fPlastic&r."
	]
	quest.000000008A00000D.title: "&fIndustrial Foregoing"
	quest.000000008A00000E.quest_desc: [
		"Place a Fluid Extractor facing a wood log."
		"It will slowly break the log and produce Liquid Latex."
		"Acacia and Dark Oak produce latex faster."
	]
	quest.000000008A00000E.title: "&fFluid Extractor"
	quest.000000008A00000F.quest_desc: [
		"Pump the Liquid Latex and Water into this machine."
		"It uses power to produce Tiny Dry Rubber."
	]
	quest.000000008A00000F.title: "&fLatex Processing"
	quest.000000008A000010.quest_desc: [
		"Craft 9 Tiny Dry Rubber into 1 Dry Rubber."
		"Smelt the Dry Rubber in a furnace to get Plastic."
		"You will need stacks of this."
	]
	quest.000000008A000010.title: "&fPlastic"
	quest.000000008A000011.quest_desc: ["Uses fluids (often Pink Slime or Latex) and items to craft advanced machine frames and upgrades."]
	quest.000000008A000011.title: "&fDissolution Chamber"
	quest.000000008A000012.quest_desc: [
		"Kills mobs instantly. Does NOT drop items or XP."
		"Instead, it produces Liquid Meat and Pink Slime."
		"Pink Slime is essential for advanced crafting."
	]
	quest.000000008A000012.title: "&fMob Slaughter Factory"
	quest.000000008A000013.quest_desc: ["Uses Mob Essence (from a Mob Crusher) and a Mob Imprisonment Tool to spawn exact copies of entities."]
	quest.000000008A000013.title: "&fMob Duplicator"
	quest.000000008A000014.quest_desc: ["An advanced farming block that requires water, power, and ether gas to function at max efficiency."]
	quest.000000008A000014.title: "&fHydroponic Bed"
	quest.000000008A000015.quest_desc: [
		"The Laser Drill Base generates ores from nothing (or fluids) at the cost of immense power."
		"You must attach Laser Drills to the Base."
		"Use Colored Lenses to target specific ores (e.g., Yellow for Gold)."
	]
	quest.000000008A000015.title: "&fLaser Mining"
	quest.000000008A000016.quest_desc: [
		"An addon machine that extracts souls."
		"Focus on the Blue Warden to get special soul resources."
	]
	quest.000000008A000016.title: "&fSoul Extraction"
	quest.000000008A000017.quest_desc: [
		"Thanks to MIFA, you can craft higher tier upgrades for your Industrial Foregoing machines."
		"Efficiency, Speed, and Processing upgrades go up to Tier 8!"
	]
	quest.000000008A000017.title: "&fAdvanced Addons"
	quest.000000008A000019.quest_desc: [
		"Construct the Foundry structure."
		"You need:"
		"- 1 Foundry Controller"
		"- Foundry Tanks (for lava/fuel)"
		"- Foundry Glass or Structural Blocks"
		"- Input/Output tables or basins"
	]
	quest.000000008A000019.title: "&8Productive Metalworks"
	quest.000000008A00001A.quest_desc: [
		"Use the Casting Table for ingots (requires cast) and the Casting Basin for blocks."
		"Molten metal is poured from the Foundry into these blocks."
	]
	quest.000000008A00001A.title: "&8Casting"
	quest.000000009A000000.quest_desc: [
		"Welcome to the Age of Power."
		"You will need Forge Energy (FE) to run your machines."
	]
	quest.000000009A000000.quest_subtitle: "Powering the World"
	quest.000000009A000000.title: "&cEnergy Generation"
	quest.000000009A000001.quest_desc: [
		"Basic Solar Panel for early game."
		"Check @solargeneration , @energizedpower and @powah for other solar panel."
	]
	quest.000000009A000001.title: "&cSolar Flux"
	quest.000000009A000002.quest_desc: [
		"Middle Solar Panel for mid-game."
		"Check @solargeneration , @energizedpower and @powah for other solar panel."
	]
	quest.000000009A000002.title: "&cMid-Tier Solar"
	quest.000000009A000003.quest_desc: [
		"Advanced Solar Panel for end-game."
		"Check @solargeneration , @energizedpower and @powah for other solar panel."
	]
	quest.000000009A000003.title: "&cHigh-Tier Solar"
	quest.000000009A000004.quest_desc: ["Beautiful mod for mid-game energy! Dielectic Paste is the base of all blocks, uraninite is the reactor fuel."]
	quest.000000009A000004.title: "&cPowah!"
	quest.000000009A000005.quest_desc: ["Generate energy by burning things."]
	quest.000000009A000005.title: "&cFurnator"
	quest.000000009A000006.quest_desc: [
		"Generate energy from lava. "
		"Tips: you can use lava generator upgrade (functional storage), or fluid pump."
	]
	quest.000000009A000006.title: "&cMagmator"
	quest.000000009A000007.quest_desc: ["Place a block of lava under this block and it generate power."]
	quest.000000009A000007.title: "&cThermo Generator"
	quest.000000009A000008.title: "&cEnergizing Orb"
	quest.000000009A000009.title: "&cEnergized Steel"
	quest.000000009A00000A.title: "&cBlazing Crystal"
	quest.000000009A00000B.title: "&cNiotic Crystal"
	quest.000000009A00000C.title: "&cSpirited Crystal"
	quest.000000009A00000D.title: "&cNitro Crystal"
	quest.000000009A00000E.quest_desc: [
		"36 blocks allow you to place reactor (just place one block, structure will auto-build)."
		"For upgrading tier, you must connect the energizing rod whit the mod's energy pipe, directly to reactor. This rod must be facing to energizing orb,"
		"Hold G for guide."
	]
	quest.000000009A00000E.title: "&cReactors"
	quest.000000009A00000F.title: "&cPlayer Transmitter"
	quest.000000009A000010.quest_desc: [
		"Immersive Engineering is a tech mod that focuses on realistic power systems and industrial machinery. Instead of glowing blocks, it features massive multi-block structures, overhead power lines, and functional tools like the Revolver and Chemical Thrower. It prioritizes immersion and visual detail, making complex automation feel like a tangible, heavy-duty industrial operation."
		"Use the manual for building the multiblock structures."
	]
	quest.000000009A000010.quest_subtitle: "https://ftbwiki.org/Immersive_Engineering"
	quest.000000009A000010.title: "&cImmersive Engineering"
	quest.000000009A000011.quest_desc: ["The Water Wheel provides early-game renewable energy by generating rotational force when placed next to flowing water. This kinetic energy is converted into IF (Immersive Flux) by attaching the wheel to a Kinetic Dynamo, which serves as the essential interface between mechanical motion and your power grid."]
	quest.000000009A000011.title: "&cKinetic Power"
	quest.000000009A000012.quest_desc: ["Wires and Connectors facilitate power distribution through visible overhead lines, moving away from the \"hidden cables\" found in most other mods. You must place Connectors on machines and use Relays for long distances, manually stringing the wire coils between them to create a realistic industrial power grid."]
	quest.000000009A000012.title: "&cWires and Connectors"
	quest.000000009A000013.quest_desc: ["Incredible way for transfert wirelessly the energy!"]
	quest.000000009A000013.title: "&cFlux Networks"
	quest.000000009A000014.quest_desc: ["Use plug to send your energy to a flux controller. Use flux point on machines for receive energy from controller. "]
	quest.000000009A000014.title: "&cNetwork Components"
	quest.000000009A000015.quest_subtitle: "A battery,"
	quest.000000009A000015.title: "&cFlux Storage"
	quest.000000009A000016.quest_desc: ["Just another way to create energy."]
	quest.000000009A000016.quest_subtitle: "https://ftb.fandom.com/wiki/Deep_Resonance"
	quest.000000009A000016.title: "&cDeep Resonance"
	quest.000000009A000017.quest_desc: ["Check the wiki for build multiblock structures."]
	quest.000000009A000017.quest_subtitle: "https://ftb.fandom.com/wiki/Deep_Resonance"
	quest.000000009A000017.title: "&cCrystal Generator"
	quest.000000009A000018.quest_desc: [
		"Just another solar panel mod (and much much more)."
		"Check the wiki for other information."
	]
	quest.000000009A000018.title: "&cEnergized Power"
	quest.000000009A000019.quest_desc: ["A simple machine that provide to charge the tools."]
	quest.000000009A000019.title: "&cCharging Station"
	quest.000000009A000020.quest_desc: ["Industrial Foregoing is a massive industrial automation mod that provides a wide range of machines for farming, resource processing, and utility. Regarding energy, it primarily generates power through the Pituitary Generator (using Ghast tears) or the Mycelial Generators, which produce massive amounts of RF/FE by consuming diverse resources like crops, explosives, or enchanted items."]
	quest.000000009A000020.quest_subtitle: "https://ftb.fandom.com/wiki/Industrial_Foregoing"
	quest.000000009A000020.title: "&cIndustrial Foregoing Power"
	quest.000000009A000021.quest_desc: ["Industrial Foregoing’s Biofuel is a liquid fuel produced in the Bioreactor by processing various organic materials like seeds, saplings, and crops. Its primary use is to power the Biofuel Generator for efficient energy production, but it is also essential for creating Pink Slime and advanced plastic components."]
	quest.000000009A000021.title: "&cBiofuel Power"
	quest.000000009A000022.quest_desc: ["The Mycelial Reactor is a high-tier multiblock structure that generates massive amounts of FE by simultaneously running all 16 different types of Mycelial Generators. It acts as a central hub that consumes the combined \"essences\" of these generators to produce a continuous, endgame-level power output."]
	quest.000000009A000022.title: "&cMycelial Reactor"
	quest.000000009A000023.quest_subtitle: "There are more addon. Check the jei."
	quest.000000009A000023.title: "&cMIFA Addons"
	quest.00000000AA000000.quest_desc: [
		"This Chapter is for my own custom mod: &6NeoGundam&r and guide you through the exclusive items, powerful gears, and decorations added by NeoGundam."
		"Prepare yourself, because some of these items will change how you play entirely."
	]
	quest.00000000AA000000.quest_subtitle: "Start Here"
	quest.00000000AA000000.title: "&eWelcome!"
	quest.00000000AA000001.quest_desc: [
		"The most important resource in NeoGundam."
		"This dust radiates immense energy."
		"&eHow to obtain:&r You must smelt &bBEDROCK&r in a blast furnace."
		"Used for crafting end-game things."
	]
	quest.00000000AA000001.title: "&6Gundamite"
	quest.00000000AA000002.quest_desc: [
		"A legendary weapon forged from Gundamite."
		"It hits hard, but its true power lies in its magic."
		"&eSpecial Ability:&r Press &b'K'&r while holding it to summon a lightning strike on your enemies."
		"Become the storm."
	]
	quest.00000000AA000002.title: "&cJuki's Sword"
	quest.00000000AA000003.quest_desc: [
		"The Tier 3 (Ultimate) Alloy."
		"Made by infusing Reinforced Alloy with Refined Obsidian Dust."
	]
	quest.00000000AA000003.title: "&3Atomic Alloy"
	quest.00000000AA000004.quest_desc: [
		"Tier 4 Alloy (Extras)."
		"Things are getting serious."
	]
	quest.00000000AA000004.title: "&dRadiance Alloy"
	quest.00000000AA000005.quest_desc: ["Tier 5 Alloy (Extras)."]
	quest.00000000AA000005.title: "&dThermonuclear Alloy"
	quest.00000000AA000006.quest_desc: [
		"Tier 6 Alloy (Extras)."
		"Powered by the cosmos."
	]
	quest.00000000AA000006.title: "&dShining Alloy"
	quest.00000000AA000007.quest_desc: [
		"The Final Alloy."
		"Used for creative-level items and infinite capabilities."
	]
	quest.00000000AA000007.title: "&dSpectrum Alloy"
	quest.00000000AA000008.quest_desc: [
		"The brain of basic machines."
		"Made by infusing Osmium Ingots with Redstone."
	]
	quest.00000000AA000008.title: "&3Basic Control Circuit"
	quest.00000000AA000009.quest_desc: [
		"Used for Elite factories and advanced tech."
		"Made by infusing Basic Circuits with Infused Alloys."
	]
	quest.00000000AA000009.title: "&3Advanced Control Circuit"
	quest.00000000AA00000A.quest_desc: [
		"Used for high-tier machinery."
		"Made by infusing Advanced Circuits with Reinforced Alloys."
	]
	quest.00000000AA00000A.title: "&3Elite Control Circuit"
	quest.00000000AA00000B.quest_desc: [
		"The highest tier base circuit."
		"Used for the Fusion Reactor, SPS, and QIO drives."
	]
	quest.00000000AA00000B.title: "&3Ultimate Control Circuit"
	quest.00000000AA00000C.quest_desc: ["Extras Tier 4 Circuit."]
	quest.00000000AA00000C.title: "&dAbsolute Control Circuit"
	quest.00000000AA00000D.quest_desc: ["Extras Tier 5 Circuit."]
	quest.00000000AA00000D.title: "&dSupreme Control Circuit"
	quest.00000000AA00000E.quest_desc: ["Extras Tier 6 Circuit."]
	quest.00000000AA00000E.title: "&dCosmic Control Circuit"
	quest.00000000AA00000F.quest_desc: [
		"The Final Circuit."
		"Limitless processing power."
	]
	quest.00000000AA00000F.title: "&dInfinity Control Circuit"
	quest.00000000AA000010.quest_desc: [
		"The ultimate equipment."
		"This armor cannot be crafted by normal means."
		"&eSource:&r You can find these pieces in Loot Chests (Dungeons, End Cities, etc.), whit &crarity&r 0.03% chance and in Loot Reward whit &crarity&r 0.05% in High Tier Loot Reward, 0.03% in Industrial Loot Reward and 0.01% in Misc and Resource Loot Reward"
	]
	quest.00000000AA000010.title: "&5Andromeda Armor Set"
	quest.00000000AA000011.quest_desc: [
		"The helm of the stars."
		"Provides the following permanent effects:"
		"- &bWater Breathing:&r Explore the depths without fear."
		"- &bSaturation:&r You will never need to eat again."
		"- &bNight Vision:&r See everything clearly."
	]
	quest.00000000AA000011.title: "&5Andromeda Helmet"
	quest.00000000AA000012.quest_desc: [
		"The core of the set."
		"Provides the following permanent effects:"
		"- &bHealth Boost:&r Massively increases your max HP."
		"- &bHaste:&r Mine blocks instantly."
		"- &bResistance:&r Shrug off damage like it's nothing."
	]
	quest.00000000AA000012.title: "&5Andromeda Chestplate"
	quest.00000000AA000013.quest_desc: [
		"Leggings forged in the void."
		"Provides the following permanent effects:"
		"- &bJump Boost:&r Leap over walls."
		"- &bFire Resistance:&r Swim in lava safely."
	]
	quest.00000000AA000013.title: "&5Andromeda Leggings"
	quest.00000000AA000014.quest_desc: [
		"Boots of infinite motion."
		"Provides the following permanent effects:"
		"- &bSpeed:&r Move faster on land."
		"- &bDolphin's Grace:&r Move incredibly fast underwater."
	]
	quest.00000000AA000014.title: "&5Andromeda Boots"
	quest.00000000AA000015.quest_desc: [
		"Moves HEAT."
		"Used to transfer heat from a Resistive Heater to a Thermal Evaporation Plant, or from a Fission Reactor to a Boiler."
	]
	quest.00000000AA000015.title: "&3Thermodynamic Conductor"
	quest.00000000AA000016.quest_desc: [
		"The fastest base item transport pipe."
		"Upgrading pipes increases throughput and pumping speed."
	]
	quest.00000000AA000016.title: "&3Ultimate Transporters"
	quest.00000000AA000017.quest_desc: [
		"Mekanism Extras Tier."
		"Instant item movement."
	]
	quest.00000000AA000017.title: "&dInfinite Transporter"
	quest.00000000AA000018.quest_desc: [
		"&bConfigurator:&r The Wrench. Shift-Right Click pipe ends to change Push/Pull mode. Shift-Scroll to change mode (Gas/Fluid/Item/Energy). Right Click pipe centers to Color Code."
		"&bGauge Dropper:&r Essential for clearing fluids/gases from machine internal tanks. Right click a machine to grab contents, shift-right click air to dump."
		"&bDictionary:&r Shows Item Tags and OreDict entries."
	]
	quest.00000000AA000018.title: "&3Engineer Tools"
	quest.00000000AA00001A.quest_desc: ["Infinite Fluid Transfer."]
	quest.00000000AA00001A.title: "&dInfinite Mechanical Pipe"
	quest.00000000AA00001B.quest_desc: ["Infinite Gas Transfer."]
	quest.00000000AA00001B.title: "&dInfinite Pressurized Tube"
	quest.00000000AA00001C.quest_desc: ["Infinite Energy Transfer."]
	quest.00000000AA00001C.title: "&dInfinite Universal Cable"
	quest.00000000AA00001D.quest_desc: ["Infinite Heat Transfer."]
	quest.00000000AA00001D.title: "&dInfinite Heat Conductor"
	quest.00000000AA000020.quest_desc: [
		"A multiplayer essential."
		"Is it night? Are phantoms annoying you?"
		"Use the Sleeper to instantly set the time to Day. "
		"&#FF8F8ANote: this block set the total day in the world at 0 every night, so if you want a continuos timeline, don't use this block.&r"
		"If you are in a multiplayer server, use the command /gamerule playersSleepingPercentage 1."
		"It works without needing all players to sleep in a bed."
	]
	quest.00000000AA000020.title: "&eThe Sleeper"
	quest.00000000AA000021.quest_desc: [
		"The ultimate spelunking tool."
		"&eUsage:&r Hold it in your off-hand."
		"If the light level drops to 0 (pitch black), it will automatically place a torch at your feet."
		"&eMechanic:&r It does NOT use torches from your inventory. Instead, the Hot Torch itself takes damage and eventually breaks."
	]
	quest.00000000AA000021.title: "&6Torch Rod"
	quest.00000000AA000022.quest_desc: [
		"Safety first."
		"While worn, this helmet grants &bSlow Falling&r."
		"Never die from falling into a ravine or a deep cave again."
		"Essential for early game exploration before you find Andromeda gear."
	]
	quest.00000000AA000022.title: "&6Miner Hat"
	quest.00000000AA000023.quest_desc: [
		"The Wither boss is dangerous because of its wither effect."
		"This custom potion grants total immunity to Wither damage."
		"Drink it before the fight!"
	]
	quest.00000000AA000023.title: "&8Wither Resistance"
	quest.00000000AA000024.quest_desc: [
		"A multiblock tower."
		"Heats up fluids to concentrate them."
		"Water -> Brine."
		"Brine -> Liquid Lithium."
		"Crucial for 4x/5x processing and Fusion."
		"Even used for fission reactor ingredients."
	]
	quest.00000000AA000024.title: "&3Thermal Evaporation"
	quest.00000000AA000025.quest_desc: [
		"Quintuples your ores."
		"1. &bDissolution Chamber:&r Dissolves ore into Slurry using Sulfuric Acid."
		"2. &bWasher:&r Cleans slurry with Water."
		"3. &bCrystallizer:&r Turns clean slurry into Crystals."
	]
	quest.00000000AA000025.title: "&3Dissolution and Crystal (quintuplication)"
	quest.00000000AA000026.quest_desc: [
		"The chemical chain for 5x processing."
		"Sulfur -> Sulfur Dioxide -> Sulfur Trioxide -> Sulfuric Acid."
		"Requires Oxygen and Water Vapor."
	]
	quest.00000000AA000026.title: "&3Sulfuric Acid Chain"
	quest.00000000AA000030.quest_desc: [
		"NeoGundam adds Stone Bricks in ALL 16 Minecraft colors!"
		"No longer are you limited to gray castles."
		"Every color has a full set: Bricks, Stairs, Slabs, Walls, Fences, Gates, Trapdoors, and Doors."
	]
	quest.00000000AA000030.title: "&bBuilding Technicolor"
	quest.00000000AA000031.quest_desc: [
		"Craft some Red Stone Bricks."
		"Check JEI for the recipe."
	]
	quest.00000000AA000031.title: "&cRed Stone Bricks"
	quest.00000000AA000032.quest_desc: [
		"Craft some Blue Stone Bricks."
		""
	]
	quest.00000000AA000032.title: "&cBlue Stone Brick Slabs"
	quest.00000000AA000033.quest_desc: [
		"Craft some Yellow Stone Brick Stairs."
		""
	]
	quest.00000000AA000033.title: "&eYellow Stone Bricks Stairs"
	quest.00000000AA000034.quest_desc: [
		"Not just a fence."
		"This special fence emits light only when is night."
		"Use it to light up your pathways stylishly without spamming torches."
	]
	quest.00000000AA000034.title: "&6Redstone Fence"
	quest.00000000AA000035.quest_desc: [
		"The final material (UU Matter Equivalent)."
		"Used for Creative items, Gravity manipulation, and defying the laws of physics."
	]
	quest.00000000AA000035.title: "&dAntimatter"
	quest.00000000AA000040.quest_desc: [
		"Mekanism's Digital Storage."
		"Massive capacity, wireless access across dimensions."
		"Requires Polonium to craft."
	]
	quest.00000000AA000040.title: "&3QIO Storage"
	quest.00000000AA000041.quest_desc: ["Stores 16 Billion items per drive."]
	quest.00000000AA000041.title: "&3Supermassive QIO Drive"
	quest.00000000AA000050.quest_desc: [
		"The ultimate modular power armor."
		"Protects you from everything, including radiation and void damage, as long as it has power."
		"Install Modules using the Modification Station."
	]
	quest.00000000AA000050.title: "&3MekaSuit"
	quest.00000000AA000051.quest_desc: [
		"A universal multi-tool."
		"Insanely fast mining."
		"Right-click modes: Vein Miner, Fast, Slow, Off."
	]
	quest.00000000AA000051.title: "&3Atomic Disassembler"
	quest.00000000AA000052.quest_desc: [
		"The next step after the Atomic Disassembler."
		"Fully modular: add silk touch, fortune, teleportation, farming units, etc."
	]
	quest.00000000AA000052.title: "&3Meka-Tool"
	quest.00000000AA000060.quest_desc: [
		"Used to upgrade machines into Factories."
		"Basic: 3 Slots."
		"Advanced: 5 Slots."
		"Elite: 7 Slots."
		"Ultimate: 9 Slots."
		"Shift-Right Click a machine to apply."
	]
	quest.00000000AA000060.title: "&3Factory Installers"
	quest.00000000AA000061.quest_desc: ["Extras Tier 5 Factory."]
	quest.00000000AA000061.title: "&dAbsolute Installer"
	quest.00000000AA000062.quest_desc: ["Extras Tier 6 Factory."]
	quest.00000000AA000062.title: "&dSupreme Installer"
	quest.00000000AA000063.quest_desc: ["Extras Tier 7 Factory."]
	quest.00000000AA000063.title: "&dCosmic Installer"
	quest.00000000AA000064.quest_desc: ["The Final Factory Upgrade."]
	quest.00000000AA000064.title: "&dInfinite Installer"
	quest.00000000BA000000.quest_desc: [
		"We are moving beyond simple pipes."
		"This chapter introduces complex logic, multi-block management, and spatial compression."
		"Mastering these tools will allow you to automate absolutely anything."
	]
	quest.00000000BA000000.quest_subtitle: "Advanced Logic and Routing"
	quest.00000000BA000000.title: "&dAdvanced Automation"
	quest.00000000BA000010.quest_desc: [
		"XNet is an incredibly powerful item, fluid, energy, and gas transport system."
		"The &bController&r is the brain. It requires FE power."
		"Unlike other pipes, XNet does nothing until you program it in the Controller GUI."
		"You can handle complex logic on a single cable."
	]
	quest.00000000BA000010.title: "&bXNet Controller"
	quest.00000000BA000011.quest_desc: [
		"Cables connect the Controller to your machines."
		"They come in 4 colors (Blue, Red, Green, Yellow)."
		"&eNote:&r Different colored cables DO NOT connect to each other unless you use a Connector."
		"This allows you to run parallel networks in the same block space."
	]
	quest.00000000BA000011.title: "&bNetwork Cables"
	quest.00000000BA000012.quest_desc: [
		"Place a Connector on the machine you want to interact with."
		"In the Controller, you can name this connector (e.g., 'Furnace Input') to make programming easier."
		"One connector can handle Items, Fluids, Power, and Logic simultaneously."
	]
	quest.00000000BA000012.title: "&bConnectors"
	quest.00000000BA000013.quest_desc: [
		"Standard connectors are slow."
		"Right-click a connector with this upgrade to make it faster."
		"Essential for high-throughput systems."
	]
	quest.00000000BA000013.title: "&bConnector Upgrade"
	quest.00000000BA000014.quest_desc: [
		"Hide your XNet cables."
		"Mimics the block it is painted with."
	]
	quest.00000000BA000014.title: "&bFacades"
	quest.00000000BA000015.quest_desc: [
		"Allows you to link multiple XNet Controllers together remotely."
		"Useful for sharing data or items across different parts of your base without running long cables."
	]
	quest.00000000BA000015.title: "&bNetwork Router"
	quest.00000000BA000020.quest_desc: [
		"This block allows you to interact with another block remotely."
		"It creates a 'Quantum Entanglement'."
		"If you pipe items into this block, they will go into the linked block, no matter where it is."
		"Great for hiding messy cabling or accessing machines from multiple sides."
	]
	quest.00000000BA000020.title: "&dEntangled Block"
	quest.00000000BA000021.quest_desc: [
		"Used to link the Entangled Block."
		"1. Right-Click the target block (e.g., a Furnace) with the Binder."
		"2. Right-Click the Entangled Block with the Binder."
		"3. Done! The two are now linked."
	]
	quest.00000000BA000021.title: "&dEntangled Binder"
	quest.00000000BA000030.quest_desc: [
		"Keeps a small area of the world loaded even when you are away."
		"Essential for automated farms and machines."
		"Right-click to show the loaded area."
	]
	quest.00000000BA000030.title: "&aBasic Chunk Loader"
	quest.00000000BA000031.quest_desc: [
		"Loads a larger area."
		"Configurable radius."
	]
	quest.00000000BA000031.title: "&aAdvanced Chunk Loader"
	quest.00000000BA000032.quest_desc: [
		"The maximum chunk loading size."
		"For when your factory is truly massive."
	]
	quest.00000000BA000032.title: "&aUltimate Chunk Loader"
	quest.00000000BA000040.quest_desc: [
		"Your key to entering Compact Machines."
		"Right-click a Compact Machine block with this to teleport inside."
		"Right-click anywhere inside to teleport back out."
		"Also serves as the manual."
	]
	quest.00000000BA000040.title: "&6Personal Shrinking Device"
	quest.00000000BA000041.quest_desc: [
		"A 3x3x3 room inside a single block."
		"Small, but useful for simple automations."
	]
	quest.00000000BA000041.title: "&6Tiny Machine"
	quest.00000000BA000042.quest_desc: ["A 5x5x5 room."]
	quest.00000000BA000042.title: "&6Small Machine"
	quest.00000000BA000043.quest_desc: [
		"A 7x7x7 room."
		"The standard size for most setups."
	]
	quest.00000000BA000043.title: "&6Normal Machine"
	quest.00000000BA000044.quest_desc: ["A 9x9x9 room."]
	quest.00000000BA000044.title: "&6Large Machine"
	quest.00000000BA000045.quest_desc: ["A 11x11x11 room."]
	quest.00000000BA000045.title: "&6Giant Machine"
	quest.00000000BA000046.quest_desc: [
		"A 13x13x13 room."
		"The biggest space available."
	]
	quest.00000000BA000046.title: "&6Maximum Machine"
	quest.00000000BA000047.quest_desc: [
		"The crafting material for all Compact Machines."
		"Breakable with a pickaxe inside the machine."
	]
	quest.00000000BA000047.title: "&6Machine Walls"
	quest.00000000BA000050.quest_desc: [
		"Welcome to Ender IO."
		"To start, you need Grains of Infinity."
		"Light a fire on Bedrock and wait for it to go out (or crush it)."
	]
	quest.00000000BA000050.title: "&2Ender IO: The Beginning"
	quest.00000000BA000051.quest_desc: ["The base block for all simple machines."]
	quest.00000000BA000051.title: "&2Machine Chassis"
	quest.00000000BA000053.quest_desc: [
		"The powered version."
		"Much faster and runs on FE."
		"Has 3 input slots for advanced alloys."
	]
	quest.00000000BA000053.title: "&2Alloy Smelter"
	quest.00000000BA000054.quest_desc: [
		"Grinds ores and items."
		"Produces dusts and bonus outputs."
		"Use Grinding Balls (Dark Steel, Flint, etc.) to increase efficiency and output."
	]
	quest.00000000BA000054.title: "&2SAG Mill"
	quest.00000000BA000055.quest_desc: [
		"Generates power from solid fuel."
		"Can be upgraded with Capacitors to produce more RF/t."
	]
	quest.00000000BA000055.title: "&2Stirling Generator"
	quest.00000000BA000056.quest_desc: [
		"Used to craft machine heads and complex components."
		"Requires Shears and an Axe inside the machine to function."
	]
	quest.00000000BA000056.title: "&2Slice'N'Splice"
	quest.00000000BA000057.quest_desc: [
		"Uses XP (Liquid Experience) to bind soul vials to items."
		"Essential for Spawners and upgrading Dark Steel tools."
	]
	quest.00000000BA000057.title: "&2Soul Binder"
	quest.00000000BA000058.quest_desc: [
		"Spawns mobs using power."
		"Needs to be combined with a Broken Spawner in an Anvil or Soul Binder to set the mob type."
	]
	quest.00000000BA000058.title: "&2Powered Spawner"
	quest.00000000BA000060.quest_desc: [
		"The most versatile pipes in existence."
		"You can place Item, Fluid, Energy, and Redstone conduits IN THE SAME BLOCK."
		"Configure inputs/outputs with a Yeta Wrench."
		"Use Filters to control item flow."
	]
	quest.00000000BA000060.title: "&2Ender IO Conduits"
	quest.00000000BA000071.quest_desc: [
		"A sword that prevents Endermen from teleporting."
		"High damage, upgradable."
	]
	quest.00000000BA000071.title: "&2The Ender"
	quest.00000000BA000072.quest_desc: [
		"Allows teleportation between anchors."
		"Stand on one and look at another to jump."
		"Hold a Staff of Traveling to jump to any anchor from distance."
	]
	quest.00000000BA000072.title: "&2Travel Anchor"
	quest.00000000BA000073.quest_desc: [
		"Stores infinite amounts of Liquid XP."
		"Perfect for repairing tools or saving levels."
	]
	quest.00000000BA000073.title: "&2Experience Obelisk"
	quest.00000000BA000074.quest_desc: [
		"Machines are slow without these."
		"Basic -> Double Layer -> Octadic."
		"Each tier drastically increases speed and energy buffer."
	]
	quest.00000000BA000074.title: "&2Capacitors"
	quest.00000000CA000000.quest_desc: [
		"RFTools is a collection of mods that provide powerful utilities, tools, and the ability to create entire dimensions."
		"The Smart Wrench is your primary tool for configuring machines and selecting modes."
		"Switch modes by Shift-Right Clicking air."
	]
	quest.00000000CA000000.quest_subtitle: "Technology and Worlds"
	quest.00000000CA000000.title: "&9RFTools Suite"
	quest.00000000CA000001.quest_desc: [
		"The core material for RFTools machines."
		"Found in RFTools Dimensions, or rarely in the Overworld/Nether/End depending on generation."
		"You can also craft machines to 'Infuse' other machines with these shards to boost their speed and efficiency."
	]
	quest.00000000CA000001.title: "&9Dimensional Shards"
	quest.00000000CA000002.quest_desc: [
		"The base component for almost all RFTools machines."
		"Get used to crafting these."
	]
	quest.00000000CA000002.title: "&9Machine Frame"
	quest.00000000CA000010.quest_desc: [
		"The first step to creating a world."
		"This machine allows you to 'write' the DNA of a dimension onto an Empty Dimension Tab."
		"You insert 'Dimlets' (features like Biomes, Materials, Sky color) to define the world."
	]
	quest.00000000CA000010.title: "&dDimension Enscriber"
	quest.00000000CA000011.quest_desc: [
		"A blank canvas."
		"Put this into the Enscriber to start writing your dimension."
		"If you put it in alone without Dimlets, it will create a random world."
	]
	quest.00000000CA000011.title: "&dEmpty Dimension Tab"
	quest.00000000CA000012.quest_desc: [
		"Once you hit 'Store' in the Enscriber, you get this."
		"It contains the ID and data of your new dimension."
		"BUT WAIT! You can't enter yet. It has no power."
	]
	quest.00000000CA000012.title: "&dRealized Dimension Tab"
	quest.00000000CA000013.quest_desc: [
		"Place the Realized Dimension Tab here."
		"The Builder requires RF/FE energy to 'maintain' the dimension."
		"Complex dimensions cost more power."
		"If the power runs out while you are inside, you will die (unless you have a Phased Field Generator)."
	]
	quest.00000000CA000013.title: "&dDimension Builder"
	quest.00000000CA000014.quest_desc: [
		"&cCRITICAL ITEM!&r"
		"Keeps you alive in an unpowered dimension."
		"It uses energy from your inventory (charge it first!)."
		"Craft this BEFORE entering your first dimension, just in case."
	]
	quest.00000000CA000014.title: "&dPhased Field Generator"
	quest.00000000CA000015.quest_desc: [
		"Used to deconstruct Dimlets into their components or craft new ones."
		"Find Unknown Dimlets in End Cities or Dimensional Dungeons, research them, and use the parts here."
	]
	quest.00000000CA000015.title: "&dDimlet Workbench"
	quest.00000000CA000016.quest_desc: [
		"Decodes 'Unknown Dimlets' found in loot chests."
		"Also creates Knowledge that you need for the Workbench."
	]
	quest.00000000CA000016.title: "&dResearcher"
	quest.00000000CA000017.quest_desc: [
		"Allows you to extract the 'essence' of a block, biome, or fluid."
		"For specific dimlet, that allows you to create new dimensions, see the wiki."
	]
	quest.00000000CA000017.quest_subtitle: "https://ftbwiki.org/RFTools_Dimension_Manual"
	quest.00000000CA000017.title: "&dDimlet"
	quest.00000000CA000030.quest_desc: [
		"An extremely versatile machine."
		"It can Build, Copy, Swap, Pump, and Quarry."
		"Its function is defined by the Shape Card you put inside."
		"&eUsage:&r Click the card in the GUI to configure the area (Dimension, Offset, Size)."
	]
	quest.00000000CA000030.title: "&9The Builder"
	quest.00000000CA000031.quest_desc: [
		"Turns the Builder into a Quarry."
		"It mines the defined area and outputs items to an inventory ABOVE or BELOW the Builder."
		"&eTip:&r Use a 'Silk Touch' or 'Fortune' quarry card variants for better drops."
		"Replaces mined blocks with Dirt by default (to prevent lag/ugliness)."
	]
	quest.00000000CA000031.title: "&9Shape Card: Quarry"
	quest.00000000CA000032.quest_desc: [
		"Like the Quarry, but it mines the block completely, leaving air."
		"Great for digging massive holes."
	]
	quest.00000000CA000032.title: "&9Shape Card: Clearing Quarry"
	quest.00000000CA000033.quest_desc: [
		"Pumps liquids from the defined area."
		"Put a tank above or below the Builder to collect the fluid."
	]
	quest.00000000CA000033.title: "&9Shape Card: Pump"
	quest.00000000CA000034.quest_desc: [
		"Destroys blocks in the area."
		"No drops. Just destruction."
	]
	quest.00000000CA000034.title: "&9Shape Card: Void"
	quest.00000000CA000035.quest_desc: [
		"Used to define a 3D area for the Builder to Copy or Move."
		"1. Place the Controller at one corner."
		"2. Place Space Chamber blocks at the other corners (7 blocks total for a cube)."
		"3. Right-click the Controller with a Wrench to 'Form' the chamber."
		"4. Right-click the Controller with a Space Chamber Card to link it."
	]
	quest.00000000CA000035.title: "&9Space Chamber"
	quest.00000000CA000050.quest_desc: [
		"The 'From' part of a teleporter."
		"Stand on it to be beamed away."
		"Requires power."
		"Must be linked to a Receiver via a Dialing Device."
	]
	quest.00000000CA000050.title: "&9Matter Transmitter"
	quest.00000000CA000051.quest_desc: [
		"The 'To' part of a teleporter."
		"Requires power to receive matter safely."
		"You MUST place one of these in your newly created Dimension to get back!"
	]
	quest.00000000CA000051.title: "&9Matter Receiver"
	quest.00000000CA000052.quest_desc: [
		"The Controller for teleportation."
		"Place near a Transmitter."
		"It scans for all Receivers in the world (or other dimensions)."
		"Use it to 'Dial' a connection between the local Transmitter and a remote Receiver."
	]
	quest.00000000CA000052.title: "&9Dialing Device"
	quest.00000000CA000053.quest_desc: [
		"Handheld teleporter."
		"Shift-Right click on a Receiver to link."
		"Right-click to teleport home."
		"The Advanced version can store multiple destinations."
	]
	quest.00000000CA000053.title: "&9Charged Porter"
	quest.00000000CA000054.quest_desc: [
		"The poor man's AE2."
		"Scans all inventories (Chests, Barrels, etc.) in a configured radius."
		"Allows you to access ALL of them from a single interface."
		"Can be combined with a Tablet for remote access."
	]
	quest.00000000CA000054.title: "&9Storage Scanner"
	quest.00000000CA000055.quest_desc: [
		"Remote access to your Storage Scanner."
		"Craft a Tablet and a Storage Control Module."
		"Link the Module to the Scanner (Right click)."
		"Put the Module in the Tablet."
		"Enjoy wireless crafting."
	]
	quest.00000000CA000055.title: "&9Storage Tablet"
	quest.00000000CA000056.quest_desc: [
		"A chest that holds a Storage Module."
		"Tier 1: 100 stacks."
		"Tier 2: 200 stacks."
		"Tier 3: 300 stacks."
		"Compatible with the Storage Scanner."
	]
	quest.00000000CA000056.title: "&9Modular Storage"
	quest.00000000CA000057.quest_desc: [
		"An incredibly fast and compact auto-crafter."
		"Can hold up to 8 recipes at once (Tier 3)."
		"Inputs and Outputs can be configured per recipe."
		"Supports 'Fast Mode' for instant crafting."
	]
	quest.00000000CA000057.title: "&9The Crafter"
	quest.00000000CA000058.quest_desc: [
		"Displays information in the world."
		"Insert modules to show Energy, Fluids, Items, Time, Text, etc."
		"Modules must be linked to the target block first."
	]
	quest.00000000CA000058.title: "&9Screens"
	quest.00000000CA000070.quest_desc: [
		"Simple early game power."
		"Produces RF from coal/charcoal."
	]
	quest.00000000CA000070.title: "&9Coal Generator"
	quest.00000000CA000071.quest_desc: [
		"High power generation."
		"Requires a Blazing Agitator next to it."
		"Burns Blaze Rods. The Agitator boosts efficiency but consumes power."
	]
	quest.00000000CA000071.title: "&9Blazing Generator"
	quest.00000000CA000072.quest_desc: [
		"Generates massive power by ticking Ender Pearls."
		"Requires precise timing."
		"You need at least two generators, injectors, and a complex redstone timing circuit (or the Ender Monitor)."
		"Not for the faint of heart."
	]
	quest.00000000CA000072.title: "&9Endergenic Generator"
	quest.00000000CA000073.quest_desc: [
		"Multiblock Energy Storage."
		"All Powercells with the same ID (linked via Link Cards) share the same energy buffer wirelessly."
		"Can be upgraded with Dimensional Cells for extraction across dimensions."
	]
	quest.00000000CA000073.title: "&9Powercell"
	quest.00000000DA000000.quest_desc: [
		"The world is vast, vertical, and dangerous."
		"This chapter is dedicated to helping you move faster, fly higher, carry more, and survive harder hits."
		"From Waystones to Jetpacks, this is your quality of life upgrade."
	]
	quest.00000000DA000000.quest_subtitle: "Adventure Awaits"
	quest.00000000DA000000.title: "&6Exploration and Equipment"
	quest.00000000DA000010.quest_desc: [
		"Teleportation anchors."
		"Place one down and name it."
		"You can teleport between Waystones for a small XP cost (or free, depending on config)."
		"Essential for connecting bases and finding villages."
	]
	quest.00000000DA000010.title: "&5Waystones"
	quest.00000000DA000011.quest_desc: [
		"Pocket teleportation."
		"Allows you to teleport to any discovered Waystone from anywhere in the world."
		"Has a cooldown."
	]
	quest.00000000DA000011.title: "&5Warp Stone"
	quest.00000000DA000012.quest_desc: [
		"One-time use teleportation."
		"&bBound Scroll:&r Teleports to a specific Waystone you bind it to."
		"&bReturn Scroll:&r Teleports to the last activated Waystone."
		"Great for escaping caves quickly."
	]
	quest.00000000DA000012.title: "&5Scrolls"
	quest.00000000DA000013.quest_desc: [
		"Physical teleport pads."
		"Place two down and link them using shards/dust."
		"Step on one to instantly teleport to the other without opening a GUI."
		"Perfect for elevators or base-to-mine travel."
	]
	quest.00000000DA000013.title: "&5Warp Plate"
	quest.00000000DA000015.quest_desc: [
		"Simple vertical travel."
		"Place two elevators of the SAME COLOR on the same X and Z coordinates."
		"Jump to go up, Crouch to go down."
		"Max range is usually configurable, but covers most bases."
	]
	quest.00000000DA000015.title: "&fElevators"
	quest.00000000DA000020.quest_desc: [
		"Tired of running out of inventory space?"
		"PackedUp provides tiered backpacks."
		"The Basic one is small, but better than nothing."
	]
	quest.00000000DA000020.title: "&6Basic Backpack"
	quest.00000000DA000021.quest_desc: [
		"More slots."
		"Upgrade your basic backpack."
	]
	quest.00000000DA000021.title: "&6Iron Backpack"
	quest.00000000DA000022.quest_desc: [
		"Even more slots."
		"Shiny and spacious."
	]
	quest.00000000DA000022.title: "&6Gold Backpack"
	quest.00000000DA000023.quest_desc: [
		"Huge capacity."
		"Carry an entire mine in your pocket."
	]
	quest.00000000DA000023.title: "&6Diamond Backpack"
	quest.00000000DA000024.quest_desc: [
		"The ultimate portable storage."
		"Blast resistant and massive."
	]
	quest.00000000DA000024.title: "&6Obsidian Backpack"
	quest.00000000DA000025.quest_desc: [
		"Like an Ender Chest, but better."
		"Often provides way more storage per slot or channel capabilities."
		"Access your items across dimensions."
	]
	quest.00000000DA000025.title: "&cNether Chest"
	quest.00000000DA000030.quest_desc: [
		"The base component for all Jetpacks."
		"You cannot fly with just this, but you can't fly without it."
	]
	quest.00000000DA000030.title: "&bJetpack Strap"
	quest.00000000DA000031.quest_desc: [
		"It flies... sort of."
		"Very low fuel, very slow."
		"Don't fall."
	]
	quest.00000000DA000031.title: "&bWood Jetpack"
	quest.00000000DA000032.quest_desc: [
		"Heavy, but sturdy."
		"Slightly better than wood."
	]
	quest.00000000DA000032.title: "&bStone Jetpack"
	quest.00000000DA000033.quest_desc: [
		"Now we are talking."
		"Decent flight speed and fuel capacity."
		"Standard industrial flight."
	]
	quest.00000000DA000033.title: "&bIron Jetpack"
	quest.00000000DA000034.quest_desc: [
		"Fast, but consumes energy quickly."
		"Gold conducts energy well, allowing for high speed bursts."
	]
	quest.00000000DA000034.title: "&bGold Jetpack"
	quest.00000000DA000035.quest_desc: [
		"High durability (fuel tank) and great speed."
		"A luxury item for the wealthy explorer."
	]
	quest.00000000DA000035.title: "&bDiamond Jetpack"
	quest.00000000DA000036.quest_desc: [
		"Top tier gem jetpack."
		"Exceptional control and capacity."
	]
	quest.00000000DA000036.title: "&bEmerald Jetpack"
	quest.00000000DA000037.quest_desc: [
		"&5Infinite Flight."
		"&5Infinite Energy."
		"&5Infinite Swag."
		"The ultimate goal of verticality."
	]
	quest.00000000DA000037.title: "&d&lCreative Jetpack"
	quest.00000000DA000040.quest_desc: [
		"Vanilla armor is boring."
		"Immersive Armors adds many new sets with unique effects."
		"Some protect against magic, some make you faster, some are just tanky."
		"Explore the recipes!"
	]
	quest.00000000DA000040.title: "&cImmersive Armors"
	quest.00000000DA000041.quest_desc: [
		"Forged from the bones of the Wither."
		"Provides protection against Wither effect and high durability."
	]
	quest.00000000DA000041.title: "&cWither Armor"
	quest.00000000DA000042.quest_desc: [
		"Radiates power."
		"Excellent protection."
	]
	quest.00000000DA000042.title: "&cDivine Armor"
	quest.00000000DA000050.quest_desc: [
		"Netherite is not the end."
		"You can alloy Netherite with other materials to create specialized heavy plating."
		"Start by mixing Netherite with Iron."
	]
	quest.00000000DA000050.title: "&4Advanced Netherite"
	quest.00000000DA000051.quest_desc: [
		"The next tier."
		"Better enchantability and durability."
		"Used to upgrade Netherite Iron gear."
	]
	quest.00000000DA000051.title: "&4Netherite Gold"
	quest.00000000DA000052.quest_desc: [
		"Infused with the strength of Emeralds."
		"Massive durability."
	]
	quest.00000000DA000052.title: "&4Netherite Emerald"
	quest.00000000DA000053.quest_desc: [
		"The pinnacle of Advanced Netherite."
		"Unmatched defense and toughness."
	]
	quest.00000000DA000053.title: "&4Netherite Diamond"
	quest.00000000DA000060.quest_desc: [
		"Are you wearing ugly mixed armor just for the stats?"
		"You can wear a second set of armor purely for looks and hide your real armor!"
	]
	quest.00000000DA000060.title: "&dCosmetic Armor"
	quest.00000000EA000000.quest_desc: [
		"Forget golden carrots."
		"It is time to cook REAL food."
		"Better food gives you the &bNourished&r effect, which prevents hunger loss and heals you passively."
		"This chapter covers advanced agriculture and building a fully functional kitchen."
	]
	quest.00000000EA000000.quest_subtitle: "Culinary Arts"
	quest.00000000EA000000.title: "&6Farming and Cooking"
	quest.00000000EA000001.quest_desc: [
		"The essential tool for any chef."
		"1. Use it to cut items on a Cutting Board."
		"2. Use it to harvest Grass to get &eStraw&r."
		"3. Use it to harvest Cake slices."
		"4. It also functions as a weak weapon."
	]
	quest.00000000EA000001.title: "&6The Knife"
	quest.00000000EA000002.quest_desc: [
		"Place this down to process ingredients."
		"Right-click with an item to place it, then right-click with a Knife to cut."
		"Examples:"
		"- Raw Fish -> Salmon Slices + Bone Meal"
		"- Log -> Stripped Log + Bark"
		"- Saddle -> Leather"
	]
	quest.00000000EA000002.title: "&6Cutting Board"
	quest.00000000EA000003.quest_desc: [
		"Obtained by cutting Grass with a Knife."
		"Essential for making Canvas, Rope, and Compost."
	]
	quest.00000000EA000003.title: "&6Straw"
	quest.00000000EA000004.quest_desc: [
		"Crafted with Dirt, Straw, Bone Meal, and rotten material (Rotten Flesh, Food, etc.)."
		"Place it in the world."
		"Over time (accelerated by sunlight and water), it will turn into &bRich Soil&r."
		"Use Activators near it to speed up the process."
	]
	quest.00000000EA000004.title: "&6Organic Compost"
	quest.00000000EA000005.quest_desc: [
		"The best dirt for farming."
		"Crops planted on Rich Soil grow faster and cannot be trampled."
		"It can be tilled into Rich Soil Farmland."
	]
	quest.00000000EA000005.title: "&6Rich Soil"
	quest.00000000EA000010.quest_desc: [
		"&eLocation:&r Found in sandy biomes, beaches, and sometimes plains."
		"Break wild crops to get seeds."
		"Used for salads and stews."
	]
	quest.00000000EA000010.title: "&aWild Cabbage"
	quest.00000000EA000011.quest_desc: [
		"&eLocation:&r Found in hot or dry biomes (Savannas, Badlands)."
		"Tomatoes are a climbing crop (like vines), use Rope or sticks."
		"Essential for Pasta and Pizza."
	]
	quest.00000000EA000011.title: "&aWild Tomatoes"
	quest.00000000EA000012.quest_desc: [
		"&eLocation:&r Found in temperate biomes (Forests, Plains)."
		"A staple ingredient for many dishes to add flavor."
	]
	quest.00000000EA000012.title: "&aWild Onions"
	quest.00000000EA000013.quest_desc: [
		"&eLocation:&r Found in wet biomes (Swamps, Jungles, River banks)."
		"Must be planted in 1 block deep water (like kelp, but on surface)."
		"Used to make Cooked Rice and Kanelbulle."
	]
	quest.00000000EA000013.title: "&aWild Rice"
	quest.00000000EA000020.quest_desc: [
		"An upgraded Campfire."
		"Can cook 6 items at once."
		"Provides heat for the Cooking Pot and Skillet."
		"Does not require fuel if placed on top of a heat source (Magma Block, Lava, etc.)!"
	]
	quest.00000000EA000020.title: "&6The Stove"
	quest.00000000EA000021.quest_desc: [
		"The main cooking station."
		"Place ON TOP of a Stove (or fire)."
		"Put ingredients in (up to 6 types) + a container (Bowl/Bottle)."
		"Result: Complex meals like Stews, Pasta, and Soups."
		"Can be automated with hoppers/pipes (Side: Ingredients, Bottom: Output)."
	]
	quest.00000000EA000021.title: "&6Cooking Pot"
	quest.00000000EA000022.quest_desc: [
		"Place on a Stove to cook items quickly."
		"Hold shift to place items on it."
		"Can also be used as a weapon (Bonk!) with high knockback."
	]
	quest.00000000EA000022.title: "&6Skillet"
	quest.00000000EA000030.quest_desc: [
		"This mod connects all your food storage into one multiblock kitchen."
		"The Recipe Book shows you what you can cook with the items you CURRENTLY HAVE in your inventory/kitchen."
	]
	quest.00000000EA000030.title: "&bCooking for Blockheads"
	quest.00000000EA000031.quest_desc: [
		"The Brain of the Kitchen."
		"Place this down, and place other kitchen blocks (Fridge, Sink, Cabinets) TOUCHING it."
		"Right-click the table to see all recipes available using ingredients from ALL connected blocks."
		"One click crafting."
	]
	quest.00000000EA000031.title: "&bCooking Table"
	quest.00000000EA000032.quest_desc: [
		"Smelts food."
		"If connected to the Cooking Table, you can order cooked items directly."
		"Can be upgraded with 'Heating Unit' to run on RF instead of Coal."
	]
	quest.00000000EA000032.title: "&bThe Oven"
	quest.00000000EA000033.quest_desc: [
		"Provides INFINITE water."
		"Essential for recipes requiring water buckets or bottles."
		"Also works as an infinite water source for other mods' pipes."
	]
	quest.00000000EA000033.title: "&bThe Sink"
	quest.00000000EA000034.quest_desc: [
		"Stores food items."
		"If you have the 'Preservation Chamber' upgrade, it prevents food from rotting (if playing with rotting mods)."
		"Can make Ice if upgraded with 'Ice Unit'."
	]
	quest.00000000EA000034.title: "&bThe Fridge"
	quest.00000000EA000035.quest_desc: [
		"Infinite Milk Source."
		"How to craft: Place a Milk Jar in the world. Drop an Anvil on a Cow directly above the jar."
		"The cow will... fit inside."
		"Sorry, cow."
	]
	quest.00000000EA000035.title: "&bCow in a Jar"
	quest.00000000EA000036.quest_desc: [
		"Wall storage for ingredients."
		"Connects to the Cooking Table network."
	]
	quest.00000000EA000036.title: "&bSpice Rack"
	quest.00000000EA000037.quest_desc: [
		"Turns Bread into Toast."
		"Requires RF energy (or a redstone signal depending on config)."
		"Toast is tasty."
	]
	quest.00000000EA000037.title: "&bToaster"
	quest.00000000EA000040.quest_desc: [
		"Can't find a specific seed or sapling?"
		"The Market sells almost every seed, sapling, and flower in the game."
		"Currency: Emeralds."
	]
	quest.00000000EA000040.title: "&2The Market"
	quest.00000000EA000041.quest_desc: [
		"Auto-breeder for animals."
		"1. Fill it with animal food (Carrots, Wheat, Seeds)."
		"2. Animals nearby will eat from it and enter 'Love Mode'."
		"3. Use it to keep your animal population high automatically."
	]
	quest.00000000EA000041.title: "&2Feeding Trough"
	quest.00000000EA000042.quest_desc: [
		"Boost crop growth."
		"Red: Growth speed."
		"Green: Output increase."
		"Yellow: Prevents trampling (if not using Rich Soil)."
	]
	quest.00000000EA000042.title: "&2Fertilizers"
	quest.00000000FA000000.quest_desc: [
		"Minecraft is about building."
		"This chapter provides you with the ultimate tools to build faster, copy structures, and detail your base with thousands of variations."
		"From tech gadgets to living room chairs."
	]
	quest.00000000FA000000.quest_subtitle: "Supreme Designer"
	quest.00000000FA000000.title: "&eCostruction and Design"
	quest.00000000FA000010.quest_desc: [
		"Place blocks from your inventory remotely."
		"Modes: Build to Me, Vertical Wall, Floor, Stairs, Grid."
		"Press the 'Settings Menu' button (controls keybinds) to configure range and mode."
	]
	quest.00000000FA000010.title: "&9Building Gadget"
	quest.00000000FA000011.quest_desc: [
		"Swap blocks in the world with those in your inventory."
		"Perfect for changing floors or walls without having to break everything first."
	]
	quest.00000000FA000011.title: "&9Exchanging Gadget"
	quest.00000000FA000012.quest_desc: [
		"Select an area, copy it, and paste it elsewhere."
		"Consume the necessary blocks from your inventory."
		"Can also copy the contents of chests (if configured)."
	]
	quest.00000000FA000012.title: "&9Copy-Paste Gadget"
	quest.00000000FA000013.quest_desc: [
		"Allows you to save your builds to \"Paper\" or file."
		"Copy the build code to share it with friends or paste builds downloaded from the internet."
	]
	quest.00000000FA000013.title: "&9Template Manager"
	quest.00000000FA000014.quest_desc: [
		"Moves a structure from A to B."
		"Removes the original blocks."
		"Be careful not to lose the gadget while it has the structure in memory!"
	]
	quest.00000000FA000014.title: "&9Cut-Paste Gadget"
	quest.00000000FA000015.quest_desc: [
		"&cWARNING:&r Destroys blocks into nothing."
		"Removes large areas of blocks instantly. No drops."
		"Great for clearing an area for a base."
	]
	quest.00000000FA000015.title: "&9Destruction Gadget"
	quest.00000000FA000020.quest_desc: [
		"Extends your building range."
		"Click on the face of a block to place more identical blocks from your inventory in that direction."
		"Hold Shift + Scroll to change modes (Horizontal, Vertical, Unlimited)."
	]
	quest.00000000FA000020.title: "&aConstruction Sticks"
	quest.00000000FA000021.quest_desc: [
		"Faster and more durable."
		"You can apply 'Core's' for extra functions (like placing blocks in the air)."
	]
	quest.00000000FA000021.title: "&aDiamond Stick"
	quest.00000000FA000022.quest_desc: [
		"Functional and decorative blocks that look vanilla."
		"&bSack:&r A portable, deployable backpack."
		"&bSafe:&r A private, hard-to-break chest."
		"And much more (Globes, Taps, Road Signs)."
	]
	quest.00000000FA000022.title: "&6Supplementaries"
	quest.00000000FA000023.quest_desc: [
		"Improves existing vanilla blocks."
		"It allows you to place lanterns on walls in new ways, improves signs, and makes water interact with more blocks."
	]
	quest.00000000FA000023.title: "&6Amendments"
	quest.00000000FA000030.quest_desc: [
		"The classic tool."
		"Hold it and right-click."
		"Insert a block (e.g., Cobblestone) to transform it into dozens of decorative variations."
		"Works only in the inventory."
	]
	quest.00000000FA000030.title: "&bThe Chisel"
	quest.00000000FA000031.quest_desc: [
		"Chipped adds THOUSANDS of blocks."
		"You must create the specific table for the material:"
		"- &bBotanist:&r Flowers and Plants."
		"- &bGlassblower:&r Glass."
		"- &bCarpenter:&r Wood."
		"- &bMason:&r Stone."
		"- &bLoom:&r Wool."
		"- &bAlchemy:&r Obsidian/Glowstone."
		"- &bTinker:&r Redstone/Metals."
	]
	quest.00000000FA000031.title: "&bChipped Workbenches"
	quest.00000000FA000032.quest_desc: [
		"A suite of industrial blocks."
		"Fans, decorative pipes, metal grates, rusty sheets of metal."
		"Perfect for building realistic factories."
	]
	quest.00000000FA000032.title: "&bFactory Blocks"
	quest.00000000FA000033.quest_desc: [
		"More colors for the world!"
		"Adds intermediate color variants (e.g., Peal, Aquamarine, etc.) for wool, terracotta, concrete, and more."
	]
	quest.00000000FA000033.title: "&bDyenamics"
	quest.00000000FA000040.quest_desc: [
		"Vanilla-style furniture."
		"Chairs, stools, tables, sofas."
		"You can sit on chairs and sofas."
	]
	quest.00000000FA000040.title: "&dAnother Furniture"
	quest.00000000FA000041.quest_desc: [
		"Essential for modifying furniture."
		"Right-click on tables or chairs to change the type of leg, armrest, or backrest."
		"This is used to join tables into one large piece."
	]
	quest.00000000FA000041.title: "&dFurniture Hammer"
	quest.00000000FA000042.quest_desc: [
		"Giant doors, sliding doors, barn doors."
		"An incredible variety for every architectural style."
	]
	quest.00000000FA000042.title: "&dMacaw's Doors"
	quest.00000000FA000043.quest_desc: [
		"Like doors, but trapdoors."
		"Great for details, windows, or secret passages."
	]
	quest.00000000FA000043.title: "&dMacaw's Trapdoors"
	quest.00000000FA000044.quest_desc: ["Don't miss out on all the dozens of doors and other decoration blocks!"]
	quest.00000000FA000044.title: "&dOther Doors"
	quest.00000000FA000045.quest_desc: [
		"Break the grid!"
		"Allows you to place diagonal fences that visually connect."
		"Perfect for more natural animal enclosures."
	]
	quest.00000000FA000045.title: "&dDiagonal Fences"
	quest.011F6A81EFF2F28C.quest_desc: [
		"Why use coal? Electricity works twice as fast, so coal could be used for something else..."
		"The Electric Drill works with any pipe/conduit/energy cable, both for input (for energy) and output (for mined materials)."
		"Eco-friendly!"
		""
		"&4Important: You can spam as many drills as you want in a chunk, this will speed up ore extraction, but it will only empty the chunk faster, you won't have infinite ore ;)&r"
	]
	quest.011F6A81EFF2F28C.title: "&bElectric Drill"
	quest.01A89E3B5F7E2AB3.title: "Solid Compact Machine Wall"
	quest.01CCBDECC9B7AF30.quest_desc: ["A stealthy predator. Keep your eyes open."]
	quest.01CCBDECC9B7AF30.quest_subtitle: "Unseen Threat"
	quest.01CCBDECC9B7AF30.title: "&6Hunter: The Stalker"
	quest.025A0BAE7C4B8CFE.quest_subtitle: "Use the bricks for create more furnitures!"
	quest.02CC69FDB600B502.quest_desc: [
		"Biomes O' Plenty adds many new wood types."
		"Redwood, Willow, Palm, Mahogany... try to find some Redwood logs as a start."
	]
	quest.02CC69FDB600B502.quest_subtitle: "New Building Blocks"
	quest.02CC69FDB600B502.title: "&6Exotic Woods"
	quest.03A9CE094A4C34F9.quest_subtitle: "Let's try other colors!"
	quest.03A9CE094A4C34F9.title: "&6Coral Punch Deepslate Brick"
	quest.040E77FDC29AF7AD.quest_desc: ["There are 9 painting made whit AI."]
	quest.040E77FDC29AF7AD.title: "&bCustom Painting"
	quest.05062D31E97F1824.quest_desc: ["Can void items, fluids, and energy all at once."]
	quest.05062D31E97F1824.title: "&aUltimate Trash Can"
	quest.054775AC602BE51E.quest_desc: ["High durability and drop rates. Essential for late-game manual sifting."]
	quest.054775AC602BE51E.quest_subtitle: "Tier 4 Sifting"
	quest.054775AC602BE51E.title: "&aDiamond Mesh"
	quest.0580A665798CB42C.quest_desc: [""]
	quest.0580A665798CB42C.quest_subtitle: "Laaaaaaaarge backpack."
	quest.059A8C59EAD2AC1A.quest_subtitle: "There are many usefull upgrades!"
	quest.05D04FBB1DED21EB.quest_subtitle: "There are many usefull upgrades!"
	quest.065863C1A36C90D9.quest_subtitle: "A huuuuuge chest."
	quest.07DAA049AC96F93C.quest_desc: ["Fire resistant and maximum storage."]
	quest.07DAA049AC96F93C.title: "&aNetherite Backpack"
	quest.08622D0C53DF84EB.quest_subtitle: "There are many usefull upgrades!"
	quest.091B4D52A840809B.quest_subtitle: "A necessary block for autocrafting. Hold G for Guide."
	quest.09E3EEC09DF8FADD.quest_desc: [
		"Craft Porcelain Clay using Clay and Bone Meal."
		"Necessary for handling hot fluids like Lava."
	]
	quest.09E3EEC09DF8FADD.quest_subtitle: "Heat Resistant"
	quest.09E3EEC09DF8FADD.title: "&aPorcelain"
	quest.09F9BFFE08FA51F1.quest_subtitle: "An altar for Awakened and create augments."
	quest.0B0DFF847ADE023E.quest_desc: [
		"Craft an Unfired Crucible, then cook it in a furnace."
		"Place the Crucible over a heat source (Torch, Lava, Fire) and insert Cobblestone to melt it into Lava."
	]
	quest.0B0DFF847ADE023E.quest_subtitle: "Making Lava"
	quest.0B0DFF847ADE023E.title: "&aCrucible"
	quest.0BC84179409D28D5.quest_desc: [
		"The Tier 2 Alloy."
		"Made by infusing Infused Alloy with Diamond Dust."
	]
	quest.0BC84179409D28D5.title: "&3Reinforced Alloy"
	quest.0C15752BB53EE2E1.quest_desc: [
		"It is time to stop doing everything by hand."
		"In this chapter, we will automate resource gathering, farming, and logistics."
		"We will also introduce the first powered machines."
	]
	quest.0C15752BB53EE2E1.quest_subtitle: "Machines taking over"
	quest.0C15752BB53EE2E1.title: "&eBasic Automation"
	quest.0D77A78F73C2D0F6.quest_desc: [
		"Quadruples your ores."
		"Uses &bHydrogen Chloride&r to process ores into Shards."
		"Requires a Thermal Evaporation Plant to convert Water -> Brine -> Lithium/Chlorine."
	]
	quest.0D77A78F73C2D0F6.title: "&3Injection Chamber (quadruplication)"
	quest.0F0B11B076054855.quest_subtitle: "The cable of Refined Storage. You can links all the refined blocks whit 1 cable!"
	quest.1000000000000003.quest_desc: [
		"Your best friend for navigation."
		""
		"&eKeybinds:&r"
		"- Press &6[J]&r to open the full screen map."
		"- Press &6[B]&r to create a Waypoint at your current location."
		"- Check the options to configure the Mini-map and the key-map in the corner of your screen."
	]
	quest.1000000000000003.quest_subtitle: "Never get lost"
	quest.1000000000000003.title: "&6JourneyMap"
	quest.1000000000000005.quest_desc: [
		"Looking for a specific biome? The Nature's Compass can locate it for you."
		"Right-click with it to open the biome selection GUI."
		"It will display the coordinates and distance to the nearest biome of that type."
	]
	quest.1000000000000005.quest_subtitle: "Finding Biomes"
	quest.1000000000000005.title: "&6Nature's Compass"
	quest.103D40E05D84D966.quest_subtitle: "Armor, sword, bow... The definitive upset."
	quest.1292F506A36F7EA6.quest_desc: ["The last tier. Has 176 inventory slots."]
	quest.1292F506A36F7EA6.title: "&6Explorer Friend"
	quest.139A980C250B66E3.quest_desc: [
		"Doubles your ores."
		"Input: Raw Ore -> Output: 2x Dust."
		"Also used to enrich materials like Diamond, Redstone, and Carbon for more efficient infusing."
	]
	quest.139A980C250B66E3.title: "&3Enrichment Chamber (duplication)"
	quest.13CEDBFF33F5F376.quest_desc: [
		"The world is vast and full of dangers... and treasures."
		"In this chapter, we will look at tools to help you navigate, new biomes to discover, and a dark dimension waiting beneath the surface."
	]
	quest.13CEDBFF33F5F376.quest_subtitle: "Exploring the Unknown"
	quest.13CEDBFF33F5F376.title: "&6World Interaction"
	quest.14651663414BAC09.quest_desc: [
		"This is the beginning of the end-game exploration for this chapter."
		"You must venture into the Deep Dark and find an Ancient City."
		"&cThe Warden is dangerous, but you can farm it.&r"
	]
	quest.14651663414BAC09.quest_subtitle: "Prepare yourself"
	quest.14651663414BAC09.title: "&6The Deep Dark"
	quest.1480F5F6243CA161.quest_desc: [
		"Bridge between Refined Storage and other systems."
		"The &bRequester&r block allows you to keep a specific amount of items in an inventory (like a chest or a machine input) by automatically requesting them from your RS system."
		"Acts like a crafting card but for external blocks."
	]
	quest.149BF7064A23FF61.quest_desc: ["The middle backpack has 72 inventory slots."]
	quest.149BF7064A23FF61.title: "&6Adventure Bag"
	quest.14A8552D81D4DF9A.quest_desc: ["For you."]
	quest.1518FEB1F0EB6605.quest_subtitle: "Thats all... Infinite item! Thanks for play!"
	quest.1518FEB1F0EB6605.title: "&cThe end of my modpack"
	quest.153E843FD446AD42.quest_subtitle: "There are many upgrades."
	quest.16AD5BA3B2CF2E57.quest_subtitle: "No more space problem!"
	quest.16DF96E076EA0189.quest_desc: [
		"This machine fires a laser that transmutes items thrown in front of it."
		"It requires Crystal Flux (CF/RF) energy."
		"Use it to convert Redstone into Restonia, Lapis into Palis, and much more."
	]
	quest.16DF96E076EA0189.quest_subtitle: "&3The Transmuter"
	quest.16DF96E076EA0189.title: "&2Atomic Reconstructor"
	quest.18CF092496594303.quest_desc: [
		"Look for Crystallized Amber inside geodes or ancient vases."
		"It is used for crafting powerful gear."
	]
	quest.18CF092496594303.quest_subtitle: "Rare Gem"
	quest.18CF092496594303.title: "&6Crystallized Amber"
