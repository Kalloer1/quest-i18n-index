	file.0000000000000001.title: "&bCreate: Stranded"
	quest.0170E6442F98867A.quest_desc: [
		"Chromatic Compound is a material made with Crushed Obsidian, Rose Quartz and Glowstone in a Superheated Blaze Burner."
		""
		"It is the base ingredient for both Shadow Essence and Refined Radiance."
	]
	quest.0170E6442F98867A.quest_subtitle: "&oClick for more information"
	quest.031ECB257B232E54.title: "Miniboss: Warden"
	quest.04298CB0B50321C9.quest_desc: ["Now you have your Ender Eyes you can follow them to a Stronghold like vanilla and battle the Ender Dragon!"]
	quest.04298CB0B50321C9.quest_subtitle: "&oClick for more information"
	quest.04298CB0B50321C9.title: "The End..."
	quest.05548BDD9D85F701.title: "Miniboss: Warped Mosco"
	quest.07E7BD89DF252823.title: "Miniboss: Lifestealer"
	quest.09DAB3ED3B4AD03A.quest_desc: ["Nether Crystals can either be obtrained through Archeology or Crafting Crying Obsidian with Amethyst."]
	quest.09DAB3ED3B4AD03A.quest_subtitle: "&oClick for more information"
	quest.0B3A55E33A3298D4.quest_desc: [
		"Printers can be used to duplicate the contents of books and other items!"
		""
		"Simply add the item you want to copy in the filter slot and then feed below it with either a book or other item to copy the contents over!"
		""
		"Using Ink or Dye allows you to copy coloured text for things like nametags or books."
		"Using Experience allows you to copy enchanted books!"
	]
	quest.0B3A55E33A3298D4.quest_subtitle: "&oClick for more information"
	quest.0CC1ABBB6017BEC3.quest_desc: [
		"Cables are used to transport energy, like all components each wire has its limitations on what current and voltage it can handle!"
		""
		"Connect machines or connectors with wires in a full circuit to make your system work, follow real electricity principles you probably forgot from School!"
	]
	quest.0CC1ABBB6017BEC3.quest_subtitle: "&oClick for more information"
	quest.0FBFDF9D5A775894.quest_desc: ["Sifters can be used to sift organic matter for useful items!"]
	quest.0FBFDF9D5A775894.quest_subtitle: "&oClick for more information"
	quest.0FBFDF9D5A775894.title: "Sifting"
	quest.1003D863C0EFF5FA.quest_desc: ["Positive and Negative charges in one tidy sleeve!"]
	quest.1003D863C0EFF5FA.quest_subtitle: "&oClick for more information"
	quest.111CDEC3F16C73D7.quest_desc: [
		"String, Industrial and Brass Meshes can be used to to sift leaves for Fruit, Fertilizer, Compost and Slimeballs!"
		""
		"Each tier of Mesh reduces the risk of less desirable items like Sticks and Worms and increases the chance of rarer drops."
	]
	quest.111CDEC3F16C73D7.quest_subtitle: "&oClick for more information."
	quest.124F14FB1C4080BA.quest_subtitle: "Dropped by the Wither"
	quest.1329607D5FE18922.title: "Bulk Processing"
	quest.141F49585C6640FD.quest_desc: ["Crafted using Glass and Crying Obsidian."]
	quest.141F49585C6640FD.quest_subtitle: "&oClick for more information"
	quest.15C07E3987E162BF.quest_desc: [
		"Fire Charges can be automated by using a Tree Farm for the Charcoal, Blaze Farm/Crushing Scorcia for Blaze Rods and Gunpowder can be crafted by combining them. "
		""
		"Using these 3 ingredients you can craft yourself 1 Fire Charge, you need 16 per Ender Eye, so automation is recommended"
	]
	quest.15C07E3987E162BF.quest_subtitle: "&oClick for more information"
	quest.168EC9145E7276E7.quest_subtitle: "&oClick for more information"
	quest.16FFD092079280FE.quest_desc: ["No longer is creativity limited by how much Andesite you can find, now you can use any stone to create \"Industrial Alloy\" which has replaced the Andesite Alloy of old."]
	quest.16FFD092079280FE.quest_subtitle: "&oClick for more information"
