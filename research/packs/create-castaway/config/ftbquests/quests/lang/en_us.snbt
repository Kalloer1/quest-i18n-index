	quest.1869FC78ECE2BF14.title: "Miniboss: Missionary"
	quest.19B6E032E51A9429.quest_desc: ["These blocks are pretty essential for monitoring how your system is running to prevent any short circuits or explosions!"]
	quest.19B6E032E51A9429.quest_subtitle: "&oClick for more information"
	quest.19B6E032E51A9429.title: "Getting a Gauge of things..."
	quest.1B0D64F8BFC54F29.title: "Bulk Washing"
	quest.1C98935C4661DEB0.title: "Bulk Freezing"
	quest.1F01FE2B2875998C.quest_subtitle: "&oClick for more information"
	quest.1F0A44B8FA3A9947.quest_desc: [
		"The ultimate alloy, a combination of both Shadow Steel and Refined Radiance that allows you to benefit from both's powerful properties!"
		""
		"If you plan on making the full Shadow Radiance set of Armour and Tools or Glitch Gems it is recommended you automate Chromatic Compound."
	]
	quest.1F0A44B8FA3A9947.quest_subtitle: "&oClick for more information."
	quest.2148CB0D9D5EFEFE.title: "Components"
	quest.218AD5663FB34C06.title: "Bulk Blasting"
	quest.23E42E485005CDE0.quest_desc: [
		"Survivng on an Island is tough, to help with this essential Create Mod items have alternative means to obtain them, allowing you to get straight into the fun!"
		""
		"String is essential for sails and wool, this can be obtained through vanilla means (sheep, spiders) or using Flax, you can obtain Flax Seeds by breaking Grass and Wild Flax."
		""
		"Slimeballs are essential for gluing your contraptions together, it can be crafted using Leaves, Sea Grass and Water or easily automated using Dough and Lime Dye."
	]
	quest.23E42E485005CDE0.quest_subtitle: "&oClick for more information"
	quest.23E42E485005CDE0.title: "Essential Materials"
	quest.276A838E8299A0B4.title: "Bulk Haunting"
	quest.2833ADACDCFA7875.quest_desc: [
		"Glitch Gem Blocks are used to make \"Creative Items\". These are overpowered, usually creative-mode exclusive, items or blocks that will practically make you a god."
		""
		"Some more powerful Creative Items may require specific extra items like boss drops and the strongest may require artifacts that contain multiplicative properties, this means Creative Items are more of an extra grind for after you have completed the main content of the modpack."
		""
		"You could within theory mine the Glitch Ores Manually but unless you want to be doing it your entire life... I'd just make a farm for them at this point."
	]
	quest.2833ADACDCFA7875.quest_subtitle: "&oClick for more information."
	quest.2833ADACDCFA7875.title: "Creative Items"
	quest.28F2F82F2E99DCB8.quest_subtitle: "A metal found in The End"
	quest.2B5E4295C5407F5F.quest_subtitle: "&oClick for more information"
	quest.2BF26F49ED0706D5.title: "Boss: Void Worm"
	quest.2CF0002C7FB23911.quest_desc: [
		"By using these blocks you can convert rotational energy into electricity!"
		""
		"The bigger you build this, and the more sides you cover with coils the more power you can generate!"
	]
	quest.2CF0002C7FB23911.quest_subtitle: "&oClick for more information"
	quest.2CF0002C7FB23911.title: "Generators"
	quest.2F374DBE6CF01A66.quest_desc: [
		"The Farseer Arm can only be found from Farseers, mobs that only spawn in and very close to the Farlands which spawns 12,550,823 blocks away from the World Center."
		""
		"The usual way to get there (the Dimensional Carver) cannot be shattered to instantly teleport there so you have a long journey to get there."
		""
		"Make yourself an amazing vehicle that will fullfill all of your needs and prepare yourself for an adventure..."
	]
	quest.2F374DBE6CF01A66.quest_subtitle: "&7&oClick for more information"
	quest.354B723688B93E42.title: "Conduit Channeling"
	quest.38F51E7D1898529A.title: "Switches"
	quest.3B3FCB2A99F2C4CC.title: "Bulk Smoking"
	quest.3B73C2CD49E6FA32.quest_subtitle: "Dropped by Mimicubes found at End Cities"
	quest.3C4BFCCBA9E431C8.quest_desc: [
		"Now you've got the basics down it's time to actually use this new found power!"
		""
		"Electricity is as simple and clean way to carry energy and has some unique uses."
	]
	quest.3C4BFCCBA9E431C8.quest_subtitle: "&oClick for more information"
	quest.3C4BFCCBA9E431C8.title: "Picked up a Trade!"
	quest.4146A7D1F56C8EB7.title: "Miniboss: Berserker"
	quest.41503B469A70B00C.quest_desc: [
		"Now you've found oil it's time to pump it out of the ground."
		""
		"Use the ponder feature or \"Kwizzle Hazzizle\"'s tutorial on Create Diesel Generators to learn how to make a Pumpjack properly!"
	]
	quest.41503B469A70B00C.quest_subtitle: "&oClick for more information"
	quest.41503B469A70B00C.title: "Pumpjacks"
	quest.48B2CDB4442CF32A.title: "Bulk Ending"
	quest.49940ABAF103EE3D.quest_desc: ["These work essentially as connectors for Cords."]
	quest.49940ABAF103EE3D.quest_subtitle: "&oClick for more information"
	quest.4A6F17FE2DEF188A.quest_subtitle: "&oClick for more information"
	quest.4AF225F9215F10A6.title: "Boss: Wither"
	quest.4BF8FB42D8B47D80.quest_desc: [
		"Experience can either be extracted from items made of XP/enchanted or yourself! "
		""
		"Standing on top of a Drain or right clicking an Experience Hatch will allow you to withdraw experience and deposit it as liquid."
		"Items can be deposited onto Drains with 2 Mechanical Grindstones and they can also be stripped of experience!"
	]
	quest.4BF8FB42D8B47D80.quest_subtitle: "&oClick for more information"
	quest.4BF8FB42D8B47D80.title: "Extracting Experience"
	quest.4C9887EC85170EDF.title: "Infinite Graphene"
	quest.4DA27FAB4D1EDC12.quest_desc: [
		"Resistors and Rheostats can be used to control the current of a circuit!"
		""
		"Resistors are more simple basic stabilizers wheras Rheostats allows adjustable more fine control of the resistance!"
	]
	quest.4DA27FAB4D1EDC12.quest_subtitle: "&oClick for more information"
	quest.4DA27FAB4D1EDC12.title: "Must Resist!"
	quest.4E390AE67CD9AF10.quest_desc: ["Aquatic Meshes can be used to sift coral for a variety of ocean themed items!"]
	quest.4E390AE67CD9AF10.quest_subtitle: "&oClick for more information"
	quest.5146854454C42101.title: "Digital Storage"
	quest.561CCD8BE6BD24FB.title: "Boss: Ender Dragon"
	quest.566BBDA619012F68.quest_subtitle: "Dropped by the Void Worm"
	quest.58C935A729971286.title: "Infinite Uranium"
	quest.59B04A6FE59AC58B.title: "Miniboss: Nightmare Stalker"
	quest.5B34697E9217C981.quest_desc: [
		"Ender Pearls can only really be obtained the old fashioned way... killing Endermen and hoping the RNG gods bless you."
		""
		"Pearls are automatable in End-Game however that isn't available to you unless you unlocked the End!"
	]
	quest.5B34697E9217C981.quest_subtitle: "&oClick for more information"
	quest.5C43C90880AC3D65.quest_subtitle: "Dropped by the Ender Dragon"
	quest.5C5CB7CDD15B58B8.quest_desc: ["Hold an empty obsidian infused bottle in your off-hand and kill any undead mob to capture the Nether Essence in the bottle!"]
	quest.5C5CB7CDD15B58B8.quest_subtitle: "&oClick for more information"
	quest.5C8A58A94CB7CFF8.title: "Farming"
	quest.5CCC6A34532B64CA.quest_desc: [
		"Wind Charges can be crafted by simply killing Breezes or Blast Freezing Blaze Rods and then crafting the Breeze Rods into Charges!"
		""
		"Some sort of Blaze Rod Farm would help here..."
	]
	quest.5CCC6A34532B64CA.quest_subtitle: "&oClick for more information"
	quest.5D38EE4905D25E8C.quest_desc: [
		"Can either be fed Liquid Experience of Cake o' Enchantings to auomatically enchant items without the need for an Enchanting Table or bookshelves, the level enchant depends on the amount of experience stored within the Enchanter and the type of experience!"
		""
		"You can set things like filters to only get enchantments that would be available for specific tools for example putting Gold Boots will use the enchantability of Gold and only allow you to get Boot enchantments!"
	]
	quest.5D38EE4905D25E8C.quest_subtitle: "&oClick for more information"
	quest.5E37CF10E4F02B76.quest_desc: [
		"Blaze Forgers are essentially industrial anvils!"
		""
		"They allow you to merge enchantments of the same items without repair cost as well as apply Enchanting Templates to tools."
		"Alternatively they can be used to strip enchantments off of tools but like the Enchanter it requires a source of experience to run!"
	]
	quest.5E37CF10E4F02B76.quest_subtitle: "&oClick for more information"
	quest.5FE11C55340494FA.quest_desc: [
		"This item is essential for creating a Physics Contraption!"
		""
		"Glue your contraption and then use the Physics Assembler to turn your vehicle into a contraption that can move and interact with the world!"
		""
		"There are plenty of Youtube Tutorials on Aeronautics, or you can teach yourself in Creative, it's super intuitive and easy to get if you know Create already."
	]
	quest.5FE11C55340494FA.quest_subtitle: "&oClick for more information"
	quest.61B587D949A2A954.quest_subtitle: "Dropped by the Endstone Golem"
	quest.61CD33DD83273FBA.title: "Fancy Fly Swatters"
	quest.62E8715FEE0D314D.quest_desc: [
		"Experience can be automated by using Crushing Wheels!"
		""
		"There are two methods to automate experience, first is grinding up mobs and the second is grinding Quartz which can be automated by processing Cobblestone."
	]
	quest.62E8715FEE0D314D.quest_subtitle: "&oClick for more information"
	quest.62E8715FEE0D314D.title: "Automatic Experience"
	quest.6BAC2BE73E3E4E9B.quest_desc: [
		"Here you are... you find yourself on an island, at least you aren't alone! Just be careful stealing from the locals, they're protective of what little they have."
		""
		"Take your time to explore the town and rest of the island and get yourself settled, it won't be as easy as crafting a boat with a few planks and leaving..."
		"To escape this island due to the uneasy waters you must make a vehicle using physics, whether that's a Boat, Airship or Plane!"
		""
		"Exploring other islands is a great way to find a variety of resources not accessible on your island."
	]
	quest.6BAC2BE73E3E4E9B.quest_subtitle: "&oClick for more information"
	quest.6BAC2BE73E3E4E9B.title: "What a place to be stranded!"
	quest.6C82CA904038AC46.title: "May there be light!"
	quest.6EBC1A243C35E9A4.title: "Boss: Endstone Golem"
	quest.6F8CAFA3328D7514.quest_desc: ["The Glitch is a secret, final dimension that generates infinite ores around you!"]
	quest.6F8CAFA3328D7514.quest_subtitle: "&oClick for more information"
	quest.6F8CAFA3328D7514.title: "The Glitch..."
	quest.746AC555BE0D83EA.quest_subtitle: "&oClick for more information"
	quest.746AC555BE0D83EA.title: "Bring the End closer!"
	quest.75997404860F4B65.title: "Bulk Seething"
	quest.7857DC5A9E12770D.title: "Bulk Sanding"
	quest.79382F775AF5B1AE.quest_desc: [
		"After combining all these items you will have yourself a Seal of The Underworld!"
		""
		"Right click this to give yourself access to the Nether..."
	]
	quest.79382F775AF5B1AE.quest_subtitle: "&oClick for more information"
	quest.793C2520438D9F27.quest_desc: ["The Brass Sifter is an upgrade on the normal sifter, with increased output, filters and storage capacity."]
	quest.793C2520438D9F27.quest_subtitle: "&oClick for more information"
	quest.7AE00989DB60E8EE.title: "Miniboss: Elder Guardian"
	quest.7D8D555A8C55AEC9.quest_desc: [
		"Basic Burners can be used to heat blocks at a lower temperature than Blaze Burners!"
		""
		"By using a fan at max speed you can push the limits of the Burner to operate at the heat of a Blaze Burner allbeit less efficiently, making it essential for Pre-Nether Brass."
	]
	quest.7D8D555A8C55AEC9.quest_subtitle: "&oClick for more information"
	quest.7D8D555A8C55AEC9.title: "Budget Blaze Burners"
	quest.7DF4BD2BD9E29A38.quest_desc: [
		"Mysterious Shards can either be crafted using Brass and Amethyst or found in specific structures/mobs."
		""
		"Top Left: Abandoned Mineshafts"
		"Top Right: Witches"
		"Bottom Left: Evoker"
		"Bottom Right: Pillager Outposts"
	]
	quest.7DF4BD2BD9E29A38.quest_subtitle: "&oClick for more information"
	quest.7DF4BD2BD9E29A38.title: "Mysterious Shards"
	quest.7FB15C410A4D182A.quest_desc: ["Glitch Gems can either be rarely found just above bedrock (and only mined with Netherite Pickaxes) or automated with an incredibly tedious process if that's what interests you."]
	quest.7FB15C410A4D182A.quest_subtitle: "&oClick for more information"
