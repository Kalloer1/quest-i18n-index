	quest.0086C98729369913.quest_desc: [
		""
		"Aardwolves are shy, nocturnal creatures that roam the savannah, feeding mainly on termites."
		""
		"Discover an &a&lAardwolf&r in its natural habitat and observe how it moves, hunts, and interacts with the surrounding ecosystem."
	]
	quest.0086C98729369913.quest_subtitle: "&lDiscover an &a&lAardwolf&r     "
	quest.0086C98729369913.title: "&lQuest: Discover an &a&lAardwolf&r       "
	quest.018A0E5C7411232B.quest_desc: [
		""
		"Craft the sturdy &a&lGoat Plushie&r, inspired by energetic mountain goats. A fun plush for explorers of cold biomes."
	]
	quest.018A0E5C7411232B.quest_subtitle: "&lCraft the &aGoat Plushie&r      "
	quest.018A0E5C7411232B.title: "&lQuest: Craft &aGoat Plushie&r       "
	quest.0227E4641ECF6D9A.quest_desc: [
		""
		"Bring the mysterious &a&lEnderman Plushie&r, capturing the tall teleporting beings from other dimensions. A perfect plush for void or End themed decor."
	]
	quest.0227E4641ECF6D9A.quest_subtitle: "&lCraft the &aEnderman Plushie&r       "
	quest.0227E4641ECF6D9A.title: "&lQuest: Craft &aEnderman Plushie&r        "
	quest.0453FC0F1A384D44.quest_desc: [
		""
		"The &a&lGoo Block&r is formed by compressing goo into a solid mass. Its elastic, sticky, bouncy texture makes it useful for traps or decorative organic builds."
	]
	quest.0453FC0F1A384D44.quest_subtitle: "&lCraft a &aGoo Block&r      "
	quest.0453FC0F1A384D44.title: "&lQuest: Craft &aGoo Block&r      "
	quest.0511C0EB3EF33BF8.quest_desc: [
		""
		"The final piece of the armor set, the &a&lChocobo Boots&r, protect your chocobo’s legs and keep it steady on rough ground."
		""
		"With these crafted, you finish the full protective outfit for your mount and can send it into &b&ladventure&r with confidence."
	]
	quest.0511C0EB3EF33BF8.quest_subtitle: "&lCraft the &a&lChocobo Boots&r      "
	quest.0511C0EB3EF33BF8.title: "&lQuest: Forging the &a&lChocobo Boots&r        "
	quest.0581BDE5017E3AE7.quest_desc: [
		""
		"A proper rider protects not only themselves but also their loyal chocobo."
		""
		"The first piece of the armor set is the &a&lChocobo Helmet&r, giving your companion important &b&ldefense&r on your travels."
		""
		"Craft it with the needed materials and start shaping your chocobo’s protective gear."
	]
	quest.0581BDE5017E3AE7.quest_subtitle: "&lCraft the &a&lChocobo Helmet&r      "
	quest.0581BDE5017E3AE7.title: "&lQuest: Forging the &a&lChocobo Helmet&r         "
	quest.07453BE49EF0DC7F.quest_desc: [
		""
		"&l&aDragonfly wings&r are obtained from dragonflies and are required to tame jumping spiders. They are light, delicate, and infused with natural energy."
	]
	quest.07453BE49EF0DC7F.quest_subtitle: "&lObtain a &aDragonfly Wing&r      "
	quest.07453BE49EF0DC7F.title: "&lQuest: Obtain a Dragonfly Wing         "
	quest.091F5A8AC512AEF7.quest_desc: [
		""
		"Craft elegant &a&lMossy Oak Slabs&r, used for floors and walkways in Ribbit villages."
		""
		"Their half-height design offers extra flexibility when shaping detailed swamp builds and layered paths."
	]
	quest.091F5A8AC512AEF7.quest_subtitle: "&lCraft a set of &a&lMossy Oak Slabs&r        "
	quest.091F5A8AC512AEF7.title: "&lQuest: Craft &a&lMossy Oak Slabs&r        "
	quest.093F2C7CB12BD78A.quest_desc: [
		""
		"Crabs are &a&lsmall coastal&r creatures that roam the sandy shoreline, calmly wandering along the water’s edge."
		""
		"Most of the time they keep to themselves, but if you harm one, it will snap back and defend itself with surprising determination."
		""
		"Their quick, sideways steps and constant claw movements make them a lively addition to any beach."
		""
		"&l&7Bred with: &cCod"
	]
	quest.093F2C7CB12BD78A.quest_subtitle: "&lDiscover a &a&lCrab&r &lnear beaches&r      "
	quest.093F2C7CB12BD78A.title: "&lQuest: Claws by the &a&lShore&r       "
	quest.0949E8649AD2E27B.quest_desc: [
		""
		"&a&lChocobos&r are friendly birds that often appear in plains, forests, and flower meadows."
		""
		"They may approach out of curiosity but will back away if you rush toward them."
		"Feed them &a&lGysahl Greens&r to earn their trust and, with time, tame them as loyal companions."
	]
	quest.0949E8649AD2E27B.quest_subtitle: "&lFind a wild &a&lChocobo&r      "
	quest.0949E8649AD2E27B.title: "&lQuest: First &a&lMeeting&r     "
	quest.0972AD2DBE075A91.quest_desc: [
		""
		"Search sandy coasts and dunes to discover a &a&lDesert Rain Frog&r, a tiny, round amphibian known for its loud squeaky calls."
		""
		"Watch its charming, waddling steps as it shuffles across the sand, digging down whenever it feels threatened."
	]
	quest.0972AD2DBE075A91.quest_subtitle: "&lDiscover &a&lDesert Rain Frog&r      "
	quest.0972AD2DBE075A91.title: "&lQuest: Discover a &a&lDesert Rain Frog&r         "
	quest.097BE4362CCC849C.quest_desc: [
		""
		"&a&lPearls&r are rare treasures found inside clams, often opened by otters. These pearls are used to craft enderpearls and decorative pearl jewelry."
	]
	quest.097BE4362CCC849C.quest_subtitle: "&lObtain a &aPearl     "
	quest.097BE4362CCC849C.title: "&lQuest: Obtain a Pearl       "
	quest.09A90097754623EE.quest_desc: [
		""
		"Bright and elegant, the &a&lFlamingo&r brings color to wetlands with its vivid feathers and calm movements."
		""
		"&l&7Bred with: &cWheat."
	]
	quest.09A90097754623EE.quest_subtitle: "&lFind a &a&lFlamingo&r &lnear water&r      "
	quest.09A90097754623EE.title: "&lQuest: Dance of the &a&lPink Waters&r        "
	quest.09BEDE5D650F4E40.quest_desc: [
		""
		"The &a&lGlowing Potion&r causes entities to emit visible outlines, making them easier to track in dark or chaotic environments."
	]
	quest.09BEDE5D650F4E40.quest_subtitle: "&lBrew a &aPotion of Glowing&r      "
	quest.09BEDE5D650F4E40.title: "&lQuest: Brew &aPotion of Glowing&r        "
	quest.0A76230B02B100BE.quest_desc: [
		""
		"Penguins inhabit the &a&lcold and icy biomes&r, sliding across the snow with playful energy."
		""
		"They are harmless and friendly, living in groups and bringing life to frozen shores."
		""
		"Their adorable behavior makes them a favorite among explorers who venture into chilly regions."
		""
		"&l&7Bred with: &cSalmon, Cod, Pufferfish"
	]
	quest.0A76230B02B100BE.quest_subtitle: "&lFind a &a&lPenguin&r &lin cold biomes&r        "
	quest.0A76230B02B100BE.title: "&lQuest: Waddle of the &a&lFrozen Lands&r        "
	quest.0A992C118258A12B.quest_desc: [
		""
		"Bring the buzzing &a&lBee Plushie&r to life, celebrating helpful pollinators of flower plains. A bright, cheerful decoration."
	]
	quest.0A992C118258A12B.quest_subtitle: "&lCraft the &aBee Plushie&r      "
	quest.0A992C118258A12B.title: "&lQuest: Craft &aBee Plushie&r      "
	quest.0C28F0DCF6F4A880.quest_desc: [
		""
		"The &a&lTermite Bricks&r are created by refining termite mound. These durable building blocks are ideal for constructing sturdy, natural looking structures inspired by termite architecture."
	]
	quest.0C28F0DCF6F4A880.quest_subtitle: "&lCraft &aTermite Bricks&r      "
	quest.0C28F0DCF6F4A880.title: "&lQuest: Craft &aTermite Bricks&r       "
	quest.0C8BD13D32B24A7A.quest_desc: [
		""
		"Welcome to &a&lToasty's Mobs&r, an expansion that brings life, personality, and adventure into your world."
		""
		"This addon introduces many new creatures across different biomes, each with its own charm and behavior."
		""
		"Explore forests, oceans, caves, and other areas to meet this new wildlife and begin your journey with this creature‑themed addon."
	]
	quest.0C8BD13D32B24A7A.quest_subtitle: "&lDiscover &a&lToasty's Mobs&r &lmod&r       "
	quest.0C8BD13D32B24A7A.title: "&lQuest: Welcome to &a&lToasty's Mobs mod&r          "
	quest.0E4855BD6F467959.quest_desc: [
		""
		"Explore parched forests and scrublands to discover a &a&lChacoan Peccary&r, a rare, sturdy peccary that travels in tight-knit groups."
		""
		"Watch its wary yet inquisitive behavior as it navigates through the underbrush, sniffing and rooting around for food."
	]
	quest.0E4855BD6F467959.quest_subtitle: "&lDiscover &a&lChacoan Peccary&r      "
	quest.0E4855BD6F467959.title: "&lQuest: Discover a &a&lChacoan Peccary&r         "
	quest.0E9470C0A1C2AE04.quest_desc: [
		""
		"Venture into thick jungles and forests to discover a &a&lClouded Leopard&r, a stealthy cat marked by large cloud-shaped spots and powerful limbs."
		""
		"Watch its silent, graceful movements as it climbs and stalks through the foliage, blending almost perfectly with the dappled light."
	]
	quest.0E9470C0A1C2AE04.quest_subtitle: "&lDiscover &a&lClouded Leopard&r       "
	quest.0E9470C0A1C2AE04.title: "&lQuest: Discover a &a&lClouded Leopard&r         "
	quest.0F7EEF9C36934901.quest_desc: [
		""
		"The &a&lBaby Enderdragon&r is a tiny version of the legendary dragon, soaring through the skies with playful but dangerous energy."
		""
		"It can be summoned by placing a dragon egg on a purpur pillar, and once tamed it becomes a loyal &b&lcompanion&r that follows you and attacks hostile mobs from above."
		""
		"&l&7Tamed with: &cChorus Fruit"
	]
	quest.0F7EEF9C36934901.quest_subtitle: "&lDiscover the &a&lBaby Enderdragon      "
	quest.0F7EEF9C36934901.title: "      &lQuest: The Lost &a&lHatchling&r             "
	quest.1030A2E8C3E194E8.quest_desc: [
		""
		"Giraffes roam the warm savannas of the &a&lLivingThings&r world with elegance and calm behavior."
		""
		"They are neutral creatures and will only become aggressive if you attack them first."
		""
		"Adventurers may also encounter a rare albino giraffe, a graceful and unique variant treasured by explorers."
		""
		"&l&7Bred with: &cWheat"
	]
	quest.1030A2E8C3E194E8.quest_subtitle: "&lEncounter a &a&lGiraffe&r &lin the plains       "
	quest.1030A2E8C3E194E8.title: "&lQuest: Tall Guardian of the &a&lPlains&r        "
	quest.115BB7B0E9EB40B8.quest_desc: [
		""
		"The &a&lAncient Blaze&r is a powerful fiery entity that can be summoned deep in the Nether."
		""
		"After a short charging phase where it becomes &c&linvulnerable&r, it unleashes devastating attacks, hurling waves of small and large fireballs at its enemies."
		""
		"Upon its defeat, several regular blazes will rise from the ashes, turning this fight into a deadly trial for any adventurer bold enough to face it."
	]
	quest.115BB7B0E9EB40B8.quest_subtitle: "&lKill an &a&lAncient Blaze&r      "
	quest.115BB7B0E9EB40B8.title: "&lQuest: Ember of the &a&lOld Nether&r        "
	quest.11689216DBF82964.quest_desc: [
		""
		"Journey to cold or icy biomes to discover a &a&lChinstrap Penguin&r, a spirited bird marked by the thin black line under its chin that looks like a helmet strap."
		""
		"Watch it waddle over the ice or dive into the freezing water with surprising speed and energy."
	]
	quest.11689216DBF82964.quest_subtitle: "&lDiscover &a&lChinstrap Penguin&r      "
	quest.11689216DBF82964.title: "&lQuest: Discover a &a&lChinstrap Penguin&r          "
	quest.1193C3EA393C6E0C.quest_desc: [
		""
		"Search the depths of the Nether to find this &a&lBlazefish&r inside sunken blaze fortress structures surrounded by lava. Observe its fiery fins as it darts through the molten ruins."
	]
	quest.1193C3EA393C6E0C.quest_subtitle: "&lDiscover the &aBlazefish&r &lin the Nether        "
	quest.1193C3EA393C6E0C.title: "       &lQuest: Discover &aBlazefish&r                 "
	quest.11C3787EB342EB29.quest_desc: [
		""
		"Craft &a&lTermite Mound Walls&r to build hardened natural termite clay. These walls blend perfectly with termite mounds, creating organic defenses and structures."
	]
	quest.11C3787EB342EB29.quest_subtitle: "&lCraft a set of &aTermite Mound Walls&r         "
	quest.11C3787EB342EB29.title: "&lQuest: Craft &aTermite Mound Walls&r         "
	quest.11F734C845362E04.quest_desc: [
		""
		"Search wetlands and riversides to discover a &a&lChinese Crocodile Lizard&r, a semi-aquatic reptile with an ancient, dragon-like look and calm demeanor."
		""
		"Watch it basking or resting near the water’s edge in quiet spots to observe its relaxed, deliberate movements."
	]
	quest.11F734C845362E04.quest_subtitle: "&lDiscover &a&lChinese Crocodile Lizard&r         "
	quest.11F734C845362E04.title: "&lQuest: Discover a &a&lChinese Crocodile Lizard&r           "
	quest.143D788240E4D754.quest_desc: [
		""
		"The &a&lNether Knight&r is a formidable warrior that patrols the fiery depths, clad in dark armor and armed with both an enchanted axe and sword."
		""
		"In close combat it is a deadly &c&lfoe&r, and any adventurer who dares to face it must be fully prepared for battle."
	]
	quest.143D788240E4D754.quest_subtitle: "&lEncounter the &a&lNether Knight&r        "
	quest.143D788240E4D754.title: "&lQuest: The Nether &a&lKnight's Challenge&r         "
	quest.14BBB15B39CD8DD1.quest_desc: [
		""
		"The &a&lSoul Sucker Boots&r use soul infused leather, offering protection and utility while traversing hazardous Nether terrain."
	]
	quest.14BBB15B39CD8DD1.quest_subtitle: "&lCraft &aSoul Sucker Boots&r       "
	quest.14BBB15B39CD8DD1.title: "&lQuest: Craft &aSoul Sucker Boots&r         "
	quest.14D61C2090436BA1.quest_desc: [
		""
		"The world has changed, and the LivingThings mod has brought &a&lnew creatures&r to every forest, river, and mountain, from calm animals to strange and extraordinary beings that turn each encounter into the start of a new adventure.&r"
		""
		"Get ready to watch, learn, and live alongside these &a&lLiving Creatures&r, taking your first step into a world filled with curiosity, beauty, and small surprises at every turn.&r"
	]
	quest.14D61C2090436BA1.quest_subtitle: "&lDiscover your first &a&lcreature!&r       "
	quest.14D61C2090436BA1.title: "&lQuest: Welcome to &aLiving Things Mod        "
	quest.14EAB8249481D68A.quest_desc: [
		""
		"Create the soft and friendly &a&lCow Plushie&r inspired by the iconic overworld cow. A comforting companion perfect for decorating cozy farms and rustic homes."
	]
	quest.14EAB8249481D68A.quest_subtitle: "&lCraft the &aCow Plushie&r      "
	quest.14EAB8249481D68A.title: "&lQuest: Craft &aCow Plushie&r       "
	quest.1589CB89CEB78D8C.quest_desc: [
		""
		"To ride a chocobo, you will need a &a&lChocobo Saddle&r, the key item that lets you travel beside your new ally."
		""
		"Gather the required materials, craft the saddle, and get ready to explore the world from a fresh &b&lperspective&r."
	]
	quest.1589CB89CEB78D8C.quest_subtitle: "&lCraft your first &a&lChocobo Saddle&r        "
	quest.1589CB89CEB78D8C.title: "  &lQuest: The Rider's &a&lBeginning&r         "
	quest.1663E5BBAB991A0A.quest_desc: [
		""
		"Compressed warped kelp forms a warped kelp block, useful for building or as renewable fuel within Nether environments."
	]
	quest.1663E5BBAB991A0A.quest_subtitle: "&lCraft a &aWarped Kelp Block&r       "
	quest.1663E5BBAB991A0A.title: "&lQuest: Craft &aWarped Kelp Block&r         "
	quest.17E471D298ED1217.quest_desc: [
		""
		"Create the shambling &a&lZombie Plushie&r, inspired by restless undead that wander dark forests and caves. A spooky yet charming decoration."
	]
	quest.17E471D298ED1217.quest_subtitle: "&lCraft the &aZombie Plushie&r       "
	quest.17E471D298ED1217.title: "&lQuest: Craft &aZombie Plushie&r        "
	quest.17F2D5391ADED35C.quest_desc: [
		""
		"Bring the fluffy &l&aSheep Plushie&r, modeled after the gentle sheep that roam the fields. Soft, peaceful, perfect for brightening up any room."
	]
	quest.17F2D5391ADED35C.quest_subtitle: "&lCraft the &aSheep Plushie&r      "
	quest.17F2D5391ADED35C.title: "&lQuest: Craft &aSheep Plushie&r        "
	quest.18991469389C04A0.quest_desc: [
		""
		"Monkeys move playfully through the jungle canopy, jumping from branch to branch with endless &a&lenergy&r."
		""
		"When tamed, they become joyful companions that follow you on your travels and even start &b&ldancing&r when a music box plays nearby."
		""
		"&l&7Tamed with: &cApple, Banana"
		"&l&7Bred with: &cApple, Banana"
	]
	quest.18991469389C04A0.quest_subtitle: "&lFind a &a&lMonkey&r &lin the jungle&r       "
	quest.18991469389C04A0.title: "&lQuest: Forest &a&lTrickster&r       "
	quest.1941963E65852571.quest_desc: [
		""
		"Koalas cling to the tall trees, living quiet lives high above the ground."
		""
		"These gentle &a&lcreatures&r spend most of their time resting or munching on &b&lleaves&r, bringing a calm and soothing presence to any forest they call home."
		""
		"&l&7Bred with: &cWheat"
	]
	quest.1941963E65852571.quest_subtitle: "&lFind a &a&lKoala&r &lin forests&r      "
	quest.1941963E65852571.title: "&lQuest: Keeper of the &a&lEucalyptus&r        "
	quest.19D6FCCFFFD11C86.quest_desc: [
		""
		"The &a&lFortress Grouper Plate&r is a hardened scale plate taken from massive fortress groupers, providing strong protection and serving as a key crafting material."
	]
	quest.19D6FCCFFFD11C86.quest_subtitle: "&lCraft a &aFortress Grouper Plate&r         "
	quest.19D6FCCFFFD11C86.title: "&lQuest: Craft &aFortress Grouper Plate&r         "
	quest.19EE1AF071A62949.quest_desc: [
		""
		"The &a&lLava Sponge&r is a rare utility item capable of absorbing invaluable lava instead of water, making exploring and reshaping dangerous molten environments safer."
	]
	quest.19EE1AF071A62949.quest_subtitle: "&lObtain a &aLava Sponge&r      "
	quest.19EE1AF071A62949.title: "&lQuest: Obtain &aLava Sponge&r        "
	quest.1A86DA1A28CB0C1E.quest_desc: [
		""
		"The &a&lBonefish&r Nether waters body drifts through stripped bone. It is commonly found near fossil rich areas and ancient remains."
	]
	quest.1A86DA1A28CB0C1E.quest_subtitle: "&lObtain a &aBonefish&r      "
	quest.1A86DA1A28CB0C1E.title: "&lQuest: Obtain &aBonefish&r       "
	quest.1AEFF24C096244A6.quest_desc: [
		""
		"Put together the tall &a&lCamel Plushie&r, representing gentle desert companions used by travelers. A perfect plush for warm, sandy builds."
	]
	quest.1AEFF24C096244A6.quest_subtitle: "&lCraft the &aCamel Plushie&r       "
	quest.1AEFF24C096244A6.title: "&lQuest: Craft &aCamel Plushie&r       "
	quest.1BBD6F7319CE5C6B.quest_desc: [
		""
		"Compressed crimson kelp forms a &a&lcrimson kelp block&r, vibrant building material inspired by the flora of the crimson forest."
	]
	quest.1BBD6F7319CE5C6B.quest_subtitle: "&lCraft a &aCrimson Kelp Block&r        "
	quest.1BBD6F7319CE5C6B.title: "&lQuest: Craft &aCrimson Kelp Block&r         "
	quest.1C52B3FAAB5401CA.quest_desc: [
		""
		"This gourmet dish is prepared from giant snail meat, slow-cooked and seasoned with fresh organic herbs."
		""
		"&a&lEscargot&r provides refined nourishment and makes a luxurious meal for daring travelers exploring distant lands."
	]
	quest.1C52B3FAAB5401CA.quest_subtitle: "&lCraft &a&lEscargot&r   "
	quest.1C52B3FAAB5401CA.title: "&lQuest: Craft &a&lEscargot&r      "
	quest.1D28CB399356C792.quest_desc: [
		""
		"The &a&lLexicon&r is a special guide filled with knowledge about the creatures of this world."
		""
		"You can craft it by combining a book with &9&lLapis Lazuli&r on a crafting table, creating a handy &b&lreference&r for your adventures."
	]
	quest.1D28CB399356C792.quest_subtitle: "&lCraft the &a&lLexicon&r     "
	quest.1D28CB399356C792.title: "&lQuest: Lore of the &a&lLexicon&r       "
	quest.1D3B748D70D9488E.quest_desc: [
		""
		"Raccoons are clever, medium‑sized mammals that wander forests and plains, always searching for something to eat."
		""
		"They will try almost any &a&lfood&r they find, and their mischievous nature often gets them into &c&ltrouble&r, from raiding camps to sneaking around nests."
		""
		"&l&7Bred with: &cWheat, Apple, Beetroot, Potato, Carrot"
	]
	quest.1D3B748D70D9488E.quest_subtitle: "&lEncounter a &a&lRaccoon&r     "
	quest.1D3B748D70D9488E.title: "&lQuest: The &a&lNight Thief&r       "
	quest.1E240AE6B3D0BDA9.quest_desc: [
		""
		"Travel through the &a&lWarped Forest&r, a volatile creature capable molten lava. Observe its defensive behavior within this warped and mystical biome."
	]
	quest.1E240AE6B3D0BDA9.quest_subtitle: "&lDiscover the &aLava Pufferfish&r &lin the Nether          "
	quest.1E240AE6B3D0BDA9.title: "       &lQuest: Discover &aLava Pufferfish&r                      "
	quest.1E83F31255754EC9.quest_desc: [
		""
		"Craft the winged &a&lPhantom Plushie&r, representing the terrifying night creature that swoops from the sky. A harmless menace in plush form."
	]
	quest.1E83F31255754EC9.quest_subtitle: "&lCraft the &aPhantom Plushie&r        "
	quest.1E83F31255754EC9.title: "&lQuest: Craft &aPhantom Plushie&r        "
	quest.1E8B307ADFFDA7BD.quest_desc: [
		""
		"The &a&lMossy Oak Door&r is a staple feature of Ribbit village homes, with a mossy texture that feels cozy and humid like a deep forest."
		""
		"Craft one to bring the look and ambience of swamp dwellings into your own base."
	]
	quest.1E8B307ADFFDA7BD.quest_subtitle: "&lCraft a &a&lMossy Oak Door&r     "
	quest.1E8B307ADFFDA7BD.title: "&lQuest: Craft a &a&lMossy Oak Door&r        "
	quest.1EA096FD23A7D312.quest_desc: [
		""
		"The &a&lGlowdine&r emits a faint glow, illuminating the dark Nether waters it inhabits. This makes it easier to spot in deep, shadowy regions."
	]
	quest.1EA096FD23A7D312.quest_subtitle: "&lObtain a &aGlowdine&r     "
	quest.1EA096FD23A7D312.title: "&lQuest: Obtain &aGlowdine&r      "
	quest.1EB26DFE188C6BE7.quest_desc: [
		""
		"The &a&lPearl Necklace I&r is the first tier of pearl jewelry, offering minor benefits and serving as the foundation for stronger necklaces."
	]
	quest.1EB26DFE188C6BE7.quest_subtitle: "&lCraft a &aPearl Necklace I       "
	quest.1EB26DFE188C6BE7.title: "&lQuest: Craft Pearl Necklace I        "
	quest.1F9DC5D151A9FAE0.quest_desc: [
		""
		"Assemble the bouncy &a&lSlime Plushie&r based on gooey slime creatures found deep underground. Cute, soft, and perfect for playful builds."
	]
	quest.1F9DC5D151A9FAE0.quest_subtitle: "&lCraft the &aSlime Plushie&r      "
	quest.1F9DC5D151A9FAE0.title: "&lQuest: Craft &aSlime Plushie&r       "
	quest.21041092FEC838B2.quest_desc: [
		""
		"The &a&lSea Hare&r is a gentle aquatic creature that lives deep in the &9&locean&r biomes."
		""
		"Slow and graceful, it drifts through kelp forests and coral reefs, its soft shape and calm nature making it a unique sight beneath the waves."
	]
	quest.21041092FEC838B2.quest_subtitle: "&lDiscover a &a&lSea Hare&r      "
	quest.21041092FEC838B2.title: "&lQuest: Grace of the &a&lSea Hare&r        "
	quest.217D129F5FA86E49.quest_desc: [
		""
		"Bring the mysterious &a&lMushroom Plushie&r infused with magic to mushroom islands. An exotic plush that stands out in any collection."
	]
	quest.217D129F5FA86E49.quest_subtitle: "&lCraft the &aMushroom Plushie&r        "
	quest.217D129F5FA86E49.title: "&lQuest: Craft &aMushroom Plushie&r        "
	quest.225A7F49472DDC7B.quest_desc: [
		""
		"Raw &a&lcrab&r meat is gathered by hunting crabs along the shore."
		""
		"It can be cooked for food or used in seafood &b&lrecipes&r that call for fresh ingredients."
	]
	quest.225A7F49472DDC7B.quest_subtitle: "&lObtain &a&lRaw Crab&r     "
	quest.225A7F49472DDC7B.title: "&lQuest: Obtain &a&lRaw Crab&r      "
	quest.233DF805159EE1C4.quest_desc: [
		""
		"The &a&lSilk Cocoon&r can be found in areas inhabited by silk producing creatures. It contains valuable silk fibers used for advanced crafting and unique tools."
	]
	quest.233DF805159EE1C4.quest_subtitle: "&lObtain a &aSilk Cocoon&r      "
	quest.233DF805159EE1C4.title: "&lQuest: Obtain a Silk Cocoon         "
	quest.23E3A788BEBD6E23.quest_desc: [
		""
		"Craft a sturdy &a&lMossy Oak Fence Gate&r to pair with your mossy oak fences."
		""
		"Common in Ribbit enclosures, these gates swing open smoothly while blending perfectly into swamp-themed builds."
	]
	quest.23E3A788BEBD6E23.quest_subtitle: "&lCraft a &a&lMossy Oak Fence Gate&r       "
	quest.23E3A788BEBD6E23.title: "&lQuest: Craft a &a&lMossy Oak Fence Gate&r          "
	quest.258BD945C1F30B54.quest_desc: [
		""
		"The &a&lEyeball Fish&r watches its massive eye surroundings. It is often found in massively corrupted or chaotic Nether waters, making it both fascinating."
	]
	quest.258BD945C1F30B54.quest_subtitle: "&lObtain an &aEyeball Fish&r      "
	quest.258BD945C1F30B54.title: "&lQuest: Obtain &aEyeball Fish&r       "
	quest.25B4610EA59A9AF8.quest_desc: [
		""
		"Explore fortresses to find the &a&lFortress Grouper&r, a heavy and resilient fish that lurks in fortified lava pools and dark channels carved into ancient bricks."
	]
	quest.25B4610EA59A9AF8.quest_subtitle: "&lDiscover the &aFortress Grouper&r &lin the Nether            "
	quest.25B4610EA59A9AF8.title: "       &lQuest: Discover &aFortress Grouper&r                     "
	quest.25D598A551F616BE.quest_desc: [
		""
		"Graceful and mysterious, the &a&lMantaray&r moves like a spectral dancer through the deep &b&locean&r."
	]
	quest.25D598A551F616BE.quest_subtitle: "&lFind a &a&lMantaray&r &lunderwater&r      "
	quest.25D598A551F616BE.title: "&lQuest: Glider of the &a&lAbyss&r       "
	quest.27DC11470643696B.quest_desc: [
		""
		"Chocobos sometimes shed soft &a&lfeathers&r that can be saved for crafting and future tools."
		""
		"Finding one means you are beginning to connect with these creatures, so keep them stored, you will need &b&lplenty&r later on.."
	]
	quest.27DC11470643696B.quest_subtitle: "&lCollect a &a&lChocobo Feather&r      "
	quest.27DC11470643696B.title: "&lQuest: Gathering &a&lChocobo Feathers&r         "
	quest.288EB49CD0F95A8F.quest_desc: [
		""
		"Create the loyal and &a&lCat Plushie&r, inspired by elegant felines that wander villages. A charming addition for cozy indoors."
	]
	quest.288EB49CD0F95A8F.quest_subtitle: "&lCraft the &aCat Plushie&r       "
	quest.288EB49CD0F95A8F.title: "&lQuest: Craft &aCat Plushie&r       "
	quest.29068FE880DE2305.quest_desc: [
		""
		"The &l&aKopje Fig&r tree yields sturdy and valuable logs. Collect five from these trees to use in crafting, building, or trading. "
		""
		"Explore to find these trees and gather their wood for your adventures."
	]
	quest.29068FE880DE2305.quest_subtitle: "&lObtain &a5 Kopje Fig Logs&r      "
	quest.29068FE880DE2305.title: "&lQuest: Collect &aKopje Fig Logs&r       "
	quest.296FF195A9ADEF53.quest_desc: [
		""
		"Ribbitts live in small villages scattered throughout the swamps."
		""
		"Find a &a&lRibbit Village&r to see their &b&lcommunity&r in action and learn how they live alongside the environment."
	]
	quest.296FF195A9ADEF53.quest_subtitle: "&lLocate a &a&lRibbit Village&r      "
	quest.296FF195A9ADEF53.title: "&lQuest: Ribbit Village &a&lDiscovery&r        "
	quest.2A290B8DF2849A6E.quest_desc: [
		""
		"The elusive &a&lLeaf Insect&r hides among forest foliage and has a special love for music it dances when it hears it. Its natural camouflage and joyful personality make it a delightful discovery."
	]
	quest.2A290B8DF2849A6E.quest_subtitle: "&lObserve a &aLeaf Insect&r &lin a forest        "
	quest.2A290B8DF2849A6E.title: "  &lQuest: Observe a Leaf Insect           "
	quest.2A2DC697195E1A85.quest_desc: [
		""
		"Ribbits are the friendly amphibians of this mod, often found near swamps, rivers, or village edges."
		""
		"Take time to &a&lobserve the Ribbits&r in their natural spots, watching their movements and &b&lbehaviors&r to learn more about these lively creatures."
	]
	quest.2A2DC697195E1A85.quest_subtitle: "&lObserve the &a&lRibbits&r     "
	quest.2A2DC697195E1A85.title: "&lQuest: Meet the &a&lRibbits&r      "
	quest.2AE65B372DAA28E3.quest_desc: [
		""
		"Packing multiple figs into a sturdy crate preserves them for transport. This crate is perfect for storage or trading figs with other travelers."
	]
	quest.2AE65B372DAA28E3.quest_subtitle: "&lCraft a &aCrate of Figs&r      "
	quest.2AE65B372DAA28E3.title: "&lQuest: Craft &aCrate of Figs&r       "
	quest.2B189B9C77AE0A31.quest_desc: [
		""
		"Frass is the organic matter left behind by insects and other tiny critters."
		""
		"Collectors use this nutrient-rich &a&lFrass&r in crafting recipes or as a powerful additive in certain growth and processing mixtures."
	]
	quest.2B189B9C77AE0A31.quest_subtitle: "&lGather &a&lFrass&r  "
	quest.2B189B9C77AE0A31.title: "&lQuest: Obtain &a&lFrass&r     "
	quest.2C3CB0D7FECA34B4.quest_desc: [
		""
		"Explore dense forests or jungles to discover a &a&lBush Dog&r, a small but bold canid that lives and hunts in packs."
		""
		"Watch how it moves with its group and listen for its calls as it patrols and protects its territory."
	]
	quest.2C3CB0D7FECA34B4.quest_subtitle: "&lDiscover &a&lBush Dog&r      "
	quest.2C3CB0D7FECA34B4.title: "&lQuest: Discover a &a&lBush Dog&r       "
	quest.2CCFDA7C6A275CF9.quest_desc: [
		""
		"The fluffy &a&lShima Enaga&r appears in snowy biomes and can be tamed with seeds. These tiny white birds are known for their soft appearance and peaceful nature, bringing charm to cold environments."
	]
	quest.2CCFDA7C6A275CF9.quest_subtitle: "&lObserve a &aShima Enaga&r &lin snowy biomes        "
	quest.2CCFDA7C6A275CF9.title: "        &lQuest: Observe a Shima Enaga                 "
	quest.2D77DD55BA7C96A5.quest_desc: [
		""
		"By polishing raw kopje granite, you create a stone block perfect for refined builds that blend rugged terrain with clean architectural lines."
	]
	quest.2D77DD55BA7C96A5.quest_subtitle: "&lCraft &aPolished Kopje Granite&r         "
	quest.2D77DD55BA7C96A5.title: "&lQuest: Craft &aPolished Kopje Granite&r         "
	quest.2F75473114336F0E.quest_desc: [
		""
		"The &a&lSoul Sucker Leather&r is crafted from the hide of eerie soul infused fish and is used to create specialized Nether armor adapted to the dangers."
	]
	quest.2F75473114336F0E.quest_subtitle: "&lCraft &aSoul Sucker Leather&r     "
	quest.2F75473114336F0E.title: "&lQuest: Craft &aSoul Sucker Leather&r         "
	quest.31574337A5A40F2F.quest_desc: [
		""
		"Bear fur is taken from bears and provides thick &a&linsulation&r against the cold."
		""
		"It is often used when crafting warm clothing or rugged &b&lsurvival&r gear."
	]
	quest.31574337A5A40F2F.quest_subtitle: "&lObtain &a&lBear Fur&r    "
	quest.31574337A5A40F2F.title: "&lQuest: Obtain &a&lBear Fur&r     "
	quest.31BA9FE00F345AC5.quest_desc: [
		""
		"Sweet and nourishing, figs often appear where special critters interact with their surroundings."
		""
		"These flavorful &a&lFigs&r are prized as both a tasty food and a versatile ingredient in many recipes."
	]
	quest.31BA9FE00F345AC5.quest_subtitle: "&lHarvest a ripe &a&lFig&r     "
	quest.31BA9FE00F345AC5.title: "&lQuest: Obtain a &a&lFig&r     "
	quest.31E9674AAEF28CA1.quest_desc: [
		""
		"Buff milk is produced by especially strong critters and is prized for its potent restorative effects."
		""
		"Secure a bucket of this rich milk to aid in survival, advanced brewing, or any situation where extra resilience is needed."
	]
	quest.31E9674AAEF28CA1.quest_subtitle: "&lAcquire a &a&lBuff Milk Bucket&r &lfrom buff creatures&r           "
	quest.31E9674AAEF28CA1.title: "        &lQuest: Obtain a &a&lBuff Milk Bucket&r                      "
	quest.323DFFBF81C14231.quest_desc: [
		""
		"The &a&lSearing Cod&r is a blazing variant of cod living in hot Nether waters. Its fiery nature makes it both hazardous and valuable."
	]
	quest.323DFFBF81C14231.quest_subtitle: "&lObtain a &aSearing Cod&r     "
	quest.323DFFBF81C14231.title: "&lQuest: Obtain &aSearing Cod&r       "
	quest.340ABEF13FDFC19F.quest_desc: [
		""
		"The &a&lTermite Mound Colony&r represents a fully developed colony growth and adds realism to savanna or forest scenery. "
		""
		"This block supports more complex mound with greater ecological detail."
	]
	quest.340ABEF13FDFC19F.quest_subtitle: "&lCraft a &aTermite Mound Colony&r        "
	quest.340ABEF13FDFC19F.title: "&lQuest: Craft &aTermite Mound Colony&r         "
	quest.34F42FF30D387C58.quest_desc: [
		""
		"Travel into the &a&lSoul Sand Valley&r to discover this Nether fish that sucks through lava. Its eerie glow and unusual souls observe behavior within this ghostly biome."
	]
	quest.34F42FF30D387C58.quest_subtitle: "&lDiscover the &aSoul Sucker&r &lin the Nether          "
	quest.34F42FF30D387C58.title: "        &lQuest: Discover &aSoul Sucker&r                   "
	quest.35352BB80766631A.quest_desc: [
		""
		"By treating reptile skin with special hide, it becomes tougher and highly resistant organic material. This makes it ideal for advanced crafting recipes."
	]
	quest.35352BB80766631A.quest_subtitle: "&lCraft &aBonded Reptile Hide&r       "
	quest.35352BB80766631A.title: "&lQuest: Craft &aBonded Reptile Hide&r        "
	quest.366E6439F4CDAC42.quest_desc: [
		""
		"A strange mix of savory and sweet, the &a&lPorkchop Fig&r combines juicy pork with ripe figs."
		""
		"This hearty treat makes a unique survival meal, offering balanced nourishment and a rich, comforting flavor."
	]
	quest.366E6439F4CDAC42.quest_subtitle: "&lCraft a &a&lPorkchop Fig&r      "
	quest.366E6439F4CDAC42.title: "&lQuest: Craft a &a&lPorkchop Fig&r        "
	quest.36E4AE4DF742A91B.quest_desc: [
		""
		"Craft the playful &a&lAxolotl Plushie&r inspired by aquatic cave inhabitants. A favorite for water base decorators."
	]
	quest.36E4AE4DF742A91B.quest_subtitle: "&lCraft the &aAxolotl Plushie&r        "
	quest.36E4AE4DF742A91B.title: "&lQuest: Craft &aAxolotl Plushie&r        "
	quest.36F4C6FF237F5F0D.quest_desc: [
		""
		"Peacocks wander through forests and plains, showing off their vibrant &a&lfeathers&r as they move."
		""
		"Their elegant walks and colorful &b&lplumage&r make them unforgettable creatures to encounter."
		""
		"&l&7Bred with: &cWheat"
	]
	quest.36F4C6FF237F5F0D.quest_subtitle: "&lFind a &a&lPeacock&r    "
	quest.36F4C6FF237F5F0D.title: "&lQuest: Wings of &a&lRadiance&r      "
	quest.372FDDED4DD688DD.quest_desc: [
		""
		"Elephants are majestic and powerful creatures that roam the vast wilderness of the &a&lLivingThings&r world."
		""
		"They are gentle by nature, but a wild elephant will fiercely defend itself if attacked, using its incredible strength."
		""
		"When tamed, these giants become loyal companions that can carry you over long distances with a &6&lsaddle&r, and they can also hold a &6&lchest&r, giving you extra &b&linventory&r space for your adventures."
		""
		"&l&7Tamed with: &cWheat "
		"&l&7Bred with: &cApple"
	]
	quest.372FDDED4DD688DD.quest_subtitle: "&lFind an &a&lElephant&r &lin the wild       "
	quest.372FDDED4DD688DD.title: "&lQuest: Majesty of the &a&lElephant&r        "
	quest.37F10991052D37A4.quest_desc: [
		""
		"&a&lNether Depths Upgrade&r is a compact expansion that enhances the Nether with unique fiery lava-dwelling fish. This mod enchantment and potion environment allows diving into lava seas and uncover a world thriving within the heat."
	]
	quest.37F10991052D37A4.quest_subtitle: "&lDiscover &aNether Depths&r       "
	quest.37F10991052D37A4.title: "&lQuest: &aWelcome Nether Depths Upgrade&r          "
	quest.38323905B9A72F84.quest_desc: [
		""
		"Assemble the gold loving &a&lPiglin Plushie&r, modeled after Nether dwellers that value riches above all. A perfect plush for crimson Nether themed builds."
	]
	quest.38323905B9A72F84.quest_subtitle: "&lCraft the &aPiglin Plushie&r        "
	quest.38323905B9A72F84.title: "&lQuest: Craft &aPiglin Plushie&r        "
	quest.394FEC6B01A06ED6.quest_desc: [
		""
		"The &a&lArrows of Glowing&r make targets emit a visible outline, making them easy to track even in complete darkness."
	]
	quest.394FEC6B01A06ED6.quest_subtitle: "&lCraft &aArrows of Glowing&r      "
	quest.394FEC6B01A06ED6.title: "&lQuest: Craft &aArrows of Glowing&r         "
	quest.3AE72F002B809708.quest_desc: [
		""
		"Enter the &a&lNether&r, a hardened lava fish with a bony exterior adapted to intense heat. It swims amongst sharp molten currents."
	]
	quest.3AE72F002B809708.quest_subtitle: "&lDiscover the &aBonefish&r &lin the Nether         "
	quest.3AE72F002B809708.title: "        &lQuest: Discover &aBonefish&r                  "
	quest.3B2A9A4167363FB0.quest_desc: [
		""
		"This &a&ladorable&r variety of &a&lcute&r plushies adds warmth and joy to your world, base, or any build. Collect them or simply brighten up your favorites! Start exploring cuddly additions!"
	]
	quest.3B2A9A4167363FB0.quest_subtitle: "&lDiscover the &aPlushie Mod&r        "
	quest.3B2A9A4167363FB0.title: "&lQuest: Welcome to &aPlushie Mod&r         "
	quest.3C48E0B809636B1D.quest_desc: [
		""
		"Build this gate to pair with your &l&akopje fences&r."
		""
		"Perfect for creating enclosed, organic looking areas with smooth access."
	]
	quest.3C48E0B809636B1D.quest_subtitle: "&lCraft a &aKopje Fence Gate&r        "
	quest.3C48E0B809636B1D.title: "&lQuest: Craft &aKopje Fence Gate&r        "
	quest.3E1E7E27A4F95AF0.quest_desc: [
		""
		"Craft &a&lKopje Plank Stairs&r to complement kopje slabs and planks. Their rugged wooden texture elevates forest structures, roofs, or pathways."
	]
	quest.3E1E7E27A4F95AF0.quest_subtitle: "&lCraft a set of &aKopje Plank Stairs&r        "
	quest.3E1E7E27A4F95AF0.title: "&lQuest: Craft &aKopje Plank Stairs&r        "
	quest.3E2EC762B9555531.quest_desc: [
		""
		"The &l&aTermite Mound&r is a compact structure. Termites use it as an early stage home. Perfect for natural decorations or &l&aTermite&r themed builds."
	]
	quest.3E2EC762B9555531.quest_subtitle: "&lCraft a &aTermite Mound&r        "
	quest.3E2EC762B9555531.title: "&lQuest: Craft &aa Termite Mound&r        "
	quest.3E403DCF0AB3B87F.quest_desc: [
		""
		"Toxinballs are dropped by toxic &a&lcreatures&r and hold concentrated poisonous substances."
		""
		"They are used in alchemy and risky &c&lcrafting&r recipes, so handle them with care."
	]
	quest.3E403DCF0AB3B87F.quest_subtitle: "&lObtain a &a&lToxinball&r    "
	quest.3E403DCF0AB3B87F.title: "&lQuest: Obtain a &a&lToxinball&r       "
	quest.3E71FC7085179350.quest_desc: [
		""
		"Welcome to &a&lChococraft&r, a classic creature addon that brings the beloved &e&lChocobos&r into your Minecraft world."
		""
		"This mod adds colorful rideable birds with unique abilities, breeding mechanics, special equipment, and many adventures to explore."
		"Raise, tame, and bond with these majestic creatures as you begin your journey with this iconic fantasy‑themed addon."
	]
	quest.3E71FC7085179350.quest_subtitle: "&lDiscover the &a&lChococraft&r &lmod&r     "
	quest.3E71FC7085179350.title: "&lQuest: Welcome to &a&lChococraft mod&r        "
	quest.3E8BF1A25051D712.quest_desc: [
		""
		"The &a&lSea Bunny Slime Block&r is crafted using bottled sea bunny slime and provides a soft, bouncy block useful for decoration and playful builds."
	]
	quest.3E8BF1A25051D712.quest_subtitle: "&lCraft a &aSea Bunny Slime Block        "
	quest.3E8BF1A25051D712.title: "&lQuest: Craft a Sea Bunny Slime Block           "
	quest.3E90499C635E6987.quest_desc: [
		""
		"Stitch together the sly &a&lFox Plushie&r, inspired by snowy and taiga foxes. A lively ornament for nature builds."
	]
	quest.3E90499C635E6987.quest_subtitle: "&lCraft the &aFox Plushie&r      "
	quest.3E90499C635E6987.title: "&lQuest: Craft &aFox Plushie&r      "
	quest.3FB4FA21EDD08E4B.quest_desc: [
		""
		"Craft the bony &a&lSkeleton Plushie&r wielding bow foes that lurk in shadows. Perfect for eerie or dungeon themed builds."
	]
	quest.3FB4FA21EDD08E4B.quest_subtitle: "&lCraft the &aSkeleton Plushie&r        "
	quest.3FB4FA21EDD08E4B.title: "&lQuest: Craft &aSkeleton Plushie&r        "
	quest.3FD4D5A7A439587E.quest_desc: [
		""
		"&a&lBears&r roam the dense forests, wandering between trees and streams."
		""
		"Large, powerful, and territorial, they usually stay calm at a distance, but their massive presence adds both danger and rough beauty to the woods."
	]
	quest.3FD4D5A7A439587E.quest_subtitle: "&lEncounter a &a&lBear&r     "
	quest.3FD4D5A7A439587E.title: "&lQuest: Might of the &a&lBear&r      "
	quest.429EA761D706B103.quest_desc: [
		""
		"Sew the lively &a&lRabbit Plushie&r, representing forests and deserts. A hopper full of cheer for nature themed decorations."
	]
	quest.429EA761D706B103.quest_subtitle: "&lCraft the &aRabbit Plushie&r       "
	quest.429EA761D706B103.title: "&lQuest: Craft &aRabbit Plushie&r        "
	quest.430F33F6C5D961DD.quest_desc: [
		""
		"By carefully cooling molten materials, &a&lLava Glass&r can be crafted into a heat resistant transparent block ideal for dangerous Nether constructions."
	]
	quest.430F33F6C5D961DD.quest_subtitle: "&lCraft &aLava Glass&r     "
	quest.430F33F6C5D961DD.title: "&lQuest: Craft &aLava Glass&r       "
	quest.43F56989B9C74E92.quest_desc: [
		""
		"Agazzis Cichlids are bright freshwater fish commonly found in clear rivers and lakes."
		""
		"Discover an &a&lAgazzis Cichlid&r in its natural habitat and take time to observe its vivid patterns and graceful swimming behavior."
	]
	quest.43F56989B9C74E92.quest_subtitle: "&lDiscover an &a&lAgazzis Cichlid&r       "
	quest.43F56989B9C74E92.title: "&lQuest: Discover an &a&lAgazzis Cichlid&r          "
	quest.441D28C694B115A9.quest_desc: [
		""
		"Explore the &a&lSoul Sand Valley&r to find this lava dwelling fish infused with skeletal lava energy. Observe it carefully as it moves through the fiery rivers of its home."
	]
	quest.441D28C694B115A9.quest_subtitle: "&lDiscover the &aWitherbones&r &lin the Nether       "
	quest.441D28C694B115A9.title: "       &lQuest: Discover &aWitherbones&r                "
	quest.444240799EE377BF.quest_desc: [
		""
		"The &a&lEyeball Fish Eye&r is crafted from the unsettling remains of eyeball fish and is commonly used in alchemy and advanced Nether recipes."
	]
	quest.444240799EE377BF.quest_subtitle: "&lCraft an &aEyeball Fish Eye&r       "
	quest.444240799EE377BF.title: "&lQuest: Craft &aEyeball Fish Eye&r         "
	quest.45CC83BFE52DC02B.quest_desc: [
		""
		"Okapis wander the warm &e&lsavannas&r, blending elegance with a touch of mystery."
		""
		"With zebra‑like legs and a calm &a&lposture&r, they move quietly through tall grass, making them some of the savanna’s most fascinating residents."
	]
	quest.45CC83BFE52DC02B.quest_subtitle: "&lEncounter an &a&lOkapi&r      "
	quest.45CC83BFE52DC02B.title: "&lQuest: Mystique of the &a&lOkapi&r       "
	quest.461357B05209F103.quest_desc: [
		""
		"The playful &a&lOtter&r lives in rivers and can open clams. With a 5% chance, they may find a pearl, which can be used to craft ender pearls and pearl necklaces. Their curious behavior makes them a delightful creature to encounter."
	]
	quest.461357B05209F103.quest_subtitle: "&lObserve an &aOtter&r &lin a river       "
	quest.461357B05209F103.title: "   &lQuest: Observe an Otter          "
	quest.461F4057E1E1BFB9.quest_desc: [
		""
		"Craft sturdy &l&aKopje fences&r to build pens, pathways, and decorative areas, adding a natural construct touch to your wilderness."
		""
		"These &l&afences&r made from kopje wood blend perfectly with your builds."
	]
	quest.461F4057E1E1BFB9.quest_subtitle: "&lCraft a set of &aKopje Fences&r        "
	quest.461F4057E1E1BFB9.title: "&lQuest: Craft &aKopje Fences&r       "
	quest.4679524E88FC2545.quest_desc: [
		""
		"The Asian Leopard Cat is a small wild feline known for its agility and distinctive spotted coat."
		""
		"Discover an &a&lAsian Leopard Cat&r in forests or grasslands and observe its cautious yet curious behavior as it explores its territory."
	]
	quest.4679524E88FC2545.quest_subtitle: "&lDiscover an &a&lAsian Leopard Cat&r        "
	quest.4679524E88FC2545.title: "&lQuest: Discover an &a&lAsian Leopard Cat&r          "
	quest.4713516F6CA14939.quest_desc: [
		""
		"The &a&lArrows of Wither&r inflict the wither effect on impact, steadily draining health and making them a dangerous weapon against powerful foes."
	]
	quest.4713516F6CA14939.quest_subtitle: "&lCraft &aArrows of Wither&r       "
	quest.4713516F6CA14939.title: "&lQuest: Craft &aArrows of Wither&r        "
	quest.4769E74D268B72B3.quest_desc: [
		""
		"Craft the quirky &a&lLlama Plushie&r inspired by the colorful and proud llamas found in mountains. Perfect for vibrant decorations."
	]
	quest.4769E74D268B72B3.quest_subtitle: "&lCraft the &aLlama Plushie&r        "
	quest.4769E74D268B72B3.title: "&lQuest: Craft &aLlama Plushie&r        "
	quest.47B0F7B2086FD52E.quest_desc: [
		""
		"&a&lSilk&r is a refined material obtained from silk cocoons and jumping spiders. It is used to craft silk leashes, grappling hooks, and other lightweight tools."
	]
	quest.47B0F7B2086FD52E.quest_subtitle: "&lObtain &aSilk     "
	quest.47B0F7B2086FD52E.title: "&lQuest: Obtain Silk     "
	quest.47C5A04EDF8C41FA.quest_desc: [
		""
		"The &a&lCrate of Salt&r consolidates organic salt into a convenient shipment, allowing material to be transported or stored efficiently."
	]
	quest.47C5A04EDF8C41FA.quest_subtitle: "&lCraft a &aCrate of Salt&r       "
	quest.47C5A04EDF8C41FA.title: "&lQuest: Craft &aCrate of Salt&r       "
	quest.482CE0D3F7DF6B25.quest_desc: [
		""
		"Make the cute and feathery &a&lChicken Plushie&r, inspired by the tiny birds wandering plains and farms. Perfect decorative touch for rural builds."
	]
	quest.482CE0D3F7DF6B25.quest_subtitle: "&lCraft the &aChicken Plushie&r      "
	quest.482CE0D3F7DF6B25.title: "&lQuest: Craft &aChicken Plushie&r        "
	quest.4845CF0E47AADD8E.quest_desc: [
		""
		"Glowing beetles secrete a thick, luminous fluid that can be carefully collected."
		""
		"This radiant substance is prized for crafting and alchemical experiments, adding a magical glow to potions and tools."
	]
	quest.4845CF0E47AADD8E.quest_subtitle: "&lCollect a bottle of &a&lGlowing Beetle Juice&r         "
	quest.4845CF0E47AADD8E.title: "    &lQuest: Obtain &a&lGlowing Beetle Juice&r             "
	quest.489A528C4E82BBDE.quest_desc: [
		""
		"Snails are small, slow‑moving &a&lcreatures&r that wander peacefully through forests, gardens, and damp ground."
		""
		"Though fragile, their steady pace and spiral &b&lshells&r add a quiet charm to any place they appear."
		""
		"&l&7Bred with: &cCarrot, Apple"
	]
	quest.489A528C4E82BBDE.quest_subtitle: "&lSpot a &a&lSnail&r &lafter rain&r      "
	quest.489A528C4E82BBDE.title: "&lQuest: Trail of &a&lPatience&r      "
	quest.4B46A82EA376ED47.quest_desc: [
		""
		"Search the rivers and watch a graceful &a&lDragonfly&r hovering above the water. These creatures can be tamed with spider eyes and will protect you once domesticated. They can even wear dragonfly armor to increase their health. A tiny but loyal airborne companion."
	]
	quest.4B46A82EA376ED47.quest_subtitle: "&lObserve a &aDragonfly&r &lnear a river       "
	quest.4B46A82EA376ED47.title: "    &lQuest: Observe a Dragonfly            "
	quest.4BCE87F8DEE8786D.quest_desc: [
		""
		"Silent and deadly, the &a&lShark&r glides through the water, watching everything that enters its domain."
		""
		"It circles its prey with calm precision, and only the brave dare get close to its dark waters."
	]
	quest.4BCE87F8DEE8786D.quest_subtitle: "&lLocate a &a&lShark&r &lin the ocean&r      "
	quest.4BCE87F8DEE8786D.title: "&lQuest: Terror of the &a&lDepths&r       "
	quest.4BE67858FCC46EE6.quest_desc: [
		""
		"Craft a sleek &a&lKopje Trapdoor&r to use for floors, hidden entrances, or decorative accents. This trapdoor adds versatility and charm to your builds."
	]
	quest.4BE67858FCC46EE6.quest_subtitle: "&lCraft a &aKopje Trapdoor&r       "
	quest.4BE67858FCC46EE6.title: "&lQuest: Craft &aKopje Trapdoor&r        "
	quest.4C02B5D2A2F7CA75.quest_desc: [
		""
		"Explore rocky deserts and arid cliffs to discover a &a&lChuckwalla&r, a gentle herbivorous lizard that inflates its body to wedge into crevices."
		""
		"Watch it bask beneath the hot sun or retreat into narrow cracks for shelter whenever it senses danger."
	]
	quest.4C02B5D2A2F7CA75.quest_subtitle: "&lDiscover &a&lChuckwalla&r      "
	quest.4C02B5D2A2F7CA75.title: "&lQuest: Discover a &a&lChuckwalla&r        "
	quest.4C0E02090C66012A.quest_desc: [
		""
		"The &a&lDiamond Dragonfly Armor&r provides the highest level of protection for a dragonfly companion, greatly increasing its survivability."
	]
	quest.4C0E02090C66012A.quest_subtitle: "&lCraft &aDiamond Dragonfly Armor       "
	quest.4C0E02090C66012A.title: "&lQuest: Craft Diamond Dragonfly Armor          "
	quest.4C541F11C5676453.quest_desc: [
		""
		"This viscous &a&lGoo&r is secreted by certain critters and clings to anything it touches."
		""
		"Crafters prize it for organic recipes and strange mixtures, where its stretchy, elastic texture helps bind materials together."
	]
	quest.4C541F11C5676453.quest_subtitle: "&lAcquire &a&lGoo&r "
	quest.4C541F11C5676453.title: "&lQuest: Obtain &a&lGoo&r     "
	quest.4C548A6196192FC3.quest_desc: [
		""
		"Ducks gather peacefully near &9&lrivers&r and small lakes, filling the shoreline with gentle quacks and curious behavior."
		""
		"Their bright &a&lfeathers&r and lively presence bring charm to watery areas, making them some of the friendliest creatures you will spot on your travels."
	]
	quest.4C548A6196192FC3.quest_subtitle: "&lFind a &a&lDuck&r    "
	quest.4C548A6196192FC3.title: "&lQuest: Quacks of the &a&lDuck&r       "
	quest.4D2CA4DC6AED5291.quest_desc: [
		""
		"Stitch the creepy crawly &a&lSpider Plushie&r, inspired by eight-legged predators of caves and night forests. Surprisingly adorable in plush form."
	]
	quest.4D2CA4DC6AED5291.quest_subtitle: "&lCraft the &aSpider Plushie&r       "
	quest.4D2CA4DC6AED5291.title: "&lQuest: Craft &aSpider Plushie&r        "
	quest.4D4C6F33128DB55F.quest_desc: [
		""
		"&l&aKoi fish&r inhabit rivers and can be collected using a bucket. Groups of koi grant the player luck, making them both decorative and beneficial companions."
	]
	quest.4D4C6F33128DB55F.quest_subtitle: "&lObtain a &aKoi Fish      "
	quest.4D4C6F33128DB55F.title: "&lQuest: Obtain a Koi Fish       "
	quest.4EB8884E4F260C3C.quest_desc: [
		""
		"The &a&lCrimson Kelp Carpet&r is crafted from crimson kelp strands and adds organic texture to floors and decorative spaces in Nether structures."
	]
	quest.4EB8884E4F260C3C.quest_subtitle: "&lCraft a &aCrimson Kelp Carpet&r        "
	quest.4EB8884E4F260C3C.title: "&lQuest: Craft &aCrimson Kelp Carpet&r         "
	quest.4EC9903CE79BF990.quest_desc: [
		""
		"The &a&lLava Vision&r potion grants the ability to see clearly and fish effectively in lava environments, making navigation far safer."
	]
	quest.4EC9903CE79BF990.quest_subtitle: "&lBrew a &aPotion of Lava Vision&r        "
	quest.4EC9903CE79BF990.title: "&lQuest: Brew &aPotion of Lava Vision&r         "
	quest.4F19D14AA1B2CC2E.quest_desc: [
		""
		"Welcome to &a&lKoopa’s Critters&r, a wildlife-focused addon that brings a wide range of real-world animals into your world."
		""
		"Encounter creatures from deserts, forests, oceans, mountains, and more, each with distinct behaviors, habitats, and animations that make the world feel alive."
	]
	quest.4F19D14AA1B2CC2E.quest_subtitle: "&lDiscover the &a&lKoopa’s Critters&r &lmod&r         "
	quest.4F19D14AA1B2CC2E.title: "&lQuest: Welcome to &a&lKoopa’s Critters&r &lmod&r          "
	quest.50601DB5CD4E9C9A.quest_desc: [
		""
		"Create a &a&lMossy Oak Fence&r inspired by the rustic boundaries around Ribbit settlements."
		""
		"These overgrown wooden fences are perfect for pens, gardens, and village paths, adding a touch of wild swamp charm to your builds."
	]
	quest.50601DB5CD4E9C9A.quest_subtitle: "&lCraft a &a&lMossy Oak Fence&r      "
	quest.50601DB5CD4E9C9A.title: "&lQuest: Craft a &a&lMossy Oak Fence&r         "
	quest.50D2DB968A832B6D.quest_desc: [
		""
		"Craft a &a&lKopje Door&r, a signature element for &a&lKopje Structures&r. Its naturalistic design blends well with forest and savanna builds, bringing character to your homes."
	]
	quest.50D2DB968A832B6D.quest_subtitle: "&lCraft a &aKopje Door&r      "
	quest.50D2DB968A832B6D.title: "&lQuest: Craft &aKopje Door&r       "
	quest.50D9D1992202F011.quest_desc: [
		""
		"An &a&lOwl Pellet&r is a compact mass coughed up by owls after they feed, packed with fur and tiny bones."
		""
		"These pellets can be broken apart for crafting components or studied to learn more about the prey and habits of nearby wildlife."
	]
	quest.50D9D1992202F011.quest_subtitle: "&lObtain an &a&lOwl Pellet&r     "
	quest.50D9D1992202F011.title: "&lQuest: Obtain an &a&lOwl Pellet&r         "
	quest.50F1A1A1D778F5BD.quest_desc: [
		""
		"The &a&lBlazefish&r is often found near Nether fortresses, its fiery presence makes it one of the most challenging fish to obtain."
	]
	quest.50F1A1A1D778F5BD.quest_subtitle: "&lObtain a &aBlazefish&r     "
	quest.50F1A1A1D778F5BD.title: "&lQuest: Obtain &aBlazefish&r      "
	quest.5154A2BD9B901932.quest_desc: [
		""
		"Mobility matters. The &a&lChocobo Leggings&r help keep your chocobo agile while still giving solid protection."
		""
		"This piece lets your mount face dangers without losing &b&lspeed&r or flexibility, so craft the leggings and get your bird ready for tougher challenges."
	]
	quest.5154A2BD9B901932.quest_subtitle: "&lCraft the &a&lChocobo Leggings&r       "
	quest.5154A2BD9B901932.title: "&lQuest: Forging the &a&lChocobo Leggings&r          "
	quest.5286020BFBA1E82C.quest_desc: [
		""
		"The &a&lObsidianfish&r swims near hardened lava formations, its body as dark and tough as obsidian. It is often found in deep and dangerous Nether waters."
	]
	quest.5286020BFBA1E82C.quest_subtitle: "&lObtain an &aObsidianfish&r     "
	quest.5286020BFBA1E82C.title: "&lQuest: Obtain &aObsidianfish&r       "
	quest.562F37D864A5EF2F.quest_desc: [
		""
		"Lions are powerful predators that roam the &a&lopen grasslands&r."
		""
		"If you wander too close, a lion will not hesitate to attack, defending its territory with ferocity."
		""
		"Explorers may rarely encounter an albino lion, a striking and majestic variant highly sought after by collectors."
		""
		"&l&7Bred with: &cBeef, Rabbit, Chicken"
	]
	quest.562F37D864A5EF2F.quest_subtitle: "&lFind a &a&lLion&r &lin its territory       "
	quest.562F37D864A5EF2F.title: "&lQuest: Roar of the &a&lKing&r      "
	quest.563C6C4242AF5802.quest_desc: [
		""
		"Build a set of &a&lMossy Oak Stairs&r to match your swamp‑themed builds."
		""
		"These stairs use mossy oak planks and are a staple of Ribbit architecture, perfect for layered, organic structures."
	]
	quest.563C6C4242AF5802.quest_subtitle: "&lCraft a set of &a&lMossy Oak Stairs&r        "
	quest.563C6C4242AF5802.title: "&lQuest: Craft &a&lMossy Oak Stairs&r        "
	quest.5644D2E3109AFE55.quest_desc: [
		""
		"The &a&lLava Fishing Rod&r is specialized tool designed to let players fish safely in extreme lava heat pools across the Nether and retrieve unique molten creatures."
	]
	quest.5644D2E3109AFE55.quest_subtitle: "&lCraft a &aLava Fishing Rod&r        "
	quest.5644D2E3109AFE55.title: "&lQuest: Craft &aLava Fishing Rod&r          "
	quest.570A161993566673.quest_desc: [
		""
		"Dive into deeper oceans to discover a &a&lBowmouth Guitarfish&r, a curious animal that looks like a mix between a shark and a ray."
		""
		"Watch it glide over the sea floor and take in its unusual silhouette as it moves through the sand."
	]
	quest.570A161993566673.quest_subtitle: "&lDiscover &a&lBowmouth Guitarfish&r        "
	quest.570A161993566673.title: "&lQuest: Discover a &a&lBowmouth Guitarfish&r          "
	quest.588B7E65E08277A2.quest_desc: [
		""
		"The colorful &a&lKoi Fish&r swims peacefully in rivers and can be picked up with a bucket. When multiple koi gather, they grant the player the Luck effect. Calm, graceful, and beneficial to any river explorer."
	]
	quest.588B7E65E08277A2.quest_subtitle: "&lObserve a &aKoi Fish&r &lin a river        "
	quest.588B7E65E08277A2.title: "   &lQuest: Observe a Koi Fish          "
	quest.589B64459CC469A7.quest_desc: [
		""
		"These smooth, curved horns are occasionally shed or dropped by Impallas in the wild."
		""
		"Artisans prize each &a&lImpalla Horn&r for crafting sturdy tools, ornate decorations, and ceremonial ritual items."
	]
	quest.589B64459CC469A7.quest_subtitle: "&lCollect an &a&lImpalla Horn&r        "
	quest.589B64459CC469A7.title: "&lQuest: Obtain an &a&lImpalla Horn&r        "
	quest.58CBBC129EA693E2.quest_desc: [
		""
		"The small &a&lJumping Spider&r can be tamed using dragonfly wings. Once tamed, it protects the player and attacks silverfish. It also drops jumping spider silk, used to craft the silk leash and silk grappling hook. Tiny but surprisingly powerful."
	]
	quest.58CBBC129EA693E2.quest_subtitle: "&lObserve a &aJumping Spider&r &lin its natural habitat              "
	quest.58CBBC129EA693E2.title: "               &lQuest: Observe a Jumping Spider                         "
	quest.591FE06DF13575EA.quest_desc: [
		""
		"Owls glide silently through the trees and night sky, watching everything from the shadows."
		""
		"With the right &a&ltreat&r, an &a&lOwl&r can be tamed and will quietly follow you as a gentle nighttime companion."
		""
		"&l&7Tamed with: &cSeed"
		""
		"&l&7Bred with: &cMelon Seeds, Pumpkin Seeds, Beetroot Seeds"
	]
	quest.591FE06DF13575EA.quest_subtitle: "&lFind an &a&lOwl&r &lafter dusk&r      "
	quest.591FE06DF13575EA.title: "&lQuest: Watcher of the &a&lNight&r       "
	quest.5A09F9CA5E6F2E41.quest_desc: [
		""
		"Create the warm &a&lStrider Plushie&r, modeled after Nether lava walkers. A quirky plush perfect for fiery themed rooms."
	]
	quest.5A09F9CA5E6F2E41.quest_subtitle: "&lCraft the &aStrider Plushie&r       "
	quest.5A09F9CA5E6F2E41.title: "&lQuest: Craft &aStrider Plushie&r       "
	quest.5A24358215C55FD6.quest_desc: [
		""
		"Ribbits love the swamps, so head out and &a&lsearch&r your world until you discover a swamp biome."
		""
		"This is your first step toward meeting different Ribbits and learning more about their &b&lhabitats&r."
	]
	quest.5A24358215C55FD6.quest_subtitle: "&lFind a &a&lSwamp Biome&r     "
	quest.5A24358215C55FD6.title: "&lQuest: Swamp &a&lExplorer&r      "
	quest.5A2B839E54721DDB.quest_desc: [
		""
		"Forged from tough Impalla horns, the &a&lImpalla Horn Leggings&r offer sturdy lower-body protection."
		""
		"Their carved, wildlife-themed plates give a rugged look while keeping the wearer safe on dangerous hunts."
	]
	quest.5A2B839E54721DDB.quest_subtitle: "&lCraft &a&lImpalla Horn Leggings&r       "
	quest.5A2B839E54721DDB.title: "&lQuest: Craft &a&lImpalla Horn Leggings&r          "
	quest.5AFA116B54B146B9.quest_desc: [
		""
		"The &a&lPearl Necklace II&r is an upgraded accessory created by refining the first necklace, granting improved effects."
	]
	quest.5AFA116B54B146B9.quest_subtitle: "&lCraft a &aPearl Necklace II        "
	quest.5AFA116B54B146B9.title: "&lQuest: Craft Pearl Necklace II        "
	quest.5BA80D57CF75431F.quest_desc: [
		""
		"Planks, the beautifully &l&acarved&r variant of &l&akopje&r wood, look elegant and add an artistic style of kopje architecture to any structure."
		""
		"These carved &l&aplanks&r enhance your builds with a decorative touch."
	]
	quest.5BA80D57CF75431F.quest_subtitle: "&lCraft a set of &aCarved Kopje Planks&r          "
	quest.5BA80D57CF75431F.title: "&lQuest: Craft &aCarved Kopje Planks&r         "
	quest.5C8675437564AAF6.quest_desc: [
		""
		"Travel into temperate regions to discover a &a&lCalifornia Quail&r, a small ground-dwelling bird with a distinct crest and lively demeanor."
		""
		"Watch as it darts in groups through bushes and tall grass, foraging together for seeds and insects."
	]
	quest.5C8675437564AAF6.quest_subtitle: "&lDiscover &a&lCalifornia Quail&r       "
	quest.5C8675437564AAF6.title: "&lQuest: Discover a &a&lCalifornia Quail&r         "
	quest.5D3244EF7578097F.quest_desc: [
		""
		"Craft the fierce &a&lPillager Plushie&r, raiders by crossbow wielding plains. A soft, harmless version of one of the most notorious village threats."
	]
	quest.5D3244EF7578097F.quest_subtitle: "&lCraft the &aPillager Plushie&r       "
	quest.5D3244EF7578097F.title: "&lQuest: Craft &aPillager Plushie&r        "
	quest.5D42B46B9EA101FC.quest_desc: [
		""
		"Seahorses are colorful ocean &a&ldwellers&r that wander gently through reefs and underwater meadows in small groups."
		""
		"They can be scooped up with a water &b&lbucket&r and later released, making them peaceful and decorative aquatic companions."
	]
	quest.5D42B46B9EA101FC.quest_subtitle: "&lSpot a &a&lSeahorse&r &lunderwater&r     "
	quest.5D42B46B9EA101FC.title: "&lQuest: Tides of &a&lGrace&r      "
	quest.5D7492997FD80BB9.quest_desc: [
		""
		"The vibrant &a&lLush Lily Pad&r grows in the shallow ponds scattered throughout Ribbit villages."
		""
		"Its thick, colorful leaves stand out against the murky swamp, so explore the village water gardens and gather this lush aquatic plant."
	]
	quest.5D7492997FD80BB9.quest_subtitle: "&lObtain a &a&lLush Lily Pad&r      "
	quest.5D7492997FD80BB9.title: "&lQuest: Obtain a &a&lLush Lily Pad&r        "
	quest.5DA7210193B24C09.quest_desc: [
		""
		"Create the &a&lDonkey Plushie&r symbolizing the hard-working companion of travelers. A charming piece for adventurer themed homes."
	]
	quest.5DA7210193B24C09.quest_subtitle: "&lCraft the &aDonkey Plushie&r       "
	quest.5DA7210193B24C09.title: "&lQuest: Craft &aDonkey Plushie&r        "
	quest.5DEFA11D8C890A18.quest_desc: [
		""
		"The ostrich is a swift, non‑flying bird that races across the dry sands."
		""
		"When two ostriches pair up, one will run to the nearest sand block to build a nest and lay an egg, starting a new life cycle."
		""
		"Adventurers can also &a&lride an ostrich&r by right‑clicking it, turning it into a fast and unique travel companion."
		""
		"&l&7Bred with: &cWheat"
	]
	quest.5DEFA11D8C890A18.quest_subtitle: "&lSpot an &a&lOstrich&r &lin the desert&r      "
	quest.5DEFA11D8C890A18.title: "&lQuest: Desert &a&lRunner&r      "
	quest.5EFB1DC4C8958778.quest_desc: [
		""
		"Attenborough’s Echidnas are unusual egg-laying mammals covered in sharp spines."
		""
		"Discover one in dense forest areas to learn more about these remarkable creatures and observe their slow, deliberate movements as they forage."
	]
	quest.5EFB1DC4C8958778.quest_subtitle: "&lDiscover an &a&lAttenborough’s Echidna&r        "
	quest.5EFB1DC4C8958778.title: "&lQuest: Discover an &a&lAttenborough’s Echidna&r           "
	quest.5F3CCCE5408332F3.quest_desc: [
		""
		"The &a&lIron Dragonfly Armor&r increases a tamed dragonfly’s durability, allowing it to better protect its owner in combat."
	]
	quest.5F3CCCE5408332F3.quest_subtitle: "&lCraft &aIron Dragonfly Armor       "
	quest.5F3CCCE5408332F3.title: "&lQuest: Craft Iron Dragonfly Armor         "
	quest.5F452A32F024B73A.quest_desc: [
		""
		"Craft the loyal &a&lWolf Plushie&r that represent roaming forests. Perfect companions for adventurers who value faithful friends."
	]
	quest.5F452A32F024B73A.quest_subtitle: "&lCraft the &aWolf Plushie&r       "
	quest.5F452A32F024B73A.title: "&lQuest: Craft &aWolf Plushie&r       "
	quest.5FB95FC370523353.quest_desc: [
		""
		"&a&lWarped Kelp&r grows in warped forest regions, adapted to strange energies. Its twisted structure makes it useful for unique recipes and fishing related crafts."
	]
	quest.5FB95FC370523353.quest_subtitle: "&lObtain &aWarped Kelp&r      "
	quest.5FB95FC370523353.title: "&lQuest: Obtain &aWarped Kelp&r       "
	quest.5FBC1D3E91244F61.quest_desc: [
		""
		"Crabs crawl along the &e&lbeaches&r, hiding between rocks and sand as the waves roll in."
		""
		"Their sideways steps and snapping &c&lclaws&r make them iconic coastal companions, bringing a bit of life to every shoreline you explore."
	]
	quest.5FBC1D3E91244F61.quest_subtitle: "&lLocate a &a&lCrab&r     "
	quest.5FBC1D3E91244F61.title: "&lQuest: Scuttle of the &a&lCrab&r       "
	quest.602B12A127437D03.quest_desc: [
		""
		"Create the tiny &a&lBat Plushie&r, a tribute to the quiet creatures fluttering through caves. A cute addition for builders who love underground themes."
	]
	quest.602B12A127437D03.quest_subtitle: "&lCraft the &aBat Plushie&r       "
	quest.602B12A127437D03.title: "&lQuest: Craft &aBat Plushie&r       "
	quest.60C3A7EC3EE4BA08.quest_desc: [
		""
		"&a&lSaddle Bags&r let your chocobo carry extra items while you travel, making long journeys much easier."
		""
		"Crafting a pair will prepare you for exploration and resource gathering in distant areas, and even early in your adventure they are incredibly &b&luseful&r."
	]
	quest.60C3A7EC3EE4BA08.quest_subtitle: "&lCraft &a&lChocobo Saddle Bags&r      "
	quest.60C3A7EC3EE4BA08.title: "&lQuest: Crafting &a&lSaddle Bags&r       "
	quest.63761EF7A9AF0303.quest_desc: [
		""
		"Craft &a&lKopje Plank Slabs&r, ideal for structural transitions, furniture or slabs. These smooth help shape natural and cozy &a&lKopje Style&r constructions."
	]
	quest.63761EF7A9AF0303.quest_subtitle: "&lCraft a set of &aKopje Plank Slabs&r       "
	quest.63761EF7A9AF0303.title: "&lQuest: Craft &aKopje Plank Slabs&r        "
	quest.63C0D134F10B6300.quest_desc: [
		""
		"Travel into warped depths to encounter the elusive &a&lEyeball Fish&r, a strange creature with eerie gazes. It can be found swimming near warped biomes pools or dark nether caverns, lurking in pools of strange water."
	]
	quest.63C0D134F10B6300.quest_subtitle: "&lDiscover the &aEyeball Fish&r &lin the Nether            "
	quest.63C0D134F10B6300.title: "        &lQuest: Discover &aEyeball Fish&r                  "
	quest.64D9068882C9862B.quest_desc: [
		""
		"Look for the agile &a&lFerret&r wandering through plains and forests. They can be tamed with raw rabbit, and once tamed, they can dig for loot every few minutes. They'll also help hunt chickens and rabbits, making them both adorable and useful allies."
	]
	quest.64D9068882C9862B.quest_subtitle: "&lObserve a &aFerret&r &lin plains or forests          "
	quest.64D9068882C9862B.title: "           &lQuest: Observe a Ferret                  "
	quest.657B337BF9255614.quest_desc: [
		""
		"&a&lWither Bonefish&r lurks in dangerous energy regions influenced by dark magic. Handle it with caution due to its unstable nature."
	]
	quest.657B337BF9255614.quest_subtitle: "&lObtain a &aWither Bonefish&r        "
	quest.657B337BF9255614.title: "&lQuest: Obtain &aWither Bonefish&r         "
	quest.6676CDF044C7F2AD.quest_desc: [
		""
		"The meat of a giant snail is rare and challenging to harvest, but it boasts unique culinary qualities."
		""
		"Chefs use this &a&lRaw Giant Snail&r in refined dishes and experimental recipes where its rich, delicate flavor truly stands out."
	]
	quest.6676CDF044C7F2AD.quest_subtitle: "&lAcquire &a&lRaw Giant Snail&r     "
	quest.6676CDF044C7F2AD.title: "&lQuest: Obtain &a&lRaw Giant Snail&r        "
	quest.66D5667D29F8D895.quest_desc: [
		""
		"Once you have gathered Kopje Fig Logs, craft them into &l&aplanks&r to use in building and creating new items."
		""
		"These planks are sturdy and versatile, making them perfect for all your &l&econstruction&r needs during your adventures."
	]
	quest.66D5667D29F8D895.quest_subtitle: "&l&7Craft &e8 &aKopje Fig Planks       "
	quest.66D5667D29F8D895.title: "&lQuest: Craft &aKopje Fig Planks&r        "
	quest.67062581B9954B0B.quest_desc: [
		""
		"The &a&lPearl Necklace III&r represents the final and most powerful pearl necklace, crafted for adventurers seeking maximum benefit."
	]
	quest.67062581B9954B0B.quest_subtitle: "&lCraft a &aPearl Necklace III        "
	quest.67062581B9954B0B.title: "&lQuest: Craft Pearl Necklace III          "
	quest.679D0364B0087CF0.quest_desc: [
		""
		"The &a&lCrimson Kelp&r grows in hot Nether waters near crimson forests, thriving in lava as a key ingredient for specialized crafting."
	]
	quest.679D0364B0087CF0.quest_subtitle: "&lObtain &aCrimson Kelp&r      "
	quest.679D0364B0087CF0.title: "  &lQuest: Obtain &aCrimson Kelp&r           "
	quest.688CF6A24AB9B3BA.quest_desc: [
		""
		"The adorable &l&aRed Panda&r lives in jungles and often sleeps through the day. It can be bred with bamboo and tamed with sweet berries. When tamed, red pandas scare away most aggressive neutral mobs. Cute, loyal, and protective."
	]
	quest.688CF6A24AB9B3BA.quest_subtitle: "&lObserve a &aRed Panda&r &lin a jungle          "
	quest.688CF6A24AB9B3BA.title: "     &lQuest: Observe a Red Panda              "
	quest.6997C9428835E3EB.quest_desc: [
		""
		"Explore the &a&lBasalt Deltas&r to discover a magma cube fish, a bouncy fish formed from molten slime materials. Observe its bubbling energetic motions as it swims through lava."
	]
	quest.6997C9428835E3EB.quest_subtitle: "&lDiscover the &aMagma Cube Fish&r &lin the Nether         "
	quest.6997C9428835E3EB.title: "        &lQuest: Discover &aMagma Cube Fish&r                  "
	quest.69A78B43D0BC23E7.quest_desc: [
		""
		"Welcome to the &a&lCritters and Companions&r questline! This mod introduces a variety of adorable, lively, and helpful creatures to the world of Minecraft from playful otters and loyal ferrets to colorful koi fish, graceful dragonflies, and even magical sea bunnies."
		""
		"Each critter brings unique behaviors, abilities, and interactions that make the world feel more alive. Your adventure starts here: explore, observe, and enjoy the company of these wonderful new companions."
	]
	quest.69A78B43D0BC23E7.quest_subtitle: "&lBegin your journey&r   "
	quest.69A78B43D0BC23E7.title: "&lQuest: Welcome to &aCritters and Companions!           "
	quest.6A84A51D802E10E3.quest_desc: [
		""
		"Craft the iconic &a&lCreeper Plushie&r, representing the silent, unpredictable creature that stalks the night. A harmless plush version of Minecraft's most explosive enemy."
	]
	quest.6A84A51D802E10E3.quest_subtitle: "&lCraft the &aCreeper Plushie&r      "
	quest.6A84A51D802E10E3.title: "&lQuest: Craft &aCreeper Plushie&r       "
	quest.6AEFE4DFF4D42B30.quest_desc: [
		""
		"Welcome to &a&lMore Animals 2&r, an expanded evolution of the original &b&lMore Animals&r modpack."
		""
		"This version offers a much larger selection of mods and content, all focused on giving you an amazing time."
		""
		"You will find exploration, combat, decoration, technology, and even more adventures waiting for you."
		""
		"At the heart of it all are the &a&lanimals&r, with a wide collection of animal‑related mods that bring life and personality to your world."
	]
	quest.6AEFE4DFF4D42B30.quest_subtitle: "&lBegin your journey in &a&lMore Animals 2&r         "
	quest.6AEFE4DFF4D42B30.title: "  &lQuest: Welcome to &a&lMore Animals 2&r           "
	quest.6B681BE6B4818741.quest_desc: [
		""
		"Inspired by classic pastries, the &a&lFig Neuton&r blends sweet figs with soft dough into a compact bar."
		""
		"This filling snack is ideal for long journeys, giving travelers a tasty burst of energy in every bite."
	]
	quest.6B681BE6B4818741.quest_subtitle: "&lCraft a &a&lFig Neuton&r     "
	quest.6B681BE6B4818741.title: "&lQuest: Craft a &a&lFig Neuton&r       "
	quest.6BA4688185E0E081.quest_desc: [
		""
		"Craft the mischievous &a&lWitch Plushie&r, dwellers of swamp potion throwing huts. A magical and quirky addition to any plush collection."
	]
	quest.6BA4688185E0E081.quest_subtitle: "&lCraft the &aWitch Plushie&r       "
	quest.6BA4688185E0E081.title: "&lQuest: Craft &aWitch Plushie&r       "
	quest.6BA8D0C896A5D0B2.quest_desc: [
		""
		"Muntjac antlers are naturally shed and can be discovered wherever these shy deer-like creatures roam."
		""
		"They are valued as sturdy materials for crafting and as prized trade goods among collectors and merchants."
	]
	quest.6BA8D0C896A5D0B2.quest_subtitle: "&lRecover a &a&lMuntjac Antler&r      "
	quest.6BA8D0C896A5D0B2.title: "&lQuest: Obtain a &a&lMuntjac Antler&r        "
	quest.6BE83C3896BD0E05.quest_desc: [
		""
		"Explore warm ocean waters to discover a &a&lBonnethead Shark&r, a small hammerhead with a rounded, shovel-like head."
		""
		"Approach it cautiously and watch its calm, curious swimming to learn more about its behavior in the wild sea."
	]
	quest.6BE83C3896BD0E05.quest_subtitle: "&lDiscover &a&lBonnethead Shark&r       "
	quest.6BE83C3896BD0E05.title: "&lQuest: Discover a &a&lBonnethead Shark&r         "
	quest.6C7957C87D765302.quest_desc: [
		""
		"The &a&lGold Dragonfly Armor&r enhances a dragonfly with lightweight protection and improved resilience while maintaining agility."
	]
	quest.6C7957C87D765302.quest_subtitle: "&lCraft &aGold Dragonfly Armor         "
	quest.6C7957C87D765302.title: "&lQuest: Craft Gold Dragonfly Armor        "
	quest.6C7D85AE21A720CE.quest_desc: [
		""
		"&l&aSea bunny slime&r is carefully collected using glass bottles from sea bunnies. This shimmering substance is used to craft sea bunny slime blocks and other aquatic items."
	]
	quest.6C7D85AE21A720CE.quest_subtitle: "&lObtain a &aSea Bunny Slime Bottle&r        "
	quest.6C7D85AE21A720CE.title: "&lQuest: Obtain Sea Bunny Slime         "
	quest.6CBDE5DA0BE4B2E4.quest_desc: [
		""
		"&a&lGysahl Greens&r are the favorite food of chocobos and the base of any bond with these creatures."
		""
		"Plant them in moist soil, care for them as they grow, and harvest their &b&lfruit&r when it is ready."
		""
		"This will be your first real step toward taming and raising your own chocobos."
	]
	quest.6CBDE5DA0BE4B2E4.quest_subtitle: "&lHarvest your first &a&lGysahl Greens&r      "
	quest.6CBDE5DA0BE4B2E4.title: "   &lQuest: Cultivating the &a&lBond&r            "
	quest.6DA06CB887E96CCD.quest_desc: [
		""
		"The &a&lWither Potion&r inflicts the wither effect on targets, slowly draining health and making it a powerful offensive brew."
	]
	quest.6DA06CB887E96CCD.quest_subtitle: "&lBrew a &aPotion of Wither&r       "
	quest.6DA06CB887E96CCD.title: "&lQuest: Brew &aPotion of Wither&r        "
	quest.6E10AFC2B8CE09BA.quest_desc: [
		""
		"The delicate &a&lSwamp Daisy&r blooms around Ribbit homes, adding a bit of brightness to the murky swamp."
		""
		"Its resilience and soft &b&lglow&r make it a lovely souvenir, so search near paths and flower patches to pick one for yourself."
	]
	quest.6E10AFC2B8CE09BA.quest_subtitle: "&lObtain a &a&lSwamp Daisy&r &lfrom a village&r         "
	quest.6E10AFC2B8CE09BA.title: "   &lQuest: Obtain a &a&lSwamp Daisy&r            "
	quest.6E61C21AE4AD0D73.quest_desc: [
		""
		"The &a&lSteadfast Tread&r potion improves stability and resistance while moving across hazardous terrain, reducing knockback and enhancing control in dangerous Nether areas."
	]
	quest.6E61C21AE4AD0D73.quest_subtitle: "&lBrew a &aPotion of Steadfast Tread&r         "
	quest.6E61C21AE4AD0D73.title: "&lQuest: Brew &aPotion of Steadfast Tread&r            "
	quest.6FFA4D875AAD8E33.quest_desc: [
		""
		"The mysterious &a&lSwamp Lantern&r casts a soft glow throughout Ribbit villages, lighting up the swamp with an eerie shimmer."
		""
		"Check their huts, lamps, and pathways to collect one of these unique decorations and take a bit of swamp magic with you."
	]
	quest.6FFA4D875AAD8E33.quest_subtitle: "&lObtain a &a&lSwamp Lantern&r      "
	quest.6FFA4D875AAD8E33.title: "&lQuest: Obtain a &a&lSwamp Lantern&r        "
	quest.7188843EEC0E1F26.quest_desc: [
		""
		"The &a&lSilk Lead&r is a refined lead made from strong silk fibers, allowing players to safely guide and transport small critters."
	]
	quest.7188843EEC0E1F26.quest_subtitle: "&lCraft a &aSilk Lead      "
	quest.7188843EEC0E1F26.title: "&lQuest: Craft a Silk Lead       "
	quest.718BCC610CEF2DBA.quest_desc: [
		""
		"&l&aClams&r can be obtained from drowned or found in ocean chests. They can be opened by otters and may contain valuable pearls."
	]
	quest.718BCC610CEF2DBA.quest_subtitle: "&lObtain a &aClam&r     "
	quest.718BCC610CEF2DBA.title: "&lQuest: Obtain a Clam       "
	quest.71B35E23EAF17D28.quest_desc: [
		""
		"Explore the &a&lCrimson Forest&r to find this soft glowing radiant fish lava. Observe its gentle glow as it contrasts with the dark crimson terrain."
	]
	quest.71B35E23EAF17D28.quest_subtitle: "&lDiscover the &aGlowdine&r &lin the Nether        "
	quest.71B35E23EAF17D28.title: "      &lQuest: Discover &aGlowdine&r                "
	quest.71D22C28AE175583.quest_desc: [
		""
		"Venture into the &a&lBasalt Deltas&r to lava fish with an obsidianish, dense lava hardened obsidian body. Observe its heavy movements as it navigates volcanic terrain."
	]
	quest.71D22C28AE175583.quest_subtitle: "&lDiscover the &aObsidianfish&r &lin the Nether         "
	quest.71D22C28AE175583.title: "      &lQuest: Discover &aObsidianfish&r                 "
	quest.71DB8573BEF4FD57.quest_desc: [
		""
		"Welcome to &a&lRibbitts&r, a creature addon that introduces new frog‑like companions to your world."
		""
		"This mod adds lively, bouncy Ribbitts with their own behaviors and animations."
		""
		"Explore swamps, forests, and lakes to meet these adorable creatures and start your journey with this lighthearted, nature‑themed addon."
	]
	quest.71DB8573BEF4FD57.quest_subtitle: "&lDiscover the &a&lRibbitts&r &lmod&r       "
	quest.71DB8573BEF4FD57.title: "&lQuest: Welcome to &a&lRibbitts mod&r        "
	quest.72427923E86A72F1.quest_desc: [
		""
		"The &a&lArrows of Lava Vision&r apply the lava vision effect through their targets, revealing surroundings and enabling strategic combat and exploration."
	]
	quest.72427923E86A72F1.quest_subtitle: "&lCraft &aArrows of Lava Vision&r        "
	quest.72427923E86A72F1.title: "&lQuest: Craft &aArrows of Lava Vision&r          "
	quest.73F5EFB6991F359F.quest_desc: [
		""
		"Wander through the &a&lSearing Nether&r, a fiery variant of cod that thrives in lava filled environments. Observe its scorching scales as it moves through glowing pools."
	]
	quest.73F5EFB6991F359F.quest_subtitle: "&lDiscover the &aSearing Cod&r &lin the Nether        "
	quest.73F5EFB6991F359F.title: "      &lQuest: Discover &aSearing Cod&r                "
	quest.7448B30D2502AF44.quest_desc: [
		""
		"Assemble the adorable &a&lPanda Plushie&r, modeled after the playful bears of bamboo jungles. A sweet, decorative piece full of personality."
	]
	quest.7448B30D2502AF44.quest_subtitle: "&lCraft the &aPanda Plushie&r       "
	quest.7448B30D2502AF44.title: "&lQuest: Craft &aPanda Plushie&r       "
	quest.7494BC3EA638114D.quest_desc: [
		""
		"Travel through savannas and open grasslands to discover a &a&lCape Buffalo&r, a strong and resilient wild bovine."
		""
		"Watch the herd as it grazes, noticing how calm it remains while undisturbed and how quickly it reacts when it senses danger."
	]
	quest.7494BC3EA638114D.quest_subtitle: "&lDiscover &a&lCape Buffalo&r      "
	quest.7494BC3EA638114D.title: "&lQuest: Discover a &a&lCape Buffalo&r         "
	quest.74CDF87F7A721482.quest_desc: [
		""
		"The &a&lArrows of Steadfast Tread&r grant stability and resistance to affected entities, altering movement dynamics in hazardous terrain.."
	]
	quest.74CDF87F7A721482.quest_subtitle: "&lCraft &aArrows of Steadfast Tread&r        "
	quest.74CDF87F7A721482.title: "&lQuest: Craft &aArrows of Steadfast Tread&r          "
	quest.756BACC6AB925D55.quest_desc: [
		""
		"The &a&lChocobo Chestplate&r gives sturdy protection to the main body of your chocobo."
		""
		"It is the core of the armor set, shielding your companion during battles and long trips, so gather the needed materials and craft this essential &b&lpiece&r."
	]
	quest.756BACC6AB925D55.quest_subtitle: "&lCraft the &a&lChocobo Chestplate&r       "
	quest.756BACC6AB925D55.title: "&lQuest: Forging the &a&lChocobo Chestplate&r          "
	quest.75D47C8888482D4C.quest_desc: [
		""
		"Venture into rocky caves or dimly lit areas to discover a &a&lChinese Cave Gecko&r, a small reptile with bright colors suited to life in the dark."
		""
		"Watch its slow, careful steps as it moves along the rocks and explores every corner of its underground home."
	]
	quest.75D47C8888482D4C.quest_subtitle: "&lDiscover &a&lChinese Cave Gecko&r       "
	quest.75D47C8888482D4C.title: "&lQuest: Discover a &a&lChinese Cave Gecko&r          "
	quest.75FE9193E7FFD419.quest_desc: [
		""
		"The low-profile warped kelp carpet is made from warped kelp block, perfect for Nether builds detailing paths and interiors."
	]
	quest.75FE9193E7FFD419.quest_subtitle: "&lCraft &aWarped Kelp Carpet&r      "
	quest.75FE9193E7FFD419.title: "&lQuest: Craft &aWarped Kelp Carpet&r        "
	quest.760D3EB2DDBC19E2.quest_desc: [
		""
		"The charming &a&lSea Bunny&r can be found in ocean biomes and picked up with a bucket. Players can obtain sea bunny slime using glass bottles, which is used to craft sea bunny slime blocks. A tiny marine creature with magical properties."
	]
	quest.760D3EB2DDBC19E2.quest_subtitle: "&lObserve a &aSea Bunny&r &lin the ocean        "
	quest.760D3EB2DDBC19E2.title: "       &lQuest: Observe a Sea Bunny               "
	quest.763D5C74C98A5D55.quest_desc: [
		""
		"Craft the adorable &a&lPig Plushie&r, a snorting and carefree spirit of overworld pigs. Ideal for bringing warmth to any build."
	]
	quest.763D5C74C98A5D55.quest_subtitle: "&lCraft the &aPig Plushie&r      "
	quest.763D5C74C98A5D55.title: "&lQuest: Craft &aPig Plushie&r      "
	quest.76C18E69F7537110.quest_desc: [
		""
		"Crab claws are dropped by crabs that live along shores and rocky &a&lcoasts&r."
		""
		"This sturdy &c&lclaw&r is often used in crafting and stands as a reminder of the creature’s natural defenses."
	]
	quest.76C18E69F7537110.quest_subtitle: "&lObtain a &a&lCrab Claw&r      "
	quest.76C18E69F7537110.title: "&lQuest: Obtain a &a&lCrab Claw&r       "
	quest.76F24A5DE53DE1AA.quest_desc: [
		""
		"&a&lFortress Grouper&r inhabits massive fortress Nether waters. Strong and resilient, it is one of the most dangerous environments."
	]
	quest.76F24A5DE53DE1AA.quest_subtitle: "&lObtain a &aFortress Grouper&r      "
	quest.76F24A5DE53DE1AA.title: "&lQuest: Obtain &aFortress Grouper&r        "
	quest.77F5AA784CB02CA3.quest_desc: [
		""
		"The rhythmic &a&lMaraca&r is a special item that cannot be crafted, only found."
		""
		"Search Ribbit villages or trade with the Ribbits themselves to acquire one of these lively instruments, often played during swamp celebrations and rituals."
	]
	quest.77F5AA784CB02CA3.quest_subtitle: "&lObtain a &a&lMaraca&r &lfrom a Ribbit &r      "
	quest.77F5AA784CB02CA3.title: "  &lQuest: Obtain a &a&lMaraca&r         "
	quest.7810AD297C609969.quest_desc: [
		""
		"The &a&lGlowing Beetle Juice Block&r emits a soft, mystical light derived from bioluminescent beetles. Its vibrant glow makes it an excellent decorative block for magical or woodland environments."
	]
	quest.7810AD297C609969.quest_subtitle: "&lCraft a &aGlowing Beetle Juice Block&r         "
	quest.7810AD297C609969.title: "&lQuest: Craft &aGlowing Beetle Juice Block&r           "
	quest.7836202E8478E66C.quest_desc: [
		""
		"The large &a&lUmbrella Leaf&r grows along the outskirts of Ribbit villages, forming natural canopies that catch raindrops."
		""
		"Search their gardens and shaded clearings to harvest one of these impressive plants for yourself."
	]
	quest.7836202E8478E66C.quest_subtitle: "&lObtain an &a&lUmbrella Leaf&r       "
	quest.7836202E8478E66C.title: "&lQuest: Obtain an &a&lUmbrella Leaf&r        "
	quest.7972EE95F8031158.quest_desc: [
		""
		"The &a&lGrappling Hook&r uses silk to pull the player across gaps or upward, enabling agile movement and creative exploration."
	]
	quest.7972EE95F8031158.quest_subtitle: "&lCraft a &aGrappling Hook         "
	quest.7972EE95F8031158.title: "&lQuest: Craft a Grappling Hook         "
	quest.798890AA26188110.quest_desc: [
		""
		"The &a&lLava Pufferfish&r thrives in lava pools adapting its body to extreme Nether heat. Catch one carefully positioning near lava flows."
	]
	quest.798890AA26188110.quest_subtitle: "&lObtain a &aLava Pufferfish&r        "
	quest.798890AA26188110.title: "&lQuest: Obtain &aLava Pufferfish&r          "
	quest.7C2F5DD88B5F8512.quest_desc: [
		""
		"The &a&lSoul Sucker&r eerie soul feeds on lost souls near soul valleys. Its haunting energy appearance of its surroundings."
	]
	quest.7C2F5DD88B5F8512.quest_subtitle: "&lObtain a &aSoul Sucker&r       "
	quest.7C2F5DD88B5F8512.title: "&lQuest: Obtain &aSoul Sucker&r       "
	quest.7C3EFBB863738F97.quest_desc: [
		""
		"A &a&lCrate of Frass&r bundles large amounts of grass into one bulk container, making it easier to use in bulk crafting or environmental projects."
	]
	quest.7C3EFBB863738F97.quest_subtitle: "&lCraft a &aCrate of Frass&r       "
	quest.7C3EFBB863738F97.title: "&lQuest: Craft &aCrate of Frass&r         "
	quest.7C8950AFB42C5C46.quest_desc: [
		""
		"Binturongs are arboreal mammals often called “bearcats,” famous for their popcorn-like scent."
		""
		"Discover a &a&lBinturong&r in dense forests and watch its impressive climbing skills and nocturnal routines among the tree branches."
	]
	quest.7C8950AFB42C5C46.quest_subtitle: "&lDiscover a &a&lBinturong&r     "
	quest.7C8950AFB42C5C46.title: "&lQuest: Discover a &a&lBinturong&r        "
	quest.7CDAE7576AEA5D85.quest_desc: [
		""
		"The &a&lDodo&r is a mythical rediscovered creature, long thought lost to history."
		""
		"To meet one, you must delve into deep &9&lcaves&r and uncover a &e&lFossilized Spawn Egg&r, reviving a cheerful relic of ancient times."
	]
	quest.7CDAE7576AEA5D85.quest_subtitle: "&lFind a &a&lDodo&r     "
	quest.7CDAE7576AEA5D85.title: "&lQuest: Legacy of the &a&lDodo&r       "
	quest.7D5CBE92D72A26FC.quest_desc: [
		""
		"Organic salt forms through slow biological processes in soils, caves, and living creatures."
		""
		"Alchemists prize this &a&lOrganic Salt&r for preserving materials, enhancing crafting recipes, and triggering unusual chemical reactions."
	]
	quest.7D5CBE92D72A26FC.quest_subtitle: "&lCollect &a&lOrganic Salt&r      "
	quest.7D5CBE92D72A26FC.title: "&lQuest: Obtain &a&lOrganic Salt&r       "
	quest.7D5F70A4FCC85C0B.quest_desc: [
		""
		"By churning the rich milk of powerful buffalo creatures, you can produce creamy &a&lCape Buffalo Butter&r."
		""
		"This luxurious dairy ingredient is favored in advanced cooking, adding depth, energy, and flavor to complex recipes."
	]
	quest.7D5F70A4FCC85C0B.quest_subtitle: "&lCraft &a&lCape Buffalo Butter&r       "
	quest.7D5F70A4FCC85C0B.title: "&lQuest: Craft &a&lCape Buffalo Butter&r         "
	quest.7DC679EFB369F41F.quest_desc: [
		""
		"This &a&lMagma Cube Fish&r mimics the bouncing behavior of magma cubes through unpredictable lava filled areas. It thrives in unstable volcanic zones."
	]
	quest.7DC679EFB369F41F.quest_subtitle: "&lObtain a &aMagma Cube Fish&r        "
	quest.7DC679EFB369F41F.title: "&lQuest: Obtain &aMagma Cube Fish&r         "
	quest.7DF9BC2C869B6783.quest_desc: [
		""
		"Create sturdy &a&lMossy Oak Planks&r, the signature building material used in Ribbit settlements."
		""
		"Their moss-covered texture gives any structure a natural swamp aesthetic, perfect for recreating Ribbit village homes."
	]
	quest.7DF9BC2C869B6783.quest_subtitle: "&lCraft a set of &a&lMossy Oak Planks&r        "
	quest.7DF9BC2C869B6783.title: "&lQuest: Craft &a&lMossy Oak Planks&r        "
	quest.7EBBDAA834617A0C.quest_desc: [
		""
		"The adorable &l&aDumbo Octopus&r lives in deep oceans and can be collected with a bucket. When a player is drowning, nearby dumbo octopuses will help by giving them a temporary bubble helmet. Cute, friendly, and unexpectedly life saving."
	]
	quest.7EBBDAA834617A0C.quest_subtitle: "&lObserve a &aDumbo Octopus&r &lin deep ocean waters          "
	quest.7EBBDAA834617A0C.title: "             &lQuest: Observe Dumbo Octopus&r                       "
	quest.7EEC84C37D1F6C9F.quest_desc: [
		""
		"Craft the &a&lTurtle Plushie&r honoring the gentle turtles that bask along warm beaches. A lovely plush for ocean-themed builds."
	]
	quest.7EEC84C37D1F6C9F.quest_subtitle: "&lCraft the &aTurtle Plushie&r       "
	quest.7EEC84C37D1F6C9F.title: "&lQuest: Craft &aTurtle Plushie&r        "
	quest.7F311151DD3663E7.quest_desc: [
		""
		"Shroomies are gentle mushroom &a&lcreatures&r that wander quietly through forests and caves."
		"When given a mushroom, a Shroomie will plant it at a nearby spot and may leave it intact, acting like a tiny &b&lgardener&r of the fungal realms."
		""
		"&l&7Bred with: &cWheat"
	]
	quest.7F311151DD3663E7.quest_subtitle: "&lFind a &a&lShroomie&r &lin fungal biomes&r       "
	quest.7F311151DD3663E7.title: "&lQuest: Mystic of the &a&lMushrooms&r        "
	quest.7F3D1CF68696B29F.quest_desc: [
		""
		"Shed scales from reptile-like beings can be gathered and refined into tough, versatile material."
		""
		"Use this skin in recipes for durable gear and specialized armor pieces that echo the resilience of their original owners."
	]
	quest.7F3D1CF68696B29F.quest_subtitle: "&lRecover &a&lReptile Skin&r      "
	quest.7F3D1CF68696B29F.title: "&lQuest: Obtain &a&lReptile Skin&r       "
	quest.7FA15113F652B6E8.quest_desc: [
		""
		"Travel across dry plains and open fields to discover a &a&lBurrowing Owl&r, a small owl that nests in underground burrows instead of trees."
		""
		"Watch its alert stance as it stands guard at the entrance to its home, keeping a close eye on everything nearby."
	]
	quest.7FA15113F652B6E8.quest_subtitle: "&lDiscover &a&lBurrowing Owl&r      "
	quest.7FA15113F652B6E8.title: "&lQuest: Discover a &a&lBurrowing Owl&r         "
	quest.7FA2741D06E952AC.quest_desc: [
		""
		"Assemble the noble &a&lHorse Plushie&r, capturing overworld horses' strength and loyalty. A proud ornament for stables and cottages."
	]
	quest.7FA2741D06E952AC.quest_subtitle: "&lCraft the &aHorse Plushie&r      "
	quest.7FA2741D06E952AC.title: "&lQuest: Craft &aHorse Plushie&r       "
	quest.7FD7E1AF8B46CD7C.quest_desc: [
		""
		"The quirky &a&lToadstool&r sprouts near logs, huts, and other damp spots throughout Ribbit villages."
		""
		"Its whimsical look makes it easy to notice, so collect one of these strange mushrooms while you explore their settlement."
	]
	quest.7FD7E1AF8B46CD7C.quest_subtitle: "&lObtain a &a&lToadstool&r    "
	quest.7FD7E1AF8B46CD7C.title: "&lQuest: Obtain a &a&lToadstool&r       "
