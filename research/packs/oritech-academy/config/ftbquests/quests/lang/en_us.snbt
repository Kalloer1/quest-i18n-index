	task.4FB3B08A74EC802A.title: "Welcome to OriCraft!"
	task.5125182D67C0585E.title: "WHEEEEE!!!!"
	task.522911865D59072C.title: "An Accelerated Grind"
	task.53A59575D546DBBA.title: "The Vernation Acceleration"
	task.5DA0E1696D96C2B9.title: "Torches R Us"
	task.699A5374E6CB2219.title: "What is my purpose?"
