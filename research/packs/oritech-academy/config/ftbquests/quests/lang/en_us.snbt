	quest.265D5F47A0C8C8BA.quest_desc: [
		"&l&zNew in the latest version of Oritech: Add some Color to your machines!&r"
		""
		"By pulverizing certain materials, you can create Machine Paint to spice up your factories. There are 9 different colors to collect, so see which one suits your liking!"
		""
		"&l&o&n&zIt's Colorific!"
	]
	quest.265D5F47A0C8C8BA.quest_subtitle: "Not as bad of a game as you'd think."
