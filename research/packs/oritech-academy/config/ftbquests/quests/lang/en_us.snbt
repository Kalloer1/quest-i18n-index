	quest.270113505196FCAD.title: "20/20"
	quest.27AF1D7484634D54.quest_desc: ["This is the second &bResearch Addon&r you can make. Just bolt it onto the side of your Research Station to unlock the second set of upgrades on the tree."]
	quest.27AF1D7484634D54.quest_subtitle: "Do all the dance moves all at once until observed, and then collapse your waveforms into just one."
