	quest.037B2793E657993F.quest_desc: [
		"&l&aThe Harvester Pylon&r"
		""
		"- &oAutomatically harvests fully grown crops in its range.&r"
		"- &oReplants seeds from the harvested crops.&r"
		"- &oCollects items into a connected storage unit&r"
		""
		"&e&lTo use:&r"
		""
		"1. &oPlace it near your crops inside or above a water block.&r"
		"2. &oInsert a hoe into the pylon&r"
		"3. &oAttach a chest or storage block above the pylon for storing harvested items.&r"
		""
		"&e&lIt's great for automating farms!&r"
	]
