	file.0000000000000001.title: "Artifice \\& Industry"
	quest.009A385FC2456E83.quest_desc: ["Presses are essential for crafting various components needed for your ME (Matter-Energy) system. These Presses are used in the Inscriber, a machine that combines resources to create the key parts of the AE2 network."]
	quest.009A385FC2456E83.quest_subtitle: "Im not that pressed dude."
	quest.009A385FC2456E83.title: "Presses"
	quest.00B9D5A1FA59623B.title: "Back To The Calcination Oven"
	quest.00F72C78CFE63783.quest_desc: [
		"&l&2Alchemy&r &l\\&&r &9&lIndustry&r"
		""
		"Dive into a world where magic and technology intertwine! Alchemy \\&! Industry is a modpack that blends the mystical arts with industrial ingenuity, creating a truly unique Minecraft experience. Build automated factories and intricate machines while mastering alchemical secrets and arcane rituals."
		""
		"&c&oWhether you're crafting complex machinery, brewing powerful potions, or discovering ancient magic, this modpack offers something for every type of player. Explore a vast world full of challenges, mysteries, and hidden treasures, where you can shape your own path to power.&r"
		""
		"&4&lTech and Automation&r: Harness the power of machinery with mods like Create and Immersive Engineering to automate resource gathering, processing, and construction."
		"&4&lMagical Alchemy&r: Unleash your magical potential with Ars Nouveau and other alchemical mods to craft powerful spells, enchantments, and mystical devices."
		"&4&lExploration and Adventure&r: Uncover hidden dungeons, ancient ruins, and rare biomes as you explore a world filled with wonders and dangers."
	]
	quest.00F72C78CFE63783.quest_subtitle: "Information about the pack."
	quest.00F72C78CFE63783.title: "Artifice \\& Industry"
	quest.01AD908F2FC044B6.title: "Gateways To Eternity"
	quest.01F764BECBA941D4.quest_subtitle: "Basic Tier of Wireless Chargers, Go for the advanced ones!"
