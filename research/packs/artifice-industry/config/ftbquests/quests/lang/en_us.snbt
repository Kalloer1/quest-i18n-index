	quest.02287BD46ED83FB4.quest_desc: ["The ME Threshold Export Bus allows for automated item exports in an Applied Energistics 2 network based on predefined quantity thresholds, ensuring optimal inventory management and efficiency."]
	quest.025DF26DB4DD9A40.title: "Summon Devil Familiar"
