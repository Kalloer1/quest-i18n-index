		"&l&eWither:&r +2x Power Capacity +2x Recharge Rate"
		"&l&ePlayer:&r +2.5x Power Capacity +3x Recharge Rate"
	]
	quest.675F71E18D73A7F4.title: "Skull Upgrades"
	quest.677F3E920C04816E.quest_desc: ["Fluix Cable efficiently transfers energy and data in AE2 networks, ensuring reliable performance with its advanced design and vibrant blue color."]
	quest.67B3E706FB69AC78.quest_desc: [
		"&lPlease be patient as we continue developing this beta modpack. &r"
		""
		"&e&oThere may be bugs or unfinished features. &r"
		""
