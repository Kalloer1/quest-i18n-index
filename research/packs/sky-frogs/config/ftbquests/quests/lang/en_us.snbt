	chapter.70DD000000000001.title: "Sister Ponds"
	quest.7CA7E000C0DE0026.quest_desc: ["Craft a &bBreeze Rod Slime in a Bucket&r, feed your &aCave Frog&r, and turn in the &6Breeze Rod Froglight&r."]
	quest.7CA7E000C0DE0026.quest_subtitle: "Catch the wind."
	quest.7CA7E000C0DE0026.title: "Breeze Rod"
	quest.7D00000000000029.quest_desc: ["Craft a &bTurtle Scute Slime in a Bucket&r in a Dissolution Chamber, feed your &aTide Frog&r, and turn in the &6Turtle Scute Froglight&r."]
	quest.7D00000000000029.quest_subtitle: "Shell, expedited."
	quest.7D00000000000029.title: "Turtle Scute"
	quest.51F000000000001E.quest_desc: ["Craft a &bGhast Tear Slime in a Bucket&r in a Dissolution Chamber, feed your &aInfernal Frog&r, and turn in the &6Ghast Tear Froglight&r."]
	quest.51F000000000001E.quest_subtitle: "No tissue required."
	quest.51F000000000001E.title: "Ghast Tear"
	quest.60F0000000000014.quest_desc: ["Craft a &bPhantom Membrane Slime in a Bucket&r in a Dissolution Chamber, feed your &aVoid Frog&r, and turn in the &6Phantom Membrane Froglight&r."]
	quest.60F0000000000014.quest_subtitle: "Sleep well anyway."
	quest.60F0000000000014.title: "Phantom Membrane"
	quest.7B06000000000022.quest_desc: ["Craft an &bArmadillo Scute Slime in a Bucket&r, feed your &aBog Frog&r, and turn in the &6Armadillo Scute Froglight&r."]
	quest.7B06000000000022.quest_subtitle: "Roll with it."
	quest.7B06000000000022.title: "Armadillo Scute"
	quest.7B06000000000025.quest_desc: ["Craft a &bHoneycomb Slime in a Bucket&r, feed your &aBog Frog&r, and turn in the &6Honeycomb Froglight&r."]
	quest.7B06000000000025.quest_subtitle: "Unbeelievable."
	quest.7B06000000000025.title: "Honeycomb"
	quest.7B06000000000043.quest_desc: [
		"No bee turns up on its own here, but the vanilla route works. Sift &fdirt&r or &fmoss&r for a &fbirch sapling&r and a &fdandelion&r."
		""
		"Plant them within two blocks of each other, same height, and grow the tree. Any flower does the job. Small chance per tree it comes up with a &ebee nest&r on it, bees included. Plant plenty."
		""
		"&bSilk Touch&r the nest or the bees stay behind. Then it is normal beekeeping: flowers to breed, a bottle for &6honey&r, four for a honey block."
	]
	quest.7B06000000000043.quest_subtitle: "Not a frog, but useful."
	quest.7B06000000000043.title: "Bees"
	quest.7B06000000000028.quest_desc: ["Craft a &bBone Slime in a Bucket&r, feed your &aBog Frog&r, and turn in the &6Bone Froglight&r."]
	quest.7B06000000000028.quest_subtitle: "Dem dry bones."
	quest.7B06000000000028.title: "Bone"
	quest.7B0600000000002B.quest_desc: ["Craft a &bGunpowder Slime in a Bucket&r, feed your &aBog Frog&r, and turn in the &6Gunpowder Froglight&r."]
	quest.7B0600000000002B.quest_subtitle: "Boom, sorted."
	quest.7B0600000000002B.title: "Gunpowder"
	quest.7B0600000000002E.quest_desc: ["Craft a &bRotten Flesh Slime in a Bucket&r, feed your &aBog Frog&r, and turn in the &6Rotten Flesh Froglight&r."]
	quest.7B0600000000002E.quest_subtitle: "It's a living."
	quest.7B0600000000002E.title: "Rotten Flesh"
	quest.7B06000000000031.quest_desc: ["Craft a &bString Slime in a Bucket&r, feed your &aBog Frog&r, and turn in the &6String Froglight&r."]
	quest.7B06000000000031.quest_subtitle: "No strings attached."
	quest.7B06000000000031.title: "String"
	quest.51F0000000000021.quest_desc: ["Craft a &bMagma Cream Slime in a Bucket&r in a Dissolution Chamber, feed your &aInfernal Frog&r, and turn in the &6Magma Cream Froglight&r."]
	quest.51F0000000000021.quest_subtitle: "Slippery when hot."
	quest.51F0000000000021.title: "Magma Cream"
	quest.51F0000000000024.quest_desc: [
		"Brew a &dsplash&r or &dlingering potion&r and throw it at a slime before its frog eats it. The &6Froglight&r that drops carries the potion's effect. Place it and right-click to switch the aura on: everything in range gets the effect. Hold it in your hand instead and the buff is yours alone."
		""
		"This one's on the honor system, so check it off once you've made your first brewed Froglight."
	]
	quest.51F0000000000024.quest_subtitle: "The frog sommelier."
	quest.51F0000000000024.title: "Pop the Cork"
	quest.51F0000000000027.quest_desc: [
		"With &dCurios&r installed, a brewed &6Froglight&r goes in its own &dFroglight slot&r and buffs you the whole time it's worn: the same personal effect as holding one, without tying up a hand or a hotbar slot."
		""
		"Honor system again, so check it off once you're wearing one."
	]
	quest.51F0000000000027.quest_subtitle: "Wearable weather."
	quest.51F0000000000027.title: "Charmed, I'm Sure"
	quest.7807000000000029.quest_desc: [
		"Every farm in this chapter runs on &5boss Slime Milk&r, and it is toxic. Stand in a boss milk pool and it hits you with &cWither&r. The slimes and frogs that live in it are fine; you are not."
		""
		"You make it safe by sealing it. Each boss source needs a &ecatalyst block&r crafted from that boss's own drop set against all six of its faces. Sealed, it spawns slimes on its own and cannot reach you. Until the sixth face is covered it will not run and it will still hurt you, so keep your distance."
	]
	quest.7807000000000029.quest_subtitle: "The pond bites back."
	quest.7807000000000029.title: "Do Not Touch the Milk"
	quest.7807000000000002.quest_desc: [
		"&fWither skeletons&r drop skulls, rarely, at a &cNether fortress&r. You need seven: one to turn in, six for catalysts."
		""
		"&fEight soul sand&r around a skull makes one &eWither Skeleton Skull Catalyst&r. Craft six, place a &5Skull Slime Milk&r source, and seal a catalyst against each of its six faces."
	]
	quest.7807000000000002.quest_subtitle: "Heads will roll."
	quest.7807000000000002.title: "Skull Harvest"
	quest.7807000000000005.quest_desc: [
		"Sealed in its six catalysts, the Skull Slime Milk source spawns Skull Slimes safely for your frogs to eat."
		""
		"Turn in the &6Wither Skeleton Skull Froglight&r."
	]
	quest.7807000000000005.quest_subtitle: "The bone orchard."
	quest.7807000000000005.title: "Wither Skeleton Skull"
	quest.7807000000000008.quest_desc: [
		"Summon the &5Wither&r the vanilla way: &f4 soul sand&r and &f3 wither skeleton skulls&r. Each kill drops one &fNether Star&r. Do it somewhere you do not mind blowing up."
		""
		"You need seven stars: one to turn in, six for catalysts. &fEight obsidian&r around a star makes one &eNether Star Catalyst&r."
	]
	quest.7807000000000008.quest_subtitle: "You built this fight from scratch. Six times."
	quest.7807000000000008.title: "The Withering"
	quest.780700000000000B.quest_desc: [
		"Sealed in its six obsidian catalysts, the Nether Star Slime Milk source spawns Star Slimes for your frogs."
		""
		"Turn in the &6Nether Star Froglight&r."
	]
	quest.780700000000000B.quest_subtitle: "Beacons, plural."
	quest.780700000000000B.title: "Nether Star"
	quest.780700000000000E.quest_desc: [
		"Vanilla drops one &dDragon Egg&r per world. This pack makes every respawned dragon drop another. Set &f4 End Crystals&r around the End exit portal to bring her back; each kill leaves an egg."
		""
		"You need seven: one to turn in, six for catalysts. &fEight end stone bricks&r around an egg makes one &eDragon Egg Catalyst&r."
	]
	quest.780700000000000E.quest_subtitle: "One per customer - repealed."
	quest.780700000000000E.title: "A Clutch of Eggs"
	quest.7807000000000011.quest_desc: [
		"Sealed in its six catalysts, the Egg Slime Milk source spawns Egg Slimes for your frogs."
		""
		"Turn in the &6Dragon Egg Froglight&r."
	]
	quest.7807000000000011.quest_subtitle: "From one egg, a clutch."
	quest.7807000000000011.title: "Dragon Egg"
	quest.7807000000000014.quest_desc: [
		"Scoop the dragon's purple breath cloud with an empty &dglass bottle&r to get &dDragon's Breath&r. You are respawning dragons anyway, so bring bottles."
		""
		"You need seven: one to turn in, six for catalysts. &fEight purpur blocks&r around a bottle of breath makes one &eDragon Breath Catalyst&r."
	]
	quest.7807000000000014.quest_subtitle: "CPR for dragons."
	quest.7807000000000014.title: "Breath of Fresh End"
	quest.7807000000000017.quest_desc: [
		"Sealed in its six catalysts, the Dragon Breath Slime Milk source spawns Breath Slimes for your frogs."
		""
		"Turn in the &6Dragon Breath Froglight&r."
	]
	quest.7807000000000017.quest_subtitle: "Industrial-scale exhalation."
	quest.7807000000000017.title: "Dragon Breath"
	quest.780700000000001A.quest_desc: [
		"A sword that drops a Resource Slime's &6Froglight&r when it lands the killing blow, brewed effect and all, exactly as if a frog had eaten it. The active-play alternative to the passive pond."
		""
		"Craft it from two &6Nether Star Froglights&r, one &6Dragon Egg Froglight&r, and &dDragon's Breath&r."
	]
	quest.780700000000001A.quest_subtitle: "Harvest the light by hand."
	quest.780700000000001A.title: "The Froglight Cleaver"
	quest.780700000000002C.quest_desc: [
		"A contained, repeatable dragon farm, built right on the real End exit portal, so you have to beat the dragon the hard way first. Her &bDragon Egg&r is the capstone: no egg, no altar."
		""
		"Ring the portal with four &eEnd Crystal Receptacles&r and reinforced froglights, with the &eEnd Dragon Altar Hatch&r at the centre and the egg resting on top. Drop an &fEnd Crystal&r into each of the four receptacles and a replica dragon rises for the &eDragonsbane&r frog to devour. The loot lands in the hatch, hopper-pipeable, and the real portal stays intact: a &6Dragon Breath Froglight&r, a &6Dragon Egg Froglight&r, the &dPrincess's Kiss&r, and XP."
		""
		"Build it from the &fProductive Frogs field guide&r, not from this page. Its altar entry has the diagram and projects the whole thing into the world before you place a block."
		""
		"&7Optional&r: a repeatable dragon harvest. Craft the &eEnd Dragon Altar Hatch&r to start."
	]
	quest.780700000000002C.quest_subtitle: "A dragon on tap."
	quest.780700000000002C.title: "The End Dragon Altar"
	quest.780700000000002F.quest_desc: [
		"A contained, repeatable Wither farm. You still have to kill a Wither the hard way once: the &eWithered Star&r capstone is crafted from a &fNether Star&r."
		""
		"Build the arena from &6Reinforced Blaze Rod Froglights&r for the shell and &6Reinforced Soul Sand Froglights&r for the floor, with a &eWither Altar Hatch&r at the centre and the &eWitherbane&r frog perched on it. Its ritual wall takes four Soul Sand Receptacles and three Wither Skull Receptacles; load the full vanilla summon each time, &f4 soul sand&r and &f3 wither skeleton skulls&r. A replica Wither charges in and Witherbane eats it before it can act. Each summon drops a &6Nether Star Froglight&r (it smelts back to a star) plus XP, with no boss bar and no block damage."
		""
		"Build it from the &fProductive Frogs field guide&r, not from this page. Its altar entry has the diagram and projects the whole thing into the world before you place a block."
		""
		"&7Optional&r: a hands-off Nether Star farm. Craft the &eWithered Star&r to start."
	]
	quest.780700000000002F.quest_subtitle: "A Wither farm, fully contained."
	quest.780700000000002F.title: "The Wither Altar"
	chapter.7807000000000001.title: "Trophy Pond"
	quest.7CA7E000C0DE0002.quest_desc: [
		"You've pulled iron out of a frog. The same Cave Frog gives the rest: copper, gold, coal, glow ink, breeze rods, and redstone."
		""
		"Each is a quest below. Work down the chain in order: every slime bucket is crafted from the milk of the step before it."
	]
	quest.7CA7E000C0DE0002.quest_subtitle: "The Cave chain opens."
	quest.7CA7E000C0DE0002.title: "Beyond Iron"
	quest.7CA7E000C0DE0005.quest_desc: [
		"Craft a &bCopper Slime in a Bucket&r from your &eiron milk&r (plus four stone, three sweetslime, and a bottle of Cave Frog Eggs)."
		""
		"Milk it, feed the slimes to a Cave Frog, and turn in the &6Copper Froglight&r. Smelt it for a copper ingot."
	]
	quest.7CA7E000C0DE0005.quest_subtitle: "The first new metal."
	quest.7CA7E000C0DE0005.title: "Copper"
	quest.7CA7E000C0DE0008.quest_desc: ["Craft a &bGold Slime in a Bucket&r, feed your &aCave Frog&r, and turn in the &6Gold Froglight&r."]
	quest.7CA7E000C0DE0008.quest_subtitle: "Shiny, soft, useful."
	quest.7CA7E000C0DE0008.title: "Gold"
	quest.7CA7E000C0DE000B.quest_desc: ["Craft a &bCoal Slime in a Bucket&r, feed your &aCave Frog&r, and turn in the &6Coal Froglight&r."]
	quest.7CA7E000C0DE000B.quest_subtitle: "Fuel, no ore in sight."
	quest.7CA7E000C0DE000B.title: "Coal"
	quest.7CA7E000C0DE000E.quest_desc: ["Craft a &bRedstone Slime in a Bucket&r, feed your &aCave Frog&r, and turn in the &6Redstone Froglight&r."]
	quest.7CA7E000C0DE000E.quest_subtitle: "The spark under everything."
	quest.7CA7E000C0DE000E.title: "Redstone"
	quest.7CA7E000C0DE0023.quest_desc: ["Craft a &bGlow Ink Sac Slime in a Bucket&r, feed your &aCave Frog&r, and turn in the &6Glow Ink Sac Froglight&r."]
	quest.7CA7E000C0DE0023.quest_subtitle: "Glow without the squid."
	quest.7CA7E000C0DE0023.title: "Glow Ink"
	quest.7CA7E000C0DE0020.quest_desc: ["A &eMob Filter&r is a solid block to everything but one kind of thing. The &ePlayer&r filter only lets &fyou&r through, so you can seal a frog pen and still walk in without leaving a gap the frogs can escape through."]
	quest.7CA7E000C0DE0020.quest_subtitle: "A wall just for you."
	quest.7CA7E000C0DE0020.title: "Players Only"
	quest.7CA7E000C0DE0029.quest_desc: ["A &eMob Filter (Slime)&r is solid to you and your frogs, but slimes pass straight through it. Build it into your slime farm and it sorts for you: the slimes pass to wherever you collect them, and nothing else does."]
	quest.7CA7E000C0DE0029.quest_subtitle: "Only slimes get through."
	quest.7CA7E000C0DE0029.title: "Slimes Only"
	quest.7D00000000000002.quest_desc: [
		"You've got &bprismarine&r. Every other Tide resource runs the same loop: chamber the slime, milk it, feed a &eTide Frog&r, then smelt the &6Froglight&r it drops."
		""
		"Eight more below to finish the aquatic set."
	]
	quest.7D00000000000002.quest_subtitle: "The Tide chain opens."
	quest.7D00000000000002.title: "Drowned Riches"
	quest.7D00000000000005.quest_desc: ["Craft a &bPrismarine Crystals Slime in a Bucket&r in a Dissolution Chamber, feed your &aTide Frog&r, and turn in the &6Prismarine Crystals Froglight&r."]
	quest.7D00000000000005.quest_subtitle: "The sea glows."
	quest.7D00000000000005.title: "Prismarine Crystals"
	quest.7D00000000000008.quest_desc: ["Craft a &bSponge Slime in a Bucket&r in a Dissolution Chamber, feed your &aTide Frog&r, and turn in the &6Sponge Froglight&r."]
	quest.7D00000000000008.quest_subtitle: "Thirsty block."
	quest.7D00000000000008.title: "Sponge"
	quest.7D0000000000000B.quest_desc: ["Craft an &bInk Sac Slime in a Bucket&r in a Dissolution Chamber, feed your &aTide Frog&r, and turn in the &6Ink Sac Froglight&r."]
	quest.7D0000000000000B.quest_subtitle: "Squid, without the squid."
	quest.7D0000000000000B.title: "Ink Sac"
	quest.7D0000000000000E.quest_desc: ["Craft a &bSea Pickle Slime in a Bucket&r in a Dissolution Chamber, feed your &aTide Frog&r, and turn in the &6Sea Pickle Froglight&r."]
	quest.7D0000000000000E.quest_subtitle: "Glowing and green."
	quest.7D0000000000000E.title: "Sea Pickle"
	quest.7D00000000000011.quest_desc: ["Craft a &bNautilus Shell Slime in a Bucket&r in a Dissolution Chamber, feed your &aTide Frog&r, and turn in the &6Nautilus Shell Froglight&r."]
	quest.7D00000000000011.quest_subtitle: "The Tide's treasure."
	quest.7D00000000000011.title: "Nautilus Shell"
	quest.7D00000000000020.quest_desc: ["Craft an &bIce Slime in a Bucket&r in a Dissolution Chamber, feed your &aTide Frog&r, and turn in the &6Ice Froglight&r."]
	quest.7D00000000000020.quest_subtitle: "Winter, imported."
	quest.7D00000000000020.title: "Ice"
	quest.7D00000000000023.quest_desc: ["Craft a &bSnow Slime in a Bucket&r in a Dissolution Chamber, feed your &aTide Frog&r, and turn in the &6Snow Froglight&r."]
	quest.7D00000000000023.quest_subtitle: "Let it frog."
	quest.7D00000000000023.title: "Snow"
	quest.7F00000000000002.quest_desc: ["&eIron Jetpacks&r builds from metals your frogs already make and runs on the &bRF&r your Geode machines spin, so there's no new resource to farm."]
	quest.7F00000000000002.quest_subtitle: "Leave the ground behind."
	quest.7F00000000000002.title: "Take Flight"
	quest.7F00000000000005.quest_desc: ["Start with a &eLeather Strap&r: &fleather&r from your Bog frog, &firon nuggets&r from your Cave one. Only the first jetpack uses one."]
	quest.7F00000000000005.quest_subtitle: "The jetpack's harness."
	quest.7F00000000000005.title: "Leather Strap"
	quest.7F00000000000008.quest_desc: ["A coil goes into a &eCell&r, and cells build the thrusters and capacitor. Which coil depends on the jetpack: &eBasic&r covers the wood and stone ones. Iron takes the &eAdvanced Coil&r."]
	quest.7F00000000000008.quest_subtitle: "The first engine."
	quest.7F00000000000008.title: "Basic Coil"
	quest.7F0000000000000B.quest_desc: [
		"Only the &ewood&r jetpack is crafted from scratch, built around the &eLeather Strap&r. After that you upgrade in place: your current jetpack in the middle, the new tier's parts around it. Wood to stone, stone to iron. Iron cells take the &eAdvanced Coil&r, so make one in gold first."
		""
		"Wear it in a &eCurios&r back slot, or straight over your chestplate."
	]
	quest.7F0000000000000B.quest_subtitle: "Your first jetpack."
	quest.7F0000000000000B.title: "Off the Ground"
	quest.7F0000000000000E.quest_desc: [
		"The jetpack needs charge. Top it off from any &bForge Energy&r source - a &eMekanism&r energy cube, or a cable off your Geode setup - then hold jump to lift off. Tap hover to hang in place."
		""
		"&aClaim this once you've flown.&r"
	]
	quest.7F0000000000000E.quest_subtitle: "Charge it, then soar."
	quest.7F0000000000000E.title: "Fuel and Fly"
	quest.7F00000000000011.quest_desc: ["&fGold&r instead of iron. Your iron jetpack's cells already took one of these, and so does the &egold&r jetpack above it. Gold comes off your Cave frog."]
	quest.7F00000000000011.quest_subtitle: "Higher, faster."
	quest.7F00000000000011.title: "Advanced Coil"
	quest.7F00000000000014.quest_desc: ["An &eElite Coil&r runs on &fdiamond&r: higher still, and easier on fuel."]
	quest.7F00000000000014.quest_subtitle: "Most of the sky."
	quest.7F00000000000014.title: "Elite Coil"
	quest.7F00000000000017.quest_desc: ["The &eUltimate Coil&r caps the line with &femerald&r from your Geode frog - the fastest jetpack in the pack."]
	quest.7F00000000000017.quest_subtitle: "The whole sky."
	quest.7F00000000000017.title: "Ultimate Coil"
	quest.7F0000000000001A.quest_desc: ["No trial chambers generate over the void, so the &bHeavy Core&r comes from the press instead. The &eDissolution Chamber&r squeezes one out of &f4 iron blocks&r and &f4 prismarine&r under latex."]
	quest.7F0000000000001A.quest_subtitle: "Vault treasure, frog-pressed."
	quest.7F0000000000001A.title: "The Heavy Core"
	quest.7F0000000000001D.quest_desc: ["Add a &bBreeze Rod&r to the core for the &bMace&r. Its smash damage scales with how far you fall - and you just built a jetpack, so climb, cut thrust, and land the hit from height. One breeze rod also crafts into &f4 wind charges&r to bounce yourself back up mid-fight."]
	quest.7F0000000000001D.quest_subtitle: "What goes up..."
	quest.7F0000000000001D.title: "Drop the Hammer"
	task.2A5700000A570003.title: "Got it"
	task.2A5700000A570023.title: "Breed two frogs with Sweetslime"
	task.570A6E0000000015.title: "Storage, sorted"
	task.65F6A1B2C3D40002.title: "Got it"
	task.6C1F0A2B3D4E5F62.title: "Build an enclosed habitat"
	task.7CA7E000C0DE0003.title: "Got it"
	chapter_group.0C4F0E0000000005.title: "Tier 5: Infernal"
	chapter.5140000000000001.title: "Road to Infernal"
	chapter.51F0000000000001.title: "Infernal Frogs"
	quest.3E17000000000002.quest_desc: [
		"The &eFroglight Crucible&r is a &fbrick-and-iron basin&r that melts &6Froglights&r into &9fluids&r - water, lava, molten metal. It runs on heat from the block underneath it: no power, no GUI."
		""
		"Craft the &eCrucible&r and set it over a &etorch&r to start."
	]
	quest.3E17000000000002.quest_subtitle: "Soup's on."
	quest.3E17000000000002.title: "The Froglight Crucible"
	quest.3E17000000000005.quest_desc: [
		"Heat comes from the block under the Crucible, and hotter melts faster. Coldest to hottest: &etorch&r, &6campfire&r, &6lava&r, &cfire&r."
		""
		"Some Froglights work as heat sources too: a &6Lava Froglight&r is as hot as lava, a &6Blaze Froglight&r is hotter than fire, and (with Powah) a &6Blazing Crystal Froglight&r is the hottest. JEI's &eCrucible Heat Sources&r page lists them all."
		""
		"Craft a &6campfire&r."
	]
	quest.3E17000000000005.quest_subtitle: "Hotter is faster."
	quest.3E17000000000005.title: "Feed the Fire"
	quest.3E17000000000008.quest_desc: ["A &6Water Froglight&r melts into a &9bucket of water&r using the &eCrucible&r."]
	quest.3E17000000000008.quest_subtitle: "The ocean, bottled."
	quest.3E17000000000008.title: "Water"
	quest.3E1700000000000B.quest_desc: ["A &6Lava Froglight&r melts into a &6bucket of lava&r using the &eCrucible&r."]
	quest.3E1700000000000B.quest_subtitle: "The floor is renewable."
	quest.3E1700000000000B.title: "Lava"
	quest.3E1700000000000E.quest_desc: [
		"The &eCasting Mold&r turns molten metal into &fingots&r. Stack it on the Crucible - &cheat&r, &eCrucible&r, &eMold&r in a column - and it pulls straight from the basin below. Or feed it by pipe."
		""
		"{image:kubejs:textures/quests/casting_tower.png width:220 height:181 align:center}"
		""
		"Craft a &eCasting Mold&r."
	]
	quest.3E1700000000000E.quest_subtitle: "Pour one out."
	quest.3E1700000000000E.title: "The Casting Mold"
	quest.3E17000000000011.quest_desc: [
		"A metal &6Froglight&r melts into &etwo ingots&r worth of molten metal - the Crucible is this pack's ore doubling. Build the tower, hopper Froglights in, and it runs hands-free."
		""
		"Tick when your tower casts its first doubled ingot."
	]
	quest.3E17000000000011.quest_subtitle: "Two for one."
	quest.3E17000000000011.title: "The Tower"
	quest.51F0000000000002.quest_desc: ["The &cInfernal frog&r covers the whole Nether now: obsidian, quartz, glowstone, blaze rods, and netherite scrap at the bottom of the chain. Same loop as every tier before, one resource at a time down the list."]
	quest.51F0000000000002.quest_subtitle: "The Nether chain opens."
	quest.51F0000000000002.title: "Beyond Netherrack"
	quest.51F0000000000005.quest_desc: ["Craft a &bQuartz Slime in a Bucket&r in a Dissolution Chamber, feed your &aInfernal Frog&r, and turn in the &6Quartz Froglight&r."]
	quest.51F0000000000005.quest_subtitle: "The gate so many recipes wanted."
	quest.51F0000000000005.title: "Quartz"
	quest.51F0000000000008.quest_desc: ["Craft a &bGlowstone Slime in a Bucket&r in a Dissolution Chamber, feed your &aInfernal Frog&r, and turn in the &6Glowstone Froglight&r."]
	quest.51F0000000000008.quest_subtitle: "Light that isn't a torch."
	quest.51F0000000000008.title: "Glowstone"
	quest.51F000000000000B.quest_desc: ["Craft a &bSoul Sand Slime in a Bucket&r in a Dissolution Chamber, feed your &aInfernal Frog&r, and turn in the &6Soul Sand Froglight&r."]
	quest.51F000000000000B.quest_subtitle: "It drags you down."
	quest.51F000000000000B.title: "Soul Sand"
	quest.51F000000000000E.quest_desc: ["Craft a &bSoul Soil Slime in a Bucket&r in a Dissolution Chamber, feed your &aInfernal Frog&r, and turn in the &6Soul Soil Froglight&r."]
	quest.51F000000000000E.quest_subtitle: "Blue fire country."
	quest.51F000000000000E.title: "Soul Soil"
	quest.51F0000000000011.quest_desc: ["Craft a &bBlaze Slime in a Bucket&r in a Dissolution Chamber, feed your &aInfernal Frog&r, and turn in the &6Blaze Froglight&r."]
	quest.51F0000000000011.quest_subtitle: "Rods without the blaze."
	quest.51F0000000000011.title: "Blaze"
	quest.51F0000000000014.quest_desc: ["Craft a &bNetherite Scrap Slime in a Bucket&r in a Dissolution Chamber, feed your &aInfernal Frog&r, and turn in the &6Netherite Scrap Froglight&r."]
	quest.51F0000000000014.quest_subtitle: "The metal at the bottom."
	quest.51F0000000000014.title: "Netherite Scrap"
	quest.51F0000000000017.quest_desc: [
		"The &eDissolution Chamber&r presses an &8Obsidian Slime&r from &cnetherrack&r (plus prismarine filler, sweetslime, and latex)."
		""
		"Like Tide, Infernal has no crafting-table chain, so the chamber is the only way to make these slimes. Feed it to your Infernal frog and turn in the &6Obsidian Froglight&r."
	]
	quest.51F0000000000017.quest_subtitle: "The portal stone, on tap."
	quest.51F0000000000017.title: "Obsidian"
	chapter.52E0000000000001.title: "The Network"
	quest.52E0000000000002.quest_desc: ["Most &eRefined Storage&r parts are built from &bQuartz Enriched Iron&r: iron plus nether quartz. Quartz comes from your Infernal frog, so none of the network was buildable until this tier."]
	quest.52E0000000000002.quest_subtitle: "The key the whole network turns on."
	quest.52E0000000000002.title: "Quartz Enriched Iron"
	quest.52E0000000000005.quest_desc: ["The &eController&r runs the network. Feed it &bForge Energy&r from your Geode-era Mekanism setup; nothing else works until it has power."]
	quest.52E0000000000005.quest_subtitle: "The heart that powers it."
	quest.52E0000000000005.title: "The Controller"
	quest.52E0000000000008.quest_desc: ["The &eGrid&r is the network terminal: one screen to search your whole system and pull out any item in it."]
	quest.52E0000000000008.quest_subtitle: "Your window into everything."
	quest.52E0000000000008.title: "The Grid"
	quest.52E000000000000B.quest_desc: [
		"A &eDisk Drive&r full of &bStorage Disks&r is the network's memory. Start with a 1k disk; swap in 4k, 16k, then 64k as you outgrow them."
	]
	quest.52E000000000000B.quest_subtitle: "Where it all lives."
	quest.52E000000000000B.title: "Disk Drive"
	quest.52E000000000000F.quest_desc: [
		"&eCable&r carries the network signal. Run it between the Controller, Grid, Disk Drive, and everything else."
	]
	quest.52E000000000000F.quest_subtitle: "Cables tie the network together."
	quest.52E000000000000F.title: "Wire It Up"
	quest.52E0000000000012.quest_desc: [
		"&eExternal Storage&r exposes a drawer, barrel, or chest to the network - your old Functional Storage wall becomes searchable."
	]
	quest.52E0000000000012.quest_subtitle: "Plug in the drawer wall."
	quest.52E0000000000012.title: "External Storage"
	quest.52E0000000000015.quest_desc: [
		"An &eImporter&r pulls items into the network; an &eExporter&r pushes them out. Wire a frog loop straight into storage."
	]
	quest.52E0000000000015.quest_subtitle: "Let it stock itself."
	quest.52E0000000000015.title: "Import and Export"
	quest.52E0000000000019.quest_desc: [
		"The &eCrafting Grid&r is a crafting table wired to the network - no hauling materials, it pulls them for you."
	]
	quest.52E0000000000019.quest_subtitle: "Craft straight from storage."
	quest.52E0000000000019.title: "Crafting Grid"
	quest.52E000000000001C.quest_desc: ["A &ePattern Grid&r records a recipe; an &eAutocrafter&r holds the patterns and crafts on demand. Request an item and the network builds the whole tree for you, sub-recipes and all."]
	quest.52E000000000001C.quest_subtitle: "Ask, and it builds."
	quest.52E000000000001C.title: "Autocrafting"
	quest.53A0000000000002.quest_desc: [
		"The &eTerrarium&r is a sealed multiblock that runs the whole frog loop on its own: &bSlime Milk&r pipes in, ceiling &eSprinklers&r rain slimes, frogs eat them, and &6Froglights&r collect in a hatch. No priming slimes, placing milk, or catching frogs by hand."
		""
		"Its parts are Infernal-tier materials and basics you already have by now."
	]
	quest.53A0000000000002.quest_subtitle: "Frog farming, sealed and self-running."
	quest.53A0000000000002.title: "The Terrarium"
	quest.53A0000000000005.quest_desc: [
		"The &eController&r is the brain. Pipe or hand-pour &bSlime Milk&r into its outward face and it rations that milk to the ceiling &eSprinklers&r. It won't take &cboss Slime Milk&r, so wither and dragon milk stay on their catalyst altars."
		""
		"Set it into a flat wall face (not a corner or edge), facing &eOUT&r of the box, placed from outside with the front toward you. Any non-edge spot on a flat face works; it isn't pinned to the height the guide diagram shows. Walls can be &aany solid block&r."
	]
	quest.53A0000000000005.quest_subtitle: "The brain of the box."
	quest.53A0000000000005.title: "Terrarium Controller"
	quest.53A0000000000008.quest_desc: [
		"&eSprinklers&r line the ceiling and rain slimes into the box. They spawn on the same rules as a placed &bSlime Milk&r source: cadence, per-bucket budget, and &dcatalysts&r (Rapid, Teeming, Bountiful, Endless) all carry through from the milk. One works; up to 25 fit a 5x5 ceiling, and more means faster rain."
		""
		"Drop a catalyst on a Sprinkler from above to upgrade it in place. Right-click one with an &eempty bucket&r to pull its Slime Milk back out and swap variants."
		""
		"&7Redstone:&r a Sprinkler pauses while it's powered - held milk and remaining spawns freeze until the signal drops. Each is wired on its own, so you can flip a lever to pause a box by hand, or run a comparator off a full chest to throttle output when storage backs up."
	]
	quest.53A0000000000008.quest_subtitle: "Indoor weather, made of slime."
	quest.53A0000000000008.title: "Sprinklers"
	quest.53A000000000000B.quest_desc: [
		"&eIncubators&r raise &dbottled frog eggs&r into frogs &ainside the box&r, stats kept over the whole lifecycle. Frogs bred in the cavity lay back into an Incubator instead of seeking water, so the line restocks itself. Right-click one with a &dSweetslime&r to speed it up."
		""
		"Each Incubator raises &eone frog at a time&r and stops releasing at the frog cap (8 by default), so run &eseveral&r for throughput. That cap is only the release ceiling, not a limit on the cavity: you can still lead, net, or carry extra frogs in by hand."
		""
		"Incubators are &eoptional&r; the box forms with none. Add them only to breed frogs in place, otherwise stock the Terrarium yourself. Each goes on a wall face, pointing &eOUT&r, placed from outside."
	]
	quest.53A000000000000B.quest_subtitle: "A nursery with the lights on."
	quest.53A000000000000B.title: "Incubators"
	quest.53A000000000000E.quest_desc: [
		"The &eHatch&r is the output. &6Froglights&r drop straight into it, with no item entities loose in the cavity, and it also vacuums up any stray slimeballs, magma cream, or raw frog legs (from a frog that died inside). It opens like a chest and pipes out its outward face. When it fills, the frogs stop eating until you clear it; nothing is ever voided."
		""
		"Exactly one, on a wall face pointing &eOUT&r, placed from outside."
	]
	quest.53A000000000000E.quest_subtitle: "Where the light comes out."
	quest.53A000000000000E.title: "The Terrarium Hatch"
	quest.53A0000000000011.quest_desc: [
		"Wrap the cavity in a one-block shell of &aany solid block&r. The interior is &e5 wide, 5 deep, 4 tall&r. The &eController&r and &eHatch&r sit on wall faces pointing OUT (placed from outside), any &eIncubators&r face OUT too, and the &eSprinklers&r line the ceiling. No machine on a corner or edge; flat faces only."
		""
		"&7Right-click the Controller&r: it reports whether the box is formed and points at the first wrong block until it reads &aformed&r. Build to whatever it asks for."
	]
	quest.53A0000000000011.quest_subtitle: "Five by five by four, shell it in."
	quest.53A0000000000011.title: "Seal the Box"
	quest.53A0000000000014.quest_desc: ["Pipe or pour a bucket of &bSlime Milk&r into the &eController's&r outward face. It buffers one variant at a time and feeds the &eSprinklers&r, which start raining that variant's slimes. Wire it to your milk farm and the rain never stops."]
	quest.53A0000000000014.quest_subtitle: "Turn on the rain."
	quest.53A0000000000014.title: "Prime the Sprinklers"
	quest.53A0000000000017.quest_desc: ["Get a frog living inside. Load a &dbottled frog egg&r into an &eIncubator&r to raise one in place, or lead or &enet&r a caught frog in directly. It eats the slimes the Sprinklers drop, and its &6Froglights&r land in the &eHatch&r. Whatever species lives in there is the resource that farms itself."]
	quest.53A0000000000017.quest_subtitle: "Move the frogs in."
	quest.53A0000000000017.title: "Stock the Incubators"
	quest.53A000000000001A.quest_desc: ["Milk in one wall, &6Froglights&r out the other, and frogs and slimes you never touch again. The &eTerrarium&r runs the whole loop you spent six tiers doing by hand. Wire the Hatch into storage and walk away."]
	quest.53A000000000001A.quest_subtitle: "Hands off. It runs itself."
	quest.53A000000000001A.title: "Hands Off"
	chapter.53A0000000000001.title: "The Terrarium"
	quest.5140000000000002.quest_desc: ["Build a nether portal to get there: frame it with 10 &eobsidian&r (the four corners are optional) and light it with a &eflint and steel&r."]
	quest.5140000000000002.quest_subtitle: "Tide gave you wings. Now use them."
	quest.5140000000000002.title: "A Portal to the Nether"
	quest.5140000000000007.quest_desc: ["Step through. This Nether is a &cvoid&r: open air with no ground under it. Wear your jetpack before you walk in, or you will fall with nothing to land on."]
	quest.5140000000000007.quest_subtitle: "Step through."
	quest.5140000000000007.title: "Into the Nether"
	quest.514000000000000A.quest_desc: ["A &cNether Fortress&r floats somewhere out in the void. Fly to it and mine its &eNether Bricks&r - they prime the Infernal frog next quest."]
	quest.514000000000000A.quest_subtitle: "The one thing you can't make yet."
	quest.514000000000000A.title: "Raid a Fortress"
	quest.514000000000000D.quest_desc: ["Prime the &eSpawnery&r with your &eNether Bricks&r and it gives a &cBottle of Infernal Frog Eggs&r."]
	quest.514000000000000D.quest_subtitle: "Feed the bricks to the Spawnery."
	quest.514000000000000D.title: "Infernal Frog Eggs"
	quest.5140000000000010.quest_desc: [
		"Same &eDissolution Chamber&r from the Tide. Feed it a &bNautilus Shell&r and &eprismarine&r filler for a &cBucket of Netherrack Slime&r."
	]
	quest.5140000000000010.quest_subtitle: "The chamber's first hellish brew."
	quest.5140000000000010.title: "A Bucket of Netherrack Slime"
	quest.5140000000000013.quest_desc: [
		"Pour the slime into a &eSlime Milker&r. &cNetherrack Slime Milk&r spawns Netherrack Slimes for the frog."
	]
	quest.5140000000000013.quest_subtitle: "Netherrack Slime Milk."
	quest.5140000000000013.title: "Milk It"
	quest.5140000000000016.quest_desc: ["Feed a Netherrack Slime to your Infernal frog for a &6Netherrack Froglight&r, then smelt it for &cnetherrack&r. The rest of the Nether's blocks come off the same frog from here - no more portal trips."]
	quest.5140000000000016.quest_subtitle: "Tier 5 opens."
	quest.5140000000000016.title: "First Netherrack"
	chapter_group.0C4F0E0000000006.title: "Tier 6: Void"
	chapter.601D000000000001.title: "Road to the Void"
	chapter.60F0000000000001.title: "Void Frogs"
	chapter.6EC0000000000001.title: "The Ultimate Table"
	chapter.6A0D000000000001.title: "Master Pond"
	quest.601D000000000002.quest_desc: [
		"You reach the End through &eEnder Pearls&r, and out here that means farming &dEndermen&r yourself. They only spawn in full darkness, so wall off a dark room and let them turn up."
		""
		"Two become &aEyes of Ender&r for the cake below; the rest prime the &eSpawnery&r for &5Void&r frogs once you're through."
	]
	quest.601D000000000002.quest_subtitle: "The void wants a key."
	quest.601D000000000002.title: "Pearls from the Dark"
	quest.601D000000000005.quest_desc: ["Blaze powder comes off your &cInfernal frog&r: each blaze rod cracks into two. Craft &a2&r Eyes of Ender for the cake."]
	quest.601D000000000005.quest_subtitle: "Pearl plus powder."
	quest.601D000000000005.title: "Eyes of Ender"
	quest.601D000000000008.quest_desc: [
		"A void skyblock has no stronghold and no End portal to find, so you bake your way in."
		""
		"Same grid as a vanilla cake, with Eyes of Ender where the sugar goes: &e3 milk&r across the top, an &eegg&r between &a2 Eyes of Ender&r, and &e3 wheat&r along the bottom. The milk can be plain &eMilk Buckets&r or any &dSlime Milk&r your frogs make."
		""
		"Plain &eMilk Buckets&r give their empty buckets back; &dSlime Milk&r bakes in, bucket and all."
	]
	quest.601D000000000008.quest_subtitle: "If the world won't give you a portal, bake one."
	quest.601D000000000008.title: "Bake the End Cake"
	quest.601D00000000000B.quest_desc: [
		"Place the &dEnd Cake&r and take a bite. It teleports you like an End portal: to the End, and back to the overworld if you bite it from the End side. Each bite spends one trip, so one cake is good for several."
		""
		"You land on an obsidian platform at the edge of the central island. Mind the drop into the void."
	]
	quest.601D00000000000B.quest_subtitle: "Eat the portal the world won't give you."
	quest.601D00000000000B.title: "Into the End"
	quest.601D00000000000E.quest_desc: ["The &5Ender Dragon&r guards the central island, the pack's capstone fight. Take out the End Crystals on the towers first or they heal her; your jetpack gets you up to them. Beds explode in the End, so set one by the dragon and try to sleep for a burst of damage."]
	quest.601D00000000000E.quest_subtitle: "The fight the pack was walking toward."
	quest.601D00000000000E.title: "Slay the Dragon"
	quest.601D000000000011.quest_desc: ["Prime the &eSpawnery&r with an &eender pearl&r and it bottles a &bBottle of Void Frog Eggs&r."]
	quest.601D000000000011.quest_subtitle: "The last species."
	quest.601D000000000011.title: "Void Frog Eggs"
	quest.601D000000000014.quest_desc: ["Run &fnetherite scrap&r through the &eDissolution Chamber&r with &fsoul soil&r filler for a &5Bucket of Ender Pearl Slime&r. First Void resource slime, and it seeds the whole Void milk chain."]
	quest.601D000000000014.quest_subtitle: "Bottle the void."
	quest.601D000000000014.title: "A Bucket of Ender Pearl Slime"
	quest.601D000000000017.quest_desc: ["Run the &5Ender Pearl Slime&r through the &eSlime Milker&r for a &bBucket of Ender Pearl Slime Milk&r. Pour it out and Ender Pearl Slimes spawn for your &5Void frog&r to eat."]
	quest.601D000000000017.quest_subtitle: "One more bucket."
	quest.601D000000000017.title: "Milk It"
	quest.601D00000000001A.quest_desc: [
		"Feed an Ender Pearl Slime to your &5Void frog&r and it drops an &6Ender Pearl Froglight&r. Smelt it for &eender pearls&r."
		""
		"Tier 6 is open: the last species, and the run-up to the endgame."
	]
	quest.601D00000000001A.quest_subtitle: "Tier 6 opens."
	quest.601D00000000001A.title: "First Ender Pearl"
	quest.60F0000000000002.quest_desc: [
		"Ender pearls were just the way in. The &5Void&r frog gives you the rest of the End:"
		""
		"end stone, chorus fruit, echo shards, sculk, phantom membranes, and shulker shells."
	]
	quest.60F0000000000002.quest_subtitle: "The End, on tap."
	quest.60F0000000000002.title: "Beyond the Pearl"
	quest.60F0000000000005.quest_desc: ["Craft an &bEnd Stone Slime in a Bucket&r in a Dissolution Chamber, feed your &aVoid Frog&r, and turn in the &6End Stone Froglight&r."]
	quest.60F0000000000005.quest_subtitle: "Pale and endless."
	quest.60F0000000000005.title: "End Stone"
	quest.60F0000000000008.quest_desc: ["Craft a &bChorus Fruit Slime in a Bucket&r in a Dissolution Chamber, feed your &aVoid Frog&r, and turn in the &6Chorus Fruit Froglight&r."]
	quest.60F0000000000008.quest_subtitle: "A fruit that moves you."
	quest.60F0000000000008.title: "Chorus Fruit"
	quest.60F000000000000B.quest_desc: ["Craft an &bEcho Shard Slime in a Bucket&r in a Dissolution Chamber, feed your &aVoid Frog&r, and turn in the &6Echo Shard Froglight&r."]
	quest.60F000000000000B.quest_subtitle: "The deep dark, skipped."
	quest.60F000000000000B.title: "Echo Shard"
	quest.60F0000000000030.quest_desc: [
		"A one-frog Terrarium in two blocks. Set the &bDome&r on the &bProcessor&r, net a frog in, and feed it its milk. It eats and produces Froglights."
		""
		"No more worrying about too many slimes in your world. This block produces more than a full Terrarium once you add upgrades."
	]
	quest.60F0000000000030.quest_subtitle: "Sealed under glass."
	quest.60F0000000000030.title: "The Virtual Terrarium"
	quest.60F000000000000E.quest_desc: ["Craft a &bSculk Slime in a Bucket&r in a Dissolution Chamber, feed your &aVoid Frog&r, and turn in the &6Sculk Froglight&r."]
	quest.60F000000000000E.quest_subtitle: "It listens."
	quest.60F000000000000E.title: "Sculk"
	quest.60F0000000000017.quest_desc: [
		"Apothic Enchanting's best sculk bookshelves need a &dWarden Tendril&r, and only the &cWarden&r drops it. A void skyblock grows no Deep Dark, so you summon the Warden by hand."
		""
		"Place a &eSculk Shrieker&r - craft it from sculk and echo shards off your Void frog, plus a bone block - then use Ex Deorum's &eSculk Core&r (four echo shards and an ender pearl) on it. A crafted shrieker can't summon until the Core wakes it. Set it shrieking a few times and the Warden digs up."
		""
		"&cCome geared&r: the Warden is the toughest mob in the game. Kill it for the &dWarden Tendril&r and the top of the enchanting tree. The fight is optional, skip it if you want."
	]
	quest.60F0000000000017.quest_subtitle: "The hardest fight, the best enchants."
	quest.60F0000000000017.title: "Wake the Warden"
	quest.60F0000000000011.quest_desc: ["Craft a &bShulker Shell Slime in a Bucket&r in a Dissolution Chamber, feed your &aVoid Frog&r, and turn in the &6Shulker Shell Froglight&r."]
	quest.60F0000000000011.quest_subtitle: "Boxes that come with you."
	quest.60F0000000000011.title: "Shulker Shell"
	quest.60F0000000000019.quest_desc: [
		"A &5Void Frog&r never produces the &eExperience&r variant on its own, so the &eDissolution Chamber&r makes it instead: a plain &fbook&r run with soul soil, sweetslime, and latex."
		""
		"Feed the slime to a Void Frog and turn in the &6Experience Froglight&r it leaves. Smelt that into a &aBottle o' Enchanting&r."
	]
	quest.60F0000000000019.quest_subtitle: "The one the frog won't make."
	quest.60F0000000000019.title: "Experience"
	quest.6EC0000000000002.quest_desc: ["Extended Crafting is the endgame crafting line, and every part of it builds up from &7Black Iron&r. Combine an iron ingot with black dye (your Tide frog's ink) for a &7Black Iron Ingot&r."]
	quest.6EC0000000000002.quest_subtitle: "Iron, dyed for greater things."
	quest.6EC0000000000002.title: "Black Iron"
	quest.6EC0000000000005.quest_desc: ["&eLuminessence&r goes into every Extended Crafting component, and components go into every table and catalyst in this chapter. You will burn through it, so make plenty."]
	quest.6EC0000000000005.quest_subtitle: "The spark in the machine."
	quest.6EC0000000000005.title: "Luminessence"
	quest.6EC0000000000008.quest_desc: ["Extended Crafting's recipes run in these tables, not a vanilla bench. The &6Basic Table&r is the first tier, a &63x3&r grid; the tiers scale up to the &69x9&r Ultimate Table."]
	quest.6EC0000000000008.quest_subtitle: "Bigger than a workbench, barely."
	quest.6EC0000000000008.title: "The Basic Table"
	quest.6EC000000000000B.quest_desc: ["The &6Advanced Table&r is the &65x5&r tier. Build it from the Basic Table and a gold block."]
	quest.6EC000000000000B.quest_subtitle: "Five by five."
	quest.6EC000000000000B.title: "The Advanced Table"
	quest.6EC000000000000E.quest_desc: ["The &6Elite Table&r is the &67x7&r tier. Build it from the Advanced Table and a diamond block."]
	quest.6EC000000000000E.quest_subtitle: "Seven by seven."
	quest.6EC000000000000E.title: "The Elite Table"
	quest.6EC0000000000011.quest_desc: ["The &6Ultimate Table&r is the &69x9&r tier, the biggest grid in the pack. Build it from the Elite Table and an emerald block. It is the only grid large enough to craft the &bUltimate Singularity&r, the key to the Master Frog."]
	quest.6EC0000000000011.quest_subtitle: "Nine by nine. The big one."
	quest.6EC0000000000011.title: "The Ultimate Table"
	quest.6EC0000000000014.quest_desc: ["The &dUltimate Catalyst&r is the catalyst the Quantum Compressor runs on. It sits in the compressor's catalyst slot and is never used up, so one is all a compressor needs. Craft it before the compressor."]
	quest.6EC0000000000014.quest_subtitle: "Fuel for the fold."
	quest.6EC0000000000014.title: "The Ultimate Catalyst"
	quest.6EC0000000000017.quest_desc: ["The &dQuantum Compressor&r presses a thousand of one resource into a single &bSingularity&r, one for every resource your frogs make. It runs on &bFE&r - wire it to your Mekanism grid."]
	quest.6EC0000000000017.quest_subtitle: "A thousand of a haul, one cube."
	quest.6EC0000000000017.title: "The Quantum Compressor"
	quest.6A0D000000000002.quest_desc: [
		"You've killed the dragon and built the &dQuantum Compressor&r. What's left is proving the farms run without you. Each &bSingularity&r takes 1,000 of one resource, far more than you'd ever hand-make, so only a running frog farm can keep the compressor fed. You need one for every resource the frogs make."
		""
		"Check the &dUltimate Singularity&r recipe for the full roster; it grows as the frogs learn new resources. The &dUltimate Catalyst&r stays in the compressor's catalyst slot, so the one you already made covers every Singularity."
	]
	quest.6A0D000000000002.quest_subtitle: "Prove the frogs run without you."
	quest.6A0D000000000002.title: "The Long Compression"
	quest.6A0D000000000005.quest_desc: [
		"Put the &dUltimate Catalyst&r in the compressor's catalyst slot, feed the &dQuantum Compressor&r 1,000 iron, and it presses out one &bIron Singularity&r. Feed it the smelted ingots, not the Froglights. Wire your iron farm straight in; a thousand by hand is the slow road."
		""
		"The first of many. The &dUltimate Singularity&r needs one from every farm you've built."
	]
	quest.6A0D000000000005.quest_subtitle: "A thousand iron, one cube."
	quest.6A0D000000000005.title: "Your First Singularity"
	quest.6A0D000000000008.quest_desc: ["Gather one Singularity for every resource the frogs make and combine the whole set in the &6Ultimate Crafting Table&r. Out comes the &dUltimate Singularity&r: proof you automated every last farm."]
	quest.6A0D000000000008.quest_subtitle: "The densest frog there is."
	quest.6A0D000000000008.title: "The Ultimate Singularity"
	quest.6A0D00000000000B.quest_desc: [
		"Set the Ultimate Singularity in a crafting table, ring it with Froglights, drop a Sweetslime in each bottom corner, and craft the &aSky Frogs Master Frog&r. It does nothing. It is everything."
	]
	quest.6A0D00000000000B.quest_subtitle: "The trophy at the end of the pond."
	quest.6A0D00000000000B.title: "The Sky Frogs Master Frog"
	quest.6A0D00000000000E.quest_desc: [
		"Set it on a shelf. You started on a speck of dirt with a bottle of frog eggs, and you turned frogs into the entire world - ore, gem, bog, ocean, nether, and void."
		""
		"There is nothing left to mine. Thanks for playing Sky Frogs."
	]
	quest.6A0D00000000000E.quest_subtitle: "Thanks for playing."
	quest.6A0D00000000000E.title: "You Out-Frogged the Game"
	quest.54E5F6A1B2C30041.quest_desc: ["A reusable net: right-click a frog to catch it, right-click a block to set it down. It keeps everything - species, stats, and name - so you can move a frog anywhere."]
	quest.54E5F6A1B2C30041.quest_subtitle: "Catch and carry, stats intact."
	quest.54E5F6A1B2C30041.title: "The Frog Net"
	quest.601D00000000001D.quest_desc: [
		"The &5Ender Dragon&r drops a &dPrincess's Kiss&r. Right-click any frog with it to turn it into a plain, unemployed &evillager&r, free to take any profession. That is how you open villager trading on a skyblock pond."
		""
		"It transforms whatever frog you click and works on any of them, so don't spend it on a prize breeder; net a spare frog first."
	]
	quest.601D00000000001D.quest_subtitle: "The dragon was the princess all along."
	quest.601D00000000001D.title: "Princess's Kiss"
}
