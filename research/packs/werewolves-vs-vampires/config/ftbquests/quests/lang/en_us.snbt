	quest.0005E18AE2C7FCE1.quest_desc: ["Larger, meaner, and the traps actually work now."]
	quest.0005E18AE2C7FCE1.quest_subtitle: "Yung's Better Jungle Temples"
	quest.0005E18AE2C7FCE1.title: "Better Jungle Temples"
	quest.0053A53D459AEB3B.quest_desc: ["Take a village apart as a werewolf. The villagers will remember."]
	quest.0053A53D459AEB3B.quest_subtitle: "Terrorise a village"
	quest.0053A53D459AEB3B.title: "The Beast of Gevaudan"
	quest.006487F2CA53EEE7.quest_desc: [
		"&aStrengths&r"
		"- Three forms: &6Beast&r (raw damage), &6Survivalist&r (speed and mobility), &6Lycanthrope&r (utility, can wear armour)."
		"- Leap, Rage, Howling, Sense-through-walls, Frightening."
		"- Bite attacks that stun, bleed, or instantly kill weakened targets from behind."
		"- No sun damage. You are the only supernatural faction that owns the daytime."
		""
		"&cWeaknesses&r"
		"- &4Silver.&r Silver swords and silver bolts cut through your fur and slow you. Hunters know this."
		"- No armour in Beast or Survivalist form until you unlock the skill for it."
		"- Your form has a duration. You will drop back to human at the worst moment."
		"- Full moon forces a transformation until you unlock &6Free Will&r."
		"- Meat only, until you take the &6Not Meat?&r skill."
	]
	quest.006487F2CA53EEE7.quest_subtitle: "What being a Werewolf actually costs"
	quest.006487F2CA53EEE7.title: "The Price of the Moon"
	quest.011BDA47221BCAD6.quest_desc: [
		"The &6Scalpel&r harvests delicate ingredients from mobs - venom fangs from poisoned wolves, toxic spit from llamas, brittle bones from the Bogged."
		""
		"The &6Magnifying Glass&r reveals an ingredient's affinity once you know enough about it."
	]
	quest.011BDA47221BCAD6.quest_subtitle: "Copper Scalpel and Magnifying Glass"
	quest.011BDA47221BCAD6.title: "Scalpel and Glass"
	quest.0151C12F2CD9B364.quest_desc: ["Vampirism ships an umbrella of its own. It works the same way and is cheaper to make."]
	quest.0151C12F2CD9B364.quest_subtitle: "Vampirism's own umbrella"
	quest.0151C12F2CD9B364.title: "The Old Umbrella"
	quest.018EB3603CE943FF.quest_desc: ["The top of the tree. There is nothing left to unlock in your bloodline."]
	quest.018EB3603CE943FF.quest_subtitle: "Maximum bloodline rank"
	quest.018EB3603CE943FF.title: "Elder"
	quest.01D9CAC9D2AE45B0.quest_desc: [
		"You have survived as a human. That was the easy part."
		""
		"&6Open the next chapter.&r Read all three descriptions before you commit to anything."
	]
	quest.01D9CAC9D2AE45B0.quest_subtitle: "Time to choose"
	quest.01D9CAC9D2AE45B0.title: "The Crossroads"
	quest.01E204A14501C580.quest_desc: ["Drink bottled Vampire Blood. Only a Bloodknight with the Still Blood skill can keep it down."]
	quest.01E204A14501C580.quest_subtitle: "Bloodknight only"
	quest.01E204A14501C580.title: "Pariah"
	quest.01E5B3A025CC7602.quest_desc: [
		"Orchids grow wild in the Vampire Forest. Harvest the petals and the seeds and you unlock an entire dessert line: orchid tea, orchid cake, orchid curry, orchid ice cream, eclairs."
		""
		"&7Orchid food works for every faction. It is the nicest thing this mod makes.&r"
	]
	quest.01E5B3A025CC7602.quest_subtitle: "The prettiest thing in the Vampire Forest"
	quest.01E5B3A025CC7602.title: "Vampire Orchids"
	quest.01F26B5B9AD68AFE.quest_desc: ["You have an army of humans and a warehouse of holy water. Good."]
	quest.01F26B5B9AD68AFE.quest_subtitle: "Hunter Lord rank 5"
	quest.01F26B5B9AD68AFE.title: "Grand Master Hunter"
	quest.0236BB9CD3421868.quest_desc: ["Scattered huts full of vampire loot. Bring something to kill the occupants with."]
	quest.0236BB9CD3421868.quest_subtitle: "Small, cursed, worth looting"
	quest.0236BB9CD3421868.title: "The Vampire Hut"
	quest.024FA57A43693DFF.quest_desc: [
		"Whichever ritual you survived, you are no longer an ordinary vampire."
		""
		"&7A new tab has appeared in your skill tree.&r"
	]
	quest.024FA57A43693DFF.quest_subtitle: "Join any bloodline"
	quest.024FA57A43693DFF.title: "A Bloodline Awakens"
	quest.0293BFF0C5B738A5.quest_desc: ["The world generates finished infusion altars. Finding one saves you a very large pile of gold."]
	quest.0293BFF0C5B738A5.quest_subtitle: "A pre-built Altar of Infusion"
	quest.0293BFF0C5B738A5.title: "An Altar in the Wild"
	quest.02B15E4F686CCB00.quest_desc: ["Teeth are needed for Werewolf &6Lord&r levelling, not normal levelling. Start hoarding them now so you are not farming at level 14."]
	quest.02B15E4F686CCB00.quest_subtitle: "Dropped by werewolves"
	quest.02B15E4F686CCB00.title: "Werewolf Tooth"
	quest.02C14FB564D546FB.quest_desc: [
		"A Farmer's Delight knife made of werewolf-grade silver."
		""
		"&6It is a kitchen tool and an anti-werewolf weapon at the same time.&r Hunters should carry one for both reasons."
	]
	quest.02C14FB564D546FB.quest_subtitle: "Cuts more than vegetables"
	quest.02C14FB564D546FB.title: "Silver Knife"
	quest.031B2921EAD483D0.quest_desc: ["An impressive castle needs impressive gates. Tall doors, and something to open them with."]
	quest.031B2921EAD483D0.quest_subtitle: "Dramatic Doors"
	quest.031B2921EAD483D0.title: "Gates of Power"
	quest.033FF5AD3E8CCF56.quest_desc: [
		"The guild pays for raw silver. Keep delivering while the mine holds."
		""
		"&4This one consumes the silver.&r"
		""
		"&8Cooldown: one hour.&r"
	]
	quest.033FF5AD3E8CCF56.quest_subtitle: "Repeatable"
	quest.033FF5AD3E8CCF56.title: "Silver Vein"
	quest.0351C86A9D6D7F79.quest_subtitle: "STOP THE SOUND"
	quest.0351C86A9D6D7F79.title: "Bell"
	quest.0365B43D1ACFDE2A.quest_desc: ["Slower, meaner, and it hits hard enough to matter in PvP."]
	quest.0365B43D1ACFDE2A.quest_subtitle: "The heavy version"
	quest.0365B43D1ACFDE2A.title: "Heartstriker"
	quest.04C0F42AA11D9F68.quest_subtitle: "Yummers"
	quest.04F7622E4815882A.quest_desc: ["Fill your inventory. You are about to do something a human should not survive."]
	quest.04F7622E4815882A.quest_subtitle: "Stock up before the last fight"
	quest.04F7622E4815882A.title: "Raw Ambition"
	quest.0513EE14958514A1.quest_desc: [
		"Crops only grow in the right season. Plant wheat in winter and you will watch it do nothing for a very long time."
		""
		"&7Check the current season on your HUD or with the calendar. Greenhouse glass is not a thing here - plan your farm around the year instead.&r"
		""
		"&8Nights get longer in winter. That is good news for exactly one of the three factions.&r"
	]
	quest.0513EE14958514A1.quest_subtitle: "Information - Serene Seasons"
	quest.0513EE14958514A1.title: "The Seasons Turn"
	quest.05413452AD610DA6.quest_desc: [
		"&8How to join:&r deep underground in the &8Deep Dark&r there are small shrine structures. In the centre of each is a &8Zealot Altar&r."
		""
		"Craft a &8Zealot Ritual Catalyst&r and use it on that altar. The ritual runs, and you come out a Zealot."
		""
		"&aWhat you get:&r faster mining, reduced thirst, wall climbing, teleporting through darkness, invisibility at will in the dark, and you can eat rotten flesh for blood."
		""
		"&cWhat it costs:&r the sun destroys you faster than any other bloodline, and villagers want nothing to do with you."
		""
		"&4The ritual only works if you have no bloodline yet.&r"
	]
	quest.05413452AD610DA6.quest_subtitle: "Find the shrine in the Deep Dark"
	quest.05413452AD610DA6.title: "Zealot"
	quest.064B08FF8FBBD12B.quest_desc: [
		"You cannot sleep in a bed as a vampire. A Coffin sets your spawn and passes the night."
		""
		"&7Coffins come in all sixteen colours. Later on, the Coffin is also where you check your &cAge Rank&r if Vampiric Ageing is running.&r"
	]
	quest.064B08FF8FBBD12B.quest_subtitle: "Beds do not work any more"
	quest.064B08FF8FBBD12B.title: "A Coffin to Call Home"
	quest.068254AABCF1431F.quest_desc: ["Iron is the floor of every path in this pack. Umbrellas, injection chairs, stakes, altars - all of it starts here."]
	quest.068254AABCF1431F.quest_subtitle: "Eight bars, minimum"
	quest.068254AABCF1431F.title: "Cold Iron"
	quest.0784F3B65AB9BA5D.quest_desc: ["Purple, floral, and it does not contain a single drop of anyone."]
	quest.0784F3B65AB9BA5D.quest_subtitle: "Genuinely lovely"
	quest.0784F3B65AB9BA5D.title: "Orchid Cake"
	quest.07D551E81DEC7708.title: "Smeltery"
	quest.0800D188A4680268.quest_desc: ["Soups, stews and anything with more than three ingredients. Put it on a stove or a campfire."]
	quest.0800D188A4680268.quest_subtitle: "Farmer's Delight"
	quest.0800D188A4680268.title: "The Cooking Pot"
	quest.0811F4BA3D56D1FA.title: "The Nether"
	quest.0815C4A38E9AA09B.quest_desc: [
		"You do not eat any more. Your hunger bar is a &cblood bar&r."
		""
		"Hold your bite key on a villager, cow, sheep, horse or pig and drain them. &aVillagers are by far the best source.&r"
		""
		"&7Watch for &2green fangs&7 above a mob - that one is full of garlic and biting it will poison you.&r"
	]
	quest.0815C4A38E9AA09B.quest_subtitle: "Hold the interact key on a villager"
	quest.0815C4A38E9AA09B.title: "First Blood"
	quest.0819782789CB5B45.quest_desc: ["Unlock the skill that raises your maximum blood pool."]
	quest.0819782789CB5B45.quest_subtitle: "Extra blood storage"
	quest.0819782789CB5B45.title: "Deeper Thirst"
	quest.08203EA4C5E27510.quest_desc: [
		"Intel comes in grades 0 through 9, one for each level from 5 to 14. Produce it at the Hunter Table, then pay the trainer his fee."
		""
		"&7Feeding the table vampire fangs, hearts and blood is the fastest route.&r"
	]
	quest.08203EA4C5E27510.quest_subtitle: "Ten grades of research"
	quest.08203EA4C5E27510.title: "Hunter Intel"
	quest.08C12B40081A05C0.quest_desc: [
		"&4Sunlight damage scales with your vampire level.&r At level 1 it is an annoyance. By level 4 it is lethal, and by the time you are useful it will delete you in seconds."
		""
		"&6Your options:&r"
		"- &eAn Umbrella&r in your off-hand. Cheapest and most reliable."
		"- &eSunscreen&r, a temporary potion-style protection."
		"- &eA Sunscreen Beacon&r, which protects a whole area of your base."
		"- &eStay underground.&r Honestly, this is what most vampires do."
		""
		"&7Rain, thunderstorms and heavy tree cover all count as shade.&r"
	]
	quest.08C12B40081A05C0.quest_subtitle: "Information - sun damage by level"
	quest.08C12B40081A05C0.title: "The Sun Will Kill You"
	quest.08E1B5F94A564689.quest_desc: [
		"Garlic weakens vampires and it is the key ingredient of the hunter vaccine."
		""
		"&7Find a village with a Hunter Trainer - there are garlic plants behind the house. Take some, and replant some. You will want a supply either way.&r"
	]
	quest.08E1B5F94A564689.quest_subtitle: "Grows behind Hunter Trainer houses"
	quest.08E1B5F94A564689.title: "Garlic in the Garden"
	quest.09B09E340497F176.quest_desc: ["Something enormous happened here. The loot is what is left of it."]
	quest.09B09E340497F176.quest_subtitle: "Iron's Spellbooks"
	quest.09B09E340497F176.title: "Ancient Battleground"
	quest.09B896CC8C06F931.quest_desc: [
		"Twenty of them. One barrel."
		""
		"&8Honour system: do it with the musket. FTB Quests cannot check which weapon you used - there is no weapon filter on a kill task. Nobody is watching. You will know.&r"
	]
	quest.09B896CC8C06F931.quest_subtitle: "Twenty vampires"
	quest.09B896CC8C06F931.title: "The Marksman"
	quest.09D635FFEF06E412.title: "Vine"
	quest.09DA64F039E0371C.quest_desc: ["Start hunting big things. Raids, Ravagers, and anything with a health bar."]
	quest.09DA64F039E0371C.quest_subtitle: "The prey requirement gets ugly here"
	quest.09DA64F039E0371C.title: "Level 10"
	quest.0A6D8218D3B74498.quest_desc: ["The other half of every ritual. Skeletons are the easy source."]
	quest.0A6D8218D3B74498.quest_subtitle: "Dropped by werewolves and skeletons"
	quest.0A6D8218D3B74498.title: "Cracked Bones"
	quest.0A760DE6782BFC99.quest_desc: [
		"Every poisonous ingredient has a hidden &6affinity&r, and the affinity decides which mutagen you get. You have to discover them."
		""
		"&e1.&r Grind redstone into a &cRedstone Mixture&r."
		"&e2.&r Heat it in the crucible to remove impurities."
		"&e3.&r Purify it in the alembic together with the ingredient you want to study. That gives an &6Affinity Solution&r."
		""
		"&7There is a slow alternative: eat enormous quantities of the ingredient until you work it out. It is as painful as it sounds.&r"
	]
	quest.0A760DE6782BFC99.quest_subtitle: "Learn what a poison actually is"
	quest.0A760DE6782BFC99.title: "Affinity Solutions"
	quest.0A7E3D8AFAD6E58D.quest_subtitle: "Is this your transport method?"
	quest.0A7E3D8AFAD6E58D.title: "Cart Transporter"
	quest.0AC73047135572EE.quest_desc: ["Pure Salt is refined at the Alchemical Cauldron. It is the base of all holy water."]
	quest.0AC73047135572EE.quest_subtitle: "Boil it out of salt water"
	quest.0AC73047135572EE.title: "Pure Salt"
	quest.0B30C9739A064263.quest_desc: [
		"Craft it, place it, and fill it with blood by right-clicking with filled Blood Bottles."
		""
		"When there is enough blood inside, right-click with an &6empty hand&r and the blood is infused into you."
		""
		"&4This only works at night.&r"
		""
		"&7Blood cost rises for each level. Look the altar up in JEI for the exact amounts.&r"
	]
	quest.0B30C9739A064263.quest_subtitle: "Levels 2 to 4"
	quest.0B30C9739A064263.title: "Altar of Inspiration"
	quest.0B86D4FC0AC764D0.quest_desc: [
		"&6Umvuthi&r rules the savanna from his grove, surrounded by the Umvuthana."
		"&aThe Naga&r hunts the cliffs - it will pick you up and drop you."
		""
		"&7Both fight under open sky. Neither of them is a good first boss.&r"
		""
		"&8Umvuthi used to be called Barako. The entity is registered as umvuthi.&r"
	]
	quest.0B86D4FC0AC764D0.quest_subtitle: "Umvuthi and the Naga"
	quest.0B86D4FC0AC764D0.title: "Sun and Venom"
	quest.0BA7E9CC4CB98D8A.quest_desc: ["Lighter than the coat. If you are chasing werewolves rather than ambushing vampires, this is the set you want."]
	quest.0BA7E9CC4CB98D8A.quest_subtitle: "For hunters who prefer to be fast"
	quest.0BA7E9CC4CB98D8A.title: "Armour of Swiftness"
	quest.0BCC3B35744B1288.quest_desc: ["Projects sun protection over an area. Build it in your courtyard and you can walk around your own base at noon."]
	quest.0BCC3B35744B1288.quest_subtitle: "Own the daylight at home"
	quest.0BCC3B35744B1288.title: "Sunscreen Beacon"
	quest.0BE70398DF228957.quest_desc: ["The fees rise sharply here. Emeralds and rare mob drops start mattering."]
	quest.0BE70398DF228957.quest_subtitle: "Halfway through the research grind"
	quest.0BE70398DF228957.title: "Level 8"
	quest.0BF6139247F9EADB.quest_desc: ["Ordinary villages under hunter protection. Guard Villagers usually make it obvious."]
	quest.0BF6139247F9EADB.quest_subtitle: "Lives in hunter-aligned villages"
	quest.0BF6139247F9EADB.title: "The Hunter Representative"
	quest.0C94D1B3DC3F9C2F.quest_desc: [
		"&4How to join:&r brew a &4Heinous Elixir&r from Corrupted Blood Samples and drink it."
		""
		"It applies a wall of negative effects for &c30 seconds&r. Survive them and you are a Bloodknight."
		""
		"&aWhat you get:&r you feed on &lother vampires&r once they drop below 25% health. Daywalker trades blood for sun protection. Blood Hunt trades blood for invisibility. With the Still Blood skill you can drink bottled Vampire Blood directly."
		""
		"&cWhat it costs:&r ordinary blood barely nourishes you, villagers trade badly with you, and villagers hit harder."
		""
		"&7Have regeneration ready before you drink.&r"
	]
	quest.0C94D1B3DC3F9C2F.quest_subtitle: "Drink the Heinous Elixir and survive"
	quest.0C94D1B3DC3F9C2F.title: "Bloodknight"
	quest.0C9BD8D75F294AF7.quest_desc: [
		"An empty Syringe becomes a &bGarlic Injection&r (the vaccine), a &cSanguinare Injection&r (to defect to the vampires), or a &6Zombie Blood Injection&r."
		""
		"&7Right-clicking a werewolf with an empty syringe draws the strange fluid needed to cure one.&r"
	]
	quest.0C9BD8D75F294AF7.quest_subtitle: "Your most versatile tool"
	quest.0C9BD8D75F294AF7.title: "The Syringe"
	quest.0CA750F0A957F24B.quest_desc: [
		"Any &6Glass Bottle&r or &cBlood Bottle&r on your hotbar fills automatically when you bite a mob that is already at full blood."
		""
		"&7Carry at least four. Running dry in the middle of a fight is how vampires die.&r"
	]
	quest.0CA750F0A957F24B.quest_subtitle: "Keep bottles on your hotbar while feeding"
	quest.0CA750F0A957F24B.title: "Bottled Life"
	quest.0D63EA2EDC80478E.quest_desc: [
		"&6One way:&r let a Werewolf hit you. There is a chance you catch &6Lupus Sanguinem&r."
		""
		"Unlike the vampire infection, this one does not run on a timer. It waits."
		""
		"&6You turn the moment you next sleep.&r So: get scratched, go home, get in bed."
		""
		"&7Milk cancels it. If you do not want to be a wolf, drink milk before you sleep.&r"
		""
		"&8Werewolves spawn in forests, and much more densely in a Werewolf Forest.&r"
	]
	quest.0D63EA2EDC80478E.quest_subtitle: "Becoming a Werewolf"
	quest.0D63EA2EDC80478E.title: "How to Get Scratched"
	quest.0D9F54FF7D5AA60C.quest_desc: [
		"The Inscription Table binds a spell scroll into a spell book slot."
		""
		"&7You will find these pre-built in magic towers out in the world, but you want one at home.&r"
	]
	quest.0D9F54FF7D5AA60C.quest_subtitle: "Where scrolls become spells"
	quest.0D9F54FF7D5AA60C.title: "The Inscription Table"
	quest.0E635C0A20F57AC0.quest_desc: ["A charm buys loyalty. Your tribe will hunt and gather while you are elsewhere."]
	quest.0E635C0A20F57AC0.quest_subtitle: "Right-click a weak werewolf NPC with it"
	quest.0E635C0A20F57AC0.title: "Werewolf Minion Charm"
	quest.0ECF368FC57082AF.quest_desc: [
		"Bloody Soil and Cursed Farmland are the vampire equivalent of Rich Soil."
		""
		"&7Cursed Farmland is what you need to grow Vampire Orchids on purpose.&r"
	]
	quest.0ECF368FC57082AF.quest_subtitle: "Farmland for things that should not grow"
	quest.0ECF368FC57082AF.title: "Bloody Soil"
	quest.0EEE8F5E202A65F8.quest_desc: [
		"&6You age by killing creatures with your Bite Attack.&r Not your sword. Your teeth."
		""
		"Different creatures are worth different amounts of &6devour points&r."
		""
		"&6Where to check your progress:&r interact with a &6Stone Altar Fire Bowl&r."
	]
	quest.0EEE8F5E202A65F8.quest_subtitle: "How a werewolf ages"
	quest.0EEE8F5E202A65F8.title: "Werewolves: Kill With the Bite"
	quest.0FC4FCE0627B3102.title: "Enable/Disable Repeatable Quests"
	quest.0FCB2DA0BDCA318F.quest_desc: ["The game itself acknowledges that you now command others."]
	quest.0FCB2DA0BDCA318F.quest_subtitle: "Advancement"
	quest.0FCB2DA0BDCA318F.title: "Recognised"
	quest.1024E9F929BD6E50.quest_desc: [
		"&4Vampirism registers an entity called Dracula.&r"
		""
		"&8Whether he appears on this server depends on your configuration and your luck. This quest is here so that if you ever meet him, the book has a place to record it.&r"
	]
	quest.1024E9F929BD6E50.quest_subtitle: "If he shows up at all"
	quest.1024E9F929BD6E50.title: "Dracula"
	quest.10B88036FEF2712D.quest_desc: [
		"Without this skill, transforming drops your armour. With it, you keep it on."
		""
		"&7There is an advancement for wearing armour in Partial Turn, and it is not a compliment.&r"
	]
	quest.10B88036FEF2712D.quest_subtitle: "Unlock the skill"
	quest.10B88036FEF2712D.title: "Wear Armor"
	quest.1145A7CC828B6B79.quest_desc: [
		"The old proof. Everything after this is tidying up."
		""
		"&7Yung's Better End Island has rebuilt the arena. It is a better fight than it was.&r"
	]
	quest.1145A7CC828B6B79.quest_subtitle: "The Ender Dragon"
	quest.1145A7CC828B6B79.title: "The End of All Things"
	quest.11509AD86E4CEB24.quest_desc: ["Three tiers. Made at the Weapon Table. Vampires do not enjoy it."]
	quest.11509AD86E4CEB24.quest_subtitle: "Simple, heavy, effective"
	quest.11509AD86E4CEB24.title: "Hunter Axe"
	quest.129BC8C43CDE350E.quest_desc: ["A blaze that got promoted. Nether fortresses are more interesting now."]
	quest.129BC8C43CDE350E.quest_subtitle: "Friends and Foes"
	quest.129BC8C43CDE350E.title: "The Wildfire"
	quest.129C965EAB92D8E5.quest_desc: [
		"&6Bloodline rank is not earned by fighting.&r It is earned by completing tasks for the &cFaction Representatives&r in vampire villages."
		""
		"Each rank up unlocks &6one specific skill&r in your Bloodline tree that cannot be obtained any other way, and that skill gates the next tier."
		""
		"You also need &6Bloodline Perk Points&r, which come from separate special perk tasks the Representatives hand out."
		""
		"&7So: bloodline progression = keep doing Representative tasks. Forever.&r"
	]
	quest.129C965EAB92D8E5.quest_subtitle: "Information - how bloodline ranks work"
	quest.129C965EAB92D8E5.title: "Ranking Up"
	quest.139D7AC5FE2A9A9E.quest_desc: ["It never was."]
	quest.139D7AC5FE2A9A9E.quest_subtitle: "Not quite the fairy tale ending"
	quest.139D7AC5FE2A9A9E.title: "Little Red Riding Hood"
	quest.145C35D9C574AE31.quest_desc: [
		"Jacaranda and magic trees, wolf berry bushes, wolfsbane, silver ore underneath, and a great many werewolves."
		""
		"&7This is where the Alpha lives.&r"
	]
	quest.145C35D9C574AE31.quest_subtitle: "Enter a Werewolf Forest"
	quest.145C35D9C574AE31.title: "Dog Soldiers"
	quest.14855DD3A3EC2435.quest_desc: [
		"&2Ocelot Mint&r - jungle temples and jungles."
		"&5Nightshade&r - dark, overgrown places. Black berries under bright petals."
		"&fWater Hemlock&r - swamps. Cloudy and easy to spot."
		"&bColdsnap&r - frozen taiga. Vivid blue."
		"&4Bloodroot&r - the Nether, in Crimson Forests."
		""
		"&7Craft a plant alone to get its seeds. To plant them you need soil as potent as they are - poison paste converts normal farmland.&r"
	]
	quest.14855DD3A3EC2435.quest_subtitle: "Five plants, five biomes"
	quest.14855DD3A3EC2435.title: "Poisonous Flora"
	quest.14E6C73574A30002.quest_desc: [
		"Right-click a planted poisonous crop with an item you fully understand, and the plant may change into a new variant."
		""
		"&4You must know the affinity of both the plant and the item&r, or the graft fails."
		""
		"&7Moonlight Hemlock and Snow Mint are grafted variants, not natural ones.&r"
	]
	quest.14E6C73574A30002.quest_subtitle: "Make new plants"
	quest.14E6C73574A30002.title: "Grafting"
	quest.14FC4D74101AD339.quest_desc: [
		"Four levels of straight trading. From here on the trainer wants &6research&r, not blood."
		""
		"&7Build a Hunter Table.&r"
	]
	quest.14FC4D74101AD339.quest_subtitle: "The trainer cannot take you further"
	quest.14FC4D74101AD339.title: "Level 4"
	quest.1509E80CE707A9E5.quest_desc: ["Bring water breathing and something for the Elder Guardians. Or come as an Ectotherm vampire and enjoy yourself."]
	quest.1509E80CE707A9E5.quest_subtitle: "Yung's Better Ocean Monuments"
	quest.1509E80CE707A9E5.title: "Better Ocean Monuments"
	quest.154F4A605E6FDCE0.quest_desc: ["A man-wolf howling at the moon. It feels like something you have done before."]
	quest.154F4A605E6FDCE0.quest_subtitle: "Howl at the moon"
	quest.154F4A605E6FDCE0.title: "Howling Moon"
	quest.1561439E2C7DEE50.quest_desc: ["A dormant iron construct sealed in an underground chamber. It does not move until you wake it. Then it moves very quickly."]
	quest.1561439E2C7DEE50.quest_subtitle: "Mowzie's Mobs"
	quest.1561439E2C7DEE50.title: "Ferrous Wroughtnaut"
	quest.1596915DFD3FD8FB.quest_desc: [
		"The strongest Tainted Blood item in the mod, restricted to high Age Rank hunters."
		""
		"&8At this point you are, functionally, something the hunters would once have staked.&r"
	]
	quest.1596915DFD3FD8FB.quest_subtitle: "The end of the hunter's dark path"
	quest.1596915DFD3FD8FB.title: "Tainted Elixir"
	quest.160CE69D8B442DAE.quest_desc: [
		"&6Vampire's Delight is not a joke mod.&r It is a full Farmer's Delight expansion built around this server's factions."
		""
		"&cVampires&r get blood dishes and blood wine that feed the blood bar."
		"&bHunters&r get garlic cooking - which they can eat and vampires cannot."
		"&6Werewolves&r get wolf berry desserts and a great deal of raw meat."
		"&fEveryone&r gets a tavern to build."
		""
		"&7Start with the Cooking Pot. Everything else hangs off it.&r"
	]
	quest.160CE69D8B442DAE.quest_subtitle: "Open to every faction"
	quest.160CE69D8B442DAE.title: "Somebody Has to Cook"
	quest.160D1436D719FE20.quest_desc: [
		"Hold it and the sun cannot touch you. This single item is the difference between a vampire who plays the game and a vampire who logs off at dawn."
		""
		"&7Umbrellas come in every dye colour and in iron, gold, diamond and netherite tiers. Higher tiers last longer.&r"
	]
	quest.160D1436D719FE20.quest_subtitle: "Iron Umbrella"
	quest.160D1436D719FE20.title: "A Shade of Your Own"
	quest.1698E07350CDDAA1.title: "The Traveller"
	quest.171CD0DCA007F710.quest_desc: ["Epsilon, Delta, Gamma, Beta - and now Alpha. The pack is yours."]
	quest.171CD0DCA007F710.quest_subtitle: "Werewolf Lord rank 5 - Lord of the Hunt"
	quest.171CD0DCA007F710.title: "Alpha"
	quest.17713A94ACBDAFC0.quest_desc: [
		"&6Reaching level 14 unlocks a second progression that most players never find.&r"
		""
		"Every faction has a &6Representative&r NPC living in villages that belong to that faction. They hand out tasks. Most of the time those tasks pay in accessories and materials."
		""
		"&aAt maximum faction level, the Representative offers you a special task.&r Completing it makes you a &6Lord&r: you gain a title, and the right to bind NPCs of your own kind as &6minions&r."
		""
		"There are &6five Lord ranks&r. Each one is another Representative task, and each one lets you command more minions."
		""
		"&7Minions collect resources, defend an area, and fight for you. They keep working while you are away.&r"
	]
	quest.17713A94ACBDAFC0.quest_subtitle: "The Lord system, explained"
	quest.17713A94ACBDAFC0.title: "After Fourteen"
	quest.17F16B330090D64A.quest_desc: ["A minion left on a collection order fills a chest while you sleep. This is the closest thing this pack has to automation."]
	quest.17F16B330090D64A.quest_subtitle: "Minion resource collection"
	quest.17F16B330090D64A.title: "Send Them to Work"
	quest.183B16D5D2FE9A6C.quest_desc: ["Headstones and a chapel. Appropriate ground for most of the people on this server."]
	quest.183B16D5D2FE9A6C.quest_subtitle: "Structory"
	quest.183B16D5D2FE9A6C.title: "The Graveyard"
	quest.19452D5C4B1E799F.quest_desc: [
		"&4Beneath the world there is a structure Vampirism calls the Mother.&r"
		""
		"At its heart are the &cRemains&r - a growth that is the origin of every vampire in this world. It is protected, and it does not want to be found."
		""
		"&7Look under the Vampire Forest and the cursed ground around it.&r"
	]
	quest.19452D5C4B1E799F.quest_subtitle: "Find the Mother"
	quest.19452D5C4B1E799F.title: "Something Is Down There"
	quest.1958CFD297090885.quest_subtitle: "If you are in a team, your teammate might get the reward"
	quest.19B6D7CC5B099C48.quest_desc: [
		"A whole separate wine industry: grape vines, a wine press, fermentation barrels and aged bottles with real effects."
		""
		"&7Slow, decorative, and the best thing to build next to a tavern.&r"
	]
	quest.19B6D7CC5B099C48.quest_subtitle: "Let's Do: Vinery"
	quest.19B6D7CC5B099C48.title: "The Vineyard"
	quest.1A18EA441B603753.quest_desc: [
		"Hold it, or keep it as a charm, and a gauge appears."
		""
		"&2The green bar&r is how much toxin is currently in your system. Eating or drinking poisonous things raises it. It falls slowly on its own."
		""
		"&5The purple bar&r is your &6tolerance&r - how much toxin your body can hold. Raising this is the entire progression."
		""
		"&4If green exceeds purple, the skull turns red.&r Detox immediately or you will die."
		""
		"&7Later, the same gauge shows your mutagens and what they have given you.&r"
	]
	quest.1A18EA441B603753.quest_subtitle: "You cannot play this mod without it"
	quest.1A18EA441B603753.title: "The Toxicity Gauge"
	quest.1A91597FAD0170AD.quest_desc: ["Fire school. Vampires should bring something other than their face."]
	quest.1A91597FAD0170AD.quest_subtitle: "Iron's Spellbooks"
	quest.1A91597FAD0170AD.title: "Pyromancer Tower"
	quest.1BFC01D8B0CAF561.quest_desc: ["Most vampires end up building a second, larger pillar arrangement for the last stretch."]
	quest.1BFC01D8B0CAF561.quest_subtitle: "A second altar structure helps here"
	quest.1BFC01D8B0CAF561.title: "Level 11"
	quest.1BFEAFE8E63DEBB0.quest_desc: [
		"&4Destroy the Vulnerable Remains.&r"
		""
		"Every faction has its own name for this:"
		"&c- Vampires&r kill the Mother and take what she was."
		"&b- Hunters&r kill the Mother and end the infection at its source."
		"&6- Werewolves&r call it &lBite the Evil in the Bud&r, which is about right."
		""
		"&7Whatever you are, one of the three advancements below will fire.&r"
	]
	quest.1BFEAFE8E63DEBB0.quest_subtitle: "The oldest thing in this world"
	quest.1BFEAFE8E63DEBB0.title: "Kill the Mother"
	quest.1CD08464FD509610.quest_desc: [
		"Three skulls. Four soul sand. One very bad day for your claim."
		""
		"&4Build it somewhere you do not care about.&r Preferably somewhere your enemies do."
	]
	quest.1CD08464FD509610.quest_subtitle: "The Wither"
	quest.1CD08464FD509610.title: "The Three-Headed Ruin"
	quest.1D351D6F493C5545.quest_desc: ["Beef, pork, mutton, chicken, rabbit, cod, salmon, and the ones you do not want to think about."]
	quest.1D351D6F493C5545.quest_subtitle: "Eat every kind of meat"
	quest.1D351D6F493C5545.title: "Insatiable Beast"
	quest.1DB98916E49FD05C.quest_desc: [
		"&6Vampire's Delight ships a complete bar set.&r Wine shelves in every wood type (including Dark Spruce, Cursed Spruce, Jacaranda and Magic), bar stools in all sixteen colours, cabinets and spirit lanterns."
		""
		"&7Combine it with Macaw's Furniture, Handcrafted and Dawn of Time and you can build a genuinely good-looking inn. On a PvP server, neutral ground is worth more than another chest of diamonds.&r"
	]
	quest.1DB98916E49FD05C.quest_subtitle: "Wine shelves, bar stools, cabinets"
	quest.1DB98916E49FD05C.title: "Open a Tavern"
	quest.1DDEF658C38155CE.quest_desc: [
		"The night is dark and full of things that climb. Build walls that hold."
		""
		"&4This quest consumes the blocks.&r Bring them when you mean it."
		""
		"&7A Building Wand makes the actual construction bearable - that is the reward.&r"
	]
	quest.1DDEF658C38155CE.quest_subtitle: "512 stone bricks, 128 deepslate"
	quest.1DDEF658C38155CE.title: "The Fortress Walls"
	quest.1E0EB0F086044105.quest_desc: [
		"&bTainted Blood is the hunter's dark path.&r Drinking vampire blood gives a human real power - extra health, more damage, more speed - at a price."
		""
		"&cThe cost:&r you start taking sun damage, holy water begins to hurt you, villagers trade worse with you, and food nourishes you less."
		""
		"&4Only hunters of a sufficient Age Rank can use it at all.&r"
	]
	quest.1E0EB0F086044105.quest_subtitle: "Hunters only, and only when old enough"
	quest.1E0EB0F086044105.title: "Tainted Blood"
	quest.1E95099F18CF16B5.quest_desc: ["You cannot hunt vampires without the hat. Everyone knows this."]
	quest.1E95099F18CF16B5.quest_subtitle: "Non-negotiable"
	quest.1E95099F18CF16B5.title: "The Hat"
	quest.1F5DAE6DBFAE3213.quest_desc: ["Drops ice clouds on your head from a distance. Mountain biomes."]
	quest.1F5DAE6DBFAE3213.quest_subtitle: "Friends and Foes"
	quest.1F5DAE6DBFAE3213.title: "Iceologer"
	quest.1FA25599AE0544F5.quest_desc: [
		"&6Every player here ends up as one of three things.&r"
		""
		"&cVampire&r - immortal, fast, and on fire every morning. You drink blood instead of eating. Most damage cannot kill you outright, but sunlight, fire and holy water can."
		""
		"&6Werewolf&r - three transformations, brutal melee, and a permanent allergy to silver. You cannot wear armour in beast form and you eat meat, raw."
		""
		"&bVampire Hunter&r - you stay human. No sun damage, no silver, no blood bar. Instead you get crossbows, holy water, garlic bombs and gear that shreds the other two."
		""
		"&7You can change sides later, but you lose every level you earned. Choose like it is permanent.&r"
	]
	quest.1FA25599AE0544F5.title: "Three Roads"
	quest.1FB32AC58E9BC0D8.quest_desc: [
		"Melee against a werewolf is suicide. Keep them at range."
		""
		"&7Reloading takes real time. Fire, then move - do not stand and reload in the open.&r"
	]
	quest.1FB32AC58E9BC0D8.quest_subtitle: "Musket and cartridges"
	quest.1FB32AC58E9BC0D8.title: "Powder and Lead"
	quest.20158B1469CE99CB.quest_desc: [
		"You wake up with dirt under nails that are no longer nails."
		""
		"&6Continue in the chapter 'Path of the Moon'.&r"
	]
	quest.20158B1469CE99CB.quest_subtitle: "Become a Werewolf"
	quest.20158B1469CE99CB.title: "Lupus Sanguinem"
	quest.20469F6B206730D8.quest_subtitle: "Yes you will also need to become a Hunter Lord, or have someone on your team become one"
	quest.20469F6B206730D8.title: "Vampiric Lord"
	quest.213E933467B1D968.quest_desc: [
		"&4Hold to cast a ray of necrotic energy.&r It damages what it hits and heals you for &a100% of the damage dealt&r."
		""
		"The in-game description says it plainly: &7creatures of the night have twisted this spell to sate their hunger.&r"
		""
		"&6For a vampire this is a second blood supply that works at range.&r For anyone else it is still one of the best sustain spells in the game."
	]
	quest.213E933467B1D968.quest_subtitle: "The spell this server rewrote"
	quest.213E933467B1D968.title: "Ray of Siphoning"
	quest.21AA04DAC8BDEC80.quest_desc: [
		"&4Blood magic&r costs you health to cast and gives it back with interest. It is the school that fits everything this server is about."
		""
		"&7Blood scrolls drop from undead and from magic structures. Get one and inscribe it.&r"
	]
	quest.21AA04DAC8BDEC80.quest_subtitle: "Your school"
	quest.21AA04DAC8BDEC80.title: "The Blood School"
	quest.21E8CD45722721FE.quest_desc: [
		"When a vampire runs out of health they usually do not die - they collapse into &cDBNO&r. You cannot move or act, but you slowly recover and can resurrect yourself."
		""
		"On resurrection your remaining blood becomes health, and you get a short window where you &lcannot&r go into DBNO again."
		""
		"&4Holy water, fire and a hunter's stake ignore all of this and kill you outright.&r"
	]
	quest.21E8CD45722721FE.quest_subtitle: "Get back up"
	quest.21E8CD45722721FE.title: "Down But Not Out"
	quest.22B0F6F3AD16197C.quest_desc: [
		"Craft a &fPurity Injection&r and use it at an &bInjection Chair&r."
		""
		"You lose the bloodline, its skills and its rank. You stay a vampire."
		""
		"&7Do this if you picked Zealot and then decided you like the sun after all.&r"
	]
	quest.22B0F6F3AD16197C.quest_subtitle: "Leaving a bloodline"
	quest.22B0F6F3AD16197C.title: "Purity"
	quest.22B3850C9DD539BD.quest_desc: ["Nothing in this world cares that you are new. Get a weapon in your hand before the sun goes down."]
	quest.22B3850C9DD539BD.quest_subtitle: "Wood, then stone. You know the drill."
	quest.22B3850C9DD539BD.title: "Something to Swing"
	quest.23275CA5B70B10AB.quest_desc: ["The end of the journal. Whatever that chemist was looking for, this is what he became."]
	quest.23275CA5B70B10AB.quest_subtitle: "The netherite tier"
	quest.23275CA5B70B10AB.title: "Plaguebringer"
	quest.235C315B7D09BA85.title: "Kill 100x Beast Werewolves"
	quest.240B5EBAFAEB01AD.quest_desc: ["Whatever faction you are, the pack leader is worth killing once."]
	quest.240B5EBAFAEB01AD.quest_subtitle: "Kill an Alpha Werewolf"
	quest.240B5EBAFAEB01AD.title: "The Alpha"
	quest.2452F8D0F8659CBF.quest_desc: [
		"&6Three things gate every werewolf level:&r"
		""
		"&e1. Items.&r Livers and Cracked Bones, more of each per level."
		"&e2. Prey.&r You must have killed creatures worth a certain total. The game counts the &lsum of the max health&r of everything you have slain. Check your progress in the Vampirism menu, or by interacting with a lit Fire Bowl."
		"&e3. Night.&r &4The ritual only works after dark.&r"
		""
		"Put the items in the altar, then click the altar with an &6empty hand&r or with a torch to start it."
		""
		"&7Common error messages:&r"
		"&8- 'Missing Structures' - you do not have four fire bowls in range.&r"
		"&8- 'The structures are not burning' - light them.&r"
		"&8- 'You need to snatch more prey' - go kill things.&r"
		"&8- 'The ritual is only working at night' - wait.&r"
	]
	quest.2452F8D0F8659CBF.quest_subtitle: "Information - how to actually level up"
	quest.2452F8D0F8659CBF.title: "The Ritual"
	quest.24F30BF0138D3CC6.quest_desc: [
		"Three Wroughtnauts. The chambers regenerate faster than you would think."
		""
		"&8Cooldown: one hour.&r"
	]
	quest.24F30BF0138D3CC6.quest_subtitle: "Repeatable"
	quest.24F30BF0138D3CC6.title: "Trophy Hunt"
	quest.2587B9244AC1E6B9.quest_desc: [
		"Trainers live in ordinary villages. Garlic grows behind the house, and the &bInjection Chair&r is inside."
		""
		"&aHe trains you for levels 2, 3 and 4.&r After that you need research, and he starts charging."
		""
		"&7There are also Hunter Camps and Hunter Outposts out in the world with trainers in them.&r"
	]
	quest.2587B9244AC1E6B9.quest_subtitle: "Observe a Vampire Hunter Trainer"
	quest.2587B9244AC1E6B9.title: "Find the Trainer"
	quest.260DD93B9BC9DA6A.quest_desc: [
		"&bRoasted Garlic&r and &bGarlic Soup&r."
		""
		"Perfectly ordinary food for a human. &cFor a vampire it is a weapon.&r Leaving a bowl of garlic soup in a shared base is a statement."
	]
	quest.260DD93B9BC9DA6A.quest_subtitle: "Hunters only, effectively"
	quest.260DD93B9BC9DA6A.title: "Garlic Cooking"
	quest.2619A4C1B3EEA95A.quest_subtitle: "Somehow you complete all of the secret quests"
	quest.2619A4C1B3EEA95A.title: "Did you really do it?"
	quest.263BD0F66B9B59EC.quest_subtitle: "Nice bed, isn't it?"
	quest.263BD0F66B9B59EC.title: "Ok, Don't sleep."
	quest.26BB89713088C47F.quest_desc: [
		"&6You woke up somewhere you do not belong.&r"
		""
		"This world is split between three powers. &cVampires&r rule the dark and burn in daylight. &6Werewolves&r run in packs and answer to the moon. &bVampire Hunters&r stay human, and make that a weapon."
		""
		"You are none of them yet. You are food."
		""
		"This chapter gets you through your first nights alive. After that, the book will ask you to choose. &7Take your time here - the choice is hard to undo.&r"
		""
		"&8Tip: quests with a gear icon are pure information. Click them, read them, tick them off.&r"
	]
	quest.26BB89713088C47F.quest_subtitle: "Read this first"
	quest.26BB89713088C47F.title: "Welcome to the Long Night"
	quest.26D486D96634B54C.quest_subtitle: "If you are in a team, your teammate might get the reward"
	quest.26FB630CE298510C.quest_desc: [
		"One naturally poisonous plant, one poison ingredient that is not a plant, and some bone meal. Ground in the mortar."
		""
		"&7Weak, but it is the base of literally everything else in this chapter.&r"
	]
	quest.26FB630CE298510C.quest_subtitle: "The foundational substance"
	quest.26FB630CE298510C.title: "Poison Paste"
	quest.27740791B5228DB6.quest_desc: [
		"Needs both the &6Alembic&r and its &6Base&r."
		""
		"It upgrades weak potions into strong ones without extra ingredients, and - more importantly - it is how you produce &6affinity solutions&r."
	]
	quest.27740791B5228DB6.quest_subtitle: "Purifies liquids the way the crucible purifies solids"
	quest.27740791B5228DB6.title: "The Alembic"
	quest.28E93D2BCCE8BE1A.quest_desc: ["Bats are food now. There is a taco."]
	quest.28E93D2BCCE8BE1A.quest_subtitle: "Raw Bat, Cooked Bat, Bat Taco"
	quest.28E93D2BCCE8BE1A.title: "Bat Chops"
	quest.29B61D48172E2E17.quest_desc: [
		"The Frostmaw sleeps in the mountains until you take what it is guarding."
		""
		"&bIts breath freezes you in place while the claws do the rest.&r"
		""
		"&7Fire resistance will not save you here. Movement will.&r"
	]
	quest.29B61D48172E2E17.quest_subtitle: "Frostmaw"
	quest.29B61D48172E2E17.title: "The Beast of Ice"
	quest.29EFBE87F993074C.quest_desc: ["A furnace cooks in bulk. The crucible cooks one item hot enough to change what it is."]
	quest.29EFBE87F993074C.quest_subtitle: "Heat one thing, properly"
	quest.29EFBE87F993074C.title: "Copper Crucible"
	quest.2A0AB721BEEE0998.quest_desc: ["Place a Blood Sieve under the Grinder and a Blood Container under the Sieve. Impure blood goes in, drinkable blood comes out."]
	quest.2A0AB721BEEE0998.quest_subtitle: "Impure blood into usable blood"
	quest.2A0AB721BEEE0998.title: "The Sieve"
	quest.2A6A69EA431B3A92.quest_desc: ["Ordinary garlic, concentrated. The core of every diffuser."]
	quest.2A6A69EA431B3A92.quest_subtitle: "Refined at the Alchemical Cauldron"
	quest.2A6A69EA431B3A92.title: "Purified Garlic"
	quest.2A9982C75563B102.quest_desc: [
		"A scroll casts its spell once and is consumed. Inscribe it into a book instead and you can cast it as often as your mana allows."
		""
		"&7Scrolls drop from magic mobs and generate in magic structures.&r"
	]
	quest.2A9982C75563B102.quest_subtitle: "Single-use, until you inscribe them"
	quest.2A9982C75563B102.title: "Scrolls"
	quest.2AAE83F6A43780BD.quest_desc: ["The vanilla 5x5 room with a spawner is gone. These are proper multi-room dungeons with themed variants: zombie, skeleton and spider."]
	quest.2AAE83F6A43780BD.quest_subtitle: "Yung's Better Dungeons"
	quest.2AAE83F6A43780BD.title: "Better Dungeons"
	quest.2B1E048F7B470094.quest_desc: [
		"Feeds from an &6Arrow Clip&r instead of your inventory. Right-click a clip with arrows to load it."
		""
		"&7This is the closest thing this pack has to a machine gun.&r"
	]
	quest.2B1E048F7B470094.quest_subtitle: "Van Helsing would approve"
	quest.2B1E048F7B470094.title: "Semi-Auto Crossbow"
	quest.2B4F427A227FFE53.quest_desc: ["No longer forced into werewolf form at full moon. Worth taking early if you play in public."]
	quest.2B4F427A227FFE53.quest_subtitle: "Unlock the skill"
	quest.2B4F427A227FFE53.title: "Free Will"
	quest.2B85248945D23D74.quest_desc: [
		"&6The maximum Age Rank.&r"
		""
		"You have survived long enough that the world has adjusted around you. There is very little left in this pack that can be called a threat."
		""
		"&8Do not get careless. Depending on the config, death can reset your ageing progress.&r"
	]
	quest.2B85248945D23D74.quest_subtitle: "Ancient"
	quest.2B85248945D23D74.title: "Age Rank 5"
	quest.2BA69E1CE4EA8102.quest_subtitle: "Die 100 times"
	quest.2BA69E1CE4EA8102.title: "Having a difficult time?"
	quest.2BEC7CC66083963B.quest_desc: [
		"From level 4 you can infect. Sneak up behind a target, look directly at their back, and use the infect action from the skill wheel."
		""
		"&7Infected villagers become Vampire Villagers. Infected players become your problem, or your coven.&r"
	]
	quest.2BEC7CC66083963B.quest_subtitle: "Infect a creature or a player"
	quest.2BEC7CC66083963B.title: "Spread It"
	quest.2CA4006365EFA8C7.title: "Kill 1000x Beast Werewolves"
	quest.2D3EC64E79484FE6.quest_desc: ["Five Representative tasks completed. Nobody drinks in this region without your permission."]
	quest.2D3EC64E79484FE6.quest_subtitle: "Vampire Lord rank 5"
	quest.2D3EC64E79484FE6.title: "Master of the Coven"
	quest.2D769020B7F19B4F.quest_desc: ["Pelts come in three grades: &7ordinary&r, &8dark&r and &fwhite&r. White is the rarest and the best."]
	quest.2D769020B7F19B4F.quest_subtitle: "Obtain a werewolf pelt"
	quest.2D769020B7F19B4F.title: "Hairy Situation"
	quest.2DCC779E7A8BF9B7.quest_desc: [
		"On a full moon you transform whether you want to or not."
		""
		"&7The skill &6Free Will&7 removes that. Until you have it, plan your full moons: do not be standing in a village square when it happens.&r"
	]
	quest.2DCC779E7A8BF9B7.quest_subtitle: "Transform during a full moon"
	quest.2DCC779E7A8BF9B7.title: "Bad Moon Rising"
	quest.2DE973F622403FED.quest_desc: [
		"&6Two sources:&r"
		""
		"&e1.&r Kill a Vampire with a &cHeartseeker&r or &cHeartstriker&r. Only those weapons produce samples."
		"&e2.&r Loot the chests inside a &cVampire Crypt&r."
		""
		"&7Bloodknight, Noble and Gravebound all run on these. Stockpile.&r"
	]
	quest.2DE973F622403FED.quest_subtitle: "The ingredient three bloodlines need"
	quest.2DE973F622403FED.title: "Corrupted Blood Samples"
	quest.2E1EE3C5CEDEFDBE.quest_desc: [
		"He shapes the arena. You fight on his terms or not at all."
		""
		"&7Find the monastery, accept the challenge, and survive what he builds around you.&r"
	]
	quest.2E1EE3C5CEDEFDBE.quest_subtitle: "The monastery challenge"
	quest.2E1EE3C5CEDEFDBE.title: "The Sculptor"
	quest.2EAF1710BE06BCDD.quest_desc: [
		"Sleep is not neutral in this world."
		""
		"&6- If a werewolf has scratched you&r, you carry &6Lupus Sanguinem&r. It turns you the moment you wake up. Drink milk before you sleep if you do not want that."
		"&c- If a vampire has bitten you&r, you carry &cSanguinare Vampiris&r. That one runs on a timer, about one Minecraft day, and sleeping will not save you. Milk cancels it."
		"&c- Once you are a vampire&r, a normal bed will not work for you at all. You will need a &cCoffin&r."
		""
		"&7Both infections are also curable by talking to a Hunter Trainer, before they finish.&r"
	]
	quest.2EAF1710BE06BCDD.quest_subtitle: "Information"
	quest.2EAF1710BE06BCDD.title: "Careful How You Sleep"
	quest.2EDC86B80EE1D4D3.quest_desc: [
		"It is not the point of this server, but it is still sitting there."
		""
		"&7Yung's Better End Island has rebuilt the arena. It is a better fight than it used to be.&r"
	]
	quest.2EDC86B80EE1D4D3.quest_subtitle: "The old ending"
	quest.2EDC86B80EE1D4D3.title: "The Ender Dragon"
	quest.2F1688336F22F3BA.quest_desc: ["A cup that never quite empties. Requires the Bottomless Chalice bloodline skill to use."]
	quest.2F1688336F22F3BA.quest_subtitle: "Bloodknight skill item"
	quest.2F1688336F22F3BA.title: "Bottomless Chalice"
	quest.2F55CA5F2AB8EB9D.quest_desc: [
		"&bYou age by hunting the enemy factions&r - vampires and werewolves."
		""
		"Kills are scored as &6petty&r, &6common&r or &6greater&r hunts depending on what you killed. A Vampire Baron is worth a great deal more than a basic Vampire."
		""
		"&6Where to check your progress:&r interact with an &bInjection Chair&r."
	]
	quest.2F55CA5F2AB8EB9D.quest_subtitle: "How a hunter ages"
	quest.2F55CA5F2AB8EB9D.title: "Hunters: Hunt the Supernatural"
	quest.2F9A36B0B5D4C85B.quest_desc: [
		"Proximity voice is installed. Press &6V&r to open the voice settings and pick your microphone."
		""
		"&7You can hear people before you can see them. So can they.&r"
	]
	quest.2F9A36B0B5D4C85B.quest_subtitle: "Information - Simple Voice Chat"
	quest.2F9A36B0B5D4C85B.title: "Speak and Be Heard"
	quest.3045EB54CC8A5FA1.quest_desc: [
		"Blood Wine is the best drinkable blood source in the pack and it looks the part on a shelf."
		""
		"&7Pour it into a Blood Wine Glass to serve. There is a Mulled Wine variant for the winter.&r"
	]
	quest.3045EB54CC8A5FA1.quest_subtitle: "Cellar something worth drinking"
	quest.3045EB54CC8A5FA1.title: "Blood Wine"
	quest.305E9026C148D342.quest_desc: ["Same job as a Stove, built from Dark Stone. If you are building a crypt, build the kitchen to match."]
	quest.305E9026C148D342.quest_subtitle: "The vampire kitchen"
	quest.305E9026C148D342.title: "Dark Stone Stove"
	quest.30628F488943F7F6.title: "Ready To Store Safely"
	quest.3149FE18CF8F82CA.quest_subtitle: "Quite the series of achievements"
	quest.3149FE18CF8F82CA.title: "I am Dracula"
	quest.31AC31BB842BE3F8.quest_desc: ["You know the story."]
	quest.31AC31BB842BE3F8.quest_subtitle: "Where is your brick house now?"
	quest.31AC31BB842BE3F8.title: "Little Pigs"
	quest.31AD0824A2957B22.quest_desc: [
		"Poison paste and honeycomb, ground in the mortar, collected into an oil pot."
		""
		"&6To apply:&r hold the oil pot in one hand and the weapon in the other, then use the pot. Or place the pot down and crouch-click your weapon on it."
		""
		"&7Oils dry out. Re-coat before a fight, not during one.&r"
	]
	quest.31AD0824A2957B22.quest_subtitle: "Your first weapon coating"
	quest.31AD0824A2957B22.title: "Poison Oil"
	quest.323E54491BF75DEC.quest_desc: ["By now you should have picked your form and be leaning into it."]
	quest.323E54491BF75DEC.quest_subtitle: "Halfway"
	quest.323E54491BF75DEC.title: "Level 7"
	quest.328A7B114CFBBC64.title: "Christopher Columbus"
	quest.328A9288CBFFE4A1.quest_desc: [
		"The End is not the flat void it used to be. Unusual End adds Enderblobs, Draglings, Endstone Golems, Enderlings and a whole ecology."
		""
		"&7Yung's Better End Island rebuilds the central island as well.&r"
	]
	quest.328A9288CBFFE4A1.quest_subtitle: "Unusual End and Yung's Better End Island"
	quest.328A9288CBFFE4A1.title: "The End"
	quest.32EF0E109AB97B0C.quest_desc: ["More durability, less panic."]
	quest.32EF0E109AB97B0C.quest_subtitle: "Diamond or Netherite Umbrella"
	quest.32EF0E109AB97B0C.title: "A Better Shade"
	quest.33526BA747B0C482.quest_subtitle: "Yes you will also need to become a Vampire Lord, or have someone on your team become one"
	quest.33526BA747B0C482.title: "Lord Hunter"
	quest.33ADB766252C2A94.quest_subtitle: "Are you a dropper?"
	quest.33ADB766252C2A94.title: "Why are you dropping so much?"
	quest.33B2CB4DF7F786B7.quest_desc: ["The last grade of ink. Everything you inscribe with it is as strong as that spell can be."]
	quest.33B2CB4DF7F786B7.quest_subtitle: "Maximum spell level"
	quest.33B2CB4DF7F786B7.title: "Legendary Ink"
	quest.33FD408A91B71C29.quest_desc: ["Wolf Berry bushes grow in Werewolf Forests. The berries also bake into cookies and ice cream if you have Vampire's Delight installed - and you do."]
	quest.33FD408A91B71C29.quest_subtitle: "They grow on bushes in werewolf country"
	quest.33FD408A91B71C29.title: "Wolf Berries"
	quest.34660A5199ED80AD.quest_desc: [
		"Vampire Books are a ritual component for the higher infusion levels. Look in Vampire Huts, Crypts and other cursed structures."
		""
		"&7Advanced Vampires also drop them.&r"
	]
	quest.34660A5199ED80AD.quest_subtitle: "Find a Vampire Book"
	quest.34660A5199ED80AD.title: "Vampire Diaries"
	quest.34CDEA652B7F5A22.quest_desc: ["Darker fur, better numbers."]
	quest.34CDEA652B7F5A22.quest_subtitle: "The middle tier"
	quest.34CDEA652B7F5A22.title: "Dark Pelt Armour"
	quest.351708B99B388CEB.quest_desc: [
		"&6Level 14 is not the end.&r"
		""
		"Find a &bHunter Representative&r in a hunter-aligned village. At max level he offers you a special task. Complete it and you become a &bHunter Lord&r, with the right to recruit hunter NPCs."
		""
		"&7Continue in the chapter &6Lords and Minions&7, then look at &cThe Long Years&7.&r"
	]
	quest.351708B99B388CEB.quest_subtitle: "Continue in 'Lords and Minions'"
	quest.351708B99B388CEB.title: "Take Command"
	quest.359027887B251F0A.quest_desc: ["End ships that fly on their own, in normal and warped varieties. Elytra are in there, if you can board one."]
	quest.359027887B251F0A.quest_subtitle: "Unusual End"
	quest.359027887B251F0A.title: "Flying End Ship"
	quest.35A8537EBE00AF11.quest_desc: [
		"&6Sunscreen is a vampire action, unlocked in the skill tree.&r Activate it from the skill wheel and you get temporary protection from the sun."
		""
		"&7Useful when both hands are busy and you cannot hold an umbrella. It is on a cooldown, so it is a get-out-of-trouble button, not a lifestyle.&r"
	]
	quest.35A8537EBE00AF11.quest_subtitle: "A skill, not an item"
	quest.35A8537EBE00AF11.title: "Sunscreen"
	quest.35F7C998C56C5FA4.quest_desc: ["Enormous, biome-themed, and full of things that were not there in vanilla. There is a variant for almost every biome."]
	quest.35F7C998C56C5FA4.quest_subtitle: "Yung's Better Mineshafts"
	quest.35F7C998C56C5FA4.title: "Better Mineshafts"
	quest.3620C31AD07BFC12.quest_subtitle: "You are very hard to kill"
	quest.3620C31AD07BFC12.title: "Invincible"
	quest.364C2D6FDA5AA222.quest_desc: ["The first step past maximum level. Small bonuses, and proof the system is running."]
	quest.364C2D6FDA5AA222.quest_subtitle: "The first rank"
	quest.364C2D6FDA5AA222.title: "Age Rank 1"
	quest.3659E8989641ECFC.title: "Kill 50x Beast Werewolves"
	quest.38B51F6177CA1CCC.quest_desc: ["Long reach. Cheap. Extremely on-theme."]
	quest.38B51F6177CA1CCC.quest_subtitle: "For the angry mob aesthetic"
	quest.38B51F6177CA1CCC.title: "Pitchfork"
	quest.38E53DA103B90B57.quest_desc: ["The core of the thing that started all of this. It is a crafting component, which is somehow the most disrespectful possible outcome."]
	quest.38E53DA103B90B57.quest_subtitle: "What was inside"
	quest.38E53DA103B90B57.title: "The Mother Core"
	quest.38EF26EF9FE30E51.quest_desc: [
		"&6A lone wolf dies. A nation survives.&r"
		""
		"&6/team create <name>&r, then &6/team invite <player>&r. Open the map with &6M&r and claim ten chunks."
		""
		"&7Team members share claims and can share quest rewards.&r"
	]
	quest.38EF26EF9FE30E51.quest_subtitle: "A team and ten chunks"
	quest.38EF26EF9FE30E51.title: "Laying the Foundation"
	quest.395F6390A67B6D40.quest_desc: ["Standard bolts. Cheap in bulk. Keep a stack on you."]
	quest.395F6390A67B6D40.quest_subtitle: "Ordinary ammunition"
	quest.395F6390A67B6D40.title: "Quarrels"
	quest.399CB0E3E92C2A65.quest_desc: [
		"&6Level 14 is where most players think the game ends. It does not.&r"
		""
		"From maximum level onward you begin to &6age&r. There are &6six Age Ranks (0 to 5)&r, and every rank makes you measurably stronger: more max health, faster movement, less sun damage, less fire damage, better trade prices, and new actions."
		""
		"&7Actions unlocked by age include &6Blood Tap&7, &6Celerity&7, &6Water Walking&7, &6Auto Step-Up&7 and, for hunters, a limited &6Bat Mode&7 and a &6Teleport&7.&r"
		""
		"&4Every faction ages differently.&r Read your own path below."
		""
		"&8Ageing can also gate Lord ranks - on some configurations you need a minimum Age Rank before the Representative will promote you.&r"
	]
	quest.399CB0E3E92C2A65.quest_subtitle: "Ageing starts at faction level 14"
	quest.399CB0E3E92C2A65.title: "Time Makes Monsters"
	quest.3A1B2B871C623C6C.quest_desc: [
		"&6Heavy armour slows a vampire down.&r Anything stronger than leather cuts into your speed and attack speed bonuses."
		""
		"Vampire Clothing is enchantable, weightless in that sense, and stacks properly with your natural armour."
	]
	quest.3A1B2B871C623C6C.quest_subtitle: "Vampire Clothing"
	quest.3A1B2B871C623C6C.title: "Dress the Part"
	quest.3A22FD36227B861F.quest_desc: ["Stores a fixed sequence of bolts. Carry two, loaded differently, for different problems."]
	quest.3A22FD36227B861F.quest_subtitle: "Reload in one action"
	quest.3A22FD36227B861F.title: "Bolt Cartridge"
	quest.3A327DB29877A703.quest_desc: [
		"&6You are max level, you are a Lord, and you have run out of altars.&r"
		""
		"What is left is the small number of things in this world that can still kill you, and one very old thing sleeping under the Vampire Forest."
		""
		"&7Everything in this chapter is a fight. Most of them are easier with a team, and this is a PvP server, so finding a team is its own quest.&r"
		""
		"&8Finish this chapter and the book is done. What you do after that is between you and the other players.&r"
	]
	quest.3A327DB29877A703.quest_subtitle: "The end of the book"
	quest.3A327DB29877A703.title: "Nothing Left to Level"
	quest.3A48F153D445F13C.quest_desc: [
		"The Hunter Table turns strange items into &bHunter Intel&r. Put material in, investigate it, and you learn something about vampires that a trainer will accept as payment."
		""
		"&6The table upgrades itself from the blocks placed directly next to it:&r"
		"&e- Alchemical Cauldron&r"
		"&e- Potion Table&r"
		"&e- Weapon Table&r"
		""
		"&4You need all three adjacent to reach the maximum level.&r If the table says 'structure incomplete for your level', that is what is missing."
	]
	quest.3A48F153D445F13C.quest_subtitle: "Research, levels 5 to 14"
	quest.3A48F153D445F13C.title: "The Hunter Table"
	quest.3A614D1DD1168DD7.quest_desc: ["&8Nobody is going to make you eat these. They are on the menu regardless.&r"]
	quest.3A614D1DD1168DD7.quest_subtitle: "Human Eye, Heart Pieces, Eye Croissant"
	quest.3A614D1DD1168DD7.title: "Eyes On Stick"
	quest.3A6FE0F6D1E5DEEB.quest_desc: ["Holds up to six items and cooks them without fuel waste. It also heats a Cooking Pot on top."]
	quest.3A6FE0F6D1E5DEEB.quest_subtitle: "Cook without burning your kitchen down"
	quest.3A6FE0F6D1E5DEEB.title: "The Stove"
	quest.3A824C45D5B2230D.quest_desc: [
		"&6This is the wall most new vampires hit. Read it properly.&r"
		""
		"&e1.&r Place the &cAltar of Infusion&r."
		"&e2.&r Place &cAltar Pillars&r around it. Each pillar must be &l2 or 3 blocks high&r."
		"&e3.&r Right-click a pillar with a block to fill it. Every block in one pillar must be the same material."
		"&e4.&r Put an &cAltar Tip&r on top of each pillar."
		""
		"Each pillar is worth &6height x material value&r in structure points. Stone bricks are cheap, iron blocks are better, gold blocks are better still."
		""
		"&e5.&r Put the ritual items in the altar, right-click with an &6empty hand&r, &4at night&r, and wait."
		""
		"&7If it says 'structure wrong': build more pillars, or fill the ones you have with better blocks.&r"
	]
	quest.3A824C45D5B2230D.quest_subtitle: "Levels 5 to 14 - build the multiblock"
	quest.3A824C45D5B2230D.title: "Altar of Infusion"
	quest.3A850F4F27F8890A.quest_desc: [
		"Red grass, dark spruce, permanent gloom. Vampires regenerate here and hunters do not."
		""
		"&7This is where Barons live, where Dark Stone comes from, and where you should build if you are serious.&r"
	]
	quest.3A850F4F27F8890A.quest_subtitle: "Home ground"
	quest.3A850F4F27F8890A.title: "The Vampire Forest"
	quest.3AD00D4C718B6845.quest_desc: [
		"Build all three and place them adjacent to the Hunter Table."
		""
		"&7The Alchemical Cauldron and the Potion Table are useful in their own right - the Potion Table is a brewing stand with a skill tree behind it.&r"
	]
	quest.3AD00D4C718B6845.quest_subtitle: "All three blocks, right next to it"
	quest.3AD00D4C718B6845.title: "Upgrade the Table"
	quest.3B481F13CFD236D9.quest_desc: [
		"A full outfit from a bygone age, made of toxic leather."
		""
		"&aWhen you are afflicted by a hazardous effect - slowness, blindness and their friends - the effect lasts noticeably less time.&r The more of the set you wear, the bigger the reduction."
		""
		"&7The &6Plaguebringer&7 set is the netherite-tier upgrade.&r"
	]
	quest.3B481F13CFD236D9.quest_subtitle: "Coat, leggings, boots, hood"
	quest.3B481F13CFD236D9.title: "The Plague Doctor"
	quest.3B5189B9D00646C7.quest_desc: [
		"Prey is measured in total max health, so a few big mobs beat a lot of chickens."
		""
		"&7Ravagers, Iron Golems, Wardens and boss mobs are extremely efficient here.&r"
	]
	quest.3B5189B9D00646C7.quest_subtitle: "Kill things. A lot of things."
	quest.3B5189B9D00646C7.title: "Snatch More Prey"
	quest.3B73C3DDB9D72D67.quest_desc: [
		"&2Toxony is an entire alchemy mod hiding in this pack, and almost nobody finds it.&r"
		""
		"It has its own in-game journal, written by a chemist who was thrown out of an academy and took it badly. Follow it and you end up with weapon oils, a repeating crossbow, refillable potion flasks, plague doctor armour - and &6mutagens&r."
		""
		"&6Mutagens&r are permanent body modifications earned by surviving poison. There are six, and they stack with being a vampire, werewolf or hunter."
		""
		"&4The catch: everything here runs on putting toxins into your own body.&r Exceed your tolerance and you start dying."
		""
		"&7Keep a golden apple or a regeneration potion nearby for the whole chapter.&r"
	]
	quest.3B73C3DDB9D72D67.quest_subtitle: "Open to every faction"
	quest.3B73C3DDB9D72D67.title: "They Called It Madness"
	quest.3C010FEAB87D10D9.quest_desc: ["Small tented camps scattered across the world, with trainers and hunters in them. Safe ground for you, a death trap for a vampire."]
	quest.3C010FEAB87D10D9.quest_subtitle: "Find a Hunter Camp"
	quest.3C010FEAB87D10D9.title: "Hunter Camps"
	quest.3C2094B8E5F0AB76.quest_desc: [
		"&6Fatigue Oil&r - from Water Hemlock. Slows and staggers."
		"&6Glowing Oil&r - marks a target through walls. Excellent in PvP."
		"&6Fire Resistance Oil&r - applied to an ally rather than an enemy."
		"&6Mending Oil&r - repairs tools without XP."
	]
	quest.3C2094B8E5F0AB76.quest_subtitle: "Fatigue, Glowing, Fire Resistance, Mending"
	quest.3C2094B8E5F0AB76.title: "The Oil Rack"
	quest.3C4C2C0C0E2ACF52.quest_desc: [
		"&6Level 14 is not the end.&r"
		""
		"Find a &cVampire Representative&r in a vampire-aligned village. At max level he offers you a special task. Complete it and you become a &cVampire Lord&r, with the right to bind minions."
		""
		"&7Continue in the chapter &6Lords and Minions&7. Then look at &cBloodlines&7 and &cThe Long Years&7 - both of them only open up once you are here.&r"
	]
	quest.3C4C2C0C0E2ACF52.quest_subtitle: "Continue in 'Lords and Minions'"
	quest.3C4C2C0C0E2ACF52.title: "Become a Lord"
	quest.3C8C4F69C036D62A.quest_desc: ["Ritual fuel. You will burn through a lot of these on the way to 14."]
	quest.3C8C4F69C036D62A.quest_subtitle: "Dropped by werewolves and villagers"
	quest.3C8C4F69C036D62A.title: "Liver"
	quest.3CD590A6DAB90351.quest_desc: ["Hang a captured creature on it and drain it slowly. Cruel, effective, and excellent decor."]
	quest.3CD590A6DAB90351.quest_subtitle: "Vampire Rack"
	quest.3CD590A6DAB90351.title: "The Rack"
	quest.3E86BD82E38D3513.quest_desc: [
		"&6You are as strong as a vampire gets without becoming a Lord.&r"
		""
		"&7Now go find a Vampire Representative in a vampire-aligned village. He has a special task for you, and it ends with the title of Lord.&r"
	]
	quest.3E86BD82E38D3513.quest_subtitle: "Maximum vampire level"
	quest.3E86BD82E38D3513.title: "Level 14"
	quest.3EED04F938D10827.quest_desc: ["The centrepiece structure of the new Nether. There are Catacombs and Piglin Manors too."]
	quest.3EED04F938D10827.quest_subtitle: "Eternal Nether"
	quest.3EED04F938D10827.title: "Nether Citadel"
	quest.3FCE323E1D0D40AE.quest_desc: [
		"Garlic is your ammunition, your area denial and your medicine. You will never have enough."
		""
		"&7Replant what you take. Later you will want stacks of it for diffusers and bombs.&r"
	]
	quest.3FCE323E1D0D40AE.quest_subtitle: "Grow your own supply"
	quest.3FCE323E1D0D40AE.title: "A Field of Garlic"
	quest.3FE88DF48EA67482.quest_desc: ["Expensive, and worth it."]
	quest.3FE88DF48EA67482.quest_subtitle: "Best armour a human gets"
	quest.3FE88DF48EA67482.title: "Ultimate Hunter Coat"
	quest.4002B72242A06B42.quest_desc: [
		"&6Complete the Representative's special task at werewolf level 14.&r"
		""
		"The five ranks are &6Epsilon, Delta, Gamma, Beta&r and &6Alpha&r."
		""
		"&7Werewolf Lord levelling also consumes Werewolf Teeth. Start collecting them early.&r"
	]
	quest.4002B72242A06B42.quest_subtitle: "Lord rank 1 - Epsilon"
	quest.4002B72242A06B42.title: "Werewolf Lord"
	quest.40274FA0CADCD7AA.quest_desc: [
		"&bThree steps:&r"
		""
		"&61.&r Find a village with a &bVampire Hunter Trainer&r. Garlic grows behind his house."
		"&62.&r Craft a &bSyringe&r, then a &bGarlic Injection&r from it."
		"&63.&r Go inside the trainer's house and use the &bInjection Chair&r with the injection in hand."
		""
		"The garlic in your blood makes you permanently immune to Sanguinare Vampiris. You are now a Hunter, level 1."
		""
		"&7This is the only path you can walk into deliberately, without waiting for a mob to hit you.&r"
	]
	quest.40274FA0CADCD7AA.quest_subtitle: "Becoming a Hunter"
	quest.40274FA0CADCD7AA.title: "How to Take the Vaccine"
	quest.4093B20A86122069.quest_desc: ["The best generally craftable book. If you are still casting from copper at this point, something has gone wrong."]
	quest.4093B20A86122069.quest_subtitle: "Twelve slots"
	quest.4093B20A86122069.title: "Netherite Spell Book"
	quest.40A096397FFF4153.quest_desc: [
		"&6Terralith, Continents, Structory, Towns and Towers, Yung's rewrites of every vanilla structure, Dungeon Crawl, Sky Villages, Medieval Buildings.&r"
		""
		"There is more out there than the factions. Most of the good gear in this pack is loot, not crafting."
		""
		"&7Lootr is installed: every player gets their own copy of a chest's contents. Nobody can loot a dungeon before you.&r"
		""
		"&8Nothing in this chapter is required. All of it is worth doing.&r"
	]
	quest.40A096397FFF4153.quest_subtitle: "Open to every faction"
	quest.40A096397FFF4153.title: "The World Is Not Vanilla"
	quest.40CEE674BF0A7AA0.quest_desc: [
		"&cYour heart has stopped and you are still standing.&r"
		""
		"From here on: villagers are food, the sun is a countdown, and every hunter in this world has a stake with your name on it."
		""
		"&6This chapter is your whole career.&r Left side keeps you fed and out of the sun. The middle column is your level ladder. The right side is gear."
		""
		"&7Press the Vampirism menu key to see your blood bar, your skills and your level progress.&r"
	]
	quest.40CEE674BF0A7AA0.quest_subtitle: "You are a Vampire, level 1"
	quest.40CEE674BF0A7AA0.title: "Sanguinare Vampiris"
	quest.40D2E623C4B9CF22.quest_desc: ["The first infusion ritual. From here every level costs more structure points, more blood, more hearts and purer blood."]
	quest.40D2E623C4B9CF22.quest_subtitle: "Stone brick pillars are enough for this one"
	quest.40D2E623C4B9CF22.title: "Level 5"
	quest.40DECAC12B77BB84.quest_desc: ["Green, black and oolong tea, hibiscus, lavender, coffee. Brewed in a kettle, served in a jug. Every brew has its own buff."]
	quest.40DECAC12B77BB84.quest_subtitle: "Let's Do: Herbal Brews"
	quest.40DECAC12B77BB84.title: "Tea and Coffee"
	quest.40F8DE1A8D296380.quest_desc: [
		"&cYou are a vampire. You are also, so far, a generic one.&r"
		""
		"A &6Bloodline&r is a permanent specialisation with its own skill tree, its own powers and its own new weaknesses. There are five, and you can only ever be one at a time."
		""
		"&f- Noble&r - almost human. Better trades, sun tolerance, mesmerise villagers, teleport behind enemies."
		"&8- Zealot&r - built for the deep dark. Wall climbing, invisibility in darkness, faster mining."
		"&4- Bloodknight&r - drinks other vampires. Daywalker, Blood Hunt, and a taste for its own kind."
		"&b- Ectotherm&r - creature of cold water. Swim speed, ice movement, no sun damage underwater."
		"&5- Gravebound&r - undead even by vampire standards. Souls instead of food, walks through walls."
		""
		"&4None of them are free. Every one of them makes you worse at something.&r"
		""
		"&7Joining is a ritual, not a menu. Each path below tells you exactly how.&r"
	]
	quest.40F8DE1A8D296380.quest_subtitle: "Vampires only"
	quest.40F8DE1A8D296380.title: "Not All Vampires Are the Same"
	quest.4118409E08CBEE78.quest_desc: [
		"Blood Sausage, Blood Hot Dog, Blood Bagel. Filling, quick to make in bulk, and they restore blood rather than hunger."
		""
		"&7Non-vampires can eat these too. They just will not enjoy them.&r"
	]
	quest.4118409E08CBEE78.quest_subtitle: "Sausage, hot dog, bagel"
	quest.4118409E08CBEE78.title: "The Butcher's Menu"
	quest.41C676A7F99C4AA9.quest_desc: ["Saves a lot of walking around village gardens."]
	quest.41C676A7F99C4AA9.quest_subtitle: "Points at wild garlic"
	quest.41C676A7F99C4AA9.title: "Garlic Finder"
	quest.420337DD1C3C4414.quest_desc: [
		"Every infusion ritual eats Human Hearts. Villagers drop &eWeak Human Hearts&r; the real thing comes from stronger humans - hunters and players."
		""
		"&7Stock up early. The level 12-14 rituals want a lot of them.&r"
	]
	quest.420337DD1C3C4414.quest_subtitle: "Dropped by villagers and players"
	quest.420337DD1C3C4414.title: "Human Hearts"
	quest.4378A95CAA9D4128.quest_subtitle: "You have left and joined 100 times"
	quest.4378A95CAA9D4128.title: "Welcome Back"
	quest.43BB20F53CC04357.quest_desc: [
		"A portable, stackable blood source that does not need a mob attached to it."
		""
		"&7Every serious vampire keeps a stack of these for emergencies.&r"
	]
	quest.43BB20F53CC04357.quest_subtitle: "Concentrated blood, in a bottle"
	quest.43BB20F53CC04357.title: "Blood Syrup"
	quest.440A6A14722F25C7.quest_subtitle: "You 'might' have a problem"
	quest.440A6A14722F25C7.title: "Bloodistic"
	quest.440F6D61943AA45D.quest_desc: ["Fill the sash from an oil pot and you can throw the contents at whatever is running at you."]
	quest.440F6D61943AA45D.quest_subtitle: "Throw the oil instead of painting with it"
	quest.440F6D61943AA45D.title: "Oil Pot Sash"
	quest.445D6D653F72F5E3.quest_desc: ["Stop waiting for drops. Forge the scrolls you actually want."]
	quest.445D6D653F72F5E3.quest_subtitle: "Make your own scrolls"
	quest.445D6D653F72F5E3.title: "Scroll Forge"
	quest.446CFE46A57AD6DE.quest_desc: ["It flies, it grabs, and it drops you from a considerable height."]
	quest.446CFE46A57AD6DE.quest_subtitle: "Mowzie's Mobs"
	quest.446CFE46A57AD6DE.title: "Naga"
	quest.447E45EEA1CA6E70.quest_desc: ["Harder and more durable than the ordinary kind, and immune to what it is soaked in."]
	quest.447E45EEA1CA6E70.quest_subtitle: "Leather cured in toxin"
	quest.447E45EEA1CA6E70.title: "Toxic Leather"
	quest.4490DB16F3B46A0E.quest_desc: [
		"&cYou age by draining creatures of blood.&r Every entity you feed on adds points."
		""
		"&6Where to check your progress:&r interact with a &cCoffin&r."
		""
		"&7Depending on the server config, ageing may instead count time survived, or creatures you have infected. The Coffin tells you which, and how far off you are.&r"
	]
	quest.4490DB16F3B46A0E.quest_subtitle: "How a vampire ages"
	quest.4490DB16F3B46A0E.title: "Vampires: Drain Them Dry"
	quest.449FD3B76C977BA6.quest_desc: ["Beacons, and one very specific brewing recipe."]
	quest.449FD3B76C977BA6.quest_subtitle: "Still the best source of a Nether Star"
	quest.449FD3B76C977BA6.title: "The Wither"
	quest.44FB2CA46980F24F.quest_desc: [
		"&4Silver is to you what garlic and holy water are to a vampire.&r"
		""
		"A silver weapon inflicts the &7Silver&r effect: it slows you down and it strips the damage reduction from your fur. That is brutal in beast form, where you cannot wear armour at all."
		""
		"Hunters can also coat any sword in &6Silver Oil&r for a temporary version of the same thing, and they have &6Silver Bolts&r for their crossbows."
		""
		"&aThe skill &6Silver Blooded&a reduces all of this.&r Take it if you PvP."
		""
		"&7Silver ore generates underground in werewolf-aligned biomes. You can mine it - just do not hold it longer than you have to.&r"
	]
	quest.44FB2CA46980F24F.quest_subtitle: "Information - your one real weakness"
	quest.44FB2CA46980F24F.title: "Silver"
	quest.452C7A76EFBE2C96.quest_desc: ["Bats in a cage. They also happen to be a renewable snack."]
	quest.452C7A76EFBE2C96.quest_subtitle: "Decor with a purpose"
	quest.452C7A76EFBE2C96.title: "Bat Cage"
	quest.454DEEBADB4D5540.quest_desc: [
		"&bThere is no better-equipped human in this world than you.&r"
		""
		"&7Find a Hunter Representative in a hunter-aligned village. He has a task for you, and it ends with command of your own hunters.&r"
	]
	quest.454DEEBADB4D5540.quest_subtitle: "Maximum hunter level"
	quest.454DEEBADB4D5540.title: "Level 14"
	quest.45947CB604309931.quest_desc: [
		"Tells you what a vampire is, and what rank they have reached."
		""
		"&7Useful before you pick a fight with a stranger.&r"
	]
	quest.45947CB604309931.quest_subtitle: "Hit a creature with it to read their bloodline"
	quest.45947CB604309931.title: "The Bloodline Tester"
	quest.463D29E826515DA2.quest_desc: [
		"Load an affinity solution into a &6Copper Needle&r by holding one in each hand."
		""
		"Then find a &lstrong&r creature, bring it to the brink of death - poison works well for this - and inject it. The affinity reveals itself."
		""
		"&4The target must be weak enough, or the injection fails.&r"
		""
		"&7Repeat until you have enough data. Then hover the Magnifying Glass over the ingredient in your inventory to read its affinity.&r"
	]
	quest.463D29E826515DA2.quest_subtitle: "Test it on something else first"
	quest.463D29E826515DA2.title: "The Needle"
	quest.4765AC936ED284C6.quest_desc: ["Larger fortified positions. They generate in plains, deserts, badlands - and, boldly, inside the Vampire Forest itself."]
	quest.4765AC936ED284C6.quest_subtitle: "Find a Hunter Outpost"
	quest.4765AC936ED284C6.title: "Hunter Outposts"
	quest.47BE097991B13ED8.quest_desc: ["Two full wood sets from the Werewolf Forest. Purple and pale, and both look excellent next to Dark Stone."]
	quest.47BE097991B13ED8.quest_subtitle: "Build something that is not stone"
	quest.47BE097991B13ED8.title: "Jacaranda and Magic Wood"
	quest.4801ABD95444022A.quest_desc: ["The Archevoker does not fight you himself. That is why he is still alive."]
	quest.4801ABD95444022A.quest_subtitle: "Archevoker"
	quest.4801ABD95444022A.title: "The Master of Illusion"
	quest.48500262E8C5249E.quest_desc: ["Applied at the Arcane Anvil. Rare, and it does not come back if you overwrite it."]
	quest.48500262E8C5249E.quest_subtitle: "Permanent gear upgrade"
	quest.48500262E8C5249E.title: "Blood Upgrade Orb"
	quest.487AC9BE10E2115A.quest_desc: ["Forts, towers, houses and a ship. Good bases if you are willing to evict the occupants."]
	quest.487AC9BE10E2115A.quest_subtitle: "Medieval Buildings"
	quest.487AC9BE10E2115A.title: "Medieval Fort"
	quest.491182BCF52B945B.quest_desc: [
		"Respawn it with end crystals and do it again."
		""
		"&8Cooldown: three hours.&r"
	]
	quest.491182BCF52B945B.quest_subtitle: "Repeatable"
	quest.491182BCF52B945B.title: "Dragon's Breath"
	quest.49BB0D6878B474B7.quest_desc: ["A village suspended in the air. Getting up there is the puzzle."]
	quest.49BB0D6878B474B7.quest_subtitle: "Sky Villages"
	quest.49BB0D6878B474B7.title: "Sky Village"
	quest.4A0874FC14B1C606.quest_desc: ["Fills the air with wolfsbane. Anything with fur that walks in will regret it."]
	quest.4A0874FC14B1C606.quest_subtitle: "Area denial"
	quest.4A0874FC14B1C606.title: "Wolfsbane Diffuser"
	quest.4A278B8CF44D0A2D.quest_desc: ["Something at the bottom of a Gloopy Nest that should not have been allowed to grow that large."]
	quest.4A278B8CF44D0A2D.quest_subtitle: "Unusual End"
	quest.4A278B8CF44D0A2D.title: "Enderblob Queen"
	quest.4A4AA7352F34FC1E.quest_desc: ["The strongest thing Illager Invasion has. Do not fight it at range."]
	quest.4A4AA7352F34FC1E.quest_subtitle: "Illager Invasion"
	quest.4A4AA7352F34FC1E.title: "The Inquisitor"
	quest.4AAA164F660A9807.quest_desc: ["Swamp huts, expanded. There is also a Witch Circle out there somewhere."]
	quest.4AAA164F660A9807.quest_subtitle: "Yung's Better Witch Huts"
	quest.4AAA164F660A9807.title: "Better Witch Huts"
	quest.4C227BF8A526D22C.quest_desc: [
		"The catacombs refill. So does he."
		""
		"&8Cooldown: 90 minutes.&r"
	]
	quest.4C227BF8A526D22C.quest_subtitle: "Repeatable"
	quest.4C227BF8A526D22C.title: "Necromantic Harvest"
	quest.4C3E3F92723D3258.quest_desc: ["By now you should have the full arsenal. If you do not, go and build it."]
	quest.4C3E3F92723D3258.quest_subtitle: "The last stretch"
	quest.4C3E3F92723D3258.title: "Level 11"
	quest.4C9922F6EE10E8E2.quest_desc: [
		"Your bite is not just damage. Use it on something and tear it apart."
		""
		"&7Bite kills are also how you gain Age Rank later, if Vampiric Ageing is enabled.&r"
	]
	quest.4C9922F6EE10E8E2.quest_subtitle: "Devour a creature"
	quest.4C9922F6EE10E8E2.title: "Another One Bites the Dust"
	quest.4D17772E2A7AF4AD.quest_desc: [
		"There were hunters before you. They left their watchtowers and their guild hall behind."
		""
		"&6The Flintlock has no recipe.&r It is out there, in one of those buildings."
		""
		"&7There is also an Old Experiment House and two sizes of silver mine.&r"
	]
	quest.4D17772E2A7AF4AD.quest_subtitle: "Two Toxony structures"
	quest.4D17772E2A7AF4AD.title: "The Old Guild"
	quest.4D3910596809D0C8.quest_desc: [
		"&4Vampire Barons live in the Vampire Forest.&r They are levelled, they hit like a truck, and they are the only reliable source of &cPure Blood&r."
		""
		"&7Bring an escape plan. Barons regenerate and they do not fight alone.&r"
	]
	quest.4D3910596809D0C8.quest_subtitle: "Defeat a Vampire Baron"
	quest.4D3910596809D0C8.title: "Regicide"
	quest.4D634D3AD1415DFF.quest_desc: [
		"Werewolves have exactly one levelling structure, and it takes you all the way from level 2 to level 14."
		""
		"&7Place it somewhere permanent. You will be coming back a lot.&r"
	]
	quest.4D634D3AD1415DFF.quest_subtitle: "Your only way up"
	quest.4D634D3AD1415DFF.title: "The Stone Altar"
	quest.4E2BC65E3BC3AE54.quest_desc: [
		"It burns going in. Then nothing in this world can turn you."
		""
		"&6Continue in the chapter 'Path of the Cross'.&r"
	]
	quest.4E2BC65E3BC3AE54.quest_subtitle: "Become a Vampire Hunter"
	quest.4E2BC65E3BC3AE54.title: "The Vaccine"
	quest.4E30B30CEF2CFCB6.quest_desc: [
		"&6Defeat a Vampire Baron. As a human.&r"
		""
		"No fangs. No claws. No natural armour and no Down But Not Out to catch you."
		""
		"&8Honour system: FTB Quests cannot read your Vampirism faction, so nothing stops a vampire from claiming this one. It would be a waste of a good story.&r"
	]
	quest.4E30B30CEF2CFCB6.quest_subtitle: "Kill a Vampire Baron as a human"
	quest.4E30B30CEF2CFCB6.title: "Arcane Dominance"
	quest.4FC0F06D19B17823.quest_desc: [
		"Unlock the Bat skill and use it from the skill wheel. You fly, you fit through one-block gaps, and you cannot attack or break anything."
		""
		"&7Garlic in the air cancels bat form. Hunters use this on purpose.&r"
	]
	quest.4FC0F06D19B17823.quest_subtitle: "Fly, badly, in the dark"
	quest.4FC0F06D19B17823.title: "Bat Form"
	quest.500E0AE702FECF8A.quest_desc: [
		"&4Alpha Werewolves are levelled pack leaders.&r They hit hard, they are fast, and they do not fight fair."
		""
		"&7Silver works on them, which is awkward if you are what you are. Bring help, or bring poison.&r"
	]
	quest.500E0AE702FECF8A.quest_subtitle: "Slay the Alpha of a pack"
	quest.500E0AE702FECF8A.title: "Natural Succession"
	quest.506B6B09A79B8E4B.quest_desc: [
		"&4You lose every level when you leave a faction.&r Read that again before you do any of this."
		""
		"&cLeaving the Vampires&r - find or craft an &cAltar of Cleansing&r and use it. There is usually one in a village church."
		""
		"&6Leaving the Werewolves&r - right-click a werewolf with an empty &6Syringe&r to draw a strange fluid, craft that into an &6Un-Werewolf Injection&r, then inject it at an &bInjection Chair&r. The effect cleanses you after about 100 seconds."
		""
		"&bLeaving the Hunters&r - craft a &cSanguinare Injection&r and use it at an &bInjection Chair&r. That flushes the garlic out and lets you be infected again."
		""
		"&7Vampirism also has a Potion of Oblivion if you only want to reset your skill choices without losing your faction.&r"
	]
	quest.506B6B09A79B8E4B.quest_subtitle: "How to leave a faction - and what it costs"
	quest.506B6B09A79B8E4B.title: "No Turning Back"
	quest.50D07953592D21DD.quest_desc: ["Made with toxic paste. Considerably more dangerous, considerably more tolerance."]
	quest.50D07953592D21DD.quest_subtitle: "The stronger version"
	quest.50D07953592D21DD.title: "Toxic Blend"
	quest.50EF65BA1079B0F1.quest_desc: [
		"Kill normal Vampire NPCs with a stake and they drop &cVampire Blood&r."
		""
		"Take it to a Hunter Trainer and open his interface. He will trade levels for blood:"
		"&e- Level 2, 3 and 4 each cost a larger amount.&r"
		""
		"&7Collect more than you think you need. The trainer does not do refunds.&r"
	]
	quest.50EF65BA1079B0F1.quest_subtitle: "Levels 2, 3 and 4"
	quest.50EF65BA1079B0F1.title: "Vampire Blood"
	quest.510C2627A2730E8B.quest_desc: ["Learn the lesson the direct way."]
	quest.510C2627A2730E8B.quest_subtitle: "Get in contact with silver"
	quest.510C2627A2730E8B.title: "Do Not Touch That"
	quest.5114C36B956A6538.quest_desc: ["Vampirism's ghost. Kill enough of them and you have earned the right to loot a crypt properly."]
	quest.5114C36B956A6538.quest_subtitle: "It lives in the crypts"
	quest.5114C36B956A6538.title: "Cryptwraith"
	quest.512455D4C02FF048.quest_desc: [
		"&6Spitfire&r - starts an alchemical fire on impact. Fire is lethal to vampires and alchemical fire does not spread or burn your build down."
		"&6Teleport Quarrel&r - teleports you to where it lands."
		"&6Vampire Killer Quarrel&r - instantly kills low level Vampire NPCs."
	]
	quest.512455D4C02FF048.quest_subtitle: "Spitfire, Teleport, Vampire Killer"
	quest.512455D4C02FF048.title: "Specialist Bolts"
	quest.514F09DAE9CAE867.quest_desc: [
		"&bComplete the Representative's special task at hunter level 14.&r"
		""
		"Master Hunter. You can now recruit low-level hunter NPCs to work for you."
	]
	quest.514F09DAE9CAE867.quest_subtitle: "Lord rank 1"
	quest.514F09DAE9CAE867.title: "Hunter Lord"
	quest.515E33C4EAED5A35.quest_desc: [
		"The Heartseeker drains blood from what it cuts and feeds it straight back to you. Three tiers: normal, enhanced, ultimate."
		""
		"&7Killing a Vampire with a Heartseeker or Heartstriker is also how you get &cCorrupted Blood Samples&7 for the Bloodlines chapter.&r"
	]
	quest.515E33C4EAED5A35.quest_subtitle: "Steals blood on hit"
	quest.515E33C4EAED5A35.title: "Heartseeker"
	quest.5162567E269FD861.quest_desc: ["Cheaper blood spells, stronger blood spells. Worn, not held."]
	quest.5162567E269FD861.quest_subtitle: "Curios slot"
	quest.5162567E269FD861.title: "Ring of Blood Affinity"
	quest.5197E9AC6BAEB031.title: "So What Is It?"
	quest.51A3255BB5010BBF.quest_desc: [
		"&6Level 14 is not the end.&r"
		""
		"Find a &6Werewolf Representative&r in a werewolf-aligned village. At max level he offers you a special task. Complete it and you can bind werewolf NPCs as your tribe."
		""
		"The five Lord ranks are &6Epsilon, Delta, Gamma, Beta&r and finally &6Alpha&r."
		""
		"&7Continue in the chapter &6Lords and Minions&7, then look at &cThe Long Years&7.&r"
	]
	quest.51A3255BB5010BBF.quest_subtitle: "Continue in 'Lords and Minions'"
	quest.51A3255BB5010BBF.title: "Lead the Tribe"
	quest.51ACFEE460F24CCD.quest_desc: [
		"Distance is dangerous. A Waystone at your base means you can always get back before sunrise."
		""
		"&7Place it, name it, then right-click any other waystone in the world to travel to it.&r"
	]
	quest.51ACFEE460F24CCD.quest_subtitle: "Craft and place a Waystone"
	quest.51ACFEE460F24CCD.title: "The Road Home"
	quest.51E658D6367E6C69.quest_desc: [
		"&aStrengths&r"
		"- You stay human. No sun damage, no silver allergy, no blood bar, no forced transformation."
		"- Immune to Sanguinare Vampiris - vampires cannot turn you."
		"- Crossbows, double crossbows, semi-auto crossbows, and specialist quarrels."
		"- Holy water, alchemical fire, garlic bombs and garlic diffusers."
		"- Hunter Coats and Armour of Swiftness, plus a Potion Table that outclasses a brewing stand."
		"- Stakes finish downed vampires permanently."
		""
		"&cWeaknesses&r"
		"- No innate power. Everything you have, you have to craft."
		"- Your progression is the most gated: research, intel, and a fee paid to a trainer at every level."
		"- Vampires and werewolves both count you as an enemy. You will be outnumbered."
	]
	quest.51E658D6367E6C69.quest_subtitle: "What being a Hunter actually costs"
	quest.51E658D6367E6C69.title: "The Price of the Cross"
	quest.522A18B32090B7F3.quest_desc: [
		"Poison paste, heated in the crucible. Far more potent and far more useful."
		""
		"&7Toxic paste unlocks acid oils, toxin oils, potion flasks and the leather for plague doctor armour.&r"
	]
	quest.522A18B32090B7F3.quest_subtitle: "Refined poison paste"
	quest.522A18B32090B7F3.title: "Toxic Paste"
	quest.526D1874A3289E8B.quest_desc: [
		"Blood-Infused Iron, taken further. This is what the &6ultimate&r tier of the vampire weapons is built from."
		""
		"&7Store the ingots as blocks - Vampirism has both a Blood-Infused Iron Block and an Enhanced Blood-Infused Iron Block.&r"
	]
	quest.526D1874A3289E8B.quest_subtitle: "The second tier of blood metal"
	quest.526D1874A3289E8B.title: "Enhanced Blood Iron"
	quest.529556A99B0D948F.quest_desc: ["Find the monastery and accept his challenge. He is not trying to kill you. He is testing you, which is worse."]
	quest.529556A99B0D948F.quest_subtitle: "Mowzie's Mobs - the monastery challenge"
	quest.529556A99B0D948F.title: "The Sculptor"
	quest.52A15C143593FE55.quest_desc: ["A drink built out of alchemy rather than fruit. Effects vary. That is the appeal."]
	quest.52A15C143593FE55.quest_subtitle: "Do not ask what is in it"
	quest.52A15C143593FE55.title: "Alchemical Cocktail"
	quest.52D392048C44B5CB.quest_desc: [
		"Vampires are faster than you in melee. They are not faster than a bolt."
		""
		"&7Load it with Quarrels, not vanilla arrows.&r"
	]
	quest.52D392048C44B5CB.quest_subtitle: "Range beats speed"
	quest.52D392048C44B5CB.title: "Basic Crossbow"
	quest.5329941CBFEFA7AE.quest_subtitle: "If you are in a team, your teammate might get the reward"
	quest.53E111B531C9C269.quest_desc: [
		"&6Blends are how you raise your tolerance.&r An ancient technique: consume a mixture of deadly flora, a little at a time, and the body adapts."
		""
		"&2Poison Blend&r first. &4Toxic Blend&r once you have toxic paste. &fPure Blend&r at the top."
		""
		"&4A blend that is too weak for your current tolerance does nothing.&r The game will tell you so."
		""
		"&7Do not drink two in a row without checking the gauge.&r"
	]
	quest.53E111B531C9C269.quest_subtitle: "Blends - drink poison on purpose"
	quest.53E111B531C9C269.title: "Raise Your Tolerance"
	quest.54267A50329F15E9.quest_desc: ["Wizard towers with an Inscription Table and scrolls you will not find anywhere else."]
	quest.54267A50329F15E9.quest_subtitle: "Iron's Spellbooks"
	quest.54267A50329F15E9.title: "Mountain Tower"
	quest.5480F165D19CC167.quest_desc: [
		"A vindicator who took up a trade. He is not friendly about it."
		""
		"&7Your existing Butchery chapter covers what to do with the tools inside.&r"
	]
	quest.5480F165D19CC167.quest_subtitle: "Butchery"
	quest.5480F165D19CC167.title: "The Butcher's House"
	quest.54B209EEFABF791D.quest_desc: ["Iron soaked in blood at the Alchemical Cauldron. The base material for the best vampire weapons and the Enhanced variant that follows it."]
	quest.54B209EEFABF791D.quest_subtitle: "The vampire's crafting metal"
	quest.54B209EEFABF791D.title: "Blood-Infused Iron"
	quest.54E40795ECE88D2A.quest_desc: [
		"&6Push your toxicity past a threshold with the right affinities and your body changes.&r"
		""
		"&cBeast&r - speed on hit, damage boost, meat feeds you more, and at night you gain 30% movement speed and inflict Hunt."
		"&bAqua&r - bonus oxygen, swim speed, mining unaffected underwater, heavy knockback attacks. Takes more fire damage."
		"&8Hollow&r - damage reduction, slower hunger, permanent night vision, wall climbing, knockback resistance. Weak in direct sunlight."
		"&2Necrotic&r - rotten flesh heals you, immunity to poison and wither, you count as undead, your hits apply Wither, and you revive once on death. Weak in sunlight."
		"&6Infernal&r - fire immunity, attackers catch fire, you set targets alight, and you can make charcoal without a furnace. Weak in water."
		"&dSpirit&r - permanent slow falling, chance to ignore damage and turn invisible, and your attacks summon Guided Spirits. Weak to magic."
		""
		"&7Which one you get depends entirely on the ingredients you consume. Check the gauge by right-clicking it to see what you have.&r"
	]
	quest.54E40795ECE88D2A.quest_subtitle: "Six permanent transformations"
	quest.54E40795ECE88D2A.title: "Mutagens"
	quest.55E13B740F947F25.quest_desc: [
		"If someone smashes your Phylactery, the Soul Binder lets you claim an unowned one by right-clicking it."
		""
		"&7Build a spare Phylactery somewhere nobody will look.&r"
	]
	quest.55E13B740F947F25.quest_subtitle: "Gravebound insurance"
	quest.55E13B740F947F25.title: "Soul Binder"
	quest.56659D409BB3CC30.quest_desc: [
		"&6Your skill tree splits into three shapes. They are not mutually exclusive, but you will not be able to max all of them.&r"
		""
		"&cBeast&r - the big one. Highest damage, Rage, Beast Rage to ignore the daytime penalty. No armour without the Wear Armor skill."
		""
		"&aSurvivalist&r - the fast one. Movement speed, Climber for automatic step-up, Arrow Awareness to dodge projectiles, Movement Tactics to dodge while sprinting."
		""
		"&eLycanthrope (Partial Turn)&r - the human-looking one. Utility, and the only form that wears armour comfortably."
		""
		"&7Every form has a duration. It runs out. Refinements of Endurance extend it.&r"
	]
	quest.56659D409BB3CC30.quest_subtitle: "Information - Beast, Survivalist, Lycanthrope"
	quest.56659D409BB3CC30.title: "Three Shapes"
	quest.5669790292D1FF2C.quest_desc: ["Dark Stone comes from the Vampire Forest. It has the full set: bricks, tiles, slabs, stairs, walls, polished and cracked variants. Build a crypt worth living in."]
	quest.5669790292D1FF2C.quest_subtitle: "Dark Stone and Purple Stone"
	quest.5669790292D1FF2C.title: "Build Something Awful"
	quest.5674E7963F438AE5.quest_desc: ["It has its own structure, and it is not there to make friends."]
	quest.5674E7963F438AE5.quest_subtitle: "Mobs of Mythology"
	quest.5674E7963F438AE5.title: "The Automaton"
	quest.56B5B8130473471D.quest_desc: [
		"Hand a hunter NPC proper equipment and they will follow you."
		""
		"&7They can defend an area or go out and collect hunter items for you.&r"
	]
	quest.56B5B8130473471D.quest_subtitle: "Right-click a low level hunter NPC with it"
	quest.56B5B8130473471D.title: "Hunter Minion Equipment"
	quest.56DD45FDC88179A1.quest_desc: ["The best werewolf armour in the game. You will need the &6White Pelt Upgrade Smithing Template&r to make it."]
	quest.56DD45FDC88179A1.quest_subtitle: "Full white pelt set"
	quest.56DD45FDC88179A1.title: "Thick Fur Coat"
	quest.56F1F3B8030E8E30.quest_desc: [
		"Your heart stops. Your eyes adjust. The sun becomes a problem."
		""
		"&6Continue in the chapter 'Path of Blood'.&r"
	]
	quest.56F1F3B8030E8E30.quest_subtitle: "Become a Vampire"
	quest.56F1F3B8030E8E30.title: "Sanguinare Vampiris"
	quest.570A168B4C27259F.quest_desc: [
		"&6You went to sleep human. You did not wake up that way.&r"
		""
		"Unlike a vampire you are not obviously a monster - you are only recognised as a werewolf &lwhile you are transformed&r. In human shape you can walk into any village you like."
		""
		"&6Left side&r is your forms and your diet. &6Middle&r is the Stone Altar, which is your entire level ladder. &6Right side&r is materials, silver, and armour."
		""
		"&7Open the Vampirism menu to see your skills, your form and your level progress.&r"
	]
	quest.570A168B4C27259F.quest_subtitle: "You are a Werewolf, level 1"
	quest.570A168B4C27259F.title: "Lupus Sanguinem"
	quest.572F8B582646C627.quest_desc: ["Stronger, and it pushes your Tainted Blood Rank higher. So do the drawbacks."]
	quest.572F8B582646C627.quest_subtitle: "The refined version"
	quest.572F8B582646C627.title: "Tainted Concentrate"
	quest.57B60F560F706DE2.quest_desc: ["Where the chemist trained, before they threw him out. There is a Hunter Watchtower and an Old Experiment House out there too."]
	quest.57B60F560F706DE2.quest_subtitle: "Toxony"
	quest.57B60F560F706DE2.title: "Old Adventure Guild"
	quest.59657318A415F7B1.quest_desc: ["By now the differences are obvious. Your health pool is larger, you move faster, and the sun no longer ends the conversation quite so quickly."]
	quest.59657318A415F7B1.quest_subtitle: "Halfway to ancient"
	quest.59657318A415F7B1.title: "Age Rank 3"
	quest.597A1C5EAE88969C.quest_desc: [
		"Vampires spawn at night and they are faster than you. Werewolves are worse."
		""
		"Dig in, place a door, and put a light on the floor. Survive the first night the boring way."
	]
	quest.597A1C5EAE88969C.quest_subtitle: "A hole in a hill counts"
	quest.597A1C5EAE88969C.title: "Four Walls"
	quest.59D24C68A0388011.quest_desc: ["Catch one in the moment after it gets back up, and put it down again for good."]
	quest.59D24C68A0388011.quest_subtitle: "Kill a resurrected vampire"
	quest.59D24C68A0388011.title: "No Second Chances"
	quest.5A0681951F4CB322.title: "Building Supplies"
	quest.5A16B34411909DE1.title: "The Storage Complex"
	quest.5A27D3C5910918BF.quest_desc: ["Silver ore, silver ingots, silver blocks, and a full set of silver tools. Hunters will pay well. So will your enemies."]
	quest.5A27D3C5910918BF.quest_subtitle: "Silver is worth money to the wrong people"
	quest.5A27D3C5910918BF.title: "Mine It Anyway"
	quest.5A2E94D8BB145801.quest_desc: [
		"Werewolves eat meat. Not bread, not carrots, not cake."
		""
		"&7The skill &6Not Meat?&7 lifts that restriction if you find it too limiting. &6Efficient Diet&7 makes your food last longer while transformed.&r"
	]
	quest.5A2E94D8BB145801.quest_subtitle: "Cooked food does nothing for you"
	quest.5A2E94D8BB145801.title: "Raw and Bloody"
	quest.5A559F1459CF16F9.quest_desc: [
		"Sneak and right-click a Blood Container with a filled Blood Bottle to store blood at home."
		""
		"&7You can also pipe it into other mods' fluid tanks. This is your fuel depot for the altars.&r"
	]
	quest.5A559F1459CF16F9.quest_subtitle: "Blood Container"
	quest.5A559F1459CF16F9.title: "A Cellar of Blood"
	quest.5ACDA086C12B927B.quest_desc: ["Complete one full ritual at the Altar of Infusion."]
	quest.5ACDA086C12B927B.quest_subtitle: "Perform an infusion ritual"
	quest.5ACDA086C12B927B.title: "Blood Cult"
	quest.5B258AC53C4777DF.quest_desc: ["Turn the weakness outward. Even wolves fight wolves."]
	quest.5B258AC53C4777DF.quest_subtitle: "Kill a werewolf with silver"
	quest.5B258AC53C4777DF.title: "Silver Hand"
	quest.5B58E2978BFF5FB0.quest_desc: [
		"&bHoly water bypasses Down But Not Out.&r It burns undead, it burns vampires much harder, and it cancels their disguise and invisibility outright."
		""
		"Three tiers: &fnormal&r, &eenhanced&r, &6ultimate&r."
		""
		"&7Keep splash bottles for crowds and regular bottles for finishing.&r"
	]
	quest.5B58E2978BFF5FB0.quest_subtitle: "The one thing that truly kills them"
	quest.5B58E2978BFF5FB0.title: "Holy Water"
	quest.5B61FC7FC1F35B77.quest_desc: ["Crypts hide Vampire Books and Corrupted Blood Samples. They also hide Cryptwraiths."]
	quest.5B61FC7FC1F35B77.quest_subtitle: "Underground, and not empty"
	quest.5B61FC7FC1F35B77.title: "The Crypt"
	quest.5B9F4033A870B65B.quest_desc: [
		"&cTwo ways:&r"
		""
		"&61.&r Let a Vampire attack you. If it hits you from behind, you may catch &cSanguinare Vampiris&r. The effect lasts roughly one Minecraft day. When it ends, you die and wake up a vampire."
		""
		"&62.&r Get a &cVampire Fang&r (dropped by vampires) and right-click with it in hand. Same effect, on your own schedule."
		""
		"&7Milk cancels the infection. So does a Hunter Trainer. If you want this, do neither.&r"
		""
		"&8Sleeping does nothing to Sanguinare Vampiris. It runs on a timer.&r"
	]
	quest.5B9F4033A870B65B.quest_subtitle: "Becoming a Vampire"
	quest.5B9F4033A870B65B.title: "How to Get Bitten"
	quest.5C0E5D5505C367E1.quest_desc: ["Look for villages that have fallen to the vampires. He is not hard to spot."]
	quest.5C0E5D5505C367E1.quest_subtitle: "Lives in vampire-aligned villages"
	quest.5C0E5D5505C367E1.title: "The Vampire Representative"
	quest.5C1EC40949271113.quest_desc: [
		"Werewolves equip three accessories in the Vampirism menu. They carry &6refinements&r: longer form duration, stronger bite, more wolves from Wolf Pack, extra dodge chance."
		""
		"&7You get them from Werewolf Representative tasks, chests and loot. Once equipped they bind to you, and they take damage when you respawn.&r"
	]
	quest.5C1EC40949271113.quest_subtitle: "Bone Necklace, Charm Bracelet, Dream Catcher"
	quest.5C1EC40949271113.title: "Charms of the Pack"
	quest.5C7CAA0511D52288.title: "Kill: 1000x Vampires"
	quest.5D03F6AA017B63E7.quest_desc: [
		"&4Pure Blood of purity 4&r only comes from the highest level Vampire Barons, deep in the Vampire Forest."
		""
		"&7This is the single hardest farm in the Vampirism progression.&r"
	]
	quest.5D03F6AA017B63E7.quest_subtitle: "Hunt Barons until they give up the good stuff"
	quest.5D03F6AA017B63E7.title: "Purity 4"
	quest.5D1A5AA6FEC60761.quest_desc: [
		"&6Waystones&r - place and link them. Waystone Towers generate ready-made ones in the world."
		"&6Small Ships&r - real sailing ships. On a Continents world this is not a novelty, it is transport."
		"&6Air Hop&r - a double jump. Do not underestimate it in a fight."
		"&6Comforts&r - sleeping bags and hammocks, so you never have to carry a bed."
		""
		"&8Vampires: an Umbrella and a boat is a viable way to cross an ocean at noon.&r"
	]
	quest.5D1A5AA6FEC60761.quest_subtitle: "Information - travel mods"
	quest.5D1A5AA6FEC60761.title: "Getting Around"
	quest.5D5C843BB6D25F33.title: "Killing bosses"
	quest.5D75F2AD25F346E4.quest_desc: ["Hold it up. Vampires that look at it will find themselves having a much worse time."]
	quest.5D75F2AD25F346E4.quest_subtitle: "Wooden, Iron, Golden"
	quest.5D75F2AD25F346E4.title: "The Crucifix"
	quest.5E28118D04B778D1.quest_desc: [
		"&7Silver is every alpha's nightmare.&r"
		""
		"&6Ancient Silver&r sits in the silver mines. Blast it into &6Silver Scrap&r, blend that into &6Silver Steel&r, then forge the ingot."
		""
		"&8Werewolves: crafting this is not against the rules, but carrying it will hurt.&r"
	]
	quest.5E28118D04B778D1.quest_subtitle: "Silver steel"
	quest.5E28118D04B778D1.title: "Bane of Wolves"
	quest.5E47FB92C0450D76.quest_desc: [
		"&6Level 14. There is nothing in the forest above you now.&r"
		""
		"&7Find a Werewolf Representative in a werewolf-aligned village. He has a task for you, and it ends with you leading a tribe.&r"
	]
	quest.5E47FB92C0450D76.quest_subtitle: "Maximum werewolf level"
	quest.5E47FB92C0450D76.title: "Unrivaled Predator"
	quest.5E6C264BD5E67A83.quest_desc: [
		"Fire does not negotiate. Keep your distance and keep moving."
		""
		"&7Vampires: you take extra fire damage. Consider sending someone else.&r"
	]
	quest.5E6C264BD5E67A83.quest_subtitle: "Pyromancer"
	quest.5E6C264BD5E67A83.title: "The Pyromancer's Tower"
	quest.5E6F8D922A8EE138.quest_desc: ["More slots, higher spell levels, more mana. The ladder is straightforward."]
	quest.5E6F8D922A8EE138.quest_subtitle: "Iron, Gold, Diamond"
	quest.5E6F8D922A8EE138.title: "Better Bindings"
	quest.5F02C1D0C992802C.quest_desc: [
		"The leader of the Umvuthana, in his grove."
		""
		"&4A vampire fighting the literal sun god is thematically perfect and tactically stupid.&r"
	]
	quest.5F02C1D0C992802C.quest_subtitle: "Mowzie's Mobs - the sun god"
	quest.5F02C1D0C992802C.title: "Umvuthi"
	quest.5F1BFD7BD934C104.quest_desc: ["Structory adds atmospheric ruins across the whole world. The Old Manor is the pick of them, and it fits the setting perfectly."]
	quest.5F1BFD7BD934C104.quest_subtitle: "Structory"
	quest.5F1BFD7BD934C104.title: "The Old Manor"
	quest.5F412CB6C3BF587C.quest_desc: [
		"&6Seniority Oil&r can be applied to a weapon. Vampires and werewolves then take &cmore damage the older they are&r."
		""
		"&7This is the hunter answer to an Age Rank 5 vampire. Without it, an ancient is very hard to bring down.&r"
	]
	quest.5F412CB6C3BF587C.quest_subtitle: "Information - the counter to old monsters"
	quest.5F412CB6C3BF587C.title: "Seniority Oil"
	quest.5F5697DF7A1DB637.quest_desc: [
		"Beacons are not cheap. Neither is this."
		""
		"&8Cooldown: two hours.&r"
	]
	quest.5F5697DF7A1DB637.quest_subtitle: "Repeatable"
	quest.5F5697DF7A1DB637.title: "Star Harvest"
	quest.5F725F925E913D60.quest_desc: [
		"Pure Blood comes in five purities. Higher-level Barons drop purer blood, and you can always substitute a purer sample for a weaker one in a ritual."
		""
		"&7Purity 3 and 4 are endgame materials. Hunt Barons deep in the forest for them.&r"
	]
	quest.5F725F925E913D60.quest_subtitle: "Purity 0 through 4"
	quest.5F725F925E913D60.title: "Pure Blood"
	quest.5FF8F7D0B0768185.quest_desc: [
		"If they do get close, make them bleed for it."
		""
		"&6Three oil pots for the ground, one blend for the blade.&r"
		""
		"&4Toxic Paste needs 400 ticks in a Copper Crucible - about 20 seconds. Plan for it.&r"
		""
		"&7Apply an oil by holding the pot in one hand and the weapon in the other. Oils dry out, so re-coat before a fight rather than during one.&r"
	]
	quest.5FF8F7D0B0768185.quest_subtitle: "Oils and blends"
	quest.5FF8F7D0B0768185.title: "Lethal Preparation"
	quest.602C62F3633ECEB1.quest_desc: [
		"Tells you how old the thing in front of you is before you decide whether to fight it."
		""
		"&7Do not confuse it with the Bloodlines Tester. Different mod, different information, both worth carrying.&r"
	]
	quest.602C62F3633ECEB1.quest_subtitle: "Attack a vampire with it to read their Age Rank"
	quest.602C62F3633ECEB1.title: "Blood Tester"
	quest.60666BBC975DE87A.quest_desc: [
		"They spawn at night, they are faster than you, and they will infect you if they get behind you."
		""
		"&7Find one. Look at it. Do not let it look back for too long.&r"
	]
	quest.60666BBC975DE87A.quest_subtitle: "Look at a Vampire. From a distance."
	quest.60666BBC975DE87A.title: "The First One You See"
	quest.60EC2B5F2E56AF23.quest_desc: ["A sleeping ice beast in the mountains. Wake it by taking what it is guarding."]
	quest.60EC2B5F2E56AF23.quest_subtitle: "Mowzie's Mobs"
	quest.60EC2B5F2E56AF23.title: "Frostmaw"
	quest.615E819B73127C9E.quest_desc: ["Brews the potions and reagents the spell system uses. Not the same thing as Vampirism's Alchemical Cauldron - they just have similar names."]
	quest.615E819B73127C9E.quest_subtitle: "Magical brewing"
	quest.615E819B73127C9E.title: "Alchemist Cauldron"
	quest.61614B06F20B17B8.quest_desc: ["Knives cut ingredients on a Cutting Board and butcher mobs for extra drops."]
	quest.61614B06F20B17B8.quest_subtitle: "Also cuts things that are not vegetables"
	quest.61614B06F20B17B8.title: "A Knife for the Kitchen"
	quest.62CBBC24BE3D3372.quest_desc: [
		"The Blood Grinder converts raw meat and mob drops into blood. Feed it from above, take the blood out of the bottom."
		""
		"&7Pair it with a Blood Sieve and you never have to hunt for a meal again.&r"
	]
	quest.62CBBC24BE3D3372.quest_subtitle: "Turn corpses into litres"
	quest.62CBBC24BE3D3372.title: "The Grinder"
	quest.62FB6508EC1F84BF.quest_desc: [
		"&cComplete the Representative's special task at vampire level 14.&r"
		""
		"You gain the title of Lord and the right to bind vampire NPCs."
		""
		"&7Ranks: five in total. Each one is another task, and each one raises your minion cap.&r"
	]
	quest.62FB6508EC1F84BF.quest_subtitle: "Lord rank 1"
	quest.62FB6508EC1F84BF.title: "Vampire Lord"
	quest.63414BF32AEC5101.quest_desc: [
		"A unique spell book. You do not make it - you take it from something that did not want to give it up."
		""
		"&7Look in magic towers, deep structures, and on the corpses of necromancers.&r"
	]
	quest.63414BF32AEC5101.quest_subtitle: "Not craftable"
	quest.63414BF32AEC5101.title: "Necronomicon"
	quest.6360798EEC13A5E4.quest_desc: ["Throwable. Excellent against a coven, or against a vampire who thinks they are invisible."]
	quest.6360798EEC13A5E4.quest_subtitle: "Area denial"
	quest.6360798EEC13A5E4.title: "Splash Holy Water"
	quest.636BB3CCDABBBD3B.quest_desc: ["Four levels in and the ritual costs are still reasonable. Enjoy it."]
	quest.636BB3CCDABBBD3B.quest_subtitle: "The first real stretch"
	quest.636BB3CCDABBBD3B.title: "Level 4"
	quest.637B38CB0D8D84AE.quest_desc: ["The Blood Pedestal slowly recharges blood-powered items and accessories placed on it. Feed it from an adjacent Blood Container."]
	quest.637B38CB0D8D84AE.quest_subtitle: "Charge your gear"
	quest.637B38CB0D8D84AE.title: "The Blood Pedestal"
	quest.6443EB57E0B60E2A.quest_desc: [
		"A huge multi-level procedural dungeon under the surface. Bosses, traps, secret rooms."
		""
		"&7This is one of the best loot runs in the pack. Take a team.&r"
	]
	quest.6443EB57E0B60E2A.quest_subtitle: "Dungeon Crawl"
	quest.6443EB57E0B60E2A.title: "The Dungeon"
	quest.64EFBE55030EBEE5.title: "Kill 500x Beast Werewolves"
	quest.65318FE0736630F1.quest_desc: [
		"&fHow to join:&r you must already be a &6Vampire Lord of rank 2&r."
		""
		"&e1.&r Craft a &fLordslayer Injection&r from Corrupted Blood Samples."
		"&e2.&r Find a &cVampire Baron&r."
		"&e3.&r Bring him below &c30% health&r and apply &7Weakness&r to him."
		"&e4.&r Attack him with the Lordslayer Injection."
		""
		"&aWhat you get:&r much better villager trades, longer sun tolerance, mesmerise villagers, teleport behind enemies, and innate fire resistance that scales with rank."
		""
		"&cWhat it costs:&r less health than other vampires, only fresh blood really feeds you, and water hurts you more."
	]
	quest.65318FE0736630F1.quest_subtitle: "The hardest one to join"
	quest.65318FE0736630F1.title: "Noble"
	quest.658A1288655D286C.quest_desc: [
		"Deep underground sleeps a suit of armour that never needed anyone inside it."
		""
		"&6It is sealed in a Wrought Chamber and it does not wake until you touch it.&r"
		""
		"&7Dodge the swings, get behind it, hit the back. Trading blows head-on does not work.&r"
	]
	quest.658A1288655D286C.quest_subtitle: "Ferrous Wroughtnaut"
	quest.658A1288655D286C.title: "The Iron Guardian"
	quest.6605A6E2E276E1FA.quest_desc: [
		"&6You have done all of it.&r"
		""
		"You survived your first night as prey. You chose a side and you did not go back. You built the altars, paid the trainers, and clawed your way to fourteen. You took a Lord's title. You went down under the forest and killed the thing that made you what you are."
		""
		"&7There is nothing left in this book to tell you to do.&r"
		""
		"&8The server is still running. The other factions are still out there. That part was never going to be a quest.&r"
	]
	quest.6605A6E2E276E1FA.quest_subtitle: "The last quest in the book"
	quest.6605A6E2E276E1FA.title: "The Bitter End"
	quest.66EAD555F7140E6B.quest_desc: ["Wolf Berry Cookies and Wolf Berry Ice Cream, made from the bushes in the Werewolf Forest."]
	quest.66EAD555F7140E6B.quest_subtitle: "Werewolves get dessert too"
	quest.66EAD555F7140E6B.title: "Wolf Berry Sweets"
	quest.671DF99DB03D70AF.quest_desc: ["Libraries, prisons, and a great deal more loot than the vanilla version."]
	quest.671DF99DB03D70AF.quest_subtitle: "Yung's Better Strongholds"
	quest.671DF99DB03D70AF.title: "Better Strongholds"
	quest.6770D1AF31C4AA37.quest_desc: [
		"Level 4 is a real milestone:"
		""
		"&a- You unlock the ability to infect other creatures and players.&r Sneak up behind them, look at their back, and use the infect action."
		"&4- Sunlight now genuinely hurts.&r If you did not build an umbrella yet, build it now."
		""
		"&7Past this point the Altar of Inspiration is useless to you. You need the Altar of Infusion.&r"
	]
	quest.6770D1AF31C4AA37.quest_subtitle: "The Altar of Inspiration takes you this far"
	quest.6770D1AF31C4AA37.title: "Level 4"
	quest.6792713619DE8691.quest_desc: [
		"Eternal Nether rebuilds the dimension: Citadels, Catacombs and Piglin Manors, with Wraithers, Wexes, Corpors and Wither Skeleton Knights in them."
		""
		"&cBloodroot for Toxony grows in the Crimson Forest.&r"
	]
	quest.6792713619DE8691.quest_subtitle: "Eternal Nether"
	quest.6792713619DE8691.title: "The Nether"
	quest.67E22D518C8E6786.quest_desc: [
		"&aStrengths&r"
		"- Permanent speed, strength and extra health that scale with your level."
		"- Natural armour, so you never need to wear heavy plate."
		"- Night vision, bat form, invisibility, teleport-behind-target, minion control."
		"- &aDown But Not Out&r: most damage knocks you down instead of killing you. You get back up."
		"- You do not breathe, so you cannot drown."
		""
		"&cWeaknesses&r"
		"- &4Sunlight burns you.&r From level 4 up it is lethal without an umbrella."
		"- Garlic weakens and blinds you. Hunters will spam it."
		"- Holy water, fire and stakes bypass Down But Not Out and kill you for good."
		"- Water hurts until you unlock resistance."
		"- You eat nothing. You drink. Run out of blood and you starve fast."
		"- Beds no longer work. You need a Coffin."
	]
	quest.67E22D518C8E6786.quest_subtitle: "What being a Vampire actually costs"
	quest.67E22D518C8E6786.title: "The Price of Blood"
	quest.67EA2ADC417E1302.quest_desc: ["Bottled or on tap in a mug. The one thing on this menu you could serve to a stranger."]
	quest.67EA2ADC417E1302.quest_subtitle: "For the humans in the room"
	quest.67EA2ADC417E1302.title: "Dandelion Beer"
	quest.68018D94B908BDB4.quest_desc: ["You will regret this. Do it anyway."]
	quest.68018D94B908BDB4.quest_subtitle: "Bite something full of garlic"
	quest.68018D94B908BDB4.title: "Yuck"
	quest.68FF763C969A9EEE.quest_desc: ["Necromancers, blood scrolls and a great deal of bone."]
	quest.68FF763C969A9EEE.quest_subtitle: "Iron's Spellbooks"
	quest.68FF763C969A9EEE.title: "The Catacombs"
	quest.694348FB0A487D64.quest_desc: ["He knows what you are, and he does not care. He wants jobs done."]
	quest.694348FB0A487D64.quest_subtitle: "Lives in werewolf-aligned villages"
	quest.694348FB0A487D64.title: "The Werewolf Representative"
	quest.69CCF3E2DD8C756F.quest_desc: ["Flour and blood. It is exactly as unpleasant as it sounds, and it feeds a vampire properly."]
	quest.69CCF3E2DD8C756F.quest_subtitle: "The base of every blood dish"
	quest.69CCF3E2DD8C756F.title: "Blood Dough"
	quest.6A3B8FE8A28D6C41.quest_desc: ["Your first real bloodline power. Also the requirement for the Noble ritual, if you ever want to switch."]
	quest.6A3B8FE8A28D6C41.quest_subtitle: "Second bloodline rank"
	quest.6A3B8FE8A28D6C41.title: "Rank 2"
	quest.6A78CD0E27B2BDA6.quest_desc: [
		"Right-click the Weapon Table with a &6lava bucket&r to fuel it. Most crossbow recipes need it."
		""
		"&7Use JEI to browse what it can make. There is a lot in here that no other faction gets.&r"
	]
	quest.6A78CD0E27B2BDA6.quest_subtitle: "Fill it with lava first"
	quest.6A78CD0E27B2BDA6.title: "The Weapon Table"
	quest.6A9FE9FE23A78323.quest_desc: ["One tower clears this. Two is showing off."]
	quest.6A9FE9FE23A78323.quest_subtitle: "One tower is enough"
	quest.6A9FE9FE23A78323.title: "Elemental Masters"
	quest.6AA271C1C5EEF251.quest_desc: ["Attach it to a Blood Container and it feeds you automatically while you stand next to it."]
	quest.6AA271C1C5EEF251.quest_subtitle: "Automate the drinking"
	quest.6AA271C1C5EEF251.title: "Feeding Adapter"
	quest.6AD23F276655875A.quest_desc: [
		"Leather wrapped around a glass bottle, sealed with toxic paste."
		""
		"Fill it by holding a potion in the other hand. It has multiple charges, and with the &6Refill&r enchantment it refills itself when you sleep."
		""
		"&7The Toxin Flask is the upgraded version. Netherite extends it further.&r"
	]
	quest.6AD23F276655875A.quest_subtitle: "A potion you can use more than once"
	quest.6AD23F276655875A.title: "Potion Flask"
	quest.6B1EF878D5B077AF.quest_desc: [
		"The ritual needs &6four Fire Bowls&r placed within a &6three block radius&r of the Stone Altar."
		""
		"&4All four must be lit&r - use flint and steel. If the altar tells you 'the structures are not burning', that is what it means."
	]
	quest.6B1EF878D5B077AF.quest_subtitle: "Stone Altar Fire Bowls"
	quest.6B1EF878D5B077AF.title: "Four Fires"
	quest.6B65A5CF2B37291E.quest_desc: ["The standard werewolf set. Craft it from the pelts you have been collecting."]
	quest.6B65A5CF2B37291E.quest_subtitle: "Armour that does not fight your fur"
	quest.6B65A5CF2B37291E.title: "Pelt Armour"
	quest.6B77BD910D9BF4E6.quest_desc: [
		"&aTerralith&r adds well over a hundred new biomes: skylands, canyons, volcanic peaks, moonlit caves, ancient forests."
		""
		"&aContinents&r changes the shape of the world itself - real oceans between real landmasses. Expect long journeys."
		""
		"&aYung's Cave Biomes and Better Caves&r rewrite everything underground."
		""
		"&7This is why Waystones and Chunky matter on this server. Distances here are not vanilla distances.&r"
	]
	quest.6B77BD910D9BF4E6.quest_subtitle: "Information - worldgen"
	quest.6B77BD910D9BF4E6.title: "Terralith and Continents"
	quest.6C0F22C78900467C.quest_desc: [
		"&2Every poison in this pack starts the same way:&r bone meal, one poisonous ingredient that is not a plant, and one poisonous plant."
		""
		"&aNightshade&r and &fWater Hemlock&r grow wild - nightshade in dark overgrown places, hemlock in swamps. &2Ocelot Mint&r is in jungles, &bColdsnap&r in frozen taiga, &4Bloodroot&r in Crimson Forests."
		""
		"&7Craft a plant on its own to get seeds. To plant them you need soil as potent as they are - poison paste converts farmland.&r"
	]
	quest.6C0F22C78900467C.quest_subtitle: "Toxony starts here"
	quest.6C0F22C78900467C.title: "Mortar and Bone Meal"
	quest.6C60B7866AFA531E.quest_desc: ["Iron blocks got you to level 7. For 8 and up you want gold block pillars."]
	quest.6C60B7866AFA531E.quest_subtitle: "Time to fill those pillars with gold"
	quest.6C60B7866AFA531E.title: "Level 8"
	quest.6DEC8682F0407BAB.quest_desc: [
		"&5How to join:&r brew both a &5Rending Elixir&r and a &4Heinous Elixir&r, and craft a &5Phylactery&r."
		""
		"Place the Phylactery. Drink both elixirs. &4If you die from it, you wake up at the Phylactery as one of the Gravebound.&r"
		""
		"&aWhat you get:&r Ghost Walk through solid walls, teleport to your Phylactery, poison immunity, soul speed, and undead mobs ignore you."
		""
		"&cWhat it costs:&r your food bar becomes a &5soul meter&r. You gain souls by devouring intelligent creatures - vampires and villagers. You get much less XP, you barely heal naturally, and magic hurts more."
		""
		"&4If your Phylactery is destroyed you lose access to your best abilities until you bind a new one with a Soul Binder.&r"
	]
	quest.6DEC8682F0407BAB.quest_subtitle: "Build your grave, then use it"
	quest.6DEC8682F0407BAB.title: "Gravebound"
	quest.6E847C301F9A369F.quest_desc: ["Five colour combinations. Wear one. You are a vampire, act like it."]
	quest.6E847C301F9A369F.quest_subtitle: "Purely a fashion statement"
	quest.6E847C301F9A369F.title: "The Cloak"
	quest.6ECF8A829140D3C8.quest_desc: [
		"&bYou are still human. That is the whole point.&r"
		""
		"No sun damage. No silver allergy. No blood bar, no forced transformation, and no vampire can ever turn you again."
		""
		"What you have instead is &6equipment&r, and this faction has more of it than the other two combined."
		""
		"&6Left side&r is garlic and the vaccine chain. &6Middle&r is your level ladder, which runs through the Hunter Table. &6Right side&r is the arsenal."
		""
		"&4Warning: your progression is the slowest of the three, and every level costs a fee.&r"
	]
	quest.6ECF8A829140D3C8.quest_subtitle: "You are a Vampire Hunter, level 1"
	quest.6ECF8A829140D3C8.title: "The Vaccine"
	quest.6F2D5E0850FE5702.quest_desc: [
		"Heavy armour only gets in the way."
		""
		"&7The Wandering Magician set gives mana and cast speed instead of armour points. That trade is the whole build.&r"
	]
	quest.6F2D5E0850FE5702.quest_subtitle: "Full Wandering Magician set"
	quest.6F2D5E0850FE5702.title: "Robes of the Wise"
	quest.6F4EF68011255A3D.quest_desc: [
		"A compacted crossbow that holds a sequence of bolts and fires them in the order you loaded them."
		""
		"Bolts are coated by placing them inside a placed oil pot. A &6Bolt Cartridge&r bulk-loads a whole sequence at once - crouch and use it to fill it from your inventory."
		""
		"&7Poison, then fatigue, then acid, in that order, is a very rude opening.&r"
	]
	quest.6F4EF68011255A3D.quest_subtitle: "One-handed, repeating, and it fires oil"
	quest.6F4EF68011255A3D.title: "The Cyclebow"
	quest.6F9400EEFF10E0D6.quest_desc: [
		"Craft a Binding, find a low-level Vampire NPC, and right-click it. It is yours."
		""
		"&7Order it to defend you, defend an area, or go and collect blood on its own.&r"
	]
	quest.6F9400EEFF10E0D6.quest_subtitle: "Right-click a weak vampire NPC with it"
	quest.6F9400EEFF10E0D6.title: "Vampire Minion Binding"
	quest.703E7C361254E1A9.quest_desc: ["The centrepiece. Place it down, cut slices, share it with people who will not ask what is in it."]
	quest.703E7C361254E1A9.quest_subtitle: "A whole pie, for a whole coven"
	quest.703E7C361254E1A9.title: "Blood Pie"
	quest.709599920E45826A.quest_desc: ["Build the technological side of the hunter arsenal."]
	quest.709599920E45826A.quest_subtitle: "Advancement"
	quest.709599920E45826A.title: "Technology"
	quest.70CF3499EDB26B57.quest_desc: ["The Arcane Anvil applies runes and upgrade orbs to your equipment. This is where mana gear stops being decorative."]
	quest.70CF3499EDB26B57.quest_subtitle: "Upgrade gear with runes"
	quest.70CF3499EDB26B57.title: "Arcane Anvil"
	quest.70E72EE169F70179.quest_desc: ["&8There is an advancement for this. That is all this quest will say about it.&r"]
	quest.70E72EE169F70179.quest_subtitle: "Some hunters change their minds"
	quest.70E72EE169F70179.title: "Betrayal"
	quest.71100E5E3FB261CF.quest_desc: [
		"Vanilla food will keep you upright. It will not keep you strong."
		""
		"The Cooking Pot is the entry point to everything in the kitchen, including the &cblood cuisine&r you will want later if you go pale."
	]
	quest.71100E5E3FB261CF.quest_subtitle: "Farmer's Delight - Cooking Pot"
	quest.71100E5E3FB261CF.title: "Something Warm"
	quest.7135357D57AD5CFC.quest_desc: [
		"The elite versions of both factions. They carry better gear, they hit harder, and they drop the good materials."
		""
		"&7Advanced Vampires drop Vampire Books. Advanced Hunters drop hunter gear.&r"
	]
	quest.7135357D57AD5CFC.quest_subtitle: "Advanced Vampires and Advanced Hunters"
	quest.7135357D57AD5CFC.title: "The Advanced Ones"
	quest.7152867EFEA01AB5.quest_desc: [
		"Ink comes in five grades: &7common&r, &agreen uncommon&r, &brare&r, &5epic&r and &6legendary&r. Better ink means higher spell levels."
		""
		"&7Common ink is cheap. Legendary ink is a boss drop or deep loot.&r"
	]
	quest.7152867EFEA01AB5.quest_subtitle: "The raw material of every spell"
	quest.7152867EFEA01AB5.title: "Ink and Paper"
	quest.71A951AD7930CC79.quest_desc: ["Bottles are too big and too fragile. Vials measure properly, and reinforced with copper they become a component."]
	quest.71A951AD7930CC79.quest_subtitle: "Precision containers"
	quest.71A951AD7930CC79.title: "Glass Vials"
	quest.71BA836D8FE3D722.quest_desc: [
		"&6/team create <name>&r makes a party. &6/team invite <player>&r brings someone in."
		""
		"Team members share chunk claims and can share quest rewards. On a faction server this matters: a lone vampire is a target, a coven is a problem."
		""
		"&7Some quests in this book are marked as team rewards - only one member needs to finish them.&r"
	]
	quest.71BA836D8FE3D722.quest_subtitle: "Information - FTB Teams"
	quest.71BA836D8FE3D722.title: "Blood Is Thicker"
	quest.71FA7BB7A8E58C49.quest_desc: ["Kobolds, sporelings, pegasi, and an Automaton guarding its own structure."]
	quest.71FA7BB7A8E58C49.quest_subtitle: "Basilisk, Drake, Chupacabra, Automaton"
	quest.71FA7BB7A8E58C49.title: "Mobs of Mythology"
	quest.720EEBDD00DC45F0.quest_desc: [
		"Wolfsbane is the werewolf equivalent of garlic - it weakens you, and hunters plant it on purpose."
		""
		"&7A &6Wolfsbane Diffuser&7 keeps enemy werewolves out of a base. Yes, you can build one against other players.&r"
	]
	quest.720EEBDD00DC45F0.quest_subtitle: "The plant that hates you"
	quest.720EEBDD00DC45F0.title: "Wolfsbane"
	quest.727D6E17821504DE.quest_desc: ["The container every weapon oil lives in. Make several."]
	quest.727D6E17821504DE.quest_subtitle: "Clay and poison paste, fired in a furnace"
	quest.727D6E17821504DE.title: "Oil Pots"
	quest.72C2FCFB96A3517C.quest_desc: ["Crafted in a normal crafting table. Grind ingredients together, then collect the result with the right tool."]
	quest.72C2FCFB96A3517C.quest_subtitle: "Everything starts here"
	quest.72C2FCFB96A3517C.title: "Mortar and Pestle"
	quest.72EE6612641EFD4F.quest_desc: [
		"This is a PvP world. Unclaimed ground is anyone's ground."
		""
		"&aOpen the map with &6M&a.&r Left-click a chunk to &aclaim&r it, then left-click again to &aforce-load&r it (force-loaded chunks keep ticking while you are offline - use them sparingly)."
		""
		"Claimed chunks stop other players from breaking, placing, and opening your containers. &7They do not stop a vampire from biting you in the street.&r"
		""
		"&8Waypoints: press &6J&8 for the minimap options, &6M&8 for the full map.&r"
	]
	quest.72EE6612641EFD4F.quest_subtitle: "Information - FTB Chunks"
	quest.72EE6612641EFD4F.title: "Claim What Is Yours"
	quest.732D94C2B54C793E.quest_desc: ["The signature hunter set. Three tiers, each a real step up."]
	quest.732D94C2B54C793E.quest_subtitle: "Made at the Weapon Table"
	quest.732D94C2B54C793E.title: "The Hunter Coat"
	quest.7385A8C99C2963FE.quest_desc: [
		"Inject garlic into an animal and it becomes poisonous to bite. You can spot an injected mob by the &2green fangs&r above it."
		""
		"&7Fill a village's livestock with garlic and you have starved out every vampire in the area.&r"
	]
	quest.7385A8C99C2963FE.quest_subtitle: "Poison the food supply"
	quest.7385A8C99C2963FE.title: "Garlic Injections"
	quest.73F708905CDEFD5E.quest_desc: ["Everyone who walks into your base should know what you did."]
	quest.73F708905CDEFD5E.quest_subtitle: "Put it on your wall"
	quest.73F708905CDEFD5E.title: "Mount the Trophy"
	quest.74434211F14B4096.quest_desc: [
		"Illager Invasion adds Basher, Provoker, Marauder, Sorcerer, Archivist, Firecaller, Necromancer, Alchemist, Invoker and the Inquisitor."
		""
		"&7They also join raids. A village raid in this pack is a real fight.&r"
	]
	quest.74434211F14B4096.quest_subtitle: "Illager Invasion"
	quest.74434211F14B4096.title: "Illager Fort"
	quest.7457EE91B32A96BC.quest_desc: [
		"It is blind, it is faster than you, and it hits through armour."
		""
		"&7A Zealot vampire is arguably built for the Deep Dark. Arguably.&r"
	]
	quest.7457EE91B32A96BC.quest_subtitle: "You do not have to. But you could."
	quest.7457EE91B32A96BC.title: "The Warden"
	quest.7475C2525083529A.quest_subtitle: "This is pretty much impossible"
	quest.75480C923484A0F1.quest_desc: [
		"Abandoned silver workings. Werewolves should think twice before going in."
		""
		"&7There is a smaller Lost Silver Mine variant as well.&r"
	]
	quest.75480C923484A0F1.quest_subtitle: "Toxony"
	quest.75480C923484A0F1.title: "The Lost Silver Mine"
	quest.7598282148328A56.quest_desc: [
		"&4This pack does not include the Vampirism guide book.&r Guide-API is not installed, so that item does not exist here. Do not go looking for it."
		""
		"&6Use JEI instead.&r Press &6R&r on any item to see how it is made, and &6U&r to see what it is used for. Every altar, ritual item and piece of gear in this book can be looked up that way."
		""
		"&7This quest book tells you what to do and in what order. JEI tells you the exact recipe. You will need both.&r"
	]
	quest.7598282148328A56.quest_subtitle: "Information - JEI is your manual"
	quest.7598282148328A56.title: "Look It Up"
	quest.75AC1BC2F2AF8E0B.quest_desc: ["Applied at the Arcane Anvil. Raises the power of every blood spell you cast."]
	quest.75AC1BC2F2AF8E0B.quest_subtitle: "Specialise your gear"
	quest.75AC1BC2F2AF8E0B.title: "Blood Rune"
	quest.75F2421C72269550.title: "Geared Up"
	quest.75F889761E3E6393.quest_desc: ["Wait for it to go down. Then make it permanent."]
	quest.75F889761E3E6393.quest_subtitle: "Finish off a vampire with a stake"
	quest.75F889761E3E6393.title: "Staked"
	quest.764A6238AB42EE9E.quest_desc: [
		"The Dead King sends undead until your stamina runs out."
		""
		"&6Kill the summoners first.&r The King himself is the easy part."
	]
	quest.764A6238AB42EE9E.quest_subtitle: "The Dead King"
	quest.764A6238AB42EE9E.title: "Lord of the Catacombs"
	quest.768AF4323E57221E.quest_desc: ["Blood, garlic, hearts, pelts. Every faction in this pack is an inventory problem. Solve it early."]
	quest.768AF4323E57221E.quest_subtitle: "You will be carrying a lot of bottles"
	quest.768AF4323E57221E.title: "Deeper Pockets"
	quest.76B916AA998A252F.quest_desc: [
		"Vampires equip three accessory slots in the Vampirism menu: an &6Amulet&r, a &6Ring&r and an &6Obi Belt&r."
		""
		"Each one carries &crefinements&r that modify your skills - longer bat form, stronger bite, faster regeneration and so on."
		""
		"&7You get them as task rewards from Vampire Representatives, and from chests in vampire structures. Once equipped they bind to you.&r"
	]
	quest.76B916AA998A252F.quest_subtitle: "Amulet, Ring, Obi Belt"
	quest.76B916AA998A252F.title: "Refinements"
	quest.771279FF4CC345AE.quest_desc: [
		"A fire that does not spread and does not damage blocks, but burns indefinitely."
		""
		"&7Ring your base with it. Vampires take extra damage from fire, and this one never goes out.&r"
	]
	quest.771279FF4CC345AE.quest_subtitle: "Burns forever, spreads never"
	quest.771279FF4CC345AE.title: "Alchemical Fire"
	quest.77908F73BF321FD7.quest_desc: ["Organic Compost turns dirt into Rich Soil, and crops on Rich Soil grow noticeably faster. With Serene Seasons cutting your growing window, this matters."]
	quest.77908F73BF321FD7.quest_subtitle: "Grow faster"
	quest.77908F73BF321FD7.title: "Rich Soil"
	quest.78495256295EBBF8.quest_desc: ["Set a minion to defend an area and it will hold that spot against anything that walks in."]
	quest.78495256295EBBF8.quest_subtitle: "Minion defence orders"
	quest.78495256295EBBF8.title: "Hold This Ground"
	quest.78772AB8BD0C7510.quest_desc: [
		"&6Every minion has levels, and every level gives them a stat point you assign yourself.&r"
		""
		"The upgrade items come in three grades and cover different level ranges. You get them as &6Representative task rewards&r - they are not craftable."
		""
		"&cVampires:&r Vampire Minion Upgrade, Enhanced, Special."
		"&bHunters:&r Hunter Minion Upgrade, Enhanced, Special."
		"&6Werewolves:&r Werewolf Minion Upgrade, Enhanced, Special."
		""
		"&7Stats you can raise: health, damage, speed, and resource-gathering efficiency.&r"
	]
	quest.78772AB8BD0C7510.quest_subtitle: "Simple, Enhanced, Special"
	quest.78772AB8BD0C7510.title: "Upgrade Your Minions"
	quest.7898E4FB5379EE88.quest_desc: [
		"The Ancient City rewards patience. The Warden does not."
		""
		"&8It is blind. It hears you. Wool blocks sound, and sneaking is not optional.&r"
		""
		"&7You do not have to kill it to loot the city. But this quest says kill it.&r"
	]
	quest.7898E4FB5379EE88.quest_subtitle: "The Warden"
	quest.7898E4FB5379EE88.title: "The Guardian of the Deep"
	quest.79C2E4A6F6F018C0.quest_desc: [
		"Your first spell book. Few slots, low spell level cap, but it works."
		""
		"&7Equip it in your off-hand or in a curio slot depending on the book, then use the spell wheel to select and cast.&r"
	]
	quest.79C2E4A6F6F018C0.quest_subtitle: "Copper Spell Book"
	quest.79C2E4A6F6F018C0.title: "A Book of Your Own"
	quest.79DCA24F0C0F38FB.quest_subtitle: "TO DO"
	quest.79DCA24F0C0F38FB.title: "The End Game"
	quest.7A65AE13A57FC17B.quest_desc: [
		"The Diffuser fills the air with garlic. Any vampire in range is weakened and disoriented, and - importantly - &6cannot turn into a bat&r."
		""
		"Three strengths: weak, normal, improved. The improved one needs an Improved Diffuser Core."
		""
		"&7This is the single best anti-vampire base defence in the pack.&r"
	]
	quest.7A65AE13A57FC17B.quest_subtitle: "Keep them out of your base"
	quest.7A65AE13A57FC17B.title: "Garlic Diffuser"
	quest.7A7B43EF77024E9F.quest_desc: [
		"Ectotherm vampires spawn commonly in &bcold biomes&r. Kill one with a Heartseeker or Heartstriker and it drops a Frozen Blood Sample."
		""
		"&7Use the Bloodline Tester to find one before you waste a fight.&r"
	]
	quest.7A7B43EF77024E9F.quest_subtitle: "Only from Ectotherm vampires"
	quest.7A7B43EF77024E9F.title: "Frozen Blood Samples"
	quest.7A7FF2C82684888E.quest_desc: ["Right-click a Cutting Board with an ingredient, then with a knife. This is how you get most of the raw components."]
	quest.7A7FF2C82684888E.quest_subtitle: "Cutting Board"
	quest.7A7FF2C82684888E.title: "Knife and Board"
	quest.7ACFF6A5208F5F56.quest_desc: ["Scales your blood magic and hits things when the mana runs out."]
	quest.7ACFF6A5208F5F56.quest_subtitle: "A weapon that casts"
	quest.7ACFF6A5208F5F56.title: "Blood Staff"
	quest.7AD714CC471B4E4C.quest_desc: [
		"&bHow to join:&r brew a &bFreezing Elixir&r from Frozen Blood Samples and drink it."
		""
		"Then, while the effect is active, you must &4die from sun damage while submerged in shallow water&r. Do it right and the cold takes you instead of the sun."
		""
		"&aWhat you get:&r swim speed, free movement through ice, no sun damage underwater, fast mining underwater, fish count as blood, and the Lord of Frost action at rank 2."
		""
		"&cWhat it costs:&r fire hurts far more, and your vampiric bonuses are gutted in hot biomes."
	]
	quest.7AD714CC471B4E4C.quest_subtitle: "Die correctly, in cold water"
	quest.7AD714CC471B4E4C.title: "Ectotherm"
	quest.7B181D56EBBB5B48.quest_desc: ["Black Mushroom Soup and Black Mushroom Noodles. Grow them on Bloody Soil in the dark."]
	quest.7B181D56EBBB5B48.quest_subtitle: "They grow where the light does not reach"
	quest.7B181D56EBBB5B48.title: "Black Mushrooms"
	quest.7B61E79B538A1840.quest_desc: [
		"&5Let the animals fight over raw meat.&r You want arcane power."
		""
		"This chapter is the alternative career: no faction bonuses, no natural armour, no regeneration. Everything you get, you built."
		""
		"&7See the chapter 'Blood and Spellcraft' for the full magic progression. This one is the challenge run.&r"
	]
	quest.7B61E79B538A1840.quest_subtitle: "Inscription Table and a book"
	quest.7B61E79B538A1840.title: "The First Spark"
	quest.7BA30EC45686E6AC.quest_desc: [
		"&4A vampire that runs out of health does not die. It collapses, waits, and gets back up.&r"
		""
		"The Stake finishes a downed vampire permanently. It is also the only way to collect &cVampire Blood&r, which is what you level up with."
		""
		"&7Carry one at all times. Killing a vampire without one is a waste of a fight.&r"
	]
	quest.7BA30EC45686E6AC.quest_subtitle: "How you actually kill a vampire"
	quest.7BA30EC45686E6AC.title: "The Stake"
	quest.7C5D28803C5A99A5.quest_desc: ["More damage per shot, slower to reload. Good for opening a fight."]
	quest.7C5D28803C5A99A5.quest_subtitle: "Two bolts, one trigger"
	quest.7C5D28803C5A99A5.title: "Double Crossbow"
	quest.7CE0E289EE263052.title: "Kill 250x Beast Werewolves"
	quest.7D9A5E937266CA2C.quest_desc: [
		"A real realm needs a real warehouse."
		""
		"&7Put the Controller in the middle of a wall of drawers and it indexes all of them. Tom's Simple Storage can then read the whole wall through one terminal.&r"
	]
	quest.7D9A5E937266CA2C.quest_subtitle: "Storage Drawers"
	quest.7D9A5E937266CA2C.title: "Heart of the Kingdom"
	quest.7D9F46D033C10B5F.title: "It's a party"
	quest.7E2A5534EAADD934.quest_desc: ["A little cruelty goes a long way."]
	quest.7E2A5534EAADD934.quest_subtitle: "Freeze something to death"
	quest.7E2A5534EAADD934.title: "Cold Blood"
	quest.7E6BBCF6FE9CFC58.quest_desc: [
		"The Remains do not fight. The &dAncient Crystals&r around them do."
		""
		"&7Break them before you touch anything else, or you will be fighting the whole room at once.&r"
	]
	quest.7E6BBCF6FE9CFC58.quest_subtitle: "Kill the Remains Defenders"
	quest.7E6BBCF6FE9CFC58.title: "Ancient Crystals"
	quest.7E7FDAA437F04D62.title: "Kill: 1000x Vampire Hunters"
	quest.7EA03EB6C0DF91A7.quest_desc: [
		"Vampire Villagers can be brought back. It takes an infested apple and patience."
		""
		"&7Every villager you cure is one the vampires cannot drink.&r"
	]
	quest.7EA03EB6C0DF91A7.quest_subtitle: "Mercy, of a sort"
	quest.7EA03EB6C0DF91A7.title: "Cure a Vampire Villager"
	quest.7EE45E13DF130FF0.quest_desc: [
		"Build your own chair at base. Any injection can be administered here."
		""
		"&7If Vampiric Ageing is running, this is also where you check your Age Rank as a hunter.&r"
	]
	quest.7EE45E13DF130FF0.quest_subtitle: "Stop walking to the village"
	quest.7EE45E13DF130FF0.title: "Your Own Injection Chair"
	quest.7F7F7BAD06C68675.quest_desc: [
		"&5Iron's Spellbooks adds a full magic system, and this pack wires it into the factions.&r"
		""
		"Spells are inscribed onto &6scrolls&r, then bound into a &6spell book&r. Casting costs &bmana&r, which regenerates on its own and can be increased with gear."
		""
		"There are ten schools. The one that matters here is &4Blood&r."
		""
		"&cThe Vampire Spells addon on this server changes Ray of Siphoning:&r creatures of the night have twisted it to feed. It drains health from what it hits and heals you for the full amount."
		""
		"&7Nothing in this chapter is required. It is a whole second progression running alongside your faction, and it is the strongest ranged option in the pack.&r"
	]
	quest.7F7F7BAD06C68675.quest_subtitle: "Open to every faction"
	quest.7F7F7BAD06C68675.title: "Words That Cost Blood"
