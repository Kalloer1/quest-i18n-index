{
	file.0000000000000001.title: "SkyTech Evolution"
	chapter_group.4E06BB3DD10B837B.title: "Main Questline"
	chapter_group.3E3B6463983F18FB.title: "Tech and Automation"
	chapter_group.33401D44ADADF4FC.title: "Magic and Alternatives"
	chapter_group.293B0513F4340751.title: "Dimensions and Endgame"
	chapter_group.50524F4A45435453.title: "Projects and Challenges"
	chapter_group.7777C0FFEE000001.title: "Optional, Support and Completionist"
	chapter.097C000000000000.title: "Welcome to the Sky"
	chapter.097C000000000000.subtitle: "Intro only; rewards begin with real actions"
	chapter.097C000000000001.title: "The First Root"
	chapter.097C000000000001.subtitle: "Make the starter tree renewable before scaling"
	chapter.097C000000000002.title: "Living Resources"
	chapter.097C000000000002.subtitle: "Resource trees reward real collection steps"
	chapter.097C00000000002A.title: "Ex Deorum Support Route"
	chapter.097C00000000002A.subtitle: "Required composting and fluids, optional sieving and hammering"
	chapter.097C000000000003.title: "Storage and Logistics"
	chapter.097C000000000003.subtitle: "Drawers first; controller and routing after Redstone"
	chapter.097C000000000004.title: "Create Factory"
	chapter.097C000000000004.subtitle: "Create rewards come from assembling the line"
	chapter.097C000000000005.title: "Power and Machines"
	chapter.097C000000000005.subtitle: "Stable FE, real machines and optional powered building tools"
	chapter.097C000000000006.title: "Growth and Utility"
	chapter.097C000000000006.subtitle: "Growth, bees, crops and magic now point to their Void bootstrap routes"
	chapter.097C000000000008.title: "Industrial Foundations"
	chapter.097C000000000008.subtitle: "Industry explains gated bridge materials before machine chains"
	chapter.097C000000000009.title: "Digital Storage"
	chapter.097C000000000009.subtitle: "RS stays simple; AE2 is optional and now names its Void bridges"
	chapter.097C00000000000A.title: "Mob Data and Dimensions"
	chapter.097C00000000000A.subtitle: "Mob data explains first contact, matrices and controlled drops"
	chapter.097C00000000000B.title: "Final Automation"
	chapter.097C00000000000B.subtitle: "Connect systems instead of manually stockpiling"
	chapter.097C00000000000C.title: "Building and QoL"
	chapter.097C00000000000C.subtitle: "Comfort, safety and building tools for cleaner play"
	chapter.097C00000000000D.title: "Completionist"
	chapter.097C00000000000D.subtitle: "Late review goals after the main route works"
	chapter.097C000000000014.title: "Sky Coin Shop"
	chapter.097C000000000014.subtitle: "Repeatable support bundles; choose what helps, do not buy everything"
	quest.1796D04D4033877C.title: "Early Recovery Bundle"
	quest.1796D04D4033877C.quest_desc: ["A recovery button, not the main route. Use it if the first island", "goes wrong and you want to keep playing instead of restarting."]
	quest.7E8BB6C4F5B06834.title: "Storage Support Bundle"
	quest.7E8BB6C4F5B06834.quest_desc: ["A compact organization kit for a base that has reached Storage and the Redstone Tree.", "The pipe route is support for an unlocked system, not a shortcut around the Orchard progression."]
	quest.30604E2BE9954595.title: "Create Support Bundle"
	quest.30604E2BE9954595.quest_desc: ["A prototype refill for Create experiments you already unlocked.", "It should keep you building, not skip the Create chapter."]
	quest.3BE6B4FF1A014F7F.title: "Power Support Bundle"
	quest.3BE6B4FF1A014F7F.quest_desc: ["A power debugging kit. Buy it when cable testing becomes boring,", "not as your main source of redstone or energy parts."]
	quest.57917F71279F34B5.title: "Orchard Support Bundle"
	quest.57917F71279F34B5.quest_desc: ["A growth support kit for orchard expansion. It helps trees recover", "and gives one bee cage for later resource scaling without replacing", "the tree loop."]
	quest.1D17E788C3069687.title: "Industrial Support Bundle"
	quest.1D17E788C3069687.quest_desc: ["A small industrial refill for a factory that has already started.", "Plastic and circuits reduce repetition, but machines still need to", "be earned through the chapter."]
	quest.6F20B503F79727C8.title: "Network Support Bundle"
	quest.6F20B503F79727C8.quest_desc: ["A network refill for the first digital-storage mistakes. It helps", "processor binding and quartz enriched iron without buying a whole", "system."]
	quest.5F751E77EB522DEE.title: "Late Game Review Token"
	quest.5F751E77EB522DEE.quest_desc: ["A late-game celebration purchase. This is not early progression;", "it is a reward for reaching the point where rare drops are already", "under control."]
	chapter.097C0000000000F0.title: "Main Route Roadmap"
	chapter.097C0000000000F0.subtitle: "Read-only route overview; real work happens in the chapters"
	quest.1130000000000001.title: "How To Read The Route"
	quest.1130000000000003.title: "01 - First Root"
	quest.1130000000000003.quest_desc: ["Make the first tree renewable. Logs give resin, leaves give", "fiber and saplings, and the Crook improves leaf recovery."]
	quest.1130000000000005.title: "02 - Living Core"
	quest.1130000000000005.quest_desc: ["Turn the starter loop into the Living Skyroot Core. This proves", "you can recover from mistakes before scaling."]
	quest.1130000000000007.title: "03 - Orchard Materials"
	quest.1130000000000007.quest_desc: ["Resource trees are the pack identity: resin from logs, acorns", "from leaves, and matching pairs become materials."]
	quest.1130000000000009.title: "04 - Storage Wall"
	quest.1130000000000009.quest_desc: ["Sort repeated outputs before adding more production. This is", "step 04 in the main route, before Create, power and industry."]
	quest.113000000000000B.title: "05 - Create Line"
	quest.113000000000000B.quest_desc: ["Build one visible processing line after storage is readable. Motion,", "pressing, milling and washing should be understood before power."]
	quest.113000000000000D.title: "06 - Power"
	quest.113000000000000D.quest_desc: ["Create rotation comes first; FE comes after. Start with one", "generator, one cable route and one powered machine."]
	quest.113000000000000F.title: "07 - Industry"
	quest.113000000000000F.quest_desc: ["Use stable power for real processing: enrichment, circuits,", "steel, plastic and machine frames."]
	quest.1130000000000011.title: "08 - Digital Storage"
	quest.1130000000000011.quest_desc: ["Add a small network only after bulk storage works. Digital", "storage is access and crafting, not a garbage dump."]
	quest.1130000000000013.title: "09 - Mob Data"
	quest.1130000000000013.quest_desc: ["Turn common mob drops into controlled production. HNN reduces", "repeat grinding after the first real drops are earned."]
	quest.1130000000000015.title: "10 - Nether and End"
	quest.1130000000000015.quest_desc: ["Blaze, ghast, wither and End materials stay milestones. Automate", "them later; do not shortcut the first encounter."]
	quest.1130000000000017.title: "11 - Final Automation"
	quest.1130000000000017.quest_desc: ["Bring the main systems together. The finale should test", "automation and routing, not manual stockpiling."]
	quest.1130000000000019.title: "Welcome to SkyTech Evolution"
	quest.113000000000001B.title: "Use The Roadmap"
	quest.113000000000001D.title: "Main Quests Teach Systems"
	quest.113000000000001F.title: "Side Routes Are Tools"
	quest.113000000000001F.quest_desc: ["Side routes are tools. Use them when they help your island,", "but do not treat every optional branch as homework.", "Factory Contracts and Playthrough Projects now live in their own optional Projects and Challenges group."]
	quest.1130000000000021.title: "Rewards Should Help, Not Skip"
	quest.1130000000000023.title: "Begin The First Root"
	quest.1130000000000023.quest_desc: ["Your first real job is simple: make the tree renewable, protect", "a sapling, and turn random drops into a stable resource loop."]
	quest.1130000000000027.title: "One Dirt, One Root"
	quest.1130000000000029.title: "Logs Give Resin"
	quest.113000000000002C.title: "Leaves Give Fiber"
	quest.113000000000002E.title: "Crook The Leaves"
	quest.113000000000002E.quest_desc: ["Use the Crook when you want better leaf recovery. It is not", "shears and not an axe; it is the Skyblock leaf tool.", "If drops feel confusing, compare leaf outputs with and without it."]
	quest.1130000000000030.title: "Backup Sapling First"
	quest.1130000000000030.quest_desc: ["Secure one spare sapling before spending the first tree outputs on bigger crafts.", "A beginner-friendly Skyblock start should survive one mistake without forcing a restart."]
	quest.1130000000000033.title: "Living Compost"
	quest.1130000000000033.quest_desc: ["Blend Skyroot Fiber and Resin into Living Compost.", "Do not craft Dirt directly: the next quest teaches the renewable Barrel route."]
	quest.1130000000000035.title: "Stabilize The New Soil"
	quest.1130000000000035.quest_desc: ["Use the extra Dirt made in the Skyroot Barrel to craft Rootbound Soil.", "Rootbound Soil is the exact Tier-2 base for Dirt, Gravel, Sand and Clay trees."]
	quest.1130000000000037.title: "Prepare Living Soil"
	quest.1130000000000037.quest_desc: ["Living Soil unlocks the Tier-3 orchard: Coal, Copper and Iron.", "All orchard soils use the same Bonsai loot-roll count; Soil only controls which tier can grow.", "The first metal Saplings still require the Basic and Metal Orchard Cores later in the route."]
	quest.1130000000000039.title: "Compost Your Second Dirt"
	quest.1130000000000039.quest_desc: ["Craft the Skyroot Barrel from Skyroot Planks and a Slab.", "Place eight Skyroot Leaves or Saplings into it: each adds 125 mB, so eight complete one Dirt.", "Keep the original island Dirt under your tree. Tick the checkmark only after the Barrel has produced the second Dirt."]
	quest.113000000000003E.title: "Metals Belong To The Orchard"
	quest.113000000000003E.quest_desc: ["Do not hand-filter copper or iron from the same starter recipe as sand.", "Wake the Living Core first; the Orchard will become the real metal source."]
	quest.1130000000000041.title: "Awaken The Living Core"
	quest.1130000000000041.quest_desc: ["The Living Skyroot Core opens the resource-tree route.", "Copper and iron deliberately wait until their own trees are established."]
	quest.1130000000000044.title: "The Orchard Opens"
	quest.1130000000000048.title: "Ready For Resource Trees"
	quest.1130000000000048.quest_desc: ["You have reached the point where resource trees can become a", "real system. The small drawer sample is a storage reminder, not", "a replacement for the Storage chapter."]
	quest.113000000000004A.title: "Resource Tree Rules"
	quest.113000000000004C.title: "Start The Dirt Orchard"
	quest.113000000000004C.quest_desc: ["The Barrel creates the first renewable Dirt; the Dirt Tree turns it into scalable production.", "Process 2 Dirt Acorns with 1 Dirt Resin. The old four-acorn and Compost-to-Dirt shortcuts are removed."]
	quest.113000000000004E.title: "Dirt Acorn + Dirt Resin"
	quest.113000000000004E.quest_desc: ["Harvest both Dirt Acorns and Dirt Resin from the tree.", "One matching Resin plus two Acorns is the single clear Orchard recipe for Dirt."]
	quest.1130000000000051.title: "Gravel And Sand Orchards"
	quest.1130000000000051.quest_desc: ["Unlock Gravel first, then Sand. Process each with its matching Resin and two Acorns.", "The only other valid route is Ex Deorum: Hammer Cobblestone into Gravel, then Gravel into Sand."]
	quest.1130000000000054.title: "Clay Orchard"
	quest.1130000000000054.quest_desc: ["Clay completes the Tier-2 utility orchard.", "Use Clay Resin plus two Clay Acorns for Clay Balls, or mix Ex Deorum Dust with 1000 mB Water in a Barrel.", "The Bone Meal reward helps form Porcelain Clay for the fluid route; no Dirt, Gravel, Sand or Clay is given as a quest reward."]
	quest.1130000000000057.title: "Coal Tree For Fuel"
	quest.1130000000000057.quest_desc: ["Coal is the first Metal-Orchard tree and supplies the binder for Copper.", "Establish it before trying to craft the Copper Tree."]
	quest.1130000000000059.title: "Grow Copper First"
	quest.1130000000000059.quest_desc: ["Copper begins with a real Copper Tree made from Coal-Orchard outputs.", "Collect Copper Acorns and Copper Resin before moving on to Iron."]
	quest.113000000000005C.title: "Grow Iron And Process The First Metals"
	quest.113000000000005F.title: "Basic Orchard Core"
	quest.113000000000005F.quest_desc: ["Water, Lava, Cobblestone, the Furnace and your first Bonsai Pot must now be available.", "The Pot is bound into this core and returned as the quest reward, so the real orchard can start without losing it."]
	quest.1130000000000061.title: "Metal Orchard Core"
	quest.1130000000000061.quest_desc: ["This core unlocks the Coal, Copper and Iron sequence.", "It does not give metal by itself; the actual resources still have to grow on trees."]
	quest.1130000000000065.title: "Sort Before Scaling"
	quest.1130000000000067.title: "How Ex Deorum Fits"
	quest.1130000000000067.quest_desc: ["SkyTech uses Ex Deorum selectively instead of turning the pack into a sieve grind.", "Barrel composting and both Crucibles are part of the main route. Sieving and hammering are optional support methods."]
	quest.1130000000000069.title: "Sieve Dirt For Pebbles"
	quest.1130000000000069.quest_desc: ["Craft the Skyroot Sieve with the pack's own Skyroot wood.", "A String Mesh can sift renewable Barrel or Orchard Dirt for Stone Pebbles and useful seeds.", "This is a support route, not the source of early Copper or Iron."]
	quest.113000000000006B.title: "Fit A String Mesh"
	quest.113000000000006B.quest_desc: ["Turn Skyroot Fiber into String and craft the String Mesh.", "The quest gives no free Sand, Clay or Flint: collect outputs from the actual Ex Deorum process."]
	quest.113000000000006D.title: "Hammer The Material Chain"
	quest.113000000000006D.quest_desc: ["Use the Wooden Hammer for the native Ex Deorum chain: Cobblestone → Gravel → Sand → Dust.", "The Orchard remains the scalable main source, while Hammering is a clean backup and conversion tool."]
	quest.113000000000006F.title: "Dust And Water Become Clay"
	quest.113000000000006F.quest_desc: ["Fill a Barrel with 1000 mB Water and add one Ex Deorum Dust to create a Clay block.", "Together with Barrel Dirt and Hammered Gravel/Sand, this is the only non-Orchard source for the four basic ground materials."]
	quest.1130000000000072.title: "Storage Comes Before Scaling"
	quest.1130000000000074.title: "One Drawer Per Bulk Output"
	quest.1130000000000074.quest_desc: ["Give logs, resin, acorns, traces and base blocks their own spots.", "Skyroot Planks can craft the Oak Drawer output used by this quest, so no oak sapling or sieve detour is required."]
	quest.1130000000000076.title: "Centralize After Redstone"
	quest.1130000000000078.title: "Use A Visible Buffer"
	quest.1130000000000078.quest_desc: ["Before pipes and machines, give items a visible stopping point.", "A chest or barrel buffer makes early routing easier to debug and prevents invisible item problems."]
	quest.113000000000007A.title: "Move One Stream First"
	quest.113000000000007A.quest_desc: ["Once the Redstone-gated Controller exists, move one item stream before building a full logistics web.", "Route one Bonsai or machine output into the prepared drawer wall and confirm every item reaches the correct place."]
	quest.113000000000007C.title: "Overflow Is A Guardrail"
	quest.113000000000007C.quest_desc: ["Trash and void upgrades are safety tools, not shortcuts.", "Use them only after drawers are locked and overflow is understood."]
	quest.113000000000007E.title: "Collect Tree Drops Cleanly"
	quest.113000000000007E.quest_desc: ["A collector is helpful once manual pickup becomes annoying. Aim", "it at a buffer you understand."]
	quest.1130000000000080.title: "Logistics Core"
	quest.1130000000000080.quest_desc: ["A clean storage wall is a momentum upgrade. Once drops stop", "spreading everywhere, the base feels ready for machines."]
	quest.1130000000000084.title: "Ready For Create"
	quest.1130000000000084.quest_desc: ["A Drawer wall and a visible buffer are enough to begin Create.", "The Controller, Pipez and advanced logistics remain a separate branch", "that opens after the Mechanical route reaches the Redstone Tree."]
	quest.1130000000000086.title: "Start Create Small"
	quest.1130000000000088.title: "Andesite Alloy Batch"
	quest.1130000000000088.quest_desc: ["Make a small batch, then look at how Create can repeat material", "steps. This should be the start of automation, not another hand grind."]
	quest.113000000000008A.title: "Shafts And Cogwheels"
	quest.113000000000008A.quest_desc: ["Shafts carry rotation; cogwheels redirect it. Keep the first", "setup simple and reachable."]
	quest.113000000000008D.title: "First Steady Rotation"
	quest.113000000000008D.quest_desc: ["A water wheel gives steady motion. Put it where you can still", "see and fix the machines it powers."]
	quest.113000000000008F.title: "Depot And Press"
	quest.113000000000008F.quest_desc: ["A depot and press are only the workstation.", "The next step is proving that you can actually press sheets", "with rotation and a real input item."]
	quest.1130000000000092.title: "Pressed Iron Sheets"
	quest.1130000000000092.quest_desc: ["Iron sheets prove the first processing upgrade. Later this", "should become automatic."]
	quest.1130000000000094.title: "Millstone Processing"
	quest.1130000000000094.quest_desc: ["The millstone is your first useful processing cell. Use it to", "turn base materials into cleaner routes before big machines."]
	quest.1130000000000096.title: "Fan Washing"
	quest.1130000000000096.quest_desc: ["Fan processing should have a visible input and output. If the line", "is easy to watch, it will be easier to automate later."]
	quest.1130000000000098.title: "Belts And Funnels"
	quest.1130000000000098.quest_desc: ["Belts show item flow. Add funnels only when you know where items", "should enter and leave."]
	quest.113000000000009B.title: "Mechanical Skyroot Core"
	quest.113000000000009B.quest_desc: ["This is where Create starts paying you back. The reward gives", "tools and parts for experimenting, because the next fun step is", "building a line that moves without hand-feeding."]
	quest.113000000000009F.title: "Ready For Power"
	quest.113000000000009F.quest_desc: ["Your first Create line can hand into power.", "The cable sample is a wiring reminder, not a finished power", "network."]
	quest.11300000000000A1.title: "Rotation Is Not FE"
	quest.11300000000000A3.title: "One Starter Generator"
	quest.11300000000000A3.quest_desc: ["Build one power source before thinking about a power room.", "The goal is simple: produce FE, connect it, and prove one machine can run."]
	quest.11300000000000A5.title: "Cable One Machine"
	quest.11300000000000A5.quest_desc: ["Cables only move energy; they do not make a stable network.", "Craft and place your own buffer next so power problems are", "easier to debug."]
	quest.11300000000000A7.title: "Small Battery Buffer"
	quest.11300000000000A7.quest_desc: ["A battery tells you whether the problem is generation, storage, routing or machine demand.", "Use it before adding more generators. Later, Uraninite has a Skyroot/Powah bridge from Uranium and the Energized Core, but starter power should still be simple first.", "If the buffer fills, generation works. If the machine stays empty, check cable sides and input/output settings."]
	quest.11300000000000A9.title: "Metallurgic Infuser"
	quest.11300000000000A9.quest_desc: ["The infuser is the first serious powered machine. Learn its", "energy side, item input and extra input before adding a machine row."]
	quest.11300000000000AB.title: "Basic Control Circuit"
	quest.11300000000000AB.quest_desc: ["Circuits are the bridge from power into industry. Make the route", "repeatable instead of crafting one miracle circuit."]
	quest.11300000000000AD.title: "Energy Tablet Check"
	quest.11300000000000AD.quest_desc: ["A portable buffer helps you understand power before the factory gets larger.", "Use it to test whether the problem is generation, cable routing, or the machine itself."]
	quest.11300000000000AF.title: "Energized Skyroot Core"
	quest.11300000000000AF.quest_desc: ["This is the power milestone for the Skyroot route.", "Craft it only after rotation, FE, cable routing and a small powered machine make sense.", "After this, Powah Uraninite and stronger energy parts can use gated bridge recipes instead of relying on missing ore worldgen."]
	quest.11300000000000B3.title: "Ready For Industry"
	quest.11300000000000B3.quest_desc: ["Power is stable enough to begin industry.", "You still need to make plastic through Industrial Foregoing;", "this handoff now only points you toward the next machines."]
	quest.11300000000000B5.title: "Growth Is Scaling, Not a Detour"
	quest.11300000000000B7.title: "Living Soil Tier"
	quest.11300000000000B7.quest_desc: ["Living Soil unlocks Tier 3: Coal, Copper and Iron.", "The Bonsai setup was introduced in Living Resources; this quest confirms the next exact Soil tier.", "Higher Soils do not replace it and do not add extra loot rolls."]
	quest.11300000000000B9.title: "Mechanical Soil"
	quest.11300000000000B9.quest_desc: ["Mechanical Soil unlocks Tier 4: Redstone, Gold, Lapis, Quartz and Zinc.", "It does not multiply Bonsai loot and cannot replace lower-tier soils."]
	quest.11300000000000BB.title: "Productive Bees Intro"
	quest.11300000000000BB.quest_desc: ["Bees are a scaling route, not an early replacement for the Orchard.", "In a void world, the first Bee Cage can use the Skyroot honey bridge: Honeycomb, Honey Bottle and Skyroot materials lead into Productive Bees without overworld RNG.", "Use the cage only after storage can handle combs; the Centrifuge turns the route into production."]
	quest.11300000000000BD.title: "Centrifuge"
	quest.11300000000000BD.quest_desc: ["Combs become useful only when they can be processed.", "The Centrifuge is the first proof that Bee output has a real input, output and storage destination.", "Keep the first bee loop small: cage, treat, combs, centrifuge, then drawer or barrel output."]
	quest.11300000000000BF.title: "Prosperity + Inferium Start"
	quest.11300000000000BF.quest_desc: ["Mystical Agriculture normally leans on ores and overworld resources, but this pack starts in the void.", "Use the Skyroot bootstrap recipes: Prosperity from Mechanical Soil, Amethyst, Quartz, Redstone and Resin; first Inferium from Living Compost, Wheat Seeds, Bone Meal, Redstone and Resin.", "This is only the first push. Once seeds, bees or automation are running, let those systems scale the resources instead of hand-crafting forever."]
	quest.11300000000000C1.title: "Inferium Seeds"
	quest.11300000000000C1.quest_desc: ["Inferium Seeds are your first real crop-scaling step.", "Make them after the Prosperity and Inferium bootstrap, then plant only a small starter patch until storage can handle essence output.", "Prosperity Shards become important again for seed bases and later resource seeds, so keep a small buffer."]
	quest.11300000000000C3.title: "Organic Processor"
	quest.11300000000000C3.quest_desc: ["Growth systems are the relaxed scaling route. Bees, crops and", "tree automation should reduce hand work, not become a second job."]
	quest.11300000000000C7.title: "Growth Route Handoff"
	quest.11300000000000C7.quest_desc: ["Growth systems are support paths, not a replacement for the main", "factory. Use bees, crops and magic to scale resources you already", "understand from trees and machines."]
	quest.11300000000000C9.title: "Magic Is Utility, Not Homework"
	quest.11300000000000C9.quest_desc: ["Magic is useful when it solves a real problem: utility, source handling, alternate resources or automation support.", "The current Void routes give Ars and Occultism clean starter materials, so you should not need overworld ore luck to begin.", "Start small and return to the factory whenever the magic branch stops solving a clear bottleneck."]
	quest.11300000000000CB.title: "Novice Spell Book"
	quest.11300000000000CB.quest_desc: ["The spell book opens utility. Keep the first goals simple: light, movement, harvesting help and source handling.", "Source Gems now have a Skyroot bridge through the Arcane Processor, Amethyst, Lapis and Resin, so JEI should show a void-safe entry route.", "Do not build a giant spell workshop before one small source setup works."]
	quest.11300000000000CD.title: "Source Jar"
	quest.11300000000000CD.quest_desc: ["Source is the power system for Ars. Store it before trying to build a complicated spell setup.", "Use the Source Gem and Sourcestone bridge recipes when worldgen would normally be expected.", "A good first setup is boring: one jar, one way to fill it, and one utility craft you understand."]
	quest.11300000000000CF.title: "Imbuement Chamber"
	quest.11300000000000CF.quest_desc: ["The Imbuement Chamber is the first clear crafting station for the magic route.", "Use it after Source Gems and Sourcestone are reachable, not as a random side craft.", "This keeps Ars as a useful support system instead of another hidden progression wall."]
	quest.11300000000000D1.title: "Occultism Guide"
	quest.11300000000000D1.quest_desc: ["Occultism is useful when you want ritual utility, smarter storage tricks or an alternate resource path.", "Datura Seeds, Otherstone and Spirit-attuned materials now have Skyroot/Arcane bridge routes so the first ritual path is possible in the void.", "Read the guide, make one ritual setup, then decide whether Occultism helps your current factory problem."]
	quest.11300000000000D3.title: "First Ritual Tools"
	quest.11300000000000D3.quest_desc: ["Build the bowl and gem route before trying to use spirits as production shortcuts.", "If a ritual item looks like it needs overworld stone or plants, check JEI for the Skyroot bridge recipes added for Datura, Otherstone and Spirit-attuned crystals.", "One working ritual is enough for the starter proof; do not turn this into ritual spam."]
	quest.11300000000000D6.title: "Arcane Processor"
	quest.11300000000000D6.quest_desc: ["This processor marks the magic route as connected to the final pack systems, not just a side toy.", "It also acts as the gate for several void-safe magic bridges, including Source Gems, Datura and Otherstone.", "Use it when magic has become useful support for your actual base."]
	quest.11300000000000DA.title: "Industry Starts With Inputs"
	quest.11300000000000DC.title: "Enrichment Chamber"
	quest.11300000000000DC.quest_desc: ["The Enrichment Chamber is your first quiet industrial machine.", "Power it clearly and send the output back into visible storage."]
	quest.11300000000000DE.title: "Crusher and Smelter"
	quest.11300000000000DE.quest_desc: ["Crusher plus Energized Smelter is the first small machine row.", "Keep it simple enough that you can explain every input and output."]
	quest.11300000000000E1.title: "Steel Step"
	quest.11300000000000E1.quest_desc: ["Steel proves that redstone, iron, carbon and power are becoming a route.", "Do not treat it as a lucky one-time craft; make the ingredients repeatable."]
	quest.11300000000000E3.title: "Latex and Plastic"
	quest.11300000000000E3.quest_desc: ["Plastic is the Industrial Foregoing checkpoint. Prove the latex route once before trying to use plastic everywhere.", "Industrial Hemp Seeds are now craftable through a Skyroot ecology bridge, so plant-based industry should not depend on overworld grass luck.", "Keep latex, water, power and storage visible until the loop feels reliable."]
	quest.11300000000000E7.title: "Machine Frame"
	quest.11300000000000E7.quest_desc: ["The first frame should feel like infrastructure, not a random expensive craft.", "If plastic, circuits and power are repeatable, future machines become realistic instead of painful."]
	quest.11300000000000E9.title: "Industrial Processor"
	quest.11300000000000E9.quest_desc: ["This proves powered processing, plastic and machine frames are part", "of one system."]
	quest.11300000000000EB.title: "Industrial Skyroot Core"
	quest.11300000000000EB.quest_desc: ["This is the real factory checkpoint: machines, steel, plastic and", "power now work together. The reward helps you scale, but it does", "not replace the next chapter."]
	quest.11300000000000EF.title: "Industrial Handoff To Network"
	quest.11300000000000EF.quest_desc: ["Industry has produced enough structure to begin digital storage.", "A small cable/material nudge is fine here because the actual", "network still needs crafting, power, discipline and storage rules."]
	quest.11300000000000F1.title: "Digital Storage Needs Discipline"
	quest.11300000000000F3.title: "Quartz Enriched Iron"
	quest.11300000000000F3.quest_desc: ["This material starts the Refined Storage route. Make it after quartz and iron are renewable enough to spend.", "If silicon feels hidden, JEI should show the Skyroot safety recipe from Quartz, Coal and Resin.", "Do not move every drawer into the network yet; connect clean bulk storage only when you understand the output flow."]
	quest.11300000000000F5.title: "Processor Binding"
	quest.11300000000000F5.quest_desc: ["Processor Binding is the first network crafting material. Keep a small recipe route ready.", "The point is not to rush autocrafting; the point is to make repeated processors less annoying once the network exists.", "If the recipe chain feels unclear, follow JEI Uses from Silicon and Quartz Enriched Iron."]
	quest.11300000000000F7.title: "Controller and Grid"
	quest.11300000000000F7.quest_desc: ["The Controller and Grid are the front door of digital storage.", "Place them where you can see power, cables and access clearly."]
	quest.11300000000000FA.title: "Disk Drive and Small Disk"
	quest.11300000000000FA.quest_desc: ["Start with a small disk. Large storage too early hides sorting", "problems instead of fixing them."]
	quest.11300000000000FD.title: "Crafting Grid"
	quest.11300000000000FD.quest_desc: ["The Crafting Grid is the first comfort upgrade. Autocrafting comes", "later; access comes first."]
	quest.11300000000000FF.title: "Network Matrix"
	quest.11300000000000FF.quest_desc: ["This matrix proves the network is tied into the Skyroot route, not", "just slapped onto the base."]
	quest.1130000000000101.title: "Networked Skyroot Core"
	quest.1130000000000101.quest_desc: ["A network is fun when it saves time without hiding chaos.", "Keep bulk outputs in drawers and use digital storage for access,", "crafting and clean automation."]
	quest.1130000000000105.title: "Network Handoff to Mob Data"
	quest.1130000000000105.quest_desc: ["Your network can now support controlled mob-data work.", "Use the blank model as a starting reminder, then build the", "simulation loop properly instead of relying on generic valuables."]
	quest.1130000000000107.title: "Mob Drops Should Become Controlled"
	quest.1130000000000109.title: "Safe Mob Room"
	quest.1130000000000109.quest_desc: ["Build or prepare a safe source of common drops before HNN. First", "contact matters before automation."]
	quest.113000000000010D.title: "Blank Data Model"
	quest.113000000000010D.quest_desc: ["A blank model is the start of controlled drops. Train simple mobs", "before chasing rare ones."]
	quest.113000000000010F.title: "Simulation Chamber"
	quest.113000000000010F.quest_desc: ["The Simulation Chamber turns trained data into repeatable work.", "Start with simple models before chasing rare drops."]
	quest.1130000000000111.title: "Prediction Matrix"
	quest.1130000000000111.quest_desc: ["Predictions are a resource. Buffer them like any other factory output.", "If the consumable matrix itself becomes the blocker, use the Network Processor bridge recipe with clay, glass, gold and iron.", "Once the simulation loop is running, the bridge should be backup support, not the main gameplay."]
	quest.1130000000000113.title: "Loot Fabricator"
	quest.1130000000000113.quest_desc: ["The fabricator converts predictions into real drops. Use it after the source mob route is understood.", "A good first lab fabricates boring common drops before it tries to replace Nether or End milestones.", "Keep matrices and model outputs in visible storage so the lab is easy to debug."]
	quest.1130000000000115.title: "Ender Pearl and Eye"
	quest.1130000000000115.quest_desc: ["Ender materials bridge the base into dimensions. They should be", "earned and then automated, not gifted early."]
	quest.1130000000000118.title: "Nether Proof"
	quest.1130000000000118.quest_desc: ["The first Nether step should be a milestone, not a shortcut.", "Earn the route once, then use mob data and automation to make repeat materials less annoying."]
	quest.113000000000011B.title: "Wither Setup"
	quest.113000000000011B.quest_desc: ["Wither Skeleton Skulls and Nether Stars are late milestones. Do not", "let reward shortcuts erase them."]
	quest.113000000000011D.title: "Rare Drop Matrix"
	quest.113000000000011D.quest_desc: ["The rare-drop matrix is already the important milestone.", "Relevant HNN support stays, but generic diamond filler is gone."]
	quest.1130000000000121.title: "Celestial Skyroot Core"
	quest.1130000000000121.quest_desc: ["Craft this when Nether, End and rare-drop routes can support the", "final automation chain."]
	quest.1130000000000123.title: "Mob Data Handoff to Final Automation"
	quest.1130000000000123.quest_desc: ["Mob data and dimension routing now hand into the finale.", "The rare-drop matrix marks that proof; diamonds are no longer", "used as filler here."]
	quest.1130000000000125.title: "Finale Is a Systems Test"
	quest.1130000000000127.title: "Final Organic Proof"
	quest.1130000000000127.quest_desc: ["Organic proof means grown resources still feed the finale.", "Make sure trees, crops or bees can repeat this route reliably."]
	quest.1130000000000129.title: "Final Mechanical Proof"
	quest.1130000000000129.quest_desc: ["Mechanical proof means Create is no longer a side workshop.", "Its processing should feed the final chain on purpose."]
	quest.113000000000012B.title: "Final Industrial Proof"
	quest.113000000000012B.quest_desc: ["Industrial proof means steel, plastic, circuits and frames are", "repeatable enough to support the final assembly."]
	quest.113000000000012D.title: "Final Arcane Proof"
	quest.113000000000012D.quest_desc: ["Arcane proof means magic stayed useful as support, utility or", "resource work instead of becoming a disconnected branch."]
	quest.113000000000012F.title: "Final Network Proof"
	quest.113000000000012F.quest_desc: ["Network proof means storage and autocrafting help the finale", "without hiding broken inputs behind one giant inventory."]
	quest.1130000000000131.title: "Final Celestial Proof"
	quest.1130000000000131.quest_desc: ["Celestial proof means rare drops and dimension materials have a", "controlled route. The painful drops should no longer be pure luck."]
	quest.1130000000000133.title: "Skyroot Singularity"
	quest.1130000000000133.quest_desc: ["The singularity compresses the main routes into one proof of", "automation."]
	quest.1130000000000135.title: "Evolution Matrix"
	quest.1130000000000135.quest_desc: ["The Evolution Matrix is a late route proof, not a treasure chest.", "The coin is the celebration; the raw diamond filler is no longer", "needed."]
	quest.1130000000000137.title: "Final Catalyst"
	quest.1130000000000137.quest_desc: ["The catalyst starts the final craft. Only do this when the base can", "replace the materials you spend."]
	quest.1130000000000139.title: "Evolution Core"
	quest.1130000000000139.quest_desc: ["The Evolution Core is the main finish line. It should feel like", "the result of connected systems, not one expensive manual craft."]
	quest.113000000000013D.title: "Optional QoL Supports the Run"
	quest.113000000000013D.quest_desc: ["QoL quests make the playthrough smoother. They are useful, but", "they should never feel required to finish the main route."]
	quest.113000000000013F.title: "Backpack or Extra Storage"
	quest.113000000000013F.quest_desc: ["Carry capacity helps during setup, but it does not replace a sorted", "base."]
	quest.1130000000000141.title: "Gravestone Safety"
	quest.1130000000000141.quest_desc: ["Death recovery should reduce frustration, not remove the need for", "safe platforms."]
	quest.1130000000000143.title: "Trash Slot Awareness"
	quest.1130000000000143.quest_desc: ["Trash tools are useful when you know what is safe to delete. Do not", "void unclear modded items."]
	quest.1130000000000145.title: "Lighting and Mob Safety"
	quest.1130000000000145.quest_desc: ["Use lighting tools when the base expands. Safety matters, but it", "does not need ten separate main quests."]
	quest.1130000000000147.title: "Building Is Optional"
	quest.1130000000000147.quest_desc: ["Decorate after access paths, storage and machines are readable.", "Pretty bases work best when they still function."]
	quest.1130000000000149.title: "QoL Handoff"
	quest.1130000000000149.quest_desc: ["Optional QoL work can make the pack nicer, but it should not", "become a currency path. The handoff is recognition only."]
	quest.113000000000014C.title: "Completionist Is After the Route"
	quest.113000000000014C.quest_desc: ["Completionist goals are for later review. Finish the main route", "first, then come back when you want extra proof and polish."]
	quest.113000000000014E.title: "Finish Open Main Branches"
	quest.113000000000014E.quest_desc: ["Finishing the open main branches is a real completionist moment.", "The gold coin is a late optional reward, not part of the normal", "route economy."]
	quest.1130000000000150.title: "Create Mastery"
	quest.1130000000000150.quest_desc: ["Automate a Create line well enough that it restarts cleanly after", "stopping."]
	quest.1130000000000152.title: "Power Mastery"
	quest.1130000000000152.quest_desc: ["Build a stable power buffer that can handle normal machine demand."]
	quest.1130000000000154.title: "Network Mastery"
	quest.1130000000000154.quest_desc: ["Use the network for access and crafting without abandoning bulk", "drawers for high-volume outputs."]
	quest.1130000000000156.title: "Rare Drop Mastery"
	quest.1130000000000156.quest_desc: ["Automate at least one rare-drop route after earning it normally."]
	quest.1130000000000158.title: "Completionist Review"
	quest.1130000000000158.quest_desc: ["If the main route is complete and the base feels stable, optional", "goals can extend the pack without bloating the first playthrough."]
	quest.1180000000000001.title: "Open Both Guides"
	quest.1180000000000001.quest_desc: ["Keep the questbook open for the route and the guidebook nearby for system notes.", "This is not homework; it is your safety net when a recipe or mechanic is new."]
	quest.1180000000000002.title: "Keep a Resin Buffer"
	quest.1180000000000002.quest_desc: ["Do not spend every piece of resin immediately. A tiny buffer keeps early recovery recipes available.", "Eight resin is enough to prove that logs are doing their job."]
	quest.1180000000000003.title: "Keep a Leaf Buffer"
	quest.1180000000000003.quest_desc: ["Leaves are your fiber, sapling and acorn side of the tree loop.", "Collect a small amount before turning the whole tree into recipes."]
	quest.1180000000000004.title: "Base Tree Trio"
	quest.1180000000000004.quest_desc: ["Dirt, gravel and sand are the three trees you will touch constantly.", "Get their acorns and resin before expanding into every other resource."]
	quest.1180000000000005.title: "Base Resin Trio"
	quest.1180000000000005.quest_desc: ["Matching resin turns acorns from loose drops into a reliable material route.", "Keep resin and acorns side by side in storage."]
	quest.1180000000000006.title: "Fuel Before Machines"
	quest.1180000000000006.quest_desc: ["Coal trees are not flashy, but they make smelting, torches and early machines calmer.", "A small fuel buffer prevents the next chapters from stalling."]
	quest.1180000000000007.title: "Metal Tree Pair"
	quest.1180000000000007.quest_desc: ["Copper and iron are the first resources that really push the pack forward.", "The goal is not infinite ingots yet; it is a stable trace route."]
	quest.1180000000000008.title: "Lock The Important Drawers"
	quest.1180000000000008.quest_desc: ["A drawer wall becomes annoying when empty drawers forget what belongs there.", "Lock the important drawers once the acorn and resin layout makes sense."]
	quest.1180000000000009.title: "Trim Connects The Wall"
	quest.1180000000000009.quest_desc: ["Trim blocks help a controller read more of the drawer wall without forcing every drawer into a perfect block.", "Craft the Oak Trim directly from Skyroot Planks; this route should never require grass seeds, moss or random vanilla oak luck."]
	quest.118000000000000A.title: "Void Only The Overflow"
	quest.118000000000000A.quest_desc: ["Void upgrades and trash cans are safety tools, not your main output.", "Use them only after the useful drawers and buffers are already working."]
	quest.118000000000000B.title: "Upgrade Only What Fills"
	quest.118000000000000B.quest_desc: ["Do not upgrade every drawer just because you can.", "Put upgrades on logs, resin, acorns and traces after you see what fills up first."]
	quest.118000000000000C.title: "Andesite Casing"
	quest.118000000000000C.quest_desc: ["Casings are the point where Create stops being just shafts and starts becoming machines.", "Make a few before planning a full line."]
	quest.118000000000000D.title: "Wrench Before Rebuilding"
	quest.118000000000000D.quest_desc: ["A wrench saves more time than it costs.", "Use it before tearing down a line by hand."]
	quest.118000000000000E.title: "Basin And Mixer Preview"
	quest.118000000000000E.quest_desc: ["Mixers and basins are a preview of bigger Create crafting, not a reason to rebuild the base yet.", "Learn the block now so later recipes feel familiar instead of sudden."]
	quest.118000000000000F.title: "Filter One Output"
	quest.118000000000000F.quest_desc: ["Filtering one output is better than cleaning five wrong chests later.", "Use a filter once items start moving without your hand."]
	quest.1180000000000010.title: "FE Cable Backup"
	quest.1180000000000010.quest_desc: ["One cable is never enough once you start testing sides and buffers.", "Keep a few spare cables so troubleshooting does not stop the run."]
	quest.1180000000000011.title: "Redstone Control Buffer"
	quest.1180000000000011.quest_desc: ["Machines get easier to manage when you understand when they should run.", "A small redstone buffer helps with control recipes and later automation."]
	quest.1180000000000012.title: "Universal Cable Check"
	quest.1180000000000012.quest_desc: ["Mekanism cables are the industrial side of your power network.", "Make a small run before spreading cables across the whole base."]
	quest.1180000000000013.title: "Energized Soil"
	quest.1180000000000013.quest_desc: ["Energized Soil unlocks the Tier 5 industrial-metal orchard.", "Its purpose is exact tier access, not extra Bonsai loot rolls."]
	quest.1180000000000014.title: "Industrial Soil After Machines"
	quest.1180000000000014.quest_desc: ["Industrial Soil is the exact Tier 7 soil used only for Platinum.", "It belongs after powered processing and does not multiply the tree loot table."]
	quest.1180000000000015.title: "First Resource Crop"
	quest.1180000000000015.quest_desc: ["Mystical Agriculture is a later scaling path, not a replacement for learning trees.", "Start small and automate it only after storage can handle the output."]
	quest.1180000000000016.title: "Source Gem Buffer"
	quest.1180000000000016.quest_desc: ["Magic starts to help once you have a small Source Gem buffer.", "The Arcane Processor recipe exists so Source Gems are reachable in the void without hunting ore.", "Treat this as utility support for the factory, not a second mainline."]
	quest.1180000000000017.title: "Steel Buffer"
	quest.1180000000000017.quest_desc: ["Steel is the first industrial material you will use more than once.", "Make a small buffer before crafting every machine frame by hand."]
	quest.1180000000000018.title: "Plastic Buffer"
	quest.1180000000000018.quest_desc: ["Plastic is Industrial Foregoing's first real bottleneck.", "A small buffer proves the latex line works before you build around it."]
	quest.1180000000000019.title: "Plant Automation Preview"
	quest.1180000000000019.quest_desc: ["Plant machines are useful once your storage and power are stable.", "Do not make them the first industrial goal; use them to scale what already works."]
	quest.118000000000001A.title: "Dissolution Chamber Preview"
	quest.118000000000001A.quest_desc: ["Some later recipes need more controlled processing than a crafting table.", "The point is not complexity; it is repeatable factory logic."]
	quest.118000000000001B.title: "Basic Network Cable"
	quest.118000000000001B.quest_desc: ["Cable is the boring part that decides whether the network is readable.", "Keep the first network small enough to understand."]
	quest.118000000000001C.title: "External Storage Warning"
	quest.118000000000001C.quest_desc: ["External Storage is powerful because it connects drawers to a network.", "Use it carefully: the goal is access to organized bulk storage, not hiding a messy chest wall inside a terminal."]
	quest.118000000000001D.title: "Importer And Exporter"
	quest.118000000000001D.quest_desc: ["Importers and exporters are the first step toward network automation.", "Use one of each before trying full autocrafting."]
	quest.118000000000001E.title: "Do Not Store Everything Yet"
	quest.118000000000001E.quest_desc: ["The network is for active crafting and access.", "Bulk logs, resin and acorns still belong in drawers until autocrafting needs them."]
	quest.118000000000001F.title: "Common Model Set"
	quest.118000000000001F.quest_desc: ["Start with common mobs before chasing rare drops.", "A few simple models teach the loop without breaking Nether or End progression."]
	quest.1180000000000020.title: "Fabricate Common Drops"
	quest.1180000000000020.quest_desc: ["The fabricator should first replace boring mob waiting: bones, string and gunpowder.", "Rare drops stay locked behind their real milestones."]
	quest.1180000000000021.title: "Portal Materials Check"
	quest.1180000000000021.quest_desc: ["Before the Nether, check that you can replace losses and return safely.", "Obsidian is a milestone only if the base can support the trip."]
	quest.1180000000000022.title: "End City Is Not Early"
	quest.1180000000000022.quest_desc: ["Shulker shells and chorus fruit belong after the End route is established.", "This keeps the late-game storage and final automation goals meaningful."]
	quest.1180000000000023.title: "Autocrafting Proof"
	quest.1180000000000023.quest_desc: ["Autocrafting is the proof that your routes are ready to repeat.", "Start with a simple recipe before asking the network to handle", "multi-step processors or final components."]
	quest.1180000000000024.title: "Rare Drop Proof"
	quest.1180000000000024.quest_desc: ["A Nether Star is already strong proof that rare-drop routing is", "under control. The reward stays useful without adding another", "generic diamond."]
	quest.1180000000000025.title: "Factory Review Before Finale"
	quest.1180000000000025.quest_desc: ["Before the finale, walk your factory once: inputs, power, buffers,", "trash safety, network patterns and rare drops. Fix weak links now", "instead of during the final craft."]
	quest.1180000000000026.title: "Keybinds And Search"
	quest.1180000000000026.quest_desc: ["QoL mods only help when you know how to access them.", "Check controls early if something feels hidden."]
	quest.1180000000000027.title: "Safe Building Materials"
	quest.1180000000000027.quest_desc: ["Optional building is not required for progression, but safe platforms prevent stupid losses.", "Use simple blocks before decorating."]
	quest.1180000000000028.title: "Orchard Completion Review"
	quest.1180000000000028.quest_desc: ["Completionist play starts by checking whether the resource tree system is actually stable.", "Do this after the main route, not before it."]
	quest.1180000000000029.title: "Storage Completion Review"
	quest.1180000000000029.quest_desc: ["A completionist base should be readable even when every resource is flowing.", "If storage is messy here, final automation will feel worse than it should."]
	quest.1190000000000001.title: "Deployer For Repetition"
	quest.1190000000000001.quest_desc: ["A Deployer is where Create starts doing repeated work for you instead of only moving items around.", "You do not need a giant factory yet. One useful repeated action is enough."]
	quest.1190000000000002.title: "Precision Mechanism Preview"
	quest.1190000000000002.quest_desc: ["Precision mechanisms are a later Create skill check.", "For now, treat this as a preview: small deployer lines first, large sequenced assembly later."]
	quest.1190000000000003.title: "Mekanism Processing Pair"
	quest.1190000000000003.quest_desc: ["The Enrichment Chamber teaches better inputs. The Crusher or Energized Smelter teaches that powered machines are now your material upgrade path.", "This keeps Power from being only cables and batteries."]
	quest.1190000000000004.title: "Energy Cell Buffer"
	quest.1190000000000004.quest_desc: ["A generator directly feeding one machine works, but a small energy cell makes the base easier to troubleshoot.", "Buffers are not exciting. They are what make the factory stable."]
	quest.1190000000000005.title: "Bee Processing Loop"
	quest.1190000000000005.quest_desc: ["Bees should support the orchard instead of replacing it too early.", "A cage and a centrifuge are the first proof that the bee path can become a controlled resource loop."]
	quest.1190000000000006.title: "Essence Farm Starter"
	quest.1190000000000006.quest_desc: ["Mystical Agriculture is another scaling path. It is useful when you want a farm to supply a specific resource without expanding the tree wall forever.", "Start small and only automate what you actually need."]
	quest.1190000000000007.title: "Source Starter Pair"
	quest.1190000000000007.quest_desc: ["Ars starts becoming useful when source can be stored and reused.", "Source Gem, Sourcestone and Magebloom now have void-safe bridges, so the starter pair should be reachable from the Skyroot route.", "Treat it like a utility system first, not a second main questline."]
	quest.1190000000000008.title: "Occultism Starter Pair"
	quest.1190000000000008.quest_desc: ["Occultism is here for utility and alternate progression, not to bury the main route in rituals.", "Datura, Otherstone and spirit-attuned materials now have bridge recipes so a void player can begin the branch intentionally.", "The guidebook and first ritual bowl are enough to prove you can follow this side system."]
	quest.1190000000000009.title: "Latex Processing Chain"
	quest.1190000000000009.quest_desc: ["Build the latex machines first, then prove the output in the", "Plastic quest. The shop and rewards can help later, but the", "first plastic should come from your setup."]
	quest.119000000000000A.title: "Plant Automation Pair"
	quest.119000000000000A.quest_desc: ["Plant automation is about farming loops, not free plastic.", "Use it to make renewables cleaner once your industrial base", "already exists."]
	quest.119000000000000B.title: "Dissolution Chamber Workbench"
	quest.119000000000000B.quest_desc: ["The Dissolution Chamber is an industrial crafting table with fluids and inputs.", "It is a good sign that your factory has moved beyond simple shaped recipes."]
	quest.119000000000000C.title: "Drive, Disk and Grid"
	quest.119000000000000C.quest_desc: ["Digital storage is three separate ideas: the controller powers the network, the drive holds disks, and the grid is how you interact with it.", "Keep those roles separate and troubleshooting gets much easier."]
	quest.119000000000000D.title: "Crafter Before Finale"
	quest.119000000000000D.quest_desc: ["Try one small autocrafting setup before the final route asks for repeated parts.", "Start with something boring and safe; the network should remove repetition, not skip learning."]
	quest.119000000000000E.title: "Carry The Deep Learner"
	quest.119000000000000E.quest_desc: ["The Deep Learner is the player-facing part of Hostile Neural Networks.", "Carry it while training models so the later simulations feel earned instead of random."]
	quest.119000000000000F.title: "First Simulation Loop"
	quest.119000000000000F.quest_desc: ["The clean rare-drop loop is simple: train a model, run simulations, then fabricate the drop you need.", "This is how mob farming becomes a controlled factory line."]
	quest.1A12000000000001.title: "Tree Loop Momentum"
	quest.1A12000000000001.quest_desc: ["Collect a small buffer from the first loop. This is the first moment", "where the island should feel alive instead of fragile.", "Reward: enough support to keep building instead of stopping."]
	quest.1A12000000000002.title: "First Orchard Wall"
	quest.1A12000000000002.quest_desc: ["Do not just unlock trees; give them a place to run.", "A small drawer wall handles the first materials without handing you the later Pipez network early."]
	quest.1A12000000000003.title: "No More Chest Monster"
	quest.1A12000000000003.quest_desc: ["This is a real base milestone: bulk outputs have a home, pipes move", "one stream cleanly, and overflow has guardrails.", "From here, adding machines should feel exciting instead of messy."]
	quest.1A12000000000004.title: "A Line That Moves Itself"
	quest.1A12000000000004.quest_desc: ["Build a small line that actually moves items. It does not need to be", "pretty yet; it just needs to prove that Create is becoming a factory,", "not another crafting checklist."]
	quest.1A12000000000005.title: "A Machine That Stays On"
	quest.1A12000000000005.quest_desc: ["Power becomes fun when machines stop flickering off.", "Prove you have generation, cables and a buffer, then push into", "industrial processing with less friction."]
	quest.1A12000000000006.title: "Your First Scaling Engine"
	quest.1A12000000000006.quest_desc: ["Pick a growth system and make it useful. Bees, crops and source are", "not homework; they are ways to make the factory feel less hand-fed."]
	quest.1A12000000000007.title: "Factory Tier Online"
	quest.1A12000000000007.quest_desc: ["This is the point where the island starts feeling industrial.", "You have machines, power and plastic. The next reward supports scale,", "not shortcuts."]
	quest.1A12000000000008.title: "Network With A Purpose"
	quest.1A12000000000008.quest_desc: ["Digital storage should make the factory easier to use, not hide a mess.", "Build a small complete network before turning it into autocrafting."]
	quest.1A12000000000009.title: "Data Replaces Waiting"
	quest.1A12000000000009.quest_desc: ["The mob-data loop replaces waiting once it is powered and routed.", "The reward now supports the loop without adding extra diamond", "value."]
	quest.1A1200000000000A.title: "The Factory Wants A Finale"
	quest.1A1200000000000A.quest_desc: ["This quest checks whether several systems can work together.", "It should point toward the finale, not give away Nether Stars or", "Evolution currency before the true final proof."]
	chapter.097C000000000016.title: "Factory Contracts"
	chapter.097C000000000016.subtitle: "Optional system challenges; never required for the main route"
	quest.1A14000000000001.title: "Factory Contracts Are Optional"
	quest.1A14000000000003.title: "Orchard Buffer Contract"
	quest.1A14000000000003.quest_desc: ["Build a small buffer from the tree loop before rushing machines.", "A little stockpile makes every next step feel smoother and avoids the empty-tree frustration."]
	quest.1A14000000000005.title: "Storage Wall Contract"
	quest.1A14000000000005.quest_desc: ["A factory is only fun when outputs stop becoming floor clutter.", "Prove that bulk items have drawers, a buffer and one clean transfer route."]
	quest.1A14000000000007.title: "Pressing Bench Contract"
	quest.1A14000000000007.quest_desc: ["Create starts becoming satisfying when one small station replaces repeated handcrafting.", "Press a real sheet and keep the parts for a cleaner first line."]
	quest.1A14000000000009.title: "Moving Line Contract"
	quest.1A14000000000009.quest_desc: ["This is the first big fun check: items move, get processed, and land somewhere useful.", "It does not need to be pretty. It only needs to work."]
	quest.1A1400000000000B.title: "Stable Power Contract"
	quest.1A1400000000000B.quest_desc: ["Power should feel like a solved problem, not a flickering machine.", "Use a generator, cable and storage so the next machines can stay on."]
	quest.1A1400000000000D.title: "Mekanism Starter Contract"
	quest.1A1400000000000D.quest_desc: ["Mekanism becomes easier when you understand the first three pieces: cable, Infuser and control circuits.", "This contract proves the machine era has started for real."]
	quest.1A1400000000000F.title: "Growth Engine Contract"
	quest.1A1400000000000F.quest_desc: ["Pick growth systems because they scale resources while you work on other machines.", "Bees and crops should feel like a useful side engine, not a random detour."]
	quest.1A14000000000011.title: "Utility Magic Contract"
	quest.1A14000000000011.quest_desc: ["Magic should add utility and clever support, not steal the whole route.", "Set up the first source tools and a small Occultism anchor."]
	quest.1A14000000000013.title: "Plastic Line Contract"
	quest.1A14000000000013.quest_desc: ["Plastic is the moment Industrial Foregoing becomes more than another machine tab.", "Prove that latex can become a repeatable material for later frames."]
	quest.1A14000000000015.title: "Machine Frame Contract"
	quest.1A14000000000015.quest_desc: ["Frames turn one-off machines into a real industrial tier.", "This goal should feel like unlocking a new workshop bench for the rest of the pack."]
	quest.1A14000000000017.title: "Clean Digital Network Contract"
	quest.1A14000000000017.quest_desc: ["Digital storage is fun when it is clean. Build the controller, access point, disk drive and first disk before hiding everything behind cables."]
	quest.1A14000000000019.title: "Autocrafting Contract"
	quest.1A14000000000019.quest_desc: ["Autocrafting is where the factory starts paying you back.", "Do not automate everything yet. Prove one small clean import/export/crafter setup first."]
	quest.1A1400000000001B.title: "Mob Data Contract"
	quest.1A1400000000001B.quest_desc: ["Rare drops should stop being waiting rooms.", "Train the system, run simulations and fabricate the useful drops instead of camping a dark box forever."]
	quest.1A1400000000001D.title: "Dimension Prep Contract"
	quest.1A1400000000001D.quest_desc: ["Nether and End materials should feel earned, but not chaotic.", "Prepare the bridge resources before pushing into the next rare-drop stage."]
	quest.1A1400000000001F.title: "Processor Prep Contract"
	quest.1A1400000000001F.quest_desc: ["The finale should ask for connected systems, not a random wall of items.", "This contract checks Create, Mekanism, RS and HNN before the final chain."]
	quest.1A14000000000021.title: "One More Factory Goal"
	quest.1A15000000000001.title: "Drawer Controller Project"
	quest.1A15000000000001.quest_desc: ["Upgrade the storage wall into something you can actually live with.", "A drawer controller and key turn the wall from emergency sorting into a base system."]
	quest.1A15000000000003.title: "Create Workshop Project"
	quest.1A15000000000003.quest_desc: ["Build one small workshop instead of scattered Create blocks.", "Pressing, mixing, moving and filtering should all be reachable from the same clean area."]
	quest.1A15000000000005.title: "Power Buffer Project"
	quest.1A15000000000005.quest_desc: ["A fun factory stops being fun when every machine blinks off.", "Give the base a real buffer and two cable standards before expanding production."]
	quest.1A15000000000007.title: "Mekanism Processing Project"
	quest.1A15000000000007.quest_desc: ["Do not let Mekanism become a random pile of machines.", "Set up the basic processing trio and prove your cable/side-config understanding."]
	quest.1A15000000000009.title: "Industrial Farm Project"
	quest.1A15000000000009.quest_desc: ["Industrial Foregoing should make the island feel less manual.", "Pair plant automation with plastic production so the industrial tier has a reason to exist."]
	quest.1A1500000000000B.title: "Pattern Starter Project"
	quest.1A1500000000000B.quest_desc: ["The first autocrafting patterns should remove boring repeats, not hide the whole game.", "Start with a small RS crafting station and a few routing blocks."]
	quest.1A1500000000000D.title: "Common Model Set Project"
	quest.1A1500000000000D.quest_desc: ["Mob data is best when it replaces waiting, not discovery.", "Build a small lab and keep enough blank models ready for common drops."]
	quest.1A1500000000000F.title: "Factory Walkthrough Review"
	quest.1A1500000000000F.quest_desc: ["Walk through the base and check whether every system has a purpose.", "This is a playtest checkpoint: screenshot the parts that made you want to continue and the parts that felt like filler."]
	quest.1A16000000000001.title: "Storage Wall Actually Works"
	quest.1A16000000000003.title: "One Real Processing Line"
	quest.1A16000000000005.title: "Power Room Checkpoint"
	quest.1A16000000000007.title: "Scaling Is Not One System"
	quest.1A16000000000009.title: "Plastic Becomes Infrastructure"
	quest.1A1600000000000B.title: "Autocraft Something Boring"
	quest.1A1600000000000D.title: "Rare Drop Simulation Loop"
	quest.1A1600000000000F.title: "Five Systems Before The Finale"
	quest.1A17000000000001.title: "Precision Without A Mess"
	quest.1A17000000000001.quest_desc: ["Precision mechanisms are the first Create part that should feel like a small production line.", "You do not need a giant factory yet. Make one clean deployer line you can understand and reuse."]
	quest.1A17000000000003.title: "Inputs, Outputs, Filters"
	quest.1A17000000000003.quest_desc: ["A moving line becomes useful when it sorts itself.", "Use funnels, tunnels and a filter so the line has a clear input side and a clear output side."]
	quest.1A17000000000005.title: "Mekanism Processing Trio"
	quest.1A17000000000005.quest_desc: ["Power is more satisfying when it feeds a real machine row.", "Set up the basic Mekanism processing machines before pushing into bigger industry."]
	quest.1A17000000000007.title: "Portable Power Backup"
	quest.1A17000000000007.quest_desc: ["A beginner-friendly factory should recover from small power mistakes.", "Keep portable energy and cable spares ready before you expand the next room."]
	quest.1A17000000000009.title: "Bee Output Bench"
	quest.1A17000000000009.quest_desc: ["Bees are not an early replacement for trees.", "Treat them as a targeted scaling bench for resources your factory keeps asking for.", "The honey, Bee Cage and Honey Treat bridges are only there to make the first controlled bee loop possible in a void world."]
	quest.1A1700000000000B.title: "Crop Scaling Starter"
	quest.1A1700000000000B.quest_desc: ["Mystical Agriculture is slower to set up, but it pays back when you keep it organized.", "Start small: one seed route, one essence buffer, one reason to come back later.", "Prosperity and first Inferium have bootstrap recipes; later scaling should come from crops, bees or automation."]
	quest.1A1700000000000D.title: "Oritech Is An Optional Workshop"
	quest.1A1700000000000F.title: "Optional Oritech Starter Row"
	quest.1A1700000000000F.quest_desc: ["This is an optional industrial branch, not a gate.", "Try a small Oritech row only when you want another machine style to compare with Mekanism.", "If silicon is the blocker, check JEI for the Skyroot Raw Silicon bridge before assuming you need overworld ore."]
	quest.1A17000000000011.title: "Machine Frames Need A Loop"
	quest.1A17000000000011.quest_desc: ["A machine-frame loop should be rebuilt and repeatable.", "This quest now rewards progress without handing out another", "core machine for free."]
	quest.1A17000000000013.title: "AE2 Is The Advanced Storage Path"
	quest.1A17000000000015.title: "AE2 Starter Network Proof"
	quest.1A17000000000015.quest_desc: ["Build this only when you want the advanced storage branch.", "Use the Skyroot bridges for Certus, Fluix and Presses if worldgen recipes would normally block you.", "The Energy Acceptor recipe is intentionally unique in SkyTech so it no longer collides with Iron Chests upgrades during crafting."]
	quest.1A17000000000017.title: "AE2 Autocrafting Preview"
	quest.1A17000000000017.quest_desc: ["AE2 autocrafting is optional and advanced.", "The reward is now about AE2 learning value, not generic diamond", "padding."]
	quest.1A17000000000019.title: "Useful Model Set"
	quest.1A17000000000019.quest_desc: ["One data model is a demo. A small set is a system.", "Prepare several models so your lab can support common drops without sending you back to manual farms."]
	quest.1A1700000000001B.title: "Nether Drop Data Prep"
	quest.1A1700000000001B.quest_desc: ["Rare drops should move from first encounter to controlled automation.", "Do not skip the Nether; use data after you have proven the route exists."]
	quest.1A1700000000001D.title: "Optional Oritech Contract"
	quest.1A1700000000001D.quest_desc: ["This contract exists to give Oritech a clear role without forcing it into the main route.", "Finish it if you want a second industrial workshop style beside Mekanism and IF."]
	quest.1A1700000000001F.title: "Optional AE2 Contract"
	quest.1A1700000000001F.quest_desc: ["This contract is for players who want the advanced storage puzzle.", "Keep RS as the easy route, then use AE2 when you want deeper network planning."]
	quest.1130000000000019.quest_desc: ["Welcome to SkyTech Evolution. Start small, follow the route,", "and let each chapter teach one system at a time."]
	quest.113000000000001D.quest_desc: ["Main quests are here to teach systems, not just tick boxes.", "When a step asks for an item, it should prove a useful skill."]
	quest.1130000000000021.quest_desc: ["Rewards should support the next step without playing the pack", "for you. The best reward is one that keeps progress moving."]
	quest.1130000000000001.quest_desc: ["Use this page as your compass. It shows the safe route from the", "first tree to final automation without paying out materials."]
	quest.1130000000000027.quest_desc: ["Plant the Skyroot Sapling on Vanilla Soil only: Dirt, Grass, Coarse Dirt or Rooted Dirt.", "Leave a clear 3x3 area around it and at least 6 blocks of open height.", "Natural growth is automatic. Bone Meal stays vanilla-like. Repeatedly crouch or sprint near the sapling to encourage faster growth."]
	quest.1130000000000029.quest_desc: ["Logs are still the main resin source. Leaves can help a little,", "but resin should push you to harvest and sort the whole tree.", "Use JEI Uses on resin when the next Skyroot craft is unclear."]
	quest.113000000000002C.quest_desc: ["Leaves are your soft resource layer: fiber, saplings, acorns and a little resin.", "Use the Crook when recovery matters; use shears only when you need the block.", "This keeps leaf drops useful without making resin too free."]
	quest.1130000000000044.quest_desc: ["The starter loop is stable. Take the support supplies and move into resource trees.", "From this point, trees—not duplicate hand recipes—define the main resource route."]
	quest.113000000000004A.quest_desc: ["Resource trees are the heart of the pack. Resin and acorns only", "matter once you collect, sort and reuse them consistently.", "JEI Uses on each new acorn/resin pair should reveal the next material route."]
	quest.113000000000005C.quest_desc: ["Use Copper Tree output to create the Iron Tree, then combine each tree’s acorns and resin into traces.", "Only after that should Copper and Iron become ingots and enter machines."]
	quest.1130000000000065.quest_desc: ["Your first Bonsai can now produce without manual tree farming.", "Give logs, resin and acorns a clear barrel or drawer before scaling more pots.", "Pipez extraction is taught later, after Iron and Redstone are actually available."]
	quest.1130000000000072.quest_desc: ["Before scaling production, give every common output a home.", "Start with normal Drawers, a Key and visible Chest or Barrel buffers.", "The Controller is intentionally later, after Iron and Redstone, and no Diamond or Sieving is required."]
	quest.1130000000000076.quest_desc: ["Do not sieve for a Diamond just to continue Storage.", "After the Iron and Redstone Trees, use the SkyTech recipe: one Drawer, four Iron Ingots and four Redstone Dust.", "The Controller then turns the prepared wall into one clean input system."]
	quest.1A16000000000001.quest_desc: ["This is a project goal, not a tiny item check.", "A working storage wall should accept the main orchard outputs and make the next Create setup easier to feed."]
	quest.1130000000000086.quest_desc: ["Create starts with one moving line. Do not build a factory yet;", "prove rotation, one machine, and one clean output first."]
	quest.1A16000000000003.quest_desc: ["Build one processing line that works while you are doing something else.", "That is the moment Create stops being a recipe mod and starts feeling like automation."]
	quest.11300000000000A1.quest_desc: ["Create rotation and FE power are different systems. This chapter", "teaches a generator, a cable, a buffer and one powered machine."]
	quest.1A16000000000005.quest_desc: ["A good power room is boring in the best way.", "It has generation, cables, a buffer and enough spare parts that one mistake does not stop the whole island."]
	quest.11300000000000B5.quest_desc: ["Growth systems are scaling tools. Pick one helper first, then", "expand when storage, power and outputs can handle it."]
	quest.1A16000000000007.quest_desc: ["A strong island should not depend on one production trick forever.", "Keep the orchard as your base, then add one scaling path that actually helps your current bottleneck."]
	quest.11300000000000DA.quest_desc: ["Industry begins when inputs and outputs are controlled. Power one machine cleanly before adding steel, plastic and frames.", "This beta adds several void-safe entry materials here: Industrial Hemp Seeds, Oritech Raw Silicon, and clearer support for later machine routes.", "These are bridges, not shortcuts. Build a repeatable loop before spending them on a long machine chain."]
	quest.1A16000000000009.quest_desc: ["Plastic is more than another material. It is the bridge into repeatable machine infrastructure.", "Keep latex, water, FE and storage visible until the loop feels boring and reliable."]
	quest.11300000000000F1.quest_desc: ["Digital storage is not a magic trash can. Build it after bulk storage exists, then connect only the outputs you understand.", "Refined Storage is the simpler main route. AE2 is available as an advanced optional path with its own Certus, Fluix and Press bridges.", "Start small: controller, grid, disk, then one importer/exporter loop."]
	quest.1A1600000000000B.quest_desc: ["Autocraft something simple and annoying first.", "If your network can handle boring repeated parts, it is ready to become part of the real factory."]
	quest.1130000000000107.quest_desc: ["Mob drops should become controlled instead of random waiting.", "Meet the drops first, then let data make them repeatable.", "Prediction Matrix now has a Network-tier fallback recipe so HNN does not get stuck on a consumable item before the lab can run."]
	quest.1A1600000000000D.quest_desc: ["This is the full data loop: train a model, simulate it, and fabricate something your factory actually needs.", "If it saves you from standing at a mob farm, it is doing its job."]
	quest.1130000000000125.quest_desc: ["The finale checks whether your systems work together. It should", "reward automation and planning, not one last manual stockpile."]
	quest.1A1600000000000F.quest_desc: ["Five systems working together is the real reward here.", "The gold coin and XP are enough; generic diamond padding is gone."]
	quest.1A14000000000021.quest_desc: ["Use this as a pause point before pushing forward.", "Walk through the base and ask: what feels messy, what keeps stopping, and what would make the next hour smoother?"]
	quest.1A17000000000013.quest_desc: ["AE2 is the advanced storage path. Try it when you want channels, patterns and deeper network planning, not because the main route forced you.", "The void bootstrap is now explicit: Certus Quartz, Charged Certus, Fluix, Certus Dust and Processor Presses all have gated Skyroot/Network bridge recipes.", "This quest now checks the AE2 Controller item, so it is no longer just a vague checkmark."]
	quest.1A1700000000000D.quest_desc: ["Oritech is an optional workshop path. Use it for extra processing depth after the basic industrial route already makes sense.", "Raw Silicon now has a Skyroot bridge through the Industrial Processor, Quartz, Sand and Resin, so the branch can start in a void world.", "Do not treat Oritech as a main gate unless your current factory actually benefits from its machines."]
	quest.1A18000000000001.title: "Player Experience Comes First"
	quest.1A18000000000001.quest_desc: ["The pack should feel guided, not crowded. If a route ever feels", "confusing, return to the main line and rebuild one clean step."]
	quest.1A19000000000001.title: "How To Use Playthrough Projects"
	quest.1A19000000000003.title: "Orchard Feeds The Base"
	quest.1A19000000000003.quest_desc: ["Make the first tree loop large enough that it feels like production instead of emergency survival.", "This project should make storage and Create feel easier to start."]
	quest.1A19000000000005.title: "A Wall That Actually Accepts Items"
	quest.1A19000000000005.quest_desc: ["A drawer wall is only satisfying when items can enter it without constant manual sorting.", "Use this as your first real anti-chest-monster project."]
	quest.1A19000000000007.title: "One Compact Create Cell"
	quest.1A19000000000007.quest_desc: ["Do not build a giant factory yet. Build one small cell that can press, move, grind or wash items.", "The cell is only finished when its output reaches a drawer, barrel or controlled buffer."]
	quest.1A19000000000009.title: "A Power Room That Does Not Stop"
	quest.1A19000000000009.quest_desc: ["Power should make the base calmer, not more stressful.", "This project proves you have generation, cable routing and a small buffer before adding heavier machines."]
	quest.1A1900000000000B.title: "One Scaling Path, Not Three Messes"
	quest.1A1900000000000B.quest_desc: ["Growth, crops, bees and magic are useful when they solve a real bottleneck.", "Pick one support path first, then expand only when it helps the factory.", "The new bridge recipes exist so you can choose a path intentionally, not so every optional mod becomes mandatory homework."]
	quest.1A1900000000000D.title: "Project: Plastic Infrastructure Loop"
	quest.1A1900000000000D.quest_desc: ["Industrial progress feels better when plastic is a loop, not a one-time craft.", "Use this project to turn tree output and power into real machine infrastructure."]
	quest.1A1900000000000F.title: "Project: Autocraft Something Boring"
	quest.1A1900000000000F.quest_desc: ["The best first autocraft is not exciting. It is something you are tired of making by hand.", "If the network can handle boring parts, it can start helping the whole playthrough."]
	quest.1A19000000000011.title: "Data Lab First Loop"
	quest.1A19000000000011.quest_desc: ["A good data lab replaces waiting at a mob farm with a controlled process.", "Train one useful model, simulate it, and fabricate a drop your factory actually needs."]
	quest.1A19000000000013.title: "Project: Five Systems Before The Finale"
	quest.1A19000000000013.quest_desc: ["Before the final route, prove the factory is connected.", "Create, power, industry, storage and mob data should all be doing useful work before the endgame asks for more."]
	chapter.097C000000000019.title: "Playthrough Projects"
	chapter.097C000000000019.subtitle: "Optional build prompts for players who want a concrete factory goal"
	quest.113000000000001B.quest_desc: ["Use the roadmap when you feel lost. It shows the safe order,", "but the actual work still happens inside the real chapters.", "Dense chapters may hide connection lines for readability; locked quests still follow their dependencies."]
	quest.1A19000000000001.quest_desc: ["Playthrough Projects are optional build prompts. Use them when", "you want a concrete factory goal instead of another checklist."]
	quest.1A14000000000001.quest_desc: ["Factory Contracts are optional challenge goals. They reward real", "working systems, not the act of reading an introduction."]
	quest.1A26000000000001.title: "A Safe Tree Buffer"
	quest.1A26000000000001.quest_desc: ["Before leaving the first chapter, keep a tiny buffer of the items that", "save the island from bad RNG: logs, resin, fiber and one spare sapling.", "Use JEI Uses on resin if you are unsure where the next craft begins."]
	quest.1A26000000000003.title: "Your First Resource Bench"
	quest.1A26000000000003.quest_desc: ["The orchard becomes fun once it can answer normal questions:", "Can it make ground blocks, fuel and early metals without a sieve wall?", "Check JEI Uses on acorns/resins before turning everything into blocks."]
	quest.1A26000000000005.title: "The First Sorted Corner"
	quest.1A26000000000005.quest_desc: ["Do not scale production while everything lands in one chest.", "Build one small drawer corner with a controller and one pipe route.", "It should look boring; that means it will keep working."]
	quest.1A26000000000007.title: "Press, Mill, Wash"
	quest.1A26000000000007.quest_desc: ["This is the first real Create cell: press metal, mill blocks and wash one output stream.", "Before expanding, make sure at least one output goes into a drawer or buffer instead of lying on the ground.", "Use JEI Categories to see which machine handles which process."]
	quest.1A26000000000009.title: "One Always-On Machine"
	quest.1A26000000000009.quest_desc: ["Power is ready when one machine can run without babysitting.", "Build the tiny proof first: generator, cable, buffer, powered machine,", "and a visible output route back into storage."]
	quest.1A2600000000000B.title: "Choose One Scaling Helper"
	quest.1A2600000000000B.quest_desc: ["Growth systems are optional helpers, not three chores at once.", "Prove one bee/crop/magic support route, then return to the main", "factory with something that actually helps production."]
	quest.1A2600000000000D.title: "Steel And Plastic Together"
	quest.1A2600000000000D.quest_desc: ["Industrial starts to click when steel, plastic and machine frames", "come from repeatable setups instead of one-off crafts. This is the", "checkpoint before digital storage should feel earned."]
	quest.1A2600000000000F.title: "A Network That Solves A Problem"
	quest.1A2600000000000F.quest_desc: ["A digital network is not just a bigger chest. Use JEI on External", "Storage, disks and processors, then make the network solve one real", "base problem instead of hiding unsorted items."]
	quest.5AE8DAEBFD4BF6EC.title: "Redstone Control Check"
	quest.5AE8DAEBFD4BF6EC.quest_desc: ["Redstone control keeps powered machines from becoming noisy or wasteful.", "Use this as the first reminder to plan switches, comparators and side behavior."]
	quest.0BBEE3039564F77F.title: "Obsidian For Dimensional Prep"
	quest.0BBEE3039564F77F.quest_desc: ["Obsidian is a bridge material for Nether and late utility routes.", "Make sure the route is repeatable before spending it in bulk."]
	quest.33D4F5FEA4803908.title: "End-Side Shell Check"
	quest.33D4F5FEA4803908.quest_desc: ["End resources should prove you reached the dimension route, not just found a random item.", "Keep chorus and shulker materials controlled before using them in final automation."]
	quest.147A998A36AB2A97.title: "Final Network Interface"
	quest.147A998A36AB2A97.quest_desc: ["The final route should connect to a network you can actually use.", "A crafting grid/interface check proves the endgame is built on real storage progress."]
	quest.1A29000000000001.title: "One Clean Intake"
	quest.1A29000000000001.quest_desc: ["Before Create starts throwing items around, give the base one clean place", "to receive repeated outputs. A drawer, controller, pipe and buffer barrel", "are enough for the first real intake. Lock the drawer once the item stream is clear."]
	quest.1A29000000000003.title: "Create Output Goes Somewhere"
	quest.1A29000000000003.quest_desc: ["A press, depot and chute are only useful when the output has a destination.", "Route one Create result into a drawer or buffer before building a bigger", "belt line. If it jams, check direction, filters and the receiving drawer first."]
	quest.1A40000000000001.title: "Food and Light Bundle"
	quest.1A40000000000001.quest_desc: ["A tiny comfort purchase for early mistakes. Use it when hunger or", "darkness would slow down testing, not as a replacement for farming", "and resource-tree production."]
	quest.1A40000000000002.title: "Builder Basics Bundle"
	quest.1A40000000000002.quest_desc: ["A small building refill for safe platforms and simple work areas.", "It is useful for base safety, but the island should still earn", "its main materials through the Skyroot loop."]
	quest.1A40000000000003.title: "Pipe Refill Bundle"
	quest.1A40000000000003.quest_desc: ["Extra pipes, hoppers and chests after the Redstone Tree has opened real item routing.", "Use the refill to repair or expand a tested network, not to skip the first crafted pipe."]
	quest.1A40000000000004.title: "Drawer Wall Bundle"
	quest.1A40000000000004.quest_desc: ["A drawer-focused refill for players who want cleaner bulk storage.", "The key is included as a reminder: lock drawers before scaling automation."]
	quest.1A40000000000005.title: "Create Belt Refill"
	quest.1A40000000000005.quest_desc: ["A practical Create refill for belts, shafts and alloy after Create is unlocked.", "It supports experiments without skipping the machines themselves."]
	quest.1A40000000000006.title: "Redstone Control Bundle"
	quest.1A40000000000006.quest_desc: ["A small control kit for droppers, filters, toggles and early automation tests.", "Buy it when a line needs control, not when you want to skip resource production."]
	quest.1A40000000000007.title: "Power Wiring Bundle"
	quest.1A40000000000007.quest_desc: ["A wiring refill for the first power network. It gives cable and one", "small buffer after power is unlocked, so debugging energy does", "not feel like busywork."]
	quest.1A40000000000008.title: "Mekanism Starter Refill"
	quest.1A40000000000008.quest_desc: ["A modest industrial material refill after the industrial path has opened.", "Steel and circuits help repeated machine crafting, but machines are still earned."]
	quest.1A40000000000009.title: "Plastic Recovery Bundle"
	quest.1A40000000000009.quest_desc: ["A recovery purchase for the latex and plastic loop. It should help", "after you understand the route, not replace the Fluid Extractor", "and Latex Processing setup."]
	quest.1A4000000000000A.title: "Network Cable Bundle"
	quest.1A4000000000000A.quest_desc: ["A digital-storage refill for cables and processor basics. Useful after", "your first network exists and you want to cleanly expand it."]
	quest.1A4000000000000B.title: "Network IO Bundle"
	quest.1A4000000000000B.quest_desc: ["A focused importer/exporter/external-storage refill for players building", "their first real network loops. It does not replace autocrafting progress."]
	quest.1A4000000000000C.title: "Rare Drop Recovery Bundle"
	quest.1A4000000000000C.quest_desc: ["A late recovery bundle for rare-drop routing mistakes after dimensions", "and mob-data progression are already under control."]
	quest.1A4000000000000D.title: "Final Comfort Bundle"
	quest.1A4000000000000D.quest_desc: ["A post-finale comfort purchase. This should only matter after the", "main route is already beaten, so it gives celebration items instead", "of early progression power."]
	chapter.097C000000000010.subtitle: "Drops and dimensions reward controlled systems"
	chapter.097C000000000011.subtitle: "Final rewards prove full automation"

	chapter_group.6A7C0F0A6D000001.title: "Resource Orchards"
	chapter.097C000000000007.title: "Resource Orchard Expansion"
	chapter.097C000000000007.subtitle: "Exact soil tiers from Mechanical to Industrial"
	quest.1170000000000001.title: "Lapis Tree"
	quest.1170000000000001.quest_desc: ["Open the early arcane material route after the", "Metal Orchard. Lapis stays renewable without generic hand-filtering."]
	quest.1170000000000003.title: "Redstone Tree"
	quest.1170000000000003.quest_desc: ["Use the Mechanical Skyroot Core to grow the", "first renewable control material for power and automation."]
	quest.1170000000000005.title: "Zinc Tree"
	quest.1170000000000005.quest_desc: ["Zinc supports Create brass and belongs after", "the first working mechanical line, not before it."]
	quest.1170000000000007.title: "Gold Tree"
	quest.1170000000000007.quest_desc: ["Gold follows Redstone and the established Copper/Iron orchard.", "It prepares power, storage and later network progression."]
	quest.1170000000000009.title: "Quartz Tree"
	quest.1170000000000009.quest_desc: ["Quartz completes the utility orchard for digital storage.", "It requires both the Lapis and Gold branches."]
	quest.117000000000000B.title: "Utility Orchard Checkpoint"
	quest.117000000000000B.quest_desc: ["Process the Tier 4 Mechanical Soil outputs", "before moving into the Tier 5 Energized Soil orchard."]
	quest.117000000000000D.title: "Tin Tree"
	quest.117000000000000D.quest_desc: ["Tin is the first energized industrial metal", "and supports Mekanism and broader machine crafting."]
	quest.117000000000000F.title: "Osmium Tree"
	quest.117000000000000F.quest_desc: ["Osmium is the defining Mekanism metal. It unlocks", "after stable FE and the Energized Skyroot Core."]
	quest.1170000000000011.title: "Lead Tree"
	quest.1170000000000011.quest_desc: ["Lead follows Tin and becomes", "a renewable shielding and machine material."]
	quest.1170000000000013.title: "Silver Tree"
	quest.1170000000000013.quest_desc: ["Silver grows from the Lead and Gold branches,", "keeping Immersive Engineering materials inside the orchard logic."]
	quest.1170000000000015.title: "Nickel Tree"
	quest.1170000000000015.quest_desc: ["Nickel connects the Iron/Osmium route", "to Oritech and Immersive Engineering alloys."]
	quest.1170000000000017.title: "Aluminum Tree"
	quest.1170000000000017.quest_desc: ["Aluminum grows from Clay, Tin and energized", "processing instead of requiring normal ore generation."]
	quest.1170000000000019.title: "Uranium Tree"
	quest.1170000000000019.quest_desc: ["Uranium is a controlled late-industrial orchard material. It", "follows Lead and Osmium, not the early island."]
	quest.117000000000001B.title: "Industrial Orchard Checkpoint"
	quest.117000000000001B.quest_desc: ["Prove the Tier 5 Energized Soil orchard works", "before moving to Tier 6 Arcane gems and Tier 7 Platinum."]
	quest.117000000000001D.title: "Diamond Tree"
	quest.117000000000001D.quest_desc: ["Diamond is a Tier 6 resource and grows only on Arcane Soil.", "It remains gated behind late processing and a complete energized orchard."]
	quest.117000000000001F.title: "Emerald Tree"
	quest.117000000000001F.quest_desc: ["Emerald is the second Tier 6 Arcane Soil tree.", "It follows the network route and remains a late renewable reward."]
	quest.1170000000000021.title: "Platinum Tree"
	quest.1170000000000021.quest_desc: ["Platinum is the only Tier 7 tree and grows only on Industrial Soil.", "It combines Nickel, Silver and Diamond for Oritech-focused late industry."]
	quest.1170000000000023.title: "Resource Orchard Complete"
	quest.1170000000000023.quest_desc: ["All seven Skyroot soil tiers are now established.", "Every sapling uses exactly one matching soil in-world and in Bonsai Pots."]
	quest.1B06000000000001.title: "Fire Porcelain Without A Furnace"
	quest.1B06000000000001.quest_desc: ["The first Furnace needs Cobblestone, so the opening uses one controlled bridge instead of forcing early Sieving.", "Craft the Skyroot Resin Campfire shown in JEI. Mix Clay Balls with Bone Meal into Porcelain Clay, shape three into an Unfired Porcelain Bucket, then cook it on the lit Campfire for 30 seconds.", "The Campfire recipes only fire the Bucket and Crucible; they do not create Water, Lava or basic materials."]
	quest.1B04000000000001.title: "Collect The First Water"
	quest.1B04000000000001.quest_desc: ["Craft a Skyroot Crucible from seven Skyroot Logs and place it safely on your platform.", "Add four Skyroot Leaves: each contributes 250 mB, so four create exactly 1000 mB Water.", "Use the fired Porcelain Bucket to collect the Water. The quest checks for the actual Porcelain Water Bucket, not an empty container."]
	quest.1B04000000000003.title: "Fire The Crucible And Make Lava"
	quest.1B04000000000003.quest_desc: ["Shape seven Porcelain Clay Balls into an Unfired Porcelain Crucible and cook it on the same lit Campfire for 30 seconds.", "Place the finished Crucible above a Torch or lit Campfire, then insert four Gravel; each contributes 250 mB Lava.", "Place the Water source first, empty the Porcelain Water Bucket, then reuse it to collect the Lava. The quest checks for the actual Porcelain Lava Bucket."]
	quest.1B04000000000005.title: "Build The First Cobblestone Generator"
	quest.1B04000000000005.quest_desc: ["Place Water so it flows into one empty meeting block, then let Lava flow into that same block from the opposite side.", "Never let the two source blocks touch. Protect both sources with non-flammable blocks and stand behind a safety edge before mining.", "Mine at least 16 Cobblestone to prove the generator is stable. Later, Create teaches continuous mechanical Cobblestone production."]
	quest.1B06000000000004.title: "Now Build A Real Furnace"
	quest.1B06000000000004.quest_desc: ["Use eight of the first Cobblestone to craft a Furnace. This closes the bootstrap loop cleanly.", "From this point onward, use normal Furnace recipes: smelt Clay Balls into Bricks for the Bonsai Pot and Skyroot Logs into Charcoal.", "The Campfire remains useful, but it is no longer your main processing block."]
	quest.1B04000000000007.title: "Your First Bonsai Pot"
	quest.1B04000000000007.quest_desc: ["Smelt Clay Balls into Bricks in the new Furnace and craft the normal Bonsai Pot; Hopping Bonsai Pots are not used in this version.", "Insert the exact matching Soil, then the Sapling, and place an axe in the tool slot so the tree harvests automatically.", "Start with one Rootbound Soil tree and confirm its internal output before expanding the orchard."]
	quest.1B04000000000009.title: "Pipez Bonsai Automation"
	quest.1B04000000000009.quest_desc: ["This step is deliberately later: Item Pipes require Iron and Redstone, so do not wait for them before using your first Bonsai.", "Connect a Pipez Item Pipe from the Bonsai Pot to a barrel or drawer and configure the pot-side connection to extract.", "The axe remains in the Bonsai tool slot; confirm Soil and Sapling stay inside while every harvested drop reaches storage."]

	quest.1B05000000000001.title: "Create Cobblestone Mechanical Generator"
	quest.1B05000000000001.quest_desc: ["A normal Create Drill cobblegen is useful, but this milestone teaches the dedicated Create Cobblestone block.", "Craft and hold the Mechanical Generator from Create Cobblestone. The quest checks that item specifically, not any drill setup.", "After the quest completes, place the generator, give it rotational power, right-click it with Cobblestone to set the output, then pipe the generated blocks into storage."]

	quest.1B17000000000001.title: "Build Bigger, Not Earlier"
	quest.1B17000000000001.quest_desc: ["Large platforms are useful once the island can produce stable FE and replace building materials.", "This optional branch starts after the Energized Skyroot Core so it speeds up construction without replacing the early Skyblock decisions."]
	quest.1B17000000000003.title: "Building Gadget"
	quest.1B17000000000003.quest_desc: ["Charge it with FE, keep the blocks you want to place in your inventory, and use the settings menu to choose a building mode.", "It is a construction tool, not free building: every placed block still comes from your supplies."]
	quest.1B17000000000005.title: "Preview Before You Click"
	quest.1B17000000000005.quest_desc: ["Default controls are G for settings, R for range, H for anchor and U for undo.", "Check the preview before placing anything near the void, storage wall or start island. Undo is a safety tool, not a replacement for backups."]
	quest.1B17000000000007.title: "Exchanging Gadget"
	quest.1B17000000000007.quest_desc: ["Replace simple structural blocks without rebuilding an entire platform or machine room.", "Use it on normal building blocks first. Avoid active machines, inventories, pipes and other complex block entities until that exact setup has been tested."]
	quest.1B17000000000009.title: "Advanced Gadgets Are Optional"
	quest.1B17000000000009.quest_desc: ["Copy/Paste, Cut/Paste and Destruction are powerful late utilities, not required progression.", "They unlock with industrial materials because moving or deleting large structures should happen only after the island has backups, power and replaceable resources."]
	quest.1B1700000000000B.title: "Copy-Paste Gadget"
	quest.1B1700000000000B.quest_desc: ["Copy a shape and paste it elsewhere when the required blocks are available.", "Start with plain blocks. Machines, cables, multipart blocks and inventories may not reproduce perfectly, so test small sections before copying a factory."]
	quest.1B1700000000000D.title: "Template Manager"
	quest.1B1700000000000D.quest_desc: ["Save and load Copy-Paste templates for repeated platforms or safe structural shells.", "Test small templates made from ordinary blocks first. Do not store untested templates containing machines, tanks, inventories or network parts."]
	quest.1B1700000000000F.title: "Cut-Paste Gadget"
	quest.1B1700000000000F.quest_desc: ["Move simple structures without rebuilding them block by block.", "Do not use it on loaded drawers, tanks, machines, pipes or digital storage. Those blocks carry data that may not survive a move safely."]
	quest.1B17000000000011.title: "Destruction Gadget"
	quest.1B17000000000011.quest_desc: ["This tool removes large areas quickly and is never required for the main route.", "Confirm the preview, keep it away from the start island and storage, and make a world backup before using a large range."]

	quest.1D18000000000001.title: "Drawer Wall Proof"
	quest.1D18000000000001.quest_desc: ["Build a real drawer wall, not a temporary chest pile.", "The required Oak Drawer and Oak Trim now have Skyroot-based recipes, so this proof stays on the main route instead of forcing a sieve-based oak detour."]
	quest.1D18000000000006.title: "Controlled Routing Proof"
	quest.1D18000000000006.quest_desc: ["Use the controller and pipes only after Redstone unlocks them.", "Void upgrades are safety rails, not a substitute for planning."]
	quest.1D1800000000000A.title: "Create Processing Cell"
	quest.1D1800000000000A.quest_desc: ["This is the first Create cell worth keeping.", "Press, mill, wash and move items before expanding the factory."]
	quest.1D1800000000000F.title: "Brass Automation Bench"
	quest.1D1800000000000F.quest_desc: ["Brass and precision mechanisms are where Create starts scaling.", "Keep this as a bench for repeatable machine parts."]
	quest.1D18000000000014.title: "Powered Builder Kit"
	quest.1D18000000000014.quest_desc: ["Charge the gadgets before trusting them with a platform.", "They are comfort tools for powered building, not earlygame shortcuts."]
	quest.1D18000000000018.title: "Machine Energy Bench"
	quest.1D18000000000018.quest_desc: ["A tiny power room needs more than a generator.", "Cables, a buffer and side configuration prevent most beginner problems."]
	quest.1D1800000000001D.title: "Bee Processing Loop"
	quest.1D1800000000001D.quest_desc: ["Bees become useful once their output has a home.", "Catch, process and sort before calling it a resource route."]
	quest.1D18000000000020.title: "Arcane Utility Bench"
	quest.1D18000000000020.quest_desc: ["Magic is optional, but it should still be understandable.", "This bench proves source storage, gems and imbuement are ready."]
	quest.1D18000000000025.title: "Occultism Ritual Starter"
	quest.1D18000000000025.quest_desc: ["Occultism works best when it is treated as a system, not a mystery.", "Gather the guide, bowl and gem before using rituals seriously."]
	quest.1D18000000000029.title: "Mekanism Processing Cell"
	quest.1D18000000000029.quest_desc: ["This is the first compact Mekanism workcell.", "It should improve repeated processing, not replace your whole factory at once."]
	quest.1D1800000000002E.title: "Plastic Production Cell"
	quest.1D1800000000002E.quest_desc: ["Plastic is a production chain, not just a recipe.", "Extractor, latex processing and a frame prove the Industrial Foregoing route is online."]
	quest.1D18000000000033.title: "Dissolution Chamber Workbench"
	quest.1D18000000000033.quest_desc: ["The Dissolution Chamber is where Industrial Foregoing becomes infrastructure.", "Do not rush it; give it materials and space."]
	quest.1D18000000000036.title: "Network Hardware Bench"
	quest.1D18000000000036.quest_desc: ["Digital storage should be a network, not a magic chest.", "Controller, grid, drive and cables make the minimum stable setup."]
	quest.1D1800000000003B.title: "Import Export Bench"
	quest.1D1800000000003B.quest_desc: ["Automation begins when the network moves items on purpose.", "Importers, exporters and external storage need a plan before autocrafting."]
	quest.1D18000000000040.title: "HNN Simulation Bench"
	quest.1D18000000000040.quest_desc: ["Hostile Neural Networks turns waiting into controlled production.", "Train a model, run a simulation and keep predictions flowing."]
	quest.1D18000000000045.title: "Fabricated Loot Bench"
	quest.1D18000000000045.quest_desc: ["The fabricator is the payoff for training models.", "Use it for repeatable drops instead of standing inside mob farms forever."]
	quest.1D18000000000048.title: "Dimension Entry Kit"
	quest.1D18000000000048.quest_desc: ["Dimension access should be deliberate in a Skyblock pack.", "Obsidian, blaze powder and eyes prove you are ready to leave the island safely."]
	quest.1D1800000000004C.title: "Real Mod Finale Proof"
	quest.1D1800000000004C.quest_desc: ["The finale should prove real systems, not just custom markers.", "Bring one proof from Create, Mekanism, Digital Storage and rare drops."]

	quest.1E23000000000001.title: "Midgame Metal Route Proof"
	quest.1E23000000000001.quest_desc: ["This is the exact survival handoff from early trees into machines.", "Coal gives fuel, Copper and Iron give traces, and traces become the first repeatable metals.", "Complete this before judging whether Create feels too early or too late."]
	quest.1E23000000000009.title: "Redstone Unlock Proof"
	quest.1E23000000000009.quest_desc: ["Redstone is the gate that turns storage from a drawer wall into controlled routing.", "Confirm the Redstone Tree and a small dust buffer before crafting the Controller and Item Pipes."]
	quest.1E2300000000000F.title: "One Routed Drawer Line"
	quest.1E2300000000000F.quest_desc: ["Do not build a spaghetti network yet.", "Use one Controller, one locked Drawer, and one Pipez Item Pipe to prove that a Bonsai or machine output can reach the correct storage target."]
	quest.1E23000000000016.title: "Create Route Proof Cell"
	quest.1E23000000000016.quest_desc: ["This is the minimum Create setup that should feel worth keeping.", "Press one sheet, mill one material, wash one output and move items with a Belt before scaling the line."]
	quest.1E2300000000001E.title: "First FE Workbench"
	quest.1E2300000000001E.quest_desc: ["Most power problems are easier to solve when the first setup is tiny.", "One generator, one cable, one battery, one powered machine and one tablet are enough to prove the FE route."]
	quest.1E23000000000026.title: "Powered Building Ready"
	quest.1E23000000000026.quest_desc: ["The Building Gadget belongs here: after power, a real material supply and at least one charged Energy Tablet.", "Use it on simple platform blocks first, not on machines, loaded storage, pipes or network blocks."]
quest.1F09000000000001.title: "Black Quartz Without Guessing"
quest.1F09000000000001.quest_desc: ["Black Quartz is the entry material for Actually Additions. Sifting Gravel still works, but it should not be the only way to discover the route in a Skyblock pack.", "Use the Skyroot bridge recipe: Quartz + Coal or Charcoal + Redstone + Skyroot Resin. If you already have a Mixer, use the Create Mixing recipe for a better batch.", "This quest checks the actual Black Quartz item, not a checkmark. Once you can make a small buffer, Actually Additions can start without ore worldgen or guessing."]

}
