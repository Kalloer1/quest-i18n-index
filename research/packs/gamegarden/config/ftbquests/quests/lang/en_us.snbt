	quest.589F0F4D863E9DF8.quest_subtitle: "YUM YUM YUM YUM YUM YUM"
	quest.58CA65DB2C01E402.quest_desc: ["Place it on a &efoundry drain&r to cast liquids."]
	quest.5A774E8296B7613B.quest_desc: [
		"You're able to convert ingredients you get from gardens into &dseeds&r by dropping them into a crafting menu, such as from your inventory."
		""
		"You can also plant the crops directly, but some recipes will call for seeds specifically. This includes &#FFC3F0Seed Soup&r, or the &#FFC3F0Miracle Seed&r from Cobblemon!"
	]
	quest.5A774E8296B7613B.title: "Seeds"
	quest.5BD64090BE816564.quest_desc: [
		"Use a &9Tier III Smithing Template&r at the &eSmithing Table&r to upgrade your Copper Armor."
		""
		""
		"Recipe: Tier III Template + Copper Chestplate + Aluminum Block"
		"Provides protection against lightning and electrical damage from Immersive Engineering."
	]
	quest.5BD64090BE816564.quest_subtitle: "Shock-resistant workwear for the industrial age."
	quest.5BD64090BE816564.title: "Tier 4 — Faraday Chestplate"
	quest.5C821529F86E970A.quest_desc: ["&oEnergy drink with an &#6A4F40aftertaste&r &oonly a mother could love.&r&r"]
	quest.5C821529F86E970A.quest_subtitle: "Distinguished."
	quest.5F8A8DC2BCAE8103.quest_desc: [
		"For instructions on how to assemble the foundry, hold [W] on the &efoundry controller block&r for an interactive demonstration. When the multiblock has formed, the floor will start glowing and controller light up!"
		""
		"If you melt down raw ores, the foundry will &6double the ore yield&r! Meaning you get two ingots per raw ore."
	]
	quest.5F8A8DC2BCAE8103.title: "The Foundry"
	quest.617F2A9CDC5840DF.quest_desc: ["&#B6FFA1&oGood ol' reliable.&r&r"]
	quest.617F2A9CDC5840DF.quest_subtitle: "There's even a mod for it."
	quest.622E8647708C0338.quest_desc: ["This modpack adds many new ways of &#FFC3F0cooking&r. This questline will guide you through the basics!"]
	quest.622E8647708C0338.title: "Getting Started with Cooking"
	quest.63C6BD3A4CAE55F6.quest_desc: ["The &eSpyglass&r can be used to see things from afar. But it also has another function, try looking at stuff with it and see what happens!"]
	quest.63F7134CF980478D.quest_desc: [
		"Use a &7Tier I Smithing Template&r at the &eSmithing Table&r to upgrade your Backpack."
		""
		""
		"Recipe: Tier I Template + Backpack + Copper Block"
		"Unlocks more storage slots and upgrade slots."
	]
	quest.64B39E253CC38B38.quest_desc: [
		"Use a &2Tier II Smithing Template&r at the &eSmithing Table&r to upgrade your Stone Pickaxe."
		""
		""
		"Recipe: Tier II Template + Stone Pickaxe + Copper Block"
	]
	quest.64B39E253CC38B38.quest_subtitle: "Your first crafted metal tool."
	quest.64B39E253CC38B38.title: "Tier 3 — Copper Pickaxe"
	quest.65159A8489959BC1.quest_desc: ["Speeds up the foundry but uses more fuel."]
	quest.659F01A5E8FE6DAC.quest_desc: [
		"Use a &5Tier IV Smithing Template&r at the &eSmithing Table&r to upgrade your Gold Backpack."
		""
		""
		"Recipe: Tier IV Template + Gold Backpack + Diamond Block"
	]
	quest.665F0936145AD615.quest_desc: [
		"The Coke Oven converts regular coal into &eCoal Coke&r."
		""
		"&eCoal Coke&r mainly used for creating steel in the blast furnace, but it also lasts &6twice as long&r as fuel in furnaces!"
	]
	quest.665F0936145AD615.title: "Coke Oven"
	quest.66F907D259D1B401.quest_desc: ["&4&oHmmm...&r&r"]
	quest.66F907D259D1B401.quest_subtitle: "A bit.. sweaty?"
	quest.679866D88F7393BA.quest_desc: [
		"The purple &5Epic Upgrade Smithing Template&r."
		"Used to upgrade &6Iron/Bronze/Gold/Faraday-tier&r gear to &eDiamond or Steel-tier&r at the &eSmithing Table&r."
		"Also upgrades &6Gold Backpacks, Bundles and Belts&r to &eDiamond-tier&r."
	]
	quest.68156C2F534FD9E8.quest_desc: [
		"&oA simple but potent mix of ammonium chloride and sugar. "
		""
		"&o(&0Salmiak&r, &oif you don't wanna scare people as much.)&r&r&r"
	]
	quest.68156C2F534FD9E8.quest_subtitle: "Satana Perkele.."
	quest.6B0F155C496B3AB2.quest_desc: [
		"Use a &6Tier V Smithing Template&r at the &eSmithing Table&r to upgrade your IE Steel Armor."
		""
		""
		"Recipe: Tier V Template + IE Steel Armor Chestplate + Netherite Ingot"
		"Note: Only Immersive Engineering Steel Armor can be upgraded to Netherite."
	]
	quest.6B0F155C496B3AB2.quest_subtitle: "The pinnacle of protection."
	quest.6B0F155C496B3AB2.title: "Tier 6 — Netherite Chestplate"
	quest.6B6D2F19864F9764.quest_desc: [
		"Welcome to Solar Flux! This little mod adds a range of &esolar panels&r which &6generate power&r."
		""
		"Each tier generates more power, but is more expensive and require more advanced materials."
	]
	quest.6B6D2F19864F9764.title: "Solar Flux"
	quest.6D3E7C6A30F189DA.quest_desc: [
		"Now that you have the cookware, how do you use it?"
		""
		"&#DAFFB5Pam's&r recipes don't require an additional cooking block. If you have the recipes and cookware, you can get cooking right away &#FFC3F0in a crafting table&r or your inventory."
		""
		"The &#DAFFB5FD&r Pot requires a &#FFC3F0Stove&r. Make one! Once you have, you can put the pot on it and get to cooking. &4&7&o(Make sure that you aren't crafting the Mr. Crayfish stove by accident!)&r&r&r"
	]
	quest.6D3E7C6A30F189DA.title: "Cooking"
	quest.6DE440E62A71E01F.quest_desc: [
		"The pinnacle of pickaxes."
		"Vanilla crafting has been disabled — obtain via loot or by reaching this milestone in the upgrade chain."
	]
	quest.6DE440E62A71E01F.quest_subtitle: "The apex of tool progression."
	quest.6DE440E62A71E01F.title: "Tier 6 — Netherite Pickaxe"
	quest.6DE86364DDDAF3CD.quest_desc: ["Handy upgrade that prevents alloying in the foundry, meaning all fluids will stay separated."]
	quest.6E3879411C437B82.quest_desc: ["This allows you to see all connected inventories. Connect it anywhere on the network, or place it directly on the inventory connector."]
	quest.6E99A6C7F59DA4EA.title: "Bronze"
	quest.6EC23FF540AB6ABD.quest_desc: ["The pack adds an array of metals and alloys, exotic and non-exotic ones. Check them out!"]
	quest.6F2C381AE5F3BA41.quest_desc: [
		"Use a &5Tier IV Smithing Template&r at the &eSmithing Table&r to upgrade your Iron, Bronze, or Gold Pickaxe."
		""
		""
		"Recipe: Tier IV Template + [Iron / Bronze / Gold Pickaxe] + Diamond Block"
	]
	quest.6F2C381AE5F3BA41.quest_subtitle: "Rare, precious, and worth the grind."
	quest.6F2C381AE5F3BA41.title: "Tier 5 — Diamond Pickaxe"
	quest.6F996D8356FE1CBC.quest_desc: ["&3&oYou know, I used to know a boy..&r&r"]
	quest.6F996D8356FE1CBC.quest_subtitle: "As Peder would say:"
	quest.704E2B807E31FE2A.quest_desc: ["Same as the other speed upgrade but even faster!"]
	quest.70DDC2B811D5E641.quest_desc: ["&dWild crops&r can be found in the overworld, such as wild onions, potatoes, peanuts and so on. These are from &#DAFFB5Farmer's Delight&r, and they will tell you exactly what crop they'll drop in the name, whereas &dgardens&r have a random chance to drop anything from their respective loot pools."]
	quest.70DDC2B811D5E641.title: "Wild Crops"
	quest.7107ECDCD061E97B.quest_desc: ["The brains of the foundry. Interact with this to see which fluids are in the foundry, which items are being melted, and how much fuel there is left."]
	quest.7109040180CB730D.quest_desc: [
		"The orange &6Legendary Upgrade Smithing Template&r."
		"Used to upgrade &6Diamond/Steel-tier&r gear to &eNetherite-tier&r at the &eSmithing Table&r."
		"Also upgrades &6Diamond Backpacks, Bundles and Belts&r to &eNetherite-tier&r."
	]
	quest.7113BA6E21905598.quest_desc: [
		"The green &2Uncommon Upgrade Smithing Template&r."
		"Used to upgrade &6Stone-tier&r tools and &6Leather Armor&r to &eCopper-tier&r at the &eSmithing Table&r."
		"Also upgrades &6Copper Backpacks, Bundles and Belts&r to &eIron-tier&r."
	]
	quest.74DD8DC28497307B.quest_desc: ["Has a few uses. In this pack, you can make caffeine with it."]
