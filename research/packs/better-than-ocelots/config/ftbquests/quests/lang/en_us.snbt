	chapter.F97E419C219D36A1.title: "Day One: The First Night"
	chapter_group.F6295D274D50C9A9.title: "Beginner's Guide"
	quest.0441B20320663104.quest_desc: ["A &lStone Axe&r allows you to mine the entire &lLog&r and if combined in the crafting grid with the &lStone Axe&r - turns &lLogs&r into &lShafts&r much faster than punching. "]
	quest.0441B20320663104.title: "Better Than a Pointy Rock"
	quest.06086C54E945C6FC.title: "Complete \"Age of Brick\""
	quest.071C475064B8EE77.quest_desc: ["Mine more &lIron&r to get your first &lIron Tool&r. "]
	quest.071C475064B8EE77.title: "More Iron!"
	quest.0C55C2EBEDABD4E9.quest_desc: ["Place a &lWireless Transmitter&r ontop of a powered &lElectric Motor&r in order to transmit &lMechanical Power&r to another &lWireless Transmitter&r attached to a &lRedstone Clutch&r."]
	quest.0C55C2EBEDABD4E9.title: "Wireless Power!"
	quest.0D506DDB5CAA9860.quest_desc: [
		"&lCharged Batteries&r are required to power an &lElectric Motor&r. "
		""
		"1 &lCharged Battery&r = 2 days of power."
		""
		"Craft 1 &lDead Battery&r or a &lDead Battery Pack&r and have them struck by &lLightning&r in order to charge them."
		""
		""
		"{image:btoimages:textures/quests/battery2.png width:209 height:270 align:center}"
	]
	quest.0D506DDB5CAA9860.title: "Storing Power"
	quest.0EBB969EAA2016DA.quest_desc: [
		"Add your &lGround Netherrack&r in a &lMechanically Powered Hopper&r with &lSoul Sand&r in the top slot to make &lHellfire Dust&r. Optional - add an &l&lUrn&r&r underneath the hopper to also recieve a &l&lSoul Urn&r&r"
		""
		"{image:btoimages:textures/quests/soul_urn_making.png width:201 height:200 align:center fit:true}"
		"{image:btoimages:textures/quests/soul_urn_making2.png width:200 height:201 align:center}"
	]
	quest.0EBB969EAA2016DA.title: "Let There Be Hellfire"
	quest.0EC19AC16D314C74.quest_desc: [
		"Using your &lWooden Chisel&r - Mine a piece of stone to get a &lLoose Stone&r. Craft it into a &lStone Chisel&r, which harvests wood noticeably faster than your bare hands."
		"It's worth grabbing a few &lLoose Stones&r before you go back to chopping trees."
	]
	quest.0EC19AC16D314C74.title: "a Pointy Rock!"
	quest.131F31A54FE4E34E.title: "Slay the Ender Dragon"
	quest.141A895B59D5963A.quest_desc: ["An &lIron Pickaxe&r will allow you to mine the &l2nd Strata Level - Tuff&r. This layer is filled with more ores and even some &lDiamonds&r."]
	quest.141A895B59D5963A.title: "Strata Level 2!"
	quest.157592258CCBA96A.quest_desc: [
		"\"Which iron tool first?\" is one of the most debated questions in BTW - there's no single right answer, it depends on your situation."
		"Pickaxe: faster mining and access to the third Strata layer. Axe: wooden plank recipes and mob-proof wood building. Shears: string from webs and hemp harvesting."
		"Sword: blocking, halving damage taken. Shovel: full dirt blocks and clay at speed. Hoe: faster hemp seeds and instant wet farmland. Bucket: milk and water for a Cauldron. Flint and Steel: cheapest of all, instant fire without spending hunger."
		"Make whichever one matches what you need most right now - there is no wrong choice here."
	]
	quest.157592258CCBA96A.title: "Craft Your First Iron Tool"
	quest.1A4DA94754211DBC.quest_desc: [
		"You can copy &lArcane Scrolls&r using a &lLecturn&r."
		""
		"Place an &lEmpty Scroll&r + an &lEnchanted Scroll&r onto the &lLectern&r and begin copying the scroll using a &lQuill and Ink&r. Once the scroll has completedy copying, tie it with a piece of &lString&r or &lHemp Fiber&r to get your copied scroll."
		""
		""
		"{image:btoimages:textures/quests/lectern_copying.png width:207 height:248 align:center}"
	]
	quest.1A4DA94754211DBC.title: "Scribing"
	quest.1AFDFA11BD4B2FF5.quest_desc: ["&lBrick Smokers&r cook &lFood&r much quicker than the &lBrick Oven&r. They can only cook &lFood&r though."]
	quest.1AFDFA11BD4B2FF5.title: "Now Were Cooking"
	quest.1B0E6CA313C1FF7B.quest_desc: ["The best&l Pickaxe&r in the game, well done!"]
	quest.1B0E6CA313C1FF7B.title: "Reinforced Mining"
	quest.1C90167BC3220896.quest_desc: [
		"&lSoulforged Nethersteel&r best material in the game and will also allow you to make 2 new tools - the &lMattock&r and the &lBattleaxe&r. "
		""
		"Thrive and conquer the world, now that you have conquered death!"
	]
	quest.1C90167BC3220896.title: "Endgame Gear"
	quest.1C94B23109A96665.quest_desc: ["Using your &lStone Chisel&r - Mine 8 &lIron Ores&r to acquire 8 &lPiles of Iron Dust&r. Combine them in the crafting grid to make 4 &lChunks of Raw Iron&r."]
	quest.1C94B23109A96665.title: "Piles of Iron Dust"
	quest.1F18D41FE2062541.quest_desc: ["Curing a &lZombie Villager&r requires you to throw a &lSoul Urn&r at the &lZombie Villager&r. "]
	quest.1F18D41FE2062541.title: "Save the World"
	quest.1F8A58B7E7280094.quest_desc: ["A &lSaw&r will open up a plethora of new recipes and make old ones cheaper. Crafting this is a must in progressing forward and for making life a lot easier."]
	quest.1F8A58B7E7280094.title: "Carpentry"
	quest.2035BBE1941F65E2.quest_desc: ["Locate the &lStronghold&r using &lEyes of Ender&r and enter the portal to slay the &lEnder Dragon&r"]
	quest.2035BBE1941F65E2.title: "Find a Stronghold and Enter the End"
	quest.21E51269BC08C698.title: "Completed \"Age of Brick\""
	quest.26FEEEAFAD2DE0B0.quest_desc: ["You'll want a productive wheat farm, at least 2 cows, at least 2 wolves, 7 iron and a Water Bucket - the raw materials for your first Cauldron and a steady supply of Leather and Dung."]
	quest.26FEEEAFAD2DE0B0.title: "Gather Cows, Wolves, and Iron"
	quest.2905B95552E454BA.quest_desc: [
		"Watch for Soul Sand patches and other Nether landmarks as clues while you explore - Nether Fortresses are the only source of Blaze Rods."
		"Blaze Rods are essential further down the tech tree, so grab a good stock while you're there."
	]
	quest.2905B95552E454BA.title: "Find a Nether Fortress and Collect Blaze Rods"
	quest.29472C2C89C22AA1.quest_desc: ["Combine 2 &lWool Knit&r and 1 &lString&r or &lSinew&r to make a &lBedroll&r. You can now skip the night! Although beware... the world still moves around you as you are sleeping, so be sure you are safe before closing your eyes."]
	quest.29472C2C89C22AA1.title: "Rest Up"
	quest.2A9321930F474C38.quest_desc: ["Using an &lIron Chisel&r - Mine &lStone&r to acquire &lStone Bricks&r. These are essential for many &lMachine&r based crafting recipes"]
	quest.2B2F4D51125AE0E7.quest_desc: [
		"A &lCrucible&r will make life much easier - as it allows for new recipes as well as the &lSmelting Refund System&r. All &lIron Tools, Weapons, Armour&r and some &lBlocks / Items&r - will provide a &l2/3 Refund&r when smelted down in the &lCrucible&r. On the other hand - &lDiamond&r items will provide a &l1/1 Refund&r, essentially making them endless!"
		""
		"{image:btoimages:textures/quests/crucible_setup.png width:210 height:109 align:center}"
	]
	quest.2B2F4D51125AE0E7.title: "Re-smelt, Re-use"
	quest.2C7C02054EC1C116.quest_desc: ["A &lDiamond Pickaxe&r will now allow you to mine &lObsidian&r in Order to build a &lNether Portal&r. It will also unlock the 3rd and Final &lStrata Layer - Deepslate&r. Down here you will find more &lDiamonds&r as well as &lAncient Debris&r. You will not be able to mine &lAncient Debris&r until you have defeated the &lWither&r."]
	quest.2C7C02054EC1C116.title: "Final Strata Layer!"
	quest.2C9954CB00BB5707.quest_desc: [
		"Crafting an Iron Axe unlocks mechanical power. Chiseling stone yields Stone Brick plus loose stone - use them with a Gear to build a Hand Crank and Mill Stone."
		"The hand crank burns through hunger fast, so treat it as a bridge to real automation, not a long-term solution."
	]
	quest.2C9954CB00BB5707.title: "Build a Hand Crank and Mill Stone"
	quest.2CBBB52E901A6DCA.quest_desc: [
		"&lWindmills&r is the first step into &lEndless Power&r and not needing to use a &lHand Crank&r anymore! Craft &lFabric&r,"
		" &lRope&r and &lSails&r, then &lAxles&r, &lGear Boxes&r and a &lWindmill&r. &lGearboxes&r and &lAxles&r are the backbone of every mechanical setup you'll build from here on, so make plenty."
		"A working &lWindmill&r needs roughly 5 &lGearboxes&r and 20 &lAxles&r to bring power to ground level. The &lWindmill&r itself is a full 13x13 - build a tower at least 10 blocks tall, and keep the 6 blocks around its mount point clear (even torches and vines can block placement)."
		""
		"{image:btoimages:textures/quests/windmill.png width:200 height:260 align:center}"
	]
	quest.2CBBB52E901A6DCA.title: "Build a Windmill"
	quest.2CEF549827038B2A.quest_desc: [
		"  &l&4Welcome to Better Than Ocelots&r&r"
		""
		"&lBetter Than Ocelots&r tears out the convenience of vanilla survival and replaces it with a slower, harsher, and far more rewarding game. Nothing about your early game is safe - hunger, mining, building, farming, trading, and even exploration have all been reworked from the ground up. If you've played &lBetter Than Wolves&r, you already know the philosophy: every comfort has to be earned."
		""
		"This is a &lGuide&r into helping you survive and thrive in this modpack, go through each &lAge&r and best of luck!"
		""
		"Make sure to set a &lHotkey&r for the quest menu - incase you lose the &lQuest Book&r"
	]
	quest.2CEF549827038B2A.title: "Read Me"
	quest.2D6A454E77F33D0B.title: "Completed \"Age of Commerce\""
	quest.2F6382C29CC3D1EA.quest_desc: [
		"One &lWindmill&r can power far more than a single &lMill Stone&r - extend your &lAxles&r and &lGear Boxes&r so grinding runs off wind power full-time. Another option you can look at for power is a &lWater Wheel&r - this acts the exact same as a windmill but instead of it being in the air, it's in flowing water."
		"You're about to need a LOT of milling. Set your &lMill Stone&r up so you can feed it in bulk before you start hauling &lNetherrack&r home."
		""
		"{image:btoimages:textures/quests/mill_stone.png width:209 height:200 align:center}"
	]
	quest.2F6382C29CC3D1EA.title: "A Small Factory"
	quest.30573C932E2710D4.quest_desc: [
		"A &lKiln&r is an important step into progressing further and finishing this mod pack. You can smelt &lOres&r faster as well as fire up &lPottery&r."
		""
		"Build a &lKiln&r using 4 &lLoose Bricks&r and right clicking them with &lClay Balls&r to allow them to float mid air. "
		""
		""
		"{image:btoimages:textures/quests/kiln_setup.png width:213 height:120 align:center}"
		""
		""
		"{image:btoimages:textures/quests/kiln_smelting.png width:103 height:235 align:center}"
	]
	quest.30573C932E2710D4.title: "Fire it up!"
	quest.312FD5A05837253B.quest_desc: [
		"Power your Saw from a gearbox near your mill. Feed it wood to cut into Panels, then Moulding, then Corners - and Corners into Gears for an efficient gear supply."
		"Combine 2 Panels, 2 Gears and 1 Corner into a Hopper - the piece that finally opens up real item automation, from farms to nether-side sorting."
	]
	quest.312FD5A05837253B.title: "Build a Hopper"
	quest.3554169001CDDE12.quest_desc: [
		"Begin farming Crops you find from Villages for a food supply that doesn't depend on hunting."
		"Your &lPlanters&r and a steady water supply make this the first truly sustainable food setup you can build."
		""
		"&lMushrooms&r also provide a large amount of recipes. Since growing them requires complete darkness - be sure to grow them on &lWood&r, as mobs cannot spawn on it."
	]
	quest.3554169001CDDE12.title: "Sustainable Food"
	quest.35BF0749F8E30B5B.quest_desc: [
		"The &lWither&r - This fight is extremely difficult and will require much preperation, so do not feel the need to rush this or you will die and you will spawn in the middle of knowhere."
		""
		"The Wither is now built using &lCondensed Bone&r and 3 &lInfused Skulls&r instead of &lSoul Sand&r and &lWither Skeleton Skulls&r. The statue also requires a &lSoul Urn&r to be thrown at it in order to summon the &lWither&r"
		""
		"{image:btoimages:textures/quests/wither_summon.png width:187 height:161 align:center}"
	]
	quest.35BF0749F8E30B5B.title: "A Tough Fight"
	quest.35CF223CFAD70B82.title: "DIAMOND!"
	quest.397107F4DC36B5C9.quest_desc: ["&lString&r - A vital step towards progressing to starter tools. Stone tools require either string or sinew in order to be crafted. String can be obtained via killing spiders or breaking a &lCobweb&r using a &lStone Chisel&r. Spiders will hunt chickens by shooting cobwebs at them.                                                                             &lSinew&r - An alternative to string. This item can be made by gathering either 2 &lRaw Beef&l or 2 &lRaw Wolf Chops&r and combing them with a &lStone Chisel&r in the crafting grid. This will give you &lSinew Extraction&r - Hold right click on this item for 2 minutes and you will be awarded with 1 &lSinew&r and your Stone Chisel"]
	quest.397107F4DC36B5C9.title: "Road To Real Tools"
	quest.39B2027A6FFC6342.quest_desc: ["&lNethercoal&r crafts into proper &lTorches&r that never burn out, unlike the &lCrude Torches&r you were relying on before."]
	quest.39B2027A6FFC6342.title: "Permanent Torches!"
	quest.3B699BCCB8A83A0B.quest_desc: [
		"Craft &lBellows&r in order to &lStoke&r your &lHibachi&r. &lBellows&r need &lMechanical Power&r alternating from on and off in order to work properly - an easy way to do this is through the &lTurntable&r or &lRedstone Repeaters&r - which is more expensive."
		""
		"{image:btoimages:textures/quests/bellows.png width:177 height:136 align:center}"
	]
	quest.3B699BCCB8A83A0B.title: "Stoking the Flame"
	quest.3C82C064D5C1D118.title: "Beat Better Than Ocelots!"
	quest.3F0DF9855EF7064C.quest_desc: ["A full set of &lArmadillo Armour&r will allow you to &lRoll Up&r into a ball much like an &lArmadillo&r - making you &lInvulnerable&r to all damage as long as you don't move."]
	quest.3F0DF9855EF7064C.title: "Ballin'"
	quest.4093BDC2392528D7.quest_desc: ["A &lStone Shovel&r allows you to break dirt, sand and gravel much quicker. More importantly - It double the yeild of &lClay&r from &lClay Ore&r."]
	quest.4093BDC2392528D7.title: "a Real Shovel"
	quest.4181642C12396888.quest_desc: ["Craft a &lWooden Chisel&r using 1 &lShaft&r"]
	quest.4181642C12396888.title: "a Pointy Stick!"
	quest.4365BA808C57EC1C.quest_desc: [
		"Different Animals now require different needs. "
		""
		"Animals will go hungry if not given a large enough pen size to feed on "
		""
		"Animals also require the following foods in order to breed:"
		""
		"&lPig - Chocolate&r"
		"&lCow - Cake&r"
		"&lHorse - Carrot Cake&r"
		"&lChicken - Chicken Feed&r"
		"&lSheep - Pumpkin Pie&r"
		""
		"{image:btoimages:textures/quests/pigs.png width:210 height:240 align:center}"
		""
		"{image:btoimages:textures/quests/cows.png width:210 height:240 align:center}"
		"(Horses are the same as Cows) "
		""
		"{image:btoimages:textures/quests/chickens.png width:210 height:240 align:center}"
		""
		"{image:btoimages:textures/quests/sheep.png width:210 height:240 align:center}"
	]
	quest.4365BA808C57EC1C.title: "Livestock"
	quest.46BFA1683BBA74DB.quest_desc: ["The &lIron Axe&r will allow you to recieve &lPlanks&r from &lLogs&r, rather than just &lShafts&r."]
	quest.46BFA1683BBA74DB.title: "Wooden Planks!"
	quest.46D354CF67506119.quest_desc: [
		"&lVaillages&r are Now seperated by 3 states:"
		""
		"&lAbandoned:&r Just as it sounds - completely abandoned with just the shell of the buildings left over."
		""
		"&lSemi-Abandoned:&r Much like the abandoned village - except it has a chance to have about half the crops left."
		""
		"&lNon-Abandoned:&r These villages have some workstations left, all the crops, animals and &lZombie Villagers&r."
		""
		"{image:btoimages:textures/quests/village_distances.png width:197 height:160 align:center}"
	]
	quest.46D354CF67506119.quest_subtitle: "Find a Non-Abandoned Village and Look at a Zombie Villager"
	quest.46D354CF67506119.title: "Saving the World"
	quest.49FC311080EEEF06.title: "Completed \"Age of Flame\""
	quest.4A1C4EF63B0EE0B3.quest_desc: ["A full set &lTurtle Armour&r will provide you with -50% damage taken from behind - so you can run away and survive much easier."]
	quest.4A1C4EF63B0EE0B3.title: "Turtle Power!"
	quest.4A24B458BE74120A.quest_desc: ["&lIron Shovels&r will now allow you to mine the full block rather than just recieve small piles."]
	quest.4CBA1B13D58E0C25.quest_desc: [
		"&lEnder Spectacles&r allow you to look at &lEndermen&r (as &lCarved Pumpkins&r no longer have this feature) without them getting agrressive. "
		""
		"&lEnder Spectacles&r also show where hostile mobs can spawn by emitting particles across the ground."
		""
		"It is HIGHLY encourage to make and wear these before going to &lThe End&r and slaying the &lEnder Dragon&r"
	]
	quest.4CBA1B13D58E0C25.title: "You Can't See Me"
	quest.4CEFC3D86AE7BCCC.quest_desc: ["Find a &lDormant Soul Forge&r in a &lNether Fortress&r - You will need this for later &lAges&r"]
	quest.4CEFC3D86AE7BCCC.title: "Preparing For The Future"
	quest.52B9CBDFF2973A8E.quest_desc: ["Craft an &lIron Hoe&r and start digging up &lGrass&r. eventually you will dig up &lHemp Seeds&r. &lHemp&r is essential in moving forward to &l&6Age of Flame&r&r."]
	quest.530A47F59D8EA760.quest_desc: [
		"Before getting a &lKiln&r, it is worth upgrading your &lBrick Ovens&r into &lBrick Blast Furnaces&r in order to smelt &lOres&r quciker&r. They can only smelt &lOres&r."
		""
		"&lBrick Blast Furnaces&r require fuels that burn hotter than the fuels used for the &lBrick Oven&r and &lBrick Smoker&r."
		""
		""
		" "
	]
	quest.530A47F59D8EA760.title: "Blasting Ores"
	quest.5377630B6291C842.quest_desc: [
		"&lMechanically Power&r and use a &lTurntable&r to &lSpin&r a &lClay Block&r into an &lUnfired Crucible&r. Place the &lUnfired Crucible&r in a &lKiln&r and wait for it pop out as a &lCrucible&r."
		""
		"This is also how you make &lPlanters&r, &lVases&r and &lSoul Urns&r"
		""
		"{image:btoimages:textures/quests/unfired_pottery_types.png width:196 height:76 align:center}"
	]
	quest.5377630B6291C842.title: "Pottery"
	quest.55137322EC7C3675.quest_desc: [
		"The &lIndustrial Smelter&r is the final upgrade to your &lOvens&r smelting capability. The &lIndustrial Smelter&r will give you a full &lIngot&r from 1 &lRaw Ore&r. It can also smelt 1 &lNethersteel Scrap&r into 2-3 &l Soulforged Nethersteel Nuggets&r, without having to use any &lGold&r as well as less &lSoul Urns&r."
		""
		"To build the &lIndustrial Smelter&r, you will need a minimum of:"
		""
		"&lReinforced Deepslate&r x 17"
		"&lTinted Glass&r x 4"
		"&lBlast Furnace&r x 1"
		"&lObsidian Lava Bucket&r x 9"
		""
		"{image:btoimages:textures/quests/is1.png width:201 height:202 align:center}"
		"{@pagebreak}"
		"Place &lLava&r in the &lTank&r of the &lIndustrial Smelter&r in order to fuel it. 1 &lLava Bucket&r will last &l3 Minutes&r of smelting time."
		""
		"{image:btoimages:textures/quests/is2.png width:183 height:188 align:center}"
		"{@pagebreak}"
		"If you are smelting &lNethersteel Scrap&r into &lSoulforged Nethersteel Nuggets&r, you must first &lInfuse&r the &lTank&r with &lSouls&r by throwing 1 &lSoul Urn&r into the &lLava&r."
		"The &lInfusion&r will last 1 smelt, after which - the &lLava&r will revert back to its normal state."
		""
		"&lInfusing&r the smelter will also double the smelting speed of all other &lOres&r. Be aware - &lSoul Lava / Fire&r will cause &lPossession&r, so build the smelter a good distance from your base or place a &lSoul Catcher&r nearby"
		""
		"You can load multiple &lSoul Urns&r into the &lTank&r but be careful not to throw too many inside or there will be &4&l&oconsequences...&r&r&r"
		""
		"{image:btoimages:textures/quests/is4.png width:213 height:205 align:center}"
		"{@pagebreak}"
		"You can expand the tank infinitly in order to fit more lava inside."
		"You can also place up to 12 &lBlast Furnaces&r around the &lTank&r, allowing the smelting of 12 items at once."
		""
		"{image:btoimages:textures/quests/is3.png width:168 height:192 align:center}"
	]
	quest.55137322EC7C3675.title: "Industrial Smelting"
	quest.5888A21A33556976.quest_desc: [
		"Plant a &lHemp Seed&r in tilled land and wait for it to grow. Wait for the plant to grow 2 blocks tall before harvesting so that the bottom half stays in tact after haarvesting. To avoid destroying the whole plant - Harvest top half using &lShears&r. &lGrind&r the &lHemp&r in a &lMillstone&r to produce &lHemp Fiber&r. "
		""
		"&4&lBeware&r:&r &lWeeds&r will grow over plants in the night time and have to be removed by right clicking the plants each morning - otherwise the plant will be fully taken over and destroyed"
	]
	quest.5888A21A33556976.title: "420BlazeIt"
	quest.5937A96C0F4D0A8F.quest_desc: [
		"&lIron Ingots&r (or a &lCistern&r), &lBone&r and a &lWater Bucket&r make a &lCauldron&r - a multi-food cooker that also enables several crafting processes and doubles as passive item storage for anything thrown into it."
		""
		"{image:btoimages:textures/quests/cauldron_setup.png width:200 height:200 align:center}"
	]
	quest.5937A96C0F4D0A8F.title: "Build a Cauldron"
	quest.5C9AF8F77C6D4089.quest_desc: ["Breed cows with wheat and thin the herd for Leather. Breed wolves with raw meat, then sit a group of about 10 down and feed them to collect Dung."]
	quest.5C9AF8F77C6D4089.title: "Farm Leather and Dung"
	quest.5F0D4EB42A8A2EC2.quest_desc: [
		"In order to get&l Phantom Membranes&r - you must throw a &lSoul Urn&r at a &lFull Moon&r to summon &lPhantoms&r for that night. "
		""
		"Craft the &lPhantom Membranes&r into &lMembrane Gel&r and dip your &lArmour&r into a gell filled &lCistern&r to get a temporary reduction in Hunger Drain and Weight."
	]
	quest.5F0D4EB42A8A2EC2.title: "Fitted Gear"
	quest.5F3C4447B904F39F.quest_desc: [
		"16 &lBricks&r make 4 &lBrick Slabs&r, and 4 &lBrick Slabs&r make a &lBrick Oven&r. Ovens are the first way to smelt all your ores and cook your food a lot faster."
		"More ovens means faster iron smelting later, so don't be shy about making a few."
	]
	quest.5F3C4447B904F39F.title: "Let Them Cook!"
	quest.5F6BA53663CA53BD.quest_desc: [
		"&lBeacons&r require the same material throughout the pyramid. The pyramid material determines the &lBeacon Effect&r, and additional tiers increase the range and strength of the effects. Some &lBeacon Types&r may also cause side effects to occur while a beacon is active."
		""
		"&lBeacons&r are the &lONLY&r way to set your &lSpawnpoint&r. Depending one which block you choose for the base and how big the base is - will determain the type, range and strength of the effects."
		""
		"You will need &lBlocks of Soulforged Nethersteel&r as your base in order to set your &lSpawnpoint&r. You will need a &lTier 3 Beacon&r in order to get &lUnlimited Range&r across the same dimension as the beacon (Tier 4 across all dimensions)"
		""
		""
		""
		"                 &n&lBEACONS ->&r&r"
		""
		"{@pagebreak}"
		""
		""
		"&4&lConcentrated Hellfire:&r&r"
		""
		"* Fire Resistance"
		"* Sets the pyramid on fire"
		""
		"Range per Beacon Layer:"
		""
		"* 20 / 40 / 80 / 160"
		""
		"{@pagebreak}"
		""
		"&b&lBlock of Diamond:&r&r"
		""
		"* Fortune II on ores mined in range"
		""
		"Range per Beacon Layer:"
		""
		"* 20 / 40 / 80 / 160"
		""
		"{@pagebreak}"
		""
		"&a&lBlock of Emerald:&r&r"
		""
		"* Looting II on mobs that die in range, however they died"
		""
		"Range per Beacon Layer:"
		""
		"* 20 / 40 / 80 / 160"
		""
		"{@pagebreak}"
		""
		"&#784601&lBlock of Dung:&r&r"
		""
		"* Poison + Nausea"
		"* Full Nethersteel armour is immune"
		""
		"Range per Beacon Layer:"
		""
		"* 20 / 40 / 80 / 160"
		""
		"{@pagebreak}"
		""
		"&e&lGlowstone:&r&r"
		""
		"* Night Vision"
		""
		"Range per Beacon Layer:"
		""
		"* 20 / 40 / 80 / 160"
		""
		"{@pagebreak}"
		""
		"&#FFCB03&lBlock of Gold:&r&r"
		""
		"* Haste"
		""
		"Range per Beacon Layer:"
		""
		"* 20 / 40 / 80 / 160"
		""
		"{@pagebreak}"
		""
		"&7&lBlock of Iron:&r&r"
		""
		"* Right-click with a Compass to bind it to the beacon"
		"* Any beacon can do this, Iron just reaches further"
		""
		"Range per Beacon Layer:"
		""
		"* 20 / 80 / 320 / Current Dimension"
		""
		"{@pagebreak}"
		""
		"&1&lBlock of Lapis Lazuli:&r&r"
		""
		"* Shows mob-spawnable dark spots"
		"* Shows the spawn chunks near world spawn"
		""
		"Range per Beacon Layer:"
		""
		"* 20 / 40 / 80 / 160"
		""
		"{@pagebreak}"
		""
		"&#760127&lBlock of Spider Eyes:&r&r"
		""
		"* ???"
		""
		"Range per Beacon Layer:"
		""
		"* 20 / 40 / 80 / 160"
		""
		"{@pagebreak}"
		""
		"&d&lCompanion Cube:&r&r"
		""
		"* ???"
		""
		"Range per Beacon Layer:"
		""
		"* 20 / 40 / 80 / 160"
		""
		"{@pagebreak}"
		""
		"&#BCEAFF&lGlass:&r&r"
		""
		"* No effect"
		"* The only beacon a Compass cannot bind to"
		""
		"{@pagebreak}"
		""
		"&#022738&lEnder Block:&r&r"
		""
		"* Ender Chest placed on the pyramid joins a shared network"
		"* Layer 1: public, this dimension"
		"* Layer 2: second public, this dimension"
		"* Layer 3: public, all dimensions"
		"* Layer 4: private to you, all dimensions"
		"* Increases Enderman spawns (Endermites in the End)"
		""
		"Range per Beacon Layer:"
		""
		"* 20 / 40 / 80 / 160"
		""
		"{@pagebreak}"
		""
		"&#140800&lSoulforged Nethersteel:&r&r"
		""
		"* Sets Spawnpoint"
		"* Spreads Blight through nearby grass"
		""
		"Range per Beacon Layer:"
		""
		"* 40 / 160 / Current Dimension / All Dimensions"
	]
	quest.5F6BA53663CA53BD.title: "Finally Setting a Spawnpoint"
	quest.5F966E27A62D9CDF.quest_desc: [
		"Use a &lTurntable&r to spin a &lClay Block&r into &lUnfired Planters&r and fire them in a &lKiln&r. Fill one with &lDirt&r - and crops planted in it grow completely &lWeed-Free&r. "
		""
		"&lPlanters&r still require a water source like regular farmland."
	]
	quest.5F966E27A62D9CDF.title: "Weed Free Crops!"
	quest.60B6F34FF85D82D2.quest_desc: [
		"Craft a &lHibachi&r - This can be used to create a &lStoked Flame&r for different &lCauldron&r, &lCrucible&r and &lKiln &rrecipes. "
		""
		"A maximum of 9 &lHibachis&r under any of these will speed up the cooking process"
	]
	quest.60B6F34FF85D82D2.title: "Let Them Cook 2!"
	quest.60E8793FF8E28C80.quest_desc: ["Gather some &lPiles of Soulsand&r and right click the in them &lNether&r and follow the lost souls in order to help yourself find a &lNether Fortress&r."]
	quest.60E8793FF8E28C80.title: "Follow the Lost Souls"
	quest.6134B8653B330A1A.quest_desc: [
		"Enchanting has completely changed. You can no longer gain powerful enchants from the vanilla Enchanting Table and the xp level in the table is capped at 15xp. "
		""
		"The only enchants avaliable in the vanilla table are: "
		""
		"&lFire Protection&r"
		"&lBlast Protection&r"
		"&lProjectile Protection&r"
		"&lRespiration&r"
		"&lAqua Affinity&r"
		"&lThorns&r"
		"&lSmite&r"
		"&lBane of Arthropods &r"
		"&lKnockback&r"
		"&lFire Aspect&r"
		"&lEfficiency&r"
		"&lUnbreaking&r"
		""
		"&lInfernal Enchanters&r require 30 &lBookshelves&r for max level."
		""
		"Place an &lArcane Scroll&r + an &lEnchantable Item&r and pick the level you want."
		""
		""
		"{image:btoimages:textures/quests/infernal_enchanter.png width:253 height:180 align:center}"
	]
	quest.6134B8653B330A1A.title: "Thaumatology"
	quest.62E1D573E5B6E369.quest_desc: [
		"Find a hole to bunker up in, start your fire, &lKnit&r / &lExtract Sinew&r while you wait for your food to cook. Good luck on your first night..."
		""
		"You will have to constantly feed the fire using any &lFlammable Item&r (sawdust, feathers, plants, wool etc)"
		""
		"{image:btoimages:textures/quests/campfire_stages_new.png width:188 height:114 align:center}"
	]
	quest.62E1D573E5B6E369.title: "Survive The Night"
	quest.63DF416758DB4DF7.quest_desc: [
		"Now that you have defeated the &lWither&r, you can now work your way to crafting an &lElectric Motor&r."
		""
		"&lElectric Motors&r allow you to easily toggle &lMechanical Power&r off and on as well as place them in much tighter spaces as apposed to &lWindmills&r and &lWater Wheels&r."
		""
		"You can also feed an &lElectric Motor&r using a &lHopper&r filled with &lCharged Batteries&r"
		""
		""
		"{image:btoimages:textures/quests/motor.png width:220 height:270 align:center}"
	]
	quest.63DF416758DB4DF7.title: "Convenient Power"
	quest.643C1AA7A7996AF0.quest_desc: ["A &lMillstone&r will allow you to grind / mill many ingredients in order to make other ingredients. Placing a &lHand Crank&r next to the &lMillstone&r is the first way to power it."]
	quest.643C1AA7A7996AF0.title: "On The Grind"
	quest.65DA9D3F91DCBF2E.quest_desc: ["Smelt 4 &lChunks of Raw Iron&r in an &lOven&r to get 4 &lIron Nuggets&r. You can only smelt or cook 1 item at a time in an &lOven&r (and it takes a LONG time) - so it is a good idea to have multiple &lOvens&r in order to speed this process up."]
	quest.668EE27B4EEBCCFE.quest_desc: [
		"&lFishing&r is an excellent activity to pass the night if you have not secured enough food by hunting. Fishing has been completely ovehauled - as fish now are attracted to the hook depending on multiple factors:"
		""
		"&lFishing Rods&r now must be &lBaited&r via right clicking the rod and having either: &lRotten Flesh, Bat Wings, Creeper Oysters, Spider Eyes&r or &lWitch Wart&r in your &lHotbar&r. &lBait&r will be consumed from left to right"
		" "
		"             &n&lFISHING INFO ->&r&r"
		""
		"{@pagebreak}"
		""
		"&c&lCondition&r&r "
		"&l&eCatch Rate&r&r "
		"&l&aAverage result&r&r"
		""
		"&c&lBasic Rate (day, no rain)&r&r - &e1x&r - ~&a1 or 2 fish per day&r"
		""
		"&c&lNight (except during full moon)&r&r - &e4x slower than day&r - &aYou're lucky if you get 1 fish per night&r"
		""
		"&c&lRain&r&r - &e2x faster than day&r - &a~ 3 fish per rainy day&r"
		""
		"&c&lDusk and Dawn&r&r - &e2x faster than day&r - ~ &a0 and 1 fish during the 90s of dawn/dusk&r"
		""
		"&c&lFull Moon&r&r - &e8x faster than day (maximum speed, does not stack with rain)&r - &aBetween 16 and 32 fish per full moon night&r"
		""
		"&c&lRain during Dawn and Dusk&r&r - &e4x faster than day (half the Full Moon rate)&r - &a~ 1 or 2 fish during the 90s of dawn/dusk&r"
		""
		"&c&lRain during Night&r&r - &e2x slower than day&r - &a~ 0 or 1 fish per night&r"
	]
	quest.668EE27B4EEBCCFE.title: "Teach a Man to Fish"
	quest.688695F606C7EAAA.quest_desc: ["A &lStone Pickaxe&r will allow you to break stone much faster as well as get &lChunks&r instead of &lDust&r from &lOres&r. You will also be able to mine the &lTuff Ores&r but not full break the block."]
	quest.688695F606C7EAAA.title: "Craft a Stone Pickaxe"
	quest.6B886375D9A1B104.quest_desc: [
		"Before nightfall, gather enough &lShafts&r: 4 for a &lCampfire&r, 1 to place ontop of the &lCampfire&r, 2 for a &lFire Plough&r - 7 minimum."
		"Grab 2 more (9 total) if you also want a &lWood Club&r for fighting off or harvesting mobs."
		""
		"The &lFire Plough&r is very taxing on hunger and requires you to hold right click (or spam click) on a &lCampfire&r until it is lit."
		""
		"&l&4WARNING:&r&r &lCampfires&r will make any &lFlameable Block&r catch fire within the radius shown below"
		""
		"&l&bTip&r&r: &lCampfires&r will light other campfires within a 1 block range (even diagonally)"
		""
		"{image:btoimages:textures/quests/fire_spread.png width:181 height:217 align:center}"
	]
	quest.6B886375D9A1B104.title: "Stock Up On Shafts"
	quest.6EC1207506473680.quest_desc: ["A &lSoul Catcher&r will absorb all &lPossession&r within a large range - allowing you to &lSoul Sift&r, have a &lNether Portal&r and &lSoul Lava / Fire&r near your base without the risk of Possession."]
	quest.6EC1207506473680.title: "Exorcism"
	quest.6FDCEAC53B15B337.quest_desc: ["Travel to the &lNether&r to obtain &lNetherrack&r and &lSoul Sand&r"]
	quest.6FDCEAC53B15B337.title: "The Nether"
	quest.70281FEFF24679D2.quest_desc: ["Make an &lIron Chisel&r using your 4 &lIron Nuggets&r. Now, You can finally make a &lCrafting Table&r! Approach a &lTree Stump&r and mine it using the &lIron Chisel&r. Keep doing this until it turns into a &lCrafting Table&r."]
	quest.70281FEFF24679D2.title: "Finally... a Crafting Table"
	quest.702BBBC59EAC0215.quest_desc: ["Place &lClay Balls&r into crafting grid to make &lWet Bricks&r. Dry &lWet Bricks&r by placing them outside and exposed to the &lSun&r. They will take 1 full in game day to dry but beware - anything or anyone that steps on the &lWet Bricks&r, will &lTrample&r them. And you will have to &lrestart the process all over again&r. &lRain&r will also reset the progress - nothing can be done about this until later in the game"]
	quest.702BBBC59EAC0215.title: "Bricks"
	quest.73254073A2388627.quest_desc: [
		"&lTrading&r is has been completely overhauld - you now must trade for many required items to beat the game. &lVillagers&r now have specific trades that give the Villager xp - do enough of these and you will be prompted with a unique &l\"Level Up Trade\"&r to progress to the next level of xp giving trades."
		""
		"&lTips:&r "
		""
		"You can now trade for &lWither Skeleton Skulls&r."
		""
		"&lBrewing Stands&r can no longer be crafted and are only found in &lWitch Huts&r"
		""
		"&lEnchanting Tables&r can no longer be crafted and are only found in &lDesert Temples&r"
		""
		"&lThe Vessel Of The Dragon&r can only be found in &lJungle Temples&r"
	]
	quest.73254073A2388627.title: "Let The Real Grind Begin..."
	quest.75BD7DF5949BBF53.quest_desc: [
		"An &lEye of Ender&r no longer leads you to the &lStronghold&r (right click at your own risk). You will have to trade with a &lCartographer&r and collect all the maps to craft a &lStronghold Explorer Map&r in order to locate the Stronghold. "
		""
		"{image:btoimages:textures/quests/stronghold_map.png width:200 height:200 align:center}"
		""
		"&lThe Mace&r, &lTotem of Undying&r and &lTrident&r have all been overhauled and are much stronger and or have extra uses."
		""
		"A &lMace&r mines a 3x3x1 grid and can mine all Strata Layers. They also have a 100% drop rate from Ominous Vaults"
		""
		"A &lTotem&r now has 2 uses instead of 1 (Evokers no longer spawn in Raids)"
		""
		"A &lBroken Trident&r is now found in the &lOcean Monument&r and needs to be fixed by having lightning strike it. They have also been buffed heavily when held and will give the player a new effect: &b&lPosidein's Spirit&r&r - 2x breath underwater, can swim with any Armour on and swimming no longer drains hunger"
		""
		"A &lRecovery Compass&r will now respawn with you after dying - for the next 5 deaths."
	]
	quest.75BD7DF5949BBF53.title: "Explore the World!"
	quest.76BD69997D579075.quest_desc: [
		"Obtain &lDung&r from &lWolves&r (wild or tamed). They will drop Dung shortly after eating."
		""
		"You can also obtain &lDung&r from &lSniffers&r after they eat enough &lWeeds&r."
	]
	quest.76BD69997D579075.title: "Ew"
	quest.77AA0F22D849F2D3.title: "Completed \"Age of Pottery\""
	quest.77E6990BA152D6FC.title: "Complete \"Age of Iron\""
	quest.7C1B0D2EA84B7947.quest_desc: ["Knitting is essential for skipping the night - as it allows you to make &lWool Knit&r in order to craft a &lBedroll&r"]
	quest.7C1B0D2EA84B7947.title: "Knitting"
	quest.7D32CE8A14B7ECED.title: "Completed \"Age of Wood\""
	quest.7DB2AB9CE32417D6.quest_desc: [
		"Punching a tree no longer gives a full log - only a &lShaft&r (stick), &lBark&r and &lSaw Dust&r."
		"You only need one Shaft to make a &lWooden Chisel&r, so you can get moving quickly."
	]
	quest.7DB2AB9CE32417D6.title: "Punch Trees For Shafts"
	quest.80945725B6DBA27E.quest_desc: ["Start making more advanced food recipes in the Cauldron, combining ingredients to multiply their efficiency - a Donut, for example, stretches simple ingredients much further than eating them raw."]
	quest.80945725B6DBA27E.title: "Make Advanced Food in the Cauldron"
	quest.844411163ADA76A5.quest_desc: [
		"Soulforged Steel is this pack's netherite tier - the final tool and armor tier, stronger than diamond, and the last upgrade your gear will need."
		"Forge Armor Plates in your Soulforge from Straps, Padding and Netherite Ingots, then work them into a full set of tools and armor."
	]
	quest.844411163ADA76A5.title: "Create Tools and Armor Made of Steel"
	quest.90A5D566EE4835D1.quest_desc: ["Wooden Sidings, Gears, a Belt and Tanned Leather (or Cut Tanned Leather) combine into a Bellows - the last piece you need before building a kiln."]
	quest.90A5D566EE4835D1.title: "Build a Bellows"
	quest.91D98AD079DEFB19.quest_desc: ["Once your tech tree and gear are in good shape, it's time to take on the Wither."]
	quest.91D98AD079DEFB19.title: "Prepare For and Defeat the Wither"
	quest.9202AB6CA76591BE.quest_desc: ["Capture souls from the nether in Soul Urns using a Hopper."]
	quest.9202AB6CA76591BE.title: "Capture Souls From the Nether in Soul Urns Using a Hopper"
	quest.92467F28303BB3B0.quest_desc: ["Craft a diamond Pickaxe and use it to mine Obsidian."]
	quest.92467F28303BB3B0.title: "Craft a Diamond Pickaxe and Use It to Mine Obsidian"
	quest.9604FD284CBBA13C.quest_desc: ["Use a Chisel to get stone bricks."]
	quest.9604FD284CBBA13C.title: "Use a Chisel to Get Stone Bricks"
	quest.97BAC56B9B3362F3.quest_desc: [
		"Craft a Campfire and a Fire Plough to light it. A medium flame is what actually cooks food - low/high flame don't reset cooking progress, but letting it die to embers does."
		"Dig a small hole you can block the entrance to while still letting light in. Don't worry about it looking nice - just survive."
	]
	quest.97BAC56B9B3362F3.title: "Build a Campfire and a Shelter"
	quest.97C724581BD52582.quest_desc: [
		"Wait for nearby skeletons and zombies to burn up in sunlight before you tear down your barricade and head out."
		"Watch out the moment you step outside - creepers love to ambush players right at their own front door."
	]
	quest.97C724581BD52582.title: "Let the Sun Clear the Undead"
	quest.9A255EE8BCD0211F.quest_desc: [
		"With your early automation in place, start building a mob trap and trading with villagers to push further into the tech tree."
		"Repeated trading levels up a villager's profession, unlocking better trades and eventually rarer, higher-tier items - keep an Emerald from a trade as proof you've started."
	]
	quest.9A255EE8BCD0211F.title: "Build a Mob Trap and Trade With Villagers"
	quest.9FAB663C3D2A3AEA.quest_desc: [
		"Hostile mobs don't spawn immediately and take a while to reach you, so don't panic if dusk catches you unprepared."
		"Be extra careful near wolves, swamps or jungles - starved wolves, jungle spiders and small slimes can all reach you through a single one-block gap."
	]
	quest.9FAB663C3D2A3AEA.title: "Survive the First Night"
	quest.A5870DB48C75DF01.quest_desc: [
		"Run Leather through your Mill to get Scoured Leather, then combine it with Dung and tree bark in a Cauldron for Tanned Leather."
		"Tanned Leather is a core ingredient for most of what comes next, so keep some leather and hemp processing going in the background."
	]
	quest.A5870DB48C75DF01.title: "Make Tanned Leather"
	quest.A5E3B2BA6B5ABB9A.quest_desc: [
		"Crafting an Iron Axe unlocks mechanical power. Chiseling stone yields Stone Brick plus loose stone - use them with a Gear to build a Hand Crank and Mill Stone."
		"The hand crank burns through hunger fast, so treat it as a bridge to real automation, not a long-term solution."
	]
	quest.A5E3B2BA6B5ABB9A.title: "Build a Hand Crank and Mill Stone"
	quest.A60525B23A464AEE.quest_desc: ["You've made it through every Age, from a Shaft punched off a tree to Soulforged Steel. From here on, the world is yours - now that you've conquered death itself."]
	quest.A60525B23A464AEE.title: "Thrive and Conquer the World"
	quest.A84A67090F032017.quest_desc: [
		"If food is tight, a Fishing Rod or Bow Drill can help - fishing turns undesirable mob drops into food, and a bow drill lights fires using less hunger than a Fire Plough."
		"Neither can be placed down, so keep a Bark Box handy if you want to avoid losing them on death."
	]
	quest.A84A67090F032017.title: "Set Up a Backup Food Source"
	quest.AAB0F6BB03D8B9DA.quest_desc: ["Place Unfired Pottery in your Kiln and wait for it to fire. A Crucible is the first piece of more advanced material processing you'll need going forward."]
	quest.AAB0F6BB03D8B9DA.title: "Fire a Crucible"
	quest.AE97FF2FCA4CD960.quest_desc: ["Cut your Tanned Leather into a Strap with Shears, turn the strap into a Belt, then combine the belt with Gears and an Iron Ingot for a Saw."]
	quest.AE97FF2FCA4CD960.title: "Make a Strap, Belt, and Saw"
	quest.AECFA5C9F8E0255C.quest_desc: ["Cut your Tanned Leather into a Strap with Shears, turn the strap into a Belt, then combine the belt with Gears and an Iron Ingot for a Saw."]
	quest.AECFA5C9F8E0255C.title: "Make a Strap, Belt, and Saw"
	quest.AEFBE1BCA0C08D3C.quest_desc: ["Craft a Pointy Stick from a Shaft, then use it to dig up a Loose Stone."]
	quest.AEFBE1BCA0C08D3C.title: "Make a Pointy Stick, Then Loose Stone"
	quest.AF64E8CAC3008056.quest_desc: [
		"Between your Stone Axe, a Stone Shovel and a Stone Hoe you can handle most early gathering."
		"The Stone Pickaxe needs more grid space than your 2x2 crafting square allows - it stays locked until you have a proper Crafting Table."
	]
	quest.AF64E8CAC3008056.title: "Craft a Stone Shovel and Stone Hoe"
	quest.B0161D6452EBC082.quest_desc: [
		"4 Iron Nuggets make an Iron Chisel. Use it twice on a Stump to finally get a real Crafting Table."
		"Keep collecting clay for more ovens - with 9 going at once you can smelt a full Iron Ingot's worth of nuggets in a single night."
	]
	quest.B0161D6452EBC082.title: "Craft a Chisel and a Crafting Table"
	quest.B2A0DC2839CE7B3A.quest_desc: [
		"Grind 216 Netherrack in your Mill into Ground Netherrack, then run it over a hopper filtering Soul Sand to get Hellfire Dust."
		"Always run mechanical power to that hopper's filter side - an unpowered filter overloads on the (invisible) souls it's catching and explodes, spawning something unfriendly."
	]
	quest.B2A0DC2839CE7B3A.title: "Process Netherrack Into Hellfire Dust"
	quest.B4C50D6D4EAFAD68.quest_desc: ["Expand automation with the tech unlocked by the Soulforge."]
	quest.B4C50D6D4EAFAD68.title: "Expand Automation With the Tech Unlocked by the Soulforge"
	quest.B600A914E333F4B3.quest_desc: ["Repeated trading levels up a villager's profession, unlocking better trades and eventually rarer, higher-tier items."]
	quest.B600A914E333F4B3.title: "Trade With Villagers to Level Them Up"
	quest.B630763BCFED0BA3.quest_desc: ["Sugarcane makes Baskets, your first real one-stack storage solution."]
	quest.B630763BCFED0BA3.title: "Farm Sugarcane for Baskets"
	quest.B676A622F52DB02E.quest_desc: [
		"A Diamond Pickaxe is the last pickaxe tier before Netherite, and the only tool that can mine Obsidian."
		"Mining Obsidian is the final requirement of the Age of Iron - it's what makes a Nether Portal possible."
	]
	quest.B676A622F52DB02E.title: "Craft a Diamond Pickaxe and Mine Obsidian"
	quest.B93333AB39295757.quest_desc: ["The final milestone of the Era of Domination: defeat the Ender Dragon."]
	quest.B93333AB39295757.title: "Defeat the Ender Dragon"
	quest.BC1C0D9F5A8637FC.quest_desc: [
		"Build a Nether Portal with your fresh supply of Obsidian and step through for the first time."
		"Netherrack and Soul Sand are both common there - grab plenty of each, along with any Glowstone you find."
	]
	quest.BC1C0D9F5A8637FC.title: "Travel to the Nether"
	quest.BC54A42E8C26D566.quest_desc: ["Kibble lets you tame and lead wild animals back to your base instead of just hunting them where they stand."]
	quest.BC54A42E8C26D566.title: "Find and Capture Animals"
	quest.BDC93787DF265C20.title: "Completed \"Age of Commerce\""
	quest.C007E9F0A2864B6F.title: "Completed \"Era of Domination\""
	quest.C4D9B44623076506.quest_desc: ["With your early automation in place, start building a mob trap and trading with villagers to push further into the tech tree."]
	quest.C4D9B44623076506.title: "Build a Mob Trap and Trade"
	quest.C78319B8EBA44F5C.quest_desc: [
		"Find and mine at least 8 Iron Ore blocks, then craft them into Chunks of Iron Ore."
		"Place the chunks in a Brick Oven, keep it fully stocked and lit, and store the resulting Iron Nuggets in a basket."
	]
	quest.C78319B8EBA44F5C.title: "Mine and Smelt Iron"
	quest.CA87DEFDB4686FC5.quest_desc: ["Villagers will request specific goods as you trade with them - set up automated farms and small factories to keep a steady supply flowing without babysitting them yourself."]
	quest.CA87DEFDB4686FC5.title: "Automate Farms and Factories for Villager Requests"
	quest.CBB970B069879F37.quest_desc: [
		"Arrange your Hibachis in a 3x3 with 9 redstone torches beneath them, then stack at least 4 brick blocks one space above as the kiln body."
		"Place the Bellows against the center, facing the fire, and alternate mechanical power to it (a turntable with a redstone torch on top works well) so it expands and contracts."
		"Place unfired pottery in the kiln's center and wait. To move on, fire 7 Urns and 1 Crucible."
	]
	quest.CBB970B069879F37.title: "Build a Kiln and Fire Your Pottery"
	quest.CEE712B840FCC876.quest_desc: ["Wooden Siding, Stone Brick, a Clock and a Gear make a Turntable. Powered turntables slowly spin a Clay Block placed on top into Unfired Pottery - right-click empty-handed to change its speed."]
	quest.CEE712B840FCC876.title: "Build a Turntable and Shape Pottery"
	quest.CF92008EEFBB68D7.quest_desc: [
		"Fire several Urns in your Kiln, then place them in the Nether - soul sand valleys are rich with wandering souls. Each Urn silently catches 8 of them over time and turns into a Soul Urn."
		"A Hopper positioned to collect the finished Urns automates the whole process."
	]
	quest.CF92008EEFBB68D7.title: "Fire Urns and Capture Souls"
	quest.D008BD8A195512B9.quest_desc: [
		"Run Leather through your Mill to get Scoured Leather, then combine it with Dung and tree bark in a Cauldron for Tanned Leather."
		"Tanned Leather is a core ingredient for most of what comes next, so keep some leather and hemp processing going in the background."
	]
	quest.D008BD8A195512B9.title: "Make Tanned Leather"
	quest.D049451A2C0ECE83.quest_desc: ["Build a Beacon atop a pyramid of Soulforged Steel to anchor your spawn location - death finally loses its sting."]
	quest.D049451A2C0ECE83.title: "Create a Steel Beacon to Anchor Your Spawn"
	quest.D19B0F45B7857789.quest_desc: ["Trade with a max-level Librarian villager for Oculars of Ender - BTW's replacement for the vanilla Eye of Ender, needed to locate and open a Stronghold's End Portal."]
	quest.D19B0F45B7857789.title: "Obtain Oculars of Ender From a Max-Level Librarian"
	quest.D335770A6322CA61.quest_desc: ["Delve deeper into caves and mine for Diamonds."]
	quest.D335770A6322CA61.title: "Delve Deeper Into Caves and Mine for Diamonds"
	quest.DB8B921F0CDA3417.quest_desc: ["Obtain several eyes of ender from a max level librarian."]
	quest.DB8B921F0CDA3417.title: "Obtain Several Eyes of Ender From a Max-Level Librarian"
	quest.DB93D54B24FB5C05.quest_desc: ["Wooden Sidings, Gears, a Belt and Tanned Leather (or Cut Tanned Leather) combine into a Bellows - the last piece you need before building a kiln."]
	quest.DB93D54B24FB5C05.title: "Build a Bellows"
	quest.DFF7B7D3FFF24461.quest_desc: [
		"This quest book is a simplified, in-order walkthrough of the official Beginner's Guide wiki page, broken into bite-sized checkpoints."
		"Checking off a quest never gives you items - this book is purely a guide and progress tracker, nothing more."
		"BTW CE also has a built-in recipe viewer (EMI). Click an item in the list on the right of your inventory to see how to make it. Press CTRL+O if it's hidden."
	]
	quest.DFF7B7D3FFF24461.title: "Read Me First"
	quest.E0385A31ADF503B3.quest_desc: [
		"Spiders shoot webs at chickens from a distance, so cobwebs often turn up near them. Use a Sharp Stone on a Cobweb to get String."
		"Sometimes a spider's shot misses and leaves a Tangled Web instead - untangle it with String and a Sharp Stone to get Shears plus more String."
	]
	quest.E0385A31ADF503B3.title: "Harvest Cobwebs for String"
	quest.E284FEF6B47731B9.title: "Completed \"Age of Flame\""
	quest.E36DC4B9BD26CB59.quest_desc: [
		"Your Pile of Soul Sand is more than crafting scrap - use (right-click) it in the Nether and its particles stream toward the nearest Nether Fortress, your personal fortress compass."
		"Used inside a fortress, it instead outlines the mob spawning area with orange and red particles. Fortresses are the only source of Blaze Rods - they're essential further down the tech tree, so grab a good stock while you're there."
	]
	quest.E36DC4B9BD26CB59.title: "Use Soul Sand Piles to Find a Nether Fortress and Collect Blaze Rods"
	quest.E3B6056871EE87D3.quest_desc: ["With Wither-tier resources in hand, construct Beacons to expand your capabilities around your base."]
	quest.E3B6056871EE87D3.title: "Construct Beacons"
	quest.E6ADBA03B38156BC.quest_desc: [
		"Cobwebs are your main early string source. Undead drops (rotten flesh, bone) make fishing bait and bone fishing hooks/clubs."
		"Learn to pop creepers safely for their dirt, gather wood by day and stone by night, and keep an oven's worth of clay and iron coming in as you explore."
		"A Chisel lets you turn a Stump into a Crafting Table for 3x3 recipes. Wood floors (including logs) block mob spawns entirely, even outdoors."
		"Avoid open water at night, avoid spooking cows, and remember that raw ores, clay and bricks can all be placed on the ground as free extra storage."
	]
	quest.E6ADBA03B38156BC.title: "Learn the General Survival Tips"
	quest.E8944CEED404BD81.quest_desc: [
		"Use a Hoe on grass for a chance at Hemp Seeds (roughly 1 in 20 blocks). Gather around 8 to kick-start a farm, and consider bone meal to speed growth."
		"Mature hemp grows a second block on top - cut it with Shears and grind it in the Mill Stone for Hemp Fiber, which becomes Sails."
	]
	quest.E8944CEED404BD81.title: "Start a Hemp Farm"
	quest.E94B6720ACB02E5F.quest_desc: ["You'll want a productive wheat farm, at least 2 cows, at least 2 wolves, several netherrack (grab glowstone and soul sand too while you're there), 7 iron and a Water Bucket."]
	quest.E94B6720ACB02E5F.title: "Gather Cows, Wolves, and Netherrack"
	quest.ED30F82CCD6D2086.quest_desc: ["Make permanent Torches using Nether Coal."]
	quest.ED30F82CCD6D2086.title: "Make Permanent Torches Using Nether Coal"
	quest.EE356B3DB0BC7E31.quest_desc: [
		"Keep mining Iron Ore and smelting it into Iron Nuggets - you'll need a steady supply for iron tools, a Chisel upgrade, a Cauldron, a Saw, and everything else in this Age."
		"9 Iron Nuggets make a full Iron Ingot, which is what real iron tools are crafted from."
	]
	quest.EE356B3DB0BC7E31.title: "Continue Mining Iron"
	quest.F5C2DAC0ADE16244.quest_desc: [
		"Arrange your Hibachis in a 3x3 with 9 redstone torches beneath them, then stack at least 4 brick blocks one space above as the kiln body."
		"Place the Bellows against the center, facing the fire, and alternate mechanical power to it (a turntable with a redstone torch on top works well) so it expands and contracts, stoking the fire underneath into a proper Kiln."
	]
	quest.F5C2DAC0ADE16244.title: "Stoke a Kiln With Your Bellows and Hibachis"
	quest.F98179418639B4C9.quest_desc: ["A thrown Soul Urn can cure a Zombie Villager in place of the vanilla weakness-potion-and-golden-apple method - a good way to safely grow a village's population."]
	quest.F98179418639B4C9.title: "Cure Villagers Using Soul Urns"
	quest.F9D6B5758D1F4986.quest_desc: ["The final milestone of the Beginner's Guide: enter the End and take down the Ender Dragon."]
	quest.F9D6B5758D1F4986.title: "Enter the End and Defeat the Ender Dragon"
	quest.FA14DA7737AB01AE.quest_desc: [
		"With a stable base and a stock of torches, start pushing into deeper cave systems for gold, diamonds and redstone."
		"Hardcore Stratification makes digging straight down to diamond level with only an Iron Pickaxe impractical - look for existing cave systems or abandoned mineshafts instead."
	]
	quest.FA14DA7737AB01AE.title: "Delve Deeper for Diamonds"
	quest.FA4012C9A7B429E5.quest_desc: [
		"Hardcore Spawn: you spawn in a random large area, expanding as you progress. Beds no longer set spawn (they're locked behind tech); Sleeping Bags speed up early nights instead."
		"Every action - even standing still - makes you hungry, so avoid needless running and jumping. Animals don't respawn, need food, and can be hunted by hostile mobs."
		"Hostile mobs spawn on slabs/glass/half-blocks but never on wood, mushroom or mycelium blocks, and always drop their held tools/armor."
		"There are no wooden tools - stone is the first tier. Unequipped/primitive digging is slow, and health & food affect your movement, harvesting and attack power."
		"Stone is split into three strata layers needing progressively better tools. Complete darkness (gloom) will terrorize you to death, and the moon has an 8-day brightness cycle that affects mob spawns."
		"Mining dirt without an Iron Shovel loosens neighboring dirt into Loose Dirt, and you cannot place blocks while jumping."
	]
	quest.FA4012C9A7B429E5.title: "How This Differs From Vanilla"
	quest.FABA5E46D0342C4C.quest_desc: [
		"A max-level Cleric will trade 8 Emeralds plus a Wither Skeleton Skull for an Infused Wither Skull - the leveled-up trading you've been building toward."
		"You need three of them, so start hunting Wither Skeletons in the fortress and keep those Emeralds flowing."
	]
	quest.FABA5E46D0342C4C.title: "Obtain Three Infused Wither Skulls"
	quest.FD8C9838A5EEEE57.quest_desc: ["Wooden Siding, Stone Brick, a Clock and a Gear make a Turntable. Powered turntables slowly spin a Clay Block placed on top into Unfired Pottery - right-click empty-handed to change its speed."]
	quest.FD8C9838A5EEEE57.title: "Build a Turntable and Shape Pottery"
	quest.FFCA9850893129EC.quest_desc: ["Continue mining Iron to make iron tools."]
	quest.FFCA9850893129EC.title: "Continue Mining Iron to Make Iron Tools"
