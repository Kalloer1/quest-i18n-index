	chapter.E47B56F5EF9ECAE5.title: "Wood Processing and Automation"
	chapter.F23AE30BE96C0AF7.subtitle: "Bricks, torches, iron, a crafting table"
	chapter.F23AE30BE96C0AF7.title: "Priorities for the Next Few Days"
