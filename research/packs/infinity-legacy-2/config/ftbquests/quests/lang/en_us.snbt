	quest.7CE764054ECB1C45.quest_desc: [
		"It turns 1 Log into 6 Planks."
		""
		"The multiblock is completed by using the Engineer's Hammer on the central Iron Sheetmetal block."
	]
	quest.7CE764054ECB1C45.title: "Sawmill"
	quest.7CF76A542529A181.quest_desc: ["If you throw down Dark Matter, then throw down Corrupti Dust, it'll create a Black Hole. Feed it small entities like Arrows or Experience Orbs, and it'll produce Xpetrified Orbs."]
	quest.7CF7B02A6CB1FDE5.quest_desc: ["This mod adds 7 new containers that function as both storage, and backpacks and so much more."]
	quest.7D0CF81F7E703B71.quest_desc: [
		"Place in &9water&r and connect &epipes&r to this and to another &cmachine&r to move &9water&r into it, uses &bsteam&r and &ccoal&r as &epower&r."
		""
		"&lShift-Right&r click twice on the &etop&r with a pipe."
	]
	quest.7D26915C5E25FE03.quest_desc: ["A handheld diagnostic device for analyzing and configuring ME networks. Used to check connections, identify channel usage, and troubleshoot system components. Visually displays network links when right-clicking cables or devices."]
	quest.7D31A66C8F7B76F7.quest_desc: [
		"Infused with Neutron Star matter and spatial fluid in the DMA or QMF. Unlocks 1T crafting storages and higher-tier matter synthesis."
		""
		"&7Fun fact: A tesseract is a 4-dimensional hypercube. Just as a 3D cube is enclosed by 6 two dimensional square faces, a 4D tesseract is enclosed by 8 three dimensional cubic cells.&r"
	]
	quest.7D31A66C8F7B76F7.quest_subtitle: "4D Spatial Matrix"
	quest.7D31A66C8F7B76F7.title: "Tesseract Component Matrix"
	quest.7D38BC3DB3406F51.title: "Basics"
	quest.7D43016926E77150.quest_desc: ["&dMystical agriculture&r adds new &aagumentable&r &aarmor!&r Crafted with &dgems&r from this &ctier,&r and &aarmor&r from the &cprevious tier&r you can craft &epowerful sets&r!"]
	quest.7D4AFD1FFF1326A9.quest_desc: ["Placed inside &cmechanism machines&r, this will allow them to &brun quickly&r and &apermenatly&r &eno energy required&r."]
	quest.7D557A396FB12D0A.quest_desc: [
		"&2Nature's Compass&r is a utility item that allows you to search for a biome's location anywhere in the world and view information about it."
		""
		"&3Explorers Compass&r is an item that allows you to locate structures anywhere in the world."
		""
		"&eRight-Clicking&r with &o&bCompass&r in hand will open the selection &o&bGUI&r, from which you can search for a biome/structure or view information about it."
		""
		"&eShift+Right-Clicking&r will &nreset&r the compass's state."
	]
	quest.7D557A396FB12D0A.title: "The Compasses"
	quest.7D57A14810BC0CBE.quest_desc: [
		"He attacks you in proportion to your health."
		""
		"Also, there is a brand when you hit his sword attack"
		""
		"It melts your armor so lowers your Armor defenses"
		""
		"They use a lot of attacks"
		""
		"Prepare To Burn"
	]
	quest.7DC387FEC143DEA2.quest_desc: [
		"Don't forget to look into the Productive Bees questline:"
		""
		"[ { \"text\": \"Click Me\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"29EE878BC8D3A742\" } } ]"
	]
	quest.7DC387FEC143DEA2.quest_subtitle: "Make a beehive"
	quest.7DC387FEC143DEA2.title: "Productive Bees"
	quest.7DF32D9CD8B2CEDA.quest_desc: ["Dropped from the &cForsaken&r, use this in &6crafting&r the rest this cave has to offer."]
	quest.7DFF18CFEB0B8DBE.quest_desc: ["Different &ctiers&r of &aseeds&r need different &ctiers&r of &aessence&r and &6farmland,&r &dmake some&r&d!&r"]
	quest.7E07C5A6FA6B6B1F.quest_desc: [
		"Once you've built a fully functional &6Reprocessor&r, you can pump in &ePower&r, &9Water&r and &dCyanite&r to create &1Blutonium&r."
		""
		"This can be used as a fuel for your &2Reactor&r, and creates its own &o&3waste&r called &5Magentite&r."
	]
	quest.7E164982974B7C55.quest_desc: ["A single unit of pure &9neutron matter&r. Useless alone, but terrifying in numbers."]
	quest.7E17AB5A4492929E.quest_desc: [
		"Every Reactor uses &aUranium&r somewhere for fuel, right?"
		""
		"For starters, let's gather some &aUranium Ingots&r. We'll need to process these in an &9Enrichment Chamber&r to turn it into &eYellow Cake Uranium&r."
	]
	quest.7E17AB5A4492929E.quest_subtitle: "Of Course It Uses Uranium"
	quest.7E17AB5A4492929E.title: "&aUranium"
	quest.7E1CDBDA2BCE9744.quest_desc: ["The &4Death Generator&r harnesses the power of &aWither Skeleton Skulls&r and &dRotten Flesh&r to produce &cEnergy&r. By feeding it these dark materials, you can generate significant power, tapping into the essence of death itself."]
	quest.7E1CF8DB8C0724E1.quest_desc: ["This &cmachine&r is pretty much an &6auto-crafter&r, make your &nrecipe in the left&r, and place the &nresources in the right&r."]
	quest.7E200B1A028DF704.quest_desc: ["Absorbs any items and XP in the area."]
	quest.7E24CEBCAE1B0794.quest_desc: ["A mountain of chewy ammo. Don’t step on it barefoot. Or do. That’s how legends begin."]
	quest.7E30CB57EA769363.quest_desc: ["A&d powerful Spell book&r with some of this mods best stats."]
	quest.7E337ADD6A9E2516.quest_desc: [
		"The &bPlant Fertilizer&r automates the application of &afertilizer&r to crops."
		""
		"Place it near the farming area and provide it with &afertilizer&r and &dpower&r."
		""
		"It boosts crop growth rates, ensuring faster harvests."
	]
	quest.7E38ACDAC8ACD079.quest_desc: [
		"The &dME Storage Monitor&r is a simple way to see the current level of a specified item."
		""
		"There are several interactions to modify it:"
		""
		"&bRight-click&r with &aItem&r will &ndisplay&r the current stored amount of that item if not locked"
		""
		"&bRight-click&r with &7Empty Hand&r will reset the display if &nnot&r locked"
		""
		"&bShift+Right-click&r with &7Empty Hand&r will toggle the &nlock&r"
		""
		"&bRight-click&r with &eWrench&r will &nrotate&r the monitor if it is locked and on the ground or ceiling."
	]
	quest.7E4A95B6443F23BC.quest_desc: ["Now that we have completed the &d&oMekanism:&r &oPhase one&r, it's time to move towards making &dAntimatter Pellets&r and trying to build some &4Reactors&r."]
	quest.7E4A95B6443F23BC.quest_subtitle: "The Path to Reactors"
	quest.7E4A95B6443F23BC.title: "&dMekanism:&r Phase two"
	quest.7E5A1001A01B0001.quest_desc: [
		"The &eChronicle of Shadows&r is the official guidebook for all things Apotheosis."
		""
		"Crafted simply by combining a &fBook&r with a &6Gold Ingot&r in any crafting grid. Its pages update dynamically based on enabled modules."
	]
	quest.7E5A1001A01B0001.title: "Chronicle of Shadows"
	quest.7E5A1001A01B0002.quest_desc: [
		"&dGem Dust&r is the foundational material for all Sigils and socketing operations in Apotheosis."
		""
		"To obtain your first Gem Dust:"
		"1. Drop any Apothic Gem onto the ground (&eQ&r)."
		"2. Place an &8Anvil&r 2 blocks above the dropped gem and drop it so it crushes the gem on impact!"
		""
		"&eTip:&r Use lower purity gems (like Cracked) for making dust, and save high purity gems for socketing."
	]
	quest.7E5A1001A01B0002.title: "Crushing Gems: Gem Dust"
	quest.7E5A1001A01B0003.quest_desc: [
		"The &eGem Case&r provides dedicated, organized storage for your collection of Apothic Gems."
		""
		"Right-click it or open it from your inventory to store, sort, and manage all your gems in one place."
		""
		"Later on, you can upgrade it into th &5Gem Case of House Fabergé&r via Infusion Enchanting!"
	]
	quest.7E5A1001A01B0003.title: "Gem Storage: Gem Case"
	quest.7E5A1001A01B0004.quest_desc: [
		"The &4Sigil of Malice&r is a rare, esoteric sigil that unpredictably mutates an Affix item."
		""
		"High risk, high reward! Also used as a key ingredient in crafting the Summit Spawner Upgrade Rune."
	]
	quest.7E5A1001A01B0004.title: "Sigil of Malice"
	quest.7E5A1001A01B0005.quest_desc: [
		"The &6Sigil of Supremacy&r is the pinnacle of enchanting sigils."
		""
		"When applied, it overcharges every affix on an item to its theoretical maximum potential!"
	]
	quest.7E5A1001A01B0005.title: "Sigil of Supremacy"
	quest.7E5A1001A01B0006.quest_desc: [
		"Your journey begins! Open the World Tier menu by pressing &bCtrl + T&r."
		""
		"Equip your first Affix item to earn the in-game advancement and awaken &aWorld Tier: Haven&r."
	]
	quest.7E5A1001A01B0006.title: "World Tier: Haven"
	quest.7E5A1001A01B0007.quest_desc: [
		"Equip a full set of Common Affix gear to earn the advancement and unlock &6World Tier: Frontier&r (&bCtrl + T&r)."
		""
		"At this tier, &cApothic Invaders&r begin invading the world, heralded by status messages and vertical light beams descending from the heavens!"
	]
	quest.7E5A1001A01B0007.title: "World Tier: Frontier"
	quest.7E5A1001A01B0008.quest_desc: [
		"Equip a complete set of &bUncommon Affix gear&r (including weapon) and slay at least one &cApothic Invader&r to earn the advancement."
		""
		"Reaching &bAscent Tier&r substantially increases mob challenge and makes Rare loot much more frequent."
	]
	quest.7E5A1001A01B0008.title: "World Tier: Ascent"
	quest.7E5A1001A01B0009.quest_desc: [
		"Equip a complete set of &9Rare Affix gear&r and defeat the &8Wither&r to earn the advancement."
		""
		"Reaching &dSummit Tier&r unlocks common access to &dEpic rarity items&r with multi-effect affixes!"
	]
	quest.7E5A1001A01B0009.title: "World Tier: Summit"
	quest.7E5A1001A01B000A.quest_desc: [
		"Equip full &dEpic Affix gear&r and slay the &5Ender Dragon&r to earn the final advancement."
		""
		"&6Pinnacle Tier&r represents the ultimate challenge and unlocks regular drops of &6Mythic items&r and god-tier gems."
	]
	quest.7E5A1001A01B000A.title: "World Tier: Pinnacle"
	quest.7E5A1001A01B000B.quest_desc: [
		"The &5Gem Case of House Fabergé&r is the ultimate dimensional upgrade for your gem collection."
		""
		"&lHow to craft:&r"
		"Place a normal &eGem Case&r into an &dInfused Enchanting Table&r with:"
		"• &a100 Eterna&r"
		"• &c100% Quanta&r"
		"• &d45% to 50% Arcana&r"
		""
		"It stored gems and grants \"unlimited\" capacity along with cross dimensional gem access!"
	]
	quest.7E5A1001A01B000B.quest_subtitle: "Worthy of a Tsar"
	quest.7E5A1001A01B000B.subtitle: "Worthy of a Tsar"
	quest.7E5A1001A01B000B.title: "Gem Case of House Fabergé"
	quest.7E677F0F28DB5359.quest_desc: ["An advanced version of its simpler sibling. This one requires &6Higher tier materials&r, but gives&d better rolls&r, and &9stronger gear&r customization. Perfect for mid to endgame optimization."]
	quest.7E6AC4753CD6BF39.quest_desc: ["More storage."]
	quest.7E70AB66644F1C9D.quest_subtitle: "Random Bullshit GO!"
	quest.7E951F2E43900FC0.quest_desc: ["The &dultimate space suit&r, offering &bbuilt-in flight&r, &cheat resistance&r, and advanced protection for &eVenus&r and &9beyond.&r"]
	quest.7EA6B942D1294ED6.quest_desc: [
		"The &9Digital Miner&r can be configured to mine ores only within a certain area. The &9Digital Miner&r can also be set to &nsilk touch&r ores, but this results in higher power consumption."
		""
		"Like all other &7Mekanism&r machines, the &9Digital Miner&r can automatically remove ores from its &einventory&r for automated processing by other machines."
		""
		"This machine &ncan mine for you&r!"
		""
		"It is completely configurable, and can even replace mined blocks with cobblestone, or whatever block you provide it with!"
	]
	quest.7EB1BE897B2B8C1A.quest_desc: ["A mechanical component that redirects rotational force vertically while keeping the same rotational direction. Perfect for compact contraptions where space is limited and precise gear alignment is essential."]
	quest.7EC01E7DB045DB05.quest_subtitle: "Don't forget the augments."
	quest.7EC01E7DB045DB05.title: "Augments"
	quest.7ECFA5751222D0EB.quest_desc: ["The &aDraconic Chest Piece&r has a grid of &b8x6&r for modules."]
	quest.7EE37ABD9F8B873D.quest_desc: [
		"Pattern providers are the primary way in which your autocrafting system interacts with the world. They push the ingredients in their patterns to adjacent inventories, and items can be inserted into them in order to insert them into the network. Often a channel can be saved by piping the output of a machine back into a nearby pattern provider (often the one that pushed the ingredients) instead of using an ME Import Bus to pull the output of the machine into the network."
		""
		"Of note, since they push the ingredients directly from the crafting storage in a crafting CPU, they never actually contain the ingredients in their inventory, so you cannot pipe out from them. You have to have the provider push to another inventory (like a barrel) then pipe from that."
		""
		"{@pagebreak}"
		"Also of note, the provider has to push ALL of the ingredients at once, it can't push half-batches. This is useful to exploit."
		""
		"Pattern providers have a special interaction with interfaces on subnets: if the interface is unmodified (nothing in the request slots) the provider will skip the interface entirely and push directly to that subnet's storage, skipping the interface and not filling it with recipe batches, and more importantly, not inserting the next batch until there's space in the machine. This works correctly with blocking mode, the provider will monitor the slots in the machine for ingredients, instead of the slots in the interface."
	]
	quest.7EE37ABD9F8B873D.title: "ME Pattern Provider"
	quest.7F0002540CB4CEFF.quest_desc: [
		"Various Nests can be found throughout the world. They can also be crafted! Bee nests are similar to hives, but only house a single bee, and have no GUI."
		""
		"With an certain item, usually honey treats, you can trigger a bee to spawn in the nest. This takes 20 Minutes, but can be sped up with additional Treats/Spawning Items (Or Time In A Bottle, if you have it) Bees Spawned this way are \"Solitary Bees\", and only a few have usage outside of breeding."
	]
	quest.7F0002540CB4CEFF.title: "Nests"
	quest.7F042DED357DEF3C.quest_desc: ["You will &nmainly&r be using &6bookshelves&r to increase your &dEnchantment&r &dtable's&r stats. And you will use &6bookshevlves&r to ctraft a few things."]
	quest.7F042DED357DEF3C.title: "Bookshelves"
	quest.7F09F8F98C13F11B.quest_desc: [
		"What is a Demonic Ritual without a &cSacrifice&r! :D"
		""
		"Most of the time, Demons just like items so don't be too afraid yet. However, if you have a favorite Cow, you might need to be worried. Sorry Betsy."
		""
		"&aSacrifical Bowls&r are used to place items needed for Rituals. These can be placed anywhere within the Ritual, as long as it isn't convering up any of the required Chalk."
		""
		"The &6Golden Sacrificial Bowl&r is used in the middle of the Ritual to activate it, and also usually needs a Book of Binding for the Ritual in it."
	]
	quest.7F09F8F98C13F11B.title: "Preparing for a Ritual: &dCrystals&r"
	quest.7F0ECA7AB9551CA1.quest_desc: [
		"To prepare a &n&fParchment&r&r with a spell, design the spell &dwithin your spellbook&r, then place a &n&fparchment&r&r on the &aScribe's Table&r. &lSneak-Right-Click&r the table with your spell book to transfer the selected spell over to the &n&fparchment&r&r."
		""
		"The &nparchment&r can be commbined with &etools&r and &barmour&r for a chance to cast the selected &dspell&r on use."
	]
	quest.7F38E9C6DA5B99EA.quest_desc: ["The &4Flamethrower&r is a ranged weapon which uses &3Hydrogen&r gas as its fuel."]
	quest.7F46E7106A620699.quest_desc: ["Has 36 filter slots and works 5x faster."]
	quest.7F4DCEA4209DEDC3.quest_desc: ["The &aCrystal Binder&r is a tool used to link &dEnergy I/O Crystals&r to various devices."]
	quest.7F5691537646B1BA.quest_desc: [
		"Don't forget to check out the complete guide to mekanism!"
		""
		"[ { \"text\": \"Click Me!\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"6F62B5510FA881CD\" } } ]"
	]
	quest.7F5691537646B1BA.quest_subtitle: "Osmium armor is equivalent to netherite"
	quest.7F5D32DA7E8D094F.quest_desc: ["{ \"text\": \"Click Me!\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"35639D4A6DDF6FF9\" } }"]
	quest.7F5E7082C2ADB094.quest_subtitle: "Not the crying one"
	quest.7F64AD61416A9157.quest_desc: [
		"Place the drilling machine on the ore vein chunk you found and place a drill on it."
		""
		"The ore/fluid will come out in the output of the multiblock."
		""
		"Fluid can be extracted in the copper pipe."
		""
		"The machine requires RPM to work."
	]
	quest.7F783DD7214B96B2.quest_desc: [
		"The Energy Acceptor converts energy from external systems (e.g., Redstone Flux RF) into AE and stores it in the network."
		""
		"Conversion Rate: 2 FE/RF = 1 AE"
		""
		"To see the current energy statistics for your network, right-click any part of it with a Network Tool."
	]
	quest.7FA135C8ABC86B97.quest_desc: [
		"&bShield Projectors&r in &5RFTools&r allow players to create &9protective barriers&r and &ccustomizable shields&r around their bases."
		""
		"Shield Projectors can generate &3force fields&r that block &6entities&r, &aitems&r, and even specific &4players&r. To set up a &bShield Projector&r, place the projector in your world and &n&bright-click&r to open the configuration &6GUI&r. Here, you can define the &n&lshape&r, &4size&r, and &bproperties&r of the shield, such as &9transparency&r and &cdamage effects&r."
		""
		"Combine the &bShield Projector&r with &eShield Templates&r to further &3customize&r the appearance and functionality of your shield. This is a powerful tool for &dprotecting&r your base and controlling &6access&r."
	]
	quest.7FA85713C86166DA.quest_desc: ["Allows you to access your fluid grid wirelessly."]
	quest.7FA85713C86166DA.title: "Wireless Fluid Grid"
	quest.7FAA4D4796F470A4.quest_desc: [
		"Stores up to 1,000,000 AE."
		""
		"They do not accept power directly but are used to add additional power storage to an already existing ME Network."
	]
	quest.7FB12EC3A5888123.quest_desc: ["Tube Junctions help you organize and route air flow in complex systems. Handy when connecting multiple machines from a single compressor line."]
	quest.7FC6FF2B7A02FB5D.quest_desc: ["The &dPotion Generator&r converts &aPotions&r into &cEnergy&r. Different potions provide varying amounts of power, making it a versatile generator for those with an excess of brewing supplies. Simply feed it any potion, and watch it turn into &cPower&r."]
	quest.7FCBDB0F8735E180.quest_desc: [
		"Your entry into &dspace travel&r! This &cTier 1 Rocket&r allows travel to the &bMoon&r once &efueled&r and launched from a pad."
		""
		"&lRight-Click&r to enter, &lShift&r to exit, and &lShift-Right-Click&r to view storage. And press &lSpacebar&r to &dLaunch&r!"
		""
		"Mainly made of &8steel&r."
	]
	quest.7FD3236DCC28E77E.quest_desc: [
		"In Applied Energistics 2, &6channels&r are a fundamental concept that dictate how many devices can be connected and managed within an &dME Network&r."
		""
		"A network management system that limits device connections to 8 channels per cable branch. Channels are used by:"
		""
		"Active machines (Interfaces, Import/Export Buses)"
		""
		"Storage devices (Drives, Chests)"
		""
		"Terminals"
	]
	quest.8B8FD66351E56580.quest_desc: [
		"The ultimate upgrade for any spawner! Applying the &6Pinnacle Spawner Upgrade Rune&r sets all attributes to peak values:"
		""
		"• &eMin Spawn Delay:&r 20 ticks (1s)"
		"• &eMax Spawn Delay:&r 20 ticks (1s)"
		"• &bSpawn Count:&r 16 mobs"
		"• &cMax Nearby Entities:&r 32"
		"• &dPlayer Activation Range:&r 48 blocks"
		""
		"Mobs will spawn almost instantaneously every single second!"
	]
	quest.8B8FD66351E56580.title: "Tier IV: Pinnacle Upgrade Rune"
	quest.DDD58D48A36C1D05.quest_desc: [
		"The &bModular Beehive&r is the pinnacle of beekeeping automation. It is a &e3x3x3 multiblock structure&r:"
		""
		"• Place the &6Modular Beehive Core&r in the center of one outer face (facing outward)."
		"• Fill the rest of the 3x3x3 cube with &eModular Beehive Parts&r or functional modules."
		"• Place &aModular Alvearies&r inside to house your bees (each Alveary holds 5 bees — right-click with Bee Cages to insert them!)."
		""
		"&cZero Entity Lag:&r The Modular Beehive has built-in simulation. Bees never fly out into the world, completely eliminating bee entity lag while producing combs and honey at incredible speeds!"
		""
		"Can be enhanced with functional blocks like Feeders, Exporters, and Overclockers."
	]
