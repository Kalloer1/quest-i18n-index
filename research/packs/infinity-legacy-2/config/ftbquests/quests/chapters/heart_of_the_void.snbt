				{
					id: "746DABE6FF3F88CA"
					item: {
						components: {
							"minecraft:written_book_content": {
								author: "WesleyJBA"
								pages: [
									{
										raw: "\"The cycle is complete.\\nThe Heart of the Void beats within you, silent yet infinite.\\nMatter, time, and energy all have yielded to your will.\\nYou have become more than a creator. You are the echo between realities.\""
									}
									{
										raw: "\"Yet even the Void hungers for meaning.\\nEvery end births a new beginning.\\nSomewhere beyond the stars, forgotten worlds stir once more…\\nwaiting for your hand to shape them.\""
									}
									{
										raw: "\"The Infinity Legacy has reached its conclusion for now.\\nBut the essence of your journey endures.\\nWhen the next dawn rises, and a new universe calls,\\nremember this truth:\\n\\nThe Void never ends it evolves.\""
									}
									{
										raw: "\"Thank you for walking this path.\\nFor building, breaking, and dreaming beyond limits.\\n\\nUntil the next chapter of infinity…\\n\\nWesley JBA\""
									}
								]
								resolved: 1b
								title: {
									raw: "The Void Echoes"
								}
							}
						}
						count: 1
						id: "minecraft:written_book"
					}
					type: "item"
				}
			]
