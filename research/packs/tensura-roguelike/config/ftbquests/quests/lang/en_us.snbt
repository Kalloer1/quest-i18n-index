	quest.07072B574ABE6A28.title: "[&aBuy&r] &6Master&r &eTime Domination&r [&e10 Gold Coins&r]"
	quest.073EACC56955682C.quest_desc: [
		"Every great &9enchanter&r starts with a &eBookshelf&r."
		""
		"Craft &cyour&r first to &aamplify&r your &9arcane potential&r."
		""
		"The &bpath&r to &6mastery&r begins with &eone block&r and &dmany stories&r."
	]
	quest.073EACC56955682C.title: "&e&lLocal Librarian&r"
	quest.083B76D1E620BBAE.quest_desc: [
		"Deep inside hedge mazes or stone courtyards, the massive **Naga** slumbers. This giant, snake-like reptile circles its arena at high velocity."
		""
		"**The Trial**: Block its charges with a shield or dodge out of its trajectory path. The Naga loses segments of its body as it takes damage, making it faster but more vulnerable!"
		""
		"Defeating it unlocks the baseline tier path barriers and rewards you with **Naga Scales** to forge lightweight armor."
	]
	quest.083B76D1E620BBAE.title: "&aThe Naga Courtyard"
	quest.08E28EB8C58F3BE4.title: "[Repeatable] Engravement [Choice]"
	quest.093D3D1488BDC16D.quest_desc: [
		"[&6Receptionist&r] &bSunwyne&r:"
		""
		"\"Tall, weird and black creatures have been spotted wandering and stealing blocks when night falls. They're normally passive, but when looked at will become agitated.\""
		""
		"\"We need you to investigate whatever they are, and if they're too dangerous, end them.\""
	]
	quest.093D3D1488BDC16D.quest_subtitle: "- Slay 5x Enderman"
	quest.093D3D1488BDC16D.title: "&l&8The Unknown Apparition"
	quest.0956DB295D20EAB6.title: "[Repeatable] Engravement [Random]"
	quest.09A4BBA078C7E502.quest_desc: [
		"You have deciphered the most complex, forbidden magical theorems available in the cosmos."
		""
		"By forging etherium armor sets, conquering ancient relics, and balancing the overwhelming weight of the Seven Curses, your status as a legendary cosmic entity is absolute."
		""
		"Claim your final reward, master of the arcane depths!"
	]
	quest.09A4BBA078C7E502.title: "&5&lMaster of the Forbidden Relics"
	quest.09B6511DF352DA32.quest_subtitle: "&5Use a weapon that has 3 Elemental cores slotted."
	quest.09B6511DF352DA32.title: "&5Infinity cores!"
	quest.0C3604429B6BBE84.quest_subtitle: "- Slay 3x Piglin Brute"
	quest.0C3604429B6BBE84.title: "Piglin Brute"
	quest.0D4042416AF35BB7.quest_desc: ["[&6Congratulations!&r]: You are promoted to [&6C&r] Rank!"]
	quest.0D4042416AF35BB7.quest_subtitle: "Strong magical creatures, requiring experienced adventurers."
	quest.0D4042416AF35BB7.title: "[&6C&r] - Rank missions"
	quest.0F26C1787502B190.quest_desc: [
		"Let the &3calm&r of the &5deep guide&r your path — obtain a &bSeashelf&r."
		""
		"Its &6essence&r flows with &aclarity&r and empowers &9enchantments&r through &3still waters&r."
		""
		"&7In silence, the sea whispers secrets older than time."
	]
	quest.0F26C1787502B190.title: "&b&lThe Purity of the Seas&r"
	quest.0F46F95AE13A1D64.quest_desc: [
		"You have fully unlocked the secrets of the land’s soil and the planet’s deepest water networks."
		""
		"By engineering rich bio-soil matrices, preparing legendary banquets, navigating deep-sea astrogation, and retrieving the lost alloy templates of Neptune, your baseline survival mastery is absolute."
		""
		"Claim your final reward, Apex Provider of the Realm!"
	]
	quest.0F46F95AE13A1D64.title: "&5&lGrand Harvester of Sea and Soil"
	quest.1001A2B3C4D5E6F7.quest_desc: [
		"Adventuring across dimensions requires massive inventory space. A regular pocket isn't going to cut it."
		""
		"Craft your very first **Sophisticated Backpack**. In its base tier, it acts as a portable chest you can wear on your back or open with a hotkey."
		""
		"Don't worry about style—you can dye it any color later!"
	]
	quest.1001A2B3C4D5E6F7.quest_subtitle: "Your portable operations base."
	quest.1001A2B3C4D5E6F7.title: "&6Primal Portability"
	quest.1002A2B3C4D5E6F7.quest_desc: [
		"Need massive, localized block storage that eclipses standard vanilla chests? Sophisticated Storage brings heavily modular containers to your base layout."
		""
		"Craft a **Sophisticated Chest** or a **Barrel**. Even at the base tier, these blocks can be upgraded with data modules just like your backpacks."
	]
	quest.1002A2B3C4D5E6F7.quest_subtitle: "Next-gen warehouse management."
	quest.1002A2B3C4D5E6F7.title: "&6Static Vaults"
	quest.1003A2B3C4D5E6F7.quest_desc: [
		"Let's expand your limits. Fusing your pack with metal reinforcing sheets increases both raw item slots and upgrade slot availability."
		""
		"Progressively upgrade your bag through **Iron**, **Gold**, and **Diamond** tiers to unlock absolute maximum portable capacity."
	]
	quest.1003A2B3C4D5E6F7.title: "&bMetamorphic Packing"
	quest.1004A2B3C4D5E6F7.quest_desc: [
		"Don't limit your base vaults to basic wood. Use storage tier upgrades directly on your placed chests or barrels to expand their capacity without breaking them down."
		""
		"Obtain the **Iron**, **Gold**, and **Diamond** variations of your static storage blocks."
	]
	quest.1004A2B3C4D5E6F7.title: "&bFortified Stockpiling"
	quest.1005A2B3C4D5E6F7.quest_desc: [
		"The pinnacle of storage technology. Imbued with the blast-resistant, fireproof capabilities of netherite debris."
		""
		"Evolving both your worn backpack and base vaults to **Netherite** tier secures the ultimate endgame capacity layout, keeping your gear perfectly safe from accidental lava deaths."
	]
	quest.1005A2B3C4D5E6F7.title: "&5Singularity Threshold"
	quest.1006A2B3C4D5E6F7.quest_desc: [
		"Backpacks aren't just for manual sorting—they can be fully automated. Upgrade modules can alter your bag's operational logic completely."
		""
		"**Pickup Upgrade**: Automatically vacuums item drops directly into your bag, bypassing your main inventory slots."
		""
		"**Magnet Upgrade**: Actively pulls distant ground entities straight to your coordinates."
		""
		"**Feeding Upgrade**: Automatically consumes nourishment items from your backpack slot configuration whenever your food bar drops."
	]
	quest.1006A2B3C4D5E6F7.title: "&aUtility Automation"
	quest.1007A2B3C4D5E6F7.quest_desc: [
		"Mass bulk resource gathering can fill chests with cobblestone, gravel, or dirt in seconds. Let's fix that."
		""
		"**Compacting Upgrade**: Automatically converts raw fragments into blocks (e.g. Redstone Dust into Redstone Blocks) inside the container container logic loop."
		""
		"**Compression Upgrade**: Packs matching block layers down tightly into multi-compressed item states to save hundreds of slots."
		""
		"**Void Upgrade**: Automatically disintegrates junk blocks or blacklisted debris types to keep your storage pristine."
	]
	quest.1007A2B3C4D5E6F7.title: "&eDensity Architecture"
	quest.1088332C319AEF28.quest_subtitle: "- Let you know praying cooldown"
	quest.1088332C319AEF28.title: "&l&6Praying cooldown"
	quest.1101A2B3C4D5E6F7.quest_desc: [
		"Waiting around for basic cobblestone smelting furnaces to finish cooking your raw Naquadah or iron ore chunks is a complete waste of precious adventuring time."
		""
		"Welcome to the **Heavy Processing and Containment tiers**."
		""
		"Your first milestone is to upgrade your baseline smelting speed. Craft an **Iron Furnace**—it handles basic smelting logic significantly faster than vanilla variants while burning fuel elements far more efficiently!"
	]
	quest.1101A2B3C4D5E6F7.quest_subtitle: "Accelerated metallurgy starts here."
	quest.1101A2B3C4D5E6F7.title: "&6Thermal Ignition"
	quest.1102A2B3C4D5E6F7.quest_desc: [
		"Before you connect an extensive automated cabling grid to your base layout, you need compact, localized vault units that don't take up an entire room's worth of surface area."
		""
		"Fulfill your early baseline storage requirements by crafting an **Iron Chest**."
		""
		"It completely condenses the volumetric capacity layout of a standard double-chest into the space of a single physical block footprint!"
	]
	quest.1102A2B3C4D5E6F7.quest_subtitle: "Ditching double chests forever."
	quest.1102A2B3C4D5E6F7.title: "&6Compact Containment"
	quest.1103A2B3C4D5E6F7.quest_desc: [
		"Let's shatter your local thermal processing restrictions completely. By reinforcing your smelting core with higher density metals, you exponentially accelerate cook cycles."
		""
		"Progressively craft or upgrade your thermal units through the **Gold** and **Diamond** furnace benchmarks."
		""
		"A Diamond Furnace fires material processing tags off at blinding speed, transforming full item stacks into finished alloys in seconds!"
	]
	quest.1103A2B3C4D5E6F7.title: "&bSupercharged Smelting"
	quest.1104A2B3C4D5E6F7.quest_desc: [
		"Keep scaling your localized block storage up right alongside your mineral intake loops."
		""
		"Upgrade your iron boxes into **Gold** and **Diamond** chest variants. You don't even need to pick them up—just use an upgrade item right-clicked flat against the placed block face!"
		""
		"A single Diamond Chest provides a massive inventory matrix view window, layout-optimized to hold a warehouse's worth of mob drops and ores safely."
	]
	quest.1104A2B3C4D5E6F7.title: "&bHigh-Density Vaults"
	quest.1105A2B3C4D5E6F7.quest_desc: [
		"Are you tired of manually hand-feeding charcoal or coal blocks down into your processing setups?"
		""
		"Equip your machinery by crafting the **Wireless Heat Transmitter** upgrade module or the **Factory Upgrade** chip."
		""
		"These logic augment modules allow your furnace arrays to pull fuel directly from your network wirelessly, or instantly split a single machine frame into an automated, multi-slot smelting factory conveyor belt loop!"
	]
	quest.1105A2B3C4D5E6F7.title: "&aIntegrated Automation"
	quest.1106A2B3C4D5E6F7.quest_desc: [
		"Want to see exactly what is resting inside your storage containers without opening a single GUI window layout?"
		""
		"Upgrade your Diamond containers into a **Crystal Chest** variant."
		""
		"The Crystal Chest keeps its massive item slot matrix limits fully intact but renders its top 3 internal items floating physically in the world, letting you parse your storage blocks at a glance!"
	]
	quest.1106A2B3C4D5E6F7.title: "&aVisual Transparency"
	quest.1107A2B3C4D5E6F7.quest_desc: [
		"The absolute peak execution of thermal physics and material containment."
		""
		"Forge the legendary **Netherite Furnace** and the blast-resistant, completely fireproof **Netherite Chest**."
		""
		"The Netherite Furnace runs at blistering speeds, can burn raw fire or lava energy directly, and both blocks are 100% immune to exploding creepers and lava disposal drops!"
	]
	quest.1107A2B3C4D5E6F7.quest_subtitle: "Peak thermal density."
	quest.1107A2B3C4D5E6F7.title: "&5The Obsidian Catalyst Threshold"
	quest.110CEC1930AED8E7.quest_desc: [
		"You &estand&r before &6the&r final &cthreshold&r of &5arcane mastery&r."
		""
		"Unleash &6legendary&r power by &9enchanting&r an item at &aLevel 100&r."
		""
		"Only &athose&r with the &6heart&r of a &cdrake&r can &ewield&r such &4might&r."
	]
	quest.110CEC1930AED8E7.title: "&c&lDraconic Enchanting&r"
	quest.11639D27FC79CDAD.quest_desc: [
		"[&6TIP&r]:"
		""
		"To kill it you must be strong!"
		""
		"&5Recommendation&r for skill set:"
		"- Aura Sword"
		"- Ogre-sword Guillotine"
		"- Magic Aura"
		""
		"With these you can hurt it ^_^"
	]
	quest.11639D27FC79CDAD.quest_subtitle: "Defeat the &5Elemental Colossus"
	quest.11639D27FC79CDAD.title: "&5The fairy wont like this..."
	quest.11A54746B7DBD21F.quest_subtitle: "- Slay 5x Leech Lizard"
	quest.11A54746B7DBD21F.title: "Leech Lizard"
	quest.1201A2B3C4D5E6F7.quest_desc: [
		"Why dig deep into underground labyrinths or hunt dangerous boss monsters for resources when you can cultivate them directly from the dirt?"
		""
		"Welcome to **Mystical Agriculture**. Your journey begins by hunting down passive elemental forces in the world to gather **Prosperity Shards** and **Inferium Essence**."
		""
		"Combine them with vanilla wheat seeds to forge your first **Inferium Seeds**—the starting catalyst block for all magical resource farming!"
	]
	quest.1201A2B3C4D5E6F7.quest_subtitle: "Sprouting your first resource loops."
	quest.1201A2B3C4D5E6F7.title: "&6Botanical Foundations"
	quest.1202A2B3C4D5E6F7.quest_desc: [
		"To breed seeds capable of growing actual diamond, netherite, or custom modded elements, you must compress your baseline magical energy."
		""
		"Utilize an **Infusion Altar** and **Infusion Pedestals** to progressively step your essences through four higher density matrices:"
		""
		"- **Prudentium** (Tier 2)"
		"- **Intermedium** (Tier 3)"
		"- **Imperium** (Tier 4)"
		"- **Supremium** (Tier 5)"
	]
	quest.1202A2B3C4D5E6F7.title: "&bAlchemical Upgrading"
	quest.1203A2B3C4D5E6F7.quest_desc: [
		"Resource crops don't grow at peak efficiency on standard, mundane dirt blocks. They require specialized soil mediums infused with magical frequencies."
		""
		"Upgrade your layout farmland directly with matching tier essence."
		""
		"Planting an Inferium Seed on **Supremium Farmland** exponentially scales its yield, causing it to drop massive multiples of extra essence upon harvesting!"
	]
	quest.1203A2B3C4D5E6F7.title: "&bMagical Bio-Density"
	quest.1204A2B3C4D5E6F7.quest_desc: [
		"Once your infusion altar is firing, you can synthesize seeds for concrete, purchaseable resources."
		""
		"**Iron Seeds**: Grow pure iron data blocks."
		""
		"**Diamond Seeds**: Sprout diamond components automatically."
		""
		"**Experience Seeds**: Cultivate literal experience droplets directly from your field plots!"
	]
	quest.1204A2B3C4D5E6F7.title: "&bThe Mineral Harvest"
	quest.1205A2B3C4D5E6F7.quest_desc: [
		"Push past the limits of traditional agriculture by breaking through into **Mystical Agradditions** endgame tier loops."
		""
		"Synthesize the volatile **Insanium Essence** (Tier 6) to craft absolute god-tier crops."
		""
		"These master seeds allow you to grow hyper-dense materials like Nether Stars, Dragon Eggs, and custom endgame items mapped out via **Mystical Customization** rules!"
	]
	quest.1205A2B3C4D5E6F7.quest_subtitle: "Tier 6 Singularity Gardening."
	quest.1205A2B3C4D5E6F7.title: "&4Insanium Alchemy"
	quest.1206A2B3C4D5E6F7.quest_desc: [
		"Tier 6 insanium seeds are so complex they refuse to grow on standard farmland blocks. They require an environmental stabilizer."
		""
		"You must craft a specialized **Crux block** (such as the Nether Star Crux or Dragon Egg Crux) and place it *directly underneath* the farmland tile."
		""
		"The Crux safely channels cosmic energy upward, allowing your Tier 6 seeds to anchor their roots and produce legendary endgame essences automatically!"
	]
	quest.1206A2B3C4D5E6F7.title: "&eCosmic Anchoring"
	quest.1207A2B3C4D5E6F7.quest_desc: [
		"Want to automatically squeeze essences out of your crops without swinging a scythe by hand all day?"
		""
		"Forge an **Harvester** machine or utilize core tools like the **Growth Accelerator**."
		""
		"Growth Accelerators can be stacked directly underneath your farmland tiles. They emit a constant magical pulse upward, forcing your resource seeds to skip growth stages entirely!"
	]
	quest.1207A2B3C4D5E6F7.title: "&eTemporal Accel-Looping"
	quest.1208A2B3C4D5E6F7.quest_desc: [
		"You have successfully completely mastered the complex biological and alchemical laws of magical botany."
		""
		"By engineering rich bio-soil matrices, upgrading essence layouts to Insanium thresholds, deploying sub-farmland Crux stabilizers, and stacking temporal acceleration networks, your resource generation is absolute."
		""
		"Claim your final reward, Sovereign Cultivator of the Cosmos!"
	]
	quest.1208A2B3C4D5E6F7.title: "&5&lSovereign Cultivator of the Cosmos"
	quest.1284268B1D870D94.title: "[&aBuy&r] &6Spirit Cooldown Reset&r [&c1 Gold Coin&r]"
	quest.1301A2B3C4D5E6F7.quest_desc: [
		"Relying on standard vanilla swords when facing down high-rank labyrinth monsters or ancient calamities is a quick way to get yourself sent back to your spawn point."
		""
		"Welcome to **Simply Warfare**. Your first task is to forge a specialized heavy weapon frame."
		""
		"Craft a **Claymore**, **Greataxe**, or a long-reaching **Halberd** from any baseline metal ingot. These unique weapon structures possess custom attack ranges, slower swings, but devastating built-in sweeping damage tags!"
	]
	quest.1301A2B3C4D5E6F7.quest_subtitle: "Forging the blades of true knights."
	quest.1301A2B3C4D5E6F7.title: "&6Heavy Armaments"
	quest.1302A2B3C4D5E6F7.quest_desc: [
		"If you prefer keeping your distance while sniping down wild direwolves or flying otherworlder mobs, traditional wood bows won't cut it."
		""
		"Step into the archery branch of the modpack by crafting a specialized **Longbow** or an advanced **Recurve Bow** from the **Simply Bows** array."
		""
		"These weapons pull back smoother, fire projectiles at high-frequency velocities, and pierce baseline mob resistances effortlessly!"
	]
	quest.1302A2B3C4D5E6F7.quest_subtitle: "Interstellar accuracy."
	quest.1302A2B3C4D5E6F7.title: "&6Ranged Dominance"
	quest.1303A2B3C4D5E6F7.quest_desc: [
		"Heavy blades aren't the only way to fight. If you prefer high-frequency attack speeds, you must master the light-weapon combat paths."
		""
		"Forge a pair of **Daggers**, a swift **Rapier**, or a dual-wielded **Sai**."
		""
		"While their raw individual damage tags are lower, their attack speed operation allows you to trigger on-hit status effects, lifesteal loops, and weapon enchantments twice as fast!"
	]
	quest.1303A2B3C4D5E6F7.title: "&bFlashing Steel"
	quest.1304A2B3C4D5E6F7.quest_desc: [
		"Scale your ranged arsenal upward by introducing metallurgical upgrades from **Simply More**."
		""
		"Forge your weapons using high-density components like **Runesteel**, **Stellarium**, or **Mystite** alloys."
		""
		"These advanced metal composites possess massive native durability stats and automatically amplify your projectile damage metrics beautifully!"
	]
	quest.1304A2B3C4D5E6F7.title: "&bAlloy Compounding"
	quest.1305A2B3C4D5E6F7.quest_desc: [
		"Ordinary blocks cannot unleash true tactical capabilities. To access hidden weapon movesets, you must discover **Runefused Gems** locked inside ancient structures."
		""
		"Socket a **Runefused Gem** into your Simply Swords weapons at a smithing table."
		""
		"This unlocks your weapon's unique **Active Ability** matrix—allowing you to press your ability key to unleash devastating spinning slashes, gap-closing lunges, or fiery aura explosions!"
	]
	quest.1305A2B3C4D5E6F7.title: "&aRunic Attunement"
	quest.1306A2B3C4D5E6F7.quest_desc: [
		"Take your ranged utility to the extreme boundary layers. Why fire basic arrows when you can utilize advanced chemical payload canisters?"
		""
		"Assemble a specialized **Crossbow** mechanism or apply custom status modifications to your bow frames."
		""
		"These augment arrays force arrows to explode into toxic clouds, freeze enemies in solid block layers, or ignite vast areas upon projectile impact!"
	]
	quest.1306A2B3C4D5E6F7.title: "&aTactical Artillery"
	quest.1307A2B3C4D5E6F7.quest_desc: [
		"The absolute pinnacle of martial engineering. These legendary artifact blades cannot be crafted by common blacksmiths—they must be recovered from mythic structure vaults."
		""
		"Discover an Artifact weapon, such as the reality-shattering **Soulvester**, the frost-imbued **Watching Wye**, or the toxic **Brimstone** greatblade."
		""
		"These mythic relics carry permanent, tier-10 hidden enchantment loops that can completely decimate high-rank bosses in a few swings!"
	]
	quest.1307A2B3C4D5E6F7.quest_subtitle: "Weapons of lost gods."
	quest.1307A2B3C4D5E6F7.title: "&4Mythic Artifact Remnants"
	quest.1308A2B3C4D5E6F7.quest_desc: [
		"You have successfully completely mastered the martial handling characteristics of every weapon class roaming the cosmos."
		""
		"By forging heavy claymores, engineering runefused active abilities, compounding advanced stellarium alloys, and wielding the lost mythic remnants of the gods, your supremacy over battlefield logistics is absolute."
		""
		"Claim your final reward, Grand Warmaster of the Realm!"
	]
	quest.1308A2B3C4D5E6F7.title: "&5&lGrand Warmaster of the Realm"
	quest.13969ADF493DE92D.title: "[Repeatable] Enchantments [Choice]"
	quest.13CF5F05B54449A1.quest_subtitle: "- Slay 1x Ghast"
	quest.13CF5F05B54449A1.title: "Ghast"
	quest.1401A2B3C4D5E6F7.quest_desc: [
		"Are your storage chests overflowing with thousands of pieces of Cobblestone, Dirt, and Gravel from your mining trips? Standard chests waste entire slot views on matching items."
		""
		"Welcome to the **Mass Stockpiling and Drawer networks**."
		""
		"Your first milestone is to separate bulk items from complex tools. Craft a basic **Storage Drawer** (Full block size). Drawers dedicate their entire structural volume to a single item type, holding thousands of them in a single slot visual layout!"
	]
	quest.1401A2B3C4D5E6F7.quest_subtitle: "True high-density single-item vaults."
	quest.1401A2B3C4D5E6F7.title: "&6Density Architecture"
	quest.1402A2B3C4D5E6F7.quest_desc: [
		"Manually walking up to fifty individual wood drawers just to sort your mob drops or mined shards is a massive waste of precious exploration time."
		""
		"Build the brain of your structural storage network by crafting the **Drawer Controller**."
		""
		"Place the Controller touching your drawers. By right-clicking the Controller block face, it automatically searches your entire player inventory and pipes matching items directly into their designated drawer slots across the whole network instantly!"
	]
	quest.1402A2B3C4D5E6F7.quest_subtitle: "The inventory deposition hub."
	quest.1402A2B3C4D5E6F7.title: "&6The Logistics Central Core"
	quest.1403A2B3C4D5E6F7.quest_desc: [
		"A baseline wooden drawer holds a respectable number of stacks, but a heavy industrial base layout will fill that up in minutes. Let's expand your storage limits."
		""
		"Craft **Storage Upgrades** ranging from Obsidian/Iron up to Diamond thresholds."
		""
		"Right-clicking these upgrade keys into your drawer slot configurations multiplies its base capacity limits exponentially—allowing a single block footprint to hold hundreds of thousands of resources!"
	]
	quest.1403A2B3C4D5E6F7.title: "&bVolumetric Multiplication"
	quest.1404A2B3C4D5E6F7.quest_desc: [
		"What if your drawers become completely full of junk items like cobblestone or gravel from an automated quarry, causing your entire extraction pipeline to lock up?"
		""
		"Equip your system slots with a **Void Upgrade**."
		""
		"Once inserted, the drawer will hold items up to its absolute maximum limit, and then safely and cleanly disintegrate any incoming overflow items automatically, keeping your pipes perfectly clear!"
	]
	quest.1404A2B3C4D5E6F7.title: "&bOverflow Protection"
	quest.1405A2B3C4D5E6F7.quest_desc: [
		"Manually uncrafting iron, gold, or diamond blocks back down into individual raw pieces just to feed recipes is incredibly tedious."
		""
		"Solve this logistical puzzle by crafting a **Compacting Drawer**."
		""
		"This high-tech storage block dynamically reads compression tags—allowing you to input iron blocks, and pull out raw ingots or nuggets from the exact same interface seamlessly, keeping all three tiers balanced automatically!"
	]
	quest.1405A2B3C4D5E6F7.title: "&aDynamic Compacting Matrices"
	quest.1406A2B3C4D5E6F7.quest_desc: [
		"Want to pipe your massive wall of storage drawers cleanly into your modern *Tom's Simple Storage*, *Refined Storage*, or *Applied Energistics 2* master terminal networks?"
		""
		"Run a single system storage cable or external bus connector and anchor it directly to your **Drawer Controller** face."
		""
		"Because the Controller coordinates the logic links for every attached drawer block, your digital network will instantly read and access millions of stored items through a single cable connection footprint!"
	]
	quest.1406A2B3C4D5E6F7.title: "&aUnified Network Integration"
	quest.1407A2B3C4D5E6F7.quest_desc: [
		"You have successfully completely mastered the intricate laws of mass item containment and physical-to-digital inventory logistics."
		""
		"By engineering high-density diamond upgrade matrices, deploying auto-void overflow safety chips, balancing real-time compacting drawers, and bridging entire warehouse arrays into a single digital mainframe, your logistical supremacy is absolute."
		""
		"Claim your final reward, Sovereign Logistician of the Realm!"
	]
	quest.1407A2B3C4D5E6F7.title: "&5&lSovereign Logistician of the Realm"
	quest.146F87C815332D90.quest_desc: [
		"Every powerful warrior and high-tier Majin needs top-quality sustenance to keep their stats peaked and their energy running hot."
		""
		"Welcome to the **Culinary and Aquatic arts**. Your first step is to upgrade your baseline processing tools."
		""
		"Craft a **Cutting Board** along with an iron **Flint Knife**. This setup allows you to cleanly slice up raw meats, harvest wild canvas materials, and prepare ingredients without wasting resources!"
	]
	quest.146F87C815332D90.quest_subtitle: "The journey to peak nutrition."
	quest.146F87C815332D90.title: "&6The Prep Station"
	quest.1501A2B3C4D5E6F7.quest_desc: [
		"Venturing into high-rank dimensions and challenge dungeons requires more than just high physical defense—you need ancient artifacts and loyal companions that alter reality around you."
		""
		"Welcome to the **Relic Hunting and Wilderness Exploration track**."
		""
		"Your first milestone is to prepare for long journeys away from home. Craft a **Traveler's Backpack**. It acts as a massive portable chest, features built-in fluid tanks for potion or water storage, and provides a sleeping bag layer so you can rest anywhere!"
	]
	quest.1501A2B3C4D5E6F7.quest_subtitle: "The ultimate survival pack."
	quest.1501A2B3C4D5E6F7.title: "&6Wilderness Readiness"
	quest.1502A2B3C4D5E6F7.quest_desc: [
		"What if you could carry living, sentient entities inside your pocket that grant you powerful status modifiers as long as they are fed?"
		""
		"Welcome to **Inventory Pets**. Craft or discover your first pocket companion, such as the **Cloud Pet** (grants flight/speed) or the **Illager Pet** (boosts attack matrices)."
		""
		"**Warning**: Inventory pets are alive! Keep their favorite food items (like diamonds, iron nuggets, or quartz) inside your active hotbar layer, or they will starve and temporarily disable their status buffs!"
	]
	quest.1502A2B3C4D5E6F7.quest_subtitle: "Sentient pocket modifiers."
	quest.1502A2B3C4D5E6F7.title: "&6Pocket Companions"
	quest.1503A2B3C4D5E6F7.quest_desc: [
		"Ancient structure vaults hold incredibly complex accessories forged by old civilizations. Open lost chests inside dungeons to recover your first true artifact from the **Relics** and **More Relics** mods."
		""
		"Discover an active relic such as the **Amethyst Lens**, **Aqua Walker**, or **Spatial Badge**."
		""
		"These high-value curios slots artifacts scale your capabilities beautifully—granting permanent step height increases, health absorption loops, or bullet-velocity projectile multipliers!"
	]
	quest.1503A2B3C4D5E6F7.title: "&bLost Antiquities"
	quest.1504A2B3C4D5E6F7.quest_desc: [
		"The peak of accessory refinement. Deep inside end-game dungeons, you have a rare chance to discover the high-frequency status bands from **Rings of Ascension: Reborn**."
		""
		"Recover a ring variant, such as the **Ring of Ascension: Flight**, **Ring of Ascension: Magnetism**, or **Ring of Ascension: Regeneration**."
		""
		"Unlike standard magical trinkets, these rings grant *permanent, unconditional tier-level beacon effects* directly to your player profile without using any fuel or mana capital!"
	]
	quest.1504A2B3C4D5E6F7.title: "&bAscension Loops"
	quest.1505A2B3C4D5E6F7.quest_desc: [
		"Want to fully customize your found relics to perfectly line up with your specific combat or magic stats?"
		""
		"Utilize **Research Notes** and specialized relic smithing modifiers to completely augment your gear."
		""
		"Upgrading your relics via experience points unlocks custom sub-attribute arrays—allowing your gear to actively level up alongside your player character!"
	]
	quest.1505A2B3C4D5E6F7.title: "&aArtifact Modification"
	quest.1506A2B3C4D5E6F7.quest_desc: [
		"Take your inventory companions to the absolute peak performance layer. Track down ultra-rare legendary entities like the **Black Hole Pet**, **Portal Pet**, or **Quantum Pet**."
		""
		"These endgame companions can completely bend space-time laws—allowing you to warp to coordinate markers instantly, auto-devour junk materials, or nullify incoming physical damage blocks entirely!"
	]
	quest.1506A2B3C4D5E6F7.title: "&aCosmic Companionship"
	quest.1507A2B3C4D5E6F7.quest_desc: [
		"You have successfully completely mastered the ancient laws of artifact attunement and cosmic companionship."
		""
		"By deploying advanced traveler storage nodes, leveling up your found relic parameters via research sheets, wearing rings of ascension, and coordinating legendary hotspots for your Hotbar pets, your baseline survival supremacy is absolute."
		""
		"Claim your final reward, Sovereign Collector of the Cosmos!"
	]
	quest.1507A2B3C4D5E6F7.title: "&5&lSovereign Collector of the Cosmos"
	quest.15898B50B68EE14C.quest_subtitle: "- &cKill&r a &5Megalodon"
	quest.15898B50B68EE14C.title: "&5Megalodon"
	quest.15F1CEEF036CDADB.quest_subtitle: "- Sacrifice &4Marionette Heart&r and 64x &bHigh Quality Magic Crystal"
	quest.15F1CEEF036CDADB.title: "[&bRepeatable&r] &6Otherworlder Spawn egg&r [&cChoice&r]"
	quest.17C018E2AF96F1DA.quest_desc: [
		"Each of the armor parts contains the same bonuses its just hidden."
		""
		"[&6BONUSES&r]:  "
		"- &6Blast Protection&r X  "
		"- &6Fire Protection&r X  "
		"- &6Projectile Protection&r X  "
		"- &6Protection&r X  "
		"- &6Thorns&r X  "
		"- &6Unbreaking&r X  "
		"- &aMending&r  "
		"- &bBreathing Support&r I  "
		"- &eElemental Boost&r X  "
		"- &eElemental Resistance&r X  "
		"- &bSturdy&r X  "
		"- &aUnbreakable&r  "
		""
		"[&8Credit&r]: &bMrPrefecterCell&r"
	]
	quest.17C018E2AF96F1DA.quest_subtitle: "- It's almost unbreakable"
	quest.17C018E2AF96F1DA.title: "&l&bLegendary Armor&r"
	quest.188356D5B81AC4C5.quest_desc: [
		"[&6TIP&f]"
		""
		"To form a contract go left road from the portal up the stairs."
		""
		"When you are on the platform &chold&r &asneak&r button to &5pray"
		""
		"If the screen goes &cdark&r and you see &6spirits&r everything praying is working!"
		""
		"If the screen doesnt go dark you must wait which is &a20 minutes&r from last praying!"
		""
		"To check prayings cooldown you can use command: ( time in seconds )"
		"&a/tensura get PLAYER_NAME spirit cooldown"
	]
	quest.188356D5B81AC4C5.quest_subtitle: "&aForm a contract with any Spirit."
	quest.188356D5B81AC4C5.title: "&aElementalist"
	quest.1A2B3C4D5E6F7A8B.quest_desc: [
		"Tired of opening twenty different wooden chests just to find your monster drops? Welcome to **Tom's Simple Storage**."
		""
		"This mod allows you to link all of your existing chests together into a single, searchable visual network."
		""
		"Craft a **Storage Terminal** and place it flat against any vanilla chest to begin your network."
	]
	quest.1A2B3C4D5E6F7A8B.quest_subtitle: "The end of chest sorting chaos."
	quest.1A2B3C4D5E6F7A8B.title: "&6The Central Core"
	quest.1A595909B9E769F9.quest_subtitle: "- Slay 3x Evil Centipede"
	quest.1A595909B9E769F9.title: "Evil Centipede"
	quest.1A895E44A2CD2104.quest_subtitle: "- Slay &cOrc Lord"
	quest.1A895E44A2CD2104.title: "&6The March of the Famine"
	quest.1BCA5564BD1FE804.quest_desc: [
		"High inside the massive, lightning-shrouded **Dark Tower**, a terrifying, multi-tentacled block monster coordinates data strings."
		""
		"The **Ur-Ghast** floats above the tower platform, crying giant exploding fire droplets and summoning carminite helper units. Utilize the arena's floor traps to forcefully snare it down to your level!"
		""
		"Slaying it rewards you with **Carminite** modules and the highly potent **Tower Key** layouts."
	]
	quest.1BCA5564BD1FE804.title: "&dThe Ur-Ghast Dark Tower"
	quest.1C89DED2A4BCF9F7.quest_desc: [
		"[&6Receptionist&r] &bSunwyne&r:"
		""
		"\"Direwolves were seen hunting close to cities, unusual behavior. The guild believe some high ranking direwolf might have appeared.\""
		""
		"\"Don't underestimate then, especially if you see star-marking on their head\""
	]
	quest.1C89DED2A4BCF9F7.quest_subtitle: "- Slay 5x Direwolf"
	quest.1C89DED2A4BCF9F7.title: "&l&1The Howling Beast"
	quest.1D18DA57C37D5D22.quest_subtitle: "- Slay 3x Lizardman"
	quest.1D18DA57C37D5D22.title: "Lizardman"
	quest.1D2E3F4A5B6C7D8E.quest_desc: [
		"Running cables across your entire magic base layout can look incredibly messy. Let's hide the clutter."
		""
		"The **Inventory Trim** block acts identically to an inventory cable, but looks like a clean, solid structural building element."
		""
		"You can line your floors or walls with Trim blocks to connect vast walls of chests without a single strand of visible cabling showing."
	]
	quest.1D2E3F4A5B6C7D8E.title: "&7Architectural Routing"
	quest.1DF480C443F2B5D6.quest_desc: [
		"[&6TIP&r]:"
		""
		"To make it happen you have to pray each and every day ^_^"
	]
	quest.1DF480C443F2B5D6.quest_subtitle: "&5Have a Greater Spirit or above in every elemental."
	quest.1DF480C443F2B5D6.title: "&5Blessed one!"
	quest.1E22326FF5B8B5AA.quest_subtitle: "- Sacrifice &aEmerald block"
	quest.1E22326FF5B8B5AA.title: "[&bRepeatable&r] Villager egg"
	quest.1FF12800B08DA4DA.quest_desc: [
		"[&6&k???&r] &bMrPerfecterCell&r:"
		""
		"\"...\""
	]
	quest.1FF12800B08DA4DA.quest_subtitle: "..."
	quest.1FF12800B08DA4DA.title: "&l&b???"
	quest.2001A2B3C4D5E6F7.quest_desc: [
		"Welcome to the peak of digital logistics. **Refined Storage** converts physical items and fluids into pure data, storing millions of blocks inside compact structural disks."
		""
		"Every digital network requires a brain and power. Craft the **Controller** and connect it to your base FE/Forge Energy power layout."
		""
		"Keep an eye on its power bar—if the Controller runs out of energy, your entire digital storage network goes dark!"
	]
	quest.2001A2B3C4D5E6F7.quest_subtitle: "The digital mainframe."
	quest.2001A2B3C4D5E6F7.title: "&6Mainframe Initialization"
	quest.2002A2B3C4D5E6F7.quest_desc: [
		"A controller alone does not have a screen to browse items. You need a window into the digital grid."
		""
		"Craft a **Grid** to view and pull out items, or upgrade it to a **Crafting Grid** to embed a standard 3x3 assembly grid directly into your search interface."
		""
		"The Crafting Grid automatically pulls required raw data blocks straight out of your network storage banks as you assemble recipes!"
	]
	quest.2002A2B3C4D5E6F7.title: "&bDigital Access Ports"
	quest.2003A2B3C4D5E6F7.quest_desc: [
		"Data needs a physical medium to live on. The **Disk Drive** reads individual storage elements and mounts their contents directly onto your mainframe grid."
		""
		"Craft a Disk Drive and place it anywhere on your cable layout."
		""
		"To actually store items, you must craft **Storage Parts** and slide them inside the drive slots. Progress through **1k**, **4k**, **16k**, and **64k** disk sizes to massively expand your block limits!"
	]
	quest.2003A2B3C4D5E6F7.title: "&bItem Databanks"
	quest.2004A2B3C4D5E6F7.quest_desc: [
		"Why limit your grid to solid blocks? Refined Storage can dematerialize liquids into raw code as well."
		""
		"Craft a **Fluid Grid** to view, deposit, and extract liquids directly into buckets."
		""
		"Slide specialized **Fluid Storage Disks** into your drive arrays to store thousands of buckets of water, lava, or magical potions in a fraction of a single block slot!"
	]
	quest.2004A2B3C4D5E6F7.title: "&bLiquid Processing Arrays"
	quest.2005A2B3C4D5E6F7.quest_desc: [
		"Don't tether yourself to a physical block terminal when managing your industrial machines or sorting loot boxes."
		""
		"Craft a **Wireless Transmitter** and connect it to your cable network, then sync a **Wireless Grid** to your Controller main frame."
		""
		"By filling the Transmitter with **Range Upgrades**, you can access your entire base inventory wirelessly while wandering around your local base perimeter!"
	]
	quest.2005A2B3C4D5E6F7.title: "&aTetherless Diagnostics"
	quest.2006A2B3C4D5E6F7.quest_desc: [
		"Standard wireless signals degrade completely when crossing dimensional rifts, locking you out of your network while diving down into labyrinths or traversing the Nether."
		""
		"Upgrade your transmitter matrix by crafting the **Network Transmitter**, **Network Receiver**, and a **Network Card**."
		""
		"By anchoring a card link between cross-dimensional receiver pads, you can route infinite data lines across dimensions, maintaining total access to your base storage anywhere in creation!"
	]
	quest.2006A2B3C4D5E6F7.title: "&5Cross-Dimensional Frequency"
	quest.2007A2B3C4D5E6F7.quest_desc: [
		"Why craft items manually when the mainframe can calculate logistics loops for you?"
		""
		"Build a **Pattern Grid** and use **Patterns** to encode item blueprints. Then, slide those patterns into a **Crafter** block placed flat against an automated furnace or machine assembly layout."
		""
		"When you order a complex item from your terminal, the network will automatically dispense raw fragments, cook intermediate alloys, and deliver the final compiled item directly to your inventory!"
	]
	quest.2007A2B3C4D5E6F7.title: "&eAutomated Logic Matrices"
	quest.2013F5E1885CA275.quest_desc: ["[&cCongratulations!&r]: You are promoted to [&cB&r] Rank!"]
	quest.2013F5E1885CA275.quest_subtitle: "Highly dangerous monsters that can threaten towns or groups."
	quest.2013F5E1885CA275.title: "[&cB&r] - Rank missions"
	quest.218AA03949F983A1.quest_desc: ["[&eCongratulations!&r]: You are promoted to [&eD&r] Rank!"]
	quest.218AA03949F983A1.quest_subtitle: "Moderate threats requiring some combat skills."
	quest.218AA03949F983A1.title: "[&eD&r] - Rank missions"
