	quest.71C36271EBCF1A2F.quest_desc: [
		"Deep beneath the dark oak forest inside subterranean tombs populated by **Knight Phantoms**, you must put the spirits of fallen warriors to rest."
		""
		"A full squad of multiple spectral executioner armor sets floats around the arena room, throwing massive spectral axes and picks. Dodge their geometric flight tracking lines and lay their souls to rest."
	]
	quest.71C36271EBCF1A2F.title: "&5The Knight Phantom Tomb"
	quest.7417761213B258EE.quest_desc: ["- Summon &ayour&r contracted &6Elemental Spirit&r to have it &btemporarily&r fight for &ayou"]
	quest.7417761213B258EE.quest_subtitle: "- Requires &bContract&r with &6Medium Spirit"
	quest.7417761213B258EE.title: "&9Summon Medium Elemental"
	quest.76076AC96931A91D.quest_desc: [
		"While casting your lines into the deep depths of old ocean monuments or hidden cavern wells, you have a rare chance to pull up lost, rusted iron vaults."
		""
		"Fish up a **Neptune's Bounty** lockbox."
		""
		"Cracking open this legendary crate lets you claim the mythical **Neptunium Ingot** strings, unlocking the capability to forge tools and weapons that function flawlessly underwater without any drag friction!"
	]
	quest.76076AC96931A91D.title: "&eRelics of Neptune"
	quest.77C911CA36EDB7AF.quest_subtitle: "- Slay &3Supermassive Slime"
	quest.77C911CA36EDB7AF.title: "&3Corrosive Calamity"
	quest.785117D02A3DD7A7.title: "Silver Coin"
	quest.79CB7F5684941CE8.quest_subtitle: "- Slay Armoursaurus"
	quest.79CB7F5684941CE8.title: "Armoursaurus"
	quest.7A8B9C1D2E3F4A5B.quest_desc: [
		"Why just pull items out when you can craft them instantly from the network screen?"
		""
		"The **Crafting Terminal** upgrades your standard storage terminal by embedding a standard 3x3 crafting grid directly into the search user interface."
		""
		"It will automatically pull raw resources out of your connected chests as you click recipe outputs!"
	]
	quest.7A8B9C1D2E3F4A5B.title: "&aIntegrated Assembly"
	quest.7AE2F3F84DDF3BEB.quest_desc: [
		"[&4Guild Master&r] &6Fuze&r:"
		""
		"Even among legends, your name resounds louder."
		""
		"Your deeds have shattered the limits of S-Class—there’s no rank beyond this in our records… but you have become the exception."
		""
		"Today, you ascend to a myth none dared to imagine."
		"A title forged solely to contain your overwhelming existence"
		""
		"Because of you, I had to invent a new rank."
		"There was nothing beyond S-Class—until now."
		"You are now [&bSS&r] Class&r."
		""
		"The world won't just look to you for hope."
		"It will fear what happens when you fall."
	]
	quest.7AE2F3F84DDF3BEB.quest_subtitle: "Calamity-class beings capable of immense destruction."
	quest.7AE2F3F84DDF3BEB.title: "[&bSS&r] - Rank missions"
	quest.7B6EEAB0C4D757E2.title: "[Repeatable] Battlewill [Choice]"
	quest.7BC47CE51A87F8F3.quest_desc: [
		"[&6TIP&f]"
		"Its colossal gate structure which you cant miss!"
		""
		"If you are struggling to find a Hell gate you can locate it using your trusty [&l&6Explorer's Compass&r]"
	]
	quest.7BC47CE51A87F8F3.quest_subtitle: "Find and enter &cHell gate"
	quest.7BC47CE51A87F8F3.title: "Visit &cHell"
	quest.7CFC85679666D54F.quest_subtitle: "Donate 100x Bronze coin to get 1x Silver coin"
	quest.7CFC85679666D54F.title: "Exchange &aBronze&r coins for &6Silver&r coin"
	quest.7D57EBAB3EDC12DF.quest_desc: [
		"High-tier farming requires rich soil layers to keep your crops growing at peak frequency."
		""
		"Gather organic composting debris and pack it tightly to create **Rich Soil** blocks."
		""
		"Crops planted on Rich Soil completely ignore light-level decay stalls, step through growth phases twice as fast, and can grow high-yield crops like Rice or Tomatoes effortlessly!"
	]
	quest.7D57EBAB3EDC12DF.title: "&bAgricultural Bio-Density"
	quest.7DDC6A4E82C9E861.quest_desc: [
		"[&6Receptionist&r] &bSunwyne&r:"
		""
		"\"Orcs were seen looking for food and resources around the forests far from their tribes, regular behavior, but their appearance is... weird to say the least.\""
		""
		"\"According to the legends, this might be prelude of a calamity. Investigate carefully\""
	]
	quest.7DDC6A4E82C9E861.quest_subtitle: "- Slay 5x Orc"
	quest.7DDC6A4E82C9E861.title: "&l&6The First Signs"
	quest.7EBB0394793B98EE.quest_subtitle: "- Slay 3x Black Spider"
	quest.7EBB0394793B98EE.title: "Black Spider"
	quest.7F30EE3B30387B17.quest_desc: [
		"Unshackle your movement across the landscape. The forces of gravity can be bent with the right ring configuration."
		""
		"Craft the **Iron Ring of Crucial Mobility** (for speed bursts) and upgrade your steps with the **Magnet Ring**."
		""
		"The Magnet Ring actively pulls loose drop entities straight to your position from blocks away, ensuring you never miss valuable monster materials in dense combat fields!"
	]
	quest.7F30EE3B30387B17.title: "&bKinetic Attunement"
	quest.7FD91C198E23E580.quest_desc: [
		"[&6Receptionist&r] &bSunwyne&r:"
		""
		"\"As usual, we have several reports of those pillagers causing problems around the villages and stealing from innocent.\""
		""
		"\"Drive them off and teach them a lesson.\""
	]
	quest.7FD91C198E23E580.quest_subtitle: "- Slay 5x Pillager"
