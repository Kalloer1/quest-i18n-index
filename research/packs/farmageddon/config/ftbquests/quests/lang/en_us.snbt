	quest.2728517166B6E3A3.title: "Shelter of Fortune"
	quest.28F004172D1B5012.quest_subtitle: "Enjoy your 10 minutes of free time"
	quest.2EEB5D5BF8BA2590.quest_desc: ["A refined mud enhanced with rare substances. Grants near-total invisibility, with only minor side effects"]
	quest.2FBABF029DCD1784.quest_desc: ["A collection of Gadgets to make building large structures a little bit easier!"]
	quest.344F7D7E7D781EC2.quest_subtitle: "80 RF/t"
	quest.361AD3B2063DF8F9.quest_desc: [
		"The climate has turned deadly. Four extreme weather threats now endanger you:"
		""
		"&oScorching Sun, Acid Rain, Violent Storms, &rand &oFreezing Winds&r — each harms you in its own way."
		""
		"Helmets block direct damage, sacrificing durability instead of your health."
		"Without protection, the elements will break you down fast."
		""
		"Stay equipped. Stay alive."
	]
	quest.361AD3B2063DF8F9.title: "Hostile Weather System"
	quest.39467BCC0364F3ED.quest_subtitle: "Revive the explosive spirit of the creeper"
	quest.3ACEF03C820697F8.title: "First Breath"
	quest.3C018F69792DA825.title: "Ender Cell"
	quest.41744E513D437FA6.quest_desc: [
		"The climate’s chaos has twisted life itself, creating mutant creatures that thrive in the devastation. Only you hold the key to the cure—the last chance to restore balance."
		""
		"It's best to leave some material between you and the outside; 2/3 might not be enough and remember to claim your chunks!"
		"&lTRUST ME&r"
	]
	quest.436866B89343CCDF.quest_desc: ["A fine layer of special mud cloaks you, making you nearly invisible to enemies for an extended time… with only a faint hint of nausea as a side effect"]
