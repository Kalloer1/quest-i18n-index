	quest.007545706B24A865.quest_desc: ["Um diamante infundido com energia dimensional shard, usado em receitas de tier elevado."]
	quest.0164BE242BA77DAD.quest_desc: ["A ferramenta multiuso definitiva feita da fusão de todas as ligas do AllTheModium. Totalmente inquebrável, com velocidades absurdas de mineração e combate."]
	quest.03C830083E544384.title: "Adv Connector"
	quest.0A807CCC60053286.quest_desc: [
		"Este é o Botany Pots basico com Hopper"
		"Adicione um Bau ou Barril em baixo para que ele saia automático "
		"Ele nao tem Buffer de velocidade, nem de multiplicador"
	]
	quest.105C7DF0FDC60149.quest_desc: [
		"Este é o Botany Pots Elite "
		"Ele tem Buffer de velocidade de 2"
		"E um Buffer de multiplicador de 2"
	]
	quest.11EC31EC5224DD4F.title: "Connector"
	quest.1D73259B2A3B1E2A.quest_desc: ["A fusão derradeira entre o Unobtainium e o Allthemodium. Esta liga é necessária para as partes mais complexas do Extreme Crafting do Avaritia."]
	quest.2168FD8194EE936F.quest_desc: ["O coração de um Piglich, encontrado apenas nas pirâmides ancestrais. Usado no craft de alloys avançados e no Infinity Catalyst."]
	quest.241C497E32CEE5F9.quest_desc: ["Liga fundindo as propriedades do Unobtainium e Vibranium. Um dos materiais mais nobres do jogo."]
	quest.24B942E59F15C12A.title: "Tornium Tools"
	quest.2785C707C01F968C.quest_desc: ["Compactação do Vibranium para fins de armazenamento de energia ou crafting avançado."]
	quest.30E9255DEC69C061.title: "Supremium Tools"
	quest.311DAD6FFDD72BC1.quest_desc: ["O Guia de Tecnologia contém informações úteis sobre como usar as máquinas e componentes do RFTools."]
	quest.311DAD6FFDD72BC1.title: "RFTools Manual"
	quest.39D9CDC37DCD22CD.title: "Network Cable"
	quest.3ADCDEB52BB4012B.quest_desc: ["Um dispositivo de teleporte portátil que permite que você retorne a um receptor de matéria sintonizado."]
	quest.3F29041291B4DC7F.quest_desc: ["Um mineral raro e poderoso usado para aprimorar e energizar dispositivos do RFTools."]
	quest.4A7AADAC9D98FDC9.title: "Lightium Tools"
	quest.4DBA0A03A065F06B.quest_desc: ["O terceiro e mais raro minério premium do AllTheModium, encontrado nas profundezas da dimensão do Fim (End) ou do End Mining Dimension. Emite uma aura mística azulada."]
	quest.4DE43F9C9AD644B9.quest_desc: ["A base fundamental para todas as máquinas do RFTools."]
	quest.4E485C18BBDDD6D1.quest_desc: ["Uma liga metálica combinando o Vibranium e o Allthemodium, produzida em reatores ou forjas de alta pressão. Usada nas receitas das mesas do Avaritia."]
	quest.513BE3C4C5CB901D.quest_desc: [
		"Este é o Botany Pots basico"
		"Ele nao tem Buffer de velocidade, nem de multiplicador"
	]
	quest.5718F92C9E488287.quest_desc: ["A ferramenta multiuso definitiva para configurar conexões do RFTools."]
	quest.582B7E7385B01122.quest_desc: ["O Teleport Pad é o portal de entrada para a dimensão de mineração do AllTheModium (Mining Dimension). Use-o no Overworld clicando com o botão direito enquanto segura um item apropriado para ser teletransportado!"]
	quest.582B7E7385B01122.title: "Mining Dimension Portal"
	quest.5A3A178715620A59.quest_desc: ["Auto-crafting rápido e automatizado para o início de sua automação de fábrica."]
	quest.5A77DEAFEC4BD706.quest_desc: ["O primeiro minério premium. Pode ser encontrado na dimensão de mineração (Mining Dimension) ou minerado de outras maneiras tardias no jogo."]
	quest.5B1E0E3E876339E7.title: "Supremium Armor"
	quest.5F20A8A3FFF4A68F.quest_desc: ["Define a forma 3D que o Builder usará para minerar ou construir."]
	quest.5FF1D4C229DE5AC6.quest_desc: ["O segundo minério premium, encontrado principalmente no Nether (dentro da dimensão do Nether ou na Nether Mining Dimension). É altamente resistente e brilhante."]
	quest.61C8377099CA1CC2.quest_desc: ["Permite infundir dimensional shards em suas máquinas para melhorar a eficiência de energia e velocidade."]
	quest.6419007D77DDA647.quest_desc: ["A forma compactada em bloco do Allthemodium, usada para receitas de estruturas e teleportadores mais avançados."]
	quest.65D3B10DD1ED8384.quest_desc: ["A versão avançada do charged porter, capaz de armazenar múltiplos destinos e com maior capacidade de energia."]
	quest.6620322836B6BFFB.title: "Lightium Armos"
	quest.679C9E7BCFF54DEF.quest_desc: ["Uma versão melhorada que permite armazenar mais receitas de craft simultâneas."]
	quest.6EBB80C614FC2604.quest_desc: ["O nível máximo de crafter automático, extremamente rápido e com capacidade total de receitas."]
	quest.6F707426983ED57B.quest_desc: ["A infraestrutura para criar uma rede de teletransporte sem fio interdimensional."]
	quest.6F707426983ED57B.title: "Network Teleportation"
	quest.73F29E9E4FA2FC59.quest_desc: ["O bloco de Unobtainium, usado para criar receptores interdimensionais de energia e receitas endgame do Avaritia."]
	quest.748854F85517A1B3.title: "Tornium Armos"
	quest.750D484E09D949C3.quest_desc: ["O chassi necessário para criar a maior parte dos dispositivos tecnológicos avançados."]
	quest.7CD4BCB31C394CE6.quest_desc: ["Permite que o Builder atue como uma pedreira (quarry) automática, minerando blocos à distância."]
	quest.7DFD73DD8C8850A9.title: "Ornium Armos"
	quest.7E3A3FA7C56E551A.quest_desc: ["Um dispositivo multiuso massivo que pode minerar, construir, bombear líquidos ou destruir blocos em uma área configurada."]
