	file.0000000000000001.title: "Dungeons and Shuttles: Evolution"
	quest.000193AA8BF1C635.quest_desc: ["Smelt Electrotine Iron Compound to obtain Electrotine Alloy Ingots."]
	quest.001C93E964AF3BF5.quest_desc: ["And so much more stuff..."]
	quest.001C93E964AF3BF5.title: "Infinity Drill #2"
	quest.0023FC148D6EA670.quest_desc: ["The Hopper automatically moves items between containers. It pulls items from above and transfers them to the inventory below, making automation simple and efficient."]
	quest.005756454C330F88.quest_desc: ["The Battery Box is a great way to store your power. However, for it to be able to use power, you have to right-click a Battery onto it. It will then be able to store energy on the battery itself."]
	quest.0072F08C927B5DD5.quest_desc: [
		"the Wyvern Chestpiece provides very little utility on its own. Think of it as a high-tech chassis that requires careful configuration and upgrades to reach its full potential."
		""
		"&aConfiguration: You must access the Draconic Evolution HUD (Default key: Shift+A) to adjust your armor's settings."
		""
		"&aPower: This suit is useless without energy. Ensure it is fully charged before heading into combat."
		""
		"&aUpgrades: To unlock features like flight, shields, or speed, you must install Upgrade Modules via Fusion Crafting."
		""
		"Don’t worry about the modules yet; you will learn to craft these advanced upgrades as you progress further through the questline."
	]
	quest.007890EE1CA8101A.quest_desc: ["This is a simple Item. Used in some recipes."]
	quest.009E64FECB66DFAB.quest_desc: ["The Cauldron holds water, lava, or powdered snow. It can be used for filling bottles, dyeing items, or collecting rainwater."]
	quest.00A391B6572BB5B0.quest_desc: [
		"The Casting Table is used with a Foundry to create metal tools, ingots, and other metal-based items. It must be placed under a Foundry Tap to function."
		""
		"The Casting Basin is also part of the Foundry and is used to form blocks from molten materials. Like the Casting Table, it requires a Foundry Tap connection."
	]
	quest.00A391B6572BB5B0.title: "          Casting Table \\& Basin          "
	quest.00CBC7C5A2861B93.quest_desc: ["Craft a few Photovoltaic Composite."]
	quest.00CBC7C5A2861B93.title: "Photovoltaic Composite"
	quest.00D03EE4E38712F9.quest_desc: ["Improves machine efficiency beyond Inferium."]
	quest.00D7E7C191553DA6.quest_desc: ["Combine 2 Carbon Fibres in a crafting grid to obtain Carbon Mesh."]
	quest.00D7E7C191553DA6.title: "Carbon Mesh"
	quest.00DC277004D44508.quest_desc: ["This material has Allthemodium-level mining power and can break through any ore found in Minecraft!"]
	quest.00E6AB4395F9B8E9.quest_desc: [
		"A rare ore found in the End. Mine it with a Neptunium tier or better to unlock powerful crafting options."
		""
		"&a💡 Hint: This ore can be found in the End but not on the main island. You'll need to explore the outer End islands to locate it."
	]
	quest.00E6AB4395F9B8E9.title: "       Allthemodium Ore!       "
	quest.014566455020269D.quest_desc: ["The Ultimate Stew is mainly used to create the Infinity Catalyst."]
	quest.01756E8D47642D5C.quest_desc: [
		"The Normal Rocket Model is required in order to reach the Mercury."
		""
		"&cYou’ll need to bring another Rocket Launch Pad with you for the return trip."
	]
	quest.0188394757EF0000.quest_desc: ["Craft a Copper Chestplate."]
	quest.01930B5305950769.quest_desc: [
		"Deep within the Infernal Venus Barrens, a legendary material awaits: Vibranium. This is a cornerstone of high-end engineering and a key component for the coveted Unobtainium-Vibranium Alloy (refer to Ores and Alloys Tier 2 for details)."
		""
		"Vital Instruction: You must gather a significant amount of Venus Sand during your expedition. Without it, the refining process for Vibranium is impossible."
		""
		"&a💡 Hint: Found between layers Y=-64 and Y=29."
		""
		"&aBiomes: Exclusively in Infernal Venus Barrens."
	]
	quest.01930B5305950769.title: "Vibranium Ore!"
	quest.01A0A6123E82A0BB.quest_desc: ["Craft a few Alumite Seeds."]
	quest.01A0A6123E82A0BB.title: "Alumite Seeds"
	quest.01C1F7F239DB3D14.quest_desc: ["Ok, let's go on with... Ginger!"]
	quest.01C1F7F239DB3D14.title: "Ginger"
	quest.01D66AF2EB888814.quest_desc: ["Used to prepare delicious meals. Most recipes require a Bowl or sometimes a Glass Bottle. Make sure to place a heat source, like fire, beneath it!"]
	quest.01E91ECCCF46DDDF.quest_desc: [
		"The surface is a monochromatic wasteland, dominated by vast craters and towering, jagged mountains of gray rock. It is a world of extremes, baked by the sun and frozen in the shadows."
		""
		"Beneath this desolate exterior lies a complex network of caves. These depths are rich in Iron and Uranium. Tread carefully the terrain is as unforgiving as the radiation."
	]
	quest.01FA4C31E3FED61F.quest_desc: ["A bowl from Dark Power Gem? :) Whatever, craft a Bowl of Empty Promises."]
	quest.020D6B268FA35118.quest_desc: ["After harvesting a fully grown plant of Emerald Seeds, you get Emerald Essences."]
	quest.020D6B268FA35118.title: "Emerald Essence"
	quest.020E2194F25648F8.quest_desc: ["Now that you're generating RF, you'll need a way to store it efficiently. The Energy Cube is the perfect solution! It can hold large amounts of energy and distribute it to machines when needed."]
	quest.023891A8B88EBAAA.quest_desc: ["The Solar panel T9 is dope. You build two at once. It is used to generate 8.388.608 RF/FE/t when receiving light! "]
	quest.023891A8B88EBAAA.title: "Neutronium Solar Panel!"
	quest.023CF9D36D2E9BAA.quest_desc: ["Buy some reward!"]
	quest.023CF9D36D2E9BAA.title: "Llama Spawn Egg"
	quest.025257E7CCBAB7A7.quest_desc: [
		"To advance further in this questline, you must reach the required stages of planetary exploration. Progression is currently locked behind two key milestones:"
		" - Venus"
		" - Mars"
		""
		"If you are stuck, please consult the Main Questline to ensure your space program is up to speed. Don't fall behind!"
	]
	quest.0267217DF3E51D7B.quest_desc: ["With your Blood Extractor, you can place liquid blood into the world. If it remains uncovered from rain, it will eventually harden into Hardened Blood. When broken with Flint and Steel, these blocks drop Hardened Blood Shards. However, if rain falls on them, they will turn back into liquid blood."]
	quest.0267217DF3E51D7B.title: "Hardened Blood Shard"
	quest.02D6E4C31CD2F560.quest_desc: ["With Mystical Agriculture, you can plant and grow almost any material you need. Start small with Inferium and work your way up to powerful essence-based crops!"]
	quest.02D6E4C31CD2F560.title: "&eMore Inferium!"
	quest.030797D416F60C06.quest_desc: ["Obsidian TNT is reinforced with obsidian for strength. Make one of these too."]
	quest.0324642571A1789A.quest_desc: [
		"Before we can start with Power generation, we need a little bit of Redstone."
		""
		"&a💡 Hint: If you haven't found an Iron Pickaxe somewhere, you should unlock the Blacksmith's Workshop to craft one."
	]
	quest.0324642571A1789A.title: "A little bit of Redstone"
	quest.036743802C8BD34C.quest_desc: ["Craft a few Titanium Seeds."]
	quest.036743802C8BD34C.title: "Titanium Seeds"
	quest.03BDB210A37C8D97.quest_desc: ["Collect Endstones and crush them down."]
	quest.03BDB210A37C8D97.title: "Endstone Dust"
	quest.03F46F1FAA0227BF.quest_desc: [
		"Before you can get Creosote Oil, you need to build a Coke Oven."
		"To do this, you need to collect a lot of Clay, Sandstone and Black Iron."
	]
	quest.03F46F1FAA0227BF.title: "Clay and Sandstone"
	quest.03FE8A5433FE7D23.quest_desc: ["Buy some reward!"]
	quest.03FE8A5433FE7D23.title: "Basic Processor"
	quest.042E04609ACB2241.quest_desc: ["Use Stone Essence to craft minecraft Stone."]
	quest.042E04609ACB2241.title: "Stone"
	quest.048E8FBA0CBED3F9.quest_desc: ["Ok, let's go on with... Peanut!"]
	quest.048E8FBA0CBED3F9.title: "Peanut"
	quest.049ADD31B6CE482B.quest_desc: ["Nichrome Heating Coils are used to upgrade the machine parts of the Industrial Blast Furnace and to increase the heat level."]
	quest.049ADD31B6CE482B.title: "Nichrome Heating Coils"
	quest.04E4E67C1B7A6A09.quest_desc: ["Make a handful of 2x Compressed Stone."]
	quest.04E4E67C1B7A6A09.title: "Compressed Stone!"
	quest.050EDDAA314628FD.quest_desc: ["Bauxite in its pulverized form is the primary source of Aluminium and Titanium."]
	quest.050EDDAA314628FD.title: "Bauxite Dust"
	quest.0510C2D1854928E3.title: "Coleslaw"
	quest.0524D1856ADDA429.quest_desc: ["These Catalysts can be added as pillar toppers to your Natural Altar. They allow you to turn more items into other items or to break them down."]
	quest.05397E1FD46DDCE2.quest_desc: ["Tungstensteel is a high-grade alloy that requires significant effort to produce. The process begins in the Blast Furnace, where you must first create Hot Tungstensteel before it can be further processed into usable ingots."]
	quest.05397E1FD46DDCE2.title: "Hot Tungstensteel Ingot!"
	quest.053A581857A31DEF.quest_desc: ["Cryotheum Dust is mainly used to create Cyrofluid. It is also used to create various upgrades."]
	quest.053A581857A31DEF.title: "Cryonite Powder"
	quest.054482C75729FF2E.quest_desc: ["Uranium Ore generates deep underground and is used primarily for advanced energy production in Reactor."]
	quest.054482C75729FF2E.title: "Uranium"
	quest.054700A39C380E1A.quest_desc: ["The Metallurgic Infuser is a key machine from Mekanism, used to combine different substances through infusion."]
	quest.054700A39C380E1A.quest_subtitle: "&9Unlock: &6&lMain Questline - Tier II."
	quest.054700A39C380E1A.title: "&9Metallurgic Infuser"
	quest.056A9A259715E0F0.quest_desc: ["Next Upgrade!"]
	quest.058C06883531483E.quest_desc: ["The Potentiometer is a unique machine to customize a redstone signal. You can customize the signal that it will emit by right-clicking for a higher signal and shift-right-clicking for a lower one."]
	quest.05A985A8368074D4.quest_desc: [
		"Used to craft Tier 3 essence seeds."
		"It cannot be planted and is only used as a crafting component for higher-tier crops."
	]
	quest.05A985A8368074D4.quest_subtitle: "Crafting Seeds"
	quest.05FC92D8EEDBC0D5.quest_desc: [
		"By now, you probably have quite a few guidebooks filling up your inventory. The Akashic Tome allows you to combine all those books into one single, tidy tome."
		"If you ever want to reset it, just left-click the air and it will revert to its default form — ready to absorb new books again."
	]
	quest.061AC68D5ACAE027.quest_desc: [
		"A mystical crafting station for arcane tools and enchanted artifacts."
		"The Alchemist’s Workshop allows recipes that involve magical components and essences."
		""
		"Inspired by the Artisan Worktables mod and brought to life using Custom Machinery."
	]
	quest.0623B37BF441D374.quest_desc: ["Insanium Coal burns for a long time! 48x longer than normal Coal!"]
	quest.0623B37BF441D374.title: "Insanium Coal"
	quest.062F22C0C9CB8750.quest_desc: [
		"With a Glass Bottle, Fluorite, some kind of flower and water you can get the Magic Compound."
		"It can be used for different recipes."
	]
	quest.062F22C0C9CB8750.title: "Magic Compound"
	quest.065CEBEC850A2ACE.quest_desc: [
		"To upgrade the Forge to Tier 3, use 4 Deorum Ingots, 4 Arcane Crystals, and a White Magic Dust."
		""
		"This enhancement expands the Forge’s capabilities — allowing it to store more Essences, use additional Relics, and perform a wider range of Rituals."
		""
		"&a💡 Hint: Use a Gavel to activate the process."
	]
	quest.065CEBEC850A2ACE.title: "     &eUpgrading the Forge to Tier III.     "
	quest.0661ABFE71D35596.quest_desc: ["The Large Heat Exchanger is used to transfer heat between fluids — essential for high-efficiency power setups. You can use it to turn superheated steam into clean water or perform complex cooling tasks in large industrial systems."]
	quest.0696B07713F09EE6.quest_desc: ["Peridot is a gem added by Tech Reborn mods. Collect more of it!"]
	quest.0696B07713F09EE6.title: "Peridot!"
	quest.06B7900BE1B55159.quest_desc: ["Buy some reward!"]
	quest.06B7900BE1B55159.title: "Blaze Rods"
	quest.06C491E61A776CB2.quest_desc: ["Use an saw to break down wooden planks into useful sticks."]
	quest.06C491E61A776CB2.quest_subtitle: "Efficient Crafting #2!"
	quest.06C491E61A776CB2.title: "Sitcks"
	quest.07013189B90DA033.quest_desc: ["Buy some reward!"]
	quest.07013189B90DA033.title: "Villager Spawn Egg"
	quest.076A91E19097A19F.quest_desc: ["Forged from the pressure and magic of the ocean's darkest trenches, this rare ingot is key to crafting powerful underwater artifacts and deep-tier magical components."]
	quest.076A91E19097A19F.title: "Ingot of the Depths"
	quest.077DDD5FF3549EEC.quest_desc: ["Electrum is your next alloy. You can get it by combining Silver and Gold Ingots in Foundry or later in Alloy Smelter and in Advanced Alloy Smelting Factory."]
	quest.077DDD5FF3549EEC.title: "Electrum Ingots"
	quest.07832A55ACB95747.quest_desc: ["To extract Methane Gas from your machine easily, you need Pipes and Servo. You can put the Servo on the end of the pipe it works like a pump."]
	quest.07A3B69F12A28F9E.quest_desc: ["The Solar Panel VI generate 2048 RF/FE/t when receiving light."]
	quest.07A6D9D70306994F.quest_desc: ["The Natural Altar is a multiblock structure made from 1 Natural Altar, 8 Golden Stone Bricks, 16 Stone Bricks, 20 Planks and 4 Chiseled Stone Bricks. The Natural Altar at Nature's Aura is indispensable."]
	quest.07A6D9D70306994F.title: "               Infusion Altar               "
	quest.07B025951F4A0923.quest_desc: [
		"Thermoelectric Generator use the temperature gradient beetween two opposing sources to produce power."
		"For example, Ice and Lava togheter will generate 16 Energy/t."
	]
	quest.07D029A7E6205246.quest_desc: ["A tangy and spicy condiment, made from mustard seeds."]
	quest.07D029A7E6205246.title: "Mustard"
	quest.07D742AEC841CB2C.quest_desc: [
		"The Wood to Iron Chest Upgrade is used to turn wooden Chests into Iron Chests."
		""
		"The Chest can be upgraded by right clicking it with the item. The Chest's inventory will be retained."
	]
	quest.07FBEAF981131CD0.quest_desc: ["Iron Infused Essences can be used to craft Iron Infused Ingot."]
	quest.07FBEAF981131CD0.title: "Infused Iron Ingots"
	quest.080AEA872120C779.quest_desc: ["The Reinforced Alloy is used in the crafting of several devices and is required for the production of Atomic Alloy. It is created by infusing Enriched Alloy with Diamond in a Metallurgic Infuser."]
	quest.081DECF95184F3D2.quest_desc: ["Iron Hook is faster than the previous generation, so get it done."]
	quest.081DECF95184F3D2.title: "Next Generation, Hooks"
	quest.083DB11C8E31D4A3.quest_desc: [
		"Put Chrome Dust in the Industrial Blast Furnace to obtain Chrome Ingots."
		""
		"&aRequire Heat: 1700Heat"
	]
	quest.083DB11C8E31D4A3.title: "Chromium Ingot"
	quest.084BDFE5F97EC187.quest_desc: ["Buy some reward!"]
	quest.084BDFE5F97EC187.title: "Tertium Apple"
	quest.084C4ECB37636EB9.quest_desc: [
		"The Heat Collector is a block that produces RF/t."
		"To do that, it needs to be surrounded with at least Lava Blocks directly around it on any side except the top one. But watch out, it sometimes destroys some of these Lava Blocks!"
	]
	quest.0855806FFABE8ED4.quest_desc: ["You can obtain Undead Log by cutting down an Undead Sapling once it has grown. Its leaves slowly drip blood, giving it an eerie appearance."]
	quest.0855806FFABE8ED4.title: "Undead Woods"
	quest.085EAC8E5BA4CDE1.quest_desc: [
		"A rare and valuable metal."
		"Platinum is used in advanced crafting recipes and high-tier machinery—make sure to hold onto it!"
	]
	quest.085EAC8E5BA4CDE1.title: "Platinum Ingots"
	quest.08641043819B57EA.quest_desc: ["The Ingot Cast is one of the most used cast in Productive Metalworks. It is used to get metals and fluids out of a foundry in form of an ingot."]
	quest.0865BAE28197B766.quest_desc: [
		"Unlike the earlier bombs, TNT is unstable and powerful."
		"Handle with care: this is the first truly destructive device in your arsenal."
		""
		"From mining to demolition, TNT brings explosive possibilities."
	]
	quest.0865BAE28197B766.title: "TNT!"
	quest.0874CE65053962C0.quest_desc: ["Make a handful of Compressed Obsidian."]
	quest.0874CE65053962C0.title: "Compressed Obsidian!"
	quest.0891665E2C34E7FF.quest_desc: ["Mixed Metal Ingot added by TechReborn, this ingot is used to craft Advanced Alloy."]
	quest.0891665E2C34E7FF.title: "Mixed Metal Ingots"
	quest.08B0C68E2758A758.quest_desc: ["You can never have enough basic resources."]
	quest.08B0C68E2758A758.title: "Magic Utensils #2"
	quest.08B1A7DA340385D5.quest_desc: ["The Storage Module is used in various recipes."]
	quest.08EF62890090F83D.quest_desc: ["The Wyvern Energy Core is used to craft most Wyvern Tier tools and armor."]
	quest.08FF7340998393D5.quest_desc: ["Craft a few Quartz Enriched Copper Seeds."]
	quest.092A12DB8A63518F.quest_desc: ["Obsidian Essences can only be used to craft Obsidian."]
	quest.092A12DB8A63518F.title: "Obsidian"
	quest.09337A71CDB1E031.quest_desc: ["The Water Wheel generates RF power when placed next to flowing water. Connect it to a Kinetic Dynamo to start producing energy!"]
	quest.0943989941CA2B7D.quest_desc: ["To make Lumium, you need Silver, Tin Ingots and Glowstone Dusts. You can smelt it in your Foundry."]
	quest.0943989941CA2B7D.title: "Lumium"
	quest.0965C857E0B03AF8.quest_desc: ["The Iron Promise Acceptor serves as a key component in various machine upgrade recipes."]
	quest.0985EE3CB2922FA5.quest_desc: ["The Engineer’s Manual is your best guide when starting with Immersive Engineering. It provides complete in-game instructions on assembling machines and understanding their functions. Keep it handy as you build your industrial setups!"]
	quest.0985EE3CB2922FA5.title: "     The Engineer's Manual     "
	quest.09878AA453588C7F.quest_desc: [
		"Used to grow Mystical Agriculture crops."
		"It increases essence yield and is required for planting essence-based seeds."
	]
	quest.09878AA453588C7F.title: "Inferium Farmland?"
	quest.09AA47A0079B3666.quest_desc: ["Certus Quartz Crystal can be obtained by mining Certus Quartz Ore. This item is used in the majority of crafting recipes in AE2, such as Energy Cells and Formation Cores."]
	quest.09AA47A0079B3666.title: "Certus Quartz!"
	quest.09FA3C3F00D14C33.quest_desc: [
		"The Bio Reactor uses all types of seeds, foodstuffs and plants to generate Energy!"
		"To do this, just place the items in its GUI. If you try this out, you will notice that it doesn't generate that much power by default. However, the more different kinds of plants, seeds and foodstuffs it has, the more power it will generate!"
	]
	quest.09FA3C3F00D14C33.quest_subtitle: "Seeds to Energy"
	quest.0A11C2261A48A88E.quest_desc: ["These are the more advanced components that will power the hardened version. Craft them carefully — precision matters!"]
	quest.0A11C2261A48A88E.title: "Jetpack Components #2.2"
	quest.0A4A74B1285BBC4B.quest_desc: [
		"The Blood Infuser is a specialized machine that uses liquid blood to infuse certain items, enhancing or transforming them. To use it, fill the infuser with liquid blood by inserting a Blood Extractor containing blood. "
		"Place the item you want to infuse in the input slot, and let the machine do its work!"
	]
	quest.0A6AEA6C7D8710BF.quest_desc: ["A juicy and flavorful meat snack, perfect as a hearty side or a quick bite on the go."]
	quest.0A6AEA6C7D8710BF.title: "Sausage"
	quest.0A97C17A7A0C0A37.quest_desc: ["Next is the Sandy Coal Compound."]
	quest.0A97C17A7A0C0A37.title: "Obtain materials for Silicon #2"
	quest.0A9ACBE108628C00.quest_desc: [
		"Nature's Aura&r is a magic mod. To start, make Brilliant Fiber, which is made from Gold Ingots, Leaves and Bark."
		"Right-clicking on any leaves with Brilliant Fiber will turn them into Golden Leaves. You will need a lot of Gold."
		""
		"&a💡 Hint: If you get stuck, use the Book of Natural Aura."
	]
	quest.0A9ACBE108628C00.title: "               Nature's Aura               "
	quest.0AA1030F374E1683.quest_desc: ["Buy some reward!"]
	quest.0AA1030F374E1683.title: "Beetroot Seeds"
	quest.0AA21F588ACFD92E.quest_desc: ["Apples are an essential food, let's turn them into apple trees!"]
	quest.0AA21F588ACFD92E.title: "Find Apple Tree"
	quest.0AB52C97D77FF757.quest_desc: [
		"Compressed Cobblestones are used in various recipes. "
		"Craft a few of them."
	]
	quest.0AB52C97D77FF757.title: "Compressed Coblestone"
	quest.0ACC66FB98D64979.quest_desc: ["Ok, let's go on with... Mushrooms!"]
	quest.0ACC66FB98D64979.title: "Mushrooms"
	quest.0AEBAE588F73818D.quest_desc: ["Find Immersive Houses in the village and there will be Storage Crate."]
	quest.0AEBAE588F73818D.title: "Wooden Storage Crate"
	quest.0B0ACF4E41EDB3DA.quest_desc: ["Build the Ultimate Crafting Table!"]
	quest.0B231E09F697DA8A.quest_desc: [
		"The Food Book, added by Spice of Life: Carrot Edition, tracks all the foods you’ve eaten. Use it to monitor your dietary variety and gain bonuses for trying new foods. Simply open the book to view your food history and maximize your health benefits!"
		""
		"&9Upon completion of this quest you will unlock the chapter: &o\"Kitchen Workshop\""
	]
	quest.0B231E09F697DA8A.title: "     &9Unlock: &6&lKitchen Workshop     "
	quest.0B2C94B53180817B.quest_desc: ["Craft a Dragon Egg Seed!"]
	quest.0B3D76EAEB7232AF.title: "Shulker Hunter"
	quest.0B6F1990D1C96157.quest_desc: ["And finally Arrow of Posion, a very effective method of wounding."]
	quest.0B6F1990D1C96157.title: "Poison Arrows!"
	quest.0B7212971AC902DF.title: "Skeleton Hunter"
	quest.0B726A2358FE009C.quest_desc: [
		"While exploring the depths of the Martian crust, you will encounter Desh Ore. Once extracted, it yields Raw Desh, a versatile metal that serves as the backbone for mid-to-late game progression. It is an essential ingredient for specialized tools, heavy-duty machinery, and reinforced armor sets."
		""
		"&a💡 Hint: Spawns between layers Y=-64 and Y=80."
	]
	quest.0B726A2358FE009C.title: "Desh Ore!"
	quest.0B94C7C7F20916D5.quest_desc: ["Ok, let's go on with... Cucumber!"]
	quest.0B94C7C7F20916D5.title: "Cucumber"
	quest.0B9FBC7A9C63848C.quest_desc: [
		"Collect over 20 different seeds and vegetables! This will be one of the biggest and longest adventures in your garden. It's a great way to explore different types of food and expand your harvest."
		""
		"Let’s start with Tomatoes!"
	]
	quest.0B9FBC7A9C63848C.title: "Tomatos"
	quest.0BA233A7A38F9253.quest_desc: ["Faster growth, larger range—your crops will love it."]
	quest.0BA4A9A6FA7227D4.quest_desc: ["Singularities are highly compressed materials. A singularity requires 2300 items of the same type."]
	quest.0BBC952CFECB64FD.quest_desc: ["Search for Sugar Canes. "]
	quest.0BBC952CFECB64FD.title: "Sugar Canes"
	quest.0BF0F5EBDEC9953B.quest_desc: ["The game's most popular food. Gather some."]
	quest.0BF0F5EBDEC9953B.title: "Potatoes"
	quest.0C20F61E5A4E1292.quest_desc: ["Solar Flux Reborn adds 10 different tiers of solar panels that generates FE or RF. The First Panel generates 1 RF/FE and is very inexpensive to craft. Place it in direct sunlight."]
	quest.0C20F61E5A4E1292.title: "The Power of the Sun!"
	quest.0C2B434830EFCA91.quest_desc: ["You got a very valuable Shulker Box. Time to upgrade it too! You don't need iron plates for that."]
	quest.0C2B434830EFCA91.title: "Shulker Box Upgrade"
	quest.0C543F862B79BB7E.quest_desc: ["Ok, let's go on with... Celery!"]
	quest.0C543F862B79BB7E.title: "Celery"
	quest.0C68BC6B1161545B.quest_desc: ["Buy some reward!"]
	quest.0C68BC6B1161545B.title: "Loot Bags"
	quest.0C70A34A07C3F755.quest_desc: ["Draconium Blocks infused with the power of the ancients."]
	quest.0C70A34A07C3F755.title: "Ancient Draconium Block"
	quest.0CAD1BF272D131F0.quest_desc: ["After harvesting a fully grown plant of Netherite Seeds, you get Netherite Essences."]
	quest.0CAD1BF272D131F0.title: "Netherite Essence"
	quest.0CC09702DF798EFE.quest_desc: ["Neutronium Essences can be used to craft Neutronium Ingots."]
	quest.0CC09702DF798EFE.title: "Neutronium Ingots"
	quest.0CC11B48347EA923.quest_desc: ["The Gold Upgrade Increases 8 times the base storage value!"]
	quest.0CC7A2DB7DF9A4E1.quest_desc: ["Mid-tier upgrade for faster and more productive machines."]
	quest.0D02A3E88FDB9712.quest_desc: ["Put 200 mb Oxygen, 200 mb Water, and 1 Sulfur Dust into the Chemical Reactor to get Sulfuric Acid."]
	quest.0D02A3E88FDB9712.title: "Sulfuric Acid #5"
	quest.0D0F913CF887F556.title: "Zoglin Hunter"
	quest.0D19D5C031C09611.quest_desc: [
		"Deep within the wilderness, an ancient and mystical tree grows—the Menril Tree. Its deep blue wood and precious resin hold unique properties, making it a sought-after resource for engineers and mages alike. Some say its essence resonates with powerful energies, while others use it to create advanced machinery and automation."
		"Just kidding :) The Menril Tree spawns occasionally in the Overworld, it's easy to spot."
	]
	quest.0D19D5C031C09611.title: "Menril Trees"
	quest.0D312DCB19EBECD3.quest_desc: ["This bomb is actually as powerful as a Bunch Of TNTs."]
	quest.0D4835F573D720E4.quest_desc: [
		"The Quantum Circuit is the foundation of Tier IV technology."
		"Crafting it will unlock access to powerful late-game machines and advanced systems."
	]
	quest.0D4835F573D720E4.title: "&eQuantum Circuit"
	quest.0DD93ED868C08F29.quest_desc: ["Inspired by the Artisan Worktables mod and brought to life using Custom Machinery."]
	quest.0DDD5DEB365A5387.quest_desc: [
		"Now you need to craft a Tree Tap. Once you have acquired one you can begin to look for a Rubber tree. "
		"They are distinctive as they have a spike of leaves at the top. "
		"They usually spawn in clumps. Don't forget to collect also a few Rubber saplings."
	]
	quest.0DDD5DEB365A5387.title: "Rubber"
	quest.0E307EA0FD478F01.quest_desc: ["Use an Alloy Furnace of your choice to combine White and Black Magic Dust to Ultimate Dust."]
	quest.0E307EA0FD478F01.title: "The Ultimate Dust!"
	quest.0E4184F65870FE89.quest_desc: ["Copper is abundant and has plenty of uses. The very first ingot in the whole game! "]
	quest.0E4184F65870FE89.title: "Basic &dMetals #1"
	quest.0E72C60B6B76AB93.quest_desc: ["Cobalt Ore generates in the Nether and has a distinct bluish color. Look for it in deeper regions."]
	quest.0E72C60B6B76AB93.title: "Cobalt"
	quest.0E74EA2EF2094963.quest_desc: ["Combine the Dark Gem with the Apple in a Craftingtable to get the Darkened Apple also get a book."]
	quest.0E7E271191AC8F63.quest_desc: ["The Gold Chest offers more storage space than the Iron Chest, making it easier to organize and store your items efficiently."]
	quest.0E89142797FB48C5.quest_desc: ["Fry some potatoes."]
	quest.0E89142797FB48C5.title: "Fry Potatos"
	quest.0E8CBAFCAE2D19B5.quest_desc: [
		"The Fuel Reginery is very important. It allow you to create fuel."
		""
		"To create Fuel, you need to input oil in the fisrt slot and it will generate fuel that you can get by putting a bucket in the last slot."
	]
	quest.0EA6D018E75E1D3D.quest_desc: ["Buy some reward!"]
	quest.0EA6D018E75E1D3D.title: "Diamond Apple"
	quest.0EAB809C1BC2C0D1.title: "Evoker Hunter"
	quest.0ED7FEE968B67D41.quest_desc: ["The Extreme Crafting Table functions as a 9x9 slot version of the Crafting Table which is used for special Avaritia items."]
	quest.0EDAA72C9EC0A900.quest_desc: ["Intermedeium Coal burns for a long time! 6x longer than normal Coal!"]
	quest.0EDAA72C9EC0A900.title: "Tertium Coal"
	quest.0EE3B6B1FF9B3AD2.quest_desc: ["This compact machine allows you to transfer heat between fluids efficiently."]
	quest.0EECF65E4444C73B.quest_desc: ["Craft a Saucepan."]
	quest.0EEF3149F84894FD.quest_desc: ["Converts power into ores, with a given weight, between a minimum and maximum Y value, in any whitelisted biome or not in any blacklisted biome, and with a specific color of laser lens impacting the probability."]
	quest.0EEF3149F84894FD.title: "Laser Drills"
	quest.0F238349CD2072A3.quest_desc: [
		"The Electric Blast Furnace is a multiblock machine used to smelt hard metals."
		"It has different tiers, such as Cupronickel or Kanthal, which determine its efficiency and capabilities."
		""
		"&a💡 Hint: When holding the MI Wrench near a placed machine, it will show you the multiblock structure and how to assemble it."
	]
	quest.0F37A60D1E46F720.quest_desc: ["After harvesting a fully grown plant of Ruby Seeds, you get Ruby Essences."]
	quest.0F37A60D1E46F720.title: "Ruby Essence"
	quest.0F5575DD32734A1C.quest_desc: ["The Advanced Energy Cube stores 3.200.000 RF/FE and can be upgraded to the Elite Energy Cube."]
	quest.0F5575DD32734A1C.title: "Advanced Energy Cube!"
	quest.0FA49A01E9CD172F.quest_desc: [
		"Depending on which machine you put the turf dust in, something specific will come out. We first use the Centrifuge [Modern Industrialization] to produce Small Pile of Grossular Dust. Then convert it to regular Grossular Dust. "
		""
		"&a💡 Hint: This process produces additional lubricant which soon becomes very important."
	]
	quest.0FA49A01E9CD172F.title: "Grossular"
	quest.0FB89F26C769F9C3.quest_desc: ["First of all you need Basic Crafting Seeds."]
	quest.0FB89F26C769F9C3.title: "Base Crafting Seed"
	quest.0FD9CCDA62521F4C.quest_desc: ["Electrotine Dust requires Redstone, Sawdust and Copper Grit."]
	quest.0FD9CCDA62521F4C.title: "First step for the Electrotine!"
	quest.1005FADB2D5A6498.quest_desc: ["To prevent your machines from overheating, you need Coolant Cells. Crafting a 10k Coolant Cell requires Snow and Water Cells."]
	quest.1005FADB2D5A6498.title: "Coolant Cells"
	quest.1019E51BF1CD3088.quest_desc: ["Use the Rolling Machine to craft a bunch of Large Plates."]
	quest.1019E51BF1CD3088.title: "Large Plates!"
	quest.102DED6C669F67B9.quest_desc: [
		"The Information Table is an in-game book which explains the different items of the mod."
		""
		"&cIs not working!"
	]
	quest.104D37662F28404F.quest_desc: ["Craft a few Netherite Seeds."]
	quest.106AD2A3E66A0BC1.quest_desc: ["Ender Chest share their items with other chests that have the same color combination on top. Right-click the 3 color buttons with dyes to set the code. Perfect for cross-dimensional item transport!"]
	quest.108CAB48687CD991.quest_desc: ["I know, it might seem strange to gather flowers in this chapter, but trust me, they will prove to be invaluable later on. Sometimes, the simplest things hold the greatest power."]
	quest.108CAB48687CD991.title: "Flowers"
	quest.109F8DB18FB26763.quest_desc: ["After harvesting a fully grown plant of Dragon Egg Seeds, you get Dragon Egg Essence."]
	quest.109F8DB18FB26763.title: "Dragon Egg Essence"
	quest.10B1340E94EB5CEB.quest_desc: ["Ok, let's go on with... Zucchini!"]
	quest.10B1340E94EB5CEB.title: "Zucchini"
	quest.10BF3139AF3FB815.quest_desc: ["Start by crafting the individual blocks needed for the Alloy Kiln. You’ll need bricks and some stone—nothing too fancy… yet."]
	quest.10BF3139AF3FB815.title: "Alloy Kiln #1"
	quest.10D2BACA83A67538.quest_desc: ["Time to gather the last components—less complex, but just as essential!"]
	quest.10D2BACA83A67538.title: "Advanced Alloy Smelting Factory #3"
	quest.10FCCD2C405E4D72.quest_desc: ["Glass bottles can be used in many different ways."]
	quest.10FCCD2C405E4D72.title: "Bottles"
	quest.1109E7940523B437.quest_desc: ["Wyvern Solar Panel generates 65,536 RF/FE/t, transfers 512,000 RF/FE/t and can store 256,000,000 RF/FE. "]
	quest.11831986EEF4FE77.quest_desc: ["Cheese Steak is a hearty meal combining Meat, melted Cheese, and Toast. It’s perfect for restoring a good amount of hunger."]
	quest.11831986EEF4FE77.title: "Cheese Steak"
	quest.1187A2384C57DC0C.quest_desc: ["Waters crops more efficiently than the previous tier. Crafted from the Inferium can."]
	quest.11918107B375C803.quest_desc: ["This mystical staff reveals nearby Ancient Debris using a small amount of Aura. A powerful tool for deep-nether exploration, helping you locate one of the rarest ores with ease. Knowledge truly is power!"]
	quest.11AC9CDBB5217ED4.quest_desc: ["Cosmic Meatballs are used to create the Infinity Catalyst or just to be eaten."]
	quest.11B9079C0B256C38.quest_desc: ["Produces energy from various basic fluids, like Oil and others."]
	quest.11F1EE40F7757157.quest_desc: ["The Casull Cartridge is a Cartridge for your Revolver. It is the most simple Cartridge, and it takes 10 health from the mob it is shot at."]
	quest.11F1EE40F7757157.title: "Casull Cartridge"
	quest.1257DCD651EE223E.quest_desc: ["The 1k Storage Disk can store up to &b1,000 items&r. Insert it into a Disk Drive to use it in your network, or into a Disk Manipulator to move data."]
	quest.1257DCD651EE223E.title: "Small but Smart"
	quest.125B6F479DAD39FB.quest_desc: [
		"It’s time to build a Pumpjack, a machine that uses energy to extract oil from beneath the earth’s surface."
		""
		"&aKeep in mind that Stellaris Oil is not a physical resource naturally found underground, but a special fluid generated by the mod."
	]
	quest.1292865C007D955F.quest_desc: ["Get some Obsidian to build a Nether Portal."]
	quest.1292865C007D955F.title: "Obsidian"
	quest.12A0E1669EA87B05.quest_desc: ["Data Storage Chips and Iridium Alloy Plates are used to craft certain Insane higher-tier machines. "]
	quest.12AB840316303217.quest_desc: ["Buy some reward!"]
	quest.12AB840316303217.title: "Attractor"
	quest.12B1DA5E78AF768F.quest_desc: ["Buy some reward!"]
	quest.12B1DA5E78AF768F.title: "Pumpkin Seeds"
	quest.12B7A283037BF5FA.quest_desc: ["Buy some reward!"]
	quest.12B7A283037BF5FA.title: "Tier 3 Crafting Seeds"
	quest.12CE3974586A4E55.quest_desc: ["Then put Bowl of Empty Promises into the Blood Infuser to get Bowl of Promises."]
	quest.12DDD0BC5296F850.quest_desc: ["Craft a few Wood Seeds."]
	quest.131811954D61196E.quest_desc: ["You can create Allthemodium Alloy by mixing Raw Allthemodium Ore, Calorite and HE Mox Ingot in a smeltery or Advanced Alloy Smelting Factory."]
	quest.131811954D61196E.title: "Allthemodium Alloy!"
	quest.1322082561843C4B.quest_desc: ["The Lapotron Crystal is a rechargeable energy storage unit similar to an Energy Crystal or Lithium Battery. It can hold 10,000,000 RF/FE!"]
	quest.13419605E9933EF6.quest_desc: ["Buy some reward!"]
	quest.13419605E9933EF6.title: "Loot Bags"
	quest.13465BB6EC6EF829.quest_desc: ["The Grinder is used to grind other powders."]
	quest.1368A92199BFCC50.quest_desc: [
		"The Energy Core Stabilizer is used to store energy when used in conjunction with a Draconic or Wyvern Energy Core. "
		""
		"This item is also a component of the Energy Core (Draconic Evolution) multiblock."
	]
	quest.1368A92199BFCC50.title: "Energy Core Stabilizer!"
	quest.1383DD8FBF260176.quest_desc: ["Buy some reward!"]
	quest.1383DD8FBF260176.title: "Pig Spawn Egg"
	quest.13B6BD8140D15A72.quest_desc: ["Unlike simple furnaces, this machine is specialized in processing dual or complex inputs to create entirely new materials."]
	quest.13B6BD8140D15A72.title: "Alloy Smelter"
	quest.13CC60745B08B4C5.quest_desc: ["Later in the modpack, you'll gain access to much better pipes from the Mekanism mod — but for now, these aren't available to craft yet. Be patient!"]
	quest.13D70462796BCA03.quest_desc: [
		"So let's prepare the first recipe with the Ritual you need for the next step."
		"Use a Bottle and Cork in the Overworld by right-clicking the air during daytime to obtain a Bottle of Sunlight."
		""
		"&a💡 Hint: If you don't know how to do the Inferium Apple then check out this chapter: &o\"Mystical Agriculture Tier I.\""
	]
	quest.1414D21809AFA6FB.quest_desc: ["Form Rice Dough to Raw Rice Bread."]
	quest.1414D21809AFA6FB.title: "Raw Rice Bread"
	quest.141856257013547F.quest_desc: [
		"Insulated Copper Cables are much safer than normal ones. You need Silicon in a Engineers Workshop to craft a few of them. "
		""
		"&aHint: Use a Wrench while sneaking to dismantle Insulated Cables. If you use a pickaxe you get a Copper Cable!"
	]
	quest.141856257013547F.title: "Insulated Copper Cable"
	quest.145787222484CE97.quest_desc: ["Let's continue with Redstone!"]
	quest.145787222484CE97.title: "Redstone!"
	quest.14757ECEB1D0D9BB.quest_desc: ["Solar Panel of Infinity generates 16,777,216 RF/FE/t, transfers 65,536,000 RF/FE/t and can store 262,144,000,000 RF/FE."]
	quest.147CF1E768D73C0B.quest_desc: ["Craft a few Uranium Seeds."]
	quest.148173869ADD7D6D.quest_desc: ["The excavator head is designed for digging in a 3×3 area, ideal for collecting dirt, gravel, sand, and other soft materials. Combine it with a handle!"]
	quest.148C764E4FC58829.quest_desc: ["To make your own Crossbow, you'll first need the basic parts: a Steel Tool Rod to hold the structure and a String Cord to launch the projectile. Experiment with different materials to find the one that works best for you!"]
	quest.148C764E4FC58829.title: "Crossbow Materials #1"
	quest.149ADB05C1FDAA3D.title: "Ender Guardian"
	quest.14BCE4E022E9A96A.quest_desc: ["For starters, you can use a Fermenting Barrel to convert the Canola Oil into Refined Canola Oil. It will generate 120 Energy per tick in the Oil Generator, but it can be further refined into Crystallized Oil which produces 280 Energy/t. "]
	quest.14DB9BCDF33A35EA.quest_desc: ["Crush Copper and Tin Ingots a Hammer to get their dust."]
	quest.14DB9BCDF33A35EA.title: "Your Hands the pulverizer!"
	quest.154B67D1C3536D18.quest_desc: ["Craft Supremium Essence with a Infusion Crystal."]
	quest.154B67D1C3536D18.title: "Supremium Essence"
	quest.1566653F5983CFA1.quest_desc: ["Alumite Essences can be used to craft Alumite Ingots."]
	quest.1566653F5983CFA1.title: "Alumite Ingots"
	quest.15848CEAF0CDBA2E.quest_desc: ["The Emerald Upgrade Increases 32 times the base storage value!"]
	quest.159E107DDC570DA0.quest_desc: [
		"To create an Xpetrified Orb, you'll need a Black Hole."
		"First, smelt Edelwood to get Dark Matter. Then craft Corrupti Dust using Obsidiansteel and various mob drops."
		"Throw both items on the ground—this summons a Black Hole."
		"The Black Hole consumes anything nearby, but to get your reward, feed it Experience."
		"Once it has absorbed enough, it will release an Xpetrified Orb."
	]
	quest.15AB47844603B7A8.title: "Mushroom Steak"
	quest.15CD219361A71431.quest_desc: ["Take the Empowered Canola Seed and throw them into some Crystallized Oil to get Empowered Oil!"]
	quest.15CD219361A71431.title: "Empowered Canola Oil"
	quest.15D7544738CF20BA.quest_desc: ["The mechanical fusion anvil is a special anvil that cannot be made in this situation. Check out the JEI to see what you can do in it."]
	quest.15D98AB01B96E805.title: "Pillager Hunter"
	quest.15F09CE56FCCA137.quest_desc: ["Make Flint Tools from Wooden Sticks for now, later you can use almost any material rod!"]
	quest.15F09CE56FCCA137.title: "Flint Tools!"
	quest.1654A3E8B899BEA8.quest_desc: [
		"Mercury Solerium Ore and Uranium Ore are both generated on this planet."
		"Can only be found on this planet and it's essential for your planet progression."
		""
		"&a💡 Hint: Mercury Solerium Ore can be found between layers Y=0 and Y=192."
		"&aUranium Ore can be found between layers Y=-80 and Y=192."
	]
	quest.1654A3E8B899BEA8.title: "Solerium Ore!"
	quest.1678CBFC72B646CA.quest_desc: ["Crafting Table On A Stick? Buy some reward!"]
	quest.1678CBFC72B646CA.title: "Crafting Table On A Stick"
	quest.16D6244D03666953.quest_desc: ["Tungsten Essences can be used to craft Tungsten Ingots."]
	quest.16D6244D03666953.title: "Tungsten Ingots"
	quest.16E8BE2CF0741683.quest_desc: [
		"Running out of inventory space? The Sophisticated Backpacks mod lets you carry more items with customizable, &aupgradable backpacks! &r"
		"Crafting your a Copper Backpack to expand your storage."
	]
	quest.17294DF3F2584A59.quest_desc: ["If you need even more power, place Refined Canola Oil on the ground and throw in a Crystallized Canola Seed to create Crystallized Oil."]
	quest.17294DF3F2584A59.title: "Crystallyzed Oil"
	quest.17788ECC83F43D50.quest_desc: ["Craft a few End Seeds."]
	quest.17BB3740E48A0E72.quest_desc: [
		"Your scanners have picked up traces of Corronium, a rare and volatile mineral. While essential for advanced machinery, Corronium is highly radioactive."
		""
		"&cWarning: Handling this ore without proper protection is lethal. If left in your inventory for too long, the radiation will begin to deteriorate your vitals. Mine it quickly, move it safely, and never underestimate its toxicity."
	]
	quest.17BB3740E48A0E72.title: "Corronium Ore!"
	quest.17C90330D55CAB12.quest_desc: [
		"The Template Board is a basic crafting component in the Silent Gear mod. It is used to create blueprints and templates, essential for crafting tools, weapons, and other gear."
		""
		"&9Upon completion of this quest you will unlock the chapter: &o\"Ores and Alloys Tier I\""
	]
	quest.17C90330D55CAB12.title: "     &9Unlock: &6&lOres and Alloys Tier I.     "
	quest.17CEDBB035F26FA5.quest_desc: [
		"Cleans Dirty Dusts into regular dusts. Essential for ore processing and automation."
		"You’ll use this machine more than any other!"
	]
	quest.17D10EE330A2FB55.title: "First Village!"
	quest.17D5CC7DB95B0F57.quest_desc: ["Every modpack has a mod that uses white magic, this chapter will go through these mods in general."]
	quest.17E04872451ED9DD.quest_desc: ["Craft a Copper Boots."]
	quest.1800641111BF396B.quest_desc: [
		"Essence Coal is Coal that burns for longer! Inferium Coal burns 1,5x longer."
		""
		"&9Upon completion of this quest you will unlock the chapter: &o\"Mystical Agriculture Tier I\""
	]
	quest.1800641111BF396B.title: "&9Unlock: &6&lMystical Agriculture Tier I."
	quest.1824EBC44919E82B.quest_desc: ["To make Constantan you need to combine Copper and Nickel Ingots in Foundry or later in Alloy Smelter and in Advanced Alloy Smelting Factory."]
	quest.1824EBC44919E82B.title: "Constantan"
	quest.1851ED693217AEAD.quest_desc: ["Buy some reward!"]
	quest.1851ED693217AEAD.title: "Emerald Apple"
	quest.185ADB9BE839A3C4.quest_desc: ["Small TNT explodes a little, but it kills you if you're close to it."]
	quest.185ADB9BE839A3C4.title: "Mini TNT"
	quest.185E09E8AF468D38.quest_desc: ["Transform your newly acquired tin ingots into Tin Plates, essential components for crafting machines and advanced tools."]
	quest.185E09E8AF468D38.title: "Basic Plates #3"
	quest.18A6A3D913EBAE2E.quest_desc: ["The Basic Drill is a medium tier Drill from Steve's Carts."]
	quest.18B9D66D48AC0C48.quest_desc: ["No jetpack without thrusters! Build the propulsion units that will lift you to the skies."]
	quest.18B9D66D48AC0C48.title: "Hardened Thruster"
	quest.18DCDCFEE622D5B9.quest_desc: ["Mix Redstone with Sawdust and Copper Grit to obtain Electrotine Dust."]
	quest.18DCDCFEE622D5B9.title: "Electrotine Dust"
	quest.18EF8D7BCFC82BCF.title: "Ender Guardian"
	quest.18F1509108A95418.quest_desc: ["To craft a katana, you'll first need its blueprint. The Katana Blueprint allows you to produce katana parts."]
	quest.18F2B69E74B9F7E7.quest_desc: ["You can create Deepsilver by mixing Triberium, Obsidian and Azure Silver in a Foundry or Advanced Alloy Smelting Factory."]
	quest.18F2B69E74B9F7E7.title: "Deepsilver"
	quest.1926950B293FE25C.quest_desc: ["The Energy Tablet is a portable, rechargeable battery pack that can be charged with energy and can then be used to power other devices. It is also an ingredient in many recipes."]
	quest.1926950B293FE25C.title: "Energy Tablet"
	quest.197E54C63B32844F.quest_desc: ["Well this is nothing more than pulverized Moon Sand. But it is versatile and very powerful!"]
	quest.197E54C63B32844F.title: "Moon Sand Dust"
	quest.199BB384AD6240DD.quest_desc: ["Craft a few Blaze Seeds."]
	quest.19F426577BCF782B.quest_desc: ["Required to craft Intermedium essence-based items and have greater durability."]
	quest.1A389BDA6B06530F.quest_desc: ["Now put the blocks together to form the Alloy Kiln multiblock. Use the Engineer’s Hammer to finish the structure and unlock alloy smelting!"]
	quest.1A389BDA6B06530F.title: "Alloy Kiln #2"
	quest.1A3F342847B526B2.title: "Ignis"
	quest.1A40DCE408B6DE51.quest_desc: ["This metal doesn’t spawn naturally in ore form. To produce it, you’ll need to combine Bauxite — which can be found underground — with Triberium. Process the mix in the appropriate machine to obtain Aluminium Ingots."]
	quest.1A40DCE408B6DE51.title: "Aluminium Ingot"
	quest.1A6BB58D69D26D92.quest_desc: ["After harvesting a fully grown plant of Awakened Draconium Seeds, you get Awakened Draconium Essence."]
	quest.1A6BB58D69D26D92.title: "Awakened Draconium Essence"
	quest.1AA43A71B153968D.quest_desc: [
		"Extreme Reactors are powerful multi-block generators based on real-world nuclear concepts. "
		"They're modular — every block affects efficiency or output. They generate RF/FE, and are a great power source once fully built. Ready to dive into nuclear energy?"
	]
	quest.1ABF83E73918F744.quest_desc: ["The Transistor is a basic crafting component required to craft various electric and electronic blocks and items."]
	quest.1ABF83E73918F744.title: "Transistor"
	quest.1ADAB9414BC0220F.quest_desc: ["Menril Essences can be used to craft Menril Wood and Saplings. Craft some Menril Wood."]
	quest.1ADAB9414BC0220F.title: "Menril Log"
	quest.1AE231978D8C4EC9.quest_desc: ["The Heavy Metal Plate is a key component for building rocket parts, including the Rocket Engine, Nose Cone, Rocket Fin, and the Spaceship itself."]
	quest.1AE231978D8C4EC9.title: "Heavy Metal Plates"
	quest.1AE3CF264A2C0609.title: "Maledictus"
	quest.1B317CB5A9168900.title: "Mayonnaise"
	quest.1B360CC2A8D24A13.quest_desc: [
		"Craft unused coins to the next higher currency (and if necessary also back again)!"
		""
		"&79 Copper Coins = 1 Iron Coin"
		"&79 Iron Coins = 1 Gold Coin"
		"&79 Gold Coins = 1 Diamond Coin"
		"&79 Diamond Coins = 1 Emerald Coin"
		"&79 Emerald Coins = 1 Netherite Coin"
	]
	quest.1B360CC2A8D24A13.title: "Craftable Coin!"
	quest.1B3F979EF0DAD9D8.quest_desc: [
		"Craft Flint and Steel to light fires, activate portals, and spark your journey! "
		"{image:chipped:block/carved_pumpkin/slight_smile_carved_pumpkin width:15 height:15 align:left}"
	]
	quest.1B3F979EF0DAD9D8.title: "Flint and Iron"
	quest.1B9C949647E04DE0.quest_desc: ["After harvesting a fully grown plant of Thermal Springstone Seeds, you get Thermal Springstone Essence."]
	quest.1B9C949647E04DE0.title: "Thermal Springstone Essence"
	quest.1BF9A6871B49DFE9.quest_desc: ["Put Ruby Dust in the Electrolyzer to obtain Chrome Dust. It can be made from more Gems!"]
	quest.1BF9A6871B49DFE9.title: "Chromium Dust"
	quest.1C2535060717D71A.quest_desc: ["Craft a Neutronium Seed!"]
	quest.1C2A6F03893AC774.quest_desc: ["When even the 30k Coolant Cell isn't cutting it anymore… Provides superior heat absorption for high-performance machines."]
	quest.1C50D5AE70010E26.quest_desc: ["Industrial TNT is an item added by the Modern Industrialization mod. It can ONLY be used for crafting, it does not explode."]
	quest.1C579BCD2B5EDC3E.quest_desc: ["The Cleaning Tubes help keep your machines clean."]
	quest.1C579BCD2B5EDC3E.title: "Cleaning Tubes"
	quest.1C5DD707F9884F71.quest_desc: ["Craft a few Chromium Seeds."]
	quest.1C5DD707F9884F71.title: "Chromium Seeds"
	quest.1C9028128A3C92D1.quest_desc: [
		"Enriched Alloy is a key crafting material used in many Mekanism devices and in creating Reinforced Alloy."
		"It's made by infusing a Steel Ingot with Redstone in the Metallurgic Infuser."
	]
	quest.1C9028128A3C92D1.title: "Infused Alloy"
	quest.1C91626D1D2F1DC9.quest_desc: ["You can use an Energizer to charge up items."]
	quest.1CED510F8B2D1C88.quest_desc: ["Finally, Iridium! Mix Mythralite Ingot and Ultimate Essence Fluid to create Iridium Ingots!"]
	quest.1CED510F8B2D1C88.quest_subtitle: "&9Unlock: &6&lMain Questline - Tier IV."
	quest.1CED510F8B2D1C88.title: "IRIDIUM"
	quest.1D26BC8FA7148F3B.quest_desc: ["If you put Grossular into the Industrial Electrolyzer you will get valuable materials! Besides precious Azure Silver and Uvarovite Dust, the machine will also extract Lubricant from Grossular which is very useful for the Blacksmith Workshops and the Master Assembler!"]
	quest.1D26BC8FA7148F3B.title: "Azure Silver, Uvarovite and Lubricant"
	quest.1D3785F8AF0F1AB7.quest_desc: ["The Ceramic Shears are very useful at the beginning of the game. It works like normal vanilla Shears."]
	quest.1D3785F8AF0F1AB7.quest_subtitle: "In Clays?"
	quest.1D3785F8AF0F1AB7.title: "Ceramic?"
	quest.1D58AA86D2209CCD.quest_desc: [
		"The Coal Generator from Actually Additions will generate 100 FE when burning solid fuels that would work in a Furnace. The Coal Generator can be disabled by a Redstone signal."
		""
		"&9Upon completion of this quest you will unlock the chapter: &o\"Main Questline Tier I\""
	]
	quest.1D58AA86D2209CCD.title: "&9Unlock: &6&lMain Questline - Tier I. "
	quest.1D7BFCB8FF5859B1.quest_desc: ["The Reactor Casing and Reactor Glass form the foundation of every Extreme Reactor. These components are used to build the outer frame and corners of the reactor. With the Basic tier, the reactor can be between 3x3x3 and 5x5x5 in size. Later, you’ll be able to upgrade these parts to build more powerful reactors."]
	quest.1D7BFCB8FF5859B1.title: "Reactor Frame – Basic Structure"
	quest.1D81E8D9A78A1573.quest_desc: ["Combine White and Dark Magic Dust to create Ultimate Dust, then liquefy it in the Material Liquefier to get Ultimate Essence Fluid."]
	quest.1D81E8D9A78A1573.title: "Ultimate Essence Fluid #9"
	quest.1DD3173D2C88B717.quest_desc: ["This chocolate must be strong..."]
	quest.1DD3173D2C88B717.title: "Chili Chocolate"
	quest.1DEC946FC748A251.quest_desc: ["Combine a Unobtainium Ingot and a Cobalt Ingot to create the powerful Inanite."]
	quest.1DEC946FC748A251.title: "Inanite!"
	quest.1DF2D6F581A2635B.quest_desc: ["Ok, let's go on with... Sweet Potato!"]
	quest.1DF2D6F581A2635B.title: "Sweet Potato"
	quest.1E03E7D6B8F0A748.quest_desc: ["The Creative Capacitor is used to output an infinite amount of RF/FE. "]
	quest.1E03E7D6B8F0A748.title: "&6Creative Capacitor"
	quest.1E151DE3B2421663.quest_desc: [
		"The rituals require different Essences. Collect some of each!"
		""
		"The Aureal Bottle is crafted with Arcane Crystal Dusts and a Potion of Regeneration II."
	]
	quest.1E151DE3B2421663.title: "Aureal Bottles"
	quest.1E1BF346EB6017FA.quest_desc: ["Golem Steel Essences can be used to craft Golem Steel Ingots."]
	quest.1E1BF346EB6017FA.title: "Golem Steel Ingot"
	quest.1E2BDAC8131BC77E.quest_desc: ["After harvesting a fully grown plant of Chromium Seeds, you get Chromium Essences."]
	quest.1E2BDAC8131BC77E.title: "Chromium Essence"
	quest.1E3DF7E9CEEBD575.quest_desc: ["Buy some reward!"]
	quest.1E3DF7E9CEEBD575.title: "Chicken Spawn Egg"
	quest.1E57BA016AF7EC5B.quest_desc: ["Buy some reward!"]
	quest.1E57BA016AF7EC5B.title: "Slimebllas"
	quest.1E6350D94DFF1D25.quest_desc: ["The Blast Furnace is made of Blaze Rods, collect a few of them."]
	quest.1E6350D94DFF1D25.title: "Blazes"
	quest.1EA238CCCA708476.quest_desc: ["Combining Mundabitur Dust, Arcane Crystal Dust, Charcoal and a Gold Ingot we'll get The Deorum Ingot."]
	quest.1EBBC1C96CF348CD.quest_desc: ["The next tier Solar Panel generate 32768 RF/FE/t when receiving light."]
	quest.1EC1FD99C2AA85AA.title: "Frostmaw"
	quest.1EC44E3AEC5B2B11.quest_desc: [
		"As with all mods, there is a book that comes with it, this time Origins of Darkness. It will help you a lot."
		"You need a Darkened Apple with a Gold Ingot and a Book."
	]
	quest.1EEC13A1C6303913.quest_desc: ["Sugar is an essential ingredient for many recipes, especially in baking and brewing. You can craft it from Sugar Cane or Beet, which grows naturally near water."]
	quest.1EEC13A1C6303913.title: "Sugar"
	quest.1F18F1CFA53ECFDA.quest_desc: [
		"Congratulations! You've crafted your first Jetpack. Powered by Redstone Flux (RF / FE), it lets you soar."
		"Use it wisely — and don’t forget to land safely."
	]
	quest.1F18F1CFA53ECFDA.title: "Iron Jetpack!"
	quest.1F265BE70016F3A3.quest_desc: ["Use your new rocket to travel to the Moon. Make sure to wear your full space gear and fill up your oxygen tank before launch!"]
	quest.1F265BE70016F3A3.title: "&eThe Moon!"
	quest.1F270C560FCB5D0C.quest_desc: ["Ok, let's go on with... Okra!"]
	quest.1F270C560FCB5D0C.title: "Okra"
	quest.1F64556FC2B24CC8.title: "Netherite Monstrosity"
	quest.1F6A27DC61391719.quest_desc: ["You can break down Water in an Electrolyzer to obtain Oxygen and Hydrogen. Salt can also be processed into Sodium Dust, and when combined with these fluids in a Chemical Reactor, you will produce Sodium Hydroxide."]
	quest.1F6A27DC61391719.title: "Sodium Hydroxide"
	quest.1F7CB86278D5152E.quest_desc: ["Craft a few Glowstone Seeds."]
	quest.1F971C2EE5E97D44.quest_desc: ["Silver Ore can be found at Y-levels -64 to 56."]
	quest.1F971C2EE5E97D44.title: "Silver"
	quest.1FA150F6248F234E.quest_desc: ["Endstone Dust Tungsten can be produced in an Industrial Centrifuge, the construction of which is described above."]
	quest.1FA150F6248F234E.title: "Tungsten and Helium!"
	quest.1FAD8D292B5B6C69.quest_desc: ["Lapis Lazuli Ore is found at a depth of 31 and below. It is used for enchanting and and also for machines."]
	quest.1FAD8D292B5B6C69.title: "Lapis Lazuli"
	quest.205212E525F698EA.quest_desc: ["Found in the Nether, this vibrant crystal is quite abundant and will become a fundamental component in many ore processing recipes later on. Be sure to collect plenty, as it's a crucial base material for future alloys."]
	quest.205212E525F698EA.title: "Tiberium"
	quest.20D4E1457FA5FBA2.quest_desc: ["Plastic is essential in Industrial Foregoing. To produce it, place a Tree Fluid Extractor facing a log (on the side with the dark circle). It will slowly extract Liquid Latex at 4mb/s, eventually consuming the log."]
	quest.20D4E1457FA5FBA2.title: "Latex!"
	quest.20EE7A72BFAE5A4F.quest_desc: ["The Coke Oven is a multi-block structure used to turn Coal into Coal Coke and produce Creosote Oil as a byproduct. It requires 27 Coke Bricks to build and works without needing power—just insert Coal and wait!"]
	quest.20EE7A72BFAE5A4F.title: "Coke Oven"
	quest.20EF6073BD1CB50A.quest_desc: ["Combine Liquid Concrete, Liquid Crystalline, and Ether Gas in a Chemical Reactor to produce Cursium! (or Liquid Concrete, Liquid Crystalline, Ostrum in Foundry)"]
	quest.20EF6073BD1CB50A.title: "Cursium!"
	quest.20FCDF28926DA0CC.quest_desc: [
		"With advanced fuels, oxygen systems, and machinery in place, you are ready to craft the Space Suit — your ticket to survival beyond Earth."
		""
		"&aDon’t forget to fill your Space Suit Chest with oxygen before heading out, or you won’t last long."
	]
	quest.214089954C2D64A7.quest_desc: [
		"Using the Atomic Reconstructor, you can transform regular Lapis into Palis Crystal."
		"Using the Atomic Reconstructor, you can transform regular Lapis Lazuli Block into Palis Crystal Block."
	]
	quest.214089954C2D64A7.title: "Palis Crystals"
	quest.217083CEBBE562F7.quest_desc: ["The Hopping Item Interface is a block that allows for automatic item transfer between inventories with Item Laser Relay. It works like a Hopper, but with additional flexibility."]
	quest.21C9B5102DDF97BA.quest_desc: ["Supremium Coal burns for a long time! 24x longer than normal Coal!"]
	quest.21C9B5102DDF97BA.title: "Supremium Coal"
	quest.21FEA79755440D38.quest_desc: [
		"The next step is to travel to the End. Be well prepared — it will be a tough and painful challenge. "
		""
		"For the battle against the Ender Dragon, make sure to bring the best armor you have!"
	]
	quest.21FEA79755440D38.title: "       Journey to the End!       "
	quest.221E65ADC7BA55CB.quest_desc: ["The Assembler is highly efficient multi-purpose machine for crafting circuits, cables, food, and more. It saves materials compared to manual crafting—build it early for maximum efficiency!"]
	quest.221E65ADC7BA55CB.title: "Assembler!!"
	quest.222DD01A6BA53E05.quest_desc: [
		"I know — we’re upgrading the forge quickly, but that’s just how the process goes!"
		"This one requires another Archwood Plank, this time combined with 2 Rune Blocks, 2 Sea Prism and 4 Stellarite Pieces."
		"It’s not the final forge yet, but it does unlock all remaining Relic slots and includes all recipes from the previous stages."
		""
		"&a💡 Hint: Use a Gavel to activate the process."
	]
	quest.222DD01A6BA53E05.title: "     Upgrading the Forge to Tier IV.     "
	quest.225E2AACB8191BC1.quest_desc: ["A special type of glass that blocks light while remaining transparent to the player. Perfect for darkroom setups or secretive builds."]
	quest.225E2AACB8191BC1.title: "Obscured Glass"
	quest.22C887DFF960497A.quest_desc: [
		"Put your Small Pile of Tungsten Dust in your upgraded Blast Furnace to obtain ingots."
		""
		"&aRequire: 256.000 FE/run and 2500Heat"
	]
	quest.22C887DFF960497A.title: "Tungsten Ingots"
	quest.23190828A279D2E8.quest_desc: [
		"An unbreakable crystal used for essence crafting."
		"Unlike lower-tier crystals, it never runs out!"
	]
	quest.23264E3BD2CC796F.quest_desc: ["The Diamond Upgrade Increases 16 times the base storage value!"]
	quest.233EB710371FF2BC.quest_desc: ["SoL: Carrot gives you an extra heart each time you eat 40 different meals. This book gives you an overview of what you have already eaten."]
	quest.2352752047ABF92E.quest_desc: ["Ok, let's go on with... Corn!"]
	quest.2352752047ABF92E.title: "Corn"
	quest.23570216B5C73B5F.quest_desc: ["Craft Eyes of Ender more efficiently to earn the best possible rewards."]
	quest.23570216B5C73B5F.title: "Eyes of Ender"
	quest.23617EB0D87169C6.quest_desc: ["Craft the remaining interior components to assemble your first rocket."]
	quest.23617EB0D87169C6.title: "Componets for the Rocket! #2"
	quest.23910A2B83A66937.quest_desc: ["Well, the first step is to make blueprints, which you will use later to make the tools."]
	quest.23910A2B83A66937.title: "&eBlueprints!"
	quest.23B02CAC7F11071F.quest_desc: ["Ketchup is a classic condiment made from tomatoes, known for its rich, tangy, and slightly sweet flavor. It pairs perfectly with a variety of dishes and is a must-have in any kitchen!"]
	quest.23B02CAC7F11071F.title: "Ketchup"
	quest.23BD30AB605E3242.quest_desc: ["Upgrade Templates are a basic component for all Storage Drawer Upgrades."]
	quest.23BD30AB605E3242.title: "Upgrade Templates"
	quest.23D01EFC916E2FAD.quest_desc: [
		"These casings are essential for building multiblock machines such as the Industrial Grinder and Industrial Blast Furnace."
		"Check the instructions below to see how to construct the multiblock structure properly."
		""
		"&aWith Lava in center:"
		"&aStandard Machine Casing: 1860Heat"
		"&aAdvanced Machine Casing: 2784Heat"
		""
		"&a-The Blast Furnace requires a 3×4 multi-block with a hole in the center. "
		"&a-The first layer contains 9x casings"
		"&a-The second layer contains 8x casings with an empty central hole."
		"&a-The third layer again contains 8x casings with a hole in the middle."
		"&a-The last layer is made with 9x casings."
		"&a-Place the Blast Furnace in front of the center bottom block and connect it to a power source. Done!"
	]
	quest.23D01EFC916E2FAD.title: "               Machine Casings               "
	quest.23F5130F5B3F6132.quest_desc: [
		"Silicon is often a required component when crafting machines, tools, and electronic circuits. "
		"You will need a lot of it! Let's start with one of its ingredients: a simple Clay Block."
	]
	quest.23F5130F5B3F6132.title: "Obtain materials for Silicon #1"
	quest.2403C7C808384202.quest_desc: ["A powerful enhancement that greatly boosts machine performance."]
	quest.240E12F48D189EBA.quest_desc: ["To craft Motors, you'll need a Wiremill to produce wires efficiently. This machine will help you process plates into the necessary wiring for your advanced components!"]
	quest.2438A288CF0711F2.quest_desc: [
		"Industrial Blast Furnace is a multiblock machine is used to smelt hard metals and can produce Steel at an impressive speed. It requires 512 FE/t and has an internal buffer of 40,000 FE. Its smelting capabilities depend on the type of casings used."
		""
		"&a💡 Hint: Use a wrench to dismantle this machine!"
	]
	quest.2438A288CF0711F2.title: "          Industrial Blast Furnace          "
	quest.249B17FF95C51B88.quest_desc: ["Osmium is one of three basic metals in Mekanism."]
	quest.249B17FF95C51B88.title: "Osmium Ingot"
	quest.24B3B664CF7FF0EA.quest_desc: ["The Elite Energy Cube stores 12.800.000 RF/FE and can be upgraded to the Ultimate Energy Cube."]
	quest.24CB366EF7EB9C41.quest_desc: ["The Crumbling Catalyst allows you to turn each Gold Leaf into 4 Gold Powder instead of 2! "]
	quest.24DC7856997497F8.quest_desc: [
		"The Empty Cell is a versatile container designed for storing liquids, gases, and other resources."
		"Empty Cells can be used to craft Compressed Air Cells, Cooling Cells, and much more."
		""
		"&cThe empty cell does not work in all cases because Tech Reborn is Fabric based and may be faulty!"
	]
	quest.24DC7856997497F8.title: "Empty Cells"
	quest.24E9A586B48365B7.quest_desc: [
		"To obtain Gold Powder, crush Gold Leaf using a Hammer."
		""
		"Gold Powder is used up during the Ritual, so be sure to keep a good supply."
	]
	quest.24E9A586B48365B7.title: "Ritual of the Forest #2"
	quest.24F12510F457AD6A.quest_desc: ["Immersive Engineering's industrial-grade automated tower, designed for serious area protection, features a robust mechanical design."]
	quest.2534F99705C79EF7.quest_desc: ["Buy some reward!"]
	quest.2534F99705C79EF7.title: "Foods"
	quest.257AFF2A1A03D049.quest_desc: ["Ok, let's go on with... Spinach!"]
	quest.257AFF2A1A03D049.title: "Spinach"
	quest.258236FDB90B4AC4.quest_desc: [
		"Craft ONE of the Prudentium bows so that your opponents can't get any closer."
		"As a reward, you get a speed effect."
	]
	quest.258236FDB90B4AC4.quest_subtitle: "Reward: Speed 60 sec"
	quest.258236FDB90B4AC4.title: "Prudentium Bows"
	quest.259479F441494E4B.quest_desc: [
		"The Dark Power Gem can be crafted by infusing a Dark Gem with blood using the Blood Infuser. However, since the Blood Infuser itself requires a Dark Power Gem to craft, an alternative method is to throw a Dark Gem into a pool of at least 5 liquid blood blocks placed in the world."
		"The gem will absorb the blood and transform into a Dark Power Gem."
	]
	quest.25AF47AFC01036AD.quest_desc: ["Dark Gem Essences can only be used to craft Dark Gems."]
	quest.25AF47AFC01036AD.title: "Dark Gem"
	quest.25B05924F746EA1F.quest_desc: ["Smelting Cobblestones to produce \"clean-Stone\"."]
	quest.25B05924F746EA1F.title: "Clean-Stone"
	quest.25BD9235C4D6F1CD.quest_desc: ["The Neutron Collector is a simple, although extremely expensive, machine. Every 6 minutes, one Pile of Neutrons will be fabricated."]
	quest.25D3957E90D800C3.quest_desc: ["Ok, let's go on with... Parsnip!"]
	quest.25D3957E90D800C3.title: "Parsnip"
	quest.25DA40E2EA3DCF5C.quest_desc: [
		"The Energy Pylon is used to transport energy in and out of Energy Cores. A block of Glass must be placed on top of it to make it properly function. "
		""
		"The direction of energy can be observed by the particle effects of the translucent sphere: if they are moving inwards then it will take energy out of an Energy Core, while energy will move into the Energy Core if particle effects are moving outwards."
	]
	quest.25DFF9EC51AC555E.quest_desc: [
		"The Awakened Draconium Block is a very strong material! It is used to craft the Draconic set, Awakened Core and many strong tools and armor. It is wither proof!"
		""
		"&cWarning: This uses 2.500.000.000 RF/FE and as such may cause serious problems for your power system until the process is completed."
	]
	quest.25DFF9EC51AC555E.title: "Awakened Draconium Blocks"
	quest.262A0D3AD9017181.quest_desc: ["The Kinetic Dynamo converts rotational energy into RF power. Connect it to a Water Wheel or Windmill to generate electricity for your machines!"]
	quest.2638C7FBD41C1597.quest_desc: [
		"Brass is an alloy created by melting specific metals in a Smeltery, using a 3:2 ratio."
		"It's primarily used to create part casts by pouring the molten Brass over individual tool parts. While functionally similar to Gold, Brass is a more affordable alternative for casting."
		""
		"You can obtain Brass through two main alloy combinations:"
		"- Copper + Silver"
		"- Copper + Zinc"
		""
		"Let’s begin with the Copper and Silver method."
	]
	quest.2638C7FBD41C1597.title: "Brass"
	quest.266D681362D1898E.quest_desc: ["Industrial Blast Furnace is a multiblock machine is used to smelt hard metals at different levels"]
	quest.266D681362D1898E.title: "Machine Casings and Coils"
	quest.268D8FED82AEB6DA.quest_desc: [
		"Vibranium Allthemodium Alloy is one of the most durable metals ever discovered — a material of exceptional resistance."
		"It’s used in top-tier equipment and high-end machines, but crafting it requires some of the most extreme alloys and resources ever made."
		""
		"&a&l🎉 Congratulations! You've completed the second major power progression questline! &r&a:)"
	]
	quest.268D8FED82AEB6DA.title: "       &6Vibranium Allthemodium Alloy!       "
	quest.269343318CAB1DA5.title: "Ancient Remnant"
	quest.26C1F1D7A8656E3B.quest_desc: ["The Battery is useful for item recipes, make two of them."]
	quest.26C1F1D7A8656E3B.title: "Battery"
	quest.26D8FCD6494654C7.quest_desc: [
		"The Energy Core is a part of an energy storage system. It is the central part of the Energy Core multiblock which can store massive amounts RF/FE. This structure comes in 8 tiers."
		""
		"&aThe amount of RF/FE that can be stored inside an Energy Core of a given tier is:"
		"&aTier 1= 45,500,000"
		"&aTier 2= 273,000,000"
		"&aTier 3= 1,640,000,000"
		"&aTier 4= 9,880,000,000"
		"&aTier 5= 59,300,000,000"
		"&aTier 6= 356,000,000,000"
		"&aTier 7= 2,140,000,000,000"
		"&aTier 8= 9,223,372,036,854,775,807"
	]
	quest.26D8FCD6494654C7.title: "The Energy Core!"
	quest.26FACB9521BE31AE.quest_desc: ["An upgraded crystal for crafting Prudentium and higher-tier resources."]
	quest.2710C915800332F4.quest_desc: ["Buy some reward!"]
	quest.2710C915800332F4.title: "Ghast Tears"
	quest.27205308D91A078F.quest_desc: [
		"Tier 2 Crafting Seeds are more powerful and can be used as well in many recipes."
		"It cannot be planted and is only used as a crafting component for higher-tier crops."
	]
	quest.27205308D91A078F.quest_subtitle: "Crafting Seeds"
	quest.27249AD506DC73CF.title: "Ferrous Wroughtnaut"
	quest.2733381001E1CD69.quest_desc: ["Craft a Awakened Draconium Seed!"]
	quest.2737BE10BF6A1234.quest_desc: ["Infused Iron Ingot can be found in the White Magic quest series."]
	quest.2737BE10BF6A1234.title: "Infused Iron Ingot"
	quest.273FA2BF01EB8617.quest_desc: ["Craft the Soul Binding Crystal and apply it to tools or armor to make them Soulbound, meaning they stay in your inventory after death."]
	quest.27474A5A33847A80.quest_desc: ["After harvesting a fully grown plant of Dark Gem Seeds, you get Dark Gem Essences."]
	quest.27474A5A33847A80.title: "Dark Gem Essence"
	quest.27706004954E04BE.quest_desc: ["Moon Sand can be found in large quantities on the Moon’s surface. Collect a full stack it’ll come in handy later when you return to Earth."]
	quest.27706004954E04BE.title: "Moon Sands"
	quest.278719A0DBABDC72.quest_desc: ["Decorated Pots are more than just decoration—they tell the stories of the past. Craft your Decorated Pot to add a unique touch to your world!"]
	quest.278719A0DBABDC72.title: "Decorating"
	quest.2792FC5DE60799FB.quest_desc: ["Before performing the Ritual of the Forest, you'll first need to craft 8x Wooden Stands."]
	quest.2792FC5DE60799FB.title: "Ritual of the Forest #1"
	quest.27AF7EC63B203E3F.quest_desc: ["Graphite Bars are a useful material for reactors. They protect against radiation."]
	quest.27AF7EC63B203E3F.title: "Graphite Bars"
	quest.27B6CBD7F0E7E254.quest_desc: ["Glowstone Essences can only be used to craft Glowstone Dust."]
	quest.27B6CBD7F0E7E254.title: "Glowstone"
	quest.27BC481A612FF947.quest_desc: ["Buy some reward!"]
	quest.27BC481A612FF947.title: "Xpetrified Orb"
	quest.27C2C54A0BF3A91A.quest_desc: ["Awakened Draconium Essences can be used to craft Awakened Draconium Nugget which can be converted into Awakened Draconium Ingot."]
	quest.27C2C54A0BF3A91A.title: "Awakened Draconium Ingot"
	quest.27F4A501868F1003.quest_desc: [
		"Enderium is made by combining Lead, Platinum, and Ender Pearl."
		""
		"&a💡 Hint: You received Portal Frames as a reward! In Survival mode, you can build your own End Portal, but it will only activate if all frames are placed correctly, facing inward. Make sure to stand inside the ring when placing them."
	]
	quest.27F4A501868F1003.title: "Enderium Ingots!"
	quest.2865B54CAAE838BD.quest_desc: [
		"Similar in use to a laser drill base, but produces fluid once every 20 seconds, adding speed to the surrounding laser drills. Efficiency plugins can increase fluid production."
		""
		"You can produce the gas with a Purple Laser Lens and put it into the machine."
	]
	quest.28718C06E365DFE3.quest_desc: ["The Armor-Piercing Cartridge inflicts 10 points of damage to the target mob and bypasses armor protection!"]
	quest.28718C06E365DFE3.title: "Armor-Piercing Cartridge"
	quest.28923459EE205590.title: "Hardened Glass"
	quest.28D409BF3B434996.quest_desc: ["After harvesting a fully grown plant of Wood Seeds, you get Wood Essences."]
	quest.28D409BF3B434996.title: "Wood Essence"
	quest.28F61E7CA2714DF4.quest_desc: ["Buy some reward!"]
	quest.28F61E7CA2714DF4.title: "Feathers"
	quest.28FCEE70A674AA6E.quest_desc: [
		"The Enchanted Ingot is inspired by Extra Utilities 2. It is crafted by combining 2 Gold Ingots and 1 Refined Glowstone Ingot in Alloy Smelter."
		"For better efficiency, you can also produce it using the Advanced Alloy Smelter."
	]
	quest.28FCEE70A674AA6E.title: "Enchanted Ingots!"
	quest.29036F00B6A0F708.quest_desc: [
		"They're small, throwable, and go boom!"
		"These simple bombs may not cause much destruction, but they’re a starting point for understanding how to defend — and sometimes attack."
		""
		"Craft 8 of them and test their blast radius (carefully). Just don’t expect them to level a mountain… yet."
	]
	quest.29036F00B6A0F708.title: "&eBomb, grenade?!"
	quest.291532BE6C7BF538.quest_desc: ["Buy some reward!"]
	quest.291532BE6C7BF538.title: "Gunpowders"
	quest.2932FD0663FDE421.quest_desc: ["The Promise of Tenacity I is essential for early machine upgrades and is also used in lower-tier crafting recipes."]
	quest.298927066BF04E33.quest_desc: ["You need more Tin Ingots!"]
	quest.298927066BF04E33.title: "More Tin!"
	quest.29B26595E063E884.quest_desc: ["Time to assemble the Mixer, a useful machine for combining fluids and items!"]
	quest.29B26595E063E884.title: "Mixer #1"
	quest.29DEECC08ED06BC9.quest_desc: ["Buy some reward!"]
	quest.29DEECC08ED06BC9.title: "Papers"
	quest.29FA20E5E471AB21.quest_desc: ["After harvesting a fully grown plant of Quartz Enriched Copper Seeds, you get Quartz Enriched Copper Essences."]
	quest.29FA20E5E471AB21.title: "Quartz Enriched Copper Essence"
	quest.2A101EB358C7C5B1.quest_desc: [
		"Batteries are a good way to store CF/FE/RF to move around. "
		"When holding them in hand, they can be sneak-right-clicked to put them into discharge mode. This means that they will charge any other items in your inventory."
	]
	quest.2A101EB358C7C5B1.title: "Batteries!"
	quest.2A218EB518DE9426.quest_desc: ["Buy some reward!"]
	quest.2A218EB518DE9426.title: "Souls"
	quest.2A2589B7EDFD1B0D.quest_desc: [
		"The Fluid Laser Relay is a wireless fluid transfer device. It moves liquids between tanks and machines without pipes, within a default range of 15 blocks."
		""
		"&a💡 Hint: Use a Laser Wrench to link relays easily!"
	]
	quest.2A2589B7EDFD1B0D.title: "The Fluid Laser Relay"
	quest.2A457DFC298FFDF1.quest_desc: [
		"For Silent Gear Patterns we need a bunch of sawdust. "
		"Use a Hammer to obtain sawdust from wooden planks."
	]
	quest.2A457DFC298FFDF1.title: "Sawdust"
	quest.2A45958CF7D830DF.quest_desc: [
		"To upgrade your Forge, place an Edelwood Plank in the center slot and surround it with 4 Arcane Crystals and 4 Spawner Scraps on the pedestals. "
		""
		"Once complete, your Forge will reach Tier II, allowing it to hold more Essences, unlock new Rituals, and support the use of a second Relic."
		""
		"Accept these valuable rewards!"
		""
		"&a💡 Hint: Use a Gavel to activate the process."
	]
	quest.2A45958CF7D830DF.title: "          Upgrading the Forge to Tier II.          "
	quest.2A51216D806AF2C7.quest_desc: ["Disenchanter is a block added by the Draconic Evolution mod. It can be used to remove enchantments from items. This is achieved by placing an enchanted item and a book in its GUI. The enchantment will be moved to the book after pressing the button in the GUI. This process costs a certain amount of experience, as well as cause damage to the item that is being disenchanted. The damage caused to the item can be reduced by placing Bookcases or charged draconium blocks around the Disenchanter."]
	quest.2A56771CB24A879F.quest_desc: [
		"It’s time to get off the ground — literally!"
		"This is your first step toward flight: basic frame and materials."
		"You’ll need these to build your very first Jetpack."
	]
	quest.2A56771CB24A879F.title: "Jetpack Components #1.1"
	quest.2A78666D4C3DEBAA.quest_desc: ["Silicon Essences can only be used to craft Silicon."]
	quest.2A78666D4C3DEBAA.title: "Silicon"
	quest.2A83A95EAA7E59BF.quest_desc: ["This is the fastest hook in minecraft!"]
	quest.2A97D96BFEC018E7.quest_desc: ["The Dislocator is used as a basic item for others."]
	quest.2AB9B3737731247D.quest_desc: ["Prisms play a key role in many Forbidden Arcanus recipes, as well as in other mods later on. To craft them, you'll first need Elementarium, a rare material found in Jungle Temples, Desert Pyramids, and Underwater Ruins. Keep an eye out for it while exploring!"]
	quest.2AE0311B9F9BF09A.quest_desc: ["After harvesting a fully grown plant of Alumite Seeds, you get Alumite Essences."]
	quest.2AE0311B9F9BF09A.title: "Alumite Essence"
	quest.2AE884FCCB905B24.quest_desc: ["Buy some reward!"]
	quest.2AE884FCCB905B24.title: "Inferium Apple"
	quest.2AF486C39E01112E.quest_desc: ["Buy some reward!"]
	quest.2AF486C39E01112E.title: "Processor Binding"
	quest.2B20A7B544700611.quest_desc: [
		"The Ultimate Circuit is a key component in many high-tier machines and items — and it comes with a hefty crafting cost. "
		""
		"&a💡 Hint: To save valuable resources, it’s best to craft it in a Assembler."
	]
	quest.2B25CD5BBE080D68.quest_desc: [
		"This machine separates elements from complex materials. It has two input slots (cells on the left, dusts on the right) and four outputs. It’s mainly used to extract pure elements — like iron and sulfur from pyrite, or lithium from clay."
		"Check the chemical formula of an item to predict the results!"
		""
		"&a💡 Hint: Use a wrench to dismantle this machine!"
	]
	quest.2B25CD5BBE080D68.title: "          Industrial Electrolyzer          "
	quest.2B2919EACD10CAD3.quest_desc: [
		"If you pour Liquid Concrete on the ground and let it dry, it will turn into Concrete Blocks."
		""
		"&a💡 Hint: Automate this with a Drying Basin or Mechanical Drying Basin for faster results!"
	]
	quest.2B2919EACD10CAD3.title: "Let It Dry"
	quest.2B73DB3F2CBACAE0.quest_desc: ["A key material for high-tech components like Atomic Alloys and Elite Circuits. Create it by infusing an Enriched Alloy with Diamond in a Metallurgic Infuser."]
	quest.2B73DB3F2CBACAE0.title: "Reinforced Alloy!"
	quest.2B7855185B9E2C8D.quest_desc: ["This machine digs downward in a configurable 5x5 area, powered by energy per mined block. It works in two modes: mine everything or just ores. You can stack up to 3 Range Boosters on top to expand its range, reaching a maximum 33x33 area."]
	quest.2B7909E512A0743F.quest_desc: ["Aluminum Essences can be used to craft Aluminum Ingots."]
	quest.2B7909E512A0743F.title: "Aluminum Ingots"
	quest.2B797F3BA0F40103.quest_desc: ["Buy some reward!"]
	quest.2B797F3BA0F40103.title: "Aureal Bottle"
	quest.2B9A8D15C83C5FC4.quest_desc: ["The Empowerer uses the Display Stand to empower things. Right-clicking it with an item will put that item into it, like an Item Frame."]
	quest.2B9A8D15C83C5FC4.title: "Display Stands"
	quest.2B9CF621B42853D8.quest_desc: ["Blaze Essences can be used to craft Blaze Rod and Magma Cream."]
	quest.2B9CF621B42853D8.title: "Blaze Rods"
	quest.2B9E9B31BF199A54.quest_desc: [
		"It requires rare and aquatic-themed components: Prismarine, Turtle Scute, Lapis Lazuli and a Heart of the Sea."
		"Gathering all of these won’t be easy."
	]
	quest.2BD2F3FC5CBD2D81.quest_desc: [
		"Oil is the foundation of all space-age fuels. Locate an oil source and extract it for processing.,"
		""
		"&aFill it with energy."
	]
	quest.2BF7D8979E8A5257.quest_desc: ["Time to move up! Start gathering the basic materials required to build your next-level jetpack."]
	quest.2BF7D8979E8A5257.title: "Jetpack Components #2.1"
	quest.2C0EC7DD0D3842FB.quest_desc: ["The Drill can be enhanced with various upgrades. Mining Upgrades increase the digging area, but each tier requires the installation of the previous one to function."]
	quest.2C0EC7DD0D3842FB.title: "Drill Upgrade!"
	quest.2C362D900F27FE0D.title: "180k NaK Coolant Cell"
	quest.2C449036B32D191A.quest_desc: ["With EvilCraft you can make the dead bush with the Sapling and Shears."]
	quest.2C5E8B7561FA98DF.quest_desc: ["Formed when Glowstone drips into lava and transforms under intense heat, Ostrum rises to the surface of the lava, waiting to be collected."]
	quest.2C5E8B7561FA98DF.quest_subtitle: "Ostrum on the Lava!"
	quest.2C5E8B7561FA98DF.title: "       Ostrum       "
	quest.2C9FFE2A5785ADF7.quest_desc: ["Golem Steel Ingot is an alloy of Cobalt, Bismuth, and a bit of Steel."]
	quest.2C9FFE2A5785ADF7.title: "Golem Steel Ingots"
	quest.2CA2C326206C5867.quest_desc: ["Let the following castings be:"]
	quest.2CA2C326206C5867.title: "More Cast!"
	quest.2CF1B683AC758523.quest_desc: ["Pressurized Tube for the transport of liquids from point A to point B."]
	quest.2CF1B683AC758523.title: "Transfer the Fluid"
	quest.2D018CA08DF73D2F.quest_desc: ["The Energy Flow Chip is the best and most expensive circuit you can build in this pack. It is used in several high end recipes!"]
	quest.2D10124356D14129.quest_desc: ["Use Cream and Salt to craft Butter."]
	quest.2D10124356D14129.title: "Butter"
	quest.2D29D78581661BB7.quest_desc: [
		"In the bottom-left corner of your screen is your mana bar — it shows how much mana you currently have."
		""
		"As you progress, you can expand your mana pool and improve spell efficiency. "
		"Upgrading your spellbook is one way to gain more mana!"
	]
	quest.2D29D78581661BB7.title: "Mana"
	quest.2D59EABDBA271C0C.quest_desc: ["Use more Dough to form a Sourdough."]
	quest.2D59EABDBA271C0C.title: "Sourdough"
	quest.2D6A2EA7261B28BC.quest_desc: ["The most powerful upgrade. Pushes machines to their full potential."]
	quest.2D8842C4D457B8E6.quest_desc: ["Use Pulverized Coal or Charcoal together with Diamond Dust to craft Carbon Fibre — an essential component for advanced machines."]
	quest.2D8842C4D457B8E6.title: "Carbon Fiber"
	quest.2DCFAE4371C5B374.quest_desc: ["Almost every biome has beautiful flowers. Collect Poppy and Dandelion flowers."]
	quest.2DCFAE4371C5B374.title: "Flowers"
	quest.2DEFBEF26C500DCF.title: "Umvuthi, the Sunbird"
	quest.2DFEB2024AC589CE.title: "Zombie Hunter"
	quest.2E112C0C6AF6827E.quest_desc: ["Prudentium Coal burns 3x longer than normal Coal!"]
	quest.2E112C0C6AF6827E.title: "Prudentium Coal"
	quest.2E3090E912D59E7C.quest_desc: ["Bottle of Milk... :)"]
	quest.2E3090E912D59E7C.title: "Milk Bottle"
	quest.2E58C61AAC432843.quest_desc: ["The Dragon Heart is obtained by killing the Ender Dragon or the Chaos Guardian. I think you already have one."]
	quest.2E6719CA68E44CA3.quest_desc: ["Chicken Sandwich is a simple yet satisfying meal made from cooked Chicken, Carrot and Sourdough Bread."]
	quest.2E6719CA68E44CA3.title: "Chicken Sandwich"
	quest.2E787399D0D93BCB.quest_desc: ["You have proven your culinary skills! As a true Master Cooker, you now deserve a special reward. Use a spawner to ensure you’ll never run out of meat again!"]
	quest.2E787399D0D93BCB.title: "Master Cook!"
	quest.2E93DB5BC1598D78.quest_desc: ["Oxygen is essential for survival in space, so always make sure to bring some with you."]
	quest.2EA282D1F7F5C4BF.quest_desc: ["Cucumber sandwiches must be delicious."]
	quest.2EA282D1F7F5C4BF.title: "Cucumber Sandwich"
	quest.2EBB9D5322293081.quest_desc: ["The Carry On mod allows you to pick up and move blocks and entities with ease. Simply &acrouch (Shift)&r and &aright-click&r to carry chests or even mobs. Simplify your tasks and keep everything within reach!"]
	quest.2EC46A252E3A1D89.title: "Wyvern Shield Modules"
	quest.2ED288B0F88FCE93.quest_desc: ["You can build Withert on the Stasis Chamber."]
	quest.2ED288B0F88FCE93.title: "Wither"
	quest.2ED79F7C762DF015.quest_desc: [
		"The Blood Extractor gathers blood from creatures when they take damage. Carry it in your inventory, and it will automatically store their life essence for later use."
		""
		"&9Upon completion of this quest you will unlock the chapter: &o\"Black Magic Tier I\""
	]
	quest.2ED79F7C762DF015.title: "     &9Unlock: &6&lBlack Magic Tier I.     "
	quest.2EE3425BE74A1C14.quest_desc: ["It's time to find saltpeter. If you mix it with sulfur you can create gunpowder."]
	quest.2EE3425BE74A1C14.title: "Saltpeter"
	quest.2EF69F8E2324F778.quest_desc: ["Battery Alloy is made by combining Lead and Antimony in a Foundry or in Alloy Furnace or later an Advanced Alloy Smelter."]
	quest.2EF69F8E2324F778.title: "Battery Alloy Ingots"
	quest.2F18B189D66D6A05.quest_desc: ["Now the simpler casing blocks for your multiblock structure."]
	quest.2F18B189D66D6A05.title: "Master Assambler 2k25 #3"
	quest.2F45C3AB6B7DABC9.quest_desc: ["Buy some reward!"]
	quest.2F45C3AB6B7DABC9.title: "Tier 1 Crafting Seeds"
	quest.2F5DE707FC7C03CF.quest_desc: ["Use Nature Essence to craft Cactus."]
	quest.2F5DE707FC7C03CF.title: "Cactus"
	quest.2F6B164D5C786AEC.quest_desc: [
		"A special workstation for crafting. Weak materials won’t work here :) !"
		""
		"Inspired by the Artisan Worktables mod and brought to life using Custom Machinery."
	]
	quest.2F7C62C0447FB687.quest_desc: ["The Copper Coil can be used for many things, for example for Motors or Generators."]
	quest.2F7C62C0447FB687.title: "Copper Coil"
	quest.2F7FF5F2D92C9E5E.quest_desc: ["Used to extend the range of blocks like the Range Booster or Vertical Digger. Up to 3 can be stacked directly on top of the target block, increasing its effect radius with each booster."]
	quest.2FD153293956EDDB.quest_desc: ["You need Ash and materials for Primitive Alloy Smelter. Collect some of them."]
	quest.2FD153293956EDDB.title: "Smelter #1"
	quest.3001B07888733F3F.quest_desc: [
		"Energy Batteries can be combined in any crafting grid, combining their maximum capacity and stored RF/FE. They can be combined to hold up to 655.000.000 RF in a single Battery!"
		""
		"&a💡 Hint: This battery only outputs energy when a redstone signal is supplied!"
	]
	quest.3001B07888733F3F.title: "2M Energy Storage?"
	quest.300DEA8A1780A0C4.quest_desc: [
		"The Refined Obsidian Ingot is not made by simply smelting the dust. Instead, it must be combined with Osmium before it can be processed."
		""
		"For better efficiency, you can also produce it using the Advanced Alloy Smelter."
	]
	quest.300DEA8A1780A0C4.title: "       Refined Obsidian Ingots       "
	quest.3021F142B7478322.quest_desc: ["Use Undead Planks and a Dark Gem to craft some Dark Sticks."]
	quest.3021F142B7478322.title: "Dark Sticks"
	quest.3035F04A36FC5516.quest_desc: [
		"The Altar of Birthing lets you create a wide variety of vanilla mobs."
		"Spirits of Birthing are made by breeding animals in areas with large amounts of aura. "
	]
	quest.3044C7039A5B52E6.quest_desc: ["There are many possible applications for sandstone. One of them is the press of paper."]
	quest.3044C7039A5B52E6.title: "Sandstone"
	quest.307329D59BB9B332.quest_desc: [
		"Stainless Steel Dust is a complex alloy that requires precision and balance."
		"Combine 6 Iron Grit, 1 Chrome Dust, 1 Nickel Dust, and 1 Manganese Dust in a Mixer to produce 9 units of this high-grade alloy powder."
	]
	quest.307329D59BB9B332.title: "Stainless Steel Dusts #1"
	quest.30802DEB7DBBD1D7.quest_desc: ["Ender Tanks share their fluids with other tanks that have the same color combination on top. Right-click the 3 color buttons with dyes to set the code. Perfect for cross-dimensional fluid transport!"]
	quest.30802DEB7DBBD1D7.title: "Ender Tank!"
	quest.30BE4EA030F0030C.quest_desc: ["To Craft Bricks you need tons of clay. Let's make some in advance!"]
	quest.30BE4EA030F0030C.title: "Bricks"
	quest.30C82010A1053172.quest_desc: ["Cables are essential for linking Refined Storage devices. They carry both data and power, allowing machines and grids to communicate as part of your network."]
	quest.30C82010A1053172.title: "Connect Everything"
	quest.30EBA371DEC241AB.quest_desc: ["Buy some reward!"]
	quest.30EBA371DEC241AB.title: "Leathers"
	quest.3103C7A6C978E6BD.quest_desc: [
		"The Mystical Furnace is no ordinary furnace. Built for efficiency, it smelts items faster than the standard furnace and supports upgrades to enhance its performance. "
		"\"Craft your first Mystical Furnace and start upgrading it to unlock its full potential!\""
	]
	quest.3103C7A6C978E6BD.title: "Upgrade the Furnace"
	quest.310660651CFEE40B.quest_desc: [
		"The Placer places blocks in front of it. It can be oriented in every direction."
		""
		"When right-clicking it with a Redstone Torch in hand, it will change between a mode where it gets deactivated by Redstone and a mode where it responds to pulses."
	]
	quest.310F9E77A3CA5C08.quest_desc: ["Craft a few Silicon Seeds."]
	quest.3119F0E8A845E554.quest_desc: ["Mix Electrotine Dust with an Iron Ingot to obtain Electrotine Iron Compound."]
	quest.31361D8B987FEDD7.quest_desc: ["The Oxygen Tank stores breathable oxygen, allowing you to survive in space or other airless environments."]
	quest.31361D8B987FEDD7.title: "Oxygen Tanks"
	quest.313C2CE641C92C83.quest_desc: ["You will find Galena in the middle, a strong material."]
	quest.313C2CE641C92C83.title: "Galena"
	quest.315705B66B578384.quest_desc: ["Craft the Axe."]
	quest.3179EC81D27B834E.quest_desc: ["Clibano is a special Multiblock Smelter. It is used to efficiently produce Arcane Crystal Dust and Obsidiansteel Ingot."]
	quest.3179EC81D27B834E.title: "Clibano #1"
	quest.31A0F6977F11668F.quest_desc: ["Tier 1 Crafting Seeds can't be planted. They're used only for crafting higher-tier seeds—your first step toward growing powerful resources!"]
	quest.31A0F6977F11668F.quest_subtitle: "Crafting Seeds"
	quest.31B0BFE9FA7EBA64.quest_desc: ["The Chisel is your key to creativity! Use it to transform ordinary blocks into stunning decorative patterns and make your builds truly unique. Craft your first Chisel and let the designs flow!"]
	quest.31B0BFE9FA7EBA64.quest_subtitle: "Shape Your World!"
	quest.31BDD172BE74511F.quest_desc: ["Craft a Copper Saw. In the beginning, this will be your most useful tool."]
	quest.31BDD172BE74511F.title: "Saw"
	quest.31C92F3570B0260E.quest_desc: [
		"Your journey has led you to the heart of the Void. The Chaos Guardian is the final test of your godhood, located on the desolate Chaos Islands far out in The End."
		""
		"The Battle Mechanics:"
		""
		"Immunity: The Guardian is healed and protected by several crystals scattered across the island. You must destroy these first."
		""
		"Shielded Crystals: Each crystal has 50 HP and will generate a protective shield for 5–10 seconds upon taking damage. Warning: Attacking a shielded crystal will refresh its invulnerability timer. Patience is key."
		""
		"The Aftermath: Once the Guardian falls, you may claim the Chaos Crystal at the island's core. But beware: once the crystal is harvested, the entire island will destabilize and explode. Take the shards and run!"
		""
		"&2Thank you so much for playing this modpack!"
	]
	quest.31C92F3570B0260E.title: "&6Chaos Guardian"
	quest.31CECD8A21F12360.quest_desc: ["It is crafted from 9 Sawdust, and can be smelted into Charcoal or hammered to a Pattern."]
	quest.31CECD8A21F12360.title: "Compressed Sawdust"
	quest.31DD6A54A28BBA12.quest_desc: ["Thermal Springstone Essences can be used to craft Thermal Springstone Ingots."]
	quest.31DD6A54A28BBA12.title: "Thermal Springstone Ingot"
	quest.31F6E3EDFD7DDCCA.quest_desc: ["Diamond Essences can be used to craft Diamond Ingots."]
	quest.31F6E3EDFD7DDCCA.title: "Diamond"
	quest.320ABE05B4006EFA.quest_desc: ["HE Mox Ingots are created by combining End Steel, Neptunium, and Azure Silver Ingots."]
	quest.320ABE05B4006EFA.title: "HE Mox Ingot!"
	quest.320D469370B65E34.quest_desc: ["The Crusher is a machine from Actually Additions that allows you to break down materials into finer components, doubling dust output from ores."]
	quest.324FFEC646F9E3CD.quest_desc: ["Azure Silver Ore can be found on the End islands, though it is quite rare. It is formed from the lingering magical energies present within the End's ancient terrain."]
	quest.324FFEC646F9E3CD.title: "       Azure Silver!       "
	quest.32590FAB96D5725A.quest_desc: ["The Straw is used to consume liquids from tanks and in-world. It may also be used to consume fluids from a machine's internal tank by shift right clicking. Fluids from Industrial Foregoing will inflict various status effects when consumed."]
	quest.32590FAB96D5725A.title: "Straw"
	quest.326F6D099C55B765.quest_desc: ["After harvesting a fully grown plant of Diamond Seeds, you get Diamond Essences."]
	quest.326F6D099C55B765.title: "Diamond Essence"
	quest.327F92B0428585CA.quest_desc: [
		"Together with the ritual, knowledge of Tokens can be gained. These figurines contain a combination of the vast power of Aura itself and the power of the emotions they represent."
		""
		"Use a Bottle and Cork in the Nether by right-clicking the air during daytime to obtain a Bottled Ghosts."
	]
	quest.327F92B0428585CA.title: "Token of All :)"
	quest.32843DFC6CDEA330.quest_desc: ["You can create Unobtainium by mixing Green Xychorium, Red Xychorium Gems and Ovium in a Advanced Alloy Smelting Factory."]
	quest.32843DFC6CDEA330.title: "Unobtainium!"
	quest.3284E198A5E66570.title: "Ghast Hunter"
	quest.329069E7079CFBA0.title: "Wither Skeleton Hunter"
	quest.3295CE634F0E2D59.quest_desc: [
		"When starting your farm, you'll need seeds. They can be obtained by breaking grass."
		"\"Wild\" rice occasionally is found near bodies of water."
	]
	quest.3295CE634F0E2D59.title: "Seeds"
	quest.32CC2E9BFDD1C654.quest_desc: ["Next step: Skillet"]
	quest.32D71274E0E97021.quest_desc: ["The Crystallized Canola Seed is used to create Crystallized Oil. One Canola Seed can be converted to one Crystallized Canola Seed in an Atomic Reconstructor."]
	quest.32D71274E0E97021.title: "Efficient Energy Source!"
	quest.32F6548E6774CB21.quest_desc: ["Ok, let's go on with... Bellpepper!"]
	quest.32F6548E6774CB21.title: "Bellpepper"
	quest.331EA9A61CE214E7.quest_desc: ["Ruby is a gem added by Tech Reborn mods. Collect more of it!"]
	quest.331EA9A61CE214E7.title: "Ruby!"
	quest.3322F77DD01107D5.quest_desc: [
		"Put in the Furnace a Arcane Crystal to obtain Arcane Crystal Dust."
		""
		"To get the Mundabitur Dust, you need to survive at least 3 nights to get Phantom Membrane and you need to craft various other things."
	]
	quest.3322F77DD01107D5.title: "Crystal Dusts"
	quest.3323AF6A463ACD54.quest_desc: ["Find the right place for your house."]
	quest.3323AF6A463ACD54.title: "Set Home?"
	quest.3343E0BFEA2F1029.quest_desc: ["Fish is a versatile food that can be cooked or used as an ingredient in many recipes. You can obtain it by fishing in any body of water or through mob drops like Cod or Salmon."]
	quest.3343E0BFEA2F1029.title: "Fish!"
	quest.334C59E225DDC0D7.quest_desc: ["The Creative Energy Cube stores and outputs an infinite amount of energy, and can be used as a charging station for items."]
	quest.334C59E225DDC0D7.title: "&6Creative Energy Cube"
	quest.33684640750DE19D.quest_desc: [
		"Thrusters provide the lift you need."
		"Crafting them is crucial to complete your Jetpack. They burn through fuel fast, so plan ahead!"
	]
	quest.33684640750DE19D.title: "Iron Thrusters"
	quest.33827ED1BBD968F0.quest_desc: ["Nuke is an item added by the Modern Industrialization mod. It can ONLY be used for higher-level crafting, it does not explode."]
	quest.33827ED1BBD968F0.title: "Nuke"
	quest.33A11A6BAD649E6C.title: "Vex Hunter"
	quest.33AABB583377BFE4.quest_desc: ["Time to get more White and Black Magic dust!"]
	quest.33AABB583377BFE4.title: "Magic Dust!"
	quest.33BCD7019C69A91F.quest_desc: [
		"The Foundry is a multi-block structure used for melting and alloying metals. To build a functional Foundry, you’ll need at least the following components:"
		""
		"- 9 Fire Bricks (minimum for the base layer),"
		"- a Foundry Controller,"
		"- a Foundry Tank,"
		"- a Foundry Drain,"
		"- a Foundry Tap"
		"- and 9 Liquid Heating Coils placed directly under the base layer"
		""
		"This setup forms a single-layer Foundry, which is the minimum required for operation. However, you can expand it vertically by adding more layers of Fire Bricks — doing so increases its capacity, allowing it to hold more molten materials at once."
		""
		"You don’t need to fill in the corner blocks — they can be left empty without affecting functionality."
		""
		"&a💡 Hint: For more information, hold W while hovering over Foundry components in your inventory."
	]
	quest.33BCD7019C69A91F.title: "                    Foundry!                    "
	quest.33BDE312940132B5.quest_desc: ["Buy some reward!"]
	quest.33BDE312940132B5.title: "Loot Bags"
	quest.33DED49AD30E14E0.quest_desc: [
		"These components focus on energy handling and control."
		"Without them, your Jetpack won’t function."
		"Keep assembling — you're almost airborne!"
	]
	quest.33DED49AD30E14E0.title: "Jetpack Components #1.2"
	quest.33EC15EBA87DE783.quest_desc: ["The mixing of Obsidian Dust and Diorite Dust is required to produce Hardened Glass."]
	quest.33EC15EBA87DE783.title: "Obsidian and Diorite dust"
	quest.340A8D4D1DECA521.quest_desc: ["After harvesting a fully grown plant of Aluminum Seeds, you get Aluminum Essences."]
	quest.340A8D4D1DECA521.title: "Aluminum Essence"
	quest.3413C9F63A45F353.quest_desc: [
		"Corrupt Souls are rare drops you can collect by defeating mobs with a weapon that has the Soul Looting enchantment."
		"Right-click an Oak Sapling with a Corrupt Soul to convert it into a Growing Edelwood."
		""
		"&aThis can be a lengthy task."
	]
	quest.3413C9F63A45F353.title: "Edelwood Sapling"
	quest.342F83701D9430D2.quest_desc: ["The Centrifuge splits items by spinning them very fast."]
	quest.3435B05DFEA6FB09.quest_desc: ["To make the Poison Arrows you need Poisonous Potato first."]
	quest.3435B05DFEA6FB09.title: "Poisonous Potato"
	quest.3438918D38776821.quest_desc: ["Slag is a material obtained as a byproduct from Arc Furnace or Blast Furnaces."]
	quest.3438918D38776821.title: "Slag"
	quest.3457ADE5ED3D3D84.quest_desc: ["Wooden chests are a thing of the past! It's time to upgrade to a more durable and spacious Copper Chest!"]
	quest.3457ADE5ED3D3D84.title: "Upgrade Your Storage #1!"
	quest.3463115DBED78EEF.quest_desc: ["Gavel uses for finishing Rituals, just Right Click the Forge with it!"]
	quest.347313A134593846.quest_desc: ["Cotton Seeds, added by Pam's HarvestCraft, can be obtained by breaking tall grass or by breaking existing Cotton plants.. Once planted, they grow into cotton plants, providing a renewable source of string and wool."]
	quest.347313A134593846.title: "Cotton Seeds"
	quest.3480884BFC51AF7B.quest_desc: ["Electrotine Essences can only be used to craft Electrotine Alloy Ingots."]
	quest.3480884BFC51AF7B.title: "Electrotine Alloy Ingot"
	quest.34866E9EE4A61A01.quest_desc: ["The Draconium Fusion Crafting Injector is the first tier of Fusion Crafting Injectors used in the Fusion crafting process."]
	quest.34866E9EE4A61A01.title: "Draconium Fusion Crafting Injector"
	quest.34C941EDBB920565.quest_desc: [
		"The Aura Cache will prove useful: It stores a substantial amount of Aura in it so one can use it on the go."
		""
		"To fill the cache up, simply place it on a Natural Altar and wait for the Aura to draint into it."
	]
	quest.34ED977B15DCF6A9.quest_desc: [
		"Ovium is used in many recipes and can be mined—though you probably don’t have the tools for that just yet."
		"No worries! You can produce it by combining Marble and Galena instead."
	]
	quest.34ED977B15DCF6A9.title: "Ovium"
	quest.352DC96DC4E24428.quest_desc: [
		"Refined Glowstone Ingots created by combining Energetic Blend and Osmium in a Rolling Machine. "
		"For better efficiency, you can also produce it using the Advanced Alloy Smelter."
	]
	quest.352DC96DC4E24428.title: "Refined Glowstone Ingots!"
	quest.3533B58077C1D293.quest_desc: ["Stone tools are the foundation of your survival. Craft essential stone tools and a Furnace to begin your journey toward survival and progress."]
	quest.3533B58077C1D293.title: "Stone Age!"
	quest.3542CEB3047E92BB.quest_desc: ["Alumite is an alloy made by combining 5 Aluminium, 2 Iron, and Obsidian in a Foundry. It's a durable material often used for mid-tier tools and parts."]
	quest.3542CEB3047E92BB.title: "Alumite Ingots"
	quest.358B57DD5BE88AF1.quest_desc: ["Craft a few Menril Seeds."]
	quest.35936C70BCCB8FF2.quest_desc: [
		"The Planet Eater does not use durability."
		""
		"Shift right-clicking with the Planet Eater will put it into \"destroyer\" mode, and shift right-clicking again will put it back into normal mode. Breaking a block with destroyer mode active will destroy all dirt blocks in an 17x17x17 cube."
		"Instead of dropping all of those items, one Matter Cluster will be dropped with all of the items inside of it to avoid lag."
	]
	quest.359413C89649132E.quest_desc: ["Iron is essential for your journey! Mine Iron Ore and smelt it into your first Iron Ingots to kickstart your progress."]
	quest.359413C89649132E.title: "Basic &dMetals #2"
	quest.35968FEC92152E52.quest_desc: [
		"The Edelwood Tree has a hollow trunk, similar in size and function to a Cauldron."
		"At the top, you’ll find a Carved Edelwood Log, with Edelwood Branches extending from it."
		"These branches drop Edelwood Sticks when broken."
	]
	quest.35968FEC92152E52.title: "Edelwood Logs"
	quest.35A424C1318144BE.quest_desc: ["Craft some bullets for your sentry turret."]
	quest.35A9050D6067068E.quest_desc: ["This material has an Obsidian Tier. This means that you can extract Obsidian with it."]
	quest.35A9050D6067068E.title: "Infused Iron Pickaxe Head"
	quest.35CA194CA113CCF4.quest_desc: [
		"So far, crafting blocks required using the Blacksmith’s Workshop. With the Electric Packer, you can now automate this process more easily. "
		"It allows compacting items into blocks using energy instead of manual crafting, simplifying your resource processing chains."
	]
	quest.35CA194CA113CCF4.title: "          &eEasily Compression!          "
	quest.35D170D4371BF464.quest_desc: ["Sandy Glass is crafted from Sand (of any kind) and Glass. It is used mainly to create Acrylic Glue!"]
	quest.35D170D4371BF464.title: "Sandy Glass"
	quest.35DD00EF065AEC58.quest_desc: ["Use your chisel to convert Stone to Smooth Stone from natura. It'll give you some practice."]
	quest.35DD00EF065AEC58.title: "Fancy Stones!"
	quest.35E14648C2775D42.quest_desc: [
		"A whole new world of danger and resources awaits."
		"Step through the portal and explore the Nether—but be prepared, it’s not a friendly place!"
	]
	quest.35E14648C2775D42.title: "Visit the Nether!"
	quest.35EB7C3EB52BA1F1.quest_desc: ["Buy some reward!"]
	quest.35EB7C3EB52BA1F1.title: "Tertium Farmland"
	quest.36295B7F64B09F7E.quest_desc: ["Industrial Machine Frames are the highest tier of machine frames in Tech Reborn and are used to craft high end machines and parts."]
	quest.36295B7F64B09F7E.title: "Industrial Machine Frames"
	quest.3646C10E1E309BCD.quest_desc: ["Creating Infused Rock, an earthly material infused with Aura."]
	quest.3646C10E1E309BCD.title: "Infused Rock \\& Ancient Log"
	quest.3679EAE8F6A256E0.quest_desc: ["The Red Alloy Ingot is an item added by More Red and is the basic element for a lot of recipes!"]
	quest.3679EAE8F6A256E0.title: "Red Alloy Ingots"
	quest.36B726E6F266DCD9.quest_desc: ["The Fluid Extractor is an essential machine for industrial fluid production. It can extract valuable liquids from various items, such as latex from logs or methane from organic materials. Start extracting and fuel your industry!"]
	quest.36C106E276EDD847.quest_desc: ["Buy some reward!"]
	quest.36C106E276EDD847.title: "Ink Sac"
	quest.36C36B1AB4A0D79D.quest_desc: ["First, we need to gather Light Engineering Blocks, Redstone Engineering Blocks, a cauldron, and Graphite Electrodes."]
	quest.36C36B1AB4A0D79D.title: "Light Engineering Block"
	quest.36E25F985F25B6A4.quest_desc: ["Boosts essence output even further. Needed for advanced crop tiers."]
	quest.36E25F985F25B6A4.title: "&eTertium Farmland"
	quest.371B140C9605BAA5.quest_desc: [
		"The dust alone isn't enough — it must be refined at extreme heat."
		"Insert the Stainless Steel Dust into an Industrial Blast Furnace with at least 3120 Heat Capacity to obtain Stainless Steel Ingots, used in high-tier machinery and casings."
	]
	quest.371B140C9605BAA5.title: "Stainless Steel Dusts #2"
	quest.3768994B7E4C3A8D.quest_desc: ["A soft and chewy rice cake, great as a sweet snack or a special ingredient in your finest dishes."]
	quest.3768994B7E4C3A8D.title: "Mochi"
	quest.37A897CB168FB38B.quest_desc: ["The Elite Craftingtable is used to craft advanced machines and tanks using a 7x7 crafting grid."]
	quest.37A897CB168FB38B.title: "&dElite Craftingtable!"
	quest.37A96304D387ED15.quest_desc: ["Copper Essences can be used to craft instant Copper Ingots."]
	quest.37A96304D387ED15.title: "Copper"
	quest.37D03178372E4C42.quest_desc: ["The Master Assembler 2k25 is a 3x3 Multiblock machine that makes it possible to craft high-tier materials much more efficiently. Each process consumes a small amount of Lubricant. The machine also has an additional liquid input for Boosting Mixture to increase the efficiency even more."]
	quest.37D03178372E4C42.title: "Master Assambler 2k25 #1"
	quest.37E5DDF17D18A230.quest_desc: ["Buy some reward!"]
	quest.37E5DDF17D18A230.title: "Extractor"
	quest.385053C333A9021A.quest_desc: ["Caramel is made by cooking sugar until it melts and browns, creating a sweet and rich ingredient. It's used in various dessert recipes and can also enhance the flavor of more complex dishes."]
	quest.385053C333A9021A.title: "Caramel"
	quest.389166996B29F31F.quest_desc: ["The Cupronickel Heating Coil is a component item added by Tech Reborn, used in the crafting of the Industrial Blast Furnace. "]
	quest.389166996B29F31F.title: "Heating Coils"
	quest.38A281F48604BEED.quest_desc: ["Collect some Leathers."]
	quest.38A281F48604BEED.title: "Magic Utensils #1"
	quest.38C3376C6D56CB1E.quest_desc: ["The next tier Solar Panel generate 8192 RF/FE/t when receiving light."]
	quest.38D53F333C4BBD37.quest_desc: ["The Crafting Grid combines storage access with a crafting table. It pulls items directly from your network and shows available resources while you craft."]
	quest.38D53F333C4BBD37.quest_subtitle: "Complete Plastic Sheets Quest"
	quest.38DE6448C7DF45D2.quest_desc: [
		"A Brewing Stand is used for brewing potions, splash potions and lingering potions."
		""
		"&aYou need these chapters:"
		"&a-&o \"Ores and Alloys\" Tier I. for Bronze"
		"&a-&o \"White Magic\" Tier I. for Infused Iron Ingot"
	]
	quest.3917661C153F01C0.quest_desc: [
		"The Draconic Chestpiece is a massive leap forward in modular technology, featuring a significantly higher capacity for Upgrade Modules and vastly increased internal energy storage."
		""
		"This tier allows for the installation of Draconic-level upgrades, which are far more potent than their Wyvern counterparts. With this equipped and fully upgraded, you cease to be a mere explorer and become an unstoppable force."
	]
	quest.391CA3550E199E6E.quest_desc: [
		"Thermal Springstone Ingot is a powerful ingot created in the Hephaestus Forge Tier 5."
		"To craft it, you’ll need Infused Diamond, Infused Ender Pearl, Stellarite Piece, and Deorum Ingot, with a Depth Ingot placed at the center."
	]
	quest.391CA3550E199E6E.title: "Thermal Springstone!"
	quest.39281323ED67AEE9.quest_desc: ["Buy some reward!"]
	quest.39281323ED67AEE9.title: "Wither Skeleton Skull"
	quest.392925341AAF97E6.quest_desc: ["Get some black paint. You either kill squid or pick flowers."]
	quest.392925341AAF97E6.title: "Black dye"
	quest.39850997A8DBC712.quest_desc: ["The Disk Drive stores up to 8 item or fluid disks for your Refined Storage network. You can set priorities, filter items by type or tag, and choose to void overflow if needed."]
	quest.39850997A8DBC712.title: "Digital Storage"
	quest.3994C2426485ECF3.quest_desc: ["Ok, let's go on with... Spiceleaf!"]
	quest.3994C2426485ECF3.title: "Spiceleaf"
	quest.399909C2BB3DD9E9.quest_desc: ["After harvesting a fully grown plant of Steel Seeds, you get Steel Essences."]
	quest.399909C2BB3DD9E9.title: "Steel Essence"
	quest.39AF0FD72DD0E44D.quest_desc: ["Make a Red Alloy Ingot from a mixture of Redstone Dust and Iron Ingots."]
	quest.39AF0FD72DD0E44D.title: "Red Alloy Ingots"
	quest.39B88B448B44FAC4.quest_desc: [
		"Cans are items that can store food and can be used in various recipes. There are two differents type of cans:"
		"-Small: can contain maximum 10 nutrition"
		"-Regular: can contain maximum 20 nutrition"
	]
	quest.39B88B448B44FAC4.title: "Tin Can"
	quest.39B976DC4F7190D6.quest_desc: ["Soft, sweet treats that are perfect for a snack or a special recipe."]
	quest.39B976DC4F7190D6.title: "Marshmellows"
	quest.39CDC0E405C2D56B.quest_desc: ["Blaze Gold Dust is normally used as a catalyst in the Starlight Charger from Silent Gear. However, in this modpack, it plays a more significant role — it’s also a key ingredient in multiple important recipes. Keep a stock of it ready!"]
	quest.39CDC0E405C2D56B.title: "Blaze Gold Dusts"
	quest.39F1A1B707DE7504.quest_desc: [
		"The rituals require different Essences. Collect some of each!"
		""
		"To collect Souls, you can either defeat Lost Souls that roam the Dark Forest in Overworld, or craft a Soul Extractor using some Nether materials and an Utrem Jar, which requires Edelwood."
		"Once crafted, simply hold right-click with the Soul Extractor on Soul Sand to extract Souls directly."
	]
	quest.39F1A1B707DE7504.title: "Souls"
	quest.3A0D2AE4DD5145AE.title: "The Harbringer"
	quest.3A1783500D5F6E45.quest_desc: [
		"The highest tier of essence."
		"Used to craft the most powerful items and seeds in Mystical Agriculture."
	]
	quest.3A1783500D5F6E45.title: "&eInsanium Essence"
	quest.3A2773CCE8955B35.quest_desc: ["And FINALLY the drill itself. Set it to 13x13x13 and have fun!"]
	quest.3A2773CCE8955B35.title: "&6Infinity Drill!"
	quest.3A3EED2F48DB4D7D.quest_desc: ["The Fusion Crafting Core is the center of the multi-block Fusion Crafting setup. Its purpose is to hold the item to be transformed."]
	quest.3A530AC1779A5C28.quest_desc: ["Mix Copper Grit with Tin Dust to obtain Bronze Dusts."]
	quest.3A530AC1779A5C28.title: "Bronze Dust!"
	quest.3A5E9CD1970EB812.quest_desc: ["Prosperity Shards are essential for crafting Inferium Ingots. These versatile resources form the backbone of your mystical journey."]
	quest.3A5E9CD1970EB812.title: "Prosperity"
	quest.3A7A1C84F01D24D7.quest_desc: ["The Drying Basin is a functional block designed to solidify liquids into tangible items. It can transform water into salt blocks or convert liquid honey into honey blocks, making it a useful tool for resource processing."]
	quest.3AA956EECC91A1FF.quest_desc: ["Coal Essences can be used to craft Coal."]
	quest.3AA956EECC91A1FF.title: "Coal"
	quest.3AC9BF14C6E015B5.quest_desc: ["Placing grass in different positions in the crafting grid gives you different seeds!"]
	quest.3AC9BF14C6E015B5.title: "Corn Seeds"
	quest.3ADC7E3F03AB9966.quest_desc: ["A versatile ingredient used in various food recipes. Smooth and rich, perfect for enhancing flavors."]
	quest.3ADC7E3F03AB9966.title: "Cream"
	quest.3AF848D10ED88AAC.quest_desc: ["And finally put the Solid Glue Cell in the Furnace to get Acrylic Glue Cell."]
	quest.3AF848D10ED88AAC.title: "Acrylic Glue!"
	quest.3B11FE1333DF11CC.quest_desc: ["Titanium Essences can be used to craft Titanium Ingots."]
	quest.3B11FE1333DF11CC.title: "Titanium Ingot"
	quest.3B127EBE806FB302.quest_desc: ["You’ll notice copper ore is more common than iron. Take advantage of that early on—you're going to need a lot of it!"]
	quest.3B127EBE806FB302.title: "Copper!"
	quest.3B29BBCC325594F6.quest_desc: ["Buy some reward!"]
	quest.3B29BBCC325594F6.title: "Inferium Seeds"
	quest.3B3E6DF7033D7290.quest_desc: ["Uranium Essences can be used to craft Uranium Ingots."]
	quest.3B3E6DF7033D7290.title: "Uranium Ingot"
	quest.3B448D9559BB52A9.quest_desc: ["The Blood Infusion Core is a crucial component used in crafting the Blood Infuser. "]
	quest.3B49ABEEC21977CA.quest_desc: ["Obsidian Plates are mainly used for TechReborn Industrial Machine Casings."]
	quest.3B49ABEEC21977CA.title: "Obsidian Plates"
	quest.3B8FDCC95022AC40.quest_desc: ["After harvesting a fully grown plant of Sulfur Seeds, you get Sulfur Essences."]
	quest.3B8FDCC95022AC40.title: "Sulfur Essence"
	quest.3B96A454BA275E1D.quest_desc: ["The Soulium Dagger increases the chance of getting Mob Chunks when slaying creatures—essential for crafting mob seeds."]
	quest.3B9C582DA79D5E8F.quest_desc: ["Craft a few Ruby Seeds."]
	quest.3BB86C3D2F342238.quest_desc: ["Gunpowder is an item that is used for explosive-related actions. Creepers have a chance of dropping up to 2 pieces of gunpowder upon death. Combine sulfur + saltpeter to craft it."]
	quest.3BB86C3D2F342238.title: "Gunpowder"
	quest.3BBFB6E04A9ACE2A.quest_desc: ["Time for the next Jetpack upgrade!"]
	quest.3BD50BB72D5718CA.title: "Okra Creole"
	quest.3BD801AEE077F33A.quest_desc: [
		"Let your journey begin by crafting the Novice Spell Book, your guide to this new world of arcane potential."
		"This is where you create and store your spells."
		""
		"&a💡 Hint: Only Tier 1 glyphs can be used with this spellbook — upgrade it to unlock stronger spells."
	]
	quest.3BD801AEE077F33A.quest_subtitle: "First Spell Book"
	quest.3BDFEB7801503241.quest_desc: [
		"The Copper Cable from Tech Reborn can transport energy to your machines."
		""
		"&cBut they are dangerous without insulation!"
	]
	quest.3BDFEB7801503241.title: "Transfer the Energy!"
	quest.3BE8702DD51BC547.quest_desc: ["Craft a Thermal Springstone Seed!"]
	quest.3BFFC1B20B323C08.quest_desc: ["Use the Mixer to craft Liquid Concrete. This fluid is essential for many advanced constructions, so it’s a good idea to start stockpiling it now — you'll need a lot of it later!"]
	quest.3BFFC1B20B323C08.title: "Liquid Concrete"
	quest.3C03A6FBA005046D.quest_desc: ["Quartz Enriched Copper Essences can be used to craft Quartz Enriched Copper Ingots."]
	quest.3C03A6FBA005046D.title: "Quartz Enriched Copper Ingots"
	quest.3C38AD5E4E6432A3.quest_desc: ["A refreshing and sweet blend of apples, perfect for a quick energy boost. Smooth, cool, and delicious!"]
	quest.3C38AD5E4E6432A3.title: "Smoothieee"
	quest.3C8203117A8A8693.quest_desc: [
		"The Smelter Prism is one of the most useful results of these rituals. To craft it, place 4 Blaze Powder, 2 Coal, and an Arcane Crystal Block on the pedestals, and don’t forget to include the Elementarium Relic."
		"Once created, the Smelter Prism can be applied to tools, allowing them to smelt blocks as they’re harvested — like turning Raw Ore into Ingots, Logs into Charcoal, or Sand into Glass instantly."
	]
	quest.3C8D129D7F44B926.quest_desc: ["Ok, let's go on with... Grape!"]
	quest.3C8D129D7F44B926.title: "Grape"
	quest.3C8DD31E38E2AA84.quest_desc: ["After harvesting a fully grown plant of Neutronium Seeds, you get Neutronium Essence."]
	quest.3C8DD31E38E2AA84.title: "Neutronium Essence"
	quest.3CA30228139D2590.quest_desc: ["When building a reactor larger than 5x5x5 (starting at 6x6x6), Reinforced Reactor components are required instead of Basic ones. These allow for much larger builds — up to a maximum size of 32x32x48. Make sure you're using the correct parts for your desired scale!"]
	quest.3CA30228139D2590.title: "Reinforced Reactor Structure"
	quest.3CAB8F57CC268FE8.quest_desc: [
		"EvilCraft adds only one new ore to the world generation, called dark ore. "
		"This ore spawns from Y-levels 0 to 66 and drops dark gems upon breaking. You will at least need an iron tier pickaxe (mininglevel diamond) to mine it and fortune does have an effect on the drop rate. "
		""
		"&a💡 Hint: If you haven't found an Iron Pickaxe somewhere, you should unlock the Blacksmith's Workshop to craft one."
	]
	quest.3CAB8F57CC268FE8.title: "               Dark Gems               "
	quest.3CE1EAFE9F407B1D.quest_desc: [
		"The Particle Generator has multiple functions:"
		""
		"It can create customizable particles around it."
		"It can be used with an Energy Core to create energy storage"
		"It is used as a component in a few crafting recipes such as the Energy Infuser."
	]
	quest.3CE1EAFE9F407B1D.title: "Particle Generator"
	quest.3CE26B0AF4554A24.quest_desc: ["The Draconic Fusion Crafting Injector is the third tier of Fusion Crafting Injectors used in the Fusion crafting process."]
	quest.3CE26B0AF4554A24.title: "Draconic Fusion Crafting Injectors"
	quest.3CE7F1A15D4A9053.quest_desc: ["A specialized alloy made from a combination of advanced materials. It’s primarily used to craft machine casings and internal components for high-tier multiblock machines. Essential for progressing into late-game tech!"]
	quest.3CE7F1A15D4A9053.title: "Modularium"
	quest.3D78935051A2A14F.quest_desc: [
		"Fusion Crafting is a ritual-like method of crafting added by Draconic Evolution and is used to create higher tier materials and tools/armor from this mod."
		""
		"To begin, place the Fusion Crafting Core in a central location and surround it with Fusion Crafting Injectors pointing inward."
		""
		"Installation Parameters:"
		"Distance: Injectors must be at least 1 block away and no more than 16 blocks from the Core."
		""
		"Alignment: They can be offset by one block in any direction relative to the Core's axis. (Check the in-game documentation for a visual guide)."
		""
		"Power: Every Injector must be connected to a stable RF/FE power source."
		""
		"The Crafting Process: Once started, the Injectors will draw energy, creating sparks and energy bubbles around the ingredients. When the energy saturation is complete, the power will surge toward the Core to finalize the craft."
		""
		"Safety Protocol: If the process is interrupted, don't panic! The Core retains all progress, meaning no materials or energy will be lost."
	]
	quest.3DA45D471B8CBA6E.quest_desc: ["Bauxite Ore can be found underground at Y-levels -64 to 32. It is mainly used to produce Aluminum. If you smelt the ore in a furnace, you will get Raw Bauxite."]
	quest.3DA45D471B8CBA6E.title: "Bauxite"
	quest.3DC706CA3C2818C8.quest_desc: [
		"Converts ores or shards into clumps using Oxygen. Ores yield 3 clumps—greatly boosting resource output."
		""
		"Clumps can be processed further into dusts for tripled ingot production!"
	]
	quest.3DCDD5EF4AF091FD.quest_desc: ["Rover is a vehicle added by the Stellaris mod. To be able to craft the rover you need some Titanium Large Plates which can only be crafted if you have already collected Mercury Solerium Ore on the planet Mercury."]
	quest.3DDA85638B01FEEC.quest_desc: [
		"Uses power to split certain liquids, like water, into gases such as Hydrogen and Oxygen. This process is key to many Mekanism machines and crafting recipes."
		"Ensure it has energy and a steady fluid input to keep running."
	]
	quest.3DDDBAC2B8EA0410.quest_desc: [
		"The Reactor Fuel Rods must be placed inside the reactor’s casing and will hold the fuel required for operation."
		""
		"The Reactor Control Rods go directly on top of each Fuel Rod, forming part of the outer structure of the reactor. They regulate how much fuel is used during operation, helping control power output and efficiency."
	]
	quest.3DDDBAC2B8EA0410.title: "Reactor Rods – Fuel \\& Control"
	quest.3DE12AB0BAAF5EEA.title: "Blaze Hunter"
	quest.3DEAA49DB3F1C4EF.quest_desc: ["Flour is used to create various food items."]
	quest.3DEAA49DB3F1C4EF.title: "Flour"
	quest.3E018C333727DCDC.quest_desc: ["Touchdown confirmed. Welcome to the Red Planet. Unlike the suffocating heat of Venus, Mars is a frozen, desolate desert of iron oxide dust and endless craters. The atmosphere is thin, the silence is deafening."]
	quest.3E0F625C3023781E.quest_desc: ["Buy some reward!"]
	quest.3E0F625C3023781E.title: "Sandy Glass"
	quest.3E2CF22598245405.quest_desc: ["Steel Essences can be used to craft Steel Ingots."]
	quest.3E2CF22598245405.title: "Steel Ingots"
	quest.3E448AF7F7B9350B.quest_desc: ["Just put a Dead Bush into a Blood Infuser and you will get an Undead Sapling."]
	quest.3E4817F61204F544.quest_desc: [
		"Titanium is used in a large variety of recipes. Put Titanium Dust in the Industiral Blast Furnace to obtain some ingots."
		""
		"&aRequire Heat: 1500Heat"
	]
	quest.3E4817F61204F544.title: "Titanium!"
	quest.3E8ACAFF67094D5A.quest_desc: ["Mix with a little Garlic and Chicken."]
	quest.3E8ACAFF67094D5A.title: "Garlic Chicken"
	quest.3EDD53B346998A67.quest_desc: ["Craft the Iron Shovel."]
	quest.3EDEE2BCC836381F.quest_desc: ["For starters, push Silicon Boule into the Empty Cell to get a Solid Silicon Cell."]
	quest.3EDEE2BCC836381F.title: "Molten Silicon #1"
	quest.3EECE4FB3D44C8C3.quest_desc: ["Before you can begin constructing the Hephaestus Forge, you need a solid foundation. Gather Polished Darkstone for the multiblock structure and a Smithing Table."]
	quest.3EECE4FB3D44C8C3.title: "Building the Forge #1"
	quest.3EF8C6A0BEE4EFB2.quest_desc: ["A more advanced upgrade than the previous one, but not the strongest yet—later on, you'll be able to craft even more powerful version."]
	quest.3F10FFB8BB541BA3.quest_desc: ["Producing Iron Bars without a Rolling Machine is a bit expensive, but more on that later."]
	quest.3F10FFB8BB541BA3.title: "Iron Bars"
	quest.3F465C5C897E2198.quest_desc: ["Craft Zucchini Bake."]
	quest.3F465C5C897E2198.title: "Zucchini Bake"
	quest.3F702EE6EC5B3362.quest_desc: [
		"A stationary defense turret that sprays liquid at hostile mobs within range."
		"Can ignite flammable fluids, target neutral entities via toggled blacklist, and requires RF and fluid input to operate."
		"Stores up to 4000 mB and only consumes liquid when firing"
	]
	quest.3F96FEB188010A18.quest_desc: ["Upgrade your Backpack to carry more Items."]
	quest.3F9A6FD8D11182BF.quest_desc: ["Placing Dry Rubber into a furnace will then yield plastic! Plastic Sheets can then be used to create many other types of machines."]
	quest.3F9A6FD8D11182BF.title: "Plastic Sheets"
	quest.3F9C50C7C3A1CCA0.quest_desc: ["To get some Naquadah Alloy you have to mix Naquadah with Dark Steel ingots."]
	quest.3F9C50C7C3A1CCA0.title: "Naquadah Alloy!"
	quest.3F9E8308B64CF098.quest_desc: ["Craft a Steel Leggings."]
	quest.3FC7AF02FE507C8B.quest_desc: [
		"The Bark Knife used to obtain bark from logs."
		""
		"&9Upon completion of this quest you will unlock the chapter: &o\"White Magic Tier I\""
	]
	quest.3FC7AF02FE507C8B.title: "&9Unlock: &6&lWhite Magic Tier I."
	quest.3FD9A4A3BBD9998D.quest_desc: ["The Macerator will turn 1 crushed dusts/raw ores into 2 dusts."]
	quest.3FE2EFEC01102F1A.quest_desc: ["Fruit Yogurts there are so many variations."]
	quest.3FE2EFEC01102F1A.title: "Pineapple Yoghurt"
	quest.3FEC43695737D0E2.quest_desc: ["A versatile component used in crafting various tools and weapons across different technologies."]
	quest.3FFD3C6A972A5B26.quest_desc: ["Different hooks are made from the ropes to facilitate exploration."]
	quest.3FFD3C6A972A5B26.title: "Rope"
	quest.4025D19B7AB8D008.quest_desc: ["Due to the smooth surface of sandstone-slabs, you can press paper in stunning quality!"]
	quest.4025D19B7AB8D008.title: "Papers"
	quest.403239740FA9D491.quest_desc: ["The Iron Upgrade increases storage value."]
	quest.403239740FA9D491.title: "Drawer Upgrade!"
	quest.40469F3D08315B65.quest_desc: ["After harvesting a fully grown plant of Electrotine Seeds, you get Electrotine Essences."]
	quest.40469F3D08315B65.title: "Electrotine Essence"
	quest.4048314A14CA3C89.quest_desc: ["A simple watering tool made from iron. Speeds up crop growth in a small area."]
	quest.404CEFBF640A31D6.quest_desc: ["Ok, let's go on with... Mustard Seeds!"]
	quest.404CEFBF640A31D6.title: "Mustar Seeds"
	quest.405BD8337E79A9F3.quest_desc: ["Using colors as a means of making buildings look nice is a recognized technique among builders. However, sometimes it can be difficult to find all the colors one requires. The Bucket of Infinite Colors, merely using the three primary shades of the world, can create any color so long as it came in contact with them, and then tranfer it onto any dyeable block."]
	quest.407225C0454CA687.quest_desc: [
		"It’s time to craft the key components for the Industrial Blast Furnace — a crucial machine for producing Titanium Ingots."
		"But first, there are a few important steps to complete before it’s ready to use."
	]
	quest.407225C0454CA687.title: "Aluminium Gears"
	quest.409A5E1873F34E73.quest_desc: ["The Pile of Neutrons is used to create Neutronium nuggets and ingots, the Ultimate Stew and other items of high quality."]
	quest.409A5E1873F34E73.title: "Neutron Piles"
	quest.40D82990CD90B999.quest_desc: [
		"The Long-Range Breaker works like a normal Breaker, but it can break up to blocks in front of it."
		"When right-clicking it with a Redstone Torch in hand, it will change between a mode where it gets deactivated by Redstone and a mode where it responds to pulses."
		"Per block broken, it uses FE."
	]
	quest.4159589378303D41.quest_desc: ["The Extended Magazine is an upgrade for the Revolver. Like all upgrades, it's applied in the Engineer's Workbench."]
	quest.417EEC22373193F5.quest_desc: ["Mix Triberium, Deepsilver, Crimson Iron and Otsrum in a Foundry or in Advanced Alloy Smelting Factory to obtain Magentite."]
	quest.417EEC22373193F5.title: "Magentite!"
	quest.41AEA4D2229B0B20.quest_desc: ["Craft a few Diamond Seeds."]
	quest.41C1DF9D9391FC83.quest_desc: ["Pulsating Essences can be used to craft Pulsating Alloy Ingots."]
	quest.41C1DF9D9391FC83.title: "Pulsating Alloy Ingot"
	quest.41C4EDD86424E869.quest_desc: [
		"Darkstone is a plain stone, but it is the base stone of the Forbidden Arcanus mod. It appears deep underground near Lava Lakes, like at Y-level -53."
		"Make sure you have plenty of this!"
	]
	quest.41C4EDD86424E869.quest_subtitle: "Darkstone"
	quest.41C4EDD86424E869.title: "Deep Underground!"
	quest.41C734932FA02628.title: "Growing Edelwood"
	quest.41EF65D411C1B0EA.quest_desc: ["The Energized Smelter is your basic electric furnace that uses energy instead of fuel to smelt items. "]
	quest.4250C79A4641DA8B.quest_desc: ["Apple Pie is a classic dessert made with sweet apples and a flaky pastry crust. It's crafted using Dough, Apples, and Sugar — a warm and comforting dish perfect for any meal."]
	quest.4250C79A4641DA8B.title: "Apple Pie"
	quest.425408AFB734E118.quest_desc: ["It just pumps water..."]
	quest.428875641B272227.quest_desc: ["You can get Marble Dust by crashing Obsidian and Diorite."]
	quest.428875641B272227.title: "Marble Dust"
	quest.4298493757108F5E.quest_desc: ["The Advanced Item Laser Relay improves upon the basic version by adding a built-in filter system. Right-click to open its interface, where you can set input and/or output filters using a whitelist or blacklist."]
	quest.429D9A464128206A.quest_desc: ["Bins are basic yet efficient storage blocks from Mekanism, designed to hold huge quantities of a single item. Perfect for mass storage of resources like cobblestone or ingots. Insert and extract with hoppers, pipes, or even by hand!"]
	quest.42A2D045CD8BA156.quest_desc: ["Smelt your Fire Clay to Fire Brick."]
	quest.42A2D045CD8BA156.title: "Smelter #3"
	quest.42AD0774041CBB9E.quest_desc: ["Quantum Core which is crafted with Runes, Mundabitur Dust! The Spawner Scraps are drops from Mining a Spawner without Silk Touch, so it'll break the Spawner."]
	quest.42AD0774041CBB9E.title: "Quantum Core"
	quest.42C3588C9D55B344.quest_desc: [
		"Let's start a little bigger with the Tier 3 energy storage system. To do this we need at least 26 Draconium blocks. "
		""
		"If you don't know how to set up the multiblock, follow the instuctions in the draconic information tablet."
		""
		"&a💡 Hint: You can also make it bigger if you already have the necessary resources"
	]
	quest.42C3588C9D55B344.title: "Energy Story Tier 3!"
	quest.432785684CAAB86E.quest_desc: ["The Leaf Blower can blow away tall grass, flowers and other stuff around you when you hold right-click."]
	quest.433278A8F9C37652.quest_desc: ["Smelt your Bronze Dusts to Ingots and craft it into a Plate in the usual way."]
	quest.433278A8F9C37652.title: "Bronze Plate"
	quest.4335A45F451EFD2A.quest_desc: ["Let’s finish the Mixer’s frame! Once everything is in place, use your Engineer’s Hammer to right-click the middle of the machine to complete the structure. The Engineer’s Manual projection helps a lot!"]
	quest.4335A45F451EFD2A.title: "Mixer!"
	quest.4338DC3CA22A91FB.quest_desc: ["Craft a few Steel Seeds."]
	quest.43BE17F9CBF2AEAC.quest_desc: ["The Moon Dungeon is a large, naturally generated structure hidden deep beneath the lunar surface. It can be quite hard to find, but exploring it is definitely worth the effort!"]
	quest.43BE17F9CBF2AEAC.title: "Moon Dungeons"
	quest.43CD9822C7A10F63.quest_desc: ["The Powered Furnace is an RF-powered smelting machine, working similarly to a vanilla Furnace, but faster and more efficient."]
	quest.43CE4CCC0691F4F3.quest_desc: ["The Empty Casing is used in the creation of the Casull Cartridge, Armor-Piercing Cartridge and much more!"]
	quest.43CE4CCC0691F4F3.title: "Empty Casing"
	quest.441F508FAD1D64FE.quest_desc: ["Placing grass in different positions in the crafting grid gives you different seeds!"]
	quest.441F508FAD1D64FE.title: "Onion Seeds"
	quest.443193D1CBB3E790.quest_desc: ["Combine all crafted components to assemble the Hardened Jetpack. This upgraded jetpack runs on Redstone Flux (RF/FE) and offers better control and flight time than the previous tier."]
	quest.443193D1CBB3E790.title: "Hardened Jetpack!"
	quest.44392FE73F756955.quest_desc: [
		"While traversing the gray craters of Mercury, you may stumble upon ancient fortifications. Your objective is the Big Castle a massive structure that dominates the surface."
		""
		"&aNote: Do not confuse this with the Small Castles scattered across the planet; only the main fortress holds what you seek. Infiltrate the stronghold, defeat its guardians, and scour the loot chests. Somewhere within its walls lies a vital Module that will significantly boost your technological progression"
	]
	quest.44392FE73F756955.title: "Mercury Big Castle!"
	quest.44549C1766490FEC.quest_desc: ["Blood Potash double your bonemealing efficiency,"]
	quest.44549C1766490FEC.title: "Blood Potash"
	quest.445B38496EA40081.quest_desc: ["Exceptionally powerful. Boosts growth significantly over a large area."]
	quest.448C5F03A4470080.quest_desc: ["The building block of the Nether is Nether Bricks, smelt your Netherrack to obtain."]
	quest.448C5F03A4470080.title: "Nether Bricks"
	quest.4490923336009EC1.title: "Chicken Celery Casserole"
	quest.44B6010A8351D92F.quest_desc: ["Don't forget to burn the clay!"]
	quest.44B6010A8351D92F.title: "More Bricks"
	quest.44C72A4BC8280551.quest_desc: ["Bins are basic yet efficient storage blocks from Mekanism, designed to hold huge quantities of a single item. Perfect for mass storage of resources like cobblestone or ingots."]
	quest.44E73EB4B8BC5330.quest_desc: ["Craft Copper Wire and assemble your first Motor! This essential component will be needed for many advanced machines."]
	quest.450BB19FE71A3CE3.quest_desc: ["Smoothie Glasses are used mainly for Smoothies."]
	quest.4519237186F9A733.quest_desc: ["A mystical upgrade to the basic can. Grows crops faster and covers a wider area."]
	quest.452B5AD47F488E00.quest_desc: ["After harvesting a fully grown plant of Obsidian Seeds, you get Obsidian&l Essences."]
	quest.452B5AD47F488E00.title: "Obsidian Essence"
	quest.45462EA58E462596.quest_desc: ["A rare mid-to-late game metal. Commonly found in dungeon loot early on, but later requires complex production methods to obtain."]
	quest.45545EC372678187.quest_desc: ["Buy some reward!"]
	quest.45545EC372678187.title: "Rune"
	quest.456765182C32EE30.quest_desc: ["Quartz Enriched Iron Essences can be used to craft Quartz Enriched Iron Ingots."]
	quest.456765182C32EE30.title: "Quartz Enriched Iron Ingots"
	quest.4593571C5CF54B04.quest_desc: [
		"The rituals require different Essences. Collect some of each!"
		"To provide EXP, use the Experience Slot in the Forge. You can insert one of the following:"
		"  1. Xpetrified Orbs – These provide the most experience."
		""
		"  2. Bottle o' Enchanting – Gives a small amount of EXP but is easy to obtain."
		""
		"  3. Enchanted Items – The Forge will extract the enchantments and convert them into EXP."
	]
	quest.4593571C5CF54B04.title: "          Xpetrified Orb          "
	quest.4596BBD65B382DF3.quest_desc: ["Craft some Fluid Pipes in the Engineer's Workshop."]
	quest.4596BBD65B382DF3.title: "Fluid Pipes"
	quest.45A2B219D252AB13.quest_desc: ["Naphtha is a fluid obtained by processing Crude Oil in the Distillery. It can be used as a fuel source or refined further into Lubricant."]
	quest.45A2B219D252AB13.title: "Better than Oil!"
	quest.45CF1ABF26D473AB.quest_desc: [
		"A key components from Modern Industrialization used in crafting advanced machines."
		""
		"&a💡 Hint: For Lithium production, check the &o\"Ores and Alloys: Tier II\"&r &achapter!"
	]
	quest.45CF1ABF26D473AB.title: "Advanced Components!"
	quest.45F058A1D9DC3642.quest_desc: ["It's time to make mining more interesting with the Mining Hammer that hits a 3x3 block."]
	quest.45F058A1D9DC3642.title: "Mining Hammer"
	quest.45F6746F692EC2EA.quest_desc: ["Find Ice Shard Ore on The Moon and collect."]
	quest.45F6746F692EC2EA.title: "Ice Shards"
	quest.460017338C35265A.quest_desc: ["Craft a few Obsidian Seeds."]
	quest.460D969466FC534E.quest_desc: [
		"In Minecraft, Coal is a vital resource used for smelting, crafting, and even energy production. "
		"Found deep underground or in exposed veins, it burns efficiently and can be refined into more advanced materials."
	]
	quest.460D969466FC534E.quest_subtitle: "The Power of Carbon"
	quest.460D969466FC534E.title: "Basic Fuel"
	quest.460DFD7874D60B5D.quest_desc: ["The Reactor Controller is the central unit of an Extreme Reactor. It must be placed on the outer frame and is required to activate or monitor the reactor. Without it, the multiblock won't function at all."]
	quest.460DFD7874D60B5D.title: "Finally Reactor!"
	quest.4613A42195E4BA0B.quest_desc: ["After harvesting a fully grown plant of Titanium Seeds, you get Titanium Essences."]
	quest.4613A42195E4BA0B.title: "Titanium Essence"
	quest.461A8D416D16946A.quest_desc: ["A reliable piece of armor crafted from Iron Plates instead of Ingots. It provides solid defense against enemy attacks and is essential for survival in tougher battles."]
	quest.46495018E8D7FCFC.quest_desc: ["The Canola you get out of them can be used in a Canola Press to make 80mB Canola Oil."]
	quest.465222E2D8C893CC.quest_desc: ["After harvesting a fully grown plant of Nether Star Seeds, you get Nether Star Essence."]
	quest.465222E2D8C893CC.title: "Nether Star Essence"
	quest.4666313B896CD97A.title: "Ender Dragon Hunter"
	quest.46760DB42A958368.quest_desc: ["Its time to craft copper tools!"]
	quest.46760DB42A958368.title: "Copper Upgarde"
	quest.467D6DABE98B7540.quest_desc: [
		"The surface is not the only thing hidden in the clouds of Venus. Somewhere beneath the basalt crust lie massive, ancient structures. These Dungeons are treacherous and filled with guardians, but the reward is worth the risk."
		""
		"Locate the treasure room and secure the Tier 2 Base Module."
	]
	quest.467D6DABE98B7540.title: "Venus Dungeon!"
	quest.467E1AB902BFA05E.quest_desc: ["The Rice Slimeball can be used to create anything a Slimeball can."]
	quest.467E1AB902BFA05E.title: "Rice Slimeballs"
	quest.4685E258B423E671.quest_desc: [
		"Using the Atomic Reconstructor, you can transform regular Redstone into Restonia Crystals."
		"Using the Atomic Reconstructor, you can transform regular redstone Block into Restonia Crystal Block."
	]
	quest.4685E258B423E671.title: "Restonia Crystals"
	quest.468B4EEB4BEA445F.quest_desc: ["Quartz is nice and shiny, lots of it in The Nether!"]
	quest.468B4EEB4BEA445F.title: "Nether Quartz!"
	quest.4691666CBFD679A3.quest_desc: ["Prevents machines from overheating by stabilizing internal temperature. Essential in blocks like the Resourceful Furnace to ensure safe and efficient operation."]
	quest.469EDD7EDFF2E0DD.quest_desc: ["Neptunium is created by combining Blazing Dust, Ostrum, and Magentite in a Foundry or an Advanced Alloy Smelting Factory. This powerful alloy is a key ingredient in crafting HE Mox Ingots."]
	quest.46A84165BB1E728C.quest_desc: ["For each dish you need at least one tool to prepare it, such as a Cutting Board and other things you prepare afterwards."]
	quest.46A8A0E60C83EA90.quest_desc: ["After harvesting a fully grown plant of End Seeds, you get End Essences."]
	quest.46A8A0E60C83EA90.title: "End Essence"
	quest.46C91A1F199D4910.quest_desc: ["The moment has come to assemble your first Crossbow! Use the components you've acquired in previous missions and assemble the weapon according to The Blueprint. Once you've done everything right, you can test it!"]
	quest.46C91A1F199D4910.title: "&7Build the Crossbow"
	quest.46CF029106EC0BE7.quest_desc: ["The Polarizer polarizes stuff. :)"]
	quest.46CF029106EC0BE7.quest_subtitle: "&9Unlock: &6&lMain Questline - Tier III."
	quest.46D4DD79C0665825.quest_desc: ["The Blast Furnace is a multiblock and is used to produce Steel—an essential material for advanced machines and tools."]
	quest.46D4DD79C0665825.quest_subtitle: "Heavy-duty smelting starts here."
	quest.46D4DD79C0665825.title: "Blast Furnace!"
	quest.46DBF6F9FFD90C31.quest_desc: [
		"Dilithium is similar to Tiberium, but it spawns in the Overworld — specifically in Oceans, Rivers, and Desert Biomes."
		""
		"Found between Y-levels -70 to 20."
	]
	quest.46DBF6F9FFD90C31.title: "Dilithium Crystals"
	quest.46E316DFCD59A756.quest_desc: ["Squeezes, flattens and crushes by jumping on it. Redstone pulse to reset."]
	quest.46F8B6BB553C9ED5.quest_desc: [
		"Ars Nouveau introduces a flexible, customizable spellcasting system."
		"Using magical glyphs, source energy, and spellbooks, you can craft your own spells, automate rituals, and explore powerful magical technology."
		"Let your journey begin by crafting the Worn Notebook, your guide to this new world of arcane potential."
	]
	quest.46F8B6BB553C9ED5.title: "Ars Nouveau: A New Path to Magic"
	quest.47396B27F43DCB54.quest_desc: ["The Diamond Hook allows you to aim precisely, reach greater distances, and even fire up to four hooks simultaneously. Can also keep you suspended mid-air for added mobility."]
	quest.473D41266BEE3FEA.quest_desc: ["Collect a lot of water and use the new Electrolyzer to generate Oxygen."]
	quest.473D41266BEE3FEA.title: "Oxygen #2"
	quest.474B12B12A5AB8DD.quest_desc: [
		"Basic Control Circuit is a very useful electronic component for intermediate level machines. "
		"You can make it in Engineer's Worshop."
	]
	quest.4759DEE7B2AB757F.quest_desc: ["After harvesting a fully grown plant of Rubber Seeds, you get Rubber Essences."]
	quest.4759DEE7B2AB757F.title: "Rubber Essence"
	quest.47638F510B40330E.quest_desc: ["Craft a few Dark Gem Seeds."]
	quest.47638F510B40330E.title: "Dark Gem Seeds"
	quest.476CC159FEB066FF.quest_desc: ["You can build the Quantum Compressor in the following missions! Let's start with some \"basic\" components."]
	quest.476CC159FEB066FF.title: "\"Basic\" Components"
	quest.476FFD6E5980A7C1.quest_desc: [
		"The next step in solar energy!"
		"This Solar Panel IV generates 128 FE/tick, making it a reliable source of power for mid-tier machines."
		"It's a bit more expensive, but well worth the energy boost!"
	]
	quest.4787DBF0F5F0AE75.quest_desc: ["Craft a Copper Helmet."]
	quest.478CB87BCFF30EC5.quest_desc: [
		"A powerful crop-growing machine that automatically cares for and harvests plants placed above it. Requires CF/FE/RF, 10 mB Water, and 1 mB Ether Gas (not always use it) to operate. Especially effective with Mystical Agriculture seeds, as it re-plants and collects them automatically."
		""
		"&aYou’ll learn how to produce Ether Gas later in the Main Questline."
	]
	quest.47B8312B6462DE1D.quest_desc: [
		"Pressure Tube move air between compressors and machines. They can be camouflaged and Tube Modules can be placed on them for additional functionality."
		"But it can also be used for crafting recipes."
	]
	quest.47B8312B6462DE1D.title: "Pressure Tube"
	quest.47C3B7F5320FD7EA.quest_desc: [
		"Using Canola, you can make a simple, yet effective power generation system from natural resources."
		"To do this, first find some Canola Plants in the wild and plant them on your farm."
	]
	quest.47C3B7F5320FD7EA.title: "Canola"
	quest.47C52CA89FD76AD4.quest_desc: ["Before progressing, you'll need to collect multiple Blueprint items. These will unlock recipes for powerfultools. Keep them safe!"]
	quest.47C52CA89FD76AD4.title: "Useful Blueprints!"
	quest.47DEEFB86425A5F3.quest_desc: ["The Stasis Chamber is a machine added by Industrial Foregoing that uses Forge Energy to freeze and heal any mobs in its working area. For example, Wither."]
	quest.47E702EDE49DBEA5.quest_desc: [
		"The Wyvern Shield Control Module is the brain of your armor's defensive system. Without this essential module, your chestpiece is just a heavy piece of metal."
		""
		"Once installed and configured via the HUD (Shift+A), it manages the energy flow to your shields, allowing them to intercept incoming damage.,"
		""
		"&aThe Dragon Heart is obtained by killing the Ender Dragon or the Chaos Guardian. I think you already have one."
	]
	quest.47F0D9CFDF303AD5.quest_desc: ["The Seismic Sensor is an early game item used to track down Oil. Upon right click, it will show whether or not Oil was found directly under where the sensor was clicked on."]
	quest.47F32DA655459855.quest_desc: ["A vibrant and hearty Korean dish made with rice, assorted vegetables, and savory toppings—all mixed into one flavorful bowl."]
	quest.47F32DA655459855.title: "Bimimbap"
	quest.47FCC3AD7F724C76.quest_desc: ["Dragon Egg Essences can be used to craft Dragon Egg Chunks which can be converted into Dragon Eggs."]
	quest.47FCC3AD7F724C76.title: "Dragon Eggs"
	quest.47FCDF49654845B2.quest_desc: ["The Solar panel II is the next Tier in the Solar Flux Reborn Series. It is used to generate 8 RF/FE/t when receiving light. "]
	quest.47FF42162C2571F4.quest_desc: ["In the Chemical Reactor, mix Manganese Dust with Platinum Sulfuric Acid to obtain the Mythralite Ingot."]
	quest.47FF42162C2571F4.title: "Mythralite Ingot #8"
	quest.48107454AC35440D.title: "Grape Smoothies..."
	quest.483B873EE005CE19.quest_desc: ["You need to install different hatches into the main multiblock structure in order to make it functional."]
	quest.483B873EE005CE19.title: "Hatches"
	quest.48666DE3E31ECCC9.quest_desc: [
		"Prepare yourself for a descent into hell. Venus is often described as the Nether's celestial twin—a suffocating world of jagged Basalt landscapes and vast, bubbling lava lakes. The atmosphere is unstable, characterized by perpetual lightning strikes that scour the uneven surface."
		""
		"Survival here is a constant struggle. Watch your step on the treacherous terrain and keep an eye on the sky."
	]
	quest.4869646106353868.quest_desc: [
		"Craft a few Copper Plates with your new Ore Hammer."
		"Seems wasteful?  Don't worry! :) "
		"Pretty soon you'll be able to automate this to save on material!"
	]
	quest.4869646106353868.title: "Basic Plates #1"
	quest.4870A4E9F677FEBB.quest_desc: ["Ok, let's go on with... Pineapple!"]
	quest.4870A4E9F677FEBB.title: "Pineapple"
	quest.487B7F729BDA1567.quest_desc: ["Ruby Essences can be used to craft Rubys."]
	quest.487B7F729BDA1567.title: "Ruby"
	quest.488E9F3E16489BF6.quest_desc: ["The Material Liquefier is a machine used to melt items into liquid. For example, Redstone to Molten Redstone."]
	quest.489DDB3CCF41CB90.quest_desc: ["Lets you craft high-tier components using Imperium essence."]
	quest.48BB50298402EDD4.quest_desc: ["After harvesting a fully grown plant of Ice Seeds, you get Ice Essences."]
	quest.48BB50298402EDD4.title: "Ice Essence"
	quest.48E342E2F49EAC06.quest_desc: ["The ultimate farmland. Used to grow the rarest and most powerful essence crops."]
	quest.48E3D535B6623DFB.quest_desc: [
		"To begin your journey into soul-binding, right-click a vanilla mob spawner with any Draconic Core (Draconic, Wyvern, Awakened, or Chaotic). Upon impact, the spawner will stabilize, drop as an item, and retain its original mob data. You can now relocate and upgrade your farm to fit your base's needs."
		""
		"&aUpgrade Tiers:"
		""
		"&aDraconic Core: Spawns up to 4 mobs (10-40s interval). Requires player proximity and standard spawning conditions (light level, floor type)."
		""
		"&aWyvern Core: Spawns up to 6 mobs (5-20s interval). Player proximity no longer required, but environment conditions must still be met."
		""
		"&aAwakened Core: Spawns up to 8 mobs (2.5-10s interval). All requirements ignored (Spawns in any light or space)."
		""
		"&aChaotic Core: The ultimate tier. Spawns up to 12 mobs (1.25-5s interval). Zero restrictions."
	]
	quest.48E87A3BDB2B0891.quest_desc: ["Crude Oil is found around Y-level 20 in small underground pockets, especially in flat, low-altitude biomes like deserts and oceans. Try filling a Wooden Tank with some!"]
	quest.48F87CAB189317C2.quest_desc: ["In Blacksmith's Workshop you can make all the metal blocks until you get to the machines."]
	quest.4921AC4A6B053ECB.quest_desc: ["The Neutronium Compressor is used to compress blocks into singularities. The GUI will state how many more of the input item is needed most recipes require 7,000-10,000 items for completion, and cannot be put in with one stack."]
	quest.49270BE95844C124.quest_desc: ["After harvesting a fully grown plant of Glowstone Seeds, you get Glowstone Essences."]
	quest.49270BE95844C124.title: "Glowstone Essence"
	quest.4954F5316FBAA6AE.quest_desc: ["Is this Item like the other Tokens."]
	quest.4965F31CF01D1AF2.quest_desc: ["Netherite Essences can be used to craft Netherite Ingots."]
	quest.4965F31CF01D1AF2.title: "Netherite Ingot"
	quest.49703B05D9550CFB.quest_desc: [
		"Iron Plates are essential for building machines and advanced tools. "
		""
		"Craft your first Iron Plate and lay the groundwork for industrial progress!"
	]
	quest.49703B05D9550CFB.title: "Basic Plates #2"
	quest.497ADE5D47C50835.title: "Endermann Hunter"
	quest.498B920507437040.quest_desc: ["Now that you have the materials, it's time to prepare the design of the structure. You can use the Crossbow Blueprint to assemble the parts. Without it, the crossbow cannot be assembled!"]
	quest.498B920507437040.title: "Crossbow Materials #2"
	quest.4996754331E08781.quest_desc: ["The Crystal Matrix Ingot is a very expensive component added by Avaritia. "]
	quest.49DBC2F68B097FA9.quest_desc: ["Buy some reward!"]
	quest.49DBC2F68B097FA9.title: "Copper Tool"
	quest.4A044CCFA60903AA.quest_desc: [
		"Hephaestus Forge Tier 5 is the final and most powerful forge – and naturally, also the most expensive!"
		"To craft it, you’ll need:"
		"-2 Dark Nether Stars, made by combining 4 Obsidiansteel with a Nether Star"
		"-Dragon Scales, dropped when defeating the Ender Dragon"
		"-Sculk Catalysts, dropped from the Warden or Silk-Touched in the Deep Dark"
		"-Stellarite Block, crafted from 9 Stellarite Pieces"
		"-Source Gem Block"
		"-Soul Binding Crystal for the middle"
	]
	quest.4A044CCFA60903AA.title: "               Finally Forge!               "
	quest.4AAC4D501E8F2738.quest_desc: ["Pink slime ingots are mainly used to craft machines."]
	quest.4AAC4D501E8F2738.title: "Pink Slime Ingots!"
	quest.4ACD67C38846484F.quest_desc: [
		"This chapter provides an introduction on how to use the Blacksmiths Workshop. "
		"Some tools and armor require more than just a simple crafting table."
		""
		"The Blacksmith's Workshop is a specialized workstation where you can craft Iron or higher-tier weapons, tools, and armor. If you're ready to forge stronger gear, this is the place to do it!"
	]
	quest.4ACD67C38846484F.title: "&eIntroduction: Blacksmith's Workshop"
	quest.4ADA7115B2F779D2.quest_desc: ["The Wand is essential for the Infusion Altar, which you'll build later on."]
	quest.4ADA7115B2F779D2.title: "Altar #1"
	quest.4AE5A21120D82CF8.quest_desc: [
		"One of the most precious resources."
		"Used for tools, armor, and crafting high-tier components. Always worth mining!"
	]
	quest.4AE5A21120D82CF8.title: "DIAMONDS!"
	quest.4B144846569C60BC.quest_desc: ["Iron Rods are used for various machines, but they are also needed for the Bucket."]
	quest.4B144846569C60BC.title: "Iron Rods"
	quest.4B2F764350FAC1C5.quest_desc: ["Charcoal is simple to make. Smelting Logs in a Furnace will obtain pieces of Tiny Charcoal, then combine two of them to form a Charcoal."]
	quest.4B2F764350FAC1C5.quest_subtitle: "Smelt your logs"
	quest.4B2F764350FAC1C5.title: "Little Charcoal :)"
	quest.4BE8BC4D13963D1D.quest_desc: ["The 1k Storage Cell provides storage for &b1024 bytes worth of items&r, and up to 63 different item types."]
	quest.4C04221386970256.quest_desc: [
		"The Iron Chest offers more space than a copper chest. "
		"Craft one to keep your growing inventory organized and secure!"
	]
	quest.4C04221386970256.title: "Upgrade Your Storage #2!"
	quest.4C09AA342BF4E1D5.quest_desc: [
		"With the Big Rocket Models complete, the entire solar system is finally within your reach. But why stop there? These engines are powerful enough to carry you beyond our sun to distant galaxies. Yes, you heard that right—entire galaxies await your arrival."
		""
		"&2Happy exploring, and thank you so much for playing this modpack!"
	]
	quest.4C09AA342BF4E1D5.title: "&6Big Rocket Model"
	quest.4C12105790A3A0B0.quest_desc: ["An advanced furnace that smelts 3 items simultaneously. While processing, it generates Essence based on the XP value of smelted items — 50mb per level. Efficient and productive!"]
	quest.4C12180C7DC3999F.quest_desc: ["Craft a few Copper Seeds."]
	quest.4C3CF0D867C0132F.quest_desc: ["Buy some reward!"]
	quest.4C3CF0D867C0132F.title: "Cotton Seeds"
	quest.4C52FD330BBCA59A.quest_desc: [
		"The Ranged Collector works much like a hopper, in that it collects items around it, having the power, however, to pick up items that are in an area of blocks around it."
		"It has a filter that can be set to white- or blacklist."
	]
	quest.4C6819FDFC7C391B.quest_desc: ["Watch out for hot cocoa!"]
	quest.4C6819FDFC7C391B.title: "Hot Cocoa"
	quest.4C75744A0A811429.quest_desc: ["Buy some reward!"]
	quest.4C75744A0A811429.title: "Glue Compound"
	quest.4C86047507CDC7B1.quest_desc: ["The Stone AIOT (All-In-One Tool) is a combination of the Stone Axe, the Stone Pickaxe, the Stone Sword, the Stone Shovel and the Stone Hoe."]
	quest.4CA991367931CEF5.quest_desc: [
		"The Energy Battery from Integrated Dynamics can be placed in the world to store Redstone Flux."
		""
		"&a💡 Hint: This battery only outputs energy when a redstone signal is supplied!"
	]
	quest.4CA9D7F5BC5D4419.quest_desc: ["Craft a few Stone Seeds."]
	quest.4CCC8AA39B120891.quest_desc: ["The most diamond backpack ever!"]
	quest.4CE7029A694AD085.quest_desc: ["A Coal Generator only produces electricity."]
	quest.4CFD13E20057013A.quest_desc: ["Copper Wire is used to transfer low-voltage power."]
	quest.4CFD13E20057013A.title: "Copper Wire"
	quest.4D1B204BC2BBE48E.quest_desc: ["Ok, let's go on with... Cabbage!"]
	quest.4D1B204BC2BBE48E.title: "Cabbage"
	quest.4D1E2EDE25B42E08.quest_desc: ["Craft a few Infused Iron Seeds."]
	quest.4D1E2EDE25B42E08.title: "Mana Infused Seeds"
	quest.4D28006F880DA718.quest_desc: ["A modular upgrade for the Revolver that improves zoom and long-range accuracy."]
	quest.4D438E1820C11FC5.quest_desc: ["You already know how to make Bronze, and now you can smelt it in your Foundry."]
	quest.4D438E1820C11FC5.title: "Bronze Ingots"
	quest.4D6238DAB24D7DD9.quest_desc: ["Bloody Cobblestone is a blood-soaked Mossy Cobblestone. To obtain it, place regular Cobblestone inside a Blood Infuser and supply it with Liquid Blood. This block is often used in various dark rituals and crafting recipes within EvilCraft."]
	quest.4D6238DAB24D7DD9.title: "Bloody Cobblestone"
	quest.4D62D0B28A0D6326.quest_desc: ["Get more Cobblestones."]
	quest.4D62D0B28A0D6326.title: "Cobblestones"
	quest.4DA724FFEDF21A6E.quest_desc: ["Buy some reward!"]
	quest.4DA724FFEDF21A6E.title: "Transistors"
	quest.4DAD2A427210B0D4.quest_desc: ["Craft the Electric Mixer."]
	quest.4DAD2A427210B0D4.title: "Mixer #10"
	quest.4DC2F03C59CFD1D3.quest_desc: ["Basic Pressurized Tubes are used to move Gases between machines."]
	quest.4DC2F03C59CFD1D3.title: "&aBasic Pressurized Tube"
	quest.4DCC19D75CEC5517.quest_desc: ["Nickel Ore can be found at Y-levels -64 to 56."]
	quest.4DCC19D75CEC5517.title: "Nickel"
	quest.4DD6E0F3A5BDCDB8.quest_desc: ["A Bunch Of TNTs nagyobbat robban mint a \"mini\" tnt és fájdalmasabb."]
	quest.4DDA62B71537CAAE.quest_desc: ["Craft a few Rubber Seeds."]
	quest.4DDF239B93AFE357.quest_desc: ["Refined Obsidian Essences can be used to craft Refined Obsidian Ingots."]
	quest.4DDF239B93AFE357.title: "Refined Obsidian Ingot"
	quest.4E04A2CD0423E6AF.quest_desc: ["The Clay Bucket is an item added by Ceramics. It works similarly to a Bucket, but will break after pouring out a hot liquid like Lava."]
	quest.4E04A2CD0423E6AF.title: "First Bucket"
	quest.4E0BB40CAD9A6293.quest_desc: ["Craft a Pot."]
	quest.4E25DD43A5CE4B7D.quest_desc: [
		"Used to craft Tier 4 essence seeds."
		"It cannot be planted and is only used as a crafting component for higher-tier crops."
	]
	quest.4E25DD43A5CE4B7D.quest_subtitle: "Crafting Seeds"
	quest.4E426E4335CD3014.quest_desc: [
		"The Energy Laser Relay from Actually Additions is a wireless energy transfer device. It allows RF power to be sent between machines without cables, within a default range of 15 blocks. "
		""
		"&a💡 Hint: Use a Laser Wrench to link relays easily!"
	]
	quest.4E426E4335CD3014.title: "The Energy Laser Relay"
	quest.4EAC1ADDB1013692.quest_desc: ["The Controller powers and manages your entire Refined Storage network. It accepts RF or FE and shows connected devices and energy use when right-clicked. Redstone control is also possible."]
	quest.4EC04C2E7DA4F12C.quest_desc: ["The Quantum Compressor is a late-game RF/FE-powered machine capable of crafting Singularities by consuming large amounts of materials."]
	quest.4EDA443D3DC68C0B.quest_desc: ["The Circuit Plate is the basic component for all components."]
	quest.4EDA443D3DC68C0B.title: "Circuit Plates"
	quest.4EE881BA05609E56.quest_desc: ["To create a Triberium, you’ll need to combine Tiberium Crystals with either Obsidian or Dilithium."]
	quest.4EE881BA05609E56.title: "Triberium"
	quest.4EEE94A287D1647A.quest_desc: ["Combine the Bucket with 4 Poisonous Potatoes."]
	quest.4EEE94A287D1647A.title: "Liquid Poison"
	quest.4F262FDFED4A495E.quest_desc: ["To make Cooked Rice, you need Rice and heat."]
	quest.4F262FDFED4A495E.title: "Cooked Rice"
	quest.4F2AEBF459DBA57E.quest_desc: ["Put Lapis Lazuli in the Industrial Centrifuge to obtain Lazurite Dust."]
	quest.4F2AEBF459DBA57E.title: "Lazurite Dust"
	quest.4F3CD21A6D61957D.quest_desc: ["The Quantum Catcher is a very useful Tool for moving Mobs. Simply Right Click a Mob to \"catch\" them, then Right Click again to let them go. You'll need a set amount of Aureal on you in order to use it though, this is dependent on the Health of the Mob. More Health, more Aureal needed!"]
	quest.4F6EC0ECDF5D9131.quest_desc: [
		"Combine Energy Batteries up to 4.000.000 RF Storage."
		""
		"&a💡 Hint: This battery only outputs energy when a redstone signal is supplied!"
	]
	quest.4F6EC0ECDF5D9131.title: "4M Energy Storage"
	quest.4F724C1440F5386D.quest_desc: ["This gadget lets you zip around with style! It reaches up to 24 blocks in just a second and pulls you at 20 blocks per second. You can anchor up to 4 hooks and swing between them—perfect for fast, agile movement through tight spaces."]
	quest.4F724C1440F5386D.title: "Red Hook!"
	quest.4F7C78E24F97EFDA.quest_desc: ["Get the Flints!"]
	quest.4F7C78E24F97EFDA.title: "Gravel to Flint"
	quest.4FADA45E4C005B64.quest_desc: [
		"Beware when breaking Tech Reborn machines, as most of them you will need to use a Wrench to ensure that you get the original machine back. "
		""
		"&cIf you don't use a Wrench you may only get a Standard Machine Casing back. You have been warned!"
	]
	quest.4FB5E3DB2ED7F25B.quest_desc: ["Bins are basic yet efficient storage blocks from Mekanism, designed to hold huge quantities of a single item. Perfect for mass storage of resources like cobblestone or ingots."]
	quest.4FC8F57D2F7C894F.quest_desc: [
		"To produce Awakened Draconium you need a better fusion crafitng system and tons of Energy!"
		"The Wyvern Fusion Crafting Injector is the second tier of Fusion Crafting Injectors and is created using Fusion crafting."
	]
	quest.4FC8F57D2F7C894F.title: "Wyvern Fusion Crafting Injector"
	quest.4FCA781B92052BB3.quest_desc: ["The Inferium Crystal is used to craft various essence upgrades and items. It’s an essential tool for progressing through Mystical Agriculture!"]
	quest.4FE92BBA0D7CDCB0.quest_desc: ["After harvesting a fully grown plant of Infused Iron Seeds, you get Infused Iron Essences."]
	quest.4FE92BBA0D7CDCB0.title: "Infused Iron Essence"
	quest.4FF045C780C5D5B0.quest_desc: ["Then get a few Fuel Buckets."]
	quest.4FF045C780C5D5B0.title: "Fuel Buckets"
	quest.502BFAFFAC874E21.quest_desc: ["Chemical Compound has a wide range of applications, with its most notable being the creation of The Ultimate Ingots. To craft it, combine Water, Photovoltaic Composite, Energetic Blend, and a Glass Bottle to produce this unique mixture."]
	quest.502BFAFFAC874E21.title: "Chemical Compound"
	quest.503A8581E9A74D61.quest_desc: [
		"Defense doesn't always require explosions."
		"The electric fence provides a passive, reliable method to deter intruders."
	]
	quest.503A8581E9A74D61.title: "Electric Fences"
	quest.506419A96CD89BC3.quest_desc: ["The Arc Furnace is a demanding structure—now it’s time to gather Steel Blocks in large quantities, along with Steel Sheetmetals. These materials form the body and outer casing of the furnace, providing durability and structural integrity."]
	quest.506419A96CD89BC3.title: "Forging the Foundation"
	quest.50DD460F4FCE61B5.quest_desc: ["Ok, let's go on with... Onion!"]
	quest.50DD460F4FCE61B5.title: "Onion"
	quest.50E2D2764AF619F0.quest_desc: ["Buy some reward!"]
	quest.50E2D2764AF619F0.title: "Tier 2 Crafting Seeds"
	quest.512A207E5023C0B6.quest_desc: ["Red Paper is colored paper, just to make the explosives look nice."]
	quest.512A207E5023C0B6.title: "Red Paper"
	quest.512FBA3E2DE4938E.quest_desc: ["The main source of Aluminium Dust is Bauxite Dust, though it can also be obtained by electrolyzing various other dusts. It can be smelted in a Furnace to produce Aluminium Ingots."]
	quest.512FBA3E2DE4938E.title: "Aluminium!"
	quest.51307CF52C1A62F3.title: "Spider Hunter"
	quest.514BC370C9AE67E4.quest_desc: ["Use the ingredients for the cod cutlet and cooked rice to make a simple dish."]
	quest.514BC370C9AE67E4.title: "Cod Roll"
	quest.5182237A9A5BF146.quest_desc: ["Search for tin ore and smelt into ingots."]
	quest.5182237A9A5BF146.title: "Basic &dMetals #3"
	quest.518D47D64A40C7FA.quest_desc: ["The last tier of crafting seeds."]
	quest.518D47D64A40C7FA.quest_subtitle: "Crafting Seeds"
	quest.51C32612EDB611EC.quest_desc: ["Craft Lamb Kebab."]
	quest.51C32612EDB611EC.title: "Lamb Kebab"
	quest.51DE6C0C98794818.quest_desc: ["You may be exhausted, but now comes the real challenge of the mission. Collect some Chrome and Titanium Plates."]
	quest.51DE6C0C98794818.title: "Usefull Plates!"
	quest.51E560B3517AD4DC.quest_desc: ["Collect some grass..."]
	quest.51E560B3517AD4DC.title: "Sifting Grass for Seeds"
	quest.5210A355C05AEE49.quest_desc: ["Buy some reward!"]
	quest.5210A355C05AEE49.title: "Melon Seeds"
	quest.5211B03D4C4DB590.title: "Warden Hunter"
	quest.5227AB7D54B99D73.quest_desc: [
		"Ether Gas is produced quite slowly, but you don't need a lot of it all at once."
		""
		"&aYou can use it mostly in the Hydrophonic Bed and to Cursium Ingot."
	]
	quest.5227AB7D54B99D73.title: "Ether Gas!"
	quest.524123185394C44A.quest_desc: ["Magnesium Dust is obtained by processing Marble Dust in Mixer."]
	quest.524123185394C44A.title: "Magnesium Dust"
	quest.5245AFE5A7E62FC7.quest_desc: [
		"Nature's Ruin does not use durability."
		""
		"Shift right-clicking with the Nature's Ruin will destroy all wooden blocks in an 13x13 cube."
		"Instead of dropping all of those items, one Matter Cluster will be dropped with all of the items inside of it to avoid lag."
	]
	quest.528BA870053786A7.quest_desc: ["Used to fill containers like Fuel Cans or cells with fluids, and apply protective coatings to items."]
	quest.5293E80D9E7E0436.quest_desc: ["Crush some Rubys to obtain Ruby Dust."]
	quest.529D3D1FAF415900.quest_desc: [
		"A sledgehammer is a tool with a large, flat, metal head, attached to a short handle. The size of its head allows a sledgehammer to apply more force than other hammers of similar size. "
		"Can be used to craft ingots into plates and dusts."
	]
	quest.529D3D1FAF415900.title: "Hammer Time!"
	quest.52ACF4189A8B0F69.quest_desc: [
		"Make Dark Magic Dust and see what it can do!"
		""
		"&9Upon completion of this quest you will unlock the chapter: &o\"Black Magic Tier II\" &cNot available!"
	]
	quest.52ACF4189A8B0F69.quest_subtitle: "&9Unlock: &7&lBlack Magic - Tier II."
	quest.52ACF4189A8B0F69.title: "Dark Magic Dust"
	quest.52E390603A4FCE83.quest_desc: ["The Construction Core is used in recipes for devices that turn items from the storage network into items in the world."]
	quest.52F26EEC590FC5E3.quest_desc: ["String is a versatile material used in crafting items like bows, fishing rods and wool."]
	quest.52F26EEC590FC5E3.title: "Strings"
	quest.52F3C3C714CBF2B0.quest_desc: [
		"The Lava Factory Controller is a block added by Actually Additions, used to create the Lava Factory, which is used to create Lava from CF/FE/RF."
		""
		"The Lava Factory is created in a bowl-like shape, with the Lava Factory Controller being the bottom of the bowl, and the Casings making the sides. The Lava Factory requires 150000 CF/FE/RF to generate one Lava block. It will place the Lava block inside the bowl."
	]
	quest.52F3C3C714CBF2B0.title: "Lava Factory"
	quest.5301114BE4FD90E4.quest_desc: ["A significant upgrade from the basic backpack! The Gold Backpack offers much more storage, making it ideal for long mining trips or exploration."]
	quest.530E30E4CA7CB09F.quest_desc: ["Craft a few Sulfur Seeds."]
	quest.5314E70782467C77.quest_desc: ["Titanium Dust is produced as a by-product in the Industrial Electrolyzer, mainly from Bauxite Dust."]
	quest.5314E70782467C77.title: "Titanium Dust"
	quest.531646138605CA37.quest_desc: ["Now that you have access to Vibranum, you can afford one of the best jetpacks available."]
	quest.5339C8E3483438C2.quest_desc: [
		"Welcome to the beginning of the end. Avaritia is not just a mod; it is a test of your infrastructure and patience. To succeed, you will need resources on a scale you’ve likely never imagined."
		""
		"Pro Tip: Time is your most valuable asset. We highly recommend crafting a Neutron Collector immediately. Let it accumulate Neutron Piles in the background while you focus on your planetary progression."
	]
	quest.5339C8E3483438C2.title: "The beginnings of high technology"
	quest.5341619DD78FB3F7.quest_desc: ["Gather the ingredients for Energy Battery!"]
	quest.5341619DD78FB3F7.title: "Materials"
	quest.53710B1000D6BA47.quest_desc: ["An upgraded solar generator that produces more energy during the day. Place it in direct sunlight and enjoy a steady flow of energy—completely maintenance-free!"]
	quest.53734121E3CF4F18.quest_desc: ["The Drawer Controller facilitates the sorting of Storage Drawers items."]
	quest.537CE2670827F20D.quest_desc: ["Use the Heat Exchanger or the Vacuum Freezer together with Cryofluid to cool Hot Tungstensteel."]
	quest.537CE2670827F20D.title: "Tungstensteel!"
	quest.5385B2123E82B680.quest_desc: ["Base Modules are available in various tiers and are required for a wide variety of crazy things."]
	quest.53DFB5A446F703D4.quest_desc: ["Yes, we know it's a redundant element, but the mission needs it. :)"]
	quest.5446F20FDE7BAE77.quest_desc: [
		"We need to upgrade a crafting table and make some of your first wooden tools!"
		"&6Basic Crafting Table &rallows items put onto the station to remain there, even when leaving its inventory screen."
	]
	quest.544BA605F931126B.quest_desc: ["Got extra seeds, leaves, or food scraps? Toss them into a Composter to slowly turn them into Bone Meal! It’s a simple way to recycle plant-based items into useful fertilizer."]
	quest.549CDA1D1EA30A44.quest_desc: ["The Item Dislocator is an utility item. When shift-right-clicked, it will attract nearby items to the player. It has a range of 8 blocks and can be upgraded to an Awakened Item Dislocator."]
	quest.54A2D2E1E210FA8E.quest_desc: ["The Basic Processor is used to craft the various Refined Storage devices."]
	quest.54E94D3FDD8C0EFE.quest_desc: [
		"To craft the Terrastomp Prism, you’ll need Dripstone, Flint, and a Diamatine Crystal Block. Just like the other Prisms, this one also requires the Elementarium Relic."
		"When used with tools, the Terrastomp Prism enables 3x3 area mining, allowing you to break 9 blocks at once instead of just one. Perfect for efficient digging and resource collection."
	]
	quest.54F040FA6E724CAE.quest_desc: ["The Anvil is a block in which you can repair tools, you can rename almost anything."]
	quest.552E81FF0A62960C.quest_desc: ["It's a perfectly light meal."]
	quest.552E81FF0A62960C.title: "Mashed Sweet Potatoes"
	quest.55633E333BA55D26.quest_desc: ["Buy some reward!"]
	quest.55633E333BA55D26.title: "Logic Chip"
	quest.559BF7A463E8812A.quest_desc: ["After harvesting a fully grown plant of Refined Obsidian Seeds, you get Refined Obsidian Essences."]
	quest.559BF7A463E8812A.title: "Refined Obsidian Essence"
	quest.55A5BE3515F7509D.quest_desc: ["The Infinity Drill is one of the most powerful mining tools you have ever seen. It requires many and very expensive components. If you follow this quest line you will build one in the end."]
	quest.55A5BE3515F7509D.title: "Infinity Drill #1"
	quest.5630A6F3E61EAB1A.quest_desc: ["It's time to process your vibranium and desh into ingots."]
	quest.5630A6F3E61EAB1A.title: "Vibranium and Desh Ingots!"
	quest.564DB2E88ACDF255.quest_desc: [
		"One of the earliest circuits used in low-tier machines and components. You’ll need plenty of these as you progress, so start crafting them in bulk!"
		""
		"&a💡 Hint: You can make it efficiently in a later machine."
	]
	quest.564DB2E88ACDF255.title: "Analog Circuit"
	quest.567F7A08A24747ED.quest_desc: [
		"The Modern Industrialization mod is complex, but this questline will help you get started step by step."
		""
		"To begin with, don't waste so many ingots to make plates. Build a Compressor to save materials!"
		""
		"&aIf you don't know how to do the bronze, go ahead with this chapter: &o\"Ores and Alloys\""
	]
	quest.567F7A08A24747ED.title: "Compressor!"
	quest.56D75879A4F9E318.quest_desc: ["The plant drops 1 Inferium Essence which is used in crafting many of the recipes in the mod."]
	quest.56F4C2200D0A7CF6.quest_desc: [
		"Vegetable Oil can be made from almost any vegetable."
		""
		"&aHint: Extract Oil in Squeezer with Fluid Pipe."
	]
	quest.56F4C2200D0A7CF6.title: "Vegetable Oil"
	quest.56FDC6B8099C3AEB.quest_desc: ["Put 16 pieces of Sand and two empty cells in the Electrolyzer to obtain Silicon, Compressed Air and Clay! "]
	quest.570EECB4BC74A88F.quest_desc: ["A flower pot is a decorative block that can contain flowers, saplings, mushrooms or plants."]
	quest.570F668C28DAEC23.quest_desc: ["Craft a few Electrotine Seeds."]
	quest.5718732C7191826C.quest_desc: ["The &eAdvanced Motor &fis a component added by &bModern Ind.&f. It is used in the manufacturing of advanced machines."]
	quest.5727277C90500139.quest_desc: [
		"The Arcane Crystal Ores can spawn from Y-levels 14 to -40."
		"It will be needed a lot, so mine a lot and persevere. :)"
		""
		"&a💡 Hint: If you haven't found an iron pickaxe somewhere, you should unlock the Blacksmith's Workshop to craft one."
	]
	quest.5727277C90500139.quest_subtitle: "Arcane Crystals"
	quest.5727277C90500139.title: "     The Forbidden Beginnings     "
	quest.575BCDFC0A084B5F.quest_desc: ["30k Coolant Cell..."]
	quest.5777530B37A61F18.quest_desc: ["Crimson Iron Ore generates in the Nether and can be smelted into Crimson Iron Ingots."]
	quest.5777530B37A61F18.title: "Crimson Iron"
	quest.57B67073EEFCC691.quest_desc: ["The Water Pump will produce 1/8th of a bucket of water for every adjacent water source every 5 seconds, for a max output of 1 bucket / 5 seconds."]
	quest.57D0E2B117B2268A.quest_desc: ["Signalum is an alloy used in crafting a variety of items, including Plates and more. It is created by combining Constantan with Redstone."]
	quest.57D0E2B117B2268A.title: "Signalum"
	quest.57DDDEBE7440C206.quest_desc: ["Your first heavy armor!"]
	quest.57E3314B47FC6BCD.quest_desc: ["Pepperoni Pizza is god?"]
	quest.57E3314B47FC6BCD.title: "Pepperoni Pizza!"
	quest.5808E8D3702BDE19.quest_desc: ["The Windmill It's used to generate Energy when connected to a Kinetic Dynamo."]
	quest.58150ED5C4420A31.quest_desc: ["This dust is used as an essential ingredient for crafting Refined Glowstone Ingots and other advanced components."]
	quest.58150ED5C4420A31.title: "Energetic Blend"
	quest.5844018CCBDE4DF6.quest_desc: ["The Sword of the Cosmos does not use durability. Attacking any mob with it will set its health to 0, instantly killing it. "]
	quest.58450499CF4AF434.quest_desc: ["Creating the Ancient Sapling using the Ritual of the Forest."]
	quest.58450499CF4AF434.title: "Ancient Saplings"
	quest.5853AC6398E29439.quest_desc: [
		"The Small Rocket Model is required in order to reach the Mars."
		""
		"&cYou’ll need to bring another Rocket Launch Pad with you for the return trip."
	]
	quest.58751BC058DE959A.quest_desc: ["After harvesting a fully grown plant of Stone Seeds, you get Stone Essences."]
	quest.58751BC058DE959A.title: "Stone Essence"
	quest.587BCD4F2540801D.quest_desc: ["Find a Lost Soul flying around in your world, then toss a Splash Potion of Aureal at them! Then, they'll become a Lost Enchanted Soul, kill them!"]
	quest.58BAE4710609BDF7.quest_desc: [
		"Somewhere beneath the mars sand crust lie massive, ancient structures. These Dungeons are treacherous and filled with guardians, but the reward is worth the risk."
		""
		"Locate the treasure room and secure the Tier 3 Base Module."
	]
	quest.58BAE4710609BDF7.title: "Mars Temple"
	quest.58FD6E1FF419C8B3.title: "Zombified Piglin Hunter"
	quest.5931824122D04608.quest_desc: [
		"The Harvesters are used to automatically harvest fully grown crops."
		"These machines can upgraded with Machine Upgrades, and can be de-activated with a Rerdstone signal."
	]
	quest.59335F6ED2B0004B.quest_desc: [
		"Obsidiansteel is a powerful alloy introduced by Forbidden Arcanus."
		""
		"It is created in the Clibano by combining a Steel Ingot with a Compressed Obsidian block."
		""
		"&a💡 Hint: If you don't know how to make Steel Ingots, check out the &oOres and Alloy Tier I. &r&aquest."
	]
	quest.59335F6ED2B0004B.title: "Obsidiansteel Ingots"
	quest.5951426B65BE95CE.quest_desc: ["The Electric Pump draws fluids into its 10,000mB buffer from nearby source blocks. Just place it adjacent to or above a source block, and it will start collecting any fluid it can reach, even following flowing blocks. It works with any fluid type."]
	quest.595D596208008637.quest_desc: [
		"You're almost ready to move on."
		"Gather Steel Blocks and Ovium Blocks to prove your progress. "
	]
	quest.595D596208008637.quest_subtitle: "&9Unlock: &3&lOres and Alloys - Tier 2. "
	quest.595D596208008637.title: "Preparations for the Tier II."
	quest.596BEB4E710D213C.quest_desc: ["Craft a Mixing Bowl."]
	quest.59777EB7AE177414.quest_desc: ["Let’s continue with the most important core blocks needed to bring your multiblock machine to life!"]
	quest.59777EB7AE177414.title: "Advanced Alloy Smelting Factory #2"
	quest.598762C34CB028A8.quest_desc: [
		"The Revolver is a ranged weapon added by Immersive Engineering. It shoots Cartridges."
		""
		"To load the gun, shift right-click with the Revolver in hand to open its GUI. Right-clicking with the gun in hand will make it shoot. When a Cartridge is used, the Empty Casing or Empty Shell will remain behind."
	]
	quest.59941097DEFAE311.quest_desc: [
		"To craft one of the core components in Ars Nouveau — the Source Gem — you'll need an Imbuement Chamber."
		""
		"It uses Source to infuse items and can generate a small amount on its own. For more efficient operation, you can supply it with Source Jars."
		""
		"Some recipes also require Arcane Pedestals placed around the chamber."
	]
	quest.59ABDCD9E81DFAC4.quest_desc: [
		"With the foundation in place, it's time to complete the Hephaestus Forge. Gather the remaining materials and construct it properly. Once built, the forge will require all 4 Essences: Aureal, Souls, Blood and Experience!"
		""
		"To use the forge, place the center item of the recipe in the middle slot and the outer items on the pedestals. Ensure you have all the necessary essences before attempting a craft!"
	]
	quest.59ABDCD9E81DFAC4.title: "          Building the Forge #2          "
	quest.59BEE850FBDC92D9.quest_desc: [
		"The Vengeance Pickaxe is a powerful tool infused with dark energy. It comes with Fortune V by default, making it excellent for mining valuable resources."
		"However, beware—the pickaxe may also apply the Vengeance effect!"
	]
	quest.59C421E8B71B1422.quest_desc: [
		"Time to stock up!"
		"You’ll need tons of iron, copper, tin—basically more of everything. Get digging!"
	]
	quest.59C421E8B71B1422.title: "Moore Iron!"
	quest.59EA0A5D66950928.quest_desc: ["Simple wall. :)"]
	quest.59EA0A5D66950928.title: "Wall"
	quest.59F40D37B42CDDBD.quest_desc: ["The LV Wire Coil is used to transfer low-voltage power between LV Wire Connectors. Addinionaly, it can only transfer up to 256 RF/t. If you need more then MV Wire Coil."]
	quest.59F40D37B42CDDBD.title: "LV Wire Coil"
	quest.5A00B35529F7EC17.quest_desc: ["Craft a few Coal Seeds."]
	quest.5A5C02788AA31742.quest_desc: ["After harvesting a fully grown plant of Quartz Enriched Iron Seeds, you get Quartz Enriched Iron Essences."]
	quest.5A5C02788AA31742.title: "Quartz Enriched Iron Essence"
	quest.5A8F1DF1C19868CE.quest_desc: ["Combine a Bread with Butter to obtain Toast."]
	quest.5A8F1DF1C19868CE.title: "Toast"
	quest.5A97144765C2694A.quest_desc: ["Sulfur Essences can only be used to craft Sulfur."]
	quest.5AD1A420CB05DAE3.quest_desc: [
		"The rituals require different Essences. Collect some of each!"
		""
		"You can either kill Mobs on/near the Forge in order to add Blood."
		"Or you can deposit filled Test Tubes to put that Blood into the Forge."
		""
		"To fill a Test Tube, have it in your Offhand when killing Mobs."
	]
	quest.5AEDA533979C390C.quest_desc: ["Craft a Nether Star Seed!"]
	quest.5AFB73AF784B4A71.quest_desc: ["To create Source Gems, we'll need to put either Lapis or Amethyst Shards into the Imbuement Chamber. Over time, these will convert to Source Gems!"]
	quest.5AFB73AF784B4A71.title: "Sources Gems"
	quest.5AFDFEA9689AA95C.quest_desc: ["Sawblade is used in various recipes."]
	quest.5AFDFEA9689AA95C.title: "Sawblades"
	quest.5B02F4B5209C3E81.quest_desc: ["You can create Azure Electrum by mixing Azure Silver, Gold and Ender in a Foundry (or Advanced Alloy Smelting Factory). Azure Electrum is important for Boosting Mixtures."]
	quest.5B02F4B5209C3E81.title: "Azure Electrum!"
	quest.5B1724D343BA5D68.quest_desc: ["Base Modules are available in various tiers and are required for a wide variety of crazy things."]
	quest.5B2B25094200C162.quest_desc: ["Sleep anywhere, anytime! The Sleeping Bag lets you rest without setting your spawn — and it comes in many colors too.&l"]
	quest.5B353F12600B9209.quest_desc: ["Blood-Waxed Coal double your Coal efficiency!"]
	quest.5B353F12600B9209.title: "Blood-Waxed Coal"
	quest.5B389EC5B927EED9.quest_desc: ["You'll need this singularity for your next multiblock machine! I really hope you've already planted Infused Iron seeds."]
	quest.5B4E41976ED2EA68.title: "Cave Spider Hunter"
	quest.5B6EFEB7D24460AE.quest_desc: ["Rubber Essences can only be used to craft Rubber."]
	quest.5B6EFEB7D24460AE.title: "Rubber"
	quest.5BC1AC0FCDB66C18.quest_desc: ["Craft Superium Essence with a Infusion Crystal."]
	quest.5BC1AC0FCDB66C18.quest_subtitle: "&9Unlock: &5&lMystical Agriculture Tier II."
	quest.5BC1AC0FCDB66C18.title: "&9Imperium Essence"
	quest.5BC7FEA7A8B0FAF4.quest_desc: ["End Essences can be used to craft Endstone and Purpur blocks."]
	quest.5BC7FEA7A8B0FAF4.title: "End Stone"
	quest.5BF029B9FC002B66.quest_desc: ["A savory dish made with layers of breaded eggplant, rich tomato sauce, and melted cheese."]
	quest.5BF029B9FC002B66.title: "Eggplant Parm"
	quest.5C02D64E03D9CB44.quest_desc: ["Expand the battery!"]
	quest.5C02D64E03D9CB44.title: "Double Batteries!"
	quest.5C284B8BE1830B7B.quest_desc: ["Obsidian can be used for many things."]
	quest.5C284B8BE1830B7B.title: "More Obsidian!"
	quest.5C2B54CBE2B75EE3.quest_desc: ["Heavy Water must be separated from regular water in a Centrifuge, and it requires processing a considerable amount of water to obtain. Fortunately, there’s no shortage of water in the world. :)"]
	quest.5C7A9BE6D671B566.quest_desc: ["A Overdrive Module is something like a state-of-the-art memory card that is only used in high-quality machines!"]
	quest.5CAE62DF8B9F9DDF.quest_desc: ["The Iron Casing serves as the structural core for future automated defenses"]
	quest.5CBF41E8BBB1F44C.title: "Gingers Snaps"
	quest.5CC8089FCF818282.title: "Witch Hunter"
	quest.5CD33EB2CCD8B77E.quest_desc: ["Combine an Iron Ingot with a Ender Perl to obtain a Ender Ingot."]
	quest.5CD33EB2CCD8B77E.title: "Ender Ingot"
	quest.5CE0F4EC882C8607.quest_desc: ["After harvesting a fully grown plant of Golem Steel Seeds, you get Golem Steel Essences."]
	quest.5CE0F4EC882C8607.title: "Golem Steel Essence"
	quest.5CE655C1DB5E841D.quest_desc: ["The ME Crafting Terminal gives you full access to your ME System and includes a built-in grid. With JEI support, it auto-fills recipes using items from storage — crafting has never been this easy."]
	quest.5CE655C1DB5E841D.quest_subtitle: "Complete Plastic Sheets Quest"
	quest.5CE655C1DB5E841D.title: "Smart Crafting Access"
	quest.5D02369AA18E75CB.quest_desc: ["After harvesting a fully grown plant of Iron Seeds, you get Iron Essences."]
	quest.5D02369AA18E75CB.title: "Iron Essence"
	quest.5D237B59B6ED2E42.quest_desc: [
		"The Water Separator transform water into Oxygen and Hydrogen."
		""
		"The machine works by putting water in the second slot and it will generate Hydrogen and Oxygen that you can gathe placing buckets under the tanks."
	]
	quest.5D41B06568B233BA.quest_desc: [
		"The Hooked mod introduces a variety of grappling hooks, each with unique abilities to aid in exploration and mobility. "
		""
		"&aEquip one in a 'Hook' slot and take your adventures to new heights!"
	]
	quest.5D41B06568B233BA.title: "Ready to Explore?!"
	quest.5D572AAB6E558080.quest_desc: ["Infused Iron Ingot is a basic resource. These are made by place Iron Ingots on a Infusion Altar."]
	quest.5D572AAB6E558080.title: "Infused Ingots"
	quest.5D62B16909303CA5.quest_desc: [
		"Steel is made by combining iron with carbon and sometimes other materials."
		"For efficiency, it’s recommended to convert full iron blocks into steel—just be ready for the high fuel cost!"
	]
	quest.5D62B16909303CA5.title: "First Steel!"
	quest.5D7008A2FAD11948.quest_desc: ["The Chemical Reactor can make items and fluids react. We will use this in the next step."]
	quest.5D7008A2FAD11948.title: "Chemical Reactor #4"
	quest.5DBA28B1CD575F58.quest_desc: ["Once you’ve mined some Raw Naquadah, smelt it in a furnace to obtain Refined Naquadah the purified form used in high-tech crafting."]
	quest.5DBA28B1CD575F58.title: "Refined Naquadah"
	quest.5DCA262BD711F8CE.quest_desc: ["Cables link ME machines together. When machines are placed next to each other, they auto-connect — but to bridge distances, you'll need cables to keep the network working."]
	quest.5DCA262BD711F8CE.title: "Connecting the System"
	quest.5DD18664A5BD1751.quest_desc: [
		"The Ritual of the Forest can be performed using either an Oak or a Jungle Sapling, depending on the recipe."
		""
		"To start a ritual, place the required items on the Wooden Stands and grow the necessary Sapling in the center."
	]
	quest.5DD18664A5BD1751.title: "Ritual of the Forest #3"
	quest.5DE18808E923C203.quest_desc: ["Chromium Essences can be used to craft Chromium Ingots."]
	quest.5DE18808E923C203.title: "Chromium Ingot"
	quest.5DECD68D6F75446A.quest_desc: ["Craft a Tungsten Seed!"]
	quest.5E1498D580A8C947.quest_desc: ["It increases the Energy production of the windmill by exactly two times."]
	quest.5E1498D580A8C947.title: "Improve Windmill"
	quest.5E3C61735372025A.quest_desc: [
		"The Bow is a ranged weapon used to shoot arrows. "
		"It's essential for long-distance combat!"
	]
	quest.5E3C61735372025A.quest_subtitle: "Bow"
	quest.5E3C61735372025A.title: "Ranged Weapon!"
	quest.5E680E63D5F07040.quest_desc: [
		"You can also transport liquids with the bucket."
		""
		"&aThis modpack increases the stack of the bucket to 16."
	]
	quest.5EAF3C91FB065A94.quest_desc: [
		"The Wind Turbine uses its massive blades to generate power from wind. It requires a 1x1x5 space and must have an unobstructed view of the sky to operate. It works in all weather conditions, day and night."
		""
		"&a💡 Hint: The higher you place it, the more power it generates."
	]
	quest.5EB1091A8739B644.quest_desc: ["Buy some reward!"]
	quest.5EB1091A8739B644.title: "Cow Spawn Egg"
	quest.5EBB76813637E171.quest_desc: ["Now that you have The Blueprint, it’s time to craft the Katana Blade. Start with a Steel Ingot and use the Katana Blueprint. Then combine it with a Tool Rod of your choice and you're ready to slash."]
	quest.5EC9D0DA054992AF.quest_desc: ["Smelt your Sourdough to obtain Sourdough Bread."]
	quest.5EC9D0DA054992AF.title: "Sourdough Bread"
	quest.5F22091057D05FA3.quest_desc: ["The ME Controller is the brain of your ME Network, providing up to &b32 channels&r per side when using Dense Cables. Only one is allowed per network, but you can expand it as a multiblock for more power and control."]
	quest.5F22091057D05FA3.title: "The Network Core"
