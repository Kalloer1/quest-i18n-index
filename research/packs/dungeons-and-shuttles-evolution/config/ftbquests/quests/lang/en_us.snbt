	]
	quest.5F488B445B7C8D99.title: "Kanthal Coils"
	quest.5F61E0B8824074A5.quest_desc: ["The Storage Drawers mod surprisingly adds different storage drawers to the game :) You can fit many items in it, but only one kind. If it's full, there are upgrades for it, Shift + Right Click on the Drawers and insert the upgrades."]
	quest.5F739ED4FC57A1AA.quest_desc: ["The Filter Module is used in various recipes. Eg.: Upgrade Template"]
	quest.5F8999D8D0416314.quest_desc: ["Just like almost every modpack, gather some wood to get started!"]
	quest.5F8999D8D0416314.quest_subtitle: "Getting Wood"
	quest.5F8999D8D0416314.title: "&eWood needed"
	quest.5FA0F9CC64F603A2.quest_desc: ["Rotten Flesh... useless BUT... Put it in the furnace the Rotten Flesh and..."]
	quest.5FA59527F7D1B093.quest_desc: ["With this tool, you can summon one at will! However, it only works once, making it a costly way to call upon the storm."]
	quest.5FAC23842FC293F0.quest_desc: ["Lead Ore can be found at Y-levels -24 to 40 to."]
	quest.5FAC23842FC293F0.title: "Lead"
	quest.601AEE0FF3F3B1BB.quest_desc: ["Let's start with the most important core blocks for the multiblock."]
	quest.601AEE0FF3F3B1BB.title: "Master Assambler 2k25 #2"
	quest.6045790112418DBE.quest_desc: ["Buy some reward!"]
	quest.6045790112418DBE.title: "Prudentium Farmland"
	quest.6045FF950C984A2E.quest_desc: ["Craft a few Ice Seeds."]
	quest.60778D8946B674FA.quest_desc: [
		"A mystical ingot created through Aura-based crafting."
		"Use the Altar of the Sea with infused ingredients and ensure enough Aura surrounds you."
	]
	quest.60963902731DE620.quest_desc: [
		"Using the Atomic Reconstructor, you can transform regular Diamond into Diamatine Crystals."
		"Using the Atomic Reconstructor, you can transform regular Diamond Block into Diamatine Crystal Block."
	]
	quest.60C95D5005ED98EF.quest_desc: ["The Tech Reborn Battery is a rechargable battery used to power various blocks and tools. It is also used in various machine recipes."]
	quest.60FDF28A1EE84786.quest_desc: ["Place Carbon Mesh into a Compressor (or equivalent machine) to create Carbon Plates. These are essential components for crafting high-end machines and advanced items later on."]
	quest.60FDF28A1EE84786.title: "Carbon Plate"
	quest.6130A386B3A478F7.quest_desc: ["Use your Hands to get Bonemeal."]
	quest.6130A386B3A478F7.title: "White dye"
	quest.6138C74AC93CD753.quest_desc: ["Craft the different exterior components needed for the rocket, such as the nose cone and engines."]
	quest.6138C74AC93CD753.title: "Components for the Rocket! #1"
	quest.6140C99537A0B576.quest_desc: ["The Copper Coil Block used for crafting electrical machines and transformers."]
	quest.61B2EE7761289FA4.quest_desc: [
