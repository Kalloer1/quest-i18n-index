	quest.6309EA92EEDABB2C.quest_desc: ["Industrial Hemp is a useful plant in Immersive Engineering, mainly used for fiber. It grows from Hemp Seeds, which can be obtained by breaking grass. Plant the seeds on farmland, let them grow, and harvest the tall stalks for crafting materials!"]
	quest.6309EA92EEDABB2C.title: "Industrial Hemp"
	quest.6315DB46F5B42C0D.quest_desc: ["Blazing Dust is the fire elemental dust. Is used in several advanced crafting recipes."]
	quest.6315DB46F5B42C0D.title: "Blazing Dust!"
	quest.631B14A7C84E5C32.quest_desc: ["Buy some reward!"]
	quest.631B14A7C84E5C32.title: "Loot Bags"
	quest.632AF429F9DF1F62.quest_desc: ["You can melt gems using the Material Liquefier."]
	quest.6369A77752A57F91.quest_desc: ["Buy some reward!"]
	quest.6369A77752A57F91.title: "Potatos"
	quest.63B56E54F97F6E57.quest_desc: [
		"A step up in explosive engineering."
		"The Blue Bomb features a slightly delayed detonation and a noticeably wider blast radius — though it still won’t leave craters behind."
	]
	quest.63BEFCE54D608F1C.quest_desc: [
		"Strengthen the hammer!"
		""
		"&a💡 Hint: If you don't know how to produce steel then follow this chapter:&o \"Ores and Alloys\""
	]
	quest.63CA3629DBDA15E7.quest_desc: [
		"There are a lot of ways of creating Aura and feeding it back into the environment."
		""
		"&a💡 Hint: Of course, Nature's Aura also adds means to automate procedures like this."
	]
	quest.63D9B03D178D5D8D.quest_desc: ["To make Cupronickel you need to combine Annealed Copper and Nickel Ingots in Foundry or later in Advanced Alloy Smelting Factory."]
	quest.63D9B03D178D5D8D.title: "Cupronickel"
	quest.63DB393C1AD541FB.quest_desc: ["Combine 4 Strings to craft a block of White Wool. A handy trick if you can't find any sheep nearby!"]
	quest.63DB393C1AD541FB.title: "White Wools"
	quest.63EB8F4F81F98D27.quest_desc: ["Rice Dough is a component. It is used to create Raw Rice Bread."]
	quest.63EB8F4F81F98D27.title: "Rice Dough"
	quest.63F4C947BC1F4D6B.quest_desc: ["Use the clay bucket to produce some Fresh Water."]
	quest.63F4C947BC1F4D6B.title: "Fresh Water"
	quest.64281EF62AE96CDA.quest_desc: [
		"Uru Metal is the most powerful and rarest metal in existence."
		"Its incredible durability and energy resonance make it unmatched in strength — perfect for legendary-tier tools and armor."
		"Forging it requires exotic materials, fluid alloying, and possibly mythical components few have ever seen."
		""
		"This material isn't necessary to complete your journey — but for those who seek true mastery, it's the final challenge."
		""
		"&a(Of course, there are much stronger materials than this.)"
	]
	quest.64281EF62AE96CDA.title: "              Uru Metal Ingot!              "
	quest.643A48E9E5C7366C.quest_desc: ["After harvesting a fully grown plant of Coal Seeds, you get Coal Essences."]
	quest.643A48E9E5C7366C.title: "Coal Essence"
	quest.645480FD6047F235.quest_desc: ["Top-tier upgrade for near-maximized machine output."]
	quest.6460BAE91B56EFE2.quest_desc: ["The Advanced Circuit is used in a variety of mid and high tier crafting recipes such as the Empowerer and stc.!"]
	quest.6460BAE91B56EFE2.title: "&cAdvanced Circuit!"
	quest.649A700DE88F345D.quest_desc: [
		"Sulfur is a non-metal added by various mods. Find some sulfur veins and collect as much as you can."
		""
		"Hint: (Y Level = 55 to 80) Sulfur ore looks like yellow andesite."
	]
	quest.649A700DE88F345D.title: "Sulfur"
	quest.64B90F7AD1E944BE.quest_desc: ["The Draconic Core is an important crafting ingredient for Draconic Evolution. It is used in many recipes and it is also used to stabilize a mob spawner into a Stabilized Mob Spawner."]
	quest.64CE7A077DB6829F.quest_desc: ["Eggs are a versatile ingredient used in many recipes. They are an essential part of any kitchen!"]
	quest.64CE7A077DB6829F.title: "Eggs"
	quest.64FC77D656FAC3E2.quest_desc: ["The Data Storage Core is specialized component required for crafting Data Storage Chips and Ultimate Circuits. Also used in some advanced machinery where data handling is critical."]
	quest.65935C0EA92D8F7B.quest_desc: ["The Cutting Machine will give you better ratios for bolts, gears, rings and rods. It uses a little bit of lubricant every time."]
	quest.659A05BA1DBC7D4A.quest_desc: ["Rotten Flesh can make a very tasty dish."]
	quest.659A05BA1DBC7D4A.title: "Liver and Onions"
	quest.65B2DC6C3DAF0E66.quest_desc: ["Craft a few Zombie Seeds."]
	quest.65BA69CEDE2D3A2A.quest_desc: [
		"Used to craft Tier 5 essence seeds."
		"It cannot be planted and is only used as a crafting component for higher-tier crops."
	]
	quest.65BA69CEDE2D3A2A.quest_subtitle: "Crafting Seeds"
	quest.65C560B0E21E4BFD.quest_desc: [
		"Cast... Casting :)"
		"Tip is an enhancement to your existing tool."
	]
	quest.65C560B0E21E4BFD.title: "Sword"
	quest.65CDE4DE6A5F94A6.quest_desc: ["The MMU is a key electronic component used in advanced machines and circuit assemblies. It handles data control and memory access."]
	quest.65CDE4DE6A5F94A6.title: "Memory Management Unit"
	quest.65DC499CEDE5DB3A.quest_desc: ["Craft a few Aluminum Seeds."]
	quest.66523A5E045CD33F.quest_desc: ["Buy some reward!"]
	quest.66523A5E045CD33F.title: "Loot Bags"
	quest.667F2802B79F702A.quest_desc: ["Same space as the Diamond Chest."]
	quest.6682F3288652BC40.quest_desc: ["Craft an Alumite Pickaxe Head, it's required to mine tougher ores like Bismuth and Cobalt."]
	quest.66B00FAAFD55D1BE.quest_desc: ["Using a lot of Sulfuric Acid and Platinum in the Chemical Reactor, you’ll get Platinum Sulfuric Acid Fluid."]
	quest.66B00FAAFD55D1BE.title: "Platinum Sulfuric Acid #6"
	quest.66BD505148BCFB12.quest_desc: ["The Silicon Wafer is a key material for advanced electronics, used in crafting circuits and high-tech components."]
	quest.66BD505148BCFB12.title: "Silicon Wafer?"
	quest.66BD6E891AD85DF2.quest_desc: [
		"The Bow of the Wyvern uses RF/FE to recharge and use and it can store up to 1 million RF. It has many options to customize a bit the player's bow."
		""
		"The Sword of the Wyvern uses RF/FE to recharge and use and it can store up to 1 million RF. It has an area of effect option where it can attack mobs up to 3x3 of the intial hit."
		""
		"&cUpgrade modules required!"
	]
	quest.66BED23BEF96D9B3.quest_desc: ["Processors are used in countless devices and machines."]
	quest.66BED23BEF96D9B3.title: "Logic Processor"
	quest.6705E63052B6CF47.quest_desc: ["Bread is the most basic food."]
	quest.6705E63052B6CF47.title: "Bread"
	quest.67156219805EC64A.quest_desc: ["Highly fertile soil for powerful essence seeds. Unlocks stronger resource growth."]
	quest.6728F445599635DE.quest_desc: ["Craft a Steel Boots."]
	quest.673BACAF0E9373B9.quest_desc: ["Collect some items and prepare yourself for upcoming important steps."]
	quest.673BACAF0E9373B9.title: "Natural Resources"
	quest.673F89F58FF466CD.quest_desc: ["For a Calculation Processor you need Certus Quartz Crystals!"]
	quest.674E53C384A9B7BD.quest_desc: ["This heavy-duty head is used to craft a hammer capable of mining in a 3×3 area. Combine it with a handle and part to create a tool that can break multiple blocks at once — perfect for clearing stone and ores quickly."]
	quest.675C4AAE26058F59.quest_desc: [
		"Iron bars are a first step toward building safe and secure infrastructure."
		""
		"&9Upon completion of this quest you will unlock the chapter: &o\"Protect the Earth\""
	]
	quest.675C4AAE26058F59.title: "     &9Unlock: &6&lProtect the Earth     "
	quest.6790641A6C33FD37.quest_desc: [
		"Divine Pact is one of the hardest items to find. You’ll need to explore Piglin Villages and Ancient Pyramids deep to obtain it."
		"It’s a key ingredient in crafting the Soul Binding Crystal!"
	]
	quest.67AE3958EE5DD8BD.quest_desc: ["Netherstar Essences can be used to craft Nether Star Shards which can be converted into Nether Stars."]
	quest.67AE3958EE5DD8BD.title: "Nether Stars"
	quest.680E799BAD6F52E1.quest_desc: [
		"The Rolling Machine is used to produce various coils, and vanilla items such as rails and carts. It already requires an &9Electronic Circuit&r, which you won’t craft as part of a quest, but it will be essential later on as well."
		""
		"&a💡 Hint: Use a wrench to dismantle this machine! I strongly recommend to progress a bit in the chapter &9&o\"Ores and Alloys Tier II.\" &r&abefore you continue here."
	]
	quest.680E799BAD6F52E1.title: "          &eRolling Machine          "
	quest.6826712B89B85BBF.quest_desc: [
		"The Leaf Generator can generate RF just by being placed alongside some Leaves."
		"It will destroy the leaves, generating 300 RF per leaf broken in the process."
	]
	quest.68520168C6DDDD11.quest_desc: ["You can get the Gold Leaf by smashing the Golden Leaves."]
	quest.68520168C6DDDD11.title: "Gold Leafs!"
	quest.6853C066E44F5E5D.quest_desc: [
		"This questbook will guide you step-by-step through this expert modpack, designed to challenge and excite you. Based on the legendary  &6&lDDSS &rmodpack,  &6&lDaSE &rbrings you a reimagined experience with rebalanced recipes, tougher challenges, and greater rewards."
		""
		"The difficulty of each quest determines the rewards you receive: harder quests offer better loot! By completing missions, you'll earn coins that you can use to purchase items in the quest shop."
		""
		"Coin Tiers:"
		"  &6T1 - Copper Coin"
		"  &7T2 - Iron Coin"
		"  &eT3 - Gold Coin"
		"  &bT4 - Diamond Coin"
		"  &aT5 - Emerald Coin"
		"  &9T6 - Netherite Coin"
	]
	quest.6853C066E44F5E5D.quest_subtitle: "Introduction to DaSE"
	quest.6853C066E44F5E5D.title: "&l&2Welcome to Dungeons and Shuttles Evolution"
	quest.686224352F5A16FB.quest_desc: ["Nurtures your crops with even greater speed and coverage."]
	quest.68634EA7AAD7EECE.quest_desc: ["For starters, find some sheep to get Wool with your new Shears."]
	quest.68634EA7AAD7EECE.title: "Wool for the Bed"
	quest.6882BBB73170E74C.quest_desc: ["The Drill can be enhanced with various upgrades. The Speed Augment temporarily increases the mining speed when used."]
	quest.6882BBB73170E74C.title: "More Drill Upgrade!"
	quest.68959C3B91300F5F.quest_desc: [
		"This item can pull in nearby items and experience orbs within a set range. Right-clicking adjusts the range, while shift + right-click toggles it on or off. Attracting close items consumes little to no Blood, whereas pulling from a greater distance requires more. Sneaking prevents item attraction."
		""
		"Reversing the recipe creates the opposite version, which repels items and experience orbs instead."
	]
	quest.68A5FEA80EA07B53.quest_desc: ["A nutritious survival food made from dried meat, berries, and fat. Long-lasting and energy-packed—perfect for long journeys or tough battles."]
	quest.68A5FEA80EA07B53.title: "Pemmican"
	quest.69280F5FAACEC6AD.quest_desc: ["This item will turn the drawer into a void drawer, voiding any items coming in once it's full. "]
	quest.6955E1C44446B6BC.quest_desc: ["Buy some reward!"]
	quest.6955E1C44446B6BC.title: "Rabbit Spawn Egg"
	quest.6957034FB6916226.quest_desc: ["Craft a Electrotine Generator."]
	quest.69718F18EF6B96C0.quest_desc: [
		"The Arc Furnace is a massive 5×5×5 multiblock structure capable of processing large amounts of ores, alloys, and advanced materials. It uses Electrodes and a steady supply of power to operate efficiently. With the right setup, it can even double your ore output and handle special recipes unavailable in smaller machines."
		""
		"Be prepared, this will consume a serious amount of steel!"
	]
	quest.69718F18EF6B96C0.title: "Arc Furnace"
	quest.697D49A54C1EC304.quest_desc: ["A specialized crafting table used for assembling machine components and applying upgrades to tools like the Mining Drill and Revolver. Essential for every engineer!"]
	quest.69A0BD8AF23AAB60.quest_desc: ["You need more Copper Ingots!"]
	quest.69A0BD8AF23AAB60.title: "More Copper!"
	quest.69BB80092BE7A0ED.quest_desc: [
		"The Advanced Crafting Table opens the door to powerful tools and complex machines. "
		"With this table, you can create recipes far beyond the basics. "
		"Craft your first Advanced Crafting Table and unlock advanced technology!"
	]
	quest.69BB80092BE7A0ED.title: "          &aAdvanced Crafting?          "
	quest.69E92D48F72B0D3C.quest_desc: [
		"The Rocket Launch Pad is required to launch your spaceship into space in Stellaris."
		"Place 9 blocks in a 3×3 square to create a functional Launch Pad."
	]
	quest.69E92D48F72B0D3C.title: "Launch Pad"
	quest.6A0A0A258208DDD4.quest_desc: ["The 1k ME Storage Component is used to create the 1k ME Storage Cell or higher-tiered Storage Components."]
	quest.6A385D1D161076A8.quest_desc: ["As promised, let’s dive into your first upgrades. To begin customizing your equipment, you first need to craft the foundation of all enhancements: the Module Core."]
	quest.6A385D1D161076A8.title: "Module Cores"
	quest.6A4EF2362880CD1F.quest_desc: ["Buy some reward!"]
	quest.6A4EF2362880CD1F.title: "Sheep Spawn Egg"
	quest.6AB622B2A7D017E4.quest_desc: ["The XyCraft Gem is found deep underground and comes in three vibrant colors."]
	quest.6AB622B2A7D017E4.title: "Red Xychorium Gems"
	quest.6ABBA7DBFD78B212.quest_desc: [
		"The Atomic Reconstructor is a key machine in the Actually Additions mod that uses RF energy to transform various blocks and items using a laser beam. This machine is essential for many recipes in the mod, such as creating Restonia Crystals and other advanced materials."
		""
		"&a💡 Hint: Actually Additions has an official website where you can find more detailed descriptions and guides for all its machines and features. Check it out here: &ohttps://ellpeck.de/actaddmanual/"
	]
	quest.6ABBA7DBFD78B212.title: "          Atomic Reconstructor          "
	quest.6AC3D00CF9C4F860.title: "Vindicator Hunter"
	quest.6B41704F591ABDD6.quest_desc: ["Craft Intermedium Essence with a Infusion Crystal."]
	quest.6B41704F591ABDD6.title: "Tertium Essence"
	quest.6B44938AC91E8553.quest_desc: ["Canola Oil can be used in an Oil Generator. It displays the amount of power it generates in its GUI, however, it can be upgraded further to yield more power than that! If you break the Oil Generator, it will keep the liquid inside. "]
	quest.6B44938AC91E8553.title: "Power!"
	quest.6B4FA513A5E57E44.quest_desc: ["Use the Metallurgic Infuser to obtain Refined Obsidian Dust."]
	quest.6B4FA513A5E57E44.title: "Refined Glowstone Ingot"
	quest.6B5825FB58ED37EF.quest_desc: ["The Oxygen Distributor alloq you to fill a romm with osygen. For this, place a full an oxygen tank with oxygen with the Water Separator."]
	quest.6B73159629246DC0.quest_desc: ["Ok, let's go on with... Eggplant!"]
	quest.6B73159629246DC0.title: "Eggplant"
	quest.6B7375520ECCC07F.quest_desc: [
		"Bone Meal is a quick way to grow crops, trees, and grass."
		"Compost your plants to get more bone meal!"
	]
	quest.6B7375520ECCC07F.title: "Bone Meals Efficiently!"
	quest.6B9B40FDE83C6C4B.quest_desc: [
		"With the last 5 Heavy Engineering Blocks in hand, you now have everything needed to complete the Arc Furnace!"
		"Check the Engineer’s Manual for the exact structure and use the projector to help build it."
		""
		"&a💡 Hint: Once built, right-click the Cauldron with an Engineer’s Hammer to assemble the multiblock!"
	]
	quest.6B9B40FDE83C6C4B.title: "Final Assembly: Arc Furnace"
	quest.6BA0C5C095916F83.quest_desc: ["Advanced Machine Frames are used to craft Advanced Machine Casings."]
	quest.6BA0C5C095916F83.title: "Machine Frames"
	quest.6BB096D8B3508336.quest_desc: [
		"The Offering to the Gods is a multiblock structure made from 1 Offering Table and 36 Flowers."
		"To make an offering you need Spirits of Calling."
	]
	quest.6BC4D21D82ADB034.quest_desc: ["The Infinity Catalyst is used to craft many of the tools and components in the mod, including the Infinity Ingot."]
	quest.6BC4D21D82ADB034.title: "Infinity Catalyst"
	quest.6BC7C0584B32A536.quest_desc: ["Reinforced Glass is an opaque building block added by Tech Reborn. Thanks to its high explosion resistance, this material is ideal for building specialized machines."]
	quest.6BC7C0584B32A536.title: "Reinforced Glass"
	quest.6BCDA8148F61FDD0.quest_desc: ["This upgraded solar panel generates an impressive 512 FE/tick, making it one of the most powerful passive energy sources available. Place it in direct sunlight and enjoy a steady flow of energy—completely maintenance-free!"]
	quest.6BD4B66EF8EE2EED.quest_desc: [
		"Refined Storage makes storing and accessing your items easy and fast. To get started, you'll need &6Processor Bindings&r — these are key components used to craft the brains of your system: processors. "
		"No Bindings, no automation!"
	]
	quest.6BD4B66EF8EE2EED.title: "Refined Storage"
	quest.6BF005B1CC048699.quest_desc: ["Make a basic mesh. It is made of different materials, the more valuable the material the more durability it will have."]
	quest.6C03F95FD5C57A3D.quest_desc: ["Buy some reward!"]
	quest.6C03F95FD5C57A3D.title: "Sugar Cane"
	quest.6C4AF7F969021C94.title: "Wither Hunter"
	quest.6C5D2C13AB6A0905.quest_desc: ["I will use the Dark Steel Ingot later on. Make some of these."]
	quest.6C5D2C13AB6A0905.title: "Dark Steel"
	quest.6C64311984860BD1.quest_desc: ["This material has an Obsidian Tier. This means that you can extract Obsidian with it."]
	quest.6C75B5ACCF2DAAE2.quest_desc: ["Buy some reward!"]
	quest.6C75B5ACCF2DAAE2.title: "Flint"
	quest.6C7D3B52B2163910.quest_desc: ["60k NaK Coolant Cells are a type of cooling mainly used in crafting."]
	quest.6C7D3B52B2163910.title: "60k NaK Coolant Cell"
	quest.6C81BFD6429546B5.quest_desc: [
		"The Heat Exchanger is used to chill gases and fluids or hot item to very low temperatures."
		"You've probably already figured out that this is also a multi-block. You need to install different hatches into the main multiblock structure in order to make it functional."
		""
		"&a💡 Hint: When holding the MI Wrench near a placed machine, it will show you the multiblock structure and how to assemble it."
	]
	quest.6C81F9D8A05451EE.quest_desc: ["Egg sandwich hmmm."]
	quest.6C81F9D8A05451EE.title: "Egg Sandwich"
	quest.6C8DB253852755A3.quest_desc: ["Put Cryonite Powder in a Material Liquefier to obtain Cryofluid. Cryofluid is an extremely cold liquid used primarily for advanced cooling applications and high-end machinery."]
	quest.6C8DB253852755A3.title: "Cryofluid Bucket"
	quest.6C8E93FC8C0D2F21.quest_desc: ["White Magic Dust is a purified magical substance used in many advanced rituals and crafting recipes."]
	quest.6C8E93FC8C0D2F21.quest_subtitle: "&9Unlock: &f&lWhite Magic - Tier II."
	quest.6CB3C6A46AB2B3EC.quest_desc: ["The Inferium Ingot is a key material for crafting advanced tools and armor. Use Prosperity Shards and Inferium Essence to craft this mystical resource and unlock new possibilities!"]
	quest.6CB3C6A46AB2B3EC.title: "Inferium Ingots"
	quest.6CD5E9E490419558.quest_desc: ["The Enervator discharges items that hold CF/FE/RF and stores the energy in its energy supply."]
	quest.6D0D82B93E26D534.title: "Grottol"
	quest.6D50658B450D918E.quest_desc: ["Meshing the sandy glass to obtain Sandy Glass Dust."]
	quest.6D50658B450D918E.title: "Sandy Glass Dust"
	quest.6D60AC68218E5870.quest_desc: ["Used in powerful crafting recipes requiring Supremium essence."]
	quest.6D60AC68218E5870.quest_subtitle: "&9Unlock: &5&lMystical Agriculture Tier III."
	quest.6D836B97A678E180.quest_desc: ["Turn logs into planks the smart way! Without an saw, you can craft 2 planks per log. But use an saw, and you'll double your efficiency, crafting 4 planks per log. Work smarter, not harder!"]
	quest.6D836B97A678E180.quest_subtitle: "Efficient Crafting #1!"
	quest.6D836B97A678E180.title: "Planks"
	quest.6DC3CB2C579BFA1A.quest_desc: ["After harvesting a fully grown plant of Tungsten Seeds, you get Tungsten Essence."]
	quest.6DC3CB2C579BFA1A.title: "Tungsten Essence"
	quest.6DCD407BE1435FCF.quest_desc: ["The Copper Tank is your next tier fluid storage tank, capable of storing 32 buckets (32,000 mB) of Fluid."]
	quest.6DEDFEDD06E5DDC3.quest_desc: ["The Meat Feeder is an item added by Industrial Foregoing. It is used to automatically keep the player fed while in their inventory. The Meat Feeder requires Liquid Meat to operate and can be filled or emptied by right-clicking a tank. When the player's hunger or saturation drops below full, the Meat Feeder will drain 400 mB of Liquid Meat and restore 1/2 shank of hunger and 1 saturation."]
	quest.6E04832112087146.quest_desc: ["Sapphire is a gem added by Tech Reborn mods. Collect more of it!"]
	quest.6E04832112087146.title: "Sapphire!"
	quest.6E076915DC8463C3.quest_desc: ["Buy some reward!"]
	quest.6E076915DC8463C3.title: "Test Tubes"
	quest.6E1A4F0AF89A8BD7.quest_desc: ["Upgrade kits are items used to incrementally upgrade Modern Industrialization machines to higher tiers."]
	quest.6E3B1AF6599B97AF.quest_desc: ["Emerald Essences can be used to craft Emerald Ingots."]
	quest.6E3B1AF6599B97AF.title: "Emerald"
	quest.6E54B1CE9D7ABE7C.quest_desc: ["This specialized module keeps your cart's liquid tanks clean and functional by automatically removing unwanted byproducts during operation."]
	quest.6E54B1CE9D7ABE7C.title: "Pump"
	quest.6E6CA5A0DD5E4D0D.quest_desc: ["You will find most Glowstones at the top of The Nether."]
	quest.6E6CA5A0DD5E4D0D.title: "Glowstone!"
	quest.6E8D115D6AAC5A96.quest_desc: ["Craft the Iron Sword."]
	quest.6EB949A1D701043C.quest_desc: ["Applied Energistics 2 is all about smart storage and automation. Before anything else, we need to craft two essential resources: &9Certus Quartz Crystals&r and &dFluix Crystals&r. These will be the core of our ME system later — so keep a few extra on hand!"]
	quest.6EB949A1D701043C.title: "Applied Energistics"
	quest.6EC29641D10E1420.quest_desc: ["Buy some reward!"]
	quest.6EC29641D10E1420.title: "Eggs"
	quest.6ED88C970BEB060B.quest_desc: ["Before operating advanced machinery, it's vital to prepare proper cleaning components. These tools ensure safe and efficient machine maintenance."]
	quest.6ED88C970BEB060B.title: "Cleanroom Protocols"
	quest.6EEFDBCE987FA053.quest_desc: ["Gold is used for redstone components, tools, and magical items. It’s rare—so mine it when you can!"]
	quest.6EEFDBCE987FA053.title: "Gold"
	quest.6F16929C945D5AA1.quest_desc: ["Iridium production is complex, but mastering it is key to progressing in late-game technology!"]
	quest.6F28E89B4E32ED6C.quest_desc: ["Buy some reward!"]
	quest.6F28E89B4E32ED6C.title: "Copper Tool"
	quest.6F3972FB0E363797.quest_desc: ["Buy some reward!"]
	quest.6F3972FB0E363797.title: "Arrows"
	quest.6F43971FB11E56BD.quest_desc: ["Dark Gem added by EvilCraft. Can be found at Y-levels 0 to 66."]
	quest.6F43971FB11E56BD.title: "Dark Gems"
	quest.6F52C57067B1B031.quest_desc: ["No need to worry — you can now upgrade your Quantum Catcher using 3 Stellarite Pieces and a Nether Star to create the powerful Boss Catcher."]
	quest.6F652E02A6F1186C.quest_desc: ["ME Drives allow users to store up to &b10 ME Storage Cells&r as opposed to a single cell that can be placed in a ME Chest."]
	quest.6FA675FB33E07F85.quest_desc: ["The Crusher grinds solid materials into Dusts."]
	quest.6FA675FB33E07F85.title: "Another Crusher?"
	quest.6FCC9414CC5CC661.quest_desc: ["Well, let's make two of them!"]
	quest.6FCC9414CC5CC661.title: "Basic Drawer"
	quest.6FCC99CCE5839282.quest_desc: ["After harvesting a fully grown plant of Silicon Seeds, you get Silicon Essences."]
	quest.6FCC99CCE5839282.title: "Silicon Essence"
	quest.6FCDE84C526DD384.quest_desc: ["Well, let's try out our new machine, put a bucket of water in it and wait."]
	quest.6FCDE84C526DD384.title: "Salt Block"
	quest.6FE0AA1C3428663E.quest_desc: [
		"However, when it comes to the Nether dimension, simple bone meal doesn't fare so well."
		""
		"This issue, however, can be easily avoided through the use of Crimson Meal."
		""
		"Not only will this substance make any Nether Wart plants grow faster in a similar fashion to how bone meal works"
	]
	quest.6FE0AA1C3428663E.title: "Crimson Meals"
	quest.6FF2673F0F976AB0.quest_desc: ["It's just a Powder..."]
	quest.6FF2673F0F976AB0.title: "Powder of no Storage"
	quest.701AAC457D7BBF21.quest_desc: [
		"Using the Atomic Reconstructor, you can transform regular Iron Ingot into Enori Crystal, a key component for advanced technology."
		"Using the Atomic Reconstructor, you can transform regular Iron Ingot Block into Enori Crystal Block."
	]
	quest.701AAC457D7BBF21.title: "Enory Crystals"
	quest.704753A709AB20F1.quest_desc: ["An upgraded version of the Advanced Control Circuit, used in many high-tier machines and components. It’s quite expensive—better craft it in an Assembler to save on materials!"]
	quest.7048F9382CDA5C6C.quest_desc: ["Used to configure machines, rotate blocks, and form multiblock structures in Immersive Engineering."]
	quest.7053A2BF448AB0C1.quest_desc: ["Base Modules are available in various tiers and are required for a wide variety of crazy things."]
	quest.709711254B30FD92.quest_desc: ["Ok, let's go on with... Chilipepper!"]
	quest.709711254B30FD92.title: "Chilipepper"
	quest.70E3D43910AC7953.quest_desc: [
		"Annealed Copper is produced by heating Copper and then cooling it slowly, making it softer and easier to work with."
		"Craft it in a Blast Furnace."
	]
	quest.70E3D43910AC7953.title: "Annealed Copper"
	quest.70E8A53D23B12FA0.quest_desc: ["The LV Wire Connector is used to link Low Voltage (LV) Wires to machines and power sources. Place it on a block, Right-click to attach a LV Wire Coil."]
	quest.70E8A53D23B12FA0.title: "LV Wire Connector"
	quest.70EE5EE4A6212B62.quest_desc: ["A Diamond Chest offers a huge upgrade in storage space, far beyond that of an Iron or Gold Chest."]
	quest.7102081CA7384A67.quest_desc: ["Bismuth Ore spawns naturally in the Nether, similar to Cobalt, and has a reddish-orange appearance."]
	quest.7102081CA7384A67.title: "Bismuth"
	quest.7134C3CB2BC1FC6A.quest_desc: ["Ok, let's go on with... Lettuce!"]
	quest.7134C3CB2BC1FC6A.title: "Lettuce"
	quest.713915E4FBDDBD25.quest_desc: ["You will find a lot of Fluorite Ore above Y-levels 2. You will mostly use it for Magic Compound and Starlight Compound."]
	quest.713915E4FBDDBD25.title: "Fluorite"
	quest.7155AF6791F054D2.quest_desc: [
		"The Torch does not need to be presented. Flammable!!"
		"If you run out of wood, you have to make it out of Stone."
	]
	quest.7155AF6791F054D2.title: "Stone Torch"
	quest.7195AE034EEAE00D.quest_desc: ["Wrap meals are easy to prepare and delicious."]
	quest.7195AE034EEAE00D.title: "Wraps"
	quest.71A4EDBC4AC1E6CE.quest_desc: ["Using the Machine Upgrade Base, craft your first upgrade. The Inferium Machine Upgrade increases processing speed by 1.2×, but it will also consume more fuel."]
	quest.71BAC5A2B66937F4.quest_desc: ["Buy some reward!"]
	quest.71BAC5A2B66937F4.title: "Torch"
	quest.71CB6F07216EE36C.quest_desc: ["The Wyvern Energy Core is the advanced version of a Draconic Core. It is used in higher crafting recipes like all the Wyvern Tools and armor which is your next goal."]
	quest.71CB6F07216EE36C.title: "Wyvern Core!"
	quest.71DB130D8FD31D22.quest_desc: [
		"The Breaker breaks blocks in front of it. It can be oriented in every direction."
		""
		"When right-clicking it with a Redstone Torch in hand, it will change between a mode where it gets deactivated by Redstone and a mode where it responds to pulses."
	]
	quest.7223095162F7C9D8.quest_desc: [
		"To craft an End Steel Ingot, you’ll need a Dark Steel Ingot, an Obsidian Block, and some End Stone."
		"Dark Steel is easy to produce — the real challenge is combining the materials!"
	]
	quest.7223095162F7C9D8.title: "End Steel"
	quest.7249692A4D9F7325.quest_desc: ["The Excavator is useful if you want to dig up Dirt with it."]
	quest.72530D5DC5611A72.quest_desc: ["Large Bunch Of TNTs is not called that by accident. :)"]
	quest.7258E693B337DBBF.quest_desc: ["Iron Essences can be used to craft Iron Ingots."]
	quest.7258E693B337DBBF.title: "Iron"
	quest.725ED43BE9392CF0.quest_desc: ["Dough is used to create various food items, such as Bread."]
	quest.725ED43BE9392CF0.title: "Dough"
	quest.728A059E89B4949C.quest_desc: ["Then get a few Oil Buckets."]
	quest.728A059E89B4949C.title: "Oil Buckets!"
	quest.72AADF01A32733DE.quest_desc: ["Clibano Core is the main component of Clibano Multiblock. Once built, right-clicking with Mundabitur Dust will activate the smelter."]
	quest.72AADF01A32733DE.title: "Clibano #2"
	quest.72BE5231B27D03B6.quest_desc: [
		"To unlock more powerful spells, you'll need a special kind of magical wood."
		"Archwood trees grow naturally in the Overworld — go find one to begin your next step in spellcraft."
	]
	quest.72BE5231B27D03B6.title: "Seeking Magical Wood"
	quest.72C68C9230EAC317.quest_desc: [
		"Vibranium Dust on its own is unstable and unusable. To unlock its true potential, you'll need to process it with Mars Sand, a reactive material found only on the Red Planet."
		"Combine the two in a Advanced Alloy Smelter to create the powerful Vibranium Ingot."
		""
		"&a💡 Hint: This ore can be found only planet Mars."
	]
	quest.72C68C9230EAC317.title: "                     Vibranium                     "
	quest.72CDC89C55BF8D14.quest_desc: ["After harvesting a fully grown plant of Nature Seeds, you get Nature Essences."]
	quest.72CDC89C55BF8D14.title: "Nature Essence"
	quest.72E57904E75F587F.quest_desc: ["The Digital Circuit it is used in compact machine with an industrial control system that comprised several working operations at the same time. "]
	quest.72E57904E75F587F.title: "Digital Circuit"
	quest.72FE98AF258B5669.quest_desc: [
		"Smelt the Solid Silicon Cells in a furnace to obtain cells molten Silicon!"
		""
		"&a💡 Hint: Place it on the ground and pick it up with a Bucket so you can use it anywhere."
	]
	quest.72FE98AF258B5669.title: "Molten Silicon #2"
	quest.72FFA7874C0248A8.quest_desc: ["Collect some Liquid Meat from the Mob Slaughter Factory."]
	quest.7314C14EDBC88056.quest_desc: ["The Vacuumator allow you to put food inside Cans that you can eat in space."]
	quest.7316C6E840E736CC.quest_desc: [
		"The Lantern is a decorative light source that emits bright light, perfect for illuminating your builds and preventing mob spawns. "
		"Crafted with iron nuggets and a torch, it adds a rustic charm to any structure."
	]
	quest.7316C6E840E736CC.title: "Lantern"
	quest.731E1E37F98A5101.quest_desc: [
		"The Industrial Machine Casing is a component used in various advanced recipes. "
		""
		"&aExchange all casings of the Blast Furnace with the new ones to increase heat and power."
		""
		"&aWith Lava in center:"
		"&aIndustrial Machine Casing: 3675Heat"
	]
	quest.731E1E37F98A5101.title: "Industrial Machine Casing"
	quest.73307BA7120D55E3.quest_desc: ["Fill the bowl with Evil Dust!"]
	quest.7347F753CB471E7D.quest_desc: ["After harvesting a fully grown plant of Copper Seeds, you get Copper Essences."]
	quest.7347F753CB471E7D.title: "Copper Essence"
	quest.736B1B489CFDA4B7.quest_desc: [
		"Find Ancient Debris in the Nether and smelt it into Netherite Scrap."
		"Combine four Netherite Scraps and four Gold Ingots in a Foundry to craft a Netherite Ingot."
	]
	quest.736B1B489CFDA4B7.title: "Netherite Ingots"
	quest.737420EBDA89A695.quest_desc: ["Time to craft some Bronze Tools!"]
	quest.737420EBDA89A695.title: "Bronze Age!"
	quest.738C244BBFEE10B6.quest_desc: ["Top-tier farmland with excellent yield. Required for the strongest crops."]
	quest.738D9CEB016ECED2.quest_desc: ["The Spike is a component added by EvilCraft. It can be used to craft various tools, such as the Blood Extractor or Spiked Plates."]
	quest.738D9CEB016ECED2.title: "Spikes!"
	quest.73B2CBC8913F414A.quest_desc: [
		"The Dragon Egg Energy Siphon is an RF/FE generator which uses the energy contained inside the Dragon Egg to produce a constant output of 200RF/FE/t. In order to operate, the dragon egg needs to be placed on top. If it functions the siphon will turn purple."
		""
		"It may not sound very strong but it is an infinite source of energy that needs no fuel and also works day and night..."
	]
	quest.73F19A0EEE00A054.quest_desc: [
		"The Chemical Reactor is used to combine two Fluids (and other assorted items) into a third fluid or item. It has input rate of 128 Energy and an internal buffer of 10,000 Energy."
		""
		"&a💡 Hint: Use a wrench to dismantle this machine!&r"
	]
	quest.73F7FBC2AA10A4EC.quest_desc: ["Fish and chips are simply delicious."]
	quest.73F7FBC2AA10A4EC.title: "Cod n Chips"
	quest.740C898DCFE64886.quest_desc: ["Singularities are highly compressed materials. A singularity requires 2300 items of the same type."]
	quest.74104BC409F512A6.quest_desc: ["Use Ice Essence to craft some Packed Ice."]
	quest.74104BC409F512A6.title: "Packed Ice"
	quest.74171DEC3252655B.quest_desc: [
		"The Infusin Altar is a crafting structure that is usually used to create seed. The structure consists of 1 Infusion Altar and 8 Infusion Pedestals."
		"You need to activate the altar with a Wand."
	]
	quest.74171DEC3252655B.title: "Altar #2"
	quest.741CA10F7E9B3F1C.quest_desc: [
		"Runes can spawn from Bedrock to Y-level 2. That includes near Darkstone!"
		""
		"&a💡 Hint: If you haven't found an iron pickaxe somewhere, you should unlock the Blacksmith's Workshop to craft one."
	]
	quest.741CA10F7E9B3F1C.title: "Runes"
	quest.742F9B2BCED3BB1F.quest_desc: ["There’s no doubt these ingots are of great importance — and now it’s your turn to craft them. Use the Assembler along with all the prepared components to create several The Ultimate Ingots."]
	quest.742F9B2BCED3BB1F.title: "The Ultimate Ingot"
	quest.747CFD864A463118.quest_desc: ["After harvesting a fully grown plant of Zombie Seeds, you get Zombie Essences."]
	quest.747CFD864A463118.title: "Zombie Essence"
	quest.74964ACBEA5E44AD.quest_desc: [
		"Draconium Ore generates only on planet venus. One block of Draconium Ore will drop 1-4 Draconium Dust when mined. This can be increased using Fortune enchantments."
		""
		"It is important that you collect enough Tharsite, otherwise you will not be able to process the dust!"
		""
		""
		"&a💡 Hint: Draconium Ore can be found between layers Y=9 and Y=40"
	]
	quest.74964ACBEA5E44AD.title: "Draconium!"
	quest.74B48FB05730CA2F.quest_desc: ["Use Wood Essence to craft Wood."]
	quest.74B48FB05730CA2F.title: "Wood"
	quest.74BFB3963D92E99C.quest_desc: ["This is the last and best tier of the upgrade kits."]
	quest.74C67B10E77B8FEA.quest_desc: [
		"A 4×3×3 multiblock structure specialized in alloy production. You can view the exact layout and required blocks using the provided blueprints."
		""
		"This machine produces alloys faster and more efficiently."
		""
		"&a💡 Hint: Each operation consumes energy and a fuel. Lava is a valid option, costing 200mb per operation."
	]
	quest.74DE1BD1F0A3407D.quest_desc: ["Olives are a versatile crop added by Pam's HarvestCraft. They can be harvested from Olive Trees and used to craft Olive Oil, a key ingredient in various recipes."]
	quest.74DE1BD1F0A3407D.title: "Olive Trees"
	quest.74E7441F175890F1.quest_desc: [
		"The Artisan relic is the first relic found in some of your village buildings. "
		"When used in the Clibano, it allows you to create Obsidiansteel."
	]
	quest.74F0C562DD86D7E3.quest_desc: [
		"The Active Forge Energy Power Tap is used to extract the energy produced by the reactor in the form of FE."
		"You’ll also need two Reactor Solid Access Ports – one for inserting fuel and another for extracting waste materials."
	]
	quest.74F0C562DD86D7E3.title: "Reactor Output \\& Access Ports"
	quest.75114D655F12450A.quest_desc: [
		"Improves crop yield more than Inferium Farmland."
		"Used to grow higher-tier essence crops."
	]
	quest.7527428828D29C69.quest_desc: ["The Double Crusher works like a regular crusher but processes two items simultaneously, making it twice as efficient."]
	quest.75358638C6A1B2E2.quest_desc: [
		"Process Saltpeter in an Industrial Electrolyzer to get Potassium."
		"Process Clay Dust in the same machine to extract Sodium."
	]
	quest.75358638C6A1B2E2.title: "Sodium and Potassium"
	quest.75A6C08C141F13F0.quest_desc: ["Coke Dust is made by mixing Coal/Charcoal dust with Gravel in a crafting grid."]
	quest.75A6C08C141F13F0.title: "Coke Dust"
	quest.75D5420C9C7B5DDE.title: "Piglin Brute Hunter"
	quest.7620A2626F676A6C.quest_desc: ["Next, you'll need to collect 28 Reinforced Blast Bricks and several Steel Scaffoldings to complete the Arc Furnace structure."]
	quest.7620A2626F676A6C.title: "Reinforced Blast Bricks!"
	quest.7621581A19E4AEBA.quest_desc: [
		"The Engineer’s Workshop is no ordinary crafting table—it’s a powerful workstation."
		""
		"Inspired by the Artisan Worktables mod and brought to life using Custom Machinery."
	]
	quest.7621581A19E4AEBA.quest_subtitle: "Workshop"
	quest.7621581A19E4AEBA.title: "&eEngineer's Workshop"
	quest.7622681F4B78BFD7.quest_desc: [
		"A basic automated turret that targets nearby threats."
		"Reliable, stationary, and always on guard."
	]
	quest.766C52C556DE201C.quest_desc: ["Unobtainium Vibranium Alloy is a very strong high-quality alloy of Vibranium, Allthemodium, Unobtainium and Blazing Dust! "]
	quest.766C52C556DE201C.title: "       Unobtainium Vibranium Alloy       "
	quest.76A8E8117407FD94.quest_desc: ["The Empowerer is a mid-tier block used to upgrade crystals and other items. Place the item to be empowered on the Empowerer, and the required materials on Display Stands exactly two blocks away. Power each stand with energy to begin the process—once enough energy is drained, the item will be empowered."]
	quest.76A8E8117407FD94.quest_subtitle: "Complete Elite Craftingtable Quest"
	quest.76A8E8117407FD94.title: "Empowerer"
	quest.774FCFA19D3F53A9.quest_desc: ["A refined material made by smelting Mixed Metal Ingots. Often used in advanced machines and tools."]
	quest.774FCFA19D3F53A9.title: "Advanced Alloy Ingots"
	quest.776448A88CDC6D4C.quest_desc: [
		"With Draconium finally in your grasp, the secrets of Draconic Evolution are yours to command. This marks your ascent toward Avaritia, the ultimate peak of power."
		""
		"The Infinity Ingot is the heart of this progression, serving as the core component for god-tier artifacts like the Sword of the Cosmos. Prepare yourself the most insane crafts in existence are now within your reach!"
	]
	quest.776448A88CDC6D4C.title: "Infinity Ingot!"
	quest.77785614A747E6EA.quest_desc: ["There are many ways to make salt, but for now the easiest is in the Kitchen Workshop."]
	quest.77785614A747E6EA.title: "Salt"
	quest.77865466BCB9DF32.quest_desc: ["Buy some reward!"]
	quest.77865466BCB9DF32.title: "Mushrooms"
	quest.779008411621FC76.quest_desc: ["Lithium Ore generates deep underground between Y-levels -62 to 4. It’s an important resource for more advanced materials and processing."]
	quest.779008411621FC76.title: "Lithium"
	quest.77AB36E987740D28.quest_desc: ["Time to cook some Hot Dogs!"]
	quest.77AB36E987740D28.title: "Hot Dogs"
	quest.77AD8D3A5D0601CB.quest_desc: ["Placing grass in different positions in the crafting grid gives you different seeds!"]
	quest.77AD8D3A5D0601CB.title: "Tomato Seeds"
	quest.77B533799EBF2499.quest_desc: [
		"The World Breaker is automatically enchanted with Fortune X. "
		""
		"Shift right-clicking with the World Breaker will put it into \"hammer\" mode, and shift right-clicking again will put it back into normal mode. Breaking a block with hammer mode active will destroy all blocks in an 17x17x17 cube."
		"Instead of dropping all of those items, one Matter Cluster will be dropped with all of the items inside of it to avoid lag."
	]
	quest.7840F201C753ADEF.quest_desc: ["Smelt your Sand Coal Compound in the Furnace to obtain a Silicon Boule."]
	quest.7840F201C753ADEF.title: "Obtain materials for Silicon #3"
	quest.78A1ED5093D11E7C.quest_desc: ["Use Zombie Essences to craft Rotten Flesh."]
	quest.78A1ED5093D11E7C.title: "Rotten Flesh"
	quest.78A228A99EC206DD.quest_desc: ["The Wooden Exalted Crafter functions as a portable crafting table with additional storage, allowing you to keep materials handy while crafting on the go."]
	quest.78A7DE44E0731497.quest_desc: ["Use the blueprints to make Flint Parts."]
	quest.78A7DE44E0731497.title: "&7Tools Parts"
	quest.78D97CADE6809630.title: "The Leviathan"
	quest.78FADFE18B8B18C0.quest_desc: ["It doesn't hurt to have a small projectile for your bow..."]
	quest.78FADFE18B8B18C0.title: "Arrows"
	quest.790FA222274D900F.quest_desc: ["Industrial Fertilizer acts like Bone Meal but with slightly stronger effects. It can also be used in specific machines for automated crop growth."]
	quest.790FA222274D900F.title: "Fertilizer"
	quest.7920494B2E2DD7BB.quest_desc: ["Buy some reward!"]
	quest.7920494B2E2DD7BB.title: "Pipes"
	quest.795C7F6B42DFA889.quest_desc: ["The Dissolution Chamber is a versatile machine capable of combining items and fluids to create advanced components, tools, and resources. It processes both solid and liquid inputs simultaneously, following specific recipes. Place the required items in its input slots, supply the correct fluid, and power it with FE to begin crafting."]
	quest.796B4996DDA222AD.quest_desc: ["Craft Prudentium Essence with the help of your Inferium Crystal."]
	quest.796B4996DDA222AD.title: "Prudentium Essence!"
	quest.79908B4F3750EDCB.quest_desc: ["A backpack is great for storage, but what if you could craft items anywhere? With the Crafting Upgrade, you can turn your backpack into a portable crafting table! Simply install the upgrade and access a built-in crafting grid anytime."]
	quest.7995E13CD686F9F7.quest_desc: ["Crystaltine Ingots are primarily used to enhance various production processes. For instance, they can be utilized to mass-produce circuits or microchips in a single operation."]
	quest.7995E13CD686F9F7.title: "Crystaltine Ingots"
	quest.79A64C98083DDF25.quest_desc: ["The Advanced Energy Laser Relay is an upgraded version of the Energy Laser Relay that transfers 10x more energy, but at a higher loss of 8%. "]
	quest.79A77745FA7C0406.quest_desc: ["Vinegar is also an important ingredient."]
	quest.79A77745FA7C0406.title: "Vinegar"
	quest.7A532F1834896ADC.quest_desc: ["Buy some reward!"]
	quest.7A532F1834896ADC.title: "Basic Control Circuits"
	quest.7AA3C32F2659E795.quest_desc: ["Only the most dedicated essence farmer can gather this much power. Collect 64 Insanium Blocks to prove your mastery—and earn a reward worthy of your efforts."]
	quest.7AA3C32F2659E795.quest_subtitle: "&9The Final Shape"
	quest.7AA3C32F2659E795.title: "&dInsanium Block"
	quest.7AD92EE94494BF46.quest_desc: ["Make yourself a Bed so you can spend the night in comfort."]
	quest.7AD92EE94494BF46.title: "Good Night!"
	quest.7AE731850E4EA1EC.quest_desc: ["Silicon Plates are used in a lot of recipes."]
	quest.7AE731850E4EA1EC.title: "Silicon Plates"
	quest.7AFEB6B3D205486E.quest_desc: ["A luxurious dish made with tender beef wrapped in savory pastry. A true delicacy for any feast—rich, filling, and perfect for showing off your cooking skills!"]
	quest.7AFEB6B3D205486E.title: "Beef Wellington"
	quest.7B178808EDA2DD68.quest_desc: ["Craft a few Golem Steel Seeds."]
	quest.7B771424B6B37A9D.quest_desc: ["Collect some a few Cheese."]
	quest.7B771424B6B37A9D.title: "Cheese!"
	quest.7B8C0A78D1B1C400.title: "Shelter!"
	quest.7B8E7A1B975AB6F1.quest_desc: ["Like the basic Bucket, but made of Wood."]
	quest.7B8E7A1B975AB6F1.title: "Edelwood Buckets"
	quest.7BB4E94D7805A853.quest_desc: ["Buy some reward!"]
	quest.7BB4E94D7805A853.title: "Copper Tool"
	quest.7BBE812EBFEDBB38.quest_desc: ["Let's continue with Tin Ore! I'm sure you've come across this ore before."]
	quest.7BBE812EBFEDBB38.title: "Tin"
	quest.7BC093B2A89E2959.quest_desc: ["Just collect some Sulfur Dust."]
	quest.7BC093B2A89E2959.title: "Sulfurs #3"
	quest.7BF9C8A239F1DFA9.quest_desc: [
		"Naquadah is a very valuable and important resource used in many advanced technologies. It also helps simplify the production of the Boosting Mixture!"
		""
		"&a💡 Hint: You can find this ore anywhere on the Moon between Y levels -44 and 56, usually in veins."
	]
	quest.7BF9C8A239F1DFA9.title: "Naquadah Ores!"
	quest.7C16A55117E3E9FB.quest_desc: ["The Drill works like a Pickaxe and a Shovel. It uses Energy per block. It can be charged in an Energizer and upgraded by sneak-right-clicking with it in your hand. The Drill can also be dyed 16 colors."]
	quest.7C16A55117E3E9FB.title: "Drill"
	quest.7C1ADB75D4A1FCA6.quest_desc: [
		"The Wooden Fluid Tank was added by Fluid Tank, used for storing liquids. You can stack these vertically to combine them for larger storage, connect pipes to pump into/from them, or simply right-click them with a bucket or other fluid container in-hand to insert/remove fluid."
		"A little help:"
		"&a1000 mB = 1 B"
	]
	quest.7C1ADB75D4A1FCA6.title: "First Fluid Tank"
	quest.7C202530120A9EB8.quest_desc: ["The Mob Slaughter Factory is a machine added by Industrial Foregoing. It is used to process mobs and animals into Liquid Meat and Pink Slime. The animals killed by this machine will not produce drops or experience. The default working area is 1x3x1 in front of the machine and can be expanded with Range Addons. Mobs killed will produce 5 mb of Liquid meat per HP and 1 mb of Pink Slime per HP (50 mb of Liquid Meat and 10 mb of Pink Slime for Cows and Pigs). "]
	quest.7C202530120A9EB8.title: "          Mob Slaughter Factory          "
	quest.7C2A16BEE92A9216.quest_desc: [
		"The Tier 1 Base Module can be found inside treasure chests within the Moon Dungeon. This module is essential for crafting the Tiny Rocket Model, which you’ll need to travel to Venus."
		""
		"&9Once you’ve secured one and finished your business on the Moon, it’s time to head back to your base."
	]
	quest.7C2B2DDB18045CF3.quest_desc: [
		"Antimony will mostly be used as an alloy, but the Modern Industrialization mod uses this material for its machines."
		""
		"&aHint: Can be found Y-levels -64 to 64."
	]
	quest.7C2B2DDB18045CF3.title: "Antimony Ingots"
	quest.7C41C3E839C015EE.quest_desc: ["The XyCraft Gem is found deep underground and comes in three vibrant colors."]
	quest.7C41C3E839C015EE.title: "Green Xychorium Gems"
	quest.7C454BA4858B3409.quest_desc: ["Buy some reward!"]
	quest.7C454BA4858B3409.title: "Copper Tool"
	quest.7C46CC8A7A783230.quest_desc: ["Put Raw Rice Bread in the Furnace to obtain Rice Bread."]
	quest.7C46CC8A7A783230.title: "Rice Bread"
	quest.7C4A776AF482C6E8.quest_desc: ["Ok, let's go on with... Garlic!"]
	quest.7C4A776AF482C6E8.title: "Garlic"
	quest.7C716BFA687B3D2A.quest_desc: ["Buy some reward!"]
	quest.7C716BFA687B3D2A.title: "Data Storage Cores"
	quest.7C742B01AC0F1DE9.quest_desc: ["The Draconium Ingot is obtained by smelting Draconium Dust and Tharsite Ingot in any kind of alloy smelter."]
	quest.7C742B01AC0F1DE9.title: "Draconium Ingots"
	quest.7C74F02ACE9D22BB.quest_desc: [
		"Inferium Essence is a component added by Mystical Agriculture. It is used to craft the first tier of seeds and higher-tiered Essences. "
		""
		"It can be acquired from harvesting Inferium Plants, mining Inferium Ore, or dropped from mobs."
	]
	quest.7C74F02ACE9D22BB.title: "Inferium"
	quest.7C8C43886F530B18.quest_desc: ["Mossy Cobblestone is an average decorative element and simple to craft."]
	quest.7C8C43886F530B18.title: "Mossy Cobblestone"
	quest.7C93755D871EFAA7.quest_desc: ["After harvesting a fully grown plant of Blaze Seeds, you get Blaze Essences."]
	quest.7C93755D871EFAA7.title: "Blaze Essence"
	quest.7CA4C21D97536FBC.quest_desc: ["Buy some reward!"]
	quest.7CA4C21D97536FBC.title: "&aBoosting Mixture"
	quest.7CA6C686AE82E37C.quest_desc: ["The Distillery will turn various fluids into their lighter parts. That will be very useful for Oil Processing."]
	quest.7CC171467620B32F.quest_desc: ["Put Sandy Glass Dust and Rubber in a Empty Cell to obtain a filled glue compound cell."]
	quest.7CC852DBF71B8AAD.quest_desc: ["The basis of the analogue circuit."]
	quest.7CC852DBF71B8AAD.title: "Analog Circuit Board"
	quest.7CD15496F9BFC525.quest_desc: [
		"Calorite is a resin-like material known for its exceptional heat resistance. Because of this, it naturally generates in the Nether, where extreme temperatures are the norm. Mine it with a Neptunium tier or better to unlock powerful crafting options."
		""
		"&a💡 Hint: Rare ore can be found at Y-levels 4 to 34 to."
	]
	quest.7CD15496F9BFC525.title: "       Calorite Ore       "
	quest.7CD6FAA71121017D.quest_desc: [
		"Fluids are easy to store, but what about gases? The Basic Chemical Tank from Mekanism lets you safely store and transport gases."
		"Craft one."
	]
	quest.7CEC4C32C8610DD4.quest_desc: [
		"This upgrade increases the maximum amount of energy a Tech Reborn Machine can store."
		"Now we’re entering the world of Tech Reborn machinery, which will be incredibly useful in the later stages of the game!"
	]
	quest.7CF105D2B5AE583B.quest_desc: ["Craft a few Nature Seeds."]
	quest.7CFDBE864D62FE0D.quest_desc: ["Craft a Fire Clay."]
	quest.7CFDBE864D62FE0D.title: "Smelter #2"
	quest.7D01596FFC8BDFF2.quest_desc: [
		"The Item Laser Relay is a wireless items transfer device. Within a default range of 15 blocks. "
		""
		"&a💡 Hint: Use a Laser Wrench to link relays easily!"
	]
	quest.7D01596FFC8BDFF2.title: "The Item Laser Relay"
	quest.7D3A6B6E0E0C15D2.quest_desc: [
		"The Rocket is a vehicle added by Stellaris, used to travel to the Moon and Space Stations."
		"It can be filled with 3000 mb of rocket fuel."
		""
		"&a💡 Hint: Chests inside the rocket are optional and provide additional storage. There are also different slots available for various upgrades."
		""
		"&cYou’ll need to bring another Rocket Launch Pad with you for the return trip."
	]
	quest.7D3A6B6E0E0C15D2.quest_subtitle: "&9Unlock: &6&lMain Questline - Tier V."
	quest.7D5DB5C5DABD47AD.quest_desc: ["And now the hardest part..."]
	quest.7D5DB5C5DABD47AD.title: "Infinity Drill #3"
	quest.7D621DF418C6CC2F.quest_desc: ["Cheese is a dairy product derived from milk and delicious."]
	quest.7D621DF418C6CC2F.title: "Cheese"
	quest.7D716482CA1B53FE.quest_desc: ["Wood casings are versatile components with many uses, such as crafting chest upgrades."]
	quest.7DA61EDD39FE1E50.quest_desc: ["This machine casing is one of the components required to build a Stainless Steel Pipe Machine Casing, but it's also used across many multiblock structures."]
	quest.7DA61EDD39FE1E50.title: "Clean Stainless Steel Machines Casing"
	quest.7DC4DEDD78504498.quest_desc: ["The range upgrade increases the range of the turret."]
	quest.7DFB0E9FFF03F788.quest_desc: [
		"The Extraneous Firestarter is a way of using Aura to your benefit: It collects it from the world and powers a furnace without needing any fuel."
		"Just place it on the Furnace."
	]
	quest.7DFBD1E402CDE95D.quest_desc: ["The 1k ME Storage Component is used to create the 1k ME Storage Cell or higher-tiered Storage Components."]
	quest.7E089975A882EECC.quest_desc: [
		"With just a small amount of Aura, this staff summons floating lights to illuminate your path."
		"An elegant and efficient lighting solution, especially useful in dark or underground areas."
	]
	quest.7E26601EB00F521B.quest_desc: ["Buy some reward!"]
	quest.7E26601EB00F521B.title: "Slime Spawn Egg"
	quest.7E3CCD5B8D1C6B22.quest_desc: ["Buy some reward!"]
	quest.7E3CCD5B8D1C6B22.title: "Cod Spawn Egg"
	quest.7E3DCE7FCE6923A8.quest_desc: ["Superium Coal burns for a long time! 12x longer than normal Coal!"]
	quest.7E3DCE7FCE6923A8.title: "Imperium Coal"
	quest.7E4A146555DF4799.quest_desc: [
		"The Tiny Rocket Model allows you to reach planet Venus!"
		""
		"&cYou’ll need to bring another Rocket Launch Pad with you for the return trip."
	]
	quest.7E574C5EA424D481.quest_desc: ["The &eCopper Fine Wire &fis a component used in &eAdvanced Motors&f."]
	quest.7E850CE97F09C3CD.quest_desc: ["Craft a few Refined Obsidian Seeds."]
	quest.7E90032E034D0B8C.quest_desc: ["Buy some reward!"]
	quest.7E90032E034D0B8C.title: "Sandy Coal Compound"
	quest.7EC299912C29B8D4.quest_desc: [
		"The Whirlwind Prism is a mystical component used in crafting White Magic Dust. It channels light and motion, embodying balance and elemental energy."
		""
		"&eAs a reward, you’ll receive a Phantom Spawn Egg — use it wisely."
	]
	quest.7EC299912C29B8D4.title: "Whirlwind Prims"
	quest.7ECB4885E865B64B.quest_desc: ["The Latex Processing Unit is used to create Dry Rubber. It will generate one Dry Rubber from 500 mB of Water, 750 mB of Latex and Energy. Each process will take 5 seconds, consuming 2000 Energy per Dry Rubber."]
	quest.7EE8F8EB9D93D408.quest_desc: ["A step up in fluid storage! The Tin Tank holds up to 64,000mB and can be stacked vertically for even more capacity."]
	quest.7F14E56A4A42B730.quest_desc: ["A simple yet satisfying classic—sweet corn grilled to perfection."]
	quest.7F14E56A4A42B730.title: "Corn on the Cob"
	quest.7F2064323D24D822.quest_desc: ["You're about to dive into more complex and resource-heavy content. This chapter will take time, effort, and smart resource management. Good luck, you're going to need it!"]
	quest.7F2064323D24D822.title: "&eExpand your toolkit!"
	quest.7F383AA57082166A.quest_desc: ["To make Invar you need to combine Iron and Nickel Ingots in Foundry or later in Alloy Smelter and in Advanced Alloy Smelting Factory."]
	quest.7F383AA57082166A.title: "Invar"
	quest.7F38673C728748D9.quest_desc: ["For Blood Magic, first collect some Gold, Iron, Redstone, Lapis Lazuli and Diamonds!"]
	quest.7F38673C728748D9.title: "&eStart the Black Magic!"
	quest.7F51603D045DC1FA.quest_desc: ["Craft a Steel Helmet."]
	quest.7F82585FA06C6466.quest_desc: ["Craft a few Quartz Enriched Iron Seeds."]
	quest.7F86A36C57C53F91.quest_desc: [
		"A mysterious item used as a catalyst in powerful rituals."
		"When placed beside the Offering Table along with the correct item, the Spirit of Calling triggers ancient magic and summons hidden forces."
		"Without it, the ritual remains dormant."
	]
	quest.7F86A36C57C53F91.title: "Spirit of Calling"
	quest.7FBC9E9E6C3C713E.quest_desc: ["Put Iron Grit into the Electrolyzer to get Manganese Dust, an important ingredient for Iridium — because yes, we’re still making it. :)"]
	quest.7FBC9E9E6C3C713E.title: "Manganese Dusts #7"
	quest.7FC7DA4326F7F8BE.quest_desc: ["Craft a Copper Leggings."]
	quest.7FCD021C40ECE5CF.quest_desc: ["Easy Beetroot Soup making."]
	quest.7FCD021C40ECE5CF.title: "Beetroot Soup"
	quest.7FD98C35B5B34EDC.quest_desc: [
		"To make more food, you’ll need a table where you can prepare your delicious meals."
		""
		"Inspired by the Artisan Worktables mod and brought to life using Custom Machinery. "
	]
	quest.7FD98C35B5B34EDC.title: "          &eWelcome in the Kitchen!          "
	quest.7FDBDAF6910C8FFB.quest_desc: ["Buy some reward!"]
	quest.7FDBDAF6910C8FFB.title: "Carrots"
	quest.7FFAF8D3B3306E62.quest_desc: ["The Empowered Canola Seed is used to create Empowered Oil. One Crystallized Canola Seed with four Canola Seeds can be converted to one Empowered Canola Seed in an Empowerer. "]
	quest.7FFAF8D3B3306E62.title: "Empowered Canola Seed"
