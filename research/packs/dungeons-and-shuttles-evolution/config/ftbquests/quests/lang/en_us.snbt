		" "
		"&31 Organic Block can produce between 2000 - 3000 mB Methane Gas."
	]
	quest.61B2EE7761289FA4.title: "Organic Compost"
	quest.61B36DDFA73B140F.quest_desc: ["After harvesting a fully grown plant of Menril Seeds, you get Menril Essences."]
