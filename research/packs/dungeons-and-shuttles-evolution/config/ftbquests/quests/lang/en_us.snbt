	quest.61B8A0F6F64C5DEF.quest_desc: ["This material has mining level Neptunium and allows you to mine new stronger ores!"]
	quest.61C6209D4BC97024.quest_desc: ["Buy some reward!"]
	quest.61C6209D4BC97024.title: "Ender Pearls"
	quest.61E5DBD6D376996C.quest_desc: ["Buy some reward!"]
	quest.61E5DBD6D376996C.title: "Prudentium Apple"
