	quest.62267D15BA0EBC2C.title: "Pulsating Essence"
	quest.622F952A38315EFD.quest_desc: [
		"The Industrial Centrifuge is used to produce Fluids and Dusts from various items."
		""
		"&a💡 Hint: Use a wrench to dismantle this machine!"
	]
	quest.6235BD8540166641.quest_desc: [
		"Craft a Tank Valve. Used mainly for making Gas Tanks, but sometimes used as a component for other machines."
