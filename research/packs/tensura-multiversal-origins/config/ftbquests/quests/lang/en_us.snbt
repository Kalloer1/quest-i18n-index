	quest.6FDFBE5B4CD727A1.quest_desc: [
		""
		""
		"&6[Passive, Toggle]&r &dThought Acceleration&r – &7Increases cognitive and reaction speed.&r"
		""
		"&6[Passive, Toggle]&r &dChant Annulment&r – &7Negates the need to chant mastered spells.&r  "
		""
		"&6[Passive, In-Slot]&r &bStasis Field&r – &aAll projectiles are nullified&r upon contact with the user."
		"{@pagebreak}"
		""
		""
		"&6[Passive, True]&r &5Road to Stagnation&r – All &cnon-ally entities&r within &a10 blocks&r gain &eSlowness IV&r,  "
		"within &a20 blocks&r gain &eSlowness II&r.  "
		"&7With Mastery: Applies &6Paralysis IV&r and &6Paralysis II&r instead."
		""
		"&6[Passive, Toggle]&r &8Cessation&r –  "
		"- &a+50 bonus damage&r on all attacks  "
		"- &9Bypasses resistances&r  "
		"- &7Nulls are treated as resists&r  "
		"- &9Passively regenerates Barrier Points&r"
		""
		"{@pagebreak}"
		""
		""
		"&6[Active, Hold]&r &bInaction&r – While held:  "
		"- &cUser cannot move or attack&r  "
		"- &aBecomes invulnerable&r  "
		"- Costs &b50 MP/sec&r"
		""
		"&6[Active, Press]&r &dTime Manipulation&r – Stop time for &a10 seconds&r (&c400 ticks&r).  "
		"&7Time Stop has no effect on &bSusano’o&r users."
		""
		"&6[Active, Press]&r &dStagnate&r – Cost: &b1000 MP&r  "
		"- &cFreeze all nearby entities (10 blocks)&r  "
		"- &7They cannot move, act, or be harmed&r  "
		"- Sneak-press to cancel early."
		"{@pagebreak}"
		""
		""
		"&6[Active, Press]&r &dStillness of One’s Heart&r – Cost: &b5000 MP&r  "
		"- Instantly &ckill all non-spiritual beings&r in &a25 blocks&r  "
		"- &7Cooldown: &c20 seconds&r  "
		"- With Mastery:  "
		"  - &cKills Spiritual beings&r unless they have resistance  "
		"  - &eSpiritual Resistance: 50% HP damage  "
		"  - &eSpiritual Null: 10% HP damage"
		"{@pagebreak}"
		""
		""
		"&6[Active, Press]&r &cStasis Coat&r – &7While active, all attacks&r:  "
		"- &cPermanently reduce target's Max HP or SHP&r by &a½ the damage dealt&r  "
		"- Cost: &b100 MP&r  "
		"- &7Ends on hit&r"
		""
		"&6[Active, Press]&r &9Multilayer Barrier&r – &7[Requires Learning]&r  "
		"- &aGrants layered protection against high-damage attacks&r"
	]
	quest.6FDFBE5B4CD727A1.quest_subtitle: "- Requires &9500,000 MP&r and &6mastered&r skill &6Stagnator&r and &6Multilayer Barrier"
