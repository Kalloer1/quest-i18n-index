	quest.6B9864EDBEE5531A.quest_desc: [
		"[&4Guild Master&r] &6Fuze&r: \"Welcome, adventurer, to the &4Adventurers Guild!\""
		""
		"\"By joining us, you become part of a noble tradition—defending the realm, exploring the unknown, and protecting the innocent."
		""
