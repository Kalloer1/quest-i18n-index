	quest.7E1EB84F90EAA863.quest_desc: ["&#584655Paldea Series &7is a mid-tier difficulty series in the game, it does unlock the quests for Miraidon, Koraidon, and Pecharunt."]
	quest.7E3D5DECE67ADD5D.quest_desc: [
		"&#C4A15CLandorus&7 is a &6Legendary &#C4A15CGround&7/&#7FD1FFFlying&7-type Pokémon, the &4Incarnation &7of &zAbundance&7 born from &#7C4E24ancient earth &7and &#7FD1FFskies&7 to nourish the land, command &#7FD1FFwinds&7, and &5dominate&7 the battlefield with towering &#7C572Dstrength"
		""
		"{@pagebreak}"
		"&7Spawns in: "
		"&#FF681FSavanna"
		"&#EBCB8BDesert"
		"&eSunflower Plains"
		""
		"&#FFD93DDuring thunderstorm"
	]
	quest.7E3D5DECE67ADD5D.title: "&#C4A15CSky Lord"
	quest.7E542FC4F6E78D87.quest_desc: ["Increase Level Cap: 36"]
	quest.7E93BAFBBB153E41.quest_desc: [
		"Sell Price:"
		"1$ each"
	]
	quest.7F1FC85AF833C716.quest_desc: [
		"&#B3A912Tapu Koko&7 is a &6Legendary &#B3A912Electric&7/&#FF7F89Fairy&7-type Pokémon, the &4Guardian Deity of Melemele&7 born from &#7C4E24ancient lightning&7 to energize the land and shatter the &4battlefield&7 with &#B3A912crackling &7power."
		""
		"{@pagebreak}"
		"&7Spawns in:"
		"&#EBCB8BBeach"
		"&8Stony Ocean"
		"&#1E5631Jungle"
	]
	quest.7F1FC85AF833C716.title: "&#B3A912Lightning Deity"
	quest.7F5F77EF0FB857DD.quest_desc: [
		"&#3AA3FFKeldeo&7 is a &6Legendary &#3AA3FFWater&7/&#BB5914Fighting&7-type Pokémon and the spirited apprentice of the &4Swords of Justice&7, awakened from &#7C4E24ancient currents&7 to prove its &#FFCC34courage&7, &5master &7the &4sacred blade&7, and fight with &#FF5F55unwavering heart &7in battle."
		"{@pagebreak}"
		"&7Spawns in:"
		"&8Mountains"
		"&8Hills"
	]
	quest.7F5F77EF0FB857DD.title: "&#7AC4F0Justice Preserved"
	quest.7F823340B76ECE37.quest_desc: [
		"&6&lHoney Creation Job:"
		"&7- Combee"
		"&7- Vespiqueen"
	]
