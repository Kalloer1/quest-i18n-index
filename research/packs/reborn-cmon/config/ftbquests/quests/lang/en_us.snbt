	quest.7D6E4D608BD2ACFF.title: "&#535051Great Disturbance"
	quest.7D7D18481D3EB5FE.quest_desc: [
		"&l&4MAJOR / IMPORTANT"
		""
		"&#4C566ASome Legendary Hunts will be locked behind quests to ensure late game legendaries and force you to try something new, for RCTmod is a bit difficult. "
		""
		"&#4C566ALegendary Tabs will start unlocking the more you complete the RCT series. If you would not like to do this, you always have Legendary Monuments, and find the structures."
		""
		"{@pagebreak}"
		"&l&#BF616AWhy do Pantheon of Legends when I can find Legendary Monuments?"
		""
		"&#4C566AWell, with the pantheons you may get items from Myths and Legends that you may only obtain through completing quests. You may use these items on raid dens to battle with friends or other players. This allows for up to 6 people to get the legendary in that raid den."
		" "
		"{@pagebreak}"
		"&l&#BF616AWhy not summon it and do it alone?"
		""
		"&#4C566AYou may do that, but in raids all legendaries / mythicals have a &#FDDB961/100 shiny chance&#4C566A. If the host finds it shiny, all other players have it shiny as well."
		""
		""
		"{@pagebreak}"
		"&#BF616ARadical Red &8Series "
		"Unlocks Mew, MewTwo, Moltres, Articuno, Zapdos, Ho-Oh, and Lugia."
		""
		"&#76BA1BHoenn Gym Challenge &8Series "
		"Unlocks Rayquaza, Latios, Latias, Deoxys, and Jirachi."
		""
		"&1Team Aqua &8Series "
		"Unlocks Kyogre."
		""
		"&#5C1010Team Magma &8Series "
		"Unlocks Groudon."
		""
		"&#EAD5FFSinnoh Gym Challenge &8Series "
		"Unlocks Regi Ice, Regi Rock, and Regi Steel."
		""
		"&#FFF0FBUnova Gym Challenge &8Series "
		"Unlocks Genesect, Victini, Meloetta, Thundurus, Tornadus, and Landorus."
	]
	quest.7D969E8011C21B7F.quest_desc: ["Found in archeologist sites from Cobblemon"]
