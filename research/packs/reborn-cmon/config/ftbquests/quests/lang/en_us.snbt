	quest.67CEC6010C85E0DB.quest_desc: ["Max Level Cap"]
	quest.67E8B8DCFC93F832.quest_desc: ["The warehouse is completed. It might not seem like much, but you can't have much of a trade empire without a place to store things. "]
	quest.68A21E2A6F4DFE64.quest_desc: [
		"&7a powerful &#B3A912Electric&7/&#939DD1Flying &6Legendary &7bird, part of the &4Kanto &7trio with &#7598C1Articuno and &#781D11Moltres&7, controlling &#897314lightning&7, living in &#897314thunderclouds&7, and gaining power from &#897314lightning strikes&7."
		""
