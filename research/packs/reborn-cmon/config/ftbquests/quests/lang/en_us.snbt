	quest.119A245FD83848C0.quest_desc: [
		"&#207C1ARayquaza &7is an &#765436ancient&7, immensely &4powerful &r&#1D1F93Dragon&7/&#939DD1Flying&7-type &6Legendary &7Pokémon, acting as the master of the &fWeather Trio&7 and protector of the &3ozone&7 layer"
