	quest.0000000000000A19.quest_desc: ["The only difference between the rods is different durability."]
	quest.0000000000000A1B.quest_desc: ["The only difference between the rods is different durability."]
	quest.0000000000000A1D.quest_desc: ["The only difference between the rods is different durability."]
