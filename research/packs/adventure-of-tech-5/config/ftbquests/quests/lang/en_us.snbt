	quest.1B960C91AD7C7A54.quest_desc: ["&cStack Upgrades&r allow you to expand the stack amount an item can have in the chest!"]
	quest.1C44DEC3F381F307.quest_desc: ["Welcome to the most critical chapter of this pack! This quest line will guide you to &5antimatter&r! Which is needed for endgame items."]
