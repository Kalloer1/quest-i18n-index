	quest.008EDBC2A1A1FD87.quest_desc: [
		"This &zquestline&r is designed to be a &every basic&r guide for &dyou&r, with &9most&r being just &6checklists&r. "
		""
		"The purpose of this &amodpack&r is for &dyou&r to discover the &4mechanics&r &zyourself&r!"
	]
	quest.008EDBC2A1A1FD87.quest_subtitle: "Welcome to Confluence: Otherworld! This is the start of your Terraria journey! For a more terraria-like experience, consider enabling keep inventory."
	quest.008EDBC2A1A1FD87.title: "Welcome to Confluence"
	quest.0097266D4CB1A2D4.quest_subtitle: "A checklist of all the Confluence Biomes"
	quest.00C9495D1E686923.quest_subtitle: "Permanently increases mining and building speed. Transmuted from any fruit."
	quest.00D917E7C912111D.title: "Corrupt Tundra"
	quest.022D804DB2C21A4D.quest_desc: [
		"In the middle of the night on snowy evenings, a terrifying roaring sound comes from the wilderness! Something is out there!"
		""
		"— The Guide"
		"{image:terra_entity:item/egg/guide_spawn_egg width:20 height:20 align:left} "
	]
	quest.022D804DB2C21A4D.title: "Defeat Deerclops"
	quest.023F04170AD9C528.quest_subtitle: "The strongest pre-hardmode sword. Only requires the sword of your world's evil biome."
	quest.023F04170AD9C528.title: "Night's Edge"
	quest.03DE55511F80A7C9.quest_subtitle: "A checklist of all Confluence NPCs"
	quest.05AE1DD0D30506C4.quest_desc: [
		"The &1Alchemy Table&r is found &bwithin&r the &7dungeon&r, used for brewing &apotions&r or you can &3brew&r with a &6brewing stand&r."
		""
		"Note that the &1Alchemy Table&r has a &z33% chance&r to not consume &5potion&r crafting ingredients."
	]
	quest.0601FB844D55528D.quest_desc: [
		"A &aworld&r permanently &echanges&r into &4Hardmode&r after the &cWoF&r/&cHoF&r is defeated for the first time, granting &6players&r new challenges and much more content to &2explore&r."
		""
		"Enabling &4Hardmode&r in a world is &1necessary&r for game &dprogression&r, as several new &#FF4F26bosses&r leading up to the game's final boss only become &7available&r to fight in this world state(&4WIP&r)."
	]
	quest.0601FB844D55528D.quest_subtitle: "“The ancient spirits of light and dark have been released.”"
	quest.080D46077FB51992.quest_desc: ["The more \"&5hammer powe&rr\" the &dhammer&r has the &efaster&r and &6easier&r it will break blocks."]
	quest.0CAABC4806698C18.quest_subtitle: "You've gotta start somewhere."
	quest.0D1493EFF4238D6D.quest_desc: [
		"The more \"&2axe power&r\" the &axe&r has the &efaster&r and &6easier&r it will break blocks."
		""
		"Some can be &1both&r an &aaxe&r and a &3hammer&r!"
	]
	quest.105BE6B8D0514705.quest_desc: [
		"&2Confluence: Otherworld&r is currently in &aactive&r development."
		""
		"[ \"Checkout our \", { \"text\": \"Work-In-Progress Wiki\", \"underlined\": true, \"clickEvent\": { \"action\": \"open_url\", \"value\": \"https://confluenceotherworld.wiki.gg\" } }, \" for gameplay info.\" ]"
	]
	quest.105BE6B8D0514705.quest_subtitle: "Click to read some info."
	quest.105BE6B8D0514705.title: "Welcome!"
	quest.108A2B3796A3CB06.quest_subtitle: "For making arrows."
	quest.13A721906127D17C.title: "Tier 3"
	quest.13ACD2D5AA1F222A.quest_desc: [
		"&9Potions&r are commonly found in &6Chests&r and &#68391DPots&r, purchased from &aNPCs&r, most&9 potions&r can be crafted at a &2Alchemy Table&r or &eBrewing Stand&r."
		""
		"Different &9potions&r require specific &5plants&r found across the world. "
		"Each &5plant&r usually has its own &2biome&r and &3conditions&r to grow."
		""
		"{@pagebreak}"
		""
		"Such as:"
		""
		"&eWaterleaf&r -> Sand block"
		""
		"&3Moonglow&r -> Mud block"
		""
		"&6Blinkroot&r -> Stone block"
		""
		"&4Deathweed&r -> Corruption"
		""
		"&#FF8027Fireblossom&r -> Nether"
	]
	quest.13B10B96DDF0F2D8.title: "The Corruption"
