	quest.42000000001E04AF.quest_desc: [
		"Nether stone compacted for a lighter inventory.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000001E04AF.title: "Compressed Netherrack"
	quest.42000000001E04B0.quest_desc: [
		"End stone compacted, useful once the void needs feeding.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000001E04B0.title: "Compressed End Stone"
	quest.42000000001E04B1.quest_desc: [
		"Deepslate compacted nine to one, still just stone.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000001E04B1.title: "Compressed Deepslate"
	quest.42000000001E04B2.quest_desc: [
		"Smashes a whole stack of compressed blocks apart at once.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000001E04B2.title: "Compressed Hammer"
	quest.42000000001E04B3.quest_desc: [
		"A weaker hammer for breaking compressed blocks.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000001E04B3.title: "Compressed Iron Hammer"
	quest.42000000001E04B4.quest_desc: [
		"A wide sieve, several gravel piles at a time.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000001E04B4.title: "Compressed Sieve (Voidcraft)"
	quest.42000000001E04B5.quest_desc: [
		"Sieves the same as oak, just a different grain.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000001E04B5.title: "Birch Sieve"
	quest.42000000001E04B6.quest_desc: [
		"Ferments the same as any other barrel.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000001E04B6.title: "Birch Barrel"
	quest.42000000001E04B7.quest_desc: [
		"Melts blocks the same as any other crucible.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000001E04B7.title: "Birch Crucible"
	quest.42000000001E04B8.quest_desc: [
		"The Strand's currency; earn it, spend it, never waste it.",
		"How: quest rewards, flint-mesh dirt on a Loomframe, steward caches."
	]
	quest.42000000001E04B8.title: "Frayed Thread Stock"
	quest.42000000001E04B9.quest_desc: [
		"Archive pages and notes.",
		"How: seating a Strand at the Post, or the Seal-carvers' stall at /clowder hub (8 Thread). Right-click to read; they are kept, not spent."
	]
	quest.42000000001E04B9.title: "Codex Pages"
	quest.42000000001E04BA.quest_desc: [
		"Right-click and open Start here. Grave (`): the assignment list. The book does not assign quests.",
		"How: starter kit / dock chest. Right-click the book; Grave (`) is the assignment list."
	]
	quest.42000000001E04BA.title: "Whisker Codex"
	quest.42000000001F04BB.quest_desc: [
		"The paper inside a package, before it's sealed shut.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: gold ingots and planks around an Eye of Ender. First Packaged Auto craft."
	]
	quest.42000000001F04BB.title: "Package Component"
	quest.42000000001F04BC.quest_desc: [
		"A package wrapper built around a stored pattern instead.",
		"How: package component, then Packager / Encoder. Needs an AE2 network for the ME piece."
	]
	quest.42000000001F04BC.title: "ME Package Comp"
	quest.42000000001F04BD.quest_desc: [
		"Seals items into a package for the line to move.",
		"How: package component, then Packager / Encoder. Needs an AE2 network for the ME piece."
	]
	quest.42000000001F04BD.title: "Packager (Packaged)"
	quest.42000000001F04BE.quest_desc: [
		"Adds another packaging slot to a packager.",
		"How: package component, then Packager / Encoder. Needs an AE2 network for the ME piece."
	]
	quest.42000000001F04BE.title: "Packager Ext"
	quest.42000000001F04BF.quest_desc: [
		"Opens a package back into loose items.",
		"How: package component, then Packager / Encoder. Needs an AE2 network for the ME piece."
	]
	quest.42000000001F04BF.title: "Unpackager"
	quest.42000000001F04C0.quest_desc: [
		"Writes a crafting recipe onto a package pattern.",
		"How: package component, then Packager / Encoder. Needs an AE2 network for the ME piece."
	]
	quest.42000000001F04C0.title: "Encoder"
	quest.42000000001F04C1.quest_desc: [
		"Assembles a package by following its encoded recipe.",
		"How: package component, then Packager / Encoder. Needs an AE2 network for the ME piece."
	]
	quest.42000000001F04C1.title: "Crafter"
	quest.42000000001F04C2.quest_desc: [
		"Routes packages toward whichever address matches.",
		"How: Distributor Marker, Packaging Component, two Shulker Shells, four ender pearls and an iron block. Shells: pack recipe, six purpur blocks, two ender pearls and a Binding Knot."
	]
	quest.42000000001F04C2.title: "Distributor"
	quest.42000000001F04C3.quest_desc: [
		"Marks a destination a distributor can route packages to.",
		"How: package component, then Packager / Encoder. Needs an AE2 network for the ME piece."
	]
	quest.42000000001F04C3.title: "Distributor Marker"
	quest.42000000001F04C4.quest_desc: [
		"Feeds finished packages into the line for pickup.",
		"How: package component, then Packager / Encoder. Needs an AE2 network for the ME piece."
	]
	quest.42000000001F04C4.title: "Packaging Provider"
	quest.42000000001F04C5.quest_desc: [
		"Lets a distant crafter request through this block instead.",
		"How: Proxy Marker, Packaging Component, two Shulker Shells, two ender pearls, two crying obsidian and an iron block. Shells: pack recipe, six purpur blocks, two ender pearls and a Binding Knot."
	]
	quest.42000000001F04C5.title: "Crafting Proxy"
	quest.42000000001F04C6.quest_desc: [
		"Stores a batch of package recipes for reuse.",
		"How: package component, then Packager / Encoder. Needs an AE2 network for the ME piece."
	]
	quest.42000000001F04C6.title: "Recipe Holder"
	quest.42000000001F04C7.quest_desc: [
		"Copies one block's settings onto another, saves a lot of clicking.",
		"How: package component, then Packager / Encoder. Needs an AE2 network for the ME piece."
	]
	quest.42000000001F04C7.title: "Settings Cloner"
	quest.42000000001F04C8.quest_desc: [
		"Fills a package with fluid instead of items.",
		"How: package component, then Packager / Encoder. Needs an AE2 network for the ME piece."
	]
	quest.42000000001F04C8.title: "Fluid Package Filler"
	quest.42000000001F04C9.quest_desc: [
		"A sealed bundle of items, ready to move or store.",
		"How: package component, then Packager / Encoder. Needs an AE2 network for the ME piece."
	]
	quest.42000000001F04C9.title: "Package Item"
	quest.42000000001F04CA.quest_desc: [
		"Packs far more into one package than the basic kind.",
		"How: package component, then Packager / Encoder. Needs an AE2 network for the ME piece."
	]
	quest.42000000001F04CA.title: "Volume Package"
	quest.42000000001F04CB.quest_desc: [
		"Marks where a crafting proxy should reach.",
		"How: package component, then Packager / Encoder. Needs an AE2 network for the ME piece."
	]
	quest.42000000001F04CB.title: "Proxy Marker"
	quest.42000000001F04CC.quest_desc: [
		"Links the packaging line to the digital loom.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000001F04CC.title: "AE Interface"
	quest.42000000001F04CD.quest_desc: [
		"Supplies crafting patterns to the packaging line.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000001F04CD.title: "Pattern Provider (Packaged)"
	quest.42000000001F04CE.quest_desc: [
		"Crafts items for the digital loom's own patterns.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000001F04CE.title: "Molecular Assembler (Packaged)"
	quest.42000000001F04CF.quest_desc: [
		"A digital loom network first, or none of this packaging runs.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000001F04CF.title: "ME Controller"
	quest.42000000001F04D0.quest_desc: [
		"Wire power or signals.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000001F04D0.title: "Fluix Cable (Packaged)"
	quest.42000000001F04D1.quest_desc: [
		"Packs Create-side items the mechanical way.",
		"How: Create craft in JEI (crafting table, press, mixer or deployer). Andesite alloy and a water wheel start the line."
	]
	quest.42000000001F04D1.title: "Create Packager"
	quest.42000000001F04D2.quest_desc: [
		"Gathers split packages back into whole orders.",
		"How: Create craft in JEI (crafting table, press, mixer or deployer). Andesite alloy and a water wheel start the line."
	]
	quest.42000000001F04D2.title: "Create Repackager"
	quest.42000000001F04D3.quest_desc: [
		"Requests packaged items from a linked stock network.",
		"How: Create craft in JEI (crafting table, press, mixer or deployer). Andesite alloy and a water wheel start the line."
	]
	quest.42000000001F04D3.title: "Stock Ticker (Packaged)"
	quest.42000000001F04D4.quest_desc: [
		"A bulk buffer chest for packages waiting their turn.",
		"How: Create craft in JEI (crafting table, press, mixer or deployer). Andesite alloy and a water wheel start the line."
	]
	quest.42000000001F04D4.title: "Item Vault (Packaged)"
	quest.42000000002004D5.quest_desc: [
		"A basic quantum storage disk for the QIO network.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004D5.title: "QIO Drive Base"
	quest.42000000002004D6.quest_desc: [
		"Packs far more storage onto one quantum disk.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004D6.title: "QIO Hyper Dense"
	quest.42000000002004D7.quest_desc: [
		"A quantum disk that trades size for raw density.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004D7.title: "QIO Time Dilating"
	quest.42000000002004D8.quest_desc: [
		"The largest quantum disk Mekanism makes.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004D8.title: "QIO Supermassive"
	quest.42000000002004D9.quest_desc: [
		"Holds several quantum disks in one housing.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004D9.title: "QIO Drive Array"
	quest.42000000002004DA.quest_desc: [
		"Browse everything the QIO network is storing.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004DA.title: "QIO Dashboard"
	quest.42000000002004DB.quest_desc: [
		"Carries the QIO dashboard in your pocket.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004DB.title: "Portable QIO"
	quest.42000000002004DC.quest_desc: [
		"The basic shell for most advanced Mekanism machines.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004DC.title: "Steel Casing (QIO)"
	quest.42000000002004DD.quest_desc: [
		"Stores an enormous amount of power in one block.",
		"Rare reward: one shared Clowder life, once for the entire team. Only six such rewards exist in the campaign.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004DD.title: "Ultimate Cube"
	quest.42000000002004DE.quest_desc: [
		"Holds a huge stack of one single item.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004DE.title: "Ultimate Bin"
	quest.42000000002004DF.quest_desc: [
		"Smelts several stacks at once, as fast as Mekanism gets.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004DF.title: "Ult Smelt Factory"
	quest.42000000002004E0.quest_desc: [
		"Enriches ore at the fastest speed Mekanism offers.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004E0.title: "Ult Enrich Factory"
	quest.42000000002004E1.quest_desc: [
		"Crushes ore at the fastest speed Mekanism offers.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004E1.title: "Ult Crush Factory"
	quest.42000000002004E2.quest_desc: [
		"Mines out a chunk automatically, straight into the void.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004E2.title: "Digital Miner (QIO)"
	quest.42000000002004E3.quest_desc: [
		"A modular tool that swaps its own working head.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004E3.title: "Atomic Disassembler (QIO)"
	quest.42000000002004E4.quest_desc: [
		"Rotates faces and copies settings between Mekanism machines.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004E4.title: "Configurator (QIO)"
	quest.42000000002004E5.quest_desc: [
		"Jumps you instantly between two linked pads.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004E5.title: "Teleporter (QIO)"
	quest.42000000002004E6.quest_desc: [
		"Frames the portal a teleporter opens.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004E6.title: "Teleporter Frame"
	quest.42000000002004E7.quest_desc: [
		"Shell for the reactor that produces antimatter.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004E7.title: "SPS Casing"
	quest.42000000002004E8.quest_desc: [
		"Feeds chemicals in and pulls antimatter out of the reactor.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004E8.title: "SPS Port"
	quest.42000000002004E9.quest_desc: [
		"Speeds up an antimatter reactor's output.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004E9.title: "Supercharged Coil"
	quest.42000000002004EA.quest_desc: [
		"Spins isotopes apart for late-game chemistry.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004EA.title: "Isotopic Centrifuge"
	quest.42000000002004EB.quest_desc: [
		"Dissolves ore into a chemical slurry.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004EB.title: "Chem Dissolution"
	quest.42000000002004EC.quest_desc: [
		"Washes slurry clean before it's crystallized.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004EC.title: "Chem Washer"
	quest.42000000002004ED.quest_desc: [
		"Turns a chemical back into a solid crystal.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004ED.title: "Chem Crystallizer"
	quest.42000000002004EE.quest_desc: [
		"Bombards material with sunlight-driven neutrons.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004EE.title: "Solar Neutron"
	quest.42000000002004EF.quest_desc: [
		"Turns power directly into heat for a boiler.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004EF.title: "Resistive Heater"
	quest.42000000002004F0.quest_desc: [
		"Burns wood for heat instead of power.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004F0.title: "Fuelwood Heater"
	quest.42000000002004F1.quest_desc: [
		"Late-game synthesis of otherwise impossible materials.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004F1.title: "Antiprotonic"
	quest.42000000002004F2.quest_desc: [
		"One modular tool for mining, digging, and more.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004F2.title: "Meka Tool"
	quest.42000000002004F3.quest_desc: [
		"Suit armor for the head, upgraded module by module.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004F3.title: "Meka Helmet"
	quest.42000000002004F4.quest_desc: [
		"Suit armor for the chest, upgraded module by module.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004F4.title: "Meka Body"
	quest.42000000002004F5.quest_desc: [
		"Suit armor for the legs, upgraded module by module.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004F5.title: "Meka Pants"
	quest.42000000002004F6.quest_desc: [
		"Suit armor for the feet, upgraded module by module.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004F6.title: "Meka Boots"
	quest.42000000002004F7.quest_desc: [
		"Shell for a steam boiler.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004F7.title: "Boiler Casing"
	quest.42000000002004F8.quest_desc: [
		"Stores a large amount of power.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004F8.title: "Elite Energy Cube"
	quest.42000000002004F9.quest_desc: [
		"Stores a moderate amount of power.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004F9.title: "Adv Energy Cube"
	quest.42000000002004FA.quest_desc: [
		"Stores a small amount of power, good for starting out.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004FA.title: "Basic Energy Cube (QIO)"
	quest.42000000002004FB.quest_desc: [
		"Infuses metal with a chemical for new alloys.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004FB.title: "Metallurgic Infuser (QIO)"
	quest.42000000002004FC.quest_desc: [
		"Doubles the output of raw ore before it's smelted.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004FC.title: "Enrichment Chamber (QIO)"
	quest.42000000002004FD.quest_desc: [
		"Mill or crush bulk materials.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004FD.title: "Crusher (QIO)"
	quest.42000000002004FE.quest_desc: [
		"Smelts faster than a furnace, on power instead of fuel.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004FE.title: "Energized Smelter (QIO)"
	quest.42000000002004FF.quest_desc: [
		"Cuts wood with Mekanism's own precision blade.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000002004FF.title: "Precision Sawmill"
	quest.4200000000200500.quest_desc: [
		"Splits water into its two component gases.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.4200000000200500.title: "Electrolytic Sep"
	quest.4200000000200501.quest_desc: [
		"Combines two chemicals into a new one.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.4200000000200501.title: "Chemical Infuser"
	quest.4200000000200502.quest_desc: [
		"Purify fluids or ores.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.4200000000200502.title: "Purification"
	quest.4200000000200503.quest_desc: [
		"Injects a chemical into ore for extra yield.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.4200000000200503.title: "Chem Injection"
	quest.4200000000200504.quest_desc: [
		"Compresses osmium onto items for tougher gear.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.4200000000200504.title: "Osmium Compressor (QIO)"
	quest.4200000000200505.quest_desc: [
		"Combines several components into one finished piece.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.4200000000200505.title: "Combiner"
	quest.4200000000210506.quest_desc: [
		"Zombies drop it whether you want it or not.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: kill zombies on the pad at night, or a dark hole."
	]
	quest.4200000000210506.title: "Rotten Flesh Stock"
	quest.4200000000210507.quest_desc: [
		"Skeletons leave these behind; grind them for meal later.",
		"How: skeletons at night, or /clowder hub Pad-keepers (16 Thread for 8)."
	]
	quest.4200000000210507.title: "Bone Stock"
	quest.4200000000210508.quest_desc: [
		"Creepers pay this out, sometimes explosively.",
		"How: sieve dust or soul sand, or creepers on the pad at night. Keep edges lit after you have some."
	]
	quest.4200000000210508.title: "Gunpowder Stock"
	quest.4200000000210509.quest_desc: [
		"Spiders drop it, and a sieve never will.",
		"How: unravel Frayed Thread (1 → 3). Spiders. Loom Lint at an Echo Bind. Yarn reverse sink."
	]
	quest.4200000000210509.title: "String Stock"
	quest.420000000021050A.quest_desc: [
		"Brews poison and feeds a few odd recipes.",
		"How: spiders on the pad at night."
	]
	quest.420000000021050A.title: "Spider Eye Stock"
	quest.420000000021050B.quest_desc: [
		"Endermen drop these; a farm beats begging the void for them.",
		"How: endermen, or /clowder hub Edge-walkers' stall."
	]
	quest.420000000021050B.title: "Ender Pearl Farm"
	quest.420000000021050C.quest_desc: [
		"Fuel for brewing stands and blaze burners alike.",
		"How: Nether fortress after Claw obsidian. Brewing wants a rod; Ars and Occultism do not wait on it."
	]
	quest.420000000021050C.title: "Blaze Rod Farm"
	quest.420000000021050D.quest_desc: [
		"A rare drop, key for regeneration potions.",
		"How: Nether ghasts after Claw obsidian."
	]
	quest.420000000021050D.title: "Ghast Tear Farm"
	quest.420000000021050E.quest_desc: [
		"Brews fire resistance and feeds a few crafts.",
		"How: a slime ball dropped into a lava barrel, slime plus blaze powder, or magma cubes."
	]
	quest.420000000021050E.title: "Magma Cream Farm"
	quest.420000000021050F.quest_desc: [
		"Sticky enough for pistons, slime blocks, and leads.",
		"How: two dirt + wheat seeds + bone meal (pad compost), or /clowder hub Pad-keepers."
	]
	quest.420000000021050F.title: "Slimeball Farm"
	quest.4200000000210510.quest_desc: [
		"Three of these summon a boss worth fighting for.",
		"How: Nether fortress after Claw obsidian. Three skulls start a Wither."
	]
	quest.4200000000210510.title: "Wither Skull"
	quest.4200000000210511.quest_desc: [
		"The wither's own tax, rare and heavy with power.",
		"How: Wither (three skulls on soul sand), or the Drumhearts' stall at /clowder hub once, for 12 Thread Bolts (972 Thread). Optional trophy — it does not gate End or Mob Farm 100%."
	]
	quest.4200000000210511.title: "Nether Star"
	quest.4200000000210512.quest_desc: [
		"Crafts a shulker box, storage that survives death.",
		"Optional — no shulkers here, so the pack crafts shells instead.",
		"How: pack recipe, six purpur blocks, two ender pearls and a Binding Knot. Shulkers never spawn here. Optional."
	]
	quest.4200000000210512.title: "Shulker Shell Farm"
	quest.4200000000210513.quest_desc: [
		"Repairs elytra when nothing else will.",
		"How: skip sleep three nights, then kill phantoms. Optional."
	]
	quest.4200000000210513.title: "Phantom Membrane"
	quest.4200000000210514.quest_desc: [
		"Squid ink, useful for dye and old-fashioned writing.",
		"How: charcoal plus a glass bottle. Squid never spawn here."
	]
	quest.4200000000210514.title: "Ink Sac Farm"
	quest.4200000000210515.quest_desc: [
		"Makes signs and item frames glow in the dark.",
		"How: glow squid never spawn on the pad. Optional."
	]
	quest.4200000000210515.title: "Glow Ink"
	quest.4200000000210516.quest_desc: [
		"Guardians drop it for prismarine blocks and lanterns.",
		"How: ocean monuments are gone. Optional unless you grow a prismarine seed."
	]
	quest.4200000000210516.title: "Prismarine Shard"
	quest.4200000000210517.quest_desc: [
		"Guardian drop that lights the sea and fuels a few crafts.",
		"How: ocean monuments are gone. Optional."
	]
	quest.4200000000210517.title: "Prismarine Crystal"
	quest.4200000000210518.quest_desc: [
		"Rings a conduit; gather eight to finish the frame.",
		"Optional — the void may never offer one.",
		"How: ocean-only. Optional."
	]
	quest.4200000000210518.title: "Nautilus Shell (Hunt)"
	quest.4200000000210519.quest_desc: [
		"Cheats death once, then it's gone.",
		"How: quest rewards only. Seat Clock and Seat Sigil give one each, and the late Strand Knot gifts offer more. Raids and evokers never come to the pad. Optional."
	]
	quest.4200000000210519.title: "Totem (Hunt)"
	quest.420000000021051A.quest_desc: [
		"Golems shed iron while they stand guard.",
		"How: smelt raw iron / iron grit (furnace or Ember Kiln). Sieve gravel for chunks."
	]
	quest.420000000021051A.title: "Iron Golem Gift"
	quest.420000000021051B.quest_desc: [
		"Throws snowballs; useful ammunition, not much of a fighter.",
		"How: one ice (kit / ice gen) shapeless into four snowballs."
	]
	quest.420000000021051B.title: "Snow Golem"
	quest.420000000021051C.quest_desc: [
		"Skeletons keep the pad stocked with ammunition.",
		"How: flint, stick, feather. Skeletons drop extras."
	]
	quest.420000000021051C.title: "Arrow Farm"
	quest.420000000021051D.quest_desc: [
		"Marks whatever it hits with a temporary glow.",
		"How: glowstone dust around an arrow."
	]
	quest.420000000021051D.title: "Spectral Arrow"
	quest.420000000021051E.quest_desc: [
		"Mount when you find a saddle.",
		"Optional — the Pad-keepers in Clowder Hall sell one.",
		"How: trade a block of diamond to the Pad-keepers at their shop in Clowder Hall (/clowder hub). Chocobo Saddle is a different item."
	]
	quest.420000000021051E.title: "Saddle (Hunt)"
	quest.420000000021051F.quest_desc: [
		"Names a mob so it never despawns.",
		"Optional — the Seal-carvers in Clowder Hall sell one.",
		"How: fishing / rare chests, or the Seal-carvers' stall at /clowder hub (24 Thread). Optional."
	]
	quest.420000000021051F.title: "Name Tag Farm"
	quest.4200000000210520.quest_desc: [
		"Tether a link or cable.",
		"How: four string around a slime ball. Slime is pad compost (dirt, seeds, bone meal)."
	]
	quest.4200000000210520.title: "Lead (Hunt)"
	quest.4200000000210521.quest_desc: [
		"Chickens lay them faster than you can collect.",
		"How: wheat seeds to chickens on the pad, or a Mob Farm chapter coop."
	]
	quest.4200000000210521.title: "Egg Stock"
	quest.4200000000210522.quest_desc: [
		"Leather and beef stock.",
		"How: smelt or campfire rotten flesh. Sieve dirt with flint mesh. /clowder hub Pad-keepers sell two for 18 Thread."
	]
	quest.4200000000210522.title: "Leather Stock"
	quest.4200000000210523.quest_desc: [
		"Sheep grow it back after a trim.",
		"How: shear sheep after grass, or four string."
	]
	quest.4200000000210523.title: "Wool Stock"
	quest.4200000000210524.quest_desc: [
		"Food stock for the kitchen.",
		"How: wheat to cows on the pad."
	]
	quest.4200000000210524.title: "Beef Stock"
	quest.4200000000210525.quest_desc: [
		"Pigs provide it, cook it before eating.",
		"How: potatoes or carrots to pigs on the pad."
	]
	quest.4200000000210525.title: "Pork Stock"
	quest.4200000000210526.quest_desc: [
		"Chicken for meals and feathers.",
		"How: seeds to chickens on the pad."
	]
	quest.4200000000210526.title: "Chicken Stock"
	quest.4200000000210527.quest_desc: [
		"Sheep meat, better roasted than raw.",
		"How: wheat to sheep on the pad."
	]
	quest.4200000000210527.title: "Mutton Stock"
	quest.4200000000210528.quest_desc: [
		"Brews a potion of luck, if you can spare one.",
		"Optional — the void may never offer one.",
		"How: rabbits do not spawn on the pad. Optional."
	]
	quest.4200000000210528.title: "Rabbit Foot"
	quest.4200000000210529.quest_desc: [
		"A showpiece worth setting beside a dragon egg.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000210529.title: "Zombie Head"
	quest.420000000021052A.quest_desc: [
		"Pairs nicely with a dragon egg on a shelf.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.420000000021052A.title: "Skeleton Skull"
	quest.420000000021052B.quest_desc: [
		"Another head for the trophy shelf by the egg.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.420000000021052B.title: "Creeper Head"
	quest.420000000021052C.quest_desc: [
		"One more head, at home near a dragon egg.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.420000000021052C.title: "Piglin Head"
	quest.420000000021052D.quest_desc: [
		"The rarest head, earned only after the fight is over.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.420000000021052D.title: "Dragon Head"
	quest.420000000021052E.quest_desc: [
		"Only if a player happens to drop one.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.420000000021052E.title: "Player Head"
	quest.420000000022052F.quest_desc: [
		"First craft yields 2 — keep one for Codex later.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: one bone, string, amethyst. /clowder hub Pad-keepers sell bones. Spark / Hum gate."
	]
	quest.420000000022052F.title: "Bone Chime"
	quest.4200000000220530.quest_desc: [
		"Shard of old tribe song — needs a Chime.",
		"How: Bone Chime, amethyst and redstone, shapeless. Yields two."
	]
	quest.4200000000220530.title: "Spirit Shard"
	quest.4200000000220531.quest_desc: [
		"Tune metal to spirit — copper around a Chime.",
		"How: copper around a Bone Chime. Yields two."
	]
	quest.4200000000220531.title: "Copper Resonator"
	quest.4200000000220532.quest_desc: [
		"Mark the lattice lines — chalk needs a Shard.",
		"How: two bone meal, lapis and a Spirit Shard, shapeless. Yields four."
	]
	quest.4200000000220532.title: "Ritual Chalk (Tribal)"
	quest.4200000000220533.quest_desc: [
		"Place the heart — two Bone Chimes, a Spirit Shard, two leather and four planks (the Pad-keepers sell leather).",
		"How: two Bone Chimes, a Spirit Shard, two leather and four planks. Strike empty-handed on tempo (17–23 ticks) for 24 Pulse."
	]
	quest.4200000000220533.title: "Drumheart Beat"
	quest.4200000000220534.quest_desc: [
		"Nine tribes hummed once — needs a spare Chime + Shard.",
		"How: craft or Spark/Tribal Weave reward. Right-click: how the lattice works."
	]
	quest.4200000000220534.title: "Spirit Codex"
	quest.4200000000220535.quest_desc: [
		"Draw ley into beats.",
		"How: place under sky near water/green. Slow Pulse. Spark ladder."
	]
	quest.4200000000220535.title: "Ley Collector"
	quest.4200000000220536.quest_desc: [
		"Carry Pulse for tools, spells and travel. Fill it at a Drumheart.",
		"How: craft, then fill from a Drumheart (click with the cell). Tools, spells and travel draw from the cell."
	]
	quest.4200000000220536.title: "Pulse Cell"
	quest.4200000000220537.quest_desc: [
		"Seat an Echo catalyst, which wears down as it works; add two different totem voices within eight blocks. More voices strengthen the song. Redstone pauses it.",
		"How: seat an Echo catalyst, two different totems within 8. Redstone pauses it."
	]
	quest.4200000000220537.title: "Pulse Resonator"
	quest.4200000000220538.quest_desc: [
		"Tribe of stone answers.",
		"How: a Bone Chime, two logs, dirt and a Copper Resonator."
	]
	quest.4200000000220538.title: "Earth Totem"
	quest.4200000000220539.quest_desc: [
		"Tribe of flame answers.",
		"How: a Bone Chime, two logs, charcoal and a Copper Resonator."
	]
	quest.4200000000220539.title: "Fire Totem"
	quest.420000000022053A.quest_desc: [
		"Tribe of tide answers.",
		"How: a Bone Chime, two logs, a water bucket (or porcelain water bucket) and a Copper Resonator."
	]
	quest.420000000022053A.title: "Water Totem"
	quest.420000000022053B.quest_desc: [
		"Tribe of wind answers.",
		"How: a Bone Chime, two logs, a feather and a Copper Resonator."
	]
	quest.420000000022053B.title: "Air Totem"
	quest.420000000022053C.quest_desc: [
		"Fifth tribe — steward core.",
		"How: a Bone Chime, two logs, a Spirit Shard and a Copper Resonator."
	]
	quest.420000000022053C.title: "Spirit Totem"
	quest.420000000022053D.quest_desc: [
		"Start the lattice song. It waits for stone or an Echo-stage item; raw metal is grit on Echo Shatter.",
		"How: Spirit Codex + Tribal Weave. Seat stone or an Echo-stage item. Raw metal belongs on Echo Shatter."
	]
	quest.420000000022053D.title: "Song Bench"
	quest.420000000022053E.quest_desc: [
		"Route harmonics between totems.",
		"How: four Copper Resonators around redstone. Makes four."
	]
	quest.420000000022053E.title: "Lattice Conductor"
	quest.420000000022053F.quest_desc: [
		"Hum stage one — break the ore. Stone becomes shards; cobble becomes gravel; raw metal becomes grit. Grit shatter is 4 seconds at 40 Pulse/s.",
		"How: stone + Bone Chime + Copper Resonator. Earth totem within 8. Stone → shards; cobble → gravel; raw metal → grit. Four seconds at 40 Pulse/s."
	]
	quest.420000000022053F.title: "Echo Shatter"
	quest.4200000000220540.quest_desc: [
		"Shard that heard the shatter.",
		"How: Echo Shatter stone (not cobble). Font stone tier, or silk-touched stone."
	]
	quest.4200000000220540.title: "Echo Shard (Tribal)"
	quest.4200000000220541.quest_desc: [
		"Hum stage two — attune.",
		"How: seven stone, a Spirit Shard and a Copper Resonator."
	]
	quest.4200000000220541.title: "Echo Attune"
	quest.4200000000220542.quest_desc: [
		"Echo that found a key.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220542.title: "Attuned Echo"
	quest.4200000000220543.quest_desc: [
		"Bind stage — knot spirit to metal.",
		"How: seven stone, an amethyst shard and a Copper Resonator."
	]
	quest.4200000000220543.title: "Echo Bind"
	quest.4200000000220544.quest_desc: [
		"Echo that will not slip.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220544.title: "Bound Echo"
	quest.4200000000220545.quest_desc: [
		"Reweave stage — call the ingot.",
		"How: five stone, a gold ingot, two Copper Resonators and a Spirit Shard."
	]
	quest.4200000000220545.title: "Echo Manifest"
	quest.4200000000220546.quest_desc: [
		"Metal willed into being by Spirit Pulse instead of a furnace.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220546.title: "Manifested Ingot"
	quest.4200000000220547.quest_desc: [
		"Keep what the tribes left.",
		"How: seven planks, a chest and a Bone Chime."
	]
	quest.4200000000220547.title: "Ancestral Cache"
	quest.4200000000220548.quest_desc: [
		"Vault linked toward The March.",
		"How: an Ancestral Cache, four iron ingots, a Spirit Shard, two Copper Resonators and a Pulse Cell."
	]
	quest.4200000000220548.title: "Deep Cache"
	quest.4200000000220549.quest_desc: [
		"An unwritten seal, waiting for a rite to fill it.",
		"How: seven paper, a Spirit Shard and a Bone Chime. Makes two."
	]
	quest.4200000000220549.title: "Blank Seal"
	quest.420000000022054A.quest_desc: [
		"Seal of the stone tribe.",
		"How: a Blank Seal and dirt, shapeless."
	]
	quest.420000000022054A.title: "Earth Seal"
	quest.420000000022054B.quest_desc: [
		"Seal of the flame tribe.",
		"How: a Blank Seal and charcoal, shapeless."
	]
	quest.420000000022054B.title: "Fire Seal"
	quest.420000000022054C.quest_desc: [
		"Seal of the tide tribe.",
		"How: a Blank Seal and a water bucket (or porcelain water bucket), shapeless."
	]
	quest.420000000022054C.title: "Water Seal"
	quest.420000000022054D.quest_desc: [
		"Seal of the wind tribe.",
		"How: a Blank Seal and a feather, shapeless."
	]
	quest.420000000022054D.title: "Air Seal"
	quest.420000000022054E.quest_desc: [
		"Seal of the steward tribe.",
		"How: a Blank Seal and a Spirit Shard, shapeless."
	]
	quest.420000000022054E.title: "Spirit Seal"
	quest.420000000022054F.quest_desc: [
		"Offer seals. Ask the Loom.",
		"How: five stone, an amethyst shard and a Bone Chime."
	]
	quest.420000000022054F.title: "Rite Pedestal"
	quest.4200000000220550.quest_desc: [
		"Use it empty-handed and play the Gate Rite: hit the falling beats on A, S, D, F. Land 60% and it opens; no Pulse needed.",
		"How: use the Gate Drum empty-handed and play the Gate Rite: hit the falling beats on A, S, D, F. Land 60% and it opens; no Pulse needed. Bind a return compass first."
	]
	quest.4200000000220550.title: "Gate Drum (Tribal)"
	quest.4200000000220551.quest_desc: [
		"Dress your camp's threshold with a carved spirit frame. Compasses and the Gate Drum perform travel.",
		"How: four iron ingots, two Spirit Shards, two Copper Resonators and an amethyst shard."
	]
	quest.4200000000220551.title: "Spirit Door"
	quest.4200000000220552.quest_desc: [
		"Tool that spends Pulse.",
		"How: three Manifested Ingots, a Bone Chime and a stick."
	]
	quest.4200000000220552.title: "Spiritgear Pick"
	quest.4200000000220553.quest_desc: [
		"Edge that spends Pulse.",
		"How: two Manifested Ingots, a Bone Chime and a stick."
	]
	quest.4200000000220553.title: "Spiritgear Blade"
	quest.4200000000220554.quest_desc: [
		"Stone from the March, underfoot in a place that shouldn't exist.",
		"How: smelt March Cobble. Mine it in the March, through a Gate Drum."
	]
	quest.4200000000220554.title: "March Stone (Tribal)"
	quest.4200000000220555.quest_desc: [
		"Rubble from the March, plain but plentiful.",
		"How: mine March stone in the March, through a Gate Drum."
	]
	quest.4200000000220555.title: "March Cobble"
	quest.4200000000220556.quest_desc: [
		"Wood grown somewhere the sun doesn't reach.",
		"How: cut March trees, through a Gate Drum."
	]
	quest.4200000000220556.title: "March Log"
	quest.4200000000220557.quest_desc: [
		"Sawn timber from the March, sturdy despite where it came from.",
		"How: one March Log makes four planks."
	]
	quest.4200000000220557.title: "March Planks"
	quest.4200000000220558.quest_desc: [
		"Leaves that murmur even without any wind.",
		"How: March trees, through a Gate Drum. Shears or Silk Touch keep the leaves."
	]
	quest.4200000000220558.title: "March Leaf"
	quest.4200000000220559.quest_desc: [
		"A reed that hums with leftover Spirit Pulse.",
		"How: grows wild in the March, sits in reed-weir chests, and a Rootbinder Elder trades it."
	]
	quest.4200000000220559.title: "Spirit Reed (Tribal)"
	quest.420000000022055A.quest_desc: [
		"Feed raw iron into Echo Shatter beside an Earth Totem. Two grits emerge; smelt or blast them into ingots. Other mods can supply tagged raw metals.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.420000000022055A.title: "Ore remembers twice"
	quest.420000000022055B.quest_desc: [
		"Water binds wool into Spiritweave. Feed the station above or from its sides and draw finished work out below.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.420000000022055B.title: "Cloth with a voice"
	quest.420000000022055C.quest_desc: [
		"Manifest a Manifested Ingot again under Spirit. The Resonant Core opens stronger equipment and distant paths.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.420000000022055C.title: "The living heart"
	quest.420000000022055D.quest_desc: [
		"Carry 4,800 Pulse in one Greater Cell, or 19,200 in a Grand. Charge it at a Drumheart or Resonator before setting out.",
		"How: a Pulse Cell, two Resonant Cores and two Manifested Ingots."
	]
	quest.420000000022055D.title: "A longer song"
	quest.420000000022055E.quest_desc: [
		"Sixteen buckets in one cistern. Buckets and fluid pipes both work. A comparator reads fullness; redstone locks filling and draining. Break it and the fluid stays on the dropped block. Sky Stone Tanks dump.",
		"How: craft, fill with a bucket or pipe, pick it up — fluid stays. AE2 Sky Stone Tanks empty when broken."
	]
	quest.420000000022055E.title: "Rain held in copper"
	quest.420000000022055F.quest_desc: [
		"Mark a machine face with the tuner, then use it on a relay plate. Use it on another machine to replace the mark. Do not mark the plate.",
		"How: a Spirit Shard over two Copper Resonators."
	]
	quest.420000000022055F.title: "Name the far end"
	quest.4200000000220560.quest_desc: [
		"Snap the plate onto a chest or machine face. Pair two plates with the same unique Bond item, or tuner-bind a destination. Local cargo reaches 32 blocks, 16 items a second for 8 Pulse. Redstone pauses it. Since 5.0 the plate wants a kept Air Resonance Totem within eight blocks, or it stands idle and says which voice it is missing.",
		"How: a hopper, a Copper Resonator, two Ritual Chalk and a Manifested Ingot."
	]
	quest.4200000000220560.title: "A path for supplies"
	quest.4200000000220561.quest_desc: [
		"Snap the plate onto a tank face. Pair two plates or tuner-bind a destination. Local fluid reaches 32 blocks: 250 mB a second for 8 Pulse. Both ends must be loaded. Since 5.0 the plate wants a kept Air Resonance Totem within eight blocks, or it stands idle and says which voice it is missing.",
		"How: a Spirit Cistern, a Copper Resonator, two Ritual Chalk and a Manifested Ingot."
	]
	quest.4200000000220561.title: "A path for rain"
	quest.4200000000220562.quest_desc: [
		"Longreach carries items up to 128 blocks for 16 Pulse per successful beat. Use standard inventories from any compatible mod. Since 5.0 the plate wants a kept Air Resonance Totem within eight blocks, or it stands idle and says which voice it is missing.",
		"How: an Item Relay, two Resonant Cores and two ender pearls."
	]
	quest.4200000000220562.title: "Across the workshop"
	quest.4200000000220563.quest_desc: [
		"Longreach carries fluids up to 128 blocks for 16 Pulse per beat. Full receivers pause safely; redstone can lock the receiving cistern. Since 5.0 the plate wants a kept Air Resonance Totem within eight blocks, or it stands idle and says which voice it is missing.",
		"How: a Fluid Relay, two Resonant Cores and two ender pearls."
	]
	quest.4200000000220563.title: "Across the waterworks"
	quest.4200000000220564.quest_desc: [
		"Bridge Tribal Power into Mekanism, Powah or AE2 energy acceptors. Each Pulse becomes 100 FE. Unranked conversion is 60 Pulse a second (6,000 FE/s); rank the adapter at Echo stations and empty-hand status names the live rate. It still cannot receive FE. Redstone stops conversion and export.",
		"How: five copper ingots, three redstone and a Resonant Core."
	]
	quest.4200000000220564.title: "The beat becomes current"
	quest.4200000000220565.quest_desc: [
		"The Sixfold Staff. Sneak-use to cycle Earth, Fire, Water, Air, Spirit and Loom. Use to cast; the Loom voice is Tether, pulling a target eight blocks toward you, and a sneak-cast with no target is Stitch, a six-block blink. Carry charged cells; the Spirit Codex explains each spell and its cost.",
		"How: a Spirit Seal, a Resonant Core, a Manifested Ingot and two logs."
	]
	quest.4200000000220565.title: "Six voices in one hand"
	quest.4200000000220566.quest_desc: [
		"Main hand, sneak-use a stone face: a deliberate three-by-three cut at 8 Pulse per block. Normal breaking protection and tool requirements still apply.",
		"How: two Manifested Ingots, a Resonant Core and two Copper Resonators."
	]
	quest.4200000000220566.title: "Stone yields a doorway"
	quest.4200000000220567.quest_desc: [
		"The hood lends night sight while charged cells sustain it. Unlinked pieces draw 2 Pulse every four seconds; a bound voice costs 3.",
		"How: five Spiritweave, helmet-shaped. A Ley Lens on it later lets it see the ley."
	]
	quest.4200000000220567.title: "Eyes in the quiet"
	quest.4200000000220568.quest_desc: [
		"The robe grants resistance. Wear it into the work and keep your cells charged.",
		"How: seven Spiritweave and a Resonant Core."
	]
	quest.4200000000220568.title: "A woven shelter"
	quest.4200000000220569.quest_desc: [
		"Woven leggings lend speed. Their Pulse cost is separate from the other pieces.",
		"How: six Spiritweave and a Resonant Core."
	]
	quest.4200000000220569.title: "The camp keeps pace"
	quest.420000000022056A.quest_desc: [
		"Boots can lend slow falling during descent while Pulse remains. A bound return path is still worth carrying.",
		"How: four Spiritweave, boot-shaped."
	]
	quest.420000000022056A.title: "A gentler descent"
	quest.420000000022056B.quest_desc: [
		"Seat a reusable seal beside its matching totem. A six-block blessing costs 8 Pulse every two seconds. High redstone pauses it; sneak empty-handed to recover the seal.",
		"How: two Manifested Ingots, two copper ingots, a Resonant Core and three stone."
	]
	quest.420000000022056B.title: "A blessing that stays"
	quest.420000000022056C.quest_desc: [
		"Sneak-use the top of a solid floor to bind it. Return within 128 blocks in the same world for 20 Pulse. Power the landing floor to lock arrivals.",
		"How: a compass inside four Manifested Ingots."
	]
	quest.420000000022056C.title: "The first return path"
	quest.420000000022056D.quest_desc: [
		"Return across any distance within one dimension for 40 Pulse. Leave a dry landing with two clear blocks above it.",
		"How: a Waystone Compass inside four Resonant Cores."
	]
	quest.420000000022056D.title: "Beyond the horizon"
	quest.420000000022056E.quest_desc: [
		"Seek March Crystal beyond the Gate Drum. Astral paths for people, items and fluids all draw on the same late-game material.",
		"How: mine crystal in March grottos, or find it in March chests. Gate Drum first."
	]
	quest.420000000022056E.title: "A voice beyond the veil"
	quest.420000000022056F.quest_desc: [
		"The final compass crosses dimensions for 100 Pulse. Bind a safe return before exploring. Travel waits five seconds between uses.",
		"How: a Horizon Compass, two Spirit Seals and two March Crystals."
	]
	quest.420000000022056F.title: "A path between worlds"
	quest.4200000000220570.quest_desc: [
		"Astral cargo crosses dimensions without a distance limit. Each successful beat costs 32 Pulse. The receiver must already be loaded; no hidden chunk loading. Since 5.0 the plate wants a kept Loom Resonance Totem within eight blocks, or it stands idle and says which voice it is missing.",
		"How: a Longreach Item Relay, two Spirit Seals and two March Crystals."
	]
	quest.4200000000220570.title: "Supplies cross the veil"
	quest.4200000000220571.quest_desc: [
		"Astral fluid follows the same dimensional tier as players and items. Keep the destination tank loaded. A full tank or unloaded world pauses without consuming cargo. Since 5.0 the plate wants a kept Loom Resonance Totem within eight blocks, or it stands idle and says which voice it is missing.",
		"How: a Longreach Fluid Relay, two Spirit Seals and two March Crystals."
	]
	quest.4200000000220571.title: "Rain crosses the veil"
	quest.4200000000220572.quest_desc: [
		"Open your personal 54-slot Deep Cache from the road. This is the same vault, shared between your caches and satchel. March attunement removes its opening cost.",
		"How: six Spiritweave, two Resonant Cores and a Deep Cache."
	]
	quest.4200000000220572.title: "The camp in your keeping"
	quest.4200000000220573.quest_desc: [
		"The Gate opens onto a living country. Some creatures still carry the old song; others guard its broken pieces. Brush the gentle ones. Face the guardians with charged cells and a return route.",
		"How: craft or Spark/Tribal Weave reward. Right-click: how the lattice works."
	]
	quest.4200000000220573.title: "The Returning Song"
	quest.4200000000220574.quest_desc: [
		"A dawn grazer that carries the old forest song in its antlers. Breed with wheat; brush adults for Dawn Velvet.",
		"Seek it in Overworld forests and the March. Return its reagent to Echo Bind under Water for a useful material. Build lighted paths; hostile spirits require darkness.",
		"How: brush an adult Dawn Stag. Breed them with wheat."
	]
	quest.4200000000220574.title: "Dawn Stag: a song returned"
	quest.4200000000220575.quest_desc: [
		"A shy dusk forager whose tail marks safe paths. Breed with sweet berries; brush adults for Lantern Down.",
		"Seek it in Overworld forests and the March. Return its reagent to Echo Bind under Water for a useful material. Build lighted paths; hostile spirits require darkness.",
		"How: brush an adult Lantern Fox. Breed them with sweet berries."
	]
	quest.4200000000220575.title: "Lantern Fox: a song returned"
	quest.4200000000220576.quest_desc: [
		"A patient wetland gardener with a living shell. Breed with seagrass; brush adults for a naturally shed Mossback Scale.",
		"Seek it in Overworld swamps and the March. Return its reagent to Echo Bind under Water for a useful material. Build lighted paths; hostile spirits require darkness.",
		"How: brush an adult Mossback. Breed them with seagrass."
	]
	quest.4200000000220576.title: "Mossback: a song returned"
	quest.4200000000220577.quest_desc: [
		"The remains of a broken fire rite. Its melee strikes briefly ignite; keep water close.",
		"Seek it in Overworld forests and the March. Return its reagent to Echo Attune under Spirit for a useful material. Build lighted paths; hostile spirits require darkness.",
		"How: drops from the Ashbound. Hostile spirits need darkness."
	]
	quest.4200000000220577.title: "Ashbound: a song returned"
	quest.4200000000220578.quest_desc: [
		"A grove guardian twisted by a severed ley line. Slow but sturdy; its blows root travellers briefly.",
		"Seek it in Overworld forests and the March. Return its reagent to Echo Attune under Spirit for a useful material. Build lighted paths; hostile spirits require darkness.",
		"How: drops from the Rootbound. Hostile spirits need darkness."
	]
	quest.4200000000220578.title: "Rootbound: a song returned"
	quest.4200000000220579.quest_desc: [
		"A marsh hunter concealed among spirit reeds. Fast strikes carry a short poison.",
		"Seek it in Overworld swamps and the March. Return its reagent to Echo Attune under Spirit for a useful material. Build lighted paths; hostile spirits require darkness.",
		"How: drops from the Reed Stalker. Hostile spirits need darkness."
	]
	quest.4200000000220579.title: "Reed Stalker: a song returned"
	quest.420000000022057A.quest_desc: [
		"A crystal-field scavenger armored in singing stone. Keep your distance from its heavy shove.",
		"Seek it in the March. Return its reagent to Echo Attune under Spirit for a useful material. Build lighted paths; hostile spirits require darkness.",
		"How: drops from the Shardback. Hostile spirits need darkness."
	]
	quest.420000000022057A.title: "Shardback: a song returned"
	quest.420000000022057B.quest_desc: [
		"An empty watchman that still guards the ancient roads. Its touch weakens the grip of attackers.",
		"Seek it in the March. Return its reagent to Echo Attune under Spirit for a useful material. Build lighted paths; hostile spirits require darkness.",
		"How: drops from the Hollow Sentinel. Hostile spirits need darkness."
	]
	quest.420000000022057B.title: "Hollow Sentinel: a song returned"
	quest.420000000022057C.quest_desc: [
		"A storm-fed spirit with vast veil wings. A bright gathering of motes warns of its gust; cover breaks the attack.",
		"Seek it in the March. Return its reagent to Echo Bind under Water for a useful material. Build lighted paths; hostile spirits require darkness.",
		"How: drops from the Storm Moth. Hostile spirits need darkness."
	]
	quest.420000000022057C.title: "Storm Moth: a song returned"
	quest.420000000022057D.quest_desc: [
		"A nimble ember spirit. It gathers sparks before a burning bolt; the spell never ignites terrain.",
		"Seek it in the March. Return its reagent to Echo Attune under Spirit for a useful material. Build lighted paths; hostile spirits require darkness.",
		"How: drops from the Cinder Imp. Hostile spirits need darkness."
	]
	quest.420000000022057D.title: "Cinder Imp: a song returned"
	quest.420000000022057E.quest_desc: [
		"A floating relic that remembers the lost tribes. Its telegraphed chime slows; shelter interrupts the song.",
		"Seek it in the March. Return its reagent to Echo Attune under Spirit for a useful material. Build lighted paths; hostile spirits require darkness.",
		"How: drops from the Mourning Bell. Hostile spirits need darkness."
	]
	quest.420000000022057E.title: "Mourning Bell: a song returned"
	quest.420000000022057F.quest_desc: [
		"A hunter drawn to tears in the lattice. It closes distance quickly but cannot cross worlds by itself.",
		"Seek it in the March. Return its reagent to Echo Attune under Spirit for a useful material. Build lighted paths; hostile spirits require darkness.",
		"How: drops from the Rift Hound. Hostile spirits need darkness."
	]
	quest.420000000022057F.title: "Rift Hound: a song returned"
	quest.4200000000220580.quest_desc: [
		"An eight-legged keeper of broken songs. Its bite slows prey without placing webs or damaging the camp.",
		"Seek it in the March. Return its reagent to Echo Bind under Water for a useful material. Build lighted paths; hostile spirits require darkness.",
		"How: drops from the Echo Weaver. Hostile spirits need darkness."
	]
	quest.4200000000220580.title: "Echo Weaver: a song returned"
	quest.4200000000220581.quest_desc: [
		"The field notes are complete. The gentle harvests and recovered relics have become cloth and Echoes again. Beneath the night veil, the camp answers with a fuller song.",
		"Rare reward: one shared Clowder life, once for the entire team. Only six such rewards exist in the campaign.",
		"How: Spirit Codex + Tribal Weave. Station, totem, and Pulse cost are on the Codex page."
	]
	quest.4200000000220581.title: "Thirteen voices, one sky"
	quest.4200000000220582.quest_desc: [
		"Hang the camp's song in copper. A Spirit Lantern gives full light without fuel; redstone dims it. Mark safe paths back from the dark.",
		"How: three copper ingots, a Spirit Shard and a plank."
	]
	quest.4200000000220582.title: "A light for the returning"
	quest.4200000000220583.quest_desc: [
		"The chime is both ornament and instrument. Its comparator gives 0 in clear skies, 8 in rain and 15 in thunder. Redstone silences it.",
		"How: three planks, three copper ingots and a Bone Chime."
	]
	quest.4200000000220583.title: "Listen to the weather"
	quest.4200000000220584.quest_desc: [
		"A carved table holds 27 stacks. Standard item pipes and relays can share its offerings; comparators read fullness and redstone locks access.",
		"How: a chest, a Bound Echo, two planks and two stone."
	]
	quest.4200000000220584.title: "A place at the hearth"
	quest.4200000000220585.quest_desc: [
		"Place the tender at crop height in a 9-by-9 bed. Put seeds in the first row; harvests fill the lower two rows. Planting costs 4 Pulse, harvest and replant costs 12. Supply power within eight blocks. A full output preserves the crop; redstone pauses the work. Since 5.0 it wants a kept Earth Resonance Totem within eight blocks, or it stands idle and says which voice it is missing. Keep a Water totem near it as well and it waters every furrow of the bed.",
		"How: an iron hoe, an Earth Seal, a Bound Echo, two copper ingots and two planks."
	]
	quest.4200000000220585.title: "The garden keeps singing"
	quest.4200000000220586.quest_desc: [
		"Eight Pulse each second wards hostile spawning within 24 blocks. Existing creatures remain. The ward also prevents hostile cradle summons, so keep your summoning ground outside it. Redstone immediately silences the ward. Since 5.0 it wants a kept Spirit Resonance Totem within eight blocks, or it stands idle and says which voice it is missing.",
		"How: a Spirit Seal, two Bound Echoes, an Echo Shard and three March Planks."
	]
	quest.4200000000220586.title: "Quiet at the camp edge"
	quest.4200000000220587.quest_desc: [
		"The Wayanchor holds its own chunk awake for 16 Pulse each second. Place one at a distant relay receiver and sustain its local power supply. At most 32 anchors may run in one dimension. Redstone or an empty buffer releases the chunk. Since 5.0 it wants a kept Earth Resonance Totem within eight blocks, or it stands idle and says which voice it is missing.",
		"How: two March Crystals, an Eye of Ender, two Manifested Ingots, a Resonant Core and three March Stone."
	]
	quest.4200000000220587.title: "A camp that remembers"
	quest.4200000000220588.quest_desc: [
		"Sneak-use an uncharged effigy on a supported creature to take a harmless imprint. The effigy remembers the species. Bosses cannot be bound; the Codex explains compatible spirits and renewal.",
		"How: a Bone Chime, two Spiritweave, a Resonant Core and a Bound Echo."
	]
	quest.4200000000220588.title: "Borrow a living voice"
	quest.4200000000220589.quest_desc: [
		"Seat an awakened effigy in the first slot and Spiritweave in the second. Each successful summon uses 80 Pulse, one Spiritweave and one binding thread. Leave safe flooring within three blocks. Eight nearby mobs pause the cradle; redstone pauses all work and automation. Since 5.0 it wants a kept Spirit Resonance Totem within eight blocks, or it stands idle and says which voice it is missing.",
		"How: two Manifested Ingots, a March Crystal, two Bound Echoes, a Resonant Core and three March Planks."
	]
	quest.4200000000220589.title: "A hearth for borrowed life"
	quest.420000000022058A.quest_desc: [
		"Set a Spirit Seal in a Ritual Brazier. Bring Earth, Air and Spirit Totems within eight blocks, 200 nearby Pulse and three Spiritweave in your inventory. Use the imprinted effigy on the brazier to awaken 512 summon threads. When all are spent, repeat this ritual to renew the binding.",
		"How: Spirit Seal in a Ritual Brazier; Earth, Air, Spirit totems within 8; 200 Pulse; three Spiritweave; use the imprinted effigy."
	]
	quest.420000000022058A.title: "Three voices awaken the thread"
	quest.420000000022058B.quest_desc: [
		"Complete one successful summoning. Failed or blocked attempts consume no threads or offerings. Each binding lasts 512 successful summons; breaking and replacing the cradle never renews it. The effigy tooltip shows uses left, and a comparator reads the cradle's remaining binding strength.",
		"How: complete one successful summon from the cradle. Failed attempts spend nothing."
	]
	quest.420000000022058B.title: "An answer from the cradle"
	quest.4200000000228001.quest_desc: [
		"Beyond the Gate Drum, the March steppe and highlands hide sunken Ancestor Halls. Walking in ticks this. Four Lore Tablets line each hall; read every one. The chests keep Loom Thread, Echoes, Spiritweave and seals. Hollow Sentinels still stand guard.",
		"How: Gate Drum into the March and walk into an Ancestor Hall; then read its four Lore Tablets."
	]
	quest.4200000000228001.title: "The halls that kept time"
	quest.4200000000228002.quest_desc: [
		"Loom Thread is the Loom, in hand: Ancestor Hall chests hold two to four, The Unsung tears loose sixteen or more, and a Loom-stitcher Elder trades one at Friend standing. It is the reagent of the sixth voice.",
		"How: Ancestor Hall chests, The Unsung, or a Loom-stitcher Elder at Friend."
	]
	quest.4200000000228002.title: "A strand of the thread itself"
	quest.4200000000228003.quest_desc: [
		"Eight March Stone around an Echo Shard makes two Lore Tablets. Placed, a tablet shows a fragment of the nine tribes; a Creative sneak-use cycles which one. Line your own hall with them.",
		"How: eight March Stone around an Echo Shard. Makes two."
	]
	quest.4200000000228003.title: "Carve what you read"
	quest.4200000000228004.quest_desc: [
		"Leather over March Planks around a Resonant Core. The Drum Circle in the March highlands holds one already; this is yours to seat at home. Strike it four times, a breath apart, and something old rises.",
		"How: three leather, five March Planks and a Resonant Core."
	]
	quest.4200000000228004.title: "A drum that will not sound"
	quest.4200000000228005.quest_desc: [
		"The Unsung is a three-phase drum-spirit. Beat: brace by sneaking against its shockwave. Chorus: cut down the Echo Weavers it calls. Silence: it cannot be hurt until you strike the Silent Drum with the same four-beat rhythm, which stuns it and doubles your damage. Bring charged cells and a return path.",
		"How: fight The Unsung at the Silent Drum. Sneak the Beat; four-beat the Silence."
	]
	quest.4200000000228005.title: "The Drum Remembers"
	quest.4200000000228006.quest_desc: [
		"One Unsung Heart per kill, beside Loom Thread and Resonant Cores. It crafts the Loom totem and nothing else, so spend it with care.",
		"How: The Unsung at the Silent Drum drops one per kill."
	]
	quest.4200000000228006.title: "The stilled drum"
	quest.4200000000228007.quest_desc: [
		"An Unsung Heart between Loom Thread and March Crystal, on March Planks. Loom joins Earth, Fire, Water, Air and Spirit: a distinct voice for the Pulse Resonator and the attunement the Echo Unweave and Ley Binding ask for.",
		"How: an Unsung Heart, four March Crystals, two Loom Thread and two March Planks."
	]
	quest.4200000000228007.title: "The sixth voice"
	quest.4200000000228008.quest_desc: [
		"A Blank Seal and Loom Thread. Seated in a Ritual Brazier the Loom Seal blesses Tension: every two seconds it refills two Pulse into the carried cells of everyone in range, and lends Luck.",
		"How: a Blank Seal and Loom Thread, shapeless."
	]
	quest.4200000000228008.title: "A seal of tension"
	quest.4200000000228009.quest_desc: [
		"Loom Thread and Copper Resonators on March Stone. Under a Loom voice the Echo Unweave runs the lattice backwards: a Manifested Ingot to two Bound Echo, Bound to two Attuned, Attuned to two Shards, Spiritweave to two Wool, a Resonant Core to three Manifested Ingots, and any worn Spiritgear tool to one Manifested Ingot.",
		"How: five March Stone, Loom Thread, two Copper Resonators and a Spirit Shard."
	]
	quest.4200000000228009.title: "The lattice, reversed"
	quest.420000000022800A.quest_desc: [
		"Cycle the Sixfold Staff to its Loom voice. Tether pulls a target eight blocks toward you for six Pulse; a sneak-cast with no target is Stitch, a six-block blink through air for ten. Tick this when you have used both.",
		"How: Sixfold Staff on Loom voice. Tether a target, then sneak-Stitch. Tick when both have fired."
	]
	quest.420000000022800A.title: "Tether and Stitch"
	quest.420000000022800B.quest_desc: [
		"Nine tribe camps stand in the March, one per Strand: huts, a fire, a Tribe Hearth, a totem, a banner and four Tribal Kin. Right-click a hearth with what that tribe favours, or with a charged Pulse Cell, and your standing with them rises. Hurting Kin costs 25. Breaking a tribe banner costs 5, the hearth 40. Generic camp blocks do not cost.",
		"How: right-click a March Tribe Hearth with that tribe's favour or a charged Pulse Cell."
	]
	quest.420000000022800B.title: "Kept warm"
	quest.420000000022800C.quest_desc: [
		"Guest at 50, Friend at 150, Kin at 400, Voice at 800. Kills near a hearth and completed trades count too. Elders trade two offers per rank: Grit-singers sell Echoes for raw ore, Seal-carvers sell seals and rite tablets, Loom-stitchers sell Loom Thread and a Waystone Compass, and at Kin a Loom Anchor and a Loom Seal. `/tribalpower standing` prints all nine.",
		"How: reach Friend (150) with a tribe. /tribalpower standing."
	]
	quest.420000000022800C.title: "On good terms"
	quest.420000000022800D.quest_desc: [
		"At Voice standing an Elder presses a Tribe Mark into your hand, once. It opens that tribe's Codex page and is the one ingredient a Kinship Totem cannot do without.",
		"How: Voice (800) with a tribe; the Elder gives a Tribe Mark once."
	]
	quest.420000000022800D.title: "Nine agreeing"
	quest.420000000022800E.quest_desc: [
		"Hold a Tribe Mark. Each tribe's is different; nine are possible.",
		"How: reach Voice (800) with a tribe; its Elder gives the Mark once."
	]
	quest.420000000022800E.title: "Mark of the tribe"
	quest.420000000022800F.quest_desc: [
		"A Tribe Mark, the Resonance Totem of that tribe's attunement and two Spiritweave. A Kinship Totem counts as an extra distinct voice for the Pulse Resonator and lends its tribe's attunement to stations, so nine tribes can carry the camp's song to fifteen voices.",
		"How: a Tribe Mark, that tribe's Resonance Totem and two Spiritweave in a crafting grid."
	]
	quest.420000000022800F.title: "A voice that is not a voice"
	quest.4200000000228010.quest_desc: [
		"A camp's Drummer plays every few seconds; place a Drumheart within eight blocks of one and each beat feeds it two Pulse. Tick this when a Drummer is feeding your lattice.",
		"How: place a Drumheart within 8 of a camp Drummer; tick when it is feeding Pulse."
	]
	quest.4200000000228010.title: "The camp keeps the beat"
	quest.4200000000228011.quest_desc: [
		"Two stone and the reagent around the seal; the seal is handed back. Knotted Root beside an Earth Seal; 600 Pulse. For twenty minutes crops, saplings and stems in the nine chunks around the brazier grow faster. Sneak-use the tablet on a Ritual Brazier with that seal seated, inside its Rite Circle (four pedestals on the diagonals, chalk joining them); the Pulse is drawn from the lattice within eight blocks.",
		"How: two stone, a Knotted Root and an Earth Seal, shapeless; the seal comes back."
	]
	quest.4200000000228011.title: "Rite Tablet: Green Blessing"
	quest.4200000000228012.quest_desc: [
		"Two stone and the reagent around the seal; the seal is handed back. Reed Fang beside a Water Seal; 400 Pulse. Twenty minutes of rain, for the cisterns and the crops. Sneak-use the tablet on a Ritual Brazier with that seal seated, inside its Rite Circle (four pedestals on the diagonals, chalk joining them); the Pulse is drawn from the lattice within eight blocks.",
		"How: two stone, a Reed Fang and a Water Seal, shapeless; the seal comes back."
	]
	quest.4200000000228012.title: "Rite Tablet: Rain Calling"
	quest.4200000000228013.quest_desc: [
		"Two stone and the reagent around the seal; the seal is handed back. Storm Wing beside an Air Seal; 400 Pulse. Forty minutes of clear sky. Sneak-use the tablet on a Ritual Brazier with that seal seated, inside its Rite Circle (four pedestals on the diagonals, chalk joining them); the Pulse is drawn from the lattice within eight blocks.",
		"How: two stone, a Storm Wing and an Air Seal, shapeless; the seal comes back."
	]
	quest.4200000000228013.title: "Rite Tablet: Sky Clearing"
	quest.4200000000228014.quest_desc: [
		"Two stone and the reagent around the seal; the seal is handed back. Ember Heart beside a Fire Seal; 800 Pulse. Hurries the night to the next sunrise for the whole world. Sneak-use the tablet on a Ritual Brazier with that seal seated, inside its Rite Circle (four pedestals on the diagonals, chalk joining them); the Pulse is drawn from the lattice within eight blocks.",
		"How: two stone, an Ember Heart and a Fire Seal, shapeless; the seal comes back."
	]
	quest.4200000000228014.title: "Rite Tablet: Dawn Calling"
	quest.4200000000228015.quest_desc: [
		"Two stone and the reagent around the seal; the seal is handed back. Sentinel Sigil beside a Spirit Seal; 600 Pulse. Fifteen minutes without hostile spawns within sixty-four blocks. Sneak-use the tablet on a Ritual Brazier with that seal seated, inside its Rite Circle (four pedestals on the diagonals, chalk joining them); the Pulse is drawn from the lattice within eight blocks.",
		"How: two stone, a Sentinel Sigil and a Spirit Seal, shapeless; the seal comes back."
	]
	quest.4200000000228015.title: "Rite Tablet: Still Night"
	quest.4200000000228016.quest_desc: [
		"Two stone and the reagent around the seal; the seal is handed back. Loom Thread beside a Loom Seal; 1,200 Pulse. Joins the nearest totem to another within sixty-four blocks with a thirty-minute ley line that routes Pulse between them. Sneak-use the tablet on a Ritual Brazier with that seal seated, inside its Rite Circle (four pedestals on the diagonals, chalk joining them); the Pulse is drawn from the lattice within eight blocks.",
		"How: two stone, Loom Thread and a Loom Seal, shapeless; the seal comes back."
	]
	quest.4200000000228016.title: "Rite Tablet: Ley Binding"
	quest.4200000000228017.quest_desc: [
		"Perform any rite. If the lattice around the brazier holds too little Pulse, nothing is consumed and the brazier says so.",
		"How: sneak-use any Rite Tablet on a Ritual Brazier in its Rite Circle with matching seal and Pulse."
	]
	quest.4200000000228017.title: "First Rite"
	quest.4200000000228018.quest_desc: [
		"Two Spiritweave, a Spirit Shard and the reagent of the species. Use it on an adult familiar. Animals: sixty percent, charm kept on failure. Remnants want Voice with their tribe, forty percent, charm spent on failure.",
		"How: two Spiritweave, a Spirit Shard and one familiar reagent (Dawn Velvet, Lantern Down, Storm Wing and the like)."
	]
	quest.4200000000228018.title: "A charm for a wild thing"
	quest.4200000000228019.quest_desc: [
		"A bonded familiar follows, teleports after you, never despawns, cannot be hurt by you and yields double when brushed. Fox, Mossback and Stag start you off. Remnants need Voice. One fighter and two helpers may follow; sitters do not count.",
		"How: use a Bonding Charm on an adult familiar. Advancement on first bond."
	]
	quest.4200000000228019.title: "A friend in the dark"
	quest.420000000022801A.quest_desc: [
		"Paper, Spiritweave and a Spirit Shard. Use the charter on a player to invite them to your camp, or in the air to see it. `/tribalpower camp` creates, invites, joins, leaves, kicks, renames.",
		"How: paper, Spiritweave and a Spirit Shard, shapeless."
	]
	quest.420000000022801A.title: "A camp of many voices"
	quest.420000000022801B.quest_desc: [
		"Camp members share a fifty-four-slot camp vault behind every Deep Cache and Wayfarer Satchel, count as owners of each other's devices, pool twelve Wayanchors, and mirror a quarter of their tribe standing to the camp. A Clowder is not that camp — /tribalpower camp create <name> is.",
		"How: /tribalpower camp create <name> (not a Clowder). Advancement on first camp."
	]
	quest.420000000022801B.title: "One vault, one budget"
	quest.420000000022801C.quest_desc: [
		"A glass pane over a Copper Resonator and a Spirit Shard. Held, the lens shows the ley strength where you stand and paints it on the ground around you; sneak-use it on a Ley Collector, or a familiar, for its numbers.",
		"How: a glass pane, a Copper Resonator and a Spirit Shard in a column."
	]
	quest.420000000022801C.title: "See the ley"
	quest.420000000022801D.quest_desc: [
		"Quartz over redstone and a Copper Resonator on March Stone. Faced at any Pulse holder it puts out redstone 0 to 15 in proportion to what is stored.",
		"How: quartz, two redstone, a Copper Resonator and March Stone."
	]
	quest.420000000022801D.title: "A needle for Pulse"
	quest.420000000022801E.quest_desc: [
		"A redstone torch over redstone and a Copper Resonator on March Stone. It emits when the faced holder is at or above its threshold; right-click cycles 25, 50, 75 and 100 percent. The pieces of a Pulse-driven automation.",
		"How: a redstone torch, two redstone, a Copper Resonator and March Stone."
	]
	quest.420000000022801E.title: "A line in the song"
	quest.420000000022801F.quest_desc: [
		"Sneak-use the Spirit Codex on any Tribal block for a plain report: stored Pulse, the generators feeding it, the attunements within eight blocks, what is missing for the current recipe, a full output, a redstone pause, an unloaded relay end. Tick this when it has told you something you did not know.",
		"How: sneak-use the Spirit Codex on a Tribal block; tick when the report names a real fault."
	]
	quest.420000000022801F.title: "Ask the Codex why"

	quest.4200000000228020.quest_desc: [
		"Ask a Stone Font for cobble. Stone is not made; stone is asked to stay. Cobble needs only the shape and Pulse; an Earth totem within eight lets it ask for stone.",
		"How: five cobblestone, an Echo Shard and a Drumheart."
	]
	quest.4200000000228020.title: "A font of stone"
	quest.4200000000228021.quest_desc: [
		"Complete any pattern. Placement is the ritual: scattered devices are not a rite.",
		"How: place a rite pattern from the Spirit Codex; the advancement fires on the first complete circle."
	]
	quest.4200000000228021.title: "Draw the circle"
	quest.4200000000228022.quest_desc: [
		"Ask a Stone Font for its first cobblestone. Stone is not made; stone is asked to stay.",
		"How: run the Stone Font until cobble appears. Advancement on the first stay."
	]
	quest.4200000000228022.title: "Stone stays"
	quest.4200000000228023.quest_desc: [
		"Sneak-use the Spirit Codex on the font when it is working. Tick this when the report names stored Pulse or a missing totem.",
		"How: sneak-use the Spirit Codex on the Stone Font; tick when the report names a real fault or a full buffer."
	]
	quest.4200000000228023.title: "The font answers"
	quest.4200000000228024.quest_desc: [
		"Keep a charged cell at the font so the asking does not stall.",
		"How: fill a Pulse Cell from a Drumheart, then tick this when the font is fed."
	]
	quest.4200000000228024.title: "A cell at the font"
	quest.4200000000228025.quest_desc: [
		"The mesh does not find the ore; the mesh gives the ore somewhere to land. Seat it over a Listening Pit.",
		"How: four March Stone, two Attuned Echoes, two Spiritweave and a Copper Resonator."
	]
	quest.4200000000228025.title: "A mesh that listens"
	quest.4200000000228026.quest_desc: [
		"Four Anchor Stones hold the pit's corners. Without them the mesh has nowhere to stand.",
		"How: four March Stone over an Echo Shard. Makes four."
	]
	quest.4200000000228026.title: "Four anchors"
	quest.4200000000228027.quest_desc: [
		"Call the first ore up through a Listening Pit.",
		"How: Resonance Mesh over a pit with Anchor Stones; the advancement fires on the first ore."
	]
	quest.4200000000228027.title: "Ask the ground"
	quest.4200000000228028.quest_desc: [
		"Gold grit from the pit is the next voice after iron.",
		"How: keep asking the ground; tick when gold grit is in hand."
	]
	quest.4200000000228028.title: "Gold from the pit"
	quest.4200000000228029.quest_desc: [
		"The pit spends Pulse. Keep a cell on the mesh so the asking does not stall.",
		"How: fill a Pulse Cell from a Drumheart and seat it where the Codex shows."
	]
	quest.4200000000228029.title: "The pit keeps time"
	quest.420000000022802A.quest_desc: [
		"Eleven Gate Frames and the keystone ring the way. A missing frame is a missing step.",
		"How: six March Stone, two copper ingots and an Echo Shard. Makes four."
	]
	quest.420000000022802A.title: "A frame for the way"
	quest.420000000022802B.quest_desc: [
		"The keystone is the twelfth stone. Without it the ring is only a pattern.",
		"How: four Gate Frames, a Resonant Core, a Spirit Shard and a Pulse Cell."
	]
	quest.420000000022802B.title: "The keystone"
	quest.420000000022802C.quest_desc: [
		"Light a Way Gate. Eleven frames, one keystone, and somewhere to be.",
		"How: finish the ring and light it; the advancement fires when the way opens."
	]
	quest.420000000022802C.title: "Open the way"
	quest.420000000022802D.quest_desc: [
		"Sneak-use the sigil on a keystone to write it down. Use it on a second keystone to tie the two together.",
		"How: a Blank Seal, Loom Thread and a Spirit Shard, shapeless."
	]
	quest.420000000022802D.title: "Write the destination"
	quest.420000000022802E.quest_desc: [
		"Travel a Far Gate from one dimension to another. The Loom was never one thread.",
		"How: bind two keystones with a Gate Sigil, then walk the far gate."
	]
	quest.420000000022802E.title: "The long thread"
	quest.420000000022802F.quest_desc: [
		"The fire's generator. Seat it near its totem; a hand Drumheart cannot run this voice.",
		"How: three copper ingots, a Cinder Knot, a Fire Seal and two March Planks."
	]
	quest.420000000022802F.title: "The fire's voice"
	quest.4200000000228030.quest_desc: [
		"The wind's generator. Seat it near its totem so the six can hear each other.",
		"How: four Spiritweave, a Storm Wing, an Air Seal and two March Planks."
	]
	quest.4200000000228030.title: "The wind's voice"
	quest.4200000000228031.quest_desc: [
		"The water's generator. Seat it near its totem; cisterns and springs listen to this voice.",
		"How: two leather, three March Planks, a Knotted Root and a Water Seal."
	]
	quest.4200000000228031.title: "The water's voice"
	quest.4200000000228032.quest_desc: [
		"The wake-bell is spirit's long tone. Seat it near its totem with the other five.",
		"How: a Bell Fragment, four copper ingots, a Spirit Seal and a Spirit Shard."
	]
	quest.4200000000228032.title: "The earth's wake"
	quest.4200000000228033.quest_desc: [
		"The sixth generator. Loom voice needs Loom Thread; the Unsung and the stitcher Elders keep it.",
		"How: four March Crystals, two Loom Thread, two Spiritweave and a Resonant Core."
	]
	quest.4200000000228033.title: "The sixth generator"
	quest.4200000000228034.quest_desc: [
		"A cairn stores Pulse in the field so six voices can share a buffer.",
		"How: six March Stone, two Bound Echoes and a Pulse Cell."
	]
	quest.4200000000228034.title: "A cairn of Pulse"
	quest.4200000000228035.quest_desc: [
		"Have all six generators producing within 32 blocks of each other, one per voice.",
		"How: Ember Horn, Wind Harp, Wave Drum, Wake Bell, Loom Anchor, and Drumheart within 32. Advancement on six voices."
	]
	quest.4200000000228035.title: "Six voices singing"
	quest.4200000000228036.quest_desc: [
		"Asks a cistern to keep giving. Ten minutes of water, and the seal is kept.",
		"How: sneak-use the tablet on a Ritual Brazier in its Rite Circle with matching seal and Pulse."
	]
	quest.4200000000228036.title: "A spring that keeps giving"
	quest.4200000000228037.quest_desc: [
		"The drum circle the Unsung still remember. Optional souvenir.",
		"How: The Unsung at the Silent Drum can drop it. Optional."
	]
	quest.4200000000228037.title: "The drum circle"
	quest.4200000000228038.quest_desc: [
		"A blank seal after the first rite, ready for the next circle.",
		"How: First Rite at the brazier; tick when a spare blank seal is in hand."
	]
	quest.4200000000228038.title: "A spare seal"
	quest.4200000000228039.quest_desc: [
		"The fire workshop. A Fire totem within eight and Pulse run every furnace recipe, including mineral grit. A hand Drumheart cannot keep this kiln.",
		"How: furnace + resonators + chime. Fire totem. Smelts grit for Pulse — a hand Drumheart cannot run it."
	]
	quest.4200000000228039.title: "Grit in the kiln"
	quest.420000000022803A.quest_desc: [
		"Weave a Recipe Seal for a workshop. Empty bottles return to the slot that held them. Side-IO refuses spectators and other camps. Since 5.0 it wants a kept Loom Resonance Totem within eight blocks, or it stands idle and says which voice it is missing.",
		"How: Spirit Codex names the Seal Loom craft. Seat bottles; they come back to that slot."
	]
	quest.420000000022803A.title: "A loom for seals"
	quest.420000000022803B.quest_desc: [
		"Four cheap Pulse lamps (Glow Reed, Shard Lamp, Echo Sconce, Ember Bowl) draw 1–2 Pulse a second from the lattice. Redstone dims them.",
		"How: craft a Shard Lamp, place it within eight of Pulse, then dim it with redstone if you want night."
	]
	quest.420000000022803B.title: "A lamp that drinks Pulse"
	quest.420000000022803C.quest_desc: [
		"Ten Spirit Charms wear in three Tribal slots, no Curios. Sky with Air is creative flight. Sneak-use a Resonance Totem to bind a voice; Chorus binds every nearby voice at a Brazier.",
		"How: craft the Sky Charm, then sneak-use it on an Air totem. Spirit Codex: Spirit Charms."
	]
	quest.420000000022803C.title: "A charm with a voice"
	quest.420000000022803D.quest_desc: [
		"The water workshop. Rank it at Echo stations the same way as Spiritgear; higher rank spends more Pulse as it speeds up. Rank survives pickup. Since 5.0 it wants a kept Water Resonance Totem within eight blocks, or it stands idle and says which voice it is missing.",
		"How: Spirit Codex Workshop pages. Place the Tide Pump on a cistern face, then sneak-use the Codex if it stays silent."
	]
	quest.420000000022803D.title: "A pump for the cistern"
	quest.420000000022803E.quest_desc: [
		"Each Pulse still becomes 100 FE. Unranked conversion is 60 Pulse a second. Rank the adapter at Echo Attune, Bind, then Manifest and empty-hand status names the live rate. It still cannot receive FE.",
		"How: sneak-use a Harmonic Energizer on Echo Attune, then Bind, then Manifest. Tick when diagnose names a rate above 60."
	]
	quest.420000000022803E.title: "Rank the current"
	quest.420000000022803F.quest_desc: [
		"Sneak-use any Spiritgear piece or charm on a placed Resonance Totem (40 Pulse) to bind that voice. Mixed sets are intended. The totem is not consumed. Loom needs a Loom totem.",
		"How: sneak-use a tool, armor piece, or charm on a totem with 40 Pulse nearby. Tick when the tooltip names the bound voice."
	]
	quest.420000000022803F.title: "Bind a voice"
	quest.4200000000228040.quest_desc: [
		"A reed lamp. Cheap Pulse light for a camp path. Optional.",
		"How: craft Glow Reed. Place it near Pulse. Optional."
	]
	quest.4200000000228040.title: "Reed light"
	quest.4200000000228041.quest_desc: [
		"A wall sconce that drinks Pulse. Optional.",
		"How: craft Echo Sconce and hang it. Optional."
	]
	quest.4200000000228041.title: "Echo sconce"
	quest.4200000000228042.quest_desc: [
		"A bowl of camp firelight on Pulse. Optional.",
		"How: craft Ember Bowl. Optional."
	]
	quest.4200000000228042.title: "Ember bowl"
	quest.4200000000228043.quest_desc: [
		"Hang a wind charm from a ceiling. March camp furniture: stool, table, urn, mat, shelf, and this. Optional.",
		"How: craft Wind Charm and hang it. Optional souvenir."
	]
	quest.4200000000228043.title: "A charm on the wind"
	quest.4200000000228044.quest_desc: [
		"Chorus binds every nearby totem voice at a Ritual Brazier. Optional once Sky is in hand.",
		"How: craft Chorus Charm, then sneak-use it at a Brazier with voices in range. Optional."
	]
	quest.4200000000228044.title: "Every nearby voice"
	quest.4200000000228045.quest_desc: [
		"The axe spends Pulse like the pick. Rank it at Echo stations; sneak-use a totem to bind a voice. Optional.",
		"How: craft Spiritgear Axe. Optional once the pick exists."
	]
	quest.4200000000228045.title: "An edge for timber"
	quest.4200000000228046.quest_desc: [
		"Bricks and a bowl over three copper. Set it over a lit campfire, fire, magma, lava or an Ember Bowl; it asks no Pulse at all. Up to four ingredients and a bowl in any order, about twelve seconds a meal. Hoppers feed it from above and the sides and take the meal from below.",
		"How: bricks and a bowl over three copper. Set it over a campfire, fire, magma, lava or an Ember Bowl; no Pulse."
	]
	quest.4200000000228046.title: "A pot for the camp"
	quest.4200000000228047.quest_desc: [
		"A hot red tuber from the Ember Wastes. What you pick is the seed; plant it on farmland like a potato. The Spiritgear Hoe reaps and replants in one stroke.",
		"How: grows wild in the Ember Wastes, through a Gate Drum. What you pick is the seed; plant it on farmland."
	]
	quest.4200000000228047.title: "Emberroot"
	quest.4200000000228048.quest_desc: [
		"Grows wild in the Reed Fen. Pick a patch and plant what you picked; four stages on tilled ground, and bees pollinate it.",
		"How: grows wild in the Reed Fen, through a Gate Drum. Plant what you picked on farmland."
	]
	quest.4200000000228048.title: "Fen Rice"
	quest.4200000000228049.quest_desc: [
		"From the Snow Fields. It also counts as a herb for the Spirit Kettle.",
		"How: grows wild in the Snow Fields, through a Gate Drum. Plant what you picked on farmland."
	]
	quest.4200000000228049.title: "Frostberry"
	quest.420000000022804A.quest_desc: [
		"From Glimmer Ridge. A herb for the kettle as well as a crop.",
		"How: grows wild on Glimmer Ridge, through a Gate Drum. Plant what you picked on farmland."
	]
	quest.420000000022804A.title: "Glimmer Bean"
	quest.420000000022804B.quest_desc: [
		"From the Steppe, and the grain most tribe dishes are built on. Grow a bed of it before the rest.",
		"How: grows wild on the Steppe, through a Gate Drum. Plant what you picked on farmland."
	]
	quest.420000000022804B.title: "Steppe Grain"
	quest.420000000022804C.quest_desc: [
		"Two Steppe Grain and one Iron Grit in the Hearth Pot. Eating a tribe's dish carries its boon for five minutes; the Grit-singers' breaks more from ore. Once a tribe calls you Friend its Kin sell the dish for four of its crop, and offering a tribe its own dish at its hearth pays six standing.",
		"How: two Steppe Grain and an Iron Grit in a Hearth Pot over heat. Grit-singer Kin sell it at Friend."
	]
	quest.420000000022804C.title: "The Grit-singers' loaf"
	quest.420000000022804D.quest_desc: [
		"Two Raw Game and an Emberroot. Raw Game drops from the March's game animals. The Edge-walkers' boon: you never fall while you sneak. Every tribe has a dish; JEI lists all nine under the pot.",
		"How: two Raw Game and an Emberroot in a Hearth Pot. Raw Game drops from March game animals."
	]
	quest.420000000022804D.title: "The Edge-walkers' jerky"
	quest.420000000022804E.quest_desc: [
		"Keeper's Root Mash, Grit-baked Bread, an Emberroot and Steppe Grain in the pot. Set the feast on a solid block and it holds six servings; each fills you and grants the Earth blessing for eight minutes — dig faster, stand firm. Every voice has a feast of its own dishes.",
		"How: Keeper's Root Mash, Grit-baked Bread, Emberroot and Steppe Grain in a Hearth Pot. Place it; six servings."
	]
	quest.420000000022804E.title: "A table for the camp"
	quest.420000000022804F.quest_desc: [
		"Bones and iron around a cauldron, a Bone Chime under it. Sit it over heat. Three seats: one raw reagent out of your pouch, a March herb, and a base — a glass bottle makes two tinctures, honeycomb two salves, charcoal four incense. A batch is ten seconds and 24 Pulse from the lattice. The nearest totem within eight blocks sings into the brew.",
		"How: bones and iron around a cauldron, a Bone Chime under. Sit it over heat; a totem within 8 shapes the brew."
	]
	quest.420000000022804F.title: "A kettle over the fire"
	quest.4200000000228050.quest_desc: [
		"The reagent's family picks the remedy: Kindling is Strength, Cooling is Fire Resistance, Antidote lifts poison, Mending is Regeneration, and so on. A tincture lasts three minutes and hands the bottle back. Every remedy lifts Spirit Sickness, the Hush, Frayed and Ley Sickness.",
		"How: Spirit Kettle — a raw reagent, a March herb and a glass bottle. Ten seconds, 24 Pulse, two tinctures."
	]
	quest.4200000000228050.title: "Drink it"
	quest.4200000000228051.quest_desc: [
		"Honeycomb as the base. Use a salve on yourself, or on a friend, a villager or your familiar: three hearts at once, every harmful effect gone, and the remedy for half a tincture's time. A stack of these is the difference between a hard night in the March and a walk home.",
		"How: Spirit Kettle — a raw reagent, a March herb and honeycomb. Two salves a batch."
	]
	quest.4200000000228051.title: "Lay it on"
	quest.4200000000228052.quest_desc: [
		"Charcoal as the base. Seat incense in a Ritual Brazier — up to sixteen sticks, no seal and no Pulse — and every two seconds everyone within eight blocks gets the remedy, familiars mended a heart. Each stick burns thirty seconds. Redstone puts it out; sneak empty-handed to take it back.",
		"How: Spirit Kettle — a raw reagent, a March herb and charcoal. Four incense a batch; burn them in a Ritual Brazier."
	]
	quest.4200000000228052.title: "Burn it for everyone"
	quest.4200000000228053.quest_desc: [
		"Two Bone Chimes around a Manifested Ingot on a stick. Hold use and every half second it mends whoever you look at within six blocks, or you: three-quarters of a heart for 2 Pulse. It ranks at the Echo stations like the rest of Spiritgear; from Bound each shake eases Spirit Sickness a level.",
		"How: two Bone Chimes around a Manifested Ingot on a stick. Hold use to mend whoever you look at."
	]
	quest.4200000000228053.title: "Shake it"
	quest.4200000000228054.quest_desc: [
		"Cobble over a magma block makes four. Over heat they steam. Sleep the whole night in a bed with hot stones within five blocks and a roof over you: you wake fully healed, cleansed, with ten minutes of Spirit Blessing so the sickness cannot take hold.",
		"How: cobble over a magma block makes four. Sit them over heat within five blocks of a roofed bed."
	]
	quest.4200000000228054.title: "A night in the lodge"
	quest.4200000000228055.quest_desc: [
		"Two stone, a Mossback Scale and Spirit Reed around a Spirit Seal; the seal is handed back. Cast it on a brazier with a Spirit Seal seated, inside its Rite Circle, for 500 Pulse: everyone within twelve blocks is healed ten hearts, cleansed and blessed, and the circle stays open ten minutes. Lay a fallen familiar's Spirit Remnant on a pedestal first and it comes back whole.",
		"How: two stone, a Mossback Scale, Spirit Reed and a Spirit Seal, shapeless; the seal comes back. Cast on a sealed brazier in its Rite Circle."
	]
	quest.4200000000228055.title: "Rite Tablet: Healing Circle"
	quest.4200000000228056.quest_desc: [
		"A Manifested Ingot, a Bone Chime and a stick on the diagonal. Seven damage, reach plus one and a half, and a sprinting thrust hits 35 percent harder. Underneath it is a Blade: it ranks at the Echo stations, spends Pulse on echo strikes and takes a totem voice. It keeps a Rift Hound at arm's length.",
		"How: Manifested Ingot, Bone Chime and a stick on the diagonal. Ranks at the Echo stations like the Blade."
	]
	quest.4200000000228056.title: "Reach first"
	quest.4200000000228057.quest_desc: [
		"Four Manifested Ingots in a T over a Bone Chime. Ten damage, reach plus half, heavy — it slows your walk while it is in hand — and the widest, strongest sweep of the family. The halberd, battle axe, warhammer, dagger, scythe and trident are made the same way; each trades reach, speed and weight against the others.",
		"How: four Manifested Ingots in a T over a Bone Chime. Heavy; the widest sweep."
	]
	quest.4200000000228057.title: "The widest sweep"
	quest.4200000000228058.quest_desc: [
		"String and Copper Resonators around a Bone Chime. It fires sonic bolts on Pulse from the cells you carry and takes verse arrows. Quick to loose again, and a half draw when you are in a hurry.",
		"How: string and Copper Resonators around a Bone Chime. Fires sonic bolts on carried Pulse."
	]
	quest.4200000000228058.title: "A bow that sings"
	quest.4200000000228059.quest_desc: [
		"Manifested Ingots either side of a Pulse Bow, a tripwire hook and sticks below. Hold use to load — 10 Pulse up front, a little longer than a full draw — then use again to fire. It hits about half again as hard, flies almost straight, and holds its shot as long as you like.",
		"How: Manifested Ingots either side of a Pulse Bow, tripwire hook and sticks below. Hold use to load, use to fire."
	]
	quest.4200000000228059.title: "The bow's heavier sister"
	quest.420000000022805A.quest_desc: [
		"The Song Bench has a weapon seat beside the output. Stand a totem within reach with Pulse in the lattice, keep your Reagent Pouch on the hotbar with four empowered reagents of one kind, seat a Spiritgear weapon, pick the reagent and press Anoint: four reagents and 32 Pulse. Searing burns, Stormcall arcs lightning, Bloodthirst steals life, Mending repairs the weapon — eleven in all, one at a time; a different reagent replaces it. Only Spiritgear takes the bench's work unless a pack opens tribalpower:anointable. Tick this when a weapon carries one.",
		"How: Spiritgear weapon in the Song Bench's weapon seat, four empowered reagents in the pouch, 32 Pulse; press Anoint. Tick when it is anointed."
	]
	quest.420000000022805A.title: "A reagent in the blade"
	quest.420000000022805B.quest_desc: [
		"Vines around Spirit Reed and an ender pearl make two. Put one on each floor in the same column; they find each other, no linking and no power. Jump to rise to the next lift above, sneak to sink to the one below, up to 48 blocks each way. A lift with a ceiling on it is passed over.",
		"How: vines around Spirit Reed and an ender pearl make two. Stack them in one column; jump up, sneak down."
	]
	quest.420000000022805B.title: "Up the column"
	quest.420000000022805C.quest_desc: [
		"Spirit Reed under a string. Use it on a creature to take it and on a block to set it down, safe and whole. Never a player, a boss or a March elite. Woven is two uses — one trip; copper, manifested and resonant urns carry more, and the resonant never wears out. It will not take a creature when it has only one use left.",
		"How: Spirit Reed under a string. Use on a creature to take it, on a block to set it down. Two uses."
	]
	quest.420000000022805C.title: "Carry a creature home"
	quest.420000000022805D.quest_desc: [
		"Leather over planks around a note block. The Gate Rite as a game with no portal at the end: every track in the pack, played on A, S, D, F as the beats reach the line. It keeps your best score per track and a board of the server's five best. Practise here before a real Gate Drum.",
		"How: leather over planks around a note block. Use it to pick a track and play A, S, D, F."
	]
	quest.420000000022805D.title: "Drum for the joy of it"
	quest.420000000022805E.quest_desc: [
		"Four glowstone round a Spirit Seal, two Manifested Ingots, a golden carrot and Spiritweave. Use it to wear it; sneak-use to open the three charm slots. The Lantern charm carries the Spirit voice: night sight, and any voice blessing on you lasts half again as long. Worn charms cost 2 Pulse per voice every two seconds from a carried cell.",
		"How: four glowstone round a Spirit Seal, two Manifested Ingots, a golden carrot and Spiritweave. Use it to wear it; sneak-use opens the slots."
	]
	quest.420000000022805E.title: "A light you wear"
	quest.420000000022805F.quest_desc: [
		"Once a tribe calls you Guest, right-click its Elder and talk. Ask for work and they hand you a request — three open a day, one held per tribe, each paying standing and every third a Tribe Mark. Ask for their story and a seven-step road begins: Friend, the thing they prize, hunting near their fires, a rite in their camp, their dish cooked, and where they send you. The last step is a trial against a guardian. Finish one story and hold its relic.",
		"How: right-click a tribe's Elder at Guest or better and ask for their story; seven steps end at a guardian. Advancement on the first relic."
	]
	quest.420000000022805F.title: "A story told"
	quest.4200000000228060.quest_desc: [
		"The Pad-keepers' relic. Their story ends at the Stampede Spirit at the Trampled Ring on the Steppe; win the trial and the Elder hands it over. Carried anywhere in your pack it keeps their boon on you whatever your standing: you never trample a field.",
		"How: finish the Pad-keepers' story with their Elder; the trial is the Stampede Spirit on the Steppe."
	]
	quest.4200000000228060.title: "Kept Ember"
	quest.4200000000228061.quest_desc: [
		"The Grit-singers' relic. Their story ends at the Prism Serpent at the Singing Fracture in the Crystal Fields; win the trial and the Elder hands it over. Carried anywhere in your pack it keeps their boon on you whatever your standing: you break more from ore.",
		"How: finish the Grit-singers' story with their Elder; the trial is the Prism Serpent in the Crystal Fields."
	]
	quest.4200000000228061.title: "Ringing Stone"
	quest.4200000000228062.quest_desc: [
		"The Rootbinders' relic. Their story ends at the Bog Matriarch at the Drowned Root in the Reed Fen; win the trial and the Elder hands it over. Carried anywhere in your pack it keeps their boon on you whatever your standing: crops hurry along around you.",
		"How: finish the Rootbinders' story with their Elder; the trial is the Bog Matriarch in the Reed Fen."
	]
	quest.4200000000228062.title: "First Root"
	quest.4200000000228063.quest_desc: [
		"The Edge-walkers' relic. Their story ends at the Storm Roc at the Roost on the Highlands; win the trial and the Elder hands it over. Carried anywhere in your pack it keeps their boon on you whatever your standing: you never fall while you sneak.",
		"How: finish the Edge-walkers' story with their Elder; the trial is the Storm Roc on the Highlands."
	]
	quest.4200000000228063.title: "Bridge Nail"
	quest.4200000000228064.quest_desc: [
		"The Drumhearts' relic. Their story ends at the Slag Titan at the Slag Throne in the Ember Wastes; win the trial and the Elder hands it over. Carried anywhere in your pack it keeps their boon on you whatever your standing: you swing faster.",
		"How: finish the Drumhearts' story with their Elder; the trial is the Slag Titan in the Ember Wastes."
	]
	quest.4200000000228064.title: "Steady Drum"
	quest.4200000000228065.quest_desc: [
		"The Pattern-weavers' relic. Their story ends at the Tide Drummer at the Tide Stone in the Shallows; win the trial and the Elder hands it over. Carried anywhere in your pack it keeps their boon on you whatever your standing: Echo stations near you work double.",
		"How: finish the Pattern-weavers' story with their Elder; the trial is the Tide Drummer in the Shallows."
	]
	quest.4200000000228065.title: "Silent Gear"
	quest.4200000000228066.quest_desc: [
		"The Colony-keepers' relic. Their story ends at the Cairn Wight at the Cairn Ring in the Snow Fields; win the trial and the Elder hands it over. Carried anywhere in your pack it keeps their boon on you whatever your standing: you are never stung.",
		"How: finish the Colony-keepers' story with their Elder; the trial is the Cairn Wight in the Snow Fields."
	]
	quest.4200000000228066.title: "Hive Seal"
	quest.4200000000228067.quest_desc: [
		"The Seal-carvers' relic. Their story ends at the Vault Sentinel at the Sealed Gate on Glimmer Ridge; win the trial and the Elder hands it over. Carried anywhere in your pack it keeps their boon on you whatever your standing: your charms ask half the Pulse.",
		"How: finish the Seal-carvers' story with their Elder; the trial is the Vault Sentinel on Glimmer Ridge."
	]
	quest.4200000000228067.title: "Polite Seal"
	quest.4200000000228068.quest_desc: [
		"The Loom-stitchers' relic. Their story ends at The Unsung at the Silent Drum; win the trial and the Elder hands it over. Carried anywhere in your pack it keeps their boon on you whatever your standing: you sing cheaper.",
		"How: finish the Loom-stitchers' story with their Elder; the trial is The Unsung at the Silent Drum."
	]
	quest.4200000000228068.title: "Ninth Thread"
	quest.4200000000228069.quest_desc: [
		"Every tribe's story finished: eight guardians faced and The Unsung. With all nine relics in your pack, the Ninth Agreement is within reach. `/tribalpower standing` shows where each tribe stands with you.",
		"How: finish all nine stories. Advancement when the ninth relic is in hand."
	]
	quest.4200000000228069.title: "Nine relics"
	quest.420000000022806A.quest_desc: [
		"The Slag Throne in the Ember Wastes: a ring of stone with a Guardian Altar at its centre, on polished deepslate between four lit candles, open air above. Sneak-use the altar empty-handed and it names what it wants — eight Magma Scales — then lay them on and stand back. Sneak to brace against its slams; roused, the rings ignite and Cinder Imps rise from the slag. At half health it is roused and calls its country's creatures, which drop nothing. Leave it half a minute and it sleeps again; the altar rests twenty minutes between calls. It drops the Slag Core, and its fall ends the Drumhearts' story.",
		"How: sneak-use the country's Guardian Altar empty-handed, lay on eight of the reagent it names, and win. Advancement on the kill."
	]
	quest.420000000022806A.title: "Slag Titan stilled"
	quest.420000000022806B.quest_desc: [
		"The Drowned Root in the Reed Fen: a ring of stone with a Guardian Altar at its centre, on polished deepslate between four lit candles, open air above. Sneak-use the altar empty-handed and it names what it wants — eight Reed Fangs — then lay them on and stand back. Its snare drags you in and slows you; keep to solid ground and cut down the Reed Stalkers it calls. At half health it is roused and calls its country's creatures, which drop nothing. Leave it half a minute and it sleeps again; the altar rests twenty minutes between calls. It drops the Fen Heart, and its fall ends the Rootbinders' story.",
		"How: sneak-use the country's Guardian Altar empty-handed, lay on eight of the reagent it names, and win. Advancement on the kill."
	]
	quest.420000000022806B.title: "Bog Matriarch stilled"
	quest.420000000022806C.quest_desc: [
		"The Cairn Ring in the Snow Fields: a ring of stone with a Guardian Altar at its centre, on polished deepslate between four lit candles, open air above. Sneak-use the altar empty-handed and it names what it wants — eight Rime Mandibles — then lay them on and stand back. Its breath freezes everything in front of it. Circle behind; the Rime Crawlers it calls are slow. At half health it is roused and calls its country's creatures, which drop nothing. Leave it half a minute and it sleeps again; the altar rests twenty minutes between calls. It drops the Cairn Stone, and its fall ends the Colony-keepers' story.",
		"How: sneak-use the country's Guardian Altar empty-handed, lay on eight of the reagent it names, and win. Advancement on the kill."
	]
	quest.420000000022806C.title: "Cairn Wight stilled"
	quest.420000000022806D.quest_desc: [
		"The Singing Fracture in the Crystal Fields: a ring of stone with a Guardian Altar at its centre, on polished deepslate between four lit candles, open air above. Sneak-use the altar empty-handed and it names what it wants — eight Prism Carapace — then lay them on and stand back. It fires bolts of light that mark you glowing. Strafe, close in, and watch for the second bolt it adds once roused. At half health it is roused and calls its country's creatures, which drop nothing. Leave it half a minute and it sleeps again; the altar rests twenty minutes between calls. It drops the Prism Core, and its fall ends the Grit-singers' story.",
		"How: sneak-use the country's Guardian Altar empty-handed, lay on eight of the reagent it names, and win. Advancement on the kill."
	]
	quest.420000000022806D.title: "Prism Serpent stilled"
	quest.420000000022806E.quest_desc: [
		"The Sealed Gate on Glimmer Ridge: a ring of stone with a Guardian Altar at its centre, on polished deepslate between four lit candles, open air above. Sneak-use the altar empty-handed and it names what it wants — eight Sentinel Sigils — then lay them on and stand back. The heaviest armour in the March and a sweep that throws you off the ridge. Roused, it wards itself three seconds at a time: wait it out. At half health it is roused and calls its country's creatures, which drop nothing. Leave it half a minute and it sleeps again; the altar rests twenty minutes between calls. It drops the Vault Seal, and its fall ends the Seal-carvers' story.",
		"How: sneak-use the country's Guardian Altar empty-handed, lay on eight of the reagent it names, and win. Advancement on the kill."
	]
	quest.420000000022806E.title: "Vault Sentinel stilled"
	quest.420000000022806F.quest_desc: [
		"The Tide Stone in the Shallows: a ring of stone with a Guardian Altar at its centre, on polished deepslate between four lit candles, open air above. Sneak-use the altar empty-handed and it names what it wants — eight Brine Fangs — then lay them on and stand back. Each beat pulls everyone toward it and hurts. Fight it from the shore with your back to something solid. At half health it is roused and calls its country's creatures, which drop nothing. Leave it half a minute and it sleeps again; the altar rests twenty minutes between calls. It drops the Tide Shell, and its fall ends the Pattern-weavers' story.",
		"How: sneak-use the country's Guardian Altar empty-handed, lay on eight of the reagent it names, and win. Advancement on the kill."
	]
	quest.420000000022806F.title: "Tide Drummer stilled"
	quest.4200000000228070.quest_desc: [
		"The Trampled Ring on the Steppe: a ring of stone with a Guardian Altar at its centre, on polished deepslate between four lit candles, open air above. Sneak-use the altar empty-handed and it names what it wants — eight Shank Sinew — then lay them on and stand back. It charges. Sidestep and hit it as it passes; when Burrow Gnashers surface, stand on a block. At half health it is roused and calls its country's creatures, which drop nothing. Leave it half a minute and it sleeps again; the altar rests twenty minutes between calls. It drops the Herd Horn, and its fall ends the Pad-keepers' story.",
		"How: sneak-use the country's Guardian Altar empty-handed, lay on eight of the reagent it names, and win. Advancement on the kill."
	]
	quest.4200000000228070.title: "Stampede Spirit stilled"
	quest.4200000000228071.quest_desc: [
		"The Roost on the Highlands: a ring of stone with a Guardian Altar at its centre, on polished deepslate between four lit candles, open air above. Sneak-use the altar empty-handed and it names what it wants — eight Storm Wings — then lay them on and stand back. It swoops and throws you into the air; roused, lightning follows each swoop. A bow and a roof help more than a shield. At half health it is roused and calls its country's creatures, which drop nothing. Leave it half a minute and it sleeps again; the altar rests twenty minutes between calls. It drops the Storm Plume, and its fall ends the Edge-walkers' story.",
		"How: sneak-use the country's Guardian Altar empty-handed, lay on eight of the reagent it names, and win. Advancement on the kill."
	]
	quest.4200000000228071.title: "Storm Roc stilled"
	quest.4200000000228072.quest_desc: [
		"All eight guardian cores and an Unsung Heart, shapeless. A core with a Loom Thread would make six Resonant Cores instead, so take a second set of drops if you want both. The boss bar of every guardian wears its tribe's colour.",
		"How: all eight guardian cores and an Unsung Heart, shapeless. Cast in a Loom circle with nine relics on you."
	]
	quest.4200000000228072.title: "The tablet of nine"
	quest.4200000000228073.quest_desc: [
		"Draw a Loom circle — a Loom Seal seated in the brazier inside its Rite Circle — and cast the tablet with all nine relics on you; the rite draws its Pulse before it takes. Nine lights rise, one in each tribe's colour. From then on every tribe treats you as Kin at the least, all nine boons settle on you for a while, and the aurora burns full every night you stand under it. Once per player; a second casting only lights the circle.",
		"How: Loom Seal in a brazier inside its Rite Circle, nine relics in your pack; sneak-use the tablet on the brazier."
	]
	quest.4200000000228073.title: "The Loom agrees"
	quest.4200000000228074.quest_desc: [
		"Sixteen fragments of the Loom's history are carved into the March: eight Carved Stones in the walls of its ruins, eight two-by-two Murals at the guardians' grounds. Right-click one to read it; the Codex keeps it and its Chronicle section puts it in order. Read all sixteen and the story is whole.",
		"How: right-click all eight Carved Stones in March ruins and all eight Murals at the guardians' grounds."
	]
	quest.4200000000228074.title: "The Chronicle whole"
	quest.4200000000228075.quest_desc: [
		"Set into the walls of the March's ruins — the old works, the sunken shrine, the barrows, the tombs, the vaults. Read it where you find it, then pick it up and set it on a wall of your own; what you read stays read.",
		"How: set into the walls of March ruins. Read it, then break it and set it on your own wall."
	]
	quest.4200000000228075.title: "A stone that remembers"
	quest.4200000000228076.quest_desc: [
		"Two blocks wide and two tall at each guardian's ground, each painting the country it stands in. Reading any part reads it all. Placed as one piece, it comes down as one; a mural cut in creative changes its chapter with a sneak-click.",
		"How: stands two-by-two at each guardian's ground. Read it, then take it down whole and place it at home."
	]
	quest.4200000000228076.title: "A wall that paints its country"
	quest.4200000000228077.quest_desc: [
		"The March acts on its own. Ashfall, a Glimmer Storm, a Whiteout and Fen Mist close a country in and raise spirits by day; each feeds one voice's generators and hampers another's. Now and then one voice's ley threads surge: collectors carrying it yield double, but stand on a bare crossing with no collector and Ley Sickness sways the ground and drains your Pulse. Every tribe keeps a festival day in turn — join the feast for a gift. A warm light drifting near you is a wandering spirit; reach it for a line of its country's story and a small gift. Storms and surges are called two minutes ahead, in chat and over the hotbar. Tick this when you have weathered one.",
		"How: be in the March through a weather, a surge or a festival day; tick it when you have."
	]
	quest.4200000000228077.title: "The March breathes"

	quest.420000000023058C.quest_desc: [
		"Grit-singers never cut a stone the same way twice. This bench remembers every cut.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: stone + table parts in JEI. Insert a block and pick a variant."
	]
	quest.420000000023058C.title: "Mason Table"
	quest.420000000023058D.quest_desc: [
		"The same trick for wood — a hundred planks from one.",
		"How: Chipped carpenter table in JEI. Same idea as the mason table, for wood."
	]
	quest.420000000023058D.title: "Carpenter's Table"
	quest.420000000023058E.quest_desc: [
		"Sand into glass, then glass into every shape the light will take.",
		"How: Chipped workbench in JEI (mason, carpenter, glassblower…). Put the block in the table and pick a cut."
	]
	quest.420000000023058E.title: "Glassblower"
	quest.420000000023058F.quest_desc: [
		"Wool and cloth, rewoven — fitting, for a pad that is mending a loom.",
		"How: Chipped workbench in JEI (mason, carpenter, glassblower…). Put the block in the table and pick a cut."
	]
	quest.420000000023058F.title: "Loom Table"
	quest.4200000000230590.quest_desc: [
		"Leaves, saplings, and growing things, sorted into their variations.",
		"How: Chipped workbench in JEI (mason, carpenter, glassblower…). Put the block in the table and pick a cut."
	]
	quest.4200000000230590.title: "Botanist Workbench"
	quest.4200000000230591.quest_desc: [
		"Coloured blocks and stranger stone. Pick a variant; the bench holds the rest.",
		"How: Chipped workbench in JEI (mason, carpenter, glassblower…). Put the block in the table and pick a cut."
	]
	quest.4200000000230591.title: "Alchemy Bench"
	quest.4200000000230592.quest_desc: [
		"Metal and machine-facing blocks, cut to taste.",
		"How: Chipped workbench in JEI (mason, carpenter, glassblower…). Put the block in the table and pick a cut."
	]
	quest.4200000000230592.title: "Tinkering Table"
	quest.4200000000230593.quest_desc: [
		"Feed a block into the Mason Table and choose from the wall of variants.",
		"How: four stone in a square, or the stonecutter."
	]
	quest.4200000000230593.title: "A Cut of Stone"
	quest.4200000000230594.quest_desc: [
		"The Carpenter's Table does the same for wood.",
		"How: one log in the crafting grid makes four."
	]
	quest.4200000000230594.title: "A Cut of Planks"
	quest.4200000000230595.quest_desc: [
		"Every pane the Glassblower knows starts here.",
		"How: smelt sand. Hammer cobble to gravel, gravel to sand, then furnace."
	]
	quest.4200000000230595.title: "A Cut of Glass"
	quest.4200000000230596.quest_desc: [
		"Grit-singers' favourite stone to argue over.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000230596.title: "Deepslate Variety"
	quest.4200000000230597.quest_desc: [
		"Fired clay, a hundred ways.",
		"How: four brick items. Clay balls smelt into bricks."
	]
	quest.4200000000230597.title: "Bricks Variety"
	quest.4200000000230598.quest_desc: [
		"Pad grit, cut fine.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000230598.title: "Sandstone Variety"
	quest.4200000000240599.quest_desc: [
		"The first thing that turns a pad into a place someone lives.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: oak planks in JEI. First Handcrafted piece."
	]
	quest.4200000000240599.title: "A Chair"
	quest.420000000024059A.quest_desc: [
		"Somewhere to put the Codex down while you think.",
		"How: Handcrafted furniture from planks in JEI. First chair is oak."
	]
	quest.420000000024059A.title: "A Table"
	quest.420000000024059B.quest_desc: [
		"Room for a Clowder to sit while the barrel works.",
		"How: Handcrafted furniture from planks in JEI. First chair is oak."
	]
	quest.420000000024059B.title: "A Bench"
	quest.420000000024059C.quest_desc: [
		"For the Codex Pages you keep meaning to reread.",
		"How: Handcrafted furniture from planks in JEI. First chair is oak."
	]
	quest.420000000024059C.title: "A Shelf"
	quest.420000000024059D.quest_desc: [
		"Handcrafted storage that looks like it belongs.",
		"How: Handcrafted furniture from planks in JEI. First chair is oak."
	]
	quest.420000000024059D.title: "A Cupboard"
	quest.420000000024059E.quest_desc: [
		"The Pad-keepers slept well. So should you.",
		"How: Handcrafted furniture from planks in JEI. First chair is oak."
	]
	quest.420000000024059E.title: "A Fancy Bed"
	quest.420000000024059F.quest_desc: [
		"A lantern, a page, a place for both.",
		"How: Handcrafted furniture from planks in JEI. First chair is oak."
	]
	quest.420000000024059F.title: "A Nightstand"
	quest.42000000002405A0.quest_desc: [
		"Cut a frame, then dress it in any block. One shape, every skin.",
		"How: an iron ingot over three framed cubes. Cuts framed blocks."
	]
	quest.42000000002405A0.title: "Framing Saw"
	quest.42000000002405A1.quest_desc: [
		"A blank cube waiting for a camouflage block.",
		"How: Framing Saw, then framed cube/slab/stairs. Camo is right-click with a block."
	]
	quest.42000000002405A1.title: "Framed Cube"
	quest.42000000002405A2.quest_desc: [
		"Half a frame; twice the options.",
		"How: Framing Saw, then framed cube/slab/stairs. Camo is right-click with a block."
	]
	quest.42000000002405A2.title: "Framed Slab"
	quest.42000000002405A3.quest_desc: [
		"Steps that wear whatever wall they sit in.",
		"How: Framing Saw, then framed cube/slab/stairs. Camo is right-click with a block."
	]
	quest.42000000002405A3.title: "Framed Stairs"
	quest.42000000002405A4.quest_desc: [
		"For roofs and rooflines the void never gave you.",
		"How: Framing Saw, then framed cube/slab/stairs. Camo is right-click with a block."
	]
	quest.42000000002405A4.title: "Framed Slope"
	quest.42000000002405A5.quest_desc: [
		"Edge-walkers spanned the void with less. Reach the next pad in style.",
		"How: Macaw bridges from the matching stone/wood in JEI."
	]
	quest.42000000002405A5.title: "Rope Bridge"
	quest.42000000002405A6.quest_desc: [
		"A roof over the pad. The rain up here is only ever ambition.",
		"How: Macaw roofs from the matching wood in JEI."
	]
	quest.42000000002405A6.title: "Attic Roof"
	quest.42000000002405A7.quest_desc: [
		"Comfort is infrastructure too.",
		"How: Handcrafted furniture from planks in JEI. First chair is oak."
	]
	quest.42000000002405A7.title: "Couch"
	quest.42000000002405A8.quest_desc: [
		"A kitchen edge for the Farmer's Delight line.",
		"How: Handcrafted furniture from planks in JEI. First chair is oak."
	]
	quest.42000000002405A8.title: "Counter"
	quest.42000000002405A9.quest_desc: [
		"Where the Whisker Codex gets its margins.",
		"How: Handcrafted furniture from planks in JEI. First chair is oak."
	]
	quest.42000000002405A9.title: "Desk"
	quest.42000000002405AA.quest_desc: [
		"Small storage that matches the table.",
		"How: Handcrafted furniture from planks in JEI. First chair is oak."
	]
	quest.42000000002405AA.title: "Drawer"
	quest.42000000002405AB.quest_desc: [
		"A threshold that hides in the wall.",
		"How: Framing Saw, then framed cube/slab/stairs. Camo is right-click with a block."
	]
	quest.42000000002405AB.title: "Framed Door"
	quest.42000000002405AC.quest_desc: [
		"Thin cover; full disguise.",
		"How: Framing Saw, then framed cube/slab/stairs. Camo is right-click with a block."
	]
	quest.42000000002405AC.title: "Framed Panel"
	quest.42000000002405AD.quest_desc: [
		"An edge rail you can dress to taste.",
		"How: Framing Saw, then framed cube/slab/stairs. Camo is right-click with a block."
	]
	quest.42000000002405AD.title: "Framed Fence"
	quest.42000000002405AE.quest_desc: [
		"Grey and honest, like the grit it came from.",
		"How: Macaw bridges from the matching stone/wood in JEI."
	]
	quest.42000000002405AE.title: "Andesite Bridge"
	quest.42000000002505AF.quest_desc: [
		"A wall light that is not a torch stuck in shame. The stewards had standards.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: torch + iron nuggets. First Stewardries craft."
	]
	quest.42000000002505AF.title: "Sconce"
	quest.42000000002505B0.quest_desc: [
		"Sand, falling. The only honest clock before the Clock Strand.",
		"How: Supplementaries craft in JEI (sconce, sack, safe, rope…). Stewardries names the station."
	]
	quest.42000000002505B0.title: "Hourglass"
	quest.42000000002505B1.quest_desc: [
		"Drip a fluid out of a block. Small; oddly satisfying.",
		"How: Supplementaries craft in JEI (sconce, sack, safe, rope…). Stewardries names the station."
	]
	quest.42000000002505B1.title: "Faucet"
	quest.42000000002505B2.quest_desc: [
		"Turn it by hand. The Drumhearts started somewhere too.",
		"How: Supplementaries craft in JEI (sconce, sack, safe, rope…). Stewardries names the station."
	]
	quest.42000000002505B2.title: "Crank"
	quest.42000000002505B3.quest_desc: [
		"Show a thing off. A token, a page, a trophy.",
		"How: Supplementaries craft in JEI (sconce, sack, safe, rope…). Stewardries names the station."
	]
	quest.42000000002505B3.title: "Item Shelf"
	quest.42000000002505B4.quest_desc: [
		"A bag that holds bags. Recover's clutter, tidied.",
		"How: Supplementaries craft in JEI (sconce, sack, safe, rope…). Stewardries names the station."
	]
	quest.42000000002505B4.title: "Sack"
	quest.42000000002505B5.quest_desc: [
		"Lock the Frayed Thread away from your own worse ideas.",
		"How: Supplementaries craft in JEI (sconce, sack, safe, rope…). Stewardries names the station."
	]
	quest.42000000002505B5.title: "Safe"
	quest.42000000002505B6.quest_desc: [
		"Pin a page where the whole Clowder reads it.",
		"How: Supplementaries craft in JEI (sconce, sack, safe, rope…). Stewardries names the station."
	]
	quest.42000000002505B6.title: "Notice Board"
	quest.42000000002505B7.quest_desc: [
		"A pot with ambitions. Grow a little where the pad is thin.",
		"How: Supplementaries craft in JEI (sconce, sack, safe, rope…). Stewardries names the station."
	]
	quest.42000000002505B7.title: "Planter"
	quest.42000000002505B8.quest_desc: [
		"Raise the Spindle Loom Fragment where it can be admired.",
		"How: Supplementaries craft in JEI (sconce, sack, safe, rope…). Stewardries names the station."
	]
	quest.42000000002505B8.title: "Pedestal"
	quest.42000000002505B9.quest_desc: [
		"Store cookies, bees, or the small dignity of order.",
		"How: Supplementaries craft in JEI (sconce, sack, safe, rope…). Stewardries names the station."
	]
	quest.42000000002505B9.title: "Jar (37)"
	quest.42000000002505BA.quest_desc: [
		"Set a spawn without hauling a whole bed up the ladder.",
		"How: wool in JEI. White sleeping bag; dye variants exist. Sets spawn without a full bed."
	]
	quest.42000000002505BA.title: "Sleeping Bag"
	quest.42000000002505BB.quest_desc: [
		"Sleep through the day so the mobs meet a rested Skybound.",
		"How: wool + string in JEI. Hang it from Rope and Nail."
	]
	quest.42000000002505BB.title: "Hammock"
	quest.42000000002505BC.quest_desc: [
		"Hang the hammock between two posts, over the drop, and dare it.",
		"How: string and an iron ingot. Place two, then hang the hammock."
	]
	quest.42000000002505BC.title: "Rope and Nail"
	quest.42000000002505BD.quest_desc: [
		"A steadier flame for the pad's long nights.",
		"How: Supplementaries craft in JEI (sconce, sack, safe, rope…). Stewardries names the station."
	]
	quest.42000000002505BD.title: "Candle Holder"
	quest.42000000002505BE.quest_desc: [
		"Climb, hang, or bridge. Edge-walkers swore by it.",
		"How: Supplementaries craft in JEI (sconce, sack, safe, rope…). Stewardries names the station."
	]
	quest.42000000002505BE.title: "Rope (37)"
	quest.42000000002505BF.quest_desc: [
		"Raise and lower the rope on a redstone whim.",
		"How: Supplementaries craft in JEI (sconce, sack, safe, rope…). Stewardries names the station."
	]
	quest.42000000002505BF.title: "Pulley Block"
	quest.42000000002505C0.quest_desc: [
		"Fall onto it and the void forgets to punish you.",
		"How: Supplementaries craft in JEI (sconce, sack, safe, rope…). Stewardries names the station."
	]
	quest.42000000002505C0.title: "Feather Block"
	quest.42000000002505C1.quest_desc: [
		"Chalk a plan the whole Clowder can argue with.",
		"How: Supplementaries craft in JEI (sconce, sack, safe, rope…). Stewardries names the station."
	]
	quest.42000000002505C1.title: "Blackboard"
	quest.42000000002505C2.quest_desc: [
		"Carry a small thing that would rather you didn't.",
		"How: Supplementaries craft in JEI (sconce, sack, safe, rope…). Stewardries names the station."
	]
	quest.42000000002505C2.title: "Cage"
	quest.42000000002605C3.quest_desc: [
		"The first wire. The pulse the Drumhearts kept now has somewhere to go.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: roll copper sheets in a rolling mill. Current chapter starts here."
	]
	quest.42000000002605C3.title: "Copper Wire"
	quest.42000000002605C4.quest_desc: [
		"Rotation on one side, Forge Energy on the other. Two Strands shaking hands.",
		"How: Create Crafts \& Additions — copper wire from the rolling mill, then connectors and motor."
	]
	quest.42000000002605C4.title: "Connector"
	quest.42000000002605C5.quest_desc: [
		"Energy back into rotation. The Clock Strand runs on the Spark Strand now.",
		"How: Create Crafts \& Additions — copper wire from the rolling mill, then connectors and motor."
	]
	quest.42000000002605C5.title: "Electric Motor"
	quest.42000000002605C6.quest_desc: [
		"Hold a charge between the wire and the work.",
		"How: Create Crafts \& Additions — copper wire from the rolling mill, then connectors and motor."
	]
	quest.42000000002605C6.title: "Capacitor"
	quest.42000000002605C7.quest_desc: [
		"A wall of stored current, built as big as the pad allows.",
		"How: Create Crafts \& Additions — copper wire from the rolling mill, then connectors and motor."
	]
	quest.42000000002605C7.title: "Modular Accumulator"
	quest.42000000002605C8.quest_desc: [
		"Rods and wire from ingots — Create's answer to the press.",
		"How: Create Crafts \& Additions — copper wire from the rolling mill, then connectors and motor."
	]
	quest.42000000002605C8.title: "Rolling Mill"
	quest.42000000002605C9.quest_desc: [
		"Enchant without the table's superstition. Feed it experience, get intent.",
		"How: Create Enchantment Industry after a blaze burner. JEI names the printer and XP bucket."
	]
	quest.42000000002605C9.title: "Blaze Enchanter"
	quest.42000000002605CA.quest_desc: [
		"Liquid practice, carried. The stewards would have found this vulgar and useful.",
		"How: Create Enchantment Industry after a blaze burner. JEI names the printer and XP bucket."
	]
	quest.42000000002605CA.title: "Experience Bucket"
	quest.42000000002605CB.quest_desc: [
		"Copy a book, a plan, a page. The Codex approves, quietly.",
		"How: Create Enchantment Industry after a blaze burner. JEI names the printer and XP bucket."
	]
	quest.42000000002605CB.title: "Printer"
	quest.42000000002605CC.quest_desc: [
		"Lava and heat into power. A bridge, not the Hum itself.",
		"How: osmium + furnace + copper. First Mekanism generator."
	]
	quest.42000000002605CC.title: "Heat Generator"
	quest.42000000002605CD.quest_desc: [
		"On a pad that is all sky, the sun is the one resource nobody rations.",
		"How: Mekanism generators after the Works line. Heat generator is the first craft."
	]
	quest.42000000002605CD.title: "Solar Generator"
	quest.42000000002605CE.quest_desc: [
		"The higher the pad, the harder it turns. Build tall.",
		"How: Mekanism generators after the Works line. Heat generator is the first craft."
	]
	quest.42000000002605CE.title: "Wind Generator"
	quest.42000000002605CF.quest_desc: [
		"Burn the Sprout Strand's surplus. Nothing on a pad is waste.",
		"How: Mekanism generators after the Works line. Heat generator is the first craft."
	]
	quest.42000000002605CF.title: "Bio Generator"
	quest.42000000002605D0.quest_desc: [
		"Late power for a Clowder that went deep on Mekanism.",
		"How: Mekanism generators after the Works line. Heat generator is the first craft."
	]
	quest.42000000002605D0.title: "Gas-Burning Generator"
	quest.42000000002605D1.quest_desc: [
		"The digital loom, in your pocket. Reweave from anywhere on the pad.",
		"How: Wireless Terminal after an AE2 network and a charged wireless kit. JEI names the craft."
	]
	quest.42000000002605D1.title: "Wireless Terminal (38)"
	quest.42000000002605D2.quest_desc: [
		"Mekanism's chemicals, stored in the AE2 network. Two late pillars, braided.",
		"How: Applied Mekanistics chemical cells after AE2 housing + Mekanism chemicals."
	]
	quest.42000000002605D2.title: "Chemical Cell"
	quest.42000000002605D3.quest_desc: [
		"For when the copper wire cannot carry the whole pulse.",
		"How: Create Crafts \& Additions — copper wire from the rolling mill, then connectors and motor."
	]
	quest.42000000002605D3.title: "Large Connector"
	quest.42000000002605D4.quest_desc: [
		"A cake that levels you. Do not tell the Kitchen line.",
		"How: Create Enchantment Industry after a blaze burner. JEI names the printer and XP bucket."
	]
	quest.42000000002605D4.title: "Experience Cake"
	quest.42000000002605D5.quest_desc: [
		"A bigger bite of the same free sky.",
		"How: Mekanism generators after the Works line. Heat generator is the first craft."
	]
	quest.42000000002605D5.title: "Advanced Solar"
	quest.42000000002605D6.quest_desc: [
		"The shell every chemical cell needs.",
		"How: Applied Mekanistics chemical cells after AE2 housing + Mekanism chemicals."
	]
	quest.42000000002605D6.title: "Chemical Housing"
	quest.42000000002605D7.quest_desc: [
		"Carry a measure of gas off the network.",
		"How: Applied Mekanistics chemical cells after AE2 housing + Mekanism chemicals."
	]
	quest.42000000002605D7.title: "Portable Chemical Cell"
	quest.42000000002705D8.quest_desc: [
		"Each Strand has a guardian the Cut snapped: a Loom-construct gone feral. You do not murder a monster; you re-tension the Strand by beating it. Craft its Frayed Totem once the Strand is seated, use it anywhere outside an arena, and you and every Clowder mate within 32 blocks are pulled into its stage. Win, and every one of you carries home that guardian's Woven Relic. Lose, and you are spat back out with the totem spent.",
		"Relics work from the Curios relic slot, the off-hand or the hotbar: a passive while worn and a right-click power on a cooldown. `/guardians leave` abandons a fight; `/guardians status` shows the Clowder's record.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: checkmark. Craft each Frayed Totem after that Strand is seated; use it outside an arena."
	]
	quest.42000000002705D8.title: "Answer for the Cut"
	quest.42000000002705D9.quest_desc: [
		"The Burrow Bowl: a sunken bowl of four soil tiers stepping down to a mud pit under six dark-oak root arches, seven teal root-seams glowing across the pit floor.",
		"Four Frayed Thread and four of the Strand's block around a Void Yarn.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705D9.title: "Totem: the Beddown"
	quest.42000000002705DA.quest_desc: [
		"Every quarter of its health the Beddown slams and floods the pit with a layer of dirt, immune inside it. One of the seven seams lights: dig a channel to it, expose the core and hit it to break the burial. The first gate, and a forgiving one.",
		"How: use the matching Frayed Totem, then win the arena. Advancement completes this."
	]
	quest.42000000002705DA.title: "Re-tension: the Beddown"
	quest.42000000002705DB.quest_desc: [
		"Rootheart: knockback taken is cut by sixty percent and nothing can pull you. Root Down plants you for five seconds behind eight hearts of absorption.",
		"One per Clowder member present at the win, straight to inventory.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705DB.title: "Relic: Rootheart"
	quest.42000000002705DC.quest_desc: [
		"The Millpit: a deepslate quarry with a rotating grindstone ring in the floor and four stone sieve chutes pouring gravel into the central grit pit.",
		"Four Frayed Thread and four of the Strand's block around a Void Yarn.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705DC.title: "Totem: the Grindmaw"
	quest.42000000002705DD.quest_desc: [
		"The Grindmaw is immune while its maw is closed. Each chute drops a grit block every fifteen seconds; carry one onto the ring and let it ride into the pit's mouth to jam the maw open for twelve seconds. The ring reverses every phase and shoves the careless into the pit.",
		"How: use the matching Frayed Totem, then win the arena. Advancement completes this."
	]
	quest.42000000002705DD.title: "Re-tension: the Grindmaw"
	quest.42000000002705DE.quest_desc: [
		"Grindcore: immune to Mining Fatigue, and your hand sieves get one extra fortune roll. Shred strips two armour from the next thing you hit.",
		"One per Clowder member present at the win, straight to inventory.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705DE.title: "Relic: Grindcore"
	quest.42000000002705DF.quest_desc: [
		"The Overgrowth Terrace: four garden terraces under a leaf canopy, eight trellis posts, and four pruning stations on the second tier.",
		"Four Frayed Thread and four of the Strand's block around a Void Yarn.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705DF.title: "Totem: the Thornmother"
	quest.42000000002705E0.quest_desc: [
		"The Thornmother never strikes; she seeds thorn-hedge that spreads and burns to the touch, and heals whenever a pruning station is overgrown. Shears and axes clear it. Compost eight hedge at a station to fire a prune wave that clears the ground and stuns her — the only clean damage window.",
		"How: use the matching Frayed Totem, then win the arena. Advancement completes this."
	]
	quest.42000000002705E0.title: "Re-tension: the Thornmother"
	quest.42000000002705E1.quest_desc: [
		"Thornseed: Thorns and no berry or cactus damage. Bloom raises a ring of hedge and gives Regeneration II to you and your Clowder inside it.",
		"One per Clowder member present at the win, straight to inventory.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705E1.title: "Relic: Thornseed"
	quest.42000000002705E2.quest_desc: [
		"The Sky Shards: ten deepslate shards floating over the void, crumbling bridges between them, gold claw-marks on the main shard where the boss lands.",
		"Four Frayed Thread and four of the Strand's block around a Void Yarn.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705E2.title: "Totem: the Edgewalker"
	quest.42000000002705E3.quest_desc: [
		"A pure duel. The Edgewalker leaps shard to shard and pounces whoever stands furthest from a wall; a gold claw-mark shows where, a breath before it lands — step off it. Bridges crumble behind you and return later. Falling costs six hearts and a trip back to your pad.",
		"How: use the matching Frayed Totem, then win the arena. Advancement completes this."
	]
	quest.42000000002705E3.title: "Re-tension: the Edgewalker"
	quest.42000000002705E4.quest_desc: [
		"Edgestep: no fall damage under twelve blocks and no slipping off edges. Edgestep dashes six blocks, twice, with a stronger hit at the end.",
		"One per Clowder member present at the win, straight to inventory.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705E4.title: "Relic: Edgestep"
	quest.42000000002705E5.quest_desc: [
		"The Forge Drum: a brass drum-platform over a lava crater, eight copper piston hammers with beat pads before them, four lava channels through the floor.",
		"Four Frayed Thread and four of the Strand's block around a Void Yarn.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705E5.title: "Totem: the Drumheart"
	quest.42000000002705E6.quest_desc: [
		"The Drumheart can only be hurt for a moment after every fourth beat. Stand on a beat pad at the downbeat to charge a spark that counts triple; on beat four the lava channels rise, so be on the pads, not in the channels. The tempo climbs every phase.",
		"How: use the matching Frayed Totem, then win the arena. Advancement completes this."
	]
	quest.42000000002705E6.title: "Re-tension: the Drumheart"
	quest.42000000002705E7.quest_desc: [
		"Drumpulse: every fourth hit lands two extra hearts. Downbeat stuns and throws back everything within seven blocks.",
		"One per Clowder member present at the win, straight to inventory.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705E7.title: "Relic: Drumpulse"
	quest.42000000002705E8.quest_desc: [
		"The Escapement: four rotating copper rings carrying dark-oak sequence tiles around an iron hub, six gear-towers and a sixteen-block pendulum keeping time.",
		"Four Frayed Thread and four of the Strand's block around a Void Yarn.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705E8.title: "Totem: the Cogwright"
	quest.42000000002705E9.quest_desc: [
		"Every phase the Cogwright winds: tiles light in sequence across the turning rings and you have twelve seconds to step them in order. Success opens its chassis for eight seconds; failure fires every gear-tower. The pendulum is the metronome; the rings reverse when it swings far.",
		"How: use the matching Frayed Totem, then win the arena. Advancement completes this."
	]
	quest.42000000002705E9.title: "Re-tension: the Cogwright"
	quest.42000000002705EA.quest_desc: [
		"Cogloop: Haste I, and tools wear a fifth slower. Rewind resets every other relic you carry and snaps you back three seconds.",
		"One per Clowder member present at the win, straight to inventory.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705EA.title: "Relic: Cogloop"
	quest.42000000002705EB.quest_desc: [
		"The Comb: a hexagonal wax arena of rising and falling comb cells, honey pools, and six drone cells in the wall.",
		"Four Frayed Thread and four of the Strand's block around a Void Yarn.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705EB.title: "Totem: the Hivemind"
	quest.42000000002705EC.quest_desc: [
		"The Hivemind is fragile but every wave its six cells pour drones. A campfire set on a drone cell seals it for thirty seconds; seal all six and the royal chamber opens for ten. Your own Productive Bees attack the drones on sight.",
		"How: use the matching Frayed Totem, then win the arena. Advancement completes this."
	]
	quest.42000000002705EC.title: "Re-tension: the Hivemind"
	quest.42000000002705ED.quest_desc: [
		"Hivecall: bees never turn on you, and hives within sixteen blocks work a tenth faster. Call the Swarm sends four relic-bees after whatever you hit.",
		"One per Clowder member present at the win, straight to inventory.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705ED.title: "Relic: Hivecall"
	quest.42000000002705EE.quest_desc: [
		"The Ward Circle: a stone sanctum of gold circles and nine glyph pillars with amethyst spires, a nine-sided dais of gold pegs at the centre.",
		"Four Frayed Thread and four of the Strand's block around a Void Yarn.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705EE.title: "Totem: the Sealbreaker"
	quest.42000000002705EF.quest_desc: [
		"The Sealbreaker hides behind three active wards. The dais pegs light the order once per phase — watch first. Dispel the pillars in that order with an Ars dispel or any Sigil-strand item; a wrong one re-arms all three and the ward-glass bites. Three right and it is open for twelve seconds. Later phases shuffle the runes and add a decoy.",
		"How: use the matching Frayed Totem, then win the arena. Advancement completes this."
	]
	quest.42000000002705EF.title: "Re-tension: the Sealbreaker"
	quest.42000000002705F0.quest_desc: [
		"Sealmark: magic damage taken is cut by a fifth. Sealmark wards you, or a Clowder mate you look at, against one heavy hit.",
		"One per Clowder member present at the win, straight to inventory.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705F0.title: "Relic: Sealmark"
	quest.42000000002705F1.quest_desc: [
		"The Collapsing Loom: a loom sixty-six blocks wide whose floor is the warp — plank strips that unravel into thread bridges as the heddle bars drop.",
		"Four Frayed Thread and four of the Strand's block around a Void Yarn.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705F1.title: "Totem: the Unwoven"
	quest.42000000002705F2.quest_desc: [
		"Five phases. Each quotes two of the other eight mechanics for thirty seconds, then a heddle bar drops and three more strips unravel. In its true form the last four strips remain and the warp threads are the only way up to the beam where it stands. Kill it there: the Reweave.",
		"How: use the matching Frayed Totem, then win the arena. Advancement completes this."
	]
	quest.42000000002705F2.title: "Re-tension: the Unwoven"
	quest.42000000002705F3.quest_desc: [
		"Loomthread: two more Loom Tension for your Clowder and slower decay. Loomthread tethers your Clowder to your side. It is the keystone for the true Reweave and the key to the two sealed arenas.",
		"One per Clowder member present at the win, straight to inventory.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705F3.title: "Relic: Loomthread"
	quest.42000000002705F4.quest_desc: [
		"The Dock Dustbin: a corner of the Dock itself — a plank yard, a washing line of cloth sheets, baskets of wool, a red rug.",
		"Four Frayed Thread and four wool around a Void Yarn.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705F4.title: "Totem: the Lint Golem"
	quest.42000000002705F5.quest_desc: [
		"The one fight with no risk. The golem throws lint balls that only blind for a moment and hides behind the washing; beat the rug and it sneezes and staggers. It teaches totem, arena and gate.",
		"How: use the matching Frayed Totem, then win the arena. Advancement completes this."
	]
	quest.42000000002705F5.title: "Re-tension: the Lint Golem"
	quest.42000000002705F6.quest_desc: [
		"Lintwisp: immune to cactus, berry and hedge damage and to being pushed. Puff blinds nearby mobs for an escape.",
		"One per Clowder member present at the win, straight to inventory.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705F6.title: "Relic: Lintwisp"
	quest.42000000002705F7.quest_desc: [
		"The Knotgarden: a grass island under four rings of hedge maze with gaps and spurs, cobble paths, rope-knot rings hung over them.",
		"Four Frayed Thread and four leaves around a Void Yarn.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705F7.title: "Totem: the Tangle"
	quest.42000000002705F8.quest_desc: [
		"The spider strings the paths shut behind you with rope-knots that take three hits to cut, and bites whoever is alone in a dead end. Stay together in the maze. Optional, mid-game, a cosmetic prize.",
		"How: use the matching Frayed Totem, then win the arena. Advancement completes this."
	]
	quest.42000000002705F8.title: "Re-tension: the Tangle"
	quest.42000000002705F9.quest_desc: [
		"Knotcharm: no slowdown on cobweb, soul sand, honey or powder snow, and half the slip on ice. Tangle roots the first mob it hits.",
		"One per Clowder member present at the win, straight to inventory.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705F9.title: "Relic: Knotcharm"
	quest.42000000002705FA.quest_desc: [
		"The two insane arenas wait behind a door only the Reweave opens. Their totems need the Loomthread relic on the crafting grid, and answer only a Clowder that has closed its sky. The bosses are ten to twenty times your size. Bring everyone.",
		"How: seat all nine Strands, then Reweave. Advancement fires when the sky closes."
	]
	quest.42000000002705FA.title: "The sealed door"
	quest.42000000002705FB.quest_desc: [
		"The Severance: a great obsidian shard crossed by the glowing Cut, twenty world-shards drifting around it, teal void-tears in the air.",
		"Frayed Thread and obsidian around the Loomthread relic; the relic is handed back.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705FB.title: "Totem: the First Cut"
	quest.42000000002705FC.quest_desc: [
		"A shape the Cut left on the shard, not a confession of who swung. Every twenty seconds it cuts a line across the shard and the blocks fall away for fifteen; the seam gives Speed but its beam follows the seam. Drifting shards crush, void-tears pull, and at a fifth of its health the shard splits in two along the Cut. After the Reweave only.",
		"How: use the matching Frayed Totem, then win the arena. Advancement completes this."
	]
	quest.42000000002705FC.title: "Re-tension: the First Cut"
	quest.42000000002705FD.quest_desc: [
		"Shard of the First Cut: cuts through ward phases. Best-in-pack, reserved for those who passed.",
		"One per Clowder member present at the win, straight to inventory.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705FD.title: "Relic: Firstcut Shard"
	quest.42000000002705FE.quest_desc: [
		"The Loom Above: a purpur weave, nine strand-bridges to nine pillared platforms, twenty-seven cathedral threads to a keystone sixty-four blocks up.",
		"Frayed Thread and purpur around the Loomthread relic; the relic is handed back.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.42000000002705FE.title: "Totem: the Overweaver"
	quest.42000000002705FF.quest_desc: [
		"Your own restored Loom turned against you. The Overweaver throws shades of the nine guardians onto their strands; kill a shade and its thread pulls taut for twenty-five seconds, and only then can the loom itself be hurt. Later it throws three, then all nine.",
		"How: use the matching Frayed Totem, then win the arena. Advancement completes this."
	]
	quest.42000000002705FF.title: "Re-tension: the Overweaver"
	quest.4200000000270600.quest_desc: [
		"The Overweaver's Shuttle: an echo of every Strand relic in one, and it reweaves a fallen Clowder mate.",
		"One per Clowder member present at the win, straight to inventory.",
		"How: Whisker Codex Snapped Guardians — totem, arena, relic. Totem answers on the pad."
	]
	quest.4200000000270600.title: "Relic: Overweaver Shuttle"
	quest.42000000002805E3.quest_desc: [
		"Wild pad-runners do not spawn on a void pad. Play the Gate Rite on a Gate Drum (use it empty-handed, hit the beats on A, S, D, F) and walk the March. Yellows graze the Steppe and Reed Fen. Highlands lean Great. Snow Fields hide Wonderful grades. Ember Wastes keep Flame birds.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: use the Gate Drum empty-handed and play the Gate Rite: hit the falling beats on A, S, D, F. Land 60% and it opens; no Pulse needed. Bind a return compass first."
	]
	quest.42000000002805E3.title: "Gate to the March"
	quest.42000000002805E4.quest_desc: [
		"Wild Gysahl grows in the Reed Fen, Steppe and Highlands, thickest in the Fen. Picking it drops seeds too, and March Leaf or grass broken with a hoe sheds more. Plant the seeds on farmland at home.",
		"How: pick wild gysahl in the March (Reed Fen is densest). Picking also drops seeds; plant them on farmland at home."
	]
	quest.42000000002805E4.title: "Gysahl Green"
	quest.42000000002805E5.quest_desc: [
		"A book and a gysahl leaf. Use it anywhere: its pages list each of your birds' colour, grade, class, race wins and last nut.",
		"How: a book and a gysahl. Use it anywhere; its pages list your own birds."
	]
	quest.42000000002805E5.title: "Chocobo Almanac"
	quest.42000000002805E6.quest_desc: [
		"Feed Gysahl to tame a wild yellow. Craft a saddle from leather, string and iron, then ride. Sprint dashes; ease off to recover stamina.",
		"How: leather, string and iron. Tame a wild yellow with gysahl, then saddle it."
	]
	quest.42000000002805E6.title: "Chocobo Saddle"
	quest.42000000002805E7.quest_desc: [
		"Gold nuggets around a clock, with a gysahl. It winds you to Whiskerwind and back. After you have walked the March, Esther stands at Clowder Hall too: ride a saddled bird to her, or ask the Whiskerwind Guide.",
		"How: gold nuggets around a clock, with a gysahl. Use it to wind to Whiskerwind and back; a saddled bird comes with you."
	]
	quest.42000000002805E7.title: "Chocobo Pocketwatch"
	quest.42000000002805E8.quest_desc: [
		"A lure in hand draws wild birds and outlines them across a field.",
		"How: craft the lure. Hold it to find March yellows."
	]
	quest.42000000002805E8.title: "Chocobo Lure"
	quest.42000000002805E9.quest_desc: [
		"Plant gysahl seeds on farmland. A home patch is how the farm line starts.",
		"How: picking wild gysahl drops seeds, and so do grass and March Leaf broken with a hoe. Plant on farmland."
	]
	quest.42000000002805E9.title: "Gysahl Seeds"
	quest.42000000002805EA.quest_desc: [
		"Feed a Carob Nut to two adults of opposite sex. Two Good-or-better Yellows plus Carob can hatch Green or Blue. Each parent needs five first places won in Class C; sixteen combined make the colour certain. A Great Green and a Great Blue, each with eight Class B firsts, hatch Black (White on a miss; twenty-four combined for a sure roll).",
		"How: Bilo the Nutkeeper at Whiskerwind sells Carob. Class A races also pay it out."
	]
	quest.42000000002805EA.title: "Carob Nut"
	quest.42000000002805EB.quest_desc: [
		"A mid-ladder green. Train speed, stamina, intelligence or cooperation; a bird gets sated on each kind.",
		"How: Sage Wynn at Whiskerwind."
	]
	quest.42000000002805EB.title: "Curiel Green"
	quest.42000000002805EC.quest_desc: [
		"The top training green. Move up the ladder once the bird is sated on the cheaper leaves.",
		"How: Sage Wynn at Whiskerwind, or a Class S race prize."
	]
	quest.42000000002805EC.title: "Sylkis Green"
	quest.42000000002805ED.quest_desc: [
		"Gold never hatches without Zeio. A Wonderful Black plus a Wonderful Yellow, each with ten first places won in Class A (thirty-two combined for a sure roll).",
		"How: Bilo the Nutkeeper at Whiskerwind sells Zeio. Class S races rarely pay it out."
	]
	quest.42000000002805ED.title: "Zeio Nut"
	quest.42000000002805EE.quest_desc: [
		"GP won on the course. Stalls at the Square price everything in it.",
		"How: place in the top three of a heat at Whiskerwind. Ride a saddled bird to Esther to enter."
	]
	quest.42000000002805EE.title: "GP"
	quest.42000000002805EF.quest_desc: [
		"The first mating nut. Talent follows the nut; colour follows the parents unless Carob or Zeio is involved.",
		"How: Bilo the Nutkeeper at Whiskerwind sells Pepio. A Class C win can pay it out too."
	]
	quest.42000000002805EF.title: "Pepio Nut"
	quest.42000000002805F0.quest_desc: [
		"Two gysahl and bone meal. The first step up from plain greens.",
		"How: shapeless — two gysahl and bone meal."
	]
	quest.42000000002805F0.title: "Krakka Green"
	quest.42000000002805F1.quest_desc: [
		"The next training green. Optional once the farm is running.",
		"How: Sage Wynn, or craft listed in JEI."
	]
	quest.42000000002805F1.title: "Tantal Green"
	quest.42000000002805F2.quest_desc: [
		"Another training green. Optional.",
		"How: Sage Wynn at the Square."
	]
	quest.42000000002805F2.title: "Pahsana Green"
	quest.42000000002805F3.quest_desc: [
		"Another training green. Optional.",
		"How: Sage Wynn at the Square."
	]
	quest.42000000002805F3.title: "Mimett Green"
	quest.42000000002805F4.quest_desc: [
		"Another training green. Optional.",
		"How: Sage Wynn at the Square."
	]
	quest.42000000002805F4.title: "Reagan Green"
	quest.42000000002805F5.quest_desc: [
		"A mid nut. Optional.",
		"How: Bilo the Nutkeeper at Whiskerwind sells Luchile."
	]
	quest.42000000002805F5.title: "Luchile Nut"
	quest.42000000002805F6.quest_desc: [
		"A mid nut. Optional.",
		"How: Bilo the Nutkeeper at Whiskerwind sells Saraha."
	]
	quest.42000000002805F6.title: "Saraha Nut"
	quest.42000000002805F7.quest_desc: [
		"A mid nut. Optional.",
		"How: Bilo the Nutkeeper at Whiskerwind sells Lasan."
	]
	quest.42000000002805F7.title: "Lasan Nut"
	quest.42000000002805F8.quest_desc: [
		"A mid-late mating nut. Optional. Bilo the Nutkeeper sells it.",
		"How: Bilo the Nutkeeper at Whiskerwind sells Pram."
	]
	quest.42000000002805F8.title: "Pram Nut"
	quest.42000000002805F9.quest_desc: [
		"The Fair stall at Whiskerwind sells fireworks, leads, pocketwatches and the Chocobo Almanac for GP.",
		"How: paper plus gunpowder. Optional burst."
	]
	quest.42000000002805F9.title: "Fair Fireworks"
	quest.42000000002805FA.quest_desc: [
		"A late mating nut. Optional.",
		"How: Bilo the Nutkeeper at Whiskerwind sells Porov."
	]
	quest.42000000002805FA.title: "Porov Nut"
	quest.42000000002905FB.quest_desc: [
		"The void never grew Pam's bushes. Sieve dirt with a string mesh. Break the garden for arid seeds — chili, corn, cactus fruit.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: sieve dirt with a string mesh or better (Ex Deorum or Voidloom)."
	]
	quest.42000000002905FB.title: "Arid Garden"
	quest.42000000002905FC.quest_desc: [
		"Cold crops from the same dirt. Break the bush; plant what you need.",
		"How: sieve dirt with a string mesh or better."
	]
	quest.42000000002905FC.title: "Frost Garden"
	quest.42000000002905FD.quest_desc: [
		"Under-leaf crops. Same sieve, different bush.",
		"How: sieve dirt with a string mesh or better."
	]
	quest.42000000002905FD.title: "Shaded Garden"
	quest.42000000002905FE.quest_desc: [
		"Wet crops. Rice and the rest of the fen-minded seeds live here.",
		"How: sieve dirt with a string mesh or better."
	]
	quest.42000000002905FE.title: "Soggy Garden"
	quest.42000000002905FF.quest_desc: [
		"Warm crops. Keep a bush in a chest; they still spread if you plant them.",
		"How: sieve dirt with a string mesh or better."
	]
	quest.42000000002905FF.title: "Tropical Garden"
	quest.4200000000290600.quest_desc: [
		"The last of the six. Every HarvestCraft seed on the pad starts as one of these bushes.",
		"How: sieve dirt with a string mesh or better."
	]
	quest.4200000000290600.title: "Windy Garden"
	quest.4200000000290601.quest_desc: [
		"Not the Farmer's Delight board. Copper, a stick, and a plank. Prep fruit and veg before they hit a pot.",
		"How: copper, a stick, and a plank. Not the Farmer's Delight board."
	]
	quest.4200000000290601.title: "Harvest Board"
	quest.4200000000290602.quest_desc: [
		"Soups, stews, and stock. Copper and a stick. The pot comes back after every craft.",
		"How: copper and a stick. The pot comes back after every shapeless cook."
	]
	quest.4200000000290602.title: "Harvest Pot"
	quest.4200000000290603.quest_desc: [
		"Pan meals. Copper and sticks. Different craft from the Delight skillet; JEI tells them apart.",
		"How: copper and sticks. Different from the Delight skillet."
	]
	quest.4200000000290603.title: "Harvest Skillet"
	quest.4200000000290604.quest_desc: [
		"Sauces and reductions. Copper and a stick. Keep it next to the pot.",
		"How: copper and a stick."
	]
	quest.4200000000290604.title: "Saucepan"
	quest.4200000000290605.quest_desc: [
		"Terracotta ring. Pies, breads, and anything that wants an oven shape.",
		"How: eight terracotta around an empty centre."
	]
	quest.4200000000290605.title: "Bakeware"
	quest.4200000000290606.quest_desc: [
		"Planks and a stick. Batters, doughs, salads. The quiet station.",
		"How: planks and a stick."
	]
	quest.4200000000290606.title: "Mixing Bowl"
	quest.4200000000290607.quest_desc: [
		"Terracotta. Fruit in, punch out. Pair it with a tree, not a garden.",
		"How: terracotta. Four in a T."
	]
	quest.4200000000290607.title: "Juicer"
	quest.4200000000290608.quest_desc: [
		"Sticks and a log. Flatten dough. Bakeware is waiting.",
		"How: sticks either side of a log."
	]
	quest.4200000000290608.title: "Rolling Pin"
	quest.4200000000290609.quest_desc: [
		"Andesite pebbles from a flint sieve, then a stick. Flour, spices, pastes.",
		"How: andesite (flint-sieve dirt or gravel pebbles) and a stick."
	]
	quest.4200000000290609.title: "Grinder"
	quest.420000000029060A.quest_desc: [
		"A water bucket split into eight. Most recipes want this, not a vanilla bucket.",
		"How: one water bucket → eight freshwater."
	]
	quest.420000000029060A.title: "Fresh Water"
	quest.420000000029060B.quest_desc: [
		"No cows on the pad. Coconut (iron-mesh dirt) plus freshwater, or split a milk bucket later.",
		"How: coconut (iron-mesh dirt) plus freshwater, or split a milk bucket."
	]
	quest.420000000029060B.title: "Fresh Milk"
	quest.420000000029060C.quest_desc: [
		"Water in a pot, or a grind. Almost every savoury recipe asks.",
		"How: pot plus water or freshwater. The pot comes back."
	]
	quest.420000000029060C.title: "Salt"
	quest.420000000029060D.quest_desc: [
		"Wheat through the grinder. Dough starts here.",
		"How: grinder plus wheat (or another flour plant). The grinder comes back."
	]
	quest.420000000029060D.title: "Flour"
	quest.420000000029060E.quest_desc: [
		"Flour, salt, and fresh water. Pies and breads share this lump.",
		"How: mixing bowl, flour, water, salt."
	]
	quest.420000000029060E.title: "Dough"
	quest.420000000029060F.quest_desc: [
		"Bones or veg in the pot. Soups want a bottle of this, not a vague broth.",
		"How: pot plus a bone (Pad-keepers sell bones) or leftover veg."
	]
	quest.420000000029060F.title: "Stock"
	quest.4200000000290610.quest_desc: [
		"Iron-mesh dirt. Grow it on the pad; vanilla oak will not drop Pam's apples.",
		"How: sieve dirt with an iron mesh for kitchen saplings, then grow the fruit."
	]
	quest.4200000000290610.title: "Apple Tree"
	quest.4200000000290611.quest_desc: [
		"Acid for dressings and fish. Same iron sieve.",
		"How: sieve dirt with an iron mesh for kitchen saplings, then grow the fruit."
	]
	quest.4200000000290611.title: "Lemon Tree"
	quest.4200000000290612.quest_desc: [
		"Bark spice. Bakes and teas.",
		"How: sieve dirt with an iron mesh for kitchen saplings, then grow the fruit."
	]
	quest.4200000000290612.title: "Cinnamon Tree"
	quest.4200000000290613.quest_desc: [
		"Milk, oil, and tropical cooking.",
		"How: sieve dirt with an iron mesh for kitchen saplings, then grow the fruit."
	]
	quest.4200000000290613.title: "Coconut Palm"
	quest.4200000000290614.quest_desc: [
		"Beans for sweets. Plant it like the others.",
		"How: sieve dirt with an iron mesh for kitchen saplings, then grow the fruit."
	]
	quest.4200000000290614.title: "Vanilla Vine"
	quest.4200000000290615.quest_desc: [
		"Pam's apple tree bears plain apples, far more than oak leaves drop. Juicer and bakeware both want these.",
		"How: oak leaves drop a few; a Pam's apple tree (sapling from iron-mesh dirt) bears many."
	]
	quest.4200000000290615.title: "Pam's Apple"
	quest.4200000000290616.quest_desc: [
		"Bakeware, dough, sugar, apples. The first finished HarvestCraft bake.",
		"How: bakeware, dough, sugar, Pam's apples from the apple tree."
	]
	quest.4200000000290616.title: "Apple Pie (Harvest)"
	quest.4200000000290617.quest_desc: [
		"Juicer plus mixed fruit. A pad drink that is not melon juice.",
		"How: juicer plus mixed fruit."
	]
	quest.4200000000290617.title: "Fruit Punch"
	quest.4200000000290618.quest_desc: [
		"Skillet, bread, cheese. Fast lunch while the trees grow.",
		"How: skillet, bread, butter, and cheese — all from freshwater, coconut milk, and flour."
	]
	quest.4200000000290618.title: "Grilled Cheese"
	quest.4200000000290619.quest_desc: [
		"Arid peppers, tomato, onion, bean, spiceleaf, and meat or silken-tofu. Food Extended starts earning its keep.",
		"How: pot, arid chili, tomato, onion, bean, spiceleaf, and meat or silken tofu."
	]
	quest.4200000000290619.title: "Chili Bowl"
	quest.420000000029061A.quest_desc: [
		"Spices from the grinder, veg from the gardens, pot work.",
		"How: saucepan, rice, coconut, chili, black pepper, curry powder (spiceleaf + mustard + cinnamon)."
	]
	quest.420000000029061A.title: "Curry Plate"
	quest.420000000029061B.quest_desc: [
		"Dough, sauce, meat. Bakeware. A full HarvestCraft meal.",
		"How: bakeware, dough, tomato, cheese, pepperoni (pork or tofu bacon from maple + soy)."
	]
	quest.420000000029061B.title: "Pepperoni Pizza"
	quest.420000000029061C.quest_desc: [
		"Soggy-garden rice, carrot, onion, peas, and an egg — silken tofu stands in until chickens exist.",
		"How: skillet, soggy-garden rice, carrot, onion, peas, and an egg — silken tofu counts as egg."
	]
	quest.420000000029061C.title: "Garden Fried Rice"
	quest.420000000029061D.quest_desc: [
		"Tea leaf and spiceleaf in the pot. Shaded and soggy gardens cover both.",
		"How: pot, tea leaf, and spiceleaf. Shaded garden drops both tea and spice."
	]
	quest.420000000029061D.title: "Green Tea"
	quest.420000000029061E.quest_desc: [
		"Oil and savoury fruit. Optional iron-mesh catch.",
		"How: sieve dirt with an iron mesh for kitchen saplings, then grow the fruit."
	]
	quest.420000000029061E.title: "Olive Tree"
	quest.420000000029061F.quest_desc: [
		"Juice and zest. Optional.",
		"How: sieve dirt with an iron mesh for kitchen saplings, then grow the fruit."
	]
	quest.420000000029061F.title: "Orange Tree"
	quest.4200000000290620.quest_desc: [
		"Summer fruit. Optional.",
		"How: sieve dirt with an iron mesh for kitchen saplings, then grow the fruit."
	]
	quest.4200000000290620.title: "Peach Tree"
	quest.4200000000290621.quest_desc: [
		"Pepper for the grinder. Optional.",
		"How: sieve dirt with an iron mesh for kitchen saplings, then grow the fruit."
	]
	quest.4200000000290621.title: "Peppercorn Tree"
	quest.4200000000290622.quest_desc: [
		"Fryer fat. Optional staple.",
		"How: press seeds or olives in JEI. Optional staple."
	]
	quest.4200000000290622.title: "Cooking Oil"
	quest.4200000000290623.quest_desc: [
		"Milk and salt. Optional staple.",
		"How: pot plus milk (coconut freshwater milk works)."
	]
	quest.4200000000290623.title: "Butter"
	quest.4200000000290624.quest_desc: [
		"An egg through the juicer. Optional.",
		"How: juicer and an egg (silken tofu counts). Optional."
	]
	quest.4200000000290624.title: "Mayonnaise"
	quest.4200000000290625.quest_desc: [
		"Cutting board, mixed fruit. Optional.",
		"How: cutting board and mixed fruit. Optional."
	]
	quest.4200000000290625.title: "Fruit Salad"
	quest.4200000000290626.quest_desc: [
		"Pasta night. Optional.",
		"How: gardens and fruit trees supply the ingredients. Soy tofu stands in for meat and egg. JEI names the station."
	]
	quest.4200000000290626.title: "Spaghetti Dinner"
	quest.4200000000290627.quest_desc: [
		"Breakfast flex. Optional.",
		"How: gardens and fruit trees supply the ingredients. Soy tofu stands in for meat and egg. JEI names the station."
	]
	quest.4200000000290627.title: "Bacon Pancakes"
	quest.4200000000290628.quest_desc: [
		"Iron-mesh dirt for an avocado sapling, then skillet, toast, salt, garlic, spiceleaf.",
		"How: iron-mesh avocado sapling, then skillet with toast, salt, garlic, spiceleaf."
	]
	quest.4200000000290628.title: "Avocado Toast"
	quest.4200000000290629.quest_desc: [
		"Not the Delight hamburger. Optional.",
		"How: gardens and fruit trees supply the ingredients. Soy tofu stands in for meat and egg. JEI names the station."
	]
	quest.4200000000290629.title: "Onion Burger"
	quest.420000000029062A.quest_desc: [
		"Juicer, apples. Optional.",
		"How: juicer and Pam's apples. Optional."
	]
	quest.420000000029062A.title: "Apple Juice"
	quest.420000000029062B.quest_desc: [
		"Skillet, bread and butter. Optional.",
		"How: skillet, bread and butter. Optional."
	]
	quest.420000000029062B.title: "Toast Slice"
	quest.42000000002A062C.quest_desc: [
		"Four sticks in a square. Place them on farmland. Vanilla seeds convert when you plant — Mystical Agriculture seeds do not.",
		"Put a second set of sticks into the same block to make a cross crop — an empty pair that takes after whatever is mature beside it. Ring it with parents on all four sides and it seeds itself in a few minutes; bone meal on the cross forces an attempt straight away.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: four sticks in a square. Place on farmland, then plant a seed."
	]
	quest.42000000002A062C.title: "Wooden Crop Sticks"
	quest.42000000002A062D.quest_desc: [
		"A writable book (book, ink sac, feather) plus wheat seeds. Keep it in the analyzer.",
		"How: writable book (book, ink sac, feather) plus wheat seeds. Charcoal plus a glass bottle makes the ink."
	]
	quest.42000000002A062D.title: "Crop Journal"
	quest.42000000002A062E.quest_desc: [
		"Glass pane and sticks. Look at a crop to read growth, gain, and strength without picking it.",
		"How: glass pane between sticks, then a stick handle. Look at a planted crop."
	]
	quest.42000000002A062E.title: "Magnifying Glass"
	quest.42000000002A062F.quest_desc: [
		"Glass, stone slab, planks, sticks. Put a seed in with the journal. Breeding becomes visible.",
		"Fertility is the stat that drives crossing: a fresh seed sits at 1 of 10, and every point raises the chance a plant is picked as a parent. Analyse, replant the best, and the crosses come faster.",
		"How: glass panes, stone slab, planks, and sticks. Seat the journal, then a seed."
	]
	quest.42000000002A062F.title: "Seed Analyzer"
	quest.42000000002A0630.quest_desc: [
		"Weeds are off on this pack, but the rake still clears a stick. Carry one anyway.",
		"How: wooden fence over a stick. Weeds are off; it still clears a stick."
	]
	quest.42000000002A0630.title: "Wooden Rake"
	quest.42000000002A0631.quest_desc: [
		"Pick a plant up and put it down with its stats intact. Move a 10-10 without breaking it.",
		"How: two iron ingots and a stick. Pick a plant up with its stats intact."
	]
	quest.42000000002A0631.title: "Trowel"
	quest.42000000002A0632.quest_desc: [
		"Clip a mature plant for its clipping product and reset it. Flowers and some HarvestCraft crops.",
		"How: shears, iron, and a stick. Clip a mature plant and reset it."
	]
	quest.42000000002A0632.title: "Clipper"
	quest.42000000002A0633.quest_desc: [
		"Carry a breeding line. Fill it from the analyzer, empty it onto sticks.",
		"How: leather and string. Fill from the analyzer."
	]
	quest.42000000002A0633.title: "Seed Bag"
	quest.42000000002A0634.quest_desc: [
		"Sturdier sticks. Same planting rules, less fuss when you bump them.",
		"How: two iron nuggets in a column make eight."
	]
	quest.42000000002A0634.title: "Iron Crop Sticks"
	quest.42000000002A0635.quest_desc: [
		"The better rake. Still a habit, even with weeds gone.",
		"How: iron bars over a stick."
	]
	quest.42000000002A0635.title: "Iron Rake"
	quest.42000000002A0636.quest_desc: [
		"Hold water for the channels. A pad farm that does not carry buckets every morning.",
		"How: planks. Hold water for the channels."
	]
	quest.42000000002A0636.title: "Irrigation Tank"
	quest.42000000002A0637.quest_desc: [
		"Run water from the tank along the row. Crops drink from the channel, not from you.",
		"How: shapeless from a tank — one tank becomes eight channels."
	]
	quest.42000000002A0637.title: "Irrigation Channel"
	quest.42000000002A0638.quest_desc: [
		"Stop and start a line without breaking the tank.",
		"How: iron bars, red dye and an iron ingot. Stop and start a line without breaking the tank."
	]
	quest.42000000002A0638.title: "Channel Valve"
	quest.42000000002A0639.quest_desc: [
		"Rain in a square. Sit it on a channel over the sticks.",
		"How: sit it on a channel over the sticks. JEI names the craft."
	]
	quest.42000000002A0639.title: "Sprinkler"
	quest.42000000002A063A.quest_desc: [
		"Cover a channel so you can walk the row.",
		"How: cover a channel so you can walk the row."
	]
	quest.42000000002A063A.title: "Channel Grate"
	quest.42000000002A063B.quest_desc: [
		"Read the room. Light, humidity, the reason a crop stalled.",
		"How: craft, then place in the room to read light and humidity."
	]
	quest.42000000002A063B.title: "Greenhouse Monitor"
	quest.42000000002A063C.quest_desc: [
		"Late sticks. Fireproof, stubborn, for the plants that ask too much of wood. Two neighbouring mature crops can cross-breed.",
		"How: two obsidian in a column make eight. Two neighbouring mature crops can cross-breed."
	]
	quest.42000000002A063C.title: "Obsidian Crop Sticks"
	quest.42000000002A063D.quest_desc: [
		"A channel you can walk. Optional.",
		"How: a channel you can walk. Optional."
	]
	quest.42000000002A063D.title: "Hollow Channel"
	quest.42000000002A063E.quest_desc: [
		"Ore crops drop these. Optional breeding line.",
		"How: wooden crop sticks from sticks; journal is a writable book plus seeds; analyzer is glass and wood. Plant on farmland."
	]
	quest.42000000002A063E.title: "Copper Nugget Crop"
	quest.42000000002A063F.quest_desc: [
		"Quartz from a stick. Optional.",
		"How: wooden crop sticks from sticks; journal is a writable book plus seeds; analyzer is glass and wood. Plant on farmland."
	]
