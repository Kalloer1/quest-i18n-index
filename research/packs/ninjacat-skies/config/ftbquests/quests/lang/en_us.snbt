	quest.4200000000060130.title: "Display Link"
	quest.4200000000060131.quest_desc: [
		"Display board shows data.",
		"How: Create craft in JEI (crafting table, press, mixer or deployer). Andesite alloy and a water wheel start the line."
	]
	quest.4200000000060131.title: "Display Board"
	quest.4200000000060132.quest_desc: [
		"Fires a potato hard enough to knock something back. Mostly for laughs.",
		"How: Create craft in JEI (crafting table, press, mixer or deployer). Andesite alloy and a water wheel start the line."
	]
	quest.4200000000060132.title: "Potato Cannon"
	quest.4200000000060133.quest_desc: [
		"Reaches and breaks blocks from further away than your arm allows.",
		"How: Create craft in JEI (crafting table, press, mixer or deployer). Andesite alloy and a water wheel start the line."
	]
	quest.4200000000060133.title: "Extendo Grip"
	quest.4200000000060134.quest_desc: [
		"A wheel, a press, a mixer, a fan, a clockwork heart.",
		"Tension the Strand: the Pattern-weavers answer.",
		"Claim it and choose one gift from the tribe: a Thread of Return for one more shared life, or supplies.",
		"How: finish the quests linked to this one, then claim it for the Strand token. Seat the token at your Tension Post."
	]
	quest.4200000000060134.quest_subtitle: "Pattern"
	quest.4200000000060134.title: "Clock Knot"
	quest.4200000000060135.quest_desc: [
		"Right-click your Clowder's Tension Post with the token.",
		"The notch lights, the tribe chimes, the pad changes.",
		"Rare reward: one shared Clowder life, once for the entire team. Only six such rewards exist in the campaign.",
		"How: right-click your Tension Post with the Strand token in hand."
	]
	quest.4200000000060135.title: "Seat Clock"
	quest.4200000000060136.quest_desc: [
		"Twenty skeletons. The pattern holds if you keep the lights on.",
		"How: kill twenty skeletons. Keep the pad lit."
	]
	quest.4200000000060136.title: "Rattle in the Gears"
	quest.4200000000070137.quest_desc: [
		"Place the oak nest on the pad and right-click it with a small flower. Wait. Something with wings will come out of the wood.",
		"Look at it. That counts.",
		"How: right-click the oak nest with a small flower, then look at the first bee that comes out."
	]
	quest.4200000000070137.quest_subtitle: "Colony"
	quest.4200000000070137.title: "First Wings"
	quest.4200000000070138.quest_desc: [
		"Eight oak logs around a small flower. Place it and wake it with another flower; the wood remembers wings.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: ring of the nest material around a small flower. Place it, then right-click it with a small flower to wake it; bees come out after a while."
	]
	quest.4200000000070138.title: "Ring of Oak"
	quest.4200000000070139.quest_desc: [
		"Bone meal on grass. Bees will not stay where nothing blooms.",
		"How: bone-meal grass. Bees want any small flower."
	]
	quest.4200000000070139.title: "A Flower to Argue Over"
	quest.420000000007013A.quest_desc: [
		"Planks and flowers — a home a wild bee will move into.",
		"How: three small flowers between two rows of planks. Swarm names the nest."
	]
	quest.420000000007013A.title: "Bee Nest"
	quest.420000000007013B.quest_desc: [
		"Colonies in the wind. The Colony-keepers' stall at /clowder hub sells comb if none drift by.",
		"How: shear a nest or hive after bees work a flower. The Colony-keepers' stall at /clowder hub sells eight for 16 Thread."
	]
	quest.420000000007013B.title: "Honeycomb"
	quest.420000000007013C.quest_desc: [
		"A home for workers.",
		"How: three honeycomb and six planks. Campfire underneath calms them."
	]
	quest.420000000007013C.title: "Beehive"
	quest.420000000007013D.quest_desc: [
		"Sweet, sticky, and worth more to a furnace than to your stomach.",
		"How: glass bottle on a full hive. Campfire underneath."
	]
	quest.420000000007013D.title: "Honey Bottle (Swarm)"
	quest.420000000007013E.quest_desc: [
		"A snack that calms an agitated bee before you reach into the hive.",
		"How: honeycomb plus a honey bottle, shapeless."
	]
	quest.420000000007013E.title: "Honey Treat"
	quest.420000000007013F.quest_desc: [
		"Gravel around a flower. Mining bees and diggers like the dust.",
		"How: ring of the nest material around a small flower. Place it, then right-click it with a small flower to wake it; bees come out after a while."
	]
	quest.420000000007013F.title: "Ring of Grit"
	quest.4200000000070140.quest_desc: [
		"Coarse dirt around a flower. Leafcutters and ashy miners.",
		"How: ring of the nest material around a small flower. Place it, then right-click it with a small flower to wake it; bees come out after a while."
	]
	quest.4200000000070140.title: "Ring of Coarse Dirt"
	quest.4200000000070141.quest_desc: [
		"Stone around a flower. Mason bees, and diggers that eat rock.",
		"How: ring of the nest material around a small flower. Place it, then right-click it with a small flower to wake it; bees come out after a while."
	]
	quest.4200000000070141.title: "Ring of Stone"
	quest.4200000000070142.quest_desc: [
		"A productive home.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.4200000000070142.title: "Advanced Beehive"
	quest.4200000000070143.quest_desc: [
		"Gives a hive more room before it swarms looking for a new one.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.4200000000070143.title: "Expansion Box"
	quest.4200000000070144.quest_desc: [
		"Bottles the yield without a hand on it.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.4200000000070144.title: "Bottler"
	quest.4200000000070145.quest_desc: [
		"Spin combs into everything they hide.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.4200000000070145.title: "Centrifuge"
	quest.4200000000070146.quest_desc: [
		"The same, faster, on power.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.4200000000070146.title: "Powered Centrifuge"
	quest.4200000000070147.quest_desc: [
		"Nets a bee out of the air without a single sting.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.4200000000070147.title: "Catcher"
	quest.4200000000070148.quest_desc: [
		"Carry a bee like a lantern.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.4200000000070148.title: "Bee Cage"
	quest.4200000000070149.quest_desc: [
		"Hatch the genes you want.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.4200000000070149.title: "Incubator"
	quest.420000000007014A.quest_desc: [
		"Pair two colonies on purpose.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.420000000007014A.title: "Breeding Chamber"
	quest.420000000007014B.quest_desc: [
		"Sort traits like seed.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.420000000007014B.title: "Gene Indexer"
	quest.420000000007014C.quest_desc: [
		"A stack of treats: the colony's payroll.",
		"How: honeycomb plus a honey bottle, shapeless."
	]
	quest.420000000007014C.title: "Feed Upgrade"
	quest.420000000007014D.quest_desc: [
		"One of the deeper essence crops, grown far past the basics.",
		"How: Mystical Agriculture craft in JEI. Inferium and Prosperity come from the sieve; seeds are infused on the Infusion Altar."
	]
	quest.420000000007014D.title: "Diamond Seeds"
	quest.420000000007014E.quest_desc: [
		"A farm plot that yields dust instead of digging for it.",
		"How: Mystical Agriculture craft in JEI. Inferium and Prosperity come from the sieve; seeds are infused on the Infusion Altar."
	]
	quest.420000000007014E.title: "Redstone Seeds"
	quest.420000000007014F.quest_desc: [
		"Grows the blue essence enchanting tables are always hungry for.",
		"How: Mystical Agriculture craft in JEI. Inferium and Prosperity come from the sieve; seeds are infused on the Infusion Altar."
	]
	quest.420000000007014F.title: "Lapis Seeds"
	quest.4200000000070150.quest_desc: [
		"Quartz grown on a crop instead of dug from Nether caves.",
		"How: Mystical Agriculture craft in JEI. Inferium and Prosperity come from the sieve; seeds are infused on the Infusion Altar."
	]
	quest.4200000000070150.title: "Nether Quartz Seeds"
	quest.4200000000070151.quest_desc: [
		"A softer way to farm light than mining the Nether ceiling.",
		"How: Mystical Agriculture craft in JEI. Inferium and Prosperity come from the sieve; seeds are infused on the Infusion Altar."
	]
	quest.4200000000070151.title: "Glowstone Seeds"
	quest.4200000000070152.quest_desc: [
		"A hardened crop that yields obsidian essence without a lava bucket in sight.",
		"How: Mystical Agriculture craft in JEI. Inferium and Prosperity come from the sieve; seeds are infused on the Infusion Altar."
	]
	quest.4200000000070152.title: "Obsidian Seeds"
	quest.4200000000070153.quest_desc: [
		"High essence. The fields are industry now.",
		"How: Mystical Agriculture craft in JEI. Inferium and Prosperity come from the sieve; seeds are infused on the Infusion Altar."
	]
	quest.4200000000070153.title: "Imperium"
	quest.4200000000070154.quest_desc: [
		"The last essence tier. Whatever you're building, this is the good version.",
		"How: Mystical Agriculture craft in JEI. Inferium and Prosperity come from the sieve; seeds are infused on the Infusion Altar."
	]
	quest.4200000000070154.title: "Supremium"
	quest.4200000000070155.quest_desc: [
		"Swarm surplus, stacked.",
		"How: four honey bottles. Bottles return."
	]
	quest.4200000000070155.title: "Honey Block"
	quest.4200000000070156.quest_desc: [
		"A bee that did not exist before you built the nest.",
		"Mining, mason, digger, carpenter — look at one.",
		"How: look at a Productive Bee after a nest wakes. First Wings is the oak nest."
	]
	quest.4200000000070156.quest_subtitle: "Colony"
	quest.4200000000070156.title: "Something New Hums"
	quest.4200000000070157.quest_desc: [
		"Sand around a flower. Ashy and chocolate miners.",
		"How: ring of the nest material around a small flower. Place it, then right-click it with a small flower to wake it; bees come out after a while."
	]
	quest.4200000000070157.title: "Ring of Sand"
	quest.4200000000070158.quest_desc: [
		"Sugar cane around a flower. Reed bees and masons.",
		"How: ring of the nest material around a small flower. Place it, then right-click it with a small flower to wake it; bees come out after a while."
	]
	quest.4200000000070158.title: "Ring of Reed"
	quest.4200000000070159.quest_desc: [
		"Slime blocks around a flower. Guess.",
		"How: ring of the nest material around a small flower. Place it, then right-click it with a small flower to wake it; bees come out after a while."
	]
	quest.4200000000070159.title: "Ring of Slime"
	quest.420000000007015A.quest_desc: [
		"Hay around a flower. Bumble bees, and plain bees too.",
		"How: ring of the nest material around a small flower. Place it, then right-click it with a small flower to wake it; bees come out after a while."
	]
	quest.420000000007015A.title: "Ring of Hay"
	quest.420000000007015B.quest_desc: [
		"Snow around a flower. Sweat bees, oddly.",
		"How: ring of the nest material around a small flower. Place it, then right-click it with a small flower to wake it; bees come out after a while."
	]
	quest.420000000007015B.title: "Ring of Snow"
	quest.420000000007015C.quest_desc: [
		"Burns honey for power. A hive doing double duty.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.420000000007015C.title: "Honey Generator"
	quest.420000000007015D.quest_desc: [
		"Holds one bee on display, wings and all, without a hive attached.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.420000000007015D.title: "Jar"
	quest.420000000007015E.quest_desc: [
		"Calms a hive full of bees before you go digging for honeycomb.",
		"How: logs, sticks, and coal or charcoal."
	]
	quest.420000000007015E.title: "Campfire (Swarm)"
	quest.420000000007015F.quest_desc: [
		"Feeds bees and blooms twice a year, evergreen the rest of the time.",
		"How: moss plus oak, or bone-meal moss. Bees accept the bloom."
	]
	quest.420000000007015F.title: "Flowering Azalea (Swarm)"
	quest.4200000000070160.quest_desc: [
		"Tall, yellow, and always facing the sun. Bees find it easily.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000070160.title: "Sunflower"
	quest.4200000000070161.quest_desc: [
		"Two blocks of purple bloom that bees will cross a pad to reach.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000070161.title: "Lilac"
	quest.4200000000070162.quest_desc: [
		"A tall flower bees favor, and one more color for the garden.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000070162.title: "Rose Bush"
	quest.4200000000070163.quest_desc: [
		"Pink and full, planted wherever a hive needs more forage nearby.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000070163.title: "Peony"
	quest.4200000000070164.quest_desc: [
		"A short, single flower, but bees don't care about height.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000070164.title: "Orange Tulip"
	quest.4200000000070165.quest_desc: [
		"A nest you built, a hive you moved, a centrifuge, an incubator, essence fields.",
		"Tension the Strand: the Colony-keepers answer.",
		"Claim it and choose one gift from the tribe: a Thread of Return for one more shared life, or supplies.",
		"How: finish the quests linked to this one, then claim it for the Strand token. Seat the token at your Tension Post."
	]
	quest.4200000000070165.quest_subtitle: "Colony"
	quest.4200000000070165.title: "Swarm Knot"
	quest.4200000000070166.quest_desc: [
		"Right-click your Clowder's Tension Post with the token.",
		"The notch lights, the tribe chimes, the pad changes.",
		"How: right-click your Tension Post with the Strand token in hand."
	]
	quest.4200000000070166.title: "Seat Swarm"
	quest.4200000000070167.quest_desc: [
		"You killed a bee.",
		"The Colony-keepers would like a word. Here is a bottle; think about it.",
		"How: kill a bee (hidden). The bottle is the lesson."
	]
	quest.4200000000070167.title: "Regret"
	quest.4200000000080168.quest_desc: [
		"The stewards left tricks in crystal. Thirty-two shards.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: sieve, or budding amethyst if you grow a geode line. Occultism wants shards."
	]
	quest.4200000000080168.title: "Amethyst"
	quest.4200000000080169.quest_desc: [
		"Right-click the Tension Post holding 16 Strand Filaments. No Strand has to be seated.",
		"Bind begins here.",
		"How: right-click the Tension Post holding 16 Strand Filaments. Sieve gravel or sand with an iron Thread Mesh to find them."
	]
	quest.4200000000080169.title: "Braid Cord"
	quest.420000000008016A.quest_desc: [
		"Write the rite before you carve it.",
		"How: book, ink sac, feather. Charcoal plus a glass bottle makes the ink."
	]
	quest.420000000008016A.title: "Book and Quill"
	quest.420000000008016B.quest_desc: [
		"Soft power for hard tools.",
		"How: two diamonds, four obsidian, book. Diamonds from iron-mesh gravel."
	]
	quest.420000000008016B.title: "Enchanting Table (Sigil)"
	quest.420000000008016C.quest_desc: [
		"Fuel the table.",
		"How: nine lapis. Sieve gravel or Echo Shatter lapis ore."
	]
	quest.420000000008016C.title: "Lapis Block"
	quest.420000000008016D.quest_desc: [
		"Surrounds an enchanting table to unlock its strongest enchantments.",
		"How: six planks and three books. Books are paper plus leather."
	]
	quest.420000000008016D.title: "Bookshelf"
	quest.420000000008016E.quest_desc: [
		"Heals deeply and grants a shine that fades after a minute.",
		"How: eight gold around an apple. Not the enchanted one."
	]
	quest.420000000008016E.title: "Golden Apple"
	quest.420000000008016F.quest_desc: [
		"Skip the drop.",
		"How: endermen, or /clowder hub Edge-walkers' stall."
	]
	quest.420000000008016F.title: "Ender Pearl"
	quest.4200000000080170.quest_desc: [
		"Turns water bottles into something with an actual effect.",
		"How: blaze rod over three cobble. The rod is a Nether fortress after Claw obsidian."
	]
	quest.4200000000080170.title: "Brewing Stand"
	quest.4200000000080171.quest_desc: [
		"Heat for potions.",
		"How: craft from a blaze rod, or a fortress after Claw obsidian."
	]
	quest.4200000000080171.title: "Blaze Powder"
	quest.4200000000080172.quest_desc: [
		"Fuels the brewing stand and proves you've already faced the Nether.",
		"How: Nether fortress after Claw obsidian. Brewing wants a rod; Ars and Occultism do not wait on it."
	]
	quest.4200000000080172.title: "Blaze Rod"
	quest.4200000000080173.quest_desc: [
		"Twists a potion's effect into something worse, on purpose.",
		"How: spider eye, brown mushroom, sugar."
	]
	quest.4200000000080173.title: "Fermented Eye"
	quest.4200000000080174.quest_desc: [
		"Glowstone dust for recipes.",
		"How: sieve soul sand, or witches on the pad."
	]
	quest.4200000000080174.title: "Glowstone Dust (Sigil)"
	quest.4200000000080175.quest_desc: [
		"Breath of the thing that guards the End.",
		"How: glass bottle on the dragon. The End island is gone. Optional."
	]
	quest.4200000000080175.title: "Dragon Breath"
	quest.4200000000080176.quest_desc: [
		"One more chance.",
		"Optional — no raids reach the pad, and the pack does not craft one.",
		"How: quest rewards only. Seat Clock and Seat Sigil give one each, and the late Strand Knot gifts offer more. Raids and evokers never come to the pad. Optional."
	]
	quest.4200000000080176.title: "Totem"
	quest.4200000000080177.quest_desc: [
		"Stores Source, the fuel spells burn through.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.4200000000080177.title: "Source Gem"
	quest.4200000000080178.quest_desc: [
		"Grown, not found. Wood for casting tools and spell pedestals.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.4200000000080178.title: "Archwood"
	quest.4200000000080179.quest_desc: [
		"First spells. Peer magic, if you want it beside the rites.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.4200000000080179.title: "Novice Spell Book"
	quest.420000000008017A.quest_desc: [
		"An arcane crop, grown for its cloth as much as its magic.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.420000000008017A.title: "Mage Bloom"
	quest.420000000008017B.quest_desc: [
		"Brazier for ritual work.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.420000000008017B.title: "Ritual Brazier"
	quest.420000000008017C.quest_desc: [
		"Displays a reagent and feeds it into whatever ritual needs it.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.420000000008017C.title: "Arcane Pedestal"
	quest.420000000008017D.quest_desc: [
		"Scribe spells and pages.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.420000000008017D.title: "Scribes Table"
	quest.420000000008017E.quest_desc: [
		"Imbue reagents with source.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.420000000008017E.title: "Imbuement Chamber"
	quest.420000000008017F.quest_desc: [
		"Stores extra Source so a spell never runs dry mid-cast.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.420000000008017F.title: "Source Jar"
	quest.4200000000080180.quest_desc: [
		"Call spirits by their names.",
		"How: a book and Demon's Dream Seeds, shapeless. Read it; Spirit Fire is next."
	]
	quest.4200000000080180.title: "Occultism Dictionary"
	quest.4200000000080181.quest_desc: [
		"A cold flame used in rituals that regular fire won't finish.",
		"How: light Spirit Fire as the Dictionary of Spirits shows (It burns!), then drop andesite into it."
	]
	quest.4200000000080181.title: "Spirit Fire"
	quest.4200000000080182.quest_desc: [
		"A focus for summoning. The rites are patient.",
		"How: gold around a sacrificial bowl. Dictionary names the ritual."
	]
	quest.4200000000080182.title: "Golden Sacrificial Bowl"
	quest.4200000000080183.quest_desc: [
		"The heart of aura-based crafting, tuned to the land around it.",
		"How: Ritual of the Forest (JEI): three stone, a Gold Leaf, a gold ingot and a Token of Joy. Heart of the Aura line."
	]
	quest.4200000000080183.title: "Natural Altar"
	quest.4200000000080184.quest_desc: [
		"A plant infused by high aura, spun into something rarer.",
		"How: four leaves and four gold nuggets around short grass make four Brilliant Fiber. Place it in the crown of a tree; its leaves turn golden with time."
	]
	quest.4200000000080184.title: "Brilliant Fiber"
	quest.4200000000080185.quest_desc: [
		"Aura-touched material, more valuable than it looks lying on the ground.",
		"How: break golden leaves grown from Brilliant Fiber."
	]
	quest.4200000000080185.title: "Gold Leaf"
	quest.4200000000080186.quest_desc: [
		"Iron that's soaked up ambient aura until it's worth more than the ore.",
		"How: Brilliant Fiber on trees → Gold Leaf → Natural Altar. Aura chapter names tokens and generators."
	]
	quest.4200000000080186.title: "Infused Iron"
	quest.4200000000080187.quest_desc: [
		"Lets you see the aura level of the land around you.",
		"How: gold leaf + spider eye. Shows local aura."
	]
	quest.4200000000080187.title: "Eye"
	quest.4200000000080188.quest_desc: [
		"A token of joy. The Natural Altar and Herbivorous Absorber are built on one.",
		"How: Brilliant Fiber on trees → Gold Leaf → Natural Altar. Aura chapter names tokens and generators."
	]
	quest.4200000000080188.title: "Token of Joy"
	quest.4200000000080189.quest_desc: [
		"Spell parchment stock.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.4200000000080189.title: "Spell Parchment"
	quest.420000000008018A.quest_desc: [
		"Marks a spot to return to with a word, not a walk.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.420000000008018A.title: "Warp Scroll"
	quest.420000000008018B.quest_desc: [
		"Plant it, tend it, and harvest cloth soaked in low magic.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.420000000008018B.title: "Magebloom Crop"
	quest.420000000008018C.quest_desc: [
		"The empty page a spell gets written onto.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.420000000008018C.title: "Blank Glyph"
	quest.420000000008018D.quest_desc: [
		"Casts combat spells without ever touching a wand.",
		"How: three chains, four leather and two paper. Spells chapter names ink."
	]
	quest.420000000008018D.title: "Iron's Spell Book"
	quest.420000000008018E.quest_desc: [
		"The fuel spellcasters burn through, spell after spell.",
		"How: kill casters or craft listed in JEI. Fuel for ink and books."
	]
	quest.420000000008018E.title: "Arcane Essence"
	quest.420000000008018F.quest_desc: [
		"Inscribes a spell onto a book, one tier at a time.",
		"How: bottle + essence + dye. First inscription ink."
	]
	quest.420000000008018F.title: "Ink Common"
	quest.4200000000080190.quest_desc: [
		"Color for rites.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000080190.title: "Mystical Flower"
	quest.4200000000080191.quest_desc: [
		"Deep dark echo.",
		"Optional — the void may never offer one.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000080191.title: "Echo Shard"
	quest.4200000000080192.quest_desc: [
		"A braid spun, potions bottled, spells and spirits called.",
		"Tension the Strand: the Seal-carvers answer.",
		"Claim it and choose one gift from the tribe: a Thread of Return for one more shared life, or supplies.",
		"How: finish the quests linked to this one, then claim it for the Strand token. Seat the token at your Tension Post."
	]
	quest.4200000000080192.quest_subtitle: "Bind"
	quest.4200000000080192.title: "Sigil Knot"
	quest.4200000000080193.quest_desc: [
		"Right-click your Clowder's Tension Post with the token.",
		"The notch lights, the tribe chimes, the pad changes.",
		"Rare reward: one shared Clowder life, once for the entire team. Only six such rewards exist in the campaign.",
		"How: right-click your Tension Post with the Strand token in hand."
	]
	quest.4200000000080193.title: "Seat Sigil"
	quest.4200000000080194.quest_desc: [
		"An apple the stewards never ate. Neither should you, probably.",
		"How: not a pad craft. Optional secret — it does not gate the Sigil Knot."
	]
	quest.4200000000080194.title: "Old Gold"
	quest.4200000000090195.quest_desc: [
		"An iron mesh, gravel or sand, patience.",
		"Strand Filament is the Loom's own thread. The braid is spun from it.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: iron thread mesh on gravel, sand, or dust (Loomframe or sieve)."
	]
	quest.4200000000090195.title: "Spin the Filament"
	quest.4200000000090196.quest_desc: [
		"Sixteen Filaments, one right-click on the Post.",
		"Bind has begun; Reweave starts here.",
		"How: right-click the Tension Post holding 16 Strand Filaments. Sieve gravel or sand with an iron Thread Mesh to find them."
	]
	quest.4200000000090196.title: "Splice a Braid"
	quest.4200000000090197.quest_desc: [
		"Certus quartz — the cold thread of a digital loom.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.4200000000090197.title: "Cold Weft"
	quest.4200000000090198.quest_desc: [
		"Ground quartz, the base material the digital loom is built from.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.4200000000090198.title: "Certus Dust"
	quest.4200000000090199.quest_desc: [
		"The shell block for every network machine, quarried from certus deposits.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.4200000000090199.title: "Sky Stone"
	quest.420000000009019A.quest_desc: [
		"Fluix — certus, quartz, and redstone charged in water.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.420000000009019A.title: "Charged Warp"
	quest.420000000009019B.quest_desc: [
		"A blend of quartz, redstone, and glass, ground fine for network crafting.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.420000000009019B.title: "Fluix Dust"
	quest.420000000009019C.quest_desc: [
		"Silicon for AE2 processors.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.420000000009019C.title: "Silicon"
	quest.420000000009019D.quest_desc: [
		"The inscriber presses circuits the way a loom presses cloth.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.420000000009019D.title: "Press the Pattern"
	quest.420000000009019E.quest_desc: [
		"Stamps a silicon plate the way a loom presses cloth.",
		"How: iron block, Binding Knot, iron, and quartz. AE2 only duplicates a press you already have."
	]
	quest.420000000009019E.title: "Inscriber Silicon Press"
	quest.420000000009019F.quest_desc: [
		"Stamps the die for a logic processor, one press at a time.",
		"How: iron block, Binding Knot, iron, and gold. First copy is the Knot craft."
	]
	quest.420000000009019F.title: "Logic Press"
	quest.42000000000901A0.quest_desc: [
		"Stamps the die for a calculation processor.",
		"How: iron block, Binding Knot, iron, and certus (sieve sand). First copy is the Knot craft."
	]
	quest.42000000000901A0.title: "Calculation Press"
	quest.42000000000901A1.quest_desc: [
		"Engineering die craft.",
		"How: iron block, Binding Knot, iron, and diamond. First copy is the Knot craft."
	]
	quest.42000000000901A1.title: "Engineering Press"
	quest.42000000000901A2.quest_desc: [
		"Logic processor for AE2.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901A2.title: "Logic Processor"
	quest.42000000000901A3.quest_desc: [
		"A component in autocrafting patterns, made from silicon and certus quartz.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901A3.title: "Calculation Processor"
	quest.42000000000901A4.quest_desc: [
		"A denser processor, needed for the network's more demanding parts.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901A4.title: "Engineering Processor"
	quest.42000000000901A5.quest_desc: [
		"Houses the cells that hold everything the network remembers.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901A5.title: "ME Drive"
	quest.42000000000901A6.quest_desc: [
		"The shell a storage cell is built inside.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901A6.title: "Item Cell Housing"
	quest.42000000000901A7.quest_desc: [
		"First digital chest.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901A7.title: "1k Item Cell"
	quest.42000000000901A8.quest_desc: [
		"See the net.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901A8.title: "ME Terminal"
	quest.42000000000901A9.quest_desc: [
		"Lets you craft directly from whatever the network already holds.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901A9.title: "Crafting Terminal"
	quest.42000000000901AA.quest_desc: [
		"The controller. Wants a Binding Knot at its centre.",
		"Spindle core.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901AA.title: "Digital Loom"
	quest.42000000000901AB.quest_desc: [
		"Use it empty-handed and play the Gate Rite: hit the falling beats on A, S, D, F. Land 60% and it opens; no Pulse needed.",
		"How: use the Gate Drum empty-handed and play the Gate Rite: hit the falling beats on A, S, D, F. Land 60% and it opens; no Pulse needed. Bind a return compass first."
	]
	quest.42000000000901AB.title: "Gate Drum"
	quest.42000000000901AC.quest_desc: [
		"Footing from beyond the gate. Bring one home.",
		"How: smelt March Cobble. Mine it in the March, through a Gate Drum."
	]
	quest.42000000000901AC.title: "March Stone"
	quest.42000000000901AD.quest_desc: [
		"Carries the network's channels from one machine to the next.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901AD.title: "Fluix Cable"
	quest.42000000000901AE.quest_desc: [
		"Pull items into storage.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901AE.title: "Import Bus"
	quest.42000000000901AF.quest_desc: [
		"Pushes items out of the network into a chest or machine.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901AF.title: "Export Bus"
	quest.42000000000901B0.quest_desc: [
		"Reads an outside inventory into the network as if it were a cell.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901B0.title: "Storage Bus"
	quest.42000000000901B1.quest_desc: [
		"Adds bulk crafting capacity to the network's autocrafting.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901B1.title: "Crafting Unit"
	quest.42000000000901B2.quest_desc: [
		"Speeds up how many crafting jobs run at once.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901B2.title: "Crafting Co-Processing Unit"
	quest.42000000000901B3.quest_desc: [
		"Holds patterns for the network to draw on while it crafts.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901B3.title: "1k Crafting Storage"
	quest.42000000000901B4.quest_desc: [
		"Feeds patterns to machines the way a loom feeds thread to the shuttle.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901B4.title: "Pattern Provider"
	quest.42000000000901B5.quest_desc: [
		"Builds from patterns. Wants a Braid Cord at its heart.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901B5.title: "Molecular Assembler"
	quest.42000000000901B6.quest_desc: [
		"An empty pattern, waiting to be encoded with a recipe.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901B6.title: "Blank Pattern"
	quest.42000000000901B7.quest_desc: [
		"Feed power into the digital loom.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901B7.title: "Energy Acceptor"
	quest.42000000000901B8.quest_desc: [
		"Burn for AE — optional power branch.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901B8.title: "Vibration Chamber"
	quest.42000000000901B9.quest_desc: [
		"A storage cell with more room than the last size.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901B9.title: "4k Item Cell"
	quest.42000000000901BA.quest_desc: [
		"Holds far more than any chest, the densest cell before the drive fills up.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901BA.title: "16k Item Cell"
	quest.42000000000901BB.quest_desc: [
		"The shell a fluid storage cell is built inside.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901BB.title: "Fluid Cell Housing"
	quest.42000000000901BC.quest_desc: [
		"A digital tank, storing liquid the network can pull from anywhere.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901BC.title: "1k Fluid Cell"
	quest.42000000000901BD.quest_desc: [
		"Places blocks from the network the way a hand would, without one.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901BD.title: "Formation Plane"
	quest.42000000000901BE.quest_desc: [
		"Breaks blocks in front of it and feeds them into the network.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901BE.title: "Annihilation Plane"
	quest.42000000000901BF.quest_desc: [
		"Redstone from net.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901BF.title: "Level Emitter"
	quest.42000000000901C0.quest_desc: [
		"Connects the network to the world, trading items across the edge.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901C0.title: "Interface"
	quest.42000000000901C1.quest_desc: [
		"Links two networks across distance the ordinary cable can't reach.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901C1.title: "Quantum Ring"
	quest.42000000000901C2.quest_desc: [
		"The paired half of a quantum ring, tying two networks together.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901C2.title: "Quantum Link"
	quest.42000000000901C3.quest_desc: [
		"Reaches the network from anywhere in range, no cable underfoot.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901C3.title: "Wireless Terminal"
	quest.42000000000901C4.quest_desc: [
		"Copies one machine's settings onto another without retyping them.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901C4.title: "Memory Card"
	quest.42000000000901C5.quest_desc: [
		"Network tool for AE2.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901C5.title: "Network Tool"
	quest.42000000000901C6.quest_desc: [
		"Charges certus quartz until it's ready for finer crafting.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901C6.title: "Charger"
	quest.42000000000901C7.quest_desc: [
		"Speeds a growing crystal bud toward a full-sized cluster.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000000901C7.title: "Crystal Growth Accelerator"
	quest.42000000000901C8.quest_desc: [
		"March canopy proof — optional Reweave souvenir.",
		"How: grows wild in the March, sits in reed-weir chests, and a Rootbinder Elder trades it."
	]
	quest.42000000000901C8.title: "Spirit Reed"
	quest.42000000000901C9.quest_desc: [
		"A braid, a digital loom, a gate, a stone from the March.",
		"Tension the ninth Strand. Then the Fragment, then the Post.",
		"Claim it and choose one gift from the tribe: a Thread of Return for one more shared life, or supplies.",
		"How: finish the quests linked to this one, then claim it for the Strand token. Seat the token at your Tension Post."
	]
	quest.42000000000901C9.quest_subtitle: "Reweave"
	quest.42000000000901C9.title: "Spindle Knot"
	quest.42000000000901CA.quest_desc: [
		"Right-click your Clowder's Tension Post with the token.",
		"The notch lights, the tribe chimes, the pad changes.",
		"How: right-click your Tension Post with the Strand token in hand."
	]
	quest.42000000000901CA.title: "Seat Spindle"
	quest.42000000000901CB.quest_desc: [
		"Nine seated, one March stone, one right-click on the Post: the Fragment.",
		"Seat it. The cut closes above your pad.",
		"How: nine tokens seated, then right-click the Post with March Stone."
	]
	quest.42000000000901CB.quest_subtitle: "Reweave"
	quest.42000000000901CB.title: "Loom Fragment"
	quest.42000000000901CC.quest_desc: [
		"Seat the Fragment at the Tension Post.",
		"Nine tribes, one thread. Go and see what the March kept for you.",
		"Rare reward: one shared Clowder life, once for the entire team. Only six such rewards exist in the campaign.",
		"How: seat the Spindle Loom Fragment at the Tension Post. Advancement fires when the sky closes."
	]
	quest.42000000000901CC.quest_subtitle: "The cut, closed"
	quest.42000000000901CC.title: "Reweave"
	quest.42000000000901CD.quest_desc: [
		"A wither, on a pad, in the sky. The Loom-stitchers would have been impressed and then furious.",
		"How: Wither (three skulls on soul sand), or the Drumhearts' stall at /clowder hub once, for 12 Thread Bolts (972 Thread). Optional trophy — it does not gate End or Mob Farm 100%."
	]
	quest.42000000000901CD.title: "A Star, Somehow"
	quest.42000000000A01CE.quest_desc: [
		"Leaves drop more saplings.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000000A01CE.title: "Crook Basics"
	quest.42000000000A01CF.quest_desc: [
		"Sifts faster than the wooden crook, and lasts far longer.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000000A01CF.title: "Bone Crook"
	quest.42000000000A01D0.quest_desc: [
		"The plainest mesh. Everything you sieve starts by passing through this.",
		"How: nine string in a 3x3. The Grit-singers' stall sells the Voidloom string thread mesh, which sieves the same."
	]
	quest.42000000000A01D0.title: "String Mesh"
	quest.42000000000A01D1.quest_desc: [
		"Catches finer shards than string. Fewer scraps slip through the weave.",
		"How: four flint and five string in a checker. Flint is gravel, or Thread + gravel."
	]
	quest.42000000000A01D1.title: "Flint Mesh (Sieve)"
	quest.42000000000A01D2.quest_desc: [
		"Iron threads catch heavier grit and pull rarer scraps from the pile.",
		"How: four iron ingots and five string in a checker. No stall sells it."
	]
	quest.42000000000A01D2.title: "Iron Mesh (Sieve)"
	quest.42000000000A01D3.quest_desc: [
		"Gold tier mesh. Odds shift toward the ores that matter.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000000A01D3.title: "Golden Mesh"
	quest.42000000000A01D4.quest_desc: [
		"Sieve gravel with this and diamonds turn up far more often.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000000A01D4.title: "Diamond Mesh"
	quest.42000000000A01D5.quest_desc: [
		"The finest mesh made. Nothing sieves better than netherite thread.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000000A01D5.title: "Netherite Mesh"
	quest.42000000000A01D6.quest_desc: [
		"Clay refined smooth, ready to fire into a crucible that holds real heat.",
		"How: clay ball + bone meal, shapeless. Clay comes from the Tension Barrel."
	]
	quest.42000000000A01D6.title: "Porcelain Clay (Sieve)"
	quest.42000000000A01D7.quest_desc: [
		"Porcelain clay shaped into a crucible. Fire it in a furnace.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000000A01D7.title: "Unfired Crucible"
	quest.42000000000A01D8.quest_desc: [
		"Holds molten heat without cracking. Smelt what the sieve turned up.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000000A01D8.title: "Porcelain Crucible"
	quest.42000000000A01D9.quest_desc: [
		"Splashes water across crops without trampling the rows.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000000A01D9.title: "Watering Can Wood"
	quest.42000000000A01DA.quest_desc: [
		"Wider splash and a deeper tank. Water more of the pad per trip.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000000A01DA.title: "Watering Can Iron"
	quest.42000000000A01DB.quest_desc: [
		"Set loose on leaves, it spins silk while it feeds.",
		"How: break leaves with a crook; silkworms drop now and then."
	]
	quest.42000000000A01DB.title: "Silkworm"
	quest.42000000000A01DC.quest_desc: [
		"Strange water that nudges saplings and seeds toward stranger crops.",
		"How: a barrel of water on mycelium turns to witch water; fill a bucket from it. Mycelium spores sieve from dirt."
	]
	quest.42000000000A01DC.title: "Witch Water Bucket"
	quest.42000000000A01DD.quest_desc: [
		"Scatter these and mycelium creeps outward, block by patient block.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000000A01DD.title: "Mycelium Spores"
	quest.42000000000A01DE.quest_desc: [
		"Toss on dirt and grass spreads without waiting on the rain.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000000A01DE.title: "Grass Seeds"
	quest.42000000000A01DF.quest_desc: [
		"Cobblestone's replacement grit. Feed it back to the hammer for more.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000000A01DF.title: "Stone Pebble"
	quest.42000000000A01E0.quest_desc: [
		"Nine cobblestone packed tight into storage stone for a growing pad.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000000A01E0.title: "Compressed Cobble"
	quest.42000000000A01E1.quest_desc: [
		"Breaks cobble into gravel faster than any hammer before it.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000000A01E1.title: "Netherite Hammer"
	quest.42000000000A01E2.quest_desc: [
		"Nether stone, crushed fine. Basalt and blackstone both start here.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000000A01E2.title: "Blackstone Pebble"
	quest.42000000000A01E3.quest_desc: [
		"Deepslate crushed down to grit, ready for the sieve again.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000000A01E3.title: "Deepslate Pebble"
	quest.42000000000A01E4.quest_desc: [
		"Pale stone pulled from deep sieving, mostly good for building.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000000A01E4.title: "Calcite"
	quest.42000000000A01E5.quest_desc: [
		"Grey stone from the depths, plain and easy to shape.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000000A01E5.title: "Tuff"
	quest.42000000000A01E6.quest_desc: [
		"Grows slow underground; stack it and let it drip into stalactites again.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000A01E6.title: "Dripstone"
	quest.42000000000A01E7.quest_desc: [
		"Soaks up standing water fast, handy after a flooded farm.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000A01E7.title: "Sponge"
	quest.42000000000B01E8.quest_desc: [
		"Links the storage around it into one searchable network.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: a wooden barrel or chest, two comparators, planks and stone. Links nearby Sophisticated barrels."
	]
	quest.42000000000B01E8.title: "Storage Controller"
	quest.42000000000B01E9.quest_desc: [
		"A barrel that upgrades: filters, hoppers, magnets, void.",
		"How: upgrade a barrel with copper. JEI names the craft."
	]
	quest.42000000000B01E9.title: "Copper Barrel"
	quest.42000000000B01EA.quest_desc: [
		"More slots, more upgrade rows.",
		"How: barrels and upgrades in JEI. Controller ties a wall of barrels together."
	]
	quest.42000000000B01EA.title: "Iron Barrel"
	quest.42000000000B01EB.quest_desc: [
		"Pull dropped items straight into the barrel from across the pad.",
		"How: barrels and upgrades in JEI. Controller ties a wall of barrels together."
	]
	quest.42000000000B01EB.title: "Advanced Magnet Upgrade"
	quest.42000000000B01EC.quest_desc: [
		"In one side, out the other, no hopper block needed.",
		"How: barrels and upgrades in JEI. Controller ties a wall of barrels together."
	]
	quest.42000000000B01EC.title: "Hopper Upgrade"
	quest.42000000000B01ED.quest_desc: [
		"Deletes anything past capacity so the drawer never jams.",
		"How: barrels and upgrades in JEI. Controller ties a wall of barrels together."
	]
	quest.42000000000B01ED.title: "Void Upgrade"
	quest.42000000000B01EE.quest_desc: [
		"Pulls nearby drops straight into the storage it is fitted to.",
		"How: barrels and upgrades in JEI. Controller ties a wall of barrels together."
	]
	quest.42000000000B01EE.title: "Pickup Upgrade"
	quest.42000000000B01EF.quest_desc: [
		"One slot, sorted and visible. The simplest way to store bulk items.",
		"How: oak logs + chest. First drawer."
	]
	quest.42000000000B01EF.title: "Oak Drawer 1x1"
	quest.42000000000B01F0.quest_desc: [
		"Two slots side by side for keeping similar items apart.",
		"How: oak drawers 1x1 / 1x2 / 2x2, then compacting drawer and controller. JEI names the craft."
	]
	quest.42000000000B01F0.title: "Oak Drawer 1x2"
	quest.42000000000B01F1.quest_desc: [
		"Four slots in one frame. Dense storage for a small footprint.",
		"How: oak drawers 1x1 / 1x2 / 2x2, then compacting drawer and controller. JEI names the craft."
	]
	quest.42000000000B01F1.title: "Oak Drawer 2x2"
	quest.42000000000B01F2.quest_desc: [
		"Automatically compacts what it holds into blocks as it fills.",
		"How: oak drawers 1x1 / 1x2 / 2x2, then compacting drawer and controller. JEI names the craft."
	]
	quest.42000000000B01F2.title: "Compacting Drawer"
	quest.42000000000B01F3.quest_desc: [
		"Links the storage around it into one searchable network.",
		"How: oak drawers 1x1 / 1x2 / 2x2, then compacting drawer and controller. JEI names the craft."
	]
	quest.42000000000B01F3.title: "Storage Controller (Storage)"
	quest.42000000000B01F4.quest_desc: [
		"Pulls nearby item drops straight into the drawer.",
		"How: oak drawers 1x1 / 1x2 / 2x2, then compacting drawer and controller. JEI names the craft."
	]
	quest.42000000000B01F4.title: "Collector Upgrade"
	quest.42000000000B01F5.quest_desc: [
		"Pulls items out of the chest or machine set beside it.",
		"How: oak drawers 1x1 / 1x2 / 2x2, then compacting drawer and controller. JEI names the craft."
	]
	quest.42000000000B01F5.title: "Puller Upgrade"
	quest.42000000000B01F6.quest_desc: [
		"Pushes stored items into whatever inventory sits next to it.",
		"How: oak drawers 1x1 / 1x2 / 2x2, then compacting drawer and controller. JEI names the craft."
	]
	quest.42000000000B01F6.title: "Pusher Upgrade"
	quest.42000000000B01F7.quest_desc: [
		"Deletes anything past capacity so the drawer never jams.",
		"How: oak drawers 1x1 / 1x2 / 2x2, then compacting drawer and controller. JEI names the craft."
	]
	quest.42000000000B01F7.title: "Void Upgrade (Storage)"
	quest.42000000000B01F8.quest_desc: [
		"A portable inventory that frees up hotbar and pocket space.",
		"How: leather + chest. Then iron/gold/diamond upgrades."
	]
	quest.42000000000B01F8.title: "Backpack"
	quest.42000000000B01F9.quest_desc: [
		"More slots than the plain backpack, and a slot to upgrade it.",
		"How: leather backpack, then iron/gold/diamond upgrades in JEI."
	]
	quest.42000000000B01F9.title: "Iron Backpack"
	quest.42000000000B01FA.quest_desc: [
		"Roomier still, with slots left over for useful upgrades.",
		"How: leather backpack, then iron/gold/diamond upgrades in JEI."
	]
	quest.42000000000B01FA.title: "Gold Backpack"
	quest.42000000000B01FB.quest_desc: [
		"The deepest pockets before enchanting takes the storage further still.",
		"How: leather backpack, then iron/gold/diamond upgrades in JEI."
	]
	quest.42000000000B01FB.title: "Diamond Backpack"
	quest.42000000000B01FC.quest_desc: [
		"Pulls nearby drops straight into the storage it is fitted to.",
		"How: leather backpack, then iron/gold/diamond upgrades in JEI."
	]
	quest.42000000000B01FC.title: "Pickup Upgrade (Storage)"
	quest.42000000000B01FD.quest_desc: [
		"Filter what enters packs.",
		"How: leather backpack, then iron/gold/diamond upgrades in JEI."
	]
	quest.42000000000B01FD.title: "Filter Upgrade"
	quest.42000000000B01FE.quest_desc: [
		"Lets the backpack craft from whatever it already has stored.",
		"How: leather backpack, then iron/gold/diamond upgrades in JEI."
	]
	quest.42000000000B01FE.title: "Crafting Upgrade"
	quest.42000000000B01FF.quest_desc: [
		"Feeds you automatically from its stores when hunger runs low.",
		"How: leather backpack, then iron/gold/diamond upgrades in JEI."
	]
	quest.42000000000B01FF.title: "Feeding Upgrade"
	quest.42000000000B0200.quest_desc: [
		"Swaps a broken tool for a fresh one from the pack.",
		"How: leather backpack, then iron/gold/diamond upgrades in JEI."
	]
	quest.42000000000B0200.title: "Restock Upgrade"
	quest.42000000000B0201.quest_desc: [
		"Empties the backpack into nearby chests when you get close.",
		"How: leather backpack, then iron/gold/diamond upgrades in JEI."
	]
	quest.42000000000B0201.title: "Deposit Upgrade"
	quest.42000000000B0202.quest_desc: [
		"Adds a fluid tank inside the backpack for hauling liquids.",
		"How: leather backpack, then iron/gold/diamond upgrades in JEI."
	]
	quest.42000000000B0202.title: "Tank Upgrade"
	quest.42000000000C0203.quest_desc: [
		"The backbone metal behind most machines and casings on this line.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000000C0203.title: "Steel Ingot"
	quest.42000000000C0204.quest_desc: [
		"The core metal behind most cables, tanks, and early machines.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000000C0204.title: "Osmium Ingot"
	quest.42000000000C0205.quest_desc: [
		"A hard alloy pressed from obsidian dust for tougher gear.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000000C0205.title: "Refined Obsidian"
	quest.42000000000C0206.quest_desc: [
		"The simplest logic board. Most early machines need a few.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000000C0206.title: "Basic Control Circuit"
	quest.42000000000C0207.quest_desc: [
		"A sharper logic board for the machines a step up the line.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000000C0207.title: "Advanced Control Circuit"
	quest.42000000000C0208.quest_desc: [
		"The sharpest logic board, reserved for the line's top machines.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000000C0208.title: "Elite Control Circuit"
	quest.42000000000C0209.quest_desc: [
		"Infuses metals with carbon, redstone, or diamond dust before smelting.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000000C0209.title: "Metallurgic Infuser"
	quest.42000000000C020A.quest_desc: [
		"Doubles most raw ores into two dusts instead of one.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000000C020A.title: "Enrichment Chamber"
	quest.42000000000C020B.quest_desc: [
		"Mill or crush bulk materials.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000000C020B.title: "Crusher"
	quest.42000000000C020C.quest_desc: [
		"Smelts ores on power instead of fuel, and a little faster too.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000000C020C.title: "Energized Smelter"
	quest.42000000000C020D.quest_desc: [
		"Purifies enriched ore with oxygen for a third output, sometimes more.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000000C020D.title: "Purification Chamber"
	quest.42000000000C020E.quest_desc: [
		"Injects gas into ore for the richest output the line offers.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000000C020E.title: "Chemical Injection"
	quest.42000000000C020F.quest_desc: [
		"Compresses osmium dust into ingots faster than a furnace alone.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000000C020F.title: "Osmium Compressor"
	quest.42000000000C0210.quest_desc: [
		"A single stack slot that holds far more than a chest can.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000000C0210.title: "Basic Bin"
	quest.42000000000C0211.quest_desc: [
		"Stores a deep pool of one fluid in a single block.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000000C0211.title: "Basic Fluid Tank"
	quest.42000000000C0212.quest_desc: [
		"Buffers power between machines so surges don't stall the line.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000000C0212.title: "Basic Energy Cube"
	quest.42000000000C0213.quest_desc: [
		"Carries power to machines. The most common cable on the pad.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000000C0213.title: "Basic Universal Cable"
	quest.42000000000C0214.quest_desc: [
		"Moves fluids between tanks and machines along the pad.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000000C0214.title: "Basic Mechanical Pipe"
	quest.42000000000C0215.quest_desc: [
		"Moves items automatically between connected inventories.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000000C0215.title: "Basic Logistical Transporter"
	quest.42000000000C0216.quest_desc: [
		"Rotates, wrenches, and reconfigures machine faces with one tool.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000000C0216.title: "Configurator"
	quest.42000000000C0217.quest_desc: [
		"Mek jetpack — optional lift.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000000C0217.title: "Jetpack"
	quest.42000000000C0218.quest_desc: [
		"Softens fall damage and buys a second before the void claims you.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000000C0218.title: "Free Runners"
	quest.42000000000C0219.quest_desc: [
		"One tool that mines, cuts, and fights, sharper with every upgrade.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000000C0219.title: "Atomic Disassembler"
	quest.42000000000C021A.quest_desc: [
		"The structural frame most multiblock machines are built around.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000000C021A.title: "Steel Casing"
	quest.42000000000C021B.quest_desc: [
		"Links two points so stepping through skips the walk between.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000000C021B.title: "Teleporter"
	quest.42000000000C021C.quest_desc: [
		"Mines a wide radius automatically and sorts the output for you.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000000C021C.title: "Digital Miner"
	quest.42000000000D021D.quest_desc: [
		"A sticky base ingredient behind most of the grid's machines.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: Powah Grid chapter — energizing orb and cables after Spark Pulse exists."
	]
	quest.42000000000D021D.title: "Dielectric Paste"
	quest.42000000000D021E.quest_desc: [
		"Store a measure of power.",
		"How: Powah Grid chapter — energizing orb and cables after Spark Pulse exists."
	]
	quest.42000000000D021E.title: "Capacitor Basic"
	quest.42000000000D021F.quest_desc: [
		"Stores a deep reserve of power for the machines around it.",
		"How: Powah Grid chapter — energizing orb and cables after Spark Pulse exists."
	]
	quest.42000000000D021F.title: "Energy Cell Basic"
	quest.42000000000D0220.quest_desc: [
		"Burns fuel into power more efficiently than a plain furnace.",
		"How: Powah Grid chapter — energizing orb and cables after Spark Pulse exists."
	]
	quest.42000000000D0220.title: "Furnator Basic"
	quest.42000000000D0221.quest_desc: [
		"Turns lava into steady power for as long as the lava lasts.",
		"How: Powah Grid chapter — energizing orb and cables after Spark Pulse exists."
	]
	quest.42000000000D0221.title: "Magmator Basic"
	quest.42000000000D0222.quest_desc: [
		"Generates power from daylight, more than a single cell manages alone.",
		"How: Powah Grid chapter — energizing orb and cables after Spark Pulse exists."
	]
	quest.42000000000D0222.title: "Solar Basic"
	quest.42000000000D0223.quest_desc: [
		"Generates power from the gap between hot and cold nearby blocks.",
		"How: Powah Grid chapter — energizing orb and cables after Spark Pulse exists."
	]
	quest.42000000000D0223.title: "Thermo Basic"
	quest.42000000000D0224.quest_desc: [
		"Burns solid fuel steadily for a strong, dependable trickle of power.",
		"How: Powah Grid chapter — energizing orb and cables after Spark Pulse exists."
	]
	quest.42000000000D0224.title: "Reactor Basic"
	quest.42000000000D0225.quest_desc: [
		"Moves more power per tick than the starting cable.",
		"How: Powah Grid chapter — energizing orb and cables after Spark Pulse exists."
	]
	quest.42000000000D0225.title: "Energy Cable Basic"
	quest.42000000000D0226.quest_desc: [
		"Charges the player directly, no wires or slots required.",
		"How: Powah Grid chapter — energizing orb and cables after Spark Pulse exists."
	]
	quest.42000000000D0226.title: "Player Transmitter Basic"
	quest.42000000000D0227.quest_desc: [
		"Feeds power into nearby machines the way a hopper feeds items.",
		"How: Powah Grid chapter — energizing orb and cables after Spark Pulse exists."
	]
	quest.42000000000D0227.title: "Energy Hopper Basic"
	quest.42000000000D0228.quest_desc: [
		"Charges energizing cells faster when placed beside the crystal setup.",
		"How: Powah Grid chapter — energizing orb and cables after Spark Pulse exists."
	]
	quest.42000000000D0228.title: "Energizing Rod Basic"
	quest.42000000000D0229.quest_desc: [
		"A pocket reserve of power to carry between machines by hand.",
		"How: Powah Grid chapter — energizing orb and cables after Spark Pulse exists."
	]
	quest.42000000000D0229.title: "Battery Basic"
	quest.42000000000D022A.quest_desc: [
		"The first crystal tier for the energizing rod's cell chamber.",
		"How: Powah Grid chapter — energizing orb and cables after Spark Pulse exists."
	]
	quest.42000000000D022A.title: "Niotic Crystal"
	quest.42000000000D022B.quest_desc: [
		"A stronger crystal tier, further along the energizing chamber's build.",
		"How: Powah Grid chapter — energizing orb and cables after Spark Pulse exists."
	]
	quest.42000000000D022B.title: "Spirited Crystal"
	quest.42000000000D022C.quest_desc: [
		"The strongest crystal tier the energizing chamber can hold.",
		"How: Powah Grid chapter — energizing orb and cables after Spark Pulse exists."
	]
	quest.42000000000D022C.title: "Nitro Crystal"
	quest.42000000000E022D.quest_desc: [
		"Spun from magebloom, and woven into robes and spell gear.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.42000000000E022D.title: "Mage Fiber"
	quest.42000000000E022E.quest_desc: [
		"A flower that regrows its fiber on the stem after harvest.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.42000000000E022E.title: "Magebloom"
	quest.42000000000E022F.quest_desc: [
		"Stores a dense pool of source, the fuel behind every spell.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.42000000000E022F.title: "Source Gem Block"
	quest.42000000000E0230.quest_desc: [
		"Holds more glyphs than the starting book allows.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.42000000000E0230.title: "Apprentice Spell Book"
	quest.42000000000E0231.quest_desc: [
		"The largest spell book, room enough for a full arsenal of glyphs.",
		"How: Mage's Spell Book, three ender pearls, two emeralds, a Totem of Undying, a nether star and a Wilden Tribute, shapeless. Totem: pack recipe, four gold blocks and four emeralds around a golden apple."
	]
	quest.42000000000E0231.title: "Archmage Spell Book"
	quest.42000000000E0232.quest_desc: [
		"Casts a bound spell automatically whenever it senses a target.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.42000000000E0232.title: "Spell Turret"
	quest.42000000000E0233.quest_desc: [
		"Casts its bound spell on a steady timer instead of on sight.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.42000000000E0233.title: "Timer Spell Turret"
	quest.42000000000E0234.quest_desc: [
		"The centerpiece for crafting spell books, wands, and other arcane gear.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.42000000000E0234.title: "Enchanting Apparatus"
	quest.42000000000E0235.quest_desc: [
		"Sits inside the enchanting apparatus and drives its recipes.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.42000000000E0235.title: "Arcane Core"
	quest.42000000000E0236.quest_desc: [
		"Carries source between an arcane spot and a linked jar or spell.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.42000000000E0236.title: "Relay"
	quest.42000000000E0237.quest_desc: [
		"Splits one source line so it feeds several places at once.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.42000000000E0237.title: "Relay Splitter"
	quest.42000000000E0238.quest_desc: [
		"Converts nearby crop growth into a slow trickle of source.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.42000000000E0238.title: "Agronomic Sourcelink"
	quest.42000000000E0239.quest_desc: [
		"Converts nearby lava heat into a steady trickle of source.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.42000000000E0239.title: "Volcanic Sourcelink"
	quest.42000000000E023A.quest_desc: [
		"Summons a wixie that crafts recipes for you while you work elsewhere.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.42000000000E023A.title: "Wixie Charm"
	quest.42000000000E023B.quest_desc: [
		"Summons a starbuncle that fetches items from storage on command.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.42000000000E023B.title: "Starbuncle Charm"
	quest.42000000000E023C.quest_desc: [
		"Summons a drygmy that slowly generates a chosen resource nearby.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.42000000000E023C.title: "Drygmy Charm"
	quest.42000000000E023D.quest_desc: [
		"Summons a whirlisprig that tends and grows crops on its own.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.42000000000E023D.title: "Whirlisprig Charm"
	quest.42000000000E023E.quest_desc: [
		"Summons a golem that harvests amethyst buds without lifting a pick.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.42000000000E023E.title: "Amethyst Golem Charm"
	quest.42000000000E023F.quest_desc: [
		"Picks up and places blocks remotely, wiring machines together at range.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.42000000000E023F.title: "Dominion Wand"
	quest.42000000000E0240.quest_desc: [
		"Marks an item as allowed when set into a filter.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.42000000000E0240.title: "Allow Scroll"
	quest.42000000000E0241.quest_desc: [
		"Marks an item as denied when set into a filter.",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.42000000000E0241.title: "Deny Scroll"
	quest.42000000000F0242.quest_desc: [
		"Logs around a Binding Knot, Thread on top. Place it on the pad.",
		"Stand near it: the pad starts mending you once a Strand is seated.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: logs around a Binding Knot, Thread on top. Place it on the pad. Look at it to complete."
	]
	quest.42000000000F0242.title: "Raise the Post"
	quest.42000000000F0243.quest_desc: [
		"Hub Key in hand, or /clowder hub. Every Clowder on the server meets here.",
		"/clowder return brings you home.",
		"How: Hub Key or `/clowder hub`. `/clowder return` comes home."
	]
	quest.42000000000F0243.title: "Enter the Hall"
	quest.42000000000F0244.quest_desc: [
		"Above the Dock stands a slow dark column: the cut itself.",
		"It thins as Clowders seat Strands. Come back and check it now and then.",
		"How: /clowder hub, look up at the dark column over the Dock, then click the checkmark."
	]
	quest.42000000000F0244.title: "Look at the Fray"
	quest.42000000000F0245.quest_desc: [
		"Name a pad as yours.",
		"How: K opens the island panel. Hold the Charter; sneak-use on Overworld pad ground to seal spawn. Start here names the steps."
	]
	quest.42000000000F0245.title: "Island Charter"
	quest.42000000000F0246.quest_desc: [
		"Opens the way back to the Clowder Hall from anywhere on the Strand.",
		"How: starter kit / Hall. `/clowder hub` and Hub Key go to Clowder Hall; `/clowder return` comes home."
	]
	quest.42000000000F0246.title: "Hub Key"
	quest.42000000000F0247.quest_desc: [
		"A banner pattern that marks how far your Strand has come.",
		"How: craft at the Hall or JEI. A banner mark, not a Strand token."
	]
	quest.42000000000F0247.title: "Strand Banner"
	quest.42000000000F0248.quest_desc: [
		"Grave (`) opens the assignment list. Right-click the Whisker Codex for Start here. Same campaign; no Shift-click book.",
		"How: a book and any stone, shapeless. Grave (`) opens the same list without it."
	]
	quest.42000000000F0248.title: "Assignment List"
	quest.42000000000F0249.quest_desc: [
		"Stay fed on claim runs.",
		"How: eight gold nuggets around a carrot. Carrots are rare zombie drops; the snack is optional."
	]
	quest.42000000000F0249.title: "Chunk Claim Snack"
	quest.42000000000F024A.quest_desc: [
		"Charts the pads around you as your Clowder spreads outward.",
		"How: compass surrounded by paper."
	]
	quest.42000000000F024A.title: "Map"
	quest.42000000000F024B.quest_desc: [
		"Points back toward the world spawn, useful once pads multiply.",
		"How: iron around redstone."
	]
	quest.42000000000F024B.title: "Compass"
	quest.42000000000F024C.quest_desc: [
		"Anchors a compass to one exact spot instead of spawn.",
		"How: netherite ingot in chiseled stone bricks. Late Clowder luxury."
	]
	quest.42000000000F024C.title: "Lodestone"
	quest.42000000000F024D.quest_desc: [
		"Points toward your last death, so nothing stays lost in the void.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000F024D.title: "Recovery Compass"
	quest.42000000000F024E.quest_desc: [
		"Rings loud enough to gather the whole Clowder to one pad.",
		"How: no crafting recipe. Occultism's Contact Wild Spirit ritual makes one but needs a goat, and goats never reach the pad. Optional."
	]
	quest.42000000000F024E.title: "Bell"
	quest.42000000000F024F.quest_desc: [
		"Holds a book open for the whole Clowder to read.",
		"How: wood slabs around a bookshelf."
	]
	quest.42000000000F024F.title: "Lectern"
	quest.42000000000F0250.quest_desc: [
		"Labels a district so newcomers know which pad is which.",
		"How: planks over a stick."
	]
	quest.42000000000F0250.title: "Oak Sign"
	quest.42000000000F0251.quest_desc: [
		"A blank banner ready to take the Clowder's colors.",
		"How: six wool over a stick."
	]
	quest.42000000000F0251.title: "White Banner"
	quest.42000000000F0252.quest_desc: [
		"Shield ready for banners.",
		"How: six planks around iron. Off-hand block."
	]
	quest.42000000000F0252.title: "Shield Banner Ready"
	quest.42000000000F0253.quest_desc: [
		"Set these off when a Strand finally comes back together.",
		"How: paper plus gunpowder. Optional burst."
	]
	quest.42000000000F0253.title: "Firework"
	quest.42000000000F0254.quest_desc: [
		"Share with the Hall.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000F0254.title: "Cookie Tribute"
	quest.42000000000F0255.quest_desc: [
		"Shared food for celebrating a Strand well and truly rewoven.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000F0255.title: "Cake"
	quest.42000000000F0256.quest_desc: [
		"Cat disc — pack mood.",
		"Optional — the void may never offer one.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000F0256.title: "Music Disc"
	quest.42000000000F0257.quest_desc: [
		"Leads a tamed or bought animal back to the pad without chasing.",
		"How: four string around a slime ball. Slime is pad compost (dirt, seeds, bone meal)."
	]
	quest.42000000000F0257.title: "Lead"
	quest.42000000000F0258.quest_desc: [
		"Mount when you find a saddle.",
		"Optional — the Pad-keepers in Clowder Hall sell one.",
		"How: trade a block of diamond to the Pad-keepers at their shop in Clowder Hall (/clowder hub). Chocobo Saddle is a different item."
	]
	quest.42000000000F0258.title: "Saddle"
	quest.42000000000F0259.quest_desc: [
		"For the day someone builds a sea. Optional.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000F0259.title: "Boat"
	quest.4200000000110278.quest_desc: [
		"Shows where aura pools thick or thin across the land.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: gold leaf + spider eye. Shows local aura."
	]
	quest.4200000000110278.title: "Eye (Aura)"
	quest.4200000000110279.quest_desc: [
		"Woven from gold, used to infuse plants with concentrated aura.",
		"How: four leaves and four gold nuggets around short grass make four Brilliant Fiber. Place it in the crown of a tree; its leaves turn golden with time."
	]
	quest.4200000000110279.title: "Brilliant Fiber (Aura)"
	quest.420000000011027A.quest_desc: [
		"A refined material used in the altar's higher tier recipes.",
		"How: break golden leaves grown from Brilliant Fiber."
	]
	quest.420000000011027A.title: "Gold Leaf (Aura)"
	quest.420000000011027B.quest_desc: [
		"Leaves that hold a soft golden glow year round.",
		"How: Brilliant Fiber on trees → Gold Leaf → Natural Altar. Aura chapter names tokens and generators."
	]
	quest.420000000011027B.title: "Golden Leaves"
	quest.420000000011027C.quest_desc: [
		"Holds an ingredient for the Ritual of the Forest, set around a sapling.",
		"How: Brilliant Fiber on trees → Gold Leaf → Natural Altar. Aura chapter names tokens and generators."
	]
	quest.420000000011027C.title: "Wooden Stand"
	quest.420000000011027D.quest_desc: [
		"The altar where aura powers stronger crafting recipes.",
		"How: Ritual of the Forest (JEI): three stone, a Gold Leaf, a gold ingot and a Token of Joy. Heart of the Aura line."
	]
	quest.420000000011027D.title: "Natural Altar (Aura)"
	quest.420000000011027E.quest_desc: [
		"Iron charged with aura, a step toward the Ingot of the Depths.",
		"How: Brilliant Fiber on trees → Gold Leaf → Natural Altar. Aura chapter names tokens and generators."
	]
	quest.420000000011027E.title: "Infused Iron (Aura)"
	quest.420000000011027F.quest_desc: [
		"Bark stripped from ancient trees, useful in aura recipes.",
		"How: Brilliant Fiber on trees → Gold Leaf → Natural Altar. Aura chapter names tokens and generators."
	]
	quest.420000000011027F.title: "Ancient Bark"
	quest.4200000000110280.quest_desc: [
		"A token of joy. The Natural Altar and Herbivorous Absorber are built on one.",
		"How: Brilliant Fiber on trees → Gold Leaf → Natural Altar. Aura chapter names tokens and generators."
	]
	quest.4200000000110280.title: "Token of Joy (Aura)"
	quest.4200000000110281.quest_desc: [
		"A token of fear. The Canopy Diminisher and Lingering Absorber are built on one.",
		"How: Brilliant Fiber on trees → Gold Leaf → Natural Altar. Aura chapter names tokens and generators."
	]
	quest.4200000000110281.title: "Token of Fear"
	quest.4200000000110282.quest_desc: [
		"A token of anger. The Crumbling Catalyst and Shooting Mark need one.",
		"How: Brilliant Fiber on trees → Gold Leaf → Natural Altar. Aura chapter names tokens and generators."
	]
	quest.4200000000110282.title: "Token of Anger"
	quest.4200000000110283.quest_desc: [
		"A token of sorrow. The Offering Table and Disentangler of Mortals need one.",
		"How: Brilliant Fiber on trees → Gold Leaf → Natural Altar. Aura chapter names tokens and generators."
	]
	quest.4200000000110283.title: "Token of Sorrow"
	quest.4200000000110284.quest_desc: [
		"Aura spirit for rituals.",
		"How: Brilliant Fiber on trees → Gold Leaf → Natural Altar. Aura chapter names tokens and generators."
	]
	quest.4200000000110284.title: "Spirit of Calling"
	quest.4200000000110285.quest_desc: [
		"Birth spirit for aura rites.",
		"How: Brilliant Fiber on trees → Gold Leaf → Natural Altar. Aura chapter names tokens and generators."
	]
	quest.4200000000110285.title: "Spirit of Birthing"
	quest.4200000000110286.quest_desc: [
		"Stores a reserve of aura for when the land runs thin.",
		"How: Brilliant Fiber on trees → Gold Leaf → Natural Altar. Aura chapter names tokens and generators."
	]
	quest.4200000000110286.title: "Aura Trove"
	quest.4200000000110287.quest_desc: [
		"Late. Only if the Aura wants it.",
		"How: Brilliant Fiber on trees → Gold Leaf → Natural Altar. Aura chapter names tokens and generators."
	]
	quest.4200000000110287.title: "Creational Catalyst"
	quest.4200000000110288.quest_desc: [
		"Reveals aura and spawn conditions over a wider stretch of land.",
		"How: Brilliant Fiber on trees → Gold Leaf → Natural Altar. Aura chapter names tokens and generators."
	]
	quest.4200000000110288.title: "Environmental Ocular"
	quest.4200000000110289.quest_desc: [
		"Set beside the Natural Altar, it opens the altar's crushing recipes.",
		"How: Brilliant Fiber on trees → Gold Leaf → Natural Altar. Aura chapter names tokens and generators."
	]
	quest.4200000000110289.title: "Crumbling Catalyst"
	quest.420000000011028A.quest_desc: [
		"Set beside the Natural Altar, it opens the altar's transmutation recipes.",
		"How: Brilliant Fiber on trees → Gold Leaf → Natural Altar. Aura chapter names tokens and generators."
	]
	quest.420000000011028A.title: "Transmutation Catalyst"
	quest.420000000011028B.quest_desc: [
		"Sky ingots, tainted gold and netherite scrap, pressed into the Ingot of the Depths.",
		"How: Brilliant Fiber on trees → Gold Leaf → Natural Altar. Aura chapter names tokens and generators."
	]
	quest.420000000011028B.title: "Ingot of the Depths"
	quest.420000000011028C.quest_desc: [
		"Marks a farm layout that draws aura into faster crop growth.",
		"How: Brilliant Fiber on trees → Gold Leaf → Natural Altar. Aura chapter names tokens and generators."
	]
	quest.420000000011028C.title: "Farming Stencil"
	quest.420000000011028D.quest_desc: [
		"Generates aura whenever a projectile lands nearby.",
		"How: Brilliant Fiber on trees → Gold Leaf → Natural Altar. Aura chapter names tokens and generators."
	]
	quest.420000000011028D.title: "Shooting Mark"
	quest.420000000011028E.quest_desc: [
		"Generates aura slowly from flowers blooming nearby.",
		"How: Brilliant Fiber on trees → Gold Leaf → Natural Altar. Aura chapter names tokens and generators."
	]
	quest.420000000011028E.title: "Herbivorous Absorber"
	quest.420000000011028F.quest_desc: [
		"Generates aura slowly from oak trees growing nearby.",
		"How: Brilliant Fiber on trees → Gold Leaf → Natural Altar. Aura chapter names tokens and generators."
	]
	quest.420000000011028F.title: "Canopy Diminisher"
	quest.4200000000110290.quest_desc: [
		"A flower from the end, oddly at home on a floating pad.",
		"How: Brilliant Fiber on trees → Gold Leaf → Natural Altar. Aura chapter names tokens and generators."
	]
	quest.4200000000110290.title: "Rose of Oblivion"
	quest.4200000000110291.quest_desc: [
		"Lights an area to keep hostile mobs from spawning there.",
		"How: Brilliant Fiber on trees → Gold Leaf → Natural Altar. Aura chapter names tokens and generators."
	]
	quest.4200000000110291.title: "Lamp of Sanctuary"
	quest.4200000000120292.quest_desc: [
		"Cooks stew-type meals that feed more than one plate at once.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.4200000000120292.title: "Cooking Pot (Kitchen)"
	quest.4200000000120293.quest_desc: [
		"Skillet pan fry meals.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.4200000000120293.title: "Skillet"
	quest.4200000000120294.quest_desc: [
		"Stove for Farmer's Delight.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.4200000000120294.title: "Stove"
	quest.4200000000120295.quest_desc: [
		"Cuts meat and vegetables into ingredients other recipes call for.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.4200000000120295.title: "Cutting Board (Kitchen)"
	quest.4200000000120296.quest_desc: [
		"Basket for farm haul.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.4200000000120296.title: "Basket"
	quest.4200000000120297.quest_desc: [
		"Climbable like a vine, and needed for several kitchen recipes.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.4200000000120297.title: "Rope"
	quest.4200000000120298.quest_desc: [
		"Catches a long fall and bounces you back up unharmed.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.4200000000120298.title: "Safety Net"
	quest.4200000000120299.quest_desc: [
		"Boosts nearby crop growth once it's tilled and planted.",
		"How: place Organic Compost and wait; it slowly matures into Rich Soil."
	]
	quest.4200000000120299.title: "Rich Soil (Kitchen)"
	quest.420000000012029A.quest_desc: [
		"Turns food scraps into compost for enriching soil.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.420000000012029A.title: "Organic Compost (Kitchen)"
	quest.420000000012029B.quest_desc: [
		"A hearty meal wrapped from cabbage, restores a solid chunk of hunger.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.420000000012029B.title: "Cabbage Rolls"
	quest.420000000012029C.quest_desc: [
		"Quick to cook, quick to eat, decent hunger for the effort.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.420000000012029C.title: "Bacon Sandwich"
	quest.420000000012029D.quest_desc: [
		"A layered meal that restores more hunger than the parts alone.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.420000000012029D.title: "Hamburger"
	quest.420000000012029E.quest_desc: [
		"A warming bowl that restores hunger and saturation together.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.420000000012029E.title: "Chicken Soup"
	quest.420000000012029F.quest_desc: [
		"Beef stew fills hard.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.420000000012029F.title: "Beef Stew"
	quest.42000000001202A0.quest_desc: [
		"Noodles and broth, filling enough for a full day's work.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.42000000001202A0.title: "Noodle Soup"
	quest.42000000001202A1.quest_desc: [
		"A baked dessert worth the wait, restores a generous chunk of hunger.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.42000000001202A1.title: "Apple Pie"
	quest.42000000001202A2.quest_desc: [
		"Tart and sweet, one of the richer desserts on the pad.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.42000000001202A2.title: "Sweet Berry Cheesecake"
	quest.42000000001202A3.quest_desc: [
		"Rice for kitchen line.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.42000000001202A3.title: "Rice"
	quest.42000000001202A4.quest_desc: [
		"Kitchen line comfort food.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.42000000001202A4.title: "Fried Rice"
	quest.42000000001202A5.quest_desc: [
		"Small filled parcels, quick to cook in batches.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.42000000001202A5.title: "Dumplings"
	quest.42000000001202A6.quest_desc: [
		"A warm drink brewed from cocoa beans and milk.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.42000000001202A6.title: "Hot Cocoa"
	quest.42000000001202A7.quest_desc: [
		"A cool drink pressed from melon, restores a little hunger fast.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.42000000001202A7.title: "Melon Juice"
	quest.42000000001202A8.quest_desc: [
		"Woven cloth used in several kitchen and decor recipes.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.42000000001202A8.title: "Canvas"
	quest.42000000001202A9.quest_desc: [
		"Soft woven flooring, a change of texture from plain wood.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.42000000001202A9.title: "Tatami"
	quest.42000000001302AA.quest_desc: [
		"The first book that lets you cast spells in a real fight.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: three chains, four leather and two paper. Spells chapter names ink."
	]
	quest.42000000001302AA.title: "Iron Spell Book"
	quest.42000000001302AB.quest_desc: [
		"Holds more spell slots than the iron book before it.",
		"How: Arcane Essence and ink, then a spellbook. Spells chapter names the ladder."
	]
	quest.42000000001302AB.title: "Gold Spell Book"
	quest.42000000001302AC.quest_desc: [
		"A sturdier book with even more room for spells.",
		"How: Arcane Essence and ink, then a spellbook. Spells chapter names the ladder."
	]
	quest.42000000001302AC.title: "Diamond Spell Book"
	quest.42000000001302AD.quest_desc: [
		"Fuels spellcasting and sits at the base of most spell recipes.",
		"How: kill casters or craft listed in JEI. Fuel for ink and books."
	]
	quest.42000000001302AD.title: "Arcane Essence (Spells)"
	quest.42000000001302AE.quest_desc: [
		"Scribe spells and pages.",
		"How: bottle + essence + dye. First inscription ink."
	]
	quest.42000000001302AE.title: "Common Ink"
	quest.42000000001302AF.quest_desc: [
		"Writes uncommon-tier spells and scrolls into a book.",
		"How: Arcane Essence and ink, then a spellbook. Spells chapter names the ladder."
	]
	quest.42000000001302AF.title: "Uncommon Ink"
	quest.42000000001302B0.quest_desc: [
		"Writes rare-tier spells and scrolls into a book.",
		"How: Arcane Essence and ink, then a spellbook. Spells chapter names the ladder."
	]
	quest.42000000001302B0.title: "Rare Ink"
	quest.42000000001302B1.quest_desc: [
		"Writes epic-tier spells and scrolls into a book.",
		"How: Arcane Essence and ink, then a spellbook. Spells chapter names the ladder."
	]
	quest.42000000001302B1.title: "Epic Ink"
	quest.42000000001302B2.quest_desc: [
		"Writes the rarest, strongest spells a book can hold.",
		"How: Arcane Essence and ink, then a spellbook. Spells chapter names the ladder."
	]
	quest.42000000001302B2.title: "Legendary Ink"
	quest.42000000001302B3.quest_desc: [
		"Casts a spell once without needing it learned in a book.",
		"How: Arcane Essence and ink, then a spellbook. Spells chapter names the ladder."
	]
	quest.42000000001302B3.title: "Scroll"
	quest.42000000001302B4.quest_desc: [
		"Magic cloth for robes.",
		"How: Arcane Essence and ink, then a spellbook. Spells chapter names the ladder."
	]
	quest.42000000001302B4.title: "Magic Cloth"
	quest.42000000001302B5.quest_desc: [
		"Light armor that favors spellcasting over raw defense.",
		"How: Arcane Essence and ink, then a spellbook. Spells chapter names the ladder."
	]
	quest.42000000001302B5.title: "Wandering Magician Helmet"
	quest.42000000001302B6.quest_desc: [
		"Chest armor built for casting speed rather than damage soaked.",
		"How: Arcane Essence and ink, then a spellbook. Spells chapter names the ladder."
	]
	quest.42000000001302B6.title: "Wandering Magician Chestplate"
	quest.42000000001302B7.quest_desc: [
		"A staff that channels fire spells with extra force.",
		"How: Arcane Essence and ink, then a spellbook. Spells chapter names the ladder."
	]
	quest.42000000001302B7.title: "Pyrium Staff"
	quest.42000000001302B8.quest_desc: [
		"A modest staff for a caster just starting out.",
		"How: Arcane Essence and ink, then a spellbook. Spells chapter names the ladder."
	]
	quest.42000000001302B8.title: "Graybeard Staff"
	quest.42000000001302B9.quest_desc: [
		"A blade that punishes spellcasters, cutting through their defenses.",
		"How: pack recipe, two Arcane Ingots up the diagonal with a chain either side and a diamond at the hilt. Its only wild carrier lives in evoker forts, which the pad never has."
	]
	quest.42000000001302B9.title: "Magehunter"
	quest.42000000001302BA.quest_desc: [
		"The earliest spell book, light on slots but easy to reach.",
		"How: Arcane Essence and ink, then a spellbook. Spells chapter names the ladder."
	]
	quest.42000000001302BA.title: "Copper Spell Book"
	quest.42000000001302BB.quest_desc: [
		"The strongest spell book, holding the most spell slots of all.",
		"How: four Arcane Cloth, two Blood Vials, a netherite ingot, a Bottle o' Lightning and a Ruined Book (pack recipe). JEI names it Ancient Codex."
	]
	quest.42000000001302BB.title: "Netherite Spell Book"
	quest.42000000001302BC.quest_desc: [
		"Refined metal used across the higher end of spellcasting gear.",
		"How: Arcane Essence and ink, then a spellbook. Spells chapter names the ladder."
	]
	quest.42000000001302BC.title: "Arcane Ingot"
	quest.42000000001302BD.quest_desc: [
		"A damaged book that can be pieced back into knowledge.",
		"How: pack recipe, an enchanted book ringed by four Arcane Essence and four soul sand. JEI names it Ruined Book."
	]
	quest.42000000001302BD.title: "Ruined Codex"
	quest.42000000001402BE.quest_desc: [
		"The first Solar Flux part. Cells, coatings and the Blank Upgrade are built from it.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: three glass over an iron ingot makes three Mirrors."
	]
	quest.42000000001402BE.title: "Mirror"
	quest.42000000001402BF.quest_desc: [
		"The first tier of solar cell, weak but cheap to stack.",
		"How: three glass, three lapis and three Mirrors, a row of each."
	]
	quest.42000000001402BF.title: "Photovoltaic Cell 1"
	quest.42000000001402C0.quest_desc: [
		"A stronger solar cell, a step up from the last tier.",
		"How: three clay balls, three lapis, two Mirrors and a Photovoltaic Cell I."
	]
	quest.42000000001402C0.title: "Photovoltaic Cell 2"
	quest.42000000001402C1.quest_desc: [
		"Mid tier solar cell, noticeably more output per panel.",
		"How: three glass, three glowstone dust, two obsidian and a Photovoltaic Cell II."
	]
	quest.42000000001402C1.title: "Photovoltaic Cell 3"
	quest.42000000001402C2.quest_desc: [
		"A high tier solar cell for a panel built to scale.",
		"How: three Blazing Coating, two glowstone dust, a diamond, two quartz blocks and a Photovoltaic Cell III."
	]
	quest.42000000001402C2.title: "Photovoltaic Cell 4"
	quest.42000000001402C3.quest_desc: [
		"Near the top tier, this cell pulls serious power from daylight.",
		"How: three Emerald Glass, two glowstone blocks, a diamond block, a quartz block and two Photovoltaic Cell IV. Makes two."
	]
	quest.42000000001402C3.title: "Photovoltaic Cell 5"
	quest.42000000001402C4.quest_desc: [
		"The strongest solar cell made, the ceiling for a single panel.",
		"How: three Ender Glass, two glowstone blocks, an emerald block, a quartz block and two Photovoltaic Cell V. Makes two."
	]
	quest.42000000001402C4.title: "Photovoltaic Cell 6"
	quest.42000000001402C5.quest_desc: [
		"Lets a solar panel hold a larger reserve of stored power.",
		"How: five redstone blocks, a diamond block and a Blank Upgrade."
	]
	quest.42000000001402C5.title: "Capacity Upgrade"
	quest.42000000001402C6.quest_desc: [
		"Squeezes more power out of the same sunlight.",
		"How: three Mirrors, a Blank Upgrade and a Photovoltaic Cell I."
	]
	quest.42000000001402C6.title: "Efficiency Upgrade"
	quest.42000000001402C7.quest_desc: [
		"Lets a solar panel send power out faster.",
		"How: six redstone and two gold ingots around a Blank Upgrade."
	]
	quest.42000000001402C7.title: "Transfer Upgrade"
	quest.42000000001402C8.quest_desc: [
		"Passes power on to the machines connected to the panel, within a few blocks.",
		"How: four iron ingots, two pistons and two redstone around a Blank Upgrade."
	]
	quest.42000000001402C8.title: "Traversal Upgrade"
	quest.42000000001402C9.quest_desc: [
		"Sends power to players standing near the panel.",
		"How: four glowstone dust and four Eyes of Ender around a Blank Upgrade."
	]
	quest.42000000001402C9.title: "Dispersive Upgrade"
	quest.42000000001402CA.quest_desc: [
		"Sends power to one linked block within range, no cable needed.",
		"How: four ender pearls and four redstone blocks around a Dispersive Upgrade."
	]
	quest.42000000001402CA.title: "Block Charging Upgrade"
	quest.42000000001402CB.quest_desc: [
		"Lets the panel smelt items using stored sunlight instead of fuel.",
		"How: five coal, a furnace and two Blazing Coating around a Blank Upgrade."
	]
	quest.42000000001402CB.title: "Furnace Upgrade"
	quest.42000000001402CC.quest_desc: [
		"Mirror glass set with an emerald. Ender Glass and Photovoltaic Cell V are built on it.",
		"How: an emerald between two Mirrors in a column makes two."
	]
	quest.42000000001402CC.title: "Emerald Glass"
	quest.42000000001402CD.quest_desc: [
		"Emerald Glass charged with pearls and an eye. Photovoltaic Cell VI is built on it.",
		"How: three Emerald Glass over an Eye of Ender between two ender pearls makes three."
	]
	quest.42000000001402CD.title: "Ender Glass"
	quest.42000000001402CE.quest_desc: [
		"A blaze-dusted Mirror finish. Photovoltaic Cell IV and the Furnace Upgrade use it.",
		"How: blaze powder between two Mirrors in a column makes two."
	]
	quest.42000000001402CE.title: "Blazing Coating"
	quest.42000000001402CF.quest_desc: [
		"An uncommitted upgrade item, crafted into any upgrade type.",
		"How: four cobblestone around a Mirror."
	]
	quest.42000000001402CF.title: "Blank Upgrade"
	quest.42000000001502D0.quest_desc: [
		"Plain, dependable stone for walls and floors.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: four stone in a square, or the stonecutter."
	]
	quest.42000000001502D0.title: "Stone Bricks"
	quest.42000000001502D1.quest_desc: [
		"Mossy brick pad trim.",
		"How: stone bricks plus vines or moss. Stonecutter after that."
	]
	quest.42000000001502D1.title: "Mossy Stone Bricks"
	quest.42000000001502D2.quest_desc: [
		"Weathered stone bricks with a worn, cracked look.",
		"How: smelt stone bricks."
	]
	quest.42000000001502D2.title: "Cracked Stone Bricks"
	quest.42000000001502D3.quest_desc: [
		"Carved stone bricks for trim and accent lines.",
		"How: two stone brick slabs, or the stonecutter."
	]
	quest.42000000001502D3.title: "Chiseled Stone Bricks"
	quest.42000000001502D4.quest_desc: [
		"A flat, even stone finish for floors.",
		"How: smelt stone. Slabs come from the stonecutter."
	]
	quest.42000000001502D4.title: "Smooth Stone"
	quest.42000000001502D5.quest_desc: [
		"Grey stone polished to a smooth finish.",
		"How: four andesite, or the stonecutter."
	]
	quest.42000000001502D5.title: "Polished Andesite"
	quest.42000000001502D6.quest_desc: [
		"Bright white stone, polished smooth.",
		"How: four diorite, or the stonecutter."
	]
	quest.42000000001502D6.title: "Polished Diorite"
	quest.42000000001502D7.quest_desc: [
		"Warm pink stone, polished for detailing.",
		"How: four granite, or the stonecutter."
	]
	quest.42000000001502D7.title: "Polished Granite"
	quest.42000000001502D8.quest_desc: [
		"Fired clay blocks, warm red against grey stone.",
		"How: four brick items. Clay balls smelt into bricks."
	]
	quest.42000000001502D8.title: "Bricks"
	quest.42000000001502D9.quest_desc: [
		"Pale, packed mud shaped into building trim.",
		"How: four packed mud. Mud is dirt plus a water bottle; mud and wheat make packed mud."
	]
	quest.42000000001502D9.title: "Mud Bricks"
	quest.42000000001502DA.quest_desc: [
		"Dark stone bricks pulled from the deep.",
		"How: polished deepslate in a square, or the stonecutter. Four deepslate pebbles (sieve dirt) make cobbled deepslate."
	]
	quest.42000000001502DA.title: "Deepslate Bricks"
	quest.42000000001502DB.quest_desc: [
		"Smooth dark tiles for a sleeker floor.",
		"How: deepslate bricks in a square, or the stonecutter."
	]
	quest.42000000001502DB.title: "Deepslate Tiles"
	quest.42000000001502DC.quest_desc: [
		"Dark nether stone, sturdy and plain.",
		"How: witch water poured into a lava barrel, or four blackstone pebbles. Bastions are built of it."
	]
	quest.42000000001502DC.title: "Blackstone"
	quest.42000000001502DD.quest_desc: [
		"Blackstone polished to a glossy dark sheen.",
		"How: four blackstone, or the stonecutter. Nether after Claw."
	]
	quest.42000000001502DD.title: "Polished Blackstone"
	quest.42000000001502DE.quest_desc: [
		"Blackstone flecked with gold, rare and decorative.",
		"How: Nether bastion after Claw obsidian. A Decor leaf, not a later gate."
	]
	quest.42000000001502DE.title: "Gilded Blackstone"
	quest.42000000001502DF.quest_desc: [
		"Bright white block, a pad decor staple.",
		"How: four nether quartz. Nether after Claw."
	]
	quest.42000000001502DF.title: "Quartz Block"
	quest.42000000001502E0.quest_desc: [
		"Quartz smoothed flat for clean trim work.",
		"How: smelt a quartz block."
	]
	quest.42000000001502E0.title: "Smooth Quartz"
	quest.42000000001502E1.quest_desc: [
		"Purple end stone, an odd accent piece.",
		"How: four popped chorus. Chorus fruit is the Edge-walkers' stall."
	]
	quest.42000000001502E1.title: "Purpur Block"
	quest.42000000001502E2.quest_desc: [
		"Sea-born stone with a faint blue shimmer.",
		"How: needs prismarine shards. Ocean-only. Optional."
	]
	quest.42000000001502E2.title: "Prismarine"
	quest.42000000001502E3.quest_desc: [
		"A darker prismarine, good for deep accents.",
		"How: needs prismarine shards. Ocean-only. Optional."
	]
	quest.42000000001502E3.title: "Dark Prismarine"
	quest.42000000001502E4.quest_desc: [
		"A steady light pulled from the ocean floor.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001502E4.title: "Sea Lantern"
	quest.42000000001502E5.quest_desc: [
		"A warm orange light grown from nether fungus.",
		"How: grows on huge fungi. Plant a fungus on nylium and bone-meal it."
	]
	quest.42000000001502E5.title: "Shroomlight"
	quest.42000000001502E6.quest_desc: [
		"A soft yellow light with no flame at all.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001502E6.title: "Ochre Froglight"
	quest.42000000001502E7.quest_desc: [
		"A pale, glowing light with a pearled sheen.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001502E7.title: "Pearlescent Froglight"
	quest.42000000001502E8.quest_desc: [
		"A cool green light, flameless and safe indoors.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001502E8.title: "Verdant Froglight"
	quest.42000000001502E9.quest_desc: [
		"Glass that blocks light but keeps the view.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001502E9.title: "Tinted Glass"
	quest.42000000001502EA.quest_desc: [
		"Soft white glass for gentle window light.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001502EA.title: "White Stained Glass"
	quest.42000000001502EB.quest_desc: [
		"Pale blue glass, close to open sky.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001502EB.title: "Light Blue Stained Glass"
	quest.42000000001502EC.quest_desc: [
		"Cool teal glass for a calmer room.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001502EC.title: "Cyan Stained Glass"
	quest.42000000001502ED.quest_desc: [
		"Deep purple glass, a nod to the void below.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001502ED.title: "Purple Stained Glass"
	quest.42000000001502EE.quest_desc: [
		"A small steady flame for mood lighting.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001502EE.title: "Candle"
	quest.42000000001502EF.quest_desc: [
		"A pale candle, subtle against light walls.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001502EF.title: "White Candle"
	quest.42000000001502F0.quest_desc: [
		"Climb the pad edge safely.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001502F0.title: "Scaffolding Tower"
	quest.42000000001502F1.quest_desc: [
		"Ladders for vertical pads.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001502F1.title: "Ladder Stock"
	quest.42000000001502F2.quest_desc: [
		"Rails across the void.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001502F2.title: "Rail Spare"
	quest.42000000001502F3.quest_desc: [
		"Keeps you afloat if the pad ever meets water.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001502F3.title: "Oak Boat"
	quest.42000000001502F4.quest_desc: [
		"Decor for the pad walls.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001502F4.title: "Painting Spare"
	quest.42000000001502F5.quest_desc: [
		"Displays a full set of armor on the pad.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001502F5.title: "Armor Stand"
	quest.42000000001502F6.quest_desc: [
		"Holds a displayed item that never goes dark.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001502F6.title: "Glow Item Frame"
	quest.42000000001502F7.quest_desc: [
		"Flower pots for green.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001502F7.title: "Flower Pot Spare"
	quest.42000000001502F8.quest_desc: [
		"Hanging signs for rooms.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001502F8.title: "Oak Hanging Sign"
	quest.42000000001502F9.quest_desc: [
		"Loom for banner work.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001502F9.title: "Loom"
	quest.42000000001502FA.quest_desc: [
		"Cuts stone into precise shapes without the waste.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001502FA.title: "Stonecutter"
	quest.42000000001502FB.quest_desc: [
		"Repairs tools and strips unwanted enchantments.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001502FB.title: "Grindstone"
	quest.42000000001502FC.quest_desc: [
		"Upgrades gear with smithing templates and netherite.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001502FC.title: "Smithing Table"
	quest.42000000001502FD.quest_desc: [
		"Chart the island grid.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001502FD.title: "Cartography Table"
	quest.42000000001502FE.quest_desc: [
		"A villager workstation, mostly decorative on the pad.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001502FE.title: "Fletching Table"
	quest.42000000001502FF.quest_desc: [
		"Smelts ores twice as fast as a plain furnace.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001502FF.title: "Blast Furnace Spare"
	quest.4200000000150300.quest_desc: [
		"Cooks food twice as fast as a plain furnace.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000150300.title: "Smoker Spare"
	quest.4200000000150301.quest_desc: [
		"Holds a small amount of water, dye, or potion.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000150301.title: "Cauldron"
	quest.4200000000150302.quest_desc: [
		"Moves items automatically between containers below and above.",
		"How: five iron around a chest. Sit it under a Loomframe or Tension Barrel (extract DOWN)."
	]
	quest.4200000000150302.title: "Hopper Spare"
	quest.4200000000150303.quest_desc: [
		"Fires or uses whatever item is loaded into it.",
		"How: cobble, bow, and redstone."
	]
	quest.4200000000150303.title: "Dispenser Spare"
	quest.4200000000150304.quest_desc: [
		"Pulses redstone whenever the block in front changes.",
		"How: cobble, redstone, and nether quartz."
	]
	quest.4200000000150304.title: "Observer Spare"
	quest.4200000000150305.quest_desc: [
		"A constant, strong redstone signal in block form.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000150305.title: "Redstone Block"
	quest.4200000000150306.quest_desc: [
		"Sends a signal strength based on how well it's hit.",
		"How: redstone around hay. Hay is three wheat."
	]
	quest.4200000000150306.title: "Target Spare"
	quest.4200000000150307.quest_desc: [
		"Plays one note when struck or powered. Tune it by hand.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000150307.title: "Note Block Spare"
	quest.4200000000150308.quest_desc: [
		"Plays music discs across the pad.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000150308.title: "Jukebox Spare"
	quest.4200000000150309.quest_desc: [
		"Bell marks the Clowder.",
		"How: no crafting recipe. Occultism's Contact Wild Spirit ritual makes one but needs a goat, and goats never reach the pad. Optional."
	]
	quest.4200000000150309.title: "Bell Spare"
	quest.420000000015030A.quest_desc: [
		"Sets your respawn point in the nether, charged with glowstone.",
		"How: crying obsidian plus glowstone. Nether-only respawn."
	]
	quest.420000000015030A.title: "Respawn Anchor"
	quest.420000000015030B.quest_desc: [
		"Locks a compass to this exact block instead of spawn.",
		"How: netherite ingot in chiseled stone bricks. Late Clowder luxury."
	]
	quest.420000000015030B.title: "Lodestone Spare"
	quest.420000000015030C.quest_desc: [
		"Draws lightning strikes safely away from the pad.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.420000000015030C.title: "Lightning Rod Spare"
	quest.420000000015030D.quest_desc: [
		"A personal storage space that follows you everywhere you go.",
		"How: eight obsidian around an Eye of Ender. Eye is pearl plus blaze powder."
	]
	quest.420000000015030D.title: "Ender Chest"
	quest.420000000015030E.quest_desc: [
		"Crafts into a shulker box for stackable, safe storage.",
		"How: pack recipe, six purpur blocks, two ender pearls and a Binding Knot. Shulkers never spawn here. Optional."
	]
	quest.420000000015030E.title: "Shulker Shell"
	quest.420000000016030F.quest_desc: [
		"The floor and walls of anywhere you're building over lava.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: the Nether here is void, not terrain. Pour lava into an Ex Deorum barrel of witch water (a water barrel standing on mycelium; mycelium spores sieve from dirt)."
	]
	quest.420000000016030F.title: "Netherrack Stock"
	quest.4200000000160310.quest_desc: [
		"Fired mudstone braced with quartz. Holds shape near fire.",
		"How: smelt netherrack, then four nether brick items."
	]
	quest.4200000000160310.title: "Nether Bricks"
	quest.4200000000160311.quest_desc: [
		"Nether wart baked into brick. Warmer color, same strength.",
		"How: nether bricks plus nether wart. Nether after Claw."
	]
	quest.4200000000160311.title: "Red Nether Bricks"
	quest.4200000000160312.quest_desc: [
		"Cooled magma column, cut into blocks for a foothold.",
		"How: lava flowing over soul soil beside blue ice, or four basalt pebbles from sieved crushed blackstone."
	]
	quest.4200000000160312.title: "Basalt"
	quest.4200000000160313.quest_desc: [
		"Basalt sanded smooth. Reads as stone, not scaffolding.",
		"How: stonecutter, or four basalt."
	]
	quest.4200000000160313.title: "Polished Basalt"
	quest.4200000000160314.quest_desc: [
		"Basalt without the ridges. Good for flat floors and trim.",
		"How: smelt basalt."
	]
	quest.4200000000160314.title: "Smooth Basalt"
	quest.4200000000160315.quest_desc: [
		"The Nether's cobblestone. Craft it toward tools and bricks.",
		"How: witch water poured into a lava barrel, or four blackstone pebbles. Bastions are built of it."
	]
	quest.4200000000160315.title: "Blackstone Stock"
	quest.4200000000160316.quest_desc: [
		"Warms nearby water to a boil and hurts bare feet.",
		"How: four magma cream. A slime ball in a lava barrel makes cream."
	]
	quest.4200000000160316.title: "Magma Block"
	quest.4200000000160317.quest_desc: [
		"Soul sand foothold stock.",
		"How: sand into an Ex Deorum barrel of witch water. Fortress wart rooms hold a little. Three skulls on soul sand make a Wither."
	]
	quest.4200000000160317.title: "Soul Sand Stock"
	quest.4200000000160318.quest_desc: [
		"Lets soul fire and soul torches burn instead of ordinary flame.",
		"How: soul sand dropped into an Ex Deorum lava barrel."
	]
	quest.4200000000160318.title: "Soul Soil"
	quest.4200000000160319.quest_desc: [
		"Crushes into four dust, or lights a room without smoke.",
		"How: four glowstone dust. Dust sieves from soul sand."
	]
	quest.4200000000160319.title: "Glowstone"
	quest.420000000016031A.quest_desc: [
		"A fungus that glows on its own. No wiring needed.",
		"How: grows on huge fungi. Plant a fungus on nylium and bone-meal it."
	]
	quest.420000000016031A.title: "Shroomlight Stock"
	quest.420000000016031B.quest_desc: [
		"Nine wart bundled into a block. Mostly decoration and dye.",
		"How: nine nether wart. Wart sieves from soul sand or grows in fortress gardens."
	]
	quest.420000000016031B.title: "Nether Wart Block"
	quest.420000000016031C.quest_desc: [
		"Blue cousin of the crimson block. Same recipe, cooler color.",
		"How: grows on huge warped fungi. Bone-meal a warped fungus on warped nylium."
	]
	quest.420000000016031C.title: "Warped Wart Block"
	quest.420000000016031D.quest_desc: [
		"Wood that isn't wood. Strips and planks like any log.",
		"How: crimson nylium spores (sieve crushed netherrack) on netherrack, bone-meal the nylium for a fungus, then bone-meal the fungus."
	]
	quest.420000000016031D.title: "Crimson Stem"
	quest.420000000016031E.quest_desc: [
		"The other fungus trunk. Planks come out blue instead of red.",
		"How: warped nylium spores (sieve crushed netherrack) on netherrack, bone-meal the nylium for a fungus, then bone-meal the fungus."
	]
	quest.420000000016031E.title: "Warped Stem"
	quest.420000000016031F.quest_desc: [
		"Chain for hanging flair.",
		"How: crimson forests after Claw. Hang from the ceiling."
	]
	quest.420000000016031F.title: "Weeping Vines"
	quest.4200000000160320.quest_desc: [
		"Climbs a warped forest and marks a foothold in the haze.",
		"How: warped forests after Claw. Grow up from nylium."
	]
	quest.4200000000160320.title: "Twisting Vines"
	quest.4200000000160321.quest_desc: [
		"Weeps purple light and anchors a respawn point in the Nether.",
		"How: bastion chests, piglin barter, or Draconic bees working obsidian. Ruined portals do not generate here."
	]
	quest.4200000000160321.title: "Crying Obsidian"
	quest.4200000000160322.quest_desc: [
		"Buried below the ordinary ores. Smelt it toward netherite.",
		"How: hammer blackstone to crushed blackstone and sieve it. Bastion chests hold a little."
	]
	quest.4200000000160322.title: "Ancient Debris"
	quest.4200000000160323.quest_desc: [
		"Four scraps and four gold ingots make one netherite ingot.",
		"How: smelt ancient debris. Four scrap plus gold makes an ingot."
	]
	quest.4200000000160323.title: "Netherite Scrap"
	quest.4200000000160324.quest_desc: [
		"The hardest metal a Skybound hand will ever hold.",
		"How: four scrap plus four gold. Debris is rare Nether after Claw."
	]
	quest.4200000000160324.title: "Netherite Ingot"
	quest.4200000000160325.quest_desc: [
		"Fuels brewing stands and blast furnaces both. Keep a stack spare.",
		"How: Nether fortress after Claw obsidian. Brewing wants a rod; Ars and Occultism do not wait on it."
	]
	quest.4200000000160325.title: "Blaze Rod Stock"
	quest.4200000000160326.quest_desc: [
		"The regeneration potion needs one, plus patience near a ghast.",
		"How: Nether ghasts after Claw obsidian."
	]
	quest.4200000000160326.title: "Ghast Tear"
	quest.4200000000160327.quest_desc: [
		"Brews into fire resistance, or crafts back into a magma block.",
		"How: a slime ball dropped into a lava barrel, slime plus blaze powder, or magma cubes."
	]
	quest.4200000000160327.title: "Magma Cream"
	quest.4200000000160328.quest_desc: [
		"Three summon a wither. One looks fine on a shelf too.",
		"How: Nether fortress after Claw obsidian. Three skulls start a Wither."
	]
	quest.4200000000160328.title: "Wither Skeleton Skull"
	quest.4200000000160329.quest_desc: [
		"Piglins trade for gold. Nuggets work as well as ingots.",
		"How: one ingot makes nine, or Nether gold ore."
	]
	quest.4200000000160329.title: "Gold Nugget Pile"
	quest.420000000016032A.quest_desc: [
		"Smelts to gold and mines faster than the ore it's named for.",
		"How: Mekanism Combiner, eight raw gold plus netherrack. The void Nether has no ore."
	]
	quest.420000000016032A.title: "Nether Gold Ore"
	quest.420000000016032B.quest_desc: [
		"Bright white stone that builds and channels comparator signals both.",
		"How: sieve soul sand, or piglin barter."
	]
	quest.420000000016032B.title: "Quartz"
	quest.420000000016032C.quest_desc: [
		"Thrown, it starts a fire. Loaded in a dispenser, it does too.",
		"How: blaze powder, coal, and gunpowder."
	]
	quest.420000000016032C.title: "Fire Charge"
	quest.4200000000178001.quest_desc: [
		"Twelve portal frames are not a pad craft, so the End is a bite away instead.",
		"Eat it to stand on the End's obsidian pad; eat the half that is left to come home to the spot you ate from.",
		"How: five ender pearls, two bones and two blaze powder at a crafting table."
	]
	quest.4200000000178001.title: "End Apple"
	quest.420000000017032D.quest_desc: [
		"Pale stone from the far side. Heavy, plain, and endless.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: chorus fruit and ender pearls (Edge-walkers' stall) around a Binding Knot. Yields eight. The End island is gone."
	]
	quest.420000000017032D.title: "End Stone"
	quest.420000000017032E.quest_desc: [
		"End stone cut square, for cleaner lines on an end pad.",
		"How: four End Stone in a square, or the stonecutter. End Stone is the Knot craft."
	]
	quest.420000000017032E.title: "End Stone Bricks"
	quest.420000000017032F.quest_desc: [
		"Grown from chorus fruit, then baked into building stone.",
		"How: four popped chorus. Chorus fruit is the Edge-walkers' stall."
	]
	quest.420000000017032F.title: "Purpur Block Stock"
	quest.4200000000170330.quest_desc: [
		"Purpur with a column pattern, oriented however you place it.",
		"How: two purpur slabs, or stonecutter. Popped chorus first."
	]
	quest.4200000000170330.title: "Purpur Pillar"
	quest.4200000000170331.quest_desc: [
		"A cold light that never flickers and doubles as a rail post.",
		"How: blaze rod plus popped chorus. Nether after Claw; chorus is Edge-walkers' stall."
	]
	quest.4200000000170331.title: "End Rod"
	quest.4200000000170332.quest_desc: [
		"Eat it and you teleport a short, unpredictable hop.",
		"How: Edge-walkers' stall at /clowder hub. Outer End islands are gone."
	]
	quest.4200000000170332.title: "Chorus Fruit"
	quest.4200000000170333.quest_desc: [
		"Chorus fruit cooked. Crafts into purpur and dyes without teleporting you.",
		"How: smelt chorus fruit from the Edge-walkers' stall."
	]
	quest.4200000000170333.title: "Popped Chorus"
	quest.4200000000170334.quest_desc: [
		"Throw it and you arrive where it lands, minus some health.",
		"How: endermen, or /clowder hub Edge-walkers' stall."
	]
	quest.4200000000170334.title: "Ender Pearl Stock"
	quest.4200000000170335.quest_desc: [
		"Eyes of Ender stock.",
		"How: pearl (Edge-walkers' stall / endermen) plus blaze powder from a Nether fortress after Claw obsidian. Eight-eye stock is optional; End crystals use the same craft."
	]
	quest.4200000000170335.title: "Eye of Ender Stock"
	quest.4200000000170336.quest_desc: [
		"Dragon breath for potions.",
		"How: glass bottle on the dragon. The End island is gone. Optional."
	]
	quest.4200000000170336.title: "Dragon Breath Stock"
	quest.4200000000170337.quest_desc: [
		"The dragon's only trophy. It never sits still when clicked.",
		"Rare reward: one shared Clowder life, once for the entire team. Only six such rewards exist in the campaign.",
		"How: the dragon is gone with the End island. Optional trophy — it does not gate Ender Chests."
	]
	quest.4200000000170337.title: "Dragon Egg Show"
	quest.4200000000170338.quest_desc: [
		"Elytra for skybound travel.",
		"Optional — the void may never offer one.",
		"How: End cities are gone. Optional."
	]
	quest.4200000000170338.title: "Elytra Show"
	quest.4200000000170339.quest_desc: [
		"Shulker shells for boxes.",
		"Optional — no shulkers here, so the pack crafts shells instead.",
		"How: pack recipe, six purpur blocks, two ender pearls and a Binding Knot. Shulkers never spawn here. Optional."
	]
	quest.4200000000170339.title: "Shulker Shell Stock"
	quest.420000000017033A.quest_desc: [
		"A portable chest that keeps its contents when you break it.",
		"Optional — the Edge-walkers in Clowder Hall sell one.",
		"How: two Shulker Shells around a chest (shells are a pack recipe), or the Edge-walkers' stall at /clowder hub for 22 Thread Skeins (198 Thread). Optional."
	]
	quest.420000000017033A.title: "Shulker Box Show"
	quest.420000000017033B.quest_desc: [
		"End crystals — handle gently.",
		"How: glass, eye of ender, ghast tear. Nether after Claw obsidian; the egg is optional."
	]
	quest.420000000017033B.title: "End Crystal Show"
	quest.420000000017033C.quest_desc: [
		"Every ender chest on every pad shares one hidden storage.",
		"How: eight obsidian around an Eye of Ender. Eye is pearl plus blaze powder."
	]
	quest.420000000017033C.title: "Ender Chest Show"
	quest.420000000017033D.quest_desc: [
		"Plant it on end stone and it grows chorus fruit upward.",
		"How: outer End islands are gone. Chorus fruit is the Edge-walkers' stall. Optional."
	]
	quest.420000000017033D.title: "Chorus Flower"
	quest.420000000017033E.quest_desc: [
		"Twelve of these, filled with eyes, open the way to the end.",
		"How: not a pad craft. Optional."
	]
	quest.420000000017033E.title: "End Portal Frame"
	quest.420000000017033F.quest_desc: [
		"Concrete powder set solid. Void-dark and permanent once it cures.",
		"How: concrete powder plus water. Powder is sand, gravel, and dye."
	]
	quest.420000000017033F.title: "Black Concrete"
	quest.4200000000170340.quest_desc: [
		"A loud accent color for a quiet, pale biome.",
		"How: concrete powder plus water. Powder is sand, gravel, and dye."
	]
	quest.4200000000170340.title: "Purple Concrete"
	quest.4200000000170341.quest_desc: [
		"Cooled lava on contact with water. Blast resistant, slow to mine.",
		"How: water on a lava source (or lava on water). Keep the lava source."
	]
	quest.4200000000170341.title: "Obsidian Stock"
	quest.4200000000170342.quest_desc: [
		"Glows faintly and, charged, launches you from a respawn anchor.",
		"How: bastion chests, piglin barter, or Draconic bees working obsidian. Ruined portals do not generate here."
	]
	quest.4200000000170342.title: "Crying Obsidian Stock"
	quest.4200000000170343.quest_desc: [
		"Charge it with glowstone to set a Nether respawn point.",
		"How: crying obsidian plus glowstone. Nether-only respawn."
	]
	quest.4200000000170343.title: "Respawn Anchor Show"
	quest.4200000000170344.quest_desc: [
		"Held in the off-hand, it cancels one otherwise fatal hit.",
		"How: quest rewards only. Seat Clock and Seat Sigil give one each, and the late Strand Knot gifts offer more. Raids and evokers never come to the pad. Optional."
	]
	quest.4200000000170344.title: "Totem Show"
	quest.4200000000170345.quest_desc: [
		"The wither's only drop. A beacon needs one to light up.",
		"How: Wither (three skulls on soul sand), or the Drumhearts' stall at /clowder hub once, for 12 Thread Bolts (972 Thread). Optional trophy — it does not gate End or Mob Farm 100%."
	]
	quest.4200000000170345.title: "Nether Star Show"
	quest.4200000000170346.quest_desc: [
		"Powered by a pyramid of mineral blocks, it grants standing buffs.",
		"How: nether star, glass, and obsidian. Optional trophy — ocean leaves hang off Obsidian Stock."
	]
	quest.4200000000170346.title: "Beacon Show"
	quest.4200000000170347.quest_desc: [
		"Surrounded by prismarine, it grants water breathing and haste underwater.",
		"Optional — the void may never offer one.",
		"How: needs Heart of the Sea and nautilus. Ocean-only. Optional."
	]
	quest.4200000000170347.title: "Conduit Show"
	quest.4200000000170348.quest_desc: [
		"Eight ring a conduit and one crafts into the sea's compass.",
		"Optional — the void may never offer one.",
		"How: ocean-only. Optional."
	]
	quest.4200000000170348.title: "Nautilus Shell"
	quest.4200000000170349.quest_desc: [
		"A drowned's rare drop. Throw it, or channel lightning in a storm.",
		"How: drowned only. Optional."
	]
	quest.4200000000170349.title: "Trident Show"
	quest.420000000018034A.quest_desc: [
		"Base essence. Feeds growth accelerators and reprocessors alike.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: Mystical Agriculture craft in JEI. Inferium and Prosperity come from the sieve; seeds are infused on the Infusion Altar."
	]
	quest.420000000018034A.title: "Inferium Stock"
	quest.420000000018034B.quest_desc: [
