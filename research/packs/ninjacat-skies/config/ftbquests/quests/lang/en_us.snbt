		"Partitions a storage cell into several smaller pools.",
		"How: Spindle Network — certus from sand, controller wants a Knot."
	]
	quest.42000000001D0497.title: "Cell Workbench"
	quest.42000000001E0498.quest_desc: [
		"Clay and bone meal, a step toward porcelain tools.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: clay ball + bone meal, shapeless. Clay comes from the Tension Barrel."
	]
	quest.42000000001E0498.title: "Porcelain Clay (Voidcraft)"
	quest.42000000001E0499.quest_desc: [
		"A lighter bucket, easier on an early grit budget.",
		"How: shape porcelain clay into an unfired bucket, then smelt it."
	]
	quest.42000000001E0499.title: "Porcelain Bucket"
	quest.42000000001E049A.quest_desc: [
		"Melts blocks down into liquid over a fire.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000001E049A.title: "Porcelain Crucible (Voidcraft)"
	quest.42000000001E049B.quest_desc: [
		"The first sieve mesh; slow but it works.",
		"How: nine string in a 3x3. The Grit-singers' stall sells the Voidloom string thread mesh, which sieves the same."
	]
	quest.42000000001E049B.title: "String Mesh (Voidcraft)"
	quest.42000000001E049C.quest_desc: [
		"Sieves faster than string, worth the upgrade.",
		"How: four flint and five string in a checker. Flint is gravel, or Thread + gravel."
	]
	quest.42000000001E049C.title: "Flint Mesh (Voidcraft)"
	quest.42000000001E049D.quest_desc: [
		"A solid middle mesh for steady sieving.",
		"How: four iron ingots and five string in a checker. No stall sells it."
	]
	quest.42000000001E049D.title: "Iron Mesh (Voidcraft)"
	quest.42000000001E049E.quest_desc: [
		"Turns up rarer drops than iron will.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000001E049E.title: "Golden Mesh (Voidcraft)"
	quest.42000000001E049F.quest_desc: [
		"Sieves fast enough to keep a hopper line fed.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000001E049F.title: "Diamond Mesh (Voidcraft)"
	quest.42000000001E04A0.quest_desc: [
		"The best mesh a sieve will ever hold.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.42000000001E04A0.title: "Netherite Mesh (Voidcraft)"
	quest.42000000001E04A1.quest_desc: [
		"Spun from string, the Loom's own fiber.",
		"How: four string → two yarn. Tension Barrel: string + pearl. Four Loom Lint."
	]
	quest.42000000001E04A1.title: "Void Yarn Stock"
	quest.42000000001E04A2.quest_desc: [
		"The Loom's soft gate: posts, presses and controllers all want one.",
		"How: Void Yarn ring around a slime ball."
	]
	quest.42000000001E04A2.title: "Binding Knot Stock"
	quest.42000000001E04A3.quest_desc: [
		"A void-loom take on the basic sieve mesh.",
		"How: string around yarn. The Grit-singers' stall sells one."
	]
	quest.42000000001E04A3.title: "Thread Mesh String"
	quest.42000000001E04A4.quest_desc: [
		"A void-loom mesh, a step above plain string.",
		"How: flint around a string thread mesh."
	]
	quest.42000000001E04A4.title: "Thread Mesh Flint"
	quest.42000000001E04A5.quest_desc: [
		"A void-loom mesh built for steady output.",
		"How: iron around a flint thread mesh. Strand Filament starts here."
	]
	quest.42000000001E04A5.title: "Thread Mesh Iron"
	quest.42000000001E04A6.quest_desc: [
		"Breaks grit a step finer: cobble to gravel, gravel to sand, sand to dust.",
		"How: cobble + sticks. Break grit into gravel, sand, dust."
	]
	quest.42000000001E04A6.title: "Spindle Hammer (Voidcraft)"
	quest.42000000001E04A7.quest_desc: [
		"Strips leaves for saplings and silkworms.",
		"How: four sticks. The Grit-singers' stall sells one."
	]
	quest.42000000001E04A7.title: "Spindle Crook"
	quest.42000000001E04A8.quest_desc: [
		"The Loom's sieve frame: stretch a mesh on it and feed it grit.",
		"How: planks around a Binding Knot. Stretch a mesh, hopper grit in, sit it on a hopper."
	]
	quest.42000000001E04A8.title: "Loomframe"
	quest.42000000001E04A9.quest_desc: [
		"Water and dirt become clay; string and a pearl become yarn.",
		"How: planks, string, and Void Yarn. Pour water (bucket returns), add dirt → clay."
	]
	quest.42000000001E04A9.title: "Tension Barrel (Voidcraft)"
	quest.42000000001E04AA.quest_desc: [
		"Nine blocks of dirt folded into one for the trip up.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
