	quest.4200000000190399.title: "Ring of Quartz"
	quest.420000000019039A.quest_desc: [
		"Nether bricks around a flower: magmatic.",
		"How: ring of the nest material around a small flower. Place it, then right-click it with a small flower to wake it; bees come out after a while."
	]
	quest.420000000019039A.title: "Ring of Nether Brick"
	quest.420000000019039B.quest_desc: [
		"Soul sand around a flower: ghostly.",
		"How: ring of the nest material around a small flower. Place it, then right-click it with a small flower to wake it; bees come out after a while."
	]
	quest.420000000019039B.title: "Ring of Soul Sand"
	quest.420000000019039C.quest_desc: [
		"End stone around a flower: ender bees, and the far end of breeding.",
		"How: ring of the nest material around a small flower. Place it, then right-click it with a small flower to wake it; bees come out after a while."
	]
	quest.420000000019039C.title: "Ring of End Stone"
	quest.420000000019039D.quest_desc: [
		"Obsidian around a flower: draconic. Do not ask what it eats.",
		"How: ring of the nest material around a small flower. Place it, then right-click it with a small flower to wake it; bees come out after a while."
	]
	quest.420000000019039D.title: "Ring of Obsidian"
	quest.420000000019039E.quest_desc: [
		"A proper hive with more slots than a wild nest.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.420000000019039E.title: "Advanced Oak Hive"
	quest.420000000019039F.quest_desc: [
		"Bolts onto a hive to add more bee living space.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.420000000019039F.title: "Expansion Box (Apiary)"
	quest.42000000001903A0.quest_desc: [
		"Traps a bee in glass so you can carry it.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.42000000001903A0.title: "Jar Oak"
	quest.42000000001903A1.quest_desc: [
		"Cage bees for moving hives.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.42000000001903A1.title: "Bee Cage (Apiary)"
	quest.42000000001903A2.quest_desc: [
		"Holds a bee safely for transport between pads.",
		"How: village chests only, and the void has no villages. Optional."
	]
	quest.42000000001903A2.title: "Sturdy Cage"
	quest.42000000001903A3.quest_desc: [
		"Scoops bees into jars automatically, no net required.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.42000000001903A3.title: "Catcher (Apiary)"
	quest.42000000001903A4.quest_desc: [
		"Keeps a hive fed so the bees keep working.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.42000000001903A4.title: "Feeder"
	quest.42000000001903A5.quest_desc: [
		"Fills bottles from a hive's stored honey.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.42000000001903A5.title: "Bottler (Apiary)"
	quest.42000000001903A6.quest_desc: [
		"Spins honeycomb apart into honey, wax, and combs.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.42000000001903A6.title: "Centrifuge (Apiary)"
	quest.42000000001903A7.quest_desc: [
		"A centrifuge that spins on its own once powered.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.42000000001903A7.title: "Powered Centrifuge (Apiary)"
	quest.42000000001903A8.quest_desc: [
		"Spins faster with a heat source feeding it.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.42000000001903A8.title: "Heated Centrifuge"
	quest.42000000001903A9.quest_desc: [
		"Hatches bee larvae into new bees with useful traits.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.42000000001903A9.title: "Incubator (Apiary)"
	quest.42000000001903AA.quest_desc: [
		"Pairs two bees and produces offspring with mixed traits.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.42000000001903AA.title: "Breeding Chamber (Apiary)"
	quest.42000000001903AB.quest_desc: [
		"Reads a bee's traits and records them for breeding.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.42000000001903AB.title: "Gene Indexer (Apiary)"
	quest.42000000001903AC.quest_desc: [
		"Burns honey for a slow, steady trickle of power.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.42000000001903AC.title: "Honey Generator (Apiary)"
	quest.42000000001903AD.quest_desc: [
		"A snack that keeps a caged bee calm and healthy.",
		"How: honeycomb plus a honey bottle, shapeless."
	]
	quest.42000000001903AD.title: "Honey Treat (Apiary)"
	quest.42000000001903AE.quest_desc: [
		"A full bucket of honey, ready to pour or burn.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.42000000001903AE.title: "Honey Bucket"
	quest.42000000001903AF.quest_desc: [
		"Melts down for candles or seals a hive's frame.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.42000000001903AF.title: "Wax Stock"
	quest.42000000001903B0.quest_desc: [
		"A honeycomb that can be tuned to match any bee.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.42000000001903B0.title: "Configurable Comb"
	quest.42000000001903B1.quest_desc: [
		"A bee's traits, extracted and ready to bottle.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.42000000001903B1.title: "Gene Sample"
	quest.42000000001903B2.quest_desc: [
		"One bee's genetics, stored for later breeding.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.42000000001903B2.title: "Gene Bottle"
	quest.42000000001903B3.quest_desc: [
		"Four combs pressed solid, mostly for building with.",
		"How: four honeycomb."
	]
	quest.42000000001903B3.title: "Honeycomb Block"
	quest.42000000001903B4.quest_desc: [
		"Slows falls and movement. Sticky underfoot, sweet in a hopper.",
		"How: four honey bottles. Bottles return."
	]
	quest.42000000001903B4.title: "Honey Block (Apiary)"
	quest.42000000001903B5.quest_desc: [
		"A wild hive. Smoke it calm before you take the comb.",
		"How: three honeycomb and six planks. Campfire underneath calms them."
	]
	quest.42000000001903B5.title: "Beehive Vanilla"
	quest.42000000001903B6.quest_desc: [
		"Smoke from below keeps bees calm during harvest.",
		"How: logs, sticks, and coal or charcoal."
	]
	quest.42000000001903B6.title: "Campfire Under"
	quest.42000000001903B7.quest_desc: [
		"Flowers for bee work.",
		"How: bone-meal grass, or a small flower for the oak nest."
	]
	quest.42000000001903B7.title: "Flower Carpet"
	quest.42000000001903B8.quest_desc: [
		"More flowers nearby means more pollen for the hive.",
		"How: bone-meal grass. Bees want any small flower."
	]
	quest.42000000001903B8.title: "Dandelion Field"
	quest.42000000001903B9.quest_desc: [
		"A showier flower that some bees prefer over dandelions.",
		"How: moss plus oak, or bone-meal moss. Bees accept the bloom."
	]
	quest.42000000001903B9.title: "Azalea Bloom"
	quest.42000000001903BA.quest_desc: [
		"An end fruit some bees will happily forage from.",
		"How: Edge-walkers' stall at /clowder hub. Outer End islands are gone."
	]
	quest.42000000001903BA.title: "Chorus Snack"
	quest.42000000001903BB.quest_desc: [
		"An odd favorite for a few of the tougher bees.",
		"How: water on a lava source (or lava on water). Keep the lava source."
	]
	quest.42000000001903BB.title: "Obsidian Treat"
	quest.42000000001903BC.quest_desc: [
		"More rooms for the hive, cut from birch this time.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.42000000001903BC.title: "Birch Expansion"
	quest.42000000001903BD.quest_desc: [
		"Spruce-paneled rooms bolted onto the hive.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.42000000001903BD.title: "Spruce Expansion"
	quest.42000000001903BE.quest_desc: [
		"Dark oak paneling, same purpose: more bee rooms.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.42000000001903BE.title: "Dark Oak Expansion"
	quest.42000000001903BF.quest_desc: [
		"Acacia rooms for a hive that's outgrown itself.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.42000000001903BF.title: "Acacia Expansion"
	quest.42000000001903C0.quest_desc: [
		"Jungle wood rooms, just as roomy as the rest.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.42000000001903C0.title: "Jungle Expansion"
	quest.42000000001903C1.quest_desc: [
		"Cherry-paneled rooms, purely a matter of style.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.42000000001903C1.title: "Cherry Expansion"
	quest.42000000001903C2.quest_desc: [
		"Crimson-paneled rooms for a hive gone Nether.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.42000000001903C2.title: "Crimson Expansion"
	quest.42000000001903C3.quest_desc: [
		"Warped-paneled rooms, the blue half of the pair.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.42000000001903C3.title: "Warped Expansion"
	quest.42000000001903C4.quest_desc: [
		"Bamboo rooms, lighter and just as functional.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.42000000001903C4.title: "Bamboo Expansion"
	quest.42000000001903C5.quest_desc: [
		"Mangrove rooms, the newest wood on the list.",
		"How: Productive Bees craft in JEI. Swarm names the hive, centrifuge and breeding steps."
	]
	quest.42000000001903C5.title: "Mangrove Expansion"
	quest.42000000001903C6.quest_desc: [
		"Honey you can drink straight from the bottle.",
		"How: glass bottle on a full hive. Campfire underneath."
	]
	quest.42000000001903C6.title: "Honey Bottle Stock"
	quest.42000000001903C7.quest_desc: [
		"Crafts into treats and cakes for a hungry Clowder.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001903C7.title: "Sugar Stock"
	quest.42000000001903C8.quest_desc: [
		"Empty and waiting for honey, potions, or experience.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000001903C8.title: "Glass Bottle Stock"
	quest.42000000001903C9.quest_desc: [
		"A backup pair for cutting comb without hurting the bees.",
		"How: two iron ingots diagonal. Shear sheep and bee nests."
	]
	quest.42000000001903C9.title: "Shears Spare"
	quest.42000000001A03CA.quest_desc: [
		"One block that moves items where you tell it — the pad's nervous system.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: iron ingots and iron bars around a blank module; yields four. Modules go in the router."
	]
	quest.42000000001A03CA.title: "Modular Router"
	quest.42000000001A03CB.quest_desc: [
		"The card every router behaviour is written onto.",
		"How: Modular Router plus blank modules in JEI. Puller/sender/breaker sit in the router."
	]
	quest.42000000001A03CB.title: "Blank Module"
	quest.42000000001A03CC.quest_desc: [
		"Pull items out of a neighbour into the router.",
		"How: Modular Router plus blank modules in JEI. Puller/sender/breaker sit in the router."
	]
	quest.42000000001A03CC.title: "Puller Module"
	quest.42000000001A03CD.quest_desc: [
		"Push items to a marked spot across the pad.",
		"How: Modular Router plus blank modules in JEI. Puller/sender/breaker sit in the router."
	]
	quest.42000000001A03CD.title: "Sender Module"
	quest.42000000001A03CE.quest_desc: [
		"Break a block in front of the router and keep the drop.",
		"How: Modular Router plus blank modules in JEI. Puller/sender/breaker sit in the router."
	]
	quest.42000000001A03CE.title: "Breaker Module"
	quest.42000000001A03CF.quest_desc: [
		"Place a block where the router points.",
		"How: Modular Router plus blank modules in JEI. Puller/sender/breaker sit in the router."
	]
	quest.42000000001A03CF.title: "Placer Module"
	quest.42000000001A03D0.quest_desc: [
		"Emit redstone when the router's contents cross a threshold.",
		"How: Modular Router plus blank modules in JEI. Puller/sender/breaker sit in the router."
	]
	quest.42000000001A03D0.title: "Detector Module"
	quest.42000000001A03D1.quest_desc: [
		"Carries items between chests, machines, and pads.",
		"How: iron + redstone. Faces with the Pipez wrench."
	]
	quest.42000000001A03D1.title: "Item Pipe"
	quest.42000000001A03D2.quest_desc: [
		"Carries liquids between tanks and machines without a bucket run.",
		"How: iron + buckets + redstone. Sneak-use the wrench on a side to extract; right-click that side for filters."
	]
	quest.42000000001A03D2.title: "Fluid Pipe"
	quest.42000000001A03D3.quest_desc: [
		"Carries power between machines that make it and machines that need it.",
		"How: iron + redstone. Carries FE between machines."
	]
	quest.42000000001A03D3.title: "Energy Pipe"
	quest.42000000001A03D4.quest_desc: [
		"Carries chemicals between machines that handle them.",
		"How: iron + redstone pipes in JEI. Sneak-use the wrench to set extracting sides; right-click one for filters. Pipes chapter is the full ladder."
	]
	quest.42000000001A03D4.title: "Gas Pipe"
	quest.42000000001A03D5.quest_desc: [
		"One pipe, many jobs.",
		"How: iron + redstone pipes in JEI. Sneak-use the wrench to set extracting sides; right-click one for filters. Pipes chapter is the full ladder."
	]
	quest.42000000001A03D5.title: "Universal Pipe"
	quest.42000000001A03D6.quest_desc: [
		"Sneak-use a pipe side to make it pull from a machine, or to cut it off.",
		"How: two flint and two sticks. Sneak-use a pipe side at a machine to make it extract, again to cut it off; right-click an extracting side for filters."
	]
	quest.42000000001A03D6.title: "Pipe Wrench"
	quest.42000000001A03D7.quest_desc: [
		"Speed upgrade for a pipe.",
		"How: iron + redstone pipes in JEI. Sneak-use the wrench to set extracting sides; right-click one for filters. Pipes chapter is the full ladder."
	]
	quest.42000000001A03D7.title: "Basic Upgrade"
	quest.42000000001A03D8.quest_desc: [
		"Slot into a pipe to move more per tick.",
		"How: iron + redstone pipes in JEI. Sneak-use the wrench to set extracting sides; right-click one for filters. Pipes chapter is the full ladder."
	]
	quest.42000000001A03D8.title: "Improved Upgrade"
	quest.42000000001A03D9.quest_desc: [
		"The stronger upgrade, for a line under heavy load.",
		"How: iron + redstone pipes in JEI. Sneak-use the wrench to set extracting sides; right-click one for filters. Pipes chapter is the full ladder."
	]
	quest.42000000001A03D9.title: "Advanced Upgrade"
	quest.42000000001A03DA.quest_desc: [
		"Top Pipez throughput tier.",
		"How: iron + redstone pipes in JEI. Sneak-use the wrench to set extracting sides; right-click one for filters. Pipes chapter is the full ladder."
	]
	quest.42000000001A03DA.title: "Ultimate Upgrade"
	quest.42000000001A03DB.quest_desc: [
		"Remove Pipez rate caps.",
		"How: creative-only; Pipez has no survival recipe for it. Optional."
	]
	quest.42000000001A03DB.title: "Infinity Upgrade"
	quest.42000000001A03DC.quest_desc: [
		"Sets which items a pipe end will accept or ignore.",
		"How: iron + redstone pipes in JEI. Sneak-use the wrench to set extracting sides; right-click one for filters. Pipes chapter is the full ladder."
	]
	quest.42000000001A03DC.title: "Filter Tool"
	quest.42000000001A03DD.quest_desc: [
		"The original mover. Slow, cheap, and always useful.",
		"How: five iron around a chest. Sit it under a Loomframe or Tension Barrel (extract DOWN)."
	]
	quest.42000000001A03DD.title: "Hopper Spare (Pipes)"
	quest.42000000001A03DE.quest_desc: [
		"Dropper line for logistics.",
		"How: cobble around redstone."
	]
	quest.42000000001A03DE.title: "Dropper Line"
	quest.42000000001A03DF.quest_desc: [
		"Fires or places whatever's loaded when it gets a signal.",
		"How: cobble, bow, and redstone."
	]
	quest.42000000001A03DF.title: "Dispenser Line"
	quest.42000000001A03E0.quest_desc: [
		"Reads how full a container is and outputs a signal.",
		"How: nether quartz, redstone torch, stone. Quartz sieves from soul sand; no Nether trip needed."
	]
	quest.42000000001A03E0.title: "Comparator (Pipes)"
	quest.42000000001A03E1.quest_desc: [
		"Observer reads the beat.",
		"How: cobble, redstone, and nether quartz."
	]
	quest.42000000001A03E1.title: "Observer Line"
	quest.42000000001A03E2.quest_desc: [
		"An always-on signal source, or an inverter next to a lever.",
		"How: redstone over a stick."
	]
	quest.42000000001A03E2.title: "Redstone Torch"
	quest.42000000001A03E3.quest_desc: [
		"Repeater times the circuit.",
		"How: redstone torch, redstone, stone. Pipes chapter uses it for clocks."
	]
	quest.42000000001A03E3.title: "Repeater (Pipes)"
	quest.42000000001A03E4.quest_desc: [
		"Struck by a projectile, it sends out a signal by strength.",
		"How: redstone around hay. Hay is three wheat."
	]
	quest.42000000001A03E4.title: "Target Block"
	quest.42000000001A03E5.quest_desc: [
		"Reads the sky and signals based on light or time.",
		"How: glass, nether quartz, wood slabs."
	]
	quest.42000000001A03E5.title: "Daylight Detector (Pipes)"
	quest.42000000001A03E6.quest_desc: [
		"Holds a book and signals when a page turns.",
		"How: wood slabs around a bookshelf."
	]
	quest.42000000001A03E6.title: "Lectern (Pipes)"
	quest.42000000001A03E7.quest_desc: [
		"Signals while it's open, like a chest with a tripwire.",
		"How: tripwire hook plus a chest."
	]
	quest.42000000001A03E7.title: "Trapped Chest"
	quest.42000000001A03E8.quest_desc: [
		"Loads a belt or pulls items off one, depending on facing.",
		"How: Create craft in JEI (crafting table, press, mixer or deployer). Andesite alloy and a water wheel start the line."
	]
	quest.42000000001A03E8.title: "Create Funnel"
	quest.42000000001A03E9.quest_desc: [
		"A funnel that can filter what it moves.",
		"How: Create craft in JEI (crafting table, press, mixer or deployer). Andesite alloy and a water wheel start the line."
	]
	quest.42000000001A03E9.title: "Brass Funnel"
	quest.42000000001A03EA.quest_desc: [
		"Drops items straight down between floors.",
		"How: Create craft in JEI (crafting table, press, mixer or deployer). Andesite alloy and a water wheel start the line."
	]
	quest.42000000001A03EA.title: "Chute (Pipes)"
	quest.42000000001A03EB.quest_desc: [
		"A chute that can filter and hold back items.",
		"How: Create craft in JEI (crafting table, press, mixer or deployer). Andesite alloy and a water wheel start the line."
	]
	quest.42000000001A03EB.title: "Smart Chute"
	quest.42000000001A03EC.quest_desc: [
		"Sorts and moves items with configurable priority per side.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000001A03EC.title: "Mek Logistical"
	quest.42000000001A03ED.quest_desc: [
		"Moves fluids with pressure, so it climbs as easily as it drops.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000001A03ED.title: "Mek Pipe"
	quest.42000000001A03EE.quest_desc: [
		"Carries power between machines, with several throughput tiers available.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000001A03EE.title: "Mek Cable"
	quest.42000000001A03EF.quest_desc: [
		"Moves chemicals and gases through a sealed line.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000001A03EF.title: "Mek Tube"
	quest.42000000001A03F0.quest_desc: [
		"A faster line for moving items across a busy pad.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000001A03F0.title: "Adv Transporter"
	quest.42000000001A03F1.quest_desc: [
		"Faster still, for a network that's outgrown the basics.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000001A03F1.title: "Elite Transporter"
	quest.42000000001A03F2.quest_desc: [
		"The fastest item line available, for a maxed-out pad.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000001A03F2.title: "Ult Transporter"
	quest.42000000001A03F3.quest_desc: [
		"The highest-throughput power line, for heavy machine rooms.",
		"How: Mekanism Works chapter — ore chunks from the sieve, then the factory line."
	]
	quest.42000000001A03F3.title: "Ult Cable"
	quest.42000000001B03F4.quest_desc: [
		"Lists every spirit you can bind and what it needs.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: a book and Demon's Dream Seeds, shapeless. Read it; Spirit Fire is next."
	]
	quest.42000000001B03F4.title: "Dictionary of Spirits"
	quest.42000000001B03F5.quest_desc: [
		"Burns violet and never spreads. Used to light rituals.",
		"How: light Spirit Fire as the Dictionary of Spirits shows (It burns!), then drop andesite into it."
