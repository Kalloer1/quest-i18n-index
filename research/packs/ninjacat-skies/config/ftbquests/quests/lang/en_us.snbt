{
	chapter.3100000000000001.chapter_subtitle: [
		"Wake — survive, claim the pad, let the Codex wake."
	]
	chapter.3100000000000001.title: "Strand: Soil"
	chapter.3100000000000002.chapter_subtitle: [
		"Recover — pull the fallen world back into matter."
	]
	chapter.3100000000000002.title: "Strand: Stone"
	chapter.3100000000000003.chapter_subtitle: [
		"Root — grow anchors so the pad stops fraying."
	]
	chapter.3100000000000003.title: "Strand: Sprout"
	chapter.3100000000000004.chapter_subtitle: [
		"Edge — kit up and leave the pad on purpose."
	]
	chapter.3100000000000004.title: "Strand: Claw"
	chapter.3100000000000005.chapter_subtitle: [
		"Hum — rhythm and pulse before wires."
	]
	chapter.3100000000000005.title: "Strand: Spark"
	chapter.3100000000000006.chapter_subtitle: [
		"Pattern — a factory as a song that carries itself."
	]
	chapter.3100000000000006.title: "Strand: Clock"
	chapter.3100000000000007.chapter_subtitle: [
		"Colony — keep something alive that keeps something else alive."
	]
	chapter.3100000000000007.title: "Strand: Swarm"
	chapter.3100000000000008.chapter_subtitle: [
		"Bind — seals, rites, and two braid paths in a cord."
	]
	chapter.3100000000000008.title: "Strand: Sigil"
	chapter.3100000000000009.chapter_subtitle: [
		"Reweave — the digital loom, the March, the Fragment."
	]
	chapter.3100000000000009.title: "Strand: Spindle"
	chapter.310000000000000A.title: "Deep Sieve"
	chapter.310000000000000B.title: "Storage and Packs"
	chapter.310000000000000C.title: "Mekanism Works"
	chapter.310000000000000D.title: "Powah Grid"
	chapter.310000000000000E.title: "Arcane Side"
	chapter.310000000000000F.chapter_subtitle: [
		"Teams, the Hall, the Post, and the Fray."
	]
	chapter.310000000000000F.title: "Clowder Hall"
	chapter.3100000000000011.title: "Nature's Aura"
	chapter.3100000000000012.title: "Kitchen Line"
	chapter.3100000000000013.title: "Battle Spells"
	chapter.3100000000000014.title: "Solar Flux"
	chapter.3100000000000015.title: "Pad Decor"
	chapter.3100000000000016.title: "Nether Foothold"
	chapter.3100000000000017.title: "End Foothold"
	chapter.3100000000000018.title: "Essence Fields"
	chapter.3100000000000019.chapter_subtitle: [
		"Every nest is a ring of something around a flower."
	]
	chapter.3100000000000019.title: "Swarm Apiary"
	chapter.310000000000001A.title: "Pipeworks"
	chapter.310000000000001B.title: "Otherworld"
	chapter.310000000000001C.title: "Clockworks Deep"
	chapter.310000000000001D.title: "Spindle Network"
	chapter.310000000000001E.title: "Voidcraft"
	chapter.310000000000001F.title: "Packaged Lines"
	chapter.3100000000000020.title: "QIO and Mek Peak"
	chapter.3100000000000021.title: "Hunt and Farm"
	chapter.3100000000000022.title: "Tribal Weave"
	chapter.3100000000000023.chapter_subtitle: [
		"Grit-singers cut one stone a hundred ways."
	]
	chapter.3100000000000023.title: "Stonemason"
	chapter.3100000000000024.chapter_subtitle: [
		"A pad is a ledge until someone puts a chair on it."
	]
	chapter.3100000000000024.title: "Furnishings"
	chapter.3100000000000025.chapter_subtitle: [
		"The little machines the stewards left."
	]
	chapter.3100000000000025.title: "Small Stewardries"
	chapter.3100000000000026.chapter_subtitle: [
		"The Drumhearts' pulse learns to run in copper."
	]
	chapter.3100000000000026.title: "The Current"
	chapter.3100000000000027.chapter_subtitle: [
		"Thirteen guardians the Cut snapped. Re-tension each Strand by beating its keeper."
	]
	chapter.3100000000000027.title: "Snapped Guardians"
	chapter.3100000000000028.chapter_subtitle: [
		"Walk the March. Tame a yellow. Esther waits at the Hall after you have been there."
	]
	chapter.3100000000000028.title: "Pad-runners"
	chapter.3100000000000029.chapter_subtitle: [
		"Gardens from the sieve. Cook what a void pad never grew."
	]
	chapter.3100000000000029.title: "Harvest Table"
	chapter.310000000000002A.chapter_subtitle: [
		"Crop sticks, stats, irrigation. Weeds stay off on a ledge."
	]
	chapter.310000000000002A.title: "Crop Sticks"
	chapter_group.2100000000000001.title: "Skybound"
	chapter_group.2100000000000002.title: "Craft and Tension"
	chapter_group.2100000000000003.title: "Reweave"
	chapter_group.2100000000000004.title: "Side Paths"
	file.0000000000000001.title: "Ninjacat Skies"
	quest.4200000000018001.quest_desc: [
		"You woke on a ledge. Look at the drop, then click this.",
		"Grave (`) is the assignment list. The Whisker Codex is Start here.",
		"How: click the quest. Then punch the oak."
	]
	quest.4200000000018001.title: "Look at the drop"
	quest.4200000000010001.quest_desc: [
		"You are Skybound. This is what did not fall.",
		"Eight logs. Start with the tree; it started with you.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: punch the oak on your pad. Eight logs start Wake."
	]
	quest.4200000000010001.title: "Wake on a Pad"
	quest.4200000000010002.quest_desc: [
		"Dirt is a promise the pad makes to your boots.",
		"Sixteen blocks. Widen the promise.",
		"How: starter chest, cobble+thread sink, sieve leftovers, or /clowder hub (Pad-keepers)."
	]
	quest.4200000000010002.title: "Something to Stand On"
	quest.4200000000010003.quest_desc: [
		"Hands need a surface. Everything after this is a surface.",
		"How: four planks in a square."
	]
	quest.4200000000010003.title: "Craft a Bench"
	quest.4200000000010004.quest_desc: [
		"Claw comes later. For now, wood that bites.",
		"How: three planks over two sticks."
	]
	quest.4200000000010004.title: "Wooden Pick"
	quest.4200000000010005.quest_desc: [
		"Green against the drop.",
		"Plant it before you are hungry.",
		"How: break oak leaves, or /clowder hub Rootbinders (8 Thread for four)."
	]
	quest.4200000000010005.title: "First Sapling"
	quest.4200000000010006.quest_desc: [
		"Sixty-four planks is a pad that stops feeling like a ledge.",
		"How: one log in the crafting grid makes four."
	]
	quest.4200000000010006.title: "Plank Stock"
	quest.4200000000010007.quest_desc: [
		"Handles, frames, the bones of tools.",
		"How: two planks in a column."
	]
	quest.4200000000010007.title: "Stick Bundle"
	quest.4200000000010008.quest_desc: [
		"Put things where they stay. A Clowder shares a chest before it shares anything else.",
		"How: eight planks around an empty centre."
	]
	quest.4200000000010008.title: "Chest for the Clowder"
	quest.4200000000010009.quest_desc: [
		"See the edge before the edge sees you.",
		"How: coal or charcoal over a stick. /clowder hub Kin sell a pack."
	]
	quest.4200000000010009.title: "Torch Line"
	quest.420000000001000A.quest_desc: [
		"Ice and lava make stone where there was none.",
		"Normal and Hard pads ship both. The Pad-keepers at /clowder hub sell a bucket.",
		"How: lava next to water (or ice melt). Hammer stone. /clowder hub Grit-singers' stall sells a bundle."
	]
	quest.420000000001000A.title: "Cobble Cache"
	quest.420000000001000B.quest_desc: [
		"Warmth that is not yet Spark.",
		"The Pad-keepers would have called this a hearth.",
		"How: eight cobble around an empty centre."
	]
	quest.420000000001000B.title: "Furnace Heat"
	quest.420000000001000C.quest_desc: [
		"Hunger is a soft void. Eight loaves closes it for a while.",
		"How: three wheat in a row, or /clowder hub Hearth-keeper."
	]
	quest.420000000001000C.title: "Cook a Meal"
	quest.420000000001000D.quest_desc: [
		"Place lava, melt ice into a source, fill the bucket.",
		"Easy ships water; Normal and Hard ship the pieces.",
		"How: empty bucket on a water source. Normal/Hard: place lava, melt ice, fill."
	]
	quest.420000000001000D.title: "Catch the Rain"
	quest.420000000001000E.quest_desc: [
		"Scraps of the Loom that still hold. Every quest returns some.",
		"Unravel one for string, or spend them at the Kin stalls in /clowder hub.",
		"How: quest rewards, flint-mesh dirt on a Loomframe, steward caches."
	]
	quest.420000000001000E.title: "Frayed Currency"
	quest.420000000001000F.quest_desc: [
		"Damaged, but it still teaches. Open Start here.",
		"Right-click the book and open Start here. Grave (`): the assignment list.",
		"How: starter kit / dock chest. Right-click the book; Grave (`) is the assignment list."
	]
	quest.420000000001000F.title: "Codex in Hand"
	quest.4200000000010010.quest_desc: [
		"Set a spawn.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000010010.title: "Bed Claim"
	quest.4200000000010011.quest_desc: [
		"Climb into the depths without a rope. Cheap enough to leave in every shaft.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000010011.title: "Ladder Down"
	quest.4200000000010012.quest_desc: [
		"Spider silk saved for later meshes. Every strand gets used eventually.",
		"How: unravel Frayed Thread (1 → 3). Spiders. Loom Lint at an Echo Bind. Yarn reverse sink."
	]
	quest.4200000000010012.title: "String Cache"
	quest.4200000000010013.quest_desc: [
		"Speed the green.",
		"How: bones in a grid, or Thread + rotten flesh sink, or /clowder hub Pad-keepers."
	]
	quest.4200000000010013.title: "Bone Meal Stock"
	quest.4200000000010014.quest_desc: [
		"Widen the pad.",
		"How: starter chest, cobble+thread sink, sieve leftovers, or /clowder hub (Pad-keepers)."
	]
	quest.4200000000010014.title: "Dirt Platform"
	quest.4200000000010015.quest_desc: [
		"Trim them now, compost them later. Nothing on a pad goes to waste.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000010015.title: "Oak Leaves"
	quest.4200000000010016.quest_desc: [
		"A quiet corner.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000010016.title: "Flower Pot"
	quest.4200000000010017.quest_desc: [
		"Ex Deorum's barrel: compost, and water into clay the slow way.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000010017.title: "Barrel"
	quest.4200000000010018.quest_desc: [
		"Waste to meal.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000010018.title: "Composter"
	quest.4200000000010019.quest_desc: [
		"Scratch a row.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000010019.title: "Wooden Hoe"
	quest.420000000001001A.quest_desc: [
		"Fells logs quicker than bare hands. The first real tool a Skybound owns.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.420000000001001A.title: "Wooden Axe"
	quest.420000000001001B.quest_desc: [
		"Turns dirt and gravel into cleared ground. Slow, but it works.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.420000000001001B.title: "Wooden Shovel"
	quest.420000000001001C.quest_desc: [
		"Barely stops a zombie, but it stops one. Better than swinging a fist.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.420000000001001C.title: "Wooden Sword"
	quest.420000000001001D.quest_desc: [
		"Holds soup, stew, and not much else. Simple crockery for a simple pad.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.420000000001001D.title: "Bowl"
	quest.420000000001001E.quest_desc: [
		"Label the pad.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.420000000001001E.title: "Item Frame"
	quest.420000000001001F.quest_desc: [
		"Make it home.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.420000000001001F.title: "Painting"
	quest.4200000000010020.quest_desc: [
		"Keeps the wind and the mobs on the correct side of the wall.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000010020.title: "Oak Door"
	quest.4200000000010021.quest_desc: [
		"Marks an edge without blocking the view. Handy where the drop is real.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000010021.title: "Oak Fence"
	quest.4200000000010022.quest_desc: [
		"Turns a sheer wall into something you can actually climb.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000010022.title: "Oak Stairs"
	quest.4200000000010023.quest_desc: [
		"Half a block, twice the flooring options. Useful in tight spaces.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000010023.title: "Oak Slab"
	quest.4200000000010024.quest_desc: [
		"Trapdoor access hatches.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000010024.title: "Oak Trapdoor"
	quest.4200000000010025.quest_desc: [
		"Trips a signal when something steps on it. Doors open themselves.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000010025.title: "Oak Pressure Plate"
	quest.4200000000010026.quest_desc: [
		"Button for redstone taps.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000010026.title: "Oak Button"
	quest.4200000000010027.quest_desc: [
		"Fence the pad edge.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000010027.title: "Stick Fence Gate"
	quest.4200000000010028.quest_desc: [
		"Cooks food slowly and keeps the smoke visible for miles.",
		"How: logs, sticks, and coal or charcoal."
	]
	quest.4200000000010028.title: "Campfire"
	quest.4200000000010029.quest_desc: [
		"Hangs light wherever a torch would look wrong. Warmer glow, same job.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000010029.title: "Lantern"
	quest.420000000001002A.quest_desc: [
		"Burns pale blue and keeps most things from spawning nearby.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.420000000001002A.title: "Soul Lantern"
	quest.420000000001002B.quest_desc: [
		"Climbs with you and vanishes when pulled. Building high stops being scary.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.420000000001002B.title: "Scaffolding"
	quest.420000000001002C.quest_desc: [
		"Chain for hanging flair.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.420000000001002C.title: "Chain"
	quest.420000000001002D.quest_desc: [
		"Cage the edge.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.420000000001002D.title: "Iron Bars"
	quest.420000000001002E.quest_desc: [
		"Glass for pad windows.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.420000000001002E.title: "Glass Pane"
	quest.420000000001002F.quest_desc: [
		"Soft, flammable, and easy to dye. Every pad needs a bed eventually.",
		"How: shear sheep after grass, or four string."
	]
	quest.420000000001002F.title: "White Wool"
	quest.4200000000010030.quest_desc: [
		"A thin layer of wool for floors that don't need a whole block.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000010030.title: "White Carpet"
	quest.4200000000010031.quest_desc: [
		"Brings a little green and pink to a pad made of grit.",
		"How: moss plus oak, or bone-meal moss. Bees accept the bloom."
	]
	quest.4200000000010031.title: "Flowering Azalea"
	quest.4200000000010032.quest_desc: [
		"Spreads slowly and softens the look of raw stone platforms.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000010032.title: "Moss Block"
	quest.4200000000010033.quest_desc: [
		"Hanging roots under the pad.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000010033.title: "Hanging Roots"
	quest.4200000000010034.quest_desc: [
		"Clings to walls and lights them without a single torch.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000010034.title: "Glow Lichen"
	quest.4200000000010035.quest_desc: [
		"Dripstone for pointed flair.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000010035.title: "Pointed Dripstone"
	quest.4200000000010036.quest_desc: [
		"Amethyst in a block. Sigil will want shards later.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000010036.title: "Amethyst Block"
	quest.4200000000010037.quest_desc: [
		"Nine ingots pressed together. Weathers green if you leave it outside.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000010037.title: "Copper Block"
	quest.4200000000010038.quest_desc: [
		"Nine chunks of raw iron stacked tight, waiting on a furnace.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000010038.title: "Raw Iron Block"
	quest.4200000000010039.quest_desc: [
		"Burns far longer than loose coal. Feed the furnace and walk away.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000010039.title: "Coal Block"
	quest.420000000001003A.quest_desc: [
		"Feeds animals and slows a fall. Farmers keep it close for both.",
		"How: nine wheat. Three wheat also makes bread."
	]
	quest.420000000001003A.title: "Hay Block"
	quest.420000000001003B.quest_desc: [
		"Nine kelp pressed into fuel. Smelts more than it looks like it should.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.420000000001003B.title: "Dried Kelp Block"
	quest.420000000001003C.quest_desc: [
		"Paper and leather, waiting to become something with a recipe attached.",
		"How: three paper plus leather. Paper is sugar cane."
	]
	quest.420000000001003C.title: "Book"
	quest.420000000001003D.quest_desc: [
		"Paper for books and maps.",
		"How: three sugar cane in a row. Cane comes from sieving dirt with a flint mesh or better."
	]
	quest.420000000001003D.title: "Paper"
	quest.420000000001003E.quest_desc: [
		"Dye and books need ink.",
		"How: charcoal plus a glass bottle. Squid never spawn here."
	]
	quest.420000000001003E.title: "Ink Sac"
	quest.420000000001003F.quest_desc: [
		"Feathers for arrows and books.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.420000000001003F.title: "Feather"
	quest.4200000000010040.quest_desc: [
		"Leather for books and kits.",
		"How: smelt or campfire rotten flesh. Sieve dirt with flint mesh. /clowder hub Pad-keepers sell two for 18 Thread."
	]
	quest.4200000000010040.title: "Leather"
	quest.4200000000010041.quest_desc: [
		"Bench, sapling, hearth, water, Codex. The pad holds.",
		"Tension the Strand: the Pad-keepers answer, and the token is yours to seat.",
		"Claim it and choose one gift from the tribe: a Thread of Return for one more shared life, or supplies.",
		"How: finish the quests linked to this one, then claim it for the Strand token. Seat the token at your Tension Post."
	]
	quest.4200000000010041.quest_subtitle: "Wake"
	quest.4200000000010041.title: "Soil Knot"
	quest.4200000000010042.quest_desc: [
		"Right-click your Clowder's Tension Post with the token.",
		"The notch lights, the tribe chimes, the pad changes.",
		"How: right-click your Tension Post with the Strand token in hand."
	]
	quest.4200000000010042.title: "Seat Soil"
	quest.4200000000010043.quest_desc: [
		"A zombie on a pad with no caves. The void sends its regards.",
		"Light the edges.",
		"How: kill a zombie on the pad at night. Light the edges."
	]
	quest.4200000000010043.title: "Something Came Up"
	quest.4200000000020044.quest_desc: [
		"Thread that remembers where it came from.",
		"Unravel Thread to string; four string spin two yarn.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: four string → two yarn. Tension Barrel: string + pearl. Four Loom Lint."
	]
	quest.4200000000020044.title: "Pull Void Yarn"
	quest.4200000000020045.quest_desc: [
		"Cobble and sticks. Break fallen grit into gravel, sand, dust.",
		"How: cobble + sticks. Break grit into gravel, sand, dust."
	]
	quest.4200000000020045.title: "Spindle Hammer"
	quest.4200000000020046.quest_desc: [
		"String around yarn. It catches what the Loom dropped — and combs Loom Lint out of dirt.",
		"How: string around yarn. The Grit-singers' stall sells one."
	]
	quest.4200000000020046.title: "Thread the Mesh"
	quest.4200000000020047.quest_desc: [
		"Pour water; the bucket comes straight back. Add dirt. Wait for clay.",
		"String and a pearl in the same barrel make yarn.",
		"How: planks, string, and Void Yarn. Pour water (bucket returns), add dirt → clay."
	]
	quest.4200000000020047.title: "Tension Barrel"
	quest.4200000000020048.quest_desc: [
		"Sixteen clay from the barrel. Load eight dirt at a time.",
		"How: Tension Barrel — water + dirt. Echo Shatter hammers sand to clay."
	]
	quest.4200000000020048.title: "Clay Pocket"
	quest.4200000000020049.quest_desc: [
		"Clay and bone meal. Shape the unfired bucket.",
		"How: clay ball + bone meal, shapeless. Clay comes from the Tension Barrel."
	]
	quest.4200000000020049.title: "Porcelain Clay"
	quest.420000000002004A.quest_desc: [
		"Smelt it. Porcelain carries lava where iron is still a rumour.",
		"How: shape porcelain clay into an unfired bucket, then smelt it."
	]
	quest.420000000002004A.title: "Porcelain Tool"
	quest.420000000002004B.quest_desc: [
		"Grit-singers named every shard by its echo.",
		"Sieve until you can hear the iron.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.420000000002004B.title: "Sift Fallen Grit"
	quest.420000000002004C.quest_desc: [
		"A spare set of hits.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.420000000002004C.title: "Wooden Hammer"
	quest.420000000002004D.quest_desc: [
		"Matter from grit. Sixty-four stones that were dust an hour ago.",
		"How: lava next to water (or ice melt). Hammer stone. /clowder hub Grit-singers' stall sells a bundle."
	]
	quest.420000000002004D.title: "Pebbles"
	quest.420000000002004E.quest_desc: [
		"Loom dust waits in gravel. So does flint.",
		"How: hammer cobble (Spindle Hammer or Echo Shatter)."
	]
	quest.420000000002004E.title: "Gravel Path"
	quest.420000000002004F.quest_desc: [
		"Fine grit. Glass later, and the iron mesh's best catch.",
		"How: hammer gravel."
	]
	quest.420000000002004F.title: "Sand Cache"
	quest.4200000000020050.quest_desc: [
		"Ash of the fallen world. Redstone and gunpowder hide in it.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.4200000000020050.title: "Dust Pile"
	quest.4200000000020051.quest_desc: [
		"Yarn around slime. Pad compost makes the slime.",
		"The Knot is the Loom's soft gate; keep two.",
		"How: Void Yarn ring around a slime ball."
	]
	quest.4200000000020051.title: "Tie Binding Knot"
	quest.4200000000020052.quest_desc: [
		"Planks around a Knot. Stretch a mesh, load grit, let it work.",
		"Hoppers feed it. This is the pad's first machine.",
		"How: planks around a Binding Knot. Stretch a mesh, hopper grit in, sit it on a hopper."
	]
	quest.4200000000020052.title: "Raise Loomframe"
	quest.4200000000020053.quest_desc: [
		"Iron is low and patient. Eight chunks from the mesh.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.4200000000020053.title: "Iron Ore Chunk"
	quest.4200000000020054.quest_desc: [
		"Sieved from gravel bit by bit. The mesh finds copper before your eyes do.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.4200000000020054.title: "Copper Ore Chunk"
	quest.4200000000020055.quest_desc: [
		"Gold barely bothers to answer. Four is enough.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.4200000000020055.title: "Gold Ore Chunk"
	quest.4200000000020056.quest_desc: [
		"Fuel the line.",
		"How: sieve gravel, or smelt coal ore."
	]
	quest.4200000000020056.title: "Coal"
	quest.4200000000020057.quest_desc: [
		"Chunks to raw. Smelt onward.",
		"How: sieve gravel for iron ore chunks; four make an iron ore block, and mining it drops raw iron."
	]
	quest.4200000000020057.title: "Raw Iron"
	quest.4200000000020058.quest_desc: [
		"Recover pays out. Sixteen bars the void did not want you to have.",
		"How: smelt raw iron / iron grit (furnace or Ember Kiln). Sieve gravel for chunks."
	]
	quest.4200000000020058.title: "Iron Ingot"
	quest.4200000000020059.quest_desc: [
		"Wire and bulbs, and Tribal resonators later.",
		"How: smelt raw copper / copper grit. Sieve gravel."
	]
	quest.4200000000020059.title: "Copper Ingot"
	quest.420000000002005A.quest_desc: [
		"Gilded tools, and gold plates for the Pattern-weavers.",
		"How: smelt raw gold / gold grit. Rarer sieve catch."
	]
	quest.420000000002005A.title: "Gold Ingot"
	quest.420000000002005B.quest_desc: [
		"Sharper catch. Flint meshes shake Frayed Thread out of grit.",
		"How: flint around a string thread mesh."
	]
	quest.420000000002005B.title: "Flint Mesh"
	quest.420000000002005C.quest_desc: [
		"Metal thread for heavier dust. Iron meshes are where Strand Filament falls.",
		"How: iron around a flint thread mesh. Strand Filament starts here."
	]
	quest.420000000002005C.title: "Iron Mesh"
	quest.420000000002005D.quest_desc: [
		"Melt and drip. Cobble to lava, given time.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.420000000002005D.title: "Crucible"
	quest.420000000002005E.quest_desc: [
		"Ex Deorum's barrel: compost, and water into clay the slow way.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.420000000002005E.title: "Barrel (Stone)"
	quest.420000000002005F.quest_desc: [
		"Harder hits, longer life.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.420000000002005F.title: "Stone Hammer"
	quest.4200000000020060.quest_desc: [
		"Crushes ore into gravel and grit, the noisy trick behind the sieve.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.4200000000020060.title: "Iron Hammer"
	quest.4200000000020061.quest_desc: [
		"Wider mesh, nine at a time.",
		"How: Ex Deorum sieve, hammer, crucible, or barrel. Match the mesh to the grit."
	]
	quest.4200000000020061.title: "Compressed Sieve"
	quest.4200000000020062.quest_desc: [
		"See through. Sand to glass.",
		"How: smelt sand. Hammer cobble to gravel, gravel to sand, then furnace."
	]
	quest.4200000000020062.title: "Glass"
	quest.4200000000020063.quest_desc: [
		"Carry the rain in iron now.",
		"How: three iron ingots, or /clowder hub Pad-keepers (8 Thread). Fill from melted ice."
	]
	quest.4200000000020063.title: "Bucket"
	quest.4200000000020064.quest_desc: [
		"Heat from the void, in hand.",
		"How: Ex Deorum lava crucible, or a Nether lava pool after Claw obsidian."
	]
	quest.4200000000020064.title: "Lava Bucket"
	quest.4200000000020065.quest_desc: [
		"Portal thoughts. Water on lava source.",
		"How: water on a lava source (or lava on water). Keep the lava source."
	]
	quest.4200000000020065.title: "Obsidian"
	quest.4200000000020066.quest_desc: [
		"Rare grit luck. Two is a start.",
		"How: sieve gravel with an iron mesh or better, or Echo Shatter diamond ore."
	]
	quest.4200000000020066.title: "Diamond"
	quest.4200000000020067.quest_desc: [
		"Mesh upgrade fuel.",
		"How: gravel, or Thread + gravel sink."
	]
	quest.4200000000020067.title: "Flint"
	quest.4200000000020068.quest_desc: [
		"Made from grit and dust, not looted from a creeper. Handle it carefully.",
		"How: sieve dust or soul sand, or creepers on the pad at night. Keep edges lit after you have some."
	]
	quest.4200000000020068.title: "Gunpowder"
	quest.4200000000020069.quest_desc: [
		"Spark will want this. Keep it dry.",
		"How: sieve gravel, or Echo Shatter redstone ore after Recover."
	]
	quest.4200000000020069.title: "Redstone"
	quest.420000000002006A.quest_desc: [
		"Feeds the enchanting table. Blue dust that makes gear listen better.",
		"How: sieve gravel, or Echo Shatter lapis ore."
	]
	quest.420000000002006A.title: "Lapis"
	quest.420000000002006B.quest_desc: [
		"A common stone blend, useful mostly for building and for mixing recipes later.",
		"How: sieve dirt/gravel pebbles, or cobble plus diorite in JEI."
	]
	quest.420000000002006B.title: "Andesite"
	quest.420000000002006C.quest_desc: [
		"Speckled stone, decorative more than structural. Grit-singers called it the loud one.",
		"How: sieve pebbles, or cobble plus nether quartz."
	]
	quest.420000000002006C.title: "Diorite"
	quest.420000000002006D.quest_desc: [
		"Dense and pink-flecked, good for a floor that wants to stand out.",
		"How: sieve pebbles, or diorite plus nether quartz."
	]
	quest.420000000002006D.title: "Granite"
	quest.420000000002006E.quest_desc: [
		"Porous rock from the other place. Burns forever once it catches.",
		"How: the Nether here is void, not terrain. Pour lava into an Ex Deorum barrel of witch water (a water barrel standing on mycelium; mycelium spores sieve from dirt)."
	]
	quest.420000000002006E.title: "Netherrack"
	quest.420000000002006F.quest_desc: [
		"Slows every step that crosses it and feeds soul fire a colder blue.",
		"How: sand into an Ex Deorum barrel of witch water. Fortress wart rooms hold a little. Three skulls on soul sand make a Wither."
	]
	quest.420000000002006F.title: "Soul Sand"
	quest.4200000000020070.quest_desc: [
		"Ground from Nether glowstone, useful for brewing and for softer light sources.",
		"How: sieve soul sand, or witches on the pad."
	]
	quest.4200000000020070.title: "Glowstone Dust"
	quest.4200000000020071.quest_desc: [
		"Strips leaves off a tree without swinging an axe at the trunk.",
		"How: four sticks. The Grit-singers' stall sells one."
	]
	quest.4200000000020071.title: "Crook"
	quest.4200000000020072.quest_desc: [
		"Pulled from the sieve in growing piles. Never quite enough for every mesh.",
		"How: unravel Frayed Thread (1 → 3). Spiders. Loom Lint at an Echo Bind. Yarn reverse sink."
	]
	quest.4200000000020072.title: "String"
	quest.4200000000020073.quest_desc: [
		"Knot binder — or pad compost recipe.",
		"How: two dirt + wheat seeds + bone meal (pad compost), or /clowder hub Pad-keepers."
	]
	quest.4200000000020073.title: "Slimeball"
	quest.4200000000020074.quest_desc: [
		"Ground down for meal, or kept whole to breed the pack's next wolf.",
		"How: skeletons at night, or /clowder hub Pad-keepers (16 Thread for 8)."
	]
	quest.4200000000020074.title: "Bone"
	quest.4200000000020075.quest_desc: [
		"Bitter and faintly toxic. Brewers use it, nobody eats it plain.",
		"How: spiders on the pad at night."
	]
	quest.4200000000020075.title: "Spider Eye"
	quest.4200000000020076.quest_desc: [
		"Yarn, porcelain, a Loomframe working, iron in the chest.",
		"Tension the Strand: the Grit-singers answer.",
		"Claim it and choose one gift from the tribe: a Thread of Return for one more shared life, or supplies.",
		"How: finish the quests linked to this one, then claim it for the Strand token. Seat the token at your Tension Post."
	]
	quest.4200000000020076.quest_subtitle: "Recover"
	quest.4200000000020076.title: "Stone Knot"
	quest.4200000000020077.quest_desc: [
		"Right-click your Clowder's Tension Post with the token.",
		"The notch lights, the tribe chimes, the pad changes.",
		"How: right-click your Tension Post with the Strand token in hand."
	]
	quest.4200000000020077.title: "Seat Stone"
	quest.4200000000020078.quest_desc: [
		"A creeper, dealt with. Gunpowder is worth more than the fright.",
		"How: kill three creepers. Gunpowder is the reward."
	]
	quest.4200000000020078.title: "Boom, Later"
	quest.4200000000030079.quest_desc: [
		"Scratch rows into the pad.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: two iron ingots over a stick."
	]
	quest.4200000000030079.title: "Iron Hoe"
	quest.420000000003007A.quest_desc: [
		"Bread is infrastructure. Thirty-two wheat is a field, not a patch.",
		"How: wheat seeds on farmland, then bone meal. Seeds from breaking grass or the starter chest."
	]
	quest.420000000003007A.title: "Wheat Field"
	quest.420000000003007B.quest_desc: [
		"Plant what you eat.",
		"How: break grass, or sieve dirt with a flint mesh. Plant on farmland; bone meal speeds the first field."
	]
	quest.420000000003007B.title: "Seed Pouch"
	quest.420000000003007C.quest_desc: [
		"Speed is kindness. Compost and bones.",
		"How: bones in a grid, or Thread + rotten flesh sink, or /clowder hub Pad-keepers."
	]
	quest.420000000003007C.title: "Bone Meal Engine"
	quest.420000000003007D.quest_desc: [
		"Prep the harvest.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.420000000003007D.title: "Farmers Knife"
	quest.420000000003007E.quest_desc: [
		"A kitchen starts here.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.420000000003007E.title: "Cutting Board"
	quest.420000000003007F.quest_desc: [
		"Warm meals feed more than hunger.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.420000000003007F.title: "Cooking Pot"
	quest.4200000000030080.quest_desc: [
		"Grows in tidy heads, better cooked into something than eaten raw.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.4200000000030080.title: "Cabbage"
	quest.4200000000030081.quest_desc: [
		"Climbs its own trellis and ripens red. Sauce starts here.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.4200000000030081.title: "Tomato"
	quest.4200000000030082.quest_desc: [
		"Tears of joy.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.4200000000030082.title: "Onion"
	quest.4200000000030083.quest_desc: [
		"Essence farming begins. Sixteen from the first row.",
		"How: Mystical Agriculture craft in JEI. Inferium and Prosperity come from the sieve; seeds are infused on the Infusion Altar."
	]
	quest.4200000000030083.title: "Inferium"
	quest.4200000000030084.quest_desc: [
		"The seed backbone. Sieve or grow it.",
		"How: Mystical Agriculture craft in JEI. Inferium and Prosperity come from the sieve; seeds are infused on the Infusion Altar."
	]
	quest.4200000000030084.title: "Prosperity"
	quest.4200000000030085.quest_desc: [
		"Raise seeds from essence.",
		"How: Mystical Agriculture craft in JEI. Inferium and Prosperity come from the sieve; seeds are infused on the Infusion Altar."
	]
	quest.4200000000030085.title: "Infusion Altar"
	quest.4200000000030086.quest_desc: [
		"Four around the altar.",
		"How: Mystical Agriculture craft in JEI. Inferium and Prosperity come from the sieve; seeds are infused on the Infusion Altar."
	]
	quest.4200000000030086.title: "Infusion Pedestal"
	quest.4200000000030087.quest_desc: [
		"Grow more pad.",
		"How: Mystical Agriculture craft in JEI. Inferium and Prosperity come from the sieve; seeds are infused on the Infusion Altar."
	]
	quest.4200000000030087.title: "Dirt Seeds"
	quest.4200000000030088.quest_desc: [
		"Grow canopy without the axe.",
		"How: Mystical Agriculture craft in JEI. Inferium and Prosperity come from the sieve; seeds are infused on the Infusion Altar."
	]
	quest.4200000000030088.title: "Wood Seeds"
	quest.4200000000030089.quest_desc: [
		"Grown, not mined. Harvest essence instead of swinging a pickaxe.",
		"How: Mystical Agriculture craft in JEI. Inferium and Prosperity come from the sieve; seeds are infused on the Infusion Altar."
	]
	quest.4200000000030089.title: "Stone Seeds"
	quest.420000000003008A.quest_desc: [
		"Metal from a crop. Recover's second engine.",
		"How: Mystical Agriculture craft in JEI. Inferium and Prosperity come from the sieve; seeds are infused on the Infusion Altar."
	]
	quest.420000000003008A.title: "Iron Seeds"
	quest.420000000003008B.quest_desc: [
		"A crop that yields copper essence instead of copper ore.",
		"How: Mystical Agriculture craft in JEI. Inferium and Prosperity come from the sieve; seeds are infused on the Infusion Altar."
	]
	quest.420000000003008B.title: "Copper Seeds"
	quest.420000000003008C.quest_desc: [
		"A gilded crop that grows gold essence right on the pad.",
		"How: Mystical Agriculture craft in JEI. Inferium and Prosperity come from the sieve; seeds are infused on the Infusion Altar."
	]
	quest.420000000003008C.title: "Gold Seeds"
	quest.420000000003008D.quest_desc: [
		"Turns a farm plot into a fuel source, no mining required.",
		"How: Mystical Agriculture craft in JEI. Inferium and Prosperity come from the sieve; seeds are infused on the Infusion Altar."
	]
	quest.420000000003008D.title: "Coal Seeds"
	quest.420000000003008E.quest_desc: [
		"Bottled rain from a crop.",
		"How: Mystical Agriculture craft in JEI. Inferium and Prosperity come from the sieve; seeds are infused on the Infusion Altar."
	]
	quest.420000000003008E.title: "Water Seeds"
	quest.420000000003008F.quest_desc: [
		"Compact growth for a small pad.",
		"How: terracotta Botany Pot in JEI. Dirt + a seed in the pot; bone meal still helps."
	]
	quest.420000000003008F.title: "Botany Pot"
	quest.4200000000030090.quest_desc: [
		"The pot that harvests itself.",
		"How: hopper Botany Pot in JEI. Sits over a chest/hopper and harvests itself."
	]
	quest.4200000000030090.title: "Hopper Pot"
	quest.4200000000030091.quest_desc: [
		"Tier up. The seeds get greedier and better.",
		"How: Mystical Agriculture craft in JEI. Inferium and Prosperity come from the sieve; seeds are infused on the Infusion Altar."
	]
	quest.4200000000030091.title: "Prudentium"
	quest.4200000000030092.quest_desc: [
		"A deeper grade of crop essence, stronger than the seeds you started with.",
		"How: Mystical Agriculture craft in JEI. Inferium and Prosperity come from the sieve; seeds are infused on the Infusion Altar."
	]
	quest.4200000000030092.title: "Tertium"
	quest.4200000000030093.quest_desc: [
		"Nine meal to a block. Storage for the engine.",
		"How: nine bone meal. Bones from skeletons or Pad-keepers."
	]
	quest.4200000000030093.title: "Bone Block"
	quest.4200000000030094.quest_desc: [
		"Sprout surplus, stacked.",
		"How: nine wheat. Three wheat also makes bread."
	]
	quest.4200000000030094.title: "Hay Silo"
	quest.4200000000030095.quest_desc: [
		"Better farmland. Rootbinders would approve.",
		"How: place Organic Compost and wait; it slowly matures into Rich Soil."
	]
	quest.4200000000030095.title: "Rich Soil"
	quest.4200000000030096.quest_desc: [
		"Feed the soil that feeds you.",
		"How: Farmer's Delight craft in JEI (crafting table, cutting board or cooking pot). Crop seeds come from sieving dirt."
	]
	quest.4200000000030096.title: "Organic Compost"
	quest.4200000000030097.quest_desc: [
		"Plant a row, feed a horse, or just eat it raw.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000030097.title: "Carrot"
	quest.4200000000030098.quest_desc: [
		"Potato staple crop.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000030098.title: "Potato"
	quest.4200000000030099.quest_desc: [
		"Grows fast and dyes red. Soup, stew, or straight from the ground.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.4200000000030099.title: "Beetroot"
	quest.420000000003009A.quest_desc: [
		"Melon for food and trades.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.420000000003009A.title: "Melon"
	quest.420000000003009B.quest_desc: [
		"Pumpkin for food and decor.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.420000000003009B.title: "Pumpkin"
	quest.420000000003009C.quest_desc: [
		"Paper and sugar.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.420000000003009C.title: "Sugar Cane"
	quest.420000000003009D.quest_desc: [
		"Grows without water and hurts anything that leans on it.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.420000000003009D.title: "Cactus"
	quest.420000000003009E.quest_desc: [
		"Shoots up fast and burns hot. Handy fuel for a pad short on trees.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.420000000003009E.title: "Bamboo"
	quest.420000000003009F.quest_desc: [
		"Berries while you build.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.420000000003009F.title: "Sweet Berries"
	quest.42000000000300A0.quest_desc: [
		"Grown on jungle logs, ground into the brown that flavors everything sweet.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000300A0.title: "Cocoa"
	quest.42000000000300A1.quest_desc: [
		"Falls from oak leaves on its own time. Free food, eventually.",
		"How: oak leaves drop a few; a Pam's apple tree (sapling from iron-mesh dirt) bears many."
	]
	quest.42000000000300A1.title: "Apple"
	quest.42000000000300A2.quest_desc: [
		"One bowl, no crafting table. The lazy farmer's dinner.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000300A2.title: "Mushroom Stew"
	quest.42000000000300A3.quest_desc: [
		"A taste of the hive before the deeper work with bees begins.",
		"How: glass bottle on a full hive. Campfire underneath."
	]
	quest.42000000000300A3.title: "Honey Bottle"
	quest.42000000000300A4.quest_desc: [
		"Grow on cave vines and light the tunnel while you eat them.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000300A4.title: "Glow Berries"
	quest.42000000000300A5.quest_desc: [
		"The base of every potion worth bottling. Grows only on soul sand.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000300A5.title: "Nether Wart"
	quest.42000000000300A6.quest_desc: [
		"A field, a kitchen, essence rising.",
		"Tension the Strand: the Rootbinders answer.",
		"Claim it and choose one gift from the tribe: a Thread of Return for one more shared life, or supplies.",
		"How: finish the quests linked to this one, then claim it for the Strand token. Seat the token at your Tension Post."
	]
	quest.42000000000300A6.quest_subtitle: "Root"
	quest.42000000000300A6.title: "Sprout Knot"
	quest.42000000000300A7.quest_desc: [
		"Right-click your Clowder's Tension Post with the token.",
		"The notch lights, the tribe chimes, the pad changes.",
		"How: right-click your Tension Post with the Strand token in hand."
	]
	quest.42000000000300A7.title: "Seat Sprout"
	quest.42000000000300A8.quest_desc: [
		"Every Rootbinder pulls one eventually.",
		"Do not eat it. Do not throw it away either.",
		"How: a rare potato harvest. Optional Sprout secret."
	]
	quest.42000000000300A8.title: "Wrong Potato"
	quest.42000000000400A9.quest_desc: [
		"Cut the void on your terms. Eight sheets of plans.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: four paper and one blue dye, shapeless. Yields four sheets."
	]
	quest.42000000000400A9.title: "Blueprint Paper"
	quest.42000000000400AA.quest_desc: [
		"Plans in a box.",
		"Four Blueprint Paper, shapeless — claiming a pad wipes Silent Gear's join gift. Right-click to unwrap starter plans.",
		"How: four Blueprint Paper, shapeless. Right-click to unwrap starter plans. Claiming a pad wipes Silent Gear's join gift."
	]
	quest.42000000000400AA.title: "Blueprint Package"
	quest.42000000000400AB.quest_desc: [
		"The template a modular tool starts from before you add its parts.",
		"How: unwrap the Blueprint Package, or JEI. Claw names the tool line."
	]
	quest.42000000000400AB.title: "Rod Blueprint"
	quest.42000000000400AC.quest_desc: [
		"Shape a pick that outlives its metal.",
		"How: unwrap the Blueprint Package, or JEI. Claw names the tool line."
	]
	quest.42000000000400AC.title: "Pick Blueprint"
	quest.42000000000400AD.quest_desc: [
		"Shape an axe.",
		"How: unwrap the Blueprint Package, or JEI. Claw names the tool line."
	]
	quest.42000000000400AD.title: "Axe Blueprint"
	quest.42000000000400AE.quest_desc: [
		"Shape a shovel.",
		"How: unwrap the Blueprint Package, or JEI. Claw names the tool line."
	]
	quest.42000000000400AE.title: "Shovel Blueprint"
	quest.42000000000400AF.quest_desc: [
		"Shape a blade.",
		"How: unwrap the Blueprint Package, or JEI. Claw names the tool line."
	]
	quest.42000000000400AF.title: "Sword Blueprint"
	quest.42000000000400B0.quest_desc: [
		"Room to grow.",
		"How: JEI after Blueprint Paper. Claw names the upgrade line."
	]
	quest.42000000000400B0.title: "Upgrade Base"
	quest.42000000000400B1.quest_desc: [
		"Thirty-two bars of material for parts.",
		"How: smelt raw iron / iron grit (furnace or Ember Kiln). Sieve gravel for chunks."
	]
	quest.42000000000400B1.title: "Iron Mass"
	quest.42000000000400B2.quest_desc: [
		"Sharpens a blade's edge past what iron alone can manage.",
		"How: sieve gravel with an iron mesh or better, or Echo Shatter diamond ore."
	]
	quest.42000000000400B2.title: "Diamond Tip"
	quest.42000000000400B3.quest_desc: [
		"Leaves and wool, and combs later.",
		"How: two iron ingots diagonal. Shear sheep and bee nests."
	]
	quest.42000000000400B3.title: "Shears"
	quest.42000000000400B4.quest_desc: [
		"Pads have edges. So do mobs.",
		"How: six planks around iron. Off-hand block."
	]
	quest.42000000000400B4.title: "Shield"
	quest.42000000000400B5.quest_desc: [
		"Survive the night on purpose.",
		"How: eight iron ingots. Smelt sieve grit."
	]
	quest.42000000000400B5.title: "Iron Chestplate"
	quest.42000000000400B6.quest_desc: [
		"Mind the drop.",
		"How: five iron ingots."
	]
	quest.42000000000400B6.title: "Iron Helmet"
	quest.42000000000400B7.quest_desc: [
		"Covers the legs first. Most damage comes from below anyway.",
		"How: seven iron ingots."
	]
	quest.42000000000400B7.title: "Iron Leggings"
	quest.42000000000400B8.quest_desc: [
		"Steadies your footing on ledges where a slip means the void.",
		"How: four iron ingots."
	]
	quest.42000000000400B8.title: "Iron Boots"
	quest.42000000000400B9.quest_desc: [
		"Keep the void's mobs at a distance.",
		"How: three string and three sticks."
	]
	quest.42000000000400B9.title: "Bow"
	quest.42000000000400BA.quest_desc: [
		"Sixty-four reasons to keep distance.",
		"How: flint, stick, feather. Skeletons drop extras."
	]
	quest.42000000000400BA.title: "Arrow Bundle"
	quest.42000000000400BB.quest_desc: [
		"Light the way through.",
		"How: iron ingot plus flint."
	]
	quest.42000000000400BB.title: "Flint and Steel"
	quest.42000000000400BC.quest_desc: [
		"Ten blocks. A door the Edge-walkers would recognise.",
		"How: water on a lava source (or lava on water). Keep the lava source."
	]
	quest.42000000000400BC.title: "Obsidian Frame"
	quest.42000000000400BD.quest_desc: [
		"Foothold prep. Somewhere else exists.",
		"How: pearl (Edge-walkers' stall / endermen) plus blaze powder from a Nether fortress after Claw obsidian. Eight-eye stock is optional; End crystals use the same craft."
	]
	quest.42000000000400BD.title: "Ender Eye"
	quest.42000000000400BE.quest_desc: [
		"Soft power for hard tools.",
		"How: two diamonds, four obsidian, book. Diamonds from iron-mesh gravel."
	]
	quest.42000000000400BE.title: "Enchanting Table"
	quest.42000000000400BF.quest_desc: [
		"Repair and name what you carry.",
		"How: three iron blocks over four ingots."
	]
	quest.42000000000400BF.title: "Anvil"
	quest.42000000000400C0.quest_desc: [
		"Call it yours.",
		"How: fishing / rare chests, or the Seal-carvers' stall at /clowder hub (24 Thread). Optional."
	]
	quest.42000000000400C0.title: "Name Tag"
	quest.42000000000400C1.quest_desc: [
		"The starting template for a modular hoe, built part by part.",
		"How: unwrap the Blueprint Package, or JEI."
	]
	quest.42000000000400C1.title: "Hoe Blueprint"
	quest.42000000000400C2.quest_desc: [
		"Clears a wide swath of crops in one swing instead of one plant.",
		"How: unwrap the Blueprint Package, or JEI."
	]
	quest.42000000000400C2.title: "Sickle Blueprint"
	quest.42000000000400C3.quest_desc: [
		"One tool that mines, chops, and digs. No more swapping in your hand.",
		"How: unwrap the Blueprint Package, or JEI."
	]
	quest.42000000000400C3.title: "Paxel Blueprint"
	quest.42000000000400C4.quest_desc: [
		"Breaks a three by three block of stone in a single hit.",
		"How: unwrap the Blueprint Package, or JEI."
	]
	quest.42000000000400C4.title: "Hammer Blueprint"
	quest.42000000000400C5.quest_desc: [
		"Clears wide holes in dirt and sand faster than any shovel.",
		"How: unwrap the Blueprint Package, or JEI."
	]
	quest.42000000000400C5.title: "Excavator Blueprint"
	quest.42000000000400C6.quest_desc: [
		"Small, fast, and precise. Built for close work, not for war.",
		"How: unwrap the Blueprint Package, or JEI."
	]
	quest.42000000000400C6.title: "Knife Blueprint"
	quest.42000000000400C7.quest_desc: [
		"Soft plating, easily enchanted, worth more for its magic than its defense.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000400C7.title: "Gold Armor Bits"
	quest.42000000000400C8.quest_desc: [
		"Sea claw.",
		"Optional — the void may never offer one.",
		"How: drowned only. Optional."
	]
	quest.42000000000400C8.title: "Trident"
	quest.42000000000400C9.quest_desc: [
		"Loads slow, hits hard, and holds its charge until you need it.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000400C9.title: "Crossbow"
	quest.42000000000400CA.quest_desc: [
		"Scan the void.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000400CA.title: "Spyglass"
	quest.42000000000400CB.quest_desc: [
		"Plans, iron on your back, a door out.",
		"Tension the Strand: the Edge-walkers answer. The braid opens.",
		"Claim it and choose one gift from the tribe: a Thread of Return for one more shared life, or supplies.",
		"How: finish the quests linked to this one, then claim it for the Strand token. Seat the token at your Tension Post."
	]
	quest.42000000000400CB.quest_subtitle: "Edge"
	quest.42000000000400CB.title: "Claw Knot"
	quest.42000000000400CC.quest_desc: [
		"Right-click your Clowder's Tension Post with the token.",
		"The notch lights, the tribe chimes, the pad changes.",
		"How: right-click your Tension Post with the Strand token in hand."
	]
	quest.42000000000400CC.title: "Seat Claw"
	quest.42000000000400CD.quest_desc: [
		"Something tall looked back. Edge-walkers called them door-wardens.",
		"How: kill an enderman. Pearls also come from the Edge-walkers' stall."
	]
	quest.42000000000400CD.title: "Edge of the Edge"
	quest.42000000000500CE.quest_desc: [
		"A brief signal before the Hum. Sixty-four dust.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: sieve gravel, or Echo Shatter redstone ore after Recover."
	]
	quest.42000000000500CE.title: "Redstone Dust"
	quest.42000000000500CF.quest_desc: [
		"Parallel heat. Eight is a line, not a furnace.",
		"How: eight cobble around an empty centre."
	]
	quest.42000000000500CF.title: "Furnace Array"
	quest.42000000000500D0.quest_desc: [
		"Move the grit without hands.",
		"How: five iron around a chest. Sit it under a Loomframe or Tension Barrel (extract DOWN)."
	]
	quest.42000000000500D0.title: "Hopper Line"
	quest.42000000000500D1.quest_desc: [
		"Measure the beat.",
		"How: nether quartz, redstone torch, stone. Quartz sieves from soul sand; no Nether trip needed."
	]
	quest.42000000000500D1.title: "Comparator"
	quest.42000000000500D2.quest_desc: [
		"Bone, string, amethyst. The first beat.",
		"It yields two — keep one for the Spirit Codex.",
		"How: one bone, string, amethyst. /clowder hub Pad-keepers sell bones. Spark / Hum gate."
	]
	quest.42000000000500D2.title: "Hum: Bone Chime"
	quest.42000000000500D3.quest_desc: [
		"A shard of old tribe song. Needs a Chime.",
		"How: Bone Chime, amethyst and redstone, shapeless. Yields two."
	]
	quest.42000000000500D3.title: "Hum: Spirit Shard"
	quest.42000000000500D4.quest_desc: [
		"Copper around a Chime: metal tuned to spirit.",
		"How: copper around a Bone Chime. Yields two."
	]
	quest.42000000000500D4.title: "Hum: Copper Resonator"
	quest.42000000000500D5.quest_desc: [
		"Strike it. Hold a Pulse. Listen before you wire anything.",
		"Two Chimes, a Shard, two leather, four planks — the Pad-keepers at /clowder hub sell leather.",
		"How: two Bone Chimes, a Spirit Shard, two leather and four planks. Strike empty-handed on tempo (17–23 ticks) for 24 Pulse."
	]
	quest.42000000000500D5.title: "Hum: Drumheart"
	quest.42000000000500D6.quest_desc: [
		"Carry Pulse for tools, spells and travel — needs Resonator + Shard.",
		"How: craft, then fill from a Drumheart (click with the cell). Tools, spells and travel draw from the cell."
	]
	quest.42000000000500D6.title: "Hum: Pulse Cell"
	quest.42000000000500D7.quest_desc: [
		"Draw ambient ley into beats under open sky. Totem voices add; a Drumheart is not required.",
		"How: place under sky near water/green. Slow Pulse. Spark ladder."
	]
	quest.42000000000500D7.title: "Hum: Ley Collector"
	quest.42000000000500D8.quest_desc: [
		"Seat an Echo catalyst (it wears down as it works) and two different elemental totems. The camp sings its own power; redstone pauses the harmony.",
		"How: seat an Echo catalyst, two different totems within 8. Redstone pauses it."
	]
	quest.42000000000500D8.title: "Hum: Pulse Resonator"
	quest.42000000000500D9.quest_desc: [
		"A buffer for Forge Energy — the bridge from Pulse to wire, if you want one.",
		"How: Powah Grid chapter — energizing orb and cables after Spark Pulse exists."
	]
	quest.42000000000500D9.title: "Powah Starter Cell"
	quest.42000000000500DA.quest_desc: [
		"Burn fuel for Forge Energy.",
		"How: Powah Grid chapter — energizing orb and cables after Spark Pulse exists."
	]
	quest.42000000000500DA.title: "Powah Furnator"
	quest.42000000000500DB.quest_desc: [
		"Move energy along.",
		"How: Powah Grid chapter — energizing orb and cables after Spark Pulse exists."
	]
	quest.42000000000500DB.title: "Powah Cable"
	quest.42000000000500DC.quest_desc: [
		"Sky power, on a pad that is all sky.",
		"How: Powah Grid chapter — energizing orb and cables after Spark Pulse exists."
	]
	quest.42000000000500DC.title: "Solar Panel Starter"
	quest.42000000000500DD.quest_desc: [
		"Burns a heat difference into power. Feed it hot on one side, cold on the other.",
		"How: Powah Grid chapter — energizing orb and cables after Spark Pulse exists."
	]
	quest.42000000000500DD.title: "Thermo Generator"
	quest.42000000000500DE.quest_desc: [
		"Charge items in a ring of rods.",
		"How: Powah Grid chapter — energizing orb and cables after Spark Pulse exists."
	]
	quest.42000000000500DE.title: "Energizing Orb"
	quest.42000000000500DF.quest_desc: [
		"Feed the orb.",
		"How: Powah Grid chapter — energizing orb and cables after Spark Pulse exists."
	]
	quest.42000000000500DF.title: "Energizing Rod"
	quest.42000000000500E0.quest_desc: [
		"A pocketful of stored power.",
		"How: Powah Grid chapter — energizing orb and cables after Spark Pulse exists."
	]
	quest.42000000000500E0.title: "Battery"
	quest.42000000000500E1.quest_desc: [
		"Rotates machines in place instead of breaking and replacing them.",
		"How: Powah Grid chapter — energizing orb and cables after Spark Pulse exists."
	]
	quest.42000000000500E1.title: "Wrench"
	quest.42000000000500E2.quest_desc: [
		"Smelts ore twice as fast as a regular furnace, ore only.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000500E2.title: "Blast Furnace"
	quest.42000000000500E3.quest_desc: [
		"Cooks meat twice as fast as a campfire, food only.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000500E3.title: "Smoker"
	quest.42000000000500E4.quest_desc: [
		"Nine coal pressed dense. One block outlasts a whole stack of lumps.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000500E4.title: "Coal Block (Spark)"
	quest.42000000000500E5.quest_desc: [
		"Nudges one item at a time into whatever sits in front of it.",
		"How: cobble around redstone."
	]
	quest.42000000000500E5.title: "Dropper"
	quest.42000000000500E6.quest_desc: [
		"Push with purpose.",
		"How: cobble, bow, and redstone."
	]
	quest.42000000000500E6.title: "Dispenser"
	quest.42000000000500E7.quest_desc: [
		"Pushes a block forward on a signal, then waits for the next one.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000500E7.title: "Piston"
	quest.42000000000500E8.quest_desc: [
		"Pushes a block out and pulls it back when the signal drops.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000500E8.title: "Sticky Piston"
	quest.42000000000500E9.quest_desc: [
		"Observer reads the beat.",
		"How: cobble, redstone, and nether quartz."
	]
	quest.42000000000500E9.title: "Observer"
	quest.42000000000500EA.quest_desc: [
		"Repeater times the circuit.",
		"How: redstone torch, redstone, stone. Pipes chapter uses it for clocks."
	]
	quest.42000000000500EA.title: "Repeater"
	quest.42000000000500EB.quest_desc: [
		"Registers a hit with signal strength based on how close to center.",
		"How: redstone around hay. Hay is three wheat."
	]
	quest.42000000000500EB.title: "Target"
	quest.42000000000500EC.quest_desc: [
		"Draws a strike away from your roof and grounds the charge.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000500EC.title: "Lightning Rod"
	quest.42000000000500ED.quest_desc: [
		"Time for power.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000500ED.title: "Clock"
	quest.42000000000500EE.quest_desc: [
		"Light without torches.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000500EE.title: "Copper Bulb"
	quest.42000000000500EF.quest_desc: [
		"Lights up on a signal and goes dark the moment it stops.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000500EF.title: "Redstone Lamp"
	quest.42000000000500F0.quest_desc: [
		"Reads the sky and sends a signal that rises and falls with the sun.",
		"How: glass, nether quartz, wood slabs."
	]
	quest.42000000000500F0.title: "Daylight Detector"
	quest.42000000000500F1.quest_desc: [
		"Flips a signal on or off by hand. The oldest switch there is.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000500F1.title: "Lever"
	quest.42000000000500F2.quest_desc: [
		"Button taps a redstone pulse.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000500F2.title: "Button"
	quest.42000000000500F3.quest_desc: [
		"Sends a signal when something heavier than air stands on it.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000500F3.title: "Pressure Plate"
	quest.42000000000500F4.quest_desc: [
		"Strung with string across a path, it catches anything that crosses.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000500F4.title: "Tripwire Hook"
	quest.42000000000500F5.quest_desc: [
		"Plays one note per block type beneath it. Drumhearts hear a song in a row of them.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000500F5.title: "Note Block"
	quest.42000000000500F6.quest_desc: [
		"Jukebox for pad morale.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000500F6.title: "Jukebox"
	quest.42000000000500F7.quest_desc: [
		"Rolls along track under gravity or a push. No rails, no ride.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000500F7.title: "Minecart"
	quest.42000000000500F8.quest_desc: [
		"Rails across the void span.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000500F8.title: "Rail"
	quest.42000000000500F9.quest_desc: [
		"Powered rail for carts.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000500F9.title: "Powered Rail"
	quest.42000000000500FA.quest_desc: [
		"Reads a passing cart and fires a signal as it rolls over.",
		"How: craft, smelt, sieve, or mob-drop this. JEI lists every source on the pad."
	]
	quest.42000000000500FA.title: "Detector Rail"
	quest.42000000000500FB.quest_desc: [
		"Alt solar craft.",
		"How: three glass, three lapis and three Mirrors, a row of each."
	]
	quest.42000000000500FB.title: "Solar Flux Cell"
	quest.42000000000500FC.quest_desc: [
		"Simple item pipes.",
		"How: iron + redstone. Faces with the Pipez wrench."
	]
	quest.42000000000500FC.title: "Pipez Item"
	quest.42000000000500FD.quest_desc: [
		"Simple fluid pipes.",
		"How: iron + buckets + redstone. Sneak-use the wrench on a side to extract; right-click that side for filters."
	]
	quest.42000000000500FD.title: "Pipez Fluid"
	quest.42000000000500FE.quest_desc: [
		"Plain energy pipes between machines.",
		"How: iron + redstone. Carries FE between machines."
	]
	quest.42000000000500FE.title: "Pipez Energy"
	quest.42000000000500FF.quest_desc: [
		"Sets which pipe sides pull from a machine, or cuts a side off, without breaking the pipe.",
		"How: two flint and two sticks. Sneak-use a pipe side at a machine to make it extract, again to cut it off; right-click an extracting side for filters."
	]
	quest.42000000000500FF.title: "Pipez Wrench"
	quest.4200000000050100.quest_desc: [
		"Mark lattice lines — needs a Spirit Shard.",
		"How: two bone meal, lapis and a Spirit Shard, shapeless. Yields four."
	]
	quest.4200000000050100.title: "Ritual Chalk"
	quest.4200000000050101.quest_desc: [
		"A drum struck, a Pulse held, a Resonator seated.",
		"Tension the Strand: the Drumhearts answer.",
		"Claim it and choose one gift from the tribe: a Thread of Return for one more shared life, or supplies.",
		"How: finish the quests linked to this one, then claim it for the Strand token. Seat the token at your Tension Post."
	]
	quest.4200000000050101.quest_subtitle: "Hum"
	quest.4200000000050101.title: "Spark Knot"
	quest.4200000000050102.quest_desc: [
		"Right-click your Clowder's Tension Post with the token.",
		"The notch lights, the tribe chimes, the pad changes.",
		"How: right-click your Tension Post with the Strand token in hand."
	]
	quest.4200000000050102.title: "Seat Spark"
	quest.4200000000050103.quest_desc: [
		"Follow Tribal Weave through Echo refinement to a Resonant Core. The Harmonic Energizer turns the camp's harmony into FE for this chapter's machines. Unranked conversion is 60 Pulse a second; rank it at Echo stations for more. It cannot receive FE. Redstone pauses both conversion and export.",
		"How: five copper ingots, three redstone and a Resonant Core."
	]
	quest.4200000000050103.title: "Hum becomes current"
	quest.4200000000050104.quest_desc: [
		"A witch, on your pad, at night. The drums did not warn you.",
		"How: kill a witch on the pad at night."
	]
	quest.4200000000050104.title: "Bottled Trouble"
	quest.4200000000060105.quest_desc: [
		"Hands that work while you sleep. Thirty-two.",
		"The Nine Tribes left provisions for the next Clowder. Use a Steward Cache to unwrap random supplies, or craft four small caches into a medium and three mediums into a large. Larger seals hold more rolls and a broader supply pool; opening separately gives more basic supplies. No machines or progression tokens hide inside, but every seal has a small chance of a Thread Shard and a very small chance of a whole Thread of Return; bigger seals have better odds.",
		"How: andesite + iron nugget in a crafting table (or mixer)."
	]
	quest.4200000000060105.title: "Andesite Alloy"
	quest.4200000000060106.quest_desc: [
		"The rotation spine.",
		"How: andesite alloy in a cutting recipe / craft listed in JEI."
	]
	quest.4200000000060106.title: "Shaft"
	quest.4200000000060107.quest_desc: [
		"One cog. Then the same cog again.",
		"How: shaft + planks."
	]
	quest.4200000000060107.title: "Cogwheel"
	quest.4200000000060108.quest_desc: [
		"More teeth, slower turn.",
		"How: Create craft in JEI (crafting table, press, mixer or deployer). Andesite alloy and a water wheel start the line."
	]
	quest.4200000000060108.title: "Large Cog"
	quest.4200000000060109.quest_desc: [
		"Andesite casing frames Create.",
		"How: Create craft in JEI (crafting table, press, mixer or deployer). Andesite alloy and a water wheel start the line."
	]
	quest.4200000000060109.title: "Andesite Casing"
	quest.420000000006010A.quest_desc: [
		"A river in the sky, turning.",
		"How: eight planks around a shaft. Needs a water flow beside it."
	]
	quest.420000000006010A.title: "Water Wheel"
	quest.420000000006010B.quest_desc: [
		"Turns rotation by hand when nothing else is spinning yet.",
		"How: Create craft in JEI (crafting table, press, mixer or deployer). Andesite alloy and a water wheel start the line."
	]
	quest.420000000006010B.title: "Hand Crank"
	quest.420000000006010C.quest_desc: [
