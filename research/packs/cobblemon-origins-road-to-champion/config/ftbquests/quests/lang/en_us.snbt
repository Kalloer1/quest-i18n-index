	quest.3A8A0B3B88C54BF7.quest_desc: [
		"&eTier 3&r with &e6 Diamonds&r and &e2 Blocks of Diamond&r."
		""
		"Every slot holds &e16x&r as many stacks. Chests, barrels and shulker boxes take up to &e2&r stack upgrades each."
	]
	quest.3A8A0B3B88C54BF7.title: "Stack Upgrade Tier 4"
	quest.3A92509090946506.quest_desc: [
		"&6Price:&r &e6,000 CobbleDollars&r for one."
		""
		"Boosts the power of moves used consecutively"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
