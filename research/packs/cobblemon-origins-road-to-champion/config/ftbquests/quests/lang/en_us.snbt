	quest.0BB1B1AB4852A7B5.quest_desc: [
		"Sink and move freely underwater, and hold your breath longer."
		""
		"&6Where to look:&r Ancient City chests, shipwreck treasure, village temples, brushing Desert Wells."
	]
	quest.0BB1B1AB4852A7B5.title: "Charm of Sinking"
	quest.0BC2648DBC4EC8A9.quest_desc: [
