	quest.538FFD4CA8F60E0A.title: "Is It a Bird?"
	quest.539C1E2AAD530D7C.quest_desc: [
		"Has a 25% chance to strike attackers with lightning, and lightning cannot hurt you."
		""
		"&6Where to look:&r Ancient City chests."
