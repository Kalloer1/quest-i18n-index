	quest.64B045E3E2E12A21.quest_desc: [
		"The ultimate upgrade for a mount: 8 &eAprijuice&r (any color) around a &eNether Star&r."
		""
		"Use it on one of your own rideable Pokémon to raise all five ride stats by 100. Aprijuice comes from the &aCooking&r chapter; the Nether Star from the Wither."
	]
	quest.64B045E3E2E12A21.title: "Rider's Relic"
	quest.64C304E705453A39.quest_desc: [
		"Catch &e5&r Pokémon in &dthe End&r."
		""
		"Every letter of &bUnown&r drifts around the End islands, along with &bBeldum&r, &bElgyem&r, &bSolosis&r, &bGothita&r and &bSigilyph&r."
	]
	quest.64C304E705453A39.title: "Edge of the World"
	quest.64C53A9EC5EF6255.quest_desc: [
		"&eCobblemon&r ruins, &eLegendary Monuments&r shrines and &eMega Showdown&r sites hide golden &eGilded Chests&r. Lootr turns them into per-player &eGilded Loot Chests&r."
		""
		"Find one and take a good look before you open it."
	]
	quest.64C53A9EC5EF6255.title: "All That Glitters"
	quest.64C700D589778F54.quest_desc: [
