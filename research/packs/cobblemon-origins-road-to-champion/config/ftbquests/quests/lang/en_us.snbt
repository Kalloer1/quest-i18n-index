	quest.542B52ECF884127B.title: "Crystal Heart"
	quest.54401600D99780B9.quest_desc: [
		"The Emerald-free route: &e7 Glass&r around a &eDiamond Furnace&r with an &eEye of Ender&r in the bottom slot."
		""
		"Same &e40 ticks&r per item as the Emerald Furnace. The Eye of Ender needs Blaze Powder, so this one waits for the Nether. Its real job comes later: the Rainbow Plating recipe needs one."
	]
	quest.54401600D99780B9.title: "Crystal Furnace"
	quest.546A02C232EA5ECF.quest_desc: [
		"Catch one &eElectric&r, one &6Ground&r and one &3Flying&r Pokémon."
		""
		"Electric zaps Flying, but Ground hits Electric hard and takes nothing back."
		"Flying, in turn, is completely immune to Ground moves."
	]
	quest.546A02C232EA5ECF.title: "Storm and Soil"
	quest.5472936D9C4D014E.quest_desc: [
		"The &bEternatus Cocoon&r rests in the End highlands. Mine &eGalar Particles&r from Galar Particle Ore (stone and deepslate, Y -24 to 56) and feed the cocoon 500 of them until it breaks."
		""
		"&cWhat hatches is &dEternatus&c, and it is not friendly.&r"
	]
	quest.5472936D9C4D014E.title: "The Darkest Day"
	quest.5477DA8B65609894.quest_desc: [
		"&6Price:&r &e400 CobbleDollars&r for one."
		""
		"Cures a Pokémon from paralysis"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
