	quest.3C0A4FD9E497DFAC.title: "Relaxed Mint"
	quest.3C1277A2B1281A5B.quest_desc: [
		"&ePiglin Brutes&r guard Bastion Remnants with golden axes. Golden armor does not calm them."
		""
		"Defeat one. They do not respawn, so each Bastion only has a few."
	]
	quest.3C1277A2B1281A5B.title: "Bouncer"
	quest.3C132300156CB2E2.quest_desc: [
