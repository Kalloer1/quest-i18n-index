	quest.5364808BBD3C2926.quest_subtitle: "6,000 CD"
	quest.5364808BBD3C2926.title: "Potion x10"
	quest.537017A624777B8C.quest_desc: ["Mulch plus &eBlaze Powder&r makes &eRich Mulch&r: the tree yields more Berries per harvest."]
	quest.537017A624777B8C.title: "Bumper Crop"
	quest.537CB1892439EDF2.quest_desc: [
		"Find the &6Stony Spires&r."
		""
		"Bagon, Shelgon and even Salamence lurk in the shadowy, sheltered spots between the spires."
	]
	quest.537CB1892439EDF2.title: "Dragon Spires"
	quest.538FFD4CA8F60E0A.quest_desc: [
		"Look at the Ender Dragon through a &eSpyglass&r."
		""
