	quest.54F4B04625E569AF.quest_desc: [
		"Find a &eDusk Stone&r."
		""
		"&6Ore:&r dark forests and other spooky biomes, taigas and snowy taigas, rarer in swamps."
		"&6Evolves:&r Murkrow, Misdreavus, Lampent and Doublade."
	]
	quest.54F4B04625E569AF.title: "Gathering Dusk"
	quest.54FC1B80D85A58D3.quest_desc: [
		"Visit any village."
		""
		"Most villages here are built by &eChoTuve's Villages&r, and with Cobblemon they can include a &ePokécenter&r with a Healing Machine and PC, plus berry farms in place of crops."
		"Look for a &eCobble Merchant&r and a &eWaystone&r while you are there."
	]
	quest.54FC1B80D85A58D3.title: "Signs of Civilisation"
	quest.54FF4656DF860361.quest_desc: [
		"Kill any mob next to a &eSculk Catalyst&r and watch sculk bloom over the ground."
		""
		"The catalyst soaks up the XP of nearby deaths and turns it into sculk."
	]
	quest.54FF4656DF860361.title: "It Spreads"
	quest.55028BD5BBE2C181.quest_desc: ["Brew a PP Up with a &eQualot Berry&r to make &eIron&r. Each one adds 10 Defense EVs."]
