	quest.5477DA8B65609894.title: "Paralyze Heal"
	quest.5485ECAAE8E56B9A.quest_desc: [
		"Eight planks around a &eClock&r. The &eClock Block&r shows the time of day on its faces."
		""
		"Read it with a &eComparator&r: the output follows the hour, so it can switch farms or lights on a schedule."
	]
	quest.5485ECAAE8E56B9A.title: "What Time Is It?"
	quest.548F2C11304DC77B.quest_desc: [
		"&eSticky Piston&r, &e2 String&r and &e3 Redstone&r around an &eUpgrade Base&r."
		""
		"Items you pick up go straight into the backpack instead of your inventory. Filters let you choose which."
	]
	quest.548F2C11304DC77B.title: "Pickup Upgrade"
	quest.54AB031B96B43A98.quest_desc: [
		"Collect all &e19&r wild Vivillon patterns."
		""
		"Every pattern spawns in its own kind of biome, so this one is a world tour. Pair it with the habitat quests below."
	]
	quest.54AB031B96B43A98.title: "Aspiring Vivillionaire"
	quest.54BC1DB509EE02FA.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Boosts the power of the holder's Fire-type moves"
