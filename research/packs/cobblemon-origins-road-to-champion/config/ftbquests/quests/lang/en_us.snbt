	quest.413A6F4C84929095.quest_subtitle: "2,000 CD"
	quest.413A6F4C84929095.title: "Water Gem"
	quest.41440F83B9DB8C4A.quest_desc: ["Clear all three lakes, then bind &eUxie's Claw&r, &eAzelf's Fang&r and &eMesprit's Plume&r into the &eRed Chain&r."]
	quest.41440F83B9DB8C4A.title: "The Red Chain"
	quest.414FB582B9401AF3.quest_desc: [
		"&6Price:&r &e400 CobbleDollars&r for one."
		""
		"Cures a Pokémon from a burn"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.414FB582B9401AF3.quest_subtitle: "400 CD"
	quest.414FB582B9401AF3.title: "Burn Heal"
	quest.415F2C09D8393CBD.quest_desc: [
