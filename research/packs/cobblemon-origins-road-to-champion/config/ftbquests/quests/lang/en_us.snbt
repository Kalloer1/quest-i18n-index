	quest.529EE04446CB0275.quest_subtitle: "2,500 CD"
	quest.529EE04446CB0275.title: "Starf Berry"
	quest.52B6C41F501BD210.quest_desc: [
		"Register &e25&r species as &eCaught&r in your Pokédex."
		""
		"&aTip:&r a &eRepeat Ball&r is 3.5x on species already registered as caught, so save it for duplicates."
	]
	quest.52B6C41F501BD210.title: "Growing Database"
	quest.52CB4B0973763912.quest_desc: [
		"Some Pokémon are big enough to carry you. Send one out, sneak and interact with it, then pick &eRide&r."
		""
		"Swimmers, fliers and runners all ride differently: try a few."
	]
	quest.52CB4B0973763912.title: "Pokémon Jockey!"
	quest.52EF5E8ECC0243E9.quest_desc: [
		"Craft a &eCram-O-Matic&r from a Feather, Blue Dye, a Stick, 2 Coal, a Dispenser, 2 Iron Ingots and a Chest."
		""
		"Feed it any &eApricorn&r for a random Poké Ball, held item or Sweet. A good home for surplus Apricorns."
	]
	quest.52EF5E8ECC0243E9.title: "Cram-O-Matic"
	quest.530C9863B68C5A5F.quest_desc: [
		"&6Price:&r &e8,000 CobbleDollars&r for one."
		""
		"Boosts the holder's critical hit ratio"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.530C9863B68C5A5F.quest_subtitle: "8,000 CD"
	quest.530C9863B68C5A5F.title: "Scope Lens"
	quest.53393FB22E36883E.quest_desc: [
		"&6Price:&r &e6,000 CobbleDollars&r for one."
		""
		"Protects the holder from contact effects from the target"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.53393FB22E36883E.quest_subtitle: "6,000 CD"
	quest.53393FB22E36883E.title: "Protective Pads"
	quest.5342283E8833069C.quest_desc: [
		"Use a &eCracked Pot&r (three Clay Balls, three Gold Ingots and a Gold Nugget) on Sinistea, or an &eUnremarkable Teacup&r (three Clay Balls and two Nether Quartz) on Poltchageist."
		""
		"&aTip:&r the rare Antique Sinistea needs a Chipped Pot and Artisan Poltchageist a Masterpiece Teacup."
	]
	quest.5342283E8833069C.title: "Tea Time"
	quest.53446115EE13CC89.quest_desc: [
		"Craft a &eWhite Plaque&r from 2 Chains, 3 Iron Ingots and White Dye."
		""
		"Plaques go on floors, walls and ceilings and come in all 16 dye colours. Craft any plaque with a dye to recolour it."
