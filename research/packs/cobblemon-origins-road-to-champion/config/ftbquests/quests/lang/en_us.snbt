	]
	quest.308E0B8122AA56AF.title: "Wax On"
	quest.30979090F3BA5C99.quest_desc: [
		"Craft a &eWooden Hoe&r from two Planks and two Sticks."
		""
		"Use it on dirt or grass near water to make &eFarmland&r."
		""
		"&aTip:&r any hoe tills soil; stone, iron and better hoes just last longer."
	]
	quest.30979090F3BA5C99.title: "Till the Soil"
	quest.30B8A18697243D68.quest_desc: [
		"&6Price:&r &e3,000 CobbleDollars&r for one."
		""
		"Evolves certain Pokémon"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
