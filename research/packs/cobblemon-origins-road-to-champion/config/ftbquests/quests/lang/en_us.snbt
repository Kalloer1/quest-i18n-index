	quest.53D7B7B7B54A4152.quest_subtitle: "1,500 CD"
	quest.53D7B7B7B54A4152.title: "Passho Berry"
	quest.53DCF5A25689721C.quest_desc: [
		"&eGuardians&r protect Ocean Monuments, rebuilt here by YUNG's Better Ocean Monuments. Their laser charges up, so break line of sight."
		""
