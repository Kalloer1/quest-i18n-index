	quest.55059863ABDBBCFD.title: "Spark of Genius"
	quest.551EFADA28D26A43.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Boosts the power of the holder's Fairy-type moves"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.551EFADA28D26A43.quest_subtitle: "5,000 CD"
	quest.551EFADA28D26A43.title: "Fairy Feather"
	quest.552CE77279E7AD26.quest_desc: [
		"Two mods tame the item flood. &6Sophisticated Storage&r gives you chests and barrels that grow in tiers and take upgrades. &6Tom's Simple Storage&r links plain chests into one searchable network."
		""
		"Both start here: a &eChest&r and a &eRedstone Torch&r. Most Sophisticated storage blocks have a torch in their recipe, and most Tom's blocks have a chest."
	]
	quest.552CE77279E7AD26.title: "&lStorage Solutions"
	quest.5544A4C42CA08F91.quest_desc: [
		"Eight cobblestone in a ring make a &eFurnace&r."
