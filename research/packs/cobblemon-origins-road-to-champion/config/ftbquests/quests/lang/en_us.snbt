	quest.082534465FFA1E0E.quest_subtitle: "4,000 CD"
	quest.082534465FFA1E0E.title: "PP Up"
	quest.08276F352AF02CAA.quest_desc: [
		"Finish &dExploration&r: Biome Tour, Structure Hunter, Treasure and Artifacts, and Travel and Camping."
		""
		"Every biome walked, every ruin searched, every waystone lit."
		""
		"&aUnlocks once every listed chapter finale is complete; then tick the checkmark.&r"
	]
	quest.08276F352AF02CAA.title: "World Explorer"
	quest.0851E131F4717A0C.quest_desc: ["Turn Glass into &eFancy Leaded Glass&r with a Chipped workbench or its tool, then place it and look at it."]
	quest.0851E131F4717A0C.title: "Fancy Leaded Glass"
	quest.0864325A9817118F.quest_desc: [
		"Mine the Wishing Star crystal in the Weald with a &eDiamond Pickaxe&r or better."
		""
		"&aOr craft two &eWishing Stars&r from seven Max Mushrooms, a Diamond and a Block of Lapis Lazuli.&r"
	]
	quest.0864325A9817118F.title: "When You Wish"
	quest.086521591F0DC97E.quest_desc: [
		"Like Pokémon with regional forms, some monsters change with the biome."
		""
		"Kill a &eHusk&r (deserts; causes Hunger), a &eStray&r (snowy biomes; Slowness arrows) and a &eBogged&r (swamps and Trial Chambers; Poison arrows)."
	]
	quest.086521591F0DC97E.title: "Regional Variants"
	quest.08756A6CBF8D7E55.quest_desc: ["Craft the &eCartographer&r's job site: 2 Paper over 4 Planks. Cartographers trade explorer maps, including one that leads to Trial Chambers."]
	quest.08756A6CBF8D7E55.title: "Cartographer"
	quest.08A50A719762B71C.quest_desc: [
		"Find a &emeteorite impact&r habitat in the badlands."
		""
		"Clefairy, Elgyem, Beldum, Lunatone and Solrock are drawn to the crater."
	]
	quest.08A50A719762B71C.title: "Fallen Star"
	quest.08A744C778668D61.quest_desc: [
		"A Pokémon's &eNature&r (on the summary's Info page) raises one stat and lowers another. A &eMint&r rewrites that alignment."
		""
		"&6Recipe rule:&r three leaves of the stat to raise plus one leaf of the stat to lower. Red = Attack, Blue = Defense, Cyan = Sp. Atk, Pink = Sp. Def, Green = Speed. Four White leaves make a neutral Serious Mint."
		""
		"Popular picks: &eAdamant&r, &eModest&r, &eJolly&r and &eTimid&r. Claim one as your reward."
	]
	quest.08A744C778668D61.title: "Mint Condition"
	quest.08A865A81E21014C.quest_desc: [
		"Diamond ore lies below y=16 and gets more common the deeper you dig."
		""
		"Branch-mine near the bottom of the world and keep a water bucket ready for lava."
	]
	quest.08A865A81E21014C.title: "Diamond Cache"
	quest.08B2595FDDB700CE.quest_desc: [
		"Brew a &aPotion of Leaping&r: Awkward Potion + &eRabbit's Foot&r (Rabbits drop them)."
		""
		"&aScorbunny, Raboot and Cinderace can drop a Rabbit's Foot as well.&r"
	]
	quest.08B2595FDDB700CE.title: "Spring in Your Step"
	quest.08BB1082E26F556C.quest_desc: [
		"&e8 Iron Ingots&r around a &eRedstone Torch&r (or 4 around a Basic to Copper upgrade)."
		""
		"Use it on a placed basic Sophisticated chest or barrel to jump straight to that tier, contents and all. Each of these upgrades is crafted from the one before."
	]
	quest.08BB1082E26F556C.title: "Basic to Iron Tier Upgrade"
	quest.08CA6E68D4B41ECD.quest_desc: [
		"Lets &eLucario&r Mega Evolve."
		""
		"Recipe: raw Mega Stone, two Iron Ingots, a Diamond and a &eBlack Belt&r."
	]
	quest.08CA6E68D4B41ECD.title: "Lucarionite"
	quest.08F73B208F023EDF.quest_desc: [
		"&eBig Roots&r hang from the underside of dirt and stone just below the surface."
		""
		"Held, a Big Root boosts the HP a Pokémon drains with its moves. One crafts into a Remedy."
	]
	quest.08F73B208F023EDF.title: "Down to the Roots"
	quest.08F9DF6C8C313409.quest_desc: [
		"Brush the Suspicious Sand at an Archaeological Site until it gives up a &eSparkling Stone&r. The Light stone turns up about five times as often as the Dark one."
		""
		"&aAlternative: craft one from seven Stellar Tera Shards, a Netherite Ingot and Calcite (Light) or Tuff (Dark).&r"
	]
	quest.08F9DF6C8C313409.title: "Sparkle Hunting"
	quest.0902937671495E0C.quest_desc: [
		"Surround a &eSmelting Upgrade&r with &e4 Logs&r (or build one from a Smoker)."
		""
		"Cooks food in an upgrade tab."
	]
	quest.0902937671495E0C.title: "Smoking Upgrade"
	quest.091CD8F29FC0F587.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.091CD8F29FC0F587.quest_subtitle: "5,000 CD"
	quest.091CD8F29FC0F587.title: "Mental Herb"
	quest.093C02466C870AB1.quest_desc: [
		"The &eDragon Egg&r sits on top of the exit portal and teleports away if you hit it. Break the block under it with a torch placed below, or push it with a Piston, so it drops as an item."
		""
		"There is only &eone egg per world&r: dragons you summon again drop none. If a friend already has it, they can hand it to you to finish this quest."
	]
	quest.093C02466C870AB1.title: "The Next Generation"
	quest.094FE356ED01F526.quest_desc: ["Find a &eLiberty Pass&r in desert temple chests, Thalic Pyramid chests (Plains of Death) or the Throneroom of Knightly Heroes."]
	quest.094FE356ED01F526.title: "Finders Keepers"
	quest.095C168E69E7BFA5.quest_desc: [
		"Find a &cPillager Outpost&r, a watchtower full of crossbow-wielding Pillagers."
		""
		"Its chests hold crossbows, Bottles o' Enchanting and sometimes a &eSentry&r armor trim template."
		"&cPillagers keep spawning around it. Go in prepared.&r"
	]
	quest.095C168E69E7BFA5.title: "Watchtower"
	quest.0969EBB3F9012B08.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
