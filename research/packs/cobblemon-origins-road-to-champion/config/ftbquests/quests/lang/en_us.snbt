	quest.3C132300156CB2E2.title: "Sun Stone"
	quest.3C17234EA695A16A.quest_desc: [
		"Key item: &eSugar&r."
		""
		"&a+&r Halves the cook time of every recipe."
		"&c-&r Uses twice as much fuel."
	]
	quest.3C17234EA695A16A.title: "Augment: Speed"
	quest.3C385019998B3A09.quest_desc: [
		"One coal or charcoal on top of a stick makes four &eTorches&r."
		""
		"&cHostile mobs cannot spawn on any block lit by a torch.&r Light up your base and every cave you explore."
	]
