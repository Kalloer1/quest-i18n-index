	]
	quest.3C42A4166EEEE0FE.quest_subtitle: "6,000 CD"
	quest.3C42A4166EEEE0FE.title: "Throat Spray"
	quest.3C50FC57D6144D2B.quest_desc: [
		"Find a &eWater Stone Ore&r: it generates under oceans, rivers and lakes, more rarely under jungles, thermal biomes and tropical islands."
		"Look at the regular stone variant, found above the deepslate layer."
		""
		"&aPokémon tip:&r this stone evolves Pokémon such as Poliwhirl, Staryu and Eevee."
	]
	quest.3C50FC57D6144D2B.title: "Water Stone Ore"
	quest.3C5F89AF5ACD8BFD.quest_desc: [
		"Collect every ball on the list: the basic colors, every specialty ball (Sport, Park and Safari included), all fifteen Ancient balls, the Beast Ball and the &eMaster Ball&r."
		""
		"Master Ball recipe: a &eNether Star&r core, 2 &eNetherite Ingots&r and 2 &eShulker Shells&r. It never fails."
		""
		"&oThe ultimate ball collection.&r"
	]
	quest.3C5F89AF5ACD8BFD.title: "Poké Ball Maniac"
	quest.3C6E9FFCEE2CC28F.quest_desc: [
		"&6Price:&r &e10,000 CobbleDollars&r for one."
		""
		"Boosts the damage of super-effective moves"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.3C6E9FFCEE2CC28F.quest_subtitle: "10,000 CD"
	quest.3C6E9FFCEE2CC28F.title: "Expert Belt"
	quest.3C80F72F861D783A.quest_desc: [
		"Defeat a &etier 5&r raid boss."
		""
		"Tier 5 bosses are level &e75&r with 20x their normal HP. A win pays &e15,000&r CobbleDollars and the reward Pokémon comes with &e4&r perfect IVs."
		""
		"&aTier 5 is the highest tier that appears in this pack.&r"
	]
	quest.3C80F72F861D783A.quest_subtitle: "Tier 5 raid"
	quest.3C80F72F861D783A.title: "Five-Star Finale"
	quest.3C8236FD2DF60E44.quest_desc: [
		"Adds 5 hearts to your maximum health."
		""
		"&6Where to look:&r Bastion treasure rooms, End City chests, Pillager Outposts."
	]
	quest.3C8236FD2DF60E44.title: "Crystal Heart"
	quest.3CCECA532B1EB80C.quest_desc: [
		"Catch one &fNormal&r, one &5Ghost&r and one &2Bug&r Pokémon."
		""
		"Normal and Ghost moves pass right through each other: each is immune to the other."
		"Ghost also resists Bug and is immune to Fighting."
	]
	quest.3CCECA532B1EB80C.title: "Odd Ones Out"
	quest.3CDBF02280914B69.quest_desc: [
		"Craft a &eTimer Ball&r: 2 White Apricorns, 1 Red Apricorn and 1 Black Apricorn around a &eGold Ingot&r."
		""
		"&6Catch rate:&r 1x to 4x, rising each turn up to turn 10."
	]
	quest.3CDBF02280914B69.title: "Timer Ball"
	quest.3CE5F7AF95EE52AD.quest_desc: [
		"&6Price:&r &e3,000 CobbleDollars&r for one."
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.3CE5F7AF95EE52AD.quest_subtitle: "3,000 CD"
	quest.3CE5F7AF95EE52AD.title: "Revive"
	quest.3CE861422A33EDC4.quest_desc: ["Not every lucid dream is kind. A nightmare leaves a &eNightmare Essence&r behind."]
	quest.3CE861422A33EDC4.title: "Bad Dreams"
	quest.3CE8CB9CC8C3A321.quest_desc: [
		"Reach the &6Yosemite Cliffs&r."
		""
		"Mienfoo train on the ledges and Skiddo graze the slopes."
		"&oRegisteel is said to stand watch over high mountains, ultra-rarely.&r"
	]
	quest.3CE8CB9CC8C3A321.title: "Cliffhanger"
	quest.3CEC018DB802D679.quest_desc: [
		"&6Price:&r &e1,500 CobbleDollars&r for one."
		""
		"Halves damage taken from a supereffective Fairy-type attack"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.3CEC018DB802D679.quest_subtitle: "1,500 CD"
	quest.3CEC018DB802D679.title: "Roseli Berry"
	quest.3D1D2B040451CAE7.quest_desc: [
		"A &eGlobe&r cannot be crafted from scratch: the &eWandering Trader&r sells one for 10 Emeralds, and they sometimes sit in shipwreck treasure chests."
		""
		"Right-click a placed globe to give it a spin and see your coordinates."
	]
	quest.3D1D2B040451CAE7.title: "Around the World"
	quest.3D2D9C1199D8D8BB.quest_desc: [
		"Craft an &eOak Sign&r on its own to turn it into a &eWay Sign&r: a signpost with arms you can write on."
		""
		"Point friends toward your base, your berry farm or your favorite catching spot."
	]
	quest.3D2D9C1199D8D8BB.title: "Point the Way"
	quest.3D3E88AC9CBB7AF4.quest_desc: [
		"Throw a Wind Charge at your feet and ride the blast at least 7 blocks up."
		""
		"&aOne Breeze Rod makes four charges, so carry plenty.&r"
	]
	quest.3D3E88AC9CBB7AF4.title: "Updraft"
	quest.3D5A3AFABDFD5D8A.quest_desc: [
		"&6Where the ores are&r (press &eF3&r to see your Y level)"
		"&eCoal&r: y 0 and up. &eCopper&r: richest around y 48. &eIron&r: around y 16 and high inside mountains."
		"&eLapis&r: around y 0. &eGold&r: below y 32. &eRedstone&r and &eDiamond&r: near the bottom."
		"&eEmerald&r: only inside mountain biomes."
		""
		"Stone tools mine iron, copper and lapis. Gold, redstone, emerald and diamond need iron."
	]
	quest.3D5A3AFABDFD5D8A.title: "Reading the Rock"
	quest.3D698C87927B78BC.quest_desc: ["Combine the &eMolten&r, &eZap&r and &eArctic Stones&r from the urn summons into a &eVortex Stone&r: proof you may challenge the guardian of the seas."]
	quest.3D698C87927B78BC.title: "Eye of the Storm"
	quest.3D7FD41CE3714626.quest_desc: [
		"Eight echo shards around a compass make a &eRecovery Compass&r. It points to where you last died."
		""
		"Your items wait in your grave there, so it leads you straight back to them."
	]
	quest.3D7FD41CE3714626.title: "Lost and Found"
	quest.3D986233453222CC.quest_desc: ["Craft a &eLuvdisc Cushion&r from 6 Pink Wool."]
	quest.3D986233453222CC.title: "Heart-Shaped Cushion"
	quest.3DA228B8950DC1D5.quest_desc: [
		"&6Price:&r &e2,000 CobbleDollars&r for one."
		""
		"Raises the Pokémon's Speed EVs by 4"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.3DA228B8950DC1D5.quest_subtitle: "2,000 CD"
	quest.3DA228B8950DC1D5.title: "Swift Mochi"
	quest.3DAB90450E0959F2.quest_desc: [
		"Jump higher and fall further without getting hurt."
		""
		"&6Where to look:&r Bastion hoglin stables, buried treasure, village tanneries; rarely worn by zombies."
	]
	quest.3DAB90450E0959F2.title: "Bunny Hoppers"
	quest.3DBDF883C57C045A.quest_desc: [
		"Mine copper ore and smelt the raw copper."
		""
		"&aPokémon tip:&r a Copper Ingot is the core of every basic &ePoké Ball&r. The &eHealing Machine&r, &ePC&r and &ePokédex&r need copper too."
	]
	quest.3DBDF883C57C045A.title: "Copper Age"
	quest.3DCBCEF059FDBA58.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Boosts the power of the holder's Rock-type moves"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.3DCBCEF059FDBA58.quest_subtitle: "5,000 CD"
	quest.3DCBCEF059FDBA58.title: "Hard Stone"
	quest.3DD4DE5D33CFC6D7.quest_desc: [
		"Step inside a &eTrial Chamber&r, a copper and tuff complex buried deep underground."
		""
		"Hard to spot from the surface: a &eCartographer&r villager trades a map that leads to one."
	]
	quest.3DD4DE5D33CFC6D7.title: "Into the Trials"
	quest.3DEF30660B66280E.quest_desc: [
		"Endermen turn hostile when you look at their face, and the End is full of them."
		""
		"Wearing a &eCarved Pumpkin&r (shear a Pumpkin) on your head lets you look at them safely. It limits your view, so swap it off for the dragon fight."
	]
	quest.3DEF30660B66280E.title: "Do Not Look Them in the Eye"
	quest.3DF7D6865BD4274F.quest_desc: [
		"&6Price:&r &e1,000 CobbleDollars&r for one."
		""
		"2× catch rate"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.3DF7D6865BD4274F.quest_subtitle: "1,000 CD"
	quest.3DF7D6865BD4274F.title: "Ancient Ultra Ball"
	quest.3E0488223911ADB1.quest_desc: [
		"Catch a Pokémon with a &ePark Ball&r."
		""
		"&aUse it in forests and plains.&r"
	]
	quest.3E0488223911ADB1.title: "Walk in the Park"
	quest.3E19D26E95457338.quest_desc: ["At the &bDragonspiral Tower&r (plains) set the Light Stone and a &eFire Gem&r on the paired pedestals. &dReshiram&r awakens and leaves a &eTruth Bottle&r."]
	quest.3E19D26E95457338.title: "White Flame"
	quest.3E2C18D277FA9A50.quest_desc: [
		"Negative effects on you wear off within 5 seconds."
		""
		"&6Where to look:&r Bastion treasure rooms, village temples, brushing cold Ocean Ruins; rarely worn by Bogged and wither skeletons."
	]
	quest.3E2C18D277FA9A50.title: "Antidote Vessel"
	quest.3E2DBDD16630F162.quest_desc: [
		"&6Price:&r &e4,000 CobbleDollars&r for one."
		""
		"Damages the holder each turn, and transfers holders when hit"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.3E2DBDD16630F162.quest_subtitle: "4,000 CD"
	quest.3E2DBDD16630F162.title: "Sticky Barb"
	quest.3E439CEFAF498B65.quest_desc: ["Sail to &bLiberty Island&r over deep ocean and show the Liberty Pass to the Victini Lock. &dVictini&r comes out to play."]
	quest.3E439CEFAF498B65.title: "Small Victory"
	quest.3E8AB615FCE1EAD5.quest_desc: [
		"Use &eSurprise Mulch&r on a Revival Herb and it mutates into a &eWhite&r, &eMental&r, &ePower&r or &eMirror Herb&r."
		""
		"All four are single-use held items, so grow a few of each."
	]
	quest.3E8AB615FCE1EAD5.title: "Herbalist"
	quest.3E9B609686B44911.quest_desc: [
		"150 bites, custom bait, a FishingNav, a Prism Scale and a Dratini: few things in the water can still surprise you."
		""
		"Pick a bundle of specialty balls as your prize."
	]
	quest.3E9B609686B44911.title: "Master Angler"
	quest.3EB6FB4CDB8C0840.quest_desc: [
		"&6Dripstone Caves&r bristle with pointed dripstone and hold extra-large copper veins."
		""
		"&aPokémon tip:&r both &eMoon Stone&r and &eSun Stone&r ore generate here, and Clefairy wander the caves."
	]
	quest.3EB6FB4CDB8C0840.title: "Stalactite Stroll"
	quest.3F05B41712F54A57.quest_desc: [
		"Taking damage gives you a burst of Speed."
		""
		"&6Where to look:&r mineshaft chests, Bastion treasure rooms, Pillager Outposts."
	]
	quest.3F05B41712F54A57.title: "Panic Necklace"
	quest.3F1AC48FE408A725.quest_desc: [
		"&eElite Four Agatha&r waits in the &eKanto League&r, a grand hall on the outer islands of the &5End&r (End Highlands and Midlands). Search for it with the compass."
		""
		"League team: Gengar, Marshadow and Spectrier lead a team of Ghost and Dark Pokémon."
		""
		"She also wanders spooky biomes and swamps, sometimes with a different team. Either team counts, and the Elite Four can be fought in any order."
	]
	quest.3F1AC48FE408A725.quest_subtitle: "Elite Four Agatha"
	quest.3F1AC48FE408A725.title: "Ghost Story"
	quest.3F390A9C443A214A.quest_desc: [
		"Pulleys and cannons, cages and crystal displays, soap bubbles, sepia globes and a roaring fire pit: you have unpacked the whole Supplementaries toolbox."
		""
		"Claim your reward, then go build something nobody has seen before."
	]
	quest.3F390A9C443A214A.quest_subtitle: "Something for every occasion"
	quest.3F390A9C443A214A.title: "&lFully Supplemented"
	quest.3F3B60701961D33D.quest_desc: [
		"The &bHoopa Pyramid&r stands in the End highlands. Bring a &eTemple Key&r and a &ePrison Bottle&r to the Hoopa pedestal to summon &dHoopa&r. Both lie inside the pyramid; Temple Keys also turn up in the Lugia Temple."
		""
		"&aYou can also craft a Prison Bottle: Psychic Gem, Ender Chest, Eye of Ender, Dark Gem and Netherite Ingot.&r"
	]
	quest.3F3B60701961D33D.title: "Ring Delivery"
	quest.3F3B89F00D58AD65.quest_desc: [
		"Revive all four Galar fossil Pokémon: Dracozolt, Arctozolt, Dracovish and Arctovish."
		""
		"You need two of each half. Fossilized Fish turn up at underwater fissures and hydrothermal vents, Birds at buried trees."
	]
	quest.3F3B89F00D58AD65.title: "Mix and Match"
	quest.3F4F0030E594A5E1.quest_desc: [
		"&6Price:&r &e150 CobbleDollars&r for one."
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.3F4F0030E594A5E1.quest_subtitle: "150 CD"
	quest.3F4F0030E594A5E1.title: "Red Apricorn"
	quest.3F58A275B04BD38F.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Boosts the power of the holder's Normal-type moves"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.3F58A275B04BD38F.quest_subtitle: "5,000 CD"
	quest.3F58A275B04BD38F.title: "Silk Scarf"
	quest.3F739F99CBCE83F1.quest_desc: [
		"&6Price:&r &e6,000 CobbleDollars&r for one."
		""
		"Evolves Ursaring into Ursaluna when used during a full moon at night"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.3F739F99CBCE83F1.quest_subtitle: "6,000 CD"
	quest.3F739F99CBCE83F1.title: "Peat Block"
	quest.3F83FA4E48A9CB36.quest_desc: [
		"Eat a bar of &eSoap&r. Even the advancement tells you not to try this at home."
		""
		"Here is some milk to wash the taste out."
	]
	quest.3F83FA4E48A9CB36.title: "Soap for Supper"
	quest.3F9397CA3B260B35.quest_desc: [
		"Stand on the &6White Cliffs&r."
		""
		"Crabrawler and Mareanie are common along this coast."
		"&oSuicune is said to roam coasts like this, ultra-rarely.&r"
	]
	quest.3F9397CA3B260B35.title: "Chalk Cliffs"
	quest.3F97A677AA73441B.quest_desc: [
		"Brew an &eAwkward Potion&r: Water Bottles in the stand, &eNether Wart&r on top, Blaze Powder as fuel."
		""
		"It does nothing by itself, but almost every potion in this chapter starts from it."
		"&aOne ingredient brews all three bottles at once.&r"
	]
	quest.3F97A677AA73441B.title: "First Batch"
	quest.3F9EEE31282236AB.quest_desc: [
		"&eType Gems&r are held items that power up the holder's first move of that type, then get used up."
		""
		"Wild &6Alpha&r Pokémon can drop gems of their own types when defeated."
		"You can also craft one from &eHard Stone&r plus the type's resist berry (Dragon uses a &ePetaya Berry&r). Hard Stone comes from blasting Cobblestone."
		"&aTip:&r gems can also be grown with a Deepslate Crystal Core (see Fossils and Geology)."
	]
	quest.3F9EEE31282236AB.title: "Gem Lore"
	quest.3FD05A6ECB69765C.quest_desc: [
		"&eLegendary Monuments&r adds shrines and temples tied to legendary Pokémon, like the three Sinnoh lakes, the Spear Pillar and a Lugia temple."
		""
		"Your compass can find them, but their quests live in the &eLegends and Myths&r chapter."
		"Mega Showdown sites are covered in &eMega Evolution&r and &eZ-Moves, Tera and Dynamax&r."
	]
	quest.3FD05A6ECB69765C.title: "Shrines of Legend"
	quest.3FDFA4216B2FE2A7.quest_desc: [
		"&6Price:&r &e2,500 CobbleDollars&r for one."
		""
		"Raises holder's Attack by 1 stage when at 1/4 max HP or less"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.3FDFA4216B2FE2A7.quest_subtitle: "2,500 CD"
	quest.3FDFA4216B2FE2A7.title: "Liechi Berry"
	quest.3FF0F3A109563ED6.quest_desc: [
		"Find &eTrail Ruins&r: half-buried terracotta and mud brick remains, mostly underground."
		""
		"Their suspicious gravel holds the rarest sherds and four trim templates, so dig out the whole site."
	]
	quest.3FF0F3A109563ED6.title: "Lost Roads"
	quest.3FF785760069B970.quest_desc: [
		"Break tall grass for &eWheat Seeds&r and plant them on your Farmland."
		""
		"&aTip:&r Farmland stays hydrated near water, and crops need light to keep growing."
	]
	quest.3FF785760069B970.title: "A Seedy Start"
	quest.3FF7FBFDB4E38562.quest_desc: [
		"Craft a &ePark Ball&r: 3 Green Apricorns and 1 Red Apricorn around an &eIron Ingot&r."
		""
		"&6Catch rate:&r 2.5x in all Forest or Plains biomes."
	]
	quest.3FF7FBFDB4E38562.title: "Park Ball"
	quest.400B5ACEC742F9D0.quest_desc: ["Cook six XS candies together into an &eExp. Candy S&r (800 EXP). Six XS are only worth 600, so cooking up is pure profit."]
	quest.400B5ACEC742F9D0.title: "Bigger Bites"
	quest.4015D8F4142BBC5B.quest_desc: [
		"Six &eBamboo&r and a carpet weave a &eLunch Basket&r with 6 slots for food."
		""
		"Open it to eat straight from the basket, or set it down for a picnic. Ideal for long expeditions in search of rare Pokémon."
	]
	quest.4015D8F4142BBC5B.title: "Picnic Time"
	quest.401A9321B28F2F05.quest_desc: [
		"&6Price:&r &e10,000 CobbleDollars&r for one."
		""
		"Grants 8 Defense EVs when gaining experience in battle"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.401A9321B28F2F05.quest_subtitle: "10,000 CD"
	quest.401A9321B28F2F05.title: "Power Belt"
	quest.402766839571AE37.quest_desc: ["Join the &eTime Globe&r, &eSpace Globe&r and &eAntimatter Globe&r with the &eCelestica Flute&r to make the &eAzure Flute&r."]
	quest.402766839571AE37.title: "The Azure Flute"
	quest.403F238A20F8FCFF.quest_desc: [
		"Brush a &eSniffer Egg&r out of the suspicious sand of warm ocean ruins."
		""
		"Place it on &eMoss&r to hatch it faster."
	]
	quest.403F238A20F8FCFF.title: "An Ancient Egg"
	quest.406FB1B768F23F76.quest_desc: [
		"&6Price:&r &e2,000 CobbleDollars&r for one."
		""
		"Temporarily prevents stat reduction when used in battle"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.406FB1B768F23F76.quest_subtitle: "2,000 CD"
	quest.406FB1B768F23F76.title: "Guard Spec"
	quest.40A5D3DDCBAA4C45.quest_desc: [
		"One of the new Megas from Pokémon Legends: Z-A."
		"Lets &eEmboar&r Mega Evolve."
		""
		"Recipe: raw Mega Stone, a Diamond, a &eFire Gem&r and two &eFire Charges&r."
	]
	quest.40A5D3DDCBAA4C45.title: "Emboarite"
	quest.40C159763172EFA1.quest_desc: ["Take the shield path for the &eHero Shield&r and pair it with a Totem. &dZamazenta&r answers and gives you a Rusted Shield."]
	quest.40C159763172EFA1.title: "The Hero Shield"
	quest.40CF3F5F88194DCD.quest_desc: [
		"Find a &eStonjourner Henge&r on the plains."
		""
		"Look closely: some of the standing stones are Stonjourner."
	]
	quest.40CF3F5F88194DCD.title: "Standing Stones"
	quest.40D33E8958539656.quest_desc: [
		"A &eHopper Upgrade&r with a &eDiamond&r, &e2 Gold Ingots&r, &e2 Redstone&r and a &eDropper&r."
		""
		"Faster, with input and output options."
	]
	quest.40D33E8958539656.title: "Advanced Hopper Upgrade"
	quest.40DD01481DE5AFDE.quest_desc: [
		"Win the &eanimated Cubchoo Pokédoll&r from the Frosty Yarn pool."
		""
		"Odds: about 1 pull in 27. Be patient."
	]
	quest.40DD01481DE5AFDE.title: "It Moves!"
	quest.40E1E4108021F887.quest_desc: [
		"Gold ore needs an iron pickaxe and hides below y=32. Badlands hold far more of it, even high up."
		""
		"&aPokémon tip:&r gold is the core of the &eUltra Ball&r and part of the &eExp. Share&r."
	]
	quest.40E1E4108021F887.title: "Golden Opportunity"
	quest.4103F9C49F331D4A.quest_desc: [
		"Craft a &eDive Ball&r: 3 Blue Apricorns and 1 White Apricorn around an &eIron Ingot&r."
		""
		"&6Catch rate:&r 3.5x on Pokémon submerged in water."
	]
	quest.4103F9C49F331D4A.title: "Dive Ball"
	quest.41197F56F86FDFD7.quest_desc: [
		"Defeat 5 wild Pokémon."
		""
		"Only Pokémon that battle (or hold an &eExp. Share&r) earn EXP, and EXP gains are doubled in this pack. Wild wins also pay &eCobbleDollars&r."
	]
	quest.41197F56F86FDFD7.title: "Warming Up"
	quest.41369574960216C6.quest_desc: [
		"Terralith also reshapes the underground with its own cave biomes."
		""
