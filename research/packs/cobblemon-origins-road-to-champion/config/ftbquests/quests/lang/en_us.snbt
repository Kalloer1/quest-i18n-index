		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.30BD52240759D95D.quest_subtitle: "10,000 CD"
	quest.30BD52240759D95D.title: "Power Anklet"
	quest.30BEC9C227AFACB3.quest_desc: [
		"Surround your &eBackpack&r with &e8 Copper Ingots&r."
		""
		"Grows to &e45 slots&r, still &e1 upgrade slot&r."
	]
	quest.30BEC9C227AFACB3.title: "Copper Backpack"
	quest.30D132509C9A446E.quest_desc: [
		"Berries, mutations, Apricorns, Mints, roots and a working ranch: your garden supplies a whole team."
		""
		"Claim this once Sitrus, Enigma, Reapriforestation, Mints, Energy Root and Home on the Range are done."
	]
	quest.30D132509C9A446E.title: "Master Gardener"
	quest.3109F4A7472945F8.quest_desc: [
		"&6Price:&r &e4,500 CobbleDollars&r for one."
		""
		"Fully restores all PP to all of a Pokémon's moves"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.3109F4A7472945F8.quest_subtitle: "4,500 CD"
	quest.3109F4A7472945F8.title: "Max Elixir"
	quest.3121CAC35B77B96E.quest_desc: [
		"Craft an &eUpgrade&r: two Glass, a Redstone Lamp, two Copper Ingots and a Blank TM. The recipe viewer shows a second recipe too."
		""
		"Some trade evolutions only work while the Pokémon holds the right item."
	]
	quest.3121CAC35B77B96E.title: "Software Update"
	quest.312638E628AAB293.quest_desc: [
		"&6Price:&r &e1,000 CobbleDollars&r for one."
		""
		"4× on Pokémon reeled in with a Poké Rod"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.312638E628AAB293.quest_subtitle: "1,000 CD"
	quest.312638E628AAB293.title: "Lure Ball"
	quest.314AC08B6A7AD45D.quest_desc: [
		"Craft a &eLure Ball&r: 2 Blue Apricorns, 1 Red Apricorn and 1 Green Apricorn around an &eIron Ingot&r."
		""
		"&6Catch rate:&r 4x on Pokémon reeled in with a Poké Rod."
	]
	quest.314AC08B6A7AD45D.title: "Lure Ball"
	quest.3169DACFDC6CC859.quest_desc: [
		"Your Pokémon battle other Pokémon, but the monsters of the night are your job. Players cannot hurt Pokémon here, so swing freely."
		""
		"This chapter tracks every hostile mob worth hunting: kill ladders for the common ones, then the bosses of each dimension. Kill any monster to begin."
	]
	quest.3169DACFDC6CC859.title: "&cMonster Hunter"
	quest.3183469C7DF0218C.quest_desc: [
		"Find an Explorify &etavern&r."
		""
		"These roadside inns stand in plains and forests, with rooms full of chests."
	]
	quest.3183469C7DF0218C.title: "Last Orders"
	quest.319CC232D830E4D9.quest_desc: [
		"Kill two &ePhantoms&r with a single arrow from a &eCrossbow&r enchanted with &ePiercing&r."
		""
		"Let them line up as they dive at you."
	]
	quest.319CC232D830E4D9.title: "One Arrow, Two Phantoms"
	quest.31AE0112E50A4CCF.quest_desc: [
		"Coast, desert, snow, jungle, swamp and caves: you have caught Pokémon in all of them."
		""
		"Claim a Type Gem pouch of your choice. This unlocks once the six habitat quests are done."
	]
	quest.31AE0112E50A4CCF.title: "All-Terrain Trainer"
	quest.31B630C0DFC1286E.quest_desc: [
		"&6Price:&r &e9,000 CobbleDollars&r for 10."
		""
		"Restores 60 HP of a Pokémon"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.31B630C0DFC1286E.quest_subtitle: "9,000 CD"
	quest.31B630C0DFC1286E.title: "Super Potion x10"
	quest.31BACBD1F02DD264.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Changes a Pokémon's stats to be that of a Quiet nature"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.31BACBD1F02DD264.quest_subtitle: "5,000 CD"
	quest.31BACBD1F02DD264.title: "Quiet Mint"
	quest.31D30AD0FC0EDB96.quest_desc: [
		"Diamonds sit deep underground and get more common the lower you dig. You need an iron pickaxe."
		""
		"&aPokémon tip:&r Carbink spawn next to diamond ore in dark caves."
	]
	quest.31D30AD0FC0EDB96.title: "Shine Bright"
	quest.31D704D34D7AA310.quest_desc: [
		"Explore the &6Badlands&r."
		""
		"Dwebble and Crustle scuttle across the terracotta, and herds of Mudsdale roam the mesas."
	]
	quest.31D704D34D7AA310.title: "Bad to the Bone"
	quest.31D79ACEFD4CD45E.quest_desc: [
		"Craft a &eMaster Candy&r (Cobblemon Utility+): a Rare Candy surrounded by four Paper and four &eNether Stars&r. It sets a Pokémon's level straight to 100."
		""
		"&cFour Nether Stars means four Withers. Save it for a Pokémon you really care about.&r"
	]
	quest.31D79ACEFD4CD45E.title: "Instant Champion"
	quest.31F064E850D19B43.quest_desc: [
		"&6Price:&r &e6,000 CobbleDollars&r for one."
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.31F064E850D19B43.quest_subtitle: "6,000 CD"
	quest.31F064E850D19B43.title: "Red Card"
	quest.31F4854E53034DB8.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Resets all of the Pokémon's EVs to 0"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.31F4854E53034DB8.quest_subtitle: "5,000 CD"
	quest.31F4854E53034DB8.title: "Fresh-Start Mochi"
	quest.31F9DEBF306E1CCB.quest_desc: [
		"Reach the &6Mantle Caves&r deep underground."
		""
		"Zweilous and Hydreigon are rare hunters in the dark, and Turtonator is an uncommon sight."
		"&oHeatran and Groudon are ultra-rare here.&r"
	]
	quest.31F9DEBF306E1CCB.title: "Close to the Core"
	quest.3208ACE087642B66.quest_desc: ["&eTamato Berry&r + Hearty Grains + Honey. Raises &eSpeed&r EVs by 4 per Mochi."]
	quest.3208ACE087642B66.title: "Swift Mochi"
	quest.32116D76DDA88287.quest_desc: [
		"Skip sleep for three nights or more and &ePhantoms&r swoop down from the night sky."
		""
		"Kill 5. Their &ePhantom Membranes&r repair Elytra and go into Cobblemon's &eAir Balloon&r, &eCovert Cloak&r and &eReaper Cloth&r."
	]
	quest.32116D76DDA88287.title: "Sleep Is for the Weak"
	quest.3216FF6EAA48312E.quest_desc: [
		"Five &eCopper Ingots&r around a &eLumisene Bottle&r make a &eFire Pit&r, a copper brazier for your camp or great hall."
		""
		"Light it up and gather your team (and your Pokémon) around the fire."
	]
	quest.3216FF6EAA48312E.title: "Campfire Stories"
	quest.321B2DD890C95C4E.quest_desc: [
		"&6Price:&r &e1,500 CobbleDollars&r for one."
		""
		"Temporarily raises the target's Attack stat by one stage when used in battle"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.321B2DD890C95C4E.quest_subtitle: "1,500 CD"
	quest.321B2DD890C95C4E.title: "X Attack"
	quest.321CB99B9B22BAA1.quest_desc: [
		"&eFurnace&r, &eIron&r and &eRedstone&r around an &eUpgrade Base&r."
		""
		"A furnace in an upgrade tab. Only &eone&r furnace-type upgrade fits in a backpack at a time."
	]
	quest.321CB99B9B22BAA1.title: "Smelting Upgrade"
	quest.3239DF36493F0D67.quest_desc: [
		"Brew a &ePep-Up Flower&r into an Ether or an Elixir for a &eMax Ether&r or &eMax Elixir&r: all PP back."
		""
		"Pep-Up Flowers drop from fully grown Revival Herbs. Brewing Stand only."
	]
	quest.3239DF36493F0D67.title: "Bottomless Moveset"
	quest.32648B5C872DF280.quest_desc: [
		"Craft a &eSuitcase Workstation&r (an Iron Ingot, a Gold Ingot and 4 Black Wool). A jobless villager who claims it becomes an &eEntrepreneur&r; desert &bOutskirt Stands&r already have one."
		""
		"Entrepreneurs sell key items for Emeralds plus Relic Coins: the Poké Treat Box and Dream Catcher (Apprentice), the four Seals (Journeyman), Light and Dark Stone Shards (Expert), the Celestica Flute and Silver Wing (Master)."
	]
	quest.32648B5C872DF280.title: "Open for Business"
	quest.32675608BBDD6FF6.quest_desc: [
		"&6Price:&r &e7,500 CobbleDollars&r for 10."
		""
		"1.5× catch rate"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.32675608BBDD6FF6.quest_subtitle: "7,500 CD"
	quest.32675608BBDD6FF6.title: "Great Ball x10"
	quest.326CE5A37EE96E7A.quest_desc: [
		"&6Pokémon&r"
		"&eR&r sends out or calls back your selected Pokémon; aim at a wild one to start a battle."
		"&eUp&r / &eDown&r pick a party slot, &eO&r hides the party bar, &eC&r opens the summary."
		"&eJ&r opens the battle log, &e,&r toggles the catch-rate display, &eG&r compares Poké Balls."
		"{@pagebreak}"
		"&6World and Inventory&r"
		"&eM&r opens the world map, &eF6&r minimap settings, &eU&r waypoints, &eInsert&r a new waypoint."
		"&eB&r opens your backpack, &eI&r a storage terminal, &eH&r accessories; &eT&r shows the trash slot in your inventory."
		"Hold &e`&r while mining to break connected blocks with FTB Ultimine. The numpad drives the Jade info overlay, and &eV&r opens the voice chat menu."
		""
		"&aEvery key can be changed in Options, Controls.&r"
	]
	quest.326CE5A37EE96E7A.title: "Controls Cheat Sheet"
	quest.326FB9EC65F8F472.quest_desc: [
		"A &eSmelting Upgrade&r with &e5 Iron Ingots&r and &e3 Smooth Stone&r (or build one from a Blast Furnace)."
		""
		"Blasts ores and metal gear in an upgrade tab."
	]
	quest.326FB9EC65F8F472.title: "Blasting Upgrade"
	quest.328505CF60F9B7E0.quest_desc: [
		"Five iron ingots, a furnace and three smooth stone make a &eBlast Furnace&r."
		""
		"It smelts ores twice as fast as a furnace, Cobblemon's evolution stone ores included."
	]
	quest.328505CF60F9B7E0.title: "Turn Up the Heat"
	quest.328A64A184B0C674.quest_desc: ["Craft a &eFocus Sash&r: two Leather, a Copper Ingot and two Blaze Powder. It keeps the holder from fainting to a single hit."]
	quest.328A64A184B0C674.title: "Hang On!"
	quest.328B73FF0EF39763.quest_desc: [
		"Craft a &eRed Orb&r from two Redstone, a Ground Gem, five Blocks of Redstone and a Fire Stone, or find one in a Legendary Monuments shrine."
		""
		"Held by Groudon, it triggers Primal Reversion. Groudon itself is in the Legends and Myths chapter."
	]
	quest.328B73FF0EF39763.title: "Primal Heat"
	quest.3292B531D41C25F4.quest_desc: [
		"Surround the previous Heal Upgrade with &e4 Blocks of Netherite&r."
		""
		"Cuts the recharge time by &e80%&r: about &e30 seconds&r between heals."
	]
	quest.3292B531D41C25F4.title: "Heal Upgrade Tier 4"
	quest.32B09D2C5C106B66.quest_desc: [
		"Some Pokémon change form with special items instead of battle gimmicks."
		""
		"Below are a few highlights. REI lists every form item Mega Showdown adds: Plates, Memories, Drives, Nectars, Orbs and more."
	]
	quest.32B09D2C5C106B66.title: "Shape Shifters"
	quest.32B722F4E1C62A0B.quest_desc: [
		"&6Price:&r &e400 CobbleDollars&r for one."
		""
		"1× catch rate"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.32B722F4E1C62A0B.quest_subtitle: "400 CD"
	quest.32B722F4E1C62A0B.title: "Ancient Slate Ball"
	quest.32B97A2BE8CB73AF.quest_desc: [
		"Win a &eSquirtle Pokédoll&r (the normal one) from the Plush-O-Matic with Soggy Yarn."
		""
		"Odds: about 1 pull in 20, and every pull costs Yarn, so stock up on Type Gems first."
	]
	quest.32B97A2BE8CB73AF.title: "Plush Squirtle"
	quest.32C6CC74EAC8C72E.quest_desc: [
		"Discover a &eSpider Cave&r."
		""
		"Bring Shears: the cobwebs here are exactly what an Explorer's Compass needs."
	]
	quest.32C6CC74EAC8C72E.title: "Cobweb Entanglement"
	quest.32D24B74507EA7F9.quest_desc: [
		"After your first win over Boss Giovanni, a second &eGiovanni&r wanders the badlands, savannas and the Nether with an old-school Ground team: Rhyhorn, Dugtrio, Nidoqueen and Nidoking."
		""
		"Beating him is optional."
	]
	quest.32D24B74507EA7F9.quest_subtitle: "Giovanni"
	quest.32D24B74507EA7F9.title: "A Facade?"
	quest.330023EC13E0A41F.quest_desc: [
		"Catch a wild Pokémon of level &e50&r or higher."
		""
		"High-level wild Pokémon hit hard. Bring a strong team, heal between fights, and pack Ultra Balls."
	]
	quest.330023EC13E0A41F.title: "Big Game Hunter"
	quest.330458F2E0ED7204.quest_desc: [
		"A &eWaystone&r plus 3 &eVines&r (or 3 &eMoss Blocks&r) becomes a &eMossy Waystone&r."
		""
		"Other styles (Sandy, Deepslate, Black, Ender, Nether, Prismarine, Purpur, Muddy) swap the Stone Bricks for their own block around a Warp Stone."
	]
	quest.330458F2E0ED7204.title: "Mossy Makeover"
	quest.33086F0A98A1D86C.quest_desc: [
		"&6Price:&r &e400 CobbleDollars&r for one."
		""
		"1× catch rate"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.33086F0A98A1D86C.quest_subtitle: "400 CD"
	quest.33086F0A98A1D86C.title: "Ancient Roseate Ball"
	quest.3347A60D6F9088EE.quest_desc: [
		"&eBeldum&r is a rare spawn on the End islands. Catch one while you are in the End."
		""
		"Raise it and it becomes &eMetang&r and then the mighty &eMetagross&r."
	]
	quest.3347A60D6F9088EE.title: "Metal From the Sky"
	quest.335639BE6BAA3820.quest_desc: ["The &bGrasswither Shrine&r hides in crimson and warped forests. With the power of 8 matching stakes it releases &dWo-Chien&r."]
	quest.335639BE6BAA3820.title: "Rot of Ruin"
	quest.33666ADA4D9D5DC8.quest_desc: ["Craft a &eMason Table&r from 3 Brick items, 2 Iron Ingots, 3 Logs and a Crafting Table."]
	quest.33666ADA4D9D5DC8.title: "Mason Table"
	quest.3385ED7FE2721E81.quest_desc: [
		"&6Price:&r &e1,000 CobbleDollars&r for one."
		""
		"4× on Pokémon with 100 or more Base Speed"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.3385ED7FE2721E81.quest_subtitle: "1,000 CD"
	quest.3385ED7FE2721E81.title: "Fast Ball"
	quest.33A846604733D7D7.quest_desc: [
		"Craft &eTipped Arrows&r: one Lingering Potion in the middle of 8 Arrows."
		""
		"Each arrow carries the potion's effect. &eFletcher&r villagers trade them too."
	]
	quest.33A846604733D7D7.title: "Point Taken"
	quest.33E9F0561C043FDA.quest_desc: ["You have stood in all five Nether biomes. Every Fire, Ghost and Dark Pokémon the Nether hides is now within reach."]
	quest.33E9F0561C043FDA.title: "Hot Spot Tourist"
	quest.33F2E47D84164C77.quest_desc: [
		"&6Price:&r &e10,000 CobbleDollars&r for one."
		""
		"Grants 8 Sp. Def EVs when gaining experience in battle"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.33F2E47D84164C77.quest_subtitle: "10,000 CD"
	quest.33F2E47D84164C77.title: "Power Band"
	quest.34148B1AA0D2AFD2.quest_desc: [
		"Pick up an &eOminous Bottle&r."
		""
		"Drinking it gives &cBad Omen&r. Walk into a village with it and it becomes a Raid Omen; a raid starts there soon after."
		"&aInside Trial Chambers the same omen makes the trial spawners ominous instead.&r"
	]
	quest.34148B1AA0D2AFD2.title: "A Bad Omen"
	quest.341B79473D665492.quest_desc: [
		"Find a &eLeaf Stone Ore&r: it generates under forests, jungles and lush biomes, more rarely under swamps and tropical islands."
		"Look at the regular stone variant, found above the deepslate layer."
		""
		"&aPokémon tip:&r this stone evolves Pokémon such as Gloom, Exeggcute and Eevee."
	]
	quest.341B79473D665492.title: "Leaf Stone Ore"
	quest.343412D45FB6108C.quest_desc: [
		"Kill 10 &eZombies&r."
		""
		"Zombies shamble out at night and burn at dawn. They drop Rotten Flesh, and now and then an &eIron Ingot&r, a Carrot or a Potato."
	]
	quest.343412D45FB6108C.title: "Braaains"
	quest.34407163D7BFE677.quest_desc: [
		"Pull a &eCherish Capsule&r from a Poké Gacha Machine."
		""
		"The jackpot. Cherish Capsules hold Rare Candy, vitamins, PP Max, Cherish Balls and even a Master Ball."
	]
	quest.34407163D7BFE677.title: "Jackpot"
	quest.3448F2684180773E.quest_desc: [
		"To bait a rod, hold the bait on your cursor in the inventory and right-click the &ePoké Rod&r with it. Any Berry works, and each does something:"
		"&eOran&r, &eGlow Berries&r: faster bites. &eLeppa&r: +5 levels."
		"&eOcca&r, &ePassho&r, &eWacan&r: more Fire, Water or Electric types."
		"&eHopo&r: a small Alpha chance. &eStarf&r, &eGolden Apple&r: better shiny odds."
	]
	quest.3448F2684180773E.title: "Bait Science"
	quest.344E37E8D4F90788.quest_desc: [
		"Already have vanilla Furnaces placed and full? Craft a &eStone to Iron Furnace Upgrade&r (&e8 Iron Ingots&r around &eCobblestone&r), then &esneak and right-click&r a placed Furnace with it."
		""
		"There is a kit for every step of the ladder. Each one copies the recipe of the furnace it creates, but with a material in the centre instead of the old furnace."
	]
	quest.344E37E8D4F90788.title: "Upgrade in Place"
	quest.346521B2B8C1C0EE.quest_desc: [
		"&6Price:&r &e15,000 CobbleDollars&r for one."
		""
		"Raises the holder's Sp. Def but prevents the use of status moves"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.346521B2B8C1C0EE.quest_subtitle: "15,000 CD"
	quest.346521B2B8C1C0EE.title: "Assault Vest"
	quest.3474FB907B5CF586.quest_desc: [
		"Look at a &eTrial Spawner&r."
		""
		"It wakes when players come close and sends out a set number of mobs, more for bigger groups. Beat them all and it hands out rewards, then rests for a while."
	]
	quest.3474FB907B5CF586.title: "Trial by Combat"
	quest.34A9783E0D853C85.quest_desc: [
		"&eSugar&r, &ePaper&r and a &eHoney Bottle&r make 8 &eCandy&r."
		""
		"A quick sweet snack for the road. Just do not overdo it."
	]
	quest.34A9783E0D853C85.title: "Sweet Tooth"
	quest.34C2426978DEE1AC.quest_desc: ["Give Onix or Scyther a Metal Coat to hold, then trade it or use a Link Cable on it."]
	quest.34C2426978DEE1AC.title: "Heavy Metal"
	quest.34C92F900C6789CE.quest_desc: [
		"Some fully evolved Pokémon can go one step further: &6Mega Evolution&r, a temporary battle form with boosted power."
		""
		"You need two things: a &eKey Stone&r accessory for yourself and the right &eMega Stone&r for your Pokémon to hold."
		""
		"This chapter takes you from meteorites buried deep underground to your first Mega."
	]
	quest.34C92F900C6789CE.quest_subtitle: "Mega Showdown"
	quest.34C92F900C6789CE.title: "&6Beyond Evolution"
	quest.34CD97405F8537B2.quest_desc: [
		"A &eHealing Machine&r and &e7 Blocks of Copper&r around an &eUpgrade Base&r."
		""
		"Heals your whole party from the backpack, anywhere. It then needs &e150 seconds&r to recharge."
	]
	quest.34CD97405F8537B2.title: "Heal Upgrade"
	quest.34DA890DBA0F619A.quest_desc: [
		"&6Price:&r &e6,000 CobbleDollars&r for one."
		""
		"Evolves Electabuzz into Electivire when held while trading"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.34DA890DBA0F619A.quest_subtitle: "6,000 CD"
	quest.34DA890DBA0F619A.title: "Electirizer"
	quest.34DAE1323661B6FB.quest_desc: [
		"&6Price:&r &e6,000 CobbleDollars&r for one."
		""
		"Grants the holder immunity to powder and spore moves and damage from weather"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.34DAE1323661B6FB.quest_subtitle: "6,000 CD"
	quest.34DAE1323661B6FB.title: "Safety Goggles"
	quest.34F2493D32622B1A.quest_desc: [
		"Use an empty Bucket on a cow (or a goat) for a &eMilk Bucket&r."
		""
		"&aPokémon tie-in:&r a Bucket works on &eMiltank&r too, and a Glass Bottle on Miltank gives &eMoomoo Milk&r."
	]
	quest.34F2493D32622B1A.title: "Got Milk?"
	quest.34FCA5F12B844E62.quest_desc: [
		"Craft all fifteen Ancient Balls. Beyond the seven basic colors:"
		"&eGreat&r (Iron, 1.5x) and &eUltra&r (Gold, 2x)."
		"&eFeather&r, &eWing&r, &eJet&r: Blue and White Apricorns with &eSky Tumblestones&r; fly further (1x, 1.5x, 2x)."
		"&eHeavy&r, &eLeaden&r, &eGigaton&r: Black Apricorns with &eBlack Tumblestones&r; throw shorter (1x, 1.5x, 2x)."
		"Copper, Iron and Gold cores set each trio's tier. Sky and Black Tumblestones turn up in ruins like the regular kind."
	]
	quest.34FCA5F12B844E62.title: "A True Antiquarian"
	quest.34FE69EF64B02C00.quest_desc: [
		"Mega Showdown adds three more battle gimmicks: &eZ-Moves&r, &eTerastallization&r and &eDynamax&r."
		""
		"Each needs its own accessory, worn in its own slot of the accessories screen (&eH&r): the Z Slot, Tera Wear and the Dynamax Slot."
		""
		"Pick a lane, or master all three and forge the Omni Ring at the end."
	]
	quest.34FE69EF64B02C00.quest_subtitle: "Mega Showdown"
	quest.34FE69EF64B02C00.title: "&6More Than Mega"
	quest.3509132823221565.quest_desc: [
		"Take a &eBell&r from a village square (it drops when mined) or find one in a ruined portal chest."
		""
		"Ringing a bell makes every raider within 48 blocks glow for a moment, so none can hide during a raid."
	]
	quest.3509132823221565.title: "Sound the Alarm"
	quest.35179DE1B0219211.quest_desc: [
		"Craft an &eArchaeological Compass&r: a Compass ringed by four Iron Ingots, two Amethyst Shards and two Gold Ingots."
		""
		"Right-click it in the Overworld to track the nearest &6Archaeological Site&r."
	]
	quest.35179DE1B0219211.title: "Dig Site Detector"
	quest.351B39EC2591C82C.quest_desc: [
		"Each circle to the right is the first quest of a chapter, one row per chapter group: &cPokémon Journey&r (Poké Ball), &6Battle Frontier&r (Choice Band), &aTrainer Life&r (Oran Berry), &eMinecraft&r (pickaxe), &dExploration&r (compass) and &9Storage and Utility&r (bundle). Hover or click one to read that chapter's opening quest."
		""
		"New to Cobblemon? Start with &cBecoming a Trainer&r. New to Minecraft? Try &eFirst Days&r. The rest can be done in any order."
		""
		"&6Champion of Origins&r, the large circle at the bottom, is the final goal: finish every chapter to claim the title."
	]
	quest.351B39EC2591C82C.quest_subtitle: "Pick a path"
	quest.351B39EC2591C82C.title: "Where to Next?"
	quest.351D6F927E74D6A1.quest_desc: [
		"Road signs stand here and there across the Overworld, pointing toward the nearest village with the distance written on them."
		""
		"Find one and walk up to it. Follow it and you will reach Cobble Merchants and villagers to trade with."
	]
	quest.351D6F927E74D6A1.title: "This Must Be a Sign!"
	quest.3524AA193140551D.quest_desc: ["Mega Evolve a &eLucario&r holding its Lucarionite."]
	quest.3524AA193140551D.title: "Aura Overdrive"
	quest.3535053D1AE73A17.quest_desc: [
		"Stone brick slabs around &eStone Bricks&r make a &ePedestal&r."
		""
		"Set an item on top and it slowly spins on display. Swords, tridents and End Crystals get a special pose."
	]
	quest.3535053D1AE73A17.title: "Trophy Case"
	quest.3539F24064EA859F.quest_desc: [
		"&6Price:&r &e10,000 CobbleDollars&r for one."
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.3539F24064EA859F.quest_subtitle: "10,000 CD"
	quest.3539F24064EA859F.title: "PP Max"
	quest.3542F9A751EC2158.quest_desc: ["Find a &eWild&r armor trim template in a jungle temple chest."]
	quest.3542F9A751EC2158.title: "Wild Trim"
	quest.3548F27BDF9011EB.quest_desc: [
		"&eChipped&r adds seven workbenches. Put an ordinary block in one and pick from up to dozens of decorative variants of it."
		""
		"Look a workbench up in the recipe viewer (REI) to see which blocks it reshapes."
		""
		"Each bench except the Glassblower also has a handheld tool that opens the same menu anywhere."
	]
	quest.3548F27BDF9011EB.title: "Chipped Workbenches"
	quest.355C16B9D3A8EC36.quest_desc: [
		"Surround a Netherite Ingot with eight &eChiseled Stone Bricks&r to craft a &eLodestone&r."
		""
		"Use a Compass on it and the compass points to that Lodestone from anywhere in the same dimension. Perfect for finding your portal home."
	]
	quest.355C16B9D3A8EC36.title: "True North"
	quest.3568DFAE12E47255.quest_desc: [
		"&6The Nether&r is a scorching dimension packed with things the Overworld lacks: &eBlaze Rods&r, &eQuartz&r, &eGlowstone&r and the &eAncient Debris&r that becomes Netherite."
		""
		"Build an &eObsidian&r frame (4 wide, 5 tall, the corners can be left out), light it with &eFlint and Steel&r and step through."
		""
		"&aTip:&r the Golden Helmet reward is not just for looks. Piglins leave you alone while you wear a piece of gold armor."
	]
	quest.3568DFAE12E47255.title: "&cThrough the Portal"
	quest.357718E67F9913FE.quest_desc: [
		"&6Price:&r &e700 CobbleDollars&r for one."
		""
		"Restores 80 HP of a Pokémon whilst reducing friendship"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.357718E67F9913FE.quest_subtitle: "700 CD"
	quest.357718E67F9913FE.title: "Energy Root"
	quest.3594ABAA0C25953F.quest_desc: [
		"&6Price:&r &e6,000 CobbleDollars&r for one."
		""
		"Evolves Rhydon into Rhyperior when held while trading"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.3594ABAA0C25953F.quest_subtitle: "6,000 CD"
	quest.3594ABAA0C25953F.title: "Protector"
	quest.35B3AB3D25955BB2.quest_desc: [
		"Stand on lava while sneaking, and hot floors like Magma Blocks stop hurting."
		""
		"&6Where to look:&r Ruined Portals, brushing warm Ocean Ruins; rarely worn by piglin brutes."
	]
	quest.35B3AB3D25955BB2.title: "Strider Shoes"
	quest.35C26DB2FAE88433.quest_desc: [
		"Make every Medicinal Brew product: all Potions, the Full Restore, Ethers and Elixirs, PP Up, PP Max, the six vitamins and an &eAbility Capsule&r."
		""
		"The capsule brews &eDragon's Breath&r into Medicinal Brew. Bottle it from the Ender Dragon's breath, or win it from Dratini and Deino and their evolutions."
	]
	quest.35C26DB2FAE88433.title: "Double, Double, Brew Some Trouble"
	quest.35C65A7725645DC5.quest_desc: ["Start with &ePewter Crunchies&r: 2 &eHearty Grains&r, a &eHoney Bottle&r and &ePumpkin Seeds&r."]
	quest.35C65A7725645DC5.title: "A Taste of Pewter"
	quest.35F2336FA2CE47BD.quest_desc: [
		"Craft a &eWarp Plate&r: 4 &eStone Bricks&r, 4 &eWarp Dust&r and a &eDormant Shard&r."
		""
		"On its own a plate goes nowhere. It needs a partner."
	]
	quest.35F2336FA2CE47BD.title: "Step On, Step Off"
	quest.35FC01F3D227B67C.quest_desc: [
		"Chop a tree with your kit's &eIron Axe&r. Logs turn into planks and planks into sticks, all in the 2x2 grid of your inventory."
		""
		"Sticks go into torches, campfires and every tool handle."
	]
	quest.35FC01F3D227B67C.title: "Timber!"
	quest.35FD9A057ACCE297.quest_desc: [
		"&eSerene Seasons&r is installed: the Overworld cycles through Spring, Summer, Autumn and Winter."
		""
		"Eight Paper around a &eClock&r make a &eCalendar&r that shows the season and day. Each season lasts 24 in-game days."
	]
	quest.35FD9A057ACCE297.title: "Mark the Calendar"
	quest.36197076E0957B68.quest_desc: [
		"&eTier 3&r with &e8 Blocks of Netherite&r."
		""
		"Every slot holds &e16x&r as many stacks. Nine of these make the Omega tier, which removes the stack limit entirely, if you have the Netherite to spare."
	]
	quest.36197076E0957B68.title: "Stack Upgrade Tier 4"
	quest.3619A1129F0274E4.quest_desc: [
		"Reel in a &eLotad&r. Lotad and its evolutions only bite in forests, jungles and swamps &ewhile it rains&r."
		""
		"Here is a Water Stone for when your Lombre is ready."
	]
	quest.3619A1129F0274E4.title: "Rainy Day Angler"
	quest.362221825801AC35.quest_desc: [
		"Follow the on-screen prompt to open the &eStarter Selection&r and pick your first Pokémon."
		""
		"Choosing a starter also hands you the &eCobblepedia&r, an in-game guide book to Cobblemon."
		""
		"&aAlready picked one? This completes on its own.&r"
	]
	quest.362221825801AC35.title: "Choose Your Partner"
	quest.362FF27DF04AD0D7.quest_desc: [
		"Temperate forests, plains and flower fields are where most journeys begin, and the gentlest place to start a tour."
		""
		"Expect plenty of &eGrass&r-, &eBug&r- and &eFairy&r-types, and a few legends that only show up among the flowers."
		"&aTip:&r some birds, like Natu, spawn on top of trees, so look up."
	]
	quest.362FF27DF04AD0D7.title: "Forests and Fields"
	quest.367B1E25ABA778A7.quest_desc: [
		"&6Price:&r &e15,000 CobbleDollars&r for one."
		""
		"Evolves Kubfu into Rapid Strike Style Urshifu"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.367B1E25ABA778A7.quest_subtitle: "15,000 CD"
	quest.367B1E25ABA778A7.title: "Scroll of Waters"
	quest.367DB202943199AF.quest_desc: [
		"Find an Explorify &emangrove hut&r."
		""
		"A witch and her cat live in this hut in the Mangrove Swamp."
	]
	quest.367DB202943199AF.title: "Swamp Shack"
	quest.367F4D33E0979C8D.quest_desc: [
		"Walk under the pink canopy of a &6Cherry Grove&r."
		""
		"Look up: Natu and Xatu perch in the treetops here."
		"&oThe ultra-rare Meloetta sings here under the open sky.&r"
	]
	quest.367F4D33E0979C8D.title: "Blossom Season"
	quest.36946C6B52EA1A47.quest_desc: ["Level up a Mantyke while a Remoraid is in your party, or raise Pancham to level 32 with a Dark-type Pokémon in your party."]
	quest.36946C6B52EA1A47.title: "Strength in Numbers"
	quest.36A1E79CE23B87F0.quest_desc: [
		"Combine an Ender Pearl with &eBlaze Powder&r to craft an &eEye of Ender&r."
		""
		"Throw one and it flies toward the nearest Stronghold before dropping back down, though now and then it shatters. A portal needs up to 12 eyes, so bring spares."
	]
	quest.36A1E79CE23B87F0.title: "Eye of Ender"
	quest.36D15A89B065B3DB.quest_desc: [
		"Brush both kinds of Lootr &esuspicious blocks&r (sand and gravel) and loot a Lootr decorated pot."
		""
		"Archaeology sites are per-player too, so you never find a dig site already emptied."
	]
	quest.36D15A89B065B3DB.title: "Ninety Percent Dust"
	quest.36E6FD2A255E7012.quest_desc: [
		"Once May is beaten, &eRival Terry&r sometimes shows up with a completely different team: Heracross, Alakazam, Tyranitar, Arcanine, Exeggutor and Blastoise."
		""
		"Find him on the plains or near End Cities. Optional."
	]
	quest.36E6FD2A255E7012.quest_subtitle: "Rival Terry, alternative team"
	quest.36E6FD2A255E7012.title: "Who's Got the Edge?"
	quest.3700C7F3BDB7C9D3.quest_desc: [
		"Catch a Pokémon that is both &5Ghost&r and &8Dark&r."
		""
		"Immune to Normal, Fighting and Psychic, and weak only to Fairy."
	]
	quest.3700C7F3BDB7C9D3.title: "Shadow Play"
	quest.37485F5B8AE719F3.quest_desc: [
		"Three &eDeepslate&r and three &eAmethyst Shards&r make two &eCrystal Displays&r."
		""
		"A display shows the strength of the redstone signal it receives as a number. Put two side by side and they chain together to show bigger values."
		""
		"&aTip:&r Clock Blocks and Hourglasses only talk to Comparators. Read them with a &eComparator&r feeding into the display; placed right next to them, a display shows nothing."
	]
	quest.37485F5B8AE719F3.title: "Read the Signal"
	quest.375D5FC353898D09.quest_desc: [
		"Craft the &eMace&r: the Heavy Core on top of a Breeze Rod."
		""
		"Its hit grows with the distance you fall before it lands. Pair it with Wind Charges for huge smashes."
		"&aRepair it with Breeze Rods.&r"
	]
	quest.375D5FC353898D09.title: "The Mace"
	quest.37641DC601FF4661.quest_desc: [
		"Defeat an &cEvoker&r. Evokers spawn around this pack's pillager outposts and join the later waves of a raid."
		""
		"They summon biting fangs and flying Vexes, so close the gap fast."
	]
	quest.37641DC601FF4661.title: "Fang Fighter"
	quest.3768E4349F337E8E.quest_desc: [
		"Each evolution stone has its own ore in the stone and deepslate layers of matching biomes."
		""
		"Mining the ore drops the stone itself, and Fortune gives more. With Silk Touch you get the ore block, which smelts into the stone."
		"Nine stones craft a storage block. The &eInto the Depths&r chapter covers ores in general."
	]
	quest.3768E4349F337E8E.title: "Stones in the Rock"
	quest.37834157B9976912.quest_desc: [
		"&6Price:&r &e1,200 CobbleDollars&r for one."
		""
		"5× on the first turn of battle"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.37834157B9976912.quest_subtitle: "1,200 CD"
	quest.37834157B9976912.title: "Quick Ball"
	quest.37A0FFAAEC2BD39C.quest_desc: ["&eGrepa Berry&r + Hearty Grains + Honey. Raises &eSp. Def&r EVs by 4 per Mochi."]
	quest.37A0FFAAEC2BD39C.title: "Clever Mochi"
	quest.37D953D78D905CC9.quest_desc: [
		"&e8 Gold Ingots&r around an &eIron Chest&r."
		""
		"&e81 slots&r and &e3 upgrade slots&r."
	]
	quest.37D953D78D905CC9.title: "Gold Chest"
	quest.37E6F30C4B46EF53.quest_desc: [
		"Craft a &eCampfire&r from sticks, coal or charcoal and three logs. It cooks food slowly: 30 seconds a piece, against 10 in a furnace."
		""
		"&aPokémon tip:&r Cobblemon's &eCampfire Pot&r goes on top of a lit campfire to cook Poké Snacks and Poké Bait (Cooking and Medicine chapter)."
	]
	quest.37E6F30C4B46EF53.title: "Campfire Stories"
	quest.37EACB8BD615E444.quest_desc: [
		"Find a &eSol Henge&r, a stone circle in the taiga."
		""
		"Solrock gather here by day when the weather is clear."
	]
	quest.37EACB8BD615E444.title: "Sun Circle"
	quest.380A3B1D43004157.quest_desc: [
		"Craft a &eGreat Ball&r: 2 &eRed&r and 2 &eBlue Apricorns&r around an &eIron Ingot&r."
		""
		"1.5x catch rate, a solid upgrade for everyday catching."
	]
	quest.380A3B1D43004157.title: "Better Odds"
	quest.382F8E4FA0D2EBBC.quest_desc: [
		"&6Price:&r &e4,000 CobbleDollars&r for one."
		""
		"Grounds the holder, and halves their speed"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.382F8E4FA0D2EBBC.quest_subtitle: "4,000 CD"
	quest.382F8E4FA0D2EBBC.title: "Iron Ball"
	quest.3835FD6CF0E4B9BF.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Raises the Pokémon's Sp. Atk EVs by 10"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.3835FD6CF0E4B9BF.quest_subtitle: "5,000 CD"
	quest.3835FD6CF0E4B9BF.title: "Calcium"
	quest.383E2B5A73199C75.quest_desc: [
		"&eSmithing Table&r, &eIron&r and a &eChest&r around an &eUpgrade Base&r."
		""
		"A smithing table in an upgrade tab: trims and Netherite upgrades away from home."
	]
	quest.383E2B5A73199C75.title: "Smithing Upgrade"
	quest.3846BDD4D0B8CA76.quest_desc: [
		"&6Price:&r &e600 CobbleDollars&r for one."
		""
		"Restores 1/4 max HP when at 1/2 max HP or less"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.3846BDD4D0B8CA76.quest_subtitle: "600 CD"
	quest.3846BDD4D0B8CA76.title: "Sitrus Berry"
	quest.385C266B6F28BC88.quest_desc: [
		"&eHearty Grains&r grow in shallow water at sea level in plains and swamps. Grows in Summer and Autumn."
		""
		"Nine make a Hearty Grain Bale, four make Tatami, and three go into every &ePoké Snack&r."
	]
	quest.385C266B6F28BC88.title: "Hearty Grains"
	quest.385CC9077F2BC67B.quest_desc: [
		"Stand on the &6Frozen Cliffs&r."
		""
		"Cubchoo and Beartic roam here, especially while it snows. Seel and Spheal lounge along the icy shore."
	]
	quest.385CC9077F2BC67B.title: "Cold Shoulder"
	quest.3863C66FAB8B4101.quest_desc: ["Craft a &eCosmic Catalyst&r: 4 Obsidian, a Psychic Gem, 2 Amethyst Shards, a Star Sweet and an Ultra Ball."]
	quest.3863C66FAB8B4101.title: "Stardust Collector"
	quest.389AB265956A5DE6.quest_desc: [
		"A &eWater Bucket&r, four &eAsh&r and a &eRaw Porkchop&r boil down into &eSoap&r."
		""
		"Right-click dyed blocks with it to wash the color out, or use it to scrub a Sepia Globe clean."
	]
	quest.389AB265956A5DE6.title: "Squeaky Clean"
	quest.38B469583B5865D8.quest_desc: [
		"&6Price:&r &e400 CobbleDollars&r for one."
		""
		"Cures a Pokémon from poison"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.38B469583B5865D8.quest_subtitle: "400 CD"
	quest.38B469583B5865D8.title: "Antidote"
	quest.38BA5B60399304F6.quest_desc: [
		"Four &eCopper Ingots&r around &eRedstone&r. Use the &eAltimeter&r to read your exact height (Y level), handy when you dig for ores at the right depth."
		""
		"Combine it with a &eMap&r for a &eSlice Map&r that charts only the layer at your height."
	]
	quest.38BA5B60399304F6.title: "How Deep?"
	quest.38DDE2F4915F40FF.quest_desc: [
		"Three Sticks and two String make a &eFishing Rod&r. Cast into any water and reel in when the bobber dips."
		""
		"This is plain fish. Fishing for Pokémon with a &ePoké Rod&r has its own chapter."
	]
	quest.38DDE2F4915F40FF.title: "Gone Fishing"
	quest.38E37583D4403DA2.quest_desc: [
		"Four &eCopper Ingots&r make a &eWrench&r. Right-click a placed block to rotate it."
		""
		"Fix that one stair facing the wrong way without breaking it."
	]
	quest.38E37583D4403DA2.title: "Righty Tighty"
	quest.38F185EFBB66EDDE.quest_desc: [
		"&eArtifacts&r cannot be crafted. They hide in structure chests, turn up in 1 of 16 brushings at Desert Wells, Trail Ruins and Ocean Ruins, and are very rarely worn by zombies, skeletons and piglins."
		""
		"Press &eH&r and drop them into your accessory slots. Each one below says where to look."
	]
	quest.38F185EFBB66EDDE.title: "Amateur Archaeologist"
	quest.38FB1A6819966B37.quest_desc: ["Use a &eFire Stone&r on Eevee."]
	quest.38FB1A6819966B37.title: "Flareon"
	quest.38FC958E83B7DD4B.quest_desc: [
		"A &eSmelting Upgrade&r with &eDiamonds&r, &eGold&r, &eHoppers&r and &eRedstone&r."
		""
		"Automatically pulls what it should smelt (and fuel) from the backpack and pushes the results back in."
	]
	quest.38FC958E83B7DD4B.title: "Auto-Smelting Upgrade"
	quest.3905B434A393553A.quest_desc: [
		"Swim much faster."
		""
		"&6Where to look:&r buried treasure, shipwreck treasure, big Ocean Ruins; rarely worn by Drowned."
	]
	quest.3905B434A393553A.title: "Flippers"
	quest.39134E1479DEC509.quest_desc: [
		"Open a &eVault&r with a Trial Key."
		""
		"Each vault rewards each player once, so friends can all claim the same one."
		"&aVaults can give &eOminous Bottles&a. Hold on to those.&r"
	]
	quest.39134E1479DEC509.title: "Unlocked"
	quest.3922754A6B4CD7FF.quest_desc: [
		"Open 10 Lootr containers."
		""
		"Every structure you pass is worth a detour: the loot inside is waiting just for you."
	]
	quest.3922754A6B4CD7FF.title: "Pocket Change"
	quest.394AD20D19355B13.quest_desc: ["Craft an &eAlchemy Bench&r from a Brewing Stand, an Enchanting Table, 4 Wooden Slabs and a Crafting Table."]
	quest.394AD20D19355B13.title: "Alchemy Bench"
	quest.394B3E1CB7AEB29A.quest_desc: [
		"Register &e30&r species from the &eKalos&r region (Generation 6) as caught."
		""
		"Regional forms count for their own region (an Alolan form counts toward Alola). Hisuian forms count toward Galar."
	]
	quest.394B3E1CB7AEB29A.title: "Kalos Field Notes"
	quest.39564FB3754AE384.quest_desc: [
		"&6Price:&r &e6,000 CobbleDollars&r for one."
		""
		"Evolves Charcadet into Armarouge"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.39564FB3754AE384.quest_subtitle: "6,000 CD"
	quest.39564FB3754AE384.title: "Auspicious Armor"
	quest.396D8693AE456300.quest_desc: [
		"With your Z-Ring worn and a Z-Crystal held, unleash a &eZ-Move&r in battle: a one-time, super-powered version of a matching move."
		""
		"You get one Z-Move per battle, so save it for the moment that matters."
	]
	quest.396D8693AE456300.title: "Full Power Pose"
	quest.39756FCB4A0AC836.quest_desc: [
		"Medicinal Brew + a &eFigy&r, &eWiki&r, &eAguav&r, &eMago&r or &eIapapa Berry&r = &eSuper Potion&r (60 HP)."
		""
		"Those Berries mutate from a Persim tree planted next to the five status-healing Berry trees."
	]
	quest.39756FCB4A0AC836.title: "Super Strength"
	quest.398046030436B647.quest_desc: [
		"Shrinks you to half your size."
		""
		"&6Where to look:&r Ruined Portals, village weaponsmiths, brushing Trail Ruins."
	]
	quest.398046030436B647.title: "Charm of Shrinking"
	quest.39B0C8BE312AE78C.quest_desc: [
		"&6Price:&r &e2,000 CobbleDollars&r for one."
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.39B0C8BE312AE78C.quest_subtitle: "2,000 CD"
	quest.39B0C8BE312AE78C.title: "Poison Gem"
	quest.39CEE41B064FE37F.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Changes a Pokémon's stats to be that of a Impish nature"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.39CEE41B064FE37F.quest_subtitle: "5,000 CD"
	quest.39CEE41B064FE37F.title: "Impish Mint"
	quest.39D04F2301C56747.quest_desc: [
		"Finish the &cPokémon Journey&r: Becoming a Trainer, Poké Ball Workshop, Gotta Catch 'Em All, Pokédex Research, Type Mastery and Evolution."
		""
		"From your first Apricorn to a full Pokédex, you know your Pokémon inside out."
		""
		"&aUnlocks once every listed chapter finale is complete; then tick the checkmark.&r"
	]
	quest.39D04F2301C56747.title: "Pokémon Master"
	quest.39D45CE64CF16CEB.quest_desc: ["Use &e25&r Z-Moves in battle. Different crystals, different finishers."]
	quest.39D45CE64CF16CEB.title: "Zenith"
	quest.39E7654C8E14F6B7.quest_desc: [
		"A lit base, iron armor and a diamond pickaxe. Your first days are behind you."
		""
		"Head &eInto the Depths&r for ores and caves, or mine &eObsidian&r and open the way to &cThe Nether&r."
	]
	quest.39E7654C8E14F6B7.title: "Settled In"
	quest.39EB97287E3D76BC.quest_desc: [
		"Look at any Pokémon. Its &enameplate&r shows the level and, thanks to &eCatch Indicator&r, whether you have already caught that species, plus shiny, gender and Alpha marks. Species you have never registered show as &e???&r."
		""
		"&aLook for species you have not caught yet.&r"
	]
	quest.39EB97287E3D76BC.title: "Know Before You Throw"
	quest.39F87EA3239A8EA2.quest_desc: [
		"Finish &9Storage and Utility&r: Sophisticated Backpacks, Storage Solutions, Iron Furnaces and Supplementaries."
		""
		"A base that runs itself and a backpack that carries everything."
		""
		"&aUnlocks once every listed chapter finale is complete; then tick the checkmark.&r"
	]
	quest.39F87EA3239A8EA2.title: "Master Builder"
	quest.39FBCCFC1D10FB26.quest_desc: [
		"&eBlazes&r spawn from the spawners inside fortresses and drop up to one &eBlaze Rod&r each (Looting adds more). Fortress chests can hold rods too."
		""
		"Blaze Rods are the key to the &eBrewing Stand&r and, as Blaze Powder, to the Eyes of Ender that open &eThe End&r."
	]
	quest.39FBCCFC1D10FB26.title: "Rod of Fire"
	quest.3A0CDA8BC642D716.quest_desc: [
		"&eMax Mushrooms&r hold Dynamax energy."
		""
		"They grow wild in the world below Y 60; a fully grown one drops three. You can also craft two from a Red Mushroom, Nether Wart and Blaze Powder, or find them in loot chests."
	]
	quest.3A0CDA8BC642D716.title: "Fun Guy"
	quest.3A0DE5EF9C708D24.quest_desc: [
		"Wake the statue in the Regigigas room and catch &dRegigigas&r. It leaves a &eTitan Core&r behind."
		""
		"&aThe Titan Core crafts the &eTitan Hammer&a (with 2 Netherite Ingots and 2 Breeze Rods) or joins five Golem Pauldrons into the &eTitan Pauldron&a.&r"
	]
	quest.3A0DE5EF9C708D24.title: "The Colossal One"
	quest.3A168607CE99B37C.quest_desc: [
		"&eTrainer Brendan&r wants a rematch once you hold the Marsh Badge. Look on the &eplains&r and in caves."
		""
		"Metagross, Medicham, Crawdaunt, Exploud, Gardevoir and Sceptile."
	]
	quest.3A168607CE99B37C.quest_subtitle: "Trainer Brendan"
	quest.3A168607CE99B37C.title: "Friendly Competition"
	quest.3A3D0B4C934A548D.quest_desc: [
		"&6Price:&r &e15,000 CobbleDollars&r for one."
		""
		"Boosts the power of the holder's moves, but causes recoil damage"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.3A3D0B4C934A548D.quest_subtitle: "15,000 CD"
	quest.3A3D0B4C934A548D.title: "Life Orb"
	quest.3A43330E3A980A08.quest_desc: ["The &bPlains of Death&r spread across parts of the desert. Trap its &eRestless Souls&r in Jars and offer 16 Soul Jars to the &eYveltal Cocoon&r."]
	quest.3A43330E3A980A08.title: "Wings of Destruction"
	quest.3A5A77BEC4C4CAA9.quest_desc: [
		"Register &e45&r species from the &eSinnoh&r region (Generation 4) as caught."
		""
		"Regional forms count for their own region (an Alolan form counts toward Alola). Hisuian forms count toward Galar."
	]
	quest.3A5A77BEC4C4CAA9.title: "Sinnoh Field Notes"
