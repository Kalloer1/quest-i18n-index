	quest.53446115EE13CC89.title: "Hall of Fame Plaque"
	quest.53605BD62A9398DA.quest_desc: [
		"Has a 50% chance to hurt attackers back."
		""
		"&6Where to look:&r Ruined Portals, brushing Trail Ruins; rarely worn by husks."
