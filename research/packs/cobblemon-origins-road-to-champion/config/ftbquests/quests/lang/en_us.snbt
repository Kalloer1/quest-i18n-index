	quest.64C700D589778F54.title: "Chipped Pot"
	quest.64DB2CD9D8B8392A.quest_desc: ["Catch any &dMythical Pokémon&r. Mew roams floral and jungle biomes, Darkrai haunts the Deep Dark, and Deoxys falls to the End and high mountains."]
	quest.64DB2CD9D8B8392A.title: "Myth Made Real"
	quest.650D491B5DD9F29B.quest_desc: [
		"Craft a &eBall Synchronizer&r (6 &eGold Ingots&r and 2 &eIron Ingots&r) to rehouse a Pokémon in a different ball."
		""
		"Give the Pokémon the ball you want as its held item, then use the Synchronizer on it."
	]
	quest.650D491B5DD9F29B.title: "Ball Swap"
	quest.6525E545B769ECF8.quest_desc: [
		"Find an Explorify &efarmstead&r."
		""
		"Lone farms with beehives and composters, out in plains biomes away from villages."
	]
	quest.6525E545B769ECF8.title: "Down on the Farm"
	quest.652A79E3019FE5D9.quest_desc: ["Find a &eSentry&r armor trim template in a pillager outpost chest (see Villagers and Raids)."]
	quest.652A79E3019FE5D9.title: "Sentry Trim"
	quest.6530D0D9DFAE1EC7.quest_desc: [
		"&e4 String&r, &e4 Iron Ingots&r and &e1 Leather&r."
		""
		"Every upgrade in this chapter is crafted from one of these (or from the upgrade before it). Upgrades go into a backpack's upgrade slots, so higher tiers can run more of them at once."
	]
	quest.6530D0D9DFAE1EC7.title: "Upgrade Base"
	quest.6536617BD57DB8CD.quest_desc: [
		"Legendary Pokémon reach you two ways here: &esummoned&r at the monuments of &6Legendary Monuments&r, or met in the wild as ultra-rare spawns from the &6CR Biome Expanded Spawns&r datapack."
		""
		"Each branch of this chapter is a chain of key items: craft or find the item, carry it to the right monument, and the legend appears."
		""
		"&aMost pedestals work once per player. A &eMedallion of Renewal&a (four fragments from monument chests) lets you use one again.&r"
	]
	quest.6536617BD57DB8CD.title: "Legends and Myths"
	quest.656867524EE9A54E.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Changes a Pokémon's stats to be that of a Naive nature"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.656867524EE9A54E.quest_subtitle: "5,000 CD"
	quest.656867524EE9A54E.title: "Naive Mint"
	quest.6568F7B2B20C2ABA.quest_desc: [
		"&eRocket Admin Ariana&r steps up after Archer falls. She roams the same places: Nether, End Cities, badlands and savannas."
		""
		"Hatterene, Rhyperior, Honchkrow and Mawile."
	]
	quest.6568F7B2B20C2ABA.quest_subtitle: "Rocket Admin Ariana"
	quest.6568F7B2B20C2ABA.title: "Alpha"
	quest.6569623C1994EB05.quest_desc: [
		"Team Rocket regroups. &eRocket Admin Archer&r now turns up in the &cNether&r, near &5End Cities&r and in the badlands and savannas."
		""
		"Mamoswine, Durant, Mimikyu and Houndoom."
	]
	quest.6569623C1994EB05.quest_subtitle: "Rocket Admin Archer"
	quest.6569623C1994EB05.title: "Beta"
	quest.6576C9239E7AAD33.quest_desc: [
		"Catch &e100&r Pokémon."
		""
		"A hundred catches in, you know your way around a battle and a Poké Ball. The rare stuff starts here."
	]
	quest.6576C9239E7AAD33.title: "Century Catcher"
	quest.6582B58AE2754F92.quest_desc: [
		"&oMultiplayer.&r A &eTwinbound Feather&r: &eFeather&r, &eAmethyst Shard&r, &eGold Nugget&r and &eInk Sac&r."
		""
		"Link your feather with a friend's and the two of you can warp to each other."
	]
	quest.6582B58AE2754F92.title: "Birds of a Feather"
	quest.658DE0540F83D4CD.quest_desc: [
		"&e5 Planks&r and &e4 Iron Ingots&r in a checkerboard."
		""
		"The base for every storage upgrade. Already crafted backpack upgrades? Surround one with &ePlanks&r to convert it into the storage version (String and Leather convert it back)."
	]
	quest.658DE0540F83D4CD.title: "Upgrade Base"
	quest.6596F79D5B151662.quest_desc: [
		"&eTier 2&r with &e6 Gold Ingots&r and &e2 Blocks of Gold&r."
		""
		"Every slot holds &e8x&r as many stacks. Chests, barrels and shulker boxes take up to &e2&r stack upgrades each."
	]
	quest.6596F79D5B151662.title: "Stack Upgrade Tier 3"
	quest.65B6025E2AB03080.quest_desc: [
		"Fill a bucket with lava. Lava pools are common in deep caves."
		""
		"&cNever dig straight down, and keep a water bucket handy.&r"
	]
	quest.65B6025E2AB03080.title: "Liquid Fire"
	quest.6607661BEAF57AC5.quest_desc: [
		"&eGhasts&r drift over the Nether Wastes, Soul Sand Valleys and Basalt Deltas. Down one and grab the &eGhast Tear&r before it falls into lava."
		""
		"Tears brew Regeneration and craft &eEnd Crystals&r. Cobblemon uses them in the &eLife Orb&r, &eDestiny Knot&r and &eReaper Cloth&r (Dusclops evolves into Dusknoir when traded holding one)."
	]
	quest.6607661BEAF57AC5.title: "Tears of a Ghast"
	quest.660DA35156F9E54D.quest_desc: [
		"Defeat a &etier 4&r raid boss."
		""
		"Tier 4 bosses are level &e45&r with 12x their normal HP. A win pays &e10,000&r CobbleDollars and the reward Pokémon comes with &e3&r perfect IVs."
	]
	quest.660DA35156F9E54D.quest_subtitle: "Tier 4 raid"
	quest.660DA35156F9E54D.title: "Four-Star General"
	quest.6631DF474D52E3A2.quest_desc: [
		"Three &eFlax&r in a column twist into three &eRope&r."
		""
		"Rope hangs from the side of blocks, stretches sideways, and lets you slide down without fall damage. Perfect for dropping into caves in search of evolution stone ores."
	]
	quest.6631DF474D52E3A2.title: "Learning the Ropes"
	quest.66323DC5227776F1.quest_desc: [
		"&6Price:&r &e15,000 CobbleDollars&r for one."
		""
		"5× on Ultra Beasts, 0.1× otherwise"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.66323DC5227776F1.quest_subtitle: "15,000 CD"
	quest.66323DC5227776F1.title: "Beast Ball"
	quest.6645C8F9E0D964B4.quest_desc: [
		"Find an Explorify &eEnd shipwreck&r in the outer End, where End Cities generate."
		""
		"Its chests carry End City treasure."
	]
	quest.6645C8F9E0D964B4.title: "Lost in Space"
	quest.66488F4736CD36F9.quest_desc: [
		"Revive an &eAnorith&r (Rock/Bug) from a &eClaw Fossil&r."
		""
		"Look for it at dripstone oases, frozen spikes, mossy ponds, preserved skeletons and underwater fissures."
	]
	quest.66488F4736CD36F9.title: "Anorith"
	quest.6652BA3A70BE22D2.quest_desc: [
		"Craft a &eSafari Ball&r: 2 Green Apricorns, 1 Yellow Apricorn and 1 White Apricorn around a &eCopper Ingot&r."
		""
		"&6Catch rate:&r 1.5x outside of battle."
	]
	quest.6652BA3A70BE22D2.title: "Safari Ball"
	quest.666F4D3A674CB9E9.quest_desc: [
		"&e4 Leather&r, &e4 String&r and a &eChest&r in the middle."
		""
		"A leather Backpack holds &e27 slots&r (a whole chest) and has &e1 upgrade slot&r. Press &eB&r to open it while worn, or set it down as a block."
		"&oRarely, a zombie or skeleton spawns wearing a backpack. Check it before you leave!&r"
	]
	quest.666F4D3A674CB9E9.title: "Into the Bag"
	quest.667473FB9500328A.quest_desc: [
		"&6Price:&r &e1,000 CobbleDollars&r for one."
		""
		"1× to 4×, increases the higher the player's Pokémon level is compared to the target"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.667473FB9500328A.quest_subtitle: "1,000 CD"
	quest.667473FB9500328A.title: "Level Ball"
	quest.667903BECD9793F5.quest_desc: [
		"Explore a &6Tropical Jungle&r."
		""
		"Tropius and Tangela are about, and Slakoth hang lazily in the treetops."
		"&oTapu Koko, ultra-rare, guards jungles like this.&r"
	]
	quest.667903BECD9793F5.title: "Welcome to the Jungle"
	quest.66A6A1E6A9EAB9A0.quest_desc: [
		"Raid bosses use the normal shiny odds, and a shiny boss means a shiny reward for everyone in the raid."
		""
		"Catch a shiny Pokémon from a raid."
	]
	quest.66A6A1E6A9EAB9A0.quest_subtitle: "Pure luck"
	quest.66A6A1E6A9EAB9A0.title: "Sparkling Spoils"
	quest.66A6C1B138D4384E.quest_desc: [
		"Win a &eShiny Charmander Pokédoll&r."
		""
		"Shiny dolls are the rare roll of each pool. Fiery Yarn only holds Charmander, so about 1 pull in 9 is a Shiny Charmander."
	]
	quest.66A6C1B138D4384E.title: "Shiny Stitches"
	quest.66ACF27D2D27D6F5.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Boosts the power of the holder's Grass-type moves"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.66ACF27D2D27D6F5.quest_subtitle: "5,000 CD"
	quest.66ACF27D2D27D6F5.title: "Miracle Seed"
	quest.66BCA5268C989FCC.quest_desc: [
		"Vanilla Minecraft has two kinds of magic: &eenchanting&r gear with experience and Lapis Lazuli, and &ebrewing&r potions over Blaze Powder."
		""
		"This chapter builds a full enchanting library, a brewery, and finally a &eBeacon&r and a &eConduit&r."
		""
		"&aYou already have Obsidian, so the Enchanting Table is only a few books away.&r"
	]
	quest.66BCA5268C989FCC.quest_subtitle: "A little magic goes a long way"
	quest.66BCA5268C989FCC.title: "&lEnchanting and Brewing&r"
	quest.66D28E9CD8B28A66.quest_desc: [
		"&6Price:&r &e2,500 CobbleDollars&r for one."
		""
		"If holder is hit by a special move, attacker loses 1/8 of its max HP"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.66D28E9CD8B28A66.quest_subtitle: "2,500 CD"
	quest.66D28E9CD8B28A66.title: "Rowap Berry"
	quest.66DCBD080FA574A0.quest_desc: [
		"Reel in 50 Pokémon."
		""
		"&aTip:&r a Poké Rod only pulls up its rare treasure in &eopen water&r, so fish from a wide, deep spot."
	]
	quest.66DCBD080FA574A0.title: "Seasoned Angler"
	quest.66E7E79D88FAF149.quest_desc: [
		"Cross a &6Savanna&r."
		""
		"Blitzle and Phanpy roam the grass, Doduo race across it, and Komala dozes up in the acacias."
		"&oRaikou and Zapdos, both ultra-rare, can appear here.&r"
	]
	quest.66E7E79D88FAF149.title: "Acacia Horizon"
	quest.66EB6605796B3678.quest_desc: [
		"Some evolutions depend on where they happen:"
		"- Pikachu given a Thunder Stone on a beach or tropical island becomes &eAlolan Raichu&r."
		"- Cubone reaching level 28 in the Nether becomes &eAlolan Marowak&r."
		"- Koffing reaching level 35 in a mushroom biome becomes &eGalarian Weezing&r."
		"- Quilava reaching level 36 in a taiga or crimson forest becomes &eHisuian Typhlosion&r."
	]
	quest.66EB6605796B3678.title: "Regional Variety"
	quest.66FA702BCD8D6EF7.quest_desc: [
		"Before evolving Gimmighoul, also feed it Netherite: Scrap counts 1, an Ingot 4 and a Block 36."
		""
		"With a full Scrap Stash of 256 it evolves into a fully netherite-coated Gholdengo."
	]
	quest.66FA702BCD8D6EF7.title: "Netherite Plating"
	quest.66FD1BB021E23D7E.quest_desc: [
		"Three Apricorns of any color in a V shape craft &ethree Bowls&r."
		""
		"A handy use for spare Apricorns: bowls hold juices, stews and dips."
	]
	quest.66FD1BB021E23D7E.title: "Bowled Over"
	quest.67001F9F7772AA0B.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Boosts the holder's Defense in Electric terrain"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.67001F9F7772AA0B.quest_subtitle: "5,000 CD"
	quest.67001F9F7772AA0B.title: "Electric Seed"
	quest.670F5C5A882EB6A3.quest_desc: [
		"Win battles against &e25&r wild Pokémon. Look at a wild Pokémon and press &eR&r to send out your lead and start the fight."
		""
		"Every knockout gives your battler &eEVs&r as well as experience (see the stats branch above)."
	]
	quest.670F5C5A882EB6A3.title: "Practice Rounds"
	quest.67370F46EA682838.quest_desc: [
		"Eight planks around the edge of the grid make a &eChest&r."
		""
		"Items go in chests, Pokémon go in the &ePC&r from your starter kit. Keep both close to home."
	]
	quest.67370F46EA682838.title: "Somewhere to Put It"
	quest.6748F62186AF3303.quest_desc: [
		"Paper and Gunpowder craft &eFirework Rockets&r. Use one while gliding with the Elytra to shoot forward."
		""
		"More Gunpowder in the recipe means a longer boost. Rockets without firework stars do not hurt you."
	]
	quest.6748F62186AF3303.title: "Rocket Boost"
	quest.6783797AD030F0AC.quest_desc: [
		"Three &eBamboo&r make a &eFlute&r. Use it on your horses, camels, llamas and other tamed pets to bind them, then play it to call them to your side."
		""
		"Your Pokémon do not need it: recall them with &eR&r."
	]
	quest.6783797AD030F0AC.title: "Pied Piper"
	quest.67933934300A7173.quest_desc: [
		"Sprint faster and step up blocks while sprinting."
		""
		"&6Where to look:&r shipwreck treasure, village armorers, brushing warm Ocean Ruins."
	]
	quest.67933934300A7173.title: "Running Shoes"
	quest.679E073E5CD6E985.quest_desc: [
		"Poké Rods take fishing enchantments, and &eLure&r changes what bites."
		""
		"With Lure I or higher, Wailmer, Lapras and Relicanth turn from uncommon to common bites in their oceans, and patterned Magikarp start to appear. A few, like Goomy, want Lure II or more."
	]
	quest.679E073E5CD6E985.title: "Lure Lessons"
	quest.67A8E82BD237D3B0.quest_desc: [
		"The ground is full of secrets: &eFossils&r, &eTumblestones&r, &eType Gems&r and long-lost &eTMs&r."
		""
		"This chapter digs them up, brings ancient Pokémon back to life and grows new stone from old."
		""
		"&aCompletes as soon as you pick up a Fossil, Tumblestone, Type Gem, evolution stone or Deepslate Crystal Core.&r"
	]
	quest.67A8E82BD237D3B0.title: "Interesting Stones"
	quest.67B78A7A194B6263.quest_desc: [
		"Four White Mint Leaves craft a &eSerious Mint&r, which sets stats to a neutral nature."
		""
		"Mint Leaves also go into the Power items used for training: White for the Power Weight, the colors for the rest."
	]
	quest.67B78A7A194B6263.title: "Perfectly Neutral"
	quest.67B963CEE92F6FB1.quest_desc: [
		"The &eBasic to Iron&r upgrade surrounded by &e8 Gold Ingots&r."
		""
		"Upgrades a placed basic chest or barrel straight to this tier, contents kept."
	]
	quest.67B963CEE92F6FB1.title: "Basic to Gold Tier Upgrade"
	quest.67BAA78DE4E4A1A7.quest_desc: [
		"Two &eGlow Berries&r in a &eGlass Bottle&r make &eLumisene&r, a glowing oil."
		""
		"&cWarning:&r drinking it makes you glow, but also &cFlammable&r: you burn longer and leave fire behind as you walk."
	]
	quest.67BAA78DE4E4A1A7.title: "Liquid Light"
	quest.67C33A2514A1BFBB.quest_desc: [
		"Pair a &ePersim&r tree with each status Berry: Cheri gives &eFigy&r, Chesto &eWiki&r, Pecha &eMago&r, Rawst &eAguav&r and Aspear &eIapapa&r."
		""
		"Each restores a third of max HP at low health, but confuses a Pokémon whose nature dislikes the flavor."
	]
	quest.67C33A2514A1BFBB.title: "Flavor Fusion"
	quest.67D51947539AE754.quest_desc: [
		"Use any IV candy on a Pokémon. Cook one in the &eCampfire Pot&r: an &eExp. Candy L&r ringed with four Honeycomb and four of the matching EV berry (Pomeg for HP, Kelpsy for Attack, and so on). An XL candy makes three."
		""
		"Each raises one stat's effective IV by 1. Versions made with &eEnigma Berries&r instead of Honeycomb lower it."
	]
	quest.67D51947539AE754.title: "Candy-Coated Potential"
	quest.67D66DEB5D4DE315.quest_desc: [
		"Your rival &eTerry&r wanders &eplains&r and other open country, and he wants a battle once Archer is beaten."
		""
		"He brings Kirlia, Staravia, Rockruff and a Kanto starter: Wartortle, Ivysaur or Charmeleon."
	]
	quest.67D66DEB5D4DE315.quest_subtitle: "Rival Terry"
	quest.67D66DEB5D4DE315.title: "Enter the Rival"
	quest.67ED1312B94E9D43.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Changes a Pokémon's stats to be that of a Jolly nature"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.67ED1312B94E9D43.quest_subtitle: "5,000 CD"
	quest.67ED1312B94E9D43.title: "Jolly Mint"
	quest.67F298FF89C8672A.quest_desc: [
		"&6Price:&r &e1,500 CobbleDollars&r for one."
		""
		"4× on sleeping Pokémon"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.67F298FF89C8672A.quest_subtitle: "1,500 CD"
	quest.67F298FF89C8672A.title: "Dream Ball"
	quest.67F850AAA45A63E1.quest_desc: ["The &bAmphitheater&r stands in the desert. Play Pigstep, 5, Creator and Relic in its jukeboxes, then put the Disc of the First Song in the &eMeloetta Jukebox&r. &dMeloetta&r takes the stage."]
	quest.67F850AAA45A63E1.title: "Encore!"
	quest.68131B71C8BDB58B.quest_desc: ["Level up a Tangela, Yanma or Piloswine while it knows the move &eAncient Power&r."]
	quest.68131B71C8BDB58B.title: "Ancient Power"
	quest.6841DD4EF1B136AD.quest_desc: [
		"Reach a &6Meadow&r on a mountainside."
		""
		"Gossifleur drift between the flowers."
		"&oLegend says Ho-Oh lands here, ultra-rarely.&r"
	]
	quest.6841DD4EF1B136AD.title: "Mountain Meadow"
	quest.6882B172DBAB3504.quest_desc: [
		"After Giovanni's second defeat, &eArcher&r and &eAriana&r also battle alone with three Pokémon each, in the badlands, savannas and the Nether."
		""
		"Beat both of them. Optional."
	]
	quest.6882B172DBAB3504.quest_subtitle: "Archer and Ariana, solo"
	quest.6882B172DBAB3504.title: "Left and Right Hand"
	quest.688ECF885EFD85CE.quest_desc: [
		"Craft a &eQuick Ball&r: 2 Yellow Apricorns and 2 Blue Apricorns around a &eGold Ingot&r."
		""
		"&6Catch rate:&r 5x on the first turn of battle."
	]
	quest.688ECF885EFD85CE.title: "Quick Ball"
	quest.68955F28D1D53D03.quest_desc: ["Craft the &eFletcher&r's job site: 2 Flint over 4 Planks. Fletchers trade arrows, bows and crossbows."]
	quest.68955F28D1D53D03.title: "Fletcher"
	quest.68AFD8BA239D05F9.quest_desc: [
		"Craft a &eData Monitor&r from Iron Ingots, Copper Ingots, Glass and a Redstone Torch."
		""
		"It is the screen of the Resurrection Machine."
	]
	quest.68AFD8BA239D05F9.title: "Data Monitor"
	quest.68CB8373782E3EA6.quest_desc: [
		"Wear your Key Stone accessory, let a Pokémon hold its own Mega Stone and choose &eMega Evolve&r in battle."
		""
		"The bond between trainer and Pokémon does the rest."
	]
	quest.68CB8373782E3EA6.title: "Light Show"
	quest.68CE78D56E2F663B.quest_desc: [
		"&6Price:&r &e2,500 CobbleDollars&r for one."
		""
		"1×, caught Pokémon gain Friendship twice as fast"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.68CE78D56E2F663B.quest_subtitle: "2,500 CD"
	quest.68CE78D56E2F663B.title: "Luxury Ball"
	quest.68E334767DBCF419.quest_desc: [
		"Catch a Pokémon with a &eNest Ball&r."
		""
		"&aIdeal for low-level wild Pokémon.&r"
	]
	quest.68E334767DBCF419.title: "Nest Egg"
	quest.68F7BA1696095EA3.quest_desc: [
		"&6Price:&r &e3,000 CobbleDollars&r for one."
		""
		"Evolves certain Pokémon"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.68F7BA1696095EA3.quest_subtitle: "3,000 CD"
	quest.68F7BA1696095EA3.title: "Thunder Stone"
	quest.68FAB897CC2352E3.quest_desc: [
		"A &ePortstone&r sends you to your waystones, but nothing can teleport to it. Ideal for a busy base entrance."
		""
		"Recipe: 2 &eWhite Dye&r, 3 &eStone Bricks&r, a &eWarp Stone&r and 3 &ePolished Andesite&r."
	]
	quest.68FAB897CC2352E3.title: "Departure Hall"
	quest.69362A0BE54DA92A.quest_desc: [
		"Register &e35&r species from the &eGalar&r region (Generation 8) as caught."
		""
		"Regional forms count for their own region (an Alolan form counts toward Alola). Hisuian forms count toward Galar."
	]
	quest.69362A0BE54DA92A.title: "Galar Field Notes"
	quest.6940A56A28A1E96F.quest_desc: [
		"Catch a &eHatenna&r."
		""
		"It is an uncommon spawn in magical biomes like the &6Moonlight Grove&r."
		"&oIt dislikes loud emotions, so approach quietly.&r"
	]
	quest.6940A56A28A1E96F.title: "Calm Mind"
	quest.6962288671B148E0.quest_desc: [
		"Cook an &eExp. Candy XS&r in a &eCampfire Pot&r from Sculk and Honeycomb. It gives 100 EXP."
		""
		"&aWild Alphas drop EXP Candies of every size too.&r"
	]
	quest.6962288671B148E0.title: "Sugar Rush"
	quest.6967EF983D321724.quest_desc: [
		"Collect the five status Berries. A Pokémon holding one cures itself in battle:"
		"&eCheri&r paralysis, &eChesto&r sleep, &ePecha&r poison, &eRawst&r burns, &eAspear&r freezing."
		""
		"Cheri grows wild in plains, Chesto in forests, Pecha in jungles and swamps, Rawst in dry lands, Aspear in mountains and taigas."
	]
	quest.6967EF983D321724.title: "Field Medic"
	quest.69713BE911658832.quest_desc: ["The same tower holds &dZekrom&r: the Dark Stone and an &eElectric Gem&r wake it, and it leaves an &eIdeals Bottle&r."]
	quest.69713BE911658832.title: "Black Thunder"
	quest.697278686585BD89.quest_desc: [
		"Find an &eOld PokéNav&r in an Ancient City chest or as fishing treasure."
		""
		"A Diamond, 2 Copper Ingots and Redstone restore it into a working PokéNav."
	]
	quest.697278686585BD89.title: "Antique Tech"
	quest.6977D7E60EB89464.quest_desc: [
		"Near a Power Spot and with the Dynamax Band worn, choose &eDynamax&r in battle."
		""
		"Your Pokémon grows huge and its moves become Max Moves for a few turns."
	]
	quest.6977D7E60EB89464.title: "Giant Steps"
	quest.69AA796268703591.quest_desc: [
		"Key item: &eCoal&r."
		""
		"&a+&r Fuel heats the furnace twice as much."
		"&c-&r Cook time is 25% slower."
	]
	quest.69AA796268703591.title: "Augment: Fuel Efficiency"
	quest.69B8E2852FD15522.quest_desc: ["Level up Eevee with 160 or more friendship while it knows a Fairy-type move."]
	quest.69B8E2852FD15522.title: "Sylveon"
	quest.69E2BD9D3B12C75B.quest_desc: ["With a steed found again, Calyrex sets you a final trial. Win it and &dCalyrex&r joins you."]
	quest.69E2BD9D3B12C75B.title: "King of Bountiful Harvests"
	quest.69EC15BFC7631DC1.quest_desc: [
		"A &eNether Star&r, &e3 Diamonds&r and &e4 Eyes of Ender&r around an &eUpgrade Base&r."
		""
		"Lets you put backpacks inside this backpack, and their upgrades keep working from in there."
	]
	quest.69EC15BFC7631DC1.title: "Inception Upgrade"
	quest.69F0AE4F946B39EF.quest_desc: [
		"Far below the surface, sculk spreads across the &5Deep Dark&r."
		""
		"&cSculk Sensors and the Warden react to sound.&r Sneak to keep them from detecting you."
		"&aPokémon tip:&r Mawile, Golett and the rare Sableye live down here."
	]
	quest.69F0AE4F946B39EF.title: "The Deep Dark"
	quest.69F7E6B1E2192031.quest_desc: ["Five &eLunar Feathers&r make the &eFullmoon Whistle&r."]
	quest.69F7E6B1E2192031.title: "Moonlit Melody"
	quest.6A29D426300F7A47.quest_desc: [
		"Craft &eFrosty Yarn&r from 3 Wool, 3 String and an Ice Gem."
		""
		"In the Plush-O-Matic it gives dolls of Cubchoo, Beartic, Snorunt, Glalie, Froslass, Swinub, Piloswine, Spheal, Delibird, Eiscue, Cetoddle, Frigibax and more."
		""
		"&aType Gems come from ruins, Type Gem clusters (Fossils and Geology chapter) or a Hard Stone plus the matching type-resist Berry (see the recipe viewer).&r"
	]
	quest.6A29D426300F7A47.title: "Frosty Yarn"
	quest.6A37CB47A6CDF9C0.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Raises the Pokémon's Speed EVs by 10"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.6A37CB47A6CDF9C0.quest_subtitle: "5,000 CD"
	quest.6A37CB47A6CDF9C0.title: "Carbos"
	quest.6A701975BB5C6087.quest_desc: [
		"Craft a &eZ-Ring&r: five Iron Ingots, two White Apricorns and a Light Sparkling Stone. Other Apricorn colors make colored rings; the Dark stone makes Z-Power Rings."
		""
		"&aNo stone? In a Smithing Table, a Protector (template), an Echo Shard and a White Apricorn also make a Z-Ring.&r"
		""
		"Wear it in the &eZ Slot&r."
	]
	quest.6A701975BB5C6087.title: "Z-Power Up"
	quest.6A70E0FF484EDA00.quest_desc: [
		"Pull a &eGreat Capsule&r from a Poké Gacha Machine."
		""
		"Great Capsules add held items, Ancient Balls and better medicine to the pool."
	]
	quest.6A70E0FF484EDA00.title: "Great Capsule"
	quest.6A7C900AB8B70998.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Changes a Pokémon's stats to be that of a Mild nature"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.6A7C900AB8B70998.quest_subtitle: "5,000 CD"
	quest.6A7C900AB8B70998.title: "Mild Mint"
	quest.6A7FC3082554E55E.quest_desc: [
		"Use one of each &eCheer&r in raid battles: Attack, Defense and Heal."
		""
		"Cheers boost your whole side, so a well-timed one can save a struggling team."
	]
	quest.6A7FC3082554E55E.title: "Best Supporting Trainer"
	quest.6A8A2CBEB14F45DA.quest_desc: [
		"Craft a bed from three wool and three planks, then sleep in it to set your respawn point."
		""
		"&eComforts&r sleeping bags and hammocks let you rest away from home without moving your spawn (Travel and Camping chapter)."
	]
	quest.6A8A2CBEB14F45DA.title: "Sweet Dreams"
	quest.6A965B53D5445714.quest_desc: [
		"Catch any Sinnoh starter."
		""
		"&bTurtwig&r in forests, &bChimchar&r on mountains, &bPiplup&r on frozen shores and tundra."
	]
	quest.6A965B53D5445714.title: "Twinleaf Trio"
	quest.6A999898AC5F868A.quest_desc: ["Reel in a &eLuvdisc&r. They only bite in &ewarm oceans&r, and only during the day."]
	quest.6A999898AC5F868A.title: "Lovestruck Lagoon"
	quest.6AA50ACF977A5EE4.quest_desc: [
		"Caves are biomes too. &2Lush Caves&r, &6Dripstone Caves&r, the &5Deep Dark&r and YUNG's &eLost&r and &bFrosted Caves&r each have their own blocks and their own Pokémon."
		""
		"Terralith adds even more cave biomes. Check Cobbledex REI to see where a Pokémon spawns."
	]
	quest.6AA50ACF977A5EE4.title: "Underground Wonders"
	quest.6AAEBE912D7D4F7F.quest_desc: [
		"Open 25 Lootr containers."
		""
		"Villages, ruins and YUNG dungeons are packed with them."
	]
	quest.6AAEBE912D7D4F7F.title: "Treasure Habit"
	quest.6AB2E585A078576C.quest_desc: [
		"Press &eC&r to open the &esummary&r: stats, moves, nature and held item of every party Pokémon."
		""
		"When a Pokémon is ready to evolve, a chat message tells you; open the summary and press the &eevolve&r button."
		""
		"&aSneak and interact with your own Pokémon for its menu: held item, shoulder ride and more.&r"
	]
	quest.6AB2E585A078576C.title: "Know Your Team"
	quest.6AB5C096C9E0CF50.quest_desc: [
		"Walking on grass slowly refills hunger, and eating there makes plants grow."
		""
		"&6Where to look:&r Ancient City chests, Pillager Outposts, brushing Trail Ruins; rarely worn by Bogged."
	]
	quest.6AB5C096C9E0CF50.title: "Rooted Boots"
	quest.6AC9F0E585661F01.quest_desc: [
		"The &3Warden&r is blind but tracks you by sound and smell, and it hits harder than anything else in the Overworld."
		""
		"Kill one. Bring your best gear, ranged weapons and a way out. It drops a &eSculk Catalyst&r."
	]
	quest.6AC9F0E585661F01.title: "&3The Warden"
	quest.6AEE27CCC0AF81B9.quest_desc: [
		"Immunity to knockback, and ice stops being slippery."
		""
		"&6Where to look:&r Bastion treasure rooms, Pillager Outposts, shipwreck treasure, village armorers; rarely worn by strays."
	]
	quest.6AEE27CCC0AF81B9.title: "Steadfast Spikes"
	quest.6AF64C99D48A92D2.quest_desc: [
		"&6Price:&r &e2,000 CobbleDollars&r for one."
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.6AF64C99D48A92D2.quest_subtitle: "2,000 CD"
	quest.6AF64C99D48A92D2.title: "Fairy Gem"
	quest.6AFE2B16F66F29EA.quest_desc: [
		"A trainer's base deserves more than cobblestone."
		""
		"This chapter covers &ePokédolls&r from the Plush-O-Matic, the seven &eChipped&r workbenches and Cobblemon's own building blocks: Apricorn and Saccharine wood, Display Cases, Plaques and Gilded Chests."
		""
		"&aClick the checkmark to start.&r"
	]
	quest.6AFE2B16F66F29EA.title: "Make Yourself at Home"
	quest.6B04DFCF2F41F556.quest_desc: [
		"Win &e10&r battles against trainers of any kind."
		""
		"Story trainers count, and so does every youngster, hiker and grunt you meet on the way."
	]
	quest.6B04DFCF2F41F556.quest_subtitle: "10 trainer wins"
	quest.6B04DFCF2F41F556.title: "Getting Noticed"
	quest.6B07A4BE558D8999.quest_desc: [
		"Beat other players in &e5&r Pokémon battles. Look at a player and press &eR&r to open the interaction menu, then choose &eBattle&r."
		""
		"PvP battles award experience in this pack, so a sparring partner is a fine training tool."
	]
	quest.6B07A4BE558D8999.title: "Friendly Rivalry"
	quest.6B25ED260D695641.quest_desc: [
		"Brush Cobblemon ruins for a &eSky Tumblestone&r, another rare find."
		""
		"Like the red one, it grows next to Lava or a Magma Block."
	]
	quest.6B25ED260D695641.title: "Head in the Clouds"
	quest.6B3388FA93115B06.quest_desc: [
		"&6Price:&r &e750 CobbleDollars&r for one."
		""
		"1.5×, throws less far"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.6B3388FA93115B06.quest_subtitle: "750 CD"
	quest.6B3388FA93115B06.title: "Ancient Leaden Ball"
	quest.6B42BE9C48949D04.quest_desc: ["Craft a &eMagma Stone&r from 7 Magma Blocks and 2 Netherite Scrap."]
	quest.6B42BE9C48949D04.title: "Hot Rock"
	quest.6B4BE6BFB95DB67D.quest_desc: [
		"Every Kanto gym is a building that generates in the world, with its leader waiting inside."
		""
		"Craft an &eExplorer's Compass&r (see Structure Hunter) and search for the gym by name, such as &ePewter Gym&r. Use it in the dimension the gym is in."
		""
		"Six gyms stand in the Overworld. &eCinnabar Gym&r is in the &cNether&r; &eBlackthorn Gym&r and the &eKanto League&r are on the outer islands of the &5End&r."
	]
	quest.6B4BE6BFB95DB67D.title: "Finding the Gyms"
	quest.6B843D325F1128A3.quest_desc: [
		"&6Price:&r &e6,000 CobbleDollars&r for one."
		""
		"Evolves Dusclops into Dusknoir when held while trading"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.6B843D325F1128A3.quest_subtitle: "6,000 CD"
	quest.6B843D325F1128A3.title: "Reaper Cloth"
	quest.6B84FDEBA6A56BDE.quest_desc: [
		"&6Price:&r &e500 CobbleDollars&r for one."
		""
		"Restores 1/3 max HP at 1/4 max HP or less; confuses if -Def Nature"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.6B84FDEBA6A56BDE.quest_subtitle: "500 CD"
	quest.6B84FDEBA6A56BDE.title: "Iapapa Berry"
	quest.6B8CC18B9EB8CC5E.quest_desc: [
		"Collect all 35 Z-Crystals: 18 type crystals and 17 species crystals."
		""
		"REI shows every recipe; many species crystals are built from a type crystal."
	]
	quest.6B8CC18B9EB8CC5E.title: "Crystal Collector"
	quest.6BA1499A3307D9C6.quest_desc: [
		"Amethyst geodes hide between y=-58 and y=30 inside shells of smooth basalt and calcite."
		""
		"Break fully grown &eAmethyst Clusters&r with a pickaxe for shards. &cBudding Amethyst drops nothing, even with Silk Touch&r, so leave it where it is."
		"&aPokémon tip:&r shards make &eBlank TMs&r and the Mega Site Compass."
	]
	quest.6BA1499A3307D9C6.title: "Geode Hunter"
	quest.6BA30D54F89ADE4D.quest_desc: [
		"Villages, ruins, dungeons, temples, towers and treasure: you have seen the best this world has built."
		""
		"&oThere is always one more structure over the next hill.&r"
	]
	quest.6BA30D54F89ADE4D.title: "Master Cartographer"
	quest.6BA38E2E57D56DFF.quest_desc: ["Bramblin and Rellor evolve when they level up after walking 1,000 blocks. Check the &eSteps&r counter in their summary."]
	quest.6BA38E2E57D56DFF.title: "The Long Walk"
	quest.6BA654C955B4181F.quest_desc: [
		"Reel in a &eMagikarp&r. They bite almost anywhere in the Overworld."
		""
		"Raise one to level 20 and it becomes a Gyarados."
	]
	quest.6BA654C955B4181F.title: "A Classic Catch"
	quest.6BB93653850EAC78.quest_desc: [
		"Playing with friends? Use the &eMy Team&r button in your inventory, or &e/ftbteams party create&r and &e/ftbteams party invite <player>&r, to form a party."
		""
		"Party members share quest progress and chunk claims, can share waypoints, and each member claims their own quest rewards."
		""
		"&e/tpa <player>&r asks to teleport to a friend. &eV&r opens the proximity voice chat menu."
	]
	quest.6BB93653850EAC78.title: "Better Together"
	quest.6BC56A428B8FCB61.quest_desc: [
		"Enchant any item at the Enchanting Table."
		""
		"You pay with levels and Lapis Lazuli, and the item comes out glowing."
		"&aPlain Books can be enchanted too. They become Enchanted Books you can apply later.&r"
	]
	quest.6BC56A428B8FCB61.title: "Sparkle and Shine"
	quest.6BCA92BEBE88C7B4.quest_desc: [
		"Catch any &cFire&r-type Pokémon in the Nether."
		""
		"The Basalt Deltas and Nether Wastes are full of them: Magby, Slugma, Torkoal, Numel and Ponyta all live there."
	]
	quest.6BCA92BEBE88C7B4.title: "Born in the Fire"
	quest.6BCAF288879B62EC.quest_desc: [
		"&eAprijuice&r raises a Pokémon's riding stats. Cook one &eApricorn&r, a &ePep-Up Flower&r and an &eEnergy Root&r."
		""
		"The Apricorn color picks the base stats; Berry seasonings add more by flavor and raise the quality from Plain to Tasty to Delicious."
	]
	quest.6BCAF288879B62EC.title: "Juice Bar"
	quest.6BCFA1563E401B4E.quest_desc: [
		"Adds a level of Luck of the Sea and of Lure when fishing."
		""
		"&6Where to look:&r buried treasure, big Ocean Ruins, village tanneries, brushing cold Ocean Ruins."
	]
	quest.6BCFA1563E401B4E.title: "Angler's Hat"
	quest.6BDB9C94E94BAE5D.quest_desc: [
		"Catch &e10&r Pokémon during the day (time of day 0 to 12000)."
		""
		"&aTip:&r a &eQuick Ball&r is 5x on the first turn of a battle."
	]
	quest.6BDB9C94E94BAE5D.title: "Early Bird"
	quest.6BFBD41DED3E5C8B.quest_desc: [
		"Revive a &eCranidos&r (Rock) from a &eSkull Fossil&r."
		""
		"Look for it at buried birch or oak trees, mossy ponds, mud pits and suspicious mounds."
	]
	quest.6BFBD41DED3E5C8B.title: "Cranidos"
	quest.6BFBED6C49D7B215.quest_desc: [
		"&eWaystones&r stand in some villages and out in the wild, styled to match their biome. Look at one, then right-click it to &eactivate&r it."
		""
		"From any waystone you can warp to every waystone you have activated. Teleporting is &afree&r in this pack: no XP cost and no cooldown."
	]
	quest.6BFBED6C49D7B215.title: "A Stone That Remembers"
	quest.6C026AF3A3E82D69.quest_desc: [
		"Dynamax a Pokémon with its Gigantamax form unlocked to &eGigantamax&r it."
		""
		"Charizard, Pikachu, Gengar and Snorlax are among the Pokémon with a Gigantamax form."
	]
	quest.6C026AF3A3E82D69.title: "Colossal"
	quest.6C29BB53D6930D50.quest_desc: ["Catch 5 Legendary Pokémon."]
	quest.6C29BB53D6930D50.title: "Legend Collector"
	quest.6C4E3DBEC812E113.quest_desc: [
		"Catch 10 &6Ground&r-type Pokémon. Dual-type Pokémon count for both of their types."
		""
		"&6Strong against:&r Fire, Electric, Poison, Rock, Steel"
	]
	quest.6C4E3DBEC812E113.title: "Down to Earth"
	quest.6C5789D4FBB4D1C8.quest_desc: [
		"&6Price:&r &e1,000 CobbleDollars&r for one."
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.6C5789D4FBB4D1C8.quest_subtitle: "1,000 CD"
	quest.6C5789D4FBB4D1C8.title: "Kelpsy Berry"
	quest.6C58F85217247049.quest_desc: [
		"Reel in a Water starter: Squirtle, Totodile, Mudkip, Piplup, Oshawott, Froakie, Popplio, Sobble or Quaxly."
		""
		"Each is an ultra-rare bite in waters that suit it."
	]
	quest.6C58F85217247049.title: "Starter Surprise"
	quest.6C5CEA80C310DB6B.quest_desc: [
		"Add &eDragon's Breath&r to any Splash Potion to brew a &eLingering Potion&r. It leaves an effect cloud on the ground."
		""
		"Bottle the breath from the Ender Dragon's breath attack, or beat Dratini, Dragonair, Dragonite, Deino, Zweilous or Hydreigon, which can drop it."
	]
	quest.6C5CEA80C310DB6B.title: "Lingering Doubts"
	quest.6C5E33B94D966BA9.quest_desc: [
		"Put the workshop to work: catch 25 Pokémon with specialty or Ancient balls."
		""
		"Unlocks with the basic colors, the Apricorn set, an Ultra Ball, a Dream Ball and your first Ancient ball catch."
		""
		"&aThe Diamonds in the reward make more Dream Balls.&r"
	]
	quest.6C5E33B94D966BA9.title: "Ball Artisan"
	quest.6C89CA615281F73E.quest_desc: [
		"&e2 Netherite Furnaces&r on the middle row, framed by &eStained Glass&r in red, orange, yellow, green, blue, purple and magenta."
		""
		"Yes, two of them. This is where the Rainbow Furnace earns its price."
	]
	quest.6C89CA615281F73E.title: "Rainbow Core"
	quest.6C8D98DB9ECF9DE8.quest_desc: ["Reel in a &eGoomy&r. They bite in swamps and in dark underground water, and far more often on a rod with &eLure II&r or higher, best of all in dripstone and lush caves."]
	quest.6C8D98DB9ECF9DE8.title: "Slime Time"
	quest.6C9D2398BDF253B0.quest_desc: [
		"Smelt any Overworld log in a furnace to get &eCharcoal&r."
		""
		"It works like coal in torches and campfires, so a tree farm is all the fuel you will ever need."
	]
	quest.6C9D2398BDF253B0.title: "No Coal? No Problem"
	quest.6CA4929F1410DEB6.quest_desc: [
		"Catch &e5&r Pokémon in cave biomes (Terralith variants count)."
		""
		"Lush caves hold &bWooper&r and &bMorelull&r, dripstone caves &bClefairy&r and &bLunatone&r, the Deep Dark &bNoibat&r and &bRoggenrola&r."
	]
	quest.6CA4929F1410DEB6.title: "Spelunker"
	quest.6CAEFC5203911E9D.quest_desc: [
		"Find a &eLeaf Stone&r."
		""
		"&6Ore:&r forests, jungles and lush caves, rarer in swamps and tropical islands."
		"&6Evolves:&r Gloom, Weepinbell, Exeggcute, Nuzleaf, Pansage and Eevee."
	]
	quest.6CAEFC5203911E9D.title: "Turning Over a New Leaf"
	quest.6CAF2D0379743968.quest_desc: [
		"&6Price:&r &e400 CobbleDollars&r for one."
		""
		"1× catch rate"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.6CAF2D0379743968.quest_subtitle: "400 CD"
	quest.6CAF2D0379743968.title: "Premier Ball"
	quest.6CCADE53B533E601.quest_desc: [
		"&cIn this pack, Dynamax only works within 20 blocks of a placed Power Spot.&r"
		""
		"Recipe: four Redstone, a Max Mushroom, a Wishing Star and three Stone. Place one where you like to battle."
	]
	quest.6CCADE53B533E601.title: "Power Outlet"
	quest.6CCF76534B8B68D0.quest_desc: [
		"&6Price:&r &e2,500 CobbleDollars&r for one."
		""
		"Raises holder's Defense by 1 stage after it is hit by a physical attack"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.6CCF76534B8B68D0.quest_subtitle: "2,500 CD"
	quest.6CCF76534B8B68D0.title: "Kee Berry"
	quest.6CFA537321F442C8.quest_desc: [
		"Finish &6Legends and Myths&r."
		""
		"The shrines are answered and the legends walk beside you."
		""
		"&aUnlocks once every listed chapter finale is complete; then tick the checkmark.&r"
	]
	quest.6CFA537321F442C8.title: "Living Legend"
	quest.6D1A42B8CBA56FF7.quest_desc: [
		"&6Price:&r &e6,000 CobbleDollars&r for one."
		""
		"The holder is unaffected by Rain or Harsh Sunlight"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.6D1A42B8CBA56FF7.quest_subtitle: "6,000 CD"
	quest.6D1A42B8CBA56FF7.title: "Utility Umbrella"
	quest.6D2522917F120996.quest_desc: [
		"Smelt Ancient Debris in a Furnace or Blast Furnace to get &eNetherite Scrap&r."
		""
		"Four scrap are needed for one ingot. The Gold Ingots in the reward cover the rest."
	]
	quest.6D2522917F120996.title: "Scrap Metal"
	quest.6D2576ACC18A1578.quest_desc: ["Fit Wise Glasses with two Blaze Rods, three Gold Ingots and two Redstone to make &eChoice Specs&r: a big Sp. Atk boost, locked into one move."]
	quest.6D2576ACC18A1578.title: "Choice Specs"
	quest.6D32F2F5A703360C.quest_desc: ["&eHondew Berry&r + Hearty Grains + Honey. Raises &eSp. Atk&r EVs by 4 per Mochi."]
	quest.6D32F2F5A703360C.title: "Genius Mochi"
	quest.6D406CDF5F7339E0.quest_desc: [
		"Find a &eCobble Merchant&r and look at them. They spawn with vanilla villages (plains, desert, savanna, snowy and taiga); the custom CTOV village designs may not have one, and villagers who take the merchant job later may not count."
		""
		"Talk to a merchant to open two screens: the &eShop&r, where you buy, and the &eBank&r, where you sell valuables for CobbleDollars."
	]
	quest.6D406CDF5F7339E0.title: "Meet the Merchant"
	quest.6D5AAE8B7E14B0BD.quest_desc: [
		"At a &eSmithing Table&r, combine the Upgrade Template, a &eDiamond Pickaxe&r and a Netherite Ingot."
		""
		"The upgrade keeps your enchantments, and netherite gear floats and survives in lava."
	]
	quest.6D5AAE8B7E14B0BD.title: "Smithing Upgrade"
	quest.6D791B7E9488F28A.quest_desc: [
		"A &eWarp Scroll&r works like a one-use Warp Stone: read it and pick any activated waystone."
		""
		"Recipe: &eGold Nuggets&r, an &eInk Sac&r, an &eEnder Pearl&r and &ePaper&r make 3."
	]
	quest.6D791B7E9488F28A.title: "One Trip, Any Stop"
	quest.6D8B0FE43204F64C.quest_desc: [
		"Set foot in a &eCatacomb&r, a sprawling zombie dungeon."
		""
		"&cIts staircase can reach the surface, so watch where you dig.&r"
	]
	quest.6D8B0FE43204F64C.title: "When in Rome"
	quest.6DB8FB8EA358B95B.quest_desc: [
		"Revive a &eShieldon&r (Rock/Steel) from an &eArmor Fossil&r."
		""
		"Look for it at eroded pillars, lush dens, mud pits, powdered deposits and sandy dens."
	]
	quest.6DB8FB8EA358B95B.title: "Shieldon"
	quest.6DC4063E4536BC89.quest_desc: [
		"&eEnder Pearl&r, &eObsidian&r and &eRedstone&r around an &eUpgrade Base&r."
		""
		"Deletes whatever you put in its filter. Pair it with a Pickup Upgrade and Cobblestone stops being a problem."
		"&cVoided items are gone for good.&r"
	]
	quest.6DC4063E4536BC89.title: "Void Upgrade"
	quest.6DEDBB679E214460.quest_desc: [
		"&6Price:&r &e3,000 CobbleDollars&r for one."
		""
		"Restores 10 PP to all of a Pokémon's moves"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.6DEDBB679E214460.quest_subtitle: "3,000 CD"
	quest.6DEDBB679E214460.title: "Elixir"
	quest.6E2414D858A6A6D7.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Raises the Pokémon's Sp. Def EVs by 10"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.6E2414D858A6A6D7.quest_subtitle: "5,000 CD"
	quest.6E2414D858A6A6D7.title: "Zinc"
	quest.6E4D856CC218CD40.quest_desc: [
		"Level up Golbat, Chansey, Munchlax, Togepi, Pichu, Buneary, Woobat or Swadloon with 160 or more friendship."
		""
		"Riolu must do it during the day, Chingling and Snom at night."
	]
	quest.6E4D856CC218CD40.title: "Best Friends"
	quest.6E52035F82BA1188.quest_desc: [
		"You have caught and beaten every one of the 18 types."
		""
		"Claim your reward once all 18 defeat quests are done, and pick the Type Gems that suit your team."
	]
	quest.6E52035F82BA1188.title: "&lType Master"
	quest.6E6929D730920445.quest_desc: [
		"Craft an &eAncient Poké Ball&r: 2 &eRed Apricorns&r above and below a &eCopper Ingot&r, flanked by 2 &eTumblestones&r. Makes 4."
		""
		"Each basic color has an ancient twin made the same way."
	]
	quest.6E6929D730920445.title: "Old School"
	quest.6E6F193DDD124D6D.quest_desc: [
		"Craft a &eRelic Coin Sack&r from 9 pouches (81 coins)."
		""
		"The Bank pays 4,500 for it, more than the 4,275 the nine pouches would fetch."
	]
	quest.6E6F193DDD124D6D.title: "Treasure Sack"
	quest.6E940A0E2FF70AB2.quest_desc: [
		"&6Price:&r &e1,200 CobbleDollars&r for one."
		""
		"3.5× if target is in Light Level 0, 3× if in Light Level 1-7"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.6E940A0E2FF70AB2.quest_subtitle: "1,200 CD"
	quest.6E940A0E2FF70AB2.title: "Dusk Ball"
	quest.6EA79112D4ACB47B.quest_desc: ["&eCosmic Dust&r glitters in the End. You can only collect it with a Cosmic Catalyst in hand."]
	quest.6EA79112D4ACB47B.title: "Something in the Stars"
	quest.6EADF2857F66CC80.quest_desc: [
		"Terralith's fantasy biomes and the rare Mushroom Fields hold some of the strangest Pokémon around."
		""
		"These biomes are rare, so let your &eNature's Compass&r do the searching."
		"&aTip:&r legendary spawns are announced in chat, so keep an eye on it while you explore."
	]
	quest.6EADF2857F66CC80.title: "Enchanted Lands"
	quest.6EB73698E154BD81.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Boosts the power of the holder's Dragon-type moves"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.6EB73698E154BD81.quest_subtitle: "5,000 CD"
	quest.6EB73698E154BD81.title: "Dragon Fang"
	quest.6ECE3631BEF3A356.quest_desc: [
		"Surround a &eFurnace&r with &e8 Iron Ingots&r."
		""
		"Cook time drops to &e160 ticks&r per item, and it accepts &eAugments&r. Every furnace further up the ladder is built on top of this one."
	]
	quest.6ECE3631BEF3A356.title: "Iron Furnace"
	quest.6EE24143248C1B7A.quest_desc: [
		"Register &e45&r species from the &eJohto&r region (Generation 2) as caught."
		""
		"Regional forms count for their own region (an Alolan form counts toward Alola). Hisuian forms count toward Galar."
	]
	quest.6EE24143248C1B7A.title: "Johto Field Notes"
	quest.6EE99BDF9D2CCA2D.quest_desc: ["Find an &eAutomaton&r armor trim template, Cobblemon's own design, in the Gilded Chests of Cobblemon's ruins. It copies with 7 Diamonds and Cobblestone."]
	quest.6EE99BDF9D2CCA2D.title: "Automaton Trim"
	quest.6F1360A502783DEF.quest_desc: ["Craft an &eAsh Cap&r from Red, White and Green Wool. REI shows the pattern."]
	quest.6F1360A502783DEF.title: "Hat Trick"
	quest.6F2A10F177C6171B.quest_desc: [
		"Lets &eTyranitar&r Mega Evolve."
		""
		"Recipe: raw Mega Stone, two Iron Ingots, a Diamond and a &eRocky Helmet&r."
	]
	quest.6F2A10F177C6171B.title: "Tyranitarite"
	quest.6F2E87DCEB4C75C9.quest_desc: [
		"Breathe underwater for a limited time."
		""
		"&6Where to look:&r buried treasure, shipwreck treasure, big Ocean Ruins; rarely worn by Drowned."
	]
	quest.6F2E87DCEB4C75C9.title: "Snorkel"
	quest.6F3E402AE631747F.quest_desc: [
		"Find &eocean ruins&r."
		""
		"Relicanth and Dratini swim among the stones; Dragonite has been seen here too."
	]
	quest.6F3E402AE631747F.title: "Sunken City"
	quest.6FB06109D6BB4E3C.quest_desc: [
		"You have stood before Ho-Oh and Lugia, Arceus and Kyurem, Regigigas, Calyrex and Eternatus, and filled your PC with legends."
		""
		"&oThe monuments are quiet now. They remember you.&r"
		""
		"Take this &eMaster Ball&r. You have earned the right to choose which legend it is for."
	]
	quest.6FB06109D6BB4E3C.title: "Keeper of Legends"
	quest.6FB869B57A24AE9F.quest_desc: [
		"The dragon is slain, the cities are explored and you have wings."
		""
		"Few trainers ever see the End. Fewer still come back with an Elytra on their back."
	]
	quest.6FB869B57A24AE9F.title: "&5Master of the End"
	quest.6FBC4A1730AF4671.quest_desc: [
		"A &eStorage Controller&r and an &eEnder Pearl&r make &e3 Storage Links&r (shapeless)."
		""
		"Links connect a separate group of storage to the controller. Bind each one with the &eStorage Tool&r."
	]
	quest.6FBC4A1730AF4671.title: "Storage Link"
	quest.6FBD12AA04D72ECC.quest_desc: ["Craft the &eFisherman&r's job site: 6 Planks and 2 Wooden Slabs. A barrel is also handy storage."]
	quest.6FBD12AA04D72ECC.title: "Fisherman"
	quest.6FBDD8FE75B518FC.quest_desc: [
		"Climb the &6Jagged Peaks&r."
		""
		"Delibird and Crabominable brave the summit."
		"&oAn ultra-rare Galarian Articuno roosts above Y 110.&r"
	]
	quest.6FBDD8FE75B518FC.title: "Peak Performance"
	quest.6FCB34D1CB9B74A7.quest_desc: [
		"Craft a &eWishing Weald Compass&r: a Compass ringed by four Iron Ingots, two Amethyst Shards and two Emeralds."
		""
		"Right-click it to track the nearest &6Wishing Weald&r."
	]
	quest.6FCB34D1CB9B74A7.title: "Fairy-Tale Finder"
	quest.6FD59E1023D4661A.quest_desc: [
		"&6Price:&r &e6,000 CobbleDollars&r for one."
		""
		"Evolves Galarian Slowpoke into Galarian Slowking"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.6FD59E1023D4661A.quest_subtitle: "6,000 CD"
	quest.6FD59E1023D4661A.title: "Galarica Wreath"
	quest.6FE1715DB39279A5.quest_desc: [
		"A level 100 partner, a thousand wild wins, perfect IVs, all three Choice items, your own TMs and hidden abilities."
		""
		"Your team is ready for anything. Next stop: &eRoad to Champion&r and the rest of the Battle Frontier."
	]
	quest.6FE1715DB39279A5.quest_subtitle: "Ready for anything"
	quest.6FE1715DB39279A5.title: "&6&lBattle Master"
	quest.6FE2728C0DCA5BF1.quest_desc: [
		"Catch a Pokémon with a &eSafari Ball&r."
		""
		"&aThrow it at a wild Pokémon without starting a battle.&r"
	]
	quest.6FE2728C0DCA5BF1.title: "No Battle Needed"
	quest.6FE3CFC439E93408.quest_desc: [
		"A &eHammock&r is Wool with &eString&r and &eSticks&r. It hangs between two &eRope and Nail&r blocks (4 String and an &eIron Ingot&r make 2)."
		""
		"In this pack hammocks and sleeping bags both work day or night, and resting in either keeps Phantoms away."
	]
	quest.6FE3CFC439E93408.title: "Siesta Time"
	quest.6FF186D7326AF7B2.quest_desc: [
		"Craft &eFiery Yarn&r from 3 Wool, 3 String and a Fire Gem."
		""
		"In the Plush-O-Matic it gives dolls of Charmander, and nothing but Charmander."
		""
		"&aType Gems come from ruins, Type Gem clusters (Fossils and Geology chapter) or a Hard Stone plus the matching type-resist Berry (see the recipe viewer).&r"
	]
	quest.6FF186D7326AF7B2.title: "Fiery Yarn"
	quest.7001DD9320E43DCC.quest_desc: [
		"A &6Mega Site&r is a meteorite buried between Y -19 and 5."
		""
		"At its heart grows a &eMega Crystal&r, the source of raw Mega Stones."
	]
	quest.7001DD9320E43DCC.title: "Crystal at the Core"
	quest.700321A2C3A4959C.quest_desc: [
		"The &bBurned Tower&r stands in the Pagoda villages of the &bDyna Plains&r. Set a Treat on its beast's pedestal to summon &dEntei&r, &dRaikou&r or &dSuicune&r."
		""
		"Each beast leaves a feather behind: Red from Entei, Yellow from Raikou, Blue from Suicune."
	]
	quest.700321A2C3A4959C.title: "Burned Tower Rendezvous"
	quest.70126C2EDD2D7391.quest_desc: [
		"Find a &eFire Stone&r."
		""
		"&6Ore:&r deserts, volcanic and hot-spring biomes, rarer in badlands. Nether Fire Stone Ore also fills the netherrack of the Nether."
		"&6Evolves:&r Vulpix, Growlithe, Pansear, Capsakid and Eevee."
	]
	quest.70126C2EDD2D7391.title: "Hot Rock"
	quest.702BDCE4ED48BC04.quest_desc: ["Craft a &eMeltan Box&r: 5 Iron Ingots, a Netherite Ingot, a Redstone Block, a Lapis Block and any Golem Ingot."]
	quest.702BDCE4ED48BC04.title: "A Box of Bolts"
	quest.704E144893E56BC3.quest_desc: ["Craft a &eTinkering Table&r from 2 Redstone Torches, Redstone Dust, 2 Iron Ingots, 2 Logs and a Crafting Table."]
	quest.704E144893E56BC3.title: "Tinkering Table"
	quest.70589D82D3214EB8.quest_desc: [
		"Break gravel until it drops &eFlint&r, then combine it with an iron ingot."
		""
		"You will need it to light a Nether Portal."
	]
	quest.70589D82D3214EB8.title: "Spark of Genius"
	quest.7079DC2C92AEA0CB.quest_desc: [
		"Every ruin, temple and shipwreck in this world hides loot, and none of it is first come, first served."
		""
		"This chapter covers &eLootr&r (loot for every player), the Pokémon goodies in structure chests, and &eArtifacts&r: wearable trinkets you can only find, never craft."
		""
		"&aClick the checkmark to start digging.&r"
	]
	quest.7079DC2C92AEA0CB.quest_subtitle: "Finders keepers"
	quest.7079DC2C92AEA0CB.title: "&lThe Treasure Map"
	quest.708A8AB8B3D00CE0.quest_desc: [
		"Craft a &eMega Site Compass&r: a Compass ringed by four Iron Ingots, two Amethyst Shards and two Glowstone Dust."
		""
		"Right-click it to track the nearest &6Mega Site&r."
	]
	quest.708A8AB8B3D00CE0.title: "Crater Seeker"
	quest.70A9F26DB42D7085.quest_desc: [
		"Find the &6Fungal Caves&r."
		""
		"Foongus and Amoonguss hide among the giant mushrooms; Shuckle is less common."
	]
	quest.70A9F26DB42D7085.title: "Spore Cavern"
	quest.70B0E0A664A5491E.quest_desc: ["Open &e10&r Raid Pouches."]
	quest.70B0E0A664A5491E.title: "Pouch Hoarder"
	quest.70C4F800D3C0A541.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Changes a Pokémon's stats to be that of a Rash nature"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.70C4F800D3C0A541.quest_subtitle: "5,000 CD"
	quest.70C4F800D3C0A541.title: "Rash Mint"
	quest.70DB35603DD6C69D.quest_desc: [
		"Build an &eIron Golem&r: 4 Blocks of Iron in a T shape, then a Carved Pumpkin or Jack o'Lantern on top."
		""
		"Golems guard the village and fight the raiders that come for it."
	]
	quest.70DB35603DD6C69D.title: "Hired Muscle"
	quest.70E72F71C37CEDAE.quest_desc: [
		"The final showdown with &eBoss Giovanni&r, in the Nether, near End Cities or in the badlands and savannas."
		""
		"Scrafty, Tapu Lele, Excadrill, Tyranitar, Celesteela and &dMewtwo&r. Win, and Team Rocket's plans fall apart."
	]
	quest.70E72F71C37CEDAE.quest_subtitle: "Boss Giovanni, final battle"
	quest.70E72F71C37CEDAE.title: "Head of the Snake"
	quest.70FD086C94277F46.quest_desc: [
		"Plant your seeds on farmland. Flax grows two blocks tall; harvest it fully grown for &eFlax&r and more seeds."
		""
		"Flax is the fiber behind &eRope&r, &eSacks&r, awnings and doormats, so keep a field of it going."
	]
	quest.70FD086C94277F46.title: "Flax Farmer"
	quest.70FD88C7A08910E0.quest_desc: [
		"Catch a Pokémon with a &eDream Ball&r."
		""
		"&aPut the target to sleep with a move like Sleep Powder or Hypnosis first.&r"
	]
	quest.70FD88C7A08910E0.title: "Sweet Dreams"
	quest.71029768D16E6DB4.quest_desc: [
		"Catch a Pokémon with a &eFriend Ball&r."
		""
		"&aGreat for species that evolve through friendship.&r"
	]
	quest.71029768D16E6DB4.title: "Instant Friends"
	quest.7133EFFF3B329686.quest_desc: [
		"Surround a &eBlank-Z&r with four &eType Gems&r of one type to craft that type's Z-Crystal, like Firium-Z from Fire Gems."
		""
		"Give it to a Pokémon that knows a move of that type."
	]
	quest.7133EFFF3B329686.title: "Crystal Clear"
	quest.715526BAE5858037.quest_desc: [
		"&eLeader Sabrina&r waits in the &eSaffron Gym&r, found in &edark forests&r, &echerry&r and &esakura groves&r, &emoonlight groves&r and &ecloud forests&r."
		""
		"She battles you after your second win over Boss Giovanni. Expect Hatterene, Gardevoir, Indeedee, Crawdaunt, Porygon2 and Ursaluna: a mixed team that rewards a mixed party."
	]
	quest.715526BAE5858037.quest_subtitle: "Leader Sabrina, Saffron Gym"
	quest.715526BAE5858037.title: "Marsh Badge"
	quest.715800E77F559630.quest_desc: [
		"&6How it works&r"
		"1. Wear a Mega Bracelet or any Key Stone accessory in the &eMega Slot&r of the accessories screen (&eH&r)."
		"2. Give your Pokémon its own species Mega Stone to hold."
		"3. In battle, choose &eMega Evolve&r when picking a move."
		""
		"&cOnly one of your Pokémon can be Mega Evolved at a time.&r"
		"&aThe Mega Evolve keybind (Controls, Mega Showdown) also works outside battle.&r"
	]
	quest.715800E77F559630.title: "Mega Evolution 101"
	quest.71798D5D7D52A17B.quest_desc: [
		"Catch 10 &fNormal&r-type Pokémon. Dual-type Pokémon count for both of their types."
		""
		"&6Strong against:&r nothing, but only Rock and Steel resist it and only Ghost is immune."
	]
	quest.71798D5D7D52A17B.title: "Perfectly Normal"
	quest.7196A15A97B58553.quest_desc: [
		"Smelt sand or red sand into &eGlass&r."
		""
		"&aPokémon tip:&r the &ePC&r, the &eCampfire Pot&r and the &eFossil Analyzer&r all need glass."
	]
	quest.7196A15A97B58553.title: "Clear Thinking"
	quest.71A0BBA8BF904DB0.quest_desc: [
		"Defeat &e5&r wild Meowth."
		""
		"Each defeated Meowth has a small chance to drop a &eKoban Coin&r."
	]
	quest.71A0BBA8BF904DB0.title: "Pay Day"
	quest.71A151478B71A44B.quest_desc: [
		"Catch &e5&r Pokémon in snowy or frozen biomes (Terralith variants count)."
		""
		"&bSnorunt&r, &bSwinub&r, &bSnom&r, &bCetoddle&r and &bBergmite&r brave the cold."
	]
	quest.71A151478B71A44B.title: "Snow Day"
	quest.71A25022F448B72E.quest_desc: [
		"Cook all seven Mochi flavors."
		""
		"With Mochi, vitamins and EV-reducing Berries you can shape any spread; the &6Training and Battling&r chapter covers EVs."
	]
	quest.71A25022F448B72E.title: "Mochi Master"
	quest.71AA4FF7118E8146.quest_desc: [
		"&6Price:&r &e8,000 CobbleDollars&r for one."
		""
		"Lengthens the duration of moves and Abilities that alter the terrain of the battlefield"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.71AA4FF7118E8146.quest_subtitle: "8,000 CD"
	quest.71AA4FF7118E8146.title: "Terrain Extender"
	quest.71AB2791CF385BCD.quest_desc: ["Summon all three beasts, then combine the &eRed&r, &eYellow&r and &eBlue Feathers&r into a &eRainbow Feather&r."]
	quest.71AB2791CF385BCD.title: "Every Color at Once"
	quest.71BE1F377BD36C80.quest_desc: [
		"Surround an &eElectrium-Z&r with four Thunder Stones to craft &ePikanium-Z&r."
		""
		"A Pikachu holding it turns Volt Tackle into Catastropika."
	]
	quest.71BE1F377BD36C80.title: "Catastrophe Incoming"
	quest.71BF38459176D91D.quest_desc: [
		"Pull a &ePoké Capsule&r from a Poké Gacha Machine."
		""
		"Right-click a capsule to crack it open. Poké Capsules hold everyday supplies: Berries, Mints, medicine and Poké Balls."
	]
	quest.71BF38459176D91D.title: "Gotcha!"
	quest.71CEEDF09C1C6C90.quest_desc: [
		"&6Price:&r &e400 CobbleDollars&r for one."
		""
		"1× catch rate"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.71CEEDF09C1C6C90.quest_subtitle: "400 CD"
	quest.71CEEDF09C1C6C90.title: "Citrine Ball"
	quest.71D7B2A62D30373E.quest_desc: [
		"&6Price:&r &e2,000 CobbleDollars&r for one."
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.71D7B2A62D30373E.quest_subtitle: "2,000 CD"
	quest.71D7B2A62D30373E.title: "Fighting Gem"
	quest.71D83900404525D6.quest_desc: [
		"&6Price:&r &e2,000 CobbleDollars&r for one."
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.71D83900404525D6.quest_subtitle: "2,000 CD"
	quest.71D83900404525D6.title: "Grass Gem"
	quest.71EB134B9309984D.quest_desc: [
		"Find a &eruined portal&r."
		""
		"Houndour and Charcadet are drawn to the Nether-scorched stone."
	]
	quest.71EB134B9309984D.title: "Portal to Nowhere"
	quest.71ECE9F08BF0624B.quest_desc: [
		"Sticks, &eRabbit Hide&r, &eString&r and a &eSlime Ball&r. Draw a &eSlingshot&r like a bow to fling blocks and items you carry."
		""
		"It can even throw buckets, which spill their contents where they land."
	]
	quest.71ECE9F08BF0624B.title: "Pocket Artillery"
	quest.72061DF6352CD4B7.quest_desc: [
		"Catch a Pokémon with a &eLevel Ball&r."
		""
		"&aSend out a high-level partner against a low-level target.&r"
	]
	quest.72061DF6352CD4B7.title: "Level Gap"
	quest.7216BA17C22A346E.quest_desc: [
		"Kill 10 &eSpiders&r."
		""
		"Spiders climb walls and are only hostile in the dark. They drop &eString&r and, when you kill them, &eSpider Eyes&r."
	]
	quest.7216BA17C22A346E.title: "Eight Legs"
	quest.7239958DDB1BBADA.quest_desc: [
		"&6Price:&r &e300 CobbleDollars&r for one."
		""
		"Restores 20 HP of a Pokémon whilst slightly reducing Friendship"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.7239958DDB1BBADA.quest_subtitle: "300 CD"
	quest.7239958DDB1BBADA.title: "Remedy"
	quest.723EBF5E3AB584BE.quest_desc: [
		"Craft an &eAnvil&r from 3 Blocks of Iron and 4 Iron Ingots."
		""
		"Join an item with an Enchanted Book or a second copy of itself to merge enchantments and repair it. You can rename things here too."
		"&cEach job makes the next one on that item pricier. At 40 levels the anvil refuses: Too Expensive!&r"
	]
	quest.723EBF5E3AB584BE.title: "Heavy Metal"
	quest.725A5891F1E089B2.quest_desc: [
		"Catch a &eSandile&r."
		""
		"It is common in the &6Desert&r: watch for it basking on the dunes."
	]
	quest.725A5891F1E089B2.title: "Desert Croc"
	quest.728EBBB0B3416C7C.quest_desc: [
		"&6Price:&r &e20,000 CobbleDollars&r for one."
		""
		"Increases the amount of experience earned by the holder in battle"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.728EBBB0B3416C7C.quest_subtitle: "20,000 CD"
	quest.728EBBB0B3416C7C.title: "Lucky Egg"
	quest.7296930D38A2B25A.quest_desc: ["Take an item from a Lootr &eitem frame&r. Structures with framed loot are converted, and so is the Elytra on End ships: everyone gets their own."]
	quest.7296930D38A2B25A.title: "Framed!"
	quest.729F0725DEC219FF.quest_desc: ["&dKyogre&r swims ultra-rarely deep in ocean water. Bring Ultra Balls, status moves and patience."]
	quest.729F0725DEC219FF.title: "Lord of the Seas"
	quest.72B90FFF8214DB11.quest_desc: [
		"Win a &eCharmander Pokédoll&r (the normal one) from the Plush-O-Matic with Fiery Yarn."
		""
		"Odds: more than half of all pulls, and every pull costs Yarn, so stock up on Type Gems first."
	]
	quest.72B90FFF8214DB11.title: "Plush Charmander"
	quest.72DBCBCCC9394100.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Boosts the power of the holder's Bug-type moves"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.72DBCBCCC9394100.quest_subtitle: "5,000 CD"
	quest.72DBCBCCC9394100.title: "Silver Powder"
	quest.72F6FC8CD75B167E.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Boosts the holder's Defense in Grassy terrain"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.72F6FC8CD75B167E.quest_subtitle: "5,000 CD"
	quest.72F6FC8CD75B167E.title: "Grassy Seed"
	quest.7333C33BF8363039.quest_desc: [
		"Blow the Fullmoon Whistle to call &dCresselia&r. The whistle works once, so pick your moment."
		""
		"&cCresselia has no model yet in this Cobblemon version, so it cannot be caught yet.&r"
	]
	quest.7333C33BF8363039.title: "Lunar Lullaby"
	quest.73353F36B1B9F3CE.quest_desc: [
		"&6Price:&r &e1,200 CobbleDollars&r for one."
		""
		"3.5× on Pokémon submerged in water"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.73353F36B1B9F3CE.quest_subtitle: "1,200 CD"
	quest.73353F36B1B9F3CE.title: "Dive Ball"
	quest.733EF313BAC27EEB.quest_desc: [
		"&eIron&r, &ePistons&r and &eRedstone&r around an &eUpgrade Base&r."
		""
		"Compacts items into their compressed versions, but only 2x2 recipes."
	]
	quest.733EF313BAC27EEB.title: "Compacting Upgrade"
	quest.73439ED214F312CE.quest_desc: [
		"Find a &eWater Stone&r."
		""
		"&6Ore:&r oceans, rivers and swamps, rarer in jungles, hot springs and tropical islands."
		"&6Evolves:&r Shellder, Staryu, Poliwhirl, Lombre, Panpour and Eevee."
	]
	quest.73439ED214F312CE.title: "Wet Stone"
	quest.736B27C0881BE318.quest_desc: [
		"Play the Azure Flute and a melody carries you to the &bHall of Origin&r."
		""
		"&cThe flute works once. Bring a strong, healed team before you play it.&r"
	]
	quest.736B27C0881BE318.title: "Where It All Began"
	quest.73780D6A42BF1205.quest_desc: [
		"Seven Wooden Slabs make a &eComposter&r: feed it spare plants and it slowly fills with &eBone Meal&r."
		""
		"Bone Meal speeds up crops, and it is the fertilizer in Cobblemon &eMulch&r."
	]
	quest.73780D6A42BF1205.title: "Waste Not"
	quest.737D8E032275BC2D.quest_desc: [
		"Pokémon hide in every river, lake and ocean. Turn a plain fishing rod into a &ePoké Rod&r and they start biting."
		""
		"This chapter covers rods, bait, lures, the rare bites and where they hide."
		""
		"&aClick the checkmark to cast off.&r"
	]
	quest.737D8E032275BC2D.quest_subtitle: "Patience is a virtue"
	quest.737D8E032275BC2D.title: "&lGone Fishing"
	quest.7397EF53264B9999.quest_desc: [
		"Beat all four of the Elite Four and the Champion accepts your challenge in the Kanto League. It is your old rival, &eTerry&r."
		""
		"Pheromosa, Metagross, Primal Groudon, Yveltal, Eternatus and a Ditto that copies your best. Heal up, plan your party, and take the title."
	]
	quest.7397EF53264B9999.quest_subtitle: "Champion Terry"
	quest.7397EF53264B9999.title: "&6Kanto Champion"
	quest.73B0C92B17D980D9.quest_desc: [
		"&ePillagers&r patrol the countryside and guard their outposts."
		""
		"Kill 10. The banner-carrying captains drop an &eOminous Bottle&r. Raids themselves are covered in Villagers and Raids."
	]
	quest.73B0C92B17D980D9.title: "Crossbow Crew"
	quest.73C3A8D6348E3D75.quest_desc: [
		"Put a &eHay Bale&r on an &eArmor Stand&r to craft a &eTarget Dummy&r."
		""
		"Hit it to see damage numbers and your damage per second, so you can compare weapons and enchantments. Your gear takes no durability damage from it."
		"&aTip:&r put a Carved Pumpkin on its head and it becomes a scarecrow that keeps animals away and stops monsters spawning nearby."
	]
	quest.73C3A8D6348E3D75.title: "Practice Makes Perfect"
	quest.73E536C29C6928A3.quest_desc: [
		"Find a &6Flower Forest&r."
		""
		"Roselia and Budew are common among the blooms, and a rare Togepi can toddle out of the flowers."
		"&oThe ultra-rare Shaymin is said to nap in fields like this one.&r"
	]
	quest.73E536C29C6928A3.title: "Petal Path"
	quest.73FB3F65222388EA.quest_desc: [
		"Craft a &eGrindstone&r: 2 Sticks, a Stone Slab and 2 Planks."
		""
		"Grinding strips every enchantment except curses. An Enchanted Book comes back as a plain Book."
		"&aIt is also the job site of the &eWeaponsmith&r villager.&r"
	]
	quest.73FB3F65222388EA.title: "Clean Slate"
	quest.740100A4456E7FEB.quest_desc: [
		"Every 20 to 40 minutes a sandstorm sweeps through the Lost Caves and rages for 2 to 10 minutes."
		""
		"Be there when one blows over."
	]
	quest.740100A4456E7FEB.title: "Weather the Storm"
	quest.741FCBBF4E1C07C2.quest_desc: [
		"&6Price:&r &e10,000 CobbleDollars&r for one."
		""
		"Grants 8 Sp. Atk EVs when gaining experience in battle"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.741FCBBF4E1C07C2.quest_subtitle: "10,000 CD"
	quest.741FCBBF4E1C07C2.title: "Power Lens"
	quest.742141DAF25347C5.quest_desc: [
		"A &eCandle&r on an &eIron Ingot&r makes a &eCandle Holder&r for walls, floors and ceilings."
		""
		"Colored versions use dyed candles."
	]
	quest.742141DAF25347C5.title: "Mood Lighting"
	quest.743AAE5C299C14FF.quest_desc: [
		"Collect the six EV-lowering Berries: &ePomeg&r, &eKelpsy&r, &eQualot&r, &eHondew&r, &eGrepa&r and &eTamato&r. Each lowers one stat's EVs by 10 and raises friendship."
		""
		"They only grow from &eBerry mutation&r: plant two different trees side by side (Sitrus next to Haban gives Pomeg). They are also what turns a PP Up into a vitamin."
	]
	quest.743AAE5C299C14FF.title: "Bitter Medicine"
	quest.743B001A26B39AFE.quest_desc: [
		"A &eCarved Pumpkin&r and a &eFurnace&r make the &eFurnace Spooka-lator&r."
		""
		"Right-click a furnace to give it a spooky makeover; sneak and right-click to cleanse it again. Purely cosmetic, entirely necessary."
	]
	quest.743B001A26B39AFE.title: "Spooky Season"
	quest.743D206C6ECFA3D7.quest_desc: [
		"&6Price:&r &e6,000 CobbleDollars&r for one."
		""
		"Evolves Seadra into Kingdra when held while trading"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.743D206C6ECFA3D7.quest_subtitle: "6,000 CD"
	quest.743D206C6ECFA3D7.title: "Dragon Scale"
	quest.744FBFD1F70DC36F.quest_desc: ["Register every possible move in the TM Machine. A true long-term project for dedicated move collectors."]
	quest.744FBFD1F70DC36F.title: "The Complete Repertoire"
	quest.7468ABDC3122AA49.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Boosts the holder's Sp. Def in Psychic terrain"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.7468ABDC3122AA49.quest_subtitle: "5,000 CD"
	quest.7468ABDC3122AA49.title: "Psychic Seed"
	quest.7470F46EE671B25C.quest_desc: [
		"&e4 Glass&r, &e2 Buckets&r, a &ePiston&r and a &eSticky Piston&r around an &eUpgrade Base&r."
		""
		"Pumps fluids between a Tank Upgrade and adjacent blocks."
	]
	quest.7470F46EE671B25C.title: "Pump Upgrade"
	quest.74A0FBFD3133CEFA.quest_desc: [
		"&6Price:&r &e600 CobbleDollars&r for one."
		""
		"Raises the Pokémon's Sp. Def EVs by 1"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.74A0FBFD3133CEFA.quest_subtitle: "600 CD"
	quest.74A0FBFD3133CEFA.title: "Clever Feather"
	quest.74A214F8CD2D65A0.quest_desc: [
		"Surround a PokéNav with &e7 Relic Coins&r and a &eGhost Gem&r to make the Gholdengo edition."
		""
		"Plain dyes recolor it too, and crafting a dyed PokéNav alone turns it back to the base look."
	]
	quest.74A214F8CD2D65A0.title: "Gold Standard"
	quest.74A58D2B1BA0729E.quest_desc: [
		"See a little better in the dark."
		""
		"&6Where to look:&r mineshaft chests, Ruined Portals, shipwreck treasure; rarely worn by skeletons."
	]
	quest.74A58D2B1BA0729E.title: "Night Vision Goggles"
	quest.74AFAB386827A110.quest_desc: [
		"Sail over a &6Deep Ocean&r."
		""
		"Wailmer swim below, and an ultra-rare Lapras may glide across the surface."
	]
	quest.74AFAB386827A110.title: "The Big Blue"
	quest.74C55823FBC909F6.quest_desc: [
		"&6Price:&r &e400 CobbleDollars&r for one."
		""
		"1× catch rate"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.74C55823FBC909F6.quest_subtitle: "400 CD"
	quest.74C55823FBC909F6.title: "Ancient Citrine Ball"
	quest.74C79616318399C6.quest_desc: [
		"Catch a Pokémon that is both &9Water&r and &6Ground&r."
		""
		"Ground cancels Water's Electric weakness completely, but Grass now hits for four times the damage."
	]
	quest.74C79616318399C6.title: "Mud Bath"
	quest.74DF27915DD78005.quest_desc: [
		"Your starter kit came with a &eHealing Machine&r. Place it, let it charge (about five minutes), then use it to restore your whole party."
		""
		"Village &ePoké Centers&r have one too. Fainted Pokémon cannot battle until they recover or are healed."
	]
	quest.74DF27915DD78005.title: "Healing Power"
	quest.7508D4623A92BEAF.quest_desc: [
		"Grow a &eLum Berry&r next to Figy, Wiki, Mago, Aguav or Iapapa to mutate a &eSitrus Berry&r."
		""
		"Sitrus restores a quarter of max HP when the holder drops below half: a staple held item."
	]
	quest.7508D4623A92BEAF.title: "Sitrus Squeeze"
	quest.751274B5453F4351.quest_desc: [
		"Catch (or evolve) a Pokémon that can carry you through water."
		""
		"&eLapras&r rides like a boat, &eMilotic&r and &eSharpedo&r leap like dolphins, and &eWailmer&r or &eWailord&r take you under like a submarine."
	]
	quest.751274B5453F4351.title: "Surf Is Up"
	quest.7519D6E9D90B5CD0.quest_desc: [
		"&6Price:&r &e400 CobbleDollars&r for one."
		""
		"Cures a Pokémon of all status conditions whilst slightly reducing friendship"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.7519D6E9D90B5CD0.quest_subtitle: "400 CD"
	quest.7519D6E9D90B5CD0.title: "Heal Powder"
	quest.751A10F2CD4DFEF0.quest_desc: [
		"&e4 Iron Ingots&r around a &eCopper Chest&r (or 8 around a basic one)."
		""
		"&e54 slots&r and &e2 upgrade slots&r."
	]
	quest.751A10F2CD4DFEF0.title: "Iron Chest"
	quest.751A3947F596F67A.quest_desc: [
		"Win &e25&r battles against trainers of any kind."
		""
		"Story trainers count, and so does every youngster, hiker and grunt you meet on the way."
	]
	quest.751A3947F596F67A.quest_subtitle: "25 trainer wins"
	quest.751A3947F596F67A.title: "Local Favourite"
	quest.7525A071FE742034.quest_desc: [
		"Charge a &eRaid Shard&r to &e100&r raid energy, then &eright-click&r it."
		""
		"It turns into a &eRaid Den Crystal&r you can place anywhere, such as right next to your base."
	]
	quest.7525A071FE742034.title: "A Den of Your Own"
	quest.753AC70E359A6DF5.quest_desc: [
		"Kill 50 &eZombies&r."
		""
		"The higher rungs of each ladder are about stamina. A good sword, armor and a well-lit base help."
	]
	quest.753AC70E359A6DF5.title: "Zombie Apocalypse"
	quest.75452352F2B882ED.quest_desc: [
		"Eight planks around an &eEmerald&r. Type a message of up to 32 characters into a &eSpeaker Block&r."
		""
		"Whenever it gets redstone power it broadcasts the message to every player within 64 blocks. Announce that the gym battle is starting!"
	]
	quest.75452352F2B882ED.title: "Now Hear This"
	quest.754814849EDA6F31.quest_desc: [
		"&6Price:&r &e1,200 CobbleDollars&r for one."
		""
		"Restores 120 HP of a Pokémon whilst slightly reducing Friendship"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.754814849EDA6F31.quest_subtitle: "1,200 CD"
	quest.754814849EDA6F31.title: "Superb Remedy"
	quest.754D9BB22CEFB542.quest_desc: [
		"Some Pokémon can carry you: send one out, sneak and interact with it, then pick &eRide&r."
		""
		"Mounts move in styles: &eStandard&r on land; &eBoat&r, &eDolphin&r or &eSubmarine&r in water; &eClassic&r, &eHover&r or &eRocket&r in the air. The &ePokédex&r has a &eRideable&r filter and a &eRide Stats&r page."
		""
		"&cStamina runs out, and you can only hop off once you are back on the ground.&r"
	]
	quest.754D9BB22CEFB542.title: "Saddle Not Required"
	quest.754EA61805FE4FD5.quest_desc: [
		"&6Price:&r &e600 CobbleDollars&r for one."
		""
		"Raises the Pokémon's Atk EVs by 1"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.754EA61805FE4FD5.quest_subtitle: "600 CD"
	quest.754EA61805FE4FD5.title: "Muscle Feather"
	quest.755C220BFB2148B3.quest_desc: [
		"Raise any Pokémon to &elevel 75&r."
		""
		"Wild Alphas of level 66 or higher drop the best reward bundle, Rare Candies included."
	]
	quest.755C220BFB2148B3.title: "Elite Training"
	quest.7565C0AAF5816C30.quest_desc: [
		"Catch 10 &eElectric&r-type Pokémon. Dual-type Pokémon count for both of their types."
		""
		"&6Strong against:&r Water, Flying"
	]
	quest.7565C0AAF5816C30.title: "Live Wires"
	quest.7580A2880F8CC8E4.quest_desc: [
		"&6Price:&r &e1,500 CobbleDollars&r for one."
		""
		"Halves damage taken from a supereffective Dragon-type attack"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.7580A2880F8CC8E4.quest_subtitle: "1,500 CD"
	quest.7580A2880F8CC8E4.title: "Haban Berry"
	quest.7583A0DD927B5300.quest_desc: ["Yellow Apricorn base: &e+2 Stamina, -1 Skill&r."]
	quest.7583A0DD927B5300.title: "Yellow Aprijuice"
	quest.758839C39E913204.quest_desc: ["Carry the Truth Bottle and the Ideals Bottle to the &bKyurem Cave&r in snowy lands and summon &dKyurem&r."]
	quest.758839C39E913204.title: "The Empty Husk"
	quest.75B1F530F435A7F1.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Changes a Pokémon's stats to be that of a Bold nature"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.75B1F530F435A7F1.quest_subtitle: "5,000 CD"
	quest.75B1F530F435A7F1.title: "Bold Mint"
	quest.75C6BBA956B744D0.quest_desc: [
		"&eNether Wart&r grows in the gardens of Better Nether Fortresses and turns up in their chests."
		""
		"Plant it on &eSoul Sand&r (the reward has some) to farm it. Almost every potion starts as an Awkward Potion brewed from Nether Wart."
	]
	quest.75C6BBA956B744D0.title: "Fortress Fungus"
	quest.75CB333B40BF4CE2.quest_desc: [
		"&e8 Diamonds&r around a &eGold Chest&r."
		""
		"&e108 slots&r and &e4 upgrade slots&r."
	]
	quest.75CB333B40BF4CE2.title: "Diamond Chest"
	quest.75DAEDD88607F1F9.quest_desc: [
		"Win, and the boss is yours to catch: &ehold a Poké Ball in your main hand&r and choose &eCatch&r. That ball becomes its home. Or choose &ePass&r."
		""
		"Either way you get a &eRaid Pouch&r of loot and a stack of &eCobbleDollars&r: 1,500 at tier 1, up to 15,000 at tier 5."
		""
		"&aThe whole party gets the same reward Pokémon, shiny and IVs included.&r"
	]
	quest.75DAEDD88607F1F9.title: "Catch or Pass"
	quest.75E161AF4D601C24.quest_desc: [
		"Find a &eshipwreck&r."
		""
		"Dhelmise drift around wrecks, and the map chest holds a buried treasure map."
	]
	quest.75E161AF4D601C24.title: "Abandon Ship"
	quest.75E5A99FCEAFCA0E.quest_desc: [
		"Craft an &eAlchemy Book&r from an Alchemy Bench and a Book."
		""
		"Use it to open the Alchemy Bench menu wherever you are."
	]
	quest.75E5A99FCEAFCA0E.title: "Alchemy Book"
	quest.75E5D0DBC53EC592.quest_desc: [
		"Find a &eThunder Stone&r."
		""
		"&6Ore:&r highlands, meadows and hills, rarer in jungles and plains."
		"&6Evolves:&r Pikachu, Magneton, Eelektrik, Tadbulb, Nosepass and Eevee."
	]
	quest.75E5D0DBC53EC592.title: "Bottled Lightning"
	quest.75E6A318D7D3A827.quest_desc: ["Use your &eWrench&r on any block to earn the advancement."]
	quest.75E6A318D7D3A827.title: "Engineer Gaming"
	quest.75F87A00387CB7AB.quest_desc: [
		"Use a Leaf Stone on Gloom, Weepinbell, Exeggcute, Nuzleaf or Pansage, or a Sun Stone on Gloom, Sunkern, Cottonee or Petilil. Gloom can go either way!"
		""
		"Hold the stone and use it on the Pokémon."
	]
	quest.75F87A00387CB7AB.title: "In Full Bloom"
	quest.760B9F44EE40D474.quest_desc: [
		"Three &eBowls&r (or teacups) and a &eWater Bucket&r or &eMilk&r brew 3 &eSinister Tea&r."
		""
		"Tea seasonings add effects when you drink it: a &ePoppy&r gives Night Vision, a &ePep-Up Flower&r Strength."
	]
	quest.760B9F44EE40D474.title: "Teatime"
	quest.760CF86BC4EC423A.quest_desc: [
		"Find a &eBetter Jungle Temple&r."
		""
		"Bronzor and Meditite live inside, and Hawlucha patrol the grounds."
	]
	quest.760CF86BC4EC423A.title: "Temple of the Jungle"
	quest.763DFC5DEF1776C8.quest_desc: [
		"Craft an &eEviolite&r: an &eEverstone&r surrounded by four Amethyst Shards. It boosts the holder's Defense and Sp. Def as long as it is not fully evolved."
		""
		"Geodude and Roggenrola sometimes drop an Everstone when knocked out."
	]
	quest.763DFC5DEF1776C8.title: "Not Done Growing"
	quest.766565EFA356113D.quest_desc: [
		"Mega Evolve a &eCharizard&r."
		""
		"Charizardite X and Charizardite Y give two very different Megas. Either one counts."
	]
	quest.766565EFA356113D.title: "Two Flavors of Fire"
	quest.766BBE2809589CE7.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Boosts the power of the holder's Dark-type moves"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.766BBE2809589CE7.quest_subtitle: "5,000 CD"
	quest.766BBE2809589CE7.title: "Black Glasses"
	quest.766BD743CF1730D2.quest_desc: [
		"Key item: &eRedstone Repeater&r."
		""
		"&a+&r Heat from burning fuel generates power."
		"&c-&r The furnace can no longer smelt."
	]
	quest.766BD743CF1730D2.title: "Augment: Generator"
	quest.766F3D343AAA814C.quest_desc: [
		"&6Price:&r &e1,500 CobbleDollars&r for one."
		""
		"Halves damage taken from a supereffective Grass-type attack"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.766F3D343AAA814C.quest_subtitle: "1,500 CD"
	quest.766F3D343AAA814C.title: "Rindo Berry"
	quest.767B16BA31044600.quest_desc: [
		"Sweets and treats: most of them need &eSugar&r, &eHoney Bottles&r or &eMilk&r."
		""
		"Several are evolution items: Sweets for &eMilcery&r, the Whipped Dream for &eSwirlix&r, and teacups for Poltchageist. The &cEvolution&r chapter covers those evolutions."
	]
	quest.767B16BA31044600.title: "Dessert Cart"
	quest.767B3B806E7B47F6.quest_desc: [
		"Catch a &eBagon&r."
		""
		"Search the dark, sheltered nooks of the &6Stony Spires&r, where it is a rare spawn."
		"&oOne day it will grow wings.&r"
	]
	quest.767B3B806E7B47F6.title: "Dreams of Flight"
	quest.76848121DE062928.quest_desc: [
		"&6FTB Ultimine&r"
		"Hold &e`&r (grave) while breaking a block to mine up to 64 connected blocks at once. Sneak while holding it to open the shape menu."
		"&cIt drains hunger fast.&r Eat before you clear a whole vein."
		""
		"Holding the key also strips logs with an axe, tills with a hoe and harvests crops with a right-click."
	]
	quest.76848121DE062928.title: "One Swing, Many Blocks"
	quest.76A369F094E2BA24.quest_desc: [
		"&eRedstone&r and &eString&r around an &eUpgrade Base&r."
		""
		"Controls which items hoppers and pipes may push into, or pull out of, a placed backpack."
	]
	quest.76A369F094E2BA24.title: "Filter Upgrade"
	quest.76AD346BED0EE978.quest_desc: [
		"Beaches, cliffs and open water."
		""
		"Many sea Pokémon spawn underwater or only on a fishing line, so bring a &ePoké Rod&r (see the &eFishing&r chapter)."
		"&aTip:&r fishing spawns change with the biome too, so cast a line in every sea you visit."
	]
	quest.76AD346BED0EE978.title: "Coasts and Seas"
	quest.76BC329EAD79EAFD.quest_desc: ["Right-click the Curry of Justice to lure &dKeldeo&r. The curry works once."]
	quest.76BC329EAD79EAFD.title: "The Young Sword"
	quest.76CE70E558C1CDDC.quest_desc: [
		"Find a &eLuna Henge&r, a stone circle in the savanna."
		""
		"Lunatone gather here at night."
	]
	quest.76CE70E558C1CDDC.title: "Moon Circle"
	quest.76E70E95113BF23B.quest_desc: [
		"Hold one of every furnace from Copper to Obsidian: &eCopper, Iron, Golden, Diamond, Emerald, Crystal&r and &eObsidian&r."
		""
		"&cAll seven are consumed&r by the next recipe, so craft spares if you are still using them."
	]
	quest.76E70E95113BF23B.title: "One of Each"
	quest.76E9E8EC7769A4BC.quest_desc: [
		"Catch your first &6shiny&r Pokémon."
		""
		"The base shiny rate is &e1 in 4,096&r. Long KO streaks on one species improve your odds, and chat announces every shiny spawn."
	]
	quest.76E9E8EC7769A4BC.title: "Lucky Color"
	quest.76EBDEC90E55E9B6.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Raises the Pokémon's HP EVs by 10"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.76EBDEC90E55E9B6.quest_subtitle: "5,000 CD"
	quest.76EBDEC90E55E9B6.title: "HP Up"
	quest.76EC360890BC7EDC.quest_desc: [
		"Win a &eBolt Armor Trim&r template from a Vault."
		""
		"Copy it with 7 Diamonds and a Block of Copper."
	]
	quest.76EC360890BC7EDC.title: "Bolt Trim"
	quest.76F4B5FF7D78EA6B.quest_desc: [
		"A fully grown Revival Herb also drops one or two &ePep-Up Flowers&r when harvested."
		""
		"They are an ingredient in Full Heal, so keep a few."
	]
	quest.76F4B5FF7D78EA6B.title: "Pep in Your Step"
	quest.7701EE1687C88FA8.quest_desc: [
		"Descend into a &6Volcanic Crater&r."
		""
		"Numel, Camerupt and Sizzlipede are common, with Turtonator less so."
		"&oGroudon, Entei and Heatran can all spawn here, ultra-rarely.&r"
	]
	quest.7701EE1687C88FA8.title: "Into the Crater"
	quest.77041193E1693389.quest_desc: [
		"This chapter is all about the thrill of the catch: big catch counts, odd hours, faraway places, rare starters, shinies and towering Alphas."
		""
		"Catch &e5&r Pokémon to get rolling. Your chosen starter counts as a catch, and catching in battle still earns your battling Pokémon some EXP and EVs."
	]
	quest.77041193E1693389.title: "&lGotta Catch 'Em All"
	quest.7721A102E17E167D.quest_desc: [
		"Explore a &6Taiga&r."
		""
		"Pineco hang in the spruces, Sneasel and Vulpix prowl the needles, and Rockruff roam the woods."
		"&oZacian, ultra-rare, has been spotted under the open sky.&r"
	]
	quest.7721A102E17E167D.title: "Pine Country"
	quest.772386D8A54B7473.quest_desc: [
		"Open 50 Lootr containers."
		""
		"Mineshafts, villages and ruins add up fast if you check every corner."
	]
	quest.772386D8A54B7473.title: "Seasoned Scavenger"
	quest.7734254BB83B4B9F.quest_desc: [
		"Stones, friendship, trades and a hundred evolutions: you have seen it all."
		""
		"Claim your reward once the evolve ladder, the Eeveelutions, a trade evolution and a friendship evolution are done."
	]
	quest.7734254BB83B4B9F.title: "&lMaster of Change"
	quest.7735CC2E8A9D20A3.quest_desc: [
		"&eLootr&r gives every player their own copy of each structure container. Your friend looted it first? Your loot is still inside."
		""
		"Unopened Lootr containers sparkle. Open your first Lootr chest."
	]
	quest.7735CC2E8A9D20A3.title: "Yours and Yours Alone"
	quest.7737537169230ED6.quest_desc: [
		"You stay invincible a little longer after taking a hit."
		""
		"&6Where to look:&r Bastion treasure rooms, Pillager Outposts, big Ocean Ruins, village temples."
	]
	quest.7737537169230ED6.title: "Cross Necklace"
	quest.7773278A8D0B2991.quest_desc: [
		"&6Price:&r &e15,000 CobbleDollars&r for one."
		""
		"Boosts the holder's Attack, but locks it into only using one move"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.7773278A8D0B2991.quest_subtitle: "15,000 CD"
	quest.7773278A8D0B2991.title: "Choice Band"
	quest.7774910A8D6E38DD.quest_desc: [
		"Craft a &eLevel Ball&r: 2 Pink Apricorns, 1 Red Apricorn and 1 Black Apricorn around an &eIron Ingot&r."
		""
		"&6Catch rate:&r 1x to 4x, rising the more your Pokémon out-levels the target."
	]
	quest.7774910A8D6E38DD.title: "Level Ball"
	quest.7775FD03DE5CE526.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Boosts the holder's friendship gains"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.7775FD03DE5CE526.quest_subtitle: "5,000 CD"
	quest.7775FD03DE5CE526.title: "Soothe Bell"
	quest.777787252F5E7696.quest_desc: [
		"Catch a Pokémon with a &eLuxury Ball&r."
		""
		"&aCatch a future friendship evolver in one.&r"
	]
	quest.777787252F5E7696.title: "Living in Luxury"
	quest.77B5D8C4AF5C7D4D.quest_desc: [
		"Find a &eDawn Stone Ore&r: it generates under mountain peaks and sky-high biomes, more rarely under floral, glacial and hilly ones."
		"Look at the regular stone variant, found above the deepslate layer."
		""
		"&aPokémon tip:&r this stone evolves Pokémon such as Kirlia and Snorunt."
	]
	quest.77B5D8C4AF5C7D4D.title: "Dawn Stone Ore"
	quest.77C2566BF6CA2E74.quest_desc: [
		"Brew a &eLum Berry&r into a &eMax Potion&r: the &eFull Restore&r heals all HP and every status problem."
		""
		"Lum Berries mutate from an Oran tree planted beside a Cheri, Chesto, Pecha, Rawst or Aspear tree."
	]
	quest.77C2566BF6CA2E74.title: "Full Service"
	quest.77C50E9F82787BA2.quest_desc: ["Four Honey Bottles make a &eHoney Block&r: sticky, slow to walk on and handy in redstone builds."]
	quest.77C50E9F82787BA2.title: "Sticky Situation"
	quest.77CFFDC0D313DC09.quest_desc: [
		"Craft &eSoggy Yarn&r from 3 Wool, 3 String and a Water Gem."
		""
		"In the Plush-O-Matic it gives dolls of the Squirtle line, Shellder, Cloyster, Wooper, Quagsire, Wailmer, Wailord, Luvdisc and Kyogre."
		""
		"&aType Gems come from ruins, Type Gem clusters (Fossils and Geology chapter) or a Hard Stone plus the matching type-resist Berry (see the recipe viewer).&r"
	]
	quest.77CFFDC0D313DC09.title: "Soggy Yarn"
	quest.77DB9FA199B2DCCC.quest_desc: [
		"Reel in 10 Water-type Pokémon."
		""
		"Freshwater, oceans and flooded caves all stock different Water types."
	]
	quest.77DB9FA199B2DCCC.title: "Making Waves"
	quest.77FD0AEE75737683.quest_desc: [
		"&6Price:&r &e1,000 CobbleDollars&r for one."
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.77FD0AEE75737683.quest_subtitle: "1,000 CD"
	quest.77FD0AEE75737683.title: "Grepa Berry"
	quest.7831B3E28CA22E65.quest_desc: [
		"Trainers roam this world: youngsters on the routes, hikers in the hills, Team Rocket in the badlands and much tougher faces further out."
		""
		"Walk up to a trainer and &eright-click&r them to battle. Win once to set out on the road."
		""
		"&aThis chapter follows the Kanto story in the order the trainers demand: eight badges, the Elite Four, then the Champion.&r"
	]
	quest.7831B3E28CA22E65.quest_subtitle: "Your first trainer battle"
	quest.7831B3E28CA22E65.title: "&6Road to Champion"
	quest.784964656551F975.quest_desc: [
		"&eYellow Dye&r, &eRed Dye&r, &ePaper&r and a &eFurnace&r make &eFurnace Wrapping Papers&r."
		""
		"Right-click a furnace to wrap it as a gift; sneak and right-click to unwrap it. &oBut won't the wrappings catch fire?&r"
	]
	quest.784964656551F975.title: "Wrapped With Care"
	quest.7853B72D3EA8EECB.quest_desc: [
		"One of the new Megas from Pokémon Legends: Z-A."
		"Lets &eDarkrai&r Mega Evolve."
		""
		"Recipe: raw Mega Stone, a Diamond, an &eEye of Ender&r and two &eNetherite Ingots&r."
	]
	quest.7853B72D3EA8EECB.title: "Darkranite"
	quest.78B7F3560055AEF5.quest_desc: [
		"Attack faster."
		""
		"&6Where to look:&r buried treasure, shipwreck treasure, village weaponsmiths, brushing Trail Ruins."
	]
	quest.78B7F3560055AEF5.title: "Feral Claws"
	quest.78E77EA34E0EE2CC.quest_desc: [
		"&6Sophisticated Backpacks&r are wearable chests that grow with you: bigger tiers, and upgrades that pick up, sort, cook and even heal your Pokémon."
		""
		"Every backpack and every upgrade begins with &eLeather&r and &eString&r. Five Leather and eight String cover your first Backpack and your first Upgrade Base."
		"&aPress &eB&a to open a backpack you are wearing.&r"
	]
	quest.78E77EA34E0EE2CC.title: "&lPack Animal"
	quest.78F687192DCCB4AE.quest_desc: [
		"&6The End&r is the last dimension: a floating island ruled by the &5Ender Dragon&r, and beyond it End Cities with Shulkers and the Elytra."
		""
		"The way there starts with the two halves of an Eye of Ender: &eEnder Pearls&r (Endermen drop them, Piglins barter them for gold) and &eBlaze Powder&r ground from your Blaze Rods."
	]
	quest.78F687192DCCB4AE.title: "&5Eyes on the End"
	quest.79267805EB28B31C.quest_desc: ["Find an &eOld Sea Map&r in jungle temple chests, Liberty Island chests or Thalic chests. Carry it to the Mew pedestal on the &bFinal Island&r; &dMew&r appears and leaves a &eTuft of Mew Hair&r."]
	quest.79267805EB28B31C.title: "Fluff on the Final Island"
	quest.792B88231A7A8C87.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Changes a Pokémon's stats to be that of a Calm nature"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.792B88231A7A8C87.quest_subtitle: "5,000 CD"
	quest.792B88231A7A8C87.title: "Calm Mint"
	quest.7941E4A0F86906C7.quest_desc: [
		"Cast your Poké Rod into water and wait. When the bobber dips, use the rod again to reel in: a hooked Pokémon is pulled out of the water as a wild Pokémon to battle and catch."
		""
		"Not every catch is a Pokémon; you will reel in items too."
	]
	quest.7941E4A0F86906C7.title: "Fish On!"
	quest.795E653B778376AE.quest_desc: [
		"Craft a &eNest Ball&r: 2 Yellow Apricorns and 2 Green Apricorns around an &eIron Ingot&r."
		""
		"&6Catch rate:&r 1x to 4x, rising the further the target is below level 30."
	]
	quest.795E653B778376AE.title: "Nest Ball"
	quest.796387D862FCE6B1.quest_desc: [
		"Your Pokédex keeps two lists: species you have &eSeen&r and species you have &eCaught&r. Scanning a new species registers it; owning one marks it caught."
		""
		"This chapter rewards filling both lists, researching every region and building the tools that find what you are missing."
	]
	quest.796387D862FCE6B1.title: "&lPokédex Research"
	quest.7992FF5F5D49D340.quest_desc: [
		"Find and enter the &bTurnback Cave&r with the Arc Phone's tracking. Its trial rooms and chests hold &eGriseous Keys&r, which open the cave's vaults."
		""
		"Its portal room holds a &eDistortion Portal&r."
	]
	quest.7992FF5F5D49D340.title: "Turnback Cave"
	quest.79A64EB236AF2750.quest_desc: [
		"Cows drop &eLeather&r when defeated. A bred herd means you never run short."
		""
		"&aPokémon tie-in:&r Leather goes into the &eFocus Sash&r, &eFocus Band&r and &eMuscle Band&r; the &eAssault Vest&r and &eHeavy-Duty Boots&r use it via leather armor."
	]
	quest.79A64EB236AF2750.title: "Tanned Hides"
	quest.79BF5FD98F92C742.quest_desc: [
		"Defeat a &cRaid Captain&r: the raider wearing the striped Illager banner. Captains lead pillager patrols."
		""
		"A Pillager captain always drops an &eOminous Bottle&r."
	]
	quest.79BF5FD98F92C742.title: "Off With the Banner"
	quest.79C6DB899495A6EA.quest_desc: [
		"Supplementaries lets a &eGrindstone&r strip the magic from an &eEnchanted Golden Apple&r, leaving a plain Golden Apple."
		""
		"&cThis destroys one of the rarest foods in the game.&r Only for the truly committed. Two plain apples as a consolation prize."
	]
	quest.79C6DB899495A6EA.title: "Why Would You Do That?!"
	quest.79DF832B6EB73034.quest_desc: [
		"&6Price:&r &e1,500 CobbleDollars&r for one."
		""
		"Halves damage taken from a supereffective Electric-type attack"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.79DF832B6EB73034.quest_subtitle: "1,500 CD"
	quest.79DF832B6EB73034.title: "Wacan Berry"
	quest.7A01B78A6B09068B.quest_desc: ["The Registeel, Regirock, Regice, Regieleki and Regidrago Tablets form the &eTitan Key&r, which opens the Regigigas room."]
	quest.7A01B78A6B09068B.title: "Key of the Colossus"
	quest.7A1051714293B038.quest_desc: [
		"&6Price:&r &e2,000 CobbleDollars&r for one."
		""
		"Raises the Pokémon's Attack EVs by 4"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.7A1051714293B038.quest_subtitle: "2,000 CD"
	quest.7A1051714293B038.title: "Muscle Mochi"
	quest.7A20328AB98EC06E.quest_desc: [
		"Add &eGunpowder&r to the Potion of Weakness to brew a &eSplash Potion of Weakness&r."
		""
		"Splash potions are thrown and hit everything nearby, friend or foe. This one weakens a zombie villager before you cure it."
		"&aVoltorb and Electrode can drop Gunpowder.&r"
	]
	quest.7A20328AB98EC06E.title: "Make a Splash"
	quest.7A35579139F97A30.quest_desc: [
		"Craft a &eDisplay Case&r from 3 Glass, 2 Smooth Stone Slabs and a Wool block."
		""
		"Put an item inside to show it off: your first Poké Ball, a rare fossil, a Master Ball you are too scared to use."
	]
	quest.7A35579139F97A30.title: "Show and Tell"
	quest.7A36BD537CB2C372.quest_desc: [
		"&6Price:&r &e400 CobbleDollars&r for one."
		""
		"1× catch rate"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.7A36BD537CB2C372.quest_subtitle: "400 CD"
	quest.7A36BD537CB2C372.title: "Ancient Ivory Ball"
	quest.7A36DB9C6963E3C2.quest_desc: [
		"Smith a Poké Rod with a &eMaster Ball&r. Wasteful? Perhaps."
		""
		"But only a Master Rod can hook a rare variant of &eWhiscash&r."
	]
	quest.7A36DB9C6963E3C2.title: "Overkill Angler"
	quest.7A59F7010546C084.quest_desc: [
		"&eMagma Cubes&r drop &eMagma Cream&r, or craft it from Blaze Powder and a Slimeball."
		""
		"Four make a &eMagma Block&r, the heart of Cobblemon's &eMagmarizer&r: trade a Magmar holding one and it evolves into &eMagmortar&r. Magma Cream also bakes &eLava Cookies&r in the Campfire Pot."
	]
	quest.7A59F7010546C084.title: "Molten Goo"
	quest.7A66F2F2C835CE10.quest_desc: [
		"Blue fire, bone pillars, &eGhasts&r and &eSkeletons&r. Soul Sand slows you down."
		""
		"&6Pokémon:&r Duskull and Litwick after dark, plus Cubone, Salandit and Bramblin."
		"&aTip:&r a Cubone that reaches level 28 while in the Nether evolves into &eAlolan Marowak&r."
	]
	quest.7A66F2F2C835CE10.title: "Soul Sand Valley"
	quest.7A6B7012338014B4.quest_desc: [
		"Mega Evolve &e50&r times, with Mega Charizard, Lucario, Gengar and Garchomp already on your record."
		""
		"Meteorites, Key Stones, a pile of Mega Stones and a team that shines brighter than ever: you have mastered Mega Evolution."
	]
	quest.7A6B7012338014B4.title: "&6Mega Master"
	quest.7A74DD6A6DCC6D67.quest_desc: [
		"Register &e200&r species as &eSeen&r (caught species count too)."
		""
		"Scan everything you meet. A seen entry tells you a species exists here, even before you catch one."
	]
	quest.7A74DD6A6DCC6D67.title: "Keen Observer"
	quest.7A85ED37192BD686.quest_desc: [
		"Use an appliance on a &eRotom&r to send it inside and change its form."
		""
		"A &eRotom Catalogue&r lets it hop in and out of every device."
	]
	quest.7A85ED37192BD686.title: "Ghost in the Machine"
	quest.7A9E6D0C0601A3AE.quest_desc: [
		"Each dragon kill opens an &eEnd Gateway&r near the edge of the central island."
		""
		"Throw an &eEnder Pearl&r into it to warp to the outer islands, where the End Cities are."
	]
	quest.7A9E6D0C0601A3AE.title: "Beyond the Gateway"
	quest.7AC70ACF5BD874EF.quest_desc: ["Five &eNightmare Essences&r make the &eNewmoon Whistle&r."]
	quest.7AC70ACF5BD874EF.title: "Midnight Melody"
	quest.7AD02A45E654D7CD.quest_desc: [
		"Feed Gimmighoul &eRelic Coins&r to fill its Coin Stash: a Coin counts 1, a Pouch 9 and a Sack 81."
		""
		"At 999 coins, level it up and it evolves into Gholdengo."
	]
	quest.7AD02A45E654D7CD.title: "Coin Collector"
	quest.7AD6412DF9596DFD.quest_desc: [
		"&6Price:&r &e4,000 CobbleDollars&r for one."
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.7AD6412DF9596DFD.quest_subtitle: "4,000 CD"
	quest.7AD6412DF9596DFD.title: "Absorb Bulb"
	quest.7ADBB74A806DA513.quest_desc: [
		"Register &e50&r species as &eCaught&r in your Pokédex."
		""
		"Each species needs only one catch. After that, go looking for something new."
	]
	quest.7ADBB74A806DA513.title: "Half a Hundred"
	quest.7ADD0B7695BEC789.quest_desc: [
		"Craft a &eDusk Ball&r: 2 Green Apricorns and 2 Black Apricorns around a &eGold Ingot&r."
		""
		"&6Catch rate:&r 3.5x at light level 0, 3x at light level 1 to 7."
	]
	quest.7ADD0B7695BEC789.title: "Dusk Ball"
	quest.7ADEC75046DAD7C3.quest_desc: [
		"&6Individual Values (IVs)&r are a Pokémon's natural talent: a number from 0 to 31 in each stat, shown on the summary's &eStats&r page."
		""
		"IVs cannot be trained like EVs, but they can be overridden: &eIV Candies&r nudge a stat by 1 and Cobblemon Utility+ &eBottle Caps&r &oHyper Train&r a stat to 31."
	]
	quest.7ADEC75046DAD7C3.title: "Individual Values"
	quest.7AF13EB33DB88ECA.quest_desc: [
		"&6Price:&r &e3,000 CobbleDollars&r for one."
		""
		"Evolves certain Pokémon"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.7AF13EB33DB88ECA.quest_subtitle: "3,000 CD"
	quest.7AF13EB33DB88ECA.title: "Shiny Stone"
	quest.7AF2D912AC864A7D.quest_desc: ["Restore the &eDisc of the First Song&r from 9 fragments found in monument chests, and collect four music discs: &ePigstep&r, &e5&r, &eCreator&r and &eRelic&r."]
	quest.7AF2D912AC864A7D.title: "Songs for the Amphitheater"
	quest.7AF8B353D88E1C9C.quest_desc: [
		"&eDeepslate&r and a &eFlint&r make a &eDeepslate Shard&r."
		""
		"Insert it into a Warp Plate to &elock&r that plate."
	]
	quest.7AF8B353D88E1C9C.title: "Lock and Key"
	quest.7B0B10F543859ABF.quest_desc: [
		"&eTrainer May&r travels the &eplains&r and &eforests&r and challenges holders of the Soul Badge."
		""
		"Solrock, Breloom, Manectric, Relicanth, Flygon and Blaziken."
	]
	quest.7B0B10F543859ABF.quest_subtitle: "Trainer May"
	quest.7B0B10F543859ABF.title: "A Different Path"
	quest.7B0D8B5385A9696F.quest_desc: [
		"&6Price:&r &e6,000 CobbleDollars&r for one."
		""
		"Evolves Counterfeit Poltchageist into Unremarkable Sinistcha"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.7B0D8B5385A9696F.quest_subtitle: "6,000 CD"
	quest.7B0D8B5385A9696F.title: "Unremarkable Teacup"
	quest.7B0F5F6EFE346A95.quest_desc: [
		"YUNG's &eLost Caves&r lie beneath the hottest, driest lands, such as deserts."
		""
		"Ancient sandstone, prickly vines and cacti fill them. &cThe vines hurt.&r"
	]
	quest.7B0F5F6EFE346A95.title: "Lost Caves"
	quest.7B37A41BD66279E3.quest_desc: [
		"Four String and a Slime Ball make two &eLeads&r."
		""
		"Leash animals and walk them home to your pens, or tie them to a fence post."
	]
	quest.7B37A41BD66279E3.title: "Leading the Herd"
	quest.7B556E6EC675A6A5.quest_desc: [
		"&6Price:&r &e8,000 CobbleDollars&r for one."
		""
		"Provides a chance for the holder to survive a potential KO attack, leaving it with 1 HP"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.7B556E6EC675A6A5.quest_subtitle: "8,000 CD"
	quest.7B556E6EC675A6A5.title: "Focus Band"
	quest.7B61B28BD83C3EFA.quest_desc: [
		"Your own waystone, linked warp plates, a scroll for emergencies, a bed in your pack and wings beneath you."
		""
		"No corner of the region is far away anymore."
	]
	quest.7B61B28BD83C3EFA.title: "Seasoned Traveler"
	quest.7B6F4C945AB710CD.quest_desc: [
		"&eGhasts&r float over open lava and shoot exploding fireballs."
		""
		"Kill 5. A bow helps, and a cobblestone shield wall even more. They drop &eGhast Tears&r and Gunpowder."
	]
	quest.7B6F4C945AB710CD.title: "Crybabies"
	quest.7B707CB3D8E55AC3.quest_desc: [
		"&eCave Spiders&r only come from spawners. Trial Chambers have them in their small-mob spawners. They are small, fast and poisonous."
		""
		"Kill 10. Milk cures the poison."
	]
	quest.7B707CB3D8E55AC3.title: "Chamber Crawlers"
	quest.7B726A44FF764EA5.quest_desc: [
		"Mine &eAncient Rubble&r in deepslate (Y -64 to 0) and smelt it into &eGolem Scrap&r; Turnback Cave chests hold some too."
		""
		"Four Golem Scrap and a type gem make 4 Golem Ingots: Rock, Ice, Steel, Electric or Dragon Gem for the matching ingot."
	]
	quest.7B726A44FF764EA5.title: "Titan Metal"
	quest.7B927463452241B8.quest_desc: ["Buy a &eBeast Ball&r for 15,000, the dearest ball a merchant will sell short of a Master Ball."]
	quest.7B927463452241B8.title: "Big Ticket"
	quest.7B9D0AE26AB77A63.quest_desc: [
		"Craft a &eWarped Fungus on a Stick&r from a Fishing Rod and a &eWarped Fungus&r."
		""
		"Striders follow it like pigs follow a carrot. Grab the Saddle reward for the next step."
	]
	quest.7B9D0AE26AB77A63.title: "Carrot on a Stick, Nether Edition"
	quest.7BE524583C2C32D8.quest_desc: [
		"Craft the &eReins of Unity&r from four String, a Ghost Gem, an Ice Gem and Lapis Lazuli."
		""
		"They unite Calyrex with Glastrier or Spectrier. See the Legends and Myths chapter for the Pokémon."
	]
	quest.7BE524583C2C32D8.title: "King and Steed"
	quest.7C08BFCD8B2DD547.quest_desc: [
		"&6Price:&r &e4,000 CobbleDollars&r for one."
		""
		"The holder's weight is halved"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.7C08BFCD8B2DD547.quest_subtitle: "4,000 CD"
	quest.7C08BFCD8B2DD547.title: "Float Stone"
	quest.7C0D97630124F74B.quest_desc: [
		"A Mint is three leaves of the stat to raise plus one leaf of the stat to lower."
		""
		"&eAdamant&r (3 Red, 1 Cyan), &eModest&r (3 Cyan, 1 Red), &eJolly&r (3 Green, 1 Cyan) and &eTimid&r (3 Green, 1 Red) are the classics."
	]
	quest.7C0D97630124F74B.title: "Nature Lessons"
	quest.7C50EFCABD5F2E48.quest_desc: [
		"You have beaten five-star bosses, mastered Cheers and grown a den of your own."
		""
		"Finish the job: win &e50&r raids in total."
	]
	quest.7C50EFCABD5F2E48.quest_subtitle: "50 raid wins"
	quest.7C50EFCABD5F2E48.title: "&6Raid Champion"
	quest.7C54F9DCD8498B5B.quest_desc: [
		"Craft a &eRelic Coin Pouch&r from 9 Relic Coins."
		""
		"&aThe Bank pays 475 for a pouch but only 450 for nine loose coins.&r A placed pouch drops itself, so it is safe as decoration."
	]
	quest.7C54F9DCD8498B5B.title: "Coin Purse"
	quest.7C563CB9805641D9.quest_desc: [
		"Get a &eGigantic Charmander Pokédoll&r."
		""
		"Craft it from 4 Charmander Pokédolls around a Wool block, or get lucky: about 1 Fiery Yarn pull in 4 drops one directly."
	]
	quest.7C563CB9805641D9.title: "Supersized"
	quest.7C823CD4B18C404E.quest_desc: [
		"A &eSlime Ball&r and &ePaper&r make a roll of &ePacking Tape&r."
		""
		"Use it on a Sophisticated chest or barrel to pack it, so it drops as one item with its contents still inside when broken. Each roll has limited uses."
	]
	quest.7C823CD4B18C404E.title: "Moving Day"
	quest.7C87DA4C472CA654.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Changes a Pokémon's stats to be that of a Brave nature"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.7C87DA4C472CA654.quest_subtitle: "5,000 CD"
	quest.7C87DA4C472CA654.title: "Brave Mint"
	quest.7CC88341742CFF57.quest_desc: [
		"Revive a &eshiny&r Fossil Pokémon."
		""
		"The machine rolls its own shiny chance: 1 in 100 here, far better than the 1 in 4,096 of the wild."
	]
	quest.7CC88341742CFF57.title: "Polished Bones"
	quest.7CDD72ED7360CB34.quest_desc: [
		"&6Price:&r &e2,500 CobbleDollars&r for one."
		""
		"Holder gains the Focus Energy effect when at 1/4 max HP or less"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.7CDD72ED7360CB34.quest_subtitle: "2,500 CD"
	quest.7CDD72ED7360CB34.title: "Lansat Berry"
	quest.7CE1CBE74BB8E62C.quest_desc: [
		"A fatal hit teleports you somewhere safe instead of killing you. It is used up."
		""
		"&6Where to look:&r End City chests, Woodland Mansions."
	]
	quest.7CE1CBE74BB8E62C.title: "Chorus Totem"
	quest.7CF9A29DCC290496.quest_desc: [
		"Use a Glass Bottle on a full Bee Nest or Beehive for a &eHoney Bottle&r."
		""
		"&aPokémon tie-in:&r Honey is smeared on &eSaccharine&r logs to lure Pokémon, goes into &ePoké Snacks&r, Mochi and Sweets, and you can bottle it straight from a &eVespiquen&r."
	]
	quest.7CF9A29DCC290496.title: "Sweet as Honey"
	quest.7CFD62390ECADFCB.quest_desc: [
		"Three wooden slabs make two &eItem Shelves&r. Hang one on a wall and right-click it with an item to show it off."
		""
		"A row of shelves makes a great Poké Ball collection wall."
	]
	quest.7CFD62390ECADFCB.title: "On Display"
	quest.7D277F3B15B92CAA.quest_desc: [
		"&6Price:&r &e8,000 CobbleDollars&r for one."
		""
		"Heals the holder for a fraction of damage dealt every turn"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.7D277F3B15B92CAA.quest_subtitle: "8,000 CD"
	quest.7D277F3B15B92CAA.title: "Shell Bell"
	quest.7D312E965713A113.quest_desc: [
		"Set foot on the &6Mirage Isles&r."
		""
		"Foongus and Amoonguss are common, but the real prize is ultra-rare: all four Tapus, Koko, Lele, Bulu and Fini, can spawn here."
	]
	quest.7D312E965713A113.title: "Was It a Mirage?"
	quest.7D38F46A942E4910.quest_desc: [
		"Catch &e5&r Pokémon in beaches, shores or oceans biomes (Terralith variants count)."
		""
		"&bShellos&r, &bSandygast&r and &bWiglett&r dig in the sand; &bKrabby&r, &bStaryu&r and &bBinacle&r hug the coast."
	]
	quest.7D38F46A942E4910.title: "Beachcomber"
	quest.7D41A4A281476730.quest_desc: [
		"Get a &eKoban Coin&r from a Meowth, or find one in a structure chest."
		""
		"Only one machine accepts them."
	]
	quest.7D41A4A281476730.title: "Koban Coin"
	quest.7D48D4271F2E2630.quest_desc: [
		"&6Price:&r &e600 CobbleDollars&r for one."
		""
		"Raises the Pokémon's Defense EVs by 1"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.7D48D4271F2E2630.quest_subtitle: "600 CD"
	quest.7D48D4271F2E2630.title: "Resist Feather"
	quest.7D49C78A9908AFF6.quest_desc: [
		"Craft any species &eMega Stone&r."
		""
		"Most classic stones put a raw Mega Stone in the middle, two Iron Ingots at the sides, a Diamond below and a themed held item on top."
		""
		"Each stone works for one species only. Hover over a stone to see which Pokémon it belongs to."
	]
	quest.7D49C78A9908AFF6.title: "Stone Cold Power"
	quest.7D5CA9C366C2BA66.quest_desc: [
		"&6Price:&r &e3,000 CobbleDollars&r for one."
		""
		"Has no effect"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.7D5CA9C366C2BA66.quest_subtitle: "3,000 CD"
	quest.7D5CA9C366C2BA66.title: "Smoke Ball"
	quest.7D780E4B36E1F544.quest_desc: ["Craft &eGolden Caps&r: all six Silver Caps, two Gold Blocks and a White Mint Leaf make a pair. One cap Hyper Trains every IV to 31 at once."]
	quest.7D780E4B36E1F544.title: "Golden Standard"
	quest.7D849E1B446851A6.quest_desc: [
		"Catch one &4Fighting&r, one &dPsychic&r and one &8Dark&r Pokémon."
		""
		"Psychic outthinks Fighting, Dark is immune to Psychic, and Fighting punches through Dark."
	]
	quest.7D849E1B446851A6.title: "Mind Games"
	quest.7D8ACF8D3AA2C8F3.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Extends the duration of Sandstorm"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.7D8ACF8D3AA2C8F3.quest_subtitle: "5,000 CD"
	quest.7D8ACF8D3AA2C8F3.title: "Smooth Rock"
	quest.7DA4B7A2AE27D85E.quest_desc: [
		"Let a &eTotem of Undying&r save your life."
		""
		"It only works while held, so swap it into your offhand before a risky fight."
	]
	quest.7DA4B7A2AE27D85E.title: "Not Today"
	quest.7DB61CE6E0F1C4FF.quest_desc: [
		"&6Price:&r &e1,200 CobbleDollars&r for one."
		""
		"Increases a Pokémon's experience by 3000 Exp. Points"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.7DB61CE6E0F1C4FF.quest_subtitle: "1,200 CD"
	quest.7DB61CE6E0F1C4FF.title: "Exp. Candy M"
	quest.7DBC39421EF86B3B.quest_desc: [
		"&6Surviving the first night&r"
		"Dig into a hillside or wall yourself in, then light every corner."
		""
		"Wild Pokémon keep their own hours: Hoothoot and Gastly only come out at night."
		"Open the &eFTB Chunks: Claim Manager&r button in your inventory to claim the chunks your base sits in."
	]
	quest.7DBC39421EF86B3B.title: "Home Sweet Hole"
	quest.7DEDB07DE7C53A44.quest_desc: [
		"&6Price:&r &e15,000 CobbleDollars&r for one."
		""
		"Boosts the holder's Speed, but locks it into only using one move"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.7DEDB07DE7C53A44.quest_subtitle: "15,000 CD"
	quest.7DEDB07DE7C53A44.title: "Choice Scarf"
	quest.7DF0213FFB8EE627.quest_desc: [
		"A &ePortal Scroll&r opens a &eWarp Portal&r to the waystone you choose. It needs open space to fit the portal."
		""
		"Recipe: 4 &eAmethyst Shards&r, an &eInk Sac&r, an &eEnder Pearl&r and 3 &ePaper&r make 3."
	]
	quest.7DF0213FFB8EE627.title: "Now You Are Thinking With Portals"
	quest.7E0654FC6AF59263.quest_desc: [
		"Craft &ePlain Yarn&r from 3 Wool, 3 String and a Normal Gem."
		""
		"In the Plush-O-Matic it gives dolls of Eevee, Sentret, Furret, Happiny, Lickitung, Munchlax and Snorlax."
		""
		"&aType Gems come from ruins, Type Gem clusters (Fossils and Geology chapter) or a Hard Stone plus the matching type-resist Berry (see the recipe viewer).&r"
	]
	quest.7E0654FC6AF59263.title: "Plain Yarn"
	quest.7E15E0CF6DB3DA3D.quest_desc: [
		"Defeat 25 wild &2Bug&r-type Pokémon in battle."
		""
		"&6Weak to:&r Fire, Flying, Rock"
		"&cResists:&r Fighting, Grass, Ground"
	]
	quest.7E15E0CF6DB3DA3D.title: "Pest Control"
	quest.7E3E180AB13329D9.quest_desc: [
		"Set a &eType Gem Block&r (crafted from 4 Type Gems) so it touches a Deepslate Crystal Core."
		""
		"The core's energy grows Type Gem clusters on it over time. Break them for gems of that type."
	]
	quest.7E3E180AB13329D9.title: "They're Minerals!"
	quest.7E4F5637B29A360E.quest_desc: [
		"NPC trainers are good practice, but the real test is another player."
		""
		"Challenge a friend to a battle and &ewin&r it. Only a victory against another player counts here."
	]
	quest.7E4F5637B29A360E.quest_subtitle: "Player versus player"
	quest.7E4F5637B29A360E.title: "Rival Showdown"
	quest.7E7856D7A1CA755C.quest_desc: [
		"&6Price:&r &e300 CobbleDollars&r for one."
		""
		"Holder is cured if it is burned"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.7E7856D7A1CA755C.quest_subtitle: "300 CD"
	quest.7E7856D7A1CA755C.title: "Rawst Berry"
	quest.7E7F00F6E6DB7D56.quest_desc: [
		"An &eIron Ingot&r and four &eIron Nuggets&r make a &eBubble Blower&r."
		""
		"Combine it with &eSoap&r in a crafting grid to fill it (one bar lasts a long time), then hold use to blow streams of bubbles."
	]
	quest.7E7F00F6E6DB7D56.title: "Bubble Trouble"
	quest.7E8B5F7C2E25D2D0.quest_desc: [
		"Catch 10 &dFairy&r-type Pokémon. Dual-type Pokémon count for both of their types."
		""
		"&6Strong against:&r Fighting, Dragon, Dark"
	]
	quest.7E8B5F7C2E25D2D0.title: "Fairy Tale"
	quest.7E8EABE431E06B6D.quest_desc: [
		"&6Price:&r &e6,000 CobbleDollars&r for one."
		""
		"Evolves Magmar into Magmortar when held while trading"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.7E8EABE431E06B6D.quest_subtitle: "6,000 CD"
	quest.7E8EABE431E06B6D.title: "Magmarizer"
	quest.7E99CBF10F69EC33.quest_desc: [
		"Planks, slabs and a &eRedstone Torch&r again, in a different shape."
		""
		"Limited Barrels I to IV hold only one to four kinds of item, but each slot has a big stack-size multiplier. Perfect for bulk Cobblestone, Apricorns or Berries."
	]
	quest.7E99CBF10F69EC33.title: "Limited Barrel"
	quest.7EA909ACE8ADC427.quest_desc: [
		"Wear the Tera Orb and choose &eTerastallize&r in battle."
		""
		"Your Pokémon takes on its Tera Type for the rest of the battle and its moves of that type hit harder. One Terastallization per battle."
	]
	quest.7EA909ACE8ADC427.title: "Crown Jewel"
	quest.7EE9FCA87E0873FA.quest_desc: [
		"&6Price:&r &e6,000 CobbleDollars&r for one."
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.7EE9FCA87E0873FA.quest_subtitle: "6,000 CD"
	quest.7EE9FCA87E0873FA.title: "Deep Sea Scale"
	quest.7EF64500377F8F94.quest_desc: [
		"Catch any Paldea starter."
		""
		"&bSprigatito&r in flowery and magical biomes, &bFuecoco&r in badlands, &bQuaxly&r near rivers."
	]
	quest.7EF64500377F8F94.title: "Paldean Picnic"
	quest.7EF6529F47821B45.quest_desc: [
		"&6Price:&r &e6,000 CobbleDollars&r for one."
		""
		"Evolves Charcadet into Ceruledge"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.7EF6529F47821B45.quest_subtitle: "6,000 CD"
	quest.7EF6529F47821B45.title: "Malicious Armor"
	quest.7EF7C74795D10B10.quest_desc: [
		"&6Price:&r &e750 CobbleDollars&r for one."
		""
		"1.5×, flies further"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.7EF7C74795D10B10.quest_subtitle: "750 CD"
	quest.7EF7C74795D10B10.title: "Ancient Wing Ball"
	quest.7F17C1F1A3D2EB4A.quest_desc: [
		"After Giovanni, &eRival Terry&r is back on the &eplains&r with a stronger team: Staraptor, Electivire, Darmanitan, Jumpluff and Blastoise."
		""
		"Beat him again."
	]
	quest.7F17C1F1A3D2EB4A.quest_subtitle: "Rival Terry"
	quest.7F17C1F1A3D2EB4A.title: "Good Terms?"
	quest.7F1BC07AEC41BAA6.quest_desc: [
		"Craft an &eAncient Origin Ball&r: 4 Origin Ingots around the Red Chain."
		""
		"&cCrafting uses up the Red Chain, so summon Dialga and Palkia first.&r"
	]
	quest.7F1BC07AEC41BAA6.title: "Before the Master Ball"
	quest.7F2C42CFDFB28A42.quest_desc: ["Obtain a &eTotem of Undying&r. Evokers drop them, and Bell Tower chests may hold one."]
	quest.7F2C42CFDFB28A42.title: "Fallen Heroes"
	quest.7F35FD897E768DFC.quest_desc: [
		"Shapes tell you what a quest is: a &6gear&r opens a chapter, a big &6octagon&r is its finale, &6hexagons&r mark milestones and places, &6hearts&r are rare finds and &6squares&r are notes like this one."
		""
		"In the book, scroll to zoom and drag to move the view. Pin a quest to keep its progress on screen while you play."
		""
		"&aClaim All skips reward crates (random rolls and pick-one choices): open those one at a time.&r"
	]
	quest.7F35FD897E768DFC.title: "Reading the Book"
	quest.7F4BE54D44FC2E71.quest_desc: [
		"Catch any Alola starter."
		""
		"&bRowlet&r in forests and taigas, &bLitten&r in jungles, &bPopplio&r along coasts."
	]
	quest.7F4BE54D44FC2E71.title: "Island Challengers"
	quest.7F4EBD118F60914F.quest_desc: [
		"Drink much faster and eat a little faster."
		""
		"&6Where to look:&r brushing Desert Wells, mineshaft chests, buried treasure; rarely worn by skeletons."
	]
	quest.7F4EBD118F60914F.title: "Plastic Drinking Hat"
	quest.7F657AFA028C8DAB.quest_desc: [
		"Obtain one of every Berry in Cobblemon."
		""
		"Work through the mutation pairs from the quests above, and keep planting. A true botanist's badge of honor."
	]
	quest.7F657AFA028C8DAB.title: "Oops, All Berries!"
	quest.7F6B1F85B6B377C6.quest_desc: [
		"Hot, wet and crowded: jungles and swamps are packed with spawns."
		""
		"Expect &eGrass&r-, &eBug&r- and &eWater&r-types, plus a surprising number of fighters in the bamboo."
		"&aTip:&r some swamp Pokémon, like Surskit, spawn on the water surface."
	]
	quest.7F6B1F85B6B377C6.title: "Jungles and Swamps"
	quest.7F752C4B6F17873E.quest_desc: [
		"Catch &e10&r Pokémon."
		""
		"Weaken a wild Pokémon first: low HP and status conditions both raise your odds."
	]
	quest.7F752C4B6F17873E.title: "Pocket Monsters"
	quest.7F9A9B6B853B1565.quest_desc: [
		"&6Price:&r &e4,000 CobbleDollars&r for one."
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.7F9A9B6B853B1565.quest_subtitle: "4,000 CD"
	quest.7F9A9B6B853B1565.title: "Cell Battery"
	quest.7FC8C52902D44B31.quest_desc: [
		"Scan &e250&r Pokémon with your Pokédex."
		""
		"The scanner reaches Pokémon up to &e10&r blocks away and registers species you have not met yet."
	]
	quest.7FC8C52902D44B31.title: "Data Hoarder"
	quest.7FDCD326BE4A3DBD.quest_desc: [
		"Win a &cRaid&r: survive every wave of Pillagers, Vindicators, Witches, Ravagers and Evokers."
		""
		"Victory grants &eHero of the Village&r: villagers drop their prices and some hand you gifts."
		"&aRing the village bell to reveal stragglers, and let your Iron Golems take the front line.&r"
	]
	quest.7FDCD326BE4A3DBD.title: "Hero of the Village"
	quest.7FE05C599975F982.quest_desc: [
		"&6Price:&r &e600 CobbleDollars&r for one."
		""
		"1×, fully restores HP, PP, and status conditions upon capture"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.7FE05C599975F982.quest_subtitle: "600 CD"
	quest.7FE05C599975F982.title: "Heal Ball"
	quest.7FF4BDC279E16C01.quest_desc: [
		"Dojo villages in the &bDyna Plains&r hold a &bGrand Dojo&r (carry a Black Belt and the Arc Phone tracks it). Beat &dMustard&r there and he entrusts you with a &dKubfu&r."
		""
		"&aThe masters of the Towers of Darkness and Water reward the Scrolls that evolve Kubfu into Urshifu.&r"
	]
	quest.7FF4BDC279E16C01.title: "Dojo Apprentice"
