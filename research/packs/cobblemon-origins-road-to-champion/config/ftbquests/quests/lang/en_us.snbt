	quest.07E716206F4A2876.title: "Razor Fang"
	quest.07F905EF6279F37E.quest_desc: [
		"Lets you swim through the air for a few seconds, then it needs to recharge."
		""
		"&6Where to look:&r Ancient City chests, End City chests."
	]
	quest.07F905EF6279F37E.title: "Helium Flamingo"
	quest.080BE66AD08383E1.quest_desc: [
		"Use any &eEXP Candy&r (or a &eRare Candy&r) on a Pokémon."
		""
		"Quest rewards hand out plenty, and you can cook &eEXP Candy XS&r from &eSculk&r and &eHoneycomb&r in a &eCampfire Pot&r (see the &aCooking&r chapter)."
	]
	quest.080BE66AD08383E1.title: "Candy Time"
	quest.082534465FFA1E0E.quest_desc: [
		"&6Price:&r &e4,000 CobbleDollars&r for one."
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
