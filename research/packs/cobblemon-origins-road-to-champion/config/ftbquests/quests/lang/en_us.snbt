	quest.09BF94A3ACB39210.title: "Salac Berry"
	quest.09E494585D72170F.quest_desc: [
		"The &6Wishing Weald&r grows in spooky biomes such as the Dark Forest."
		""
		"At its center sits a &eWishing Star&r crystal, with Suspicious Gravel and a gilded chest nearby."
	]
	quest.09E494585D72170F.title: "Into the Weald"
	quest.09EACF0380CF67E4.quest_desc: [
		"Put a &eNetherite Ingot&r in a &eStonecutter&r to cut two &eBlank-Z&r crystals."
		""
		"Every type Z-Crystal starts as a Blank-Z."
	]
	quest.09EACF0380CF67E4.title: "Clean Slate"
	quest.09F28A4855F74344.quest_desc: [
		"Find a &eIce Stone&r."
		""
		"&6Ore:&r ice spikes, frozen peaks, snowy forests, snowy taigas and tundra, rarer in any freezing biome."
		"&6Evolves:&r Alolan Vulpix, Alolan Sandshrew, Crabrawler, Cetoddle and Eevee."
	]
	quest.09F28A4855F74344.title: "Cold Snap"
	quest.09F6A256A4C95A52.quest_desc: ["Level Rockruff to 25. During the day it becomes Midday Lycanroc, at night Midnight Lycanroc."]
	quest.09F6A256A4C95A52.title: "Day and Night"
	quest.0A04D294A06670B8.quest_desc: [
		"Hold each classic Mega Stone at least once: a raw Mega Stone plus all 46 species stones. They do not all need to be in your inventory at the same time."
		""
		"REI lists every recipe. Cobblemon Loot Plus also hides Mega Stones in structure chests."
	]
	quest.0A04D294A06670B8.title: "Gem Hoarder"
