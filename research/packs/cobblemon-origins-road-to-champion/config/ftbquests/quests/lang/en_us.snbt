	file.0000000000000001.title: "Cobblemon Origins"
	quest.0003337DF16A4D1D.quest_desc: [
		"&6Price:&r &e2,500 CobbleDollars&r for one."
		""
		"Raises holder's Defense by 1 stage when at 1/4 max HP or less"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.0003337DF16A4D1D.quest_subtitle: "2,500 CD"
	quest.0003337DF16A4D1D.title: "Ganlon Berry"
	quest.00102E83242BB5D9.quest_desc: [
		"Craft a &ePokéNav&r: 4 Copper Ingots, an Iron Ingot, a Diamond, Redstone, an Electirizer and an &eUpgrade&r."
		""
		"It lists every Pokémon that can spawn around you, by rarity and chance. Its finder ranks nearby Pokémon by perfect IVs, Hidden Ability, Egg Move and shininess, then an arrow tracks the one you pick."
	]
	quest.00102E83242BB5D9.title: "PokéNav"
	quest.00125AADF6937610.quest_desc: [
		"Red fungus trees, &eHoglins&r and &ePiglins&r. Hoglins avoid &eWarped Fungus&r, Nether Portals and Respawn Anchors."
		""
		"&6Pokémon:&r Larvesta, Lechonk, Paras, Spoink, Toedscool and, at night, Morelull."
		"Leader Blaine's Cinnabar Gym can generate in both fungus forests."
	]
	quest.00125AADF6937610.title: "Crimson Forest"
	quest.00750B7CB9637F0E.quest_desc: [
		"&6Super effective&r moves deal double damage, &6not very effective&r moves deal half, and an &6immune&r Pokémon takes nothing."
		""
		"Against a dual-type Pokémon the multipliers stack: two weaknesses mean four times the damage, while a weakness and a resistance cancel out."
		"&aTip:&r the six triad quests each teach one corner of the type chart."
	]
	quest.00750B7CB9637F0E.title: "Super Effective!"
	quest.009307E351246C99.quest_desc: [
		"Use the Love Letter and &dEnamorus&r appears."
		""
		"&aA letter used by someone other than its writer has a better shiny chance. Trade letters with friends!&r"
	]
	quest.009307E351246C99.title: "Love Is in the Air"
	quest.0095C7375756D6D8.quest_desc: [
		"&6Wins pay off:&r every trainer you beat pays &eCobbleDollars&r and drops a prize."
		""
		"&6One win each:&r a trainer you have beaten will not battle you again. Wandering trainers come and go, so take them on when you meet them."
		""
		"&6Story order:&r gym leaders, rivals and Team Rocket only accept a challenge once you have beaten the trainer before them. If one refuses, they tell you why."
	]
	quest.0095C7375756D6D8.title: "Trainer Etiquette"
	quest.00A60E45C926FBC2.quest_desc: [
		"&e8 Glass&r around an &eUpgrade Base&r."
		""
		"Trades some inventory space for fluid storage. The Pump upgrades below need it."
	]
	quest.00A60E45C926FBC2.title: "Tank Upgrade"
	quest.00AB0DE01EB9F33D.quest_desc: ["Gain &e500 levels&r in total across all of your Pokémon. Every level any of them gains adds to the count."]
	quest.00AB0DE01EB9F33D.title: "Level Grinder"
	quest.00AF881A0CDC01AF.quest_desc: [
		"Find an &6Orchid Swamp&r."
		""
		"Tadbulb and Croagunk are common in the muck."
		"&oThe mythical Pecharunt is an ultra-rare swamp spawn.&r"
	]
	quest.00AF881A0CDC01AF.title: "Swamp Orchids"
	quest.00B3147F93D97037.quest_desc: [
		"You have tracked down all ten evolution stone ores."
		""
		"Pick the stone your team needs most."
	]
	quest.00B3147F93D97037.title: "Stone Prospector"
	quest.00D9D0BE49155766.quest_desc: ["Find &bSnowpoint Temple&r on the snowy plains. Carry Golem Scrap and the Arc Phone tracks it."]
	quest.00D9D0BE49155766.title: "Snowpoint Temple"
	quest.00EE5868D21AD04C.quest_desc: [
		"Find a &eDusk Stone Ore&r: it generates under spooky biomes and taigas, more rarely under swamps."
		"Look at the regular stone variant, found above the deepslate layer."
		""
		"&aPokémon tip:&r this stone evolves Pokémon such as Murkrow, Misdreavus and Lampent."
	]
	quest.00EE5868D21AD04C.title: "Dusk Stone Ore"
	quest.011F29D47DCF3D3E.quest_desc: [
		"Use a Thunder Stone on Pikachu, Magneton, Eelektrik, Tadbulb or Nosepass, or an Ice Stone on Crabrawler or Cetoddle."
		""
		"Hold the stone and use it on the Pokémon."
	]
	quest.011F29D47DCF3D3E.title: "Storm Front"
	quest.012D89EC6D33ABA0.quest_desc: [
		"&eIron&r, &ePistons&r and &eRedstone&r around a &eStorage Upgrade Base&r."
		""
		"Compacts items into their compressed versions as they arrive (2x2 recipes only)."
	]
	quest.012D89EC6D33ABA0.title: "Compacting Upgrade"
	quest.0136F9CB870CB1CB.quest_desc: [
		"Battles here show far more than vanilla Cobblemon. Hover a move to see its &eestimated damage range and KO chance&r; the HUD also shows type icons, stat changes, weather, terrain, entry hazards and a speed comparison."
		""
		"Press &eJ&r to open the full &ebattle log&r."
	]
	quest.0136F9CB870CB1CB.title: "Read the Battlefield"
	quest.0149D43ECD7A70AE.quest_desc: [
		"Charizard's second Mega Stone, for Mega Charizard Y."
		""
		"Same frame as Charizardite X, topped with a &eCharcoal Stick&r instead."
	]
	quest.0149D43ECD7A70AE.title: "Charizardite Y"
	quest.014BA0DD8A756475.quest_desc: [
		"&e4 Sticks&r, &e2 Planks&r, &e2 Trapdoors&r and a &eChest&r make &e6 cables&r."
		""
		"Carries the network across long distances. One Inventory Connector must be somewhere in the network."
	]
	quest.014BA0DD8A756475.title: "Inventory Cable"
	quest.0154AED378F50AC0.quest_desc: [
		"Win &e50&r battles against trainers of any kind."
		""
		"Story trainers count, and so does every youngster, hiker and grunt you meet on the way."
	]
	quest.0154AED378F50AC0.quest_subtitle: "50 trainer wins"
	quest.0154AED378F50AC0.title: "Known on Every Route"
	quest.0166023CCE0D8F0F.quest_desc: [
		"Collect 8 &eNautilus Shells&r. Fishing can reel them up as treasure."
		""
		"&aOmanyte and Omastar drop a shell when you beat them.&r"
	]
	quest.0166023CCE0D8F0F.title: "Shell Collector"
	quest.016B810FB4A87D77.quest_desc: ["Craft a &eDefense Silver Cap&r: four Iron Ingots, two Diamonds and three &eBlue Mint Leaves&r. It Hyper Trains the Defense IV to 31."]
	quest.016B810FB4A87D77.title: "Defense Silver Cap"
	quest.01784DFEFA16414A.quest_desc: [
		"Use a Link Cable on a Shelmet while a Karrablast is in your party and it becomes Accelgor."
		""
		"Shelmet drops its &eShell Helmet&r when it evolves this way. Use the helmet on Karrablast to get Escavalier (helmets also come from gacha capsules), or trade the two for each other."
	]
	quest.01784DFEFA16414A.title: "Swap Shells"
	quest.01789218EA1A8F4E.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Extends the duration of Snow or Hail"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.01789218EA1A8F4E.quest_subtitle: "5,000 CD"
	quest.01789218EA1A8F4E.title: "Icy Rock"
	quest.0196DA4138AA5545.quest_desc: [
		"Each Golem Key is a type gem plus 4 matching Golem Ingots."
		"The Rock, Ice and Steel Keys open the Regirock, Regice and Registeel rooms; the Electric and Dragon Keys belong to the Regieleki and Regidrago room."
	]
	quest.0196DA4138AA5545.title: "Five Keys, Five Rooms"
	quest.019757B01E3C641E.quest_desc: [
		"Hit a Ghast fireball back at the Ghast and kill it with its own shot."
		""
		"Swing or shoot at the fireball just before it reaches you."
	]
	quest.019757B01E3C641E.title: "Return to Sender"
	quest.01A24E66FBFB4E1B.quest_desc: [
		"Cut a Tera Orb in a &eStonecutter&r for five &eStellar Tera Shards&r. Defeated Pokémon very rarely drop them too."
		""
		"Stellar shards also craft Keystones (Mega Evolution chapter) and Sparkling Stones."
	]
	quest.01A24E66FBFB4E1B.title: "Starry Bits"
	quest.01C564F4A70C6999.quest_desc: ["&dRayquaza&r rests ultra-rarely on the highest mountain peaks. Bring Ultra Balls, status moves and patience."]
	quest.01C564F4A70C6999.title: "Lord of the Sky"
	quest.01E03DF783D36367.quest_desc: [
		"&6Price:&r &e750 CobbleDollars&r for one."
		""
		"1.5× catch rate"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.01E03DF783D36367.quest_subtitle: "750 CD"
	quest.01E03DF783D36367.title: "Great Ball"
	quest.01F8AB68FC158B4C.quest_desc: [
		"&eTier 1&r with &e6 Iron Ingots&r and &e2 Blocks of Iron&r."
		""
		"Every slot holds &e4x&r as many stacks. Chests, barrels and shulker boxes take up to &e2&r stack upgrades each."
	]
	quest.01F8AB68FC158B4C.title: "Stack Upgrade Tier 2"
	quest.01FD2A86A3B3C67C.quest_desc: ["Fill a bucket with &eShadow Ichor&r from the Thalic Well in the Plains of Death and pour it into a Cauldron. Add the &eShadowy Cowl&r (Thalic chests) and the &eOld Fighter's Towel&r (dojo trainers) to draw out &dMarshadow&r."]
	quest.01FD2A86A3B3C67C.title: "Lurking in Shadow"
	quest.020A848FB27B533C.quest_desc: [
		"Defeat 25 wild &fNormal&r-type Pokémon in battle."
		""
		"&6Weak to:&r Fighting"
		"&cImmune to:&r Ghost"
	]
	quest.020A848FB27B533C.title: "Plain Sailing"
	quest.021CA27CCA867E91.quest_desc: [
		"Craft a &eMega Bracelet&r: five Iron Ingots, a Diamond, two White Apricorns and your Keystone."
		""
		"Other Apricorn colors make colored bracelets, and any Key Stone accessory counts for this quest."
		""
		"Wear it in the &eMega Slot&r of the accessories screen (&eH&r)."
	]
	quest.021CA27CCA867E91.title: "Wrist Upgrade"
	quest.02683F342DF851FA.quest_desc: [
		"Catch an &eEevee&r. It can evolve into eight different Pokémon, more than any other."
		""
		"Five use a stone, three need high friendship. You will want several Eevee!"
	]
	quest.02683F342DF851FA.title: "Eight Ways to Grow"
	quest.029AF040D375896E.quest_desc: [
		"&6Price:&r &e6,000 CobbleDollars&r for one."
		""
		"Boosts the power of the holder's punching moves and prevents them from triggering contact with the target"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.029AF040D375896E.quest_subtitle: "6,000 CD"
	quest.029AF040D375896E.title: "Punching Glove"
	quest.02AFE4FBFA8BF5A0.quest_desc: ["Craft any Rotom appliance: the Fan, Fridge, Mow, Oven or Wash Unit. Each has its own recipe in REI."]
	quest.02AFE4FBFA8BF5A0.title: "Plug and Play"
	quest.02B570A0385B7DF7.quest_desc: [
		"Reel in a &eFeebas&r. They only bite in &eslime chunks&r, anywhere in the Overworld away from oceans and coasts, and more often on a lured rod."
		""
		"Traded while holding a &ePrism Scale&r, it evolves into Milotic."
	]
	quest.02B570A0385B7DF7.title: "Ugly Duckling"
	quest.02C2190D72CFD775.quest_desc: [
		"Gather &e15 Bookshelves&r."
		""
		"Ring the table with them two blocks out (one block gap), at table height or one higher. Fifteen is the cap and unlocks level 30 offers."
		"&cKeep the gap clear: a solid block between shelf and table cuts the power.&r"
	]
	quest.02C2190D72CFD775.title: "The Full Library"
	quest.02C7E244B2B04958.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Boosts the holder's Sp. Def in Misty terrain"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.02C7E244B2B04958.quest_subtitle: "5,000 CD"
	quest.02C7E244B2B04958.title: "Misty Seed"
	quest.02D213534266CCCE.quest_desc: [
		"&eMedicinal Leeks&r float on fresh water in rivers and lakes (not in frozen, coastal or ocean biomes)."
		""
		"Leeks are the base of medicinal brews, and a Farfetch'd or Sirfetch'd holding one lands more critical hits. Grows in Spring and Autumn."
	]
	quest.02D213534266CCCE.title: "Medicinal Leek"
	quest.02E2CA29838664E7.quest_desc: [
		"Defeat a &cRavager&r. These charging beasts first show up in the third wave of a raid."
		""
		"Every Ravager drops a &eSaddle&r."
	]
	quest.02E2CA29838664E7.title: "Beast of Burden"
	quest.02E5C70D04C91A70.quest_desc: [
		"Defeat 25 wild &8Dark&r-type Pokémon in battle."
		""
		"&6Weak to:&r Bug, Fairy, Fighting"
		"&cResists:&r Dark, Ghost"
		"&cImmune to:&r Psychic"
	]
	quest.02E5C70D04C91A70.title: "Dawn Patrol"
	quest.02F1A64980F52960.quest_desc: [
		"&e8 Logs&r around a &eStorage Upgrade Base&r."
		""
		"Every slot holds &e2x&r as many stacks. Chests, barrels and shulker boxes take up to &e2&r stack upgrades each. A copper &eTier 1+&r (3x) sits between Tier 1 and 2."
	]
	quest.02F1A64980F52960.title: "Stack Upgrade Tier 1"
	quest.0308F2DAB031D685.quest_desc: [
		"The minimap is &eXaero's Minimap&r: &eF6&r opens its settings, &eU&r lists your waypoints and &eInsert&r creates a new one."
		""
		"Press &eM&r for &eXaero's World Map&r: nearby Pokémon show up on it with their own icons, and so do your land claims. Claim land with the &eFTB Chunks: Claim Manager&r button in your inventory: up to 500 chunks and 25 force-loaded. In claimed chunks only you and your allies can break or use blocks, and explosions are switched off."
	]
	quest.0308F2DAB031D685.title: "Maps and Waypoints"
	quest.0318B63484197A57.quest_desc: ["Find a &eWard&r armor trim template in an Ancient City chest in the Deep Dark."]
	quest.0318B63484197A57.title: "Ward Trim"
	quest.031DBAA6060511FC.quest_desc: [
		"Five &eIron Ingots&r, two planks, &eRedstone&r and your &eSlingshot&r build a &eCannon&r (a Dispenser and an extra plank can stand in for the slingshot and redstone)."
		""
		"Load it with &eGunpowder&r as fuel and something to shoot (it fires almost anything), sit in to aim, then fire. Add one to a boat for a cannon boat."
	]
	quest.031DBAA6060511FC.title: "Fire in the Hole"
	quest.03300D108F3A8EC4.quest_desc: [
		"Saddle a &eStrider&r and steer it with your Warped Fungus on a Stick."
		""
		"Striders walk across lava oceans, so the scariest crossings in the Nether become a stroll."
	]
	quest.03300D108F3A8EC4.title: "Lava Taxi"
	quest.034FD776505BB394.quest_desc: [
