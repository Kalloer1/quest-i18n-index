	quest.539C1E2AAD530D7C.title: "Shock Pendant"
	quest.53ADAAB205A8E1C7.quest_desc: ["Craft a &eWooden Cap&r (Cobblemon Utility+): Planks, Logs and three Mint Leaves of any colour. It &orandomizes&r a Pokémon's Hyper Trained IVs. Cheap, but a gamble."]
	quest.53ADAAB205A8E1C7.title: "Bottle Cap Roulette"
	quest.53BF64F9D875134F.quest_desc: [
		"Craft &eGrassy Yarn&r from 3 Wool, 3 String and a Grass or Bug Gem."
		""
		"In the Plush-O-Matic it gives dolls of the Bulbasaur line, Treecko, Rowlet, the Smoliv line, Bellossom, Tropius, Trevenant and Calyrex."
		""
		"&aType Gems come from ruins, Type Gem clusters (Fossils and Geology chapter) or a Hard Stone plus the matching type-resist Berry (see the recipe viewer).&r"
	]
	quest.53BF64F9D875134F.title: "Grassy Yarn"
	quest.53C611C50226E432.quest_desc: [
		"Kill one of every hostile mob in the game, from Endermites and Silverfish to Evokers, Vexes, the Ender Dragon and the Wither."
		""
