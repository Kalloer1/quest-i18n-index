	quest.0624A3575D4F5074.quest_desc: [
		"Every gacha machine eats one kind of currency. Hold it and right-click the machine to pull."
		""
		"Poké Gacha Machines and the Item Printer take &eRelic Coins&r or any &eGacha Coin&r, the Cram-O-Matic takes &eApricorns&r, the Rocket Prize Master takes &eKoban Coins&r, the Plush-O-Matic takes &eYarn&r and the Strange Crystallized Machine takes &eDiamonds&r."
		""
		"Sometimes a bonus prize drops too. After a pull the machine needs a short rest before the next one."
	]
	quest.0624A3575D4F5074.title: "How Gacha Works"
	quest.062DC3DDC119D152.quest_desc: [
		"Find a &eRelic Coin&r."
		""
		"Brush the Suspicious Sand and Gravel of Cobblemon ruins: Relic Coins are a common find there. Naturally generated &eRelic Coin Pouches&r burst into 2 to 9 coins when broken, natural &eSacks&r into 20 to 64."
	]
	quest.062DC3DDC119D152.title: "Ancient Currency"
	quest.065037272F2B8A3C.quest_desc: [
		"&9Supplementaries&r fills the world with handy blocks and gadgets: rope and pulleys, jars and sacks, redstone contraptions, slingshots and cannons, soap, globes and much more."
		""
		"Each row of this chapter is its own toolbox. Pick whichever looks fun; nothing here is locked behind anything else for long."
		""
		"&aTip:&r every recipe is in &eREI&r, so look one up whenever a quest has you stumped."
	]
	quest.065037272F2B8A3C.quest_subtitle: "A little bit of everything"
	quest.065037272F2B8A3C.title: "&lWelcome to Supplementaries"
	quest.065B20B8D363820C.quest_desc: [
		"Brew a &2Potion of the Turtle Master&r: Awkward Potion + a &eTurtle Shell&r (5 Turtle Scutes; baby turtles shed a scute as they grow up)."
