		""
		"&6Weak to:&r Ground, Psychic"
		"&cResists:&r Bug, Fairy, Fighting, Grass, Poison"
	]
	quest.415F2C09D8393CBD.title: "Antidote"
	quest.4161504B5FF515C0.quest_desc: [
		"Catch &e25 shiny Pokémon&r."
		""
		"At 1 in 4,096 per spawn, every shiny is earned. Spawn notifications in chat help you spot them."
	]
	quest.4161504B5FF515C0.title: "Shiny Hunter Elite"
	quest.41910B8792BB0C2B.quest_desc: [
		"&6Price:&r &e2,500 CobbleDollars&r for one."
		""
		"Holder's next move has 1.2x accuracy when at 1/4 max HP or less"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.41910B8792BB0C2B.quest_subtitle: "2,500 CD"
	quest.41910B8792BB0C2B.title: "Micle Berry"
	quest.41A825434C84F635.quest_desc: [
		"&6Price:&r &e12,000 CobbleDollars&r for 10."
		""
		"Increases a Pokémon's experience by 3000 Exp. Points"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.41A825434C84F635.quest_subtitle: "12,000 CD"
	quest.41A825434C84F635.title: "Exp. Candy M x10"
	quest.41B9C7A90CA6B282.quest_desc: [
		"Craft a &eLuxury Ball&r: 2 Black Apricorns, 1 Red Apricorn and 1 White Apricorn around a &eGold Ingot&r."
		""
		"&6Catch rate:&r 1x, and the Pokémon gains Friendship twice as fast."
	]
	quest.41B9C7A90CA6B282.title: "Luxury Ball"
	quest.41C9F9892FC199D3.quest_desc: [
		"Find an Explorify &eblack spiral&r in the Nether, where bastions generate."
		""
		"&cBlaze spawners guard it, but its treasure room uses bastion loot.&r"
	]
	quest.41C9F9892FC199D3.title: "Spiral of Shadows"
	quest.41D72536D077C26B.quest_desc: [
		"Pull a &eMaster Capsule&r from a Poké Gacha Machine."
		""
		"Master Capsules can hold EXP Candy XL, an Exp. Share, Dream and Beast Balls."
	]
	quest.41D72536D077C26B.title: "Master Capsule"
	quest.41DA729835737AA4.quest_desc: [
		"A &ePumpkin&r, a pinch of &eSugar&r and an &eEgg&r bake a Pumpkin Pie."
		""
		"It brings together your fields, your cane and your chickens."
	]
	quest.41DA729835737AA4.title: "Easy as Pie"
	quest.41FA8929A0233A93.quest_desc: [
		"Catch &e3&r shiny Pokémon."
		""
		"&oOnce is luck. Three times is a lifestyle.&r"
	]
	quest.41FA8929A0233A93.title: "Shiny Hunter"
	quest.42109DF8331266C9.quest_desc: ["Pink Apricorn base: &e+2 Speed, -1 Acceleration&r."]
	quest.42109DF8331266C9.title: "Pink Aprijuice"
	quest.422587AA3FAE3D10.quest_desc: [
		"Lets &eGarchomp&r Mega Evolve."
		""
		"Recipe: raw Mega Stone, two Iron Ingots, a Diamond and a &eMuscle Band&r."
	]
	quest.422587AA3FAE3D10.title: "Garchompite"
	quest.4229F0502A7FFF81.quest_desc: [
		"&6Price:&r &e12,000 CobbleDollars&r for one."
		""
		"Evolves Artisan Poltchageist into Masterpiece Sinistcha"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.4229F0502A7FFF81.quest_subtitle: "12,000 CD"
	quest.4229F0502A7FFF81.title: "Masterpiece Teacup"
	quest.424040F46335B164.quest_desc: [
		"Wade into a &6Mangrove Swamp&r."
		""
		"Karrablast and Shelmet are common here (trade them to evolve both!), and Surskit skates on the water."
	]
	quest.424040F46335B164.title: "Roots and Mud"
	quest.4272DCA17EC09C1D.quest_desc: [
		"&6Price:&r &e6,000 CobbleDollars&r for one."
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.4272DCA17EC09C1D.quest_subtitle: "6,000 CD"
	quest.4272DCA17EC09C1D.title: "Room Service"
	quest.4277178C41624075.quest_desc: [
		"&6Price:&r &e1,500 CobbleDollars&r for one."
		""
		"Halves damage taken from a supereffective Dark-type attack"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.4277178C41624075.quest_subtitle: "1,500 CD"
	quest.4277178C41624075.title: "Colbur Berry"
	quest.427D88010C3F30AF.quest_desc: [
		"Find a Terralith &espire&r, which rises from frozen rivers."
		""
		"Its chests range from junk to real treasure, with Cobblemon items mixed in."
	]
	quest.427D88010C3F30AF.title: "Icy Spire"
	quest.428AE717DEEF59F7.quest_desc: [
		"Emerald ore only generates inside mountain biomes: peaks, slopes, meadows, cherry groves and Terralith's high country. It is most common high up."
		""
		"Trade them with villagers. The bank at a &aCobble Merchant&r does not buy Emeralds."
	]
	quest.428AE717DEEF59F7.title: "Mountain Treasure"
	quest.42B427C4D90AC62A.quest_desc: ["The &bIcerend Shrine&r hides in basalt deltas. With the power of 8 matching stakes it releases &dChien-Pao&r."]
	quest.42B427C4D90AC62A.title: "Frost of Ruin"
	quest.42BD1CA42F6AA445.quest_desc: [
		"Catch an &eAlpha&r Pokémon."
		""
		"Alphas are oversized herd leaders surrounded by their own evolution line. Most carry a &eType Gem&r, and the chat announces where one spawns."
		"&cWarning:&r their level can be anything up to 100, and they get a power boost in battle. Scout before you charge in."
	]
	quest.42BD1CA42F6AA445.title: "Follow the Leader"
	quest.42BE1DD5A6DBCE86.quest_desc: [
		"Coins sacked and banked, a Lucky Egg bought and every machine in your arcade running."
		""
		"Click the checkmark to collect your dividend."
	]
	quest.42BE1DD5A6DBCE86.title: "Tycoon"
	quest.42C87E4147CEE247.quest_desc: [
		"Find a Terralith &efortified village&r."
		""
		"Walled towns appear in plains, meadows and highlands, and a desert version stands in deserts and oases."
	]
	quest.42C87E4147CEE247.title: "Behind the Walls"
	quest.42D4A3859517AE2F.quest_desc: [
		"Every Pokémon and every move has a type, and knowing who beats whom wins battles."
		""
		"This chapter sends you after all 18 types: catch 10 of each, then defeat 25 wild ones."
		"Each type pays out its &eType Gem&r and its matching resist berry."
	]
	quest.42D4A3859517AE2F.title: "&lType Mastery"
	quest.430231C6E28D0DF4.quest_desc: [
		"Win a &eFlow Armor Trim&r template from an Ominous Vault."
		""
		"Copy it with 7 Diamonds and a Breeze Rod."
	]
	quest.430231C6E28D0DF4.title: "Flow Trim"
	quest.4306CD362E05E834.quest_desc: ["Craft the &eMason&r's job site: an Iron Ingot over 3 Stone. It also cuts stone into stairs, slabs and walls one block at a time."]
	quest.4306CD362E05E834.title: "Mason"
	quest.4314A2EC09AFADBA.quest_desc: [
		"Four amethyst shards around a glass block make two &eTinted Glass&r."
		""
		"&aPokémon tip:&r the &eTM Machine&r needs tinted glass, and so do the &eLife Orb&r, &eFlame Orb&r and &eToxic Orb&r."
	]
	quest.4314A2EC09AFADBA.title: "Tinted Glass"
	quest.432443CBDD32CB00.quest_desc: ["Use a &eLeaf Stone&r on Eevee."]
	quest.432443CBDD32CB00.title: "Leafeon"
	quest.4347E0205EEB806F.quest_desc: [
		"When fire burns a block away it leaves a layer of &eAsh&r behind, and the Nether's Basalt Deltas are dusted with it. Dig the layers to collect Ash."
		""
		"&aTip:&r grab it quickly; rain slowly washes uncovered ash away."
	]
	quest.4347E0205EEB806F.title: "Ashes to Ashes"
	quest.436E7884C28CAE56.quest_desc: [
		"Brush Cobblemon ruins for a &eBlack Tumblestone&r."
		""
		"It grows next to Lava or a Magma Block just like the others."
	]
	quest.436E7884C28CAE56.title: "Dark Matter"
	quest.438F84A35D72AEFF.quest_desc: [
		"Villages dot the Overworld, and this pack's versions come in many styles for every biome."
		""
		"Look at a &eVillager&r to begin. This chapter covers trading, jobs, curing zombie villagers and defending a village from a full &cRaid&r."
		"&aVillages also host the &eCobble Merchant&r, who sells Pokémon gear for CobbleDollars (see &eCobbleDollars and Gacha&r).&r"
	]
	quest.438F84A35D72AEFF.quest_subtitle: "Find a village and look a villager in the eye"
	quest.438F84A35D72AEFF.title: "&lVillagers and Raids&r"
	quest.4399D052D387AF58.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Changes a Pokémon's stats to be that of a Serious nature"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.4399D052D387AF58.quest_subtitle: "5,000 CD"
	quest.4399D052D387AF58.title: "Serious Mint"
	quest.43AD57E6FA7256DB.quest_desc: [
		"&6Price:&r &e2,500 CobbleDollars&r for one."
		""
		"Raises holder's Sp. Atk by 1 stage when at 1/4 max HP or less"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.43AD57E6FA7256DB.quest_subtitle: "2,500 CD"
	quest.43AD57E6FA7256DB.title: "Petaya Berry"
	quest.43B0B1AE015498E7.quest_desc: [
		"450 species caught, every region researched, 250 scans logged and a PokéNav in your pocket."
		""
		"Your Pokédex is a reference work now. Claim your &5Master Ball&r."
	]
	quest.43B0B1AE015498E7.title: "Professor of Origins"
	quest.43B0E38A9A0AF81F.quest_desc: [
		"&6Price:&r &e600 CobbleDollars&r for one."
		""
		"Restores 20 HP of a Pokémon"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.43B0E38A9A0AF81F.quest_subtitle: "600 CD"
	quest.43B0E38A9A0AF81F.title: "Potion"
	quest.43BEB4A78653C8FA.quest_desc: [
		"Kill 50 &eSkeletons&r."
		""
		"The higher rungs of each ladder are about stamina. A good sword, armor and a well-lit base help."
	]
	quest.43BEB4A78653C8FA.title: "Skeleton Crew"
	quest.43EFECA91DFEE045.quest_desc: [
		"The calmest Nether biome: no Piglins or Hoglins, only &eEndermen&r and &eStriders&r. Collect &eWarped Fungus&r here."
		""
		"&6Pokémon:&r Misdreavus and Impidimp after dark, plus Spoink and Morelull."
	]
	quest.43EFECA91DFEE045.title: "Warped Forest"
	quest.43F65C292FD3684A.quest_desc: [
		"Find a &eSun Stone&r."
		""
		"&6Ore:&r badlands (also inside terracotta), dripstone caves, plains and savannas, rarer in deserts and tropical islands."
		"&6Evolves:&r Gloom, Sunkern, Cottonee and Petilil."
	]
	quest.43F65C292FD3684A.title: "Sunstruck"
	quest.44347F7A8DDAEC11.quest_desc: [
		"Fits any slot. Sneaking or double jumping sometimes makes a rude noise."
		""
		"&6Where to look:&r village tanneries, brushing Trail Ruins."
	]
	quest.44347F7A8DDAEC11.title: "Whoopee Cushion"
	quest.446155BA0BD1E992.quest_desc: [
		"Step through the Distortion Portal into the &bDistortion World&r, a realm of floating islands."
		""
		"&aFalling into its void just drops you back up top. Later you can craft your own portal from 8 Raw Origin around an Iron Ingot.&r"
	]
	quest.446155BA0BD1E992.title: "Through the Looking Portal"
	quest.4461AE6F003D20FA.quest_desc: [
		"Land all four fish: &eCod&r, &eSalmon&r, &eTropical Fish&r and &ePufferfish&r."
		""
		"&eTropical Fish&r are the rarest of the four, so be patient. &cDo not eat the Pufferfish.&r"
	]
	quest.4461AE6F003D20FA.title: "Catch of the Day"
	quest.446A36EA3288178F.quest_desc: [
		"Find a &eThunder Stone Ore&r: it generates under highlands and hills, more rarely under jungles and plains."
		"Look at the regular stone variant, found above the deepslate layer."
		""
		"&aPokémon tip:&r this stone evolves Pokémon such as Pikachu, Magneton and Eevee."
	]
	quest.446A36EA3288178F.title: "Thunder Stone Ore"
	quest.446BCC92D233AD28.quest_desc: [
		"&6Price:&r &e3,000 CobbleDollars&r for one."
		""
		"Has no effect"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.446BCC92D233AD28.quest_subtitle: "3,000 CD"
	quest.446BCC92D233AD28.title: "Cleanse Tag"
	quest.446E86D41DD7D4BF.quest_desc: [
		"Win &e5&r raids of any tier."
		""
		"Only wins where you dealt enough damage to earn rewards count."
	]
	quest.446E86D41DD7D4BF.quest_subtitle: "5 raid wins"
	quest.446E86D41DD7D4BF.title: "Raid Rookie"
	quest.4471C53FDF18466A.quest_desc: [
		"A Cobblemon &ePC&r and &e7 Blocks of Iron&r around an &eUpgrade Base&r."
		""
		"Adds a &ePortable PC&r tab: swap Pokémon in and out of your party from anywhere, no trip home needed."
	]
	quest.4471C53FDF18466A.title: "PC Upgrade"
	quest.447B22D1EC0ABDEE.quest_desc: [
		"Every Poké Ball is Apricorns crafted around a &6core&r, and the core sets the tier: &eCopper&r, &eIron&r, &eGold&r, then &eDiamond&r. Most crafts make 4 balls."
		""
		"Specialty balls shine in one situation. Craft each one, then catch a Pokémon with it."
		""
		"&aEvery ball tooltip lists its catch multiplier.&r"
	]
	quest.447B22D1EC0ABDEE.quest_subtitle: "Apricorns plus a core"
	quest.447B22D1EC0ABDEE.title: "&lPoké Ball Workshop"
	quest.447F90FFEFE267D9.quest_desc: [
		"Defeat 25 wild &5Ghost&r-type Pokémon in battle."
		""
		"&6Weak to:&r Dark, Ghost"
		"&cResists:&r Bug, Poison"
		"&cImmune to:&r Fighting, Normal"
	]
	quest.447F90FFEFE267D9.title: "Lights Out"
	quest.448A1FE17A9A9C9A.quest_desc: [
		"&eArcher and Ariana&r team up in a &edouble battle&r: two Pokémon on each side, so bring at least two of your own."
		""
		"They show up in &ebadlands&r, &esavannas&r and the &cNether&r with Incineroar, Gothitelle, Primarina, Aegislash, Mawile and Houndoom."
	]
	quest.448A1FE17A9A9C9A.quest_subtitle: "Rocket Admins Archer and Ariana"
	quest.448A1FE17A9A9C9A.title: "Double Trouble"
	quest.448BFA1EE0586EAD.quest_desc: [
		"The &eOnion Ring&r is also a snack. Eat one."
		""
		"&cEating it is a one-way trip: keep a spare to wear.&r"
	]
	quest.448BFA1EE0586EAD.title: "Adventurous Eater"
	quest.44BF6CD2BA1A6097.quest_desc: [
		"A &eFeeding Upgrade&r with a &eDiamond&r, &e2 Gold Ingots&r and &e3 Redstone&r."
		""
		"More control over when and what it feeds you."
	]
	quest.44BF6CD2BA1A6097.title: "Advanced Feeding Upgrade"
	quest.44CB7371D9648469.quest_desc: [
		"Brew a &bPotion of Water Breathing&r: Awkward Potion + &ePufferfish&r."
		""
		"&aQwilfish and Overqwil can drop Pufferfish.&r"
	]
	quest.44CB7371D9648469.title: "Hold Your Breath"
	quest.44EE96790577D8DF.quest_desc: [
		"The &5Ender Dragon&r heals from the &eEnd Crystals&r on the island towers. Shoot or break them first."
		""
		"When she perches on the central portal, strike with your best sword. Her death opens the exit portal home and spawns an &eEnd Gateway&r."
	]
	quest.44EE96790577D8DF.title: "&5Slay the Dragon"
	quest.450CFE1567457360.quest_desc: [
		"Catch 10 &dPsychic&r-type Pokémon. Dual-type Pokémon count for both of their types."
		""
		"&6Strong against:&r Fighting, Poison"
	]
	quest.450CFE1567457360.title: "Mind Readers"
	quest.453E8B96C32FBBEA.quest_desc: [
		"Defeat 25 wild &eElectric&r-type Pokémon in battle."
		""
		"&6Weak to:&r Ground"
		"&cResists:&r Electric, Flying, Steel"
	]
	quest.453E8B96C32FBBEA.title: "Short Circuit"
	quest.4549C2EDCE2A9283.quest_desc: [
		"&6Price:&r &e8,000 CobbleDollars&r for 10."
		""
		"Fully heals any status problems of a Pokémon"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.4549C2EDCE2A9283.quest_subtitle: "8,000 CD"
	quest.4549C2EDCE2A9283.title: "Full Heal x10"
	quest.455D3CD5A24555C1.quest_desc: [
		"Catch any Hoenn starter."
		""
		"&bTreecko&r in jungles, &bTorchic&r on plains, &bMudkip&r in swamps and many other spots."
	]
	quest.455D3CD5A24555C1.title: "Littleroot Lineup"
	quest.456DCF1FE55D7AEB.quest_desc: ["Brush an &eAngler Pottery Sherd&r out of warm ocean ruins. Shelter and Snort hide there too."]
	quest.456DCF1FE55D7AEB.title: "Angler Sherd"
	quest.4574BFA1970E63F0.quest_desc: ["Trade a Shelmet for another player's Karrablast (or the other way round). Both evolve the moment the trade completes."]
	quest.4574BFA1970E63F0.title: "Fair Exchange"
	quest.458736D329CE1045.quest_desc: ["Brush a &eWayfinder Armor Trim&r template out of Trail Ruins. Host, Raiser and Shaper come from there too."]
	quest.458736D329CE1045.title: "Wayfinder Trim"
	quest.458971EDBD12E541.quest_desc: ["Craft &eWise Glasses&r: three Iron Ingots and two Glass. They boost special moves and are the core of the Choice Specs."]
	quest.458971EDBD12E541.title: "Specs Appeal"
	quest.458A35E3DD54E05D.quest_desc: [
		"Kill 10 &eEndermen&r."
		""
		"Endermen only attack when you look at their face or hit them. Fight them under a two-block ceiling or wear a Carved Pumpkin. Their &eEnder Pearls&r lead the way to the End."
	]
	quest.458A35E3DD54E05D.title: "Tall, Dark and Pearly"
	quest.459042E96D737DF9.quest_desc: [
		"The &bLugia Temple&r is found in deep ocean. Set the Vortex Stone on its pedestal, then catch &dLugia&r."
		""
		"&cThe pedestal works once; a retry needs a Medallion of Renewal. Bring Ultra Balls and a False Swipe user.&r"
		"&aA &eSilver Wing&a (Master Entrepreneur) raises Lugia's Special Attack and Special Defense by 50% when held.&r"
	]
	quest.459042E96D737DF9.title: "Guardian of the Deep"
	quest.45BBC343892EC514.quest_desc: [
		"Look at a &eBee Nest&r. They hang from oak, birch and cherry trees."
		""
		"Bees fly between flowers and their nest, and the nest fills with honey over time."
	]
	quest.45BBC343892EC514.title: "Something Is Buzzing"
	quest.45BDBE29AF12A0E2.quest_desc: [
		"Use an &eUpgrade&r or a &eDubious Disc&r on a &eData Monitor&r."
		""
		"&oYou wouldn't download a Porygon.&r"
	]
	quest.45BDBE29AF12A0E2.title: "Technical Difficulties"
	quest.45C0BC6CC4C447BF.quest_desc: [
		"Catch any &dLegendary Pokémon&r, summoned or wild. Wild legends are ultra-rare spawns, mostly level 40 to 70, and most roll at least two perfect IVs."
		""
		"&aCobblemon announces legendary spawns near you, so keep an eye on chat.&r"
	]
	quest.45C0BC6CC4C447BF.title: "A Legend Appears"
	quest.45DF0C66568D32D7.quest_desc: ["Mine &eDistortion Origin Ore&r in the Distortion World for &eRaw Origin&r and smelt it into an &eOrigin Ingot&r. Turnback Cave vaults hold a few too."]
	quest.45DF0C66568D32D7.title: "Red Metal"
	quest.45E36386BB463A44.quest_desc: [
		"Surround a &eDiamond Furnace&r with &e8 Emeralds&r."
		""
		"Cook time: &e40 ticks&r per item."
		"&aShort on Emeralds? Villagers pay in them for crops, wool and other everyday goods.&r"
	]
	quest.45E36386BB463A44.title: "Emerald Furnace"
	quest.46115C57BC98239D.quest_desc: [
		"&e4 Stone&r, &e2 Planks&r, a &eRepeater&r, a &eGold Ingot&r and a basic &eSophisticated Chest&r or &eBarrel&r."
		""
		"Part of the storage group: pipes can push into and pull from it. Craft it on its own to switch between I/O, Input and Output versions."
	]
	quest.46115C57BC98239D.title: "Storage I/O"
	quest.462324CDFBA8DC3D.quest_desc: [
		"Craft a &eRepeat Ball&r: 2 Red Apricorns, 1 Yellow Apricorn and 1 Black Apricorn around a &eGold Ingot&r."
		""
		"&6Catch rate:&r 3.5x on Pokémon already registered as caught in your Pokédex."
	]
	quest.462324CDFBA8DC3D.title: "Repeat Ball"
	quest.462DE4427F1E6270.quest_desc: [
		"Revive an &eAmaura&r (Rock/Ice) from a &eSail Fossil&r."
		""
		"Look for it at eroded pillars, frozen ponds and spikes, powdered deposits and buried spruce trees."
	]
	quest.462DE4427F1E6270.title: "Amaura"
	quest.462E9F0014CB49AC.quest_desc: [
		"&6Price:&r &e4,000 CobbleDollars&r for one."
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.462E9F0014CB49AC.quest_subtitle: "4,000 CD"
	quest.462E9F0014CB49AC.title: "Luminous Moss"
	quest.4633CAD6CEE015F7.quest_desc: [
		"Chop an Apricorn tree and craft its logs into &eApricorn Planks&r."
		""
		"The full wood set follows: stairs, slabs, fences, doors, trapdoors, signs and boats."
	]
	quest.4633CAD6CEE015F7.title: "Apricorn Carpentry"
	quest.463FA1B41C66C255.quest_desc: ["Level up Eevee with 160 or more friendship during the day."]
	quest.463FA1B41C66C255.title: "Espeon"
	quest.46615D210C597C09.quest_desc: [
		"&eVivichoke Seeds&r are brushed out of suspicious blocks at prehistoric dig sites. Plant them and harvest a &eVivichoke&r."
		""
		"It goes into Max Revives, Max Potions, Poké Snacks and Vivichoke Dip, and crafts back into seeds."
	]
	quest.46615D210C597C09.title: "Ancient Artichoke"
	quest.466C93F5A3B8F5C9.quest_desc: [
		"Your kit has no armor. Craft a full iron set: 24 ingots in total."
		""
		"&aPokémon tip:&r an &eIron Helmet&r is also part of the &eExp. Share&r recipe."
	]
	quest.466C93F5A3B8F5C9.title: "Suit of Iron"
	quest.4674214FA703227D.quest_desc: [
		"Cook a Sweet in a Campfire Pot (a Strawberry Sweet takes red dye, a Honey Bottle and Sugar), let Milcery hold it and level it up."
		""
		"The time of day picks the cream: different flavors by day, by night and at dusk."
	]
	quest.4674214FA703227D.title: "Sweet Dreams"
	quest.4676F8CC12747563.quest_desc: [
		"With the Boulder Badge in hand, &eRocket Admin Archer&r will take you on. He prowls &ebadlands&r, &esavannas&r and caves."
		""
		"Beat his Impidimp, Houndour and Mightyena to put Team Rocket on notice."
	]
	quest.4676F8CC12747563.quest_subtitle: "Rocket Admin Archer"
	quest.4676F8CC12747563.title: "Shady Business"
	quest.4682BFD13629289B.quest_desc: [
		"Open a chest in a Bastion. Thanks to Lootr, every player gets their own loot from each chest."
		""
		"Bastion chests can hold Ancient Debris, Netherite Scrap, Snout armor trims and even a Lodestone."
	]
	quest.4682BFD13629289B.title: "Raiding the Vault"
	quest.46B022A3EE10A78C.quest_desc: ["Craft a &eBotanist's Workbench&r from 3 Flower Pots, 2 Wooden Slabs, 2 Sticks and a Crafting Table."]
	quest.46B022A3EE10A78C.title: "Botanist's Workbench"
	quest.46B30FC9217DB3CF.quest_desc: [
		"Craft a &eBeacon&r: the &eNether Star&r in the middle, 5 Glass above and 3 Obsidian below."
		""
		"The star drops from the Wither. See &eMonster Hunter&r for that fight."
	]
	quest.46B30FC9217DB3CF.title: "Star Power"
	quest.46BD4A661279DDD8.quest_desc: [
		"Kill 10 &eSkeletons&r."
		""
		"Skeletons shoot from range. Use cover or a Shield. They drop &eBones&r (ground into Bone Meal for your crops) and &eArrows&r."
	]
	quest.46BD4A661279DDD8.title: "Bone Collector"
	quest.46CDEFE495FA0E9D.quest_desc: [
		"Craft a &eThunder Stone Block&r from 9 Thunder Stones."
		""
		"Every evolution stone has a block form: a statement piece, and a compact way to store spares."
	]
	quest.46CDEFE495FA0E9D.title: "Rock Solid"
	quest.46DCDD9911DF8D61.quest_desc: [
		"Craft the &eArc Phone&r from 4 Iron Ingots, 3 Gold Ingots, an &eEnd Crystal&r and any Pokédex. The End Crystal needs an Eye of Ender and a Ghast Tear, so you need the Nether first."
		""
		"Its &eLegendary Tracking&r app points to a monument while you carry that monument's key item, such as a Magma Stone for the Heatran Cave. The app tells you which item it wants."
	]
	quest.46DCDD9911DF8D61.title: "A Phone for Legends"
	quest.46E13A683FAF0A35.quest_desc: [
		"Ender Pearls are not used up when thrown (they cost hunger instead) and deal no damage."
		""
		"&6Where to look:&r Ancient City chests, End City chests, village temples, brushing Desert Wells."
	]
	quest.46E13A683FAF0A35.title: "Warp Drive"
	quest.46FDA2475C9C1403.quest_desc: [
		"Medicinal Brew + a &eSitrus Berry&r = &eHyper Potion&r (120 HP)."
		""
		"Sitrus mutates from a Lum tree beside a Figy, Wiki, Mago, Aguav or Iapapa tree."
	]
	quest.46FDA2475C9C1403.title: "Hyperactive"
	quest.47022D8534AA9225.quest_desc: [
		"The world of Cobblemon Origins is big. This chapter is about crossing it: &eWaystones&r, &eWarp Plates&r and scrolls, a bed you can carry, and Pokémon you can ride."
		""
		"Your free basics still apply: &e/home&r, &e/back&r and &e/rtp&r."
		""
		"&aClick the checkmark to set off.&r"
	]
	quest.47022D8534AA9225.quest_subtitle: "Every route starts with one step"
	quest.47022D8534AA9225.title: "&lHave Boots, Will Travel"
	quest.473E259ACD9F7144.quest_desc: [
		"Craft &eDynamax Candy&r from a Max Mushroom and four Exp. Candy S (or four Exp. Candy XS)."
		""
		"Feeding it to a Pokémon raises its &eDynamax Level&r, which makes its Dynamax form stronger."
	]
	quest.473E259ACD9F7144.title: "Sweet Growth"
	quest.4749306568907ED9.quest_desc: [
		"Revive an &eArchen&r (Rock/Flying) from a &ePlume Fossil&r."
		""
		"Look for it at buried birch or spruce trees, mossy ponds, rooted pits and suspicious mounds."
	]
	quest.4749306568907ED9.title: "Archen"
	quest.47547F7D0CAC860B.quest_desc: [
		"Catch a fish without a rod: use a &eWater Bucket&r on a swimming fish."
		""
		"A bucket of fish can be emptied into an aquarium at home."
	]
	quest.47547F7D0CAC860B.title: "Tactical Fishing"
	quest.475A8632A472E131.quest_desc: [
		"Find an Explorify &edesert shrine&r, a small shrine in the desert."
		""
		"&cOne of its chests is trapped.&r"
	]
	quest.475A8632A472E131.title: "Sand Shrine"
	quest.475EBADCDE36E90C.quest_desc: [
		"Catch a Pokémon with a &eSport Ball&r."
		""
		"&aA flat 1.5x anywhere: a stylish stand-in for the Great Ball.&r"
	]
	quest.475EBADCDE36E90C.title: "Good Sport"
	quest.4760204A5109591B.quest_desc: [
		"Defeat &e5&r wild Pokémon of &elevel 50 or higher&r."
		""
		"High-level wild Pokémon hit hard. Good EVs, IVs and held items make this far easier than raw levels alone."
	]
	quest.4760204A5109591B.title: "Giant Slayer"
	quest.476533140E6C9B98.quest_desc: [
		"Four planks of any wood make a &eCrafting Table&r."
		""
		"Its 3x3 grid unlocks tools, chests and almost every recipe in the pack, Poké Balls included."
	]
	quest.476533140E6C9B98.title: "A Proper Workbench"
	quest.4765CE7D075529F5.quest_desc: [
		"Copper ore spawns between y=-16 and y=112 and is richest around y=48. Dripstone caves hold huge veins."
		""
		"Fill a &eBlock of Raw Copper&r (9 raw copper). Every basic Poké Ball needs a copper ingot, so stock up."
	]
	quest.4765CE7D075529F5.title: "Copper Vein"
	quest.476E8DC7D10B11F6.quest_desc: ["The &bSouthern Island&r rises from deep ocean. Offer the matching Treat at its pedestal to summon &dLatias&r or &dLatios&r."]
	quest.476E8DC7D10B11F6.title: "The Southern Island"
	quest.4785C1E43D1B9404.quest_desc: [
		"&6Price:&r &e8,000 CobbleDollars&r for one."
		""
		"Prevents the holder's ability from being changed or suppressed"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.4785C1E43D1B9404.quest_subtitle: "8,000 CD"
	quest.4785C1E43D1B9404.title: "Ability Shield"
	quest.478FDF1EC607E896.quest_desc: [
		"A vanilla &eChest&r plus a &eRedstone Torch&r, or &e8 Planks&r around a torch. The planks you use set its wood look."
		""
		"&e27 slots&r and &e1 upgrade slot&r to begin with, and it keeps growing from here."
	]
	quest.478FDF1EC607E896.title: "Sophisticated Chest"
	quest.47A2F13060657F99.quest_desc: ["Footprints of &dCobalion&r, &dTerrakion&r and &dVirizion&r dot the Overworld surface. Each one you find counts toward its owner."]
	quest.47A2F13060657F99.title: "Tracks in the Grass"
	quest.47B99370C3887506.quest_desc: [
		"Scan &e50&r Pokémon with your Pokédex."
		""
		"The scanner reaches Pokémon up to &e10&r blocks away and registers species you have not met yet."
	]
	quest.47B99370C3887506.title: "Field Researcher"
	quest.47CA5A9689DAFBB0.quest_desc: [
		"Planks, cobblestone, a &eCopper Ingot&r and redstone. A powered &eTurn Table&r rotates the block it faces."
		""
		"Anything standing on top of a powered table spins along with it."
	]
	quest.47CA5A9689DAFBB0.title: "Spin Cycle"
	quest.47CACB40232A5AC7.quest_desc: [
		"Craft a &eMultimeter&r from a Tinkering Table and Redstone Dust."
		""
		"Use it to open the Tinkering Table menu wherever you are."
	]
	quest.47CACB40232A5AC7.title: "Multimeter"
	quest.47D6CCC3095DEB0D.quest_desc: [
		"A &eRaid Shard&r is a rare prize from &etier 5&r Raid Pouches."
		""
		"Keep it in your inventory: every raid you clear feeds it raid energy (1 at tier 2, up to 10 at tier 5)."
	]
	quest.47D6CCC3095DEB0D.title: "Shard of Power"
	quest.47DEC7895E6AA07E.quest_desc: [
		"Catch &e5&r Pokémon in jungle biomes (Terralith variants count)."
		""
		"&bAipom&r, &bBounsweet&r, &bExeggcute&r and &bBellsprout&r hide among the vines."
	]
	quest.47DEC7895E6AA07E.title: "Jungle Fever"
	quest.47E3415706C3BC8D.quest_desc: [
		"Win a &eBulbasaur Pokédoll&r (the normal one) from the Plush-O-Matic with Grassy Yarn."
		""
		"Odds: about 1 pull in 25, and every pull costs Yarn, so stock up on Type Gems first."
	]
	quest.47E3415706C3BC8D.title: "Plush Bulbasaur"
	quest.47F4916BC1971A56.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Boosts the power of the holder's Ground-type moves"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.47F4916BC1971A56.quest_subtitle: "5,000 CD"
	quest.47F4916BC1971A56.title: "Soft Sand"
	quest.480559911568EB31.quest_desc: [
		"Catch &e10&r Pokémon at night (time of day 13000 to 23000)."
		""
		"Some species only come out after dark."
		"&aTip:&r a &eDusk Ball&r is 3x in light level 1 to 7 and 3.5x in total darkness."
	]
	quest.480559911568EB31.title: "Night Owl"
	quest.48189D60F0AFD524.quest_desc: [
		"3 &eWhite Wool&r in a column make a &eSleeping Bag&r. Dye it any color you like."
		""
		"Sleep wherever night finds you: a sleeping bag never moves your spawn point, and it never wears out."
	]
	quest.48189D60F0AFD524.title: "Sleep Under the Stars"
	quest.481970E3236E8A1B.quest_desc: [
		"&6Price:&r &e2,000 CobbleDollars&r for one."
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.481970E3236E8A1B.quest_subtitle: "2,000 CD"
	quest.481970E3236E8A1B.title: "Ghost Gem"
	quest.481DAF5AEF192434.quest_desc: [
		"&eCobbleDollars&r are the currency of Cobblemon Origins."
		""
		"You earn them by defeating wild Pokémon, beating NPC trainers and finishing quests. You spend them in the &3Poké Mart&r pages of this book or at &eCobble Merchants&r, and the treasure you dig out of ruins can become cash or gacha prizes."
		""
		"&aClick the checkmark to start.&r"
	]
	quest.481DAF5AEF192434.title: "Show Me the Money"
	quest.4845E194168DE6C0.quest_desc: [
		"A &ePump Upgrade&r with &e2 Diamonds&r, a &eDispenser&r, &e2 Gold Ingots&r and &e3 Redstone&r."
		""
		"Also works with buckets in your hand and fluid blocks in the world, with a fluid filter."
	]
	quest.4845E194168DE6C0.title: "Advanced Pump Upgrade"
	quest.486C5E7D32B1B56C.quest_desc: [
		"Craft a Poké Gacha Machine with Blue Dye to get the &eAzure&r version."
		""
		"Yellow makes Citrine, Green Verdant, Pink Roseate, Black Slate and White Premier. Same prizes, new look."
	]
	quest.486C5E7D32B1B56C.title: "Fresh Paint"
	quest.486D90656653DB2A.quest_desc: [
		"Follow a shipwreck treasure map and dig up the &eburied treasure&r."
		""
		"Stand in the chest pit to complete this. A Heart of the Sea is waiting, plus some Cobblemon items."
	]
	quest.486D90656653DB2A.title: "X Marks the Spot"
	quest.4871D69A2110E15E.quest_desc: [
		"Grow a &eTorchflower&r from seeds a Sniffer dug up."
		""
		"The seeds are also what breeds and feeds Sniffers."
	]
	quest.4871D69A2110E15E.title: "Ancient Bloom"
	quest.48852BA599985D52.quest_desc: [
		"Kill a Pillager with a &eCrossbow&r of your own."
		""
		"Craft one from 3 Sticks, 2 String, an Iron Ingot and a Tripwire Hook, or take one from an outpost chest."
	]
	quest.48852BA599985D52.title: "Turnabout"
	quest.4891C95A48D108C6.quest_desc: [
		"&6Price:&r &e3,000 CobbleDollars&r for one."
		""
		"Evolves certain Pokémon"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.4891C95A48D108C6.quest_subtitle: "3,000 CD"
	quest.4891C95A48D108C6.title: "Ice Stone"
	quest.489D7F90325ACF69.quest_desc: [
		"Use a Dusk Stone on Murkrow, Misdreavus, Lampent or Doublade, or a Dawn Stone on a male Kirlia (Gallade) or a female Snorunt (Froslass)."
		""
		"Hold the stone and use it on the Pokémon."
	]
	quest.489D7F90325ACF69.title: "Dusk till Dawn"
	quest.48A4A07259789BCB.quest_desc: [
		"Win a raid against a &eGhost-type&r boss. Most of them sit at tiers 4 and 5."
		""
		"A den's crystal colour hints at its type. Bring a strong Dark-type attacker."
	]
	quest.48A4A07259789BCB.title: "Ghostbusting"
	quest.48A6FBA156CD41C1.quest_desc: [
		"Build the full four-layer pyramid: 9x9, 7x7, 5x5 and 3x3 layers, 164 blocks in all."
		""
		"Level 2 adds Resistance and Jump Boost, level 3 Strength, and level 4 lets you add Regeneration as a second effect."
	]
	quest.48A6FBA156CD41C1.title: "Full Power"
	quest.48AA3788D45F1D97.quest_desc: [
		"Three Wheat in a row makes a loaf of &eBread&r."
		""
		"Not fancy, but it keeps you fed while you are out catching Pokémon."
	]
	quest.48AA3788D45F1D97.title: "Daily Bread"
	quest.48AF1B07662D7764.quest_desc: [
		"Three Milk Buckets, two Sugar, an Egg and three Wheat bake a &eCake&r."
		""
		"&aPokémon tie-in:&r three bottles of &eMoomoo Milk&r can replace the Milk Buckets."
	]
	quest.48AF1B07662D7764.title: "Let Them Eat Cake"
	quest.48B1AAC532DB058A.quest_desc: [
		"&6Price:&r &e400 CobbleDollars&r for one."
		""
		"1×, flies further"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.48B1AAC532DB058A.quest_subtitle: "400 CD"
	quest.48B1AAC532DB058A.title: "Ancient Feather Ball"
	quest.48B771351F1175B3.quest_desc: [
		"Wild &ePumpkins&r grow in patches across the world; &eMelons&r grow wild in jungles."
		""
		"Plant their seeds with a free block beside each stem: the fruit grows next to it."
	]
	quest.48B771351F1175B3.title: "Gourd Gardening"
	quest.48DBC907DD4DE7FF.quest_desc: [
		"Explore an &6Underground Jungle&r."
		""
		"Woobat and Ferroseed are common in the dark."
		"&oThe mythical Zarude is an ultra-rare sight down here.&r"
	]
	quest.48DBC907DD4DE7FF.title: "Jungle Below"
	quest.48EBA01514259761.quest_desc: [
		"&6Iron Furnaces&r adds a ladder of faster furnaces, from Copper all the way up to a Rainbow trophy."
		""
		"A vanilla Furnace needs &e200 ticks&r per item. Every tier in this chapter cuts that down, and each one is crafted around the furnace before it."
		""
		"Bring a &eFurnace&r and &e8 Iron Ingots&r: that is exactly one &eIron Furnace&r."
	]
	quest.48EBA01514259761.title: "&lHotter Than Vanilla"
	quest.48EF884BE4DCEDBE.quest_desc: [
		"Find a &eShiny Stone&r."
		""
		"&6Ore:&r flower forests, meadows, cherry groves, magical forests and the Skylands, rarer on islands and peaks."
		"&6Evolves:&r Togetic, Roselia, Minccino and Floette."
	]
	quest.48EF884BE4DCEDBE.title: "Shine Bright"
	quest.49034F211CA57481.quest_desc: [
		"Craft 4 &eWind Charges&r from one Breeze Rod."
		""
		"Throw one to knock mobs back, flip switches from afar, or launch yourself into the air."
	]
	quest.49034F211CA57481.title: "Gust in a Bottle"
	quest.49061734E31184B1.quest_desc: [
		"Bone Meal, Rotten Flesh, Dirt and Paper craft three &eMulch&r."
		""
		"Mix it with one more ingredient for a special mulch, then use it on a Berry tree. Mulch wears off after a while."
	]
	quest.49061734E31184B1.title: "Rich Soil"
	quest.4908603E4B7E87EF.quest_desc: [
		"Craft a &eBlock of Tumblestone&r from 4 Tumblestones."
		""
		"Put it in a Stonecutter for polished, brick, chiseled, slab, stair and wall variants. Every colour has its own set."
	]
	quest.4908603E4B7E87EF.title: "Tumblestone Masonry"
	quest.4916C4210CCA285C.quest_desc: [
		"A cable plus &eQuartz&r, &e2 Planks&r, a &eChest&r, an &eEnder Pearl&r and a &eDiamond&r."
		""
		"Attaches a far-away inventory to the cable line."
	]
	quest.4916C4210CCA285C.title: "Inventory Cable Connector"
	quest.4933E49C40C8C11A.quest_desc: [
		"Craft a &eChoice Scarf&r: three Wool, three Diamonds and a &eSilk Scarf&r. The holder gets faster but is locked into one move."
		""
		"&aSilk Scarf: Wool, String and a Normal Gem. Hard Stone plus a Chilan Berry makes a Normal Gem.&r"
	]
	quest.4933E49C40C8C11A.title: "Wrapped Up Fast"
	quest.494BBFFBE7E0CE82.quest_desc: ["Craft a &eCarpenter's Table&r from an Iron Axe, an Iron Ingot, 5 Planks and a Crafting Table."]
	quest.494BBFFBE7E0CE82.title: "Carpenter's Table"
	quest.4967B8D0497D41FD.quest_desc: ["Reel in a &eDratini&r. They are rare bites in dark underground water between Y -31 and 32, a little more common below Y -32, and rare in magical biomes such as Dark Forests."]
	quest.4967B8D0497D41FD.title: "Dragon in the Deep"
	quest.497BD53D0B0BDF5F.quest_desc: [
		"&6Price:&r &e1,000 CobbleDollars&r for one."
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.497BD53D0B0BDF5F.quest_subtitle: "1,000 CD"
	quest.497BD53D0B0BDF5F.title: "Pomeg Berry"
	quest.4991FCC1C934D4A7.quest_desc: [
		"&6Price:&r &e300 CobbleDollars&r for one."
		""
		"Holder is cured if it is confused"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.4991FCC1C934D4A7.quest_subtitle: "300 CD"
	quest.4991FCC1C934D4A7.title: "Persim Berry"
	quest.4999F4BAF3D8DA1E.quest_desc: [
		"Max out all five riding stats of one Pokémon (Speed, Acceleration, Skill, Jump and Stamina) with Aprijuice."
		""
		"Each color also costs a little of another stat. &eWhite&r juice lowers every stat by 2."
	]
	quest.4999F4BAF3D8DA1E.title: "Star Athlete"
	quest.49BBC7A3023011C8.quest_desc: [
		"&6Price:&r &e3,000 CobbleDollars&r for one."
		""
		"Doubles an untransformed Ditto's Speed"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.49BBC7A3023011C8.quest_subtitle: "3,000 CD"
	quest.49BBC7A3023011C8.title: "Quick Powder"
	quest.49BE29B238EA1C71.quest_desc: [
		"&6Price:&r &e1,000 CobbleDollars&r for one."
		""
		"2×, flies further"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.49BE29B238EA1C71.quest_subtitle: "1,000 CD"
	quest.49BE29B238EA1C71.title: "Ancient Jet Ball"
	quest.49C2C129BF6F8B27.quest_desc: ["&eRegional Delicacies&r are dishes from the Pokémon regions, ten in all. Most start from &eHearty Grains&r, &eWheat&r, &eMilk&r or &eSugar&r."]
	quest.49C2C129BF6F8B27.title: "World Kitchen"
	quest.49C699CA6F63D100.quest_desc: [
		"Your melee hits set enemies on fire."
		""
		"&6Where to look:&r Bastion treasure rooms, Ruined Portals, big Ocean Ruins, brushing cold Ocean Ruins; rarely worn by wither skeletons."
	]
	quest.49C699CA6F63D100.title: "Fire Gauntlet"
	quest.49CA832C4284C1F6.quest_desc: [
		"&eYUNG's Better Desert Temples&r replace the vanilla pyramids. Each temple puts Mining Fatigue on you until it is cleared."
		""
		"Find the tomb deep inside and slay the &ePharaoh&r to lift the curse."
	]
	quest.49CA832C4284C1F6.title: "Curse of the Pharaoh"
	quest.49CF0F3FAF564162.quest_desc: [
		"Eight &eCopper Ingots&r around a &eBlock of Redstone&r. Cog Blocks pass redstone power along to the Cog Blocks they touch."
		""
		"Chain them to carry a signal up walls and around corners without wiring dust."
	]
	quest.49CF0F3FAF564162.title: "Gears of Industry"
	quest.49DE28B09F3A39B2.quest_desc: [
		"Craft a &eKing's Rock&r: Chiseled Sandstone on top of three Raw Gold and three Sandstone."
		""
		"Some trade evolutions only work while the Pokémon holds the right item."
	]
	quest.49DE28B09F3A39B2.title: "Fit for a King"
	quest.49EE7EBB47D4D1D1.quest_desc: ["Use &e50 Stellar Tera Shards&r on a Pokémon to give it the rare &6Stellar&r Tera Type."]
	quest.49EE7EBB47D4D1D1.title: "Starstruck"
	quest.49F342BD50FCFD8B.quest_desc: [
		"Hold a &eTotem of Undying&r. Every Evoker drops one."
		""
		"Keep it in your hand or offhand and it saves you from one death, healing you on the spot."
	]
	quest.49F342BD50FCFD8B.title: "Second Life"
	quest.49F3A0A6118941DC.quest_desc: [
		"Catch &e50&r Pokémon."
		""
		"&aTip:&r an &eUltra Ball&r doubles the catch rate of a plain Poké Ball."
	]
	quest.49F3A0A6118941DC.title: "Box Filler"
	quest.4A01B0E54C0E7074.quest_desc: [
		"Find a &eFire Stone Ore&r: it generates under deserts and volcanic or thermal biomes, more rarely under other sandy ones. A Nether variant hides in netherrack."
		"Look at the regular stone variant, found above the deepslate layer."
		""
		"&aPokémon tip:&r this stone evolves Pokémon such as Vulpix, Growlithe and Eevee."
	]
	quest.4A01B0E54C0E7074.title: "Fire Stone Ore"
	quest.4A171767EB4BC141.quest_desc: [
		"&6Price:&r &e1,500 CobbleDollars&r for one."
		""
		"Temporarily raises the target's Sp. Atk stat by one stage when used in battle"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.4A171767EB4BC141.quest_subtitle: "1,500 CD"
	quest.4A171767EB4BC141.title: "X Sp. Atk"
	quest.4A18B490E7E5CDF3.quest_desc: ["Upgrade a Muscle Band into a &eChoice Band&r with four Quartz, two Lapis and two Redstone. A big Attack boost, but the holder is locked into one move."]
	quest.4A18B490E7E5CDF3.title: "Choice Band"
	quest.4A287EE8172CB96D.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Boosts the power of the holder's Ghost-type moves"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.4A287EE8172CB96D.quest_subtitle: "5,000 CD"
	quest.4A287EE8172CB96D.title: "Spell Tag"
	quest.4A4D27C5E6DDE715.quest_desc: [
		"Wild Pokémon defeated at night sometimes drop &eDream String&r. Nine make a &eDream Catcher&r; Apprentice Entrepreneurs also sell one."
		""
		"Place it near your bed: it grants &eLucid Dreaming&r to players close by."
	]
	quest.4A4D27C5E6DDE715.title: "Catch a Dream"
	quest.4A60AE64F923DCD3.quest_desc: ["Nine shards make a whole stone: craft the &eLight Stone&r and the &eDark Stone&r."]
	quest.4A60AE64F923DCD3.title: "Light and Dark"
	quest.4A6DF5A3C5836F3D.quest_desc: ["Craft a &eMetal Alloy&r (four Iron Ingots around a Thunder Stone) and use it on Duraludon to evolve it into Archaludon."]
	quest.4A6DF5A3C5836F3D.title: "Alloyed Ambition"
	quest.4A6E46F5966B59E9.quest_desc: [
		"Reach the &6Mushroom Fields&r, usually an island far out at sea."
		""
		"Galarian Slowpoke lounge near the water and Toedscool wander the mycelium."
		"&aTip:&r a CTOV mushroom village can generate here too."
	]
	quest.4A6E46F5966B59E9.title: "Fungus Among Us"
	quest.4A7D3FFB0D0DDC9F.quest_desc: [
		"The &bFrosted Caves&r form under the coldest snowy lands: icicles overhead, ice underfoot and glowing &eEnchanted Ice&r."
		""
		"&cFalling icicles hurt.&r"
	]
	quest.4A7D3FFB0D0DDC9F.title: "Frosted Caves"
	quest.4A868C7CEC6DC5DA.quest_desc: [
		"Every kind of Bastion chest can hold a &eNetherite Upgrade Smithing Template&r, the item that turns diamond gear into netherite."
		""
		"Copy it before you use it: seven Diamonds, the template and a block of Netherrack craft two templates."
	]
	quest.4A868C7CEC6DC5DA.title: "Blueprint for Netherite"
	quest.4A9D21B20D1DC220.quest_desc: ["Craft an &eHP Silver Cap&r: four Iron Ingots, two Diamonds and three &eWhite Mint Leaves&r. It Hyper Trains the HP IV to 31."]
	quest.4A9D21B20D1DC220.title: "HP Silver Cap"
	quest.4AA9BB72A8486D39.quest_desc: [
		"Catch 10 &9Water&r-type Pokémon. Dual-type Pokémon count for both of their types."
		""
		"&6Strong against:&r Fire, Ground, Rock"
	]
	quest.4AA9BB72A8486D39.title: "Making a Splash"
	quest.4AACCEEF563DFBAE.quest_desc: [
		"Two Shulker Shells and a Chest make a &eShulker Box&r."
		""
		"Break it and it keeps every item inside, so it fits a whole chest into one slot of your backpack."
	]
	quest.4AACCEEF563DFBAE.title: "Box in a Box"
	quest.4ADF08F82F2EF0BB.quest_desc: [
		"&eElder Guardians&r live inside Ocean Monuments and curse nearby players with Mining Fatigue."
		""
		"Defeat one. It drops a &eWet Sponge&r and can drop the &eTide&r armor trim template."
	]
	quest.4ADF08F82F2EF0BB.title: "Elder of the Deep"
	quest.4AFBC1A96BB6154F.quest_desc: [
		"&6Price:&r &e1,000 CobbleDollars&r for one."
		""
		"1.5× outside of battle"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.4AFBC1A96BB6154F.quest_subtitle: "1,000 CD"
	quest.4AFBC1A96BB6154F.title: "Safari Ball"
	quest.4B07018B02686937.quest_desc: [
		"&6Price:&r &e6,000 CobbleDollars&r for one."
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.4B07018B02686937.quest_subtitle: "6,000 CD"
	quest.4B07018B02686937.title: "Power Herb"
	quest.4B21BADD7B4E06DD.quest_desc: ["Defeat &e1,000&r wild Pokémon. That is a lot of battles. Your team has earned its stripes."]
	quest.4B21BADD7B4E06DD.title: "One Thousand Victories"
	quest.4B384FD3C325AB35.quest_desc: ["Craft a &eGlassblower&r from 2 Iron Ingots, Glass, 4 blocks of Bricks, a Blast Furnace and a Crafting Table."]
	quest.4B384FD3C325AB35.title: "Glassblower"
	quest.4B5344DA3EDAA41D.quest_desc: [
		"&6Price:&r &e2,500 CobbleDollars&r for one."
		""
		"Restores 1/4 max HP after holder is hit by a supereffective move"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.4B5344DA3EDAA41D.quest_subtitle: "2,500 CD"
	quest.4B5344DA3EDAA41D.title: "Enigma Berry"
	quest.4B58952D70C35072.quest_desc: [
		"Famous trainers carried their Key Stones in style. Collect all fourteen Key Stone accessories:"
		"the seven bracelets plus the Mega Ring, May's Bracelet, Brendan's Mega Cuff, Lysandre's Ring, Korrina's Gloves, Maxie's Glasses and Archie's Anchor."
		""
		"Every one of them needs a Keystone. REI shows each recipe."
	]
	quest.4B58952D70C35072.title: "Famous Wrists"
	quest.4B6664D7086E8F39.quest_desc: [
		"&6Four newer potions&r, each from an Awkward Potion:"
		"&eBreeze Rod&r: Wind Charged, a burst of wind when the target dies."
		"&eCobweb&r: Weaving, cobwebs spread when the target dies."
		"&eSlime Block&r: Oozing, slimes pop out when the target dies."
		"&eStone&r: Infested, silverfish may crawl out when the target is hurt."
		"&aBreeze Rods come from the Trial Chambers (Trials and Archaeology).&r"
	]
	quest.4B6664D7086E8F39.title: "Trial-Era Brews"
	quest.4B7A09962F98169E.quest_desc: [
		"Craft the &eRocket Prize Master&r from 2 Iron Blocks, a Redstone Block, 3 Ultra Balls, 2 Iron Boots and a Dispenser."
		""
		"It only takes Koban Coins and always pays out a Rocket Ball."
	]
	quest.4B7A09962F98169E.title: "Rocket Prize Master"
	quest.4B8513459C50C1DB.quest_desc: [
		"Mulch plus Dirt, Coarse Dirt, Mud, a Moss Block or Sand makes &eLoamy&r, &eCoarse&r, &eHumid&r, &ePeat&r or &eSandy Mulch&r."
		""
		"Every Berry has favorite mulches that stand in for its preferred biome: Oran likes Peat and Loamy, Cheri Loamy, Aspear Coarse, Pecha Humid, Rawst Sandy."
	]
	quest.4B8513459C50C1DB.title: "Home Turf"
	quest.4B911CEA7A55B808.quest_desc: [
		"Craft a &eRocky Helmet&r: a Golden Helmet, three &eHard Stone&r, two Turtle Scutes and two Gold Ingots. Any Pokémon that makes contact with the holder takes damage."
		""
		"&aHard Stone: eight Stone, Deepslate, Blackstone or Tuff around a Rock Gem, or blast Cobblestone.&r"
	]
	quest.4B911CEA7A55B808.title: "Hard Hat"
	quest.4B92C66AF72CA3A0.quest_desc: [
		"One amethyst shard on top of two copper ingots makes a &eSpyglass&r."
		""
		"Zoom in to scout wild Pokémon from far away before you walk up to them."
	]
	quest.4B92C66AF72CA3A0.title: "Eagle Eye"
	quest.4B98C57E56E02AB6.quest_desc: [
		"Combine a &eGlobe&r with &eAntique Ink&r for a &eSepia Globe&r, straight out of an old explorer's study."
		""
		"Changed your mind? &eSoap&r washes it back into a normal globe."
	]
	quest.4B98C57E56E02AB6.title: "Here Be Dragons"
	quest.4BB7ED16C4187A05.quest_desc: [
		"Kill 50 &eBlazes&r."
		""
		"Wall in a spawner so they can only reach you one at a time, and the Blaze Rods pile up."
	]
	quest.4BB7ED16C4187A05.title: "Spawner Camper"
	quest.4BB9B9C6FCD9BBBF.quest_desc: [
		"In this pack pastured Pokémon also &eproduce loot&r: each one has a 15% chance per minute to drop an item from its usual drop table."
		""
		"Meat, bones, leather, rotten flesh, honey and a few other drops are excluded. Fainted Pokémon do not produce."
	]
	quest.4BB9B9C6FCD9BBBF.title: "Ranch Dividends"
	quest.4BC566D30984D8CD.quest_desc: [
		"Find a &6Moonlight Grove&r."
		""
		"Hatenna and its evolutions live here, and Impidimp comes out to play at night."
		"&oThe ultra-rare Lunala has been seen here.&r"
	]
	quest.4BC566D30984D8CD.title: "By Moonlight"
	quest.4BCCFBB273BA927F.quest_desc: [
		"&eCarrots&r and &ePotatoes&r have no seeds: plant the vegetable itself."
		""
		"Find them in village farms, or as rare drops from Zombies. Pigs will follow and breed with either one."
	]
	quest.4BCCFBB273BA927F.title: "Root Vegetables"
	quest.4BD6672D3971C1AB.quest_desc: [
		"Catch any Unova starter."
		""
		"&bSnivy&r in jungles, &bTepig&r on plains, &bOshawott&r on beaches and coasts."
	]
	quest.4BD6672D3971C1AB.title: "Nuvema Newcomers"
	quest.4BE4A0CAA9548041.quest_desc: [
		"&eElite Four Lorelei&r waits in the &eKanto League&r, a grand hall on the outer islands of the &5End&r (End Highlands and Midlands). Search for it with the compass."
		""
		"League team: Politoed, Poliwrath, Swampert, Kingdra, Primal Kyogre and Dracovish."
		""
		"She also wanders cold biomes, sometimes with a different team. Either team counts, and the Elite Four can be fought in any order."
	]
	quest.4BE4A0CAA9548041.quest_subtitle: "Elite Four Lorelei"
	quest.4BE4A0CAA9548041.title: "Ice Queen"
	quest.4C056E0965C33381.quest_desc: [
		"Every job filled, a zombie cured, savings in the bank and a raid beaten back: the village owes you one."
		""
		"Keep it safe. A busy village is the best trading post in the Overworld."
	]
	quest.4C056E0965C33381.title: "Pillar of the Community"
	quest.4C065FDC50FD6972.quest_desc: [
		"Deserts, oases, the striped badlands and the dry savanna."
		""
		"Ground- and Rock-types thrive in the heat, and the desert hides temples and ruins worth raiding."
		"&aTip:&r desert temples and Cobblemon ruins hide in the sand; see &eStructure Hunter&r."
	]
	quest.4C065FDC50FD6972.title: "Sun-Baked Sands"
	quest.4C0A590AD5286E8D.quest_desc: [
		"Catch 10 &5Ghost&r-type Pokémon. Dual-type Pokémon count for both of their types."
		""
		"&6Strong against:&r Psychic, Ghost"
	]
	quest.4C0A590AD5286E8D.title: "Things That Go Bump"
	quest.4C1CC980E1DD7B20.quest_desc: [
		"&6Price:&r &e2,000 CobbleDollars&r for one."
		""
		"Evolves Milcery into Alcremie with a Flower Sweet"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.4C1CC980E1DD7B20.quest_subtitle: "2,000 CD"
	quest.4C1CC980E1DD7B20.title: "Flower Sweet"
	quest.4C21152ACC03DA6B.quest_desc: [
		"Buy a &eCherish Ball&r for 5,000."
		""
		"Nobody crafts these: the Poké Mart, merchants and the rarest gacha capsules are the only sources."
	]
	quest.4C21152ACC03DA6B.title: "Special Delivery"
	quest.4C28824392496AF7.quest_desc: [
		"&6Price:&r &e2,000 CobbleDollars&r for one."
		""
		"Raises the Pokémon's Sp. Def EVs by 4"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.4C28824392496AF7.quest_subtitle: "2,000 CD"
	quest.4C28824392496AF7.title: "Clever Mochi"
	quest.4C2A1B4F76A13371.quest_desc: [
		"A starter from all nine regions has joined your team. Professors from Kanto to Paldea are impressed."
		""
		"This unlocks once all nine region quests are done."
	]
	quest.4C2A1B4F76A13371.title: "Starter Collector"
	quest.4C407DD60EC449DF.quest_desc: [
		"Put a &eShulker Shell&r above and below a &eSophisticated Chest&r. The shells come from Shulkers in End Cities."
		""
		"A shulker box that takes upgrades and tiers up like the rest of the family."
	]
	quest.4C407DD60EC449DF.title: "Sophisticated Shulker Box"
	quest.4C472204B7B87330.quest_desc: [
		"Climb the &6Volcanic Peaks&r."
		""
		"Meditite meditate and Numel plod across the ash; an ultra-rare Beldum may float by."
	]
	quest.4C472204B7B87330.title: "Fire on the Mountain"
	quest.4C698144FC345B08.quest_desc: [
		"Catch a Pokémon with a &eDive Ball&r."
		""
		"&aDive in and throw it at a Pokémon swimming underwater.&r"
	]
	quest.4C698144FC345B08.title: "Deep Dive"
	quest.4C6E25B32E5F157E.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Boosts the power of the holder's Ice-type moves"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.4C6E25B32E5F157E.quest_subtitle: "5,000 CD"
	quest.4C6E25B32E5F157E.title: "Never-Melt Ice"
	quest.4C7A91471FC513EE.quest_desc: [
		"Serene Seasons also covers Cobblemon plants. Out of season they grow slowly."
		"All year: &eApricorns&r, &eMints&r, &eVivichoke&r, Oran and Persim. Not in Winter: &eRevival Herbs&r and Saccharine saplings."
		"Spring and Autumn: &eLeeks&r. Summer and Autumn: &eHearty Grains&r. Autumn only: &eGalarica Nuts&r."
		"Other Berries vary: hover one to see its Fertile Seasons."
	]
	quest.4C7A91471FC513EE.title: "Seasonal Sprouts"
	quest.4C7C85CCFC75CC22.quest_desc: [
		"Catch 10 &cFire&r-type Pokémon. Dual-type Pokémon count for both of their types."
		""
		"&6Strong against:&r Grass, Ice, Bug, Steel"
	]
	quest.4C7C85CCFC75CC22.title: "Playing with Fire"
	quest.4CAE89F927348C3D.quest_desc: [
		"Find a &eMoon Stone Ore&r: it generates under taigas, mushroom fields and dripstone caves, more rarely under spooky and magical biomes. Dripstone caves also hide a dripstone variant."
		"Look at the regular stone variant, found above the deepslate layer."
		""
		"&aPokémon tip:&r this stone evolves Pokémon such as Clefairy, Jigglypuff and Skitty."
	]
	quest.4CAE89F927348C3D.title: "Moon Stone Ore"
	quest.4CB1F9CCDB1E21EC.quest_desc: [
		"Defeat 25 wild &6Rock&r-type Pokémon in battle."
		""
		"&6Weak to:&r Fighting, Grass, Ground, Steel, Water"
		"&cResists:&r Fire, Flying, Normal, Poison"
	]
	quest.4CB1F9CCDB1E21EC.title: "Rock Bottom"
	quest.4CBB5B7671E77500.quest_desc: [
		"This chapter is your Cobblemon tutorial: pick a partner, battle, catch, craft Poké Balls, heal up and build a team."
		""
		"Three lanes branch off your starter: &6crafting&r on top, &6catching&r in the middle, &6battling&r below. Every other Pokémon chapter opens from here."
		""
		"&aClick the checkmark to begin.&r"
	]
	quest.4CBB5B7671E77500.quest_subtitle: "Every journey starts with one Pokémon"
	quest.4CBB5B7671E77500.title: "&lBecoming a Trainer"
	quest.4CBF820426116135.quest_desc: [
		"&6Price:&r &e2,000 CobbleDollars&r for one."
		""
		"Evolves Milcery into Alcremie with a Love Sweet"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.4CBF820426116135.quest_subtitle: "2,000 CD"
	quest.4CBF820426116135.title: "Love Sweet"
	quest.4CD9CFDC8C0BC562.quest_desc: [
		"Register &e60&r species from the &eHoenn&r region (Generation 3) as caught."
		""
		"Regional forms count for their own region (an Alolan form counts toward Alola). Hisuian forms count toward Galar."
	]
	quest.4CD9CFDC8C0BC562.title: "Hoenn Field Notes"
	quest.4CEE41891DE71674.quest_desc: ["Mulch plus Bone Meal makes &eGrowth Mulch&r: a mulched Berry tree grows faster."]
	quest.4CEE41891DE71674.title: "Growth Spurt"
	quest.4D13806724D15F7F.quest_desc: [
		"Three lakes, three trials: &bLake Verity&r (sunflower plains), &bLake Valor&r (dark forest) and &bLake Acuity&r (snowy taiga)."
		""
		"Win a lake's Pokémon Trial to earn its &eProof of Conquest&r. Right-click the proof to summon &dMesprit&r, &dAzelf&r or &dUxie&r and receive a relic: Mesprit's Plume, Azelf's Fang or Uxie's Claw."
	]
	quest.4D13806724D15F7F.title: "Trials of the Lakes"
	quest.4D1F10A4A406C800.quest_desc: [
		"Cook three M candies into an &eExp. Candy L&r (10,000 EXP)."
		""
		"L candies are also the base of the IV candies in the stats branch."
	]
	quest.4D1F10A4A406C800.title: "Large Order"
	quest.4D4E9AD46E66250E.quest_desc: ["Brush a &eBrewer Pottery Sherd&r out of a desert well. Arms Up is the other sherd there."]
	quest.4D4E9AD46E66250E.title: "Brewer Sherd"
	quest.4D611B5DC9A7225F.quest_desc: [
		"&eTier 1&r with &e8 Blocks of Gold&r."
		""
		"Every slot holds &e4x&r as many stacks. Up to &e3&r stack upgrades fit in one backpack."
	]
	quest.4D611B5DC9A7225F.title: "Stack Upgrade Tier 2"
	quest.4D62DE999115E434.quest_desc: [
		"A &eHopper&r, &e2 Iron Ingots&r and &e3 Redstone&r around a &eStorage Upgrade Base&r."
		""
		"Pulls items from the block on top and pushes them into the block below. No more hopper towers."
	]
	quest.4D62DE999115E434.title: "Hopper Upgrade"
	quest.4D797A9EFCE3790B.quest_desc: [
		"Give Porygon a Upgrade to hold, then trade it or use a Link Cable on it."
		""
		"Porygon2 continues into Porygon-Z the same way while holding a &eDubious Disc&r (two Tinted Glass, a Sea Lantern, two Sculk and a Blank TM)."
	]
	quest.4D797A9EFCE3790B.title: "Version 2.0"
	quest.4D7982854D75D083.quest_desc: [
		"A &ePulley Block&r (planks, wooden slabs and an iron ingot) holds rope and reels it in or out."
		""
		"Turn a &eCrank&r attached to it to wind the rope, dragging whatever hangs on the end (up to 8 blocks) up or down. Build a mine elevator!"
	]
	quest.4D7982854D75D083.quest_subtitle: "Elevator not included"
	quest.4D7982854D75D083.title: "Going Up"
	quest.4D82777D1D00E60E.quest_desc: [
		"Catch a Pokémon that is both &2Bug&r and &7Steel&r."
		""
		"Steel covers almost every Bug weakness: only Fire gets through, and it hits for four times the damage."
		"Poison does nothing at all."
	]
	quest.4D82777D1D00E60E.title: "Armored Insects"
	quest.4D88F9E6C07D5B97.quest_desc: [
		"&6Price:&r &e800 CobbleDollars&r for one."
		""
		"Clears all stat changes of the target Pokémon when used in battle"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.4D88F9E6C07D5B97.quest_subtitle: "800 CD"
	quest.4D88F9E6C07D5B97.title: "Moomoo Milk"
	quest.4D8BE593EADCBAC5.quest_desc: [
		"Cook three L candies into an &eExp. Candy XL&r (30,000 EXP)."
		""
		"&aNeed change? Any candy above XS breaks back down into the size below at a crafting table.&r"
	]
	quest.4D8BE593EADCBAC5.title: "Sugar Mountain"
	quest.4DB0B478D0CC0891.quest_desc: [
		"&6Price:&r &e1,500 CobbleDollars&r for one."
		""
		"Temporarily raises the target's Accuracy stat by one stage when used in battle"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.4DB0B478D0CC0891.quest_subtitle: "1,500 CD"
	quest.4DB0B478D0CC0891.title: "X Accuracy"
	quest.4DC26938EC88E58C.quest_desc: [
		"Catch &e5&r Pokémon in deserts or badlands biomes (Terralith variants count)."
		""
		"&bSandile&r, &bTrapinch&r, &bCacnea&r, &bBaltoy&r and &bSilicobra&r love the heat."
	]
	quest.4DC26938EC88E58C.title: "Sun-Baked"
	quest.4DE0607D30A0EF18.quest_desc: [
		"Place four &eSoul Sand&r (or Soul Soil) in a T shape and top it with three &eWither Skeleton Skulls&r. Do it far from home: the Wither blasts blocks and spreads Wither."
		""
		"Its &eNether Star&r crafts a &eBeacon&r and goes into Cobblemon's &eMaster Ball&r and &eAbility Patch&r recipes."
	]
	quest.4DE0607D30A0EF18.title: "&8The Wither"
	quest.4DEB4FB9D465376B.quest_desc: [
		"Mine a block of &eEnchanted Ice&r."
		""
		"It only drops itself when mined with Silk Touch."
	]
	quest.4DEB4FB9D465376B.title: "Cold Glow"
	quest.4DF32C6FC46C35E9.quest_desc: [
		"Out of season, crops still grow, but slowly. Hover a crop to see its &eFertile Seasons&r."
		"&eWheat&r Summer and Autumn; &eCarrots&r Spring and Autumn; &ePotatoes&r Spring; &eBeetroot&r and &ePumpkins&r Autumn; &eMelons&r, &eSugar Cane&r and &eCocoa&r Summer; &eSweet Berries&r Spring and Winter."
		"&aTip:&r crops under a glass roof, or deep underground below Y 48, ignore the seasons."
		"&aPokémon tie-in:&r Eevee has seasonal forms here: evolved in the right season it becomes a Spring Espeon, Summer Glaceon, Autumn Sylveon or Winter Jolteon."
	]
	quest.4DF32C6FC46C35E9.title: "Out of Season"
	quest.4DFE6181573DCB1D.quest_desc: [
		"Use a Fire Stone on Growlithe, Vulpix, Pansear or Capsakid, or a Water Stone on Shellder, Staryu, Poliwhirl, Lombre or Panpour."
		""
		"Hold the stone and use it on the Pokémon."
	]
	quest.4DFE6181573DCB1D.title: "Fire and Water"
	quest.4E033C2181AE6F00.quest_desc: [
		"Hold it to drift down slowly, or raise it like a shield."
		""
		"&6Where to look:&r buried treasure, village tanneries, brushing Desert Wells."
	]
	quest.4E033C2181AE6F00.title: "Umbrella"
	quest.4E0462B6EE526C7A.quest_desc: [
		"&6Price:&r &e1,000,000 CobbleDollars&r for one."
		""
		"Guaranteed capture"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.4E0462B6EE526C7A.quest_subtitle: "1,000,000 CD"
	quest.4E0462B6EE526C7A.title: "Master Ball"
	quest.4E1B8D054C0DF1D1.quest_desc: ["Keep the battle going until your Greninja transforms into &eAsh-Greninja&r."]
	quest.4E1B8D054C0DF1D1.title: "Bond Phenomenon"
	quest.4E25AB01D977DC70.quest_desc: [
		"Catch 10 &2Bug&r-type Pokémon. Dual-type Pokémon count for both of their types."
		""
		"&6Strong against:&r Grass, Psychic, Dark"
	]
	quest.4E25AB01D977DC70.title: "Bug Collector"
	quest.4E271C552C46CA67.quest_desc: [
		"Walk along a &6Gravel Beach&r."
		""
		"Slowpoke doze by the tide, while Wiglett and Crabrawler roam the stones."
	]
	quest.4E271C552C46CA67.title: "Pebble Beach"
	quest.4E2E5853343C9B7E.quest_desc: [
		"Defeat 25 wild &1Dragon&r-type Pokémon in battle."
		""
		"&6Weak to:&r Dragon, Fairy, Ice"
		"&cResists:&r Electric, Fire, Grass, Water"
	]
	quest.4E2E5853343C9B7E.title: "Dragon Slayer"
	quest.4E46F22C7BE9B5BD.quest_desc: [
		"Before you have a Pokémon that swims, a &eBoat&r gets you across lakes and along coasts."
		""
		"Any wood works in game; this quest checks for an &eOak Boat&r. A &eChest Boat&r hauls cargo too."
	]
	quest.4E46F22C7BE9B5BD.title: "Row, Row, Row"
	quest.4E72633F37DE89B4.quest_desc: [
		"2 &eWarp Dust&r and a &eFlint&r make a &eDormant Shard&r."
		""
		"You need one inside every Warp Plate recipe, plus one more for each link you make."
	]
	quest.4E72633F37DE89B4.title: "Sleeping Shard"
	quest.4E75D39D4B5CFEB4.quest_desc: [
		"Surround the previous Heal Upgrade with &e4 Blocks of Iron&r."
		""
		"Cuts the recharge time by &e20%&r: about &e120 seconds&r between heals."
	]
	quest.4E75D39D4B5CFEB4.title: "Heal Upgrade Tier 1"
	quest.4E8231D9E8ED01A1.quest_desc: [
		"Tom's turns a wall of ordinary chests into one inventory you can search from a single screen."
		""
		"Most blocks in this branch have a &eChest&r in their recipe, so start with eight."
	]
	quest.4E8231D9E8ED01A1.title: "Tom's Simple Storage"
	quest.4E8539DD28F0363F.quest_desc: [
		"Discover a &eBetter Desert Temple&r."
		""
		"Baltoy, Yamask and Cofagrigus haunt its halls, and a rare Spiritomb appears at night."
		"&cThe temple curses intruders with Mining Fatigue. Its master waits in the &eMonster Hunter&r chapter.&r"
	]
	quest.4E8539DD28F0363F.title: "An Ancient Tomb"
	quest.4E8C4DEA11FB761D.quest_desc: [
		"Pour water onto a still lava source to turn it into &eObsidian&r, then mine it with a &ediamond pickaxe&r."
		""
		"Nether Portals and Enchanting Tables are built from it."
		"&aPokémon tip:&r obsidian also makes Heavy-Duty Boots and the obsidian bottle caps of Cobblemon Utility+."
	]
	quest.4E8C4DEA11FB761D.title: "Forged in Water"
	quest.4EA1901A8A45F7BD.quest_desc: [
		"&e4 Crafting Tables&r and &e4 Diamonds&r around a &eStorage Terminal&r."
		""
		"A terminal with a built-in crafting table, so you craft with everything the network holds."
	]
	quest.4EA1901A8A45F7BD.title: "Crafting Terminal"
	quest.4EA7E420A571541B.quest_desc: ["Craft a &eLoom Table&r from 3 Wool, 2 Sticks, 3 Logs and a Crafting Table."]
	quest.4EA7E420A571541B.title: "Loom Table"
	quest.4EAC39923887DF0E.quest_desc: [
		"Get an &eEnchanted Book&r: enchant a plain Book, trade with a &eLibrarian&r villager, or find one in a chest."
		""
		"A book holds its enchantment until you join it to gear on an &eAnvil&r."
	]
	quest.4EAC39923887DF0E.title: "Spellbound Pages"
	quest.4EC305F52FE93F1C.quest_desc: [
		"Key item: &eSmoker&r."
		""
		"Only smoking recipes are allowed:"
		"perfect for a dedicated food furnace."
	]
	quest.4EC305F52FE93F1C.title: "Augment: Smoking"
	quest.4ECC52CCA2045800.quest_desc: [
		"&e3 Logs&r, &e4 Planks&r and a &eStorage Upgrade Base&r."
		""
		"Re-skin your storage with other materials and colors. It also sets what a &ePaintbrush&r applies to storage blocks in the world."
	]
	quest.4ECC52CCA2045800.title: "Decoration Table"
	quest.4F03EEF41A2041C4.quest_desc: [
		"Three &eHearty Grains&r and a &eDried Kelp&r make 3 &ePonigiri&r."
		""
		"Add a nutrition seasoning such as fish, meat, an egg or a vegetable and it becomes the filling."
	]
	quest.4F03EEF41A2041C4.title: "Rice Ball Run"
	quest.4F0E48F92722C8CE.quest_desc: [
		"Iron, a &eSlime Block&r, a &eSticky Piston&r and Gunpowder build a &eSpring Launcher&r."
		""
		"Power it and it springs out, flinging anything on top into the air. Falling onto one from 5 or more blocks launches it automatically."
	]
	quest.4F0E48F92722C8CE.title: "Boing!"
	quest.4F4974AA9981DD50.quest_desc: [
		"&6Price:&r &e1,500 CobbleDollars&r for one."
		""
		"Temporarily boosts a Pokémon's critical hit ratio when used in battle"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.4F4974AA9981DD50.quest_subtitle: "1,500 CD"
	quest.4F4974AA9981DD50.title: "Dire Hit"
	quest.4F5C2B65261022FF.quest_desc: [
		"Catch a &eCrabrawler&r."
		""
		"It is common on the &6White Cliffs&r and on gravel beaches."
	]
	quest.4F5C2B65261022FF.title: "Crab Boxer"
	quest.4F8540D2BCA3BCE0.quest_desc: [
		"Register &e500&r species as &eSeen&r (caught species count too)."
		""
		"Scan everything you meet. A seen entry tells you a species exists here, even before you catch one."
	]
	quest.4F8540D2BCA3BCE0.title: "Eyes Everywhere"
	quest.4F94564E4F406615.quest_desc: [
		"Ripe Apricorns sometimes drop an &eApricorn Sprout&r, and sprouts also turn up in mineshaft chests."
		""
		"Plant a sprout of every color and you never have to hunt for Poké Ball materials again. Apricorns grow in every season."
	]
	quest.4F94564E4F406615.title: "Reapriforestation"
	quest.4FAFBF2CDE84B946.quest_desc: [
		"Catch 3 Pokémon of any kind."
		""
		"Different species fill different roles: mix types so one weakness cannot sweep your whole team."
	]
	quest.4FAFBF2CDE84B946.title: "A Growing Team"
	quest.4FE25365A25C5A54.quest_desc: [
		"&6Price:&r &e2,500 CobbleDollars&r for one."
		""
		"If holder is hit by a physical move, attacker loses 1/8 of its max HP"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.4FE25365A25C5A54.quest_subtitle: "2,500 CD"
	quest.4FE25365A25C5A54.title: "Jaboca Berry"
	quest.4FE67D1128DDD13E.quest_desc: [
		"Catch &e10&r Pokémon of level &e10&r or lower."
		""
		"&aTip:&r a &eNest Ball&r gets stronger the further below level 30 its target is, up to 4x."
	]
	quest.4FE67D1128DDD13E.title: "Small Fry"
	quest.4FE89625ABBA4883.quest_desc: [
		"Revive a &eTyrunt&r (Rock/Dragon) from a &eJaw Fossil&r."
		""
		"Look for it at eroded pillars, lush dens, mud pits and sunscorched dens."
	]
	quest.4FE89625ABBA4883.title: "Tyrunt"
	quest.4FEA698908D79C11.quest_desc: [
		"Catch a Pokémon with a &eFast Ball&r."
		""
		"&aSpeedy species are its specialty: check base stats in REI.&r"
	]
	quest.4FEA698908D79C11.title: "Gotta Go Fast"
	quest.4FF93F649A747905.quest_desc: [
		"Catch a &6shiny Legendary&r Pokémon."
		""
		"Shinies appear 1 in 4,096, and Legendaries are rare to begin with. Few trainers ever see one."
	]
	quest.4FF93F649A747905.title: "A Legend That Shines"
	quest.500154447D91B9C1.quest_desc: ["Sleep through the night while Lucid Dreaming. A pleasant dream can leave a &eLunar Feather&r on your pillow."]
	quest.500154447D91B9C1.title: "Sweet Dreams"
	quest.5012AA488CBDB0E9.quest_desc: [
		"Hold use with the &ePokédex&r while aiming at a Pokémon within about 10 blocks to scan it. Tap use to browse entries."
		""
		"Scan 3 Pokémon. The &cPokédex Research&r chapter takes it from here."
	]
	quest.5012AA488CBDB0E9.title: "Field Notes"
	quest.501716F6CE7E8E56.quest_desc: [
		"&aCarbink&r appear in dark caves right next to diamond ore."
		""
		"Catch one, then check the walls around it."
	]
	quest.501716F6CE7E8E56.title: "Diamond in the Rough"
	quest.50189BC3B8CCBF7D.quest_desc: [
		"The highest and hottest places in the world."
		""
		"Mountains hide &eDragon&r- and &eFighting&r-types; volcanoes bring the &eFire&r and some of the rarest legends."
		"&aTip:&r a few spawns need altitude, like Galarian Articuno above Y 110."
	]
	quest.50189BC3B8CCBF7D.title: "Peaks and Volcanoes"
	quest.501AB151EAEA508A.quest_desc: [
		"Wild &eMint&r plants grow on high ground above Y 70, and get more common the higher you climb."
		""
		"Leaf colors: &cRed&r Attack, &9Blue&r Defense, &bCyan&r Sp. Atk, &dPink&r Sp. Def, &aGreen&r Speed, &fWhite&r neutral."
		""
		"&aTip:&r a fully grown White Mint can drop seeds of the other colors."
	]
	quest.501AB151EAEA508A.title: "Minty Fresh"
	quest.5046AE6C6629325C.quest_desc: [
		"&6Price:&r &e2,000 CobbleDollars&r for one."
		""
		"Evolves Milcery into Alcremie with a Strawberry Sweet"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.5046AE6C6629325C.quest_subtitle: "2,000 CD"
	quest.5046AE6C6629325C.title: "Strawberry Sweet"
	quest.50648334925944BE.quest_desc: [
		"&e8 Diamonds&r around a &eGold Backpack&r."
		""
		"&e108 slots&r and &e5 upgrade slots&r: room for a proper upgrade loadout."
	]
	quest.50648334925944BE.title: "Diamond Backpack"
	quest.5065779843ED5D32.quest_desc: [
		"&oMultiplayer.&r Trade a Pokémon with another trainer through the interaction menu on that player."
		""
		"Some species only evolve when traded; see the &cEvolution&r chapter."
	]
	quest.5065779843ED5D32.title: "Take Good Care!"
	quest.5073E05EF6519E61.quest_desc: ["&eKelpsy Berry&r + Hearty Grains + Honey. Raises &eAttack&r EVs by 4 per Mochi."]
	quest.5073E05EF6519E61.title: "Muscle Mochi"
	quest.5082BC355C933C5F.quest_desc: [
		"Use a Moon Stone on Clefairy, Jigglypuff, Nidorina, Nidorino, Skitty or Munna, or a Shiny Stone on Togetic, Roselia, Minccino or Floette."
		""
		"Hold the stone and use it on the Pokémon."
	]
	quest.5082BC355C933C5F.title: "Moonlight and Sparkles"
	quest.5093EDED6276E219.quest_desc: [
		"&6Price:&r &e6,000 CobbleDollars&r for one."
		""
		"Evolves Scyther into Kleavor"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.5093EDED6276E219.quest_subtitle: "6,000 CD"
	quest.5093EDED6276E219.title: "Black Augurite"
	quest.50A94D6FED81A27C.quest_desc: [
		"&6Price:&r &e500 CobbleDollars&r for one."
		""
		"Restores 1/3 max HP at 1/4 max HP or less; confuses if -SpD Nature"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.50A94D6FED81A27C.quest_subtitle: "500 CD"
	quest.50A94D6FED81A27C.title: "Aguav Berry"
	quest.50B02D3A86EBD2A2.quest_desc: [
		"&eBlazes&r float around Nether Fortress spawners and shoot fireballs. Snowballs hurt them."
		""
		"Kill 10. Fire Resistance turns the fight in your favour."
	]
	quest.50B02D3A86EBD2A2.title: "Fire Fighter"
	quest.50B969BB75EBB617.quest_desc: [
		"One of the new Megas from Pokémon Legends: Z-A."
		"Lets &eFeraligatr&r Mega Evolve."
		""
		"Recipe: raw Mega Stone, a Diamond, a &eRazor Fang&r and two &eLapis Lazuli&r."
	]
	quest.50B969BB75EBB617.title: "Feraligite"
	quest.50BC2C0594FB41D2.quest_desc: [
		"A &eNetherite Chest&r, a linked &eStorage Controller&r network, a &eCrafting Terminal&r and an &eAdvanced Wireless Terminal&r: your storage now works for you."
		""
		"Claim this when all four are done. Somewhere, a Pokémon Center nurse nods in approval."
	]
	quest.50BC2C0594FB41D2.title: "&lA Place for Everything"
	quest.50D1DB6855D17583.quest_desc: [
		"Combine an &eArrow&r with &eRope&r in a crafting grid to load a &eRope Arrow&r (up to 32 rope)."
		""
		"Fire it at a wall or ledge and it lays its rope out where it lands: instant climbing line."
	]
	quest.50D1DB6855D17583.title: "Grappling Shot"
	quest.50F255D5FF4DD232.quest_desc: [
		"Find a &emushroom village&r."
		""
		"CTOV only builds these on the rare &6Mushroom Fields&r, usually far out at sea."
	]
	quest.50F255D5FF4DD232.title: "Fun Guys"
	quest.50F31143DB180DF7.quest_desc: [
		"&eTNT&r wrapped in four &eIron Ingots&r with a &eString&r fuse. Throw a &eBomb&r for a small blast that only breaks weak blocks."
		""
		"&aTip:&r look for the stronger &9Blue Bomb&r in dungeon, mineshaft and stronghold chests."
	]
	quest.50F31143DB180DF7.title: "Handle With Care"
	quest.513DDB16B634F6C4.quest_desc: [
		"Craft a &eMegaroid Compass&r: a Compass ringed by four Iron Ingots, two Amethyst Shards and two Redstone."
		""
		"Right-click to search for the nearest &6Megaroid&r, Shift + right-click to reset. It only works in the Overworld."
	]
	quest.513DDB16B634F6C4.title: "Meteorite Detector"
	quest.513EF000CA24D7FA.quest_desc: [
		"&eSlimes&r appear in swamps at night and deep underground in special slime chunks. Big ones split into smaller ones."
		""
		"Kill 10. Slimeballs make Leads, Sticky Pistons and Magma Cream."
	]
	quest.513EF000CA24D7FA.title: "Bouncing Blobs"
	quest.5140F76A2B5B6C0F.quest_desc: [
		"&eAncient Debris&r is the rarest ore in the Nether. The larger veins sit between &eY 8 and Y 24&r, and it never generates touching air."
		""
		"It needs a Diamond Pickaxe and shrugs off explosions and lava. Many miners blast tunnels with TNT or beds, since beds explode in the Nether."
	]
	quest.5140F76A2B5B6C0F.title: "Buried Treasure"
	quest.5159B95A842A2E57.quest_desc: [
		"Cobblemon adds &eNether Fire Stone Ore&r, set into netherrack across every Nether biome. Look at one to complete this quest."
		""
		"Mining it drops a &eFire Stone&r (Fortune helps). Fire Stones evolve &eVulpix&r, &eGrowlithe&r, &eEevee&r (into Flareon), &ePansear&r and &eCapsakid&r."
	]
	quest.5159B95A842A2E57.title: "Embers in the Rock"
	quest.5159DED5D6BC6AA9.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.5159DED5D6BC6AA9.quest_subtitle: "5,000 CD"
	quest.5159DED5D6BC6AA9.title: "White Herb"
	quest.515BA4C3E8A4233E.quest_desc: [
		"&eWither Skeletons&r stalk Nether Fortresses with stone swords that inflict Wither."
		""
		"Kill 10. Each has a small chance to drop a &eWither Skeleton Skull&r, and the Wither needs three."
	]
	quest.515BA4C3E8A4233E.title: "Bone Dry"
	quest.516861D21DA9278D.quest_desc: [
		"Pulls nearby items to you."
		""
		"&6Where to look:&r Ruined Portals, shipwreck treasure, brushing Desert Wells; rarely worn by piglins."
	]
	quest.516861D21DA9278D.title: "Universal Attractor"
	quest.516DAD86B826AD93.quest_desc: ["Catch 5 Mythical Pokémon."]
	quest.516DAD86B826AD93.title: "Myth Hunter"
	quest.518D4D07F91429CD.quest_desc: [
		"With all eight badges, &eRival Terry&r wants one more battle. Find him on the plains or near End Cities."
		""
		"Staraptor, Electivire, Darmanitan, Hatterene, Kartana and Blastoise."
	]
	quest.518D4D07F91429CD.quest_subtitle: "Rival Terry"
	quest.518D4D07F91429CD.title: "One Last Time?"
	quest.51919E22EBAF70E9.quest_desc: ["Level up Eevee with 160 or more friendship at night."]
	quest.51919E22EBAF70E9.title: "Umbreon"
	quest.5195327D336D9E44.quest_desc: [
		"&6Price:&r &e2,000 CobbleDollars&r for one."
