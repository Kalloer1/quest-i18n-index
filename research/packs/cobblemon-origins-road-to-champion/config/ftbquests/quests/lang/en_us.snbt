	quest.1DB969F8F0090BF3.title: "Revival Herb"
	quest.1DEA24A9CFB1EB12.quest_desc: [
		"The deluxe Drinking Hat: same fast drinking and eating, far more style."
		""
		"&6Where to look:&r brushing Desert Wells, mineshaft chests, buried treasure; rarely worn by skeletons."
	]
	quest.1DEA24A9CFB1EB12.title: "Novelty Drinking Hat"
	quest.1DF602E370060662.quest_desc: [
		"Smelt cobblestone into stone, then smelt that stone again for &eSmooth Stone&r."
		""
		"You need it for a &eBlast Furnace&r and for a Pokémon &ePC&r."
	]
	quest.1DF602E370060662.title: "Smooth Operator"
	quest.1DFD80A03F07BA54.quest_desc: ["&eEnigma Berry&r + Hearty Grains + Honey. Resets every EV to 0: a clean slate for retraining."]
	quest.1DFD80A03F07BA54.title: "Fresh-Start Mochi"
	quest.1E06FA299D1F9820.quest_desc: [
		"&6Price:&r &e200 CobbleDollars&r for one."
		""
		"Restores 10 HP when at 1/2 max HP or less"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.1E06FA299D1F9820.quest_subtitle: "200 CD"
	quest.1E06FA299D1F9820.title: "Oran Berry"
	quest.1E21FAD0A938034D.quest_desc: [
		"Gather 50 Cosmic Dust and &dCosmog&r emerges from the void."
		""
		"&aIt becomes Cosmoem at level 43, then Solgaleo by day or Lunala by night at level 53.&r"
	]
	quest.1E21FAD0A938034D.title: "Nebby"
	quest.1E738D6841BF3944.quest_desc: [
		"Surround a &eNormalium-Z&r with a Water, Thunder, Leaf and Fire Stone to craft &eEevium-Z&r."
		""
		"An Eevee holding it turns Last Resort into Extreme Evoboost."
	]
	quest.1E738D6841BF3944.title: "Eevee's Big Moment"
	quest.1E8F6FC68361B05D.quest_desc: [
		"Craft a &eDynamax Band&r: three Pink Apricorns, two Iron Ingots, a Wishing Star and three Blue Apricorns."
		""
		"Wear it in the &eDynamax Slot&r."
	]
	quest.1E8F6FC68361B05D.title: "Go Big"
	quest.1E93DC5F69DA2C70.quest_desc: [
		"Seasonings change a dish: each recipe accepts its own kind."
		"&eBait seasoning&r (Berries, apples, golden fruit): what a Poké Snack or Poké Bait attracts."
		"&eNutrition seasoning&r (meat, fish, eggs, vegetables): Ponigiri fillings."
		"&eFlavor seasoning&r (Berries): Aprijuice boosts. Hover an ingredient to see its seasoning info."
	]
	quest.1E93DC5F69DA2C70.title: "Season to Taste"
	quest.1E9E95D01BB26BE0.quest_desc: [
		"Revive a &eTirtouga&r (Water/Rock) from a &eCover Fossil&r."
		""
		"Look for it at frozen ponds, hydrothermal vents, preserved skeletons and underwater fissures."
	]
	quest.1E9E95D01BB26BE0.title: "Tirtouga"
	quest.1EA9150EA36B8027.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Changes a Pokémon's stats to be that of a Hasty nature"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.1EA9150EA36B8027.quest_subtitle: "5,000 CD"
	quest.1EA9150EA36B8027.title: "Hasty Mint"
	quest.1EB2C12B00505F34.quest_desc: [
		"Unlock each room and right-click the Regi statue inside. It breaks apart, the titan awakens with at least three perfect IVs, and you receive its &eTablet&r."
		""
		"Catch &dRegirock&r, &dRegice&r, &dRegisteel&r, &dRegieleki&r and &dRegidrago&r."
	]
	quest.1EB2C12B00505F34.title: "The Titans Awaken"
	quest.1EC2533F1CE40CF5.quest_desc: [
		"Build your own &eWaystone&r: 3 &eStone Bricks&r, a &eWarp Stone&r and 3 &eObsidian&r."
		""
		"Place one at home, at your farm, next to that perfect shiny-hunting spot. Only you can edit the waystones you place."
	]
	quest.1EC2533F1CE40CF5.title: "Home Base Beacon"
	quest.1ED5485F42C28676.quest_desc: [
		"Put the seven furnaces from the previous quest into a crafting grid (shapeless) to get &e8 Rainbow Plating&r."
		""
		"That is exactly the amount one Rainbow Furnace needs."
	]
	quest.1ED5485F42C28676.title: "Rainbow Plating"
	quest.1ED8E93866B6ED00.quest_desc: [
		"Craft a &eCounter&r from a Stone Button, 4 Stone and Redstone."
		""
		"Use it on a Pokémon to read how many of that species you have caught, knocked out, fished or hatched; use it in the air to switch to Streak Mode. Streaks feed the shiny boosts explained in Gotta Catch 'Em All."
	]
	quest.1ED8E93866B6ED00.title: "Keeping Count"
	quest.1EDA328F42559D8F.quest_desc: [
		"&e4 Obsidian&r in the corners, &e4 Blaze Rods&r on the edges, and your &eEmerald Furnace&r in the middle. (A Crystal Furnace fits too, but keep it for the Rainbow Plating.)"
		""
		"Cook time: &e20 ticks&r per item, ten times faster than vanilla."
	]
	quest.1EDA328F42559D8F.title: "Obsidian Furnace"
	quest.1EF19DEE7CAA6E74.quest_desc: [
		"&e8 Blocks of Copper&r around an &eUpgrade Base&r."
		""
		"Every slot holds &e1.5x&r as many stacks. Up to &e3&r stack upgrades fit in one backpack."
	]
	quest.1EF19DEE7CAA6E74.title: "Stack Upgrade Starter Tier"
	quest.1EF299AF86A6D7F0.quest_desc: [
		"Medicinal Brew + an &eOran Berry&r = &ePotion&r (restores 20 HP). Works in the Campfire Pot or the Brewing Stand."
		""
		"Cheap, quick and the first thing to stock before a long trip."
	]
	quest.1EF299AF86A6D7F0.title: "You Call This a Potion?"
	quest.1EFECB228301150E.quest_desc: [
		"Pull a &eUltra Capsule&r from a Poké Gacha Machine."
		""
		"Ultra Capsules can hold Ability Capsules and Patches, fossils, vitamins and Gilded Chests."
	]
	quest.1EFECB228301150E.title: "Ultra Capsule"
	quest.1F0554A910324BC4.quest_desc: ["Craft &eJars&r from 5 Glass each. Empty jars capture Aurora Essence and Restless Souls; you need a stack of 16 of each."]
	quest.1F0554A910324BC4.title: "Bottled Up"
	quest.1F0853244C8A14C3.quest_desc: [
		"Brew a &fPotion of Slow Falling&r: Awkward Potion + &ePhantom Membrane&r."
		""
		"Phantoms come for players who skip sleep for a few nights."
		"&aThe Zubat line, Drifloon and Duskull can drop membranes too.&r"
	]
	quest.1F0853244C8A14C3.title: "Feather Light"
