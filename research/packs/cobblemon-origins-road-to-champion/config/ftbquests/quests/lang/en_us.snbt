	quest.0723C3B0CE77E198.quest_desc: [
		"Surround the &eRainbow Core&r with &e8 Rainbow Plating&r to build the &eRainbow Furnace&r."
		""
		"It cooks at &e20 ticks&r per item, so the Netherite Furnace stays faster; this one is the trophy. Its tooltip hints at a power trick: with one furnace of every tier running a &eGenerator&r augment, it produces energy of its own."
	]
	quest.0723C3B0CE77E198.title: "&lTaste the Rainbow"
	quest.072880C25181B41A.quest_desc: [
		"Catch 10 &7Steel&r-type Pokémon. Dual-type Pokémon count for both of their types."
		""
		"&6Strong against:&r Ice, Rock, Fairy"
	]
	quest.072880C25181B41A.title: "Nerves of Steel"
	quest.072D9CB2C6C18B4C.quest_desc: [
		"&eApricorns&r grow on Apricorn trees in the wild, in seven colors. Right-click a fully grown one to pick it."
