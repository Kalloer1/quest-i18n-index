	]
	quest.2015C602D8FA71C4.title: "Snack Attack"
	quest.2015ED4B863C6A61.quest_desc: ["Craft a &eSpeed Silver Cap&r: four Iron Ingots, two Diamonds and three &eGreen Mint Leaves&r. It Hyper Trains the Speed IV to 31."]
