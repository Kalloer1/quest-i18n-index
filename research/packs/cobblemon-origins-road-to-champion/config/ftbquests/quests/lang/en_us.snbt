	quest.0BF50212DD5006AD.title: "Black Sludge"
	quest.0BFA85E913FFAC53.quest_desc: [
		"Kill 50 &eCreepers&r."
		""
		"The higher rungs of each ladder are about stamina. A good sword, armor and a well-lit base help."
	]
	quest.0BFA85E913FFAC53.title: "Demolition Expert"
	quest.0C01F5717316EEAD.quest_desc: [
		"Craft a &ePoké Gacha Machine&r from 5 Iron Ingots, 2 Glass, a Poké Ball and a Dispenser."
		""
		"Feed it Relic Coins and each pull dispenses one Capsule: Poké 51%, Great 24%, Ultra 15%, Master 7%, Cherish 3%."
	]
	quest.0C01F5717316EEAD.title: "Insert Coin"
	quest.0C401CA266E7C0EC.quest_desc: [
		"Built from a &ePickup Upgrade&r with &eEnder Pearls&r, &eIron&r, &eRedstone&r and &eLapis&r."
		""
		"Pulls nearby items into the backpack from &e3 blocks&r away. Great for Pokémon battles that scatter drops."
	]
	quest.0C401CA266E7C0EC.title: "Magnet Upgrade"
	quest.0C6D377FE4BC2F95.quest_desc: [
		"An &eEpitaph&r: 6 &eGold Nuggets&r, 2 &eAmethyst Shards&r and &eDeepslate&r."
		""
		"Die with one in your inventory and a &eFleeting Memorial&r appears near the spot, a waystone you can warp back to. Your grave is waiting there with your items."
	]
	quest.0C6D377FE4BC2F95.title: "Last Words"
	quest.0C8D5AF488BF4460.quest_desc: [
		"Spot a &eWandering Trader&r. He turns up near players now and then with two llamas in tow."
		""
		"His offers differ from regular villagers, so check what he brought."
	]
	quest.0C8D5AF488BF4460.title: "Just Passing Through"
	quest.0CE4B257FA45AF96.quest_desc: [
		"One of the new Megas from Pokémon Legends: Z-A."
		"Lets &eZygarde&r in its Complete Forme Mega Evolve."
		""
		"Recipe: raw Mega Stone, a Diamond, a &eNether Star&r and two &eNetherite Ingots&r."
	]
	quest.0CE4B257FA45AF96.title: "Zygardite"
	quest.0CF08F5BA4593DB2.quest_desc: [
		"Craft a &eFishingNav&r: 4 &ePrismarine Shards&r, &ePrismarine Crystals&r, &eRedstone&r, an &eElectirizer&r, a &eWater Gem&r and an &eUpgrade&r."
		""
		"While fishing, sneak and right-click it to see what can bite. Water Gems are crafted from Hard Stone and a Passho Berry."
	]
	quest.0CF08F5BA4593DB2.title: "Fish Finder"
	quest.0D0B4DFC2FF13757.quest_desc: [
		"Craft a &eFriend Ball&r: 2 Green Apricorns, 1 Red Apricorn and 1 Yellow Apricorn around an &eIron Ingot&r."
		""
		"&6Catch rate:&r 1x, and the Pokémon starts with 150 Friendship."
	]
	quest.0D0B4DFC2FF13757.title: "Friend Ball"
	quest.0D0B58AD23DF327E.quest_desc: [
		"&eSmoked-Tail Curry&r needs a &eTasty Tail&r: shear a Slowpoke for one. Its tail grows back in about 20 minutes."
		""
		"Recipe: Hearty Grains, the Tasty Tail, a &eCarrot&r and &eGalarica Nuts&r."
	]
	quest.0D0B58AD23DF327E.title: "Tail of Two Cities"
	quest.0D29F8D56EA1B8BA.quest_desc: [
		"Lapis ore is most common around y=0, and each ore drops 4 to 9 pieces."
		""
		"&aPokémon tip:&r lapis goes into the &eExp. Share&r. The enchanting table uses it too."
	]
	quest.0D29F8D56EA1B8BA.title: "Deep Blue"
	quest.0D4385308673175E.quest_desc: [
		"Find a &eFishing Boat&r. They rest on beaches and on the sea floor of deep and warm oceans."
		""
		"Check the chest on board: it is one of the places a Poké Rod Smithing Template turns up."
	]
	quest.0D4385308673175E.title: "Anchors Aweigh"
	quest.0D53C6045ABEDB77.quest_desc: [
		"Tame one wolf of every variant."
		""
		"Each variant lives in different biomes, so this one takes you all over the world."
	]
	quest.0D53C6045ABEDB77.title: "The Whole Pack"
	quest.0D572093C9100BF2.quest_desc: [
		"Lets &eBlastoise&r Mega Evolve."
		""
		"Recipe: raw Mega Stone, two Iron Ingots, a Diamond and &eMystic Water&r."
	]
	quest.0D572093C9100BF2.title: "Blastoisinite"
	quest.0D5782263EFC9EDB.quest_desc: [
		"Melee hits heal you for a fifth of the damage dealt, up to 3 hearts a hit."
		""
		"&6Where to look:&r mineshaft chests, village armorers, brushing warm Ocean Ruins; rarely worn by husks."
	]
	quest.0D5782263EFC9EDB.title: "Vampiric Glove"
	quest.0D64BAC773A4230C.quest_desc: ["Defeat &e500&r wild Pokémon. By now your team needs more than raw levels: build it up with the EV, IV and held item branches."]
	quest.0D64BAC773A4230C.title: "Battle-Hardened"
	quest.0D69930AD0BA1D0D.quest_desc: ["Open a Lootr &eminecart&r. The chest minecarts in mineshafts are converted, so every player gets a ride."]
	quest.0D69930AD0BA1D0D.title: "Mine Cart, Your Cart"
	quest.0D6C593C13161348.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Changes a Pokémon's stats to be that of a Modest nature"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.0D6C593C13161348.quest_subtitle: "5,000 CD"
	quest.0D6C593C13161348.title: "Modest Mint"
	quest.0D86F3982C380ED5.quest_desc: [
		"Cook &eMax Soup&r in a &eCampfire Pot&r: three Max Mushrooms over a Bowl."
		""
		"Feed it to a Pokémon that has a Gigantamax form to unlock that form. Add Max Honey for Sweet Max Soup, which some Pokémon prefer."
	]
	quest.0D86F3982C380ED5.title: "Soup of the Giants"
	quest.0D8D3A87C89A5C6C.quest_desc: [
		"&6Price:&r &e400 CobbleDollars&r for one."
		""
		"1× catch rate"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.0D8D3A87C89A5C6C.quest_subtitle: "400 CD"
	quest.0D8D3A87C89A5C6C.title: "Ancient Azure Ball"
	quest.0DA3B38CE9BE2035.quest_desc: [
		"Collect all seven Mega Bracelets: white, red, yellow, pink, green, blue and black."
		""
		"Each uses the matching Apricorn color, and each needs its own Keystone."
	]
	quest.0DA3B38CE9BE2035.title: "Every Color of Power"
	quest.0DA8C7228684C726.quest_desc: [
		"At a &eSmithing Table&r, combine a &eNetherite Upgrade Smithing Template&r, your &eDiamond Backpack&r and a &eNetherite Ingot&r."
		""
		"The biggest backpack in the pack: &e120 slots&r and &e7 upgrade slots&r. Fill them with everything this chapter taught you."
	]
	quest.0DA8C7228684C726.title: "&lThe Netherite Pack"
	quest.0DB9471ABC96A94A.quest_desc: [
		"The &eStarter&r upgrade with &e4 Blocks of Iron&r."
		""
		"Every slot holds &e2x&r as many stacks. Up to &e3&r stack upgrades fit in one backpack."
	]
	quest.0DB9471ABC96A94A.title: "Stack Upgrade Tier 1"
	quest.0DC83AB5FE095CDE.quest_desc: ["&ePomeg Berry&r + Hearty Grains + Honey. Raises &eHP&r EVs by 4 per Mochi."]
	quest.0DC83AB5FE095CDE.title: "Health Mochi"
	quest.0DC9D6B7245706D8.quest_desc: [
		"A full library, an anvil, lingering brews and a Beacon of your own: vanilla magic holds no more secrets."
		""
		"Claim your reward, then keep a few Fire Resistance and Healing potions packed for the road ahead."
	]
	quest.0DC9D6B7245706D8.title: "Master of the Arcane"
	quest.0DD285C74E4A1FAB.quest_desc: [
		"Cook all ten Regional Delicacies. The other eight:"
		"&eRage Candy Bar&r: Wheat, Milk, Sugar, Cocoa Beans."
		"&eLava Cookie&r: 2 Hearty Grains, Dried Kelp, Magma Cream."
		"&eJubilife Muffin&r: 2 Hearty Grains, Honey, Sweet Berries."
		"&eOld Gateau&r: Potato, Beetroot, Honey, Sugar."
		"&eCasteliacone&r: Wheat, Milk, Snowball, Sugar."
		"&eLumiose Galette&r: Wheat, Milk, Sugar, Glow Berries."
		"&eBig Malasada&r: Wheat, Milk, Sugar, a Melon block."
		"&eOpen-Faced Sandwich&r: Bread, Egg, raw meat and a vegetable."
	]
	quest.0DD285C74E4A1FAB.title: "Culinary World Tour"
	quest.0DD844145CF2F943.quest_desc: [
		"Gold ore lies below y=32, most of it around y=-16. Badlands are the jackpot: gold there runs from y=32 up to y=256."
		""
		"Collect enough raw gold for a &eBlock of Raw Gold&r."
	]
	quest.0DD844145CF2F943.title: "Gold Rush"
	quest.0DF0DDD2B8060214.quest_desc: [
		"Finish the &6Battle Frontier&r: Training and Battling, Road to Champion, Mega Evolution, Z-Moves, Tera and Dynamax, and Raid Dens."
		""
		"Every trainer beaten, every gimmick mastered, every raid boss brought down."
		""
		"&aUnlocks once every listed chapter finale is complete; then tick the checkmark.&r"
	]
	quest.0DF0DDD2B8060214.title: "Battle Legend"
	quest.0DF2473E44F2E4D8.quest_desc: [
		"Planks, a &ePC&r, a Hopper and two Wheat build a &ePasture Block&r."
		""
		"Build one at your base and you have the heart of a ranch: a home range for your Pokémon right next to your fields."
	]
	quest.0DF2473E44F2E4D8.title: "Ranch Builder"
	quest.0DF947AD3D9BF966.quest_desc: [
		"&6Price:&r &e8,000 CobbleDollars&r for one."
		""
		"Occasionally allows the holder to strike first"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.0DF947AD3D9BF966.quest_subtitle: "8,000 CD"
	quest.0DF947AD3D9BF966.title: "Quick Claw"
	quest.0E000BD998466204.quest_desc: [
		"Place a Tumblestone next to &eLava&r or a &eMagma Block&r."
		""
		"Heat makes it grow through bud stages into a cluster. Break the cluster for more Tumblestones and never run short again."
	]
	quest.0E000BD998466204.title: "Tumbling Down"
	quest.0E22F0F8E6E7C785.quest_desc: [
		"Find a &eDawn Stone&r."
		""
		"&6Ore:&r mountain peaks and the Skylands, rarer in flower biomes, glacial biomes and hills."
		"&6Evolves:&r a male Kirlia and a female Snorunt."
	]
	quest.0E22F0F8E6E7C785.title: "Crack of Dawn"
	quest.0E23C54E652E475F.quest_desc: [
		"Mine &eCoal Ore&r. It is common from around y=0 all the way up to the mountain tops."
		""
		"&aPokémon tip:&r Torkoal like to spawn right next to coal ore."
	]
	quest.0E23C54E652E475F.title: "Black Gold"
	quest.0E3F469F11B82E58.quest_desc: [
		"&6Price:&r &e15,000 CobbleDollars&r for one."
		""
		"Boosts the holder's Defense and Sp. Def if it is not fully evolved"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.0E3F469F11B82E58.quest_subtitle: "15,000 CD"
	quest.0E3F469F11B82E58.title: "Eviolite"
	quest.0E4B8D2BC2FB69CE.quest_desc: [
		"Reel in 10 Pokémon."
		""
		"Rivers, oceans, warm, cold and frozen waters each have their own fishing lists. Move around."
	]
	quest.0E4B8D2BC2FB69CE.title: "Regular at the Pier"
	quest.0E50EA4DD6061F2E.quest_desc: ["The &dPalkia&r pedestal stands at the Spear Pillar too. Summon it with the Red Chain and keep the &eSpace Globe&r it leaves."]
	quest.0E50EA4DD6061F2E.title: "Master of Space"
	quest.0E64012465A4A10B.quest_desc: [
		"A &eSharestone&r teleports you to any other Sharestone of the &esame color&r."
		""
		"Recipe: 3 &eStone Bricks&r, 2 dye, a &eWarp Stone&r and 3 &eObsidian&r. Every color works the same; this quest checks for a pair of &5Purple&r ones."
	]
	quest.0E64012465A4A10B.title: "Party Line"
	quest.0E6E557FD1A32FCF.quest_desc: [
		"Hatch the egg and feed the baby Sniffer the &eTorchflower Seeds&r from the egg quest."
		""
		"Once it grows up, the adult Sniffer digs up more ancient seeds from grass and dirt."
	]
	quest.0E6E557FD1A32FCF.title: "Little Sniffer"
	quest.0E6FCB084277CE7B.quest_desc: [
		"Seven Glass, an Eye of Ender and a &eGhast Tear&r craft an &eEnd Crystal&r."
		""
		"Four of them placed on the exit portal summon the dragon again. Keep them away from yourself: they explode when hit."
	]
	quest.0E6FCB084277CE7B.title: "Crystal Clear"
	quest.0E7876E0A4F2C100.quest_desc: [
		"Kill 50 &eSpiders&r."
		""
		"The higher rungs of each ladder are about stamina. A good sword, armor and a well-lit base help."
	]
	quest.0E7876E0A4F2C100.title: "Arachnophobia Cured"
	quest.0E8A91AC283B9625.quest_desc: [
		"Smear a &eHoney Bottle&r on a &eSaccharine Log&r."
		""
		"Saccharine trees grow in birch, flowery, magical and taiga biomes. Honey on their logs tempts Pokémon to come and visit, and each one drawn in has a &e1 in 100&r chance to be an &eAlpha&r."
	]
	quest.0E8A91AC283B9625.title: "Just a Smackerel"
	quest.0E8BB09AEAC7042A.quest_desc: [
		"Most Pokémon change into a stronger form once they meet a requirement: usually a level, sometimes a stone, a trade, friendship or something stranger."
		""
		"This chapter walks through every kind of evolution in the pack."
		"&aTip:&r a Pokémon holding an &eEverstone&r will not evolve."
	]
	quest.0E8BB09AEAC7042A.title: "&lEvolution"
	quest.0E940A30192C2458.quest_desc: [
		"&6Price:&r &e6,000 CobbleDollars&r for one."
		""
		"Evolves Duraludon into Archaludon"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.0E940A30192C2458.quest_subtitle: "6,000 CD"
	quest.0E940A30192C2458.title: "Metal Alloy"
	quest.0EA1A1F05BF16539.quest_desc: [
		"Collect all nine variant coins. Each is a Poké Gacha Coin plus one extra ingredient:"
		""
		"Erratic (Purple Dye), Blueberry (Cyan Dye), Tera (a Diamond), Citrine (Yellow Dye), Verdant (Green Dye), Azure (Blue Dye), Roseate (Pink Dye), Slate (Black Dye), Premier (White Dye)."
	]
	quest.0EA1A1F05BF16539.title: "Numismatist"
	quest.0EBB810681945C57.quest_desc: [
		"&6Price:&r &e3,000 CobbleDollars&r for one."
		""
		"Evolves Applin into Dipplin"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.0EBB810681945C57.quest_subtitle: "3,000 CD"
	quest.0EBB810681945C57.title: "Syrupy Apple"
	quest.0EBE17BC0E81E23D.quest_desc: [
		"Your starter kit's &eIron Pickaxe&r counts. Lost it? Three iron ingots and two sticks make another."
		""
		"It mines gold, redstone, emerald and diamond ore, plus every Cobblemon &eevolution stone ore&r. The &eInto the Depths&r chapter starts here."
	]
	quest.0EBE17BC0E81E23D.quest_subtitle: "The kit one counts"
	quest.0EBE17BC0E81E23D.title: "Trusty Pickaxe"
	quest.0ED7A4A3D913A8F6.quest_desc: [
		"The &eOmni Ring&r is one accessory that supports all four gimmicks: Mega Evolution, Z-Moves, Terastallization and Dynamax."
		""
		"Recipe: a Dynamax Band, any Key Stone accessory, any Z-Ring, a Netherite Ingot and a Tera Orb."
		"The original recipe uses a Wishing Star, a Keystone, a Sparkling Stone, a Netherite Ingot and a Tera Orb instead."
	]
	quest.0ED7A4A3D913A8F6.title: "&6The Omni Ring"
	quest.0F2D9E49387B71A1.quest_desc: [
		"Find an Explorify &ecampsite&r in a taiga."
		""
		"Abandoned tents with supplies left behind."
	]
	quest.0F2D9E49387B71A1.title: "Under Canvas"
	quest.0F3D5929F1710427.quest_desc: [
		"Catch a Pokémon with a &eMoon Ball&r."
		""
		"&aBest under a full moon.&r"
	]
	quest.0F3D5929F1710427.title: "Moonstruck"
	quest.0F60DA4FFDD3EB84.quest_desc: ["Craft a &eSp. Atk Silver Cap&r: four Iron Ingots, two Diamonds and three &eCyan Mint Leaves&r. It Hyper Trains the Sp. Atk IV to 31."]
	quest.0F60DA4FFDD3EB84.title: "Sp. Atk Silver Cap"
	quest.0F63B2D612EC39E3.quest_desc: [
		"&6Price:&r &e2,500 CobbleDollars&r for one."
		""
		"Fully restores the HP of a Pokémon"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.0F63B2D612EC39E3.quest_subtitle: "2,500 CD"
	quest.0F63B2D612EC39E3.title: "Max Potion"
	quest.0F6EF0C8794C541A.quest_desc: [
		"Break the &eMega Crystal&r at a Mega Site with a Diamond Pickaxe (no Silk Touch) to get a raw &eMega Stone&r."
		""
		"&aShortcut: smelt a spare Keystone in a &eBlast Furnace&r and it turns into a raw Mega Stone.&r"
		""
		"Raw stones are the base of every species Mega Stone."
	]
	quest.0F6EF0C8794C541A.title: "Rough Around the Edges"
	quest.0F89F5B3AC06C710.quest_desc: [
		"Your starter kit came with a &ePC&r: place it at your base. With a full party, new catches go straight into it, and it holds 60 boxes for swapping Pokémon in and out."
		""
		"&aWant one at an outpost too? Craft another from 4 Iron Ingots, 2 Copper Ingots, Glass and 2 Smooth Stone.&r"
	]
	quest.0F89F5B3AC06C710.title: "Storage System"
	quest.0F8AEF5222A0A0B5.quest_desc: [
		"Craft a &eLink Cable&r from two Copper Ingots, two Nether Quartz and an Ender Pearl."
		""
		"Use it on a Pokémon that evolves by trading and it evolves on the spot, no partner needed. The cable is used up."
	]
	quest.0F8AEF5222A0A0B5.title: "Link Up"
	quest.0F93159FA1D2A107.quest_desc: ["Win a &eHeavy Core&r from an Ominous Vault. Expect a few tries; it is a rare roll."]
	quest.0F93159FA1D2A107.title: "Dead Weight"
	quest.0FA724DB582E591A.quest_desc: [
		"&eLeppa&r and &eLum&r trees side by side can mutate a &eHopo Berry&r."
		""
		"Both restore 10 PP: Leppa when a held move runs dry, Hopo when you feed it to a Pokémon."
	]
	quest.0FA724DB582E591A.title: "Power Points"
	quest.0FE67ACFCA0882ED.quest_desc: [
		"Gunpowder, Blaze Powder and Coal or Charcoal make three &eFire Charges&r."
		""
		"Each one lights a portal or a campfire once, and a Dispenser fires them as fireballs."
	]
	quest.0FE67ACFCA0882ED.title: "Pocket Fireball"
	quest.0FEFC3D74586319F.quest_desc: [
		"&eSerene Seasons&r runs a calendar in the Overworld: spring, summer, autumn and winter, 24 days each (three 8-day sub-seasons). The world starts in early spring."
		""
		"Crops grow slowly out of season (their tooltips list the good seasons) but grow all year below Y 48. Winter brings snow and ice, and rain comes and goes with the season."
		""
		"&aCraft a Calendar to check the date (Farm and Husbandry).&r"
	]
	quest.0FEFC3D74586319F.title: "Seasons Change"
	quest.1023878DA7E6457D.quest_desc: ["Reel in 150 Pokémon. The water holds no more secrets from you."]
	quest.1023878DA7E6457D.title: "Old Salt"
	quest.106230ACC5858C8C.quest_desc: [
		"&eShipwreck Coves&r are caverns hidden beneath cold oceans."
		""
		"The flooded cove has its own fishing list (Chinchou, Horsea, Clamperl, Relicanth and more), and the gilded chests hold rare treasure."
	]
	quest.106230ACC5858C8C.title: "Sunken Secrets"
	quest.1073B8DD88F6C912.quest_desc: [
		"&6Price:&r &e6,000 CobbleDollars&r for one."
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.1073B8DD88F6C912.quest_subtitle: "6,000 CD"
	quest.1073B8DD88F6C912.title: "Eject Pack"
	quest.107DF032000832E1.quest_desc: [
		"Upgrade all four armor pieces to &eNetherite&r. That is four templates and four ingots, so start copying templates early."
		""
		"Netherite armor adds knockback resistance on top of the best protection in the game."
	]
	quest.107DF032000832E1.title: "Clad in Debris"
	quest.1088405C363E6B27.quest_desc: [
		"Craft a &eChisel&r from a Mason Table and an Iron Ingot."
		""
		"Use it to open the Mason Table menu wherever you are."
	]
	quest.1088405C363E6B27.title: "Chisel"
	quest.10A2C14E1B4FBBD3.quest_desc: [
		"A pot made of history, a living Sniffer, trimmed armor and the Mace in hand: the past has given up its secrets."
		""
		"A spare Heavy Core is yours. Two Maces never hurt."
	]
	quest.10A2C14E1B4FBBD3.title: "Keeper of the Past"
	quest.10A55F6CA8F1EFAA.quest_desc: [
		"&eBeetroot Seeds&r turn up in village farms and in mineshaft and dungeon chests. Grow &e6 Beetroot&r."
		""
		"Six Beetroot and a Bowl make Beetroot Soup, and pigs love them too."
	]
	quest.10A55F6CA8F1EFAA.title: "Can't Beet It"
	quest.10A97587DE1D102A.quest_desc: [
		"Revive an &eOmanyte&r (Rock/Water) from a &eHelix Fossil&r."
		""
		"Look for it at dripstone oases, enhydro agate pockets, eroded pillars, preserved skeletons and sandy dens."
	]
	quest.10A97587DE1D102A.title: "Omanyte"
	quest.10B8981C4F364AD3.quest_desc: [
		"Find a &eTumblestone&r."
		""
		"Brush the Suspicious Sand and Gravel of Cobblemon ruins: Tumblestones are among their rare finds."
		""
		"Tumblestones are the heart of the &eAncient Poké Balls&r (Poké Ball Workshop chapter). Sky and Black Tumblestones make the others."
	]
	quest.10B8981C4F364AD3.title: "The Rolling Stone"
	quest.10D03DB2C2C14A31.quest_desc: [
		"&eCatch Indicator&r reads your Pokédex for you."
		""
