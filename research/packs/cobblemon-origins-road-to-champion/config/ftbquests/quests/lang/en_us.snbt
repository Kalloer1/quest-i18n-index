	]
	quest.55EADC375E35CAD2.title: "Augment: Factory"
	quest.5605D36D08873438.quest_desc: [
		"&6Price:&r &e10,000 CobbleDollars&r for one."
		""
		"Boosts Pikachu's Attack and Sp. Atk"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.5605D36D08873438.quest_subtitle: "10,000 CD"
	quest.5605D36D08873438.title: "Light Ball"
	quest.5606333F1C297E4D.quest_desc: [
		"Catch any Kalos starter."
		""
		"&bChespin&r in forests, &bFennekin&r in deserts, &bFroakie&r in bamboo jungles and by fresh water."
	]
	quest.5606333F1C297E4D.title: "Vaniville Visitors"
	quest.5625E286A134A4EB.quest_desc: [
		"&eSticky Piston&r, &eIron&r, &eRedstone&r and a &eChest&r around an &eUpgrade Base&r."
		""
		"Sneak and right-click a chest with the backpack to restock the backpack from that chest."
	]
	quest.5625E286A134A4EB.title: "Restock Upgrade"
	quest.562A12BB1EED0F7C.quest_desc: [
		"Buy a &ePoké Treat Box&r from an Apprentice Entrepreneur (32 Emeralds and 32 Relic Coins)."
		""
		"&aEvery treat uses up one box: three for the legendary beasts and two for Latias and Latios.&r"
	]
	quest.562A12BB1EED0F7C.title: "Treats in a Box"
	quest.564BA644556EBCCE.quest_desc: [
		"Look at a wild Pokémon and press &eR&r to start a battle with your selected partner."
		""
		"Pick moves each turn and defeat 1 wild Pokémon. You cannot hit Pokémon yourself; battles are how you weaken them."
		""
		"&eJ&r opens the battle log."
	]
	quest.564BA644556EBCCE.title: "Battle Basics"
	quest.564E97EF3F180CB7.quest_desc: ["Craft a &eSoothe Bell&r: three Iron Ingots, an Iron Nugget and two Wool. The holder gains friendship faster, handy for friendship evolutions. Friendship is shown on the summary's Stats page."]
	quest.564E97EF3F180CB7.title: "Friendship Chime"
	quest.565DD9545C2BC2A4.quest_desc: [
		"Set the Beacon on a pyramid of mineral blocks: Iron, Gold, Emerald, Diamond or Netherite blocks all count."
		""
		"A 3x3 base unlocks Speed and Haste. Pay it an Iron Ingot, Gold Ingot, Emerald, Diamond or Netherite Ingot to pick the effect."
	]
	quest.565DD9545C2BC2A4.title: "Light the Pyramid"
	quest.5665160B5D2612D8.quest_desc: [
		"Catch &e5&r Pokémon in the &cNether&r. You need Obsidian for a portal first."
		""
		"&bMagby&r, &bHoundour&r, &bLitwick&r, &bNumel&r, &bSlugma&r, &bSalandit&r and &bSizzlipede&r all call it home."
	]
	quest.5665160B5D2612D8.title: "Hot Pursuit"
	quest.5680E5054D1C0BB4.quest_desc: [
		"Defeat 25 wild &cFire&r-type Pokémon in battle."
		""
		"&6Weak to:&r Ground, Rock, Water"
		"&cResists:&r Bug, Fairy, Fire, Grass, Ice, Steel"
	]
	quest.5680E5054D1C0BB4.title: "Fire Drill"
	quest.5685F6C3B2637FB8.quest_desc: [
		"Obtain any &eBerry&r. Wild Berry trees grow in small groves on the surface."
		""
		"&eOran&r and &ePersim&r trees grow in every biome; most other Berries only grow wild in the biomes they prefer."
	]
	quest.5685F6C3B2637FB8.title: "Very Berry"
	quest.56980A20F18764E8.quest_desc: ["Brew a PP Up with a &ePomeg Berry&r to make &eHP Up&r. Each one adds 10 HP EVs."]
	quest.56980A20F18764E8.title: "HP Up"
	quest.56AB1703E0E626CB.quest_desc: [
		"Two Berries and a Bowl make &eBerry Juice&r."
		""
		"A Pokémon holding it restores 20 HP when it falls below half health."
	]
	quest.56AB1703E0E626CB.title: "Squeeze the Day"
	quest.56C850FF8725A1A0.quest_desc: [
		"Use the Ash Cap on a &eGreninja&r with at least &e200 friendship&r."
		""
		"It enters its Bond form and gains the Battle Bond Ability."
	]
	quest.56C850FF8725A1A0.title: "Kindred Spirits"
	quest.56D01C66CA6D56BD.quest_desc: [
		"Catch a Pokémon with a &eTimer Ball&r."
		""
		"&aStall a few turns, then throw.&r"
	]
	quest.56D01C66CA6D56BD.title: "Patience Pays"
	quest.56D71BABE252BAE9.quest_desc: ["Catch 10 Legendary Pokémon."]
	quest.56D71BABE252BAE9.title: "Hall of Legends"
	quest.56DBB43D921E5C41.quest_desc: ["Craft the &eLibrarian&r's job site: 4 Wooden Slabs around a Bookshelf. Librarians trade Enchanted Books and Name Tags."]
	quest.56DBB43D921E5C41.title: "Librarian"
	quest.56FCAD4C3E82613C.quest_desc: [
		"&eSweet Berries&r, &eSugar&r, &eMilk&r and a &eHoney Bottle&r whip up a &eWhipped Dream&r."
		""
		"Traded while holding one, &eSwirlix&r evolves into Slurpuff."
	]
	quest.56FCAD4C3E82613C.title: "Cloud Nine"
	quest.56FD6364E33024EA.quest_desc: [
		"&6Party keys&r"
		"&eR&r: send out or recall the selected party Pokémon."
		"&eUp&r / &eDown&r arrows: cycle through your party."
		"&eO&r: hide or show the party overlay."
		"&eC&r: open the summary screen."
	]
	quest.56FD6364E33024EA.title: "Partner Controls"
	quest.570166B389DF63CB.quest_desc: [
		"Every species has favourite biomes, times and conditions."
		""
		"Look a Pokémon up in the recipe viewer (&eCobbleDex REI&r) for its spawn locations, or carry a &ePokéNav&r (Pokédex Research chapter) to list what can spawn where you stand."
	]
	quest.570166B389DF63CB.title: "Spawns Follow the Land"
	quest.57033C2B8D9FD454.quest_desc: [
		"Craft a &eRestoration Tank&r from Iron Ingots, Glass, a Composter and a &eRevive&r."
		""
		"Cook the Revive in a Campfire Pot (Heal Powder and a Honey Bottle) or buy one from a Cobble Merchant."
	]
	quest.57033C2B8D9FD454.title: "Restoration Tank"
	quest.5709CA9D69091FA9.quest_desc: [
		"A Full Restore, a Full Heal, a Max Revive, every Mochi, a Poké Snack and all seven Sweets: your bag and your kitchen are both stocked."
		""
		"Pick a nature Mint as a parting gift."
	]
	quest.5709CA9D69091FA9.title: "Chef and Apothecary"
	quest.5719B65B27D24E0D.quest_desc: [
		"&6Price:&r &e6,000 CobbleDollars&r for one."
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.5719B65B27D24E0D.quest_subtitle: "6,000 CD"
	quest.5719B65B27D24E0D.title: "Eject Button"
	quest.57405884987604C1.quest_desc: [
		"The &eBank&r buys: Relic Coin 50, Relic Coin Pouch 475, Relic Coin Sack 4,500, and every Gacha Coin for 50. It does not buy Emeralds."
		""
		"&aClick the checkmark once you have read this.&r"
	]
	quest.57405884987604C1.title: "Bank Holiday"
	quest.5741783073B6DDDB.quest_desc: ["Earn a &eTrial Key&r from a beaten Trial Spawner. Corridor pots and the entrance chest can hold one too."]
	quest.5741783073B6DDDB.title: "Key to Success"
	quest.575707AE17D24B53.quest_desc: [
		"Any &eCampfire Pot&r and &e7 Blocks of Iron&r around an &eUpgrade Base&r."
		""
		"Adds a Campfire Pot tab to the backpack, so your Campfire Pot recipes come along on the road."
	]
	quest.575707AE17D24B53.title: "Campfire Pot Upgrade"
	quest.5771D6CE285F94A7.quest_desc: [
		"Seven &eFlax&r and a &eString&r make a &eSack&r: a placeable bag with 9 slots for your odds and ends."
		""
		"&cCareful:&r sacks are heavy. Carry more than two and you become overencumbered and slow down."
	]
	quest.5771D6CE285F94A7.title: "Bag It Up"
	quest.57745A025ADC84EE.quest_desc: ["Craft the &eShepherd&r's job site: 2 String over 2 Planks. Looms also put patterns on banners."]
	quest.57745A025ADC84EE.title: "Shepherd"
	quest.5797E31A69D05A01.quest_desc: [
		"A stick and four &eIron Ingots&r. Fit a &eFaucet&r to a filled &eJar&r or another liquid container and open it to let the contents pour out below."
		""
		"Redstone can switch it on and off."
	]
	quest.5797E31A69D05A01.title: "Turn on the Tap"
	quest.579C4141D242F77C.quest_desc: ["Terastallize &e10&r times."]
	quest.579C4141D242F77C.title: "Crystallized"
	quest.57A3AC0EB89ED080.quest_desc: [
		"Find all 50 footprints of one Sword of Justice and it appears before you, then gives you its favorite snack:"
		"Cobalion: &eSpecial Meat Chunks&r. Terrakion: &eSpecial Spices&r. Virizion: &eSpecial Leafy Greens&r."
	]
	quest.57A3AC0EB89ED080.title: "Sword of Justice"
	quest.57B7396C9A7CEFE5.quest_desc: [
		"&6Price:&r &e600 CobbleDollars&r for one."
		""
		"Raises the Pokémon's HP EVs by 1"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.57B7396C9A7CEFE5.quest_subtitle: "600 CD"
	quest.57B7396C9A7CEFE5.title: "Health Feather"
	quest.57BCDDF871F065C6.quest_desc: [
		"Observatories stand in jungle biomes. Inside are PCs, Healing Machines, chests, barrels and Suspicious Sand and Gravel to brush."
		""
		"Their chests can hold &eType Gems&r, exactly what Z-Crystals are made of."
	]
	quest.57BCDDF871F065C6.title: "Jungle Stargazing"
	quest.57C262895377ADE5.quest_desc: [
		"&eUnown&r drift around the End in many letter forms. Catch one while you are in the End."
		""
		"The End is a Psychic paradise: Elgyem, Espurr, Gothita, Solosis, Inkay, Meditite and Sigilyph spawn here too, and Dragon Tamers, Psychics and Ace Trainers wander the outer islands."
	]
	quest.57C262895377ADE5.title: "Letters in the Void"
	quest.57CC562E922308CE.quest_desc: [
		"Eight Obsidian around an Eye of Ender make an &eEnder Chest&r."
		""
		"Every Ender Chest you place opens the same personal inventory, so whatever you store at home is also there in the field."
	]
	quest.57CC562E922308CE.title: "Pocket Dimension"
	quest.57DFFA488A843A5C.quest_desc: [
		"Find a &eberry patch&r habitat in a temperate biome."
		""
		"Its pool includes Snorlax, Munchlax, Plusle and Minun among the berry bushes."
	]
	quest.57DFFA488A843A5C.title: "Snack Attack"
	quest.57E7B8F1CBD4996B.quest_desc: [
		"Catch any Kanto starter."
		""
		"&bBulbasaur&r in jungles, &bCharmander&r on hills and volcanic ground, &bSquirtle&r near fresh water."
	]
	quest.57E7B8F1CBD4996B.title: "Pallet Town Picks"
	quest.57F89461ADEE04AF.quest_desc: [
		"&eMedicinal Brew&r is the base of most medicine: a &eMedicinal Leek&r and a &eGlass Bottle&r in the Campfire Pot, or a leek brewed into a &eWater Bottle&r in a Brewing Stand."
		""
		"Medicinal Leeks grow on top of fresh water, away from oceans and frozen biomes."
	]
	quest.57F89461ADEE04AF.title: "Local Apothecary"
	quest.57FB7B067C2B2FD1.quest_desc: [
		"&6Price:&r &e1,000 CobbleDollars&r for one."
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.57FB7B067C2B2FD1.quest_subtitle: "1,000 CD"
	quest.57FB7B067C2B2FD1.title: "Tamato Berry"
	quest.57FB8087407C4216.quest_desc: [
		"Craft &eSolganium-Z&r (Psychium-Z, two Steel Gems, two Sun Stones) and &eLunalium-Z&r (Psychium-Z, two Ghost Gems, two Moon Stones)."
		""
		"Combine both with three Dragon Gems into &eUltranecrozium-Z&r."
	]
	quest.57FB8087407C4216.title: "Light That Burns"
	quest.58051C1C442669E4.quest_desc: [
		"&6Price:&r &e30,000 CobbleDollars&r for 10."
