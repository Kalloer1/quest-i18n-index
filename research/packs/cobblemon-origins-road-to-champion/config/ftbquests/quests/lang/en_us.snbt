	quest.07A84B2BAF86B84E.quest_subtitle: "1,200 CD"
	quest.07A84B2BAF86B84E.title: "Repeat Ball"
	quest.07A9723F87A00F4B.quest_desc: [
		"Feed two adult animals of the same kind their favorite food to &ebreed&r them."
		""
		"Cows, sheep and goats eat &eWheat&r; pigs eat Carrots, Potatoes or Beetroot; chickens eat any seeds."
		""
		"Breeding keeps your pens full: more cows for milk and leather, more sheep for wool, more chickens for eggs."
	]
	quest.07A9723F87A00F4B.title: "The Birds and the Bees"
	quest.07C0D6E1B3366E11.quest_desc: ["Craft a &eLife Orb&r: two Ghast Tears, two Golden Apples, an Ender Pearl and four Tinted Glass. Every attack hits harder, at the cost of some HP each time."]
	quest.07C0D6E1B3366E11.title: "Life on the Edge"
	quest.07C4A312857C68E8.quest_desc: [
		"&bIlex Shrines&r sit quietly out in the wild. Use the GS Ball on one and &dCelebi&r steps out as the shrine crumbles."
		""
		"&cCelebi has no model yet in this Cobblemon version, so it cannot be caught yet.&r"
	]
	quest.07C4A312857C68E8.title: "Voice of the Forest"
	quest.07C6531ADE8EB752.quest_desc: [
		"Hold two &eWarp Plates&r, then place them."
		""
		"Put a &eDormant Shard&r into the first plate to attune it and take out the &eAttuned Shard&r (that completes this quest). Put it into the second plate: standing on the second plate for a moment now takes you to the first. Do it the other way too for a round trip."
	]
	quest.07C6531ADE8EB752.title: "Linked Plates"
	quest.07E3525E40EC071D.quest_desc: ["Craft a &eTM Machine&r: two Iron Ingots, two Copper Ingots, Tinted Glass and Redstone. It prints Technical Machines and shows which of your party can learn each move."]
	quest.07E3525E40EC071D.title: "Move Tutor"
	quest.07E716206F4A2876.quest_desc: [
