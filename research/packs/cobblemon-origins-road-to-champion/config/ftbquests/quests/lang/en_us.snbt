	quest.201A54EA1380E223.quest_desc: [
		"Explore a &6Forest&r."
		""
		"Sewaddle chew the leaves, Seedot and Pachirisu sit up in the treetops, and Flabébé float near flowers of their own colour."
		"&oThe ultra-rare Celebi is said to visit old forests.&r"
	]
	quest.201A54EA1380E223.title: "Into the Woods"
