	quest.63968881E8EEEBDA.title: "Inventory Interface"
	quest.63B8CE4DFA0EFB11.quest_desc: [
		"Five &eGlass&r and two &eGold Ingots&r. An &eHourglass&r accepts any sand, dust or powder: Sand, Redstone, Glowstone, even Gunpowder."
		""
