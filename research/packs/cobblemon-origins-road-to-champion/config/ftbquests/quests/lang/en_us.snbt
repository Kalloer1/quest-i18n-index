	quest.3A92509090946506.title: "Metronome"
	quest.3AA4382C941CA415.quest_desc: ["Brew a PP Up with a &eHondew Berry&r to make &eCalcium&r. Each one adds 10 Sp. Atk EVs."]
	quest.3AA4382C941CA415.title: "Calcium"
	quest.3AC83E3F5CD50F23.quest_desc: [
		"&eBastion Remnants&r are blackstone fortresses of the Piglins, full of gold and treasure."
		""
		"&cWarning:&r &ePiglin Brutes&r guard them and ignore your golden armor. Fight them one at a time."
	]
	quest.3AC83E3F5CD50F23.title: "Remnants of Glory"
	quest.3AED0C26B0DE38C4.quest_desc: [
		"&eWild Flax&r grows in small patches beside water all over the Overworld. Break it for &eFlax Seeds&r (Shears keep the plant instead)."
		""
		"Seeds also turn up in dungeon and mineshaft chests, and the Wandering Trader sells them."
	]
	quest.3AED0C26B0DE38C4.title: "Riverside Weeds"
	quest.3B00E8D4C415D065.quest_desc: [
		"&6Price:&r &e1,500 CobbleDollars&r for one."
		""
		"Halves damage taken from a supereffective Rock-type attack"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.3B00E8D4C415D065.quest_subtitle: "1,500 CD"
	quest.3B00E8D4C415D065.title: "Charti Berry"
	quest.3B15515D6777952A.quest_desc: [
		"&e4 Planks&r, a &eComparator&r, the &eSpyglass&r, &eGlowstone Dust&r, &eGlass&r and an &eEnder Pearl&r."
		""
		"Extends your reach to a &eStorage Terminal&r: open one you are looking at from up to &e16 blocks&r away."
	]
	quest.3B15515D6777952A.title: "Wireless Terminal"
	quest.3B184D17EF09056E.quest_desc: [
		"Catch one &cFire&r, one &9Water&r and one &aGrass&r Pokémon."
		""
		"Water douses Fire, Fire burns Grass and Grass drinks up Water."
		"Each one is strong against the next and weak to the last."
	]
	quest.3B184D17EF09056E.title: "The Starter Triangle"
	quest.3B21FF4D82A17234.quest_desc: [
		"&e4 Sticks&r around a &eRedstone Torch&r."
		""
		"Use it on a placed vanilla chest, barrel or shulker box to turn it into the Sophisticated version without emptying it."
	]
	quest.3B21FF4D82A17234.title: "Go Sophisticated"
	quest.3B3156DF030D3A77.quest_desc: [
		"Craft a &eCampfire Pot&r from 5 &eCopper Ingots&r, a &eGlass&r block and 2 &eApricorns&r; the Apricorn color sets the pot color. Place it on a lit &eCampfire&r."
		""
		"Open it for a recipe grid plus &eseasoning&r slots: seasonings flavor the dish or add effects to it."
		""
		"&aThe recipe book inside the pot lists everything you can cook right now.&r"
	]
	quest.3B3156DF030D3A77.title: "Pot on the Fire"
	quest.3B3AF459F317F880.quest_desc: [
		"Three diamonds and two sticks make a &eDiamond Pickaxe&r."
		""
		"Only a diamond pickaxe or better can mine &eObsidian&r, your ticket to the Nether."
	]
	quest.3B3AF459F317F880.title: "The Best Pick"
	quest.3B3F2AE08D4EA117.quest_desc: [
		"Team Rocket's admins never give up. After Brendan's final team, &eArcher&r brings Latias and Heatran and &eAriana&r brings Victini and Xerneas."
		""
		"They roam the Nether, End Cities, badlands and savannas. Beat both. Optional."
	]
	quest.3B3F2AE08D4EA117.quest_subtitle: "Archer and Ariana, final teams"
	quest.3B3F2AE08D4EA117.title: "Last Resort"
	quest.3B4B0EBF08700CDF.quest_desc: [
		"&6Price:&r &e15,000 CobbleDollars&r for one."
		""
		"Gradually restores the holder's HP throughout a battle"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.3B4B0EBF08700CDF.quest_subtitle: "15,000 CD"
