	quest.1531E5841187EDF5.title: "Zealous"
	quest.15395BA688C2C58D.quest_desc: [
		"Craft a &eDream Ball&r: 2 Pink Apricorns, 1 Red Apricorn and 1 Blue Apricorn around a &eDiamond&r."
		""
		"&6Catch rate:&r 4x on sleeping Pokémon."
	]
	quest.15395BA688C2C58D.title: "Dream Ball"
	quest.15443A5D66B708B2.quest_desc: [
		"&eLeader Lt. Surge&r holds the &eVermilion Gym&r in hot, dry country: &ebadlands&r, &emesas&r, &ecanyons&r, &earid highlands&r and &esavannas&r."
		""
		"Beat Trainer Brendan first. Surge sends out Pincurchin, Alolan Raichu, Vikavolt, Manectric and Boltund: Ground moves hit almost all of them hard."
	]
	quest.15443A5D66B708B2.quest_subtitle: "Leader Lt. Surge, Vermilion Gym"
	quest.15443A5D66B708B2.title: "Thunder Badge"
	quest.15475E54F00D2C0C.quest_desc: [
		"Craft a &eBrewing Stand&r from 1 &eBlaze Rod&r and 3 Cobblestone (Blackstone or Cobbled Deepslate work too)."
		""
		"It is the job site of the &eCleric&r villager."
		"&aPokémon tip:&r Cobblemon medicine is brewed in the same stand. See &eCooking and Medicine&r."
	]
	quest.15475E54F00D2C0C.title: "The Brewing Stand"
	quest.15548D4E8BE280FC.quest_desc: [
		"Register &e70&r species from the &eKanto&r region (Generation 1) as caught."
		""
		"Regional forms count for their own region (an Alolan form counts toward Alola). Hisuian forms count toward Galar."
	]
	quest.15548D4E8BE280FC.title: "Kanto Field Notes"
	quest.15747067A171972B.quest_desc: [
		"&eShulkers&r hide in the walls of End Cities and drop &eShulker Shells&r."
		""
		"Two shells cap a &eMaster Ball&r in Cobblemon's recipe, and Sophisticated Storage builds its shulker boxes from them too."
	]
	quest.15747067A171972B.title: "Shell Game"
	quest.1574B01528263B0B.quest_desc: [
		"&6Price:&r &e800 CobbleDollars&r for one."
		""
		"Fully heals any status problems of a Pokémon"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.1574B01528263B0B.quest_subtitle: "800 CD"
	quest.1574B01528263B0B.title: "Full Heal"
	quest.157F269D994CA80C.quest_desc: [
		"Catch (or evolve) a Pokémon you can fly on."
		""
		"&ePidgeot&r, &eCorviknight&r, &eAltaria&r, &eDragonite&r and &eTogekiss&r use &eClassic&r flight: they go where you look, &eSpace&r climbs and &eShift&r descends. &eMagnezone&r and &eDrifblim&r hover. &eBlastoise&r, somehow, is a rocket."
	]
	quest.157F269D994CA80C.title: "Take to the Skies"
	quest.15B4A5CE7E5ED8A0.quest_desc: [
		"Register &e50&r species as &eSeen&r (caught species count too)."
		""
		"Scan everything you meet. A seen entry tells you a species exists here, even before you catch one."
	]
	quest.15B4A5CE7E5ED8A0.title: "Wide-Eyed"
	quest.15B7F0216210ED23.quest_desc: ["Evolve 50 Pokémon of any kind. Every method in this chapter counts."]
	quest.15B7F0216210ED23.title: "Metamorphosis"
	quest.15CE887901EEBAE6.quest_desc: [
		"&eEnder Pearl&r, &e3 Obsidian&r and &e2 Redstone&r around a &eStorage Upgrade Base&r."
		""
		"Deletes items matching its filter as they come in. Put it on the barrel your quarry overflows into."
		"&cVoided items are gone for good.&r"
	]
	quest.15CE887901EEBAE6.title: "Void Upgrade"
	quest.15E2970723F83679.quest_desc: [
		"&6Price:&r &e2,000 CobbleDollars&r for one."
		""
		"Evolves Milcery into Alcremie with a Clover Sweet"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.15E2970723F83679.quest_subtitle: "2,000 CD"
	quest.15E2970723F83679.title: "Clover Sweet"
	quest.15ECAF4E0BE549EC.quest_desc: [
		"Craft a &ePokéFinder&r: 3 Red Apricorns, a Compass, 2 Copper Ingots and an Electirizer."
		""
		"It is a radar for nearby Pokémon. Filter it by name, label, EV yield or &eUncaught&r to spot species missing from your Pokédex."
	]
	quest.15ECAF4E0BE549EC.title: "PokéFinder"
	quest.1603361EC2AC1301.quest_desc: [
		"Assemble the machine: put the &eData Monitor&r on top of the &eFossil Analyzer&r and stand the &eRestoration Tank&r right beside them."
		""
		"Fill the tank with organic matter: Berries, Apricorns, crops and other foods all count, and one Revive counts as much as sixteen Berries."
		"Then insert a fossil and wait for your ancient Pokémon."
		""
		"&aIn this pack a resurrected Pokémon is shiny 1 time in 100 and an Alpha 1 time in 20.&r"
	]
	quest.1603361EC2AC1301.title: "Life Finds a Way"
	quest.160404B8FE700FE9.quest_desc: [
		"&6Price:&r &e3,000 CobbleDollars&r for one."
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.160404B8FE700FE9.quest_subtitle: "3,000 CD"
	quest.160404B8FE700FE9.title: "Metal Powder"
	quest.160A20788A4B24D4.quest_desc: [
		"&6Price:&r &e1,000 CobbleDollars&r for one."
		""
		"1×, caught Pokémon start with 150 Friendship"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.160A20788A4B24D4.quest_subtitle: "1,000 CD"
	quest.160A20788A4B24D4.title: "Friend Ball"
	quest.1613937E22C3C345.quest_desc: [
		"Eating food gives you Haste for a while."
		""
		"&6Where to look:&r mineshaft chests, Ancient City chests, brushing warm Ocean Ruins; rarely worn by piglin brutes."
	]
	quest.1613937E22C3C345.title: "Onion Ring"
	quest.1655CDFC87EA770B.quest_desc: [
		"Mine faster, and dig bare-handed as well as with a stone tool."
		""
		"&6Where to look:&r mineshaft chests, buried treasure, village toolsmiths, brushing cold Ocean Ruins."
	]
	quest.1655CDFC87EA770B.title: "Digging Claws"
	quest.165A722B8DE5639D.quest_desc: [
		"&e5 Planks&r, &e3 Trapdoors&r and a &eChest&r."
		""
		"Extends the face of the block it points at, so a network can reach an awkward inventory."
	]
	quest.165A722B8DE5639D.title: "Inventory Proxy"
	quest.16634E6E014BDF50.quest_desc: [
		"Kadabra, Machoke, Graveler, Haunter, Boldore, Gurdurr, Phantump and Pumpkaboo evolve when traded."
		""
		"Trade one with another player, or use a Link Cable on it."
	]
	quest.16634E6E014BDF50.title: "Traded Up"
	quest.166AF1CCB037FA77.quest_desc: [
		"A vanilla &eBarrel&r plus a &eRedstone Torch&r, or planks and slabs around a torch."
		""
		"Same slots and upgrades as the chest, and it tiers up the same way with metal around it. Barrels stack neatly into walls."
	]
	quest.166AF1CCB037FA77.title: "Sophisticated Barrel"
	quest.169D625FDF2F4A02.quest_desc: [
		"Revive a &eKabuto&r (Rock/Water) from a &eDome Fossil&r."
		""
		"Look for it at dripstone oases, enhydro agate pockets, hydrothermal vents, rooted pits and suspicious mounds."
	]
	quest.169D625FDF2F4A02.title: "Kabuto"
	quest.16AE93E996562CC8.quest_desc: [
		"Brew a &ePP Up&r: a bottle of &eMedicinal Brew&r in a Brewing Stand with a &eVivichoke&r on top. It raises a move's max PP, and it is the base bottle for every vitamin."
		""
		"&aVivichoke Seeds turn up in shipwreck chests, fossil dig sites and tier 1 Raid Pouches.&r"
	]
	quest.16AE93E996562CC8.title: "Pep in a Bottle"
	quest.16B9DCA55BCB25AA.quest_desc: [
		"Five hundred catches, a shiny, an Alpha, every habitat and a starter from every region. That is a collection worth bragging about."
		""
		"Claim your &5Master Ball&r: it never fails. Save it for something truly special."
	]
	quest.16B9DCA55BCB25AA.title: "Gotta Catch 'Em All!"
	quest.16BA785EE6681023.quest_desc: [
		"&6Price:&r &e1,500 CobbleDollars&r for one."
		""
		"Halves damage taken from a supereffective Ice-type attack"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.16BA785EE6681023.quest_subtitle: "1,500 CD"
	quest.16BA785EE6681023.title: "Yache Berry"
	quest.16C14878E70AC480.quest_desc: [
		"Craft a &eLove Ball&r: 3 Pink Apricorns and 1 White Apricorn around a &eGold Ingot&r."
		""
		"&6Catch rate:&r 2.5x if the target is the opposite gender of your Pokémon, 8x if it is also the same species."
	]
	quest.16C14878E70AC480.title: "Love Ball"
	quest.16C1F181D85A8736.quest_desc: [
		"Catch a &eFoongus&r."
		""
		"Common in the dark of the &6Fungal Caves&r, and in Dark Forests too."
		"&oIt only looks like a Poké Ball. Do not try to throw it.&r"
	]
	quest.16C1F181D85A8736.title: "Not a Poké Ball"
	quest.16CD2BAE57F65B19.quest_desc: [
		"One of the new Megas from Pokémon Legends: Z-A."
		"Lets &eDragonite&r Mega Evolve."
		""
		"Recipe: raw Mega Stone, a Diamond, two Gold Ingots and a whole &eElytra&r."
	]
	quest.16CD2BAE57F65B19.title: "Dragoninite"
	quest.16D1E887CC2D47D8.quest_desc: [
		"Adds a level of Fortune to every block you mine."
		""
		"&6Where to look:&r buried treasure, igloo basements, Ruined Portals, big Ocean Ruins, brushing cold Ocean Ruins."
	]
	quest.16D1E887CC2D47D8.title: "Lucky Scarf"
	quest.16D6B0478E3A439E.quest_desc: [
		"Craft a &eFast Ball&r: 2 Yellow Apricorns, 1 Red Apricorn and 1 White Apricorn around an &eIron Ingot&r."
		""
		"&6Catch rate:&r 4x on Pokémon with 100 or more Base Speed."
	]
	quest.16D6B0478E3A439E.title: "Fast Ball"
	quest.16DD170F6686822F.quest_desc: [
		"You start with 16 &ePoké Balls&r. When they run low, craft more: four &eRed Apricorns&r around a &eCopper Ingot&r makes four balls."
		""
		"Keep at least 8 on hand. Better balls wait in the &cPoké Ball Workshop&r chapter."
	]
	quest.16DD170F6686822F.title: "The First of Many"
	quest.16F78B25302457B2.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Boosts the power of the holder's Water-type moves"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.16F78B25302457B2.quest_subtitle: "5,000 CD"
	quest.16F78B25302457B2.title: "Mystic Water"
	quest.1705F7B23AFFCCBE.quest_desc: [
		"&eSweet Berries&r grow on bushes in taiga forests; &eGlow Berries&r hang from cave vines in lush caves."
		""
		"&aPokémon tie-in:&r Glow Berries, a Moss Block and a Bowl craft &eLuminous Moss&r, a Cobblemon held item."
	]
	quest.1705F7B23AFFCCBE.title: "Berry Picking"
	quest.170A9CC5466AC48C.quest_desc: ["Green Apricorn base: &e+2 Jump, -1 Speed&r."]
	quest.170A9CC5466AC48C.title: "Green Aprijuice"
	quest.1716703A38AFE01C.quest_desc: [
		"Catch a Pokémon with a &eRepeat Ball&r."
		""
		"&aUse it on species you have caught before.&r"
	]
	quest.1716703A38AFE01C.title: "Seen You Before"
	quest.1720636A30450664.quest_desc: [
		"Artifacts adds small underground &ecampsites&r between Y -60 and 40. Three in ten have a &cMimic&r where the chest should be."
		""
		"Kill one: Mimics drop artifacts."
	]
	quest.1720636A30450664.title: "This Chest Bites"
	quest.1721CBA249F64728.quest_desc: [
		"&6Price:&r &e2,000 CobbleDollars&r for one."
		""
		"Evolves Milcery into Alcremie with a Star Sweet"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.1721CBA249F64728.quest_subtitle: "2,000 CD"
	quest.1721CBA249F64728.title: "Star Sweet"
	quest.1734207A881E4915.quest_desc: [
		"&eAntique Ink&r is sold by master-level &eCartographers&r. It also turns up as fishing treasure and inside the urns found in caves."
		""
		"It gives maps, books and globes an old-world sepia look."
	]
	quest.1734207A881E4915.title: "Old Ink"
	quest.17390D2A61EFEADF.quest_desc: [
		"Catch 10 &3Flying&r-type Pokémon. Dual-type Pokémon count for both of their types."
		""
		"&6Strong against:&r Grass, Fighting, Bug"
	]
	quest.17390D2A61EFEADF.title: "Birds of a Feather"
	quest.1748F080167F0711.quest_desc: [
		"Cross a &6Desert&r."
		""
		"Sandile is common in the dunes and Trapinch is a rare find."
		"&oRegirock is said to roam the desert, ultra-rarely.&r"
	]
	quest.1748F080167F0711.title: "Dry Spell"
	quest.1773353F2B38EC6F.quest_desc: [
		"&e4 Planks&r, &e4 Sticks&r and a &eChest&r make &e2 Trims&r."
		""
		"Trims connect inventories to the Inventory Connector, so your chests do not all have to touch it."
	]
	quest.1773353F2B38EC6F.title: "Inventory Trim"
	quest.178097F14ADF2997.quest_desc: [
		"Find a &eSaccharine&r tree and craft its logs into &eSaccharine Planks&r."
		""
		"Saccharine wood has its own full set of stairs, doors, signs and boats."
	]
	quest.178097F14ADF2997.title: "Sweet Timber"
	quest.17883EA5C3AC1C6C.quest_desc: [
		"Find a &ewoodland mansion&r in a Dark Forest."
		""
		"Its halls are full of Pokémon: Ralts, Gothita, Mimikyu, Eevee and its evolutions, and Litwick at night."
		"&cIllagers guard every floor.&r"
	]
	quest.17883EA5C3AC1C6C.title: "House Call"
	quest.1795475DE6956F4F.quest_desc: [
		"&e6 Planks&r, a &eStick&r, a &eChest&r and a &eTrapdoor&r."
		""
		"Turns the block in front of it into an inventory. &cIt drops items into the world as entities.&r"
	]
	quest.1795475DE6956F4F.title: "Open Crate"
	quest.179B20F14FCFBAB8.quest_desc: [
		"Lets &eGengar&r Mega Evolve."
		""
		"Recipe: raw Mega Stone, two Iron Ingots, a Diamond and a &eSpell Tag&r."
	]
	quest.179B20F14FCFBAB8.title: "Gengarite"
	quest.179C7CDC917FBB8C.quest_desc: [
		"&6Price:&r &e10,000 CobbleDollars&r for one."
		""
		"Prevents the effects of traps set on the battlefield"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.179C7CDC917FBB8C.quest_subtitle: "10,000 CD"
	quest.179C7CDC917FBB8C.title: "Heavy-Duty Boots"
	quest.179D4FA967D52DA7.quest_desc: [
		"&6Price:&r &e300 CobbleDollars&r for one."
		""
		"Holder is cured if it is poisoned"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.179D4FA967D52DA7.quest_subtitle: "300 CD"
	quest.179D4FA967D52DA7.title: "Pecha Berry"
	quest.179F4D96326DDD9E.quest_desc: [
		"Enter a &eFortress of the Undead&r, the skeleton dungeon."
		""
		"Clear the spawners before you go chest hunting."
	]
	quest.179F4D96326DDD9E.title: "A Bone to Pick"
	quest.17B9037F750FEA99.quest_desc: [
		"Craft a &eWarp Stone&r: 4 &eAmethyst Shards&r, 4 &eEnder Pearls&r and an &eEmerald&r."
		""
		"Hold use to charge it, then pick any activated waystone. It wears down with each trip, but it takes &eUnbreaking&r and &eMending&r."
	]
	quest.17B9037F750FEA99.title: "Pocket Waystone"
	quest.17EF555F84A4786C.quest_desc: [
		"Key item: &eBlast Furnace&r."
		""
		"Only blasting recipes are allowed:"
		"ores, raw metals and metal gear."
	]
	quest.17EF555F84A4786C.title: "Augment: Blasting"
	quest.17F150EB541E66BA.quest_desc: [
		"&eRevival Herbs&r grow in lush caves. Fed to a fainted Pokémon one revives it at a quarter of its HP, at a cost in friendship."
		""
		"&aPokémon tie-in:&r Bone Meal on a &ePetilil&r also gives a Revival Herb."
	]
	quest.17F150EB541E66BA.title: "Herb Your Enthusiasm"
	quest.17F5CF7D227D3DAC.quest_desc: [
		"Register &e10&r species as &eCaught&r in your Pokédex."
		""
		"Every species counts once, no matter how many you own."
	]
	quest.17F5CF7D227D3DAC.title: "First Entries"
	quest.17FDDD77A25ABD88.quest_desc: [
		"Revive &e15&r Fossil Pokémon."
		""
		"By now the Restoration Tank should never run dry. Keep a chest of Berries next to it."
	]
	quest.17FDDD77A25ABD88.title: "Paleontologist"
	quest.180B8042CE16508C.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Changes a Pokémon's stats to be that of a Adamant nature"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.180B8042CE16508C.quest_subtitle: "5,000 CD"
	quest.180B8042CE16508C.title: "Adamant Mint"
	quest.1824314EA89CA1B3.quest_desc: [
		"&6Price:&r &e500 CobbleDollars&r for one."
		""
		"Restores 1/3 max HP at 1/4 max HP or less; confuses if -Atk Nature"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.1824314EA89CA1B3.quest_subtitle: "500 CD"
	quest.1824314EA89CA1B3.title: "Figy Berry"
	quest.183220459A5E2F37.quest_desc: [
		"Find a &eBetter Ocean Monument&r."
		""
		"Qwilfish and Overqwil swarm the waters around it."
		"&oLugia, ultra-rare, has been seen beneath the waves near these monuments.&r"
	]
	quest.183220459A5E2F37.title: "Under the Sea"
	quest.183F5737B661ACC8.quest_desc: [
		"Visit the &6Ice Spikes&r."
		""
		"Swinub and Snom are common, Frosmoth flutters about, and Frigibax is an ultra-rare find under the open sky."
		"&oRegice is rumoured to wander here.&r"
	]
	quest.183F5737B661ACC8.title: "Spiky Situation"
	quest.1869830988884D8C.quest_desc: [
		"&6Price:&r &e6,000 CobbleDollars&r for one."
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.1869830988884D8C.quest_subtitle: "6,000 CD"
	quest.1869830988884D8C.title: "King's Rock"
	quest.18C4787334BE873B.quest_desc: [
		"&6Price:&r &e6,000 CobbleDollars&r for one."
		""
		"Poisons the holder"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.18C4787334BE873B.quest_subtitle: "6,000 CD"
	quest.18C4787334BE873B.title: "Toxic Orb"
	quest.18C9DE2B5F62B8BF.quest_desc: [
		"&6Price:&r &e800 CobbleDollars&r for one."
		""
		"Holder cures itself if it has a non-volatile status or is confused"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.18C9DE2B5F62B8BF.quest_subtitle: "800 CD"
	quest.18C9DE2B5F62B8BF.title: "Lum Berry"
	quest.18C9F2DEC0E34A70.quest_desc: [
		"This pack replaces vanilla fortresses with &eYUNG's Better Nether Fortresses&r: huge keeps of nether brick with &eBlaze spawners&r, nether wart gardens and loot rooms."
		""
		"Expect &eBlazes&r, &eWither Skeletons&r, Magma Cubes, Skeletons and Zombified Piglins inside. Bring a bow and some Fire Resistance if you have it."
	]
	quest.18C9F2DEC0E34A70.title: "A Better Fortress"
	quest.18E710F3E7068E78.quest_desc: [
		"&eLeader Blaine&r keeps the &eCinnabar Gym&r in the &cNether&r: &eNether Wastes&r, &eCrimson&r and &eWarped Forests&r, between Y 32 and 70. Search for it with the compass while you are in the Nether."
		""
		"He battles you after Trainer May. Torkoal, Cinderace, Exeggutor, Typhlosion, Sunflora and Charizard: Rock moves crush most of them."
	]
	quest.18E710F3E7068E78.quest_subtitle: "Leader Blaine, Cinnabar Gym"
	quest.18E710F3E7068E78.title: "Volcano Badge"
	quest.18FDB437D2CC4ACA.quest_desc: [
		"Optional: craft a second &eHealing Machine&r for an outpost or a teammate, so you have 2."
		""
		"Recipe: 3 &eCopper Ingots&r, 4 &eIron Ingots&r, &eRedstone&r and a &eMax Revive&r. Every new machine starts empty and needs to charge. &aMax Revives are cooked in the Cooking chapter.&r"
	]
	quest.18FDB437D2CC4ACA.title: "A Second Poké Center"
	quest.190F34A27ACD4DF7.quest_desc: [
		"Brew a &dPotion of Regeneration&r: Awkward Potion + &eGhast Tear&r."
		""
		"Your health ticks back up while it lasts."
	]
	quest.190F34A27ACD4DF7.title: "Tears of Recovery"
	quest.1925A659147794CE.quest_desc: [
		"Find an Explorify &emausoleum&r in a forest."
		""
		"&cMonster spawners guard the tomb.&r"
	]
	quest.1925A659147794CE.title: "Rest in Peace"
	quest.1925BA6D7B8BFFBB.quest_desc: [
		"Brew an &eEnergy Root&r into a &ePP Up&r for a &ePP Max&r: one move gets the full +60% max PP in a single use."
		""
		"PP Up itself is brewed in the &6Training and Battling&r chapter."
	]
	quest.1925BA6D7B8BFFBB.title: "Maxed Out"
	quest.1926E22CD82336CE.quest_desc: [
		"&eWitches&r throw harmful potions and drink healing ones mid-fight. Rush them."
		""
		"Kill 5. They drop Redstone, Glowstone Dust, Sugar, Spider Eyes, Glass Bottles and Gunpowder."
	]
	quest.1926E22CD82336CE.title: "Double, Double"
	quest.19277562E6113CF0.quest_desc: [
		"Stock up on &eRedstone&r and &eGlowstone Dust&r."
		""
		"Redstone stretches a potion's duration; Glowstone raises its level. A potion can take one or the other, never both."
	]
	quest.19277562E6113CF0.title: "Longer and Stronger"
	quest.1946DC90F2F3945F.quest_desc: [
		"Catch &e500&r Pokémon."
		""
		"Five hundred friends and counting. Professors everywhere want your notes."
	]
	quest.1946DC90F2F3945F.title: "Five Hundred Strong"
	quest.197390671C91D12A.quest_desc: [
		"Defeat a &etier 3&r raid boss."
		""
		"Tier 3 bosses are level &e35&r with 8x their normal HP. A win pays &e6,000&r CobbleDollars and the reward Pokémon comes with &e2&r perfect IVs."
	]
	quest.197390671C91D12A.quest_subtitle: "Tier 3 raid"
	quest.197390671C91D12A.title: "Three Stars Shining"
	quest.199228786B0D9D0C.quest_desc: [
		"&6Price:&r &e1,600 CobbleDollars&r for one."
		""
		"Restores 120 HP of a Pokémon"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.199228786B0D9D0C.quest_subtitle: "1,600 CD"
	quest.199228786B0D9D0C.title: "Hyper Potion"
	quest.19A00C586A3AB36B.quest_desc: [
		"Cook &eEverlasting Beef&r in a furnace, smoker or campfire."
		""
		"Still never used up, still a 15 second cooldown, now well done."
	]
	quest.19A00C586A3AB36B.title: "Eternal Steak"
	quest.19BA2A523D2807A9.quest_desc: [
		"You have caught a signature Pokémon from every climate in the world."
		""
		"From flower fields to the mantle, there is nowhere left that feels unfamiliar."
		"&oKeep the compass: new biomes mean new spawns every time you travel.&r"
	]
	quest.19BA2A523D2807A9.title: "World Traveller"
	quest.19BBAD50119B4AC8.quest_desc: [
		"&6Counter and Unchained&r"
		""
		"&eCounter&r tracks how many of each species you catch or knock out, and your streak of the same species in a row. Each capture is posted in chat with its count."
		"&eUnchained&r turns streaks into boosts for that species spawning near you: a KO streak of &e100&r, &e300&r and &e500&r raises its shiny odds, a capture streak of &e5&r, &e10&r, &e20&r and &e30&r brings more perfect IVs."
	]
	quest.19BBAD50119B4AC8.title: "On a Streak"
	quest.19C2F0209CC6C87B.quest_desc: [
		"Defeat a &etier 2&r raid boss."
		""
		"Tier 2 bosses are level &e20&r with 5x their normal HP. A win pays &e3,000&r CobbleDollars and the reward Pokémon comes with &e1&r perfect IV."
	]
	quest.19C2F0209CC6C87B.quest_subtitle: "Tier 2 raid"
	quest.19C2F0209CC6C87B.title: "Double Trouble Den"
	quest.19DCE1C75D564D1B.quest_desc: [
		"&6Price:&r &e1,500 CobbleDollars&r for one."
		""
		"Temporarily raises the target's Speed stat by one stage when used in battle"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.19DCE1C75D564D1B.quest_subtitle: "1,500 CD"
	quest.19DCE1C75D564D1B.title: "X Speed"
	quest.1A14796DC05CCAB9.quest_desc: [
		"&6Price:&r &e1,500 CobbleDollars&r for one."
		""
		"Temporarily raises the target's Defense stat by one stage when used in battle"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.1A14796DC05CCAB9.quest_subtitle: "1,500 CD"
	quest.1A14796DC05CCAB9.title: "X Defense"
	quest.1A1779EDF1D4AC47.quest_desc: [
		"Craft a &eHeavy Ball&r: 2 Blue Apricorns and 2 Black Apricorns around an &eIron Ingot&r."
		""
		"&6Catch rate:&r 1x to 4x, rising with the target's weight."
	]
	quest.1A1779EDF1D4AC47.title: "Heavy Ball"
	quest.1A1CF8B33DAEA772.quest_desc: [
		"Brew a &bPotion of Swiftness&r: Awkward Potion + &eSugar&r."
		""
		"You run faster while it lasts."
	]
	quest.1A1CF8B33DAEA772.title: "Sugar Rush"
	quest.1A28AEAC3F3103FA.quest_desc: [
		"Add a &eDyna Fruit&r to each urn for its Galarian version. Dyna Fruit grows on Giant Dyna Trees in the Dyna Plains; without Silk Touch it breaks into slices, and 9 slices make a fruit again."
		""
		"A Galarian urn needs 75 defeats of its type to charge, then calls the Galarian form of its bird."
	]
	quest.1A28AEAC3F3103FA.title: "Urns, Galar Style"
	quest.1A652C7B1C7CBABC.quest_desc: [
		"Place your &eIron Furnace&r in the middle, &e7 Gold Ingots&r around it and a &eBlock of Gold&r in the bottom slot."
		""
		"Cook time: &e120 ticks&r per item."
	]
	quest.1A652C7B1C7CBABC.title: "Golden Furnace"
	quest.1A68A13DD7694242.quest_desc: [
		"&6Price:&r &e400 CobbleDollars&r for one."
		""
		"Increases a Pokémon's experience by 800 Exp. Points"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.1A68A13DD7694242.quest_subtitle: "400 CD"
	quest.1A68A13DD7694242.title: "Exp. Candy S"
	quest.1A722E12F6520228.quest_desc: [
		"Find any &eCobblemon ruin&r: crumbling towers, henges, crypts and monuments scattered across the world."
		""
		"Gimmighoul haunt ruins near the surface, and Gholdengo is an ultra-rare sight there."
		"&aTip:&r some ruins hide &eGilded Chests&r; open every one you find."
	]
	quest.1A722E12F6520228.title: "Ancient Ruins"
	quest.1ABA5D1BF6A72229.quest_desc: [
		"&6Price:&r &e15,000 CobbleDollars&r for one."
		""
		"Allows the holder to receive a share of experience from battles without participating"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.1ABA5D1BF6A72229.quest_subtitle: "15,000 CD"
	quest.1ABA5D1BF6A72229.title: "Exp. Share"
	quest.1B04BB573BA208B0.quest_desc: [
		"&eCrying Obsidian&r comes from Piglin bartering and Bastion chests."
		""
		"It cannot hold a portal, but six of them build a &eRespawn Anchor&r."
	]
	quest.1B04BB573BA208B0.title: "Who Is Crying?"
	quest.1B2C1A0499BB3295.quest_desc: [
		"Find every Artifact in the grid, from the humble Plastic Drinking Hat to the Chorus Totem."
		""
		"&oA museum would be jealous.&r"
	]
	quest.1B2C1A0499BB3295.title: "The Curator"
	quest.1B4950B213F2E9E3.quest_desc: [
		"Own one of each everyday machine: Poké Gacha Machine, Cram-O-Matic, Item Printer, Rocket Prize Master and Plush-O-Matic."
		""
		"The &ePlush-O-Matic&r is covered in the Pokéblocks and Decor chapter."
	]
	quest.1B4950B213F2E9E3.title: "Arcade Owner"
	quest.1B4CC6273D2B6751.quest_desc: [
		"Craft a &eShining HP Silver Cap&r: four Diamond Blocks, three White Mint Leaves and two &eNether Stars&r. Unlike normal caps it sets the &obase&r HP IV to 31, not just the Hyper Trained one."
		""
		"Every stat has its own Shining cap, using the same leaf colours as the Silver Caps."
	]
	quest.1B4CC6273D2B6751.title: "Shine Bright"
	quest.1B5320698C52F0BC.quest_desc: [
		"Craft a &ePlush-O-Matic&r from a Block of Gold, 2 Iron Ingots, a Lever, a Dispenser, a Poké Ball and 2 Wool."
		""
		"It is a gacha machine that takes &eYarn&r: hold a Yarn and right-click it. Each kind of Yarn has its own pool of &ePokédolls&r, and a doll can come out normal, shiny, gigantic or gigantic shiny."
	]
	quest.1B5320698C52F0BC.title: "Plush-O-Matic"
	quest.1B59F01DDAAEC40B.quest_desc: [
		"Use &eShears&r on a full nest to collect &eHoneycomb&r instead of honey."
		""
		"&aPokémon tie-in:&r Honeycomb is part of the &eMetal Coat&r recipe."
	]
	quest.1B59F01DDAAEC40B.title: "Comb Over"
	quest.1B677AA823EA42AE.quest_desc: [
		"&6Price:&r &e2,000 CobbleDollars&r for one."
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.1B677AA823EA42AE.quest_subtitle: "2,000 CD"
	quest.1B677AA823EA42AE.title: "Normal Gem"
	quest.1B7F1950BF54CDC4.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Boosts the power of the holder's Electric-type moves"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.1B7F1950BF54CDC4.quest_subtitle: "5,000 CD"
	quest.1B7F1950BF54CDC4.title: "Magnet"
	quest.1B805275623A6C10.quest_desc: [
		"No pot needed: remedies are crafted. A &eBig Root&r makes a &eRemedy&r (20 HP), add &eSweet Berries&r, &eGlow Berries&r or &eGalarica Nuts&r for a &eFine Remedy&r (60 HP), then an &eEnergy Root&r for a &eSuperb Remedy&r (120 HP)."
		""
		"&cThey taste awful:&r every dose lowers the Pokémon's friendship a little."
	]
	quest.1B805275623A6C10.title: "Bitter Medicine"
	quest.1B820EF3060993EA.quest_desc: [
		"Have a &ePoké Ball&r in your inventory and an empty party slot (5 or fewer Pokémon) when Nincada evolves at level 20, and a mysterious &eShedinja&r appears too."
		""
		"The ball is used up."
	]
	quest.1B820EF3060993EA.title: "Ghost in the Machine"
	quest.1B8D342EB6D23365.quest_desc: [
		"Purple towers on the outer islands: &eEnd Cities&r. Their chests hold diamond and iron gear and the Spire armor trim."
		""
		"Some have a flying &eEnd Ship&r docked beside them. That is where the Elytra hangs."
	]
	quest.1B8D342EB6D23365.title: "City of Shulkers"
	quest.1BCCCA6FBDCA288A.quest_desc: ["Summon all three Swords, then cook their snacks with a Bowl in a &eCampfire Pot&r to make the &eCurry of Justice&r."]
	quest.1BCCCA6FBDCA288A.title: "Curry of Justice"
	quest.1BDB37FB27CEAC5F.quest_desc: [
		"With a tamed &eParrot&r riding on your shoulder, draw and release a &eSlingshot&r."
		""
		"The parrot will forgive you. Probably."
	]
	quest.1BDB37FB27CEAC5F.title: "Angry Birds"
	quest.1BDCAF87165B3759.quest_desc: [
		"Find any &eFossil&r."
		""
		"Prehistoric dig sites hide in the world: buried petrified trees, preserved skeletons, frozen spikes, mud pits, hydrothermal vents and more, often just under the surface or in caves."
		""
		"&aBrush&r their Suspicious Sand and Suspicious Gravel to uncover the fossils inside."
	]
	quest.1BDCAF87165B3759.title: "Consult the Fossil"
	quest.1C1DC9F95A3B225D.quest_desc: [
		"&6Price:&r &e6,000 CobbleDollars&r for one."
		""
		"Allows the holder to switch out in any situation"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.1C1DC9F95A3B225D.quest_subtitle: "6,000 CD"
	quest.1C1DC9F95A3B225D.title: "Shed Shell"
	quest.1C31F01D06492B82.quest_desc: [
		"Obtain an &eancient TM&r, such as Draco Meteor, Meteor Beam or Triple Axel."
		""
		"Look for them in the Gilded Chests of Cobblemon ruins."
	]
	quest.1C31F01D06492B82.title: "Records of the Past"
	quest.1C34F39CB952A056.quest_desc: ["Cook three S candies into an &eExp. Candy M&r (3,000 EXP)."]
	quest.1C34F39CB952A056.title: "Medium Rare"
	quest.1C3AC297BB7375F2.quest_desc: [
		"&eMagma Cubes&r bounce around Basalt Deltas and fortresses and split when hit, like Slimes."
		""
		"Kill 10. They drop &eMagma Cream&r. Frogs that eat small ones leave Froglights behind."
	]
	quest.1C3AC297BB7375F2.title: "Lava Lamp"
	quest.1C4DA6D3F8C38876.quest_desc: [
		"&eCobbleDex REI&r puts a full Pokédex into the recipe viewer."
		""
		"Look up any species to see its spawn locations, evolution chain, base stats, item drops and special ways to obtain it."
	]
	quest.1C4DA6D3F8C38876.title: "Pokédex in Your Recipe Viewer"
	quest.1C60A49A453318CE.quest_desc: [
		"&6Price:&r &e10,000 CobbleDollars&r for one."
		""
		"Grants 8 Attack EVs when gaining experience in battle"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.1C60A49A453318CE.quest_subtitle: "10,000 CD"
	quest.1C60A49A453318CE.title: "Power Bracer"
	quest.1C833E2500CA1B3C.quest_desc: [
		"&6Cobblemon Origins&r is a Pokémon adventure in Minecraft: catch, train and evolve Pokémon, explore a reworked world and earn the title of &6Champion of Origins&r."
		""
		"Quests are flexible: you can make progress on any quest at any time, and a quest completes once the quests before it are done. Nothing in the pack is locked behind this book."
		""
		"Open the book with &eK&r or the &eQuests&r button in your inventory. Click a finished quest to claim its rewards; &eCobbleDollars&r go straight to your balance."
		""
		"&6Starter kit:&r you arrived with Iron tools, 32 Steak, 16 Poké Balls, a &eHealing Machine&r and a &ePC&r. Place both near your first base: the PC holds every Pokémon beyond your party of six. This &eQuest Book&r sits in the last slot of your hotbar, and your &eTrainer Card&r is in your offhand."
		""
		"&aThe notes circling this quest explain how the pack works. The panel on the right shows where every chapter begins.&r"
	]
	quest.1C833E2500CA1B3C.quest_subtitle: "Your adventure starts here"
	quest.1C833E2500CA1B3C.title: "Welcome to Cobblemon Origins!"
	quest.1C96879B3D5860FE.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Increases a Pokémon's level by one"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.1C96879B3D5860FE.quest_subtitle: "5,000 CD"
	quest.1C96879B3D5860FE.title: "Rare Candy"
	quest.1C986E3A896B0FBD.quest_desc: [
		"&eSaccharine&r trees grow among birches, in flowery and magical places and in taigas. Their leaves drop saplings."
		""
		"Rarely the leaves drop a Tart, Sweet or Syrupy Apple, and honey smeared on the logs lures Pokémon."
	]
	quest.1C986E3A896B0FBD.title: "Sweet Tree"
	quest.1C9CC89FD4F8FAA2.quest_desc: [
		"Craft a &eBlue PokéFinder&r: the same recipe with 3 Blue Apricorns in place of the red ones."
		""
		"Green, Pink, White, Black and Yellow work the same way. A second finder is handy for a friend or a spare."
	]
	quest.1C9CC89FD4F8FAA2.title: "Feeling Blue"
	quest.1CAADFE9AA26AF56.quest_desc: [
		"Register &e450&r species as &eCaught&r in your Pokédex."
		""
		"Only the dedicated get this far."
	]
	quest.1CAADFE9AA26AF56.title: "Walking Encyclopedia"
	quest.1CD284EA9CDDB44E.quest_desc: [
		"The &eQuiver&r cannot be crafted. Search chests in dungeons, woodland mansions and pillager outposts."
		""
		"It holds 6 stacks of arrows, lets you pick which kind to shoot, and catches matching arrows you pick up."
	]
	quest.1CD284EA9CDDB44E.title: "Arrow Wrangler"
	quest.1CDD1CA30570ECF4.quest_desc: [
		"Cobblemon fills the wild with plants: &eBerries&r, &eApricorns&r, &eMints&r, herbs, roots and more."
		""
		"Pick up any of them to begin. This chapter teaches you to find, plant, mutate and harvest each one."
		""
		"&aYour Pokémon eat, hold and heal with almost everything you grow here.&r"
	]
	quest.1CDD1CA30570ECF4.title: "&lMother Nature's Bounty"
	quest.1CF985A7F898F304.quest_desc: [
		"Craft the &eStrange Crystallized Machine&r: a &eMaster Ball&r, a Nether Star, 2 Diamonds, 3 Iron Blocks and 2 Diamond Blocks."
		""
		"It takes &eDiamonds&r, and every pull brings out a random Pokémon instead of an item."
		""
		"&cIt costs a Master Ball. Think twice.&r"
	]
	quest.1CF985A7F898F304.title: "Strange Crystallized Machine"
	quest.1CFDFB7613B02B29.quest_desc: [
		"&6Price:&r &e1,200 CobbleDollars&r for one."
		""
		"Restores 10 PP to one of a Pokémon's selected moves"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.1CFDFB7613B02B29.quest_subtitle: "1,200 CD"
	quest.1CFDFB7613B02B29.title: "Ether"
	quest.1D16935318C20A78.quest_desc: [
		"Grow a &eHopo&r tree beside any type-resist Berry (Occa, Passho, Rindo and the rest, even Chilan) to mutate an &eEnigma Berry&r."
		""
		"It restores a quarter of max HP after the holder takes a super-effective hit."
	]
	quest.1D16935318C20A78.title: "Riddle Me This"
	quest.1D1848680C53B902.quest_desc: [
		"Up to &e4 players&r fight one boss, each with &eone Pokémon&r and &eone life&r. You cannot be hurt yourself."
		""
		"Bag items are blocked; only &eCheers&r work, up to 3 per raid. Moves like Perish Song, Destiny Bond, Taunt and the one-hit KO moves are banned, as are Wonder Guard and Perish Body."
		""
		"&cDeal your share of the damage&r (20% at tier 1, 18% at tier 2, 16% above) or you leave empty-handed."
	]
	quest.1D1848680C53B902.title: "Raid Rules"
	quest.1D26B7FA19F44379.quest_desc: [
		"Every win hands you a &eRaid Pouch&r. &eRight-click&r it to open it."
		""
		"Low tiers give apricorns and medicinal leeks; higher tiers add EXP Candies, mochi, mint leaves, IV candies and more."
	]
	quest.1D26B7FA19F44379.title: "Open the Pouch"
	quest.1D4A042E1BE7811C.quest_desc: ["Terastallize &e25&r times. A surprise Tera Type can flip a matchup on its head."]
	quest.1D4A042E1BE7811C.title: "Gemstone Veteran"
	quest.1D64E3785C7E65E9.quest_desc: [
		"Craft an &eItem Printer&r from 2 Iron Ingots, a Poké Ball, a Great Ball, an Ultra Ball, 2 Diamonds and 2 Dispensers."
		""
		"It takes Relic Coins and prints Poké Balls, evolution stones and items, vitamins and medicine directly, no capsule needed."
	]
	quest.1D64E3785C7E65E9.title: "Item Printer"
	quest.1D6D38C7DD00EBF1.quest_desc: [
		"&6Price:&r &e8,000 CobbleDollars&r for one."
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.1D6D38C7DD00EBF1.quest_subtitle: "8,000 CD"
	quest.1D6D38C7DD00EBF1.title: "Bright Powder"
	quest.1D73AE09DFE29200.quest_desc: [
		"&e4 Planks&r, &e2 Comparators&r, a &eChest&r, &eGlowstone Dust&r and &eGlass&r."
		""
		"Place it on the network to see, search and take every item in one screen."
	]
	quest.1D73AE09DFE29200.title: "Storage Terminal"
	quest.1D78EF45522D4668.quest_desc: [
		"&6Price:&r &e5,000 CobbleDollars&r for one."
		""
		"Changes a Pokémon's stats to be that of a Timid nature"
		""
		"&aClick the checkmark to buy. Buy again as often as you like: you are only charged when you can afford it.&r"
	]
	quest.1D78EF45522D4668.quest_subtitle: "5,000 CD"
	quest.1D78EF45522D4668.title: "Timid Mint"
	quest.1D7C3FBAB4DA7CE2.quest_desc: [
		"Catch a Pokémon with any &eAncient&r ball."
		""
		"Ancient balls catch like their modern twins, but some fly farther or shorter when thrown."
	]
	quest.1D7C3FBAB4DA7CE2.title: "Throwback"
	quest.1D7D596ABAF2C36B.quest_desc: [
		"Take a first-stage Pokémon that could still evolve all the way to &elevel 100&r without evolving it."
		""
		"&aGive it an &eEverstone&a to hold: it stops evolution. Geodude and Roggenrola sometimes drop one.&r"
	]
	quest.1D7D596ABAF2C36B.title: "Forever Young"
	quest.1DAAF4ED44369CE3.quest_desc: [
		"Find a &eHeart of the Sea&r. Every Buried Treasure chest holds one."
		""
		"The big treasure Gilded Chests of Cobblemon's shipwreck coves can hold one too, and Lapras sometimes drops one."
	]
	quest.1DAAF4ED44369CE3.title: "Heart of the Ocean"
	quest.1DB11434F6275ED3.quest_desc: [
		"Craft &eDNA Splicers&r from four Blaze Rods, two Iron Ingots and a Netherite Ingot."
		""
		"They fuse Kyurem with Reshiram or Zekrom. Finding those legends is the Legends and Myths chapter's job."
	]
	quest.1DB11434F6275ED3.title: "Ice Meets Legend"
	quest.1DB969F8F0090BF3.quest_desc: [
		"&6Price:&r &e2,000 CobbleDollars&r for one."
