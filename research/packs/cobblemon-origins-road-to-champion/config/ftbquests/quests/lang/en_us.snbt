	]
	quest.203EBB23B325A0F5.title: "Heatranite"
	quest.2061011630D35145.quest_desc: [
		"An &eEnder Pearl&r and an &eAmethyst Shard&r make 4 &eWarp Dust&r."
		""
		"Warp Dust is not part of the Waystone itself: it powers &eWarp Plates&r, pairs of teleport pads you build yourself."
	]
	quest.2061011630D35145.title: "Sparkle Dust"
	quest.2066DEAD8DF7D147.quest_desc: [
		"Catch 10 &aGrass&r-type Pokémon. Dual-type Pokémon count for both of their types."
		""
		"&6Strong against:&r Water, Ground, Rock"
	]
	quest.2066DEAD8DF7D147.title: "Touch Grass"
	quest.2092D051D65F422F.quest_desc: [
		"A hundred hoards opened, dig sites brushed clean, a Gilded Chest found and a Mimic beaten."
		""
		"The artifact collection below is yours to finish at your own pace."
	]
	quest.2092D051D65F422F.title: "Treasure Hunter"
	quest.209468F303811770.quest_desc: ["Give Poliwhirl or Slowpoke a King's Rock to hold, then trade it or use a Link Cable on it."]
	quest.209468F303811770.title: "Long Live the King"
	quest.20ABC3B3A8DA45F8.quest_desc: [
		"One block walked in the Nether equals &e8 blocks&r in the Overworld."
		""
		"Build a second portal at Overworld coordinates divided by 8 and you have a highway. Use the Nether to cover 7,000 Overworld blocks to finish this quest."
	]
	quest.20ABC3B3A8DA45F8.title: "Shortcut Through Hell"
	quest.20B42EF02AB77C13.quest_desc: ["Place a &eNote Block&r directly on top of a Disc Shelf to build an audio sequencer."]
