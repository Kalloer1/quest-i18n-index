{
	chapter.0000000000010011.title: "1. Sky Awakening"
	chapter.000000000001050C.title: "2. Resources from Nothing"
	chapter.0000000000010A7E.title: "Power and Energy"
	chapter.0000000000010F35.title: "Create"
	chapter.0000000000011474.title: "Mekanism"
	chapter.0000000000011991.title: "Storage"
	chapter.0000000000011E8C.title: "Magic: Ars Nouveau"
	chapter.00000000000123DC.title: "Magic: Occultism"
	chapter.000000000001292C.title: "Farming and Food"
	chapter.0000000000012E9E.title: "Immersive Engineering"
	chapter.00000000000133DD.title: "Cross-Mod Automation"
	chapter.000000000001394F.title: "Endgame"
	chapter_group.7200000000000001.title: "Start Here"
	chapter_group.7200000000000002.title: "Workshops and Automation"
	chapter_group.7200000000000003.title: "Magic, Farming and Specialties"
	chapter_group.7200000000000004.title: "The Long Game"
	quest.000000000000FA01.quest_desc: [
		"Server islands: /sky create makes your own island. To share, the owner uses /sky invite <player>, then the invited player uses /sky accept <team>. Solo worlds create an island automatically. Also join the same FTB Team for shared quests and claims. /sky home returns home; /sky spawn returns to the lobby."
		"This optional branch ends here. Return to the chapter route and continue a square quest or work toward its hexagonal checkpoint."
	]
	quest.000000000000FA01.quest_subtitle: "Server and multiplayer setup"
	quest.000000000000FA01.title: "Playing with Friends"
	quest.0000000000010055.quest_desc: [
		"Chapter route: wood and a crafting table unlock your island basics. Make string from infested leaves, then open Ex Deorum for meshes, gravel and ore chunks. Return here with iron to finish buckets, renewable water, food and Opening Supplies Ready. Square quests form the progression; circles are optional and hexagons are checkpoints."
		"Collect four logs, bark blocks or stems of any tagged type. Vanilla woods, stripped variants, Nether stems and modded logs count together. Keep replacement saplings and replant before using the last log."
		"Next routes: First Crafting Table; Silkworms and String. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010055.title: "A Tree in the Void"
	quest.0000000000010088.quest_desc: [
		"The cornerstone of all crafting. Place 4 planks in a 2x2 grid."
		"Next routes: Wooden Tools; Chest Storage; Water from Saplings; Your Crook; The Compost Barrel. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010088.title: "First Crafting Table"
	quest.00000000000100BB.quest_desc: [
		"Craft a wooden pickaxe to break stone."
		"Next routes: The Furnace; Renewable Cobblestone. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000100BB.title: "Wooden Tools"
	quest.00000000000100EE.quest_desc: [
		"Smelt ores, cook food, and make charcoal. An essential skyblock tool."
		"Next routes: Fuel Before Machines; A Quick Snack. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000100EE.title: "The Furnace"
	quest.0000000000010132.quest_desc: [
		"Collect four coal or charcoal. Smelting renewable logs into charcoal is the easiest sustainable start; ordinary coal also counts. Keep fuel for torches, heat and your first generator."
		"Next routes: Let There Be Light. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010132.title: "Fuel Before Machines"
	quest.0000000000010176.quest_desc: [
		"Build a protected cobblestone generator using your chest's ice and lava. Break the ice to release water, keep the sources separated correctly, and collect 16 cobblestone. A bad layout can turn lava into obsidian; check the flow before mining."
		"Next routes: Stone Age; Stone Bricks; Sandy Shores; More Growing Space; Hammer Time. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010176.title: "Renewable Cobblestone"
	quest.00000000000101A9.quest_desc: [
		"Upgrade your tools. Stone pickaxes mine faster and last longer."
		"Next routes: Stone Sword. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000101A9.title: "Stone Age"
	quest.00000000000101ED.quest_desc: [
		"Craft torches using sticks and charcoal. Mobs spawn in darkness."
		"This optional branch ends here. Return to the chapter route and continue a square quest or work toward its hexagonal checkpoint."
	]
	quest.00000000000101ED.title: "Let There Be Light"
	quest.0000000000010231.quest_desc: [
		"Craft chest storage for your supplies. Any chest in the supported chest tag counts, so you can use the wood available on your island."
		"Next routes: Optional: Ready for Trouble; First Storage Drawer. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010231.title: "Chest Storage"
	quest.0000000000010264.quest_desc: [
		"Defend yourself against the mobs that appear at night."
		"This optional branch ends here. Return to the chapter route and continue a square quest or work toward its hexagonal checkpoint."
	]
	quest.0000000000010264.title: "Stone Sword"
	quest.00000000000102A8.quest_desc: [
		"Obtain four iron ingots from Ex Deorum. Sieve gravel for iron ore chunks, craft four chunks into an iron ore block, then smelt it. The resource chapter walks through each step."
		"Next routes: Iron Pickaxe; Iron Sword; Buckets for Building; Iron Armor; Opening Supplies Ready; Iron Nuggets; Andesite Alloy; The Spell Book; The Engineer’s Hammer. These are the quests that directly use this step; other prerequisites may also apply."
		"From other chapters: Chunks into Smeltable Ore (Ex Nihilo)."
	]
	quest.00000000000102A8.title: "First Iron Ingots"
	quest.00000000000102DB.quest_desc: [
		"A significant upgrade. Iron pickaxes can mine diamonds."
		"Next routes: Optional: Ready for Trouble. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000102DB.title: "Iron Pickaxe"
	quest.000000000001030E.quest_desc: [
		"Sharp and reliable. Far better for dealing with mobs."
		"This optional branch ends here. Return to the chapter route and continue a square quest or work toward its hexagonal checkpoint."
	]
	quest.000000000001030E.title: "Iron Sword"
	quest.0000000000010352.quest_desc: [
		"Craft two iron buckets. They let you relocate sources and create a renewable water pool without wasting your starter ice. Keep one lava source available until the porcelain crucible works."
		"Next routes: Build a Renewable Water Pool; Food Before Bigger Machines. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010352.title: "Buckets for Building"
	quest.0000000000010396.quest_desc: [
		"Smelt cobblestone into stone, then craft four stone into stone bricks. Smooth stone is a separate block and is not needed for this recipe."
		"This optional branch ends here. Return to the chapter route and continue a square quest or work toward its hexagonal checkpoint."
	]
	quest.0000000000010396.title: "Stone Bricks"
	quest.00000000000103DA.quest_desc: [
		"Gravel can be hammered into sand using the Ex Deorum hammer."
		"Sand is needed for glass, concrete, and more."
		"Next routes: Clear Vision. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000103DA.title: "Sandy Shores"
	quest.000000000001041E.quest_desc: [
		"Smelt sand into glass. You’ll need it for beacons, tanks, and decoration."
		"This optional branch ends here. Return to the chapter route and continue a square quest or work toward its hexagonal checkpoint."
	]
	quest.000000000001041E.title: "Clear Vision"
	quest.0000000000010462.quest_desc: [
		"Use an Ex Deorum wooden barrel and surplus saplings or other compostable material to make dirt. Keep your original grass block so grass can spread onto new dirt. Any supported growing-soil variant counts for the collection task."
		"Next routes: Food Before Bigger Machines. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010462.title: "More Growing Space"
	quest.0000000000010495.quest_desc: [
		"Protect yourself. Iron armor significantly reduces damage from mobs."
		"Next routes: Optional: Ready for Trouble. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010495.title: "Iron Armor"
	quest.00000000000104FB.quest_desc: [
		"Collect the listed iron equipment and chests. This is an optional equipment checkpoint; you can continue the main opening without completing it."
		"This optional branch ends here. Return to the chapter route and continue a square quest or work toward its hexagonal checkpoint."
	]
	quest.00000000000104FB.title: "Optional: Ready for Trouble"
	quest.0000000000010550.quest_desc: [
		"Keep an Ex Deorum crook available. One is included in the starter kit; if it was lost, craft another using JEI. Crook leaves for spare saplings and silkworms."
		"This optional branch ends here. Return to the chapter route and continue a square quest or work toward its hexagonal checkpoint."
		"From other chapters: First Crafting Table (Skyblock Basics)."
	]
	quest.0000000000010550.title: "Your Crook"
	quest.0000000000010594.quest_desc: [
		"Craft any regular Ex Deorum hand sieve and install a mesh. All wood variants count. Sieve gravel for ore chunks, dirt for crops/seeds, and dust for bone meal and redstone. Mechanical and compressed sieves are separate machine types; inspect their own recipes in JEI."
		"Next routes: Flint Mesh; Flint from Gravel; Ore Chunks from Gravel; Bone Meal from Dust. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010594.title: "Sieve, Then Upgrade"
	quest.00000000000105D8.quest_desc: [
		"Upgrade your string mesh with flint using JEI. Better meshes change the available drops and chances; a higher tier is not automatically better for every output."
		"Next routes: Iron Mesh; Sourceberries from Dirt; Archwood from Moss. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000105D8.title: "Flint Mesh"
	quest.000000000001061C.quest_desc: [
		"Obtain 16 flint from gravel. Hammering and sieving provide routes; use JEI to inspect the available recipes. Reserve four flint when upgrading an existing string mesh."
		"This optional branch ends here. Return to the chapter route and continue a square quest or work toward its hexagonal checkpoint."
	]
	quest.000000000001061C.title: "Flint from Gravel"
	quest.0000000000010660.quest_desc: [
		"Upgrade to an iron mesh for better ore yields from sieving."
		"Next routes: Gold Fever; Your First Mechanical Sieve; Osmium: The Backbone; Uranium or Yellorium. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010660.title: "Iron Mesh"
	quest.00000000000106A4.quest_desc: [
		"The hammer crushes blocks into smaller forms: cobblestone → gravel → sand → dust."
		"Next routes: Iron Hammer; Crushing It. These are the quests that directly use this step; other prerequisites may also apply."
		"From other chapters: Renewable Cobblestone (Skyblock Basics)."
	]
	quest.00000000000106A4.title: "Hammer Time"
	quest.00000000000106E8.quest_desc: [
		"More durable and faster than the stone hammer."
		"This optional branch ends here. Return to the chapter route and continue a square quest or work toward its hexagonal checkpoint."
	]
	quest.00000000000106E8.title: "Iron Hammer"
	quest.000000000001072C.quest_desc: [
		"Hammer sand into dust. Dust sieves give the best ore yields of any material."
		"Next routes: Bone Meal from Dust; Dust and Water Make Clay. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.000000000001072C.title: "Crushing It"
	quest.0000000000010770.quest_desc: [
		"Collect 16 iron nuggets, for example by breaking down iron ingots. Ex Deorum's gravel sieve route produces iron ore chunks, not these nuggets. The new Ore Chunks quest teaches the actual route."
		"This optional branch ends here. Return to the chapter route and continue a square quest or work toward its hexagonal checkpoint."
		"From other chapters: First Iron Ingots (Skyblock Basics)."
	]
	quest.0000000000010770.title: "Iron Nuggets"
	quest.00000000000107B4.quest_desc: [
		"Sieve dust or gravel through an iron mesh to find gold nuggets."
		"Next routes: Gold Mesh. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000107B4.title: "Gold Fever"
	quest.00000000000107F8.quest_desc: [
		"Craft a gold mesh for even better rare drops when sieving."
		"Next routes: Diamond in the Rough; Green Means Go. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000107F8.title: "Gold Mesh"
	quest.000000000001083C.quest_desc: [
		"Diamonds can be sieved from gravel or dust with a gold mesh. Patient sieving pays off."
		"Next routes: Blackstone to Netherite; Master Sifter; Build an End Portal. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.000000000001083C.title: "Diamond in the Rough"
	quest.0000000000010880.quest_desc: [
		"Craft any Ex Deorum wooden barrel. All wood variants count. Feed surplus saplings to compost dirt; barrels also collect rain and mix dust with water to make clay. Empty the barrel before switching jobs."
		"Next routes: Dirt from Spare Saplings; Dust and Water Make Clay. These are the quests that directly use this step; other prerequisites may also apply."
		"From other chapters: First Crafting Table (Skyblock Basics)."
	]
	quest.0000000000010880.title: "The Compost Barrel"
	quest.00000000000108C4.quest_desc: [
		"Compost eight spare saplings per dirt in your oak barrel. Make eight dirt for your farm and tree patch. Never compost your final replacement sapling."
		"This optional branch ends here. Return to the chapter route and continue a square quest or work toward its hexagonal checkpoint."
	]
	quest.00000000000108C4.title: "Dirt from Spare Saplings"
	quest.0000000000010908.quest_desc: [
		"Smelt an unfired porcelain crucible. Place the fired crucible above a valid heat source, such as a torch, then add cobblestone for lava. The oak crucible is the separate water-producing block."
		"Next routes: Renewable Lava. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010908.title: "Fire the Porcelain Crucible"
	quest.000000000001094C.quest_desc: [
		"Collect one lava bucket from your heated porcelain crucible. Start with a torch underneath; faster heat sources are later upgrades. Keep the cobblestone feed renewable before spending lava on power materials."
		"Next routes: A Small Powered Workshop; A Route to the Nether. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.000000000001094C.title: "Renewable Lava"
	quest.0000000000010990.quest_desc: [
		"Resource route: string mesh and hand sieve, gravel and ore chunks, smeltable ore, then iron. Dust plus water gives clay; bone meal plus clay gives porcelain for a fired lava crucible. Renewable lava and the opening supplies lead into a powered workshop. Consult the named cross-chapter prerequisites when a quest is locked."
		"Craft a string mesh with nine string from fully infested leaves. The string mesh is the first mesh, before flint and iron. A sieve needs an installed mesh to produce resources."
		"Next routes: Sieve, Then Upgrade. These are the quests that directly use this step; other prerequisites may also apply."
		"From other chapters: Silkworms and String (Skyblock Basics)."
	]
	quest.0000000000010990.title: "Weave a String Mesh"
	quest.00000000000109D4.quest_desc: [
		"Emeralds can be sieved from gravel with a gold mesh. Useful for Apotheosis and trading."
		"This optional branch ends here. Return to the chapter route and continue a square quest or work toward its hexagonal checkpoint."
	]
	quest.00000000000109D4.title: "Green Means Go"
	quest.0000000000010A18.quest_desc: [
		"Sieve Ex Deorum crushed blackstone for ancient debris. Check JEI for valid meshes and chances; the installed diamond-mesh recipe has a 6% chance per operation. Soul sand is not the input for that recipe."
		"Next routes: Master Sifter. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010A18.title: "Blackstone to Netherite"
	quest.0000000000010A6D.quest_desc: [
		"You’ve unlocked the full sieving chain. Diamond mesh gives the finest yields of all."
		"This optional branch ends here. Return to the chapter route and continue a square quest or work toward its hexagonal checkpoint."
	]
	quest.0000000000010A6D.title: "Master Sifter"
	quest.0000000000010AC2.quest_desc: [
		"The Furnator burns solid fuel to generate RF energy."
		"Place a chest of coal next to it and connect your first machine."
		"Next routes: Power Lines; Upgraded Generator. These are the quests that directly use this step; other prerequisites may also apply."
		"From other chapters: A Small Powered Workshop (Ex Nihilo)."
	]
	quest.0000000000010AC2.title: "First Generator"
	quest.0000000000010B06.quest_desc: [
		"Powah wire transfers energy between generators, cells, and machines."
		"Next routes: Energy Storage. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010B06.title: "Power Lines"
	quest.0000000000010B4A.quest_desc: [
		"Store RF energy in an energy cell. No more wasting power when machines are idle."
		"Next routes: Flux Networks; Bigger Battery. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010B4A.title: "Energy Storage"
	quest.0000000000010B8E.quest_desc: [
		"Flux Networks lets you transmit power wirelessly."
		"Place a Flux Plug on your generator and a Flux Point on your machine."
		"Next routes: Power Distribution. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010B8E.title: "Flux Networks"
	quest.0000000000010BD2.quest_desc: [
		"Flux Points receive power from your Flux network and deliver it to machines."
		"Next routes: Network Controller. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010BD2.title: "Power Distribution"
	quest.0000000000010C05.quest_desc: [
		"The hardened Furnator produces more RF/t from the same fuel. Upgrade early."
		"Next routes: Thermo Generator; Energizing Rod. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010C05.title: "Upgraded Generator"
	quest.0000000000010C38.quest_desc: [
		"Upgrade your energy cell to store more RF. You’ll need it when Mekanism comes online."
		"Next routes: Power Broker. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010C38.title: "Bigger Battery"
	quest.0000000000010C7C.quest_desc: [
		"Place a Thermo Generator between a lava source and water."
		"It generates passive RF indefinitely — no fuel required."
		"Next routes: Power Broker. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010C7C.title: "Thermo Generator"
	quest.0000000000010CAF.quest_desc: [
		"The Flux Controller manages your entire power network. Monitor input, output, and storage."
		"Next routes: Flux Storage; Player Power; Flux Configurator. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010CAF.title: "Network Controller"
	quest.0000000000010CE2.quest_desc: [
		"Centralized RF storage on your Flux network. Massive capacity for late-game demands."
		"Next routes: Power Broker. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010CE2.title: "Flux Storage"
	quest.0000000000010D15.quest_desc: [
		"The core of Powah’s crafting. Place it in an Energizing Orb to craft advanced Powah components."
		"Next routes: Energizing Orb. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010D15.title: "Energizing Rod"
	quest.0000000000010D48.quest_desc: [
		"Place 2 rods in an orb structure to begin energized crafting."
		"Next routes: Blazing Furnator. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010D48.title: "Energizing Orb"
	quest.0000000000010D8C.quest_desc: [
		"The core crafting material for advanced Powah items. Craft it in the Energizing Orb."
		"Next routes: A Small Powered Workshop; Power Broker. These are the quests that directly use this step; other prerequisites may also apply."
		"From other chapters: Dust and Water Make Clay (Ex Nihilo)."
	]
	quest.0000000000010D8C.title: "Dielectric Casing"
	quest.0000000000010DBF.quest_desc: [
		"A major step up in RF/t generation. Can sustain most mid-game power needs."
		"Next routes: Reactor Components; Blazing Storage. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010DBF.title: "Blazing Furnator"
	quest.0000000000010DF2.quest_desc: [
		"Powah Reactors are multiblock generators that produce massive RF/t."
		"Next routes: Reactor Online. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010DF2.title: "Reactor Components"
	quest.0000000000010E36.quest_desc: [
		"Build a Powah Reactor multiblock."
		"Controller + cells + rods = enormous power generation."
		"Next routes: Power Broker. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010E36.title: "Reactor Online"
	quest.0000000000010E69.quest_desc: [
		"The Player Transmitter charges your curio items wirelessly. Never run out of power mid-task."
		"Next routes: Power Broker. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010E69.title: "Player Power"
	quest.0000000000010E9C.quest_desc: [
		"Craft the normal Flux Configurator to configure your network. The admin configurator is not a survival progression objective."
		"Next routes: Power Broker. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010E9C.title: "Flux Configurator"
	quest.0000000000010ECF.quest_desc: [
		"A huge RF buffer. Keep your machines running even during reactor downtime."
		"Next routes: Power Broker. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010ECF.title: "Blazing Storage"
	quest.0000000000010F24.quest_desc: [
		"Your power infrastructure is set. A reactor and a flux network — you’ll never starve for RF again."
		"This is the endpoint of this chapter. One incoming route opens the checkpoint; its listed tasks still have to be completed. Continue to A Workshop Achievement in Endgame."
		"Workshop checkpoint: complete any one of the listed prerequisite quests, then satisfy this quest's own tasks. You do not need every branch."
		"Next routes: A Workshop Achievement. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010F24.title: "Power Broker"
	quest.0000000000010F79.quest_desc: [
		"The base crafting material for all early Create machinery. Craft it from andesite and iron nuggets."
		"Next routes: First Cogwheel. These are the quests that directly use this step; other prerequisites may also apply."
		"From other chapters: First Iron Ingots (Skyblock Basics)."
	]
	quest.0000000000010F79.title: "Andesite Alloy"
	quest.0000000000010FBD.quest_desc: [
		"Cogwheels transmit rotational force. Place them adjacent to transfer rotation between shafts."
		"Next routes: Shaft Power. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000010FBD.title: "First Cogwheel"
	quest.0000000000011001.quest_desc: [
		"Shafts carry rotational force in a straight line. Build your first power network."
		"Next routes: Water Wheel. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011001.title: "Shaft Power"
	quest.0000000000011045.quest_desc: [
		"Place a water wheel in flowing water to generate stress units."
		"A great early-game source of rotational power."
		"Next routes: Mechanical Press. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011045.title: "Water Wheel"
	quest.0000000000011089.quest_desc: [
		"The mechanical press crushes and presses items. Essential for making sheets and other components."
		"Next routes: Basin. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011089.title: "Mechanical Press"
	quest.00000000000110CD.quest_desc: [
		"The mixer combines ingredients using rotational force. Needed for brass and many recipes."
		"Next routes: Heated Brass. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000110CD.title: "Mechanical Mixer"
	quest.0000000000011111.quest_desc: [
		"Mix copper and zinc with a heated Create mixer over a basin. The bundled brass recipe explicitly requires heat: capture a blaze in a burner and supply fuel. The normal Nether is available in this test build; use the sand island's obsidian for your portal."
		"Next routes: Brass Casing; Forge the Connection. These are the quests that directly use this step; other prerequisites may also apply."
		"From other chapters: A Route to the Nether (Ex Nihilo)."
	]
	quest.0000000000011111.title: "Heated Brass"
	quest.0000000000011155.quest_desc: [
		"Craft brass casings to house advanced Create machines."
		"Next routes: Deployer; Chain Drive. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011155.title: "Brass Casing"
	quest.0000000000011199.quest_desc: [
		"The deployer uses a mechanical arm to interact with blocks and entities automatically."
		"Next routes: Auto Farm; Mechanical Crafter. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011199.title: "Deployer"
	quest.00000000000111CC.quest_desc: [
		"Attach a mechanical harvester to a moving contraption to automate crop harvesting."
		"Next routes: Fully Automated. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000111CC.title: "Auto Farm"
	quest.0000000000011210.quest_desc: [
		"The basin catches outputs from the press and mixer. Required for many crafting recipes."
		"Next routes: Mechanical Mixer; Fluid Pipes. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011210.title: "Basin"
	quest.0000000000011254.quest_desc: [
		"Connect fluid sources to basins, tanks, and spouts using fluid pipes."
		"Next routes: Mechanical Pump. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011254.title: "Fluid Pipes"
	quest.0000000000011298.quest_desc: [
		"Pumps move fluids through pipes. Needs rotational power to operate."
		"Next routes: Steam Engine. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011298.title: "Mechanical Pump"
	quest.00000000000112DC.quest_desc: [
		"Steam engines produce far more stress units than water wheels."
		"Heat a boiler with lava or solid fuel for high-output rotational power."
		"Next routes: Fully Automated. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000112DC.title: "Steam Engine"
	quest.000000000001130F.quest_desc: [
		"Automate shapeless and shaped crafting recipes with the mechanical crafter array."
		"Next routes: Mechanical Arm; Fully Automated. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.000000000001130F.title: "Mechanical Crafter"
	quest.0000000000011353.quest_desc: [
		"Transmit rotation across long distances with chain drives."
		"Next routes: Speed Control. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011353.title: "Chain Drive"
	quest.0000000000011386.quest_desc: [
		"Control the exact RPM of your rotational networks for precise machine operation."
		"Next routes: Fully Automated. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011386.title: "Speed Control"
	quest.00000000000113CA.quest_desc: [
		"The mechanical arm automatically moves items between inventories and machines."
		"Next routes: Portable Interface; Fully Automated. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000113CA.title: "Mechanical Arm"
	quest.00000000000113FD.quest_desc: [
		"Access the inventory of a moving contraption from a fixed block."
		"Next routes: Fully Automated. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000113FD.title: "Portable Interface"
	quest.0000000000011463.quest_desc: [
		"Your Create factory is humming."
		"Steam power, automated crafting, and moving contraptions — the sky island is truly alive."
		"This is the endpoint of this chapter. One incoming route opens the checkpoint; its listed tasks still have to be completed. Continue to A Workshop Achievement in Endgame."
		"Workshop checkpoint: complete any one of the listed prerequisite quests, then satisfy this quest's own tasks. You do not need every branch."
		"Next routes: A Workshop Achievement. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011463.title: "Fully Automated"
	quest.00000000000114B8.quest_desc: [
		"The energy cube stores RF and bridges Mekanism with other power systems."
		"Next routes: Enrichment Chamber. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000114B8.title: "Mekanism Power"
	quest.00000000000114FC.quest_desc: [
		"Osmium is Mekanism’s primary metal."
		"Sieve gravel or dust to find osmium ore chunks."
		"Next routes: Metallurgic Infuser. These are the quests that directly use this step; other prerequisites may also apply."
		"From other chapters: Iron Mesh (Ex Nihilo)."
	]
	quest.00000000000114FC.title: "Osmium: The Backbone"
	quest.0000000000011540.quest_desc: [
		"Doubles ore processing. Put raw ores in to get 2x the ingots."
		"Next routes: Crusher. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011540.title: "Enrichment Chamber"
	quest.0000000000011584.quest_desc: [
		"The crusher grinds materials into clumps and powders for further processing."
		"Next routes: Electrolytic Separator. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011584.title: "Crusher"
	quest.00000000000115C8.quest_desc: [
		"The purification chamber + crusher + enrichment chamber chain gives you 3x ores."
		"Requires oxygen gas from an electrolytic separator."
		"Next routes: Mekanism Mastery. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000115C8.title: "3x Ore Processing"
	quest.000000000001160C.quest_desc: [
		"Split water into hydrogen and oxygen. Oxygen powers 3x processing; hydrogen fuels the gas burner."
		"Next routes: 3x Ore Processing; 4x Processing; Electric Pump. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.000000000001160C.title: "Electrolytic Separator"
	quest.0000000000011650.quest_desc: [
		"Add the chemical injection chamber (using hydrogen chloride) to push to 4x ore output."
		"Next routes: 5x Processing. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011650.title: "4x Processing"
	quest.0000000000011694.quest_desc: [
		"The full 5-step processing chain with chemical crystallizer produces 5x ores. Maximum efficiency."
		"Next routes: Mekanism Mastery. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011694.title: "5x Processing"
	quest.00000000000116D8.quest_desc: [
		"Automate infinite water supply for your electrolytic separator and other fluid needs."
		"Next routes: Mekanism Mastery. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000116D8.title: "Electric Pump"
	quest.000000000001171C.quest_desc: [
		"Infuse metals with carbon, redstone, diamond, and more to create alloys."
		"Next routes: Infused Alloy. These are the quests that directly use this step; other prerequisites may also apply."
		"From other chapters: Forge the Connection (Cross Mod Automation)."
	]
	quest.000000000001171C.title: "Metallurgic Infuser"
	quest.0000000000011760.quest_desc: [
		"The base crafting material for advanced Mekanism machines. Osmium + redstone in the infuser."
		"Next routes: Mekanism Power; Reinforced Alloy; Solar Power; Manaforged Alloy. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011760.title: "Infused Alloy"
	quest.00000000000117A4.quest_desc: [
		"Infuse infused alloy with diamond for reinforced alloy. Required for tier 3 machines."
		"Next routes: Digital Miner; Quantum Entangloporter; Forge the Sky Core. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000117A4.title: "Reinforced Alloy"
	quest.00000000000117D7.quest_desc: [
		"A powerful mining machine that extracts specific ores from the world using filters."
		"Next routes: Mekanism Mastery. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000117D7.title: "Digital Miner"
	quest.000000000001180A.quest_desc: [
		"Transfer items, fluids, and energy wirelessly between any two points in the world."
		"Next routes: Formulaic Assemblicator. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.000000000001180A.title: "Quantum Entangloporter"
	quest.000000000001184E.quest_desc: [
		"Mekanism solar generators produce RF passively during daylight hours."
		"Next routes: Wind Generator. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.000000000001184E.title: "Solar Power"
	quest.0000000000011892.quest_desc: [
		"Wind generators produce RF based on height. Build them high for maximum output."
		"Next routes: Fission Reactor Casing. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011892.title: "Wind Generator"
	quest.00000000000118C5.quest_desc: [
		"Craft a fission reactor casing. This is a component milestone, not proof of an assembled, fuelled or safe reactor. Follow the installed Mekanism guide and provide its coolant and waste handling before operation."
		"Next routes: Induction Matrix Casing. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000118C5.title: "Fission Reactor Casing"
	quest.00000000000118F8.quest_desc: [
		"Automate crafting recipes using encoded formulas. Pairs beautifully with AE2 or RS."
		"Next routes: Mekanism Mastery. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000118F8.title: "Formulaic Assemblicator"
	quest.000000000001192B.quest_desc: [
		"Craft induction casing. To store energy you also need a valid structure, ports, cells and providers. The quest detects casing, not a working energy buffer."
		"Next routes: Mekanism Mastery. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.000000000001192B.title: "Induction Matrix Casing"
	quest.0000000000011980.quest_desc: [
		"5x ore processing and an induction matrix. The factory floor is fully operational."
		"This is the endpoint of this chapter. One incoming route opens the checkpoint; its listed tasks still have to be completed. Continue to A Workshop Achievement in Endgame."
		"Workshop checkpoint: complete any one of the listed prerequisite quests, then satisfy this quest's own tasks. You do not need every branch."
		"Next routes: A Workshop Achievement. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011980.title: "Mekanism Mastery"
	quest.00000000000119D5.quest_desc: [
		"Storage drawers hold huge amounts of a single item type. Perfect for bulk materials."
		"Next routes: Drawer Controller; Sophisticated Storage. These are the quests that directly use this step; other prerequisites may also apply."
		"From other chapters: Chest Storage (Skyblock Basics)."
	]
	quest.00000000000119D5.title: "First Storage Drawer"
	quest.0000000000011A08.quest_desc: [
		"The drawer controller acts as a hub. Pipe items in and they auto-sort to the correct drawer."
		"Next routes: Refined Storage Controller; AE2 Controller; LaserIO. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011A08.title: "Drawer Controller"
	quest.0000000000011A4C.quest_desc: [
		"Sophisticated chests hold more items and can be upgraded with upgrade slots."
		"Next routes: Iron Chest Upgrade; Backpack. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011A4C.title: "Sophisticated Storage"
	quest.0000000000011A7F.quest_desc: [
		"Upgrade to an iron sophisticated chest for more item capacity."
		"Next routes: Colossal Chest Interface. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011A7F.title: "Iron Chest Upgrade"
	quest.0000000000011AC3.quest_desc: [
		"Sophisticated Backpacks add portable storage you can access on the go."
		"Next routes: Dank Storage; Iron Backpack. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011AC3.title: "Backpack"
	quest.0000000000011B07.quest_desc: [
		"The RS controller is the brain of your Refined Storage network."
		"Connect drives and terminals to it via cable."
		"Next routes: Disk Drive. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011B07.title: "Refined Storage Controller"
	quest.0000000000011B4B.quest_desc: [
		"Insert storage disks into the disk drive to give your RS network storage capacity."
		"Next routes: 1K Storage Disk. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011B4B.title: "Disk Drive"
	quest.0000000000011B8F.quest_desc: [
		"Craft a Refined Storage 1K Storage Disk and place it in a powered Disk Drive. Use the installed 2.x recipes shown in JEI."
		"Next routes: Crafting Grid; 64K Storage Disk. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011B8F.title: "1K Storage Disk"
	quest.0000000000011BC2.quest_desc: [
		"The RS crafting grid lets you craft items using materials in your network directly."
		"Next routes: Pattern Grid. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011BC2.title: "Crafting Grid"
	quest.0000000000011BF5.quest_desc: [
		"Encode crafting patterns to teach your RS network how to auto-craft items."
		"Next routes: Autocrafter. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011BF5.title: "Pattern Grid"
	quest.0000000000011C39.quest_desc: [
		"Craft a Refined Storage Autocrafter, provide a pattern and connect it to a powered network. This detects the block, not a completed crafting job."
		"Next routes: Autocrafting Route Established. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011C39.title: "Autocrafter"
	quest.0000000000011C7D.quest_desc: [
		"Massive storage capacity for your RS network."
		"Next routes: Autocrafting Route Established. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011C7D.title: "64K Storage Disk"
	quest.0000000000011CC1.quest_desc: [
		"Applied Energistics 2 is the most powerful storage system available."
		"Start by building a controller and connecting your first drive."
		"Next routes: ME Drive. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011CC1.title: "AE2 Controller"
	quest.0000000000011D05.quest_desc: [
		"The ME Drive stores cells. Combine multiple drives for massive storage."
		"Next routes: AE2 Autocrafting. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011D05.title: "ME Drive"
	quest.0000000000011D38.quest_desc: [
		"Connect crafting units and a crafting monitor to build a powerful autocrafting system."
		"Next routes: Autocrafting Route Established. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011D38.title: "AE2 Autocrafting"
	quest.0000000000011D7C.quest_desc: [
		"Portable bulk storage. The Dank can hold millions of a single item type in your inventory."
		"Next routes: Autocrafting Route Established. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011D7C.title: "Dank Storage"
	quest.0000000000011DAF.quest_desc: [
		"Craft the wooden Colossal Chest Interface. Use the mod's core and wall blocks to assemble a valid chest; the interface alone is not a functioning multiblock."
		"Next routes: Autocrafting Route Established. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011DAF.title: "Colossal Chest Interface"
	quest.0000000000011DE2.quest_desc: [
		"Upgraded backpack with more slots and upgrade capability."
		"Next routes: Autocrafting Route Established. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011DE2.title: "Iron Backpack"
	quest.0000000000011E26.quest_desc: [
		"LaserIO uses lasers to transfer items, fluids, and energy wirelessly without routing pipes."
		"Next routes: Autocrafting Route Established. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011E26.title: "LaserIO"
	quest.0000000000011E7B.quest_desc: [
		"Choose AE2 or Refined Storage. Own an AE2 Crafting Unit or a Refined Storage Autocrafter after following its branch. You do not have to build the other network. This is an equipment checkpoint; add patterns, power and storage to make a working service."
		"This is the endpoint of this chapter. One incoming route opens the checkpoint; its listed tasks still have to be completed. Continue to A Workshop Achievement in Endgame."
		"Workshop checkpoint: complete any one of the listed prerequisite quests, then satisfy this quest's own tasks. You do not need every branch."
		"Next routes: A Workshop Achievement. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011E7B.title: "Autocrafting Route Established"
	quest.0000000000011ED0.quest_desc: [
		"Ars Nouveau lets you build custom spells from glyphs."
		"Start with the novice spell book and your first glyph."
		"Next routes: Spell Parchment. These are the quests that directly use this step; other prerequisites may also apply."
		"From other chapters: First Iron Ingots (Skyblock Basics)."
	]
	quest.0000000000011ED0.title: "The Spell Book"
	quest.0000000000011F14.quest_desc: [
		"Source is the mana of Ars Nouveau. Fill source jars by placing them near source relays or source gems."
		"Next routes: Source Relay; Agronomic Sourcelink. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011F14.title: "Source Jars"
	quest.0000000000011F58.quest_desc: [
		"Sieve dirt with a flint mesh for Sourceberry Bushes. Grow them on your island and use them alongside a Sourcelink. The source jar does not create berries; this acquisition step comes first."
		"Next routes: Agronomic Sourcelink. These are the quests that directly use this step; other prerequisites may also apply."
		"From other chapters: Flint Mesh (Ex Nihilo)."
	]
	quest.0000000000011F58.title: "Sourceberries from Dirt"
	quest.0000000000011F9C.quest_desc: [
		"Craft spell parchment to write spells onto. Place it in your spellbook to create a usable spell."
		"Next routes: First Glyph. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011F9C.title: "Spell Parchment"
	quest.0000000000011FE0.quest_desc: [
		"Glyphs are the building blocks of spells. Amplify increases a spell’s power."
		"Next routes: The Archmage. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000011FE0.title: "First Glyph"
	quest.0000000000012024.quest_desc: [
		"Relays transfer source between jars. Build a network to keep your source topped up."
		"Next routes: The Archmage. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000012024.title: "Source Relay"
	quest.0000000000012068.quest_desc: [
		"Grow archwood from the moss-sieving route. Use archwood planks and gold for an Imbuement Chamber, then place lapis inside for source gems. A relay is not needed to start this process; source gems unlock further Ars equipment and Manaforged Alloy."
		"Next routes: Manaforged Alloy; Source Relay; Arcane Core; Jar of Light. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000012068.title: "Source Gems First"
	quest.00000000000120AC.quest_desc: [
		"The arcane core is the crafting station for advanced Ars Nouveau components."
		"Next routes: Apprentice Spell Book. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000120AC.title: "Arcane Core"
	quest.00000000000120F0.quest_desc: [
		"Upgrade your spell book to unlock more complex spells and higher glyph tiers."
		"Next routes: Flight Prep; Wixie; Magic Mirror; Archmage Spell Book. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000120F0.title: "Apprentice Spell Book"
	quest.0000000000012123.quest_desc: [
		"The Launch glyph is a step toward the coveted Ars Nouveau flight spell."
		"Next routes: The Archmage. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000012123.title: "Flight Prep"
	quest.0000000000012167.quest_desc: [
		"An eternal light source. Craft it and place it anywhere for permanent illumination."
		"Next routes: The Archmage. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000012167.title: "Jar of Light"
	quest.000000000001219A.quest_desc: [
		"Wixies are magical familiars that can brew potions automatically."
		"Next routes: Drygmy Charm. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.000000000001219A.title: "Wixie"
	quest.00000000000121DE.quest_desc: [
		"Teleport to a set location. Invaluable for navigating back to your base quickly."
		"Next routes: The Archmage. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000121DE.title: "Magic Mirror"
	quest.0000000000012222.quest_desc: [
		"The highest tier spell book. Unlock the most powerful glyphs in Ars Nouveau."
		"Next routes: Flight Ritual. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000012222.title: "Archmage Spell Book"
	quest.0000000000012266.quest_desc: [
		"Craft the Tablet of Flight and read its ritual entry in the Ars guide. Activate it using the documented ritual setup and Source requirements; this is not a flight glyph."
		"Next routes: The Archmage. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000012266.title: "Flight Ritual"
	quest.00000000000122AA.quest_desc: [
		"Generates source from nearby plant growth. Place next to a farm for passive source generation."
		"Next routes: Volcanic Sourcelink. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000122AA.title: "Agronomic Sourcelink"
	quest.00000000000122EE.quest_desc: [
		"Generates source from heat. Place near lava for a fast and reliable source supply."
		"Next routes: The Archmage. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000122EE.title: "Volcanic Sourcelink"
	quest.0000000000012332.quest_desc: [
		"Drygmies are familiars that produce mob drops passively when near mobs."
		"Next routes: Whirlisprig. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000012332.title: "Drygmy Charm"
	quest.0000000000012376.quest_desc: [
		"Whirlisprig familiars accelerate plant growth. Place near your farms for passive crop production."
		"Next routes: The Archmage. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000012376.title: "Whirlisprig"
	quest.00000000000123CB.quest_desc: [
		"Own an Archmage Spell Book and a Tablet of Flight. These are equipment milestones; running the ritual still requires its proper setup."
		"This is the endpoint of this chapter. One incoming route opens the checkpoint; its listed tasks still have to be completed. Continue to A Workshop Achievement in Endgame."
		"Workshop checkpoint: complete any one of the listed prerequisite quests, then satisfy this quest's own tasks. You do not need every branch."
		"Next routes: A Workshop Achievement. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000123CB.title: "The Archmage"
	quest.0000000000012420.quest_desc: [
		"Tallow is rendered from animal fat and is the base of Occultism crafting."
		"Kill pigs or cows to collect raw fat, then smelt it."
		"Next routes: Otherstone; Dictionary of Spirits. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000012420.title: "First Tallow"
	quest.0000000000012464.quest_desc: [
		"Craft Otherstone using tallow and stone. The building material of Occultism structures."
		"Next routes: Spirit-Attuned Gem; Otherstone Frame. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000012464.title: "Otherstone"
	quest.00000000000124A8.quest_desc: [
		"A spirit-attuned gem channels spiritual energy. Essential for summoning rituals."
		"Next routes: The Pentacle. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000124A8.title: "Spirit-Attuned Gem"
	quest.00000000000124EC.quest_desc: [
		"Draw a pentacle on the ground to create a ritual circle. The foundation of all summoning."
		"Next routes: Golden Chalk; Spirit Storage; Foliot Miner. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000124EC.title: "The Pentacle"
	quest.0000000000012530.quest_desc: [
		"Craft a sacrificial bowl and use the Dictionary of Spirits to build the correct pentacle. Rituals use bowls and their documented ingredients, not a survival ritual-dummy item."
		"Next routes: The Pentacle; Soul Gem. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000012530.title: "The Sacrificial Bowl"
	quest.0000000000012574.quest_desc: [
		"The Occultism guidebook. Read it carefully — it contains every ritual and summon you need."
		"Next routes: The Sacrificial Bowl. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000012574.title: "Dictionary of Spirits"
	quest.00000000000125B8.quest_desc: [
		"Use golden chalk to draw the ritual pentacle on the ground."
		"Next routes: Otherworldly Rituals. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000125B8.title: "Golden Chalk"
	quest.00000000000125FC.quest_desc: [
		"Craft Otherstone frames for your storage and summoning infrastructure."
		"Next routes: Master of Spirits. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000125FC.title: "Otherstone Frame"
	quest.0000000000012640.quest_desc: [
		"Occultism’s dimensional storage uses summoned spirits to store items in other dimensions."
		"Build the storage controller to get started."
		"Next routes: Stable Wormhole. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000012640.title: "Spirit Storage"
	quest.0000000000012684.quest_desc: [
		"Connect your Occultism storage network with a stable wormhole for remote access."
		"Next routes: Storage Remote. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.0000000000012684.title: "Stable Wormhole"
	quest.00000000000126C8.quest_desc: [
		"Summon a Foliot miner spirit to mine ores from the spirit dimension for you."
		"Next routes: Djinni Miner. These are the quests that directly use this step; other prerequisites may also apply."
	]
	quest.00000000000126C8.title: "Foliot Miner"
	quest.000000000001270C.quest_desc: [
		"Upgrade to a Djinni miner for better ore returns from the spirit dimension."
		"Next routes: Afrit Miner. These are the quests that directly use this step; other prerequisites may also apply."
