	quest.4BF8C4D991693674.quest_desc: [
		"&e/sethome [name]"
		"&rSets a home at your current location."
		"(Example: /sethome base)"
		""
		"&e/home [name]"
		"&rTeleports you to one of your homes."
		""
		"&e/delhome [name]"
		"&rDeletes a saved home."
		""
		"&e/tpa <player>"
		"Sends a teleport request to another player (you go to them)."
		""
		"&e/tpahere <player>"
		"Sends a request asking another player to teleport to you."
		""
		"&e/spawn"
		"Teleports you to the world spawn."
		""
		"&e/back"
		"Teleports you to your last location (death, teleport, etc)."
	]
