	quest.553DF37945AEF5CD.title: "Farmer III"
	quest.5C124A869AEFDB36.quest_desc: ["A Basket acts as a &eregular storage container&r, but it &eautomatically catches&r and stores any &bdropped items&r that fall directly onto it."]
