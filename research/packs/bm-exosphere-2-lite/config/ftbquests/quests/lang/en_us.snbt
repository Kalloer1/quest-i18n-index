	quest.415ACA3982235C25.title: "Energy Gadgets"
	quest.4163C08075DB7282.title: "Flowers II"
	quest.42AE3C7834297D98.quest_desc: [
		"&bExperience Rod&r can be used to craft an &dXP Vacuum&r, which &apicks up all experience orbs&r in a cube-shaped area around itself.  "
		""
		"Stored &aexperience&r can be retrieved by using an &bExperience Rod&r on the XP Vacuum."
	]
	quest.42AE3C7834297D98.quest_subtitle: "Orbs denied, mine now"
	quest.42D7991653AF3017.quest_desc: [
		"\"&bRight-click&r\" on a block to link a &etelelocation point&r."
		""
