	quest.47C59CBCD6872B7F.quest_subtitle: "Glide safely from heights and travel through the air. Heat sources provide updraft."
	quest.48C2D524DA69B634.quest_desc: [
		"&bExperience Rod&r can be combined with &bSoularium&r to create a &dXP Obelisk&r, which serves as an &aexperience storage&r. It allows you to deposit your levels to prevent losing them on death.  "
		""
		"You can retrieve stored experience at any time without needing an &bExperience Rod&r to interact with it."
	]
	quest.48C2D524DA69B634.quest_subtitle: "Green number storage"
	quest.4902A65C556CE35D.quest_desc: [
		"To begin with &dEnderIO&r, you need &eGrains of Infinity&r, which can be obtained in two ways:"
		"{@pagebreak}"
		"&lMethod 1&r"
		"Shift-right-click Obsidian or a Grindstone while holding &bFlint&r in your off-hand and &bDeepslate&r in your main hand."
		"{@pagebreak}"
		"&lMethod 2&r"
		"Smelt &bMagma Blocks&r in a Furnace to produce &eGrains of Infinity&r."
	]
	quest.4902A65C556CE35D.quest_subtitle: "The Soul of EnderIO"
	quest.496EC3753286D05D.quest_desc: [
		"The &dAlloy Smelter&r combines metals and materials to create alloys essential for advanced crafting."
		""
		"It runs on &aForge Energy&r (FE) and can smelt multiple items at once."
		""
		"Make sure to set the proper smelting mode for your recipes."
	]
