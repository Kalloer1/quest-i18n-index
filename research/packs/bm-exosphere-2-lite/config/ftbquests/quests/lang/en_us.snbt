	quest.4B3B22E5E56E75B9.title: "&zBegin Quests&r"
	quest.4B8C7593E46FACF3.quest_desc: ["Be sure to clear the portal of any &bSculk Veins&r or other blocks&e before activation&r."]
	quest.4B8C7593E46FACF3.quest_subtitle: "Defeat the Warden to obtain the Heart of the Deep, a guaranteed drop. Use it within a reinforced deepslate frame to activate an Otherside portal"
	quest.4B8C7593E46FACF3.title: "&bConquer the Ancient City&r"
	quest.4C329227EA1A5693.title: "Dragonslayer"
	quest.4C7CBD85F6577820.quest_desc: [
		"&dRedstone Conduit&r transmits redstone signals between &bmachines&r and &bblocks&r, offering precise automation control.  "
		""
		"Multiple signals can overlap &ein the same block&r, allowing for compact and efficient circuit management."
		""
		"Configure channels for advanced redstone logic."
	]
	quest.4D7B262F2EE2A9D3.title: "Hot spores"
	quest.4D90E2231DD52221.quest_desc: [
		"&dSlice'N'Spice&r is a machine used to craft &eadvanced mob heads&r and other components for automation.  "
		""
		"Powered by &aForge Energy&r, it requires &bShears&r and &bAxes&r as tools to process ingredients efficiently."
		"{@pagebreak}"
		"As of now, they yet don't have lots of different uses except for the &dZ-logic controller&r."
