	quest.46A9FDACAE900F62.title: "Resistant Glider II"
	quest.4736D669E2541CED.quest_desc: [
		"Once you defeat the Sacred Pontiff, you will receive &bmaterials&r that can be used to craft the &eRespawn Totem&r."
		""
