	quest.44DEBD1D9A5168DC.quest_subtitle: "Now we can get started!"
	quest.44DEBD1D9A5168DC.title: "&dBasic Alloys"
	quest.4522809F68217195.title: "Ronin"
	quest.4572074B0B54AA8F.quest_desc: [
