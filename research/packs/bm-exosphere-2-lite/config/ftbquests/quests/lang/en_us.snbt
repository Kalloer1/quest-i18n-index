	quest.283C9111AD1A134A.quest_desc: [
		"Royall's server is composed of &ethree different worlds&r!"
		""
		"- &aDefault&r is the basic preset of Exosphere, with floating islands and lots to explore."
		""
		"- &cAmplified&r combines the default preset with the craziness of the amplified worlds, heavily extending the height of the islands."
		""
		"- &bSparse&r is a preset where the void is predominant, with the islands being way more separated from one another."
	]
	quest.28E2A147AAE3A857.title: "Thief"
	quest.2924231931C7E34D.quest_desc: [
