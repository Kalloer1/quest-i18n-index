	quest.0000000000000C6F.quest_desc: [
		"[&e!&f] This compass can help you locate meteorites."
		""
		"&eNOTE:&f Meteorites can generate in the Overworld Mining Dimension too, at the same coordinates as in the overworld, 1:1."
		""
		"&rCraft the Mining Dimension (Overworld) Portal Block to access it."
		""
		"Place it, then right-click it and you're in!"
	]
