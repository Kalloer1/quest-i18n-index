	quest.000000000000004E.quest_desc: ["&7> Better be prepared!"]
	quest.000000000000004E.quest_subtitle: "Summon the Wither Boss."
	quest.0000000000000050.quest_subtitle: "Brew any potion in a Brewing Stand or similar."
	quest.0000000000000052.quest_subtitle: "Construct and place a Beacon."
	quest.000000000000006B.quest_subtitle: "Distract Piglins with gold"
	quest.000000000000006D.quest_subtitle: "Hit the bullseye of a Target block from at least 30 meters away"
	quest.00000000000000B0.quest_subtitle: "Successfully trade with a Villager."
	quest.00000000000000B2.quest_subtitle: "Kill any hostile monster"
	quest.00000000000000B4.quest_subtitle: "Kill a raid captain."
	quest.00000000000000B6.quest_subtitle: "Successfully defend a village from a raid."
	quest.00000000000000B8.quest_subtitle: "Shoot something with an arrow."
	quest.00000000000000BA.quest_subtitle: "Kill one of every Vanilla hostile monster."
	quest.00000000000000BC.quest_subtitle: "Kill a Skeleton type mob 50+ blocks away (horizontally) from your current location. (Not vertically)."
	quest.00000000000000BE.quest_subtitle: "Note: Throwing away your only weapon is not a good idea."
	quest.00000000000000C0.quest_subtitle: "Strike a Villager with lightning."
	quest.00000000000000C2.quest_subtitle: "Summon an Iron Golem to help defend a village."
	quest.00000000000000C4.quest_subtitle: "Use a Totem of Undying to cheat death."
	quest.00000000000000C6.quest_subtitle: "Jump into a Honey Block to break your fall."
	quest.00000000000000C8.quest_subtitle: "Kill two Phantoms with a piercing arrow."
	quest.00000000000000CA.quest_subtitle: "Shoot a crossbow."
	quest.00000000000000CC.quest_subtitle: "Give a Pillager a taste of their own medicine!"
	quest.00000000000000CE.quest_subtitle: "Kill five unique mobs with one crossbow shot."
	quest.00000000000000D0.quest_subtitle: "Sleep in a bed, changing your respawn point."
	quest.00000000000000D2.quest_subtitle: "Discover every biome."
	quest.00000000000000D7.quest_subtitle: "Tame an animal."
	quest.00000000000000D9.quest_subtitle: "Play the minigame \\& catch a fish!"
	quest.00000000000000DB.quest_subtitle: "Move a Bee Nest, with 3 bees inside, using Silk Touch."
	quest.00000000000000DD.quest_subtitle: "Breed two animals together."
	quest.00000000000000DF.quest_subtitle: "Use a Campfire to collect Honey from a Beehive using a Bottle without aggravating the bees."
	quest.00000000000000E1.quest_subtitle: "Plant a seed and watch it grow."
	quest.00000000000000E3.quest_subtitle: "Eat everything that is edible even if it's not good for you.."
	quest.00000000000000E5.quest_subtitle: "Use a Netherite ingot to upgrade a hoe, and then reevaluate your life choices"
	quest.00000000000000E7.quest_subtitle: "Catch a fish... without a fishing rod!"
	quest.00000000000000E9.quest_subtitle: "Tame all cat variants!"
	quest.00000000000000EB.quest_subtitle: "Breed all the animals!"
	quest.00000000000000F0.quest_subtitle: "Kill the majestic Ender Dragon."
	quest.00000000000000F2.quest_subtitle: "Escape the Main Island"
	quest.00000000000000F6.quest_subtitle: "Collect dragon's breath in a glass bottle, right click in the purple particles that the dragon creates."
	quest.00000000000000F8.quest_desc: ["&e[!] &7Need more than one dragon egg? Respawn the Ender Dragon and get another one at the end fountain!"]
	quest.00000000000000F8.quest_subtitle: "Hold the Dragon Egg"
	quest.00000000000000FA.quest_desc: ["              &7(Find an End City.)"]
	quest.00000000000000FA.quest_subtitle: "Go on in, what could happen?"
	quest.00000000000000FC.quest_subtitle: "Find an elytra.. to infinity and beyond!"
	quest.00000000000000FE.quest_subtitle: "Levitate up 50 blocks from the attacks of a Shulker"
	quest.000000000000010F.quest_subtitle: "Kill an Iron Golem, then steal its Roses \\& Iron Ingots."
	quest.000000000000013C.quest_subtitle: "Kill a Zombified Piglin."
	quest.0000000000000192.quest_desc: ["The most basic item which most Mekanism machines and generators use. Crafted in the Metallurgic Infuser by infusing an Iron Ingot with Redstone, Redstone Blocks, or Compressed Redstone."]
	quest.0000000000000192.quest_subtitle: "Create Enriched Alloy"
	quest.0000000000000194.quest_desc: ["Upgraded version of the Enriched Alloy which some Mekanism machines and items use. Crafted in the Metallurgic Infuser by infusing an Enriched Alloy with Diamond Dust or Compressed Diamond."]
	quest.0000000000000194.quest_subtitle: "Create Reinforced Alloy"
	quest.0000000000000196.quest_desc: ["Upgraded version of the Reinforced Alloy which some Mekanism machines and items use. Crafted in the Metallurgic Infuser by infusing a Reinforced Alloy with Refined Obsidian Dust or Compressed Obsidian."]
	quest.0000000000000196.quest_subtitle: "Create Atomic Alloy"
	quest.0000000000000198.quest_desc: ["The Basic Control Circuit is a Crafting Component used in the creation of multiple lower-tier machines."]
	quest.0000000000000198.quest_subtitle: "Create a Basic Control Circuit"
	quest.000000000000019A.quest_desc: ["An upgraded Basic Control Circuit, used in many tier 2 machines and items."]
	quest.000000000000019A.quest_subtitle: "Create a Advanced Control Circuit"
	quest.000000000000019C.quest_desc: ["An upgraded Advanced Control Circuit, used in many tier 3 machines and items."]
	quest.000000000000019C.quest_subtitle: "Create a Elite Control Circuit"
	quest.000000000000019E.quest_desc: ["An upgraded Elite Control Circuit, used in many tier 4 machines and items."]
	quest.000000000000019E.quest_subtitle: "Create a Ultimate Control Circuit"
	quest.00000000000001A0.quest_desc: [
		"Enriched Carbon is used in the Metallurgic Infuser."
		" "
		"Enriched Carbon yields 80 units of carbon in the infuser, the same as 8 coal or 4 charcoal."
	]
	quest.00000000000001A0.quest_subtitle: "Create Enriched Carbon"
	quest.00000000000001A2.quest_desc: [
		"Enriched Redstone is used in the Metallurgic Infuser."
		" "
		"Enriched Redstone yields 80 units of redstone in the Metallurgic Infuser, the same as 8 redstone."
	]
	quest.00000000000001A2.quest_subtitle: "Create Enriched Redstone"
	quest.00000000000001A4.quest_desc: [
		"Enriched Diamond is used in the Metallurgic Infuser."
		" "
		"Enriched Diamond yields 80 units of diamond in the Metallurgic Infuser, the same as 8 diamonds."
	]
	quest.00000000000001A4.quest_subtitle: "Create Enriched Diamond"
	quest.00000000000001A6.quest_desc: [
		"Enriched Obsidian is used in the Metallurgic Infuser."
		" "
		"Enriched Obsidian yields 80 units of obsidian in the Metallurgic Infuser, the same as 8 Refined Obsidian Dust."
	]
	quest.00000000000001A6.quest_subtitle: "Create Enriched Obsidian"
	quest.00000000000001A8.quest_desc: [
		"Enriched Tin is used in the Metallurgic Infuser."
		" "
		"Enriched Tin yields 80 units of tin in the Metallurgic Infuser, the same as 8 Tin Dust."
	]
	quest.00000000000001A8.quest_subtitle: "Create Enriched Tin"
	quest.00000000000001AA.quest_desc: ["The Basic Fluid Tank can hold up to 14000mB of fluids. It can double as a bucket by switching its mode to bucket mode."]
	quest.00000000000001AA.quest_subtitle: "Craft a Basic Fluid Tank"
	quest.00000000000001AC.quest_desc: ["The Advanced Fluid Tank can hold up to 28000mB of fluids which is double the amount of the Basic Fluid Tank. It can double as a bucket by switching its mode to bucket mode."]
	quest.00000000000001AC.quest_subtitle: "Craft an Advanced Fluid Tank"
	quest.00000000000001AE.quest_desc: [
		"The Elite Fluid Tank is an upgraded version of the Advanced Fluid Tank that can hold 56000 mB of liquid. You can toggle its Bucket Mode on and off by shift-right clicking while holding it."
		" "
		"When Bucket Mode is on it can collect water and lava like a bucket. When Bucket Mode is off it can be placed like a block so you can attach Mechanical Pipe to it."
	]
	quest.00000000000001AE.quest_subtitle: "Craft an Elite Fluid Tank"
	quest.00000000000001B0.quest_desc: [
		"The Ultimate Fluid Tank is an upgraded version of the Elite Fluid Tank that can hold 112000 mB of liquid. You can toggle its Bucket Mode on and off by shift-right clicking while holding it."
		" "
		"When Bucket Mode is on it can collect water and lava like a bucket. When Bucket Mode is off it can be placed like a block so you can attach Mechanical Pipe to it."
	]
	quest.00000000000001B0.quest_subtitle: "Craft an Ultimate Fluid Tank"
	quest.00000000000001B2.quest_desc: ["An Energy Cube is an advanced type of battery that is compatible with multiple energy systems."]
	quest.00000000000001B2.quest_subtitle: "Craft a Basic Energy Cube"
	quest.00000000000001B4.quest_desc: [
		"An Energy Cube is an advanced type of battery that is compatible with multiple energy systems."
		" "
		"&oAn upgraded version of the Basic Energy Cube."
	]
	quest.00000000000001B4.quest_subtitle: "Craft an Advanced Energy Cube"
	quest.00000000000001B6.quest_desc: [
		"An Energy Cube is an advanced type of battery that is compatible with multiple energy systems."
		" "
		"&oAn upgraded version of the Advanced Energy Cube."
	]
	quest.00000000000001B6.quest_subtitle: "Craft an Elite Energy Cube"
	quest.00000000000001B8.quest_desc: [
		"An Energy Cube is an advanced type of battery that is compatible with multiple energy systems."
		" "
		"&oAn upgraded version of the Elite Energy Cube."
	]
	quest.00000000000001B8.quest_subtitle: "Craft an Ultimate Energy Cube"
	quest.00000000000001BA.quest_desc: ["The Solar Generator harnesses sunlight to create power."]
	quest.00000000000001BA.quest_subtitle: "Craft a Solar Generator"
	quest.00000000000001BC.quest_desc: [
		"The Advanced Solar Generator is a highly upgraded version of the basic Solar Generator."
		" "
		"Construction of an Advanced Solar Generator requires four Solar Generators, but it produces six times the power of its smaller cousin."
		" "
		"It also requires an area of 3x3x3 Blocks in order to be placed."
	]
	quest.00000000000001BC.quest_subtitle: "Craft an Advanced Solar Generator."
	quest.00000000000001BE.quest_desc: [
		"A Wind Turbine's giant blades harness the force of the wind to generate power. Each Wind Turbine requires a fairly large 1x1x5 area."
		" "
		"The machine will generate power day and night, in sun or rain, but the turbine must have a clear view of the sky (over the rotor housing at the top of the tower)."
	]
	quest.00000000000001BE.quest_subtitle: "Craft a Wind Generator"
	quest.00000000000001C0.quest_desc: ["The Flamethrower is a ranged weapon which uses Hydrogen gas as its fuel. It is fairly effective against mobs as it deals damage when they are directly hit with the stream and sets them on fire."]
	quest.00000000000001C0.quest_subtitle: "Craft a Flamethrower"
	quest.00000000000001C2.quest_desc: ["The Atomic Disassembler is Mekanism's an all-in-one tool, essentially the ultimate, electronic version of the paxel."]
	quest.00000000000001C2.quest_subtitle: "Craft an Atomic Disassembler"
	quest.00000000000001C4.quest_desc: [
		"The Electric Bow works like the vanilla Bow and shoots normal Arrows."
		" "
		"The difference is, that every shot doesn't damage, but discharges the bow. If the internal energy storage is empty, the bow doesn't work and needs to be recharged e.g. on a Basic Energy Cube."
	]
	quest.00000000000001C4.quest_subtitle: "Craft an Electric Bow"
	quest.00000000000001C6.quest_desc: [
		"Free Runners are an item that allows players to ascend 1-block inclines automatically (like the Horse), as well as preventing fall damage as long as they are charged."
		""
		"A fall will reduce the item's charge, depending on how far the fall was."
	]
	quest.00000000000001C6.quest_subtitle: "Craft a pair of Free Runners"
	quest.00000000000001C8.quest_desc: [
		"The Energy Tablet is a portable, rechargeable battery pack that can be charged with up to 1,000kJ of energy and can then be used to power other devices."
		" "
		"It is also an ingredient in many recipes."
	]
	quest.00000000000001C8.quest_subtitle: "Craft an Energy Tablet"
	quest.00000000000001CE.quest_desc: ["The Basic Bin is a storage block which can hold 4096 of a single item. It will retain its inventory when broken."]
	quest.00000000000001CE.quest_subtitle: "Craft a Basic Bin"
	quest.00000000000001D0.quest_desc: ["The Advanced Bin is a storage block which can hold 8192 of a single item. It will retain its inventory when broken."]
	quest.00000000000001D0.quest_subtitle: "Craft an Advanced Bin"
	quest.00000000000001D2.quest_desc: ["The Elite Bin is a storage block which can hold 32,768 of a single item. It will retain its inventory when broken."]
	quest.00000000000001D2.quest_subtitle: "Craft an Elite Bin"
	quest.00000000000001D4.quest_desc: ["The Ultimate Bin is a storage block which can hold 262,144 of a single item. It will retain its inventory when broken."]
	quest.00000000000001D4.quest_subtitle: "Craft an Ultimate Bin"
	quest.00000000000001D6.quest_desc: ["Chemical Tanks are Mekanisms batteries for storing Gases. They can be placed as a block and do interact with Pressurized Tubes. They come in the four levels, each increasing the storage capacity and output rate."]
	quest.00000000000001D6.quest_subtitle: "Craft a Basic Chemical Tank"
	quest.00000000000001D8.quest_desc: ["Chemical Tanks are Mekanisms batteries for storing Gases. They can be placed as a block and do interact with Pressurized Tubes. They come in the four levels, each increasing the storage capacity and output rate."]
	quest.00000000000001D8.quest_subtitle: "Craft an Advanced Chemical Tank"
	quest.00000000000001DA.quest_desc: ["Chemical Tanks are Mekanisms batteries for storing Gases. They can be placed as a block and do interact with Pressurized Tubes. They come in the four levels, each increasing the storage capacity and output rate."]
	quest.00000000000001DA.quest_subtitle: "Craft an Elite Chemical Tank"
	quest.00000000000001DC.quest_desc: ["Chemical Tanks are Mekanisms batteries for storing Gases. They can be placed as a block and do interact with Pressurized Tubes. They come in the four levels, each increasing the storage capacity and output rate."]
	quest.00000000000001DC.quest_subtitle: "Craft an Ultimate Chemical Tank"
