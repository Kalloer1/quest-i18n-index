	quest.00000000000001E6.quest_subtitle: "Craft x8 Ultimate Universal Cables"
	quest.00000000000001E6.title: "Ultimate Universal Cable"
	quest.00000000000001E8.quest_desc: ["A Mekanism machine upgrade to make them process items faster each Mekanism machine can store 8 of these upgrades."]
	quest.00000000000001E8.quest_subtitle: "Craft a Speed Upgrade"
	quest.00000000000001EA.quest_desc: ["The energy upgrade upgrade allows you to increase the power storage capacity of a Mekanism machine which has an upgrade slot, as well as reduce its power consumption."]
	quest.00000000000001EA.quest_subtitle: "Craft an Energy Upgrade"
	quest.00000000000001EE.quest_desc: ["A Mekanism machine upgrade to make them process a bit quiet . Install full 4 upgrades to completely muff the machines noises."]
	quest.00000000000001EE.quest_subtitle: "Craft a Muffling Upgrade"
	quest.00000000000001F0.quest_desc: ["The gas upgrade allows you to increase the gas usage efficiency of a Mekanism machine which allows it."]
	quest.00000000000001F0.quest_subtitle: "Craft a Gas Upgrade"
	quest.00000000000001F2.quest_desc: ["The Anchor Upgrade is a machine upgrade which keeps the chunk of the machine to which it is applied loaded. This is helpful for machines like the Digital Miner and Teleporter Portal which must be in loaded chunks to function properly."]
	quest.00000000000001F2.quest_subtitle: "Craft an Anchor Upgrade"
	quest.00000000000001F6.quest_desc: ["Factories are advanced forms of the basic machines aimed to assist in large scale resource processing"]
	quest.00000000000001F6.quest_subtitle: "Craft a Basic Smelting Factory"
