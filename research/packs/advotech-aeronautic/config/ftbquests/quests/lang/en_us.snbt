		"&7It is heavy, slow, and doesn't hold much power."
		""
		"&aThe &8Wood Jetpack&a is your very first step"
		"&ainto aerial exploration. Use it to cross small"
		"&agaps or reach high ledges."
	]
	quest.6E5F000000000020.quest_subtitle: "&7Barely gets you off the ground."
	quest.6E5F000000000020.title: "&8&lWooden Wings"
	quest.6E5F000000000025.quest_desc: [
		"&7Slightly better than strapping logs to your back."
		""
		"&aThe &7Stone Jetpack&a gives you a bit more"
		"&aflight time and slightly better vertical speed."
	]
	quest.6E5F000000000025.quest_subtitle: "&7A little more robust."
	quest.6E5F000000000025.title: "&7&lStone Ascendant"
	quest.6E5F000000000030.quest_desc: [
		"&7Better than stone, but still quite primitive."
		""
		"&aThe &cCopper Jetpack&a offers a noticeable increase"
		"&ain energy capacity and flight speed."
	]
	quest.6E5F000000000030.quest_subtitle: "&7A slight improvement."
	quest.6E5F000000000030.title: "&c&lCopper Copter"
	quest.6E5F000000000040.quest_desc: [
		"&7Now we are getting somewhere."
		""
		"&aThe &fIron Jetpack&a provides a solid balance"
		"&aof speed and energy capacity for early-to-mid"
		"&agame exploration."
	]
	quest.6E5F000000000040.quest_subtitle: "&7The namesake of the mod."
	quest.6E5F000000000040.title: "&f&lHeavy Metal"
	quest.6E5F000000000050.quest_desc: [
		"&7Gold is light and highly conductive."
		""
		"&aThe &eGold Jetpack&a is noticeably faster,"
		"&abut make sure you have a good way to"
		"&arecharge it quickly."
	]
	quest.6E5F000000000050.quest_subtitle: "&7Fast, but thirsty for power."
	quest.6E5F000000000050.title: "&e&lGolden Glide"
	quest.6E5F000000000060.quest_desc: [
