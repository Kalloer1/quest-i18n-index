	quest.7F6CEE6D1F144FD7.quest_desc: [
		"Lore: A hardened blend of Iron and Carbon. It is the backbone of advanced industrial machinery."
		""
		"Technical Information: Made in two steps: Infuse Iron with Carbon to make Enriched Iron, then infuse Enriched Iron with more Carbon to make Steel Dust."
		""
		"Usage: Smelt the resulting Steel Dust in any furnace to create Steel Ingots."
		""
		"Goal: Produce 16 Steel Ingots."
		""
		"Tips: Coal and Charcoal both act as Carbon sources. Crush them to stretch your resources further."
		""
		"Trivia: While other mods add Blast Furnaces, Mekanism's dual-infusion method is uniquely distinct."
	]
	quest.7F6CEE6D1F144FD7.quest_subtitle: "&8Steel Production"
	quest.7F6CEE6D1F144FD7.title: "Steel Production"
