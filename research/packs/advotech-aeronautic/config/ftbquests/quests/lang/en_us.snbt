	quest.34F29CBC9E8D98FB.title: "&d&lUnobtainium Spell Book&r"
	quest.34FDD3E2FFB370D1.quest_desc: [
		"Lore: A robust, durable housing designed to safely contain extreme electrical and chemical reactions."
		""
		"Technical Information: Crafted using Steel Ingots, Osmium, and Glass."
		""
		"Usage: The structural prerequisite for nearly all mid-to-high tier machines."
		""
		"Goal: Craft a Steel Casing."
		""
		"Tips: Keep a stack of these ready in your AE2/RS system. You'll use them constantly."
		""
		"Trivia: Introduced as a balancing step to require Steel before hitting advanced factory tiers."
	]
	quest.34FDD3E2FFB370D1.quest_subtitle: "&8Sturdy Framework"
	quest.34FDD3E2FFB370D1.title: "Steel Casing"
	quest.3513A577D6F64CF8.quest_desc: [
		"&bDiamond dust&r plus &cEnriched Alloy&r."
		""
		"Because your machines demanded &eexpensive jewelry&r to function properly."
	]
	quest.3513A577D6F64CF8.quest_subtitle: "Expensive iron"
	quest.3513A577D6F64CF8.title: "&b&lReinforced Alloy&r"
	quest.351A6878C554495C.quest_desc: [
		"Though unsuited for Spirit Infusion, the ancient design of the Runewood Obelisk found new purpose when reborn through Brilliance. By socketing this crystalline knowledge in place of Hallowed Gold, the structure no longer feeds the Altar’s hunger, it resonates with the higher harmonies of enchantment."
		""
		"In this state, each &dBrilliant Obelisk&r channels the stored intellect of ages past, granting the strength of five tomes to any Enchanting Table nearby. Their radiance hums softly, a chorus of remembered study and forgotten light."
		""
		"To build one is to shape the sound of learning itself. A monument not to speed, but to wisdom."
	]
	quest.351A6878C554495C.quest_subtitle: "Not all power is drawn from flame. Some hum quietly in thought."
	quest.351A6878C554495C.title: "&dBrilliant Obelisk&r"
	quest.35235CD7FB2D4505.title: "Advanced Mechanics"
	quest.352DDCDFEB0A8F47.quest_desc: [
		"The &6HV Diesel Generator&r provides massive power from diesel."
		""
		"Keep your oil refineries running!"
	]
	quest.352DDCDFEB0A8F47.quest_subtitle: "Massive diesel power"
	quest.352DDCDFEB0A8F47.title: "&6HV Power Generation"
	quest.35444DD89905F2F6.quest_desc: ["&7Seven slots. Breathing near this machine is strictly not advised."]
	quest.35444DD89905F2F6.quest_subtitle: "&4Toxic air"
	quest.35444DD89905F2F6.title: "&4Elite Oxidizing Factory"
