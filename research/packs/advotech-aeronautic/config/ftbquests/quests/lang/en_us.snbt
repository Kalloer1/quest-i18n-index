	quest.48846E2C097599C8.title: "&6Ready to Begin"
	quest.48861C3D4EB84A1B.quest_desc: ["serves as a casing to the biggest and most spacious energy storage on the modpack. not even the draconic battery can hope to match it when its completed"]
	quest.48861C3D4EB84A1B.quest_subtitle: "Battery is found in me!"
	quest.48861C3D4EB84A1B.title: "CANNOT STOP THE BATTERY!"
	quest.488844218FAE7532.quest_desc: [
		"&7Infuse a Diamond in the Orb."
		""
		"&aThe &bNiotic Crystal&a unlocks the &lNiotic&r&a tier."
		"&aPower generation reaches incredible levels at"
		"&athis stage."
	]
	quest.488844218FAE7532.quest_subtitle: "&7Crystalline perfection."
	quest.488844218FAE7532.title: "&b&lDiamond Infusion (Niotic)"
	quest.48889BC5A2C73151.quest_desc: ["&ePneumatic Elevators&r! Use Elevator Frames connected to an Elevator Base. Provide it with air pressure to travel swiftly between floors."]
	quest.4888CC546D2849AE.quest_desc: ["The brain of the reactor. Use this to turn it on, turn it off, and stare nervously at the &ctemperature gauge&r."]
	quest.4888CC546D2849AE.quest_subtitle: "The big red button"
	quest.4888CC546D2849AE.title: "&6&lReactor Controller&r"
	quest.4897ABD4113D5C23.quest_desc: ["&cThermopneumatic Processing Plant&r combines fluids and items."]
	quest.4897ABD4113D5C23.quest_subtitle: "&7PneumaticCraft"
	quest.4897ABD4113D5C23.title: "&bThermopneumatic Processing Plant"
	quest.48A3980DB49446CB.quest_desc: ["&6Blazing Cell&r. It stores more power and looks mildly threatening. A solid upgrade."]
	quest.48A3980DB49446CB.title: "&6&lBlazing Energy Cell&r"
	quest.48B674B26E3EDF7E.quest_desc: [
		"Lore: Injects corrosive hydrogen chloride gas into ores, dissolving away the most stubborn rock."
		""
		"Technical Information: The gateway to 4x Ore Processing. Turns 1 Raw Ore into 4 Shards."
		""
		"Usage: Requires Hydrogen Chloride gas, which is synthesized from Brine and Hydrogen."
		""
		"Goal: Craft a Chemical Injection Chamber."
		""
		"Tips: This chain requires a Thermal Evaporation Plant to produce Brine. Plan your base layout accordingly!"
		""
		"Trivia: The shards produced here must then go backwards through the Purification Chamber to become clumps."
	]
	quest.48B674B26E3EDF7E.quest_subtitle: "&eChemical Injection"
	quest.48B674B26E3EDF7E.title: "Chemical Injection Chamber"
	quest.48C0F3417834ED5B.quest_desc: [
		"&aUpgrade to a &3Blazing Player Transmitter&a"
		"&afor a much higher wireless charging rate."
		"&7Your tools and armor will stay topped up effortlessly."
	]
	quest.48C0F3417834ED5B.quest_subtitle: "&7Faster wireless charging."
	quest.48C0F3417834ED5B.title: "&3&lPlayer Transmitter — Blazing"
	quest.48CC3F69329E815E.quest_desc: [
		"The &bMV Diesel Generator&r burns diesel fuel to produce medium voltage power."
		""
		"Much more efficient than steam turbines at this stage!"
	]
	quest.48CC3F69329E815E.quest_subtitle: "Diesel power"
	quest.48CC3F69329E815E.title: "&bMV Power Generation"
	quest.48DE1294AB558F2C.quest_subtitle: "Harness the heat of the earth. Generates energy by consuming Lava."
	quest.48E947C637A9B570.quest_desc: [
		"Lore: Reverses the entropy of ore processing. It forcibly compresses dusts and cobble back into solid ore blocks."
		""
		"Technical Information: Consumes Dusts + Cobblestone to generate Ore Blocks."
		""
		"Usage: Useful for Fortune mining silk-touched ores, or consolidating storage."
		""
		"Goal: Craft a Combiner."
		""
		"Tips: Rarely used for main progression, but an incredible utility block for specific mod-pack quests."
		""
		"Trivia: The Combiner acts as the mechanical opposite of the Enrichment Chamber."
	]
	quest.48E947C637A9B570.quest_subtitle: "&7Recombining"
	quest.48E947C637A9B570.title: "Combiner"
	quest.48F16E725F953D50.quest_desc: [
		"Welcome to &2Create: Nuclear&r."
		""
		"Because clearly, adding complicated gears to a steam engine wasn't enough. Now you want to split atoms and risk &airradiating your entire base&r. What could possibly go wrong?"
	]
	quest.48F16E725F953D50.quest_subtitle: "I am become death"
	quest.48F16E725F953D50.title: "&2&lOppenheimer's Dream&r"
	quest.48F49A070EE7A068.title: "First Steps"
	quest.490975CC5D1B08A1.quest_desc: [
		"&7A building block of your &dMystical Agradditions&7 setup — you'll want more than one.&r"
		""
		"&8The &dAgradditions&7 tier — Insanium and beyond, for the truly endgame farmer.&r"
	]
	quest.490975CC5D1B08A1.quest_subtitle: "Another piece"
	quest.490975CC5D1B08A1.title: "Imperium Apple"
	quest.490B79D0B1961879.quest_desc: ["Now your machines can process &c5 items&r at once and consume power faster than you can &egenerate&r it."]
	quest.490B79D0B1961879.quest_subtitle: "Slap harder"
	quest.490B79D0B1961879.title: "&c&lAdvanced Tier Installer&r"
	quest.491412E1D1D69F79.quest_subtitle: "Wireless power tap"
