	quest.6D6691DB2BB8DD7E.title: "Prudentium Gemstone"
	quest.6D74F5FE366536BD.quest_desc: [
		"The &aSeismic Survey Tool&r."
		""
		"Shoot blanks into the earth to scan for massive reservoirs of &8Crude Oil&r. Because casually shooting explosives into the dirt to find resources is peak engineering."
	]
	quest.6D74F5FE366536BD.quest_subtitle: "Wait, I heard something..."
	quest.6D74F5FE366536BD.title: "&6&lSeismic Survey&r"
	quest.6D87F02C44B4E103.quest_desc: [
