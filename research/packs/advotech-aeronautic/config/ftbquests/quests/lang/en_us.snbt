	quest.3B2A000000003001.quest_desc: ["The basic tier of fluid storage. Combine it with a Storage Housing to create a functional disk."]
	quest.3B2A000000003010.quest_desc: ["Massive fluid storage capability. More buckets than you'll ever need."]
	quest.3B2A000000004001.quest_desc: ["Allows you to store raw Forge Energy (FE) digitally in your network."]
	quest.3B2A000000004010.quest_desc: ["The ultimate energy storage solution! This disk can hold an infinite amount of Forge Energy."]
	quest.3B2A000000005001.quest_desc: ["Allows your Refined Storage network to store Mekanism Chemicals directly."]
	quest.3B2A000000006001.quest_desc: ["Allows your Refined Storage network to store Source (from Ars Nouveau)."]
	quest.3B33F047BCC58BEF.quest_desc: [
		"A cage for a Blaze."
		""
		"Go find a Nether Fortress, right-click a Blaze, and shove it in a box. Dont worry, the blaze loves free food with no effort!"
	]
	quest.3B33F047BCC58BEF.quest_subtitle: "Shrodinger's burner"
	quest.3B33F047BCC58BEF.title: "&8&lEmpty Blaze Burner&r"
	quest.3B4DAAFDC1B4B6C6.quest_desc: [
		"A natural continuation of the previous step."
		""
		"Craft or obtain the &bEnder Gate Hardened&r."
		"Another piece of the machine chain. On its own it does little; wired into the rest of your factory it removes one more job you were doing by hand."
		"Part of the &7Powah&r progression."
		"&8Next: Ender Gate Blazing."
	]
	quest.3B4DAAFDC1B4B6C6.quest_subtitle: "&7Powah"
	quest.3B4DAAFDC1B4B6C6.title: "&bEnder Gate Hardened"
	quest.3B4FBBFCAA2EB992.quest_desc: [
		"Endermen are annoying. They teleport out of your carefully designed traps."
		""
		"Hide this little block under the floor, and their teleportation privileges are instantly revoked. Welcome to the blender, tall guy."
	]
	quest.3B4FBBFCAA2EB992.quest_subtitle: "No escaping"
	quest.3B4FBBFCAA2EB992.title: "&5&lEnder Inhibitor&r"
	quest.3B699771827002DC.quest_desc: ["Throws items. Literally just pressing &eQ&r, but it costs mana."]
	quest.3B699771827002DC.quest_subtitle: "YEET"
	quest.3B699771827002DC.title: "&c&lGlyph of Toss&r"
	quest.3B6D17DF6D0364D9.quest_desc: ["Throw this at your problems and hope they magically disappear."]
	quest.3B6D17DF6D0364D9.quest_subtitle: "Portable, explosive energy."
	quest.3B6D17DF6D0364D9.title: "&c&lLithium Charge&r"
	quest.3B99ABCCF42B31D9.quest_desc: ["Makes the spell last longer. Now you're trapped in a magical bubble for &e10 minutes&r."]
	quest.3B99ABCCF42B31D9.quest_subtitle: "Overtime"
	quest.3B99ABCCF42B31D9.title: "&a&lGlyph of Extend Time&r"
	quest.3B9BFAE88E280B9F.quest_desc: [
		"A natural continuation of the previous step."
		""
		"Craft or obtain the &7Basic Chemical Tank&r."
		"Bulk fluid storage. Buffering fluids is what stops a processing line from stuttering every time upstream production dips."
		"Part of the &7Mekanism&r progression."
		"&8Next: Isotopic Centrifuge."
	]
	quest.3B9BFAE88E280B9F.quest_subtitle: "spicy crunch"
	quest.3B9BFAE88E280B9F.title: "&7Basic Chemical Tank"
	quest.3B9C369BDF145675.quest_desc: [
		"&7Cables, coils, and motors are key crafting components."
		""
		"&7Before you build powerful factories, you must master the production of these basic electronic parts."
	]
	quest.3B9C369BDF145675.title: "&eBasic Components"
	quest.3BE9CB4721F35976.quest_desc: [
		"&6The high point of this chapter.&r"
		""
		"Craft or obtain the &6Module Solar Recharging Unit&r."
		"It draws power from daylight. No fuel logistics, no upkeep, just floor space and a clear view of the sky."
		"Part of the &7Mekanism Generators&r progression."
		"&8Take it or leave it - the chapter continues elsewhere."
	]
	quest.3BE9CB4721F35976.quest_subtitle: "&7Mekanism Generators"
	quest.3BE9CB4721F35976.title: "&6Module Solar Recharging Unit"
	quest.3BF312BE37759858.quest_desc: [
		"A natural continuation of the previous step."
		""
		"Bring down the &cSlay the Draconic Guardian&r. This is not something you can craft your way past - bring the best gear you have, and expect to lose a set learning the fight."
		"&8Next: Chaos Shard."
	]
	quest.3BF312BE37759858.quest_subtitle: "&cA fight, not a recipe"
	quest.3BF312BE37759858.title: "&cSlay the Draconic Guardian"
	quest.3BFD480E65B4C945.quest_desc: [
		"The chapter widens out from here."
		""
		"Craft or obtain the &7Ender Gate Starter&r."
		"Another piece of the machine chain. On its own it does little; wired into the rest of your factory it removes one more job you were doing by hand."
		"Part of the &7Powah&r progression."
		"&8Next: Ender Gate Basic, Energizing Rod Starter."
	]
	quest.3BFD480E65B4C945.quest_subtitle: "&7Powah"
	quest.3BFD480E65B4C945.title: "&7Ender Gate Starter"
	quest.3C08195B48DDCCDD.quest_desc: [
		"Worth doing properly the first time - reworking this later is tedious."
		""
		"Craft or obtain the &5Magic Lamp Empty&r."
		"Slow, ritualistic magic. The pacing is deliberate and the payoffs are worth waiting for."
		"Part of the &7Occultism&r progression."
		"&8The end of this branch."
	]
	quest.3C08195B48DDCCDD.quest_subtitle: "&7Occultism"
	quest.3C08195B48DDCCDD.title: "&5Magic Lamp Empty"
	quest.3C09F20961E63A27.quest_desc: [
		"&7Combine chemical gases at an &eunmatched rate&7."
		""
		"&7This massive &6Infuser&7 is essential for high-end fuel production and advanced ore processing. Just make sure you have the piping to keep up!"
	]
	quest.3C09F20961E63A27.quest_subtitle: "Bulk Infusion"
	quest.3C09F20961E63A27.title: "&6Large Chemical Infuser"
	quest.3C30B015A7ADEB3C.quest_desc: ["Only hits things in the air. Take that, &ePhantoms&r."]
	quest.3C30B015A7ADEB3C.quest_subtitle: "Anti-air defense"
	quest.3C30B015A7ADEB3C.title: "&f&lGlyph of Aerial Filter&r"
	quest.3C32F5DA6513BBC9.quest_desc: [
		"Lore: The crudest form of power generation, converting thermal energy directly into usable voltage."
		""
		"Technical Information: Can burn solid fuels (Coal, Wood) or run passively when surrounded by Lava."
		""
		"Usage: Your absolute first source of power to jumpstart the Metallurgic Infuser."
		""
		"Goal: Craft a Heat Generator."
		""
		"Tips: Pouring lava blocks adjacent to it provides free, infinite, albeit slow, passive energy."
		""
		"Trivia: It relies on the Seebeck effect (thermoelectric conversion)."
	]
	quest.3C32F5DA6513BBC9.quest_subtitle: "&cThermal Power"
	quest.3C32F5DA6513BBC9.title: "Heat Generator"
	quest.3C36B38B3F31E5E6.quest_desc: ["Upgrades gear with magic. Because hitting a delicate magical scroll with a &cmassive iron hammer&r makes perfect sense."]
	quest.3C36B38B3F31E5E6.quest_subtitle: "Hammer time"
	quest.3C36B38B3F31E5E6.title: "&8&lArcane Anvil&r"
	quest.3C400389F4FC4FEB.quest_desc: [
		"Welcome to Medium Voltage (MV)!"
		""
		"You need &bAluminum&r to progress. Build an &cElectric Blast Furnace&r multiblock to smelt Aluminum Dust into ingots."
	]
	quest.3C400389F4FC4FEB.quest_subtitle: "Lightweight and conductive"
	quest.3C400389F4FC4FEB.title: "&bThe Aluminum Age"
	quest.3C53789365D138ED.quest_desc: [
		"The &eholy grail&r of Mekanism power generation."
		""
		"Feed this into a &aGas-Burning Generator&r and watch all your energy issues &bvanish&r."
	]
	quest.3C53789365D138ED.quest_subtitle: "The ultimate fuel"
	quest.3C53789365D138ED.title: "&a&lEthylene&r"
	quest.3C5B608DB4CC3738.quest_desc: [
		"Boilers consume a massive amount of water."
		""
		"Craft a &8Bronze Water Pump&r and place it next to an infinite water source. Connect it to your Boiler using fluid pipes so you never have to use buckets again!"
	]
	quest.3C5B608DB4CC3738.quest_subtitle: "Infinite hydration"
	quest.3C5B608DB4CC3738.title: "&8Automated Pumping"
	quest.3C5E36B1A0F83997.quest_desc: [
		"Worth doing properly the first time - reworking this later is tedious."
		""
		"Craft or obtain the &bPlayer Transmitter Niotic&r."
		"It moves resources between machines. Throughput is the whole point - undersized transfer is the most common reason a factory looks busy but produces nothing."
		"Part of the &7Powah&r progression."
		"&8Next: Player Transmitter Spirited."
	]
	quest.3C5E36B1A0F83997.quest_subtitle: "&7Powah"
	quest.3C5E36B1A0F83997.title: "&bPlayer Transmitter Niotic"
	quest.3C682B4290ACD07D.quest_desc: ["flourite is used for *checks notes* nothing else than fissle fuel...... wow that was something"]
	quest.3C682B4290ACD07D.quest_subtitle: "dont wash your teeth with this one"
	quest.3C682B4290ACD07D.title: "Bone white, and shiny!"
	quest.3C72EA46B4B54616.quest_desc: [
		"&7The final upgrade."
		""
		"&aThe &dAdvanced Wireless Terminal&a completely"
		"&aignores the range limits of the basic version."
		"&aAs long as the chunks containing your storage"
		"&aare loaded, you can access your items from"
		"&aanywhere in the world, or even other dimensions!"
	]
	quest.3C72EA46B4B54616.quest_subtitle: "&d&lCross-dimensional logistics."
	quest.3C72EA46B4B54616.title: "&d&lInfinite Reach"
	quest.3C919E851430B576.quest_desc: [
		"The chapter widens out from here."
		""
		"Craft or obtain the &bReactor Niotic&r."
		"It is a multiblock reactor - enormous output, and an equally enormous mess if you run it badly. Read the safety limits before you fill it."
		"Part of the &7Powah&r progression."
		"&8Next: Reactor Spirited."
	]
	quest.3C919E851430B576.quest_subtitle: "&7Powah"
	quest.3C919E851430B576.title: "&bReactor Niotic"
	quest.3C9634B4D05B109A.quest_desc: [
		"Steal items from chests far, far away."
		""
		"Perfect for 'borrowing' from your base mates without ever leaving your chair."
	]
	quest.3C9634B4D05B109A.quest_subtitle: "Long distance yoink"
	quest.3C9634B4D05B109A.title: "&9&lPuller Module Mk2&r"
