	]
	quest.49255CE73D701213.quest_subtitle: "&7Silent Gear"
	quest.49255CE73D701213.title: "&bRough Rod"
	quest.492B5DE78234C1CD.quest_desc: [
		"Worth doing properly the first time - reworking this later is tedious."
		""
		"Craft or obtain the &bEnergy Cable Niotic&r."
		"It moves resources between machines. Throughput is the whole point - undersized transfer is the most common reason a factory looks busy but produces nothing."
		"Part of the &7Powah&r progression."
		"&8Next: Energy Cable Spirited."
	]
	quest.492B5DE78234C1CD.quest_subtitle: "&7Powah"
	quest.492B5DE78234C1CD.title: "&bEnergy Cable Niotic"
	quest.49732F097030B62B.quest_desc: ["&cquickly generates&7 (more like spawns) mobs using &eenergy&7 and &dliquid meat&7. methods of transport are suggested to supply both of them to &6mechanical dirts&7 to maximize output. Mobs spawned depend on &elight&7 and current &abiome&7 (and dimension). keep in mind that if mechanical dirt isnt supplied with: &eenergy, meat, darkness&7 (or all of the above) it will &cnot spawn mobs.&7"]
	quest.49732F097030B62B.quest_subtitle: "here they come"
	quest.49732F097030B62B.title: "&cyou have alerted the horde"
	quest.497529DBBD7634E8.quest_desc: [
		"&6A milestone.&r"
		""
		"Craft or obtain the &6Module Geiger Unit&r."
		"An upgrade module. Slotting these in is how you turn a functional machine into a fast one without rebuilding your entire setup."
		"Part of the &7Mekanism&r progression."
		"&8A side branch. Optional, but rarely a waste of time."
	]
