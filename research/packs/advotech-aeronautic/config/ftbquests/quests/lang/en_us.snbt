	quest.41631F055A58FC78.quest_desc: [
		"Lore: A dense, bluish-white metal that forms the structural foundation of almost every Mekanism machine."
		""
		"Technical Information: Spawns relatively frequently in the overworld. Requires an Iron Pickaxe tier or better to mine."
		""
		"Usage: Smelted into ingots and used as the primary crafting material for machine casings and tools."
		""
		"Goal: Mine and process 32 Osmium Ingots."
		""
		"Tips: Don't process all your raw Osmium immediately if you plan to build an Enrichment Chamber soon, as you can double it."
		""
		"Trivia: Real-world osmium is the densest naturally occurring element, often used in electrical contacts."
	]
	quest.41631F055A58FC78.quest_subtitle: "&bThe Essential Metal"
	quest.41631F055A58FC78.title: "The Foundation: Osmium"
