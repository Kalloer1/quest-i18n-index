	quest.01F83A89007E40E6.quest_subtitle: "Aimbot"
	quest.01F83A89007E40E6.title: "&a&lGlyph of Homing Projectile&r"
	quest.021943F7E1C027DF.quest_desc: [
		"&7An advanced smelting and alloying furnace."
