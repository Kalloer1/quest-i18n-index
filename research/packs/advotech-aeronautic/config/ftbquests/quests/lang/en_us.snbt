	quest.5486D1F3633D887E.quest_desc: [
		"Lore: Total molecular annihilation. Submerges raw ores in Sulfuric Acid, melting them entirely into a gaseous slurry."
		""
		"Technical Information: The start of 5x Ore Processing. Turns 1 Raw Ore into 1000mB of Dirty Slurry."
		""
		"Usage: Requires a massive industrial setup to produce the Sulfuric Acid necessary to run this."
		""
		"Goal: Craft a Chemical Dissolution Chamber."
		""
		"Tips: Do not attempt 5x processing until you have immense power generation and a flawless gas network."
		""
		"Trivia: This represents the pinnacle of real-world chemical extraction techniques."
	]
	quest.5486D1F3633D887E.quest_subtitle: "&eDissolving Ores"
	quest.5486D1F3633D887E.title: "Chemical Dissolution Chamber"
