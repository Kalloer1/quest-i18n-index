	]
	quest.3CF3D5A0FE2C6426.quest_subtitle: "Plant. Harvest. Repeat."
	quest.3CF3D5A0FE2C6426.title: "Skeleton Seeds"
	quest.3CF80B2D2D5E089B.quest_desc: [
		"&dFood is fuel!&r"
		""
		"&7Why eat that steak when you can power a factory with it? The more filling and complex the food, the more &eFE&7 this machine generates."
	]
	quest.3CF80B2D2D5E089B.quest_subtitle: "Food into energy"
	quest.3CF897D4CE72EB94.quest_desc: ["&aPlant gatherer&7 (accompanied by plant sower) allows for an automatic generation of many plant-based resources such as crops and trees. &cIT IS ADVISED TO NOT USE ANY TRES THAT GENERATE WOOD BELOW THE GROUND IN AUTOMATED PROCESSES. YOU'RE RISKING DESTROYING CABLES, TRANSPORTERS AND SOWER BELOW THE TREES&7"]
	quest.3CF897D4CE72EB94.quest_subtitle: "we reap......"
	quest.3CF897D4CE72EB94.title: "&2Somethin keeps cutting down my trees..."
	quest.3D1C0F80B74B27D5.quest_desc: [
		"First things first."
		""
		"Earn the &6Find Lighthouse&r advancement. It marks a genuine change in what you are able to do, not just another item in a chest."
		"&8Take it or leave it - the chapter continues elsewhere."
	]
	quest.3D1C0F80B74B27D5.quest_subtitle: "&7The foundation"
	quest.3D1C0F80B74B27D5.title: "&6Find Lighthouse"
	quest.3D201FDE7748D66A.quest_desc: ["using heat from resistive heater or solar panels (which only heat up during the day) turns water into brine, and then brine into lithium"]
	quest.3D201FDE7748D66A.quest_subtitle: "brine production"
	quest.3D201FDE7748D66A.title: "(not) salt tower"
	quest.3D2BF292FE4D15C4.quest_desc: [
		"You have the prerequisites. Now put them to use."
		""
		"Craft or obtain the &7Battery Starter&r."
		"It buffers energy so that machines drawing in bursts do not stall the rest of your network."
		"Part of the &7Powah&r progression."
		"&8Next: Battery Basic, Player Transmitter Starter."
	]
	quest.3D2BF292FE4D15C4.quest_subtitle: "&7Powah"
	quest.3D2BF292FE4D15C4.title: "&7Battery Starter"
	quest.3D2E3B31FE13AE46.quest_desc: [
		"&7Infuse Nether Stars and Blocks of Redstone."
		""
		"&aThe &4Nitro Crystal&a is the endgame of Powah."
		"&aMachines at this tier operate instantaneously"
		"&aand store godly amounts of energy."
		""
		"&eCongratulations, you have mastered the orb."
	]
	quest.3D2E3B31FE13AE46.quest_subtitle: "&4&lThe ultimate crystal."
	quest.3D2E3B31FE13AE46.title: "&4&lNitro Pinnacle"
	quest.3D43FBCDEC7BCF49.quest_desc: ["Boil this oil until it separates into useful fractions and &cflammable life mistakes&r. The distillation tower is your new god - pray that the pipes don't clog."]
	quest.3D43FBCDEC7BCF49.quest_subtitle: "Chemistry class without safety goggles."
	quest.3D43FBCDEC7BCF49.title: "&c&lDistillation Tower&r"
	quest.3D6801C58E846F57.quest_desc: [
		"A screen to dump your liquids into."
		""
		"Watch the numbers go up and feel a false sense of accomplishment."
	]
	quest.3D6801C58E846F57.quest_subtitle: "Number goes up"
	quest.3D6801C58E846F57.title: "&3&lTask Screen&r"
	quest.3D78D5D68C7F4B66.title: "First Steps"
	quest.3D7D415AFB21F9FC.quest_desc: [
		"&7Plant on farmland with matching infused soil to farm this resource hands-free.&r"
		""
		"&8Farm your resources. &dMystical Agriculture&7 grows what miners dig.&r"
	]
	quest.3D7D415AFB21F9FC.quest_subtitle: "Plant. Harvest. Repeat."
	quest.3D7D415AFB21F9FC.title: "Cow Seeds"
	quest.3D8141281387C0F1.quest_desc: ["A disk to save your programs. Because after spending 4 hours on a &e'sorting logic'&r, the last thing you want is for it to &cvanish&r into the void."]
	quest.3D8141281387C0F1.quest_subtitle: "Save your work"
	quest.3D8141281387C0F1.title: "&f&lProgram Disk&r"
	quest.3D9E2E0E941A45C8.quest_desc: [
		"&7A core crafting essence — refine and reinvest it up the tier ladder.&r"
		""
		"&8Plant essence seeds, harvest the world — ore farming without the mineshaft.&r"
	]
	quest.3D9E2E0E941A45C8.quest_subtitle: "Tier fuel"
	quest.3D9E2E0E941A45C8.title: "Tertium Essence"
	quest.3D9F6F7E29A3DD9C.quest_desc: ["The &6Pneumatic Wrench&r is used to rotate machines and configure connections. Crucial for tubes!"]
	quest.3DD763C84B8A5546.quest_desc: [
		"&eFree power&r from the sun."
		""
		"Produces &calmost nothing&r, works only during the day, and looks ugly. Great deal."
	]
	quest.3DD763C84B8A5546.quest_subtitle: "Praise the sun"
	quest.3DD763C84B8A5546.title: "&e&lSolar Generator&r"
	quest.3DE29A4FDF15668D.quest_desc: [
		"An incredibly loud machine that violently squishes ingots into &ePlates&r, &6Gears&r, and &bWires&r."
		""
		"Your eardrums will never forgive you."
	]
	quest.3DE29A4FDF15668D.quest_subtitle: "SQUISH"
	quest.3DE29A4FDF15668D.title: "&7&lMetal Press&r"
	quest.3DE5943B14BCD51A.title: "Advanced Mechanics"
	quest.3E101484DFDB8BC6.quest_desc: [
		"&7The &bImbuement Chamber&7 allows you to infuse items with Source or transform them."
		""
		"&3Place Lapis Lazuli inside to create a &dSource Gem&7, a fundamental crafting material."
	]
	quest.3E101484DFDB8BC6.quest_subtitle: "&bThe Core of Magic"
	quest.3E22D1866B33FF73.quest_desc: ["Purify the &65 shards&r into &e5 clumps&r."]
	quest.3E22D1866B33FF73.quest_subtitle: "Oxygen therapy"
	quest.3E22D1866B33FF73.title: "&4&lPurification&r"
	quest.3E2B139EE93F3F15.quest_desc: ["&eLPG&r - Best fuel, required for Plastic."]
	quest.3E2B139EE93F3F15.quest_subtitle: "&7PneumaticCraft"
	quest.3E2B139EE93F3F15.title: "&bLpg Bucket"
	quest.3E2E7A922D6520E3.quest_desc: [
		"Lore: Bathes raw ores in highly oxygenated environments to separate impurities before crushing."
		""
		"Technical Information: The key machine for 3x Ore Processing. Turns 1 Raw Ore into 3 Clumps."
		""
		"Usage: Requires Oxygen Gas (from an Electrolytic Separator) and Raw Ores."
		""
		"Goal: Craft a Purification Chamber."
		""
		"Tips: Feed Flint into the machine to jumpstart 3x processing before you have an Electrolytic Separator automated."
		""
		"Trivia: 'Clumps' are the lore-friendly way of describing ore chunks that have had their stone matrix oxidized away."
	]
	quest.3E2E7A922D6520E3.quest_subtitle: "&bOre Purification"
	quest.3E2E7A922D6520E3.title: "Purification Chamber"
	quest.3E5D1490B89F1BF7.quest_desc: [
		"Lore: By forcing Redstone dust into the lattice of an Iron Ingot, a conductive, highly reactive alloy is formed."
		""
		"Technical Information: Costs 10mB of Redstone per craft (1 piece of Redstone dust)."
		""
		"Usage: Used in the creation of Basic Control Circuits and tier-one machine upgrades."
		""
		"Goal: Manufacture 8 Enriched Alloys."
		""
		"Tips: Later on, enriching Redstone in an Enrichment Chamber makes it provide 80mB instead of 10mB per dust!"
		""
		"Trivia: These alloys glow faintly due to the latent Redstone energy trapped inside."
	]
	quest.3E5D1490B89F1BF7.quest_subtitle: "&cRedstone Infusion"
	quest.3E5D1490B89F1BF7.title: "Infused Alloys"
	quest.3E5D1490B89F1C44.quest_desc: [
		"Deep in the &8Labyrinth&r, the &4Minoshroom&r awaits."
		"Survive the &emaze&r, eat some questionable mushroom stew, and defeat the &cabomination&r."
	]
