	quest.7F05B373A3912488.quest_subtitle: "&7Astronomical solar output."
	quest.7F05B373A3912488.title: "&e&lSolar Panel — Spirited"
	quest.7F0B7EDFC0545EA2.quest_desc: ["Summons a thunderstorm right on their head. &bUnlimited power!&r"]
	quest.7F0B7EDFC0545EA2.quest_subtitle: "Zeus mode"
	quest.7F0B7EDFC0545EA2.title: "&b&lGlyph of Lightning&r"
	quest.7F0E6EDFD7B08806.quest_desc: [
		"Made of steel components. It's the core of the truly massive machines."
