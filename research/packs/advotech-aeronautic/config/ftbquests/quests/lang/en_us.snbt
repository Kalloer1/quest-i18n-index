	quest.3425D0ED39777F13.quest_desc: [
		"A natural continuation of the previous step."
		""
		"Craft or obtain the &bCapacitor Spirited&r."
		"It buffers energy so that machines drawing in bursts do not stall the rest of your network."
		"Part of the &7Powah&r progression."
		"&8Next: Capacitor Nitro."
	]
	quest.3425D0ED39777F13.quest_subtitle: "&7Powah"
	quest.3425D0ED39777F13.title: "&bCapacitor Spirited"
	quest.3433C3B313514FE9.title: "Advanced Mechanics"
	quest.343A97FD4F577EC6.quest_desc: [
		"Worth doing properly the first time - reworking this later is tedious."
		""
		"Craft or obtain the &aElite Induction Cell&r."
		"It buffers energy so that machines drawing in bursts do not stall the rest of your network."
		"Part of the &7Mekanism&r progression. This is the tier most setups settle on before pushing further."
		"&8Next: Ultimate Induction Cell."
	]
	quest.343A97FD4F577EC6.quest_subtitle: "&7Mekanism"
	quest.343A97FD4F577EC6.title: "&aElite Induction Cell"
	quest.345E9B5C5DA0437A.quest_desc: ["Yeets &eyou&r into the stratosphere. I really hope you packed some Feather Falling boots."]
	quest.345E9B5C5DA0437A.quest_subtitle: "Boing but for you"
	quest.345E9B5C5DA0437A.title: "&a&lGlyph of Leap&r"
	quest.3460C17B21F24CBD.quest_desc: [
		"&7Part of what makes &dMystical Agradditions&7 tick. Worth keeping a few on hand.&r"
		""
		"&8The &dAgradditions&7 tier — Insanium and beyond, for the truly endgame farmer.&r"
	]
	quest.3460C17B21F24CBD.quest_subtitle: "Add to collection"
	quest.3460C17B21F24CBD.title: "Prudentium Apple"
	quest.347BA73561A7970E.quest_desc: [
		"&7With &eAdvancedAE&7, you can push autocrafting to the absolute limit."
		""
		"&6Advanced Pattern Providers&7 hold significantly more patterns, work faster, and are essential for extreme endgame automation."
	]
	quest.347BA73561A7970E.quest_subtitle: "&eAdvanced Autocrafting"
	quest.349255D0F067697D.quest_desc: [
		"&7A refined metal ingot — the raw stock for tools, machines and alloys.&r"
		""
		"&8Plant essence seeds, harvest the world — ore farming without the mineshaft.&r"
	]
	quest.349255D0F067697D.quest_subtitle: "Refined and ready"
	quest.349255D0F067697D.title: "Imperium Ingot"
	quest.3496706FD46BDD7B.quest_desc: [
		"Look... you could set up a massive, convoluted assembly line to craft PCBs with lasers and drills."
		""
		"Or, you could just find a mechanic villager and pay him &aemeralds&r. We both know which one you're going to choose. Lazy."
	]
	quest.3496706FD46BDD7B.quest_subtitle: "Sending our regards!"
	quest.3496706FD46BDD7B.title: "&a&lCapitalism Solves Everything&r"
	quest.349BF9AEABFD6FC2.quest_desc: [
		"&7A building block of your &dMystical Agradditions&7 setup — you'll want more than one.&r"
		""
		"&8The &dAgradditions&7 tier — Insanium and beyond, for the truly endgame farmer.&r"
	]
	quest.349BF9AEABFD6FC2.quest_subtitle: "Onward and upward"
	quest.349BF9AEABFD6FC2.title: "Insanium Apple"
	quest.34A7155DA34FCA7F.quest_desc: ["&6Blazing Reactor&r. 36 Blazing blocks. The amount of &eBlaze Rods&r you've murdered is starting to concern me."]
	quest.34A7155DA34FCA7F.title: "&6&lBlazing Reactor&r"
	quest.34AE5C8D28991377.quest_desc: ["&7This mod (in addition to being &cAWESOME!!!&7 (like mr. Torgue said)) consumes so &asmall amount of energy&7 that advanced mekanism cables are enough to supply power to most machines (except mycelial reactor)"]
	quest.34AE5C8D28991377.quest_subtitle: "Noooo! my po.... wait a second we are fine."
	quest.34AE5C8D28991377.title: "&bProgress Marker"
	quest.34AEEC21D37D362C.quest_desc: ["&8Tomes of Weaponry&r will give &5Enchantments&r for Swords and Axes. \\n\\nMostly the ones that help with Killing things! Like &5Sharpness &fand &5Fire Aspect&r. \\n&8Tomes of Archery&r will give &5Enchantments&r for ranged Weapons, the Bow and Crossbow. \\n\\n&5Piercing&f, &5Power&f, and &5Knockback&r!"]
	quest.34AEEC21D37D362C.title: "&8Weapon Tomes"
	quest.34B38BD4A3D44058.quest_desc: [
		"&6This is the one worth building towards.&r"
		""
		"Craft or obtain the &6Book of Shadows Altar&r."
		"A ritual component. These are slow, deliberate, and usually gate something that cannot be obtained any other way."
		"Part of the &7Hexerei&r progression."
		"&8Nothing further depends on this - build it when you want it, not because you have to."
	]
	quest.34B38BD4A3D44058.quest_subtitle: "&7Hexerei"
	quest.34B38BD4A3D44058.title: "&6Book of Shadows Altar"
	quest.34BACC98EDAD8981.quest_desc: ["More integration armor that makes you literally unkillable. The balance of this modpack is officially &clong gone&r."]
	quest.34BACC98EDAD8981.quest_subtitle: "God pajamas"
	quest.34BACC98EDAD8981.title: "&d&lUnobtainium Mage Leggings&r"
	quest.34C1430DEB334137.quest_desc: [
		"A massive spinning bowl of death."
		""
		"It grinds ores into dusts for doubling, crushes blaze rods, and will absolutely shred &cmobs and players&r if they fall in. Mind your step."
	]
	quest.34C1430DEB334137.quest_subtitle: "CRUSH!!! Thy end is now"
	quest.34C1430DEB334137.title: "&8&lThe Crusher&r"
	quest.34CE90D9FED228D9.quest_desc: [
		"A step up from what came before."
		""
		"Craft or obtain the &6Allthemodium Sword&r."
		"A tool or weapon at this tier. Better reach, better speed, and usually a special ability worth learning."
		"Part of the &7AllTheModium&r progression."
		"&8A side branch. Optional, but rarely a waste of time."
	]
	quest.34CE90D9FED228D9.quest_subtitle: "&7AllTheModium"
	quest.34CE90D9FED228D9.title: "&6Allthemodium Sword"
	quest.34D33C35B2A22209.quest_desc: [
		"&7You need power to make power."
		""
		"&aCraft a &cFurnator&a (burns solid fuel like coal)"
		"&aor a &cMagmator&a (burns liquid fuel like lava)."
		"&aThese are your reliable early-game power sources."
	]
	quest.34D33C35B2A22209.quest_subtitle: "&7Burning for power."
	quest.34D33C35B2A22209.title: "&c&lEarly Generation"
