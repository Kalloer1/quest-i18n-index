		"&7Plant on farmland with matching infused soil to farm this resource hands-free.&r"
		""
		"&8Plant essence seeds, harvest the world — ore farming without the mineshaft.&r"
	]
	quest.79D04ABDBB4B0DB7.quest_subtitle: "Plant. Harvest. Repeat."
	quest.79D04ABDBB4B0DB7.title: "Rose Gold Seeds"
	quest.79F4137B3D67AF16.quest_desc: [
		"&7As your reactor burns Yellorium, it outputs"
		"&3Cyanite&7 into the output port."
		""
		"&aKeep this! It is highly toxic but absolutely"
		"&aessential for mid-game progression."
	]
	quest.79F4137B3D67AF16.quest_subtitle: "&7Don't throw this away."
	quest.79F4137B3D67AF16.title: "&3&lRadioactive Waste"
	quest.7A16B12407FA49C9.title: "First Steps"
	quest.7A1B2C3D4E5F6000.quest_desc: [
		"&7Welcome to &cMekanism: Elements&7!"
		""
		"&7Because base Mekanism wasn't complicated enough, now you get to extract trace elements from the ocean, steal gases from the atmosphere, and play with literal Nitric Acid."
		""
		"&cTry not to mutate yourself.&7"
	]
	quest.7A1B2C3D4E5F6000.quest_subtitle: "Science, but harder"
	quest.7A1B2C3D4E5F6000.title: "&b&lWelcome to Elements&r"
	quest.7A1B2C3D4E5F6001.quest_desc: [
		"&7Sucking the life out of the atmosphere has never been so industrial."
		""
		"&7Build an &bAir Compressor&7 to compress ambient air. Your neighbors won't mind the noise, probably."
	]
	quest.7A1B2C3D4E5F6001.quest_subtitle: "Atmospheric theft"
	quest.7A1B2C3D4E5F6001.title: "&e&lAir Bending&r"
	quest.7A1B2C3D4E5F6002.quest_desc: [
		"&7Run the compressed air through the &eAdsorption Separator&7 to rip the &aNitrogen&7, &bOxygen&7, and &dArgon&7 right out of it."
		""
		"&7It’s like breathing, but for machines."
	]
	quest.7A1B2C3D4E5F6002.quest_subtitle: "Gas slicer"
	quest.7A1B2C3D4E5F6002.title: "&e&lAdsorption Separator&r"
	quest.7A1B2C3D4E5F6003.quest_desc: [
		"&7Mix your hard-earned Nitrogen with Hydrogen to make &aAmmonia&7."
		""
		"&7Not only does it burn hotter than Ethylene, but your jetpack can now officially run on weaponized window cleaner! It burns &l5x slower&r and gives a &l1.5x vertical thrust multiplier&r."
	]
	quest.7A1B2C3D4E5F6003.quest_subtitle: "Weaponized window cleaner"
	quest.7A1B2C3D4E5F6003.title: "&a&lSmelly Flight&r"
	quest.7A1B2C3D4E5F6004.quest_desc: [
		"&7Mix Ammonia, Oxygen, and Water Vapor to create &cNitric Acid&7."
		""
		"&7Why do you want this highly corrosive nightmare fluid? Because it can actually &erender Spent Nuclear Waste harmless&7! Finally, your basement won't be filled with glowing green barrels."
	]
	quest.7A1B2C3D4E5F6004.quest_subtitle: "Melting your problems away"
	quest.7A1B2C3D4E5F6004.title: "&c&lAcidic Waste Disposal&r"
	quest.7A1B2C3D4E5F6005.quest_desc: [
		"&7Combine Nitric Acid and Ammonia to create &cAmmonium Nitrate&7."
		""
		"&7This compound allows you to craft TNT and Fireworks Rockets with 8 TIMES more output. Server admins absolutely love this one simple trick."
	]
	quest.7A1B2C3D4E5F6005.quest_subtitle: "Big boom"
	quest.7A1B2C3D4E5F6005.title: "&c&lExplosive Tendencies&r"
	quest.7A1B2C3D4E5F6006.quest_desc: [
		"&7Extracting &dXenon&7 from Argon."
		""
		"&7Noble gases are notoriously lazy and don't want to react with anything. Force them to do your bidding anyway."
	]
	quest.7A1B2C3D4E5F6006.quest_subtitle: "Lazy gases"
	quest.7A1B2C3D4E5F6006.title: "&d&lNoble Ambitions&r"
	quest.7A1B2C3D4E5F6007.quest_desc: ["&7Inject yourself with &dXenon&7 to sleep through the server lag. Grants immense damage resistance."]
	quest.7A1B2C3D4E5F6007.quest_subtitle: "Nap time"
	quest.7A1B2C3D4E5F6007.title: "&d&lAnesthetic&r"
	quest.7A1B2C3D4E5F6008.quest_desc: [
		"&7Mining is for peasants."
		""
		"&7Place a &bSeawater Pump&7 in an ocean biome. Now you can literally suck the ocean dry for profit."
	]
	quest.7A1B2C3D4E5F6008.quest_subtitle: "Salty industry"
	quest.7A1B2C3D4E5F6008.title: "&9&lOcean Drainer&r"
	quest.7A1B2C3D4E5F600B.quest_desc: ["&7Process seawater to obtain &cBromine&7. It's toxic, it stinks, and it's highly useful."]
	quest.7A1B2C3D4E5F600B.quest_subtitle: "Stinky water"
	quest.7A1B2C3D4E5F600B.title: "&c&lBromine Extraction&r"
	quest.7A1B2C3D4E5F600C.quest_desc: ["&7Inject &cBromine&7 into your veins so you don't burn to death. Lava is just spicy water now."]
	quest.7A1B2C3D4E5F600C.quest_subtitle: "Spicy water immunity"
	quest.7A1B2C3D4E5F600C.title: "&c&lFire Retardant&r"
