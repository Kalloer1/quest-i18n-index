	quest.331FE5C51C94FDFD.quest_subtitle: "Sheet of plastic"
	quest.331FE5C51C94FDFD.title: "&f&lHDPE Sheet&r"
	quest.3333000000000001.quest_desc: [
		"&7The beginning of your &lJust Dire Things&r automation journey."
		""
		"&7Ferricore is the baseline material for crafting early-game tools and Tier 1 machines. It introduces you to the core mechanics of the mod."
	]
	quest.3333000000000001.title: "&7Ferricore Era"
	quest.3333000000000002.quest_desc: [
		"&7Tier 2 material."
		""
		"&7Infused with the heat of the Nether, Blazegold allows your tools to auto-smelt and your machines to operate over a larger area with better filtering."
	]
	quest.3333000000000002.title: "&6Blazegold"
	quest.3333000000000003.quest_desc: [
		"&7Tier 3 material."
		""
		"&7A crystalline powerhouse. Celestigem upgrades your automation to cover massive areas and work at incredible speeds. Pickaxes gain ore-radar capabilities!"
	]
	quest.3333000000000003.quest_subtitle: "Danger zone"
	quest.3333000000000003.title: "&bCelestigem"
	quest.3333000000000004.quest_desc: [
		"&7Tier 4 (Endgame) material."
		""
		"&7The absolute pinnacle of Dire technology. Unrivaled speed, gigantic machine areas, and reality-bending tool abilities like Drop Teleport."
	]
	quest.3333000000000004.title: "&5Eclipse Alloy"
	quest.3333000000000005.quest_desc: [
		"&7Your best friend for factory management."
		""
		"&7Use this to configure machine operating areas, toggle input/output faces, and safely pick up your devices."
	]
	quest.3333000000000005.title: "&eDire's Wrench"
	quest.3333000000000006.quest_desc: ["&7A solid starting tool with basic abilities like vein mining or tree felling (check your keybinds)."]
	quest.3333000000000006.title: "&7Ferricore Pickaxe"
	quest.3333000000000007.quest_desc: ["&7Auto-smelts mined ores! A massive time saver for early game resource gathering."]
	quest.3333000000000007.title: "&6Blazegold Pickaxe"
	quest.3333000000000008.quest_desc: ["&7Extremely fast and durable, featuring a built-in radar to highlight valuable ores through walls."]
	quest.3333000000000008.title: "&bCelestigem Pickaxe"
	quest.3333000000000009.quest_desc: ["&7Tears through the world. Features the Drop Teleport ability, sending items directly into a linked chest."]
	quest.3333000000000009.title: "&5Eclipse Alloy Pickaxe"
	quest.333300000000000A.quest_desc: ["&7Automatically breaks blocks directly in front of it. Requires a redstone signal to operate."]
	quest.333300000000000A.title: "&8Block Breaker (T1)"
	quest.333300000000000B.quest_desc: ["&7Places blocks from its inventory into the world. Perfect for automated farming or building setups."]
	quest.333300000000000B.title: "&8Block Placer (T1)"
	quest.333300000000000C.quest_desc: ["&7Simulates Left or Right clicks. Can swing swords at mobs or use items on blocks."]
	quest.333300000000000C.title: "&8Clicker (T1)"
	quest.333300000000000D.quest_desc: ["&7Emits a redstone signal based on specific conditions (block updates, entity detection, etc.)."]
	quest.333300000000000D.title: "&8Sensor (T1)"
	quest.3333333333333333.quest_desc: [
		"&eThe Lord of Flames himself."
		"&7His area-of-effect attacks will destroy everything in their path. Watch out for his sword!"
	]
	quest.3333333333333333.quest_subtitle: "&cA fight, not a recipe"
	quest.3333333333333333.title: "&6&lIgnis"
	quest.335268AC1865B8AB.quest_desc: [
		"&7The &5Ultimate&7 machine for late-game &eTransmutation&7."
		""
		"&7This giant &5Nucleosynthesizer&7 turns &dAntimatter&7 and power into the rarest materials in the game. It’s expensive, it’s big, and it’s &dpeak technology&7."
	]
	quest.335268AC1865B8AB.quest_subtitle: "Atomic Weaver"
	quest.335268AC1865B8AB.title: "&5Large Antiprotonic Nucleosynthesizer"
	quest.335C42C880B8655C.quest_desc: [
		"&7Set up &aPattern Providers&7 and &bMolecular Assemblers&7 to teach your network how to craft items for you."
		""
		"&cUse the Pattern Encoding Terminal to encode blank patterns with recipes."
	]
	quest.335C42C880B8655C.quest_subtitle: "&cAutocrafting"
	quest.3363F6A6A4CA7563.quest_desc: ["Smelt the &e4 clean dusts&r into &f4 ingots&r."]
	quest.3363F6A6A4CA7563.quest_subtitle: "Finally, more ingots"
	quest.3363F6A6A4CA7563.title: "&c&lSmelting&r"
	quest.3368A10E00580658.quest_desc: [
		"Just some highly advanced &8carbon&r."
		""
		"You're making miracle materials just to survive the nuclear wasteland you're about to create."
	]
	quest.3368A10E00580658.quest_subtitle: "Pencil lead, but fancy"
	quest.3368A10E00580658.title: "&8&lGraphene&r"
	quest.33932A020DC97EC7.quest_desc: ["Turns logs into sawdust in a fraction of a microsecond."]
	quest.33932A020DC97EC7.quest_subtitle: "Speedy saw"
	quest.33932A020DC97EC7.title: "&6&lSupreme Sawing Factory&r"
	quest.3399EAB5F7C9F803.quest_desc: [
		"&6A milestone.&r"
		""
		"Craft or obtain the &6Prediction&r."
		"Another step along this mod's arcane progression. The power curve here is steep, and skipping stages tends to cost more time than it saves."
		"Part of the &7Hostile Neural Networks&r progression."
		"&8Nothing further depends on this - build it when you want it, not because you have to."
	]
	quest.3399EAB5F7C9F803.quest_subtitle: "&7Hostile Neural Networks"
	quest.3399EAB5F7C9F803.title: "&6Prediction"
	quest.339A01AA463B47DA.quest_desc: ["Welcome to the modpack. Start your journey here!"]
	quest.339A01AA463B47DA.title: "Welcome to Introduction"
	quest.339CF321976EE179.quest_desc: [
		"Machines only run in loaded chunks."
		"A farm or a processing line stops the moment nobody is nearby, unless the chunk is force-loaded. Force-load from the map screen."
		"&cBe sparing.&r Every force-loaded chunk costs server performance, and a base full of them is the most common cause of a laggy world."
		"&8Next: moving around the world efficiently."
	]
	quest.339CF321976EE179.quest_subtitle: "&6The chapter's capstone"
	quest.339CF321976EE179.title: "&6Chunk Loading"
	quest.33BD3C4C950BA5CE.quest_desc: [
		"&7Step one to infinite storage."
		"&cIncreases the base capacity of a drawer. A vital upgrade for early-game resource hoarding."
	]
	quest.33BD3C4C950BA5CE.quest_subtitle: "&7Functional Storage"
	quest.33BD3C4C950BA5CE.title: "&c&lCopper Upgrade"
	quest.33D6E7C8A4DF08A3.quest_desc: [
		"&e&l8x The Power!&r"
		""
		"&7Why build a massive room full of generators when you can compress them? This upgraded block generates exactly &a8 times&7 the power of its base tier, saving you precious space and cabling."
	]
	quest.33D6E7C8A4DF08A3.quest_subtitle: "8x power multiplier"
	quest.33DC663B3DAD4FF4.quest_desc: [
		"&6A milestone.&r"
		""
		"Craft or obtain the &6Shock Module&r."
		"An upgrade module. Slotting these in is how you turn a functional machine into a fast one without rebuilding your entire setup."
		"Part of the &7Modular Force Field System&r progression."
		"&8The end of this branch."
	]
	quest.33DC663B3DAD4FF4.quest_subtitle: "&7Modular Force Field System"
	quest.33DC663B3DAD4FF4.title: "&6Shock Module"
	quest.33E47E9D1EA68249.quest_desc: [
		"&7Welcome to the simplest storage network ever."
		""
		"&aThe &6Inventory Connector&a is the core of your network."
		"&aPlace it touching a chest (or multiple chests touching"
		"&aeach other) to link all their inventories together."
		""
		"&bTip:&7 It does not require any power!"
	]
	quest.33E47E9D1EA68249.quest_subtitle: "&7One block to rule them all."
	quest.33E47E9D1EA68249.title: "&6&lThe Brain of the System"
	quest.33F266E1D1D37855.quest_desc: ["Opens your ender chest from anywhere. Surprisingly &euseful&r for a magic mod."]
	quest.33F266E1D1D37855.quest_subtitle: "Cloud storage"
	quest.33F266E1D1D37855.title: "&5&lGlyph of Ender Inventory&r"
	quest.340B6BC49E96E4A9.quest_desc: [
		"You have the prerequisites. Now put them to use."
		""
		"Craft or obtain the &5Coffer&r."
		"Slow, ritualistic magic. The pacing is deliberate and the payoffs are worth waiting for."
		"Part of the &7Hexerei&r progression."
		"&8Next: Blood Sigil, Witch Helmet."
	]
	quest.340B6BC49E96E4A9.quest_subtitle: "&7Hexerei"
	quest.340B6BC49E96E4A9.title: "&5Coffer"
	quest.341864265BE77C14.quest_subtitle: "Paliwo z pereł kresu."
	quest.3419275995D03048.quest_desc: [
		"Slap a &eBrass Sheet&r onto a stripped log."
		""
		"Now your wood is smart. Don't ask questions."
	]
	quest.3419275995D03048.quest_subtitle: "Smart wood"
	quest.3419275995D03048.title: "&e&lBrass Casing&r"
	quest.34238B1E4DE0A437.quest_desc: ["Usually you can't get Spawn Eggs, but that's the same with Spawners and here we are! There's a few ways of obtaining Spawn Eggs but once you do, right click it on Spawner to change the mobs it spawn"]
	quest.34238B1E4DE0A437.title: "Spawn Eggs"
	quest.342490E2361D34DD.quest_desc: ["&aSpirited Magmator&r. It chugs lava so fast you'll need to upgrade your &epipes&r just to keep it fed."]
