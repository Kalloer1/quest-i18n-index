	quest.7E96D1ACC4AC0290.quest_subtitle: "heart of slime, moonlight's shine!"
	quest.7E96D1ACC4AC0290.title: "&deye of newt, newborn's foot."
	quest.7E9857BE2740E0EB.quest_desc: ["&7Melts 3 things into puddles. Who needs solid matter?"]
