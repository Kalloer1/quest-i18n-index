	quest.037DADC6431F3C1F.quest_desc: [
		"Gordon Ramsay is having a stroke."
		""
		"You combined every crop in existence into a lag-inducing, pixelated bowl of slop. It feeds you forever, but at what cost to your dignity?"
	]
	quest.037DADC6431F3C1F.quest_subtitle: "Vegan nightmare"
	quest.037DADC6431F3C1F.title: "&a&lUltimate Stew&r"
	quest.038141367285287C.quest_desc: [
		"&7Before you can split atoms, you need atoms to split."
		""
		"&aMine some Yellorite Ore and smelt it into"
		"&eYellorium Ingots&a. This is the primary fuel"
		"&athat will power your early game reactors."
	]
	quest.038141367285287C.quest_subtitle: "&7The glowing green rock."
	quest.038141367285287C.title: "&e&lNuclear Fuel"
	quest.03B5D73DD86F3F82.quest_desc: [
		"Lore: The silicon brains of Mekanism. These circuits regulate power flow and logic in all fundamental machines."
		""
		"Technical Information: Created by infusing Osmium with Redstone in the Metallurgic Infuser."
		""
		"Usage: Required for crafting almost every functional block and upgrade in the mod."
		""
		"Goal: Craft 8 Basic Control Circuits."
		""
		"Tips: Automate these early! You will literally need thousands of them for a full base setup."
		""
		"Trivia: Control circuits have a distinct green texture that becomes more complex as tiers increase."
	]
	quest.03B5D73DD86F3F82.quest_subtitle: "&aBasic Circuits"
	quest.03B5D73DD86F3F82.title: "Basic Control Circuits"
	quest.03C01109554B7E54.quest_desc: [
		"Trains will absolutely &cdestroy&r any entities in their path."
		""
		"Keep your chunks loaded, or your train might just decide to take a break in the void. Have fun running over your friends."
	]
	quest.03C01109554B7E54.quest_subtitle: "I like trains"
	quest.03C01109554B7E54.title: "&b&lTrains&r"
	quest.03D33C5365FB024C.quest_desc: ["Drowns your enemies. A bit &cdark&r for a colorful magic mod, isn't it?"]
	quest.03D33C5365FB024C.quest_subtitle: "Glub glub"
	quest.03D33C5365FB024C.title: "&9&lGlyph of Watery Grave&r"
	quest.03EE5E17084CE8FB.quest_desc: [
		"&7A rock-solid, advanced material."
		""
