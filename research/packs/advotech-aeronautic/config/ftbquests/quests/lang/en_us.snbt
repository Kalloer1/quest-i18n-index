	quest.19AE831E545CE42D.title: "&0&lCoal Coke&r"
	quest.19B2A14848B33160.quest_desc: ["Because waiting 2 seconds for an ore shard is just unacceptable."]
	quest.19B2A14848B33160.quest_subtitle: "No patience"
	quest.19B2A14848B33160.title: "&6&lSupreme Injecting Factory&r"
	quest.19BAC6A2B3F874F0.quest_desc: ["You are going to need a LOT of this powder"]
	quest.19BAC6A2B3F874F0.quest_subtitle: "who's cooking eggs?"
	quest.19BAC6A2B3F874F0.title: "Got the stinker!"
	quest.19BED6839A9B598A.quest_subtitle: "Ostateczna potęga Netherite x64!"
	quest.19BFA508652C0E55.quest_desc: [
		"The &4Hydra&r is an &cimmortal beast&r of the &6Fire Swamp&r."
		"Only the &estrongest warriors&r can withstand its &cbreath&r."
		""
		"&7Hit it while its mouth is open. Basic video game boss rules apply here."
	]
	quest.19BFA508652C0E55.quest_subtitle: "The Immortal Beast"
	quest.19BFA508652C0E55.title: "&4&lThe Hydra"
	quest.19BFA508652C0E88.quest_desc: [
		"The Slider guards the Bronze Dungeons."
		"It is a construct of stone that cannot be harmed by swords."
		""
		"&c&lWeakness:"
		"&7Use a Pickaxe to damage it!"
	]
	quest.19BFA508652C0E88.quest_subtitle: "Bronze Dungeon Boss"
	quest.19BFA508652C0E88.title: "&6&lThe Slider"
	quest.19BFA508652C0ED4.quest_desc: [
		"Lore: A nearly indestructible ingot, forging the strength of obsidian with the binding density of Osmium."
		""
		"Technical Information: Smelted from Refined Obsidian Dust."
		""
		"Usage: Used to craft the best Mekanism Tools, Armor, and Ultimate-tier machinery."
		""
		"Goal: Smelt 6 Refined Obsidian Ingots."
		""
		"Tips: A full set of Refined Obsidian armor provides immense defense and durability before you unlock the MekaSuit."
		""
		"Trivia: These ingots have the highest tier-weight in the base mod, visually distinct by their glowing purple core."
	]
	quest.19BFA508652C0ED4.quest_subtitle: "&5Refined Obsidian"
	quest.19BFA508652C0ED4.title: "Refined Obsidian Ingot"
	quest.19C5E6245FB26AFC.quest_desc: [
		"This is where the chapter begins."
		""
		"A checkpoint rather than a craft. Read through this section before moving on - the minute it costs now saves considerably more later."
		"&8Next: Stone Wand, Time in a Bottle, Sink."
	]
	quest.19C5E6245FB26AFC.quest_subtitle: "&7The first step"
	quest.19C5E6245FB26AFC.title: "&6Checkpoint"
	quest.19CA895595174809.title: "First Steps"
	quest.19D292EAEFA350B9.quest_desc: [
		"&7A weapon worth the grind — bring it to the next boss.&r"
		""
		"&8Inferium to Insanium: the tier ladder that turns dirt into Allthemodium.&r"
	]
	quest.19D292EAEFA350B9.quest_subtitle: "Sharp end first"
	quest.19D292EAEFA350B9.title: "Imperium Sword"
	quest.1A0029693B4D8E6E.quest_desc: [
		"The &cKatana&r is a swift, high-damage weapon. Silent Gear offers many weapon types like Machetes, Daggers, and Bows."
		""
		"Experiment with different materials to maximize your DPS and attack speed!"
	]
	quest.1A08250D75F0428D.quest_desc: ["Increases energy transfer limits to 'ludicrous'."]
	quest.1A08250D75F0428D.quest_subtitle: "Ludicrous speed"
	quest.1A08250D75F0428D.title: "&b&lCosmic Provider&r"
	quest.1A13CD4BA465E16F.quest_desc: [
		"&7The journey to godhood begins here."
		""
		"&aFind and smelt your first &6AllTheModium Ingot&a."
		"&aThese ores are incredibly rare, often found in"
		"&aDeep Dark biomes, Ocean depths, or the Mining Dimension."
	]
	quest.1A13CD4BA465E16F.quest_subtitle: "&7Hidden in the deep."
	quest.1A13CD4BA465E16F.title: "&6&lThe First Tier"
	quest.1A19C65D90464300.quest_desc: [
		"Welcome to &9Modern Industrialization&r!"
		""
		"This is a massive tech mod about automation, processing, and progression. Your first and most important item is the &9Guidebook&r. Keep it safe, as it contains all the multiblock structures and progression hints you will ever need."
	]
	quest.1A19C65D90464300.quest_subtitle: "Welcome to the factory"
	quest.1A19C65D90464300.title: "&9The Industrial Era Begins"
	quest.1A1A1A1A1A1A1A10.quest_desc: [
		"Everything that follows in this chapter starts here."
		""
		"A checkpoint rather than a craft. Read through this section before moving on - the minute it costs now saves considerably more later."
		"&8Next: Coercion Deriver, Biometric Identifier, Remote Controller."
	]
	quest.1A1A1A1A1A1A1A10.quest_subtitle: "&7Where this chapter begins"
	quest.1A1A1A1A1A1A1A10.title: "&6Checkpoint"
	quest.1A1A1A1A1A1A1A11.quest_desc: [
		"A step up from what came before."
		""
		"Craft or obtain the &bCoercion Deriver&r."
		"Another piece of the machine chain. On its own it does little; wired into the rest of your factory it removes one more job you were doing by hand."
		"Part of the &7Modular Force Field System&r progression."
		"&8Next: Focus Matrix, Fortron Capacitor."
	]
	quest.1A1A1A1A1A1A1A11.quest_subtitle: "&7Modular Force Field System"
	quest.1A1A1A1A1A1A1A11.title: "&bCoercion Deriver"
	quest.1A1A1A1A1A1A1A12.quest_desc: [
		"A step up from what came before."
		""
		"Craft or obtain the &bFortron Capacitor&r."
		"It buffers energy so that machines drawing in bursts do not stall the rest of your network."
		"Part of the &7Modular Force Field System&r progression."
		"&8Next: Capacity Module, Scale Module, Projector."
	]
	quest.1A1A1A1A1A1A1A12.quest_subtitle: "&7Modular Force Field System"
	quest.1A1A1A1A1A1A1A12.title: "&bFortron Capacitor"
	quest.1A1A1A1A1A1A1A13.quest_desc: [
		"You have the prerequisites. Now put them to use."
		""
		"Craft or obtain the &bProjector&r."
		"Another piece of the machine chain. On its own it does little; wired into the rest of your factory it removes one more job you were doing by hand."
		"Part of the &7Modular Force Field System&r progression."
		"&8Next: Cube Mode, Sphere Mode, Cylinder Mode."
	]
	quest.1A1A1A1A1A1A1A13.quest_subtitle: "&7Modular Force Field System"
	quest.1A1A1A1A1A1A1A13.title: "&bProjector"
	quest.1A1A1A1A1A1A1A15.quest_desc: [
		"This is where the chapter stops being introductory."
		""
		"Craft or obtain the &bBiometric Identifier&r."
		"Another piece of the machine chain. On its own it does little; wired into the rest of your factory it removes one more job you were doing by hand."
		"Part of the &7Modular Force Field System&r progression."
		"&8Next: Interdiction Matrix, Blank Card, Id Card."
	]
	quest.1A1A1A1A1A1A1A15.quest_subtitle: "&7Modular Force Field System"
	quest.1A1A1A1A1A1A1A15.title: "&bBiometric Identifier"
	quest.1A1A1A1A1A1A1A16.quest_desc: [
		"Steady progress. This one is not glamorous, but the chapter does not work without it."
		""
		"Craft or obtain the &bInterdiction Matrix&r."
		"Another piece of the machine chain. On its own it does little; wired into the rest of your factory it removes one more job you were doing by hand."
		"Part of the &7Modular Force Field System&r progression."
		"&8Next: Section Complete."
	]
	quest.1A1A1A1A1A1A1A16.quest_subtitle: "&7Modular Force Field System"
	quest.1A1A1A1A1A1A1A16.title: "&bInterdiction Matrix"
	quest.1A22E08C96212116.quest_desc: ["Conquer massive, sprawling structures."]
	quest.1A22E08C96212116.title: "Welcome to When Dungeons Arise"
	quest.1A2B3C4D5E6F0001.quest_desc: [
		"Before we get to the really crazy stuff, you need to master the &bCrystal Matrix&r."
		""
		"It's made by shoving a ridiculous amount of &bNether Stars&r, &fDiamond Lattices&r, and your new &8Neutronium&r together. It's expensive, but compared to what's coming, this is basically &7pocket change&r."
	]
	quest.1A2B3C4D5E6F0001.quest_subtitle: "Sparkly overkill"
	quest.1A2B3C4D5E6F0001.title: "&b&lCrystal Matrix Ingot&r"
	quest.1A2B3C4D5E6F0002.quest_desc: [
		"A bow so powerful it doesn't just shoot arrows, it &bshoots the concept of death&r."
		""
		"The &eLongbow of the Heavens&r will automatically home in on targets and rain down &dcelestial judgment&r. Your arrows are now orbital strikes."
	]
	quest.1A2B3C4D5E6F0002.quest_subtitle: "Orbital strike simulation"
	quest.1A2B3C4D5E6F0002.title: "&d&lHeaven's Seeker&r"
	quest.1A2B3C4D5E6F0003.quest_desc: [
		"The &8Hoe of the Green&r."
		""
		"You spent a literal &cinfinity&r of resources to craft a... &ehoe&r? You really are committed to this farming life, aren't you?"
		""
		"It clears entire fields and plants seeds in a massive radius. Peak laziness achieved."
	]
	quest.1A2B3C4D5E6F0003.quest_subtitle: "Infinity... for a hoe?"
	quest.1A2B3C4D5E6F0003.title: "&2&lBotanical Tyrant&r"
	quest.1A2B3C4D5E6F0004.quest_desc: [
		"The &7Planet Crusher&r shovel."
		""
		"Mines dirt, sand, and gravel like they are &bair&r. It can also turn entire forests into flat land with one click."
		""
		"Try not to accidentally delete your entire base while trying to clear a garden patch."
	]
	quest.1A2B3C4D5E6F0004.quest_subtitle: "Landscape eraser"
	quest.1A2B3C4D5E6F0004.title: "&7&lPlanet Crusher&r"
	quest.1A2B3C4D5E6F0005.quest_desc: [
		"The &4Nature's Ruin&r axe."
		""
		"It cuts down trees. &lEvery. Single. Block.&r If a leaf is connected to a log, it's gone. Forests are now an endangered species because of you."
	]
	quest.1A2B3C4D5E6F0005.quest_subtitle: "Lumberjack's nightmare"
	quest.1A2B3C4D5E6F0005.title: "&4&lNature's Ruin&r"
	quest.1A2B3C4D5E6F0006.quest_desc: [
		"The &eTotem of Infinity&r."
		""
		"It doesn't break when used. You are now &4permanently immune to death&r. You can dance in the void, hug creepers, and swim in lava for fun."
		""
		"You've officially won Minecraft. Go outside. Seriously."
	]
	quest.1A2B3C4D5E6F0006.quest_subtitle: "Actual God Mode"
	quest.1A2B3C4D5E6F0006.title: "&e&lThe Eternal Soul&r"
	quest.1A2B3C4D5E6F0101.quest_desc: [
		"&7Because getting lost in an infinite, dark forest is only fun for the first five minutes."
		""
		"&7Hunt down a local Raven, steal its feathers, and combine them with Torchberries to make a &eMagic Map Focus&r. Now you can actually see where you're going."
	]
	quest.1A2B3C4D5E6F0101.quest_subtitle: "GPS for the lost"
	quest.1A2B3C4D5E6F0101.title: "&e&lMagic Map Focus"
	quest.1A2B3C4D5E6F0103.quest_desc: [
		"&7Somewhere in this forest is a magical sheep that demands 16 different colors of wool."
		""
		"&7Yes, you are playing delivery boy to livestock. Feed its interior design addiction and it will reward you with the &aCrumble Horn&r, which breaks blocks with annoying sounds."
	]
	quest.1A2B3C4D5E6F0103.quest_subtitle: "Baa baa rainbow sheep"
	quest.1A2B3C4D5E6F0103.title: "&a&lThe Quest Ram"
	quest.1A2B3C4D5E6F0105.quest_desc: [
		"&7Why craft things when you can just un-craft them?"
		""
		"&7The &dUncrafting Table&r lets you reverse recipes. Found a useless piece of armor? Turn it back into ingots. It's recycling, but powered by dark magic."
	]
	quest.1A2B3C4D5E6F0105.quest_subtitle: "Ctrl+Z for crafting"
	quest.1A2B3C4D5E6F0105.title: "&d&lUncrafting Table"
	quest.1A2B3C4D5E6F0107.quest_desc: [
		"&7Found in Hollow Hills and Labyrinths, the &eCharm of Keeping&r is basically a budget grave-stone."
		""
		"&7Keep it in your inventory so when you inevitably fall into lava, you don't lose all your hard-earned loot."
	]
	quest.1A2B3C4D5E6F0107.quest_subtitle: "Death insurance"
	quest.1A2B3C4D5E6F0107.title: "&e&lCharm of Keeping"
	quest.1A2B3C4D5E6F0109.quest_desc: [
		"&7The &aMoonworm Queen&r. It shoots glowing worms. It's disgusting, squishy, and absolutely essential if you ran out of torches."
		""
		"&7Free lighting is free lighting, don't judge."
	]
	quest.1A2B3C4D5E6F0109.quest_subtitle: "Gross but useful"
	quest.1A2B3C4D5E6F0109.title: "&a&lMoonworm Queen"
	quest.1A2B3C4D5E6F010B.quest_desc: [
		"&7The &bPeacock Feather Fan&r."
		""
		"&7Blow your enemies away. Literally. Also works on yourself if you want to jump around like an idiot to avoid fall damage."
	]
	quest.1A2B3C4D5E6F010B.quest_subtitle: "Blow them away"
	quest.1A2B3C4D5E6F010B.title: "&b&lPeacock Fan"
	quest.1A2B3C4D5E6F010D.quest_desc: [
		"&7Because starving to death in a dark labyrinth while a Minotaur laughs at you is bad for morale."
		""
		"&7Craft a &eMaze Map Focus&r to map out the underground. You'll thank me later."
	]
	quest.1A2B3C4D5E6F010D.quest_subtitle: "Anti-lost technology"
	quest.1A2B3C4D5E6F010D.title: "&e&lMaze Map Focus"
	quest.1A2B3C4D5E6F010F.quest_desc: [
		"&7The Hydra is dead, and now you have its &cFiery Blood&r."
		""
		"&7Mix it with iron to make &6Fiery Ingots&r. Weapons and armor made from this will literally set things on fire. Because why not?"
	]
	quest.1A2B3C4D5E6F010F.quest_subtitle: "Hot to the touch"
	quest.1A2B3C4D5E6F010F.title: "&6&lFiery Ingot"
	quest.1A2B3C4D5E6F0111.quest_desc: [
		"&7Shave the Alpha Yeti and wear its fur."
		""
		"&7The &bYeti Armor&r is incredibly warm, protects you from ice magic, and probably smells heavily like wet dog."
	]
	quest.1A2B3C4D5E6F0111.quest_subtitle: "Smells like wet dog"
	quest.1A2B3C4D5E6F0111.title: "&b&lYeti Fur Armor"
	quest.1A2B3C4D5E6F0113.quest_desc: [
		"&7The Ghasts are crying. Collect their tears, mix them with borer essence, and do mad science."
		""
		"&7The resulting &4Carminite&r is used to craft the tower's weird, red-stone-like machinery."
	]
	quest.1A2B3C4D5E6F0113.quest_subtitle: "Weird redstone"
	quest.1A2B3C4D5E6F0113.title: "&4&lCarminite"
	quest.1A2B3C4D5E6F0115.quest_desc: [
		"&7You robbed a troll to get &aMagic Beans&r to plant in special &dUberous Soil&r."
		""
		"&7It's Jack and the Beanstalk, but you're heavily armed and here to commit giant murder."
	]
	quest.1A2B3C4D5E6F0115.quest_subtitle: "Jack's story"
	quest.1A2B3C4D5E6F0115.title: "&a&lMagic Beans"
	quest.1A2B3C4D5E6F7020.quest_desc: ["Base importers too slow? Cable Tiers adds Elite, Ultra, and Creative tiers. Sucks items so fast they &cviolate the speed of light&r."]
	quest.1A2B3C4D5E6F7020.quest_subtitle: "&7Cable Tiers"
	quest.1A2B3C4D5E6F7020.title: "&9&lElite Importer&r"
	quest.1A2B3C4D5E6F7030.quest_desc: ["Vomits items into chests at blinding speeds. Be very careful with this, or you will &ccrash your server&r."]
	quest.1A2B3C4D5E6F7030.quest_subtitle: "&7Cable Tiers"
	quest.1A2B3C4D5E6F7030.title: "&6&lElite Exporter&r"
	quest.1A2B3C4D5E6F7A8B.quest_desc: [
		"A step up from what came before."
		""
		"Craft or obtain the &bFlux Block&r."
		"Another piece of the machine chain. On its own it does little; wired into the rest of your factory it removes one more job you were doing by hand."
		"Part of the &7Flux Networks&r progression."
		"&8Next: Basic Flux Storage."
	]
	quest.1A2B3C4D5E6F7A8B.quest_subtitle: "&7Flux Networks"
	quest.1A2B3C4D5E6F7A8B.title: "&bFlux Block"
	quest.1A2F6ED1A66BFB6A.quest_desc: [
		"Squished apples, leaves, and questionable organic matter."
		""
		"Smells absolutely terrible, but it's the first step to eco-friendly fuel. Greta would be proud."
	]
	quest.1A2F6ED1A66BFB6A.quest_subtitle: "Squished salad"
	quest.1A2F6ED1A66BFB6A.title: "&2&lBiomass&r"
	quest.1A6014882284B54B.quest_desc: ["Curses your enemies. &5Spooky&r."]
	quest.1A6014882284B54B.quest_subtitle: "Bad juju"
	quest.1A6014882284B54B.title: "&5&lGlyph of Hex&r"
	quest.1A646E06D14FB6EF.quest_desc: ["&6Blazing Rod&r. Spicy power transfer. Keeps you warm while you wait for the Orb to finally finish."]
	quest.1A646E06D14FB6EF.title: "&6&lBlazing Energizing Rod&r"
	quest.1A75554FF1B93EA3.quest_desc: [
		"A step up from what came before."
		""
		"Craft or obtain the &eGolden Amber&r."
		"A reward for going where the map gets dangerous. You will not craft your way to this one."
		"Part of the &7The Aether&r progression."
		"&8Next: Enchanted Gravitite."
	]
	quest.1A75554FF1B93EA3.quest_subtitle: "&7The Aether"
	quest.1A75554FF1B93EA3.title: "&eGolden Amber"
	quest.1A87B65B6EA93D12.quest_desc: ["Used for Pressure Chamber walls."]
	quest.1A87B65B6EA93D12.quest_subtitle: "&7PneumaticCraft"
	quest.1A87B65B6EA93D12.title: "&aReinforced Bricks"
	quest.1A883E14FD9CBD26.quest_desc: ["&cInstantly drains&r your tanks before you realize you connected them to the &4wrong machine&r."]
	quest.1A883E14FD9CBD26.quest_subtitle: "Disaster wet noodle"
	quest.1A883E14FD9CBD26.title: "&d&lUltimate Mechanical Pipe&r"
	quest.1A9325ACC69F3C61.quest_desc: [
		"The chapter widens out from here."
		""
		"Craft or obtain the &aInferium Seeds&r."
		"Renewable resource production. Anything you can grow is a resource you never have to go looking for again."
		"Part of the &7Mystical Agriculture&r progression."
		"&8Next: Soulium Dagger."
	]
	quest.1A9325ACC69F3C61.quest_subtitle: "&7Mystical Agriculture"
	quest.1A9325ACC69F3C61.title: "&aInferium Seeds"
	quest.1AC57874480DC8E2.quest_desc: ["The &etiny battery&r. It holds barely enough power to charge your smartphone. Welcome to &cmicrocrafting hell&r."]
	quest.1AC57874480DC8E2.title: "&7&lTiny Capacitor&r"
	quest.1ACB4F8BCF065640.quest_desc: [
		"Lore: Sublimation at its finest. This machine aggressively oxidizes solid matter into a gaseous state."
		""
		"Technical Information: Consumes solid items and turns them into Mekanism Gases."
		""
		"Usage: Essential for turning Sulfur into Sulfur Dioxide, or Uranium into Uranium Oxide."
		""
		"Goal: Craft a Chemical Oxidizer."
		""
		"Tips: Gases require specialized Pressurized Tubes to transport; standard fluid pipes will not work."
		""
		"Trivia: One of the few machines capable of completely destroying a block's physical form into pure gas."
	]
	quest.1ACB4F8BCF065640.quest_subtitle: "&eGaseous Conversion"
	quest.1ACB4F8BCF065640.title: "Chemical Oxidizer"
	quest.1ACBF59904203715.quest_desc: [
		"Because regular diamond blocks are for peasants."
		""
		"Squash them down into a lattice to form the absurdly expensive skeleton of your Crystal Matrix. Shiny, useless on its own, and a massive flex."
	]
	quest.1ACBF59904203715.quest_subtitle: "Aggressively compressed wealth"
	quest.1ACBF59904203715.title: "&b&lDiamond Lattice&r"
	quest.1AE1128F3A8242EE.quest_desc: ["Explore the wonders of Mekanism Science and master its mechanics."]
	quest.1AE1128F3A8242EE.title: "Welcome to Mekanism Science"
	quest.1AF1E4FC4EACE585.quest_desc: ["&b8,192 wind generators&r. Why are you doing this to &cyourself&r?"]
	quest.1AF1E4FC4EACE585.quest_subtitle: "8192x spin"
	quest.1AF1E4FC4EACE585.title: "&b&lCompressed Wind x8192&r"
	quest.1AFCFB6B3C49243B.quest_desc: [
		"Your router needs to hold energy before it can distribute it."
		""
		"Stuff this in so it acts like a tiny, magical battery."
	]
	quest.1AFCFB6B3C49243B.quest_subtitle: "Internal battery"
	quest.1AFCFB6B3C49243B.title: "&e&lEnergy Upgrade&r"
	quest.1B1B1B1B1B1B1B10.quest_desc: [
		"&7Welcome to &cMekanism: More Machine&7!"
		""
		"&7Because someone looked at the base mod and said: 'You know what this needs? More arbitrary single-block machines to completely drain my induction matrix.'"
		""
		"&7Prepare for rolling, stamping, and straight-up ripping off classic IC2 mechanics. Your power grid is going to hate you."
	]
	quest.1B1B1B1B1B1B1B10.quest_subtitle: "&cMore machines, more problems"
	quest.1B1B1B1B1B1B1B10.title: "&bWelcome to More Machine"
	quest.1B1B1B1B1B1B1B11.quest_desc: [
		"&7Have 100,000 dirt blocks? Don't throw them in lava like a savage. Throw them in the &eRecycler&7."
		""
		"&7It destroys your useless items (and accidentally your valuable ones if you aren't careful) to produce &8Scrap&7. Truly, peak environmentalism."
	]
	quest.1B1B1B1B1B1B1B11.quest_subtitle: "&8Trash to treasure"
	quest.1B1B1B1B1B1B1B11.title: "&8Recycling Plant"
	quest.1B1B1B1B1B1B1B12.quest_desc: [
		"&7Use your garbage—sorry, &8Scrap&7—to manufacture &dUU Matter&7."
		""
		"&7Yes, we are stealing mechanics from classic tech mods now. Deal with it. It's purple, it's expensive, and it makes the world go round."
	]
	quest.1B1B1B1B1B1B1B12.quest_subtitle: "&dUniversal Utility"
	quest.1B1B1B1B1B1B1B12.title: "&dScrap \\& UU Matter"
	quest.1B1B1B1B1B1B1B14.quest_desc: [
		"&7Farming is for peasants."
		""
		"&7The &aPlanting Station&7 consumes Nutrient Solution to aggressively force-grow crops. It's fully compatible with Mystical Agriculture, meaning you can finally automate your way out of ever seeing the sun again."
	]
	quest.1B1B1B1B1B1B1B14.quest_subtitle: "&aIndustrial botany"
	quest.1B1B1B1B1B1B1B14.title: "&aPlanting Station"
	quest.1B1B1B1B1B1B1B15.quest_desc: [
		"&7The &eRolling Mill&7 flattens and stretches metals into wires and plates."
		""
		"&7It's basically a rolling pin, but for steel, and it requires enough voltage to fry a small elephant."
	]
	quest.1B1B1B1B1B1B1B15.quest_subtitle: "&eUnder pressure"
	quest.1B1B1B1B1B1B1B15.title: "&eRolling Mill"
	quest.1B1B1B1B1B1B1B16.quest_desc: [
		"&7Because doing one thing at a time is for amateurs."
		""
		"&7Upgrade your Mill into a &eBasic Rolling Mill Factory&7 so you can process three items at once. Keep upgrading it until your base sounds like a commercial jet engine."
	]
	quest.1B1B1B1B1B1B1B16.quest_subtitle: "&aTriple the fun"
	quest.1B1B1B1B1B1B1B16.title: "&aBasic Rolling Mill Factory"
	quest.1B1B1B1B1B1B1B17.quest_desc: [
		"&7The &bLathe&7 spins things until they become other things."
		""
		"&7Very useful for when you need metal rods and your traditional crafting table just isn't industrial and expensive enough."
	]
	quest.1B1B1B1B1B1B1B17.quest_subtitle: "&bSpin right round"
	quest.1B1B1B1B1B1B1B17.title: "&bThe Lathe"
	quest.1B1B1B1B1B1B1B18.quest_desc: [
		"&7The &cStamper&7 uses immense pressure to crush metals into specific shapes, like plates and gears."
		""
		"&7It even has integration with AE2 and Immersive Engineering. Efficiency through hostile technological takeover!"
	]
	quest.1B1B1B1B1B1B1B18.quest_subtitle: "&cHeavy metal press"
	quest.1B1B1B1B1B1B1B18.title: "&cThe Stamper"
	quest.1B1B1B1B1B1B1B19.quest_desc: [
		"&7The base mod didn't let you upgrade the Oxidizer or Dissolution Chamber to factory tiers. This mod fixes that glaring oversight."
		""
		"&7Craft a &eBasic Oxidizing Factory&7. More slots = more speed = more TPS drops."
	]
	quest.1B1B1B1B1B1B1B19.quest_subtitle: "&eChemical escalation"
	quest.1B1B1B1B1B1B1B19.title: "&aBasic Oxidizing Factory"
	quest.1B1D060F6D65B386.quest_desc: [
		"Stores your items, fluids, and other types of data."
		""
		"Insert Storage Disks into this drive to provide storage capacity for your network."
	]
	quest.1B1D060F6D65B386.quest_subtitle: "The son"
	quest.1B1D060F6D65B386.title: "&3&lDisk Drive&r"
	quest.1B2C48C09FA28744.quest_desc: [
		"The bane of your existence."
		""
		"Pass a golden sheet through 3 deployers repeatedly with a 20% chance to just fail and give you garbage instead. Enjoy the suffering."
	]
	quest.1B2C48C09FA28744.quest_subtitle: "Pure pain"
	quest.1B2C48C09FA28744.title: "&e&lPrecision Mechanism&r"
