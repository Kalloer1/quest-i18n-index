	quest.7D13B722EC976F0B.quest_subtitle: "Plant. Harvest. Repeat."
	quest.7D13B722EC976F0B.title: "Slime Seeds"
	quest.7D16801766B9A826.quest_subtitle: "Magical extraction. Strips enchantments off your items and turns them into FE."
	quest.7D1B92B33DE09BF2.quest_desc: [
		"&aCraft a &5Niotic Ender Cell&a."
