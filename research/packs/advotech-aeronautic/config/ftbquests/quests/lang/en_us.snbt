	quest.03589443C99B5F26.quest_subtitle: "Unlimited power"
	quest.03589443C99B5F26.title: "&b&lRitual of Tesla Coil&r"
	quest.03645FA056EAC72B.quest_desc: [
		"Progress here compounds - each tier makes the next one cheaper."
