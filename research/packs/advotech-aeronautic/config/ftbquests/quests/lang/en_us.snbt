	quest.491AF60A04D71EDA.quest_subtitle: "Plant. Harvest. Repeat."
	quest.491AF60A04D71EDA.title: "Nether Quartz Seeds"
	quest.4921F95ACBAD48A4.quest_desc: [
		"&7Cyanite is useless on its own."
		""
		"&aBuild a &9Cyanite Reprocessor&a. Feed it Water,"
		"&aPower, and Cyanite Ingots to slowly convert"
		"&athem into a much more potent fuel."
	]
	quest.4921F95ACBAD48A4.quest_subtitle: "&7Recycling the sludge."
	quest.4921F95ACBAD48A4.title: "&9&lWaste Reprocessing"
	quest.49255CE73D701213.quest_desc: [
		"Rods are the backbone of your tools. A &eRough Rod&r is a basic wooden handle."
		""
