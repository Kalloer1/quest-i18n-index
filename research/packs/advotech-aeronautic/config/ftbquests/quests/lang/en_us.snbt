	quest.7F6DEBE19AE6737F.title: "&aBasic Planting Factory"
	quest.7F6EB6FDDBFFF56D.quest_desc: [
		"&7Converts &clava&7 or burning fuel into &esteady power&7."
		""
		"&7While simple, this large-scale version provides a &bvery reliable&7 base load for your industrial complex. Just don't stand too close to the exhaust."
	]
