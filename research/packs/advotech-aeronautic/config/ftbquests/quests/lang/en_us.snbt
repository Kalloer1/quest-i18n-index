	quest.79B80307681105E4.title: "&6Octadic Capacitor"
	quest.79BAF2E111456412.quest_desc: ["The &8Tome of Scrapping&r will only take off half the &5Enchantments&r, while the &8Tome of Superior Scrapping&r will take every &5Enchantment&r off the Item! \\n\\nBoth of these &8Tomes&r will break the Item in use though. \\n\\nTo &d&lInfuse&r our &8Tome of Scrapping&r into a &8Tome of Superior Scrapping&r you can use 3 &9Echoing Sculkshelves&r and 15 &7Basic Bookshelves&r.\\n\\nOr, if you want this &8Tome&r on &2&lFrontier&r, you can use 8 &bCrystalline Seashelves&r."]
	quest.79BAF2E111456412.quest_subtitle: "All Enchantments, breaks Item"
	quest.79BAF2E111456412.title: "&8Tome of Superior Scrapping"
	quest.79C213155CC4A2F3.quest_desc: ["More integration armor that makes you literally unkillable. The balance of this modpack is officially &clong gone&r."]
	quest.79C213155CC4A2F3.quest_subtitle: "God pajamas"
	quest.79C213155CC4A2F3.title: "&a&lVibranium Mage Leggings&r"
