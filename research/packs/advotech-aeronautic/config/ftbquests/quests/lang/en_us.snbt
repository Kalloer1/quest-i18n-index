	quest.3B2A000000000060.quest_desc: [
		"&7Tired of clicking every dropped item?"
		""
		"&aInstall a &2Pickup Upgrade&a into your backpack."
		"&aIt will automatically collect items from the"
		"&aground that match your configured filter."
		""
		"&bHow to install: &7Open the backpack,"
		"&7go to the Upgrades tab and slot it in."
	]
	quest.3B2A000000000060.title: "&a&lHands-Free Harvesting"
	quest.3B2A000000000070.quest_desc: [
		"&7A full backpack is a problem. A Void Upgrade"
		"&7makes it someone else's problem."
		""
		"&aThe &dVoid Upgrade&a automatically destroys"
		"&aany configured items before they can clog"
		"&ayour precious storage. Never stop mining."
		""
		"&cCaution: &7Voided items are gone &lforever&r&7."
	]
	quest.3B2A000000000070.title: "&d&lVoid the Excess"
	quest.3B2A000000000080.quest_desc: [
		"&7Why store one stack when you can store four?"
		""
		"&aThe &6Stack Upgrade&a compresses multiple stacks"
		"&aof the same item into a single slot,"
		"&adrastically multiplying your effective capacity."
		""
		"&eAdvanced variant: &7stores up to &l4x &ras many items"
		"&7per slot. Essential for bulk resource gathering."
	]
	quest.3B2A000000000080.title: "&6&lStack It High"
	quest.3B2A000000000090.quest_desc: [
		"&5&lMastery achieved."
		""
		"&7You have walked the full path — from a simple"
		"&7leather pack to the pinnacle of portable storage."
		""
		"&aYour &8Netherite Backpack&a now carries:"
		"&2✔ &7Automatic item pickup"
		"&2✔ &7Void filtering for unwanted drops"
		"&2✔ &7Compressed stacks for maximum efficiency"
		""
		"&8&o\"You no longer carry a bag."
		"&8&oYou carry a legend.\""
	]
	quest.3B2A000000000090.title: "&5&lThe Perfect Pack"
