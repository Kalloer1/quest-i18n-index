	quest.106CD28EDCB92971.title: "&5&lRitual of Scrying&r"
	quest.107B1267ABFB6918.quest_desc: ["&e16k Storage&r. You start to question your life choices as you wait for the furnace to finish baking processors."]
	quest.107B1267ABFB6918.quest_subtitle: "&7Refined Storage"
	quest.107B1267ABFB6918.title: "&e&l16k Storage Part&r"
