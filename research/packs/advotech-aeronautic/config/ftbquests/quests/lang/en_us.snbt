	quest.1288EFF99CED0223.quest_desc: [
		"Lore: High-Density Polyethylene. A robust, synthesized polymer used in advanced crafting."
		""
		"Technical Information: The PRC produces Substrate. Reacting Substrate, Ethylene, and Oxygen in another PRC makes HDPE Pellets."
		""
		"Usage: Melted into sheets for the MekaSuit, advanced machines, and specialized upgrades."
		""
		"Goal: Craft HDPE Pellets."
		""
		"Tips: This chain requires a dedicated setup. You will need a Crusher, Electrolytic Separator, and two PRCs running continuously."
		""
		"Trivia: HDPE is a real-world plastic commonly used in milk jugs and hard hats!"
	]
	quest.1288EFF99CED0223.quest_subtitle: "&bPlastic Production"
	quest.1288EFF99CED0223.title: "HDPE Plastic"
