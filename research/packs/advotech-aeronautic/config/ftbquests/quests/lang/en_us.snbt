	quest.42CD3779B974D898.quest_desc: [
		"Lore: Smart cabling capable of instantly adapting its voltage and format to any connected machine."
		""
		"Technical Information: Transfers FE. Networks calculate their total transfer capacity based on the number of cables connected."
		""
		"Usage: String these between generators and machines to distribute power."
		""
		"Goal: Craft 16 Basic Universal Cables."
		""
		"Tips: Upgrade to Advanced and Elite cables as soon as possible, as basic cables will bottleneck mid-game factories."
		""
		"Trivia: 'Universal' meant it used to convert between IC2 EU, Thermal RF, and Buildcraft MJ automatically!"
	]
