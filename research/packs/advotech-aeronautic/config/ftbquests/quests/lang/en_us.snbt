	quest.142082E770159330.quest_desc: [
		"Lore: Welcome to the future of industrial engineering. Mekanism offers unparalleled power generation, ore processing, and machinery."
		""
		"Technical Information: This chapter guides you from early game ore processing to the precipice of nuclear technology."
		""
		"Usage: Follow the dependency lines. Craft the required items to unlock subsequent technologies."
		""
		"Goal: Begin your journey into Mekanism."
		""
		"Tips: Pin recipes in your inventory screen; you will be crafting a lot of intermediate components."
		""
		"Trivia: Mekanism has been a staple of modded Minecraft since its original release in 1.5.2!"
	]
	quest.142082E770159330.quest_subtitle: "&bWelcome to Mekanism"
	quest.142082E770159330.title: "Welcome to Mekanism"
	quest.142B5B455E6AEE54.quest_desc: [
		"Lore: The first step in massive resource multiplication. It breaks down raw ores into concentrated dusts."
		""
		"Technical Information: Yields 2 Dusts per Raw Ore, acting as a standard 2x multiplier."
		""
		"Usage: Also used to compress Redstone, Coal, Diamond, and Obsidian into Enriched versions, extending Infuser fuel by 8x."
		""
		"Goal: Craft an Enrichment Chamber."
		""
		"Tips: Never use raw dusts in an Infuser! Always run them through this machine first to save massive amounts of resources."
		""
		"Trivia: The Enrichment Chamber is arguably the most important efficiency block in the early game."
	]
	quest.142B5B455E6AEE54.quest_subtitle: "&6Ore Enrichment"
	quest.142B5B455E6AEE54.title: "Enrichment Chamber"
