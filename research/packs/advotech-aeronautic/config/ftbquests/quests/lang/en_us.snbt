	quest.7FC04D2949744194.quest_desc: [
		"Steady progress. This one is not glamorous, but the chapter does not work without it."
		""
		"Craft or obtain the &bMycelial Rocket&r."
		"Another piece of the machine chain. On its own it does little; wired into the rest of your factory it removes one more job you were doing by hand."
		"Part of the &7Industrial Foregoing&r progression."
		"&8A side branch. Optional, but rarely a waste of time."
	]
	quest.7FC04D2949744194.quest_subtitle: "&7Industrial Foregoing"
	quest.7FC04D2949744194.title: "&bMycelial Rocket"
	quest.7FCDF94BF90515DF.quest_desc: ["Time to grind some &6Blaze Rods&r. As always in tech mods, &cfire and red&r just mean &a+1 to machine tier&r and an excuse to visit the &4Nether&r."]
	quest.7FCDF94BF90515DF.title: "&6&lBlazing Crystal&r"
	quest.7FD9674A0D2735F9.quest_desc: ["Holds 14 spells. Because 13 just wasn't enough to satisfy your &emegalomania&r."]
	quest.7FD9674A0D2735F9.quest_subtitle: "Green cheese"
	quest.7FD9674A0D2735F9.title: "&a&lVibranium Spell Book&r"
	quest.7FD97F436D4EC853.quest_desc: ["A portable crafting table, but you have to chant a spell to use it. &bInnovation&r."]
	quest.7FD97F436D4EC853.quest_subtitle: "Pocket workbench"
	quest.7FD97F436D4EC853.title: "&6&lGlyph of Craft&r"
	quest.7FEDD8735FEF2B65.quest_desc: [
		"&aBuild the ultimate &4Nitro Reactor&a."
		"&7This multiblock is the single most powerful"
		"&7power source in all of Powah."
		""
		"&7Stack Uraninite. Feed it Dry Ice."
		"&7Watch the FE counter explode."
		""
		"&4WARNING: Ensure your Energy Cells and cables"
		"&4can handle the output, or power will be wasted."
		""
		"&eYou are now a nuclear power engineer."
	]
	quest.7FEDD8735FEF2B65.quest_subtitle: "&4&lGodlike fission output."
	quest.7FEDD8735FEF2B65.title: "&4&lNuclear Power — Nitro"
	quest.808BF2FA2919C4C5.quest_desc: ["&7&bAzure Silver&7 shines with magical affinity - great for &denchant-heavy&7 gear."]
