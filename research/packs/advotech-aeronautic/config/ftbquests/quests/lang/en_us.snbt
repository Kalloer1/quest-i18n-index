	]
	quest.03EE5E17084CE8FB.title: "&5Duratium"
	quest.0416230C130FB573.quest_desc: [
		"Lore: The ultimate chemical reactor. The PRC forces solid matter, liquids, and gases into extreme reactions."
		""
		"Technical Information: Accepts one fluid, one gas, and one solid item to produce a new gas and a solid byproduct."
		""
		"Usage: Essential for producing Ethylene (Bio Fuel + Water + Hydrogen) and HDPE plastic."
		""
		"Goal: Craft a Pressurized Reaction Chamber (PRC)."
		""
		"Tips: Piping into this machine can be tricky due to the three different input types. Use the Configurator to assign exact sides."
		""
		"Trivia: Because of its complex IO, mastering the PRC is considered a rite of passage for Mekanism players."
	]
	quest.0416230C130FB573.quest_subtitle: "&eAdvanced Reactions"
	quest.0416230C130FB573.title: "Pressurized Reaction Chamber"
	quest.041A1C64A8468087.quest_desc: [
		"This is where the chapter begins."
		""
		"Earn the &6Find Heavenly Rider&r advancement. It marks a genuine change in what you are able to do, not just another item in a chest."
		"&8The end of this branch."
	]
	quest.041A1C64A8468087.quest_subtitle: "&7The first step"
	quest.041A1C64A8468087.title: "&6Find Heavenly Rider"
	quest.0435E1B1C2288B95.quest_desc: ["consumes water and superheated coolant to output coolant and steam"]
	quest.0435E1B1C2288B95.quest_subtitle: "dont screw a tap on"
	quest.0435E1B1C2288B95.title: "Boilin' hot"
	quest.045470427E2FB572.quest_desc: ["The sweet nectar of modern transit. Perfect for fueling your smaller vehicles, or making a really, really big bonfire."]
	quest.045470427E2FB572.quest_subtitle: "Smells like freedom and speed."
	quest.045470427E2FB572.title: "&e&lGasoline&r"
	quest.046DA1A8A5FBA924.quest_desc: [
		"Lore: A clean, efficient electric furnace. It eliminates the need for solid fuel in standard smelting operations."
		""
		"Technical Information: Smelts items at the cost of FE. Can be upgraded with Speed and Energy upgrades."
		""
		"Usage: Acts as your primary bulk furnace when upgraded into a Factory."
		""
		"Goal: Craft an Energized Smelter."
		""
		"Tips: A fully upgraded Elite Smelting Factory processes 7 items concurrently at blinding speeds."
		""
		"Trivia: The Smelter's glowing orange aesthetic has barely changed since its inception, retaining its iconic look."
	]
	quest.046DA1A8A5FBA924.quest_subtitle: "&cElectric Smelting"
	quest.046DA1A8A5FBA924.title: "Energized Smelter"
	quest.047D225BAF5AC671.title: "Advanced Mechanics"
	quest.048CF4AA486A0D77.title: "&6The Old Powers Fall"
