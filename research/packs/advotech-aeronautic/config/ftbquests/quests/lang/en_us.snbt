	quest.3CAD2FD4978A94A3.quest_subtitle: "&7Refined Storage"
	quest.3CAD2FD4978A94A3.title: "&a&lConstructor&r"
	quest.3CE25C8FA0DFBC98.quest_desc: [
		"Steady progress. This one is not glamorous, but the chapter does not work without it."
		""
		"Craft or obtain the &5Aureal Bottle&r."
		"Slow, ritualistic magic. The pacing is deliberate and the payoffs are worth waiting for."
		"Part of the &7Forbidden & Arcanus&r progression."
		"&8Next: Deorum Ingot, Golden Orchid Seeds."
	]
	quest.3CE25C8FA0DFBC98.quest_subtitle: "&7Forbidden & Arcanus"
