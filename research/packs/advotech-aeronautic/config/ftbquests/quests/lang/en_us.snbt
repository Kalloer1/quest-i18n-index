	quest.4A984FABD408EF8B.title: "&6&lRitual Brazier&r"
	quest.4A9FD155008DE9DA.quest_desc: ["A tiny &ezap&r. Barely enough to charge a smartphone, let alone kill a creeper."]
	quest.4A9FD155008DE9DA.quest_subtitle: "Static electricity"
	quest.4A9FD155008DE9DA.title: "&e&lGlyph of Spark&r"
