	quest.0000000000000002.quest_desc: [
		"Welcome to &6AdvoTech: Aeronautic&r."
		"This book is your map through the pack. Every chapter is a mod or a theme, and every quest is a step that unlocks the next one."
		"You do not have to follow it in order - progression is flexible - but the chapters are laid out roughly in the order they become useful."
		"Take a minute to read this first section. It covers the handful of things that make the rest of the pack far less painful."
		"&8Next: the basics of surviving your first night."
	]
	quest.0000000000000002.quest_subtitle: "&7Where this chapter begins"
	quest.0000000000000002.title: "&6Welcome"
	quest.0000000000000005.quest_desc: [
		"The usual rules apply, with sharper teeth."
		"Gather wood, make tools, build a shelter and get through the first night. Nothing in this pack changes that."
		"What does change is what comes after: within a few in-game days you should be looking at &aMystical Agriculture&r, &bCreate&r, or an early &bPowah&r generator rather than a stone pickaxe."
		"Do not over-invest in vanilla gear. It gets replaced quickly."
		"&8Next: securing the land you build on."
	]
	quest.0000000000000005.quest_subtitle: "&7Building on what you have"
	quest.0000000000000005.title: "&6Your First Night"
	quest.0000000000000008.quest_desc: [
		"Claim your base before you build it."
		"Open the map with &eM&r and claim the chunks you are working in. Claimed chunks are protected from other players, and it costs you nothing."
		"On a server this is the single most important thing you can do in your first hour."
		"&8Next: getting back to your base reliably."
	]
	quest.0000000000000008.quest_subtitle: "&7The next tier"
	quest.0000000000000008.title: "&6Claiming Your Land"
	quest.000000000000000B.quest_desc: [
		"Set a home waypoint now, not after you get lost."
		"The map mod lets you drop waypoints anywhere. Mark your base, mark any structure you intend to come back to, and mark the entrance to every dimension portal you build."
		"Later chapters send you to the Twilight Forest, the Aether, the Undergarden and the Otherside. Waypoints are what keep that from becoming a chore."
		"&8Next: how this book actually works."
	]
	quest.000000000000000B.quest_subtitle: "&7Building on what you have"
	quest.000000000000000B.title: "&6Finding Your Way Home"
	quest.000000000000000E.quest_desc: [
		"This book is not just a checklist."
		"Every quest has a description explaining what the item does and where it fits. Hover any task to see what is required; click a completed quest to claim its reward."
		"Quests never expire and the book is never mandatory - it is a guided tour, not a rail."
		"&8Next: playing with other people."
	]
	quest.000000000000000E.quest_subtitle: "&7Progress, compounded"
	quest.000000000000000E.title: "&6The Quest Book"
	quest.0000000000000011.quest_desc: [
		"Quest progress is shared per team."
		"If you are playing with others, form a team. Everyone on it shares quest completion, so you can split the work across mods instead of duplicating it."
		"Rewards are still claimed individually."
		"&8Next: keeping your machines running while you are away."
	]
	quest.0000000000000011.quest_subtitle: "&7One step further"
	quest.0000000000000011.title: "&6Teams and Sharing"
	quest.0000000000000E01.quest_desc: [
		"Relics are powerful artifacts found in chests or crafted."
		""
		"The &dResearching Table&r is essential. It allows you to appraise unidentifiable relics and grind them down for experience points to level up your gear."
	]
	quest.0000000000000E01.title: "Relic Research"
	quest.0000000000000E11.quest_desc: [
		"Gotta go fast!"
		""
		"&6Roller Skates&r increase speed on land."
		"&6Ice Skates&r grant incredible speed on ice."
	]
	quest.0000000000000E11.title: "Speed Demons"
	quest.0000000000000E21.quest_desc: [
		"Master the elements beneath your feet."
		""
		"&cMagma Walker&r: Walk on lava and fire resistance."
		"&bAqua Walker&r: Walk on water and swim faster."
	]
	quest.0000000000000E21.title: "Surface Tension"
	quest.0000000000000E31.quest_desc: [
		"The ultimate footwear."
		""
		"Combines the effects of Magma and Aqua Walkers. You can walk on any fluid!"
	]
	quest.0000000000000E31.title: "Amphibian Boot"
	quest.0000000000000E41.quest_desc: [
		"Hit them harder."
		""
		"&cRage Glove&r: Increases damage as your health gets lower."
		"&bIce Breaker&r: Deals massive damage to frozen enemies."
	]
	quest.0000000000000E41.title: "Melee Mastery"
	quest.0000000000000E51.quest_desc: [
		"Ranged destruction."
		""
		"&eShadow Glaive&r: A boomerang-like throwing weapon."
	]
	quest.0000000000000E51.title: "Thrown Weapons"
	quest.0000000000000E61.quest_desc: [
		"Extra pockets."
		""
		"&6Leather Belt&r provides extra belt slots."
		"&2Hunter's Belt&r gives bonuses when killing mobs."
	]
	quest.0000000000000E61.title: "Belts"
	quest.0000000000000E71.quest_desc: [
		"Tools for survival."
		""
		"&bMagic Mirror&r: Teleports you to spawn/bed (like Terraria!)."
		"&2Spore Sack&r: Releases spores to damage enemies."
		"&6Arrow Quiver&r: Holds your arrows."
	]
	quest.0000000000000E71.title: "Adventurer's Kit"
	quest.0000000000000E81.quest_desc: [
		"Defensive artifacts."
		""
		"&bReflection Necklace&r: Reflects damage back to the attacker."
	]
	quest.0000000000000E81.title: "Shielding"
	quest.0000000000000E91.quest_desc: ["Mysterious powers."]
	quest.0000000000000E91.title: "Arcane Artifacts"
	quest.0000000000000EA1.quest_desc: [
		"Wait, where am I?"
		""
		"The &5Spatial Sign&r allows you to mark a location and teleport to it later. Very handy."
	]
	quest.0000000000000EA1.title: "Mark and Recall"
	quest.0000000000000FA1.quest_desc: [
		"Magic is hidden everywhere, even in the rocks."
		""
		"Arcane Crystal Ore can be found deep underground. You will need a lot of this dust to craft magical components and runes."
	]
	quest.0000000000000FA1.title: "Arcane Beginnings"
	quest.0000000000000FB1.quest_desc: [
		"Dark, sturdy wood found in the magical forests."
		""
		"It is essential for crafting the Hephaestus Forge and other magical structures. If you find a tree, chop it down (respectfully)."
	]
	quest.0000000000000FB1.title: "Edelwood"
	quest.0000000000000FC1.quest_desc: [
		"Runes are components used in rituals."
		""
		"You can craft them or find them in the world. The &5Rune&r is the base for all others."
	]
	quest.0000000000000FC1.title: "Runecrafting"
	quest.0000000000000FD1.quest_desc: [
		"The heart of this mod."
		""
		"The &4Hephaestus Forge&r allows you to perform powerful rituals. To use it, you must place it down and create a specific multiblock structure (place Chiseled Arcane Polished Darkstone underneath)."
		""
		"It requires 4 types of energy: &cBlood&r, &bAureal&r, &5Souls&r, and &aExperience&r."
	]
	quest.0000000000000FD1.title: "The Forge of Gods"
	quest.0000000000000FE1.quest_desc: [
		"This mysterious dust is used to activate the Forge and transform items."
		""
		"Right-click the Hephaestus Forge with this dust to finalize a ritual."
	]
	quest.0000000000000FE1.title: "Magic Gunpowder"
	quest.0000000000000FF1.quest_desc: [
		"One of the inputs for the Forge."
		""
		"You can collect blood by... well, hurting things near the Test Tube."
	]
	quest.0000000000000FF1.title: "Blood Sacrifice"
	quest.0000000000001001.quest_desc: [
		"Aureal is the energy of nature and cold."
		""
		"Find Aureal plants in the world and capture their essence in a bottle."
	]
	quest.0000000000001001.title: "Essence of Cold"
	quest.0000000000001011.quest_desc: [
		"Souls are trapped within Soulless Sand."
		""
		"Use a &6Soul Extractor&r on Soul Sand to obtain souls."
	]
	quest.0000000000001011.title: "Soul Harvester"
	quest.0000000000001021.quest_desc: [
		"Experience can be stored in the Xpetrified Orb."
		""
		"It is a solid form of XP, perfect for fueling your rituals."
	]
	quest.0000000000001021.title: "Solid XP"
	quest.0000000000001031.quest_desc: [
		"A dark, dense matter created in the Forge."
		""
		"It is heavy, slightly evil, and very useful for high-tier crafting."
	]
	quest.0000000000001031.title: "Dark Matter"
	quest.0000000000001041.quest_desc: [
		"An alloy of gold and magic."
		""
		"Deorum Ingots are used to craft golden magical tools and items."
	]
	quest.0000000000001041.title: "Golden Magic"
	quest.0000000000001051.quest_desc: [
		"The highest tier of metal known to Arcanus."
		""
		"Draco Arcanus is forged from Dark Matter and Dragon scales. It is incredibly durable."
	]
	quest.0000000000001051.title: "Draco Arcanus"
	quest.0000000000001061.quest_desc: [
		"The ultimate artifact."
		""
		"The Eternal Stella can make ANY item completely unbreakable. Repair it fully, combine it with the Stella in a Smithing Table, and never worry about durability again."
	]
	quest.0000000000001061.title: "Eternal Indestructibility"
	quest.0000000000001071.quest_desc: [
		"See the unseen."
		""
		"This amulet allows you to see spectral entities and hidden mana currents."
	]
	quest.0000000000001071.title: "Ghost Vision"
	quest.00000000000E10A1.quest_desc: [
		"&7Light Bedrock on fire using Flint and Steel to obtain &dGrains of Infinity&7."
		""
		"&eThis is the foundational material for all Ender IO technology."
	]
	quest.00000000000E10A1.title: "&dBeginning of Infinity"
	quest.00000000000E10A2.quest_desc: [
		"&7The &aBasic Capacitor&7 is an essential crafting component."
		""
		"&7It is required to build simple machines and acts as a basic upgrade."
	]
	quest.00000000000E10A2.title: "&aBasic Capacitor"
	quest.00000000000E10A3.quest_desc: ["&7The core framework for early-game Ender IO machinery."]
	quest.00000000000E10A3.title: "&7Void Chassis"
	quest.00000000000E10A4.quest_desc: ["&7A standard machine used to blend different metals and materials together."]
	quest.00000000000E10A4.title: "&cAlloy Smelter"
	quest.00000000000E10A5.quest_desc: [
		"&7Grinds down ores and items into dusts."
		""
		"&bPro Tip: &7Add Grinding Balls to increase your yield and get bonus outputs!"
	]
	quest.00000000000E10A5.title: "&9SAG Mill"
	quest.00000000000E10A6.quest_desc: ["&7Generates Redstone Flux (Energy) by burning solid fuels like Coal or Wood."]
	quest.00000000000E10A6.title: "&6Stirling Generator"
	quest.00000000000E10A7.quest_desc: ["&7Store your fluids safely in this multiblock-capable tank."]
	quest.00000000000E10A7.title: "&bFluid Tank"
	quest.00000000000E10A8.quest_desc: ["&7Sucks up nearby dropped items automatically."]
	quest.00000000000E10A8.title: "&6Vacuum Chest"
	quest.00000000000E10B1.quest_desc: [
		"&7Alloyed from Iron and Redstone."
		""
		"&7Used mainly for basic power conduits and electrical components."
	]
	quest.00000000000E10B1.title: "&fConductive Alloy"
	quest.00000000000E10B3.quest_desc: ["&7A tough alloy made from Iron, Coal Dust, and Obsidian."]
	quest.00000000000E10B3.title: "&8Dark Steel"
	quest.00000000000E10B4.quest_desc: ["&7A highly conductive alloy made of Redstone and Silicon."]
	quest.00000000000E10B4.title: "&cRedstone Alloy"
	quest.00000000000E10B5.quest_desc: [
		"&7Created by infusing Gold with Redstone and Glowstone."
		""
		"&7Used for advanced power transfer and vibrant upgrades."
	]
	quest.00000000000E10B5.title: "&6Energetic Alloy"
	quest.00000000000E10C1.quest_desc: ["&7Conduit Binder is the core component for crafting all conduits."]
	quest.00000000000E10C1.title: "&3Conduit Mastery"
	quest.00000000000E10C2.quest_desc: ["&7The upgraded chassis for more advanced Ender IO machines."]
	quest.00000000000E10C2.title: "&8Industrial Chassis"
	quest.00000000000E10C3.quest_desc: [
