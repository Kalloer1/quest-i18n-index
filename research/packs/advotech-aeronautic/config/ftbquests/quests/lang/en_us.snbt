	quest.4A2DE5EB39999369.quest_desc: [
		"This is where the chapter stops being introductory."
		""
		"Craft or obtain the &aImperium Essence&r."
		"Renewable resource production. Anything you can grow is a resource you never have to go looking for again."
		"Part of the &7Mystical Agriculture&r progression."
		"&8Nothing further depends on this - build it when you want it, not because you have to."
	]
	quest.4A2DE5EB39999369.quest_subtitle: "&7Mystical Agriculture"
	quest.4A2DE5EB39999369.title: "&aImperium Essence"
	quest.4A36248B0C2C4AEF.quest_desc: [
		"&6A milestone.&r"
		""
		"Craft or obtain the &6Hopper Botany Pot&r."
		"Renewable resource production. Anything you can grow is a resource you never have to go looking for again."
		"Part of the &7Botany Pots&r progression."
		"&8A side branch. Optional, but rarely a waste of time."
	]
	quest.4A36248B0C2C4AEF.quest_subtitle: "&7Botany Pots"
	quest.4A36248B0C2C4AEF.title: "&6Hopper Botany Pot"
	quest.4A38E6CA4CEFA19C.quest_desc: [
		"Worth doing properly the first time - reworking this later is tedious."
		""
		"Craft or obtain the &aFroststeel Ingot&r."
		"A crafting intermediate. Boring on its own, essential in volume - automate production before the recipes that need it pile up."
		"Part of the &7The Undergarden&r progression. This is the tier most setups settle on before pushing further."
		"&8Next: Utherium Crystal, Cloggrum Pickaxe."
	]
	quest.4A38E6CA4CEFA19C.quest_subtitle: "&7The Undergarden"
	quest.4A38E6CA4CEFA19C.title: "&aFroststeel Ingot"
	quest.4A5B6C7D8E9F0D1E.quest_desc: [
		"&6This is the one worth building towards.&r"
		""
		"Craft or obtain the &6Gargantuan Flux Storage&r."
		"Another piece of the machine chain. On its own it does little; wired into the rest of your factory it removes one more job you were doing by hand."
		"Part of the &7Flux Networks&r progression."
		"&8The end of this branch."
	]
	quest.4A5B6C7D8E9F0D1E.quest_subtitle: "&7Flux Networks"
	quest.4A5B6C7D8E9F0D1E.title: "&6Gargantuan Flux Storage"
	quest.4A8F00FC61BC6121.quest_desc: ["For the &9Echoing&r upgrade we'll need a few different Items. \\n\\nCandles which are relatively easy to get! And &9Echo Shards&r... which definitely aren't... \\n\\nThe best chance at getting them is by Looting an &6Ancient City&r, but you can Craft them with a few different Rituals. \\n\\n(Or even later on with &5Enchanting&r!) \\n\\nThe &9Echoing Deepshelves&r will give a whole lot more &5Arcana&r at &515%&r! Along with raising the max &aEterna&r to &a75&r."]
	quest.4A8F00FC61BC6121.title: "&9Echoing Deepshelf"
	quest.4A9002F6CAAC8781.quest_desc: [
		"&7Mix Calcium Oxide Dust, Sand, Lead Dust, and Water Vapor."
		""
		"&7Makes concrete that actually withstands explosions, complete with slabs and stairs. Perfect for containing your inevitably exploding reactors. Brutalism at its finest."
	]
	quest.4A9002F6CAAC8781.quest_subtitle: "Brutalism at its finest"
	quest.4A9002F6CAAC8781.title: "&8&lHigh-Quality Concrete&r"
	quest.4A965C944F051570.quest_desc: ["Explore the wonders of Hexerei and master its mechanics."]
	quest.4A965C944F051570.title: "Welcome to Hexerei"
	quest.4A984FABD408EF8B.quest_desc: ["The &5Ritual Brazier&r is used to perform large-scale environmental magic. Right-click it with a Ritual Tablet to begin!"]
