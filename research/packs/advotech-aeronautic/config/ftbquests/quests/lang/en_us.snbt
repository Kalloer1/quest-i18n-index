	quest.1000000000000042.quest_subtitle: "&7Sixty-four generators, one block"
	quest.1000000000000042.title: "&6Netherite Generator (64x)"
	quest.1000000000000043.quest_desc: [
		"&6&lThe final tier.&r"
		"The &6Nether Star Generator&r consumes Nether Stars and returns astronomical amounts of Forge Energy - enough to power Draconic Evolution, Mekanism's fusion tier, or an Avaritia crafting setup."
		"Feeding it is the real challenge. A single generator will chew through stars faster than a hand-built Wither cage can supply them, so &cindustrial-scale automation&r is mandatory."
		"Combine a Wither farm with Mystical Agriculture essence farming for a fully renewable supply."
		"&8Complete the 8x and 64x variants to finish this chapter."
	]
	quest.1000000000000043.quest_subtitle: "&6&lThe endgame of Generator Galore"
	quest.1000000000000043.title: "&6Nether Star Generator"
	quest.1000000000000044.quest_desc: [
