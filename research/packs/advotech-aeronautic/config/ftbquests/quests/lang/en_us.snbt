	quest.49F6A9E575A86963.title: "&7&l1k Storage Part&r"
	quest.4A00000000000001.quest_desc: [
		"&8Black Quartz&r is the core material of Actually Additions."
		""
		"You can find it generating as an ore in the world. Mine plenty of it, as almost every machine and tool requires it."
	]
	quest.4A00000000000001.quest_subtitle: "&7The dark foundation"
	quest.4A00000000000001.title: "&8Black Quartz"
	quest.4A00000000000002.quest_desc: [
		"Before you can transmute items, you need Crystal Flux (CF), which is compatible with standard FE/RF."
		""
		"The &8Coal Generator&r is a great starting point for generating power."
	]
	quest.4A00000000000002.quest_subtitle: "&7Basic CF Generation"
	quest.4A00000000000002.title: "&8Coal Generator"
	quest.4A00000000000003.quest_desc: [
		"The &cAtomic Reconstructor&r fires a laser beam that transmutes blocks and items dropped in front of it."
		""
		"It requires a steady supply of CF (power) to operate."
	]
	quest.4A00000000000003.quest_subtitle: "&7Zap items into better ones!"
	quest.4A00000000000003.title: "&cAtomic Reconstructor"
	quest.4A00000000000005.quest_desc: [
		"By dropping standard resources in front of the Atomic Reconstructor, you create specialized crystals:"
		""
		"• Redstone -> Restonia"
		"• Iron -> Enori"
		"• Lapis -> Palis"
		"• Coal -> Void"
		"• Diamond -> Diamatine"
		"• Emerald -> Emeradic"
	]
	quest.4A00000000000005.quest_subtitle: "&7Infused with raw power"
	quest.4A00000000000005.title: "&bReconstructed Crystals"
	quest.4A00000000000006.quest_desc: [
		"&eLaser Relays&r transfer CF/RF wirelessly across your base."
		""
		"You must use a &cLaser Wrench&r to link them together. Right-click the first relay, then the second."
	]
	quest.4A00000000000006.quest_subtitle: "&7Wireless power transfer"
	quest.4A00000000000006.title: "&eEnergy Laser Relays"
	quest.4A00000000000007.quest_desc: [
		"The &dEmpowerer&r is a multi-block crafting station."
		""
		"Place the Empowerer in the center, and 4 &aDisplay Stands&r exactly 2 blocks away from it on each side (North, South, East, West)."
		"All 5 blocks must be powered!"
	]
	quest.4A00000000000007.quest_subtitle: "&7True potential unlocked"
	quest.4A00000000000007.title: "&dThe Empowerer"
	quest.4A00000000000008.quest_desc: [
		"Place a base crystal on the Empowerer, and the required ingredients on the 4 Display Stands."
		""
		"It will draw a massive amount of power to craft the Empowered version, which is used for the mod's highest tier machines."
	]
	quest.4A00000000000008.quest_subtitle: "&7Pulsing with energy"
	quest.4A00000000000008.title: "&5Empowered Crystals"
	quest.4A00000000000010.quest_desc: [
		"Empowered crystals unlock powerful baubles."
		""
		"The &aRing of Magnetizing&r pulls items towards you, while the &2Ring of Growth&r accelerates the growth of nearby crops."
	]
	quest.4A00000000000010.quest_subtitle: "&7Baubles of utility"
	quest.4A00000000000010.title: "&6Rings of Power"
	quest.4A00000000000011.quest_desc: [
		"Canola is a great alternative power source."
		""
		"Grow Canola, then place the seeds/crops in a &aCanola Press&r to extract Canola Oil."
	]
	quest.4A00000000000011.quest_subtitle: "&7Extracting oil"
	quest.4A00000000000011.title: "&aCanola Press"
	quest.4A00000000000012.quest_desc: [
		"Pump the Canola Oil into a &2Fermenting Barrel&r to refine it into Refined Canola Oil."
		""
		"This fluid generates significantly more power when burned in an Oil Generator!"
	]
	quest.4A00000000000012.quest_subtitle: "&7Refining fuel"
	quest.4A00000000000012.title: "&2Fermenting Barrel"
	quest.4A00000000000013.quest_desc: [
		"The &aFarmer&r will automatically plant seeds and harvest mature crops in a large area in front of it."
		""
		"Provide it with power and seeds, and extract the harvested items!"
	]
	quest.4A00000000000013.quest_subtitle: "&7Automated Agriculture"
	quest.4A00000000000013.title: "&aFarmer"
	quest.4A099EA3A896422E.title: "Advanced Mechanics"
	quest.4A0A6DCDBCE017C5.quest_desc: ["&eFlux Compressor&r turns Forge Energy (RF) directly into compressed air."]
