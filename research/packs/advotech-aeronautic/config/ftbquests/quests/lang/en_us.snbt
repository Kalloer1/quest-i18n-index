	quest.1B3831394B1E3F4A.quest_subtitle: "Feather weight"
	quest.1B3831394B1E3F4A.title: "&f&lGlyph of Slowfall&r"
	quest.1B391BC9E9A0404B.quest_desc: ["&aBasic Magmator&r. Drinks lava at a reasonable pace. A true staple of any &cearly-game base&r."]
	quest.1B391BC9E9A0404B.title: "&f&lBasic Magmator&r"
	quest.1B3A326C365D9189.quest_desc: ["More integration armor that makes you literally unkillable. The balance of this modpack is officially &clong gone&r."]
	quest.1B3A326C365D9189.quest_subtitle: "God pajamas"
	quest.1B3A326C365D9189.title: "&e&lAllthemodium Mage Boots&r"
	quest.1B411BDBB23B52DE.quest_desc: [
		"Lore: Wireless energy transference field. Simply standing on it invigorates your armored suits and tools."
		""
		"Technical Information: Charges items in the player's inventory using power from the network it is connected to."
		""
		"Usage: Place it on the ground and connect power to the bottom or sides."
		""
		"Goal: Craft a Chargepad."
		""
		"Tips: Place one right inside the entrance to your base to top up your MekaSuit seamlessly."
		""
		"Trivia: Early versions of Mekanism lacked this, forcing players to manually put items into Energy Cubes."
	]
	quest.1B411BDBB23B52DE.quest_subtitle: "&aStep on it!"
	quest.1B411BDBB23B52DE.title: "Chargepad"
	quest.1B42FD39759C0632.quest_desc: ["Moves &cmore gas&r."]
	quest.1B42FD39759C0632.quest_subtitle: "Faster gas noodle"
	quest.1B42FD39759C0632.title: "&c&lAdvanced Pressurized Tube&r"
