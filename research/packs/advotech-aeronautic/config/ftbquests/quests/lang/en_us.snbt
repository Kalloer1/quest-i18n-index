	quest.39C346A031765BD1.quest_subtitle: "Instant power"
	quest.39C346A031765BD1.title: "&d&lInfinite Provider&r"
	quest.39E7613BF29A0BCA.quest_desc: ["12 slots and it's made from a dragon. PETA is going to &chave a word with you&r."]
	quest.39E7613BF29A0BCA.quest_subtitle: "Scaly"
	quest.39E7613BF29A0BCA.title: "&5&lDragonskin Spell Book&r"
	quest.39F2E7CD172CCD67.quest_desc: [
		"This is where the chapter stops being introductory."
		""
		"Craft or obtain the &bSolar Panel Spirited&r."
		"It draws power from daylight. No fuel logistics, no upkeep, just floor space and a clear view of the sky."
		"Part of the &7Powah&r progression."
		"&8Next: Solar Panel Nitro."
	]
	quest.39F2E7CD172CCD67.quest_subtitle: "&7Powah"
	quest.39F2E7CD172CCD67.title: "&bSolar Panel Spirited"
	quest.39FA825656E9EE69.quest_desc: [
		"The entry point. Nothing else in this chapter unlocks until this is done."
		""
		"Craft or obtain the &6Candelabra&r."
		"Slow, ritualistic magic. The pacing is deliberate and the payoffs are worth waiting for."
		"Part of the &7Hexerei&r progression."
		"&8Next: Willow Log, Candle."
	]
	quest.39FA825656E9EE69.quest_subtitle: "&7Start here"
	quest.39FA825656E9EE69.title: "&6Candelabra"
	quest.3A1F000000000010.quest_desc: [
		"&7Every great journey begins with a single step..."
		"&7and a good bag to carry your supplies."
		""
		"&aCraft your very first &6Backpack&a and never"
		"&awaste an inventory slot again."
		""
		"&8&o\"A wise traveller always packs light —"
		"&8&obut carries much.\""
	]
	quest.3A1F000000000010.title: "&6&lYour First Pack"
	quest.3A1F000000000020.quest_desc: [
		"&7Leather is a fine start, but iron endures."
		""
		"&aUpgrade to an &6Iron Backpack&a to unlock"
		"&aadditional storage rows and item slots."
		""
		"&bTip: &7Backpacks can be upgraded in-place —"
		"&7your items stay inside during the upgrade!"
	]
	quest.3A1F000000000020.title: "&e&lRoom for More"
	quest.3A1F000000000030.quest_desc: [
		"&7Gold — not just for decoration."
		""
		"&aThe &6Gold Backpack&a expands your capacity"
		"&asignificantly. More slots, more possibilities,"
		"&amore adventures ahead."
		""
		"&eDon't forget: &7you can also add &dUpgrade Slots&7"
		"&7to your backpack using the Slot Upgrade item."
	]
	quest.3A1F000000000030.title: "&b&lSlot Mastery"
	quest.3A1F000000000040.quest_desc: [
		"&7Diamonds are forever — and so is your storage."
		""
		"&aThe &b&lDiamond Backpack&a is a marvel of engineering."
		"&aWith massive capacity and full upgrade support,"
		"&ayou are ready for anything the world throws at you."
		""
		"&dTry adding a &5Filter Upgrade&d to keep"
		"&dyour items perfectly organised!"
	]
	quest.3A1F000000000040.title: "&b&lThe Diamond Standard"
	quest.3A3E9F651117B245.quest_desc: ["Nothing survives this machine."]
	quest.3A3E9F651117B245.quest_subtitle: "Ultimate destroyer"
	quest.3A3E9F651117B245.title: "&d&lInfinite Crushing Factory&r"
	quest.3A450F695375EE63.quest_desc: [
		"&aUpgrade to &eNiotic Solar Panels&a."
		"&7A field of these can power an entire megabase"
		"&7during the day. Energy Cells are essential as backup."
	]
	quest.3A450F695375EE63.quest_subtitle: "&7Vast solar farm potential."
	quest.3A450F695375EE63.title: "&e&lSolar Panel — Niotic"
	quest.3A4B5C6D7E8F9CAD.quest_desc: [
		"A natural continuation of the previous step."
		""
		"Craft or obtain the &bHerculean Flux Storage&r."
		"Another piece of the machine chain. On its own it does little; wired into the rest of your factory it removes one more job you were doing by hand."
		"Part of the &7Flux Networks&r progression."
		"&8Next: Gargantuan Flux Storage."
	]
	quest.3A4B5C6D7E8F9CAD.quest_subtitle: "&7Flux Networks"
	quest.3A4B5C6D7E8F9CAD.title: "&bHerculean Flux Storage"
	quest.3A4D5A2C0B73B0D8.quest_desc: ["Forces things to fall. Because apparently they weren't falling &cfast enough&r."]
	quest.3A4D5A2C0B73B0D8.quest_subtitle: "What goes up"
	quest.3A4D5A2C0B73B0D8.title: "&5&lGlyph of Gravity&r"
	quest.3A5AA431A67A1772.title: "Advanced Mechanics"
	quest.3A61E49560915677.quest_desc: ["&7Starter Magmator&r. Sips on lava. Good for the first 10 minutes of your &eNether pump&r setup before you run out of juice."]
	quest.3A61E49560915677.title: "&7&lStarter Magmator&r"
	quest.3A68B38C4082512D.quest_desc: ["12 slots. If you fill all 12, you're officially a &cscroll hoarder&r."]
	quest.3A68B38C4082512D.quest_subtitle: "Fireproof pages"
	quest.3A68B38C4082512D.title: "&8&lNetherite Spell Book&r"
	quest.3A731F425B0224A7.quest_desc: [
		"&7The pinnacle of smithing templates."
		""
		"&aSecure an &dUnobtainium Upgrade Smithing Template&a"
		"&ato complete your armor and tool evolution."
	]
	quest.3A731F425B0224A7.quest_subtitle: "&7The final upgrade path."
	quest.3A731F425B0224A7.title: "&d&lVoid Blueprint"
	quest.3A75E479F7004239.quest_desc: [
		"Progress here compounds - each tier makes the next one cheaper."
		""
		"Craft or obtain the &7Basic Chemical Tank&r."
		"Bulk fluid storage. Buffering fluids is what stops a processing line from stuttering every time upstream production dips."
		"Part of the &7Mekanism&r progression."
		"&8Next: Chemical Infuser."
	]
	quest.3A75E479F7004239.quest_subtitle: "&7Mekanism"
	quest.3A75E479F7004239.title: "&7Basic Chemical Tank"
	quest.3A785B7E53EDD28A.quest_desc: ["uses sun to activate neutrons in chemicals"]
