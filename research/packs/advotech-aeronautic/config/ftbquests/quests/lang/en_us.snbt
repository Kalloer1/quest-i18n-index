	quest.5A00000000000002.quest_subtitle: "&7A step up from wood"
	quest.5A00000000000002.title: "&fIron Fishing Rod"
	quest.5A00000000000003.quest_desc: ["The &eGold Fishing Rod&r has high enchantability, making it easier to get good fishing enchantments."]
	quest.5A00000000000003.quest_subtitle: "&7Shiny and lucky"
	quest.5A00000000000003.title: "&eGold Fishing Rod"
	quest.5A00000000000004.quest_desc: ["Highly durable and very effective. The &bDiamond Fishing Rod&r is what you need to catch the best loot."]
	quest.5A00000000000004.quest_subtitle: "&7Pro Angler"
	quest.5A00000000000004.title: "&bDiamond Fishing Rod"
	quest.5A00000000000005.quest_desc: ["Place compostable items into the &aWorm Farm&r to generate Worms over time."]
	quest.5A00000000000005.quest_subtitle: "&7Sustainable bait"
	quest.5A00000000000005.title: "&aWorm Farm"
	quest.5A00000000000006.quest_desc: ["Equip &cWorms&r in your Tackle Box to increase your chances of catching fish!"]
	quest.5A00000000000006.quest_subtitle: "&7Juicy bait"
	quest.5A00000000000006.title: "&cWorms"
	quest.5A00000000000007.quest_desc: ["Hooks give special properties to your fishing rod. The &fIron Hook&r slightly increases your chance to catch something and reduces the time it takes."]
	quest.5A00000000000007.quest_subtitle: "&7Hook, line, and sinker"
	quest.5A00000000000007.title: "&fIron Hook"
	quest.5A00000000000008.quest_desc: ["The &6Double Hook&r gives you a chance to catch two things at once!"]
	quest.5A00000000000008.quest_subtitle: "&7Two for one"
	quest.5A00000000000008.title: "&6Double Hook"
	quest.5A00000000000009.quest_desc: ["The &8Heavy Hook&r sinks faster and shortens the wait time significantly, but reduces the cast distance."]
	quest.5A00000000000009.quest_subtitle: "&7Deep sea diving"
	quest.5A00000000000009.title: "&8Heavy Hook"
	quest.5A0000000000000A.quest_desc: ["Use a &7Fillet Knife&r in a crafting grid with any fish to turn them into Fish Fillets."]
	quest.5A0000000000000A.quest_subtitle: "&7Preparing the catch"
	quest.5A0000000000000A.title: "&7Fillet Knife"
	quest.5A0000000000000B.quest_desc: ["Fish Fillets can be cooked and eaten, providing a reliable food source from your fishing trips."]
	quest.5A0000000000000B.quest_subtitle: "&7Fresh meat"
	quest.5A0000000000000B.title: "&cFish Fillet"
	quest.5A0000000000000C.quest_desc: ["While fishing, you might occasionally reel in a Lockbox or Treasure Chest. Right-click them to reveal ores, ingots, and sometimes rare loot!"]
	quest.5A0000000000000C.quest_subtitle: "&7Sunken treasures"
	quest.5A0000000000000C.title: "&6Lockbox & Treasure"
	quest.5A0000000000000D.quest_desc: ["The rarest loot you can fish up. Right-click to receive powerful Neptunium gear or ingots!"]
	quest.5A0000000000000D.quest_subtitle: "&7The ultimate catch"
	quest.5A0000000000000D.title: "&3Neptunium Bounty"
	quest.5A0000000000000E.quest_desc: ["&2Neptunium Ingots&r can be used to craft some of the best tools and armor in the game, possessing unique aquatic abilities."]
	quest.5A0000000000000E.quest_subtitle: "&7Forged in the depths"
	quest.5A0000000000000E.title: "&2Neptunium Ingot"
	quest.5A0000000000000F.quest_desc: ["Neptunium Armor grants special underwater benefits, such as water breathing, perfectly clear underwater vision, and increased swim speed."]
	quest.5A0000000000000F.quest_subtitle: "&7Master of the Sea"
	quest.5A0000000000000F.title: "&2Neptunium Armor"
	quest.5A00000000000011.quest_desc: ["Neptunium tools do not suffer the mining speed penalty when used underwater."]
	quest.5A00000000000011.quest_subtitle: "&7Unhindered by water"
	quest.5A00000000000011.title: "&2Neptunium Tools"
	quest.5A00000000000012.quest_desc: ["The pinnacle of fishing technology. The Neptunium Fishing Rod will reel in the best treasures the ocean has to offer."]
	quest.5A00000000000012.quest_subtitle: "&7Legendary Angler"
	quest.5A00000000000012.title: "&2Neptunium Fishing Rod"
