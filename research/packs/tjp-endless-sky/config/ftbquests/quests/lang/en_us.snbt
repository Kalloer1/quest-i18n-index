	quest.7AE0D40C4457C642.quest_desc: ["&e[&f!&e] &fAs same as the Impure White&r or &6Golden&r Chalks, you will have to throw this &5Impure Purple Chalk&r into the &cSpiritfire&r."]
	quest.7AE0D40C4457C642.quest_subtitle: "Possessed by Spirits"
	quest.7AF65DD50D0EDA7A.quest_desc: [
		"The Modular Router is the centre of the system: it has a single buffer slot for items, nine module slots, and five upgrade slots."
		""
		"The Modular Router has a single-slot buffer for items."
	]
	quest.7B430A28ED635F21.quest_desc: ["Breeds animals which are on the block in front of it using food given as an input. The input must be the correct food type (pigs eat carrots, cows eat wheat, etc)."]
	quest.7B8EA4CE1CE07726.quest_desc: ["&e[&f!&e] &fThis will be your Industrial Turbine! Which will generate a mass amount RF!"]
	quest.7BB7198A7612619F.quest_desc: ["Regular upgrade can only filter by item and has 9 filter slots."]
	quest.7D2B3E0BBA1F8066.quest_desc: [
		"This module tries to break a block, adjacent to the router in the module's configured direction."
		""
		"Most blocks are breakable, although anything with an unbreakable hardness can not be broken, nor can any fluid blocks."
		""
		"If the block is broken, its primary drop(s) will be pulled into the item router's buffer."
	]
	quest.7D6FD73235C85237.quest_desc: ["&e[&f!&e] &fAutomatic Hammer"]
	quest.7DC7EBC7138A6C22.quest_desc: ["Regular upgrade works just as furnace would."]
