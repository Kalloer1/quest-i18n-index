	quest.7FF27A2AEAD5A672.quest_desc: [
		"To claim open your map (default key is &cM&r), click the claimed chunks icon on top left corner and then left click a chunk to claim. Right click to unclaim."
		""
		"To create a party click the &cTeam icon&r on top left corner from inventory screen, then add people to your team."
		""
		"To rtp (randomly tp) use &c/trigger darkrtp&r"
		"If you get stuck use &c/trigger darkdeath&r (kills you instantly) or &cdarkspawn&r (will tp you to world spawn)"
		"{@pagebreak}"
		"To view your Pokémon summary use the &cJ&r key"
		""
		"To toggle the Minimap use the &cN&r key (disable minimap for more fps)"
		""
		"To toggle the Pokémon party overlay use the &cO&r key (disable overlay for more fps)"
	]
