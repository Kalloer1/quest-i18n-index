	quest.656FBF5231240143.quest_desc: [
		"No Griefing or stealing from others."
		"PVP without consent is considered griefing and harassment"
		""
		"No Spamming/Full caps messages"
		""
		"No Advertising"
		""
		"No Cursing/No Constant Cursing"
		""
		"No Trolling/Flaming"
		""
		"No Banned Items"
		""
		"Do Not Intentuanly block/break lootr chests"
		"{@pagebreak}"
		"No Asking for OP"
		""
		"Respect all Players"
		""
		"Obey Staff Members"
		""
		"No Racist, Sexist or other discrimitory Remarks"
		""
		"No Hacks (includes any form of x-ray, scripts or macros)"
		""
		"No Builds Near Spawn"
		""
		"Ask before claiming right next to players (leave a few chunks between you both so you can both have space to expand)"
		"{@pagebreak}"
		"No 1x1 Towers"
		""
		"Please only have one or two pasture blocks active at a time (Per Player, if too many are found in an area and are contributing to lag a member of staff may remove it at there discretion)"
		""
		"No malicious targeting of anybody's physical, mental or social conditions verbally or textually"
		""
		"No inappropriate usernames or skins"
		""
		"Any Player, Item, Farm, Claimed Chunk, found to be a cause of severe server lag may be removed by a server admin at their discretion."
		""
		"Dont claim trial chambers, this blocks other players from getting loot and will result in your claim being removed"
		""
		"{@pagebreak}"
		"Please do not try starting cults or religions in the server."
		""
		"No impersonating a staff member, be it using their skin or pretending to be them"
		""
		"Don't use immersive paintings to place NSFW images"
		""
		"NO NSFW/Offensive builds or text (this also means in chat)"
	]
