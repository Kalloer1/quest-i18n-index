{
	"chapters/neo_vitae.snbt": {
		quest.26C7705667EB55E8.quest_subtitle: {
			new: "Beyond the blood"
			old: "Your altar now rivals the power of ancient magic."
		}
		quest.26C7705667EB55E8.title: {
			new: "The Third Circle"
			old: "The Fourth Circle"
		}
		quest.7E88E36EDE4C0BF0.quest_subtitle: {
			new: "The final ascent"
			old: "You are no longer merely a practitioner."
		}
		quest.7E88E36EDE4C0BF0.quest_desc: {
			new: [
				"One final expansion remains."
				""
				"Add the widest ring of &d72 Runes&f, one level below and farther out than the previous circle."
				""
				"With so many rune positions available, you can heavily specialize your altar with &dSpeed&f, &bCapacity&f, &eCharging&f, &cSacrifice&f and other specialized runes."
				""
				"Crown the four pillars with &5Crystal Clusters&f or &5Crystal Cluster Bricks&f."
				""
				"Your Ara Vitae now contains &d172 Runes&f and has reached its maximum construction tier."
			]
			old: ["Expand your &bAra Vitae&r to its fifth tier by adding the required &bRunes&r and &bCapstone Blocks&r, unlocking greater &bVitae&r power and access to the most advanced transmutations and rituals."]
		}
		quest.26C7705667EB55E8.quest_desc: {
			new: [
				"The Ara Vitae demands more than blood now."
				""
				"Add another ring of &d28 Runes&f, one level lower and farther out."
				""
				"More rune positions become available, giving you even greater control over your altar."
				""
				"Place &cBloodstone Bricks&f at the four corners to complete the circle."
				""
				"Your altar now contains &d52 Runes&f."
			]
			old: ["Upgrade your &bAra Vitae&r to its fourth tier by adding the required &bRunes&r and &bCapstones&r, unlocking greater &bVitae&r capacity and access to more powerful blood magic."]
		}
		quest.5A52426AC47A1FE3.quest_desc: {
			new: [
				"The Ara Vitae has reached its final form."
				""
				"With every circle completed, more rune positions become available, allowing you to further specialize your altar with &dSpecialized Runes&f and their &5Reinforced&f variants."
				""
				"Complete the final circle and bring your Ara Vitae to its &5Transcendent&f potential."
				""
				"There is no higher circle."
				""
				"Whatever comes next, you'll have to discover for yourself."
			]
			old: ["Complete the final tier of the &bAra Vitae&r and prepare yourself for the ultimate Orb of Vitae."]
		}
		quest.0935BFDC4F0B4C6C.quest_subtitle: {
			new: "The altar grows"
			old: "Your blood network is beginning to evolve."
		}
		quest.0935BFDC4F0B4C6C.title: {
			new: "The Second Circle"
			old: "The Third Circle"
		}
		quest.7A0A29CC4F524CEE.quest_desc: {
			new: [
				"The Ara Vitae can be expanded beyond its humble beginnings."
				""
				"Build the first circle with &d8 Runes&f, one level below the altar."
				""
				"The four cardinal positions can be filled with &dSpecialized Runes&f, while the diagonal positions remain inactive for now."
				""
				"Choose your runes carefully - each one can change how your altar performs."
			]
			old: ["Expand your &bAra Vitae&r with its first ring of &bBlank Runes&r and unlock the next stage of Vitaemancy."]
		}
		quest.7A0A29CC4F524CEE.quest_subtitle: {
			new: "The beginning of something greater"
			old: "The altar is only the beginning."
		}
		quest.0935BFDC4F0B4C6C.quest_desc: {
			new: [
				"It's time to expand your Ara Vitae."
				""
				"Add a second ring of &d16 Runes&f, one level lower and farther out than the first."
				""
				"The new positions give you more room for &dSpecialized Runes&f, allowing you to further customize your altar."
				""
				"Complete the four pillars and cap them with &dBlood Stained Glass&f."
				""
				"Your altar now contains &d24 Runes&f."
			]
			old: ["Expand your &bAra Vitae&r to its third tier and prepare your network for more powerful transmutations."]
		}
		quest.5A52426AC47A1FE3.quest_subtitle: {
			new: "Beyond mortal limits"
			old: "You stand at the threshold of true mastery."
		}
	}
	"chapters/welcome.snbt": {
		quest.2E7A46639993CCDE.quest_desc: {
			new: [
				"Every world has secrets hidden beyond the visible, whether underground or in distant dimensions."
				""
				"Sometimes, you don't even need to leave home to find something unusual."
				""
				"The moon can bring special events to the night sky, each changing how you spend the night."
				""
				"&aHarvest Moon"
				"A great time to harvest your crops, with increased drops from eligible crops."
				""
				"&9Blue Moon"
				"A lucky night that grants a Luck effect, making it a great time for fishing and other Luck-based activities."
				""
				"&cBlood Moon"
				"A dangerous night where hostile mobs become far more threatening, and sleeping won't save you."
				""
				"&5Super Moon"
				"A giant moon that makes it easier to find slimes."
				""
				"Some events also have &6Super variants&r, making their effects even stronger."
				""
				"Keep an eye on the moon and the messages announcing each event. You never know when the night might be worth staying awake for."
			]
			old: [
				"Any world will have secrets &6hidden&r beyond the visible, whether that be tucked &6under the surface&r or in a completely different &6dimension&r."
				""
				"Never overlook something that looks &6out of place&r, you might just discover something new."
				""
				"Confidence is a good thing, but always stay &6geared up&r and &6safe&r; it might save your life one day."
			]
		}
		quest.7B86C9C90997B3E3.quest_subtitle: {
			new: "A little variety goes a long way!"
			old: "&oA little hexing?"
		}
		quest.21E1E62AA4761EE2.quest_desc: {
			new: [
				"There is far more to this world than simply gathering resources and building machines."
				""
				"The &eMoon&f can bring strange events to the night sky, from peaceful &aHarvest Moons&f to dangerous &cBlood Moons&f."
				""
				"Food is more than just something to fill your hunger. Eating a &6diverse diet&f can grant powerful benefits, including &cadditional hearts&f and other effects."
				""
				"And if you've made it this far, don't assume you've reached the end."
				""
				"&5Custom bosses&f, &dendgame content&f, and challenges await those willing to push beyond the normal limits."
				""
				"Explore, experiment, and see how far you can take your journey."
			]
			old: [
				"You might be curious as to what I meant when I mentioned these things, so I'll &6offer&r you a rundown. "
				""
				"If you decide not to take my &6insight&r, I won't take it harshly and will let you &abegin your journey&r. "
				""
				"I wish you luck."
			]
		}
		quest.21E1E62AA4761EE2.quest_subtitle: {
			new: "There’s more to this world than meets the eye."
			old: "&oPick A Card. Any Card"
		}
		quest.7B86C9C90997B3E3.quest_desc: {
			new: [
				"You hear right!"
				""
				"Eating a variety of foods isn't just good for your appetite."
				""
				"Every &adifferent food&r you eat brings you closer to a permanent &cheart&r increase. With &a50 milestones&r spread across all &e1,097 foods&r, there's always another reason to expand your menu."
				""
				"The first heart comes at just &e10 foods&r, while the final heart requires you to discover &e1,097 unique foods&r."
				""
				"Your progress is tracked in the &dFood Book&r, showing which foods you've already tried and how far you are from your next milestone."
				""
				"&6Explore, cook, and try everything you can find!&r"
			]
			old: [
				"&aYou heard right&r! "
				""
				"&6Harness&r the &bmana&r surrounding you and &6break the limits&r of what's possible! "
				""
				"&6Use&r &dmagic&r to &6assist you&r in your &aday&r to &aday&r activites or to help &6fight off&r the &cdangers of&r &0the night&r. "
				""
				"&6Discover &cthe &9impossible&r."
			]
		}
		quest.3C1D103FCEF249C8.quest_subtitle: {
			new: "The real challenge starts here."
			old: "&o*AGGRESSIVE FACTORY NOISES*"
		}
		quest.21E1E62AA4761EE2.title: {
			new: "&9Beyond the Ordinary"
			old: "&aExploration? &5Magic? &eMachines?"
		}
		quest.3C1D103FCEF249C8.quest_desc: {
			new: [
				"The journey doesn't end when you reach the end."
				""
				"Beyond the usual progression lies a &5custom endgame&r built specifically to push your limits."
				""
				"&bPowerful machines&r, &dunique recipes&r, &6custom materials&r, and &cdeadly bosses&r await those who are prepared to go further."
				""
				"Some challenges will demand more than just good equipment. You'll need to master your machines, optimize your gear, and make use of everything you've learned along the way."
				""
				"And when you think you've reached the top..."
				""
				"&5Something even stronger may be waiting.&r"
				""
				"The end isn't the destination."
				""
				"&6It's only the beginning of the real challenge.&r"
			]
			old: [
				"Don't you just &clove&r the aroma of &8smoke&r and &egasoline fumes&r? "
				""
				"&4Don't pollute the world too much&r! "
				""
				"I guess it might be a good &btrade off&r; lazy equals &cpollution&r! "
				""
				"&6Use&r the &bGuide Books&r you get, they will be &avery helpful&r!"
			]
		}
		quest.2E7A46639993CCDE.title: {
			new: "&bLunar Events"
			old: "&bExploration!"
		}
		quest.3C1D103FCEF249C8.title: {
			new: "&dBeyond the End"
			old: "&eMachines?"
		}
		quest.7B86C9C90997B3E3.title: {
			new: "&6Taste the World"
			old: "&5Magic?!"
		}
	}
}
