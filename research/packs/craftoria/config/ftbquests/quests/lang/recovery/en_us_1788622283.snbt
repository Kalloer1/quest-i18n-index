		quest.7B88129FF5C9145F.quest_subtitle: {
			new: "Put the spawner on a leash"
			old: "+4 Activation Range"
		}
		quest.14F545E632726FEE.quest_subtitle: {
			new: "A rune charged with power"
			old: "+ Burning"
		}
		quest.1FD59C1147BCE34F.quest_desc: {
			new: [
				"The &bEchoing Spawner Rune&f modifies a spawner to create additional spawning behavior."
				""
				"Perfect for taking an already productive spawner and making it even more productive."
			]
			old: ["The spawner ignores spawn conditions."]
		}
		quest.48F4ED8C915995DC.quest_desc: {
			new: [
				"The &bIgnore Conditions Spawner Rune&f makes the spawner ignore normal spawning conditions."
				""
				"When vanilla says no, this rune says yes."
			]
			old: ["The spawner ignores light levels."]
		}
		quest.4FDD66D88C90C951.title: {
			new: "Spawner"
			old: "&cApothic Spawners"
		}
		quest.2D8FB52E37D7D96C.quest_desc: {
			new: [
				"The &bIgnore Light Spawner Rune&f removes light-level restrictions from the spawner."
				""
				"Let your mobs spawn without having to build a pitch-black room."
			]
			old: ["The spawner does not need a nearby player."]
		}
		quest.7FD0A63CDC267251.quest_desc: {
			new: [
				"The &bFrontier Spawner Upgrade Rune&f improves the basic spawning statistics of a spawner."
				""
				"Use it to push your spawner beyond its vanilla limits."
