{
	"chapters/Monster_Mayhem.snbt": {
		quest.423B29BD8DAC8C3D.quest_subtitle: {
			new: "The peak of spawner upgrades"
			old: "+ Youthful"
		}
		quest.3F73EC8E087E2920.quest_desc: {
			new: [
				"The &bBurning Spawner Rune&f adds a fiery effect to mobs spawned by the spawner."
				""
				"Your mob farm just got considerably hotter."
			]
			old: ["Spawned mobs will drop extra loot, increasing with level."]
		}
		quest.7B88129FF5C9145F.quest_desc: {
			new: [
				"The &bRedstone Control Spawner Rune&f allows redstone to control the spawner."
				""
				"Perfect for switches, timers, and automated farm control."
			]
			old: ["How far a player can be before spawning stops."]
		}
		quest.423B29BD8DAC8C3D.quest_desc: {
			new: [
				"The &bPinnacle Spawner Upgrade Rune&f is the highest tier of the standard spawner upgrade path."
				""
				"Maximum power. Maximum mobs. Maximum chaos."
			]
			old: ["The spawner will always spawn a baby entity when possible."]
		}
		quest.4A476B25B5A3E88D.quest_desc: {
			new: [
				"The &bYouthful Spawner Rune&f modifies a spawner so that spawned mobs remain youthful."
				""
				"Useful when you need a reliable source of baby mobs."
			]
			old: ["The radius (in blocks) that mobs can spawn in."]
		}
		quest.33CDCAD12E8F6828.quest_subtitle: {
			new: "Reach the summit"
			old: "-10 Max Spawn Delay"
		}
		quest.253FA8D6C09E2BD5.quest_subtitle: {
			new: "Give your spawner some reach"
			old: "+ Silent"
		}
		quest.465ECB57BFCF5291.quest_desc: {
			new: [
				"The &bNo AI Spawner Rune&f disables artificial intelligence for mobs spawned by the spawner."
				""
				"Useful for efficient farms where mobs don't need to think."
			]
			old: ["Spawned entities will have no AI."]
		}
		quest.33CDCAD12E8F6828.quest_desc: {
			new: [
				"The &bSummit Spawner Upgrade Rune&f further enhances a spawner's core statistics."
				""
				"For serious mob production, this is where things start getting ridiculous."
			]
			old: ["The maximum number of ticks between spawns."]
		}
		quest.1F88FCB1B73FF882.quest_desc: {
			new: [
				"The &bInitial Health Spawner Rune&f modifies the initial health of mobs spawned by the spawner."
				""
				"Useful for creating easier or tougher mob farms."
			]
			old: ["The total number of entities allowed nearby."]
		}
		quest.2D8FB52E37D7D96C.quest_subtitle: {
			new: "Light doesn't matter anymore"
			old: "+ Ignores Players"
		}
		quest.7FD0A63CDC267251.quest_subtitle: {
			new: "The first tier of spawner upgrades"
			old: "+1 Spawn Count"
		}
		quest.35F320164724B44C.quest_desc: {
			new: [
				"The &bAscent Spawner Upgrade Rune&f is a stronger tier of spawner upgrade."
				""
				"Higher-tier runes provide more powerful improvements to your spawner."
			]
			old: ["The minimum number of ticks between spawns."]
		}
		quest.14F545E632726FEE.quest_desc: {
			new: [
				"An &bInfused Spawner Rune&f is a powered-up version of the basic spawner rune."
				""
				"It is required for some of the strongest spawner upgrades."
			]
			old: ["Spawned mobs will be set on fire."]
		}
		quest.4FDD66D88C90C951.quest_desc: {
			new: [
				"A &bSpawner&f is the foundation of automated mob spawning."
				""
				"Obtain a spawner to begin modifying how it behaves."
			]
			old: ["To obtain the &bSpawner &fyou must &6break &fa &bvanilla spawner &fwith&a Silk Touch&f. Every &bSpawner&f will have the same stats and can be modified to be better."]
		}
		quest.4A476B25B5A3E88D.quest_subtitle: {
			new: "Keep your mobs young"
			old: "+2 Spawn Range"
		}
		quest.1F88FCB1B73FF882.quest_subtitle: {
			new: "Choose how healthy they start"
			old: "+2 Max Entities"
		}
		quest.253FA8D6C09E2BD5.quest_desc: {
			new: [
				"The &bSpawn Range Spawner Rune&f changes the area around a spawner in which mobs can appear."
				""
				"More range means more room for your spawning setup."
			]
			old: ["Spawned entities will make no noise."]
		}
		quest.35F320164724B44C.quest_subtitle: {
			new: "Take your spawner higher"
			old: "-10 Min Spawn Delay"
