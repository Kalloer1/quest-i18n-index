	quest.6758124E2DC463D0.title: "&d&lLegendary Essence"
	quest.6758124E2DC463D0.quest_subtitle: "The rarest drop on the server"
	quest.6758124E2DC463D0.quest_desc: [
		"Defeat &cultra-rare&r wild Pokemon: each one has a &d0.5%&r chance to drop a &dLegendary Essence&r (&e1%&r when it is &eshiny&r)."
		""
		"Ultra-rare means the ultra-rare bucket of the spawns: starters, pseudo-legendaries, fossils, Eevee and its evolutions... (legendaries do not drop it)."
		""
		"Everything legendary now needs it: the &6Legendary Core&r, the &6Spawner&r and the legend quests in this chapter."
	]
	quest.FAF968F67B4D2459.title: "&6&lLegendary Core"
	quest.FAF968F67B4D2459.quest_subtitle: "The heart of every summoning item"
	quest.FAF968F67B4D2459.quest_desc: [
		"&64 Compressed Netherite Blocks&r + &b2 Compressed Diamond Blocks&r + &d2 Legendary Essences&r + &f1 Nether Star&r."
		""
		"Every summoning item (Legend Sanctuary, secret altars, Legendary Monuments) takes one Core, 4 gem blocks and 4 Z-Crystals. Recipes in JEI."
	]
	quest.B3C168A7F5DFB1FE.title: "&5&lLegendary Monuments"
	quest.B3C168A7F5DFB1FE.quest_subtitle: "Treats, tablets, whistles and urns"
	quest.B3C168A7F5DFB1FE.quest_desc: [
		"The &5Legendary Monuments&r items cost the same as ours (a Legendary Core each)."
		""
		"&eUsed anywhere&r: Fullmoon/Newmoon Whistle (Cresselia/Darkrai), Proofs of Conquest (lake trio), Urns (the birds; charge them by defeating Pokemon of their type), Curry of Justice (Keldeo), Love Letter (Enamorus)."
		""
		"&eUsed on a secret altar&r: treats, the Regi tablets and the Titan Key, bottles, the Hero Sword and Shield, the Temple Key, the GS Ball, the Disc of the First Song, the Old Sea Map, the Liberty Pass, the Cosmic Catalyst... but where are those altars?"
	]
	quest.D5DE353E42583F41.title: "&8&l???"
	quest.D5DE353E42583F41.quest_subtitle: "A rumor from the Trainer Island"
	quest.D5DE353E42583F41.quest_desc: [
		"Trainers on the &6Trainer Island&r talk about an &7old well&r nobody uses any more..."
		""
		"They say Entei, Raikou, Suicune, the Lati twins, Kyurem, Heatran and Hoopa answer to whoever finds what is below it."
	]
	task.BAD9760B3E05569B.title: "Find what is below the old well"
	quest.ED099101606FF2DE.title: "&8&l???"
	quest.ED099101606FF2DE.quest_subtitle: "A rumor from the League"
	quest.ED099101606FF2DE.quest_desc: [
		"Somewhere in the &ePokemon League&r gardens there is another &7old well&r."
		""
		"Old stories speak of the &7Regis&r sleeping in an ancient vault, and of two heroes, a sword and a shield."
	]
	task.88A116351D34B073.title: "Find the ancient vault"
	quest.488128CEFF49EC16.title: "&8&l???"
	quest.488128CEFF49EC16.quest_subtitle: "Staff only?"
	quest.488128CEFF49EC16.quest_desc: [
		"&dNurse Joy&r keeps the &cPokemon Center&r spotless... but what do the staff do downstairs?"
		""
		"Mew, Celebi, Meloetta, Victini and Cosmog are said to visit it."
	]
	task.CCD5BAA6A1B918EF.title: "Find what the staff hide"
	quest.2CB683BF64BA5906.title: "&4&lThe Spawner"
	quest.2CB683BF64BA5906.quest_subtitle: "The hardest craft of the pack"
	quest.2CB683BF64BA5906.quest_desc: [
		"&84 Compressed Netherite Blocks&r + &d2 Legendary Essences&r + &f2 Nether Stars&r + &61 Legendary Core&r."
		""
		"It comes &7empty&r: use a &aspawn egg&r on it to choose the mob. Spawn eggs drop with the &bCapturing&r enchantment (Apothic Spawners)."
	]
	quest.9417E88D8E89BBEF.title: "&c&lPokemon Center"
	quest.9417E88D8E89BBEF.quest_subtitle: "/center"
	quest.9417E88D8E89BBEF.quest_desc: [
		"A new warp: &f/center&r (also &f/pokecenter&r, &f/mart&r, or menu > Warps)."
		""
		"&a5 healing machines&r on the counter, &b6 PCs&r, &dNurse Joy&r (click her to heal your team), the &9Poke Mart&r (click the clerk: Poke Balls, potions, revives, status heals, X items, vitamins for CobbleDollars) and a lounge to meet other trainers."
	]
	task.F4A20A1F62620079.title: "Visit the Pokemon Center"
	quest.EBA297544A263F67.title: "&b&lChains"
	quest.EBA297544A263F67.quest_subtitle: "/chain"
	quest.EBA297544A263F67.quest_desc: [
		"Defeat or catch the &esame species&r again and again and the wild ones of it near you get better:"
		""
		"&7KO streak 5+&r: more of that species shows up (up to 75% at 100)"
		"&7KO streak 1+ (or 99 defeated)&r: 1 in 5 has its &dhidden ability&r"
		"&7KO streak 100 / 300 / 500&r: 1 / 2 / 3 extra &eshiny&r rolls"
		"&7Capture streak 5 / 10 / 20 / 30&r: 1 / 2 / 3 / 4 &bperfect IVs&r"
		""
		"Another species restarts the streak. &f/chain&r shows yours."
	]
	quest.CE7B27E5796674FB.title: "&5&lThe End"
	quest.CE7B27E5796674FB.quest_subtitle: "/end"
	quest.CE7B27E5796674FB.quest_desc: [
		"Menu > Warps > &5THE END&r (or &f/end&r) takes you to the real End, on the obsidian platform."
		""
		"Each trip costs &f12 Eyes of Ender + 1 Netherite Ingot&r."
	]
