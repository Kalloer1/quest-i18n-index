	quest.4A83EAA31BA98920.quest_desc: [
		"This boss represents Carrion at the stage in the series where he fiercely battles Milim Nava. In terms of progression and difficulty, he ranks directly above Charybdis and roughly on par with Hinata Sakaguchi. He is completely immune to infection mechanics."
		""
		""
		"---------------------------------"
		"Phase 1 (Base Form): Features passive health regeneration. His attack routine includes standard melee swings, Aura Slash, Tiger Talon, Elephant Stampede, alongside flight and erratic instant-move teleports to throw off the player."
		"---------------------------------"
		""
		""
		"---------------------------------"
		"Phase 2 (Royal Beast Mode): Triggered immediately upon dropping to 50% HP. Carrion fully heals himself instantly and transforms into his Royal Beast state. While transformed, he inherits the following raw stat modifiers and special abilities"
		"---------------------------------"
	]
	quest.4A83EAA31BA98920.quest_subtitle: "The Beast King (Milim Fight Ver.)"
	quest.4A83EAA31BA98920.title: "[Carrion]"
