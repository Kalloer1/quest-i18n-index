	]
	quest.1A485595EE7B92A2.title: "Generating Source Properly"
	quest.1A5D3157E8958DB9.quest_subtitle: "Craft a Lesser Water Focus to attune your magic to the element of water."
	quest.1A5D3157E8958DB9.title: "Lesser Water Focus"
	quest.1A67E1155BD4363A.quest_subtitle: "Become enraged when taking damage."
	quest.1A67E1155BD4363A.title: "Berserker's fury"
	quest.1AB80AD97A3604A1.quest_subtitle: "Makes mobs have a chance to drop their spawn egg."
	quest.1AB80AD97A3604A1.title: "Capturing"
