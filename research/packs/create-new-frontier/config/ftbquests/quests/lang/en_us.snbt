	quest.19B4FA2B1B60A4F7.quest_subtitle: "Tesla Coil"
	quest.19B4FA2B1B60A4F7.title: "High Voltage"
	quest.19BA7238CDF03FAC.quest_subtitle: "Craft the full Battlemage armor set for offensive magical combat."
	quest.19BA7238CDF03FAC.title: "Battlemage Attire"
	quest.19D02325579F2AA8.quest_desc: ["Obtain a Volcanic Sourcelink to generate Source from lava or other heat-related sources."]
	quest.19D02325579F2AA8.quest_subtitle: "Harness the heat of lava to generate Source via the Volcanic Sourcelink."
	quest.19D02325579F2AA8.title: "Volcanic Sourcelink"
