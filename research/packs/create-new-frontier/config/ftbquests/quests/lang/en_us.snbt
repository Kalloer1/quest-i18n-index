	quest.164BEB1F698AF57F.title: "Harnessing Experience"
	quest.1677AB65A6F4B2FD.quest_subtitle: "Craft a Blaze Enchanter to use XP for new enchants."
	quest.1677AB65A6F4B2FD.title: "Blazing Enchantments"
	quest.16C47409C0A411EF.quest_desc: ["Acquire the Glyph: Fangs to summon fang-like attacks that strike enemies from the ground."]
	quest.16C47409C0A411EF.quest_subtitle: "Evoker-style attack"
	quest.16C47409C0A411EF.title: "Glyph: Fangs"
	quest.17672BE2726FE1DD.quest_desc: ["The Tome of Helmets is a book bound exclusively to the enchantments of headgear. It accepts only those magics that fortify, enlighten, or empower helmets—whether granting protection, vision, or resilience. By channeling enchantments into this tome, adventurers ensure their helm becomes a vessel of focused power, safeguarding the mind and spirit against the dangers of the world. It is a tome of guardianship, a record of enchantments meant to shield the bearer’s crown."]
	quest.17672BE2726FE1DD.quest_subtitle: "A tome for the enchantments of the crown."
	quest.17BD8DEC0EE30645.quest_subtitle: "Craft a Printer and Depot to copy enchanted books."
	quest.17BD8DEC0EE30645.title: "Arcane Printing"
	quest.17D7D34F519F7E5F.quest_desc: ["Upgrade to an Archmage Spell Book to access the full range of Ars Nouveau’s most powerful spells."]
	quest.17D7D34F519F7E5F.quest_subtitle: "Reach the pinnacle of spellcasting with the Archmage Spell Book."
	quest.17D7D34F519F7E5F.title: "Archmage’s Tome"
	quest.18A2FBE2D4133FA2.quest_desc: ["Craft multiple Arcane Pedestals to support the Enchanting Apparatus and hold ingredients during crafting."]
	quest.18A2FBE2D4133FA2.quest_subtitle: "Craft multiple Arcane Pedestals to channel reagents into your apparatus."
	quest.18A2FBE2D4133FA2.title: "Pedestals of Power"
	quest.18BC056B55C25EB5.quest_desc: ["Obtain the Glyph: Smelt so your spells can cook items or smelt blocks directly in the world."]
	quest.18BC056B55C25EB5.quest_subtitle: "Heat, cook, and refine"
	quest.18BC056B55C25EB5.title: "Glyph: Smelt"
	quest.19B4FA2B1B60A4F7.quest_desc: [
		"Build a Tesla Coil to charge items and zap anything that"
		"gets too close. Handle with care!"
