	quest.000000000001318A.quest_desc: ["The IE assembler crafts items automatically from a stored recipe using piped inputs."]
	quest.000000000001318A.title: "Assembler"
	quest.00000000000131CE.quest_desc: ["Move items around your factory with IE conveyor belts."]
	quest.00000000000131CE.title: "Conveyor Belts"
	quest.0000000000013212.quest_desc: ["The garden cloche automates crop growing in a single block using water and fertilizer."]
	quest.0000000000013212.title: "Garden Cloche"
	quest.0000000000013245.quest_desc: ["Automatically crafts items using stored recipes. A cheaper alternative to the assembler."]
	quest.0000000000013245.title: "Auto Workbench"
	quest.0000000000013289.quest_desc: ["Build a large windmill multiblock for a steady passive IF source."]
	quest.0000000000013289.title: "Windmill"
	quest.00000000000132BC.quest_desc: ["The diesel generator burns biodiesel for very high IF output."]
	quest.00000000000132BC.title: "Diesel Generator"
	quest.00000000000132EF.quest_desc: ["The refinery produces biodiesel from plant oil and ethanol. Fuel your diesel generator."]
	quest.00000000000132EF.title: "Refinery"
	quest.0000000000013333.quest_desc: ["A flamethrower-style weapon. Spray liquids at enemies for devastating effects."]
	quest.0000000000013333.title: "Chemical Thrower"
	quest.0000000000013377.quest_desc: ["A high-tech weapon that fires metal spikes at incredible velocity."]
	quest.0000000000013377.title: "Railgun"
	quest.00000000000133CC.quest_desc: ["The factory runs itself. Excavators mine, assemblers craft, and belts move everything."]
	quest.00000000000133CC.title: "Industrial Revolution"
	quest.0000000000013421.quest_desc: [
		"LaserIO nodes transfer items, fluids, and energy wirelessly between any two blocks."
		"No pipes, no cables — just lasers."
	]
	quest.0000000000013421.title: "LaserIO Basics"
	quest.0000000000013465.quest_desc: ["Laser fluid nodes move liquids wirelessly. Perfect for Mekanism and Create fluid systems."]
	quest.0000000000013465.title: "Fluid Lasers"
	quest.00000000000134A9.quest_desc: ["Transfer RF wirelessly between generators and machines using energy laser nodes."]
	quest.00000000000134A9.title: "Energy Lasers"
	quest.00000000000134ED.quest_desc: ["Pipez provides simple, cheap item/fluid/energy/gas pipes for quick connections."]
	quest.00000000000134ED.title: "Pipez"
	quest.0000000000013531.quest_desc: [
		"XNet is a powerful cable-based item/fluid/energy routing system."
		"Program channels on the controller to create complex automation logic."
	]
	quest.0000000000013531.title: "XNet Controller"
	quest.0000000000013564.quest_desc: [
		"KubeJS lets you modify recipes, add custom items, and create pack-specific mechanics."
		"Check the KubeJS scripts in the kubejs/ folder to see what this pack adds."
	]
	quest.0000000000013564.title: "KubeJS Integration"
	quest.00000000000135A8.quest_desc: ["Access your AE2 network and craft items from anywhere with the wireless crafting terminal."]
	quest.00000000000135A8.title: "Wireless Crafting Terminal"
	quest.00000000000135EC.quest_desc: [
		"Compact Machines create a large crafting space inside a single block."
		"Build entire factories behind a 1x1 footprint in the grid."
	]
	quest.00000000000135EC.title: "Compact Machines"
	quest.0000000000013630.quest_desc: ["Dimensional shards are the core crafting material for RFTools. Collect them for advanced automation."]
	quest.0000000000013630.title: "RFTools Shards"
	quest.0000000000013674.quest_desc: ["The storage scanner indexes your storage system for advanced item querying and routing."]
	quest.0000000000013674.title: "RFTools Storage Scanner"
	quest.00000000000136B8.quest_desc: [
		"The RFTools builder constructs shapes, excavates areas, and teleports contraptions."
		"Great for expanding a safe platform through the grid."
	]
	quest.00000000000136B8.title: "RFTools Builder"
	quest.00000000000136FC.quest_desc: ["The RFTools crafter automates up to 8 crafting recipes simultaneously."]
	quest.00000000000136FC.title: "RFTools Crafter"
	quest.0000000000013740.quest_desc: ["Program complex automation logic with the RFTools Control processor."]
	quest.0000000000013740.title: "RFTools Control Processor"
	quest.0000000000013784.quest_desc: ["The Ex Compressum auto-compressor bulk-compresses items automatically."]
	quest.0000000000013784.title: "Ex Compressum"
	quest.00000000000137C8.quest_desc: ["Automate your Ex Deorum sieving with the Ex Compressum auto-sieve."]
	quest.00000000000137C8.title: "Auto Sieve"
	quest.000000000001380C.quest_desc: [
		"The Industrial Foregoing stoneworks factory produces stone, cobblestone, gravel, sand, and dust automatically."
		"Infinite sieving inputs from a single machine."
	]
	quest.000000000001380C.title: "Stoneworks Factory"
	quest.0000000000013850.quest_desc: ["Automatically harvests crops in a configurable area."]
	quest.0000000000013850.title: "Plant Gatherer"
	quest.0000000000013894.quest_desc: ["Crushes mobs for drops and experience in an automated mob farm."]
	quest.0000000000013894.title: "Mob Crusher"
	quest.00000000000138D8.quest_desc: ["The IF laser drill mines ores from the bedrock layer passively using RF."]
	quest.00000000000138D8.title: "Laser Drill"
	quest.000000000001393E.quest_desc: ["Your entire grid base runs automatically. Every system feeds every other system."]
	quest.000000000001393E.title: "The Automated Sky"
	quest.0000000000013993.quest_desc: [
		"Yellorium is the fuel for Extreme Reactors."
		"Sieve dust or find it via your mining systems."
	]
	quest.0000000000013993.title: "Yellorium: Reactor Fuel"
	quest.00000000000139D7.quest_desc: ["Build the outer shell of your Extreme Reactor with reactor casing blocks."]
	quest.00000000000139D7.title: "Reactor Casing"
	quest.0000000000013A1B.quest_desc: [
		"Build a complete Extreme Reactor multiblock."
		"A 3x3x3 interior with fuel rods, a controller, and access ports."
	]
	quest.0000000000013A1B.title: "Reactor Online"
	quest.0000000000013A5F.quest_desc: ["Add fuel rods to increase your reactor’s energy output."]
	quest.0000000000013A5F.title: "More Power"
	quest.0000000000013A92.quest_desc: ["Convert reactor steam output into even more RF with a Extreme Reactors turbine."]
	quest.0000000000013A92.title: "Steam Turbine"
	quest.0000000000013AD6.quest_desc: ["Use the RFTools Builder to expand your grid base with quarried materials."]
	quest.0000000000013AD6.title: "Grid Expansion"
	quest.0000000000013B1A.quest_desc: ["Advanced RFTools energy cells store enormous amounts of RF for your endgame systems."]
	quest.0000000000013B1A.title: "RFTools Energy Cell"
	quest.0000000000013B5E.quest_desc: ["Craft netherite ingots from netherite scraps and gold. The pinnacle of vanilla progression."]
	quest.0000000000013B5E.title: "Netherite Age"
	quest.0000000000013BA2.quest_desc: ["Netherite tools are the best in the game — durable, fast, and fireproof."]
	quest.0000000000013BA2.title: "Netherite Tools"
	quest.0000000000013BE6.quest_desc: ["Full netherite armor is fire-proof and has the highest base protection available."]
	quest.0000000000013BE6.title: "Netherite Armor"
	quest.0000000000013C19.quest_desc: [
		"Apotheosis overhauls the enchanting system."
		"Use the reforging station and gem socketing to push your gear to the limit."
	]
	quest.0000000000013C19.title: "Apotheosis Enchanting"
	quest.0000000000013C4C.quest_desc: ["Apothic Enchanting’s infusion altar applies powerful enchantments beyond normal limits."]
	quest.0000000000013C4C.title: "Infusion Altar"
	quest.0000000000013C90.quest_desc: ["Build a beacon from a nether star and glass. Place it on a pyramid for powerful permanent buffs."]
	quest.0000000000013C90.title: "Beacon"
	quest.0000000000013CD4.quest_desc: ["Defeat the Wither to claim a nether star. You’ll need strong gear and a safe arena."]
	quest.0000000000013CD4.title: "Wither Slain"
	quest.0000000000013D18.quest_desc: [
		"&6Obtain a Dragon Egg&r. This quest checks the item, not a dragon kill. Any of the routes below can supply it; later players do not need to claim the first egg from the shared End."
		"&bMekanism: advanced technology&r"
		"Use the Antiprotonic Nucleosynthesizer: 1 ordinary chicken egg + 4 mB antimatter makes 1 Dragon Egg. The machine also needs power. Produce antimatter in the Supercritical Phase Shifter (SPS), not in the Nucleosynthesizer. Check JEI for the full machine and fuel progression."
		"&aMystical Agriculture / Agradditions: farming&r"
		"Collect Dragon Scales after defeating the Ender Dragon. This pack is configured for 8 scales per kill: 4 for Dragon Egg Seeds and 4 for the Dragon Egg Crux. Collect the drops before they are lost. Insanium-tier crafting materials are also required; see JEI."
		"Plant Dragon Egg Seeds on Insanium Farmland, with a Dragon Egg Crux directly below the farmland. Harvest Dragon Egg Essence. Craft 9 essence into 1 Dragon Egg Chunk, then craft 3 chunks into 1 Dragon Egg: 27 essence total. This route does not need an original Dragon Egg."
		"&dForestry + Magic Bees: breeding&r"
		"Start with a Curious Hive from golden-mesh dirt sieving. Craft a Deep Hive using 1 Curious Hive, 4 Cobbled Deepslate, 2 Amethyst Shards and 2 Gold Ingots. Place it and harvest with a Forestry scoop to obtain bees, including Attuned bees. Hive drops retain their normal randomness."
		"Craft an Oblivion Hive using 1 Deep Hive, 4 End Stone, 2 Chorus Fruit and 2 Ender Pearls. Place and scoop it in the End for Oblivion bees. These recipes work in existing worlds; no new chunks are required. They use End materials rather than a strict advancement lock."
		"The egg branch needs Ethereal and Imperial bees first. Breed Ethereal + Oblivion for Nameless (10% base chance), then Oblivion + Nameless for Abandoned (8%). Breed Imperial + Abandoned in an End biome for Draconic (6%). Use JEI for the earlier breeding trees and provide each species with suitable working conditions."
		"Draconic bees produce Dragon Dust. Craft 6 dust into 1 Dragon Chunk. The egg recipe uses 8 chunks (48 dust total) around 1 Essence of False Life. These Magic Bees items are separate from the Mystical Agradditions chunks."
		"For Essence of False Life, breed Ethereal + Attuned for Aware (10%). Breed Aware with Attuned or Ethereal for Spirit (8%). Spirit bees can supply Soul Combs as a specialty when their conditions are met. Centrifuge Soul Combs for Soul Wax, then craft 4 Soul Wax + 4 Glass + 1 Poppy into Essence of False Life."
		"&7Keep breeding princesses and drones before spending your last hive. Mutation percentages are base chances, not guaranteed results. All three routes preserve the original mods' production requirements.&r"
	]
	quest.0000000000013D18.title: "Dragon Egg: Three Paths"
	quest.0000000000013D5C.quest_desc: ["Elytra give you true flight. Combine with rockets for infinite speed across the void."]
	quest.0000000000013D5C.title: "Wings of Freedom"
	quest.0000000000013D8F.quest_desc: ["Socket legendary gems into your gear for the absolute best stats possible."]
	quest.0000000000013D8F.title: "Legendary Gear"
	quest.0000000000013DD3.quest_desc: ["Your reactor and turbine generate more RF than everything in your base combined can consume."]
	quest.0000000000013DD3.title: "Infinite Power"
	quest.0000000000013E28.quest_desc: ["Your AE2 network auto-crafts everything, the induction matrix stores it all, and spirits mine the rest."]
	quest.0000000000013E28.title: "Fully Automated"
	quest.0000000000013EB0.quest_desc: ["You started on a small platform surrounded by an endless lattice of scattered blocks.\n\nYou've built machines that reshape matter, woven spells into steel, harnessed the power of stars, and forged something that has never existed before.\n\nThis is what you came here to build.\n\nThe sky was never the limit — it was the beginning."]
	quest.0000000000013EB0.quest_subtitle: "The sky was never the limit."
	quest.0000000000013EB0.title: "Ascension"
	quest.0000000000014010.quest_desc: [
		"This world is a lattice. One block every four spaces, in every direction, floating in nothing."
		""
		"There is no ground. There is no horizon. Everything you will ever need is out there somewhere, four blocks apart, and the only way to reach it is to build."
		""
		"&eThe void returns you to the shared Overworld platform, but anything you were trying to reach will still be far away.&r Bridge carefully, crouch at edges, and never dig straight down."
	]
	quest.0000000000014010.title: "What Is This Place?"
	quest.0000000000014020.quest_desc: [
		"Blocks are not scattered randomly. Every one sits at a coordinate divisible by four, so the whole world is a regular 3D lattice."
		""
		"This is worth knowing: once you find something useful, its neighbours are exactly four blocks away in six directions. Mining out a corridor along one axis covers far more ground than wandering."
		""
		"&7Ores sometimes generate as small clusters instead of single blocks. If you find one, check around it.&r"
	]
	quest.0000000000014020.title: "Reading the Grid"
	quest.0000000000014030.quest_desc: [
		"&eThere is no water in this world.&r Neither is there lava. Both were deliberately left out of the block pool, because a floating water source cascades downward forever and floods everything below it."
		""
		"&bIce is how you get water back.&r Ice generates throughout the grid. Break a block of it while it is resting on something solid, and it becomes a water source."
		""
		"Do this early. Water gates farming, cobblestone generators, Create water wheels, and most of Mekanism."
	]
	quest.0000000000014030.title: "Water From Ice"
	quest.0000000000014040.quest_desc: [
		"The block pool is not fixed. You can change what generates."
		""
		"&e/skygridgui&r opens an editor with a searchable list of every registered block, split by dimension, with a weight for each one. Higher weight means more common."
		""
		"You can also use commands directly:"
		"&7/skygrid add <block> [weight]&r"
		"&7/skygrid remove <block>&r"
		"&7/skygrid tag add <tag>&r  - adds an entire block tag at once"
		""
		"&cChanges only affect newly generated chunks.&r Terrain that already exists never changes, so travel outward or start a new world to see the difference."
	]
	quest.0000000000014040.title: "Customising the World"
	quest.0000000000014050.quest_desc: [
		"Two water sources diagonally adjacent will fill the space between them, forever."
		""
		"Once you have one, water stops being a resource and becomes infrastructure. Build it into your base before you need it."
	]
	quest.0000000000014050.title: "An Infinite Source"
	quest.0000000000014060.quest_desc: [
		"The Nether is a skygrid too, with its own block pool."
		""
		"Expect netherrack, basalt, blackstone, soul sand, nylium and nether wood - plus quartz and nether gold ore. The mobs in its spawners are nether-appropriate, and its chests use fortress and bastion loot."
		""
		"&cThere is no lava there either.&r The usual trick of finding a lava lake does not apply. Bring your own, or make it with a crucible."
		""
		"&7Overworld ores do not generate in the Nether pool, so this is a trip for nether-specific materials, not a shortcut.&r"
	]
	quest.0000000000014060.title: "The Nether Grid"
	quest.0000000000014070.quest_desc: [
		"Ancient debris generates in the Nether pool, but rarely."
		""
		"Sieving is usually the faster route to netherite. Consider this the scenic one."
	]
	quest.0000000000014070.title: "Debris in the Dark"
	quest.0000000000014080.quest_desc: [
		"The End is the sparsest of the three. End stone, purpur, obsidian and chorus - and very little else."
		""
		"Its chests use End City loot, so elytra and shulker shells are possible, and its spawners lean heavily on endermen."
		""
		"&7Deliberately bleak. There is not much out there, and what there is takes real effort to reach.&r"
	]
	quest.0000000000014080.title: "The End Grid"
	quest.0000000000014090.quest_desc: [
		"Chorus plants are the End pool renewable - food, and teleportation if you are brave about it."
		""
		"With all three grids visited you have seen everything the world generates. Everything from here is what you build on top of it."
	]
	quest.0000000000014090.title: "Chorus and Onward"
	quest.00000000000140A0.quest_desc: [
		"Weights are per block, not per tag."
		""
		"A broad tag like &e#c:ores&r expands to every matching ore in the pack. Adding or updating a mod can silently change that list, and even weight 1 is applied separately to every resolved block."
		""
		"&7The default pool therefore uses explicit logs and ores. If you add a tag, check the log after reloading: it prints how many blocks the tag resolved to, which is the number worth tuning against.&r"
	]
	quest.00000000000140A0.title: "Tuning the Pool"
	quest.00000000000140B0.quest_desc: [
		"The default pool is a starting point, not a rule."
		""
		"Want a harder run? Remove iron and copper and let the sieves carry you. Want to build? Add the decorative blocks the default list leaves out. Want the classic experience? &e/skygrid add minecraft:water&r and &e/skygrid add minecraft:lava&r, and accept the flooding that follows."
		""
		"Every world can be a different shape."
	]
	quest.00000000000140B0.title: "Make It Yours"
	quest.0000000000015001.quest_desc: [
		"&6Sky Coins&r are the currency here, and every listing below can be used as many times as you like."
		""
		"&eThe top row buys your surplus.&r The grid produces far more cobblestone, dirt and gravel than anyone needs. Hand it over and it becomes coins."
		""
		"&eEverything below sells you the things the grid is stingy with&r - saplings, seeds, and ice."
		""
		"&7Nothing sold here bypasses progression. There are no ores, ingots or machines on the shelves. The Post exists to fix bad luck, not to skip the work.&r"
	]
	quest.0000000000015001.title: "The Trading Post"
	quest.0000000000015003.quest_desc: ["The grid's most abundant output. Not worth much, but it is worth something. Trade 256 blocks (four stacks) for one Sky Coin."]
	quest.0000000000015003.title: "Sell: Cobblestone"
	quest.0000000000015006.quest_desc: ["Everyone ends up with more dirt than they can use. Grass, coarse dirt, and mud count. Trade 256 blocks (four stacks) for one Sky Coin."]
	quest.0000000000015006.title: "Sell: Dirt"
	quest.0000000000015009.quest_desc: ["Sift it for flint first if you need flint. The Post pays the same either way. Trade 256 blocks (four stacks) for one Sky Coin."]
	quest.0000000000015009.title: "Sell: Gravel"
	quest.000000000001500C.quest_desc: ["Glass is useful. Surplus sand is not. Red sand counts. Trade 256 blocks (four stacks) for one Sky Coin."]
	quest.000000000001500C.title: "Sell: Sand"
	quest.000000000001500F.quest_desc: ["Proof you made the trip. The Post is not fussy about where it came from. Trade 256 blocks (four stacks) for one Sky Coin."]
	quest.000000000001500F.title: "Sell: Netherrack"
	quest.0000000000015012.quest_desc: ["Flint takes work to accumulate, so it pays better than the gravel it came from."]
	quest.0000000000015012.title: "Sell: Flint"
	quest.0000000000015015.quest_desc: ["The reliable one. Fast, predictable, apples."]
	quest.0000000000015015.title: "Buy: Oak Saplings"
	quest.0000000000015018.quest_desc: ["Grows straight and short. Good where headroom is tight."]
	quest.0000000000015018.title: "Buy: Birch Saplings"
	quest.000000000001501B.quest_desc: ["Plant four in a square for a giant spruce."]
	quest.000000000001501B.title: "Buy: Spruce Saplings"
	quest.000000000001501E.quest_desc: ["The only reliable route to cocoa beans."]
	quest.000000000001501E.title: "Buy: Jungle Saplings"
	quest.0000000000015021.quest_desc: ["Grows sideways and refuses to be reasoned with."]
	quest.0000000000015021.title: "Buy: Acacia Saplings"
	quest.0000000000015024.quest_desc: ["Needs four planted in a square. Nothing happens otherwise."]
	quest.0000000000015024.title: "Buy: Dark Oak Saplings"
	quest.0000000000015027.quest_desc: ["Mostly for the look, and the petals."]
	quest.0000000000015027.title: "Buy: Cherry Saplings"
	quest.000000000001502A.quest_desc: ["For when you need wood now and cannot wait for a sapling to grow. Deliberately poor value against buying saplings."]
	quest.000000000001502A.title: "Buy: Oak Logs"
	quest.000000000001502D.quest_desc: ["Fastest-growing block in the game. Scaffolding, fuel, and eventually planks."]
	quest.000000000001502D.title: "Buy: Bamboo"
	quest.0000000000015030.quest_desc: ["Bread, hay bales, and something to breed animals with."]
	quest.0000000000015030.title: "Buy: Wheat Seeds"
	quest.0000000000015033.quest_desc: ["Unglamorous, but it is food and it is red dye."]
	quest.0000000000015033.title: "Buy: Beetroot Seeds"
	quest.0000000000015036.quest_desc: ["One stem feeds you indefinitely once it is growing."]
	quest.0000000000015036.title: "Buy: Melon Seeds"
	quest.0000000000015039.quest_desc: ["Golden carrots' less useful cousin, but essential for a few recipes."]
	quest.0000000000015039.title: "Buy: Pumpkin Seeds"
	quest.000000000001503C.quest_desc: ["Plant three, eat the fourth. Or don't eat any and plant all four."]
	quest.000000000001503C.title: "Buy: Carrots"
	quest.000000000001503F.quest_desc: ["The most calorie-dense thing you can farm early."]
	quest.000000000001503F.title: "Buy: Potatoes"
	quest.0000000000015042.quest_desc: ["Needs a water source beside sand or dirt. Paper, books, and eventually enchanting."]
	quest.0000000000015042.title: "Buy: Sugar Cane"
	quest.0000000000015045.quest_desc: ["Brewing starts here, and the Post is the only reliable supply without a fortress."]
	quest.0000000000015045.title: "Buy: Nether Wart"
	quest.0000000000015048.quest_desc: ["Brown dye and cookies. Plant on jungle logs."]
	quest.0000000000015048.title: "Buy: Cocoa Beans"
	quest.000000000001504B.quest_desc: ["Skips the waiting. Spawners will eventually make this free."]
	quest.000000000001504B.title: "Buy: Bone Meal"
	quest.000000000001504E.quest_desc: ["&bWater, in solid form.&r Break a block resting on something solid and it melts into a source. The single most useful thing sold here."]
	quest.000000000001504E.title: "Buy: Ice"
	quest.0000000000015051.quest_desc: ["Does not melt, and does not turn into water. For building and for very fast floors."]
	quest.0000000000015051.title: "Buy: Packed Ice"
	quest.0000000000015054.quest_desc: ["The slipperiest block in the game. Expensive, and worth it for boat highways."]
	quest.0000000000015054.title: "Buy: Blue Ice"
	quest.0000000000015057.quest_desc: ["Wool, beds, fishing rods, and scaffolding for the impatient."]
	quest.0000000000015057.title: "Buy: String"
	quest.000000000001505A.quest_desc: ["Books, armour, item frames. Tedious to farm before you have a mob grinder."]
	quest.000000000001505A.title: "Buy: Leather"
	quest.000000000001505D.quest_desc: ["Bricks and, more importantly, a route into several mod chains."]
	quest.000000000001505D.title: "Buy: Clay"
	quest.0000000000015060.quest_desc: ["Sticky pistons and slime blocks, without waiting on a slime chunk you do not have."]
	quest.0000000000015060.title: "Buy: Slime"
	quest.0000000000015070.quest_desc: ["Deepslate is the second most common block in the grid. This is what it becomes when you mine it."]
	quest.0000000000015070.title: "Sell: Cobbled Deepslate"
	quest.0000000000015073.quest_desc: ["Create wants andesite. The Post will take whatever Create doesn't."]
	quest.0000000000015073.title: "Sell: Andesite"
	quest.0000000000015076.quest_desc: ["Nobody has ever needed this much diorite."]
	quest.0000000000015076.title: "Sell: Diorite"
	quest.0000000000015079.quest_desc: ["Between granite, diorite and andesite the grid produces more decorative stone than cobblestone."]
	quest.0000000000015079.title: "Sell: Granite"
	quest.000000000001507C.quest_desc: ["Less common than the others, but it still piles up."]
	quest.000000000001507C.title: "Sell: Tuff"
	quest.000000000001507F.quest_desc: ["A Nether staple, and evidence you have been there."]
	quest.000000000001507F.title: "Sell: Blackstone"
	quest.0000000000015082.quest_desc: ["&7Half of everything in the End is end stone.&r If you have set foot there, you have too much of this."]
	quest.0000000000015082.title: "Sell: End Stone"
	quest.0000000000015100.quest_desc: [
		"&eMekanism's Metallurgic Infuser will not craft without one of these.&r That is deliberate."
		""
		"The Forged Core needs &6Create andesite alloy&r, a &6Create brass ingot&r, and &6Immersive Engineering steel&r. You cannot reach Mekanism's processing chain by ignoring the other two tech mods."
		""
		"&7Craft it once and the Infuser opens up. You will need more of them later - the Manaforged Alloy eats four.&r"
	]
	quest.0000000000015100.title: "The Forged Core"
	quest.0000000000015110.quest_desc: [
		"The second gate, and the one that pulls &dArs Nouveau&r into the chain."
		""
		"Four &6Forged Cores&r, four &dsource gems&r, and one &6infused alloy&r from the Metallurgic Infuser you just built."
		""
		"&eThis unlocks Mekanism's Enrichment Chamber and its ore-processing route.&r Other mods offer their own processing methods, but this is the gateway into Mekanism's larger production chain."
	]
	quest.0000000000015110.title: "Manaforged Alloy"
	quest.005D3168BE4EBF8F.quest_desc: ["A machine that farms so you do not have to stand on the last dirt block. Seeds to keep it honest."]
	quest.005D3168BE4EBF8F.title: "Farming Station"
	quest.00FD0D96C852E35C.quest_desc: ["Mossy golems hit like falling gravel. The totem of moss is their apology."]
	quest.00FD0D96C852E35C.title: "Moss and Stone"
	quest.01244A3F8E659038.quest_desc: ["Pointed dripstone is lava and water farms if you have the patience. Dragon breath is a much less patient reward."]
	quest.01244A3F8E659038.title: "Dripstone"
	quest.0133AEA5858EC0DC.quest_desc: ["Silent Gear materials have traits you cannot see until you grade them. Rough rods are a decent spare."]
	quest.0133AEA5858EC0DC.title: "Material Grader"
	quest.020FED1247E64BC9.quest_desc: ["Spiders cling to the sides of grid blocks. String is beds, bows, and scaffolding for the impatient."]
	quest.020FED1247E64BC9.title: "String Theory"
	quest.03B8F8FFF65F46A8.quest_desc: ["Sixteen bookshelves. Vanilla enchanting still works, and the infuser is not the only option."]
	quest.03B8F8FFF65F46A8.title: "Library Stack"
	quest.0497B8009B1BDB64.quest_desc: ["Four bronze ingots through Silent Gear. A pickaxe head is the obvious next part."]
	quest.0497B8009B1BDB64.title: "Bronze Work"
	quest.062073D2CEB95356.quest_desc: ["Biomes still exist in the noise. The compass points at them even when the terrain is four blocks apart."]
	quest.062073D2CEB95356.title: "Nature's Compass"
	quest.075A9C05E7EFF7AB.quest_desc: ["Cherry saplings are mostly for the look. Pink petals if you want the look without the wait."]
	quest.075A9C05E7EFF7AB.title: "Cherry Blossom"
	quest.091B88C7183CAE44.quest_desc: ["Four mangrove propagules. Bamboo is the faster scaffold while they grow."]
	quest.091B88C7183CAE44.title: "Mangrove Roots"
	quest.0FA84BADF22117E0.quest_desc: ["The upgraded infuser reaches enchantments the basic one will not. Bring bottles."]
	quest.0FA84BADF22117E0.title: "Advanced Infuser"
	quest.14A8442A98EAD171.quest_desc: ["The Overgrown Colossus is the last name on this list. The mossy hammer is the last word."]
	quest.14A8442A98EAD171.title: "The Colossus"
	quest.15BF8FAEBEF1B298.quest_desc: ["Any enchanted book counts. Bottles if you had to buy the levels."]
	quest.15BF8FAEBEF1B298.title: "First Enchant"
	quest.169219F7B4B4EED7.quest_desc: ["Cactus is dye, traps, and proof the grid has a desert somewhere. A brush for the archaeology you still have not done."]
	quest.169219F7B4B4EED7.title: "Desert Finds"
	quest.17D6801B50A6486F.quest_desc: ["Withered abominations are two fights you will remember. The ribcage is armour if you are brave."]
	quest.17D6801B50A6486F.title: "Ribcage"
	quest.1A0CEC4AE8BDE43C.quest_desc: ["Machines need a buffer. A basic capacitor bank is the first one that is not embarrassing."]
	quest.1A0CEC4AE8BDE43C.title: "Capacitor Bank"
	quest.1A40A696026615A3.quest_desc: ["Teleport to what you are looking at. Blaze gold is a Silent Gear material you will want anyway."]
	quest.1A40A696026615A3.title: "Staff of Travelling"
	quest.1F27C714800D7831.quest_desc: ["Four enchanted books. Diamonds so the next tool is worth putting them on."]
	quest.1F27C714800D7831.title: "Enchanted Library"
	quest.217091C49CE2001A.quest_desc: ["The End is sparse on purpose. Kill the dragon, take the elytra, and the grid gets a lot smaller."]
	quest.217091C49CE2001A.title: "The Last Flight"
	quest.2481647E1D024624.quest_desc: ["Endermen teleport. You will too, once you have the pearls. Do not look at them while bridging."]
	quest.2481647E1D024624.title: "Pearl Harvest"
	quest.29BF2866424513CE.quest_desc: ["The boss at the end of this branch. Bring a plan that does not involve falling. The Tesseract is the trophy."]
	quest.29BF2866424513CE.title: "The Obliterator"
	quest.2D6D0D3B312A6E3D.quest_desc: ["Phantoms find you if you skip sleep. On a grid, that is easy to do. Fireworks help you get even."]
	quest.2D6D0D3B312A6E3D.title: "Night Shift"
	quest.2E06972E7AB6BB71.quest_desc: ["Silent Gear's late alloy. Two ingots, and spare heads so you actually use them."]
	quest.2E06972E7AB6BB71.title: "Tyrian Steel"
	quest.32BA80CE990C4A04.quest_desc: ["Pillagers still show up. There is no village to save. Take the emeralds anyway."]
	quest.32BA80CE990C4A04.title: "Raid on Nothing"
	quest.338F15408D603324.quest_desc: ["Crushing ores the Ender IO way. Redstone is the bill for keeping it fed."]
	quest.338F15408D603324.title: "SAG Mill"
	quest.33A638527CF2CD12.quest_desc: ["Shulker mimics are not shulkers. The shield still works like you hope."]
	quest.33A638527CF2CD12.title: "Shell Game"
	quest.374EAFBD222C92CA.quest_desc: ["You've beaten the Wither and lit a beacon - you've earned the right to bend the rules a little.\n\nClaim this to receive a §dPhilosopher's Stone§r, ProjectE's front door. Its crafting recipe is disabled everywhere else in this pack; this is the only way to get one."]
	quest.374EAFBD222C92CA.title: "Alchemical Awakening"
	quest.37BEF5F5CE2D6D27.quest_desc: ["One elder guardian. The Heart of the Sea is your ticket to a conduit, if you can keep the water."]
	quest.37BEF5F5CE2D6D27.title: "Elder of the Grid"
	quest.38C0C65A7DFCF6F4.quest_desc: ["Place two, walk between them. On a skygrid this is faster than any bridge you will ever build."]
	quest.38C0C65A7DFCF6F4.title: "Travel Anchor"
	quest.3A67A768B7CB8A6E.quest_desc: ["The Enchanting Infuser spends XP like a table, without the bookshelf dance. Books are still useful."]
	quest.3A67A768B7CB8A6E.title: "Infused Enchanting"
	quest.3AB535F158684848.quest_desc: ["Break Silent Gear tools back into parts. Iron is the apology for the ones you got wrong."]
	quest.3AB535F158684848.title: "Salvager"
	quest.3C6620A725ED7AA6.quest_desc: ["Lava eaters live where you should not. Their skin is the useful part."]
	quest.3C6620A725ED7AA6.title: "Thick Skinned"
	quest.3D9CE7B90BE7A6E6.quest_desc: ["Skeletosaurus is a dinosaur made of spawners' worst ideas. Keep the bones."]
	quest.3D9CE7B90BE7A6E6.title: "Bone Age"
	quest.3DD484616C338A67.quest_desc: ["Five ambushers. The shards they drop are the useful part."]
	quest.3DD484616C338A67.title: "Ambush"
	quest.3F631F60DCFA6906.quest_desc: ["Vindicators bring axes to a bridging fight. Do not give them the last block."]
	quest.3F631F60DCFA6906.title: "Chopping Block"
	quest.3FE46CF07632B704.quest_desc: ["Skeletons have the high ground on every floating block. Bring a shield, leave with arrows."]
	quest.3FE46CF07632B704.title: "Bone Collectors"
	quest.3FF934A24D0D35A1.quest_desc: ["Eight enchanted books. A netherite ingot is the hint to put them on something that lasts."]
	quest.3FF934A24D0D35A1.title: "Master Enchanter"
	quest.40F72974E221E45B.quest_desc: ["The capacitor that makes Ender IO machines stop being polite. Soularium comes along for the ride."]
	quest.40F72974E221E45B.title: "Octadic Capacitor"
	quest.42D921DE31B4CDFE.quest_desc: ["Build the skulls somewhere you can fight without falling. The totem is for the next mistake."]
	quest.42D921DE31B4CDFE.title: "Withered"
	quest.4477EE8BE47914D6.quest_desc: ["Burn souls for power. Weather crystals are a rare Ender IO extra."]
	quest.4477EE8BE47914D6.title: "Soul Engine"
	quest.449BD1390257EA37.quest_desc: ["The Warden is not meant to be fought on a lattice. If you insist, echo shards are the receipt."]
	quest.449BD1390257EA37.title: "Don't Make a Sound"
	quest.4505956BE7DBE6F1.quest_desc: ["Ghasts float. So does everything else here. Fire charges are the polite response."]
	quest.4505956BE7DBE6F1.title: "Screams in the Void"
	quest.47713991B9516861.quest_desc: ["Strip a bad enchant, keep the item. Emeralds are the fee for learning that the hard way."]
	quest.47713991B9516861.title: "Grindstone"
	quest.48C9073900FE8C0C.quest_desc: ["Azure electrum is azure silver taken seriously. The coating template lets you plate tools with it."]
	quest.48C9073900FE8C0C.title: "Azure Electrum"
	quest.4B0D2E6C8A1F3E9D.quest_desc: ["Haunted knights hit harder than the guards. Another deactivated summoner for the collection."]
	quest.4B0D2E6C8A1F3E9D.title: "Fallen Knights"
	quest.4C0D9BB0DBBD4CBD.quest_desc: ["Two azure silver ingots. Eight nuggets of the same metal come back as change."]
	quest.4C0D9BB0DBBD4CBD.title: "Azure Silver"
	quest.4C322E99EF0F04E7.quest_desc: ["Four vibrant alloy ingots. The nuggets are change for the next crafts."]
	quest.4C322E99EF0F04E7.title: "Vibrant Alloy"
	quest.4D4D2A1B5CF2C658.quest_desc: ["Wither skeletons drop skulls and coal. The scrap is a nudge toward netherite."]
	quest.4D4D2A1B5CF2C658.title: "Skulls and Scrap"
	quest.4E57B07FFD5A76EB.quest_desc: ["Ravagers do not turn well on a four-block spacing. Two is plenty. The saddle is a joke you can use later."]
	quest.4E57B07FFD5A76EB.title: "Unstoppable"
	quest.4F0E57C110000001.quest_desc: [
		"Vanilla SkyGrid does not spawn Forestry hives. A scoop and a handful of combs are the start."
		"&eSieve dirt on an iron mesh&r for forest hives and extra combs. Claim this for a scoop so you are not waiting on wool."
	]
	quest.4F0E57C110000001.title: "No Bees Out There"
	quest.4F0E57C110000002.quest_desc: ["Wool and sticks. Break a hive with this, not a pick. The forest hive in the reward is the one the grid will not grow for you."]
	quest.4F0E57C110000002.title: "The Scoop"
	quest.4F0E57C110000003.quest_desc: ["Place it on something solid and scoop it. More hives come from dirt in the sieve if you want a second species later."]
	quest.4F0E57C110000003.title: "Forest Hive"
	quest.4F0E57C110000004.quest_desc: ["One princess and one drone. That is a colony. An untreated frame is a hint about where they live next."]
	quest.4F0E57C110000004.title: "Princess and Drone"
	quest.4F0E57C110000005.quest_desc: ["Planks, slabs, and a comb in the middle. Slow, but it works before you have a carpenter."]
	quest.4F0E57C110000005.title: "Bee House"
	quest.4F0E57C110000006.quest_desc: ["Sixteen honey combs. The house is slow; the sieve is faster if you are impatient. Honeyed slice if you actually eat the work."]
	quest.4F0E57C110000006.title: "First Harvest"
	quest.4F0E57C110000007.quest_desc: ["Combs become wax and honey drops here. Build it before you drown in unprocessed comb."]
	quest.4F0E57C110000007.title: "Centrifuge"
	quest.4F0E57C110000008.quest_desc: ["Eight beeswax. This is candles, casings, and the coin trade at the end of the row."]
	quest.4F0E57C110000008.title: "Beeswax"
	quest.4F0E57C110000009.quest_desc: ["Forestry's workbench for anything soaked in seed oil. A sturdy casing comes along for the next crafts."]
	quest.4F0E57C110000009.title: "Carpenter"
	quest.4F0E57C11000000A.quest_desc: ["The carpenter's first real output. Apiaries are just planks wrapped around this."]
	quest.4F0E57C11000000A.title: "Impregnated Casing"
	quest.4F0E57C11000000B.quest_desc: ["Faster than a bee house, and it takes frames. The impregnated frame is not decorative."]
	quest.4F0E57C11000000B.title: "Apiary"
	quest.4F0E57C11000000C.quest_desc: ["Four alveary blocks. The full box is 3x3x3 with slabs on top. Royal jelly if you actually finish the walls."]
	quest.4F0E57C11000000C.title: "Alveary"
	quest.4F0E57C11000000D.quest_desc: ["Eight peat. Bog earth dries into this, and the gold-mesh dirt sieve finds some if you do not want to wait."]
	quest.4F0E57C11000000D.title: "Peat"
	quest.4F0E57C11000000E.quest_desc: ["Copper, glass, a piston, and peat. Bituminous peat burns longer if you upgrade the fuel."]
	quest.4F0E57C11000000E.title: "Peat Engine"
	quest.4F0E57C11000000F.quest_desc: ["Four brick farm blocks. Forestry Farms wants a 3x4x3 or larger multiblock. Fertilizer for the first crop."]
	quest.4F0E57C11000000F.title: "Farm Blocks"
	quest.4F0E57C110000010.quest_desc: ["Tin gears on brick. This is the power face of the farm. Sky Coins because a working farm is the point."]
	quest.4F0E57C110000010.title: "Farm Gearbox"
	quest.4F0E57C110000011.quest_desc: ["Sixteen beeswax. The grid will take it as coin if you have more than you can crate."]
	quest.4F0E57C110000011.title: "Wax Standard"
	quest.4F0E57C110000012.quest_desc: ["Thirty-two honey combs for one Sky Coin, as many times as you want. Surplus is the whole idea."]
	quest.4F0E57C110000012.title: "Comb Exchange"
	quest.4F0E57C110000013.quest_desc: ["Forestry trees are one item - a tree sapling with a genome - not per-species IDs. Craft a grafter (bronze and sticks). The amber fossil centrifuges into a real sapling."]
	quest.4F0E57C110000013.title: "Grafter"
	quest.4F0E57C110000014.quest_desc: ["Magic Bees, if you kept it. A magic frame in an apiary is the short version. Mundane combs if you already have a hive."]
	quest.4F0E57C110000014.title: "Magic Frame"
	quest.4F0E57C110000015.quest_desc: ["Modular Bees turns a hive into a machine. The core is the first block. Honey jelly is the snack."]
	quest.4F0E57C110000015.title: "Modular Hive"
	quest.4F0E57C110000016.quest_desc: ["One butterfly. They do not live on the grid either. The lepidopterist's chest is where the rest go."]
	quest.4F0E57C110000016.title: "Butterflies"
	quest.4F0E57C110000017.quest_desc: ["Binnie's Extra Bees adds alveary toys. The mutator is the one people actually build. A spare hive frame for the housing."]
	quest.4F0E57C110000017.title: "Binnie's Alveary"
	quest.4F0E57C110000018.quest_desc: ["Tin, glass, and a sturdy casing. Seeds go in; seed oil comes out. Cans are how Forestry moves the liquid."]
	quest.4F0E57C110000018.title: "Squeezer"
	quest.4F0E57C110000019.quest_desc: ["Bronze gears on another casing. Wheat, saplings, or cactus become biomass. Mulch is the leftover the squeezer already made."]
	quest.4F0E57C110000019.title: "Fermenter"
	quest.4F0E57C11000001A.quest_desc: ["Redstone and glass around a casing. Biomass in, ethanol out. That is the fuel line."]
	quest.4F0E57C11000001A.title: "Still"
	quest.4F0E57C11000001B.quest_desc: ["Gold, glass, a chest, and a sturdy casing. Melt sand into liquid glass and print electron tubes."]
	quest.4F0E57C11000001B.title: "Thermionic Fabricator"
	quest.4F0E57C11000001C.quest_desc: ["Four copper tubes. Same recipe, swap the metal: gold tubes run alveary fans and heaters."]
	quest.4F0E57C11000001C.title: "Electron Tubes"
	quest.4F0E57C11000001D.quest_desc: ["The desk needs a portable analyzer first - tin, glass, redstone, and a diamond in the carpenter. Genomes stop being a guess."]
	quest.4F0E57C11000001D.title: "Analyzer"
	quest.4F0E57C11000001E.quest_desc: ["[Optional] Tin gears and a casing. Iodine capsules start rain; dissipation charges stop it. Two iodine so you can actually try it."]
	quest.4F0E57C11000001E.title: "[Optional] Rainmaker"
	quest.4F0E57C11000001F.quest_desc: ["Copper gears and a casing. Wheat composts into mycelium and mossy stone. Fertilizer if you would rather farm than wait."]
	quest.4F0E57C11000001F.title: "Moistener"
	quest.4F0E57C110000020.quest_desc: ["Four stringy combs. Iron-mesh dirt finds them if your bees will not. Cocoa combs centrifuge into beans."]
	quest.4F0E57C110000020.title: "Stringy Comb"
	quest.4F0E57C110000021.quest_desc: ["Four frozen combs. Gold-mesh dirt, or a wintry hive if you breed that far. Snowballs and crystalline pollen in the centrifuge."]
	quest.4F0E57C110000021.title: "Frozen Comb"
	quest.4F0E57C110000022.quest_desc: ["Four silky combs from diamond-mesh dirt. Centrifuge to silky propolis, then silk wisps. That is how alveary sieves get woven silk."]
	quest.4F0E57C110000022.title: "Silky Comb"
	quest.4F0E57C110000023.quest_desc: ["[Optional] Eight mundane combs. Curious hives and gold-mesh dirt if Magic Bees is loaded. They centrifuge into a little magic wax."]
	quest.4F0E57C110000023.title: "[Optional] Mundane Comb"
	quest.4F0E57C110000024.quest_desc: ["Glass and iron around an alveary block. Humidity is the first climate knob. No tubes required."]
	quest.4F0E57C110000024.title: "Hygroregulator"
	quest.4F0E57C110000025.quest_desc: ["Gold tubes and iron on an alveary block. Cools the box. The fabricator line is how you get the tubes."]
	quest.4F0E57C110000025.title: "Alveary Fan"
	quest.4F0E57C110000026.quest_desc: ["Same gold tubes, plus stone. Heats the box. Fan and heater together cover most biomes the grid does not have."]
	quest.4F0E57C110000026.title: "Alveary Heater"
	quest.4F0E57C110000027.quest_desc: ["[Optional] Iron and woven silk on an alveary block. Silk wisps from silky combs, then the carpenter. Pollen is what falls out."]
	quest.4F0E57C110000027.title: "[Optional] Alveary Sieve"
	quest.4F0E57C110000028.quest_desc: ["Fan, heater, and hygroregulator. That is a climate-controlled alveary, which is as close to a bee factory as Forestry gets without another mod. Coins and jelly."]
	quest.4F0E57C110000028.title: "Bee Factory"
	quest.4F0E57C110000029.quest_desc: ["[Optional] Four structure boxes. Scented planks and iron bars. The export hatch is the hopper face so the hive empties itself."]
	quest.4F0E57C110000029.title: "[Optional] Modular Factory"
	quest.4F0E57C11000002A.quest_desc: ["Woven silk in the carpenter - four silk wisps and water. The shirt is the chest piece. Bees sting less when you look the part."]
	quest.4F0E57C11000002A.title: "Apiarist's Shirt"
	quest.4F0E57C11000002B.quest_desc: ["[Optional] Hat, shirt, pants, and shoes. Same woven silk, different shapes. A Sky Coin if you finish the suit."]
	quest.4F0E57C11000002B.title: "[Optional] Full Suit"
	quest.51C0EE41256298CA.quest_desc: ["Creepers on a one-block island are a short argument. Gunpowder is fireworks and TNT, if you still have a platform afterwards."]
	quest.51C0EE41256298CA.title: "Keep Your Distance"
	quest.5A1927C67E3AB280.quest_desc: ["Piglin brutes do not trade and do not forgive gold. Three is enough."]
	quest.5A1927C67E3AB280.title: "Brute Force"
	quest.5C1E3A7B9D0F2E4C.quest_desc: ["Flame drifters do not belong over a void. Molten metal ingots do."]
	quest.5C1E3A7B9D0F2E4C.title: "Walking Fire"
	quest.5EEFAD0ACCE45EA5.quest_desc: ["Witches throw bottles from neighbouring blocks. Glass bottles are the consolation prize."]
	quest.5EEFAD0ACCE45EA5.title: "Brewing Trouble"
	quest.628F04FD6B701B91.quest_desc: ["Guardians are an ocean monument problem. The crystals are worth the swim."]
	quest.628F04FD6B701B91.title: "Prismarine Watch"
	quest.670F7E0F274E2049.quest_desc: ["Ender IO binds mob souls into machines. XP bottles soften the cost."]
	quest.670F7E0F274E2049.title: "Soul Binder"
	quest.67861E90BB715031.quest_desc: ["Frostbitten golems are slow until they are not. The shield is worth the bruises."]
	quest.67861E90BB715031.title: "Frozen Guard"
	quest.6961D39AA71EC5BC.quest_desc: ["Ten zombies. They spawn in the dark between blocks, which is most of the world. Golden carrots are a start."]
	quest.6961D39AA71EC5BC.title: "Walking Dead"
	quest.6A45FE8D5B3D6B35.quest_desc: ["Silent Gear tools are assembled, not crafted once. The blueprint package is the instruction booklet."]
	quest.6A45FE8D5B3D6B35.title: "Blueprints"
	quest.6A5E0C7A00000001.quest_desc: [
		"Soulium gates the Soulium Dagger, mob chunks and every soul-based essence in Mystical Agriculture. There are two ways to get it here, and neither is the one a wiki will tell you."
		""
		"&eSoulium Ore now generates in the Nether.&r Soulstone and Soulium Ore were added to the Nether grid pool in this update. They are uncommon - bring a pick and patience. &7Chunks generated before the update will not contain them, so travel out to fresh territory.&r"
		""
		"&eThe Occultism Dimensional Mineshaft&r with an Eldritch miner spirit pulls Soulium Blocks, and it is the only source that scales."
		""
		"It is also the only source of &6Prosperity Shards&r, which every Mystical Agriculture seed is built from. If you intend to go deep here, the Occultism chapter is not optional."
		""
		"&7Mystical Agriculture's config still claims Soulstone generates in the world. On a skygrid that setting does nothing - worldgen features never run. The grid pool is the only thing that decides what exists.&r"
	]
	quest.6A5E0C7A00000001.quest_subtitle: "Two routes, neither obvious"
	quest.6A5E0C7A00000001.title: "Where Soulium Comes From"
	quest.6BEE0C7A10000001.quest_desc: [
		"Forestry is breeding. Productive Bees is production - combs that come out as ore."
		""
		"&eThere are no wild nests on this grid.&r Every nest in this chapter is one you carve yourself out of a block you already own, which means you are never waiting on worldgen to hand you a species. You choose what you keep."
		""
		"&7Forestry and Productive Bees do not compete. Run both.&r"
	]
	quest.6BEE0C7A10000001.quest_subtitle: "Nothing here is wild"
	quest.6BEE0C7A10000001.title: "Nothing Wild Here"
	quest.6BEE0C7A10000002.quest_desc: [
		"Glass panes and a button. The jar holds one bee and shows you what it is."
		""
		"&7Right-click a bee to catch it, right-click a nest or hive to put it back. You will be doing this constantly - make several.&r"
	]
	quest.6BEE0C7A10000002.title: "Bee Jar"
	quest.6BEE0C7A10000003.quest_desc: [
		"An iron sword and a block of stone. That is the whole recipe."
		""
		"Every nest works the same way: sword plus the block the bee lives in. Sand, gravel, glowstone, obsidian, soul sand, end stone - if you can get the block, you can carve the nest."
		""
		"&eThis is why bees work on a skygrid at all.&r You are not hunting for nests in a world that has none. You are making them."
	]
	quest.6BEE0C7A10000003.quest_subtitle: "Sword plus block"
	quest.6BEE0C7A10000003.title: "Carve a Nest"
	quest.6BEE0C7A10000004.quest_desc: [
		"A slab over a chest. Fill the chest with flowers or the right food and your bees stop wandering off to look for it."
		""
		"&7Bees that cannot feed do not produce. On a grid there is no meadow next door - the feeder is not optional here the way it is in a normal world.&r"
	]
	quest.6BEE0C7A10000004.title: "Feeding Slab"
	quest.6BEE0C7A10000005.quest_desc: [
		"A honeycomb and a honey bottle. Treats are how you breed, tame and move bees around."
		""
		"&7Keep a stack. Everything downstream of here eats them.&r"
	]
	quest.6BEE0C7A10000005.title: "Honey Treat"
	quest.6BEE0C7A10000006.quest_desc: [
		"The real hive. Holds more bees than a nest, accepts upgrades, and tells you what is going on inside."
		""
		"&7Any wood works. The oak one is listed here because oak is what the grid gives you first.&r"
	]
	quest.6BEE0C7A10000006.title: "Advanced Beehive"
	quest.6BEE0C7A10000007.quest_desc: [
		"Stack a box on the hive and it holds more bees. Stack several and it holds more still."
		""
		"&7Vertical is cheap on a skygrid. You have nothing but vertical.&r"
	]
	quest.6BEE0C7A10000007.title: "Expansion Box"
	quest.6BEE0C7A10000008.quest_desc: [
		"Iron and a grindstone. This is the machine that turns combs into the things combs are made of."
		""
		"&eWithout a centrifuge your combs are decoration.&r Build it early."
	]
	quest.6BEE0C7A10000008.quest_subtitle: "Combs into resources"
	quest.6BEE0C7A10000008.title: "The Centrifuge"
	quest.6BEE0C7A10000009.quest_desc: ["Iron, a hay block and a daylight detector. Feed it a treat and a bee and you get a baby bee, which is how you scale a species instead of guarding your only one."]
	quest.6BEE0C7A10000009.title: "BaBee Incubator"
	quest.6BEE0C7A1000000A.quest_desc: [
		"A dispenser wrapped in iron. Point it at a hive and it collects bees for you."
		""
		"&7The first step out of doing this by hand.&r"
	]
	quest.6BEE0C7A1000000A.title: "Catcher"
	quest.6BEE0C7A1000000B.quest_desc: [
		"Soul sand, quartz and nether gold nests all carve the same way - sword plus the block."
		""
		"&eYou do not need to find a nest in the Nether. You need to bring the blocks home.&r Take a silk touch pick and a bag."
	]
	quest.6BEE0C7A1000000B.quest_subtitle: "Bring the blocks home"
	quest.6BEE0C7A1000000B.title: "Nether Nests"
	quest.6BEE0C7A1000000C.quest_desc: ["End stone carves into a nest like anything else. The bees that live in it are worth the trip."]
	quest.6BEE0C7A1000000C.title: "End Stone Nest"
	quest.6BEE0C7A1000000D.quest_desc: [
		"Iron, a comparator and a crafting table. The indexer reads a Gene Sample out of a bee so you can put its traits into another one."
		""
		"&7Productivity, tolerance, weather, behaviour - this is where a hive stops being luck and starts being design.&r"
	]
	quest.6BEE0C7A1000000D.quest_subtitle: "Breeding on purpose"
	quest.6BEE0C7A1000000D.title: "Gene Indexer"
	quest.6BEE0C7A1000000E.quest_desc: [
		"A centrifuge, redstone and two Mekanism control circuits. Runs on power instead of patience."
		""
		"&7This is the point where bees become a production line rather than a hobby.&r"
	]
	quest.6BEE0C7A1000000E.title: "Powered Centrifuge"
	quest.6BEE0C7A1000000F.quest_desc: ["Honey in, power out. Modest numbers, but it runs on something your hives already make and never stops."]
	quest.6BEE0C7A1000000F.title: "Honey Generator"
	quest.6BEE0C7A10000010.quest_desc: [
		"Copper blocks, time upgrades and an inactive dragon egg."
		""
		"&eThe egg is the gate.&r One dragon, one egg, one heated centrifuge - so think about whether you want this or the other things an egg can become."
		""
		"&7Faster processing and outputs the plain centrifuge cannot reach.&r"
	]
	quest.6BEE0C7A10000010.quest_subtitle: "The egg is the gate"
	quest.6BEE0C7A10000010.title: "Heated Centrifuge"
	quest.6BEE0C7A10000011.quest_desc: [
		"Sand, gravel, snow. The softer the block, the cheaper the sword."
		""
		"&eNest tier is set by the block, not the bee.&r A wooden sword carves anything soft; stone and slime want iron; obsidian and nether gold want diamond. Plan your carving trips around which sword you are carrying."
	]
	quest.6BEE0C7A10000011.quest_subtitle: "The block sets the tier"
	quest.6BEE0C7A10000011.title: "Wooden Sword Work"
	quest.6BEE0C7A10000012.quest_desc: [
		"Reed and grass nests hold the quiet bees - the ones that make the treats and wax everything else depends on."
		""
		"&7Neither block is rare. Both are easy to forget until you need forty treats and have none.&r"
	]
	quest.6BEE0C7A10000012.title: "Reed and Meadow"
	quest.6BEE0C7A10000013.quest_desc: ["Still a wooden sword. Glowstone is soft - the trip to get it is the expensive part, not the carving."]
	quest.6BEE0C7A10000013.title: "Glowstone Nest"
	quest.6BEE0C7A10000014.quest_desc: ["Iron sword and a slime block. Slime on a skygrid means a slime chunk or a swamp hut, neither of which you have - so this one comes from bees, mobs, or the Trading Post."]
	quest.6BEE0C7A10000014.title: "Slimy Nest"
	quest.6BEE0C7A10000015.quest_desc: ["Iron sword and nether bricks. Bricks are a fortress block, which on this grid means the Nether pool or a crafting table."]
	quest.6BEE0C7A10000015.title: "Nether Brick Nest"
	quest.6BEE0C7A10000016.quest_desc: [
		"Diamond sword. Obsidian is the hardest thing you will carve, and the bees inside are worth the diamond."
		""
		"&7Obsidian is in the overworld pool, so you do not need a portal to find it - but water and lava make more of it than the grid will.&r"
	]
	quest.6BEE0C7A10000016.title: "Obsidian Nest"
	quest.6BEE0C7A10000017.quest_desc: [
		"Diamond sword and nether gold ore - the ore block itself, not the gold."
		""
		"&eDo not smelt it.&r Carry the ore home whole or you have nothing to carve."
	]
	quest.6BEE0C7A10000017.quest_subtitle: "Carry the ore home whole"
	quest.6BEE0C7A10000017.title: "Nether Gold Nest"
	quest.6BEE0C7A10000018.quest_desc: [
		"Every hive upgrade starts here. The base is inert on its own - it is the frame the real upgrades are built onto."
		""
		"&7Make a stack. You will want more than you think.&r"
	]
	quest.6BEE0C7A10000018.quest_subtitle: "The frame for everything"
	quest.6BEE0C7A10000018.title: "Upgrade Base"
	quest.6BEE0C7A10000019.quest_desc: ["More combs per cycle from the same bees. Alpha is the first of four tiers, and the difference compounds across a wall of hives."]
	quest.6BEE0C7A10000019.title: "Productivity Alpha"
	quest.6BEE0C7A1000001A.quest_desc: [
		"Bees work faster. Stacks with productivity rather than competing with it."
		""
		"&7Speed upgrades are also what the Heated Centrifuge wants, so make spares.&r"
	]
	quest.6BEE0C7A1000001A.title: "Upgrade: Speed"
	quest.6BEE0C7A1000001B.quest_desc: ["Pollen out of a hive without opening it. Feeds the Bottler and anything else that wants raw pollen."]
	quest.6BEE0C7A1000001B.title: "Pollen Sieve"
	quest.6BEE0C7A1000001C.quest_desc: [
		"Samples genes from bees in the hive automatically, so you are not standing there with an indexer and a jar."
		""
		"&eThis is where selective breeding stops being manual labour.&r"
	]
	quest.6BEE0C7A1000001C.title: "Gene Sampler"
	quest.6BEE0C7A1000001D.quest_desc: [
		"The hive behaves as though conditions are perfect regardless of what is actually outside."
		""
		"&eOn a skygrid this is the upgrade that matters most.&r There is no biome out there, no weather worth the name, and nothing resembling the habitat a picky bee wants. The Simulator makes that stop being your problem."
	]
	quest.6BEE0C7A1000001D.quest_subtitle: "There is no biome out there"
	quest.6BEE0C7A1000001D.title: "Simulator"
	quest.6BEE0C7A1000001E.quest_desc: [
		"Turns honeycombs into treats without a crafting grid, and fills bottles and buckets while it is at it."
		""
		"&7The point at which you stop hand-crafting treats one at a time.&r"
	]
	quest.6BEE0C7A1000001E.title: "Bottler"
	quest.6BEE0C7A1000001F.quest_desc: [
		"A fishing rod and a treat. Bees follow it."
		""
		"&7Far less painful than jarring a bee every time you want to move it three blocks.&r"
	]
	quest.6BEE0C7A1000001F.title: "Treat on a Stick"
	quest.6BEE0C7A10000020.quest_desc: [
		"A dragon egg and a beehive."
		""
		"&eThe second egg problem.&r The Heated Centrifuge wanted one too, and the grid gives you exactly one dragon per End unless you can respawn her. Decide which of the two you want first, or go and earn another."
		""
		"&7The hive at the end of the chapter. Everything above it exists to make this worth building.&r"
	]
	quest.6BEE0C7A10000020.quest_subtitle: "The second egg problem"
	quest.6BEE0C7A10000020.title: "Dragon Egg Hive"
	quest.6C9F0E2E60F5F6EA.quest_desc: ["Legendary Monsters guards patrol with more health than they should. A deactivated summoner is the drop."]
	quest.6C9F0E2E60F5F6EA.title: "Haunted Watch"
	quest.6CA5A37A9A4E45F5.quest_desc: ["Ender IO starts here. The Alloy Smelter turns mixed metals into the alloys the rest of the chapter wants."]
	quest.6CA5A37A9A4E45F5.title: "Alloy Smelter"
	quest.6EDDF9F8FF5B7817.quest_desc: ["Four lapis blocks. Enchanting is a lapis problem before it is an XP problem."]
	quest.6EDDF9F8FF5B7817.title: "Lapis Reserve"
	quest.70F8B7F2213E0799.quest_desc: ["Blazes live on Nether spawners. Blaze powder is brewing, Eyes of Ender, and a lot of later machines."]
	quest.70F8B7F2213E0799.title: "Powder Keg"
	quest.713EC32D165901A9.quest_desc: ["Ender IO's enchanter spends lapis and XP at a desk instead of a table."]
	quest.713EC32D165901A9.title: "Ender Enchanter"
	quest.74FA7E69EC3DD129.quest_desc: ["Drowned appear wherever you have made water. Nautilus shells are slow to come by any other way."]
	quest.74FA7E69EC3DD129.title: "From the Deep"
	quest.77F6E4811C26BA3A.quest_desc: ["Eight blue ice. Packed ice in the reward is for the floor you will actually walk on."]
	quest.77F6E4811C26BA3A.title: "Ice Highways"
	quest.7874E19552A19DEF.quest_desc: ["A spawner you chose. Soul filters keep it from summoning the wrong argument."]
	quest.7874E19552A19DEF.title: "Powered Spawner"
	quest.79BA840C25241E40.quest_desc: ["Four crimson iron ingots. Crimson steel is the upgrade, and the reward is a head start."]
	quest.79BA840C25241E40.title: "Crimson Iron"
	quest.7B35FA71E0049284.quest_desc: ["A nether star fragment is Silent Gear's way of spending a star without losing the whole thing. The star in the reward is not a joke."]
	quest.7B35FA71E0049284.title: "Star Fragments"
	quest.7CF265FCC476F3A1.quest_desc: ["Blank Silent Gear templates. A sword blade is a hint about what to stamp first."]
	quest.7CF265FCC476F3A1.title: "Template Board"
	quest.7D9F1A3C5E0B2D4F.quest_desc: ["Wandering eyes watch from a distance, then they do not. Eye crystals are the proof."]
	quest.7D9F1A3C5E0B2D4F.title: "Unblinking"
	quest.7E1DD637800B4AC5.quest_desc: ["Eight sculk. Echo shards are the part that crafts into something useful."]
	quest.7E1DD637800B4AC5.title: "Sculk Sample"
	quest.7F3D935878508417.quest_desc: ["Evokers summon fangs on blocks that are not there. Emerald blocks if you survive it."]
	quest.7F3D935878508417.title: "Fang You Very Much"
	task.000000000000FA02.title: "I understand shared claims and teams!"
	task.0000000000010561.title: "Any Wooden Sieve"
}
