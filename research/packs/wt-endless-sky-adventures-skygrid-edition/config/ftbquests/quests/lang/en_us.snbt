	]
	quest.00000000000129B4.title: "Farmer’s Cutting Board"
	quest.00000000000129F8.quest_desc: ["Cook complex meals in the cooking pot. Better food gives better saturation."]
	quest.00000000000129F8.title: "Cooking Pot"
	quest.0000000000012A3C.quest_desc: ["Craft straw from wheat. Used for Farmer’s Delight recipes and mob bedding."]
	quest.0000000000012A3C.title: "Straw"
	quest.0000000000012A80.quest_desc: [
		"Mystical Agriculture lets you grow ores and materials as crops."
		"Inferium seeds are your starting point — grow them to get essence."
	]
	quest.0000000000012A80.title: "Inferium Seeds"
	quest.0000000000012AC4.quest_desc: ["Harvest inferium crops to get essence. Higher tier essence is crafted from inferium."]
	quest.0000000000012AC4.title: "Inferium Essence"
	quest.0000000000012B08.quest_desc: ["Craft prudentium essence from inferium essence to unlock tier 2 Mystical Agriculture crops."]
	quest.0000000000012B08.title: "Prudentium Tier"
	quest.0000000000012B4C.quest_desc: ["Grow iron seeds to produce iron essence, which crafts into iron ingots. Infinite iron!"]
	quest.0000000000012B4C.title: "Iron Seeds"
	quest.0000000000012B90.quest_desc: ["Grow diamonds as a crop. Requires higher tier essence to unlock."]
	quest.0000000000012B90.title: "Diamond Seeds"
	quest.0000000000012BD4.quest_desc: ["BotanyPots grow crops in a small footprint. Fill with the right soil and plant any seed. Any pot colour or hopper pot counts."]
	quest.0000000000012BD4.title: "BotanyPots"
	quest.0000000000012C18.quest_desc: ["Automate crop harvesting with hopper botany pots that self-harvest into chests below."]
	quest.0000000000012C18.title: "Hopper BotanyPot"
	quest.0000000000012C5C.quest_desc: [
		"Productive Bees adds custom bees that produce resources passively."
		"Catch and breed bees to produce iron, gold, diamonds, and more."
	]
	quest.0000000000012C5C.title: "Productive Bees"
	quest.0000000000012CA0.quest_desc: ["Advanced hives process combs automatically into resources. Any wood works."]
	quest.0000000000012CA0.title: "Advanced Hive"
	quest.0000000000012CE4.quest_desc: ["Aquaculture expands fishing with new fish species and tackle. A relaxing source of food."]
	quest.0000000000012CE4.title: "Aquaculture"
	quest.0000000000012D28.quest_desc: ["The highest tier Mystical Agriculture seed. Grow supremium for the best crops."]
	quest.0000000000012D28.title: "Supremium Seeds"
	quest.0000000000012D6C.quest_desc: ["Grow netherite scrap as a crop. The pinnacle of resource automation."]
	quest.0000000000012D6C.title: "Netherite Seeds"
	quest.0000000000012DB0.quest_desc: ["Accelerate crop growth with a watering can. Higher tiers work on larger areas."]
	quest.0000000000012DB0.title: "Watering Can"
	quest.0000000000012DE3.quest_desc: ["The Farming for Blockheads market lets you buy seeds and other farming materials."]
	quest.0000000000012DE3.title: "Farming Market"
	quest.0000000000012E27.quest_desc: ["Cook a complex meal in Farmer’s Delight for full saturation and buffs."]
	quest.0000000000012E27.title: "Fine Dining"
	quest.0000000000012E8D.quest_desc: ["Your farm produces everything from netherite to gourmet food. Fully self-sufficient."]
	quest.0000000000012E8D.title: "Master Farmer"
	quest.0000000000012EE2.quest_desc: ["The IE hammer forms multiblocks and panels. You cannot build IE machines without it."]
	quest.0000000000012EE2.title: "The Engineer’s Hammer"
	quest.0000000000012F26.quest_desc: ["IE uses wires and connectors to transfer power. Copper wire is your first tier."]
