{
	chapter.0000000000010011.title: "Getting Started"
	chapter.000000000001050C.title: "Ex Deorum"
	chapter.0000000000010A7E.title: "Power \\& Energy"
	chapter.0000000000010F35.title: "Create"
	chapter.0000000000011474.title: "Mekanism"
	chapter.0000000000011991.title: "Storage"
	chapter.0000000000011E8C.title: "Magic: Ars Nouveau"
	chapter.00000000000123DC.title: "Magic: Occultism"
	chapter.000000000001292C.title: "Farming \\& Food"
	chapter.0000000000012E9E.title: "Immersive Engineering"
	chapter.00000000000133DD.title: "Cross-Mod Automation"
	chapter.000000000001394F.title: "Endgame"
	chapter.0000000000014000.title: "The Grid"
	chapter.0000000000015000.title: "Trading Post"
	chapter.2C8312DC87E1E9BE.quest_desc: [
		"Tools, armour, enchanting, and the machines that make them."
		"Ender IO and Silent Gear sit alongside vanilla enchanting. The right-hand branch is for rare grid plants and ice."
	]
	chapter.2C8312DC87E1E9BE.title: "Gearing Up"
	chapter.4F0E57C10A1B2C3D.quest_desc: [
		"There are no world hives on this grid. Bees come from sieves, from this chapter, and from whatever you breed afterwards."
		"Forestry CE first. Farms if you stay. The side branches are only if you installed the extra bee mods."
	]
	chapter.4F0E57C10A1B2C3D.title: "Forestry \\& Bees"
	chapter.6BEE0C7A1D2E3F40.title: "Productive Bees"
	chapter.7DEB56670374C084.quest_desc: [
		"The grid has no caves and no villages worth mentioning. What it does have is spawners, and every gap is a spawn point."
		"Vanilla bounties first, then Legendary Monsters. Bring a bridge and a way back."
	]
	chapter.7DEB56670374C084.title: "Hunting \\& Bounties"
	quest.000000000000FA01.quest_desc: [
		"Playing with friends? Everyone shares the same grid.\n\n§6Claim your space:§r Open the map with §bM§r and use FTB Chunks to claim the area where you are building.\n\n§6Share quest progress:§r Open this Quest Book, go to the §bTeams§r tab, create a Party, and invite your friends. Quest progress and rewards are shared with that team.\n\n§7Solo players can ignore this quest.§r"
		"&eFalling returns you to the shared Overworld platform, but bridging carefully is still much faster than taking the long way back.&r"
	]
	quest.000000000000FA01.quest_subtitle: "Server \\& multiplayer setup"
	quest.000000000000FA01.title: "Playing with Friends"
	quest.0000000000010055.quest_desc: [
		"Your starter kit includes oak saplings, but many kinds of logs appear throughout the grid."
		"Grow a tree or bridge to what you can see — any log type counts."
	]
	quest.0000000000010055.title: "First Timber"
	quest.0000000000010088.quest_desc: ["The cornerstone of all crafting. Place 4 planks in a 2x2 grid."]
	quest.0000000000010088.title: "First Crafting Table"
	quest.00000000000100BB.quest_desc: ["Craft a wooden pickaxe to break stone."]
	quest.00000000000100BB.title: "Wooden Tools"
	quest.00000000000100EE.quest_desc: ["Smelt ores, cook food, and make charcoal. An essential essential tool."]
	quest.00000000000100EE.title: "The Furnace"
	quest.0000000000010132.quest_desc: ["Smelt logs in a furnace using a log as fuel to get charcoal."]
	quest.0000000000010132.title: "Burn Baby Burn"
	quest.0000000000010176.quest_desc: [
		"Place water next to lava to create cobblestone."
		"Mine it infinitely for building materials. Cobbled deepslate and mossy cobble count too."
		"&7A generator needs water and lava, and the grid has neither. Ice gives you water; the Ex Deorum crucible gives you lava.&r"
	]
	quest.0000000000010176.title: "Cobblestone Generator"
	quest.00000000000101A9.quest_desc: ["Upgrade your tools. Stone pickaxes mine faster and last longer."]
	quest.00000000000101A9.title: "Stone Age"
	quest.00000000000101ED.quest_desc: [
		"Craft torches using sticks and charcoal. Mobs spawn in darkness."
		"Every gap in the lattice is a valid spawn point, at every height, on all six sides. You are not defending a perimeter here."
	]
	quest.00000000000101ED.title: "Let There Be Light"
	quest.0000000000010231.quest_desc: ["Organize your loot. Craft two chests and place them together for a double chest."]
	quest.0000000000010231.title: "Chest Storage"
	quest.0000000000010264.quest_desc: ["Defend yourself against the mobs that appear at night."]
	quest.0000000000010264.title: "Stone Sword"
	quest.00000000000102A8.quest_desc: [
		"Iron doesn’t spawn in the grid worlds."
		"Use Ex Deorum sieves and meshes to find it from gravel and sand."
	]
	quest.00000000000102A8.title: "First Iron"
	quest.00000000000102DB.quest_desc: ["A significant upgrade. Iron pickaxes can mine diamonds."]
	quest.00000000000102DB.title: "Iron Pickaxe"
	quest.000000000001030E.quest_desc: ["Sharp and reliable. Far better for dealing with mobs."]
	quest.000000000001030E.title: "Iron Sword"
	quest.0000000000010352.quest_desc: [
		"Carry water and lava safely. Essential for creating resources in the grid."
		"&eThere is no water anywhere in this grid.&r Water and lava were removed deliberately - as floating source blocks they cascade and flood the world."
		"&bIce is the answer.&r Break a block of ice while it sits on something solid and it becomes a water source. That trick unlocks farming, cobblestone generators and nearly every machine in this pack."
	]
	quest.0000000000010352.title: "Bucket Brigade"
	quest.0000000000010396.quest_desc: ["Cook cobblestone to get smooth stone, then craft stone bricks for building. Mossy, cracked, and chiseled bricks count."]
	quest.0000000000010396.title: "Stone Bricks"
	quest.00000000000103DA.quest_desc: [
		"Gravel can be hammered into sand using the Ex Deorum hammer."
		"Sand is needed for glass, concrete, and more. Red sand counts."
		"&7Sand falls. A sand block with nothing beneath it drops into the void the moment it is disturbed.&r"
	]
	quest.00000000000103DA.title: "Sandy Shores"
	quest.000000000001041E.quest_desc: ["Smelt sand into glass. You'll need it for beacons, tanks, and decoration. Stained glass is extra work - colorless glass is enough."]
	quest.000000000001041E.title: "Clear Vision"
	quest.0000000000010462.quest_desc: ["Dirt is precious in the grid. Sieve gravel and sand to find it, or compost materials. Grass, coarse dirt, and mud count."]
	quest.0000000000010462.title: "Dirt Rich"
	quest.0000000000010495.quest_desc: ["Protect yourself. Iron armor significantly reduces damage from mobs."]
	quest.0000000000010495.title: "Iron Armor"
	quest.00000000000104FB.quest_desc: [
		"You’ve mastered the basics of skygrid survival."
		"A whole world of mods awaits. Onward!"
	]
	quest.00000000000104FB.title: "Sky’s the Limit"
	quest.0000000000010550.quest_desc: [
		"The wooden crook dramatically improves drops from leaves."
		"Use it to get saplings, string, and silkworms."
	]
	quest.0000000000010550.title: "A Crook for Leaves"
	quest.0000000000010594.quest_desc: [
		"The sieve is your primary ore-finding tool in the grid. Fill it with dirt, gravel, sand, or dust."
		"Any wood works - oak, spruce, crimson, whatever you have. The grid hands you dirt, gravel and sand in bulk but hides its ores. The sieve converts one into the other - it is the loop the whole pack runs on."
	]
	quest.0000000000010594.title: "Build a Sieve"
	quest.00000000000105D8.quest_desc: ["The flint mesh is your first sieve upgrade. Better yields than string mesh."]
	quest.00000000000105D8.title: "Flint Mesh"
	quest.000000000001061C.quest_desc: ["Sieve gravel through a flint mesh to get flint reliably. Essential for fire starters."]
	quest.000000000001061C.title: "Flint from Gravel"
	quest.0000000000010660.quest_desc: ["Upgrade to an iron mesh for better ore yields from sieving."]
	quest.0000000000010660.title: "Iron Mesh"
	quest.00000000000106A4.quest_desc: ["The hammer crushes blocks into smaller forms: cobblestone → gravel → sand → dust."]
	quest.00000000000106A4.title: "Hammer Time"
	quest.00000000000106E8.quest_desc: ["More durable and faster than the stone hammer."]
	quest.00000000000106E8.title: "Iron Hammer"
	quest.000000000001072C.quest_desc: ["Hammer sand into dust. Dust sieves give the best ore yields of any material."]
	quest.000000000001072C.title: "Crushing It"
	quest.0000000000010770.quest_desc: ["Sieve dust through an iron mesh to find iron nuggets. 9 nuggets = 1 ingot."]
	quest.0000000000010770.title: "Nuggets from Nothing"
	quest.00000000000107B4.quest_desc: ["Sieve dust or gravel through an iron mesh to find gold nuggets."]
	quest.00000000000107B4.title: "Gold Fever"
	quest.00000000000107F8.quest_desc: ["Craft a gold mesh for even better rare drops when sieving."]
	quest.00000000000107F8.title: "Gold Mesh"
	quest.000000000001083C.quest_desc: ["Diamonds can be sieved from gravel or dust with a gold mesh. Patient sieving pays off."]
	quest.000000000001083C.title: "Diamond in the Rough"
	quest.0000000000010880.quest_desc: [
		"Place a wooden barrel outside and fill it with water via rain or a bucket. Any wood works."
		"Use it to create dirt, compost, and witchwater."
		"&eThis solves your dirt problem.&r Dirt is finite in the grid and you burn through it on farmland, bridging and sapling beds."
	]
	quest.0000000000010880.title: "The Barrel"
	quest.00000000000108C4.quest_desc: ["Fill a barrel with water and drop in a sapling to create dirt over time."]
	quest.00000000000108C4.title: "Dirt Factory"
	quest.0000000000010908.quest_desc: [
		"The crucible melts cobblestone into lava and wood into water over a heat source."
		"&eThis is the only source of lava in the pack.&r Lava was removed from the grid for the same reason as water."
	]
	quest.0000000000010908.title: "The Crucible"
	quest.000000000001094C.quest_desc: ["Place cobblestone in the crucible over a heat source to generate lava."]
	quest.000000000001094C.title: "Lava on Demand"
	quest.0000000000010990.quest_desc: ["The first mesh tier. Use string (from leaves or silkworms) to craft it."]
	quest.0000000000010990.title: "String Mesh"
	quest.00000000000109D4.quest_desc: ["Emeralds can be sieved from gravel with a gold mesh. Useful for Apotheosis and trading."]
	quest.00000000000109D4.title: "Green Means Go"
	quest.0000000000010A18.quest_desc: ["Sieve soul sand through a diamond mesh (if available) or find ancient debris another way. Netherite awaits."]
	quest.0000000000010A18.title: "Ancient Power"
	quest.0000000000010A6D.quest_desc: ["You’ve unlocked the full sieving chain. Diamond mesh gives the finest yields of all."]
	quest.0000000000010A6D.title: "Master Sifter"
	quest.0000000000010AC2.quest_desc: [
		"The Furnator burns solid fuel to generate RF energy."
		"Place a chest of coal next to it and connect your first machine."
	]
	quest.0000000000010AC2.title: "First Generator"
	quest.0000000000010B06.quest_desc: ["Powah wire transfers energy between generators, cells, and machines."]
	quest.0000000000010B06.title: "Power Lines"
	quest.0000000000010B4A.quest_desc: ["Store RF energy in an energy cell. No more wasting power when machines are idle."]
	quest.0000000000010B4A.title: "Energy Storage"
	quest.0000000000010B8E.quest_desc: [
		"Flux Networks lets you transmit power wirelessly."
		"Place a Flux Plug on your generator and a Flux Point on your machine."
	]
	quest.0000000000010B8E.title: "Flux Networks"
	quest.0000000000010BD2.quest_desc: ["Flux Points receive power from your Flux network and deliver it to machines."]
	quest.0000000000010BD2.title: "Power Distribution"
	quest.0000000000010C05.quest_desc: ["The hardened Furnator produces more RF/t from the same fuel. Upgrade early."]
	quest.0000000000010C05.title: "Upgraded Generator"
	quest.0000000000010C38.quest_desc: ["Upgrade your energy cell to store more RF. You’ll need it when Mekanism comes online."]
	quest.0000000000010C38.title: "Bigger Battery"
	quest.0000000000010C7C.quest_desc: [
		"Place a Thermo Generator between a lava source and water."
		"It generates passive RF indefinitely — no fuel required."
	]
	quest.0000000000010C7C.title: "Thermo Generator"
	quest.0000000000010CAF.quest_desc: ["The Flux Controller manages your entire power network. Monitor input, output, and storage."]
	quest.0000000000010CAF.title: "Network Controller"
	quest.0000000000010CE2.quest_desc: ["Centralized RF storage on your Flux network. Massive capacity for late-game demands."]
	quest.0000000000010CE2.title: "Flux Storage"
	quest.0000000000010D15.quest_desc: ["The core of Powah’s crafting. Place it in an Energizing Orb to craft advanced Powah components."]
	quest.0000000000010D15.title: "Energizing Rod"
	quest.0000000000010D48.quest_desc: ["Place 2 rods in an orb structure to begin energized crafting."]
	quest.0000000000010D48.title: "Energizing Orb"
	quest.0000000000010D8C.quest_desc: ["The core crafting material for advanced Powah items. Craft it in the Energizing Orb."]
	quest.0000000000010D8C.title: "Dielectric Casing"
	quest.0000000000010DBF.quest_desc: ["A major step up in RF/t generation. Can sustain most mid-game power needs."]
	quest.0000000000010DBF.title: "Blazing Furnator"
	quest.0000000000010DF2.quest_desc: ["Powah Reactors are multiblock generators that produce massive RF/t."]
	quest.0000000000010DF2.title: "Reactor Components"
	quest.0000000000010E36.quest_desc: [
		"Build a Powah Reactor multiblock."
		"Controller + cells + rods = enormous power generation."
	]
	quest.0000000000010E36.title: "Reactor Online"
	quest.0000000000010E69.quest_desc: ["The Player Transmitter charges your curio items wirelessly. Never run out of power mid-task."]
	quest.0000000000010E69.title: "Player Power"
	quest.0000000000010E9C.quest_desc: ["The admin flux configurator lets you manage network connections remotely."]
	quest.0000000000010E9C.title: "Flux Configurator"
	quest.0000000000010ECF.quest_desc: ["A huge RF buffer. Keep your machines running even during reactor downtime."]
	quest.0000000000010ECF.title: "Blazing Storage"
	quest.0000000000010F24.quest_desc: ["Your power infrastructure is set. A reactor and a flux network — you’ll never starve for RF again."]
	quest.0000000000010F24.title: "Power Broker"
	quest.0000000000010F79.quest_desc: ["The base crafting material for all early Create machinery. Craft it from andesite and iron nuggets."]
	quest.0000000000010F79.title: "Andesite Alloy"
	quest.0000000000010FBD.quest_desc: ["Cogwheels transmit rotational force. Place them adjacent to transfer rotation between shafts."]
	quest.0000000000010FBD.title: "First Cogwheel"
	quest.0000000000011001.quest_desc: ["Shafts carry rotational force in a straight line. Build your first power network."]
	quest.0000000000011001.title: "Shaft Power"
	quest.0000000000011045.quest_desc: [
		"Place a water wheel in flowing water to generate stress units."
		"A great early-game source of rotational power."
		"&7Needs flowing water, which means the ice trick has to be working first.&r"
	]
	quest.0000000000011045.title: "Water Wheel"
	quest.0000000000011089.quest_desc: ["The mechanical press crushes and presses items. Essential for making sheets and other components."]
	quest.0000000000011089.title: "Mechanical Press"
	quest.00000000000110CD.quest_desc: ["The mixer combines ingredients using rotational force. Needed for brass and many recipes."]
	quest.00000000000110CD.title: "Mechanical Mixer"
	quest.0000000000011111.quest_desc: [
		"Mix copper and zinc ingots in the mechanical mixer to produce brass."
		"Brass unlocks mid-game Create machinery."
	]
	quest.0000000000011111.title: "Brass Age"
	quest.0000000000011155.quest_desc: ["Craft brass casings to house advanced Create machines."]
	quest.0000000000011155.title: "Brass Casing"
	quest.0000000000011199.quest_desc: ["The deployer uses a mechanical arm to interact with blocks and entities automatically."]
	quest.0000000000011199.title: "Deployer"
	quest.00000000000111CC.quest_desc: ["Attach a mechanical harvester to a moving contraption to automate crop harvesting."]
	quest.00000000000111CC.title: "Auto Farm"
	quest.0000000000011210.quest_desc: ["The basin catches outputs from the press and mixer. Required for many crafting recipes."]
	quest.0000000000011210.title: "Basin"
	quest.0000000000011254.quest_desc: ["Connect fluid sources to basins, tanks, and spouts using fluid pipes."]
	quest.0000000000011254.title: "Fluid Pipes"
	quest.0000000000011298.quest_desc: ["Pumps move fluids through pipes. Needs rotational power to operate."]
	quest.0000000000011298.title: "Mechanical Pump"
	quest.00000000000112DC.quest_desc: [
		"Steam engines produce far more stress units than water wheels."
		"Heat a boiler with lava or solid fuel for high-output rotational power."
	]
	quest.00000000000112DC.title: "Steam Engine"
	quest.000000000001130F.quest_desc: ["Automate shapeless and shaped crafting recipes with the mechanical crafter array."]
	quest.000000000001130F.title: "Mechanical Crafter"
	quest.0000000000011353.quest_desc: ["Transmit rotation across long distances with chain drives."]
	quest.0000000000011353.title: "Chain Drive"
	quest.0000000000011386.quest_desc: ["Control the exact RPM of your rotational networks for precise machine operation."]
	quest.0000000000011386.title: "Speed Control"
	quest.00000000000113CA.quest_desc: ["The mechanical arm automatically moves items between inventories and machines."]
	quest.00000000000113CA.title: "Mechanical Arm"
	quest.00000000000113FD.quest_desc: ["Access the inventory of a moving contraption from a fixed block."]
	quest.00000000000113FD.title: "Portable Interface"
	quest.0000000000011463.quest_desc: [
		"Your Create factory is humming."
		"Steam power, automated crafting, and moving contraptions — the grid is truly alive."
	]
	quest.0000000000011463.title: "Fully Automated"
	quest.00000000000114B8.quest_desc: ["The energy cube stores RF and bridges Mekanism with other power systems."]
	quest.00000000000114B8.title: "Mekanism Power"
	quest.00000000000114FC.quest_desc: [
		"Osmium is Mekanism’s primary metal."
		"Sieve gravel or dust to find osmium ore chunks."
	]
	quest.00000000000114FC.title: "Osmium: The Backbone"
	quest.0000000000011540.quest_desc: ["Unlocks Mekanism's ore-processing route. Enrich raw ores into two dusts, then smelt them into two ingots."]
	quest.0000000000011540.title: "Enrichment Chamber"
	quest.0000000000011584.quest_desc: ["The crusher grinds materials into clumps and powders for further processing."]
	quest.0000000000011584.title: "Crusher"
	quest.00000000000115C8.quest_desc: [
		"The purification chamber + crusher + enrichment chamber chain gives you 3x ores."
		"Requires oxygen gas from an electrolytic separator."
	]
	quest.00000000000115C8.title: "3x Ore Processing"
	quest.000000000001160C.quest_desc: ["Split water into hydrogen and oxygen. Oxygen powers 3x processing; hydrogen fuels the gas burner."]
	quest.000000000001160C.title: "Electrolytic Separator"
	quest.0000000000011650.quest_desc: ["Add the chemical injection chamber (using hydrogen chloride) to push to 4x ore output."]
	quest.0000000000011650.title: "4x Processing"
	quest.0000000000011694.quest_desc: ["The full 5-step processing chain with chemical crystallizer produces 5x ores. Maximum efficiency."]
	quest.0000000000011694.title: "5x Processing"
	quest.00000000000116D8.quest_desc: ["Automate infinite water supply for your electrolytic separator and other fluid needs."]
	quest.00000000000116D8.title: "Electric Pump"
	quest.000000000001171C.quest_desc: ["Infuse metals with carbon, redstone, diamond, and more to create alloys."]
	quest.000000000001171C.title: "Metallurgic Infuser"
	quest.0000000000011760.quest_desc: ["The base crafting material for advanced Mekanism machines. Osmium + redstone in the infuser."]
	quest.0000000000011760.title: "Infused Alloy"
	quest.00000000000117A4.quest_desc: ["Infuse infused alloy with diamond for reinforced alloy. Required for tier 3 machines."]
	quest.00000000000117A4.title: "Reinforced Alloy"
	quest.00000000000117D7.quest_desc: [
		"A powerful mining machine that extracts specific ores from the world using filters."
		"&7In a skygrid this pulls specific blocks out of the lattice across a huge radius. Set filters carefully.&r"
	]
	quest.00000000000117D7.title: "Digital Miner"
	quest.000000000001180A.quest_desc: ["Transfer items, fluids, and energy wirelessly between any two points in the world."]
	quest.000000000001180A.title: "Quantum Entangloporter"
	quest.000000000001184E.quest_desc: [
		"Mekanism solar generators produce RF passively during daylight hours."
		"&7Nothing blocks the sky here, so solar is unusually strong in a skygrid.&r"
	]
	quest.000000000001184E.title: "Solar Power"
	quest.0000000000011892.quest_desc: [
		"Wind generators produce RF based on height. Build them high for maximum output."
		"&7Output scales with altitude, and altitude is the one thing this world has plenty of. Build them high.&r"
	]
	quest.0000000000011892.title: "Wind Generator"
	quest.00000000000118C5.quest_desc: ["Build a Mekanism Fission Reactor multiblock for enormous power generation."]
	quest.00000000000118C5.title: "Fission Reactor"
	quest.00000000000118F8.quest_desc: ["Automate crafting recipes using encoded formulas. Pairs beautifully with AE2 or RS."]
	quest.00000000000118F8.title: "Formulaic Assemblicator"
	quest.000000000001192B.quest_desc: ["Build a Mekanism Induction Matrix for multi-trillion RF storage."]
	quest.000000000001192B.title: "Induction Matrix"
	quest.0000000000011980.quest_desc: ["5x ore processing and an induction matrix. The factory floor is fully operational."]
	quest.0000000000011980.title: "Mekanism Mastery"
	quest.00000000000119D5.quest_desc: ["Storage drawers hold huge amounts of a single item type. Perfect for bulk materials. Any wood and any drawer size counts."]
	quest.00000000000119D5.title: "First Storage Drawer"
	quest.0000000000011A08.quest_desc: ["The drawer controller acts as a hub. Pipe items in and they auto-sort to the correct drawer."]
	quest.0000000000011A08.title: "Drawer Controller"
	quest.0000000000011A4C.quest_desc: ["Sophisticated chests hold more items and can be upgraded with upgrade slots."]
	quest.0000000000011A4C.title: "Sophisticated Storage"
	quest.0000000000011A7F.quest_desc: ["Upgrade to an iron sophisticated chest for more item capacity."]
	quest.0000000000011A7F.title: "Iron Chest Upgrade"
	quest.0000000000011AC3.quest_desc: ["Sophisticated Backpacks add portable storage you can access on the go."]
	quest.0000000000011AC3.title: "Backpack"
	quest.0000000000011B07.quest_desc: [
		"The RS controller is the brain of your Refined Storage network."
		"Connect drives and terminals to it via cable."
	]
	quest.0000000000011B07.title: "Refined Storage Controller"
	quest.0000000000011B4B.quest_desc: ["Insert storage disks into the disk drive to give your RS network storage capacity."]
	quest.0000000000011B4B.title: "Disk Drive"
	quest.0000000000011B8F.quest_desc: ["Your first RS storage disk. Holds 1,000 item types. Upgrade to 4K, 16K, 64K as you progress."]
	quest.0000000000011B8F.title: "1K Storage Disk"
	quest.0000000000011BC2.quest_desc: ["The RS crafting grid lets you craft items using materials in your network directly."]
	quest.0000000000011BC2.title: "Crafting Grid"
	quest.0000000000011BF5.quest_desc: ["Encode crafting patterns to teach your RS network how to auto-craft items."]
	quest.0000000000011BF5.title: "Pattern Grid"
	quest.0000000000011C39.quest_desc: ["The RS crafter sends pattern ingredients to external machines for auto-crafting."]
	quest.0000000000011C39.title: "Auto-Crafter"
	quest.0000000000011C7D.quest_desc: ["Massive storage capacity for your RS network."]
	quest.0000000000011C7D.title: "64K Storage Disk"
	quest.0000000000011CC1.quest_desc: [
		"Applied Energistics 2 is the most powerful storage system available."
		"Start by building a controller and connecting your first drive."
	]
	quest.0000000000011CC1.title: "AE2 Controller"
	quest.0000000000011D05.quest_desc: ["The ME Drive stores cells. Combine multiple drives for massive storage."]
	quest.0000000000011D05.title: "ME Drive"
	quest.0000000000011D38.quest_desc: ["Connect crafting units and a crafting monitor to build a powerful autocrafting system."]
	quest.0000000000011D38.title: "AE2 Autocrafting"
	quest.0000000000011D7C.quest_desc: ["Portable bulk storage. The Dank can hold millions of a single item type in your inventory."]
	quest.0000000000011D7C.title: "Dank Storage"
	quest.0000000000011DAF.quest_desc: ["Colossal Chests are multiblock chests that scale to enormous sizes for bulk storage."]
	quest.0000000000011DAF.title: "Colossal Chest"
	quest.0000000000011DE2.quest_desc: ["Upgraded backpack with more slots and upgrade capability."]
	quest.0000000000011DE2.title: "Iron Backpack"
	quest.0000000000011E26.quest_desc: ["LaserIO uses lasers to transfer items, fluids, and energy wirelessly without routing pipes."]
	quest.0000000000011E26.title: "LaserIO"
	quest.0000000000011E7B.quest_desc: ["Your storage network can hold anything and craft everything on demand."]
	quest.0000000000011E7B.title: "Master of Storage"
	quest.0000000000011ED0.quest_desc: [
		"Ars Nouveau lets you build custom spells from glyphs."
		"Start with the novice spell book and your first glyph."
	]
	quest.0000000000011ED0.title: "The Spell Book"
	quest.0000000000011F14.quest_desc: ["Source is the mana of Ars Nouveau. Fill source jars by placing them near source relays or source gems."]
	quest.0000000000011F14.title: "Source Jars"
	quest.0000000000011F58.quest_desc: ["Sourceberry bushes grow sourceberries that restore source when eaten or fed to a source jar."]
	quest.0000000000011F58.title: "Sourceberries"
	quest.0000000000011F9C.quest_desc: ["Craft spell parchment to write spells onto. Place it in your spellbook to create a usable spell."]
	quest.0000000000011F9C.title: "Spell Parchment"
	quest.0000000000011FE0.quest_desc: ["Glyphs are the building blocks of spells. Amplify increases a spell’s power."]
	quest.0000000000011FE0.title: "First Glyph"
	quest.0000000000012024.quest_desc: ["Relays transfer source between jars. Build a network to keep your source topped up."]
	quest.0000000000012024.title: "Source Relay"
	quest.0000000000012068.quest_desc: ["Imbue items with source to create magical materials like arcane metal and imbued wool."]
	quest.0000000000012068.title: "Imbuement Chamber"
	quest.00000000000120AC.quest_desc: ["The arcane core is the crafting station for advanced Ars Nouveau components."]
	quest.00000000000120AC.title: "Arcane Core"
	quest.00000000000120F0.quest_desc: ["Upgrade your spell book to unlock more complex spells and higher glyph tiers."]
	quest.00000000000120F0.title: "Apprentice Spell Book"
	quest.0000000000012123.quest_desc: ["The Launch glyph is a step toward the coveted Ars Nouveau flight spell."]
	quest.0000000000012123.title: "Flight Prep"
	quest.0000000000012167.quest_desc: ["An eternal light source. Craft it and place it anywhere for permanent illumination."]
	quest.0000000000012167.title: "Jar of Light"
	quest.000000000001219A.quest_desc: ["Wixies are magical familiars that can brew potions automatically."]
	quest.000000000001219A.title: "Wixie"
	quest.00000000000121DE.quest_desc: ["Teleport to a set location. Invaluable for navigating back to your base quickly."]
	quest.00000000000121DE.title: "Magic Mirror"
	quest.0000000000012222.quest_desc: ["The highest tier spell book. Unlock the most powerful glyphs in Ars Nouveau."]
	quest.0000000000012222.title: "Archmage Spell Book"
	quest.0000000000012266.quest_desc: ["The flight glyph combined with self-cast gives you sustained magical flight."]
	quest.0000000000012266.title: "Take Flight"
	quest.00000000000122AA.quest_desc: ["Generates source from nearby plant growth. Place next to a farm for passive source generation."]
	quest.00000000000122AA.title: "Agronomic Sourcelink"
	quest.00000000000122EE.quest_desc: ["Generates source from heat. Place near lava for a fast and reliable source supply."]
	quest.00000000000122EE.title: "Volcanic Sourcelink"
	quest.0000000000012332.quest_desc: ["Drygmies are familiars that produce mob drops passively when near mobs."]
	quest.0000000000012332.title: "Drygmy Charm"
	quest.0000000000012376.quest_desc: ["Whirlisprig familiars accelerate plant growth. Place near your farms for passive crop production."]
	quest.0000000000012376.title: "Whirlisprig"
	quest.00000000000123CB.quest_desc: ["You’ve mastered Ars Nouveau. Spells, familiars, and flight are yours."]
	quest.00000000000123CB.title: "The Archmage"
	quest.0000000000012420.quest_desc: [
		"Tallow is rendered from animal fat and is the base of Occultism crafting."
		"Kill pigs or cows to collect raw fat, then smelt it."
	]
	quest.0000000000012420.title: "First Tallow"
	quest.0000000000012464.quest_desc: ["Craft Otherstone using tallow and stone. The building material of Occultism structures."]
	quest.0000000000012464.title: "Otherstone"
	quest.00000000000124A8.quest_desc: ["A spirit-attuned gem channels spiritual energy. Essential for summoning rituals."]
	quest.00000000000124A8.title: "Spirit-Attuned Gem"
	quest.00000000000124EC.quest_desc: ["Draw a pentacle on the ground to create a ritual circle. The foundation of all summoning."]
	quest.00000000000124EC.title: "The Pentacle"
	quest.0000000000012530.quest_desc: ["Place a ritual dummy at the center of your pentacle to hold the ritual item."]
	quest.0000000000012530.title: "Ritual Dummy"
	quest.0000000000012574.quest_desc: ["The Occultism guidebook. Read it carefully — it contains every ritual and summon you need."]
	quest.0000000000012574.title: "Dictionary of Spirits"
	quest.00000000000125B8.quest_desc: ["Use golden chalk to draw the ritual pentacle on the ground."]
	quest.00000000000125B8.title: "Golden Chalk"
	quest.00000000000125FC.quest_desc: ["Craft Otherstone frames for your storage and summoning infrastructure."]
	quest.00000000000125FC.title: "Otherstone Frame"
	quest.0000000000012640.quest_desc: [
		"Occultism’s dimensional storage uses summoned spirits to store items in other dimensions."
		"Build the storage controller to get started."
	]
	quest.0000000000012640.title: "Spirit Storage"
	quest.0000000000012684.quest_desc: ["Connect your Occultism storage network with a stable wormhole for remote access."]
	quest.0000000000012684.title: "Stable Wormhole"
	quest.00000000000126C8.quest_desc: ["Summon a Foliot miner spirit to mine ores from the spirit dimension for you."]
	quest.00000000000126C8.title: "Foliot Miner"
	quest.000000000001270C.quest_desc: ["Upgrade to a Djinni miner for better ore returns from the spirit dimension."]
	quest.000000000001270C.title: "Djinni Miner"
	quest.0000000000012750.quest_desc: ["The Afrit miner reaches deep dimensions for rare materials."]
	quest.0000000000012750.title: "Afrit Miner"
	quest.0000000000012794.quest_desc: ["The Marid is the most powerful miner spirit. It brings back the rarest ores in quantity."]
	quest.0000000000012794.title: "Marid Miner"
	quest.00000000000127D8.quest_desc: ["Capture mob souls in soul gems to create permanent spirit workers and companions."]
	quest.00000000000127D8.title: "Soul Gem"
	quest.000000000001281C.quest_desc: ["Bind a familiar to a ring and equip it as a curio for passive bonuses."]
	quest.000000000001281C.title: "Familiar Ring"
	quest.000000000001284F.quest_desc: ["Perform advanced summoning rituals to call powerful entities to your aid."]
	quest.000000000001284F.title: "Otherworldly Rituals"
	quest.0000000000012893.quest_desc: ["Access your Occultism dimensional storage from anywhere with a storage remote."]
	quest.0000000000012893.title: "Storage Remote"
	quest.00000000000128C6.quest_desc: ["Craft an ore crusher spirit to automatically process ores passively."]
	quest.00000000000128C6.title: "Spirit Worker"
	quest.000000000001291B.quest_desc: ["Spirits mine for you, store for you, and fight for you. The occult arts are yours."]
	quest.000000000001291B.title: "Master of Spirits"
	quest.0000000000012970.quest_desc: ["Grow wheat on farmland. It’s the foundation of food and many mod recipes."]
	quest.0000000000012970.title: "First Harvest"
	quest.00000000000129B4.quest_desc: [
		"Farmer’s Delight adds realistic cooking mechanics."
