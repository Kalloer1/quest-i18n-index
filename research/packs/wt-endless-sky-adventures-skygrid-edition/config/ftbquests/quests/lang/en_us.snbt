	quest.0000000000012F6A.quest_desc: ["The LV capacitor stores IE energy (IF). Start your power infrastructure."]
	quest.0000000000012F6A.title: "LV Capacitor"
	quest.0000000000012FAE.quest_desc: ["The IE water mill generates IF passively from flowing water."]
	quest.0000000000012FAE.title: "Water Mill"
	quest.0000000000012FF2.quest_desc: [
		"The IE crusher grinds ores into 2x dust output."
		"It’s a multiblock — use the hammer to form it."
	]
	quest.0000000000012FF2.title: "IE Crusher"
	quest.0000000000013036.quest_desc: ["The arc furnace smelts alloys and ores at high volume. A major mid-game upgrade."]
