	quest.000000000001307A.quest_desc: ["Press ingots and plates into gears, rods, and wire using the IE metal press multiblock."]
	quest.000000000001307A.title: "Metal Press"
	quest.00000000000130BE.quest_desc: ["Generate IF from heat differentials. Place between lava and ice/water for passive power."]
