	quest.0000000000013102.quest_desc: ["Upgrade to MV wires for higher throughput power transmission."]
	quest.0000000000013102.title: "MV Wiring"
	quest.0000000000013146.quest_desc: ["The enormous excavator multiblock mines huge veins of ore deposits passively."]
