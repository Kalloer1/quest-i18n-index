	quest.307F887C51E58636.quest_subtitle: "Evolves from Sea Worm"
	quest.307F887C51E58636.title: "&bOcean Aberration"
	quest.33082F6399D7BE3D.quest_desc: [
		"&8&m                                 "
		"&7Cost to evolve: &f2,000,000 EP"
		""
		"&7Health &f+490      &7Spiritual Health &f+3400"
		"&7Aura &f500,000      &7Magicule &f500,000"
		"&7Attack &f+3      &7Attack Speed &f+0.5"
		"&8&m                                 "
		"&7Over &fEnflamed Aberration&7: &a+200 HP&7, &a+3110 Spiritual HP&7, &c-1 Attack&7"
		""
		"&oWhat was once a sculk worm has truly disappeared. This is a monstrosity and there is no going back. It has achieved divinity, possessing an immortal physical body that will never age."
		""
		"&7> Next: &fKing of Hell&7."
	]
	quest.33082F6399D7BE3D.quest_subtitle: "Evolves from Enflamed Aberration"
	quest.33082F6399D7BE3D.title: "&dViolence Deity"
	quest.721351819B120A95.quest_desc: [
		"&8&m                                 "
		"&7Cost to evolve: &f2,000,000 EP"
		""
		"&7Health &f+540      &7Spiritual Health &f+3725"
		"&7Aura &f500,000      &7Magicule &f500,000"
		"&7Attack &f+5      &7Attack Speed &f+1.2"
		"&8&m                                 "
		"&7Over &fLightning Aberration&7: &a+175 HP&7, &a+3425 Spiritual HP&7, &a+1.5 Attack&7"
		""
		"&oWhat was once a sculk worm has truly disappeared. \"The beast stretched from one horizon to the next and belched storms that reminded all of the hero’s promise: that this land – and all those who live here - would never suffer again...\" It has achieved divinity, possessing an immortal physical body that will never age."
		""
		"&7> Next: &fKing of Heaven&7."
	]
	quest.721351819B120A95.quest_subtitle: "Evolves from Lightning Aberration"
	quest.721351819B120A95.title: "&dDissonance Deity"
	quest.3B67FF3D61681B11.quest_desc: [
		"&8&m                                 "
		"&7Cost to evolve: &f2,000,000 EP"
		""
		"&7Health &f+465      &7Spiritual Health &f+4970"
		"&7Aura &f500,000      &7Magicule &f500,000"
		"&7Attack &f+4.5      &7Attack Speed &f+0.75"
		"&8&m                                 "
		"&7Over &fOcean Aberration&7: &a+200 HP&7, &a+4550 Spiritual HP&7, &a+0.75 Attack&7"
		""
		"&oThe pressure that would crush anything else became the thing it prays to."
		""
		"&7> Next: &fKing of the Seas&7."
	]
	quest.3B67FF3D61681B11.quest_subtitle: "Evolves from Ocean Aberration"
	quest.3B67FF3D61681B11.title: "&dAbyss Deity"
	quest.380D64932C59E78D.quest_desc: [
		"&8&m                                 "
		"&7Cost to evolve: &f50,000,000 EP"
		""
		"&7Health &f+2240      &7Spiritual Health &f+27470"
		"&7Aura &f45,000,000      &7Magicule &f5,000,000"
		"&7Attack &f+20      &7Attack Speed &f+3"
		"&8&m                                 "
		"&7Over &fViolence Deity&7: &a+1750 HP&7, &a+24070 Spiritual HP&7, &a+17 Attack&7"
		""
		"&oThe flame line never learned restraint - it learned rule. What was a Violence Deity stopped burning outward and started burning downward, until the heat had somewhere to sit and a throne grew out of it. It keeps the worm's furnace and the ogre's horns, and wears a crown it forged for itself out of both. Awakened as a Demon Lord, fed on flame essence, it is a divine lifeform."
		""
		"&6> End of the line. Nothing evolves past this."
	]
	quest.380D64932C59E78D.quest_subtitle: "Evolves from Violence Deity"
	quest.380D64932C59E78D.title: "&6&lKing of Hell"
	quest.6B96D99DF62AF238.quest_desc: [
		"&8&m                                 "
		"&7Cost to evolve: &f50,000,000 EP"
		""
		"&7Health &f+2490      &7Spiritual Health &f+19970"
		"&7Aura &f45,000,000      &7Magicule &f5,000,000"
		"&7Attack &f+20      &7Attack Speed &f+3"
		"&8&m                                 "
		"&7Over &fDissonance Deity&7: &a+1950 HP&7, &a+16245 Spiritual HP&7, &a+15 Attack&7"
		""
		"&oThe lightning line spent its whole existence discharging into whatever was nearest. A Dissonance Deity finally stopped and listened to the interval between the flash and the sound, and understood that it had been the storm all along, not the thing being struck by it. Awakened as a Hero, fed on lightning essence, it is a divine lifeform - and the only one of the three gods that arrives by the bright road."
		""
		"&6> End of the line. Nothing evolves past this."
	]
	quest.6B96D99DF62AF238.quest_subtitle: "Evolves from Dissonance Deity"
	quest.6B96D99DF62AF238.title: "&6&lKing of Heaven"
