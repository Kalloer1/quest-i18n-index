	task.05C7D3A9CC42F76A.title: "C-Rank \"Intercepting the Vanguard\""
	task.29340F043730F49F.title: "D-Rank \"Depths of the Earth (Pt. 2)\""
	task.3BC4082E9C5DB369.title: "Trial of the Labyrinth"
	quest.7E45F1A10C0DE001.quest_desc: [
		"---------------------------------"
		"&cThe board is empty. Every contract signed, every beast accounted for."
		""
		"What is left is the list the guild never posted - the names it only"
		"whispered, because no hunter came back to confirm them."
		"---------------------------------"
		"&7Locked until all 25 other contracts of this chapter are complete."
		""
		"&7Every boss in this pack carries &l10x&r&7 its normal health."
		"Bring friends, bring Hihi'Irokane, and bring time."
	]
	quest.7E45F1A10C0DE001.quest_subtitle: "Everything the guild ever asked of you, and then the guild itself"
	quest.7E45F1A10C0DE001.title: "&4&lSS-Rank &c\"The Final Contract\""
	quest.B83D1D9BAAAD6384.quest_desc: [
		"---------------------------------"
		"&7A starting race. This is where the path begins."
		""
		"&7Health &f-10   &7Spiritual Health &f+15"
		"&7Aura &f500   &7Magicule &f500"
		"&7Attack &f-0.7   &7Attack Speed &f0"
		"---------------------------------"
		"A Spectral race of monster that lacks intelligence and ambition. They’re usually passive but are incredibly ruthless once provoked."
		""
		"&e> This race has its own chapter. The path continues there."
	]
	quest.B83D1D9BAAAD6384.quest_subtitle: "Starting race"
	quest.B83D1D9BAAAD6384.title: "Slime"
	quest.FD1ADB963BEB33BF.quest_desc: [
		"---------------------------------"
		"&7Requires &f100 Magic Ore&7, consumed on evolution"
		""
		"&7Health &f+40   &7Spiritual Health &f+130"
		"&7Aura &f1,500   &7Magicule &f3,500"
		"&7Attack &f+1   &7Attack Speed &f+0.2"
		"---------------------------------"
		"&7Against &fSlime&7: &a+50 HP, +115 SH, +1.7 ATK"
		""
		"A slime that has taken in large quantities of Magic Ore. The dissolved ore inside of it provides a strong resistance towards most forms of damage."
	]
	quest.FD1ADB963BEB33BF.quest_subtitle: "Evolves from Slime"
	quest.FD1ADB963BEB33BF.title: "Metal Slime"
	quest.EAD05DC04AC4577B.quest_desc: [
		"---------------------------------"
		"&7Requires &f50,000 EP"
		""
		"&7Health &f+50   &7Spiritual Health &f+70"
		"&7Aura &f5,000   &7Magicule &f2,500"
		"&7Attack &f+2.25   &7Attack Speed &f+0.3"
		"---------------------------------"
		"&7Against &fSlime&7: &a+60 HP, +55 SH, +2.95 ATK"
		""
		"The slime that ate the dark instead of the light, and did not choke on it."
	]
	quest.EAD05DC04AC4577B.quest_subtitle: "Evolves from Slime"
	quest.EAD05DC04AC4577B.title: "Abyss Slime"
	quest.D3B54C2BD175FDC8.quest_desc: [
		"---------------------------------"
		"&7No EP cost - this one is reached by &fawakening&7, not by growing."
		""
		"&7Health &f+250   &7Spiritual Health &f+1550"
		"&7Aura &f200,000   &7Magicule &f200,000"
		"&7Attack &f+2   &7Attack Speed &f+0.5"
		"---------------------------------"
