	quest.7C77EC30AD24D1AD.quest_subtitle: "8x Precision Mechanism"
	quest.7C77EC30AD24D1AD.title: "Precision"
	quest.7CB92CDB0B127EC5.quest_desc: ["Eight sigils of enhancement. Every affix on the item, pushed past where it should sit.  &6Rewards a Random Resistance Skill Study Book.&r"]
	quest.7CB92CDB0B127EC5.quest_subtitle: "8x Sigil of Enhancement"
	quest.7CB92CDB0B127EC5.title: "Overcharged"
	quest.7D1F56474BAF8267.quest_desc: "Forty-eight leaves and a cache to hold what you drained. The land goes quiet for a while afterwards."
	quest.7D1F56474BAF8267.title: "Gold Leaf"
	quest.7F50A71B81CEFC65.quest_desc: [
		"---------------------------------"
		"Health - 3000"
		""
		"Spiritual Health - 6000"
		""
		"Armor - 20"
		""
		"Minimum EP - 1400000"
		""
		"Maximum EP - 1600000"
		"---------------------------------"
		"&lMagic Jamming&r: Disable Skills/Magic"
		""
		"A horrifying cloud-dwelling beast has been resurrected via a sacrificed core. It seeks total planetary annihilation."
		""
		"Charybdis: A massive flying threat with 1000 HP. It is surrounded by a fleet of summoned flying Megalodons (30 HP each)."
		""
		"It utilizes ultra-speed regeneration, magic jamming, and gravity manipulation skills, making normal magic or spatial abilities completely useless during the fight."
		""
		"&lCounter&r - If the player has 3.5 times more EP than charybdis (so that would mean ranging from around 4.9 million EP to 5.6 million ep), Magic Jamming will not have any effect."
	]
	quest.7F50A71B81CEFC65.quest_subtitle: "Defeat [Charybdis (Super Boss)]"
	quest.7F50A71B81CEFC65.title: "S-Rank \"Scourge of the Skies\""
	quest.7FC864622143D7D9.quest_desc: [
		"---------------------------------"
		"Health - 48"
		""
		"Spiritual Health - 96"
		""
		"Armor - 2"
		""
		"Minimum EP - 3000"
		""
		"Maximum EP - 6000"
		"---------------------------------"
		"A variant of a Bear except has a Horn like the [Horned Rabbit]"
	]
	quest.7FC864622143D7D9.quest_subtitle: "Kill 1 [Horned Bear]"
	quest.7FC864622143D7D9.title: "E-Rank \"The Bear with a Horn\""
	quest.7FCE4D4EFD736D52.quest_desc: ["Sixteen Ancient Knights. The citadel runs out of knights before you run out of patience.  &6Rewards a Random Intrinsic Skill Study Book.&r"]
	quest.7FCE4D4EFD736D52.quest_subtitle: "Kill 16 Ancient Knight  |  48x Mithril Ingot"
	quest.7FCE4D4EFD736D52.title: "The Citadel Falls"
	quest.8020AD1385B81986.quest_desc: ["Wolves that were already dead once. Killing them again is somebody's idea of a joke."]
	quest.8020AD1385B81986.quest_subtitle: "Kill 10 Spectral Wolf  |  64x Grave Dust"
	quest.8020AD1385B81986.title: "The Spectral Hunt"
	quest.80A83A5E061A8174.quest_desc: ["Four burners, four blazes. The nether is not optional."]
	quest.80A83A5E061A8174.quest_subtitle: "4x Blaze Burner"
	quest.80A83A5E061A8174.title: "Blaze Burners"
	quest.816B26C1D8447465.quest_desc: [
		"Hell has deserts too. They are worse than the ones above, which is saying something."
		""
		"&7You already walked in through the gate. Finish the survey."
	]
	quest.816B26C1D8447465.quest_subtitle: "Stand in the Underworld Sands"
	quest.816B26C1D8447465.title: "&c[Survey] The Sands Below"
	quest.86CC19D7F2467724.quest_desc: [
		"Twenty-five times you convinced an object to be more than it was."
		""
		"&7Lapis is cheap. Levels are not. Choose well."
	]
	quest.86CC19D7F2467724.quest_subtitle: "Enchant 25 items"
	quest.86CC19D7F2467724.title: "&d[Craft] Runeworked"
	quest.889BFE3B2285A93E.quest_desc: "The board splits what the pot cannot. Cook on the skillet and you eat while it fries."
	quest.889BFE3B2285A93E.title: "Knife and Skillet"
	quest.8AA6972F32AD6A1F.quest_desc: "A table and four chairs. Nothing here makes you stronger, and that is fine."
	quest.8AA6972F32AD6A1F.title: "Somewhere to Sit"
	quest.8D027BFCAF6606F6.quest_desc: "Six meals at once, no fuel wasted between them."
	quest.8D027BFCAF6606F6.title: "The Stove"
	quest.8D22B8B955DAA242.quest_desc: ["Fourth tier. The jump from tertium is where most farms stall."]
	quest.8D22B8B955DAA242.quest_subtitle: "64x Imperium Essence"
	quest.8D22B8B955DAA242.title: "Imperium"
	quest.8E1F6357344397AA.quest_desc: ["Farmland that hurries the crop along, and something to pick it for you."]
	quest.8E1F6357344397AA.quest_subtitle: "8x Imperium Farmland  |  1x Harvester"
	quest.8E1F6357344397AA.title: "Growth Accelerated"
	quest.8F9A892B8E7262F4.quest_desc: "Sixteen leaves. Draining the aura around you has a cost - the land goes quiet for a while."
	quest.8F9A892B8E7262F4.title: "Gold Leaf"
	quest.9132695EC0CC9DEB.quest_desc: "Compost and dirt. Crops grow faster on it, and everything in this chapter starts in the ground."
	quest.9132695EC0CC9DEB.title: "Rich Soil"
	quest.932DE688076149E5.quest_desc: [
		"The Underworld is not a punishment. It is a place, and places can be mapped."
		""
		"&7Magicule density here is high enough to reshape what you are. Do not linger without a reason."
	]
	quest.932DE688076149E5.quest_subtitle: "Enter Hell"
	quest.932DE688076149E5.title: "&4[Map] Where the Damned Walk"
	quest.94986D92A91FF3F3.quest_desc: ["The altar, four pedestals and a master crystal. The full setup, nothing skipped."]
	quest.94986D92A91FF3F3.quest_subtitle: "1x Awakening Altar  |  4x Awakening Pedestal  |  1x Master Infusion Crystal"
	quest.94986D92A91FF3F3.title: "The Awakening Altar"
	quest.949EC8F25458C429.quest_desc: ["Sixteen ore blocks, not sixteen shards. Bring a pickaxe and patience."]
	quest.949EC8F25458C429.quest_subtitle: "16x Deepslate Prosperity Ore"
	quest.949EC8F25458C429.title: "Deep Prosperity"
	quest.973FE5349CF8D186.quest_desc: [
		"Older than the Nether that buried it. Nobody knows what it was for."
		""
		"&7Netherite is the only metal in this world that does not care about magicules."
	]
	quest.973FE5349CF8D186.quest_subtitle: "Find Ancient Debris"
	quest.973FE5349CF8D186.title: "&8[Craft] Debris of the Old World"
	quest.9916812F80A980AC.quest_desc: ["Eight sigils of rebirth to feed it. Reforging is a numbers game and the numbers are expensive."]
	quest.9916812F80A980AC.quest_subtitle: "1x Reforging Table  |  8x Sigil of Rebirth"
	quest.9916812F80A980AC.title: "The Reforging Table"
	quest.9CA04A06AE97F7FF.quest_desc: "Upgrades decide what moves and how fast. A pipe without a filter is just a slower hopper."
	quest.9CA04A06AE97F7FF.title: "Filtered"
	quest.A0666CB16D435905.quest_desc: [
		"Built as a test. The people who built it are not around to grade you."
		""
		"&7Copper and cages, all the way down."
	]
	quest.A0666CB16D435905.quest_subtitle: "Find a Trial Chamber"
	quest.A0666CB16D435905.title: "&9[Ruin] Ominous Halls"
	quest.A612D825AEC72D46.quest_desc: [
		"In a hardcore world this is the single most valuable object in existence."
		""
		"&7It works once. Make the once count."
	]
	quest.A612D825AEC72D46.quest_subtitle: "Use a Totem of Undying"
	quest.A612D825AEC72D46.title: "&e[Craft] Cheating Death"
	quest.B11564C894CEC447.quest_desc: ["Third tier. By now the farm should be feeding itself."]
	quest.B11564C894CEC447.quest_subtitle: "64x Tertium Essence"
	quest.B11564C894CEC447.title: "Tertium Fields"
	quest.B233BD2A58A3A9EC.quest_desc: "Four frames. Named for how little they can do - everything Industrial Foregoing builds starts here anyway."
	quest.B233BD2A58A3A9EC.title: "The Pity Frame"
	quest.B2395B1E26B82FFF.quest_desc: [
		"Somebody put it there. Somebody is not coming back for it."
		""
		"&7Curiosity, professionalised."
	]
	quest.B2395B1E26B82FFF.quest_subtitle: "Open 150 chests"
	quest.B2395B1E26B82FFF.title: "&6[Discipline] Grave Robber"
	quest.B5D1DCFA95B9DED6.quest_desc: ["The press is the first machine that pays for itself."]
	quest.B5D1DCFA95B9DED6.quest_subtitle: "1x Mechanical Press"
	quest.B5D1DCFA95B9DED6.title: "Under Pressure"
	quest.B8B03A82D357D585.quest_desc: ["Zinc plus copper, over and over. The second age of the mod."]
	quest.B8B03A82D357D585.quest_subtitle: "64x Brass Ingot"
	quest.B8B03A82D357D585.title: "Brass Age"
	quest.B9E5E9B4C0EE7697.quest_desc: ["It drops from things that were already magical. Start there."]
	quest.B9E5E9B4C0EE7697.quest_subtitle: "32x Arcane Essence"
	quest.B9E5E9B4C0EE7697.title: "Arcane Essence"
	quest.BB2383F5F976C60F.quest_desc: [
		"Nobody is impressed. That is the point of a first step."
		""
		"&7Discipline is measured, not declared."
	]
	quest.BB2383F5F976C60F.quest_subtitle: "Walk 1 kilometre"
	quest.BB2383F5F976C60F.title: "&f[Body] First Thousand Steps"
	quest.BB8C0B0B9346AB70.quest_desc: ["Sixteen. It only spawns deep and it does not spawn often."]
	quest.BB8C0B0B9346AB70.quest_subtitle: "16x Arcane Debris"
	quest.BB8C0B0B9346AB70.title: "Arcane Debris"
	quest.BE5D9221544E081D.quest_desc: ["One crystal, sixty-four prudentium. The bottleneck is deliberate."]
	quest.BE5D9221544E081D.quest_subtitle: "1x Infusion Crystal  |  64x Prudentium Essence"
	quest.BE5D9221544E081D.title: "The Infusion Crystal"
	quest.C07CE38473CBE249.quest_desc: [
		"Stone islands with nothing underneath and nothing above."
		""
		"&7There is no wind here. Write that down. It matters more than it sounds."
	]
	quest.C07CE38473CBE249.quest_subtitle: "Set foot in the End"
	quest.C07CE38473CBE249.title: "&5[Map] The Outer Silence"
	quest.C2F4040CE0037134.quest_desc: "The hopper version picks for you. Now the pot is a machine."
	quest.C2F4040CE0037134.title: "Automatic Harvest"
	quest.C6D037DA4EB32680.quest_desc: "A loaded chunk keeps working while you are somewhere else. Everything you built in the last chapter depends on it."
	quest.C6D037DA4EB32680.title: "Keep It Running"
	quest.C9FBA2E97E8ADD6D.quest_desc: [
		"A capital that lost an argument with the sea."
		""
		"&7Whatever rules it now never needed lungs to take the throne."
	]
	quest.C9FBA2E97E8ADD6D.quest_subtitle: "Find the Sunken City"
	quest.C9FBA2E97E8ADD6D.title: "&1[Ruin] The Drowned Crown"
	quest.CB3F184267534828.quest_desc: "Four pots. A crop in a pot grows without a farm around it - useful where dirt is not."
	quest.CB3F184267534828.title: "Botany Pots"
	quest.CBC8E8EE145B7731.quest_desc: [
		"A desert that earns the second half of its name honestly."
		""
		"&7No landmarks, so you will have to invent some. That is the job."
	]
	quest.CBC8E8EE145B7731.quest_subtitle: "Stand in the Desert of Death"
	quest.CBC8E8EE145B7731.title: "&6[Survey] Where Nothing Drinks"
	quest.CD125AC34993B803.quest_desc: "Three goblins. They trade, and then they are rude about it, and then this happens."
	quest.CD125AC34993B803.title: "Goblin Business"
	quest.CFE4DB3493FD7FEE.quest_desc: "Eight drawers. A chest hides what is inside it; a drawer does not, and that is the whole point."
	quest.CFE4DB3493FD7FEE.title: "Drawers"
	quest.D0275138418F536C.quest_desc: ["Forty-eight mechanisms is a factory, not a workbench. Ignis is what you spend it on."]
	quest.D0275138418F536C.quest_subtitle: "Kill 1 Ignis  |  8x Crushing Wheel  |  48x Precision Mechanism"
	quest.D0275138418F536C.title: "The Forge of Ignis"
	quest.D1F1F9788338E15E.quest_desc: ["Four engines and eight tanks. Water wheels were fine, but they were never this loud."]
	quest.D1F1F9788338E15E.quest_subtitle: "4x Steam Engine  |  8x Fluid Tank"
	quest.D1F1F9788338E15E.title: "Steam and Iron"
	quest.D3095D0199D14720.quest_desc: ["Sixty-four gem dust and a table to break things down. Nothing is wasted, only converted."]
	quest.D3095D0199D14720.quest_subtitle: "1x Salvaging Table  |  64x Gem Dust"
	quest.D3095D0199D14720.title: "Salvager"
	quest.D3E2554D9BB1B040.quest_desc: ["Twelve of them. They come back, which is rather the point."]
	quest.D3E2554D9BB1B040.quest_subtitle: "Kill 12 Necromancer"
	quest.D3E2554D9BB1B040.title: "The Necromancers"
	quest.DDE547F074EA83F4.quest_desc: "One controller turns a wall of drawers into a single inventory. Four diamond upgrades to make it worth pointing at."
	quest.DDE547F074EA83F4.title: "The Controller"
	quest.DE7ACA9DFCC29D0E.quest_desc: ["The Ender Guardian keeps the better case. It is not going to hand it over."]
	quest.DE7ACA9DFCC29D0E.quest_subtitle: "1x Gem Case of House Fabergé  |  Kill 1 Ender Guardian"
	quest.DE7ACA9DFCC29D0E.title: "The Ender Gem Case"
	quest.E3B97D9A9675E0DA.quest_desc: ["Eight blocks of awakened supremium is five hundred and twelve essence. The Leviathan is just the toll."]
	quest.E3B97D9A9675E0DA.quest_subtitle: "8x Awakened Supremium Block  |  16x Imperium Block  |  Kill 1 The Leviathan"
	quest.E3B97D9A9675E0DA.title: "The Whole Field"
	quest.E617F6E7C55CC5DA.quest_desc: ["Four archevokers and thirty-two mithril. The last step before the crown."]
	quest.E617F6E7C55CC5DA.quest_subtitle: "Kill 4 Archevoker  |  32x Mithril Ingot"
	quest.E617F6E7C55CC5DA.title: "Archevoker"
	quest.E94EFF59D50E47EE.quest_desc: "Gold powder on stone. Everything Nature's Aura makes passes over this altar first."
	quest.E94EFF59D50E47EE.title: "The Nature Altar"
	quest.EA3AA410D1CFFEC2.quest_desc: ["Four wheels and twenty-four sheets. Two full crushing setups."]
	quest.EA3AA410D1CFFEC2.quest_subtitle: "4x Crushing Wheel  |  24x Sturdy Sheet"
	quest.EA3AA410D1CFFEC2.title: "Crushing Wheels"
	quest.EA8C467DD317033B.quest_desc: [
		"Nobody left it. Everybody simply stopped being in it."
		""
		"&7The Pact requires you to record the visit, not survive it. Try for both."
	]
	quest.EA8C467DD317033B.quest_subtitle: "Find an Ancient City"
	quest.EA8C467DD317033B.title: "&8[Ruin] The City That Listens"
	quest.EC37FF830007BEB1.quest_desc: [
		"Ten kilometres of the world under your own weight."
		""
		"&7Most people who die out here died tired, not outmatched."
	]
	quest.EC37FF830007BEB1.quest_subtitle: "Walk 10 kilometres in total"
	quest.EC37FF830007BEB1.title: "&f[Body] The Long Road"
	quest.EC45ED514892815F.quest_desc: ["Thirty-two blocks of bone. Do not think about where they came from."]
	quest.EC45ED514892815F.quest_subtitle: "32x minecraft:bone_block  |  48x Grave Dust"
	quest.EC45ED514892815F.title: "The Bone Harvest"
	quest.F2C0C12F65B60E0B.quest_desc: ["Eight sigils of enhancement. Every affix on the item, pushed past where it should sit."]
	quest.F2C0C12F65B60E0B.quest_subtitle: "8x Sigil of Enhancement"
	quest.F2C0C12F65B60E0B.title: "Overcharged"
	quest.F3009B3875983254.quest_desc: [
		"The fight you never have is the one you always win."
		""
		"&7Half an hour of your life spent being deliberately boring."
	]
	quest.F3009B3875983254.quest_subtitle: "Spend 30 minutes crouched"
	quest.F3009B3875983254.title: "&8[Discipline] Ghost"
	quest.F326D7DDD834D404.quest_desc: ["Eight apothecarists and sixty-four essence. They were not using it anyway."]
	quest.F326D7DDD834D404.quest_subtitle: "Kill 8 Apothecarist  |  64x Arcane Essence"
	quest.F326D7DDD834D404.title: "The Apothecarist"
	quest.F3D1ED1038EE3071.quest_desc: [
		"Stripped down to the rock. Something took everything else and did not come back."
		""
		"&7Excellent sightlines. Nothing to hide behind, for you or for them."
	]
	quest.F3D1ED1038EE3071.quest_subtitle: "Stand in the Barren Land"
	quest.F3D1ED1038EE3071.title: "&7[Survey] Bones of the World"
	quest.F89203B74B87E3E5.quest_desc: [
		"Twenty thousand points of the world deciding it disagreed with you and losing."
		""
		"&7Power is a habit before it is a number."
	]
	quest.F89203B74B87E3E5.quest_subtitle: "Deal 20000 damage in total"
	quest.F89203B74B87E3E5.title: "&4[Discipline] Overwhelming"
	quest.FADF97E7D31F58E7.quest_desc: "&6Two supreme frames, a niotic generator, eight netherite upgrades and four ultimate upgrades.&r The factory now runs without you."
	quest.FADF97E7D31F58E7.title: "The Works"
	quest.FE5790187E81D760.quest_desc: "Twenty-four pipes. Carrying things by hand was never the plan."
	quest.FE5790187E81D760.title: "Pipes"
