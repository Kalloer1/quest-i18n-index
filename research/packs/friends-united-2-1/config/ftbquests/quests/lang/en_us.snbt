	quest.6032B894ACE9B90F.quest_desc: [
		"The stack upgrade will improve item or fluid transfer speeds by using a whole stack (64 items) instead of 1 item at a time. It can be combined with speed upgrades to let the device go to the next slot quicker. By using this upgrade, the amount of FE/t that this device draws will increase."
		"Reward: x1 upgrade"
	]
