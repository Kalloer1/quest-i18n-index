	quest.70FD7E73D5C6A52A.title: "Find and Kill a &6Mimic"
	quest.710E553EB0959877.quest_desc: [
		"Welcome to &6Hexerei&r, a rich and &6immersive experience&r filled with mystical covens and enchanting creatures!"
		""
		"Dive into the lore of the dark, nature and soon to come spirit coven, each with their &6unique&r design and &6secrets&r..."
		""
		"For &6getting started&r with the mod, you need to &6craft&r the &cBook of Shadows&r and one &6Altar&r to place the book on it and start reading it!"
	]
	quest.710E553EB0959877.quest_subtitle: "nimbus 2000 huh"
	quest.710E553EB0959877.title: "&fWelcome to&r &6Hexerei"
	quest.7165B11C2F4AF50F.quest_desc: [
		"&6When powered by Rotational Force, an Encased Fan creates an air stream that extends several blocks in front of it.&r "
		""
		"This air stream pushes entities away from the fan or pulls entities towards it depending on the direction of the rotation that the fan receives. "
		""
		"Increasing the rotational speed will lengthen the air stream."
	]
	quest.7165B11C2F4AF50F.quest_subtitle: "Encased Fans are used for moving entities, vertical transport of items, Bulk Washing, Bulk Blasting, Bulk Haunting, and Bulk Smoking."
	quest.7165B11C2F4AF50F.title: "&6Encased Fan&r"
