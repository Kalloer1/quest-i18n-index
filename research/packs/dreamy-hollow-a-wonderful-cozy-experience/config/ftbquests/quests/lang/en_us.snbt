	quest.129DE5F5A107793A.title: "&6Swivel Bearing"
	quest.129E8EE430DCF335.quest_subtitle: "Start with a simple chest, it will be useful. For Beginner players, you can easily start with Tom's Simple Storage Mod."
	quest.129E8EE430DCF335.title: "&6Start with a Chest!&r"
	quest.1311D56D9ED4AD74.quest_desc: [
		"&6The Mechanical Harvester will harvest all mature crops it comes in contact with while moving forward.&r"
		""
		"&6It will then either deposit the items to an inventory on the Contraption or, if no inventories are available&r, it will drop the items on to the ground. &6After harvesting, the plants will be reset to their initial growth state.&r"
	]
	quest.1311D56D9ED4AD74.quest_subtitle: "The Mechanical Harvester is a component used on Contraptions to harvest crops."
	quest.1311D56D9ED4AD74.title: "&6Mechanical Harvester&r"
	quest.135522226FEF0412.quest_desc: [
		"&6The Spout can be filled with up to 1 bucket of any one liquid via Fluid Pipes&r, and it will empty some of &6its fluid onto compatible items that pass under it via a Conveyor Belt or Depot.&r "
		""
		"The spout takes 1 second to process an item regardless of the amount of fluid used, though delay between fills may be caused by the time it takes the spout to fill back up."
	]
	quest.135522226FEF0412.quest_subtitle: "The Spout is used for filling liquid containers such as bottles or buckets, or crafting with liquids."
	quest.135522226FEF0412.title: "&6Spout&r"
	quest.13AA1375C369D755.quest_desc: [
		"To obtain &6Burning Ashes&r, you need to defeat one&6 Ignited Renevant&r in the &cBurning Arena&r and you can summon &6Ignis&r on the top of the Arena."
		""
		"You'll find the &6Altar&r."
		""
		"Be careful because &6Ignis&r is very strong and &6I also suggest&r to enchant your gear at &6Protection IV&r."
