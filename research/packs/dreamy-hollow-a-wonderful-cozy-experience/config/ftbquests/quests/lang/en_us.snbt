	quest.7EE7FE05D8E58BEB.quest_desc: [
		"&6You made it&r, it was hard? For my own experience, it wasn't hard honestly."
		""
		"So, you have finished the questline I guess."
		""
		"I'd like to say that if you enjoyed &bPeaceful Valley&r, let me know in our &6Discord Server&r!"
		""
		"It would be great hearing your own opinion or you just want to share any suggestions with us!"
	]
	quest.7EE7FE05D8E58BEB.quest_subtitle: "play my modpacks :D"
	quest.7EE7FE05D8E58BEB.title: "&bEnd of Peaceful Valley?"
