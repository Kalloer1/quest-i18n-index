	quest.71AB025C41D77590.quest_subtitle: "Hold right-click for 1 second to push nearby enemies and inflict Blazing Brand and release to charge forward and damage enemies in front."
	quest.71AB025C41D77590.title: "&dGauntlet of Bulwark"
