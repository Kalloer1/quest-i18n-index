	quest.75562C54600B4A92.quest_subtitle: "Yeah?"
	quest.755DBD761F769C86.quest_desc: ["The &6Mechanical Fusion Anvil&r is a specialized crafting station and it is used for forging and upgrading very important gears using materials obtained from the Ancient Factory, especially those dropped by the Harbinger boss."]
	quest.755DBD761F769C86.quest_subtitle: "This is Anvil is Special."
	quest.755DBD761F769C86.title: "&6Mechanical Fusion Anvil&r"
	quest.756DD9BBD65DF37E.title: "&6Tablet of Binding&r"
	quest.75E9C6D376A7D673.quest_desc: [
		"&6Chutes can extract items from inventories or belts immediately above them and insert or deposit items on inventories or belts below them.&r "
		""
		"&6Chutes will also collect items that fall upon them and will drop items into empty space if an inventory&r is not immediately below them. "
		""
		"Chutes may be stacked either pure vertically or in a vertical diagonal to form a pipe for moving items."
		""
		"&6And Smart Chutes allow the player to control the types of items passed and their stack size.&r"
	]
	quest.75E9C6D376A7D673.quest_subtitle: "Chutes transport items vertically, generally downward unless an encased fan is used to blow items upward."
	quest.75E9C6D376A7D673.title: "&6Chutes&r"
	quest.75F3868667C22905.title: "&6Glazed Armor Set"
	quest.760987FEF9ECEAD1.quest_desc: [
		"&6This component&r serves as a hub that connects multiple &6Sophisticated Storage&r containers within its range, enabling players to manage their inventories from a &6single interface&r. "
		""
		"Players can position a storage controller near a group of &6sophisticated storage items&r, such as Chests, Barrels, or Shulker Boxes, and it will automatically distribute items to their appropriate &6locations&r."
	]
	quest.760987FEF9ECEAD1.quest_subtitle: "Read Description"
	quest.760987FEF9ECEAD1.title: "&6Storage Controller"
	quest.7766C1BE782B46DD.quest_desc: [
		"&6The Cart Assembler can be placed on Rails.&r "
		""
		"&6When the assembler is powered with redstone&r, blocks placed on top of the assembler will be attached to minecarts that pass through it as a Contraption. "
		""
		"Use Block Attachment Utilities to attach more blocks."
	]
	quest.7766C1BE782B46DD.quest_subtitle: "The Cart Assembler can attach a Contraption to Minecarts that pass through it when supplied with a Redstone signal."
	quest.7766C1BE782B46DD.title: "&6Cart Assembler&r"
