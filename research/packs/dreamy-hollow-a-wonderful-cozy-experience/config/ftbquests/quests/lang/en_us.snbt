	quest.745357E053CAD9C0.title: "&bDiamond Backpack&r"
	quest.749F8DC57BF68556.quest_subtitle: "You can use the Runic Chalk to place spells everywhere."
	quest.749F8DC57BF68556.title: "&6What Can I Do With This?"
	quest.74CAA34EA16F6F55.quest_desc: [
		"&6Redstone Accumulators&r stores a numerical value and increases or decreases it based on incoming redstone signals."
		""
		"While the &6Redstone Inductor&r smooths out signal changes by gradually ramping power up or down."
	]
	quest.74CAA34EA16F6F55.title: "&6Some Redstone Components"
