	quest.4C8C1A35E9A5D99E.quest_desc: [
		"&6When water flows over a Water Wheel, it will begin to rotate. This rotational power can be conveyed to other Components from the Water Wheels' Shaft.&r"
		""
		"Water Wheels can also be powered by Lava, Chocolate, and Bubble Columns."
		""
		"&6As long as the water flows around the wheel in mostly one direction, the Wheel will generate Rotational Force.&r"
	]
	quest.4C8C1A35E9A5D99E.quest_subtitle: "Water Wheel is a source of rotational power. It generates Rotational Force when water flows over it."
