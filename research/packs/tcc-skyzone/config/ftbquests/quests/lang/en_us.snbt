	quest.1EDFBF414B55D56C.quest_desc: ["Place §6Andesite Tunnels§r on either side of a belt to hide it through walls cleanly."]
	quest.1EDFBF414B55D56C.quest_subtitle: "Create"
	quest.1EE7658030431E1A.quest_desc: [
		"The manual will guide you through how to complete this quest line."
		""
		"Powah is a tech mod that adds various ways to generate, store, and transmit... you guessed it... power!"
		""
		"Mod Features:"
		"- Energy Storage (Energy Cell, Ender Network)"
		"- Ender Network (Ender Cell, Ender, Gate)"
		"- Generators (Furnator, Magmatic Generator, Thermoelectric Generator, Solar panel, Reactors)"
		"- Other Machines (Discharger, Energy Hopper, Player Transmitter)"
	]
	quest.1EE7658030431E1A.quest_subtitle: "Powah"
	quest.1EF23C5BD8CB377A.quest_desc: ["§6Pink Relay§r, tier §e5§r of §e16§r. Relays move EMC between blocks and add a bonus per second. Higher tiers transfer far more."]
	quest.1EF23C5BD8CB377A.quest_subtitle: "Project Expansion: Relays"
	quest.1EF23C5BD8CB377A.title: "Pink Relay [MK 5]"
	quest.1EF8A2D45EAD47BD.quest_desc: ["A Diamond-tier barrel: more rows and upgrade slots than Gold."]
	quest.1EF8A2D45EAD47BD.quest_subtitle: "Sophisticated Storage"
	quest.1F2085BCD0225440.quest_desc: ["§6Orange Fuel§r. Dense EMC fuel refined from matter, feeding the upper machine tiers."]
	quest.1F2085BCD0225440.quest_subtitle: "Project Expansion: Fuel"
	quest.1F2085BCD0225440.title: "Orange Fuel"
	quest.1F30A84BA2B2108C.quest_desc: ["§6Cosmic Injecting Factory§r. Processes many items at once. Higher tiers add more slots and speed."]
	quest.1F30A84BA2B2108C.quest_subtitle: "Extras: Factories"
	quest.1F30A84BA2B2108C.title: "Cosmic Injecting Factory"
	quest.1F40FE21EC2AEF22.quest_desc: ["A sword with 4 attack damage."]
	quest.1F40FE21EC2AEF22.quest_subtitle: "Minecraft"
	quest.1F4977A1BBD1FEEE.quest_desc: ["Extends a run of matching blocks outward. Sneak-right-click air to change mode."]
	quest.1F4977A1BBD1FEEE.quest_subtitle: "BetterBlockz"
	quest.1F4AEFBB6E04F477.quest_desc: ["A combined import/export bus with greatly expanded filtering and throughput."]
	quest.1F4AEFBB6E04F477.quest_subtitle: "Advanced AE"
	quest.1F6B75D2715BD8A2.quest_desc: ["Storage bus filtered with a number, so it only stores up to that quantity of each item."]
	quest.1F6B75D2715BD8A2.quest_subtitle: "ExtendedAE"
	quest.1F731F3D25019553.quest_desc: ["A block that reflects spell projectiles, useful for routing turret fire around corners."]
	quest.1F731F3D25019553.quest_subtitle: "Ars Elemental"
	quest.1F894A409738DBF4.quest_desc: ["This machines is needed to craft more advanced items and machines, such as more complex machine frames."]
	quest.1F901B2CE53B3F58.quest_desc: [
		"Ingot of the Skies is a powerful metal infused with divine energy. Offer the gods a spirit of calling along with either an infused iron infot or a tainted gold ingot."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.1FC9556F87253DB5.quest_subtitle: "Beginning"
	quest.1FC9556F87253DB5.title: "Forging Ahead"
	quest.1FCBF2B893EEA7D9.quest_desc: ["Control circuits are used to craft several Mekanism items and machines. Tier 6."]
	quest.1FCF25002DEC80BA.quest_desc: ["Special apples that give different buffs! Hold shift while hovering over the apple to see its effects."]
	quest.1FD449A4EB2E1A06.quest_desc: ["The reaction chamber is a machine that uses a ton of power to provide very efficient ways of processing materials. It is used in the creation of various items needed to progress in AdvancedAE as well as offering efficient recipes for other mods."]
	quest.1FD449A4EB2E1A06.quest_subtitle: "Advanced AE"
	quest.2020A9852B63E43E.quest_desc: ["The §6ME Source Jar§r exposes Ars Source to an Applied Energistics network so machines can draw from ME storage."]
	quest.2020A9852B63E43E.quest_subtitle: "Ars Energistique"
	quest.202A8B47E8AE3376.quest_desc: ["LaserIO seeks to replicate the mechanics of EnderIO. Allowing you to interact with items, fluids, energy, and redstone -- all from the same block face! Furthermore, 9 separate configurations can be placed per block face, leading to nearly limitless potential for logistics around transportation of resources. "]
	quest.202A8B47E8AE3376.quest_subtitle: "Laser IO"
	quest.202C97EC62E3FD47.quest_desc: ["Sneak + Right Click in the air to change modes. Right click a drawer to toggle the option."]
	quest.2037B0A5C05A1E7F.quest_desc: ["Redstone control and SCRAM safety wiring for the reactor."]
	quest.2037B0A5C05A1E7F.quest_subtitle: "Reactors"
	quest.2037B0A5C05A1E7F.title: "Fission Logic Adapter"
	quest.2038C02EDD390977.quest_desc: ["§6Infinite Energy Cube§r. Stores Forge Energy. Higher tiers hold and transfer vastly more."]
	quest.2038C02EDD390977.quest_subtitle: "Extras: Storage"
	quest.2038C02EDD390977.title: "Infinite Energy Cube"
	quest.20928758A5B09DCC.quest_desc: ["Osmium tier chestplate from Mekanism Tools."]
	quest.20928758A5B09DCC.quest_subtitle: "Mekanism Tools"
	quest.20928758A5B09DCC.title: "Osmium Chestplate"
	quest.2095B6F8E1E81E75.quest_desc: ["Bottle the Remnant's sandstorm into the §6Wrath of the Desert§r."]
	quest.2095B6F8E1E81E75.quest_subtitle: "Cataclysm"
	quest.2095B6F8E1E81E75.title: "Wrath of the Desert"
	quest.20A4643BD1004B56.quest_desc: ["Refined Glowstone tier hoe from Mekanism Tools."]
	quest.20A4643BD1004B56.quest_subtitle: "Mekanism Tools"
	quest.20A4643BD1004B56.title: "Refined Glowstone Hoe"
	quest.20AA10B19EA9E15F.quest_desc: [
		"At some point, one realizes that a Furnace is just too slow and consuming of resources to use efficiently. The Extraneous Firestarter speeds up a Furnace tthat it is placed on any side of, along with giving it the necessary heat to smelt any sort of material. Note that, while consuming the required aura for this, the natural levels might drop into the negatives, causing diminishing returns."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.20AC9D0A3D0C9811.quest_desc: ["§6Electrum Ingot§r, alloyed from Gold and Redstone Dust in the Foundry. Conducts power for advanced parts."]
	quest.20AC9D0A3D0C9811.quest_subtitle: "Oritech"
	quest.20D62C31A62D10AA.quest_desc: ["The §d§lFusion Reactor§r fuses deuterium and tritium for clean, enormous power. Build the controller."]
	quest.20D62C31A62D10AA.quest_subtitle: "Reactors"
	quest.20D62C31A62D10AA.title: "Fusion Reactor"
	quest.20E32463368357B4.quest_desc: ["Storage upgrade tier 4. Hover over item for details. Upgradable to the Max Storage Upgrade."]
	quest.210F3A7CABB85DC8.quest_desc: ["Right click to instantly harvest leaves, wool, and mushrooms (from mooshrooms). The charge level (V, shift+V) controls the area sheared based on charge."]
	quest.21460544B92AF9B4.quest_desc: ["Infuses blaze rods to make them provide more power for longer"]
	quest.216A0851EAD69DCF.quest_desc: [
		"Take to the skies! Used to craft a wooden jetpack."
		""
		"Jetpacks make use of Forge Energy to allow the player to fly. Higher tier Jetpacks can have greater speed and energy capacity."
		""
		"Jetpacks require Forge Energy to function. They can be charged using a charging block from any mod that supports Forge Energy."
		""
		"The Jetpack engine can be toggled on and off using a keybinding (default V). When the engine is on you can press the Space Bar to fly."
		""
		"Every Jetpack has a Hover Mode, which allows for more precise movements. Enabling this mode (default keybinding H) will cause your Jetpack to hover in place with varying levels of descent. While hovering your Jetpack will consume power."
		""
		"You can change the speed of your Jetpack using Throttle Controls. This is done using the Throttle Control keybindings (default , and .)."
		""
		"Jetpacks can be equipped as an Accessory in the Body slot."
		""
		"Note: If the player wears a Jetpack in both the Accessory slot and the Chestplate slot, the Jetpack in the Chestplate slot will take priority."
	]
	quest.216A0851EAD69DCF.quest_subtitle: "Iron Jetpacks"
	quest.21873AADBA35C6A1.quest_desc: ["Osmium tier pickaxe from Mekanism Tools."]
	quest.21873AADBA35C6A1.quest_subtitle: "Mekanism Tools"
	quest.21873AADBA35C6A1.title: "Osmium Pickaxe"
	quest.219B7ED265976105.quest_desc: ["Mine nether quartz ore in the nether to obtain."]
	quest.21C27FA410438560.quest_desc: ["Catalysts are used in complex crafting recipes. They get harder to craft as they move higher in tiers."]
	quest.21CCF5818B335123.quest_desc: ["Awaken 128 Draconium Ingots."]
	quest.21CCF5818B335123.quest_subtitle: "Master"
	quest.21CCF5818B335123.title: "Awakening"
	quest.21D2F298B32D5B95.quest_desc: [
		"Chisel adds a huge variety of decorative blocks to the game. The mod is very useful for people who like the construction aspect of Minecraft. "
		""
		"Access to new blocks is provided mostly through one tool, the chisel."
		""
		"Right clicking opens the chiseling interface."
	]
	quest.21D2F298B32D5B95.quest_subtitle: "Rechiseled"
	quest.21D5CF2BC04467D4.quest_desc: [
		"The water separator transforms water into Oxygen and Hydrogen."
		""
		"The machine works by putting water in the second slot. It will then generate Hydrogen and Oxygen that you can gather by placing buckets under the tanks."
	]
	quest.21FD5B61FBBCA913.quest_desc: [
		"2Tick acceleration in the midgame! Other options later in progression include the temporal pouch and torcherino.r"
		""
		"Industrial Foregoing: Souls uses souls extracted from Wardens to accelerate your machines. To do it you need to extract souls from a Warden using a Soul Laser Base with a Blue Lens. As always the Stasis Chamber will be your friend."
		""
		"Once you have some souls stored, now you need to place a Soul Surge pointing at the block you want to accelerate and connect it using Soul Pipes to the Soul Laser Base. You can stop the Soul Surge from working by applying a redstone signal to it."
		""
		"Each soul lasts for 15 seconds and makes the machine 4 times faster."
	]
	quest.21FD5B61FBBCA913.quest_subtitle: "Industrial Foregoing Souls"
	quest.2201A958694C7F35.quest_desc: ["Cables (and connectors) can have four different colors (and a base version). These are used to be able to distinguish multiple distinct networks adjacent to each others (to prevent the cables from connecting). A controller will adapt its color to the first colored cable it can find around it and then remember that (unless that color is totally removed)."]
	quest.22029F72D9691499.quest_desc: ["§6Supreme Smelting Factory§r. Processes many items at once. Higher tiers add more slots and speed."]
	quest.22029F72D9691499.quest_subtitle: "Extras: Factories"
	quest.22029F72D9691499.title: "Supreme Smelting Factory"
	quest.220E723BF056F6D6.quest_desc: ["Components are used to craft catalysts. They get harder to craft as they move higher in tiers."]
	quest.222C9E858D850D29.quest_desc: ["Summons a Wixie that auto-crafts items and potions from a Crafting Lectern setup."]
	quest.222C9E858D850D29.quest_subtitle: "Ars Nouveau"
	quest.2230558554C39B34.quest_desc: ["Made of 10,000 tin ingots"]
	quest.22350912A0D709A2.quest_desc: [
		"Growth Accelerators are used to increase the growth rate of the plant planted above them. They can be stacked below each other to provide additional growth speed."
		""
		"Each tier has an increased range, but provide the same amount of growth. Placing the maximum amount of each tier will be just as efficient as using only the max tier. Note that the range is relative to 1 block below the crop."
		""
		"Place them underneath the block your plant is planted on. In the case of crops, that would be underneath the farmland block. Stack additional Growth Accelerators below it for more plant growth speed."
	]
	quest.22350912A0D709A2.title: "Growth Accelerators"
	quest.224198469D23B8E6.quest_desc: ["Tier 1. The only armor pieces in Draconic Evolution for 1.21.1 are the chestplates. Modules are needed to make it function, see JEI."]
	quest.22445BCA99A83E54.quest_desc: ["Bank EMC at the highest tier. Acquire §e8§r Gargantuan Star Omegas."]
	quest.22445BCA99A83E54.quest_subtitle: "Grandmaster"
	quest.22445BCA99A83E54.title: "Colossal Hoard"
	quest.22576BE5F4FD9868.quest_desc: ["Use the digital miner at least once in every dimension."]
	quest.2283BAFB726F6AF7.quest_desc: ["Enables you to automate complex crafting recipes. Putting an inventory on top will allow it to automatically pull items into the crafter."]
	quest.228FC9A995457D3C.quest_desc: ["This block generator has a speed of 32"]
	quest.22A7C83DBB2329ED.quest_desc: ["Craft the §6Final Star§r, the ultimate EMC battery."]
	quest.22A7C83DBB2329ED.quest_subtitle: "Grandmaster"
	quest.22A7C83DBB2329ED.title: "The Final Star"
	quest.22B16AE1B2684DCB.quest_desc: [
		"2For tick acceleration earlier in the game, look up the temporal pouch in JEI!r"
		""
		"This is a small, simple mod that adds various torches that can be used to increase the tick rates of tile entities. In other words: they make machines run faster, crops grow faster, etc..."
		""
		"Place the torch on the ground and right-click to access the GUI."
	]
	quest.22CEF75979B60798.quest_desc: [
		"The Cooking Pot is a workstation where you can both prepare and store a large amount of meals. When placed above any suitable heat source (campfire, open flames, lava, a stove etc.), it will start bubbling, indicating it's ready to cook."
		""
		"The Skillet is a weapon and a portable food-cooking station, which can be operated by hand or as a block. Skillets can process any campfire cooking recipe, taking roughly 20% of the original time to cook each item."
		""
		"The Cutting Board is a workstation where players can break down one item into many outputs, by using a valid tool on it."
	]
	quest.22D54134581E5904.quest_desc: ["Everyone knows that snad is better than sand and dirt. Try growing sugarcane on a block of snad."]
	quest.22E72357B6CD615F.quest_desc: ["Claim §6The Annihilator§r, a void-charged colossal blade."]
	quest.22E72357B6CD615F.quest_subtitle: "Cataclysm"
	quest.22E72357B6CD615F.title: "The Annihilator"
	quest.230FA0B5BC8534A5.quest_desc: ["§6§lThe Final Star§r. The pinnacle of Project Expansion and the ultimate EMC artifact. You have conquered every collector, relay, flower, link and star."]
	quest.230FA0B5BC8534A5.quest_subtitle: "Project Expansion: Capstone"
	quest.230FA0B5BC8534A5.title: "The Final Star"
	quest.232205BA1A02FFF0.quest_desc: ["The §6Dark Matter§r is an component added by ProjectE. It is used to craft Dark Matter tools and armors and is used as a component to create Red Matter."]
	quest.23299DC764A5E12D.quest_desc: ["§6§lDiamond Lasso§r, the master lasso. It captures §dalmost any§r mob, passive or hostile, with no health limit."]
	quest.23299DC764A5E12D.quest_subtitle: "Mob Lassos"
	quest.23299DC764A5E12D.title: "Diamond Lasso"
	quest.232EBBE321BA83A2.quest_desc: ["§6Magenta Relay§r, tier §e4§r of §e16§r. Relays move EMC between blocks and add a bonus per second. Higher tiers transfer far more."]
	quest.232EBBE321BA83A2.quest_subtitle: "Project Expansion: Relays"
	quest.232EBBE321BA83A2.title: "Magenta Relay [MK 4]"
	quest.2334E3E0CB803CB3.quest_desc: ["Iron is the foundation of everything you build. Gather §e1,024§r Iron Ingots."]
	quest.2334E3E0CB803CB3.quest_subtitle: "Apprentice"
	quest.2334E3E0CB803CB3.title: "Iron Will"
	quest.23409F24BCEBF0C5.quest_desc: ["§6Focus of Earth§r. Adds bonus damage from blocks and roots targets in place."]
	quest.23409F24BCEBF0C5.quest_subtitle: "Ars Elemental"
	quest.234B200716CEE3F1.quest_desc: ["A Wind Turbine's giant blades harness the force of the wind to generate power. Each Wind Turbine requires a small 1x5x1 area (horizontally one block). The machine will generate the same power day and night, in sun or rain, but the turbine must have a clear view of the sky (over the rotor housing at the top of the tower). The power output increases linearly with its elevation."]
	quest.23553993065249FB.quest_desc: ["A special item that allows you to choose your luck value when opening Chance Cubes."]
	quest.2358EBCBAFC509DA.quest_desc: ["Cycles a block's variant in a checkerboard pattern. Sneak-right-click to cycle back. Sneak-right-click air to change mode."]
	quest.2358EBCBAFC509DA.quest_subtitle: "BetterBlockz"
	quest.2361F02283F10600.quest_desc: ["§6Basic Compressing Factory§r. Processes many items at once. Higher tiers add more slots and speed."]
