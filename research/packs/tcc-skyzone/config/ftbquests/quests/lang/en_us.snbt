	quest.4915E0D17F4A2E1F.quest_desc: ["The core of Sophisticated Storage. Holds upgrades in its slots and can be raised through copper/iron/gold/diamond/netherite tiers. §7Sneak-right-click with a Storage Tool to manage it.§r"]
	quest.4915E0D17F4A2E1F.quest_subtitle: "Sophisticated Storage"
