	quest.49CCA974C5416EDB.quest_subtitle: "Reactors"
	quest.49CCA974C5416EDB.title: "SPS Port"
	quest.49D1B3EF88869286.quest_desc: ["An Infused Turret that adds Fire Focus power to whatever spell it casts."]
	quest.49D1B3EF88869286.quest_subtitle: "Ars Elemental"
