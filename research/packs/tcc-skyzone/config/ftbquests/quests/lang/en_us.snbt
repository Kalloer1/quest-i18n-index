	quest.1806145159108609.quest_subtitle: "Project Expansion: Matter"
	quest.1806145159108609.title: "Blue Matter"
	quest.18145BEEDFCD3B09.quest_desc: ["§6Gargantuan Star Ein§r. A portable EMC battery, the largest EMC storage in the game. Capacity climbs with each size from §eEin§r to §eOmega§r."]
	quest.18145BEEDFCD3B09.quest_subtitle: "Project Expansion: Greater Stars"
	quest.18145BEEDFCD3B09.title: "Gargantuan Star Ein"
