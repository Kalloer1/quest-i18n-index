	]
	quest.1961612AF6D8AD06.quest_desc: ["A six-headed terror of sea and sky. Summon it with the §6Storm Eye§r and survive the lightning."]
	quest.1961612AF6D8AD06.quest_subtitle: "Cataclysm"
	quest.1961612AF6D8AD06.title: "Scylla"
	quest.19645F031C69B3EB.quest_desc: ["Prosperity Shards are used to craft many of the core items in the mod, including Resource Seeds, Essence Tools and Essence Armor."]
	quest.19653FCE91F4A285.quest_desc: [
