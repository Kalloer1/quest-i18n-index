	quest.4A1445A4A4D63D8A.quest_subtitle: "Extras: Storage"
	quest.4A1445A4A4D63D8A.title: "Basic Tier Installer"
	quest.4A43514C3AAC8261.quest_desc: ["§6Cosmic Centrifuging Factory§r. An Extras-only factory type, available in the four highest tiers."]
	quest.4A43514C3AAC8261.quest_subtitle: "Extras: Factories"
