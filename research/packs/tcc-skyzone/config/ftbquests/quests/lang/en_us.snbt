	quest.571814A9A148A680.quest_subtitle: "Multiblocks"
	quest.571814A9A148A680.title: "Turbine Blade"
	quest.5720FF9BB1596CA1.quest_desc: ["Batteries are used to store RF. Can be used in machines and to charge items. Hover over each battery tier to see capacity and I/O speed."]
	quest.5735F3DABF096132.quest_desc: ["Place liquid plastic in the world for it to harden into plastic sheets."]
	quest.573FB7A2379800A5.quest_desc: ["One of the steps needed to make the endgame less painful"]
	quest.573FB7A2379800A5.quest_subtitle: "Mystical Agriculture"
	quest.576F87C59A3DEA24.quest_desc: ["Burns lava and fuels for steady power, and pairs with a §6Fuelwood Heater§r."]
	quest.576F87C59A3DEA24.quest_subtitle: "Generators"
	quest.576F87C59A3DEA24.title: "Heat Generator"
