	quest.131C107136664967.title: "Absolute Injecting Factory"
	quest.13355E12EBAFEB45.quest_desc: ["The §6Sequenced Gearshift§r runs a programmed list of rotation steps when pulsed with redstone. The brain of moving contraptions."]
	quest.13355E12EBAFEB45.quest_subtitle: "Create"
	quest.136AFDE5AD5E851E.quest_desc: ["Reach the Tier §e7§r §6Dank§r, the largest portable storage in the pack, an entire mass-storage system carried in a single slot."]
