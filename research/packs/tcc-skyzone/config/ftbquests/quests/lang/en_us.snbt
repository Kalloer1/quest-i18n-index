	quest.59C75650D3DF73D7.quest_subtitle: "ExtendedAE"
	quest.59CC1601AE470FA1.quest_desc: ["Craft a §6Desert Eye§r from sandstone, bone, cactus and an Eye of Ender. Use it to call the §cAncient Remnant§r from its tomb, no pyramid required."]
