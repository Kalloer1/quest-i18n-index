	quest.332842533827F298.quest_desc: [
		"Mine ancient debris in the nether and smelt to obtain."
		""
		"Combine four netherite scrap with four gold ingots to make a netherite ingot!"
	]
	quest.333DA241BCF97E3B.quest_desc: ["Made of 10,000 steel ingots"]
	quest.33453A9CE5884461.quest_desc: ["§6Supreme Stamping Factory§r. An Extras-only factory type, available in the four highest tiers."]
	quest.33453A9CE5884461.quest_subtitle: "Extras: Factories"
	quest.33453A9CE5884461.title: "Supreme Stamping Factory"
	quest.334C069543F12A2D.quest_desc: [
		"A lot of activities require a person to be around, most of them for placing blocks into the world. This, really, is a waste of personell in a time where aura can work in its place. The Imperceptible Builder will place any blocks you supply it with for a small amount of aura in return. The builder gathers the blocks for placement from any item container placed on top of it."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.3358A31C7B81C9CB.quest_desc: [
		"See the Minecraft wiki if you don't know how to build a nether portal :)"
		""
		"4Note: A flint and steel is required to light the nether portal, as Fire Spread is disabled by default.r"
	]
	quest.3358A31C7B81C9CB.quest_subtitle: "Minecraft"
	quest.3358A31C7B81C9CB.title: "Into the Nether"
	quest.3369867891992907.quest_desc: [
		"The Charger provides a way to charge supported tools, and Certus Quartz Crystal."
		""
		"Power can be provided via the top or bottom, via either AE2's cables, or other mod power cables. It can accept either AE2's power (AE) or Forge Energy (FE). Items can be inserted or removed from any side. Only the results can be removed, so no need for filters to prevent removing certus crystals instead of charged certus. Can be rotated with a Certus Quartz Wrench in order to facilitate automation."
		""
		"Can be used to create Charged Certus Quartz Crystal from Certus Quartz Crystal, and Meteorite Compass from Compass."
		""
		"To power it manually, place a Wooden Crank on the top or bottom and right-click it until the item is charged."
		""
		"It also acts as the workstation for the Fluix Researcher."
	]
	quest.33779E62A940B27D.quest_desc: ["The §6Precision Mechanism§r is the keystone of advanced Create. Sequenced from a Cogwheel, a Large Cogwheel, an Iron Sheet and a Gold Sheet on the Mechanical Crafter."]
	quest.33779E62A940B27D.quest_subtitle: "Create"
	quest.33D83D703DB763EF.quest_desc: ["Made from clay and bone meal, used to craft unfired porcelain items like crucibles."]
	quest.33F3134668A08D26.quest_desc: [
		"Burns any Fuel (Coal/Wood/etc)."
		""
		"1 Coal = 20,000 RF (Similar to most other mods fuel levels)."
		""
		"Internal storage capacity of 1,000,000 RF"
		""
		"Burns fuel and charges a single item rather quickly."
		""
		"Meant as a stop gap measure to charge items you want to use before you get a fully fledged energy system going."
	]
	quest.33F3134668A08D26.quest_subtitle: "Charging Gadgets"
	quest.33FBEE929807ECFB.quest_desc: [
		"Upgraded from the iron mesh."
		""
		"As you move up in the mesh tiers, the drops from sifting blocks changes. See JEI for details."
	]
