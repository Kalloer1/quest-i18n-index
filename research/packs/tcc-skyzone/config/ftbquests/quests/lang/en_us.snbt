	quest.3B8419C45E4CE791.title: "Osmium Shovel"
	quest.3B8D8DC08B6B8294.quest_desc: ["Craft a §6Desert Eye§r from sandstone, bone, cactus and an Eye of Ender. Use it to call the §cAncient Remnant§r from its tomb, no pyramid required."]
	quest.3B8D8DC08B6B8294.quest_subtitle: "Cataclysm"
	quest.3B8D8DC08B6B8294.title: "Desert Eye"
