	quest.19CD5840F1AEC544.quest_desc: ["Used in multi-thread machines so they can run several crafting jobs at once."]
	quest.19CD5840F1AEC544.quest_subtitle: "ExtendedAE"
	quest.19D20E11741B4592.quest_desc: ["Blends any food into §anutritional paste§r to feed a MekaSuit or canteen."]
