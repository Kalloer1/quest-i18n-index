	quest.48675A769F0D3F9D.quest_desc: ["Put these pieces together to make a kinetic generator that converts wind power into rotational energy."]
	quest.48675A769F0D3F9D.title: "Kinetic Power"
	quest.488E3B98314C6242.quest_desc: ["Harvests crops in a configurable radius (from 3x3 to 9x9) around the pylon and outputs to an inventory above. Place the pylon inside the water block of the farm. The pylon requires a hoe in the pylon inventory, and will consume 1 durability per crop harvest. Unbreakable hoes, such as Mystical Agriculture's Supremium Hoe, can be used."]
	quest.488E3B98314C6242.quest_subtitle: "Pylons"
	quest.488EB6F4DF70142A.quest_desc: ["Special apples that give different buffs! Hold shift while hovering over the apple to see its effects."]
	quest.488FD84129EFCB37.quest_desc: ["§6Lime Power Flower§r, tier §e11§r of §e16§r. A Power Flower is a self-contained collector, relay and condenser in one block, generating EMC on its own."]
	quest.488FD84129EFCB37.quest_subtitle: "Project Expansion: Power Flowers"
	quest.488FD84129EFCB37.title: "Lime Power Flower [MK 11]"
	quest.48944D8DEB5755A3.quest_desc: ["§6Purple Relay§r, tier §e6§r of §e16§r. Relays move EMC between blocks and add a bonus per second. Higher tiers transfer far more."]
