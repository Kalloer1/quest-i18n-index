	quest.13DCA7AF691E7448.quest_subtitle: "Ars Elemental"
	quest.13DFF0B82F19DECF.quest_desc: ["§6Absolute Liquifying Factory§r. An Extras-only factory type, available in the four highest tiers."]
	quest.13DFF0B82F19DECF.quest_subtitle: "Extras: Factories"
	quest.13DFF0B82F19DECF.title: "Absolute Liquifying Factory"
	quest.13E86FB30A4078F6.quest_desc: ["Froststeel can be found in the Frostfield biome of the Undergarden. Consider using the Nature's Compass to find the biome."]
	quest.141B335FEBEEDD31.quest_desc: ["A bulk staple for any base. Gather §e4,096§r Cobblestone."]
	quest.141B335FEBEEDD31.quest_subtitle: "Apprentice"
	quest.141B335FEBEEDD31.title: "Stone Cold"
	quest.14582B862A91C1E6.quest_desc: ["Each of the tiers adds more storage slots and more upgrade slots."]
