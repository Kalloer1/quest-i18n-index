	quest.5F5BB0B31B3A1C26.quest_desc: ["Enables you to automate complex crafting recipes. Putting an inventory on top will allow it to automatically pull items into the crafting table."]
	quest.5F638E60CAFBD6D9.quest_desc: ["The §6Millstone§r grinds inputs slowly with low stress, perfect for early ore doubling and seed extraction."]
	quest.5F638E60CAFBD6D9.quest_subtitle: "Create"
