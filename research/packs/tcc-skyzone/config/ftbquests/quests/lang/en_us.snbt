	quest.3D10A363B07B51F2.title: "Refined Glowstone Helmet"
	quest.3D1449264E180405.quest_desc: ["The Battlemage set trades mana for armor, built for melee casters."]
	quest.3D1449264E180405.quest_subtitle: "Ars Nouveau"
