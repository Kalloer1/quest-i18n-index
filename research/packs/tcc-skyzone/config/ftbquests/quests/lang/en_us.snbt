	quest.26CE98352B37F24A.quest_subtitle: "Oritech"
	quest.26E464976AE71F10.quest_desc: ["§6Yellow EMC Link§r, tier §e12§r of §e16§r. EMC Links import and export items, fluids and raw EMC, the backbone of EMC automation."]
