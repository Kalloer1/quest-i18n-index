	quest.3CB3F209680AB43E.quest_desc: ["§6Purple Collector§r, tier §e6§r of §e16§r. Collectors generate EMC from light. Each tier stores more and produces faster."]
	quest.3CB3F209680AB43E.quest_subtitle: "Project Expansion: Collectors"
	quest.3CB3F209680AB43E.title: "Purple Collector [MK 6]"
