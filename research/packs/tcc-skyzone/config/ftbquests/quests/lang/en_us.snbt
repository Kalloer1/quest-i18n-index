	quest.263580EFE40C382D.title: "Steel Paxel"
	quest.2642AACC04D56761.quest_desc: ["§6Dark EMC Link§r, tier §e2§r of §e16§r. EMC Links import and export items, fluids and raw EMC, the backbone of EMC automation."]
	quest.2642AACC04D56761.quest_subtitle: "Project Expansion: EMC Links"
	quest.2642AACC04D56761.title: "Dark EMC Link [MK 2]"
	quest.26466151D40A9B4A.quest_desc: [
		"Players can't eat if they are in planets/moons without oxygen. To solve this problem, you need to use the vacumator to put food into a can."
		""
		"The Vacuumator allow you to put food inside Cans that you can eat in space."
		""
		"For this machine to work you need to put a can in the first slot, food in the second, and an empty glass bottle in the third. The machine will give you a can with food inside and a water bottle."
		""
		"You get hungrier in space - so bring lots of food!"
	]
	quest.26587BB45FC82006.quest_desc: ["Uses solar power (sun) to generate RF. Tier 5!"]
	quest.2658AC97D233385C.quest_desc: ["Pumps fluids into or out of the storage fluid tanks through adjacent blocks."]
	quest.2658AC97D233385C.quest_subtitle: "Sophisticated Storage"
	quest.269CB18DF9B7D5E3.quest_desc: ["A generator from blaze rods"]
	quest.26A9B658A7E6EDF3.quest_desc: ["With the chisel in hand, craft an AntiBlock. These flat, glowing colored blocks add a clean, modern accent to any build."]
	quest.26A9B658A7E6EDF3.quest_subtitle: "AntiBlocks"
	quest.26A9B658A7E6EDF3.title: "Bright Ideas"
	quest.26AB766F3F485DDF.quest_desc: ["Craft a §6Botanist Workbench§r. Each Chipped station opens a catalog of hundreds of cosmetic variants for one family of materials."]
	quest.26AB766F3F485DDF.quest_subtitle: "Decoration"
	quest.26AB766F3F485DDF.title: "Chipped Workbench"
