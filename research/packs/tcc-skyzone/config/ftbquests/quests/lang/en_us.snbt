	quest.1388958122E58F71.quest_desc: ["Potion ingredient, slay a ghast to obtain."]
	quest.138FFE0F7A3437A7.quest_desc: ["The §6Singularity Tank§r is a basic fluid tank that will hold 32 Buckets of any fluid. Use it to store XP from your mob farm! You can also craft an XP Drain Singularity Tank to store player XP as liquid XP."]
	quest.139F32F65FEB7305.quest_desc: ["§6Supreme Universal Cable§r. Carries Forge Energy."]
