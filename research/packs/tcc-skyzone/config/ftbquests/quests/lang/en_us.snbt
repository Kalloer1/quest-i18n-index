	quest.1E12C974C836B43E.quest_desc: ["Drop a Ritual Tablet on it, surround it with reagents, and provide Source to run powerful one-time or area rituals."]
	quest.1E12C974C836B43E.quest_subtitle: "Ars Nouveau"
	quest.1E1891FBCFF0556F.quest_desc: ["§6Magenta Collector§r, tier §e4§r of §e16§r. Collectors generate EMC from light. Each tier stores more and produces faster."]
