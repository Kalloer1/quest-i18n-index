	quest.0EE2A71B8333FE12.title: "Thermonuclear Alloy"
	quest.0EF2FB5DA629DB4A.quest_desc: ["Even with the dark matter armor, you can still take a noticeable amount of damage when things start getting hairy. You decide to try throwing some red matter at the problem like any good alchemist, and find that this new Red Matter Armor blocks so much incoming damage you can't even feel anything apart from the actual kinetic energy pushing you around. But... Maybe you can go even one step further?"]
	quest.0F146A084493D964.quest_desc: ["Right click to turn wood into stripped logs and right click again to harvest instantly."]
	quest.0F2C31359D60538C.quest_desc: ["Each of the tiers adds more storage slots and more upgrade slots."]
	quest.0F345B49491600CB.quest_desc: ["§6Wixie's Enchanting Apparatus§r, an automated Apparatus a Wixie can run to craft Ars recipes on demand."]
	quest.0F345B49491600CB.quest_subtitle: "Ars Additions"
