	quest.36898151531F50CB.title: "Endless Catalysts"
	quest.36AF3D06F7C13920.quest_desc: ["Pipes fluids in and out of the evaporation tower."]
	quest.36AF3D06F7C13920.quest_subtitle: "Multiblocks"
	quest.36AF3D06F7C13920.title: "Evaporation Valve"
	quest.36B38D33759AB0E3.quest_desc: ["A shield that casts an inscribed spell when it blocks an attack."]
	quest.36B38D33759AB0E3.quest_subtitle: "Ars Nouveau"
	quest.36D115CED80477E1.quest_desc: ["Place this in a sealed room with nothing on top of the machine, and then place a filled oxygen tank in the middle slot."]
	quest.36D56DA68590B0B5.quest_desc: ["Keep the caves clear. Defeat 256 spiders."]
	quest.36D56DA68590B0B5.quest_subtitle: "Apprentice"
	quest.36D56DA68590B0B5.title: "Web Slinger"
	quest.36D5EE5DB2E10DF3.quest_desc: ["§6Pink Matter§r, matter tier §e5§r. The crafting material behind tier §e5§r collectors, relays, flowers and links."]
	quest.36D5EE5DB2E10DF3.quest_subtitle: "Project Expansion: Matter"
	quest.36D5EE5DB2E10DF3.title: "Pink Matter"
	quest.36E395E477C17A09.quest_desc: ["§6Yellow Collector§r, tier §e12§r of §e16§r. Collectors generate EMC from light. Each tier stores more and produces faster."]
	quest.36E395E477C17A09.quest_subtitle: "Project Expansion: Collectors"
	quest.36E395E477C17A09.title: "Yellow Collector [MK 12]"
	quest.36E5CD76A71A3FB3.quest_desc: ["Right-click a block to select it, then swaps matching blocks for it across a build. Sneak-right-click air to change mode."]
	quest.36E5CD76A71A3FB3.quest_subtitle: "BetterBlockz"
	quest.36ED7A4EAD6CA439.quest_desc: ["Craft the armor §6Tomes§r (helmet, chestplate, leggings, boots). A Tome stores one enchantment and applies it straight to matching gear."]
	quest.36ED7A4EAD6CA439.quest_subtitle: "Apothic Enchanting"
	quest.36ED7A4EAD6CA439.title: "Armor Tomes"
	quest.36F5C86A7D54D95E.quest_desc: ["Storage Components are the core of all AE2 cells, determining the capacity of the cells. Each tier increases the capacity by 4x and costs 3 of the previous tier."]
	quest.36FB5A0AFD152506.quest_desc: ["§6Infinite Pressurized Tube§r. Carries gases and chemicals."]
	quest.36FB5A0AFD152506.quest_subtitle: "Extras: Transport"
	quest.36FB5A0AFD152506.title: "Infinite Pressurized Tube"
	quest.3700CB704D4A5B9B.quest_desc: ["§6Cosmic Induction Cell§r. Raises an Induction Matrix's energy capacity."]
	quest.3700CB704D4A5B9B.quest_subtitle: "Extras: Storage"
	quest.3700CB704D4A5B9B.title: "Cosmic Induction Cell"
	quest.3700FAC908C2A72E.quest_desc: ["A full set of infinity armor will grant you creative flight and invincibility. Even from a /kill command."]
	quest.371722B0FBABF0D4.quest_desc: ["The §6Emerald Lasso§r captures §avillagers§r, but only ones who have agreed to come along."]
	quest.371722B0FBABF0D4.quest_subtitle: "Mob Lassos"
	quest.371722B0FBABF0D4.title: "Emerald Lasso"
	quest.37400B72CCA09A9C.quest_desc: ["§6Absolute Mechanical Pipe§r. Carries fluids between machines."]
	quest.37400B72CCA09A9C.quest_subtitle: "Extras: Transport"
	quest.37400B72CCA09A9C.title: "Absolute Mechanical Pipe"
	quest.375228E150421286.quest_desc: ["Craft the §6Blazing Hellshelf§r: a hefty §e+10§r §bEterna§r and §dQuanta§r, cap §e65§r. Serious enchanting power."]
	quest.375228E150421286.quest_subtitle: "Apothic Enchanting"
	quest.375228E150421286.title: "Blazing Hellshelf"
	quest.375349762EEA75A9.quest_desc: ["A simple wooden planter that automatically grows crops and saplings without requiring power at a much slower rate. Can't be automated (except to output into a container directly below it)."]
	quest.375349762EEA75A9.quest_subtitle: "Agritech Evolved"
	quest.3756A02BEECBD1E3.quest_desc: ["Components are used to craft catalysts. They get harder to craft as they move higher in tiers."]
	quest.3760B6D798A48C9B.quest_desc: [
		"A long-time fan favorite, Actually Additions is returning to Minecraft 1.20.4+ with brand-new models and textures and lots of overhauls!"
		""
		"Use the Atomic Reconstructor and the Empowerer to turn minerals into powerful crystals that allow the creation of useful machines for processing and sorting items, lasers for wirelessly transporting energy, items and fluids, renewable oil to generate power, and much more."
	]
	quest.3760B6D798A48C9B.quest_subtitle: "Actually Additions"
	quest.3760B6D798A48C9B.title: "Actually Additions Manual"
	quest.376C6AD36CE3F09E.quest_desc: ["The starting point for crafting Angel Rings! Who doesn't love Creative flight?"]
	quest.376C6AD36CE3F09E.quest_subtitle: "Angel Ring"
	quest.3776041C37A3C9C3.quest_desc: ["§6Refined Glowstone§r, a luminous alloy ingot for tools and trim."]
	quest.3776041C37A3C9C3.quest_subtitle: "Resources"
	quest.3776041C37A3C9C3.title: "Refined Glowstone"
	quest.3777274E9F5C5A14.quest_desc: ["§6Advanced Fluid Tank§r. Portable fluid storage."]
	quest.3777274E9F5C5A14.quest_subtitle: "Extras: Storage"
	quest.3777274E9F5C5A14.title: "Advanced Fluid Tank"
	quest.37A738516C0645B3.quest_desc: ["Generates Source from mobs dying near it."]
	quest.37A738516C0645B3.quest_subtitle: "Ars Nouveau"
	quest.37B82D083578AAE3.quest_desc: [
		"By consuming power and liquid experience, the Soul Binder can convert the type of monsters a Broken Spawner will spawn by binding it with a filled Soul Vial."
		""
		"To add Experience to the machine, one can use a Fluid Conduit connected to a tank or other source of Liquid XP; alternatively, one can use the Experience Rod to place Experience inside of the machine directly from the player"
	]
	quest.37C2E6E1232CDA89.quest_desc: ["Craft Light Glass. Glassential's glass shines at full brightness while staying perfectly clear, so your windows light the room instead of blocking the view."]
	quest.37C2E6E1232CDA89.quest_subtitle: "Decoration"
	quest.37C2E6E1232CDA89.title: "Clearly Functional"
	quest.37C94E34D9E90527.quest_desc: ["§aShrink§r adds the §6Personal Shrinking Device§r. Equip it and press the toggle key to shrink down to a tiny size, then press again to grow back. See the world from an ant's point of view."]
	quest.37C94E34D9E90527.quest_subtitle: "Shrink"
	quest.37C94E34D9E90527.title: "Personal Shrinking Device"
	quest.37F3E23619863187.quest_desc: ["A compact advanced pattern provider for dense autocrafting setups."]
	quest.37F3E23619863187.quest_subtitle: "Advanced AE"
	quest.380496BD763D15E9.quest_desc: ["An interface with the same slots as normal, but each slot holds 16x more (1024 per slot by default)."]
	quest.380496BD763D15E9.quest_subtitle: "ExtendedAE"
	quest.380EF464962F81B3.quest_desc: ["Generate 1 billion RF/tick."]
	quest.38115D4486CF6CD3.quest_desc: ["Wire a generator into a Quest Task Screen and supply §e50 million§r FE."]
	quest.38115D4486CF6CD3.quest_subtitle: "Journeyman"
	quest.38115D4486CF6CD3.title: "Power Up"
	quest.3833EC6F7FBBA74F.quest_desc: ["If you need more than the six sides of the controller to connect to, you can link the Access point for another six sides that can see the whole drawer network. "]
	quest.38451728CB184D6A.quest_desc: ["A powerful device that controls time and weather"]
	quest.38451728CB184D6A.quest_subtitle: "Draconic Evolution"
	quest.384531776969BAA4.quest_desc: ["Upgraded version of the liquid compressor."]
	quest.3895CBE4E408C629.quest_desc: ["An upgraded Dominion Wand that copies and pastes connections and works at longer range."]
	quest.3895CBE4E408C629.quest_subtitle: "Ars Additions"
	quest.389D24CB471BF633.quest_desc: ["§6Fading Power Flower§r, tier §e15§r of §e16§r. A Power Flower is a self-contained collector, relay and condenser in one block, generating EMC on its own."]
	quest.389D24CB471BF633.quest_subtitle: "Project Expansion: Power Flowers"
	quest.389D24CB471BF633.title: "Fading Power Flower [MK 15]"
	quest.38C9E48289F1665E.quest_desc: ["§6Basic Universal Cable§r. Carries Forge Energy."]
	quest.38C9E48289F1665E.quest_subtitle: "Extras: Transport"
	quest.38C9E48289F1665E.title: "Basic Universal Cable"
	quest.38D7180D07D8A349.quest_desc: [
		"The Slice'N'Splice \"slices\" and \"splices\" heads and other things, adding components into it to create new components. It has six input slots, plus two tool slots, and one output slot. The stack size of each input slot in the Slice'N'Splice is exactly one."
		""
		"The Slice'N'Splice requires two tools in order to function- an Axe and Shears. The creation process will not start without these. Each operation will take off one durability from each tool."
	]
	quest.38D8ABC0F83FDD37.quest_desc: ["§6Spectrum§r material, the final Extras resource. The doorway to Infinite tier."]
	quest.38D8ABC0F83FDD37.quest_subtitle: "Alloys"
	quest.38D8ABC0F83FDD37.title: "Spectrum"
	quest.38E15612069E3D35.quest_desc: ["Burns solid fuel to produce heat for a Heat Generator or boiler."]
	quest.38E15612069E3D35.quest_subtitle: "Generators"
	quest.38E15612069E3D35.title: "Fuelwood Heater"
	quest.38E8EA5AB3A98610.quest_desc: ["[ \"Must complete the quest \", { \"text\": \"Teleporter\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"6EF67A87979A9378\" } }, \" to unlock.\" ]"]
	quest.38E8EA5AB3A98610.quest_subtitle: "15 Coins"
	quest.38E8EA5AB3A98610.title: "Epic Reward Bag"
	quest.3904F6539FFE7CF3.quest_desc: ["Gather 128 Chaos Shards from the Chaos Island."]
	quest.3904F6539FFE7CF3.quest_subtitle: "Grandmaster"
	quest.3904F6539FFE7CF3.title: "Shards of Chaos"
	quest.3905C1E98C8931B0.quest_desc: [
		"Of course, based on the world that you are currently in, the type of aura collected will slightly vary. For instance, in the normal world, aura can be gathered in the form of sunlight, while in the Nether realm, aura can be gathered in the form of ghosts, and in the End realm, aura is present in the form of an overabundance of darkness."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.39140A5AC01843D2.quest_desc: [
		"\"How do I make more islands if I am playing multiplayer?\""
		"- Run the command \"b/skyblock guir\"."
		""
		"\"Are there different packmodes?\""
		"- Yes, run the command \"b/packmode helpr\"."
		""
		"\"Why aren't passive mobs spawning?\""
		"- If for some reason animals are not spawning, you can craft animal seeds, search \"Haven Animal Seeds\" in JEI."
		""
		"\"Is there vein miner?\""
		"- The mod FTB Ultimine is included in this pack. The default keybind is the grave key: `."
		""
		"\"Why isn't the Twilight Forest Portal opening?\""
		"- Look up \"Twilight Diamond\" in JEI. This is needed to open the portal."
		""
		"\"Do I need to do the quest pages in order?\""
		"- No."
		""
		"\"How do I get more than five hearts?\""
		"- Eat a wide variety of food to gain permenant hearts!"
		""
		"\"How do I get [insert item here]?\""
		"- Use JEI to find recipes. Also, vanilla mechanics still apply for many vanilla items (i.e. finding upgrade templates in bastions)."
		""
		""
	]
	quest.39140A5AC01843D2.quest_subtitle: "Can't find the answer here? Head to Discord and ask!"
	quest.39327666C21DA6F6.quest_desc: ["By working in large quantities of the powerful red and dark matters, you manage to dramatically speed up the construct. It now pulls items apart into EMC 64 at a time. It also now has a separate chamber to place transmuted items."]
	quest.3955588BE8BB2019.quest_desc: ["Refined Obsidian tier leggings from Mekanism Tools."]
	quest.3955588BE8BB2019.quest_subtitle: "Mekanism Tools"
	quest.3955588BE8BB2019.title: "Refined Obsidian Leggings"
	quest.39596CAA42FE6D8A.quest_desc: ["Even with the dark matter armor, you can still take a noticeable amount of damage when things start getting hairy. You decide to try throwing some red matter at the problem like any good alchemist, and find that this new Red Matter Armor blocks so much incoming damage you can't even feel anything apart from the actual kinetic energy pushing you around. But... Maybe you can go even one step further?"]
	quest.397356F1B2238867.quest_desc: ["Your basic terminal, allowing you to view and access the contents of your network's storage and request things from your autocrafting setup."]
	quest.3999198FADFC6A44.quest_desc: [
		"Upgraded from the golden mesh."
		""
		"As you move up in the mesh tiers, the drops from sifting blocks changes. See JEI for details."
	]
	quest.39AEB0990DEC4A1B.quest_desc: ["The §6Andesite Funnel§r inserts and extracts items between inventories and belts. The basic logistics interface."]
	quest.39AEB0990DEC4A1B.quest_subtitle: "Create"
	quest.39BB1EE4D2B24353.quest_desc: ["Injectors must be correct tier for crafting, see JEI. Power is required for fusion crafting. Injectors are upgradable to next tier."]
	quest.39BC864BAA5BEF13.quest_desc: ["PackagedAuto is an addon to Applied Energistics 2, and it aims to use \"packages\" of items to allow autocrafting with more than 9 items, and fluid crafting is also supported."]
	quest.39BC864BAA5BEF13.quest_subtitle: "Packaged Auto"
	quest.39D148ACFB96F5F9.quest_desc: ["Stores the same amount of fluid, but can hold four different types!"]
	quest.39D2256A7658FAE6.quest_desc: ["§6Advanced Chemical Tank§r. Stores gases, slurries and other chemicals."]
	quest.39D2256A7658FAE6.quest_subtitle: "Extras: Storage"
	quest.39D2256A7658FAE6.title: "Advanced Chemical Tank"
	quest.39E081184335B6E1.quest_desc: ["The §6Awakening Altarnator§r is a single-block automatable version of the Awakening Altar."]
	quest.39E081184335B6E1.quest_subtitle: "Mystical Automation"
	quest.39EF5A9782C3678C.quest_desc: ["The waste product from using uranium in a reactor."]
	quest.39FB0BF639BAF694.quest_desc: ["A MekaSuit/Meka-Tool module installed at the Modification Station."]
	quest.39FB0BF639BAF694.quest_subtitle: "MekaSuit \\& Meka-Tool"
	quest.39FB0BF639BAF694.title: "Radiation Shielding Module"
	quest.3A110C233076158A.quest_desc: ["Exports an item only while its stored amount in the network is above or below a set threshold."]
	quest.3A110C233076158A.quest_subtitle: "ExtendedAE"
	quest.3A1D456E94BB9A46.quest_desc: ["Elemental seeds create elemental essence. Needed for Awakened Supremium."]
	quest.3A2B60C3A0D08BA5.quest_desc: ["Iron is the foundation of everything you build. Gather 1,024 Iron Ingots."]
	quest.3A2B60C3A0D08BA5.quest_subtitle: "Apprentice"
	quest.3A2B60C3A0D08BA5.title: "Iron Will"
	quest.3A3A697E61C43FD9.quest_desc: ["§6Basic Logistical Transporter§r. Moves items through a network."]
	quest.3A3A697E61C43FD9.quest_subtitle: "Extras: Transport"
	quest.3A3A697E61C43FD9.title: "Basic Logistical Transporter"
	quest.3A3DE0145E7A9038.quest_desc: ["§6Elite Induction Provider§r. Raises an Induction Matrix's transfer rate."]
	quest.3A3DE0145E7A9038.quest_subtitle: "Extras: Storage"
	quest.3A3DE0145E7A9038.title: "Elite Induction Provider"
	quest.3A4028A9FC91C8C1.quest_desc: ["§6Caerium Miner§r, tier §e6§r of §e8§r. Build its frame from the previous tier, then assemble the miner to pull §bCaerium§r and other resources from the void."]
	quest.3A4028A9FC91C8C1.quest_subtitle: "Void Miners"
	quest.3A4028A9FC91C8C1.title: "Caerium Miner"
	quest.3A4FF66513F8B30A.quest_desc: ["The §6Equipment Charger§r recharges energy tools and armor by drawing from the grid."]
	quest.3A4FF66513F8B30A.quest_subtitle: "Oritech"
	quest.3A6A4C98058E48FC.quest_desc: ["Power from the sun."]
	quest.3A6C554DC1D00CAB.quest_desc: ["Summons an Amethyst Golem that tends and harvests budding amethyst."]
	quest.3A6C554DC1D00CAB.quest_subtitle: "Ars Nouveau"
	quest.3A7184439FA07BE9.quest_subtitle: "Middle"
	quest.3A7184439FA07BE9.title: "Ender Errand"
	quest.3A9CD835C3E1D626.quest_desc: ["§2Naquadah§r, an ultra-dense ore added by Mekanism Extras, fuel for the strongest reactor in the pack."]
	quest.3A9CD835C3E1D626.quest_subtitle: "Reactors"
	quest.3A9CD835C3E1D626.title: "Naquadah"
	quest.3AACD2ACAFBC7177.quest_desc: ["Build the §6ultimate mob factory§r: minimal spawn delays, redstone control, no AI, ignoring spawn conditions and nearby players, with a high max-nearby count."]
	quest.3AACD2ACAFBC7177.quest_subtitle: "Apothic Spawners"
	quest.3AACD2ACAFBC7177.title: "The Ultimate Spawner"
	quest.3AB51CF2A5D78472.quest_desc: ["Place a Dank Dock to slot a Dank into the world. Pipes and hoppers can then pull from and push into it, automating your portable storage."]
	quest.3AB51CF2A5D78472.quest_subtitle: "Dank Storage"
	quest.3AB51CF2A5D78472.title: "Docking Station"
	quest.3ABF2B8DCA6967BA.quest_desc: ["§6Elite Infusing Factory§r. Processes many items at once. Higher tiers add more slots and speed."]
	quest.3ABF2B8DCA6967BA.quest_subtitle: "Extras: Factories"
	quest.3ABF2B8DCA6967BA.title: "Elite Infusing Factory"
	quest.3AD0AA05BFD863C2.quest_desc: [
		"Functional Storage is an alternative take on the storage solution of Storage Drawers, with an updated look and additional functionalities."
		""
		"The classic 1x1 drawer holds a lot of one item type per drawer. Other varients avaliable. Upgradable."
	]
	quest.3AD0AA05BFD863C2.quest_subtitle: "Functional Storage"
