	quest.254382B767F78ECB.quest_subtitle: "Create"
	quest.254D20C9C194045E.quest_desc: ["Forge an Infinity Pickaxe."]
	quest.254D20C9C194045E.quest_subtitle: "Grandmaster"
	quest.254D20C9C194045E.title: "Cosmic Ascension"
