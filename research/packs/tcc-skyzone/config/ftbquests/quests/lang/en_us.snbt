	quest.725D235C07DB7608.title: "Green Thumb"
	quest.7267D02BE7F9E8B7.quest_desc: [
		"Can be used in an accumulator to rapidly create Sal Ammoniac to be used as a solvent."
		""
		"See The Hermetica for more details on Theurgy."
	]
	quest.72744CCF4110F9DD.quest_desc: [
		"Ender IO machines that have an upgrade slot require capacitors to function."
		""
		"Depending on their Base Modifier, Capacitors can increase the Speed, Range or Energy Storage of machines."
		""
		"Level: 5"
	]
	quest.7276BABCEFFEBE15.quest_desc: ["§6Red EMC Link§r, tier §e3§r of §e16§r. EMC Links import and export items, fluids and raw EMC, the backbone of EMC automation."]
	quest.7276BABCEFFEBE15.quest_subtitle: "Project Expansion: EMC Links"
	quest.7276BABCEFFEBE15.title: "Red EMC Link [MK 3]"
	quest.727C435CCD8998A1.quest_desc: ["Use the §6Atomic Reconstructor§r to turn minerals into powerful crystals that allow the creation of useful machines for processing and sorting items, lasers for wirelessly transporting energy, items and fluids, renewable oil to generate power, and much more."]
	quest.7284146C05F63CB7.quest_subtitle: "Mekanism"
	quest.72A28DEFA6AC4A0F.quest_desc: ["This machine serves two functions. Firstly, any item placed into its inventory will be converted into EMC. Secondly, it transfers energy from Energy Collectors to Energy Condensers. When transferring, it gives a small, 1 EMC per second bonus. It is also used to charge the Klein Star series with EMC. "]
	quest.72B11DB251170E68.quest_desc: ["Crafting component. Upgradable to next tier, see JEI."]
	quest.72C6F582DAA81CBF.title: "Metal Press"
	quest.72D014F4A95D908A.quest_desc: ["§6Purple Power Flower§r, tier §e6§r of §e16§r. A Power Flower is a self-contained collector, relay and condenser in one block, generating EMC on its own."]
	quest.72D014F4A95D908A.quest_subtitle: "Project Expansion: Power Flowers"
	quest.72D014F4A95D908A.title: "Purple Power Flower [MK 6]"
	quest.7313072C07DAEB96.quest_desc: ["§6Pink Collector§r, tier §e5§r of §e16§r. Collectors generate EMC from light. Each tier stores more and produces faster."]
	quest.7313072C07DAEB96.quest_subtitle: "Project Expansion: Collectors"
	quest.7313072C07DAEB96.title: "Pink Collector [MK 5]"
	quest.731CFBA9CEF27A6A.quest_desc: [
		"Welcome to TCC: Skyzone, an expert pack by DataDal, branching off of the modpack Ozone Skyblock Reborn 2 by MuggleOrWizard!"
		""
		"If you are playing multiplayer, you can run the command \"/skyblock gui\" to see how to make islands and teams for each person/group. To make or join a team for quests/chunks, click the teams icon in the upper left of your screen when your inventory is open. The quest book can be found there as well."
		""
		""
		"This pack series is inspired by the modpack series \"Project Ozone\" by TheCazadorSniper. If you haven't played it before, I highly recommend you check it out - you can find it on the Curseforge app."
		""
		"Some quest descriptions may use info taken or modified from the mod's respective project page, wiki, or in-game guidebook. All rights reserved to the mod and wiki authors. For more information on a mod, visit the perspective page, scroll to the mod page."
	]
	quest.731CFBA9CEF27A6A.quest_subtitle: "Click the checkmark after reading!"
	quest.732A662662650FD1.quest_desc: ["The §6Infusion Altarnator§r is a single-block automatable version of the Infusion Altar."]
	quest.732A662662650FD1.quest_subtitle: "Mystical Automation"
