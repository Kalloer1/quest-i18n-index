	quest.31BF2CE22A7C697E.title: "Steel Sword"
	quest.31CAFD8D2006E87A.quest_desc: ["Copper, Nickel, a Magnetic Coil and a Furnace. The §6Basic Generator§r burns fuel to produce the first reliable RF for your machines."]
	quest.31CAFD8D2006E87A.quest_subtitle: "Oritech"
	quest.31D2D1709EB19D54.quest_desc: ["Place in front of animals to generate pink slime."]
	quest.31FC1E10FF6B79D5.quest_desc: ["Extends your range even further to 64 blocks. This distance is lengthened with the addition of a beacon (hold shift on item for details)."]
	quest.3225998C4F72ED6D.quest_desc: ["§6Fading Matter§r, matter tier §e15§r. The crafting material behind tier §e15§r collectors, relays, flowers and links."]
