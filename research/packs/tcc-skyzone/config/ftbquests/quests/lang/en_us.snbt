	quest.341747596D5FDD56.quest_subtitle: "QIO Network"
	quest.341747596D5FDD56.title: "Singularity Drive"
	quest.34395A704B52130C.quest_desc: ["The §6Nuclear Reactor Controller§r runs a fission reactor built from Reactor Walls and Processing Units. Cool it with the Industrial Chiller."]
	quest.34395A704B52130C.quest_subtitle: "Oritech"
	quest.344D23546D194491.quest_desc: ["Bank serious EMC. Acquire §e8§r Magnum Star Omegas."]
