	quest.24C202A118AE8FAD.quest_subtitle: "Endgame"
	quest.24C202A118AE8FAD.title: "Impossible Material"
	quest.24C4A019D07A1F8B.quest_desc: ["Defeat the dragon! Remember, the dragon can be resummoned with 4 end crystals."]
	quest.24C4A019D07A1F8B.quest_subtitle: "Minecraft"
	quest.24C6C85F207E7409.quest_desc: ["The §6Purification Chamber§r uses oxygen to refine Ores and shards into clumps. Each ore makes 3 clumps, whereas each shard only gives one clump."]
	quest.24C964CEB5B34A22.quest_desc: ["Productive Metalworks brings a powerful and immersive smelting and casting system to Minecraft, allowing players to process ores and craft ingots in a more realistic and efficient way. With this mod, you can construct a multi-block structure known as the Foundry, which acts as a large, industrial smelting furnace capable of handling large quantities of ores at once."]
	quest.24C964CEB5B34A22.quest_subtitle: "Productive Metalworks"
	quest.24CB19ADFE73AE3C.quest_desc: ["Steel tier chestplate from Mekanism Tools."]
	quest.24CB19ADFE73AE3C.quest_subtitle: "Mekanism Tools"
	quest.24CB19ADFE73AE3C.title: "Steel Chestplate"
	quest.24CC3D7E4041BFB3.quest_desc: ["§6Absolute Centrifuging Factory§r. An Extras-only factory type, available in the four highest tiers."]
	quest.24CC3D7E4041BFB3.quest_subtitle: "Extras: Factories"
	quest.24CC3D7E4041BFB3.title: "Absolute Centrifuging Factory"
	quest.24D6D003A6630D95.quest_desc: ["Links and locks storages and toggles the on-block display of counts, tiers, locks, upgrades and fill levels. §7Sneak + scroll to change mode.§r"]
	quest.24D6D003A6630D95.quest_subtitle: "Sophisticated Storage"
	quest.24DFF0ADBAFCCACB.quest_desc: ["§6Aurantium Modifiers§r. Slot these into a Aurantium Miner to tune it: §eEnergy§r lowers power draw, §eItem§r boosts output, §eSpeed§r runs it faster. Craft all three for tier §e2§r."]
	quest.24DFF0ADBAFCCACB.quest_subtitle: "Void Miners"
	quest.24DFF0ADBAFCCACB.title: "Aurantium Modifiers"
	quest.250D50E877136CE2.quest_desc: ["Used to store large amounts of energy."]
	quest.250D50E877136CE2.title: "Energizer Components"
	quest.250FDCED97533196.quest_desc: ["Craft a §6Dank§r, a portable storage device that holds many stacks of dozens of item types in one compact inventory. Tier §e1§r is modest, but it scales fast."]
	quest.250FDCED97533196.quest_subtitle: "Dank Storage"
	quest.250FDCED97533196.title: "Pocket Storage"
	quest.251E78ED5A7DF9BF.quest_desc: ["Energy cubes can be used to hold large amounts of RF. The higher the tier, the more RF can be stored. Tier 4!"]
	quest.252C6C64F6AD0466.quest_desc: ["Upgrade your way to a Tier §e4§r §6Dank§r. Each tier holds far more per item type, turning a pocketful into a portable warehouse."]
