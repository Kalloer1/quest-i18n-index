	quest.74B8478EF7E62034.quest_subtitle: "Oritech"
	quest.74E902E377E99737.quest_desc: ["Store fuel densely in a Fuel Block for compact stockpiles."]
	quest.74E902E377E99737.quest_subtitle: "Project Expansion: Fuel"
	quest.74E902E377E99737.title: "Fuel Block"
	quest.74F1F7144A6262A9.quest_desc: ["§bWireless Setup Kit§r. Click two Wireless Connectors to link them together."]
	quest.74F1F7144A6262A9.quest_subtitle: "ExtendedAE"
	quest.74F53C25C2448D66.quest_desc: ["If you want to go beyond the 8 channel limit or you want to connect multiple distinct networks you can make a 'routing network' using routers. A single router is already sufficient to connect up to six (six sides of the router) channels but using routing cables and routing connectors you can also make a routing network out of routers. Note that on a single routing network you can only have 32 published channels."]
	quest.7522C3D4167CF6BD.quest_desc: ["Coordinates large logic networks, built from both Menril and Chorus crystal."]
	quest.7522C3D4167CF6BD.quest_subtitle: "Integrated Dynamics"
	quest.7529B626BA315E9A.quest_desc: ["Mixes pigments into any color you like."]
	quest.7529B626BA315E9A.quest_subtitle: "Chemistry \\& Processing"
	quest.7529B626BA315E9A.title: "Pigment Mixer"
