	quest.3B2F34ADFEEF855C.title: "The Library"
	quest.3B39980FD69BE7EE.quest_desc: ["Use on dirt to create delightful dirt. Will spawn passive mobs. (5x5 space)"]
	quest.3B4CFE1766600596.quest_desc: ["§6Fading EMC Link§r, tier §e15§r of §e16§r. EMC Links import and export items, fluids and raw EMC, the backbone of EMC automation."]
