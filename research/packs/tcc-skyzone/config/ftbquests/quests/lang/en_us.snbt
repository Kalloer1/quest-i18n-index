	quest.3CF9B4E19430F7B8.title: "Magenta Fuel"
	quest.3CFA5C51114EB83D.quest_desc: ["Craft the armor Tomes (helmet, chestplate, leggings, boots). Tomes store an enchantment and apply it directly to matching gear."]
	quest.3CFA5C51114EB83D.quest_subtitle: "Apothic Enchanting"
	quest.3CFA5C51114EB83D.title: "Armor Tomes"
	quest.3D10A363B07B51F2.quest_desc: ["Refined Glowstone tier helmet from Mekanism Tools."]
