	quest.3415416F44406EE4.quest_subtitle: "Glassential"
	quest.3415416F44406EE4.title: "Glass Menagerie"
	quest.34172B8D67D6281E.quest_desc: ["Crafting ingredient to create Warden tools and armor."]
