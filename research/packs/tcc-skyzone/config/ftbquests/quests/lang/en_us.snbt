	quest.1E2CD94571F3157A.quest_subtitle: "Multiblocks"
	quest.1E2CD94571F3157A.title: "Thermoelectric Boiler"
	quest.1E3A0FD1818A7433.quest_desc: ["Craft a §6Botany Pot§r. Drop in soil and a seed and it grows on its own, no farmland or sunlight needed, perfect for a floating island."]
	quest.1E3A0FD1818A7433.quest_subtitle: "Botany Pots"
	quest.1E3A0FD1818A7433.title: "Potted Plants"
	quest.1E4C3DA9C74BB3B2.quest_desc: ["Hunt the nether halls. Defeat §e128§r wither skeletons."]
	quest.1E4C3DA9C74BB3B2.quest_subtitle: "Journeyman"
	quest.1E4C3DA9C74BB3B2.title: "Skull Collector"
