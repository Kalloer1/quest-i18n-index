	quest.7E1ADEEC8EADE7A8.quest_desc: [
		"ProjectE is an open-source remake of Equivalent Exchange 2, released for Minecraft 1.7.10 and newer. It allows users to transmute materials into other materials, using various items and machines. It adds a system known as Energy-Mass Covalence, or EMC, which is used to represent the values of items."
		""
		"This value differs from item to item, and is used in determining how much of one material another requires. EMC can also be stored and produced through other means. EMC is also used by certain blocks and items to carry out powerful effects."
		""
		"2Note: Not all items have EMC.r"
	]
	quest.7E1ADEEC8EADE7A8.quest_subtitle: "ProjectE"
	quest.7E1ADEEC8EADE7A8.title: "Covalence Dust"
	quest.7E44F5798FA1AF44.quest_desc: ["A single item that holds many of your tools and wrenches at once. Sneak-right-click a tool onto it to store it, then use the radial menu to morph it into whichever stored tool you need. One inventory slot instead of many."]
	quest.7E44F5798FA1AF44.quest_subtitle: "Morph-o-Tool"
	quest.7E56A182F8DEF697.quest_desc: ["The §6Crusher§r, well, crushes things. Not to be mistaken for the Enrichment Chamber."]
	quest.7E7C8A3B94BF6C37.quest_desc: ["Enchant your meshes with efficiency and fortune for more speed and better drop rates!"]
	quest.7E905409B7196EF7.quest_desc: ["A guardian of the old desert. Summon it with the §6Desert Eye§r and bring it down."]
	quest.7E905409B7196EF7.quest_subtitle: "Cataclysm"
	quest.7E905409B7196EF7.title: "The Ancient Remnant"
	quest.7E9067C221C0F016.quest_desc: ["§6Cosmic Induction Provider§r. Raises an Induction Matrix's transfer rate."]
	quest.7E9067C221C0F016.quest_subtitle: "Extras: Storage"
	quest.7E9067C221C0F016.title: "Cosmic Induction Provider"
	quest.7E961B4E81A1A7BE.quest_desc: ["The Arcanist set favors mana regen, good for sustained casting."]
	quest.7E961B4E81A1A7BE.quest_subtitle: "Ars Nouveau"
	quest.7E9653092FEC97B2.quest_desc: ["Place a captured villager in a §6Trader§r block to browse and buy its trades from a simple GUI, no awkward clicking through the villager."]
	quest.7E9653092FEC97B2.quest_subtitle: "Easy Villagers"
	quest.7E9653092FEC97B2.title: "Trader"
	quest.7E9695F23733BE77.quest_desc: ["§6Supreme Infusing Factory§r. Processes many items at once. Higher tiers add more slots and speed."]
	quest.7E9695F23733BE77.quest_subtitle: "Extras: Factories"
	quest.7E9695F23733BE77.title: "Supreme Infusing Factory"
	quest.7EADFB4A0F82C875.quest_desc: ["Apothic Enchanting rebuilds the enchanting table around three stats read from the shelves around it: §bEterna§r (raises the max enchant level), §dQuanta§r (power and randomness) and §5Arcana§r (odds of rare and treasure enchants). Start with a §6Hellshelf§r, far stronger than a vanilla bookshelf."]
	quest.7EADFB4A0F82C875.quest_subtitle: "Apothic Enchanting"
	quest.7EADFB4A0F82C875.title: "The Three Stats"
	quest.7EB6A73F2129D124.quest_desc: ["§6Final Star Shard§r. Forged only after mastering the Final tier of every EMC machine. The shard of ultimate power."]
	quest.7EB6A73F2129D124.quest_subtitle: "Project Expansion: Capstone"
	quest.7EB6A73F2129D124.title: "Final Star Shard"
	quest.7ED21876B4C1CE24.quest_desc: ["Obtained by reprocessing benitoite with rossinite, which is a waste product from using verderium as fuel in a reactor."]
	quest.7EE2214DA65D041B.quest_desc: ["Makes your rocket look like a big rocket!"]
	quest.7EEB8A1EC9332A30.quest_desc: ["A §bsingularity§r torn apart by the reaction chamber. The core material of all AdvancedAE quantum technology."]
	quest.7EEB8A1EC9332A30.quest_subtitle: "Advanced AE"
	quest.7EECA16AD037F2D7.quest_desc: ["The §6Belt Connector§r lets you stretch a belt between two shafts to move items, mobs, and players. The backbone of Create automation."]
	quest.7EECA16AD037F2D7.quest_subtitle: "Create"
	quest.7EF319CB8B4339B6.quest_desc: [
		"A space suit is required to survive on other planets and moons."
		""
		"Beware of fall damage with the gravity on different planets/moons!"
	]
	quest.7EF319CB8B4339B6.title: "Space Suit"
	quest.7EF9C0F555742CD5.quest_desc: ["Smelts items inside the storage like a furnace, using stored fuel."]
	quest.7EF9C0F555742CD5.quest_subtitle: "Sophisticated Storage"
	quest.7EFFE27D4D7E6668.quest_desc: [
		"Store RF, like a battery!"
		""
		"It is a shapeless multiblock; putting a Basic Capacitor Bank next to another Basic Capacitor Bank will combine their energy storage."
	]
	quest.7F147A591795B284.quest_desc: [
		"The finity of aura in the world can be troubling to think about, because once it is drained, it seems like it is not restorable. That, however, is not the case: there are many ways to regenerate aura. See the guidebook for instructions."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.7F147A591795B284.title: "Aura Generation"
	quest.7F231B4A745A7EBD.quest_desc: ["Sneak + right-click a normal ME Drive to convert it to an §bExtended Drive§r in place, keeping its cells."]
	quest.7F231B4A745A7EBD.quest_subtitle: "ExtendedAE"
	quest.7F24945B6C1F2800.quest_desc: ["This is unlocked from the start of the modpack."]
	quest.7F24945B6C1F2800.quest_subtitle: "3 Coins"
	quest.7F24945B6C1F2800.title: "Common Reward Bag"
	quest.7F3DEB9D1E5BC790.quest_desc: ["These are the primary components of AE2 input and output devices. Using the power of Fluix Crystal and a logic processor it allows devices to input and output items, blocks, fluids, etc. (No actual function, just a crafting intermediate)"]
	quest.7F3DEB9D1E5BC790.title: "Cores"
	quest.7F3F70413226C054.quest_desc: ["§6Green EMC Link§r, tier §e10§r of §e16§r. EMC Links import and export items, fluids and raw EMC, the backbone of EMC automation."]
	quest.7F3F70413226C054.quest_subtitle: "Project Expansion: EMC Links"
	quest.7F3F70413226C054.title: "Green EMC Link [MK 10]"
	quest.7F46932377752DD0.quest_desc: [
		"§6Osmium§r, Mekanism's signature metal, used in casings, circuits and alloys."
		""
		"Here at Mekanism, Inc., we bring you a suite of low, mid, and high tier machinery to elevate your archaic home and inefficient resource processing to the 21st century. With our collection of high-tech tools, high-end energy generators, advanced transmission systems and intricate processing mechanisms, you’ll find yourself relieved of the tedious tasks of ‘mining’ and ‘crafting’ and quickly progressing to new levels of technological enlightenment."
		""
		"You may not realize it, but every time you smelt an ore directly into its respective ingot, you’re wasting the majority of what you’ve mined. Mekanism’s team of experienced chemical and mechanical engineers have developed advanced ore processing machinery to extract resources from ores with utmost efficiency. With our purification, dissolution, chemical injection, and crystallization technologies, you can now double, triple, quadruple, even quintuple your ingot production per ore, given enough infrastructure and energy."
		""
		"Our engineering team understands and embraces gradual technological progression. For whatever stage of gameplay you’ve reached, we offer a tier of machinery to suit your needs. Every Mekanism machine can be upgraded to a factory, allowing you to process, 3 (basic), 5 (advanced), 7 (elite), or even 9 (ultimate) different items at once - in a single machine! No more are the rows, even walls of slow and ugly furnaces that once plagued your home. Condense your machinery infrastructure with Mekanism today."
	]
	quest.7F46932377752DD0.quest_subtitle: "Resources"
	quest.7F46932377752DD0.title: "Osmium Ingot"
	quest.7F5799FA9929A829.quest_desc: ["§6Supreme Combining Factory§r. Processes many items at once. Higher tiers add more slots and speed."]
	quest.7F5799FA9929A829.quest_subtitle: "Extras: Factories"
	quest.7F5799FA9929A829.title: "Supreme Combining Factory"
	quest.7F757497DE9AEC9C.quest_desc: ["§6Final Relay§r, tier §e16§r of §e16§r. Relays move EMC between blocks and add a bonus per second. Higher tiers transfer far more."]
	quest.7F757497DE9AEC9C.quest_subtitle: "Project Expansion: Relays"
	quest.7F757497DE9AEC9C.title: "Final Relay [MK 16]"
	quest.7F82B1A92A7D555E.quest_desc: ["Apply a Spell Parchment so arrows carry that spell to wherever they land."]
	quest.7F82B1A92A7D555E.quest_subtitle: "Ars Nouveau"
	quest.7FA97841FE7426E8.quest_desc: ["Right-click blocks to scatter random pattern variants from a set across them. Sneak-right-click air to change mode."]
	quest.7FA97841FE7426E8.quest_subtitle: "BetterBlockz"
	quest.7FD7C93F0A05D9EB.quest_desc: ["A §6Variable Card§r holds a value or formula built in the Logic Programmer. Slot it into network parts to drive them."]
	quest.7FD7C93F0A05D9EB.quest_subtitle: "Integrated Dynamics"
	quest.7FE0310EAFDE3DB5.quest_desc: ["§6Absolute Induction Cell§r. Raises an Induction Matrix's energy capacity."]
	quest.7FE0310EAFDE3DB5.quest_subtitle: "Extras: Storage"
	quest.7FE0310EAFDE3DB5.title: "Absolute Induction Cell"
	quest.7FF33FA53596F5F3.quest_desc: [
		"A single-biome dimension cloaked in darkness."
		""
		"- Normal torches will burn out over time."
		"- The darkness itself deals damage, so stay illuminated."
		"- Hostile mobs spawn frequently and have extra health."
		"- Ores are abundant, making this an excellent (if dangerous) mining zone."
		""
		"Vanilla ores can be found all over, but to find more varied modded ores you need to get below y-level 80."
	]
	quest.7FF33FA53596F5F3.quest_subtitle: "Dimension Expansion"
	quest.809CD89BF6E31C02.quest_desc: ["Pattern Access Terminal that can search patterns by input/output ingredient name and highlight the provider in world."]
	quest.8AA62BA12E5DAEEA.quest_desc: ["Encodes §bAdvanced Processing Patterns§r with far more inputs and outputs than vanilla AE2."]
	quest.8B0E7153BF7C3706.quest_subtitle: "Morph-o-Tool"
	quest.8D7A6CDE5F09BEF2.quest_desc: ["Stores Forge Energy for the mechanical machines and energy-using parts."]
	quest.8F7D134BB8831B5B.quest_desc: ["Storage bus filtered by item or fluid §btags§r with basic logic operators (e.g. C:ingots/* | c:gems/*)."]
	quest.908B6C0237394DFF.quest_desc: ["Right-click a block to select it, then swaps matching blocks for it across a build. Sneak-right-click air to change mode."]
	quest.908CAD8B3EF28F5F.quest_desc: ["Cycles a block's variant in a checkerboard pattern. Sneak-right-click to cycle back. Sneak-right-click air to change mode."]
	quest.911A95891FCA76A9.quest_desc: ["An infinite water and cobblestone sink and source in cell form, holding up to 2.1 billion."]
	quest.914F149F83B5AE08.quest_desc: ["Sneak + right-click a normal Import or Export Bus to convert it to the §bExtended§r version in place."]
	quest.9185D401CE257AD4.quest_desc: ["Restricts what may be inserted into the storage."]
	quest.97702652F2B23A01.quest_desc: ["A wireless version of the Extended Pattern Access Terminal."]
	quest.A38976EE082C309F.quest_desc: ["Pumps fluids into or out of the storage fluid tanks through adjacent blocks."]
	quest.AC74200567A820D3.quest_desc: ["Smelts items inside the storage like a furnace, using stored fuel."]
	quest.AD77BF39768915E2.quest_desc: ["Crafts the Extended devices that are too complex for a crafting table, and runs in-world transforms like fluix. §eIts screen face cannot connect to a network.§r"]
	quest.AFA74193304885EE.quest_desc: ["Sneak + right-click a normal ME Interface to convert it to an §bExtended Interface§r in place, keeping its config."]
	quest.B936965EFA838016.quest_desc: ["Extends a run of matching blocks outward. Sneak-right-click air to change mode."]
	quest.BA552ABB45DEB93F.quest_desc: ["Monitors item/fluid throughput across an ME network for tuning automation."]
	quest.BC4986E10B742C0B.quest_desc: ["Adds a crafting grid to the storage screen, using the stored items."]
	quest.C481EE214E69886D.quest_desc: ["Slices material blocks straight into processor prints, up to 9x faster than an Inscriber. §eGlass faces without a port cannot connect to a network.§r"]
	quest.D21B5AAA1C87409C.quest_desc: ["Pulls nearby dropped items and XP straight into the storage."]
	quest.D2BFDC8AB3872178.quest_desc: ["Gives the storage hopper behaviour. Pulls from above and pushes to the inventory below by filter."]
	quest.D5A03D76E82F142F.quest_desc: ["Exports an item only while its stored amount in the network is above or below a set threshold."]
	quest.D75D167853D00645.quest_desc: ["Picks up items that match its filter as you collect them."]
	quest.D9078D3FE0A0887B.quest_desc: ["Fills items with fluids, and with addons (e.g. Applied Flux) also Mekanism gas, Botania mana, or §eAE energy§r. 80 AE per operation."]
	quest.DCD63A3E05BA05A6.quest_desc: ["A movable reference to a network position. Read or write a far-off block as if it were local."]
	quest.DE573ECAD06B0974.quest_desc: ["Sneak + right-click a normal ME Drive to convert it to an §bExtended Drive§r in place, keeping its cells."]
	quest.E28BECDCB820372C.quest_desc: ["A storage block holding 36 stacks of anything, from items to fluids."]
	quest.E9DF0B3F13052BA1.quest_desc: ["Sneak + right-click a normal Pattern Provider to convert it to the §bExtended Pattern Provider§r in place."]
	quest.ED89CAFF0D6E9901.quest_desc: ["Right-click a connected-texture (CTM) block to connect or disconnect its texture from its neighbours."]
	quest.EDA739C628EFA201.quest_desc: ["Stores and dispenses experience, and can pump it to or from the storage."]
	quest.F2B57F63D654F758.quest_desc: ["Voids any filtered items once the storage is full, so it never clogs."]
	quest.FC1EB03300183873.quest_desc: ["An interface with the same slots as normal, but each slot holds 16x more (1024 per slot by default)."]
