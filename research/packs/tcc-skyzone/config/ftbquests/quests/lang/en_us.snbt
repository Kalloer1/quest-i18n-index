	quest.11CB8DC2DE20DF89.title: "Farming Module"
	quest.11DF82518E7F48D3.quest_desc: ["§6Elite Purifying Factory§r. Processes many items at once. Higher tiers add more slots and speed."]
	quest.11DF82518E7F48D3.quest_subtitle: "Extras: Factories"
	quest.11DF82518E7F48D3.title: "Elite Purifying Factory"
	quest.11E0906BD605061E.quest_desc: ["The covered cable variant offers no gameplay benefits over its Fluix ME Glass Cable counterpart. It can however be used as an alternate aesthetic choice if you prefer the covered look."]
	quest.11E8F528090059C9.quest_desc: ["Craft a §6Void Eye§r from end stone, purpur and a shulker shell to summon the §cEnder Guardian§r."]
	quest.11E8F528090059C9.quest_subtitle: "Cataclysm"
	quest.11E8F528090059C9.title: "Void Eye"
	quest.11EFB5CC1817CF37.quest_desc: ["A §6Laser§r fires concentrated energy, used to ignite fusion and to mine."]
	quest.11EFB5CC1817CF37.quest_subtitle: "Reactors"
	quest.11EFB5CC1817CF37.title: "Laser"
	quest.11F34F6309A89E31.quest_desc: ["Tier 3. Can store 300 stacks."]
	quest.120A4A99099FE5E4.quest_desc: ["Infinite-capacity storage block that provides and stores unlimited amounts of any fluid."]
	quest.1210D7BF557B267B.quest_desc: ["§6Cosmic Stamping Factory§r. An Extras-only factory type, available in the four highest tiers."]
	quest.1210D7BF557B267B.quest_subtitle: "Extras: Factories"
	quest.1210D7BF557B267B.title: "Cosmic Stamping Factory"
	quest.1221C842C42C7F66.quest_desc: [
		"The Drive is the device you plug your storage cells into in order to use them for network storage. It has 10 slots which each accept a cell."
		""
		"If for some reason you want to, you can push and pull the cells from its inventory with any item logistics like hoppers or ae2 busses."
		""
		"It can be rotated with a Certus Quartz Wrench."
	]
	quest.1230550E4A5B23AC.quest_desc: [
		"Right click to instantly mine vein of ore. Mines (left click) in the following modes (cycle with G):"
		"- Standard: breaks one block at a time"
		"- 3x tall shot: breaks 3 blocks at once vertically"
		"- 3x wide-shot: breaks 3 blocks at once horizontally"
		"- 3x long-shot: breaks 3 blocks at once in a line in front of you"
	]
	quest.1231D9AF9F07AD12.quest_desc: ["Receives teleported players from a matter transmitter."]
	quest.1235ED41E2CA0203.quest_desc: ["§6Cyan Power Flower§r, tier §e9§r of §e16§r. A Power Flower is a self-contained collector, relay and condenser in one block, generating EMC on its own."]
	quest.1235ED41E2CA0203.quest_subtitle: "Project Expansion: Power Flowers"
	quest.1235ED41E2CA0203.title: "Cyan Power Flower [MK 9]"
	quest.1245AA386AB7F298.quest_desc: [
		"Crafters are machines added by RFTools that will automatically craft items given a recipe, the necessary components and RF power. Multi-step crafting can be done in a single machine, limited only by the number of recipe slots."
		""
		"Crafter Tier 1 can remember 2 recipes."
	]
	quest.1248104A9F7A3F32.quest_desc: ["Iron Jetpacks is a modern Jetpacks mod that is both feature-rich and easy to use. Jetpacks get better as you craft higher tiers. Coils are an integral part of the jetpack crafting process. See JEI."]
	quest.125B153693091816.quest_subtitle: "Multiblocks"
	quest.125B153693091816.title: "Dynamic Tank"
	quest.125C064F10CFBF60.quest_desc: [
		"Sieve and Hammer: Insert upgrades to process large amounts of material very quickly. Requires power (RF)."
		""
		"Compactor: Compress materials after sifting. A good complement to any auto-sieving setup! Requires power (RF)."
	]
	quest.125C064F10CFBF60.quest_subtitle: "Ex Machinis"
	quest.125C064F10CFBF60.title: "Flux Upgrades"
	quest.125E5D92A7D84955.title: "Coke Oven"
	quest.126CE71405216250.quest_desc: ["Storage bus filtered by item or fluid §btags§r with basic logic operators (e.g. C:ingots/* | c:gems/*)."]
	quest.126CE71405216250.quest_subtitle: "ExtendedAE"
	quest.12712FFFB3B0BCBE.quest_desc: ["A wither-touched horror of the drowned depths. Summon it with the §6Abyss Eye§r and break it."]
	quest.12712FFFB3B0BCBE.quest_subtitle: "Cataclysm"
	quest.12712FFFB3B0BCBE.title: "The Harbinger"
	quest.1273EAF9DC0A7479.quest_desc: ["Found via mining in the Aether."]
	quest.12A5561178489FCC.quest_desc: [
		"The controller is the routing hub of a ME Network. Without it, a network is \"ad-hoc\" and can only have a max of 8 channel-using devices total."
		""
		"It is not possible to have 2 controllers in one ME Network."
		""
		"The controller provides 32 Channels per face."
		""
		"The controller requires 6 AE/t per controller block to function. Each controller block can store 8000 AE, so larger networks might require additional energy storage. See energy for details."
		""
		"Multiblock Controllers can be built in a fairly free form."
		""
		"However, there are a few rules that must be followed:"
		"- All controller blocks on a ME Network must be connected; else the blocks will turn red."
		"- The size of the controller must be within 7x7x7; else it will turn red."
		"-A controller can have 2 adjacent blocks in at most 1 axis; if a block violates this rule, it will disable and turn red."
	]
	quest.12A78906CCEB9888.quest_desc: ["Craft an §6Elite Botany Pot§r. The higher tier grows crops faster and holds more, the way to scale your gardens up."]
	quest.12A78906CCEB9888.quest_subtitle: "Botany Pots"
	quest.12A78906CCEB9888.title: "Elite Cultivation"
	quest.12AE4AE8955D0364.quest_desc: ["Upgraded version of the air compressor."]
	quest.12B32970DF51871F.quest_desc: ["Hold shift key when hovering over the item to see stats."]
	quest.12C98CEEB49B54D8.quest_desc: ["The §6Mechanical Arm§r picks items from sources and places them into destinations in a programmed order. Pairs with crafters and depots."]
	quest.12C98CEEB49B54D8.quest_subtitle: "Create"
	quest.12E388A337027D9F.quest_desc: ["The §6Destruction Gadget§r allows you to void a large area."]
	quest.12E6949EDE55D49D.quest_desc: ["§6Absolute Energy Cube§r. Stores Forge Energy. Higher tiers hold and transfer vastly more."]
	quest.12E6949EDE55D49D.quest_subtitle: "Extras: Storage"
	quest.12E6949EDE55D49D.title: "Absolute Energy Cube"
	quest.12F5CD9FCFE9C4B0.quest_desc: ["The §6Hand Drill§r is a powered mining tool built from Adamant, Steel, Enderic Compound and a Motor."]
	quest.12F5CD9FCFE9C4B0.quest_subtitle: "Oritech"
	quest.12F60B0E98F9D419.quest_desc: ["Tier 4, max tier. Can store 500 stacks."]
	quest.13010CE647E918A3.quest_desc: [
		"Ender IO machines that have an upgrade slot require capacitors to function."
		""
		"Depending on their Base Modifier, Capacitors can increase the Speed, Range or Energy Storage of machines."
		""
		"Level: 7"
	]
	quest.130380166BF98207.title: "Bottling Machine"
	quest.13068D9B517A3900.quest_desc: ["Upgrade to the Infused Hellshelf and Infused Seashelf. Each raises its max-Eterna cap to 60, letting your table reach higher enchant levels."]
