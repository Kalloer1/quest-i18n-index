	quest.3263AE2A41A47982.title: "Refined Glowstone Shovel"
	quest.326626C6F888B720.quest_desc: ["To use this mod, one needs to make 2 Recipe Pattern Holders and encode them with an Encoder. "]
	quest.32664FCADE420D48.quest_desc: [
		"Addons make industrial foregoing machines better! There are addons for efficiency, range, speed, and more!"
		""
		"Higher tiers exist, see JEI."
	]
	quest.32664FCADE420D48.title: "Addons"
