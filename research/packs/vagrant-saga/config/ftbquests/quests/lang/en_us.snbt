	]
	quest.70DCAD4818CBFC79.quest_desc: ["You can now smelt all the vanilla armors, tools and weapons into ingots. (Includes all Iron, Diamond, Gold, Netherite Armor, Tools, Weapons and Horse Armors, Bucket, Iron Door, Iron Trap Door, Iron Bars)"]
