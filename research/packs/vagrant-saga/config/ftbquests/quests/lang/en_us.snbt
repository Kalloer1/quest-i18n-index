	quest.707FFBD10638FF18.quest_desc: ["Most of the hostile mobs will have special effects on them to make them difficult to kill."]
	quest.7084F0F662A9EA97.quest_desc: [
		"Advent of Ascension is all about modern adventure and exploration gameplay designed to expand and extend during and beyond vanilla, catering to all playstyles."
