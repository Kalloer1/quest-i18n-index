	file.0000000000000001.title: "Shattered Skies"
	quest.006C91968D4A33A6.quest_desc: ["Some ores can ONLY be found in The Mining Dimension."]
	quest.018627236368DA44.quest_desc: [
		"Normal Cows can be converted to Fluid Cows and then Breed or further converted to other more advanced cows."
		""
		"It all starts with Dye cows..."
		""
		"White, Black, Brown, Red, Green, Blue, Yellow Dye can be fed to a normal cow with a chance of converting it to the corresponding Dye variant."
		""
		"Water Bucket, Lava Bucket, Budding Amethyst, Budding Diamond Geore, Budding Emerald Geore, Budding Lapis Geore, Budding Quartz Geore, Budding Uranium Geore and an Oil Bucket can be fed to normal cows to convert them to their fluid counterparts.  These are chance conversions and in JEI."
	]
	quest.02CD6F2FEA5560B7.quest_desc: ["A Sky Stone Catalyst can be found in the Overworld in a Geode that is encased in Coal and Sky Stone blocks.  It may just look like a black blob since both blocks are black."]
	quest.02CD6F2FEA5560B7.quest_subtitle: "Observe a Sky Stone Catalyst"
	quest.037B335E2E79165B.quest_desc: ["Sea Shelves primarily increase your Eterna and Arcana."]
	quest.037B335E2E79165B.title: "Sea Shelves"
	quest.037DD773C41855AA.quest_desc: [
		"Not everyone likes Create, as such, we've made Create completely optional."
		"If you'd like to go down the Create rabbit hole, enable these tasks."
	]
	quest.03E7D73433AB6B7C.quest_desc: [
		"Using our Arcane Crystal Dust, we'll need to combine it with other dusts and powders to create &dMundabiter Dust&r."
		""
		"This dust is used in several recipes, as well as activating the Hephaestus Forge."
	]
	quest.03E7D73433AB6B7C.quest_subtitle: "Let the Dusts Combine"
	quest.03E7D73433AB6B7C.title: "Mundabitur Dust"
	quest.03F7CF00094645F6.quest_desc: ["The Molten Carbon Cow is the start of some more advanced Cows, also in JEI for the full recipes."]
	quest.04D9F6587EF8D9B7.quest_desc: [
		"The &9Potion Jar&r stores up to 100 potions. You can remove them by using an empty bottle or a potion flask on the jar."
		""
		"Wixies will use these jars during Potion Autocrafting."
	]
	quest.04D9F6587EF8D9B7.quest_subtitle: "Storing Potions"
	quest.05DD19B6F8C6CDEB.quest_desc: [
		"With our ability to mine for &cIesnium&r, we can use Demons to do our mining."
		""
		"For this, we'll need to create a &dDimensional Mineshaft&r to access the Demon Mining World. You'll also need a Mining Demon confined to a lamp, which you'll place inside of the Mineshaft for it to work. While any tier will complete this quest, higher tiers work faster and have a higher chance at mining Iesnium for you."
		""
		"The Mineshafts do not auto-export on their own. You will need to extract the items out using either Hoppers, Transporting Demons, or some other method like Item Pipes. It will void any items over its storage limit."
	]
	quest.05DD19B6F8C6CDEB.title: "&cDemon Mining&r"
	quest.05F47198B09C2305.quest_desc: "Punch dirt or grass to find Pebbles — the remnants of the old world’s stone. Combine them into cobblestone."
	quest.05F47198B09C2305.title: "Pebbles of the Past"
	quest.07B391B3EE84F7DF.quest_desc: [
		"Struggling to find Netherite or Ancient Debris?"
		"Build a Mob Farm, progress through Apotheosis and scrap netherite gear."
		"This takes time, but it is the primary method of getting your initial Netherite."
	]
	quest.08623179A29E8DCA.quest_desc: ["Hammer cobblestone into more resources.  This can be automated later!"]
	quest.08623179A29E8DCA.title: "Getting Hammered"
	quest.0871ED6FB4E06AAA.quest_desc: ["The Attuned Soul Matrix seems to resonate at the same frequency of it's owner..."]
	quest.088FCB5267CB7A89.quest_desc: ["This belt will give random positive potion effects for a short duration. These will vary in strength. "]
	quest.0977E2F604EEEF7B.quest_desc: ["Dropped exclusively by Sludge mobs in the Blooming Caverns biome."]
	quest.0A1ABE9CF7740AAA.quest_desc: ["The Ring of Discount provides a small bonus to max mana and mana regen. It also reduces the total cost to cast a spell."]
	quest.0A4EAA9CAEB64706.quest_desc: [
		"Blaze Rods cannot be aquired naturally, you must melt Blaze Powder in a Foundry or compress them via Immersive Engineering."
		""
		"Once you have your first Blaze Rods, you can create a Blaze Gateway to get more."
		""
		"Capturing a Blaze will collapse the Gateway, so careful.  Maybe Swab a Blaze instead!"
	]
	quest.0AEE1B2B0069E9DA.quest_desc: [
		"Eggs can be dyed all 16 colors.  This isn't for Easter, it's how you get started with Chickens."
		"You need Chickens of various colors to breed and create new Chickens.  Start off with White, make a Feather Chicken and go from there."
	]
	quest.0AFC5B1AF055811A.quest_desc: [
		"The &2Edelwood Bucket&r can store more than one bucket of liquid, and can also be used to capture small animals like chickens or squids."
		""
		"You'll need the Permafrost enchant to use it to carry Lava."
	]
	quest.0B68E3C046C82860.quest_desc: [
		"The &6Deorum Ingot&r is needed to continue your progression in the mod!"
		""
		"This is a very important crafting ingot used in a lot of recipes, plus it also makes some pretty blocks!"
	]
	quest.0B68E3C046C82860.title: "&6Deorum"
	quest.0C6719D81DE5A614.quest_desc: [
		""
		"The Forge requires 4 different items to be powered: Aureal, Souls, Blood, and Experience."
		""
		"To learn more about each, follow the corner quests!"
	]
	quest.0C8215BCCF37EC8B.quest_desc: [
		"Using &dSpiritfire&r, we can convert several Overworld mats into their Otherworld variants. You can also find several Otherworld mats by going under the effects of the &bThird Eye&r and adventuring into the world. You might be surprised what you find. To make it easier, there are crafting recipes for the basic materials by throwing them into &dSpiritfire&r."
		""
		"&bAndesite&r converts to &3Otherstone&r, which can be used to light a permanent &dSpiritfire&r."
		""
		"&aOak Saplings&r convert to &9Oak Saplings&r but they are not the same. When grown, these will look exactly like a regular Oak tree. However, under the effects of the &bThird Eye&r, you will be able to harvest the Otherworld variant."
		""
		"&eDiamonds&r will turn into &dSpirit Attuned Gems&r which are used in several recipes we'll need later down the road."
	]
	quest.0C8215BCCF37EC8B.title: "&dSpiritfire&r Conversions"
	quest.0D330FAD6C993DBC.quest_desc: [
		"This is the next upgrade to your Spellbook!"
		""
		"This will increase your overall mana and mana regen, as well as allowing you to create and use Tier 2 Glyphs."
	]
	quest.0E14C93C2A519B5B.title: "Ores"
	quest.0E2AD156E5EF263A.quest_desc: ["Used to inscribe spells on with the Scribe's Table."]
	quest.0E9A6A3AB6B9CD74.title: "Dragon's Breath Cow"
	quest.0F3BD102F9F93DDD.quest_desc: ["The &9Quantum Catcher&r is used to capture and transport mobs."]
	quest.0F3BD102F9F93DDD.title: "Entity Tools"
	quest.10470F90B09DE5CA.quest_desc: [
		"While there are other methods to move Demons around, you can create an &dEmpty Soul Gem&r to capture a Demon and place it somewhere else."
		""
		"To make this, we'll need to do a more advanced Ritual called &aStrigeor's Higher Binding&r. For this, you'll need &a8 Sacrificial Bowls&r as well as the items required for this quest."
		""
		"Remember, you can always use the multi-block preview by finding the Pentacle in the &bDictionary of Spirits&r to help you build the structure."
	]
	quest.10470F90B09DE5CA.title: "&bCapturing&r &dDemons&r"
	quest.111649D7E16D869F.quest_desc: [
		"The &9Caster's Wand&r only accepts a single spell, and is inscribed using the Scribe's Table."
		""
		"Wand spells always start with Projectile > Accelerate, and MUST be inscribed with a spell that does not have another method (like touch, self, etc)."
		""
		"This allows you to cast spells beyond the 10 spell cap. If you want to use Break, just inscribe the wand with Break by itself."
	]
	quest.1171A0477B1F75BB.quest_desc: ["A Radioactive Catalyst can be found in the Overworld in a Geode that is encased in Coal and Deepslate Uranium Ore blocks.  Despite it's name, it's not actually radioactive, but it's a renewable form of uranium that is a little tougher to automate and also requires Mekanism, but you're already into Mekanism if you need Uranium..."]
	quest.1171A0477B1F75BB.quest_subtitle: "Observe a Radioactive Catalyst"
	quest.1174DE40A9E576B8.quest_desc: [
		"Love it or hate it, Pneumaticcraft is a requirement for late game completion."
		"It's also a good alternative to Create if you're not a fan, but at this point in the game you already know that."
		""
		"Get into Laser and Drill Assembly, it will be good to have these mechanisms setup in advance."
	]
	quest.1174DE40A9E576B8.title: "Getting into PNC"
	quest.11C065375DF7AC3E.quest_desc: [
		"To create an Arcane Crystal Obelisk, place down an Arcane Polished Darkstone block, then place two Arcane Crystal Blocks on top of it."
		""
		"Right-click with Mundabitur Dust and you'll create the obelisk."
		""
		"When placed on a Arcane Chiseled Polished Darkstone block on the Hephaestus Forge structure, it will slowly generate Aureal over time."
	]
	quest.1283193B5C645249.quest_desc: ["Automation is great, let's put those materials to use."]
	quest.1283193B5C645249.title: "Salvation"
	quest.130824B42E9D3C3B.quest_desc: ["The Warden holds the key to The Otherside...  Not only does he drop the Heart of the Deep, he also occasionally drops Sculk Shriekers which are required to summon more Wardens without the Ritual.  You'll need to use a Sculk Core on them to make them work properly."]
	quest.130824B42E9D3C3B.title: "Summon a Possessed Warden"
	quest.13E5783AD64E3BC2.quest_desc: ["Breaking spawners will now drop &9Spawner Scraps&r."]
	quest.14DB8A515CA50932.quest_desc: [
		"The &9Enchanter's Sword&r allows you to attach a Touch Spell to the sword. "
		""
		"All spells on the Sword gain 1 additional Amplify augment to the last effect on the spell."
		""
		"To apply a spell to the sword, use a Scribe's Table. Create the spell without using a form."
	]
	quest.151648179684B088.quest_desc: [
		"Runic Chalk is used to draw permanent Runes on that ground. These runes will cast spells on entities that walk over them."
		""
		"To attach a spell to a rune, inscribe a &eSpell Parchment&r using a Scribe's Table."
		""
		"Note: The Rune will need Source to operate."
	]
	quest.151648179684B088.quest_subtitle: "Placeable Spells"
	quest.1612E23201299DA1.quest_desc: ["A Frozen Catalyst can be found in the Overworld in a Geode that is encased in Coal and Packed Ice blocks."]
	quest.1612E23201299DA1.quest_subtitle: "Observe a Frozen Catalyst"
	quest.165FD7200391C4F2.quest_desc: ["Brave The Upside Down, kill mobs and collect their reliquary drops."]
	quest.174ABF732ACF1755.quest_desc: [
		"Chicken Seed automation is key to really getting into Chickens."
		"Each tier can be crafted from the soul of same tier."
		""
		"Chicken Seed can also be planted, this produces an infinite source of seeds of that tier."
	]
	quest.174ABF732ACF1755.title: "Chicken Seed"
	quest.1798AB5DA6CB8EE0.quest_desc: ["Reliquary Mob Drops can only be acquired by mobs killed in The Upside Down."]
	quest.1798AB5DA6CB8EE0.title: "Reliquary Drops"
	quest.17D7D34F519F7E5F.quest_desc: [
		"To create the final tier of your Spellbook, you'll need to have killed the &6Wilden Chimera&r."
		""
		"This is a Ritual that you'll need to complete using a &9Ritual Brazier&r."
	]
	quest.1814ECFF473ACD34.title: "Tier 9 Soul - Chickens"
	quest.183C815F4A3C513C.quest_desc: [
		"There are a few miscellaneous shelves that help with different functions."
		""
		"1) Deepshelf of Arcane Treasures"
		"2) Shelf of End-Fused Rectification"
		"3) Seashelf of Aquatic Filtration"
		"4) Geode-Encased Bookshelf of Stability"
		"5) Hellshelf of Sight (masterful sight)"
		"6) Melonshelf"
		"7) Stoneshelf"
		"8) Beeshelf"
	]
	quest.183C815F4A3C513C.title: "Misc Shelves"
	quest.18A2FBE2D4133FA2.quest_desc: [
		"Arcane Pedestals are needed for the Ritual Brazier and crafting items with an Enchanting Apparatus."
		""
		"Go ahead and make yourself 8 of them!"
	]
	quest.18A2FBE2D4133FA2.quest_subtitle: "Fancy Tables"
	quest.18A2FBE2D4133FA2.title: "Arcane Pedestals"
	quest.18F5F0C75B5036C7.quest_desc: [
		"&cDemon's Dream Fruit&r is perfectly healthy for you. There might be some side effects you should know about."
		""
		"When you consume one, you have a chance to get the effect of the &3Third Eye&r, allowing you to see into the &9The Otherworld&r. Certain items in the world might not be what they seem, and you'll need this \"vision\" to find certain items for progression."
		""
		"Or you can set it on fire and skip finding most of them. That's up to you."
	]
	quest.18F5F0C75B5036C7.quest_subtitle: "Get Ready for a Trip"
	quest.18F5F0C75B5036C7.title: "&cDemon Fruit&r"
	quest.196F6A0BDAF42FB3.quest_desc: ["Hell Shelves primarily increase your Eterna and Quanta."]
	quest.196F6A0BDAF42FB3.title: "Hell Shelves"
	quest.19D02325579F2AA8.quest_desc: [
		"The Volcanic Sourcelink generates Source by consuming burnable items. Archwood logs will generate bonus Source."
		""
		"As it burns items, it will convert nearby stone into lava."
		""
		"This also generates Lava Lilys."
	]
	quest.1AE38569B8C91B28.quest_desc: [
		"Check JEI for sieving recipes."
		"You objectively want to get to higher tier meshes and eventually to the Create Sifter for automation."
	]
	quest.1B471AAA9FFAF622.quest_desc: ["End Shelves primarily focus on maximizing your Eterna."]
	quest.1B471AAA9FFAF622.title: "End Shelves"
	quest.1C2AC2DAF1196C26.title: "Sophisticated Stuff"
	quest.1C4D28755E281880.title: "Storage Upgrades"
	quest.1C91BD525C91FD73.quest_desc: [
		"This stuff is everywhere."
		""
		"It can be used to give yourself experience, or used to make the Eternal Stella."
		""
		"It can also be used to provide Experience to the Forge."
	]
	quest.1D86B2E553503E53.quest_desc: ["The Dominion Wand is used for controlling the creatures you might encounter in the world! Each being responds differently to the wand, so make sure to read up in the Worn Notebook!"]
	quest.1D86B2E553503E53.title: "Summoning Help!"
	quest.1DDE8A1AAD6A07A2.title: "Some Chicken Feed"
	quest.1DEAB04B6DAEB07A.quest_desc: [
		"This is a very simple quest line, you can explore Fluid Cows and go down the rabbit hole if you want, or not.  It's up to you."
		""
		"Click the Checkmark to open up this quest line."
	]
	quest.1DEAB04B6DAEB07A.quest_subtitle: "That's not Milk..."
	quest.1DEAB04B6DAEB07A.title: "Fluid Cows?  "
	quest.1F756D1AFFE32808.quest_desc: ["A Diamond Catalyst can be found in the Overworld in a Geode that is encased in Coal and Deepslate Diamond Ore blocks.  This one is a little harder to automate, it requires getting into Mekanism."]
	quest.1F756D1AFFE32808.quest_subtitle: "Observe a Diamond Catalyst"
	quest.207B61D794C4E0C5.quest_desc: ["If you fashion a crook out of sticks, you can use it on leaves to get more resources.  Sometimes a silkworm will drop which can be used to infest the leaves.  Using the crook on those leaves can yield string."]
	quest.207B61D794C4E0C5.title: "Stringy Leaves"
	quest.20B2360F04CD833B.quest_desc: ["If you aren't careful around your Rainbow furnace, it could explode and leave behind some coal..."]
	quest.20B495B4B8B95636.quest_desc: ["Combining a Dragon Head with a Mystical Dagger will give you &9Dragon Scales&r."]
	quest.20B495B4B8B95636.quest_subtitle: "Dragon Scales, Dragon Scales....."
	quest.20B495B4B8B95636.title: "Dragon Scales"
	quest.2185AF69822CFB79.quest_desc: ["You can craft some basic tools out of string, wood and sticks.  Make a sieve, string mesh, wooden barrel and crucible using your wood of choice.  These will allow you to sieve gravel, sand, dust and crushed stones into resources.  You can also create a Water Condenser."]
	quest.2185AF69822CFB79.quest_subtitle: "Additional Resources"
	quest.227DBA8836021B0B.quest_desc: [
		"In Ars Nouveau, the power system for machines is called &9Source&r."
		""
		"To start collecting some Source, we'll need a Source Jar."
		""
		"Source can also be moved with buckets, or by breaking and picking up Source Jars."
	]
	quest.227DBA8836021B0B.quest_subtitle: "Storing Source"
	quest.23255D29E4664AA2.quest_desc: [
		"There are more Otherworld items you will need to gather, and eating &cDemon's Dream Fruit&r every time you need the &7Third Eye&r effect gets annoying."
		""
		"This is what the &dOtherworld Goggles&r are for! When equipped (even in your Curios slot), it gives the Third Eye effect!"
	]
	quest.23255D29E4664AA2.title: "Quit Eating That Fruit!"
	quest.23B86F6AAA934D5A.quest_desc: ["Augment an Awakening Ritual with a Book and Quill to produce a Bookwyrm Charm."]
	quest.24261D6C5C5A6CB4.quest_desc: ["This Dragon Egg is a cool decoration piece. That's pretty much it."]
	quest.244554D264A262E1.quest_desc: [
		"A Simple Coal Generator from JustDireThings as a POI will bring Direwolf20 into your world."
		"Trade with Direwolf20 for items from his mods!"
	]
	quest.244554D264A262E1.title: "Direwolf20"
	quest.24E94326C3CE86E4.quest_desc: [
		"To enchant an Enchantment Library to a Library of Alexandria, you need the following configuration:"
		""
		"6x Echoing Sculkshelf"
		"3x Melonshelf"
		"2x Draconic Endshelf"
		"2 Infused Seashelf"
	]
	quest.24E94326C3CE86E4.title: "Library of Alexandria"
	quest.2541213137D4A200.quest_desc: [
		"The Activator Wand is a necessary tool for interacting with Catalysts.  It allows you to \"Break\" them by making them drop in place, and also move them a few blocks at a time.  It's also crucial for crafting Agitator of various tiers to agitate the Catalyst and produce blocks."
		""
		"This tool may work on budding blocks too."
	]
	quest.25D4F2BB5428C94F.quest_desc: ["You need 27 blocks to assemble!"]
	quest.2611007C0FEF1316.quest_desc: [
		"Iesnium is required for some Occultism quests."
		"It can be crafted via Pneumaticcraft, please refer to JEI for the recipe."
	]
	quest.2611007C0FEF1316.title: "Iesnium"
	quest.2640805D9A241C3F.quest_desc: [
		"This is a very simple quest line, you can explore Chickens and go down the rabbit hole if you want, or not.  It's up to you."
		""
		"Click the Checkmark to open up this quest line."
	]
	quest.268717C76D68C0F8.quest_desc: ["Maybe you don't need to craft this...  Maybe one could trade for it."]
	quest.26C126C0893C8072.quest_desc: [
		"The Fluidizer is a multiblock machine that let you convert solid fuels to fluids and to mix existing fuels to create new ones."
		""
		"The Fluidizer is a 3x3x3 (minimum size) machine build from Casing blocks and a mix of the other device parts."
		"Glass can be used in place of Casing blocks in the all faces of the machine (but not on the frame)."
		""
		"This task is for a 5x5."
		""
		"Check each Fluidizer part page in the Extreme Reactors Manual for restriction on where each part can be placed."
	]
	quest.283EA4E7BA93DA11.quest_desc: [
		"The Empowerer requires 4 display stands placed around it with 2 blocks of space between them."
		"The Display Stands also require power."
		""
		"{image:kubejs:textures/ftbquests/actually_empowerer.png width:200 height:200 align:center}"
	]
	quest.2883123DEACD9E50.quest_desc: ["Where does this portal lead?"]
	quest.2894F11A73335179.quest_desc: [
		"Smelting down Arcane Crystals will give you Arcane Crystal Dust."
		""
		"This is used for most of the items in the mod."
	]
	quest.29164630E1BD76B5.quest_desc: ["This is the main resource in the mod. Go out and mine some!"]
	quest.29164630E1BD76B5.title: "Arcane Crystals"
	quest.295C77EEC89000FC.quest_subtitle: "Generates Source from Mob Deaths and Animal Breeding"
	quest.2992268BD1E5C553.title: "Empowered Crystals"
	quest.29CCC076979B9CA1.quest_desc: ["The shaft drops from the Warden with a 33% chance, it is also a random trade from a Wandering Trader, so maybe you'll get lucky!"]
	quest.2B53B6EE76150834.title: "Evoker Spawn Egg"
	quest.2C2B2ACBBE38708A.quest_desc: [
		"The next step in your journey will be to find &eIesnium Ore&r in the Otherside."
		"Setup a Mining Laser in the Otherside using a White Lens to acquire this rare resource."
		""
		"Since you can't break this ore down into double the dusts using the standard methods, try using your Foliot Crusher to double your ingots per raw ore!"
	]
	quest.2C2B2ACBBE38708A.title: "&cIesnium: Ore of the Otherworld&r"
	quest.2C4804933C3A2F37.quest_desc: [
		"You're bound to have too many items playing this modpack. It's just it works, and if you haven't figured out your storage situation yet, &dDimensional Storage&r might just be right for you!"
		""
		"To get started with this magical storage solution, you'll need to craft the &dDimensional Storage Actuator&r and place it down into the world. This acts just like a Shulker Box, meaning if you break it, it won't lose any of the items stored inside. "
		""
		"By default, this has 128 storage slots with each slot holding up to 16 stacks of an item, except for items with &5NBT&r data. These will not stack and will take up an entire slot, so make sure to leave those items out!"
		""
		"If you aren't sure what items have NBT data on them, you can always check out the quest \"NBT and You\" in the Storage questline for more info on NBT!"
	]
	quest.2C4804933C3A2F37.title: "&c&mDemonic&r &dMagical Storage&r!"
	quest.2C9418AEFF6313CE.quest_desc: [
		"Automation is key, one of the items you'll need to complete later quests is Time Crystals."
		"You should probably work out how to get a lot of them."
	]
	quest.2C9418AEFF6313CE.title: "Getting into Time Manipulation"
	quest.2CA21901E55D28CA.quest_desc: [
		"Occultism provides more than just Demons to crush your ores!"
		""
		"There are Demons that can move stuff for you, chop down wood, and more!!"
		""
		"There are also ways to summon cool friends known as &dFamiliars&r that give special buffs and even fight for you! Make sure to check out the &dFamiliar Rituals&r in your guide book!"
	]
	quest.2CA21901E55D28CA.title: "&dFamiliars&r"
	quest.2D0CF18C8B2ABB7D.quest_desc: [
		"Placing this near growing plants or saplings will provide Source. Archwood trees provide more Source!"
		""
		"Note: Bonemealing does not produce Source."
	]
	quest.2D0CF18C8B2ABB7D.quest_subtitle: "Creates Source using the growth of Plants"
	quest.2DA9D19D1739DDE8.quest_desc: [
		"The Cow Snatcher is like a Chicken Stick, it allows you to capture a Fluid Cow as an Item."
		"It doesn't work on normal Cows..."
	]
	quest.2E15B77AB718199A.quest_desc: ["Ars Nouveau isn't a complicated Magic Mod but it does require some automation and preparation to get things going.  You will need to work toward Rituals and item hoarding!"]
	quest.2E15B77AB718199A.title: "Getting into Ars Nouveau"
	quest.2E44163E411DDE17.quest_desc: [
		"Summon a Wilden Chimera in a Compact Machine or an area that you don't care about."
		"When summoned, the Wilden Chimera will destroy blocks."
		""
		"Be sure to augment the ritual properly :D"
	]
	quest.2E63C32D3847292C.quest_desc: ["Now that we have a Foliot Crusher, we can use it to crush down some &eEnd Stone&r and &9Obsidian&r for us. We'll use these to make some new Chalk!"]
	quest.2E63C32D3847292C.title: "&aChalking It Up&r"
	quest.2F8366DC0776728C.title: "Chaotic Ingredients"
	quest.306C75DD1CD5962A.quest_desc: [
		"Before we start enlisting the help of our Demon friends, we will need to create the most important item needed for Rituals: &aChalk&r."
		""
		"There are several colors of chalk needed, with higher level Rituals requiring several to activate. To start with, &bWhite Chalk&r is the easiest to get."
		""
		"Start by tossing Otherstone in a furnace, and tossing Otherworld Logs into &dSpiritfire&r. With the items you create, you'll be able to make the Impure White Chalk."
		""
		"To purify any piece of Chalk, simply throw it into &dSpiritfire&r to cleanse it. Using the Purified Chalk on the ground will draw &mdemonic&r pretty symbols on the ground. These are a pain to remove, unless of course, you make yourself the &aChalk Brush&r. Do it, it's worth it."
	]
	quest.306C75DD1CD5962A.title: "Preparing for a Ritual: &eChalk&r"
	quest.310B54FB390982C5.quest_desc: [
		"Blowing up matter balls with TNT will sometimes produce Dark Matter."
		""
		"You can make Black Holes with this."
	]
	quest.3142A40E1EAEBAA3.quest_desc: [
		"The &6Dowsing Rod&r gives you Magic Find and Scrying when used."
		""
		"This allows you to see nearby magic creatures as well as helping you find amethyst!"
	]
	quest.3142A40E1EAEBAA3.quest_subtitle: "Magic Finder"
	quest.3144BAF5D25972ED.title: "Ghast Spawn Egg"
	quest.315D49C884DE072F.title: "Random Severing Book"
	quest.3182E8AF755104E4.quest_desc: [
		"When blocking damage, the &9Enchanter's Shield&r will give the user Mana Regen and Spell Damage for a short amount of time."
		""
		"Additionally, the shield will repair itself over time using the wearer's mana."
	]
	quest.31F60634BB3E73E8.title: "Power Generator"
	quest.33682F4B44950123.quest_desc: [
		"To gain further knowledge of spells, we'll need a specific type of magical wood!"
		""
		"Archwood Trees can be found in the overworld."
	]
	quest.33682F4B44950123.title: "Archwood logs"
	quest.33F44B87C5496158.quest_subtitle: "Dragon Tools"
	quest.33F44B87C5496158.title: "&1Draco Tools"
	quest.34592A8F4B661D8D.quest_desc: [
		"You'll find the Stella Arcanum ore deep underground."
		""
		"Careful when mining."
	]
	quest.34592A8F4B661D8D.quest_subtitle: "This Goes Boom Too"
	quest.34EDBCE44F7C4002.title: "Tier 4 Soul - Chickens"
	quest.3513D89C6FD2D852.quest_desc: ["The Scepter shoots out energy orbs when charged up with Right-Click. If a mob is hit, it'll strike it with lightning."]
	quest.3513D89C6FD2D852.quest_subtitle: "Go Pew Pew"
	quest.3513D89C6FD2D852.title: "&1Draco Weapons"
	quest.35A46309C0FE316B.quest_desc: [
		"Demons like Candles. I think."
		""
		"For almost every Ritual to summon our friends, you'll need some Candles. You can create the &aButcher Knife&r and kill some pigs, cows, sheep, horses, or even the Trader Llamas to get some &aTallow&r to make them."
		""
		"Otherwise, Vanilla Candles can also work!"
		""
		"&9Spirit Attuned Crystals&r are also used in several Rituals, so might as well make some now!"
	]
	quest.35A46309C0FE316B.title: "Preparing for a Ritual: &aCandles&r"
	quest.35D97078258ADC3C.title: "Goo"
	quest.371DF7589239CB78.quest_subtitle: "Arrow Go Boom"
	quest.38DCA5E5717DB3E7.quest_desc: [
		"You must be level 65+ to infuse Block of Amethyst"
		""
		""
		"10x Crystalline Seashelf"
		"5x Normal Bookshelves"
	]
	quest.38DCA5E5717DB3E7.title: "Budding Amethyst"
	quest.39ABF31316F79E15.quest_desc: [
		"Once you've gathered a few &aRaw Iesnium Ores&r, you'll probably want to use the first few ingots to make an &dIesnium Pickaxe&r. This not only mines Iesnium like the Infused Pickaxe, but lasts a lot longer too."
		""
		"Do yourself a favor and make one of these!"
	]
	quest.39ABF31316F79E15.title: "&aThe Otherworld Pickaxe&r"
	quest.3B6A786CA9CDA778.quest_desc: ["[ \"Jump over to the \", { \"text\": \"Create Quest Line\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"104C306C5D7FA8CA\" } }, \" to unlock this Task!\" ]"]
	quest.3C8DBF896C0080F8.quest_desc: ["This item is used to capture Demons for transport or storage."]
	quest.3C8DBF896C0080F8.title: "&dEmpty Soul Gem&r"
	quest.3D26E779056335F0.title: "Molten Netherite Cow"
	quest.3D4D88B8BE881351.quest_desc: [
		"If you want to cast better spells, you'll need a &6Scribe's Table&r to unlock new glyphs for your spellbook."
		""
		"There are 3 tiers of glyphs to unlock, and each one requires some experience and items."
		""
		"The Scribe's Table is also used to attach spells to Spell Parchments. To do this, place a Spell Parchment on the table, select the spell in your Spellbook, then sneak right-click the book on the table."
		""
		"To create a Glyph, right-click on the Scribe's Table with your spellbook. Search for the glyph you want to make, then click Select at the bottom. Right-click the table with the items required, and the glyph will be created. Use the glyph to learn it."
		""
		"Note: The table can pull items from nearby inventories."
	]
	quest.3D4D88B8BE881351.quest_subtitle: "Upgrading Spells"
	quest.3D862A3D3F83CA26.quest_desc: [
		"The &9Enchanting Apparatus&r is used to craft various items within the mod. It requires Source to work."
		""
		"It is also a multiblock structure that utilizes Arcane Pedestals to craft."
		""
		"Start by placing an Arcane Core in the ground, then place the Enchanting Apparatus on top of it. Surround the Apparatus with Arcane Pedestals."
		""
		"{image:kubejs:textures/ftbquests/ars/enchanting_app.png width:200 height:175 align:1}"
	]
	quest.3D862A3D3F83CA26.title: "Enchanting Apparatus"
	quest.3D8E2CC5DA97A158.quest_desc: [
		"Now that you've started to automate resources and are working toward automation, it's time to step up the game."
		"In this chapter we're going to move through advanced technology and automation."
	]
	quest.3D8E2CC5DA97A158.quest_subtitle: "Staying here isn't an option."
	quest.3D8E2CC5DA97A158.title: "This is not ok!"
	quest.3DBDC440E6037CA6.quest_desc: "Punch a tree. It’s not glamorous, but you’ll need logs to begin rebuilding the world."
	quest.3DBDC440E6037CA6.title: "The First Splinter"
	quest.3F052D11F492DF28.quest_desc: ["Now that you’ve created a Water Condenser, it will produce water non-stop and even more while raining.  You can bucket it out and create an infinite water source using the traditional methods."]
	quest.3F052D11F492DF28.quest_subtitle: "Free Water"
	quest.3F052D11F492DF28.title: "Infinite Water"
	quest.3F2DC193716B1493.quest_desc: [
		"Want to access your storage remotely? This can be done with either the &eStable Wormhole&r or the &aStorage Accessor&r."
		""
		"To use the &eStable Wormhole&r, shift-click a &dStorage Actuator&r to link it. You can then place the Wormhole to act as another storage location."
		""
		"The &aStorage Accessor&r is linked in the same way, but acts as a wireless remote that can even work across dimensions!"
	]
	quest.3F2DC193716B1493.title: "&aRemote Access&r"
	quest.3FD702B5AB006402.quest_desc: [
		"Have you ever wanted to just hover everywhere you go?"
		""
		"This belt allows you to levitate. To activate, just sneak while in the air, either while falling or from jumping."
	]
	quest.4024DEB2A833B351.title: "Capturing Book"
	quest.40BC67BDEE15D1DE.quest_desc: ["To create Source Gems, you need to toss Runic Tablets through an Elven Portal!"]
	quest.40BC67BDEE15D1DE.title: "&5Source Gems"
	quest.41A0BE357C8A74E1.quest_desc: [
		"The &9Alchemical Sourcelink&r produces Source from adjacent potion jars."
		""
		"The amount of source varies per potion and complexity."
	]
	quest.41A0BE357C8A74E1.quest_subtitle: "Power through Potions"
	quest.41CA447EE144BFA1.title: "Tier 5 Soul - Chickens"
	quest.43559CD679BC6F5D.quest_desc: ["Punch a tree, gather some sticks and saplings and farm some trees.  There’s no twerk, but you can craft a Sapling Grower."]
	quest.43559CD679BC6F5D.quest_subtitle: "Time to start gathering resources"
	quest.43559CD679BC6F5D.title: "Tree Farming"
	quest.44065ABEC5F36B42.title: "Amadron Tablet"
	quest.441C0659ED28D935.quest_desc: ["Tier 1 Glyphs require 3 levels of experience to be made."]
	quest.441C0659ED28D935.title: "Tier 1 Glyphs"
	quest.4476473EC7789E01.title: "Rose Quartz"
	quest.44B1B147CDAC4E36.quest_desc: ["This gives X-Ray vision for mobs, highlighting them from afar to make it easier to spot them."]
	quest.44B1B147CDAC4E36.quest_subtitle: "Highlights Mobs when Activated"
	quest.457DE8C154641437.quest_desc: [
		"The &9Ritual Brazier&r is used to cast rituals. It can also be used for decoration. If you want to light the Brazier, use a Light spell on it."
		""
		"To perform rituals, you'll need Arcane Pedestals as well. As there are so many rituals to cast, make sure to check out each of them using the &6Worn Notebook&r!"
		""
		"This can be done by holding Ctrl on the Ritual Table while the book is in your inventory."
	]
	quest.4883532DEB30A197.quest_desc: ["The Blood Extractor is used to collect blood from killed mobs, it's also a convenient way to transport blood from a tank or device to another."]
	quest.48CF368B718D0EF0.quest_desc: [
		"For us to specify which &c&mDemon&r &9Friend&r we want to summon, we'll need to make a specific &bBook of Binding&r."
		""
		"To make this, you'll need to purify some Black Dye in &dSpiritfire&r to get Purified Ink. With this, we're going to make our first Book of Binding which will summon a &aFoliot&r Demon."
	]
	quest.48CF368B718D0EF0.title: "&bBooks of&r &dBinding&r"
	quest.4947F4C983CD728D.quest_desc: [
		"The Reactor is a multiblock machine that can generate power directly or be used to vaporize coolants. The generated vapors can later be used to drive a Turbine rotor."
		""
		"To produce cyanite, we need a Basic Reactor that's fueled with Uranium."
		"You can make a 3x3 or a 5x5 to start, a 5x5 will produce waste faster which you need to progress..."
	]
	quest.4A143DF3CC65D60E.quest_desc: ["These tablets... they are so familiar yet so foreign.  These rare relics of a long forgotten past must be important.  You need to find all 4 variants, keep exploring the islands."]
	quest.4AAA1BDCFED51734.quest_desc: [
		"The first step to progress through Apothic Enchanting is to craft 16 and place 15 sea shelves in a 5x5 around an enchanting table leaving out the corners."
		""
		"Take the last shelf and place it in the enchanting table to infuse it.  You need 45 levels for this step."
		""
		"Take that infused shelf and replace a non-infused shelf and repeat this process until you have all 16 infused.  This will leave you with 1 extra. "
	]
	quest.4B45E51A11E59EBB.quest_desc: ["This item is hard to get, you must complete \"The Queen's Desire\" advancements from The Bumblezone.  Open the Advancements Screen and get started!"]
	quest.4BC65A54561C997F.quest_desc: ["This is the best way to get early game Blaze Rods!"]
	quest.4C8DF36565175E79.quest_desc: [
		"What if I told you that the Demon's Fruit is flammable?"
		""
		"Throwing our &cDemon's Dream Fruit&r down and setting it on fire will create &dSpiritfire&r. This is how we'll convert some overworld items into &9Otherworld&r materials."
		""
		"It's also pretty."
	]
	quest.4C8DF36565175E79.title: "The Flames of &9The Otherworld&r"
	quest.4C9BFD1BE7B7CE1A.title: "Starter Enchanting"
	quest.4CD6BAD4F6BCF55B.quest_desc: [
		"You must be level 80+ to infuse Dragon’s Breath"
		""
		""
		"5x Echoing Sculkshelf"
		"2x Soul-Touched Sculkshelf"
		"5x Melonshelf"
		"5x Normal Bookshelf"
		"1x Geode-Encased Bookcase of Stability"
	]
	quest.4CD6BAD4F6BCF55B.title: "Infused Dragon's Breath"
	quest.4CF3F8A13E7718C6.quest_desc: [
		"The Soul Extractor extracts Souls from Chickens.  A little dark, but it's just a game :D"
		"Combine these Souls with Seed to make Chicken Seed."
		""
		"Placing on top of a Barrel will auto export the soul into the barrel."
		""
		"Make sure you have enough Chickens, 1 Chicken = 1 Soul."
	]
	quest.4DA04ABF4FF2625C.quest_desc: [
		"&dAureal Bottles&r can only be crafted using a custom recipe, check JEI for details."
		""
		"You can also generate Aureal with Arcane Crystal Obelisks."
	]
	quest.4DA04ABF4FF2625C.title: "&9Aureal"
	quest.4DA1C95BED78A662.quest_subtitle: "Better than Netherite"
	quest.4DA1C95BED78A662.title: "&1Draco Arcanus Armor&r"
	quest.4DC7F9FF34E8D009.quest_desc: ["A fantastic way to get all the passive mobs."]
	quest.4E6709A65237E795.quest_desc: ["If you haven't been hoarding resources, you aren't playing Modded Minecraft the right way."]
	quest.4EE44CF2809EFF71.quest_desc: ["Repair your items with Blood, kinda weird but it's neat."]
	quest.51162B9185A45BB1.quest_desc: [
		"This bow can be inscribed with a spell using a Scribe's Table."
		""
		"At the cost of mana, arrows will become Spell Arrows and will apply the spell on their target."
		""
		"If you have no arrows, a spell arrow that deals 0 damage will be cast. If there is not enough mana, regular arrows will be fired instead."
		""
		"The &9Enchanter's Bow&r can also use special Augment Arrows that empower the inscribed spell."
	]
	quest.526559F94031FE43.quest_desc: [
		"The &6Eternal Stella&r has 3 charges, and when right-clicked, can fully repair all of your items in your inventory."
		""
		"The main purpose of it is to give the enchant &9Unbreakable&r to an item, which is done by combining it with a tool and an &dApply Item Modifier Smithing Template&r in a Smithing Table."
	]
	quest.526559F94031FE43.title: "&dEternal Stella"
	quest.536B56D0A6208E8C.title: "Tier 1 Soul - Chickens"
	quest.53742E3C945D3D53.quest_desc: [
		"If you look into the distance, or maybe even just down, you'll see some remnants of what was."
		"Although upon closer inspection, things don't look quite right, nothing seems familiar."
		""
		"Find a Shattered Island and see if it contains any secrets or clues.  Maybe you'll find something useful."
	]
	quest.537E39530360AD73.quest_desc: [
		"To perform a ritual, place the ingredients on the Arcane Pedestals around the Forge."
		""
		"You'll need a &9Blacksmith's Gavel&r to activate the ritual. To do this, right click on the Forge with the Gavel."
	]
	quest.537E39530360AD73.title: "Performing Rituals"
	quest.53A91BCC28F097D3.quest_desc: [
		"For our first Ritual, we want to summon a &aFoliot Crusher&r Demon. This Demon will crush items for us, which is something we'll need to make some of the higher level Chalks!"
		""
		"To start with, combine your Unbound Book with your &aDictionary of Spirits&r in a crafting table. This will bind a Demon to the book, which is what we'll need for the Ritual."
		""
		"Speaking of your Dictionary of Spirits, it's time to open it up! On the left, click on the &dPentacles&r tab and click on &bAviar's Circle&r. You might have to advance through it by reading a little bit. There is also a way to click \"Mark All As Read\" so it unlocks everything in the book."
		""
		"This is what we're going to use to summon our new Friend. On the right side, you can click the eye in the bottom-left corner of the image to build an outline of the Ritual for you in the world. This is super helpful!"
		""
		"Once you've completed the multi-block Ritual, place down 4 Sacrificial Bowls and use the required items on them. Once you place your Bound Book in the Golden Sacrificial Bowl, the Ritual will start!"
		""
		"This is what the Ritual will look like. The rods are just there for lighting."
		""
		"{image:kubejs:textures/ftbquests/occultism/rituals/summoning/aviars_circle.png width:200 height:200 align:center}"
	]
	quest.53A91BCC28F097D3.title: "&bYour First&r &dRitual&r"
	quest.5401932B11AE7EA4.quest_desc: [
		"No, not that kind."
		""
		"&cAfrit Demons&r are Demons of &cFire&r. They are more advanced Demons, which some are friends and some are....not."
		""
		"If we want to collect all of the Chalks, we'll need to summon a not-so friendly Afrit. And kill it."
		""
		"This specific Ritual will need a live sacrifice. Once you've placed all of the items needed and the Book of Binding into the Golden Sacrificial Bowl, the Ritual will not start until you sacrifice the living creature nearby it. In this instance, we'll be sacrificing a cow. "
	]
	quest.5401932B11AE7EA4.title: "&cHot Demons&r"
	quest.542C6D76B579886C.quest_desc: [
		"When your Magebloom seeds.... bloom, you can use the Magebloom to create Fibers."
		""
		"These are used to craft several items, including your first set of magical armor!"
	]
	quest.549DA4E1EDE3F480.quest_desc: [
		"Create a Foundry, it will be useful in automations."
		"You need at least 1 Drain, a Controller and as many Bricks as you can.  A foundry must be a "
		"full cube, unlike the old Tinker Smeltery."
		""
		"The main usage of the Foundry will be to convert liquids from Fluid Cows to ingots or blocks."
	]
	quest.5523A71F1688EA88.quest_desc: [
		"Forbidden \\&\\ Arcanus adds new ways to get better armor, enchants, and more!"
		""
		"This magic-themed mod has amazing animations, as well as some overpowered items like the &6Eternal Stella&r. "
	]
	quest.5523A71F1688EA88.title: "Welcome to &5Forbidden \\&\\ Arcanus!"
	quest.559411CB99A135DB.quest_desc: [
		"Most of the items we've needed from the &3Otherworld&r so far just needed some Spiritfire. However, we will need to use the help of the &3Third Eye&r to find the Ore of the &3Otherworld&r."
		""
		"We'll also need a special pickaxe to be able to mine it. For this, we'll need to Infuse a Demon into a &dSpirit Attuned Pickaxe Head&r to create a pickaxe that can break this new kind of ore."
	]
	quest.559411CB99A135DB.title: "New Tools for New Ores"
	quest.56046D7D30F0A903.quest_desc: [""]
	quest.568C3386D7E0E7D3.quest_desc: [
		"Max Enchanting requires the following configuration:"
		""
		"5x Echoing Sculkshelf"
		"5x Soul-Touched Sculkshelf"
		"1x Deepshelf of Arcane Treasures"
		"1x Draconic Endshelf"
		"1x Geode-Encased Bookcase of Stability"
		""
		"You can achieve max stats in other ways, here's another example to get 100% on every stat + Rectification, Treasure Enchants and two filters:"
		""
		"1x Deepshelf of Arcane Treasures"
		"7x Echoing Sculkshelf"
		"5x Soul-touched Deepshelf"
		"4x Draconic Endshelf"
		"4x Shelf of End-fused rectification"
		"2x Seashelf of Aquatic Filtration"
	]
	quest.568C3386D7E0E7D3.title: "Max Enchanting"
	quest.56C9B9B53EC2E9EB.title: "Dragon Head"
	quest.5727A93DF4423FFB.quest_desc: ["Porcelain isn't used for much but it is used to make a crucible which is very important for getting into the early-mid game."]
	quest.5737066C71353CCC.quest_desc: [
		"Using your 13 Crystaline and 2 Infused Sea Shelves,"
		"Craft 10x Dormant Deepshelves and infuse them into Deepshelves."
		""
		"This does require 60+ levels to do and your Sea Shelf setup will work."
		""
		"Craft those Deep Shelves to 5x &3Soul-Touched Sculkshelf&r and 5x  &3Echoing Sculkshelf&r"
	]
	quest.5766C8B9E850C186.quest_desc: [
		"To create some of the main crafting items in Ars, the &9Essences&r, we'll need to make an &6Imbuement Chamber&r."
		""
		"The Imbuement Chamber requires Source to imbue items. It produces a small amount of Source by itself, but can also use Source Jars as a power source."
		""
		"Several recipes also require Arcane Pedestals to be placed around it as well."
		""
		""
		"{image:kubejs:textures/ftbquests/ars/imbuement.png width:200 height:150 align:1}"
	]
	quest.5766C8B9E850C186.quest_subtitle: "Creating Essences"
	quest.58EC47584C773B82.quest_desc: [
		"Growing Mage Bloom will allow for the creation of magebloom fiber."
		"This will be used to create us some magical clothing and other items!"
	]
	quest.58EC47584C773B82.quest_subtitle: "Growing Magic"
	quest.58EC47584C773B82.title: "Magebloom Seed"
	quest.5A398EAB0DD6DDED.title: "Reliquary Item"
	quest.5B37AE6B59DA87F8.title: "Tier 2 Soul - Chickens"
	quest.5B484850B11CDC25.quest_desc: [
		"Occultism appears difficult at first glance but once you get past forming the rituals, it's just a neat crafting mechanic and mob summoning mechanic."
		"You'll need to work toward the end-game rituals for mob summoning and item acquisition."
	]
	quest.5B484850B11CDC25.title: "Getting into the Occult"
	quest.5BE0073731C702AD.quest_subtitle: "Good Luck"
	quest.5C3FF43CF16BCF30.quest_desc: ["With Source Gems, you can get started crafting the various machines by creating &5Sourcestones&r."]
	quest.5C3FF43CF16BCF30.quest_subtitle: "Formerly known as \"Arcane Stones\""
	quest.5C3FF43CF16BCF30.title: "Sourcestones"
	quest.5CF175DA7BDA52F3.quest_desc: [
		"The &dHephaestus Forge&r can be upgraded into higher tiers using things like Spawner Scraps, Arcane Crystals, and more!"
		""
		"You'll need higher tiers to make some of the higher tier items, like the &aWarp Stone&r. Make sure to check out JEI for more info!"
	]
	quest.5CFBA24B3E0CDEDD.quest_desc: [
		"While holding your Spellbook, you can press C to open up the spell creation page."
		""
		"Each spell must have a form. You start off with 3 basic forms: Projectile, Self-cast, and Touch."
		""
		"For the Effect, this determines what happens when you cast the spell. You can have up to 9 effects per spell."
		""
		"For starters, you have Harm and Break."
		""
		"Select one Form and one Effect, name your spell, and click create!"
		""
		"{image:kubejs:textures/ftbquests/ars/spellbook.png width:200 height:150 align:1}"
	]
	quest.5D6F78195BF53C83.quest_desc: [
		"This is the processing tree for Extreme Reactors:"
		""
		"Basic Reactor:"
		"- Uranium -> Cyanite"
		"- Blutonium -> Magentite"
		""
		"Reinforced Reactor:"
		"- Liquid Verderium -> Liquid Rossinite"
		""
		"Reprocessor:"
		"- Water + Cyanite = Blutonium"
		"- Liquid Cyanite + Blutonium = Ludicrite"
		"- Liquid Magentite + Ludicrite = Ridiculite"
		"- Liquid Rossinite + Ridiculite = Inanite"
		"- Liquid Rossinite + Benitoite = Insanite"
		""
		"Fluidizer:"
		"- Cyanite -> Liquid Cyanite"
		"- Blutonium -> Liquid Blutonium"
		"- Magentite -> Liquid Magentite"
		"- Uranium -> Liquid Yellorium"
		"- Liquid Blutonium + Liquid Yellorium = Liquid Verderium"
	]
	quest.5D7503D0FAD00D69.quest_desc: [
		"Create a Vengeance Pickaxe, a couple of Blooks and use the Purifier to get a Fortune V book."
		"A fairly cheap and easy way to do it."
	]
	quest.5E45D2A2FDD67495.quest_desc: ["This goes in the right side of the forge."]
	quest.5E45D2A2FDD67495.quest_subtitle: "Experience in a bottle"
	quest.5E45D2A2FDD67495.title: "&aBottle O' Enchanting"
	quest.5EF5265F155D7FDC.quest_desc: [
		"There are a couple ways to summon a warden to acquire the Heart to light the portal and advance to the Otherside dimension."
		""
		"1) You can buy a Sculk Shrieker from the Marketplace, craft a Sculk Core and activate it."
		""
		"2) You can use the Occultism Ritual to summon a Possessed Warden."
	]
	quest.5EFC63CF97D97AB5.quest_desc: [
		"Crafted with skulls, bones, and cloth, this armor is slightly stronger than Iron."
		""
		"It's also really cool looking."
	]
	quest.5EFC63CF97D97AB5.quest_subtitle: "Armor of the Dead"
	quest.5EFC63CF97D97AB5.title: "Mortem Armor"
	quest.5F5675E30ED046F7.quest_desc: ["You've probably already acquired some Darkstone, but we'll need it to craft the forge."]
	quest.5F5675E30ED046F7.title: "Prepping For the Forge"
	quest.60DC069FA02B604E.quest_desc: [
		"The Reprocessor is a multiblock machine that let you reuse spent fuel by converting waste produced in the Reactor into new fuel sources or other resources"
		""
		"The Reprocessor is a 3 by 3 and 7 blocks high machine build from Casing blocks and one each of the other device parts."
		"Glass can be used in place of Casing blocks in the vertical faces of the machine (but not on the frame)."
		""
		"Check each Reprocessor part page in the Extreme Reactors Manual for restriction on where each part can be placed."
	]
	quest.61DA422DEC915740.quest_desc: ["Created in a Tier 3 Forge, Stellarite can be found in the Deep Beneath!"]
	quest.632BC46928CC9A8C.quest_desc: [
		"The &9Enchanter's Mirror&r will apply a self spell when used."
		""
		"Spells cast with this mirror are discounted and gain additional bonus duration."
		""
		"To apply a spell, use a Scribe's table. Create a spell without using a form."
	]
	quest.63A8DDFC739B0839.quest_desc: [
		"The &aDictionary Of Spirits&r serves as the Guide Book for &dOccultism&r. You'll absolutely need to make this if you want to continue with the mod!"
		""
		"The Dictionary has a quest-style guide inside of it if you'd rather read it instead of doing these quests!"
		""
		"You'll also need the book to craft several things in the pack, so you kind of have to make it. :)"
	]
	quest.63A8DDFC739B0839.title: "Little Book o' &cDemons&r"
	quest.63DD7F5A4441ACE7.quest_desc: [
		"Tier 2 Glyphs require 5 levels of experience to be made."
		""
		"They also require a &9Mage's Spell Book&r to create."
	]
	quest.63DD7F5A4441ACE7.title: "Tier 2 Glyphs"
	quest.64588BEDDE2C2249.title: "Random Glyph"
	quest.64BFE5596FFB820E.title: "Egg Sammich"
	quest.64D0E66CB4FBEC82.quest_desc: [
		"To get started, you'll need to craft yourself a &6Novice Spellbook&r."
		""
		"This is where you create and store your spells."
		""
		"Hitting the &9C&r key will open up the \"Create a Spell\" page. On the left, there are several tabs, but the main 3 are: Spell Creation, Color Picker, and Familiars."
		""
		"This spellbook will only allow you to create and use Tier 1 Glyphs. To create better spells, you'll need to upgrade your Spellbook!"
	]
	quest.64D0E66CB4FBEC82.quest_subtitle: "Our First Spellbook"
	quest.64EA1D0465771D44.quest_desc: [
		"Using Blooks and enchanted items, you can remove enchants and re-apply to new tools."
		"Without a Blook, you can remove curses from your tools and armor."
	]
	quest.65C9B8CF2718BDDB.title: "Tier 6 Soul - Chickens"
	quest.6681B9B5DD25B346.quest_desc: [
		"Craft a hammer, at this point you should be able to craft a Stone hammer."
		"This hammer will crush normal cobblestone to gravel and then gravel to sand and sand to dust."
		"The gravel, sand and dust can be sifted in the sieve to get more resources."
	]
	quest.6681B9B5DD25B346.quest_subtitle: "Hulk Smash!"
	quest.6681B9B5DD25B346.title: "Hammer Time"
	quest.6729039B94982392.quest_desc: [
		"The facility was destroyed, you followed evacuation protocol following the blackout but where did they send you? "
		""
		"You have burning questions: \"How do I get back\",  \"What happened to everyone I know?\", \"Where Am I???\""
	]
	quest.6729039B94982392.quest_subtitle: "Grateful to still be alive, let's figure out what to do next."
	quest.68458E69E231CD2E.quest_desc: ["Actually Additions is a neat Tech mod that offers new items and blocks as well as machines and foods.  Work towards empowering gems, you'll need them later."]
	quest.68458E69E231CD2E.title: "Getting into Actually Additions"
	quest.68DE80BE129EEDAB.title: "Tier 8 Soul - Chickens"
	quest.68F2094DA029B883.quest_desc: [
		"Spawners cannot be crafted but they can be found in the Shattered Overworld in some random islands.  You can Silk Touch them and upgrade them."
		""
		"Once you are able to reach the Deep Beneath, you'll find dungeons there too."
	]
	quest.6A1C0B17B22CE50F.quest_desc: [
		"The &9Amulet of Mana Boost&r gives a boost to max mana."
		""
		"The &6Amulet of Mana Regen&r gives a boost to your mana regen."
	]
	quest.6A1C0B17B22CE50F.title: "The Amulets"
	quest.6B3842B6FB92EE88.quest_desc: [
		"With a Sky Stone Catalyst as the POI, the villager will transform into DarkLotus."
		"The pack creator and mod author of a few mods in this pack."
	]
	quest.6B3842B6FB92EE88.title: "DarkLotus"
	quest.6B511C8B572E8940.quest_desc: [
		"In the bottom left of your screen, you'll see a bar. This bar is your mana pool!"
		""
		"There are several ways to increase your mana pool, or increase the efficiency of your spells as you progress through the mod. Upgrading your spellbook can also increase your mana!"
	]
	quest.6B511C8B572E8940.quest_subtitle: "Mage Power"
	quest.6B6FA49DA4AE6347.title: "Tier 7 Soul - Chickens"
	quest.6BFC0E61BA72FD4A.quest_desc: [
		"See, they aren't all bad!"
		""
		"If you've completed the Ritual properly, you'll now have your very own &cFoliot Crusher Demon&r. These Demons are great at crushing down items for you!"
		""
		"To give it an item to crush, just throw it nearby and it will pick up the item and crush it. You can also sneak-right click the Demon to open up the inventory."
		""
		"This is a starter Demon, so it won't last very long. This one can also double your ore output for you!"
	]
	quest.6BFC0E61BA72FD4A.title: "&aTalking with our New Friend!&r"
	quest.6C35871E17DFC923.quest_desc: [
		"Craft a 14 block portal frame, traditional shape."
		"Attune your Portal Activator and light the portal!"
		""
		"14 blocks * 9 Ingots = 126 total ingots."
		"The crafting recipe makes 3 ingots at a time so you need 42 of each type of ingot."
	]
	quest.6C379B36B0421D5E.title: "Legendary Talisman Base"
	quest.6C3DBAA2B65BF46B.title: "Spawn Eggs"
	quest.6C70264ACE9EFC9E.title: "Sculk Shrieker"
	quest.6C832BFE4D07D897.quest_subtitle: "Leaves an AoE Cloud that damages living mobs"
	quest.6DAA82B5F94AF9F8.quest_desc: [
		"The &9Jar of Light&r summons a floating light source that follows you."
		""
		"The &6Jar of Voiding&r destroys items you pick up in exchange for mana. This can be filtered."
		""
		"To add or remove an item to be destroyed by the jar, use the jar with the item in your off hand, or use an item on the Scribe's Table with the jar placed on it."
		""
		"The jar must be on your hotbar to function."
	]
	quest.6DD184484C77A120.quest_desc: ["Some ores can ONLY be found in The Deep Beneath."]
	quest.6E0E13806F388D7E.quest_desc: [
		"Welcome to &aArs Nouveau&f!"
		""
		"Ars Nouveau is a magic mod that allows you to create custom spells with the different Glyphs made within the mod!"
	]
	quest.6E3B9051503B938C.quest_desc: [
		"Found within the Dark Forest biome, the Edelwood Tree looks like a small tree that has been chopped in half."
		""
		"You'll need to break the branches off and collect the logs, as these are used for crafting various items within the mod."
	]
	quest.6E3B9051503B938C.title: "Edelwood Trees"
	quest.6F3602F5600A6221.quest_desc: [
		"Tier 3 Glyphs require 10 levels of experience to be made."
		""
		"They also require an &6Archmage's Spell Book&r."
	]
	quest.6F3602F5600A6221.title: "Tier 3 Glyphs"
	quest.6F43F98CBC0AC7DD.title: "Rabbit Spawn Egg"
	quest.70112194DFFD15D3.title: "&5Tyr Armor"
	quest.70F11154917548DD.quest_desc: [
		"The pieces of the puzzle are coming together, you now know what you must do."
		"Assemble the pieces, craft the portal."
	]
	quest.70F11154917548DD.title: "It's time to get serious and get out of here!"
	quest.70F4C671DCF3B91D.quest_desc: ["If you punch the grass, pebbles can be easily extracted.  Hold one in your off-hand and only pebbles of that type will be extracted."]
	quest.70F4C671DCF3B91D.quest_subtitle: "Gather Pebbles"
	quest.70F4C671DCF3B91D.title: "A platform from pebbles"
	quest.712296B27E322887.quest_subtitle: "Good Luck!"
	quest.712296B27E322887.title: "Craft a Portal"
	quest.715F7E5F0D4F60B5.quest_desc: [
		"Break 13 of the Infused Sea Shelves and craft them into Crystaline Seashelf."
		""
		"Place those back down so you have 13 Crystaline and 2 Infused Sea Shelves."
		""
		"This should give you 60 Eterna, 54% Quanta and 75 Arcana."
	]
	quest.72BB8E2A46373F83.title: "Reinforced Deepslate"
	quest.732691A663CACE25.quest_desc: ["Now that you've found your way back to solid ground, find your way to a village, rent a cottage and celebrate your victory!  Congratulations, you've escaped the Shattered Skies!"]
	quest.73349B993DE69954.quest_desc: [
		"We'll be using all of that Darkstone to create the &dHephaestus Forge&r."
		""
		"Once you have all of the blocks needed, you'll need to build the platform for the forge!"
		""
		"{image:kubejs:textures/ftbquests/forbidden/forge.png width:200 height:200 align:1}"
		""
		"The 8 Chiseled Arcane Polished Darkstone blocks on the outer ring of the platform can be used for pedestals or Arcane Cryal Obelisks, with the last block being placed in the center of the platform. "
		""
		"On top of the center block, place a Smithing Table and sneak+right-click it with a piece of Mundabitur Dust to convert it to the Forge!"
	]
	quest.73349B993DE69954.title: "&1The Hephaestus Forge"
	quest.734FBB4641FC55BC.quest_desc: "Smash stone with your hammer to create Gravel, Sand, and Dust. These materials hold secrets when sifted."
	quest.734FBB4641FC55BC.title: "The Dust Settles"
	quest.7356DEDA6609B9A3.title: "Rainbow Chalk"
	quest.73F8EA8CF06536F2.quest_desc: "Craft your first wooden and stone tools. You’re on your own now."
	quest.73F8EA8CF06536F2.title: "Tools of Survival"
	quest.7439CFAD20E3E2BF.quest_desc: [
		"Using this bone meal on Farmland will convert it to Magical Farmland."
		""
		"Crops will produce double the output when grown on Magical Farmland."
	]
	quest.7439CFAD20E3E2BF.quest_subtitle: "Use on Farmland to make it Magical!"
	quest.744A01000E086CC9.quest_desc: [
		"The Dragon Scale can be made into a Golden and Aquatic Dragon Scales."
		""
		"These are mainly used to craft &dTyr Armor&r."
	]
	quest.745841EC7F8E91BB.quest_desc: ["It all starts with the Chicken Stick.  Once crafted, you can use this stick to capture chickens.  It's kind of like getting villagers as items but chickens..."]
	quest.74AC6723C0EBE39E.title: "Shadowpulse Goo"
	quest.757E1521D84AC5C8.quest_desc: [
		"Blood is collected by crafting Test Tubes, then killing mobs with the Mystical Dagger."
		""
		"Note: The Test Tube must be in your inventory when killing mobs."
	]
	quest.757E1521D84AC5C8.title: "&4Blood"
	quest.76BC484FC50EAEC3.quest_desc: [
		"To enchant items, you'll need Darkstone Pedestals placed around the Forge."
		""
		"Make sure to place these on the Arcane Chiseled Polished Darkstone."
	]
	quest.76BC484FC50EAEC3.title: "Darkstone Pedestals"
	quest.770DBFEC8B7DDCA6.quest_desc: ["This is the best way to get early game Slime balls."]
	quest.77143120F8DF4B68.quest_desc: ["Build a traditional portal frame out of Reinforced Deepslate and light the portal with a Heart of the Deep."]
	quest.77145113CD5B26FB.quest_desc: [
		"Source Berries produce more Source than other sources."
		""
		"This will also convert grass or dirt into Mycelium in a 3x3 area around it. It will also grow mushrooms around it if the space is empty."
	]
	quest.77145113CD5B26FB.quest_subtitle: "Generates Source from Nearby Food"
	quest.77B5A7D2A7494A39.quest_desc: [
		"Welcome to &dOccultism&r!"
		""
		"This mod aimes to help you in many different ways by enlisting the help of &bSpirits&r! &oMost&r of which are friendly."
		""
		"To get started, you'll need to get some &aDemon's Dream Seeds&r."
		""
		"These can be acquired by breaking grass."
	]
	quest.77B5A7D2A7494A39.title: "&dDreaming of&r &cDemons&r"
	quest.784C12B49E3F564F.quest_desc: [
		"What is a Demonic Ritual without a &cSacrifice&r! :D"
		""
		"Most of the time, Demons just like items so don't be too afraid yet. However, if you have a favorite Cow, you might need to be worried. Sorry Betsy."
		""
		"&aSacrifical Bowls&r are used to place items needed for Rituals. These can be placed anywhere within the Ritual, as long as it isn't convering up any of the required Chalk."
		""
		"The &6Golden Sacrificial Bowl&r is used in the middle of the Ritual to activate it, and also usually needs a Book of Binding for the Ritual in it."
	]
	quest.784C12B49E3F564F.title: "Preparing for a Ritual: &dCrystals&r"
	quest.788A3685A7D07E75.quest_desc: ["Souls are gathered by creating a &9Soul Extractor&r, and then using it on Soul Sand."]
	quest.788A3685A7D07E75.title: "&dSouls"
	quest.78B5D726803B6533.quest_desc: [
		"That first Foliot Demon was cool, but what if I told you that you could summon a demon that gives you 6 dusts per raw ore it crushes?"
		""
		"The &5Marid Crusher&r does exactly that. To summon them, you'll need to use the &cFatma's Incentivized Attraction&r pentacle. This is an advanced ritual, requiring Red, White, and Gold Chalk as well as a lot of space."
		""
		""
		"{image:kubejs:textures/ftbquests/occultism/rituals/summoning/fatmas_incentivized_attraction.png width:200 height:200 align:center}"
	]
	quest.78B5D726803B6533.title: "The &5Marid Crusher&r"
	quest.7A273495C2A0AFB3.quest_desc: ["The Gem is typically found in Mineshaft Chests but this is a skyblock so it looks like you need to pray to the RNG gods and hope the Wandering Trader has the goods."]
	quest.7AA42EA363FD469F.title: "Storage Parts"
	quest.7ABA8D48D7131B43.title: "Totem of Undying"
	quest.7AE918F8D8583E60.quest_desc: ["Deep Shelves focus on all three stats."]
	quest.7AE918F8D8583E60.title: "Deep Shelves"
	quest.7C57E5088B415E79.quest_desc: ["Lava can be generated using a Porcelain Crucible with a heat source under it.  The most rudimentary heat source available is a torch.  It will take a while, but you can melt cobblestone into lava. "]
	quest.7CF76A542529A181.quest_desc: [
		"Used to corrupt Souls and Runes. You'll need this for later."
		""
		"If you throw down Dark Matter, then throw down Corrupti Dust, it'll create a Black Hole. Feed it small entities like Arrows or Experience Orbs, and it'll produce Xpetrified Orbs."
	]
	quest.7D74452819BE86EC.quest_desc: [
		"To upgrade the amount of stacks your magical storage can hold, you'll need to make &dStorage Stabilizers&r."
		""
		"Once made, these must point directly at the Dimensional Matrix part of your Storage Actuator, not the base. These can be up to 5 blocks away, but must have a clear line of sight to the Matrix."
		""
		"Whenever you want to upgrade to a higher tier Stabilizer, breaking it won't destroy the items inside. However, you will not be able to add any more items to your storage until it is either replaced or upgraded."
	]
	quest.7D74452819BE86EC.title: "&aUpgrading Your Magical Storage&r"
	quest.7D8C2F2E04E7D594.quest_desc: [
		"You must be level 100+ to infuse Potion Charms"
		""
		"5x Draconic Endshelf"
		"2x Echoing Deepshelf"
		"1x Melonshelf"
		"1x Endshelf"
	]
	quest.7D8C2F2E04E7D594.title: "Unbreakable Potion Charms"
	quest.7E1DDA109A14F117.title: "Nether Star"
	quest.7E29C5F67976851B.quest_desc: ["Can you master time and space and gather time crystals?"]
	quest.7E56A394108B56FD.title: "Blood Cow"
	quest.7EA01C721DFBF014.title: "Breaking and Placing"
	quest.7F7A02E0B2FD1721.title: "Tier 3 Soul - Chickens"
	quest.7FF378A6A4AC3A7E.quest_desc: ["Use a Stock Ticker as a POI and you'll summon TubeAndKnuckle, one of the greatest YouTubers of all time!"]
	quest.7FF378A6A4AC3A7E.title: "TubeAndKnuckle"
