	chapter.75FDA9480EE7777C.chapter_subtitle: ["This Questline will get you familiarized with the basics of AE2. You should be able to get basic power generation as well as a storage system started here!"]
	chapter.75FDA9480EE7777C.title: "&9 Applied Energistics 2"
	chapter_group.3DBADFFDA1FDAD84.title: "&6&lCampaign"
