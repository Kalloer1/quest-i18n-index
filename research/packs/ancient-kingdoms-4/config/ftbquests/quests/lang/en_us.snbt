{
	chapter.60DE000000000002.title: "Charting the Realm"
	chapter.60DE000000000002.chapter_subtitle: [
		"Structures, new biomes and far-off worlds — explore with &6Valhelsia Structures&r, &6Regions Unexplored&r and more."
	]
	quest.0D00000000000002.title: "Find a Village"
	quest.0D00000000000002.quest_subtitle: "Trade and shelter"
	quest.0D00000000000002.quest_desc: [
		"Track down a &6Village&r — a safe haven with villagers to trade and beds to sleep in."
		"A good early base of operations."
		"&7Protect its people from raids.&r"
	]
	quest.0D00000000000003.title: "Pillager Outpost"
	quest.0D00000000000003.quest_subtitle: "Danger and loot"
	quest.0D00000000000003.quest_desc: [
		"Scout a &6Pillager Outpost&r — guarded by pillagers but packed with loot."
		"Clear it out for supplies and an Allay."
		"&7Watch for the captain.&r"
	]
	quest.0D0000000000000C.title: "Cartographer Tower"
	quest.0D0000000000000C.quest_subtitle: "Buy the map"
	quest.0D0000000000000C.quest_desc: [
		"Find a &6Cartographer Tower&r from Moog's Voyager — a place to pick up maps that lead to other landmarks."
		"Maps here point you toward adventure."
		"&7Follow where they lead.&r"
	]
	quest.0D00000000000006.title: "Witch Hut"
	quest.0D00000000000006.quest_subtitle: "A witch's home"
	quest.0D00000000000006.quest_desc: [
		"Discover a &6Witch Hut&r out in the swamps — handy for witch drops and a spooky base."
		"One of Valhelsia's many structures."
		"&7Mind the cauldron.&r"
	]
	quest.0D00000000000004.title: "Castle Ruin"
	quest.0D00000000000004.quest_subtitle: "Fallen grandeur"
	quest.0D00000000000004.quest_desc: [
		"Explore a &6Castle Ruin&r — the crumbled remains of a once-great fortress, full of loot."
		"A taste of what a full castle holds."
		"&7Lead-in to the real thing.&r"
	]
	quest.0D00000000000005.title: "The Castle"
	quest.0D00000000000005.quest_subtitle: "A grand fortress"
	quest.0D00000000000005.quest_desc: [
		"Find an intact &6Castle&r — Valhelsia's grandest structure, richly guarded and richly rewarded."
		"The prize find for any explorer."
		"&aReward: a pick from Kingdom Loot.&r"
	]
	quest.0D00000000000007.title: "Redwood Forest"
	quest.0D00000000000007.quest_subtitle: "Towering trees"
	quest.0D00000000000007.quest_desc: [
		"Stand among the &6Redwoods&r from Regions Unexplored — colossal trees that dwarf the vanilla world."
		"Great timber and grand views."
		"&7One of many new biomes.&r"
	]
	quest.0D00000000000008.title: "The Bayou"
	quest.0D00000000000008.quest_subtitle: "Murky wetlands"
	quest.0D00000000000008.quest_desc: [
		"Wade into the &6Bayou&r — a moody wetland biome with its own flora and creatures."
		"Atmospheric and full of secrets."
		"&7Watch your step in the water.&r"
	]
	quest.0D0000000000000D.title: "Rainforest"
	quest.0D0000000000000D.quest_subtitle: "Lush and loud"
	quest.0D0000000000000D.quest_desc: [
		"Trek through a dense &6Rainforest&r — vibrant, layered, and teeming with life."
		"Regions Unexplored reshapes the whole world map."
		"&7Go find the rest yourself.&r"
	]
	quest.0D0000000000000E.title: "The Grand Cathedral"
	quest.0D0000000000000E.quest_subtitle: "Moog's Voyager Structures"
	quest.0D0000000000000E.quest_desc: [
		"A towering &6Cathedral&r from Moog's Voyager Structures — the grandest building in the wilds, stained glass and vaulted halls worth the trek."
		"&aReward: a land claim and a pick from Kingdom Loot.&r"
	]
	quest.0D0000000000000F.title: "Marble Chateau"
	quest.0D0000000000000F.quest_subtitle: "ATi Structures"
	quest.0D0000000000000F.quest_desc: [
		"A sprawling noble estate of white marble from &6ATi Structures&r, tucked into the hills. Plenty of rooms to loot."
	]
	quest.0D00000000000010.title: "Dark Tower"
	quest.0D00000000000010.quest_subtitle: "ATi Structures"
	quest.0D00000000000010.quest_desc: [
		"A brooding &6Dark Tower&r that climbs into the clouds — guarded from top to bottom, with the best loot waiting at the summit."
	]
	quest.0D00000000000011.title: "Baobab Savanna"
	quest.0D00000000000011.quest_subtitle: "Regions Unexplored"
	quest.0D00000000000011.quest_desc: [
		"Wide golden grasslands under enormous &6Baobab&r trees — a signature biome from Regions Unexplored."
	]
	quest.0D00000000000012.title: "Autumnal Maple Forest"
	quest.0D00000000000012.quest_subtitle: "Regions Unexplored"
	quest.0D00000000000012.quest_desc: [
		"A forest locked in eternal autumn, all reds and oranges under the &6Maple&r canopy."
	]
	quest.0D00000000000013.title: "Eucalyptus Forest"
	quest.0D00000000000013.quest_subtitle: "Regions Unexplored"
	quest.0D00000000000013.quest_desc: [
		"Tall pale &6Eucalyptus&r trees over soft blue-green undergrowth — a calm, airy woodland."
	]
	chapter.60DE000000000001.title: "The Armory"
	chapter.60DE000000000001.chapter_subtitle: [
		"Blades, armor and modular gear — &6Simply Swords&r, &6Immersive Armors&r and &6Silent Gear&r."
	]
	quest.0A00000000000002.title: "A Proper Blade"
	quest.0A00000000000002.quest_subtitle: "Simply Swords"
	quest.0A00000000000002.quest_desc: [
		"Forge an Iron Longsword from &6Simply Swords&r — the mod adds dozens of new weapon types beyond the vanilla sword."
		"Each weapon class handles differently — reach, speed, sweep."
		"&7Find a style that suits you.&r"
	]
	quest.0A00000000000008.title: "Rapier and Katana"
	quest.0A00000000000008.quest_subtitle: "Different steel"
	quest.0A00000000000008.quest_desc: [
		"Craft a Rapier (fast, precise) and a Katana (sweeping cuts) — two very different fighting styles."
		"Try them against a few mobs to feel the difference."
		"&7Higher tiers hit harder.&r"
	]
	quest.0A00000000000007.title: "The Netherite Claymore"
	quest.0A00000000000007.quest_subtitle: "A mighty weapon"
	quest.0A00000000000007.quest_desc: [
		"Forge a Netherite Claymore — a heavy two-hander that cleaves through crowds."
		"&aReward: a land claim and a pick from Kingdom Loot.&r"
		"&7The pride of your blade collection.&r"
	]
	quest.0A00000000000003.title: "Heavy Armor"
	quest.0A00000000000003.quest_subtitle: "Immersive Armors"
	quest.0A00000000000003.quest_desc: [
		"Craft a Heavy Chestplate from &6Immersive Armors&r — the mod adds many themed armor sets with unique looks and perks."
		"Heavier armor trades speed for protection."
		"&7Browse the sets in JEI.&r"
	]
	quest.0A00000000000004.title: "Themed Sets"
	quest.0A00000000000004.quest_subtitle: "Bone and beyond"
	quest.0A00000000000004.quest_desc: [
		"The Bone Helmet is one of many themed pieces — mix and match sets for the look and bonuses you want."
		"Some sets grant set-effects when worn together."
		"&7Dress for the occasion.&r"
	]
	quest.0A00000000000009.title: "Divine Armor"
	quest.0A00000000000009.quest_subtitle: "Top-tier protection"
	quest.0A00000000000009.quest_desc: [
		"The Divine Chestplate is among the strongest armors here — a worthy endgame set."
		"Pair it with a matching set for full effect."
		"&7Built to last.&r"
	]
	quest.0A00000000000010.title: "Blueprints"
	quest.0A00000000000010.quest_subtitle: "Silent Gear starts here"
	quest.0A00000000000010.quest_desc: [
		"Craft the &6Blueprint Book&r — &6Silent Gear&r builds tools and weapons from parts, and blueprints unlock each type."
		"Add blueprints to the book to learn new gear."
		"&eA whole modular gear system — this is the entry point.&r"
	]
	quest.0A00000000000011.title: "Gear Smithing Table"
	quest.0A00000000000011.quest_subtitle: "Assemble your gear"
	quest.0A00000000000011.quest_desc: [
		"The &6Gear Smithing Table&r is where you assemble gear from a main part, a rod, and optional tips."
		"Different materials give different stats — mix for the perfect tool."
		"&7Experiment with part combinations.&r"
	]
	quest.0A00000000000012.title: "Build Your Tools"
	quest.0A00000000000012.quest_subtitle: "Pickaxe and sword"
	quest.0A00000000000012.quest_desc: [
		"Craft a Silent Gear Pickaxe and Sword — they gain XP, level up, and can be upgraded and repaired without losing progress."
		"Add tips, coatings and grips to customize."
		"&eGear that grows with you.&r"
	]
	quest.0A00000000000013.title: "The Metal Press"
	quest.0A00000000000013.quest_subtitle: "Make parts"
	quest.0A00000000000013.quest_desc: [
		"The &6Metal Press&r presses ingots into rods, plates and other gear parts."
		"You'll need it to craft custom part combinations."
		"&7Set it up beside the smithing table.&r"
	]
	quest.0A00000000000014.title: "Alloys and Crimson Iron"
	quest.0A00000000000014.quest_subtitle: "Advanced materials"
	quest.0A00000000000014.quest_desc: [
		"The &6Alloy Forge&r blends metals into stronger alloys; &6Crimson Iron&r is a Nether metal for high-tier gear."
		"Alloys unlock the best stat combinations."
		"&7The path to endgame tools.&r"
	]
	quest.0A00000000000005.title: "Gemcraft"
	quest.0A00000000000005.quest_subtitle: "Silent Gems"
	quest.0A00000000000005.quest_desc: [
		"&6Silent Gems&r adds Rubies, Sapphires, Topaz and more — colorful gems used for decorative blocks, lamps and glass."
		"They also pair naturally with Silent Gear for themed builds."
		"&7Mine them deep underground.&r"
	]
	chapter.378B07B3885291AA.title: "The Depths Below"
	chapter.378B07B3885291AA.chapter_subtitle: [
		"Open a portal to the sunless caverns of the &2Undergarden&r — new stone, metals, monsters and a boss."
	]
	quest.4B00000000000001.title: "The Catalyst"
	quest.4B00000000000001.quest_subtitle: "Key to the deep"
	quest.4B00000000000001.quest_desc: [
		"Craft the &2Catalyst&r — the item that opens a portal to the Undergarden."
		"You'll build the portal frame and activate it with this."
		"&7The doorway down.&r"
	]
	quest.4B00000000000002.title: "Enter the Undergarden"
	quest.4B00000000000002.quest_subtitle: "A sunless world"
	quest.4B00000000000002.quest_desc: [
		"Build a portal frame from &2Depthrock Bricks&r (or any stone-brick block), then right-click the inner base with your Catalyst to open the way into the &2Undergarden&r."
		"It's a vast, dark cavern dimension — no sky, no sun."
		"&eBring light and food.&r"
	]
	quest.4B00000000000003.title: "Mine Depthrock"
	quest.4B00000000000003.quest_subtitle: "The local stone"
	quest.4B00000000000003.quest_desc: [
		"&2Depthrock&r is the Undergarden's basic stone — gather a stack for tools and building down here."
		"It's everywhere, like overworld cobble."
		"&7Your first resource.&r"
	]
	quest.4B00000000000004.title: "Shard Torches"
	quest.4B00000000000004.quest_subtitle: "Light the dark"
	quest.4B00000000000004.quest_desc: [
		"Craft &2Shard Torches&r from &2Utheric Shards&r (mined from Utherium ore) — they ward off the &2Rotspawn&r that spawn in the dark."
		"Keep them around your base and paths to hold the horde back."
		"&7Carry a stack.&r"
	]
	quest.4B00000000000006.title: "Cloggrum"
	quest.4B00000000000006.quest_subtitle: "The first metal"
	quest.4B00000000000006.quest_desc: [
		"Smelt &2Cloggrum&r — the Undergarden's iron-tier metal for tools and armor."
		"Found as ore throughout the caverns."
		"&7Your starting kit down here.&r"
	]
	quest.4B00000000000007.title: "Froststeel"
	quest.4B00000000000007.quest_subtitle: "The cold metal"
	quest.4B00000000000007.quest_desc: [
		"&2Froststeel&r is a colder, tougher metal for better gear."
		"A step up from cloggrum."
		"&7Mine deeper to find it.&r"
	]
	quest.4B00000000000008.title: "Utherium"
	quest.4B00000000000008.quest_subtitle: "The healing crystal"
	quest.4B00000000000008.quest_desc: [
		"&2Utherium&r crystals hold restorative power — prized for the best gear and trinkets."
		"Rare and worth the hunt."
		"&7The Undergarden's treasure.&r"
	]
	quest.4B0000000000000C.title: "Cloggrum Gear"
	quest.4B0000000000000C.quest_subtitle: "Sword and shield"
	quest.4B0000000000000C.quest_desc: [
		"Forge a Cloggrum Sword and Cloggrum Shield — solid gear for the dangers below."
		"Cloggrum outclasses iron, and the shield is sturdier than the vanilla one."
		"&7Gear up before exploring.&r"
	]
	quest.4B0000000000000B.title: "The Slingshot"
	quest.4B0000000000000B.quest_subtitle: "Ranged goo"
	quest.4B0000000000000B.quest_desc: [
		"The &2Slingshot&r fires &2Goo Balls&r and &2Gronglets&r — handy ranged pokes at Undergarden mobs."
		"Cheap and fun."
		"&7Keep your distance from brutes.&r"
	]
	quest.4B00000000000005.title: "Undergarden Crops"
	quest.4B00000000000005.quest_subtitle: "Strange food"
	quest.4B00000000000005.quest_desc: [
		"Gather &2Gloomgourds&r, &2Underbeans&r and &2Blisterberries&r — the food that keeps you going down here."
		"Blisterberries heal but burn — use with care."
		"&7Farm them for long expeditions.&r"
	]
	quest.4B0000000000000D.title: "Depleted Mine"
	quest.4B0000000000000D.quest_subtitle: "Old workings"
	quest.4B0000000000000D.quest_desc: [
		"Explore a &2Depleted Mine&r — abandoned tunnels with ore and loot."
		"A good early landmark to raid."
		"&7Watch for ambushes.&r"
	]
	quest.4B0000000000000E.title: "Denizen Camp"
	quest.4B0000000000000E.quest_subtitle: "Locals' den"
	quest.4B0000000000000E.quest_desc: [
		"Find a &2Denizen Camp&r, home to the Undergarden's inhabitants."
		"Loot it — carefully."
		"&7They don't take kindly to visitors.&r"
	]
	quest.4B00000000000009.title: "The Catacombs"
	quest.4B00000000000009.quest_subtitle: "The boss lair"
	quest.4B00000000000009.quest_desc: [
		"Locate the &2Catacombs&r — a dungeon hiding the Undergarden's guardian and its best loot."
		"This is where the boss waits."
		"&eCome prepared for a fight.&r"
	]
	quest.4B0000000000000F.title: "Undergarden Beasts"
	quest.4B0000000000000F.quest_subtitle: "Brutes and rotbeasts"
	quest.4B0000000000000F.quest_desc: [
		"Cut down &2Brutes&r and a &2Rotbeast&r — the tough hostiles that roam the caverns."
		"Brutes hit like a truck; keep moving."
		"&7Proof you can survive down here.&r"
	]
	quest.4B0000000000000A.title: "The Forgotten Guardian"
	quest.4B0000000000000A.quest_subtitle: "Slay the boss"
	quest.4B0000000000000A.quest_desc: [
		"Face the &2Forgotten Guardian&r in the Catacombs — the Undergarden's mighty boss."
		"&aReward: a land claim and a pick from Kingdom Loot.&r"
		"&7Defeat it to conquer the depths.&r"
	]
	chapter.131E14E9D091F1A7.title: "The Forbidden Arts"
	chapter.131E14E9D091F1A7.chapter_subtitle: [
		"Arcane crystals, blessed gold, dark matter and dragon-plate — the alchemy of &6Forbidden Arcanus&r."
	]
	quest.4A00000000000001.title: "Arcane Crystals"
	quest.4A00000000000001.quest_subtitle: "Mine the magic"
	quest.4A00000000000001.quest_desc: [
		"Mine &6Arcane Crystals&r — the glowing gems that power almost everything in Forbidden Arcanus."
		"Found deep underground."
		"&7Grab a good handful to start.&r"
	]
	quest.4A00000000000002.title: "Arcane Crystal Dust"
	quest.4A00000000000002.quest_subtitle: "Grind them down"
	quest.4A00000000000002.quest_desc: [
		"Grind Arcane Crystals into Dust — the refined form used in most recipes."
		"A base reagent you'll always want stocked."
		"&7Keep grinding as you go.&r"
	]
	quest.4A00000000000003.title: "Mundabitur Dust"
	quest.4A00000000000003.quest_subtitle: "The cleansing dust"
	quest.4A00000000000003.quest_desc: [
		"Craft &6Mundabitur Dust&r — sprinkled to prepare and cleanse blocks for rituals and transformations."
		"Needed to activate the Hephaestus Forge."
		"&7A key ritual reagent.&r"
	]
	quest.4A00000000000008.title: "The Hephaestus Forge"
	quest.4A00000000000008.quest_subtitle: "Built, not crafted"
	quest.4A00000000000008.quest_desc: [
		"The &6Hephaestus Forge&r is the ritual altar at the heart of Forbidden Arcanus. There is no recipe for it — you lay the structure out and wake it up."
		""
		"&eMaterials:&r 45 Polished Darkstone, 9 Gilded Chiseled Polished Darkstone, 4 Chiseled Arcane Polished Darkstone, one Smithing Table and one Mundabitur Dust."
		""
		"&eThe shape:&r put a Gilded Chiseled block down as the centre. Touch its four sides with the Chiseled Arcane blocks. Fill the ring around those with Polished Darkstone. Then space the remaining eight Gilded Chiseled blocks around the outer edge — those eight are your pedestal spots later."
		""
		"Set the Smithing Table on the centre block, keep the space above it clear, then sneak and right-click the table with &6Mundabitur Dust&r. Lightning strikes and the table becomes the forge."
		""
		"&7Mining the finished forge drops it back as an item, so this quest ticks the moment it is in your hand. Put it straight back down where it stood.&r"
	]
	quest.4A00000000000005.title: "Deorum"
	quest.4A00000000000005.quest_subtitle: "Blessed gold"
	quest.4A00000000000005.quest_desc: [
		"Craft &6Deorum&r, a blessed golden metal far tougher than ordinary gold."
		"Combine a gold ingot with arcane crystal dust, mundabitur dust and charcoal at a crafting table."
		"&7The base for high-tier tools and blocks.&r"
	]
	quest.4A00000000000009.title: "The Clibano"
	quest.4A00000000000009.quest_subtitle: "Fast smelting"
	quest.4A00000000000009.quest_desc: [
		"Build a Clibano furnace and craft its Core — it smelts far faster and hotter than a normal furnace."
		"A big upgrade for processing ores."
		"&7Keep it fueled.&r"
	]
	quest.4A0000000000000D.title: "Quantum Catcher"
	quest.4A0000000000000D.quest_subtitle: "Bottle a creature"
	quest.4A0000000000000D.quest_desc: [
		"The Quantum Catcher captures a living creature into a bottle you can carry and release."
		"Handy for moving mobs or building farms."
		"&7Right-click a mob to catch it.&r"
	]
	quest.4A00000000000004.title: "Dark Matter"
	quest.4A00000000000004.quest_subtitle: "Forbidden material"
	quest.4A00000000000004.quest_desc: [
		"Make &6Dark Matter&r by smelting an &6Edelwood Log&r in a furnace."
		"A dense, powerful crafting component."
		"&7Used in the darkest recipes.&r"
	]
	quest.4A00000000000006.title: "Edelwood"
	quest.4A00000000000006.quest_subtitle: "The dark tree"
	quest.4A00000000000006.quest_desc: [
		"Grow &6Edelwood&r trees — their dark logs are carved into jars, pipes and tools."
		"A renewable source of aureal-holding wood."
		"&7Plant a small grove.&r"
	]
	quest.4A0000000000000C.title: "Utrem Jar"
	quest.4A0000000000000C.quest_subtitle: "Bottle the magic fluids"
	quest.4A0000000000000C.quest_desc: [
		"The Utrem Jar (glass and edelwood planks) stores xpetrified and other magical fluids."
		"Keeps your ritual fluids on tap."
		"&7Make a few for your forge area.&r"
	]
	quest.4A0000000000000A.title: "Obsidian Skull"
	quest.4A0000000000000A.quest_subtitle: "An aureal relic block"
	quest.4A0000000000000A.quest_desc: [
		"Craft the &6Obsidian Skull&r — a skeleton skull encased in &6Obsidiansteel&r."
		""
		"Obsidiansteel is alloyed in the Clibano from raw iron and obsidian, but only once an &6Artisan Relic&r is slotted into the Clibano as an enhancer. Artisan Relics turn up in village armorer, toolsmith and weaponsmith chests, so raid a few villages if you have not found one."
		""
		"The skull is a placeable block tied to Aureal, and ages through cracked, fragmented, fading and eternal variants over time."
		"&7Set it up near your ritual area.&r"
	]
	quest.4A0000000000000B.title: "Stellarite"
	quest.4A0000000000000B.quest_subtitle: "Star-stone, buried deep"
	quest.4A0000000000000B.quest_desc: [
		"Mine &6Stellarite&r from &6Stella Arcanum&r ore, found deep underground — a fallen-star material for the highest-tier crafts."
		"&7Feeds the Tier 4 forge upgrade and the Boss Catcher, if you push Forbidden Arcanus that far.&r"
	]
	quest.4A0000000000000E.title: "The Blacksmith's Gavel"
	quest.4A0000000000000E.quest_subtitle: "What starts a ritual"
	quest.4A0000000000000E.quest_desc: [
		"A finished forge does nothing on its own. Rituals are started by right-clicking the forge with a &6Blacksmith Gavel&r."
		""
		"The head is shaped from clay, then hafted onto sticks and ingots. Gavels come in the usual material tiers and any of them will fire a ritual — the better ones simply last longer."
	]
	quest.4A0000000000000F.title: "Ritual Pedestals"
	quest.4A0000000000000F.quest_subtitle: "Where the offerings sit"
	quest.4A0000000000000F.quest_desc: [
		"&6Darkstone Pedestals&r hold the items a ritual consumes. They go on the eight Gilded Chiseled blocks ringing the forge."
		""
		"The main ingredient goes inside the forge itself; everything else sits on the pedestals. Most rituals only use six of the eight spots, so six is enough to begin."
	]
	quest.4A00000000000010.title: "Feeding the Forge"
	quest.4A00000000000010.quest_subtitle: "Four kinds of essence"
	quest.4A00000000000010.quest_desc: [
		"Every ritual burns essence, and the forge tracks four bars — &6Aureal&r, &6Blood&r, &6Souls&r and &6Experience&r. You fill them through the slots down the side of the forge screen."
		""
		"&eAureal&r — Aureal Bottles, eight Arcane Crystal Dust around a Potion of Regeneration II."
		"&eBlood&r — hurt mobs standing next to the forge and it drinks directly, or hold a &6Test Tube&r in your off-hand to bottle blood and carry it back."
		"&eSouls&r — a &6Soul Extractor&r used on Soul Sand, or the Lost Souls that drift about at night."
		"&eExperience&r — Bottles o' Enchanting, or drop enchanted tools in to burn their enchantments off for essence."
		""
		"&7Rituals will not start until every bar covers the cost.&r"
	]
	quest.4A00000000000011.title: "A Greater Forge"
	quest.4A00000000000011.quest_subtitle: "Tier two"
	quest.4A00000000000011.quest_desc: [
		"The forge starts at &6Tier 1&r. Higher tiers hold more essence and unlock deeper rituals — and the armour at the end of this chapter needs &6Tier 2&r."
		""
		"Run the upgrade on the forge itself: &6Edelwood Planks&r as the main ingredient, with 4 Arcane Crystal and 4 &6Spawner Scrap&r on the pedestals. Spawner Scrap comes from breaking monster spawners."
		""
		"&7Mine the upgraded forge once to tick this off, then set it back down.&r"
	]
	quest.4A00000000000007.title: "Draco Arcanus"
	quest.4A00000000000007.quest_subtitle: "Master of the arts"
	quest.4A00000000000007.quest_desc: [
		"&6Draco Arcanus&r is the finest plate Forbidden Arcanus can make — netherite armour rebuilt on a Tier 2 forge."
		""
		"For the chestplate: a &6Netherite Chestplate&r as the main ingredient, with 4 &6Dragon Scales&r and 3 &6Obsidiansteel Ingots&r on the pedestals. Scales drop from dragons and turn up in loot; obsidiansteel comes out of the Clibano."
		""
		"It is a costly ritual — bank your aureal before you start it."
		"&aReward: a land claim and a pick from Kingdom Loot.&r"
		"&eForge the chestplate to finish The Forbidden Arts.&r"
	]
	task.6A00000000000008.title: "Build a Hephaestus Forge"
	task.6A00000000000013.title: "Upgrade the Forge to Tier 2"
	chapter.564E30088D7581A6.title: "The Art of Summoning"
	chapter.564E30088D7581A6.chapter_subtitle: [
		"Bind otherworldly spirits to your service — the rituals of &5Occultism&r."
	]
	quest.1F00000000000001.title: "Dictionary of Spirits"
	quest.1F00000000000001.quest_subtitle: "Your Occultism guide"
	quest.1F00000000000001.quest_desc: [
		"Craft the &5Dictionary of Spirits&r — right-click to open and read it; it names every spirit and explains every ritual."
		"Later you also craft it together with a Book of Binding to inscribe a spirit's name into the book."
		"&7The start of the occult path.&r"
	]
	quest.1F00000000000003.title: "Chalk and Brush"
	quest.1F00000000000003.quest_subtitle: "Draw ritual circles"
	quest.1F00000000000003.quest_desc: [
		"Craft White Chalk and a Brush to draw the ritual circles that summonings are performed inside."
		"Each ritual has a specific chalk pattern — check the dictionary."
		"&7Draw on a clean floor.&r"
	]
	quest.1F00000000000004.title: "Sacrificial Bowls"
	quest.1F00000000000004.quest_subtitle: "Hold your offerings"
	quest.1F00000000000004.quest_desc: [
		"Place Sacrificial Bowls (and a Golden one at the center) around a ritual circle to hold ingredients."
		"The ritual consumes what's in the bowls."
		"&7You'll want several.&r"
	]
	quest.1F0000000000000D.title: "Colored Chalks"
	quest.1F0000000000000D.quest_subtitle: "Advanced circles"
	quest.1F0000000000000D.quest_desc: [
		"Yellow, Purple and Red chalks unlock the more advanced ritual circles."
		"Higher-tier spirits need fancier patterns."
		"&7Craft them as you climb the tiers.&r"
	]
	quest.1F00000000000005.title: "Bind a Foliot"
	quest.1F00000000000005.quest_subtitle: "Your first spirit"
	quest.1F00000000000005.quest_desc: [
		"Perform a ritual with a &5Book of Binding: Foliot&r to summon and bind your first, weakest spirit."
		"Foliots handle the simplest tasks and crafts."
		"&eThis is where summoning really begins.&r"
	]
	quest.1F0000000000000A.title: "Bind a Djinni"
	quest.1F0000000000000A.quest_subtitle: "A stronger spirit"
	quest.1F0000000000000A.quest_desc: [
		"The Djinni is a step up — bind one to unlock better crafts and services."
		"Needs a fancier circle than the Foliot."
		"&7Tier 2 of four.&r"
	]
	quest.1F0000000000000B.title: "Bind an Afrit"
	quest.1F0000000000000B.quest_subtitle: "Fire spirit"
	quest.1F0000000000000B.quest_desc: [
		"Afrits are powerful fire spirits used for high-tier rituals and crafting."
		"Getting close to the top now."
		"&7Tier 3 of four.&r"
	]
	quest.1F0000000000000C.title: "Bind a Marid"
	quest.1F0000000000000C.quest_subtitle: "The greatest spirit"
	quest.1F0000000000000C.quest_desc: [
		"The Marid is the strongest spirit in Occultism — binding one unlocks the pinnacle rituals."
		"A serious undertaking with a serious payoff."
		"&eTier 4 — the top of the ladder.&r"
	]
	quest.1F00000000000011.title: "The Miner Spirit"
	quest.1F00000000000011.quest_subtitle: "Automated resources"
	quest.1F00000000000011.quest_desc: [
		"Bind a miner spirit into a &5Magic Lamp&r and it will dig up ores and blocks from other dimensions for you."
		"A key source of passive resources."
		"&7Feed it and let it work.&r"
	]
	quest.1F00000000000014.title: "Binding a Marid"
	quest.1F00000000000014.quest_subtitle: "The greatest demon, bound to your service"
	quest.1F00000000000014.quest_desc: [
		"The &dMarid&r is the highest tier of demon in Occultism, summoned only after the lesser Foliot, Djinni and Afrit."
		"Run the Marid binding ritual to earn a &dBound Book of Binding (Marid)&r, the pact that lets you call one to your service."
		"&eObtain a Bound Book of Binding (Marid) to finish The Art of Summoning.&r"
	]
	task.3F0000000000001A.title: "Bind a Marid"
	quest.1F00000000000012.title: "Familiars"
	quest.1F00000000000012.quest_subtitle: "Summon a companion"
	quest.1F00000000000012.quest_desc: [
		"The Familiar Ring binds a small familiar that follows you and grants passive perks."
		"Different familiars give different buffs."
		"&7Collect a few and swap them.&r"
	]
	quest.1F00000000000013.title: "Dimensional Storage"
	quest.1F00000000000013.quest_subtitle: "Bottomless space"
	quest.1F00000000000013.quest_desc: [
		"Build a Storage Controller and Dimensional Matrix to stash near-infinite items in a pocket dimension."
		"A spirit holds it all for you."
		"&eThe occult answer to storage.&r"
	]
	quest.1F00000000000006.title: "The Divination Rod"
	quest.1F00000000000006.quest_subtitle: "Find anything"
	quest.1F00000000000006.quest_desc: [
		"Craft the &5Divination Rod&r — tune it to a block and it points you to the nearest one underground."
		"Essential for finding otherstone and ores."
		"&7Your first real tool here.&r"
	]
	quest.1F00000000000007.title: "The Otherworld"
	quest.1F00000000000007.quest_subtitle: "See the unseen"
	quest.1F00000000000007.quest_desc: [
		"Grow an Otherworld Tree and craft Otherworld Goggles to see hidden otherworld blocks with your Third Eye."
		"Some resources only appear while you're looking through the veil."
		"&7Wear the goggles and open your Third Eye.&r"
	]
	quest.1F00000000000002.title: "Demon's Dream"
	quest.1F00000000000002.quest_subtitle: "The occult crop"
	quest.1F00000000000002.quest_desc: [
		"Find &5Demon's Dream Seeds&r by breaking grass, then grow the &5Datura&r plant from them."
		"Its leaves are a core reagent for Occultism's rituals and the third-eye brew."
		"&7Cheap and useful — plant a patch early.&r"
	]
	quest.1F00000000000008.title: "Silver"
	quest.1F00000000000008.quest_subtitle: "The occult metal"
	quest.1F00000000000008.quest_desc: [
		"Mine and smelt &5Silver&r — the base metal for Occultism's tools and rituals."
		"Found underground like other ores."
		"&7Keep a stack handy.&r"
	]
	quest.1F0000000000000F.title: "Infused Pickaxe"
	quest.1F0000000000000F.quest_subtitle: "Silver tools"
	quest.1F0000000000000F.quest_desc: [
		"The Infused Pickaxe is a silver tool that can be recharged with spirit energy."
		"A handy upgrade over vanilla iron."
		"&7Keep it topped up.&r"
	]
	quest.1F00000000000009.title: "Iesnium"
	quest.1F00000000000009.quest_subtitle: "Nether metal"
	quest.1F00000000000009.quest_desc: [
		"&5Iesnium&r is a rare metal from the Nether, mined with the help of your spirits."
		"The strongest occult material."
		"&7Bring fire protection.&r"
	]
	quest.1F00000000000010.title: "Iesnium Pickaxe"
	quest.1F00000000000010.quest_subtitle: "Top-tier tool"
	quest.1F00000000000010.quest_desc: [
		"The Iesnium Pickaxe is the best occult mining tool — fast, durable, and spirit-charged."
		"The reward for reaching the Nether metals."
		"&7Endgame digging.&r"
	]
	chapter.3108386352D52F8B.title: "The Spirit Arts"
	chapter.3108386352D52F8B.chapter_subtitle: [
		"Harvest souls and forge them into power — the arcana of &bMalum&r."
	]
	quest.1E00000000000001.title: "Encyclopedia Arcana"
	quest.1E00000000000001.quest_subtitle: "Your Malum handbook"
	quest.1E00000000000001.quest_desc: [
		"Craft the &bEncyclopedia Arcana&r — it explains spirits, affinities, and every recipe in Malum."
		""
		"It takes a plain Book and a piece of &bRefined Soulstone&r, so go mine Soulstone first — it sits in the same depths as iron. Smelting the raw stone gives you the refined kind."
		"&7Your guide to the whole art. Read the entries as you unlock new materials.&r"
	]
	quest.1E00000000000002.title: "Grow Runewood"
	quest.1E00000000000002.quest_subtitle: "The arcane tree"
	quest.1E00000000000002.quest_desc: [
		"Plant a Runewood Sapling and grow the arcane tree that most Malum blocks are built from."
		"Runewood is your primary crafting wood here."
		"&7Grow a small grove early.&r"
	]
	quest.1E00000000000003.title: "Mine Soulstone"
	quest.1E00000000000003.quest_subtitle: "Fuel for spirits"
	quest.1E00000000000003.quest_desc: [
		"Dig up &bSoulstone Ore&r — the stone that holds and channels spirits."
		"You'll need a steady supply for altars and reagents."
		"&7Found underground like any ore.&r"
	]
	quest.1E00000000000004.title: "Blazing Quartz"
	quest.1E00000000000004.quest_subtitle: "Fiery reagent"
	quest.1E00000000000004.quest_desc: [
		"Gather &bBlazing Quartz&r, a hot reagent used in fire-aligned recipes and refining."
		"Pairs with soulstone in many crafts."
		"&7Stock up a stack.&r"
	]
	quest.1E00000000000005.title: "The Crude Scythe"
	quest.1E00000000000005.quest_subtitle: "Harvest souls"
	quest.1E00000000000005.quest_desc: [
		"Craft a &bScythe&r and kill mobs with it to shatter their souls into spirit shards."
		"Different mobs drop different spirit affinities."
		"&eThe core loop of Malum — reap souls to power everything.&r"
	]
	quest.1E00000000000006.title: "Spirit Jar"
	quest.1E00000000000006.quest_subtitle: "Store your spirits"
	quest.1E00000000000006.quest_desc: [
		"The Spirit Jar collects and stores loose spirit shards automatically nearby."
		"Set one by your altar so nothing goes to waste."
		"&7Keeps your harvest tidy.&r"
	]
	quest.1E00000000000007.title: "The Spirit Altar"
	quest.1E00000000000007.quest_subtitle: "Your crafting heart"
	quest.1E00000000000007.quest_desc: [
		"Build the &bSpirit Altar&r — place items on it and feed spirits in to craft Malum's reagents and gear."
		"Surround it with pedestals to add ingredients."
		"&eEverything advanced runs through this altar.&r"
	]
	quest.1E00000000000008.title: "Charcoal and Ash"
	quest.1E00000000000008.quest_subtitle: "Base reagents"
	quest.1E00000000000008.quest_desc: [
		"&bArcane Charcoal&r and &bHex Ash&r are the first reagents you'll refine at the altar."
		"They feed into higher-tier materials."
		"&7Keep a supply on hand.&r"
	]
	quest.1E00000000000010.title: "Auric Embers"
	quest.1E00000000000010.quest_subtitle: "Golden fuel"
	quest.1E00000000000010.quest_desc: [
		"&bAuric Embers&r are a refined, gold-touched fuel for the strongest crafts."
		"Made by combining earlier reagents at the altar."
		"&7A mid-tier milestone.&r"
	]
	quest.1E00000000000009.title: "Soul Stained Steel"
	quest.1E00000000000009.quest_subtitle: "The signature metal"
	quest.1E00000000000009.quest_desc: [
		"Forge &bSoul Stained Steel&r — Malum's signature metal, made by binding spirits into iron."
		"The base for all its tools, weapons and armor."
		"&eSave up spirits before a big smelt.&r"
	]
	quest.1E0000000000000A.title: "Soulforged Weapons"
	quest.1E0000000000000A.quest_subtitle: "Sword and scythe"
	quest.1E0000000000000A.quest_desc: [
		"Craft the Soul Stained Steel Sword and Scythe — solid weapons forged from spirit-infused steel."
		"The scythe harvests souls from the mobs it kills, feeding your spirit supply as you fight."
		"&7Add runes for more.&r"
	]
	quest.1E0000000000000B.title: "The Runic Workbench"
	quest.1E0000000000000B.quest_subtitle: "Cut your own runes"
	quest.1E0000000000000B.quest_desc: [
		"Build the &bRunic Workbench&r to inscribe runes onto slates — Malum's enchant-like system."
		"You don't apply runes to gear; you wear them on yourself with a &bRunic Brooch&r, one rune per hand, for passive buffs."
		"&7Mix and match for a build that suits you.&r"
	]
	quest.1E0000000000000F.title: "Alchemical Impetus"
	quest.1E0000000000000F.quest_subtitle: "Heart of the crucible"
	quest.1E0000000000000F.quest_desc: [
		"The &bAlchemical Impetus&r is the catalyst at the centre of the &bSpirit Crucible&r — it focuses raw spirits into refined, more powerful forms."
		"Push it too hard and the catalyst takes damage, so mind your rituals."
		"&7For the dedicated spirit-smith.&r"
	]
	quest.1E0000000000000E.title: "Twisted Reagents"
	quest.1E0000000000000E.quest_subtitle: "Dark materials"
	quest.1E0000000000000E.quest_desc: [
		"Gather &bTwisted Rock&r and &bGrim Talc&r — corrupted materials for the darkest, most powerful recipes."
		"Found in twisted, spirit-heavy places."
		"&7Handle the corruption carefully.&r"
	]
	quest.1E0000000000000C.title: "The Weeping Well"
	quest.1E0000000000000C.quest_subtitle: "Open the way to the Void"
	quest.1E0000000000000C.quest_desc: [
		"Assemble the &bWeeping Well&r — a ritual well of primordial soup that tears open a path to the &8Void&r, the deepest layer of Malum's spirit arts and the source of its darkest materials."
		"&aReward: a land claim and a pick from the Kingdom Loot.&r"
	]
	chapter.0CD78EB2BA047964.title: "The Witch's Brew"
	chapter.0CD78EB2BA047964.chapter_subtitle: [
		"Herbs, candles, cauldrons and broomsticks — the witchcraft of &dHexerei&r."
	]
	quest.1D00000000000001.title: "The Book of Shadows"
	quest.1D00000000000001.quest_subtitle: "Your witch's handbook"
	quest.1D00000000000001.quest_desc: [
		"Craft the &dBook of Shadows&r — it holds every Hexerei recipe and walks you through the craft."
		""
		"You need leather, a book, tallow and a &dSage Seed&r. Sage grows wild in grassy places, so break a few plants before you sit down to craft."
		"&7Keep it on hand; most items here show their recipe inside.&r"
	]
	quest.1D00000000000012.title: "Book of Shadows Altar"
	quest.1D00000000000012.quest_subtitle: "A place to study"
	quest.1D00000000000012.quest_desc: [
		"Place your Book of Shadows on an Altar to display it and anchor your workspace."
		"Set up your brewing area around it."
		"&7A tidy home for your craft.&r"
	]
	quest.1D00000000000002.title: "Pestle and Mortar"
	quest.1D00000000000002.quest_subtitle: "Grind your ingredients"
	quest.1D00000000000002.quest_desc: [
		"The Pestle and Mortar grinds herbs, petals and materials into powders and dusts."
		"Many recipes need ground ingredients — this is your first tool."
		"&7Cheap and essential.&r"
	]
	quest.1D00000000000007.title: "Herb Storage"
	quest.1D00000000000007.quest_subtitle: "Jars and coffers"
	quest.1D00000000000007.quest_desc: [
		"Herb Jars and Coffers keep your growing collection of reagents sorted."
		"Quick access makes brewing faster."
		"&7Coffers hold general items; jars specialize in herbs.&r"
	]
	quest.1D00000000000003.title: "Grow Sage"
	quest.1D00000000000003.quest_subtitle: "From seed to dried"
	quest.1D00000000000003.quest_desc: [
		"Plant &dSage Seeds&r, harvest the leaves, then dry them into &dDried Sage&r."
		"Dried herbs are the backbone of most brews and rituals."
		"Grow a steady supply."
	]
	quest.1D00000000000011.title: "Sage Burning Plate"
	quest.1D00000000000011.quest_subtitle: "Smoke and cleansing"
	quest.1D00000000000011.quest_desc: [
		"Burn dried sage on a Burning Plate to release cleansing smoke and ritual effects."
		"Used to purify areas and power certain rites."
		"&7Light it near your workspace.&r"
	]
	quest.1D0000000000000B.title: "Candle Dipper"
	quest.1D0000000000000B.quest_subtitle: "Make your own candles"
	quest.1D0000000000000B.quest_desc: [
		"The Candle Dipper turns wax and string into candles."
		"Candles light rituals and mark ceremonial spaces."
		"&7Craft a batch in advance.&r"
	]
	quest.1D00000000000004.title: "Candles"
	quest.1D00000000000004.quest_subtitle: "Ritual light"
	quest.1D00000000000004.quest_desc: [
		"Candles are placed to set up rituals and dress a coven."
		"Color and arrangement matter for some rites."
		"&7Simple, but needed.&r"
	]
	quest.1D00000000000005.title: "The Mixing Cauldron"
	quest.1D00000000000005.quest_subtitle: "Where brews are made"
	quest.1D00000000000005.quest_desc: [
		"The &dMixing Cauldron&r is the heart of Hexerei. Fill it with water, light a fire beneath, and drop in ingredients to brew."
		"Watch the water change color as a brew comes together."
		"&eYour main crafting station from here on.&r"
	]
	quest.1D00000000000006.title: "Blood Bottle"
	quest.1D00000000000006.quest_subtitle: "Bottle the blood"
	quest.1D00000000000006.quest_desc: [
		"Bottle the blood collected in your Mixing Cauldron with the Blood Sigil."
		"Blood is a key ingredient in Hexerei recipes — most importantly, the flying brooms."
		"&7Handle with care.&r"
	]
	quest.1D0000000000000A.title: "Blood Sigil"
	quest.1D0000000000000A.quest_subtitle: "Draw blood at the cauldron"
	quest.1D0000000000000A.quest_desc: [
		"The Blood Sigil is a &6Mixing Cauldron&r attachment. With it active, mobs (or you) that jump into the filled cauldron give up their blood into it."
		"Three dips is enough blood to fill one Blood Bottle."
		"&7Potent, but not for the squeamish.&r"
	]
	quest.1D00000000000009.title: "Selenite and Moonlight"
	quest.1D00000000000009.quest_subtitle: "Lunar reagents"
	quest.1D00000000000009.quest_desc: [
		"Selenite Shards are mined from geodes under jungles and swamps; Moon Dust is brewed in your cauldron from redstone and glowstone."
		"Both feed the most powerful brews."
		"&7The good stuff for high-tier magic.&r"
	]
	quest.1D00000000000008.title: "Your First Broomstick"
	quest.1D00000000000008.quest_subtitle: "Take to the sky"
	quest.1D00000000000008.quest_desc: [
		"Craft a Willow Broom — it comes ready to fly. Right-click to mount and soar."
		"Its broom brush wears out with use, so keep spares (brew a wet brush in the cauldron, then dry it on a drying rack)."
		"&eThe classic witch's ride.&r"
	]
	quest.1D0000000000000C.title: "Better Brooms"
	quest.1D0000000000000C.quest_subtitle: "Upgrade and park them"
	quest.1D0000000000000C.quest_desc: [
		"The Mahogany Broom flies faster and handles better than willow."
		"Build a Broom Stand to park and display your brooms."
		"&7Trade up as you progress.&r"
	]
	quest.1D0000000000000D.title: "Crow Familiar"
	quest.1D0000000000000D.quest_subtitle: "Call a crow"
	quest.1D0000000000000D.quest_desc: [
		"The Crow Flute calls and commands a crow familiar to follow and help you."
		"Familiars fetch items and keep you company."
		"&7Bond with your bird.&r"
	]
	quest.1D0000000000000E.title: "Owl Post Office"
	quest.1D0000000000000E.quest_subtitle: "Find the roost"
	quest.1D0000000000000E.quest_desc: [
		"Seek out an Owl Post Office in the world — its owls can deliver items across distances."
		"A handy find for the well-connected witch."
		"&7Explore to locate one.&r"
	]
	quest.1D0000000000000F.title: "Find a Coven"
	quest.1D0000000000000F.quest_subtitle: "Nature and Dark"
	quest.1D0000000000000F.quest_desc: [
		"Hunt down the &dNature Coven&r and &dDark Coven&r — hidden witch settlements with loot and lore."
		"Each leans to a different path of the craft."
		"Visit both."
	]
	quest.1D00000000000010.title: "The Baba Yaga Hut"
	quest.1D00000000000010.quest_subtitle: "The walking hut"
	quest.1D00000000000010.quest_desc: [
		"Track down the legendary Baba Yaga Hut, the rarest structure in Hexerei."
		"Its treasures reward the most dedicated witches."
		"&eA true endgame find.&r"
	]
	quest.1D00000000000013.title: "The Witch's Regalia"
	quest.1D00000000000013.quest_subtitle: "Signature garb and a familiar of your own"
	quest.1D00000000000013.quest_desc: [
		"The &5Mushroom Witch Hat&r is the signature garb of a practicing witch, sewn from the herbs and cloth you have gathered."
		"Bind a familiar with a &5Crow Ankh Amulet&r — a crow companion tied to you through the craft."
		"&eCraft the Mushroom Witch Hat and a Crow Ankh Amulet to finish The Witch's Brew.&r"
	]
	task.3D0000000000001B.title: "Craft a Mushroom Witch Hat"
	task.3D0000000000001C.title: "Bind a Crow Ankh Amulet"
	chapter.70DE000000000001.title: "Tools of the Trade"
	chapter.70DE000000000001.chapter_subtitle: [
		"Handy mods that make building, decorating, and everyday play smoother — helpful tools worth knowing about."
	]
	quest.7A00000000000021.title: "Chisels and Variants"
	quest.7A00000000000021.quest_subtitle: "Rechiseled and Chipped"
	quest.7A00000000000021.quest_desc: [
		"Craft a &6Chisel&r to turn ordinary blocks into dozens of clean decorative variants — pillars, panels, patterns and more."
		"Right-click with the chisel to open its menu, then pick the variant you want."
		"&7Rechiseled and Chipped together cover most vanilla and modded blocks.&r"
	]
	quest.7A00000000000022.title: "Chipped"
	quest.7A00000000000022.quest_subtitle: "Thousands of block variants"
	quest.7A00000000000022.quest_desc: [
		"&6Chipped&r adds crafting benches (like the Carpenter's Table) that open a huge catalog of decorative variants for wood, stone and more."
		"Drop in a block and pick from hundreds of styles."
		"&7The fastest way to add detail to a build.&r"
	]
	quest.7A00000000000023.title: "FramedBlocks"
	quest.7A00000000000023.quest_subtitle: "Any shape, any texture"
	quest.7A00000000000023.quest_desc: [
		"&6FramedBlocks&r are blank blocks you camouflage with any other block, in every shape — slabs, stairs, slopes, pillars."
		"Right-click a framed block while holding any block to apply that block's look. (The Framed Hammer tweaks and strips camo.)"
		"Build seamless custom shapes in any material."
	]
	quest.7A00000000000024.title: "Handcrafted Furniture"
	quest.7A00000000000024.quest_subtitle: "Tables, chairs and decor"
	quest.7A00000000000024.quest_desc: [
		"&6Handcrafted&r adds furniture — tables, chairs, shelves, benches, crockery and trinkets — to dress up interiors."
		"Mix and match with wood types."
		"&7Makes rooms feel lived-in.&r"
	]
	quest.7A00000000000025.title: "Macaw's Collection"
	quest.7A00000000000025.quest_subtitle: "Doors, roofs, bridges and more"
	quest.7A00000000000025.quest_desc: [
		"The &6Macaw's&r mods add doors, windows, roofs, fences, trapdoors, bridges, paths and lights in every style."
		"Everything a detailed build needs."
		"&7Stacks with the other building mods here.&r"
	]
	quest.7A00000000000026.title: "Building Sets"
	quest.7A00000000000026.quest_subtitle: "Ready-made palettes"
	quest.7A00000000000026.quest_desc: [
		"&6Medieval Buildings&r, &6Royal Variations&r and &6Fusion&r add whole palettes of matching blocks — bricks, timber, trims and connected textures."
		"Great starting points for towns and castles."
		"&7Browse them in the creative menu or JEI.&r"
	]
	quest.7A00000000000027.title: "Disenchanting Table"
	quest.7A00000000000027.quest_subtitle: "Recover enchantments"
	quest.7A00000000000027.quest_desc: [
		"The &6Disenchanting Table&r pulls enchantments off a tool, weapon or armor piece and onto a book."
		"Salvage good enchants before scrapping old gear."
		"&7Costs some XP, but saves great enchantments.&r"
	]
	quest.7A00000000000028.title: "Mob-Free Zones"
	quest.7A00000000000028.quest_subtitle: "Megatorch and Magnum Torch"
	quest.7A00000000000028.quest_desc: [
		"Place a &6Megatorch&r or &6Magnum Torch&r to stop monster spawns in a large radius — no need to light every corner."
		"One torch keeps a base or farm clear."
		"&7A huge time-saver for big builds.&r"
	]
	quest.7A00000000000029.title: "Tree Harvester"
	quest.7A00000000000029.quest_subtitle: "Fell whole trees"
	quest.7A00000000000029.quest_desc: [
		"With &6Tree Harvester&r, chopping the bottom log of a tree brings the whole thing down at once."
		"No more climbing for stray leaves and logs."
		"&7Works with any axe.&r"
	]
	task.7C00000000000026.title: "Got it!"
	task.7C00000000000029.title: "Got it!"
	chapter.70DE000000000003.title: "Storage and Travel"
	chapter.70DE000000000003.chapter_subtitle: [
		"Carry more and get around — backpacks, waystones, carts, wagons, and ships."
	]
	quest.6F00000000000001.title: "Your First Backpack"
	quest.6F00000000000001.quest_subtitle: "Wear your storage"
	quest.6F00000000000001.quest_desc: [
		"Craft a &6Backpack&r and wear it in the back slot (or just hold it) for a big chunk of extra inventory."
		"Open it with a keybind anywhere — no need to place a chest."
		"&7Dye it any color and name it if you like.&r"
	]
	quest.6F00000000000002.title: "Bigger Backpacks"
	quest.6F00000000000002.quest_subtitle: "More rows, more slots"
	quest.6F00000000000002.quest_desc: [
		"Upgrade the base Backpack up the tier ladder — &eCopper, Iron, Gold, Diamond, Netherite&r — each adds storage rows and upgrade slots."
		"Upgrading keeps your contents and settings."
		"Iron is a solid early goal."
	]
	quest.6F00000000000003.title: "Diamond Backpack"
	quest.6F00000000000003.quest_subtitle: "Serious capacity"
	quest.6F00000000000003.quest_desc: [
		"The Diamond tier holds a huge amount and opens more upgrade slots for automation."
		"Worth the diamonds once you're settled."
		"&7One more tier to go.&r"
	]
	quest.6F00000000000004.title: "Netherite Backpack"
	quest.6F00000000000004.quest_subtitle: "The top tier"
	quest.6F00000000000004.quest_desc: [
		"The Netherite Backpack is &efireproof&r, holds the most, and has the most upgrade slots."
		"It survives lava and fire — a safe place for your gear."
		"&aReward: a land claim and a pick from Kingdom Loot.&r"
	]
	quest.6F00000000000005.title: "Backpack Upgrades"
	quest.6F00000000000005.quest_subtitle: "The upgrade system"
	quest.6F00000000000005.quest_desc: [
		"Craft an &6Upgrade Base&r — the core of every backpack upgrade."
		"Slot upgrades in to give your backpack new powers: auto-pickup, magnet, crafting, feeding, tool swap, and more."
		"&7Higher-tier backpacks hold more upgrades at once.&r"
	]
	quest.6F00000000000006.title: "Auto-Pickup"
	quest.6F00000000000006.quest_subtitle: "Hoover up drops"
	quest.6F00000000000006.quest_desc: [
		"The Pickup Upgrade makes your backpack grab items off the ground automatically."
		"Set filters so it only grabs what you want."
		"Great for mining and mob farms."
	]
	quest.6F00000000000007.title: "Magnet Upgrade"
	quest.6F00000000000007.quest_subtitle: "Pull items from range"
	quest.6F00000000000007.quest_desc: [
		"The Magnet Upgrade pulls nearby items and XP straight to you."
		"Combine it with Pickup to sweep an area clean."
		"&7Toggle it off when you don't want the clutter.&r"
	]
	quest.6F00000000000018.title: "Stack Upgrade I"
	quest.6F00000000000018.quest_subtitle: "Double your stacks"
	quest.6F00000000000018.quest_desc: [
		"Craft a &6Stack Upgrade Tier 1&r and slot it into a backpack to hold twice as many items per slot."
		"Great for hauling stone, dirt and ores by the thousand."
		"&7Needs an Upgrade Base to build.&r"
	]
	quest.6F00000000000019.title: "Stack Upgrade II"
	quest.6F00000000000019.quest_subtitle: "Four times the haul"
	quest.6F00000000000019.quest_desc: [
		"&6Stack Upgrade Tier 2&r multiplies stacks per slot by four."
		"A single backpack slot now swallows a double chest of one item."
	]
	quest.6F0000000000001A.title: "Stack Upgrade III"
	quest.6F0000000000001A.quest_subtitle: "Bottomless hauling"
	quest.6F0000000000001A.quest_desc: [
		"&6Stack Upgrade Tier 3&r pushes each slot to eight times the normal stack."
		"Mine all day without a single trip home to unload."
		"&7Higher tiers exist if you ever fill even this.&r"
	]
	quest.6F00000000000008.title: "Place a Waystone"
	quest.6F00000000000008.quest_subtitle: "Fast-travel anchor"
	quest.6F00000000000008.quest_desc: [
		"Place and activate a &6Waystone&r to mark a spot, then right-click any Waystone to teleport to any other you've activated."
		""
		"The quickest way to get one is to find it: waystones generate in villages and out in the world, and mine up cleanly. Crafting one instead needs a &6Warp Stone&r at its centre."
		"&7Scatter them across your world — home, mines, villages, the Nether. Activating one is free and permanent.&r"
	]
	quest.6F00000000000009.title: "Warp Scroll"
	quest.6F00000000000009.quest_subtitle: "Teleport on the go"
	quest.6F00000000000009.quest_desc: [
		"A Warp Scroll teleports you to any known Waystone without standing at one — single use."
		"Handy for emergencies or long hauls."
		"Craft a stack for expeditions."
	]
	quest.6F0000000000000A.title: "Warp Stone"
	quest.6F0000000000000A.quest_subtitle: "Reusable warp"
	quest.6F0000000000000A.quest_desc: [
		"The Warp Stone does what a Warp Scroll does, but it's reusable with a short cooldown."
		"Keep one on your hotbar and you're never far from home."
		"&aReward: a pick from Kingdom Loot.&r"
	]
	quest.6F0000000000000B.title: "Return Scroll"
	quest.6F0000000000000B.quest_subtitle: "Back to civilization"
	quest.6F0000000000000B.quest_desc: [
		"A Return Scroll teleports you to the &enearest activated Waystone&r with one use — no binding needed."
		"A cheap way back to safety when you're deep in the wild."
		"&7For a chosen destination, use the Bound Scroll below.&r"
	]
	quest.6F0000000000000C.title: "Bound Scroll"
	quest.6F0000000000000C.quest_subtitle: "Set your own destination"
	quest.6F0000000000000C.quest_desc: [
		"The Bound Scroll can be tied to a Waystone of your choice, then reused to warp there."
		"Bind it to your base, a mine, wherever you go often."
		"Rebind it any time."
	]
	quest.6F0000000000000D.title: "Hand Cart"
	quest.6F0000000000000D.quest_subtitle: "Pull it yourself"
	quest.6F0000000000000D.quest_desc: [
		"A Hand Cart is a small mobile chest you drag around on foot."
		"Perfect for moving a build's worth of blocks without a hundred trips."
		"&7Cheap, and needs no animal.&r"
	]
	quest.6F0000000000000E.title: "Supply Cart"
	quest.6F0000000000000E.quest_subtitle: "Let an animal haul it"
	quest.6F0000000000000E.quest_desc: [
		"Hitch a Supply Cart to a horse, mule, or donkey for a big mobile storage box that follows you."
		"Far more capacity than a hand cart."
		"Lead the animal and the cart trails behind."
	]
	quest.6F0000000000000F.title: "Animal Cart"
	quest.6F0000000000000F.quest_subtitle: "Move livestock"
	quest.6F0000000000000F.quest_desc: [
		"The Animal Cart carries animals — load up cows, sheep, or pigs and relocate your herd in one trip."
		"Beats leading them one by one with wheat."
		"&7Also horse-drawn.&r"
	]
	quest.6F00000000000010.title: "Horse-Drawn Wagon"
	quest.6F00000000000010.quest_subtitle: "Trotting Wagons"
	quest.6F00000000000010.quest_desc: [
		"The Conestoga Wagon is a large horse-drawn wagon you can ride and load with storage."
		"Hitch a horse and roll out — passengers and cargo together."
		"A proper overland vehicle."
	]
	quest.6F00000000000011.title: "Armored Wagon"
	quest.6F00000000000011.quest_subtitle: "Haul through danger"
	quest.6F00000000000011.quest_desc: [
		"The Armored Wagon is a tougher wagon that protects its riders and cargo on rough roads."
		"Good for long, dangerous hauls between settlements."
		"&aReward: a pick from Kingdom Loot.&r"
	]
	quest.6F00000000000013.title: "Your First Ship"
	quest.6F00000000000013.quest_subtitle: "The Cog"
	quest.6F00000000000013.quest_desc: [
		"Build and launch a &6Cog&r — a small sailing ship you steer across water."
		"Load it with a chest of supplies and set sail."
		"Much faster and roomier than a boat."
	]
	quest.6F00000000000014.title: "The Galley"
	quest.6F00000000000014.quest_subtitle: "Bigger and faster"
	quest.6F00000000000014.quest_desc: [
		"The Galley is a larger ship with more cargo room and speed."
		"A step up from the Cog for real voyages and hauling."
		"&7Add sails to push it faster.&r"
	]
	quest.6F00000000000015.title: "The Brigg"
	quest.6F00000000000015.quest_subtitle: "The flagship"
	quest.6F00000000000015.quest_desc: [
		"The Brigg is the largest ship — heavy cargo, multiple sails, room for cannons."
		"Your ocean-going flagship."
		"&aReward: a pick from Kingdom Loot.&r"
	]
	quest.6F00000000000016.title: "Rig the Sails"
	quest.6F00000000000016.quest_subtitle: "Speed and handling"
	quest.6F00000000000016.quest_desc: [
		"Add Sails to your ship to increase its speed — more sails, more knots."
		"Catch the wind and cut travel time."
		"&7Balance sails against control.&r"
	]
	quest.6F00000000000017.title: "Cannons"
	quest.6F00000000000017.quest_subtitle: "Naval combat"
	quest.6F00000000000017.quest_desc: [
		"Mount Cannons on your ship and load Cannon Balls to fight back on the water."
		"Fend off drowned, guardians, or rival pirates."
		"&aReward: a pick from Kingdom Loot.&r"
	]
	chapter.388084E512A0ABCB.title: "MineColonies"
	chapter.388084E512A0ABCB.chapter_subtitle: [
		"Found a colony, hire citizens to build and work it, and grow a self-running medieval town."
	]
	quest.1A00000000000001.title: "Found Your Colony"
	quest.1A00000000000001.quest_subtitle: "Every colony starts here"
	quest.1A00000000000001.quest_desc: [
		"Place the &6Supply Camp&r on flat, solid ground and open it to receive your first &eTown Hall&r and &eBuild Tool&r."
		"Pick a roomy spot — a colony spreads outward as you add buildings."
		"&7You only get one Supply Camp, so choose the location well.&r"
	]
	quest.1A00000000000002.title: "Raise the Town Hall"
	quest.1A00000000000002.quest_subtitle: "The heart of the colony"
	quest.1A00000000000002.quest_desc: [
		"The Town Hall founds your colony and claims the land around it."
		"Place the block, then use the Build Tool to set the footprint and confirm — a Builder constructs it once you hire one."
		"Open it any time to see citizens, happiness, and colony-wide settings."
	]
	quest.1A00000000000003.title: "The Build Tool"
	quest.1A00000000000003.quest_subtitle: "How every building gets placed"
	quest.1A00000000000003.quest_desc: [
		"The Build Tool places and upgrades &eevery&r colony building."
		"Right-click to open the blueprint menu, position the see-through hologram, rotate it, and confirm."
		"&7The building doesn't appear instantly — a Builder works through the materials block by block.&r"
	]
	quest.1A00000000000004.title: "Hire a Builder"
	quest.1A00000000000004.quest_subtitle: "Nothing gets built without one"
	quest.1A00000000000004.quest_desc: [
		"Place a &6Builder's Hut&r and assign a citizen. The Builder constructs and upgrades every other building."
		"Builders need materials — check the hut's request list and fill it, or let a Courier deliver later."
		"&eKeep your Builder supplied and everything else follows.&r"
	]
	quest.1A00000000000005.title: "A Colony Is Born"
	quest.1A00000000000005.quest_subtitle: "Town Hall built"
	quest.1A00000000000005.quest_desc: [
		"Your Town Hall is up and your colony is on the map."
		"From here you can build any hut below — there is no fixed order, so grow however your colony needs."
		"&aReward: a land-claim token to expand your borders.&r"
	]
	quest.1A00000000000006.title: "The Request System"
	quest.1A00000000000006.quest_subtitle: "How workers ask for materials"
	quest.1A00000000000006.quest_desc: [
		"Workers can't gather everything — they post &erequests&r for tools, food, and materials."
		"Fill them three ways: drop items in the worker's hut, hand them over at the Town Hall request list, or build a &6Warehouse&r and &6Courier&r to deliver automatically."
		"&7The Resource Scroll and Clipboard let you read open requests on the go.&r"
	]
	quest.1A00000000000007.title: "Build Homes"
	quest.1A00000000000007.quest_subtitle: "Citizens need somewhere to live"
	quest.1A00000000000007.quest_desc: [
		"Each &6Residence&r houses citizens and raises your population cap."
		"More beds means room for more workers — build Residences before you run out of housing."
		"Upgrade them to raise the cap further and keep citizens content."
	]
	quest.1A00000000000008.title: "Build a Tavern"
	quest.1A00000000000008.quest_subtitle: "Recruit new citizens"
	quest.1A00000000000008.quest_desc: [
		"The &6Tavern&r is where new citizens arrive — visitors show up and can be recruited for a small fee."
		"It also gives a gathering spot and a happiness boost."
		"A steady stream of recruits keeps your worker slots filled."
	]
	quest.1A00000000000009.title: "A Growing Village"
	quest.1A00000000000009.quest_subtitle: "5 citizens"
	quest.1A00000000000009.quest_desc: [
		"Your colony has reached &e5 citizens&r."
		"Keep housing, food, and jobs ahead of your population and it will keep climbing."
		"&aReward: another land claim as your borders grow.&r"
	]
	quest.1A0000000000000A.title: "A Bustling Town"
	quest.1A0000000000000A.quest_subtitle: "10 citizens"
	quest.1A0000000000000A.quest_desc: [
		"Ten citizens now call your colony home."
		"At this size a &6Warehouse&r and &6Courier&r really pay off — let them haul materials so Builders never sit idle."
		"&aReward: more claimed land.&r"
	]
	quest.1A0000000000000B.title: "A Thriving Colony"
	quest.1A0000000000000B.quest_subtitle: "25 citizens"
	quest.1A0000000000000B.quest_desc: [
		"Twenty-five citizens — a proper town."
		"&6University&r research and higher-tier buildings push you toward 50 and beyond."
		"&aReward: a large land claim and a pick from the colony stores.&r"
	]
	quest.1A0000000000000C.title: "Start a Farm"
	quest.1A0000000000000C.quest_subtitle: "Grow the colony's food"
	quest.1A0000000000000C.quest_desc: [
		"Place a &6Farm&r and mark &eFields&r nearby for the Farmer to work."
		"The Farmer plants and harvests crops that feed citizens and supply the Cook."
		"Assign fields with the Build Tool and choose what each one grows."
	]
	quest.1A0000000000000D.title: "Build a Fishery"
	quest.1A0000000000000D.quest_subtitle: "Food from the water"
	quest.1A0000000000000D.quest_desc: [
		"A &6Fisher's Hut&r on a coast or lake gives a steady supply of fish."
		"Fish are cheap early food — just a hut and a worker."
		"&7A good backup while your farms get going.&r"
	]
	quest.1A0000000000000E.title: "Feed Everyone"
	quest.1A0000000000000E.quest_subtitle: "The Dining Hall"
	quest.1A0000000000000E.quest_desc: [
		"Citizens get hungry and unhappy without food. The &6Cook&r turns raw ingredients into meals and serves everyone."
		"Keep the Cook stocked with farm and fish output and the whole colony stays fed."
		"&cHungry citizens work slowly and can leave — don't skip this.&r"
	]
	quest.1A0000000000000F.title: "Build a Bakery"
	quest.1A0000000000000F.quest_subtitle: "Bread and better meals"
	quest.1A0000000000000F.quest_desc: [
		"The &6Baker&r turns wheat into bread and baked goods, adding variety to your food."
		"A varied diet keeps citizens happier than the same meal every day."
		"Feeds off your farm's wheat."
	]
	quest.1A00000000000010.title: "Raise Livestock"
	quest.1A00000000000010.quest_subtitle: "Cowhand, Shepherd, Swineherd, Chicken Farmer, Rabbit Hutch"
	quest.1A00000000000010.quest_desc: [
		"The animal herders keep cows, sheep, pigs, chickens, and rabbits — meat, wool, leather, eggs, and milk with no work from you."
		"Build all five herder huts (including the Rabbit Hutch) to complete this."
		"&7Wool and leather also feed your crafters.&r"
	]
	quest.1A00000000000011.title: "Chop Wood"
	quest.1A00000000000011.quest_subtitle: "The Forester's Hut"
	quest.1A00000000000011.quest_desc: [
		"The &6Forester&r fells trees and replants them, keeping a renewable wood supply flowing."
		"Wood feeds the Sawmill and nearly every early build."
		"Give them an axe and a forest to work."
	]
	quest.1A00000000000012.title: "Dig a Mine"
	quest.1A00000000000012.quest_subtitle: "Ores and stone"
	quest.1A00000000000012.quest_desc: [
		"The &6Miner&r digs a proper shaft and brings up stone, coal, and ores."
		"Their output feeds the Stonemason and Smeltery."
		"Upgrade the Mine to reach deeper, richer layers."
	]
	quest.1A00000000000013.title: "Build a Sawmill"
	quest.1A00000000000013.quest_subtitle: "Wood into planks and parts"
	quest.1A00000000000013.quest_desc: [
		"The &6Sawmill&r crafts everything wooden — planks, sticks, tools, furniture parts — from the Forester's logs."
		"Many building-material requests are fulfilled here."
		"&7Pairs with the Forester.&r"
	]
	quest.1A00000000000014.title: "Build a Stonemason's Hut"
	quest.1A00000000000014.quest_subtitle: "Stone into building blocks"
	quest.1A00000000000014.quest_desc: [
		"The &6Stonemason&r shapes the Miner's stone into bricks, slabs, stairs, and decorative blocks."
		"Lots of building upgrades demand worked stone — this hut keeps them supplied."
		"&7Pairs with the Mine.&r"
	]
	quest.1A00000000000015.title: "Build a Blacksmith's Hut"
	quest.1A00000000000015.quest_subtitle: "Tools and armor"
	quest.1A00000000000015.quest_desc: [
		"The &6Blacksmith&r crafts the metal tools and armor your workers and guards need."
		"As buildings upgrade they demand better tools — the Blacksmith fulfils those requests."
		"Needs metal from the Smeltery."
	]
	quest.1A00000000000016.title: "Build a Smeltery"
	quest.1A00000000000016.quest_subtitle: "Smelt ore into ingots"
	quest.1A00000000000016.quest_desc: [
		"The &6Smeltery&r smelts the Miner's ore into ingots in bulk, feeding the Blacksmith and Mechanic."
		"Central to your metal supply as the colony grows."
		"Keep it fed with ore and fuel."
	]
	quest.1A00000000000017.title: "Post a Guard"
	quest.1A00000000000017.quest_subtitle: "Your first defender"
	quest.1A00000000000017.quest_desc: [
		"A &6Guard Tower&r assigns a citizen as a guard who patrols and fights off monsters and raiders."
		"Guards level up with experience and gear — keep them armed and armored."
		"Place towers to cover your colony's edges."
	]
	quest.1A00000000000018.title: "Build the Barracks"
	quest.1A00000000000018.quest_subtitle: "A proper garrison"
	quest.1A00000000000018.quest_desc: [
		"The &6Barracks&r houses several guards in one upgraded structure and anchors your defense."
		"It comes with Barracks Towers you can build out for full coverage."
		"The backbone of a colony that survives raids."
	]
	quest.1A00000000000019.title: "Train Your Troops"
	quest.1A00000000000019.quest_subtitle: "Archers and knights"
	quest.1A00000000000019.quest_desc: [
		"The &6Combat Academy&r trains melee knights; the &6Archery&r trains ranged guards."
		"Build both for a balanced defense — archers thin raiders out, knights hold the line."
		"Assign citizens and equip them."
	]
	quest.1A0000000000001A.title: "Survive a Raid"
	quest.1A0000000000001A.quest_subtitle: "Defend the colony"
	quest.1A0000000000001A.quest_desc: [
		"Raids hit your colony on a schedule — barbarians, pirates, or worse depending on where you built."
		"Rally your guards (the &eRallying Banner&r calls them to you) and hold the line."
		"Defeat 10 raiders to prove your defenses hold."
		"&aReward: a pick from the colony stores.&r"
	]
	quest.1A0000000000001B.title: "Set Up Logistics"
	quest.1A0000000000001B.quest_subtitle: "Warehouse and Courier"
	quest.1A0000000000001B.quest_desc: [
		"The &6Warehouse&r stores your colony's shared goods; the &6Courier&r hauls items between huts and the Warehouse automatically."
		"Together they stop Builders and crafters sitting idle waiting on materials."
		"&eThe single biggest quality-of-life upgrade for a growing colony.&r"
	]
	quest.1A0000000000001C.title: "Build a University"
	quest.1A0000000000001C.quest_subtitle: "Unlock research"
	quest.1A0000000000001C.quest_desc: [
		"The &6University&r lets you research colony-wide upgrades — faster workers, stronger guards, better tools, and more."
		"Research takes time and materials, but the buffs are permanent."
		"Assign researchers to speed it along."
	]
	quest.1A0000000000001D.title: "Build a Library"
	quest.1A0000000000001D.quest_subtitle: "Boost your citizens"
	quest.1A0000000000001D.quest_desc: [
		"Library workers study to raise your citizens' skills over time."
		"Smarter citizens work faster and produce more."
		"&7Pairs with the University's research.&r"
	]
	quest.1A0000000000001E.title: "Build a Hospital"
	quest.1A0000000000001E.quest_subtitle: "Heal the sick and injured"
	quest.1A0000000000001E.quest_desc: [
		"Citizens get hurt and fall ill — the &6Hospital&r treats them so they recover instead of dying."
		"A Healer here saves you replacing lost workers."
		"Stock it with the medicine it requests."
	]
	quest.1A0000000000001F.title: "Build a School"
	quest.1A0000000000001F.quest_subtitle: "Raise skilled children"
	quest.1A0000000000001F.quest_desc: [
		"With a &6School&r, child citizens learn from teachers and grow into more skilled adults."
		"Educated kids start their careers with a head start."
		"Grows your colony's talent from within."
	]
	quest.1A00000000000020.title: "Build a Mystical Site"
	quest.1A00000000000020.quest_subtitle: "A happiness boost"
	quest.1A00000000000020.quest_desc: [
		"The &6Mystical Site&r is a decorative building that raises colony happiness."
		"Happy colonies work faster, recruit easier, and hold together under pressure."
		"&7A simple, cheap morale win.&r"
	]
	task.3A00000000000005.title: "Build the Town Hall"
	task.3A00000000000006.title: "Got it!"
	task.3A00000000000009.title: "Reach 5 citizens"
	task.3A0000000000000A.title: "Reach 10 citizens"
	task.3A0000000000000B.title: "Reach 25 citizens"
	task.3A00000000000010.title: "Build all five herder huts"
	task.3A0000000000001A.title: "Defeat 10 raiders"
	task.3A00000000000020.title: "Build the Mystical Site"
	chapter.57A2320197D49E1E.title: "Getting Started"
	chapter.57A2320197D49E1E.chapter_subtitle: [
		"Welcome to Ancient Kingdoms 4 — who you are, how to survive, and where your story leads."
	]
	chapter.5451511F844F25F9.title: "Ice and Fire"
	chapter.5451511F844F25F9.chapter_subtitle: [
		"The complete dragon guide: hunting, harvesting, taming, dragonsteel — and every other beast in the mod."
	]
	file.0000000000000001.title: "&6Ancient Kingdoms 4"
	chapter_group.79D363442938A3A7.title: "&6Your Kingdom"
	chapter_group.208F5E79BC73D0EC.title: "&5Paths of Magic"
	chapter_group.62E8BD0CEEC916F5.title: "&cHero's Journey"
	reward_table.00000000CAFEBABE.title: "Explorer's Cache"
	reward_table.00000000C0FFEE00.title: "Kingdom Loot"
	reward_table.00000000DEADBEEF.title: "Dragon Hoard"
	quest.4D00000000000001.title: "Welcome to Ancient Kingdoms"
	quest.4D00000000000001.quest_subtitle: "Your story begins here"
	quest.4D00000000000001.quest_desc: [
		"&6Ancient Kingdoms 4&r is a medieval realm of three great callings: build a living colony with &6MineColonies&r, master four schools of &5magic&r, and hunt the &cdragons and monsters&r that rule the wilds."
		""
		"This book is your guide. Chapters are listed on the left, grouped by path. Completed quests pay out rewards — &eclick them on the quest's page to claim&r. Quests like this one are simple checkboxes: tick them off whenever you've read them."
	]
	task.6D00000000000001.title: "Got it!"
	quest.4D00000000000009.title: "Your Origin and Class"
	quest.4D00000000000009.quest_subtitle: "What you are, and what you do"
	quest.4D00000000000009.quest_desc: [
		"When you first woke in this realm you chose an &eOrigin&r (what you &oare&r — Avians glide, Arachnids climb, Blazelings shrug off fire, Merlings breathe water) and a &eClass&r (what you &odo&r — Archer, Berserker, Blacksmith, Cleric, Cook, Explorer and more)."
		""
		"To review your powers at any time: open your &einventory&r and look for the &eOrigins button&r, or check &eOptions > Controls&r for the 'View Origin' keybind. Each power's tooltip explains exactly what it does — worth a read before you plan your build."
	]
	task.6D00000000000009.title: "Got it!"
	quest.4D00000000000007.title: "Your First Night"
	quest.4D00000000000007.quest_subtitle: "Shelter before sundown"
	quest.4D00000000000007.quest_desc: [
		"The old rules still apply: get wood, get shelter, get light before dark — the monsters here are meaner than the ones you remember."
		""
		"Check your inventory: your &eClass gave you a starter kit&r to skip the worst of day one. Here's a bed and some torches on the house, too."
	]
	task.6D00000000000007.title: "Got it!"
	quest.4D0000000000000A.title: "The Dragon's Shadow"
	quest.4D0000000000000A.quest_subtitle: "Something big lives here"
	quest.4D0000000000000A.quest_desc: [
		"See that shadow crossing the sun? &cThis realm belongs to dragons&r — fire, ice and lightning, from small drakes to ancient titans that level forests."
		""
		"Early on: &ekeep clear of the roosts&r. Collect &emanuscripts&r from dungeon chests and learn your enemy first. When you're ready to hunt, the &cHere Be Dragons&r chapter takes you from your first bestiary to a dragonsteel blade — and a dragon of your own."
	]
	task.6D0000000000000A.title: "Got it!"
	quest.4D0000000000000B.title: "A Kingdom Awaits"
	quest.4D0000000000000B.quest_subtitle: "You won't build it alone"
	quest.4D0000000000000B.quest_desc: [
		"You weren't meant to carry this realm on your back. &6MineColonies&r lets you found a real colony — citizens with names and jobs, builders who raise your city, farmers, guards and couriers."
		""
		"It starts with a humble &eSupply Camp&r and ends with a walled capital. When you're ready to rule, open &6The Crown's Charter&r chapter."
	]
	task.6D0000000000000B.title: "Got it!"
	quest.4D00000000000006.title: "Choose Your Path"
	quest.4D00000000000006.quest_subtitle: "Ruler, mage, or monster-slayer?"
	quest.4D00000000000006.quest_desc: [
		"You're settled, and the realm lies open. Three paths await:"
		""
		"&6Your Kingdom&r — found your colony and live well off the land."
		"&5Paths of Magic&r — four schools of magic, four prices to pay."
		"&cHero's Journey&r — dragons to slay, gear to forge, depths and ruins to plunder."
		""
		"There's no wrong order. Walk them all — and check &eTools of the Trade&r for the quality-of-life kit that makes every path smoother."
	]
	task.6D00000000000006.title: "Got it!"
	quest.4D00000000000008.title: "Commands of the Realm"
	quest.4D00000000000008.quest_subtitle: "A little magic for everyone"
	quest.4D00000000000008.quest_desc: [
		"A few handy commands work for every traveler — type these in chat:"
		""
		"&e/sethome&r and &e/home&r — mark and return to your base."
		"&e/rtp&r — teleport somewhere random and wild."
		"&e/back&r — return to where you last teleported from (or died)."
		"&e/tpa <player>&r — ask to teleport to a friend."
	]
	task.6D00000000000008.title: "Got it!"
	quest.4D0000000000000C.title: "Join the Realm"
	quest.4D0000000000000C.quest_subtitle: "Adventurers wanted"
	quest.4D0000000000000C.quest_desc: [
		"Questions, screenshots, kingdom bragging rights — the community lives on Discord:"
		""
		"&9&nhttps://discord.gg/duNgHhPB7&r"
	]
	task.6D0000000000000C.title: "Say hello"
	quest.4D0000000000000D.title: "When Things Go Wrong"
	quest.4D0000000000000D.quest_subtitle: "Even legends hit bugs"
	quest.4D0000000000000D.quest_desc: [
		"A big modpack is a small city — sometimes a pipe bursts."
		""
		"&eGame stuttering?&r Give it a minute after loading; first launches are the worst."
		"&eCrashed?&r The launcher keeps logs — share the latest one when reporting."
		"&eFound a bug?&r Report it on the pack's CurseForge page or in the Discord with what you were doing when it happened."
	]
	task.6D0000000000000D.title: "Got it!"
	quest.1C00000000000001.title: "Manuscripts"
	quest.1C00000000000001.quest_subtitle: "Ice and Fire's research material"
	quest.1C00000000000001.quest_desc: [
		"&eManuscripts&r are Ice and Fire's knowledge currency. You'll find them in &edragon roosts and dens, cyclops caves, graveyards and battle towers&r out in the world."
		""
		"You need them to unlock pages in the Bestiary. &7Getting Started already handed you a few to begin with — grab every one you find after that.&r"
	]
	task.3C00000000000001.title: "Collect 3 Manuscripts"
	quest.1C00000000000002.title: "The Bestiary"
	quest.1C00000000000002.quest_subtitle: "The mod's guide book"
	quest.1C00000000000002.quest_desc: [
		"The &eBestiary&r (crafted from 3 manuscripts) is Ice and Fire's in-game encyclopedia."
		""
		"&eHow to unlock pages:&r place the Bestiary in a &eLectern&r and feed manuscripts into it — each one teaches a random new creature entry. Entries cover spawn locations, drops, and fight mechanics for everything in this chapter."
	]
	quest.1C00000000000003.title: "Find a Roost"
	quest.1C00000000000003.quest_subtitle: "Where the fire is"
	quest.1C00000000000003.quest_desc: [
		"Dragons spawn in two kinds of lairs:"
		""
		"&eSurface roosts&r — hills with a stage 1-3 dragon circling above a small hoard. Your first target."
		"&eUnderground caverns&r — big cave lairs with stage 4 dragons and serious treasure. Fire dragons prefer hot biomes, ice dragons cold ones, lightning dragons wet ones."
	]
	task.3C00000000000003.title: "Discover a Fire Dragon Roost"
	quest.1C00000000000004.title: "Slay a Fire Dragon"
	quest.1C00000000000004.quest_subtitle: "Kill it before it burns the loot"
	quest.1C00000000000004.quest_desc: [
		"&cFire dragons&r breathe a stream that ignites terrain and melts you through armor."
		""
		"&eTips:&r Fire Resistance potions cancel most of the danger. Fight it grounded — hitting the wings and body forces landings. Don't stand in the fire line; strafe around it."
		""
		"&7Drops: scales, bones, skull, and bottleable blood. The corpse stays — harvest everything.&r"
	]
	task.3C00000000000004.title: "Slay a Fire Dragon"
	quest.1C00000000000005.title: "Slay an Ice Dragon"
	quest.1C00000000000005.quest_subtitle: "The freezing breath"
	quest.1C00000000000005.quest_desc: [
		"&bIce dragons&r encase you in an ice block if their breath connects — held still while it lines up the next bite."
		""
		"&eTips:&r keep moving side to side, never stand in open sightlines, and break out of ice fast (punch it). Strength potions shorten the fight a lot."
	]
	task.3C00000000000005.title: "Slay an Ice Dragon"
	quest.1C00000000000006.title: "Slay a Lightning Dragon"
	quest.1C00000000000006.quest_subtitle: "The storm breath"
	quest.1C00000000000006.quest_desc: [
		"&eLightning dragons&r strike with bolts that pierce armor and fling you airborne — fall damage does half their work."
		""
		"&eTips:&r a Feather Falling setup or slow-fall potion removes their best trick. They fly more than the other breeds; a strong bow helps."
	]
	task.3C00000000000006.title: "Slay a Lightning Dragon"
	quest.1C00000000000007.title: "Dragon Bone"
	quest.1C00000000000007.quest_subtitle: "Harvest the skeleton"
	quest.1C00000000000007.quest_desc: [
		"Break down a dragon corpse to collect &eDragon Bones&r — the material for the strongest pre-dragonsteel weapons."
		""
		"&79 bones covers a sword and a bow. Bigger dragons drop far more.&r"
	]
	task.3C00000000000007.title: "Collect 9 Dragon Bones"
	quest.1C00000000000008.title: "Dragonbone Sword"
	quest.1C00000000000008.quest_subtitle: "Better than diamond"
	quest.1C00000000000008.quest_desc: [
		"&eDragonbone tools and weapons&r craft like vanilla ones, using dragon bones instead of sticks+material — and the sword out-damages diamond."
		""
		"The full set: sword, bow, pickaxe, axe, shovel, hoe."
	]
	quest.1C00000000000009.title: "Blood and Heart"
	quest.1C00000000000009.quest_subtitle: "The valuable organs"
	quest.1C00000000000009.quest_desc: [
		"Two drops you should never waste:"
		""
		"&cDragon Blood&r — use an empty bottle on the corpse. Required for the Dragonforge and flame-infused weapons."
		"&cDragon Heart&r — a rare corpse harvest used in top-end crafting."
	]
	quest.1C0000000000000A.title: "Steal an Egg"
	quest.1C0000000000000A.quest_subtitle: "From stage 4+ females"
	quest.1C0000000000000A.quest_desc: [
		"&eDragon eggs&r drop when you slay &estage 4-5 female dragons&r — mostly found in underground caverns. Check the corpse and the hoard."
		""
		"Every egg color hatches into that color's dragon, and it will be &eyours&r."
	]
	task.3C0000000000000A.title: "Obtain a Dragon Egg"
	quest.1C0000000000000B.title: "Dragon Meal"
	quest.1C0000000000000B.quest_subtitle: "Growth food"
	quest.1C0000000000000B.quest_desc: [
		"&eDragon Meal&r (meat + bonemeal) is how you grow your dragon — each meal ages it and heals it."
		""
		"At &eStage 3&r it can be ridden and takes flight with you. Keep feeding: a hand-raised stage 5 is the strongest ally in the pack."
	]
	task.3C0000000000000B.title: "Craft 4 Dragon Meal"
	quest.1C0000000000000C.title: "Dragon Commands"
	quest.1C0000000000000C.quest_subtitle: "Staff, horn and flute"
	quest.1C0000000000000C.quest_desc: [
		"Three tools every dragon rider needs:"
		""
		"&eDragon Staff&r — right-click your dragon to set wander / sit / escort orders."
		"&eDragon Horn&r — stores your dragon as an item. Pocket cataclysm."
		"&eDragon Flute&r — calls your flying dragon down to you."
	]
	task.3C0000000000000C.title: "Craft a Dragon Staff"
	task.3C0000000000000D.title: "Craft a Dragon Horn"
	quest.1C0000000000000D.title: "Build the Dragonforge"
	quest.1C0000000000000D.quest_subtitle: "The multiblock smelter"
	quest.1C0000000000000D.quest_desc: [
		"The &eDragonforge&r is a multiblock furnace that smelts iron + dragon blood into dragonsteel. Bricks craft from stone + dragon bones; the core is the controller."
		""
		"The core is crafted &einactive&r — it only wakes up once the brick shell around it is built correctly."
		""
		"&eThe catch:&r only &cdragon fire&r heats it. Build it where your tamed dragon can breathe on it — or where a wild one will oblige, if you enjoy gambling."
	]
	task.3C0000000000000E.title: "Craft 8 Dragonforge Bricks"
	task.3C0000000000000F.title: "Craft a Dragonforge Core"
	quest.1C0000000000000E.title: "Dragonsteel"
	quest.1C0000000000000E.quest_subtitle: "The endgame metal"
	quest.1C0000000000000E.quest_desc: [
		"Feed the burning forge &eiron ingots + fire dragon blood&r to smelt &eDragonsteel Ingots&r."
		""
		"Dragonsteel gear is the strongest in Ice and Fire — beyond netherite. Each breed's blood makes its own steel variant with matching perks."
	]
	quest.1C0000000000000F.title: "Dragonsteel Arsenal"
	quest.1C0000000000000F.quest_subtitle: "The final tier"
	quest.1C0000000000000F.quest_desc: [
		"Forge the &eDragonsteel Sword&r — massive damage plus a burn effect on every hit."
		""
		"The full dragonsteel kit (armor, tools, weapons) is the best gear this mod offers. From here, nothing in the realm outclasses you."
	]
	quest.1C00000000000010.title: "Cockatrice"
	quest.1C00000000000010.quest_subtitle: "The death stare"
	quest.1C00000000000010.quest_desc: [
		"&eCockatrices&r wither anything they stare at — including through your shield."
		""
		"&eCounter:&r break line of sight, close the gap sideways, and strike from behind. Drops the &eCockatrice Eye&r, an attack-boost charm."
	]
	quest.1C00000000000011.title: "Trolls"
	quest.1C00000000000011.quest_subtitle: "Cave brutes"
	quest.1C00000000000011.quest_desc: [
		"&eTrolls&r spawn in caves and under bridges, swinging log clubs that launch you."
		""
		"&eCounter:&r daylight turns them to stone. Drops: &etroll tusks&r and their weapon — troll weapons are strong early clubs."
	]
	quest.1C00000000000012.title: "Cyclops"
	quest.1C00000000000012.quest_subtitle: "The shepherd giant"
	quest.1C00000000000012.quest_desc: [
		"&eCyclopes&r herd sheep on rocky islands and swat players like flies. Their grab attack skips your armor."
		""
		"&eCounter:&r shoot the eye — headshots stagger it. Never fight in the open at melee range."
	]
	task.3C00000000000014.title: "Slay a Cyclops"
	quest.1C00000000000013.title: "Sea Serpents"
	quest.1C00000000000013.quest_subtitle: "Seven colors, three sizes"
	quest.1C00000000000013.quest_desc: [
		"&3Sea Serpents&r patrol deep oceans and attack ships on sight."
		""
		"&eCounter:&r fight from a boat deck or shoreline, not in the water — their swim speed beats yours. Drops &efangs and scales&r for tridents and sea armor."
	]
	quest.1C00000000000014.title: "Sirens"
	quest.1C00000000000014.quest_subtitle: "Craft earplugs first"
	quest.1C00000000000014.quest_desc: [
		"&dSirens&r charm you and drag you underwater to drown. Their song takes over your camera — you literally walk to them."
		""
		"&eCounter:&r craft &eEarplugs&r (two wooden planks, side by side) and wear them in a curio slot to block the song entirely. Then take the fight to them and claim a &eSiren Tear&r."
	]
	quest.1C00000000000015.title: "The Hydra"
	quest.1C00000000000015.quest_subtitle: "Nine heads of trouble"
	quest.1C00000000000015.quest_desc: [
		"The &2Hydra&r regrows any head you cut — unless the stump is &eburned&r."
		""
		"&eCounter:&r fight with fire: a flame-enchanted weapon, fire aspect, or the flaming dragonbone sword stops regrowth. Poison spit is its ranged threat; a shield eats it."
	]
	task.3C00000000000017.title: "Slay a Hydra"
	quest.1C00000000000016.title: "The Gorgon"
	quest.1C00000000000016.quest_subtitle: "Never look directly at her"
	quest.1C00000000000016.quest_desc: [
		"The &eGorgon&r waits in her jungle temple. Eye contact = instant stone statue. That's you."
		""
		"&eCounter:&r wear a &eBlindfold&r (curio slot) to fight her safely — you'll take reduced vision over petrification every time. Her head is a weapon that stones your enemies."
	]
	task.3C00000000000018.title: "Find a Gorgon Temple"
	task.3C00000000000019.title: "Slay the Gorgon"
	quest.1C00000000000017.title: "Pixies"
	quest.1C00000000000017.quest_subtitle: "Tiny thieves, big value"
	quest.1C00000000000017.quest_desc: [
		"&dPixies&r live in mushroom-circle villages and steal items from sleeping players."
		""
		"&eWorth hunting:&r Pixie Dust brews flight and luck potions, and a jarred pixie is both a lamp and a lucky charm."
	]
	task.3C0000000000001A.title: "Find a Pixie Village"
	task.3C0000000000001B.title: "Obtain Pixie Dust"
	quest.1C00000000000018.title: "The Dread Queen"
	quest.1C00000000000018.quest_subtitle: "Ice and Fire's final boss"
	quest.1C00000000000018.quest_desc: [
		"The &5Dread Queen&r rules a frozen citadel and raises the dread legion — every mob she kills joins her army."
		""
		"&eCounter:&r bring dragonsteel, healing supplies, and thin her summons fast — the fight scales with how long you let her army grow. The realm's hardest fight, and its best loot."
	]
	task.3C0000000000001C.title: "Slay the Dread Queen"
	quest.1C00000000000019.title: "Tame a Hippogryph"
	quest.1C00000000000019.quest_subtitle: "Cliffside flyer"
	quest.1C00000000000019.quest_desc: [
		"&eHippogryphs&r live on mountain cliffs. Feed one &erabbit feet&r to tame it — then saddle, armor, and fly it long before your dragon grows up."
		""
		"&7They dive-bomb prey on command and fit in a stable.&r"
	]
	task.3C0000000000001D.title: "Craft any Dragon armor piece"
	quest.1C0000000000001A.title: "Tame an Amphithere"
	quest.1C0000000000001A.quest_subtitle: "The jungle serpent"
	quest.1C0000000000001A.quest_desc: [
		"&2Amphitheres&r glide over jungles. To tame one: &eride it mid-flight and hang on&r until it submits."
		""
		"No saddle needed once broken — a free flying mount for the bold."
	]
	task.3C0000000000001E.title: "Forge an infused dragonbone sword"
	quest.1C0000000000001B.title: "Death Worm"
	quest.1C0000000000001B.quest_subtitle: "The desert ambusher"
	quest.1C0000000000001B.quest_desc: [
		"&eDeath Worms&r swim through desert sand and erupt underneath you."
		""
		"&eCounter:&r watch for the moving sand trail, fight from rock or hard ground where they can't dive. Their chitin makes solid armor."
	]
	task.3C0000000000001F.title: "Got it!"
	quest.1C0000000000001C.title: "Ghosts"
	quest.1C0000000000001C.quest_subtitle: "Haunted shipwrecks"
	quest.1C0000000000001C.quest_desc: [
		"&bGhosts&r haunt graveyards and shipwreck sites, phasing through walls to reach you."
		""
		"&eCounter:&r they take full damage from any weapon — the danger is terrain, not toughness. Drops &eGhost Ingots&r for the phasing &eGhost Sword&r."
	]
	task.3C00000000000020.title: "Slay a Ghost"
	task.3C00000000000021.title: "Obtain a Ghost Ingot"
	quest.1C00000000000020.title: "Dragon Stages"
	quest.1C00000000000020.quest_subtitle: "Size = danger = loot"
	quest.1C00000000000020.quest_desc: [
		"Dragons grow through &e5 stages&r over their (very long) lives:"
		""
		"&7Stage 1-2:&r hatchlings and juveniles — killable with early gear."
		"&eStage 3:&r adult, flies and breathes properly — bring good armor."
		"&6Stage 4:&r these guard the underground caverns and can drop &eeggs&r."
		"&cStage 5:&r 30+ block titans. Do not fight your first one fair."
		""
		"Bigger dragons drop more scales, bones and better hoard loot."
	]
	task.3C00000000000022.title: "Got it!"
	task.3C00000000000009.title: "Bottle Fire Dragon Blood"
	task.3C00000000000023.title: "Harvest a Fire Dragon Heart"
	quest.1C00000000000021.title: "Dragonbone Bow"
	quest.1C00000000000021.quest_subtitle: "Hits like a ballista"
	quest.1C00000000000021.quest_desc: [
		"The &eDragonbone Bow&r deals roughly double a vanilla bow's damage, and &eDragonbone Arrows&r push it further."
		""
		"This is the recommended weapon for your first stage 4-5 dragon fight — kill it before it lands."
	]
	task.3C00000000000024.title: "Craft a Dragonbone Bow"
	task.3C00000000000025.title: "Craft 8 Dragonbone Arrows"
	quest.1C0000000000001D.title: "Dragon Armor"
	quest.1C0000000000001D.quest_subtitle: "Armor your dragon"
	quest.1C0000000000001D.quest_desc: [
		"Once you've raised a dragon, protect it: craft &eDragon Armor&r — head, neck, body and tail plating, forged from metal ingots (iron on up to dragonsteel)."
		""
		"An armored dragon shrugs off far more punishment in a fight. Any piece counts for this quest. &7For your own armor, see the Dragonsteel Arsenal.&r"
	]
	quest.1C0000000000001E.title: "Flame-Infused Blade"
	quest.1C0000000000001E.quest_subtitle: "Weapon + dragon blood"
	quest.1C0000000000001E.quest_desc: [
		"Combine a &eDragonbone Sword&r with &cFire Dragon Blood&r in a crafting grid to forge the &cFlaming Dragonbone Sword&r — it ignites everything it hits."
		""
		"&7Ice and lightning blood make frozen and shock variants the same way.&r"
	]
	quest.1C0000000000001F.title: "Hatching 101"
	quest.1C0000000000001F.quest_subtitle: "Each breed hatches differently"
	quest.1C0000000000001F.quest_desc: [
		"Place the egg in the right conditions and wait a few minutes:"
		""
		"&cFire egg:&r set it on fire (it won't burn)."
		"&bIce egg:&r submerge it in water."
		"&eLightning egg:&r leave it out in the rain."
		""
		"The hatchling &eimprints on you&r automatically — congratulations, it's a dragon."
	]
	task.3C00000000000026.title: "Craft a Dragon Flute"
	quest.1C00000000000022.title: "Tame a Hippocampus"
	quest.1C00000000000022.quest_subtitle: "The sea horse"
	quest.1C00000000000022.quest_desc: [
		"&3Hippocampi&r swim the warm oceans. Tame with &ekelp&r, saddle up, and cross oceans faster than any boat."
	]
	task.3C0000000000002C.title: "Slay a Death Worm"
	task.3C00000000000028.title: "Craft Earplugs"
	task.3C00000000000016.title: "Obtain a Siren Tear"
	quest.1C00000000000023.title: "The Tide Trident"
	quest.1C00000000000023.quest_subtitle: "Serpent-forged"
	quest.1C00000000000023.quest_desc: [
		"Forge the &3Tide Trident&r from sea serpent fangs and scales — stronger than a vanilla trident, and it never needs Riptide to come back."
	]
	task.6B00000000000002.title: "Enter the Undergarden"
	task.6B00000000000003.title: "Mine 32 Depthrock"
	task.6B0000000000000D.title: "Discover a Depleted Mine"
	task.6B0000000000000E.title: "Find a Denizen Camp"
	task.6B00000000000008.title: "Smelt 3 Cloggrum Ingots"
	task.6B00000000000009.title: "Smelt 3 Froststeel Ingots"
	task.6B00000000000012.title: "Slay 3 Brutes"
	task.6B00000000000013.title: "Slay a Rotbeast"
	task.6B0000000000000B.title: "Discover the Catacombs"
	task.6B0000000000000C.title: "Slay the Forgotten Guardian"
	task.0F00000000000002.title: "Visit a village"
	task.0F00000000000003.title: "Find a Pillager Outpost"
	task.0F0000000000000C.title: "Find a Cartographer's Tower"
	task.0F00000000000004.title: "Discover a Castle Ruin"
	task.0F00000000000005.title: "Discover a Castle"
	task.0F00000000000006.title: "Find a Witch Hut"
	task.0F00000000000007.title: "Enter the Redwoods"
	task.0F00000000000008.title: "Enter the Bayou"
	task.0F0000000000000D.title: "Enter the Rainforest"
	task.0F00000000000020.title: "Find the Cathedral"
	task.0F00000000000023.title: "Find the Marble Chateau"
	task.0F00000000000025.title: "Find the Dark Tower"
	task.0F00000000000027.title: "Enter a Baobab Savanna"
	task.0F00000000000029.title: "Enter an Autumnal Maple Forest"
	task.0F0000000000002B.title: "Enter a Eucalyptus Forest"
	chapter.60DE000000000004.title: "Busy Bees"
	chapter.60DE000000000004.chapter_subtitle: [
		"Hundreds of specialized bees that gather metals, gems and magic while you rule."
	]
	quest.4E00000000000001.title: "Beekeeping 101"
	quest.4E00000000000001.quest_subtitle: "The heart of the hive"
	quest.4E00000000000001.quest_desc: [
		"&6Productive Bees&r turns vanilla's one bee into hundreds of specialized breeds that gather metals, gems, and magic while you sleep."
		"Everything branches out from here: catch wild bees, house them, harvest their combs, and breed them stronger. Follow any arm of the web."
		"&eStart by crafting an Advanced Beehive.&r"
	]
	task.4F00000000000001.title: "Obtain Beekeeping 101"
	quest.4E00000000000002.title: "Nest Locator"
	quest.4E00000000000002.quest_subtitle: "Point the way"
	quest.4E00000000000002.quest_desc: [
		"The &6Nest Locator&r sniffs out wild bee nests nearby. Right-click to ping the closest one."
		"Wild nests hide in trees, caves and biomes all over — each holds a different bee."
	]
	task.4F00000000000002.title: "Obtain Nest Locator"
	quest.4E00000000000003.title: "Bee Cage"
	quest.4E00000000000003.quest_subtitle: "Catch and carry"
	quest.4E00000000000003.quest_desc: [
		"A &6Bee Cage&r scoops a bee out of its nest or hive so you can carry it home."
		"Right-click a bee to cage it, right-click a hive to release it inside."
	]
	task.4F00000000000003.title: "Obtain Bee Cage"
	quest.4E00000000000004.title: "Sturdy Bee Cage"
	quest.4E00000000000004.quest_subtitle: "Reusable capture"
	quest.4E00000000000004.quest_desc: [
		"The &6Sturdy Bee Cage&r works like the paper one but doesn't break, so you can relocate bees again and again."
	]
	task.4F00000000000004.title: "Obtain Sturdy Bee Cage"
	quest.4E00000000000005.title: "Bee Jar"
	quest.4E00000000000005.quest_subtitle: "Show them off"
	quest.4E00000000000005.quest_desc: [
		"A &6Bee Jar&r displays a captured bee on a shelf — handy for storing a breed you're not using without losing it."
	]
	task.4F00000000000005.title: "Obtain Bee Jar"
	quest.4E00000000000007.title: "Expansion Box"
	quest.4E00000000000007.quest_subtitle: "Room to grow"
	quest.4E00000000000007.quest_desc: [
		"Stack an &6Expansion Box&r on top of a hive to add slots — more bees and more comb storage in the same footprint."
	]
	task.4F00000000000007.title: "Obtain Expansion Box"
	quest.4E00000000000008.title: "Canvas Hive"
	quest.4E00000000000008.quest_subtitle: "Any wood, any look"
	quest.4E00000000000008.quest_desc: [
		"A &6Canvas Hive&r can be painted to match any wood or block — pure decoration, works exactly like an Advanced Beehive."
	]
	task.4F00000000000008.title: "Obtain Canvas Hive"
	quest.4E00000000000009.title: "Feeding Slab"
	quest.4E00000000000009.quest_subtitle: "Keep them fed"
	quest.4E00000000000009.quest_desc: [
		"Place a &6Feeding Slab&r under a hive and fill it with flowers or plants so your bees keep producing even without a garden nearby."
	]
	task.4F00000000000009.title: "Obtain Feeding Slab"
	quest.4E0000000000000A.title: "Centrifuge"
	quest.4E0000000000000A.quest_subtitle: "Crack the combs"
	quest.4E0000000000000A.quest_desc: [
		"The &6Centrifuge&r spins honeycombs apart into their raw drops — honey, wax, and whatever that bee specializes in (nuggets, dusts, gems)."
		"Hand-cranked to start; every bee's comb goes here first."
	]
	task.4F0000000000000A.title: "Obtain Centrifuge"
	quest.4E0000000000000B.title: "Bottler"
	quest.4E0000000000000B.quest_subtitle: "Bottle the honey"
	quest.4E0000000000000B.quest_desc: [
		"The &6Bottler&r fills empty bottles from honey stored in an adjacent hive or tank — automated honey bottles without right-clicking hives by hand."
	]
	task.4F0000000000000B.title: "Obtain Bottler"
	quest.4E0000000000000C.title: "Heated Centrifuge"
	quest.4E0000000000000C.quest_subtitle: "Faster, hands-free"
	quest.4E0000000000000C.quest_desc: [
		"The &6Heated Centrifuge&r runs on furnace fuel instead of muscle — feed it coal and it processes combs on its own."
	]
	task.4F0000000000000C.title: "Obtain Heated Centrifuge"
	quest.4E0000000000000D.title: "Powered Centrifuge"
	quest.4E0000000000000D.quest_subtitle: "Full automation"
	quest.4E0000000000000D.quest_desc: [
		"The &6Powered Centrifuge&r takes Forge Energy and processes combs at full speed — the endgame of honey extraction."
	]
	task.4F0000000000000D.title: "Obtain Powered Centrifuge"
	quest.4E0000000000000F.title: "Honey Treat"
	quest.4E0000000000000F.quest_subtitle: "Bee food and bribery"
	quest.4E0000000000000F.quest_desc: [
		"A &6Honey Treat&r feeds bees to trigger breeding and is the currency for the machines below. Craft a stack — you'll use plenty."
		"&eThe gateway to genetics.&r"
	]
	task.4F0000000000000F.title: "Obtain Honey Treat"
	quest.4E00000000000010.title: "Breeding Chamber"
	quest.4E00000000000010.quest_subtitle: "Make new breeds"
	quest.4E00000000000010.quest_desc: [
		"Drop two bees and Honey Treats into the &6Breeding Chamber&r to breed them. Combining the right pair unlocks new specialized bees (metals, gems, essences)."
	]
	task.4F00000000000010.title: "Obtain Breeding Chamber"
	quest.4E00000000000011.title: "BaBee Incubator"
	quest.4E00000000000011.quest_subtitle: "Hatch the young"
	quest.4E00000000000011.quest_desc: [
		"The &6BaBee Incubator&r raises baby bees to adults quickly and can copy genes onto them — the fast lane to a full apiary."
	]
	task.4F00000000000011.title: "Obtain BaBee Incubator"
	quest.4E00000000000012.title: "Gene Indexer"
	quest.4E00000000000012.quest_subtitle: "Read the DNA"
	quest.4E00000000000012.quest_desc: [
		"The &6Gene Indexer&r pulls genes out of a bee and stores them — productivity, temper, endurance, weather and behavior all live in the DNA."
	]
	task.4F00000000000012.title: "Obtain Gene Indexer"
	quest.4E00000000000013.title: "Squashed Bee Material"
	quest.4E00000000000013.quest_subtitle: "Bottled genetics"
	quest.4E00000000000013.quest_desc: [
		"&6Squashed Bee Material&r is what a bee leaves behind when you kill it — the raw stock for genetics."
		"Run it through a &6Centrifuge&r to separate out a &6Gene Sample&r, then use the Gene Indexer to read it and a Honey Treat to splice that trait into another bee."
		"&7This is how you build the perfect fast, calm, tireless bee.&r"
	]
	task.4F00000000000013.title: "Obtain Squashed Bee Material"
	quest.4E00000000000014.title: "Treat on a Stick"
	quest.4E00000000000014.quest_subtitle: "Lead them around"
	quest.4E00000000000014.quest_desc: [
		"A &6Treat on a Stick&r lures bees to follow you — herd a loose bee back to its hive without caging it."
	]
	task.4F00000000000014.title: "Obtain Treat on a Stick"
	quest.4E00000000000015.title: "Nether Gold Nest"
	quest.4E00000000000015.quest_subtitle: "Bees of the Nether"
	quest.4E00000000000015.quest_desc: [
		"Every biome hides its own wild nest, and each holds a different breed of bee. The &6Nether Gold Nest&r spawns gold-gathering bees — bring a Sturdy Cage and fire resistance."
		"&7Find and break nests to collect the whole roster of bees.&r"
	]
	task.4F00000000000015.title: "Obtain Nether Gold Nest"
	quest.4E00000000000016.title: "Quartz Nest"
	quest.4E00000000000016.quest_subtitle: "Rarer still"
	quest.4E00000000000016.quest_desc: [
		"The &6Quartz Nest&r houses bees that produce Nether Quartz. Rare nests like these are how you find the exotic breeds worth breeding for."
	]
	task.4F00000000000016.title: "Obtain Quartz Nest"
	quest.4E00000000000019.title: "Oak Nest"
	quest.4E00000000000019.quest_subtitle: "Where it all starts"
	quest.4E00000000000019.quest_desc: [
		"The common &6Oak Nest&r hangs in ordinary forests and holds your first wild bees."
		"&7A gentle introduction to nest hunting.&r"
	]
	task.4F00000000000019.title: "Obtain Oak Nest"
	quest.4E0000000000001A.title: "Stone Nest"
	quest.4E0000000000001A.quest_subtitle: "Dug from the hills"
	quest.4E0000000000001A.quest_desc: [
		"The &6Stone Nest&r is found among rocky outcrops and caves, home to stone-dwelling bees."
	]
	task.4F0000000000001A.title: "Obtain Stone Nest"
	quest.4E0000000000001B.title: "Sand Nest"
	quest.4E0000000000001B.quest_subtitle: "Desert dwellers"
	quest.4E0000000000001B.quest_desc: [
		"The &6Sand Nest&r turns up in deserts and beaches, sheltering bees suited to the heat."
	]
	task.4F0000000000001B.title: "Obtain Sand Nest"
	quest.4E0000000000001C.title: "Reed Nest"
	quest.4E0000000000001C.quest_subtitle: "By the water's edge"
	quest.4E0000000000001C.quest_desc: [
		"The &6Reed Nest&r grows among sugar cane along rivers and swamps."
	]
	task.4F0000000000001C.title: "Obtain Reed Nest"
	quest.4E0000000000001D.title: "Glowstone Nest"
	quest.4E0000000000001D.quest_subtitle: "Lights of the Nether"
	quest.4E0000000000001D.quest_desc: [
		"The &6Glowstone Nest&r clings to Nether ceilings and holds bees that gather glowstone."
	]
	task.4F0000000000001D.title: "Obtain Glowstone Nest"
	quest.4E0000000000001E.title: "Soul Sand Nest"
	quest.4E0000000000001E.quest_subtitle: "From the soul valleys"
	quest.4E0000000000001E.quest_desc: [
		"The &6Soul Sand Nest&r is buried in soul sand valleys, home to eerie soul-touched bees."
	]
	task.4F0000000000001E.title: "Obtain Soul Sand Nest"
	quest.4E00000000000017.title: "The Catcher"
	quest.4E00000000000017.quest_subtitle: "Automatic capture"
	quest.4E00000000000017.quest_desc: [
		"The &6Catcher&r automatically bags bees that wander into range and outputs them as caged bees — set-and-forget wild collection."
	]
	task.4F00000000000017.title: "Obtain The Catcher"
	quest.4E00000000000018.title: "Master Apiarist"
	quest.4E00000000000018.quest_subtitle: "The hive runs itself"
	quest.4E00000000000018.quest_desc: [
		"With a powered centrifuge cracking combs and bred bees filling your hives, one machine closes the loop: the &6Honey Generator&r burns honey for Forge Energy, powering the whole operation off its own bees."
		"Craft a Honey Generator to run a self-sustaining apiary."
		"&aReward: a land claim and a pick from Kingdom Loot.&r"
	]
	task.4F00000000000018.title: "Craft a Honey Generator"
	chapter.7BEAB90AA8BC0395.title: "Hearth and Harvest"
	chapter.7BEAB90AA8BC0395.chapter_subtitle: [
		"Farm, cook and make wine — the good life with Farmer's Delight and Vinery."
	]
	quest.4C00000000000001.title: "The Kitchen Opens"
	quest.4C00000000000001.quest_subtitle: "Where every meal begins"
	quest.4C00000000000001.quest_desc: [
		"&6Farmer's Delight&r turns bland eating into real cooking. Start with a &6Cutting Board&r: place it and use a knife on it to slice logs into planks, carve meat, and prep ingredients."
		"Everything else branches out from here — the farm that feeds you, the dishes you cook, and the vineyard that keeps your cup full."
		"&eSlice something on a cutting board to begin.&r"
	]
	task.6C00000000000001.title: "Obtain The Kitchen Opens"
	quest.4C00000000000002.title: "The Cooking Pot"
	quest.4C00000000000002.quest_subtitle: "Soups, stews and stocks"
	quest.4C00000000000002.quest_desc: [
		"The &6Cooking Pot&r sits on a heat source and simmers ingredients into hearty soups and stews."
		"Drop in ingredients + a container (bowl), give it heat, and it cooks over time."
		"&7Most of the best foods in the pack come out of this pot.&r"
	]
	task.6C00000000000002.title: "Obtain The Cooking Pot"
	quest.4C00000000000003.title: "The Skillet"
	quest.4C00000000000003.quest_subtitle: "Fry it fast"
	quest.4C00000000000003.quest_desc: [
		"The &6Skillet&r pan-fries food quickly over a heat source — and you can even carry it to cook on the go. Great for eggs, meat cuts and quick meals."
	]
	task.6C00000000000003.title: "Obtain The Skillet"
	quest.4C00000000000004.title: "The Stove"
	quest.4C00000000000004.quest_subtitle: "A proper cooktop"
	quest.4C00000000000004.quest_desc: [
		"The &6Stove&r is a dedicated heat block: put skillets on top, or feed it fuel to passively cook food items placed on it. The heart of a working kitchen."
	]
	task.6C00000000000004.title: "Obtain The Stove"
	quest.4C00000000000005.title: "The Feast"
	quest.4C00000000000005.quest_subtitle: "A meal made from your own fields and vines"
	quest.4C00000000000005.quest_desc: [
		"A &6Stuffed Pumpkin&r is Farmer's Delight's grandest dish — a whole pumpkin packed with cooked crops from your farm."
		"Pair it with a bottle of &6Red Wine&r, pressed and fermented from your vineyard grapes."
		"&eCraft a Stuffed Pumpkin and a Red Wine to finish Hearth and Harvest.&r"
	]
	task.6C00000000000005.title: "Craft a Stuffed Pumpkin"
	task.6C00000000000054.title: "Bottle a Red Wine"
	quest.4C00000000000006.title: "Rich Soil"
	quest.4C00000000000006.quest_subtitle: "Grow it faster"
	quest.4C00000000000006.quest_desc: [
		"&6Rich Soil&r makes crops grow faster and can be made with Organic Compost. The foundation of a productive Farmer's Delight garden."
	]
	task.6C00000000000006.title: "Obtain Rich Soil"
	quest.4C00000000000007.title: "Tomatoes"
	quest.4C00000000000007.quest_subtitle: "Vine to plate"
	quest.4C00000000000007.quest_desc: [
		"Plant &6Tomato&r seeds; mature vines keep producing. The base of sauces, soups and more."
	]
	task.6C00000000000007.title: "Obtain Tomatoes"
	quest.4C00000000000008.title: "Onions"
	quest.4C00000000000008.quest_subtitle: "Flavor everything"
	quest.4C00000000000008.quest_desc: [
		"&6Onions&r grow from a placed onion and flavor a huge range of dishes — keep a stock going."
	]
	task.6C00000000000008.title: "Obtain Onions"
	quest.4C00000000000009.title: "Cabbage"
	quest.4C00000000000009.quest_subtitle: "Leaves and rolls"
	quest.4C00000000000009.quest_desc: [
		"&6Cabbage&r gives leaves for salads and Cabbage Rolls — a cheap, filling early food crop."
	]
	task.6C00000000000009.title: "Obtain Cabbage"
	quest.4C0000000000000A.title: "Rice Paddies"
	quest.4C0000000000000A.quest_subtitle: "Grow in shallow water"
	quest.4C0000000000000A.quest_desc: [
		"&6Rice&r grows in shallow water and dries into panicles — the base of Cooked and Fried Rice dishes."
	]
	task.6C0000000000000A.title: "Obtain Rice Paddies"
	quest.4C0000000000000B.title: "A Good Knife"
	quest.4C0000000000000B.quest_subtitle: "The cook's tool"
	quest.4C0000000000000B.quest_desc: [
		"A &6Knife&r carves meat into cuts, slices produce and works the cutting board. Upgrade from flint to iron, gold, diamond or netherite for durability."
	]
	task.6C0000000000000B.title: "Obtain A Good Knife"
	quest.4C0000000000000C.title: "Vegetable Soup"
	quest.4C0000000000000C.quest_subtitle: "First pot meal"
	quest.4C0000000000000C.quest_desc: [
		"&6Vegetable Soup&r is an easy early cooking-pot dish from your own crops — filling and cheap."
	]
	task.6C0000000000000C.title: "Obtain Vegetable Soup"
	quest.4C0000000000000D.title: "Hearty Stews"
	quest.4C0000000000000D.quest_subtitle: "Meat in the pot"
	quest.4C0000000000000D.quest_desc: [
		"&6Beef Stew&r and its cousins pack serious hunger and saturation — the workhorse meals of a colony kitchen."
	]
	task.6C0000000000000D.title: "Obtain Hearty Stews"
	quest.4C0000000000000E.title: "Chicken Soup"
	quest.4C0000000000000E.quest_subtitle: "Comfort food"
	quest.4C0000000000000E.quest_desc: [
		"&6Chicken Soup&r restores hunger and grants a short regeneration — handy before a fight."
	]
	task.6C0000000000000E.title: "Obtain Chicken Soup"
	quest.4C0000000000000F.title: "Pies and Sweets"
	quest.4C0000000000000F.quest_subtitle: "Bake a treat"
	quest.4C0000000000000F.quest_desc: [
		"&6Apple Pie&r (and Chocolate/Sweet Berry pies) bake in whole slices — a shareable dessert to round out a feast."
	]
	task.6C0000000000000F.title: "Obtain Pies and Sweets"
	quest.4C00000000000010.title: "Plant a Vineyard"
	quest.4C00000000000010.quest_subtitle: "Grapes on the vine"
	quest.4C00000000000010.quest_desc: [
		"&5Let's Do Vinery&r adds grapes. Plant &6Red Grape Seeds&r beside a trellis and they climb into fruit-bearing vines — white varieties and biome grapes exist too."
		""
		"Seeds are crafted from grapes, so your first handful has to be picked off the wild vines that grow out in the world."
	]
	task.6C00000000000010.title: "Obtain Plant a Vineyard"
	quest.4C00000000000011.title: "Harvest Grapes"
	quest.4C00000000000011.quest_subtitle: "Red and white"
	quest.4C00000000000011.quest_desc: [
		"Harvest &6Red Grapes&r from mature vines. Grapes are the raw material for juice and wine."
	]
	task.6C00000000000011.title: "Obtain Harvest Grapes"
	quest.4C00000000000012.title: "White Grapes"
	quest.4C00000000000012.quest_subtitle: "For the finer wines"
	quest.4C00000000000012.quest_desc: [
		"&6White Grapes&r grow from their own seeds and make lighter wines — collect both colors for variety."
	]
	task.6C00000000000012.title: "Obtain White Grapes"
	quest.4C00000000000013.title: "Grape Juice"
	quest.4C00000000000013.quest_subtitle: "Press before you ferment"
	quest.4C00000000000013.quest_desc: [
		"Stomp or press grapes into &6Grapejuice&r — drinkable on its own, or the first step toward wine in the barrel."
	]
	task.6C00000000000013.title: "Obtain Grape Juice"
	quest.4C00000000000014.title: "The Apple Press"
	quest.4C00000000000014.quest_subtitle: "Cider and juice"
	quest.4C00000000000014.quest_desc: [
		"The &6Apple Press&r squeezes apples into &6Apple Juice&r and, left to ferment, &6Cider&r — the simplest drink to start with."
	]
	task.6C00000000000014.title: "Obtain The Apple Press"
	quest.4C00000000000015.title: "Fermentation Barrel"
	quest.4C00000000000015.quest_subtitle: "Turn juice to wine"
	quest.4C00000000000015.quest_desc: [
		"The &6Fermentation Barrel&r ages grapejuice into wine over time. Different grapes and woods yield different vintages."
	]
	task.6C00000000000015.title: "Obtain Fermentation Barrel"
	quest.4C00000000000016.title: "The Wine Rack"
	quest.4C00000000000016.quest_subtitle: "Store your cellar"
	quest.4C00000000000016.quest_desc: [
		"A &6Wine Rack&r displays and stores your bottles — build a proper cellar as your vintages age."
	]
	task.6C00000000000016.title: "Obtain The Wine Rack"
	quest.4C00000000000017.title: "A Fine Vintage"
	quest.4C00000000000017.quest_subtitle: "Drink of kings"
	quest.4C00000000000017.quest_desc: [
		"Bottled wines like &6Cherry Wine&r give strong food + effect bonuses. Toast your thriving colony."
	]
	task.6C00000000000017.title: "Obtain A Fine Vintage"
	quest.4C00000000000018.title: "Cider"
	quest.4C00000000000018.quest_subtitle: "Everyday drink"
	quest.4C00000000000018.quest_desc: [
		"&6Cider&r is the quick, cheap fermented drink — a mug for the working folk of the colony."
	]
	task.6C00000000000018.title: "Obtain Cider"
	chapter.20DE000000000001.title: "Armies of the Realm"
	chapter.20DE000000000001.chapter_subtitle: [
		"Build a war economy and lead a commanded army with Hundred Years Warfare - workers, soldiers, guns, siege and guarded convoys."
	]
	quest.2000000000000001.title: "The Conqueror's Manual"
	quest.2000000000000001.quest_subtitle: "Hundred Years Warfare"
	quest.2000000000000001.quest_desc: [
		"&6Hundred Years Warfare&r lets you build a war economy and lead a commanded army - worker NPCs, soldiers, siege engines and guarded convoys."
		"Craft the &6Conqueror's Manual&r first: it is the mod's built-in tutorial and explains recruiting, commands and every station in detail."
		"&eThis chapter is the guided tour; the Manual has the fine print.&r"
	]
	task.2100000000000001.title: "The Conqueror's Manual"
	quest.2000000000000002.title: "Crafting Workstation"
	quest.2000000000000002.quest_subtitle: "Where work happens"
	quest.2000000000000002.quest_desc: [
		"Place a &6Crafting Workstation&r, then summon a &6Craftsman&r worker to run it (see Workers). Stations do nothing until a matching worker is assigned; more workers make them faster."
	]
	task.2100000000000002.title: "Crafting Workstation"
	quest.2000000000000003.title: "The Warehouse"
	quest.2000000000000003.quest_subtitle: "Central stores"
	quest.2000000000000003.quest_desc: [
		"&6Warehouse Control&r anchors a shared stockpile. Your workers deposit here and your soldiers and stations draw from it - the hub of your whole operation."
	]
	task.2100000000000003.title: "The Warehouse"
	quest.2000000000000004.title: "Supply Point"
	quest.2000000000000004.quest_subtitle: "Keep troops in the field"
	quest.2000000000000004.quest_desc: [
		"Soldiers need supply, drawn from you or a &6Supply Point&r. Build one near the front so your army does not go hungry far from home."
	]
	task.2100000000000004.title: "Supply Point"
	quest.2000000000000005.title: "Command Staff"
	quest.2000000000000005.quest_subtitle: "Give the orders"
	quest.2000000000000005.quest_desc: [
		"The &6Command Staff&r selects units and issues orders - move, hold, attack, form up. You can also hold the Command Wheel key for a quick panel, or enter RTS mode for full camera control."
	]
	task.2100000000000005.title: "Command Staff"
	quest.2000000000000007.title: "Farming Workstation"
	quest.2000000000000007.quest_subtitle: "Feed the army"
	quest.2000000000000007.quest_desc: [
		"Place a &6Farming Workstation&r and staff it with a Farmer - it grows the food your soldiers eat."
	]
	task.2100000000000007.title: "Farming Workstation"
	quest.2000000000000008.title: "Mining Workstation"
	quest.2000000000000008.quest_subtitle: "Dig the war chest"
	quest.2000000000000008.quest_desc: [
		"A &6Mining Workstation&r sets a Miner to pulling ore and stone - the raw wealth behind every weapon."
	]
	task.2100000000000008.title: "Mining Workstation"
	quest.2000000000000009.title: "Lumber Workstation"
	quest.2000000000000009.quest_subtitle: "Timber and shafts"
	quest.2000000000000009.quest_desc: [
		"A &6Lumber Workstation&r puts a Lumberjack to felling trees for building and tools."
	]
	task.2100000000000009.title: "Lumber Workstation"
	quest.200000000000000A.title: "Fishing Workstation"
	quest.200000000000000A.quest_subtitle: "Rations from the water"
	quest.200000000000000A.quest_desc: [
		"A &6Fishing Workstation&r works a nearby shore for a steady food supply."
	]
	task.210000000000000A.title: "Fishing Workstation"
	quest.200000000000000B.title: "Summon Workers"
	quest.200000000000000B.quest_subtitle: "Mercenary labor"
	quest.200000000000000B.quest_desc: [
		"Every workstation needs a worker. Summon them from &6worker scrolls&r - found in the recruitment list under the &6Mercenary&r race - like the &6Farmer Scroll&r. Right-click the scroll to summon the NPC, then assign it to a matching station."
		"This is how all your workshops get manned."
	]
	task.210000000000000B.title: "Summon Workers"
	quest.200000000000000C.title: "Warehouse Storage"
	quest.200000000000000C.quest_subtitle: "Grow the stockpile"
	quest.200000000000000C.quest_desc: [
		"&6Warehouse Storage&r blocks expand your warehouse so workers can deposit and withdraw far more goods."
	]
	task.210000000000000C.title: "Warehouse Storage"
	quest.200000000000000D.title: "Transport Workstation"
	quest.200000000000000D.quest_subtitle: "Move goods automatically"
	quest.200000000000000D.quest_desc: [
		"A &6Transport Workstation&r assigns a Porter to haul items between your stations on set routes (up to 50 blocks) - automation with no pipes. Set routes with a Transport Order."
	]
	task.210000000000000D.title: "Transport Workstation"
	quest.2000000000000018.title: "Supply Convoys"
	quest.2000000000000018.quest_subtitle: "Trade on the road"
	quest.2000000000000018.quest_desc: [
		"Build a &6Caravan Dock&r to run automated trade convoys between settlements. Load it with a wagon (see &6Storage and Travel&r) and post soldier scrolls in its chest as guards - the very troops you recruit here."
		"Convoys carry goods dock to dock and come back with profit."
	]
	task.2100000000000018.title: "Supply Convoys"
	quest.200000000000000E.title: "Recruit Militia"
	quest.200000000000000E.quest_subtitle: "Your first soldier"
	quest.200000000000000E.quest_desc: [
		"Militia are cheap spearmen and the backbone of an early army. Recruit them from the &6recruitment screen&r - hold the Command Wheel key and click Recruitment, or right-click the &6Conqueror's Staff&r. Pick a race, choose the unit and its level, and pay the XP and resource cost. You will hold a &6Scroll of Militia&r for the unit you raised."
	]
	task.210000000000000E.title: "Recruit Militia"
	quest.200000000000000F.title: "Recruit Archers"
	quest.200000000000000F.quest_subtitle: "Rain from range"
	quest.200000000000000F.quest_desc: [
		"&6Archers&r soften an enemy at distance before your footmen close in. Recruit them from the &6recruitment screen&r - hold the Command Wheel key and click Recruitment, or right-click the &6Conqueror's Staff&r. Pick a race, choose the unit and its level, and pay the XP and resource cost. Unit types counter each other, so mix your ranks."
	]
	task.210000000000000F.title: "Recruit Archers"
	quest.2000000000000010.title: "Recruit Cavalry"
	quest.2000000000000010.quest_subtitle: "Ride them down"
	quest.2000000000000010.quest_desc: [
		"Horsemen charge fast and run down routed foes - your hammer on open ground. Recruit them from the &6recruitment screen&r - hold the Command Wheel key and click Recruitment, or right-click the &6Conqueror's Staff&r. Pick a race, choose the unit and its level, and pay the XP and resource cost."
		""
		"The heavy mercenary horse is the &6Mounted Lancer&r. There are lighter riders too - Mounted Light Lancers and Mounted Archers - and each comes in numbered tiers that cost more but hit harder."
	]
	task.2100000000000010.title: "Recruit a Mounted Lancer"
	quest.2000000000000011.title: "Handgonne"
	quest.2000000000000011.quest_subtitle: "Early gunpowder"
	quest.2000000000000011.quest_desc: [
		"Craft a &6Handgonne&r - the first firearm. Loud, slow to load, and brutal at close range."
	]
	task.2100000000000011.title: "Handgonne"
	quest.2000000000000012.title: "Matchlock"
	quest.2000000000000012.quest_subtitle: "A steadier gun"
	quest.2000000000000012.quest_desc: [
		"The &6Matchlock&r is a more reliable firearm than the handgonne, with better range and punch."
	]
	task.2100000000000012.title: "Matchlock"
	quest.2000000000000013.title: "Cast Bullets"
	quest.2000000000000013.quest_subtitle: "Feed the guns"
	quest.2000000000000013.quest_desc: [
		"Craft &6Bullets&r - the ammunition your handgonnes and matchlocks burn through. Stock plenty before a battle."
	]
	task.2100000000000013.title: "Cast Bullets"
	quest.2000000000000014.title: "Cannon"
	quest.2000000000000014.quest_subtitle: "Field artillery"
	quest.2000000000000014.quest_desc: [
		"The &6Cannon&r hurls iron shot across the battlefield. Siege engines are raised from the recruitment screen just like soldiers - they simply cost more resources."
	]
	task.2100000000000014.title: "Cannon"
	quest.2000000000000015.title: "Bombard"
	quest.2000000000000015.quest_subtitle: "Crack the walls"
	quest.2000000000000015.quest_desc: [
		"A &6Bombard&r lobs heavy stone into fortifications. Recruit it from the recruitment screen when your war chest can afford it."
	]
	task.2100000000000015.title: "Bombard"
	quest.2000000000000016.title: "Great Bombard"
	quest.2000000000000016.quest_subtitle: "The siege breaker"
	quest.2000000000000016.quest_desc: [
		"The &6Great Bombard&r is the largest gun in the arsenal - nothing standing survives a direct hit. The pinnacle of your siege train."
	]
	task.2100000000000016.title: "Great Bombard"
	quest.2000000000000006.title: "The Conqueror's Staff"
	quest.2000000000000006.quest_subtitle: "Muster the host"
	quest.2000000000000006.quest_desc: [
		"The &6Conqueror's Staff&r is the master command tool: right-click it to open the &6recruitment screen&r and it directs your whole force at once."
		"With an economy running, soldiers in the ranks, guns and siege engines built, you command a true medieval army. Colony taxes from &6War and Taxes&r and your &6MineColonies&r settlement help pay the bills."
		"Craft the Conqueror's Staff to take the field as a warlord."
	]
	task.2100000000000006.title: "The Conqueror's Staff"
}
