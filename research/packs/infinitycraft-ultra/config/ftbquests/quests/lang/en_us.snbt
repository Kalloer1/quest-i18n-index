	file.0000000000000001.title: "InfinityCraft Ultra"
	quest.00170D6A6CB617E9.quest_desc: [
		"A &eRelay Crystal&r is four diamonds around a Wyvern Energy Controller. Shapeless-craft it for two &eI/O Crystals&r."
		""
		"Link crystals with the &eCrystal Binder&r to move power around without cables."
	]
	quest.00170D6A6CB617E9.quest_subtitle: "Wireless-ish power"
	quest.00170D6A6CB617E9.title: "Crystal Network"
	quest.003FEED99725AD25.quest_desc: [
		"A normal cable carries &e8 channels&r and every device uses one. &eSmart Cable&r shows them as coloured lines."
		""
		"Run out of channels and devices go dark."
	]
	quest.003FEED99725AD25.quest_subtitle: "Every device needs a lane"
	quest.003FEED99725AD25.title: "Cables and Channels"
	quest.005CCB02D3FB1D87.quest_desc: [
		"Build a Fluid Tank, put &eBlaze Burners&r under it, pump in water, and attach &eSteam Engines&r to its sides with a shaft in front."
		""
		"Look at the tank with goggles to see the boiler level and what's holding it back: heat, water, or size."
	]
	quest.005CCB02D3FB1D87.quest_subtitle: "Serious stress capacity"
	quest.005CCB02D3FB1D87.title: "Steam Power"
	quest.0070A268CA2BB7D9.quest_desc: [
		"Ride a train more than 5000 blocks from where you boarded, then step off."
		""
		"A real railway at last. Nice work, engineer!"
	]
	quest.0070A268CA2BB7D9.quest_subtitle: "A long ride home"
	quest.0070A268CA2BB7D9.title: "Field Trip"
	quest.0075419565B770D3.quest_desc: [
		"Put water on one side of a &eStone Block Generator&r and lava on the other. A modifier block changes what it makes."
		""
		"EMI's &eBlock Generator&r page lists every combination, including Ancient Stone."
	]
	quest.0075419565B770D3.quest_subtitle: "Cobblestone forever"
	quest.0075419565B770D3.title: "Block Generator"
	quest.007A48FFE48176AE.quest_desc: [
		"All four pieces. Once you wear the full set there isn't much left that can hurt you."
		""
		"Congratulations. This is as far as the numbers go."
	]
	quest.007A48FFE48176AE.quest_subtitle: "Actually infinite"
	quest.007A48FFE48176AE.title: "Infinity Armor"
	quest.008D669DAEDBAF47.quest_desc: [
		"Cast &eDispel&r on a Witch at half health or less to get a &eWixie Token&r."
		""
		"Charm it (sapling, emerald, crafting table, brewing stand) and use the charm on a Cauldron. Show the cauldron an item and the Wixie crafts it from nearby chests. It brews potions too."
	]
	quest.008D669DAEDBAF47.quest_subtitle: "Autocrafting, the witchy way"
	quest.008D669DAEDBAF47.title: "Wixie"
	quest.0094CABEBAC566BD.quest_desc: [
		"ICU's recipe: an Advanced Circuit, two Reinforced Alloy and an &eAllthemodium Ingot&r."
		"The Infuser shortcut is off."
	]
	quest.0094CABEBAC566BD.quest_subtitle: "Smarter machines"
	quest.0094CABEBAC566BD.title: "Elite Control Circuit"
	quest.009A9EC3B3884DED.quest_desc: [
		"Built in the Extreme table from Neutronium, Crystal Matrix, hoppers and redstone."
		""
		"Feed it a huge pile of one material and it slowly squeezes out a Singularity."
	]
	quest.009A9EC3B3884DED.quest_subtitle: "Thousands in, one out"
	quest.009A9EC3B3884DED.title: "Neutronium Compressor"
	quest.009C690EF42FFF8D.quest_desc: [
		"A &eFluid Hatch&r on a tank lets you right-click buckets and bottles straight into it (sneak to fill from it)."
		""
		"No more pipe spaghetti just to top up a tank by hand."
	]
	quest.009C690EF42FFF8D.quest_subtitle: "Create: Dragons Plus"
	quest.009C690EF42FFF8D.title: "Fluid Hatch"
	quest.00B032E31FD6B582.quest_desc: [
		"Helmet, chestplate, leggings, boots and gloves. Wear the set to jump much higher."
	]
	quest.00B032E31FD6B582.quest_subtitle: "Full gravitite set"
	quest.00B032E31FD6B582.title: "Defying Gravity"
	quest.00C2104C733B6DE8.quest_desc: [
		"Needs an &eUltimate Control Circuit&r. It dissolves ore in Sulfuric Acid into a dirty slurry."
		""
		"One ore block makes enough slurry for five crystals at the end of the line."
	]
	quest.00C2104C733B6DE8.quest_subtitle: "Ore soup"
	quest.00C2104C733B6DE8.title: "Chemical Dissolution Chamber"
	quest.0103A2623350F6EF.quest_desc: [
		"Craft any Offroad tire with a dye to color it. It works for small, normal, large and monstrous tires, and you can re-dye a colored tire."
		""
		"Tick this once your rover has a set of colored wheels."
	]
	quest.0103A2623350F6EF.quest_subtitle: "Match your paint job"
	quest.0103A2623350F6EF.title: "Colored Tires"
	quest.0108E4A57CB519DB.quest_desc: [
		"The same recipe with a different middle item makes the others:"
		"&eMycelial&r (mushroom stew) eats food, &eVitalic&r (glistering melon) feeds on mob deaths and breeding, &eAlchemical&r (brewing stand) drinks potions from nearby Potion Jars."
		""
		"Mix and match. More links near the same jars means more Source."
	]
	quest.0108E4A57CB519DB.quest_subtitle: "Pick your flavor"
	quest.0108E4A57CB519DB.title: "More Sourcelinks"
	quest.010FB1A300BCB4BB.quest_desc: [
		"Three wool in a column. A &eSleeping Bag&r lets you skip the night on the road without resetting your spawn point."
		""
		"Craft it white first; you can dye it after."
	]
	quest.010FB1A300BCB4BB.quest_subtitle: "Camp anywhere"
	quest.010FB1A300BCB4BB.title: "Sleeping Bag"
	quest.012795CB35D0894A.quest_desc: [
		"Sticks, coal, a diamond and a gold ingot. The &eTorch Pet&r places torches for you, and can also set things on fire."
		""
		"Cave trips just got easier. It snacks on coal nuggets."
	]
	quest.012795CB35D0894A.quest_subtitle: "Never run out"
	quest.012795CB35D0894A.title: "Torch Pet"
	quest.01B01CFCE9D835A5.quest_desc: [
		"&eFluid Tanks&r stack into big multiblocks. They're also the body of a steam boiler, so you'll want plenty."
	]
	quest.01B01CFCE9D835A5.quest_subtitle: "Store the good stuff"
	quest.01B01CFCE9D835A5.title: "Fluid Tanks"
	quest.01C1730D7D63F187.quest_desc: [
		"Wrecked ships rest on the floor of deep oceans. Swim down and look around."
	]
	quest.01C1730D7D63F187.quest_subtitle: "Down with the ship"
	quest.01C1730D7D63F187.title: "A Sunken Ship"
	quest.01F884998F63A3F0.quest_desc: [
		"An &eAwakening Altar&r (Soulstone, orange wool, gold), four Infusion Pedestals and four &eEssence Vessels&r."
		""
		"Vessels hold the four elemental essences, up to 40 each."
	]
	quest.01F884998F63A3F0.quest_subtitle: "The last altar"
	quest.01F884998F63A3F0.title: "Awakening Altar"
	quest.0212687C45AC6955.quest_desc: [
		"Mix copper and zinc in a &eheated&r Basin. That means a Blaze Burner underneath, so go bother some blazes."
	]
	quest.0212687C45AC6955.quest_subtitle: "Things are heating up"
	quest.0212687C45AC6955.title: "Brass"
	quest.02418FE4309E0906.quest_desc: [
		"The same upgrade for the chestpiece. With good shield modules you'll shrug off most bosses."
	]
	quest.02418FE4309E0906.quest_subtitle: "Nearly untouchable"
	quest.02418FE4309E0906.title: "Draconic Armor"
	quest.02592C958F60087D.quest_desc: [
		"A Void Thorn, an ender pearl and Ancient Anima. It never runs out, and you get a moment of resistance after each teleport."
	]
	quest.02592C958F60087D.quest_subtitle: "Reusable teleports"
	quest.02592C958F60087D.title: "Charged Ender Pearl"
	quest.02677AB356916F3C.quest_desc: [
		"Mix &eHydrogen&r and &eChlorine&r in a &eChemical Infuser&r to make Hydrogen Chloride."
		""
		"Chlorine comes from splitting brine in the Electrolytic Separator. Brine comes from a Thermal Evaporation tower (see the Generators chapter)."
	]
	quest.02677AB356916F3C.quest_subtitle: "The 4x ingredient"
	quest.02677AB356916F3C.title: "Hydrogen Chloride"
	quest.02B67E92947BA898.quest_desc: [
		"Diamond Lattices and Nether Stars make Crystal Matrix Ingots. You'll want plenty."
	]
	quest.02B67E92947BA898.quest_subtitle: "Diamonds, but more"
	quest.02B67E92947BA898.title: "Crystal Matrix"
	quest.02E20E782125A681.quest_desc: [
		"Upgrade your Draconic tools and armor with Chaotic Cores and a &eChaotic Energy Controller&r."
		""
		"You'll want &eChaotic injectors&r for this. Check EMI for the exact ingredients."
	]
	quest.02E20E782125A681.quest_subtitle: "The top of Draconic"
	quest.02E20E782125A681.title: "Chaotic Gear"
	quest.03485C396C149891.quest_desc: [
		"Draconic Additions adds a modular &eWyvern Necklace&r: gold ingots and a Wyvern Core."
		""
		"It sits in a Curios slot and takes Draconic modules like your armor does."
	]
	quest.03485C396C149891.quest_subtitle: "Draconic Additions"
	quest.03485C396C149891.title: "Wyvern Necklace"
	quest.036EEABEC1EA4C9E.quest_desc: [
		"These cards go in a wireless terminal. The &eImport Card&r sends chosen items from your inventory into the network; the &eExport Card&r keeps items topped up in your inventory."
	]
	quest.036EEABEC1EA4C9E.quest_subtitle: "Terminal upgrades"
	quest.036EEABEC1EA4C9E.title: "Import and Export Cards"
	quest.0377FB0CE8B379BE.quest_desc: [
		"Towerwood Borers in the Dark Tower drop &eBorer Essence&r. Four of it, four redstone and a ghast tear make &eCarminite&r."
		""
		"Carminite powers the tower's devices, like the Carminite Reactor and Builder."
	]
	quest.0377FB0CE8B379BE.quest_subtitle: "Red and restless"
	quest.0377FB0CE8B379BE.title: "Carminite"
	quest.03939EA5B6CAF260.quest_desc: [
		"A &eMagnet&r needs cobblestone, iron, blue dye, redstone and a chorus fruit, so it waits for the End."
		""
		"Powered with redstone, it pushes or pulls blocks made of iron or copper, depending on its side. A moving stonecutter even cuts the block above it."
	]
	quest.03939EA5B6CAF260.quest_subtitle: "Push and pull"
	quest.03939EA5B6CAF260.title: "Magnets"
	quest.042D42646CA8CE9A.quest_desc: [
		"&eDead&r trees stand in the Dead Forest, the Wasteland and the Muskeg. The Mystic Grove grows &eMagic&r trees, and the gloomy Ominous Woods hide &eUmbran&r trees."
		""
		"Great wood for a spooky build."
	]
	quest.042D42646CA8CE9A.quest_subtitle: "Dead, magic and umbran"
	quest.042D42646CA8CE9A.title: "Strange Woods"
	quest.043B0D5C92EE0313.quest_desc: [
		"Four echo shards, two sculk, a &eSculk Shrieker&r and a &eVibranium Ingot&r around a Double Compressed table."
		""
		"Your first shrieker has to come from the world: break one in the Deep Dark or an Ancient City with a &eSilk Touch&r tool. Without Silk Touch it drops nothing."
		""
		"Avaritia's tables come in tiers: Sculk, Nether, End and Extreme. Each one can make the recipes of the tier it belongs to."
	]
	quest.043B0D5C92EE0313.quest_subtitle: "The 3x3 table"
	quest.043B0D5C92EE0313.title: "Sculk Crafting Table"
	quest.044853C73573902C.quest_desc: [
		"Silver Dungeons float in the clouds. Valkyries drop &eVictory Medals&r; bring them to the Queen to prove you're worthy."
		""
		"Beat the &eValkyrie Queen&r."
	]
	quest.044853C73573902C.quest_subtitle: "Dethroned"
	quest.044853C73573902C.title: "The Silver Dungeon"
	quest.045DD56B75433051.quest_desc: [
		"An &eOverstress Clutch&r uncouples when the network is overstressed (wrench it to reset)."
		"A &eCentrifugal Clutch&r only couples above a set speed."
		""
		"Handy safety valves for big factories."
	]
	quest.045DD56B75433051.quest_subtitle: "Protect your network"
	quest.045DD56B75433051.title: "Smart Clutches"
	quest.04B53327F9ACB9F3.quest_desc: [
		"Down here you can catch the &eUtheric Infection&r. Eating &eRogdorium&r from the Depths holds it back."
	]
	quest.04B53327F9ACB9F3.quest_subtitle: "The Utheric Infection"
	quest.04B53327F9ACB9F3.title: "An Antidote"
	quest.04EC379997A3493F.quest_desc: [
		"Cut copper plates with &eWire Cutters&r for copper wire, then wrap it around a stick for an &eLV Wire Coil&r."
		""
		"Place &eLV Connectors&r, then right-click one and then the next with the coil to string a wire."
	]
	quest.04EC379997A3493F.quest_subtitle: "Power on a string"
	quest.04EC379997A3493F.title: "LV Wiring"
	quest.04EDA1D74C837B24.quest_desc: [
		"Fuse a diamond tool with a Draconium Core, Draconium ingots, two relay crystals and a Wyvern Energy Controller."
		""
		"They run on power, not durability. Charge them and fill their module grid."
		""
		"The Wyvern pickaxe mines like an &eAllthemodium pickaxe&r: Vibranium yes, Unobtainium needs a Vibranium pickaxe."
	]
	quest.04EDA1D74C837B24.quest_subtitle: "Your first real Draconic gear"
	quest.04EDA1D74C837B24.title: "Wyvern Tools"
	quest.04FF6082627C73C6.quest_desc: [
		"Some Mekanism builds want &6heat&r, not power: the Thermal Evaporation tower and the Thermoelectric Boiler."
		""
		"The &eFuelwood Heater&r burns furnace fuel. The &eResistive Heater&r turns power into heat."
	]
	quest.04FF6082627C73C6.quest_subtitle: "Heat is its own resource"
	quest.04FF6082627C73C6.title: "Heaters"
	quest.0504FFEF74440D3E.quest_desc: [
		"Four Prudentium around the crystal. Iron, redstone and glowstone crops are Tertium tier."
	]
	quest.0504FFEF74440D3E.quest_subtitle: "Tier 3 essence"
	quest.0504FFEF74440D3E.title: "Tertium"
	quest.05096D9381CCA898.quest_desc: [
		"The &eFusion Crafting Core&r (built around a Draconium Core) pulls items and energy from &einjectors&r pointed at it."
		""
		"Awakened Draconium is made this way."
	]
	quest.05096D9381CCA898.quest_subtitle: "Injectors around a core"
	quest.05096D9381CCA898.title: "Fusion Crafting"
	quest.0527352785CC18FC.quest_desc: [
		"Planks, a log, a diamond and a gold ingot. Right-click the &eCrafting Table Pet&r for a crafting grid anywhere."
	]
	quest.0527352785CC18FC.quest_subtitle: "A workbench to go"
	quest.0527352785CC18FC.title: "Crafting Table Pet"
	quest.052D668CCB1CFF3F.quest_desc: [
		"&6ICU recipe:&r a Blazing Crystal is four blaze powder (or one blaze rod) plus an &eAllthemodium Nugget&r, energized."
		""
		"Blazing crystals make Blazing capacitors, and those make every Blazing block."
	]
	quest.052D668CCB1CFF3F.quest_subtitle: "Allthemodium required"
	quest.052D668CCB1CFF3F.title: "Blazing Tier"
	quest.05599CA05D2C89DA.quest_desc: [
		"ICU has the &eSophisticated Backpacks Create Integration&r add-on."
		""
		"A placed backpack works as storage on moving Create contraptions, like a chest would. You can open it while it rides along."
	]
	quest.05599CA05D2C89DA.quest_subtitle: "Storage that rides along"
	quest.05599CA05D2C89DA.title: "Backpacks on Contraptions"
	quest.055F4CE06B54560A.quest_desc: [
		"The &eChemical Injection Chamber&r needs an &eElite Control Circuit&r. With Hydrogen Chloride, one ore makes four &eShards&r."
		""
		"Shards go into your Purification Chamber and follow the 3x line from there."
	]
	quest.055F4CE06B54560A.quest_subtitle: "Now with acid"
	quest.055F4CE06B54560A.title: "4x: Shards"
	quest.0581BAF51FE4AC0E.quest_desc: [
		"In the Inscriber: the Calculation Press on top, the Engineering Press on the bottom and a &eSingularity&r in the middle."
		""
		"Copy it later with an iron block, like the others."
	]
	quest.0581BAF51FE4AC0E.quest_subtitle: "A fifth press"
	quest.0581BAF51FE4AC0E.title: "Accumulation Press"
	quest.05D2E5B1967ACA74.quest_desc: [
		"Quests don't unlock anything. The recipes themselves are the gates, so you can play in any order you want."
		""
		"The book just shows you the quickest path up."
	]
	quest.05D2E5B1967ACA74.quest_subtitle: "Wander off whenever you like"
	quest.05D2E5B1967ACA74.title: "The Book Is a Guide, Not a Lock"
	quest.05E0843A654F9ACE.quest_desc: [
		"Make a &eVial of Consciousness&r from Ratlantean Spirit Flame and Feral Rat Claws, then throw it at a &eFeral Ratlantean&r."
	]
	quest.05E0843A654F9ACE.quest_subtitle: "A ghost of the old empire"
	quest.05E0843A654F9ACE.title: "The Neo-Ratlantean"
	quest.05E2813C3F2C2723.quest_desc: [
		"Sticks and a Twistytwig make a &eSlingshot&r. It fires Depthrock Pebbles, goo balls and even berries."
	]
	quest.05E2813C3F2C2723.quest_subtitle: "Your new best friend"
	quest.05E2813C3F2C2723.title: "Slingshot"
	quest.05F687666270083B.quest_desc: [
		"Same idea, but for fluids."
		""
		"With a &ePurple Laser Lens&r and a Wither in range, it makes &eEther Gas&r. The Supreme Frame needs 135 mB of it."
		""
		"The Wither has to stay alive inside the base's working area the whole time, so trap it before you start."
	]
	quest.05F687666270083B.quest_subtitle: "Pulling fluids from the void"
	quest.05F687666270083B.title: "Fluid Laser Base"
	quest.0600D9EC6416AC4F.quest_desc: [
		"The boss of the Bronze Dungeon. It drops the Bronze Key."
	]
	quest.0600D9EC6416AC4F.quest_subtitle: "The Aether"
	quest.0600D9EC6416AC4F.title: "The Slider"
	quest.0647084CB11F7A63.quest_desc: [
		"Cook a chicken egg (white, blue or brown) in a furnace, smoker or campfire for a &eFried Egg&r."
		""
		"Two eggs, milk and a bowl make &eScrambled Eggs&r. They heal you a heart when you eat them."
	]
	quest.0647084CB11F7A63.quest_subtitle: "Eggs, two ways"
	quest.0647084CB11F7A63.title: "Breakfast Time"
	quest.06671665AB193592.quest_desc: [
		"&ePenguins&r waddle around Snowy Plains, Frozen Oceans and Frozen Rivers. They love fish: cod, salmon or tropical fish."
		""
		"Breed two, and the baby drops a &ePenguin Feather&r. Brew it into an Awkward Potion for a &ePotion of Sliding&r: everything under you turns slippery as ice."
	]
	quest.06671665AB193592.quest_subtitle: "Penguins!"
	quest.06671665AB193592.title: "Happy Feet"
	quest.06C2C360958CB3B3.quest_desc: [
		"Collectors next to a &eRelay&r feed their EMC into it, and it passes the total on."
		""
		"Put a Condenser or a Klein Star next to it to collect."
	]
	quest.06C2C360958CB3B3.quest_subtitle: "Collectors, together"
	quest.06C2C360958CB3B3.title: "Anti-Matter Relay"
	quest.0725E6012330FBDF.quest_desc: [
		"The &ePattern Encoding Terminal&r turns a &eBlank Pattern&r into a recipe the network can repeat."
	]
	quest.0725E6012330FBDF.quest_subtitle: "Teach it a recipe"
	quest.0725E6012330FBDF.title: "Encoding Patterns"
	quest.07314736AD6ADF7C.quest_desc: [
		"Put the core in the middle and point injectors at it from a few blocks away, in straight lines."
		"Put the catalyst in the core and one ingredient in each injector, then power it up and press Craft."
		""
		"&6Heads up:&r the injectors must be at least the recipe's tier. The core's screen tells you when they are too close or too weak."
	]
	quest.07314736AD6ADF7C.quest_subtitle: "Read this before you waste a Wyvern Core"
	quest.07314736AD6ADF7C.title: "How Fusion Works"
	quest.07325E2024C69008.quest_desc: [
		"Frostmaw carries an &eIce Crystal&r. Hold right-click with it to channel an icy whirlwind."
		""
		"Sneaky players can steal it while Frostmaw sleeps..."
	]
	quest.07325E2024C69008.quest_subtitle: "Steal it or earn it"
	quest.07325E2024C69008.title: "Ice Crystal"
	quest.073E55C15865EFC8.quest_desc: [
		"The &eAncient Mines&r are dug into hills and mountains. They're big, so pack torches."
	]
	quest.073E55C15865EFC8.quest_subtitle: "Deep, dark and old"
	quest.073E55C15865EFC8.title: "Ancient Mines"
	quest.074738FF67C0A339.quest_desc: [
		"Each &eEnergy Storage Component&r is three of the tier below, a processor, Vibrant Quartz Glass and some dust."
		""
		"Climb from 1k all the way to 16M. Portable versions exist for every size, too."
	]
	quest.074738FF67C0A339.quest_subtitle: "Stack the storage"
	quest.074738FF67C0A339.title: "Bigger Energy Cells"
	quest.07508D6BF52D2F41.quest_desc: [
		"Eight quartz around any concrete make eight &eQuartz-Crete&r, a clean white building block with bricks, pillars, slabs, stairs and walls."
		""
		"Prefab's modern buildings are made from it."
	]
	quest.07508D6BF52D2F41.quest_subtitle: "Smooth and modern"
	quest.07508D6BF52D2F41.title: "Quartz-Crete"
	quest.0763BAEFD19537C7.quest_desc: [
		"Chests and drawers only get you so far. &eApplied Energistics 2&r stores everything in one searchable network."
		""
		"You built your first network in Tier 1. The AE2 chapter shows how to grow it."
	]
	quest.0763BAEFD19537C7.quest_subtitle: "A network for everything"
	quest.0763BAEFD19537C7.title: "The Real Endgame: AE2"
	quest.0767B4837AEA9B05.quest_desc: [
		"Perch and Pike swim in rivers and lakes. In the pot: raw perch, a Red Mushroom Colony, rice and a tomato."
	]
	quest.0767B4837AEA9B05.quest_subtitle: "Upgrade Aquatic's fish"
	quest.0767B4837AEA9B05.title: "Perch with Mushrooms"
	quest.07885506126144CD.quest_desc: [
		"She rules the Acropolis. Stormy weather ahead."
	]
	quest.07885506126144CD.quest_subtitle: "L_Ender's Cataclysm"
	quest.07885506126144CD.title: "Scylla"
	quest.079A35250E1B9488.quest_desc: [
		"Below Y 0, some tortoises carry ore on their backs. Hit an &eOretoise&r with a pickaxe to mine it."
		""
		"Feed it glow berries later and it may grow its ore back."
	]
	quest.079A35250E1B9488.quest_subtitle: "A tortoise made of ore"
	quest.079A35250E1B9488.title: "Mine Turtle!"
	quest.08147F5B8159081E.quest_desc: [
		"The &eCulinary Generator&r burns food. It leads on to the &eHoney&r and &ePotion&r generators."
		""
		"Nice for a farm that makes more food than you can eat."
	]
	quest.08147F5B8159081E.quest_subtitle: "Food into power"
	quest.08147F5B8159081E.title: "Culinary Generator"
	quest.08220C4A89480B73.quest_desc: [
		"An &eEmpty Fan Catalyst&r holds the stuff a fan blows through: water, lava, soul sand and more."
		""
		"The contents never spill or spread fire, so your processing line stays clean."
	]
	quest.08220C4A89480B73.quest_subtitle: "Neat and tidy processing"
	quest.08220C4A89480B73.title: "Fan Catalysts"
	quest.08365F21D40612E0.quest_desc: [
		"ICU includes &eWaystones: Sable&r. A waystone built into a Create Aeronautics ship still works while the ship flies."
		""
		"Travel to your airship from anywhere, wherever it is right now."
	]
	quest.08365F21D40612E0.quest_subtitle: "Take your waystone flying"
	quest.08365F21D40612E0.title: "Waystones on Ships"
	quest.08539337F0310F62.quest_desc: [
		"&eReinforced Blast Bricks&r are a blast brick plus a steel plate. The manual shows the shape."
		""
		"Bolt &eBlast Furnace Preheaters&r onto the sides and give them power to speed it up."
	]
	quest.08539337F0310F62.quest_subtitle: "Steel, faster"
	quest.08539337F0310F62.title: "Improved Blast Furnace"
	quest.0859292702DBBC76.quest_desc: [
		"Build a &eWireless Access Point&r and link a &eWireless Terminal&r to it in the slot on the access point."
		""
		"Wireless Boosters in the access point give it more range."
	]
	quest.0859292702DBBC76.quest_subtitle: "Storage in your pocket"
	quest.0859292702DBBC76.title: "Wireless Access"
	quest.085D60EDD3419B83.quest_desc: [
		"Iron and sticks make a &eHammer&r."
		""
		"Right-click (or sneak and right-click) Handcrafted furniture and trims with it to change their look or shape."
	]
	quest.085D60EDD3419B83.quest_subtitle: "Same block, new look"
	quest.085D60EDD3419B83.title: "Hammer"
	quest.088056A6E9284F2F.quest_desc: [
		"The Acropolis sits in warm oceans. Defeat one of the big crab-like &eClawdians&r while you're there."
	]
	quest.088056A6E9284F2F.quest_subtitle: "Out on warm seas"
	quest.088056A6E9284F2F.title: "The Acropolis"
	quest.088F078690605723.quest_desc: [
		"Put a Golden Sheet on a belt and send it past Deployers holding a cogwheel, a large cogwheel and an iron nugget, five times over."
		"A few come out as scrap. That's normal."
		""
		"&6Heads up:&r in ICU, Immersive Aircraft are built from Create parts. An aircraft &eEngine&r needs a Precision Mechanism, two Brass Sheets, two Sturdy Sheets and a &eBoiler&r (Steam Engine, Fluid Tank and Blaze Burner)."
		"Hulls use Andesite Casing, propellers use a Create Propeller, and the aircraft themselves are Mechanical Crafter recipes."
	]
	quest.088F078690605723.quest_subtitle: "Sequenced assembly"
	quest.088F078690605723.title: "Precision Mechanism"
	quest.08B532972E7E4623.quest_desc: [
		"Three wool over three wooden slabs make four &eStools&r. You can sit on them."
		""
		"Put a block on top of a stool and it turns into a little table."
	]
	quest.08B532972E7E4623.quest_subtitle: "Take a seat"
	quest.08B532972E7E4623.title: "Stools"
	quest.08BC40D3F468BC8F.quest_desc: [
		"Normal windmill sails make &elift&r when a ship moves fast. That's how you build a plane."
		"&eSymmetric Sails&r (two sails in a grid) only make &edrag&r. Angle them to steer or steady the ship."
	]
	quest.08BC40D3F468BC8F.quest_subtitle: "Wings and fins"
	quest.08BC40D3F468BC8F.title: "Symmetric Sails"
	quest.08CD7AF0473EE605.quest_desc: [
		"Source gems, gold and a lava bucket make a &eVolcanic Sourcelink&r. It burns fuel into Source for jars within 5 blocks."
		""
		"Archwood logs give bonus Source, Blazing Archwood most of all. &6Heads up:&r its heat slowly turns stone around it into magma, then lava."
	]
	quest.08CD7AF0473EE605.quest_subtitle: "Burn things, get Source"
	quest.08CD7AF0473EE605.title: "Volcanic Sourcelink"
	quest.08DDE55D1776BD10.quest_desc: [
		"Craft a &eTeleport Pad&r from Allthemodium nuggets and an ender pearl."
		""
		"Place it in the Overworld, then sneak and right-click it with empty hands."
	]
	quest.08DDE55D1776BD10.quest_subtitle: "A whole world of ore"
	quest.08DDE55D1776BD10.title: "The Mining Dimension"
	quest.0906C244D314B054.quest_desc: [
		"&eFusion Crafting&r at Draconic tier. The catalyst in the core is a &eDraconic Core&r (the Awakened Core from Tier 5)."
		""
		"The eight injectors hold two Ultimate Control Circuits, two Nitro Crystals, an Antimatter Pellet, a Nitro Capacitor, an Ultimate Induction Cell and an Awakened Draconium Block."
		""
		"The craft pulls &e64 million FE&r, so have a big battery ready."
	]
	quest.0906C244D314B054.quest_subtitle: "Three power mods, one fusion"
	quest.0906C244D314B054.title: "Dynamo Seal"
	quest.09441C18EC0E8A60.quest_desc: [
		"Inferium Essence, stone and an Inferium Gemstone make a &eGrowth Accelerator&r. Put it under the farmland."
		""
		"They stack: a column of accelerators all boosts the plant above, as long as it's in range."
	]
	quest.09441C18EC0E8A60.quest_subtitle: "Crops, but faster"
	quest.09441C18EC0E8A60.title: "Growth Accelerator"
	quest.0994F641898F4397.quest_desc: [
		"Put a mode like &eSphere&r or &eCube&r in the &eProjector&r, power it with Fortron, and watch the field go up."
		""
		"Modules change size, shape and what the field does."
	]
	quest.0994F641898F4397.quest_subtitle: "Your own shield dome"
	quest.0994F641898F4397.title: "Force Field Projector"
	quest.099E6F4DC8196927.quest_desc: [
		"ICU changes this one: &ethree&r Imperium Essence, an Infusion Crystal and a &eVibranium Nugget&r make one Supremium."
		""
		"So Tier 5 farming waits for Vibranium (Tier 4)."
	]
	quest.099E6F4DC8196927.quest_subtitle: "ICU recipe: Vibranium inside"
	quest.099E6F4DC8196927.title: "Supremium"
	quest.09A55272A1043E90.quest_desc: [
		"Aircraft have upgrade slots. Most upgrades are made from Create iron sheets:"
		"&eIndustrial Gears&r (a cogwheel), &eSturdy Pipes&r (a fluid pipe), &eSteel Boiler&r (a fluid tank), &eHull Reinforcement&r (a hull)."
		""
		"Hover over an upgrade to see which stats it changes."
	]
	quest.09A55272A1043E90.quest_subtitle: "Tune your ride"
	quest.09A55272A1043E90.title: "Aircraft Upgrades"
	quest.09B1566EA2DA2647.quest_desc: [
		"Four Tertium around the crystal. Gold, blaze and experience crops are Imperium tier."
	]
	quest.09B1566EA2DA2647.quest_subtitle: "Tier 4 essence"
	quest.09B1566EA2DA2647.title: "Imperium"
	quest.09C3777B3C8B581F.quest_desc: [
		"Energize an emerald with a &eVibranium Nugget&r."
	]
	quest.09C3777B3C8B581F.quest_subtitle: "Green and glowy"
	quest.09C3777B3C8B581F.title: "Spirited Crystal"
	quest.09E218F12D06FCDE.quest_desc: [
		"Smelt coal or charcoal (a Blast Furnace is twice as fast) to get &eGraphite Bars&r. Casings and fuel rods need them."
	]
	quest.09E218F12D06FCDE.quest_subtitle: "Cooked coal"
	quest.09E218F12D06FCDE.title: "Graphite"
	quest.09EA9D4A57F34BE4.quest_desc: [
		"&eHandcrafted&r adds proper furniture, &eMacaw's Fences and Walls&r adds fences and walls in every style, and &eGallery&r makes paintings easier to pick."
		""
		"None of it is required. All of it is nice."
	]
	quest.09EA9D4A57F34BE4.quest_subtitle: "Four walls aren't a home"
	quest.09EA9D4A57F34BE4.title: "Make It Cozy"
	quest.0A14A85803891F57.quest_desc: [
		"Step through the portal. Ratlantis is a whole dimension of marbled cheese ruins, ghost pirats and old Ratlantean machines."
		""
		"Bring food and armor. The locals are not friendly."
	]
	quest.0A14A85803891F57.quest_subtitle: "An empire lost"
	quest.0A14A85803891F57.title: "Ratlantis"
	quest.0A44702BA0535D2A.quest_desc: [
		"Energize two Blue Ice to make &eDry Ice&r. Your reactor will thank you."
	]
	quest.0A44702BA0535D2A.quest_subtitle: "The best coolant"
	quest.0A44702BA0535D2A.title: "Dry Ice"
	quest.0A47E84040E5B863.quest_desc: [
		"Upgrades give rats jobs: &eLumberjack&r chops trees, &ePlanter&r farms, and &ePlatter&r lets a rat carry a whole stack at once."
		""
		"Pair them with the Cheese Staff so the rat knows where to deliver."
	]
	quest.0A47E84040E5B863.quest_subtitle: "Lumberjacks, farmers and couriers"
	quest.0A47E84040E5B863.title: "Rat Workers"
	quest.0A4900F48B141845.quest_desc: [
		"The Nether table can craft &eEnd Portal Frames&r from end stone, end crystals, emeralds and Crystal Matrix."
		""
		"The End Crafting Table needs three."
	]
	quest.0A4900F48B141845.quest_subtitle: "Yes, you can craft them"
	quest.0A4900F48B141845.title: "End Portal Frames"
	quest.0A9194E16FBBC4F4.quest_desc: [
		"&eTrain Signals&r split the track into blocks. Only one train may be in a block at a time."
		""
		"Place one on each side of every junction and your trains will wait their turn."
	]
	quest.0A9194E16FBBC4F4.quest_subtitle: "No crashes, please"
	quest.0A9194E16FBBC4F4.title: "Signals"
	quest.0A9B0823CE733B02.quest_desc: [
		"Your Mage's book plus three ender pearls, two emeralds, a Totem of Undying, a &eNether Star&r and the &eWilden Tribute&r."
		""
		"Tier 3 glyphs are yours. The Nether Star means a Wither fight, so this one waits for Tier 4."
	]
	quest.0A9B0823CE733B02.quest_subtitle: "The best book there is"
	quest.0A9B0823CE733B02.title: "Archmage Spell Book"
	quest.0AA61AD2D03FA08D.quest_desc: [
		"A &eFlux Plug&r takes power in, a &eFlux Point&r sends it out. Put both on the same network in their screen."
		""
		"They work across any distance, even between dimensions."
	]
	quest.0AA61AD2D03FA08D.quest_subtitle: "Wireless power"
	quest.0AA61AD2D03FA08D.title: "Plugs and Points"
	quest.0AA6B5A3979FC493.quest_desc: [
		"ICU has &eAeroPortals&r. Fly a Simulated Contraption into a Nether portal and the whole ship goes through."
		""
		"Build the portal big enough for the ship!"
	]
	quest.0AA6B5A3979FC493.quest_subtitle: "Yes, really"
	quest.0AA6B5A3979FC493.title: "Ships Through Portals"
	quest.0B00FF0D0E50B737.quest_desc: [
		"A &eSharestone&r takes you to any other sharestone of the &esame color&r, no activating needed."
		""
		"Make a pair for a quick link between two bases. Mechanical Crafter: stone bricks, dye, a Warp Stone and obsidian."
	]
	quest.0B00FF0D0E50B737.quest_subtitle: "Color-coded networks"
	quest.0B00FF0D0E50B737.title: "Sharestones"
	quest.0B0B43CB33EEED21.quest_desc: [
		"The same smithing upgrade works on each piece of netherite armor."
	]
	quest.0B0B43CB33EEED21.quest_subtitle: "Top of Tier 3"
	quest.0B0B43CB33EEED21.title: "Allthemodium Armor"
	quest.0B19559E8C12CABE.quest_desc: [
		"ICU's recipe: an Elite Circuit, two Atomic Alloy and a &eVibranium Ingot&r. The Infuser shortcut is off."
	]
	quest.0B19559E8C12CABE.quest_subtitle: "The smartest circuit"
	quest.0B19559E8C12CABE.title: "Ultimate Control Circuit"
	quest.0B2424E41D069EA9.quest_desc: [
		"Craft an &eEmpty Blaze Burner&r and right-click a blaze (or a blaze spawner) with it to capture one."
		""
		"A few Blaze Rods never hurt either."
	]
	quest.0B2424E41D069EA9.quest_subtitle: "Politely"
	quest.0B2424E41D069EA9.title: "Catch a Blaze"
	quest.0B3F951D2B3A48C3.quest_desc: [
		"&6Tier 1&r is free: vanilla, Create, Powah, Immersive Engineering, AE2 and Ars Nouveau basics."
		"&6Tier 2&r opens Mekanism. It needs Create casings, and advanced circuits need a Twilight Forest &eFiery Ingot&r."
		"&6Tier 3&r needs &eAllthemodium&r, &eIgnitium&r and &eKnightmetal&r."
		"&6Tier 4&r needs &eVibranium&r, &eWitherite&r and &eNether Stars&r."
		"&6Tier 5&r needs &eUnobtainium&r and a &eDragon Heart&r."
	]
	quest.0B3F951D2B3A48C3.quest_subtitle: "Five tiers, one ladder"
	quest.0B3F951D2B3A48C3.title: "How Progression Works"
	quest.0B82F2A450263BEE.quest_desc: [
		"Somewhere in the snowy plains, the Frosted Prison holds &eMaledictus&r."
	]
	quest.0B82F2A450263BEE.quest_subtitle: "Jail of cold"
	quest.0B82F2A450263BEE.title: "The Frosted Prison"
	quest.0B8D6585A45C325F.quest_desc: [
		"&eInception&r lets you store backpacks inside your backpack, and their upgrades still work."
		"&eEverlasting&r makes the backpack impossible to destroy and keeps it when you die."
		""
		"Both need &eNether Stars&r."
	]
	quest.0B8D6585A45C325F.quest_subtitle: "Backpacks in backpacks"
	quest.0B8D6585A45C325F.title: "Inception and Everlasting"
	quest.0BACD5E40156A753.quest_desc: [
		"Put it all together: a ship with lift, thrust, steering and a name."
		""
		"Give it a &eNameplate&r, dock it at your base, and go see the world from above."
	]
	quest.0BACD5E40156A753.quest_subtitle: "Captain on deck"
	quest.0BACD5E40156A753.title: "Maiden Voyage"
	quest.0BE233612E1F9325.quest_desc: [
		"Dig a 2x2 pool of water, ring it with flowers or grass, and toss in a diamond. Then jump in!"
	]
	quest.0BE233612E1F9325.quest_subtitle: "Pack a lunch"
	quest.0BE233612E1F9325.title: "Into the Twilight"
	quest.0C04C9DB239D5F5B.quest_desc: [
		"The &eWarp Stone&r is amethyst, ender pearls and an emerald. Hold right-click to open the waystone menu from anywhere."
		"&eWarp Dust&r is an ender pearl and an amethyst shard."
	]
	quest.0C04C9DB239D5F5B.quest_subtitle: "The magic ingredients"
	quest.0C04C9DB239D5F5B.title: "Warp Stone and Warp Dust"
	quest.0C149ADF2442F174.quest_desc: [
		"Below Y 0 you might spot a little stone creature carrying an item. That's a &eStoneling&r."
		""
		"Sneak up on it (or tempt it with a &eGlow Shroom&r) and break its shell for its &eHeart of Diamond&r. Don't worry, it's fine!"
		""
		"Use a Heart on plain stone and the Stoneling builds itself a new body."
	]
	quest.0C149ADF2442F174.quest_subtitle: "Stonelings are shy"
	quest.0C149ADF2442F174.title: "Heart of Diamond"
	quest.0C2A56C3E83B8985.quest_desc: [
		"Coal nuggets, raw meat or fish, a diamond and a gold ingot. The &eSpider Pet&r gives jump boost and lets you climb walls."
	]
	quest.0C2A56C3E83B8985.quest_subtitle: "Up the walls"
	quest.0C2A56C3E83B8985.title: "Spider Pet"
	quest.0C2AFF7914973B44.quest_desc: [
		"The &eElectrolytic Separator&r splits water into &eHydrogen&r and &eOxygen&r."
		""
		"Oxygen feeds the Purification Chamber. Hydrogen can fill a jetpack or burn for power."
	]
	quest.0C2AFF7914973B44.quest_subtitle: "Water in, gas out"
	quest.0C2AFF7914973B44.title: "Electrolytic Separator"
	quest.0C56F215379380C7.quest_desc: [
		"Plenty of food and drink counts: &eMelon Juice&r and &eApple Cider&r restore 8 thirst points; melon slices and soups help a little."
		""
		"Melon Juice is four melon slices, sugar and a bottle."
	]
	quest.0C56F215379380C7.quest_subtitle: "Water is boring"
	quest.0C56F215379380C7.title: "Tasty Hydration"
	quest.0CA207C79FE5B6CF.quest_desc: [
		"Paper wrapped in Magebloom Fiber makes &eBlank Parchment&r."
		""
		"Put it on the Scribe's Table, hold your book on the spell you want, and sneak-right-click the table to inscribe it. Turrets and Warp Scrolls use parchment too."
	]
	quest.0CA207C79FE5B6CF.quest_subtitle: "Spells on paper"
	quest.0CA207C79FE5B6CF.title: "Spell Parchment"
	quest.0CD351EDAF63E27A.quest_desc: [
		"Big, fluffy, and throws ice. Look for its cave in the snowy forest."
	]
	quest.0CD351EDAF63E27A.quest_subtitle: "Twilight Forest"
	quest.0CD351EDAF63E27A.title: "The Alpha Yeti"
	quest.0CE4EDEC0630D02E.quest_desc: [
		"A molten giant from the Soul Black Smith in the Nether."
	]
	quest.0CE4EDEC0630D02E.quest_subtitle: "L_Ender's Cataclysm"
	quest.0CE4EDEC0630D02E.title: "Netherite Monstrosity"
	quest.0D189E47B3524948.quest_desc: [
		"Infuse Infused Alloy with diamond in the Metallurgic Infuser. You'll need two per Elite Control Circuit."
	]
	quest.0D189E47B3524948.quest_subtitle: "The Elite Circuit needs two"
	quest.0D189E47B3524948.title: "Reinforced Alloy"
	quest.0D19EF4031BA9F96.quest_desc: [
		"Diamond pickaxes and shovels make a &eBulldozer&r. It needs power first: combine it with &eTriple Compressed Stone&r in an anvil."
		""
		"It clears a 16x16x16 space in the direction you face and hands you the drops."
		""
		"&6Heads up:&r it only drops what a diamond tool could harvest, so it's no shortcut past the pickaxe tiers."
	]
	quest.0D19EF4031BA9F96.quest_subtitle: "Clear the lot"
	quest.0D19EF4031BA9F96.title: "Bulldozer"
	quest.0D38C574B1DAEEC1.quest_desc: [
		"Locked away in the Frosted Prison."
	]
	quest.0D38C574B1DAEEC1.quest_subtitle: "L_Ender's Cataclysm"
	quest.0D38C574B1DAEEC1.title: "Maledictus"
	quest.0D3911EF2DF3EDB7.quest_desc: [
		"&eFriends and Foes&r brings mobs from the Minecraft mob votes into the game: golems, glares, crabs, sneaky illagers and a fiery boss."
		""
		"&eFlowery Mooblooms&r and &eBeekeeper Hut&r add to it. &6Heads up:&r every Friends and Foes mob and structure is switched on in ICU."
	]
	quest.0D3911EF2DF3EDB7.quest_subtitle: "Meet the neighbors"
	quest.0D3911EF2DF3EDB7.title: "Who Lives Here?"
	quest.0D512D613726E59B.quest_desc: [
		"String, leather and a seed make a &eSeed Pouch&r. It holds up to 640 of one kind of seed or sapling."
		""
		"Use it on the ground to plant a 3x3 patch at once. It takes bone meal too."
	]
	quest.0D512D613726E59B.quest_subtitle: "640 seeds, one slot"
	quest.0D512D613726E59B.title: "Seed Pouch"
	quest.0D91FC32FEE85AAE.quest_desc: [
		"The &eChemical Washer&r rinses dirty slurry with water. It burns through a lot of water, so feed it from a big source."
		""
		"Also needs an &eUltimate Control Circuit&r."
	]
	quest.0D91FC32FEE85AAE.quest_subtitle: "Clean slurry only"
	quest.0D91FC32FEE85AAE.title: "Chemical Washer"
	quest.0DA038E1ACF4C1E1.quest_desc: [
		"&eYaks&r live in the hills and on stony peaks. Shear them for &eYak Hair&r, but they hate it."
		""
		"Nine hair make a block. Three blocks and four leather make &eYak Pants&r. Wear them and yaks don't mind the shears."
	]
	quest.0DA038E1ACF4C1E1.quest_subtitle: "Fluffy and grumpy"
	quest.0DA038E1ACF4C1E1.title: "Yakety Sax"
	quest.0DDD981952ECC5C9.quest_desc: [
		"Ignis guards the &eBurning Arena&r in the Nether. Bring fire resistance and a good shield."
	]
	quest.0DDD981952ECC5C9.quest_subtitle: "Hot. Very hot."
	quest.0DDD981952ECC5C9.title: "Ignis"
	quest.0E019488C769374A.quest_desc: [
		"It guards the Ruined Citadel in the End."
	]
	quest.0E019488C769374A.quest_subtitle: "L_Ender's Cataclysm"
	quest.0E019488C769374A.title: "Ender Guardian"
	quest.0E03DE31833B5B61.quest_desc: [
		"Vibranium shows up in the Nether, and there is more of it in &eThe Other&r."
		""
		"Rumor has it a Teleport Pad behaves differently when you use it in the Nether."
	]
	quest.0E03DE31833B5B61.quest_subtitle: "Vibranium's second home"
	quest.0E03DE31833B5B61.title: "The Other"
	quest.0E209E3DE4096B99.quest_desc: [
		"Raw pike, two Pickerelweed and a beetroot in the pot."
		""
		"Pickerelweed grows at the edge of rivers. Two of it plus sugar also makes &ePickerelweed Juice&r."
	]
	quest.0E209E3DE4096B99.quest_subtitle: "River dinner"
	quest.0E209E3DE4096B99.title: "Pike with Beetroot"
	quest.0E2BCE1303A3A792.quest_desc: [
		"A full &eTerracotta Water Bowl&r. Cook it once or twice until it reads Purified."
	]
	quest.0E2BCE1303A3A792.quest_subtitle: "Drink up"
	quest.0E2BCE1303A3A792.title: "Terracotta Water Bowl"
	quest.0E2D5EB2B8489610.quest_desc: [
		"Right-click Train Casing on the track at your station to make a &ebogey&r. Build on top, glue it all, add Controls."
		""
		"Open the station and hit assemble. Choo choo!"
	]
	quest.0E2D5EB2B8489610.quest_subtitle: "Your first train"
	quest.0E2D5EB2B8489610.title: "All Aboard!"
	quest.0E34FC54F8C76919.quest_desc: [
		"Hover over any item and press &eR&r to see how it's made, or &eU&r to see what it's used for."
		""
		"ICU changes a few recipes to build its tiers. EMI always shows the current version, so trust it over your memory."
	]
	quest.0E34FC54F8C76919.quest_subtitle: "Seriously, use it"
	quest.0E34FC54F8C76919.title: "EMI Knows Every Recipe"
	quest.0E82D9D43AAFA045.quest_desc: [
		"Eight planks of one wood make a chest in that wood's colors. Every wood type gets its own."
		""
		"Shortcut: eight &elogs&r in a ring make four chests at once."
	]
	quest.0E82D9D43AAFA045.quest_subtitle: "Wood you like one?"
	quest.0E82D9D43AAFA045.title: "Chests to Match"
	quest.0E90A4E655318F0F.quest_desc: [
		"An &eME P2P Tunnel&r carries up to 32 channels through a single channel. Link input and output with a Memory Card."
		""
		"Other P2P types carry items, fluids, power or redstone."
	]
	quest.0E90A4E655318F0F.quest_subtitle: "Channels through one cable"
	quest.0E90A4E655318F0F.title: "P2P Tunnels"
	quest.0E94B47D1386A208.quest_desc: [
		"Put an iron ingot and a gold ingot on the Energizing Orb. Out comes &eEnergized Steel&r."
		""
		"Powah's basic tier (cells, cables, generators) is built from it."
	]
	quest.0E94B47D1386A208.quest_subtitle: "Iron and gold, zapped"
	quest.0E94B47D1386A208.title: "Energized Steel"
	quest.0E980ED9AED0F190.quest_desc: [
		"Every &eAdvanced Control Circuit&r uses one &eFiery Ingot&r, and every Elite and Ultimate circuit is built from one."
		""
		"One Fiery Blood (Hydra) or Fiery Tears (Ur-Ghast) plus an iron ingot makes one Fiery Ingot. A Hydra drops 7 to 10 Fiery Blood, more with Looting."
		""
		"Plan your circuits before you spend them."
	]
	quest.0E980ED9AED0F190.quest_subtitle: "Mekanism runs on Hydra blood"
	quest.0E980ED9AED0F190.title: "The Fiery Ingot Budget"
	quest.0EA0329E3E8D97A7.quest_desc: [
		"A Bow Template, a bow and an emerald (or ruby, amethyst, obsidian or copper) in the Smithing Table."
		""
		"In ICU the gem bows shoot faster than a normal bow, fly dead straight, and zoom in a little while you draw."
	]
	quest.0EA0329E3E8D97A7.quest_subtitle: "Zoom and boom"
	quest.0EA0329E3E8D97A7.title: "Gem Bows"
	quest.0EA97C04C77C8ECA.quest_desc: [
		"The biggest plain AE2 cells. Keep going with components; MEGA Cells takes it from here."
	]
	quest.0EA97C04C77C8ECA.quest_subtitle: "Now we're storing"
	quest.0EA97C04C77C8ECA.title: "64k and 256k"
	quest.0EB474290A815116.quest_desc: [
		"Redstone blocks, blaze rods and a Draconium Core. It makes particles on its own, and it's the key part of an &eEnergy Core Stabilizer&r."
	]
	quest.0EB474290A815116.quest_subtitle: "Pretty, and useful"
	quest.0EB474290A815116.title: "Particle Generator"
	quest.0EBCB09FFADAFD0C.quest_desc: [
		"Tell the &eME Requester&r how much of an item to keep and it orders crafts whenever you drop below."
		""
		"Needs patterns and a free Crafting CPU."
	]
	quest.0EBCB09FFADAFD0C.quest_subtitle: "Always in stock"
	quest.0EBCB09FFADAFD0C.title: "ME Requester"
	quest.0EDE11FEE5A5A302.quest_desc: [
		"Plastic, a chest, buckets, gold, a diamond gear and a Pity Frame."
		""
		"It combines up to eight items with a fluid. Frames, addons and lenses are all made here."
	]
	quest.0EDE11FEE5A5A302.quest_subtitle: "IF's real crafting table"
	quest.0EDE11FEE5A5A302.title: "Dissolution Chamber"
	quest.0F30A6060CDD2A50.quest_desc: [
		"Mix dye with water in a Basin to make &eLiquid Dye&r. Pipe it into a tank and bucket some out with the hatch."
		"Blow a fan through it for bulk coloring, or dunk items and mobs in it."
		""
		"Liquid dye meeting lava makes concrete in that color."
	]
	quest.0F30A6060CDD2A50.quest_subtitle: "Color everything"
	quest.0F30A6060CDD2A50.title: "Liquid Dye"
	quest.0F4091394F1553AF.quest_desc: [
		"Integrated Dungeons and Structures scatters big hand-built places around the world: castles, wizard towers, the Ancient Mines, sunken ships and more."
		""
		"Use your Explorer's Compass to hunt one down. Tick this once you've been inside one."
	]
	quest.0F4091394F1553AF.quest_subtitle: "Castles, towers and mines"
	quest.0F4091394F1553AF.title: "Integrated Dungeons"
	quest.0F78E74EA1C83575.quest_desc: [
		"The &ePrecision Sawmill&r cuts logs into extra planks, with a chance of &eSawdust&r on the side."
		""
		"Sawdust is handy later for making Substrate and plastic."
	]
	quest.0F78E74EA1C83575.quest_subtitle: "More planks, plus a bonus"
	quest.0F78E74EA1C83575.title: "Precision Sawmill"
	quest.0F97E0C6C8D763EB.quest_desc: [
		"Sound the &eAir-Raid Siren&r (it needs Oratchalcum) and the &cRat Baron&r flies in on its plane."
	]
	quest.0F97E0C6C8D763EB.quest_subtitle: "Air raid!"
	quest.0F97E0C6C8D763EB.title: "The Rat Baron"
	quest.0FB32523113404E1.quest_desc: [
		"Supplementaries adds dozens of handy blocks and items, plus some small vanilla tweaks."
		""
		"Try placing a book or a stick on the ground, or throwing a brick at something (it might even break glass)."
	]
	quest.0FB32523113404E1.quest_subtitle: "The odds-and-ends drawer"
	quest.0FB32523113404E1.title: "Supplementaries"
	quest.0FB4DD1C3747E6FC.quest_desc: [
		"Make a &eControl Chip&r with sequenced assembly, then build a &eSequenced Pulse Generator&r."
		""
		"It runs a timed list of redstone pulses when signaled. Right-click it to set the steps."
	]
	quest.0FB4DD1C3747E6FC.quest_subtitle: "Program your redstone"
	quest.0FB4DD1C3747E6FC.title: "Control Chips"
	quest.0FC5F5CF34B65280.quest_desc: [
		"Spin up a Water Wheel, then build a Mechanical Press and a Mechanical Mixer over a Basin."
		""
		"Presses make sheets, mixers make alloys. You'll use both forever."
	]
	quest.0FC5F5CF34B65280.quest_subtitle: "Your first real factory"
	quest.0FC5F5CF34B65280.title: "Press and Mix"
	quest.0FC66384BEADB884.quest_desc: [
		"Mix &eLiveroot&r, raw iron and a gold nugget into Raw Ironwood, then smelt it."
		""
		"Liveroot grows among the roots under the forest floor. Ironwood gear is a solid step up from iron."
	]
	quest.0FC66384BEADB884.quest_subtitle: "Grown, not mined"
	quest.0FC66384BEADB884.title: "Ironwood"
	quest.0FD848EEC48F9940.quest_desc: [
		"Controller, Drive, and a 1k Storage Cell. That's a working ME system!"
		""
		"Bigger MEGA cells come later, and they need rare metals."
	]
	quest.0FD848EEC48F9940.quest_subtitle: "You'll never sort a chest again"
	quest.0FD848EEC48F9940.title: "Your First ME Network"
	quest.0FF7B11F2E272BD9.quest_desc: [
		"Stack &eTurbine Rotors&r up the middle and put two &eTurbine Blades&r on each rotor."
		""
		"More blades catch more steam, but the tower has to be wide enough for them."
	]
	quest.0FF7B11F2E272BD9.quest_subtitle: "Spin to win"
	quest.0FF7B11F2E272BD9.title: "Rotors and Blades"
	quest.100D0134F77FD3FA.quest_desc: [
		"An AE2 pattern terminal for Extended Crafting recipes. Encode them onto &eBlank Extended Patterns&r (a blank pattern, certus quartz and glass make two)."
		""
		"The Basic terminal is 3x3. The 5x5, 7x7 and 9x9 ones are made in Extended Crafting tables."
	]
	quest.100D0134F77FD3FA.quest_subtitle: "AE2 patterns, but bigger"
	quest.100D0134F77FD3FA.title: "Extended Pattern Terminal"
	quest.102792A0771AA8B2.quest_desc: [
		"Wither skeletons in Nether Fortresses drop skulls now and then. Looting helps a lot."
	]
	quest.102792A0771AA8B2.quest_subtitle: "Three per Wither"
	quest.102792A0771AA8B2.title: "Wither Skeleton Skulls"
	quest.102C05E390C73AA0.quest_desc: [
		"&eSteam 'n' Rails&r adds tracks made from each wood type, built the same way as Create's."
		""
		"Mix and match to fit your builds."
	]
	quest.102C05E390C73AA0.quest_subtitle: "Steam 'n' Rails"
	quest.102C05E390C73AA0.title: "Tracks for Every Wood"
	quest.103BD1B42257280C.quest_desc: [
		"The droplets next to your hunger bar are &ethirst&r. Low thirst slows health regen, and at 3 droplets or less you can't sprint."
		""
		"Water has four purity levels: &cDirty&r, &6Slightly Dirty&r, &eAcceptable&r and &aPurified&r. Dirtier water can make you sick or poison you."
	]
	quest.103BD1B42257280C.quest_subtitle: "How water works here"
	quest.103BD1B42257280C.title: "Thirst and Purity"
	quest.106EFC72AA18E1C1.quest_desc: [
		"&eHV Wire Coils&r twist steel and aluminium wire together. The &eHV Transformer&r links MV to HV."
		""
		"&6Heads up:&r HV wire hurts. Keep it high and out of reach."
	]
	quest.106EFC72AA18E1C1.quest_subtitle: "Long lines, big loads"
	quest.106EFC72AA18E1C1.title: "HV Power"
	quest.1078AAA91C419A16.quest_desc: [
		"&eMechanical Pistons&r and &eBearings&r move whole structures. Stick blocks together with &eSuper Glue&r."
		""
		"Everything glued moves as one piece. This is how drills, farms and elevators work."
	]
	quest.1078AAA91C419A16.quest_subtitle: "Blocks that go places"
	quest.1078AAA91C419A16.title: "Moving Contraptions"
	quest.108DD97E0B57C5F9.quest_desc: [
		"Smelt a water bottle or bucket in a furnace or over a campfire. Dirty water comes out &eAcceptable&r; Slightly Dirty or Acceptable comes out &aPurified&r."
		""
		"A campfire is cheap and works while you're away."
	]
	quest.108DD97E0B57C5F9.quest_subtitle: "Heat kills the nasties"
	quest.108DD97E0B57C5F9.title: "Boil It"
	quest.10963CB6C39AFB40.quest_desc: [
		"Speed Upgrades make a machine faster (and hungrier for power). Slot them in the machine's upgrade tab."
	]
	quest.10963CB6C39AFB40.quest_subtitle: "Go faster"
	quest.10963CB6C39AFB40.title: "Speed Upgrade"
	quest.10A8D5C6B7B6F2FF.quest_desc: [
		"A Prosperity Ingot and two Soulium Dust make a &eSoulium Ingot&r. Soul Dust around glass makes &eSoul Glass&r."
	]
	quest.10A8D5C6B7B6F2FF.quest_subtitle: "Nether's own essence metal"
	quest.10A8D5C6B7B6F2FF.title: "Soulium"
	quest.10C6CB8353A5AF63.quest_desc: [
		"&eIron Chests&r are simply bigger chests. Surround a wooden chest with copper or iron ingots."
		""
		"They don't form double chests, so each one is a single block."
	]
	quest.10C6CB8353A5AF63.quest_subtitle: "Bigger boxes"
	quest.10C6CB8353A5AF63.title: "Iron Chests"
	quest.10C94F59EF854A00.quest_desc: [
		"Infuse iron with redstone for Infused Alloy. Another thing you'll want by the stack."
	]
	quest.10C94F59EF854A00.quest_subtitle: "Iron plus redstone"
	quest.10C94F59EF854A00.title: "Infused Alloy"
	quest.10D19C361359314B.quest_desc: [
		"Mulberry vines grow in some forests. Mulberry, sugar and a glass bottle make &eMulberry Jam&r; with an egg instead of the bottle you get &eMulberry Pie&r."
	]
	quest.10D19C361359314B.quest_subtitle: "Jam and pie"
	quest.10D19C361359314B.title: "Mulberries"
	quest.10E2009B9A2FE51C.quest_desc: [
		"Emeralds and sticks, in the shapes you already know."
		""
		"An &eEmerald Pickaxe&r digs as fast as diamond and harvests the same blocks. It only lasts 725 uses, though, where diamond lasts 1561. A good home for a pile of trading emeralds."
	]
	quest.10E2009B9A2FE51C.quest_subtitle: "Villager money, meet pickaxe"
	quest.10E2009B9A2FE51C.title: "Emerald Tools"
	quest.10E29951EDF1A8C8.quest_desc: [
		"Allthemodium ore needs a Netherite pickaxe. Time to go hunting for Ancient Debris."
	]
	quest.10E29951EDF1A8C8.quest_subtitle: "Dig deeper"
	quest.10E29951EDF1A8C8.title: "Netherite Pickaxe"
	quest.1105AC0BF3DD31FE.quest_desc: [
		"Now and then a &eGreat Thrasher&r shows up in Deep Frozen Oceans instead. It's big and very angry."
		""
		"It can drop &eAtlantis&r disc fragments. Collect enough for a music disc."
	]
	quest.1105AC0BF3DD31FE.quest_subtitle: "The Great Thrasher"
	quest.1105AC0BF3DD31FE.title: "Gonna Need a Bigger Boat"
	quest.116F06FA55C55FBD.quest_desc: [
		"&eShafts&r carry rotation in a straight line. &eCogwheels&r pass it sideways to other cogs."
		""
		"A small cog next to a large cog changes speed: large to small doubles it, small to large halves it."
	]
	quest.116F06FA55C55FBD.quest_subtitle: "Passing the spin along"
	quest.116F06FA55C55FBD.title: "Shafts and Cogs"
	quest.11B9C0AE9E7A5E83.quest_desc: [
		"Put a Seed Base on the altar, then four of the material and four matching essences on the pedestals. Coal (Prudentium tier) is a good first pick; iron needs Tertium."
		""
		"EMI shows the exact layout and which essence tier each seed needs."
	]
	quest.11B9C0AE9E7A5E83.quest_subtitle: "Iron that grows"
	quest.11B9C0AE9E7A5E83.title: "Your First Resource Crop"
	quest.11C92795924235DF.quest_desc: [
		"Flax and sticks make an &eAwning&r (dye it any color). Awnings are springy, so you bounce when you land on one."
		""
		"Slabs make &eItem Shelves&r to show off one item each, and slabs with dirt make a &eFlower Box&r that holds even big plants."
	]
	quest.11C92795924235DF.quest_subtitle: "Awnings and shelves"
	quest.11C92795924235DF.title: "Shop Front"
	quest.11ED524258CED4B6.quest_desc: [
		"The &eBorehead Bearing&r spins &eRock Cutting Wheels&r that break blocks in a range around them. It needs a storage block on the drill for the drops."
		""
		"It spins at a quarter of its input speed. Put one on a rover and dig tunnels as you drive."
	]
	quest.11ED524258CED4B6.quest_subtitle: "Tunnel boring machine"
	quest.11ED524258CED4B6.title: "Borehead Drill"
	quest.12207921B2E68532.quest_desc: [
		"ICU turns off the vanilla desert pyramid. IDAS builds its own &eDesert Pyramid&r instead."
		""
		"Find it in the desert and step inside."
	]
	quest.12207921B2E68532.quest_subtitle: "Not the vanilla one"
	quest.12207921B2E68532.title: "The Desert Pyramid"
	quest.1224EA0F97F1AE80.quest_desc: [
		"&eEmbedded Ammonite&r turns up in the stone of beaches, oceans and stony shores. Smelt it for a &eNautilus Shell&r."
		""
		"A shell ringed with stone bricks makes eight &eCoralstone&r. Shells also build conduits."
	]
	quest.1224EA0F97F1AE80.quest_subtitle: "Nautilus shells, no fishing"
	quest.1224EA0F97F1AE80.title: "Fossil Hunting"
	quest.12251D3AF5BD7440.quest_desc: [
		"A full emerald set protects just like diamond, with a bit less durability."
		""
		"&6Heads up:&r the full-set bonuses are switched off in ICU's config. If you want water breathing, carry an &eEmerald Juju&r instead (see below)."
	]
	quest.12251D3AF5BD7440.quest_subtitle: "Green and sturdy"
	quest.12251D3AF5BD7440.title: "Emerald Armor"
	quest.122BA7AED143413C.quest_desc: [
		"The Naga drops a pile of &eNaga Scales&r. Craft the Naga Scale Tunic and Leggings."
		""
		"Solid armor for the next few bosses, and a nice use for all those scales."
	]
	quest.122BA7AED143413C.quest_subtitle: "Fashion from a snake"
	quest.122BA7AED143413C.title: "Scaled Up"
	quest.125FD2DCC4D29FFF.quest_desc: [
		"The &eGas-Burning Generator&r burns flammable gases. Hydrogen from the Separator works."
		""
		"&eEthene&r burns much better. Make it in a Pressurized Reaction Chamber from Bio Fuel, water and hydrogen."
	]
	quest.125FD2DCC4D29FFF.quest_subtitle: "Burn hydrogen or ethene"
	quest.125FD2DCC4D29FFF.title: "Gas-Burning Generator"
	quest.1264C2B387716968.quest_desc: [
		"Buried in the Cursed Pyramid under the desert."
	]
	quest.1264C2B387716968.quest_subtitle: "L_Ender's Cataclysm"
	quest.1264C2B387716968.title: "Ancient Remnant"
	quest.1265E565562D7A44.quest_desc: [
		"Grow a tree next to a wild Whirlisprig to earn a token. Its charm needs mageblooms, saplings, seeds and a diamond."
		""
		"Use the charm on a flower with a chest beside it. It makes logs, crops and flowers from what grows around it, and it likes variety."
	]
	quest.1265E565562D7A44.quest_subtitle: "A nature sprite"
	quest.1265E565562D7A44.title: "Whirlisprig"
	quest.12715610127B60C3.quest_desc: [
		"The Advanced Frame takes a &eKnightmetal Ingot&r in the Dissolution Chamber."
		""
		"It also needs 500 mB of &ePink Slime&r, which comes from a &eMob Slaughter Factory&r (see Industrial Foregoing)."
	]
	quest.12715610127B60C3.quest_subtitle: "Industrial Foregoing, level up"
	quest.12715610127B60C3.title: "Advanced Machine Frame"
	quest.128DC43B6BC74F42.quest_desc: [
		"Energize blaze powder (or a blaze rod) with an &eAllthemodium Nugget&r."
	]
	quest.128DC43B6BC74F42.quest_subtitle: "Spicy power"
	quest.128DC43B6BC74F42.title: "Blazing Crystal"
	quest.12AC8FB39DBDF64A.quest_desc: [
		"All eight Twilight Forest boss trophies (Naga, Lich, Minoshroom, Hydra, Knight Phantom, Ur-Ghast, Alpha Yeti and Snow Queen) around a &eBlock of Carminite&r, on a normal crafting table."
		""
		"Yes, the trophies get used up. Take a screenshot of your trophy room first."
	]
	quest.12AC8FB39DBDF64A.quest_subtitle: "A trophy shelf's worth"
	quest.12AC8FB39DBDF64A.title: "Twilight Seal"
	quest.12DAD28F3C107909.quest_desc: [
		"Mowzie's Naga is a flying sea serpent from the ocean cliffs. Its &eNaga Fang&r makes a poison dagger and blowgun darts."
	]
	quest.12DAD28F3C107909.quest_subtitle: "Not that Naga"
	quest.12DAD28F3C107909.title: "Naga Fang"
	quest.12DC8F77486FC0D5.quest_desc: [
		"ICU swaps out a lot of vanilla buildings. Villages, desert pyramids, Nether fortresses, ocean monuments and mineshafts are all replaced by new versions, and Integrated Dungeons and Structures adds dozens more."
		""
		"Your &eExplorer's Compass&r finds all of them. &6Heads up:&r Structure Essentials speeds up structure searches in ICU."
	]
	quest.12DC8F77486FC0D5.quest_subtitle: "The world's new architecture"
	quest.12DC8F77486FC0D5.title: "Bigger and Better"
	quest.12F14687D95B984B.quest_desc: [
		"Two glowstone dust, a redstone dust and a gunpowder make &eLuminessence&r."
	]
	quest.12F14687D95B984B.quest_subtitle: "Glowing dust"
	quest.12F14687D95B984B.title: "Luminessence"
	quest.1329B933485E1600.quest_desc: [
		"Torches and double compressed stone make an &eInstant Bridge&r."
		""
		"Set its length and material, and add a roof if you like, then build it."
	]
	quest.1329B933485E1600.quest_subtitle: "Across in a click"
	quest.1329B933485E1600.title: "Instant Bridge"
	quest.13680614AF0F32CA.quest_desc: [
		"Two stone buttons, an emerald and a redstone dust."
		""
		"Left-click a button or lever with the &eRedstone Remote&r to link it, then use the remote to press it from anywhere nearby. The chunk must be loaded, and it won't reach into other dimensions."
	]
	quest.13680614AF0F32CA.quest_subtitle: "Flip it from over here"
	quest.13680614AF0F32CA.title: "Redstone Remote"
	quest.13E0B9AB796FB09D.quest_desc: [
		"The &eHull&r is andesite casing and iron ingots. The &eSail&r is six Create windmill sails."
		""
		"Almost every aircraft needs both."
	]
	quest.13E0B9AB796FB09D.quest_subtitle: "The body of the plane"
	quest.13E0B9AB796FB09D.title: "Hull and Sail"
	quest.13F8DB1FFBBF2DBF.quest_desc: [
		"Create machines run on &erotation&r, not energy. Something spins, shafts carry it, machines use it."
		""
		"Stuck on anything? Hover an item and hold &eW&r to watch its Ponder scene. It's the best manual in the pack."
		""
		"Start small: a &eHand Crank&r turns things when you hold right-click."
	]
	quest.13F8DB1FFBBF2DBF.quest_subtitle: "Create 101"
	quest.13F8DB1FFBBF2DBF.title: "Setting Things in Motion"
	quest.1406AAD02D5496A5.quest_desc: [
		"Wrap the Copper Generator in iron. Each solid-fuel tier roughly doubles the output and uses fuel more efficiently."
	]
	quest.1406AAD02D5496A5.quest_subtitle: "Twice the power"
	quest.1406AAD02D5496A5.title: "Iron Generator"
	quest.140CDC3B1469047C.quest_desc: [
		"While you work up Tier 1, have a look at &eFood and Farming&r and &eStorage and Logistics&r."
		""
		"A cooking pot and a backpack make the early game much nicer."
	]
	quest.140CDC3B1469047C.quest_subtitle: "The main path isn't the only path"
	quest.140CDC3B1469047C.title: "Side Chapters"
	quest.141BE2D7D73C375D.quest_desc: [
		"The &eMatter Condenser&r destroys items. Give it a storage component and it turns them into Matter Balls and Singularities."
		""
		"Bigger outputs need a bigger component; the screen tells you. You need a Singularity next."
	]
	quest.141BE2D7D73C375D.quest_subtitle: "Crushing junk into something"
	quest.141BE2D7D73C375D.title: "Matter Condenser"
	quest.14586875563167F9.quest_desc: [
		"The Burning Arena is in the Nether Wastes. Warm up on the &eIgnited Revenants&r before facing Ignis."
	]
	quest.14586875563167F9.quest_subtitle: "Ignis's home"
	quest.14586875563167F9.title: "The Burning Arena"
	quest.145CF1D3D5071C16.quest_desc: [
		"&eRascals&r are shy little critters that love a game of hide and seek. Find one three times."
		""
		"Win and it hands you a prize in a bundle, like an enchanted iron pickaxe or a pile of ore."
	]
	quest.145CF1D3D5071C16.quest_subtitle: "A shy little miner"
	quest.145CF1D3D5071C16.title: "Hide and Seek"
	quest.14AF1F27484AD9FD.quest_desc: [
		"Four Solar Generators, Infused Alloy and iron make the &eAdvanced&r version. It takes more space and makes more power."
	]
	quest.14AF1F27484AD9FD.quest_subtitle: "Bigger panels"
	quest.14AF1F27484AD9FD.title: "Advanced Solar Generator"
	quest.14D837EA08DC28F5.quest_desc: [
		"Every great base starts with a crafting table. You know the drill."
	]
	quest.14D837EA08DC28F5.quest_subtitle: "Punch tree. Make table. Classic."
	quest.14D837EA08DC28F5.title: "First Things First"
	quest.14EF351BF61C1E8C.quest_desc: [
		"The &eSwivel Bearing&r assembles the glued blocks in front of it into their own contraption that turns on the bearing."
		""
		"Great for turrets, flaps and landing gear. Power it with redstone to let it spin freely."
	]
	quest.14EF351BF61C1E8C.quest_subtitle: "Moving parts on moving ships"
	quest.14EF351BF61C1E8C.title: "Swivel Bearing"
	quest.151E54A1D3E2D1F1.quest_desc: [
		"Smelt Dry Rubber into &ePlastic&r. Nearly every IF recipe wants some, so set up a steady supply."
	]
	quest.151E54A1D3E2D1F1.quest_subtitle: "The IF currency"
	quest.151E54A1D3E2D1F1.title: "Plastic"
	quest.154742EB618037F1.quest_desc: [
		"The top of the ladder. Seriously, congratulations!"
		""
		"Now go build something ridiculous."
	]
	quest.154742EB618037F1.quest_subtitle: "You beat ICU!"
	quest.154742EB618037F1.title: "Infinity"
	quest.156544FA3B2541C0.quest_desc: [
		"&eLasers&r charge a &eLaser Amplifier&r. Once it holds enough energy, fire it into the Laser Focus Matrix to ignite the reactor."
		""
		"Put the Hohlraum in the controller first."
	]
	quest.156544FA3B2541C0.quest_subtitle: "Ignition needs a spark"
	quest.156544FA3B2541C0.title: "Lasers"
	quest.15F64B978453C7F5.quest_desc: [
		"&eMechanical Crafters&r link up into grids of any size and craft automatically. Some recipes only work here."
		""
		"&6Heads up:&r in ICU, every &eWaystone&r, Sharestone, Portstone and Warp Plate is made in a Mechanical Crafter grid. Check EMI for the layout."
	]
	quest.15F64B978453C7F5.quest_subtitle: "Big grids, no hands"
	quest.15F64B978453C7F5.title: "Mechanical Crafter"
	quest.15FE548A93CC594D.quest_desc: [
		"The Naga lives in a stone courtyard. It kicks off the Twilight Forest's boss chain."
		""
		"The Twilight Forest makes you beat its bosses in order, so start here."
	]
	quest.15FE548A93CC594D.quest_subtitle: "A very long, very angry snake"
	quest.15FE548A93CC594D.title: "The Naga"
	quest.1643D45A1C75D723.quest_desc: [
		"Little &eBeekeeper Huts&r sit in Flower Forests and Meadows, with beehives, a villager and mooblooms out front."
		""
		"The barrel inside often has honeycomb and a few emeralds. Tick this once you've found one."
	]
	quest.1643D45A1C75D723.quest_subtitle: "Bees, cows and a neighbor"
	quest.1643D45A1C75D723.title: "Beekeeper Hut"
	quest.1656895C20F9B813.quest_desc: [
		"Visit all 69 Biomes O' Plenty biomes, including the Nether, End and cave ones."
		""
		"Biomes O' Plenty gives you its own prize for this: the &eWanderer&r music disc. This is a long one. Enjoy the trip!"
	]
	quest.1656895C20F9B813.quest_subtitle: "Every last biome"
	quest.1656895C20F9B813.title: "Wanderer"
	quest.16663F0C24AC954D.quest_desc: [
		"Link a &eRope Winch&r and a &eRope Connector&r by right-clicking both with a &eRope Coupling&r."
		"Spin the winch to reel the rope in or out. Two winches can't connect to each other."
		""
		"Sling cargo under an airship, or tow a barge."
	]
	quest.16663F0C24AC954D.quest_subtitle: "Tow it, hoist it"
	quest.16663F0C24AC954D.title: "Ropes and Winches"
	quest.166C5D24C5875F95.quest_desc: [
		"Canvas and sticks make a &eBasket&r. It collects items that land in it and can push them into chests."
	]
	quest.166C5D24C5875F95.quest_subtitle: "A hopper with manners"
	quest.166C5D24C5875F95.title: "Basket"
	quest.16704A1AF7476890.quest_desc: [
		"Build the &eMetal Press&r from the manual's layout and form it with the hammer."
		""
		"It does nothing without a mold: plates, rods, wire and gears all come from here, in bulk."
	]
	quest.16704A1AF7476890.quest_subtitle: "Squish it flat"
	quest.16704A1AF7476890.title: "Metal Press"
	quest.168742544C03B8B9.quest_desc: [
		"Surround a Transmutation Table with Dark Matter Blocks and stone. Same screen, anywhere you go."
	]
	quest.168742544C03B8B9.quest_subtitle: "A table in your pocket"
	quest.168742544C03B8B9.title: "Transmutation Tablet"
	quest.16899BE798BA8BAF.quest_desc: [
		"Each stabilizer is a Particle Generator with four diamonds."
		""
		"An Energy Core needs four of them around it. The core's build guide shows where they go."
	]
	quest.16899BE798BA8BAF.quest_subtitle: "Four corners of power"
	quest.16899BE798BA8BAF.title: "Energy Core Stabilizers"
	quest.168BEE309904C501.quest_desc: [
		"Certus Quartz grows from Budding Certus inside meteorites. Mix charged certus, redstone and quartz in water for &eFluix&r."
		""
		"You'll use both for every AE2 part."
	]
	quest.168BEE309904C501.quest_subtitle: "The crystals behind AE2"
	quest.168BEE309904C501.title: "Certus and Fluix"
	quest.16C75CA7F7C5FCE2.quest_desc: [
		"Bedrock, Crystal Matrix, Neutronium, the four odd ingredients and &eone of every Singularity&r (27 in ICU). EMI shows the full list."
		""
		"&6Short on space?&r Combine all 27 Singularities into one &eEternal Singularity&r first. There's a second Catalyst recipe that takes it instead."
		""
		"&6Bedrock:&r the Neutronium Compressor squeezes 10,000 Deepslate into one, or mine it with a Crystal Pickaxe."
		""
		"The Catalyst is what turns Neutronium and Crystal Matrix into Infinity."
	]
	quest.16C75CA7F7C5FCE2.quest_subtitle: "One is all"
	quest.16C75CA7F7C5FCE2.title: "Infinity Catalyst"
	quest.17099265A0250255.quest_desc: [
		"A book and a lever make the &eEngineer's Manual&r."
		""
		"Every multiblock in IE has a page with a 3D preview you can spin around. Keep it on your hotbar while you build."
	]
	quest.17099265A0250255.quest_subtitle: "Read the fine print"
	quest.17099265A0250255.title: "The Engineer's Manual"
	quest.171F5D94EC9327F9.quest_desc: [
		"Bricks, iron, a wooden shovel and a water bucket make a &eCooking Pot&r. It needs heat below it: a Stove, campfire or fire."
		""
		"Soups and stews need a bowl in the container slot. Meals stay in the pot until you take them."
	]
	quest.171F5D94EC9327F9.quest_subtitle: "Real meals start here"
	quest.171F5D94EC9327F9.title: "Cooking Pot"
	quest.172489645C1A52AF.quest_desc: [
		"Three trees worth the trip: &eRainbow Birch&r from the Auroral Garden, &eSnowblossom&r from the Snowblossom Grove and the &eOrigin&r tree from the Origin Valley."
		""
		"Break their leaves for a sapling and grow your own at home."
	]
	quest.172489645C1A52AF.quest_subtitle: "The pretty ones"
	quest.172489645C1A52AF.title: "Rare Saplings"
	quest.174894421DCFB755.quest_desc: [
		"The &eMob Fan&r pushes mobs the way it faces. &eIron Spikes&r hurt whatever stands on them."
		""
		"Spike kills drop XP but don't count as player kills."
	]
	quest.174894421DCFB755.quest_subtitle: "Push, then poke"
	quest.174894421DCFB755.title: "Mob Fan and Spikes"
	quest.176176CF73B4CF6F.quest_desc: [
		"Energize an ender eye with a casing and a tiny capacitor for an &eEnder Core&r."
		""
		"&eEnder Cells&r share one power pool per channel, anywhere in the world. &eEnder Gates&r connect a block to that pool."
	]
	quest.176176CF73B4CF6F.quest_subtitle: "Power without wires"
	quest.176176CF73B4CF6F.title: "Ender Network"
	quest.17B21FD09039A025.quest_desc: [
		"Mix 4 End Stone Powder, 2 zinc nuggets and water in a &eheated&r Basin for &eLevitite Blend&r."
		""
		"Pour it out as a fluid, then light it with a torch, flint and steel or a campfire. The crystal spreads through the whole pool. Once it starts, you can't scoop the blend back up."
		""
		"Enough Levitite keeps a ship afloat with no burners. It won't climb on its own, so add propellers."
	]
	quest.17B21FD09039A025.quest_subtitle: "A rock that floats"
	quest.17B21FD09039A025.title: "Levitite"
	quest.17C33B1887EA6F64.quest_desc: [
		"Place a &ePattern Provider&r against a &eMolecular Assembler&r. Crafting patterns go in the provider; the assembler does the work."
	]
	quest.17C33B1887EA6F64.quest_subtitle: "Tiny robotic crafting table"
	quest.17C33B1887EA6F64.title: "Molecular Assembler"
	quest.17D4647C9A15CAE9.quest_desc: [
		"Split water into &eoxygen&r and &ehydrogen&r. The Purification Chamber runs on oxygen, so you need one for ore tripling."
	]
	quest.17D4647C9A15CAE9.quest_subtitle: "Water in, gas out"
	quest.17D4647C9A15CAE9.title: "Electrolytic Separator"
	quest.17F638B4D331E497.quest_desc: [
		"A multiblock of &eAssembler Matrix Frames&r, walls and glass with Crafter, Pattern and Speed cores inside."
		""
		"It replaces rows of Molecular Assemblers with one tidy box."
	]
	quest.17F638B4D331E497.quest_subtitle: "Autocrafting, industrial size"
	quest.17F638B4D331E497.title: "Assembler Matrix"
	quest.180123C843E0CDFD.quest_desc: [
		"Put an &eInsanium Block&r on the &eEnchanting Apparatus&r and fill eight pedestals around it: a Wilden Tribute, two Awakened Supremium Ingots, an Insanium Ingot, a Source Gem Block, and Manipulation, Abjuration and Conjuration Essence."
		""
		"It drinks &e1000 Source&r, so keep your jars topped up."
		""
		"Stuck? The Wilden Tribute drops from the Wilden Chimera, which only the Summon Wilden ritual calls up. Awakened Supremium needs Cognizant Dust. The Ars Nouveau and Mystical Agriculture chapters explain both."
	]
	quest.180123C843E0CDFD.quest_subtitle: "Source and soil"
	quest.180123C843E0CDFD.title: "Leyline Seal"
	quest.182F260F6489A23E.quest_desc: [
		"The biggest cell there is. Your storage problems are officially over."
	]
	quest.182F260F6489A23E.quest_subtitle: "All the storage"
	quest.182F260F6489A23E.title: "MEGA 256M"
	quest.183C1918DC683244.quest_desc: [
		"Foxhounds roam the Nether Wastes and Basalt Deltas. Feed one coal while you have &eFire Resistance&r and it may become yours."
		""
		"Tamed Foxhounds like to nap on furnaces, and a sleeping one makes the furnace smelt faster."
	]
	quest.183C1918DC683244.quest_subtitle: "Hot dogs"
	quest.183C1918DC683244.title: "Foxhounds"
	quest.186F20BF9B197CE5.quest_desc: [
		"Break one mud block into four &eMud Balls&r (or mix dirt with a water bucket), then throw one at a pig."
		""
		"Muddy pigs even let you stick a flower in their mud."
	]
	quest.186F20BF9B197CE5.quest_subtitle: "Pigs love mud"
	quest.186F20BF9B197CE5.title: "Muddy Up"
	quest.189270FA9A48333A.quest_desc: [
		"Run a boiler at its highest level. You'll need a big tank, lots of heat and a pump that can keep up."
	]
	quest.189270FA9A48333A.quest_subtitle: "Maximum boiler"
	quest.189270FA9A48333A.title: "Full Steam"
	quest.18979AE2DA331B36.quest_desc: [
		"Store nuclear waste in &eRadioactive Waste Barrels&r. They slowly break it down."
		""
		"Better: a &eSolar Neutron Activator&r turns waste into Polonium, and the Isotopic Centrifuge turns it into Plutonium."
	]
	quest.18979AE2DA331B36.quest_subtitle: "Waste not, want not"
	quest.18979AE2DA331B36.title: "Handling Waste"
	quest.18C042ECCB825909.quest_desc: [
		"Fusion-craft Draconium Blocks with Draconium Cores and a &eDragon Heart&r. You'll need a Fusion Crafting Core and injectors."
	]
	quest.18C042ECCB825909.quest_subtitle: "Fusion time"
	quest.18C042ECCB825909.title: "Awakened Draconium"
	quest.18D833EBB09CB4D1.quest_desc: [
		"Fiery Tears work just like the Hydra's Fiery Blood: one plus an iron ingot makes a &eFiery Ingot&r."
		""
		"Handy if you need more Advanced Control Circuits and don't feel like another swamp trip."
	]
	quest.18D833EBB09CB4D1.quest_subtitle: "Plan B for Fiery Ingots"
	quest.18D833EBB09CB4D1.title: "Fiery Tears"
	quest.18E7925CB5C04AA3.quest_desc: [
		"Xaero's minimap is in the corner. Press &eM&r for the full world map."
		""
		"Press &eB&r to drop a waypoint and &eU&r to see your waypoints. Mark your base before you go anywhere!"
	]
	quest.18E7925CB5C04AA3.quest_subtitle: "Never get lost"
	quest.18E7925CB5C04AA3.title: "Your Map"
	quest.18E8DBE782283678.quest_desc: [
		"Every item has an &eEMC&r value, shown in its tooltip. Cheap stuff is worth little, rare stuff is worth a lot."
		""
		"Your EMC is stored on you, not in the table, so any table or tablet can spend it."
	]
	quest.18E8DBE782283678.quest_subtitle: "The universal currency"
	quest.18E8DBE782283678.title: "What Is EMC?"
	quest.18F3F397F387225B.quest_desc: [
		"&eAllthemodium&r: the Overworld's Deep Dark, and the Mining dimension. Needs a Netherite pickaxe."
		"&eVibranium&r: the Nether, and The Other. Needs an Allthemodium pickaxe."
		"&eUnobtainium&r: the End Highlands. Needs a Vibranium pickaxe."
		""
		"Each pickaxe is a smithing upgrade of the one before it."
	]
	quest.18F3F397F387225B.quest_subtitle: "The rare metal ladder"
	quest.18F3F397F387225B.title: "Three Metals, Three Pickaxes"
	quest.190548D43CA9C5CB.quest_desc: [
		"&eSpirit Orbs&r turn up in dungeon and structure chests, in trial chamber rewards, from mob spawners and from Elder Guardians."
		""
		"Save them up. You need 4 at a time."
	]
	quest.190548D43CA9C5CB.quest_subtitle: "Treasure from challenges"
	quest.190548D43CA9C5CB.title: "Spirit Orbs"
	quest.19256672EA161BDD.quest_desc: [
		"Eight stone around a Source Gem gives &eSourcestone&r. It's a building block, and it's also in the next few crafts."
		""
		"A rectangle of it (plus a full Source Jar and a Warp Scroll) can even become a Warp Portal later."
	]
	quest.19256672EA161BDD.quest_subtitle: "Stone with a spark"
	quest.19256672EA161BDD.title: "Sourcestone"
	quest.1926AA2537495BB7.quest_desc: [
		"The &eEngineer's Crafting Table&r is a crafting table built from treated wood. Add iron, a treated fence and slabs for the &eEngineer's Workbench&r."
		""
		"The Workbench takes a blueprint and crafts from it. The blueprint is never used up."
	]
	quest.1926AA2537495BB7.quest_subtitle: "Where blueprints live"
	quest.1926AA2537495BB7.title: "Engineer's Workbench"
	quest.197510BC2DD5979D.quest_desc: [
		"Beaches now grow &eCoconut&r palms. Break a coconut with an axe and it splits into two &eCoconut Slices&r."
		""
		"&6Heads up:&r when a coconut breaks, there's a 1 in 5 chance a &eCoconut Crab&r pops out. Mind your ankles."
	]
	quest.197510BC2DD5979D.quest_subtitle: "Ecologics beaches"
	quest.197510BC2DD5979D.title: "Coconuts!"
	quest.19A232392046B7E9.quest_desc: [
		"&eEnergy Cables&r link generators, cells and machines. Use the wrench in Config mode to change a side."
	]
	quest.19A232392046B7E9.quest_subtitle: "Hook it all up"
	quest.19A232392046B7E9.title: "Energy Cables"
	quest.19A92EA77BD72430.quest_desc: [
		"&eItem Vaults&r join into huge multiblock storage. Wider vaults hold more."
		""
		"Funnels and chutes can feed them from any side."
	]
	quest.19A92EA77BD72430.quest_subtitle: "Bulk storage, Create style"
	quest.19A92EA77BD72430.title: "Item Vaults"
	quest.19B9B49A3D9E5B7E.quest_desc: [
		"Use a &eRemote Lens&r on a conductor wearing goggles, then use it again to look through that conductor's eyes."
	]
	quest.19B9B49A3D9E5B7E.quest_subtitle: "See what they see"
	quest.19B9B49A3D9E5B7E.title: "Remote Lens"
	quest.19BDB9DB7C87AA54.quest_desc: [
		"&eThrashers&r hunt in cold and frozen oceans, deep down below Y 30. They drop a &eThrasher Tooth&r."
		""
		"Bring a good sword and a way to breathe."
		""
		"A Thrasher Tooth also repairs a trident in an anvil, just like prismarine shards."
	]
	quest.19BDB9DB7C87AA54.quest_subtitle: "Something in the cold water"
	quest.19BDB9DB7C87AA54.title: "Tooth Fairy"
	quest.19C9A65ABD994D66.quest_desc: [
		"Water bottles, water buckets and an Upgrade Base make a &eThirst Upgrade&r. It drinks water from your backpack for you."
		""
		"The &eAdvanced&r version lets you pick when it drinks."
	]
	quest.19C9A65ABD994D66.quest_subtitle: "Your backpack pours for you"
	quest.19C9A65ABD994D66.title: "Thirst Upgrade"
	quest.19E596185E3CB74C.quest_desc: [
		"&eWhite Sand&r shows up in the Tropics and the Mystic Grove, &eOrange Sand&r in the Rainforest, and &eBlack Sand&r around the Volcano."
		""
		"&6Heads up:&r with Create O' Plenty, a Mechanical Press compacts white sand with two flint and a little lava into Diorite, and black sand into Scorchia."
	]
	quest.19E596185E3CB74C.quest_subtitle: "White, orange and black"
	quest.19E596185E3CB74C.title: "Colored Sand"
	quest.1A132FF61661FD28.quest_desc: [
		"A redstone block, an Annihilation Plane, a lapis block, an Advanced Card and iron blocks."
		""
		"Slot the &eMagnet Card&r into your Wireless Crafting or Universal Terminal. It picks up items around you and sends them to your inventory or straight into the ME system. There's a hotkey to toggle it, and a Restock toggle too."
	]
	quest.1A132FF61661FD28.quest_subtitle: "Pick it all up"
	quest.1A132FF61661FD28.title: "Magnet Card"
	quest.1A41635D9CFC221C.quest_desc: [
		"Ring the &eFlying Dutchrat's Bell&r to call a ghost ship's captain."
	]
	quest.1A41635D9CFC221C.quest_subtitle: "Ring the bell"
	quest.1A41635D9CFC221C.title: "The Flying Dutchrat"
	quest.1A56DEA44562CC3D.quest_desc: [
		"Both totems trigger when a hit drops you below half your max health. They also fit in a Curios &echarm&r slot."
		""
		"Keep one on you for bad days."
	]
	quest.1A56DEA44562CC3D.quest_subtitle: "Charms that save you"
	quest.1A56DEA44562CC3D.title: "Emergency Totems"
	quest.1AC39D89321B8D62.quest_desc: [
		"An Ironwood Pickaxe and chestplate will carry you through the first few bosses."
	]
	quest.1AC39D89321B8D62.quest_subtitle: "Better than iron"
	quest.1AC39D89321B8D62.title: "Ironwood Tools"
	quest.1B1B5B8A51ADC345.quest_desc: [
		"A respawn anchor, wither skulls, netherrack, netherite and a Nether Star around a Double Compressed table."
		""
		"Made in the Sculk table."
	]
	quest.1B1B5B8A51ADC345.quest_subtitle: "The 5x5 table"
	quest.1B1B5B8A51ADC345.title: "Nether Crafting Table"
	quest.1B292E1E1AFB04BE.quest_desc: [
		"Break grass, wheat or rice with your knife to collect &eStraw&r."
		""
		"Four Straw make &eCanvas&r, two make Rope."
	]
	quest.1B292E1E1AFB04BE.quest_subtitle: "Dry, useful, everywhere"
	quest.1B292E1E1AFB04BE.title: "Straw"
	quest.1B416E4A39DF43C9.quest_desc: [
		"A &eDominion Wand&r links things. Click a jar then a &eSource Relay&r to pull from the jar; click a relay then a jar to push into it."
		""
		"Relays reach 30 blocks. A redstone signal switches one off."
	]
	quest.1B416E4A39DF43C9.quest_subtitle: "Wand it, link it"
	quest.1B416E4A39DF43C9.title: "Moving Source Around"
	quest.1B631FCEC3B7655B.quest_desc: [
		"Sticks and leather make a &eParaglider&r. Hold it, jump off something high and glide."
		""
		"Gliding and sprinting use &estamina&r (the wheel next to your cursor). Rising hot air from a &ecampfire&r pushes you back up."
	]
	quest.1B631FCEC3B7655B.quest_subtitle: "Leap of faith"
	quest.1B631FCEC3B7655B.title: "Paraglider"
	quest.1B65BB7B5A268232.quest_desc: [
		"Throw a Charged Certus into water with a &eCertus Quartz Block&r to get a Damaged budding block."
		"Do it again with that block to go Chipped, then Flawed."
		""
		"Flawed blocks slowly decay as they grow crystals, so keep making more."
	]
	quest.1B65BB7B5A268232.quest_subtitle: "Grow your own"
	quest.1B65BB7B5A268232.title: "Making Budding Certus"
	quest.1BA1D00A890D4F80.quest_desc: [
		"If the Nether worked, maybe try the End too."
	]
	quest.1BA1D00A890D4F80.quest_subtitle: "...and in the End?"
	quest.1BA1D00A890D4F80.title: "The Beyond"
	quest.1BAEB2AA59379C8F.quest_desc: [
		"Craft the Engineer's Hammer, build a 3x3x3 Coke Oven from Coke Bricks and hit it with the hammer to form it."
		""
		"Bake coal into &eCoal Coke&r. It's the key to steel."
	]
	quest.1BAEB2AA59379C8F.quest_subtitle: "Hit it until it's a multiblock"
	quest.1BAEB2AA59379C8F.title: "Engineer's Hammer"
	quest.1BD8395E5CBA975D.quest_desc: [
		"Spell Turrets and Source Jars keep working on moving Create contraptions. A basic turret fires when the contraption interacts with it, a Timer turret fires on its own."
		""
		"A &eDisplay Link&r on a Source Jar shows its Source on a Display Board."
	]
	quest.1BD8395E5CBA975D.quest_subtitle: "Ars Creo keeps it working"
	quest.1BD8395E5CBA975D.title: "Magic on Contraptions"
	quest.1BEB45F285584907.quest_desc: [
		"Iron goes into almost everything in Tier 1. Build up a healthy pile."
		""
		"Bonus: a &eMeteorite Compass&r for later, when you go looking for AE2 meteors."
	]
	quest.1BEB45F285584907.quest_subtitle: "The metal of the people"
	quest.1BEB45F285584907.title: "Iron Age"
	quest.1C06F5F32A32E0DC.quest_desc: [
		"Build a ring of &eTeleporter Frames&r around a 2-wide, 3-tall opening, with the &eTeleporter&r block as part of the ring."
		""
		"Set a frequency in the GUI and give it power. The Teleportation Core needs Atomic Alloy."
	]
	quest.1C06F5F32A32E0DC.quest_subtitle: "Portals, Mekanism style"
	quest.1C06F5F32A32E0DC.title: "Teleporter"
	quest.1C0A11A35B056ACD.quest_desc: [
		"Planks, a slab and sticks make two &eChairs&r. Planks and sticks make two &eTables&r."
		""
		"Right-click a chair to sit down. Every wood type has its own set."
	]
	quest.1C0A11A35B056ACD.quest_subtitle: "Dinner is served"
	quest.1C0A11A35B056ACD.title: "Table and Chairs"
	quest.1C24B64D726323A1.quest_desc: [
		"Craft a Wheel Mount by itself to get a &eCentered Wheel Mount&r, and craft it again to turn it back."
		""
		"Try both styles and see which fits your vehicle."
	]
	quest.1C24B64D726323A1.quest_subtitle: "Simulated Extra"
	quest.1C24B64D726323A1.title: "Centered Wheel Mount"
	quest.1C474266AA5B05C9.quest_desc: [
		"Moas are big flying birds you can ride. Wild Moas lay eggs now and then, and Silver Dungeon chests hold them too."
	]
	quest.1C474266AA5B05C9.quest_subtitle: "Don't count them yet"
	quest.1C474266AA5B05C9.title: "Moa Egg"
	quest.1C486C9F3AE6F6B7.quest_desc: [
		"Meteorites hide &eBudding Certus Quartz&r. Buds grow on its sides; break a full cluster for crystals."
		""
		"Leave the budding block where it is. Mining it damages it."
	]
	quest.1C486C9F3AE6F6B7.quest_subtitle: "Grown, not mined"
	quest.1C486C9F3AE6F6B7.title: "Certus Quartz"
	quest.1CAB9F32D0B3C198.quest_desc: [
		"Wheat and an egg (or a water bucket) make Wheat Dough. Cut it on the board for &eRaw Pasta&r."
		""
		"Pasta, Minced Beef and Tomato Sauce in the pot make &ePasta with Meatballs&r."
	]
	quest.1CAB9F32D0B3C198.quest_subtitle: "Knife, dough, sauce"
	quest.1CAB9F32D0B3C198.title: "Pasta Night"
	quest.1CAF2847B87E5EE8.quest_desc: [
		"A factory is a machine with several slots working side by side. Build one around an Energized Smelter or Enrichment Chamber."
		""
		"A factory with upgrades beats a row of single machines."
	]
	quest.1CAF2847B87E5EE8.quest_subtitle: "Three jobs at once"
	quest.1CAF2847B87E5EE8.title: "Basic Factory"
	quest.1CB0A493749E1D3A.quest_desc: [
		"At the top of the Dark Tower, defeat the little Carminite Ghastlings near the Ghast Traps, then power them with redstone."
		""
		"That pulls the &eUr-Ghast&r down to fight."
	]
	quest.1CB0A493749E1D3A.quest_subtitle: "Lure them down"
	quest.1CB0A493749E1D3A.title: "Ghast Trap"
	quest.1CC5CB15C4324C05.quest_desc: [
		"Ignis, the Harbinger, the Leviathan, the Ender Guardian, Maledictus, the Ancient Remnant, the Netherite Monstrosity and Scylla."
		""
		"You've reached the summit of Cataclysm!"
	]
	quest.1CC5CB15C4324C05.quest_subtitle: "Every boss, beaten"
	quest.1CC5CB15C4324C05.title: "The Cataclysmfarer"
	quest.1CD6033ECBD613DA.quest_desc: [
		"Draconium ingots, redstone blocks and a Draconium Core make the &eWyvern Energy Controller&r."
		""
		"Wyvern tools, the Mob Grinder and relay crystals all use it."
	]
	quest.1CD6033ECBD613DA.quest_subtitle: "Stored power in a box"
	quest.1CD6033ECBD613DA.title: "Wyvern Energy Controller"
	quest.1CE54D48617F39A6.quest_desc: [
		"The &ePlant Fertilizer&r spreads fertilizer over its area to speed up growth."
	]
	quest.1CE54D48617F39A6.quest_subtitle: "Grow faster"
	quest.1CE54D48617F39A6.title: "Plant Fertilizer"
	quest.1CE64890F026F739.quest_desc: [
		"&eImmersive Aircraft&r gives you ready-made aircraft. You place them like a boat and fly them right away."
		""
		"&6Heads up:&r in ICU the parts are made from Create components: precision mechanisms, sturdy sheets, steam engines and more. Some aircraft need a &eMechanical Crafter&r."
	]
	quest.1CE64890F026F739.quest_subtitle: "No kit, no flight"
	quest.1CE64890F026F739.title: "Planes, the Create Way"
	quest.1D20B96EDA2ACC25.quest_desc: [
		"Gloomper, a Shimmerpearl, mushrooms, a Ditchbulb, berries and Underbeans in the pot, with a &eGloomgourd&r as the container."
	]
	quest.1D20B96EDA2ACC25.quest_subtitle: "An Undergarden feast"
	quest.1D20B96EDA2ACC25.title: "Stuffed Gloomgourd"
	quest.1D44B1E57DB4AA49.quest_desc: [
		"&eQIO&r stores items in drives inside a &eDrive Array&r and reaches them wirelessly from a &eDashboard&r."
		""
		"Drives and the array need &eUltimate Control Circuits&r. Link everything with one frequency."
	]
	quest.1D44B1E57DB4AA49.quest_subtitle: "Mekanism's storage network"
	quest.1D44B1E57DB4AA49.title: "QIO"
	quest.1D44F0957F1FFD44.quest_desc: [
		"In ICU, Sulfur Cubes don't spawn on their own. Make one instead: pick up a small &aSlime&r with an empty bucket (Quark), then craft the &eSlime in a Bucket&r with &eSulfur&r."
		""
		"Feed a Sulfur Cube a block and it takes on that block's feel: bouncy, flat, light, slippery..."
		""
		"&cCareful:&r give it TNT and it becomes explosive."
	]
	quest.1D44F0957F1FFD44.quest_subtitle: "A bouncy friend in a bucket"
	quest.1D44F0957F1FFD44.title: "Sulfur Cube"
	quest.1D7C5D8546FA767B.quest_desc: [
		"Four logs in a ring make four &eHollow Logs&r."
		""
		"Sneak while walking into the open side to crawl inside. You can climb up through them too, like a hidden ladder."
	]
	quest.1D7C5D8546FA767B.quest_subtitle: "Crawl space"
	quest.1D7C5D8546FA767B.title: "Hollow Logs"
	quest.1D96D321268E21BE.quest_desc: [
		"The &eGyroscope&r (an electron tube on a compass) shows your flight data. Its Advanced and Electronic versions show more."
		"The &eEnhanced Propeller&r is a Create propeller wrapped in brass sheets."
	]
	quest.1D96D321268E21BE.quest_subtitle: "Fly by the numbers"
	quest.1D96D321268E21BE.title: "Gyroscope and Propeller"
	quest.1DA2A9B677D068AA.quest_desc: [
		"The &eCrystal Assembler&r does all those 'throw it in water' recipes in bulk, and crafts ExtendedAE's parts."
	]
	quest.1DA2A9B677D068AA.quest_subtitle: "Recipes without the water"
	quest.1DA2A9B677D068AA.title: "Crystal Assembler"
	quest.1DA39C900087D328.quest_desc: [
		"Applied Mekanistics adds &eChemical Storage Cells&r. The housing uses osmium, quartz glass and redstone."
		""
		"Now your hydrogen and oxygen live in the drive too."
	]
	quest.1DA39C900087D328.quest_subtitle: "Mekanism gases on the network"
	quest.1DA39C900087D328.title: "Chemical Cells"
	quest.1DD3FDD19D7F7060.quest_desc: [
		"A &eCompacting Drawer&r stores one material in up to three forms and converts between them for you."
		""
		"Put iron ingots in and take out blocks or nuggets as needed."
	]
	quest.1DD3FDD19D7F7060.quest_subtitle: "Nuggets, ingots, blocks"
	quest.1DD3FDD19D7F7060.title: "Compacting Drawers"
	quest.1DE52811C0DF8DB1.quest_desc: [
		"Stoneborn wander the caves. They're grumpy, but they'll trade with you for Regalium."
	]
	quest.1DE52811C0DF8DB1.quest_subtitle: "Trade with the locals"
	quest.1DE52811C0DF8DB1.title: "Interdimensional Business"
	quest.1DFE092DA71947C4.quest_desc: [
		"She waits at the top of the Aurora Palace on the Glacier."
	]
	quest.1DFE092DA71947C4.quest_subtitle: "Twilight Forest"
	quest.1DFE092DA71947C4.title: "The Snow Queen"
	quest.1DFE8431D7BD1B0C.quest_desc: [
		"A &ePortstone&r opens the waystone menu so you can leave, but nobody can teleport &eto&r it."
		""
		"Good for a busy base hub. Mechanical Crafter: stone bricks, dye, a Warp Stone and polished andesite."
	]
	quest.1DFE8431D7BD1B0C.quest_subtitle: "Leave from here"
	quest.1DFE8431D7BD1B0C.title: "Portstones"
	quest.1E26AEAE019A64BE.quest_desc: [
		"A 3x3x3 box: a Fuel Rod in the middle, a Control Rod above it, everything else casing, with the controller, port and tap in the walls."
		""
		"Set the Access Port to Inlet and feed it uranium ingots. Then switch the reactor on in the controller."
	]
	quest.1E26AEAE019A64BE.quest_subtitle: "Light it up"
	quest.1E26AEAE019A64BE.title: "Your First Reactor"
	quest.1E3DB5691977762E.quest_desc: [
		"&eSculk&r, &eNether&r, &eEnd&r and &eExtreme&r Package Crafters craft Avaritia table recipes from packages, one per table size. Each is made from its Avaritia table."
		""
		"The Extreme one handles the 9x9 recipes."
	]
	quest.1E3DB5691977762E.quest_subtitle: "PackagedAvaritia"
	quest.1E3DB5691977762E.title: "Avaritia Package Crafters"
	quest.1E40B0ED036F6F66.quest_desc: [
		"&eTwig Nests&r turn up in forests, jungles and taigas, often with a chicken close by. Break one with shears to keep the nest; anything else just gets you sticks."
		""
		"Some villages have a chicken coop, and Environmental's ducks use nests too."
	]
	quest.1E40B0ED036F6F66.quest_subtitle: "Somebody's been busy"
	quest.1E40B0ED036F6F66.title: "Nests in the Wild"
	quest.1E7120EF1A6E160A.quest_desc: [
		"Housing plus a normal AE2 storage component makes a &eSource Storage Cell&r. Bigger components, bigger cells."
		""
		"Slot it into an ME Drive like any other cell."
	]
	quest.1E7120EF1A6E160A.quest_subtitle: "Source in a drive"
	quest.1E7120EF1A6E160A.title: "Source Storage Cell"
	quest.1E85732A2DB81317.quest_desc: [
		"The Infinity Catalyst wants &eCosmic Meatballs&r, &eUltimate Stew&r, an &eEndest Pearl&r and a &eRecord Fragment&r."
		""
		"The food recipes take a little of everything. Start a big farm now."
	]
	quest.1E85732A2DB81317.quest_subtitle: "A very strange shopping list"
	quest.1E85732A2DB81317.title: "Catalyst Ingredients"
	quest.1EAE161A480B3398.quest_desc: [
		"&eAncient Stone&r makes up much of The Other. Grab a stack for template copies and building."
		""
		"Tip: Cobblegen Galore can make it too (see Utilities)."
	]
	quest.1EAE161A480B3398.quest_subtitle: "Souvenir from The Other"
	quest.1EAE161A480B3398.title: "Ancient Stone"
	quest.1EBF1D09821A0427.quest_desc: [
		"The Cursed Pyramid is buried in the desert. Dig the suspicious sand inside to wake the &eAncient Remnant&r."
	]
	quest.1EBF1D09821A0427.quest_subtitle: "Under the desert"
	quest.1EBF1D09821A0427.title: "The Cursed Pyramid"
	quest.1EDF310E570CE2AA.quest_desc: [
		"Pick &eUnderbeans&r from their bushes and plant &eGloomgourd&r seeds. You'll be down here a while, so start a farm."
	]
	quest.1EDF310E570CE2AA.quest_subtitle: "Beans and gourds"
	quest.1EDF310E570CE2AA.title: "Food Down Below"
	quest.1F08531B1E589616.quest_desc: [
		"The boss of the Gold Dungeon. It drops the Gold Key."
	]
	quest.1F08531B1E589616.quest_subtitle: "The Aether"
	quest.1F08531B1E589616.title: "The Sun Spirit"
	quest.1F18D37057C49B0F.quest_desc: [
		"Surround your backpack with copper ingots to upgrade it. Everything inside stays put."
		""
		"Each tier adds more slots and more upgrade slots."
	]
	quest.1F18D37057C49B0F.quest_subtitle: "A little roomier"
	quest.1F18D37057C49B0F.title: "Copper Backpack"
	quest.1F23278AB54CEA40.quest_desc: [
		"Three flax in a column make three &eRope&r. It climbs like a ladder, and you can slide down it as fast as falling without taking fall damage."
		""
		"It sticks to the sides of blocks and can even run sideways between them."
	]
	quest.1F23278AB54CEA40.quest_subtitle: "Climb it, slide it"
	quest.1F23278AB54CEA40.title: "Rope"
	quest.1F2AD0F8E9CA201F.quest_desc: [
		"Once lit, the reactor runs on a steady trickle of D-T fuel and gives off huge amounts of heat and power."
		""
		"Water cooling turns that heat into steam for turbines. Congratulations, you've beaten Mekanism's power tree!"
	]
	quest.1F2AD0F8E9CA201F.quest_subtitle: "Fusion power online"
	quest.1F2AD0F8E9CA201F.title: "Ignition!"
	quest.1F3CD83C8C4F23E0.quest_desc: [
		"Undergarden Delight adds knives from Undergarden metals. A &eCloggrum Knife&r is the easy one."
		""
		"Cut Undergarden crops and mobs on the board for new ingredients."
	]
	quest.1F3CD83C8C4F23E0.quest_subtitle: "Knives from below"
	quest.1F3CD83C8C4F23E0.title: "Undergarden Knives"
	quest.1F452B2A8E37D574.quest_desc: [
		"A &eHeart of Diamond&r on top of a potato makes a &eTiny Potato&r."
		""
		"Place it and give it a pat."
	]
	quest.1F452B2A8E37D574.quest_subtitle: "It believes in you"
	quest.1F452B2A8E37D574.title: "Tiny Potato"
	quest.1F80124C1E29D084.quest_desc: [
		"Slabs and trapdoors of any wood make a &eCabinet&r. It holds as much as a chest and fits right in a kitchen."
	]
	quest.1F80124C1E29D084.quest_subtitle: "Storage that looks nice"
	quest.1F80124C1E29D084.title: "Kitchen Cabinet"
	quest.1F83664BD3BBB1FA.quest_desc: [
		"&eMechanical Pipes&r carry fluids. &ePressurized Tubes&r carry gases and other chemicals."
		""
		"A &eBasic Chemical Tank&r stores gas. It's also a crafting part for jetpacks and several machines."
	]
	quest.1F83664BD3BBB1FA.quest_subtitle: "Moving fluids and gases"
	quest.1F83664BD3BBB1FA.title: "Pipes and Tubes"
	quest.1FEED1EE9ABF71A0.quest_desc: [
		"The &eIndustrial Turbine&r turns steam into lots of power. Start with &eTurbine Casing&r, a &eTurbine Valve&r (Advanced circuit) and &eTurbine Vents&r."
		""
		"Vents go around the top so steam can leave."
	]
	quest.1FEED1EE9ABF71A0.quest_subtitle: "The walls of a power plant"
	quest.1FEED1EE9ABF71A0.title: "Turbine Casing"
	quest.1FF92772ADE00E5F.quest_desc: [
		"&eFluid Pipes&r carry fluids. A &eMechanical Pump&r on a spinning pipe pushes fluid in the direction of its arrow."
		""
		"Right-click a pipe with a wrench to add a window and check the flow."
	]
	quest.1FF92772ADE00E5F.quest_subtitle: "Moving liquids"
	quest.1FF92772ADE00E5F.title: "Pipes and Pumps"
	quest.20243D856ED59AC5.quest_desc: [
		"Better Tridents makes Loyalty tridents much nicer. They come back if thrown into the void, they return to the slot you threw them from, and they bring your target's drops and XP back with them."
		""
		"Impaling works on anything standing in rain or water, and you can repair a trident with prismarine shards in an anvil."
	]
	quest.20243D856ED59AC5.quest_subtitle: "Loyal to the end"
	quest.20243D856ED59AC5.title: "Better Tridents"
	quest.2033BCEA2D32715A.quest_desc: [
		"The &eExtended Interface&r stocks more item types. The &eExtended Drive&r holds more cells in one block."
	]
	quest.2033BCEA2D32715A.quest_subtitle: "Bigger everything"
	quest.2033BCEA2D32715A.title: "Extended Interface and Drive"
	quest.203F387234199262.quest_desc: [
		"Face a &eStorage Bus&r at a chest, drawer or tank and the network can read and write it like a cell."
	]
	quest.203F387234199262.quest_subtitle: "Your chests, on the network"
	quest.203F387234199262.title: "Storage Bus"
	quest.2049E12C17AF9635.quest_desc: [
		"Step into any Biomes O' Plenty biome. Fields, Maple Woods, Tropics, Redwood Forests: pick one and go."
		""
		"Wandering Traders in ICU can carry Biomes O' Plenty goods too, so check their trades."
	]
	quest.2049E12C17AF9635.quest_subtitle: "Biomes O' Plenty"
	quest.2049E12C17AF9635.title: "Somewhere New"
	quest.20714098F53ED571.quest_desc: [
		"Throw &eCheese&r on the ground near a wild rat (press Q) and let it eat. Keep feeding it until it's full, and it's yours."
		""
		"Right-clicking a rat with cheese won't tame it. Drop the cheese."
	]
	quest.20714098F53ED571.quest_subtitle: "Patience and cheese"
	quest.20714098F53ED571.title: "A Rat of Your Own"
	quest.207E76BEE1D25198.quest_desc: [
		"Use Andesite Alloy on stripped logs to make casings."
		""
		"&6Heads up:&r in ICU, Mekanism's &eMetallurgic Infuser&r needs an Andesite Casing."
	]
	quest.207E76BEE1D25198.quest_subtitle: "Remember this one!"
	quest.207E76BEE1D25198.title: "Andesite Casing"
	quest.20889AD99C1FDB7A.quest_desc: [
		"The Soul Black Smith hides in the Nether. The &eNetherite Monstrosity&r lives there."
	]
	quest.20889AD99C1FDB7A.quest_subtitle: "Where monsters are made"
	quest.20889AD99C1FDB7A.title: "The Soul Forge"
	quest.20990CC9794DBEFE.quest_desc: [
		"Upgrade your starter gear. The &eBasic Energy Cell&r and &eBasic Furnator&r can both be made from your Starter versions."
		""
		"Every Powah block has seven tiers: Starter, Basic, Hardened, Blazing, Niotic, Spirited and Nitro."
	]
	quest.20990CC9794DBEFE.quest_subtitle: "A step up from Starter"
	quest.20990CC9794DBEFE.title: "Basic Tier"
	quest.20D097B58D86361B.quest_desc: [
		"Craft &eRose Quartz&r from quartz and eight redstone, then polish it with &eSandpaper&r (hold right-click)."
		""
		"Polished Rose Quartz on an iron sheet makes an &eElectron Tube&r. Brass machines eat these."
	]
	quest.20D097B58D86361B.quest_subtitle: "Brains for brass"
	quest.20D097B58D86361B.title: "Rose Quartz and Electron Tubes"
	quest.20D4569035A72302.quest_desc: [
		"A Prosperity Ingot with two essences makes an &eessence ingot&r of that tier. A Prosperity Gemstone does the same for gemstones."
		""
		"Gear, accelerators and machine upgrades are built from these."
	]
	quest.20D4569035A72302.quest_subtitle: "Crafting materials"
	quest.20D4569035A72302.title: "Essence Ingots and Gems"
	quest.20E1F596182ED0AA.quest_desc: [
		"Iron, gold, diamond and other versions of the Block Generator work faster. Hover one to see its speed."
	]
	quest.20E1F596182ED0AA.quest_subtitle: "Metal makes it quicker"
	quest.20E1F596182ED0AA.title: "Faster Generators"
	quest.21158BB39097055E.quest_desc: [
		"In the &ePackage Recipe Encoder&r, pick a recipe type, lay out the recipe, put &ePackage Recipe Holders&r inside and press save. One holder stores up to 20 recipes."
	]
	quest.21158BB39097055E.quest_subtitle: "Teach it once"
	quest.21158BB39097055E.title: "Recipe Encoder"
	quest.2135290C25968E4B.quest_desc: [
		"&eSteeleaf&r turns up in hollow hill and Labyrinth chests. It makes light, sharp tools and armor."
		""
		"Keep a few around; it's handy in a lot of Twilight recipes."
	]
	quest.2135290C25968E4B.quest_subtitle: "Leaves that cut"
	quest.2135290C25968E4B.title: "Steeleaf"
	quest.215B0BBF27878993.quest_desc: [
		"A Create propeller wrapped in four iron sheets makes the aircraft &ePropeller&r."
	]
	quest.215B0BBF27878993.quest_subtitle: "Spin to win"
	quest.215B0BBF27878993.title: "Propeller"
	quest.21619D5A2183E4D5.quest_desc: [
		"Two prismarine shards make a &ePrismarine Rod&r. Two rods and three &eThrasher Teeth&r craft a &eTrident&r."
		""
		"Much easier than hoping a drowned drops one."
	]
	quest.21619D5A2183E4D5.quest_subtitle: "No drowned required"
	quest.21619D5A2183E4D5.title: "Make Your Own Trident"
	quest.21670CA3CE5CB6B9.quest_desc: [
		"Smelt Zanite Ore into &eZanite Gemstones&r."
		""
		"Zanite tools get faster as their durability drops, and slow down again when repaired."
	]
	quest.21670CA3CE5CB6B9.quest_subtitle: "Faster when worn"
	quest.21670CA3CE5CB6B9.title: "Zanite"
	quest.219CF20470E85D4A.quest_desc: [
		"The big one: a Double Compressed Crafting Table, Crystal Matrix, the &eDragon Egg&r and two &eUnobtainium Ingots&r."
		""
		"It's a 7x7 recipe, so let EMI show you where everything goes."
	]
	quest.219CF20470E85D4A.quest_subtitle: "A 9x9 grid of dreams"
	quest.219CF20470E85D4A.title: "Extreme Crafting Table"
	quest.21B0884AE96EAFB0.quest_desc: [
		"Got an Andesite Casing and a Brass Casing? That's everything Mekanism asks for."
		""
		"On to &6Tier 2&r!"
	]
	quest.21B0884AE96EAFB0.quest_subtitle: "Mekanism is calling"
	quest.21B0884AE96EAFB0.title: "Casings in Hand"
	quest.21DB4F32EE363743.quest_desc: [
		"The Elite table (or its Auto version), an emerald block, Ultimate Components and an Ultimate Catalyst."
	]
	quest.21DB4F32EE363743.quest_subtitle: "The 9x9 table"
	quest.21DB4F32EE363743.title: "Ultimate Crafting Table"
	quest.21E08271C5D3A123.quest_desc: [
		"A &eTrain Station&r (casing plus compass) goes next to the track. &eTrain Controls&r (with a precision mechanism) let you drive."
	]
	quest.21E08271C5D3A123.quest_subtitle: "Where trains live"
	quest.21E08271C5D3A123.title: "Station and Controls"
	quest.2201D42FCE1B63CD.quest_desc: [
		"Six wool and a stick make a &eFlag&r. You can copy a banner's pattern onto one too (check EMI)."
		""
		"Stand a flag on a stick pole, then click the pole to raise or lower it."
	]
	quest.2201D42FCE1B63CD.quest_subtitle: "Fly your colors"
	quest.2201D42FCE1B63CD.title: "Flags"
	quest.220E75CCD647066F.quest_desc: [
		"The last dungeon, on a huge floating island. Defeat the &eSun Spirit&r."
		""
		"It drops the &eSun Altar&r, which lets you control the Aether's time of day."
	]
	quest.220E75CCD647066F.quest_subtitle: "Extinguished"
	quest.220E75CCD647066F.title: "The Gold Dungeon"
	quest.222EBE28A0ACF7C6.quest_desc: [
		"Visit every Better Dungeon: a monster room, a Catacomb, a Fortress of the Undead and a Spider Cave."
	]
	quest.222EBE28A0ACF7C6.quest_subtitle: "All four"
	quest.222EBE28A0ACF7C6.title: "Professional Dungeoneer"
	quest.225829DF02355D15.quest_desc: [
		"In the Dark Forest ruins there's a pedestal. Place any boss trophy on it to lift the Knight Stronghold's shield."
		""
		"Beat the Lich first: that lifts the Dark Forest's blinding curse."
	]
	quest.225829DF02355D15.quest_subtitle: "Show off a little"
	quest.225829DF02355D15.title: "Trophy Pedestal"
	quest.2281881A07C0D36D.quest_desc: [
		"The &eThrottle Lever&r gives an exact analog redstone signal from 0 to 15. Right-click and drag to set it."
		""
		"Hot Air Burners and Steam Vents scale with redstone strength, so this is your gas pedal."
	]
	quest.2281881A07C0D36D.quest_subtitle: "Smooth control"
	quest.2281881A07C0D36D.title: "Throttle Lever"
	quest.228E854DF4470B3F.quest_desc: [
		"A plain crafting table recipe with very fancy parts: four Concurrent Processors, two Supreme Machine Frames, a Quantum Entangled Singularity, a 256M MEGA Storage Component and an Accumulation Processor."
	]
	quest.228E854DF4470B3F.quest_subtitle: "Every byte, entangled"
	quest.228E854DF4470B3F.title: "Network Seal"
	quest.22AC2BB1FB344886.quest_desc: [
		"&eFluid Storage Cells&r hold fluids the same way item cells hold items. They share a drive with item cells."
	]
	quest.22AC2BB1FB344886.quest_subtitle: "Buckets not included"
	quest.22AC2BB1FB344886.title: "Fluid Storage"
	quest.22B379335E1DA58D.quest_desc: [
		"Craft a &eRitual of Summon Wilden&r tablet and run it with a Wilden Spike, Horn and Wing to call the &eWilden Chimera&r."
		""
		"It's meant for a Tier 2 caster. Bring buffs and a way to move fast. It drops a &eWilden Tribute&r."
		""
		"The Chimera never spawns on its own; this ritual is the only way. Without all three parts you only get ordinary Wilden, and the fight breaks blocks around the brazier, so hold it away from your base."
	]
	quest.22B379335E1DA58D.quest_subtitle: "Ars' mid-game boss"
	quest.22B379335E1DA58D.title: "The Wilden Chimera"
	quest.22BD6FBC95DFE062.quest_desc: [
		"Leave a comment on the CurseForge page and include your &elogs/latest.log&r file. It's the most useful thing you can send."
	]
	quest.22BD6FBC95DFE062.quest_subtitle: "Help fix it"
	quest.22BD6FBC95DFE062.title: "Found a Bug?"
	quest.22BE0C3227C4E72D.quest_desc: [
		"Four Prosperity Shards around wheat seeds make a &eProsperity Seed Base&r, the center of every resource seed recipe."
	]
	quest.22BE0C3227C4E72D.quest_subtitle: "Every crop starts here"
	quest.22BE0C3227C4E72D.title: "Prosperity Seed Base"
	quest.22C1684B39E9D2E9.quest_desc: [
		"The full 9x9 grid of the &eExtreme Crafting Table&r: all eight Seals, the Endest Pearl, four Blocks each of Unobtainium and Vibranium, four Crystal Matrix Ingots and eight Neutronium Ingots."
		""
		"This is the top of InfinityCraft Ultra. Pick any one creative item as your prize. Thank you for playing!"
	]
	quest.22C1684B39E9D2E9.quest_subtitle: "You did it. All of it."
	quest.22C1684B39E9D2E9.title: "The Ultra Star"
	quest.22D1D5CE02017199.quest_desc: [
		"The Naga drops scales. They make good early armor and a nice trophy for the wall."
	]
	quest.22D1D5CE02017199.quest_subtitle: "Snakeskin, but tougher"
	quest.22D1D5CE02017199.title: "Naga Scales"
	quest.22D61102DFED5E4F.quest_desc: [
		"&eIntegrated Villages&r replaces every vanilla village. Each biome has its own style."
		""
		"Start with a &eMarketstead&r on the plains, a village built around trade."
	]
	quest.22D61102DFED5E4F.quest_subtitle: "Integrated Villages"
	quest.22D61102DFED5E4F.title: "Village People"
	quest.22EF539B27619037.quest_desc: [
		"Ender Storage - Energy adds an &eEnder Battery&r. Set the same three colors on two of them to share power, like an Ender Chest."
	]
	quest.22EF539B27619037.quest_subtitle: "Ender Storage for power"
	quest.22EF539B27619037.title: "Ender Battery"
	quest.2312FDFC06F8D66F.quest_desc: [
		"Craft a &eRatlantean Automaton Core&r, put a &eRatlantean Automaton Head&r on top, and surround the core with &eMarbled Cheese&r. Then fight what wakes up."
	]
	quest.2312FDFC06F8D66F.quest_subtitle: "A marbled cheese golem"
	quest.2312FDFC06F8D66F.title: "Ratlantean Automaton"
	quest.2313F5EC91692409.quest_desc: [
		"Feed a Purification Chamber some oxygen and you get three ingots per ore."
		""
		"&6Heads up:&r the chamber needs &eAdvanced Control Circuits&r, and each one needs a Fiery Ingot from the Hydra. So this comes after the Hydra."
	]
	quest.2313F5EC91692409.quest_subtitle: "Now we're talking"
	quest.2313F5EC91692409.title: "Ore Tripling"
	quest.2316A855720EA56A.quest_desc: [
		"A tower of &eThermal Evaporation Blocks&r with a &eController&r and a &eValve&r (both need an Advanced circuit)."
		""
		"Water becomes &eBrine&r, and Brine becomes &eLithium&r. More heat and height make it faster."
	]
	quest.2316A855720EA56A.quest_subtitle: "Salty water"
	quest.2316A855720EA56A.title: "Thermal Evaporation"
	quest.2323961085C4E417.quest_desc: [
		"Four Create propellers, a Hull, a Boiler and string. It hovers slowly and steadily."
		""
		"Perfect for building high up, and that's about it."
	]
	quest.2323961085C4E417.quest_subtitle: "The builder's friend"
	quest.2323961085C4E417.title: "Quadrocopter"
	quest.23295BB692697354.quest_desc: [
		"A &eHose Pulley&r lowers into a fluid and pumps it out."
		""
		"If the body of water is big enough (roughly ten thousand blocks, like an ocean), it never runs dry."
	]
	quest.23295BB692697354.quest_subtitle: "Never place a bucket again"
	quest.23295BB692697354.title: "Bottomless Water"
	quest.234B77922ADFFC5F.quest_desc: [
		"The Avaritia Spear add-on gives you a Crystal Matrix spear from the End table. A neat side weapon."
	]
	quest.234B77922ADFFC5F.quest_subtitle: "Avaritia Spear"
	quest.234B77922ADFFC5F.title: "Crystal Spear"
	quest.2356FB1E27372A2E.quest_desc: [
		"The &eUndergrowth&r is a Nether forest of &eHellbark&r trees, brambles and orange &eBurning Blossoms&r."
		""
		"Hellbark gives you a full Nether wood set to build with."
	]
	quest.2356FB1E27372A2E.quest_subtitle: "Trees in the Nether?"
	quest.2356FB1E27372A2E.title: "Hellbark"
	quest.235DE59BCBDB3CF5.quest_desc: [
		"Put a &eSemaphore&r on a pole above a Train Signal. Its arm shows whether the signal is open or closed."
		""
		"Stack two on a brass signal to tell 'some paths blocked' from 'all paths blocked'."
	]
	quest.235DE59BCBDB3CF5.quest_subtitle: "Old-school signals"
	quest.235DE59BCBDB3CF5.title: "Semaphores"
	quest.23793BA312CC0EC9.quest_desc: [
		"Lapis nuggets, a raw fish, a diamond and a gold ingot. The &eSquid Pet&r gives water breathing, clear sight underwater and a swim boost."
		""
		"Perfect for the Upgrade Aquatic hunts in Land and Sea."
	]
	quest.23793BA312CC0EC9.quest_subtitle: "Breathe easy"
	quest.23793BA312CC0EC9.title: "Squid Pet"
	quest.2387273B20D4A452.quest_desc: [
		"ICU comes with 4 shader packs: &eBSL&r (the default: MEDIUM settings, shadows to 128 blocks), &eComplementary Reimagined&r and &eUnbound&r (with Euphoria Patches for modded blocks) and &eBliss&r. They start &eoff&r."
		""
		"&eF6&r turns shaders on or off. &eF7&r (or Video Settings, Shader Packs) picks a pack - use the ones ending in &e+ Clrwl&r or &e+ EuphoriaPatches&r (they keep Create machines fast)."
		""
		"Modded water and lava get shader effects and keep their own colours. Modded lamps, lanterns, torches, candles and crystals get the same shader look as their vanilla versions."
		""
		"Low FPS? Open the pack's settings and pick a lower profile (&eLOW&r, or &eMINIMUM&r / &ePOTATO&r), or turn shaders off again."
		""
		"Known: ship blocks don't get shader effects yet, the world border is hidden and levitite's shimmer is off while shaders are on. AMD RX 9000 cards: if joining a world with shaders on crashes, join with them off, then press F6."
	]
	quest.2387273B20D4A452.quest_subtitle: "Pretty, but optional"
	quest.2387273B20D4A452.title: "Shaders"
	quest.239184E216D476E3.quest_desc: [
		"The &eFermenter&r turns sugar cane, potatoes and other crops into &eEthanol&r."
	]
	quest.239184E216D476E3.quest_subtitle: "Brewing, industrially"
	quest.239184E216D476E3.title: "Industrial Fermenter"
	quest.23A11A9F7C23D126.quest_desc: [
		"Redstone, white wool, a diamond and a gold ingot. The &eBed Pet&r lets you sleep wherever you are, or summons a living bed."
		""
		"It gets hungry for white wool."
	]
	quest.23A11A9F7C23D126.quest_subtitle: "Sleep anywhere"
	quest.23A11A9F7C23D126.title: "Bed Pet"
	quest.23C911F48A232827.quest_desc: [
		"&eAllthemodium&r: the Overworld's Deep Dark, and the Mining dimension. Needs a Netherite pickaxe."
		"&eVibranium&r: the Nether, and The Other. Needs an Allthemodium pickaxe."
		"&eUnobtainium&r: the End Highlands (the outer End islands). Needs a Vibranium pickaxe."
	]
	quest.23C911F48A232827.quest_subtitle: "Where the shiny stuff lives"
	quest.23C911F48A232827.title: "Rare Metal Cheat Sheet"
	quest.23E020BD53697018.quest_desc: [
		"Build a &eFusion Crafting Core&r (lapis blocks, diamonds, a Draconium Core) and some &eDraconium Fusion Crafting Injectors&r."
		""
		"Injectors are made with Draconium Cores too, so remember ICU's cores need a &eVibranium Ingot&r each."
	]
	quest.23E020BD53697018.quest_subtitle: "The heart of Draconic"
	quest.23E020BD53697018.title: "Fusion Crafting"
	quest.23EFEA24B6BE179C.quest_desc: [
		"Leaves on top of a log make two &eHedges&r, a fence made of leaves."
		""
		"Two leaves side by side make three &eLeaf Carpets&r, a thin layer of foliage for floors and roofs."
	]
	quest.23EFEA24B6BE179C.quest_subtitle: "Garden party"
	quest.23EFEA24B6BE179C.title: "Hedges and Leaf Carpets"
	quest.23F3F1B675F47C45.quest_desc: [
		"Eight &eCheese&r in a ring make a &eRat Upgrade: Basic&r. Almost every other rat upgrade starts from one."
		""
		"Give an upgrade to a tamed rat through its menu."
	]
	quest.23F3F1B675F47C45.quest_subtitle: "The start of every upgrade"
	quest.23F3F1B675F47C45.title: "Rat Upgrade: Basic"
	quest.244FDFB7AC310A1B.quest_desc: [
		"Put an &eUltimate Catalyst&r in the left slot (it isn't used up), then feed it &e10,000&r of one material and 5,000,000 FE to make a &eSingularity&r."
		""
		"ICU has 19: iron, gold, copper, diamond, emerald, redstone, lapis, glowstone, coal and ten modded metals."
	]
	quest.244FDFB7AC310A1B.quest_subtitle: "Ten thousand into one"
	quest.244FDFB7AC310A1B.title: "Quantum Compressor"
	quest.245A5BB782A0B9B3.quest_desc: [
		"It needs an &eAdvanced Control Circuit&r. It squeezes dusts into &eRefined Obsidian&r and &eRefined Glowstone&r ingots, fueled by osmium."
		""
		"Refined Obsidian goes into lots of late-game gear."
	]
	quest.245A5BB782A0B9B3.quest_subtitle: "Refined metals"
	quest.245A5BB782A0B9B3.title: "Osmium Compressor"
	quest.2461E58C21B2A2B2.quest_desc: [
		"A spinning &eGenerator Coil&r surrounded by magnets makes electricity. &eCarbon Brushes&r collect it."
		""
		"Stronger magnets turn more of your stress into power, but the coil also gets hungrier. Coils never make rotation."
	]
	quest.2461E58C21B2A2B2.quest_subtitle: "Spin to win"
	quest.2461E58C21B2A2B2.title: "Generator Coils"
	quest.24684F649401208C.quest_desc: [
		"Fuse Awakened Cores, Awakened Draconium and Large Chaos Fragments, with a Large Chaos Fragment as the catalyst."
	]
	quest.24684F649401208C.quest_subtitle: "Pure chaos in a box"
	quest.24684F649401208C.title: "Chaotic Core"
	quest.24689CCC040BFB40.quest_desc: [
		"Place &eGrowth Accelerators&r next to budding blocks and give them power. Buds grow much faster."
	]
	quest.24689CCC040BFB40.quest_subtitle: "Speed up the buds"
	quest.24689CCC040BFB40.title: "Growth Accelerator"
	quest.247DBD810409FE1A.quest_desc: [
		"Defeat all three illager spellcasters: an &eEvoker&r, an &eIceologer&r and an &eIllusioner&r."
		""
		"Evokers turn up in woodland mansions and raids."
	]
	quest.247DBD810409FE1A.quest_subtitle: "Three spellcasters"
	quest.247DBD810409FE1A.title: "The Magicians"
	quest.24924F33557D8248.quest_desc: [
		"The &eCoercion Deriver&r turns power into &eFortron&r, the energy force fields run on."
		""
		"A &eFortron Capacitor&r shares Fortron with machines on the same frequency."
	]
	quest.24924F33557D8248.quest_subtitle: "Power to Fortron"
	quest.24924F33557D8248.title: "Coercion Deriver"
	quest.24A67EF416F325F6.quest_desc: [
		"Mix copper and zinc in a Basin over a lit Blaze Burner. Out comes &eBrass&r."
		""
		"Zinc ore is common in the Overworld, and crushing it doubles your yield later."
	]
	quest.24A67EF416F325F6.quest_subtitle: "Copper plus zinc, plus heat"
	quest.24A67EF416F325F6.title: "Brass"
	quest.24EB6EF5142BE7E7.quest_desc: [
		"The &eHeat Generator&r burns furnace fuel. It also makes free power from lava touching its sides."
		""
		"Surround one with lava source blocks for a no-fuel starter setup."
	]
	quest.24EB6EF5142BE7E7.quest_subtitle: "Your first Mekanism power"
	quest.24EB6EF5142BE7E7.title: "Heat Generator"
	quest.24F6F9ED00B76A48.quest_desc: [
		"Vibranium ore shows up in the &eNether&r and in &eThe Other&r."
	]
	quest.24F6F9ED00B76A48.quest_subtitle: "Purple and precious"
	quest.24F6F9ED00B76A48.title: "Nether Treasure"
	quest.24FF75F62E86BF53.quest_desc: [
		"Iron, planks and a chest make a &eCrate&r. It holds up to 640 items, no matter their stack size."
		""
		"Not great for bulk storage, but perfect for tools, armor and all the random one-off items you pick up."
	]
	quest.24FF75F62E86BF53.quest_subtitle: "For all the odds and ends"
	quest.24FF75F62E86BF53.title: "Crate"
	quest.250A16B690CBB7DA.quest_desc: [
		"Glass and a wooden slab make a &eJar&r. It holds bottles, bowls and buckets of liquid (modded soups, stews and drinks too), cookies, or small critters."
		""
		"Slimes, magma cubes, bees, allays and frogs all fit. Great for a pet shelf."
	]
	quest.250A16B690CBB7DA.quest_subtitle: "Put it in a jar"
	quest.250A16B690CBB7DA.title: "Jars"
	quest.251FABCADC6BACDD.quest_desc: [
		"Logs, iron ingots and a block of redstone make the &ePity Machine Frame&r."
		""
		"Most early IF machines are built around one."
	]
	quest.251FABCADC6BACDD.quest_subtitle: "It's a start"
	quest.251FABCADC6BACDD.title: "Pity Machine Frame"
	quest.252CCC09DAD847D3.quest_desc: [
		"Four lapis, four Source Gems and a Blank Parchment make a &eWarp Scroll&r. Bind it to a spot, then use it to jump back there."
		""
		"Same dimension only. The Stabilized version (blaze powder and ender pearls on the apparatus) isn't used up and can cross dimensions."
	]
	quest.252CCC09DAD847D3.quest_subtitle: "One-way ticket home"
	quest.252CCC09DAD847D3.title: "Warp Scroll"
	quest.254FA077B2601398.quest_desc: [
		"Smelt Resin Clumps into &eResin Bricks&r, then put four together for a &eResin Bricks&r block."
		""
		"They come as slabs, stairs, walls and a chiseled version."
	]
	quest.254FA077B2601398.quest_subtitle: "Build in orange"
	quest.254FA077B2601398.title: "Resin Bricks"
	quest.255861EAAC4A8A9F.quest_desc: [
		"Climb the Lich Tower and take down the Lich. Bring a bow for the shield phase."
	]
	quest.255861EAAC4A8A9F.quest_subtitle: "Tall tower, bad attitude"
	quest.255861EAAC4A8A9F.title: "The Lich"
	quest.255B2433E0D50766.quest_desc: [
		"Rotspawn drop &eUtheric Shards&r. A shard on a stick is a torch that hurts any Rotspawn near it."
		""
		"Light up your base with these."
	]
	quest.255B2433E0D50766.quest_subtitle: "Rot, begone"
	quest.255B2433E0D50766.title: "Shard Torch"
	quest.257F8C4DEBDF55D7.quest_desc: [
		"The Neutronium Collector slowly makes Neutron Piles out of thin air. Set it and forget it."
	]
	quest.257F8C4DEBDF55D7.quest_subtitle: "Something from nothing"
	quest.257F8C4DEBDF55D7.title: "Neutronium"
	quest.2581B93E73B11C08.quest_desc: [
		"The &eAnimal Feeder&r breeds animals in range. The &eAnimal Rancher&r milks and shears them."
		""
		"Watch the numbers; too many animals means lag."
	]
	quest.2581B93E73B11C08.quest_subtitle: "Happy cows"
	quest.2581B93E73B11C08.title: "Animal Husbandry"
	quest.258644C40F015F3F.quest_desc: [
		"A honey bottle and bread make &eHoney Bread&r. A honey bottle and a cooked porkchop make a &eHoney Glazed Porkchop&r."
		""
		"Candles, lamps and more wait in Buzzier Bees too."
	]
	quest.258644C40F015F3F.quest_subtitle: "Buzzier Bees"
	quest.258644C40F015F3F.title: "Honey Snacks"
	quest.258E127F75B18DCB.quest_desc: [
		"A &eRat Crafting Table&r plus a rat with &eRat Upgrade: Crafting&r crafts recipes for you while you're busy."
		""
		"&6Heads up:&r the &eTick Accelerator&r and &eTime Manipulator&r upgrades are turned off in ICU. They could speed up any machine, including the ones ICU's tiers lock."
	]
	quest.258E127F75B18DCB.quest_subtitle: "Tiny hands, big factory"
	quest.258E127F75B18DCB.title: "Rat Auto-Crafting"
	quest.25C506FFDB99FADA.quest_desc: [
		"Upgrade Allthemodium tools with the Vibranium template and a &eVibranium Ingot&r."
		""
		"The Vibranium pickaxe is your ticket to Unobtainium."
	]
	quest.25C506FFDB99FADA.quest_subtitle: "Purple power"
	quest.25C506FFDB99FADA.title: "Vibranium Tools"
	quest.25CC6F74D9AE53F8.quest_desc: [
		"Tired of random paintings? With &eGallery&r, right-click with a painting to open a menu and choose exactly which one to hang."
	]
	quest.25CC6F74D9AE53F8.quest_subtitle: "Gallery"
	quest.25CC6F74D9AE53F8.title: "Pick Your Picture"
	quest.25DE6F9615E47983.quest_desc: [
		"Stack a block of &eTuff&r, any &ewool&r, and a carved pumpkin (or a jack o'lantern) on top to build a &eTuff Golem&r."
		""
		"Its cloak takes the color of the wool you used. Tick this once you've made one."
	]
	quest.25DE6F9615E47983.quest_subtitle: "Small and sleepy"
	quest.25DE6F9615E47983.title: "Tuff Golem"
	quest.25DE75A79CA0D7B8.quest_desc: [
		"Seeds, bundles of timber, compressed dirt, wool and a water bucket make a &eFarm&r."
		""
		"Choose a Berry Farm, Rabbit Hutch, Elevated Farm, Cactus Farm, Horse Stable, Multi-Level Farm, Chicken Coop or Beef Farm."
	]
	quest.25DE75A79CA0D7B8.quest_subtitle: "Barns, pens and coops"
	quest.25DE75A79CA0D7B8.title: "Farm in a Box"
	quest.25DF9E09CF7AB7A0.quest_desc: [
		"A Simple Frame with dirt, fertilizer and a hoe. Plant on top, power it, and it harvests for you."
	]
	quest.25DF9E09CF7AB7A0.quest_subtitle: "Farming in a box"
	quest.25DF9E09CF7AB7A0.title: "Hydroponic Bed"
	quest.260A47EF47A10251.quest_desc: [
		"A &eMechanical Saw&r cuts logs into planks and cuts things on belts. Mount it on a contraption and it fells whole trees."
	]
	quest.260A47EF47A10251.quest_subtitle: "Timber!"
	quest.260A47EF47A10251.title: "Mechanical Saw"
	quest.262A4111B8A89791.quest_desc: [
		"Give a pig a &eGolden Carrot&r and follow it. It sniffs out a &eBuried Truffle&r nearby."
		""
		"Dig the truffle up. Fancy!"
	]
	quest.262A4111B8A89791.quest_subtitle: "Pigs know best"
	quest.262A4111B8A89791.title: "Truffle Shuffle"
	quest.264154827D5AFA8E.quest_desc: [
		"&eStack Upgrades&r let each slot hold more than a normal stack."
		"Starter uses copper blocks, Tier 1 uses iron blocks, then gold and diamond blocks for Tiers 2 and 3."
		""
		"Build more than one and they stack together."
	]
	quest.264154827D5AFA8E.quest_subtitle: "64 is a suggestion"
	quest.264154827D5AFA8E.title: "Stack Upgrades"
	quest.26482A856469CE0E.quest_desc: [
		"Defeat a &eBluff&r for its Bluff Rod. The Sculptor wants one before he'll test you."
	]
	quest.26482A856469CE0E.quest_subtitle: "A rod for the Sculptor"
	quest.26482A856469CE0E.title: "Called Your Bluff"
	quest.264C77BDA4716274.quest_desc: [
		"Inventory Pets builds its own little dungeons: &eTree Tops&r in forests, &eSky Dungeons&r floating over the land, &eUnderground Dungeons&r, &eSea Caves&r, &eNether Dungeons&r and &eSpace Dungeons&r in the End."
		""
		"Most are guarded by their own spawners. Tick this once you've raided one."
	]
	quest.264C77BDA4716274.quest_subtitle: "Built just for pets"
	quest.264C77BDA4716274.title: "Pet Dungeons"
	quest.26D4AF7ADC3090C5.quest_desc: [
		"&eRune&r smithing templates turn up in chests, desert and jungle temples among them. Seven Corundum and a cobblestone around one make two."
		""
		"Use one on an enchanted item in a smithing table to change the color of its shine. Purely for looks."
	]
	quest.26D4AF7ADC3090C5.quest_subtitle: "Make it shine your way"
	quest.26D4AF7ADC3090C5.title: "Color Runes"
	quest.26D7A62028DD1CE0.quest_desc: [
		"You can't drink water with your bare hands in ICU. Fill glass bottles instead."
		""
		"&6Heads up:&r running water is one step cleaner than still water, and water above Y 100 or below Y 48 is cleaner too."
	]
	quest.26D7A62028DD1CE0.quest_subtitle: "Hands won't do"
	quest.26D7A62028DD1CE0.title: "Bottle It Up"
	quest.26E9AAB1C69E21A3.quest_desc: [
		"Put a cell in the &eCell Workbench&r to set a filter (partition) or add upgrade cards."
		""
		"A filtered cell only accepts the items you choose."
	]
	quest.26E9AAB1C69E21A3.quest_subtitle: "Tune your cells"
	quest.26E9AAB1C69E21A3.title: "Cell Workbench"
	quest.26EB2F7C5CA387DB.quest_desc: [
		"The Leviathan drops &eTidal Claws&r. Right-click to grapple, left-click to lash out with a tentacle."
	]
	quest.26EB2F7C5CA387DB.quest_subtitle: "A grappling hook!"
	quest.26EB2F7C5CA387DB.title: "Tidal Claws"
	quest.26FA8A9E53E05A7D.quest_desc: [
		"An ender pearl on four obsidian makes a &eBasic Item Collector&r. Put it against a chest or any other inventory. It picks up dropped items nearby and puts them straight in. Set the range (up to 5) in its screen."
		""
		"The &eAdvanced Item Collector&r (Basic Collector, an Eye of Ender and obsidian) reaches up to 7 and has a filter."
		""
		"Tick this once you've built one."
	]
	quest.26FA8A9E53E05A7D.quest_subtitle: "A vacuum for your floor"
	quest.26FA8A9E53E05A7D.title: "Item Collectors"
	quest.26FC1DD85D1C9438.quest_desc: [
		"&eFiery Ingot&r: Fiery Blood from the Hydra (or Fiery Tears from the Ur-Ghast) plus iron."
		"&eKnightmetal&r: Armor Shards from Goblin Knights in the Twilight Forest."
		"&eIgnitium&r: Ignis, in the Nether's Burning Arena."
		"&eWitherite&r: the Harbinger, in the Ancient Factory."
		"&eNether Stars&r: the Wither. &eDragon Heart&r: the Ender Dragon."
	]
	quest.26FC1DD85D1C9438.quest_subtitle: "Who drops what"
	quest.26FC1DD85D1C9438.title: "Boss Cheat Sheet"
	quest.271EF8AD073DEE60.quest_desc: [
		"Nine Crystal Matrix Ingots make a &eCrystal Matrix&r block. The Extreme table's bottom row wants five of them."
	]
	quest.271EF8AD073DEE60.quest_subtitle: "Nine ingots, one block"
	quest.271EF8AD073DEE60.title: "Crystal Matrix Block"
	quest.272A37D80C862989.quest_desc: [
		"The &eAlpha Yeti&r lives in a cave in the Snowy Forest. Its fur keeps you warm on the Glacier."
		""
		"Beat it and pick up the fur."
	]
	quest.272A37D80C862989.quest_subtitle: "Big, fluffy, angry"
	quest.272A37D80C862989.title: "Alpha Fur"
	quest.27699D6D3BF997FF.quest_desc: [
		"Upgrade each Allthemodium armor piece the same way."
	]
	quest.27699D6D3BF997FF.quest_subtitle: "Top of Tier 4"
	quest.27699D6D3BF997FF.title: "Vibranium Armor"
	quest.2771606DFB3A2B1A.quest_desc: [
		"It needs a full bucket of &eRedstone Acid&r: four redstone dust and a water bucket, shapeless."
		""
		"Accumulators store power and push it out their output side."
	]
	quest.2771606DFB3A2B1A.quest_subtitle: "A battery for your wires"
	quest.2771606DFB3A2B1A.title: "LV Accumulator"
	quest.277C9D401995D6BE.quest_desc: [
		"Pick up &eSeashells&r along the beach. Sand, two seashells and a stick make a &eSandcastle&r."
		""
		"It's decoration, but it also shelters turtle eggs."
	]
	quest.277C9D401995D6BE.quest_subtitle: "Shells by the sea"
	quest.277C9D401995D6BE.title: "Sandcastle"
	quest.27863C3CBC482BB1.quest_desc: [
		"A spell is a &eform&r (Projectile, Touch, Self), then &eeffects&r, then &eaugments&r like Amplify."
		""
		"Cheap starters: &eLight&r needs a lantern and a torch, &eTouch&r just a button. &eHarm&r takes Earth Essence and three iron swords. EMI lists every glyph's price."
	]
	quest.27863C3CBC482BB1.quest_subtitle: "Spells are just sentences"
	quest.27863C3CBC482BB1.title: "Your First Glyphs"
	quest.27BA16E9F0D4E0F8.quest_desc: [
		"A &eFiery Pickaxe&r smelts what it mines, and Fiery armor burns anything that hits you."
		""
		"&6Heads up:&r Fiery Ingots also feed Mekanism's Advanced Control Circuits. Don't spend them all on shiny gear."
	]
	quest.27BA16E9F0D4E0F8.quest_subtitle: "Auto-smelt, burn stuff"
	quest.27BA16E9F0D4E0F8.title: "Fiery Tools"
	quest.27E5769EEDE7E89F.quest_desc: [
		"Three mods fill the land and sea with life: &eEnvironmental&r (deer, yaks, pigs that dig for truffles, koi), &eBuzzier Bees&r (honey goodies) and &eUpgrade Aquatic&r (thrashers, fossils and more)."
		""
		"Their food, like duck, venison, perch and pike, is cooked up in the &eDelightful Add-ons&r chapter."
	]
	quest.27E5769EEDE7E89F.quest_subtitle: "The Abnormals crew"
	quest.27E5769EEDE7E89F.title: "Wild Things"
	quest.27F0881DB9F70E6C.quest_desc: [
		"The &ePropeller Bearing&r spins whatever you glue to its front. It needs at least 2 sail-like blocks."
		""
		"More sails give more thrust. Thrust drops as you climb, because the air gets thin."
	]
	quest.27F0881DB9F70E6C.quest_subtitle: "Build your own blades"
	quest.27F0881DB9F70E6C.title: "Propeller Bearing"
	quest.280152F04BFA31F1.quest_desc: [
		"Coconut Crabs drop &eCrab Claws&r. Cook a claw into &eCrab Meat&r, then add a Coconut Slice for a bowl of &eTropical Stew&r."
	]
	quest.280152F04BFA31F1.quest_subtitle: "Crab and coconut"
	quest.280152F04BFA31F1.title: "Tropical Stew"
	quest.282E79C8B429AF9C.quest_desc: [
		"&eSulfur Caves&r are a cave biome full of &eSulfur&r and &eSulfur Spikes&r. Four spikes craft into four Sulfur."
		""
		"Watch out for &ePotent Sulfur&r: it powers &cgeysers&r."
	]
	quest.282E79C8B429AF9C.quest_subtitle: "Yellow, smelly and underground"
	quest.282E79C8B429AF9C.title: "Sulfur Caves"
	quest.288ADE959650EABF.quest_desc: [
		"Strongholds are rebuilt and much bigger here. Throw an Eye of Ender and follow it to one."
	]
	quest.288ADE959650EABF.quest_subtitle: "Follow the eye"
	quest.288ADE959650EABF.title: "A Better Stronghold"
	quest.288FE2C99CA0F173.quest_desc: [
		"&eStorage Upgrades&r multiply how much a drawer holds. The tiers go obsidian, copper, iron, gold, emerald, diamond and netherite."
		""
		"Each drawer has a few upgrade slots, and the upgrades stack."
	]
	quest.288FE2C99CA0F173.quest_subtitle: "Make them hold more"
	quest.288FE2C99CA0F173.title: "Drawer Upgrades"
	quest.28AF0F4385F12CCD.quest_desc: [
		"&eCreate Connected&r fills in the gaps. The &e6-way Gearbox&r has shafts on all sides (top and bottom run at half speed)."
		""
		"The &eParallel Gearbox&r sends rotation out side by side."
	]
	quest.28AF0F4385F12CCD.quest_subtitle: "Create Connected"
	quest.28AF0F4385F12CCD.title: "Fancy Gearboxes"
	quest.28C2786201B177DF.quest_desc: [
		"Quark adds new stone in big clusters: &eJasper&r in badlands and deserts, &eLimestone&r in swamps and oceans, &eShale&r in cold biomes."
		""
		"Each one has polished, brick and pillar versions. A stonecutter makes them all."
	]
	quest.28C2786201B177DF.quest_subtitle: "Rocks with style"
	quest.28C2786201B177DF.title: "New Stones"
	quest.28FDB16A542289DF.quest_desc: [
		"A stick and two iron ingots make a &eTrowel&r. Use it and it places a random block from your hotbar."
		""
		"Put a block in more slots to make it come up more often. Great for messy paths and natural walls. In ICU it never breaks."
	]
	quest.28FDB16A542289DF.quest_subtitle: "Random, on purpose"
	quest.28FDB16A542289DF.title: "Trowel"
	quest.28FF185F0E71FA9D.quest_desc: [
		"A &ePackager&r next to an inventory wraps items into packages with an address label."
		""
		"Packages can travel on belts, chutes and frogports, and unpack at the right place."
	]
	quest.28FF185F0E71FA9D.quest_subtitle: "Put it in a box"
	quest.28FF185F0E71FA9D.title: "Packagers"
	quest.29021A3231BDA298.quest_desc: [
		"Four plastic around a ghast tear. Right-click a mob to catch it, right-click again to let it out."
		""
		"The Mob Duplicator uses these later."
	]
	quest.29021A3231BDA298.quest_subtitle: "Pokemon, but plastic"
	quest.29021A3231BDA298.title: "Mob Imprisonment Tool"
	quest.290B16FC2A123FD5.quest_desc: [
		"The &eBuilding Gadget&r places rows, walls and surfaces. The &eExchanging Gadget&r swaps blocks in place."
		""
		"Gadgets run on power, so charge them first."
	]
	quest.290B16FC2A123FD5.quest_subtitle: "Place a hundred blocks at once"
	quest.290B16FC2A123FD5.title: "Building Gadget"
	quest.294B7AAFD17D1208.quest_desc: [
		"Eight windmill blades around an iron ingot."
		""
		"Windmills need open air around them and work better the higher you put them."
	]
	quest.294B7AAFD17D1208.quest_subtitle: "Let it breeze"
	quest.294B7AAFD17D1208.title: "Windmill"
	quest.295373C5C00E12DA.quest_desc: [
		"Crimson and warped planks make boats too, with chest, furnace and large versions."
		""
		"Bamboo gets the same treatment: a &eWide Bamboo Raft&r and a &eBamboo Furnace Raft&r."
	]
	quest.295373C5C00E12DA.quest_subtitle: "Crimson and warped"
	quest.295373C5C00E12DA.title: "Nether Wood Boats"
	quest.297F560368CED7F2.quest_desc: [
		"Eight Mobius Fuel around a diamond. Klein Stars hold EMC, and bigger stars combine from smaller ones."
	]
	quest.297F560368CED7F2.quest_subtitle: "An EMC battery"
	quest.297F560368CED7F2.title: "Klein Star"
	quest.29D78344CD52D92B.quest_desc: [
		"You climbed the whole ladder. The side chapters still have bosses to beat, ships to fly and factories to automate."
		""
		"Thanks for playing ICU!"
	]
	quest.29D78344CD52D92B.quest_subtitle: "Anything you like"
	quest.29D78344CD52D92B.title: "What Now?"
	quest.29EA8A1E29F0ECF7.quest_desc: [
		"The &eEnergized Smelter&r cooks anything a furnace can, powered instead of fueled."
		""
		"Put Speed Upgrades in it and it leaves every furnace behind."
	]
	quest.29EA8A1E29F0ECF7.quest_subtitle: "A furnace that runs on power"
	quest.29EA8A1E29F0ECF7.title: "Energized Smelter"
	quest.29F1A820540484D8.quest_desc: [
		"Craft any helmet together with Engineer's Goggles. You keep the armor and get the goggle overlay."
		""
		"No more swapping hats to check your machines."
	]
	quest.29F1A820540484D8.quest_subtitle: "Armor that sees stress"
	quest.29F1A820540484D8.title: "Goggle Helmets"
	quest.29F5C0DBE285017A.quest_desc: [
		"Inferium Essence, bone meal and a diamond make &eMystical Fertilizer&r. It instantly grows any crop, resource crops included."
		""
		"Resource crops (not Inferium) also drop Fertilized Essence, which makes more of it."
	]
	quest.29F5C0DBE285017A.quest_subtitle: "Bonemeal that works"
	quest.29F5C0DBE285017A.title: "Mystical Fertilizer"
	quest.2A05CF3A8FCA560E.quest_desc: [
		"A Quill with quartz, redstone, lapis, an emerald and gold makes the &eRedstone Logic Control&r."
		""
		"It reads and sets signals on all six sides, and you program it with short lines like &eR = G AND B&r. Timers, counters and edge detection are built in. Its tooltip has the whole manual."
	]
	quest.2A05CF3A8FCA560E.quest_subtitle: "A tiny programmable brain"
	quest.2A05CF3A8FCA560E.title: "Redstone Logic Control"
	quest.2A236281CACA3F96.quest_desc: [
		"Canvas and string make a &eSack&r: nine slots that you can carry around or set down as a block."
		""
		"&6Heads up:&r carrying more than two sacks makes you &eOverencumbered&r. No sprinting, and it gets worse the more you carry."
	]
	quest.2A236281CACA3F96.quest_subtitle: "Portable, but heavy"
	quest.2A236281CACA3F96.title: "Sack"
	quest.2A4656DF2BB35FEC.quest_desc: [
		"The &eItem Silo&r is a vertical item vault. The &eFluid Vessel&r is a horizontal fluid tank."
		""
		"Craft either one back into the normal version any time."
	]
	quest.2A4656DF2BB35FEC.quest_subtitle: "Storage, turned sideways"
	quest.2A4656DF2BB35FEC.title: "Silos and Vessels"
	quest.2A55A2AA2DEE357C.quest_desc: [
		"ICU's worlds are full of new places. &eBiomes O' Plenty&r adds 69 biomes to the Overworld, the Nether and the End, and &eEcologics&r livens up beaches, plains, deserts, snow and lush caves."
		""
		"&6Heads up:&r every Biomes O' Plenty biome is switched on in ICU. A &eNature's Compass&r (see the Explorer's Toolkit) finds any of them by name."
	]
	quest.2A55A2AA2DEE357C.quest_subtitle: "The world got a lot bigger"
	quest.2A55A2AA2DEE357C.title: "Go Outside"
	quest.2A5CC5A3FB622206.quest_desc: [
		"Gold ingots around an Iron Chest make a &eGold Chest&r. Diamonds and glass around that make a &eDiamond Chest&r."
		""
		"A Diamond Chest has 108 slots: two whole double chests."
	]
	quest.2A5CC5A3FB622206.quest_subtitle: "Real storage now"
	quest.2A5CC5A3FB622206.title: "Gold and Diamond Chests"
	quest.2A7EF7C35500AF98.quest_desc: [
		"Some pale oak trunks hide a &eCreaking Heart&r. At night it wakes a &cCreaking&r to guard it."
		""
		"Mine the heart with &eSilk Touch&r to take it home. Without Silk Touch it breaks into 1-3 &eResin Clumps&r."
	]
	quest.2A7EF7C35500AF98.quest_subtitle: "Something lives in the trees"
	quest.2A7EF7C35500AF98.title: "Creaking Heart"
	quest.2AAD0118283D1286.quest_desc: [
		"&eWarp Plates&r work in pairs. Put a &eDormant Shard&r (warp dust and flint) in one to attune it, then carry the shard to a second plate."
		""
		"Stand on either plate to hop across. It's free, and it works for mobs too."
	]
	quest.2AAD0118283D1286.quest_subtitle: "Step on, pop out"
	quest.2AAD0118283D1286.title: "Warp Plates"
	quest.2B19215FEC5B1F73.quest_desc: [
		"Farms and machines only work while their chunk is loaded. Wander far away and they stop."
		""
		"&eChunk Loaders&r: place one, right-click it, and click chunks on its map to turn them on."
		"&eFTB Chunks&r: open the &eClaim Manager&r from the map buttons in your inventory. Drag to claim chunks, and Shift-drag to force-load the ones that should keep running while you're away."
		""
		"Farm animals, villagers and iron golems always keep moving in loaded chunks. A hostile mob farm must sit in a chunk-loaded or claimed chunk, or its mobs freeze once you're more than four chunks away."
	]
	quest.2B19215FEC5B1F73.quest_subtitle: "Out of sight, still working"
	quest.2B19215FEC5B1F73.title: "Keep Your Farms Running"
	quest.2B29942BD8272227.quest_desc: [
		"Build an &eEnchanting Apparatus&r on top of an &eArcane Core&r, with Arcane Pedestals within 3 blocks."
		""
		"Load the pedestals, then right-click the apparatus with the center item. Most of Ars from here on is made this way."
	]
	quest.2B29942BD8272227.quest_subtitle: "Ars' main crafting station"
	quest.2B29942BD8272227.title: "Enchanting Apparatus"
	quest.2B30C5035E254F3E.quest_desc: [
		"The &eDiesel Generator&r burns Biodiesel for a big, steady stream of power."
		""
		"Its Generator Blocks need MV coils and its Radiators need constantan. A farm, a squeezer, a fermenter and a refinery keep it fed forever."
	]
	quest.2B30C5035E254F3E.quest_subtitle: "Real power, finally"
	quest.2B30C5035E254F3E.title: "Diesel Generator"
	quest.2B380DECF12F7949.quest_desc: [
		"Eight iron ingots in a ring make 24 &eIron Plates&r. &eFramed Glass&r is glass with iron corners, eight per craft."
		""
		"&eGold Bars&r and &eGrates&r finish off the look. Unleashed animals won't walk on a Grate, and items fall through it."
	]
	quest.2B380DECF12F7949.quest_subtitle: "Factory chic"
	quest.2B380DECF12F7949.title: "Plates and Framed Glass"
	quest.2B53E358F15C74F8.quest_desc: [
		"Teleporting costs &eXP levels&r. The cost grows with distance, and trips to another dimension cost the most."
		""
		"Trips to &eglobal&r waystones, and trips from a Warp Plate, are free."
	]
	quest.2B53E358F15C74F8.quest_subtitle: "XP, not magic"
	quest.2B53E358F15C74F8.title: "The Price of Travel"
	quest.2B5AD4515B6B1893.quest_desc: [
		"Nine crafting tables make a &eCompressed Crafting Table&r, and nine of those make a &eDouble Compressed&r one."
		""
		"Every big Avaritia table starts from these."
	]
	quest.2B5AD4515B6B1893.quest_subtitle: "Nine tables in one"
	quest.2B5AD4515B6B1893.title: "Compressed Crafting Tables"
	quest.2B7BC86810242568.quest_desc: [
		"Robes have three tiers, upgraded on the apparatus:"
		"Tier 2 costs two blaze rods and 2500 Source. Tier 3 costs two ender pearls, a chorus fruit and 5000 Source."
		""
		"Each tier adds mana regen and bigger thread slots."
	]
	quest.2B7BC86810242568.quest_subtitle: "More slots, more regen"
	quest.2B7BC86810242568.title: "Armor Tiers"
	quest.2BF18C54B8E2BBDA.quest_desc: [
		"&eBrass Funnels&r and &eBrass Tunnels&r have filter slots. A &eSmart Chute&r filters what drops through it."
		""
		"Put an item in the filter slot to only let that item through."
	]
	quest.2BF18C54B8E2BBDA.quest_subtitle: "Filters everywhere"
	quest.2BF18C54B8E2BBDA.title: "Smart Logistics"
	quest.2BFD45764BFAAB46.quest_desc: [
		"Mix pulpable plant bits (check EMI) with water to make &ePulp&r, then press it into &eCardboard&r."
		""
		"You'll need a stack for the package network."
	]
	quest.2BFD45764BFAAB46.quest_subtitle: "Packaging material"
	quest.2BFD45764BFAAB46.title: "Cardboard"
	quest.2C020D2F1CEB5BBA.quest_desc: [
		"Agradditions adds &eessence coal&r (coal plus two essences, burns longer), essence apples and &epaxels&r."
		""
		"A paxel is an axe, pickaxe and shovel of the same tier crafted together."
	]
	quest.2C020D2F1CEB5BBA.quest_subtitle: "Little extras"
	quest.2C020D2F1CEB5BBA.title: "Mystical Agradditions"
	quest.2C2E1C3E4310EE4C.quest_desc: [
		"Mowzie's Cataclysm adds Eyes for Mowzie's structures too:"
		"&eEye of Wrought&r (Wrought Chamber), &eEye of Frost&r (Frostmaw), &eEye of Sunbird&r (Umvuthana Grove) and &eEye of Sculptor&r (the Sculptor's Monastery)."
		""
		"Throw one and follow it."
	]
	quest.2C2E1C3E4310EE4C.quest_subtitle: "Find the lairs"
	quest.2C2E1C3E4310EE4C.title: "Mowzie's Eyes"
	quest.2C2E6D6BD9C599C8.quest_desc: [
		"Diamond, emerald and netherite seeds are Supremium tier, so they wait for Vibranium like the essence does."
		""
		"Put them on Supremium Farmland, over a stack of accelerators, and enjoy."
	]
	quest.2C2E6D6BD9C599C8.quest_subtitle: "Diamonds on a stalk"
	quest.2C2E6D6BD9C599C8.title: "Precious Crops"
	quest.2C3F2C7D9C086818.quest_desc: [
		"Right-click stripped logs with a Brass Ingot to make &eBrass Casing&r."
		""
		"&6Heads up:&r in ICU, Mekanism's &eSteel Casing&r needs a Brass Casing. Make extras."
	]
	quest.2C3F2C7D9C086818.quest_subtitle: "Tier two of Create"
	quest.2C3F2C7D9C086818.title: "Brass Casing"
	quest.2C4F871845EDA9F2.quest_desc: [
		"ICU's recipe needs a Create &eBrass Casing&r in the middle. Most Mekanism machines are built on this."
	]
	quest.2C4F871845EDA9F2.quest_subtitle: "Almost every machine starts here"
	quest.2C4F871845EDA9F2.title: "Steel Casing"
	quest.2C7F1C8C4B1BAF06.quest_desc: [
		"The Hydra lives in the Fire Swamp. Fire resistance potions are your best friend."
	]
	quest.2C7F1C8C4B1BAF06.quest_subtitle: "Three heads, zero chill"
	quest.2C7F1C8C4B1BAF06.title: "The Hydra"
	quest.2C90098A21FD8EAD.quest_desc: [
		"Crush &eEnd Stone&r to get &eEnd Stone Powder&r. It's the base for Levitite, the floating crystal."
		""
		"Bring back a few stacks of end stone. You'll want a lot."
	]
	quest.2C90098A21FD8EAD.quest_subtitle: "A trip to the End"
	quest.2C90098A21FD8EAD.title: "End Stone Powder"
	quest.2CAC461409CC22AD.quest_desc: [
		"Put a filled Mob Imprisonment Tool inside and feed it Essence. It spawns copies of that mob."
		""
		"Pair it with the Mob Crusher for a full mob farm."
	]
	quest.2CAC461409CC22AD.quest_subtitle: "Copy and paste"
	quest.2CAC461409CC22AD.title: "Mob Duplicator"
	quest.2CB31CBD379BF0B8.quest_desc: [
		"Chest &eupgrade items&r turn a placed chest into the next tier and keep everything inside."
		""
		"Sneak and right-click the chest with the upgrade. Much easier than moving 100 stacks by hand."
	]
	quest.2CB31CBD379BF0B8.quest_subtitle: "No unpacking needed"
	quest.2CB31CBD379BF0B8.title: "Upgrade in Place"
	quest.2CD83ACD19D8B277.quest_desc: [
		"Eight gold ingots around an Iron Backpack. More room, more upgrade slots."
	]
	quest.2CD83ACD19D8B277.quest_subtitle: "Shiny and spacious"
	quest.2CD83ACD19D8B277.title: "Gold Backpack"
	quest.2CE62D5E7EC0D085.quest_desc: [
		"Deserts and badlands now have &eDry Grass&r, and cacti can grow &eCactus Flowers&r."
		""
		"Cactus Flowers make &dpink dye&r."
	]
	quest.2CE62D5E7EC0D085.quest_subtitle: "Life in the dry places"
	quest.2CE62D5E7EC0D085.title: "Desert Bloom"
	quest.2CFC8A4061706950.quest_desc: [
		"The &eDigital Miner&r digs out exactly the blocks you filter for, in a big radius, without breaking the land."
		""
		"Give it lots of power and somewhere to put what it digs. It needs a Robit, a Sorter and two Teleportation Cores."
	]
	quest.2CFC8A4061706950.quest_subtitle: "Mining while you sleep"
	quest.2CFC8A4061706950.title: "Digital Miner"
	quest.2D1691EF891C9F51.quest_desc: [
		"A &eReactor Core&r, four &eReactor Stabilizers&r and a &eReactor Energy Injector&r, all fusion crafted."
		"It burns Awakened Draconium and makes an absurd amount of power."
		""
		"&6Heads up:&r a badly run reactor explodes. Build it far from home and learn the screen first."
	]
	quest.2D1691EF891C9F51.quest_subtitle: "Infinite power, finite patience"
	quest.2D1691EF891C9F51.title: "Draconic Reactor"
	quest.2D31851F053DCA94.quest_desc: [
		"Take down every kind of Rotspawn: Rotling, Rotwalker, Rotbeast and Rotbelcher."
	]
	quest.2D31851F053DCA94.quest_subtitle: "All of the rot"
	quest.2D31851F053DCA94.title: "Rotbane"
	quest.2D63A30DEC19B034.quest_desc: [
		"Put music discs in the &eJukebox Upgrade&r and your backpack plays them wherever you go."
		""
		"Pure fun. No shame."
	]
	quest.2D63A30DEC19B034.quest_subtitle: "Music to mine by"
	quest.2D63A30DEC19B034.title: "Jukebox Upgrade"
	quest.2D665B8035BB1E9A.quest_desc: [
		"A few flowers to hunt down: &eWildflowers&r in the Fields, &eGoldenrod&r on the Prairie, &ePink Hibiscus&r in the Tropics and &eViolets&r in the Maple Woods and on the Moor."
		""
		"Every one of them crafts into dye."
	]
	quest.2D665B8035BB1E9A.quest_subtitle: "Pick a bouquet"
	quest.2D665B8035BB1E9A.title: "Flower Power"
	quest.2D752AD64BB26D28.quest_desc: [
		"Immersive Energistics runs your network over Immersive Engineering style wires."
		""
		"Four fluix blocks and three fluix crystals make four &eME Connectors&r. Put one against an ME cable or device, then link two connectors with an &eME Wire Coil&r (fluix glass cables around a stick). A wire can span 16 blocks and carries 8 channels, like a normal cable."
	]
	quest.2D752AD64BB26D28.quest_subtitle: "Immersive Energistics"
	quest.2D752AD64BB26D28.title: "ME on a Wire"
	quest.2D9E25C0443648AD.quest_desc: [
		"A Pickup Upgrade plus ender pearls, iron, redstone and lapis makes a &eMagnet Upgrade&r."
		"It pulls in items (and XP orbs) from a few blocks away. Set a filter so it skips the junk."
	]
	quest.2D9E25C0443648AD.quest_subtitle: "Come here, loot"
	quest.2D9E25C0443648AD.title: "Magnet Upgrade"
	quest.2DB5C310B7AF1DBD.quest_desc: [
		"Start with a &eGolden Sheet&r. Three Deployers add a cogwheel, a large cogwheel and an iron nugget, and the whole sequence loops five times."
		""
		"Three Deployers along a looping belt do it hands-free. Aircraft need these in ICU."
	]
	quest.2DB5C310B7AF1DBD.quest_subtitle: "Sequenced assembly"
	quest.2DB5C310B7AF1DBD.title: "Precision Mechanism"
	quest.2DD4FC1AF9F5737E.quest_desc: [
		"Umvuthana Raptors drop masks. Each mask gives a buff, like strength or speed, when worn."
	]
	quest.2DD4FC1AF9F5737E.quest_subtitle: "Umvuthana masks"
	quest.2DD4FC1AF9F5737E.title: "Masquerade"
	quest.2DE9955B1F03C00C.quest_desc: [
		"Upgrade items like &eCopper to Iron Upgrade&r move a placed generator up a tier without crafting a new one."
	]
	quest.2DE9955B1F03C00C.quest_subtitle: "No need to break it"
	quest.2DE9955B1F03C00C.title: "Upgrade Kits"
	quest.2DEAFA9D0422C173.quest_desc: [
		"Wilden roam forests at night. &eHunters&r drop horns, &eStalkers&r drop wings, and &eDefenders&r (cold biomes only) drop spikes."
		""
		"Horns tame Drygmys, wings make Air Essence, and all three summon the Chimera."
	]
	quest.2DEAFA9D0422C173.quest_subtitle: "Horns, wings and spikes"
	quest.2DEAFA9D0422C173.title: "Wilden Hunting"
	quest.2DFC243EE96EBCE0.quest_desc: [
		"String, rabbit hide, sticks and a slime ball make a &eSlingshot&r. Draw it for a second and it flings items instead of arrows."
		""
		"Blocks land as placed blocks, so you can put one somewhere you can't reach."
	]
	quest.2DFC243EE96EBCE0.quest_subtitle: "Fling things"
	quest.2DFC243EE96EBCE0.title: "Slingshot"
	quest.2E35CCF3A6CA2658.quest_desc: [
		"Factories, 4x and 5x ore processing, turbines and reactors all live in the &eMekanism&r chapters under Tech."
		""
		"Elite and Ultimate parts wait for the next tiers."
	]
	quest.2E35CCF3A6CA2658.quest_subtitle: "Tier 2 is just the start"
	quest.2E35CCF3A6CA2658.title: "There's Much More Mekanism"
	quest.2E3DF788E76DC4C5.quest_desc: [
		"&eIllusioners&r haunt taiga forests and hide out in shacks and training grounds. They fill the air with copies of themselves."
		""
		"Find the real one. It drops a &eTotem of Illusion&r."
	]
	quest.2E3DF788E76DC4C5.quest_subtitle: "The Illusioner"
	quest.2E3DF788E76DC4C5.title: "World of Illusion"
	quest.2E64FE14161AB734.quest_desc: [
		"Cobblestone, coal, a diamond and a gold ingot. The &eFurnace Pet&r smelts the first smeltable item in your hotbar."
	]
	quest.2E64FE14161AB734.quest_subtitle: "Cook on the move"
	quest.2E64FE14161AB734.title: "Furnace Pet"
	quest.2E7A3DE25B49D825.quest_desc: [
		"&eEyeblossoms&r grow in the Pale Garden, open or closed."
		""
		"Open ones make &6orange dye&r, closed ones make &7gray dye&r."
	]
	quest.2E7A3DE25B49D825.quest_subtitle: "Flowers that watch you"
	quest.2E7A3DE25B49D825.title: "Eyeblossoms"
	quest.2E8F75BF85686E1F.quest_desc: [
		"The &eBioreactor&r turns crops and saplings into &eBiofuel&r. The &eBiofuel Generator&r burns it for good power."
		""
		"Hook it to your Plant Gatherer and it runs itself."
	]
	quest.2E8F75BF85686E1F.quest_subtitle: "Compost, but spicy"
	quest.2E8F75BF85686E1F.title: "Biofuel"
	quest.2EC41EA63621F1FB.quest_desc: [
		"In the pot: rice, onion, a brown mushroom, a potato, berries and a vegetable, with a &epumpkin&r as the container."
	]
	quest.2EC41EA63621F1FB.quest_subtitle: "Cooked in its own shell"
	quest.2EC41EA63621F1FB.title: "Stuffed Pumpkin"
	quest.2ED9FAB0D97B93EC.quest_desc: [
		"MFFS builds almost everything from &eFocus Matrices&r (steel, redstone, a diamond) and &eBatteries&r."
	]
	quest.2ED9FAB0D97B93EC.quest_subtitle: "Force fields, step one"
	quest.2ED9FAB0D97B93EC.title: "Focus Matrix"
	quest.2EEC80DF90EFBFCF.quest_desc: [
		"Stonecut iron blocks into &eLocometal&r and top your engine with a &eSmokestack&r."
		""
		"Click a smokestack with dye to change the smoke color, or with soul sand for soul smoke."
	]
	quest.2EEC80DF90EFBFCF.quest_subtitle: "Smoke and steel"
	quest.2EEC80DF90EFBFCF.title: "Locomotive Style"
	quest.2EEE2A7BDE6B2128.quest_desc: [
		"Energy Cubes upgrade by crafting: Advanced needs Infused Alloy, Elite needs Reinforced Alloy."
		""
		"No gated circuits here, just alloys, so grow your storage whenever you like."
	]
	quest.2EEE2A7BDE6B2128.quest_subtitle: "More room for more power"
	quest.2EEE2A7BDE6B2128.title: "Bigger Batteries"
	quest.2F361D7C90EC2ADB.quest_desc: [
		"Hardened parts need the &eHardened Capacitor&r, made with Energized Steel. No rare metals needed yet."
	]
	quest.2F361D7C90EC2ADB.quest_subtitle: "Tougher and bigger"
	quest.2F361D7C90EC2ADB.title: "Hardened Tier"
	quest.2F676AAB1B939FB9.quest_desc: [
		"ICU's recipe puts a Create &eAndesite Casing&r in the bottom. Check EMI if you're unsure."
		""
		"The Infuser makes alloys, circuits and steel."
	]
	quest.2F676AAB1B939FB9.quest_subtitle: "The heart of early Mekanism"
	quest.2F676AAB1B939FB9.title: "Metallurgic Infuser"
	quest.2F7059F15949E1E7.quest_desc: [
		"Osmium ore is common underground. Smelt a good stack."
	]
	quest.2F7059F15949E1E7.quest_subtitle: "Mekanism runs on it"
	quest.2F7059F15949E1E7.title: "Osmium"
	quest.2F738C5C7DAEF958.quest_desc: [
		"The &eSolid Access Port&r takes fuel in and pushes waste out. The &eActive Power Tap&r sends power into cables."
	]
	quest.2F738C5C7DAEF958.quest_subtitle: "In and out"
	quest.2F738C5C7DAEF958.title: "Access Port and Power Tap"
	quest.2F77D386DE8211AB.quest_desc: [
		"The &eMEGA Bulk Cell&r holds a single item type in any amount. Perfect for cobblestone or ore dust."
		""
		"Add a &eCompression Card&r and it folds nuggets into ingots into blocks for you."
	]
	quest.2F77D386DE8211AB.quest_subtitle: "One item, no limit"
	quest.2F77D386DE8211AB.title: "Bulk Cell"
	quest.2F9BE0FD63D47F2D.quest_desc: [
		"&eWalnut&r trees grow on the plains now, and their leaves drop &eWalnuts&r."
		""
		"&eSquirrels&r live there too. Hold out a walnut and they'll follow you around."
	]
	quest.2F9BE0FD63D47F2D.quest_subtitle: "Walnuts on the plains"
	quest.2F9BE0FD63D47F2D.title: "Squirrel Food"
	quest.301FEA78C563D5E2.quest_desc: [
		"&eLight Engineering&r: iron sheetmetal, iron components and copper."
		"&eHeavy Engineering&r: steel sheetmetal, steel components and electrum."
		""
		"You'll need stacks of both once the multiblocks start."
	]
	quest.301FEA78C563D5E2.quest_subtitle: "The guts of every machine"
	quest.301FEA78C563D5E2.title: "Engineering Blocks"
	quest.3037BEAE28C265EE.quest_desc: [
		"Three cooked mutton, two baked potatoes, two onions, milk and a bowl."
	]
	quest.3037BEAE28C265EE.quest_subtitle: "Mutton and mash"
	quest.3037BEAE28C265EE.title: "Shepherd's Pie"
	quest.304A15483DD2FD58.quest_desc: [
		"The &eCore Sample Drill&r bores down and tells you which mineral deposit sits in this chunk."
		""
		"Take the Core Sample it spits out; it's a map note for the Excavator."
	]
	quest.304A15483DD2FD58.quest_subtitle: "What's under your feet?"
	quest.304A15483DD2FD58.title: "Mineral Surveying"
	quest.306B2B1BCDF24D0B.quest_desc: [
		"&eDog Food&r (in the pot) heals and buffs tamed wolves. &eHorse Feed&r does the same for horses."
		""
		"Feed them by right-clicking your pet."
	]
	quest.306B2B1BCDF24D0B.quest_subtitle: "Good boy!"
	quest.306B2B1BCDF24D0B.title: "Treats for Friends"
	quest.306D230DFB484BD0.quest_desc: [
		"Back down in the Troll Caves, a vault holds the &eLamp of Cinders&r. It burns away the thorns that guard the final plateau."
	]
	quest.306D230DFB484BD0.quest_subtitle: "Burn the thorns"
	quest.306D230DFB484BD0.title: "Lamp of Cinders"
	quest.30799A0E3F7B0F05.quest_desc: [
		"An Ender Storage &eEnder Chest&r shares its inventory with every other one that has the same three colors."
		""
		"Right-click the colored strips on top with dye to set the code. Two chests with the same code are the same chest."
	]
	quest.30799A0E3F7B0F05.quest_subtitle: "Same chest, two places"
	quest.30799A0E3F7B0F05.title: "Ender Chest (Colors!)"
	quest.3079B76D09CE6F1D.quest_desc: [
		"Cows, pigs and chickens now come in &ewarm&r and &bcold&r variants, depending on the biome."
		""
		"Warm chickens lay &6Brown Eggs&r, cold chickens lay &bBlue Eggs&r. In ICU both work in every egg recipe, including cake and pumpkin pie, and cook into Farmer's Delight &eFried Eggs&r."
	]
	quest.3079B76D09CE6F1D.quest_subtitle: "Warm and cold chickens"
	quest.3079B76D09CE6F1D.title: "Colored Eggs"
	quest.3086632FD75F57B4.quest_desc: [
		"Glowstone, a &eBrass Casing&r, a diamond block and a furnace. Give it sky and light and it slowly makes EMC."
		""
		"Put fuel inside and it'll upgrade it for you over time."
	]
	quest.3086632FD75F57B4.quest_subtitle: "EMC from sunlight"
	quest.3086632FD75F57B4.title: "Energy Collector"
	quest.309D0C3E585FB877.quest_desc: [
		"Kelp, salmon and cod rolls (rice plus fish or kelp) all go together for a &eRice Roll Medley&r."
	]
	quest.309D0C3E585FB877.quest_subtitle: "Sushi party"
	quest.309D0C3E585FB877.title: "Rice Roll Medley"
	quest.30BD81197102022D.quest_desc: [
		"Collector MK2 adds Dark Matter to an MK1, and MK3 adds Red Matter to an MK2."
	]
	quest.30BD81197102022D.quest_subtitle: "More EMC per tick"
	quest.30BD81197102022D.title: "Better Collectors"
	quest.30BFFF003355B7FE.quest_desc: [
		"Light the Levitite Blend with &esoul fire&r instead (a soul torch or a soul campfire) and it crystallizes into &ePearlescent Levitite&r."
	]
	quest.30BFFF003355B7FE.quest_subtitle: "Now in pink"
	quest.30BFFF003355B7FE.title: "Pearlescent Levitite"
	quest.30F4CFD53D513F59.quest_desc: [
		"Upgrade a diamond pickaxe with Inferium Ingots and Gemstones. Each tier builds on the last one."
		""
		"Essence gear has an augment slot. Armor works the same way."
	]
	quest.30F4CFD53D513F59.quest_subtitle: "Diamond tools, but better"
	quest.30F4CFD53D513F59.title: "Essence Gear"
	quest.31015ABE9AD5B02E.quest_desc: [
		"IF machines run on FE. The &ePitiful Generator&r burns anything a furnace would."
		""
		"Any FE source works too: Powah, IE wires, whatever you have."
	]
	quest.31015ABE9AD5B02E.quest_subtitle: "Humble beginnings"
	quest.31015ABE9AD5B02E.title: "Pitiful Generator"
	quest.312EF3F2C418D0CE.quest_desc: [
		"Augments slot into Iron Furnaces: &eSpeed&r smelts faster, &eFactory&r handles several stacks at once, and &eGenerator&r turns it into a power generator."
	]
	quest.312EF3F2C418D0CE.quest_subtitle: "Tune your furnace"
	quest.312EF3F2C418D0CE.title: "Furnace Augments"
	quest.3168069BC580EB61.quest_desc: [
		"Every block has a weight. ICU adds weight data for many modded blocks, so heavy machines and metal blocks make a ship much heavier than wood or wool."
		""
		"Craft a &eContraption Diagram&r (paper plus a Physics Assembler) and right-click it on your ship. It shows the mass, the center of mass and every force acting on it."
		""
		"Parts that lose their connection break off as their own contraption. A &eSlime Ball&r merges two back together. In the End, ships are weightless, so fly carefully up there."
	]
	quest.3168069BC580EB61.quest_subtitle: "Heavy blocks, heavy ship"
	quest.3168069BC580EB61.title: "Weight Matters"
	quest.31772C8ED6551CC8.quest_desc: [
		"A vanilla mace, an &eAllthemodium Block&r and the template. Because sometimes you want to fall on things."
	]
	quest.31772C8ED6551CC8.quest_subtitle: "Heavy hitter"
	quest.31772C8ED6551CC8.title: "Allthemodium Mace"
	quest.317943411781C22D.quest_desc: [
		"Eight redstone and a feather make a &eRedstone Quill&r. It draws thin redstone tracks on floors, walls and ceilings. Right-click to draw, left-click to erase."
		""
		"Tracks don't power the block they sit on. Click the center of a track to add a connector when you want that. Sneak and look at a block to see its signal strength."
	]
	quest.317943411781C22D.quest_subtitle: "The Pen's little sibling"
	quest.317943411781C22D.title: "Redstone Quill"
	quest.31960B57A60A6430.quest_desc: [
		"Build an &eInfusion Altar&r and eight &eInfusion Pedestals&r (stone, red wool, gold). Place the altar first; it shows where the pedestals go."
		""
		"Craft a &eWand&r too. Right-click the altar with it (or give it redstone) to start a recipe."
	]
	quest.31960B57A60A6430.quest_subtitle: "The seed maker"
	quest.31960B57A60A6430.title: "Infusion Altar"
	quest.31A9175BE6C50C06.quest_desc: [
		"The &eDrawer Key&r locks a drawer to its item, so it keeps its slot even when empty."
		"Other keys hide labels or show exact counts. Check EMI for the full set."
	]
	quest.31A9175BE6C50C06.quest_subtitle: "Lock it down"
	quest.31A9175BE6C50C06.title: "Keys and Tricks"
	quest.31B70F8232A7C088.quest_desc: [
		"Planks, wool, a cushion and a sheet make a &eFancy Bed&r."
		""
		"Change its pillow with a cushion and its bedsheet with a sheet whenever you like."
	]
	quest.31B70F8232A7C088.quest_subtitle: "Sweet dreams"
	quest.31B70F8232A7C088.title: "Fancy Bed"
	quest.32407E4387541C58.quest_desc: [
		"Place the Creaking Heart between two &ePale Oak Logs&r, lined up the same way as the heart."
	]
	quest.32407E4387541C58.quest_subtitle: "Give it a new home"
	quest.32407E4387541C58.title: "Heart Transplanter"
	quest.32526D10A8F884CC.quest_desc: [
		"The &eGimbal Sensor&r outputs a signal on the downhill side, which is perfect for self-leveling."
		"The &eOptical Sensor&r casts a beam and reports how far away a block is. Use it for landing or anti-crash."
	]
	quest.32526D10A8F884CC.quest_subtitle: "Balance and eyes"
	quest.32526D10A8F884CC.title: "Gimbal and Optical Sensors"
	quest.32C302C45F26B0EF.quest_desc: [
		"...the Teleport Pad does something different when you use it in the Nether."
	]
	quest.32C302C45F26B0EF.quest_subtitle: "Rumor has it..."
	quest.32C302C45F26B0EF.title: "The Other"
	quest.32F3B5D8CB4780D8.quest_desc: [
		"A Turbine is a casing box with a &eRotor Bearing&r on one face, a line of &eRotor Shafts&r, and &eRotor Blades&r around the shaft."
		""
		"Coil blocks around the end of the shaft make the power. Check a block's advanced tooltip (F3+H) to see if it's a valid coil."
	]
	quest.32F3B5D8CB4780D8.quest_subtitle: "Steam into power"
	quest.32F3B5D8CB4780D8.title: "Turbine Parts"
	quest.330ED762856A6476.quest_desc: [
		"&ePalm&r trees lean over the Tropics and the Lush Desert. &eMahogany&r grows in the Rainforest and the Rocky Rainforest."
		""
		"Pack light, it's warm out there."
	]
	quest.330ED762856A6476.quest_subtitle: "Palm and mahogany"
	quest.330ED762856A6476.title: "Tropical Timber"
	quest.338C85ED2AC18D39.quest_desc: [
		"Smelt a honey block into &eCrystallized Honey&r. An end rod, a honey bottle and a gold nugget make a &eHoney Lamp&r."
		""
		"A &eHoney Apple&r cures levitation, if a shulker ever gets you."
	]
	quest.338C85ED2AC18D39.quest_subtitle: "Buzzier Bees decor"
	quest.338C85ED2AC18D39.title: "Sweet Lighting"
	quest.33A2E74B980F807D.quest_desc: [
		"A crafting table, an iron block, Basic Components, a Basic Catalyst and a Black Iron Slate."
		""
		"Extended tables keep their items when you close them. They grow to 5x5, 7x7 and 9x9: each one is made from the tier below."
	]
	quest.33A2E74B980F807D.quest_subtitle: "3x3, but it keeps its items"
	quest.33A2E74B980F807D.title: "Basic Crafting Table"
	quest.33C94C242EE446A8.quest_desc: [
		"Smelt your raw Allthemodium. This metal opens most of Tier 3."
	]
	quest.33C94C242EE446A8.quest_subtitle: "The yellow key to Tier 3"
	quest.33C94C242EE446A8.title: "Allthemodium Ingot"
	quest.33E48E30793D3ED8.quest_desc: [
		"A big Mechanical Crafter recipe with a whole &eBiplane&r in it, plus copper casings and industrial iron windows."
		""
		"Three seats and pontoons, so it can land safely on water."
	]
	quest.33E48E30793D3ED8.quest_subtitle: "Lands on water"
	quest.33E48E30793D3ED8.title: "Bamboo Hopper"
	quest.3401B02BA5DF53F5.quest_desc: [
		"&eRefill&r tops up the stack in your hand (torches, blocks) from the backpack."
		"&eTool Swapper&r picks the best tool from the backpack for whatever you are hitting."
	]
	quest.3401B02BA5DF53F5.quest_subtitle: "The right tool, every time"
	quest.3401B02BA5DF53F5.title: "Refill and Tool Swapper"
	quest.3416F20AB57FA1E0.quest_desc: [
		"A &eReturn Scroll&r sends you back to your spawn point. A &eWarp Scroll&r opens the waystone menu once."
		"Use a &eBlank Scroll&r on a waystone to make a &eBound Scroll&r that always takes you there."
	]
	quest.3416F20AB57FA1E0.quest_subtitle: "Single-use tickets"
	quest.3416F20AB57FA1E0.title: "Scrolls"
	quest.3447698DEE3EAE8B.quest_desc: [
		"Make a bed early. It skips the night and sets where you respawn."
		""
		"Any color works; the quest just asks for a white one."
	]
	quest.3447698DEE3EAE8B.quest_subtitle: "Skip the night, set your spawn"
	quest.3447698DEE3EAE8B.title: "Sleep Tight"
	quest.344CB52EE7BAE331.quest_desc: [
		"&eRats&r live all over the Overworld. Wild ones sneak into chests and steal food, and a &cPlague Rat&r can make you sick."
		""
		"Tamed rats are the opposite: little workers that fetch, farm, craft and fight for you."
		""
		"&6Heads up:&r in ICU wild rats do &onot&r dig holes through your walls. They still raid chests, so keep your food somewhere safe."
	]
	quest.344CB52EE7BAE331.quest_subtitle: "Small, clever and hungry"
	quest.344CB52EE7BAE331.title: "Rats!"
	quest.3495AF1842660867.quest_desc: [
		"&eFission Reactor Ports&r move fuel, coolant, steam and waste. A &eLogic Adapter&r can shut the reactor down by redstone."
		""
		"&6Heads up:&r if the waste tank fills up or the temperature gets too high, the reactor melts down, explodes and spreads radiation. Always pipe waste away and set the Logic Adapter to SCRAM."
	]
	quest.3495AF1842660867.quest_subtitle: "Read this before you turn it on"
	quest.3495AF1842660867.title: "Ports and Safety"
	quest.349D48C671BEA6E2.quest_desc: [
		"Find a set of &eCatacombs&r. The chests inside can hold Forgotten Nuggets and the smithing template you'll need next."
	]
	quest.349D48C671BEA6E2.quest_subtitle: "Forgotten halls"
	quest.349D48C671BEA6E2.title: "Catacombs"
	quest.34B5739695F15837.quest_desc: [
		"The &eErupting Inferno&r is the Nether at its angriest: lava lakes, lava springs and fumaroles."
		""
		"Mine its &eBrimstone&r. Four make Brimstone Bricks, and brimstone around a fire charge makes your own &eBrimstone Fumarole&r."
	]
	quest.34B5739695F15837.quest_subtitle: "The Erupting Inferno"
	quest.34B5739695F15837.title: "Brimstone"
	quest.34B7D041DDC012E2.quest_desc: [
		"Iron, graphite and sand make &eReactor Casing&r. A first reactor needs about 22 of them."
		""
		"&eReactor Glass&r can replace casing on the sides so you can see inside."
	]
	quest.34B7D041DDC012E2.quest_subtitle: "The shell"
	quest.34B7D041DDC012E2.title: "Reactor Casing"
	quest.34BE22FF15BF329D.quest_desc: [
		"The &eMob Masher&r kills mobs, and its kills count as player kills, so you get the rare drops."
		""
		"Add Masher upgrades for looting, sharpness and more."
	]
	quest.34BE22FF15BF329D.quest_subtitle: "A proper mob grinder"
	quest.34BE22FF15BF329D.title: "Mob Masher"
	quest.34C8F8ED79226EB2.quest_desc: [
		"A shulker box and a netherite ingot make a &eSafe&r. Gold makes a &eKey&r."
		""
		"Lock the safe to a key and only whoever holds that key can open it. Good for shared bases."
	]
	quest.34C8F8ED79226EB2.quest_subtitle: "Hands off"
	quest.34C8F8ED79226EB2.title: "Safe"
	quest.34CC232488B9BA5D.quest_desc: [
		"Four sticks make a &eTimber Frame&r. Place it over any full block to frame it, or fill it with &eDaub&r (clay and straw) for classic wattle and daub."
		""
		"An axe strips the frame off again and leaves the block inside."
	]
	quest.34CC232488B9BA5D.quest_subtitle: "Tudor, but blocky"
	quest.34CC232488B9BA5D.title: "Timber Framing"
	quest.350DE6736B4D078E.quest_desc: [
		"An Illuminated Panel, a Logic Processor and an ME Requester, shapeless."
		""
		"The &eME Requester Terminal&r shows every Requester on the network, so you can change what to keep in stock from one screen. With AE2 Wireless Terminals there's a wireless version too."
	]
	quest.350DE6736B4D078E.quest_subtitle: "All your stock orders"
	quest.350DE6736B4D078E.title: "Requester Terminal"
	quest.352355E22B086BE8.quest_desc: [
		"A 2x2 pool of water ringed with flowers or grass, plus one diamond tossed in."
	]
	quest.352355E22B086BE8.quest_subtitle: "Always dusk, always spooky"
	quest.352355E22B086BE8.title: "The Twilight Forest"
	quest.35315404B8FF2B4D.quest_desc: [
		"&eOffroad&r adds ground vehicles. A &eWheel Mount&r (with a spring for suspension) holds a tire. Right-click the mount with a tire."
		""
		"Power the top of the mount to brake and a side to steer. Tires come in small, normal, large and monstrous."
	]
	quest.35315404B8FF2B4D.quest_subtitle: "Cars, trucks and rovers"
	quest.35315404B8FF2B4D.title: "Offroad: Wheels"
	quest.3555C4650E5628B4.quest_desc: [
		"The &eOven&r (bricks, iron bars and a smoker) works just like a smoker. &eCounters&r take calcite on top; right-click one with wood or stone to change the surface."
		""
		"Slabs make &eWood Plates&r and &eWood Cups&r. Put one of each together for a &eCrockery Combo&r, then right-click it with any item to set that on the plate."
	]
	quest.3555C4650E5628B4.quest_subtitle: "Cook in style"
	quest.3555C4650E5628B4.title: "Kitchen"
	quest.355AFBA300ACC37C.quest_desc: [
		"You'll want diamonds for AE2 storage cells, Powah and plenty of tools. Dig deep, around the bottom of the world."
	]
	quest.355AFBA300ACC37C.quest_subtitle: "Diamonds are still a big deal"
	quest.355AFBA300ACC37C.title: "Shiny!"
	quest.356933D0C48BA026.quest_desc: [
		"Got Create? Your kitchen can run itself:"
		""
		"A fed &eBlaze Burner&r works as the heat under a Cooking Pot or Skillet, and a hotter one cooks some things faster."
		"A &eFunnel&r takes the finished meals out of a Cooking Pot."
		"A &eMechanical Arm&r puts food on a Cutting Board. A &eDeployer&r holding a knife, or a &eMechanical Saw&r, cuts it."
		"Mechanical Arms also serve feasts and take slices from pies."
		""
		"To see it in action, hover a Cooking Pot or Cutting Board and hold &eW&r."
	]
	quest.356933D0C48BA026.quest_subtitle: "Let Create do the cooking"
	quest.356933D0C48BA026.title: "Automated Kitchen"
	quest.35CB1860BEC7606E.quest_desc: [
		"&eMEGA Crafting Units&r and &e1M Crafting Storage&r build CPUs that plan huge crafts."
		""
		"A &eMEGA Pattern Provider&r is a Pattern Provider plus an Accumulation Processor, with more slots."
	]
	quest.35CB1860BEC7606E.quest_subtitle: "Bigger jobs"
	quest.35CB1860BEC7606E.title: "MEGA Crafting"
	quest.35F57E37B26D130A.quest_desc: [
		"Build a Glowstone frame shaped like a Nether portal and pour water inside."
	]
	quest.35F57E37B26D130A.quest_subtitle: "Up, up and away"
	quest.35F57E37B26D130A.title: "The Aether"
	quest.360FAB4F319BF795.quest_desc: [
		"The Advanced table (or its Auto version), a diamond block, Elite Components and an Elite Catalyst."
	]
	quest.360FAB4F319BF795.quest_subtitle: "The 7x7 table"
	quest.360FAB4F319BF795.title: "Elite Crafting Table"
	quest.362725CC06AED795.quest_desc: [
		"A giant ice beast that roams the snowy lands."
	]
	quest.362725CC06AED795.quest_subtitle: "Mowzie's Mobs"
	quest.362725CC06AED795.title: "Frostmaw"
	quest.3658B7C86722CDC5.quest_desc: [
		"Place an Energizing Orb near powered Energizing Rods to fuse items with energy."
		""
		"Powah's better crystals are all made here, and in ICU the fancy ones need rare metals."
	]
	quest.3658B7C86722CDC5.quest_subtitle: "Zap items into better items"
	quest.3658B7C86722CDC5.title: "Energizing Orb"
	quest.36720522CAF4626F.quest_desc: [
		"Nuclear waste and a broken reactor both leak &cradiation&r. A full &eHazmat&r suit protects you."
		""
		"Carry a &eGeiger Counter&r to check an area before you walk into it."
	]
	quest.36720522CAF4626F.quest_subtitle: "Dress for the job"
	quest.36720522CAF4626F.title: "Radiation Safety"
	quest.3691ECC02029EDF9.quest_desc: [
		"The Harbinger's home is the &eAncient Factory&r. An Explorer's Compass helps you find it."
	]
	quest.3691ECC02029EDF9.quest_subtitle: "Something big is humming"
	quest.3691ECC02029EDF9.title: "Find the Ancient Factory"
	quest.36970FA465FC4B39.quest_desc: [
		"Brush &eSuspicious Soul Sand&r in Bastion treasure rooms for a &eVibranium Smithing Template&r."
		""
		"Copy it with seven Allthemodium Ingots and &eAncient Stone&r."
	]
	quest.36970FA465FC4B39.quest_subtitle: "Bastion treasure"
	quest.36970FA465FC4B39.title: "Vibranium Template"
	quest.3697F3045165A9C7.quest_desc: [
		"The &eArchmage's Tower&r is a mage's home built for Ars Nouveau, found in the same kinds of places as wizard towers."
		""
		"Good hunting for a budding spellcaster."
	]
	quest.3697F3045165A9C7.quest_subtitle: "An Ars Nouveau hideout"
	quest.3697F3045165A9C7.title: "Archmage's Tower"
	quest.370FB45C42F8B245.quest_desc: [
		"Blueprints are blue dye and paper with a few items on top. The &eComponents&r blueprint uses copper, lead and iron ingots; the &eMolds&r blueprint uses an iron plate."
		""
		"Check EMI for the rest (bullets, electrodes and more)."
	]
	quest.370FB45C42F8B245.quest_subtitle: "Plans, not magic"
	quest.370FB45C42F8B245.title: "Blueprints"
	quest.3734A16DE97D3A2C.quest_desc: [
		"An armored brute in an underground Wrought Chamber."
	]
	quest.3734A16DE97D3A2C.quest_subtitle: "Mowzie's Mobs"
	quest.3734A16DE97D3A2C.title: "Ferrous Wroughtnaut"
	quest.37369D8B607A20D1.quest_desc: [
		"Bosses always drop their trophy. Collect one of each major boss for your wall."
	]
	quest.37369D8B607A20D1.quest_subtitle: "Every head on the wall"
	quest.37369D8B607A20D1.title: "Trophy Room"
	quest.3740B69512F446EB.quest_desc: [
		"Extreme Reactors normally uses Yellorium. In ICU it's merged into Mekanism &eUranium&r, so uranium ingots do the job."
		""
		"Mine Uranium ore and smelt it. Keep a stack handy: it's both a crafting part and the fuel."
	]
	quest.3740B69512F446EB.quest_subtitle: "One metal, two names"
	quest.3740B69512F446EB.title: "Uranium Is Yellorium"
	quest.374AB680A7148C6E.quest_desc: [
		"Wide and narrow gauge tracks take their own bogeys, from tiny trams to huge freight trains."
		""
		"A train can only run on the gauge its bogeys fit."
	]
	quest.374AB680A7148C6E.quest_subtitle: "Size matters"
	quest.374AB680A7148C6E.title: "Wide and Narrow Gauge"
	quest.3783118E8CB084AD.quest_desc: [
		"An &eiron ingot&r and &eblack dye&r make a Black Iron Ingot. Craft one into a &eBlack Iron Slate&r."
		""
		"Almost every Extended Crafting part starts with these two."
	]
	quest.3783118E8CB084AD.quest_subtitle: "Where it all starts"
	quest.3783118E8CB084AD.title: "Black Iron"
	quest.37A89D15C1F1ABD3.quest_desc: [
		"Wear &eEngineer's Goggles&r and look at machines to see their speed, stress and contents."
		""
		"The &eWrench&r rotates blocks, and sneak-right-click picks them up instantly. Use it constantly."
	]
	quest.37A89D15C1F1ABD3.quest_subtitle: "Goggles and a wrench"
	quest.37A89D15C1F1ABD3.title: "See the Invisible"
	quest.37AB78FE91035226.quest_desc: [
		"Ring an emerald with four redstone to make a &eRuby&r. Ruby tools are the toughest gem set: diamond speed and 960 uses."
		""
		"&6Heads up:&r ICU unifies rubies, so EMI shows the gem as the AllTheOres Ruby. It's the same gem for every ruby recipe."
	]
	quest.37AB78FE91035226.quest_subtitle: "Emerald, but angrier"
	quest.37AB78FE91035226.title: "Ruby Tools"
	quest.37B5BB606979DFC0.quest_desc: [
		"Wheat and milk make a &ePie Crust&r. Add apples, sugar and wheat for an &eApple Pie&r."
		""
		"Place it and eat it slice by slice, or cut it on the board."
	]
	quest.37B5BB606979DFC0.quest_subtitle: "Slice it up"
	quest.37B5BB606979DFC0.title: "Apple Pie"
	quest.37BC8BBE924F0BBE.quest_desc: [
		"The &eRedstone Randomizer&r sends a signal out of its left or right side at random."
		""
		"The &eEnder Watcher&r gives off a stronger signal the closer a player looks to the center of its eye. Secret doors, anyone?"
	]
	quest.37BC8BBE924F0BBE.quest_subtitle: "Randomness and staring contests"
	quest.37BC8BBE924F0BBE.title: "Redstone Oddballs"
	quest.37BD3C282A616F8B.quest_desc: [
		"Eight diamonds around a Gold Backpack. This is the last crafting-table tier."
	]
	quest.37BD3C282A616F8B.quest_subtitle: "Now we're packing"
	quest.37BD3C282A616F8B.title: "Diamond Backpack"
	quest.37C0EB400D953539.quest_desc: [
		"Look for wild plants: &ecabbages&r on beaches, &eonions&r in plains and forests, &etomatoes&r in savannas and deserts, &erice&r in swamp and jungle ponds."
		""
		"Break them for seeds and a first harvest."
	]
	quest.37C0EB400D953539.quest_subtitle: "Go foraging"
	quest.37C0EB400D953539.title: "Wild Crops"
	quest.37C43A0E90CB50A9.quest_desc: [
		"The &eHot Air Burner&r (iron sheets, a coal block, redstone and andesite alloy) fills the balloon above it when it gets a redstone signal."
		""
		"Stronger signal, more hot air. More burners can share one balloon. Lift gets weaker as you climb, so the ship levels off by itself."
	]
	quest.37C43A0E90CB50A9.quest_subtitle: "Up, up and away"
	quest.37C43A0E90CB50A9.title: "Hot Air Burner"
	quest.37C7BDDE8555C8EB.quest_desc: [
		"It vacuums up items and XP orbs in a 7x7x7 area. XP goes into a &eSingularity Tank&r as fluid."
	]
	quest.37C7BDDE8555C8EB.quest_subtitle: "Items and XP, collected"
	quest.37C7BDDE8555C8EB.title: "Absorption Hopper"
	quest.38060B05E6174914.quest_desc: [
		"Advanced factories and installers need an &eAdvanced Control Circuit&r."
	]
	quest.38060B05E6174914.quest_subtitle: "Five slots"
	quest.38060B05E6174914.title: "Advanced Factory"
	quest.38106165790673B6.quest_desc: [
		"&eDocking Connectors&r lock two contraptions together once they line up (Mechanical Crafter recipe)."
		""
		"When docked, items and fluids can pass through in either direction. Retract either side to let go."
	]
	quest.38106165790673B6.quest_subtitle: "Park it properly"
	quest.38106165790673B6.title: "Docking Connectors"
	quest.382AB8AF62600EA7.quest_desc: [
		"Stone and Soulium Dust make a &eTinkering Table&r. Use it to slot augments into essence tools and armor."
		""
		"Night vision, speed, step assist and even flight are in there. Each augment needs a minimum gear tier."
	]
	quest.382AB8AF62600EA7.quest_subtitle: "Add augments"
	quest.382AB8AF62600EA7.title: "Tinkering Table"
	quest.38443B7253517EFB.quest_desc: [
		"&eCrabs&r scuttle along beaches and through Mangrove Swamps. They drop a &eCrab Claw&r."
		""
		"Brew a claw into an Awkward Potion for a &ePotion of Reaching&r: you can reach blocks from further away. &6Heads up:&r Ecologics' Coconut Crab drops a different Crab Claw, and that one doesn't brew into Reaching."
	]
	quest.38443B7253517EFB.quest_subtitle: "Crab claws and reach"
	quest.38443B7253517EFB.title: "Long Arms"
	quest.385C629EE429CC7C.quest_desc: [
		"Energize a diamond with an &eIgnitium Ingot&r."
	]
	quest.385C629EE429CC7C.quest_subtitle: "Shiny and blue"
	quest.385C629EE429CC7C.title: "Niotic Crystal"
	quest.38641F9FD781274D.quest_desc: [
		"Combine &eFiery Blood&r (from the Hydra) or &eFiery Tears&r (from the Ur-Ghast) with an iron ingot."
		""
		"&6Budget them:&r every Advanced Control Circuit uses one Fiery Ingot, and every Elite and Ultimate circuit is built from one. A Hydra drops 7 to 10 Fiery Blood (Looting adds more)."
	]
	quest.38641F9FD781274D.quest_subtitle: "Hot metal"
	quest.38641F9FD781274D.title: "Fiery Ingot"
	quest.386B317EDFD57283.quest_desc: [
		"Every quest here is just a checkmark. Read it, tick it, move on."
		""
		"Stuck on something that isn't here? Hover the item: some of ICU's rare items explain themselves in the tooltip and in EMI."
	]
	quest.386B317EDFD57283.quest_subtitle: "Quick answers, no tasks"
	quest.386B317EDFD57283.title: "Tips and How-To"
	quest.3896A4B586181037.quest_desc: [
		"The &eTrain Coupler&r joins and splits trains without taking them apart. Place it next to a selected track."
		""
		"A station helps line the carriages up. Redstone triggers it."
	]
	quest.3896A4B586181037.quest_subtitle: "Join and split trains"
	quest.3896A4B586181037.title: "Train Coupler"
	quest.38A8F211E8220BDF.quest_desc: [
		"Hold a dye in your other hand when you light the Levitite Blend. The whole crystal grows in that color."
		""
		"Already have plain Levitite? Blow a fan through &eLiquid Dye&r (Create: Dragons Plus) onto it to recolor it."
	]
	quest.38A8F211E8220BDF.quest_subtitle: "Floating rocks, now in color"
	quest.38A8F211E8220BDF.title: "Colored Levitite"
	quest.38ADCB3F3E8AE0D4.quest_desc: [
		"&eBlue Bombs&r can't be crafted. The rare &eRed Merchant&r trades them for a bomb and 40 emeralds, and they very rarely turn up in temple chests."
		""
		"&6Heads up:&r in ICU a Blue Bomb has a big blast and then scatters five little bombs that set things on fire. Stand well back."
	]
	quest.38ADCB3F3E8AE0D4.quest_subtitle: "Handle with care"
	quest.38ADCB3F3E8AE0D4.title: "Blue Bomb"
	quest.38B1D23B01994741.quest_desc: [
		"Copper and obsidian tools and armor harvest like iron."
		""
		"Copper tools last 250 uses and obsidian ones 650. Handy while you're still short on diamonds."
	]
	quest.38B1D23B01994741.quest_subtitle: "Budget options"
	quest.38B1D23B01994741.title: "Copper and Obsidian"
	quest.38E610A671758074.quest_desc: [
		"The &ePackager&r turns ingredients into Recipe Packages for the recipes in its holder. The &eUnpackager&r opens a full set of packages into the inventory or crafting machine next to it."
		""
		"Both need power."
	]
	quest.38E610A671758074.quest_subtitle: "Pack it, ship it, open it"
	quest.38E610A671758074.title: "Packager and Unpackager"
	quest.395F8C9DEB359924.quest_desc: [
		"Follow Eyes of Ender to a Stronghold and fill the portal frame."
	]
	quest.395F8C9DEB359924.quest_subtitle: "Not actually the end"
	quest.395F8C9DEB359924.title: "The End"
	quest.397BC0AFAAB3184E.quest_desc: [
		"The &eGlowing Grotto&r is a cave biome full of giant glowshrooms and dangling silk."
		""
		"Pick some &eGlowshrooms&r, and use shears on the strands for &eGlowworm Silk&r."
	]
	quest.397BC0AFAAB3184E.quest_subtitle: "Lights down below"
	quest.397BC0AFAAB3184E.title: "Glowing Grotto"
	quest.398D49173D7FE1A2.quest_desc: [
		"Print Sky Steel with the new press, then press it with Printed Silicon and fluix dust."
		""
		"&6Heads up:&r ICU's 64M and 256M components need these too, so make a stack."
	]
	quest.398D49173D7FE1A2.quest_subtitle: "MEGA's brain"
	quest.398D49173D7FE1A2.title: "Accumulation Processor"
	quest.399BD26931F1061E.quest_desc: [
		"Iron Generator plus gold. Still solid fuel, still better."
	]
	quest.399BD26931F1061E.quest_subtitle: "Shiny and faster"
	quest.399BD26931F1061E.title: "Gold Generator"
	quest.39A09502B9AE8E52.quest_desc: [
		"The &eFeeding Upgrade&r eats food from the backpack when you get hungry."
		""
		"It costs a golden apple, a golden carrot, a glistering melon and an ender pearl, and it's worth it."
	]
	quest.39A09502B9AE8E52.quest_subtitle: "Never go hungry again"
	quest.39A09502B9AE8E52.title: "Feeding Upgrade"
	quest.39AF98FC109927A2.quest_desc: [
		"In the Dissolution Chamber, two iron, two gold and 1000 mB of Pink Slime make a &ePink Slime Ingot&r."
		""
		"Keep a tank of Pink Slime around; the Advanced Frame needs it."
	]
	quest.39AF98FC109927A2.quest_subtitle: "Squishy metal"
	quest.39AF98FC109927A2.title: "Pink Slime"
	quest.39D1B2BD3FE79DFD.quest_desc: [
		"The &eSmelting Upgrade&r is a furnace in your backpack. Its &eAuto-Smelting&r version pulls ore and fuel from the backpack and cooks it by itself."
		""
		"There are Smoking and Blasting versions too. Check EMI (R on the item)."
	]
	quest.39D1B2BD3FE79DFD.quest_subtitle: "Cook while you walk"
	quest.39D1B2BD3FE79DFD.title: "Smelting Upgrades"
	quest.39DDDAAFC3E4D82A.quest_desc: [
		"Four gold ingots around a gem make a &eJuju&r. Keep one anywhere in your inventory:"
		"&eEmerald Juju&r: Water Breathing. &eRuby Juju&r: Fire Resistance."
		"&eAmethyst Juju&r: Night Vision. Right-click it to switch it on or off."
	]
	quest.39DDDAAFC3E4D82A.quest_subtitle: "Lucky charms"
	quest.39DDDAAFC3E4D82A.title: "Jujus"
	quest.3A34E217F34F0D5B.quest_desc: [
		"Amethyst, gold and an Eye of Ender make a &eDimensional Core&r, the heart of Owl's Pocket Dimension."
	]
	quest.3A34E217F34F0D5B.quest_subtitle: "Infinite potential"
	quest.3A34E217F34F0D5B.title: "Dimensional Core"
	quest.3A395AB8407CCD1F.quest_desc: [
		"Wild Starbuncles love gold nuggets. Hold one out, and when a Starbuncle picks it up it leaves a &eStarbuncle Token&r."
		""
		"Four gold ingots around the token on the apparatus make a charm. Wand a chest then the Starbuncle to take, the Starbuncle then a chest to deliver."
	]
	quest.3A395AB8407CCD1F.quest_subtitle: "A tiny courier"
	quest.3A395AB8407CCD1F.title: "Starbuncle"
	quest.3A527E85A04400B8.quest_desc: [
		"Minotaurs and Labyrinth chests drop the &eMaze Map Focus&r."
		""
		"Put it in paper for a Maze Map. Add a block of iron, gold and diamond to that for an Ore Map."
	]
	quest.3A527E85A04400B8.quest_subtitle: "Minotaurs have the best stuff"
	quest.3A527E85A04400B8.title: "Maze Map Focus"
	quest.3ABB14B8AF27A224.quest_desc: [
		"Break the Witherite Block into nine ingots."
	]
	quest.3ABB14B8AF27A224.quest_subtitle: "Nine for the price of one"
	quest.3ABB14B8AF27A224.title: "Witherite"
	quest.3AE127DBB8843D84.quest_desc: [
		"Eight iron ingots around a furnace make an &eIron Furnace&r, and it smelts faster than vanilla."
		""
		"Use &eupgrade kits&r to change a placed furnace to the next tier without losing its contents."
	]
	quest.3AE127DBB8843D84.quest_subtitle: "Faster smelting"
	quest.3AE127DBB8843D84.title: "Iron Furnaces"
	quest.3B05217951162495.quest_desc: [
		"A dye and a water bucket make a bucket of colored water. Add glowstone dust or a glow ink sac to make it glow."
		""
		"Lava works too: a lava bucket and a dye make colored lava, and a second dye makes it dimmer. Colored lava is &creal lava&r: it burns, lights nearby wood and turns to obsidian or cobblestone next to water. Keep it away from wooden builds."
	]
	quest.3B05217951162495.quest_subtitle: "Pools in every color"
	quest.3B05217951162495.title: "Colored Water"
	quest.3B1AA3A41ED43E45.quest_desc: [
		"A Scribe's Table wrapped in Magebloom Fiber makes the &eAlteration Table&r. Use it to put &eThreads&r into magical armor."
		""
		"Blank Threads are fiber and gold nuggets. Turn them into real threads on the apparatus."
	]
	quest.3B1AA3A41ED43E45.quest_subtitle: "Slot in some threads"
	quest.3B1AA3A41ED43E45.title: "Alteration Table"
	quest.3B39B82B99E05218.quest_desc: [
		"The Ender Guardian drops the &eGauntlet of Guard&r. Right-click to pull enemies to you."
	]
	quest.3B39B82B99E05218.quest_subtitle: "Get over here!"
	quest.3B39B82B99E05218.title: "Gauntlet of Guard"
	quest.3B3B3BE4BA4656A1.quest_desc: [
		"Stack a Carved Gloomgourd on a Block of Forgotten Metal to build a little Forgotten Minion that helps guard your base."
	]
	quest.3B3B3BE4BA4656A1.quest_subtitle: "Forgotten Minion"
	quest.3B3B3BE4BA4656A1.title: "Build a Sentry"
	quest.3B47AED25AF0B8B8.quest_desc: [
		"Tracks come from sequenced assembly: deploy nuggets onto a slab, then press it. Check EMI for the exact steps."
		""
		"Click a placed track, then another spot, to lay long curves and slopes in one go."
	]
	quest.3B47AED25AF0B8B8.quest_subtitle: "Lay some line"
	quest.3B47AED25AF0B8B8.title: "Train Tracks"
	quest.3B5103D261A6E4D2.quest_desc: [
		"The Hydra drops a stack of &eHydra Chops&r. Eat one while nearly starving for an extra treat."
	]
	quest.3B5103D261A6E4D2.quest_subtitle: "Emergency dinner"
	quest.3B5103D261A6E4D2.title: "Hydra Chop"
	quest.3B518C0D595EA011.quest_desc: [
		"Three Dark Matter, five Aeternalis Fuel and a &eVibranium Nugget&r. Red Matter tools and armor are stronger still."
	]
	quest.3B518C0D595EA011.quest_subtitle: "Dark Matter, but angrier"
	quest.3B518C0D595EA011.title: "Red Matter"
	quest.3B82CF7B8757CCDA.quest_desc: [
		"If you die, your things stay safe in a &ecorpse&r where you fell. Walk back and open it to get everything back."
		""
		"Your minimap marks the spot, so you won't have to search for long."
	]
	quest.3B82CF7B8757CCDA.quest_subtitle: "It happens to the best of us"
	quest.3B82CF7B8757CCDA.title: "When Things Go Wrong"
	quest.3BAFFDBC16006F67.quest_desc: [
		"A normal crafting table wants eight diamonds and a netherite scrap per &eDiamond Lattice&r."
		"The Sculk table's recipe only needs four diamonds. Use it!"
	]
	quest.3BAFFDBC16006F67.quest_subtitle: "Cheaper in the Sculk table"
	quest.3BAFFDBC16006F67.title: "Diamond Lattice"
	quest.3BC46B72BBE15E68.quest_desc: [
		"Each Lich drops one scepter: Twilight (shoots), Life Draining (heals you), Zombie (summons help) or Fortification (shields)."
		""
		"Have all four at once to finish this. Other Lich Towers are fair game."
	]
	quest.3BC46B72BBE15E68.quest_subtitle: "Collect all four"
	quest.3BC46B72BBE15E68.title: "The Lich's Scepters"
	quest.3BDE10A84B75CC93.quest_desc: [
		"In ICU, every &eElder Guardian&r drops a &eTrident Fragment&r."
		""
		"Three fragments and two prismarine shards craft a brand new Trident. An ocean monument has three Elder Guardians, which is exactly enough."
	]
	quest.3BDE10A84B75CC93.quest_subtitle: "A trident without the drowned"
	quest.3BDE10A84B75CC93.title: "Trident Fragments"
	quest.3BEE09950FE2F5D5.quest_desc: [
		"A 5x5 job for the &eMechanical Crafter&r: eight Sturdy Sheets, four Precision Mechanisms, four Brass Casings, three Electron Tubes, a Rotation Speed Controller and a Block of Experience."
		""
		"Build a 5x5 block of crafters. EMI shows where each part goes."
	]
	quest.3BEE09950FE2F5D5.quest_subtitle: "Create's finest clockwork"
	quest.3BEE09950FE2F5D5.title: "Kinetic Seal"
	quest.3C3C12FA3570851B.quest_desc: [
		"Craft your Novice book with obsidian, three diamonds, two quartz blocks and two blaze rods."
		""
		"The &eMage's Spell Book&r can use Tier 2 glyphs, and every glyph you learned comes with it."
	]
	quest.3C3C12FA3570851B.quest_subtitle: "Tier 2 spells unlocked"
	quest.3C3C12FA3570851B.title: "Mage's Spell Book"
	quest.3C5AA0B356467ACB.quest_desc: [
		"In the Dissolution Chamber: a Pity Frame, two plastic, two nether bricks, two iron, a gold gear and 250 mB of Latex."
	]
	quest.3C5AA0B356467ACB.quest_subtitle: "One step up"
	quest.3C5AA0B356467ACB.title: "Simple Machine Frame"
	quest.3C7DCDC5DE5B0446.quest_desc: [
		"A Wireless Receiver on top, the terminal in the middle and a Dense Energy Cell below make a wireless &ePattern Encoding&r or &ePattern Access&r terminal."
		""
		"You can also upgrade a Wireless Crafting Terminal with an Engineering Processor. Both fit into the Universal Terminal."
	]
	quest.3C7DCDC5DE5B0446.quest_subtitle: "Encode from anywhere"
	quest.3C7DCDC5DE5B0446.title: "Wireless Patterns"
	quest.3C8ABCBA363FF41B.quest_desc: [
		"Plant a seed in the &eGarden Cloche&r, add dirt, give it power and water. It grows crops indoors, no light needed."
		""
		"Fertilizer speeds it up."
	]
	quest.3C8ABCBA363FF41B.quest_subtitle: "A farm in a jar"
	quest.3C8ABCBA363FF41B.title: "Garden Cloche"
	quest.3CA89A9354ADFF86.quest_desc: [
		"&eInventory Pets&r are items. Carry one and right-click it (or sneak and right-click) to use its ability. Hover a pet to see what it does."
		""
		"&6Heads up:&r pets get hungry in ICU. Each one has a favorite food listed in its tooltip, so keep some on you."
	]
	quest.3CA89A9354ADFF86.quest_subtitle: "They ride in your inventory"
	quest.3CA89A9354ADFF86.title: "Pocket Pets"
	quest.3CC6747925F5AA93.quest_desc: [
		"Three Supremium Essence, an Infusion Crystal and an &eUnobtainium Nugget&r."
	]
	quest.3CC6747925F5AA93.quest_subtitle: "Farming goes too far"
	quest.3CC6747925F5AA93.title: "Insanium Essence"
	quest.3CC837BA6D770F43.quest_desc: [
		"A &eBasic Spell Turret&r casts an inscribed Touch or Projectile spell when powered, drawing Source from nearby jars."
		""
		"Upgrade it on the apparatus (a Source Gem Block and two blaze rods) to the &eEnchanted&r turret, which casts for half the Source. Great for tiny farms and quarries."
	]
	quest.3CC837BA6D770F43.quest_subtitle: "Magic dispensers"
	quest.3CC837BA6D770F43.title: "Spell Turrets"
	quest.3CD546BAD48CA2C8.quest_desc: [
		"Craft &eSoul Jars&r and a &eSoulium Dagger&r (Soulium, Soulium Dust and a golden sword)."
		""
		"Kill mobs with the dagger while an empty jar is in your inventory, and their souls fill it."
	]
	quest.3CD546BAD48CA2C8.quest_subtitle: "Catch some souls"
	quest.3CD546BAD48CA2C8.title: "Soul Jars"
	quest.3D02805B8DB75FA4.quest_desc: [
		"An AE2 Item Cell Housing on the apparatus, with two Manipulation Essence, two Source Gems and four gold, becomes a &eSource Cell Housing&r."
		""
		"Your ME network can now store Source like any other resource."
	]
	quest.3D02805B8DB75FA4.quest_subtitle: "Ars Energistique begins"
	quest.3D02805B8DB75FA4.title: "ME Source Cell Housing"
	quest.3D1471B3E4721067.quest_desc: [
		"Made in the End table from Crystal Matrix and Neutronium. It can switch between Fortune and Silk Touch, and it mines bedrock and portal frames."
	]
	quest.3D1471B3E4721067.quest_subtitle: "Breaks bedrock"
	quest.3D1471B3E4721067.title: "Crystal Pickaxe"
	quest.3D57378E6249F99F.quest_desc: [
		"Crush plants, seeds and food in the Crusher to make &eBio Fuel&r, then burn it in the &eBio-Generator&r."
		""
		"Hook it to an automatic farm and forget about it."
	]
	quest.3D57378E6249F99F.quest_subtitle: "Crops into power"
	quest.3D57378E6249F99F.title: "Bio-Generator"
	quest.3D63DAC7B23B9862.quest_desc: [
		"The boss of the Silver Dungeon. It drops the Silver Key."
	]
	quest.3D63DAC7B23B9862.quest_subtitle: "The Aether"
	quest.3D63DAC7B23B9862.title: "The Valkyrie Queen"
	quest.3D752B93715B25AF.quest_desc: [
		"The &eEnergy Acceptor&r takes FE from any generator. &eEnergy Cells&r buffer it so the network never flickers."
	]
	quest.3D752B93715B25AF.quest_subtitle: "Feed the controller"
	quest.3D752B93715B25AF.title: "Network Power"
	quest.3D96BCD838FC53D0.quest_desc: [
		"Upgrade your Dark Matter Pickaxe with Red Matter."
		""
		"Every Red Matter tool and armor piece needs a &eDragon Heart&r (the Ender Dragon) in the grid. It stays in the grid, so one heart makes the whole set."
		"Gem Armor, the Katar and the Morning Star are made from Red Matter pieces."
		""
		"It mines like an Allthemodium Pickaxe: Vibranium ore yes, Unobtainium ore no."
	]
	quest.3D96BCD838FC53D0.quest_subtitle: "Top-tier digging"
	quest.3D96BCD838FC53D0.title: "Red Matter Pickaxe"
	quest.3E038A13282E77CA.quest_desc: [
		"Leather, iron and redstone make eight &eConveyor Belts&r. Your Crusher and Metal Press love being fed by them."
	]
	quest.3E038A13282E77CA.quest_subtitle: "Items on the move"
	quest.3E038A13282E77CA.title: "Conveyor Belts"
	quest.3E329CA147973ED1.quest_desc: [
		"&eCupboards&r, &eDrawers&r, &eNightstands&r, &eDesks&r, &eShelves&r, &eSide Tables&r and &eCounters&r all hold as much as a chest: 27 slots."
		""
		"Each one takes a chest in its recipe. Check EMI for the shapes."
	]
	quest.3E329CA147973ED1.quest_subtitle: "Hide the clutter"
	quest.3E329CA147973ED1.title: "Storage That Looks Nice"
	quest.3E80DC06EF1BF41B.quest_desc: [
		"Find a meteorite. Inside is a &eMysterious Cube&r holding the four Inscriber presses."
		""
		"Build an Inscriber and print your first Logic Processor."
	]
	quest.3E80DC06EF1BF41B.quest_subtitle: "Meteors hold the secrets"
	quest.3E80DC06EF1BF41B.title: "Inscriber"
	quest.3E86E4FEAFD9B356.quest_desc: [
		"&eWizard Towers&r rise over forests, plains and meadows. Climb one."
	]
	quest.3E86E4FEAFD9B356.quest_subtitle: "Tall and pointy"
	quest.3E86E4FEAFD9B356.title: "Wizard Tower"
	quest.3E93D46D3FA94C54.quest_desc: [
		"Draconium ore drops &eDraconium Dust&r, and Fortune gives you more. Smelt the dust into ingots."
		""
		"Almost everything in this chapter starts with Draconium, so keep a steady supply coming."
	]
	quest.3E93D46D3FA94C54.quest_subtitle: "Purple dust, big dreams"
	quest.3E93D46D3FA94C54.title: "Draconic Evolution"
	quest.3E97965CAB5C8178.quest_desc: [
		"An AE2 Energy Acceptor with four Source Gem Blocks and four gold blocks (10000 Source) becomes the &eME Source Converter&r."
		""
		"It connects Source and your ME network. Hover it in EMI for the details."
	]
	quest.3E97965CAB5C8178.quest_subtitle: "Energy Acceptor, the magic version"
	quest.3E97965CAB5C8178.title: "ME Source Converter"
	quest.3F037DB335A2C483.quest_desc: [
		"Another &eMechanical Crafter&r recipe, 5 wide and 4 tall: three Hot Air Envelopes, four Gyroscopic Mechanisms, three Engine Assemblies, two Gyroscopic Propeller Bearings, two Hot Air Burners, an Altitude Sensor and a Navigation Table."
		""
		"Every part is a ship part, so the &eCreate Aeronautics&r chapter has you covered."
	]
	quest.3F037DB335A2C483.quest_subtitle: "Tuned on a ship that flew"
	quest.3F037DB335A2C483.title: "Skyward Seal"
	quest.3F67D59EDAD989DA.quest_desc: [
		"Don't like the look? The Paraglider can be turned into a &eDeku Leaf&r, which works the same. Check EMI (R on the item) for how."
	]
	quest.3F67D59EDAD989DA.quest_subtitle: "Glide in style"
	quest.3F67D59EDAD989DA.title: "Deku Leaf"
	quest.3F78CB24846E38FF.quest_desc: [
		"A &eFlux Controller&r on your network charges the items in your inventory wirelessly."
	]
	quest.3F78CB24846E38FF.quest_subtitle: "Charge on the go"
	quest.3F78CB24846E38FF.title: "Flux Controller"
	quest.3F7B0076DB8C5AC2.quest_desc: [
		"IE moves power along real wires. Craft &eLV Wire Coils&r and &eLV Wire Connectors&r, then click connector to connector."
		""
		"The Immersive Engineering chapter covers the big machines."
	]
	quest.3F7B0076DB8C5AC2.quest_subtitle: "Immersive power lines"
	quest.3F7B0076DB8C5AC2.title: "Wire It Up"
	quest.3F9A3C9AE762B16C.quest_desc: [
		"Gold Dungeon treasure includes Phoenix armor, which laughs at fire and lava."
		""
		"&6Heads up:&r water slowly turns it into Obsidian armor."
	]
	quest.3F9A3C9AE762B16C.quest_subtitle: "Phoenix gear"
	quest.3F9A3C9AE762B16C.title: "Fireproof"
	quest.3FA7DD18415027A0.quest_desc: [
		"You made Logic already. &eCalculation&r uses certus crystals and &eEngineering&r uses diamonds."
		""
		"Spare presses: put a press with an iron block in the Inscriber to copy it."
	]
	quest.3FA7DD18415027A0.quest_subtitle: "Brains for everything"
	quest.3FA7DD18415027A0.title: "All Three Processors"
	quest.3FED78849B2D62A3.quest_desc: [
		"A copper ingot, glass and another copper ingot in a column make six &ePipes&r."
		""
		"Feed them with a hopper or dropper. Items prefer to fall down, then go forward, then sideways. A redstone signal shuts a pipe off, and more than 16 items inside will burst it."
	]
	quest.3FED78849B2D62A3.quest_subtitle: "Copper tubes for items"
	quest.3FED78849B2D62A3.title: "Pipes"
	quest.3FF42EEB9C529ECC.quest_desc: [
		"The Obsidilith guards an &eObsidian Heart&r in its chest."
	]
	quest.3FF42EEB9C529ECC.quest_subtitle: "Obsidilith loot"
	quest.3FF42EEB9C529ECC.title: "Obsidian Heart"
	quest.401FDB6F9849988A.quest_desc: [
		"Ocean monuments are rebuilt by &eYUNG's Better Ocean Monuments&r, and the vanilla ones are off."
		""
		"Clear one out and defeat an &eElder Guardian&r."
	]
	quest.401FDB6F9849988A.quest_subtitle: "Elder business"
	quest.401FDB6F9849988A.title: "Better Ocean Monument"
	quest.4038506B2C209B7B.quest_desc: [
		"Denizens camp out in the Depths. Visit one (and maybe don't kick over the campfire)."
	]
	quest.4038506B2C209B7B.quest_subtitle: "Denizen camps"
	quest.4038506B2C209B7B.title: "Meeting the Locals"
	quest.404B28B0AACE47C2.quest_desc: [
		"A very unfriendly flower. Watch out for the spores."
	]
	quest.404B28B0AACE47C2.quest_subtitle: "Bosses of Mass Destruction"
	quest.404B28B0AACE47C2.title: "Void Blossom"
	quest.4051A9F0435E6FF8.quest_desc: [
		"Your Basic table (or its Auto version), a gold block, Advanced Components and an Advanced Catalyst."
	]
	quest.4051A9F0435E6FF8.quest_subtitle: "The 5x5 table"
	quest.4051A9F0435E6FF8.title: "Advanced Crafting Table"
	quest.4065A6A88950DD27.quest_desc: [
		"Some Labyrinth vaults hide the &eMazebreaker&r, a pickaxe that chews through Mazestone. Good luck!"
	]
	quest.4065A6A88950DD27.quest_subtitle: "Jackpot!"
	quest.4065A6A88950DD27.title: "Mazebreaker"
	quest.40D6EA82892B8A85.quest_desc: [
		"Aether blocks want Aether tools. &eSkyroot&r tools double the drops of Holystone and Ambrosium Ore."
		""
		"&eHolystone&r tools can mine Zanite and sometimes drop Ambrosium Shards as you work."
	]
	quest.40D6EA82892B8A85.quest_subtitle: "Starting over, up high"
	quest.40D6EA82892B8A85.title: "Skyroot and Holystone"
	quest.40FD2553386B46ED.quest_desc: [
		"Obsidian frame, flint and steel. You know how this goes."
	]
	quest.40FD2553386B46ED.quest_subtitle: "Hot and cranky"
	quest.40FD2553386B46ED.title: "The Nether"
	quest.40FF110376586263.quest_desc: [
		"The &eSteam Vent&r (gold sheet on a copper block) fills a balloon with steam instead of hot air."
		""
		"Like a Steam Engine it needs heat, water and boiler space."
	]
	quest.40FF110376586263.quest_subtitle: "Lift with steam"
	quest.40FF110376586263.title: "Steam Vent"
	quest.4104F10573119006.quest_desc: [
		"A 5x5 recipe on the &eExtreme Crafting Table&r: four Witherite Ingots, four Nether Stars, five Ancient Metal Ingots, two Ignitium and two Cursium Ingots, and one each of Essence of the Storm, Monstrous Horn, Abyssal Egg, Ancient Anima, Obsidian Heart, Blazing Eye, Void Thorn and a &eDragon Heart&r."
		""
		"Nearly all of it is boss loot. The &eBoss Hunting&r chapter doubles as your shopping list."
	]
	quest.4104F10573119006.quest_subtitle: "Paid for in boss fights"
	quest.4104F10573119006.title: "Calamity Seal"
	quest.4129B4A85FC89942.quest_desc: [
		"Three &eHouse&r items make an &eImproved House&r."
		""
		"Pick from a Spruce House, Acacia House, Earthen Home, Hobbit House, Jungle House, Cottage, Mountain House, Tower and more."
	]
	quest.4129B4A85FC89942.quest_subtitle: "Three houses make a better one"
	quest.4129B4A85FC89942.title: "Improved House"
	quest.418C751AAF482F02.quest_desc: [
		"ICU changes the Advanced Frame: a Simple Frame, two plastic, a &eKnightmetal Ingot&r, a Netherite Scrap, two gold, a diamond gear and 500 mB of Pink Slime."
		""
		"Knightmetal comes from Twilight Forest Goblin Knights. The Tier 3 page has the crafting quest."
	]
	quest.418C751AAF482F02.quest_subtitle: "Knightmetal inside"
	quest.418C751AAF482F02.title: "Advanced Frames, ICU Style"
	quest.418E9D2AFE33679F.quest_desc: [
		"Each MekaSuit piece is a &eNetherite&r armor piece wrapped in HDPE, Polonium and Ultimate circuits."
		""
		"Fill it with modules: jetpack, gravity, radiation shielding and more."
	]
	quest.418E9D2AFE33679F.quest_subtitle: "Power armor"
	quest.418E9D2AFE33679F.title: "MekaSuit"
	quest.4197B282B8F1946B.quest_desc: [
		"The &eMob Crusher&r kills mobs in range and keeps their drops and experience as liquid Essence."
		""
		"Needs an Advanced Frame."
	]
	quest.4197B282B8F1946B.quest_subtitle: "Loot and XP"
	quest.4197B282B8F1946B.title: "Mob Crusher"
	quest.41B9176E3923BCF0.quest_desc: [
		"The &eWildfire&r rules its citadel. Bring fire resistance and a good bow."
		""
		"It drops three to five &eWildfire Crown Fragments&r."
	]
	quest.41B9176E3923BCF0.quest_subtitle: "The Wildfire"
	quest.41B9176E3923BCF0.title: "Drop It Like It's Hot"
	quest.41BE80B87D19EAAC.quest_desc: [
		"An &eME Interface&r keeps items stocked for machines and accepts anything pushed into it."
	]
	quest.41BE80B87D19EAAC.quest_subtitle: "The network's front door"
	quest.41BE80B87D19EAAC.title: "ME Interface"
	quest.41C1326C2C9ECEBC.quest_desc: [
		"Smithing needs an &eAllthemodium Smithing Template&r. Look for &eSuspicious Clay&r in Ancient Cities and brush it."
		""
		"Found one? Craft it with seven netherite ingots and deepslate to get two back."
	]
	quest.41C1326C2C9ECEBC.quest_subtitle: "Brush the Deep Dark"
	quest.41C1326C2C9ECEBC.title: "Allthemodium Template"
	quest.41EC23265DA036D6.quest_desc: [
		"A goat horn inside a ring of planks makes a &eGoat Trophy&r for your wall. Plenty of other mobs have trophies too; EMI shows them all."
		""
		"A painting and a gold ingot make a &eFancy Painting&r."
	]
	quest.41EC23265DA036D6.quest_subtitle: "Show off a little"
	quest.41EC23265DA036D6.title: "Trophies and Paintings"
	quest.41F4D04379406896.quest_desc: [
		"Eight Inferium Essence around wheat seeds make &eInferium Seeds&r. They grow on any farmland and drop essence."
		""
		"&6Heads up:&r resource crops can't be bonemealed, and only drop a second seed on Essence Farmland."
	]
	quest.41F4D04379406896.quest_subtitle: "Grow your essence"
	quest.41F4D04379406896.title: "Inferium Seeds"
	quest.41F7A29B2D734568.quest_desc: [
		"&ePhantom Track&r is invisible unless you're holding some, and it works with every bogey type."
		"&eEnder Track&r is made with end stone brick slabs."
	]
	quest.41F7A29B2D734568.quest_subtitle: "Spooky rails"
	quest.41F7A29B2D734568.title: "Phantom and Ender Tracks"
	quest.421B8AFD24858EBE.quest_desc: [
		"Most structure recipes use Prefab's bulk materials:"
		"Nine logs make a &eBundle of Timber&r. Nine stone make &eCompressed Stone&r, which compresses twice more. Bricks, dirt, glowstone and lanterns compress the same way."
	]
	quest.421B8AFD24858EBE.quest_subtitle: "Compressed and bundled"
	quest.421B8AFD24858EBE.title: "Building Supplies"
	quest.421EB19B5E942BD9.quest_desc: [
		"Ignis drops &eIgnitium Ingots&r. Keep a few; Tier 3 wants them."
	]
	quest.421EB19B5E942BD9.quest_subtitle: "Loot from the flames"
	quest.421EB19B5E942BD9.title: "Ignitium"
	quest.42255B27CF0DEF5F.quest_desc: [
		"Place the &eTree Fluid Extractor&r facing a log and it slowly pulls &eLatex&r out of the wood."
		""
		"&6Tip:&r acacia and mangrove logs give the most. Now and then the log gets used up, so keep a spare tree."
	]
	quest.42255B27CF0DEF5F.quest_subtitle: "Tree juice"
	quest.42255B27CF0DEF5F.title: "Tree Fluid Extractor"
	quest.42379BCA31FD3F68.quest_desc: [
		"The &eGyroscopic Mechanism&r is made by sequenced assembly: start with an iron sheet and deploy cogwheels, shafts and more onto it over 5 loops."
		""
		"You need it for gimbals, smart propellers and helicopter bearings."
	]
	quest.42379BCA31FD3F68.quest_subtitle: "Spinning brains"
	quest.42379BCA31FD3F68.title: "Gyroscopic Mechanism"
	quest.423CD8385A79527A.quest_desc: [
		"Two diamonds, planks and a &eHeart of Diamond&r make a &ePickarang&r."
		""
		"Throw it and it mines whatever it hits, then flies back with the drops. It mines like a diamond pickaxe, handles wood and dirt too, and takes enchantments."
	]
	quest.423CD8385A79527A.quest_subtitle: "A pickaxe you throw"
	quest.423CD8385A79527A.title: "Pickarang"
	quest.42409A5A356FB2B7.quest_desc: [
		"A &eBackpack&r is one of the best early crafts in the pack. It's mostly leather and a chest (EMI has the grid)."
		""
		"Upgrades like auto-pickup and magnets come later. See the &eStorage&r chapter."
	]
	quest.42409A5A356FB2B7.quest_subtitle: "Never enough inventory"
	quest.42409A5A356FB2B7.title: "Pockets, Upgraded"
	quest.425381B084545B3C.quest_desc: [
		"Bronze Dungeons are buried inside islands. The &eSlider&r waits inside and only takes damage from pickaxes."
		""
		"Its Bronze Key opens the treasure chest."
	]
	quest.425381B084545B3C.quest_subtitle: "Like a boss"
	quest.425381B084545B3C.title: "The Bronze Dungeon"
	quest.426682407A81819B.quest_desc: [
		"The &eME Level Emitter&r gives a redstone signal when an item goes above or below an amount. Great for switching machines on and off."
	]
	quest.426682407A81819B.quest_subtitle: "Redstone that counts"
	quest.426682407A81819B.title: "Level Emitter"
	quest.428E2212B67CADC8.quest_desc: [
		"Bamboo and a carpet make a &eLunch Basket&r. It has six slots for food and can be set down like a picnic basket."
	]
	quest.428E2212B67CADC8.quest_subtitle: "Snacks on the go"
	quest.428E2212B67CADC8.title: "Lunch Basket"
	quest.42927BCA2A5C2F72.quest_desc: [
		"Alpha Yeti Fur makes Yeti armor, which chills anything that hits you. Start with the jacket."
	]
	quest.42927BCA2A5C2F72.quest_subtitle: "Warm and tough"
	quest.42927BCA2A5C2F72.title: "Yeti Armor"
	quest.42983968595886EE.quest_desc: [
		"Find the Labyrinth in the swamp, beat the Minoshroom, and eat its &eMeef Stroganoff&r."
		""
		"Yes, really. That's how the Twilight Forest knows you're done here."
	]
	quest.42983968595886EE.quest_subtitle: "Beef, but make it fungus"
	quest.42983968595886EE.title: "The Labyrinth"
	quest.42D9566151F58324.quest_desc: [
		"Plastic, iron and redstone. Upgrades bolt on top: insertion, extraction, splitting, dropping and more."
	]
	quest.42D9566151F58324.quest_subtitle: "Plastic belts"
	quest.42D9566151F58324.title: "Conveyors"
	quest.42DC943F802A0507.quest_desc: [
		"Planks and wheat make a &eFeeding Trough&r. Fill it with food and animals nearby eat from it and breed on their own."
		""
		"It won't breed them when the pen is already crowded, and it gives no XP."
	]
	quest.42DC943F802A0507.quest_subtitle: "Self-serve breeding"
	quest.42DC943F802A0507.title: "Feeding Trough"
	quest.42FD794B11C99611.quest_desc: [
		"The Imbuement Chamber does more than Source Gems. Put &eArcane Pedestals&r around it (within 1 block) with items on them and it makes &eessences&r instead."
		""
		"It pulls Source from jars up to 2 blocks away, so park a full jar next to it."
	]
	quest.42FD794B11C99611.quest_subtitle: "Pedestals change the recipe"
	quest.42FD794B11C99611.title: "Imbuement, Deeper"
	quest.4326F017638FB91A.quest_desc: [
		"A &eFour Leaf Clover&r is rare. Jungle temple chests are your best bet."
	]
	quest.4326F017638FB91A.quest_subtitle: "Four leaves"
	quest.4326F017638FB91A.title: "Better Luck This Time"
	quest.433B41E6AF6E7320.quest_desc: [
		"Out on the End's outer islands, the &eEnd Wilds&r grow &eEmpyreal&r trees and &eEndblooms&r."
		""
		"The &eEnd Reef&r and the &eEnd Corruption&r are out there too."
	]
	quest.433B41E6AF6E7320.quest_subtitle: "Wilds at the end of the world"
	quest.433B41E6AF6E7320.title: "Empyreal"
	quest.436E1E7820FECC69.quest_desc: [
		"Nine ingots make a &eDraconium Block&r. Wyvern injectors and a few machines ask for whole blocks, so pack some away."
	]
	quest.436E1E7820FECC69.quest_subtitle: "Storage and ingredient"
	quest.436E1E7820FECC69.title: "Draconium Blocks"
	quest.4395C5F867A930B1.quest_desc: [
		"&eVanilla Backport&r brings features from newer Minecraft versions into ICU: the &ePale Garden&r and its Creaking, resin, wildflowers, leaf litter, firefly bushes, warm and cold farm animals, colored eggs, bundles and &eSulfur Caves&r."
		""
		"New terrain only appears in chunks you haven't explored yet."
		""
		"&6Heads up:&r in ICU &cHappy Ghasts&r are turned off, and Sulfur Cubes don't spawn on their own (they caused lag). You can still make a Sulfur Cube, see the end of this chapter."
	]
	quest.4395C5F867A930B1.quest_subtitle: "Features from later versions, in 1.21.1"
	quest.4395C5F867A930B1.title: "Newer Minecraft"
	quest.43A6C8DD5DC86061.quest_desc: [
		"The Nether's &eCrystalline Chasm&r is packed with rose quartz. Break the clusters for &eRose Quartz Chunks&r. Four make a block."
		""
		"&6Heads up:&r thanks to Create O' Plenty, two chunks in a &eheated&r Mixer make one Create &eRose Quartz&r, no redstone needed."
	]
	quest.43A6C8DD5DC86061.quest_subtitle: "The Crystalline Chasm"
	quest.43A6C8DD5DC86061.title: "Pink Crystals"
	quest.43B1CC24CEDD8B82.quest_desc: [
		"&eIcestone&r is found in the island rock. It fuels the Freezer (Holystone, Icestone and Skyroot Planks)."
		""
		"The Freezer turns water into ice and makes frozen accessories."
	]
	quest.43B1CC24CEDD8B82.quest_subtitle: "Cold as ice"
	quest.43B1CC24CEDD8B82.title: "Freezer"
	quest.43D05CDE14F41866.quest_desc: [
		"Freeze an Iron Ring and an Iron Pendant (or gold ones) to get an &eIce Ring&r and &eIce Pendant&r."
		""
		"Wear them in the accessory slots and you freeze water and lava under your feet."
	]
	quest.43D05CDE14F41866.quest_subtitle: "Walk on water"
	quest.43D05CDE14F41866.title: "Cool Jewelry"
	quest.440048CBB9219CB6.quest_desc: [
		"A Pattern Provider with room for many more patterns. Crafted in the Crystal Assembler."
	]
	quest.440048CBB9219CB6.quest_subtitle: "Way more slots"
	quest.440048CBB9219CB6.title: "Extended Pattern Provider"
	quest.44091CE7A21807E7.quest_desc: [
		"A &eSolar Generator&r needs a clear view of the sky. No power at night or in the rain."
	]
	quest.44091CE7A21807E7.quest_subtitle: "Free power, daytime only"
	quest.44091CE7A21807E7.title: "Solar Generator"
	quest.441AA02D7CCA3B53.quest_desc: [
		"Right-click farmland with essence, or craft them together, for &eEssence Farmland&r."
		""
		"Crops get a 10% chance at a second seed on any tier, plus another 10% on their own tier. Inferium Seeds drop more essence on higher tiers."
	]
	quest.441AA02D7CCA3B53.quest_subtitle: "Better dirt"
	quest.441AA02D7CCA3B53.title: "Essence Farmland"
	quest.443D2035E3C9806B.quest_desc: [
		"The &eNexus&r is buried underground and doesn't turn up often. Finding one is a proper achievement."
	]
	quest.443D2035E3C9806B.quest_subtitle: "Underground and rare"
	quest.443D2035E3C9806B.title: "The Nexus"
	quest.44604F7C65D19313.quest_desc: [
		"Biomes O' Plenty sands make sandpaper too. &eBlack Sand Paper&r polishes just like the regular kind."
		""
		"Handy if you live near a volcano instead of a beach."
	]
	quest.44604F7C65D19313.quest_subtitle: "Create O' Plenty"
	quest.44604F7C65D19313.title: "Colored Sandpaper"
	quest.446ACC3FCAD521FC.quest_desc: [
		"Bounce on a Blue Aercloud, then craft a &eCold Parachute&r from four Cold Aerclouds."
		""
		"It opens by itself when you fall off an island. Golden Aerclouds make a reusable one."
	]
	quest.446ACC3FCAD521FC.quest_subtitle: "Fall with style"
	quest.446ACC3FCAD521FC.title: "Parachutes"
	quest.447FE638CE6F40AC.quest_desc: [
		"ICU tracks thirst as well as hunger. Drinking straight from rivers and lakes can make you sick."
		""
		"Boil or filter your water before you drink it. The &eStaying Hydrated&r chapter in Food and Farming shows how."
	]
	quest.447FE638CE6F40AC.quest_subtitle: "Yes, you get thirsty here"
	quest.447FE638CE6F40AC.title: "Stay Hydrated"
	quest.44D364763184C8A5.quest_desc: [
		"An Arcane Pedestal, a Source Gem Block and three gold make a &eRitual Brazier&r."
		""
		"Craft ritual tablets from archwood logs and other items, then right-click the brazier with one to start it. Try &eSunrise&r first: a Blazing Archwood log and a sunflower."
	]
	quest.44D364763184C8A5.quest_subtitle: "Big magic, slow burn"
	quest.44D364763184C8A5.title: "Ritual Brazier"
	quest.44D854FD70188397.quest_desc: [
		"&eFuel Tanks&r and &ePortable Fuel Interfaces&r refuel trains at stations."
		""
		"ICU leaves realistic train fuel off, so trains run free. These are here if a server turns it on."
	]
	quest.44D854FD70188397.quest_subtitle: "Just in case"
	quest.44D854FD70188397.title: "Fuel Tanks"
	quest.44E76C0571FD6A3F.quest_desc: [
		"An &eEnergy Cube&r holds power and can charge items in its slots."
		""
		"Use the Configurator to pick which sides push power out."
	]
	quest.44E76C0571FD6A3F.quest_subtitle: "Store your power"
	quest.44E76C0571FD6A3F.title: "Basic Energy Cube"
	quest.44ED09D90B85536D.quest_desc: [
		"Flux Dust, obsidian and an Eye of Ender make a &eFlux Core&r. Cores and dust make &eFlux Blocks&r."
	]
	quest.44ED09D90B85536D.quest_subtitle: "Building blocks"
	quest.44ED09D90B85536D.title: "Flux Core and Flux Block"
	quest.44F87A2F0011C0F3.quest_desc: [
		"A &eRift Drive&r jumps the ship it is built into. It can only warp to a place marked with a &eWarp Anchor&r (or found with a Rift Probe)."
		""
		"Mk II and Mk III drives reach further. Check EMI for the upgrades."
	]
	quest.44F87A2F0011C0F3.quest_subtitle: "Engage!"
	quest.44F87A2F0011C0F3.title: "Rift Drive"
	quest.44FB39FBC666F76C.quest_desc: [
		"Waterwheel segments are treated wood and treated sticks; four of them around a steel ingot make the wheel."
		""
		"Mount it on a dynamo with flowing water passing through it."
	]
	quest.44FB39FBC666F76C.quest_subtitle: "Rivers are free energy"
	quest.44FB39FBC666F76C.title: "Water Wheel"
	quest.44FCFA412DD78BFB.quest_desc: [
		"Easy Emerald has three smithing templates, and each recipe makes four:"
		"&eTool&r (gold around an amethyst shard), &eSword&r (iron around a ruby) and &eBow&r (lapis around an emerald)."
		""
		"At a Smithing Table an iron pickaxe plus an emerald becomes an Emerald Pickaxe, and that plus a ruby becomes a Ruby Pickaxe. Swords go the same way. Smithing keeps the enchantments, so your favorite tool comes along."
	]
	quest.44FCFA412DD78BFB.quest_subtitle: "Keep your enchantments"
	quest.44FCFA412DD78BFB.title: "Smithing Upgrades"
	quest.4545D62D18C31FB5.quest_desc: [
		"A &eHandcar&r is a tiny ready-made train. Place it on track and pump away. Pick it up with a wrench."
	]
	quest.4545D62D18C31FB5.quest_subtitle: "Pump it yourself"
	quest.4545D62D18C31FB5.title: "Handcar"
	quest.455974A1DA70C6AE.quest_desc: [
		"A torch on iron nuggets makes a wall &eSconce&r. A candle on an iron ingot makes a &eCandle Holder&r, and they stack."
		""
		"There are soul, ender and glow versions too. Check EMI for the set."
	]
	quest.455974A1DA70C6AE.quest_subtitle: "Mood lighting"
	quest.455974A1DA70C6AE.title: "Sconces and Candles"
	quest.456F01254E54664C.quest_desc: [
		"Iron nuggets around a Source Gem make a &eDull Trinket&r. On the apparatus with diamonds and Source Gems it becomes an &eAmulet of Mana Boost&r."
		""
		"A &eRing of Potential&r (eight nuggets around a gem) is the base for the rings."
	]
	quest.456F01254E54664C.quest_subtitle: "Rings and amulets"
	quest.456F01254E54664C.title: "Trinkets"
	quest.459793567C11C6B4.quest_desc: [
		"&eMV Wire Coils&r are electrum wire. Use a &eTransformer&r to join an LV line to an MV line."
		""
		"The MV Accumulator holds a lot more than the LV one."
	]
	quest.459793567C11C6B4.quest_subtitle: "Now with electrum"
	quest.459793567C11C6B4.title: "MV Power"
	quest.459A90909F7A545C.quest_desc: [
		"A compass ringed with saplings and logs. Pick a biome and it points the way."
	]
	quest.459A90909F7A545C.quest_subtitle: "Find any biome"
	quest.459A90909F7A545C.title: "Nature's Compass"
	quest.45AB1D5A120A6DC3.quest_desc: [
		"Three gems and two sticks. The &eExcavator&r digs dirt, sand and gravel in a 3x3. Sneak for one block at a time."
		""
		"Great for clearing space for a big build."
	]
	quest.45AB1D5A120A6DC3.quest_subtitle: "The shovel version"
	quest.45AB1D5A120A6DC3.title: "Excavator"
	quest.45C04E577C9E321A.quest_desc: [
		"ICU's recipe: three Supremium Essence, an Infusion Crystal and an &eUnobtainium Nugget&r."
		""
		"Insanium Farmland and the top crops need it. This is Tier 5."
	]
	quest.45C04E577C9E321A.quest_subtitle: "Mystical Agradditions, ICU style"
	quest.45C04E577C9E321A.title: "Insanium"
	quest.45E164E02113266C.quest_desc: [
		"The Overworld got busier: &eWildflowers&r in birch forests and meadows, &eLeaf Litter&r on forest floors, and &eFirefly Bushes&r by swamps and water."
		""
		"Wildflowers make &eyellow dye&r."
	]
	quest.45E164E02113266C.quest_subtitle: "Flowers, leaves and fireflies"
	quest.45E164E02113266C.title: "Spring to Life"
	quest.46049D9F3BDF94A1.quest_desc: [
		"Put &eMechanical Harvesters&r on a moving contraption and sweep them over your crops. They harvest and replant."
		""
		"A &eMechanical Plough&r tills dirt the same way."
	]
	quest.46049D9F3BDF94A1.quest_subtitle: "Crops that pick themselves"
	quest.46049D9F3BDF94A1.title: "Automatic Farming"
	quest.460D09076672BC51.quest_desc: [
		"An HV Accumulator, MV coils, steel and advanced electronics. It fires steel rods and hits very hard."
		""
		"It's a flex, not a requirement."
	]
	quest.460D09076672BC51.quest_subtitle: "Magnets, but violent"
	quest.460D09076672BC51.title: "Railgun"
	quest.461D8E8157E7B539.quest_desc: [
		"Unobtainium ore needs a Vibranium pickaxe."
	]
	quest.461D8E8157E7B539.quest_subtitle: "One more pickaxe, promise"
	quest.461D8E8157E7B539.title: "Vibranium Pickaxe"
	quest.46239920EC0077EC.quest_desc: [
		"The Highlands are full of Troll Caves. Trolls throw rocks and sometimes drop &eMagic Beans&r."
		""
		"Beat a Troll inside a cave."
	]
	quest.46239920EC0077EC.quest_subtitle: "Mind your head"
	quest.46239920EC0077EC.title: "Troll Caves"
	quest.4680CB1ACD925829.quest_desc: [
		"Throw a redstone block, a fluix crystal and glowstone dust into water for two &eRedstone Crystals&r. Charge them in a Charger."
		""
		"Charging an iron block gives you the &eInscriber Energy Press&r. It prints Charged Redstone into the circuit for the &eEnergy Processor&r."
	]
	quest.4680CB1ACD925829.quest_subtitle: "Applied Flux's building blocks"
	quest.4680CB1ACD925829.title: "Charged Redstone"
	quest.4695EC9A3E0E8C5D.quest_desc: [
		"Two &eIgnitium Ingots&r, nether bricks, blaze rods and a shield."
		""
		"&6Heads up:&r Ignitium also makes Niotic Crystals and the Supreme Machine Frame. Plan your ingots."
	]
	quest.4695EC9A3E0E8C5D.quest_subtitle: "Ignitium shield"
	quest.4695EC9A3E0E8C5D.title: "Bulwark of the Flame"
	quest.46D33D0A399F4FAE.quest_desc: [
		"Hand the Sculptor a Bluff Rod and climb his pillar before time runs out."
		""
		"Pass and you get the &eEarthrend Gauntlet&r: lift boulders, tunnel through the ground and ride pillars of earth."
	]
	quest.46D33D0A399F4FAE.quest_subtitle: "The Sculptor's challenge"
	quest.46D33D0A399F4FAE.title: "Earthrend Gauntlet"
	quest.46F7B49C00D8DE04.quest_desc: [
		"Craft a &eMagic Map Focus&r from a Raven Feather, Torchberries and glowstone dust, then ring it with paper."
		""
		"Use the blank map and it shows biomes and every boss structure nearby. Ravens drop the feathers, and Torchberries hang in the caves."
	]
	quest.46F7B49C00D8DE04.quest_subtitle: "Where is everything?"
	quest.46F7B49C00D8DE04.title: "Map of the Twilight"
	quest.4700CE40E54B95A1.quest_desc: [
		"Zinc ore shows up underground in the Overworld. Crush it in Create for extra output, then smelt."
		""
		"Brass is copper plus zinc, mixed in a heated Basin."
	]
	quest.4700CE40E54B95A1.quest_subtitle: "The other half of brass"
	quest.4700CE40E54B95A1.title: "Zinc"
	quest.470A38663B30012A.quest_desc: [
		"Right-click Brass Casing with a &eSturdy Sheet&r to make &eTrain Casing&r."
		""
		"Stations, signals, bogeys and controls all start from it."
	]
	quest.470A38663B30012A.quest_subtitle: "Every train starts here"
	quest.470A38663B30012A.title: "Train Casing"
	quest.4711353E32F1C6EA.quest_desc: [
		"The &eReprocessor&r multiblock turns Cyanite and water into &eBlutonium&r, a second reactor fuel."
		""
		"Check EMI for the controller and casing recipes."
	]
	quest.4711353E32F1C6EA.quest_subtitle: "Waste into new fuel"
	quest.4711353E32F1C6EA.title: "Reprocessor"
	quest.47213C63446F59AF.quest_desc: [
		"Any seed with four Source Gems on the apparatus becomes a &eMagebloom Seed&r. Plant it, harvest the flowers, and craft each one into &eMagebloom Fiber&r."
		""
		"Fiber goes into robes, threads, parchment and a lot more. Plant a big patch."
	]
	quest.47213C63446F59AF.quest_subtitle: "Magic cotton"
	quest.47213C63446F59AF.title: "Magebloom"
	quest.472F511D5EE8E0B3.quest_desc: [
		"An &eEnergy Pylon&r connects the core to the outside world. Put it near the core and switch it between input and output."
		""
		"Pipe power in from your generators and out to your machines."
	]
	quest.472F511D5EE8E0B3.quest_subtitle: "Power in, power out"
	quest.472F511D5EE8E0B3.title: "Energy Pylon"
	quest.475778C203BA475A.quest_desc: [
		"Every power source has &estress capacity&r and every machine has a &estress impact&r. Go over and the whole network stops."
		""
		"A &eStressometer&r shows how close you are. Faster speed means more stress, so don't spin things faster than you need."
	]
	quest.475778C203BA475A.quest_subtitle: "Know your limits"
	quest.475778C203BA475A.title: "Stress Test"
	quest.47826E103BBB86F7.quest_desc: [
		"It needs an &eElite Control Circuit&r. Eight raw ore plus a cobblestone makes one ore block."
		""
		"Why bother? Ore blocks give the full bonus in the processing lines, raw ore does not."
	]
	quest.47826E103BBB86F7.quest_subtitle: "Ore blocks from raw ore"
	quest.47826E103BBB86F7.title: "Combiner"
	quest.4795EECBFDD9861E.quest_desc: [
		"The &eChemical Crystallizer&r turns clean slurry into &eCrystals&r. They go into the Injection Chamber and down the 4x line."
		""
		"That's five ingots per ore block. Put factories and upgrades on every stage."
	]
	quest.4795EECBFDD9861E.quest_subtitle: "The full ore line!"
	quest.4795EECBFDD9861E.title: "5x: Crystals"
	quest.47ABFBDD5262046B.quest_desc: [
		"Find a &eGoddess Statue&r in a village and trade 4 Spirit Orbs for an extra &eHeart Container&r or a &eStamina Vessel&r."
		""
		"More stamina means longer glides and longer sprints."
	]
	quest.47ABFBDD5262046B.quest_subtitle: "Pray for power"
	quest.47ABFBDD5262046B.title: "The Goddess Statue"
	quest.47B4A42005A7B8C8.quest_desc: [
		"The &ePowah Wrench&r has three modes: &eConfig&r (cable sides), &eLink&r (rods to an orb) and &eRotate&r."
	]
	quest.47B4A42005A7B8C8.quest_subtitle: "Three tools in one"
	quest.47B4A42005A7B8C8.title: "Powah Wrench"
	quest.47C87CC01C7C7108.quest_desc: [
		"The catalyst needs bedrock, a Crystal Matrix Ingot, a Neutronium Ingot, some very odd food, an Endest Pearl and a Record Fragment."
		""
		"Check EMI and start collecting early."
	]
	quest.47C87CC01C7C7108.quest_subtitle: "All the leftovers"
	quest.47C87CC01C7C7108.title: "Infinity Catalyst"
	quest.47CACE50ADFAAF37.quest_desc: [
		"&eManipulation&r: button, redstone, clock. &eAbjuration&r: fermented spider eye, sugar, milk bucket. &eAir&r needs a feather, arrows and a &eWilden Wing&r."
		""
		"Manipulation Essence also changes an Archwood sapling into the next color."
	]
	quest.47CACE50ADFAAF37.quest_subtitle: "Manipulation, abjuration, air"
	quest.47CACE50ADFAAF37.title: "Stranger Essences"
	quest.48376C06BD8C43E2.quest_desc: [
		"A normal chest dressed up with all three dusts, a diamond and iron. It's also part of the Condenser."
	]
	quest.48376C06BD8C43E2.quest_subtitle: "A chest with ambitions"
	quest.48376C06BD8C43E2.title: "Alchemical Chest"
	quest.4844368205CCFD96.quest_desc: [
		"One &eAntimatter Pellet&r takes a lot of polonium and a lot of patience. Keep the SPS well fed."
	]
	quest.4844368205CCFD96.quest_subtitle: "The rarest thing in Mekanism"
	quest.4844368205CCFD96.title: "Antimatter Pellet"
	quest.4883B2B848641D54.quest_desc: [
		"A book plus glowstone dust, flint or an Ambrosium Shard makes a &eBook of Lore&r. Put any item in it to read about what it does."
	]
	quest.4883B2B848641D54.quest_subtitle: "Ask the book"
	quest.4883B2B848641D54.title: "Book of Lore"
	quest.489E930DD18A213B.quest_desc: [
		"A big tank of &eBoiler Casing&r with &eSuperheating Elements&r at the bottom and a &ePressure Disperser&r layer above."
		""
		"Heat it with Resistive Heaters or superheated sodium, pump in water, and pull out &eSteam&r."
	]
	quest.489E930DD18A213B.quest_subtitle: "Heat into steam"
	quest.489E930DD18A213B.title: "Thermoelectric Boiler"
	quest.48A040AAB9BFA848.quest_desc: [
		"A &eComponent&r is a Black Iron Slate, Luminessence and two of a material: iron makes Basic, gold Advanced, diamonds Elite and emeralds Ultimate."
		""
		"Four Components around a Black Iron Ingot make the matching &eCatalyst&r."
	]
	quest.48A040AAB9BFA848.quest_subtitle: "The building blocks"
	quest.48A040AAB9BFA848.title: "Components and Catalysts"
	quest.48A503B53835B9E5.quest_desc: [
		"Uraninite ore is found deep underground. Energize the ore for extra Uraninite, or smelt the raw ore."
		""
		"Tip: Mekanism &eUranium Ingots&r can be energized into Uraninite too."
	]
	quest.48A503B53835B9E5.quest_subtitle: "Glowing green rocks"
	quest.48A503B53835B9E5.title: "Uraninite"
	quest.48A7304D769B78EA.quest_desc: [
		"The &eSPS&r is a multiblock of &eSPS Casing&r with &eSPS Ports&r and a &eSupercharged Coil&r to power it."
		""
		"It turns Polonium into &eAntimatter&r using enormous amounts of power. Crystallize antimatter into pellets."
	]
	quest.48A7304D769B78EA.quest_subtitle: "Making antimatter"
	quest.48A7304D769B78EA.title: "Supercritical Phase Shifter"
	quest.48BCD9F370D9142F.quest_desc: [
		"&eFactory Gauges&r watch your stock network and order ingredients to keep a recipe topped up."
		""
		"Chain them together and your factory plans itself."
	]
	quest.48BCD9F370D9142F.quest_subtitle: "Keep it in stock"
	quest.48BCD9F370D9142F.title: "Factory Gauges"
	quest.48E16A18186AF8B2.quest_desc: [
		"Prosperity Ore sits deeper, between Y -60 and 24. Smelt or mine it for &eProsperity Shards&r."
		""
		"Shards around an iron ingot make a Prosperity Ingot; around a diamond, a Prosperity Gemstone."
	]
	quest.48E16A18186AF8B2.quest_subtitle: "The shiny stuff"
	quest.48E16A18186AF8B2.title: "Prosperity Shards"
	quest.48E35DB2677229AD.quest_desc: [
		"Iron and Steel &eMechanical Components&r are plates around a copper ingot."
		""
		"&6Tip:&r the crafting grid wants 4 plates, but the Workbench with the Components blueprint only needs 2. Use the blueprint."
	]
	quest.48E35DB2677229AD.quest_subtitle: "Gears in a box"
	quest.48E35DB2677229AD.title: "Mechanical Components"
	quest.48F12CFF93FFEF74.quest_desc: [
		"Feasts are placed as blocks. Right-click with a bowl to serve a plate."
		""
		"&eRoast Chicken&r: cooked chicken, bread, an egg, an onion, two carrots, two baked potatoes and a bowl."
	]
	quest.48F12CFF93FFEF74.quest_subtitle: "A feast for the whole team"
	quest.48F12CFF93FFEF74.title: "Roast Chicken"
	quest.491EC3146461B5BA.quest_desc: [
		"Each tier is three of the one below plus an Accumulation Processor."
		""
		"Save a few &e16M Components&r: ICU's 64M recipe eats them."
	]
	quest.491EC3146461B5BA.quest_subtitle: "Keep stacking"
	quest.491EC3146461B5BA.title: "MEGA 4M and 16M"
	quest.495F1F41B3F824A9.quest_desc: [
		"Paste and iron bars make &eDielectric Rods&r. Rods and iron make the &eDielectric Casing&r."
		""
		"Paste, iron and a redstone block make a &eBasic Capacitor&r. Nearly every machine needs both."
	]
	quest.495F1F41B3F824A9.quest_subtitle: "The building blocks"
	quest.495F1F41B3F824A9.title: "Casings and Capacitors"
	quest.497B79779405D3C5.quest_desc: [
		"Craft a &eNovice Spell Book&r to start Ars Nouveau. Its guide, the Tattered Tome, explains the rest."
	]
	quest.497B79779405D3C5.quest_subtitle: "Tech isn't everything"
	quest.497B79779405D3C5.title: "A Little Magic"
	quest.497DCDE10A038ED6.quest_desc: [
		"The &eNecromancer's Spire&r stands in the Nether. It's as friendly as it sounds."
	]
	quest.497DCDE10A038ED6.quest_subtitle: "Spooky, in the Nether"
	quest.497DCDE10A038ED6.title: "The Necromancer's Spire"
	quest.499805E5D2A31A46.quest_desc: [
		"A &eBundle&r (string over leather) holds a stack's worth of mixed items in one slot."
		""
		"Dye it any of 16 colors."
	]
	quest.499805E5D2A31A46.quest_subtitle: "A bag for your bag"
	quest.499805E5D2A31A46.title: "Bundles"
	quest.49BB8557ED42F0E9.quest_desc: [
		"A &eBasic Motor&r turns electricity back into rotation. Change its speed with a wrench; its stress output stays the same."
		""
		"A redstone signal turns it off. Motors let you send power by wire instead of long shaft lines."
	]
	quest.49BB8557ED42F0E9.quest_subtitle: "Power into rotation"
	quest.49BB8557ED42F0E9.title: "Electric Motors"
	quest.49D2DF6F2329E5AA.quest_desc: [
		"Mossy, sandy, deepslate, blackstone, ender, nether, prismarine, purpur and mud-brick waystones all work the same."
		"Every one of them is a Mechanical Crafter recipe too. Pick your favorite."
	]
	quest.49D2DF6F2329E5AA.quest_subtitle: "Match your build"
	quest.49D2DF6F2329E5AA.title: "Waystone Styles"
	quest.49DFCE578716FE71.quest_desc: [
		"Once the Guardian is down, break the big &eChaos Crystal&r in the middle of the island for &eChaos Shards&r."
		""
		"Shards craft down into fragments. You'll need both."
	]
	quest.49DFCE578716FE71.quest_subtitle: "Loot from the island"
	quest.49DFCE578716FE71.title: "Chaos Shards"
	quest.4A134060B05BAF95.quest_desc: [
		"The &6Main Path&r is the spine: five tiers, one ladder."
		""
		"Everything else is sorted into groups on the left: &eTech&r, &eMagic&r, &eExploration and Bosses&r, &eFood and Farming&r, &eStorage and Logistics&r and &eShips and Flight&r. Dip into any of them whenever you like."
	]
	quest.4A134060B05BAF95.quest_subtitle: "The chapter list, explained"
	quest.4A134060B05BAF95.title: "Finding Your Way Around"
	quest.4A24C56E6AD4231A.quest_desc: [
		"Make a team with &e/ftbteams party create <name>&r, then bring friends in with &e/ftbteams party invite <player>&r."
		""
		"Everyone on a team shares quest progress."
	]
	quest.4A24C56E6AD4231A.quest_subtitle: "More hands, more machines"
	quest.4A24C56E6AD4231A.title: "Playing With Friends"
	quest.4A2CE103E6AA2685.quest_desc: [
		"When lightning strikes a &ePlague Doctor&r, it becomes the &cBlack Death&r."
		""
		"Expect plague and a lot of rats."
	]
	quest.4A2CE103E6AA2685.quest_subtitle: "Lightning and a plague mask"
	quest.4A2CE103E6AA2685.title: "The Black Death"
	quest.4A5B7628B26AD455.quest_desc: [
		"Create's &eSuper Glue&r works, and &eHoney Glue&r is made for ships. Fill an iron sheet with honey using a Spout."
		""
		"Click two corners to glue a box and Ctrl-scroll to resize it. Honey Glue only sticks to Simulated Contraptions, never to normal moving contraptions."
	]
	quest.4A5B7628B26AD455.quest_subtitle: "Sticky, but only for ships"
	quest.4A5B7628B26AD455.title: "Honey Glue"
	quest.4A6E62E52F7C833F.quest_desc: [
		"The &eSmart Propeller&r is a compact propeller that tilts on one axis to face upward."
		"One recipe makes two, so they're good for small drones and lift pods."
	]
	quest.4A6E62E52F7C833F.quest_subtitle: "Small and self-leveling"
	quest.4A6E62E52F7C833F.title: "Smart Propeller"
	quest.4A7717BF96A25FA1.quest_desc: [
		"Crafters, precision parts and a stock network. You've seen the whole Create toolbox."
		""
		"Trains are next, and the add-ons chapter has plenty more to build."
	]
	quest.4A7717BF96A25FA1.quest_subtitle: "Create, conquered"
	quest.4A7717BF96A25FA1.title: "Master Engineer"
	quest.4A7D1CCC6ABDF0FE.quest_desc: [
		"The Burning Arena is a Nether structure. An Explorer's Compass can point you to it."
		""
		"Take fire resistance, food and your best armor before you go in."
	]
	quest.4A7D1CCC6ABDF0FE.quest_subtitle: "Ignis waits inside"
	quest.4A7D1CCC6ABDF0FE.title: "Find the Burning Arena"
	quest.4A7DFA811ABFFF0F.quest_desc: [
		"Build an &eImbuement Chamber&r and imbue Lapis to make Source Gems. Source powers almost everything in Ars."
	]
	quest.4A7DFA811ABFFF0F.quest_subtitle: "Magic needs fuel"
	quest.4A7DFA811ABFFF0F.title: "Source Gems"
	quest.4A82C69B3C53B7E5.quest_desc: [
		"Basic reactors top out at 5x5x5 and can't be cooled with water. &eReinforced&r ones can be huge."
		""
		"&6Heads up:&r the Reinforced Controller needs an &eAllthemodium Ingot&r in ICU."
	]
	quest.4A82C69B3C53B7E5.quest_subtitle: "No size limit (almost)"
	quest.4A82C69B3C53B7E5.title: "Reinforced Reactor"
	quest.4A85F8085E4D7AAA.quest_desc: [
		"ICU's recipe swaps the diamond in the middle for a &eVibranium Ingot&r."
	]
	quest.4A85F8085E4D7AAA.quest_subtitle: "Now with extra Vibranium"
	quest.4A85F8085E4D7AAA.title: "Draconium Core"
	quest.4ABC557E2942773E.quest_desc: [
		"Five wheat make a &eHay Nest&r. Put it near your chickens."
		""
		"Chickens within 16 blocks walk over and lay their eggs in the nest instead of on the ground. A nest holds up to 6 eggs. Right-click to take one out, or let a hopper pull them. A comparator reads how full it is."
	]
	quest.4ABC557E2942773E.quest_subtitle: "No more eggs in the grass"
	quest.4ABC557E2942773E.title: "Hay Nest"
	quest.4ADF3056DDAC164B.quest_desc: [
		"Globes can't be crafted. Wandering Traders sell them for 10 emeralds, and they sometimes turn up in shipwreck treasure."
		""
		"Right-click to spin it, and it tells you your coordinates too. Antique Ink turns it into an old-style sepia globe."
	]
	quest.4ADF3056DDAC164B.quest_subtitle: "Spin it"
	quest.4ADF3056DDAC164B.title: "Globe"
	quest.4AEFF7FBEB4E575C.quest_desc: [
		"Stand on the &eFinal Plateau&r. That's the end of the Twilight Forest's story (for now)."
		""
		"Amazing work!"
	]
	quest.4AEFF7FBEB4E575C.quest_subtitle: "The Twilight Forest, beaten"
	quest.4AEFF7FBEB4E575C.title: "Top of the Highlands"
	quest.4AF449C7C1E7552C.quest_desc: [
		"The azalea trees in &eLush Caves&r grow real &eAzalea Logs&r in ICU, and some are &eFlowering Azalea&r."
		""
		"Two new wood sets, straight from the caves."
	]
	quest.4AF449C7C1E7552C.quest_subtitle: "Azalea wood"
	quest.4AF449C7C1E7552C.title: "Lush Lumber"
	quest.4B240FED4FB30726.quest_desc: [
		"An obsidian pillar with a grudge, in the Obsidilith Arena."
	]
	quest.4B240FED4FB30726.quest_subtitle: "Bosses of Mass Destruction"
	quest.4B240FED4FB30726.title: "Obsidilith"
	quest.4B47E4E9B9011CC3.quest_desc: [
		"Quark tweaks lots of small things all over the game and adds a big stack of building blocks, tools and gadgets."
		""
		"This chapter picks out the fun and useful parts. Everything in here is switched on in ICU."
	]
	quest.4B47E4E9B9011CC3.quest_subtitle: "A pile of little improvements"
	quest.4B47E4E9B9011CC3.title: "Quark"
	quest.4B5D89400AAFDAFD.quest_desc: [
		"Sneak and right-click an Ender Chest with the &eEnder Pouch&r to copy its colors."
		"Now you can open that chest from anywhere."
	]
	quest.4B5D89400AAFDAFD.quest_subtitle: "Your chest, in your pocket"
	quest.4B5D89400AAFDAFD.title: "Ender Pouch"
	quest.4B66AE37B5112CBA.quest_desc: [
		"Engineer's Goggles plus leather make &eAviator's Goggles&r. They show all the same info, and they look great."
		""
		"With goggles on you can see a propeller's thrust and airflow."
	]
	quest.4B66AE37B5112CBA.quest_subtitle: "Style and stats"
	quest.4B66AE37B5112CBA.title: "Aviator's Goggles"
	quest.4B72DE48562957E4.quest_desc: [
		"The &eRefinery&r mixes Plant Oil and Ethanol into &eBiodiesel&r. It needs &eSaltpeter&r as a catalyst."
		""
		"Fill a bucket to prove it works."
	]
	quest.4B72DE48562957E4.quest_subtitle: "Oil plus booze"
	quest.4B72DE48562957E4.title: "Biodiesel"
	quest.4B794FD6B2EFED95.quest_desc: [
		"Inferium Essence, Prosperity Shards and a diamond make an &eInfusion Crystal&r."
		""
		"It loses durability each time you use it to make a higher essence, so make a spare."
	]
	quest.4B794FD6B2EFED95.quest_subtitle: "Essence goes up a tier"
	quest.4B794FD6B2EFED95.title: "Infusion Crystal"
	quest.4B9CBE3A2989B34B.quest_desc: [
		"Tier 4 wraps a Tier 3 Stack Upgrade in &eNetherite Blocks&r. Nine of those make the Omega tier."
		""
		"&6Heads up:&r that's a lot of netherite. Save it until your netherite supply is steady."
	]
	quest.4B9CBE3A2989B34B.quest_subtitle: "Stupid amounts of cobble"
	quest.4B9CBE3A2989B34B.title: "Stack Upgrade Tier 4"
	quest.4BA43A55BFA1F8B8.quest_desc: [
		"Put your 256M component into a &e256M MEGA Item Storage Cell&r. One cell can hold a small world."
	]
	quest.4BA43A55BFA1F8B8.quest_subtitle: "256 million bytes"
	quest.4BA43A55BFA1F8B8.title: "A Very Big Drive"
	quest.4BBC5D842BFD4EA7.quest_desc: [
		"Infuse iron with carbon twice for steel dust, then smelt it. (The IE Blast Furnace works too.)"
	]
	quest.4BBC5D842BFD4EA7.quest_subtitle: "Mekanism style"
	quest.4BBC5D842BFD4EA7.title: "More Steel"
	quest.4C12375BF72BB686.quest_desc: [
		"Right-click stripped logs with Andesite Alloy to make &eAndesite Casing&r. Most early machines are built on it."
		""
		"&6Heads up:&r in ICU, Mekanism's &eMetallurgic Infuser&r needs an Andesite Casing. Keep a spare."
	]
	quest.4C12375BF72BB686.quest_subtitle: "The frame for everything"
	quest.4C12375BF72BB686.title: "Andesite Casing"
	quest.4C356E5C1E1ECE5C.quest_desc: [
		"A diamond chestplate upgraded with Inferium Ingots and Gemstones. Do the rest of the set too."
		""
		"A full Awakened Supremium set grows plants around you."
	]
	quest.4C356E5C1E1ECE5C.quest_subtitle: "Protection with perks"
	quest.4C356E5C1E1ECE5C.title: "Essence Armor"
	quest.4C4D7E0B552B62C4.quest_desc: [
		"&eAccelerators&r speed travelers up (or brake them). &eSplitters&r branch a line: steer with your movement keys."
	]
	quest.4C4D7E0B552B62C4.quest_subtitle: "Faster, and with choices"
	quest.4C4D7E0B552B62C4.title: "Accelerators and Splitters"
	quest.4C61D3469F6403BF.quest_desc: [
		"With the Sun Spirit gone, you can finally sleep in the Aether."
	]
	quest.4C61D3469F6403BF.quest_subtitle: "Finally"
	quest.4C61D3469F6403BF.title: "A Well Earned Rest"
	quest.4C843FF057EDD7BA.quest_desc: [
		"Mekanism machines need power. &eUniversal Cables&r carry it from your generators to your machines."
		""
		"Powah, IE and Mekanism energy all work together."
	]
	quest.4C843FF057EDD7BA.quest_subtitle: "Power goes where you point it"
	quest.4C843FF057EDD7BA.title: "Universal Cables"
	quest.4CB3AB0E6DF91CEB.quest_desc: [
		"Dig through the &eDreadrock&r at the bottom of the Undergarden to reach the Depths."
	]
	quest.4CB3AB0E6DF91CEB.quest_subtitle: "Even further down"
	quest.4CB3AB0E6DF91CEB.title: "Into the Depths"
	quest.4CCF2038FDF07CCB.quest_desc: [
		"Craft your Wyvern Necklace with an &eAwakened Core&r (EMI calls it the Draconic Core) to upgrade it."
	]
	quest.4CCF2038FDF07CCB.quest_subtitle: "Draconic Additions"
	quest.4CCF2038FDF07CCB.title: "Draconic Necklace"
	quest.4CFB57B306725BEA.quest_desc: [
		"An &eEnrichment Chamber&r turns one ore block into two dusts. Smelt the dust for ingots."
		""
		"&6Heads up:&r raw ore gets a smaller bonus (three raw make four dusts). Silk Touch ore blocks give the full 2x."
	]
	quest.4CFB57B306725BEA.quest_subtitle: "Double your ore"
	quest.4CFB57B306725BEA.title: "2x: Dusts"
	quest.4D58C473A97E8AA7.quest_desc: [
		"Put a navigation item in the &eNavigation Table&r and it outputs redstone toward its target. Ponder the table (hold W) to see which items work."
		""
		"The signal is weaker when you aren't facing the target. Wire it to steering for a real autopilot."
	]
	quest.4D58C473A97E8AA7.quest_subtitle: "Point me home"
	quest.4D58C473A97E8AA7.title: "Navigation Table"
	quest.4D67A68B5790584C.quest_desc: [
		"&eOratchalcum Ore&r only grows in Ratlantis. Smelt it into &eOratchalcum Ingots&r."
		""
		"Ratlantis armor and tools use it, and so does the &eAir-Raid Siren&r."
	]
	quest.4D67A68B5790584C.quest_subtitle: "Ratlantis' own metal"
	quest.4D67A68B5790584C.title: "Oratchalcum"
	quest.4D6A147EC3663C39.quest_desc: [
		"Frame, Soulium, iron and two Diamond Scythes. The &eHarvester&r picks ripe crops, replants them, and keeps the drops inside."
		""
		"A redstone signal turns it off. Add Machine Upgrades for more range."
	]
	quest.4D6A147EC3663C39.quest_subtitle: "Farming on autopilot"
	quest.4D6A147EC3663C39.title: "Harvester"
	quest.4D71416C8A0181FB.quest_desc: [
		"Craft an &eEmpty Blaze Burner&r and right-click a blaze with it. Now you have a Blaze Burner."
		""
		"Feed it fuel to heat a basin. Feed it a &eBlaze Cake&r to superheat it for the fanciest recipes."
	]
	quest.4D71416C8A0181FB.quest_subtitle: "Your pet blaze"
	quest.4D71416C8A0181FB.title: "Blaze Burner"
	quest.4D945ECEE30BDCDD.quest_desc: [
		"Too many seeds? The &eSeed Reprocessor&r turns them back into essence."
	]
	quest.4D945ECEE30BDCDD.quest_subtitle: "Extra seeds into essence"
	quest.4D945ECEE30BDCDD.title: "Seed Reprocessor"
	quest.4DABE33843FEF77A.quest_desc: [
		"You reached the top of the ladder. This chapter is the victory lap."
		""
		"Craft eight &eSeals&r, one for each corner of ICU: Create, flight, power, storage, magic, the Twilight Forest, the other realms and the big bosses. Then bring them together into the &6Ultra Star&r."
		""
		"Do them in any order. EMI shows every recipe."
	]
	quest.4DABE33843FEF77A.quest_subtitle: "One more climb"
	quest.4DABE33843FEF77A.title: "The Last Challenge"
	quest.4DB1B414C0FA2ABB.quest_desc: [
		"A &eTier Installer&r upgrades a placed machine or factory to the next tier. Right-click it, no need to break anything."
		""
		"The Basic installer turns a plain machine straight into a Basic Factory."
	]
	quest.4DB1B414C0FA2ABB.quest_subtitle: "Upgrade in place"
	quest.4DB1B414C0FA2ABB.title: "Tier Installers"
	quest.4DB34F14CD4A73B6.quest_desc: [
		"Iron, bricks and a campfire make a &eStove&r. It cooks up to six items on top at once."
		""
		"It's also the best thing to put under a Cooking Pot."
	]
	quest.4DB34F14CD4A73B6.quest_subtitle: "A proper heat source"
	quest.4DB34F14CD4A73B6.title: "Stove"
	quest.4DEAE53C4CBED6F4.quest_desc: [
		"&eYUNG's Better Mineshafts&r replaces the vanilla ones. They sit between Y -55 and 30."
		""
		"Look for &eore deposits&r in the walls and the odd abandoned miners' outpost. Tick this once you've explored one."
	]
	quest.4DEAE53C4CBED6F4.quest_subtitle: "Watch your step"
	quest.4DEAE53C4CBED6F4.title: "Better Mineshafts"
	quest.4E1E5983AA343725.quest_desc: [
		"Crush obsidian into &ePowdered Obsidian&r, then run it through sequenced assembly: a Spout adds lava, then a Press flattens it twice."
		""
		"Sturdy Sheets go into train casings, schedules and Immersive Aircraft engines."
	]
	quest.4E1E5983AA343725.quest_subtitle: "Obsidian, but thin"
	quest.4E1E5983AA343725.title: "Sturdy Sheet"
	quest.4E650CB290C33650.quest_desc: [
		"A &eStock Link&r joins packagers into a network. A &eStock Ticker&r shows everything in it and lets you request items."
		""
		"Your items get packaged and sent to you. It's a whole storage system built from Create parts."
	]
	quest.4E650CB290C33650.quest_subtitle: "Order from anywhere"
	quest.4E650CB290C33650.title: "Stock Keeping"
	quest.4E694A9748198B04.quest_desc: [
		"Every Dark Matter tool and armor piece needs a &eNether Star&r (the Wither) and a &eWarden Heart&r (the Warden) in the grid."
		"Both stay in the grid, so one of each makes the whole set."
		""
		"Dark Matter tools never break and can be charged for bigger area modes."
		""
		"They mine like Netherite: Allthemodium ore yes, Vibranium ore no."
	]
	quest.4E694A9748198B04.quest_subtitle: "Unbreakable and quick"
	quest.4E694A9748198B04.title: "Dark Matter Tools"
	quest.4E7D21455DBC29BA.quest_desc: [
		"Made from printed entro circuits, like the AE2 processors. Almost every Extended device wants one."
	]
	quest.4E7D21455DBC29BA.quest_subtitle: "ExtendedAE's brain"
	quest.4E7D21455DBC29BA.title: "Concurrent Processor"
	quest.4E8E6D3B25DB2D9D.quest_desc: [
		"Out in the Badlands, &eClockwork Villages&r run on Create machinery, and ICU keeps their contraptions switched on."
		""
		"Go see the gears turn."
	]
	quest.4E8E6D3B25DB2D9D.quest_subtitle: "Another cog in the machine"
	quest.4E8E6D3B25DB2D9D.title: "Clockwork Village"
	quest.4EBCAC5C7C1A1F12.quest_desc: [
		"A &eNotice Board&r (planks and paper) holds a book or map and shows it on the front."
		""
		"A &eBlackboard&r lets you draw pictures in black and white. Handy for signs, maps and doodles."
	]
	quest.4EBCAC5C7C1A1F12.quest_subtitle: "Leave a message"
	quest.4EBCAC5C7C1A1F12.title: "Notice Boards"
	quest.4EE18AA55854A7E7.quest_desc: [
		"&eDense Cable&r carries 32 channels. Run it straight out of the Controller's faces, then split into normal cable near your devices."
		""
		"Need more? Add more Controller blocks to make it bigger."
	]
	quest.4EE18AA55854A7E7.quest_subtitle: "32 lanes wide"
	quest.4EE18AA55854A7E7.title: "Dense Cable"
	quest.4EEDD260467C480E.quest_desc: [
		"Eight redstone blocks and a feather. The &eRedstone Pen&r draws thin redstone tracks on walls, floors and ceilings."
	]
	quest.4EEDD260467C480E.quest_subtitle: "Draw your circuits"
	quest.4EEDD260467C480E.title: "Redstone Pen"
	quest.4F4C13E11B590A27.quest_desc: [
		"It rules the Dark Tower. Mind the carminite."
	]
	quest.4F4C13E11B590A27.quest_subtitle: "Twilight Forest"
	quest.4F4C13E11B590A27.title: "The Ur-Ghast"
	quest.4F5FA97DA48559A4.quest_desc: [
		"Gravitite Ore sits low on the islands and needs an iron-tier pickaxe (Zanite works)."
		""
		"Enchant the ore in the Altar to get &eEnchanted Gravitite&r."
	]
	quest.4F5FA97DA48559A4.quest_subtitle: "Pink is the new blue"
	quest.4F5FA97DA48559A4.title: "Enchanted Gravitite"
	quest.4F6B2BB2F666F041.quest_desc: [
		"&6Heads up:&r in ICU every waystone, sharestone, portstone and the Warp Plate is made in a Create &eMechanical Crafter&r."
		""
		"The plain Waystone needs 4 rows: stone bricks around a Warp Stone, with obsidian along the bottom. Line up enough crafters and check EMI for the exact shape."
	]
	quest.4F6B2BB2F666F041.quest_subtitle: "Brass required"
	quest.4F6B2BB2F666F041.title: "Build Your Own Waystone"
	quest.4FB7C762DD78CB6E.quest_desc: [
		"The Nether hides &eCitadels&r. They're not fortresses, and they're home to the &eWildfire&r."
		""
		"Walk inside one."
	]
	quest.4FB7C762DD78CB6E.quest_subtitle: "Not another fortress"
	quest.4FB7C762DD78CB6E.title: "A Citadel!"
	quest.4FB9732D1F3383AD.quest_desc: [
		"Upgrade netherite tools at a Smithing Table with the template and an &eAllthemodium Ingot&r."
		""
		"The pickaxe is the one that matters: it opens Vibranium."
	]
	quest.4FB9732D1F3383AD.quest_subtitle: "Yellow and tough"
	quest.4FB9732D1F3383AD.title: "Allthemodium Tools"
	quest.4FF1D10C663F5DB5.quest_desc: [
		"Feathers, seeds, a diamond and a gold ingot. The &eChicken Pet&r gives you a speed boost and the odd egg."
	]
	quest.4FF1D10C663F5DB5.quest_subtitle: "Fast feet"
	quest.4FF1D10C663F5DB5.title: "Chicken Pet"
	quest.4FF3A83026A1DD13.quest_desc: [
		"Iron and a brick make a &eSkillet&r. Hold food in your off-hand and right-click to cook it over a heat source."
		""
		"It's a decent weapon in a pinch too."
	]
	quest.4FF3A83026A1DD13.quest_subtitle: "Cook on the go"
	quest.4FF3A83026A1DD13.title: "Skillet"
	quest.4FFE0D0D81320BF2.quest_desc: [
		"The Harbinger waits in the &eAncient Factory&r. It drops a Block of Witherite."
	]
	quest.4FFE0D0D81320BF2.quest_subtitle: "Machines have feelings too"
	quest.4FFE0D0D81320BF2.title: "The Harbinger"
	quest.502E5086865A93F2.quest_desc: [
		"&eEasy Emerald Tools&r makes full tool and armor sets out of emerald, ruby, amethyst, obsidian and copper. It also adds hammers, excavators, paxels and tree axes for every material."
		""
		"&6Heads up:&r none of it skips ICU's ladder. The gem tools harvest like diamond, and the copper and obsidian ones like iron. Allthemodium ore still needs a Netherite pickaxe."
	]
	quest.502E5086865A93F2.quest_subtitle: "What to do with all those emeralds"
	quest.502E5086865A93F2.title: "Gems Into Gear"
	quest.5044B8E0F11F0720.quest_desc: [
		"Nine eggs pack into a &eCrate of Chicken Eggs&r, and it crafts back into nine eggs."
		""
		"Turtle eggs have a crate too, if you ever collect that many."
	]
	quest.5044B8E0F11F0720.quest_subtitle: "Tidy storage"
	quest.5044B8E0F11F0720.title: "Crate of Eggs"
	quest.50478A46AD54FEA3.quest_desc: [
		"&eQuivers&r come from pillager outpost and woodland mansion chests. One holds six stacks of arrows."
		""
		"Hold &eV&r (ICU's default key) to pick which arrows your bow uses."
	]
	quest.50478A46AD54FEA3.quest_subtitle: "Arrows, organized"
	quest.50478A46AD54FEA3.title: "Quiver"
	quest.504F5D4422348148.quest_desc: [
		"Right-click a Zombie or Husk with an &eAerial Pearl&r and the pearl becomes a &ePlayer Aerial Pearl&r, the core of the &ePlayer Transmitter&r."
		""
		"Bind a &eBinding Card&r to yourself and put it inside. It charges your items anywhere in the same dimension."
	]
	quest.504F5D4422348148.quest_subtitle: "Charge your gear on the go"
	quest.504F5D4422348148.title: "Player Transmitter"
	quest.507EF21D4B73D32D.quest_desc: [
		"ICU replaces the Nether fortress with &eYUNG's Better Nether Fortresses&r. Find one."
		""
		"&6Heads up:&r once you've beaten &eIgnis&r, Cataclysm's Ignited Berserkers start showing up in these fortresses too."
	]
	quest.507EF21D4B73D32D.quest_subtitle: "YUNG's rebuild"
	quest.507EF21D4B73D32D.title: "Better Nether Fortress"
	quest.50B85512EBBA261C.quest_desc: [
		"A big Mechanical Crafter recipe with &eWitherite Ingots&r, a Precision Mechanism and an anvil."
		""
		"Cataclysm uses it to fuse its best gear."
	]
	quest.50B85512EBBA261C.quest_subtitle: "Witherite workshop"
	quest.50B85512EBBA261C.title: "Mechanical Fusion Anvil"
	quest.50B85F6AF25E644F.quest_desc: [
		"The &eVisceral Heap&r has lakes of blood. Yes, you can bucket it."
		""
		"A &eBucket of Blood&r ringed with four rotten flesh makes a &eFlesh&r block. A Create Millstone grinds it back into rotten flesh."
	]
	quest.50B85F6AF25E644F.quest_subtitle: "The Visceral Heap"
	quest.50B85F6AF25E644F.title: "Gross, but Useful"
	quest.5100B2DADED71C28.quest_desc: [
		"Hang a &eHammock&r between two Rope and Nails. It works in the daytime and skips to night, which is great for mob farms and night-only mobs."
	]
	quest.5100B2DADED71C28.quest_subtitle: "Nap through the day"
	quest.5100B2DADED71C28.title: "Hammock"
	quest.512C376D27B5B444.quest_desc: [
		"Put a Wyvern tool in the core as the catalyst, then add netherite, a Wyvern Core, Awakened Draconium and a Draconic Energy Controller."
	]
	quest.512C376D27B5B444.quest_subtitle: "Upgrade by fusion"
	quest.512C376D27B5B444.title: "Draconic Tools"
	quest.514622395C9C996B.quest_desc: [
		"Planks and sticks make a &eCutting Board&r. Place an item on it and hit it with the right tool."
		""
		"Knives slice food, axes strip logs into &eTree Bark&r and salvage wooden doors, signs, fences and boats back into planks (modded woods too), pickaxes break down stone items."
	]
	quest.514622395C9C996B.quest_subtitle: "Chop chop"
	quest.514622395C9C996B.title: "Cutting Board"
	quest.515116E405CF81E5.quest_desc: [
		"Blow a fan through a block and drop items in the stream:"
		"&eWater&r washes, &eLava&r smelts, &eFire or a campfire&r smokes, &eSoul fire&r haunts."
		""
		"Washing is great for gravel, sand and crushed ores. Process any item with a fan to finish this quest."
	]
	quest.515116E405CF81E5.quest_subtitle: "Wash, smelt, smoke, haunt"
	quest.515116E405CF81E5.title: "Bulk Processing"
	quest.51787B6AF91E76C8.quest_desc: [
		"Dense cables around a stick make the &eDense ME Wire Coil&r. It carries 32 channels and spans up to 32 blocks."
		""
		"&eME Relays&r hold the wire up between connectors, like IE's wire relays."
	]
	quest.51787B6AF91E76C8.quest_subtitle: "32 lanes in the air"
	quest.51787B6AF91E76C8.title: "Dense ME Wire"
	quest.51A3355F7548F85F.quest_desc: [
		"Leather and white wool make a &eBedroll&r (Leatherworkers sell them too). It works underwater."
		""
		"Try it at the bottom of the sea."
	]
	quest.51A3355F7548F85F.quest_subtitle: "A bed for anywhere"
	quest.51A3355F7548F85F.title: "Sleepin' with the Fishes"
	quest.521352F665D22E0E.quest_desc: [
		"&ePowah Solar Panels&r need open sky. Anything above that blocks light stops them."
		""
		"A &eLens of Ender&r lets a panel see through blocks."
	]
	quest.521352F665D22E0E.quest_subtitle: "Clean power"
	quest.521352F665D22E0E.title: "Solar Panel"
	quest.521A91B02D721ED9.quest_desc: [
		"&eFir&r grows in Coniferous Forests and Fir Clearings. &ePine&r grows around Hot Springs, Jade Cliffs and Drylands."
		""
		"&eRedwoods&r are the giants of the Redwood Forest. One tree is a lot of logs."
	]
	quest.521A91B02D721ED9.quest_subtitle: "Fir, pine and redwood"
	quest.521A91B02D721ED9.title: "Evergreens"
	quest.521DE3DE681DD909.quest_desc: [
		"Put Obsidian on top of Bedrock, drop Redstone on it and left-click the Obsidian. EMI's &eCreating Flux&r page shows the setup."
		""
		"The Nether roof and floor have plenty of bedrock."
	]
	quest.521DE3DE681DD909.quest_subtitle: "Crushed at the bottom of the world"
	quest.521DE3DE681DD909.title: "Flux Dust"
	quest.525C2CB22FDBEE88.quest_desc: [
		"&eKoi&r swim in the ponds of the Blossom Woods and Blossom Valleys. Scoop one up in a bucket."
		""
		"Release it in a village and it keeps monsters from spawning around the villagers."
	]
	quest.525C2CB22FDBEE88.quest_subtitle: "Lucky fish"
	quest.525C2CB22FDBEE88.title: "What a Koincidence!"
	quest.526F1115311B984C.quest_desc: [
		"The &eAtomic Disassembler&r runs on power instead of durability, and mines like a &eNetherite pickaxe&r: Allthemodium ore yes, Vibranium and Unobtainium no."
		""
		"It needs &eAtomic Alloy&r (Reinforced Alloy infused with Refined Obsidian dust) and a Refined Obsidian ingot."
	]
	quest.526F1115311B984C.quest_subtitle: "Pickaxe, axe and shovel in one"
	quest.526F1115311B984C.title: "Atomic Disassembler"
	quest.526F4E2A88EB6368.quest_desc: [
		"The &eCopper Coil Block&r is eight LV wire coils around an iron ingot. Build a &eKinetic Dynamo&r with it."
		""
		"Put a water wheel or windmill on the dynamo's shaft to make power."
	]
	quest.526F4E2A88EB6368.quest_subtitle: "Spin to win"
	quest.526F4E2A88EB6368.title: "Kinetic Dynamo"
	quest.52C95DAB9DA1FE07.quest_desc: [
		"Gold Generator plus diamonds. This is where the tree branches out."
	]
	quest.52C95DAB9DA1FE07.quest_subtitle: "Serious furnace power"
	quest.52C95DAB9DA1FE07.title: "Diamond Generator"
	quest.52F3539798AD8062.quest_desc: [
		"Each component tier is three of the one below with a Calculation Processor, quartz glass and redstone."
		""
		"Pop a component in a housing, or craft the full cell."
	]
	quest.52F3539798AD8062.quest_subtitle: "More bytes"
	quest.52F3539798AD8062.title: "Bigger Cells"
	quest.52F6823DA8329E31.quest_desc: [
		"The leader of the Umvuthana Grove."
	]
	quest.52F6823DA8329E31.quest_subtitle: "Mowzie's Mobs"
	quest.52F6823DA8329E31.title: "Umvuthi"
	quest.53023DC7F1858182.quest_desc: [
		"Upgrade Vibranium tools with the Unobtainium template and an &eUnobtainium Ingot&r."
	]
	quest.53023DC7F1858182.quest_subtitle: "The best metal tools"
	quest.53023DC7F1858182.title: "Unobtainium Tools"
	quest.5313B23366997558.quest_desc: [
		"Andesite plus iron nuggets (or zinc) makes &eAndesite Alloy&r, the backbone of early Create."
	]
	quest.5313B23366997558.quest_subtitle: "Create's bread and butter"
	quest.5313B23366997558.title: "Andesite Alloy"
	quest.5334AD920C35EBA1.quest_desc: [
		"The &eImport Bus&r pulls items out of whatever it faces. The &eExport Bus&r pushes chosen items in."
	]
	quest.5334AD920C35EBA1.quest_subtitle: "In one side, out the other"
	quest.5334AD920C35EBA1.title: "Import and Export"
	quest.536C9FFAA0CFB99E.quest_desc: [
		"Two &eCrushing Wheels&r side by side, spinning toward each other, crush anything dropped between them."
		""
		"They're a Mechanical Crafter recipe, and they're thirsty for stress. Give them a good power source."
	]
	quest.536C9FFAA0CFB99E.quest_subtitle: "The heavy grinders"
	quest.536C9FFAA0CFB99E.title: "Crushing Wheels"
	quest.536F5F916EB8CA79.quest_desc: [
		"An Electron Tube, a &eBrass Casing&r and a crafting table. Place crafters in a grid facing the same way, connect neighbours with a Wrench, and give them rotation."
		""
		"&6Heads up:&r in ICU every Waystone, Sharestone, Portstone and the Warp Plate is made here."
	]
	quest.536F5F916EB8CA79.quest_subtitle: "A crafting table with ambitions"
	quest.536F5F916EB8CA79.title: "Mechanical Crafter"
	quest.5397883FFE8CB29F.quest_desc: [
		"&eFuel Rods&r go in a column inside the reactor. A &eControl Rod&r goes on top of each column, in the roof."
		""
		"Control rods let you throttle the reaction from the controller."
	]
	quest.5397883FFE8CB29F.quest_subtitle: "The core"
	quest.5397883FFE8CB29F.title: "Fuel and Control Rods"
	quest.53BBC7E95BB8006F.quest_desc: [
		"An &eEncased Fan&r pushes air. What the air passes through decides what it does to items in its path."
	]
	quest.53BBC7E95BB8006F.quest_subtitle: "A blowhard with a job"
	quest.53BBC7E95BB8006F.title: "Encased Fan"
	quest.53C6D39774ED344F.quest_desc: [
		"Rainwater counts as &aPurified&r in ICU."
		""
		"A &eCauldron&r left out in the rain slowly fills with it. Fill bottles from it, or drink from the cauldron directly."
	]
	quest.53C6D39774ED344F.quest_subtitle: "Free clean water"
	quest.53C6D39774ED344F.title: "Catch the Rain"
	quest.53C789DB2AE0E969.quest_desc: [
		"AE2 Wireless Terminals (ae2wtlib) combine your wireless terminals into one &eWireless Universal Terminal&r. It also takes a Magnet Card."
	]
	quest.53C789DB2AE0E969.quest_subtitle: "One terminal to rule them all"
	quest.53C789DB2AE0E969.title: "Universal Terminal"
	quest.53CEB008E28B65FF.quest_desc: [
		"Two tomatoes in the pot make &eTomato Sauce&r."
		""
		"Got Create? A Mixer turns two tomatoes and a bowl into sauce too."
	]
	quest.53CEB008E28B65FF.quest_subtitle: "Everything's better with sauce"
	quest.53CEB008E28B65FF.title: "Tomato Sauce"
	quest.53DA8AC0D6FAF5D8.quest_desc: [
		"Crush an &eore block&r (mined with Silk Touch) for one crushed ore plus a 75% chance of a second."
		"Raw ore crushes one to one, with a bonus XP nugget."
		""
		"Wash crushed iron with a fan for nine nuggets and a chance of redstone, or just smelt it."
	]
	quest.53DA8AC0D6FAF5D8.quest_subtitle: "More metal per ore"
	quest.53DA8AC0D6FAF5D8.title: "Ore Doubling"
	quest.53FC7A30C7BAB34F.quest_desc: [
		"Out in the End, the Ruined Citadel is guarded by Ender Golems and the &eEnder Guardian&r."
	]
	quest.53FC7A30C7BAB34F.quest_subtitle: "Another stronghold?!"
	quest.53FC7A30C7BAB34F.title: "The Ruined Citadel"
	quest.53FF7A32B5F108A2.quest_desc: [
		"Dungeons in The Other's warped forests sometimes have a &elibrary&r room (not every dungeon does). Beat its &eTrial Spawner&r, full of Evokers, and it drops an &eUnobtainium Smithing Template&r. The library chests don't have one."
		""
		"Copy it with seven Vibranium Ingots and end stone."
	]
	quest.53FF7A32B5F108A2.quest_subtitle: "Check the library"
	quest.53FF7A32B5F108A2.title: "Unobtainium Template"
	quest.543EDB2ECDEB894E.quest_desc: [
		"Upgrade a Cloggrum Pickaxe with a Forgotten Ingot and the &eForgotten Upgrade&r template at a smithing table."
		""
		"Forgotten tools mine Undergarden blocks 1.5x faster, and it's the only way through Dreadrock."
	]
	quest.543EDB2ECDEB894E.quest_subtitle: "Break the barrier"
	quest.543EDB2ECDEB894E.title: "Forgotten Pickaxe"
	quest.5449CB4DA4B8AAB0.quest_desc: [
		"Vibranium ore goes through the same Mekanism chain. More ingots per ore, fewer trips to the Nether."
	]
	quest.5449CB4DA4B8AAB0.quest_subtitle: "Same trick, purple metal"
	quest.5449CB4DA4B8AAB0.title: "Vibranium Processing"
	quest.547FEE5E35C5C764.quest_desc: [
		"The &eForgotten Guardian&r drops Forgotten Nuggets. Nine make an ingot."
	]
	quest.547FEE5E35C5C764.quest_subtitle: "What now is"
	quest.547FEE5E35C5C764.title: "Forgotten Ingot"
	quest.54BB6929975C037B.quest_desc: [
		"Wearing a mask, sneak into an Umvuthana Grove and trade with Umvuthi for the &eSun's Blessing&r."
		""
		"With an empty hand you can call down sunstrikes and fire a solar beam."
	]
	quest.54BB6929975C037B.quest_subtitle: "Sun's Blessing"
	quest.54BB6929975C037B.title: "Heliomancer"
	quest.54BE53C99EE6D2BB.quest_desc: [
		"&eLayered Magnets&r (Overcharged Iron and Gold) are much stronger than magnetite."
		""
		"Swap them into your generator for more power from the same stress."
	]
	quest.54BE53C99EE6D2BB.quest_subtitle: "Better generators"
	quest.54BE53C99EE6D2BB.title: "Stronger Magnets"
	quest.54D066BF714DB096.quest_desc: [
		"Clear the Knight Stronghold and defeat all of the Knight Phantoms."
		""
		"This counts even if you beat them before picking up the book."
	]
	quest.54D066BF714DB096.quest_subtitle: "Settle the stronghold"
	quest.54D066BF714DB096.title: "Knight Phantoms"
	quest.54F42E0006D1A9E3.quest_desc: [
		"It lives at the top of the Lich Tower."
	]
	quest.54F42E0006D1A9E3.quest_subtitle: "Bosses of Mass Destruction"
	quest.54F42E0006D1A9E3.title: "Night Lich"
	quest.551A8E112BB73741.quest_desc: [
		"The &eEngine&r is a Boiler with a &ePrecision Mechanism&r, brass sheets and &eSturdy Sheets&r."
	]
	quest.551A8E112BB73741.quest_subtitle: "Precision power"
	quest.551A8E112BB73741.title: "Engine"
	quest.55597C7BA6F8F1AF.quest_desc: [
		"Draconic gear is &6modular&r: you fit modules into a grid on the tool or armor."
		""
		"Every module starts as a &eModule Core&r (iron, gold, redstone and a Draconium Ingot). An &eEnergy Module&r is a good first one."
	]
	quest.55597C7BA6F8F1AF.quest_subtitle: "Tools with slots"
	quest.55597C7BA6F8F1AF.title: "Module Core"
	quest.557B93F6A3C2C4B4.quest_desc: [
		"A floating fist in the Nether's Gauntlet Arena."
	]
	quest.557B93F6A3C2C4B4.quest_subtitle: "Bosses of Mass Destruction"
	quest.557B93F6A3C2C4B4.title: "Nether Gauntlet"
	quest.5583A5FCE88EBF29.quest_desc: [
		"A &eBasic Energy Cube&r buffers power and can charge items. Put one between your generators and machines."
	]
	quest.5583A5FCE88EBF29.quest_subtitle: "A battery with a view"
	quest.5583A5FCE88EBF29.title: "Energy Cube"
	quest.5586CAEA78AA7F20.quest_desc: [
		"Four Infinity Range Boosters, four &eNether Stars&r and an Eye of Ender."
		""
		"In a Wireless Access Point it gives unlimited range and works from other dimensions too. It doesn't chunk-load anything, so keep the network's chunks loaded."
	]
	quest.5586CAEA78AA7F20.quest_subtitle: "Your network, everywhere"
	quest.5586CAEA78AA7F20.title: "Dimension Card"
	quest.5592684A50C009A5.quest_desc: [
		"&eResin Clumps&r come from Creaking Hearts. Nine make a &eBlock of Resin&r."
		""
		"In ICU, Supplementaries' &eFine Wood&r is made with resin instead of honeycomb."
	]
	quest.5592684A50C009A5.quest_subtitle: "Sticky orange clumps"
	quest.5592684A50C009A5.title: "Resin"
	quest.55A4BFAC0ABC8F79.quest_desc: [
		"ICU sets keybinds once per version so no two actions share a key. Chat is on T."
		""
		"Change anything you like in Options, Controls. Your choices stay until the next ICU version resets the scheme once."
	]
	quest.55A4BFAC0ABC8F79.quest_subtitle: "Nothing doubled up"
	quest.55A4BFAC0ABC8F79.title: "Your Keybinds"
	quest.55D3D66CE21820E6.quest_desc: [
		"Hover any item (in your inventory or in EMI's item list on the right) and press:"
		""
		"&eR&r: how to &amake or get&r it."
		"&eU&r: what it's &aused in&r (crushing, machines, rituals...)."
		""
		"In EMI's item list you can also &eleft-click&r (same as R) or &eright-click&r (same as U)."
		""
		"&eA&r pins it to your favorites on the left. &eBackspace&r goes back a page. &eCtrl+F&r jumps to the search bar, &eCtrl+O&r hides or shows EMI."
		""
		"In a recipe, the &e+&r button fills your crafting grid for you (Shift for as many as you can make)."
	]
	quest.55D3D66CE21820E6.quest_subtitle: "Where does it come from, what is it for?"
	quest.55D3D66CE21820E6.title: "Using EMI"
	quest.55DDA9EF6492F9F0.quest_desc: [
		"Coal or charcoal, clay and a lava bucket make &eDielectric Paste&r. Blaze powder can replace the lava."
		""
		"Almost every Powah recipe uses it, so make a lot."
	]
	quest.55DDA9EF6492F9F0.quest_subtitle: "Powah's glue"
	quest.55DDA9EF6492F9F0.title: "Dielectric Paste"
	quest.560822A55BE8186E.quest_desc: [
		"Build a &ePocket Portal&r (grass, stone, a Dimensional Core and a diamond), place it and use it."
		""
		"Your pocket dimension is your own space. A Dimensional Suitcase takes you there from anywhere."
	]
	quest.560822A55BE8186E.quest_subtitle: "A private world"
	quest.560822A55BE8186E.title: "Your Pocket Dimension"
	quest.56173E540418F6DE.quest_desc: [
		"Goblin Knights in the Twilight Forest drop &eArmor Shards&r. Craft them into a cluster and smelt it."
	]
	quest.56173E540418F6DE.quest_subtitle: "Goblins drop the best stuff"
	quest.56173E540418F6DE.title: "Knightmetal"
	quest.564DB40C4E00FD7F.quest_desc: [
		"A &eMechanical Press&r over a &eDepot&r or belt flattens ingots into sheets."
		""
		"You'll need iron, copper, gold and brass sheets all over Create. Build this early."
	]
	quest.564DB40C4E00FD7F.quest_subtitle: "Sheets for days"
	quest.564DB40C4E00FD7F.title: "Pressing Matters"
	quest.5675AC0A2361614A.quest_desc: [
		"The &eEco Engine&r is a Boiler with iron and copper sheets and a water bucket. The &eNether Engine&r uses sturdy sheets and a lava bucket."
		""
		"Hover over each one to compare its fuel use and power."
	]
	quest.5675AC0A2361614A.quest_subtitle: "Different fuel, different feel"
	quest.5675AC0A2361614A.title: "Eco and Nether Engines"
	quest.56A407C885B47FAC.quest_desc: [
		"Pipe oxygen into a &ePurification Chamber&r. Ore becomes three &eClumps&r."
		""
		"Clumps go to the Crusher (Dirty Dust), then the Enrichment Chamber (clean Dust), then the smelter."
	]
	quest.56A407C885B47FAC.quest_subtitle: "Oxygen makes it better"
	quest.56A407C885B47FAC.title: "3x: Clumps"
	quest.56AB9C66D59416F6.quest_desc: [
		"The &eME Terminal&r shows everything stored. The &eCrafting Terminal&r adds a crafting grid that pulls straight from storage."
	]
	quest.56AB9C66D59416F6.quest_subtitle: "The window into your stuff"
	quest.56AB9C66D59416F6.title: "Terminals"
	quest.56B194033E335A62.quest_desc: [
		"Imbue a Source Gem with pedestals around it:"
		"&eEarth&r: iron, seeds, dirt. &eWater&r: water bucket, snow block, kelp. &eFire&r: flint and steel, torch, gunpowder."
		""
		"Each costs 2000 Source, so get your Sourcelinks going first."
	]
	quest.56B194033E335A62.quest_subtitle: "Earth, water, fire"
	quest.56B194033E335A62.title: "Elemental Essences"
	quest.56B246E5B703DCE6.quest_desc: [
		"Kiln Bricks are sandstone and bricks in a 2x2. Stack eight of them into a 2x2x2 cube and hit it with the hammer."
		""
		"Gold and Silver make &eElectrum&r. Copper and Nickel make &eConstantan&r. Both come out two at a time."
	]
	quest.56B246E5B703DCE6.quest_subtitle: "Two metals, one ingot"
	quest.56B246E5B703DCE6.title: "Alloy Kiln"
	quest.56E272EA25FAE250.quest_desc: [
		"The elemental crops use &eagglomeratio&r as their material: gravel, dirt and clay plus a glass bottle (air), grass (earth), water (water) or lava (fire)."
		""
		"Their essences feed the Awakening Altar later on."
	]
	quest.56E272EA25FAE250.quest_subtitle: "Air, earth, water, fire"
	quest.56E272EA25FAE250.title: "Elemental Seeds"
	quest.5716250023891AB9.quest_desc: [
		"&6ICU recipe:&r a Nether Star, two redstone blocks, a Block of Blazing Crystal and an &eUnobtainium Nugget&r make sixteen Nitro Crystals."
		""
		"The Nitro Energy Cell is as big as Powah gets. Well done!"
	]
	quest.5716250023891AB9.quest_subtitle: "Maximum Powah!"
	quest.5716250023891AB9.title: "Nitro Tier"
	quest.5741B3F5AEA1D480.quest_desc: [
		"&eFilth Corruption&r turns a rat into the &cRat King&r, a boss that throws rats at you."
		""
		"Beat it for its crown."
	]
	quest.5741B3F5AEA1D480.quest_subtitle: "Filth makes a king"
	quest.5741B3F5AEA1D480.title: "The Rat King"
	quest.5756900D7C1D99F6.quest_desc: [
		"Draconic Evolution makes the Ender Dragon drop a &eDragon Heart&r."
		""
		"Need another? Respawn the dragon with four End Crystals on the exit portal."
	]
	quest.5756900D7C1D99F6.quest_subtitle: "Still warm"
	quest.5756900D7C1D99F6.title: "Dragon Heart"
	quest.5786FC0112CCB80D.quest_desc: [
		"Bamboo and paper make six &ePaper Walls&r. Add glowstone dust for a &ePaper Lantern&r."
		""
		"Bamboo and sticks make &eBamboo Mats&r. Try hitting something with one."
	]
	quest.5786FC0112CCB80D.quest_subtitle: "A softer palette"
	quest.5786FC0112CCB80D.title: "Paper and Bamboo"
	quest.57E6CA90A4453EED.quest_desc: [
		"A &eBackpack&r is a chest you wear. Craft it from a chest, leather and string, then press &eB&r to open it."
		""
		"You can also place it on the ground (sneak and right-click) and use it like a chest."
	]
	quest.57E6CA90A4453EED.quest_subtitle: "Pockets for your pockets"
	quest.57E6CA90A4453EED.title: "A Backpack!"
	quest.58005875FFF94967.quest_desc: [
		"The &eSteering Wheel&r gives a precise rotation output. Hold right-click and move the mouse to turn it; sneak to snap to 45 degrees."
		""
		"Hook it to a bearing to steer rudders or wheels. Tell the bearing not to disassemble!"
	]
	quest.58005875FFF94967.quest_subtitle: "Hands on the wheel"
	quest.58005875FFF94967.title: "Steering Wheel"
	quest.58024E90DB5618E3.quest_desc: [
		"&eEnder Chests&r and Tanks from Ender Storage work on moving contraptions."
		""
		"A drill rig with an Ender Chest sends its loot straight home, however far it travels."
	]
	quest.58024E90DB5618E3.quest_subtitle: "Create Ender Storage"
	quest.58024E90DB5618E3.title: "Ender Storage on Contraptions"
	quest.580AF08BEA3EF0D6.quest_desc: [
		"&eDeuterium&r: pump Heavy Water with an Electric Pump holding a Filter Upgrade, then split it in the Separator."
		"&eTritium&r: Lithium from the evaporation tower, activated in the Solar Neutron Activator."
		""
		"Mix both in a Chemical Infuser. A &eHohlraum&r filled with the fuel starts the reactor."
	]
	quest.580AF08BEA3EF0D6.quest_subtitle: "Deuterium plus tritium"
	quest.580AF08BEA3EF0D6.title: "D-T Fuel"
	quest.581A4DEA39B50043.quest_desc: [
		"A few AE2 add-ons that the main AE2 chapters only touch on: ME over wires, handy terminal cards and Applied Flux's bigger energy cells."
		""
		"Pick up whichever ones your network needs."
	]
	quest.581A4DEA39B50043.quest_subtitle: "Small add-ons, big comfort"
	quest.581A4DEA39B50043.title: "More for Your Network"
	quest.583B9033857FFC23.quest_desc: [
		"They haunt the Knight Stronghold in the Dark Forest."
	]
	quest.583B9033857FFC23.quest_subtitle: "Twilight Forest"
	quest.583B9033857FFC23.title: "Knight Phantoms"
	quest.583E7A9F84C48C29.quest_desc: [
		"&eNetherite pickaxe:&r Allthemodium ore (Deep Dark, Mining dimension, The Other)."
		"&eAllthemodium pickaxe:&r Vibranium ore (Nether, The Other)."
		"&eVibranium pickaxe:&r Unobtainium ore (End highlands)."
		""
		"Other tools follow the same ladder:"
		"- &eLike Netherite:&r Dark Matter tools, the Atomic Disassembler, Forgotten tools."
		"- &eLike Allthemodium:&r Red Matter tools, the Meka-Tool, Wyvern tools, Supremium and Awakened Supremium tools."
	]
	quest.583E7A9F84C48C29.quest_subtitle: "The rare-metal ladder"
	quest.583E7A9F84C48C29.title: "Which Pickaxe Mines What"
	quest.5849EB7850091973.quest_desc: [
		"When you die, a &eCorpse&r stays behind with all your items. Walk back and right-click it to get everything back."
		""
		"It won't burn in lava or fall into the void, so take your time."
	]
	quest.5849EB7850091973.quest_subtitle: "Your stuff is safe"
	quest.5849EB7850091973.title: "You Died!"
	quest.58506E6500842F28.quest_desc: [
		"Walls of &eFission Reactor Casing&r (or Reactor Glass), with &eFuel Assemblies&r stacked inside and a &eControl Rod Assembly&r on top of each stack."
		""
		"Control rods need an &eElite Control Circuit&r."
	]
	quest.58506E6500842F28.quest_subtitle: "Big, hot and dangerous"
	quest.58506E6500842F28.title: "Fission Reactor"
	quest.585821130FBBED92.quest_desc: [
		"The Ferrous Wroughtnaut drops its axe and helm. Neither ever breaks."
		""
		"Right-click the axe to swing in a wide arc, or sneak and right-click to send out a shockwave."
	]
	quest.585821130FBBED92.quest_subtitle: "Wroughtnaut loot"
	quest.585821130FBBED92.title: "Axe of a Thousand Metals"
	quest.588DA15EC8AAB0BC.quest_desc: [
		"The &eReactor Controller&r needs a diamond, a comparator and two uranium ingots. One per reactor, on an outside wall."
	]
	quest.588DA15EC8AAB0BC.quest_subtitle: "The brain"
	quest.588DA15EC8AAB0BC.title: "Reactor Controller"
	quest.58B15EA53CCFC2A7.quest_desc: [
		"The biggest Mechanical Crafter recipe here: a Cargo Airship, engines, propellers, reinforced hulls, industrial iron and a Heavy Crossbow."
		""
		"Put weapons like the &eRotary Cannon&r or &eBomb Bay&r in its weapon slots."
	]
	quest.58B15EA53CCFC2A7.quest_subtitle: "A flying fortress"
	quest.58B15EA53CCFC2A7.title: "Warship"
	quest.58D86E9C24224C58.quest_desc: [
		"Crafting Units, Crafting Storage and Co-Processing Units form one box-shaped &eCrafting CPU&r."
		""
		"Storage decides how big a job it can plan; co-processors make it faster. Now ask for an item and watch it go!"
	]
	quest.58D86E9C24224C58.quest_subtitle: "The planning department"
	quest.58D86E9C24224C58.title: "Crafting CPU"
	quest.5918E88696F32B3F.quest_desc: [
		"ICU's 64M component takes an &eAllthemodium Ingot&r. Wrap it in a MEGA housing."
	]
	quest.5918E88696F32B3F.quest_subtitle: "Allthemodium inside"
	quest.5918E88696F32B3F.title: "MEGA 64M"
	quest.591A193D9BBE9497.quest_desc: [
		"The &eLatex Processing Unit&r mixes Latex and water into &eDry Rubber&r."
	]
	quest.591A193D9BBE9497.quest_subtitle: "Latex plus water"
	quest.591A193D9BBE9497.title: "Latex Processing"
	quest.593E2860757CD0B1.quest_desc: [
		"The &eMob Grinder&r kills mobs around it using power. Pair it with a spawner or a dark room."
		""
		"It needs a Wyvern Energy Controller and a mob skull."
	]
	quest.593E2860757CD0B1.quest_subtitle: "Hands-free mob farming"
	quest.593E2860757CD0B1.title: "Mob Grinder"
	quest.594EB178280225C7.quest_desc: [
		"The &eMagmatic Generator&r burns lava instead of solid fuel. Pipe a steady supply in."
	]
	quest.594EB178280225C7.quest_subtitle: "Lava power"
	quest.594EB178280225C7.title: "Magmatic Generator"
	quest.596D7EAE2B064674.quest_desc: [
		"Hold 36 &eReactor&r blocks and place one with open space around it (the guide asks for a 3x4 area). It builds itself!"
		""
		"Fuel it with Uraninite. Carbon, redstone and a coolant (water, ice or &eDry Ice&r) all improve it."
	]
	quest.596D7EAE2B064674.quest_subtitle: "Self-building multiblock"
	quest.596D7EAE2B064674.title: "Powah Reactor"
	quest.597B1A0734E42C15.quest_desc: [
		"Brass on stripped logs gives you Brass Casing."
		""
		"&6Heads up:&r in ICU, Mekanism's &eSteel Casing&r needs a Brass Casing."
	]
	quest.597B1A0734E42C15.quest_subtitle: "Remember this one too!"
	quest.597B1A0734E42C15.title: "Brass Casing"
	quest.59801064CAA2277F.quest_desc: [
		"YUNG's mods rebuild dungeons, mineshafts, Nether fortresses, ocean monuments and the End island."
		""
		"Step into one of the upgraded monster rooms underground."
	]
	quest.59801064CAA2277F.quest_subtitle: "Renovated monster rooms"
	quest.59801064CAA2277F.title: "Better Dungeons"
	quest.5987E4B7CA0862C5.quest_desc: [
		"&eScylla&r, the Storm Empress, rules the Acropolis. She drops the Essence of the Storm."
	]
	quest.5987E4B7CA0862C5.quest_subtitle: "Scylla's gift"
	quest.5987E4B7CA0862C5.title: "Essence of the Storm"
	quest.59B1D247C2FE1E42.quest_desc: [
		"&eRavager Hide&r drops from Ravagers in raids. One of it, leather, iron and a chest make a &eBackpack&r."
		""
		"Wear it in your chestplate slot for three extra rows of inventory. It never breaks, but you have to empty it before you can take it off."
		""
		"&6Heads up:&r ICU's main backpacks are &eSophisticated Backpacks&r (see the Storage chapter). Quark's is simpler, and it costs you your chestplate."
	]
	quest.59B1D247C2FE1E42.quest_subtitle: "Three more rows"
	quest.59B1D247C2FE1E42.title: "Quark's Backpack"
	quest.59D94EC1FE7E32E5.quest_desc: [
		"Build a &eWaystone&r in the Mechanical Crafter (EMI shows the grid). Name it, and you can warp between any waystones you've visited."
	]
	quest.59D94EC1FE7E32E5.quest_subtitle: "Fast travel, earned"
	quest.59D94EC1FE7E32E5.title: "Your First Waystone"
	quest.59EF14D922093768.quest_desc: [
		"Ancient Anima on an Obsidian Heart on obsidian. Place it and mobs stop spawning within 64 blocks."
	]
	quest.59EF14D922093768.quest_subtitle: "No more spawns"
	quest.59EF14D922093768.title: "Staff of Suppression"
	quest.5A212F9299E41E19.quest_desc: [
		"&eCloggrum&r ore is everywhere in the Depthrock. It's about as good as iron and makes your first Undergarden tools."
	]
	quest.5A212F9299E41E19.quest_subtitle: "Iron's gloomy cousin"
	quest.5A212F9299E41E19.title: "Cloggrum"
	quest.5A3B4969347F8C7F.quest_desc: [
		"Throw a Wilden Horn near a wild Drygmy to get a token, then charm it on the apparatus with food, seeds and Source Gems."
		""
		"Use the charm on &eMossy Cobblestone&r to make a Drygmy Henge. It copies drops from mobs around it into a chest. More kinds of mobs make it happier."
	]
	quest.5A3B4969347F8C7F.quest_subtitle: "Mob drops, no mobs harmed"
	quest.5A3B4969347F8C7F.title: "Drygmy"
	quest.5A41F682D1DD2FFD.quest_desc: [
		"Craft a boat together with a furnace."
		""
		"Sneak and right-click the &eBoat with Furnace&r to put fuel in. While it burns, the boat goes faster. It only seats one."
	]
	quest.5A41F682D1DD2FFD.quest_subtitle: "Coal-powered paddling"
	quest.5A41F682D1DD2FFD.title: "Boat with Furnace"
	quest.5A7BC2FD766F4D1B.quest_desc: [
		"The &eWither Builder&r builds and summons Withers for you: plastic, a nether star, wither skeleton skulls and soul sand around a &eSupreme Frame&r."
		""
		"The Supreme Frame needs Allthemodium, Ignitium and Ether Gas. Great work reaching the top of IF!"
	]
	quest.5A7BC2FD766F4D1B.quest_subtitle: "IF's top shelf"
	quest.5A7BC2FD766F4D1B.title: "Supreme Machinery"
	quest.5A8F5F879241C296.quest_desc: [
		"Maledictus drops &eCursium Ingots&r. They upgrade Netherite armor into Cursium armor with ghostly tricks, like reviving once when you die."
	]
	quest.5A8F5F879241C296.quest_subtitle: "Ghostly armor"
	quest.5A8F5F879241C296.title: "Cursium"
	quest.5ABC7643D6842F49.quest_desc: [
		"An ME Chest, a storage component, an Energy Cell and a Source Cell Housing make a &ePortable Source Cell&r."
		""
		"Handy for carrying Source out to a far-away build."
	]
	quest.5ABC7643D6842F49.quest_subtitle: "Source on the go"
	quest.5ABC7643D6842F49.title: "Portable Source Cell"
	quest.5AD91616D943DDB7.quest_desc: [
		"It burns &eNether Stars&r for an enormous amount of power per second. Pricey fuel, but a Wither farm can keep it fed."
	]
	quest.5AD91616D943DDB7.quest_subtitle: "Burning stars"
	quest.5AD91616D943DDB7.title: "Nether Star Generator"
	quest.5B0A107D681BA4A4.quest_desc: [
		"A huge ram in a stone circle wants one of every wool color. Feed it all sixteen and it pays out."
	]
	quest.5B0A107D681BA4A4.quest_subtitle: "Bring me wool!"
	quest.5B0A107D681BA4A4.title: "The Questing Ram"
	quest.5B0ABFDE1125698E.quest_desc: [
		"Put an &eEnergy Meter&r between two cables to see how much power flows through it."
		""
		"Great for finding the machine that eats everything."
	]
	quest.5B0ABFDE1125698E.quest_subtitle: "Where is my power going?"
	quest.5B0ABFDE1125698E.title: "Energy Meter"
	quest.5B16747988757C5D.quest_desc: [
		"A Packager and an Unpackager in one block, on your ME network (it uses a channel). Put an encoded holder in and AE2 autocrafting can use those recipes."
	]
	quest.5B16747988757C5D.quest_subtitle: "Straight into AE2"
	quest.5B16747988757C5D.title: "ME Packaging Provider"
	quest.5B2477A2712D13A3.quest_desc: [
		"Crops on tilled &eRich Soil&r grow faster. Mushrooms planted on plain Rich Soil spread into &eMushroom Colonies&r."
		""
		"Cut a colony on the board for a pile of mushrooms."
	]
	quest.5B2477A2712D13A3.quest_subtitle: "The best dirt in the pack"
	quest.5B2477A2712D13A3.title: "Rich Soil"
	quest.5B9414A12E616934.quest_desc: [
		"The &eLaser Drill&r (Simple Frame) doesn't mine by itself. It beams power into a laser base."
		""
		"Check the base in EMI or the IF manual for how to place the drills around it."
	]
	quest.5B9414A12E616934.quest_subtitle: "The power source"
	quest.5B9414A12E616934.title: "Laser Drill"
	quest.5BA84674BF1A72D7.quest_desc: [
		"Integrated Dungeons and Structures hides &eCastles&r in forests, birch forests, plains and meadows."
		""
		"Step inside one."
	]
	quest.5BA84674BF1A72D7.quest_subtitle: "Knock knock"
	quest.5BA84674BF1A72D7.title: "Castle"
	quest.5BBB69E1C960529B.quest_desc: [
		"A &eFlux Crafter&r works the same way, but its &eFlux Alternators&r need power."
		""
		"It makes Enhanced Redstone Ingots and Flux Stars."
	]
	quest.5BBB69E1C960529B.quest_subtitle: "Waiting, plus power"
	quest.5BBB69E1C960529B.title: "Flux Crafting"
	quest.5BBE15C7C414E4C8.quest_desc: [
		"&eBeef Stew&r is raw beef, a carrot and a potato. &eVegetable Soup&r is carrot, potato, beetroot and a leafy green."
		""
		"Meals from the pot give the &eNourishment&r effect, so your hunger stays full for a while."
	]
	quest.5BBE15C7C414E4C8.quest_subtitle: "Warm and filling"
	quest.5BBE15C7C414E4C8.title: "Hearty Stews"
	quest.5BC17C04EB21AE87.quest_desc: [
		"Put an iron ingot and a gold ingot around your Energizing Orb to make &eEnergized Steel&r."
		""
		"It's the metal for the Hardened tier."
	]
	quest.5BC17C04EB21AE87.quest_subtitle: "Iron plus gold plus power"
	quest.5BC17C04EB21AE87.title: "Energized Steel"
	quest.5BE682933309440B.quest_desc: [
		"The Ancient Factory is buried deep underground. The &eHarbinger&r sleeps inside."
		""
		"The Eye of Mech is made on a Create sequenced assembly line."
	]
	quest.5BE682933309440B.quest_subtitle: "Out of place"
	quest.5BE682933309440B.title: "The Ancient Factory"
	quest.5BE6D6BB6022BB23.quest_desc: [
		"Uranium ingots become &eYellow Cake&r in the Enrichment Chamber, then Uranium Oxide in the Chemical Oxidizer."
		""
		"Mix it with Hydrofluoric Acid (fluorite dissolved in Sulfuric Acid) and spin the result in an &eIsotopic Centrifuge&r (Ultimate circuit) for Fissile Fuel."
	]
	quest.5BE6D6BB6022BB23.quest_subtitle: "The long way round"
	quest.5BE6D6BB6022BB23.title: "Fissile Fuel"
	quest.5BECE34378F07E35.quest_desc: [
		"Some quests are just reading. Click the checkmark to finish them and grab the reward."
		""
		"Item quests finish as soon as the item is in your inventory. Nothing gets taken from you."
	]
	quest.5BECE34378F07E35.quest_subtitle: "Like this one!"
	quest.5BECE34378F07E35.title: "About Checkmark Quests"
	quest.5C000C521BDC88BD.quest_desc: [
		"Quantum Rings, a Quantum Link Chamber and an Advanced Card."
		""
		"It lets a wireless terminal connect through a Quantum Bridge, so your range has no limit."
	]
	quest.5C000C521BDC88BD.quest_subtitle: "Wireless, the long way round"
	quest.5C000C521BDC88BD.title: "Quantum Bridge Card"
	quest.5C1DAC8581397EE7.quest_desc: [
		"The same fusion recipe on a diamond chestplate gives the &eWyvern Chestpiece&r."
		""
		"Add shield modules and it soaks damage with energy instead of your health."
	]
	quest.5C1DAC8581397EE7.quest_subtitle: "Shields up"
	quest.5C1DAC8581397EE7.title: "Wyvern Armor"
	quest.5C2DC01D9838CA10.quest_desc: [
		"The &eGyrodyne&r needs no fuel at all: you power it with your legs. Pedal hard and it lifts off."
		""
		"Recipe: sails, hulls, a propeller, a precision mechanism and a seat."
	]
	quest.5C2DC01D9838CA10.quest_subtitle: "Pedal power"
	quest.5C2DC01D9838CA10.title: "Gyrodyne"
	quest.5C35F1B95DCA8CDD.quest_desc: [
		"Four ingots (or diamonds) around an iron nugget. The Metal Press with a gear mold works too."
		""
		"IF machines want gold and diamond gears a lot."
	]
	quest.5C35F1B95DCA8CDD.quest_subtitle: "Round and useful"
	quest.5C35F1B95DCA8CDD.title: "Gears"
	quest.5C3B402AD003EC76.quest_desc: [
		"Ancient Debris sits low in the Nether. Beds and TNT blow it loose; smelt it into scrap, then four scrap plus four gold make an ingot."
		""
		"You need a Netherite pickaxe for Allthemodium."
	]
	quest.5C3B402AD003EC76.quest_subtitle: "The Nether's hardest find"
	quest.5C3B402AD003EC76.title: "Ancient Debris"
	quest.5C3F456633569996.quest_desc: [
		"The 5x line runs on &eSulfuric Acid&r. The quick route: &eSulfur Dust&r converts straight into acid in the machine's chemical slot."
		""
		"Get sulfur by injecting gunpowder with Hydrogen Chloride. The long route uses the Chemical Oxidizer and Infuser (check EMI)."
	]
	quest.5C3F456633569996.quest_subtitle: "Dissolves just about anything"
	quest.5C3F456633569996.title: "Sulfuric Acid"
	quest.5C4749C0E9419FF0.quest_desc: [
		"Soul sand, three wither skeleton skulls, and somewhere that is &lnot&r your base."
		""
		"Each Wither drops one Nether Star."
	]
	quest.5C4749C0E9419FF0.quest_subtitle: "Wither away"
	quest.5C4749C0E9419FF0.title: "Nether Stars"
	quest.5C49BF3C0124A3BA.quest_desc: [
		"Four copper ingots make a &eWrench&r. Use it on a block to rotate it."
		""
		"A &eTurn Table&r does the same with redstone, and spins anything standing on it."
	]
	quest.5C49BF3C0124A3BA.quest_subtitle: "Turn it around"
	quest.5C49BF3C0124A3BA.title: "Wrench"
	quest.5C522DB94AE5DFD1.quest_desc: [
		"Four cobblestone, a redstone torch and a redstone dust make a &eRedstone Relay&r. It passes a full-strength signal to its front."
		""
		"Put a relay back in the crafting grid to cycle it through the &eInverted&r, &eBi-Stable&r (a toggle), &ePulse&r and &eBridging&r relays. Hover each one for what it does."
	]
	quest.5C522DB94AE5DFD1.quest_subtitle: "Five chips in one recipe"
	quest.5C522DB94AE5DFD1.title: "Redstone Relays"
	quest.5C5428D0F9177C42.quest_desc: [
		"Four &eEnd Crystals&r on the exit portal's edges bring the dragon back. That's how you get more Dragon Hearts."
	]
	quest.5C5428D0F9177C42.quest_subtitle: "The dragon comes back"
	quest.5C5428D0F9177C42.title: "Another Round"
	quest.5C63A4C20A47D3CE.quest_desc: [
		"&eCorundum&r crystals grow in big underground clusters between Y 0 and 64, two colors per cluster."
		""
		"Four redstone around a Corundum block make a &eCrystal Lamp&r in that color. Power it and it glows at full brightness, and it tints a beacon beam while it's on."
	]
	quest.5C63A4C20A47D3CE.quest_subtitle: "Crystal lights"
	quest.5C63A4C20A47D3CE.title: "Corundum Lamps"
	quest.5C73F4534B0449CF.quest_desc: [
		"Ecologics slips a music disc, &eCoconut&r, into every Buried Treasure chest. Follow a treasure map from a shipwreck or ocean ruin and dig it up."
	]
	quest.5C73F4534B0449CF.quest_subtitle: "X marks the song"
	quest.5C73F4534B0449CF.title: "Buried Treasure Tune"
	quest.5C85B3849A52C81F.quest_desc: [
		"Fuse a Wyvern injector with two Wyvern Cores, an &eAwakened Draconium Block&r and diamonds."
		""
		"Draconic-tier gear needs these."
	]
	quest.5C85B3849A52C81F.quest_subtitle: "Tier three fusion"
	quest.5C85B3849A52C81F.title: "Draconic Injectors"
	quest.5C906415F22EA849.quest_desc: [
		"ICU's recipe: a Basic Circuit, two Infused Alloy and a &eFiery Ingot&r."
		""
		"The Infuser shortcut is turned off, so the Hydra is the only way through. Nice work!"
	]
	quest.5C906415F22EA849.quest_subtitle: "Tier 2 complete!"
	quest.5C906415F22EA849.title: "Advanced Control Circuit"
	quest.5C925412E1E145A8.quest_desc: [
		"The &eCheese Staff&r sets where a tamed rat picks items up and where it drops them off."
		""
		"Point it at a chest, then at the rat's work spot. That's most of rat logistics."
	]
	quest.5C925412E1E145A8.quest_subtitle: "Tell your rat where to go"
	quest.5C925412E1E145A8.title: "The Cheese Staff"
	quest.5C9398E120AB7D8F.quest_desc: [
		"Eight &eQuantum Rings&r around a &eQuantum Link Chamber&r on each end, with a pair of Quantum Entangled Singularities."
		""
		"Make the pair by blowing up a Singularity with ender dust. Works across dimensions!"
	]
	quest.5C9398E120AB7D8F.quest_subtitle: "Across any distance"
	quest.5C9398E120AB7D8F.title: "Quantum Bridge"
	quest.5CA204DCA58A500E.quest_desc: [
		"&eBoatload&r adds bigger boats, boats with furnaces and Nether wood boats. Later on, &eDyeable Components&r lets you paint your Aeronautics tires and levitite."
		""
		"Start small. Or large."
	]
	quest.5CA204DCA58A500E.quest_subtitle: "Boats first, airships later"
	quest.5CA204DCA58A500E.title: "More Ways to Float"
	quest.5CA3C920AC948FBD.quest_desc: [
		"Awakened Draconium ingots, two Wyvern Energy Controllers and a Wyvern Core."
	]
	quest.5CA3C920AC948FBD.quest_subtitle: "More storage, more awake"
	quest.5CA3C920AC948FBD.title: "Draconic Energy Controller"
	quest.5CBD54CD2D64844F.quest_desc: [
		"The &ePortable Teleporter&r jumps you to any Teleporter frequency you can use. Keep it charged."
	]
	quest.5CBD54CD2D64844F.quest_subtitle: "A teleporter in your pocket"
	quest.5CBD54CD2D64844F.title: "Portable Teleporter"
	quest.5CBFC950AD570491.quest_desc: [
		"&eAeroWarptics&r lets ships jump long distances. It starts with a &eRift Core&r: precision mechanism, electron tubes, brass and levitite mixed in a heated basin."
		""
		"Craft the &eNavigator's Handbook&r too. It explains the whole system."
	]
	quest.5CBFC950AD570491.quest_subtitle: "Folding space"
	quest.5CBFC950AD570491.title: "Rift Core"
	quest.5CCFA16DF820696E.quest_desc: [
		"Put a &eWindmill Bearing&r on a block, glue &eSails&r to it, and right-click the bearing to start it."
		""
		"More sails means more stress capacity. Build big and high."
	]
	quest.5CCFA16DF820696E.quest_subtitle: "Catch the breeze"
	quest.5CCFA16DF820696E.title: "Windmills"
	quest.5CD51A64C0EDA4FF.quest_desc: [
		"A Maze Map Focus surrounded by eight crafting tables."
		""
		"&6Heads up:&r ICU turns the uncrafting part off. The table still repairs and re-crafts gear while keeping its enchantments."
	]
	quest.5CD51A64C0EDA4FF.quest_subtitle: "Well, mostly"
	quest.5CD51A64C0EDA4FF.title: "Uncrafting Table"
	quest.5CE33E96A663003C.quest_desc: [
		"Iron, iron bars and slabs make a &eCage&r for small animals: chickens, rabbits, foxes, bats and more, plus baby cows, pigs, sheep and goats."
		""
		"Cats, parrots and other pets have to be tamed first."
	]
	quest.5CE33E96A663003C.quest_subtitle: "Bring them home"
	quest.5CE33E96A663003C.title: "Cage"
	quest.5CE4D5A062C4688C.quest_desc: [
		"An Airship, a Hull and six chests. It's slow and burns lots of fuel, but carries a whole chest of storage."
	]
	quest.5CE4D5A062C4688C.quest_subtitle: "A flying warehouse"
	quest.5CE4D5A062C4688C.title: "Cargo Airship"
	quest.5CE5ECB5F6A11F21.quest_desc: [
		"The Night Lich drops &eAncient Anima&r, a key ingredient for most Mass Destruction gear."
	]
	quest.5CE5ECB5F6A11F21.quest_subtitle: "Night Lich loot"
	quest.5CE5ECB5F6A11F21.title: "Ancient Anima"
	quest.5D00FA9588BE6C34.quest_desc: [
		"Beat the Nether Gauntlet and open its chest for a &eBlazing Eye&r."
	]
	quest.5D00FA9588BE6C34.quest_subtitle: "Nether Gauntlet loot"
	quest.5D00FA9588BE6C34.title: "Blazing Eye"
	quest.5D0443266980E07E.quest_desc: [
		"A &eMechanical Mixer&r over a &eBasin&r mixes whatever you drop in. It makes alloys, dough, and plenty more."
		""
		"Some mixes need heat. That's what Blaze Burners are for."
	]
	quest.5D0443266980E07E.quest_subtitle: "Basin chemistry"
	quest.5D0443266980E07E.title: "Mix It Up"
	quest.5D0883D70C89437C.quest_desc: [
		"The &eAdvanced Motor&r uses Brass Casing and Overcharged Iron. Add a &eMotor Extension&r behind a motor to raise its stress capacity."
	]
	quest.5D0883D70C89437C.quest_subtitle: "More stress, more speed"
	quest.5D0883D70C89437C.title: "Advanced Motor"
	quest.5D47187662D10663.quest_desc: [
		"The &ePortable Engine&r burns fuel for rotation, no water wheel needed. It's a must for ships."
		""
		"Make an &eEngine Assembly&r by sequenced assembly on an iron sheet, then add a blast furnace and an iron sheet. A Blaze Cake superheats it for more power."
	]
	quest.5D47187662D10663.quest_subtitle: "Power in a box"
	quest.5D47187662D10663.title: "Portable Engine"
	quest.5D53DA6F4A5998FE.quest_desc: [
		"A huge stone guardian of the Undergarden. It drops Forgotten Nuggets."
	]
	quest.5D53DA6F4A5998FE.quest_subtitle: "The Undergarden"
	quest.5D53DA6F4A5998FE.title: "Forgotten Guardian"
	quest.5D7B453B6BAA706B.quest_desc: [
		"Charged &eFree Runners&r let you walk up full blocks and soak up fall damage."
		""
		"Charge them in an Energy Cube's slot."
	]
	quest.5D7B453B6BAA706B.quest_subtitle: "Step up, never fall hard"
	quest.5D7B453B6BAA706B.title: "Free Runners"
	quest.5D82E97898E9ECDE.quest_desc: [
		"&eHot Air Envelope&r blocks (wool and sticks) enclose a volume that holds hot air. It must be &eairtight&r."
		""
		"Blocks inside the balloon take up volume. Shafts can pass through an Envelope Encased Shaft. Dye them any color."
	]
	quest.5D82E97898E9ECDE.quest_subtitle: "Balloon fabric"
	quest.5D82E97898E9ECDE.title: "Envelopes"
	quest.5D9F6482421C96CD.quest_desc: [
		"The Supreme Frame takes an &eAllthemodium Ingot&r and an &eIgnitium Ingot&r."
		""
		"It also needs 135 mB of &eEther Gas&r: a Fluid Laser Base with a &ePurple Laser Lens&r and a live Wither kept in its working area (see Industrial Foregoing)."
		""
		"Great work. Next stop: Vibranium."
	]
	quest.5D9F6482421C96CD.quest_subtitle: "Tier 3 complete!"
	quest.5D9F6482421C96CD.title: "Supreme Machine Frame"
	quest.5E07162AE041ADD6.quest_desc: [
		"Dirt, Straw, bone meal and Tree Bark (or rotten flesh) make &eOrganic Compost&r."
		""
		"Leave it in the world and it slowly turns into &eRich Soil&r."
	]
	quest.5E07162AE041ADD6.quest_subtitle: "Feed the dirt"
	quest.5E07162AE041ADD6.title: "Organic Compost"
	quest.5E310B3163145371.quest_desc: [
		"Redstone, gold and Infused Alloy make an &eEnergy Tablet&r."
		""
		"It goes into energy cubes, jetpacks, solar panels and more. Make a few."
	]
	quest.5E310B3163145371.quest_subtitle: "A battery in your pocket"
	quest.5E310B3163145371.title: "Energy Tablet"
	quest.5E7CF06585DF2341.quest_desc: [
		"A &eSpout&r fills items below it (buckets, bottles, or recipes like honeyed apples). An &eItem Drain&r empties them."
		""
		"Both need &eCopper Casing&r: copper ingots on stripped logs."
	]
	quest.5E7CF06585DF2341.quest_subtitle: "Fill and empty"
	quest.5E7CF06585DF2341.title: "Spout and Drain"
	quest.5EAD721716AEE19C.quest_desc: [
		"TNT, iron and string make four &eBombs&r. Throw them at mobs."
		""
		"&6Heads up:&r in ICU bombs don't blast apart terrain the way TNT does, so they're for fighting, not mining."
	]
	quest.5EAD721716AEE19C.quest_subtitle: "Pocket explosives"
	quest.5EAD721716AEE19C.title: "Bombs"
	quest.5EE810AAC3BC839F.quest_desc: [
		"The Sunken City lies on the floor of the deep ocean. The &eLeviathan&r waits inside. Bring water breathing."
	]
	quest.5EE810AAC3BC839F.quest_subtitle: "Deep, deep water"
	quest.5EE810AAC3BC839F.title: "The Sunken City"
	quest.5F033DFD0CCB2D8E.quest_desc: [
		"Infinity tools never break and hit absurdly hard. The pickaxe even has a huge area mining mode."
	]
	quest.5F033DFD0CCB2D8E.quest_subtitle: "And the Sword of the Cosmos"
	quest.5F033DFD0CCB2D8E.title: "World Breaker"
	quest.5F22A5A035520D4A.quest_desc: [
		"Give the game 10 to 11 GB of RAM. More than 12 GB makes lag spikes worse, not better."
		""
		"Optional: in CurseForge, InfinityCraft Ultra, Profile Options, Java Arguments, add:"
		"&7-XX:+UseZGC -XX:+ZGenerational -XX:+UseStringDeduplication --add-modules jdk.incubator.vector&r"
		""
		"Playing on a server? ICU includes &eVery Many Players&r, which helps servers run smoother when many players are online. Nothing to set up."
	]
	quest.5F22A5A035520D4A.quest_subtitle: "Fewer lag spikes"
	quest.5F22A5A035520D4A.title: "Smoother Play"
	quest.5F44E8ABC9485D33.quest_desc: [
		"Mob crops use a &eSoulium Seed Base&r and a full Soul Jar on the altar."
		""
		"Zombie, skeleton and creeper crops give you their drops without the fighting."
	]
	quest.5F44E8ABC9485D33.quest_subtitle: "Grow a zombie. Well, its drops."
	quest.5F44E8ABC9485D33.title: "Mob Seeds"
	quest.5F5DC2AA33DE2D2D.quest_desc: [
		"Put two &eFluid Ports&r on a Reinforced reactor: one pumps water in, the other pulls steam out."
		""
		"Pipe that steam into your Turbine. An actively cooled reactor is far more efficient."
	]
	quest.5F5DC2AA33DE2D2D.quest_subtitle: "Reactor plus turbine"
	quest.5F5DC2AA33DE2D2D.title: "Active Cooling"
	quest.5F6FC55A28843ECF.quest_desc: [
		"A Starbuncle Charm and a Create Water Wheel make a &eStarbuncle Wheel&r. It spins out rotational force."
		""
		"Put a block of gold in front of it for more RPM."
	]
	quest.5F6FC55A28843ECF.quest_subtitle: "Ars Creo: cute rotational force"
	quest.5F6FC55A28843ECF.title: "Starbuncle Wheel"
	quest.5F788DC601E265BE.quest_desc: [
		"Umvuthi drops the &eSol Visage&r. Wear it, then right-click with a mask in hand to summon an Umvuthana helper."
	]
	quest.5F788DC601E265BE.quest_subtitle: "Wear the sun"
	quest.5F788DC601E265BE.title: "Sol Visage"
	quest.5F7AB4C55E1DC9B8.quest_desc: [
		"&eChutes&r move items straight up or down (up needs a fan). A &eDepot&r holds one stack for a press or spout to work on."
	]
	quest.5F7AB4C55E1DC9B8.quest_subtitle: "Up, down and hold"
	quest.5F7AB4C55E1DC9B8.title: "Chutes and Depots"
	quest.5F82F07555CD9F62.quest_desc: [
		"The &eDrawer Controller&r links all drawers touching it (and each other)."
		"Insert into the controller and items go to the right drawer. Pipe it into the rest of your base."
		""
		"Double-click it to dump your whole inventory into matching drawers."
	]
	quest.5F82F07555CD9F62.quest_subtitle: "One face for the whole wall"
	quest.5F82F07555CD9F62.title: "Drawer Controller"
	quest.5FB3E6374ECEFC0D.quest_desc: [
		"Project Expansion packs collectors and relays into one block: the &ePower Flower&r adds EMC straight to your personal total."
		""
		"It needs compressed collectors, relays and an &eEMC Link&r. Check EMI for the full chain."
		""
		"The basic tier needs a Brass Casing, &eMagenta Matter&r needs an Unobtainium Nugget, and the Final tier needs a Chaos Fragment from the Chaos Guardian."
	]
	quest.5FB3E6374ECEFC0D.quest_subtitle: "Project Expansion"
	quest.5FB3E6374ECEFC0D.title: "Power Flower"
	quest.5FC82A1D4895456B.quest_desc: [
		"&eCattails&r grow along rivers and in swamps. Use shears on one to take its fluff."
		""
		"Seven &eCattail Fluff&r craft into a piece of string."
	]
	quest.5FC82A1D4895456B.quest_subtitle: "Swamp cotton"
	quest.5FC82A1D4895456B.title: "Fluff Content"
	quest.5FF574F3ADF23625.quest_desc: [
		"Eight chests around an ender chest make a &eCompressed Chest&r, which is only used in structure recipes."
		""
		"Add compressed stone and compressed lights for a &eWarehouse&r, a big building ready for your storage."
	]
	quest.5FF574F3ADF23625.quest_subtitle: "Room for everything"
	quest.5FF574F3ADF23625.title: "Warehouse"
	quest.60087CED26DE3F52.quest_desc: [
		"Vibranium ore needs an Allthemodium pickaxe."
	]
	quest.60087CED26DE3F52.quest_subtitle: "The right tool for the job"
	quest.60087CED26DE3F52.title: "Allthemodium Pickaxe"
	quest.600C70C73D042D25.quest_desc: [
		"&eMonorail Track&r is built from metal girders and brackets. Trains ride it with monorail bogeys."
		""
		"Great for sky lines over your base."
	]
	quest.600C70C73D042D25.quest_subtitle: "Hanging on"
	quest.600C70C73D042D25.title: "Monorail"
	quest.6025BEAD022C68F9.quest_desc: [
		"Cut a Raw Gwibling on the board for &eRaw Gwibfillet&r, then roll two of them with Cooked Rice."
	]
	quest.6025BEAD022C68F9.quest_subtitle: "Undergarden sushi"
	quest.6025BEAD022C68F9.title: "Gwibfillet Roll"
	quest.6035611E73A45623.quest_desc: [
		"256M too. Big storage, big metal."
	]
	quest.6035611E73A45623.quest_subtitle: "All the bytes"
	quest.6035611E73A45623.title: "MEGA 256M"
	quest.603BE1B63F039E78.quest_desc: [
		"Select a track, then place a &eTrack Switch&r nearby. Use it to point trains left, straight or right."
		""
		"Redstone can set it too, and comparators read which way it points."
	]
	quest.603BE1B63F039E78.quest_subtitle: "Choose your path"
	quest.603BE1B63F039E78.title: "Track Switches"
	quest.60409AD7ED6369BC.quest_desc: [
		"A drawer holds many stacks of &eone&r item and shows what's inside on the front. Craft one from planks around a chest."
		""
		"Craft one drawer into an &eUpgrade Template&r. Every drawer upgrade starts from it."
		""
		"Later, Mekanism &eBins&r do a similar job. See the Mekanism chapter."
	]
	quest.60409AD7ED6369BC.quest_subtitle: "One item, lots of it"
	quest.60409AD7ED6369BC.title: "Storage Drawers"
	quest.606556DD47F9CD1E.quest_desc: [
		"Made in the &eUltimate&r table from one of every Singularity."
		""
		"Nothing in ICU uses it. It's a trophy."
	]
	quest.606556DD47F9CD1E.quest_subtitle: "One of everything"
	quest.606556DD47F9CD1E.title: "The Ultimate Singularity"
	quest.60682097CE2F0712.quest_desc: [
		"The Nether table turns ancient debris, blaze rods and fire charges into a &eBlaze Cube&r."
		""
		"Blaze tools smelt, burn and scorch as they work. Fun, and not required."
	]
	quest.60682097CE2F0712.quest_subtitle: "Hot tools"
	quest.60682097CE2F0712.title: "Blaze Cube"
	quest.606F40CCE784904B.quest_desc: [
		"Four chests around a lectern on the apparatus make a &eStorage Lectern&r, a crafting terminal for nearby storage."
		""
		"Bookwyrm Charms extend its reach. Get them from a &eRitual of Awakening&r augmented with a Book and Quill."
	]
	quest.606F40CCE784904B.quest_subtitle: "A librarian for your chests"
	quest.606F40CCE784904B.title: "Bookwyrms"
	quest.60782FF3D72F2EA7.quest_desc: [
		"The Extreme Reactors reinforced controller needs an &eAllthemodium Ingot&r in ICU."
	]
	quest.60782FF3D72F2EA7.quest_subtitle: "Big power, bigger reactor"
	quest.60782FF3D72F2EA7.title: "Reinforced Reactor"
	quest.608929ED7AC1B534.quest_desc: [
		"Each &eSingularity&r takes 1,000 items in the Neutronium Compressor. There are 27 kinds."
		""
		"The &eInfinity Catalyst&r wants one of each (or one Eternal Singularity). &eBedrock&r comes from 10,000 Deepslate in the same compressor."
		""
		"Start compressors early and let automation feed them."
	]
	quest.608929ED7AC1B534.quest_subtitle: "How long is the endgame?"
	quest.608929ED7AC1B534.title: "Singularity Math"
	quest.60ACD6D756111A1C.quest_desc: [
		"&eSimulated Coasters&r lets you build roller coaster track and carts out of girders."
		"&eSimulated Extra&r adds a Centered Wheel Mount (craft it from a normal one)."
		"&eAeronautics Dyeable Components&r lets you dye tires and levitite."
	]
	quest.60ACD6D756111A1C.quest_subtitle: "The fun stuff"
	quest.60ACD6D756111A1C.title: "Coasters and Extras"
	quest.60D47828CBCB4C24.quest_desc: [
		"Put a &eTrack Buffer&r at the end of a line so trains know where to stop."
		""
		"Wrench its front to change the style, click it with dye to recolor."
	]
	quest.60D47828CBCB4C24.quest_subtitle: "End of the line"
	quest.60D47828CBCB4C24.title: "Track Buffers"
	quest.619BBA783FEBDD85.quest_desc: [
		"The &eMeka-Tool&r is built from an Atomic Disassembler, Ultimate circuits, HDPE and &ePolonium Pellets&r."
		""
		"Polonium comes from nuclear waste (see the Generators chapter). Add modules at a &eModification Station&r."
		""
		"It mines like an &eAllthemodium pickaxe&r: Vibranium yes, Unobtainium still needs a Vibranium pickaxe."
	]
	quest.619BBA783FEBDD85.quest_subtitle: "The last tool you'll craft"
	quest.619BBA783FEBDD85.title: "Meka-Tool"
	quest.61A30BD0E36BB8EE.quest_desc: [
		"Prefab turns items into whole buildings. You got a &eHouse&r item the first time you joined."
		""
		"Right-click the ground with a structure item, pick a style, then hit &ePreview!&r to see where it goes or &eBuild!&r to place it. Right-click any block to clear the preview."
	]
	quest.61A30BD0E36BB8EE.quest_subtitle: "Just add ground"
	quest.61A30BD0E36BB8EE.title: "Buildings in a Box"
	quest.61CCB46CB2DE7099.quest_desc: [
		"Four Wyvern Cores, two Awakened Draconium and two &eUnobtainium Ingots&r, fused around a Nether Star."
	]
	quest.61CCB46CB2DE7099.quest_subtitle: "Draconic, fully awake"
	quest.61CCB46CB2DE7099.title: "Awakened Core"
	quest.61E0FD10585FB0EE.quest_desc: [
		"Three iron ingots and a stick make an &eIron Sickle&r (there are wood to netherite versions too). It cuts grass, flowers and leaves with ease."
	]
	quest.61E0FD10585FB0EE.quest_subtitle: "Yard work"
	quest.61E0FD10585FB0EE.title: "Sickle"
	quest.62469146B7BC2DAF.quest_desc: [
		"The &eBiplane&r is a Mechanical Crafter recipe: hulls, sails, an Engine, a propeller and a seat."
		""
		"Fast and fairly reliable, but it needs a long runway to take off."
	]
	quest.62469146B7BC2DAF.quest_subtitle: "Fast and fun"
	quest.62469146B7BC2DAF.title: "Biplane"
	quest.62857046C814398D.quest_desc: [
		"Nine Neutron Piles make a &eNeutronium Nugget&r, and nine nuggets make an ingot."
		""
		"Collectors are slow, so build a few more once you can afford them."
	]
	quest.62857046C814398D.quest_subtitle: "Very, very heavy"
	quest.62857046C814398D.title: "Neutronium Ingot"
	quest.62B2796C6FE8594D.quest_desc: [
		"Mine &eUtherium&r crystals. Utherium weapons deal 1.5x damage to Rotspawn."
	]
	quest.62B2796C6FE8594D.quest_subtitle: "Made for rot"
	quest.62B2796C6FE8594D.title: "Utherium"
	quest.62B5C884645CE63A.quest_desc: [
		"&eDeer&r live in forests and meadows."
		""
		"Feed one an &eApple&r, then a flower. It'll start planting that flower as it wanders."
	]
	quest.62B5C884645CE63A.quest_subtitle: "Deer that garden"
	quest.62B5C884645CE63A.title: "Full Bloom"
	quest.62CB8B7A2147057C.quest_desc: [
		"&eCompacting&r turns 9 ingots into a block (and similar) as they come in."
		"&eVoid&r deletes the items you pick in its filter. Cobblestone, dirt, rotten flesh... bye!"
	]
	quest.62CB8B7A2147057C.quest_subtitle: "Squish it or bin it"
	quest.62CB8B7A2147057C.title: "Compacting and Void"
	quest.6327D95646FCCC67.quest_desc: [
		"Your Coke Oven also collects &eCreosote Oil&r. Put a bucket of it in the middle of 8 planks for 8 &eTreated Wood Planks&r."
		""
		"A Create Spout works too: 125 mB per plank."
	]
	quest.6327D95646FCCC67.quest_subtitle: "Smells like a railway"
	quest.6327D95646FCCC67.title: "Treated Wood"
	quest.632A4E9A0509A186.quest_desc: [
		"The &eMounted Potato Cannon&r takes the same ammo as the handheld one and can be loaded automatically."
		""
		"Spin it to charge, then pulse redstone to fire. Keep the signal on for automatic fire."
	]
	quest.632A4E9A0509A186.quest_subtitle: "Heavier artillery"
	quest.632A4E9A0509A186.title: "Mounted Potato Cannon"
	quest.63B29D294D539E41.quest_desc: [
		"Feed steam into a Turbine Valve from a Boiler or a Fission Reactor and pull power out."
		""
		"If it won't form, check the structure against the in-game guide or JEI/EMI info tab."
	]
	quest.63B29D294D539E41.quest_subtitle: "Turbine online"
	quest.63B29D294D539E41.title: "Spin It Up"
	quest.63B443FC933CC955.quest_desc: [
		"Get up to cloud height (Y 191 to 196) and use an empty glass bottle there."
		""
		"Right-click a &eBottled Cloud&r into the air and it makes a temporary block you can build off. Handy for bridges and roofs."
	]
	quest.63B443FC933CC955.quest_subtitle: "Scaffolding from the sky"
	quest.63B443FC933CC955.title: "Bottled Cloud"
	quest.63EC6FE5AF70238B.quest_desc: [
		"Five gems (or ingots) and two sticks make a &eHammer&r. It mines a 3x3 square of stone at once. Sneak to mine a single block."
		""
		"It skips blocks it couldn't mine on its own, and anything with a block entity, so your chests are safe."
	]
	quest.63EC6FE5AF70238B.quest_subtitle: "Mine a 3x3"
	quest.63EC6FE5AF70238B.title: "Hammer Time"
	quest.6407C11112C419E7.quest_desc: [
		"The &eAirship&r is a Mechanical Crafter recipe: sails, string, hulls, an Engine, a Create propeller and a seat."
		""
		"It's slow but very easy to fly. A great first real aircraft."
	]
	quest.6407C11112C419E7.quest_subtitle: "Slow and steady"
	quest.6407C11112C419E7.title: "Airship"
	quest.64159C163DD13BF9.quest_desc: [
		"The &eCrafting Upgrade&r adds a 3x3 grid to the backpack screen."
		"The &eStonecutter Upgrade&r adds a stonecutter. Great for builders."
	]
	quest.64159C163DD13BF9.quest_subtitle: "A workshop on your back"
	quest.64159C163DD13BF9.title: "Crafting on the Go"
	quest.6427F434865DD83B.quest_desc: [
		"Build the &eInfuser&r from Dreadrock, a Utheric Cluster and Rogdorium. It turns Utheric Clusters into Utherium, among other things."
	]
	quest.6427F434865DD83B.quest_subtitle: "I heart infusing"
	quest.6427F434865DD83B.title: "The Infuser"
	quest.647C7B69C81E82D0.quest_desc: [
		"&eWillow&r trees droop over the Bayou and the Wetland."
		""
		"Their &eWillow Vines&r only drop when you cut them with shears. A vine plus cobblestone makes Mossy Cobblestone."
	]
	quest.647C7B69C81E82D0.quest_subtitle: "Willows and vines"
	quest.647C7B69C81E82D0.title: "Soggy Wood"
	quest.648555CD970AF869.quest_desc: [
		"Stone bricks make &eModern&r, &eRailing&r, &ePillar&r and &eGrass-Topped&r walls. Most also come from a stonecutter."
		""
		"&6Heads up:&r the &eWired&r fences look nice, but they scratch anything that walks into them. Mind your pets."
	]
	quest.648555CD970AF869.quest_subtitle: "Macaw's Walls"
	quest.648555CD970AF869.title: "Walls With Style"
	quest.648675D99D9FD83F.quest_desc: [
		"The Monstrosity drops the &eInfernal Forge&r. Right-click a block to slam everything around it."
	]
	quest.648675D99D9FD83F.quest_subtitle: "It's a pickaxe. Really."
	quest.648675D99D9FD83F.title: "Infernal Forge"
	quest.649B14F59BCBFF74.quest_desc: [
		"Draconium, an Energy Core Stabilizer, Draconium Cores and an enchanting table."
		""
		"Drop tools and armor inside to charge them from your power network."
	]
	quest.649B14F59BCBFF74.quest_subtitle: "A charging station"
	quest.649B14F59BCBFF74.title: "Energy Transfuser"
	quest.64AE69B167CA913C.quest_desc: [
		"Dirt, sand, gravel, cobblestone, clay, a snowball, a grass block, a diamond and a gold ingot."
		""
		"Pick a biome and the &eBiome Pet&r points you toward it. Handy for the Biomes O' Plenty hunt."
	]
	quest.64AE69B167CA913C.quest_subtitle: "Where's the jungle?"
	quest.64AE69B167CA913C.title: "Biome Pet"
	quest.64C11D2A1E5DB6FC.quest_desc: [
		"The shell is made of &eFusion Reactor Frames&r, with a &eController&r on top, &ePorts&r for fuel and power, and a &eLaser Focus Matrix&r to aim the laser at. Check the in-game guide for the shape."
		""
		"The frames need Polonium and the controller needs an &eUltimate Control Circuit&r."
	]
	quest.64C11D2A1E5DB6FC.quest_subtitle: "A star in a box"
	quest.64C11D2A1E5DB6FC.title: "Fusion Reactor"
	quest.64CB83C036C5163C.quest_desc: [
		"Pour a bucket of milk into a cauldron and wait. It turns into a &eBlock of Cheese&r."
		""
		"Break it up into four &eCheese&r. Rats love it."
	]
	quest.64CB83C036C5163C.quest_subtitle: "Milk goes in, cheese comes out"
	quest.64CB83C036C5163C.title: "Say Cheese"
	quest.64D83C7D33030807.quest_desc: [
		"Four Allthemodium nuggets around an ender pearl. Sneak and right-click it with empty hands."
		""
		"In the Overworld it goes to the &eMining dimension&r, in the Nether to &eThe Other&r, and in the End to &eThe Beyond&r."
	]
	quest.64D83C7D33030807.quest_subtitle: "Three doors in one block"
	quest.64D83C7D33030807.title: "Teleport Pad"
	quest.64E8584C4189ABB8.quest_desc: [
		"The &eCopy Paste Gadget&r copies an area and pastes it elsewhere. The &eTemplate Manager&r saves and shares copies."
	]
	quest.64E8584C4189ABB8.quest_subtitle: "Build it once"
	quest.64E8584C4189ABB8.title: "Copy and Paste"
	quest.64F2F8B0D7F591BC.quest_desc: [
		"Archwood trees pop up now and then in most biomes, and whole Archwood Forests are out there too."
		""
		"There are four colors: &eVexing&r (purple), &eBlazing&r (red), &eCascading&r (blue) and &eFlourishing&r (green). Rituals use specific logs, so grab a few of each when you find them."
	]
	quest.64F2F8B0D7F591BC.quest_subtitle: "The magic grows on trees"
	quest.64F2F8B0D7F591BC.title: "Archwood Trees"
	quest.65036DD81C0D3229.quest_desc: [
		"Put one item in the top slot and the &eCondenser&r turns EMC into more of it."
		""
		"Made in a &eSculk Crafting Table&r: obsidian, diamonds and an Alchemical Chest, with an &eAllthemodium Ingot&r on top and a &eDragon Heart&r at the bottom. The heart is used up."
		""
		"Feed it from Collectors and Relays for a hands-free copy machine."
	]
	quest.65036DD81C0D3229.quest_subtitle: "Copy machine"
	quest.65036DD81C0D3229.title: "Energy Condenser"
	quest.65118EC1E09CD85F.quest_desc: [
		"&eLogistical Transporters&r move items. A &eLogistical Sorter&r pulls from an inventory and sends items where filters say."
		""
		"Color-code transporters with the Configurator to keep lines apart."
	]
	quest.65118EC1E09CD85F.quest_subtitle: "Item pipes with brains"
	quest.65118EC1E09CD85F.title: "Logistical Transporters"
	quest.653C7A27019FD69D.quest_desc: [
		"A reactor needs &eReactor Rods&r, a &eFuel Acceptor&r to load fuel and a &eHeat Vent&r to carry heat out."
		""
		"&6Heads up:&r it gives off radiation (wear leather armor or seal it in reactor casing and glass), and it melts down if nothing uses the heat."
	]
	quest.653C7A27019FD69D.quest_subtitle: "Handle with care"
	quest.653C7A27019FD69D.title: "Nuclear Reactor"
	quest.654E1FCE7766162C.quest_desc: [
		"A Source Jar with Manipulation Essence and an &eME Interface&r on the apparatus makes an &eME Source Jar&r."
		""
		"Ars machines next to it see the Source stored in your network."
	]
	quest.654E1FCE7766162C.quest_subtitle: "Your network is a jar now"
	quest.654E1FCE7766162C.title: "ME Source Jar"
	quest.655CD34274BBEEDA.quest_desc: [
		"Glass and archwood slabs make a &eSource Jar&r. Sourcelinks fill it, and machines nearby drink from it."
		""
		"Jars give a comparator signal based on how full they are, which is handy for automation."
	]
	quest.655CD34274BBEEDA.quest_subtitle: "A tank for magic"
	quest.655CD34274BBEEDA.title: "Source Jar"
	quest.658AF7B9CD47AE39.quest_desc: [
		"Chaos Islands sit far out in the End, roughly every 10,000 blocks. Each one holds the &eChaos Guardian&r."
		""
		"Knock out its guardian crystals first. Bring Draconic armor, shields and a lot of food."
	]
	quest.658AF7B9CD47AE39.quest_subtitle: "The real final boss"
	quest.658AF7B9CD47AE39.title: "The Chaos Guardian"
	quest.65C4277169031140.quest_desc: [
		"Many pet recipes use nuggets. One coal makes eight &eCoal Nuggets&r and one diamond makes nine &eDiamond Nuggets&r."
		""
		"Emerald, ender, obsidian and lapis nuggets come from their full-size items too."
	]
	quest.65C4277169031140.quest_subtitle: "Small change"
	quest.65C4277169031140.title: "Pet Nuggets"
	quest.65C9F6ECE189DCB8.quest_desc: [
		"&eInferium Essence&r drops from mobs and from Inferium Ore (between Y -32 and 64). Almost everything in the mod uses it."
		""
		"Keep a stack or two handy."
	]
	quest.65C9F6ECE189DCB8.quest_subtitle: "The green stuff"
	quest.65C9F6ECE189DCB8.title: "Inferium Essence"
	quest.65D1F5181CA8625B.quest_desc: [
		"Four feasts down. Your base is officially the best place to eat."
		""
		"Set out a feast before a big boss fight; everyone eats well."
	]
	quest.65D1F5181CA8625B.quest_subtitle: "The whole spread"
	quest.65D1F5181CA8625B.title: "Master Chef"
	quest.65EB7C3A913C5D9E.quest_desc: [
		"Eight Holystone around a Zanite Gemstone. Fuel it with Ambrosium Shards."
		""
		"The Altar enchants special Aether items and repairs damaged gear."
	]
	quest.65EB7C3A913C5D9E.quest_subtitle: "Aether enchanting"
	quest.65EB7C3A913C5D9E.title: "The Altar"
	quest.65F72106DBF341D3.quest_desc: [
		"Four Inferium Essence around an Infusion Crystal make one &ePrudentium Essence&r."
	]
	quest.65F72106DBF341D3.quest_subtitle: "Tier 2 essence"
	quest.65F72106DBF341D3.title: "Prudentium"
	quest.664071736B781B56.quest_desc: [
		"Make molds on the Workbench with the &eMolds&r blueprint. The plate mold is three steel plates and a pair of wire cutters."
		""
		"The wire mold alone saves a mountain of crafting."
	]
	quest.664071736B781B56.quest_subtitle: "Pick your shape"
	quest.664071736B781B56.title: "Press Molds"
	quest.665F1D37763FB4DD.quest_desc: [
		"With all three down, the acid rain over the Highlands clears."
		""
		"The last stretch of the Twilight Forest is open."
	]
	quest.665F1D37763FB4DD.quest_subtitle: "Hydra, Ur-Ghast, Snow Queen"
	quest.665F1D37763FB4DD.title: "Ultimate Showdown"
	quest.66682B23AFE3DB27.quest_desc: [
		"&eJacaranda&r trees bloom in the Jacaranda Glade and the Lavender Field."
		""
		"The Lavender Field is also where the &eLavender&r grows. One sprig makes purple dye."
	]
	quest.66682B23AFE3DB27.quest_subtitle: "Jacaranda and lavender"
	quest.66682B23AFE3DB27.title: "Pretty in Purple"
	quest.667DF312C8FE9372.quest_desc: [
		"Plant Magic Beans on the glowing &eUberous Soil&r under the clouds and a giant beanstalk shoots up."
	]
	quest.667DF312C8FE9372.quest_subtitle: "Grow up. Way up."
	quest.667DF312C8FE9372.title: "Jack and the Beanstalk"
	quest.668F4EA640C05841.quest_desc: [
		"A crafting table recipe from three worlds: two Enchanted Gravitite, a Victory Medal and a &eSun Altar&r from the Aether, two Forgotten Ingots and two Utherium Crystals from the Undergarden, and an Echo Shard from the Deep Dark."
	]
	quest.668F4EA640C05841.quest_subtitle: "Sky above, garden below"
	quest.668F4EA640C05841.title: "Realms Seal"
	quest.66AF25D71786C2DD.quest_desc: [
		"&6ICU recipe:&r a Niotic Crystal is a diamond plus an &eIgnitium Ingot&r, energized."
		""
		"Niotic cells are built from Blazing cells, so keep climbing in order."
	]
	quest.66AF25D71786C2DD.quest_subtitle: "Ignitium required"
	quest.66AF25D71786C2DD.title: "Niotic Tier"
	quest.66BA13DD31142528.quest_desc: [
		"Change the weather and time of day with a click."
		""
		"&6Heads up:&r it eats a &eDragon Egg&r, and the Extreme Crafting Table needs one too. Check EMI for other ways to get extra eggs before you spend yours."
	]
	quest.66BA13DD31142528.quest_subtitle: "Make it sunny"
	quest.66BA13DD31142528.title: "Celestial Manipulator"
	quest.66FCE54DD62182B9.quest_desc: [
		"Upgrade a Pickarang in a smithing table with a Netherite Upgrade and a netherite ingot."
		""
		"It mines like netherite, lasts longer, and whatever it carries back can't burn up in lava. Made for the Nether."
	]
	quest.66FCE54DD62182B9.quest_subtitle: "Too hot to handle"
	quest.66FCE54DD62182B9.title: "Flamerang"
	quest.6722F598D104C85D.quest_desc: [
		"End Cities hide &eElytra&r. Flying makes the hunt for Unobtainium in the outer islands much easier."
	]
	quest.6722F598D104C85D.quest_subtitle: "The End Highlands are big"
	quest.6722F598D104C85D.title: "Wings"
	quest.675392330A102739.quest_desc: [
		"&eSpeed Upgrades&r (osmium dust) make machines work faster. &eEnergy Upgrades&r (gold dust) cut their power use."
		""
		"A machine takes up to eight of each. Speed raises power use, so pair them with Energy Upgrades."
	]
	quest.675392330A102739.quest_subtitle: "Faster, cheaper, better"
	quest.675392330A102739.title: "Machine Upgrades"
	quest.67733CE4C96CD3AD.quest_desc: [
		"The MEGA 64M storage component needs an &eAllthemodium Ingot&r in the middle."
	]
	quest.67733CE4C96CD3AD.quest_subtitle: "More bytes"
	quest.67733CE4C96CD3AD.title: "MEGA 64M"
	quest.67764C6F56C169F3.quest_desc: [
		"A &eBasic Smelting Factory&r is an Energized Smelter with basic alloys, basic circuits and iron around it."
		""
		"It works on three stacks at once. Other machines have factories too."
	]
	quest.67764C6F56C169F3.quest_subtitle: "Three machines in one"
	quest.67764C6F56C169F3.title: "Your First Factory"
	quest.677BED4BBF094F34.quest_desc: [
		"Find a &ePale Garden&r: pale oak trees, pale moss and hanging moss, all in gray."
		""
		"Pale oak has a full wood set, from planks to boats."
	]
	quest.677BED4BBF094F34.quest_subtitle: "A gray, quiet forest"
	quest.677BED4BBF094F34.title: "The Pale Garden"
	quest.678C64C276D03B59.quest_desc: [
		"Seven Aeternalis Fuel and an &eAllthemodium Nugget&r around a diamond block. Dark Matter is the base of ProjectE's endgame."
	]
	quest.678C64C276D03B59.quest_subtitle: "Now we're cooking"
	quest.678C64C276D03B59.title: "Dark Matter"
	quest.67B8D34729E18CA4.quest_desc: [
		"The &eBoiler&r stacks a Steam Engine on a Fluid Tank on a Blaze Burner."
		""
		"Aircraft run on fuel. Put coal or other burnable items in the fuel slot."
	]
	quest.67B8D34729E18CA4.quest_subtitle: "Fire in the belly"
	quest.67B8D34729E18CA4.title: "Boiler"
	quest.67D6A7530C68755F.quest_desc: [
		"Fuse a Draconium injector with a &eWyvern Core&r, Draconium Cores, diamonds and a Draconium Block."
		""
		"Wyvern-tier recipes need Wyvern injectors for their ingredients. The core's screen tells you if you are short."
	]
	quest.67D6A7530C68755F.quest_subtitle: "Tier two fusion"
	quest.67D6A7530C68755F.title: "Wyvern Injectors"
	quest.67D7757312DAE6DE.quest_desc: [
		"Amendments is Supplementaries' little sibling. It changes vanilla blocks:"
		"Lanterns hang on walls, banners hang from ceilings, flower pots hang too, and carpet fits on stairs and slabs."
		"Dye the water in a cauldron and dip things in it. Items show on hanging signs. Fire charges can be thrown."
	]
	quest.67D7757312DAE6DE.quest_subtitle: "Vanilla, adjusted"
	quest.67D7757312DAE6DE.title: "Amendments"
	quest.687FE2582FF1C175.quest_desc: [
		"&eFunnels&r pull items off belts and out of inventories. &eTunnels&r sit on belts and split items between lanes."
		""
		"Right-click a funnel with a wrench to flip its direction."
	]
	quest.687FE2582FF1C175.quest_subtitle: "In and out"
	quest.687FE2582FF1C175.title: "Funnels and Tunnels"
	quest.68873101C013BD18.quest_desc: [
		"Craft a &eConductor's Cap&r, then check its Ponder (hold &eW&r) to see how it and an Andesite Casing become a &eConductor&r."
		""
		"Conductors can drive trains and press buttons or levers you look at, if you wear a matching cap."
	]
	quest.68873101C013BD18.quest_subtitle: "Tiny train staff"
	quest.68873101C013BD18.title: "Conductors"
	quest.68BF43564380D1F8.quest_desc: [
		"Wool and feathers make 16 &eCushions&r. One wool makes eight &eSheets&r. Dye either one any color."
		""
		"Right-click furniture with them to restyle it: cushions for chairs, couches and bed pillows, sheets for bedsheets and more."
	]
	quest.68BF43564380D1F8.quest_subtitle: "Soft furnishings"
	quest.68BF43564380D1F8.title: "Cushions and Sheets"
	quest.68C9A9317797E1DB.quest_desc: [
		"Iron, planks and a dispenser (or a slingshot and redstone) make a &eCannon&r."
		""
		"Gunpowder is the charge, and almost anything goes in as ammo. Hop in to aim it. Put one on a boat for a &eCannon Boat&r."
	]
	quest.68C9A9317797E1DB.quest_subtitle: "Can shoot anything"
	quest.68C9A9317797E1DB.title: "Cannon"
	quest.68D95C4CBAAC1224.quest_desc: [
		"A &eSolar Heating Plate&r makes heat by day, and &eHeat Pipes&r move it around."
		"A &eStirling Engine&r with heat below it rotates, faster with more heat."
		""
		"&6Heads up:&r blocks that overheat turn into lava. Don't overdo it."
	]
	quest.68D95C4CBAAC1224.quest_subtitle: "Sunshine into spin"
	quest.68D95C4CBAAC1224.title: "Heat and Stirling Engines"
	quest.68DCFF8165C83A6C.quest_desc: [
		"ICU's recipes for the &e64M&r and &e256M&r Energy Storage Components put an &eAllthemodium Ingot&r where the glass would go, just like the MEGA 64M and 256M storage components."
		""
		"That's Tier 3 power storage."
	]
	quest.68DCFF8165C83A6C.quest_subtitle: "Allthemodium inside"
	quest.68DCFF8165C83A6C.title: "64M and 256M"
	quest.692B4216D303F7C8.quest_desc: [
		"The &eCrusher&r grinds ingots into dust and turns plants into &eBio Fuel&r."
		""
		"Later it also turns Clumps into Dirty Dust in the 3x ore line."
	]
	quest.692B4216D303F7C8.quest_subtitle: "Smash it to dust"
	quest.692B4216D303F7C8.title: "Crusher"
	quest.693BC7A0AAC4EBBA.quest_desc: [
		"Allthemodium ores work in Mekanism's ore chain: enriching for dust, purifying for clumps, and on up to crystals."
		""
		"Every step up means more ingots per ore. Don't just smelt the raw ore!"
	]
	quest.693BC7A0AAC4EBBA.quest_subtitle: "Mekanism knows these ores"
	quest.693BC7A0AAC4EBBA.title: "Triple Your Allthemodium"
	quest.6955163FF33AC497.quest_desc: [
		"The Furnator burns fuel for power and the Energy Cell stores it. Cheap, simple, and good enough for now."
	]
	quest.6955163FF33AC497.quest_subtitle: "Burn stuff, get power"
	quest.6955163FF33AC497.title: "Powah! Starter Power"
	quest.69A0F32969E9A980.quest_desc: [
		"Throw a Charged Certus, an iron ingot and a &eSky Stone&r block into lava together for &eSky Steel&r."
	]
	quest.69A0F32969E9A980.quest_subtitle: "Metal from the stars"
	quest.69A0F32969E9A980.title: "Sky Steel"
	quest.69B9D77AE25CEB0F.quest_desc: [
		"Craft a &eCatalyst&r (copper, stone and an ender pearl), build a stone brick frame, and use the Catalyst on it."
	]
	quest.69B9D77AE25CEB0F.quest_subtitle: "Down, down and further down"
	quest.69B9D77AE25CEB0F.title: "The Undergarden"
	quest.69CD3908AEFC31FA.quest_desc: [
		"&eMooblooms&r graze in Flower Forests and Meadows. With &eFlowery Mooblooms&r there's one for every vanilla flower, so keep an eye out for all sixteen."
		""
		"Shear one. &6Heads up:&r Buzzier Bees has its own Moobloom in Sunflower Plains. Only a Friends and Foes one counts here."
	]
	quest.69CD3908AEFC31FA.quest_subtitle: "Flowers on a cow"
	quest.69CD3908AEFC31FA.title: "MooBoom!"
	quest.69E3B7FDF552CF87.quest_desc: [
		"Brass needs a heated Basin, and heat needs a blaze. That means a trip to the Nether."
		""
		"Grab some &eNether Quartz&r while you're there. Create and AE2 both like it."
	]
	quest.69E3B7FDF552CF87.quest_subtitle: "Pack fire resistance if you have it"
	quest.69E3B7FDF552CF87.title: "A Quick Trip to the Nether"
	quest.6A0BCDBF8FA1FFBA.quest_desc: [
		"Made in a &eSculk Crafting Table&r: obsidian, stone, your Philosopher's Stone and a &eSmall Chaos Fragment&r."
		"Chaos Fragments come from the Chaos Crystal, and it only breaks once the &eChaos Guardian&r is dead."
		""
		"Put an item in to &eburn&r it: you learn it and gain its EMC. Later you can spend EMC to make copies of anything you've learned."
	]
	quest.6A0BCDBF8FA1FFBA.quest_subtitle: "Learn it, make it"
	quest.6A0BCDBF8FA1FFBA.title: "Transmutation Table"
	quest.6A0F7AA546EFA284.quest_desc: [
		"&eAncient Tomes&r are rare finds in bastion treasure rooms, woodland mansions, ancient cities and Quark's underground &eMonster Boxes&r."
		""
		"Put one in an anvil with an item or book that has the same enchantment. It can push that enchantment one level past the normal cap."
	]
	quest.6A0F7AA546EFA284.quest_subtitle: "Break the level cap"
	quest.6A0F7AA546EFA284.title: "Ancient Tomes"
	quest.6A670692143677CC.quest_desc: [
		"&ePirate Villages&r are built out on the ocean. Grab a boat and go looking."
	]
	quest.6A670692143677CC.quest_subtitle: "Yo ho ho"
	quest.6A670692143677CC.title: "Pirate Village"
	quest.6A9B31435769EE44.quest_desc: [
		"A normal propeller bearing is a bad fit for a helicopter. The &eGyroscopic Propeller Bearing&r tries to keep its rotor pointing up."
		""
		"Power it with redstone to reset its tilt to zero."
	]
	quest.6A9B31435769EE44.quest_subtitle: "Stay upright"
	quest.6A9B31435769EE44.title: "Helicopters!"
	quest.6AB77D24116E76E5.quest_desc: [
		"Right-click any cable with the &eNetwork Tool&r to see power use, channels and every device on the network."
	]
	quest.6AB77D24116E76E5.quest_subtitle: "What's going on in there?"
	quest.6AB77D24116E76E5.title: "Network Tool"
	quest.6AB7E787E86DAEAB.quest_desc: [
		"Sometimes a rat drops a &eChunky Cheese Token&r."
		""
		"Use it anywhere and it opens a portal to &eRatlantis&r, the lost city of the rats."
	]
	quest.6AB7E787E86DAEAB.quest_subtitle: "A rat dropped something shiny"
	quest.6AB7E787E86DAEAB.title: "Chunky Cheese Token"
	quest.6AC50BD45AA6D92D.quest_desc: [
		"Infuse Reinforced Alloy with refined obsidian in the Metallurgic Infuser."
	]
	quest.6AC50BD45AA6D92D.quest_subtitle: "The Ultimate Circuit needs two"
	quest.6AC50BD45AA6D92D.title: "Atomic Alloy"
	quest.6AC622E35315BD18.quest_desc: [
		"Put certus crystals in a powered &eCharger&r. No power yet? A &eWooden Crank&r on top works by hand."
	]
	quest.6AC622E35315BD18.quest_subtitle: "Crackling with energy"
	quest.6AC622E35315BD18.title: "Charged Certus"
	quest.6ADDAD46F544586E.quest_desc: [
		"&eFlax Seeds&r turn up in pillager outpost and shipwreck chests, and Wandering Traders sell them. Break &eWild Flax&r for more."
		""
		"Plant them like any crop. Flax makes rope, sacks, awnings and more."
	]
	quest.6ADDAD46F544586E.quest_subtitle: "The useful weed"
	quest.6ADDAD46F544586E.title: "Flax"
	quest.6ADE1A26230BBC8A.quest_desc: [
		"Environmental's cherry trees drop &eCherries&r. Two wheat and a cherry make a &eCherry Cookie&r."
	]
	quest.6ADE1A26230BBC8A.quest_subtitle: "Sweet little snack"
	quest.6ADE1A26230BBC8A.title: "Cherries"
	quest.6AFB48DBE55A730B.quest_desc: [
		"Copper, a furnace and a redstone block make a &eCopper Generator&r. It burns anything a furnace can."
		""
		"Cheap and simple. Every generator in this mod upgrades from the one before."
	]
	quest.6AFB48DBE55A730B.quest_subtitle: "Fuel in, power out"
	quest.6AFB48DBE55A730B.title: "Copper Generator"
	quest.6B2A95D879B5A0D0.quest_desc: [
		"Three &eUnderbeans&r in the Cooking Pot with a bowl. Simple and filling."
	]
	quest.6B2A95D879B5A0D0.quest_subtitle: "Beans, beans, beans"
	quest.6B2A95D879B5A0D0.title: "Underbean Hotpot"
	quest.6B2DB3031320371B.quest_desc: [
		"Eight Holystone around an Ambrosium Torch. It burns Ambrosium Torches as fuel."
		""
		"Hatch your egg and raise your own Moa. It takes a while, so be patient."
	]
	quest.6B2DB3031320371B.quest_subtitle: "Keep it warm"
	quest.6B2DB3031320371B.title: "Incubator"
	quest.6B5CCD68B14D3EA1.quest_desc: [
		"&eAmbrosium Shards&r are fuel for the Altar and heal you a little when eaten."
		""
		"Put one on a Skyroot Stick for an Ambrosium Torch."
	]
	quest.6B5CCD68B14D3EA1.quest_subtitle: "The Aether's coal"
	quest.6B5CCD68B14D3EA1.title: "Ambrosium"
	quest.6B6AA141D95F4849.quest_desc: [
		"The Sculk table makes &eReinforced Deepslate&r from obsidian, deepslate, dripstone and a sculk catalyst."
		""
		"The Extreme table needs four. The rest of its list: a beacon, lodestones, a heart of the sea, a recovery compass, the Dragon Egg and two &eUnobtainium Ingots&r."
	]
	quest.6B6AA141D95F4849.quest_subtitle: "Craftable, for once"
	quest.6B6AA141D95F4849.title: "Reinforced Deepslate"
	quest.6B84C3F741751719.quest_desc: [
		"Cut Copper Sheets into &eCopper Wire&r with a saw. Put &eElectrical Connectors&r on machines and join them with wire."
		""
		"Connectors have a Pull mode (wrench them) for pulling power out of other mods' blocks."
	]
	quest.6B84C3F741751719.quest_subtitle: "Getting power around"
	quest.6B84C3F741751719.title: "Wiring"
	quest.6B9A0083A86069E9.quest_desc: [
		"See and edit the patterns in every provider on the network without walking to them."
	]
	quest.6B9A0083A86069E9.quest_subtitle: "Every pattern, one screen"
	quest.6B9A0083A86069E9.title: "Pattern Access Terminal"
	quest.6BB2B5CDEF475C36.quest_desc: [
		"Smelt it. This is the last metal on the ladder."
	]
	quest.6BB2B5CDEF475C36.quest_subtitle: "Obtained!"
	quest.6BB2B5CDEF475C36.title: "Unobtainium Ingot"
	quest.6BDDC611EDF396D4.quest_desc: [
		"&eFE Storage Cells&r keep energy in your ME system. A &eFlux Accessor&r lets machines draw from it or push into it."
	]
	quest.6BDDC611EDF396D4.quest_subtitle: "Store power on the network"
	quest.6BDDC611EDF396D4.title: "Applied Flux"
	quest.6BE06D4B362B8737.quest_desc: [
		"The little mounds in the forest are hollow! Inside are Redcaps, spawners and chests with Ore Magnets, Transformation Powder and more."
		""
		"Defeat a Redcap inside a small hollow hill."
	]
	quest.6BE06D4B362B8737.quest_subtitle: "Treasure under the grass"
	quest.6BE06D4B362B8737.title: "Hollow Hills"
	quest.6BF7CA92CEF2D4F5.quest_desc: [
		"Friends and Foes adds a beehive for almost every wood: planks on the top and bottom rows, three honeycomb in the middle."
		""
		"Collect all eleven, oak included."
	]
	quest.6BF7CA92CEF2D4F5.quest_subtitle: "Every beehive"
	quest.6BF7CA92CEF2D4F5.title: "Be Keeper"
	quest.6C1EE4B457F65A88.quest_desc: [
		"Build the &eExcavator&r and its bucket wheel over a good deposit. It digs ore out of the vein forever-ish, no mining needed."
		""
		"It's power hungry, so bring HV."
	]
	quest.6C1EE4B457F65A88.quest_subtitle: "A giant bucket wheel"
	quest.6C1EE4B457F65A88.title: "Excavator"
	quest.6C200C7451EE5424.quest_desc: [
		"Craft an &eEntro Seed&r from sand, ender dust, redstone, glowstone and sky stone dust, then grow it into Entro Crystals."
		""
		"EMI shows how the seed grows."
	]
	quest.6C200C7451EE5424.quest_subtitle: "ExtendedAE's crystal"
	quest.6C200C7451EE5424.title: "Entro Crystals"
	quest.6C3735CE6F3C6AAA.quest_desc: [
		"The &eExplorer's Compass&r points to structures, including boss arenas and dungeons. The &eNature's Compass&r finds biomes."
		""
		"Fly there: Immersive Aircraft and Create airships cover big distances fast."
	]
	quest.6C3735CE6F3C6AAA.quest_subtitle: "Stop wandering"
	quest.6C3735CE6F3C6AAA.title: "Finding Bosses and Biomes"
	quest.6C801B36126455FA.quest_desc: [
		"Needs an &eUltimate Control Circuit&r. Two Entangloporters on the same frequency share items, fluids, gases, power and heat."
		""
		"It works across dimensions too."
	]
	quest.6C801B36126455FA.quest_subtitle: "Wireless everything"
	quest.6C801B36126455FA.title: "Quantum Entangloporter"
	quest.6C8EDC8A2F00D83F.quest_desc: [
		"The &eThermo Generator&r makes power when it sits on a hot block or fluid like lava."
		""
		"It also needs a coolant like water to run."
	]
	quest.6C8EDC8A2F00D83F.quest_subtitle: "Hot below, cold above"
	quest.6C8EDC8A2F00D83F.title: "Thermo Generator"
	quest.6CF1EF22EDC87564.quest_desc: [
		"Allthemodium ore hides in the Overworld's &eDeep Dark&r. Sneak, and mind the Warden."
	]
	quest.6CF1EF22EDC87564.quest_subtitle: "Shh. Don't wake it."
	quest.6CF1EF22EDC87564.title: "Deep Dark Digging"
	quest.6D070A6EFF2E1925.quest_desc: [
		"A Source Jar on the apparatus with four blaze rods, two obsidian, wool and an ender pearl (9000 Source) makes an &eEnder Source Jar&r."
		""
		"Jars dyed the same color share one Source store, anywhere. Use a diamond on the lid to make it yours alone."
	]
	quest.6D070A6EFF2E1925.quest_subtitle: "One pool, many places"
	quest.6D070A6EFF2E1925.title: "Ender Source Jar"
	quest.6D097F64F6C05A4C.quest_desc: [
		"Nine of a crop pack into a crate or sack block: apples, potatoes, carrots, beetroot, cocoa, berries, nether wart and more."
		""
		"A &eCharcoal Block&r smelts 80 items and burns forever like netherrack. A &eGolden Apple Crate&r even counts as a beacon base."
	]
	quest.6D097F64F6C05A4C.quest_subtitle: "Tidy storage blocks"
	quest.6D097F64F6C05A4C.title: "Crates and Sacks"
	quest.6D41968CE40F97D5.quest_desc: [
		"Two gems, a block of the same material and two sticks make a &eTree Axe&r."
		""
		"Chop a log and the rest of the tree comes down with it."
	]
	quest.6D41968CE40F97D5.quest_subtitle: "Timber!"
	quest.6D41968CE40F97D5.title: "Tree Axe"
	quest.6D4AC32710B647BE.quest_desc: [
		"Spent fuel comes out as &eCyanite&r. Set a second Access Port to Outlet (or flip yours) to collect it."
		""
		"Turbines are made with Cyanite, so don't throw it away."
	]
	quest.6D4AC32710B647BE.quest_subtitle: "Waste with a use"
	quest.6D4AC32710B647BE.title: "Cyanite"
	quest.6D4AC6E5FF1F993A.quest_desc: [
		"The &ePickup Upgrade&r pulls items you walk over straight into the backpack."
		"The &eFilter Upgrade&r decides what may go in or out, which is handy with hoppers."
	]
	quest.6D4AC6E5FF1F993A.quest_subtitle: "Only the good stuff"
	quest.6D4AC6E5FF1F993A.title: "Pickup and Filter"
	quest.6D6E5EBA7A8DD7B0.quest_desc: [
		"A spinning &ePropeller&r makes thrust. Start with an &eAndesite Propeller&r (a Create propeller, a slab and a shaft). It turns into a Wooden Propeller and back in a crafting grid."
		""
		"Reverse the rotation, or use a wrench, to reverse the thrust."
	]
	quest.6D6E5EBA7A8DD7B0.quest_subtitle: "Push some air"
	quest.6D6E5EBA7A8DD7B0.title: "Propellers"
	quest.6D79C3ECCCF33B91.quest_desc: [
		"A &eMechanical Drill&r on a moving contraption mines whatever is in front of it."
		""
		"Add a chest to the contraption and it collects the drops. A simple piston tunnel bore is a great first build."
	]
	quest.6D79C3ECCCF33B91.quest_subtitle: "Tunnel bore"
	quest.6D79C3ECCCF33B91.title: "Mechanical Drill"
	quest.6D84B892F83D251B.quest_desc: [
		"All made in the Dissolution Chamber with Latex:"
		"&eRange&r: redstone, glass panes and four of a material. Cobblestone is the smallest, emeralds the biggest."
		"&eSpeed&r: gears and sugar. &eEfficiency&r: gears and blaze rods."
		"Right-click a machine's addon slots to fit them."
	]
	quest.6D84B892F83D251B.quest_subtitle: "Bigger, faster, cheaper"
	quest.6D84B892F83D251B.title: "Machine Addons"
	quest.6D8E463815D8A7CD.quest_desc: [
		"&eSoulstone&r spawns in big veins all over the Nether. &eSoulium Ore&r hides inside those veins."
		""
		"Smooth Soulstone smelts into Soul Dust, and Soulium Ore smelts into Soulium Dust."
	]
	quest.6D8E463815D8A7CD.quest_subtitle: "A Nether rock"
	quest.6D8E463815D8A7CD.title: "Soulstone"
	quest.6DB557B09C22E77C.quest_desc: [
		"The &eInfinity Range Booster&r goes in a Wireless Access Point and removes the range limit."
		""
		"Three Wireless Boosters, two Eyes of Ender, three Netherite Ingots and a &eNether Star&r."
	]
	quest.6DB557B09C22E77C.quest_subtitle: "Wireless, everywhere"
	quest.6DB557B09C22E77C.title: "Infinite Range"
	quest.6DDB95B19F499511.quest_desc: [
		"Put a Supremium Block on the Awakening Altar, &eCognizant Dust&r on the pedestals, and 10 of each elemental essence in the vessels."
		""
		"Cognizant Dust drops from the Wither or Ender Dragon if the killing blow comes from an essence weapon carrying the Mystical Enlightenment enchantment."
		""
		"Get the enchantment from the &eEnchanter&r: three Supremium Essence and 64 Experience Essence. It goes on essence swords, axes and scythes, and higher levels drop more dust."
	]
	quest.6DDB95B19F499511.quest_subtitle: "Wake it up"
	quest.6DDB95B19F499511.title: "Awakened Supremium"
	quest.6DFF9D0A5882659F.quest_desc: [
		"Smelt it. Vibranium opens most of Tier 4."
	]
	quest.6DFF9D0A5882659F.quest_subtitle: "The key to Tier 4"
	quest.6DFF9D0A5882659F.title: "Vibranium Ingot"
	quest.6E76AB47FF7449E1.quest_desc: [
		"A boat and five planks of the same wood make a &eLarge Boat&r."
		""
		"It seats four players. Big passengers take up more room, so a horse or two means fewer seats."
	]
	quest.6E76AB47FF7449E1.quest_subtitle: "Room for the whole team"
	quest.6E76AB47FF7449E1.title: "Large Boat"
	quest.6E7F1D48FEAE5DC1.quest_desc: [
		"The Ancient Remnant drops a block of &eAncient Metal&r. Break it into ingots."
	]
	quest.6E7F1D48FEAE5DC1.quest_subtitle: "The Remnant's hoard"
	quest.6E7F1D48FEAE5DC1.title: "Ancient Metal"
	quest.6E82B1C8750BE2F5.quest_desc: [
		"A &eRotational Complex&r sits on top of the rotor. Around it goes a layer of &ePressure Dispersers&r, and &eElectromagnetic Coils&r sit above."
		""
		"A &eSaturating Condenser&r above the dispersers turns spent steam back into water."
	]
	quest.6E82B1C8750BE2F5.quest_subtitle: "Where spin becomes power"
	quest.6E82B1C8750BE2F5.title: "Rotational Complex"
	quest.6EC2FFF793EBD91D.quest_desc: [
		"The Ender Battery's cousin. Blaze rods, wool, obsidian, an ender pearl and an &eOsmium Ingot&r make an &eEnder Flask&r."
		""
		"It holds Mekanism chemicals. Give two flasks the same three colors, like an Ender Chest, and they share one tank."
	]
	quest.6EC2FFF793EBD91D.quest_subtitle: "Shared tanks for Mekanism"
	quest.6EC2FFF793EBD91D.title: "Ender Flask"
	quest.6EC6F8EEC99E792D.quest_desc: [
		"Blow a fan through &ePowder Snow&r for bulk freezing: packed ice into blue ice, even blaze rods into breeze rods."
		""
		"Blow it through a &eDragon Head&r or &eDragon's Breath&r for bulk ending: cobblestone into end stone."
	]
	quest.6EC6F8EEC99E792D.quest_subtitle: "New fan tricks"
	quest.6EC6F8EEC99E792D.title: "Freezing and Ending"
	quest.6EF57E2EB7807B20.quest_desc: [
		"Swap the lava for wheat and you get an &eAgronomic Sourcelink&r. It makes Source whenever crops or trees grow within 15 blocks."
		""
		"Mageblooms, Sourceberries and Archwood saplings give extra. Bonemeal doesn't count."
	]
	quest.6EF57E2EB7807B20.quest_subtitle: "Your farm, now magical"
	quest.6EF57E2EB7807B20.title: "Agronomic Sourcelink"
	quest.6EFA9D6D09DDE384.quest_desc: [
		"Two steel and a redstone make &eUniversal Cables&r. They carry power between any machines, Mekanism or not."
		""
		"Right-click a cable side with the Configurator to stop it pulling from the wrong block."
	]
	quest.6EFA9D6D09DDE384.quest_subtitle: "Power goes where you point it"
	quest.6EFA9D6D09DDE384.title: "Universal Cables"
	quest.6F0849FD87B9F897.quest_desc: [
		"Upgrade the Diamond Backpack in a &eSmithing Table&r with a Netherite Upgrade template and a Netherite Ingot."
		""
		"Like other netherite gear it survives lava, so you won't lose it if you fall in."
	]
	quest.6F0849FD87B9F897.quest_subtitle: "Fireproof, and huge"
	quest.6F0849FD87B9F897.title: "Netherite Backpack"
	quest.6F5EBD60C133C102.quest_desc: [
		"In ICU, every cactus that grows to full height sprouts a &ePrickly Pear&r. Deserts have them wild, too."
		""
		"Cook them in a furnace, smoker or campfire for a snack."
	]
	quest.6F5EBD60C133C102.quest_subtitle: "Cactus fruit"
	quest.6F5EBD60C133C102.title: "Prickly Pears"
	quest.6F7ADD6639413F7C.quest_desc: [
		"The &eArc Furnace&r smelts ores into extra ingots and makes alloys without a kiln."
		""
		"It burns through &eGraphite Electrodes&r. Check EMI for how to make them."
	]
	quest.6F7ADD6639413F7C.quest_subtitle: "Lightning in a box"
	quest.6F7ADD6639413F7C.title: "Arc Furnace"
	quest.6F9ED26E3CAA49E9.quest_desc: [
		"End crystals, portal frames, purpur, dragon's breath and an ender chest around a Double Compressed table."
		""
		"This is where the Extreme Crafting Table itself gets made."
	]
	quest.6F9ED26E3CAA49E9.quest_subtitle: "The 7x7 table"
	quest.6F9ED26E3CAA49E9.title: "End Crafting Table"
	quest.6FB16A9A13C1231D.quest_desc: [
		"Barrel, drum, hammer and a grip. Load it with cartridges from the Bullets blueprint."
		""
		"It stores upgrades too; check EMI for the parts."
	]
	quest.6FB16A9A13C1231D.quest_subtitle: "An engineer's sidearm"
	quest.6FB16A9A13C1231D.title: "Revolver"
	quest.6FFB025B731D29D7.quest_desc: [
		"An iron ingot and two redstone dust make a &eRedstone Ingot&r. An iron ingot and an ender pearl make an &eEnder Ingot&r."
	]
	quest.6FFB025B731D29D7.quest_subtitle: "Two more metals"
	quest.6FFB025B731D29D7.title: "Redstone and Ender Ingots"
	quest.6FFE2531DFBF7206.quest_desc: [
		"The Enrichment Chamber turns one ore into two dusts. Your ore pile just doubled."
	]
	quest.6FFE2531DFBF7206.quest_subtitle: "Two for one"
	quest.6FFE2531DFBF7206.title: "Ore Doubling"
	quest.70010C79BAD9B038.quest_desc: [
		"Cook rice in the pot for &eCooked Rice&r. A lot of meals and rolls use it."
	]
	quest.70010C79BAD9B038.quest_subtitle: "The easiest pot recipe"
	quest.70010C79BAD9B038.title: "Cooked Rice"
	quest.70225BCBB0F34E88.quest_desc: [
		"A potato plus a gem, shapeless. You can eat them even when you're full."
		""
		"&eEmerald&r: Night Vision, Regeneration and Saturation. &eRuby&r: Resistance, Strength and Fire Resistance. &eAmethyst&r: Luck."
	]
	quest.70225BCBB0F34E88.quest_subtitle: "A gem a day"
	quest.70225BCBB0F34E88.title: "Fancy Potatoes"
	quest.703490A6DCBC53F9.quest_desc: [
		"The full set. Nothing short of Draconic or Infinity gear beats it."
		""
		"That's the whole Allthemodium ladder. Nice climbing!"
	]
	quest.703490A6DCBC53F9.quest_subtitle: "Obtained, and worn"
	quest.703490A6DCBC53F9.title: "Unobtainium Armor"
	quest.706EBEC3127EAAF3.quest_desc: [
		"A compass with cobwebs and cracked stone bricks. Pick a structure and it points to the nearest one."
		""
		"It works on modded structures too, including every Cataclysm lair."
	]
	quest.706EBEC3127EAAF3.quest_subtitle: "Find any structure"
	quest.706EBEC3127EAAF3.title: "Explorer's Compass"
	quest.707FBFCDF207ECBA.quest_desc: [
		"Unobtainium ore is in the &eEnd Highlands&r, out on the outer End islands."
	]
	quest.707FBFCDF207ECBA.quest_subtitle: "Bring slow falling"
	quest.707FBFCDF207ECBA.title: "Out in the End"
	quest.708ECCE1005306DE.quest_desc: [
		"The &eMillstone&r grinds things like wheat into flour and gravel into flint."
		""
		"It's slow, but it's cheap. Crushing Wheels come later for the heavy stuff."
	]
	quest.708ECCE1005306DE.quest_subtitle: "Slow but simple grinding"
	quest.708ECCE1005306DE.title: "Millstone"
	quest.70BD2C8EA31FD30B.quest_desc: [
		"A &eMechanical Arm&r moves items between inventories, depots, belts and machines in its reach."
		""
		"Before placing it, right-click the spots it should take from and give to."
	]
	quest.70BD2C8EA31FD30B.quest_subtitle: "Pick up, put down"
	quest.70BD2C8EA31FD30B.title: "Mechanical Arm"
	quest.70DD4EE4EB14F896.quest_desc: [
		"Eight glass panes around an item frame make two &eGlass Item Frames&r. Only the item shows."
		""
		"You can right-click through one to open the chest behind it, so they make great labels."
		""
		"ICU also has &eFast Item Frames&r, which makes plain item frames much lighter on performance."
		""
		"Glass and dyed item frames stay put on Sable ships and airships too."
	]
	quest.70DD4EE4EB14F896.quest_subtitle: "Just the item, please"
	quest.70DD4EE4EB14F896.title: "Glass Item Frames"
	quest.70E7CA1B231F7B2A.quest_desc: [
		"Logs, planks and sticks make &ePicket&r, &eStockade&r and &eHorse&r fences, plus tall gates like the &eHighley Gate&r. Every wood has them."
		""
		"Leaves make &eHedges&r, and iron bars in a stonecutter give you fancy metal fences."
	]
	quest.70E7CA1B231F7B2A.quest_subtitle: "Macaw's Fences"
	quest.70E7CA1B231F7B2A.title: "Fancy Fences"
	quest.7106A1C0713505C1.quest_desc: [
		"Put &eProgrammed Extended Patterns&r into a &eSmart AutoCraft Table&r on your ME network, and AE2 can autocraft those Extended Crafting recipes."
		""
		"There are Smart Ender and Flux Crafters too."
	]
	quest.7106A1C0713505C1.quest_subtitle: "Extended Crafting on autopilot"
	quest.7106A1C0713505C1.title: "Smart AutoCraft Tables"
	quest.710B9A7DB19B7FDA.quest_desc: [
		"An &eInventory Access Port&r lets funnels and pipes reach the inventory behind it."
		"Two of them make an &eInventory Bridge&r that works with two inventories at once, with filters for which side gets what."
	]
	quest.710B9A7DB19B7FDA.quest_subtitle: "Reach around corners"
	quest.710B9A7DB19B7FDA.title: "Inventory Bridge"
	quest.7110483F7D2C6D4B.quest_desc: [
		"A grab bag of small blocks and tricks: one-stop villager trading, item vacuums, better tridents and neater redstone."
		""
		"Nothing here is required. Pick what helps your base."
	]
	quest.7110483F7D2C6D4B.quest_subtitle: "Little things that save a lot of time"
	quest.7110483F7D2C6D4B.title: "Handy Gadgets"
	quest.712395CA23582186.quest_desc: [
		"The Aether's best tools. Right-click a stone block with the pickaxe and it floats up into the air!"
	]
	quest.712395CA23582186.quest_subtitle: "Make it float"
	quest.712395CA23582186.title: "Gravitite Pickaxe"
	quest.712882A028B3D465.quest_desc: [
		"Supremium Essence, Prosperity Shards and a Supremium Gemstone make a &eMaster Infusion Crystal&r."
		""
		"Infinite durability. No more crafting spare crystals."
	]
	quest.712882A028B3D465.quest_subtitle: "Never breaks"
	quest.712882A028B3D465.title: "Master Infusion Crystal"
	quest.714B05ADC93680BE.quest_desc: [
		"Two Straw make &eRope&r. Climb it like a ladder, or let tomato vines climb it."
		""
		"Four Rope make a &eSafety Net&r that cancels fall damage."
	]
	quest.714B05ADC93680BE.quest_subtitle: "For climbing and tomatoes"
	quest.714B05ADC93680BE.title: "Rope"
	quest.714C6138F7608A9F.quest_desc: [
		"Every Cataclysm structure has its own &eEye&r. Craft one, throw it, and it flies toward the nearest match."
		""
		"Desert (Cursed Pyramid), Curse (Frosted Prison), Abyss (Sunken City), Storm (Acropolis), Flame (Burning Arena), Monstrous (Soul Forge), Mech (Ancient Factory) and Void (Ruined Citadel). Check EMI for each recipe."
	]
	quest.714C6138F7608A9F.quest_subtitle: "Like Eyes of Ender"
	quest.714C6138F7608A9F.title: "Eyes That Point the Way"
	quest.717AC8F340C27920.quest_desc: [
		"A multiblock battery: &eInduction Casing&r walls, a &eInduction Port&r (Elite circuit) and Cells plus Providers inside."
		""
		"Cells and Providers need &eLithium Dust&r, so you'll want the Crystallizer first."
	]
	quest.717AC8F340C27920.quest_subtitle: "Serious power storage"
	quest.717AC8F340C27920.title: "Induction Matrix"
	quest.71979BC28F57E977.quest_desc: [
		"Build a Blast Furnace (Blast Bricks, formed with the hammer) and cook iron with coke."
		""
		"Your steel shows up as Mekanism steel. Almost Unified merges all the steels into one, so don't worry about it."
	]
	quest.71979BC28F57E977.quest_subtitle: "Iron, but tougher"
	quest.71979BC28F57E977.title: "Steel"
	quest.7198E5B530472584.quest_desc: [
		"The &eBiometric Identifier&r decides who can pass through your fields and use your blocks. Hand out ID cards to friends."
	]
	quest.7198E5B530472584.quest_subtitle: "Who gets in"
	quest.7198E5B530472584.title: "Biometric Identifier"
	quest.71B95A4AEA0F25E2.quest_desc: [
		"The &eWarden&r drops a Warden Heart when a player kills it."
		""
		"It can't be caught in a jar, cloned or spawned from a mob soul, so you'll have to fight one in the Deep Dark."
	]
	quest.71B95A4AEA0F25E2.quest_subtitle: "Proof you beat it"
	quest.71B95A4AEA0F25E2.title: "Warden Heart"
	quest.722A6793CB6F2FFA.quest_desc: [
		"&eRegalium&r is rare and shiny, and the Stoneborn love it."
	]
	quest.722A6793CB6F2FFA.quest_subtitle: "Stoneborn money"
	quest.722A6793CB6F2FFA.title: "Regalium"
	quest.7232E113A07FA4E4.quest_desc: [
		"An orb works faster with more rods around it, and better rods move more power."
		""
		"Upgrade your starter rods to &eBasic&r and &eHardened&r ones. You'll want the speed for the crystal recipes."
	]
	quest.7232E113A07FA4E4.quest_subtitle: "More rods, better rods"
	quest.7232E113A07FA4E4.title: "Faster Energizing"
	quest.723787B8FA9ED8B8.quest_desc: [
		"Copycat &eSliding Doors&r, &eCogwheels&r and &eShafts&r take on any texture too."
		""
		"Hide your machinery inside the walls and nobody will know."
	]
	quest.723787B8FA9ED8B8.quest_subtitle: "Blend right in"
	quest.723787B8FA9ED8B8.title: "Copycat Doors and Cogs"
	quest.723879372AF10684.quest_desc: [
		"Infuse Osmium with redstone. You'll need lots of these."
	]
	quest.723879372AF10684.quest_subtitle: "Tiny brains for machines"
	quest.723879372AF10684.title: "Basic Control Circuit"
	quest.72459DDFA2F9D521.quest_desc: [
		"Deer drop Venison. In the pot: raw venison, kelp, two bamboo and a vegetable."
	]
	quest.72459DDFA2F9D521.quest_subtitle: "Deer, the tasty way"
	quest.72459DDFA2F9D521.title: "Venison with Bamboo"
	quest.725321FB9F620326.quest_desc: [
		"The &eTank Upgrade&r (glass around an Upgrade Base) holds fluid."
		"The &eBattery Upgrade&r (gold and redstone blocks) stores energy inside the backpack."
	]
	quest.725321FB9F620326.quest_subtitle: "Fluids and power, portable"
	quest.725321FB9F620326.title: "Tank and Battery"
	quest.726A2B7B50317745.quest_desc: [
		"Create Aeronautics turns any group of blocks into a real physics object: a &eSimulated Contraption&r."
		""
		"Craft a &ePhysics Assembler&r (andesite casing, alloy and a lever). Glue a group of blocks to it, then hold right-click on it and pull the lever. Now it can move and fall."
	]
	quest.726A2B7B50317745.quest_subtitle: "Physics be upon ye"
	quest.726A2B7B50317745.title: "Physics Assembler"
	quest.72805D76B4F0C7CF.quest_desc: [
		"Elite factories and installers need an &eElite Control Circuit&r, and that means Allthemodium."
	]
	quest.72805D76B4F0C7CF.quest_subtitle: "Seven slots"
	quest.72805D76B4F0C7CF.title: "Elite Factory"
	quest.728BC23B4301D6B6.quest_desc: [
		"Stonecut zinc into &eCopycat&r blocks, then right-click one with any block to copy its look."
		""
		"&eCopycats+&r adds slopes, slices, layers, panes and more. Perfect for detailing machines."
	]
	quest.728BC23B4301D6B6.quest_subtitle: "Any shape, any texture"
	quest.728BC23B4301D6B6.title: "Copycats"
	quest.729D28CC50A14CEF.quest_desc: [
		"Diamond Generator plus obsidian. From here you can build the &eMagmatic&r (lava), &eEnder&r and &eEnchantment&r generators."
	]
	quest.729D28CC50A14CEF.quest_subtitle: "The branching point"
	quest.729D28CC50A14CEF.title: "Obsidian Generator"
	quest.72AB7E6FA5052E38.quest_desc: [
		"&eHypertubes&r shoot you through glass tubes at high speed. Right-click a tube with another tube to link them."
		""
		"An &eEntrance&r needs at least 16 RPM. Spin it faster to travel faster."
	]
	quest.72AB7E6FA5052E38.quest_subtitle: "Zoom"
	quest.72AB7E6FA5052E38.title: "Hypertubes"
	quest.72F875F3B5A3FE4F.quest_desc: [
		"&eAcceleration Cards&r speed up buses. &eCapacity Cards&r add filter slots. Fuzzy, Redstone and Crafting cards do what they say."
	]
	quest.72F875F3B5A3FE4F.quest_subtitle: "Slot them in"
	quest.72F875F3B5A3FE4F.title: "Upgrade Cards"
	quest.73021FCFBB9C6FD3.quest_desc: [
		"Iron, a bowl and bone meal make a &eWatering Can&r. Right-click water to fill it, then water crops to speed them up."
		""
		"Essence cans reach further; shift-right-click the air to toggle auto-watering."
	]
	quest.73021FCFBB9C6FD3.quest_subtitle: "Manual labor, magic results"
	quest.73021FCFBB9C6FD3.title: "Watering Can"
	quest.7313B28E6410AD38.quest_desc: [
		"Bind a &eConductor Whistle&r to a conductor riding a train, then use it on a track to summon that train."
		""
		"Deployers can blow it at stations to call trains automatically."
	]
	quest.7313B28E6410AD38.quest_subtitle: "Call a cab"
	quest.7313B28E6410AD38.title: "Conductor Whistle"
	quest.73161607C3DB3C14.quest_desc: [
		"The &eMagmator&r burns hot fluids like lava. Pipe it a steady supply and it runs forever."
	]
	quest.73161607C3DB3C14.quest_subtitle: "Lava into power"
	quest.73161607C3DB3C14.title: "Magmator"
	quest.7334DC92FB7CDB55.quest_desc: [
		"Redstone, a gold nugget, a diamond and a gold ingot. The &eMagma Cube Pet&r gives fire resistance and lets you walk on lava."
		""
		"A great friend for Nether trips. It likes quartz."
	]
	quest.7334DC92FB7CDB55.quest_subtitle: "Lava? What lava?"
	quest.7334DC92FB7CDB55.title: "Magma Cube Pet"
	quest.733D3EF00B6ACEA7.quest_desc: [
		"Cut a raw Duck on the board for fillets. In the pot: duck, pasta, a carrot and a vegetable."
		""
		"Ducks hang out near rivers and swamps."
	]
	quest.733D3EF00B6ACEA7.quest_subtitle: "Environmental's ducks"
	quest.733D3EF00B6ACEA7.title: "Duck Noodles"
	quest.735047CB39E45128.quest_desc: [
		"Four Draconium Cores, two Draconium Ingots, a &eNether Star&r and two &eWitherite Ingots&r."
		""
		"That's the big one. Tier 5 is next!"
	]
	quest.735047CB39E45128.quest_subtitle: "Tier 4 complete!"
	quest.735047CB39E45128.title: "Wyvern Core"
	quest.73A906E91E469E93.quest_desc: [
		"The &ePlant Sower&r plants seeds and saplings in front of it. The &ePlant Gatherer&r harvests them, trees included."
		""
		"Put them side by side and never touch a hoe again."
	]
	quest.73A906E91E469E93.quest_subtitle: "Plant it, pick it"
	quest.73A906E91E469E93.title: "Automatic Farming"
	quest.73F0EFC2E2D0047F.quest_desc: [
		"Climb the beanstalk and defeat a &eGiant Miner&r. Its Giant's Pickaxe mines huge chunks at once."
	]
	quest.73F0EFC2E2D0047F.quest_subtitle: "Giants in the sky"
	quest.73F0EFC2E2D0047F.title: "Cloud Nine"
	quest.74320E545D885378.quest_desc: [
		"Crafts normal crafting-table recipes from packages. It needs power; on an ME network it takes power from the network and sends what it makes into it."
	]
	quest.74320E545D885378.quest_subtitle: "A crafting table that never sleeps"
	quest.74320E545D885378.title: "Package Crafter"
	quest.7449F8921FD94A50.quest_desc: [
		"Fill a &eJetpack&r with Hydrogen, either in the Separator's item slot or from a Chemical Tank."
		""
		"Switch modes with its keybind: normal, hover or off."
	]
	quest.7449F8921FD94A50.quest_subtitle: "Up, up and away"
	quest.7449F8921FD94A50.title: "Jetpack"
	quest.74970CD82E15869D.quest_desc: [
		"The &eOre Laser Base&r needs an Advanced Frame. Powered by Laser Drills, it pulls ores out of thin air."
		""
		"Add a coloured &eLaser Lens&r to favour certain ores. Hover a lens in EMI to see what it boosts."
	]
	quest.74970CD82E15869D.quest_subtitle: "Ore from nowhere"
	quest.74970CD82E15869D.title: "Ore Laser Base"
	quest.74A4B7A34414323E.quest_desc: [
		"Drop a Charged Certus, a redstone dust and a Nether Quartz into water together for &eFluix Crystals&r."
		""
		"A Create Mixer with water does it in bulk."
	]
	quest.74A4B7A34414323E.quest_subtitle: "The good purple"
	quest.74A4B7A34414323E.title: "Fluix"
	quest.74A547F9F5854201.quest_desc: [
		"With a &eVoid Upgrade&r a full drawer deletes extra items instead of backing up your line."
		""
		"Perfect for cobblestone generators and mob farms."
	]
	quest.74A547F9F5854201.quest_subtitle: "Never full again"
	quest.74A547F9F5854201.title: "Void Upgrade"
	quest.74C1D7D6AACEE6EA.quest_desc: [
		"The Star's centre piece. It's an &eExtreme Crafting Table&r recipe too: a ring of end stone full of ender pearls, with four Neutronium Ingots and a Nether Star in the middle."
	]
	quest.74C1D7D6AACEE6EA.quest_subtitle: "The heart of the Star"
	quest.74C1D7D6AACEE6EA.title: "Endest Pearl"
	quest.74C548C220E463C7.quest_desc: [
		"Take down the Ur-Ghast and grab its &eFiery Tears&r."
		""
		"Counts past kills too, as long as you did the Knight Phantoms first."
	]
	quest.74C548C220E463C7.quest_subtitle: "The Ur-Ghast"
	quest.74C548C220E463C7.title: "Tears of Fire"
	quest.74CBC469BF3ECCC3.quest_desc: [
		"Open a chest with the backpack on and these upgrades kick in:"
		"&eDeposit&r dumps matching items into the chest. &eRestock&r takes matching items out of it."
	]
	quest.74CBC469BF3ECCC3.quest_subtitle: "Chest chores, automated"
	quest.74CBC469BF3ECCC3.title: "Restock and Deposit"
	quest.74CEDB01AF4B058F.quest_desc: [
		"Nine Sulfur make a block of &ePotent Sulfur&r. Sulfur and Cinnabar also come as polished blocks, bricks, slabs, stairs and walls."
	]
	quest.74CEDB01AF4B058F.quest_subtitle: "Concentrated stink"
	quest.74CEDB01AF4B058F.title: "Potent Sulfur"
	quest.74EFB59ACD559A75.quest_desc: [
		"Draconium dust, blaze powder and an Eye of Ender make a &eDislocator&r, a short-range teleporter."
		""
		"Tip: the fancier dislocators burn Ender Pearls as fuel, so keep a stack handy."
	]
	quest.74EFB59ACD559A75.quest_subtitle: "Point, click, somewhere else"
	quest.74EFB59ACD559A75.title: "Dislocator"
	quest.75090E01BC280819.quest_desc: [
		"The &eNucleosynthesizer&r uses antimatter to turn items into rarer ones: coal into diamonds, eggs into dragon eggs and more."
		""
		"Check its EMI tab for the full list."
	]
	quest.75090E01BC280819.quest_subtitle: "Antimatter alchemy"
	quest.75090E01BC280819.title: "Antiprotonic Nucleosynthesizer"
	quest.750C7CD1CA2A0D24.quest_desc: [
		"Craft a &eBelt Connector&r from dried kelp, then click two shafts to join them with a belt."
		""
		"Belts carry items and connect machines. Keep them in a straight line, flat or sloped."
	]
	quest.750C7CD1CA2A0D24.quest_subtitle: "The factory conveyor"
	quest.750C7CD1CA2A0D24.title: "Belts"
	quest.751C1288A925D73F.quest_desc: [
		"Catch a mob with the &eLasso&r, then put the lasso in a Mob Farm. It makes that mob's drops over time."
		""
		"Better farms work faster and take more kinds of mobs. Hover a farm to see what it can hold."
	]
	quest.751C1288A925D73F.quest_subtitle: "A farm in one block"
	quest.751C1288A925D73F.title: "Tiny Mob Farm"
	quest.7540A85438BDAE9F.quest_desc: [
		"The &eMining Drill&r runs on fuel instead of durability. Swap in a Steel Drill Head for tougher rock."
		""
		"Upgrades go in on the Workbench."
	]
	quest.7540A85438BDAE9F.quest_subtitle: "Hold on tight"
	quest.7540A85438BDAE9F.title: "Mining Drill"
	quest.7553AF25A1503FB8.quest_desc: [
		"&eYUNG's Better End Island&r rebuilds the Ender Dragon's island around a central tower."
		""
		"&6Heads up:&r only the &efirst&r dragon kill leaves a Dragon Egg; a resummoned dragon doesn't. ICU's Extreme Crafting Table (Tier 5) needs that egg, so don't lose it."
	]
	quest.7553AF25A1503FB8.quest_subtitle: "The dragon's new home"
	quest.7553AF25A1503FB8.title: "Better End Island"
	quest.75BF7F0A3942AC01.quest_desc: [
		"Three blocks of &eWood&r (the all-bark version of a log) in a column make eight &ePosts&r."
		""
		"They can face any direction, and chains and lanterns hook right onto them."
	]
	quest.75BF7F0A3942AC01.quest_subtitle: "Thin beams"
	quest.75BF7F0A3942AC01.title: "Posts"
	quest.75F7ADEAC42EF88E.quest_desc: [
		"Upgrade a Diamond Generator with a Netherite Ingot at a Smithing Table. A big jump in output."
	]
	quest.75F7ADEAC42EF88E.quest_subtitle: "Smithing time"
	quest.75F7ADEAC42EF88E.title: "Netherite Generator"
	quest.75FEA4AF631002CC.quest_desc: [
		"Press Polonium or Plutonium with fluorite dust and water in a &ePressurized Reaction Chamber&r to make pellets."
		""
		"Polonium Pellets go into the MekaSuit, Meka-Tool and fusion frames. Both go into the SPS."
	]
	quest.75FEA4AF631002CC.quest_subtitle: "The endgame ingredients"
	quest.75FEA4AF631002CC.title: "Polonium and Plutonium"
	quest.76203445E60BFA69.quest_desc: [
		"A &eGearbox&r sends rotation out every side except the one it's coming in on. Great for tight builds."
		""
		"It needs Andesite Casing, so make a few of those first."
	]
	quest.76203445E60BFA69.quest_subtitle: "Around the corner"
	quest.76203445E60BFA69.title: "Gearboxes"
	quest.7624C3AECAFBC4DE.quest_desc: [
		"&eIceologers&r are illagers of the cold. They roam snowy biomes and live in &eIceologer Cabins&r."
		""
		"Each one drops a &eTotem of Freezing&r."
	]
	quest.7624C3AECAFBC4DE.quest_subtitle: "The Iceologer"
	quest.7624C3AECAFBC4DE.title: "Cold Shoulder"
	quest.763A7730116F2236.quest_desc: [
		"Low dust is cobblestone and charcoal, medium is iron and redstone, high is diamond and coal."
		""
		"They go into a lot of ProjectE recipes."
	]
	quest.763A7730116F2236.quest_subtitle: "Repair and crafting dust"
	quest.763A7730116F2236.title: "Covalence Dust"
	quest.763AEC6C873116C5.quest_desc: [
		"A Flux Accessor and a Basic Card."
		""
		"Put the &eInduction Card&r in an AE device's upgrade slots and it can take in or send out energy."
	]
	quest.763AEC6C873116C5.quest_subtitle: "Power in, power out"
	quest.763AEC6C873116C5.title: "Induction Card"
	quest.763F2296D4BEDA01.quest_desc: [
		"A &ePackaging Component&r is an eye of ender, planks and gold."
		""
		"With AE2 in the pack, every PackagedAuto machine is made with the &eME Packaging Component&r: add AE2's Annihilation and Formation Cores and Quartz Glass."
	]
	quest.763F2296D4BEDA01.quest_subtitle: "PackagedAuto starts here"
	quest.763F2296D4BEDA01.title: "Packaging Components"
	quest.7663EA8EBDA7492E.quest_desc: [
		"Somewhere above the Overworld floats an &eAirship Village&r. They're rare and far apart, so it's a real hunt."
		""
		"The Explorer's Compass helps a lot here."
	]
	quest.7663EA8EBDA7492E.quest_subtitle: "Look up"
	quest.7663EA8EBDA7492E.title: "Airship Village"
	quest.766CF009331BB3AB.quest_desc: [
		"Five fragments make the &eWildfire Crown&r, a helmet. Wear it and let the Nether know who's in charge."
	]
	quest.766CF009331BB3AB.quest_subtitle: "Put it on"
	quest.766CF009331BB3AB.title: "New King of the Nether"
	quest.76C749B1E68EE83A.quest_desc: [
		"&eCreate: New Age&r turns rotation into electricity and back."
		""
		"Start with &eMagnetite Blocks&r. They show up as small clumps underground in the Overworld. Mine them as they are."
	]
	quest.76C749B1E68EE83A.quest_subtitle: "Create: New Age"
	quest.76C749B1E68EE83A.title: "Magnetite"
	quest.76DAA23378C740DC.quest_desc: [
		"The top Iron Furnace tiers are made of Allthemodium, Vibranium and Unobtainium."
		""
		"&6Heads up:&r those metals open ICU's tiers. Spend them on progress first and on furnaces later."
	]
	quest.76DAA23378C740DC.quest_subtitle: "Only when you're rich"
	quest.76DAA23378C740DC.title: "Allthemodium Furnace"
	quest.772770BF88A05D71.quest_desc: [
		"Ancient Anima, a Blazing Eye, gold and obsidian."
		""
		"Placed down, it gives you creative-style flight in a 7x7 column above it. Perfect for building tall."
	]
	quest.772770BF88A05D71.quest_subtitle: "Fly at home"
	quest.772770BF88A05D71.title: "Table of Elevation"
	quest.773B68D85015A1EA.quest_desc: [
		"An &eEnergiser&r needs both electricity and rotation. It charges items on a depot or belt below it."
		""
		"Energise iron into &eOvercharged Iron&r. You'll need it for most New Age parts."
	]
	quest.773B68D85015A1EA.quest_subtitle: "Zap items on a depot"
	quest.773B68D85015A1EA.title: "Energiser"
	quest.773E0683B0AB591E.quest_desc: [
		"Hammer an ingot in a crafting grid for a &eplate&r. Four plates make &eSheetmetal&r, and steel ingots with steel rods make &eSteel Scaffolding&r."
		""
		"Almost every big IE machine is built from these."
	]
	quest.773E0683B0AB591E.quest_subtitle: "Plates, sheets and scaffolds"
	quest.773E0683B0AB591E.title: "Structural Steel"
	quest.774BB5C65709D5FA.quest_desc: [
		"A Nether Star, two redstone blocks, a Block of Blazing Crystal and an &eUnobtainium Nugget&r. Makes 16!"
	]
	quest.774BB5C65709D5FA.quest_subtitle: "Maximum powah"
	quest.774BB5C65709D5FA.title: "Nitro Crystal"
	quest.7761E03F21CB633F.quest_desc: [
		"Place a Teleport Pad in the Overworld, then sneak and right-click it with empty hands."
	]
	quest.7761E03F21CB633F.quest_subtitle: "All ore, no fuss"
	quest.7761E03F21CB633F.title: "The Mining Dimension"
	quest.777088F8F513AA4A.quest_desc: [
		"Each table has an Auto version: the table plus Crystaltine and Redstone Components and Black Iron."
		""
		"Lay out a recipe, then &eShift + Left Click&r one of the three recipe slots at the top right to save it, and click it to select it. Put a chest on top and fill it: items go in using power, and a hopper can pull the results out."
	]
	quest.777088F8F513AA4A.quest_subtitle: "Crafting on its own"
	quest.777088F8F513AA4A.title: "Auto Crafting Tables"
	quest.777BD49FB89A8E7C.quest_desc: [
		"Upgrade a chestplate (and the other pieces) on the apparatus with four Magebloom Fiber:"
		"gold makes the &eSorcerer's&r set, iron the &eArcanist's&r, diamond the &eBattlemage's&r."
		""
		"Sorcerer has the weakest armor but the best thread slots; Battlemage is the reverse."
	]
	quest.777BD49FB89A8E7C.quest_subtitle: "Mana regen you can wear"
	quest.777BD49FB89A8E7C.title: "Magical Robes"
	quest.77AAAC8776DF30C1.quest_desc: [
		"Hi there! ICU is a big pack with a clear spine: &6five tiers&r, and each new tier is opened by a rare metal or a boss drop."
		""
		"This book walks you up that ladder one step at a time. Tick the checkmark to get going."
	]
	quest.77AAAC8776DF30C1.quest_subtitle: "Grab a snack. This is going to be a long one."
	quest.77AAAC8776DF30C1.title: "Welcome to InfinityCraft Ultra!"
	quest.77B23B0A56C00690.quest_desc: [
		"Break grass to find &eIndustrial Hemp Seeds&r. The plant grows two blocks tall; cut the top and the bottom keeps growing."
		""
		"Hemp Fiber becomes &eTough Fabric&r for windmill sails, insulated wire and survey tools."
	]
	quest.77B23B0A56C00690.quest_subtitle: "The useful kind of weed"
	quest.77B23B0A56C00690.title: "Industrial Hemp"
	quest.77E340B920B7B2A9.quest_desc: [
		"Eight sand around an ender pearl make eight &eGravisand&r."
		""
		"It only falls when it gets a redstone signal, and pulls the Gravisand next to it along. If it can't fall, it floats upward instead."
	]
	quest.77E340B920B7B2A9.quest_subtitle: "Falls on command"
	quest.77E340B920B7B2A9.title: "Gravisand"
	quest.780B8703A24F59F3.quest_desc: [
		"A &eBacktank&r stores pressurized air for tools like the Extendo Grip and the diving gear."
		""
		"Craft it with an iron chestplate for an armored version."
	]
	quest.780B8703A24F59F3.quest_subtitle: "Air and armor"
	quest.780B8703A24F59F3.title: "Armored Backtank"
	quest.782B2B29BA6DF6F8.quest_desc: [
		"Black Moas can jump the most times in the air. Hatch one and go for a ride."
	]
	quest.782B2B29BA6DF6F8.quest_subtitle: "The best flier"
	quest.782B2B29BA6DF6F8.title: "Black Moa"
	quest.782BD815454A3637.quest_desc: [
		"&eGlares&r float around Lush Caves. They're grumpy little things, but they love &eGlow Berries&r."
		""
		"Feed one glow berries to tame it."
	]
	quest.782BD815454A3637.quest_subtitle: "A glare of your own"
	quest.782BD815454A3637.title: "Grumpy and Cute"
	quest.78334B9BA5B8E67F.quest_desc: [
		"Iron nuggets, raw beef (or chicken), a diamond and a gold ingot."
		""
		"The &eWolf Pet&r summons a wolf to fight beside you, can warn you about nearby monsters, and scares skeletons away."
	]
	quest.78334B9BA5B8E67F.quest_subtitle: "A loyal guard"
	quest.78334B9BA5B8E67F.title: "Wolf Pet"
	quest.7846B7D1953DB7B6.quest_desc: [
		"Beat the Ender Dragon. Already did it? You're good, this counts your old win too."
	]
	quest.7846B7D1953DB7B6.quest_subtitle: "The classic final boss"
	quest.7846B7D1953DB7B6.title: "Dragon Slayer"
	quest.784E49B29C371A39.quest_desc: [
		"Hold Train Casing and press &eAlt&r (the Open Bogey Menu key) to pick a bogey style before placing it."
		""
		"Single, double or triple axle, and many more, each with its own look."
	]
	quest.784E49B29C371A39.quest_subtitle: "Pick your wheels"
	quest.784E49B29C371A39.title: "Bogey Styles"
	quest.7869B7A84909DD1B.quest_desc: [
		"Pylons frame a space, the &eSpatial IO Port&r copies it into a Spatial Cell, and you can paste it back later."
		""
		"Great for moving builds. Try a small 2x2x2 cell first."
	]
	quest.7869B7A84909DD1B.quest_subtitle: "Pack a room in a cell"
	quest.7869B7A84909DD1B.title: "Spatial Storage"
	quest.787B646E7CE5ED0C.quest_desc: [
		"Four iron ingots around the Copper Backpack make an &eIron Backpack&r."
		""
		"You can also skip copper and put eight iron around a plain backpack."
	]
	quest.787B646E7CE5ED0C.quest_subtitle: "Heavy metal storage"
	quest.787B646E7CE5ED0C.title: "Iron Backpack"
	quest.7892B54C7836910F.quest_desc: [
		"Use &eTier Up&r in the core's screen to see the next shell. Every tier holds far more power."
		"&eAssemble Core&r places the blocks for you if they're in your inventory."
		""
		"&6Heads up:&r the top tiers want advanced stabilizers. The screen tells you when you need them."
	]
	quest.7892B54C7836910F.quest_subtitle: "Tier Up!"
	quest.7892B54C7836910F.title: "Growing the Core"
	quest.78E426D38A1AE2D3.quest_desc: [
		"The Philosopher's Stone upgrades coal: four coal make &eAlchemical Coal&r, then &eMobius Fuel&r, then &eAeternalis Fuel&r."
		""
		"Aeternalis is the key to Dark Matter."
	]
	quest.78E426D38A1AE2D3.quest_subtitle: "Coal, but better"
	quest.78E426D38A1AE2D3.title: "Alchemical Fuels"
	quest.78FA89DB2F399B26.quest_desc: [
		"&eBasic&r to &eUltimate&r Package Crafters craft Extended Crafting table recipes. &eEnder&r and &eFlux&r Package Crafters do Ender and Flux crafting."
		""
		"Each is made from the matching Auto table or Auto crafter."
	]
	quest.78FA89DB2F399B26.quest_subtitle: "PackagedExCrafting"
	quest.78FA89DB2F399B26.title: "Extended Crafting Package Crafters"
	quest.7928558F5ECC4BFB.quest_desc: [
		"The &eKinetic Battery&r charges from rotation. Power it with redstone and it gives that stress back."
		""
		"Chain batteries for longer runs, or put them side by side for more capacity."
	]
	quest.7928558F5ECC4BFB.quest_subtitle: "Rotation in a box"
	quest.7928558F5ECC4BFB.title: "Kinetic Battery"
	quest.792D3F2715C04DC9.quest_desc: [
		"A flint (or iron) head on a stick makes a &eKnife&r. It's light and quick."
		""
		"Kill animals with it for guaranteed extra drops, and cut grasses with it for &eStraw&r."
	]
	quest.792D3F2715C04DC9.quest_subtitle: "Every kitchen needs one"
	quest.792D3F2715C04DC9.title: "A Cook's Knife"
	quest.7930AAEDCAF3836A.quest_desc: [
		"A &eDeployer&r uses whatever it's holding: places blocks, clicks buttons, applies items, even attacks."
		""
		"It's also a key station for sequenced assembly."
	]
	quest.7930AAEDCAF3836A.quest_subtitle: "A robot hand"
	quest.7930AAEDCAF3836A.title: "Deployer"
	quest.795582494295DC34.quest_desc: [
		"Froststeel ore hides in the Shiverstone of the frozen biomes. Froststeel weapons slow down whatever they hit."
	]
	quest.795582494295DC34.quest_subtitle: "Chilling"
	quest.795582494295DC34.title: "Froststeel"
	quest.7992DCDBC30FC374.quest_desc: [
		"&eDreadful Dirt&r spawns more hostile mobs. Keep it dark (light level under 5) and out of the sun."
	]
	quest.7992DCDBC30FC374.quest_subtitle: "Spawn more monsters"
	quest.7992DCDBC30FC374.title: "Dreadful Dirt"
	quest.79EA08FC2F716CF8.quest_desc: [
		"Pigs and hoglins killed with a knife can drop a whole &eHam&r. Smoke it in a smoker for &eSmoked Ham&r."
		""
		"Or cut it on the board for slices."
	]
	quest.79EA08FC2F716CF8.quest_subtitle: "Knife versus pig"
	quest.79EA08FC2F716CF8.title: "Ham"
	quest.7A0C2989CE0B23B9.quest_desc: [
		"&eThorium Ore&r is rare and deep in the Overworld."
		""
		"Crushing Thorium sometimes gives &eRadioactive Thorium&r, the start of nuclear fuel."
	]
	quest.7A0C2989CE0B23B9.quest_subtitle: "Hot rocks"
	quest.7A0C2989CE0B23B9.title: "Thorium"
	quest.7A1956D7BA8C3C2E.quest_desc: [
		"A &eWater Wheel&r turns when water flows past it. The &eLarge Water Wheel&r gives more stress capacity from one axle."
		""
		"Tip: flowing water on one side only. Water on both sides pushing the same way works too."
	]
	quest.7A1956D7BA8C3C2E.quest_subtitle: "Free power, forever"
	quest.7A1956D7BA8C3C2E.title: "Big Water Wheels"
	quest.7A1D3449882B8676.quest_desc: [
		"&eEntro Infused Ingots&r: entro dust, a gold ingot and lapis thrown into water."
		"The frame is entro ingots, copper, iron and quartz glass."
	]
	quest.7A1D3449882B8676.quest_subtitle: "The ExtendedAE base"
	quest.7A1D3449882B8676.title: "Extended Machine Frame"
	quest.7A321242E1D8395D.quest_desc: [
		"Redstone, glowstone and a diamond. The stone transmutes blocks in the world and works as a portable crafting helper."
		""
		"&6Heads up:&r the book expects every tier item (rare metals, boss drops, circuits, crystals) to be earned the normal way, not transmuted. That's where the fun is."
		"The book opens ProjectE here, once you've climbed a tier the honest way."
	]
	quest.7A321242E1D8395D.quest_subtitle: "Where it all begins"
	quest.7A321242E1D8395D.title: "Philosopher's Stone"
	quest.7A3D20C1ED0123F5.quest_desc: [
		"Draconium ore turns up in the Overworld, the Nether and the End."
	]
	quest.7A3D20C1ED0123F5.quest_subtitle: "Draconic Evolution begins"
	quest.7A3D20C1ED0123F5.title: "Draconium"
	quest.7A3DE9C50C859B5A.quest_desc: [
		"The &eCrusher&r turns one ore into two dusts, sometimes with a bonus."
		""
		"Feed it from the top, or drop items on it."
	]
	quest.7A3DE9C50C859B5A.quest_subtitle: "Two dusts per ore"
	quest.7A3DE9C50C859B5A.title: "Crusher"
	quest.7A58AA0A0E183C17.quest_desc: [
		"Iron, redstone and stone make a &eMachine Frame&r. Add two furnaces, iron and Prosperity Ingots for the MA &eFurnace&r."
		""
		"MA machines burn solid fuel and take Machine Upgrades."
	]
	quest.7A58AA0A0E183C17.quest_subtitle: "MA machines start here"
	quest.7A58AA0A0E183C17.title: "Machine Frame"
	quest.7A601F8CAA978EA5.quest_desc: [
		"Knightmetal tools hit armored targets harder, and the shield and Block and Chain are fun too."
		""
		"&6Heads up:&r every &eKnightmetal Ingot&r you spend on gear is one less for Industrial Foregoing's Advanced Machine Frame."
	]
	quest.7A601F8CAA978EA5.quest_subtitle: "Heavy and mean"
	quest.7A601F8CAA978EA5.title: "Knightmetal Gear"
	quest.7A73CF98BE2BCCF2.quest_desc: [
		"Three Imperium Essence, an Infusion Crystal and a &eVibranium Nugget&r."
	]
	quest.7A73CF98BE2BCCF2.quest_subtitle: "Top-shelf farming"
	quest.7A73CF98BE2BCCF2.title: "Supremium Essence"
	quest.7A7C5E70ECDC6A8B.quest_desc: [
		"Smoked Ham, a honey bottle, four sweet berries, two Cooked Rice and a bowl."
	]
	quest.7A7C5E70ECDC6A8B.quest_subtitle: "Sticky and sweet"
	quest.7A7C5E70ECDC6A8B.title: "Honey Glazed Ham"
	quest.7A878102863DBCAC.quest_desc: [
		"An emerald on top of three planks, with two sticks for legs."
		""
		"Right-click the &eTrading Post&r to trade with every villager within 24 blocks (16 up or down) from one screen. The XP from trading pops out on top of the post."
	]
	quest.7A878102863DBCAC.quest_subtitle: "Every villager, one screen"
	quest.7A878102863DBCAC.title: "Trading Post"
	quest.7A9D00A153A773B3.quest_desc: [
		"The &eAltitude Sensor&r gives a redstone signal based on height. The &eVelocity Sensor&r gives one based on speed."
		""
		"Wire them to your burners and propellers for an autopilot that holds your height."
	]
	quest.7A9D00A153A773B3.quest_subtitle: "Know where you are"
	quest.7A9D00A153A773B3.title: "Flight Sensors"
	quest.7AB2BFEF6D907634.quest_desc: [
		"A simple fuel generator built around a &eDraconium Core&r."
		""
		"It won't win any prizes, but it's handy for charging a first fusion setup."
	]
	quest.7AB2BFEF6D907634.quest_subtitle: "Burn now, fuse later"
	quest.7AB2BFEF6D907634.title: "Draconic Generator"
	quest.7AC31B9F5C29D651.quest_desc: [
		"Diamond blocks, a diamond shovel, gold gears, the biggest Range Addon and 2000 mB of Pink Slime."
		""
		"It runs on power and gets bigger as you charge it. The &eInfinity Charger&r needs an Advanced Frame."
	]
	quest.7AC31B9F5C29D651.quest_subtitle: "Dig a hole. A big one."
	quest.7AC31B9F5C29D651.title: "Infinity Drill"
	quest.7B01B354A9021AB9.quest_desc: [
		"Archwood slabs, archwood logs and gold nuggets make a &eScribe's Table&r."
		""
		"Right-click it with your spell book to open the glyph list. Pick a glyph, toss its items onto the table, and it gets scribed for a bit of XP. It also pulls items from nearby chests."
	]
	quest.7B01B354A9021AB9.quest_subtitle: "Where glyphs are born"
	quest.7B01B354A9021AB9.title: "Scribe's Table"
	quest.7B3C05FBD7E302FE.quest_desc: [
		"Flux Blocks and glass panes. Storage smooths out spikes, and bigger tiers craft from smaller ones."
	]
	quest.7B3C05FBD7E302FE.quest_subtitle: "A buffer for the network"
	quest.7B3C05FBD7E302FE.title: "Flux Storage"
	quest.7B6AA22D43198E16.quest_desc: [
		"The &eWind Generator&r makes more power the higher it stands. Put it up on a hill or a tower."
	]
	quest.7B6AA22D43198E16.quest_subtitle: "Build it tall"
	quest.7B6AA22D43198E16.title: "Wind Generator"
	quest.7B6F1F3B3B698B2E.quest_desc: [
		"Planks, an iron nugget, a diamond and a gold ingot. Right-click the &eChest Pet&r to open the storage inside it."
	]
	quest.7B6F1F3B3B698B2E.quest_subtitle: "Extra pockets"
	quest.7B6F1F3B3B698B2E.title: "Chest Pet"
	quest.7B8094A62BF78DD7.quest_desc: [
		"Sand, a Create &eNozzle&r and a &eFluid Tank&r make a &eSand Filter&r."
		""
		"Pump water in the top and take it out the bottom. Each pass cleans it by one level, so chain a few filters for really dirty water."
	]
	quest.7B8094A62BF78DD7.quest_subtitle: "Clean water by the bucketful"
	quest.7B8094A62BF78DD7.title: "Sand Filter"
	quest.7BB086004F1CDD56.quest_desc: [
		"It turns mobs in range into &eMeat&r and &ePink Slime&r fluid. Pipe both into tanks."
	]
	quest.7BB086004F1CDD56.quest_subtitle: "Grim, but useful"
	quest.7BB086004F1CDD56.title: "Mob Slaughter Factory"
	quest.7BBD904892177BAE.quest_desc: [
		"Deep in the Sunken City. Bring water breathing."
	]
	quest.7BBD904892177BAE.quest_subtitle: "L_Ender's Cataclysm"
	quest.7BBD904892177BAE.title: "The Leviathan"
	quest.7BE0D5F08A918FA1.quest_desc: [
		"Ultimate factories and installers need an &eUltimate Control Circuit&r, and that means Vibranium."
		""
		"Nine jobs at once, and upgrades still stack on top."
	]
	quest.7BE0D5F08A918FA1.quest_subtitle: "Nine slots"
	quest.7BE0D5F08A918FA1.title: "Ultimate Factory"
	quest.7BF8D9102868EE3F.quest_desc: [
		"Climb the Aurora Palace on the Glacier and defeat the &eSnow Queen&r."
		""
		"She drops a Tri-Bow or Seeker Bow. Both are great."
	]
	quest.7BF8D9102868EE3F.quest_subtitle: "The Snow Queen"
	quest.7BF8D9102868EE3F.title: "Clear Skies"
	quest.7C0DF263BA250EEF.quest_desc: [
		"Gold and glass make an &eHourglass&r. Fill it with sand, or any dust or powder."
		""
		"Each dust flows at its own speed. Redstone takes much longer than sand, and glows a little while it runs."
	]
	quest.7C0DF263BA250EEF.quest_subtitle: "Watch it trickle"
	quest.7C0DF263BA250EEF.title: "Hourglass"
	quest.7C26DE0525830DFA.quest_desc: [
		"The Void Blossom drops &eVoid Thorns&r and a healing Crystal Fruit."
	]
	quest.7C26DE0525830DFA.quest_subtitle: "Void Blossom loot"
	quest.7C26DE0525830DFA.title: "Void Thorn"
	quest.7C56DB85D3899E03.quest_desc: [
		"The &eScribe's Table&r turns glyphs into spells for your book. More in the &eArs Nouveau&r chapter."
	]
	quest.7C56DB85D3899E03.quest_subtitle: "Write your own spells"
	quest.7C56DB85D3899E03.title: "Scribe's Table"
	quest.7C5FCA9915830EB2.quest_desc: [
		"The &eSqueezer&r presses seeds into &ePlant Oil&r. Hemp seeds give the most."
	]
	quest.7C5FCA9915830EB2.quest_subtitle: "Seed oil"
	quest.7C5FCA9915830EB2.title: "Industrial Squeezer"
	quest.7C76F1F2D443E443.quest_desc: [
		"The &eEnder Tank&r does the same trick for fluids. Pump lava or water in at one end and pull it out at the other."
	]
	quest.7C76F1F2D443E443.quest_subtitle: "Fluids at a distance"
	quest.7C76F1F2D443E443.title: "Ender Tank"
	quest.7C78578B58801984.quest_desc: [
		"Wrap a Chest Pet in eight &eDiamond Nuggets&r and it becomes a &eSated Chest Pet&r. It never needs feeding."
	]
	quest.7C78578B58801984.quest_subtitle: "The sated chest"
	quest.7C78578B58801984.title: "Never Hungry"
	quest.7C823D19765196A0.quest_desc: [
		"The Silver Dungeon treasure has Valkyrie tools and armor. Valkyrie tools have extra reach."
	]
	quest.7C823D19765196A0.quest_subtitle: "Valkyrie loot"
	quest.7C823D19765196A0.title: "Earning Your Wings"
	quest.7C86EB4E7F961E99.quest_desc: [
		"&6ICU recipe:&r a Spirited Crystal is an emerald plus a &eVibranium Nugget&r, energized."
	]
	quest.7C86EB4E7F961E99.quest_subtitle: "Vibranium required"
	quest.7C86EB4E7F961E99.title: "Spirited Tier"
	quest.7C921CC3DAD1A79E.quest_desc: [
		"Stack three slabs in a column to get three &eVertical Slabs&r. Most slabs in the game have one."
		""
		"Perfect for thin walls, window frames and little furniture builds."
	]
	quest.7C921CC3DAD1A79E.quest_subtitle: "Slabs, but sideways"
	quest.7C921CC3DAD1A79E.title: "Vertical Slabs"
	quest.7CAF89F33C6A23E9.quest_desc: [
		"&eMaple&r trees fill the Maple Woods and the Seasonal Forest. Their leaves come in red, orange and yellow, and each color drops its own sapling."
		""
		"Grab one of each and plant yourself an autumn."
	]
	quest.7CAF89F33C6A23E9.quest_subtitle: "Red, orange and yellow"
	quest.7CAF89F33C6A23E9.title: "Autumn Colors"
	quest.7CB87324950BBA67.quest_desc: [
		"Make your first &eSingularity&r. EMI lists every material the Compressor accepts and how much it needs."
		""
		"Tip: pipe your ore processing straight into the Compressor and forget about it."
		""
		"&6Platinum&r is the tricky one. The reliable source is Industrial Foregoing's &eLaser Drill&r with a &eLight Blue Laser Lens&r (anywhere but the End)."
	]
	quest.7CB87324950BBA67.quest_subtitle: "A whole mine in one item"
	quest.7CB87324950BBA67.title: "Singularities"
	quest.7CD6FA498B8A3BE7.quest_desc: [
		"&eRat Upgrade: Ore Doubling&r turns a rat into a tiny ore processor."
		""
		"It's a nice early boost. Mekanism's ore processing gets more out of each ore later on."
	]
	quest.7CD6FA498B8A3BE7.quest_subtitle: "Rat-powered ore processing"
	quest.7CD6FA498B8A3BE7.title: "Ore Doubling"
	quest.7D03361C7130F106.quest_desc: [
		"Build a &eCopper Golem&r: a copper block, a carved pumpkin on top, and a lightning rod on top of that."
		""
		"It wanders around pressing &eCopper Buttons&r (two copper ingots stacked) and slowly turns green like any copper."
	]
	quest.7D03361C7130F106.quest_subtitle: "A tiny copper friend"
	quest.7D03361C7130F106.title: "Off You Go"
	quest.7D1776C584E8885F.quest_desc: [
		"A Diamond Hammer, a Netherite Upgrade template and a Netherite Ingot at the Smithing Table."
		""
		"It harvests like a Netherite pickaxe, so it can clear &eAllthemodium&r ore in a 3x3. Vibranium still needs an Allthemodium pickaxe."
	]
	quest.7D1776C584E8885F.quest_subtitle: "Big metal, big holes"
	quest.7D1776C584E8885F.title: "Netherite Hammer"
	quest.7D7286F2F780B9C3.quest_desc: [
		"Put an axe, a shovel and a pickaxe of the same material over two sticks."
		""
		"The &ePaxel&r mines anything those three can, and it still strips logs, scrapes copper and makes dirt paths."
	]
	quest.7D7286F2F780B9C3.quest_subtitle: "Three tools in one slot"
	quest.7D7286F2F780B9C3.title: "Paxel"
	quest.7DBF8671B347207F.quest_desc: [
		"Almost every backpack upgrade starts as an &eUpgrade Base&r: iron, leather and string."
		""
		"Put upgrades in the slots on the side of the backpack screen. Bigger backpacks have more slots."
	]
	quest.7DBF8671B347207F.quest_subtitle: "Where every upgrade starts"
	quest.7DBF8671B347207F.title: "Upgrade Base"
	quest.7DFBF239B0A73B74.quest_desc: [
		"Amethyst shards make diamond-grade tools that last 840 uses. Amethyst tools also take enchantments better than gold ones do."
		""
		"Amethyst armor matches diamond's protection and adds some knockback resistance."
	]
	quest.7DFBF239B0A73B74.quest_subtitle: "Pretty and practical"
	quest.7DFBF239B0A73B74.title: "Amethyst Gear"
	quest.7E11FCBC16CF1610.quest_desc: [
		"Three clay balls make four &eClay Bowls&r. Smelt them into &eTerracotta Bowls&r."
		""
		"Fill one at a water source for a &eTerracotta Water Bowl&r, and cook it like a bottle to clean it."
	]
	quest.7E11FCBC16CF1610.quest_subtitle: "Cheap water containers"
	quest.7E11FCBC16CF1610.title: "Clay Bowls"
	quest.7E125B2B169A1483.quest_desc: [
		"The &eCrystal Chest&r shows its best items on the outside. Glass around a Diamond Chest."
		"The &eObsidian Chest&r survives explosions. Obsidian around a Diamond Chest."
	]
	quest.7E125B2B169A1483.quest_subtitle: "Show off, or blow up-proof"
	quest.7E125B2B169A1483.title: "Crystal and Obsidian"
	quest.7E265E04631E5CD5.quest_desc: [
		"Cut beef on the board for Minced Beef, cook it into a &eBeef Patty&r, then craft it with bread, a leafy green, tomato and onion."
	]
	quest.7E265E04631E5CD5.quest_subtitle: "A classic"
	quest.7E265E04631E5CD5.title: "Hamburger"
	quest.7E299B162E50D357.quest_desc: [
		"&eMaulers&r prowl Deserts, Badlands and Savannas. The name tells you everything."
		""
		"Take one down."
	]
	quest.7E299B162E50D357.quest_subtitle: "Watch the sand"
	quest.7E299B162E50D357.title: "It Bites"
	quest.7E60EEC6EECBC94F.quest_desc: [
		"A few Quark tweaks you might not even notice:"
		"Right-click a ladder onto another ladder to drop it down, and look down while climbing to slide faster."
		"Double doors open together. Hoes clear a 3-wide patch of plants (5-wide for diamond and netherite)."
		"Armor stands have arms, and right-clicking an item onto a lava bucket destroys it for good."
	]
	quest.7E60EEC6EECBC94F.quest_subtitle: "Things that just work now"
	quest.7E60EEC6EECBC94F.title: "Quality of Life"
	quest.7E673601D67AA63D.quest_desc: [
		"Write a &eSchedule&r (stations to visit, how long to wait), then give it to a driver seated at the controls."
		""
		"A seated mob or a Blaze Burner in front of the controls can drive."
	]
	quest.7E673601D67AA63D.quest_subtitle: "Autopilot"
	quest.7E673601D67AA63D.title: "Train Schedules"
	quest.7E71E6BD356EE787.quest_desc: [
		"An &eEnder Crafter&r (crafting table, eyes of ender and Ender Ingots) crafts slowly and needs no power. &eEnder Alternators&r within 3 blocks, even above or below, make it faster."
		""
		"It makes Enhanced Ender Ingots and Ender Stars."
	]
	quest.7E71E6BD356EE787.quest_subtitle: "The power of waiting"
	quest.7E71E6BD356EE787.title: "Ender Crafting"
	quest.7E721C988509F20A.quest_desc: [
		"Switch the encoder to &eProcessing&r mode for recipes a machine makes (smelting, crushing, pressing)."
		""
		"Put the pattern in a Pattern Provider facing that machine, and send the output back into the network."
	]
	quest.7E721C988509F20A.quest_subtitle: "Machines join in"
	quest.7E721C988509F20A.title: "Processing Patterns"
	quest.7E8392C46932C97C.quest_desc: [
		"The 1M component: three 256k components, an Accumulation Processor, sky stone dust and Vibrant Quartz Glass."
		""
		"MEGA cells need a &eMEGA Cell Housing&r (sky steel)."
	]
	quest.7E8392C46932C97C.quest_subtitle: "A million bytes"
	quest.7E8392C46932C97C.title: "MEGA 1M"
	quest.7E97DF3D601D88EB.quest_desc: [
		"Mekanism machines can be set up from any side. The &eConfigurator&r switches a side between input, output and off."
		""
		"Sneak and right-click to change mode. Most machines also have a side-config tab in their GUI."
	]
	quest.7E97DF3D601D88EB.quest_subtitle: "Your new favourite tool"
	quest.7E97DF3D601D88EB.title: "Welcome to Mekanism"
	quest.7EA66578CA2A46AC.quest_desc: [
		"Wrap a Dislocator in iron, redstone and Draconium to get the &eItem Dislocator&r."
		""
		"It pulls nearby drops into your inventory, so mining and mob fights get a lot tidier."
	]
	quest.7EA66578CA2A46AC.quest_subtitle: "Loot comes to you"
	quest.7EA66578CA2A46AC.title: "Item Dislocator"
	quest.7EDABD88E1DCC2DF.quest_desc: [
		"Wild &eWaystones&r can be found in all three vanilla dimensions, and some villages have one too."
		""
		"Right-click one to activate it. After that you can teleport to it from any other waystone."
	]
	quest.7EDABD88E1DCC2DF.quest_subtitle: "Someone left the lights on"
	quest.7EDABD88E1DCC2DF.title: "Find a Waystone"
	quest.7F0688B2DD8696A9.quest_desc: [
		"&eFarmer's Structures&r scatters small farms and kitchens around: on plains and savannas, along rivers, in Nether forests, and even in the Aether and the Undergarden."
		""
		"Tick this once you've found one."
	]
	quest.7F0688B2DD8696A9.quest_subtitle: "Somebody's garden"
	quest.7F0688B2DD8696A9.title: "Farmer's Structures"
	quest.7F1985EB636A1BA7.quest_desc: [
		"Draconium ingots, two Wyvern Energy Controllers and a &eWyvern Core&r."
		""
		"Place it, surround it with the four stabilizers and open its screen. &eToggle Build Guide&r shows the shell for the current tier."
	]
	quest.7F1985EB636A1BA7.quest_subtitle: "A battery the size of a house"
	quest.7F1985EB636A1BA7.title: "Energy Core"
	quest.7F2B3D32A89E4CEB.quest_desc: [
		"Eight of one generator around an &eEcho Shard&r makes its &e8x&r version."
		""
		"&6Heads up:&r in ICU the 8x versions also burn fuel faster, not just make more power. Great for saving space, not for saving fuel."
	]
	quest.7F2B3D32A89E4CEB.quest_subtitle: "Eight times the everything"
	quest.7F2B3D32A89E4CEB.title: "8x Generators"
	quest.7F7B3CE341146998.quest_desc: [
		"Made in the &eElite&r table: diamonds, lapis, iron, gold and two &eNether Stars&r make four Crystaltine Ingots."
		""
		"Crystaltine Components go into every Auto table."
	]
	quest.7F7B3CE341146998.quest_subtitle: "Your first 7x7 recipe"
	quest.7F7B3CE341146998.title: "Crystaltine"
	quest.7FCAF317E055B182.quest_desc: [
		"Farms far away from you freeze unless their chunks are loaded. Use a &eChunk Loader&r or claim and force-load the chunks with &eFTB Chunks&r (open the Xaero map)."
		""
		"Claims in ICU don't protect blocks, so ships and Create machines work everywhere. The Utilities chapter has the full quest."
	]
	quest.7FCAF317E055B182.quest_subtitle: "Walk away, come back to loot"
	quest.7FCAF317E055B182.title: "Farms That Keep Running"
	quest.7FEE95BB4127E777.quest_desc: [
		"&eFrogports&r grab packages and send them along &eChain Conveyors&r to other frogports."
		""
		"Give each one an address. Packages with a matching label get off there."
	]
	quest.7FEE95BB4127E777.quest_subtitle: "Ribbit, delivered"
	quest.7FEE95BB4127E777.title: "Frogports"
	quest.7FF973D520AAD8BD.quest_desc: [
		"The &eRitual of Binding&r turns a nearby eligible creature (a Starbuncle is the classic first pick) into a &eBound Script&r."
		""
		"Use the script, then summon your familiar from the spell book's crafting menu. It reserves some of your max mana while out."
	]
	quest.7FF973D520AAD8BD.quest_subtitle: "A friend that fights for you"
	quest.7FF973D520AAD8BD.title: "Familiars"
