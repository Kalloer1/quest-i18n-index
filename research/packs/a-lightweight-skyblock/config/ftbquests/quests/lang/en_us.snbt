	quest.398D625F93B5551F.quest_desc: [
		"{image:kubejs:textures/quests_en/01_start/banner.png width:200 height:40 align:center}"
		""
		"Welcome to this &btech skyblock&r!"
		""
		"You start on a tiny island. There are &cno ores&r, &cno caves&r and only very few structures. Everything you need comes from &6dirt, gravel and sand&r – with sieves, hammers and lots of patience."
		""
		"&eTips:"
		"&7• Press &fU&7 on an item in JEI to see what it is used for."
		"&7• Press &fR&7 to see its recipe – including sieve and hammer drops."
		"&7• Quests &fdon't consume&7 anything – you keep your items."
		"&7• Claim rewards by clicking the quest."
		""
		"Tick this quest to get started. &aHave fun!"
	]
