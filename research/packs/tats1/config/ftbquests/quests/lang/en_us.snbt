	quest.264B0B4E6135DB74.quest_desc: ["Instead of tossing armor in a kiln, crush it! Doing so will provide more materials back (applicable to tensura metal armors)."]
	quest.264B0B4E6135DB74.quest_subtitle: "&fSome additions"
