	quest.05F9E9B705B6F2C4.quest_desc: [
		"&0&lPassive"
		"[Passive, Toggle] Dragon's Claw - The user gains +1 Attack Damage per 100 Mastery. (1,000 Mastery by default). This becomes 2 when mastered."
		""
		"[Passive, In-slot] Cut Through - The user bypasses Resistances and Nullifications."
		""
		"&0&lActive"
		"[Active, Press] Dragon Claw - This is a slashing attack that cannot be preformed with an item in hand. It deals the user's Attack Damage x2 as damage and has a 7 block + reach range as damage. This will destroy blocks if gamerule isn't on."
	]
	quest.05F9E9B705B6F2C4.title: "&f&lDivide"
	quest.0604264265A8FA90.title: "&f&lAbove"
	quest.067629A073CD3234.quest_desc: [
		"&0&lPassive"
		"[Passive - Toggle] Thought Acceleration"
		""
		"[Passive - Toggle] Inspire Forces Boosts the stats of all allies in 30 block radius by 30% (60% with Mastery) and gives them 30% Crit chance (60% with Mastery)."
		""
		"[Passive - Toggle] Predictive Calculation : 10% Chance to auto-dodge an attack. 50% Chance to ignore dodge on enemies. Nullification is treated as resistance and resistance is bypassed. Magic Jamming's damage mitigation is ignored."
		""
		"&0&lActive"
		"[Active - Press] Thought Communication: Able to give commands to allies similar to Thought Communication."
		""
		"[Active - Press] Thought Domination: Works like Vampire’s Charm."
	]
	quest.067629A073CD3234.quest_subtitle: "&fUsage"
	quest.067629A073CD3234.title: "&f&lCommander"
