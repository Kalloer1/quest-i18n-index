	quest.6FDE80D92229EA34.quest_desc: [
		"&f&lLocation: She lies in her castle the Night Rose"
		""
		"Quest Description: An elegant, gothic architecture that glows with a cold, divine radiance. The halls are silent, adorned with intricate stained glass and holy symbols that mask the terrifying power of the true vampire beneath. Luminus is so powerful she is hailed as a god."
	]
	quest.6FDE80D92229EA34.quest_subtitle: "&0&lThe Queen of Nightmares"
	quest.6FDE80D92229EA34.title: "&4&lLuminus Valentine"
	quest.7013B1B6966AD280.quest_desc: [
		"&0&lPassive"
		"[Passive, True] Pyromaniac - The user gains all of the Flame-Type Aspectual Magics."
		""
		"[Passive, Toggled] Paradox Flame - All of the user's Flame Magics become White. They apply the Freeze Effect when dealing Fire Damage."
		""
		"&0&lActive"
		"[Active, Press] After World - The user creates a virtual space around them which makes all of their Flame Magics deal Spiritual Damage as well. Anything killed inside of the After World will give the user Soul Points. The user gains 1.5x EP Regeneration inside of After World for every 1,000 Souls they possess."
		""
		"[Active, Toggle] White Flame - The user coats themselves in ultra-white hot flames. These flames apply Freezing Burn on hit. Entities with Spiritual Attack Nullification and Thermal Fluctuation Nullification are able to ignore this effect."
	]
	quest.7013B1B6966AD280.title: "&f&lFreezing Flame"
