	quest.659D5811777C1999.quest_desc: [
		"Go to Spirit Tree and let another player hit you with Hellfire or Flare Circle"
		""
		"If you are playing alone just fight Ifrit (Greater Fire Elemental) and let him hit you"
		""
		"When toggled, prevents Fire damage if it falls below 50% of your Max HP. If the attack is not below 50% of your Max HP the damage will be halved."
		"Gives the ability to learn Flame Manipulation"
	]
	quest.659D5811777C1999.quest_subtitle: "&f&lTips"
	quest.659D5811777C1999.title: "&#A5200C&lFlame Attack Resistance"
