	quest.66F9B5C4A06AB6AA.quest_desc: ["Found in Ice spikes (mine them) within Ice Spikes Biome or in the watee biome of the elemental realm"]
	quest.66F9B5C4A06AB6AA.quest_subtitle: "&fObtainment"
