	quest.266B57A4679BB342.title: "&f&lObtain A Greater Spirit Of Space"
	quest.269F39CBF204B3D5.quest_desc: ["This is a massive standout because its damage scales off the player's held weapon and its enchantments. If a player is wielding an endgame Tensura blade that deals hundreds of damage, Shadow Slash will hit like an absolute freight train."]
	quest.269F39CBF204B3D5.title: "&f&lShadow Slash"
	quest.26AF6D1FE1A86DD7.quest_subtitle: "&fImportant Items"
	quest.26AF6D1FE1A86DD7.title: "&0&lEssence Of Evolution"
