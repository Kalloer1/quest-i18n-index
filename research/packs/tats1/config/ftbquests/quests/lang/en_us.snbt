	quest.0699629B07AAE4BE.title: "&f&lRaces"
	quest.06BBA61254B1A2C5.quest_desc: [
		"&0&lPassive"
		"[Passive - Toggle] - Sense Soundwave"
		""
		"&0&lActive"
		"[Active - Press] - Sonic Blast: Fires a sonic boom that deals 75 (150 with Mastery) damage ignoring armor at the cost of 50 MP - 1s Cooldown."
		""
		"[Active - Press] - Sound Wave: Deals 40 damage (70 with mastery) to everything in a 10x10 radius ignoring armor at the cost of 100 MP."
		""
		"[Active - Press] - Mind Requiem (Requires Mastery): Fires a sonic boom that does 150 Damage and 100 Spiritual Damage ignoring armor at the cost of 200 MP. Cooldown 3s."
	]
	quest.06BBA61254B1A2C5.quest_subtitle: "&fUsage"
	quest.06BBA61254B1A2C5.title: "&f&lMusician"
	quest.06E955CC4B9DDEB0.quest_desc: [
		"&0&lPassive"
		"[Passive, True] Scent of Death: Soul particles float around the user every 5 seconds."
		""
		"&0&lActive"
		"[Active, Press] No Escape: Pull your target towards you slightly, dealing 44 damage. 44 second cooldown. 4444 MP cost."
		""
		"[Active, Press] Death’s Door: Produce a blade with a mangled name and 44444 max EP (not increasible as for some reason the items i apply ep stats to don't work...) . 444 second cooldown."
	]
	quest.06E955CC4B9DDEB0.title: "&f&lEnding"
	quest.07A6BE68A11FDC5D.quest_desc: [
		"Get someone to use Poisonous Breath on you"
		""
		"If you are playing alone just let Tempest Serpents use their Poisonous Breath on you"
		""
		"When toggled, it nullifies the effects of Poison and prevents Poison damage if it falls below 50% of your Max HP. If the attack is not below 50% of your Max HP the damage will be halved."
