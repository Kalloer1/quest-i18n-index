	quest.7352692195262DE4.quest_desc: [
		"Go to the Spirit Tree and let another player hit you with a weapon that has Holy Weapon engraving on it, or they could use the Magic Aura skill and change the damage to Holy. Or drop a weapon that does holy damagr to a mob, let the mob pick it up and let them hit you with it."
		""
		"Go fight the scary mean woman (Hinata) and get hit by her Melt Slash"
		""
		"When toggled, prevents Holy damage if it falls below 50% of your Max HP. If the attack is not below 50% of your Max HP the damage will be halved."
	]
	quest.7352692195262DE4.quest_subtitle: "&f&lTips"
	quest.7352692195262DE4.title: "&#C97F15&lHoly Attack Resistance"
	quest.735EE2F54CBE16DA.quest_subtitle: "Better enchanting awaits"
