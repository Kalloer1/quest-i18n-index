	quest.7347C968B7B5EB87.quest_desc: [
		"&f&lLocation: Found in the Beast Kingdom Of Eurazania"
		""
		"Quest Description: An imposing, rustic fortress carved into the side of a massive mountain, reflecting the feral strength of its master. Carrion stand at the peak and is even more ferocious than Rimuru himself."
	]
	quest.7347C968B7B5EB87.quest_subtitle: "&0&lThe Beast Master"
