	quest.0A0FD9458FC5D7BA.quest_desc: [
		"&f&lLocation: Found in the Soul Blacksmith (Forge of Souls) in the Nether, often hidden behind lava waterfalls."
		""
		"Quest Description: A mountain of living Netherite waits in the deepest forges of the Nether. It devours lava to heal its wounds and strikes with shockwaves that ignore standard defenses. Bring your strongest gear, or you will be crushed into soot."
	]
	quest.0A0FD9458FC5D7BA.quest_subtitle: "&0&lThe Soul-Forged Juggernaut"
	quest.0A0FD9458FC5D7BA.title: "&4&lThe Netherite Monstrosity"
