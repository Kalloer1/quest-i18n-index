	quest.55785A828D588FC1.quest_desc: [
		"   When you start &dliving in the village&f"
		"         And make &evarious trades&f"
		" You can influence the &6village economy&f"
		"         Becoming a &amerchant&f is a "
		"  Great way to gain &brespect and trust&f"
	]
	quest.55785A828D588FC1.quest_subtitle: "Starting in Business"
	quest.55785A828D588FC1.title: "Merchant"
	quest.55B096952C7CAE11.quest_desc: [
		"            &6Blinds&f are a &acurtain&f"
