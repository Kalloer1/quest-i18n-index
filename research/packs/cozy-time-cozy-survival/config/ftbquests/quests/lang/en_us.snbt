	]
	quest.55B096952C7CAE11.quest_subtitle: "Curtain"
	quest.55B096952C7CAE11.title: "Blinds"
	quest.562DEEA407562B29.quest_subtitle: "&7Prepare a Simple Spicy Dish"
	quest.56426D9DB5C6432F.quest_desc: [
		" In the &ccrimson forests&f of the &cNether"
		"   You will find a &avolatile plant&f known"
		"           As the &6Bullet Pepper&f"
		" Getting too close can make it &cExplode"
		"   So you must handle it with extreme"
		"   &bCare&f and &6Caution by using a &eKnife"
		" You can &bsafely harvest&f and process"
		"    It to obtain many &auseful materials&f"
		"    Obtain a &6Bullet Pepper&f today and"
		"        Learn how to work with this"
		"&eDangerous ingredient&f for your recipes"
	]
	quest.56426D9DB5C6432F.quest_subtitle: "&7Handle a Dangerous Nether Ingredient"
	quest.5647319273ED4229.quest_desc: ["&fTravel across this world can become much easier, but only for those willing to shape the land first. By building proper &aroads &fbetween important places, you can create reliable routes that reward both exploration and careful planning. Before fast travel becomes possible, make sure your paths are clear and your destinations are worth connecting."]
	quest.5647319273ED4229.quest_subtitle: "&7Fast travel begins with a well-built road"
	quest.5647319273ED4229.title: "&5&lQuest: &r&eRoads of the Empire"
	quest.568D6083936BBD12.quest_desc: [
		"         &fWe need to &6upgrade &four"
		"            &eTools &fto be able to"
		"               Mine &bstronger"
		"                     &aOres&f!"
	]
	quest.568D6083936BBD12.quest_subtitle: "Improving Resources"
	quest.568D6083936BBD12.title: "Stone Pickaxe"
	quest.57CB5E5A892282EA.quest_subtitle: "Wrap"
	quest.581FF6B8199A8037.quest_desc: ["&fThe &aDragonfly Wings &fdropped by dragonflies may not seem important at first, but they are far more useful than simple leftovers. These delicate wings are the key to taming &aJumping Spiders, &fturning a curious little creature into a loyal defender. Keep every wing you find, because they may be worth more than they appear."]
	quest.581FF6B8199A8037.quest_subtitle: "&7Dragonfly wings have a hidden use"
	quest.581FF6B8199A8037.title: "&5&lQuest: &r&eDo Not Throw These Away"
	quest.585B7AAEAD1275E1.quest_desc: [
		"          We can build new &6fences&f"
		"           To beautify our &dhouse&f"
		"        With these &adifferent fences&f"
	]
	quest.585B7AAEAD1275E1.quest_subtitle: "New Fences"
	quest.5911226A2E56BEE0.quest_desc: [
		"     This &6Table&f is extremely curious,"
		"   With it we can &bremove enchantments&f"
		"           From &eitems&f and transfer"
		"               Them into a &ebook&f."
		"           Its &apotential&f is amazing!"
	]
	quest.5911226A2E56BEE0.quest_subtitle: "Disenchantment"
	quest.5A0E59768910AF49.quest_desc: [
		"         Forged from 4 Blocks of&f"
		"                &0Ancient Debris&f"
		"           And a &ecarved pumpkin&f"
		"        The &6netherite golem&f is one"
		"      Of the &astrongest companions&f"
		"         You can mount&f and jump&f"
		"       To deal a &cdevastating slam&f"
		"  But its &6true power&f comes from &4lava&f"
		"          Feed it a &elava bucket&f"
		"       Press &bR&f to release &cFlames&f"
		"     That &bchase down&f your enemies&f"
		"          Be careful in the rain&f!"
		"         Carrying lava will hurt it&f"
	]
	quest.5A0E59768910AF49.quest_subtitle: "WOW!"
	quest.5A49C989B335857D.quest_desc: ["&fThe &aTerracotta Golem &fcan be found naturally in badlands, but it can also be crafted by hand using clay at a workbench. To awaken it, place it beside a heat source such as lava or a campfire and let the warmth bring it to life. You can increase its attack by giving it a cactus or dead bush, and if you want to remove those thorns later, a pair of &aShears &fwill do the job."]
	quest.5A49C989B335857D.quest_subtitle: "&7A desert guardian awakened by heat"
	quest.5A49C989B335857D.title: "&5&lQuest: &r&eTerracotta Golem"
	quest.5A5B839A38BD0A5B.quest_desc: ["&fSome bonds grow far beyond simple friendship. By spending time together, sharing moments and showing genuine care, a relationship can deepen into something truly meaningful. Reaching &a200 Hearts &fwith a villager means you have found a &atrue friend, &fsomeone who trusts you completely and will stand by your side."]
	quest.5A5B839A38BD0A5B.quest_subtitle: "&7Reach 200 hearts with a villager"
	quest.5A5B839A38BD0A5B.title: "&5&lQuest: &r&eA True Friend"
	quest.5A6430C9EC732243.quest_subtitle: "&7Process Meat for Efficiency"
	quest.5B01DE3EC860F872.quest_desc: ["&fThe &aBarrel Golem &fis a peaceful creature that can be found naturally in villages, often keeping to itself until approached. When startled or when it goes to sleep, it hides inside its barrel body, greatly increasing its defense and becoming immune to projectiles. It can be repaired with wooden planks, and if you offer it &aEmeralds, &fit may toss useful items back in return."]
	quest.5B01DE3EC860F872.quest_subtitle: "&7A shy village trader with sturdy defenses"
	quest.5B01DE3EC860F872.title: "&5&lQuest: &r&eBarrel Golem"
	quest.5B083E5EAC7E31D9.quest_desc: ["&fPlushies are adorable decorative items that bring warmth and personality to your builds. Designed as small animal figures, they are perfect for bedrooms and cozy spaces. They are also easy to craft, making them a simple way to enhance your &ainteriors."]
	quest.5B083E5EAC7E31D9.quest_subtitle: "&7Add charm to your interiors"
	quest.5B083E5EAC7E31D9.title: "&5&lQuest: &r&ePlushies"
	quest.5B91911C7AEF8FC8.quest_desc: [
		"               The &asilk&f found"
		"           Near &6spider cocoons&f"
		"            Is more than just a"
		"              &aCurious material&f"
		"          It can be crafted into"
		"                 A silk rope&f"
		"            More &bresistant&f than"
		"                A &enormal lead&f"
		"           And far more &breliable&f"
		"          In &cdangerous situations&f"
		"         Use it not just on &aanimals&f"
		"            But also on &4monsters&f"
		"       And other &bhostile creatures&f"
	]
	quest.5B91911C7AEF8FC8.quest_subtitle: "Holding Tighter"
	quest.5CFD57DFE9C712DD.quest_desc: [
		"        Well... &6doors&f already exist"
		"   However we can create &anew doors&f"
		"     I think I &bdo not need to explain"
		"             What a door is for"
	]
	quest.5CFD57DFE9C712DD.quest_subtitle: "Doors?"
	quest.5D5452B5149E60AF.quest_subtitle: "&7Prepare a Flavorful Spicy Dish"
	quest.5EBF76CDBC3F6AF2.quest_desc: ["&fSome recipes make use of unusual ingredients from Nether creatures. The &aRock Soup &fis prepared using a &aStrider Egg, &fcreating a strange but nourishing dish. Cook it and discover new possibilities in your &acooking."]
	quest.5EBF76CDBC3F6AF2.quest_subtitle: "&7Use strider resources in cooking"
	quest.5EBF76CDBC3F6AF2.title: "&5&lQuest: &r&eRock Soup"
	quest.5F51B2D44A75C0D8.quest_subtitle: "MEcDonaLdS"
	quest.5FF9D6AC79D484BF.quest_desc: [
		"            The &6Terracotta Golem&f"
		"             Is found in &4badlands&f"
		"            It can be &bcrafted&f with"
		"             &eClay&f on a &eworkbench&f"
		"              To &dwake it up&f, place"
		"             It near &cheat&f or &clava&f"
		"            Give it &ecactus&f or &ebush&f"
		"              To &bboost its attack&f"
		"              And use &eshears&f to"
		"              &4Remove the spikes&f"
	]
	quest.5FF9D6AC79D484BF.quest_subtitle: "Terracotta?"
	quest.602F67801FE0E7BE.quest_desc: ["&fLong journeys, building projects and deep expeditions often leave your inventory full far too quickly. A &aBackpack &fwill let you carry extra blocks, food, tools and valuable loot, making every adventure far more comfortable. Craft or obtain a &aBackpack &fand keep it with you on your travels."]
	quest.602F67801FE0E7BE.quest_subtitle: "&7Carry more supplies wherever you go"
	quest.602F67801FE0E7BE.title: "&5&lQuest: &r&ePack for the Journey"
	quest.60B1313CEFC3C25C.quest_desc: ["&fWindows are essential to give life and light to your constructions. There are many designs available, made from different types of wood and glass, allowing you to match any style. Place them and improve both the appearance and lighting of your &abuilds."]
	quest.60B1313CEFC3C25C.quest_subtitle: "&7Bring light into your builds"
	quest.60B1313CEFC3C25C.title: "&5&lQuest: &r&eWindows"
	quest.61483FCCEA6B9519.quest_subtitle: "&7Collect a Rare Ingredient"
	quest.624487455046F74A.quest_desc: [
		"    Even the &aPumpkins&f are &6different&f!"
		"  We have &eseveral types of pumpkins&f"
		" And we can use them for &bmany Things&f"
	]
	quest.624487455046F74A.quest_subtitle: "Different Pumpkins"
	quest.6296E5D06C37A804.quest_subtitle: "&7Process Ingredients for Efficiency"
	quest.63D483D66FD6228E.quest_desc: ["&fTime passes, and the world continues to grow beyond your own story. Watching the next generation form families of their own is a sign of everything you have built and nurtured. Becoming a &agrandparent &fmarks the creation of a true legacy, where your influence lives on through those who came after you."]
	quest.63D483D66FD6228E.quest_subtitle: "&7Become a grandparent"
	quest.63D483D66FD6228E.title: "&5&lQuest: &r&eA Lasting Legacy"
	quest.63D5F281E340957C.quest_desc: ["&fArmor stands can be much more than simple displays for equipment. With the right adjustments, you can unlock &aarms, &frotate different body parts and choose from several built-in &aposes &fto create far more dynamic decorations. Experiment with your armor stands and give your base a more lively and personal touch."]
	quest.63D5F281E340957C.quest_subtitle: "&7Bring your armor stands to life"
	quest.63D5F281E340957C.title: "&5&lQuest: &r&eDecorative Poses"
	quest.64348DF4AC0995FA.quest_subtitle: "&7Cook the Skewered Tentacle"
	quest.6450C5225396BF07.quest_desc: [
		"   As your &dChildren&f &6grow and mature&f"
		"          They can start a &dfamily"
		"             And have &6children&f"
		"  You need to be a &agreat grandfather"
		"             To your &egrandkids&f"
		"    Just as you were a &bgreat father&f"
	]
	quest.6450C5225396BF07.quest_subtitle: "Your Legacy..."
	quest.6450C5225396BF07.title: "Becoming a Grandmother"
	quest.64F3E559E01F16E2.quest_desc: [
		"            The &6Dragonfly&f is a"
		"           Completely &apeaceful&f"
		"              And &dloyal flight&f"
		"                  &4Companion&f"
		"        Requires many &cspider eyes&f"
		"                To be &btamed&f"
		"             Equip it with &6armor&f"
		"         Of iron, &egold&f or &bdiamond&f"
		"         It drops &edragonfly wings&f"
		"             A &avaluable material&f"
		"        That must never be &cwasted&f"
	]
	quest.64F3E559E01F16E2.quest_subtitle: "DRAGON!!!"
	quest.661A1C0CD93EFEF9.quest_desc: [
		"                 We can make"
		"      &eVarious types of staircases&f"
		"    To make &6new rooms&f in our &dhouse&f"
	]
	quest.661A1C0CD93EFEF9.quest_subtitle: "Moving up in life"
	quest.665EEF13BC85EF48.quest_desc: ["&fLiving among others means more than just passing by. By talking, helping and giving thoughtful gifts, you can slowly build a strong &afriendship &fwith the people around you. Reaching &a50 Hearts &fwith a villager shows that you are no longer a stranger, but someone they can truly trust. Strengthen your bonds and become part of the community."]
	quest.665EEF13BC85EF48.quest_subtitle: "&7Reach 50 hearts with a villager"
	quest.665EEF13BC85EF48.title: "&5&lQuest: &r&eBuilding Trust"
	quest.66D7DCAD8CDA6503.quest_desc: [
		" With the right &aingredients&f and &autensils"
		"         Prepare &6complete meals&f"
		"   &eEgg sandwiches&f, &9chicken sandwiches"
		" &eBurgers&f and &ewraps&f are &beasy to craft&f"
		" These options provide &dbetter nutrition"
		"     To sustain you on your journey"
		"      Try &adifferent combinations&f and"
		"       Build your own &6meal collection&f"
	]
	quest.66D7DCAD8CDA6503.quest_subtitle: "Simple Meals"
	quest.66D7DCAD8CDA6503.title: "Minced Beef"
	quest.676F4D799A580B52.quest_desc: ["&fThe &aDragonfly &fis a completely peaceful creature that can become a loyal flying companion if you are willing to invest enough effort. It requires many spider eyes to be tamed, but once befriended it can be protected with iron, gold or diamond armor. It also drops &aDragonfly Wings, &fa valuable material that should never be wasted."]
	quest.676F4D799A580B52.quest_subtitle: "&7A peaceful companion with useful wings"
	quest.676F4D799A580B52.title: "&5&lQuest: &r&eA Gentle Dragonfly"
	quest.6808D4C614A122FE.quest_desc: ["&fTables are a simple yet essential piece of furniture. While they share a single design, they can be crafted using different types of wood, allowing them to adapt to many styles. Place one and complete your interior with a versatile and &afunctional &fpiece."]
	quest.6808D4C614A122FE.quest_subtitle: "&7Create versatile interior spaces"
	quest.6808D4C614A122FE.title: "&5&lQuest: &r&eTables"
	quest.685317CDC1C8F9E0.quest_desc: ["&fThe &aDumbo Octopus &fis a peaceful ocean creature that cannot be tamed or bred, but its presence can still be incredibly valuable. If you stay close to one while underwater, it will create a small air bubble around your head, helping you breathe and avoid drowning. Keep an eye out for this strange little ally during longer &adives."]
	quest.685317CDC1C8F9E0.quest_subtitle: "&7A gentle creature that helps you underwater"
	quest.685317CDC1C8F9E0.title: "&5&lQuest: &r&eBreath of the Deep"
	quest.68779D272A01D70D.quest_subtitle: "&7Prepare a Simple Skewered Dish"
	quest.68EA4A1B532F2372.quest_subtitle: "&7Combine Rare Ingredients With Vegetables"
	quest.69C6D2C07946FC50.quest_desc: ["&fFences are a simple but important way to define and decorate your builds. There are many styles available, made from different types of wood, including wired and bush variants. Choose the one that best fits your design and shape your &asurroundings."]
	quest.69C6D2C07946FC50.quest_subtitle: "&7Define your spaces with style"
	quest.69C6D2C07946FC50.title: "&5&lQuest: &r&eWooden Fences"
	quest.6A4731BDDF435B6B.quest_desc: [
		"            We can build &6windows&f"
		"       And put them in our &dhouses&f"
		"     &aPerfect&f for letting some &bair&f in"
	]
	quest.6A4731BDDF435B6B.quest_subtitle: "Open and Close"
	quest.6AD1F4E96802964B.quest_desc: ["&fSome cliffs, walls and tall structures are much easier to conquer with the right tool. A &aGrappling Hook &flets you launch a rope high above until it catches onto a surface, then pull yourself upward with speed and precision. It is perfect for reaching high places, scaling builds or even gaining momentum before taking flight with an &aElytra."]
	quest.6AD1F4E96802964B.quest_subtitle: "&7Climb higher with a grappling hook"
	quest.6AD1F4E96802964B.title: "&5&lQuest: &r&eReach the Impossible"
	quest.6D4E5DAAF174027D.quest_desc: ["&fIn birch forests you may encounter the unusual &aHoney Golem, &fa living hive-shaped guardian with a sweet but dangerous purpose. Bees can live inside its body and help it produce honey, while it also has a chance to launch &aHoney Drops &fat enemies, dealing damage and slowing them down. If it is hurt, you can restore it with bottles of honey and keep this sticky protector in fighting shape."]
	quest.6D4E5DAAF174027D.quest_subtitle: "&7A sticky defender from birch forests"
	quest.6D4E5DAAF174027D.title: "&5&lQuest: &r&eHoney Golem"
	quest.6DA62CFD96EBE7E7.quest_subtitle: "BACON"
	quest.6DB14B7B05E094B1.quest_desc: ["&fThe pearls gathered from otters can be turned into a &aPearl Necklace, &fa useful accessory for anyone who spends time underwater. Even the first version grants faster swimming and reduces the detection range of drowned, making aquatic exploration much safer. By upgrading it with more &aPearls, &fyou can strengthen these effects and become far more comfortable beneath the waves."]
	quest.6DB14B7B05E094B1.quest_subtitle: "&7Craft a necklace for safer swimming"
	quest.6DB14B7B05E094B1.title: "&5&lQuest: &r&ePearls of the Deep"
	quest.6E91229A6C841374.quest_desc: ["&fWooden drawers are a great addition to modern interiors, fitting perfectly in bedrooms and living spaces. Beyond decoration, they can store items just like a chest, combining style and utility. Place one and improve both the look and functionality of your &ainteriors."]
	quest.6E91229A6C841374.quest_subtitle: "&7Decorate with functional storage"
	quest.6E91229A6C841374.title: "&5&lQuest: &r&eWooden Drawers"
	quest.6F339B3C7EEB74A8.quest_desc: [
		"      Many &6useful ingredients&f grow"
		"        Naturally across the &dworld&f"
		"           &eCabbage&f and &ebeetroot&f"
		"     Can be found near the &bbeaches&f"
		"        &eOnion&f and &ecarrot&f appear in"
		"             &aPlains&f and &dforests&f"
		"     &cTomatoes&f grow in &9savannas&f and"
		"            &ePotatoes&f in &6mountains&f"
		"         &aRice&f grows in &2swamps&f and"
		"     Must be &bone block under water&f"
		"         &etomatoes&f can use &6rope&f"
		"      To continue &cclimbing&f upwards"
		"        Keep your eyes open and"
		"   Gather every &eingredient&f you find!"
	]
	quest.6F339B3C7EEB74A8.quest_subtitle: "Natural Ingredients"
	quest.701362991EEAB76F.quest_desc: ["&fThe holiday season brings a wide variety of decorations to your builds. From illuminated trees and candy canes to gift boxes, red stockings and glowing garlands, you can transform any space into a festive environment. Place them and fill your world with a true &aholiday spirit."]
	quest.701362991EEAB76F.quest_subtitle: "&7Decorate for the holidays"
	quest.701362991EEAB76F.title: "&5&lQuest: &r&eChristmas Decorations"
	quest.701529998252BB1A.quest_desc: [
		"        By gaining the &btrust&f of the"
		"                Entire &6village&f"
		"        You can become the &6mayor&f"
		"     And become &aresponsible&f for the"
		"   Whole village, you can define &arules&f"
		"     Dictate how the &bvillage operates"
		"    You can even weigh in on others'"
		"                &dRelationships&f!"
		"              Be a true &aleader&f"
	]
	quest.701529998252BB1A.quest_subtitle: "Leader of The People"
	quest.701529998252BB1A.title: "Mayor"
	quest.70BFAFF0AF98D825.quest_subtitle: "&7Obtain a Rare Ocean Ingredient"
	quest.70E9591C5B8386D0.quest_desc: [
		"        The &6frying pan&f is another"
		"       Essential utensil that can be"
		"      Placed over any &cheat source&f"
		"               It allows you to"
		"         &bCook various ingredients"
		"      Directly, making it perfect for"
		"                  &aQuick meals&f"
		"            Although it only holds"
		"              &eOne stack of food"
		"            At a time, it is ideal for"
		"             &6Simple preparations&f"
		"  &bCraft&f a frying pan and add another"
		"   Useful &aworkstation&f to your kitchen"
	]
	quest.70E9591C5B8386D0.quest_subtitle: "Heat Up the Skillet"
	quest.723C4C8954231D51.quest_desc: [
		"     &9Friendship&f is a &6very important&f"
		"      Part of our lives and nothing"
		"             Has changed here!"
		"         With &9friendship&f you have"
		"             &aRespect and trust&f"
		"  To have respect is much more than"
		"Living together, give &egifts&f, make &etrades&f"
		"         After reaching &c50 hearts"
		"        The &dvillager&f sees you as a"
		"                 &bGood friend&f"
	]
	quest.723C4C8954231D51.quest_subtitle: "Making new friends"
	quest.723C4C8954231D51.title: "Friend"
	quest.7335A0A6A74F610C.quest_subtitle: "&7Cook a Nether Meat Source"
	quest.739B2997094F1E8F.quest_desc: [
		"            The &boceans&f offer a"
		"      &aVariety of unique ingredients"
		" That can be used to create &6nutritious"
		"             And healthy meals&f"
		"            Creatures such as"
		"         &esquid&f, &6guardians&f, and &ecod"
		"       Provide &avaluable resources"
		"  That can be turned into &btasty dishes&f"
		"        &bExplore the waters&f, collect"
		"  These ingredients, and expand your"
		"          &dCulinary repertoire&f with"
		"       Various &aseafood-based meals&f"
	]
	quest.739B2997094F1E8F.quest_subtitle: "Marine Creatures"
	quest.73D084918A0F81A4.quest_desc: ["&fSome Nether ingredients can be used in unusual recipes. The &aMagma Cake &fcombines magma cream into a unique dessert that offers strong nourishment. Prepare it and explore more advanced &ameals."]
	quest.73D084918A0F81A4.quest_subtitle: "&7Prepare a fiery dessert"
	quest.73D084918A0F81A4.title: "&5&lQuest: &r&eMagma Cake"
	quest.74C6C49A972D0A78.quest_desc: ["&fThese small &aJumping Spiders &fare far friendlier than they first appear and can become surprisingly helpful companions. They are often found near cocoons, which may contain random loot and spider silk, and they can be tamed by feeding them &aDragonfly Wings. &fOnce loyal to you, they will defend you from nearby enemies."]
	quest.74C6C49A972D0A78.quest_subtitle: "&7Befriend the jumping spiders"
	quest.74C6C49A972D0A78.title: "&5&lQuest: &r&eTiny Guardians"
	quest.7517A375EB423AA8.quest_desc: ["&fNot every guardian in this world is made of iron. Hidden across different biomes and materials, you will discover many unusual &agolems, &fsome crafted by your own hands and others found wandering the land. Each one has its own strengths, special abilities and favorite repair material, so learn how they work and choose the &aright companion &ffor every situation."]
	quest.7517A375EB423AA8.quest_subtitle: "&7Meet the strange golems of this world"
	quest.7517A375EB423AA8.title: "&5&lQuest: &r&eFaithful Assistants"
	quest.753E652470CB0D63.quest_desc: ["&fRoofs play a major role in the overall look of your constructions. They can be crafted using many materials such as different types of wood, stone or even glass. Glass roofs allow sunlight to pass through, making them perfect for enclosed spaces. Build one and define the style of your &astructure."]
	quest.753E652470CB0D63.quest_subtitle: "&7Shape the top of your builds"
	quest.753E652470CB0D63.title: "&5&lQuest: &r&eRoofs"
	quest.75474F2A862FE517.quest_desc: [
		"       We can use a &6grappling hook&f"
		"                To shoot &awebs&f"
		"          And &bgrapple&f onto &etrees&f,"
		"             &eWood&f and &amuch more&f"
		"                 &bMoving&f around"
		"              Much more &bquickly&f"
	]
	quest.75474F2A862FE517.quest_subtitle: "Like Spider-Man"
	quest.7640556580D163A6.quest_desc: ["&fHidden within the jungle lives the &aRed Panda, &fan adorable creature that stays awake during the night and brings life to the treetops. It can be tamed with berries and bred using bamboo, making it a charming addition to any camp or base. When startled or alert, it may stand on two legs and &ascare away &fother neutral animals nearby."]
	quest.7640556580D163A6.quest_subtitle: "&7Meet the red panda of the jungle"
	quest.7640556580D163A6.title: "&5&lQuest: &r&eThe Night Watcher"
	quest.77914D5DBF4741F8.quest_desc: ["&fArmor stands can be adjusted in far more detail than they first appear. You can change the position and rotation of each body part, give them a custom &aname, &fmake them small like a baby villager, hide the base or the item in their hand, and even disable &agravity &fso they remain floating in place. They can also be made invisible so only the armor or weapon is visible, allowing for highly detailed displays. Once your design is ready, simply save the changes or cancel them if you want to start again."]
	quest.77914D5DBF4741F8.quest_subtitle: "&7Use armor stands for advanced decoration"
	quest.77914D5DBF4741F8.title: "&5&lQuest: &r&eCreative Displays"
	quest.77C7F001E1659E37.quest_subtitle: "&7Prepare a Nourishing Seafood Dish"
	quest.780193BD254CF74B.quest_desc: ["&fWith stronger bonds and a growing presence, you may rise to the rank of &aNoble, &fa position earned through trust and contribution to the community. At this level, your influence extends further, allowing you to guide aspects of village life such as population growth and organization. You are no longer just part of the village, you help shape its &afuture."]
	quest.780193BD254CF74B.quest_subtitle: "&7Take on greater responsibility within the village"
	quest.780193BD254CF74B.title: "&5&lQuest: &r&eA Rising Noble"
	quest.782CC1999DE4882F.quest_desc: ["&fHalloween decorations allow you to fully transform your builds into a spooky setting. From cobwebs, cat and bat drawings to pumpkins, ghosts, scarecrows, gravestones and witch potions, there are many ways to decorate. Place them and bring a true &aeerie atmosphere &fto your world."]
	quest.782CC1999DE4882F.quest_subtitle: "&7Create a spooky environment"
	quest.782CC1999DE4882F.title: "&5&lQuest: &r&eHalloween Decorations"
	quest.783BC7210A42AD5F.quest_desc: [
		"         Hidden in the &6jungle&f lives"
		"               The &6red panda&f"
		"           An &aAdorable&f creature"
		"         That stays awake at &0night&f"
		"               In the &atreetops&f"
		"             &bTame&f it with &eberries&f"
		"           And &bbreed&f with &ebamboo&f"
		"            When &cscared&f or &calert&f"
		"            It stands on &6two legs&f"
		"                To &bscare away&f"
		"            Other &dneutral&f animals"
	]
	quest.783BC7210A42AD5F.quest_subtitle: "And the bamboo?"
	quest.783BC7210A42AD5F.title: "Red Panda"
	quest.79D8F6A2AD6A940A.quest_subtitle: "&7Preserve a Rare Ingredient"
	quest.7A427C1379B2917B.quest_desc: [
		"              &6Koi Fish&f can have"
		"           Many &abeautiful colors&f"
		"              Bringing &dpeace&f to"
		"              &bLakes and rivers&f"
		"           They can be picked up&f"
		"                 With a &ebucket&f"
		"             For easy transport&f"
		"              Staying &bnear&f a &6Koi&f"
		"                Gives you &aluck&f"
		"               More &duseful&f than"
		"                 They &6appear&f"
	]
	quest.7A427C1379B2917B.quest_subtitle: "Little Fish"
	quest.7A427C1379B2917B.title: "Koi Fish"
	quest.7A86743926C7D537.quest_desc: [
		"       Decorations are &6Great Ways&f"
		"        To make our &dHome&f beautiful"
		"          Bring &bPeace of Mind&f with"
		"      Various forms of &6Decorations&f"
		"     The cutest ones of them all are"
		"          Certainly the &aPlushables&f"
		"    They are &eExtremely Adorable&f and"
		"             Make any place cozy"
		"    Start decorating your &dSpace&f with"
		"          These &aCute Companions&f!"
	]
	quest.7A86743926C7D537.quest_subtitle: "Cute"
	quest.7A86743926C7D537.title: "Plushable"
	quest.7B67AF9ECF316B50.quest_subtitle: "&7Create a Refined Ocean Dish"
	quest.7B9606933C8D9790.quest_desc: ["&fBlinds are a great way to enhance your windows, adding both style and functionality. They can be opened and closed, allowing you to control light and create dynamic designs. Place them and give your builds a more detailed &aappearance."]
	quest.7B9606933C8D9790.quest_subtitle: "&7Add detail to your windows"
	quest.7B9606933C8D9790.title: "&5&lQuest: &r&eBlinds"
	quest.7BC8092367DE4C6F.quest_desc: [
		"            On &cChristmas&f we can"
		"        Decorate our &dlittle house&f"
		"       With various &6christmas items&f"
	]
	quest.7BC8092367DE4C6F.quest_subtitle: "Christmas Decorations"
	quest.7C91BCDCF2DA30C7.quest_desc: [
		"     A good &aknife&f is one of the most"
		"               &6Important tools&f"
		"      In any &ekitchen&f and a valuable"
		"          &bCompanion&f while &chunting&f."
		"    It guarantees &6secondary drops&f"
		"            From &eanimals&f, making"
		"       &bResources&f easier to gather,"
		"     And can even obtain &aHoglin Ham&f"
		"   From the &4dangerous beasts&f of the"
		"          &cNether&f. It also carries"
		"  A special &denchantment&f that rewards"
		"            &6Attacks from behind&f,"
		"   Helping you finish off &cprey&f quickly."
		"                  Claim your"
		"       &eFirst knife&f and keep it close!"
	]
	quest.7C91BCDCF2DA30C7.quest_subtitle: "Basic Knife"
	quest.7D0AF4D7F4F988F9.quest_desc: [
		"   In &6birch forests&f you may find the"
		"           Unusual &6Honey Golem&f"
		"              A &aliving guardian&f"
		"             In a &ebeehive&f shape"
		"              &eBees&f live inside it"
		"           Helping produce &ahoney&f"
		"           It throws &ehoney drops&f"
		"  Dealing &cdamage&f and Heavy Slowness&f"
		"      &bRestore&f it with honey bottles&f"
		"             A &dsticky protector&f"
		"              Ready for &6battle&f"
	]
	quest.7D0AF4D7F4F988F9.quest_subtitle: "Little Honey"
	quest.7D9B4C3C25E12B01.quest_desc: ["&fSome tools, weapons and armor may no longer be worth using, but their &aEnchantments &fcan still be far too valuable to lose. With the right table, you can extract enchantments from damaged equipment or enchanted books and preserve them for future upgrades. Use it wisely whenever an old item still holds something &aprecious."]
	quest.7D9B4C3C25E12B01.quest_subtitle: "&7Separate valuable enchantments from your gear"
	quest.7D9B4C3C25E12B01.title: "&5&lQuest: &r&eRecover Lost Enchantments"
	quest.7DE39392772245BB.quest_desc: [
		"     Now we can have new &asnowmen&f"
		"              I do not know why"
		"           The &6original&f is enough"
		"              &b#TeamOriginalSnow&f"
	]
	quest.7DE39392772245BB.quest_subtitle: "Didn't we already have a snowman?"
	quest.7E1317F829843F18.quest_subtitle: "&7Create a Base Ingredient"
	quest.7EA197B2B0642250.quest_desc: [
		"    Farming in the &cNether&f requires a"
		"            &dFull adaptation&f to its"
		"             &eHostile environment&f"
		"     &6Resurgent Soil&f can be tilled with"
		"      A &ehoe&f and used for &acultivation&f"
		"    Instead of &bwater&f, this special soil"
		" Must be &chydrated with lava&f to function"
		"   Get this &6special block&f and learn to"
		"  Maintain &afarms&f in &4extreme Conditions&f"
	]
	quest.7EA197B2B0642250.quest_subtitle: "&7Adapt Farming to The Nether"
	quest.7F06049C2DCA2EDA.quest_desc: [
		"  We need &6great lighting&f in our &dhouse&f"
		"We can create &emany types of lanterns&f"
		"    That help &billuminate&f and &adecorate&f"
	]
	quest.7F06049C2DCA2EDA.quest_subtitle: "And let there be light."
	quest.7F22E9A3B0E7107A.quest_subtitle: "&7Cook the Processed Ingredient"
	quest.7F2D2C4E11CF7FDE.quest_desc: [
		"            To finish our &dhouse&f"
		"           We can create &6roofs"
		"   And make our house &amore beautiful&f"
	]
	quest.7F2D2C4E11CF7FDE.quest_subtitle: "We can create Roofs"
