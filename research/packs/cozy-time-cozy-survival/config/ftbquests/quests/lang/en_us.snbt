	file.0000000000000001.title: " &l&aCozy Time"
	quest.01434A0C003A6E6B.quest_desc: ["&fA family begins to take shape with the arrival of a child. This new life marks the start of something greater, a future built on everything you have created so far. Raising a child is both a responsibility and a reward, bringing warmth and meaning to your home. Welcome your first &achild &fand begin this new journey."]
	quest.01434A0C003A6E6B.quest_subtitle: "&7Welcome your first child"
	quest.01434A0C003A6E6B.title: "&5&lQuest: &r&eA New Generation"
	quest.02A4881A71332C1A.quest_subtitle: "&7Process And Use The Hide"
	quest.0333C17C99311D8C.quest_desc: ["&fOtters can be found in rivers and lakes, always searching the water for fish to eat. They cannot be tamed, but they can be bred with raw salmon or cod, and they especially love &aOysters. &fIf you feed one an oyster, it may break it open and reveal a precious &aPearl, &fwhich can be used for something far more valuable than simple treasure."]
	quest.0333C17C99311D8C.quest_subtitle: "&7Watch the otter and learn its favorite treat"
	quest.0333C17C99311D8C.title: "&5&lQuest: &r&eRiverside Fisher"
	quest.03DEA82138FB5738.quest_desc: ["&fSome relationships grow into something much stronger over time. After building trust and forming a deep connection, you may choose to take the next step and unite your lives. Marriage is more than a title, it is a bond built on &atrust &fand commitment. Find the right person and begin a new chapter together."]
	quest.03DEA82138FB5738.quest_subtitle: "&7Marry the one you trust the most"
	quest.03DEA82138FB5738.title: "&5&lQuest: &r&eA Lifelong Promise"
	quest.03E24A6C5ABB4BA2.quest_subtitle: "&7Process the Fish Into Usable Parts"
	quest.045E40157368CD46.quest_subtitle: "&7Process Meat for Advanced Recipes"
	quest.052E2A56705C8C00.quest_subtitle: "&7Cook a Balanced Nether Stew"
	quest.0537E7C1FFEB24AE.quest_subtitle: "&7Prepare a Regenerative Dish"
	quest.05404C814F3DD488.quest_desc: [
		"   We can use the &6lattice&f for &bclimbing&f"
		"          And making &adecorations&f"
	]
	quest.05404C814F3DD488.quest_subtitle: "Going up"
	quest.05512817EEFEF336.quest_subtitle: "&7Obtain a Rare Ocean Ingredient"
	quest.06DE72D81761D4FF.quest_desc: [
		"          &6Ghasts&f are dangerous"
		"             &cFlying creatures"
		"           That roam the vast"
		"         Dimensions of the &cnether&f"
		"          &bDefeating one&f will grant"
		"            You &aunique materials"
		"          That are essential for"
		"             &dAdvanced recipes&f"
		"           &bHunt&f down a &6Ghast&f to"
		"   Collect these &evaluable resources"
		"     And master your &acooking skills&f"
	]
	quest.06DE72D81761D4FF.quest_subtitle: "&7Defeat a ghast to obtain materials"
	quest.06DE72D81761D4FF.title: "Ghast"
	quest.0794B410EE871A95.quest_subtitle: "&7Prepare a Light Snack"
	quest.07E6B2B8B62863E2.quest_desc: ["&fIn this world you will come across many unfamiliar creatures, plants and dangers. With a &aSpyglass &fyou can observe them from a safe distance and slowly learn more about what surrounds you. Point it at a plant, animal or monster and study it until the discovery is &aregistered &fin your guide."]
	quest.07E6B2B8B62863E2.quest_subtitle: "&7Use a spyglass to discover the world around you"
	quest.07E6B2B8B62863E2.title: "&5&lQuest: &r&eA Curious Gaze"
	quest.08389BD302F76D97.quest_subtitle: "&7Process Tentacles"
	quest.086A6C1EE2255376.quest_desc: [
		"     With a &acutting board&f and a &aknife&f"
		"         You process &6ingredients&f"
		"   Improve your &befficiency&f by turning"
		"          &eMeats&f into smaller cuts"
		" This process can &6double your output&f"
		"              For many &erecipes&f"
		"          It works with &eham&f, &ecakes&f"
		"            &eMelons&f and much more"
		" This is one of the most &avaluable tools&f"
		"                In your &dkitchen&f"
		"            Craft a &acutting board&f"
		"  And start preparing &6food&f properly!"
	]
	quest.086A6C1EE2255376.quest_subtitle: "Process Ingredients"
	quest.08FA93F26CBA0300.quest_subtitle: "Strider Egg"
	quest.095EA5D451E5BB61.quest_desc: [
		"            In &bsnowy biomes&f you"
		"                 May find the"
		"           Adorable &9shima enaga&f"
		"                A tiny bird&f and"
		"          Gentle &cflight companion&f"
		"         Though small and fragile"
		"          It adds &6warmth and Life&f"
		"     To even the &dcoldest journeys&f"
		"             Offer some &eseeds&f"
		"        To gain a &acharming friend&f"
		"             That will &bfollow you&f"
		"             Through the &cfrost&f"
	]
	quest.095EA5D451E5BB61.quest_subtitle: "Little Bird"
	quest.0ABE414A8AAEC755.quest_desc: [
		"            Near &0coal ore veins&f"
		"              You may find the"
		"               Small &6Coal Golem&f"
		"            Tiny and &4dangerous&f"
		"                With low health&f"
		"               &bLight it&f with &eflint&f"
		"               Or walk into fire&f"
		"            For a flaming attack&f"
		"           It &bcharges&f the enemy"
		"          A &6powerful final strike&f"
		"               But it &csacrifices&f"
		"            Itself in the process"
	]
	quest.0ABE414A8AAEC755.quest_subtitle: "Fuel Golem"
	quest.0C695E4CD05B78C2.quest_desc: [
		"       &dThe End&f offers access to"
		"    Some of the most &aunusual and"
		"           Powerful ingredients"
		"            Found in the world"
		"  Among them, &6Dragon Meat&f stands out"
		"        As an &eessential component"
		"        For many &dadvanced dishes&f"
		"  These meals provide &astrong effects"
		"             And &bhigh saturation"
		"          Making them deal for the"
		"        &cMost challenging situations&f"
		"        Explore these &6recipes&f and"
		"  Master the &aart of end-game cooking"
		"   To complete your ultimate journey"
	]
	quest.0C695E4CD05B78C2.quest_subtitle: "&7Prepare Rare Meals From the End"
	quest.0E3076BCDDF186D8.quest_desc: [
		"       &fTraveling the world can be"
		"         &aMuch easier&f! By building"
		"    &6Proper roads &fbetween key sites,"
		"       &fYou create &breliable routes&f."
		"    &fUse a &echarting map &fto trace the"
		"         Path and connect it to a"
		"     &6Signpost &fat the end. Once the"
		"   &fNetwork is set, you can &atransport"
		"       &aInstantly &fbetween the linked"
		"                  &fSignposts!"
	]
	quest.0E3076BCDDF186D8.quest_subtitle: "Creating Routes"
	quest.0E6B9519FDC666FF.quest_desc: [
		"        The more &chearts&f we have"
		"              With our &bfriends&f"
		"  The &astronger&f our &6friendship&f will be"
		"         Reach &c200 hearts&f with a"
		"               &dFriend of yours&f"
	]
	quest.0E6B9519FDC666FF.quest_subtitle: "A Stronger Friendship"
	quest.0E6B9519FDC666FF.title: "Best Friends"
	quest.0F136EDC41B6D2E0.quest_subtitle: "&7Cook a Powerful Spicy Meal"
	quest.0F8D2D144318BAB1.quest_desc: ["&fBy placing an enchanted item on the table, its magical properties can be moved into a regular &aBook, &fturning the enchantments into something you can store or reuse later. The original item will remain behind without its enchantments, making this especially useful for worn tools or outdated gear. Each use always costs &a5 XP Levels, &fso choose carefully when recovering your best enchantments."]
	quest.0F8D2D144318BAB1.quest_subtitle: "&7Transfer enchantments back into books"
	quest.0F8D2D144318BAB1.title: "&5&lQuest: &r&eA Second Life for Magic"
	quest.0FE3CBB2665E1CEC.quest_desc: [
		"            &fWe can organize our"
		"      &bItems better&f! Craft a &6Backpack"
		"           &fAnd &aequip it &ffor more"
		"          &fSpace. But &estay sharp&f:"
		"          &fSet your &9binds B and V"
		"        &fTo access your backpack!"
	]
	quest.0FE3CBB2665E1CEC.quest_subtitle: "Storing More Items"
	quest.10900A4D08021E6A.quest_desc: ["&fAt the peak of your journey lies the rank of &aMonarch, &fthe highest authority a village can recognize. By building a thriving settlement and earning the trust of many, you gain full control over its direction. From assigning roles to villagers to shaping the entire community, you now rule with absolute &apower &fand responsibility."]
	quest.10900A4D08021E6A.quest_subtitle: "&7Reach the highest rank and command your people"
	quest.10900A4D08021E6A.title: "&5&lQuest: &r&eRuler of the Realm"
	quest.11830A7B34CCF549.quest_desc: [
		"              &fHello, &afriend&f! Welcome to"
		"               &fthis &ahappy world&f. Here, we"
		"               &fcan have our &6family&f, our"
		"               &6house&f, and our &6friends&f."
		"               &fThis world is full of &btools"
		"                &fand &bspecial skills &fthat"
		"                &fwill help you on your &ejourney&f!"
	]
	quest.11830A7B34CCF549.quest_subtitle: "&7Check and configure your keybindings"
	quest.11830A7B34CCF549.title: "&5&lQuest: &r&eBefore You Begin"
	quest.11B662822EF3F3C4.quest_desc: ["&fAmong the plants and foliage, you may spot strange little creatures that look almost like moving leaves. These insects appear in &athree colors, &fincluding yellow, green and orange, and while they cannot be tamed or bred, they have a charming secret of their own. Play some &amusic &fnear them and watch them begin to dance."]
	quest.11B662822EF3F3C4.quest_subtitle: "&7Find the insects that dance to music"
	quest.11B662822EF3F3C4.title: "&5&lQuest: &r&eLiving Leaves"
	quest.11D60C02303644EE.quest_subtitle: "&7Finish the Dish Using The Pan"
	quest.12A4C037DC1CC910.quest_subtitle: "&7Process Chorus Fruit"
	quest.12A5A0590639693E.quest_desc: [
		"       To start forming our &dfamily&f"
		"         We need to find a &6village&f"
		"    We can use an &aexplore compass&f"
		"      To find villages &bmore quickly&f"
		"   &6Villages&f are places where &dfamilies"
		"         Dwell and have &amore life&f"
		"   You can meet the &einhabitants&f and"
		"         Start your &dgreat family&f"
	]
	quest.12A5A0590639693E.quest_subtitle: "Visiting a Village"
	quest.12A5A0590639693E.title: "Village"
	quest.12B5AFE4A650C22B.quest_desc: ["&fIn snowy biomes you may come across the adorable &aShima Enaga, &fa tiny bird that can become a gentle flying companion. Though small and fragile, it adds warmth and life to even the coldest journeys. Offer it some &aSeeds &fand you may gain a charming little friend to follow you through the frost."]
	quest.12B5AFE4A650C22B.quest_subtitle: "&7Find a tiny friend in frozen lands"
	quest.12B5AFE4A650C22B.title: "&5&lQuest: &r&eA Snowy Songbird"
	quest.12F010EB32EFB6DE.quest_desc: [
		"             We can make &6pavings&f"
		"           And create &broad paths&f"
	]
	quest.12F010EB32EFB6DE.quest_subtitle: "Roads"
	quest.132E4426D05F1D6B.quest_desc: [
		"         We can make &6metal gates&f"
		"        To &amatch&f with our &bfences&f"
	]
	quest.132E4426D05F1D6B.quest_subtitle: "More Gates"
	quest.1341B0D110E82BA5.quest_desc: [
		"          &6Otters&f can be found in"
		"              &bLakes and rivers&f"
		"           Always searching for"
		"              Some &bfish&f to eat"
		"          They cannot be &atamed&f"
		"           But they can be &6bred&f"
		"             With &csalmon&f or &ccod&f"
		"      They especially love &aoysters&f"
		"            Feed them an &eoyster&f"
		"            And they may &breveal&f"
		"              A &aprecious pearl&f"
		"      Something much more &dvaluable&f"
		"          Than a simple &6treasure&f"
	]
	quest.1341B0D110E82BA5.quest_subtitle: "Pearl"
	quest.1341B0D110E82BA5.title: "Otter"
	quest.1356ED9CC450A9D0.quest_subtitle: "&7Prepare a Light but Filling Snack"
	quest.143A152820D9BF97.quest_desc: [
		"    When you have everyone's &2trust"
		"     And build a &bprosperous village&f"
		"              With &egreat wealth"
		" You become a &6monarch&f of the village"
		"   You become the &9ultimate authority"
		"           And gain &btotal control&f"
		"     Being able to assign roles and"
		"       &aShape the entire community&f"
	]
	quest.143A152820D9BF97.quest_subtitle: "Supreme Authority"
	quest.143A152820D9BF97.title: "Monarch"
	quest.14621D84F7F7BCC3.quest_desc: ["&fAs your reputation grows, your role within the village begins to change. Becoming a &aMerchant &fmeans you are no longer just a visitor, but someone who contributes to the flow of resources and trade. At this stage, you gain the ability to influence aspects such as &ataxes, &fhelping shape how the village manages its wealth and growth."]
	quest.14621D84F7F7BCC3.quest_subtitle: "&7Begin influencing the village economy"
	quest.14621D84F7F7BCC3.title: "&5&lQuest: &r&eVillage Merchant"
	quest.147D0B5B6563AD63.quest_subtitle: "&7Obtain a Flexible Ocean Ingredient"
	quest.1484DC4BDE0227B3.quest_subtitle: "&7Refine a Valuable Resource"
	quest.14B2C933C236E02F.quest_subtitle: "Eggs!"
	quest.14B2C933C236E02F.title: "&5&lQuest: &r&eEgg Sandwich"
	quest.14B484581D3842B3.quest_subtitle: "&7Defeat an Elder Guardian"
	quest.14B484581D3842B3.title: "Kill Elder Guardian"
	quest.15F60909C206CC4C.quest_desc: ["&fReaching the rank of &aMayor &fplaces the future of the village in your hands. With enough trust, population and development, you can begin to define how the community operates, setting important rules that affect daily life. From managing relationships to organizing the settlement, you now stand as the true &aleader &fof your people."]
	quest.15F60909C206CC4C.quest_subtitle: "&7Take control of the village's direction"
	quest.15F60909C206CC4C.title: "&5&lQuest: &r&eLeader of the People"
	quest.162F90DC816988FA.quest_desc: ["&fBridges are a fundamental part of building, allowing you to connect different areas while improving the look of your world. You can craft them using many types of wood or even stone, adapting their design to your environment. Build one and start shaping your &aworld."]
	quest.162F90DC816988FA.quest_subtitle: "&7Connect your builds with style"
	quest.162F90DC816988FA.title: "&5&lQuest: &r&eBridges"
	quest.163C59F9A4D3ED33.quest_desc: [
		"    &6Striders&f are useful creatures"
		"              Found across the"
		"          &cLava lakes of the nether&f"
		"       By defeating one with a &eknife"
		"  You can obtain &aspecial ingredients"
		"                 For recipes"
		"        &bHunt&f one down and collect"
		"          &eValuable resources&f for"
		"          Your culinary journey"
	]
	quest.163C59F9A4D3ED33.quest_subtitle: "Defeat Strider"
	quest.163C59F9A4D3ED33.title: "Strider"
	quest.177A5EEA92C7F03A.quest_desc: [
		"    We can put a &6picture&f on the &dwall&f"
		"             With these &apaintings&f"
	]
	quest.177A5EEA92C7F03A.quest_subtitle: "Picture"
	quest.177A5EEA92C7F03A.title: "Frames"
	quest.17C46EFB82428225.quest_desc: [
		"           Deep within the &dswamps&f"
		"             The &2Slime Golem&f can"
		"             Be found &bdefending&f"
		"             Its &ddamp home&f from"
		"               &cHostile intruders&f"
		"       It may look &asoft and harmless&f"
		"        But it's a &6capable protector&f"
		"          When &cmonsters&f get close"
		"            If hurt, use &eslimeballs&f"
		"              To help it &brecover&f"
		"             And keep on fighting&f"
	]
	quest.17C46EFB82428225.quest_subtitle: "A Clingy Friend"
	quest.17DC46D868550BFB.quest_subtitle: "&7Create a Shareable Dish"
	quest.18461F67E0F09536.quest_desc: [
		"            The &6Straw Golem&f can"
		"             Spawn in &evillages&f or"
		"             Be manually created&f"
		"            A dedicated &dprotector&f"
		"                 For your &afarm&f"
		"             It watches the fields&f"
		"             And protects the soil&f"
		"              From being &cdamaged&f"
		"                It can be &bhealed&f"
		"                Using only &ewheat&f"
		"                A &asimple ally&f for"
		"            Any growing &6settlement&f"
	]
	quest.18461F67E0F09536.quest_subtitle: "Farm Protector"
	quest.197F3B16E2DB9CAF.quest_desc: ["&fFrames are decorative portraits that add personality to your interiors. They are perfect for placing above wooden drawers or on shelves, helping to complete your design. You can place and remove them to change the displayed image, allowing for dynamic and customizable &adecorations."]
	quest.197F3B16E2DB9CAF.quest_subtitle: "&7Decorate with style and variety"
	quest.197F3B16E2DB9CAF.title: "&5&lQuest: &r&eFrames"
	quest.1A7233C5D44F93F2.quest_desc: ["&fForged from four blocks of &aAncient Debris &fand brought to life with a carved pumpkin, the Netherite Golem is one of the strongest companions you can create. You can ride it into battle and press jump to unleash a devastating &aground slam, &fbut its true power comes from lava. Fill its stomach with a lava bucket, then press &aR &fto release small flames that seek out nearby enemies and set them ablaze. Be careful in the rain, as carrying lava will cause it harm."]
	quest.1A7233C5D44F93F2.quest_subtitle: "&7A powerful mount forged from ancient debris"
	quest.1A7233C5D44F93F2.title: "&5&lQuest: &r&eNetherite Golem"
	quest.1AA516E728E41BEB.quest_subtitle: "&7Cook a Powerful Meal"
	quest.1BBCDC6AFC34EA3A.quest_desc: [
		"      What seems like common &2grass&f"
		"     Can become a &buseful resource&f"
		"          By breaking &2tall frass"
		"           You can collect straw&f"
		"    It is used for &6rope&f, &9safety nets&f"
		"          Cloth&f and &estraw blocks&f"
		"       Gather some &6straw&f now and"
		"      Prepare for &bfuture crafting&f"
		"           Start your &ahourney&f"
		"  By collecting this essential material!"
	]
	quest.1BBCDC6AFC34EA3A.quest_subtitle: "Straw?"
	quest.1BDAFBBB066AABBA.quest_desc: ["&fSnowmen are a classic symbol of winter and holiday celebrations. You can craft different variants, each with unique outfits and expressions, making them perfect for festive decorations. Build one and bring a joyful &aholiday spirit &fto your world."]
	quest.1BDAFBBB066AABBA.quest_subtitle: "&7Celebrate the winter season"
	quest.1BDAFBBB066AABBA.title: "&5&lQuest: &r&eSnowmen"
	quest.1BEC4FE79FDF189A.quest_desc: ["&fMetal fence gates complement metal fences by providing controlled access while maintaining a clean and modern look. Although there are only a few designs available, each one fits perfectly with contemporary builds. Place one and complete your &amodern structures."]
	quest.1BEC4FE79FDF189A.quest_subtitle: "&7Complete your modern designs"
	quest.1BEC4FE79FDF189A.title: "&5&lQuest: &r&eMetal Fence Gates"
	quest.1C588B310F53870B.quest_desc: ["&fWhen building large structures or planning detailed layouts, knowing the exact distance between two points can save both time and materials. A &aMeasuring Tape &flets you check the space between blocks with precision, making it much easier to design roads, rooms and decorative projects. Craft or obtain one and use it whenever a build needs more &aaccuracy."]
	quest.1C588B310F53870B.quest_subtitle: "&7Plan your builds with exact distances"
	quest.1C588B310F53870B.title: "&5&lQuest: &r&eMeasure with Precision"
	quest.1C670E64C533318F.quest_desc: [
		"        We can use the &6candelabra&f"
		"      To make a &bdarker environment&f"
		"            however &cwithout mobs&f"
	]
	quest.1C670E64C533318F.quest_subtitle: "Creating Candles"
	quest.1C670E64C533318F.title: "Candelabra"
	quest.1C8A5D576B84C8F9.quest_desc: ["&fSome familiar resources gain new value in different environments. &aMagma Cream &fmay not be new, but it plays an important role in preparing several Nether dishes. Gather some and keep a good supply of this versatile &aingredient."]
	quest.1C8A5D576B84C8F9.quest_subtitle: "&7Gather a useful nether resource"
	quest.1C8A5D576B84C8F9.title: "&5&lQuest: &r&eMagma Cream"
	quest.1E15D3B82D207215.quest_desc: [
		"        Building a &6relationship&f is a"
		"            &bVery important&f step"
		"        Spend some &etime together"
		"   And create &abonds and connections&f"
		"        You can build a &dtrue family&f"
	]
	quest.1E15D3B82D207215.quest_subtitle: "Creating Bonds"
	quest.1E15D3B82D207215.title: "Building a Relationship"
	quest.1E688603C2A2FA59.quest_desc: ["&fNot every path needs to be mined open. By pressing &aC &for the key you have assigned, you can crawl through spaces only one block high, making it much easier to slip into narrow tunnels, hidden gaps or unfinished passages. This can save both &adurability &fand time when exploring or working in tight areas."]
	quest.1E688603C2A2FA59.quest_subtitle: "&7Crawl into places you normally could not reach"
	quest.1E688603C2A2FA59.title: "&5&lQuest: &r&eMove Through Tight Spaces"
	quest.1EB976803982B10E.quest_subtitle: "&7Cook a Strange End Ingredient"
	quest.1FD37614E675E0E6.quest_desc: [
		"         &fHello, &afriend&f! Welcome to"
		"       &fThis &ahappy world&f. Here, we"
		"         Can have our &6family&f, our"
		"          &6House&f, and our &6friends&f."
		"         &fThis world is full of &btools"
		"           And &bspecial skills &fthat"
		"      Will help you on your &ejourney&f!"
	]
	quest.1FD37614E675E0E6.quest_subtitle: "First steps"
	quest.1FD37614E675E0E6.title: "Starting the Adventure"
	quest.202BF9FDE5B18397.quest_desc: [
		"      One of the &bbest parts&f of our"
		"    Lives is the &6birth of our children&f"
		"        After having a &astable and"
		"             Happy relationship&f"
		"       We can have our &dfirst child&f"
	]
	quest.202BF9FDE5B18397.quest_subtitle: "The Firstborn"
	quest.202BF9FDE5B18397.title: "Children"
	quest.211639665600D5ED.quest_desc: [
		" As we increase the amount of &etrades&f"
		"    You can obtain the rank of &6noble&f"
		"              Within the villages"
		"        With this level of &binfluence&f"
		"     You can guide &apopulation growth&f"
		"              And &9organization&f."
		"       Now everyone &brespects&f you"
	]
	quest.211639665600D5ED.quest_subtitle: "Having Greater Influence"
	quest.211639665600D5ED.title: "Noble"
	quest.215D8BB0FF8E6104.quest_subtitle: "&7Hunt a Cod Using a Knife"
	quest.215D8BB0FF8E6104.title: "Kill Cod"
	quest.21616D4D9D1B74E9.quest_desc: ["&fLighting plays a key role in the atmosphere of your builds. Lanterns come in many styles, including ceiling, wall and tabletop variants. Ceiling lanterns offer colorful and modern designs, while wall lanterns provide a more classic and medieval look. Place them and bring life to your &ainteriors."]
	quest.21616D4D9D1B74E9.quest_subtitle: "&7Light up your interiors"
	quest.21616D4D9D1B74E9.title: "&5&lQuest: &r&eLanterns"
	quest.21FB233DD7994AAB.quest_desc: ["&fPumpkin heads are a classic decoration for Halloween. With different carved faces and variants both with and without light, they are perfect for creating a spooky environment. Place them and give your builds a true &aeerie &fappearance."]
	quest.21FB233DD7994AAB.quest_subtitle: "&7Set a spooky atmosphere"
	quest.21FB233DD7994AAB.title: "&5&lQuest: &r&ePumpkin Heads"
	quest.235A356E70F144A6.quest_desc: [
		"     We can use &6bridges&f to link our"
		"            &dhouse&f across &blakes&f"
		"   Or just use them for &adecorations&f"
	]
	quest.235A356E70F144A6.quest_subtitle: "Connecting Bridges"
	quest.236F20189251101F.quest_desc: [
		"          These &6jumping spiders&f"
		"            Are much &afriendlier&f"
		"             Than they &6appear&f"
		"           Becoming &dcompanions"
		"            Surprisingly &auseful&f"
		"           Found near &6cocoons&f"
		"             With &erandom items&f"
		"               And &aspider silk&f"
		"            They can be &btamed&f"
		"            With &edragonfly wings&f"
		"             Once &dloyal&f to you"
		"           They will &bdefend&f you"
		"           From nearby &cenemies&f"
	]
	quest.236F20189251101F.quest_subtitle: "Spiderman?"
	quest.245D200B31809FAC.quest_desc: [
		"     We can give a &6ring&f to someone"
		"      We like and &dpropose&f to them"
		"            The &ararer&f the ring"
		"   The &bhappier&f your partner will be"
		"   &dMarriage&f is a &bvery important&f part"
		"         Where &aeverything begins&f"
	]
	quest.245D200B31809FAC.quest_subtitle: "Living in the Moments"
	quest.245D200B31809FAC.title: "Marriage"
	quest.2487E0CFBFD9C40B.quest_subtitle: "&7Collect a Rare Dragon Material"
	quest.24C1167012D2A04D.quest_desc: ["&fChandeliers are perfect for adding elegance and a medieval touch to your interiors. With candles of different colors, they allow you to customize the atmosphere of your builds. Place one and give your home or castle a more &aclassic &fappearance."]
	quest.24C1167012D2A04D.quest_subtitle: "&7Create a medieval atmosphere"
	quest.24C1167012D2A04D.title: "&5&lQuest: &r&eChandeliers"
	quest.24E14A217F2E74D3.quest_desc: ["&fAmong the oceans you may find the unusual &aSea Bunny, &fa creature that cannot be tamed or bred but offers something truly special. It produces slime that can be collected with glass bottles, and by combining four filled bottles you can create a &aSlime Block. &fThis strange block can be climbed through and passed through, though it behaves very differently from the slime you may already know."]
	quest.24E14A217F2E74D3.quest_subtitle: "&7Harvest a strange gift from the ocean"
	quest.24E14A217F2E74D3.title: "&5&lQuest: &r&eThe Slime of the Sea"
	quest.25CC73AD2C69EE2B.quest_desc: ["&fMetal fences offer a more modern alternative to traditional designs. While there are fewer variations, their clean and structured look makes them perfect for contemporary builds. Use them to give your constructions a more &amodern &fappearance."]
	quest.25CC73AD2C69EE2B.quest_subtitle: "&7Add a modern touch to your builds"
	quest.25CC73AD2C69EE2B.title: "&5&lQuest: &r&eMetal Fences"
	quest.25D496B2E2984B3A.quest_desc: ["&fBuilt from blocks of kelp and a sea lantern, the &aKelp Golem &fcomes to life without needing a carved pumpkin at all. It is a sturdy underwater defender, well suited for protecting oceans, rivers or submerged bases, and can be repaired using more &aKelp. &fIf it stands near an activated catalyst, its power will grow even stronger, making it an even greater force beneath the waves."]
	quest.25D496B2E2984B3A.quest_subtitle: "&7A strong guardian of the deep"
	quest.25D496B2E2984B3A.title: "&5&lQuest: &r&eKelp Golem"
	quest.25E22AB9007A85AB.quest_desc: ["&fThe Nether allows for more extreme cooking methods. The &aBurnt Roll &fis a dish that makes use of intense heat and special ingredients to create a powerful meal. Prepare one and expand your collection of &anethern dishes."]
	quest.25E22AB9007A85AB.quest_subtitle: "&7Cook a nether-style dish"
	quest.25E22AB9007A85AB.title: "&5&lQuest: &r&eBurnt Roll"
	quest.25F7BACEA2E410B6.quest_subtitle: "Chickens!"
	quest.25F90744B593FD3D.quest_desc: [
		"       We have &6several new fences"
		"                  To explore"
		"         Let's &bexplore the fences&f"
		"    To make &aeverything more beautiful&f"
	]
	quest.25F90744B593FD3D.quest_subtitle: "New Fences"
	quest.26E7675F26B2ACDA.quest_desc: [
		"         The &6Dumbo Octopus&f is a"
		"         &aPeaceful&f creature that"
		"        Cannot be &btamed&f or bred"
		"         But its presence is still"
		"            &dIncredibly valuable&f"
		"            Near it &bunderwater&f"
		"       It will create an &aair bubble&f"
		"            Around your head"
		"         Helping you to &bbreathe&f"
		"            And avoid &cdrowning&f"
		"            Keep an eye on this"
		"           Small and &6strange ally&f"
	]
	quest.26E7675F26B2ACDA.quest_subtitle: "Dumbo? With the big ears?"
	quest.29077B3D845F23A3.quest_desc: [
		"       &6Rope&f is a &6simple and useful&f"
		"      Way to move between &eheights&f"
		"        Travel without relying on"
		"      &cBulky staircases&f or &cladders&f"
		"      Perfect for &atreehouses&f and"
		"       Interiors in a &dcreative way&f"
		"        Craft some &6rope&f and make"
		"       &bVertical travel&f much easier"
		"        Transform your &dbuilds&f with"
		"     This natural and &aaesthetic&f tool!"
	]
	quest.29077B3D845F23A3.quest_subtitle: "Climb"
	quest.29153A6C06FEE973.quest_desc: [
		"   Building in &ehigh places&f is &crisky&f and"
		"           Can cost your &4health&f"
		"       A &6safety net&f can catch your"
		"         &eFall&f and &bprevent damage&f"
		"       Work on &6tall structures&f and"
		"    &6Vertical builds&f with peace of mind"
		"      Craft a &asafety net&f to protect"
		"      Your most &dambitious projects&f"
		"      Add &bextra protection&f beneath"
		"      Your constructions right now!"
	]
	quest.29153A6C06FEE973.quest_subtitle: "A Softer Landing"
	quest.29D436EB8AE8002C.quest_desc: [
		"             Made of &ehoneycomb&f"
		"               And some string&f"
		"            The &6Candle Golem&f may"
		"            Look &aharmless&f at first"
		"          But it's a &duseful defender&f"
		"             Wake it up&f with a click"
		"                Command it to sit&f"
		"              Use &eflint and steel&f"
		"              To shoot fireballs&f"
		"              &bRepair&f it with &ehoney&f"
		"               To keep its &cflame&f"
		"                Always &cburning&f"
	]
	quest.29D436EB8AE8002C.quest_subtitle: "Velinha"
	quest.2A35D875BA427140.quest_desc: [
		"    There are times when we need to"
		"                 &bSit and think&f"
		"  We can &acreate chairs&f to &6think better&f"
	]
	quest.2A35D875BA427140.quest_subtitle: "There are no tables without chairs."
	quest.2A651FB59DBBF64B.quest_subtitle: "&7Create a Refined Seafood Dish"
	quest.2A79117743BA6056.quest_desc: ["&fYour backpack can grow alongside your journey. By spending &aExperience &fyou can unlock additional storage slots, allowing it to hold more and more items over time. Keep in mind that each new upgrade will require even more &aXP, &fso choose carefully when to expand your backpack."]
	quest.2A79117743BA6056.quest_subtitle: "&7Use experience to unlock more backpack slots"
	quest.2A79117743BA6056.title: "&5&lQuest: &r&eExpand Your Storage"
	quest.2BBB0FB18A237481.quest_desc: ["&fNot all gifts are received the same way. Each villager has their own tastes, and discovering what they truly enjoy is key to building a deeper bond. Offering a &aperfect gift &fwill greatly strengthen your relationship and show that you truly understand them. Pay attention, choose carefully and give something they will &alove."]
	quest.2BBB0FB18A237481.quest_subtitle: "&7Give a gift they truly love"
	quest.2BBB0FB18A237481.title: "&5&lQuest: &r&eA Perfect Gift"
	quest.2BDA13186A5B1BD9.quest_desc: [
		"           We can have our &6Pets"
		"                 Our &bFriends&f"
		"           And they &eHelp Us&f and"
		"        Become &aFaithful Companions&f"
		"          Besides being &dVery Cute&f!"
	]
	quest.2BDA13186A5B1BD9.quest_subtitle: "Your Little Friend"
	quest.2BDA13186A5B1BD9.title: "Friends"
	quest.2C87F73971977050.quest_desc: [
		"            &fLike every &ebeginning&f,"
		"          We need to &6gather &fsome"
		"              &eWood &fto start our"
		"                  &aAdventure&f!"
	]
	quest.2C87F73971977050.quest_subtitle: "Starting from the Beginning"
	quest.2C87F73971977050.title: "Oak Log"
	quest.2CFB691F9A3EACA4.quest_desc: [
		"        &fIt's always good to &6gather"
		"       Some &eIron&f, both for &bfuture"
		"         &bRecipes &fand to &6upgrade"
		"                  Our &eTools&f!"
	]
	quest.2CFB691F9A3EACA4.quest_subtitle: "Collecting Iron"
	quest.2CFB691F9A3EACA4.title: "Iron Ingot"
	quest.2D055E011E3FDB12.quest_subtitle: "&7Process the Slab Into Usable Cuts"
	quest.2D738B2BC12EAB7A.quest_desc: ["&fPaths and pavements help define the exterior of your builds, making them feel more complete and connected. With many designs and materials available, you can match different colors and styles to fit your constructions. Create a path and improve the look of your &aoutdoor areas."]
	quest.2D738B2BC12EAB7A.quest_subtitle: "&7Design beautiful outdoor spaces"
	quest.2D738B2BC12EAB7A.title: "&5&lQuest: &r&ePaths and Pavements"
	quest.2D76923DD6CA201D.quest_subtitle: "&7Use It As a Special Material"
	quest.2EB1D983E13ABE9A.quest_desc: ["&fWalls serve a similar purpose to fences, but offer a more solid and refined look. They come in many stone variants, allowing you to match different architectural styles. Build with them and give your constructions a more &aelegant &fappearance."]
	quest.2EB1D983E13ABE9A.quest_subtitle: "&7Build with elegance and strength"
	quest.2EB1D983E13ABE9A.title: "&5&lQuest: &r&eWalls"
	quest.30749839049EA931.quest_desc: ["&fStairs are essential for moving between levels while also shaping the look of your interiors. There are many designs available, with or without railings, made from wood, stone or metal. From classic to modern styles, choose the one that best fits your build and connect your &aspaces."]
	quest.30749839049EA931.quest_subtitle: "&7Connect your spaces with style"
	quest.30749839049EA931.title: "&5&lQuest: &r&eStairs"
	quest.30A3FBB5A4074800.quest_desc: [
		"         Among plants&f and &afoliage&f"
		"                 You may spot"
		"                Moving leaves&f"
		"            Creatures in &agreen&f,"
		"             &eYellow&f and &6orange&f"
		"           They cannot be &btamed&f"
		"               But they have a"
		"               &dCharming secret&f"
		"                Play some &6music&f"
		"         Near them and watch them"
		"                &bStart to dance&f"
	]
	quest.30A3FBB5A4074800.quest_subtitle: "Dance"
	quest.31A046E8CD79C949.quest_desc: [
		"       To create &6giant structures&f,"
		"        Roads, or houses, we need"
		" &bMeasurements&f. Use the &eTape Measure"
		"       To measure &ablock distances"
		"                With precision!"
	]
	quest.31A046E8CD79C949.quest_subtitle: "Measuring Blocks"
	quest.31B22DFEE260ACF8.quest_desc: [
		"             Built with &2kelp blocks&f"
		"              And a &esea lantern&f"
		"            The &6Kelp Golem&f awakes"
		"             No &epumpkin&f is needed"
		"             A robust underwater&f"
		"          &aDefender&f for &boceans&f and"
		"               Submerged bases&f"
		"            &bRepair&f it with more &eKelp&f"
		"            Near an active &dconduit&f"
		"            Its &6power will increase&f"
		"          Becoming a &agreater force&f"
		"              Beneath the &bwaves&f"
	]
	quest.31B22DFEE260ACF8.quest_subtitle: "Kelp?"
	quest.31F4CB70125349AC.quest_desc: ["&fFerrets can be found in forested biomes, appearing in both brown and white variants. These clever little hunters prey on rabbits and chickens, which also happen to be the foods used to &atame &fand breed them. Once they trust you, feeding them again may encourage them to dig into the ground and uncover something &ahidden."]
	quest.31F4CB70125349AC.quest_subtitle: "&7A hunter with a nose for hidden treasures"
	quest.31F4CB70125349AC.title: "&5&lQuest: &r&eThe Curious Ferret"
	quest.33C62F743793AD10.quest_subtitle: "&7Hunt a Squid Using a Knife"
	quest.33C62F743793AD10.title: "Kill Squid"
	quest.343145D990B3F2C8.quest_subtitle: "Strider Slice"
	quest.3445B196ADF88C4C.quest_subtitle: "&7Obtain a Rare Endgame Ingredient"
	quest.34C82E9027F4A23F.quest_subtitle: "&7Cook a Powerful Nether Meal"
	quest.35A0A33F6503AEC1.quest_subtitle: "&7Obtain Materials With a Knife"
	quest.35A40300B28DBA89.quest_desc: ["&fMagma Cubes are dangerous creatures found in the Nether. Defeating one will grant you &aMagma Cream, &fa valuable ingredient used in several recipes. Hunt one down and secure this important &aresource."]
	quest.35A40300B28DBA89.quest_subtitle: "&7Defeat a magma cube"
	quest.35A40300B28DBA89.title: "&5&lQuest: &r&eMagma Core"
	quest.36FAF25CA86AEB33.quest_subtitle: "&7Obtain a Defensive Creature Resource"
	quest.37659CC7925D2609.quest_desc: ["&fThis world is full of unusual &acreatures, &feach with their own behaviors, favorite foods and hidden uses. Some can become loyal companions, others may help you gather rare materials, and a few offer special benefits simply by staying nearby. Take your time to observe them, learn their habits and uncover the many &asecrets &fthey bring to your adventure."]
	quest.37659CC7925D2609.quest_subtitle: "&7Discover the unique wildlife of this world"
	quest.37659CC7925D2609.title: "&5&lQuest: &r&eCreatures Great and Small"
	quest.37A28765A80E56D3.quest_desc: [
		"    We can also create &6metal fences&f"
		"      To change the &bstyle&f a bit and"
		"       &aMatch better&f with our &dhouse&f"
	]
	quest.37A28765A80E56D3.quest_subtitle: "Made of Metal?"
	quest.37F423012FB1318B.quest_desc: ["&fDoors are essential for any build, providing both access and style. There is a wide variety of designs available, from different types of wood to metal and even modern glass doors. Choose the one that best fits your construction and create an entrance that stands out in your &aworld."]
	quest.37F423012FB1318B.quest_subtitle: "&7Choose the perfect entrance"
	quest.37F423012FB1318B.title: "&5&lQuest: &r&eDoors"
	quest.3804390AAEE01D24.quest_desc: ["&fVillages are no longer just places to trade, but living communities filled with unique individuals, each with their own personality and role. By visiting a &aVillage, &fyou can begin to meet its inhabitants, learn how they live and take your first steps into a more connected and meaningful way of life. Find a village and start building your place within the &acommunity."]
	quest.3804390AAEE01D24.quest_subtitle: "&7Visit a village and meet its people"
	quest.3804390AAEE01D24.title: "&5&lQuest: &r&eA New Beginning"
	quest.3867455895F38055.quest_desc: ["&fSupports add depth and realism to your bridges, making them feel more solid and detailed. They can be crafted using different types of wood or stone, allowing you to match any design. Build supports for your bridge and improve both its structure and &aappearance."]
	quest.3867455895F38055.quest_subtitle: "&7Reinforce your constructions"
	quest.3867455895F38055.title: "&5&lQuest: &r&eBridge Supports"
	quest.392E0346D6A54B0B.quest_subtitle: "&7Defeat a Guardian With the Right Tool"
	quest.392E0346D6A54B0B.title: "Kill Guardian"
	quest.3AC3892A7B47B6C4.quest_desc: ["&fWith a &aCharting Map &fyou can trace a route along the roads you have built and turn simple paths into a real travel network. Once the route is complete, link it to a &asignpost &fat the end of the road, then add more signs along the way, even at intersections, to expand your network. Open the map to review every connected path and travel instantly between the linked signs."]
	quest.3AC3892A7B47B6C4.quest_subtitle: "&7Mark your roads and connect your destinations"
	quest.3AC3892A7B47B6C4.title: "&5&lQuest: &r&eChart the Route"
	quest.3C082863111FE304.quest_desc: [
		"            &6Ferrets&f are found in"
		"                &aForest biomes&f"
		"             In brown&f and white&f"
		"                Color variants"
		"            These &6smart hunters&f"
		"          Eat &erabbits&f and &echickens&f"
		"             Used to &bbreed&f them"
		"            Once they &dtrust You&f"
		"               Feed them again"
		"               To make them &bdig&f"
		"          And find something &6hidden&f"
	]
	quest.3C082863111FE304.quest_subtitle: "Cute Creatures"
	quest.3C082863111FE304.title: "Ferret"
	quest.3C12675B87BF9201.quest_desc: [
		"           We can make new &6walls&f"
		"              They are &aperfect&f"
		"        To put around our &dhouse&f"
	]
	quest.3C12675B87BF9201.quest_subtitle: "Walls and Walls"
	quest.3C9506ED0D2323BF.quest_desc: [
		"    To keep our &6bridge&f from falling"
		"We can place some &asupports&f beneath it"
	]
	quest.3C9506ED0D2323BF.quest_subtitle: "Helping the bridge"
	quest.3D90BC8733F33427.quest_subtitle: "Defeat Hoglin"
	quest.3D90BC8733F33427.title: "Hoglin"
	quest.3D9FCD96ADC52EC1.quest_desc: [
		"    Having a &6Second Child&f is perfect"
		"     For always having a &aFull House&f"
		"               And having your"
		"       &bLegacy&f preserved forever"
		"         Be &6Good Parents&f and an"
		"        &aExample&f for your &dChildren&f"
	]
	quest.3D9FCD96ADC52EC1.quest_subtitle: "Expanding the House"
	quest.3D9FCD96ADC52EC1.title: "The Second Child"
	quest.3F5B8FE2215D1009.quest_desc: [
		"           In this world there are"
		"               Many new &6golems&f"
		"               That can &bhelp us&f"
		"              They have &9special&f"
		"             &aAbilities&f, &cweaknesses&f"
		"              And also &4strengths&f"
		"           Made of &eunique material&f"
		"           Choose your &dcompanion&f"
		"             For every &6challenge&f"
	]
	quest.3F5B8FE2215D1009.quest_subtitle: "Golems!"
	quest.4042CB099F9221AF.quest_desc: ["&fFence gates allow you to control access to your builds while keeping a consistent design. They can be crafted using different types of wood, matching the style of your fences. Place one and create a proper &aentrance."]
	quest.4042CB099F9221AF.quest_subtitle: "&7Create functional entrances"
	quest.4042CB099F9221AF.title: "&5&lQuest: &r&eFence Gates"
	quest.409AAFA3EDF2C25D.quest_desc: ["&fThe silk found near jumping spider cocoons is more than just a curious material. It can be crafted into &aSilk Rope, &fa stronger alternative to normal rope that is far more reliable in dangerous situations. Unlike regular rope, it can be used not only with animals but also with &amonsters &for other hostile creatures."]
	quest.409AAFA3EDF2C25D.quest_subtitle: "&7Use spider silk for stronger bindings"
	quest.409AAFA3EDF2C25D.title: "&5&lQuest: &r&eSilk Stronger Than Rope"
	quest.437164949A4ACDD5.quest_desc: [
		"       &fOur &6Armor Stands &fhave been"
		"       &aImproved&f! After placing them"
		"       Down, use &bShift + Right Click"
		"          &fTo change &6poses&f, equip"
		"            &eHeld items&f, wear &ehats&f,"
		"                &fand much more!"
	]
	quest.437164949A4ACDD5.quest_subtitle: "Changing Poses"
	quest.448D06002B449509.quest_desc: ["&fCrafted from honeycomb and string, the &aCandle Golem &fmay look harmless at first, but it can become a surprisingly useful little defender. Once placed, you can wake it with a right-click, command it to sit, and even light it with flint and steel so it begins launching &afireballs &fat nearby enemies. If it is damaged, a bit of honeycomb will help repair it and keep its flame alive."]
	quest.448D06002B449509.quest_subtitle: "&7A small guardian with a fiery temper"
	quest.448D06002B449509.title: "&5&lQuest: &r&eCandle Golem"
	quest.466167B6BFE855EF.quest_desc: ["&fAs your home fills with life, your family continues to grow. Having a second child strengthens your household and creates a more lively and dynamic environment. With more voices, more stories and more shared moments, your home becomes something truly &aspecial. &fExpand your family and embrace the joy it brings."]
	quest.466167B6BFE855EF.quest_subtitle: "&7Expand your household"
	quest.466167B6BFE855EF.title: "&5&lQuest: &r&eA Growing Family"
	quest.46CE6E8DEED69490.quest_desc: ["&fTo begin measuring, right-click a block to set your first point, then move to another position and right-click again to complete the measurement. This will help you keep track of spacing while working on paths, walls or larger constructions. If you want to remove the marked distances, hold &aShift &fand right-click the ground while carrying the &aMeasuring Tape."]
	quest.46CE6E8DEED69490.quest_subtitle: "&7Use the tape to create and clear measurements"
	quest.46CE6E8DEED69490.title: "&5&lQuest: &r&eMark the Distance"
	quest.46FA8E51BBFED6C3.quest_desc: ["&fChairs are essential to make your interiors feel complete and lived in. There are many types available, including wooden chairs and upholstered variants in different colors. Choose the style that best fits your build and add a sense of &acomfort &fto your spaces."]
	quest.46FA8E51BBFED6C3.quest_subtitle: "&7Add comfort to your interiors"
	quest.46FA8E51BBFED6C3.title: "&5&lQuest: &r&eChairs"
	quest.4859EA65A5B60682.quest_desc: [
		"     A &dproper kitchen&f begins with a"
		"            &6Reliable heat source&f"
		"  The stove&f provides an &cinfinite flame"
		"         Essential for your &ameals&f"
		"  An &bimportant step&f towards building a"
		"          &6Complete kitchen&f setup"
		"     &bCraft&f a Stove today and unlock"
		"          &aFuture cooking recipes&f"
	]
	quest.4859EA65A5B60682.quest_subtitle: "Set Up The Stove"
	quest.48973A19902EB558.quest_desc: ["&fLattices are a simple yet elegant way to decorate your builds. While they share a similar design, they are available in many types of wood to match your style. They also allow you to climb them, making them both decorative and functional. Place them and enhance your &astructures."]
	quest.48973A19902EB558.quest_subtitle: "&7Decorate and climb with style"
	quest.48973A19902EB558.title: "&5&lQuest: &r&eLattices"
	quest.49015376942E36BA.quest_desc: ["&fEvery successful discovery will make a small sound, letting you know the information has been safely &asaved. &fAs your journey continues, this journal will become a valuable source of knowledge about creatures, bosses and useful resources. Press &aB &fto open your guide and review what you have learned."]
	quest.49015376942E36BA.quest_subtitle: "&7Review everything you have discovered"
	quest.49015376942E36BA.title: "&5&lQuest: &r&eYour Personal Journal"
	quest.49B7E3494B102E9A.quest_subtitle: "&7Craft a Unique Item"
	quest.49EFF193E01254D8.quest_subtitle: "&7Process It for Valuable Resources"
	quest.4AC74F199D37A120.quest_desc: [
		" The &6Cooking Pot&f is the &dheart of many"
		"     Advanced recipes&f and vital for"
		"          Preparing proper meals&f"
		"  Place it over a &eGrill&f or &cheat source"
		"     And interact to add &aingredients"
		"            For &bsoups and stews&f"
		"       With a &6wide variety of dishes"
		"   This tool will greatly expand your"
		"               &aCooking options&f"
		"        &bCraft&f a Pot now and start"
		"  Experimenting with new combinations"
		"               In your kitchen"
	]
	quest.4AC74F199D37A120.quest_subtitle: "A Pot Full Of Possibilities"
	quest.4B50D5493DE7E8AD.quest_subtitle: "&7Create a Complete and Nourishing Meal"
	quest.4BFB22E2690C9C7E.quest_desc: [
		"        The &adrawer&f unfortunately"
		" Is not our old acquaintance &edrawers&f"
		" However it is &6perfect&f for &ddecorations&f"
	]
	quest.4BFB22E2690C9C7E.quest_subtitle: "Compact Drawers? NO!"
	quest.4CBE85F01546896C.quest_subtitle: "&7Refine Ghast Materials"
	quest.4DB61D972DFCACBC.quest_desc: [
		"  You can win someone over with &egifts&f"
		"However everyone has their own &6taste&f"
		"  Not everyone likes &aflowers&f or &6ores&f"
		"       Discover what they like and"
		"         &bStrengthen the trust&f of"
		"              Your &drelationship&f"
		"         Choose something &aspecial&f"
	]
	quest.4DB61D972DFCACBC.quest_subtitle: "The Perfect Gift"
	quest.4DB61D972DFCACBC.title: "Conquering"
	quest.4ED379396081F4AC.quest_desc: [
		"     One of the &6most beloved dates&f!"
		"    We can make &avarious decorations&f"
		"      And create a &cscenario of &0Fear&f"
	]
	quest.4ED379396081F4AC.quest_subtitle: "Trick or Treat?"
	quest.4F8789AC6646B9A3.quest_subtitle: "&7Prepare a Filled Fish Dish"
	quest.4F8789AC6646B9A3.title: "Kill Stuffed Cod"
	quest.4FC63ED667016EF4.quest_desc: ["&fSome relationships grow beyond simple friendship and begin to shape a shared future. By spending time together, supporting each other and strengthening your connection, you can form the foundation of a true &afamily. &fThis bond represents trust, commitment and the beginning of something much greater. Find someone special and take the first step toward a &ashared life."]
	quest.4FC63ED667016EF4.quest_subtitle: "&7Form a family bond with someone special"
	quest.4FC63ED667016EF4.title: "&5&lQuest: &r&eBuilding a Future Together"
	quest.4FCE9DF19940D6F8.quest_desc: ["&fDeep within the swamps, the &aSlime Golem &fcan sometimes be found defending its wet homeland from hostile intruders. Its body may look soft and harmless, but it is a capable protector when monsters come too close. If it is injured during battle, a few &aSlime Balls &fwill help restore it and keep it fighting."]
	quest.4FCE9DF19940D6F8.quest_subtitle: "&7A swamp guardian with a soft body"
	quest.4FCE9DF19940D6F8.title: "&5&lQuest: &r&eSlime Golem"
	quest.50D2295278A14FAA.quest_desc: [
		"      &6Canvas&f is a &6practical material&f"
		"     That replaces &ewool&f and &eleather&f"
		"          It is &bvaluable&f even in the"
		"      &aEarly stages&f of your journey"
		"        Craft &6signs&f, &6tatami mats&f and"
		"           &6Carpets&f for your home"
		"    Add a &aClean&f and aesthetic touch&f"
		"              To all your &bbuilds&f"
		"    Keep your &ecanvas&f ready for all"
		"              &bFuture projects&f!"
	]
	quest.50D2295278A14FAA.quest_subtitle: "New Material"
	quest.516A8A7788D24BFD.quest_desc: ["&fNear veins of coal ore, you may find the small but dangerous &aCoal Golem. &fIt has very little health, but if it is lit with flint and steel or walks over fire, it will rush toward a nearby enemy and burn them in a fiery attack. This final assault is powerful, but the golem will &asacrifice itself &fin the process."]
	quest.516A8A7788D24BFD.quest_subtitle: "&7A fragile spark hidden near the ore"
	quest.516A8A7788D24BFD.title: "&5&lQuest: &r&eCoal Golem"
	quest.52C8A6F174BD4813.quest_desc: ["&fKoi fish can appear in many beautiful color variations, bringing a peaceful touch to ponds and waterways. They can be picked up with a &aBucket, &fmaking them easy to transport and display wherever you like. Staying near a &aKoi &fwill also grant you the effect of Luck, making them more useful than they first seem."]
	quest.52C8A6F174BD4813.quest_subtitle: "&7Catch a koi and enjoy its good fortune"
	quest.52C8A6F174BD4813.title: "&5&lQuest: &r&eColors Beneath the Water"
	quest.534DF86CB652852D.quest_desc: ["&fThe &aStraw Golem &fcan appear naturally in villages, but it can also be created by hand if you want a farm protector of your own. These gentle guardians stay close to crops, watching over the fields and even preventing farmland from being damaged when you jump on it. They can be healed with &aWheat, &fmaking them simple but very useful companions for any growing settlement."]
	quest.534DF86CB652852D.quest_subtitle: "&7A quiet guardian of the fields"
	quest.534DF86CB652852D.title: "&5&lQuest: &r&eStraw Golem"
	quest.53524B6223865098.quest_desc: [
		"          The &6Barrel Golem&f is a"
		"        &aPeaceful&f village creature"
		"         It &bHides&f inside its &6barrel&f"
		"         When &cscared&f or &9sleeping&f"
		"     Becoming &bimmune&f to &4projectiles&f"
		"            With a &ahigh defense&f"
		"            &bRepair&f it with &eplanks&f"
		"             Give him &2emeralds&f"
		"            To get useful items&f"
	]
	quest.53524B6223865098.quest_subtitle: "Armazen?"
	quest.54A245D79DC8504A.quest_desc: [
		"     Among the &6oceans&f you may find"
