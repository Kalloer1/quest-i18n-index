	quest.44C5973CD376C0C4.quest_subtitle: "Found in Nether Fortresses."
	quest.44E7ADBFDC06294C.quest_desc: [
		"During rain, it emits a signal with a power of 1."
		"During thundering - with a power of 2."
		"Also provide strong power to the block below."
	]
	quest.44E7ADBFDC06294C.quest_subtitle: "Swing depending on the current weather and output a redstone signal, the strength of which depends on the current weather."
	quest.44E7ADBFDC06294C.title: "Wind Vane"
	quest.450C39AE75127F3A.quest_desc: ["When placed next to an inventory, it will mimic the functionality of that inventory. For example, if you place it down and then a chest onto the front face, using a hopper on the proxy to insert items would put them into the chest. This can be useful when you need to have multiple insertion points to one block."]
	quest.450C39AE75127F3A.quest_subtitle: "Click to learn more!"
	quest.4521CFC7E05A8BAC.quest_subtitle: "You'll need a brush."
	quest.4521CFC7E05A8BAC.title: "Obtain a fossil !"
	quest.453B35F69CB3EB69.title: "Find an Axolotl"
	quest.455AB40E9A8F4641.quest_desc: [
		"They can be pushed with pistons or contraptions and will deal &4extra damage&r if they hit something while extending."
		"Can be infused with &9lingering potions&r. To do so either craft them, click on them or pour the potion using a faucet."
		"They can only accept negative lingering potions and have infinite charge."
		""
		"Bamboo spikes counts as &6player kills&r, meaning when a mob is killed by bamboo spikes it drops loot and XP as if it were killed by a player."
	]
	quest.455AB40E9A8F4641.quest_subtitle: "Spikes that will slow and damage all mobs that walk on them."
	quest.45D11540ED89B4E7.title: "Find a Jumping Spider"
	quest.45E6458B285449BD.quest_desc: [
		"When pushed by a piston it can scrape agains any full face iron-like block to produce sparks."
		"If a flammable block is nearby it will catch fire! This allows to have a on demand durationless flint and steel."
		"Opposite also works which means you can move an iron block agains a flint block instead."
		"These interactions also work with Quark magnets."
	]
	quest.45E6458B285449BD.quest_subtitle: "A decorative and storage block that can provide a use for your extra flints."
	quest.45FF08E4DB6F7F0E.quest_desc: ["{atm9.quest.rs.desc.iron}"]
	quest.45FF08E4DB6F7F0E.title: "{atm9.quest.rs.iron}"
	quest.460D60F796E4940A.quest_subtitle: "Small chance to drop when enchanting."
	quest.461EAAE527DE42A0.title: "Find a Boar"
	quest.464D5B690548E214.title: "Acces to the End delight"
	quest.46C3E19658D0965B.quest_desc: [
		"The &bFrosted Rod&r is uncraftable and is only obtainable through &bFrosted Crates&r."
