	quest.0292F734F71E37C2.quest_desc: [
		"The level emitter functions by emitting a redstone signal when a specific item has reached a particular amount, set by the player. It operates in two modes:"
		""
		"Emit when there is More than"
		"Emit when there is Less than"
		""
		"These modes are useful for setups to either deactivate when reaching a certain threshold or activate automation when falling below a designated mark."
	]
	quest.0292F734F71E37C2.quest_subtitle: "Click to learn more!"
	quest.02DB5A7AD4160322.quest_desc: [
		"In the mood for some thievery? Why not target the unemployed!"
		""
		"&6Right-clicking&r a jobless &bVillager&r gives you a small chance to steal &2Emeralds&r. This chance increases with your &2Luck&r, up to 90%!"
		""
		"But be cautious! Repeatedly targeting the same &bVillager&r will make them more protective, and failing to pickpocket will harm your reputation!"
	]
