		"{atm9.quest.mekanism.desc.metallurgicInfuser.1}"
		""
		"{atm9.quest.mekanism.desc.metallurgicInfuser.2}"
		""
		"{atm9.quest.mekanism.desc.metallurgicInfuser.3}"
	]
