	quest.7FCF073953B20033.title: "Find a Wolf"
	quest.7FFFF7F7DF3BE4FB.quest_desc: [
		"Work only with &aSafes&r, &aNetherite Doors&r, &aNetherite Trapdoors&r and&a Lock Blocks&r"
		""
		"To lock a block first rename the &aKey&r to your desired password, the click on the unbounded block."
		"To clear the ownership simply &6Shift&r + &6Right-Click&r with the correct &aKey&r on the locked block."
		"To open a locked block you won't need to have the correct &aKey&r in hand, it just needs to be in your inventory or &2Curio&r slot."
		""
		"Can be used in a &aDispenser&r to open key lockable blocks. Useful with lock blocks"
	]
	quest.7FFFF7F7DF3BE4FB.quest_subtitle: "Used to lock Safes, Netherite Doors, Netherite Trapdoors and Lock Blocks."
	quest.7FFFF7F7DF3BE4FB.title: "Key"
