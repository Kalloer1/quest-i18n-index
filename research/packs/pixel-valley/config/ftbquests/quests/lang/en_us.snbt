	quest.628814DCBC533B2B.quest_desc: [
		"&bFiery Crates&r are fished up in the &4Nether&r in any biome. It requires a fishing rod that can fish in lava and contains the following:"
		""
		"&2Common Drops&r:"
		"- Netherrack"
		"- Nether Quartz"
		"- Gravel"
		"- Nether Bricks"
		"- Bone"
		"- Soul Sand"
		"- Gold Ingots and Nuggets"
		"- Nether Wart"
		""
