	quest.3E890BABC4C41370.title: "{atm9.quest.rs.grid}"
	quest.3EAEC39431D5A055.quest_desc: [
		"The &bDiet Journal&r is a helpful book that tracks every food you've eaten. You can craft it by combining a &bBook and Quill&r with an &bApple&r, or by accepting this quest! That was easy."
		""
		"You might be wondering, why is it important to know what foods I've eaten? Well, each unique food you eat increases your &cMax Health&r! It may take a bit of munching before you start feeling different, but rest assured, you'll grow stronger!"
	]
	quest.3EAEC39431D5A055.quest_subtitle: "Click to learn more!"
	quest.3EB5ACA017BACC0B.quest_desc: [
		"Similar to &aCakes&r they can only be eaten when placed."
		"Can be placed in a pile of up to 8."
		"&aHoney&r can be poured on them (either via &aFaucet&r or by &6Right-clicking&r with a &aHoney Bottle&r)."
		"They can also accept other toppings such as &aChocolate&r and &aSyrup&r."
		"&aPancakes&r with honey, chocolate or syrup will give a short speed effect when eaten."
		""
		"&8You can also insert a Pancake in a Jukebox for some sick tunes!&r"
	]
	quest.3EB5ACA017BACC0B.quest_subtitle: "Yummy."
	quest.3EB5ACA017BACC0B.title: "Pancake"
