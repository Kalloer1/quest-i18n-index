		""
		"1x &bShaft&r"
		"2x &bAny Wooden Planks&r"
		""
		"Alternative recipe:"
		""
		"1x &bCogwheel&r"
		"1x &bAny Wooden Plank&r"
	]
	quest.1E8CF9F49F78363C.quest_subtitle: "Similar to the Cogwheel, but larger."
	quest.1F14D45C1E6C8A80.quest_subtitle: "Ah! It grew legs!"
