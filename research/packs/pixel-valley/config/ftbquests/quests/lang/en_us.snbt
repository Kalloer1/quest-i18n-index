	quest.7C32DED450405D92.quest_desc: [
		"Locate and discover a &7Silver&r Dungeon."
		""
		"Be prepared for a difficult of a fight!"
		""
		"Can be found within the skies of &bAether&r."
		""
		"The structure looks like a greek ancient building with many pillars around it."
