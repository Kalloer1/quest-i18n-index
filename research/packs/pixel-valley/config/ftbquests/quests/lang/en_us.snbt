	quest.4B20AAF81A1DAF1D.quest_desc: [
		"&6Spouts&r can be crafted with:"
		""
		"1x &bCopper Casing&r"
		"1x &bDried Kelp&r"
	]
	quest.4B20AAF81A1DAF1D.quest_subtitle: "Used for bottling or bucket filling, or crafting with liquids."
	quest.4B36949CD065FCBB.quest_subtitle: "Rotate any kind of rotateable block."
	quest.4B384ED77AFFC7D4.quest_desc: [
		"The &6Wrench&r"
		""
		"Right-clicking a component with a &6Wrench&r rotates it. Right-clicking a component, redstone component, or rail dismantles it and places it in your inventory. Sneak while right-clicking to dismantle interactive blocks."
		""
		"&6Wrenches&r can be crafted with:"
		""
		"3x &bGolden Sheets&r"
		"1x &bCogwheel&r"
		"1x &bStick&r"
		""
		"The &6Engineer's Goggles&r"
		""
		"When worn, the &6Engineer's Goggles&r display the stress impact of a running machine, show numbers and highlight the current rotation when looking at a &bStressometer&r or &bSpeedometer&r, and indicate the fluid level and total capacity of a tank."
		""
		"&6Engineer's Goggles&r can be crafted with:"
		""
		"1x &bString&r"
		"2x &bAny Glass&r"
		"1x &bGolden Sheet&r"
	]
	quest.4B384ED77AFFC7D4.quest_subtitle: "Click to learn more!"
	quest.4B384ED77AFFC7D4.title: "Craft Engineering Tools"
	quest.4B51836028C8BDE8.quest_desc: [
		"As strong as Iron gear from the Overworld."
		""
		"But the more durability used, the faster it mines."
		""
		"The sword also increases damage output with how much durability it has."
		""
		"Can mine &2Skyjade&r and &dGravitite&r Ore"
	]
	quest.4B51836028C8BDE8.title: "Zanite Tool Set"
	quest.4B5B12608410AFDB.title: "Dark Oak Log"
	quest.4B77EE0A74D55BEC.quest_subtitle: "Dropped by The Wither."
	quest.4B81E84CAE814BA9.quest_desc: ["{atm9.quest.rs.desc.64kfluid}"]
	quest.4B81E84CAE814BA9.title: "{atm9.quest.rs.64kfluid}"
	quest.4BA827EDA2F6DA23.quest_desc: ["This works exactly like the Inventory Cable Connector, but with the added capability of filtering. You can specify exactly what it will insert into the inventory, as well as set specifics such as \"Keep last item\". This is particularly useful when combined with the polymorphic filter. Additionally, you can set a priority to determine whether it should be the first inventory inserted/pulled from or the last."]
	quest.4BA827EDA2F6DA23.quest_subtitle: "Click to learn more!"
	quest.4BDE773C3359D584.quest_subtitle: "{atm9.quest.mekanism.subt.miniRobot}"
	quest.4BE1C5F8E8F09016.quest_desc: [
		"The &bRod of Souls&r is uncraftable and can only be obtained from the &bSoul Crate.&r"
		""
		"It has the special effect of increasing the yield of XP by +5 when catching anything, and boasts a durability of 250."
		""
		"Additionally, it can fish in lava."
	]
	quest.4BE1C5F8E8F09016.quest_subtitle: "Click to learn more!"
	quest.4BE722FA1D056106.quest_desc: [
		"This is the &bAether&r explorers dream, &amust have&r &nITEM!&r"
		""
		"Think of it as a wiki for &2ALL&r the new &bAether&r items/blocks gathered."
		""
		"Simply open it up and add an item/block in the slot in the book to find out more information."
	]
	quest.4BE722FA1D056106.title: "Da Wiki!"
	quest.4BFC5627EBC60A9A.quest_subtitle: "Grown from tea blossoms."
	quest.4C0302FF4F63B52E.title: "Resssources"
	quest.4C1F13F5A0E273EF.quest_desc: ["{atm9.quest.rs.desc.256kstorage}"]
	quest.4C1F13F5A0E273EF.title: "{atm9.quest.rs.256kstorage}"
	quest.4C3EAFD51063B02A.quest_desc: [
		"&bPermanent Sponges&r offer a simple solution for clearing &9water&r and &clava&r. Easily create air pockets by placing a sponge; once placed, liquids won't flow back."
		""
		"Attaching a sponge to a stick will result in a &bSponge On A Stick&r. Right-clicking will swiftly clear out small pockets of fluids!"
	]
	quest.4C3EAFD51063B02A.quest_subtitle: "Click to learn more!"
	quest.4C466B770F48B07E.quest_subtitle: "Grants the player +2 armor when worn."
	quest.4C4DCEA3243648A5.quest_subtitle: "The Standard Traveler's Backpack has no unique abilities and serves as the base for upgrading into various types of backpacks."
	quest.4C5575534915E6C0.title: "&2Animal Breeding III"
	quest.4C5D63586BBA3C22.title: "Obtain 256x Birch Log"
	quest.4CD83943865018EA.quest_desc: ["{atm9.quest.rs.desc.exporter}"]
	quest.4CD83943865018EA.quest_subtitle: "{atm9.quest.rs.subt.exporter}"
	quest.4CD83943865018EA.title: "{atm9.quest.rs.exporter}"
	quest.4CF6B343FE51F81F.quest_desc: [
		"&n&6                                                 &r&6               "
		"&2MineColonies&f is an interactive building mod that allows you to create your own thriving town within Minecraft.\\nIt lets your leadership skills soar by providing you with everything you need to build your kingdom. \\nMineColonies gives you the flexibility to create a colony as unique as every player. \\n\\nWith so many options, you’ll create a different colony every time, adapt to any biome, build inside a mountain, on top of one, under the ocean, or in the sky. \\nThe limit is your imagination! \\n\\nMineColonies features &6NPC workers &fsuch as Builders, Farmers, Fishers, Foresters, Guards, Miners, Smelters, Bakers, Cooks, Couriers, five types of animal herders, Composters, and many more, with even more being developed and added as the mod grows.\\n\\nIt also includes specialized buildings such as the Warehouse, House, Town Hall, Barracks, Library, University, and even the School."
		"&n&6                                                 &r&6               "
	]
	quest.4D4D004CFD92E40D.quest_desc: [""]
	quest.4D4D004CFD92E40D.quest_subtitle: "Only caught when fishing in a &4Soul Sand Valley&r in the &4Nether&r. It will require a rod that can withstand lava."
	quest.4D52DEC4EEDEEC0D.quest_subtitle: "Those Pokémon don't stand a chance!"
	quest.4D52DEC4EEDEEC0D.title: "Unlock &6Cobblemon Industrialized"
	quest.4D5F9E9A9CA701B5.quest_desc: [
		"To assign a &6Schedule&r, right-click a conductor (&bMob&r or &bBlaze Burner&r at &bTrain Controls&r) with the &6Schedule&r. Right-click the &6Schedule&r to add commands."
		""
		"For station recognition, input a &bStation&r name or use \"&b*&r\" as a wildcard."
		""
		"You can set travel conditions for the &6Schedule&r."
		""
		"&6Schedules&r left at stations will automatically replace the conductor's schedule when stopping."
		""
		"&6Train Schedules&r can be crafted with:"
		""
		"1x &bSturdy Sheet&r"
		"1x &bPaper&r"
		""
		"&aPondering is recommended.&r"
	]
	quest.4D5F9E9A9CA701B5.quest_subtitle: "Use mobs to control your Trains!"
	quest.4D87DE75948AB8F5.quest_subtitle: "Found in taiga biomes."
	quest.4D87DE75948AB8F5.title: "Taiga Grapes"
	quest.4D8CAD708E7BCB8B.quest_subtitle: "Chop chop!"
	quest.4D98552BA5389769.title: "Find a Rattlesnake"
	quest.4D9DC4973FD340E5.quest_desc: [
		"The Combat Academy is where your Knights in Training will train to become Knight. This also allows them to level up without a risk of dying to mobs."
		"The Knights in Training require a sword and shield to practice. They will attack the practice dummies, a pumpkin on top of a bale of hay."
		""
		"Tip: Consider setting the hiring mode to automatic so new recruits or kids growing up will automatically start training if not already attending school"
	]
	quest.4D9DC4973FD340E5.quest_subtitle: "Build a Combat Academy"
	quest.4DD7E2BD8508A117.quest_subtitle: "Build one of every herder hut."
	quest.4DF782D7E2E59DAF.quest_desc: [
		"If enchanted with &3Stasis&r it gains the ability to place &aSoap Bubble Blocks&r in mid air wherever you aim."
		""
		"The blocks will remain in the air for a while or until they are stepped on."
		"&aSoap Blocks&r can be replaced with other blocks, which is useful when building."
	]
	quest.4DF782D7E2E59DAF.quest_subtitle: "A fun novelty item which you can use to blow soap bubbles at your friends."
	quest.4DFC015406B24BD2.quest_desc: [
		"Can hold and display 3 lines of text."
		"Cats will occasionally sit on it."
		"One single item can be hidden below it. To do so shift click on any face except the top one."
	]
