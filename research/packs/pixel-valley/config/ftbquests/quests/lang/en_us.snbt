	quest.592E74E7C40A121B.quest_desc: [
		"Once an item is taken or removed from a pedestal the block will give out a observer detectable update. (This can be prevented if one swaps the item with a sack)."
		"If an end crystal is placed on a pedestal the block will give off an enchanting power equal to 3 bookshelves. This means that with 5 of such blocks you'll be able to max out an enchanting table."
	]
	quest.592E74E7C40A121B.quest_subtitle: "Beautifully displays the object placed on it."
