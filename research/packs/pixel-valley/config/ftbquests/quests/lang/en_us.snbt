	quest.323E1990203C74C2.quest_subtitle: "Can be caught anywhere in the &5End&r."
	quest.324287EC1ACF685B.quest_desc: [
		"These are the same tier as Overworld wooden tools, but they alos have another cool feature."
		""
		"When using the correct tool for the job, you'll gain double the drops!"
