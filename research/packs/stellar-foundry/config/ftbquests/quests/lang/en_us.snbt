	task.4206011F133EDD9C.title: "I am ready to design a real off-world outpost"
	task.424A7396E226EF28.title: "I understand that the quests explain the progression"
	task.44A43931F8A4C806.title: "I understand basic FE machine diagnosis"
	task.4610939469E53679.title: "I am ready to learn patterns and autocrafting"
	task.480AEFF667A7195D.title: "I tested the grid under load and identified its real limit"
	task.481F6385379C9956.title: "I prepared a first-flight supply loadout"
