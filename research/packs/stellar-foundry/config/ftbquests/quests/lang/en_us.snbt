	task.39F70B3981B3A63C.title: "Storage Architect Patch"
	task.3AD9F007BC13C36B.title: "I will read the surrounding quests before mass-crafting"
	task.3D565B1C144451E8.title: "I am ready to route items deliberately"
	task.3F6BAEDD2B4C4130.title: "I understand the purpose of optional branches"
