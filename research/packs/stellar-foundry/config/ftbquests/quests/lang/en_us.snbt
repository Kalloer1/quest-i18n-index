	quest.1918579C00105426.quest_desc: [
		"Craft Foundry Alloy Mix and check its uses in JEI."
		"Version 2.4.0 no longer hides the new components behind optional recipes. This mix is the first required step toward the launch pad."
	]
	quest.1918579C00105426.quest_subtitle: "The custom launch chain now starts with a visible pack-owned material."
	quest.1918579C00105426.title: "Begin the Foundry Route"
	quest.645B124B5404CEDB.quest_desc: [
		"Craft Stellaris Steel through one of the Stellar Foundry conversion recipes."
		"The generic Stellaris recipe is replaced so JEI points to the intended pack route instead of silently preferring Immersive Engineering steel."
	]
	quest.645B124B5404CEDB.quest_subtitle: "Dedicated steel is now a required part of the launch chain."
	quest.645B124B5404CEDB.title: "Produce Stellaris Steel"
	quest.A42C9D7E10B5F361.quest_desc: [
		"Craft a Sealed Machine Frame."
		"This is the structural core used by later mission electronics and proves that the factory branches are feeding one shared space program."
	]
	quest.A42C9D7E10B5F361.quest_subtitle: "Industrial steel, pressure technology, and control circuits meet here."
	quest.A42C9D7E10B5F361.title: "Build a Sealed Machine Frame"
	quest.B71E4A2C90D63F58.quest_desc: [
		"Craft a Mission Data Core."
		"It connects Refined Storage processing with the Orbital Guidance Chip and is required for the rocket nose cone and mission systems."
	]
	quest.B71E4A2C90D63F58.quest_subtitle: "Storage logic becomes flight hardware."
	quest.B71E4A2C90D63F58.title: "Assemble a Mission Data Core"
	quest.C94F20A6B17D3E85.quest_desc: [
		"Craft four Launch Frame Segments."
		"These segments are required by the launch pad, fins, engine, oxygen tank, and rocket station. Open JEI to see each connected recipe."
	]
	quest.C94F20A6B17D3E85.quest_subtitle: "The new recipes are now part of the main quest route."
	quest.C94F20A6B17D3E85.title: "Fabricate Launch Frame Segments"
	quest.0F9CB1D007F3484B.quest_desc: [
		"Craft the Stellaris Oxygen Tank using Pressure Sealant, PneumaticCraft parts, Stellaris Steel, and a Launch Frame Segment."
		"This replaces the old standalone route and makes the tank part of the factory-wide progression."
	]
	quest.0F9CB1D007F3484B.quest_subtitle: "Pressure technology is now tied directly to the launch frame."
	quest.0F9CB1D007F3484B.title: "Build an Oxygen Tank"
	quest.430CC210EA629E38.quest_desc: [
		"Craft nine Rocket Launch Pads with the Stellar Foundry recipe shown in JEI."
		"The original recipe has been replaced, so this is no longer an optional alternative."
	]
	quest.430CC210EA629E38.quest_subtitle: "The pad now uses Foundry Alloy Mix and Launch Frame Segments."
	quest.430CC210EA629E38.title: "Construct the Rocket Launch Pad"
	quest.443BFF8007D296A8.quest_desc: [
		"Craft four Rocket Fins using Launch Frame Segments, Stellaris Steel, and Create Sail Frames."
		"These are required parts of the connected Chapter 12 route."
	]
	quest.443BFF8007D296A8.quest_subtitle: "Create engineering now contributes directly to the vehicle."
	quest.443BFF8007D296A8.title: "Craft Rocket Fins"
	quest.6ECF54F778BDA78C.quest_desc: [
		"Craft the Rocket Engine and Rocket Nose Cone using the new Stellar Foundry recipes."
		"The engine uses multiple technology branches, while the nose cone requires the Mission Data Core."
	]
	quest.6ECF54F778BDA78C.quest_subtitle: "Power, precision, guidance, and pressure systems converge."
	quest.6ECF54F778BDA78C.title: "Craft Engine and Nose Cone"
	quest.30221B26A537ED0A.quest_desc: [
		"Craft the Rocket Station with a Mission Data Core, Mission Manifest, Stellaris Steel, and a Launch Frame Segment."
		"This recipe replaces the previous default route."
	]
	quest.30221B26A537ED0A.quest_subtitle: "Mission Control is built from the same launch infrastructure."
	quest.30221B26A537ED0A.title: "Add a Rocket Station"
}
