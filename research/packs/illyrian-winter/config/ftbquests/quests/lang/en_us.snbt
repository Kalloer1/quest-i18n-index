	file.0000000000000001.title: "&bIllyrian Winter"
	quest.00A3AD4BD4EE0FC7.quest_desc: [
		"The Guard Tower will employ and house one Guard to protect your colony. Your citizens will appreciate a well guarded colony. A general rule of thumb is two guards for every three citizens."
		""
		"Guards sleep in guard dowers, freeing up the bed they previously occupied in a residence or tavern allowing you to recruit new colonists. "
		""
		"Tip: You can expand your colony border by building and leveling up guard towers."
	]
	quest.00A3AD4BD4EE0FC7.quest_subtitle: "Keep your colony safe."
	quest.00A3AD4BD4EE0FC7.title: "&fBuild a &6Guard Tower&f and &6Hire a Guard"
	quest.015E9A8FFAC0B1CA.quest_desc: ["Use this &o&6Build Tool&r to pick your colony's style.  It's recommended to check out all the styles in a creative world first!"]
	quest.0177BB2C7A23D8EF.quest_desc: ["The Baker will craft bread dough, cookie dough, cake dough, and raw pumpkin pie, then bake these in a furnace to create bread, cookies, cakes, and pumpkin pies. They will only do this upon request, whether from the Cook, the postbox, or as a minimum stock in the Warehouse."]
	quest.0177BB2C7A23D8EF.quest_subtitle: "&7Crafts &fcooked goods&7 for &fRestaurants&7."
	quest.0177BB2C7A23D8EF.title: "&fBuild a &6Cookery"
	quest.0221AA0D9993FDE6.quest_subtitle: "Here You Go"
	quest.0221AA0D9993FDE6.title: "Can't Find Flint?"
	quest.023593790DEC7546.quest_desc: ["Good luck..."]
	quest.023593790DEC7546.title: "&4Survive"
	quest.03C442C0F5710A84.quest_desc: ["Use the &o&6Transmorgrification Table&r and &o&6Amethyst Shards&r to change the appearence of items."]
	quest.03C442C0F5710A84.title: "&eTransmog"
	quest.0834CF5341CCAD7A.quest_subtitle: "&7Crafts &fconcrete&7."
	quest.0834CF5341CCAD7A.title: "&fBuild a &6Concrete Mixer's Hut"
	quest.085F473094778DCD.quest_desc: [
		"The resource scroll is an easy way to tell what one of your Builder needs. Sneak + right-click on a Builder’s Hut to register the resource scroll to the builder."
		""
		"Now when you right-click while holding the resource scroll, you will see all the needed materials for the Builder’s Hut you clicked on."
	]
	quest.085F473094778DCD.quest_subtitle: "Find out what your builder needs."
	quest.085F473094778DCD.title: "&fCraft a &6Resource Scroll"
	quest.09CE03A6C34C91F5.quest_desc: ["&4&l&o&mDid&r &0&l&n&oYou&r &4&l&o&mcause this? &r &0&l&n&oYou&r &4&l&o&mcreated it. &r &0&l&n&oYou&r &4&l&o&mended us!"]
	quest.09CE03A6C34C91F5.title: "&4Remember Them"
	quest.0A13189E6D4045EF.quest_desc: ["Good thing the rivers are frozen."]
	quest.0A13189E6D4045EF.title: "&6Keep Moving"
	quest.0A3F0941FBE415DD.quest_subtitle: "Train 30 Guards"
	quest.0A3F0941FBE415DD.title: "&dLieutenant"
	quest.0AF072431298A4C7.title: "Garlands Galore"
	quest.0B009391E3F76D6E.quest_desc: [
		"The fisher is an excellent source of early game food for your citizens. Hopefully you have a decent resource for string. With any luck the fisherman will also get some some extra loot. "
		""
		"If your colony lacks a natural water source like an ocean or river, you can make do with a 6x6x1 area of water. "
	]
	quest.0B009391E3F76D6E.quest_subtitle: "Farms &ffish&r for your colony."
	quest.0B009391E3F76D6E.title: "&fBuild a &6Fisher's Hut"
	quest.0B5C14B6595FB789.quest_desc: ["To change the difficulty of &b&oCold &cSweat&r &7(the temperature mod)&r, first press &2&oESC&r, then select &2&oOptions...&r, then click the square &o&bC&cS&r button on the left side, here you can change the settings and difficulty of &b&oCold &cSweat&r."]
	quest.0B5C14B6595FB789.quest_subtitle: "Feel Free To Use Or Ignore Any/All Of These Quests"
	quest.0B5C14B6595FB789.title: "Difficulty Settings"
	quest.0BD951A1E243D409.title: "Light Up The Night"
	quest.0C6818DDF5683620.quest_subtitle: "Here You Go"
	quest.0C6818DDF5683620.title: "Skeletons/Strays Too Tough?"
	quest.0D6E099A1A242153.quest_desc: [
		"The &bBuild Tool&r is one of the most important tools in the mod. It's how you will place all building from now on. Right+click any solid item to open the build preview GUI. On the right are controls for moving, rotating, raising, and lowering your building. "
		""
		"Place your &bTown Hall&r block and register your colony. However, the first building to be constructed is the builders hut. Your Town Hall cannot be built until you have a completed builders hut."
		""
		""
		"{image:minecolonies:textures/quests/hc_build_tool.png width:190 height:100 align:1}"
	]
	quest.0D6E099A1A242153.quest_subtitle: "Time to design your colony."
	quest.0D6E099A1A242153.title: "&fCraft a &6Build Tool"
	quest.0EBB4E5195610A82.quest_desc: [
		"The Sawmill is where the Carpenter will craft any items made of at least 75% wood. This is the point where the colony really starts to feel like it’s running on its own. Be sure to set up important recipes for items your builder regularly needs. While the sawmill starts with a paltry 10 recipes, the number of recipes you can teach the Sawmill doubles per building level."
		""
		"Tip: Be sure to give your carpenter a &ebuild tool&r as some recipes require it. "
	]
	quest.0EBB4E5195610A82.quest_subtitle: "&7Crafts &fwooden&7 items."
	quest.0EBB4E5195610A82.title: "&fBuild a &6Sawmill"
	quest.0F409DACBEB7BBF8.quest_desc: ["Depending on the pack style you choose, supply ships may need to be placed in water, or in the air. Clear an area large enough to fit your supply ship. This may include digging under water, depending on where you place your ship. The supply ship will not place if there are objects in the way. Right clicking the supply ship on the ground will show a 3D preview of the camp. Using the placement controls arrows, position the ship in your clearing, then click the green checkmark to finalize the placement. If it won’t place, then the terrain is in the way, and you may need to clear the area more. Red lines will appear showing you the areas that need to be cleared."]
	quest.0F409DACBEB7BBF8.quest_subtitle: "&7Kickstart your &fcolony&7 by sea."
	quest.0F409DACBEB7BBF8.title: "&fCraft a &6Supply Ship"
	quest.0F5CF8E34C5EFFEF.quest_desc: ["Can craft wood and &o&e&nDomum Ornamentum&r recipes."]
	quest.0F5CF8E34C5EFFEF.title: "More of A Carpenter Really"
	quest.1080168A8A2AD19D.quest_desc: ["&3&o&m\"&lThe sun did not &0&kshine&r&3&l&o&m.  It was too &0&kwet&r&3&l&o&m to play.  So we sat in the...&r&3&o&m\"&l  Are &0&kyou&r&3&l&o&m listening?  Hey!  Why are &0&kyou&r&3&l&o&m never listening."]
	quest.1080168A8A2AD19D.title: "&3Knowledge Discarded"
	quest.10C8DD14B627E418.quest_desc: ["&3&l&o&mThe end is &0&khere&r&3&l&o&m, there is nothing left to do.  The &0&kseed&r&3&l&o&m was planted, but &0&kfruit&r&3&l&o&m never grew.  We all followed&r &0&l&o&nYou&r &0&k&l&o&m to our doom."]
	quest.10C8DD14B627E418.title: "&3Is There Hope"
	quest.120152510AD4B59A.quest_desc: ["While you might think your builder needs glasses sometimes, these goggles won’t help them. The Builders googles are for you. When you put them on your head or in a curio head slot they allow you to preview your buildings at level 5 which is helpful when fitting one building next to another."]
	quest.120152510AD4B59A.quest_subtitle: "See the plan come together."
	quest.120152510AD4B59A.title: "&fCraft the &6Builder's Goggles"
	quest.130E8FC7479E4271.quest_desc: [
		"The Shepherd’s Hut is where the Shepherd will breed and butcher sheep for food and wool. You will have to capture and bring in two sheep to the Shepherd’s Hut, as the Shepherd will not catch and bring in any sheep."
		""
		"The Shepherd will only keep two sheep alive per hut level, so at level 5 they will have ten sheep in their holding pens."
	]
	quest.130E8FC7479E4271.quest_subtitle: "Farms &fsheep&r for your colony."
	quest.130E8FC7479E4271.title: "&fBuild a &6Shepherd's Hut"
	quest.132AF80A62FFF98D.quest_desc: [
		"Cliches aside, the tavern should be a high priority building in the early game for several reasons. A tavern can house four colonists. Exactly the number that spawned when you created your village. "
		""
		"After completing the tavern, visitors will stop by to hang out in hopes of being recruited into your colony. You can recruit these visitors by giving them the items they request. "
		""
		"You may want to check out their stats before recruiting a visitor because nobody wants to pay too much for a rubbish colonist."
		""
		"&o&8PRO TIP: You can tell a lot about a potential recruit by looking at their boots. Fancy boots, better stats.&r&r"
	]
	quest.132AF80A62FFF98D.quest_subtitle: "Houses 4 colonists."
	quest.132AF80A62FFF98D.title: "&fBuild a &6Tavern"
	quest.148B689F17872BF1.quest_desc: ["Provides mass housing for guards after building the integrated &o&6Barracks Towers&r."]
	quest.148B689F17872BF1.title: "Reporting For Duty"
	quest.1523C366CF54F147.quest_desc: ["&o&e&nCosmeticArmors&r adds new &6&oarmor&r, and &o&6armor trims&r, that you can either use as is or transmog onto your prefered armor."]
	quest.1523C366CF54F147.title: "&eCosmeticArmors"
	quest.15B51FB56A64C303.quest_desc: [
		"Many new buildings and upgrades are locked behind university research so it is worth getting a university built as soon as possible. Researcher will research various upgrades to your colony, and each level unlocks an additional researcher for a total of 5 researchers. Each Researcher can start their own research, but more Researchers does not lower the amount of time each individual research takes."
		""
		"Note: Research time is real-world time spent in-game. However, after level 3, Researchers will sometimes use offline time to work on researches."
	]
	quest.15B51FB56A64C303.quest_subtitle: "Research new technologies."
	quest.15B51FB56A64C303.title: "&fBuild a &6University"
	quest.15F03A5E7E14C022.quest_desc: ["The stonemason is another key profession in the colony. They craft items commonly required by the builder. The stonemason will craft 3x3 recipes made entirely out of cobblestone, stone, andesite, diorite, granite, quartz, purpur, nether bricks, prismarine, sandstones, blackstone, and basalt. They can also craft end stone from cobblestone and an ender pearl after you complete the research."]
	quest.15F03A5E7E14C022.quest_subtitle: "&7Crafts with &fstone&7."
	quest.15F03A5E7E14C022.title: "&fBuild a &6Stonemason's Hut"
	quest.169DF34F3158E9BB.quest_desc: ["One may not be enough."]
	quest.169DF34F3158E9BB.title: "&cGet Warm"
	quest.17BA6A150CD2F179.quest_desc: ["Can craft recipes made solely out of stone."]
	quest.17BA6A150CD2F179.title: "How We Built The Pyramids"
	quest.181FF9C9B201AB98.quest_desc: [
		"&o&6Snowmen&r now deal &41/2&r a heart of damage with their &o&6snowballs&r, and have a &21/4&r chance of converting an enemy into a fellow snowman upon defeat.  &o&6Snowballs&r also now &bfreeze&r mobs temporarily."
		"&o&0&7(Players also deal damage with snowballs)&r"
	]
	quest.181FF9C9B201AB98.title: "&eEnhanced Snowmen"
	quest.18B433C376191087.quest_desc: ["If only it had frozen over..."]
	quest.18B433C376191087.quest_subtitle: "&o(Only 1 Path Required)"
	quest.18B433C376191087.title: "&cVenture Forth"
	quest.198435D73DA3401E.quest_desc: ["Fishermen occasionally find these mysterious &o&6orbs&r..."]
	quest.198435D73DA3401E.title: "&9Long Lost Treasure"
	quest.19D03831EB5EED02.quest_desc: ["The Blacksmith is a 3x3 crafter and can make any vanilla tools, armor, swords, and shields (no bows or redstone items). You will need to teach the Blacksmith the recipes of the items you want them to create. "]
	quest.19D03831EB5EED02.quest_subtitle: "&7Crafts &ftools&7, &farmor&7, and &fweapons&7."
	quest.19D03831EB5EED02.title: "&fBuild a &6Blacksmith Hut"
	quest.19E97D807300370D.quest_desc: ["Perhaps living flame holds the secrets to eternal warmth."]
	quest.19E97D807300370D.title: "&eDefeat The Heat"
	quest.1C16AEE8E29FB5A0.quest_desc: [
		"The rallying banner will summon your Guards to you when used. It’s especially useful in raids, as Guards don’t automatically know where to find the raiders. You must shift + right-click the banner on a Guard tower or Barracks Tower to assigns the Guards in that tower to the rallying banner."
		""
		"Note: Your Guards will not follow you outside the colony border. To bring Guards outside the border, set them to Follow you on the second page of their tower GUI."
	]
	quest.1C16AEE8E29FB5A0.quest_subtitle: "Used to summon your &fguards&7."
	quest.1C16AEE8E29FB5A0.title: "&fCraft a &6Rallying Banner"
	quest.1DD0E6578A00EAC6.quest_desc: ["The depths hold the warmth."]
	quest.1DD0E6578A00EAC6.title: "&3Find Shelter"
	quest.1E1870FAD295DEDE.quest_desc: ["Clear out and flatten an area roughly 20x20 blocks to make room for your camp. The camp will not place if there are objects in the way. Right clicking the supply camp on the ground will show a 3D preview of the camp. Using the placement controls arrows, position the camp in your clearing, then click the green checkmark to finalize the placement. If it won’t place, then the terrain is in the way, and you may need to clear the area more. Red lines may appear showing you the areas that need to be cleared."]
	quest.1E1870FAD295DEDE.quest_subtitle: "&7Kickstart your &fcolony&7 by land."
	quest.1E1870FAD295DEDE.title: "&fCraft a &6Supply Camp"
	quest.201CB898A399F1D5.quest_desc: [
		"The Swineherd’s Hut is where the Swineherd will breed and butcher pigs for food. You will have to capture and bring in two pigs to the Swineherd’s Hut, as the Swineherd will not catch and bring in any pigs."
		""
		"The Swineherd will only keep two pigs alive per hut level, so at level 5 they will have ten pigs in their holding pens."
	]
	quest.201CB898A399F1D5.quest_subtitle: "Farms &fpigs&r for your colony."
	quest.201CB898A399F1D5.title: "&fBuild a &6Swineherd's Hut"
	quest.206159A3C7A78447.quest_subtitle: "&7Make your colonists &fhappy&7."
	quest.206159A3C7A78447.title: "&fBuild a &6Mystical Site"
	quest.20A1EC90024A054F.quest_desc: ["&4&l&o&mAre&r &0&l&n&oYou&r &4&l&o&mhappy with this?  Was it worth it?"]
	quest.20A1EC90024A054F.title: "&4You Can't Escape"
	quest.2171E790D502004C.quest_subtitle: "&7Improve your childrens &fintelligence&7."
	quest.2171E790D502004C.title: "&fBuild a &6School"
	quest.224D1995FCA67C7F.quest_desc: ["Trains your citizens to be proper Knights."]
	quest.224D1995FCA67C7F.title: "Time For Boot Camp"
	quest.22F4BDF88C726214.title: "Gather Supplies"
	quest.22F4C38E79DEFF1E.quest_desc: ["When placing any building, including your supply camp or ship. You will have the option to change your colony style. Click the “Switch Pack” button to open a menu with many styles to choose from. If you want to get an idea of the styles before you build, go to youtube and search \"&eMineColonies Build Styles&r\". Note: This pack includes a number of additional styles not shown in the video."]
	quest.22F4C38E79DEFF1E.quest_subtitle: "It's a big decision."
	quest.22F4C38E79DEFF1E.title: "&fChoose a &6Colony Style"
	quest.23012F6C4C522CEB.quest_desc: ["The Forester is an essential worker in your colony. They will chop down trees and replant a sapling in the tree’s place. Foresters will chop any tree in the immediate area. However, this area can be restricted using a &ezoning tool&r available in the hut block. "]
	quest.23012F6C4C522CEB.quest_subtitle: "&7Farms &fwood&7 for your colony."
	quest.23012F6C4C522CEB.title: "&fBuild a &6Forester's Hut"
	quest.236F01A2A4F61C5B.title: "Impenetrable Snow Forts"
	quest.23A08BFF7B7AE61C.quest_desc: ["&4&l&o&mForever and ever.  Forever and ever.  Forever and ever.  Forever and ever.  Forever and ever.  Forever and ever.  Forever and ever.  Forever and ever.  Forever and ever.  Forever and ever.  Forever and ever.  Forever and ever.  Forever and ever.  Forever and ever.  Forever and ever.  Forever and ever.  Forever &r"]
	quest.23A08BFF7B7AE61C.title: "&4Fix Your Mistake"
	quest.248CDD141581187B.quest_desc: ["&o&6Templates&r are used for making custom lights and garlands."]
	quest.248CDD141581187B.title: "Arts And Crafts"
	quest.24FB5D66918C0381.title: "World Too Cold, Or Goat Too Slow?"
	quest.29BF0F70AFF6767E.title: "Frosty's Little Brother"
	quest.2A836A9B2C09890B.quest_desc: ["&o&n&eTraveler's Backpacks&r are upgradable, portable storage that can have special abilities depending on which one you find, or craft."]
	quest.2A836A9B2C09890B.title: "&eTraveler's Backpack"
	quest.2AB033B6F3E4E6B3.title: "Tie It All Together"
	quest.2B01B964638DFBD1.quest_desc: ["The Crusher’s Hut is where the Crusher will take items and crush them into other blocks. Most notably cobblestone = gravel, gravel = sand, sand = clay. One important factor to know is that the crusher has a daily limit based on the hut level. Level 1 has a daily max of 16, level 2 has 64. At level 5 it’s daily max is 999. "]
	quest.2B01B964638DFBD1.quest_subtitle: "&7Crushes &fmaterials&7."
	quest.2B01B964638DFBD1.title: "&fBuild a &6Crusher"
	quest.2B1041CD56C2DC26.quest_subtitle: "Here You Go"
	quest.2B1041CD56C2DC26.title: "Not Near Any Trees?"
	quest.2BE7E385A5A3F36E.quest_subtitle: "Train 80 Guards"
	quest.2BE7E385A5A3F36E.title: "&cCenturion"
	quest.2CDA6DEA2100B3ED.quest_desc: ["&0&o&l&mI&r &o&2can get back up there.  That'll show &r&l&o&m&0Them&r&2&o.  &0&o&l&mI&r &2&oam better than &r&l&o&m&0Them&r&2&o.  &0&o&l&mI&r &2&oam better than &r&0&l&o&nMyself&r&2&o."]
	quest.2CDA6DEA2100B3ED.title: "&2Rebuild"
	quest.2CF7504AA831A30F.quest_subtitle: "Grow to 75 Citizens"
	quest.2CF7504AA831A30F.title: "&aTown"
	quest.2F71BBB2061B5667.quest_desc: [
		"&0&o&l&mI&r &o&2did it."
		"&0&o&l&mI&r &o&2did it... to them."
		"&0&o&l&mI&r &o&2did it... for them."
		"&0&o&l&mI&r &o&2did it... for myself."
		"&0&o&l&mI&r &o&2did it... to silence them."
		"&0&o&l&nI&2 DID IT FOR &0&kTHE-REPUBLIC!"
	]
	quest.2F71BBB2061B5667.title: "&2Redemption"
	quest.2FE8BEB6A3D2D81D.quest_desc: ["The frost no longer holds any power over you!"]
	quest.2FE8BEB6A3D2D81D.title: "&eDefeat The Freeze"
	quest.300FE98460233208.quest_desc: ["&0&k&l&o&mjdsnjkndsjakln&r&3&l&o&m House &r&0&k&l&o&masdaasd asdas&r&3&l&o&m Eleven &r&0&k&l&o&masdsadasdasdas asdasda sdadasasdad&r&3&l&o&m Lolipop &r&0&k&l&o&m masdas dsd&r&3&l&o&m Parade &r&0&k&l&o&masdas asdas"]
	quest.300FE98460233208.title: "&3Heard Everywhere"
	quest.31923AAF5312D0E6.quest_desc: ["Don't forget the essentials."]
	quest.31923AAF5312D0E6.title: "&dLight the Fire"
	quest.32CD165BC74BFE58.quest_desc: ["Harnesting this power almost allows you to walk on lava."]
	quest.32CD165BC74BFE58.title: "&9Forever Room Temperature"
	quest.33058894ACD9CB06.quest_desc: ["The Graveyard is where the Undertaker will bury your deceased citizens. When a citizen dies, a grave will spawn at the location of death. The Undertaker will attempt to recover the grave before it despawns. If successful, the Undertaker will return to the graveyard and attempt to revive the citizen. If the citizen cannot be revived, the Undertaker will bury them in the Graveyard. Another grave will be placed with the citizen’s name on it."]
	quest.33058894ACD9CB06.quest_subtitle: "&7Take care of your &fdead&7."
	quest.33058894ACD9CB06.title: "&fBuild a &6Graveyard"
	quest.335271BB4CC32A33.quest_desc: ["Colonists will automatically go here, to get food, when they're hungry."]
	quest.335271BB4CC32A33.title: "Chef's Choice"
	quest.3355FF385357F299.quest_subtitle: "&7Crafts &fvarious items&7."
	quest.3355FF385357F299.title: "&fBuild a &6Mechanic's Hut"
	quest.3388714253D897E1.title: "Not For Walking"
	quest.3427F86DD68E704F.quest_desc: ["Make sure to pick a good name!"]
	quest.3427F86DD68E704F.title: "Foundation Day"
	quest.345CEC473C8610C8.quest_desc: ["Yeah we do a little mining."]
	quest.345CEC473C8610C8.title: "The Children Yearn"
	quest.35A6A0A647838F1D.quest_subtitle: "Here You Go"
	quest.35A6A0A647838F1D.title: "Initial Quests Taking Too Long?"
	quest.360E9E02A494217C.quest_subtitle: "&7Upgrades up your &fbarracks guards&7."
	quest.360E9E02A494217C.title: "&fBuild a &6Barracks Tower"
	quest.365DA0E1FDA31DFB.quest_desc: ["If you can't find one, maybe you can attract one."]
	quest.365DA0E1FDA31DFB.title: "&eMake a Friend"
	quest.37E43341FA234E84.quest_desc: [
		"The Flower Shop is where your Florist will grow flowers for your colony, if given compost and an axe. "
		""
		"One important factor to know is that the flower shop has a daily flower limit based on the hut level. Level 1 has a daily max of 4, level 2 has 8. At level 5 it’s daily max is 20. "
	]
	quest.37E43341FA234E84.quest_subtitle: "Farms &fflowers&r for your colony."
	quest.37E43341FA234E84.title: "&fBuild a &6Flower Shop"
	quest.3A5FC3F7482E70A5.quest_subtitle: "&7Crafts &farrows&7."
	quest.3A5FC3F7482E70A5.title: "&fBuild a &6Fletcher's Hut"
	quest.3AE1C3290500638F.quest_subtitle: "Grow your colony into a Hamlet."
	quest.3AE1C3290500638F.title: "&fHouse &625 Citizens"
	quest.3B40A769EDB26EA2.quest_desc: [
		"Got your eye on a new recruit and need some hay bales? If you place a postbox outside your tavern you can request items from the warehouse and a courier will deliver them to the postbox."
		""
		"Similarly, if you have items you want taken to the warehouse, place them in a Stash and a courier will be along shortly to pick them up."
	]
	quest.3B40A769EDB26EA2.quest_subtitle: "Work with your colony."
	quest.3B40A769EDB26EA2.title: "&fCraft a &6Postbox&f and &6Stash"
	quest.3B91163DE3DA885C.quest_desc: [
		"Possibly one of the most dangerous jobs, especially early on. The Nether Miner travels to the Nether to mine resources. When the miner travels through the portal, there is a chance they may die. So choose your worker carefully."
		""
		"The portal in the Nether Mine will transport players to the Nether. However, the Nether Miner does not actually travel into the Nether, nor do they actually mine any blocks in the Nether."
	]
	quest.3B91163DE3DA885C.quest_subtitle: "&7Mines &fores&7 and &fmaterials&7 from the Nether."
	quest.3B91163DE3DA885C.title: "&fBuild a &6Nether Mine"
	quest.3E7CB27DCC0B03F4.quest_subtitle: "Train 8 Guards"
	quest.3E7CB27DCC0B03F4.title: "&9Decanus"
	quest.4055592720161B8E.quest_desc: ["Lit &o&6Campfires&r prevent mobs from spawning within &232&r blocks of them, and start to burn mobs within &48&r blocks of them."]
	quest.4055592720161B8E.title: "&eNo Hostiles Around Campfires"
	quest.42188561EA8A034D.quest_desc: ["&3&l&o&mI know what&r &0&l&o&nYou&r &3&l&o&mdid.  Where is &r&0&k&l&o&meverybody&r&3&l&o&m?  Who am I?  Do you know what I &r&0&k&l&o&mdid&r&3&l&o&m...  Who are you?"]
	quest.42188561EA8A034D.title: "&3Willfully Forgotten"
	quest.42D1024ABD844C01.quest_desc: ["&o&e&nCosmeticWeapons&r adds new &o&6weapons&r and &o&6weapon trims&r that you can either use as is, or transmog onto your prefered weapons."]
	quest.42D1024ABD844C01.title: "&eCosmeticWeapons"
	quest.430475E11D259B74.quest_desc: [
		"The Stone Smeltery is where the Stone Smelter will smelt cobblestone into stone, stone bricks into cracked stone bricks, clay balls into bricks, clay blocks into terracotta, terracotta into glazed terracotta, all types of stone into all types of smooth stone, and logs into charcoal. They can also pop chorus fruits! "
		""
		"Be sure to teach the Stone Smelter recipes needed by your colony. Also, be sure to set a fuel type. "
	]
	quest.430475E11D259B74.quest_subtitle: "&7Smelts &fstone&7."
	quest.430475E11D259B74.title: "&fBuild a &6Stone Smelter"
	quest.44599DF7338EFA5E.quest_desc: ["The &o&6lamp&r resonates with these plants, curious."]
	quest.44599DF7338EFA5E.title: "&dHarvest The Dead"
	quest.44F67360BF6AD3F8.quest_subtitle: "Grow to 25 Citizens"
	quest.44F67360BF6AD3F8.title: "&eHamlet"
	quest.454B72FF04BF8B65.quest_desc: [
		"It really likes spider eyes,"
		"...and your head for some reason."
	]
	quest.454B72FF04BF8B65.title: "&aAn Unknown Creature..."
	quest.458C172E47DDFA56.quest_subtitle: "&7Sifts for &fextra materials&7."
	quest.458C172E47DDFA56.title: "&fBuild a &6Sifter"
	quest.466B2692E3BD7D28.quest_desc: [
		"Sometimes your enemy is also your best friend."
		"&7&o(You don't need Silk Touch)&r"
	]
	quest.466B2692E3BD7D28.title: "&bPrepare Supplies"
	quest.483B8E2FC7851B84.quest_desc: ["Information is your best weapon."]
	quest.483B8E2FC7851B84.title: "&aKnow Your Limits"
	quest.488C8D1DFD797985.quest_desc: ["Can craft tools, armors, and weapons."]
	quest.488C8D1DFD797985.title: "I Think That Enemy Got The Point"
	quest.48C09D377D60F98D.quest_desc: ["The &o&6Library&r levels up an adult citizen's intelligence, while the &o&6School&r does so for children; and the &o&6University&r researchs upgrades for your colony."]
	quest.48C09D377D60F98D.title: "Shhhhh"
	quest.490628CE108A833A.quest_desc: [
		"The Courier runs back and forth from the Warehouse to all the worker huts in your colony, delivering materials to workers and putting finished products in the Warehouse. The level of the Courier’s Hut will dictate how many items the Courier can carry and the amount of requests they can keep track of at a time."
		""
		"Courier’s don’t just work on their own. You must build a warehouse, and assign the courier to work at a warehouse. "
		""
		"Note: If you have multiple Warehouses, Couriers will only see the items in the Warehouse they are assigned to. This is helpful in the late game when troubleshooting requests."
	]
	quest.490628CE108A833A.quest_subtitle: "&7Distributes &fitems&7 to &fworkers huts&7."
	quest.490628CE108A833A.title: "&fBuild a &6Courier Hut"
	quest.493B9FC17C3CF3CA.quest_desc: [
		"The Rabbit Hutch is where the Rabbit Herder will raise and butcher rabbits. You will have to capture and bring in two rabbits to the Rabbit Hutch, as the Rabbit Herder will not catch and bring in any rabbits."
		""
		" The Rabbit Herder will only keep two rabbits alive per hut level, so at level 5 they will have ten rabbits in their holding pens."
	]
	quest.493B9FC17C3CF3CA.quest_subtitle: "Farms &frabbits&r for your colony."
	quest.493B9FC17C3CF3CA.title: "&fBuild a &6Rabbit Hutch"
	quest.49793060345FB28C.quest_desc: [
		"The Cowhand’s Hut is where the Cowhand will milk, breed, and butcher cows for leather. The Cowhand will only keep two cows alive per hut level, so at level 5 they will have ten cows in their holding pens to breed and butcher."
		""
		"Note: &eYou must bring your own cows to the pen.&r"
	]
	quest.49793060345FB28C.quest_subtitle: "Farms &fcattle&r for your colony."
	quest.49793060345FB28C.title: "&fBuild a &6Cowhand's Hut"
	quest.49F5562C36806000.title: "Ice See You"
	quest.4A08A10FE497EADF.quest_subtitle: "&7Kill one of the &fraiders&7."
	quest.4A08A10FE497EADF.title: "&fDefend a &6Raid"
	quest.4B2739BA83699BD0.title: "Christmas Cat Ears"
	quest.4C32A7E1F2CD630F.title: "Diamonds Are Overrated"
	quest.4CF3B0ACBC5B2820.quest_desc: [
		"Helping clear land is a great way to speed up building."
		"And you're eventually going to want more of these."
	]
	quest.4CF3B0ACBC5B2820.title: "Let's Get Started"
	quest.4D9DC4973FD340E5.quest_desc: [
		"The Combat Academy is where your Knights in Training will train to become Knight. This also allows them to level up without a risk of dying to mobs."
		"The Knights in Training require a sword and shield to practice. They will attack the practice dummies, a pumpkin on top of a bale of hay."
		""
		"Tip: Consider setting the hiring mode to automatic so new recruits or kids growing up will automatically start training if not already attending school"
	]
	quest.4D9DC4973FD340E5.quest_subtitle: "&7Train your &fguards&7 to become &fknights&7."
	quest.4D9DC4973FD340E5.title: "&fBuild a &6Combat Academy"
	quest.4E5F4B346DC4A214.quest_desc: ["&7&oP.S. You don't grow the saplings in the &o&6Tree Stand&r."]
	quest.4E5F4B346DC4A214.title: "A Tree For Every Room"
	quest.4FCAFADF12821861.quest_desc: ["Can smelt stones and logs into their byproducts."]
	quest.4FCAFADF12821861.title: "Earth Benders Wanted"
	quest.4FE78069FEC8BE53.title: "Ginger Bread Time"
	quest.5089D5C825F32D61.quest_desc: ["The storage system of your colony.  &o&6Couriers&r use it for taking items to, and from, various buildings across the colony."]
	quest.5089D5C825F32D61.title: "Where Are The Wares"
	quest.50C31F64C3B1C3FE.quest_desc: ["&4&l&o&mLook what we've become. &r &l&o&n&0You&r &4&l&o&mabonded us."]
	quest.50C31F64C3B1C3FE.title: "&4Endless Suffering"
	quest.52453550206EC770.quest_subtitle: "&7Crafts &fdyes&7 and &fdyes items&7."
	quest.52453550206EC770.title: "&fBuild a &6Dyer's Hut"
	quest.529FF9188D8277FB.title: "The Gift Of Giving"
	quest.52FA3A19DE473621.quest_subtitle: "&7Crafts &fglass&7 items."
	quest.52FA3A19DE473621.title: "&fBuild a &6Glassblower's Hut"
	quest.537A8F99CC3F525D.quest_subtitle: "Serious defences."
	quest.537A8F99CC3F525D.title: "&fHire &68 Guards"
	quest.5526867DF48AF464.quest_desc: [
		"Provides more advanced food for the &o&6Restaurant&r."
		"&7(The &o&6Cookery&r &7does the same for non-baked goods)"
	]
	quest.5526867DF48AF464.title: "All Caked Up"
	quest.55C6661CA1AA1260.quest_desc: [
		"Will the master of the elements guide others as well?"
		"&7&o(This quest unlocks the rest of the quest book)"
	]
	quest.55C6661CA1AA1260.title: "&2Create a Home"
	quest.55DABE029C44088E.title: "Bundle Up"
	quest.57C889EC980D33D9.quest_desc: ["I can finally top playing in the dirt (as much) and hand off my farming duties to someone else. I should probably have the farmer start with carrots since they don't need to be cooked, too..."]
	quest.57C889EC980D33D9.quest_subtitle: "Farms &fcrops&r for your colony."
	quest.57C889EC980D33D9.title: "&fBuild a &6Farm"
	quest.57CCDF9B69A471E8.quest_desc: ["The other good early game food source."]
	quest.57CCDF9B69A471E8.title: "Old MacDonald Had A..."
	quest.583A7AA84FEC027F.quest_desc: [
		"Before anything can be built, you need a Builder. The Builder must build their own Builder’s Hut before building any other huts, and they cannot build or upgrade a hut to a higher level than their own hut level. "
		""
		"The builder is arguably the hardest working citizen in your colony. (Second only to you). You are not limited to just one builder. As your colony grows, you may need to add more builders just to keep up. "
	]
	quest.583A7AA84FEC027F.quest_subtitle: "Constructs buildings."
	quest.583A7AA84FEC027F.title: "&fBuild a &6Builder's Hut"
	quest.5A11A2FC20E5CE2A.quest_desc: [
		"The Barracks is the ultimate protection for your colony. The Barracks Towers (unlike the normal Guard tower) will employ and house one Guard for every level built, for a total of 5 Guards per Barracks Tower!"
		""
		"In the later game you will likely want two barracks chock full of &mexpendable&r brave souls."
		""
		"Tip: At level 3, you can hire spies for 5 gold per raid, these spies will go out into the world and if barbarians are spotted, the spies will tell you exactly where the barbarians are."
	]
	quest.5A11A2FC20E5CE2A.quest_subtitle: "&7Strengthen your &fdefences&7."
	quest.5A11A2FC20E5CE2A.title: "&fBuild a &6Barracks"
	quest.5A58AE731C4F11ED.quest_desc: ["All of the &o&n&eMineColonies&r quests are based on &o&6Advancements&r.  So, if you get stuck and/or can't advance then there are probably other &o&6Advancements&r you missed that aren't quests, but are needed to be done in order to progress your quests."]
	quest.5A58AE731C4F11ED.quest_subtitle: "Check Your Advancements"
	quest.5E28A263174D409B.quest_desc: ["Good early game food source for your colony, and provides treasure if built on an ocean"]
	quest.5E28A263174D409B.title: "Now We're An MMO"
	quest.5E43507AE60CFDD2.quest_subtitle: "Grow to 10 Citizens"
	quest.5E43507AE60CFDD2.title: "&6Settlement"
	quest.5EA9BCFE894547D2.quest_desc: [
		"Their skin is both hot and cold, weird."
		"&o&7(&6Chameleons&7 can only breed once)&r"
	]
	quest.5EA9BCFE894547D2.title: "&a...With Mystical Properties"
	quest.5FC01763770A062E.quest_desc: [
		"The Town Hall is the central building in your colony. It provides lots of helpful information about your colony such as citizen stats, open work orders, citizen happiness, allies and more. "
		""
		"The settings tab should be a first stop for any new colonist as it contains options for hiring mode, housing assignment mode, and options to allow kids to be born. Also, this is where you can customize your colony flag. Your flag will appear on guard towers and guard shields. "
	]
	quest.5FC01763770A062E.quest_subtitle: "Take control of your colony."
	quest.5FC01763770A062E.title: "&fBuild a &6Town Hall"
	quest.600D5CAECA74B9A5.quest_desc: ["The &o&6orb&r returns..."]
	quest.600D5CAECA74B9A5.title: "&dNot Your Typical Farm"
	quest.6129BFEACD9A6956.quest_desc: [
		"Each &o&6Courier&r needs their own &o&6Courier's Hut&r."
		"&7(The following crafter buildings are most useful for automating the making of blocks used by your colony's style.)"
	]
	quest.6129BFEACD9A6956.title: "Same Day Delivery"
	quest.615C6C9BBBA8C6BF.quest_desc: ["Better to be freezing then to be boiling."]
	quest.615C6C9BBBA8C6BF.title: "&bPrepare Yourself"
	quest.616A8CF3BCF5F567.quest_desc: ["Delays the first auto complete quest in the &oSurvive&r chapter (via quest log lag I guess), so it can successfully remove the merry-makers manual from the player's inventory.  (this is because the manual normally spawns in after the player loads into the world and the quest is completed)"]
	quest.616A8CF3BCF5F567.title: "delays first quest"
	quest.617A0BFFA1CF5612.title: "Rudolph Slippers"
	quest.622EDEF250F3D477.quest_desc: ["Expands your Colony's claimed chunks more than other buildings, and provides housing for its one guard."]
	quest.622EDEF250F3D477.title: "First Line of Defense"
	quest.62FE15295DB689F2.quest_desc: ["Can smelt ores into ingots."]
	quest.62FE15295DB689F2.title: "It's Getting Hot In Here"
	quest.63BB181DE6DD573E.title: "I'm The Santa Now"
	quest.647F95EED59927B7.quest_desc: [
		"Starving colonists will eat just about anything, including raw food and rotten flesh. Yuck! "
		""
		"When citizens are hungry, they will come to the Restaurant and the Cook will give them food. (assuming you have food to give them) Consider building a Fisher’s Hut, or a Cowhand’s Hut. "
		""
		"Note: Make sure to choose a fuel for your cook to use. Some popular options are charcoal, sticks, and planks, although anything with a burn time will work. "
	]
	quest.647F95EED59927B7.quest_subtitle: "&7Distributes &ffood&7 to your colonists."
	quest.647F95EED59927B7.title: "&fBuild a &6Restaurant"
	quest.64909B2C4CCA5A90.quest_desc: ["Can also be used as a starter base."]
	quest.64909B2C4CCA5A90.title: "Bring in The Supplies"
	quest.654B0D6EAF8E3E75.quest_subtitle: "Farms &fbees&r for your colony."
	quest.654B0D6EAF8E3E75.title: "&fBuild an &6Apiary"
	quest.65868B826E4E908E.quest_desc: [
		"The Flower Shop is where your Florist will grow flowers for your colony, if given compost and an axe. "
		""
		"One important factor to know is that the flower shop has a daily flower limit based on the hut level. Level 1 has a daily max of 4, level 2 has 8. At level 5 it’s daily max is 20. "
		"{image:minecraft:block/cactus_side width:16 height:16}"
		"{image:minecraft:item/sugar_cane width:16 height:16}"
	]
	quest.65868B826E4E908E.quest_subtitle: "Farms &fspecialty crops&r for your colony."
	quest.65868B826E4E908E.title: "&fBuild a &6Plantation"
	quest.66B982A4B1DC924F.quest_subtitle: "&7Identifies &fAncient Tomes&7."
	quest.66B982A4B1DC924F.title: "&fBuild an &6Enchanter's Tower"
	quest.66E9CE763748F851.quest_desc: ["&4&l&o&m&kblah bla &r&0&l&o&m There &r &4&l&o&m&k blah blah y why are you reading &r&0&l&o&m Is &r&4&l&o&m&k this blah blah blah blah blah blah blah &r&0&l&o&m Another &4&k no lor here blah blah blah uno &r"]
	quest.66E9CE763748F851.title: "&4Put Them To Rest"
	quest.6719405E27D6F86D.quest_desc: ["Great early game housing."]
	quest.6719405E27D6F86D.title: "Every Town Has One"
	quest.67CE80041CE1BD11.quest_subtitle: "Here You Go"
	quest.67CE80041CE1BD11.title: "Need To Know The Exact Temperature?"
	quest.67CFBD298BE83F94.quest_subtitle: "Here You Go"
	quest.67CFBD298BE83F94.title: "Can't Find Food?"
	quest.67E8B8DCFC93F832.quest_desc: ["The warehouse is completed. It might not seem like much, but you can't have much of a trade empire without a place to store things. "]
	quest.67E8B8DCFC93F832.quest_subtitle: "&7Stores &fitems&7."
	quest.67E8B8DCFC93F832.title: "&fBuild a &6Warehouse"
	quest.68FC81E133443E76.quest_desc: [
		"The Library is a way for you to raise your adult citizens’ Intelligence skill, which influences skill increases once employed. A citizen will randomly level up their Intelligence as long as they’re assigned to the Library. Paper and books help Library Students increase their skills faster."
		""
		"Being a Library Student is a full-time job, and a student cannot be employed simultaneously at any other hut."
		""
		"Tip: Consider setting the hiring mode to automatic so new recruits or kids growing up will start school automatically."
	]
	quest.68FC81E133443E76.quest_subtitle: "&7Improve your collective &fintelligence&7."
	quest.68FC81E133443E76.title: "&fBuild a &6Library"
	quest.6922FC65C8D3C90D.quest_desc: ["&4&l&o&mHow could&r &l&o&n&0You&r &4&l&o&m? We trusted&r &l&o&n&0You&r &4&l&o&m."]
	quest.6922FC65C8D3C90D.title: "&4Atone"
	quest.69EAF1072D492F1A.quest_desc: [
		"The Ancient Tome is a glowing book that’s dropped by raiders during raids. If you have the Ancient Tome in your inventory, it will glow when there is going to be a raid that night. "
		""
		"In the later game, the Enchanter can convert Ancient Tomes into enchanted books. "
	]
	quest.69EAF1072D492F1A.quest_subtitle: "&7Foresee a coming &fraid&7."
	quest.69EAF1072D492F1A.title: "&fObtain an &6Ancient Tome"
	quest.6A60B76053393288.quest_desc: ["The Smeltery is where the Smelter will smelt ores into ingots. The higher the level of the Smeltery, the more furnaces the Smelter will be able to use. A higher level will also have a higher chance to double and even triple the ingot output per block of ore."]
	quest.6A60B76053393288.quest_subtitle: "&7Smelts &fores&7 into &fingots&7."
	quest.6A60B76053393288.title: "&fBuild a &6Smelter"
	quest.6B0CE8AD86991E28.quest_desc: [
		"The Composter’s Hut is where the Composter will turn organic materials into compost, which can be used by the Farmer or Florist to fertilize crops or flowers. "
		""
		"Note: You must configure the composter’s hut with the items you want composted before the composter will compost. &7&oThis sounds similar to a woodchuck tongue twister.&r"
	]
	quest.6B0CE8AD86991E28.quest_subtitle: "Converts organic waste to &ffertilizer&r."
	quest.6B0CE8AD86991E28.title: "&fBuild a &6Composter's Hut"
	quest.6BB0C51EE8CA5966.quest_desc: [
		"At the Mine, the Miner will mine for ores and materials. Once they are hired, the Miner will first create a shaft downward to a specific depth depending on the level of the Mine. Once the main shaft is completed, the Miner will then branch out. While mining, sometimes the Miner will get lucky and get an ore block instead of a basic stone block. &7&o(magic!)&r&r"
		""
		"Tip: The miner fills holes and gaps with a Fill Block, cobblestone by default. However, the fill block can be changed in the Miner’s Hut settings. If you have a forester and lots of wood, consider using wood planks. Or perhaps now you will have a use for all that deepslate."
	]
	quest.6BB0C51EE8CA5966.quest_subtitle: "&7Mine for &fores&7 and &fmaterials&7."
	quest.6BB0C51EE8CA5966.title: "&fBuild a &6Mine"
	quest.6C0C8152113F9BB2.quest_desc: ["&3&l&o&mOh!  Look &r&l&o&k&0mommy&r&3&l&o&m, Look!  I got &r&l&o&k&0second&r&3&l&o&m place at &r&l&o&k&0the&r&3&l&o&m science fair.  Mommy?  Where are &r&l&o&k&0you&r&3&l&o&m?  Oh!&r"]
	quest.6C0C8152113F9BB2.title: "&3Forever Yesterday"
	quest.6C7E78FBA71EB684.quest_desc: ["&3&l&o&mI see &r&l&o&k&0them&r&3&l&o&m, but they're not there.  I hear &r&l&o&k&0them&r&3&l&o&m, but don't comprehend to noises.  I feel nothing but &r&l&o&k&0them&r&3&l&o&m.  There is no sleep...  but I'm never awake."]
	quest.6C7E78FBA71EB684.title: "&3Never Tomorrow"
	quest.6D56AD1BEC644A10.quest_desc: [
		"The Archery is where your Archers in Training will train to become Archer. This also allows them to level up without a risk of dying to mobs. "
		""
		"The Archers in Training require a bow to practice. They will shoot at the practice targets, a target block"
		""
		"Tip: Consider setting the hiring mode to automatic so new recruits or kids growing up will automatically start training if not already attending school. "
	]
	quest.6D56AD1BEC644A10.quest_subtitle: "&7Train your &fguards&7 to become &farchers&7."
	quest.6D56AD1BEC644A10.title: "&fBuild an &6Archery"
	quest.6EEA012FA11C7C08.quest_desc: ["Once you have found the location for your colony, you will likely want to build either a supply camp or supply ship. You can choose one but not both. Either will provide you with some basic supplies to help you get started in the early game. &o&7(bed, food, basic tools and armor, starting resources, etc.)&r&r It’s beneficial to place your supply camp or ship near your colony as you will be traveling back and forth to it frequently in the early game. &eClose, but not in the way close.&r"]
	quest.6F6FBB8DEEBAA8E8.quest_desc: ["&7&o(It's a known issue that all quests that give backpacks give 2 instead of 1)&r"]
	quest.6F6FBB8DEEBAA8E8.quest_subtitle: "Here You Go"
	quest.6F6FBB8DEEBAA8E8.title: "Can't Wait For A Backpack?"
	quest.71FCF06A98CC66D7.quest_desc: [
		"With so many colonists working for the greater good it can be difficult to know who needs what. The clipboard is an easy way to see all the requests your workers have."
		""
		"&eSneak + right-click&r on your town hall block to register the clipboard."
	]
	quest.71FCF06A98CC66D7.quest_subtitle: "Find out what your workers need."
	quest.71FCF06A98CC66D7.title: "&fCraft a &6Clipboard"
	quest.72076F79942781F3.title: "Caroling Season"
	quest.72A486BDBBF49659.quest_subtitle: "&7Brews &fpotions&7."
	quest.72A486BDBBF49659.title: "&fBuild a &6Alchemist Tower"
	quest.72C749AD9F1C634E.quest_desc: [
		"Citizens will go to the Residence they are assigned to at night to sleep. The Residence is also a way to get more citizens for your colony. Every residence level adds another bed. More beds means more citizen capacity."
		""
		"It’s worth considering residence locations and the citizens they house. Workers get grumpy when they have to travel long distances to work. Try to move citizens into homes close to where they work. "
	]
	quest.72C749AD9F1C634E.quest_subtitle: "Houses citizens."
	quest.72C749AD9F1C634E.title: "&fBuild a &6Residence"
	quest.7395F76C54CD9CCF.quest_desc: ["&o&6Underground&r survival and military &o&6bunkers&r are spread out across the world, providing shelter and bountiful resources."]
	quest.7395F76C54CD9CCF.title: "&eUnderground Bunkers"
	quest.74C114D0C0D4D374.quest_desc: ["Remember in the beginning how it seemed that everyone was sick with Influenza and you had to keep feeding everyone carrots and potatoes? With the hospital built, they can go see the doctor and get cured by the Healer. You or the colony still needs to supply the ingredients."]
	quest.74C114D0C0D4D374.quest_subtitle: "Treat the sick."
	quest.74C114D0C0D4D374.title: "&fBuild a &6Hospital"
	quest.754988D2D8CA9F9B.quest_desc: [
		"This is the guide book for &o&n&eMama's Merry-Making&r, the biggest Chistmas mod in the pack. "
		"&o&n&eSnowy Spirit&r and &o&n&eWinterly&r are the other two big Holiday mods, but they don't have guide books."
	]
	quest.754988D2D8CA9F9B.title: "Tis' The Season"
	quest.754D7DF3D92899D7.quest_desc: ["It was coming right for you."]
	quest.754D7DF3D92899D7.title: "&6That's No Pig"
	quest.769724C9B0F36A9B.quest_desc: ["Trains your citizens to be proper Archers."]
	quest.769724C9B0F36A9B.title: "Robinhood Approved"
	quest.7852EBBFA44A3FA7.quest_subtitle: "Grow to 50 Citizens"
	quest.7852EBBFA44A3FA7.title: "&bVillage"
	quest.7870800C28A7E199.quest_desc: [
		"The Chicken Farmer’s Hut is where the Chicken Farmer will raise chickens, collect eggs, and butcher chickens for food. You will have to capture and bring in two chickens to the Chicken Farmer’s Hut, as the Chicken Farmer will not catch and bring in any chickens."
		""
		"The Chicken Farmer will only keep two chickens alive per hut level, so at level 5 they will have ten chickens."
	]
	quest.7870800C28A7E199.quest_subtitle: "Farms &fchickens&r for your colony."
	quest.7870800C28A7E199.title: "&fBuild a &6Chicken Farmer's Hut"
	quest.79257273F01B7148.quest_desc: ["You can only build one &o&6Tavern&r, so prepare to do some home decorating."]
	quest.79257273F01B7148.title: "Home Sweet Home"
	quest.7B5E2CD676A1A1C4.quest_desc: ["The Baker will craft bread dough, cookie dough, cake dough, and raw pumpkin pie, then bake these in a furnace to create bread, cookies, cakes, and pumpkin pies. They will only do this upon request, whether from the Cook, the postbox, or as a minimum stock in the Warehouse."]
	quest.7B5E2CD676A1A1C4.quest_subtitle: "&7Crafts &fbaked goods&7 for &fRestaurants&7."
	quest.7B5E2CD676A1A1C4.title: "&fBuild a &6Bakery"
	quest.7B9B6CFDE060D236.quest_desc: ["It seems these beasts weren't made from fire, but resistant to it."]
	quest.7B9B6CFDE060D236.quest_subtitle: "...But It Works"
	quest.7B9B6CFDE060D236.title: "&6A Little Creepy..."
	quest.7C742B602AC272DB.quest_desc: ["&0&o&l&mThey&r &2&oput me here.  &0&o&l&mI&r &2&ohad no choice!  &0&o&l&mThey&r &2&owere jealous of me.  &0&o&l&mEveryone&r &2&oloved me.  &0&o&l&mI&r &2&ohad everything.  &0&o&l&mThey&r &2&omade me do it..."]
	quest.7C742B602AC272DB.title: "&2Ever After"
	quest.7D593E1DC93489FD.quest_desc: ["Automated wood production is a necessity for any colony."]
	quest.7D593E1DC93489FD.title: "Get Chopping"
