	quest.06080C64F7F740C7.quest_desc: [
		"&6BigChadGuys Plus&r lets you claim chunks! This means you can keep your base safe from other players, Creeper explosions, and even keep chunks loaded."
		""
		"To claim a chunk, open your inventory and click on &bFTB Chunks: Claim Manager&r in the top-left corner. Then just left-click the chunks you want to claim. The number of claims you get depends on the server."
		""
		"To force-load a chunk, shift-click it after claiming. You'll see a visual change showing that the chunk is now force-loaded."
		""
		"And to unclaim chunks, just right-click!"
	]
