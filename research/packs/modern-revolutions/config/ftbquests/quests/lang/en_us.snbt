	quest.2C49B4369B84411A.quest_desc: [
		"&l&6General Commands&r"
		""
		"&o&eTeleportation&r"
		"\"&7/sethome&r\" will allow you to set that location as your home"
		"&cYou do not need to give it a name to set a home! &r"
		""
		"“&7/home&r” will allow you to teleport to that location from anywhere"
		""
		"“&7/tpa&r” will allow you to teleport to your friend"
		"“&7/tpahere&r” will allow your friend to teleport to you"
		"Accepting /tpa commands is clickable in chat"
		""
		"“&7/rtp&r” will randomly teleport you from a range of 1000 blocks to 5000 blocks"
		"&4If you are on a server try to not use rtp too often!&r"
		""
		"\"&7/showmahou&r\" will toggle the mahou amount"
		""
		"&l&6All of these commands have a cooldown!&r"
	]
