	quest.670F9A7D0711CCED.quest_desc: ["Insert a gas to get infinite amounts of that gas!"]
	quest.6713B1428E72DBD1.quest_desc: ["A crafting ingredient in many Industrial Foregoing machines."]
	quest.679CEDEFBD049478.quest_desc: ["Tier 3 Machine Frame. Requires pink slime (obtained via Mob Slaughter Factory)."]
	quest.67C3836D9A0AC89B.quest_desc: ["See JEI for a list of drops."]
	quest.67D365E629CC5BA3.quest_desc: [
		"Transports fluids. Can be placed in the same block as other Ender IO conduits."
		""
		"Note: EnderIO cables are known to sometimes cause lag. If you experience this, consider switching to a different cable type."
	]
