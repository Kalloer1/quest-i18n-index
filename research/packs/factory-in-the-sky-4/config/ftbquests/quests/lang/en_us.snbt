	file.0000000000000001.title: "Quests"
	quest.0074CD842AE5DF5A.quest_desc: ["Storage parts can be used in crafting to create storage disks or storage blocks. As they increase in tier, the more stuff you can fit in them!"]
	quest.008E478C5C67A731.quest_desc: ["Insert soil, sapling, and axe and let your trees grow with no effort on your part!"]
	quest.00AD7AB3F3039FCB.quest_desc: [
		"Have a question that is not addressed here? Ask it on Discord!"
		""
		"\"Where can I find passive mobs?\""
		"- If your island is not spawning passive mobs (you will need a large grass area), you can craft animal seeds, see \"Haven Animal Seeds\" in JEI."
		""
		"\"Is there vein miner?\""
		"- The mod FTB Ultimine is included in this pack. The default keybind is the grave key: `."
		""
		"\"Middle mouse to sort inventory?\""
		"- Yes, you can set the keybind in the controls menu!"
		""
		"\"Do I need to do the quest pages in order?\""
		"- No."
		""
		"\"How do I get [insert item here]?\""
		"- Use JEI to find recipes. Also, vanilla mechanics still apply for many vanilla items (i.e. finding upgrade templates in bastions)."
	]
	quest.00AD7AB3F3039FCB.quest_subtitle: "Join the Discord!"
	quest.01A5A30AFDAA215A.quest_desc: [
		"Salt represents the \"body\" or the \"physical matter\" of an object. "
		""
		"See The Hermetica for more details on Theurgy."
	]
	quest.01A5A30AFDAA215A.title: "Salt"
	quest.0238BAECF1A81B70.quest_desc: ["Control Circuits are key components in crafting Mekanism machines/tools. They are present in many recipes, and different recipes may require different tiers of Control Circuits. For example, an Energized Smelter would require Basic Control Circuits, but a Chemical Dissolution Chamber would require Ultimate Control Circuits. "]
	quest.0299CB83EE5C7AC7.quest_desc: ["Maximize smelting efficiency with unparalleled speed, reconfigurable sides, augments for smoking and blasting, and much more."]
	quest.02D5BB168D585BB1.quest_desc: ["Storage parts can be used in crafting to create storage disks or storage blocks. As they increase in tier, the more stuff you can fit in them!"]
	quest.0333265CAEB2672B.quest_desc: ["Turns liquid latex into dry rubber."]
	quest.0333D108914243AD.quest_desc: [
		"Tired of the vanilla crafting table? Try these on for size."
		""
		"The crafting table on a stick from Actually Additions can be used in a charm slot!"
	]
	quest.0333D108914243AD.title: "Crafting"
	quest.049B79DBCFE418BB.quest_desc: ["Turns copper storage into iron storage. Click upgrade on storage to apply."]
	quest.04A3DFCB86AD6A8F.quest_desc: ["Fast travel! Great for teleporting between dimensions. "]
	quest.0554A15324BA0FE6.quest_desc: ["Refer to &oThe Big Book of Bees&r for in-game documentaion, as well as JEI for recipes and breeding information. Buzz Buzz!"]
	quest.060DFA3D45DC5A01.quest_desc: [
		"The Cable connects storage network devices."
		""
		"However, cables are not always required—devices that are directly touching will automatically form a connection."
		""
		"If the Cable is colored, it will only connect to blocks and cables of the same color or the default color."
	]
	quest.062262B5C65AF83C.quest_desc: ["Used to craft tier 6 seeds."]
	quest.07854ABDF2525423.quest_desc: [
		"A device to recombine Alchemical Sulfur, Salt, and Mercury into items."
		""
		"See The Hermetica for more details on Theurgy."
	]
	quest.07D661E96B16D91A.quest_desc: ["Maximize smelting efficiency with unparalleled speed, reconfigurable sides, augments for smoking and blasting, and much more."]
	quest.07EC7458B7467EF4.quest_desc: ["Hammer blocks with the power of RF! Requires power. Insert a hammer to speed up."]
	quest.0831FA16886C36B8.quest_desc: ["Burns coal and turns it into power."]
	quest.084A0492C76D4B3F.quest_desc: ["Crafted using the Atomic Reconstructor. See JEI."]
	quest.0935819E16549AD6.quest_desc: ["Craft into many different items, see JEI for uses."]
	quest.0935819E16549AD6.title: "Generalized Predictions"
	quest.09760C9938F730D8.quest_desc: [
		"Crafters are machines added by RFTools that will automatically craft items given a recipe, the necessary components and RF power. Multi-step crafting can be done in a single machine, limited only by the number of recipe slots."
		""
		"Crafter Tier 2 can remember 4 recipes."
	]
	quest.097A233A95FFB754.quest_desc: ["Use on a chicken to create a golden egg. Click the egg on a 5x5 dirt patch to create delightful dirt (spawns passive mobs when lit)."]
	quest.09814BA8EA7DEE5A.quest_desc: ["Everyone knows that snad is better than sand and dirt. Try growing sugarcane on a block of snad."]
	quest.09D6A95486012A30.quest_desc: ["Maximize smelting efficiency with unparalleled speed, reconfigurable sides, augments for smoking and blasting, and much more."]
	quest.0A5256C62EB1B109.quest_desc: ["More storage! Hover over the item to see slot and stack capacity."]
	quest.0A6F0B333D136BC9.quest_desc: ["Put over a heat source and insert cobblestone to create lava."]
	quest.0A7F3AC9D7D4F604.quest_desc: ["Catalysts are crafting components that will be needed to craft creative items."]
	quest.0C0F94B6DB2E080B.quest_desc: ["The Awakening Altar is the core component of the multi-block Awakening crafting structure. Along with four Awakening Pedestals and four Essence Vessels, the altar is mainly used to craft Awakened Supremium. Activate with a redstone signal to start the crafting process."]
	quest.0C0F94B6DB2E080B.title: "Awakening"
	quest.0C2FF5B4D6DF8DC1.quest_desc: ["Each of the tiers adds more storage slots and more upgrade slots."]
	quest.0DFAA6039CF52FBC.quest_desc: ["Extended Crafting Tables are a set of tiered Crafting Tables that can be used to craft a variety of items. Each tier has a larger grid which can be used to craft higher tier items with more components."]
	quest.0E277E20880B2049.quest_desc: [
		"Resource Seeds are the main purpose of Mystical Agriculture. These seeds can grow more than 100 different resources, including Diamonds, Bones, Copper, Redstone and many others. When harvested they all drop their own Resource Essence, as well as having a 10% chance of dropping a Fertilized Essence."
		"There are different tiers of Resource Seeds. The tiers are dependent on how rare the material grown is."
		"These seeds are created using the Infusion Altar with materials, essences and a Seed Base."
		"These crops cannot be grown using Bonemeal or sped up by shifting."
		"They can be grown in the Garden Cloche with the correct soil."
	]
	quest.0E277E20880B2049.title: "Elemental Seeds"
	quest.0E6FF623392EEC67.quest_desc: ["More variety in your choice of building blocks! Also, check out the new handheld Chipped items, see JEI for details."]
	quest.0E6FF623392EEC67.title: "Chipped"
	quest.0FACDB9481B865F9.quest_desc: ["Uses RF to slice mob heads and splice them up with other items. Requires an Axe and Shears to operate."]
	quest.0FED5744C88DDF08.quest_desc: ["The XP Tap can only be placed on the side of a Singularity Tank. The XP Tap can be turned on and off when required to convert Fluid XP, contained in the tank, back in to XP Orbs for when you need to top up your XP levels."]
	quest.100CCB76CC637C5E.quest_desc: [
		"Check the Bumblezone advancements tab for what to do!"
		""
		"You will find bees are extremely protective of their honey in this dimension. If you mine vanilla's Honey Block, destroy or take honey from Honeycomb Brood Block, or you hit a bee, all bees around you will get many buffs and will become VERY angry at you because you now have the Wrath of the Hive effect! But by feeding bees or the Honeycomb Brood Blocks with the honey foods that you have, you might be able to calm them down. By feeding bees or that brood block, you get Protection of the Hive that makes bees defend you against anyone attacking you!"
	]
	quest.102C5B92DCFEBEB9.quest_desc: ["Autocrafter, upgraded to tier 2! Faster crafting speeds and increased pattern capacity."]
	quest.108601833D0C39F7.quest_desc: ["Hang Glider adds a hang glider (surprise!) to soar through the skies! Just jump off a high point (or jetpack up) and let your glider do the rest. Features very fluid and natural flight controls. And when you wanna go even quicker, reinforce your glider!"]
	quest.10943C6087CD73A4.quest_desc: ["Inferium Essence is one of the key materials needed to craft Mystical Agriculture blocks and items. It can be collected by killing both hostile and passive mobs and by farming Inferium Seeds."]
	quest.10943C6087CD73A4.title: "Mystical Agriculture"
	quest.1103C0F9C2F1FD57.quest_desc: ["This ultimate ingot is the most ultimate of all the ingots."]
	quest.1111CBFFB9565287.quest_desc: ["Check the Bumblezone advancements tab for what to do!"]
	quest.11AA6D7D6B0DCB70.quest_desc: ["Control Circuits are key components in crafting Mekanism machines/tools. They are present in many recipes, and different recipes may require different tiers of Control Circuits. For example, an Energized Smelter would require Basic Control Circuits, but a Chemical Dissolution Chamber would require Ultimate Control Circuits. "]
	quest.11AF013477D44838.quest_desc: [
		"The Infusion Altar is the core component of the multi-block Infusion crafting structure. Along with eight Infusion Pedestals, the altar is mainly used to craft Resource Seeds and Augments."
		"Activate with a redstone signal to start the crafting process."
	]
	quest.11AF013477D44838.title: "Infusing"
	quest.1248F9135FAAB5AF.quest_desc: ["Boosters with infinite range across dimensions."]
	quest.1248F9135FAAB5AF.title: "Infinity Booster"
	quest.12535C84226202FC.quest_desc: ["Storage parts can be used in crafting to create storage disks or storage blocks. As they increase in tier, the more stuff you can fit in them!"]
	quest.126BC695008C57CA.quest_desc: ["Makes alloys from two or more different materials! Can also act as a powered furnace."]
	quest.12715DDDBE88F6B4.quest_desc: ["Made with regular sized basic capacitors."]
	quest.128E41AC14154D18.quest_desc: ["Allows you to locate biomes and structures."]
	quest.128E41AC14154D18.title: "Compasses"
	quest.12A613974CDAD722.quest_desc: [
		"Max Blocks: 1024"
		""
		"Construction Sticks allow you to place multiple blocks at once, extending your build in the direction you're facing. You can upgrade your stick to enhance its abilities, making construction faster and more efficient."
		""
		"There are five different tiers of Construction Sticks: Wood, Copper, Iron, Diamond, and Netherite. Each tier offers improved durability and block placement abilities, and can be further upgraded with templates."
	]
	quest.12E2104DD92875C6.quest_desc: ["Storage parts can be used in crafting to create storage disks or storage blocks. As they increase in tier, the more stuff you can fit in them!"]
	quest.131FDA64C3180DB0.quest_desc: [
		"Right-click to enter the end. Refill with eyes of ender."
		""
		"The main End Island exists, but the outer end islands are void. To explore end cities, make sure to bring a jetpack or other way to fly!"
		""
		"Consider using the Explorer's Compass to help find End Cities!"
	]
	quest.131FDA64C3180DB0.title: "Into the End"
	quest.134D6774DA2D1932.quest_desc: ["Storage parts can be used in crafting to create storage disks or storage blocks. As they increase in tier, the more stuff you can fit in them!"]
	quest.148BA0F51023CE66.quest_desc: ["A Heat Generator converts heat energy into power. This is often the first generator to craft because, although it provides only a small amount of power, it is the only mekanism generator that does not require steel. The Heat Generator can generate power in both an active and a passive mode simultaneously."]
	quest.150A43710BAB94B3.quest_desc: ["Four iron ore chunks can be crafted into a block of iron ore."]
	quest.15388A4EE7D97E9A.quest_desc: ["Each of the tiers adds more storage slots and more upgrade slots."]
	quest.157C098AEBC660F3.quest_desc: ["The Autocrafter executes autocrafting tasks using patterns inserted into it or available in the storage network."]
	quest.1593E93188BF6609.quest_desc: [
		"There are six crafting crystals to Mystical Agriculture, instead of just two. The crystals are: Inferium, Prudentium, Tertium, Imperium, Supremium, and the Master Infusion Crystal."
		""
		"The recipes for the crystals are nested, so you can't just jump to a higher crystal without crafting the previous tier."
	]
	quest.15C3349D236A7BDC.quest_desc: ["Click on an ender chest with pouch to link. Ender chest access from your inventory!"]
	quest.163D19751578D945.quest_desc: ["Obtained by hammering gravel."]
	quest.16858B5DE24142ED.quest_desc: [
		"Burns any Fuel (Coal/Wood/etc). "
		"1 Coal = 20,000 RF (Similar to most other mods fuel levels). "
		"Internal storage capacity of 1,000,000 RF"
		"Burns fuel and charges a single item rather quickly."
		"Meant as a stop gap measure to charge items you want to use before you get a fully fledged energy system going. "
	]
	quest.16876F72C06C93BD.quest_desc: ["The Purification Chamber uses oxygen to refine Ores and shards into clumps. Each ore makes 3 clumps, whereas each shard only gives one clump. "]
	quest.177639631205B3EC.quest_desc: ["The Crafting Core is one of the key components of the Combination Crafting mechanism. Along with Pedestals, the Crafting Core can be used to craft different creative items using energy and items."]
	quest.1895A470465F4028.quest_desc: ["Using the mortar and pestle is quite simple. Detailed in the tablet are many recipes for different spells. You will need all of these ingredients, as well as a particular base ingredient. To create the most basic possible spell, simply place in the spell's recipe, as well as an old root. This will allow for a spell with no modifiers."]
	quest.18A405B8BF7F6E3F.quest_desc: ["The Importer extracts resources from a connected external inventory and inserts them into the storage network."]
	quest.19894F58314AF562.quest_desc: ["Defeat wardens and upgrade your armor to become more powerful than ever!"]
	quest.19894F58314AF562.title: "Warden Armor"
	quest.19BD8618EF4707CC.quest_desc: ["Crafted from stone pebbles."]
	quest.1A4F4869908795C2.quest_desc: [
		"This mod adds bees for most vanilla resources as well as all your favorite modded resources like copper, lead, silver etc. There are also a lot of bees for mod specific resources like Mystical Agriculture and Powah, for example."
		""
		"It is recommended to use JEI for looking up breeding recipes and the book for in-game documentation."
	]
	quest.1AE639EF3AE28B6C.quest_desc: [
		"To get started with the Aether, you must construct a portal with a Glowstone frame and light it with a water bucket in the middle, this will activate the portal and allow you to step through and enter the dimension. From here you can begin your survival in the Aether’s hostile paradise!"
		""
		"The Aether's world contains three new mysterious dungeons, each with a fearsome boss to defeat..."
		""
		"The Bronze Dungeon is the home of the Sentries and guarded by the ominous Slider, a creature born of pure stone. Look out for hidden tunnels through islands and prepare yourself with the best gear you can craft!"
		""
		"The Silver Dungeon is the beautiful Valkyrie Temple. Challenge the knights of the Valkyrie Order and, if you prove worthy, fight the Valkyrie Queen herself. Utilize every tool and trick you can to best this ancient warrior. "
		""
		"Within the rare Gold Dungeon lies the Sun Spirit, an eternal being of pure fire and energy. He is the God that rules the very Sun itself and will take some convincing to even pay attention to a being such as yourself. But it is rumored he guards some of the best treasure that exists in the Aether."
	]
	quest.1AE639EF3AE28B6C.title: "Into the Aether"
	quest.1B3242881C6D1876.quest_desc: ["Tier 2 Machine Frame."]
	quest.1B4E82446FBCEA61.quest_desc: ["A more advanced generator, burns anything you can use as fuel in a furnace and turns it into power!"]
	quest.1B5C7FE8C6DEAA59.quest_desc: ["Dragon Heads can be found on the front of flying ships in End Cities."]
	quest.1B7562EF795778A9.quest_desc: [
		"See also: Tank Storage (for fluids)"
		""
		"&2Features&r"
		"Larger slots: Store more items per slot than normally possible. Up to 1 billion items in a single slot."
		"Different sizes: From Bank 1 with 9 slots to bank 7 with 108 slots each with increasing slot sizes."
		"Bank Dock: Dock your bank to easily access it in-world."
		""
		"&2Pickup Modes&r"
		"Pickup all: All items picked up will automatically go into the Bank instead of your inventory."
		"Filtered pickup: Items will only go into Banks if they already contain matching items."
		"Void excess: Similar to filtered pickup, but if there is no room left in the Bank, the item gets voided."
		"No pickup: Items go straight into your inventory."
		""
		"&2Build Modes&r"
		"Build mode: Choose any block inside your Bank and place directly from the Bank item."
		"Scroll while crouching to choose block."
		"Randomized build mode: Similar to Build mode, but blocks get chosen randomly."
		"Bag Mode: Right click to open the Bank inventory screen."
		"Right click which crouching to change build mode."
		""
		"&2Slot Filtering&r"
		"Hold alt and click with an item to lock the slot to that item."
		"Only matching items can go into that slot."
		""
		"&2Bank Dock&r"
		"Craft with 6 smooth stone on the sides and 2 hoppers at the top and bottom."
		"Right click with the Bank to dock it."
		"Right click while crouching to pick up the Bank."
	]
	quest.1B7562EF795778A9.quest_subtitle: "dank/null/ or dev/null/"
	quest.1B7562EF795778A9.title: "Bank Storage"
	quest.1BD5123D662FBB72.quest_desc: ["Can be used to grow all sorts of crops, including those from Mystical Agriculture! See JEI to determine the correct soil to use."]
	quest.1BFF97D02D7C5D4B.quest_desc: ["Storage upgrade tier 2. Hover over item for details."]
	quest.1CB1EDD80BC5F2DB.quest_desc: [
		"Follow the steps outlined in the book on your journey to become a master alchemist."
		""
		"Theurgy aims to introduce a new take on Alchemy in Minecraft. Deviating from the well-trodden path of the \"4 Elements\" - Air, Water, Fire, Earth - it is inspired by classical Alchemy and works with the elements of Sulfur, Salt and Mercury and their handling through a group of processes known as Spagyrics."
		""
		"First and foremost Theurgy tries to create a balanced alchemy experience - not as overpowered as Equivalent Exchange, yet maybe somewhat more practicable than the legendary Thaumcraft."
	]
	quest.1CBA3B4E2413818F.quest_desc: ["Refer to &oThe Big Book of Bees&r for in-game documentaion, as well as JEI for recipes and breeding information. Buzz Buzz!"]
	quest.1CCF5DAA93C9AD84.quest_desc: ["Wireless power! What more could you want?"]
	quest.1CCF5DAA93C9AD84.title: "Flux Networks"
	quest.1CFE005AD9F9395B.quest_desc: ["Iron Jetpacks is a modern Jetpacks mod that is both feature-rich and easy to use. Jetpacks get better as you craft higher tiers. Coils are an integral part of the jetpack crafting process. See JEI."]
	quest.1CFE005AD9F9395B.title: "Jetpacks"
	quest.1D035E910905B2CD.quest_desc: ["Each of the tiers adds more storage slots and more upgrade slots."]
	quest.1D0DFE2219A02B10.quest_desc: [
		"Each seed can only grow on certain blocks. Make sure you plant them in the right spots!"
		""
		"The animals that has a Baby variant will grow into their baby variant."
		""
		"More types are avaliable! See JEI."
	]
	quest.1D0DFE2219A02B10.title: "Mob Seeds"
	quest.1E64CEE9C82A233F.quest_desc: ["Inhibits Teleportation for Entities up to 8 Blocks away. Can be attached on ANY side of Solid Blocks.  Right Click to Deactivate/Activate."]
	quest.1E90AB5E49CEED4B.quest_desc: ["Used in Immersive Engineering multiblock machines. See the manual or JEI for details."]
	quest.1ECA229DE8C00248.quest_desc: ["Crafted using the Atomic Reconstructor. See JEI."]
	quest.1EEED62EE765CA0D.quest_desc: ["Immersive Engineering is all about using multiblock machines to create your industrial revolution!"]
	quest.1F1D357B52EFF584.quest_desc: [
		"Different rituals may be performed at the altar, each one requiring different components and conditions to operate."
		""
		"A typical ritual is cast as follows: first, necessary items are placed on the altar, and necessary incense items are ignited. Make sure you don't have any extra ingredients in the altar, or extra incenses in the air, or the ritual will fail. Then, sneak-right-click the altar with an empty hand to begin the ritual."
	]
	quest.1F37B280738A6B66.quest_desc: ["Sift dirt in a sieve with a mesh to obtain pebbles of all types! Can be crafted into stone varients."]
	quest.1F7047C6351AA042.quest_desc: [
		"Liquid in a solid form; allows for easy transportation and alchemical processing."
		""
		"See The Hermetica for more details on Theurgy."
	]
	quest.1F7047C6351AA042.title: "Lava and Water"
	quest.203229D68F81B92F.quest_desc: [
		"There are six crafting crystals to Mystical Agriculture, instead of just two. The crystals are: Inferium, Prudentium, Tertium, Imperium, Supremium, and the Master Infusion Crystal."
		""
		"The recipes for the crystals are nested, so you can't just jump to a higher crystal without crafting the previous tier."
	]
	quest.20BE02827015CC81.quest_desc: ["Want an enchantment off of a tool or armor piece? Use this table!"]
	quest.2113D616855A2E8D.quest_desc: ["Refer to &oThe Big Book of Bees&r for in-game documentaion, as well as JEI for recipes and breeding information. Buzz Buzz!"]
	quest.211446D218E7E567.quest_desc: ["Made with energized steel."]
	quest.219E1914902D3479.quest_desc: ["Refer to &oThe Big Book of Bees&r for in-game documentaion, as well as JEI for recipes and breeding information. Buzz Buzz!"]
	quest.21BE81F18EF5C6B9.quest_desc: ["The Ender IO version of solar power."]
	quest.22979C118161AA3A.quest_desc: ["Autocrafter, upgraded to tier 3! Faster crafting speeds and increased pattern capacity."]
	quest.229AB36EAC2661CA.quest_desc: ["Training a Data Model can be done in one of two ways, with a Deep Learner or with a Simulation Chamber. The deep learner allows you to store a few data models within, and kills you receive will begin to train the model. All models start out in the Faulty state, and must be trained up to Basic in the deep learner."]
	quest.231C7D537D5F2334.quest_desc: ["More storage! Hover over the item to see slot and stack capacity."]
	quest.23890AEB2EA0F1AB.quest_desc: ["Storage parts can be used in crafting to create storage disks or storage blocks. As they increase in tier, the more stuff you can fit in them!"]
	quest.23B95448721F4E5B.quest_desc: ["Used in Immersive Engineering multiblock machines. See the manual or JEI for details."]
	quest.24036AE756D446CF.quest_desc: [
		"Elytra can be found on flying ships in End Cities."
		""
		"It can also be obtained as a drop when the Ender Dragon is defeated or via crafting."
	]
	quest.254643F9AD4978C1.quest_desc: ["Crafted from resources you will find in the Otherside."]
	quest.25603E442AE0E737.quest_desc: ["Crafted using the Empowerer. See JEI."]
	quest.256951CF16DDD508.quest_desc: ["Extended Crafting Tables are a set of tiered Crafting Tables that can be used to craft a variety of items. Each tier has a larger grid which can be used to craft higher tier items with more components."]
	quest.25B01D780EA5A73B.quest_desc: [
		"Make a portal from reinforced deepslate, just as you would a nether portal. To activate, click with the heart (obtained by defeating a Warden)."
		""
		"Remember, reinforced deepslate can be broken, it just takes a very long time to mine! Be careful where you place your blocks!"
		""
		"Deeper and Darker adds an entire new dimension — the Otherside — with much content to explore. Here's a list with some of the features!"
		""
		"Biomes: explore the deeplands, echoing forest, overcast columns, and blooming caverns."
		"Structure: find an ancient temple, the home of the warden! Just be cautious when breaking the ancient vases to avoid awakening an ancient lurker."
		"Blocks: over a hundred new blocks to build, including  gloomslate,  sculk stone, and a new  wood type!"
		"Items: a brand-new warden set of armor and tools, an  upgrade to elytra and the awesome  sculk transmitter!"
		"Mobs: 8 new mobs, including a miniboss!"
		"To enter the Otherside, kill the warden and use its heart. Play the mod to find more content and explore hidden mysteries!"
	]
	quest.25B01D780EA5A73B.title: "Into the Deep"
	quest.25C295D927D5496F.quest_desc: [
		"A device to extract Alchemical Sulfur from items using a Solvent."
		""
		"Place the cauldron on top of the braizer. Fill the braizer with blaze rods to heat the cauldron!"
		""
		"See The Hermetica for more details on Theurgy."
	]
	quest.2608543E104C6B3A.quest_desc: ["Autocrafter, upgraded to tier 5! Faster crafting speeds and increased pattern capacity."]
	quest.264DB832753EF79C.quest_desc: ["Check the Bumblezone advancements tab for what to do!"]
	quest.266043FC16E645A7.quest_desc: ["Once your model is Basic or higher, you can use the simulation chamber to run simulations of your model. Simulations will always produce a generalized prediction, and may also produce a Mob Prediction, based on the accuracy of the model. The higher tier of the model, the higher the accuracy, up to 99.5% at Self Aware. Running simulations requires energy (based on the model type) and a catalyst item, which is usually a Prediction Matrix."]
	quest.267870FD5D4C0BEA.quest_desc: ["Iron Jetpacks is a modern Jetpacks mod that is both feature-rich and easy to use. Jetpacks get better as you craft higher tiers. Coils are an integral part of the jetpack crafting process. See JEI."]
	quest.26D477BD067C71B2.quest_desc: ["Turns basic storage into copper storage. Click upgrade on storage to apply."]
	quest.2796FB3D93055E92.quest_desc: ["The Crafting Grid functions like a regular Grid but includes a crafting inventory."]
	quest.27AB2346C851E196.quest_desc: [
		"Bag of Holding, Tier 3. Max tier."
		""
		"Note: a bug exists in which sometimes bags may not be able to be opened. A game restart usually fixes the issue. A bug report has been submitted to the mod author."
	]
	quest.27F77909838C5A36.quest_desc: ["Power storage, tier 3."]
	quest.2825F162E89AF2F9.quest_desc: ["Links to drawers to allow mass control."]
	quest.285E4E9F3EC57A42.quest_desc: ["Hang Glider adds a hang glider (surprise!) to soar through the skies! Just jump off a high point (or jetpack up) and let your glider do the rest. Features very fluid and natural flight controls. And when you wanna go even quicker, reinforce your glider!"]
	quest.292DEF4DD1BAB2DF.quest_desc: ["The Singularity Tank is a basic fluid tank that will hold 32 Buckets of any fluid. Use it to store XP from your mob farm! You can also craft an XP Drain Singularity Tank to store player XP as liquid XP."]
	quest.29747C07922D623A.quest_desc: [
		"Use the Runic Tablet to guide you through the Roots mod."
		""
		"Some of what the mod has to offer:"
		"- Create spell powder using natural ingredients."
		"- Imbue magic wands to cast spells"
		"- Perform magical druidic rituals to summon creatures and create special tools and armor."
	]
	quest.2A56CF9CFDF0C615.quest_desc: ["Iron Jetpacks is a modern Jetpacks mod that is both feature-rich and easy to use. Jetpacks get better as you craft higher tiers. Coils are an integral part of the jetpack crafting process. See JEI."]
	quest.2AB4C39991F55BE0.quest_desc: ["The Crusher crushes, among other things, clumps into Dirty Dusts, Ingots into dusts and Biomatter into Bio Fuel. "]
	quest.2ADCBD5A7DFD1343.quest_desc: ["Higher tier versions of the tier 1 block gen. Faster yields!"]
	quest.2ADCBD5A7DFD1343.title: "Cobble Gens"
	quest.2B05E930558022BB.quest_desc: [
		"Alchemically pure gold. Acts as a catalysator, enabling various alchemical processes."
		""
		"See The Hermetica for more details on Theurgy."
	]
	quest.2B152316AC21184B.quest_desc: [
		"Crafters are machines added by RFTools that will automatically craft items given a recipe, the necessary components and RF power. Multi-step crafting can be done in a single machine, limited only by the number of recipe slots."
		""
		"Crafter Tier 1 can remember 2 recipes."
	]
	quest.2B2B99AC5FFD4B35.quest_desc: ["Used to craft tier 5 seeds."]
	quest.2BBBC49A831D9CA3.quest_desc: ["Insert leaves or saplings to create water."]
	quest.2BDCEF60F36F432C.quest_desc: ["Use this to craft your first Ender IO machines."]
	quest.2C4767FA88BA40F2.quest_desc: [
		"Welcome to Factory in the Sky 4 by MuggleOrWizard! Make sure to read all quest descriptions, as they will include useful information and helpful hints. "
		""
		"If you have any questions or comments while playing this modpack, feel free to leave a comment on the project page, send me a message on Curseforge, or join the Discord server. "
		""
		"To make or join an FTB team (for quests, chunk claiming, etc), click the teams icon in the upper left of your screen when your inventory is open. The quest book can be found there as well. "
		""
		"To learn about Skyblock teams (for individual/team islands), use the command /skyblock gui."
		""
		"If you have questions, make sure to check out the FAQ tab!"
		""
		"&2This pack is inspired by the modpack series \"Sky Factory\". If you haven't played it before, I highly recommend you check it out - you can find it on the Curseforge app.&r"
		""
		"Note: Many quest descriptions are taken from the related mod's respective wiki page or in-game guidebook. All credit remains with the mod authors."
	]
	quest.2C4767FA88BA40F2.quest_subtitle: "Read all quest descriptions!"
	quest.2CFD4DA376D7A95C.quest_desc: [
		"A Storage Housing is an empty storage disk or fluid storage disk without an assigned storage part or fluid storage part."
		""
		"It can be used to craft a new storage disk by combining it with the corresponding storage part or fluid storage part."
	]
	quest.2DBA62C991BAE9BE.quest_desc: ["Crafted using the Empowerer. See JEI."]
	quest.2E0F5CBC2BC6C08E.quest_desc: ["Most rituals, if not all, require incense to function. Incense braziers will only be counted if they are within a 9x9 area around the altar, and on the same level. Items may be placed within the brazier, and ignited with a flint and steel. An incense brazier can be extinguished by sneak-right-clicking with an empty hand."]
	quest.2E1691349A853A38.quest_desc: ["Tier 1 upgrade."]
	quest.2F0158FCC4479FEA.quest_desc: ["Made with blazing crystals."]
	quest.2FAE40B79BD639DF.quest_desc: ["Iron Jetpacks is a modern Jetpacks mod that is both feature-rich and easy to use. Jetpacks get better as you craft higher tiers. Coils are an integral part of the jetpack crafting process. See JEI."]
	quest.306E64FC75EFE513.quest_desc: [
		"A device to extract Alchemical Mercury from items."
		""
		"Place the distiller on top of the braizer. Fill the braizer with blaze rods to heat the distiller!"
		""
		"See The Hermetica for more details on Theurgy."
	]
	quest.30740B977370651A.quest_desc: ["Refer to &oThe Big Book of Bees&r for in-game documentaion, as well as JEI for recipes and breeding information. Buzz Buzz!"]
	quest.30DF604A86087BD9.quest_desc: ["Hang Glider adds a hang glider (surprise!) to soar through the skies! Just jump off a high point (or jetpack up) and let your glider do the rest. Features very fluid and natural flight controls. And when you wanna go even quicker, reinforce your glider!"]
	quest.30E7E3CAB4C5D408.quest_desc: ["Generate infinite lava (slowly)! Place into a fluid drawer."]
	quest.30F1482C50855B41.quest_desc: ["Stores power, upgradable."]
	quest.30F28A22E27DC72B.quest_desc: ["Similar to the mechanical hammer, but upgradable!"]
	quest.315952B82873034E.quest_desc: ["Energy storage for wireless power, see Powah manual for details."]
	quest.316C68682A9753C8.quest_desc: [
		"Converts mercery from its crystal form into its flux form."
		""
		"See The Hermetica for more details on Theurgy."
	]
	quest.317C6EFB5B68B18A.quest_desc: ["Maximize smelting efficiency with unparalleled speed, reconfigurable sides, augments for smoking and blasting, and much more."]
	quest.31BB2CF9E443BA95.quest_desc: [
		"The Disk Drive stores storage disks and fluid storage disks."
		""
		"By inserting storage disks, the Disk Drive expands the storage capacity of the storage network. The total available storage depends on the number and type of disks inside. Removing a disk will make its stored contents temporarily inaccessible until reinserted."
	]
	quest.31F347F5F9510959.quest_desc: ["Upgraded version of the importer. 18 filter slots."]
	quest.320003532E0C82AD.quest_desc: ["Power storage, tier 2."]
	quest.320EBC7E55C11D66.quest_desc: ["Turns gold storage into diamond storage. Click upgrade on storage to apply."]
	quest.321B7E28899ACCA1.quest_desc: ["Storage upgrade tier 3. Hover over item for details."]
	quest.3258ABB4591DE8AB.quest_desc: ["The energized smelter is your basic electric furnace that uses energy instead of fuel to smelt items. "]
	quest.336A9F5BA48F3C0F.quest_desc: ["Mob Fans are designed to allow players to push mobs all over the place in all directions even vertical. The Mob Fan Block has 3 upgrade options to expand it’s capabilities - Width, Height and Distance modifiers."]
	quest.3394B9E2F12D4183.quest_desc: [
		"The Osmium Compressor is used to create Refined Obsidian Ingots from Refined Obsidian Dust and Glowstone Ingots from Glowstone Dust."
		"It fuses liquid Osmium (melted down Osmium Ingots placed in the machine's bottom slot) with the originating materials to create their corresponding ingots. "
	]
	quest.33FB7358D155093C.quest_desc: ["Storage upgrade tier 1. Hover over item for details."]
	quest.342328DA4ECCD303.quest_desc: ["Blaze spawners can be found in a Nether Fortress."]
	quest.34D13D96646E6C3E.quest_desc: ["Consumes nearby leaves and turns them into power."]
	quest.3510D31502AB77AC.quest_desc: ["Infest a tree by clicking a silkworm on a leaf block. After spreading to the entire tree, break the infested leaves with a crook to obtain string. Silkworms can also be eaten."]
	quest.3510D31502AB77AC.title: "String Production"
	quest.352E2E7BCBC1E76E.quest_desc: [
		"Powah is a tech mod that adds Various ways to generate, store, and transmit Forge Energy. Read the book to find out all you need to know!"
		""
		"Mod Features:"
		"- Energy Storage (Energy Cell, Ender Network)"
		"- Ender Network (Ender Cell, Ender, Gate)"
		"- Generators (Furnator, Magmatic Generator, Thermoelectric Generator, Solar panel, Reactors)"
		"- Other Machines (Discharger, Energy Hopper, Player Transmitter)"
		"- Server Friendly Energy Cables."
		"- Waterlogging support."
		"- And more ..."
	]
	quest.352E2E7BCBC1E76E.title: "Powah"
	quest.35439E71E2C55399.quest_desc: [
		"The Harvester is a machine that will auto-harvest crops and re-plant them. Items collected by the Harvester are placed into it's internal inventory."
		"The Seed Reprocessor is a machine built for converting extra seeds into essences."
		"The Soul Extractor is a machine used for extracting Mob Souls from items into Soul Jars."
		"All three machines can be upgraded using Machine Upgrades."
		"The Tinkering Table allows you to put augments on mystical armor, tools, and weapons."
	]
	quest.35439E71E2C55399.title: "Mystical Machines"
	quest.35AC01269B4F9615.quest_desc: ["Iron Jetpacks is a modern Jetpacks mod that is both feature-rich and easy to use. Jetpacks get better as you craft higher tiers. Coils are an integral part of the jetpack crafting process. See JEI."]
	quest.36222893BBD14BCD.quest_desc: [
		"There are six crafting crystals to Mystical Agriculture, instead of just two. The crystals are: Inferium, Prudentium, Tertium, Imperium, Supremium, and the Master Infusion Crystal."
		""
		"The recipes for the crystals are nested, so you can't just jump to a higher crystal without crafting the previous tier."
	]
	quest.36F144C0C7F7C92A.quest_desc: [
		"The diamond ring is a crafting component for the angel ring."
		""
		"The Angel Ring mod adds an Angel Ring, which allows you to fly, like in a creative mode to help with building/travelling. Inspired by Extra Utilities' Angel Ring."
	]
	quest.36F1BE59B76BABFB.quest_desc: ["Use the Atomic Reconstructor and the Empowerer to turn minerals into powerful crystals that allow the creation of useful machines for processing and sorting items, lasers for wirelessly transporting energy, items and fluids, renewable oil to generate power, and much more."]
	quest.378335EBADF84878.quest_desc: ["Grants creative flight, apply to Supremium Chestplate using the Tinkering Table."]
	quest.37DEF911AA9FFE06.quest_desc: ["The Combiner allows the player to create an ore block from 8 dust. Place the ore dust in the top slot, and some cobblestone in the bottom slot, and it will combine to make the ore block."]
	quest.38401880D2434D5E.quest_desc: ["Catalysts are crafting components that will be needed to craft creative items."]
	quest.38606D62CAA33DB9.quest_desc: ["Burns oil and turns it into power."]
	quest.388B5215D86F32D7.quest_desc: ["Neural Processor is used to craft various high-tier storage network devices."]
	quest.38B43EC782FE2A6C.quest_desc: [
		"A simple device to increase the concentration of residual Sal Ammoniac in water by evaporation."
		""
		"Place the accumulator on top of the tank. Fill the accumulator with water and let the magic happen!"
		""
		"See The Hermetica for more details on Theurgy."
	]
	quest.38D56923F0F332A1.quest_desc: ["Each of the tiers adds more storage slots and more upgrade slots."]
	quest.39021A1451B84E37.quest_desc: ["Connect to your energy network to get infinite power!"]
	quest.3A136BC844853F33.quest_desc: ["Sometimes, building large structures can be a little tedious, and take a lot of effort. Not all of us are great builders you know! Dire's Building Gadgets aims to make building a little bit easier."]
	quest.3AE5706892FD387E.quest_desc: ["Catalysts are crafting components that will be needed to craft creative items."]
	quest.3BA7E85F45629218.quest_desc: ["Tier 4 Machine Frame. Requires Ether Gas."]
	quest.3BF8182FD2D9CE67.quest_desc: ["Check the Bumblezone advancements tab for what to do!"]
	quest.3D2A8B9B6B4A3579.quest_desc: ["Upgrade that voids excess items. Prevents systems from jamming up due to overflow."]
	quest.3EB503A7005EB307.quest_desc: ["Made with spirited crystals."]
	quest.3EBBAD557DA84CAD.quest_desc: [
		"There are six crafting crystals to Mystical Agriculture, instead of just two. The crystals are: Inferium, Prudentium, Tertium, Imperium, Supremium, and the Master Infusion Crystal."
		""
		"The recipes for the crystals are nested, so you can't just jump to a higher crystal without crafting the previous tier."
	]
	quest.40FD21F3F69ED1D2.quest_desc: ["Catalysts are crafting components that will be needed to craft creative items."]
	quest.41001B2CB88B422A.quest_desc: [
		"Crafted from resources you will find in the Otherside."
		""
		"Trouble finding scute? Try making a turtle seed (Haven Animal Seeds)!"
	]
	quest.414935E05F19594F.quest_desc: ["Storage upgrade tier 4. Hover over item for details. Upgradable to the Max Storage Upgrade."]
	quest.4155C829F6CEC3B8.quest_desc: ["Extended Crafting Tables are a set of tiered Crafting Tables that can be used to craft a variety of items. Each tier has a larger grid which can be used to craft higher tier items with more components."]
	quest.41BE21718BDF78C0.quest_desc: ["Similar to the mechanical sieve, but upgradable!"]
	quest.422C87E619A5A2A3.quest_desc: ["To obtain Ether Gas, place the stasis chamber down inside a wither-proof chamber, power it, and make the wither directly on top of it. Place the liquid laser base above the wither with a purple laser lens inside of it and four laser drills to the N/S/E/W. Power each drill, and pump the ether gas into a liquid tank!"]
	quest.422C87E619A5A2A3.title: "Ether Gas"
	quest.424B7B9044A540B2.quest_desc: ["Prevent mob spawns like a boss!"]
	quest.424B7B9044A540B2.title: "Magnum Torches"
	quest.426C4E86095CD928.quest_desc: ["A Gas-Burning Generator creates power by consuming any burnable gas for example the Hydrogen produced by an Electrolytic Separator or Ethylene."]
	quest.42CD986B61F11A7D.quest_desc: ["Each of the tiers adds more storage slots and more upgrade slots."]
	quest.42DB9B98EADB1583.quest_desc: ["Maximize smelting efficiency with unparalleled speed, reconfigurable sides, augments for smoking and blasting, and much more."]
	quest.435A7164843D2020.quest_desc: ["Generate infinite water! Place into a fluid drawer."]
	quest.4380FE8B9ED6C5BB.quest_desc: ["Refer to &oThe Big Book of Bees&r for in-game documentaion, as well as JEI for recipes and breeding information. Buzz Buzz!"]
	quest.4380FE8B9ED6C5BB.title: "Comb Collection"
	quest.4384694EA82E9FAC.quest_desc: ["Crafted using the Empowerer. See JEI."]
	quest.43CA20FEAD4350A8.quest_desc: ["Load chunks so stuff keeps on ticking when you aren't around."]
	quest.447D11B0652CD462.quest_desc: ["Control Circuits are key components in crafting Mekanism machines/tools. They are present in many recipes, and different recipes may require different tiers of Control Circuits. For example, an Energized Smelter would require Basic Control Circuits, but a Chemical Dissolution Chamber would require Ultimate Control Circuits. "]
	quest.44F3C05A8D41F74E.quest_desc: ["Made with niotic crystals."]
	quest.44F8DC14FD50BC67.quest_desc: ["Control Circuits are key components in crafting Mekanism machines/tools. They are present in many recipes, and different recipes may require different tiers of Control Circuits. For example, an Energized Smelter would require Basic Control Circuits, but a Chemical Dissolution Chamber would require Ultimate Control Circuits. "]
	quest.4524CA86DDA108A0.quest_desc: ["Automatically open those loot crates that keep dropping from your mob farm! (Hint: use hoppers or pipes for automation!)"]
	quest.4524CA86DDA108A0.title: "Loot Crate Automation"
	quest.456A3461BA56C7A2.quest_desc: ["Generates power from uraninite, upgradable."]
	quest.4591289F6470AA15.quest_desc: ["Refer to &oThe Big Book of Bees&r for in-game documentaion, as well as JEI for recipes and breeding information. Buzz Buzz!"]
	quest.4591289F6470AA15.title: "BaBee Bees"
	quest.45D3257582FF2B4E.quest_desc: ["Similar to the Storage Terminal, but with the addition of a crafting interface."]
	quest.460D718C94207286.quest_desc: [
		"An early-game way of getting plates and dust!"
		""
		"Try the Platinum Hammer as another method - better yields on some materials."
	]
	quest.46221AA1BB942A23.quest_desc: [
		"Fermentation aid for recipes in the fermentation vat."
		""
		"See The Hermetica for more details on Theurgy."
	]
	quest.46D79C3651ECA0AA.quest_desc: [
		"The flora in the world around you seem to have vast untapped power. What better way to access that than mashing them into a pulp? "
		""
		"Of course, to mash the aforementioned plants into a pulp, you're going to need something to mash with. The pestle, fashioned out of a smooth white stone, should do the task nicely. "
	]
	quest.46D79C3651ECA0AA.title: "Mortar and Pestle"
	quest.475AB61FBF6A58AF.quest_desc: ["Link two or more ender chests to transport and access items! Color code with dyes to pair chests together."]
	quest.47F2101828560520.quest_desc: ["Catalysts are crafting components that will be needed to craft creative items."]
	quest.48BCA06DC5AAD546.quest_desc: ["Catalysts are crafting components that will be needed to craft creative items."]
	quest.48EC17BA28863C7D.quest_desc: [
		"There are six crafting crystals to Mystical Agriculture, instead of just two. The crystals are: Inferium, Prudentium, Tertium, Imperium, Supremium, and the Master Infusion Crystal."
		""
		"The recipes for the crystals are nested, so you can't just jump to a higher crystal without crafting the previous tier."
	]
	quest.490558A8D30AA686.quest_desc: ["Turns diamond storage into netherite storage. Click upgrade on storage to apply."]
	quest.496E60A1B5AC534F.quest_desc: ["The Solar Generator harnesses sunlight to create power. The generator is particularly useful for generating passive energy for above-ground machines instead of draining your main stores. "]
	quest.4A2FA75BAF4E8D5C.quest_desc: ["Sift gravel for a chance to get iron ore chunks."]
	quest.4AAB77C213A1DDF0.quest_desc: ["Smelt Gravitite Ore in an Altar, using Ambrosium Shards as fuel."]
	quest.4AAB77C213A1DDF0.title: "Ambrosium and Gravitite"
	quest.4AE32EE74D37C1F2.quest_desc: ["The Pipez mod adds simple and highly configurable pipes that are designed to create as little lag as possible. Includes a highly configurable filter system and upgrade tiers. Now with Pretty x Smart Pipez resource pack!"]
	quest.4AE32EE74D37C1F2.title: "Pipez"
	quest.4B27559E6DAA0241.quest_desc: ["The fundamental unit of this mod is the Data Model - an item which holds information about an entity that you can utilize to generate their drops. To get a Data Model, you must first craft a Data Model Framework, and use it on the target entity to build the model. Once you have your model, you will have to train it."]
	quest.4B468B0B3CA361C3.quest_desc: ["The Pattern stores inputs and outputs for an autocrafting recipe. Recipes are assigned using a Pattern Grid."]
	quest.4B90C9FBF21772B7.quest_desc: ["The Exporter extracts resources from the storage network and inserts them into a connected external inventory."]
	quest.4BB13273E21BCA26.quest_desc: ["More storage! Hover over the item to see slot and stack capacity."]
	quest.4BB6701E9A458BBD.quest_desc: ["Insert into a drawer to get infinite items!"]
	quest.4BC99DFAF1C72844.quest_desc: [
		"Use obsidian blocks to make a frame and light the portal with a flint and steel. Make sure you have a lot of building blocks or a reliable form of flight before entering the Nether!"
		""
		"The Nether is a void world, but will generate fortresses and bastions."
		""
		"Consider using the Explorer's Compass to help find Nether structures!"
	]
	quest.4BC99DFAF1C72844.title: "Into the Nether"
	quest.4C70A88924BB2E10.quest_desc: [
		"Can be used in digestion, fermentation, and liquefaction recipes."
		""
		"See The Hermetica for more details on Theurgy."
	]
	quest.4CE7399112B2AE1B.quest_desc: ["Not all the ingots in the pack. But a lot of them."]
	quest.4CE7399112B2AE1B.title: "(Not) All The Ingots"
	quest.4D97B224A5F8DBEF.quest_desc: ["Wither Skeletons can be found in a Nether Fortress. Looting III enchantment is helpful!"]
	quest.4E075F85409EAE4A.quest_desc: ["Hostile Neural Networks is a mod that allows you to train data models and run simulations, producing mob predictions, which can be used to generate mob loot."]
	quest.4F10459F3FC2C422.quest_desc: ["Immersive Engineering multiblock machine. Assemble as a 2x2 and right-click with the engineer's hammer. Makes alloys from a variety of raw materials."]
	quest.4F10459F3FC2C422.title: "Alloy Kiln"
	quest.4F306F45E0D19583.quest_desc: [
		"To use wireless tools, the storage network must be accessible wirelessly by installing Wireless Transmitters in the network."
		""
		"The default range is 16 blocks but can be extended with range upgrades."
	]
	quest.4F306F45E0D19583.title: "Wireless Refined"
	quest.4F3AB6CE76783768.quest_desc: ["The Quantum Entangloporter from Mekanism is a machine that allows liquids/items/energy/gas to be sent from one Quantum Entangloporter to another through a channel. "]
	quest.4F65AF8D030E6284.quest_desc: ["Iron Spikes are a basic block that can be placed on any side of a solid block. Iron Spikes will damage mobs  and players when they come in to contact with them. Mobs will drop XP and their normal drops."]
	quest.5083FE77FC50B2B3.quest_desc: ["Immersive Engineering multiblock machine. Assemble as a 3x3 and right-click with the engineer's hammer. Uses coal and outputs coal coke and creosote oil."]
	quest.5083FE77FC50B2B3.title: "Coke Oven"
	quest.50860D1B56143535.quest_desc: ["Basic Processor is used to craft various storage network devices."]
	quest.509158ADD0513BD5.quest_desc: ["Your mortar and pestle yield a fine Spell Powder for use in spells, but it can't really be used on its own. With this device, you channel natural energies from that powder into a branch of wood. Simply place in a stick, place in your powder, and wait for your staff to pop out."]
	quest.50D092D124213599.quest_desc: ["Mob Predictions will need to be processed in a Loot Fabricator, a device which uses power to convert predictions to mob drops. The drops which are available are based on a list of pre-defined items, and a target can be selected for each type of model. The loot fabricator will remember your choices for each type, so you can feed multiple types of predictions into a single fabricator."]
	quest.5121E3A99D290288.quest_desc: ["Maximize smelting efficiency with unparalleled speed, reconfigurable sides, augments for smoking and blasting, and much more."]
	quest.51A0F730A8BC075C.quest_desc: ["Refer to &oThe Big Book of Bees&r for in-game documentaion, as well as JEI for recipes and breeding information. Buzz Buzz!"]
	quest.51DFACE8622E4E38.quest_desc: ["The Pattern Grid functions like a regular Grid but also supports creating patterns."]
	quest.51FD1757A28A3841.quest_desc: ["The Mekanism Jetpack is an item that allows the player to fly, equippable in the chestplate slot. It uses Hydrogen gas as a fuel."]
	quest.51FD1757A28A3841.title: "Mekanism Jetpack"
	quest.520CAB88B3A4C8F9.quest_desc: ["Improve the speed and other factors of your furnaces by utilizing augments!"]
	quest.520CAB88B3A4C8F9.title: "Furnace Augments"
	quest.529D5E5C6CF1B07F.quest_desc: ["Generates power from the sun, upgradable."]
	quest.52B992879E7B64AC.quest_desc: ["Use on leaves for a small chance to obtain silkworms and for a higher drop rate of saplings."]
	quest.539A30CE4D6252BE.quest_desc: ["Magic staves are very simple to use. Imbued with the power of nature, all you need to do is hold right-click to charge up a spell, and after about a second release right-click to cast it. Staves have limited uses, and will be destroyed completely after their charges are used up. The number of charges can be increased with the use of the efficiency modifier."]
	quest.539BCC229ED4AD1F.quest_desc: ["Combines mob souls with objects. Nothing dark about this at all..."]
	quest.53B292405012E269.quest_desc: ["Craft an iron pickaxe to get out of the stone age!"]
	quest.53DAE21458E08F56.quest_desc: ["Just like an item drawer, but holds fluids!"]
	quest.53FC75322EC8C32A.quest_desc: ["Connect a generator to the workbench with the wrench. Use the worbench to craft furniture!"]
	quest.53FC75322EC8C32A.title: "Furniture"
	quest.540D9B73F6F008FF.quest_desc: ["See JEI for a list of drops."]
	quest.548637FB72EA8FFE.quest_desc: ["Immersive Engineering multiblock machine. Assemble as a 3x3 and right-click with the engineer's hammer. Makes steel from iron and coal coke."]
	quest.548637FB72EA8FFE.title: "Blast Furnace"
	quest.54BB486DD1E7C37F.quest_desc: ["More storage! Hover over the item to see slot and stack capacity."]
	quest.551E3129CE26B9FC.quest_desc: ["Storage parts can be used in crafting to create storage disks or storage blocks. As they increase in tier, the more stuff you can fit in them!"]
	quest.553356616311C286.quest_desc: ["Crafted using the Empowerer. See JEI."]
	quest.555DD517DDA35D3D.quest_desc: ["Catalysts are crafting components that will be needed to craft creative items."]
	quest.55C4C5BD713B3D79.quest_desc: ["Breaks down blocks into other materials."]
	quest.56179A14BD445AD1.quest_desc: ["To spawn a Warden, use a Sculk Core on a Sculk Shrieker to allow it to spawn a Warden (following vanilla mechanics)"]
	quest.56179A14BD445AD1.title: "Warden Spawning"
	quest.56A9D71DA5C2F8F4.quest_desc: ["Holds a lot of one item type per drawer. Other varients avaliable. Upgradable."]
	quest.56D10C40E36A47F4.quest_desc: ["Auto-compact your ore chunks into ores!"]
	quest.56F6548EF39B593A.quest_desc: [
		"Bag of Holding, Tier 1. Upgradable."
		""
		"Note: a bug exists in which sometimes bags may not be able to be opened. A game restart usually fixes the issue. A bug report has been submitted to the mod author."
	]
	quest.571A4EE7257235E4.quest_desc: ["Kitchen makeover time!"]
	quest.571A4EE7257235E4.title: "Master Chef"
	quest.57775C40A0323450.quest_desc: ["Tier 2 upgrade."]
	quest.58621EB2F53BEB8C.quest_desc: [
		"Sophisticated backpacks is yet another backpack mod this time with backpack you can place in world, color in different color combinations, upgrade with more inventory and enhance with many functional upgrades."
		"Can be accessed using a key press (by default B)."
		"Curios compatibility makes it possible to wear and render the backpack when put in “Back” slot."
		"Backpacks can also be placed in world."
		"Each of the tiers adds more storage slots and more upgrade slots."
	]
	quest.586B7C66F5E95595.quest_desc: [
		"Bag of Holding, Tier 2. Upgradable."
		""
		"Note: a bug exists in which sometimes bags may not be able to be opened. A game restart usually fixes the issue. A bug report has been submitted to the mod author."
	]
	quest.592793FACB4C126F.quest_desc: ["Slay a ghast to obtain its tears."]
	quest.593865BD54A922BC.quest_desc: ["Refer to &oThe Big Book of Bees&r for in-game documentaion, as well as JEI for recipes and breeding information. Buzz Buzz!"]
	quest.5957F43864289ADB.quest_desc: [
		"Barrels are useful for creating blocks such as dirt, clay, soul sand, slime, and more! Stone barrel varient is also present. See JEI."
		""
		"To obtain dirt, put saplings, leaves, wood chippings, or other organic material into the barrel!"
		""
		"You can also make a dirt generator using water and witchwater - just like you would make a cobblestone generator with lava and water!"
	]
	quest.5A88EA080503F84F.quest_desc: ["Shulker Shells can be taken from Shulkers, which are found in End Cities."]
	quest.5A8DB7BC2F8142BF.quest_desc: ["Automatically sieve resources using the power of RF! Requires power and a mesh."]
	quest.5AF014F0A6385833.quest_desc: ["A Wind Turbine's giant blades harness the force of the wind to generate power. Each Wind Turbine requires a small 1x5x1 area (horizontally one block). The machine will generate the same power day and night, in sun or rain, but the turbine must have a clear view of the sky (over the rotor housing at the top of the tower). The power output increases linearly with its elevation."]
	quest.5B479E75F9EEFAEC.quest_desc: ["The starting way to get resources. Requires a mesh. Will accept gravel, sand, dust, and crushed blocks!"]
	quest.5B4D3648D7AC6CE2.quest_desc: ["The last magical ingredient needed to craft creative items!"]
	quest.5B647D338175C794.quest_desc: ["Crafted using the Atomic Reconstructor. See JEI."]
	quest.5B77DC0980506C5E.quest_desc: ["Insert a fluid to get infinite amounts of that fluid!"]
	quest.5C421BF33AF6C8E0.quest_desc: [
		"Extended Crafting adds more ways to craft items, more items to craft with, and more utilities for crafting. Work your way through this questline to be able to craft some op creative items!"
		""
		"Catalysts are crafting components that will be needed to craft the creative items."
	]
	quest.5C8AD9BC27B6067D.quest_desc: ["Refer to &oThe Big Book of Bees&r for in-game documentaion, as well as JEI for recipes and breeding information. Buzz Buzz!"]
	quest.5CB687981A0D80FA.quest_desc: ["Just like in vanilla, smelt iron ore to get iron ingots. Iron ore blocks can also be broken into raw iron."]
	quest.5D0AE110D2D9A741.quest_desc: ["Compacts compactable stored items."]
	quest.5D32FD49E536670A.quest_desc: ["Crafted using the Empowerer. See JEI."]
	quest.5D85F18A1A686CCB.quest_desc: ["Generates power from lava, upgradable."]
	quest.5DDB97B664715703.quest_desc: ["Used to hammer compressed blocks."]
	quest.5E420D5F38BFAC55.quest_desc: ["Improved Processor is used to craft various storage network devices."]
	quest.5EF1C9DC51DE2231.quest_desc: ["Generates power from coal and other burnable materials."]
	quest.5F156000CB4EA702.quest_desc: [
		"Place the Ender Crafter in-world and right-click to view the GUI. Inside there's a 3x3 crafting grid, similar to a Crafting Table. Place your recipe ingredients into the grid and the Ender Crafter should begin to craft."
		""
		"To increase crafting speed, place Ender Alternators around the Ender Crafter. Any Alternators placed within a 4 block radius will increase the crafting speed. You can tell they are working if they are emitting particle effects."
	]
	quest.5FAF91E1C7E3416E.quest_desc: ["Made with nitro crystals."]
	quest.5FB3D7A5823A2488.quest_desc: ["Turns iron storage into gold storage. Click upgrade on storage to apply."]
	quest.5FF0396BA3953492.quest_desc: [
		"Transports items. Can be placed in the same block as other Ender IO conduits."
		""
		"Note: EnderIO cables are known to sometimes cause lag. If you experience this, consider switching to a different cable type."
	]
	quest.5FF50DB367B692FB.quest_desc: ["Filters can be used in Ender IO conduits. More are avaliable, see JEI."]
	quest.5FF50DB367B692FB.title: "Filters"
	quest.5FF8A5308258D79E.quest_desc: ["Obtained by hammering cobblestone."]
	quest.6087919B30E9072D.quest_desc: ["This machine uses energy to extract dusts out of certain blocks and ores, making it essential to producing different kinds of tools. Not to be mistaken with the Crusher, this machine is the pulverizer equivalent in other mods. "]
	quest.60DD73D82D4272AA.quest_desc: ["Use in combination with blueprints to create various components for crafting!"]
	quest.61BAD11EB0BD237A.quest_desc: ["Put on slime boots and use your slime sling for fast travel! Be careful to aim correctly..."]
	quest.61BAD11EB0BD237A.title: "Slime Gear"
	quest.61EE7D1179D3B0A5.quest_desc: ["The Ender IO version of solar power."]
	quest.6200861F7728A0EE.quest_desc: [
		"Crafters are machines added by RFTools that will automatically craft items given a recipe, the necessary components and RF power. Multi-step crafting can be done in a single machine, limited only by the number of recipe slots."
		""
		"Crafter Tier 3 can remember 8 recipes."
	]
	quest.6285202A8CB4E4B7.quest_desc: ["Crafted using the Atomic Reconstructor. See JEI."]
	quest.630C712DB750FBD2.quest_desc: ["See JEI for a list of drops."]
	quest.6318A6EFA9477124.quest_desc: ["This is your starter generator for Industrial Foregoing."]
	quest.634A10A7851E5400.quest_desc: ["Crafted using the Atomic Reconstructor. See JEI."]
	quest.63BEE8BC6B4A8F10.quest_desc: ["Refer to &oThe Big Book of Bees&r for in-game documentaion, as well as JEI for recipes and breeding information. Buzz Buzz!"]
	quest.63C8B80E80540A4C.quest_desc: ["More storage! Hover over the item to see slot and stack capacity."]
	quest.63F2484A9589E343.quest_desc: ["Used in Immersive Engineering multiblock machines. See the manual or JEI for details."]
	quest.645E7116AA6DA20B.quest_desc: ["The Absorption Hopper is a block that will suck up any mob drops and experience orbs within it’s range. The Basic range for an Absorption Hopper is a 3 block radius - this can be increased with upgrades. "]
	quest.6487CFE6EBDB387F.quest_desc: ["Quartz Enriched Copper is used to craft Cable."]
	quest.64A049C85861827B.quest_desc: [
		"See JEI for a list of drops."
		""
		"Netherite Upgrade Smithing Template can be found in bastions in the Nether. Consider using an Explorer's Compass to help find the structures. It can also be crafted."
	]
	quest.64E08CAE267B2280.quest_desc: ["Link two or more ender tanks to transport and access fluids! Color code with dyes to pair tanks together."]
	quest.651C7084DCD9F58E.quest_desc: ["Refer to &oThe Big Book of Bees&r for in-game documentaion, as well as JEI for recipes and breeding information. Buzz Buzz!"]
	quest.654EC09E719A4989.quest_desc: ["Used to craft tier 2 seeds."]
	quest.65F53D31B4B971B0.quest_desc: [
		"Obtained by hammering netherrack, deepslate, and blackstone."
		""
		"Netherrack can be obtained via barrel mixing lava and witchwater, or make a netherite generator using lava and witchwater - just like you would make a cobblestone generator with lava and water!"
	]
	quest.65F53D31B4B971B0.title: "Other Crushed Blocks"
	quest.662B17346E82C135.quest_desc: [
		"A vat for alchemical fermentation, required for transmutation."
		""
		"See The Hermetica for more details on Theurgy."
	]
	quest.66C89A193D9A024F.quest_desc: ["Crafting ingredient. Made by combining planks and creosote oil."]
	quest.66F77941FEC7F2F3.quest_desc: [
		"Used as an ingredient and as an energy source."
		""
		"See The Hermetica for more details on Theurgy."
