	quest.0759CA52EECF3B49.quest_desc: ["The &n&5Plough&r will destroy any non-solid block, turn dirt into farmland and launch entities without doing damage. If it has a connected inventory, the items will be stored in it."]
	quest.083ABBA1C45FF960.quest_subtitle: "{atm9.quest.SG.subt.scythe}"
	quest.083ABBA1C45FF960.title: "{atm9.quest.SG.sickle}"
	quest.087F9C40B4545AE5.quest_desc: ["This is used to craft meshes, with the String Mesh being the first available. I recommend starting with a 3x3 sieve setup, but you can go bigger or smaller—it's completely up to you"]
	quest.0893EFCAC7031FEA.quest_desc: ["{atm9.quest.farm.desc.cake}"]
	quest.0893EFCAC7031FEA.title: "{atm9.quest.farm.cake}"
	quest.0945B6E883E32A90.quest_desc: ["By sieving dirt, you can obtain every color you’re looking for."]
	quest.0947B4ED95B0267E.quest_desc: ["{atm9.quest.SG.desc.coating}"]
	quest.0947B4ED95B0267E.quest_subtitle: "{atm9.quest.SG.subt.coating}"
	quest.0947B4ED95B0267E.title: "{atm9.quest.SG.coating}"
	quest.098649183C786A5A.quest_desc: ["{atm9.quest.storage.desc.module2}"]
	quest.098649183C786A5A.title: "{atm9.quest.storage.module2}"
	quest.09936F8FCEA72C5C.quest_desc: [
		"The &n&5Cart Assembler&r can be placed on tracks. Anything you build on top of it will be picked up by a Minecart if the Assembler has a redstone signal."
		""
		"The blocks must be glued together and any blocks requiring rotational force will automatically be working."
		""
		"To \"unmount\" the blocks from the Minecart, simply turn off the redstone signal and let the Minecart ride through."
	]
	quest.0A1C2A7A8617D3E4.quest_subtitle: "{atm9.quest.farm.subt.wheat}"
	quest.0A1C2A7A8617D3E4.title: "{atm9.quest.farm.wheat}"
	quest.0AB80C0705795BE0.title: "Epic"
	quest.0AC803ACD9A7FF2A.quest_desc: ["\"Silkworms infest leaves, and once the infestation spreads, breaking the leaves with your crook will yield string. String is vital for progression, so don’t skip this step. Luckily, these little worms work fast—so you won’t be stuck waiting for long."]
	quest.0CF69DBA9573A7B3.quest_desc: [
		"The Schematic Table will read and write structures to/from your schematics."
		""
		"You can use it to copy buildings or to share them with others!"
	]
	quest.0D26E5EF6CFCFDBF.quest_desc: ["{atm9.quest.SG.desc.knife}"]
