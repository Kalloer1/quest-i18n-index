	quest.58D5BD3106BFD94A.title: "{atm9.quest.farm.cookbook}"
	quest.59A3081002F16C28.quest_desc: [
		"\"Ahhh, hello hello! You've stumbled upon my Useful Blocks section!\""
		"Blocks! Yes, blocks — very helpful. Very... blocky. You get it."
		""
		"Anyyyywayyy, moving on:"
		"Here’s what I’ve got for you today:"
		""
		"A Healer — zap! Your team, good as new."
		""
		"A PC — store your precious creatures in the digital void. Safe-ish."
		""
		"Some fossil stuff — bones, rocks, ancient mystery. Very science."
		""
		"Gimmighoul-related oddities — rattly, spooky, mildly cursed."
		""
		"...And a grave."
		"We don’t talk about the grave. Seriously."
		"Don’t touch it. Don’t ask. Just... don’t."
		""
		"So! Interested in some delightfully useful, slightly ominous blocks?"
	]
	quest.59A3081002F16C28.title: "Helpfull Old Blocks"
	quest.5A51E26D66D1273B.quest_desc: ["{atm9.quest.farm.desc.flax}"]
	quest.5A51E26D66D1273B.quest_subtitle: "{atm9.quest.farm.subt.flax}"
	quest.5A51E26D66D1273B.title: "{atm9.quest.farm.flax}"
	quest.5A94A2664BFDD7B9.quest_desc: ["{atm9.quest.storage.desc.basic}"]
	quest.5A94A2664BFDD7B9.title: "{atm9.quest.storage.basic}"
	quest.5AB8651FCB1E2F72.title: "{atm9.quest.SG.elytra}"
	quest.5B36DE3826F26963.quest_desc: ["&n&5Shafts&r transfer rotational power without changing the speed of the gears."]
	quest.5DC892BA79EB52EC.quest_desc: ["The &n&5Mixer&r can be used combined with the Basin to craft."]
	quest.5DED4197DB2EEBBC.quest_desc: [
		"\"Ahhh yes, seeds and... other things!\""
		"One of each — only one. Why? Because they’re that rare. Scarce. Precious. Legendary, even. I’ve got a few red ones too — and those? Those are the rarest of the rare."
		"Trust me."
		"Or... trust the guy who told me. Either way, very exclusive stuff."
		""
		"Now over here, I’ve got these seeds — never grown a thing in their life. Cabbage and wheat, apparently. Never heard of ‘em."
		"I live on a strict lettuce-and-water diet, myself. Keeps the soul light."
		""
		"But yeah — real nature stuff. Totally eco-friendly."
		"I’m basically saving the planet. You’re welcome."
	]
	quest.5DED4197DB2EEBBC.title: "Seeds And Stuff"
	quest.5E4BC0F59C90433A.quest_desc: ["{atm9.quest.storage.desc.chest}"]
	quest.5E4BC0F59C90433A.quest_subtitle: "{atm9.quest.storage.subt.chest}"
	quest.5E4BC0F59C90433A.title: "{atm9.quest.storage.chest}"
	quest.5E4FE420B6D2C97F.quest_subtitle: "{atm9.quest.storage.subt.Acompacting}"
	quest.5E4FE420B6D2C97F.title: "{atm9.quest.storage.Acompacting}"
	quest.5EB36B3477BC9C64.quest_desc: [
		"Ah, yes... these dusty little bone things—\""
		"Er, I mean... archaeological masterpieces from a bygone age! Yes, yes, very rare, very historical. Found them buried deep in the earth — or maybe just under my rug, who knows?"
		""
		"Anyway... want one? They’re cheap. Practically giving them away."
		"(But don’t ask too many questions.)"
	]
	quest.5EB36B3477BC9C64.title: "Dusty Rocks I think...."
	quest.5EBCFDDB3D74F000.quest_desc: ["&cCurrently this item has no uses."]
	quest.5EE53C2C83F73244.quest_desc: [
		"To craft &n&5Shadow Steel&r simply throw one or more &n&5Chromatic Compound&r into the void."
		""
		"It will be converted and will levitate back up. A magnet is highly recommended!"
	]
