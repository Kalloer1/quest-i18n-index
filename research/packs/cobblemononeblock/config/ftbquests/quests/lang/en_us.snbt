	quest.122FBF5110E4CFF2.title: "{atm9.quest.storage.downgrade}"
	quest.12417572054691BE.quest_desc: [
		"Shinies – We All Love Them!"
		""
		"Shinies are a fan favorite, but they can be incredibly difficult to find. So, in this modpack, I've decided to introduce a fun twist: every \"Bioring Monday,\" shiny odds will be boosted to twice the normal rate!"
		""
		"The base shiny odds have also been adjusted from the original 1 in 8192 to 1 in 4096, making them more reasonable overall. This change is meant to make shiny hunting more enjoyable without removing the challenge entirely."
		""
		"Why the change? The old odds were just too high, and I personally prefer a slightly more generous system. Happy hunting, and may your Mondays be extra shiny!"
	]
	quest.12E5930AE01189AE.quest_desc: ["Cook this in a furnace to use it"]
	quest.1310C1E14C259807.quest_desc: ["{atm9.quest.storage.desc.framed}"]
	quest.1310C1E14C259807.title: "{atm9.quest.storage.framed}"
	quest.134BC365E77C6DB8.quest_desc: [
		"The &n&5Portable Interface&r works in pairs. You need to have one placed in the world and another one on a moving entity, like a Minecart."
		""
		"When the two interfaces are facing each other, they will link and transfer items between each other."
	]
	quest.139BBD408DFF5E8C.title: "Kitchen"
	quest.13AEBC331F29BC3D.quest_desc: [
		"&n&5Belts&r can be placed between two &n&5Shafts&r to transfer mobs/items or to simply transfer rotational energy from one point to another."
		""
		"The &n&5Shafts&r must be at either 45, 90 or 180 degrees from each other."
	]
	quest.13AFCD3B6F62B986.quest_desc: ["{atm9.quest.farm.desc.cool}"]
	quest.13AFCD3B6F62B986.title: "{atm9.quest.farm.cool}"
