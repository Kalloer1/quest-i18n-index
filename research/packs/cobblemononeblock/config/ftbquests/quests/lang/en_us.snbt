	quest.1F58AA51814C7568.quest_desc: ["&n&5Super Glue&r can be used to attach blocks to each other to move them with pistons or other means."]
	quest.1FE052F643401232.quest_desc: ["{atm9.quest.storage.desc.upgrade_base}"]
	quest.1FE052F643401232.quest_subtitle: "{atm9.quest.storage.subt.upgrade_base}"
	quest.1FE052F643401232.title: "{atm9.quest.storage.upgrade_base}"
	quest.1FE17B1C7C639F88.quest_desc: ["{atm9.quest.storage.desc.s_controller}"]
	quest.1FE17B1C7C639F88.title: "{atm9.quest.storage.s_controller}"
	quest.1FE5EC7B77697E1F.quest_desc: [
		"\"Right, right — held items! I think that’s what they’re called.\""
		"I mean, really, when you think about it... a Pokémon can hold anything, yeah? But that’s not the point."
		""
		"The point is — I’ve got the best of the best. Well... not all of them, but most. Maybe. Good ones though. Real good."
		"These beauties give Pokémon special effects in battle — real tactical stuff. Probably game-changing. Definitely mysterious."
		""
		"Take these funky glasses — no idea what they do, but they look incredible."
		"This black umbrella? Very ominous. Very protective. Probably rain-related."
		"And this weird ink I found? I mean... cough cough... type-changing ink, yeah. Totally legit. Very experimental. Super rare."
		""
		"So — you want power? Style? Mild confusion?"
		"I got you."
	]
	quest.1FE5EC7B77697E1F.title: "Items To Hold"
	quest.2098D8BFADB55D2A.title: "{atm9.quest.SG.lining}"
	quest.21234BB40DB05C78.title: "{atm9.quest.SG.bracelet}"
	quest.21CF93BDCE7BA2F9.quest_desc: [
		"To craft &n&5Refined Radiance&r simply throw one or more &n&5Chromatic Compound&r into the beam of an active &n&5Beacon&r."
		""
		"It will be converted and will start levitating. A magnet is highly recommended!"
	]
	quest.220EA0B486F33931.quest_desc: ["This is an extra-strong crook—and that’s pretty much it. It works just like a regular crook, but lasts longer and helps you gather even more efficiently."]
