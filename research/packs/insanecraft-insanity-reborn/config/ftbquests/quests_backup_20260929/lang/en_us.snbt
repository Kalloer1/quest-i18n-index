	file.0000000000000001.title: "InsaneCraft: Insanity Reborn"
	quest.0077643318330D5B.quest_desc: ["The base material of the mod. With a lil bit of lapis or amethyst, you can make a bunch of these, you will have to wait though."]
	quest.0077643318330D5B.quest_subtitle: "Ooh, Purple Gem"
	quest.026464312766749D.quest_subtitle: "Mod Recreator/Coding"
	quest.026464312766749D.title: "Dragon"
	quest.03710964378589DA.quest_desc: ["One of Mekanism's own generators you can make very easily in the early phases of the mod, &eWind Generators&r work very well, and they are height dependent. Put it at the world height and you can make a decent bit of power from it."]
	quest.03710964378589DA.quest_subtitle: "\"Windmill superior\" - MangoGamr"
	quest.040A2968F5D9ABDD.quest_desc: [
		"You ready to automate? &oNo?&r &lWell too bad.&r You may want to set some time to do all this. You do want that gauntlet, don't you?"
		""
		"(p.s. this quest page will get overhauled at a later time)"
	]
	quest.040A2968F5D9ABDD.quest_subtitle: "Any sanity left?"
	quest.04184E8D0FDDE50C.quest_desc: [
		"Welcome to InsanityCraft: Insanity Reborn, a fanmade remaster of the 1.12.2 modpack InsaneCraft, played by known YouTubers such as SSundee, JeromeASF and BiffleWiffle."
		""
		"Will you be the one to get the Infinity Gauntlet and all of its stones? Or will you lose your sanity in the process? Time will tell."
		"{@pagebreak}"
		"For now, I'd recommend you get some wood. You have to start somewhere. It is Minecraft after all. Mining is in the name."
	]
	quest.04184E8D0FDDE50C.quest_subtitle: "Gotta start somewhere"
	quest.04184E8D0FDDE50C.title: "The Beginning"
	quest.08BF00A95610F7AE.quest_desc: [
		"One of the newest biomes of the Nether Update (1.16, a rather old version at this point)."
		""
		"Quite handy to find enderman, and in return, get ender pearls en masse."
	]
	quest.08BF00A95610F7AE.quest_subtitle: "Zoop Zoop"
	quest.08BF00A95610F7AE.title: "Orb"
	quest.094BAB72ED95CA16.quest_desc: [
		"Congratulations on finishing the first chapter. That wasn't so bad, was it?"
		""
		"That's all for now."
		"{@pagebreak}"
		"&lSIKE.&r"
		""
		"You have only started one journey ahead of yourself. You did want a Infinity Gauntlet out of this, right?"
		"{@pagebreak}"
		"Well then, let's get moving to Chapter 2. It's time for you to learn mods. "
		""
		"&oBut the real question I have for you is..&r"
		"&dMagic&r or &bTech&r?"
		"Which appeals to you more? Time is ticking."
	]
	quest.094BAB72ED95CA16.quest_subtitle: "Two Paths Unlocked"
	quest.094BAB72ED95CA16.title: "Chapter Completed!"
	quest.09E9CD6B46CE474B.quest_desc: [
		"The 2nd to last best material of vanilla Minecraft."
		""
		"Best to get mining. Unlock the &4Nether&r, new resources await you."
	]
	quest.09E9CD6B46CE474B.quest_subtitle: "🎶 Mine Diamonds... I'll mine them all! 🎶"
	quest.09E9CD6B46CE474B.title: "Diamonds!"
	quest.0A18530E57B71AC5.quest_subtitle: "Gotta Go To X10,000 Z10,000"
	quest.0D405CCB1C8770E7.quest_desc: ["With this machine, you can improve the ratios for making stuff like steel, infused alloy and more just by putting the infused material in here!"]
	quest.0D405CCB1C8770E7.quest_subtitle: "Seems pretty refined to me."
	quest.0DC7553306F8BF2F.quest_subtitle: "The power is in you"
	quest.0DC7553306F8BF2F.title: "Iron man, fully"
	quest.11977BDD5F42BC5C.quest_desc: ["&o\"Hello, good people!\"&r"]
	quest.11977BDD5F42BC5C.quest_subtitle: "Pack Owner/Dev of Insanity Powers"
	quest.11977BDD5F42BC5C.title: "Layla"
	quest.139605DCFB5A454D.quest_desc: [
		"I'm sorry to say this, but I have taught you enough of the basics."
		""
		"From here you need to work towards &dAtomic Alloy&r, you will need a bunch of this in the future."
		""
		"[ \"If you need any help, you may refer to the \", { \"text\": \"Mekanism Wiki\", \"underlined\": true, \"clickEvent\": { \"action\": \"open_url\", \"value\": \"https://wiki.aidancbrady.com/\" } }, \", or Reddit, I'm not your mother.\" ]"
	]
	quest.139605DCFB5A454D.quest_subtitle: "Step 4: You're On Your Own."
	quest.1547A0EDD6685E16.quest_subtitle: "Make sure you've got plenty of power for this mod"
	quest.1547A0EDD6685E16.title: "No Power?"
	quest.1830B963F5EDCADB.title: "Crafting The Crystal Matrix Ingot"
	quest.1A3937AD0B9C7EB4.quest_subtitle: "Worked on Lost Infinity"
	quest.1B7B80BDC4ABFFA8.quest_subtitle: "Quest Maker"
	quest.1B7B80BDC4ABFFA8.title: "CRAFTING_TEA"
	quest.1BBBA3E867CE20A7.quest_subtitle: "Beta Tester/Idea Giver"
	quest.1CCD305C6757558B.quest_desc: [
		"&1Ahem.&r"
		""
		"If you haven't made a decent sword that can deal decent damage, please do so. Fight back. Get mad."
		""
		"You get a shield out of it, so hey. Compensation."
	]
	quest.1CCD305C6757558B.quest_subtitle: "\"Enough of the iron jokes, they are way too ironic.\""
	quest.1CCD305C6757558B.title: "Too much iron"
	quest.1DE88FFB9FFCBEB6.title: "The Start To Power"
	quest.1EE247D244A855C5.quest_desc: [
		"One step closer to feeling safer. "
		""
		"Enchanting is a very worthwhile investment. Given how much mobs can pack a punch, this is a good idea to do. Do look into Apotheosis later. The mod provides better enchants later."
	]
	quest.1EE247D244A855C5.quest_subtitle: "Getting stronger huh.."
	quest.1EE247D244A855C5.title: "This is getting out of hand"
	quest.24F79CB8F072BE8C.quest_desc: [
		"Found some ores? I'd smelt them. "
		""
		"All of those metals have a use, &9&oone way or another&r&r."
		""
		"You'll see."
	]
	quest.24F79CB8F072BE8C.quest_subtitle: "So. Many. Metals."
	quest.24F79CB8F072BE8C.title: "Metallurgy"
	quest.25D19998746F529F.quest_desc: [
		"Finally, something worth the time. A iron pick."
		""
		"Be sure to make a few of these if you need to."
	]
	quest.25D19998746F529F.quest_subtitle: "Yearn for the mines"
	quest.25D19998746F529F.title: "You're a [Miner], Harry"
	quest.2734877104C128DA.quest_desc: [
		"This Quest line will get added in the next update"
		""
		"While this quest line gets worked on go checkout the marvel superheroes mod in the meantime"
	]
	quest.2A09AE701B367F3C.quest_desc: [
		"Any knowledgeable person will know without power, you can't make a machine run."
		""
		"The same applies in modded Minecraft."
		""
		"Without &4FE (Forge Energy)&r, you can't make any tech run for you."
		"{@pagebreak}"
		"Of all the tech mods there is, &eMekanism&r is one of the more well-known ones out there. From generators that can make millions of FE, to machines that can (up to) give upwards to five ingots per ore, this mod can do a lot."
		""
		"To start out, get a burnable generator of the sort, any of the ones showed can work fine, I'd recommend a &zHeat Generator&r though."
	]
	quest.2A09AE701B367F3C.quest_subtitle: "Step 1: Power"
	quest.2A09AE701B367F3C.title: "Technological Beginnings"
	quest.2AE6A5933614E5CF.quest_subtitle: "Programmer"
	quest.2C122D7C04D180AD.quest_desc: ["Your first entry to spells is with the Basic Spell Book. From there you can do a basic spell like that of Magic Missile from Harry Potter! Or if you want to, a simple mining spell!"]
	quest.2C122D7C04D180AD.quest_subtitle: "Entry to Spells"
	quest.2CF6B55B94276FB2.quest_desc: [
		"Steel. A fundamental alloy in the real-world with a multitude of uses."
		""
		"Whether it be for construction, vehicles, tools or machinery."
		"{@pagebreak}"
		"Mekanism requires that quite frequently for a lot of their machines. In order to create it however, this is where the Metallurgic Infuser takes its shine."
		""
		"Per steel ingot, you will need two coal and one iron ingot. This will be improved when you get into the &7Enrichment Chamber&r, more on this later. For now, get enough steel to get yourself a &8Steel Casing&r."
	]
	quest.2CF6B55B94276FB2.quest_subtitle: "Yeah no. Puns aren't stopping here."
	quest.2CF6B55B94276FB2.title: "Step 3: Steel-ing My Honor"
	quest.2F5B3D1A5B3A80C7.quest_desc: [
		"One of many dimensions you'll be going through. "
		""
		"You will be back here many times for various things. "
	]
	quest.2F5B3D1A5B3A80C7.quest_subtitle: "\"The Nether.\""
	quest.2F5B3D1A5B3A80C7.title: "You will die here"
	quest.3037639BCCEAC47C.quest_desc: [
		"Diamonds isn't always the easiest to find in here, given all the ores all about. "
		""
		"But there is a way of keeping yourself protected, and also make sure you're keeping up with the line, armor like this can help."
	]
	quest.3037639BCCEAC47C.quest_subtitle: "A Significant Upgrade"
	quest.3037639BCCEAC47C.title: "Steel Soldier"
	quest.3077E87C8D3803D5.quest_desc: [
		"Starting a mod like &dArs Nouveau&r is easy, but once you get into spellcasting, it is tricky."
		""
		"But you will need a abundance of archwood for the early bit."
		""
		"Gather some of the archwood you have on you, and make a Imbuement Chamber, you will need this for &5Source Gems&r!"
	]
	quest.3077E87C8D3803D5.quest_subtitle: "The Magic is All Around You"
	quest.3077E87C8D3803D5.title: "Get Imbued On!"
	quest.31BAFA0A9E85DED0.quest_subtitle: "\"So you picked Tom's. Very well.\""
	quest.31BAFA0A9E85DED0.title: "Red Pill"
	quest.32BB4BCEB8454469.quest_desc: ["A pretty nice upgrade to the furnace you have currently."]
	quest.32BB4BCEB8454469.quest_subtitle: "\"Butter Furnace, more like.\""
	quest.340382043781E00A.quest_desc: ["Feel free to join the Discord! We appreciate any new users, and any feedback or suggestions can be given to the team!"]
	quest.340382043781E00A.title: "Discord!"
	quest.3569E54E79DEB8E9.quest_desc: [
		"Some of the blocks with this mod will require &o&5source&r, a magical fluid that can speed up your source gem production, or for bees to be crafted."
		""
		"These sourcelinks help with generating this."
	]
	quest.3569E54E79DEB8E9.quest_subtitle: "Make that funny juice."
	quest.3569E54E79DEB8E9.title: "Generating Source"
	quest.35E4100D27491343.quest_desc: ["We appreciate anyone that has played this modpack whether it's to full completion or even for a little bit. So thanks from all of us on the team."]
	quest.35E4100D27491343.quest_subtitle: "\"Thanks to viewers like you!\""
	quest.381E9C4056590B08.quest_desc: ["Its a Start But It'll Take Forever This Way, I Recomend Making Multiple and There Upgrades."]
	quest.3A9E431D71E0C073.quest_subtitle: "Optimization/Coding"
	quest.3A9E431D71E0C073.title: "Iacchus"
	quest.3B295DB333281CA2.quest_desc: ["Ars Nouveau has its own way of making enchanted books, items and such and that's with the Enchanting Apparatus. Be sure to have the Arcane Core under it, otherwise it will not work."]
	quest.3B295DB333281CA2.quest_subtitle: "Not Just Enchanting"
	quest.3B295DB333281CA2.title: "The Enchanting Apparatus"
	quest.3B36D92C11DA3BB8.quest_desc: ["There is FTB Chunks in this pack, to use it simply open your map with &6M&r, then in the top left there is a &aClaimed Chunks&r icon, or you could simply press &6C&r. \\n\\nTo claim a chunk, left click and drag to claim.\\n\\nTo force load a chunk, shift-left click the chunk. If done properly, you'll see lines across the chunk."]
	quest.3B36D92C11DA3BB8.quest_subtitle: "This is my area! Mine mine mine!"
	quest.3B36D92C11DA3BB8.title: "Chunks"
	quest.3D412B0CEFE9D6C8.quest_desc: [
		"&o\"This is your last chance. After this, there is no turning back.\"&r"
		""
		"Take the &4red&r pill and you'll be working with &6Tom's Simple Storage&r, or you can take the &3blue&r pill and you can work towards &bApplied Energistics 2&r."
		""
		"&o\"Remember, all I'm offering is the truth - nothing more.\"&r"
	]
	quest.3D412B0CEFE9D6C8.quest_subtitle: "\"You can take the blue pill or the red pill.\""
	quest.4011689D60029C01.title: "Wyvern Tools"
	quest.4069C52CF8D479A1.quest_desc: ["When you unlock your first suit, you may need to charge it. This is what the Suit Charger comes in for!"]
	quest.4069C52CF8D479A1.quest_subtitle: "I am Iron-Man!"
	quest.4283A72DF568588C.quest_desc: ["The current mod, Marvel Superheroes, will be replaced with Insanity Powers, once it is more stable! For now, enjoy this mod with what it can do!"]
	quest.4283A72DF568588C.quest_subtitle: "[This questline is bound to change!]"
	quest.4437493813BAA2A3.quest_desc: ["&o\"You know what's better than a demon? A cambion.\"&r"]
	quest.4437493813BAA2A3.quest_subtitle: "Quest/Recipe Maker"
	quest.4437493813BAA2A3.title: "Joro"
	quest.448A6A838C5BB8EB.quest_desc: [
		"Spells. Curios. Companions that can help you."
		""
		"All of these, can be yours with a deposit of 16 archwood logs."
		""
		"From there, you will get the basics of &dArs Nouveau&r."
	]
	quest.448A6A838C5BB8EB.quest_subtitle: "\"Those who don't believe in magic will never find it.\" - Roald Dahl"
	quest.448A6A838C5BB8EB.title: "&dMagic"
	quest.4962EFA506A1D11A.quest_desc: [
		"I hope I didn't lose you there. But you got yourself into this mess and you can't go back."
		""
		"If you wish to pick your path of mods, I need a starting item of the appropriate branch you are going."
		""
		"The decision is again yours: &bTech &ror &dMagic&r, you will be back here one way or another."
	]
	quest.4962EFA506A1D11A.quest_subtitle: "Remember that decision?"
	quest.4962EFA506A1D11A.title: "Chapter 2"
	quest.4AA3BBE631909B07.quest_desc: ["This pack's quests and recipes are not complete, and can/will be changed in the future of this modpack's timeline. "]
	quest.4AA3BBE631909B07.quest_subtitle: "Please read!"
	quest.4AA3BBE631909B07.title: "Reminder!"
	quest.4B4834DB15B16F7D.title: "Wyvern Armor"
	quest.4B4BAE3F1B05A3A8.quest_desc: [
		"&1This is not Team Fortress 2, this is InsanityCraft.&r"
		""
		"Anywho. Find yourself (or your teammates) a Nether Fortress. Watch out for the hostiles around you, like Wither Skeletons and Blazes."
	]
	quest.4B4BAE3F1B05A3A8.quest_subtitle: "Team For-"
	quest.4B4BAE3F1B05A3A8.title: "The Fortress"
	quest.4F849E5D9AFE9F88.quest_desc: [
		"Welcome to Chapter 3!"
		""
		"Sanity Check! You good still?"
		""
		"Yeah? No? Well we will see after this. It's time to get a injection!"
		"{@pagebreak}"
	]
	quest.4F849E5D9AFE9F88.quest_subtitle: "\"Superheroes aren't real!\""
	quest.51CDBC30C780F0C2.quest_subtitle: "\"So you picked AE2, very well.\""
	quest.56F134E8DA292511.title: "Long Ingot Making"
	quest.584CECA114ED12D0.title: "Diamond to Wyvern"
	quest.5B046E2BB0500A5F.quest_subtitle: "Time to Fight the Dragon"
	quest.5B046E2BB0500A5F.title: "How Could you Take it?"
	quest.5BE58BB7802AFE23.quest_desc: [""]
	quest.5BE58BB7802AFE23.quest_subtitle: "Playtester/Bug Finder"
	quest.5BE58BB7802AFE23.title: "MangoGamr"
	quest.5C030C5861F88A38.quest_subtitle: "Youll also need some kind of high energy transfer rate"
	quest.60CF367C4D000FCE.quest_subtitle: "We've been awaiting you."
	quest.60FF7EB2E027DC0E.quest_desc: [
		"Stone, Cobblestone, Smooth Stone, whatever."
		""
		"You get the point. A common material always readily available to you. Get some of it for now. Upgrade those tools of yours. I suggest a paxel or a AIOT for less clutter in your inventory."
	]
	quest.60FF7EB2E027DC0E.quest_subtitle: "\"Sometimes we must be like stone, strong enough on our own.\""
	quest.60FF7EB2E027DC0E.title: "Cobble Cobble"
	quest.627F17A329AD2A10.quest_desc: [
		"Oh, a classic, Loot Bags."
		""
		"They give a random assortment of items. It all depends on what tier of loot bag you get, whether it be common, rare, or even a Legendary. Try your luck and see."
		"{@pagebreak}"
		"Definitely try to get to automating for these. Just you wait."
	]
	quest.627F17A329AD2A10.quest_subtitle: "Give me all the things!"
	quest.627F17A329AD2A10.title: "Loot goblin"
	quest.643AEE8CC5A23943.quest_subtitle: "Mmm Food"
	quest.65969DC520C7945D.quest_desc: ["With this mod, you can make all sorts of suits for various superheroes. Some of which are made with the Tailoring Table."]
	quest.65969DC520C7945D.quest_subtitle: "Making Basic Suits"
	quest.6727EF79A04C6638.quest_subtitle: "Youll need to get many of them"
	quest.6727EF79A04C6638.title: "Dont Lose These"
	quest.67DFC5F34CF23198.quest_desc: [
		"As you progress through Mekanism, you'll be constantly going through many pickaxes, likely vanilla ones, if you're new to modded."
		""
		"I'd recommend you make something stronger, like that of a Steel Pickaxe, which has 500 durability, which while not much more durable than diamond, but it will make that mining trip easier."
	]
	quest.67DFC5F34CF23198.quest_subtitle: "Finally Something with Decent Durability"
	quest.67DFC5F34CF23198.title: "Stronger Tools"
	quest.68F4293F2A430717.quest_desc: ["If you want to create a team for you and your friends, to betray (or not) use the command &a/ftbteams party create (name of team)&r to create the team!"]
	quest.68F4293F2A430717.quest_subtitle: "\"Two heads are better than one, and a teams of heads is even better.\""
	quest.68F4293F2A430717.title: "Teams"
	quest.6937A363677CC57E.quest_desc: [
		"Alrighty. Now that you have power, it's time for your first machine!"
		""
		"The &8Metallurgic Infuser&r from &eMekanism&r is a machine that takes in power with two materials to make another item in return."
		""
		"For this quest, make the machine, and place it next to the generator you decided on. I'll teach you what materials you can make with this shortly."
	]
	quest.6937A363677CC57E.quest_subtitle: "Step 2: Metallur- wha?"
	quest.6937A363677CC57E.title: "Infusing w/ Energy"
	quest.6B66589B7C78CBFA.quest_desc: [
		"We have FTB Essentials, so we have some handy commands for you all!"
		" "
		"&e/sethome and /home&r will set a home command at your current position, and send you back there as needed."
		"&e/rtp&r will send you to a random location, be wary this does have a cooldown however."
	]
	quest.6B66589B7C78CBFA.quest_subtitle: "Wrong lever!"
	quest.6C60EFD6DA80EA30.quest_desc: ["You may wonder why your spell book is nearly empty, well that's because you need glyphs! Glyphs are back bone for any spell with Ars Nouveau."]
	quest.6C60EFD6DA80EA30.quest_subtitle: "More Spell Aspectus"
	quest.6CAC4535E1252AAE.quest_desc: [
		"Sometimes a machine or pipe will need some guidance to input/output as needed. This is where the &bConfigurator&r comes in handy. When crouching and scrolling with your scroll bar on your mouse, it will go through different modes, as displayed on your action bar."
		"{@pagebreak}"
		"The reward for this is a &bConfiguration Card&r, useful for copying machine settings and pasting on others."
	]
	quest.6CAC4535E1252AAE.quest_subtitle: "\"Have I thrown a wrench in your plans?\""
	quest.6DCF6A38DB531B0E.quest_desc: ["As you upgrade through Mekanism, you will see these alot and these have to be upgraded each time for more advanced machines."]
	quest.6DCF6A38DB531B0E.quest_subtitle: "The Brains of the Operation"
	quest.6DCF6A38DB531B0E.title: "Early Circuitry"
	quest.6F0718A3F0C741A4.quest_desc: ["[ \"As denoted \", { \"text\": \"here\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"4AA3BBE631909B07\" } }, \", there is changed recipes. You will find out later what these are, unless you look ahead. Just know this now. You will hate the late to end game.\" ]"]
	quest.6F0718A3F0C741A4.quest_subtitle: "Oh hey, it's the other part of Minecraft!"
	quest.70DEE5D716B6C203.quest_desc: [
		"Machines. Powered tools. Jetpacks."
		""
		"All of that will be unlocked through this path. "
		""
		"Just get me a block of Osmium and I'll walk you through &3&oMekanism&r."
	]
	quest.70DEE5D716B6C203.quest_subtitle: "\"It's not that we use technology, we live technology.\" - Godrey Reggio"
	quest.70DEE5D716B6C203.title: "&bTech"
	quest.715BD58FBB777321.quest_desc: [
		"The end game boss drop of Ars Nouveau's progress."
		""
		"You need this later for a Tier 3 spellbook, among other things."
		""
		"Be sure to gather some extra."
	]
