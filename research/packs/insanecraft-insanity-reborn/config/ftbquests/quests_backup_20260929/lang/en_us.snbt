	quest.757136E9D056A539.title: "The smoky man"
	quest.76FB8414C960EA9E.quest_desc: ["With a bit of copper and redstone, you get your first compound/modded material, &cInfused Alloy&r. This is needed for a bit of early crafts and as such, later on, upgrades."]
