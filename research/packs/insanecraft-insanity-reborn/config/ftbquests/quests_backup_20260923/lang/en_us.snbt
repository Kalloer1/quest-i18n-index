	quest.026464312766749D.title: "Dragon"
	quest.040A2968F5D9ABDD.quest_desc: ["You ready to automate? &oNo?&r &lWell too bad.&r You may want to set some time to do all this. You do want that gauntlet, don't you?"]
	quest.040A2968F5D9ABDD.quest_subtitle: "Any sanity left?"
	quest.04184E8D0FDDE50C.quest_desc: [
		"Welcome to InsanityCraft: Insanity Reborn, a fanmade remaster of the 1.12.2 modpack InsaneCraft, played by known YouTubers such as SSundee, JeromeASF and BiffleWiffle."
		""
		"Will you be the one to get the Infinity Gauntlet and all of its stones? Or will you lose your sanity in the process? Time will tell."
		"{@pagebreak}"
		"For now, I'd recommend you get some wood. You have to start somewhere. It is Minecraft after all. Mining is in the name."
	]
	quest.04184E8D0FDDE50C.quest_subtitle: "Gotta start somewhere"
	quest.04184E8D0FDDE50C.title: "The Beginning"
	quest.08BF00A95610F7AE.quest_desc: [
		"One of the newest biomes of the Nether Update (1.16, a rather old version at this point)."
		""
		"Quite handy to find enderman, and in return, get ender pearls en masse."
	]
	quest.08BF00A95610F7AE.quest_subtitle: "Zoop Zoop"
	quest.08BF00A95610F7AE.title: "Orb"
	quest.094BAB72ED95CA16.quest_desc: [
		"Congratulations on finishing the first chapter. That wasn't so bad, was it?"
		""
		"That's all for now."
		"{@pagebreak}"
		"&lSIKE.&r"
		""
		"You have only started one journey ahead of yourself. You did want a Infinity Gauntlet out of this, right?"
		"{@pagebreak}"
		"Well then, let's get moving to Chapter 2. It's time for you to learn mods. "
		""
		"&oBut the real question I have for you is..&r"
		"&dMagic&r or &bTech&r?"
		"Which appeals to you more? Time is ticking."
	]
	quest.094BAB72ED95CA16.quest_subtitle: "Two Paths Unlocked"
	quest.094BAB72ED95CA16.title: "Chapter Completed!"
