	quest.5592D2FAAD06041E.quest_desc: [
		"The {bold}Digital Miner{/r} is the ultimate mining machine. "
		""
		"Configure it using 'Filters' (tags or items) to teleport blocks directly into its inventory. In Skyblock, this is perfect for 'mining' compressed blocks or generated platforms."
	]
	quest.5592D2FAAD06041E.title: "The Digital Miner"
	quest.55EB7DED6C00C8D1.quest_desc: [
		"The {bold}Atomic Disassembler{/r} is the only tool you'll ever need. "
		""
		"It functions as a Pickaxe, Shovel, Axe, and Hoe. Shift-Right Click to change mining modes (Normal, Slow, Fast, Vein, Extended Vein)."
	]
	quest.55EB7DED6C00C8D1.title: "Atomic Utility: The Disassembler"
	quest.55F29A7414A84178.quest_desc: ["If you throw some Dust into Witch Water, you will get clay? You'd have thought it to have been something else."]
