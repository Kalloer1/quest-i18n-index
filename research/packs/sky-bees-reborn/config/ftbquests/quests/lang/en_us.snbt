	quest.79A83700027E7AEB.title: "Echoing"
	quest.79E1E4CC0E2CA859.quest_desc: ["Throw some &a&lSugar&r&r into a barrel filled with &a&lWitch Water&r&r and you will get a sticky item in return"]
	quest.7A1B5EF3656E3C8D.quest_desc: ["Putting a &aCamp Fire&r under a vanilla Hive will stop the bees from attacking when harvesting honey or using a Bottle on the Hive."]
	quest.7A1B5EF3656E3C8D.title: "Campfire"
	quest.7A1B88DA8625196B.quest_desc: [
		"The final evolution. The {bold}Meka-Suit{/r} uses power to shield you from all damage, grant flight, allow underwater breathing, and much more."
		""
		"Install {bold}Modules{/r} in the Modification Station to customize your abilities."
	]
	quest.7A1B88DA8625196B.title: "The Meka-Suit"
	quest.7A27866F91C412E6.quest_desc: [
		"The {bold}Gas-Burning Generator{/r} is the king of mid-game."
		""
		"Process Bio Fuel into Ethylene in a {bold}PRC{/r} and burn it here for massive FE gains."
	]
	quest.7A27866F91C412E6.title: "Mid-Game Power: Gas Burning"
	quest.7B0BED08B15A57D2.quest_desc: ["To get Witch Water. Simply throw some Mycelium Spores into water!"]
	quest.7B644BBEC3A772E5.quest_desc: [
		"You need to be level 60+ to infuse this"
		""
		"{image:kubejs:textures/quests/enchant_infused_deepshelf.png width:130 height:100}"
	]
	quest.7C41A6CF62B24FFB.quest_desc: [
		"Since there is no Bedrock around, you will have to find other ways to get some &0&lFlux Dust&r&r."
		""
		"Try Sieving some &0&lCrushed Blackstone&r&r!"
	]
	quest.7C41A6CF62B24FFB.title: "Starting Flux Networks"
	quest.7E48A15A0DB29085.quest_desc: ["This is part of the &a3x3 Multiblock&r and is where all the combs are sent. You can either extract from this with pipes etc, or you can place a chest next to it!"]
	quest.7E9CA0822A5A7E11.quest_desc: [
		"Place this machine in the sun. Feed it Nuclear Waste to create {cyan}Polonium{/r} or {cyan}Plutonium{/r}."
		""
		"These pellets are the key to the Endgame."
	]
	quest.7E9CA0822A5A7E11.title: "Solar Neutron Activation"
	quest.7FDF4DBE9D31F0B6.quest_desc: ["Use some of that Bone Meal on the grass. Break it and find out if you are lucky or not!"]
