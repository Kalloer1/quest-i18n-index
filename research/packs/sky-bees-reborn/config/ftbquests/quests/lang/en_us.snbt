	quest.14004109FEA41017.quest_desc: ["Your Bees can fly away into the void. Protect them by making sure they are inside an enclosed room!"]
	quest.140A3B42C05B6B47.title: "Botany Pots"
	quest.14D387F9FA9CFCDA.title: "Max Entities"
	quest.15273952604C270D.quest_desc: [
		"A multiblock reactor that splits Uranium. It produces massive heat (Steam) and {red}Nuclear Waste{/r}."
		""
		"STEAM = POWER (via Industrial Turbine)."
		"WASTE = PROGRESSION (via Solar Neutron Activator)."
		""
		"{bold}WARNING{/bold}: Do not let Waste sit in the reactor. Do not break pipes full of Waste. Radiation will kill everything."
	]
	quest.15273952604C270D.title: "Fission: Energy and Waste"
	quest.16BB6FC5BB515A41.title: "Mob Masher Upgrades"
	quest.171D31EF46B98A51.quest_desc: ["Falling into the &l&5Void&r&r? Don't worry. You will just pop back up to the sky. However, you will be left with Half a heart when you land so make sure you are full health!"]
	quest.1819B98E79DF6E66.quest_desc: [
		"The {bold}Industrial Turbine{/r} is a multiblock that turns the Steam from your Fission reactor into FE."
		""
		"This is the most powerful generator in the mod until you reach Fusion."
	]
	quest.1819B98E79DF6E66.title: "The Industrial Turbine"
	quest.1A1B2ECC7FC1B830.title: "Ignores Players"
	quest.1C837B65F04BB06E.quest_desc: ["After placing this cake down. Make sure to use some &a&lEyes of Ender&r&r on it to get more slices."]
	quest.1C926B64EA007298.title: "Fermenter"
	quest.1CD99361311C56C0.quest_desc: ["Seive Dust to find Bonemeal"]
	quest.1E6A0907B8CF0301.quest_desc: ["The main island is normal, however the rest is not!"]
	quest.1E6A0907B8CF0301.title: "Far far away"
	quest.1F273CC584AB2042.quest_desc: ["Be careful, this is extreamly &4hot&r. I would be close to &bwater&r, just incase."]
	quest.222B0103B016B30F.quest_desc: ["{image:kubejs:textures/quests/extended_crafting.png width:100 height:100}"]
	quest.222F7AA099D5F654.quest_desc: [
		"Welcome to {bold}Mekanism{/r}. Your journey begins with the {cyan}Metallurgic Infuser{/r}."
		""
		"This machine uses an 'Infusion' material (placed in the left slot) and a base metal (placed in the middle slot) to create alloys."
		""
		"Tip: You can use {bold}Redstone{/r}, {bold}Coal{/r}, {bold}Diamond{/r}, {bold}Obsidian{/r}, and {bold}Fungi{/r} as infusion sources."
	]
	quest.222F7AA099D5F654.title: "The Beginning: Metallurgic Infusion"
	quest.22EBEA448776C8A0.quest_desc: [
		"The {bold}Enrichment Chamber{/r} doubles your raw ores into 2 dusts."
		""
		"It also turns 1 Redstone into 1 'Enriched Redstone', which provides {bold}80 units{/r} of infusion instead of 10. Always enrich your materials!"
		""
		"The {bold}Crusher{/r} turns ingots back into dust and creates Bio Fuel from organic matter."
	]
	quest.22EBEA448776C8A0.title: "Tier 2: Enrichment and Crushing"
	quest.23B220BAEFB89857.title: "Quite Dreadful"
	quest.2679C63FD155E3CB.quest_desc: ["This is used to make other parts for a &a3x3 Multiblock&r."]
	quest.292B33693B874BDD.quest_desc: ["This is part of the &a3x3 Mutlblock&r and allows you to produce &5Dragons Breath&r."]
	quest.2976E34C3FBB3D3C.title: "Arc Furnace"
	quest.2AFD39545649735C.quest_desc: [
		"You will need &5&lSilk Touch&r&r in order to grab one of these bad boys."
		""
		"Go to the next page for a useful tip."
		"{@pagebreak}"
		"You can use a &a&lSpawn Egg&r&r to change what it spawns!"
		""
		"Use either the &5&lCapturing&r&r enchantment, or a &5&lSwab&r&r to get Spawn Eggs."
	]
	quest.2B559D8EFF650C93.quest_desc: ["Place food items that the bees require in here."]
	quest.2C166AF87280D76D.quest_desc: [
		"You need energy (FE) to run these machines. "
		""
		"The {bold}Heat Generator{/r} is cheap and can generate power passively if surrounded by Lava."
		""
		"The {bold}Wind Generator{/r} is much better for Skyblock. Place it high up (Y=200+) to maximize production."
	]
	quest.2C166AF87280D76D.title: "Basic Power: Heat and Wind"
