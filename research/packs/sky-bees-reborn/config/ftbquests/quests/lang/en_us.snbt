	quest.03895C5CCDC25D47.quest_desc: ["Throwing Sand into Creosote transforms it into Soul Sand"]
	quest.04232FE86A51373B.quest_desc: [
		"        Welcome to Sky Bees Reborn!"
		""
		"Your goal is to breed Bee's and get the resources automated to make the end game Singularities."
		""
		"{image:kubejs:textures/quests/skybeesreborn-logo.png width:100 height:100}"
		"{@pagebreak}"
		"You find yourself looming over the void and have the urge to live for stronger things. You are in luck! There seems to be some magical bee's that can be summoned via specific nests."
		""
		"It looks like you have to become friends with the bee's"
	]
