	quest.6C868D75B3686D12.quest_desc: ["Make sure you have either flight or blocks as this is a skyblock dimension"]
	quest.6C868D75B3686D12.title: "Going Deeper"
	quest.6C8F7FE7A5CEADA9.quest_desc: [
		"Mekanism machines often use {cyan}Gas{/r} instead of fluids. "
		""
		"The {bold}Electrolytic Separator{/r} splits Water into {bold}Hydrogen{/r} and {bold}Oxygen{/r}."
		""
		"Hydrogen is for power; Oxygen is for advanced ore processing."
	]
	quest.6C8F7FE7A5CEADA9.title: "Gas and Fluids: The Separator"
	quest.6CF52948CA0C3575.quest_desc: ["There are some useful mods to help you on your journey. Check the mod list or JEI as not all of them are listed here."]
	quest.6D105A40EA66527C.quest_desc: ["This is a great start for getting cobblestone automatically. This generator can also generate other blocks. Check JEI for other uses."]
	quest.6D105A40EA66527C.title: "Cobblestone Generation"
	quest.6D4683D48F8F735C.title: "Sophisticated Storage"
	quest.6F39D513C33ED55A.title: "Bee Hive"
	quest.6F44B9189EE4DDCD.quest_desc: [
		"Unlike Fission, the {bold}Fusion Reactor{/r} is perfectly safe. It uses Deuterium and Tritium (from heavy water and lithium) to generate endless power."
		""
		"This is the ultimate goal for power generation."
	]
	quest.6F44B9189EE4DDCD.title: "Fusion: The Power of a Star"
	quest.6FA77CBCD71D5319.title: "Sulfur"
	quest.6FACE4F08E45FC9A.title: "Fire Clay + Fire Bricks"
	quest.7053E31CBAF23927.title: "Fluid Laser"
	quest.708B12B22CE1A4E1.quest_desc: [
		"If your tree doesn't drop any &asaplings&r or they fall into the void. Then look in your quest book on the right hand side and you will see &aEmergency Items&r. Leave that page open until the timer runs out."
		""
		"&4Closing it will not work.&r"
	]
	quest.70E6B52DAC8B65E1.quest_desc: ["This is a great multiblock for early ore doubling."]
	quest.70E6B52DAC8B65E1.title: "Productive Metalworks"
	quest.715A08DCF00609DC.quest_desc: [""]
	quest.71CEADC9486A3B8D.title: "No AI"
