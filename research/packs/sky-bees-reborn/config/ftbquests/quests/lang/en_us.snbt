	quest.4239E0AB8212A6C6.quest_desc: ["Check JEI for the recipe. You must use the Bee'o Matic to get it!"]
	quest.43E2C81C4F438593.quest_desc: ["Home for your Bee friends. Each one you add to your Multiblock gives 5 spaces for bees. Either place them in via the GUI or right click with a cage."]
