		"5x Echoing Sculkshelf"
		"2x Soul-Touched Sculkshelf"
		"5x Melonshelf"
		"5x Normal Bookshelf"
		"1x Geode-Encased Bookcase of Stability"
	]
	quest.75246E5154A9E112.title: "Hostile Neural Networks"
	quest.7537D867984C124B.title: "Bee Squeezing"
	quest.777E509BB2B9286B.quest_desc: ["You cannot get porcelain yet so a wooden bucket will have to do!"]
