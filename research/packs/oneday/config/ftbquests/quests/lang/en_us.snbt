	quest.3AB4D9F8483D0E46.title: "Bioshroom Caves"
	quest.3AC1586D9FDB0382.title: "Rainbow Beach"
	quest.3AC6475CF65969EC.title: "Everlasting Beef"
	quest.3ADBA2BF57A23E05.quest_desc: ["&7To become something higher, is the loneliest Achievement of them all."]
	quest.3ADBA2BF57A23E05.quest_subtitle: "A Blade made out of a sharp Fire."
	quest.3B1D7C24AC35261C.quest_desc: ["&7Two Storms, chained together by a single Handle. You can feel how volatile it is."]
	quest.3B1D7C24AC35261C.quest_subtitle: "The Storm has no Conscience"
	quest.3B253027B3A56099.quest_desc: ["&7He is gone. I am what remains."]
	quest.3B253027B3A56099.quest_subtitle: "Death Awaits."
	quest.3B28B46F411E584C.quest_desc: ["Deep below lies the End Portal. Fill its frame with your Eyes of Ender."]
