	quest.1A59D35015E0BB3F.quest_desc: ["&7What will you choose? Will you regret your choices?"]
	quest.1A59D35015E0BB3F.quest_subtitle: "Dormant Power Lies Beneath..."
	quest.1A8752421E4A205E.quest_desc: ["Feasts are placed as blocks and served with bowls – enough for the whole team."]
	quest.1A8752421E4A205E.title: "A Feast!"
	quest.1A931EE53037648D.quest_desc: ["Right-click to water crops and make them grow faster."]
	quest.1A931EE53037648D.title: "Watering Can"
	quest.1A98B02EDA838AA4.quest_desc: ["Drawers hold huge amounts of a single item."]
