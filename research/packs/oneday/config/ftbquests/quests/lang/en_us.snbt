	quest.1A379A420E5561A4.title: "Court Jester"
	quest.1A4221CF47D0E978.quest_desc: ["An ancient sea monster rules the Sunken City. Water Breathing is a must."]
	quest.1A4221CF47D0E978.title: "The Leviathan"
	quest.1A4CF1F49230DF79.quest_desc: ["Smash particles together to create exotic matter."]
	quest.1A4CF1F49230DF79.title: "Particle Accelerator"
