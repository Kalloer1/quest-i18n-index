	quest.3B9EE0E642B7E0D7.title: "Over and Out"
	quest.3BA1D7B63CB3CA6D.quest_desc: ["Combines metals into alloys."]
	quest.3BCBD6888B1EEF2B.title: "Drill Core"
	quest.3BD42621F23745E4.quest_desc: ["Build a 3x3x3 cube of Coke Bricks and hit the middle block of one side with the Engineer's Hammer."]
	quest.3BD42621F23745E4.title: "Coke Oven"
	quest.3BFBF2C34C80AB5B.quest_desc: [
		"Find a Goblin Trader deep underground and look at it."
		""
		"Goblins love a good deal – bring Emeralds! The nether has Vein Goblins too."
	]
	quest.3BFBF2C34C80AB5B.title: "Goblin Mode"
	quest.3C0CFCE9A2700117.quest_desc: [
		"Complete every quest in &eAd Astra&r to earn the title &bSpace Legend&r."
		""
		"The title is offered automatically. Choose &a[Accept]&r to wear it under your name – or &c[Decline]&r to keep it in your collection for later."
	]
	quest.3C0CFCE9A2700117.quest_subtitle: "Ad Astra"
	quest.3C0CFCE9A2700117.title: "Space Legend"
	quest.3C25BC0FE5230469.quest_desc: ["A full Hazmat suit protects you from Irradiation."]
	quest.3C25BC0FE5230469.title: "Suit Up"
	quest.3C2BDFF5A0241141.quest_desc: ["The Harvester Pylon automatically harvests mature crops in a designated chunk-wide area and places the drops into an attached chest."]
	quest.3C2BDFF5A0241141.title: "Harvester Pylon"
	quest.3C8BB7C2D6234870.quest_desc: [
		"Fighting a boss with a player from another team? Make them your ally for a while:"
		""
		"&e/oneday ally invite <player> [minutes]&r – they get an [Accept] button in chat."
		""
		"Allies count as teammates for friendly fire until the time runs out. You get a warning 5 minutes and 1 minute before it ends."
		""
		"&7/oneday ally list – show your allies   /oneday ally leave – end an alliance early"
	]
	quest.3C8BB7C2D6234870.title: "Temporary Allies"
	quest.3CB351272478C435.quest_desc: ["Rolls ingots into rods and wires."]
	quest.3CB351272478C435.title: "Rolling Mill"
	quest.3CE95E50C6CC689A.quest_desc: ["Mix cocktails at the Palm Bar – coconut, ice and honey make a Coconut Cocktail."]
	quest.3CE95E50C6CC689A.title: "Beach Party"
	quest.3CFAA0BF10CBEAFD.quest_desc: ["&7This blade reeks of a Betrayal that has changed this Weapon forever. A Betrayal so heartbreaking, it cannot even be forgotten by the ones that don't know it. The Souls in this Weapon ooze guilt."]
	quest.3CFAA0BF10CBEAFD.quest_subtitle: "&7A Blade Lucius would love."
	quest.3D1C0F80B74B27D5.quest_subtitle: "Arrive at a Lighthouse"
	quest.3D90929CDE45D3D0.quest_subtitle: "Magmators use lava to generator power. The higher the tier, the more power and efficiency used from lava."
	quest.3DBCF334DAD80C9D.title: "Necoium Ingot"
	quest.3DC3752F77FD5CFF.quest_desc: ["Space is deadly. You need a full Space Suit filled with oxygen."]
	quest.3DC3752F77FD5CFF.title: "Space Suit"
	quest.3DEEF330074DD80C.quest_subtitle: "2nd Tier Capacitors used to upgrade to Hardened Machinery."
	quest.3DF63B780E8E53D9.quest_desc: ["Use the Terrarium in the Otherworld to return to the Overworld. Your bases in both worlds stay exactly where you left them."]
	quest.3DF63B780E8E53D9.title: "There and Back Again"
	quest.3DF6E4D42850A8C2.title: "Regions Unexplored"
	quest.3E0B33F83CD2E975.quest_desc: ["Finds any structure – dungeons, temples, boss lairs."]
	quest.3E0B33F83CD2E975.title: "Explorer's Compass"
	quest.3E25B816816EFDEB.quest_desc: ["A 3x3x3 cube of Blast Bricks, formed with the hammer. Iron plus Coal Coke becomes Steel."]
	quest.3E25B816816EFDEB.title: "Crude Blast Furnace"
	quest.3E3BE04155331A0A.quest_desc: ["Takes gems back out of an item without destroying them."]
	quest.3E41284512370454.quest_desc: ["Axe, shovel and hoe dig 25% faster while the sun is up."]
	quest.3E41284512370454.title: "The Full Toolbox"
	quest.3E5207641E8653DC.quest_desc: [
		"&7To make it, combine a &bRunic Tablet&r &7with a &cEmpowered Remnant&r &7in a Smithing Table."
