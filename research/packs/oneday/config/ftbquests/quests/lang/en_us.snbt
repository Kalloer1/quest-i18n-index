	quest.5E418A209B285E18.title: "Spellbook Legend"
	quest.5E6A65E69445CD8A.quest_desc: ["Applied Flux lets your ME network store and move FE energy."]
	quest.5E6A65E69445CD8A.title: "Flux Accessor"
	quest.5E6E94730281753A.quest_desc: ["Wear them and look at a block to see its speed, stress impact and contents."]
	quest.5E6E94730281753A.title: "Engineer's Goggles"
	quest.5E7F13B7290F4ED7.quest_desc: ["Offer Infused Iron to the gods – or Tainted Gold for twice as many ingots."]
	quest.5E7F13B7290F4ED7.title: "Ingot of the Skies"
	quest.5E9275EB030938FF.quest_desc: ["My Nether's Delight brings cooking to the Nether. Bullet Peppers are its spicy signature crop."]
	quest.5E9275EB030938FF.title: "Spicy Nether Cooking"
	quest.5EAA83E38BF56386.quest_desc: [
		"&6Solarium Ore&r glows golden high up in the mountains, above Y 80."
		""
		"You need at least a &bdiamond pickaxe&r to mine it."
	]
	quest.5EAA83E38BF56386.title: "A Piece of the Sun"
	quest.5EB66A7DB7CB07EC.quest_desc: ["Combine a Heavy Core from an Ominous Vault with a Breeze Rod. The further you fall before a hit, the harder it smashes!"]
	quest.5EC27B5F85CEC39A.quest_desc: ["Rockets are assembled here from nose cones, fins, engines, tanks and plates."]
	quest.5EC27B5F85CEC39A.title: "NASA Workbench"
	quest.5F2FE270863AE26F.title: "Diesel Power"
	quest.5F48146949BF9109.quest_desc: ["Stores large amounts of a single spirit."]
	quest.5F59BA8F398834C6.quest_desc: [
		"Build a Nether Portal frame out of Obsidian and light it with Flint and Steel."
		""
		"&cBeds explode here – do not try to sleep!"
	]
	quest.5F59BA8F398834C6.title: "Into the Nether"
	quest.5F6748754377DB53.quest_desc: ["Faster furnaces – upgrade all the way to the Rainbow Furnace."]
	quest.5F9A38A199997671.quest_desc: ["Set your spawn point in the Nether. Charge it with Glowstone."]
	quest.5FCA6B80D0208B6B.quest_desc: ["Civilian Aviation adds real small planes and helicopters on top of Immersive Aircraft."]
	quest.5FCA6B80D0208B6B.title: "Cleared for Takeoff"
	quest.5FCF3FDBA64B3DD3.quest_desc: ["An upgradable mining drill: speed, 3×3, 5×5, silk touch, fortune and block placing."]
	quest.5FCF3FDBA64B3DD3.title: "The Drill"
	quest.60144FFDA8D00E33.quest_desc: ["A hatchling becomes your loyal companion once it is tamed. Look after it – a grown, saddled dragon can be ridden into the sky."]
	quest.60144FFDA8D00E33.title: "Dragon Tamer"
	quest.6029C34D55EC0F1E.quest_desc: [
		"Finish a whole chapter and the &6Hall of Legends&r gives you a title like &bMekanism Legend&r or &bMaster Chef&r."
		""
		"Titles appear under your name for everyone to see. Choose which one you wear in the OneDay menu."
		""
		"Finish &eevery&r quest and forge the OneDay Star to become a &6✦ OneDay Legend ✦&r."
	]
	quest.6029C34D55EC0F1E.title: "Titles and Legends"
	quest.607D367050727C90.title: "Sakura Grove"
	quest.60DCA31515BC6061.title: "Bloom Stone Staff"
	quest.60F51208FA5117A6.quest_desc: ["&6Source&r is the magical energy of Ars Nouveau. Source Jars store it for your machines."]
	quest.60F51208FA5117A6.title: "Source Jar"
	quest.6142D6FA161487F6.quest_desc: ["A tier 3 crop. 8 Iron Essence make 3 Iron Ingots."]
	quest.6142D6FA161487F6.title: "Iron Grows on Trees? No, on Crops!"
	quest.614EC37BEA185F5F.title: "Enchanted Spell Book"
	quest.619A727FF6FB268A.quest_desc: ["Place the rocket on a Launch Pad, fill it with Fuel, get in and launch!"]
	quest.619A727FF6FB268A.title: "Tier 1 Rocket"
	quest.61C06732A8C67FAA.quest_desc: [
		"Defeat an Enderminy."
		""
		"Small Enderman, big attitude. Don't look it in the eyes."
	]
	quest.61C06732A8C67FAA.title: "Tiny but Terrifying"
	quest.61C55A13F3DBBD22.quest_desc: [
		"The &6Bounty Board&r offers new bounties every Minecraft day: hunt mobs or deliver items for coins, XP and Lucky Blocks."
		""
		"Bounties grow harder (and pay more) once you have visited the Nether, the End and beaten the Ender Dragon."
		""
		"&7Kill bounties count by themselves. Deliver bounties take the items from your inventory when you press \"Deliver\"."
	]
	quest.61C55A13F3DBBD22.title: "Bounty Hunter"
	quest.61C74003316C78C3.title: "Peridot"
	quest.61DB013AF9D2D6F4.quest_desc: ["Carry Aura with you. Fill it up by placing it on the Natural Altar."]
	quest.61DCD40D5F0F6DED.quest_desc: ["A much, much bigger bang."]
	quest.61DCD40D5F0F6DED.title: "Obsidian TNT"
	quest.61DE2AE3CEDCA4C0.quest_desc: ["Magnets, building wands, gadgets and hammers."]
	quest.61DE2AE3CEDCA4C0.title: "Tools"
	quest.622B0A56F7FD7083.quest_desc: [
		"OneDay adds its own gateways: &2Rotten Horde&r, &5Night of the Ender Zoo&r, &aCreeper Carnival&r, &7Illager Siege&r and the &dEndless Eclipse&r."
		""
		"Craft a Gate Pearl, throw it, survive the waves – and collect the rewards. The Endless Eclipse never stops!"
	]
	quest.622B0A56F7FD7083.title: "Gate Crasher"
	quest.62589D0D45F0D98A.quest_desc: [
		"The Let's Do mods add a whole countryside: bakeries, dairies, vineyards and breweries."
		""
		"Many of their recipes, like dough, are mixed in the Crafting Bowl."
	]
	quest.62589D0D45F0D98A.title: "The Crafting Bowl"
	quest.6264E830D735CEF9.title: "Stamina Vessel"
	quest.62B47D18AB28B8AD.title: "Storage Controller"
	quest.62EA93B01221C9B3.quest_desc: ["Programs drones with puzzle-piece commands."]
	quest.62EA93B01221C9B3.title: "The Programmer"
	quest.62FEA01FAA032475.quest_desc: ["Evokers drop Totems of Undying – find them in Woodland Mansions and during raids. Hold it to cheat death once."]
	quest.63116691C92FD576.quest_desc: ["A quiet spring hidden among the hills, its waters swirl mysteriously in the bottomless well. Travelers speak of subtle blessings for those brave enough to approach. Some even report a modest burst of speed for journeys ahead. Whether magic or rumor, the well offers a curious advantage to explorers."]
	quest.63116691C92FD576.quest_subtitle: "Find a Wishing Well"
	quest.639EDAE9BA5D6519.quest_desc: ["A quiver holds extra arrows in its own slot."]
	quest.63ADC29FABC60424.quest_desc: [
		"Complete every quest in &eArmor Sets&r to earn the title &bArmorsmith&r."
		""
		"The title is offered automatically. Choose &a[Accept]&r to wear it under your name – or &c[Decline]&r to keep it in your collection for later."
	]
	quest.63ADC29FABC60424.quest_subtitle: "Armor Sets"
	quest.63ADC29FABC60424.title: "Armorsmith"
	quest.63BB3DE54E986797.quest_desc: ["Found on Venus. Used for the final rocket tier."]
	quest.63BB3DE54E986797.title: "Calorite"
	quest.63CB3B7253534C40.title: "Enderminy"
	quest.63D302D27F692952.quest_desc: ["Stack elevators vertically: jump to go up, sneak to go down."]
	quest.63D55699D4BB8848.quest_subtitle: "Charged Snowballs carry enough energy to cause a lightning strike when hitting a mob or hitting the ground."
	quest.63DE5FD17A9BBDE6.quest_desc: [
		"Equip your Spell Book in its slot, then:"
		""
		"[\"\",{\"text\":\"• \"},{\"keybind\":\"key.irons_spellbooks.spellbook_cast\",\"color\":\"gold\"},{\"text\":\" casts the selected spell.\"}]"
		"[\"\",{\"text\":\"• Hold \"},{\"keybind\":\"key.irons_spellbooks.spell_wheel\",\"color\":\"gold\"},{\"text\":\" to open the spell wheel.\"}]"
		"[\"\",{\"text\":\"• Hold \"},{\"keybind\":\"key.irons_spellbooks.spell_bar_modifier\",\"color\":\"gold\"},{\"text\":\" and scroll to cycle spells quickly.\"}]"
	]
	quest.63DE5FD17A9BBDE6.title: "Cast Away!"
	quest.644730C35064F209.title: "Automatic Harvest"
	quest.6447492FAA873F93.quest_desc: ["Suspended in the sky, this floating steampunk city glows in hues of orange and green. Strange, gear-driven inhabitants roam its platforms, each dominated by a singular central eye or monocle. Enter with caution, this mechanical hive is as clever as it is imposing, and its secrets are tightly guarded."]
	quest.6447492FAA873F93.quest_subtitle: "Find a Mechanical Nest"
	quest.646542E5F62C51AE.title: "Apprentice's Spell Book"
	quest.64A3CD943835233D.quest_desc: ["Mined on Mars – the key to the Tier 3 rocket."]
	quest.64A3CD943835233D.title: "Ostrum"
	quest.65495B51321BB86A.quest_desc: ["Holy warriors: heal allies, smite foes and hold the line with a shield."]
	quest.65495B51321BB86A.title: "Paladin and Priest"
	quest.65A0C655347698B9.quest_desc: ["A living stone block that guards the Bronze Dungeon. Only &6pickaxes&r can hurt it!"]
	quest.65A0C655347698B9.quest_subtitle: "Bronze Dungeon"
	quest.65A0C655347698B9.title: "The Slider"
	quest.65B818D879FA7E4F.quest_subtitle: "The 6th Tier Capacitor used to upgrade to Nitro Machinery, the final tier."
	quest.65D5AD0EC9A0F57E.quest_desc: [
		"Defeat a Mummy near a desert temple."
		""
		"Someone should really tell it that bandages are for wounds, not fashion."
	]
	quest.65D5AD0EC9A0F57E.title: "Unwrapped"
	quest.6601243A1553F79E.title: "Oh The Biomes We've Gone"
	quest.66450530A1BF2864.quest_desc: ["The rarity of the Ink sets the level of the forged spell."]
	quest.66450530A1BF2864.title: "Ink"
	quest.666D6FFBD5FD2306.quest_desc: ["&7Too many Beings, not enough Souls."]
	quest.666D6FFBD5FD2306.quest_subtitle: "&7If it were stolen, was it ever yours to begin with?"
	quest.667E880C28AB9FA6.quest_desc: ["An Aura Cache with three times the storage."]
	quest.66A4960217E0791D.quest_desc: ["Press apples – or grapes – into juice."]
	quest.66A541EE636B0274.quest_desc: ["Weapons and armor can drop with random affixes, from Common to Mythic. Rarer items can have sockets for gems."]
	quest.66A541EE636B0274.title: "Affix Loot"
	quest.66C28F69B9114D36.quest_desc: ["The ultimate general-purpose spell book."]
	quest.66C28F69B9114D36.title: "Ancient Codex"
	quest.66D2D430C6E96A5E.title: "Maximilian Armor"
	quest.66F0BF461623535F.title: "Snowy Creeper"
	quest.67030CEFEC1CEF37.quest_desc: ["Driven from their villages, these hardy merchants now wander the wilds, taking shelter beneath simple cyan and brown tents. Though weary from exile, they still offer trade and refuge to travelers brave enough to seek them out. In a world rising with danger, such camps are rare havens of trust."]
	quest.67030CEFEC1CEF37.quest_subtitle: "Find a Merchant Campsite"
	quest.6743AA5BF9C095A2.quest_desc: [
		"Jump 1,000 times."
		""
		"Yes, spamming space bar counts. We are not judging. Much."
	]
	quest.6743AA5BF9C095A2.title: "Bunny Hop"
	quest.675E8D7245B66C21.quest_desc: ["A second altar catalyst. It transmutes items: Rotten Flesh into Leather, Charcoal into Coal, Sand into Soul Sand and more."]
	quest.67F408052A984C0E.quest_desc: ["Drop iron ingots next to an explosion (TNT or creeper) to compress them. Some always get lost!"]
	quest.67F408052A984C0E.title: "Compressed Iron"
	quest.67FFA119A3BFC695.quest_desc: ["The center of every ritual."]
	quest.6810972065857B71.quest_desc: ["Faster and sportier – with a propeller."]
	quest.681FA798D563880A.title: "Fallen Knight"
	quest.6837A0498F747EB3.quest_desc: [
		"The Otherworld pays in &7Silver Coins&r, the Overworld in &aEmeralds&r. One &aEmerald&r is worth &715 Silver Coins&r."
		""
		"Put an &aEmerald&r into a &6Stonecutter&r to get &715 Silver Coins&r. To buy an &aEmerald&r back for 15 Silver Coins, use the &aExchange Counter&r."
		""
		"&7Tip: 100 Copper = 1 Silver, 100 Silver = 1 Gold, 100 Gold = 1 Platinum. Put a coin into the crafting grid to break it down."
	]
	quest.6837A0498F747EB3.quest_subtitle: "One economy for both worlds"
	quest.6837A0498F747EB3.title: "Exchange Rate"
	quest.6858E25E510AE0FA.quest_desc: ["Drifting through the skies like a colossal squid, this otherworldly airship bristles with defenses. Phantom-riding monstrosities circle its hull, while fish-like warriors astride hoglins guard its decks. To face the Conqueror is to battle a skyborne legion. And only the strongest will claim victory."]
	quest.6858E25E510AE0FA.quest_subtitle: "Find a Heavenly Conqueror"
	quest.6865FDB53B237C3C.quest_desc: ["Surround it with bookshelves to unlock stronger enchantments. Apotheosis turns enchanting into a whole system – see the 💎 Apotheosis chapter."]
	quest.688FF2C2F77D267C.title: "Circuit Boards"
	quest.68B5CE508BDF7904.quest_desc: ["Picks items up and puts them down anywhere in range. Select its inputs and outputs before placing it."]
	quest.68B5CE508BDF7904.title: "Mechanical Arm"
	quest.68C274BC3FDBF7B1.title: "Refined Redstone"
	quest.68CC10EDAD3CF2AB.title: "Desert Spell Book"
	quest.68D9B7CBEB346B19.quest_desc: ["The Chimera's trophy – needed for the Archmage Spell Book."]
	quest.68D9B7CBEB346B19.title: "Wilden Tribute"
	quest.68EDC5289C44F9B9.title: "Ruby Ingot"
	quest.68FDDCA1C9D4BCC8.quest_desc: [
		"Get into a boat and float with a goat."
		""
		"Screaming goats recommended."
	]
	quest.68FDDCA1C9D4BCC8.title: "Whatever Floats Your Goat"
	quest.691AB171C0A0B4A5.quest_desc: ["Collect 10 boss trophies."]
	quest.691AB171C0A0B4A5.title: "Trophy Room"
	quest.69C9EC0631A59171.quest_desc: ["Drowned sometimes carry and drop Tridents."]
	quest.69D7086959402D69.quest_desc: ["The trophy on the bow of every End Ship."]
	quest.69EA7C9FE6676533.quest_desc: ["[\"\",{\"text\":\"Gloves, rings, pendants and capes go into your accessory slots. Open them with \"},{\"keybind\":\"key.aether.open_accessories.desc\",\"color\":\"gold\"},{\"text\":\".\"}]"]
	quest.69EA7C9FE6676533.title: "Aether Accessories"
	quest.69EF462347C191C6.quest_desc: ["A giant worm made of gum burrows through the candy."]
	quest.69EF462347C191C6.title: "Gum Worm"
	quest.6A0237FADC519965.quest_desc: ["From a distance, it looks peaceful. Fields of golden wheat swaying beside a proud windmill. But don’t be deceived: the Illagers tend no crops for trade. Behind the rustic facade lies a nest of evil, their blades as sharp as the sickles they carry."]
	quest.6A0237FADC519965.quest_subtitle: "Find an Illager Windmill"
	quest.6A1234567890BCDE.quest_desc: ["Welcome to the Pylons mod! Pylons provide utility functions across an entire chunk or even dimensionally without causing lag."]
	quest.6A1234567890BCDE.title: "Introduction to Pylons"
	quest.6A3EDD423D9E141E.quest_desc: [
		"4 Solarium and 4 Lunarium Ingots around a Netherite Scrap make &d2 Eclipse Ingots&r."
		""
		"The ingot itself shows whether it is day or night right now!"
	]
	quest.6A3EDD423D9E141E.title: "Eclipse"
	quest.6A4C5697B8AEF9CE.quest_desc: ["From the Forlorn Hollows of Alex's Caves."]
	quest.6A4C5697B8AEF9CE.title: "Dread Robes"
	quest.6A4F0E662C367303.title: "Glacial Hunter"
	quest.6A8665FBC017A00F.quest_desc: ["&7Forever is a dangerous word. How can a Mortal offer Eternity?"]
	quest.6A8665FBC017A00F.quest_subtitle: "Some things dont end with Death."
	quest.6A8FBA84DD1283E8.quest_desc: ["Kill creatures with a scythe to shatter their souls into spirits."]
	quest.6AA46157C76B3EFB.quest_desc: ["Barrels and chests that you can upgrade in tiers and give upgrades like auto-smelting and compacting."]
	quest.6AA46157C76B3EFB.title: "Sophisticated Storage"
	quest.6AC872BD641706D4.quest_desc: ["Special bookshelves raise Eterna, Quanta and Arcana at the enchanting table – much stronger enchantments."]
	quest.6AC872BD641706D4.title: "Better Bookshelves"
	quest.6AED85374A4ACD23.title: "Citrine Ingot"
	quest.6AEDC93B21A4779E.quest_desc: ["Calls your dragon to you. Whistles come in every dye colour – craft a &cred&r one for this quest."]
	quest.6AEDC93B21A4779E.title: "Dragon Whistle"
	quest.6B35F27EE277F880.quest_desc: ["&7'Cause Man is a Wolf to another Man"]
	quest.6B35F27EE277F880.quest_subtitle: "To slay a Dragon"
