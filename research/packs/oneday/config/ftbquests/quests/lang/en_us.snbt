	quest.1A232E4BB3990CB3.title: "Infested Zombie"
	quest.1A255711B9233932.quest_desc: ["Harvesters and Ploughs mounted on a moving contraption farm entire fields for you."]
	quest.1A255711B9233932.title: "Automatic Farming"
	quest.1A29FC5A73FDE328.quest_subtitle: "Solar Panels generate energy during the day time, the higher tier, the more power generated during the day."
	quest.1A30EADD94693184.quest_desc: [
		"Trade with a villager at the build height limit."
