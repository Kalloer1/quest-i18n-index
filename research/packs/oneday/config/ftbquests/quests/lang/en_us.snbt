	quest.7A808753E1128B62.quest_desc: ["Turns water into oxygen and fills your suit."]
	quest.7A808753E1128B62.title: "Oxygen Loader"
	quest.7AA22DC8D5C40BA5.title: "Minigun"
	quest.7AAA9CE6FA1E72F6.quest_subtitle: "Furnators use burning fuel sources such as coal and wood to generate power. The higher tier, the more power and efficiency created from fuel sources."
	quest.7AEA6DBBDE382345.quest_desc: ["Belts move items and carry rotation between two shafts. Machines like the Press can work on items passing by on a belt."]
	quest.7AEA6DBBDE382345.title: "Mechanical Belts"
	quest.7B1234567890BCDE.quest_desc: ["The Expulsion Pylon allows you to automatically whitelist or blacklist players, kicking unwanted visitors out of your claimed chunk."]
	quest.7B1234567890BCDE.title: "Expulsion Pylon"
	quest.7B21B0CF514B0605.quest_desc: ["Integrated Dynamics starts with the blue Menril trees in the Overworld."]
	quest.7B21B0CF514B0605.title: "Menril Trees"
