	quest.77A99B1C6D7630E3.title: "Relic Collector"
	quest.77F55C31BEB29543.quest_desc: ["[\"\",{\"text\":\"Pulls nearby items to you. Toggle it with \"},{\"keybind\":\"simplemagnets.keys.toggle\",\"color\":\"gold\"},{\"text\":\".\"}]"]
	quest.78362376328C841C.quest_desc: ["Free the End – and unlock the path to the Ruined Citadel."]
	quest.78362376328C841C.title: "The Ender Dragon"
	quest.78472170A4075011.title: "Crystal Heart"
	quest.786CE41804D98FDA.quest_desc: ["Planks soaked in Creosote Oil from the Coke Oven."]
	quest.78D95DE80EB57FF9.quest_desc: ["The sun-worshipping chieftain of the Umvuthana village in the savanna. His mask channels the power of the sun."]
	quest.78D95DE80EB57FF9.title: "Umvuthi"
	quest.78DAEEE532969487.quest_desc: [
		"&6☀ Sun:&r undead burn and take 30% more damage."
		"&b☾ Moon:&r every hit heals you for 15% of the damage dealt."
	]
	quest.78DAEEE532969487.title: "Blade of Dawn and Dusk"
	quest.78FE738067571F2F.quest_desc: ["Infuse items with spirits. Place spirit-filled items on nearby pedestals."]
	quest.790828CD209D73A8.quest_desc: ["The finest Ink there is – for level-maxed scrolls."]
	quest.790828CD209D73A8.title: "Legendary Ink"
	quest.7928722DB058CC48.title: "Bone Reef"
	quest.792F26A8A2521746.quest_desc: ["Find wild hops for brewing."]
	quest.7930BA129DDED079.quest_desc: ["Ingots of the Skies, Tainted Gold and Netherite Scrap make the strongest metal of the mod."]
	quest.7930BA129DDED079.title: "Ingot of the Depths"
	quest.7953BCBBF9F386C4.quest_subtitle: "Ender Cores are a primary material used to create ender-based machinery."
	quest.79714A89BF6B05FC.quest_desc: ["&7This blades stares at you with a sense of a Holy purpose. Something greater than it could even comprehend. "]
	quest.79714A89BF6B05FC.quest_subtitle: "&7It watched a great Paladin slay a Beast. But he who kills cannot be far from a Beast himself."
	quest.79A05B0FAB091FC2.quest_desc: [
		"Place Brilliant Fiber into the leaves of a tree. Over time the gold spreads through the leaves and turns them into &6Golden Leaves&r."
		""
		"Break them for Gold Leaf."
	]
	quest.79D10CE84F9467C1.quest_desc: ["Find a Nether Fortress. Blazes and Wither Skeletons live here."]
	quest.79D10CE84F9467C1.title: "Fortress of Fire"
