	quest.6EF83C670D585029.title: "Topaz Ingot"
	quest.6F149777AD4BDAA4.quest_desc: ["Enter the pitch-black &8Forlorn Hollows&r. Something is watching you."]
	quest.6F149777AD4BDAA4.title: "Forlorn Hollows"
	quest.6F47AE101E338200.quest_desc: ["Create Crafts and Additions: turn FE into rotation – and rotation back into FE with the Alternator."]
	quest.6F47AE101E338200.title: "Electric Motor"
