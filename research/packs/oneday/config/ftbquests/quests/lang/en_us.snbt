	quest.2D682C9032C61CBA.quest_desc: ["Place it directly below an Aura generator so it keeps making Aura even when the area is already full."]
	quest.2D894DA57337C966.quest_desc: ["&7Forged out of the remains of a great cold being, you can feel how it fought its last Battle with every swing."]
	quest.2D894DA57337C966.quest_subtitle: "He who stares into the Abyss..."
	quest.2D951D3E552190C2.quest_desc: [
		"Xaero's Minimap and World Map keep track of everything for you:"
		""
		"[\"\",{\"text\":\"• \"},{\"keybind\":\"gui.xaero_open_map\",\"color\":\"gold\"},{\"text\":\" opens the full World Map.\"}]"
		"[\"\",{\"text\":\"• \"},{\"keybind\":\"gui.xaero_new_waypoint\",\"color\":\"gold\"},{\"text\":\" creates a new Waypoint at your position.\"}]"
		"[\"\",{\"text\":\"• \"},{\"keybind\":\"gui.xaero_waypoints_key\",\"color\":\"gold\"},{\"text\":\" lists all your Waypoints.\"}]"
		"[\"\",{\"text\":\"• \"},{\"keybind\":\"gui.xaero_minimap_settings\",\"color\":\"gold\"},{\"text\":\" opens the Minimap settings.\"}]"
		""
		"&eAlways set a waypoint at your base before heading out on a long expedition!"
	]
	quest.2D951D3E552190C2.title: "Getting Lost is Yesterday's News"
	quest.2D968C2FFD552BE7.quest_desc: ["Burn Impure White Chalk in Spirit Fire to purify it. Draw pentacles with it."]
	quest.2DA474B78CB0DD5A.title: "Codex of Malice"
	quest.2DB4F395EA26DF4B.quest_subtitle: "Find a Coliseum"
	quest.2DBBAC5AFE741ACE.quest_desc: ["Smelt or blast Raw Lunarium. Create, Mekanism and Immersive Engineering can double your ore."]
	quest.2DBBAC5AFE741ACE.title: "Lunarium Ingot"
	quest.2DD033ED1CCAA89F.quest_desc: [
		"Complete every quest in &eMystical Agriculture&r to earn the title &bMystical Farmer&r."
		""
		"The title is offered automatically. Choose &a[Accept]&r to wear it under your name – or &c[Decline]&r to keep it in your collection for later."
	]
	quest.2DD033ED1CCAA89F.quest_subtitle: "Mystical Agriculture"
	quest.2DD033ED1CCAA89F.title: "Mystical Farmer"
	quest.2DF6E44D44DCB238.quest_desc: ["Skyroot tools give double drops from many Aether blocks."]
	quest.2DF6E44D44DCB238.title: "Skyroot Tools"
	quest.2DF94FB433DD8C60.quest_desc: [
		"Complete every quest in &eEnder IO&r to earn the title &bEnder IO Legend&r."
		""
		"The title is offered automatically. Choose &a[Accept]&r to wear it under your name – or &c[Decline]&r to keep it in your collection for later."
	]
	quest.2DF94FB433DD8C60.quest_subtitle: "Ender IO"
	quest.2DF94FB433DD8C60.title: "Ender IO Legend"
	quest.2E0B0A2023A49822.title: "Peridot Ingot"
	quest.2E766ACF5DD9BB41.title: "Ethereal Wings"
	quest.2E7F0DA00B3D3815.quest_desc: ["Craft a Cave Biome Map. It points towards the nearest cave biome of its type."]
	quest.2E7F0DA00B3D3815.title: "The Journey Begins"
	quest.2E8EDA4D13F40A9B.quest_desc: ["Netherite gear + Sapphire Upgrade Smithing Template + Sapphire Ingot at a Smithing Table."]
	quest.2E8EDA4D13F40A9B.title: "Sapphire Upgrade"
	quest.2E99B6AFD62C74AF.title: "Heater Shield"
	quest.2EC1379445B2FCA5.quest_desc: ["Wizards master arcane, fire and frost magic."]
	quest.2EC1379445B2FCA5.title: "Wizard"
	quest.2EE472F7CA58DF74.quest_desc: ["Blaze Rods fuel Brewing Stands and are needed for Eyes of Ender."]
	quest.2EEB8FB014A2D6B3.quest_desc: ["Found in Bastion chests. Duplicate it with Diamonds and Netherrack."]
	quest.2EFC5DBD8122A0AE.quest_desc: ["Far below the surface lies a twisted network of chambers, where the air is thick with disease and shadow. Once a place of treatment, it now resembles a burial ground for forgotten rulers, its halls echoing with the whispers of those long lost. Only the brave (or the desperate) dare to tread these haunted corridors."]
	quest.2EFC5DBD8122A0AE.quest_subtitle: "Find a Plague Asylum"
	quest.2F1A99A6CAF8BCAF.quest_desc: ["Melt Unobtainium and Vibranium together and cast the strongest alloy there is."]
	quest.2F1A99A6CAF8BCAF.title: "The Ultimate Alloy"
	quest.2F6A9D49B2D0622F.quest_desc: [
		"Presses ingots into Sheets. Place it above a Depot or a Belt and power it."
		""
		"Iron, Gold, Copper and Brass sheets unlock most of what follows."
	]
	quest.2F6A9D49B2D0622F.title: "Mechanical Press"
	quest.2F70713C7F498671.quest_desc: ["Upgrade your Apprentice book with a Wilden Tribute, a Nether Star, a Totem of Undying, Ender Pearls and Emeralds. Tier 3 glyphs await."]
	quest.2F70713C7F498671.title: "Archmage"
	quest.2F9E5B65C3ACE3BD.title: "Sapphire"
	quest.2FA4CDF41B9C4731.quest_desc: ["A pitch-black cave world packed with ores – and danger. Bring light: the darkness itself hurts."]
	quest.2FA4CDF41B9C4731.title: "The Deep Beneath"
	quest.2FE74D0698201078.quest_desc: ["&7Feed it."]
	quest.2FE74D0698201078.quest_subtitle: "It wants something from you. Something as molten as itself. Something that gets more but also less."
	quest.2FEF1EF991E64653.quest_desc: ["Netherite gear + Jade Upgrade Smithing Template + Jade Ingot at a Smithing Table."]
	quest.2FEF1EF991E64653.title: "Jade Upgrade"
	quest.3000000000000001.quest_desc: [
		"Industrial Foregoing is all about automation: farms, mob grinding and the mighty Laser Drill."
		""
		"Craft its manual (&7Book + Redstone + Dirt&r) – it explains every machine in detail."
	]
	quest.3000000000000001.title: "Welcome to Industrial Foregoing"
	quest.3000000000000002.quest_desc: ["Place this machine facing a log block (such as Acacia or Dark Oak) to slowly extract raw liquid latex."]
	quest.3000000000000002.title: "Fluid Extractor"
	quest.3000000000000003.quest_desc: ["Gather a full bucket of raw fluid Latex from your Fluid Extractor to prepare for processing."]
	quest.3000000000000003.title: "Latex Bucket"
	quest.3000000000000004.quest_desc: ["The core crafting machine of Industrial Foregoing. It combines fluids with items to form advanced parts – including the Simple Machine Frame."]
	quest.3000000000000004.title: "Dissolution Chamber"
	quest.3000000000000005.quest_desc: ["Craft the Pity Machine Frame from logs, iron and a redstone block. It is the chassis of every early Industrial Foregoing machine."]
	quest.3000000000000005.title: "Pity Machine Frame"
	quest.3000000000000006.quest_desc: ["Feed Latex and Water into a &6Latex Processing Unit&r to get Tiny Dry Rubber, then craft it into Dry Rubber."]
	quest.3000000000000006.title: "Dry Rubber"
	quest.3000000000000007.quest_desc: ["Smelt Dry Rubber in a furnace to get Plastic – you will need lots of it."]
	quest.3000000000000007.title: "Plastic Sheets"
	quest.3000000000000008.quest_desc: ["Infuse iron, plastic sheets, and gold blocks with latex inside your Dissolution Chamber to unlock Tier 1 machine assembly capabilities."]
	quest.3000000000000008.title: "Simple Machine Frame"
	quest.3000000000000009.quest_desc: ["Automate your crop cultivation setups. This block scans an area above it and neatly replants seeds, saplings, or tubers."]
	quest.3000000000000009.title: "Plant Sower"
	quest.3000000000000010.quest_desc: ["Completes the farming loop. Automatically shears, breaks, and harvests fully grown crops or wood within its operational radius."]
	quest.3000000000000010.title: "Plant Gatherer"
	quest.3000000000000011.quest_desc: ["Speeds up farming efficiency by automatically injecting industrial fertilizer components directly onto growing crops."]
	quest.3000000000000011.title: "Plant Fertilizer"
	quest.3000000000000012.quest_desc: ["Place this device underneath adult farm animals to continuously suction away biological waste materials."]
	quest.3000000000000012.title: "Sewage Sewer"
	quest.3000000000000013.quest_desc: ["Extract a raw bucket of fluid Sewage generated by your livestock waste collection loops."]
	quest.3000000000000013.title: "Sewage Bucket"
	quest.3000000000000014.quest_desc: ["Takes incoming liquid sewage and compresses/dries it into rich high-grade physical industrial fertilizer items."]
	quest.3000000000000014.title: "Sewage Composter"
	quest.3000000000000015.quest_desc: ["Combine diamond matrices, pink slime components, and gold inside your Dissolution Chamber to construct Tier 2 processing structures."]
	quest.3000000000000015.title: "Advanced Machine Frame"
	quest.3000000000000016.quest_desc: ["An aggressive harvester variant. Instead of item drops, it instantly dissolves target mobs into Liquid Meat and Pink Slime fluid."]
	quest.3000000000000016.title: "Mob Slaughter Factory"
	quest.3000000000000017.quest_desc: ["Isolate a full bucket of fluid Pink Slime byproduct produced by processing mobs inside the slaughter framework."]
	quest.3000000000000017.title: "Pink Slime Bucket"
	quest.3000000000000018.quest_desc: ["Pour your liquid pink slime onto the ground, wait for it to spawn a slime mob, slay it to get physical pink slime gems, and smelt them into ingots."]
	quest.3000000000000018.title: "Pink Slime Ingot"
	quest.3000000000000019.quest_desc: ["The definitive automated execution unit. Kills mobs instantly, collects their standard item loot drops, and generates fluid Essence."]
	quest.3000000000000019.title: "Mob Crusher"
	quest.3000000000000020.quest_desc: ["Secure a bucket of concentrated fluid Essence (liquid experience) generated by automated mob farming infrastructure."]
	quest.3000000000000020.title: "Essence Bucket"
	quest.3000000000000021.quest_desc: ["Fuses netherite scrap, diamond gear blocks, and plastic matrices inside your Dissolution Chamber to unlock Tier 3 tech."]
	quest.3000000000000021.title: "Supreme Machine Frame"
	quest.3000000000000022.quest_desc: ["The anchor component for late-game mining loops. Points structural laser fields downward to siphon oils and gaseous vapors."]
	quest.3000000000000022.title: "Fluid Laser Base"
	quest.3000000000000023.quest_desc: ["Place multiple laser drills facing into a Fluid or Ore Laser Base. Supply them with massive power to activate drilling beams."]
	quest.3000000000000023.title: "Laser Drill"
	quest.3000000000000024.quest_desc: ["Siphons high-tier raw physical ore minerals directly out of bedrock voids without generating any physical quarry holes."]
	quest.3000000000000024.title: "Ore Laser Base"
	quest.3000000000000025.quest_desc: ["The ultimate modular mining tool. Absorbs massive amounts of Bio-Eln energy to unlock gigantic mining radius areas."]
	quest.3000000000000025.title: "Infinity Drill"
	quest.300A44956434AC01.quest_desc: ["Netherite gear + Citrine Upgrade Smithing Template + Citrine Ingot at a Smithing Table."]
	quest.300A44956434AC01.title: "Citrine Upgrade"
	quest.300E001A9EB2F898.title: "Wither Witch"
	quest.30223DD04737A044.title: "Ocean Creeper"
	quest.303186C0892295E7.quest_desc: [
		"Mods or not – Minecraft's own milestones are the backbone of every adventure."
		""
		"This chapter covers the classic Overworld progression. The Nether and the End have their own chapters in 🌍 Dimensions."
	]
	quest.303186C0892295E7.title: "The Vanilla Journey"
	quest.3038898771DD0C37.quest_desc: [
		"Play a music disc with a jukebox in a Meadow."
		""
		"The hills are alive. And slightly confused."
	]
	quest.3038898771DD0C37.title: "Sound of Music"
	quest.306AAF14EBD13866.quest_desc: ["&7Some say that the Soul is the most important part. Some say all you are is a mess of Hormones and impulses. What if you are neither and both at the same time?"]
	quest.306AAF14EBD13866.quest_subtitle: "It's the Eyes. It's always the Eyes."
	quest.306FD68533ABC4B4.quest_desc: ["Organic Compost slowly turns into Rich Soil over time."]
	quest.30D5C690FF678141.title: "Abyssal Warlock"
	quest.30DC0540DDFFF5E3.quest_desc: ["Friendly frog people live in villages in swamps."]
	quest.30DC0540DDFFF5E3.title: "Ribbit!"
	quest.3134599DABE1F2C1.quest_desc: [
		"The first player to defeat each boss is written into the server's &6Hall of Fame&r forever."
		""
		"Type &e/oneday halloffame&r to see who did it first."
	]
	quest.3134599DABE1F2C1.title: "Hall of Fame"
	quest.3140D81F441A94B4.quest_desc: [
		"Complete every quest in &eUnique Weaponry&r to earn the title &bWeapon Master&r."
		""
		"The title is offered automatically. Choose &a[Accept]&r to wear it under your name – or &c[Decline]&r to keep it in your collection for later."
	]
	quest.3140D81F441A94B4.quest_subtitle: "Unique Weaponry"
	quest.3140D81F441A94B4.title: "Weapon Master"
	quest.315BE66F5DF44912.quest_subtitle: "Used to create Binding Cards."
	quest.3179F8CEEC5C2B27.quest_desc: ["The most important Ars Nouveau material. Keep a steady supply!"]
	quest.3179F8CEEC5C2B27.title: "Source Gems"
	quest.3180BE9B5A2ADCBD.quest_desc: ["Ars Nouveau armor comes as Sorcerer, Arcanist and Battlemage sets. Each piece has slots for Threads that add perks."]
	quest.3180BE9B5A2ADCBD.title: "Mage Armor"
	quest.31D04F84C8AE3ABB.title: "Absolute Factory"
	quest.31DF407FAF33B128.quest_desc: ["A Heart of the Sea from buried treasure plus eight Nautilus Shells. Grants water breathing and underwater vision nearby."]
	quest.3288C0C0CCD8C0B4.quest_desc: ["Pickaxe, axe and shovel in one: the Paxel. Craft one in your favourite essence tier."]
	quest.3288C0C0CCD8C0B4.title: "One Tool for Everything"
	quest.32994250A3C2ABB2.quest_desc: ["Fishing is a Stardew Valley-style minigame here: keep the green bar on the fish until it is caught!"]
	quest.32994250A3C2ABB2.title: "Gone Fishing"
	quest.329D035B8D47D44D.quest_desc: ["Barley, oats, corn, lettuce and strawberries grow wild in the world. Start your own fields!"]
	quest.329D035B8D47D44D.title: "Country Crops"
	quest.329E75277717E967.quest_desc: ["Upgrade gems by combining them with Gem Dust."]
	quest.32C591A42D8C3C2E.quest_desc: ["&7Any Betrayal you can see, is trivial. Whoever killed with this, did it for the sport or their own gain. Once a Straight Blade, this Weapon now mimicks the twisted mind of its Creator."]
	quest.32C591A42D8C3C2E.quest_subtitle: "With a smug grin, he stabbed what they thought was dear to him."
	quest.32E7908C334674EC.quest_desc: ["Catch creatures in a net and carry them home."]
	quest.3313E43399CDA352.quest_desc: ["The Engineer's sidearm – customizable at the workbench."]
	quest.3327E05B030ECEE0.quest_desc: [
		"Finish &eevery quest in every chapter&r and hold the &6OneDay Star&r."
		""
		"Your reward: the golden title &6✦ OneDay Legend ✦&r under your name – and the whole server will know."
		""
		"&7Optional quests do not count. Chapters of the Hall of Legends itself do not count either."
	]
	quest.3327E05B030ECEE0.quest_subtitle: "Every quest. Every chapter. Every path."
	quest.3327E05B030ECEE0.title: "✦ OneDay Legend ✦"
	quest.33307AAA01BE9444.title: "The Sandworm"
	quest.3343B7550C09C341.quest_desc: ["&7No Evil thinks it is evil. Noone chooses Evil because it is Evil, they only mistake it for the the good one seeks. "]
	quest.3343B7550C09C341.quest_subtitle: "This Weapon attracts Fury like a Magnet."
	quest.3352BD329214EB89.quest_desc: ["Mine as much as you like without scarring your Overworld."]
	quest.3352BD329214EB89.title: "The Mining World"
	quest.3355ED19D9F64532.quest_desc: ["Hidden in deserts."]
	quest.3355ED19D9F64532.title: "Sandworm Nest"
	quest.337850CC7D7299F1.quest_desc: [
		"Leave the game 50 times."
		""
		"Closing the game counts. Throwing your keyboard does not."
	]
	quest.337850CC7D7299F1.title: "Rage Quit"
	quest.338C0436E3C5B61A.quest_desc: ["A Foliot that carries items between containers."]
	quest.338FA84926455BFB.title: "The Yeti"
	quest.33A637CCABFE3478.quest_desc: ["Venus and Mercury are scorching hot. A Netherite Space Suit protects you from the heat."]
	quest.33A637CCABFE3478.title: "Feeling the Heat"
	quest.33C09B1CC6BCC9C4.quest_desc: ["Infuse Stone on the Natural Altar."]
	quest.33C1AF22808BBEFE.quest_desc: [
		"Drop 1,000 items."
		""
		"Your inventory is more of a suggestion."
	]
	quest.33C1AF22808BBEFE.title: "Butterfingers"
	quest.33C510D18355173E.quest_desc: ["Collect it from the Ender Dragon with glass bottles. You need it to craft eggs of other breeds."]
	quest.33C510D18355173E.title: "Dragon's Breath"
	quest.33D7C5FA0D8D0DBA.quest_desc: [
		"Complete every quest in &eThe Nether&r to earn the title &bNether Legend&r."
		""
		"The title is offered automatically. Choose &a[Accept]&r to wear it under your name – or &c[Decline]&r to keep it in your collection for later."
	]
	quest.33D7C5FA0D8D0DBA.quest_subtitle: "The Nether"
	quest.33D7C5FA0D8D0DBA.title: "Nether Legend"
	quest.33DBE8E47A2000EC.quest_subtitle: "Energy Hoppers are used to charge items in a chest without the need to use an energizing orb."
	quest.342746FC5598B958.quest_desc: [
		"Sleep in a bed 50 times."
		""
		"Five more minutes…"
	]
	quest.342746FC5598B958.title: "Professional Napper"
	quest.3447CA9EF02F3EAB.quest_desc: ["Wooden Stands hold the ingredients of a ritual. Right-click a stand to put an item on it."]
	quest.34825ED731B1F088.quest_desc: ["Stores pressurised air for Copper Diving gear and powers tools like the Extendo Grip."]
	quest.34825ED731B1F088.title: "Copper Backtank"
	quest.348316BB2ECD45E2.quest_desc: ["The Oxygen Distributor fills an enclosed room with breathable air."]
	quest.348316BB2ECD45E2.title: "A Base in Space"
	quest.34B32CB987E86B55.quest_desc: ["A Gold Sheet travels along a belt through Deployers and a Press several times. EMI shows every step."]
	quest.34B32CB987E86B55.quest_subtitle: "Your first Sequenced Assembly"
	quest.34B32CB987E86B55.title: "Precision Mechanism"
	quest.34BACF93066559BD.quest_desc: ["&7It seems that you are not the only one interested in the weapon. You should not make the Hive angry, or at least give them someone else to be angry about."]
	quest.34BACF93066559BD.quest_subtitle: "You can hear a buzzing coming from the weapon itself."
	quest.34F9620E5D4A864C.quest_desc: ["Craft an Empty Blaze Burner and right-click a Blaze with it. Placed under a Basin and fed fuel, it provides &6heat&r."]
	quest.34F9620E5D4A864C.title: "Blaze Burner"
	quest.3534158821AF3154.quest_desc: ["Every biome has its own creeper."]
	quest.3534158821AF3154.title: "Creeper Overhaul"
	quest.3538DE5BD564E72B.title: "First Power"
	quest.356C54D4D638AE2F.quest_desc: [
		"Somewhere in the mountains stand small round shrines – half sun, half moon, with a sundial in the middle."
		""
		"Their chest often holds the &dEclipse Upgrade Smithing Template&r, Eclipse nuggets and sometimes Oney himself."
	]
	quest.356C54D4D638AE2F.title: "The Sundial Shrine"
	quest.357835CF18BA26E5.quest_desc: ["The highest tier of essence."]
	quest.357835CF18BA26E5.title: "Supremium"
	quest.357DE55C2AE76AD4.quest_desc: [
		"Botanist's tools repair themselves with Aura from an Aura Cache – hold still and sneak."
		""
		"Right-click a block with the pickaxe to turn it into its mossy version. Ancient Wood Rods come from the planks of a grown Ancient Sapling."
	]
	quest.3585BCA265F583FF.title: "Citrine"
	quest.358C6CB7AB15450F.quest_desc: ["An infusion crystal that never breaks."]
	quest.358C6CB7AB15450F.title: "Master Infusion Crystal"
	quest.358D742BF236AFA7.quest_subtitle: "Energy Cells are basically a bulk battery that can contain and transfer energy to other machinery connected to it when a machine is taking time to produce energy."
	quest.35BCDD94DB46EDC4.quest_desc: ["Mine Inferium Ore underground or kill mobs – they sometimes drop Inferium Essence."]
	quest.35BCDD94DB46EDC4.title: "Inferium Essence"
	quest.35C83E0771128C01.title: "Glowshroom Forest"
	quest.3606BECBA8D9D929.title: "Cursium Mage"
	quest.36276B9C85E01C2E.quest_desc: [
		"Build one yourself: an &bEnigmatic Engine&r (dropped by the Hullbreaker) surrounded by 20 copper blocks, with 6 Depth Glass at the front."
		""
		"Or find an old wreck near the Abyssal Ruins and repair it with Copper Ingots. Then take it for a ride!"
	]
	quest.36276B9C85E01C2E.title: "Yellow Submarine"
	quest.363DBB83D5A12D52.quest_desc: ["Right-click blocks with Gravitite tools to make them float upwards!"]
	quest.363DBB83D5A12D52.title: "Defying Gravity"
	quest.36557DFA1DBA0E96.quest_desc: ["The Fuel Refinery refines Oil into Fuel. Check EMI for all ways to obtain oil."]
	quest.36557DFA1DBA0E96.title: "Rocket Fuel"
	quest.366EA20E32AA0729.quest_desc: ["Spent fuel becomes Cyanite. It can be reprocessed into Blutonium."]
	quest.366EA20E32AA0729.title: "Waste Not"
	quest.36C18805A70396A8.quest_desc: ["Turns lower essences into higher ones with an Infusion Crystal – no more crafting by hand."]
	quest.36C18805A70396A8.title: "The Infuser"
	quest.36FB624E14ACC22C.title: "1M Component"
	quest.36FCD662B4DB4E3D.quest_desc: ["The gateway to three extra worlds: &7The Mining Dimension&r (Overworld), &cThe Other&r (Nether) and &5The Beyond&r (End). Stand on the pad in the matching dimension and sneak."]
	quest.36FCD662B4DB4E3D.title: "Teleport Pad"
	quest.372B6EB1F66455B8.quest_desc: ["&7To go against what you know is to invent. But will that Reward be high enough?"]
	quest.372B6EB1F66455B8.quest_subtitle: "Heresy."
	quest.3730DF78DFBAF0B7.quest_desc: ["Pulls resources straight out of bedrock."]
	quest.3730DF78DFBAF0B7.title: "Bedrock Extractor"
	quest.378D1F288923842B.quest_desc: [
		"Free fall from the top of the world (build limit) to the bottom of the world and survive."
		""
		"A water bucket helps. So does praying."
	]
	quest.378D1F288923842B.title: "Caves and Cliffs"
	quest.37B04BB6D9E8FBFD.title: "Prudentium"
	quest.37CD6EBB40276EE2.quest_subtitle: "3rd Tier Capacitors used to upgrade to Blazing Machinery."
	quest.37CF3A5652C8ACB6.title: "Mercury"
	quest.384E5189E0273AE7.quest_subtitle: "Dry ice is used to cool down Reactors, another alternative to using water as coolant."
	quest.3879E0B671BFC250.title: "Hunter Belt"
	quest.38B7B906C3682FF9.quest_desc: [
		"Nature's Aura is about &aAura&r – the life energy of the world."
		""
		"Craft the book from 2 Paper, Leather and any Sapling. It explains every ritual and multiblock of the mod."
	]
	quest.38B7B906C3682FF9.title: "Book of Natural Aura"
	quest.38BFCEECF99D81F5.quest_desc: [
		"Place the egg and wait. The breed depends on the blocks around it – check with the Habitat Checker."
		""
		"Tip: craft an egg of another breed with Dragon's Breath (OneDay recipes)."
	]
	quest.38BFCEECF99D81F5.title: "Hatching"
	quest.38C9A1B7439A7A1A.title: "The Mining Dimension"
	quest.397D5E0DF0F51FDE.title: "Cheers!"
	quest.39C169FC7DA4F87B.title: "The Underworld Knight"
	quest.39C67965E649E388.quest_desc: ["Ferment Apple Juice into your first bottle of wine. Grapes from all over the world make many more."]
	quest.39C67965E649E388.title: "Apple Wine"
	quest.39CC5E41A968D44D.quest_desc: ["Rich Soil boosts plant growth and grows mushroom colonies."]
	quest.39E2E87B3D95BB79.title: "Lavender Fields"
	quest.3A2805EB2E39441B.quest_desc: ["Knives harvest straw from grass and crops, and get extra drops like Ham from animals."]
	quest.3A2805EB2E39441B.title: "Sharp Beginnings"
	quest.3A333A884ED801AE.quest_desc: ["&7Once bestowed by a great Arcane Mage. This Blade has seen more than most."]
	quest.3A333A884ED801AE.quest_subtitle: "&7You can't lose, you're chosen."
	quest.3A6590ECCFCFACA8.quest_desc: ["Kitchen storage that looks the part."]
	quest.3A778689A728B430.quest_desc: ["Insert items into a whole wall of drawers at once."]
	quest.3A8503F457566959.quest_desc: ["The Token of Fear needs Bottled Ghosts from the Nether, the Token of Sorrow needs Bottled Sunlight and a Ghast Tear."]
