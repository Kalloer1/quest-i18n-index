	quest.40358CDA0038D4BA.title: "Warrior"
	quest.404B537CF7E22BEF.quest_desc: ["Craft this Eye and throw it like an Eye of Ender – it flies towards the &6Acropolis&r."]
	quest.404B537CF7E22BEF.title: "Find the Acropolis"
	quest.40A8D7121622CD60.quest_desc: ["Leather strips and woolen fabric are the base of padded armor."]
	quest.40A8D7121622CD60.title: "Materials"
	quest.40B3339A8D3D3278.quest_desc: ["Put a picked-up villager inside to trade with it in a single block."]
	quest.40BF896ABF5FA668.quest_desc: ["Smaller mods that make automation easier and more fun."]
	quest.40BF896ABF5FA668.title: "Automate Everything"
	quest.40C5CFC3031DD7AD.quest_desc: [
		"Make the text of a sign glow."
		""
		"Because \"Keep Out\" is scarier in neon."
	]
	quest.40C5CFC3031DD7AD.title: "Glow and Behold!"
	quest.40CCEB6B8EBA9ED2.quest_desc: [
		"&bLunarium Ore&r hides deep in the deepslate, below Y 0. It glows faintly blue in the dark."
		""
		"You need at least a &bdiamond pickaxe&r to mine it."
	]
	quest.40CCEB6B8EBA9ED2.title: "A Piece of the Moon"
	quest.40D041CF404F1C06.quest_desc: [
		"The only tier 6 crop in OneDay: it grows Powah's Nitro Crystals."
		""
		"Every craft still needs a &eNether Star&r, so the Wither stays important. The Nether Star and Dragon Egg crops are switched off in this pack."
	]
	quest.40D041CF404F1C06.title: "Nitro Crop"
	quest.41127E411F9967A7.quest_desc: [
		"Honey Glazed Ham feasts, Lucky Blocks, a Netherite Backpack and a Dragon Egg around an Eclipse Ingot."
		""
		"Title: &dLife Legend"
	]
	quest.41127E411F9967A7.title: "Life Core"
	quest.4118927D9D079DC8.quest_desc: ["Rising like jagged thorns from the ground, these massive towers are defended by skeletons entwined with deadly roses. Each level is heavily fortified, and flying rose guards patrol the skies above. Only those who ascend to the top will claim the treasures and secrets hidden within."]
	quest.4118927D9D079DC8.quest_subtitle: "Visit the Thornborn Towers"
	quest.416979EA4C74AF88.quest_desc: ["Attach Drills to a Mechanical Bearing, Piston or Minecart Contraption to build tunnel bores and quarries. Use Super Glue to hold everything together."]
	quest.416979EA4C74AF88.title: "Moving Contraptions"
	quest.416D6B447B3DF038.quest_desc: ["Relics level up while you use them – check their abilities with shift."]
	quest.416D6B447B3DF038.title: "Bastion Ring"
	quest.41E2D38A68AC069F.title: "Infinity Ham"
	quest.4234921C3DF2EBFE.quest_desc: ["Bottle some &cGhosts&r in the Nether, then make the Token of Anger in the Ritual of the Forest."]
	quest.42690A79E3CE85F3.title: "Goddess Statue"
	quest.427A9A0A4B4BB9AA.quest_desc: ["The Ender Dragon awaits on the main island. Its fight is part of 💀 Bosses of the World."]
	quest.427A9A0A4B4BB9AA.title: "The End?"
	quest.42A67F5C0DA13C75.quest_desc: ["Reroll the affixes of an item."]
	quest.436231715C11E3BA.quest_desc: ["Scattered across the wilds, small bands of Illagers set up camp beneath their distinctive purple tents. Though their supplies are meager and their loot scarce, their presence is a warning, the Illagers’ reach grows wider with every outpost."]
	quest.436231715C11E3BA.quest_subtitle: "Find an Illager Campsite"
	quest.4370B71D22B07358.quest_desc: [
		"Everything from &aConfluence&r – the Terraria part of this pack – lives in its own dimension: the &2Otherworld&r. Your Overworld stays a normal Minecraft world, so both never get in each other's way."
		""
		"You received a &6Terrarium&r when you first joined. Use it to travel between the Overworld and the Otherworld."
		""
		"&7Lost it? Craft a new one from Glass Panes, a Sapling and Planks."
	]
	quest.4370B71D22B07358.quest_subtitle: "The Terrarium"
	quest.4370B71D22B07358.title: "Your Ticket to the Otherworld"
	quest.43B614D2004AFB7E.quest_desc: ["An automatic crafting table with remembered recipes."]
	quest.43B614D2004AFB7E.title: "RFTools Crafter"
	quest.43E154758356ECF0.quest_desc: ["Wizard robes boost spell power. Choose Arcane, Fire or Frost."]
	quest.4417AD6C1BD1A80A.quest_desc: ["Goblins wander through caves and trade rare items for emeralds. Vein Goblins live in the Nether."]
	quest.4417AD6C1BD1A80A.title: "Goblin Traders"
	quest.441CA314726CA8AB.quest_desc: [
		"The &aExchange Counter&r swaps &aEmeralds&r and &7Silver Coins&r – &a1 Emerald&r = &715 Silver Coins&r, both ways. One economy for the Overworld and the Otherworld."
		""
		"&7A Stonecutter also turns an Emerald into 15 Silver Coins – but only the Exchange Counter turns coins back into Emeralds."
	]
	quest.441CA314726CA8AB.title: "Money Talks"
	quest.44266A4B1118A31E.quest_subtitle: "5th Tier Capacitors used to upgrade to Spirited Machinery."
	quest.446A7A2517450540.quest_desc: ["An automatic crafting table for essence recipes. Feed it essence, get iron, diamonds and more."]
	quest.446A7A2517450540.title: "The Crafter"
	quest.44A43AAFB17810E4.quest_desc: ["Jewelry adds rings and necklaces with gems and special unique pieces."]
	quest.44A43AAFB17810E4.title: "Jeweler"
	quest.44BEFB55D357FD43.quest_desc: ["Mines entire ore veins deep underground with a giant bucket wheel. Find veins with the Core Sample Drill."]
	quest.44BEFB55D357FD43.title: "Excavator"
	quest.44D115281B0BFB75.quest_desc: ["Whispers speak of a &9flying vessel&r that hovers above the world, shimmering with strange energy. Few dare approach, for those who return tell of eerie lights, warped corridors, and guardians not of this realm. Seek it out, if you dare—and uncover the secrets hidden within its metallic shell."]
	quest.44D115281B0BFB75.quest_subtitle: "Find a Giant Mushroom"
	quest.44D87F68EC65B4AF.quest_desc: [
		"Surround it with flowers, put the items you want to offer into the bowl and throw a Spirit of Calling next to it."
		""
		"If the gods accept, their gift rains down from the sky."
	]
	quest.44DF2808880BD984.quest_desc: ["An Ender Crystal surrounded by Emerald Blocks. It attunes teleporters at a Smithing Table."]
	quest.44E6A59C0FD32C69.quest_desc: ["Netherite gear + Ruby Upgrade Smithing Template + Ruby Ingot at a Smithing Table."]
	quest.44E6A59C0FD32C69.title: "Ruby Upgrade"
	quest.44EE18F81A61FCEE.quest_subtitle: "Capacitors are the next parts that are used to create a variety of electric machinery, you can either combine two capacitors to get a large one or cut one to get two tiny capacitors."
	quest.44EE18F81A61FCEE.title: "Secondary Parts"
	quest.45156481B6D4B044.quest_desc: ["Summon it far away from anything you love."]
	quest.45156481B6D4B044.title: "The Wither"
	quest.45163F8A6463C455.quest_desc: ["&7Guess what? It stabs a bit further than just wielding it. Hope the Stick doesnt break. Disgrace."]
	quest.45163F8A6463C455.quest_subtitle: "This is literally just a Sword on a stick."
	quest.451C77FC19903965.quest_desc: ["Spirit rites create area effects around a Totem Base."]
	quest.4538F9B15C286DB5.quest_desc: ["The fuel of the Aether – for Altars, Freezers, Incubators and torches."]
	quest.4538F9B15C286DB5.title: "Ambrosium"
	quest.453A6B33F5912461.quest_desc: [
		"Jump into a Honey Block to break your fall."
		""
		"Tastes like survival."
	]
	quest.453A6B33F5912461.title: "Sticky Situation"
	quest.455328140F74C57D.quest_desc: ["Juice turns into wine in the Fermentation Barrel."]
	quest.455378FC65B48C2F.quest_desc: ["Build a brewing station and brew beer from hops, dried grain and yeast."]
	quest.4574358CD870AE65.quest_desc: ["Bastions are full of Piglins and treasure. Wear at least one piece of gold armor so Piglins stay calm."]
	quest.4574358CD870AE65.title: "Bastion Remnant"
	quest.45B6D09D25D07F7D.quest_desc: ["Welcome to the Moon. Low gravity, no air – and cheese?"]
	quest.45B6D09D25D07F7D.title: "One Small Step"
	quest.45CACD789D7D92DD.quest_desc: ["Craft this Eye and throw it like an Eye of Ender – it flies towards the &6Sunken City&r."]
	quest.45CACD789D7D92DD.title: "Find the Sunken City"
	quest.4602FD0E33DD4D5E.quest_desc: [
		"&7The inscription, in a rusty, bloody paint says:"
		"&4I bind myself to you tonight,&r"
		"&4No matter the shift of the knife,&r"
		"&4Through blood and bone,&r"
		"&4Flesh and Heart,&r"
		"&4Death may come,&r"
		"&4But we shall not part.&r"
	]
	quest.4602FD0E33DD4D5E.quest_subtitle: "The Death Oath"
	quest.461E65850546FC41.quest_desc: ["Find wild cabbages, tomatoes, onions and rice out in the world and plant them at home."]
	quest.461E65850546FC41.title: "Wild Crops"
	quest.4636BDC0E4B33561.quest_desc: ["&7Whoever wronged the Wielder shall pay the Price tenfold."]
	quest.4636BDC0E4B33561.quest_subtitle: "The Fire on this Blade is fueled by hate like Gasoline."
	quest.46554095B939F28C.quest_desc: ["&7Be not scared of the Betrayal you see, but the one you cannot see."]
	quest.46554095B939F28C.quest_subtitle: "Through the Heart"
	quest.46786C23CB829A31.quest_desc: [
		"Tokens are wooden figures that hold an emotion. They are made in the Ritual of the Forest."
		""
