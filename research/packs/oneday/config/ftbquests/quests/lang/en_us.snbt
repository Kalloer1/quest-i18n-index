	quest.1014455789A6FCDD.quest_desc: ["Moog's End Structures fills the outer islands with ruins, towers, shrines and giant crashed ships. Find at least one of them!"]
	quest.1014455789A6FCDD.title: "Explorer of the Void"
	quest.102A464C6C32993B.quest_desc: ["Advanced Netherite improves netherite with iron, gold, emerald and diamond – each tier better than the last."]
	quest.102A464C6C32993B.title: "Advanced Netherite"
	quest.10710081934A30C6.quest_desc: ["&7You were sent to destroy them, not join them!"]
	quest.10710081934A30C6.quest_subtitle: "Tainted and Twisted."
	quest.109DA73D0390ED37.quest_desc: [
		"Wear all four pieces for the set bonus:"
		""
		"&6☀ Sun:&r Regeneration and Speed"
		"&b☾ Moon:&r Night Vision and Strength"
		""
		"The armor changes its look with the time of day – golden by day, starry blue by night."
	]
	quest.109DA73D0390ED37.title: "Clothed in Sun and Moon"
	quest.10B753CFD971CB80.quest_subtitle: "Ender Cells are energy transferring machinery that is wireless and will transfer power through another Ender Cell using the same channel number. Each Ender Cell must contain an Energy Cell in order to function and store power."
	quest.1109BFF473EEAE0F.title: "99 Balloons"
	quest.112ECF849360ADD2.quest_desc: ["Write down the name of a Foliot – the weakest spirit – to bind it."]
	quest.112ECF849360ADD2.title: "Book of Binding"
	quest.114D6A6698F7E792.quest_desc: ["Sneak + right-click to switch it on: then it mines a whole ore vein at once."]
	quest.11694880AD276E3D.quest_desc: ["Hatch Moa Eggs in the Incubator for your own flying mount."]
	quest.11694880AD276E3D.title: "Moa Ranch"
	quest.11795BAAF294BDDA.quest_desc: ["Kill mobs with the Soulium Dagger while a Soul Jar is in your inventory to fill it. Filled jars are needed for mob seeds."]
	quest.11795BAAF294BDDA.title: "Mob Souls"
	quest.118162F2F3CEFD45.title: "Enchanted Tangle"
	quest.120D362256EB5522.quest_desc: [
		"Great to have you here! &6OneDay 2.0&r mixes technology, magic, Terraria-style adventure, new dimensions and brutal bosses into one big world."
		""
		"This quest book is your guide. It won't hold your hand everywhere – experimenting is half the fun – but it will always point you somewhere worth going."
		""
		"&eTip:&r Finishing a quest unlocks the next ones. You can also complete quests out of order – they tick off as soon as their prerequisites are done."
	]
	quest.120D362256EB5522.quest_subtitle: "Start here"
	quest.120D362256EB5522.title: "Welcome to OneDay 2.0!"
	quest.12524F7E1BC7446E.quest_desc: ["Candlelight adds fine dining: pans, stoves, sinks and a Dinner Bell."]
	quest.12719CF6C9BB78C4.quest_desc: ["Addons for your AE2 network: huge storage cells, better pattern providers, quantum crafting and power storage."]
	quest.12719CF6C9BB78C4.title: "Bigger Networks"
	quest.128AE3D974FBFCF4.quest_desc: ["Put ingredients into a Basin and place a Mechanical Mixer above it for mixing recipes."]
	quest.128AE3D974FBFCF4.title: "Mixer and Basin"
	quest.1299DA76794F4557.quest_desc: ["&7All Power demands Sacrifice and Pain."]
	quest.1299DA76794F4557.quest_subtitle: "&7I will rend the Flesh, until i stand as a unholy god."
	quest.12BEB26CC7B99297.quest_desc: ["Creepers sometimes drop Plush Boxes. Open one for a random plushie!"]
	quest.12C3D1BD623E5663.quest_desc: [
		"Luminite and Hallowed Bars, a Life Fruit and a Soul of Might around an Eclipse Ingot."
		""
		"Title: &dTerraria Legend"
	]
	quest.12C3D1BD623E5663.title: "Terraria Core"
	quest.12F9B25AFE36EF08.quest_desc: [
		"Stay alive for 5 hours of playtime in a row."
		""
		"One death resets the timer. No pressure."
	]
	quest.12F9B25AFE36EF08.title: "Plot Armour"
	quest.1325F54BBE6F99C5.quest_desc: ["Hold right-click to block. Many enemies in this pack hit hard!"]
	quest.13397125C6E2241D.quest_desc: ["Netherite gear + Aquamarine Upgrade Smithing Template + Aquamarine Ingot at a Smithing Table."]
	quest.13397125C6E2241D.title: "Aquamarine Upgrade"
	quest.1350CE31C1143F54.quest_desc: [
		"Complete every quest in &eDeeper and Darker&r to earn the title &bDeep Dark Legend&r."
		""
		"The title is offered automatically. Choose &a[Accept]&r to wear it under your name – or &c[Decline]&r to keep it in your collection for later."
	]
	quest.1350CE31C1143F54.quest_subtitle: "Deeper and Darker"
	quest.1350CE31C1143F54.title: "Deep Dark Legend"
	quest.138F5BC616B4A97C.quest_desc: [
		"Your first Aura generator: it eats small flowers next to it and turns them into Aura."
		""
		"Feed it different flowers – the same flower over and over stops working."
	]
	quest.13941733056B337D.title: "Allthemodium Armor"
	quest.13B2D9F7CE1957DC.quest_desc: ["The whole Infusion Altar with all its pedestals in one machine."]
	quest.13B2D9F7CE1957DC.title: "Infusion Altarnator"
	quest.13B5E4EF97D6308F.quest_subtitle: "Dielectric Paste is an ingredient used to glue and craft electric parts used in the machinery, you should prepare a lot if you plan on upgrading."
	quest.13B5E4EF97D6308F.title: "Electric Glue"
	quest.13BC44B8329E422D.title: "Dead Beard"
	quest.13BD9628ED76D994.quest_desc: [
		"Complete every quest in &eExploration Tools&r to earn the title &bPathfinder&r."
		""
		"The title is offered automatically. Choose &a[Accept]&r to wear it under your name – or &c[Decline]&r to keep it in your collection for later."
	]
	quest.13BD9628ED76D994.quest_subtitle: "Exploration Tools"
	quest.13BD9628ED76D994.title: "Pathfinder"
	quest.13EE77249477FF2E.quest_desc: [
		"Infuse an Iron Ingot on the Natural Altar."
		""
		"It costs a lot of Aura – keep plants and trees around the altar."
	]
	quest.1429BB036F101F06.quest_desc: ["Nine Eclipse Ingots. Works as a beacon base, too."]
	quest.1429BB036F101F06.title: "Eclipse on Display"
	quest.1462F62C1D093E6B.title: "Better Solar"
	quest.14857DBF1DCBF100.quest_desc: ["Cresting the waves like a shadow of the past, this cursed vessel is crewed by skeletons that seem impossible to keep down. Every deck hides danger, every hold whispers of lost treasure and every strike you land may be fleeting. Only the bold (or the foolhardy) dare to face its relentless undead crew."]
	quest.14857DBF1DCBF100.quest_subtitle: "Find an Undead Pirate Ship"
	quest.1497D0EE5FC769D9.title: "Jade Ingot"
	quest.149F59892DA42648.title: "Heart Container"
	quest.14A05156775B1E05.title: "Ametrine"
	quest.14B651BC47025356.quest_desc: [
		"Every boss drops a &6Trophy&r the first time you help defeat it – a tiny statue of the boss to put on your shelf."
		""
		"Everyone within 64 blocks gets one, so bring your friends!"
	]
	quest.14B651BC47025356.title: "Trophy Hunter"
	quest.14E5FA8D4CC56B10.quest_desc: [
		"Hollow box of casing (glass allowed on the sides), a controller, fuel rods from bottom to top with a control rod on top of each, and a power tap."
		""
		"Put Yellorium into an access port or the controller."
	]
	quest.14E5FA8D4CC56B10.title: "Your First Reactor"
	quest.1526F87B624D73B7.quest_desc: [
		"Dragon Mounts: Remastered lets you hatch and ride dragons. There are 11 kinds – fire, ice, forest, water, end, nether, aether, ghost, sculk, lush and amethyst."
		""
		"[\"\",{\"text\":\"Call your dragon: \"},{\"keybind\":\"dmr.keybind.summon_dragon\",\"color\":\"gold\"},{\"text\":\"\"}]"
		"[\"\",{\"text\":\"Breath attack while riding: \"},{\"keybind\":\"dmr.keybind.attack\",\"color\":\"gold\"},{\"text\":\"\"}]"
	]
	quest.1526F87B624D73B7.title: "Here Be Dragons"
	quest.1533AF90DDBBE2B5.quest_desc: [
		"Grows one kind of seed inside a single block and pushes the essence out – perfect for pipes."
		""
		"It needs the seed, the right farmland and fuel. In OneDay it works as fast as a normal field, it just saves space and hands."
	]
	quest.1533AF90DDBBE2B5.title: "The Farmer"
	quest.15402034CBA50BE6.quest_desc: ["Deep in ancient catacombs lies the resting place of the Dead King. Wake him – if you dare."]
	quest.15402034CBA50BE6.title: "The Dead King"
	quest.155B7C795F7E734C.quest_desc: [
		"Crafted from a Book and a set of iron tools."
		""
		"[\"\",{\"text\":\"Open it with \"},{\"keybind\":\"key.ars_nouveau.open_book\",\"color\":\"gold\"},{\"text\":\" and try Projectile + Harm for your first attack spell.\"}]"
		"[\"\",{\"text\":\"Switch between saved spells with \"},{\"keybind\":\"key.ars_nouveau.selection_hud\",\"color\":\"gold\"},{\"text\":\".\"}]"
	]
	quest.155B7C795F7E734C.title: "Novice Spell Book"
	quest.1562FA62AD06CB8D.quest_desc: ["Lances deal huge damage when you charge on horseback."]
	quest.1562FA62AD06CB8D.title: "Joust!"
	quest.15730B999806675C.quest_desc: ["Arrange Mechanical Crafters in a grid to automate even the largest recipes."]
	quest.15730B999806675C.title: "Mechanical Crafters"
	quest.159B92CB8A05264B.quest_desc: [
		"&6Alex's Caves&r hides rare cave biomes deep underground – each with its own creatures, materials and a boss."
		""
		"Cave Tablets point the way. You find them in &6Underground Cabins&r in normal caves, and as loot in Jungle Temples, Witch Huts, Underwater Ruins, Woodland Mansions, Bastions and suspicious sand."
	]
	quest.159B92CB8A05264B.title: "It Belongs in a Museum"
	quest.15A88EE622C1F407.quest_subtitle: "Energizing Rods are a type of machinery that energizes items contained in an energizing orb and transforms them."
	quest.15B727B8696B2393.title: "The Infernal Dragon"
	quest.15C792151E9226A1.quest_desc: ["Wixies craft items and brew potions at a Wixie Cauldron."]
	quest.15C792151E9226A1.title: "Wixie"
	quest.15EF6F6E4B670A54.quest_desc: [
		"&6Iron's Spells 'n Spellbooks&r is all about collecting spells and casting them from a Spell Book."
		""
		"Your first book is simple: Copper, Paper and String."
	]
	quest.15EF6F6E4B670A54.title: "Flimsy Journal"
	quest.15F101A3E9237DBE.quest_desc: ["The base for every backpack upgrade."]
	quest.15F15105C7FF30A8.quest_desc: [
		"Plant seeds that grow iron, coal, quartz and much more."
		""
		"&6OneDay rules&r (to keep things fair):"
		"• Crops never drop a second seed – every seed has to be crafted."
		"• Resource crops only grow on the Farmland of their tier."
		"• Harvests give about half of the usual resources."
		"• There are no crops for Netherite, Wither Skulls, AE2 presses, Fiery Ingots or Knightmetal."
		""
		"&7All altar and infusion recipes can be looked up in EMI (press R or U on an item)."
	]
	quest.15F15105C7FF30A8.quest_subtitle: "Farming, but for diamonds"
	quest.15F15105C7FF30A8.title: "Mystical Agriculture"
	quest.16098E969CB95DF8.title: "Burned"
	quest.161B9D65D5A1C911.quest_desc: ["Chests linked by their color code – even across dimensions."]
	quest.161C85F603FA6A6A.quest_desc: [
		"Welcome to the most useless chapter of the whole quest book!"
		""
		"Nothing here makes you stronger. Some of it will make you look silly. All of it is worth it."
		""
		"&7Most of these quests track your statistics – they complete on their own while you play."
	]
	quest.161C85F603FA6A6A.quest_subtitle: "Serious business only. Just kidding."
	quest.161C85F603FA6A6A.title: "Just for Laughs"
	quest.163883D874FD5FD2.title: "Reverse Card"
	quest.1647461BC7220064.quest_desc: [
		"Complete every quest in &eMonsters of the World&r to earn the title &bMonster Hunter&r."
		""
		"The title is offered automatically. Choose &a[Accept]&r to wear it under your name – or &c[Decline]&r to keep it in your collection for later."
	]
	quest.1647461BC7220064.quest_subtitle: "Monsters of the World"
	quest.1647461BC7220064.title: "Monster Hunter"
	quest.16A865F4E9A0B9E7.quest_desc: ["Brew better Ink here, and break unwanted scrolls down into useful ingredients."]
	quest.16A865F4E9A0B9E7.title: "Alchemist Cauldron"
	quest.16F14229B133E35C.title: "Pressure Tubes"
	quest.16F23967840B04A7.quest_desc: ["Smelt or blast Raw Solarium. Create, Mekanism and Immersive Engineering can double your ore."]
	quest.16F23967840B04A7.title: "Solarium Ingot"
	quest.1709924A9B5594CD.quest_desc: ["Zanite tools get faster the more worn they are."]
	quest.1709924A9B5594CD.title: "Zanite"
	quest.170AA1F64096297F.quest_desc: ["Needed for Afrit rituals."]
	quest.17349BCDB45CA495.quest_desc: ["The flame knight guards the Burning Arena. Defeat him for Ignitium."]
	quest.17349BCDB45CA495.title: "Ignis"
	quest.1756C4878E9FD78F.title: "Tier 3 Rocket"
	quest.1777D7389714FA04.quest_desc: ["Links blocks and creatures together – for example, telling a Starbuncle where to pick up and drop off items."]
	quest.1777D7389714FA04.title: "Dominion Wand"
	quest.177CE07DA601DF07.quest_desc: ["&7Even the calmest minds, have a Storm brewing in them. But it is up to the mind to learn when to unleash it."]
	quest.177CE07DA601DF07.quest_subtitle: "&7Before the Storm, there is always a certain type of calm."
	quest.17AF8ADFC1218B90.quest_desc: ["An adorable little item courier. Use the Dominion Wand to assign where it takes items from and where it brings them."]
	quest.17AF8ADFC1218B90.title: "Starbuncle"
	quest.17B5281769381237.quest_desc: ["&7Kill what you hold dear. Kill what sees you. Do you see your reflection in your own doing?"]
	quest.17B5281769381237.quest_subtitle: "THE EYES, OH GOD NOT THE EYES"
	quest.17BA9D67A60AC3F4.quest_desc: ["The advanced tome – the deeper secrets of Malum."]
	quest.17FA5AE32F7A22DD.quest_desc: ["&7A sign of intelligence is an awareness of one's own ignorance."]
	quest.17FA5AE32F7A22DD.quest_subtitle: "A Pain unfelt by the Guilty."
	quest.180107AB50FED2A3.quest_desc: ["Right-click a Stripped Log or Stripped Wood with Andesite Alloy. Casing is the frame of most early machines."]
	quest.180107AB50FED2A3.title: "Andesite Casing"
	quest.1805522FD3CDD838.quest_desc: ["Enter the &9Abyssal Chasm&r at the bottom of the ocean."]
	quest.1805522FD3CDD838.title: "Into the Abyss"
	quest.18410956C2D6956A.quest_desc: ["Smelt Iron Ore into ingots and craft an Iron Pickaxe – it can mine diamonds."]
	quest.18410956C2D6956A.title: "Iron Age"
	quest.18435254F79DB63B.quest_desc: ["Trial Chambers are hidden underground. Beat the waves of the trial spawners to earn Trial Keys, which open the vaults."]
	quest.18435254F79DB63B.title: "Trial and Error"
	quest.18724D965654056F.quest_subtitle: "By itself, it's not useful, but after using it on a Zombie or a Husk, it will upgrade into the Player Aerial Pearl."
	quest.188AAB5B74C6EAAE.quest_subtitle: "Discover an Infested Temple explorer map"
	quest.18A087DCCED26705.quest_desc: ["The Caking Station is where cakes and cupcakes are assembled."]
	quest.18AC409C98B4B5D8.quest_desc: ["Each scroll holds one spell. Find them as loot, or forge your own later."]
	quest.18AC409C98B4B5D8.title: "Spell Scrolls"
	quest.18BFEC67E61DC759.title: "Quantum Armor"
	quest.18C4F3367A04B882.quest_desc: ["&7You wear vengeance like armor, but it corrodes from within. You will become what you destroy."]
	quest.18C4F3367A04B882.quest_subtitle: "Wrath is a Sin that corrodes from within."
	quest.18CCA8C4CDE6F453.quest_desc: ["Once the dragon is defeated, End Gateways appear. Throw an Ender Pearl into one to reach the outer islands."]
	quest.18CCA8C4CDE6F453.title: "Beyond the Gateway"
	quest.18ED1941D66ADE61.quest_desc: ["Jewelry adds rings and necklaces with class bonuses. Gems come from Gem Veins underground."]
