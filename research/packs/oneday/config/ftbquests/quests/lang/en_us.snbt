	quest.6BEBFBFD51FE589A.quest_desc: ["Pray at statues to trade Spirit Orbs for more hearts or stamina."]
	quest.6BEBFBFD51FE589A.title: "Horned Statue"
	quest.6BED9D42446EC716.quest_desc: ["Stores enchanted books and lets you extract enchantments at any level you have unlocked."]
	quest.6BFE5D35265080E6.quest_desc: ["A sprawling underground stronghold, the Scorched Mines radiate in four cardinal directions from a central dome. Heat and shadows fill the tunnels, and danger lurks at every turn. Brave adventurers who navigate its branching paths may uncover riches, but only if they survive the hazards within."]
	quest.6BFE5D35265080E6.quest_subtitle: "Find the Scorched Mines"
	quest.6C457F6B4DCC7DB8.quest_desc: ["Earn Victory Medals by defeating her Valkyries – only then will the Queen accept your challenge."]
	quest.6C457F6B4DCC7DB8.quest_subtitle: "Silver Dungeon"
	quest.6C457F6B4DCC7DB8.title: "The Valkyrie Queen"
	quest.6C6ADBA003AEA8FD.title: "Advanced Compressor"
	quest.6C7E53A4792B2249.quest_desc: ["Two addons add schools, spells and mage armor for Iron's Spells 'n Spellbooks – made from the bosses of Cataclysm and the biomes of Alex's Caves."]
	quest.6C7E53A4792B2249.title: "More Spells"
	quest.6C8EF8F603BE09B6.quest_desc: ["Enter the &aToxic Caves&r. Do not linger without protection!"]
	quest.6C8EF8F603BE09B6.title: "Radiation Zone"
	quest.6CA3F93FF5E2BD22.title: "Illusioner"
	quest.6CAF6F9F3FACE781.quest_desc: ["Automatically feeds you from the backpack."]
	quest.6CB5ACBAAED66871.quest_desc: ["Shaped from the stem and cap of a giant fungus, this whimsical dwelling offers a rare touch of charm in a perilous world. Lightly guarded and easy to claim, the mushroom house makes for a delightful refuge, perfect for any adventurer who’s ever dreamed of calling a mushroom home."]
	quest.6CB5ACBAAED66871.quest_subtitle: "Find a Mushroom House"
	quest.6CBF0E8BFDF02291.quest_desc: ["Oritech is a modern tech mod with animated machines, lasers and even a particle accelerator. Motors are the first key part."]
	quest.6D3856516544C296.quest_desc: ["Pick any biome and the compass points you to the nearest one."]
	quest.6D3856516544C296.title: "Nature's Compass"
	quest.6D3B7F9D1AB765E4.quest_desc: ["Offer each Token to the gods to get its stronger version: Euphoria, Terror, Rage and Grief."]
	quest.6D3B7F9D1AB765E4.title: "Gifts of the Gods"
	quest.6D7F4962B4200281.quest_desc: [
		"Craft a Paraglider."
		""
		"Jump off something tall and hold the use key. What could go wrong?"
	]
	quest.6D7F4962B4200281.title: "I Believe I Can Fly"
	quest.6DEE76E4D23A69D0.quest_desc: [
		"Every path of OneDay ends in a &dcore&r: Tech, Arcane, Terraria, Warrior, Explorer and Life."
		""
		"Place all six on a &5Star Altar&r and use a &fNether Star&r to start the ritual. What comes out is the &6OneDay Star&r."
		""
		"The first time you hold a core you are offered its title – &aaccept&r it to wear it under your name, or keep it for later."
	]
	quest.6DEE76E4D23A69D0.quest_subtitle: "Everything leads here"
	quest.6DEE76E4D23A69D0.title: "The Final Goal"
	quest.6DFB02BE2BBCD53E.title: "Dragon Tower"
