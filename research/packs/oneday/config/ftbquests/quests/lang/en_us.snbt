	quest.1DA91EDDFF464BB2.title: "Town Mayor"
	quest.1DC7E421FC37767E.quest_desc: ["Deep in the Nether."]
	quest.1DC7E421FC37767E.title: "Underworld Arena"
	quest.1DF27FDF080455AC.quest_desc: ["Glide from high places. Gliding uses stamina."]
	quest.1DF27FDF080455AC.title: "Paraglider"
	quest.1E0686645B73CFBE.quest_desc: [
		"Ride a real pig for 1 kilometre."
		""
		"Carrot on a stick required. Patience even more so."
	]
	quest.1E0686645B73CFBE.title: "When Pigs Fly… Slowly"
	quest.1E1F30AA23256133.quest_desc: [
		"Every adventurer grows – this pack has a full skill system:"
		""
		"[\"\",{\"text\":\"• Press \"},{\"keybind\":\"key.puffish_skills.open\",\"color\":\"gold\"},{\"text\":\" to open your Skill Trees.\"}]"
		"• Earn skill points by fighting, mining and exploring, then spend them on permanent perks."
		"• The &6Class Skills&r tree lets you specialise as a Wizard, Paladin, Rogue, Archer and more."
		""
		"[\"\",{\"text\":\"Tip: \",\"color\":\"yellow\"},{\"text\":\"Apotheosis adds World Tiers – higher tiers mean tougher enemies and better loot. Change the tier with \"},{\"keybind\":\"key.apotheosis.open_world_tier_select\",\"color\":\"gold\"},{\"text\":\".\"}]"
	]
	quest.1E1F30AA23256133.title: "Grow Stronger!"
	quest.1E20C53F8A899108.title: "The Kraken"
	quest.1E21538FFDD8E669.quest_desc: ["Every multiblock layout is explained here."]
	quest.1E3046EB37F29BD6.quest_desc: ["Mithril Ore lies deep underground. It is needed for top-tier spell books and gear."]
	quest.1E3046EB37F29BD6.title: "Mithril"
	quest.1E38ABA8FE3A09FB.quest_desc: ["Enter the &6Primordial Caves&r – dinosaurs still live down here."]
	quest.1E38ABA8FE3A09FB.title: "Land Before Time"
	quest.1E43CA1D1052238D.quest_desc: ["&7A Fire only rises as high as its Fuel lets it to."]
	quest.1E43CA1D1052238D.quest_subtitle: "In order to understand, he destroyed himself."
	quest.1E4A521988AEE7E7.title: "Extended Assembler"
	quest.1E50DCCAFCBC436E.title: "Redwood Thicket"
	quest.1E58FE80AE0FCA72.title: "Aquamarine Ingot"
	quest.1E65DAC37F8D34F9.quest_desc: ["&7Look at your righteousness.  If only they could see you now."]
	quest.1E65DAC37F8D34F9.quest_subtitle: "All Mighty!"
	quest.1E92741C10D47A6A.quest_desc: [
		"Complete every quest in &eBosses of the World&r to earn the title &bBoss Slayer&r."
		""
		"The title is offered automatically. Choose &a[Accept]&r to wear it under your name – or &c[Decline]&r to keep it in your collection for later."
	]
