	quest.6FD2FD1F7F98537C.quest_desc: ["Use a Photoelectric Pane on an Enderman or Endermite."]
	quest.6FD2FD1F7F98537C.quest_subtitle: "A Lens of Ender allows a Solar Panel to see through blocks which allows it to absorb sunlight while under a block."
	quest.6FFB45B92B717ACB.title: "Exo Armor"
