		"&7Click to identify which power you have rolled."
	]
	quest.47EBDA6516061205.quest_subtitle: "Made with Ash."
	quest.48915D5C4A221F8F.quest_desc: ["Netherite gear + Ametrine Upgrade Smithing Template + Ametrine Ingot at a Smithing Table."]
	quest.48915D5C4A221F8F.title: "Ametrine Upgrade"
