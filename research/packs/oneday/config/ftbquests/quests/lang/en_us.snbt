	quest.1ED0B8E68A69E40D.title: "Master Chef"
	quest.1EE26CA611722F29.title: "Under and Beyond"
	quest.1F10BC33D22328BD.quest_desc: ["Time has claimed this once-sacred site, leaving its halls cracked and overgrown. Now, ghostly skeletons and trickster illusioners linger within, guarding little more than shadows of former glory. Though its dangers are real, the temple’s sturdy walls make it a tempting refuge for those seeking a foothold in this hostile world."]
	quest.1F10BC33D22328BD.quest_subtitle: "Find an Abandoned Temple"
	quest.1F122AAD99D2A3D2.quest_desc: ["Lay Tracks, build a Station, assemble a train around Train Controls and give it a Schedule. Trains are the best way to move goods – and yourself – over long distances."]
	quest.1F122AAD99D2A3D2.quest_subtitle: "Create Trains"
	quest.1F122AAD99D2A3D2.title: "All Aboard!"
	quest.1F1234567890BCDE.quest_desc: ["Craft a Potion Filter and combine it with a vanilla potion to feed into your Infusion Pylon for persistent chunk-wide effect scaling."]
	quest.1F1234567890BCDE.title: "Potion Filter"
	quest.1F1E9322EFDF2987.quest_desc: ["The Moon's metal. You need it for the Tier 2 rocket."]
	quest.1F1E9322EFDF2987.title: "Desh"
	quest.1F3107CA85323111.title: "Steel Plates"
	quest.1F32FF7BFF9562A0.quest_desc: [
		"Complete every quest in &eTools and Weapons&r to earn the title &bToolsmith&r."
		""
		"The title is offered automatically. Choose &a[Accept]&r to wear it under your name – or &c[Decline]&r to keep it in your collection for later."
	]
	quest.1F32FF7BFF9562A0.quest_subtitle: "Tools and Weapons"
	quest.1F32FF7BFF9562A0.title: "Toolsmith"
	quest.1F48F405C4C70D3C.quest_desc: ["Extends the face you look at with blocks from your inventory – building made fast."]
	quest.1F8F18087EA99B02.quest_desc: [
		"Die once."
		""
		"Don't worry, it happens to the best of us. And to you."
	]
	quest.1F8F18087EA99B02.title: "First of Many"
	quest.1F914EAF1C4B4C9E.title: "Cave Creeper"
	quest.1FB3A6C4C6AFF557.quest_desc: ["Place Steam Engines on a Fluid Tank, heat the tank with Blaze Burners and pump in water. A large boiler produces enormous amounts of stress capacity."]
	quest.1FB3A6C4C6AFF557.title: "Steam Power"
	quest.1FE0A0287CAFBB7D.quest_desc: ["The storm-wielding queen of the Acropolis."]
	quest.1FE0A0287CAFBB7D.title: "Scylla"
	quest.1FE9AB988B724596.title: "Vibranium Ingot"
	quest.1FEDCA8B2494A1DC.quest_desc: [
		"You have learned the basics – now the world is yours! The chapter list on the left is sorted into seven paths:"
		""
		"&6⭐ OneDay&r – Sun and Moon ores, Eclipse gear, bounties, the OneDay Star and legend titles"
		"&e🏡 Life and Survival&r – vanilla milestones, cooking, farming, storage and a bit of luck"
		"&2🌍 Dimensions&r – the Twilight Forest, the Aether, Alex's Caves, the Nether, the End, space and more"
		"&d✦ Magic&r – Ars Nouveau, Iron's Spells, Occultism and Malum"
		"&c⚔ Combat&r – bosses, dungeons, RPG classes and Apotheosis"
		"&6⚙ Technology&r – Create, Mekanism, AE2, Immersive Engineering, Oritech, Ender IO and more"
		"&a🌳 Terraria&r – the Confluence journey in its own dimension, the Otherworld (use your Terrarium!)"
		""
		"There is no single right order. Follow whatever looks fun!"
	]
	quest.1FEDCA8B2494A1DC.title: "Where Does Your Path Lead?"
	quest.1FF94EC1526D52CD.quest_desc: [
		"Strike a villager with lightning."
		""
		"Channeling trident plus thunderstorm. He had it coming. Probably."
	]
	quest.1FF94EC1526D52CD.title: "Very Very Frightening"
	quest.20078D0C6307CA00.quest_desc: [
		"Find the template in a Sundial Shrine or craft one from diamonds, Solarium, Lunarium and an Eclipse Ingot."
		""
		"Smithing Table: &dTemplate + diamond gear + Eclipse Ingot&r. Copy the template with diamonds and a Lunarium block."
	]
	quest.20078D0C6307CA00.title: "Eclipse Upgrade"
	quest.2047A1E40BB31AF7.quest_desc: ["Cooking coal produces Coal Coke and Creosote Oil."]
	quest.20948E5613D180F0.quest_desc: ["A sturdier book with more spell slots."]
	quest.20948E5613D180F0.title: "Ironbound Tome"
	quest.20CB04DF18E5B32F.quest_desc: ["Two Crushing Wheels spinning towards each other process items dropped between them – much faster than a Millstone."]
	quest.20CB04DF18E5B32F.title: "Crushing Wheels"
	quest.20D02705D867CD6F.quest_desc: ["Restores Earth-like gravity in an area."]
	quest.20D02705D867CD6F.title: "Gravity Normalizer"
	quest.20EBCEF58B72B488.quest_desc: [
		"Get your hands on a dragon egg."
		""
		"Please do not fry it. Place it down and wait – it hatches into a rideable dragon!"
		""
		"&7Eggs hide in temples, strongholds, fortresses, dungeons, igloos and buried treasure."
	]
	quest.20EBCEF58B72B488.title: "Is This an Omelette?"
	quest.210925D2D66577EB.title: "Four-Leaf Clover"
	quest.21426F5EEC922866.quest_desc: ["Half-submerged in the oceans lie the petrified remains of a colossal beast, its skeletal form stretching farther than the eye can follow. Was it a creature of the deep, dragged ashore in ages past—or did it fall from the heavens themselves? No records remain, only questions carved into stone."]
	quest.21426F5EEC922866.quest_subtitle: "Find a Typhon"
	quest.216793A7F9E4FCE6.quest_desc: ["Atop the Gold Dungeon burns the tyrant of the Aether. Defeat him to take control of the Sun Altar – and of time itself."]
	quest.216793A7F9E4FCE6.quest_subtitle: "Gold Dungeon"
	quest.216793A7F9E4FCE6.title: "The Sun Spirit"
	quest.216F8398629BDB24.quest_desc: [
		"Look at a parrot through a spyglass."
		""
		"Yes. It is a bird."
	]
	quest.216F8398629BDB24.title: "Is It a Bird?"
	quest.2170104C2CC8C13B.quest_desc: ["The processor behind every MEGA cell. The press comes from AE2 meteorites."]
	quest.2170104C2CC8C13B.title: "Accumulation Processor"
	quest.218AFDBCF9418F17.title: "Halberd"
	quest.219A0DC55E358F50.title: "Reactor Casing"
	quest.21C6E50D90759A27.title: "Check the Pressure"
	quest.2207A7BA4F72C1D9.quest_desc: [
		"Get a Chicken Bike."
		""
		"Why did the chicken cross the road? Because it has a motor now."
	]
	quest.2207A7BA4F72C1D9.title: "Chicken Run"
	quest.22082E50C3CDA2AC.title: "Dragon Bone Armor"
	quest.220CCED156281858.quest_desc: ["The Slicer automates Farmer's Delight cutting board recipes."]
	quest.220CCED156281858.title: "Slice and Dice"
	quest.221D60EC8B8EC985.quest_desc: ["Black Quartz ore generates in the Overworld underground."]
