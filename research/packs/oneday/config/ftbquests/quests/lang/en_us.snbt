	quest.77347E1941D87405.title: "Pressure Master"
	quest.779A0934C137150D.quest_desc: ["The keeper of the Ruined Citadel."]
	quest.779A0934C137150D.title: "Ender Guardian"
	quest.779D557EAFB7A0CE.quest_desc: ["The Infusion Pylon allows you to apply potion effects permanently to yourself from anywhere in the world by using a Potion Filter."]
	quest.779D557EAFB7A0CE.title: "Infusion Pylon"
	quest.77A99B1C6D7630E3.quest_desc: [
		"Complete every quest in &eArtifacts and Relics&r to earn the title &bRelic Collector&r."
		""
		"The title is offered automatically. Choose &a[Accept]&r to wear it under your name – or &c[Decline]&r to keep it in your collection for later."
	]
