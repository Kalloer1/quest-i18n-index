	]
	quest.3E8FF745496AF636.title: "World Tiers"
	quest.3ECA226F08D5195F.quest_desc: ["Hidden among hills and valleys, the monastery stands as a quiet refuge in a world of rising danger. Here, villagers tend to simple lives of prayer and work, untouched by Illager conquest. Though the halls hold little in the way of treasure, their sturdy walls and peaceful company make this an ideal sanctuary for weary adventurers."]
	quest.3ECA226F08D5195F.quest_subtitle: "Find a Monastery"
	quest.3ECF359C95BA8004.title: "Tropical Shores"
	quest.3EDA30B9D0544FFC.quest_desc: ["Shoots a laser that converts blocks and items in front of it. Check the manual for all conversions."]
	quest.3EDA30B9D0544FFC.title: "Atomic Reconstructor"
	quest.3EF10B97D9FD1A2E.quest_desc: ["Craft new Glyphs here to expand what your spells can do."]
	quest.3EF10B97D9FD1A2E.title: "Scribe's Table"
	quest.3EF9F9717B1E19E8.quest_desc: ["Not everything has to be serious. Here are the silly, lucky and cute parts of the pack."]
	quest.3EF9F9717B1E19E8.title: "Just for Fun"
	quest.3F2C69919286C5E8.quest_desc: [
		"Defeat a Frostbitten in the frozen lands."
		""
		"Stop. Collaborate and… run."
	]
	quest.3F2C69919286C5E8.title: "Ice Ice Baby"
	quest.3F3674745C46FED9.quest_desc: ["Collect 16 Lucky Blocks. What could possibly go wrong?"]
	quest.3F3674745C46FED9.title: "Gambling Addiction"
	quest.3F565CA0DC4FE3A3.quest_desc: ["Repairs tools and enchants Aether materials using Ambrosium."]
	quest.3F565CA0DC4FE3A3.title: "Enchanting Altar"
	quest.3F57A3A4E6B5DA2B.quest_desc: [
		"Sneak for a total of one hour."
		""
		"Nobody saw you. Everybody saw you."
	]
	quest.3F57A3A4E6B5DA2B.title: "Sneaky Beaky"
	quest.3F60AB4FE7151613.title: "Squeezer"
