	quest.5996D2ED8745D5F6.quest_subtitle: "The metal of progress"
	quest.5996D2ED8745D5F6.title: "Brass"
	quest.599AAF65990CAFD0.quest_desc: [
		"Eat 50 slices of cake."
		""
		"It was a lie in some other game. Here it is very real and very delicious."
	]
	quest.599AAF65990CAFD0.title: "The Cake Is Not a Lie"
	quest.59B60A798631D7AE.title: "Frostbitten"
