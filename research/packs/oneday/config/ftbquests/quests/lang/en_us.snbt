	quest.3B2C0A65FEB535D9.quest_desc: [
		"Tired of mining every single block by hand? &6FTB Ultimine&r has your back!"
		""
		"[\"\",{\"text\":\"• Hold \"},{\"keybind\":\"key.ftbultimine\",\"color\":\"gold\"},{\"text\":\" (the key below ESC) while breaking a block.\"}]"
		"• All connected blocks of the same type break at once – perfect for ore veins and trees."
		"• It works with hoes, axes and shovels too."
		""
		"&cCareful:&r Ultimining costs hunger and tool durability for every block."
	]
	quest.3B2C0A65FEB535D9.title: "Mining Blocks in Record Time"
	quest.3B493891D57C1D39.quest_desc: ["A compact iron farm in one block."]
	quest.3B50D775CE678833.quest_desc: ["&7Where there is Light, there is Darkness. Are you sure youre up to the Challenge?"]
	quest.3B50D775CE678833.quest_subtitle: "Pure Light."
	quest.3B7D37B660B16EFC.quest_desc: ["Mines a 3x3 area at once."]
	quest.3B7E1D3592DCCBD0.quest_desc: ["Combine enchantments, repair gear and rename items."]
	quest.3B84B5EDD76E42CE.quest_desc: [
		"Nitro Crystals, Precision Mechanisms, Antimatter and an AE2 Singularity around an Eclipse Ingot."
		""
		"Title: &dTech Legend"
	]
	quest.3B84B5EDD76E42CE.title: "Tech Core"
	quest.3B87676D899F9B6C.quest_desc: [
		"Die 25 times."
		""
		"The respawn screen now knows you by name."
	]
	quest.3B87676D899F9B6C.title: "Professional Respawner"
	quest.3B9DF96ED1DE3BA5.quest_desc: ["Canola oil can be refined into powerful fuel for the Oil Generator."]
