	quest.198DBBCABC09D91A.quest_desc: ["Carry a familiar spirit with you."]
	quest.19E649DA0EBF40E8.quest_desc: ["8 Diamonds around a Redstone Block. Break it and hope for the best – it could be treasure, a trap or even a boss…"]
	quest.19E649DA0EBF40E8.title: "Feeling Lucky?"
	quest.1A227FC9A1BD5E8B.quest_desc: ["Create: Enchantment Industry turns experience into a fluid. The Blaze Enchanter applies enchantments automatically."]
