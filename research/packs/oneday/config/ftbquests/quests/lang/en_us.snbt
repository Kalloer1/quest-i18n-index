	quest.2B16004978C06C8E.title: "Drygmy"
	quest.2B21952A37C6B9A9.quest_desc: ["&7How much do you have to lose to be new? How much makes you you?"]
	quest.2B21952A37C6B9A9.quest_subtitle: "Once a Noble Weapon, now barely a Relic"
