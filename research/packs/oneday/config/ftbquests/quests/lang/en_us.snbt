	quest.5D97C508FA8F1F26.title: "Rotten Creatures"
	quest.5DB18EB2857AD937.quest_desc: ["Place the Apparatus on an Arcane Core and surround it with Arcane Pedestals. This is Ars Nouveau's advanced crafting altar."]
