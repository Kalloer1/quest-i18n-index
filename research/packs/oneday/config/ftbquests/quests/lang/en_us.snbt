	quest.56D8267953307598.title: "Millstone"
	quest.570DB5EF22240511.quest_desc: ["A rare metal found deep underground."]
	quest.570DB5EF22240511.title: "Necoium"
	quest.573C22EAB7D03F10.title: "Assembly Line"
	quest.5749A372620979B7.title: "Exoversal Alloy"
	quest.575B074A8CC38A77.quest_desc: [
		"&6Waystones&r are scattered across the world – you will often find them in villages."
		""
		"• Right-click a Waystone to activate it."
		"• Once activated, you can travel between all of your Waystones at any time."
		"• Warp Scrolls and the Warp Stone bring you back to a Waystone from anywhere."
		""
		"Here are two Warp Scrolls to get you started."
	]
	quest.575B074A8CC38A77.title: "The Fast Travel Network"
	quest.576793919D8BC5BA.quest_desc: ["Drones can dig, build, farm, fight and carry items – whatever you program them to do."]
	quest.576793919D8BC5BA.title: "Your First Drone"
	quest.57757A30E93E01F8.quest_desc: [
		"You know the way – now make the Otherworld yours. The Terraria chapters in recommended order:"
		""
		"&a🌱 A New Beginning&r – crafting stations and the first bosses"
		"&a🏠 Town NPCs&r – attract new neighbours"
		"&a🗺 Biomes&r – explore every corner"
		"&a⛏ Tools and Weapons&r, &a🛡 Armor Sets&r, &a💍 Accessories&r – gear up"
		"&a🧪 Potions&r – brew everything"
		"&a💀 Hardmode&r and &a✨ The Shimmer&r – the endgame"
	]
	quest.57757A30E93E01F8.title: "The Journey Begins"
	quest.578CE55CB78C44AD.quest_desc: ["Compresses materials with incredible force."]
	quest.57B16891F6022F12.quest_desc: ["A cursed warrior bound in ice."]
	quest.57B16891F6022F12.title: "Maledictus"
	quest.57C61B4B8C1A071B.quest_desc: ["A vesper warped by dark magic into the ultimate monster."]
	quest.57C61B4B8C1A071B.title: "The Forsaken"
	quest.57D3EA9B66B5C418.title: "Alternator"
	quest.583E898E0855159B.quest_desc: [
		"Throw it next to an Offering Table to call the gods."
		""
		"Needs Bottled Sunlight and Bottled Ghosts."
	]
	quest.584C9EE5E7AA1A91.quest_desc: ["A laser that mines blocks from afar – and charges machines."]
	quest.5884A8CF77A77AFC.quest_desc: ["Smithing Table: Ender Gem + Blank Teleporter + Diamond Ore."]
	quest.58863CD36841B0B1.quest_desc: [
		"Complete every quest in &eNature's Aura&r to earn the title &bAura Legend&r."
