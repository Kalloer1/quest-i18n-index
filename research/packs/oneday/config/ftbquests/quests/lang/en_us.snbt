	quest.476AC4242E51E098.title: "Otherworld Traveler"
	quest.4785E7AF967241A5.quest_desc: ["Build your own claw machine and try your luck."]
	quest.4791FC0A2E834D85.quest_desc: ["Dark magics linger in the depths of these dungeons, woven into items, halls, and even the very air. Power awaits the bold, but so do twisted fates for the careless."]
	quest.4791FC0A2E834D85.quest_subtitle: "Find a Bathhouse"
	quest.47EBDA6516061205.quest_desc: [
		"&7In order to make it, combine a &cEmpowered Remnant&r &7with a &6Netherite Ingot&r &7in a Smithing Table."
