	quest.40150F69FF9873D7.quest_desc: ["A legendary pyromancer's echo still burns somewhere in this world. Bring fire resistance."]
	quest.40150F69FF9873D7.quest_subtitle: "First Flamebearer"
	quest.40150F69FF9873D7.title: "Echo of Tyros"
	quest.402B32F26CAE2A1E.title: "Venus"
