	quest.1AB1D1AAF364CFAE.title: "Biome Explorer"
	quest.1ACA01458705876B.quest_desc: ["Place it over a heat source – fire, campfire or stove – to cook soups and stews."]
	quest.1AFAC8D975420E0B.quest_desc: [
		"Play a note block 500 times."
		""
		"Your teammates would like a word."
	]
	quest.1AFAC8D975420E0B.title: "Annoying Neighbour"
	quest.1B0AAB5228013FA5.quest_desc: [
		"Distract a Piglin with gold."
		""
		"Works on some of your friends too."
	]
	quest.1B0AAB5228013FA5.title: "Oh Shiny"
	quest.1B1E0A7CF736BD7F.title: "Ametrine Ingot"
	quest.1B4DEDF05634434D.quest_desc: ["Hull, sail and engine: your first aircraft. Slow, but it flies!"]
	quest.1B9DC6CF4187AC98.quest_desc: ["Prosperity Ore hides in the same places as iron. You need the shards for every seed."]
	quest.1B9DC6CF4187AC98.title: "Prosperity"
	quest.1BA470767958D731.quest_desc: ["Inferium Seeds grow more Inferium Essence. Harvest them when they are fully grown."]
	quest.1BA470767958D731.title: "Your First Seeds"
	quest.1BBA27AFC14A76BF.quest_desc: ["Resource seeds are made on the Infusion Altar: put the seed base on the altar and the ingredients on up to 8 pedestals around it, then activate it with redstone."]
	quest.1BBA27AFC14A76BF.title: "The Infusion Altar"
	quest.1BE3C1A617B591E3.quest_desc: ["Automates the Awakening Altar."]
	quest.1BE3C1A617B591E3.title: "Awakening Altarnator"
	quest.1BF1CC9B89C995AB.quest_desc: ["Finished the Mekanism chapter? These addons add tiers far above Ultimate."]
	quest.1BF1CC9B89C995AB.title: "Beyond Ultimate"
	quest.1C1F3BF4BB45C071.quest_desc: ["Craft this Eye and throw it like an Eye of Ender – it flies towards the &6Ancient Factory&r."]
	quest.1C1F3BF4BB45C071.title: "Find the Ancient Factory"
	quest.1C219C8669A164E0.quest_desc: [
		"Welcome to &6Create&r! Everything here runs on rotational power – shafts, cogs and belts spinning machines to life."
		""
		"It all starts with &eAndesite Alloy&r: Andesite plus Iron (or Zinc) Nuggets."
		""
		"[\"\",{\"text\":\"Hold \"},{\"keybind\":\"key.ponder.ponder\",\"color\":\"gold\"},{\"text\":\" while hovering over any Create item to watch a Ponder scene that shows exactly how it works.\"}]"
	]
	quest.1C219C8669A164E0.quest_subtitle: "Where every contraption begins"
	quest.1C219C8669A164E0.title: "Andesite Alloy"
	quest.1C33DCFADBD4B13F.quest_desc: ["&7Our hearts are monsters. That's why our ribs are cages."]
	quest.1C33DCFADBD4B13F.quest_subtitle: "Do not ever apologize for the madnesss which made you a Warrior."
	quest.1C375606107C117F.quest_subtitle: "Find Keep Kayra"
	quest.1C4CC17CED87CDD4.quest_desc: [
		"OneDay has its own treasure: &6Solarium&r, a piece of the sun, and &bLunarium&r, a piece of the moon."
		""
		"Forged together they become &dEclipse&r – gear that changes its power with the time of day."
		""
		"&6☀ Sun&r = daytime under an open sky."
		"&b☾ Moon&r = night, thunderstorms, the Nether, the End and other dark places."
	]
	quest.1C4CC17CED87CDD4.quest_subtitle: "One day has two halves"
	quest.1C4CC17CED87CDD4.title: "Sun and Moon"
	quest.1C5E5C596D8B2A61.quest_desc: ["Four Supremium Essence around an Infusion Crystal become one &5Insanium Essence&r – the sixth and final tier from &bMystical Agradditions&r."]
	quest.1C5E5C596D8B2A61.title: "Insanium"
	quest.1C6075524C120092.quest_desc: ["&7You can feel Death when wielding this Weapon. No living or dead creature wants to be near you. You can feel that this Weapon craves something. It wants to wake up."]
	quest.1C6075524C120092.quest_subtitle: "A certain feeling of Death."
	quest.1C72A3790353AF97.quest_desc: [
		"Unobtainium, Fiery Ingots, Enchanted Gravitite and Calorite around an Eclipse Ingot."
		""
		"Title: &dExplorer Legend"
	]
	quest.1C72A3790353AF97.title: "Explorer Core"
	quest.1C7CD73C371364CA.quest_desc: ["The Overworld is more dangerous in OneDay. Hunt each new monster once to fill your bestiary."]
	quest.1C7CD73C371364CA.title: "Bestiary"
	quest.1CAFB7A7896A57E6.quest_desc: ["Copy an area and paste it somewhere else."]
	quest.1CBB07C9191383D1.quest_desc: [
		"Three endgame metals: &6Allthemodium&r in the Deep Dark, &dVibranium&r in the Nether and &5Unobtainium&r in the End Highlands."
		""
		"You need a netherite pickaxe (or better) to mine them."
	]
	quest.1CBB07C9191383D1.title: "Allthemodium"
	quest.1CCA31D9352C60E6.quest_desc: ["Clustered around a towering central “grandmother” mushroom, these villages appear quaint from afar. Yet the villagers within are far more aggressive than their old-world counterparts, hiding a cunning fierceness beneath their colorful caps. Approach with caution as this village may welcome the unwary only to spring its traps."]
	quest.1CCA31D9352C60E6.quest_subtitle: "Find a mushroom village"
	quest.1CEF2A38948010A2.quest_desc: ["Out on the open seas, the &6Illagers&r have taken to the waves, commandeering massive galleys and swift corsairs. Their sails cast long shadows, and their cannons roar with fury. Only the bravest dare to board, for fortune favors those who seize it."]
	quest.1CEF2A38948010A2.quest_subtitle: "Find an Illager Corsair or an Illager Galley"
	quest.1D22AA64DC073F04.quest_desc: ["Mage armor raises your max mana and spell power. School sets like Pyromancer, Cryomancer or Electromancer boost one school even further."]
	quest.1D22AA64DC073F04.title: "Wizard's Wardrobe"
	quest.1D2599CA3F1C822B.quest_desc: ["Read values from the world with readers, combine them in the Logic Programmer and act on them with writers."]
	quest.1D2599CA3F1C822B.title: "Logic Networks"
	quest.1D6E9A8F3B71A1B9.quest_desc: ["Trains, steam, robotic arms and giant crafters – you have mastered Create. Now build something ridiculous!"]
	quest.1D6E9A8F3B71A1B9.title: "Master Engineer"
	quest.1D9245F81C0581A8.quest_desc: ["A saddle and some meat make a rideable animal bike. There is one for almost every mob!"]
	quest.1D9245F81C0581A8.title: "Pig on Wheels"
	quest.1D933192E8487DB1.title: "The Saw"
	quest.1D9672B0A8C34A9D.title: "Aquamarine"
	quest.1D9AA6EA5FC60C84.quest_desc: [
		"&6Ad Astra&r adds rockets and a whole solar system: the &7Moon&r, &cMars&r, &6Venus&r, &eMercury&r and the icy planet &bGlacio&r."
		""
		"Each rocket tier reaches further. The metal you find on one world builds the rocket to the next."
	]
	quest.1D9AA6EA5FC60C84.title: "To the Stars"
	quest.1DA91EDDFF464BB2.quest_desc: [
		"Complete every quest in &eTown NPCs&r to earn the title &bTown Mayor&r."
		""
		"The title is offered automatically. Choose &a[Accept]&r to wear it under your name – or &c[Decline]&r to keep it in your collection for later."
	]
