		"The title is offered automatically. Choose &a[Accept]&r to wear it under your name – or &c[Decline]&r to keep it in your collection for later."
	]
	quest.58863CD36841B0B1.quest_subtitle: "Nature's Aura"
	quest.58863CD36841B0B1.title: "Aura Legend"
	quest.58C460A297158B7D.quest_desc: [
		"Sourcelinks create Source from the world around them:"
		""
		"&6Agronomic&r – growing plants"
		"&6Volcanic&r – burning fuel"
		"&6Mycelial&r – food"
		"&6Vitalic&r – animals and mobs"
		"&6Alchemical&r – potions"
	]
	quest.58C460A297158B7D.title: "Generating Source"
	quest.591ADA11628B1564.quest_desc: ["Order items from the Amadron store – delivered by drone."]
	quest.591ADA11628B1564.title: "Online Shopping"
	quest.5925583BAE1454AF.quest_desc: ["A powerful mining tool fueled by diesel."]
	quest.595714C78D8821C1.title: "Zweihänder"
	quest.59575E7725598396.title: "The Immortal"
	quest.596103BEDC507D72.title: "Quantum Processor"
