	quest.0000000000000002.quest_desc: ["Osmium is the backbone of all Mekanism technologies. Mine it and smelt it."]
	quest.0000000000000002.title: "Osmium Ingot"
	quest.0000000000000003.quest_desc: ["Enrich iron with carbon (charcoal/coal) to form the base alloy components."]
	quest.0000000000000003.title: "Enriched Iron"
	quest.0000000000000004.quest_desc: [
		"Infuse Enriched Iron with more carbon to create Steel – a critical structural material."
		""
		"&7All steel in this pack is unified into one type, so any steel counts."
	]
	quest.0000000000000004.title: "Steel Ingot"
	quest.0000000000000005.quest_desc: ["Right-click a block, item or fluid with the Dictionary to see all of its tags – perfect for figuring out what works where."]
	quest.0000000000000005.title: "Mekanism Dictionary"
	quest.0000000000000006.quest_desc: ["The essential multi-tool for configuring cables, pipes, and machine faces."]
	quest.0000000000000006.title: "The Configurator"
	quest.0000000000000007.quest_desc: ["Use this tool to check the status, contents, and throughput of pipes and cables."]
	quest.0000000000000007.title: "Network Reader"
	quest.0000000000000008.quest_desc: ["Place and power the Seismic Vibrator. It scans every block in the column below it."]
	quest.0000000000000008.title: "Seismic Vibrator"
	quest.0000000000000009.quest_desc: ["Right-click an active Seismic Vibrator with the Reader to see exactly which ores are hiding beneath it, layer by layer."]
	quest.0000000000000009.title: "Seismic Reader"
	quest.000000000000000A.quest_desc: ["The baseline electronic component for every single primary Mekanism tier machine."]
	quest.000000000000000A.title: "Basic Control Circuit"
	quest.000000000000000B.quest_desc: ["Generates power from burning solid fuels or heat from adjacent lava blocks."]
	quest.000000000000000B.title: "Heat Generator"
	quest.000000000000000C.quest_desc: ["Harness passive green energy from the sun. Requires a clear view of the sky."]
	quest.000000000000000C.title: "Solar Generator"
	quest.000000000000000D.quest_desc: ["An upgraded array of solar panels packing significantly higher output."]
	quest.000000000000000D.title: "Advanced Solar Generator"
	quest.000000000000000E.quest_desc: ["Generates reliable power based on height placement. Higher means faster output."]
	quest.000000000000000E.title: "Wind Generator"
	quest.000000000000000F.quest_desc: ["Crush plant material into Bio Fuel to feed this eco-friendly combustion machine."]
	quest.000000000000000F.title: "Bio-Generator"
	quest.0000000000000010.quest_desc: ["A portable power bank to store your FE/Joules and charge handheld tools."]
	quest.0000000000000010.title: "Basic Energy Cube"
	quest.0000000000000011.quest_desc: ["Flexible cables that dynamically convert power systems seamlessly between mods."]
	quest.0000000000000011.title: "Basic Universal Cable"
	quest.0000000000000012.quest_desc: ["Transfers thermal energy efficiently between heat-driven structures and machines."]
	quest.0000000000000012.title: "Basic Thermodynamic Conductor"
	quest.0000000000000013.quest_desc: ["A simple storage vessel for specialized gases generated during chemical processing."]
	quest.0000000000000013.title: "Gas Tank"
	quest.0000000000000014.quest_desc: ["Stores and transport buckets of liquids. Can function as a portable bucket dispenser."]
	quest.0000000000000014.title: "Fluid Tank"
	quest.0000000000000015.quest_desc: ["The heart of early Mekanism. Infuse Iron with Carbon, Redstone with Copper and more to create the alloys every machine needs."]
	quest.0000000000000015.title: "Metallurgic Infuser"
	quest.0000000000000016.quest_desc: ["Gives 2x ore dust returns per ore block, or compresses materials for infuser optimization."]
	quest.0000000000000016.title: "Enrichment Chamber"
	quest.0000000000000017.quest_desc: ["An electric furnace that speeds up basic cooking using electrical currents."]
	quest.0000000000000017.title: "Energized Smelter"
	quest.0000000000000019.quest_desc: ["Uses Osmium vapor to compress refined dusts into dense refined glowstone or obsidian."]
	quest.0000000000000019.title: "Osmium Compressor"
	quest.000000000000001C.quest_desc: ["Inject oxygen gas into raw ores to extract 3x ore clumps."]
	quest.000000000000001C.title: "Purification Chamber"
	quest.000000000000001D.quest_desc: ["Crushes items, turning clumps into gravel, or bio-materials into bio-fuel dust."]
	quest.000000000000001D.title: "Crusher"
	quest.000000000000001E.quest_desc: ["Splits clean water into oxygen and hydrogen gases via electric currents."]
	quest.000000000000001E.title: "Electrolytic Separator"
	quest.000000000000001F.quest_desc: ["Uses Hydrogen Chloride gas to step up processing efficiency to 4x ore shards."]
	quest.000000000000001F.title: "Chemical Injection Chamber"
	quest.0000000000000020.quest_desc: ["Combines two distinct chemical gases together to form a brand new chemical output."]
	quest.0000000000000020.title: "Chemical Infuser"
	quest.0000000000000021.quest_desc: ["Transitions compounds smoothly between their liquid forms and gas vapors."]
	quest.0000000000000021.title: "Rotary Condensentrator"
	quest.0000000000000022.quest_desc: ["Converts solid materials and resources into usable gas streams."]
	quest.0000000000000022.title: "Chemical Oxidizer"
	quest.0000000000000023.quest_desc: ["Washes chemical slurries with clean water to prepare them for crystal crystallization."]
	quest.0000000000000023.title: "Chemical Washer"
	quest.0000000000000024.quest_desc: ["Dries out clean mineral slurries back into high-grade physical crystals."]
	quest.0000000000000024.title: "Chemical Crystallizer"
	quest.0000000000000025.quest_desc: ["Dissolves raw ore blocks completely using hydrofluoric acid for 5x yields."]
	quest.0000000000000025.title: "Chemical Dissolution Chamber"
	quest.0000000000000026.quest_desc: ["A massive multiblock controller tower used to evaporate water/brine into lithium."]
	quest.0000000000000026.title: "Thermal Evaporation Plant"
	quest.0000000000000027.quest_desc: ["Tier 2 circuit engineered using Enriched Alloy and a Basic Circuit base."]
	quest.0000000000000027.title: "Advanced Control Circuit"
	quest.0000000000000028.quest_desc: ["Tier 3 circuit engineered using Reinforced Alloy matrices."]
	quest.0000000000000028.title: "Elite Control Circuit"
	quest.0000000000000029.quest_desc: ["The finest standard control circuit crafted with Atomic Alloy components."]
	quest.0000000000000029.title: "Ultimate Control Circuit"
	quest.000000000000002A.quest_desc: ["An item sorting hub designed to route items dynamically using color channels."]
	quest.000000000000002A.title: "Logistical Sorter"
	quest.000000000000002B.quest_desc: ["Standard conveyor tubes that intelligently push items between inventories."]
	quest.000000000000002B.title: "Basic Logistical Transporter"
	quest.000000000000002C.quest_desc: ["High-efficiency pipeline built for fast, clean fluid transport dynamics."]
	quest.000000000000002C.title: "Basic Mechanical Pipe"
	quest.000000000000002D.quest_desc: ["Leakproof distribution lines for all gaseous substances and chemical compounds."]
	quest.000000000000002D.title: "Basic Pressurized Tube"
	quest.000000000000002E.quest_desc: ["The ultimate all-in-one electronic tool. Breaks any block instantly on command."]
	quest.000000000000002E.title: "Atomic Disassembler"
	quest.000000000000002F.quest_desc: ["Breath underwater seamlessly when coupled with an air-filled tank pack."]
	quest.000000000000002F.title: "Scuba Mask"
	quest.0000000000000030.quest_desc: ["Stores oxygen cleanly to supply your scuba gear during deep ocean excursions."]
	quest.0000000000000030.title: "Scuba Tank"
	quest.0000000000000031.quest_desc: ["High-tech boots providing full fall damage elimination and automatic step assistance."]
	quest.0000000000000031.title: "Free Runners"
	quest.0000000000000032.quest_desc: ["Uses stored electrical energy to launch high-velocity arrows precisely."]
	quest.0000000000000032.title: "Electric Bow"
	quest.0000000000000033.quest_desc: ["Mekanism Tools: Heavy hitting sword built with structural Osmium metals."]
	quest.0000000000000033.title: "Osmium Sword"
	quest.0000000000000034.quest_desc: ["Mekanism Tools: Durable alternative mining pickaxe outperforming standard iron."]
	quest.0000000000000034.title: "Osmium Pickaxe"
	quest.0000000000000035.quest_desc: ["Mekanism Tools: Enchantment-attuned defensive armor utilizing blue lapis lazuli."]
	quest.0000000000000035.title: "Lapis Armor Set"
	quest.0000000000000036.quest_desc: ["Combines an axe, pickaxe, and shovel together into one dense, high-tier tool."]
	quest.0000000000000036.title: "Refined Glowstone Paxel"
	quest.0000000000000037.quest_desc: ["Ultra heavy tactical armor set offering blast defensive resistances."]
	quest.0000000000000037.title: "Refined Obsidian Armor"
	quest.0000000000000038.quest_desc: ["Automated teleporter miner that filters and strips exact ores out of the ground safely."]
	quest.0000000000000038.title: "Digital Miner"
	quest.0000000000000039.quest_desc: ["Build custom sized multiblock fluid storage tanks using these robust valves."]
	quest.0000000000000039.title: "Dynamic Tank Valve"
	quest.000000000000003A.quest_desc: ["Structural structural panel used to frame out massive Dynamic Tank structures."]
	quest.000000000000003A.title: "Dynamic Tank Casing"
	quest.000000000000003B.quest_desc: ["Instantly links positions together for limitless, energy-hungry dimension travels."]
	quest.000000000000003B.title: "Teleporter"
	quest.000000000000003C.quest_desc: ["Frames out the physical threshold zone for comfortable step-in point warping."]
	quest.000000000000003C.title: "Teleporter Portal"
	quest.000000000000003D.quest_desc: ["Controls hyper-pressurized steam injection paths inside energy generating turbines."]
	quest.000000000000003D.title: "Industrial Turbine Valve"
	quest.000000000000003E.quest_desc: ["Outer protective skin paneling required to encapsulate Industrial Turbines."]
	quest.000000000000003E.title: "Turbine Casing"
	quest.000000000000003F.quest_desc: ["Central spinning axel rod meant to catch incoming rushing steam payloads."]
	quest.000000000000003F.title: "Turbine Rotor"
	quest.0000000000000040.quest_desc: ["Attaches directly onto the rotor assembly to turn kinetic movement into raw power."]
	quest.0000000000000040.title: "Turbine Blade"
	quest.0000000000000041.quest_desc: ["Boils water rapidly into high-yield power station clean dry steam."]
	quest.0000000000000041.title: "Superheating Element"
	quest.0000000000000042.quest_desc: ["Handles coolant inputs and steam line exhaust vents inside radioactive cores."]
	quest.0000000000000042.title: "Fission Reactor Port"
	quest.0000000000000043.quest_desc: ["Dense shielding block layers containing high-tier nuclear material fission chains."]
	quest.0000000000000043.title: "Fission Reactor Casing"
	quest.0000000000000044.quest_desc: ["Internal vertical fuel cell rods storing processed radioactive fissile fuel charges."]
	quest.0000000000000044.title: "Fission Fuel Assembly"
	quest.0000000000000045.quest_desc: ["Regulates thermal levels inside reactor structures to prevent immediate melt scenarios."]
	quest.0000000000000045.title: "Control Rod Assembly"
	quest.0000000000000046.quest_desc: ["Separates Uranium Hexafluoride into Fissile Fuel and spins Nuclear Waste into Plutonium – the gateway to Polonium and endgame Mekanism."]
	quest.0000000000000046.title: "Isotopic Centrifuge"
	quest.0000000000000047.quest_desc: ["The pinnacle energy matrix setup. Manages sun-like plasma core fusing constraints."]
	quest.0000000000000047.title: "Fusion Reactor Controller"
	quest.0000000000000048.quest_desc: ["High strength housing nodes binding the massive thermonuclear plasma containment loops."]
	quest.0000000000000048.title: "Fusion Reactor Frame"
	quest.0000000000000049.quest_desc: ["Fires highly concentrated light energy beams forward to ignite Fusion cores safely."]
	quest.0000000000000049.title: "Laser"
	quest.000000000000004A.quest_desc: ["Collects and concentrates small multiple laser rays into a singular massive energy pulse."]
	quest.000000000000004A.title: "Laser Amplifier"
	quest.000000000000004B.quest_desc: ["The complete ultimate god-armor piece. Unlocks absolute invulnerability features when fully powered."]
	quest.000000000000004B.title: "MekaSuit Helmet"
	quest.02D16E97B12EEA41.quest_desc: ["&7You will never be able to escape from your heart. So it's better to listen to what it has to say."]
	quest.02D16E97B12EEA41.quest_subtitle: "A burnt Child loves the fire."
	quest.0331AC0315EBB66D.quest_desc: ["Nestled among the trees, this lively tavern is usually a haven for villagers looking to unwind. Yet when the ale flows too freely, even the most peaceful patrons turn aggressive, defending their pub with surprising ferocity. Enter carefully or risk being caught in a drunken brawl."]
	quest.0331AC0315EBB66D.quest_subtitle: "Find a Greenwood Pub"
	quest.0395861176F7F402.quest_desc: ["&7The Blade whispers gratitude towards you. Materializing something that will &4be of great use sooner or later&r&7 to you. Long shall be their suffering. Joyous be their pain."]
	quest.0395861176F7F402.quest_subtitle: "AT FULL POTENTIAL"
	quest.03E7D9E3CD29B32F.quest_desc: ["&7A Promise broken is a stab in the Heart. A Guarantee broken is a stab in the Brain. A Heart broken is a stab in the Soul."]
	quest.03E7D9E3CD29B32F.quest_subtitle: "To not be forgotten, is to not be forgiven."
	quest.041A1C64A8468087.quest_desc: ["Suspended high in the sky, this arrowhead-shaped airship drifts on a massive aft propeller. Boarding is perilous, but those who succeed will witness its strange and fearsome inhabitants riding boar-like beasts, their eyeless faces obscured by ominous cages. Danger and mystery ride with them across the clouds."]
	quest.041A1C64A8468087.quest_subtitle: "Find a Heavenly Rider"
	quest.042EE2F5E9F5CFBF.quest_subtitle: "Uraninite is used to create Reactors that also use uraninite to generate electricity. You need 36 blocks to create a functioning Reactor, the higher tier, the more power generated from Uraninite."
	quest.06B4703BD757BD7B.quest_desc: [
		"The item list on the right side of your inventory is &6EMI&r – your recipe encyclopedia:"
		""
		"• Hover over any item and press &6R&r to see how it is made, or &6U&r to see what it is used for."
		"• Type &6@modname&r in the search bar to filter by mod, e.g. &7@mekanism&r."
		"• Press &6A&r over an item to pin it to your favorites on the left."
		""
		"[\"\",{\"text\":\"Here is a Backpack for the road – open it anywhere with \"},{\"keybind\":\"key.sophisticatedbackpacks.open_backpack\",\"color\":\"gold\"},{\"text\":\". Middle-click inside an inventory to sort it.\"}]"
	]
	quest.06B4703BD757BD7B.title: "EMI and Inventory Helpers"
	quest.07DAFC04179A4DA0.quest_desc: ["&7The more you take, the less you'll have. You will starve surrounded by Gold."]
	quest.07DAFC04179A4DA0.quest_subtitle: "Greed - how insatiable..."
	quest.08AEEA46BD870294.quest_desc: ["&7Let the Land thunder with my Storm!"]
	quest.08AEEA46BD870294.quest_subtitle: "The first River, was a River of Blood."
	quest.0B89EB36AC565461.quest_desc: ["Deep within this subterranean city, the heat of molten lava and the hum of industry dominate the air. The Nether’s influence is strong here, fueling forges and animating Forge Sentinels that patrol every corridor. Only those prepared for fire and steel will survive, and claim the treasures forged within."]
	quest.0B89EB36AC565461.quest_subtitle: "Find a Foundry"
	quest.0C2D472551252C55.quest_desc: ["&7A delicate pair of Eyes, set on this blade, to forever judge the kills you do with it. Who are you to decide about life or death?"]
	quest.0C2D472551252C55.quest_subtitle: "&7They will never stop judging your Actions."
	quest.0CE50A7F4F1A0E4D.quest_desc: ["ladder stretches skyward, disappearing into the clouds. At its top floats a strange, floating vessel. What secrets or dangers await above, none can say… except that the view alone is enough to make even the bravest adventurer’s stomach turn."]
	quest.0CE50A7F4F1A0E4D.quest_subtitle: "Find a Small Blimp"
	quest.0D8A8981385BAF73.quest_desc: ["&7You are mesmerized by the flowing Lava on this Blade. It reminds you of something..."]
	quest.0D8A8981385BAF73.quest_subtitle: "The Prince"
	quest.0D9DFC48E3D2F434.quest_subtitle: "Energy Dischargers drain energy away from charged machinery and store it in an internal storage pocket and can redirect the power into another piece of machinery using cables."
	quest.0E1234567890BCDE.quest_desc: ["The Interdiction Pylon prevents specific mobs from spawning or entering your base perimeter using configurable item filters."]
	quest.0E1234567890BCDE.title: "Interdiction Pylon"
	quest.0E959953F768C259.quest_desc: ["&7Forever Cursed and Blessed to walk two Realms, one might only pity these poor Souls."]
	quest.0E959953F768C259.quest_subtitle: "&7Between two Realms, yet home in none."
	quest.0F426527B63F854D.quest_desc: [
		"&6&lSimply Swords&r &7offers over &a&l15&r &7weapons types for the player to utilize."
		""
		"&7It also has the unique featureset of &b&n&lRunic Powers&r, &7which can be given to weapons via &n&bsockets&r!"
	]
	quest.0F426527B63F854D.quest_subtitle: "One of Many Sockets!"
	quest.1000000000000001.quest_desc: ["Craft a Meteorite Compass and locate your first meteorite."]
	quest.1000000000000001.title: "The Search Begins"
	quest.1000000000000002.quest_desc: ["Find the 4 Inscriber Presses hidden inside the core of a meteorite."]
	quest.1000000000000002.title: "Inscriber Presses"
	quest.1000000000000003.quest_desc: ["Mine Certus Quartz. You can find it buried deep underground."]
	quest.1000000000000003.title: "Certus Quartz"
	quest.1000000000000004.quest_desc: ["Find Charged Certus Quartz. It glows slightly in the dark."]
	quest.1000000000000004.title: "Charged Energy"
	quest.1000000000000006.quest_desc: ["Throw Charged Certus Quartz, Redstone, and Nether Quartz together into water."]
	quest.1000000000000006.title: "Fluix Crystals"
	quest.1000000000000007.quest_desc: ["Grind your crystals into Fluix or Certus Dust."]
	quest.1000000000000007.title: "Crushed Dust"
	quest.1000000000000008.quest_desc: ["Use the Inscriber to press processor components."]
	quest.1000000000000008.title: "The Inscriber"
	quest.1000000000000009.quest_desc: ["Craft a Logic Processor using Gold."]
	quest.1000000000000009.title: "Logic Processor"
	quest.1000000000000010.quest_desc: ["Craft a Calculation Processor using Pure Certus Quartz."]
	quest.1000000000000010.title: "Calculation Processor"
	quest.1000000000000011.quest_desc: ["Craft an Engineering Processor using Diamonds."]
	quest.1000000000000011.title: "Engineering Processor"
	quest.1000000000000012.quest_desc: ["Charge normal Certus Quartz with power."]
	quest.1000000000000012.title: "The Charger"
	quest.1000000000000013.quest_desc: ["Convert external power (RF/FE) into ME Energy."]
	quest.1000000000000013.title: "Energy Acceptor"
	quest.1000000000000014.quest_desc: ["The core of your storage: The ME Drive holds your storage cells."]
	quest.1000000000000014.title: "The ME Drive"
	quest.1000000000000015.quest_desc: ["Look inside your digital network storage."]
	quest.1000000000000015.title: "ME Terminal"
	quest.1000000000000016.quest_desc: ["A terminal with an integrated crafting grid. Essential!"]
	quest.1000000000000016.title: "ME Crafting Terminal"
	quest.1000000000000017.quest_desc: ["Your very first digital storage cell."]
	quest.1000000000000017.title: "1k Storage Cell"
	quest.1000000000000018.quest_desc: ["Provides significantly more space for items."]
	quest.1000000000000018.title: "4k Storage Cell"
	quest.1000000000000019.quest_desc: ["For advanced data and item storage."]
	quest.1000000000000019.title: "16k Storage Cell"
	quest.1000000000000020.quest_desc: ["The largest tier-1 standard storage cell for items."]
	quest.1000000000000020.title: "64k Storage Cell"
	quest.1000000000000021.quest_desc: ["Glass cables transport up to 8 channels."]
	quest.1000000000000021.title: "Cable Connections"
	quest.1000000000000022.quest_desc: ["Smart Cables visually show you how many channels are in use."]
	quest.1000000000000022.title: "Smart Network Overview"
	quest.1000000000000023.quest_desc: ["Dense Cables can transport a massive amount of 32 channels."]
	quest.1000000000000023.title: "The Data Highway"
	quest.1000000000000024.quest_desc: ["The brain of the network. Allows routing for hundreds of channels."]
	quest.1000000000000024.title: "The ME Controller"
	quest.1000000000000025.quest_desc: ["Compress cable channels to tunnel them over long distances."]
	quest.1000000000000025.title: "P2P Tunnel"
	quest.1000000000000026.quest_desc: ["Patterns store recipes for autocrafting."]
	quest.1000000000000026.title: "The Code of Crafting"
	quest.1000000000000027.quest_desc: ["Automatically assembles items based on pattern templates."]
	quest.1000000000000027.title: "Molecular Assembler"
	quest.1000000000000028.quest_desc: ["The interface between your network and external machinery."]
	quest.1000000000000028.title: "ME Interface"
	quest.1000000000000029.quest_desc: ["Base block for your co-processors and crafting storage blocks."]
	quest.1000000000000029.title: "Crafting Unit"
	quest.1000000000000030.quest_desc: ["Access your ME system wirelessly from anywhere in your base area."]
	quest.1000000000000030.title: "Wireless Freedom"
	quest.1000000000000032.quest_desc: ["Your very first storage cell for liquid resources."]
	quest.1000000000000032.title: "1k Fluid Cell"
	quest.1000000000000033.quest_desc: ["Expanded storage space for fluid mediums."]
	quest.1000000000000033.title: "4k Fluid Cell"
