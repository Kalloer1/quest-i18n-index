	quest.5DCDDAD3CB75D25D.quest_desc: [
		"Get a Cow Bike."
		""
		"Moo-ving at incredible speed."
	]
	quest.5DCDDAD3CB75D25D.title: "Holy Cow, It Has Wheels"
	quest.5E310F7F168CBA8C.quest_desc: ["Craft a piece of any school-specific armor. Pyromancer is shown here, but any school counts as progress in your journey."]
	quest.5E310F7F168CBA8C.title: "Pick a School"
	quest.5E418A209B285E18.quest_desc: [
		"Complete every quest in &eIron's Spells 'n Spellbooks&r to earn the title &bSpellbook Legend&r."
		""
		"The title is offered automatically. Choose &a[Accept]&r to wear it under your name – or &c[Decline]&r to keep it in your collection for later."
	]
