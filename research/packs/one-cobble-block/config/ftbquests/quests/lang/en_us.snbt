	file.0000000000000001.title: "One Cobble Block"
	quest.00833E17B2495105.quest_desc: ["Unlocked when your island reaches phase 1."]
	quest.00833E17B2495105.title: "Phase 1"
	quest.009B588D51418EAA.quest_desc: ["A display link shows what your machines are doing on a display board."]
	quest.009B588D51418EAA.title: "Display Boards"
	quest.00DE1D6FB29BAA97.quest_desc: ["Unlocked when your island reaches phase 4."]
	quest.00DE1D6FB29BAA97.title: "Phase 4"
	quest.01C0AFBB8218F17D.quest_desc: ["The reverse of the alternator: energy back into rotation, wherever you need it."]
	quest.01C0AFBB8218F17D.title: "Electric Motor"
	quest.0209FB5FE60DE5BE.quest_desc: ["Catch 500 Pokémon. The block keeps giving rare ones in the post-game."]
	quest.0209FB5FE60DE5BE.title: "Collector"
	quest.045A675DED1F5FFF.quest_desc: ["Shaded rocks and a fallen meteorite in the red canyons. Dark-type Pokémon hide in their shadow."]
	quest.045A675DED1F5FFF.title: "Habitat: Badlands"
	quest.049B97F1336E5A6D.quest_desc: ["Catch 10 Fire-type Pokémon."]
	quest.049B97F1336E5A6D.title: "Fire Specialist"
	quest.0515FB29D361A2C1.quest_desc: ["Unlocked when your island reaches phase 3."]
	quest.0515FB29D361A2C1.title: "Phase 3"
	quest.05FA3D258BAC2D91.quest_desc: ["Every legendary and mythical Pokémon of the block is yours."]
	quest.05FA3D258BAC2D91.title: "Living Legend"
	quest.061F97333F4BA685.quest_desc: ["Navas ZA Megas adds the Mega Stones of Legends Z-A. Some are crafted from a Mega Stone, a diamond and rare materials (Zeraorite, Heatranite, Darkranite, Magearnite, Tatsugirinite, Zygardite): check JEI."]
	quest.061F97333F4BA685.title: "Z-A Mega Stone"
	quest.076C9F4C3F3DE130.quest_desc: ["A mythical Psychic-type Pokémon. Catch it when it comes out of the block, then put it in your party."]
	quest.076C9F4C3F3DE130.title: "Mew"
	quest.07C1E084F9B92033.quest_desc: ["Break blocks to grow this tree (ores count 5 times as much). At the top, a final choice: Fortune of the Block, or Heart of the Block, which sometimes turns the island block into a chest."]
	quest.07C1E084F9B92033.title: "Block Miner"
	quest.080BBB719CDF9CF8.quest_desc: ["A legendary Psychic/Grass-type Pokémon. Catch it when it comes out of the block, then put it in your party."]
	quest.080BBB719CDF9CF8.title: "Calyrex"
	quest.08240607E713F8B6.quest_desc: ["Your iron runs by itself? Call Silvère with /trigger cf.boss. Victory opens phase 2: zinc, brass and the Nether."]
	quest.08240607E713F8B6.title: "Silvère, Master of Steel"
	quest.08C5D3BE58E39047.quest_desc: ["The strongest trainer of One Cobble Block. Beat her to reach the main ending — and the post-game."]
	quest.08C5D3BE58E39047.title: "Célestine, the Champion"
	quest.0954319FE07D3C14.quest_desc: ["A factory processes several items at once. Upgrade a machine with a tier installer, or craft one."]
	quest.0954319FE07D3C14.title: "Factories"
	quest.098679EA94A343BE.quest_desc: ["Place it on a stove or a campfire: soups and stews feed you much longer."]
	quest.098679EA94A343BE.title: "Cooking Pot"
	quest.09B5085443F9AC68.quest_desc: ["The League comes one member at a time: /trigger cf.boss calls the next one you have not beaten yet. Morgane opens with Ghost-type Pokémon."]
	quest.09B5085443F9AC68.title: "Elite Four: Morgane"
	quest.09FA53FE86B8ECDE.quest_desc: ["Sophisticated Backpacks: a portable chest that can be upgraded."]
	quest.09FA53FE86B8ECDE.title: "Backpack"
	quest.0B205FEFDFC6A622.quest_desc: ["Unlocked when your island reaches phase 1."]
	quest.0B205FEFDFC6A622.title: "Phase 1"
	quest.0B55677ACC936E45.quest_desc: ["A zen garden or thermal crevices: rare jungle habitats where Psychic-type Pokémon meditate."]
	quest.0B55677ACC936E45.title: "Habitat: Jungle Temples"
	quest.0B9ED6571D53BB65.quest_desc: ["A legendary Psychic-type Pokémon. Catch it when it comes out of the block, then put it in your party."]
	quest.0B9ED6571D53BB65.title: "Necrozma"
	quest.0BE7F8B32E3E1562.quest_desc: ["Connect your machines to the network: items go in and out by themselves."]
	quest.0BE7F8B32E3E1562.title: "Importers and Exporters"
	quest.0BF52336C9F84089.quest_desc: ["Create: Interiors chairs and cushions, even on moving contraptions."]
	quest.0BF52336C9F84089.title: "Take a Seat"
	quest.0CA2D051A3CD0B5B.quest_desc: ["Craft an Empty Blaze Burner (netherrack and iron sheets) and use it on a Blaze to capture it."]
	quest.0CA2D051A3CD0B5B.title: "Blaze Burner"
	quest.0D2003D44FCBB3E9.quest_desc: ["Level up a Pokémon or use an evolution stone on it."]
	quest.0D2003D44FCBB3E9.title: "Evolution"
	quest.0DE3E1490EECE64D.quest_desc: ["Chain it all: extruder, millstone, washing, smelting, plus your pasture. Collect a full stack of iron ingots."]
	quest.0DE3E1490EECE64D.title: "Automated Iron"
	quest.0E7CF6A16F51E9E8.quest_desc: ["Leather from cows, string and a chest: a Sophisticated Backpack triples your pockets."]
	quest.0E7CF6A16F51E9E8.title: "Backpack"
	quest.0EFA92F2C7A8D378.quest_desc: ["Catch 10 Ground-type Pokémon."]
	quest.0EFA92F2C7A8D378.title: "Ground Specialist"
	quest.0FBF289A1FD2424C.quest_desc: ["Create Deco: catwalks, bars and metal sheets for your factory."]
	quest.0FBF289A1FD2424C.title: "Industrial Style"
	quest.10227DB5DE513390.quest_desc: ["Catch 10 Electric-type Pokémon."]
	quest.10227DB5DE513390.title: "Electric Specialist"
	quest.10559B2EA3C4665C.quest_desc: ["Create Aeronautics lets you build flying machines: the best way to reach faraway habitats."]
	quest.10559B2EA3C4665C.title: "Take Flight"
	quest.10AEF76F4DCF43FF.quest_desc: ["One chance in a few thousand. Good luck."]
	quest.10AEF76F4DCF43FF.title: "Shiny!"
	quest.1140CBB6F4B46952.quest_desc: ["Collect 10 obsidian from the block with your diamond pickaxe and build a portal (4 wide, 5 high, corners optional). Light it with flint and steel: flint comes from gravel. Brass needs heat, and heat means Blazes: look for a Nether Fortress."]
	quest.1140CBB6F4B46952.title: "Into the Nether"
	quest.118096C8FCA3A2C7.quest_desc: ["Andesite and iron nuggets make Andesite Alloy, the base of every Create machine."]
	quest.118096C8FCA3A2C7.title: "Andesite Alloy"
	quest.11AED57E63681B35.quest_desc: ["Next to a pasture, it collects extra resources from the Pokémon inside. Iron, gold and diamond versions."]
	quest.11AED57E63681B35.title: "Pasture Extractor"
	quest.11BC27BEF72B2822.quest_desc: ["Challenge Aldric with /trigger cf.boss. Victory opens phase 4: the habitats, the Pokédex and the League."]
	quest.11BC27BEF72B2822.title: "Aldric, Master of Dragons"
	quest.12CEF6D0015D619D.quest_desc: ["Send rotation in every direction."]
	quest.12CEF6D0015D619D.title: "Gearbox"
	quest.12D687E7CD2DB6D7.quest_desc: ["Show off your favorite items and Poké Balls."]
	quest.12D687E7CD2DB6D7.title: "Display Case"
	quest.12DA9D11433D3FB6.quest_desc: ["A mythical Psychic/Ghost-type Pokémon. Catch it when it comes out of the block, then put it in your party. The Prison Bottle unbinds its true power."]
	quest.12DA9D11433D3FB6.title: "Hoopa"
	quest.141A49BCFA3B8B74.quest_desc: ["A single-slot surface for machines to work on."]
	quest.141A49BCFA3B8B74.title: "Depot"
	quest.1464DC24D6B6A1E4.quest_desc: ["Catch 10 Pokémon."]
	quest.1464DC24D6B6A1E4.title: "Collector I"
	quest.1474F23ADA1D7F05.quest_desc: ["A paradox Water/Dragon-type Pokémon. Catch it when it comes out of the block, then put it in your party."]
	quest.1474F23ADA1D7F05.title: "Walking Wake"
	quest.15A49ED82221C27B.quest_desc: ["Craft and smelt to grow this tree: reach, armor and efficiency for your factories."]
	quest.15A49ED82221C27B.title: "Engineer"
	quest.161445A95FB790D6.quest_desc: ["Catch 1000 Pokémon."]
	quest.161445A95FB790D6.title: "1000 Pokémon"
	quest.163392E0968EABB3.quest_desc: ["A clean heat source for your pots and skillets."]
	quest.163392E0968EABB3.title: "Stove"
	quest.1753BAB391231A58.quest_desc: ["The Mechanical Extruder generates cobblestone automatically, like a cobblestone generator: it needs water on one side and lava on the other. Lava is rare before the Nether, so here is a bucket: the extruder does not use it up."]
	quest.1753BAB391231A58.title: "Mechanical Extruder"
	quest.175643098FD042E3.quest_desc: ["Catch 50 Pokémon."]
	quest.175643098FD042E3.title: "50 Pokémon"
	quest.17D453762A60A080.quest_desc: ["Cobblemon Industries: mix dye into colored fluid, then fill Apricorns with it to change their color."]
	quest.17D453762A60A080.title: "Apricorn Dyes"
	quest.18023B37CFAC472A.quest_desc: ["Processing Chamber: give it energy and a berry, an Apricorn or a plant, and it slowly grows copies."]
	quest.18023B37CFAC472A.title: "Resource Processor"
	quest.1824994AA5553A72.quest_desc: ["Once this phase's required quests are done, call your Rival with /trigger cf.boss. Beat him to reach phase 1: the block gets new resources and the level cap goes up."]
	quest.1824994AA5553A72.title: "Tung, the Rival"
	quest.18306895E4FE26E3.quest_desc: ["Catch 10 Pokémon."]
	quest.18306895E4FE26E3.title: "10 Pokémon"
	quest.18C4AD61634D4CF5.quest_desc: ["Aldric's dragons are level 66 to 70 with perfect IVs. Your cap is now 70, the level of his strongest."]
	quest.18C4AD61634D4CF5.title: "Ready for Aldric"
	quest.18FC6DF9CFEFA279.quest_desc: ["The Dynamax Band makes your Pokémon gigantic for three turns. It needs a Wishing Star, found in the Wishing Wealds of dark, spooky forests: a long flight away."]
	quest.18FC6DF9CFEFA279.title: "Dynamax"
	quest.19009C4C38151016.quest_desc: ["More items per slot."]
	quest.19009C4C38151016.title: "Stack Upgrade"
	quest.19F10D59DCBF1AA0.quest_desc: ["A legendary Fairy-type Pokémon. Catch it when it comes out of the block, then put it in your party."]
	quest.19F10D59DCBF1AA0.title: "Xerneas"
	quest.1A431B886F699CD4.quest_desc: ["Links all your Sophisticated chests and barrels into one inventory."]
	quest.1A431B886F699CD4.title: "Storage Controller"
	quest.1A511DE24303BD72.quest_desc: ["It infuses carbon, redstone or diamond into metals: steel, then alloys and circuits. Power it with your alternators."]
	quest.1A511DE24303BD72.title: "Metallurgic Infuser"
	quest.1A760F58BAC41BD4.quest_desc: ["Two crushing wheels facing each other: ore doubling, Create style."]
	quest.1A760F58BAC41BD4.title: "Crushing Wheels"
	quest.1ACB2270475660B8.quest_desc: ["The FishingNav tells you which Pokémon bite in the water in front of you. Prismarine, redstone, an Electirizer, a Water Gem and an Up-Grade."]
	quest.1ACB2270475660B8.title: "FishingNav"
	quest.1AF01AE259E98AA8.quest_desc: ["A legendary Poison/Dragon-type Pokémon. Catch it when it comes out of the block, then put it in your party."]
	quest.1AF01AE259E98AA8.title: "Eternatus"
	quest.1AF9D599B1A1865F.quest_desc: ["Cuts trees and turns logs into planks and stripped logs."]
	quest.1AF9D599B1A1865F.title: "Mechanical Saw"
	quest.1BC43C6A28F3F951.quest_desc: ["Catch 10 Poison-type Pokémon."]
	quest.1BC43C6A28F3F951.title: "Poison Specialist"
	quest.1C6AD09FC3E78757.quest_desc: ["Turn logs into planks, then craft a crafting table. Hover an item and press R in JEI to see its recipes."]
	quest.1C6AD09FC3E78757.title: "Workbench"
	quest.1D411B9AC22326CC.quest_desc: ["The Elite Four are level 80 to 89, the Champion up to 100. Your cap follows your next opponent: 83 against Morgane, up to 100 against the Champion."]
	quest.1D411B9AC22326CC.title: "Ready for the League"
	quest.1E2BDE05D72633B8.quest_desc: ["Store your Pokémon in a PC: you will need it for pastures."]
	quest.1E2BDE05D72633B8.title: "Pokémon PC"
	quest.1E56957B761A336A.quest_desc: ["Iron ball bases and colored lids: another way to assemble Poké Balls with Create."]
	quest.1E56957B761A336A.title: "Cobblemon Manufactory"
	quest.1EA331D9BC3E11EA.quest_desc: ["Pipez item pipes carry pasture drops straight to your storage."]
	quest.1EA331D9BC3E11EA.title: "Collect Everything"
	quest.1EFF3011FC595E8F.quest_desc: ["Weaken a wild Pokémon, then throw a Poké Ball at it. Some Pokémon come straight out of the block!"]
	quest.1EFF3011FC595E8F.title: "Gotcha!"
	quest.1F88202E12FEEFFA.quest_desc: ["The Enrichment Chamber turns one ore into two dusts."]
	quest.1F88202E12FEEFFA.title: "Ores ×2"
	quest.1F8A2259B4CAF74D.quest_desc: ["Catch 300 Pokémon."]
	quest.1F8A2259B4CAF74D.title: "300 Pokémon"
	quest.207242651A4D9A04.quest_desc: ["A legendary Electric/Flying-type Pokémon. Catch it when it comes out of the block, then put it in your party. The Reveal Glass switches the forces of nature between their two forms."]
	quest.207242651A4D9A04.title: "Thundurus"
	quest.2092D9D5951E48E9.quest_desc: ["Create: Copycats+ blocks take the look of any block you apply."]
	quest.2092D9D5951E48E9.title: "Copycats"
	quest.212F62B2B189010F.quest_desc: ["A legendary Dragon/Ice-type Pokémon. Catch it when it comes out of the block, then put it in your party."]
	quest.212F62B2B189010F.title: "Kyurem"
	quest.2162493166A640E3.quest_desc: ["Zinc ore now comes out of the block. With copper, it makes brass."]
	quest.2162493166A640E3.title: "Zinc"
	quest.21CE547CA42F865C.quest_desc: ["Lush canopies and hidden cenotes deep in the jungle."]
	quest.21CE547CA42F865C.title: "Habitat: Jungle"
	quest.2236FA032811B296.quest_desc: ["Lugia's temple sits above the deep ocean biomes. Its key opens the way to the guardian of the seas."]
	quest.2236FA032811B296.title: "Lugia's Key"
	quest.229BDD3836D0BCD4.quest_desc: ["A Create slicer uses knives for you: automated cutting board recipes."]
	quest.229BDD3836D0BCD4.title: "Slice \\& Dice"
	quest.22A5ECF3172E368F.quest_desc: ["Fly or build your way to a legendary monument: the Spear Pillar, the Lake of Valor, Lugia's temple, the Tree of Life… They are at least a few hundred blocks away from any other one."]
	quest.22A5ECF3172E368F.title: "A Monument in the Sky"
	quest.22EF4C4C43E6DEF3.quest_desc: ["Waters (or fertilizes) the crops around it."]
	quest.22EF4C4C43E6DEF3.title: "Sprinkler"
	quest.24D12D2726D7EB70.quest_desc: ["A buzzing mound in the savanna."]
	quest.24D12D2726D7EB70.title: "Habitat: Bug Mound"
	quest.26F4BA28AB7293E8.quest_desc: ["A legendary Electric-type Pokémon. Catch it when it comes out of the block, then put it in your party."]
	quest.26F4BA28AB7293E8.title: "Regieleki"
	quest.270663EA49DDC090.quest_desc: ["Storage Drawers: thousands of a single item, visible at a glance."]
	quest.270663EA49DDC090.title: "Drawers"
	quest.284CCBAB98D7C2B2.quest_desc: ["Evolve 50 Pokémon."]
	quest.284CCBAB98D7C2B2.title: "Evolution Expert"
	quest.286F50B2C4C93187.quest_desc: ["A rare rock spire in the mountains that attracts storms, and Electric-type Pokémon."]
	quest.286F50B2C4C93187.title: "Habitat: Natural Lightning Rod"
	quest.29669F16DFBE0EE9.quest_desc: ["Unlocked when your island reaches phase 5."]
	quest.29669F16DFBE0EE9.title: "Phase 5"
	quest.2A005B85145356FD.quest_desc: ["Catch 50 Pokémon."]
	quest.2A005B85145356FD.title: "Collector III"
	quest.2A02981EC557A44E.quest_desc: ["Items, fluids, energy and gases in a single pipe."]
	quest.2A02981EC557A44E.title: "Universal Pipe"
	quest.2A49821AA0EC01FC.quest_desc: ["A legendary Steel-type Pokémon. Catch it when it comes out of the block, then put it in your party."]
	quest.2A49821AA0EC01FC.title: "Registeel"
	quest.2AA13A005DC4918D.quest_desc: ["Create: Cobblemon Integrations. Compact red Apricorns into a sheet and press it into a top. Cut a copper sheet with a saw and press the blank into a bottom."]
	quest.2AA13A005DC4918D.title: "Poké Ball Parts"
	quest.2AC067CCD96EE555.quest_desc: ["Craft the Holo Battle Tower (a Healing Machine, a Monitor and a PC) and place it on your island. Use it to start a run: trainers get stronger at every floor."]
	quest.2AC067CCD96EE555.title: "Battle Tower"
	quest.2B54D055ED5CEEB9.quest_desc: ["A legendary Dragon/Flying-type Pokémon. Catch it when it comes out of the block, then put it in your party."]
	quest.2B54D055ED5CEEB9.title: "Rayquaza"
	quest.2B9D01D0884294CE.quest_desc: ["Sequenced assembly on golden sheets: your first real production line. Gold now comes out of the block."]
	quest.2B9D01D0884294CE.title: "Precision Mechanism"
	quest.2BBA1798A816C9E3.quest_desc: ["Craft your PokéNav with a dye to change its colour."]
	quest.2BBA1798A816C9E3.title: "Your Colour"
	quest.2C3E4802DEA211C4.quest_desc: ["CobbleFurnies: Poké Ball chairs, desks, lamps and Poké wool."]
	quest.2C3E4802DEA211C4.title: "Pokémon Furniture"
	quest.2CD0ED3336A81B8D.quest_desc: ["Catch 10 Steel-type Pokémon."]
	quest.2CD0ED3336A81B8D.title: "Steel Specialist"
	quest.2D266F298A95D46F.quest_desc: ["Chairs, tables, shelves and more."]
	quest.2D266F298A95D46F.title: "Another Furniture"
	quest.2ED6468D28211B53.quest_desc: ["Mega Showdown: a Mega Bracelet and the right Mega Stone unlock a new form in battle. Key Stone ore hides in the floating meteorites (Megaroids) scattered over the void; Mega Stones grow in the Mega Sites."]
	quest.2ED6468D28211B53.title: "Mega Evolution"
	quest.2EF97253851B405D.quest_desc: ["In the Nether or the End, it mines everything around it, filtered."]
	quest.2EF97253851B405D.title: "Digital Miner"
	quest.2F27FACDCA09CDFC.quest_desc: ["Chemical Dissolution Chamber, Washer and Crystallizer: the full Mekanism chain, five ingots per ore."]
	quest.2F27FACDCA09CDFC.title: "Ores ×5"
	quest.2F44EE79763A3B2C.quest_desc: ["The ultimate challenge for your factory: automate the whole line (shulker shells from the End cities, Netherite, Nether Stars for some recipes) and produce 16 Master Balls."]
	quest.2F44EE79763A3B2C.title: "Master Ball Factory"
	quest.2F734F056D77F526.quest_desc: ["Catch 10 Bug-type Pokémon."]
	quest.2F734F056D77F526.title: "Bug Specialist"
	quest.2FEC6D6CD0BD79CA.quest_desc: ["Only on the rare mushroom islands. Poison-type Pokémon thrive among the giant mushrooms."]
	quest.2FEC6D6CD0BD79CA.title: "Habitat: Fungal Dwelling"
	quest.30DF4D5556D0CD69.quest_desc: ["Storage Drawers: drawers hold lots of a single item. A controller links them all."]
	quest.30DF4D5556D0CD69.title: "Organized!"
	quest.315FB1BD6A4DBFDE.quest_desc: ["Place a Poké Snack to attract wild Pokémon around it."]
	quest.315FB1BD6A4DBFDE.title: "Poké Snack"
	quest.3172D37A0A8F2489.quest_desc: ["Jars, sacks, globes and lots of small useful blocks."]
	quest.3172D37A0A8F2489.title: "Supplementaries"
	quest.3174DBC150249080.quest_desc: ["Generators (heat, solar, wind…) and an Energy Cube to store what they produce."]
	quest.3174DBC150249080.title: "Mekanism Power"
	quest.318A03BA5EFDE940.quest_desc: ["Items you pick up go straight into the backpack."]
	quest.318A03BA5EFDE940.title: "Pickup Upgrade"
	quest.32EEEBEE983B0DD8.quest_desc: ["Burnt patches of oak, birch or spruce forest, where Fire-type Pokémon gather."]
	quest.32EEEBEE983B0DD8.title: "Habitat: Wildfire Scars"
	quest.32FEE83095F08EC1.quest_desc: ["Catch 25 Pokémon."]
	quest.32FEE83095F08EC1.title: "Collector II"
	quest.33060962A92382B8.quest_desc: ["Twice as fast, with room for three upgrade cards."]
	quest.33060962A92382B8.title: "Advanced Processor"
	quest.3319C94CE2684C44.quest_desc: ["Catch, defeat and evolve Pokémon to grow this tree. Its last skill, Call of the Wild, sometimes makes an extra wild Pokémon come out of the block."]
	quest.3319C94CE2684C44.title: "Trainer"
	quest.33D69322325C1B9A.quest_desc: ["Defeat 500 wild Pokémon."]
	quest.33D69322325C1B9A.title: "Veteran"
	quest.33F9DEE3E7BE0C7C.quest_desc: ["A legendary Rock-type Pokémon. Catch it when it comes out of the block, then put it in your party."]
	quest.33F9DEE3E7BE0C7C.title: "Regirock"
	quest.347AFFE5C6383816.quest_desc: ["Cut food on a cutting board."]
	quest.347AFFE5C6383816.title: "Knife"
	quest.35318D85DBDBF88B.quest_desc: ["Rotate Create blocks, or pick them up instantly with sneak + right-click."]
	quest.35318D85DBDBF88B.title: "Wrench"
	quest.35C139102FB99314.quest_desc: ["Move items in and out of inventories, belts and depots."]
	quest.35C139102FB99314.title: "Funnels and Chutes"
	quest.35E7FB9BFAB4A8C0.quest_desc: ["Shapeless recipes, alloys and fluids, automated."]
	quest.35E7FB9BFAB4A8C0.title: "Mixer and Basin"
	quest.36184736A4BD5EAE.quest_desc: ["Copper ore sometimes comes out of the block. Smelt it in a furnace: every Poké Ball needs copper."]
	quest.36184736A4BD5EAE.title: "Copper"
	quest.362845899777FBF7.quest_desc: ["Upgrade it with iron for more slots, then gold, diamond and netherite."]
	quest.362845899777FBF7.title: "Bigger Backpack"
	quest.3642B2215B01D4F9.quest_desc: ["Catch 10 Dragon-type Pokémon."]
	quest.3642B2215B01D4F9.title: "Dragon Specialist"
	quest.367F290F42149220.quest_desc: ["Radical Cobblemon Trainers: your Trainer Card shows your level cap and the trainers you have beaten."]
	quest.367F290F42149220.title: "Trainer Card"
	quest.376D5ECE77BE3144.quest_desc: ["A legendary Fighting-type Pokémon. Catch it when it comes out of the block, then put it in your party. Read one of the two scrolls to evolve it into Urshifu."]
	quest.376D5ECE77BE3144.title: "Kubfu"
	quest.3A4214C38A2D63C7.quest_desc: ["A robot arm that uses items on whatever is in front of it. It will assemble your Poké Balls."]
	quest.3A4214C38A2D63C7.title: "Deployer"
	quest.3AC8E7895C5D5787.quest_desc: ["The Mechanical Press costs a whole iron block. It is worth it: it turns ingots into sheets."]
	quest.3AC8E7895C5D5787.title: "The Big Investment"
	quest.3AE607C1878E11D1.quest_desc: ["A legendary Flying-type Pokémon. Catch it when it comes out of the block, then put it in your party. The Reveal Glass switches the forces of nature between their two forms."]
	quest.3AE607C1878E11D1.title: "Tornadus"
	quest.3B36200DED86C029.quest_desc: ["Catch 10 Fighting-type Pokémon."]
	quest.3B36200DED86C029.title: "Fighting Specialist"
	quest.3C31ED426453338D.quest_desc: ["Create machines run on rotation. A water wheel in flowing water is the easiest source; a windmill works too."]
	quest.3C31ED426453338D.title: "Rotational Power"
	quest.3C3F09C1F3782CF8.quest_desc: ["A Poison-type Ultra Beast. Catch it when it comes out of the block, then put it in your party."]
	quest.3C3F09C1F3782CF8.title: "Poipole"
	quest.3CE82BDE6E6833BF.quest_desc: ["There is no stronghold in the void, so no End portal to find. Gather 12 Eyes of Ender (Ender Pearls and Blaze Powder, or the block's chests) and you will receive the 12 frames of a portal. Place them in a ring facing inward, like in a stronghold, then add the eyes."]
	quest.3CE82BDE6E6833BF.title: "Portal to the End"
	quest.3D63AAE6FD99EBB4.quest_desc: ["Unlocked when your island reaches phase 5."]
	quest.3D63AAE6FD99EBB4.title: "Phase 5"
	quest.3DC669AC38FA676D.quest_desc: ["Nuggets, ingots and blocks convert automatically."]
	quest.3DC669AC38FA676D.title: "Compacting Drawer"
	quest.3E059A0AF3C99C9F.quest_desc: ["A paradox Grass/Psychic-type Pokémon. Catch it when it comes out of the block, then put it in your party."]
	quest.3E059A0AF3C99C9F.title: "Iron Leaves"
	quest.3E13CE882E876E3A.quest_desc: ["On a moving contraption, it harvests crops without breaking them."]
	quest.3E13CE882E876E3A.title: "Harvester"
	quest.3EFF4611FAD94615.quest_desc: ["Refined Storage (phase 3): your whole network in your pocket."]
	quest.3EFF4611FAD94615.title: "Wireless Grid"
	quest.3F452D140A574530.quest_desc: ["A drill next to the OneBlock breaks it for you: the first step to automating the block itself!"]
	quest.3F452D140A574530.title: "Mechanical Drill"
	quest.40754A1FB10CDF53.quest_desc: ["Oases, shaded rocks and sun-scorched clearings in sandy biomes. Ground-type Pokémon love them."]
	quest.40754A1FB10CDF53.title: "Habitat: Deserts"
	quest.4080D462CC771DED.quest_desc: ["Osmium, tin, lead, uranium and fluorite ores now come out of the block. Osmium is the metal of Mekanism."]
	quest.4080D462CC771DED.title: "Osmium"
	quest.40EC9B458B62FB65.quest_desc: ["Upgraded Cobblemon campfire pots cook faster, from copper to netherite."]
	quest.40EC9B458B62FB65.title: "Better Campfire Pot"
	quest.41A721E548DD0014.quest_desc: ["A legendary Dark/Fire-type Pokémon. Catch it when it comes out of the block, then put it in your party."]
	quest.41A721E548DD0014.title: "Chi-Yu"
	quest.4208AA462F46AE63.quest_desc: ["The PokéNav lists the Pokémon that can spawn where you stand, and tracks the one you pick. Copper, iron, a diamond, an Electirizer and an Up-Grade."]
	quest.4208AA462F46AE63.title: "PokéNav"
	quest.4231C275FD776216.quest_desc: ["Silvère fights with Steel and Rock Pokémon. Catch a few of your own."]
	quest.4231C275FD776216.title: "Steel Crew"
	quest.4263BEE97838ED33.quest_desc: ["Cabbage and tomato seeds, onions, rice, Hearty Grains and Vivichoke seeds hide in the block's chests from phase 1."]
	quest.4263BEE97838ED33.title: "New Crops"
	quest.42820B2D001B3121.quest_desc: ["Small and large cogwheels change the speed of rotation."]
	quest.42820B2D001B3121.title: "Gears"
	quest.42B341AE019A554A.quest_desc: ["Wash gravel with a fan blowing through water: it gives flint and iron nuggets. Lots of gravel means lots of iron."]
	quest.42B341AE019A554A.title: "Bulk Washing"
	quest.42BD0ECDCFA02650.quest_desc: ["Catch 10 Water-type Pokémon."]
	quest.42BD0ECDCFA02650.title: "Water Specialist"
	quest.43370808FACCB969.quest_desc: ["A deployer joins a top and a bottom. Automate the whole chain from the Apricorn trees and fill a stack."]
	quest.43370808FACCB969.title: "The Poké Ball Factory"
	quest.437A6A7B876C24D8.quest_desc: ["Silvère's Pokémon are level 28 to 32, and your cap is now 32, the level of his strongest."]
	quest.437A6A7B876C24D8.title: "Ready for Silvère"
	quest.44B0CB93060A3B0D.quest_desc: ["Evolve 10 Pokémon."]
	quest.44B0CB93060A3B0D.title: "Evolution Lover"
	quest.453FC00769DEE9B8.quest_desc: ["Mix copper and zinc in a basin placed on a lit Blaze Burner."]
	quest.453FC00769DEE9B8.title: "Brass"
	quest.4574D68864A07416.quest_desc: ["Ice sometimes comes out of the block: place it on your island next to a torch and it melts into water. Keep two ice blocks: two sources side by side make an infinite one, and Create will need it in phase 1. A bucket needs iron (phase 1), but the block's chests sometimes hold a water bucket."]
	quest.4574D68864A07416.title: "A Water Source"
	quest.4677371F5BEFD901.quest_desc: ["Black and yellow Apricorns around a gold ingot. White and black Apricorn saplings now come out of the block."]
	quest.4677371F5BEFD901.title: "Ultra Balls"
	quest.46893E765507CC5C.quest_desc: ["Blue and red Apricorns around an iron ingot: better odds against stronger Pokémon."]
	quest.46893E765507CC5C.title: "Great Balls"
	quest.468A7EA81707E49E.quest_desc: ["Fish Pokémon out of water with a Poké Rod. It is made on a smithing table from a fishing rod, a Poké Ball and a Poké Rod template: fish with an ordinary rod to find one among the treasures, then copy it. Add bait to attract some species."]
	quest.468A7EA81707E49E.title: "Poké Rod"
	quest.468FD92E7504075B.quest_desc: ["Put ingots on a depot or a belt under the press."]
	quest.468FD92E7504075B.title: "Iron Sheets"
	quest.47C4D0C1391A8B01.quest_desc: ["Your Pokédex records every species you see and catch. Craft one, then use it (right-click) to open it."]
	quest.47C4D0C1391A8B01.title: "Pokédex"
	quest.47E272DB2DB104B0.quest_desc: ["Picks items up and drops them off wherever you point it."]
	quest.47E272DB2DB104B0.title: "Mechanical Arm"
	quest.47EE0CE3F90FD30C.quest_desc: ["Crafting tables that work alone, and can craft recipes larger than 3×3."]
	quest.47EE0CE3F90FD30C.title: "Mechanical Crafters"
	quest.48A0D451F5B7EA60.quest_desc: ["Small floating islands are scattered across the void: the Cobblemon habitats. Each one attracts its own Pokémon around its habitat block. Stand inside a habitat to discover it. Waystones and airships make travelling easier."]
	quest.48A0D451F5B7EA60.title: "The Habitats"
	quest.493E6CB07B6D0F81.quest_desc: ["The Hero Sword and the Hero Shield wait in the Throne Room of the Knightly Heroes: bring one back to wake Zacian or Zamazenta."]
	quest.493E6CB07B6D0F81.title: "Relics of the Heroes"
	quest.496C875B352B3098.quest_desc: ["Pipez: simple, light pipes. Configure each side with the wrench."]
	quest.496C875B352B3098.title: "Item Pipes"
	quest.4ABCCB57F5A936DC.quest_desc: ["Marine's Pokémon are level 45 to 50, and your cap is now 50, the level of her strongest."]
	quest.4ABCCB57F5A936DC.title: "Ready for Marine"
	quest.4B56D5CA2DAD4D82.quest_desc: ["Ice spikes, burrows, grottos and hot springs in the snow: home of Ice-type Pokémon."]
	quest.4B56D5CA2DAD4D82.title: "Habitat: Snowfields"
	quest.4BF65C8B99A64E76.quest_desc: ["A legendary Fire/Flying-type Pokémon. Catch it when it comes out of the block, then put it in your party."]
	quest.4BF65C8B99A64E76.title: "Ho-Oh"
	quest.4C0888A9E47FC7C9.quest_desc: ["Catch 100 Pokémon since the start of your adventure. The Pokédex chapter tracks the rest."]
	quest.4C0888A9E47FC7C9.title: "A Hundred Catches"
	quest.4C15803004FBCDAA.quest_desc: ["Unlocked when your island reaches phase 2."]
	quest.4C15803004FBCDAA.title: "Phase 2"
	quest.4C565E342FC174EB.quest_desc: ["Barrels and chests that grow with upgrades."]
	quest.4C565E342FC174EB.title: "Sophisticated Barrel"
	quest.4D90A598DB55CE2F.quest_desc: ["A propeller in a casing. Blowing through water, it washes items; through lava, it smelts them."]
	quest.4D90A598DB55CE2F.title: "Encased Fan"
	quest.4ED7C51BDFBB1623.quest_desc: ["Unlocked when your island reaches phase 5."]
	quest.4ED7C51BDFBB1623.title: "Phase 5"
	quest.4F7D3200DC1DCF53.quest_desc: ["A legendary Ice-type Pokémon. Catch it when it comes out of the block, then put it in your party."]
	quest.4F7D3200DC1DCF53.title: "Regice"
	quest.4FA68FBD1AD542C8.quest_desc: ["Break the block under your feet: it comes back every time with something new. Its drops stay on top of it."]
	quest.4FA68FBD1AD542C8.title: "The First Block"
	quest.4FEBD0937DACEEF4.quest_desc: ["Deep-sea spires and drifting icebergs above the oceans. Water Pokémon need water: bring some, or fish with a Poké Rod."]
	quest.4FEBD0937DACEEF4.title: "Habitat: The Open Sea"
	quest.504B1B870C3A123F.quest_desc: ["Catch 10 Dark-type Pokémon."]
	quest.504B1B870C3A123F.title: "Dark Specialist"
	quest.513B28B9BBA11BF5.quest_desc: ["The PokéFinder points to the nearest Pokémon. An Apricorn of any colour, a compass, copper and an Electirizer."]
	quest.513B28B9BBA11BF5.title: "PokéFinder"
	quest.518690843DC968FE.quest_desc: ["A legendary Normal-type Pokémon. Catch it when it comes out of the block, then put it in your party."]
	quest.518690843DC968FE.title: "Regigigas"
	quest.51D2E9918320C7AF.quest_desc: ["Catch 5 Steel-type Pokémon to fill your pastures."]
	quest.51D2E9918320C7AF.title: "The Iron Crew"
	quest.5206489D4A47EFB8.quest_desc: ["Catch 150 Pokémon."]
	quest.5206489D4A47EFB8.title: "150 Pokémon"
	quest.521F05D919E52319.quest_desc: ["Six Pokémon in your party: ready for anything."]
	quest.521F05D919E52319.title: "Full Team"
	quest.5230B27D7503A614.quest_desc: ["The Elite Four and the Champion want a rematch, stronger than ever (levels 92 to 100). Island menu → [Boss]: one opponent after the other. One Rematch per week on a server, every 3 hours of play in solo; the winner gets a League Medal, Rare Candies and an Ability Patch."]
	quest.5230B27D7503A614.title: "League Rematch"
	quest.526CED0031C1CC5A.quest_desc: ["Pokémon in a pasture drop their items from time to time: raw iron from Aron, copper from Roggenrola, coal from Rolycoly…"]
	quest.526CED0031C1CC5A.title: "Pasture Loot"
	quest.5279598564B46349.quest_desc: ["Catch 10 Fairy-type Pokémon."]
	quest.5279598564B46349.title: "Fairy Specialist"
	quest.534802254D3FC862.quest_desc: ["Raise a Pokémon to level 30. Remember the level cap: beat the phase bosses to raise it."]
	quest.534802254D3FC862.title: "Experienced"
	quest.5356787D01AECD59.quest_desc: ["The millstone crushes cobblestone into gravel: the future source of your iron."]
	quest.5356787D01AECD59.title: "Millstone"
	quest.53592938903DF25C.quest_desc: ["Every level in a tree gives a skill point. Break a few blocks, open your trees with J and spend your first point in Block Miner. Each tree levels up on its own, with its own activity."]
	quest.53592938903DF25C.title: "A New Skill"
	quest.5364082DD319E670.quest_desc: ["With oxygen from an Electrolytic Separator, the Purification Chamber gets three ingots per ore."]
	quest.5364082DD319E670.title: "Ores ×3"
	quest.53BCD784DF23288B.quest_desc: ["Apricorn saplings come out of the block. Plant them on dirt: their fruit is the base of every Poké Ball. Tip: crouch repeatedly next to them to make them grow faster."]
	quest.53BCD784DF23288B.title: "Apricorn Grove"
	quest.55371EB02CFD4DFE.quest_desc: ["Lush or parched peat bogs, where sturdy Fighting-type Pokémon train."]
	quest.55371EB02CFD4DFE.title: "Habitat: Peat Bogs"
	quest.5551CBBA542B4A08.quest_desc: ["Quartz and silicon make processors; the controller powers the whole network."]
	quest.5551CBBA542B4A08.title: "Refined Storage"
	quest.55625BFA5DD44551.quest_desc: ["Pumps, tanks and spouts: move and use water, lava and more."]
	quest.55625BFA5DD44551.title: "Fluids"
	quest.55F4DAF90AB3ECAE.quest_desc: ["Catch 600 Pokémon."]
	quest.55F4DAF90AB3ECAE.title: "600 Pokémon"
	quest.565A55D4C1063D35.quest_desc: ["Four red Apricorns around a copper ingot make four Poké Balls."]
	quest.565A55D4C1063D35.title: "Home-made Poké Balls"
	quest.568F54664F28E804.quest_desc: ["Berry patches, ponds and sunny clearings in temperate plains and forests. The most common habitats."]
	quest.568F54664F28E804.title: "Habitat: Meadows"
	quest.56D95BE5DE192A10.quest_desc: ["A legendary Fighting-type Pokémon. Catch it when it comes out of the block, then put it in your party. Give it the Rusted Shield to awaken its Crowned form."]
	quest.56D95BE5DE192A10.title: "Zamazenta"
	quest.56FB461130AF17D7.quest_desc: ["Because why not."]
	quest.56FB461130AF17D7.title: "Potato Cannon"
	quest.5AE688696D16F999.quest_desc: ["Activate a Waystone to teleport back to it from any other Waystone."]
	quest.5AE688696D16F999.title: "Waystones"
	quest.5AEB3EE6BADBE82C.quest_desc: ["A legendary Electric/Flying-type Pokémon. Catch it when it comes out of the block, then put it in your party."]
	quest.5AEB3EE6BADBE82C.title: "Zapdos"
	quest.5CAD96BDB7294441.quest_desc: ["Legendary Pokémon almost never stay in a normal ball. First step of a Master Ball line: the lid, made from a Shulker Shell and Netherite, in a Create sequenced assembly or a Mekanism Combiner. Check the recipes in JEI."]
	quest.5CAD96BDB7294441.title: "Master Ball Lid"
	quest.5CC2BFFEF1EAC770.quest_desc: ["High-tier machines need Elite Control Circuits (refined obsidian and reinforced alloy)."]
	quest.5CC2BFFEF1EAC770.title: "Elite Circuits"
	quest.5DB375F43D2FA1B1.quest_desc: ["Create: Power Loader keeps your factory loaded while you travel."]
	quest.5DB375F43D2FA1B1.title: "Always Running"
	quest.5E2D1B852B61F437.quest_desc: ["Berries heal your Pokémon and cook into many recipes. Plant them to grow more."]
	quest.5E2D1B852B61F437.title: "Berries"
	quest.5EBB433EE59F929D.quest_desc: ["The ultimate goal: visit every one of the 30 Cobblemon habitats."]
	quest.5EBB433EE59F929D.title: "Habitat Master"
	quest.5FF864B8D67692CE.quest_desc: ["Brutus hits hard with Fighting-type Pokémon."]
	quest.5FF864B8D67692CE.title: "Elite Four: Brutus"
	quest.609217ADFE2F53C4.quest_desc: ["Automate every main resource. Show a stack of each."]
	quest.609217ADFE2F53C4.title: "Everything Automated"
	quest.60D9F8066F75D739.quest_desc: ["Super glue blocks together and move them with a mechanical bearing."]
	quest.60D9F8066F75D739.title: "Contraptions"
	quest.61E7BBECB0B33CBA.quest_desc: ["Unlocked when your island reaches phase 1."]
	quest.61E7BBECB0B33CBA.title: "Phase 1"
	quest.620E5148A1C0F47C.quest_desc: ["Upgradable chests and barrels: more slots, stacks, filters and automation."]
	quest.620E5148A1C0F47C.title: "Sophisticated Storage"
	quest.62197618341A7721.quest_desc: ["Nox, the last of the Four, fights in the dark."]
	quest.62197618341A7721.title: "Elite Four: Nox"
	quest.62D86832C4145121.quest_desc: ["Search and craft straight from your network."]
	quest.62D86832C4145121.title: "Crafting Grid"
	quest.633C21FCAE282EE1.quest_desc: ["Tung's Pokémon are level 15 to 17. For now, your Pokémon stop gaining experience at level 20: beating a boss raises that cap."]
	quest.633C21FCAE282EE1.title: "Training"
	quest.638F92CBB0644936.quest_desc: ["Fire, Water, Thunder and Leaf Stone ores now come out of the block."]
	quest.638F92CBB0644936.title: "Evolution Stones"
	quest.63A02574E7F8798D.quest_desc: ["Your Rival fights with three Pokémon. Have at least three in your party."]
	quest.63A02574E7F8798D.title: "A Real Team"
	quest.648E8020961A2F4B.quest_desc: ["Unlocked when your island reaches phase 1."]
	quest.648E8020961A2F4B.title: "Phase 1"
	quest.64F89ECCB4B33D3D.quest_desc: ["Raise a Pokémon to level 50."]
	quest.64F89ECCB4B33D3D.title: "Veteran Trainer"
	quest.6632C975B6211FA5.quest_desc: ["Plant every Apricorn color: red, blue and yellow in phase 0, green and pink in phase 1, white and black in phase 2."]
	quest.6632C975B6211FA5.title: "All the Apricorns"
	quest.67BE5E70892C81F1.quest_desc: ["Encode patterns in a Pattern Grid and place them in an Autocrafter: the network crafts on demand."]
	quest.67BE5E70892C81F1.title: "Autocrafting"
	quest.68FA3CDE3305D0C1.quest_desc: ["Ultimate Control Circuits for the best machines of the game."]
	quest.68FA3CDE3305D0C1.title: "Ultimate"
	quest.6968F739B7F2EC4D.quest_desc: ["Multiply the capacity of a drawer."]
	quest.6968F739B7F2EC4D.title: "Storage Upgrade"
	quest.698064745C1E55F2.quest_desc: ["Catch 10 Rock-type Pokémon."]
	quest.698064745C1E55F2.title: "Rock Specialist"
	quest.6A1F50D04E0133DD.quest_desc: ["The Tera Orb changes a Pokémon's type in the middle of a battle."]
	quest.6A1F50D04E0133DD.title: "Terastallization"
	quest.6A7A863777ED7392.quest_desc: ["Huge multiblock storage for your production lines."]
	quest.6A7A863777ED7392.title: "Item Vault"
	quest.6A87F57E6BEA7A22.quest_desc: ["Choose your starter Pokémon when the game asks you (or open your summary with M). Send it out with R."]
	quest.6A87F57E6BEA7A22.title: "A Partner"
	quest.6AAF7BB14E5EEE1F.quest_desc: ["Right-click a stripped log with Andesite Alloy to make a casing: every machine is built around one."]
	quest.6AAF7BB14E5EEE1F.title: "Andesite Casing"
	quest.6B30A0EAE22BB188.quest_desc: ["Power by hand, while you wait for water."]
	quest.6B30A0EAE22BB188.title: "Hand Crank"
	quest.6B4AAC1AF7CDA00A.quest_desc: ["Catch 10 Ghost-type Pokémon."]
	quest.6B4AAC1AF7CDA00A.title: "Ghost Specialist"
	quest.6B9A6BCB21A95AC9.quest_desc: ["Unlocked when your island reaches phase 1."]
	quest.6B9A6BCB21A95AC9.title: "Phase 1"
	quest.6BAA1AA6CEDC8075.quest_desc: ["A legendary Fairy/Flying-type Pokémon. Catch it when it comes out of the block, then put it in your party. The Reveal Glass switches the forces of nature between their two forms."]
	quest.6BAA1AA6CEDC8075.title: "Enamorus"
	quest.6C0A0836B84A8CEA.quest_desc: ["Fluid tanks, Blaze Burners and steam engines: the strongest power of Create."]
	quest.6C0A0836B84A8CEA.title: "Steam Power"
	quest.6CB5190D85C7A87A.quest_desc: ["A legendary Fire/Flying-type Pokémon. Catch it when it comes out of the block, then put it in your party."]
	quest.6CB5190D85C7A87A.title: "Moltres"
	quest.6D0A170E6FACA234.quest_desc: ["Catch 10 Flying-type Pokémon."]
	quest.6D0A170E6FACA234.title: "Flying Specialist"
	quest.6D422E120D98984E.quest_desc: ["A legendary Fairy-type Pokémon. Catch it when it comes out of the block, then put it in your party. Give it the Rusted Sword to awaken its Crowned form."]
	quest.6D422E120D98984E.title: "Zacian"
	quest.6DAE1AB52930DE1C.quest_desc: ["A legendary Dragon/Ground-type Pokémon. Catch it when it comes out of the block, then put it in your party. The Zygarde Cube stores Cells and changes its form."]
	quest.6DAE1AB52930DE1C.title: "Zygarde"
	quest.6F3A76830F7FCFAC.quest_desc: ["Place dirt around the block to grow your island. Wild Pokémon appear by themselves on grass when there is enough space."]
	quest.6F3A76830F7FCFAC.title: "Room to Grow"
	quest.7015F4A1299EAB92.quest_desc: ["Iron ore now comes out of the block, but rarely. Save every ingot: your first machines need it."]
	quest.7015F4A1299EAB92.title: "Precious Iron"
	quest.71D70C1E40791825.quest_desc: ["Dried kelp blocks now come out of the block: six dried kelp make a belt. Link two shafts with it."]
	quest.71D70C1E40791825.title: "Conveyor Belts"
	quest.7203981A1B283CA2.quest_desc: ["Take a Pokémon to the very top."]
	quest.7203981A1B283CA2.title: "Level 100"
	quest.721BB72D06B00993.quest_desc: ["A legendary Dragon-type Pokémon. Catch it when it comes out of the block, then put it in your party."]
	quest.721BB72D06B00993.title: "Regidrago"
	quest.72BFAC69309917C3.quest_desc: ["Raid dens need solid ground, so none form in the void: the Champion left you a Raid Den Crystal. Place it on your island and team up against giant Pokémon. Raids of 5 stars and more give Raid Shards; the den changes Pokémon and tier every two hours."]
	quest.72BFAC69309917C3.title: "Raid Dens"
	quest.72DADAF7FA8E80AB.quest_desc: ["A legendary Dragon/Psychic-type Pokémon. Catch it when it comes out of the block, then put it in your party."]
	quest.72DADAF7FA8E80AB.title: "Latios"
	quest.72E08216D576331F.quest_desc: ["A mythical Dark/Grass-type Pokémon. Catch it when it comes out of the block, then put it in your party."]
	quest.72E08216D576331F.title: "Zarude"
	quest.72EB194A846DFE5B.quest_desc: ["Unlocked when your island reaches phase 5."]
	quest.72EB194A846DFE5B.title: "Phase 5"
	quest.7301E5D7942A2D78.quest_desc: ["A legendary Ground/Flying-type Pokémon. Catch it when it comes out of the block, then put it in your party. The Reveal Glass switches the forces of nature between their two forms."]
	quest.7301E5D7942A2D78.title: "Landorus"
	quest.7338ECCF119DC348.quest_desc: ["A legendary Psychic-type Pokémon. Catch it when it comes out of the block, then put it in your party."]
	quest.7338ECCF119DC348.title: "Mewtwo"
	quest.7345B7BDC2A03375.quest_desc: ["Some Pokémon can be ridden: walking, swimming or flying."]
	quest.7345B7BDC2A03375.title: "Ride On"
	quest.74108F3B9F3D0E92.quest_desc: ["Put Aron, Magnemite, Bronzor or Klink in a pasture: they drop raw iron from time to time. Aron and Magnemite now come out of the block. Reward: a Magnet Upgrade for your backpack, which pulls in nearby items."]
	quest.74108F3B9F3D0E92.title: "Pokémon at Work"
	quest.74A0D57BF8FADB92.quest_desc: ["Catch 10 Ice-type Pokémon."]
	quest.74A0D57BF8FADB92.title: "Ice Specialist"
	quest.74C70DF4751532F4.quest_desc: ["Stone and cobblestone come out of the block. A stone pickaxe mines everything phase 0 has to offer."]
	quest.74C70DF4751532F4.title: "Stone Age"
	quest.74FD62B2BD920AE2.quest_desc: ["Catch 10 Psychic-type Pokémon."]
	quest.74FD62B2BD920AE2.title: "Psychic Specialist"
	quest.75F27B376AE1720C.quest_desc: ["A legendary Normal-type Pokémon. Catch it when it comes out of the block, then put it in your party."]
	quest.75F27B376AE1720C.title: "Terapagos"
	quest.76081DA438C9A279.quest_desc: ["Sibylle reads your moves with Psychic-type Pokémon."]
	quest.76081DA438C9A279.title: "Elite Four: Sibylle"
	quest.765E02573F9A6143.quest_desc: ["Unlocked when your island reaches phase 1."]
	quest.765E02573F9A6143.title: "Phase 1"
	quest.770893C6F0A9E356.quest_desc: ["Defeat 20 wild Pokémon to train your team."]
	quest.770893C6F0A9E356.title: "Sparring"
	quest.77255D3C2EA07E44.quest_desc: ["See the speed and stress of every machine you look at."]
	quest.77255D3C2EA07E44.title: "Engineer's Goggles"
	quest.7899FBE049EEFAB5.quest_desc: ["Hydrogen chloride in a Chemical Injection Chamber: four ingots per ore."]
	quest.7899FBE049EEFAB5.title: "Ores ×4"
	quest.78CF867CD1C5139B.quest_desc: ["A Healing Machine restores your whole team. It needs redstone (now in the block) and a Max Revive: two Revives and a Vivichoke in a campfire pot. Revival Herbs and Vivichoke seeds hide in the block's chests from phase 1: plant them."]
	quest.78CF867CD1C5139B.title: "Healing Machine"
	quest.78E4170A9B4BB4CD.quest_desc: ["The Cobblemon campfire pot cooks snacks and treats for your Pokémon."]
	quest.78E4170A9B4BB4CD.title: "Cobblemon Cooking"
	quest.78FD6054F64C1D5A.quest_desc: ["Create Enchantment Industry: liquid experience and a Blaze that enchants for you."]
	quest.78FD6054F64C1D5A.title: "Enchantment Industry"
	quest.792D0655418A7BB8.quest_desc: ["Fluid pipes and energy pipes work the same way."]
	quest.792D0655418A7BB8.title: "Fluids and Energy"
	quest.796250915FAF20DD.quest_desc: ["A legendary Dragon/Psychic-type Pokémon. Catch it when it comes out of the block, then put it in your party."]
	quest.796250915FAF20DD.title: "Latias"
	quest.79C3967A356FC944.quest_desc: ["A legendary Ice/Flying-type Pokémon. Catch it when it comes out of the block, then put it in your party."]
	quest.79C3967A356FC944.title: "Articuno"
	quest.79CC6BFFAEFDA249.quest_desc: ["Steel is in almost every Mekanism machine. Make plenty."]
	quest.79CC6BFFAEFDA249.title: "Steel"
	quest.79CC6EF7566E130D.quest_desc: ["Crafts \\& Additions: an alternator turns rotation into energy (FE). It bridges Create and Mekanism."]
	quest.79CC6EF7566E130D.title: "Electricity"
	quest.79EF8BF6193C1AB6.quest_desc: ["In the post-game the block sometimes turns into Galar Particle Ore or Ancient Rubble: the monuments' rituals need what they drop."]
	quest.79EF8BF6193C1AB6.title: "Galar Particles"
	quest.7B58C8DBDD4770BF.quest_desc: ["Catch 10 Normal-type Pokémon."]
	quest.7B58C8DBDD4770BF.title: "Normal Specialist"
	quest.7C935F4D0BBA8AE0.quest_desc: ["Fight monsters, fish and travel to other dimensions to grow this tree: made for the Nether, the End and the faraway habitats."]
	quest.7C935F4D0BBA8AE0.title: "Explorer"
	quest.7CA32E1AA4F17E55.quest_desc: ["Create 6 packagers and stock tickers: order items from your whole factory."]
	quest.7CA32E1AA4F17E55.title: "Logistics"
	quest.7D0AE26C88145DB2.quest_desc: ["A legendary Psychic/Flying-type Pokémon. Catch it when it comes out of the block, then put it in your party."]
	quest.7D0AE26C88145DB2.title: "Lugia"
	quest.7D5038CBB1356AA0.quest_desc: ["Catch 10 Grass-type Pokémon."]
	quest.7D5038CBB1356AA0.title: "Grass Specialist"
	quest.7E3E23C5F0CAC0FD.quest_desc: ["Cherry groves, flower forests and magical mounds, full of Fairy-type Pokémon."]
	quest.7E3E23C5F0CAC0FD.title: "Habitat: Flower Clearings"
	quest.7E97053D7094216E.quest_desc: ["Challenge Marine with /trigger cf.boss. Victory opens phase 3: Mekanism and Refined Storage."]
	quest.7E97053D7094216E.title: "Marine, Mistress of the Waters"
	quest.7F490CCA5794F5A4.quest_desc: ["Diamond ore now comes out of the block, but rarely: mine it with an iron pickaxe. Obsidian also appears, and only a diamond pickaxe collects it: with any other pickaxe it breaks for nothing."]
	quest.7F490CCA5794F5A4.title: "Diamond Pickaxe"
	quest.7FE929A1ED57EF93.quest_desc: ["Light your portal and cross it. The dragon is optional; Psychic Pokémon await in the End. To come back, jump into the portal that appears when the dragon dies, or die: you respawn on your island."]
	quest.7FE929A1ED57EF93.title: "The End"
	quest.7FF2B2D9C16A880E.quest_desc: ["Storage disks in a disk drive: every item of your base in one place."]
	quest.7FF2B2D9C16A880E.title: "Disk Drive"
