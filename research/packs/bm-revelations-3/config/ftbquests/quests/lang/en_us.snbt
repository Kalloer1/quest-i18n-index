	quest.4D90E2231DD52221.quest_subtitle: "Handyman at its best"
	quest.4EB45F62D4352CFA.quest_desc: [
		"&dEnchanter&r allows you to create &ecustom enchantments&r using &bexperience&r and &bspecific materials&r.  "
		""
		"It provides more control over enchantments compared to traditional methods."
	]
	quest.4EB45F62D4352CFA.quest_subtitle: "Controlled Magic"
	quest.4F1C80CB01377D0A.quest_desc: [
		"The &dCharm Belt&r automatically activates any equipped &eMonster Charms&r, saving inventory space and keeping their effects active."
		""
		"It’s a handy way to stay protected from specific mobs without having to hold the charms directly."
	]
	quest.4F1C80CB01377D0A.quest_subtitle: "Getting the jewels in order"
	quest.4F3C7F253B1A3B26.quest_desc: [
		"&aHydroponic Beds&r are a great way to enhance your farming, as it can &espeed up&r the growth of crops placed above it, as long as &bwater&r and &benergy&r is supplied."
		""
		"&oThese can get even better with certain material that you will unlock later.&r"
	]
	quest.4F3C7F253B1A3B26.quest_subtitle: "Crops enhanced!"
	quest.4F3C7F253B1A3B26.title: "Efficient Farming"
	quest.50ADBCBEAD81591E.title: "Redstone III"
	quest.514FA3553B50E276.quest_desc: ["The &dTarget Designator&r sets &nonly a direction&r, not a specific block, and the beam will attempt to destroy all blocks along that line."]
	quest.517377E1BDFADA0E.quest_desc: [
		"&dVacuum Chest&r automatically attracts nearby items, making it useful for automation and item collection."
		""
		"It has a configurable range and can be upgraded with filters to control which items it picks up."
	]
	quest.517582A4F6A7FCB3.quest_desc: [
		"&dWarrior Armor&r transforms you into a formidable Viking."
		""
		"It &eboosts axe damage&r and overall strength as health decreases, enabling brutal melee combat."
	]
	quest.517582A4F6A7FCB3.title: "Warrior"
	quest.5179780B4F5DDDA0.quest_desc: [
		"Place a &bFusion Core&r and &bFusion Crafting Injectors&r 2 blocks apart from your Fusion Core."
		""
		""
		"{@pagebreak}"
		""
		"&eExample recipe for a Wyvern Sword:&r"
		""
		"1. Place a Diamond Sword inside the Fusion Crafting Core."
		""
		"2. PLace a Draconium Core,"
		"   &o2x&r Draconium Ingots,"
		"   &o2x&r Basic Energy Relay Crystals,"
		"   Wyvern Energy Controller"
		"inside the &bFusion Crafting Injectors&r."
		""
		"Ensure the Injectors are &cpowered with energy&r."
	]
	quest.5179780B4F5DDDA0.title: "Draconium Fusion"
	quest.52186B8B6A5B9479.quest_desc: [
		"The &dSemi-Autogenous Grinding Mill&r (SAG Mill) is a powerful machine that grinds &bOres&r, &bIngots&r, and other materials into &ePowder&r or &ebonus outputs&r."
		""
		"It runs on &aForge Energy&r (FE) and can be upgraded for better efficiency."
		"{@pagebreak}"
		"You can create different types of &eGrinding Balls&r to increase the efficiency of this machine, making it yield more items or use &aless energy&r."
	]
	quest.52186B8B6A5B9479.quest_subtitle: "Down to a fine powder"
	quest.521C0A3172B9DE04.quest_desc: [
		"Deep in the Swamp, you may find a &bGolden Allay&r floating around."
		""
		"If you give this allay a &bMage Hat&r, a &bMage Coat&r and a &bMage Staff&r, it will transform into the &eSoul Mage&r and become your companion! It doesn't do much by itself, but you can give it &aspell books&r and it will fire them against enemies. "
		""
		"Also, if you place a &bcandle&r into the &bSoul Furnace&r, it will become a &eLiving Candle&r and attach itself to the closest Soul Mage, &aprotecting it from fatal damage&r by taking its place instead!"
	]
	quest.521C0A3172B9DE04.quest_subtitle: "Spellcaster companion!"
	quest.521C0A3172B9DE04.title: "The Soul Mage"
	quest.538F5B764494FDC5.quest_desc: ["&dRobe Armor&r features fluffy, &bdyeable wool&r infused with blaze rods. It &edeals fire damage&r to attackers while remaining completely &efireproof&r."]
	quest.538F5B764494FDC5.title: "Robe"
	quest.540E62ADBD6F4C19.title: "Golden"
	quest.546CF09FB2DF4966.quest_desc: [
		"&lHow do I obtain a Runic Tablet?&r"
		""
		"&dRunic Tablets&r have a low chance to be found in &bany chest&r, including chests found in modded structures."
		""
		""
		"{@pagebreak}"
		"&lHow do I re-roll a runic power?&r"
		""
		"&eRunic weapons&r can have their ability re-rolled by combining a &dRunic Tablet&r, the &bRunic Weapon&r, and a &bDiamond&r in a smithing table."
		""
		"(Do not shift-click the item from the smithing table, or it will not re-roll the ability)."
	]
	quest.549DD662D49569F9.quest_desc: [
		"The &bDinamo&r has one additional ability that can be used while its sitting down: it can feed electricity to &etesla coils&r nearby!"
		""
		"These can be linked with other blocks, such as light sources from &aPlasma Lamps&r, or used to connect &aRecall Platforms&r that will act as teleports in the same network."
		""
		"Check the description of each block and experiment as much as you want! But be careful not to get &celectrocuted&r in the meantime."
	]
	quest.549DD662D49569F9.quest_subtitle: "Electrifying!!"
	quest.549DD662D49569F9.title: "The Tesla Network"
	quest.55E460FBDF58B39D.quest_desc: [
		"Breaking an &dAncient Vase&r without Silk Touch risks summoning danger."
		""
		"&bSculk Leeches&r may spawn, but there’s a slim chance you’ll face a deadly &bStalker&r. Will you take the risk?"
	]
	quest.55E460FBDF58B39D.quest_subtitle: "The Ancient Temple is the sole structure in the Otherside dimension and is filled with valuable loot."
	quest.5602CF8DA37D8AFC.quest_desc: [
		"&dPhotovoltaic Modules&r convert sunlight into &aForge Energy&r (FE), providing a passive and renewable power source."
		""
		"They generate power during daylight hours and must have a &cclear line of sight&r to the sky."
	]
	quest.573CA6CEC7835F8D.quest_desc: [
		"Now you have access to &aMechanical Dirt&r."
		""
		"This special block, when supplied with &benergy&r and &bliquid meat&r, acts as a natural spawn for &ehostile mobs&r under the right conditions. It might be useful for &amob farms&r."
	]
	quest.573CA6CEC7835F8D.quest_subtitle: "They just keep coming!"
	quest.573CA6CEC7835F8D.title: "Efficient Spawning"
	quest.5760C9BE6F25A9AF.quest_desc: [" The Exporter &dsends items&r from your system to connected inventories."]
	quest.576CD59FB316D3E4.quest_desc: [
		"The &dEnergy Conduit&r transfers &aForge Energy&r (FE) between &emachines&r and &bpower sources&r."
		"It provides a compact and efficient way to manage energy distribution."
	]
	quest.576CD59FB316D3E4.title: "Energy Conduits"
	quest.58EBFBFFE9DCE3C9.quest_desc: [""]
	quest.58EBFBFFE9DCE3C9.quest_subtitle: "Try getting your first kills!"
	quest.58EBFBFFE9DCE3C9.title: "Rookie Numbers"
	quest.59BB37822803ACA6.quest_desc: [
		"&eCoins &rcan be found in structures all across the world!"
		""
		"&aCopper coins&r can be found in the Overworld (also by trading with villagers), and there are also &anether&r and &aend&r variants for each dimension."
	]
	quest.59BB37822803ACA6.quest_subtitle: "Ohh, shiny!"
	quest.59BB37822803ACA6.title: "Coins!"
	quest.5AAAEF8F19AE31B4.quest_subtitle: "Submit items"
	quest.5AAAEF8F19AE31B4.title: "Golden Trade"
	quest.5B1F99C9FB825EA9.quest_desc: [
		"The &eHero's Medallion&r stores &dexperience&r as you collect it, keeping it safe until you're ready to use it."
		""
		"It can hold large amounts of XP and helps prevent accidental loss on death."
	]
	quest.5B8996EA0858DB01.quest_desc: ["This block offers &dexpanded pattern storage&r, enabling you to handle more complex recipes with ease."]
	quest.5C635316B1588D93.title: "Leather"
	quest.5CB02A08E1B2D0F6.quest_desc: ["The Importer &dpulls items&r from connected inventories into your system."]
	quest.5D841760B20B984D.quest_desc: [
		"You probably have animals in a fence by now."
		""
		"Animals can produce &bSewage&r when in range of a &aSewer&r, and this can be used in a &aComposter&r in order to produce &eFertilizer&r, which mimics the effects of bone meal."
	]
	quest.5D841760B20B984D.quest_subtitle: "Ew..."
	quest.5D841760B20B984D.title: "Fertilizer production"
	quest.5E779BD8226C52DD.quest_desc: ["The Fortune Upgrade increases resource drops, similar to the Fortune enchantment."]
	quest.5F69359563745BBE.title: "Basic Processor"
	quest.5F6CCF1A0C89B569.title: "Your Home"
	quest.6010C0EC3BADEAD9.quest_desc: ["These cables are used to &bconnect&r and &bpower&r Refined Storage devices, forming a &dunified network&r for seamless resource management."]
	quest.6010C0EC3BADEAD9.quest_subtitle: "Everything connected!"
	quest.60162F65CC931928.quest_desc: [
		"The pulverizer is a slow and simple block that crushes &bores&r and &bbiomass&r into &edust&r."
		""
		"It gives a &dbetter yield&r than directly smelting raw ores."
	]
	quest.60162F65CC931928.quest_subtitle: "Improves ore processing efficiency"
	quest.60A6D0F0DBFA0AFC.quest_desc: [
		"The Crafting Grid combines the &bstandard Grid&r with a &dbuilt-in crafting table&r."
		""
		"It lets you craft items directly from the stored resources."
	]
	quest.61B701498CA8CEDE.quest_desc: [
		"You can summon this companion by interacting with a &bRespawn Totem&r using an &bRelic Gold&r instead of an Hourglass."
		""
		"This golden monkey can vaporize enemies using a &alaser beam&r from a distance, or cast a &afire ring&r on its feet to burn nearby targets!"
	]
	quest.61B701498CA8CEDE.quest_subtitle: "MONKEEEE"
	quest.61B701498CA8CEDE.title: "The Mankh"
	quest.61EDC774EFC0259E.quest_desc: [
		"&6Oritech&r features new &emultiblock machines&r that allow you to process and harvet resources, or produce energy."
		""
		"Create Multiblocks out of the &binitial machine&r block and fill it with &dMachine Cores&r."
	]
	quest.6235A39AA9FF87F9.quest_desc: ["When supplied with &benergy&r, this machine will &efreeze any entity&r in its range, which might not seem a lot until you look at the next quest..."]
	quest.6235A39AA9FF87F9.quest_subtitle: "Freeze!"
	quest.6288B85471ECBA78.quest_desc: [
		"&bCopper Alloy Ingots&r are used to craft a &dDrain&r, which picks up liquids from &awater&r source blocks and transfers them to machines that need it."
		""
		"Keep an &ninfinite water source&r underneath to ensure continuous operation."
	]
	quest.6288B85471ECBA78.quest_subtitle: "Water supply!"
	quest.6295FF1B7C1BE2B8.quest_desc: ["An &dElytra&r can be used to craft a &eFlight Module&r for your Draconic Chestpiece, or be crafted into a &eSoul Elytra&r."]
	quest.62C71546F94CA482.quest_desc: [
		"The centrifuge can be used to &eextract ore dusts&r from &bore clumps&r obtained from a &dFragment Forge&r."
		""
		"Spin coal dust into carbon fiber strands, or process various liquids."
	]
	quest.62C71546F94CA482.quest_subtitle: "Multiblock - requires &e1&r &dMachine Core&r!"
	quest.637843512F2C9942.quest_desc: [
		"A Pattern stores &ecrafting instructions&r that the Refined Storage system can recognize."
		""
		"By inserting it &binto an Autocrafter&r, you &eautomate recipes&r and let the network handle the rest."
	]
	quest.64B4366D220DC2D1.quest_desc: [
		"The &ePrometheum Battleaxe&r is an unbreakable multi-purpose harvesting tool."
		""
		"It works as a strong axe for stripping wood and attacking enemies, and it can also fell entire trees in one action."
		"{@pagebreak}"
		"It can be enchanted with standard axe enchantments like Efficiency, Sharpness, and Fortune."
	]
	quest.64CB066E84D2E8BD.quest_desc: [
		"Directing an &dEnderic Laser&r at &bamethyst clusters&r will transform them into &efluxite&r when mined."
		""
		"Fluxite is a key component for &eadvanced machines&r, &eEnergite&r and managing energy flow."
	]
	quest.65356B479CEADD05.quest_desc: [
		"The &aMycelial Reactor&r can produce a colossal amount of &eenergy&r, but will only start working if all other &b16 Mycelial Generators&r are &bactive&r and &bclose enough&r."
		""
		"Obtaining and making the Generators work will be the ultimate test for this section, as it will require almost every other machine from this mod."
	]
	quest.65356B479CEADD05.quest_subtitle: "All the energy is mine now"
	quest.65356B479CEADD05.title: "Full power!"
	quest.656FC8FF99C3D4B3.quest_desc: [
		"You can craft this &esilly slot machine&r with &bstone bricks&r and &bplanks&r of any kind."
		""
		"Once you place it in your world, feed it any &bcoin&r and then pull the lever for a &arandom reward&r! Better coins will give you more times to pull the lever!"
		""
		"&8By random, we mean &oreally&r &8random. Watch out.&r&r"
	]
	quest.656FC8FF99C3D4B3.quest_subtitle: "LET'S GO GAMBLING."
	quest.656FC8FF99C3D4B3.title: "Frog Bonanza!"
	quest.65C40277B2F38533.quest_subtitle: "Retro-futuristic leggings burst steam to provide a double-jump."
	quest.67A988B11E4856BA.quest_desc: [
		"The &dGlare&r lurks in the darkness, revealing dimly lit areas where monsters can spawn."
		""
		"Find one in &alush caves&r and befriend it with &bglow berries&r to make it your glowing guide!"
	]
	quest.67BA90AC53F3DC2F.quest_desc: ["The &dCross of Mercy&r is a melee weapon that deals increased damage to &eundead mobs&r like zombies"]
	quest.6846557AACFEE2FF.title: "Redstone II"
	quest.68CCE16C6869D299.quest_subtitle: "Required for Multiblock machines"
	quest.68D2399A29D11DD6.quest_desc: [
		"The &bEnderic Laser&r consumes large amounts of &aenergy&r to fire a long-range beam that is used for &erapid mining&r or &elong-distance power transfer&r."
		""
		"Use a &dtarget designator&r on the laser block to set the firing direction."
		""
		"{@pagebreak}"
		"The laser can reach up to 128 blocks and will continue firing until obstructed or disabled by a &credstone signal&r."
	]
	quest.68D2399A29D11DD6.quest_subtitle: "Multiblock - requires &e1&r &dMachine Core&r!"
	quest.69DDF301B0969F20.quest_desc: ["Imbuing your &bNetherite Gear&r with &bCrystalized Blood&r will lower it's toughness a little bit, and in exchange it will obtain an ability to&e reduce incoming damage&r when your health falls below 50%."]
	quest.69DDF301B0969F20.quest_subtitle: "The perfect Halloween costume!"
	quest.69DDF301B0969F20.title: "Bloody Gear"
	quest.6A48A1D81365B806.quest_desc: [
		"The &dYeta Wrench&r is a versatile tool used to configure and adjust &dEnderIO&r machines and conduits. It allows you to rotate, disconnect, and filter connections with ease."
		""
		"Craft it using &bIron Ingots&r and &bEnergetic Alloy&r to create an &eessential automation tool&r!"
	]
	quest.6B27FC5F2969071F.quest_desc: ["The Fortune Upgrade increases resource drops, similar to the Fortune enchantment."]
	quest.6B27FC5F2969071F.quest_subtitle: "Fortune II and III"
	quest.6B4F4F3AD82EA53A.quest_desc: ["A large multiblock that generates &apower&r from &bsunlight&r. "]
	quest.6B4F4F3AD82EA53A.quest_subtitle: "Multiblock - requires &e3&r &dMachine Cores&r!"
	quest.6B87D29559E2F898.title: "&dNether Slaughtering"
	quest.6BC86B156E239602.quest_desc: [
		"&lWhat are Runic Weapons?&r"
		""
		"&dRunic Weapons&r are created by etching runes onto &bnetherite weapons&r, and possess runic powers that enhance their combat abilities."
		""
		"{@pagebreak}"
		"&lHow do I create a Runic Weapon?&r"
		""
		"Combine a &bRunic Tablet&r, a &bNetherite Weapon&r, and a &bDiamond&r in a smithing table. Once created, left click the item in your inventory to identify the runic power."
		""
		""
		"{@pagebreak}"
		"&lHow do I repair a Runic Weapon?&r"
		""
		"&dRunic weapons&r can be repaired with &bNetherite Ingots&r."
	]
	quest.6BC86B156E239602.quest_subtitle: "Requires Smithing Table"
	quest.6BC86B156E239602.title: "&eRunic"
	quest.6C0F9B3F5910DBF0.quest_desc: [
		"&dHeavy Armor&r delivers high defense, increased toughness, and minimal knockback."
		""
		"It is designed to crush even the strongest foes at the cost of mobility."
	]
	quest.6C0F9B3F5910DBF0.title: "Heavy"
	quest.6D341E7C7391C337.title: "Gold"
	quest.6D54CD172925504C.quest_desc: [
		"&bHigh-end energy cable&r for &every large RF transfer&r."
		""
		"Default transfer rate is 4.1M RF/t."
	]
	quest.6E74479609F31F85.quest_desc: [
		"Once you get your hands on a &bZ-Logic controller&r, you can create the &dSoul Binder&r."
		""
		"This machine's most important task is to infuse &aSoul Vials&r into &aBroken Spawners&r to change the mob they have stored within."
		"{@pagebreak}"
		"Another very fun use of soul binders is creating&e Tokens&r, that can be combined with either &bclear glass&r or &bfused quartz&r, making said blocks &anon-solid&r to the target written in the token (players, mobs or animals)"
	]
	quest.6E74479609F31F85.quest_subtitle: "Spooky"
	quest.6E74479609F31F85.title: "Binding Souls"
	quest.6EA65D9BD1E07A99.quest_subtitle: "Required for Multiblock machines"
	quest.6F139D4FC4AF2FBB.quest_desc: [
		"There's a possibility that while exploring the world, or creating mob farms, you end up with a lot of items you don't need."
		""
		"If that's the case, you can always use a &eTrash Can&r to dispose of any &bitems&r you don't need."
		"{@pagebreak}"
		"There are also other versions of this block that allow to dispose of fluids, or energy, or all at once."
	]
	quest.6F139D4FC4AF2FBB.quest_subtitle: "Uh... garbage supply?"
	quest.6F139D4FC4AF2FBB.title: "Trash Cans"
	quest.6F8DBBACBBE1E4AE.quest_desc: [
		"&lWhat are Unique weapons?&r"
		""
		"&dUnique weapons&r are powerful weapons that possess unique abilities and deal slightly more damage than their Netherite counterparts."
		""
		""
		"{@pagebreak}"
		"&lWhere can I find Unique weapons?&r"
		""
		"&dUnique weapons&r are extremely rare, found in chests from structures or dropped by the &cWither&r (5%) and &cEnder Dragon&r (50%), and though they can't be crafted, some can be upgraded."
	]
	quest.702C6604028744A6.quest_subtitle: "Shoot something with a bow and arrow to prove your accuracy!"
	quest.702C6604028744A6.title: "Take Aim"
	quest.7033E1A1E1F53DC8.quest_desc: [
		"&dWooden Armor&r offers primitive yet effective protection."
		""
		"It defends well &eagainst arrows and explosions&r, making it a reliable choice for early adventurers."
	]
	quest.7033E1A1E1F53DC8.title: "Wooden"
	quest.712FC420D10DB3B1.quest_desc: [
		"&dPrismarine Armor&r uses &bGuardian spikes&r to damage attackers."
		""
		"Its design grants the &eDepth Strider&r effect, providing enhanced movement in water in exchange for a slight reduction on land."
	]
	quest.712FC420D10DB3B1.title: "Prismarine"
	quest.7145C6EC27D67761.quest_desc: [
		"If you right-click an incomplete Machine such as your first &dAssembler&r, it outlines where you have to place &bMachine Cores.&r"
		""
		"If you have &bMachine Cores&r in your Inventory, click the &einitial Machine block&r, to automatically place the Machine Cores at the proper location."
	]
	quest.7145C6EC27D67761.quest_subtitle: "Automatic placement"
	quest.717F9794EC6657A6.title: "Wyvern Fusion"
	quest.71A25A006F832582.quest_desc: ["&dSlime Armor&r provides unique protection by &ebouncing away attackers&r and &ereducing explosion damage&r, though it may leave an &cunusual smell&r."]
	quest.71A25A006F832582.title: "Slime"
	quest.720B88C548B6CBAE.quest_desc: [
		"Once tamed, the Teddy will assist you by attacking with the &avoodoo effect&r, causing needles to shoot from nearby affected entities and pierce them. "
		""
		"Interacting with it using an &bEternal Lighter&r will transform it into its &aflying version&r, that circles around its enemies and rams them to deal bigger damage! "
		""
		"If it takes a heavy hit while attacking, it will teleport to the opposite side of the target."
	]
	quest.720B88C548B6CBAE.quest_subtitle: "Cute (?) companion!"
	quest.720B88C548B6CBAE.title: "The Teddy"
	quest.721F10FDF23D55E7.quest_desc: ["Place 4 &eEnd Crystals&r, one on each side of the &dEnd Portal frame&r, to respawn the Ender Dragon."]
	quest.721F10FDF23D55E7.title: "Resurrection"
	quest.724B35F0A907851E.quest_desc: [
		"Congratulations!"
		""
		"Now that you have obtained &bether gas&r, you can access &eSupreme Machine Frames&r, which unlock the strongest machines in this mod."
	]
	quest.724B35F0A907851E.quest_subtitle: "End game tier machines now at your disposal!"
	quest.724B35F0A907851E.title: "&eGear fourth!&r"
	quest.732B6BC9525FA71E.quest_desc: ["The &eHoly Hand Grenade&r is a powerful explosive that deals heavy damage to mobs &dwithout destroying blocks&r. "]
	quest.733D2301E53DD13E.quest_desc: [
		"If you travel through the &bDesert&r, you may be able to find &eAntlions&r!"
		""
		"These creatures will &aburrow&r underground and attack you by spitting sand if you aren't careful. However, they can be tamed by apporaching them from behind &awithout being seen&r, and feeding them &bCrystallized Blood&r."
		""
		"Once they are tamed, you will see that they &acycle&r through different forms during the day, each form having a different trait. Have fun finding out what can they do! And make sure to use an &bHourglass&r to prevent it from changing if you find one that you like."
	]
	quest.733D2301E53DD13E.quest_subtitle: "A companion from the sands!"
	quest.733D2301E53DD13E.title: "The Antlion"
	quest.741951ABB0E42814.quest_desc: [
		"The &dCapacitor Bank&r stores and distributes &aForge Energy&r (FE), acting as a buffer between &bpower sources&r and &emachines&r. It allows you to store excess energy and release it when needed."
		"{@pagebreak}"
		"Multiple banks can be connected to increase storage capacity, making it a scalable solution for power management and automation."
	]
	quest.741951ABB0E42814.quest_subtitle: "Energy supply!"
	quest.746506B7F2A522ED.quest_subtitle: "Submit items"
	quest.746506B7F2A522ED.title: "Ender Trade"
	quest.75AD72FC4F81F13F.quest_desc: ["Using &bGrains of Infinity&r and &bIron&r can make the &eVoid Chassis&r that will be required for powered machines."]
	quest.75AD72FC4F81F13F.quest_subtitle: "Empty so far"
	quest.75D261FEED10D594.quest_desc: [
		"With new resources in our grasp, we advanced in ways we had never imagined."
		""
		"Some among us devoted themselves to the study of Redstone Flux, creating machines that could automate our work and reshape the land itself.  "
		""
		"Others turned to magic, unlocking enchantments that allowed us to bend reality to our will.  "
		"{@pagebreak}"
		"&6Believing no limit remained, we undertook our boldest experiment.&r  "
		"Using soul-infused Nether materials, we tried to create a guardian to defend us.  "
		""
		"&cInstead, we created the Wither.&r  "
		"{@pagebreak}"
		"It was not a protector. It was destruction.  "
		"&cIt reduced our cities to rubble and blackened the skies.&r  "
		"We fought against it, but nothing we did could stop the devastation in time.  "
		"{@pagebreak}"
		"In the wake of this disaster, our people broke apart.  "
		"Some chose to abandon the path of progress, retreating into a life of simplicity, focusing on farming, trade, and rebuilding what was lost.  "
		"{@pagebreak}"
		"These people became the Villagers. They sealed themselves away in their towns, turning away from the ambition that had nearly destroyed us.  "
		"{@pagebreak}"
		"&6The rest of us refused to stop, not out of pride, but fear.&r  "
		"If we had created such a monster by mistake, what else might be waiting beyond our world?  "
		"We had to be ready. We had to be stronger by then.  "
	]
	quest.75D261FEED10D594.title: "Losing Control"
	quest.7634C199DDBA5A83.quest_subtitle: "&dUraninite Ore Geodes&r are found in the Nether and serve as a rich source of this radioactive ore."
	quest.7634C199DDBA5A83.title: "Uraninite"
	quest.76B286AB8729FA65.quest_desc: [
		"I write these words as the land around me fractures by forces we never fully understood."
		""
		"&6The world we once shaped with our own hands is breaking, the echoes of our greatest mistakes shaking its foundations. &r "
		""
		"I do not know if anyone will find these notes."
		"{@pagebreak}"
		"I do not know if anyone will be left to read it.  "
		""
		"&cBut if you do, let this be a warning.&r"
		""
		"&6Let it tell the tale of the rise and fall of the Builders, the first civilization, the masters of dimensions, and the ones who doomed their own home.&r"
	]
	quest.76B286AB8729FA65.title: "Emergency"
	quest.76BFA78823D646BD.quest_desc: ["When equipped, a wildfire crown will grant &b1 armor point&r, &b1 armour toughness&r point and &b1 knockback resistance&r and &cFire Resistance&r for 8 seconds, which starts expiring each time the player is in lava or on fire."]
	quest.76BFA78823D646BD.title: "&cKing of the Nether"
	quest.77D4CB061D1132CC.quest_desc: [
		"&dEnderIO&r modifies vanilla spawners, allowing them to drop &bBroken Spawners&r when broken, without requiring Silk Touch.  "
		"{@pagebreak}"
		"These can be used to craft a &dPowered Spawner&r, which consumes &aForge Energy&r (FE) to spawn entities based on the stored spawner type."
		"The attached &bCapacitor&r affects both its energy capacity and spawn speed."
	]
	quest.77D4CB061D1132CC.quest_subtitle: "Ore Creeper farming?"
	quest.77D4CB061D1132CC.title: "Controlling the Spawner"
	quest.77DD662BB530819D.quest_desc: [
		"The &eOtherside portal&r is the entrypoint to the Otherside."
		""
		"It follows the same shape as the nether portal, but has a minimum height of 2 instead of 3 by default, along with being composed of reinforced deepslate."
		""
		"Unlit Otherside portals can be found in the center of an &bancient city&r and in &bancient temples&r."
	]
	quest.77DD662BB530819D.quest_subtitle: "The Otherside dimension is the only place to find Draconium Ore and Draconium Geodes."
	quest.77DD662BB530819D.title: "Otherside?"
	quest.7830A686E4567D6D.quest_subtitle: "A grappling hook for reaching high places quickly."
	quest.78DD045B46A1228A.quest_desc: [
		"When your Great Chalice is filled with essence, you will need another &egrail&r to pick it up."
		""
		"This will be used with &bother materials&r to create a &eHomunculus&r, which is a key component to make your very first companion!"
	]
	quest.78DD045B46A1228A.quest_subtitle: "Oh that's a smaller one."
	quest.78DD045B46A1228A.title: "Creating... life?"
	quest.78EA6CFECECD333B.quest_desc: ["Smelt &bRotten Flesh&r into &eLeather&r using a Furnace, or use a Smoker for &nfaster results&r."]
	quest.78EA6CFECECD333B.title: "Cow approved!"
	quest.78FE2E5C7B704D59.quest_desc: [
		"Our experiments with natural elements led to the discovery of something unbelievable.  "
		""
		"&6We created a portal, a swirling vortex that defied the laws of our world.&r  "
		""
		"Beyond it lay a place we called the Nether, a realm of endless fire and suffering.  "
		"{@pagebreak}"
		"The very air burned our lungs, and the land itself was hostile.  "
		"Rivers of lava stretched for miles, and creatures of flame and fury roamed freely.  "
		""
		"Among them were the Piglins, fierce traders and warriors who valued gold above all else.  "
		"{@pagebreak}"
		"We feared them at first, but over time, we learned their ways, exchanging resources and knowledge.  "
		""
		"The Nether was cruel, but it was also rich with power. &6Each discovery only fueled our hunger for more.&r  "
	]
	quest.78FE2E5C7B704D59.title: "Interdimensional Exploration"
	quest.79B714137BFDCF15.quest_desc: [
		"The &dInterdiction Torch&r pushes back &bhostile mobs&r in a large radius, preventing them from getting close."
		"{@pagebreak}"
		"It doesn’t deal damage but creates a safe zone, making it useful for base defense or protecting automation setups."
	]
	quest.79CB48D88FD66DD8.quest_desc: [
		"Now that you know the basics about &bmachines, fluids and power&r, it's time to make an upgrade."
		""
		"&eSimple machine frames&r can be used for more advanced tools and gadgets. Get ready!"
	]
	quest.79CB48D88FD66DD8.quest_subtitle: "Unlocking a new tier of machinery."
	quest.79CB48D88FD66DD8.title: "&bGear second!&r"
	quest.7ABCCD7E48401913.quest_desc: ["&4The Nether&r remains mostly unchanged but now features new structures and ore geodes."]
	quest.7ABCCD7E48401913.title: "&dNether Gonna Give You Up&r"
	quest.7AE36372E86B4C40.quest_desc: [
		"Reliquary adds its own way to craft &apotions&r."
		""
		"Combine materials in an &bApothecary Mortar&r to create &ePotion Essence&r. Mix that with &bNether Wart&r in an &bApothecary Cauldron&r to brew &epotions&r."
		"{@pagebreak}"
		"A wide variety of &dnew potion recipes&r are available, so make sure to try them out."
	]
	quest.7AE36372E86B4C40.quest_subtitle: "A different way to brew"
	quest.7AE36372E86B4C40.title: "Crafting potions"
	quest.7AF34FBFE7DFB406.quest_desc: ["Stores &cenergy&r for your &eFlux Network&r."]
	quest.7BCCBB127E66B6B8.title: "Blast' Smoke"
	quest.7C195FB479BD0E5A.quest_desc: [
		"To get the &dHero of the Village&r advancement in Minecraft, you need to successfully &bdefend a village during a Raid&r by defeating all waves of raiding mobs."
		""
		""
		"{@pagebreak}"
		""
		"&eHeroes of the Village (Community)&r"
		""
		"Ever wondered about the unique &9purple role on Discord&r and special capes?"
		""
		"It’s assigned to those members who make &eexceptional contributions&r to the &dBeyond Mines community&r, such as assisting other players, sharing or writing articles on the official Forum, or supporting the project through donations."
	]
	quest.7C195FB479BD0E5A.title: "&eHero of the Village&r"
	quest.7C3E2FAB42770B83.quest_subtitle: "Can be obtained by smelting down any unique weapon."
	quest.7CC82A2E3958EB13.quest_desc: ["A &dCitadel&r is a huge nether structure similar to the fortress. A Wildfire mob can be found inside."]
	quest.7D26C4D7D00A70DE.quest_desc: [
		"The &dDark Steel Ladder&r is a faster and sturdier alternative to regular ladders."
		""
		"Craft it using &bDark Steel Ingots&r."
	]
	quest.7D41BBA275CBC3E1.quest_desc: [
		"Once you get your &bMob Slaughter Factory&r working, you will start producing &ePink Slime&r."
		""
		"This fluid is required to advance into the &anext tier&r of machinery. Pick some of this material using a &bbucket&r to complete this task."
	]
	quest.7D41BBA275CBC3E1.quest_subtitle: "Sticky situation we got here."
	quest.7D41BBA275CBC3E1.title: "Pink Slime"
	quest.7D493C27CE650E91.title: "&dNetherite"
	quest.7D4A3FCDB911711A.quest_subtitle: "Grants you the chance to get mob heads"
	quest.7E147B3AF403B30E.quest_desc: [
		"The &eStirling Generator&r is your first power source in &dEnderIO&r. It runs on &bcombustible fuel&r like coal to generate &aForge Energy&r (FE)."
		""
		"Connect it to machines like the &eAlloy Smelter&r to power your automation."
		""
		"Upgrade it later for improved efficiency and output!"
	]
	quest.7E147B3AF403B30E.quest_subtitle: "Forge Energy"
	quest.7E147B3AF403B30E.title: "Generating Power"
	quest.7E4FEAA0EBB2CE96.quest_desc: ["Imbuing your Netherite Gear with materials from the Sacred Pontiff will apply a weaker damage reduction effect than its bloody counterpart, but will also give a chance to summon fire rings to fend off attackers!"]
	quest.7E4FEAA0EBB2CE96.quest_subtitle: "Protected by divine fire"
	quest.7E4FEAA0EBB2CE96.title: "Holy gear"
	quest.7ED2E294D0149887.quest_subtitle: "Required for Multiblock machines"
	quest.7F557D82F7221635.quest_desc: [
		"&e&lFlux Plug&r&r"
		"Takes energy from your power source, and add it to your &dFlux Network&r."
		""
		"&e&lFlux Point&r&r"
		"Provides Energy&r to connected Blocks."
	]
	quest.7F557D82F7221635.title: "Interdimensional Energy"
