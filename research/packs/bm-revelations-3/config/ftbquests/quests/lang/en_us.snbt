	quest.496EC3753286D05D.title: "Powered Alloy Smelter"
	quest.4977EE7AAF78907F.quest_subtitle: "Thats enough Layers!"
	quest.4A432495FB7B7C18.quest_desc: [
		"&dPedestal&r activates the item it displays when powered by &cRedstone.&r This allows for automation setups like mob farms using &eSwords&r or XP collection with the &eCoin of Fortune&r."
		"{@pagebreak}"
		"Items can be inserted or extracted with &bitem conduits&r and &bhoppers&r, making it a flexible part of any system."
	]
	quest.4A432495FB7B7C18.quest_subtitle: "Guess it wasn't just decoration"
	quest.4A432495FB7B7C18.title: "Automating with pedestals"
	quest.4AC21531ED608A74.quest_desc: [
		"&eFluid Conduits&r are made with &bClear Glass&r, which is the result of further smelting&b Glass&r in the Alloy Smelter."
		""
