{
	quest.00B243B328CD85B4.quest_desc: [
		"The foundry specializes in creating&e all the alloys&r needed to make &eOritech machines&r."
		""
		"Some of these alloys can be &bcrafted by hand&r, doing so consumes &csignificantly more resources&r."
	]
	quest.00B243B328CD85B4.quest_subtitle: "Multiblock - requires &e3&r &dMachine Cores&r!"
	quest.0FFF66188456E4AA.quest_desc: ["&dDuratium&r is a high-tier alloy used to create particle accelerators and reactors."]
	quest.0FFF66188456E4AA.quest_subtitle: "A very dense Material"
	quest.12536C2280D7B11A.quest_desc: [
		"&bNickel&r is crucial for several &emachine&r and &ealloy recipes&r."
		""
		"Also mine redstone, gold, and some diamonds, and watch for amethyst geodes for budding amethyst needed later for &dfluxite production&r."
	]
	quest.12536C2280D7B11A.quest_subtitle: "Work in progress"
	quest.12536C2280D7B11A.title: "Getting started"
	quest.1357DE16AB051E9C.quest_desc: [
		"&bMachine cores&r determine the quality of &eOritech multiblock machines&r."
		""
		"Their main purpose is to increase how many &elayers of extenders&r and &econnected addons&r a machine can support."
	]
	quest.1357DE16AB051E9C.quest_subtitle: "Required for Multiblock machines"
	quest.1357DE16AB051E9C.title: "Cores for Multiblocks"
	quest.144F75EA01366D8E.quest_desc: [
		"The &dPrometheum Pickaxe&r is an unbreakable high-tier mining tool."
		"It has very high mining speed and can switch between area mining and &dsilk touch&r harvesting."
		"{@pagebreak}"
		"It can be enchanted with standard pickaxe enchantments like Efficiency and Fortune."
		""
		"Note that Silk Touch is provided natively by its secondary mode."
	]
	quest.17E7F0F0AD1D469A.quest_desc: [
		"The &dMachine Addon Extender&r is used to increase the number of available &eaddon slots&r for a machine."
		""
		"By itself, it does not provide any bonuses, but it lets you place &nmore&r addons than the &bmachine's base quality&r would normally allow."
	]
	quest.18EC56703A424463.quest_desc: [
		"The &ePowered Furnace&r is a modern replacement for the traditional stone furnace."
		""
		"It uses &bRF energy&r to smelt items at a much higher speed and efficiency."
	]
	quest.18EC56703A424463.quest_subtitle: "Multiblock - requires &e1&r &dMachine Core&r!"
	quest.192DFFEC831DF27D.quest_subtitle: "Required for Multiblock machines"
	quest.20CC5B11C8E11426.quest_desc: ["The &dAtomic Forge&r is a machine used to create &eadvanced computer chips&r, &ereinforce deepslate&r, and help with high-yield ore processing."]
	quest.26003A59449EAE28.quest_desc: ["A standard &belectric motor&r used to drive mechanical parts in &eindustrial machines&r."]
	quest.26003A59449EAE28.quest_subtitle: "Crafting Ingredients"
	quest.27B10C68B9463181.quest_desc: [
		"&dAdamant&r is a basic alloy used to create the &dAssembler&r, &dSteam Engine&r, machine cores, and various components and tools."
		""
		"The &dFoundry&r can produce more &eadamant&r with &bfewer diamonds&r and &bnickel&r."
	]
	quest.27B10C68B9463181.quest_subtitle: "Very hard but brittle, and it is partly see-through!"
	quest.2C4C988FCF67BDC1.quest_subtitle: "Required for Multiblock machines"
	quest.2E9B5E7158B6A077.quest_desc: [
		"It uses normal &bfurnace fuels&r and produces &e32 RF/t&r, enough to run your first processing machines."
		""
		"Once online, a &dPowered Furnace&r is a good first convenience upgrade."
	]
	quest.330A59FF8E2209E9.quest_desc: [
		"Oritech includes an &dOracle Index&r &eingame documentation&r."
		""
		"Hover your mouse over a supported Oritech item (e.g., a machine) and hold the &bALT&r key to open the ingame index."
	]
	quest.330A59FF8E2209E9.quest_subtitle: "Official ingame documentation"
	quest.331B544251B0E40B.quest_desc: [
		"When placed adjacent to a &bpipe extraction point&r and &bpowered with RF&r, it massively &eincreases the speed&r at which items and fluids are pulled."
		"{@pagebreak}"
		"&l&dItem Pipes&r&r:"
		"Accelerates the extraction rate to one full stack every tick."
		""
		"&l&dFluid Pipes&r&r:"
		"Increases the throughput up to 50 buckets per tick."
	]
	quest.331B544251B0E40B.quest_subtitle: "Place at Extracting Pipe point"
	quest.3444B89BFA912A2A.quest_desc: [
		"The assembler has a &e2x2 crafting grid&r and auto-assembles when it has &benergy&r, &binputs&r, and &boutput&r space."
		""
		"Some components can be made by hand but &dcost significantly more&r resources."
	]
	quest.3444B89BFA912A2A.quest_subtitle: "Multiblock - requires &e3&r &dMachine Cores&r!"
	quest.47EE2961FA8351FB.quest_desc: ["It can only be produced in an &dAtomic Forge&r and marks the last major step in progression."]
	quest.47EE2961FA8351FB.quest_subtitle: "&dEndgame material"
	quest.514FA3553B50E276.quest_desc: ["The &dTarget Designator&r sets &nonly a direction&r, not a specific block, and the beam will attempt to destroy all blocks along that line."]
	quest.60162F65CC931928.quest_desc: [
		"The pulverizer is a slow and simple block that crushes &bores&r and &bbiomass&r into &edust&r."
		""
		"It gives a &dbetter yield&r than directly smelting raw ores."
	]
	quest.60162F65CC931928.quest_subtitle: "Improves ore processing efficiency"
	quest.61EDC774EFC0259E.quest_desc: [
		"&6Oritech&r features new &emultiblock machines&r that allow you to process and harvet resources, or produce energy."
		""
		"Create Multiblocks out of the &binitial machine&r block and fill it with &dMachine Cores&r."
	]
	quest.62C71546F94CA482.quest_desc: [
		"The centrifuge can be used to &eextract ore dusts&r from &bore clumps&r obtained from a &dFragment Forge&r."
		""
		"Spin coal dust into carbon fiber strands, or process various liquids."
	]
	quest.62C71546F94CA482.quest_subtitle: "Multiblock - requires &e1&r &dMachine Core&r!"
	quest.64B4366D220DC2D1.quest_desc: [
		"The &ePrometheum Battleaxe&r is an unbreakable multi-purpose harvesting tool."
		""
		"It works as a strong axe for stripping wood and attacking enemies, and it can also fell entire trees in one action."
		"{@pagebreak}"
		"It can be enchanted with standard axe enchantments like Efficiency, Sharpness, and Fortune."
	]
	quest.64CB066E84D2E8BD.quest_desc: [
		"Directing an &dEnderic Laser&r at &bamethyst clusters&r will transform them into &efluxite&r when mined."
		""
		"Fluxite is a key component for &eadvanced machines&r, &eEnergite&r and managing energy flow."
	]
	quest.68CCE16C6869D299.quest_subtitle: "Required for Multiblock machines"
	quest.68D2399A29D11DD6.quest_desc: [
		"The &bEnderic Laser&r consumes large amounts of &aenergy&r to fire a long-range beam that is used for &erapid mining&r or &elong-distance power transfer&r."
		""
		"Use a &dtarget designator&r on the laser block to set the firing direction."
		""
		"{@pagebreak}"
		"The laser can reach up to 128 blocks and will continue firing until obstructed or disabled by a &credstone signal&r."
	]
	quest.68D2399A29D11DD6.quest_subtitle: "Multiblock - requires &e1&r &dMachine Core&r!"
	quest.6B4F4F3AD82EA53A.quest_desc: ["A large multiblock that generates &apower&r from &bsunlight&r. "]
	quest.6B4F4F3AD82EA53A.quest_subtitle: "Multiblock - requires &e3&r &dMachine Cores&r!"
	quest.6D54CD172925504C.quest_desc: [
		"&bHigh-end energy cable&r for &every large RF transfer&r."
		""
		"Default transfer rate is 4.1M RF/t."
	]
	quest.6EA65D9BD1E07A99.quest_subtitle: "Required for Multiblock machines"
	quest.7145C6EC27D67761.quest_desc: [
		"If you right-click an incomplete Machine such as your first &dAssembler&r, it outlines where you have to place &bMachine Cores.&r"
		""
		"If you have &bMachine Cores&r in your Inventory, click the &einitial Machine block&r, to automatically place the Machine Cores at the proper location."
	]
