	file.0000000000000001.title: "&bEndless Sky 2"
	quest.0205FAA6702C830C.quest_desc: [
		"&e(&a!&e) &bSo now that you have &cDirt &byou can now aqcuire &cStone &b+ &cStone Variants&b!"
		""
		"&e(&a!&e) &bSimply &cShift-Right Click Dirt &band it will spit out all types of pebbles!"
	]
	quest.156E2E3915698AB4.quest_desc: [
		"&e[&f!&e] &fThink of it like the mod Baubles, allowing you to equip certain items to maybe gain abilities or to equip backpacks, etc."
		" "
		"You will notice while playing that some items have a tooltip displaying that they can be equipped in the Curios Menu."
		" "
		"&e[&f!&e] &fThe Curios GUI menu can be access by clicking the Coin like icon top left in your inventory. Next to your character."
	]
	quest.156E2E3915698AB4.title: "&bCurios"
	quest.1600E5CC5BC30CEC.quest_desc: ["&e(&a!&e) &cProject Table &bis the best friend before you get to advanced storage systems!"]
	quest.1AA49930E91CD04B.title: "Productive Metalworks Upgrade"
	quest.1E8B9F4449BEE57F.title: "Barrel"
	quest.23FBB20BDD5EDBBD.title: "Botany Pots"
	quest.28F81909D0D71A9D.quest_desc: ["&e(&a!&e) &bIt's time to crook some leaves! and hopefully get a &cSilkworm"]
	quest.362BCE3E9575463F.quest_desc: [
		"&e[&f!&e] &fIn this pack FTBTeams is inside which will allow you to make teams and share quests!"
		""
		"To make a team you just press this button in your inventory! &e[&fIt's located in the top left of your inventory!&e]"
		"{image:ftbteams:textures/teams.png width:50 height:50 align:center}"
		"&e[&f!&e] &fThis button will also allow you to invite other players or join other players parties!"
	]
	quest.362BCE3E9575463F.title: "&bFTB Teams"
	quest.42486A3D42031B09.quest_desc: ["&e(&a!&e) &bSo it's time for the first &cPower &byou will obtain the &cClicking Generator&b!"]
	quest.47D2DA84289F5451.quest_desc: [
		"&e(&a!&e) &bSo to use the &cCrushing Basin &bsimply &cRight Click &bwith your hand on the &cCrushing Basin &bwith &cIron Berries&b in you hand!"
		""
		"&e(&a!&e) &bAfter putting the &cIron Berries &bin the &cCrushing Basin&b simply stand ontop of it and &cJump &blike your life depends on it!"
	]
	quest.4D5B754A959FDDA9.quest_desc: [
		"&e[&f!&e] &fEver found a specific sound that is annoying you?"
		" "
		"Simply head into your inventory and click the Muffle button top right of your character render."
		" "
		"When you've clicked it a GUI will open up and a list of recently played sounds will be displayed. Just left click the one you want to mute and then you're golden! &e(&cClick again to unmute.&e)"
	]
	quest.4D5B754A959FDDA9.title: "&bSound Muffler"
	quest.514ECD021EDF0591.quest_desc: [
		"&e[&f!&e] &fYou will notice when you open a Crafting Table or similar (if supported) that there'll be 3 new buttons on the left side of the grid."
		" "
		"These buttons can be handy for either rotating around a recipe, or clearing the crafting grid fast."
		" "
		"&e[&f!&e] &fThere's also a button to evenly split a stack into every slot."
		" "
		"Give them a try!"
		" "
	]
	quest.514ECD021EDF0591.title: "&bCraft Tweaker"
	quest.5588A5EE5DEAEDC3.quest_desc: [
		"&e[&f!&e] &fQuests usually have &eRandom Loot&f or &eExperience&f as Rewards "
		" "
		"The &eLoot Loot&f can vary a lot, maybe you'll end up getting something &ereally nice,&f &oooor&r, something &eless valuable."
		" "
		"&e[&f!&e] Note: &fMods are not gated by quests. Quests are optional. It just shows how to get to the end easier."
	]
	quest.5588A5EE5DEAEDC3.title: "&bFTB Quests"
	quest.5703BB43D271C5B5.quest_desc: [
		"&e[&f!&e] &fYou're able to claim chunks to protect your base(s). Just click the map icon that is located top left in your inventory."
		" "
		"This will bring up a fullscreen map, but this isn't the map we're looking for. Click the map again top left corner."
		" "
		"&e[&f!&e] &fHere you can freely claim available chunks by just drawing on the map with your mouse. (Left click and drag.)"
		" "
		"To unclaim a chunk you do the opposite, just draw but hold 'Right Click' instead."
		" "
		"&e[&f!&e] &e[&f!&e] &f(To Chunkload a Chunk you do as explained above but now you need to hold down 'LSHIFT' while dragging over an existing claimed chunk.)"
	]
	quest.5703BB43D271C5B5.title: "&bChunk Claiming"
	quest.57C0E0C9F76BFB76.quest_desc: [
		"&e[&f!&e] &fIn this pack in order to &eCreate/Join &fanother players Skyblock you need to do a couple commands!"
		""
		"&e[&f!&e] &fTo make a Skyblock do the following &e/skyblock create [name of the island can be whatever no spaces]"
		""
		"&e[&f!&e] &fTo invite someone too your skyblock do &e/skyblock invite [player]"
	]
	quest.57C0E0C9F76BFB76.title: "&bSkyblock Team"
	quest.67B351A0FDB2F34E.quest_desc: [
		"&e[&f!&e] &fBe sure to take advantage of the Trash Slot in your inventory."
		" "
		"The Trash Slot is really handy if you just need to get rid of items while in a hurry, or just cleaing up."
		" "
		"&e[&f!&e] &fThe Trash Slot can be found in the bottom right in your inventory"
	]
	quest.67B351A0FDB2F34E.title: "&bTrash Slot"
	quest.681ECAC220F6A1D5.quest_desc: ["&bLike usual it's time to harvest some bloody wood!"]
	quest.6A2B3304B03DDFE8.quest_desc: ["&e(&a!&e) &bNow that you have managed to get a hold of pebbles make some cobblestone!"]
