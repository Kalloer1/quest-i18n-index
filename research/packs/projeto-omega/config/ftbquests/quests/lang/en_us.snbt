{
	chapter.1A10000000000001.chapter_subtitle: ["Industrialize experience and enchanting by turning XP into fluid and automating processes that used to be manual."]
	chapter.1A10000000000001.title: "Create: Enchantment Industry"
	chapter.1B10000000000001.chapter_subtitle: ["Advanced transmission, overstress protection, programmable redstone and precise control for larger Create networks."]
	chapter.1B10000000000001.title: "Create: Connected"
	chapter.1C10000000000001.chapter_subtitle: ["Foundry work, machining and artillery: turn metal into industrial cannons with Create infrastructure."]
	chapter.1C10000000000001.title: "Create Big Cannons — Artillery"
	chapter.3560539F856E388A.chapter_subtitle: ["Mixing, airflow, tools, brass, logistics and industrial processing turn a simple workshop into a versatile production floor."]
	chapter.3560539F856E388A.title: "Create II — Mechanical Workshop"
	chapter.387603D60CCD32BC.chapter_subtitle: ["From motion to electricity: turn your factory into an electromechanical industry."]
	chapter.387603D60CCD32BC.title: "Create: New Age"
	chapter.4560539F856E388A.chapter_subtitle: ["The factory matures: important technologies must be understood, automated and proven in continuous production before they feed the next stage."]
	chapter.4560539F856E388A.title: "Create III — The Factory"
	chapter.546BC07BE7CCAF75.chapter_subtitle: ["Your interactive course in engineering, automation and technological progression."]
	chapter.546BC07BE7CCAF75.title: "Welcome"
	chapter.5560539F856E388A.chapter_subtitle: ["Requests, packages, stock control and trains turn an isolated factory into an industrial network."]
	chapter.5560539F856E388A.title: "Create IV — Industrial Logistics"
	chapter.561CB01B35476D75.chapter_subtitle: ["Essential vanilla resources that prepare the way into Create without turning the book into a basic Minecraft tutorial."]
	chapter.561CB01B35476D75.title: "First Steps"
	chapter.5A10000000000001.chapter_subtitle: ["From the first hive to an industrial apiary: capture, breed and process bees into renewable factory resources."]
	chapter.5A10000000000001.title: "Productive Bees"
	chapter.5B00000000000001.chapter_subtitle: ["Industrial flight progression: Create, Mekanism hydrogen and late-game Mystical flight."]
	chapter.5B00000000000001.title: "Propulsion \\& Flight"
	chapter.5B10000000000001.chapter_subtitle: ["Agricultural automation integrated into Create infrastructure."]
	chapter.5B10000000000001.title: "Create Integrated Farming"
	chapter.5C00000000000001.chapter_subtitle: ["The Create factory opens the digital age and turns AE2 processors into industrial products."]
	chapter.5C00000000000001.title: "Applied Energistics 2 — Processors"
	chapter.5D00000000000001.chapter_subtitle: ["The main line uses Mekanism for power and infrastructure manufactured through Create. Tools, QIO, the Digital Miner and other advanced technologies are optional side routes rather than Project Omega requirements."]
	chapter.5D00000000000001.title: "Mekanism — First Electrical Age"
	chapter.5E00000000000001.chapter_subtitle: ["Sensors, actuators and tunnels begin turning inventories and machines into information that can be controlled."]
	chapter.5E00000000000001.title: "Integrated Dynamics — Industrial Logic"
	chapter.5F00000000000001.chapter_subtitle: ["Grow resources from mystical seeds and essences."]
	chapter.5F00000000000001.title: "Mystical Agriculture"
	chapter.6A00000000000001.chapter_subtitle: ["The bridge between Create and FE: motors, alternators, wires and storage connect electricity to rotation."]
	chapter.6A00000000000001.title: "Create Crafts \\& Additions Electromechanics"
	chapter.6C10000000000001.chapter_subtitle: ["Affixes, gems, salvaging, reforging and enchanting under controlled progression. High power is intended; absurd levels beyond pack caps are not."]
	chapter.6C10000000000001.title: "Apotheosis — Arcane Forge"
	chapter.6D10000000000001.chapter_subtitle: ["Industry opens the path to exploration and combat. Defeat threats, bring relics back to the factory, and prepare the materials that feed the Omega Age."]
	chapter.6D10000000000001.title: "Age of Titans"
	chapter.7721BF8F8A0D1F5C.chapter_subtitle: ["From Andesite Alloy to your first automated pressing line, learning rotation, transmission, control and transport."]
	chapter.7721BF8F8A0D1F5C.title: "Create I — First Motions"
	chapter.775A728C8474C51E.chapter_subtitle: ["From track to logistics: build trains, stations, signaling and industrial railway routes."]
	chapter.775A728C8474C51E.title: "Create: Steam 'n' Rails — Railways"
	chapter.79B941FCF6DEA109.chapter_subtitle: ["Fuels, engines and petrochemistry: turn raw materials into Create rotation."]
	chapter.79B941FCF6DEA109.title: "Create: Diesel Generators"
	chapter.7B10000000000001.chapter_subtitle: ["The Omega Age begins after industry and the Titans: eight Cores converge into the Omega Star factory; from it come the permanent Heart and the Creative Era."]
	chapter.7B10000000000001.title: "Project Omega — Ascension"
	chapter.7C10000000000001.chapter_subtitle: ["A showcase of the main armor sets, tools and weapons available. Quests are independent: use the gear that fits your build. Only Omega equipment uses a special multi-mod synthesis."]
	chapter.7C10000000000001.title: "Modpack Arsenal"
	chapter.7D10000000000001.chapter_subtitle: ["Server post-game: the Omega Star becomes a trade token and the Omega Heart proves final progression completion. Creative items are exclusive to the official shop."]
	chapter.7D10000000000001.title: "Creative Era"
	chapter.7E10000000000001.chapter_subtitle: ["Turn mobs, drops and experience into an automated Create line without turning spawners into free shortcuts."]
	chapter.7E10000000000001.title: "Industrial Mob Farm \\& XP"
	chapter_group.2D6B2D85F4B6B079.title: "WELCOME"
	chapter_group.5A00000000000001.title: "CREATE — ADVANCED ENGINEERING"
	chapter_group.5A00000000000002.title: "TECHNOLOGY"
	chapter_group.5A00000000000003.title: "RESOURCES"
	chapter_group.66D3BBBABB5BFD56.title: "MAIN PROGRESSION"
	chapter_group.6D00000000000001.title: "AGE OF TITANS"
	chapter_group.7B00000000000001.title: "PROJECT OMEGA"
	chapter_group.7C00000000000001.title: "ARSENAL \\& EQUIPMENT"
	quest.1000000000000001.quest_desc: [
		"Thank you for installing and playing this modpack. Create is the backbone of the progression: you will begin with simple mechanisms and gradually turn resources, transport, and production into truly automated systems."
		"This Quest Book is designed as an interactive course, not a checklist. Read the descriptions, complete the suggested tests, and treat the food reward as a small welcome gift — no important technology will be handed to you for free."
	]
	quest.1000000000000001.title: "Welcome — and Thank You!"
	quest.1000000000000002.quest_desc: [
		"JEI is your main reference for recipes. When you search for an item, use the keys and buttons shown by the interface to see how it is crafted and which processes can use it."
		"In this modpack, recipes may change because of mod integrations or future balance adjustments. This book explains processes and machine roles, while JEI should be used for exact ingredients and quantities. Open a recipe in JEI before completing this step."
	]
	quest.1000000000000002.title: "JEI: Your Recipe Workbench"
	quest.1000000000000003.quest_desc: [
		"Ponder is Create's visual documentation. On compatible components, use the key shown by the game to open an animated demonstration of assembly, movement direction, and operation."
		"It is especially useful for machines, kinetic transmission, fluids, trains, and less intuitive processes. Open at least one demonstration now; whenever a machine becomes confusing later, return to Ponder."
	]
	quest.1000000000000003.title: "Ponder: Learn by Watching"
	quest.1000000000000004.quest_desc: [
		"The lines between quests represent real dependencies: a step only appears after you have learned or obtained what is needed to perform it. The main path drives technological progression, while optional branches teach upgrades and tools without blocking advancement."
		"Item quests complete when FTB Quests detects the requested resource. Checkmarks are reserved for actions that must be performed in the world, such as testing a machine, building a production line, or confirming that you understand a system."
	]
	quest.1000000000000004.title: "Read the Quest Tree"
	quest.1000000000000005.quest_desc: [
		"Choose a well-lit area for your workshop and leave room around your crafting and storage area. Create machines need space for Shafts, Cogwheels, Belts, rotational sources, and future input and output lines."
		"Your factory does not need to look beautiful yet; just avoid cramming everything into one corner. Once you have enough room to expand without dismantling every previous step, confirm this quest to begin the foundation."
	]
	quest.1000000000000005.title: "Room to Grow"
	quest.1100000000000001.quest_desc: [
		"Wood remains the foundation of the manual phase: it provides planks, tools, and many components that will stay useful even after machines arrive."
		"Gather the logs requested by the quest. We are not turning the book into a full Vanilla Minecraft tutorial; the goal is simply to secure the resources needed to enter Create without interrupting progression."
	]
	quest.1100000000000001.title: "Your First Wood"
	quest.1100000000000002.quest_desc: [
		"The Crafting Table will be the center of your first recipes before the workshop gains mechanical processing. Use the wood you just gathered to craft one."
		"Even after machines and autocrafting appear, the table will remain useful for simple components. For now, it opens the path to stone tools and the preparation of your base."
	]
	quest.1100000000000002.title: "Your Crafting Table"
	quest.1100000000000003.quest_desc: [
		"Cobblestone provides the first durable tools and the Furnace we will use to prepare metals. Gather a small reserve now so you do not have to interrupt the sequence for every recipe."
		"The next step is a Stone Pickaxe, enough to reach the basic ores that will feed the beginning of the workshop."
	]
	quest.1100000000000003.title: "A Stone Foundation"
	quest.1100000000000004.quest_desc: [
		"The Stone Pickaxe is the bridge between early gathering and metalworking. With it, you can begin collecting important resources such as iron and copper, which will appear throughout almost the entire technological progression."
		"Craft the tool with the resources you just gathered and begin exploring underground. There is no need to stockpile huge amounts yet; much of this work will be automated later."
	]
	quest.1100000000000004.title: "Stone Pickaxe"
	quest.1100000000000005.quest_desc: [
		"The Furnace introduces your first form of processing: turning raw resources into usable materials. It will remain the simple solution until Create machines begin taking over part of this work."
		"Craft one using the cobblestone you collected. For fuels and specific recipes, check JEI, since it always shows the options actually available in this modpack."
	]
	quest.1100000000000005.title: "Heat for the Ores"
	quest.1100000000000006.quest_desc: [
		"Iron is one of the most important resources in this phase. It is used in tools, redstone components, and many parts required to build your first Create machines."
		"Obtain and process iron until you have the requested ingots. Keep the excess: soon, part of it will become nuggets, tools, and mechanical components."
	]
	quest.1100000000000006.title: "Your First Iron"
	quest.1100000000000007.quest_desc: [
		"With an Iron Pickaxe, your gathering is no longer limited to the most basic materials. It also gives you access to redstone, which will later be needed to control rotational networks."
		"Craft it using the iron from the previous step. It will be your main tool while the workshop still lacks Drills, Saws, and other automated solutions."
	]
	quest.1100000000000007.title: "Iron Pickaxe"
	quest.1100000000000008.quest_desc: [
		"Redstone will not be used only for vanilla circuitry. In Create, it can also control components that stop or reverse sections of a mechanical transmission."
		"Gather the requested amount with your Iron Pickaxe. Later, the Clutch and Gearshift will show why a factory needs not only movement, but also control."
	]
	quest.1100000000000008.title: "A Control Signal"
	quest.1100000000000009.quest_desc: [
		"Iron Nuggets are a smaller form of the metal and are used in the early progression toward Andesite Alloy. Since you already have processed iron, this step simply prepares the material in the form Create needs."
		"Convert the required amount and keep a few extra pieces. Check JEI when you reach the alloy, because the exact recipe may be changed by the modpack."
	]
	quest.1100000000000009.title: "Iron in a Smaller Form"
	quest.110000000000000A.quest_desc: [
		"Copper will be important for sheets, fluids, machines, and later technologies. Starting a small reserve now prevents you from returning to the mines every time a new production line requires this metal."
		"Obtain and process copper using the method available at this stage. Do not worry about mass production yet; the goal is simply to prepare your entry into Create."
	]
	quest.110000000000000A.title: "A Copper Reserve"
	quest.110000000000000B.quest_desc: [
		"A Chest acts as the first buffer in your workshop. Separating raw materials, intermediate parts, and finished products keeps progression from becoming a pile of items scattered across the floor."
		"Craft one and place it near your work area. Later, inventories will stop being simple storage and become active parts of automated production lines."
	]
	quest.110000000000000B.title: "A Place for Everything"
	quest.110000000000000C.quest_desc: [
		"Before entering Create, organize your Crafting Table, Furnace, and storage in a well-lit area. Separate iron, copper, redstone, and building materials, leaving free space for your first rotational network."
		"This is a building task, so it uses a checkmark. Confirm it once your base is ready to receive machines without forcing you to reorganize everything for every new quest."
	]
	quest.110000000000000C.title: "An Organized Base"
	quest.1200000000000001.quest_desc: [
		"Andesite is the mineral resource that opens the first generation of Create components. Find it in the world using the method available in the modpack and gather a small reserve."
		"The previous stage already prepared iron in a useful form. Now the two paths meet: the andesite will be turned into Andesite Alloy, the central material of the next quests."
	]
	quest.1200000000000001.title: "The Stone That Starts It All"
	quest.1200000000000002.quest_desc: [
		"Andesite Alloy is one of Create's fundamental materials. It appears in Shafts, casings, and many components that form the mechanical foundation of your first factory."
		"You already have andesite and the metal resources prepared earlier. §bJEI:§r check the installed recipe for the modpack's current recipe and make a few extra units, because you will use this alloy frequently in the next stages."
	]
	quest.1200000000000002.title: "The Alloy That Moves Everything"
	quest.1200000000000003.quest_desc: [
		"Andesite Casing is the structural shell used by many machines and components in Create's early game. It turns simple materials into a proper base for more complex mechanisms."
		"In Create, casings usually involve applying a material to an appropriate base; because recipes and interactions may vary, check JEI and Ponder for the method installed in this pack. Keep the concept in mind: later you will encounter other casing types for more advanced technologies."
	]
	quest.1200000000000003.title: "Andesite Casing"
	quest.1200000000000004.quest_desc: [
		"Now that you have Andesite Alloy, you can begin transmitting motion. A Shaft works like a mechanical axle: it carries rotation from a source to gears, machines, and other parts of the factory."
		"Craft the requested Shafts and keep any extras from the recipe. From now on, whenever a machine needs rotation from a distance, first think about how the shaft will reach it."
	]
	quest.1200000000000004.title: "Your First Shaft"
	quest.1200000000000005.quest_desc: [
		"Cogwheels connect and redirect kinetic networks. Their teeth transfer rotation between nearby shafts and can also change the orientation of movement when the layout requires it."
		"You already have Shafts to carry rotation in a straight line; now the Cogwheel begins shaping the transmission. §6Ponder:§r use the visualization to visualize possible connections before building larger networks."
	]
	quest.1200000000000005.title: "Teeth in Motion"
	quest.1200000000000006.quest_desc: [
		"A Large Cogwheel does more than take up space: when combined with smaller Cogwheels, it can change the speed ratio between parts of a transmission."
		"You do not need to memorize numbers yet. Craft one, open Ponder, and observe how gears of different sizes connect; in the next activity you will test that relationship in the world."
	]
	quest.1200000000000006.title: "A Larger Gear"
	quest.1200000000000007.quest_desc: [
		"The Hand Crank is a manual source of rotation. It is perfect for a test bench because it lets you spin a machine for a short time without building a permanent power source."
		"Connect the crank to the Shafts you already know how to craft. It is not meant to run an entire factory, but it is enough to let you feel how a kinetic network responds."
	]
	quest.1200000000000007.title: "Power by Hand"
	quest.1200000000000008.quest_desc: [
		"Set up the Hand Crank connected to at least one Shaft and turn it. Watch the direction of rotation and how the motion travels through the connected components."
		"This quest uses a checkmark because owning the part does not prove that you tested the system. Confirm it only after you have put your first kinetic network in motion."
	]
	quest.1200000000000008.title: "Your First Rotation"
	quest.1200000000000009.quest_desc: [
		"Mesh a Cogwheel with a Large Cogwheel and move the assembly. Visually compare the speed of both shafts, then try reversing which side receives the input motion."
		"This transmission-ratio principle will appear whenever you need to adapt a power source to a machine's needs. Ponder can show useful arrangements if the gears do not connect the way you expected."
	]
	quest.1200000000000009.title: "Trade Speed for Torque"
	quest.120000000000000A.quest_desc: [
		"A Water Wheel turns flowing water into a continuous source of rotation. It is the first major leap forward: your workshop no longer has to depend on the Hand Crank to operate."
		"Craft the wheel using the current recipe shown in JEI. Before installing it, use Ponder to see how water flow and orientation affect the generated motion."
	]
	quest.120000000000000A.title: "Power from Water"
	quest.120000000000000B.quest_desc: [
		"Install the Water Wheel in contact with a suitable water flow and connect a Shaft to its rotational output. The network should keep turning without you holding a crank."
		"Confirm the quest only once the source is working reliably. From this point on, the machines that follow can share a real kinetic infrastructure."
	]
	quest.120000000000000B.title: "Rotation Without Stopping"
	quest.120000000000000C.quest_desc: [
		"A Gearbox is a distribution component. Instead of building a confusing sequence of gears for every direction, it lets you carry the same rotation to several shafts from a compact point."
		"You already understand Shafts, Cogwheels, and a continuous source; now use the Gearbox to organize the network. §bJEI:§r check the installed recipe for the recipe and Ponder to understand its transmission faces."
	]
	quest.120000000000000C.title: "Distribute the Rotation"
	quest.120000000000000D.quest_desc: [
		"The Clutch adds an essential function to your factory: it can interrupt rotational transmission in one section using a redstone signal. This lets you stop a machine without shutting down the entire power source."
		"The redstone prepared in the foundation chapter finally enters the kinetic network. Install the Clutch where it makes sense to control a sector, and use Ponder if you want to see its behavior with and without a signal."
	]
	quest.120000000000000D.title: "Stop Without Breaking the Network"
	quest.120000000000000E.quest_desc: [
		"The Gearshift also responds to redstone, but its role is to reverse rotational direction instead of simply stopping it. This is useful whenever a mechanism needs to alternate direction without rebuilding the transmission."
		"You already know how to distribute and stop motion; now add reversal to the system. Check Ponder for a control example, then test it on a safe section of your network."
	]
	quest.120000000000000E.title: "Reverse the Direction"
	quest.120000000000000F.quest_desc: [
		"Until now, you have judged the network by watching parts spin. The Compass enters this progression as a component used to build instruments that turn motion into readable information."
		"You already have iron and redstone from the foundation chapter. Craft the requested Compass and check JEI to see how it is used in the next recipe."
	]
	quest.120000000000000F.title: "A Compass for Measurement"
	quest.1200000000000010.quest_desc: [
		"The Speedometer measures the rotational speed of a network. This lets you compare transmissions without relying only on visual impressions and helps explain why two machines connected to the same system can behave differently."
		"Craft it using the recipe shown in JEI and install it on an active part of the network. Think back to the gear-ratio test: now you have an objective way to observe the result."
	]
	quest.1200000000000010.title: "Measure the Speed"
	quest.1200000000000011.quest_desc: [
		"The Stressometer shows the relationship between available kinetic capacity and the stress consumed by connected components. A network can still be spinning while lacking enough capacity for further expansion."
		"Use the instrument to monitor load before adding several machines at once. Speed and stress are different concepts; learning to read both will prevent future production lines from stopping for reasons that seem mysterious."
	]
	quest.1200000000000011.title: "Know the Limit"
	quest.1200000000000012.quest_desc: [
		"Dried Kelp is part of the Belt Connector chain, the item that will let you turn rotation into a material-transport line. Prepare the requested amount using the processing available at this stage."
		"Check JEI to confirm the current connector recipe. From this point onward, your workshop will begin moving not only mechanical power, but items as well."
	]
	quest.1200000000000012.title: "Kelp Ready for Belts"
	quest.1200000000000013.quest_desc: [
		"Belt Connectors are used to create a Belt between properly aligned Shafts. The belt transmits motion while also providing a surface for moving items through the factory."
		"Craft the connector and use Ponder to visualize alignment, distance, and assembly. The next quest is not asking you to merely own the item — it wants you to build a working belt."
	]
	quest.1200000000000013.title: "Belt Connectors"
	quest.1200000000000014.quest_desc: [
		"Place two compatible Shafts, use the Belt Connector to form the belt, and provide rotation to the assembly. Put an item on the Belt and watch whether it travels along the line."
		"Confirm the quest once transport actually works. This is a central automation concept: from now on, machines can receive and return materials without you carrying every item by hand."
	]
	quest.1200000000000014.title: "Your First Belt"
	quest.1200000000000015.quest_desc: [
		"The Depot is a stable surface where an item can wait for a Create operation. It works as a small processing station and is especially useful when you want to handle one piece at a time."
		"You already know how to move items with Belts; now learn to create fixed work points as well. The next machine, the Mechanical Press, can operate over a Depot or as part of a moving line."
	]
	quest.1200000000000015.title: "A Work Station"
	quest.1200000000000016.quest_desc: [
		"The next machine requires a heavier frame, so this step prepares an Iron Block from the iron you already know how to obtain. It marks the transition from light components to a machine capable of applying mechanical pressure."
		"Craft the requested block and check JEI to see how it is used in the current Mechanical Press recipe. Do not assume ingredients beyond what JEI shows for this version."
	]
	quest.1200000000000016.title: "Iron for the Frame"
	quest.1200000000000017.quest_desc: [
		"The Mechanical Press turns rotational force into mechanical pressure. It is used to press materials, make sheets, and participate in several other Create recipes."
		"To work, the Press must be connected to a rotational network and positioned above a suitable work area, such as a Depot or Belt depending on the process. You already understand both concepts: mechanical power and item transport."
		"Use Ponder on the Mechanical Press for a visual demonstration and check JEI for the available recipes. In the next quest, you will make your first Iron Sheet."
	]
	quest.1200000000000017.title: "Time to Press"
	quest.1200000000000018.quest_desc: [
		"The Iron Sheet is one of the first parts produced through mechanical processing rather than ordinary crafting. Place the input shown by JEI beneath the Mechanical Press and let the machine complete the pressing cycle."
		"Keep a few sheets: they will appear in many components throughout the next workshop stages. More important than memorizing the recipe is understanding the process — item positioned, rotation supplied, and the Press performing the operation."
	]
	quest.1200000000000018.title: "Your First Sheet"
	quest.1200000000000019.quest_desc: [
		"The same Mechanical Press can work with other metals. Make a Copper Sheet using the current JEI recipe to practice reusing the workstation you just built."
		"This branch is optional and does not block the chapter, but pressed copper will become important when we reach fluids and other machines. A good factory reuses infrastructure instead of building one machine for every material."
	]
	quest.1200000000000019.title: "Copper Sheet"
	quest.120000000000001A.quest_desc: [
		"A Golden Sheet is another application of the Mechanical Press and unlocks useful Create components. Because gold may be less abundant at this stage, the quest remains optional."
		"Check the recipe in JEI, process one unit when convenient, and keep the Press accessible. The main lesson is that the same pressing line can serve several different materials."
	]
	quest.120000000000001A.title: "Golden Sheet"
	quest.120000000000001B.quest_desc: [
		"Goggles are an information tool from Create. When equipped, they help display additional data while inspecting various components and make diagnosing mechanical networks much easier."
		"This upgrade is optional and belongs to the gold branch. §bJEI:§r check the installed recipe for the current recipe and, after equipping them, inspect a few workshop components to see what extra information appears."
	]
	quest.120000000000001B.title: "Engineer's Goggles"
	quest.120000000000001C.quest_desc: [
		"You already know how to make Iron Sheets with the Mechanical Press. Now it is time to turn that process into a small automated line."
		"Build a system that can receive the input material, carry it to the pressing area, and remove the finished sheets without you placing every item manually. There is no single correct solution: use Belts, Depots, and the rotational power you already know how to build."
	]
	quest.120000000000001C.title: "No More Doing It by Hand"
	quest.120000000000001D.quest_desc: [
		"Your workshop already has a continuous source of motion, but a good factory must also be observable and controllable. Install a Speedometer and Stressometer on part of the network and use a Clutch and Gearshift in a test section."
		"Trigger the controls with redstone and confirm that you can intentionally measure, stop, and reverse motion. This activity prepares the infrastructure that will keep later machines from becoming an impossible-to-diagnose network."
	]
	quest.120000000000001D.title: "A Network Under Control"
	quest.120000000000001E.quest_desc: [
		"You have progressed from basic resources to a workshop that generates, transmits, measures, and controls rotation, moves items, and automatically produces sheets. This set of systems is the foundation for everything that comes next."
		"Keep a small working installation with a Water Wheel, transmission through Shafts or Cogwheels, a Belt, and a Mechanical Press, plus at least one measurement or control point. Confirm the milestone once the workshop is truly usable — the next chapter will expand your processing toolkit."
	]
	quest.120000000000001E.title: "Your First Mechanical Workshop"
	quest.1300000000000001.quest_desc: [
		"The Basin is Create's batch-processing work area. It receives ingredients and serves as the workspace for machines such as the Mechanical Mixer; later recipes will also use it in more advanced processes."
		"You have reached this point with a functional pressing workshop, so now we will expand the kinds of transformations it can perform. §bJEI:§r check the installed recipe for the current Basin recipe and use Ponder if you want to see how it interacts with machines placed above it."
	]
	quest.1300000000000001.title: "A Basin for Processing"
	quest.1300000000000002.quest_desc: [
		"The Whisk is the mixing tool used by the Mechanical Mixer. It does not work by itself, but it is the component that allows the next machine to process recipes inside a Basin."
		"You already know how to make sheets and mechanical components; now use JEI to check which materials this version of the modpack requires for the Whisk."
	]
	quest.1300000000000002.title: "The Workshop Whisk"
	quest.1300000000000003.quest_desc: [
		"The Mechanical Mixer turns rotation into mechanical mixing. Positioned above a Basin and connected to a kinetic network, it performs mixing recipes that were not available to your workshop before."
		"Some processes also require a heat condition, something we will learn later. Check JEI to discover which recipes use the Mixer and use Ponder to observe the correct setup before powering the machine."
	]
	quest.1300000000000003.title: "Mixing with Rotational Force"
	quest.1300000000000004.quest_desc: [
		"Set up the Mechanical Mixer above a Basin and supply the machine with the rotation you already know how to produce. Choose a mixing recipe in JEI that is available at this stage and watch one full cycle."
		"The goal here is not to craft one specific item, but to understand the flow: ingredients enter the Basin, the machine receives rotation, and the result appears once the recipe's conditions are satisfied."
	]
	quest.1300000000000004.title: "Make the Mixing Happen"
	quest.1300000000000005.quest_desc: [
		"The Propeller is the rotor used to move air in Create machines. It connects your knowledge of sheets, learned with the Mechanical Press, to the workshop's next processing system."
		"Craft one using the recipe shown in JEI. Remember this connection between simple parts and larger machines: many Create mechanisms are assembled from components you have already produced."
	]
	quest.1300000000000005.title: "The Airflow Propeller"
	quest.1300000000000006.quest_desc: [
		"The Encased Fan uses rotation to create an airflow. Depending on the medium placed between the fan and the items, that airflow can perform several kinds of bulk processing."
		"Rotation direction matters because it determines where the air is pushed. §bJEI:§r check the installed recipe for the processing categories available in the modpack and use Ponder on the Encased Fan to understand distance, direction, and assembly."
	]
	quest.1300000000000006.title: "Air Can Work Too"
	quest.1300000000000007.quest_desc: [
		"Now turn the airflow into a Washing station. Make the Encased Fan blow through water toward the items and choose a recipe from JEI that belongs to the washing category."
		"Observe the results before automating the process: some recipes may have multiple outputs or different chances. JEI is the reference for the actual values in this modpack version."
	]
	quest.1300000000000007.title: "Washing with Airflow"
	quest.1300000000000008.quest_desc: [
		"The Encased Fan can also take part in bulk thermal processing when the airflow passes through the appropriate medium. This lets you process many items at once without placing them individually in a Furnace."
		"Open a Bulk Smoking or Bulk Blasting recipe available in the pack through JEI and reproduce the shown arrangement. This practice is optional and does not block the main progression."
	]
	quest.1300000000000008.title: "Heat Carried by Air"
	quest.1300000000000009.quest_desc: [
		"The Mechanical Saw is the workshop's cutting tool. It can work with blocks and moving items and will also become useful when you begin building moving machines."
		"Cutting recipes vary with the installed materials and addons, so check JEI to see what the Saw can process in this modpack. Ponder is also very useful for understanding orientation and safe use."
	]
	quest.1300000000000009.title: "Mechanical Cutting"
	quest.130000000000000A.quest_desc: [
		"The Mechanical Drill applies rotational force to break blocks in front of it. In a fixed installation it works as an automatic tool; on contraptions, it becomes part of excavation machines."
		"You already understand rotational transmission, so now pay attention to orientation and collection of broken blocks as well. §6Ponder:§r use the visualization to see examples before integrating the Drill into a larger structure."
	]
	quest.130000000000000A.title: "Mechanical Drilling"
	quest.130000000000000B.quest_desc: [
		"The Chute is a simple way to move items vertically using gravity. It pairs well with machines that receive materials from above or deliver outputs to a lower level."
		"Now that you have learned Washing, it makes sense to start organizing process inputs and outputs. §bJEI:§r check the installed recipe for the current recipe and test a Chute between two levels of your workshop."
	]
	quest.130000000000000B.title: "A Vertical Path"
	quest.130000000000000C.quest_desc: [
		"The Andesite Funnel is one of Create's basic logistics blocks. It moves items between inventories and transport lines, creating clear input and output points without relying on the player."
		"The Belt you built in the previous chapter now gains an important partner. §6Ponder:§r use the visualization to observe insertion and extraction modes and check JEI for the installed recipe."
	]
	quest.130000000000000C.title: "Controlled Input and Output"
	quest.130000000000000D.quest_desc: [
		"The Mechanical Harvester is designed to harvest crops when mounted on a suitable contraption. It introduces an idea that will become very important later: agricultural resources can also become part of the factory's automation logic."
		"This quest is optional for now. Craft the Harvester, view its Ponder demonstration, and keep it for when we reach industrial agriculture and moving farms."
	]
	quest.130000000000000D.title: "No More Hand-Harvesting"
	quest.130000000000000E.quest_desc: [
		"Zinc is one of Create's own metals and will be the key to entering the brass stage. Find the source available in the world and turn the resource into ingots using the process shown in JEI."
		"You have had copper since the workshop foundation. Combining these two metals in a heated process will unlock more advanced logistics components and machines."
	]
	quest.130000000000000E.title: "The Missing Metal"
	quest.130000000000000F.quest_desc: [
		"Before capturing a Blaze, prepare an Empty Blaze Burner. It is the container that turns heat into a controllable workshop component, but it still cannot heat a Basin on its own."
		"You already know how to make Iron Sheets and have reached the point where heat is required to progress. §bJEI:§r check the installed recipe for the current Empty Blaze Burner recipe and craft one; the next quest will teach you how to activate it."
	]
	quest.130000000000000F.title: "Prepare the Container"
	quest.1300000000000010.quest_desc: [
		"The Empty Blaze Burner does not provide heat yet. To turn it into a functional Blaze Burner, you need to capture the heat source that will remain inside it."
		"In standard Create, this is done by using the Empty Blaze Burner on a Blaze or another compatible source; check Ponder and JEI in your installation before attempting the capture. Once the Blaze Burner is ready, the Basin can handle mixing recipes that require heating."
	]
	quest.1300000000000010.title: "Capture the Heat"
	quest.1300000000000011.quest_desc: [
		"Brass is the material that marks the transition to Create's more sophisticated mechanisms. At this stage, the process uses a Mechanical Mixer above a Basin with the proper heat condition and the metals you prepared earlier."
		"Do not rely on remembered quantities: open the Brass Ingot recipe in JEI to confirm ingredients, ratios, and the heating level required by the current modpack version. Produce a small reserve, because several upcoming quests depend on it."
	]
	quest.1300000000000011.title: "Entering the Brass Age"
	quest.1300000000000012.quest_desc: [
		"Brass Casing is the structural evolution of Andesite Casing for a more advanced stage of Create. It appears in logistics systems, interfaces, and mechanical crafting."
		"You have understood the casing concept since early Create. Now check JEI to see how the current version turns your brass materials into this new casing and prepare at least one unit."
	]
	quest.1300000000000012.title: "Brass Casing"
	quest.1300000000000013.quest_desc: [
		"The Brass Funnel takes the Andesite Funnel concept into logistics with finer control. It becomes useful when the factory needs to decide more precisely what enters, what leaves, and in what quantity."
		"Since you have already tested basic flow with the Andesite Funnel and can now produce Brass, this upgrade arrives at the right time. §6Ponder:§r use the visualization to compare their behavior and confirm the recipe in JEI."
	]
	quest.1300000000000013.title: "More Precise Logistics"
	quest.1300000000000014.quest_desc: [
		"The Electron Tube is a control component used in Create's more sophisticated mechanisms. It connects the mechanical side of the workshop to parts that demand greater precision, such as the Deployer, Mechanical Crafter, and logistics systems."
		"Its production chain may involve materials that have not appeared directly in the quests yet. §bJEI:§r use the recipe viewer to follow the current recipe step by step and keep a few spare units."
	]
	quest.1300000000000014.title: "Mechanical Electronics"
	quest.1300000000000015.quest_desc: [
		"The Brass Hand is the component that turns brass into an actuator capable of manipulating items. It directly prepares the construction of the Deployer, one of the most important machines for the modpack's later progression."
		"You already have a Mechanical Press and know how to make sheets. Check JEI to see how that knowledge is used in the current Brass Hand recipe."
	]
	quest.1300000000000015.title: "A Brass Hand"
	quest.1300000000000016.quest_desc: [
		"The Deployer works like a mechanical hand: it performs interactions and applies the item it is holding to a target in front of it. This turns repetitive player actions into steps of an automated line."
		"Later, this concept becomes essential for Sequenced Assembly, custom components, and the modpack's Mystical Agriculture Resource Seeds. §6Ponder:§r use the visualization to understand orientation, reach, and item feeding, and check JEI for the exact recipe."
	]
	quest.1300000000000016.title: "The Machine That Applies"
	quest.1300000000000017.quest_desc: [
		"Set up the Deployer connected to your rotational network and give it an item that can be applied in a valid interaction shown by JEI or Ponder. Watch the hand extend, perform the action, and return."
		"Confirm only after seeing a real application work. The goal is to understand the mechanic, because from this point onward the Deployer will stop being just a machine and become a step inside larger processes."
	]
	quest.1300000000000017.title: "Put the Deployer to Work"
	quest.1300000000000018.quest_desc: [
		"The Portable Storage Interface creates a temporary item-transfer point between a contraption and the fixed factory when two interfaces align. This lets a moving machine unload or receive materials without being dismantled."
		"This knowledge pairs especially well with the Drill and Harvester. §6Ponder:§r use the visualization to watch a pair of interfaces connect and check JEI for the current recipe."
	]
	quest.1300000000000018.title: "A Bridge to Moving Machines"
	quest.1300000000000019.quest_desc: [
		"The Mechanical Crafter turns crafting recipes into a physical structure. Each Crafter represents one slot in the grid, and several blocks can be connected to form larger or special patterns."
		"This quest detects one unit to introduce the component, but larger recipes may require many Crafters arranged in the shape shown by JEI. It is excellent for large and special recipes, but it will not be the mandatory solution for all future autocrafting. §6Ponder:§r use the visualization to learn orientation, connections, and output behavior."
	]
	quest.1300000000000019.title: "Crafting Becomes a Machine"
	quest.130000000000001A.quest_desc: [
		"Crushing Wheels work as a pair. When two wheels rotate toward one another, material inserted between them is crushed and can produce new processed outputs."
		"This step asks for two units because the functional setup depends on the pair. Use the Mechanical Crafter you just learned, check the current recipe in JEI, and view Ponder before powering the wheels so you understand rotation direction and feeding."
	]
	quest.130000000000001A.title: "Two Wheels, One Crusher"
	quest.130000000000001B.quest_desc: [
		"It is time to chain processes together. Choose a compatible ore or resource in JEI and build a line that begins with Crushing, sends the material to Washing when the recipe calls for it, and finishes with smelting or another treatment when needed."
		"There is no universal yield: outputs, byproducts, and chances depend on the installed recipe. The goal of this quest is to learn how to read a processing chain in JEI and turn isolated machines into a coherent industrial process."
	]
	quest.130000000000001B.title: "From Ore to Product"
	quest.130000000000001C.quest_desc: [
		"The Mechanical Arm moves items between configured input and output points, creating visible logistics for Depots, Belts, inventories, and other compatible stations. It is especially useful when several machines need to share materials without a straight transport line."
		"Configure the points carefully and test item routing before relying on it for important production. Ponder shows how to select inputs and destinations; JEI confirms the current recipe."
	]
	quest.130000000000001C.title: "An Arm for Logistics"
	quest.130000000000001D.quest_desc: [
		"Your workshop is no longer just a press. You now have mixing, airflow, cutting, drilling, logistics, automatic application, and material processing — enough tools to start thinking in complete production lines instead of isolated machines."
		"Build a small functional workshop that integrates at least three of these processes and has organized inputs and outputs. Once everything operates in a clear and reusable way, confirm this milestone: the next stage is turning the workshop into a factory."
	]
	quest.130000000000001D.title: "The Workshop Is Alive"
	quest.1400000000000001.quest_desc: [
		"Until now, your factory has mainly moved items and rotation. Fluid Pipes open a new layer of automation: transporting liquids between machines, tanks, and processing points."
		"Produce a few pipes and use Ponder to see how they connect. §bJEI:§r check the installed recipe for the exact recipe in the current build; from now on, they will form the basic fluid network of your factory."
	]
	quest.1400000000000001.title: "Pipes for the Factory"
	quest.1400000000000002.quest_desc: [
		"A pipe by itself does not decide where fluid should go. The Mechanical Pump uses rotation to impose flow through piping and turns your network into a truly controllable system."
		"Connect the pump to a rotational source and observe the indicated direction. Ponder is especially useful here, because reversing rotation also reverses pumping direction."
	]
	quest.1400000000000002.title: "Motion for Fluids Too"
	quest.1400000000000003.quest_desc: [
		"Fluid Tanks store liquids and act as buffers between production and consumption. This prevents one machine from depending on receiving exactly the right amount of fluid at the exact moment another process needs it."
		"Build a few tank modules and try connecting them to your piping. Use JEI for the current recipe and Ponder to visualize larger tank structures."
	]
	quest.1400000000000003.title: "An Industrial Reservoir"
	quest.1400000000000004.quest_desc: [
		"The Hose Pulley can interact with large volumes of fluid below it. It is useful when the factory needs to fill from or drain natural reservoirs without manually carrying buckets every cycle."
		"Connect it to a network with a pump and pipes. Rules for sources considered infinite may vary with pack configuration, so use Ponder and test the actual behavior in this build."
	]
	quest.1400000000000004.title: "Drawing from Large Sources"
	quest.1400000000000005.quest_desc: [
		"The Item Drain extracts fluid from compatible items and sends it into the fluid network. It is the natural counterpart to the Spout: one empties containers, the other fills them."
		"Place a compatible item on the Drain and watch the process. JEI shows which Emptying operations are available in the current modpack version."
	]
	quest.1400000000000005.title: "Draining Items"
	quest.1400000000000006.quest_desc: [
		"The Spout applies fluid to items passing beneath it and performs Filling recipes. It turns your fluid network into part of a production line instead of merely a liquid-storage system."
		"Feed the Spout from pipes or a tank and leave room for a Belt or Depot below it. §6Ponder:§r use the visualization to see a working setup and JEI to check which items can be filled."
	]
	quest.1400000000000006.title: "Fluid in the Right Place"
	quest.1400000000000007.quest_desc: [
		"The Spout stops being just a machine once fluid becomes a finished product. Produce a Honey Bottle through Filling and make the item pass beneath the Spout to complete this step with a detectable result."
		"Create includes a standard recipe for this process, but JEI in your instance remains the source of truth if the modpack changes recipes. Later you will turn this test into a continuous line and produce a small stock."
	]
	quest.1400000000000007.title: "Your First Filling Product"
	quest.1400000000000008.quest_desc: [
		"This branch is optional. Use the Item Drain to remove fluid from a compatible container or item and route that fluid into a tank or pipe network."
		"If you are unsure which items support Emptying, check JEI. Confirm once you have watched the process working in the world."
	]
	quest.1400000000000008.title: "Emptying in Practice"
	quest.1400000000000009.quest_desc: [
		"Integrate a Hose Pulley or another source, Mechanical Pump, Fluid Pipes, Fluid Tank, and Spout into one functional network. The system must move fluid from a source to a point of use without manual bucket transport."
		"This is your factory's first real fluid infrastructure. Leave room to expand it, because Sequenced Assembly and future recipes may depend on Filling."
	]
	quest.1400000000000009.title: "A Real Fluid Network"
	quest.140000000000000A.quest_desc: [
		"Item Vaults provide storage designed for industrial lines and work well with Belts, Funnels, and Chutes. They act as production buffers, holding items between one processing stage and the next."
		"Build a few modules and observe how they connect. Later we will use stock control to prevent machines from continuing production when a buffer is already full."
	]
	quest.140000000000000A.title: "Storage at Scale"
	quest.140000000000000B.quest_desc: [
		"Brass Tunnels work directly on Belts and help split, merge, and distribute item flows with greater precision. They complement the Brass Funnels you already know how to craft."
		"§6Ponder:§r use the visualization to visualize distribution modes and test at least one line split. The goal now is to organize internal routes, not simply move everything along one belt."
	]
	quest.140000000000000B.title: "Split and Merge Flows"
	quest.140000000000000C.quest_desc: [
		"The Smart Chute adds filtering control to vertical transport. It is useful when a buffer receives several item types but only one category should continue to a specific machine or output."
		"Compare its behavior with the simple Chute you already know. Use JEI for the current recipe and configure a filter before moving on."
	]
	quest.140000000000000C.title: "Filtered Vertical Drop"
	quest.140000000000000D.quest_desc: [
		"Before building a logistics cell, prepare a small set of Brass Funnels. They control item input and output and can use filters to decide what enters or leaves Belts and inventories."
		"Produce four units and keep them for the next setups. JEI shows the current recipe; shortly you will combine these components with Mechanical Arms, Tunnels, Chutes, and buffers."
	]
	quest.140000000000000D.title: "Hardware for Distribution"
	quest.140000000000000E.quest_desc: [
		"You already met the Mechanical Arm in the previous chapter. Now produce two units so you can start treating it as a factory component rather than a one-off demonstration piece."
		"In the next step of this branch, you will configure multiple destinations and turn these arms into real distributors. Use Ponder if you want to review how input and output points are selected."
	]
	quest.140000000000000E.title: "Arms for the Cell"
	quest.140000000000000F.quest_desc: [
		"A single Mechanical Crafter teaches the mechanic, but large recipes require a matrix. Gather eight Mechanical Crafters so you have a concrete assembly base before automating recipe input."
		"§bJEI:§r check the installed recipe for the Crafter recipe and do not make more than you need. Later, this branch asks for a larger matrix once your factory can justify the investment."
	]
	quest.140000000000000F.title: "Crafter Matrix"
	quest.1400000000000010.quest_desc: [
		"Sequenced Assembly begins with a base item that is transformed into an incomplete state. In the current standard Precision Mechanism recipe, Golden Sheets fill that role; gather four for your first tests."
		"Check JEI before building the line, because modpack recipes can change. The important lesson here is to recognize the sequence input before following the intermediate item."
	]
	quest.1400000000000010.title: "The Sequence Input"
	quest.1400000000000011.quest_desc: [
		"Deployers need to receive the components consumed during each pass of Sequenced Assembly. Gather some Cogwheels to feed the line and use JEI to confirm every input required by the current recipe."
		"Preparing the materials before building the loop helps you think in terms of continuous production: each Deployer needs its own supply instead of relying on the player holding parts by hand."
	]
	quest.1400000000000011.title: "Gears for the Sequence"
	quest.1400000000000012.quest_desc: [
		"The Deployer can apply components during Sequenced Assembly. The machine that once copied a simple player interaction now becomes part of a repeatable manufacturing chain."
		"Build or simulate the step shown by JEI with a properly supplied Deployer. Notice that the incomplete item continues to the next operation instead of ending the recipe immediately."
	]
	quest.1400000000000012.title: "Deployer in the Sequence"
	quest.1400000000000013.quest_desc: [
		"Pressing can also be used as a Sequenced Assembly step, although not every recipe — including the current Precision Mechanism recipe — needs it. This branch is conceptual and optional."
		"Look in JEI for a sequence in the pack that includes Pressing. If none exists in this build, review the integration in Ponder/JEI and confirm after understanding where the Mechanical Press would fit."
	]
	quest.1400000000000013.title: "Pressing in Sequences"
	quest.1400000000000014.quest_desc: [
		"Filling with a Spout can also participate in Sequenced Assembly. This matters because custom modpack recipes may combine item application, pressure, and fluids in the same production chain."
		"Look in JEI for a current sequence that uses Filling. If one does not exist yet, use Ponder and the Sequenced Assembly category to understand the step before confirming this optional branch."
	]
	quest.1400000000000014.title: "Filling in Sequences"
	quest.1400000000000015.quest_desc: [
		"A sequence can require different components in separate Deployers. Gather Large Cogwheels to keep another stage supplied and watch in JEI how the incomplete item moves through the applicators."
		"Do not memorize a fixed number of repetitions: the point of this quest is to prepare enough inputs for the cycle to continue without stopping the line every pass."
	]
	quest.1400000000000015.title: "Larger Gears for the Cycle"
	quest.1400000000000016.quest_desc: [
		"Advance the Sequenced Assembly until an Incomplete Precision Mechanism appears. Temporarily remove one unit so the task can detect it, then return it to the process."
		"This item clearly shows what makes Sequenced Assembly different from a normal recipe: the same intermediate product keeps circulating and receiving operations until it becomes the final result."
	]
	quest.1400000000000016.title: "The Incomplete Item"
	quest.1400000000000017.quest_desc: [
		"The Precision Mechanism is a technological milestone in Create. It represents your first truly sequenced production and is required by many more advanced machines and systems."
		"Produce one using the Sequenced Assembly shown by JEI. Do not lock ingredients or cycle counts into this description: the modpack recipe is the source of truth, while Ponder helps visualize the setup."
	]
	quest.1400000000000017.title: "Mechanical Precision"
	quest.1400000000000018.quest_desc: [
		"Producing one Precision Mechanism proves the sequence works. Now turn the setup into a repeatable line: the starting item must enter, receive the required operations, and return to the beginning as many times as the recipe requires without you repositioning it manually."
		"Plan Deployer supply, return of the incomplete item, buffers, and final output. JEI remains the source for ingredients and cycle count; your job is to make the flow sustain itself."
	]
	quest.1400000000000018.title: "Automate Precision Mechanisms"
	quest.1400000000000019.quest_desc: [
		"You already automated Iron Sheets in Create I. Now collect the benefit of that infrastructure: keep the line running until you reach the stock requested by the task."
		"The goal is not to manually grind 64 sheets, but to verify that iron input, transport, Pressing, and output can sustain enough production to supply future recipes."
	]
	quest.1400000000000019.title: "Sheets in Bulk"
	quest.140000000000001A.quest_desc: [
		"In the Andesite Alloy automation branch, you prepared a repeatable process. Now use that line to build a factory stock instead of returning to one-by-one crafting whenever material runs out."
		"The task only measures the final quantity. Produce it using the process shown by JEI for this build and watch where the line loses pace: feeding, mixing/crafting, transport, or storage."
	]
	quest.140000000000001A.title: "Alloy at Factory Scale"
	quest.140000000000001B.quest_desc: [
		"Your Sequenced Assembly line should already be able to produce without constant intervention. Let it run until you gather the requested small stock and use that batch to evaluate whether the Deployers, buffers, and incomplete-item return can keep up."
		"If production stops on its own, do not treat that as failure: find the bottleneck, fix it, and only then increase the scale. This practice will be essential when precision mechanisms feed more advanced technologies."
	]
	quest.140000000000001B.title: "Precision in a Small Batch"
	quest.140000000000001C.quest_desc: [
		"The Threshold Switch — whose historical internal ID remains stockpile_switch — monitors an inventory level and produces a redstone signal according to configured thresholds. It lets a factory stop when the buffer is full and resume when stock drops."
		"Build one and use Ponder to understand the upper and lower limits. Later, we will use it to control a real production line instead of leaving machines running unnecessarily."
	]
	quest.140000000000001C.title: "Produce Only When Needed"
	quest.140000000000001D.quest_desc: [
		"The Smart Observer keeps the internal ID content_observer and detects items or conditions at a logistics point. It is useful for triggering signals when specific contents pass through a Belt, Chute, or inventory."
		"This branch is optional. Try a simple filter and compare its role with the Threshold Switch: one observes contents or events, while the other focuses on stock levels."
	]
	quest.140000000000001D.title: "Watch the Contents"
	quest.140000000000001E.quest_desc: [
		"Use the Threshold Switch to control part of the factory according to the stock in a buffer. The line should stop or block feeding when it reaches your chosen limit and resume when space becomes available again."
		"You can combine redstone with a Clutch, Funnel, Smart Chute, or another suitable component. What matters is that production responds to the state of storage."
	]
	quest.140000000000001E.title: "Stock Control"
	quest.140000000000001F.quest_desc: [
		"Integrate at least two forms of processing into one chain — Pressing, Filling, Deploying, Crushing/Washing, or another combination supported by the current recipes. Clearly define where raw material enters, where a buffer sits, and where the final product exits."
		"The goal is to eliminate manual transport between stages. Also watch whether one machine produces faster than the next; that imbalance is exactly why buffers and flow control exist."
	]
	quest.140000000000001F.title: "Two Stages, One Line"
	quest.1400000000000020.quest_desc: [
		"You have moved beyond a collection of machines and now operate a factory. Fluids have their own network, resources are crushed and processed in continuous flow, Mechanical Arms distribute materials, Crafters receive ingredients, and Sequenced Assembly maintains precision production."
		"Before confirming, let your main lines run for several cycles and watch whether buffers, inputs, and outputs can absorb differences in speed. Create III ends only when the factory demonstrates repeatable production, not when every block is merely placed on the floor."
	]
	quest.1400000000000020.title: "The Factory Is Producing"
	quest.1400000000000021.quest_desc: [
		"Your first Filling operation proved the Spout works. Now turn the process into a small continuous line: items should arrive automatically at the application point and continue to the output after being filled."
		"Keep the Spout supplied by a Tank and Pump, and use a Belt, Depot, Funnels, or another appropriate transport method for the items. The goal is to repeat several cycles without manually refilling fluid or repositioning each item."
	]
	quest.1400000000000021.title: "Continuous Filling"
	quest.1400000000000022.quest_desc: [
		"You already understand Crushing Wheels and have built an ore-processing chain. Now remove the player from the middle of the process: feed the wheels automatically and route the output to Washing or the next process shown by JEI."
		"Include a clear input, transport between stages, and an output or buffer. Do not assume a fixed yield in the build; outputs and chances belong to the modpack's current recipe."
	]
	quest.1400000000000022.title: "Crushing Without Intervention"
	quest.1400000000000023.quest_desc: [
		"An automated line must prove it can accumulate product. Let your crushing line run until you gather 32 Crushed Raw Iron."
		"This amount is enough to expose bottlenecks without turning the quest into a grind. If the line stops early, check Crushing Wheel feeding, output transport, and available buffer space."
	]
	quest.1400000000000023.title: "Stock of Crushed Material"
	quest.1400000000000024.quest_desc: [
		"Now make the Mechanical Arm work as a distributor, not just a transporter between two points. Configure one input and multiple compatible destinations, then watch how items are delivered."
		"Experiment with priorities and situations where one destination is full. The goal is to understand that logistics also means deciding where a resource should go, not merely moving it."
	]
	quest.1400000000000024.title: "One Arm, Multiple Destinations"
	quest.1400000000000025.quest_desc: [
		"Build a small cell where a buffer receives materials and the Mechanical Arm distributes those items between two or more workstations or inventories."
		"The cell should remain organized even when one output slows down. Use Vaults, Depots, Belts, Funnels, or inventories as buffers when needed; at this scale the Arm begins replacing tangled belt systems."
	]
	quest.1400000000000025.title: "A Logistics Cell"
	quest.1400000000000026.quest_desc: [
		"You have already produced a large recipe with Mechanical Crafters. Now automate the feeding of that matrix and organize result extraction so the same recipe can repeat without manually inserting each ingredient."
		"Choose a recipe that genuinely justifies the Crafters and check JEI for the current ingredients. The Mechanical Crafter remains a specialized tool: do not try to turn it into a universal autocrafting solution."
	]
	quest.1400000000000026.title: "Crafting in Series"
	quest.1400000000000027.quest_desc: [
		"Andesite Alloy remains a raw material for many Create components. Build a repeatable way to produce it using the process available in the current build instead of crafting each batch manually."
		"Check JEI before designing the line, because the recipe may change with the modpack. Organize ingredient input, execution of the process, and result extraction; the next stock quest will verify whether this automation can actually sustain production."
	]
	quest.1400000000000027.title: "Automate Andesite Alloy"
	quest.1400000000000028.quest_desc: [
		"Your line has already proven it can produce Precision Mechanisms repeatedly. Now raise the stock to 32 units so this component becomes a true industrial resource, ready to support more advanced technologies."
		"The goal is not to craft thirty-two pieces by hand. If the line still requires constant intervention, fix feeding, incomplete-item return, and Deployer restocking before chasing the quantity."
	]
	quest.1400000000000028.title: "Precision Engineering"
	quest.1400000000000029.quest_desc: [
		"Every industrial line becomes easier to understand when it has three clear zones: raw-material input, a buffer that absorbs speed differences, and product output."
		"Choose one of your current lines and reorganize it around this principle. The buffer does not need to be huge; it needs to prevent a fast stage from immediately stalling because the next one is still busy."
	]
	quest.1400000000000029.title: "Input, Buffer, and Output"
	quest.140000000000002A.quest_desc: [
		"When a single machine becomes the bottleneck, increasing the speed of the entire network is not always the best solution. Split one flow between two equivalent stations and merge or store their outputs."
		"Use Tunnels, Funnels, a Mechanical Arm, or another logistics method you already know. The goal is to experience parallel processing and see when two slower machines can serve demand better than one overloaded station."
	]
	quest.140000000000002A.title: "Parallel Processing"
	quest.140000000000002B.quest_desc: [
		"Now look at the factory as a complete system. Keep at least one Filling line, one mineral-processing line, and one production/logistics cell operating for several cycles without constant intervention."
		"Adjust buffers, distribution, and feeding until no stage stops simply because the previous one is too fast or because the output has nowhere to go. This quest does not demand maximum speed; it demands stable, understandable flow."
	]
	quest.140000000000002B.title: "Flow Without Bottlenecks"
	quest.140000000000002C.quest_desc: [
		"Filling automation only proves its value when it can repeatedly deliver product. Keep the line running until you gather 16 Honey Bottles without manually placing every item beneath the Spout."
		"Use a Tank, Pump, and Pipes to keep fluid available and organize the output so the product does not block the station. Once the result is proven, you can expand with more buffers and Filling points."
	]
	quest.140000000000002C.title: "Filling Stock"
	quest.140000000000002D.quest_desc: [
		"Fluid Tanks are buffers: they decouple the speed of fluid supply from the speed of consumption. After building your first functional network, keep eight Tanks available to expand storage or create intermediate reservoirs."
		"There is no single correct size for every system. Use JEI and Ponder whenever you need to review connections; the important part is to start thinking about process capacity, not just one machine working."
	]
	quest.140000000000002D.title: "Fluid Buffers"
	quest.140000000000002E.quest_desc: [
		"One Spout teaches the process; several Spouts let you separate recipes, build parallel lines, or dedicate a station to a particular fluid. Produce four Spouts so Filling becomes industrial capacity instead of a demonstration."
		"The exact recipe remains JEI's responsibility. This quest measures infrastructure ready for expansion; a specific Filling product can be tied to a real pack recipe whenever a canonical chain is defined."
	]
	quest.140000000000002E.title: "More Filling Points"
	quest.140000000000002F.quest_desc: [
		"You have already proven that automated crushing can accumulate material. Now let the line work until you gather 64 Crushed Raw Iron without returning to manual processing."
		"This stock is large enough to reveal whether feeding, output, and buffers can sustain continuous production, but still small enough to avoid becoming a grind. Afterward, use JEI to decide which next process gives the best result in the current build."
	]
	quest.140000000000002F.title: "Crushing at Scale"
	quest.1400000000000030.quest_desc: [
		"The same pressing logic that sustains Iron Sheets can feed other production chains. Produce a batch of 32 Copper Sheets so the Press becomes a material-processing station instead of a machine used for only one recipe."
		"Check JEI before feeding the line, especially if the pack changes recipes. The important part is to reuse the automated Pressing infrastructure and maintain a useful stock for future components."
	]
	quest.1400000000000030.title: "Copper Sheets in Bulk"
	quest.1400000000000031.quest_desc: [
		"Golden Sheets appear in more delicate components and precision processes. Produce 16 units using the Pressing infrastructure you already understand."
		"You do not need to dedicate an entire factory to gold. A line with selectable input or a small automated batch already proves that the same sector can manufacture different materials as needed."
	]
	quest.1400000000000031.title: "Golden Sheets in Bulk"
	quest.1400000000000032.quest_desc: [
		"The first Precision Mechanism proved the recipe, and the previous batch proved the automation works. Now gather 16 units so you can treat this component as real industrial stock."
		"If reaching 16 requires constant manual corrections, review Deployer feeding, incomplete-item return, and buffers. A reliable Sequenced Assembly should keep producing while you work on other parts of the factory."
	]
	quest.1400000000000032.title: "Precision Stock"
	quest.1400000000000033.quest_desc: [
		"After organizing input, buffer, and output, keep Item Vault modules ready for new lines. Eight units let you create intermediate storage without turning every expansion into another crafting session."
		"Buffers do more than store items: they absorb speed differences between stages. Use this stock when one machine produces in bursts or the next operation works more slowly."
	]
	quest.1400000000000033.title: "Factory Buffers"
	quest.1400000000000034.quest_desc: [
		"Your logistics cell already showed why distributing items is different from simply transporting them. Produce eight Brass Tunnels so you have enough parts for new splitters, balancers, and convergence points over Belts."
		"Use Ponder whenever you need to review distribution modes. The quantity in this quest is construction stock, not a requirement to install every Tunnel immediately."
	]
	quest.1400000000000034.title: "Distribution at Scale"
	quest.1400000000000035.quest_desc: [
		"Smart Chutes are useful when several materials share a buffer or vertical column but each output should accept only a specific set. Produce eight units so filtered vertical routes can become a normal part of future lines."
		"This does not replace Belts, Funnels, or Mechanical Arms. Think of the Smart Chute as a compact tool for situations where gravity and filtering solve the problem with less infrastructure."
	]
	quest.1400000000000035.title: "Filtered Vertical Logistics in Bulk"
	quest.1400000000000036.quest_desc: [
		"After configuring multiple destinations, the Mechanical Arm stops being a curiosity and becomes a distribution tool. Produce four units so you can build independent cells without dismantling the one that already works."
		"You do not need to install them all now. The stock exists so future lines can choose Arms when priorities, multiple destinations, or cleaner logistics justify their use."
	]
	quest.1400000000000036.title: "Arms for Expansion"
	quest.1400000000000037.quest_desc: [
		"Automating a large recipe requires a Mechanical Crafter matrix sized to match the recipe pattern. Gather 16 Crafters so you have the freedom to build larger recipes without dismantling your first experiment."
		"Do not turn this into universal autocrafting yet. Use Mechanical Crafters where JEI actually shows a large or special recipe; other technologies will handle general-purpose crafting later."
	]
	quest.1400000000000037.title: "Industrial Crafting Matrix"
	quest.1400000000000038.quest_desc: [
		"Parallel processing only makes sense when there are enough machines to divide the load. Gather four Crushing Wheels — enough for two pairs — and you will have the hardware to test two lines or duplicate a real bottleneck."
		"§bJEI:§r check the installed recipe for the current Wheel recipe. The idea is to connect the concept of parallel processing to a concrete amount of equipment without forcing you to duplicate the entire factory."
	]
	quest.1400000000000038.title: "Wheels for Parallel Lines"
	quest.1400000000000039.quest_desc: [
		"You have already configured a Threshold Switch to stop and resume production according to stock. Produce four units so you can take that idea to more than one factory sector."
		"Automatic control is more valuable when it is repeatable. Use the switches wherever a line truly needs to react to buffer level; there is no need to install all of them immediately."
	]
	quest.1400000000000039.title: "Repeatable Control"
	quest.140000000000003A.quest_desc: [
		"The previous milestone confirmed that your systems work together. Now prove they deliver results: maintain or replenish a stock of 64 Iron Sheets and 32 Precision Mechanisms using the lines you built."
		"This is a production goal, not a manual-crafting goal. If the stock drops because you use the components, that is expected; what matters is that the factory can rebuild it without turning you back into the main machine."
	]
	quest.140000000000003A.title: "The Factory Delivers"
	quest.1500000000000001.quest_desc: [
		"The Precision Mechanism was Create's precision component; now it becomes the raw material for a component unique to this modpack: the Industrial Mechanism."
		"In this build, it is made through Sequenced Assembly starting from a Precision Mechanism and passing through Deployer, Filling, and Pressing steps. §bJEI:§r check the installed recipe for the exact sequence and use Ponder to review the machines."
		"This component will be the bridge between your Create factory and several technologies that appear in the next eras."
	]
	quest.1500000000000001.title: "Industrial Mechanism"
	quest.1500000000000002.quest_desc: [
		"Producing one unit proves the recipe; a factory must repeat the process. Build a line that can manufacture Industrial Mechanisms without you manually applying each step."
		"Ensure Deployer supply, fluid for Filling, Pressing, and correct return of the incomplete item. You do not need to maximize speed: the goal is to make the process repeatable."
	]
	quest.1500000000000002.title: "Industrial Mechanism Production Line"
	quest.1500000000000003.quest_desc: [
		"Keep eight Industrial Mechanisms available. This small stock confirms that the line is sustainable and prepares your entry into machines from other mods."
		"The amount is deliberately moderate: we want to prove industrial capability, not turn this stage into a grind."
	]
	quest.1500000000000003.title: "Reserve for the Next Era"
	quest.1500000000000004.quest_desc: [
		"Redstone Links transmit signals between points using frequencies configured with items. Produce a pair so you have both a transmitter and a receiver."
		"They are useful when redstone wiring would cross the entire factory or when several sectors need to share the same command."
	]
	quest.1500000000000004.title: "Wireless Redstone"
	quest.1500000000000005.quest_desc: [
		"Configure two Redstone Links to the same frequency and use one to trigger a mechanism from a distance."
		"This is a configuration objective, so it remains a checkmark. The focus is learning how to create a reusable control channel."
	]
	quest.1500000000000005.title: "Remote Control"
	quest.1500000000000006.quest_desc: [
		"The Packager turns batches of items into packages that can travel through Create's modern logistics system."
		"In this modpack, the Packager recipe has been changed to use industrial-era components, including a Precision Mechanism. §bJEI:§r use the recipe viewer to verify the exact current ingredients."
		"From this point on, transport no longer means only moving loose stacks over Belts."
	]
	quest.1500000000000006.title: "Packaging Production"
	quest.1500000000000007.quest_desc: [
		"The Stock Link connects an inventory to Create's logistics network. It is the component that lets other blocks see what is stored there."
		"Start small: one well-connected storage inventory is enough to learn the system before spreading it across the factory."
	]
	quest.1500000000000007.title: "Linking the Stock"
	quest.1500000000000008.quest_desc: [
		"Connect a Stock Link to a real storage inventory and confirm that the network can query the available items."
		"This quest is a checkmark because FTB Quests cannot detect network configuration. What matters is that stock becomes information, not just a full chest."
	]
	quest.1500000000000008.title: "A Network That Sees Stock"
	quest.1500000000000009.quest_desc: [
		"The Stock Ticker provides an interface for viewing and requesting items from the logistics network."
		"It turns several connected inventories into something closer to an organized supply system while remaining completely physical and package-based."
	]
	quest.1500000000000009.title: "Stock Panel"
	quest.150000000000000A.quest_desc: [
		"The Redstone Requester can trigger item requests from redstone signals and conditions."
		"This brings the factory closer to true on-demand production and supply: a sector can request resources only when it actually needs them."
	]
	quest.150000000000000A.title: "Redstone Requests"
	quest.150000000000000B.quest_desc: [
		"Configure a Redstone Requester to request at least one item from a functional stock network."
		"Placing the block is not enough: make the request leave storage and reach its destination. This behavior cannot be detected automatically, so confirmation is manual."
	]
	quest.150000000000000B.title: "On-Demand Restocking"
	quest.150000000000000C.quest_desc: [
		"The Re-Packager reorganizes packages so logistics flows remain compatible with destinations and requests."
		"It becomes especially useful once the factory starts treating packages as transport units rather than simple item stacks."
	]
	quest.150000000000000C.title: "Reorganized Packages"
	quest.150000000000000D.quest_desc: [
		"The Package Frogport is a dedicated point for sending and receiving packages. It helps separate the request network from ordinary item movement."
		"Think of it as a logistics dock: the source prepares the package and the destination knows where to receive it."
	]
	quest.150000000000000D.title: "A Port for Packages"
	quest.150000000000000E.quest_desc: [
		"The Factory Gauge can display logistics-related states and helps make large systems easier to read."
		"This branch is optional because visual monitoring improves operation and diagnostics, but it is not required to unlock the next era."
	]
	quest.150000000000000E.title: "Factory Indicator"
	quest.150000000000000F.quest_desc: [
		"Belts solve local transport; tracks open transport between sectors, buildings, and distant factories. Produce an initial batch of Train Tracks."
		"We are not building a continent-spanning railway yet. Thirty-two tracks are enough to experiment with curves, stations, and your first functional segment."
	]
	quest.150000000000000F.title: "Tracks for Growth"
	quest.1500000000000010.quest_desc: [
		"A Train Station is the point where a train can be assembled, controlled, and integrated into routes."
		"Use Ponder before assembling the train: it explains the relationship between tracks, bogeys, glued structure, and the station much more clearly than a recipe alone."
	]
	quest.1500000000000010.title: "Your First Station"
	quest.1500000000000011.quest_desc: [
		"Track Signals divide a railway into sections and organize traffic when more than one train shares the same network."
		"Even if your first route has only one train, learning signaling now prevents you from rebuilding the entire system when it grows."
	]
	quest.1500000000000011.title: "Railway Signaling"
	quest.1500000000000012.quest_desc: [
		"The Train Observer detects trains passing a point on the line and can turn railway movement into redstone information."
		"It is optional at this stage, but it becomes useful for stations, signaling, and automations triggered by arriving cargo."
	]
	quest.1500000000000012.title: "Watching the Trains"
	quest.1500000000000013.quest_desc: [
		"The Schedule defines destinations and conditions for a train to operate automatically. It is what turns a manually driven train into a repeatable route."
		"Use Ponder and the Schedule interface itself to understand destinations and conditions. JEI remains the reference for the item's recipe."
	]
	quest.1500000000000013.title: "Schedule and Route"
	quest.1500000000000014.quest_desc: [
		"Close this era by building a functional cargo route: a stock system must prepare or request resources, and a railway route must carry cargo between two points."
		"There is no single correct build. The goal is to prove that your factory can already treat local supply and long-distance transport as parts of the same flow."
		"With this infrastructure ready, the Create Engineering and Technology sections can begin without abandoning Create: the next mods will be built on top of this industrial foundation."
	]
	quest.1500000000000014.title: "Logistics Between Factories"
	quest.1600000000000001.quest_desc: ["Aeronautics has left Omega. Flight progression is now direct and balanced: Create jetpacks for early mobility, Mekanism hydrogen propulsion and the Flight Augment as a late-game reward."]
	quest.1600000000000001.title: "The Propulsion Era"
	quest.1600000000000002.quest_desc: ["The first Create flight stage. Useful mobility, but still limited."]
	quest.1600000000000002.title: "Copper Jetpack"
	quest.1600000000000003.quest_desc: ["Move one tier higher before reaching the stronger industrial models."]
	quest.1600000000000003.title: "Andesite Jetpack"
	quest.1600000000000004.quest_desc: ["Brass marks the beginning of advanced Create mobility."]
	quest.1600000000000004.title: "Brass Jetpack"
	quest.1600000000000005.quest_desc: ["The top Create jetpack tier. It is also part of the Omega Propulsion Core recipe."]
	quest.1600000000000005.title: "Netherite Jetpack"
	quest.1600000000000006.quest_desc: ["A controlled exception to Mekanism Power Only: this machine now has a Create-based recipe so water can be converted into hydrogen for jetpacks."]
	quest.1600000000000006.title: "Electrolytic Separator"
	quest.1600000000000007.quest_desc: ["Feed the Electrolytic Separator with water and power. Its hydrogen output can directly refuel a Mekanism Jetpack."]
	quest.1600000000000007.title: "Hydrogen Production"
	quest.1600000000000008.quest_desc: ["The Mekanism route uses hydrogen fuel and gives technical flight without handing out permanent creative flight."]
	quest.1600000000000008.title: "Mekanism Jetpack"
	quest.1600000000000009.quest_desc: ["A reinforced Jetpack and an important part of Omega propulsion progression."]
	quest.1600000000000009.title: "Armored Jetpack"
	quest.160000000000000A.quest_desc: ["High-tech mobility tied to End exploration and future Omega engineering."]
	quest.160000000000000A.title: "HDPE Elytra"
	quest.160000000000000E.quest_desc: ["Mystical Agriculture Flight Augment is rebalanced. It now requires Mechanical Crafting, Awakened Supremium, Nether Stars, industrial mechanisms and a Mekanism Jetpack."]
	quest.160000000000000E.title: "Creative Flight — Now Endgame"
	quest.1600000000000010.quest_desc: ["Optional Mekanism ground mobility. Free Runners return with their own Create-based Mechanical Crafting recipe using steel, energy and industrial mechanisms. This quest does not block flight progression."]
	quest.1600000000000010.title: "Free Runners — Optional Mobility"
	quest.1600000000000011.quest_desc: ["The armored Free Runners are an optional upgrade for players who want mobility and protection without making the equipment a mandatory progression gate."]
	quest.1600000000000011.title: "Armored Free Runners"
	quest.1600000000000014.quest_desc: ["You mastered the industrial flight line: Create jetpacks, hydrogen production, the Mekanism Jetpack and the endgame Flight Augment. Free Runners remain optional mobility equipment."]
	quest.1600000000000014.title: "Integrated Flight Line"
	quest.1600000000000015.quest_desc: ["Complete the new flight progression and unlock the next stage of Project Omega and the Omega Propulsion Core."]
	quest.1600000000000015.title: "Mastery of the Skies"
quest.1700000000000010.quest_desc: [
		"A fundamental AE2 crystal. From it, you will obtain Charged Certus Quartz, Fluix, and Silicon."
		"Collect some in the world."
	]
	quest.1700000000000010.title: "Certus Quartz"
	quest.1700000000000011.quest_desc: [
		"A machine that charges Certus Quartz into Charged Certus Quartz."
		"Requires FE power."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000011.title: "Charger"
	quest.1700000000000012.quest_desc: [
		"The charged form of Certus Quartz, essential for Fluix and several components."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000012.title: "Charged Certus Quartz"
	quest.1700000000000015.quest_desc: [
		"Created by combining Certus Quartz, Charged Certus Quartz, and Redstone in water."
		"It is a base material for cables and processors."
	]
	quest.1700000000000015.title: "Fluix Crystal"
	quest.1700000000000016.quest_desc: [
		"Fluix Dust, used in many recipes."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000016.title: "Fluix Dust"
	quest.1700000000000017.quest_desc: [
		"Obtained from Certus Quartz through a grinding process."
		"An essential component for processors."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000017.title: "Silicon"
	quest.1700000000000018.quest_desc: [
		"A machine that presses printed circuits. It can be used to produce processors manually."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000018.title: "Inscriber"
	quest.1700000000000019.quest_desc: [
		"The result of pressing Silicon in the Inscriber."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000019.title: "Printed Silicon"
	quest.170000000000001A.quest_desc: [
		"The logic print required for the Logic Processor."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.170000000000001A.title: "Printed Logic Circuit"
	quest.170000000000001B.quest_desc: [
		"The calculation print required for the Calculation Processor."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.170000000000001B.title: "Printed Calculation Circuit"
	quest.170000000000001C.quest_desc: [
		"The engineering print required for the Engineering Processor."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.170000000000001C.title: "Printed Engineering Circuit"
	quest.170000000000001D.quest_desc: [
		"The logic processor, used as the foundation of many AE2 components."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.170000000000001D.title: "Logic Processor"
	quest.170000000000001E.quest_desc: [
		"A calculation processor used in automation-related components."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.170000000000001E.title: "Calculation Processor"
	quest.170000000000001F.quest_desc: [
		"An engineering processor used in advanced components."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.170000000000001F.title: "Engineering Processor"
	quest.1700000000000020.quest_desc: ["Build a Create production line that automatically makes Logic Processors through Sequenced Assembly."]
	quest.1700000000000020.title: "Automate Logic Processors"
	quest.1700000000000021.quest_desc: ["Apply the same industrial logic used for Logic Processors to build an automated Calculation Processor line."]
	quest.1700000000000021.title: "Automate Calculation Processors"
	quest.1700000000000022.quest_desc: ["Repeat the same Sequenced Assembly architecture for Engineering Processors and make their production automatic as well."]
	quest.1700000000000022.title: "Automate Engineering Processors"
	quest.1700000000000023.quest_desc: [
		"Build a stock of 16 Logic Processors."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000023.title: "16 Logic Processors"
	quest.1700000000000024.quest_desc: [
		"Build a stock of 16 Calculation Processors."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000024.title: "16 Calculation Processors"
	quest.1700000000000025.quest_desc: [
		"Build a stock of 16 Engineering Processors."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000025.title: "16 Engineering Processors"
	quest.1700000000000026.quest_desc: [
		"With all three processors mastered, you are ready to build your first ME network."
		"This milestone opens the digital era."
	]
	quest.1700000000000026.title: "The Digital Age"
	quest.1700000000000027.quest_desc: [
		"Allows the ME network to be powered from an external FE source."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000027.title: "Energy Acceptor"
	quest.1700000000000028.quest_desc: [
		"Stores energy for the ME network and acts as a buffer."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000028.title: "Energy Cell"
	quest.1700000000000029.quest_desc: [
		"A higher-capacity version of the Energy Cell."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000029.title: "Dense Energy Cell"
	quest.170000000000002A.quest_desc: [
		"The basic cable used to connect AE2 devices."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.170000000000002A.title: "Fluix Cable"
	quest.170000000000002B.quest_desc: [
		"Holds Storage Cells and exposes their contents to the network."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.170000000000002B.title: "ME Drive"
	quest.170000000000002C.quest_desc: [
		"The first 1k storage component used to build ME Storage Cells."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.170000000000002C.title: "1k Storage Component"
	quest.170000000000002D.quest_desc: [
		"A 1k storage cell that stores items in the ME network."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.170000000000002D.title: "1k Storage Cell"
	quest.1700000000000030.quest_desc: [
		"The basic interface used to access items stored in the ME network."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000030.title: "ME Terminal"
	quest.1700000000000031.quest_desc: [
		"A terminal with integrated manual crafting support."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000031.title: "Crafting Terminal"
	quest.1700000000000032.quest_desc: [
		"Build a functional network with a Drive, Storage Cell, Terminal, and power."
		"Confirm that you can insert and retrieve items."
	]
	quest.1700000000000032.title: "Your First ME Network"
	quest.1700000000000033.quest_desc: [
		"A core used to build the Import Bus."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000033.title: "Formation Core"
	quest.1700000000000034.quest_desc: [
		"A core used to build the Export Bus."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000034.title: "Annihilation Core"
	quest.1700000000000035.quest_desc: [
		"Imports items from external inventories into the ME network."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000035.title: "Import Bus"
	quest.1700000000000036.quest_desc: [
		"Exports items from the ME network into external inventories."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000036.title: "Export Bus"
	quest.1700000000000037.quest_desc: [
		"Connects an external inventory so the ME network can treat it as storage."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000037.title: "Storage Bus"
	quest.1700000000000038.quest_desc: [
		"Lets the network interact with machines and inventories by supplying and receiving items."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000038.title: "ME Interface"
	quest.1700000000000039.quest_desc: [
		"Configure an Import Bus to pull items from a chest or machine."
		"This is a practical objective: complete it only after testing the setup in the world and confirming that it performs the intended function."
	]
	quest.1700000000000039.title: "Automatic Importing"
	quest.170000000000003A.quest_desc: [
		"Use an Export Bus to keep a machine continuously supplied with inputs."
		"This is a practical objective: complete it only after testing the setup in the world and confirming that it performs the intended function."
	]
	quest.170000000000003A.title: "Keep a Machine Supplied"
	quest.170000000000003B.quest_desc: [
		"Use a Storage Bus to expose an external inventory to the ME network."
		"This is a practical objective: complete it only after testing the setup in the world and confirming that it performs the intended function."
	]
	quest.170000000000003B.title: "Integrate External Storage"
	quest.170000000000003C.quest_desc: [
		"A blank pattern used as the basis for encoding recipes."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.170000000000003C.title: "Blank Pattern"
	quest.170000000000003D.quest_desc: [
		"A terminal used to encode recipes into patterns."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.170000000000003D.title: "Pattern Encoding Terminal"
	quest.170000000000003F.quest_desc: [
		"Provides encoded patterns to the autocrafting system."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.170000000000003F.title: "Pattern Provider"
	quest.1700000000000040.quest_desc: [
		"A component used to build the autocrafting system's Crafting CPU."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000040.title: "Crafting Unit"
	quest.1700000000000041.quest_desc: [
		"Speeds up autocrafting by allowing more work to be processed in parallel."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000041.title: "Crafting Co-Processor"
	quest.1700000000000042.quest_desc: [
		"Build a Crafting CPU, create a Processing Pattern, and request an item from the terminal."
		"AE2 should only dispatch the ingredients through the Pattern Provider. Manufacturing happens outside the network in your Create line, and the result must return to storage to complete the job."
	]
	quest.1700000000000042.title: "First Production on Demand"
	quest.1700000000000043.quest_desc: [
		"Create a processing pattern for a recipe that uses machines rather than instant crafting."
		"This is a practical objective: complete it only after testing the setup in the world and confirming that it performs the intended function."
	]
	quest.1700000000000043.title: "Processing Pattern"
	quest.1700000000000044.quest_desc: [
		"Configure AE2 to send ingredients to a Create factory through a Pattern Provider."
		"This is a practical objective: complete it only after testing the setup in the world and confirming that it performs the intended function."
	]
	quest.1700000000000044.title: "The Network Gives the Order"
	quest.1700000000000045.quest_desc: ["Complete the cycle: the factory processes the ingredients and returns the finished product to the network."]
	quest.1700000000000045.title: "The Factory Responds"
	quest.1700000000000046.quest_desc: ["Request a Create component from the terminal — for example, a Precision Mechanism — and watch the network orchestrate its production."]
	quest.1700000000000046.title: "Production on Demand"
	quest.1700000000000047.quest_desc: [
		"Advanced milestone: your AE2 network now controls Create production lines automatically."
		"This is a practical objective: complete it only after testing the setup in the world and confirming that it performs the intended function."
	]
	quest.1700000000000047.title: "Full Create + AE2 Integration"
	quest.1700000000000048.quest_desc: [
		"Emits a redstone signal based on the quantity of an item stored in the ME network."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000048.title: "Level Emitter"
	quest.1700000000000049.quest_desc: [
		"Set the Level Emitter to activate when stock drops below a chosen threshold."
		"This is a practical objective: complete it only after testing the setup in the world and confirming that it performs the intended function."
	]
	quest.1700000000000049.title: "Configure a Stock Limit"
	quest.170000000000004A.quest_desc: [
		"Use the Level Emitter to control a Create production line and maintain an ideal stock level."
		"This is a practical objective: complete it only after testing the setup in the world and confirming that it performs the intended function."
	]
	quest.170000000000004A.title: "Automatically Start and Stop the Factory"
	quest.170000000000004B.quest_desc: [
		"Accelerates Certus Quartz crystal growth and requires power."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.170000000000004B.title: "Growth Accelerator"
	quest.170000000000004C.quest_desc: ["Build an arrangement of Growth Accelerators around Budding Certus and confirm that crystal growth speeds up."]
	quest.170000000000004C.title: "Accelerated Certus Production"
	quest.170000000000004D.quest_desc: [
		"Provides wireless access to the ME network."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.170000000000004D.title: "Wireless Access Point"
	quest.170000000000004E.quest_desc: [
		"A portable terminal for accessing the ME network from a distance."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.170000000000004E.title: "Wireless Terminal"
	quest.170000000000004F.quest_desc: [
		"A wireless terminal with integrated crafting support."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.170000000000004F.title: "Wireless Crafting Terminal"
	quest.1700000000000050.quest_desc: [
		"Use the Wireless Terminal away from the Access Point to manage stored items."
		"This is a practical objective: complete it only after testing the setup in the world and confirming that it performs the intended function."
	]
	quest.1700000000000050.title: "Access the Network Remotely"
	quest.1700000000000051.quest_desc: [
		"The central component used to manage network channels."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000051.title: "ME Controller"
	quest.1700000000000052.quest_desc: [
		"A smart cable that visually monitors channel usage."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000052.title: "Smart Cable"
	quest.1700000000000053.quest_desc: [
		"A dense smart cable that carries more channels than a standard cable."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000053.title: "Dense Smart Cable"
	quest.1700000000000054.quest_desc: [
		"Use an ME Controller and Dense Smart Cables to expand your network beyond eight channels."
		"This is a practical objective: complete it only after testing the setup in the world and confirming that it performs the intended function."
	]
	quest.1700000000000054.title: "Expanding with Channels"
	quest.1700000000000055.quest_desc: [
		"Transports channels and other resources between distant points."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000055.title: "P2P Tunnel"
	quest.1700000000000056.quest_desc: [
		"Establish a P2P connection between two points in the network."
		"This is a practical objective: complete it only after testing the setup in the world and confirming that it performs the intended function."
	]
	quest.1700000000000056.title: "Configure P2P"
	quest.1700000000000057.quest_desc: [
		"Create a subnet to isolate part of the network. This is an optional advanced step."
		"This is a practical objective: complete it only after testing the setup in the world and confirming that it performs the intended function."
	]
	quest.1700000000000057.title: "Simple Subnetwork"
	quest.1700000000000058.quest_desc: [
		"A block used as part of the Quantum Network Bridge."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000058.title: "Quantum Link Chamber"
	quest.1700000000000059.quest_desc: [
		"An item required to establish a Quantum Network Bridge."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1700000000000059.title: "Quantum Entangled Singularity"
	quest.170000000000005A.quest_desc: ["The Quantum Ring forms the outer structure of the quantum bridge. After obtaining the Link Chamber and Quantum Entangled Singularity, use these components to assemble a complete connection between distant networks."]
	quest.170000000000005A.title: "Quantum Ring"
	quest.170000000000005B.quest_desc: [
		"Establish a quantum bridge between two separate ME networks."
		"This is a practical objective: complete it only after testing the setup in the world and confirming that it performs the intended function."
	]
	quest.170000000000005B.title: "Connect Distant Networks"
	quest.170000000000005C.quest_desc: [
		"A cell capable of storing an area of the world."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.170000000000005C.title: "Spatial Storage Cell"
	quest.170000000000005D.quest_desc: [
		"The port used to interact with Spatial Storage."
		"This component belongs to AE2 digital infrastructure and prepares the next machines or network resources. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.170000000000005D.title: "Spatial IO Port"
	quest.170000000000005E.quest_desc: [
		"Capture an area of the world and materialize it again through Spatial Storage."
		"This is a practical objective: complete it only after testing the setup in the world and confirming that it performs the intended function."
	]
	quest.170000000000005E.title: "Use Spatial Storage"
	quest.170000000000005F.quest_desc: ["The Pattern Provider delivers; the Molecular Assembler executes. Combine AE2 digital automation with external Create lines whenever the process needs physical machinery."]
	quest.170000000000005F.title: "Molecular Assembler"
	quest.1700000000000060.quest_desc: ["Increase memory available for heavier autocrafting jobs."]
	quest.1700000000000060.title: "16k Crafting Storage"
	quest.1700000000000061.quest_desc: ["The digital factory grows: more steps, more ingredients and more calculation space."]
	quest.1700000000000061.title: "64k Crafting Storage"
	quest.1700000000000062.quest_desc: ["This tier is required by the Logic Core. AE2 must prove industrial scale, not just storage."]
	quest.1700000000000062.title: "256k Crafting Storage"
	quest.1700000000000063.quest_desc: ["Automate content movement between cells and the network for storage maintenance at scale."]
	quest.1700000000000063.title: "I/O Port"
	quest.1700000000000064.quest_desc: ["You completed the Digital Age proof: AE2 requests, distributes and calculates; Create performs physical manufacturing; the product returns to the network. This milestone unlocks the Logic Core path."]
	quest.1700000000000064.title: "Industrial Autocrafting at Scale"
	quest.1700000000000065.quest_desc: ["Manage an entire wall of Pattern Providers through the network. Manufacturing now uses Mechanical Crafting, keeping this AE2 terminal as technology built by Create industry."]
	quest.1700000000000065.title: "Pattern Access Terminal"
	quest.1700000000000066.quest_desc: ["Scale up Spatial I/O. Both component and cell are manufactured through Create processes instead of keeping a parallel native recipe."]
	quest.1700000000000066.title: "16³ Spatial Cell"
	quest.1700000000000067.quest_desc: ["The largest Spatial Cell requires a heavier industrial line and proves mastery of the complete Spatial I/O system."]
	quest.1700000000000067.title: "128³ Spatial Cell"
	quest.1700000000000068.quest_desc: ["Carry high-capacity ME storage with you. Portable Cells remain original AE2 devices; only their manufacturing route has moved to Create."]
	quest.1700000000000068.title: "256k Portable Cell"
	quest.1700000000000069.quest_desc: ["Close the link between network and factory: Cable Pattern Provider, Cable Interface, Storage/Conversion Monitor and Energy Level Emitter are now part of Create manufacturing."]
	quest.1700000000000069.title: "AE2 — Industrial Interfaces"
	quest.170000000000006A.quest_desc: ["Start from the ME P2P Tunnel and specialize Redstone, Items, Fluids, FE and Light. The network becomes infrastructure distribution, not just storage."]
	quest.170000000000006A.title: "AE2 — Specialized P2P"
	quest.170000000000006B.quest_desc: ["Spatial Anchor, Matrix Frame, Vibration Chamber and Crystal Resonance Generator close the final functional gaps in the industrialized AE2 route."]
	quest.170000000000006B.title: "AE2 — Advanced Network Infrastructure"
	quest.1800000000000010.quest_desc: [
		"Create remains the backbone of your factory, but electrical technologies will now begin to require FE (Forge Energy)."
		"Mekanism Generators introduces new ways to produce and store that energy without replacing the mechanical automation you already understand."
		"In this chapter, you will learn to generate electricity from several sources and store it in Energy Cubes so your electrical machines can run reliably."
	]
	quest.1800000000000010.title: "Mekanism — Power at Scale"
	quest.1800000000000011.quest_desc: [
		"Generates power from heat, such as lava or burning solid fuels."
		"Advantage: it does not depend on wind or sunlight, so it can work in almost any environment."
		"Limitation: it needs a constant heat source to maintain production."
		"Create integration: this generator is assembled through your mechanical infrastructure — JEI will show the exact sequence."
	]
	quest.1800000000000011.title: "Heat Generator"
	quest.1800000000000012.quest_desc: [
		"Converts wind into electrical power."
		"Advantage: passive and renewable generation with no fuel consumption."
		"Limitation: output depends on height and open space around the generator."
		"Create integration: crafted from components processed in your industrial production lines."
	]
	quest.1800000000000012.title: "Wind Generator"
	quest.1800000000000013.quest_desc: [
		"Uses daylight to generate power."
		"Advantage: free energy during the day with no fuel maintenance."
		"Limitation: it does not generate at night or in dark locations."
		"Create integration: assembled from sheets and mechanical components produced in your factory."
	]
	quest.1800000000000013.title: "Solar Generator"
	quest.1800000000000014.quest_desc: [
		"Burns biomass to generate electricity."
		"Advantage: it can use organic and agricultural byproducts from your automation."
		"Limitation: it requires a continuous supply of burnable material."
		"Create integration: its manufacturing chain involves processes such as Deploying and Mechanical Crafting."
	]
	quest.1800000000000014.title: "Bio-Generator"
	quest.1800000000000015.quest_desc: [
		"An upgraded Solar Generator with greater efficiency and output."
		"It keeps the advantages of solar power while producing more energy per block."
		"Create integration: it requires more advanced components, such as Precision Mechanisms."
	]
	quest.1800000000000015.title: "Advanced Solar Generator"
	quest.1800000000000016.quest_desc: [
		"Install a Wind Generator in a high location and connect it to a machine that consumes FE."
		"Confirm that power is flowing and the machine can operate continuously."
	]
	quest.1800000000000016.title: "Wind Power in Action"
	quest.1800000000000017.quest_desc: [
		"Set up a Bio-Generator and feed it biomass, such as seeds or plant waste."
		"Verify that it generates enough power to supply a basic load."
	]
	quest.1800000000000017.title: "Biomass into Power"
	quest.1800000000000018.quest_desc: [
		"You do not need to build every generator, but you should have at least one FE source operating."
		"Having active generation is the first step toward stabilizing your electrical network."
	]
	quest.1800000000000018.title: "A Generator in Operation"
	quest.1800000000000019.quest_desc: [
		"An Energy Cube stores FE, unlike a generator that produces it."
		"Storage lets you accumulate power, absorb demand spikes, and keep machines running when generation fluctuates."
		"Build four units so energy can be distributed across different factory sectors."
		"Create integration: the current recipe replaces the old Mekanism industrial chain with a direct assembly route in your factory."
	]
	quest.1800000000000019.title: "Basic Energy Cube (×4)"
	quest.180000000000001A.quest_desc: [
		"Offers greater capacity and transfer rates than the Basic Energy Cube."
		"Use it wherever electrical demand begins to grow."
	]
	quest.180000000000001A.title: "Advanced Energy Cube"
	quest.180000000000001B.quest_desc: [
		"High-capacity storage for more robust electrical networks."
		"Suitable for powering multiple machines at the same time."
	]
	quest.180000000000001B.title: "Elite Energy Cube"
	quest.180000000000001C.quest_desc: [
		"The top tier of Mekanism's Energy Cube line."
		"It can sustain heavy demand and provide stable power to your entire technological infrastructure."
	]
	quest.180000000000001C.title: "Ultimate Energy Cube"
	quest.180000000000001D.quest_desc: [
		"Build a complete electrical infrastructure: at least one generator producing FE, one Energy Cube storing it, and one connected consumer machine."
		"The system should operate continuously without manual intervention."
		"With generation and storage mastered, your Create factory is ready to power increasingly advanced technologies."
	]
	quest.180000000000001D.title: "The Factory Must Not Stop"
	quest.1800000000000020.quest_desc: ["Move FE with Mekanism infrastructure. The native recipe was replaced by Create manufacturing."]
	quest.1800000000000020.title: "Universal Cable"
	quest.1800000000000021.quest_desc: ["Fluids gain an advanced technological option without removing Create’s visual transport or Pipez simplicity."]
	quest.1800000000000021.title: "Mechanical Pipe"
	quest.1800000000000022.quest_desc: ["Mekanism item logistics returns to the pack, but starts in Mechanical Crafting to preserve the industrial identity."]
	quest.1800000000000022.title: "Logistical Transporter"
	quest.1800000000000023.quest_desc: ["Prepare gas and chemical infrastructure for systems that truly need it, without automatically unlocking the whole machine tree."]
	quest.1800000000000023.title: "Pressurized Tube"
	quest.1800000000000024.quest_desc: ["The fifth transport pillar closes the set: heat now has its own advanced infrastructure route."]
	quest.1800000000000024.title: "Thermodynamic Conductor"
	quest.1800000000000025.quest_desc: ["Raise all five families to Ultimate. Each tier jump uses Mekanism alloys manufactured through Create and progressively hotter processing."]
	quest.1800000000000025.title: "Ultimate Infrastructure"
	quest.1800000000000026.quest_desc: ["Power, items, fluids, chemicals and heat now form a complete technology infrastructure. This milestone feeds the Omega Energy Core."]
	quest.1800000000000026.title: "Complete Tech Network"
	quest.1800000000000030.quest_desc: ["Bronze, Osmium and Steel tools return as useful equipment, but manufacturing now goes through Create Mechanical Crafting. Mekanism supplies the materials; Create builds the technology."]
	quest.1800000000000030.title: "Mekanism Industrial Tools"
	quest.1800000000000031.quest_desc: ["Refined Glowstone and Refined Obsidian form the advanced Mekanism tool layer. Their original recipes remain replaced by more expensive Create manufacturing."]
	quest.1800000000000031.title: "High-Tech Paxels"
	quest.1800000000000032.quest_desc: ["The original Mekanism tool is back, but not as a free shortcut. Its 5×5 assembly uses Atomic Alloy, Energy Tablets, Sturdy Sheet, Netherite and an Industrial Mechanism."]
	quest.1800000000000032.title: "Atomic Disassembler"
	quest.1800000000000033.quest_desc: ["Take Mekanism logistics to the quantum level. The Entangloporter is now a 5×5 milestone mixing Atomic Alloy, Ultimate Circuits, energy and Create industrial mechanisms."]
	quest.1800000000000033.title: "Quantum Entangloporter"
	quest.1800000000000034.quest_desc: ["Optional route. The QIO Drive Array holds QIO Drives and concentrates digital storage, while the QIO Dashboard is an interface for accessing that network. Mekanism runs the technology; Create builds the structure."]
	quest.1800000000000034.title: "QIO Infrastructure"
	quest.1800000000000035.quest_desc: ["Produce the Ultimate Induction Cell and Provider through your factory. Extreme energy must require real infrastructure, not a lone crafting table."]
	quest.1800000000000035.title: "Ultimate Induction Matrix"
	quest.1800000000000036.quest_desc: ["The Nucleosynthesizer represents Mekanism's peak scientific processing and is now built from SPS Casing, Supercharged Coil, Ultimate Circuits and Create industry."]
	quest.1800000000000036.title: "Antiprotonic Nucleosynthesizer"
	quest.1800000000000037.quest_desc: ["Optional automated mining route. The Digital Miner remains available behind expensive industrial manufacturing, but it is not required to finish the pack and does not replace Mystical/Productive Bees as the primary renewable resource paths."]
	quest.1800000000000037.title: "Industrial Digital Miner"
	quest.190000000000000C.quest_desc: [
		"Menril Trees are the foundation of Integrated Dynamics. You can find them in swamp, forest, or freshwater environments such as Swamp, Forest, and River biomes."
		"Break the leaves to collect Menril Berries and use an axe to harvest the logs. This quest is simply your starting marker for exploration."
	]
	quest.190000000000000C.title: "Find a Menril Tree"
	quest.190000000000000D.quest_desc: [
		"Menril wood is durable and highly versatile. With eight logs, you already have enough material to begin producing the crystals and structures required for the logic network."
		"Keep the excess, because expanding cables and components will consume a good amount of wood."
	]
	quest.190000000000000D.title: "Menril Logs"
	quest.190000000000000E.quest_desc: [
		"Menril Berries grow on Menril leaves. They can be eaten in an emergency, but their main purpose here is resin extraction."
		"Collect eight so you have enough raw material for the next stage."
	]
	quest.190000000000000E.title: "Menril Berries"
	quest.190000000000000F.quest_desc: [
		"With logs and berries in hand, you can extract valuable Menril Resin and store it in a bucket. Resin is the central material used to make blocks, crystals, and logic components."
		"You are now officially ready to enter the age of intelligent automation."
	]
	quest.190000000000000F.title: "Bucket of Menril Resin"
	quest.1900000000000050.quest_desc: [
		"Menril Resin can be solidified into its own block. This keeps the material organized and acts as an intermediate step before crystallization for storage-network components."
		"Craft the resin block and continue toward crystallized Menril."
	]
	quest.1900000000000050.title: "Block of Menril Resin"
	quest.1900000000000051.quest_desc: [
		"Crystallizing the resin block creates a hard, logic-conductive material. It is essential for Variable Transformers and other central Integrated Dynamics components."
		"Produce this block to unlock the rest of the progression."
	]
	quest.1900000000000051.title: "Crystallized Menril Block"
	quest.1900000000000052.quest_desc: [
		"Menril Glass combines durability and transparency. Beyond decoration, it is used in Light Panels and other visual components of the logic network."
		"Craft one piece of Menril Glass to continue."
	]
	quest.1900000000000052.title: "Menril Glass"
	quest.1900000000000053.quest_desc: [
		"The Input Variable Transformer allows the logic network to read data from the world. It is used in readers and sensors, giving your factory the ability to observe machine and inventory states."
		"Produce one as part of the storage system."
	]
	quest.1900000000000053.title: "Input Variable Transformer"
	quest.1900000000000054.quest_desc: [
		"The Output Variable Transformer is the counterpart to the input version: it allows the logic network to act on the world by controlling machines and devices."
		"With both transformers, you have the basic building blocks for the system's backbone."
	]
	quest.1900000000000054.title: "Output Variable Transformer"
	quest.1900000000000055.quest_desc: [
		"The Light Panel is a simple visual component that can be controlled by the logic network. It also serves as a base for the Display Panel."
		"Craft a Light Panel to begin working with visual outputs."
	]
	quest.1900000000000055.title: "Light Panel"
	quest.1900000000000056.quest_desc: [
		"The Display Panel shows information from the logic network, including numbers, text, and states. It is the first step toward viewing data without opening a terminal."
		"Produce one to unlock the Storage Terminal."
	]
	quest.1900000000000056.title: "Display Panel"
	quest.1900000000000057.quest_desc: [
		"The Storage Terminal is the central interface of the system. It lets you access and manage every item connected to the logic network, turning the factory into a unified inventory."
		"Build it to begin your intelligent storage system."
	]
	quest.1900000000000057.title: "Storage Terminal"
	quest.1900000000000058.quest_desc: [
		"Logic Cables connect Integrated Dynamics components and allow variables and information to travel between them."
		"Without cables, the terminal cannot communicate with Item Interfaces."
	]
	quest.1900000000000058.title: "Logic Cable"
	quest.1900000000000059.quest_desc: [
		"The Item Interface connects the logic network to physical inventories such as chests and barrels. It allows the Storage Terminal to see and access the items inside those inventories."
		"Connect it to the terminal with Logic Cables to begin using the system."
	]
	quest.1900000000000059.title: "Item Interface"
	quest.190000000000005A.quest_desc: [
		"The Portable Storage Terminal brings the power of the Storage Terminal into your hand, allowing access to the network from anywhere within connector range."
		"To function, it needs a Mono-Directional Connector on the network."
	]
	quest.190000000000005A.title: "Portable Storage Terminal"
	quest.190000000000005B.quest_desc: [
		"The Mono-Directional Connector forms the basis for wireless communication between the portable terminal and the logic network."
		"Install it near your storage system."
	]
	quest.190000000000005B.title: "Mono-Directional Connector"
	quest.190000000000005C.quest_desc: [
		"The Omni-Directional Connector is the upgraded form of the mono-directional connector, accepting connections in every direction and extending the flexibility of your Portable Terminal setup."
		"With it, your storage network becomes easier to expand and connect."
	]
	quest.190000000000005C.title: "Omni-Directional Connector"
	quest.1900000000000060.quest_desc: [
		"In addition to Menril Resin, Integrated Dynamics also uses Chorus Resin for advanced components."
		"Obtain Chorus Resin so you can create its corresponding block."
	]
	quest.1900000000000060.title: "Chorus Resin"
	quest.1900000000000061.quest_desc: [
		"Just like Menril Resin, Chorus Resin can be compacted into a solid block."
		"Craft the block to continue toward crystallization."
	]
	quest.1900000000000061.title: "Block of Chorus Resin"
	quest.1900000000000062.quest_desc: [
		"Crystallizing the Chorus Resin Block produces a high-purity crystallized chunk used in the Logic Director."
		"Produce one to unlock the Director."
	]
	quest.1900000000000062.title: "Crystallized Chorus Chunk"
	quest.1900000000000063.quest_desc: [
		"The Logic Director is an advanced component used to direct and organize the flow of variables through the network."
		"It is required to build the Omni-Directional Connector."
	]
	quest.1900000000000063.title: "Logic Director"
	quest.1A00000000000001.quest_desc: [
		"Create masters rotation, but now we will connect it to the world of FE power."
		"Crafts & Additions provides motors, alternators, wires, and electrical storage."
		"This chapter teaches you how to convert rotation into electricity and electricity back into rotation."
	]
	quest.1A00000000000001.title: "Beyond Motion"
	quest.1A00000000000002.quest_desc: [
		"A base material for electrical and mechanical components."
		"Produce a Zinc Sheet to begin the manufacturing chain."
	]
	quest.1A00000000000002.title: "Zinc Sheet"
	quest.1A00000000000003.quest_desc: [
		"A conductive rod used to make wires and connectors."
		"It is essential for the Crafts & Additions electrical network."
	]
	quest.1A00000000000003.title: "Copper Rod"
	quest.1A00000000000004.quest_desc: [
		"A basic mechanical material for structures and components."
		"It can also be processed into Iron Wire."
	]
	quest.1A00000000000004.title: "Iron Rod"
	quest.1A00000000000005.quest_desc: [
		"A machine that turns ingots and plates into rods and wires."
		"§6Ponder:§r use the visualization to see how it can be automated with Belts and Funnels."
	]
	quest.1A00000000000005.title: "Rolling Mill"
	quest.1A00000000000006.quest_desc: [
		"A low-current conductor used with small connectors."
		"Produce it with the Rolling Mill and keep a few pieces ready for the first electrical links."
	]
	quest.1A00000000000006.title: "Copper Wire"
	quest.1A00000000000007.quest_desc: [
		"Stores copper wire and lets you link two compatible connectors."
		"The empty spool is returned after the connection, so it can be reused."
	]
	quest.1A00000000000007.title: "Copper Spool"
	quest.1A00000000000008.quest_desc: [
		"A basic low-current conductive wire."
		"It is an alternative to copper in specific recipes and expands your stock of electrical components."
	]
	quest.1A00000000000008.title: "Iron Wire"
	quest.1A00000000000009.quest_desc: [
		"A high-current conductor used with larger connectors."
		"It can handle more power than copper and prepares the network for heavier loads."
	]
	quest.1A00000000000009.title: "Gold Wire"
	quest.1A0000000000000A.quest_desc: [
		"An alloy of gold and silver with excellent conductivity."
		"It is the basis for advanced high-current wires and electrical components."
	]
	quest.1A0000000000000A.title: "Electrum Ingot"
	quest.1A0000000000000B.quest_desc: [
		"A high-current conductor with increased capacity."
		"Use it with large connectors and machines that need a stronger electrical backbone."
	]
	quest.1A0000000000000B.title: "Electrum Wire"
	quest.1A0000000000000C.quest_desc: [
		"Connects FE-compatible blocks to low-current wires."
		"Use a Copper Spool to create links between connectors and begin building your electrical network."
	]
	quest.1A0000000000000C.title: "Small Connector"
	quest.1A0000000000000D.quest_desc: [
		"A high-current connector designed for Gold and Electrum wire."
		"It becomes important when the factory starts moving larger amounts of energy between machines."
	]
	quest.1A0000000000000D.title: "Large Connector"
	quest.1A0000000000000E.quest_desc: [
		"A component that stores electrical charge temporarily."
		"It is used as a building block for motors, alternators and other electromechanical devices."
	]
	quest.1A0000000000000E.title: "Capacitor"
	quest.1A0000000000000F.quest_desc: [
		"Converts FE energy into Create rotation."
		"It lets you power mechanical lines without running long shaft networks. Adjust the RPM from the rear panel and provide enough energy for the selected speed."
	]
	quest.1A0000000000000F.title: "Electric Motor"
	quest.1A00000000000010.quest_desc: [
		"Converts Create rotation into FE energy."
		"It requires at least 32 RPM to operate, and power production rises with rotational speed."
	]
	quest.1A00000000000010.title: "Alternator"
	quest.1A00000000000011.quest_desc: [
		"Build a system that converts rotation into electricity and then electricity back into rotation."
		"Confirm that the Alternator and Electric Motor work together as one integrated system."
	]
	quest.1A00000000000011.title: "Electromechanical Circuit"
	quest.1A00000000000012.quest_desc: [
		"A multiblock structure designed to store large amounts of FE energy."
		"Configure input and output connectors so the stored power can be charged and distributed safely."
	]
	quest.1A00000000000012.title: "Accumulator"
	quest.1A00000000000013.quest_desc: [
		"Transfers FE energy between moving contraptions and the stationary factory."
		"Align two interfaces so mobile equipment can charge or discharge without permanently wiring the contraption to the base."
	]
	quest.1A00000000000013.title: "Portable Energy Interface"
	quest.1A00000000000014.quest_desc: [
		"Controls the flow of FE energy with a redstone signal."
		"Use it when you need the electrical side of the factory to react automatically to machine state or control logic."
	]
	quest.1A00000000000014.title: "Redstone Relay"
	quest.1A00000000000015.quest_desc: [
		"A flammable fluid produced from seeds."
		"It can be used as a liquid fuel and opens the renewable-fuel branch of Crafts & Additions."
	]
	quest.1A00000000000015.title: "Seed Oil"
	quest.1A00000000000016.quest_desc: [
		"A more efficient liquid fuel refined from Seed Oil."
		"Use it in compatible burners and machines that accept flammable liquids; check JEI for the exact processing route in this pack."
	]
	quest.1A00000000000016.title: "Biofuel"
	quest.1A00000000000017.quest_desc: [
		"Compressed organic material used as a solid fuel."
		"It gives plant waste a useful role in the factory and supports the renewable-energy branch."
	]
	quest.1A00000000000017.title: "Biomass"
	quest.1A00000000000018.quest_desc: [
		"Allows a Blaze Burner to accept flammable liquids."
		"§6Ponder:§r use the visualization to see the intended setup and then feed it with buckets or pipes supported by the pack."
	]
	quest.1A00000000000018.title: "Strawed Blaze Burner"
	quest.1A00000000000019.quest_desc: [
		"Charges FE-powered items placed beneath it."
		"When enabled with redstone it can also damage nearby creatures, making it useful both as a charger and as part of controlled automation."
	]
	quest.1A00000000000019.title: "Tesla Coil"
	quest.1A0000000000001A.quest_desc: [
		"You have mastered conversion between Create rotation and FE energy."
		"Your factory can now combine motors, alternators, storage and automation as one electrical-mechanical infrastructure."
	]
	quest.1A0000000000001A.title: "Electromechanical Bridge"
	quest.1B00000000000001.quest_desc: ["The Bee Cage is the basic tool for capturing and transporting Productive Bees. Craft one so you can begin building your apiary without leading every bee across the world."]
	quest.1B00000000000001.title: "Bee Cage"
	quest.1B00000000000002.quest_desc: ["Honey Treats are used in several bee interactions, including feeding and breeding. Prepare a few units because they will be a recurring consumable while the apiary expands."]
	quest.1B00000000000002.title: "Honey Treat"
	quest.1B00000000000003.quest_desc: ["Capture a suitable bee with the Bee Cage and bring it back to your base. This step marks the practical beginning of Productive Bees; exact species and conditions can be checked in JEI."]
	quest.1B00000000000003.title: "Your First Bee"
	quest.1B00000000000004.quest_desc: ["Start with a simple hive to understand the basic cycle of shelter, bee entry, and bee exit. It is the bridge to the Advanced Hive, where production begins to scale."]
	quest.1B00000000000004.title: "Your First Hive"
	quest.1B00000000000005.quest_desc: ["The Advanced Hive is the core of Productive Bees production. It accepts upgrades and lets you turn a small apiary into a continuous resource-generation structure."]
	quest.1B00000000000005.title: "Advanced Hive"
	quest.1B00000000000006.quest_desc: ["The Expansion Box increases Advanced Hive capacity and prepares room for a more efficient operation. Install it with the hive before moving on to production upgrades."]
	quest.1B00000000000006.title: "Expansion Box"
	quest.1B00000000000007.quest_desc: ["Place the Advanced Hive, attach the Expansion Box, and put your bees in conditions where they can work. Confirm this step once the setup is functional and ready to produce combs."]
	quest.1B00000000000007.title: "Build Your First Apiary"
	quest.1B00000000000008.quest_desc: ["Obtain your first Honeycomb from a working hive. Combs are the raw material that will be processed into honey and, later, industrial resources."]
	quest.1B00000000000008.title: "Your First Honeycomb"
	quest.1B00000000000009.quest_desc: ["The Centrifuge turns combs into useful products. Craft the machine and check JEI to see the possible outputs from each comb type before planning your processing line."]
	quest.1B00000000000009.title: "Centrifuge"
	quest.1B0000000000000A.quest_desc: ["Process a comb in the Centrifuge and confirm that you understand the basic flow: the hive produces the comb, centrifuging separates the products, and the results move on to storage or factory use."]
	quest.1B0000000000000A.title: "First Processing"
	quest.1B0000000000000B.quest_desc: ["Some species can be obtained through breeding. Use the combinations shown by JEI and observe each bee's requirements to expand your catalog without relying only on exploration."]
	quest.1B0000000000000B.title: "Bee Breeding"
	quest.1B0000000000000C.quest_desc: ["Certain bees are created through conversion by using a specific item or block on another species. §bJEI:§r check the installed recipe for the exact condition and use this mechanic to reach new resource lines."]
	quest.1B0000000000000C.title: "Bee Conversion"
	quest.1B00000000000010.quest_desc: ["Produce the comb associated with coal. This is one of the first proofs that an apiary can turn beekeeping into a renewable source of raw materials."]
	quest.1B00000000000010.title: "Coal Comb"
	quest.1B00000000000011.quest_desc: ["Produce an Iron Comb and process it when needed. The goal is to begin replacing part of manual mining with renewable generation inside the apiary."]
	quest.1B00000000000011.title: "Iron Comb"
	quest.1B00000000000012.quest_desc: ["Produce a Copper Comb. Copper appears throughout many modpack technologies, so a renewable source will be valuable to future factories."]
	quest.1B00000000000012.title: "Copper Comb"
	quest.1B00000000000013.quest_desc: ["Produce a Redstone Comb. Redstone is consumed by control, logic, and technological components, making this species especially useful for continuous production."]
	quest.1B00000000000013.title: "Redstone Comb"
	quest.1B00000000000014.quest_desc: ["Produce a Gold Comb. The goal of this branch is to build resource diversity in the apiary before moving on to more advanced materials."]
	quest.1B00000000000014.title: "Gold Comb"
	quest.1B00000000000015.quest_desc: ["Produce a Lapis Lazuli Comb and keep the species available in your apiary. This completes the initial set of renewable resources for this stage."]
	quest.1B00000000000015.title: "Lapis Lazuli Comb"
	quest.1B00000000000016.quest_desc: ["You have established the main basic resource lines in the apiary. From this point onward, new bees require more preparation, breeding, or conversion."]
	quest.1B00000000000016.title: "Basic Catalog Complete"
	quest.1B00000000000017.quest_desc: ["Produce a Diamond Comb. This material marks entry into a higher-value resource tier, where stable production becomes more important than obtaining only one unit."]
	quest.1B00000000000017.title: "Diamond Comb"
	quest.1B00000000000018.quest_desc: ["Produce an Emerald Comb and confirm the new species in your catalog. §bJEI:§r use the recipe viewer to verify how to obtain the bee and what centrifuging can produce."]
	quest.1B00000000000018.title: "Emerald Comb"
	quest.1B00000000000019.quest_desc: ["Produce the Rose Quartz Comb configured for this quest. The name is aligned with the item actually detected by the task, avoiding confusion with Nether Quartz."]
	quest.1B00000000000019.title: "Rose Quartz Comb"
	quest.1B0000000000001A.quest_desc: ["Produce a Blaze-related comb. This line begins covering resources that would normally require exploration or combat, making the apiary increasingly valuable for automation."]
	quest.1B0000000000001A.title: "Blaze Comb"
	quest.1B0000000000001B.quest_desc: ["The advanced species for this stage are now under your control. The focus shifts from variety to technological materials and upgrades for the hive itself."]
	quest.1B0000000000001B.title: "Advanced Catalog Complete"
	quest.1B0000000000001C.quest_desc: ["Produce a Brass Comb. Since Brass is important to Create infrastructure, this species directly links Productive Bees to your main factory."]
	quest.1B0000000000001C.title: "Brass Comb"
	quest.1B0000000000001D.quest_desc: ["Produce a Bronze Comb and keep the species available. Renewable technological alloys help the apiary support other progression trees in the modpack."]
	quest.1B0000000000001D.title: "Bronze Comb"
	quest.1B0000000000001E.quest_desc: ["Produce an Ender Comb. This resource opens a more advanced material line and reduces dependence on manual gathering in dangerous dimensions."]
	quest.1B0000000000001E.title: "Ender Comb"
	quest.1B00000000000020.quest_desc: ["You have completed the technological resource set planned for this Productive Bees stage. The next step is improving apiary efficiency and automating the route from combs to storage."]
	quest.1B00000000000020.title: "Technology Catalog Complete"
	quest.1B00000000000021.quest_desc: ["The Productivity Upgrade increases production yield. Install upgrades gradually and use JEI and hive information to observe the effects and limits available in the installed version."]
	quest.1B00000000000021.title: "Productivity Upgrade"
	quest.1B00000000000022.quest_desc: ["The Time Upgrade reduces the duration of production cycles. It becomes useful once the infrastructure is working and comb generation speed becomes the bottleneck."]
	quest.1B00000000000022.title: "Speed Upgrade"
	quest.1B00000000000023.quest_desc: ["The Simulation Upgrade lets the hive operate in a more controlled model, ideal for industrial installations. It becomes the foundation of the continuous production line we will build next."]
	quest.1B00000000000023.title: "Simulation Upgrade"
	quest.1B00000000000024.quest_desc: ["Configure an Advanced Hive with a Simulation Upgrade and confirm that production works under the correct conditions. This uses a checkmark because FTB Quests cannot validate the hive's full internal configuration."]
	quest.1B00000000000024.title: "Simulated Production"
	quest.1B00000000000025.quest_desc: ["Automate comb extraction from the hive so they move to processing or storage without manual collection. Use whichever transport system best fits the current stage of the modpack."]
	quest.1B00000000000025.title: "Automatic Comb Transport"
	quest.1B00000000000026.quest_desc: ["Automate the Centrifuge output as well. An ideal line receives combs, processes them, and sends each product to its next destination without the player emptying the machine."]
	quest.1B00000000000026.title: "Automatic Centrifuge Output"
	quest.1B00000000000027.quest_desc: ["Keep four Centrifuges available to increase processing capacity. This quest turns centrifuging into a factory-scale stage prepared to handle several hives at once."]
	quest.1B00000000000027.title: "Parallel Processing"
	quest.1B00000000000028.quest_desc: ["Build an apiary with Advanced Hives, upgrades, comb transport, and automatic processing. Confirm once the structure can operate as an integrated sector of your factory."]
	quest.1B00000000000028.title: "Industrial Apiary"
	quest.1B00000000000029.quest_desc: ["You have turned beekeeping into an automated source of resources. This milestone closes the current Productive Bees stage and leaves the system ready for future species and modpack integrations."]
	quest.1B00000000000029.title: "The Industrial Swarm"
	quest.1C00000000000001.quest_desc: [
		"You already understand renewable resource sources: Mystical Agriculture and Productive Bees."
		"Now we will turn them into fully automated Create factories."
		"This chapter teaches you how to harvest, collect, transport, and process resources without manual intervention."
	]
	quest.1C00000000000001.title: "Agricultural Integration"
	quest.1C00000000000010.quest_desc: [
		"Start with Iron Seeds, a basic and abundant resource source."
		"They will become the foundation of our automated Mystical Agriculture farm."
	]
	quest.1C00000000000010.title: "Iron Seeds"
	quest.1C00000000000011.quest_desc: ["Obtain one Iron Essence to confirm that the crop is producing correctly."]
	quest.1C00000000000011.title: "Iron Essence"
	quest.1C00000000000012.quest_desc: [
		"A central component for harvesting crops automatically."
		"It can be mounted on contraptions or fixed structures to sweep across a growing area."
	]
	quest.1C00000000000012.title: "Mechanical Harvester"
	quest.1C00000000000013.quest_desc: [
		"The base for building rotating and moving contraptions."
		"Use it to move Harvesters and Ploughs across the field."
	]
	quest.1C00000000000013.title: "Mechanical Bearing"
	quest.1C00000000000014.quest_desc: [
		"A structural component that supports Harvesters on a rotating contraption."
		"Use a Radial Chassis to cover a circular growing area around the axis."
	]
	quest.1C00000000000014.title: "Radial Chassis"
	quest.1C00000000000015.quest_desc: ["Attach a chest to the contraption so harvested items can accumulate while it moves."]
	quest.1C00000000000015.title: "Contraption Inventory"
	quest.1C00000000000016.quest_desc: [
		"Transfers items from moving contraptions into the factory."
		"When aligned, a pair of interfaces can transfer entire inventories, making them essential for rotating harvesters."
	]
	quest.1C00000000000016.title: "Portable Storage Interface"
	quest.1C00000000000017.quest_desc: ["A high-capacity receiving buffer, ideal for collecting the output of the farm."]
	quest.1C00000000000017.title: "Item Vault"
	quest.1C00000000000018.quest_desc: [
		"Controls item input and output between inventories and transport lines."
		"Use it to pull farm products out and send them toward processing."
	]
	quest.1C00000000000018.title: "Andesite Funnel"
	quest.1C00000000000019.quest_desc: [
		"Connects shafts to create transport belts."
		"This logistics backbone carries harvested resources toward storage and processing."
	]
	quest.1C00000000000019.title: "Belt Connector"
	quest.1C0000000000001A.quest_desc: [
		"Build a rotating contraption with Mechanical Harvesters over the Iron crop."
		"Include a chest so the harvested items can be stored during operation."
	]
	quest.1C0000000000001A.title: "Build the Farming Contraption"
	quest.1C0000000000001B.quest_desc: ["Use a Portable Storage Interface to unload the contraption into an Item Vault without manual intervention."]
	quest.1C0000000000001B.title: "Unload the Harvest Automatically"
	quest.1C0000000000001C.quest_desc: [
		"Prove that your Mystical Agriculture farm is producing at scale."
		"Accumulate 64 Iron Essence using automation only."
	]
	quest.1C0000000000001C.title: "64 Iron Essence"
	quest.1C0000000000001D.quest_desc: [
		"A block that performs crafting recipes automatically through Create production lines."
		"It will be used to turn Iron Essence into Iron Ingots."
	]
	quest.1C0000000000001D.title: "Mechanical Crafter"
	quest.1C0000000000001E.quest_desc: [
		"Configure Mechanical Crafters to process Iron Essence into Iron Ingots automatically."
		"Use Funnels and Belts to feed ingredients and remove the finished products."
	]
	quest.1C0000000000001E.title: "Automate Essence → Resource"
	quest.1C0000000000001F.quest_desc: [
		"Prove that your Mystical production line can turn Essence into ingots."
		"Accumulate 64 Iron Ingots from the automated farm output."
	]
	quest.1C0000000000001F.title: "64 Iron Ingots (Mystical)"
	quest.1C00000000000020.quest_desc: [
		"Speed up the growth of Mystical Agriculture crops."
		"Install it near the crops to increase farm production."
	]
	quest.1C00000000000020.title: "Growth Accelerator"
	quest.1C00000000000021.quest_desc: ["Integrate Growth Accelerators into your farm and confirm that the harvesting rate increases."]
	quest.1C00000000000021.title: "Accelerated Crop Production"
	quest.1C00000000000030.quest_desc: [
		"An advanced hive that supports upgrades and large-scale production."
		"This is the foundation of our bio-industry."
	]
	quest.1C00000000000030.title: "Advanced Hive"
	quest.1C00000000000031.quest_desc: ["Expands Advanced Hive capacity, allowing more bees and upgrades."]
	quest.1C00000000000031.title: "Expansion Box"
	quest.1C00000000000032.quest_desc: [
		"A comb produced by an Iron Bee."
		"It is the raw material that will be collected and processed."
	]
	quest.1C00000000000032.title: "Iron Comb"
	quest.1C00000000000033.quest_desc: ["Use an Andesite Funnel to automatically extract Combs from the Advanced Hive."]
	quest.1C00000000000033.title: "Extraction Funnel"
	quest.1C00000000000034.quest_desc: ["Transport the extracted Combs to the buffer."]
	quest.1C00000000000034.title: "Belt Connector"
	quest.1C00000000000035.quest_desc: ["An intermediate buffer used to accumulate Combs before processing."]
	quest.1C00000000000035.title: "Item Vault"
	quest.1C00000000000036.quest_desc: ["Confirm that Combs are continuously removed from the Advanced Hive without manual intervention."]
	quest.1C00000000000036.title: "Automate Comb Extraction"
	quest.1C00000000000037.quest_desc: [
		"A machine that processes Combs into useful resources."
		"Create does not replace its role, but it can handle transport and distribution around it."
	]
	quest.1C00000000000037.title: "Centrifuge"
	quest.1C00000000000038.quest_desc: [
		"Build four Centrifuges for parallel processing."
		"This increases the capacity of the production line."
	]
	quest.1C00000000000038.title: "4 Centrifuges"
	quest.1C00000000000039.quest_desc: ["Distributes items across multiple outputs and is useful for splitting Combs between the Centrifuges."]
	quest.1C00000000000039.title: "Brass Tunnel"
	quest.1C0000000000003A.quest_desc: [
		"A mechanical arm that can route items precisely between multiple destinations."
		"It helps distribute Combs across processing machines."
	]
	quest.1C0000000000003A.title: "Mechanical Arm"
	quest.1C0000000000003B.quest_desc: [
		"Configure Comb distribution across all four Centrifuges using Brass Tunnels or Mechanical Arms."
		"Confirm that the flow remains continuous and balanced."
	]
	quest.1C0000000000003B.title: "Distribute Combs Automatically"
	quest.1C0000000000003C.quest_desc: [
		"Prove that your apiary can produce Combs at industrial scale."
		"Accumulate 64 Iron Combs."
	]
	quest.1C0000000000003C.title: "64 Iron Combs"
	quest.1C0000000000003D.quest_desc: ["Automatically collect the products from the Centrifuges and transport them into storage."]
	quest.1C0000000000003D.title: "Automate Output Extraction"
	quest.1C0000000000003E.quest_desc: ["Prove that Comb processing can generate a useful quantity of Iron Ingots."]
	quest.1C0000000000003E.title: "64 Iron Ingots (Bees)"
	quest.1C0000000000003F.quest_desc: [
		"Enables continuous industrial production without free-roaming bees."
		"It turns the apiary into a stable production installation."
	]
	quest.1C0000000000003F.title: "Simulation Upgrade"
	quest.1C00000000000040.quest_desc: ["Configure Advanced Hives with Simulation Upgrades and confirm that production continues without interruption."]
	quest.1C00000000000040.title: "Continuous-Production Apiary"
	quest.1C00000000000050.quest_desc: [
		"Choose your renewable route: Mystical Agriculture OR Productive Bees. You do not need to complete both to continue."
		"Finish either branch, then stockpile 256 Iron Ingots using the route you prefer. The other branch remains fully optional and can be explored later."
	]
	quest.1C00000000000050.title: "Choose Your Resource Route"
	quest.1C00000000000051.quest_desc: [
		"You proved resource independence through at least one renewable route."
		"Mystical and Productive Bees are alternative progression paths, not two requirements. Use the one that fits your factory — or explore both if you want."
	]
	quest.1C00000000000051.title: "Resource Independence"
	quest.1D00000000000001.quest_desc: [
		"Until now, your factory transmitted power as rotation."
		"Create: New Age introduces a new form of energy: electricity."
		"With it, you can transport power over long distances and run machines without endless shafts."
	]
	quest.1D00000000000001.title: "The Discovery of Electricity"
	quest.1D00000000000002.quest_desc: [
		"The primary source of Thorium, a radioactive material used in nuclear fuel."
		"It belongs to the electromechanical chain of Create: New Age and prepares the next stage of generation, transmission or power use. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1D00000000000002.title: "Thorium Ore"
	quest.1D00000000000003.quest_desc: [
		"The base material for nuclear fuel. Keep a reserve for later stages."
		"It belongs to the electromechanical chain of Create: New Age and prepares the next stage of generation, transmission or power use. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.1D00000000000003.title: "Thorium"
	quest.1D00000000000004.quest_desc: [
		"Processed and unstable Thorium used in advanced nuclear fuel."
