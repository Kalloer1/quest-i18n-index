	quest.1D00000000000011.title: "Basic Motor Extension"
	quest.1D00000000000012.quest_desc: ["Use the motor to generate rotation and power a Create machine without relying on long shaft lines."]
	quest.1D00000000000012.title: "Power a Create Machine"
	quest.1D00000000000013.quest_desc: [
