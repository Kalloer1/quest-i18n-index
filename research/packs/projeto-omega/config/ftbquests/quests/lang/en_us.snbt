	quest.1F0000000000002B.title: "Mystical Automation"
	quest.1F0000000000002C.quest_desc: ["Produce 64 Iron Essence to prove that renewable production is working at scale."]
	quest.1F0000000000002C.title: "Essence at Scale"
	quest.1F0000000000002D.quest_desc: ["You have mastered every planned seed and the automation behind them. Your factory now has a renewable source of resources."]
	quest.1F0000000000002D.title: "Master of Mystical Agriculture"
	quest.4000000000000001.quest_desc: [
		"Create: Connected expands the factory with advanced transmission, stress management and redstone components."
		"This chapter focuses on controlling complex kinetic networks, protecting them from overload and building more deliberate automation."
	]
	quest.4000000000000001.title: "Control Engineering"
	quest.4000000000000002.quest_desc: [
		"A gearbox whose four horizontal output directions can be configured individually with a Wrench."
		"Use it when a compact junction needs precise control over which way each connected shaft rotates."
	]
	quest.4000000000000002.title: "Brass Gearbox"
	quest.4000000000000003.quest_desc: [
		"A gearbox with shaft connections on all six faces."
		"The top and bottom outputs run at half speed, so account for the ratio when mixing vertical and horizontal transmission."
	]
	quest.4000000000000003.title: "6-Way Gearbox"
	quest.4000000000000004.quest_desc: [
		"A gearbox designed to preserve rotation direction through specific turns while straight-through connections behave differently."
		"Use it when ordinary gearboxes would force an unwanted inversion."
	]
	quest.4000000000000004.title: "Parallel Gearbox"
	quest.4000000000000005.quest_desc: [
		"A kinetic relay that carries two independent rotational paths through the same block space."
		"It is useful for crossing shaft networks without merging their motion."
	]
	quest.4000000000000005.title: "Cross Connector"
	quest.4000000000000006.quest_desc: [
		"An encased chain-transmission component with an additional cogwheel connection."
		"It helps carry rotation along compact lines while keeping connected shafts synchronized."
	]
	quest.4000000000000006.title: "Encased Chain Cogwheel"
	quest.4000000000000007.quest_desc: [
		"A clutch that engages only after the input reaches a configurable RPM threshold."
		"Use it to make parts of the factory come online automatically when enough speed is available."
	]
	quest.4000000000000007.title: "Centrifugal Clutch"
	quest.4000000000000008.quest_desc: [
		"A clutch that engages only when the input rotates in the allowed direction."
		"It acts like a one-way mechanical link and is useful in systems where reverse rotation must not propagate."
	]
	quest.4000000000000008.title: "Freewheel Clutch"
	quest.4000000000000009.quest_desc: [
		"A clutch with reversed redstone behavior: it stays disengaged by default and transmits rotation when powered."
		"Use it when the control logic is easier to express as an active-enable signal."
	]
	quest.4000000000000009.title: "Inverted Clutch"
	quest.400000000000000A.quest_desc: [
		"A gearshift whose redstone behavior reverses the usual transmission logic."
		"It gives you another compact way to change rotation direction inside automated machinery."
	]
	quest.400000000000000A.title: "Inverted Gearshift"
	quest.400000000000000B.quest_desc: [
		"A protective clutch that disconnects after a configurable delay when the network is overstressed."
		"Reset it with a Wrench or redstone pulse after the cause of the overload has been fixed."
	]
	quest.400000000000000B.title: "Overstress Clutch"
	quest.400000000000000C.quest_desc: [
		"A single-use mechanical connector designed to break when the network becomes overstressed."
		"Treat it as a mechanical fuse: cheap protection for machinery that should fail safely before something more important does."
	]
	quest.400000000000000C.title: "Shear Pin"
	quest.400000000000000D.quest_desc: [
		"Build a protection system using an Overstress Clutch or Shear Pin."
		"Deliberately create a controlled overload and confirm that the protection isolates the problem instead of letting the whole network stall."
	]
	quest.400000000000000D.title: "Network Protection"
	quest.400000000000000E.quest_desc: [
		"A device that deliberately applies enormous stress when powered, forcing a connected kinetic network to stop."
		"Use it as an emergency or process brake where a hard mechanical stop is required."
	]
	quest.400000000000000E.title: "Brake"
	quest.400000000000000F.quest_desc: [
		"Stores stress capacity for later use."
		"Charge it from rotation and discharge it when another network needs support. §6Ponder:§r use the visualization to understand the storage and release behavior before integrating it into a large system."
	]
	quest.400000000000000F.title: "Kinetic Battery"
	quest.4000000000000010.quest_desc: [
		"Charge a Kinetic Battery to its intended level and then discharge it into a network on demand."
		"Confirm that stored kinetic capacity can actually support the connected machinery when the normal source is reduced or isolated."
	]
	quest.4000000000000010.title: "Charging the Kinetic Battery"
	quest.4000000000000011.quest_desc: [
		"Transfers a controlled amount of stress capacity between two otherwise separate kinetic networks."
		"Use it when systems should share available power without becoming one continuous shaft network."
	]
	quest.4000000000000011.title: "Kinetic Bridge"
	quest.4000000000000012.quest_desc: [
		"Configure a Kinetic Bridge between two separate networks."
		"Verify that stress capacity crosses the bridge while the networks remain mechanically isolated from one another."
	]
	quest.4000000000000012.title: "Bridging Two Networks"
	quest.4000000000000013.quest_desc: [
		"An electronic-style component used in advanced redstone devices from Create: Connected."
		"It is the common building block for programmable pulse and wireless-control equipment later in the chapter."
	]
	quest.4000000000000013.title: "Control Chip"
	quest.4000000000000014.quest_desc: [
		"Outputs redstone signals according to a programmed sequence of instructions."
		"Use it when a machine requires timed steps rather than a single constant signal."
	]
	quest.4000000000000014.title: "Sequenced Pulse Generator"
	quest.4000000000000015.quest_desc: [
		"Program a useful pulse sequence and use it to control a machine or production step."
		"Confirm that the instructions execute in the intended order and timing before relying on the circuit automatically."
	]
	quest.4000000000000015.title: "Sequenced Automation"
	quest.4000000000000016.quest_desc: [
		"Sends redstone signals wirelessly between compatible endpoints."
		"Configure its frequency with the items placed in its slots so only matching devices respond."
	]
	quest.4000000000000016.title: "Linked Transmitter"
	quest.4000000000000017.quest_desc: [
		"Link two devices with a matching Linked Transmitter configuration."
		"Confirm that a redstone change at the source reaches the remote side without a physical dust line."
	]
	quest.4000000000000017.title: "Wireless Redstone"
	quest.4000000000000018.quest_desc: [
		"A blank catalyst that can be prepared for a specific Encased Fan bulk-processing mode."
		"It is the base item for compact, dedicated fan-processing stations."
	]
	quest.4000000000000018.title: "Empty Fan Catalyst"
	quest.4000000000000019.quest_desc: [
		"A catalyst dedicated to bulk washing."
		"Use it with an Encased Fan to create a compact washing station without rebuilding the surrounding environment each time."
	]
	quest.4000000000000019.title: "Fan Splashing Catalyst"
	quest.400000000000001A.quest_desc: [
		"A catalyst dedicated to bulk smoking."
		"It provides a compact alternative for recipes that normally require the fan to blow through the corresponding heat source."
	]
	quest.400000000000001A.title: "Fan Smoking Catalyst"
	quest.400000000000001B.quest_desc: [
		"A catalyst dedicated to bulk blasting."
		"Use it for ores and other blasting-compatible materials when you want the fan-processing setup to stay compact."
	]
	quest.400000000000001B.title: "Fan Blasting Catalyst"
	quest.400000000000001C.quest_desc: [
		"A catalyst dedicated to bulk haunting."
		"It gives soul-fire-style processing a reusable dedicated component inside automated lines."
	]
	quest.400000000000001C.title: "Fan Haunting Catalyst"
	quest.400000000000001D.quest_desc: [
		"Extends access to an inventory into a more convenient position."
		"It does not add storage space; instead, connected components can interact with the port as if they were reaching the original inventory."
	]
	quest.400000000000001D.title: "Inventory Access Port"
	quest.400000000000001E.quest_desc: [
		"Provides controlled access to two inventories through one interface."
		"Use filters to decide which items should interact with each side and keep compact logistics readable."
	]
	quest.400000000000001E.title: "Inventory Bridge"
	quest.400000000000001F.quest_desc: [
		"Connect two inventories through an Inventory Bridge and configure useful filters."
		"Confirm that items are directed to the intended inventory instead of simply moving wherever space is available."
	]
	quest.400000000000001F.title: "Inventory Logistics"
	quest.4000000000000020.quest_desc: [
		"A decorative block that can mimic the appearance of another full block."
		"Apply a material with the normal interaction to match surrounding builds without changing the functional structure behind it."
	]
	quest.4000000000000020.title: "Copycat Block (Optional)"
	quest.4000000000000021.quest_desc: [
		"A decorative slab that copies the appearance of another block."
		"Its flexible placement, including vertical use where supported, makes it useful for industrial trim and compact detailing."
	]
	quest.4000000000000021.title: "Copycat Slab (Optional)"
	quest.4000000000000022.quest_desc: [
		"A decorative beam that copies another material's appearance."
		"Use it for frames, supports and visual finishing around machinery without adding another functional dependency to the progression."
	]
	quest.4000000000000022.title: "Copycat Beam (Optional)"
	quest.4000000000000023.quest_desc: [
		"You have mastered advanced transmission, overload protection, kinetic storage, programmable redstone and inventory logistics."
		"Your factory now behaves like a controlled engineering system rather than a collection of independent machines."
	]
	quest.4000000000000023.title: "Connected Mastery"
	quest.6C20000000000001.quest_desc: ["Apotheosis is neither removed nor left directionless. Progress through Affixes, Gems, Salvaging, Reforging and Augmenting before converging with the enchantment factory."]
	quest.6C20000000000001.title: "The Arcane Forge"
	quest.6C20000000000002.quest_desc: ["Use the Gem Cutting Table to improve gems and understand Gem Dust and rarity materials."]
	quest.6C20000000000002.title: "Gems and Cutting"
	quest.6C20000000000003.quest_desc: ["Affix gear you no longer need becomes material again. Salvaging closes the loot cycle instead of turning every drop into trash."]
	quest.6C20000000000003.title: "Salvaging"
	quest.6C20000000000004.quest_desc: ["Start with the Simple Reforging Table and learn to control affix progression."]
	quest.6C20000000000004.title: "First Reforging"
	quest.6C20000000000005.quest_desc: ["The Reforging Table expands rarity and affix control. Pack caps still apply: high power, not Fortune XXVI."]
	quest.6C20000000000005.title: "Advanced Reforging"
	quest.6C20000000000006.quest_desc: ["Use the Augmenting Table to work individual affixes and turn good equipment into specialized gear."]
	quest.6C20000000000006.title: "Augmenting"
	quest.6C20000000000007.quest_desc: ["Reach an endgame reforging material and prove you advanced beyond casual early-campaign loot."]
	quest.6C20000000000007.title: "Godforged Pearl"
	quest.6C20000000000008.quest_desc: ["Master Augmenting fuel and prepare mythical-grade equipment within the configured limits."]
	quest.6C20000000000008.title: "Sigil of Enhancement"
	quest.6C20000000000009.quest_desc: ["Unite Apotheosis with Create Enchantment Industry. XP, reforging, augmenting and enchantment printing now feed the Omega Arcane Core directly."]
	quest.6C20000000000009.title: "Arcane Convergence"
	quest.6C2000000000000A.quest_desc: ["Before reforging, understand Apotheosis loot: affixes and rarities define the extra attributes equipment can carry. This is informational because affixed mobs remain normal entity types rather than a separate ID FTB Quests can safely track."]
	quest.6C2000000000000A.title: "Affixes and Rarities"
	quest.6C2000000000000B.quest_desc: ["Connect Apotheosis enchanting progression to Create Enchantment Industry. Eterna, Quanta and Arcana govern enchanting potential while the XP and printing factory stays part of the industrial route."]
	quest.6C2000000000000B.title: "Apothic Enchanting"
	quest.6C2000000000000C.quest_desc: ["Combine gems, reforging, augmenting and high enchanting inside the pack's caps. Fortune VIII, Sharpness IX and Protection VIII represent endgame power; absurd levels above those caps are not part of progression."]
	quest.6C2000000000000C.title: "Mythic Equipment"
	quest.6C2000000000000D.quest_desc: ["Face affixed enemies and equipment as preparation for the Age of Titans. The goal is mastering Apotheosis mechanics, not turning every enemy into a giant health sponge."]
	quest.6C2000000000000D.title: "Apothic Bosses"
	quest.6D20000000000001.quest_desc: ["The Industrial Age opened the endgame. From here, the factory leaves the workshop: face the major bosses from Minecraft, Twilight Forest, Mowzie's Mobs, Bosses of Mass Destruction and Cataclysm.", "Boss health is scaled by Omega while original fight mechanics remain intact. Cataclysm stays at the top of the campaign, while the new exploration routes become real progression requirements."]
	quest.6D20000000000001.title: "The Age of Titans"
	quest.6D20000000000002.quest_desc: ["Defeat the Ender Dragon. The Dragon Egg becomes an industrial relic used by the Omega Star recipe."]
	quest.6D20000000000002.title: "The Ender Dragon"
	quest.6D20000000000003.quest_desc: ["The Nether Star remains a central endgame reagent. Earn it through combat before returning to the factory."]
	quest.6D20000000000003.title: "The Wither"
	quest.6D20000000000004.quest_desc: ["Face the Warden and bring Deep Dark technology into the final era. Echo Shards also enter the Omega Star."]
	quest.6D20000000000004.title: "The Warden"
	quest.6D20000000000005.quest_desc: ["The first Cataclysm Titan. Ender Guardian opens the Omega-scale boss ladder, and its Gauntlet of Guard becomes one of the relics used by the Titan Matrix."]
	quest.6D20000000000005.title: "Ender Guardian"
	quest.6D20000000000006.quest_desc: ["Netherite Monstrosity opens the Nether route. Its Monstrous Horn stops being an isolated trophy and becomes fuel for Omega industry."]
	quest.6D20000000000006.title: "Netherite Monstrosity"
	quest.6D20000000000007.quest_desc: ["Gather 8 bottles of Dragon's Breath. This draconic essence returns to the factory as a core material for the Draconic Matrix."]
	quest.6D20000000000007.title: "Draconic Proof"
	quest.6D20000000000008.quest_desc: ["Ancient Remnant represents the desert route. Beyond victory, gather Ancient Metal for the industrial synthesis of titan relics."]
	quest.6D20000000000008.title: "Ancient Remnant"
	quest.6D20000000000009.quest_desc: ["Scylla closes the main Cataclysm escalation of this era. It targets roughly 50,000 health, and its Essence of the Storm goes directly into the Titan Matrix."]
	quest.6D20000000000009.title: "Scylla"
	quest.6D2000000000000A.quest_desc: ["You mastered the respawn chain, recovered relics from every Titan and converted combat into industrial production. The Titan Matrix and Draconic Matrix now feed the Omega Star directly."]
	quest.6D2000000000000A.title: "Mastery of the Titans"
	quest.6D2000000000000B.quest_desc: ["Take Dragon's Breath, Ignitium, Cursium and industrial mechanisms to a 5×5 Mechanical Crafter. The Draconic Matrix turns exploration and combat into a mandatory industrial component of the Omega Star."]
	quest.6D2000000000000B.title: "Draconic Refining"
	quest.6D2000000000000C.quest_desc: ["The Titan Matrix now requires the Conquest Matrix at the core of its 7×7 recipe. This directly links Twilight Forest, Bosses of Mass Destruction and Mowzie's Mobs to the eight Cataclysm relics.", "Kills alone are not enough: boss trophies and rewards return to the factory and are consumed by the intermediate matrices."]
	quest.6D2000000000000C.title: "Titan Matrix"
	quest.6D2000000000000D.quest_desc: ["The mechanical Cataclysm route steps up. Harbinger has special attacks and its own regeneration, and provides the Witherite route required by industrial relic synthesis."]
	quest.6D2000000000000D.title: "The Harbinger"
	quest.6D2000000000000E.quest_desc: ["Ignis is the fire trial of the second branch. It has life steal and its own phases; its Ignitium Ingots now also participate in the Omega chain."]
	quest.6D2000000000000E.title: "Ignis"
	quest.6D2000000000000F.quest_desc: ["Take the Age of Titans into the depths. Leviathan uses percentage attacks, and its Tidal Claws become a mandatory Titan Matrix relic."]
	quest.6D2000000000000F.title: "The Leviathan"
	quest.6D20000000000010.quest_desc: ["The two Cataclysm branches converge here. Maledictus demands mastery of mobility and survival; Cursium becomes part of the final Titan refinement."]
	quest.6D20000000000010.title: "Maledictus"
	quest.6D20000000000011.quest_desc: [
		"We are not creating artificial spawn eggs for bosses Cataclysm can already revive. Ender Guardian, Netherite Monstrosity, Harbinger, Ancient Remnant and Scylla leave Boss Respawners when the option is enabled."
		"Bring the matching eye to the respawner: Void Eye, Monstrous Eye, Mech Eye, Desert Eye or Storm Eye. This makes boss materials renewable without replacing the mod’s own identity."
	]
	quest.6D20000000000011.title: "Respawn Protocol"
	quest.6D20000000000012.quest_desc: [
		"Before the Matrix, prove mastery of the entire Cataclysm campaign. Gather Gauntlet of Guard, Monstrous Horn, Witherite, Ignitium, Tidal Claws, Ancient Metal, Cursium and Essence of the Storm."
		"These materials do not end the adventure: they are consumed by the 7×7 Create industrial line that forms the Titan Matrix."
	]
	quest.6D20000000000012.title: "Relics of the Titans"
	quest.7101000000000001.quest_desc: [
		"Create already includes a complete railway system."
		"Now you will learn to build trains, program routes, and move items and fluids between factories."
		"This chapter turns your installations into a long-distance logistics network."
	]
	quest.7101000000000001.title: "The Age of Rails"
	quest.7101000000000002.quest_desc: [
		"A structural casing used to build railway components."
		"It serves as a foundation for tracks, stations, and train equipment."
	]
	quest.7101000000000002.title: "Railway Casing"
	quest.7101000000000003.quest_desc: [
		"Tracks used by trains to move through the railway."
		"Start with a short segment to test your first locomotive."
	]
	quest.7101000000000003.title: "Train Tracks"
	quest.7101000000000004.quest_desc: [
		"A departure and arrival point for trains."
		"It also serves as a location for assembling and disassembling train formations."
		"§6Ponder:§r use the visualization to see how the station integrates with the railway."
	]
	quest.7101000000000004.title: "Train Station"
	quest.7101000000000005.quest_desc: [
		"An item that allows manual control of a locomotive."
		"Place it on a seat or suitable structure to drive the train."
	]
	quest.7101000000000005.title: "Train Controls"
	quest.7101000000000006.quest_desc: [
		"Defines destinations and conditions for trains to operate automatically."
		"It is essential for repeatable routes and autonomous logistics."
	]
	quest.7101000000000006.title: "Train Schedule"
	quest.7101000000000007.quest_desc: [
		"Divides the railway into sections and organizes traffic."
		"Use signals to prevent collisions and control priorities."
	]
	quest.7101000000000007.title: "Track Signal"
	quest.7101000000000008.quest_desc: [
		"Detects passing trains and can emit a redstone signal."
		"Useful for automations triggered by arriving train formations."
	]
	quest.7101000000000008.title: "Track Observer"
	quest.7101000000000009.quest_desc: [
		"Build a small locomotive and make it travel along your tracks."
		"§6Ponder:§r use the visualization to visualize the correct assembly."
		"This is the foundation of all railway transport."
	]
	quest.7101000000000009.title: "Your First Locomotive"
	quest.710100000000000A.quest_desc: [
		"Attach an Item Vault to transport large quantities of items."
		"Your trains now have a purpose beyond sightseeing."
	]
	quest.710100000000000A.title: "Cargo Car"
	quest.710100000000000B.quest_desc: [
		"Attach a Fluid Tank to transport liquids such as Crude Oil or Diesel."
		"This creates a direct link to your industrial infrastructure."
	]
	quest.710100000000000B.title: "Fluid Tank Car"
	quest.710100000000000C.quest_desc: [
		"Load items onto your train, transport them between two points, and unload them."
		"Confirm that the logistics works without manual intervention."
	]
	quest.710100000000000C.title: "Item Transport"
	quest.710100000000000D.quest_desc: [
		"Transport liquids between tanks using your train."
		"Combine the route with pumping stations to automate fluid flow."
	]
	quest.710100000000000D.title: "Fluid Transport"
	quest.710100000000000E.quest_desc: [
		"Configure railway signals and prove that your line is properly organized."
		"A network with multiple trains needs traffic control."
	]
	quest.710100000000000E.title: "Functional Signaling"
	quest.710100000000000F.quest_desc: [
		"Program a train to operate automatically between stations."
		"Use schedules and stations to create autonomous logistics."
	]
	quest.710100000000000F.title: "Automatic Routes"
	quest.7101000000000010.quest_desc: [
		"You have built a complete railway: tracks, station, locomotive, cargo cars, signaling, and automatic routes."
		"Your factories can now connect through a long-distance logistics network."
	]
	quest.7101000000000010.title: "Industrial Railway Network"
	quest.7102000000000001.quest_desc: [
		"Enchantment Industry turns experience and enchanting into industrial processes."
		"You will liquefy XP, store it and feed machines that automate enchanting. The goal is to transform a manual activity into a repeatable production line."
	]
	quest.7102000000000001.title: "Welcome to Enchantment Industry"
	quest.7102000000000002.quest_desc: [
		"Stores experience directly from the player."
		"Use it as the first controlled buffer for liquid XP before routing experience into the rest of the system."
	]
	quest.7102000000000002.title: "Experience Hatch"
	quest.7102000000000003.quest_desc: [
		"Processes items that contain experience and converts that value into liquid XP."
		"Use it with Create's Item Drain so the current system can collect and route the resulting fluid through the factory."
	]
	quest.7102000000000003.title: "Mechanical Grindstone"
	quest.7102000000000004.quest_desc: [
		"The current setup uses Create's Item Drain as part of liquid collection and routing."
		"Combine it with the Mechanical Grindstone and connect the output to your fluid network."
	]
	quest.7102000000000004.title: "Item Drain — XP Collection"
	quest.7102000000000005.quest_desc: [
		"Assemble the complete grindstone setup and convert an experience-bearing item into liquid XP."
		"Confirm that the fluid is produced and can be collected before moving on."
	]
	quest.7102000000000005.title: "Liquefying Experience"
	quest.7102000000000006.quest_desc: [
		"A portable bucket of liquid experience."
		"Use it to move XP manually while your permanent fluid network is still being built."
	]
	quest.7102000000000006.title: "Experience Bucket"
	quest.7102000000000007.quest_desc: [
		"Collects nearby experience from players and XP orbs and stores it."
		"Its appearance reflects the amount stored, making it a useful visible buffer for the enchantment line."
	]
	quest.7102000000000007.title: "Experience Lantern"
	quest.7102000000000008.quest_desc: [
		"Build a practical experience-storage setup around the Experience Lantern."
		"Make sure you can deposit, hold and retrieve XP reliably before connecting more demanding machines."
	]
	quest.7102000000000008.title: "Experience Storage"
	quest.7102000000000009.quest_desc: [
		"An industrial enchanting table powered by liquid experience."
		"§6Ponder:§r use the visualization to learn how its level and operating modes are configured before building automation around it."
	]
	quest.7102000000000009.title: "Blaze Enchanter"
	quest.710200000000000A.quest_desc: [
		"Records enchanting information so it can be reused on equipment."
		"It becomes the reference item for forging and automated enchanting processes."
	]
	quest.710200000000000A.title: "Enchanting Template"
	quest.710200000000000B.quest_desc: [
		"Use the Blaze Enchanter to enchant an item automatically."
		"Confirm that liquid experience is consumed and the output receives the intended enchantment."
	]
	quest.710200000000000B.title: "First Industrial Enchantment"
	quest.710200000000000C.quest_desc: [
		"An advanced machine that applies, extracts and combines enchantments."
		"It works like an industrial anvil without normal repair-cost pressure. §6Ponder:§r use the visualization to understand each operating mode."
	]
	quest.710200000000000C.title: "Blaze Forger"
	quest.710200000000000D.quest_desc: [
		"Use the Blaze Forger to apply a stored template to an item."
		"Also try the extraction mode so you understand how enchantments can move through the production line."
	]
	quest.710200000000000D.title: "Enchanting Forge"
	quest.7102000000000011.quest_desc: [
		"Duplicates enchanted books, copies train schedules, renames items and supports several other printing jobs."
		"§bJEI:§r use the recipe viewer to see the exact printing recipes available in the installed version of the pack."
	]
	quest.7102000000000011.title: "Printer"
	quest.7102000000000012.quest_desc: [
		"Configure the Printer and produce a valid copy of an enchanted book or another supported item."
		"Confirm that the machine receives the required fluid and finishes the operation correctly."
	]
	quest.7102000000000012.title: "Industrial Printing"
	quest.7102000000000013.quest_desc: [
		"A special item used to enable Super Enchanting mode for Blazes."
		"It cannot be inserted through normal pipes, so supply it manually or with a Mechanical Arm."
	]
	quest.7102000000000013.title: "Enchantment Cake"
	quest.7102000000000014.quest_desc: [
		"An advanced template for Super Enchanting operations."
		"It allows the system to work beyond normal vanilla enchantment limits when the required setup is available."
	]
	quest.7102000000000014.title: "Super Enchanting Template"
	quest.7102000000000015.quest_desc: [
		"Put a Blaze Enchanter or Blaze Forger into Super mode and complete an advanced operation."
		"Lightning may occur during the process, so design the area safely and consider using a Lightning Rod."
	]
	quest.7102000000000015.title: "Super Enchanting"
	quest.7102000000000016.quest_desc: [
		"You have industrialized both experience and enchanting."
		"The factory can now produce, store and apply enchantments at scale instead of handling every item manually."
	]
	quest.7102000000000016.title: "Enchantment Factory"
	quest.7103000000000001.quest_desc: [
		"Create Big Cannons brings foundry work and artillery into the industrial era."
		"You will cast metals, bore cannon pieces and assemble powerful weapons. From molten metal to the first shot, every stage becomes part of a production chain."
	]
	quest.7103000000000001.title: "The Age of Artillery"
	quest.7103000000000002.quest_desc: [
		"Turns the Basin into part of the cannon-alloy foundry process."
		"Provide the required heat and check JEI for the exact alloy recipes available in this pack."
	]
	quest.7103000000000002.title: "Basin Foundry Lid"
	quest.7103000000000003.quest_desc: [
		"The basic material used to prepare cannon molds."
		"It is essential for shaping cast components before they can be bored and assembled."
	]
	quest.7103000000000003.title: "Casting Sand"
	quest.7103000000000004.quest_desc: [
		"A basic cannon-making alloy produced through the foundry process."
		"It supports early cannon components and introduces the material progression of Big Cannons."
	]
	quest.7103000000000004.title: "Cast Iron Ingot"
	quest.7103000000000005.quest_desc: [
		"A copper-and-tin alloy stronger than basic cast iron for several artillery parts."
		"It opens the intermediate material tier and the autocannon branch."
	]
	quest.7103000000000005.title: "Bronze Ingot"
	quest.7103000000000006.quest_desc: [
		"A stronger iron-based alloy used for higher-performance cannon components."
		"Keep a supply available because later barrels and breeches rely on stronger materials."
	]
	quest.7103000000000006.title: "Steel Ingot"
	quest.7103000000000007.quest_desc: [
		"An extremely durable Nether-derived alloy for the strongest cannon parts."
		"This material marks the high end of the chapter's structural progression."
	]
	quest.7103000000000007.title: "Nethersteel Ingot"
	quest.7103000000000008.quest_desc: [
		"A mold for casting small cannon components."
		"Prepare it with Casting Sand and use the foundry system to give molten metal the required shape."
	]
	quest.7103000000000008.title: "Small Cannon Mold"
	quest.7103000000000009.quest_desc: [
		"A mold sized for medium cannon components."
		"Use it when the next part is too large for the small mold; JEI shows which casts belong to each size."
	]
	quest.7103000000000009.title: "Medium Cannon Mold"
	quest.710300000000000A.quest_desc: [
		"A mold for large artillery components."
		"It extends the same casting process to heavier barrels, chambers and related parts."
	]
	quest.710300000000000A.title: "Large Cannon Mold"
	quest.710300000000000B.quest_desc: [
		"An advanced mold for the largest cannon components."
		"It belongs to the late foundry tier and is intended for the most demanding artillery pieces."
	]
	quest.710300000000000B.title: "Very Large Cannon Mold"
	quest.710300000000000C.quest_desc: [
		"A casting structure that receives molten metal and forms cannon components."
		"Select the proper mold, fill the cast and let the material solidify before moving to machining."
	]
	quest.710300000000000C.title: "Cannon Cast"
	quest.710300000000000D.quest_desc: [
		"A Cannon Cast after the metal has fully solidified."
		"The shaped piece is now ready to be bored into a usable cannon component."
	]
	quest.710300000000000D.title: "Finished Cannon Cast"
	quest.710300000000000E.quest_desc: [
		"Bores finished casts to create functional cannon barrels and related parts."
		"It needs kinetic power and the required cooling or process conditions; use Ponder and JEI for the exact setup."
	]
	quest.710300000000000E.title: "Cannon Drill"
	quest.710300000000000F.quest_desc: [
		"The cutting component used by the Cannon Drill."
		"Make sure the drill setup and speed match the recipe requirements before starting a long machining job."
	]
	quest.710300000000000F.title: "Cannon Drill Bit"
	quest.7103000000000010.quest_desc: [
		"A basic barrel section made from cast iron."
		"Use it in early cannon assemblies while learning how barrel sections connect and how material strength affects the build."
	]
	quest.7103000000000010.title: "Cast Iron Cannon Barrel"
	quest.7103000000000011.quest_desc: [
		"A chamber section that holds the propellant charge."
		"Connect it to compatible barrel pieces so the cannon has a reinforced area for firing pressure."
	]
	quest.7103000000000011.title: "Cast Iron Cannon Chamber"
	quest.7103000000000012.quest_desc: [
		"A rear closing section for a cast-iron cannon."
		"It completes the back of a simple barrel assembly when a dedicated breech is not being used."
	]
	quest.7103000000000012.title: "Cast Iron Cannon End"
	quest.7103000000000013.quest_desc: [
		"Allows a cannon to be loaded from the rear."
		"It makes reloading more convenient, but its mechanical design trades some structural strength for speed and access."
	]
	quest.7103000000000013.title: "Cast Iron Sliding Breech"
	quest.7103000000000014.quest_desc: [
		"A steel barrel section with greater strength than cast iron."
		"Use it when the design needs to tolerate larger propellant loads and more demanding ammunition."
	]
	quest.7103000000000014.title: "Steel Cannon Barrel"
	quest.7103000000000015.quest_desc: [
		"A strong screw-operated breech without the same strength penalty as a sliding design."
		"Provide rotation to open and close it as part of the loading cycle."
	]
	quest.7103000000000015.title: "Steel Screw Breech"
	quest.7103000000000016.quest_desc: [
		"An extremely strong barrel section for high-caliber artillery."
		"It belongs to the late material tier and supports the heaviest cannon designs."
	]
	quest.7103000000000016.title: "Nethersteel Cannon Barrel"
	quest.7103000000000017.quest_desc: [
		"A very high-strength breech intended for the heaviest cannon assemblies."
		"Combine it with compatible Nethersteel sections when maximum durability matters."
	]
	quest.7103000000000017.title: "Nethersteel Screw Breech"
	quest.7103000000000018.quest_desc: [
		"A powered mount used to assemble, aim and operate large cannons."
		"Integrate redstone and kinetic control so the weapon can be positioned and fired reliably."
	]
	quest.7103000000000018.title: "Cannon Mount"
	quest.7103000000000019.quest_desc: [
		"Extends the control interface of a Cannon Mount."
		"Use it when the build needs additional accessible faces for redstone, rotation or automation connections."
	]
	quest.7103000000000019.title: "Cannon Mount Extension"
	quest.710300000000001A.quest_desc: [
		"A simpler fixed mounting option for cannons that do not need powered aiming."
		"Use it for installations where the firing direction is predetermined and manual adjustment is enough."
	]
	quest.710300000000001A.title: "Fixed Cannon Mount"
	quest.710300000000001B.quest_desc: [
		"A mobile mounting platform for cannons."
		"It can be repositioned more easily than a fixed installation, but it is not automated in the same way as a powered Cannon Mount."
	]
	quest.710300000000001B.title: "Cannon Carriage"
	quest.710300000000001C.quest_desc: [
		"The standard propellant charge for large cannons."
		"Use the correct amount for the cannon material and ammunition; excessive charges can be dangerous."
	]
	quest.710300000000001C.title: "Powder Charge"
	quest.710300000000001D.quest_desc: [
		"A high-penetration projectile designed for direct impact."
		"It does not use a fuze, making it a straightforward choice when explosive effects are not required."
	]
	quest.710300000000001D.title: "Solid Shot"
	quest.710300000000001E.quest_desc: [
		"A high-explosive artillery shell."
		"Pair it with a compatible fuze so the projectile detonates under the conditions you choose."
	]
	quest.710300000000001E.title: "HE Shell"
	quest.710300000000001F.quest_desc: [
		"An armor-piercing shell designed to penetrate blocks before detonating."
		"Use it when protected or reinforced targets make a surface explosion less effective."
	]
	quest.710300000000001F.title: "AP Shell"
	quest.7103000000000020.quest_desc: [
		"Contains a spread of damaging fragments for soft targets and light structures."
		"It is useful when wide-area impact matters more than deep penetration."
	]
	quest.7103000000000020.title: "Shrapnel Shell"
	quest.7103000000000021.quest_desc: [
		"A compact reusable propellant cartridge."
		"It simplifies loading and is useful when you want a faster, more standardized ammunition workflow."
	]
	quest.7103000000000021.title: "Big Cartridge"
	quest.7103000000000022.quest_desc: [
		"Triggers a compatible shell when it impacts a target."
		"Shallow-angle impacts can be unreliable, so choose the firing solution with the fuze behavior in mind."
	]
	quest.7103000000000022.title: "Impact Fuze"
	quest.7103000000000023.quest_desc: [
		"Detonates a compatible shell after a configured delay."
		"Use it for airburst-style shots or whenever the explosion needs to occur after a known travel time."
	]
	quest.7103000000000023.title: "Timed Fuze"
	quest.7103000000000024.quest_desc: [
		"Detonates when the projectile approaches a valid target or block condition."
		"It is useful against moving targets or shots where direct impact is difficult."
	]
	quest.7103000000000024.title: "Proximity Fuze"
	quest.7103000000000025.quest_desc: [
		"A bronze barrel component for automatic cannons."
		"It begins the faster-firing autocannon branch, which uses a different ammunition workflow from large cannons."
	]
	quest.7103000000000025.title: "Bronze Autocannon Barrel"
	quest.7103000000000026.quest_desc: [
		"The breech section that receives autocannon ammunition and handles spent casings."
		"Combine it with the proper barrel and ammunition system to build a functioning autocannon."
	]
	quest.7103000000000026.title: "Bronze Autocannon Breech"
	quest.7103000000000027.quest_desc: [
		"Stores autocannon ammunition and can feed it into the weapon automatically."
		"Configure the container through its interface or use Deployers where supported by the design."
	]
	quest.7103000000000027.title: "Autocannon Ammo Container"
	quest.7103000000000028.quest_desc: [
		"The basic ammunition casing used by autocannons."
		"It can be prepared with different projectiles, so check JEI for the ammunition options available in the installed version."
	]
	quest.7103000000000028.title: "Autocannon Cartridge"
	quest.7103000000000029.quest_desc: [
		"Automates loading and unloading of large cannons."
		"It behaves like a specialized extending mechanism; combine it with the proper heads to push or extract ammunition."
	]
	quest.7103000000000029.title: "Cannon Loader"
	quest.710300000000002A.quest_desc: [
		"The loading head used by a Cannon Loader to push ammunition into the cannon."
		"Build enough clearance for the loader to extend through the complete loading path."
	]
	quest.710300000000002A.title: "Ram Head"
	quest.710300000000002B.quest_desc: [
		"The extraction head used by a Cannon Loader to pull ammunition back out."
		"Use it for unloading, clearing the chamber or recovering a loading sequence that needs to be reversed."
	]
	quest.710300000000002B.title: "Worm Head"
	quest.710300000000002C.quest_desc: [
		"Assemble a complete cannon with compatible barrel, chamber or breech sections and place it on an appropriate mount."
		"Load propellant and a projectile, aim safely and complete a controlled test shot."
	]
	quest.710300000000002C.title: "First Functional Cannon"
	quest.710300000000002D.quest_desc: [
		"Configure a Cannon Loader so ammunition can be inserted and removed without manual handling."
		"Use Ram and Worm Heads as needed and make sure the loading sequence cannot fire while the mechanism is exposed."
	]
	quest.710300000000002D.title: "Automated Artillery"
	quest.710300000000002E.quest_desc: [
		"You have built high-caliber cannons, specialized ammunition and an automated loading workflow."
		"Your factory can now manufacture and operate industrial artillery instead of treating each weapon as a one-off craft."
	]
	quest.710300000000002E.title: "Ballistic Engineering"
	quest.7104000000000001.quest_desc: [
		"Your factory already masters mechanical motion and electricity."
		"Now you will learn to produce liquid fuels and convert them into rotation through engines."
		"This chapter teaches you to build a complete fuel industry: production, extraction, refining, and consumption."
	]
	quest.7104000000000001.title: "The Fuel Age"
	quest.7104000000000002.quest_desc: [
		"A machine that processes large amounts of organic matter."
		"It is the foundation for producing Ethanol and other fermented products."
	]
	quest.7104000000000002.title: "Batch Fermenter"
	quest.7104000000000003.quest_desc: [
		"Turns the Basin into a fluid-processing station."
		"Use it to produce Vegetable Oil and other liquid products."
	]
	quest.7104000000000003.title: "Basin Lid"
	quest.7104000000000004.quest_desc: [
		"Build your first fermentation system and produce a useful material."
		"Confirm that the machine operates with the correct ingredients."
	]
	quest.7104000000000004.title: "Functional Fermentation"
	quest.7104000000000005.quest_desc: [
		"A renewable fuel produced through fermentation."
		"It can power Diesel Engines and serve as a base for Biodiesel."
	]
	quest.7104000000000005.title: "Ethanol"
	quest.7104000000000006.quest_desc: [
		"Oil extracted from plant matter, providing another renewable fuel route."
		"Combined with Ethanol, it can be converted into Biodiesel."
	]
	quest.7104000000000006.title: "Vegetable Oil"
	quest.7104000000000007.quest_desc: [
		"An advanced renewable fuel produced from Vegetable Oil and Ethanol."
		"It represents the peak of this chapter's agricultural fuel route."
	]
	quest.7104000000000007.title: "Biodiesel"
	quest.7104000000000008.quest_desc: [
		"An essential mechanical component for assembling Diesel Engines."
		"Without it, the engine cannot convert combustion into motion."
	]
	quest.7104000000000008.title: "Engine Piston"
	quest.7104000000000009.quest_desc: [
		"A compact engine that generates rotation by burning liquid fuel."
		"§6Ponder:§r use the visualization to see how it is assembled and supplied."
	]
	quest.7104000000000009.title: "Diesel Engine"
	quest.710400000000000A.quest_desc: [
		"Feed a Diesel Engine with Ethanol or another available fuel."
		"Confirm that it generates rotation and can power a Create machine."
	]
	quest.710400000000000A.title: "First Ignition"
	quest.710400000000000B.quest_desc: [
		"A tool used to locate underground Crude Oil deposits."
		"Right-click to check how much oil is present in the chunk."
	]
	quest.710400000000000B.title: "Oil Scanner"
	quest.710400000000000C.quest_desc: [
		"A central part of the Pumpjack structure."
		"It acts as a hinge for the pumping motion."
		"This item is an intermediate step in the current progression and prepares the components or machines that come next. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.710400000000000C.title: "Pumpjack Bearing"
	quest.710400000000000D.quest_desc: [
		"Converts Create rotation into the Pumpjack's reciprocating motion."
		"This item is an intermediate step in the current progression and prepares the components or machines that come next. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.710400000000000D.title: "Pumpjack Crank"
	quest.710400000000000E.quest_desc: [
		"The upper part of the Pumpjack that performs the pumping action."
		"This item is an intermediate step in the current progression and prepares the components or machines that come next. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.710400000000000E.title: "Pumpjack Head"
	quest.710400000000000F.quest_desc: [
		"Connects the vertical piping to bedrock so oil can be extracted."
		"This item is an intermediate step in the current progression and prepares the components or machines that come next. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.710400000000000F.title: "Pumpjack Well"
	quest.7104000000000010.quest_desc: [
		"Assemble the complete Pumpjack structure and extend it down to bedrock."
		"§6Ponder:§r use the visualization to visualize the correct construction."
	]
	quest.7104000000000010.title: "Your First Well"
	quest.7104000000000011.quest_desc: [
		"Raw petroleum extracted from underground."
		"It must be refined before advanced engines can use it as fuel."
	]
	quest.7104000000000011.title: "Crude Oil"
	quest.7104000000000012.quest_desc: [
		"Applied to a tank to create a distillation tower."
		"The structure must be at least three blocks tall to operate."
	]
	quest.7104000000000012.title: "Distillation Controller"
	quest.7104000000000014.quest_desc: [
		"Provides the heat needed for distillation."
		"It can be supplied with flammable liquids."
		"This item is an intermediate step in the current progression and prepares the components or machines that come next. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.7104000000000014.title: "Burner"
	quest.7104000000000015.quest_desc: [
		"Build the distillation tower and supply heated Crude Oil."
		"Confirm that the system begins separating petroleum products."
	]
	quest.7104000000000015.title: "Distillation Tower"
	quest.7104000000000016.quest_desc: [
		"A refined fuel obtained from Crude Oil."
		"It powers Diesel and modular engines."
		"This item is an intermediate step in the current progression and prepares the components or machines that come next. §bJEI:§r check the exact recipe in this build before crafting it in quantity."
	]
	quest.7104000000000016.title: "Diesel"
	quest.7104000000000017.quest_desc: [
		"Another fraction of refined petroleum with properties different from Diesel."
		"It is an alternative fuel for compatible engines."
	]
	quest.7104000000000017.title: "Gasoline"
	quest.7104000000000018.quest_desc: [
		"Stores fluids without losing the contents when the container is picked up."
		"Ideal for moving fuels between machines."
	]
	quest.7104000000000018.title: "Fuel Can"
	quest.7104000000000019.quest_desc: [
		"An industrial tank for storing large amounts of fluid."
		"It can be placed horizontally or vertically."
	]
	quest.7104000000000019.title: "Oil Barrel"
	quest.710400000000001A.quest_desc: [
		"Also called the Modular Diesel Engine, it generates rotation at a larger scale."
		"Modules can be stacked to increase stress capacity."
	]
	quest.710400000000001A.title: "Modular Engine"
	quest.710400000000001C.quest_desc: [
		"The largest engine in this chapter, capable of generating massive rotational power."
		"§6Ponder:§r use the visualization to understand its assembly and fuel requirements."
	]
	quest.710400000000001C.title: "Huge Diesel Engine"
	quest.710400000000001D.quest_desc: [
		"Extract oil, refine fuel, store it, and supply your engines automatically."
		"The goal is to keep the complete system running without manual intervention."
	]
	quest.710400000000001D.title: "Automate the Fuel Chain"
	quest.710400000000001E.quest_desc: [
		"You have built a complete fuel industry: production, extraction, refining, and consumption."
		"Create turns rotation into industry; Diesel Generators turns fuel into rotation."
	]
	quest.710400000000001E.title: "Fuel Age"
	quest.7B20000000000001.quest_desc: ["Create's final proof. Industrial Mechanisms, Precision Mechanisms and brass now feed a true endgame-scale product."]
	quest.7B20000000000001.title: "Omega Mechanical Core"
	quest.7B20000000000002.quest_desc: ["This core now proves advanced Mekanism infrastructure: an Ultimate Energy Cube and Ultimate Universal Cables join industrial power and mechanisms."]
	quest.7B20000000000002.title: "Omega Energy Core"
	quest.7B20000000000003.quest_desc: ["Project Omega’s brain requires AE2 at scale: Pattern Provider, Molecular Assembler, 256k Crafting Storage, processors and quantum technology."]
	quest.7B20000000000003.title: "Omega Logic Core"
	quest.7B20000000000004.quest_desc: ["This core explicitly requires 4 Insanium Blocks, plus Dragon Egg and Nether Star seeds. Your renewable resource production must have reached industrial scale."]
	quest.7B20000000000004.title: "Omega Nature Core"
	quest.7B20000000000005.quest_desc: ["Turn the apiary into infrastructure: advanced hives, centrifugation and production upgrades sustain the biological core."]
	quest.7B20000000000005.title: "Omega Biological Core"
	quest.7B20000000000006.quest_desc: ["Apotheosis and Create Enchantment Industry converge: Reforging, Augmenting, a Godforged Pearl, liquid XP and enchantment printing form the Arcane Core."]
	quest.7B20000000000006.title: "Omega Arcane Core"
	quest.7B20000000000007.quest_desc: ["Heavy artillery, pressure, engineering and external power meet in this core, representing mastery of industrial systems that complement Create."]
	quest.7B20000000000007.title: "Omega Engineering Core"
	quest.7B20000000000008.quest_desc: ["Moving structures, propulsion and transfer interfaces form the last pillar required for Ascension."]
	quest.7B20000000000008.title: "Omega Propulsion Core"
	quest.7B20000000000009.quest_desc: ["The Omega Star is the industrial apex, not the key that unlocks your equipment. Forge the Omega Arsenal first, reach Omega State and dominate the Age of Titans; then convert the eight Cores, Matrices and final materials in this 9×9 synthesis."]
	quest.7B20000000000009.title: "Omega Star"
	quest.7B2000000000000A.quest_desc: ["The Omega Pickaxe is forged BEFORE the Omega Star. It fuses Awakened Supremium, Refined Obsidian, Atomic Disassembler, MekaTool and Jackhammer in a 7×7 Create structure. Its powers are intrinsic to the item."]
	quest.7B2000000000000A.title: "Omega Pickaxe"
	quest.7B2000000000000B.quest_desc: ["The Omega Blade fuses the pack’s strongest combat routes: Awakened Supremium, Refined Obsidian, MekaTool and Cataclysm weapons. It is conquest gear for the late game, not a post-game reward."]
	quest.7B2000000000000B.title: "Omega Blade"
	quest.7B2000000000000C.quest_desc: ["The Omega Helmet fuses Awakened Supremium, Refined Obsidian, Pneumatic Armor, MekaSuit, Ignitium and Cursium. Equip it and its powers work even when obtained from Creative or /give."]
	quest.7B2000000000000C.title: "Omega Helmet"
	quest.7B2000000000000D.quest_desc: ["The Omega Chestplate combines six armor technologies. It intrinsically grants resistance and fire protection, plus the set’s extra maximum health."]
	quest.7B2000000000000D.title: "Omega Chestplate"
	quest.7B2000000000000E.quest_desc: ["Omega Leggings combine the same six endgame systems and automatically grant regeneration and mobility while equipped."]
	quest.7B2000000000000E.title: "Omega Leggings"
	quest.7B2000000000000F.quest_desc: ["Omega Boots complete the industrial fusion and reinforce mobility with speed and jump. The full set unlocks flight and Omega State; slow falling is not part of the final kit."]
	quest.7B2000000000000F.title: "Omega Boots"
	quest.7B20000000000010.quest_desc: [
		"With the Pickaxe, Blade and full armor set in hand, confirm that the Omega Arsenal is ready for the post-game."
		"The Heart of Project Omega is NO LONGER a quest reward: it must be legitimately crafted in 7×7 Mechanical Crafting by consuming an Omega Star."
	]
	quest.7B20000000000010.title: "Omega Ascension"
	quest.7B20000000000011.quest_desc: ["Buffs are intrinsic and do not depend on the recipe or enchantments. Each piece has its own powers and all pieces increase maximum health; with 4 pieces: flight, Resistance III, Regeneration III, Haste III, Strength III and Absorption VI. Colorful Hearts compresses the extra health into colored layers."]
	quest.7B20000000000011.title: "OMEGA STATE"
	quest.7B20000000000020.quest_desc: ["The Star does not begin at the Mechanical Crafter: it begins with scaled production. Make a full batch of 32 Omega Alloy Plates from compressed resources, Insanium, Brass and lava."]
	quest.7B20000000000020.title: "Omega Alloy at Scale"
	quest.7B20000000000021.quest_desc: ["Turn Omega Alloy into a repeatable, automatable structure. Your factory should make Frames without repetitive manual crafting."]
	quest.7B20000000000021.title: "Omega Structural Frame"
	quest.7B20000000000022.quest_desc: ["Make Create, AE2, Mekanism and Mystical work on the same line. The Convergence Mechanism uses Sequenced Assembly and is the industrial proof before the Star."]
	quest.7B20000000000022.title: "Omega Convergence Mechanism"
	quest.7C20000000000001.quest_desc: ["This tab is not a mandatory progression line. It is a catalog and checklist. Normal armor sets do not unlock one another; explore the mods and choose your route."]
	quest.7C20000000000001.title: "How to use this Arsenal"
	quest.7C20000000000002.quest_desc: ["The vanilla arsenal reference. Netherite remains useful for comparison and as a component in several industrial routes."]
	quest.7C20000000000002.title: "Netherite"
	quest.7C20000000000003.quest_desc: ["Inferium armor begins the Mystical Agriculture gear path and shows how essence progression grows before advanced tiers."]
	quest.7C20000000000003.title: "Inferium"
	quest.7C20000000000004.quest_desc: ["Prudentium is the second Mystical armor tier. Use this tab as a catalog, not a mandatory linear route."]
	quest.7C20000000000004.title: "Prudentium"
	quest.7C20000000000005.quest_desc: ["Tertium continues the Mystical armor climb and serves as a visual reference for the farming route's power growth."]
	quest.7C20000000000005.title: "Tertium"
	quest.7C20000000000006.quest_desc: ["Imperium brings the Mystical route close to endgame. Compare its stats and costs with the pack's technological alternatives."]
	quest.7C20000000000006.title: "Imperium"
	quest.7C20000000000007.quest_desc: ["Supremium is Mystical Agriculture's standard high tier and participates in several advanced Project Omega syntheses."]
	quest.7C20000000000007.title: "Supremium"
	quest.7C20000000000008.quest_desc: ["Awakened Supremium is a fundamental ingredient for Omega gear. Automate its production before trying to build the final arsenal."]
	quest.7C20000000000008.title: "Awakened Supremium"
	quest.7C20000000000009.quest_desc: ["Mekanism Bronze offers an intermediate equipment route. It is an option, not a prerequisite for every other armor set."]
	quest.7C20000000000009.title: "Mekanism — Bronze"
	quest.7C2000000000000A.quest_desc: ["The Mekanism Tools Lapis tier is an alternate gear route inside the catalog and can be skipped if another build fits better."]
	quest.7C2000000000000A.title: "Mekanism — Lapis Lazuli"
	quest.7C2000000000000B.quest_desc: ["Osmium marks the early technological identity of Mekanism Tools and serves as an optional equipment step."]
	quest.7C2000000000000B.title: "Mekanism — Osmium"
	quest.7C2000000000000C.quest_desc: ["Steel offers a durable alternative before refined alloys. Compare it with Mystical, PneumaticCraft and Cataclysm gear."]
	quest.7C2000000000000C.title: "Mekanism — Steel"
	quest.7C2000000000000D.quest_desc: ["Refined Glowstone takes Mekanism Tools into advanced equipment and prepares the comparison with Refined Obsidian."]
	quest.7C2000000000000D.title: "Mekanism — Refined Glowstone"
	quest.7C2000000000000E.quest_desc: ["Refined Obsidian is consumed by Omega equipment. In 1.0.0 it can be produced through superheated Create Mixing or from Refined Obsidian Essence; Mekanism Tools gear uses this route without depending on disabled chemical machines."]
	quest.7C2000000000000E.title: "Mekanism — Refined Obsidian"
	quest.7C2000000000000F.quest_desc: ["Compressed Iron opens the PneumaticCraft arsenal and prepares the infrastructure that culminates in Pneumatic Armor."]
	quest.7C2000000000000F.title: "PneumaticCraft — Compressed Iron"
	quest.7C20000000000010.quest_desc: ["Pneumatic Armor has its own upgrades and utility and also participates in the convergence used by Omega Armor."]
	quest.7C20000000000010.title: "Pneumatic Armor"
	quest.7C20000000000011.quest_desc: ["Ignitium represents Cataclysm gear and boss materials. Part of this power is incorporated into the Omega arsenal."]
	quest.7C20000000000011.title: "Cataclysm — Ignitium"
	quest.7C20000000000012.quest_desc: ["Cursium is another Cataclysm equipment route and directly connects boss combat to the pack's final synthesis."]
	quest.7C20000000000012.title: "Cataclysm — Cursium"
	quest.7C20000000000013.quest_desc: ["The Exoskeleton and Jetpack represent Create mobility. They coexist with other builds and help prepare the Propulsion Core."]
	quest.7C20000000000013.title: "Create — Exoskeleton \\& Jetpack"
	quest.7C20000000000014.quest_desc: ["MekaSuit returns to the arsenal through its own Create manufacturing route. It does not need to be the final armor: it is now one of the technologies consumed by Omega Armor synthesis."]
	quest.7C20000000000014.title: "MekaSuit"
	quest.7C20000000000015.quest_desc: ["Compare the pack’s major mining tools. They remain independent gear choices; the Omega Pickaxe is the item that finally fuses them into one machine-tool."]
	quest.7C20000000000015.title: "Endgame Mining Tools"
	quest.7C20000000000016.quest_desc: ["Weapons from several progression philosophies coexist in the pack. The Refined Obsidian Sword has its own Mechanical Crafting recipe, and the Omega Blade consumes part of this arsenal to create something above any isolated route."]
	quest.7C20000000000016.title: "Endgame Weapons"
	quest.7C20000000000017.quest_desc: ["The exception to the catalog philosophy: Omega equipment is built by converging multiple mods through Mechanical Crafting and is available before the Omega Star."]
	quest.7C20000000000017.title: "Omega Arsenal"
	quest.7D20000000000001.quest_desc: [
		"Craft the Heart in 7×7 Mechanical Crafting. It consumes an Omega Star and reuses the final factory, but does not repeat the Titan or Draconic Matrix."
		"On the server, the Heart is permanent proof that Omega progression was completed. Creative items no longer have crafting recipes and will be obtained from the official shop; the Omega Star will be the main consumable post-game token."
	]
	quest.7D20000000000001.title: "Heart of Project Omega"
	quest.7D20000000000002.quest_desc: ["No crafting recipe. Obtain the Creative Motor exclusively from the official server shop after reaching Omega post-game."]
	quest.7D20000000000002.title: "Creative Motor"
	quest.7D20000000000003.quest_desc: ["No crafting recipe. The Create Creative Fluid Tank is now exclusive to the official server shop."]
	quest.7D20000000000003.title: "Creative Fluid Tank — Create"
	quest.7D20000000000004.quest_desc: ["No crafting recipe. The Creative Crate is obtained exclusively from the official server shop."]
	quest.7D20000000000004.title: "Creative Crate"
	quest.7D20000000000005.quest_desc: ["No crafting recipe. The Mekanism Creative Energy Cube is a post-game item sold by the official server shop."]
	quest.7D20000000000005.title: "Creative Energy Cube"
	quest.7D20000000000006.quest_desc: ["No crafting recipe. The Mekanism Creative Fluid Tank is obtained exclusively from the official server shop."]
	quest.7D20000000000006.title: "Creative Fluid Tank — Mekanism"
	quest.7D20000000000007.quest_desc: ["No crafting recipe. The Mekanism Creative Chemical Tank is obtained exclusively from the official server shop."]
	quest.7D20000000000007.title: "Creative Chemical Tank"
	quest.7D20000000000008.quest_desc: ["No crafting recipe. The AE2 Creative Energy Cell is now exclusive to the official server shop."]
	quest.7D20000000000008.title: "Creative Energy Cell — AE2"
	quest.7D20000000000009.quest_desc: ["Collect the post-game technologies acquired through the official server shop. This step represents economic and technological mastery of the server, not direct crafting of Creative items."]
	quest.7D20000000000009.title: "Creative Mastery"
	quest.7D2000000000000A.quest_desc: ["This is the only official Chunk Loader in Project Omega. It has no crafting recipe and will be obtained exclusively from the official server shop. FTB force-loading and legacy Power Loaders remain disabled to protect server performance."]
	quest.7D2000000000000A.title: "Omega Chunk Loader"
	quest.7E20000000000001.quest_desc: ["This line begins after Precision Mechanisms. The goal is to use Create as infrastructure for a reproducible, controllable mob farm."]
	quest.7E20000000000001.title: "From Factory to Mobs"
	quest.7E20000000000002.quest_desc: ["Fan and Entity Conveyor move creatures through the processing line. The technology directly builds on Create ventilation and belts."]
	quest.7E20000000000002.title: "Entity Movement"
	quest.7E20000000000003.quest_desc: ["The Mob Masher handles killing while the Absorption Hopper collects items and XP. Automate input, killing and collection before generating entities."]
	quest.7E20000000000003.title: "Killing and Collection"
	quest.7E20000000000004.quest_desc: ["Store experience in tanks and control output with the XP Tap. The line should connect to the pack's fluid and enchanting infrastructure."]
	quest.7E20000000000004.title: "XP Network"
	quest.7E20000000000005.quest_desc: ["Turn captured experience into a solid resource. This step requires the Create Enchantment Industry Experience Lantern and proves integration between both systems."]
	quest.7E20000000000005.title: "XP Solidifier"
	quest.7E20000000000006.quest_desc: ["The Entity Spawner closes the line but does not create progression from nothing: its recipe requires a real Spawner, solid XP and all previous industrial infrastructure."]
	quest.7E20000000000006.title: "Entity Spawner"
	quest.6D20000000000101.title: "Naga — Twilight Forest"
	quest.6D20000000000101.quest_desc: ["Start the Twilight Forest campaign by defeating the Naga. The dimension's boss route is now an official part of the Age of Titans."]
	quest.6D20000000000102.title: "Twilight Lich"
	quest.6D20000000000102.quest_desc: ["Climb the tower and defeat the Lich. Omega follows Twilight Forest's natural progression order."]
	quest.6D20000000000103.title: "Minoshroom"
	quest.6D20000000000103.quest_desc: ["Cross the labyrinth and defeat the Minoshroom to continue the Twilight Forest campaign."]
	quest.6D20000000000104.title: "Hydra"
	quest.6D20000000000104.quest_desc: ["Face the Hydra in the Fire Swamps. Its health is increased, while the original Twilight Forest mechanics remain essential."]
	quest.6D20000000000105.title: "Knight Phantoms"
	quest.6D20000000000105.quest_desc: ["Win the full Knight Phantom encounter. This task requires six kills to represent the entire Stronghold formation."]
	quest.6D20000000000106.title: "Ur-Ghast"
	quest.6D20000000000106.quest_desc: ["Reach the top of the Dark Tower and defeat the Ur-Ghast. Use the arena traps and mechanics; high health does not replace strategy."]
	quest.6D20000000000107.title: "Alpha Yeti"
	quest.6D20000000000107.quest_desc: ["Master the frozen lands by defeating the Alpha Yeti."]
	quest.6D20000000000108.title: "Snow Queen"
	quest.6D20000000000108.quest_desc: ["Finish the current main Twilight Forest campaign by defeating the Snow Queen."]
	quest.6D20000000000111.title: "Night Lich — BOMD"
	quest.6D20000000000111.quest_desc: ["Find the Night Lich tower and defeat one of the four major Bosses of Mass Destruction threats."]
	quest.6D20000000000112.title: "Nether Gauntlet — BOMD"
	quest.6D20000000000112.quest_desc: ["Find its Nether structure and defeat the Gauntlet. All four BOMD bosses are required by Omega's campaign."]
	quest.6D20000000000113.title: "Void Blossom — BOMD"
	quest.6D20000000000113.quest_desc: ["Descend into the depths and face the Void Blossom in its underground arena."]
	quest.6D20000000000114.title: "Obsidilith — BOMD"
	quest.6D20000000000114.quest_desc: ["Defeat the Obsidilith in the End to complete the Bosses of Mass Destruction set."]
	quest.6D20000000000121.title: "Ferrous Wroughtnaut"
	quest.6D20000000000121.quest_desc: ["Find the Wroughtnaut's underground chamber and learn its vulnerability window. HP is increased, but the fight remains mechanic-driven rather than a pure DPS check."]
	quest.6D20000000000122.title: "Frostmaw"
	quest.6D20000000000122.quest_desc: ["Wake and defeat the Frostmaw. Its attacks and freezing mechanics remain the core of the encounter."]
	quest.6D20000000000123.title: "Umvuthi"
	quest.6D20000000000123.quest_desc: ["Defeat Umvuthi and complete the three major Mowzie's Mobs encounters used by Omega."]
	quest.6D20000000000140.title: "Twilight Conquest Matrix"
	quest.6D20000000000140.quest_desc: ["Return to the factory with the trophies of all eight major Twilight Forest bosses: Naga, Lich, Minoshroom, Hydra, Knight Phantoms, Ur-Ghast, Alpha Yeti and Snow Queen.", "Mechanical Crafting compresses the entire dimension campaign into one matrix, turning boss relics into endgame materials instead of mere kill checks."]
	quest.6D20000000000141.title: "Destruction Matrix"
	quest.6D20000000000141.quest_desc: ["Gather Ancient Anima, Blazing Eye, Void Thorn and Obsidian Heart, the four boss materials from Bosses of Mass Destruction.", "Process them with Create mechanisms to form the Destruction Matrix."]
	quest.6D20000000000142.title: "Wild Relic Matrix"
	quest.6D20000000000142.quest_desc: ["The Axe of a Thousand Metals, Ice Crystal and Sol Visage represent the three major Mowzie's Mobs encounters selected for the Era of Titans.", "These rewards now feed Project Omega's industrial progression instead of remaining optional trophies or equipment."]
	quest.6D20000000000130.title: "Conquest Matrix"
	quest.6D20000000000130.quest_desc: ["Combine the Twilight Conquest Matrix, Destruction Matrix and Wild Relic Matrix with the Draconic Matrix and Create components.", "This matrix proves the exploration campaigns were both completed and industrialized. It is consumed at the center of the Titan Matrix."]

}
