	file.0000000000000001.title: "CraftToMuck: Skyblock"
	quest.0171E1AA341A00AC.quest_desc: [
		"You know the drill."
		""
		"The following quests will serve as a tutorial for progressing."
	]
	quest.0171E1AA341A00AC.title: "The Beginning"
	quest.06D5D142DC696A57.quest_desc: ["Hope you found a good Bastion."]
	quest.06D5D142DC696A57.title: "Cover Me In Debris"
	quest.0B3DED5FDBE76C4B.quest_desc: ["Within the void, various biome islands will spawn with biome specific materials. Crafting an explorer's compass is imperative to find where these islands are."]
	quest.0B3DED5FDBE76C4B.title: "Where Am I Going?"
	quest.0D5065CB5C055108.quest_desc: ["Bad RNG? Sacrificed your last sapling to the void gods? No worries! On the right sidebar, you may claim an emergency sapling every 5 minutes!"]
	quest.0F9B56B65C035B64.quest_desc: [
		"There are a few ways to obtain additional lava sources. The easiest is using pointed dripstone (see the related questline for obtaining)."
		""
		"If you don't have diamonds yet, you can use lava casting to build the portal!"
	]
	quest.0F9B56B65C035B64.title: "Nether"
	quest.1273A09C29AE7986.quest_desc: ["Welcome to season 3 of the CraftToMuck Skyblock experience! We're very excited for you to try out what we have in store for you. This questbook will serve as a guide for the various skyblock mechanics in place."]
	quest.1273A09C29AE7986.title: "Welcome!"
	quest.1558D906A4284256.quest_desc: ["Your first source of soul sand will be here."]
	quest.1558D906A4284256.title: "Soul Sand Valley"
	quest.1C17A3CB68C919C7.quest_desc: [
		"We have included sky void additions for obtaining some rarer materials. Check out the datapack page below for more info!"
		""
		"https://modrinth.com/datapack/sky-void-additions"
	]
	quest.1C8A38A07D3E3E13.quest_desc: ["Bonk! The quintessential Create machine."]
	quest.1FEF23633C064C17.quest_desc: ["Per usual, zombies will occasionally drop iron ingots."]
	quest.21E1657382282299.quest_desc: ["Ancient cities are flush with various loot chests that are helpful for your skyblock journey."]
	quest.21E1657382282299.title: "Ancient City"
	quest.28D5F0AB1D9B2563.quest_desc: ["If you're tired of slaying zombies, you can wash gravel for a small chance to get iron nuggets."]
	quest.2A2B5DC3AF37B5B8.quest_desc: ["To begin your adventure, run &n/skyblock create&r to start your island. You may also invite players to your skyblock team with &n/skyblock invite&r. These may also be completed via the Sky GUI (check your keybinds)."]
	quest.2A2B5DC3AF37B5B8.title: "Welcome Home"
	quest.2A971B159B5151CB.quest_desc: ["Soulful sand."]
	quest.2C96ADBD0F8A1E72.quest_desc: ["In the skyblock realm, mobs will mysteriously drop necessary resources. Making a mob farm will be critical to progressing."]
	quest.2D07CA89E6E804BA.quest_desc: ["The Stone Mason also sells pointed dripstone as a level 2 trade."]
	quest.2D07CA89E6E804BA.title: "Stone Mason"
	quest.2E767C538E3839A6.quest_desc: ["Killing husks will have a chance to drop zinc ingots."]
	quest.37EB900A0C18452E.quest_desc: ["With basics of Andesite, Iron, and Zinc, you are now able to progress in Create!"]
	quest.37EB900A0C18452E.title: "Create!"
	quest.38DBB313EF1C215E.quest_desc: ["A key ingredient for starting your Create career. For some strange reason, zombies will also drop these."]
	quest.3E97F395936BB733.quest_desc: ["Tired of waiting for your plants to grow? Rapidly crouching next to them will mysteriously cause them to grow faster."]
	quest.43841C24019B0F59.quest_desc: ["Early game grinding. This machine will be your early way of obtaining gravel and sand."]
	quest.49EE67A409438F33.quest_desc: ["Washing sand will give a small chance of clay."]
	quest.4F0B8D2935EF7C7E.quest_desc: [
		"Hopefully you haven't lost your lava source yet. Additional lava source blocks can be obtained with pointed dripstone."
		""
		"Point dripstone can be found in dripstone cave islands."
	]
	quest.4F0B8D2935EF7C7E.title: "Dripstone Caves"
	quest.4FF334CD0B7F9645.quest_desc: [
		"After all the processing, we can finally obtain gold nuggets (from washing red sand)"
		"!"
	]
	quest.513101BBA74147FF.quest_desc: ["Everyone's favorite heater."]
	quest.525C9B452612A892.quest_desc: ["With precision mechanisms available, you may now escape the confines of your island."]
	quest.525C9B452612A892.title: "To The Skies!"
	quest.52A8FD3FBC38DF95.quest_desc: ["Killing the Wither is guaranteed to drop netherite scrap."]
	quest.52A8FD3FBC38DF95.title: "Netherite!"
	quest.5622D2926E8EEB0A.quest_desc: ["I wonder what happens if I combine three of these."]
	quest.5622D2926E8EEB0A.title: "Hey That's My Head"
	quest.5A2F7DC3DD0DA409.quest_desc: ["With a few of these going, you can now have a sustainable source of lava."]
	quest.5A2F7DC3DD0DA409.title: "Pointy"
	quest.65CA84E43A4DE411.quest_desc: ["In the skyblock realm, mobs will mysteriously drop necessary resources. Making a mob farm will be critical to progressing."]
	quest.6642A0EF1074904A.quest_desc: ["Killing the warden is guaranteed to drop a diamond."]
	quest.6642A0EF1074904A.title: "Diamonds!"
	quest.666320363539FE43.quest_desc: ["Accidentally turned your lava into obsidian? Never fear! Simply sneak right click the obsidian with an empty bucket to recover your lava."]
	quest.666320363539FE43.title: "Oops!"
	quest.668E4847DE49CEB7.quest_desc: ["Wow! I'm blown away by this machine."]
	quest.6834EA2EAD76EE2B.quest_desc: ["Structures will still generate in the void. This compass will be key to finding them. The recipe has been modified to make it easier to craft."]
	quest.6834EA2EAD76EE2B.title: "Skyblock Builder"
	quest.69729B6E0EA44632.quest_desc: ["Besides Zombies, the Mason Villager will now offer Andesite as a level 1 trade."]
	quest.6AA4F951BB81D91E.quest_desc: ["A fortress in the Nether."]
	quest.6AA4F951BB81D91E.title: "Fortress"
	quest.722F5E36114A31A2.quest_desc: ["This is a bit coarse."]
	quest.72780FF39A01242F.quest_desc: ["With your precious gold, you can now craft precision mechanisms. Besides the usual speed controller, these are also used to craft your first aircraft to escape your island."]
	quest.76E42FF80BD0A4E6.quest_desc: ["That's a lot of Piglins."]
	quest.76E42FF80BD0A4E6.title: "Bastion"
	quest.7744C0B49D5F64E8.quest_desc: [
