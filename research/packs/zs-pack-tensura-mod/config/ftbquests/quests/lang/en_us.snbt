	quest.1E179425CDF8FFFF.quest_desc: [
		"{image:trmysticism:textures/skill/ultimate/uriel.png width:100 height:100 align:1}"
		""
		"&6[Passive - In Slot]&r &bAbsolute Guard&r –  "
		"Blocks all attacks with the formula: &fC = A × 25&r (A = Attack DMG).  "
		"Can only be bypassed by enemies with &c8x your EP&r."
		""
		"&6[Passive - Toggle]&r &3Spatial Domination&r –  "
		"Increase &3Spatial&r damage by &b+8&r."
		""
		"&6[Passive - Toggle]&r &8Gravity Manipulation&r –  "
		"Increase &8Gravitational&r damage by &b+4&r."
		""
		"&6[Passive - In Slot]&r &dLaw Manipulation&r –  "
		"&cNullification&r is treated as &6resistance&r, and resistance is bypassed.  "
		"&5Magic Jamming&r is ignored."
		""
		"{@pagebreak}"
		"{image:trmysticism:textures/skill/ultimate/uriel.png width:100 height:100 align:1}"
		""
		"&6[Active - Press]&r &eImprison&r –  "
		"Works like Infinity Prison. Costs &b100,000 MP&r, drains &b1,000 MP/s&r.  "
		"Cooldown &750s&r (&a5s&r with Mastery)."
		""
		"&6[Active - Press]&r &eImaginary Space&r –  "
		"Grants a &f15-row inventory&r with &999 stack&r per slot."
		""
		"&6[Active - Press]&r &eMatter Manipulation&r –  "
		"Unleash elemental control at your fingertips."
		"{@pagebreak}"
		"{image:trmysticism:textures/skill/ultimate/uriel.png width:100 height:100 align:1}"
		""
		"&6[Active - Press]&r &eGravity Manipulation&r –  "
		"Grants &aflight immunity&r to Magic Jamming effects."
		""
		"&6[Active - Press]&r &fUniversal Barrier&r –  "
		"Barrier points = &dMax HP × 4&r (&d×8&r with Mastery)."
		""
		"&6[Active - Press]&r &cAbsolute Severance&r –  "
		"Deals &c700 damage&r (&c1400&r on Mastery).  "
		"Cost: &b1,000 MP&r. Cooldown: &75s&r (&a3s&r on Mastery)."
		""
		"{@pagebreak}"
		"{image:trmysticism:textures/skill/ultimate/uriel.png width:100 height:100 align:1}"
		""
		"&6[Active - Press]&r &5Insulated Imprisonment&r –  "
		"Applies &bSpatial Blockade&r, &dMagic Interference&r, &cFragility&r to all non-allies.  "
		"Also halves their &cATK, ATK SPD, MOV SPD, and Jump&r.  "
		"Drains &b250 MP/s&r in &e20 block&r radius (&e30&r with Mastery).  "
		"Cost: &b200,000 MP&r. Cooldown: &740s&r (&a20s&r Mastery)."
		""
		"&6[Active - Press]&r &4Fatal Imprison&r &7(Requires Mastery)&r –  "
		"Applies &cInfinite Imprisonment&r to all non-allies in &e30 blocks&r.  "
		"Cost: &b250,000 MP&r. Cooldown: &a20s&r."
		"{@pagebreak}"
		"{image:trmysticism:textures/skill/ultimate/uriel.png width:100 height:100 align:1}"
		""
		"&6[Active - Press]&r &dNova Break&r &7(Requires Mastery)&r –  "
		"Deal &f5,000 Holy DMG&r and &b3,000 Spiritual DMG&r to a single target.  "
		"Cost: &b2,000,000 MP&r. Cooldown: &a10s&r."
	]
