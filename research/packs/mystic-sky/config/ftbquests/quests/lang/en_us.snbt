	file.0000000000000001.title: "Mystic Sky 1.21.1"
	quest.04D10293F98DF124.quest_desc: ["To create flax dust, follow these steps: First, build the structure. The first layer is &#FFA826allthecompressed:obsidian_1x&r 2nd layer: nothing (place  &#FFA826minecraft:redstone&r ) 3rd layer &#FFA826minecraft:obsidian&r"]
	quest.063A67DC00D7727E.quest_desc: ["Welcome to this new modpack"]
	quest.066C35DF5930A139.quest_desc: ["Don't forget to pick up spare items you'll need !"]
	quest.0C21742AA3C5F211.quest_desc: ["To obtain these stones, hold the spacebar and the + key, then right-click on a block of dirt or grass"]
	quest.1040530307783251.quest_desc: ["&3A block activated by a redstone signal that protects a 13×13×13 area by delivering electric shocks to mobs that enter the area. The device itself consumes 256 RF/tick, and each electric shock consumes 512 RF/tick. The coil must be activated by a redstone signal, which can be set by right-clicking on the coil while holding an engineer’s hammer. Meat from animals killed by the coil will be roasted, but the coil will not charge creepers. Additionally, a coil shock will cause a stun effect, preventing Enders from teleporting. There are 2 coil modes that can be toggled by pressing ⇧ Shift + right-clicking on the coil while holding an engineer's hammer. By default, the coil is in high-voltage mode, which is the opposite of low-voltage mode. In low-voltage mode, the coil consumes half the energy but affects an area half the size. Additionally, in low-voltage mode, players wearing Faraday armor will take no damage, whereas they will take damage in high-voltage mode."]
	quest.12C3824C945926F6.quest_desc: [
		"/spawn-Teleports to spawn"
		"/rtp-Teleport to a different location"
		"/home [name]-Teleports home"
		"/sethome <name>-Create a home point"
		"/delhome <name>-Delete home point"
		"/tpa-Teleport to player"
		"/tpahere-Teleport the player to you"
		"/tpaccept-Accept teleportation can be clicked"
		"/tpadeny-Cancel teleportation by mouse click"
	]
	quest.13C1585FDC6DC8CD.quest_desc: ["Upgrade the dragon levels to the chaos level"]
	quest.1887FF5A055CECC1.quest_desc: ["Make 12 basic injectors and a fusion core"]
	quest.1A01281D2FD88BB1.quest_desc: ["&3Moves objects placed on it."]
	quest.1ABF3FA3C230821D.quest_desc: ["&3It generates energy using a temperature difference. On one side, there must be water or an ice block, and on the other, lava or a uranium block."]
	quest.259367A75F7BB9B5.quest_desc: ["&3Chain connections are used when the distance between two connectors is too great to connect them directly."]
	quest.28EE226C0BE2D669.quest_desc: ["&3Used to extract and supply energy to machines."]
	quest.2AA4904CB10119B5.quest_desc: ["Here you can buy any item !"]
	quest.2B8E3046F174BC3F.quest_desc: ["Here you can sell any item !"]
	quest.34BA521241B06151.quest_desc: [
		"The shop is now open—you can exchange coins for certain items!"
		"You can also trade items for coins !"
		"You can also earn coins by killing certain mobs !"
	]
	quest.359FC0AEA82898DF.quest_desc: ["Upgrade your wyvern levels to dragon level"]
	quest.3A6B91EDF4B0A2DB.quest_desc: ["A coal-fired base-load power plant"]
	quest.3FD54D3EA96924DE.quest_desc: [
		"&3A 3-block-tall mechanism. It is placed on the top solid blocks of a plot (usually dirt or stone), which are highlighted with orange lines for convenience. It cuts a rock sample from the ground, which reveals the presence of minerals (iron, gold, etc.) or oil in that chunk, as well as their estimated quantities, for further extraction using an excavator (for minerals) and/or a rod pump (for oil) from Immersive Petroleum. When the player holds the sample, the scanned chunk is also highlighted with lines regardless of whether the player is standing on it. The chunk’s coordinates are also written on the sample. The extracted rock sample can be placed as a block, and the data will also be displayed on it."
		"The drill requires RF power to operate."
	]
	quest.470B75BD9D843EE3.quest_desc: ["&3A specialized multi-block unit designed to produce coking coal, as well as creosote as a byproduct."]
	quest.5A8F0329B18DA5DC.quest_desc: ["To enter this dimension, you'll need to pay 1 coin!"]
	quest.6606388A146E597A.quest_desc: ["&3You can obtain them by breaking down ordinary grass. They are used for planting industrial hemp, which, in turn, is used to harvest industrial hemp fiber."]
	quest.6C07BF5C7827C66A.quest_desc: ["&3A single water wheel can produce 18 RF/tick."]
	quest.70A24A876C9B070C.quest_desc: [
		"Here, you can earn coins by killing certain mobs !"
		""
		"To start earning money, complete this quest. Good luck !"
	]
	quest.71EC1F9512C6D0C7.quest_desc: ["&3A special multi-block designed to produce steel and slag as a byproduct."]
	quest.745F14EFD537548B.quest_desc: ["&3It connects to a structured cabling connector, does not carry power, and serves a decorative purpose."]
	quest.7480C5682F351E9E.quest_desc: ["Upgrade your basic levels to Wyvern levels"]
	quest.76F2283F90212C3C.quest_desc: ["{image:ftb_quests:textures/questpics/thavma/infusion.png width:100 height:100 align:center}"]
	quest.7A4104F6CF9C14D1.quest_desc: ["&3It is made from the seeds of industrial hemp."]
