	quest.4A80F35C9CE54633.quest_desc: [
		"&cMythcraft 5&r utilises the &9Improvable skills 3&r mod for &6skills."
		""
		"&6Skills&r&r are usfull perks that allow you to boost your &bstats&r,"
		""
		"&2Abilities&r are useful &3bonuses&r that allow you to do more things,"
		""
		""
		"{image:improvableskills:item/skills_book width:50 height:50 align:center}"
		""
		"&9Usful info on skills on the next page&r"
		"{@pagebreak}"
		""
		"&9Accelerated Furnace:&r This skill increases the melting speed."
		""
		"&6Alchemist:&r This skill boosts the speed of the brewing stand. "
		""
		"&9Attack Speed:&r This skill increases attck speed."
		""
		"&9Cutting:&r This skill increases the speed of the axe."
		""
		"&6Dense Skin:&r This skill adds extra armor points."
		""
		"&6Dexterous Arms:&r This skill increases durability"
		""
		"&9Digging:&r This skill increases the speed of a shovel."
		""
		"&6Enchanter:&r This skill decreases the minimal enchanting level."
		""
		"&6Ender Manipulator:&r This skill reduces ender pearl damage. "
		""
		"&6Experience Harvesting:&r This skill increases experience gain."
		""
		"&6Extra Health:&r This skill boosts your max health up by 10 hearts. "
		""
		"&6Fast Growth:&r This skill randomly applies bone meal to surrounding plants. "
		""
		"&9Fast Swimmer:&r This skill increases swimming speed."
		""
		"&6Huckster:&r This skill reduces villager trading prices. "
		""
		"&9King of the Ladder:&r This skill increases ladder speed."
		""
		"&9Leaper:&r This skill increases jump height."
		""
		"&6Luck of The Sea:&r This skill lures fish to your fishing hook. "
		""
		"&9Mining:&r This skill increases the speed of the pickaxe."
		""
		"&6Obsidian Skin:&r This skill reduces fire/lava damage taken. "
		""
		"&9PvP Protection:&r This skill decreases PvP-type damage taken."
		""
		"&6Sharp Arrow:&r This skill increases ranged damage."
		" "
		"&6Silent Foot:&r This skill reduces the radius of vibrations."
		" "
		"&9Soft Landing:&r This skill reduces fall damage."
		""
		"&6Soul Speed:&r This skill increases your soul speed. "
		""
		"&9Strong Fist:&r This skill increases melee damage dealt to any entity."
		""
		"&6Treasure of the Sands:&r This skill allows one to find treasures from the sand. "
	]
