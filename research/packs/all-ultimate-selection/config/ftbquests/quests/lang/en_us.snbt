	quest.2BA6A13429E1242B.quest_desc: [
		"The Netherite Monstrosity is a large golem &4boss&f that serves as the boss of the Soul Forge. It is intended to be one of the first &4bosses&f fought by the player and is considered the weakest boss."
		""
		"A Netherite Monstrosity spawns in each &5Soul&f Forge structure, sleeping in soul fire at the back of the main hall. The boss awakens when the player enters its line of sight."
		""
		"It is immune to Fire, Freezing, Fall Damage, Poison, and Levitation."
		""
		"{entity:cataclysm:netherite_monstrosity ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:FORCE_OFF idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.2BA6A13429E1242B.quest_subtitle: "Netherite &4Boss&f"
	quest.2BB30AED452773EB.quest_desc: ["A portable device that lets you access your entire storage &9network&f remotely. It combines multiple functions into one interface, allowing seamless item management, crafting, and monitoring from anywhere within range."]
	quest.2BC941FC17558D35.quest_desc: ["After this somewhat hot adventure, we need to return to the Overworld and find the stronghold leading us to &5The End&f."]
	quest.2BC941FC17558D35.quest_subtitle: "Returning to the World"
	quest.2C0D9C9107FE0916.quest_desc: ["A big hotel or I don't know what this is... many bees together and extremely cute."]
	quest.2C0D9C9107FE0916.quest_subtitle: "Hotel?"
	quest.2C61DC46F2135CCE.quest_desc: ["Continuing our mod, now we will also need inferium &2essence&f, which can be found in caves!"]
	quest.2C61DC46F2135CCE.quest_subtitle: "Our First &2Essence&f"
	quest.2C68B51F72D824BD.quest_desc: [
		"&6Cloggrum&f &7ore&f is not very strong... quite the opposite."
		""
		"But it is a good ore to start with and to get a few things going."
	]
	quest.2C68B51F72D824BD.quest_subtitle: "A New &7Ore&f"
	quest.2C715DF198FD89CD.quest_desc: [
		"A new dungeon was discovered in this world..."
		""
		"This dungeon is a massive chamber with numerous cobwebs and wool, dominated by spiders..."
		""
		"Don't even ask me how they ended up there... We need her drops! Including a Throne Pillar compass."
	]
	quest.2C715DF198FD89CD.quest_subtitle: "Bee Dungeon"
	quest.2C72EB0B879E0919.quest_desc: [
		"Inside &dApotheosis&f we can find a new kind of boss, called \"&4Invaders&f\""
		""
		"They are more powerful mobs that appear out of nowhere in our world, and they will always be equipped with items that carry &daffixes&f."
		""
		"They have more hearts, more damage, more &cstrength&f and &aregeneration&f, and they are always represented by their gem."
		""
		"The rarity they spawn with is always determined by the world tier!"
		""
		"World tier is an Apotheosis addition that dictates which tier your world is at. To check your world tier, use \"CTRL + T\""
	]
	quest.2C72EB0B879E0919.quest_subtitle: "Tiers and More Tiers"
	quest.2CD0FC8F82599F65.quest_subtitle: "Level 10"
	quest.2CD70FCC8B119D7A.quest_desc: ["The Brown arrow symbols on the pump indicate the direction of flow. The flow direction can be changed by using a &aWrench&f. When a wrench is used, the entire valve will appear to have rotated 180 degrees. The brown directional arrows will appear on the other side of the pump's gear."]
	quest.2D10C3340BA7BA6D.quest_desc: [
		"The Harbinger also known as Mecha &4Wither&f is a mech &4boss&f found in Ancient Factory."
		""
		""
		""
		"{entity:cataclysm:the_harbinger ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:FORCE_OFF idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.2D10C3340BA7BA6D.quest_subtitle: "&4Wither&f Boss+"
	quest.2D286D3EC63E7063.quest_subtitle: "We Still Don't Know?"
	quest.2D2CC0B1CE4AE09E.quest_desc: [
		"In our mod, we can find &3steel&f ore in our world. This ore is the foundation of everything where we start! Grab some steel."
		""
		"Steel is used as components for crude oil processing, machines, steel tools, space suits, and &3oxygen&f tanks."
	]
	quest.2D2CC0B1CE4AE09E.quest_subtitle: "The Foundation of Everything!"
	quest.2D2CC0B1CE4AE09E.title: "&3Steel&f Ingot"
	quest.2D2F427287880ED9.quest_subtitle: "Grind &2Food&f"
	quest.2D910F2DCE1D042D.quest_desc: ["Inferium &2seed&f is the base of everything; with it, we will have &aeasier&f resources to start the mod."]
	quest.2D910F2DCE1D042D.quest_subtitle: "Tier 1"
	quest.2DB15D6F32CA8243.quest_desc: ["This block works just like a reactor and allows us to build a structure by stacking these blocks to increase &agrowth&f &aspeed&f."]
	quest.2DB15D6F32CA8243.quest_subtitle: "Speeding Up!"
	quest.2DCE17DC20F0248D.quest_desc: ["Cataclysm is a major mod adding dozens of new mobs including &4bosses&f. Cataclysm also adds various new armors, tool tiers, 8 structures, weapons, decorative blocks, pets, curios, and music."]
	quest.2DCE17DC20F0248D.quest_subtitle: "New &4Bosses&f"
	quest.2DCE17DC20F0248D.title: "Cataclysm"
	quest.2DD8B4E9780FC649.quest_desc: [
		"This powerful &7armor&f can be obtained by killing an infernal &4dragon&f!"
		""
		""
		""
		"{entity:block_factorys_bosses:infernal_dragon ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:USE_GLOBAL width:50 height:50 align:center}"
	]
	quest.2DD8B4E9780FC649.quest_subtitle: "Bones of the Bones"
	quest.2DD8B4E9780FC649.title: "&4Dragon&f Bones Armor"
	quest.2DE01FA9BBA462DA.quest_desc: ["With this &6book&f you can guide yourself and see exactly which &5ritual&f you need and what you need to perform the ritual."]
	quest.2DE01FA9BBA462DA.quest_subtitle: "Guide Book"
	quest.2DE734D44F2EAB05.quest_subtitle: "Use for Rare Scrolls"
	quest.2DE8CB93BC76A70E.quest_desc: ["Well, something from this mod has to be good, and this &2hoe&f actually is."]
	quest.2DE8CB93BC76A70E.quest_subtitle: "&2Hoe&f of the Sea"
	quest.2E274BEEF2B0B8C7.quest_desc: [
		"The Chemical Oxidizer is used for making &3gases&f from materials. It is a crucial machine needed for &9Mekanism&f's 5x ore production system."
		""
		"Okay, let's start with making Sulfur Dioxide first."
		""
		"Feeding the Sulfur Dust into this &9machine&f, the Chemical Oxidizer, will &6create&f Sulfur Dioxide. "
		""
		"Now we need to create Sulfur Trioxide. Send the Sulfur Dioxide into a Chemical Infuser to combine it with &3Oxygen&f to create Sulfur Trioxide."
		""
		"Send the Trioxide to another Chemical Infuser to combine it with Water Vapor to create Sulfuric Acid."
	]
	quest.2E2B9C432CC64CB6.quest_desc: ["{entity:occultism:foliot ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:FORCE_OFF idle:FORCE_OFF walk:FORCE_ON width:100 height:100 align:center}"]
	quest.2E2B9C432CC64CB6.quest_subtitle: "First &5demon&f"
	quest.2E747C1C2DB534B5.quest_desc: ["{ftb\tquests.chapter.mystical_agriculture.quest2E747C1C2DB534B5.description1}"]
	quest.2E747C1C2DB534B5.title: "{ftb\tquests.chapter.mystical_agriculture.quest2E747C1C2DB534B5.title}"
	quest.2E8B8DBE61162084.quest_desc: [
		"They can be filtered to only allow certain items through, and be stopped with a &credstone&f signal. Unlike funnels, they can insert and extract at the same time, but can only function vertically."
		""
		"When directly below an inventory, the Filter slot doubles as a Value Settings diode, much like the Brass Funnel. The Chute can be adjusted to extract up to or exactly a set amount of items. The Value Settings of a Smart Chute will be saved even when the inventory above is destroyed, though this has no effect on the Chute's behavior when not under an inventory."
	]
	quest.2EC18075C62BAAF4.quest_desc: ["Conventional bone meal doesn't work on &dMystical&f &2crops&f, but we can use this one!"]
	quest.2EC18075C62BAAF4.quest_subtitle: "New Meal"
	quest.2EF4DD5CC254CC80.quest_desc: [
		"Mechanical Pipe is the &3fluid&f pipe for &9Mekanism&f."
		""
		"It can be used to connect to any blocks with Fluid Handlers in them."
	]
	quest.2EF6EB536C67FFA9.quest_desc: [
		"Find a new biome called &1Deep Dark&f... inside this biome there is a new &4Boss&f."
		""
		"We will need a drop from him."
	]
	quest.2EF6EB536C67FFA9.quest_subtitle: "A Strange Place"
	quest.2EF6EB536C67FFA9.title: "&1Deep Dark&f"
	quest.2F0B0D4401AA455E.quest_desc: [
		"A &aWrench&f can be used to give the tunnel windows."
		""
		"The Tunnel does not stop items on the belt from being processed by an Encased Fan, but does stop the airflow from going beyond the belt."
		""
		"Andesite Tunnels can also be used to separate single items from passing stacks to side outputs."
	]
	quest.2F0B0D4401AA455E.title: "Tunnel"
	quest.2F6B432512FA2A65.quest_desc: ["Attach to any inventory to expand its surface area. Great for access in tight spaces and smart setups with threshold switches."]
	quest.2F9782EE3A7826A2.quest_desc: [
		"The &dSigil&f of Malice is a new sigil that randomly rerolls the &daffixes&f of a tool or piece of gear."
		""
		"It can only be obtained by defeating bosses in other dimensions, like the Nether."
	]
	quest.2F9782EE3A7826A2.quest_subtitle: "&4Invaders&f"
	quest.30039F24EC97CC6C.quest_desc: ["This new tier also shows up in the Haven &eworld tier&f, but it appears far more often in the &eFrontier&f tier."]
	quest.30039F24EC97CC6C.quest_subtitle: "&aUncommon&f"
	quest.302D29E43E9C9A94.quest_desc: [
		"When placed adjacent to any inventory, Packagers can &6create&f Cardboard Packages from the inventory they’re attached to. The process does not require extra materials."
		""
		"When powered with a &credstone&f signal, the packager attempts to fill the package as much as possible. A Cardboard Package has 9 slots of inventory. Placing a written sign on the Packager labels the created Cardboard Package with an address to be sent to."
	]
	quest.30590B11F96963BB.quest_desc: [
		"This simple &2essence&f can save your &alife&f..."
		""
		"When you are about to die, everything will go dark and you will wake up in your bed &asafe&f and sound... with full health and hunger."
		""
		"A diary will be delivered regarding your near-death experience!"
	]
	quest.30590B11F96963BB.quest_subtitle: "Totem &2Essence&f"
	quest.305F917BCC702806.quest_subtitle: "&1Moon&f Ore!"
	quest.307207FA459CD598.quest_desc: ["... I am not going to get tired of talking about &dMystical&f here."]
	quest.307207FA459CD598.quest_subtitle: "... 2.0"
	quest.30A84C6A54BD336E.quest_desc: [
		"A stationary &9Mechanical&f Drill will break blocks in the block in front of it with a time in seconds of (45 x Hardness)/RPM and will hurt entities in an area around it."
		""
		"A Mechanical Drill moved by Contraptions will break blocks and &cdamage&f entities with which it collides without needing a direct supply of Rotational Force."
		""
		"The time it takes for a Mechanical Drill to break a block is based on the Contraption's &aspeed&f and the block's Hardness value. The damage dealt to entities is also based on the Contraption's speed."
	]
	quest.30C364AC05822920.quest_desc: ["With physics in our favor, we can build incredible things, and with the new mechanics, everything becomes &aeasier&f."]
	quest.30C364AC05822920.quest_subtitle: "Getting to know the mod &abetter&f"
	quest.30C364AC05822920.title: "&6Create&f Aeronautics 2"
	quest.30CA7387B27B439C.title: "&6Cloggrum&f Tools"
	quest.30D6BFA1A3B6B205.quest_desc: ["A gearbox where the rotation direction of all 4 sides are independently configurable."]
	quest.31279859BEEB3E5E.quest_desc: ["That is it... it is an xp &csword&f."]
	quest.31279859BEEB3E5E.quest_subtitle: "XP"
	quest.313754B1B708BC31.quest_desc: [
		"With the smithing table we can join tools and &bgems&f together."
		""
		"Make sure your tool has an open &esocket&f, put the tool and the gem on the table, and that is it!"
	]
	quest.313754B1B708BC31.quest_subtitle: "Joining Two Worlds"
	quest.314DBD2F4AD83FD3.quest_desc: [
		"&5Ender&f Guardian is a large shulker-like golem &4boss&f that serves as the boss of the Ruined Citadel."
		""
		"The Ender Guardian spawns if a player approaches the Void Altar located on the third floor of the Ruined Citadel."
		""
		"{entity:cataclysm:ender_guardian ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:FORCE_OFF idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.314DBD2F4AD83FD3.quest_subtitle: "End &4Boss&f"
	quest.31A06D0CDFE935A7.quest_desc: [
		"{ftb\tquests.chapter.mystical_agriculture.quest31A06D0CDFE935A7.description1}"
		""
		"{ftb\tquests.chapter.mystical_agriculture.quest31A06D0CDFE935A7.description2}"
	]
	quest.31A06D0CDFE935A7.title: "{ftb\tquests.chapter.mystical_agriculture.quest31A06D0CDFE935A7.title}"
	quest.31D8BC1E58DD46E0.quest_desc: ["This mod is incredible! This is Sophisticated Storage, clearly one of the best. We can &6create&f chests, barrels, shulker boxes and other items, with huge storage space and &aupgrades&f that make everything better!"]
	quest.31D8BC1E58DD46E0.quest_subtitle: "Sophisticated Storage"
	quest.31E90057B6F054BB.quest_desc: ["We can &6create&f a controller and bind it to our &9system&f to open our storage system even from afar."]
	quest.31E90057B6F054BB.quest_subtitle: "Wireless Access"
	quest.31F32DDFB3F53EF2.quest_desc: ["We will need some Source &7Stone&f for various crafts, it is quite simple."]
	quest.31F32DDFB3F53EF2.quest_subtitle: "&7Stone&f with Gem"
	quest.31F32DDFB3F53EF2.title: "Source &7Stone&f"
	quest.327AD63BFE3170D2.quest_desc: [
		"To travel to the Twilight &5dimension&f, we first need to find a diamond and throw it into the &5portal&f. For this, grab 12 flowers."
		""
		"Follow this image and throw a &bdiamond&f into the water."
		""
		"{image:\tquests:textures/gui/twilight.png width:100 height:100 align:center}"
	]
	quest.327AD63BFE3170D2.quest_subtitle: "Tossing 1 &bDiamond&f Away"
	quest.327AD63BFE3170D2.title: "Creating the &5Portal&f"
	quest.32846AB135D2A5E3.quest_desc: ["This is the basic component for all other &aupgrade&f cards."]
	quest.32DE0C256F164B9F.quest_desc: ["Hello friend! Here in our modpack we have several mods and among them we find Sophisticated Backpacks. It's an excellent backpack mod allowing us to store items in our backpack and use &aupgrades&f to enhance them."]
	quest.32DE0C256F164B9F.quest_subtitle: "Sophisticated Backpacks"
	quest.32F11FC9B6082A0C.quest_desc: [
		"We finally reached the last tier, and this is the best tier for gear and tools!"
		""
		"The &5mythic&f tier is only found in the Summit &eworld tier&f, and it is even more frequent in the Pinnacle world tier."
	]
	quest.32F11FC9B6082A0C.quest_subtitle: "&5Mythic&f"
	quest.331698AEA2CFCB4A.quest_desc: ["The &2Gloomper&f is a very funny and extremely smart little monster. It will not attack you first, but if you attack it, it will defend itself and hit you with &2poison&f!"]
	quest.331698AEA2CFCB4A.quest_subtitle: "A Little Frog"
	quest.338E4A4F41889959.quest_desc: [
		"The ME Crafting Terminal is the upgraded version of the ME Terminal which has an integrated crafting grid with access to a ME &9Network&f's Networked Storage."
		""
		"Like the ME Terminal it also requires a Channel to function."
	]
	quest.3424B27C62D3D2CF.quest_desc: [
		"Allows wireless access via a Wireless Terminal. Range and &epower&f usage is determined based on the number of Wireless Booster installed."
		""
		"A &9network&f can have any number of wireless access points with any number of Wireless Booster in each one, allowing you to optimize power usage and range by altering your setup."
		""
		"Requires a channel."
		""
		"Also used to bind wireless terminals"
	]
	quest.3433F3084D9ACCAE.quest_desc: ["Hello astronaut, welcome to the &1Moon&f... THIS IS PRETTY COOL RIGHT? Okay, don't get overly excited, watch your &3oxygen&f, hope you have plenty with you, how about searching for a new ore?"]
	quest.3433F3084D9ACCAE.quest_subtitle: "We Stole the &1Moon&f!"
	quest.3433F3084D9ACCAE.title: "&1Moon&f"
	quest.34C2F6B171372824.quest_desc: [
		"We need to kill some &4wither&f skeletons to hunt for wither skulls and complete our vanilla path."
		""
		"{entity:minecraft:wither_skeleton ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:FORCE_OFF idle:FORCE_OFF walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.34C2F6B171372824.quest_subtitle: "Hunting for Skulls"
	quest.34C2F6B171372824.title: "&4Wither&f Skeleton"
	quest.34E1AB8D35A5DB54.quest_desc: ["To get this &7armor&f, one of the most beautiful ones, we need to take down the &2Hydra&f."]
	quest.34E1AB8D35A5DB54.quest_subtitle: "Hot as the &6Sun&f"
	quest.34E1AB8D35A5DB54.title: "Fiery &7Armor&f"
	quest.34F617DDF423C6C1.quest_subtitle: "Increase max capacity of each slot"
	quest.3525FD510FCA7C6C.quest_desc: [
		"I believe you aren't a vampire to like blood... but this school is very strong and features amazing &dspells&f!"
		""
		"To make a Blood Vial, place a campfire under a cauldron and throw an animal into the cauldron."
	]
	quest.3525FD510FCA7C6C.quest_subtitle: "Blood School"
	quest.3527A4E254F094F2.quest_desc: ["This incredible &7armor&f is from an &dArs Nouveau&f addon. It is quite strong and, if made properly, even stronger!"]
	quest.3527A4E254F094F2.quest_subtitle: "Ars"
	quest.3527A4E254F094F2.title: "Thunderguard's &7Armor&f"
	quest.35365535ED46DAD0.quest_desc: ["Applied Energistics 2 (AE2) is a comprehensive mod for Minecraft that introduces a unique approach to in-game inventory management. Its theme is centered around the concept of converting matter into &eenergy&f and vice versa, to store and transport your items and &3fluids&f instantaneously!"]
	quest.35365535ED46DAD0.quest_subtitle: "Starting!"
	quest.35365535ED46DAD0.title: "AE2"
	quest.3562111D841CF498.quest_desc: [
		"The Sequenced Gearshift allows finer control over Rotational &epower&f, allowing multiple changes to the rotation over a period of time."
		""
		"The Sequenced Gearshift can be given up to 5 commands at a time. Each command can be adjusted by hovering over them and scrolling in the interface."
		""
		"The first column consists of the commands Turn by angle, Turn by Piston, Timed Delay, Await New &cRedstone&f Pulse, and End. The first two are simply different measurements of rotation corresponding to Mechanical Pistons and Mechanical Bearings, the third makes the Gearshift wait before proceeding to the next command, while the fourth stops the sequence until the Gearshift receives another pulse. End signifies &5the end&f of a sequence, but is not necessary for a sequence to be completed."
		""
		"{@pagebreak}"
		""
		"The second column adjusts the measurements for each command. Up to 360 Degrees for Turn, 128 blocks for Piston, and 30 seconds for Wait."
		""
		"The third column adjusts &aspeed&f and direction. Here, rotation can be doubled, reversed, both, or neither."
		""
		"A Redstone Comparator can be used to detect what instruction a Sequenced Gearshift is on. It will output a signal strength of up to 5, regardless of how many instructions are in the Gearshift."
	]
	quest.35639D4A6DDF6FF9.quest_desc: [
		"The Clutch stops outgoing rotation when a &credstone&f signal is applied."
		""
		"When the Clutch is not activated, it will transfer rotation like a Shaft. When it is activated, it will stop transferring rotation."
	]
	quest.35A5750F7BA0B7CF.quest_desc: [
		"Ah, the &bAether&f..."
		""
		"A mod so beloved among us and deeply nostalgic."
		""
		"Yet it hides unimaginable dangers... Face new creatures and play in a world completely different from ours... This is the Aether."
	]
	quest.35A5750F7BA0B7CF.quest_subtitle: "Nostalgia and Fun"
	quest.35C37231C1C86294.quest_desc: [
		"Super glue has two modes of application: Block by Block Mode and Area Mode. These modes can be intermixed on the same contraption."
		""
		"Each use of the super glue decreases its durability by one. (Durability in this case means the number of times that a tube of super glue can be used. The glue attaching blocks is permanent until removed.) Super Glue can be Enchanted with unbreaking and mending to extend its &alife&f."
		""
		"{@pagebreak}"
		""
		"Block by Block Mode"
		"In block-by-block mode, super glue is used just like a Slimeball. Right clicking on a Linear Chassis or Radial Chassis while holding the super glue, coats the face of a chassis with green glue allowing other blocks to be attached."
		""
		"Super glue can also be held in the off hand while placing blocks to &9automatically&f glue each block individually. Note that the edges of chassis cannot be coated with glue like the face can. However, while holding super glue in the off-hand, blocks can still be attached to the edges of chassis."
		""
		"Remove glue coatings from the faces of chassis by right clicking with an empty hand while sneaking."
		""
		"{@pagebreak}"
		""
		"Area Mode"
		"Area mode is used to glue collections of blocks together after they have been placed. Glue a 3-D section of blocks by right clicking a block on one corner of the section while holding the super glue. Move the cursor to the opposite corner of the section. A green box will appear indicating the blocks which will be glued together. Right click again to complete the glueing process. To abort the process, right click while sneaking."
		""
		"The second block can be up to 24 blocks away from the initially selected block and the maximum volume of selection is 2312. No matter the size of the selection, only 1 durability will be used. Overlapping instances of super glue will combine while keeping their shape. Note that the game will not allow you to select the face of a chassis in area mode, it will instead revert to block by block mode. To select a chassis in area mode, click on the side rather than the face."
		""
		"Glued areas can be seen simply by holding the super glue in the main hand. Glued areas will be outlined in green. Note that blocks glued by first coating a surface with glue and then attaching a block (as in the Block by Block Mode) will not show a green outline. However, blocks attached with the super glue in the off hand will show a green outline."
	]
	quest.35C37231C1C86294.title: "&aSuper Glue"
	quest.35C69F1A9F2D95AB.quest_subtitle: "Level 5"
	quest.35CB6CA0EEE8C848.quest_desc: ["This sanctuary was forgotten and monsters took over the place, there are many... so stay sharp!"]
	quest.35CB6CA0EEE8C848.quest_subtitle: "Monsters and More Monsters"
	quest.35F24F6E403AADA1.quest_desc: ["A gearbox with shafts on all 6 sides. Conceptually uses the same internal mechanism as Parallel Gearbox, so top and bottom spins at half &aspeed&f."]
	quest.360FC112BC79E9DB.quest_subtitle: "Our Blood &dMagic&f"
	quest.3617DE87C4E1BCB9.quest_desc: ["The Hand Crank generates a small amount of Rotational Force through player interaction."]
	quest.36268EBCE1143F0A.quest_desc: [
		"We can use a slimeball to repair chipped or broken corners of cars, boats, planes..."
		"Click with the slimeball on damaged parts."
	]
	quest.36268EBCE1143F0A.quest_subtitle: "Repair"
	quest.371BB0B5D2347185.quest_desc: ["We can improve our &7axe&f with an &7ore&f, which makes it a bit better and gives it a new attribute."]
	quest.371BB0B5D2347185.quest_subtitle: "Leaving the Conventional Behind"
	quest.3734081CB77CDBB5.quest_desc: [
		"Matter Balls in a Matter Cannon can be substituted with Paint Balls, which will apply a paint splatter effect on the face of whatever block being fired at."
		""
		"Lumen Paint Balls are a variant of paint balls exclusively used by the Matter Cannon, whose paint splatters also give off some light once present in the world."
	]
	quest.37388CAD4435A48B.quest_desc: ["This beautiful thing is simply one of the best &cswords&f in the game, and with its &aupgrade&f slot things only get better!"]
	quest.37388CAD4435A48B.quest_subtitle: "One of the Strongest"
	quest.376304CC25EFAFCF.quest_subtitle: "Evocation School &7Armor&f"
	quest.376304CC25EFAFCF.title: "Archevoker &7Armor&f"
	quest.3763C9494249EC62.quest_subtitle: "{ftb\tquests.chapter.mystical_agriculture.quest3763C9494249EC62.subtitle}"
	quest.3763C9494249EC62.title: "{ftb\tquests.chapter.mystical_agriculture.quest3763C9494249EC62.title}"
	quest.378C79BB8DDE9AE8.quest_subtitle: "A Better &6Furnace&f"
	quest.37CEF3958664FD41.quest_desc: ["As our first &dspell&f, we can craft a Light &dGlyph&f. Simply clicking with it in the air allows us to learn this spell! With it, we can illuminate the world!"]
	quest.37CEF3958664FD41.quest_subtitle: "First &dSpell&f"
	quest.383784BD11018358.title: "{ftb\tquests.chapter.mystical_agriculture.quest383784BD11018358.title}"
	quest.383C6C030B6A5F90.quest_desc: ["There is something sacred about these &dspells&f... okay, as unbelievable as it sounds, no burning witches here... but there really is something sacred about these spells... this school is very interesting."]
	quest.383C6C030B6A5F90.quest_subtitle: "Holy School"
	quest.383D6F1A001A0AEC.quest_desc: ["Chutes transport items vertically, generally downward unless an encased fan is used to blow items upward. There are two varieties: Chute and Smart Chute. Smart Chutes allow the player to control the types of items passed and their stack size."]
	quest.38B84F3ADA7952F5.quest_desc: ["In our modpack we can go one level above &8netherite&f armor: we can combine netherite with some &7ores&f and make it stronger and more powerful!"]
	quest.38B84F3ADA7952F5.quest_subtitle: "Improving the Best"
	quest.38B84F3ADA7952F5.title: "&8Netherite&f-Emerald Armor"
	quest.38C6D933BE2A7E5D.quest_desc: ["Our new multiblock allows mixing materials and obtaining alloys from those materials."]
	quest.38C6D933BE2A7E5D.quest_subtitle: "Mixing"
	quest.38E84EA139A2316C.quest_desc: [
		"The Drive is the device you plug your storage cells into in order to use them for &9network&f storage. It has 10 slots which each accept a cell."
		""
		"If for some reason you want to, you can push and pull the cells from its inventory with any item logistics like hoppers or ae2 busses."
		""
		"It can be rotated with a Certus Quartz &aWrench&f."
	]
	quest.38E9C4DB82B1279A.quest_desc: [
		"While stationary, certain items can be applied to the block's filter. If it has a filter, it will only affect that contraption actor. If powered with a &credstone&f signal before and while it is assembled, the contraption actors will start out disabled. Keep in mind that redstone and levers assembled on Contraptions have no effect."
		""
		"While on an assembled Contraption, Contraption Controls can be right-clicked to enable and disable certain Contraption Actors."
	]
	quest.3931273289B3A68C.quest_desc: [
		"Fluix ME Glass Cable is the simplest cable to make, transfers &epower&f and up to 8 channels. It comes in 17 different colors, the default being Fluix, and can be dyed any color using any of the 16 dyes."
		""
		"To craft colored cables surround a dye of any type with 8 cables of the same type ( color of the cables dosn't matter, but they must be the same type, glass, smart, etc ). You can also paint cables with any forge compatible paint brush in world."
		""
		"You can craft any colored cable with a &3water&f bucket to remove the dye."
		""
		"You can cover the cable with wool to &6create&f Fluix ME Covered Cable, and craft Fluix ME Smart Cable to get a &abetter&f idea of what is going on with your channels."
	]
	quest.3990828CCE937FA0.quest_desc: ["Apparently the &1warden&f really did come from another world... something supernatural is in this place. Find the &1ancient city&f and defeat a warden so we can start exploring this mysterious place."]
	quest.3990828CCE937FA0.quest_subtitle: "The Home of the &1Warden&f"
	quest.3990828CCE937FA0.title: "Deep And Darker"
	quest.3999760881C855FA.quest_desc: [
		"The Chemical Crystallizer turns Clean Slurry into Crystals, Lithium into Lithium Dust and Antimatter into Antimatter Pellet. This is one of the select many &9machines&f in &9Mekanism&f to have dedicated, unchangeable sides, for input and output, with the exception of Item's config sides."
		""
		"Input is gas (uses Pressurized Tube) and output is items (uses Logistical Transporter)"
	]
	quest.39B0061C40FD5B67.quest_subtitle: "Throw a feather into the &6fire&f"
	quest.39D2E5654A911DBB.quest_desc: ["This generator takes advantage of &2food&f sub-extracts to generate your &bmana&f! Place a pedestal next to it with food!"]
	quest.39D2E5654A911DBB.quest_subtitle: "Generating with &2Food&f"
	quest.39F43CF8BFFA46A0.quest_desc: ["This &9machine&f combines items, perfect for new types of recipes."]
	quest.39F43CF8BFFA46A0.quest_subtitle: "Our Second Multiblock"
	quest.3A2633B6030BBC52.quest_desc: ["While worn, the Engineer's Goggles will show the stress impact of the viewed &9machine&f while it is running. They will also give numbers and highlight the current rotation when looking at a Stressometer or Speedometer. Additionally, they show how much &3fluid&f is in a tank along with the total storage capacity of the tank."]
	quest.3ADDA80FD3DFB33B.quest_desc: [
		"When we eat this fruit, we can see the world with different eyes and glimpse the hidden..."
		""
		"While under the effect of the fruit, we can break &5Occultism&f blocks much &abetter&f!"
		""
		"It can fail sometimes!"
	]
	quest.3ADDA80FD3DFB33B.quest_subtitle: "Seeing the World with Different Eyes!"
	quest.3ADF5889DFB9121C.quest_desc: ["{entity:minecraft:ender_dragon ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:FORCE_OFF walk:FORCE_OFF width:200 height:100 align:center}"]
	quest.3ADF5889DFB9121C.quest_subtitle: "Kill &5Ender Dragon&f"
	quest.3ADF5889DFB9121C.title: "&5Ender Dragon&f"
	quest.3AFA504735B789C0.quest_desc: ["In engineering, we need millimeter precision; this lever might be exactly what you're looking for!"]
	quest.3AFA504735B789C0.quest_subtitle: "&ePower&f Control"
	quest.3B3C89649DF57161.quest_desc: [
		"Quantum &9Network&f Bridges can extend a network over infinite distances and even between &5dimensions&f. They can carry 32 channels in total (regardless of how cables are connected to each face), essentially acting like a wireless dense cable."
		""
		"Eight of these quantum rings placed around a ME Quantum Link Chamber will create a Quantum Network Bridge. Only the 4 ME Quantum Ring blocks adjacent to the ME Quantum Link Chamber will accept network connections, the 4 corner blocks cannot connect to cables."
	]
	quest.3B43DB1A6B0A7B44.quest_desc: ["Bio Fuel is added by &9Mekanism&f and is a type of fuel used inside of a Bio-Generator. Beyond that Bio Fuel is used in the Pressurized Reaction Chamber to &6create&f Ethylene."]
	quest.3BA16477C131C63C.quest_subtitle: "Tier 4"
	quest.3BC139FA66626100.quest_desc: ["This &7axe&f is perfect for the early game!"]
	quest.3BC139FA66626100.quest_subtitle: "Fluix?"
	quest.3BDFA23A7CE8E173.quest_desc: [
		"Throw an oak sapling into occult &6fire&f to turn it into an occult sapling! Plant the tree and watch it &agrow&f! But to see its true occult form, eat another fruit! And break it only under the fruit's effect."
		""
		"You will need to throw various items into the fire!"
	]
	quest.3BDFA23A7CE8E173.quest_subtitle: "Occult Tree!"
	quest.3BF486B9A4924DEB.quest_desc: ["Sometimes the basics just work."]
	quest.3BF486B9A4924DEB.quest_subtitle: "Keeping It Conventional"
	quest.3C13A07E90BC9312.quest_desc: ["There is not much to explain, the name already says it all."]
	quest.3C13A07E90BC9312.quest_subtitle: "&bDiamond&f + Diamond = Super Diamond"
	quest.3C1B56EBC567CB02.quest_desc: ["This &4boss&f is the guardian of the new &8dungeon&f... be careful with it, its powers are out of this world."]
	quest.3C1B56EBC567CB02.quest_subtitle: "&4Boss&f"
	quest.3C1DD9DBED86AE6F.quest_desc: ["We can generate &bmana&f with this generator when eliminating or breeding mobs around it."]
	quest.3C1DD9DBED86AE6F.quest_subtitle: "Generating with Lives"
	quest.3C352E5DCE537254.quest_desc: ["Craft &7armor&f using the Naga's drop."]
	quest.3C352E5DCE537254.quest_subtitle: "Naga Drop"
	quest.3C49F2EEDCCAF1DF.quest_desc: [
		"A basic layout of your factory should be like this: "
		""
		"Raw Ore goes into your Chemical Dissolution Chamber then pumps A GAS to Chemical Washer then pumps A GAS to Chemical Crystallizer then outputs crystals to Chemical Injection Chamber then outputs shards to Purification Chamber then outputs clumps to Crusher then outputs dirty dusts to Enrichment Chamber then outputs clean &7dust&f to Smelter."
	]
	quest.3C50723252069D30.quest_desc: ["Few things in this mod are as &eimportant&f as exploration. Explore the world in search of wizard houses and other structures; there we can find our first scrolls and several crucial items."]
	quest.3C50723252069D30.quest_subtitle: "Exploration"
	quest.3C5D84B0D51474E7.title: "{ftb\tquests.chapter.mystical_agriculture.quest3C5D84B0D51474E7.title}"
	quest.3CAB660D10C42BB4.quest_desc: [
		"Okay, I know it feels like a dream entering this beloved &5dimension&f again..."
		""
		"But wake up! Don't forget what you came for: defeat the &4bosses&f and ensure peace in the skies."
	]
	quest.3CAB660D10C42BB4.quest_subtitle: "Entering a Dream"
	quest.3CDEA7F1A004F8DC.quest_subtitle: "Mending"
	quest.3D2F4E9242F96F4D.quest_desc: ["Students went to &5the end&f of the line to &6create&f this school. Their spells are impressive and very strong."]
	quest.3D2F4E9242F96F4D.quest_subtitle: "&5Ender&f School"
	quest.3DC74356834228D8.quest_desc: ["The Regulator &aUpgrade&f is an upgrade for Exporters and Importers that maintains a set amount of resources in the connected inventory."]
	quest.3E0003E4F668E92A.quest_desc: ["This little monster is extremely furious! Be &ccareful&f with it."]
	quest.3E0003E4F668E92A.quest_subtitle: "Rage!"
	quest.3E66107BBC14089B.quest_subtitle: "Level 5"
	quest.3EB76F4243716FB5.quest_subtitle: "Core for Enchanting"
	quest.3ED5669772436080.title: "&5Utherium&f Tools"
	quest.3F64E97936F08E15.quest_subtitle: "Our Holy &dMagic&f"
	quest.3F925BFD3CF1DC0B.quest_subtitle: "Used to increase the range of the wireless access point."
	quest.3FEEED5377A90191.quest_desc: ["This is the yellow sanctuary! A sanctuary full of challenges with an incredible &ereward&f."]
	quest.3FEEED5377A90191.quest_subtitle: "A Great Challenge!"
	quest.4083834439278AC3.quest_subtitle: "&bDiamond&f Chest"
	quest.40CDA8B7AAC831B0.quest_desc: [
		"A huge serpent lives in this world and this serpent is the first &4boss&f of Twilight."
		""
		"The Naga must be defeated in segments: she is massive, and you need to keep damaging her body parts to bring her down at &5the end&f."
		""
		"{entity:twilightforest:naga ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:FORCE_OFF walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.40CDA8B7AAC831B0.quest_subtitle: "The First Challenge"
	quest.413869D9ACF48D10.quest_desc: ["Let's battle some monsters... even to collect some XP and test our strength before finding a fortress."]
	quest.413869D9ACF48D10.quest_subtitle: "Defeating some monsters"
	quest.413869D9ACF48D10.title: "Kill Mobs"
	quest.4143F14C28FA7960.quest_desc: [
		"In this world exploring, we can find the &2Dark Forest&f..."
		""
		"In this dark forest you will find a structure leading underground."
		""
		"To enter, you need to place a trophy head of one of the &4bosses&f you defeated on a pedestal; upon leaving, you will retrieve the head."
		""
		"Descend through the layers until you find the &4boss&f."
		""
	]
	quest.4143F14C28FA7960.quest_subtitle: "&2Dark Forest&f"
	quest.4167B92ED5B27A15.quest_desc: ["We can build new tools whenever we reach a new &2seed&f tier in &dMystical&f, always getting stronger!"]
	quest.4167B92ED5B27A15.quest_subtitle: "New Tools"
	quest.4167B92ED5B27A15.title: "Awakened Tools"
	quest.417457E2EB5F3657.quest_desc: ["Did you know trading isn't the only way to get &5ender&f pearls? There's also a mob called &5Enderman&f that drops them... I'm teaching the easiest method, I'm a Minecraft pro player (just kidding)."]
	quest.417457E2EB5F3657.quest_subtitle: "King of Trades"
	quest.417457E2EB5F3657.title: "&5Ender&f Pearl"
	quest.41792C2BB29C3449.quest_desc: ["Inside our modpack we still have the vanilla armors, but here they will not be very good."]
	quest.41792C2BB29C3449.quest_subtitle: "Vanillas"
	quest.41792C2BB29C3449.title: "&bDiamond&f Armor"
	quest.4181323BF72047A9.quest_desc: [
		"Right-click a valid conductor with a schedule to give it to them. A conductor must either be a mob Seated directly in front of Train Controls on an assembled Train or a &6Blaze&f Burner positioned similarly."
		""
		"3 types of commands can be added."
		""
		"Travel to Station - Navigate to a specified Train Station."
		"Update Schedule Title&r - Name of route as displayed by the Train Station summary in the Display Link."
		"Limit Max &aSpeed&f - Change max speed when traveling to a station."
	]
	quest.419BBE875D40B1D6.quest_desc: [
		"The ME Export Bus extracts items from the ME &9Network&f's Networked Storage and places them into the inventory it faces."
		""
		"You must configure which items it will insert, leaving the configuration blank will result in nothing."
		""
		"The ME Export Bus will try to export any of the items on its list skipping over those it cannot fit into the destination."
		""
		"The ME Export Bus&r requires a Channel to function."
		""
		"This is the functional opposite of the ME Import Bus."
	]
	quest.41CEBA836A8BA22C.quest_desc: [
		"We now need to place a clutch in front of the generator; in front of the clutch, place a vertical gearbox. On top of the generator, place an andesite casing block; in front of the andesite casing block, place a redstone, and on top of the andesite casing block, a redstone link with 2 torches. Use \"Shift\" + \"Click\" to set it to receiver mode."
		""
		"{image:\tquests:textures/gearbox.png width:180 height:100 align:center}"
	]
	quest.41CEBA836A8BA22C.quest_subtitle: "Connecting"
	quest.41E5E6BF7CB5063F.quest_subtitle: "{ftb\tquests.chapter.mystical_agriculture.quest41E5E6BF7CB5063F.subtitle}"
	quest.41E5E6BF7CB5063F.title: "{ftb\tquests.chapter.mystical_agriculture.quest41E5E6BF7CB5063F.title}"
	quest.41EB0C570FC54F43.quest_desc: [
		"&aChemical Tanks&r are used to store &7Gases&r."
		""
		"They can be placed as a block and can interact with &dPressurized Tubes&r."
		""
		"They come in four tiers, each tier double the capacity and output rate of its predecessor."
	]
	quest.4204702AA6FBF40B.quest_desc: [
		"The Chargepad is a wireless electric charging station. Any rechargeable items you have in your inventory will be charged while standing on it."
		""
		"The Chargepad can recharge any item that requires any form of &eenergy&f. It also functions as the deployment and teleportation point for your Robit."
	]
	quest.4204702AA6FBF40B.quest_subtitle: "Charging station"
	quest.420D7ABA06B2A643.quest_desc: ["Inside &dIron's Spellbooks&f, besides several new &dspells&f, we can also get incredible new armor that combos with our spells."]
	quest.420D7ABA06B2A643.quest_subtitle: "&dSpells&f!"
	quest.4236B9F071BE18F3.quest_desc: [
		"The Rotary Condensentrator (pronounced \"con-DEN-sen-traitor\") is used for converting substances between liquid and gaseous forms at a rate of 1:1. It has two modes: Decondensentrating, which turns Liquids into Gases, and Condensentrating, which turns Gases into Liquids."
		""
		"In Decondensentrating mode:"
		""
		"&3Liquid&f→Gas"
		"&3Water&f→Water Vapor"
		"Liquid Sulfuric Acid→Sulfuric Acid"
		"Liquid &3Hydrogen&f Chloride→Hydrogen Chloride"
		"Liquid &3Oxygen&f→Oxygen"
		"Liquid Hydrogen→Hydrogen"
		"Liquid Ethylene→Ethylene"
		"Liquid Chlorine→Chlorine"
		"Liquid Sulfur Dioxide→Sulfur Dioxide"
		"Liquid Sulfur Trioxide→Sulfur Trioxide"
		"&3Brine&f→Gaseous Brine"
		"Liquid Lithium→Lithium"
		"and the opposite is true in Condensentrating mode."
		""
		"Extract liquids with Mechanical Pipe by setting them to \"pull\" (use a Configurator and Shift+Right click the outer edges of the pipe)."
	]
	quest.4266BF7FCE3B4330.quest_desc: [
		"The Cogwheel is a basic &9mechanical&f component in &6Create&f that relays rotation."
		"The Large Cogwheel is a larger variant of the cogwheel that can relay rotation around corners and power Rotation Speed Controllers."
	]
	quest.4266BF7FCE3B4330.title: "Cogwheels"
	quest.4276B941670CE0E2.quest_desc: [
		"P2P tunnels are a way to move things like items, fluids, &credstone&f signals, power, light, and channels around a network without them directly interacting with the network. There are many variants of P2P tunnel but each only transports its specific type of thing. They essentially act like &5portals&f that directly connect two block faces at range. They are not bi-directional, there are defined inputs and outputs."
		""
		"{@pagebreak}"
		""
		"There are many types of P2P tunnel. Only the ME P2P tunnel is directly craftable, the others are made by right-clicking other P2P tunnels with certain items:"
		""
		"ME P2P tunnels are selected by right-clicking with any cable."
		"Redstone P2P tunnels are selected by right-clicking with a variety of redstone components."
		"Item P2P tunnels are selected by right-clicking with a chest or hopper."
		"&3Fluid&f P2P tunnels are selected by right-clicking with a bucket or bottle."
		"&eEnergy&f P2P tunnels are selected by right-clicking with almost any energy-containing item."
		"Light P2P tunnels are selected by right-clicking with a torch or glowstone"
		"Some tunnel types have quirks. For instance, ME P2P tunnels' channels cannot pass through other ME P2P tunnels, and Energy P2P tunnels indirectly extract a 2.5% tax on FE flowing through themselves by increasing their energy draw."
		""
		"{@pagebreak}"
		""
		"The most common use case of P2P tunnels is using a ME P2P tunnel to compact the density of channel transport. Instead of a bundle of dense cable, a single dense cable can be used to carry many channels around."
	]
	quest.4291A72FF87220D5.quest_desc: [
		"There is also an inverted version of the toggle bus that &ndisables&r the connection when a &credstone&r signal is supplied."
		""
		"When &credstone&r signal is supplied, the part &nenables&r the connection; &6ME Inverted Toggle Bus&r provides the &nreverse&r behavior by &ndisabling&r the connection instead."
	]
	quest.42BF5EE98DE53564.quest_subtitle: "+++ &dAugment&f"
	quest.43E504E88FCD08CF.quest_desc: [
		"Yes! In our modpack we still have the vanilla &cswords&f..."
		""
		"These days that is a surprise, trust me..."
	]
	quest.43E504E88FCD08CF.quest_subtitle: "Vanilla"
	quest.43FFDFDD7958443C.quest_desc: ["Traveling to the &bAether&f, we can make this almost incredible &csword&f!"]
	quest.43FFDFDD7958443C.quest_subtitle: "&bAether&f"
	quest.4434D7B66521D69A.quest_desc: ["Pressurized Tubes are used to transport &3Gases&f."]
	quest.449C60985F16226E.quest_desc: [
		"{ftb\tquests.chapter.mystical_agriculture.quest449C60985F16226E.description1}"
		""
		"{ftb\tquests.chapter.mystical_agriculture.quest449C60985F16226E.description2}"
		""
		"{ftb\tquests.chapter.mystical_agriculture.quest449C60985F16226E.description3}"
		""
		"{ftb\tquests.chapter.mystical_agriculture.quest449C60985F16226E.description4}"
	]
	quest.449C60985F16226E.title: "{ftb\tquests.chapter.mystical_agriculture.quest449C60985F16226E.title}"
	quest.44BA8AF70B6911C2.quest_desc: ["Store your surplus &eenergy&f! No waste."]
	quest.44BA8AF70B6911C2.quest_subtitle: "Storing &eEnergy&f"
	quest.44DD55460BE2E576.quest_desc: ["In &bAether&f we can collect a small piece of cloud and fly like Goku on it."]
	quest.44DD55460BE2E576.quest_subtitle: "Goku"
	quest.4512B97451C2221F.quest_desc: ["The &9Mechanical&f Arm can take or deposit items from various blocks within a 5 block radius of where it is placed. A placed Mechanical Arm's selected blocks can be viewed by hovering over it with a &aWrench&f. The Mechanical Arm is capable of transferring up to a stack of items at once."]
	quest.458276C0CAE3F85A.quest_desc: ["We can have &abetter&f versions of our gear!"]
	quest.458276C0CAE3F85A.quest_subtitle: "Vanilla+"
	quest.458276C0CAE3F85A.title: "Super &bDiamond&f Armor"
	quest.458826F7BC0D3554.quest_desc: [
		"{ftb\tquests.chapter.mystical_agriculture.quest458826F7BC0D3554.description1}"
		""
		"{ftb\tquests.chapter.mystical_agriculture.quest458826F7BC0D3554.description2}"
	]
	quest.458826F7BC0D3554.title: "{ftb\tquests.chapter.mystical_agriculture.quest458826F7BC0D3554.title}"
	quest.45BA5B8A785E1B82.quest_desc: [
		"Using a &aWrench&f on a component will rotate the component around the face with which you interacted."
		""
		"Using a Wrench on a component, &credstone&f component, rail or vanilla rail variant will dismantle it and place it in your inventory. Any block which can be rotated or otherwise interacted with using right click must be dismantled while sneaking."
		""
		"Hovering over certain configurable components will allow configuration by scrolling."
		""
		"For certain components such as the Linear Chassis, ctrl can be held to configure all connected components at once."
	]
	quest.45D99E459A6A38F3.quest_desc: ["We need to paint our vehicles; nobody deserves everything in the same color. We can dye the blocks using any dye!"]
	quest.45D99E459A6A38F3.quest_subtitle: "Painting"
	quest.46004D01A142777E.quest_desc: ["Smart &3Fluid&f Pipes can be used to allow only a certain &3liquid&f to pass through them."]
	quest.464B95EE9D942B03.quest_desc: [
		"It would be nice to clear the area a bit... these &5Endermen&f are so annoying, how about wearing a pumpkin?"
		""
		"{entity:minecraft:enderman ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:FORCE_OFF idle:FORCE_OFF walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.464B95EE9D942B03.quest_subtitle: "Clearing the Area"
	quest.464B95EE9D942B03.title: "&5Enderman&f"
	quest.468232EFC7379EC6.quest_desc: ["We can make this &1Stellaris&f &csword&f and travel between planets (the sword has nothing to do with the traveling)."]
	quest.468232EFC7379EC6.quest_subtitle: "Traveling Between Worlds!"
	quest.468BCDDF89C03143.quest_subtitle: "With Fiery &7Ingot&f we can make new tools"
	quest.468BCDDF89C03143.title: "Fiery Tools"
	quest.46A1A6F4D6C5E62E.quest_desc: ["&dMystical&f &7armor&f starter tiers might not be the best, but the final tiers are probably top tier!"]
	quest.46A1A6F4D6C5E62E.quest_subtitle: "Great Equipment!"
	quest.46A1A6F4D6C5E62E.title: "Prudentium &7Armor&f"
	quest.46BC3623B86D64AF.quest_subtitle: "Drop"
	quest.46EBE6B0E06D750D.quest_desc: ["Used with &6Spatial IO Port&r to store spatial regions."]
	quest.470B1F84D01E4F7A.quest_desc: ["Charged Certus Quartz is crafted by inserting a Certus Quartz Crystal into the Charger, and powering it."]
	quest.470B1F84D01E4F7A.quest_subtitle: "Charged Quartz"
	quest.47106CE1937C4340.quest_desc: ["To get an HDPE Sheet, place 3 HDPE Pellets in an Enrichment Chamber."]
	quest.47975B3E8E3D3AD1.quest_desc: [
		"The Leviathan is a powerful aquatic &4boss&f found in the Sunken City."
		""
		"{entity:cataclysm:the_leviathan ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:FORCE_OFF idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.47975B3E8E3D3AD1.quest_subtitle: "Aquatic &4Boss&f"
	quest.47CF6535737D2172.quest_desc: [
		"This &2essence&f is very powerful. To use it, make sure:"
		""
		"1 - It is daytime"
		"2 - It is in your off-hand"
		"3 - You are exposed to the &6sun&f"
		""
		"It applies Saturation, Regeneration, &aSpeed&f, Haste, and Resistance."
	]
	quest.47CF6535737D2172.quest_subtitle: "&2Essence&f of Light"
	quest.484BEC8FEEC0F4DA.quest_desc: [
		"Watch where you walk. Out in the deep lands we can step on an infested &1sculk block&f and then..."
		""
		"They count as &4mini bosses&f and they really love to bite!"
	]
	quest.484BEC8FEEC0F4DA.quest_subtitle: "A Huge Worm"
	quest.488DBE69595F38F8.quest_desc: ["The energized smelter is your basic electric &6furnace&f that uses &eenergy&f instead of fuel to smelt items."]
	quest.48BA2E46C8B40EEE.quest_subtitle: "Use for Uncommon Scrolls"
	quest.48CDFAEEE0408019.quest_subtitle: "&6Create&f an Essence"
	quest.491FDCFB1431A038.quest_desc: ["If we need to link a chest that is far from our &9system&f, we can attach this Inventory Cable Connector to the chest and run a cable to our inventory connector."]
	quest.491FDCFB1431A038.quest_subtitle: "Connecting from Afar"
	quest.49418B7D8CEDB15E.quest_desc: [
		"Okay, do I really have to explain this one? Well, fine... "
		""
		"You can rename items..."
	]
	quest.49418B7D8CEDB15E.quest_subtitle: "Renaming"
	quest.49532B5E8B2D13CE.quest_desc: ["In Occultism, we can create various spells by \"drawing\" on the floor with chalk, accompanied by candles. We have different types of candles and chalk for different spells."]
	quest.49532B5E8B2D13CE.quest_subtitle: "The &dMagic&f Foundation"
	quest.4970CC2851818A02.quest_subtitle: "{ftb\tquests.chapter.mystical_agriculture.quest4970CC2851818A02.subtitle}"
	quest.4970CC2851818A02.title: "{ftb\tquests.chapter.mystical_agriculture.quest4970CC2851818A02.title}"
	quest.49BA104F2E73D3D0.title: "{ftb\tquests.chapter.mystical_agriculture.quest49BA104F2E73D3D0.title}"
	quest.49BC643884373A65.quest_desc: [
		"Croptopia is an incredible mod that allows us to craft various types of foods and have a huge &2farm&f outside our home!"
		""
		"We can &2plant&f and prepare incredible meals in various ways; each utensil has its own function!"
	]
	quest.49BC643884373A65.quest_subtitle: "New Yummy &2Food&f"
	quest.49BC643884373A65.title: "Croptopia"
	quest.49CADAEDDB724373.quest_subtitle: "Eat &9Automatically&f"
	quest.49E36D3C3092346E.quest_desc: [
		"The IO Port allows you to rapidly fill or empty storage cells to or from &9network&f storage."
		""
		"It can be rotated with a Certus Quartz &aWrench&f."
		""
		"The IO Port can be set to move the cell to the output slots when the cell is empty, full, or when the work is done."
		"If a &cRedstone&f Card is inserted, there will be options for various redstone conditions."
		"In the center of the GUI, there is an arrow to set which direction to transfer items, from the cell to network storage, or from storage to the cell."
		"&aUpgrades&f"
		"The IO Port supports the following upgrades:"
		""
		"Acceleration Card increases the amount of stuff moved per operation"
		"Redstone Card adds redstone control, allowing active on high signal, low signal, or once per pulse"
	]
	quest.49F3C168C8946C08.quest_subtitle: "Level 5"
	quest.4A0BA9574A2FF755.quest_desc: [
		"This incredible and beautiful &7armor&f can only be made once we find and defeat a monster that lives hidden in the &6desert&f!"
		""
		""
		"{entity:cataclysm:kobolediator ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:USE_GLOBAL width:100 height:100 align:center}"
	]
	quest.4A0BA9574A2FF755.quest_subtitle: "Ancestral"
	quest.4A0BA9574A2FF755.title: " Bone Reptile &7Armor&f"
	quest.4A0BC148F29ADA79.quest_desc: [
		"We need occult fire to progress in almost everything! Throw a fruit on the floor and ignite it with flint and &3steel&f to &6create&f occult fire!"
		""
		"To make it infinite and non-extinguishing, place it over an oak, netherrack, or coal block."
	]
	quest.4A0BC148F29ADA79.quest_subtitle: "Occult &6Fire&f!"
	quest.4A21ACC5F89557D7.quest_subtitle: "Level 10"
	quest.4A47E558AD90EB64.quest_desc: ["Provides an interface to access two inventories simultaneously. Also comes with filter slots to quickly sort incoming items."]
	quest.4A7F96E62A5845C5.quest_desc: [
		"&9Mechanical&f Pistons are a Contraption that will collide with unmovable blocks."
		""
		"To extend, the Piston must have Piston Extension Poles at &5the end&f as well as Rotational &epower&f. The maximum extension pole length is 64 blocks, and this can be changed in the Config."
		""
		"When the rotation is reversed, the piston will retract. The end must be made sticky with a Slimeball to bring the pushed blocks back with it."
	]
	quest.4AF08181C6BED2FD.quest_desc: ["We definitely need decent gear; this will do for now, but you will need to &astudy&f &9Mekanism&f."]
	quest.4AF08181C6BED2FD.quest_subtitle: "&aBetter&f Equipment"
	quest.4AF08181C6BED2FD.title: "Refined Obsidian &7Armor&f"
	quest.4AFF81D3D0E78255.quest_desc: ["The Chemical Washer turns Slurry into Clean Slurry using Water. The clean slurry then needs to be further refined by pumping it into a Chemical Crystallizer. Note that unlike most Mekanism machines this one has fixed \"in\" and \"out\" sides for the mineral flow. \"In\" will be on the left when first placed and \"out\" is on the right. It can of course be rotated with the Configurator. Water is piped in through the top of the machine."]
	quest.4B574B802F83F725.quest_desc: ["We need to generate torque for our car; we can use a &8coal&f-powered torque generator, place it at the back of our car."]
	quest.4B574B802F83F725.quest_subtitle: "Generating torque"
	quest.4B5CEA6D90440B24.quest_desc: [
		"&eHello friend&f, this new place is something incredible!"
		""
		"Come with me and I will show you the wonder hidden behind a simple &5portal&f..."
	]
	quest.4B5CEA6D90440B24.quest_subtitle: "A Weird &5Dimension&f..."
	quest.4B5CEA6D90440B24.title: "The &2Undergarden&f"
	quest.4B6F1EC56FA5B9F7.quest_subtitle: "Our Ice &dMagic&f"
	quest.4B976C143EDA4317.quest_desc: [
		"Casings are blocks used throughout many crafting recipes in &6Create&f, as well as for decoration and aesthetic purposes."
		""
		"There are four types of Casings: Andesite Casings are mainly used in basic Contraptions."
		""
		"{@pagebreak}"
		"Casings can only be crafted through physically applying a valid alloy or &7ingot&f to any Stripped variant of Log or Wood. The logs will convert themselves into the casing."
		""
		"&9Mechanical&f Belts, Shafts, and Cogwheels can be encased in most casings, creating a decoration around the encased block. Copper casings, however, can be used only on &3Fluid&f Pipes. Likewise, a fluid pipe will not accept any other kind of casing."
	]
	quest.4B976C143EDA4317.title: "Andesite Casing"
	quest.4BB13C80196FD034.quest_desc: [
		"The &6Create&f mod brings true engineering to Minecraft!"
		"Instead of simple &9machines&f, you’ll use rotational power generated by &3water&f wheels, windmills, and other types of contraptions."
		""
		"With Create, you can automate farms, build factories, or even design moving machines that run smoothly and look beautiful doing it."
	]
	quest.4BB13C80196FD034.quest_subtitle: "&6Create&f"
	quest.4BB13C80196FD034.title: "&6Create&f"
	quest.4BDB64F6522FBB78.title: "&6Cloggrum&f Armor"
	quest.4BDE773C3359D584.quest_desc: [
		"Robit is &9Mekanism&f's &9mechanical&f companion. It can act as a crafting grid, a furnace, an anvil, a chest, or simply a cute little buddy. It is immune to fire, including the Flamethrower."
		""
		"{@pagebreak}"
		""
		"To bring your personal robotic friend into the world, you'll have to craft it. Once Robit is in your inventory, right click a Chargepad with it in hand. This will spawn Robit and assign it to the pad. Oh, and make sure the Chargepad is supplied with &epower&f. Otherwise, he won't be able to follow you around!"
		""
		"If at any time you want to pick Robit up, simply shift right-click it with a Configurator."
		""
		"Don't worry about losing your Robit as whenever it runs out of charge/health it will &9automatically&f teleport back to its charging pad. It does not have conventional health: instead, taking &cdamage&f will deplete its charge. A fully charged Robit has an effective health of 100 or 50 hearts."
		""
		"When the chargepad is broken, Robit will turn into an item to be picked up. It keeps its items but it may despawn if it's not picked up."
	]
	quest.4BDE773C3359D584.quest_subtitle: "Little Robit"
	quest.4C1E974C70987717.quest_desc: [
		"In &dArs Nouveau&f there are 3 &dspellbooks&f! Each book unlocks a certain type of magic and ways to use them!"
		""
		"Press \"C\" holding it to see the formula. The formula is the method we wish to cast the spell, e.g., projectile, touch..."
		""
		"Right below we can see effects: effects are the spell itself. Select at least 1 of each, select what you want and click \"create\"."
	]
	quest.4C1E974C70987717.quest_subtitle: "The First"
	quest.4C63A2E92319B8A2.quest_desc: [
		"Get ready for the &cAdventure&f!"
		""
		"In this strange world of ours, there are several new &eStructures&f and new &4Monsters&f, totally crazy and mind-blowing stuff. &aGet ready&f! "
	]
	quest.4C63A2E92319B8A2.quest_subtitle: "Get ready"
	quest.4C71B80784B4F8FB.quest_desc: ["..."]
	quest.4C71B80784B4F8FB.quest_subtitle: "..."
	quest.4C756FFD357F091F.quest_desc: ["I do not even need to explain, right?"]
	quest.4C756FFD357F091F.quest_subtitle: "The Best..."
	quest.4C7CD3858A2BE870.quest_desc: [
		"The &9Mechanical&f Press is a mechanical component that applies Pressing, Packing, and Compacting recipes to items below it. It is used to press Ingots into Sheets, which are &eimportant&f ingredients for higher-level components."
		""
		"The Mechanical Press is powered by an internal Shaft, accessed from two opposite sides. Much like Shafts, Presses will relay rotation along their axis. It processes items faster when it receives faster rotational power."
	]
	quest.4C990203ACAAB823.quest_desc: ["Now we can finally control the wheels and the movement of our car; click with the linked controller on top of each &credstone&f link and configure a keybind to define acceleration and move the vehicle to the sides."]
	quest.4C990203ACAAB823.quest_subtitle: "Time to take control"
	quest.4CE350628327599A.quest_desc: [
		"The &eME Level Emitter&r can indicate either the level of a specified item or the &dME Network&r energy level."
		""
		"You can set the threshold and if the&e ME Level Emitter&r will emit a redstone signal or turn it off."
		""
		"Does not require a &eChannel&r to function, if its power is lost the emitter will switch to an off state."
		""
		"These can tap into the &bcrafting system&r when a crafting card is installed, allowing you to output redstone while an item is being crafted, or even configure the system to output redstone to preform a crafting task, its important to note that you cannot mix level emitter craft via &credstone&r with &binterface patterns&r."
	]
	quest.4CEBCC5C6F5E5D37.quest_desc: ["Very crazy creating a &5portal&f to travel to another &5dimension&f, only in Minecraft... Notch was crazy when he made this!"]
	quest.4CEBCC5C6F5E5D37.quest_subtitle: "Time to Travel"
	quest.4CEBCC5C6F5E5D37.title: "The &4Nether&f"
	quest.4CFE8B1C53B429E9.quest_desc: ["Crafter Slot Covers are used to denote empty spaces in &9Mechanical&f Crafter setups."]
	quest.4D3AEF3DB6E7BBC7.quest_desc: ["The Stack &aUpgrade&f increases transfer quantity per cycle on installed devices."]
	quest.4D41F29E44398EA8.quest_desc: ["This little &dstaff&f is quite strong; it sets your &cenemies&f on fire on top of the damage."]
	quest.4D41F29E44398EA8.quest_subtitle: "&6FIRE&f"
	quest.4D482A1A908ABFDA.quest_desc: [
		"Unlike Linear Chassis, the Radial Chassis connects to a radius of blocks around it rather than a straight line of blocks. This can be unwieldy if there are blocks nearby one would rather not connect to the Contraption."
		""
		"You can right click on the sides of the chassis while holding a Slimeball or Super Glue to make them sticky, and again to apply it to all sides. The items are not consumed. The radius of affected blocks can be changed per chassis with a &aWrench&f. Hold Ctrl to scroll every connected chassis."
	]
	quest.4D72CE140352B796.quest_desc: ["We're almost there... maybe I'm lying, this isn't 1% of what we'll actually do."]
	quest.4D72CE140352B796.quest_subtitle: "Gathering Eyes"
	quest.4D72CE140352B796.title: "Eye of &5Ender&f"
	quest.4D89B47FFF31585D.quest_desc: ["We can use the Chain Drive to make our car's chassis, but if it gets too big, it may cost more fuel."]
	quest.4D89B47FFF31585D.quest_subtitle: "Car body"
	quest.4D89B47FFF31585D.title: "Encased Chain Drive"
	quest.4D8CB12FD2A6A8D9.quest_desc: [
		"&7Stoneborns&f are incredible and extremely gentle monsters, they are &eneutral&f."
		""
		"You can trade with them and they will fight hostile mobs for you."
	]
	quest.4D8CB12FD2A6A8D9.quest_subtitle: "Trades"
	quest.4D8F11A3F801A303.quest_subtitle: "Transforming"
	quest.4D966F8C5AD62896.quest_subtitle: "Holy School &7Armor&f"
	quest.4D966F8C5AD62896.title: "Priest &7Armor&f"
	quest.4D999E42010FFB85.quest_desc: ["Holds 1.6r AE in its battery and drains 1 AE/t for each block you are away from the nearest ME Wireless Access Point."]
	quest.4DAC24440803FE58.quest_desc: [
		"An AE2 &9network&f needs to be chunkloaded for any of its devices to be able to function, and if only some of it is loaded, it may not function correctly. The Spatial Anchor solves this problem. It forceloads the chunks that its network occupies. A single cable extending across a chunk border is enough to load that new chunk."
		""
		"It will propagate its \"loading\" across quantum bridges, but not cross-dimensionally, so if you have a quantum bridge to the nether, you need a spatial anchor on the network in your base and on the network in the nether."
		""
		"By default it will also enable random ticks in its loaded chunks, this can be turned off in the ae2 config."
	]
	quest.4DB8552EE2DB7C53.quest_desc: ["We need this space suit to walk on other worlds! Place the suit in an &3oxygen&f &9machine&f to fill it up with oxygen!"]
	quest.4DB8552EE2DB7C53.quest_subtitle: "Space Suit"
	quest.4DB8552EE2DB7C53.title: "Space &7armor&f"
	quest.4DF53B9D43166F7F.quest_desc: ["This bow is a drop from the queen; it homes in on your &cenemies&f until hitting them!"]
	quest.4DF53B9D43166F7F.quest_subtitle: "Homing Arrow"
	quest.4E1B3417F498892B.quest_desc: ["&dMystical&f &7armor&f starter tiers might not be the best, but the final tiers are probably top tier!"]
	quest.4E1B3417F498892B.quest_subtitle: "Great Equipment!"
	quest.4E1B3417F498892B.title: "Inferium &7Armor&f"
	quest.4E424D3A4D514B73.quest_desc: [
		"Refined Storage is a storage mod that allows building a storage &9network&f using various devices. These devices store, organize, and manage your items and &3fluids&f."
		""
		"It is less complex than AE2. It lacks channels and item type limits. Furthermore, it allows the same features as AE2, such as storage and autocrafting."
	]
	quest.4E424D3A4D514B73.title: "Refined Storage"
	quest.4E5C6F23628A9982.quest_desc: [
		"The Encased Chain Drive is a block that can transfer rotation much like the &9Mechanical&f Belt."
		""
		"Encased chain drives may be placed side by side either vertically or horizontally to form a chain passing rotational &epower&f among all the blocks. The blocks must touch on their sides (not axis to side) and be in a single straight line to form a chain. The axes of the encased chain drives may be all parallel or blocks can be rotated to orient the axis perpendicularly. Encased chain drives can also pass rotational power through their rotating axis, but this is not a continuation of the same chain."
	]
	quest.4E6FF002D6C5580E.title: "{ftb\tquests.chapter.mystical_agriculture.quest4E6FF002D6C5580E.title}"
	quest.4EAA3F9C314914BF.quest_desc: [
		"Okay, this is perfect! With this mod we can have a much &aeasier&f early game with a simple inventory &9system&f! And everything starts with this terminal."
		""
		"Craft this terminal and we can really start working. It has an incredible mechanic: place it in front of any chest or Inventory Connector and open our interface!"
	]
	quest.4EAA3F9C314914BF.quest_subtitle: "Budget Applied"
	quest.4EC20D5D0EEC1DF7.quest_desc: [
		""
		"{ \"text\": \"Click Me!\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"3617DE87C4E1BCB9\" } }"
	]
	quest.4EC499B88FBFA01C.quest_desc: ["Stores kinetic stress for later use. Retains charge in item form to enable long-distance &eenergy&f transport. Battery capacity, RPM at discharge and stress impact values are all configurable."]
	quest.4F1307BB5B01F90F.quest_desc: [
		"The ME Chest acts like a miniature &9network&f with a ME Terminal, ME Drive, and &eEnergy&f Acceptor. While it can be used as a tiny storage network, its capacity for just one single storage cell means it has limited utility as such."
		""
		"Instead, it is useful for interacting with specifically the storage cell mounted inside it. Its integrated terminal can only see and access the items in the mounted drive, while devices on the general network can access items in any network storage, including ME chests."
		""
		"It has 2 different GUIs and is sided for item transport. Interacting with the top terminal opens the integrated terminal. Items can be inserted into the mounted storage cell through this face, but not extracted. Interacting with any other face opens the GUI with the slot for the storage cell and the priority settings. The cell can be inserted and removed by item logistics only through the face with the cell slot."
		""
		"It can be rotated with a Certus Quartz &aWrench&f."
		""
		"It has a small AE energy storage buffer, so if not on a network with an energy cell, inserting or extracting too many items at once may cause it to brown out."
	]
	quest.4F1C04C0F6769825.quest_desc: [
		"The Chemical Injection Chamber uses &3Hydrogen&f Chloride gas to convert Ores into 4 Shards and Raw Ores into 8 Shards."
		""
		"This marks the beginning of 4x ore processing and requires a steady supply of Hydrogen Chloride, which can only be produced with a Thermal Evaporation &2Plant&f."
		""
		"This &9machine&f is the next step in expanding your Ore Processing Factory. Place it to the left of your Purification Chamber to integrate it into your existing setup and continue your progression."
	]
	quest.4F436770D30D8520.quest_desc: [
		"We will need to add 3 more &9machines&f to our current setup."
		""
		"The Chemical Dissolution Chamber is the first machine in the 5x ore processing setup. It turns Raw Ores into Slurry using Sulfuric Acid."
		""
		"The machine uses 100mB of Sulfuric Acid for every ore dissolved and outputs 1000mb of Slurry. This Slurry needs washing in the Chemical Washer."
	]
	quest.4F78122BABAB041C.quest_desc: [
		"The &9Mechanical&f Plough is a Movement Actor used to break non-collidable blocks and fling entities."
		""
		"Placement"
		"The Plough can only be placed on the horizontal face of a solid block, however, this block is not necessary to support the Plough after it is placed."
		""
		"Breaking Blocks"
		"While attached to a Contraption, the Mechanical Plough will break non-collidable blocks it comes in contact with (ex. snow layers). The Mechanical Plough will also move or launch entities and till soil blocks."
		""
		"Tilling"
		"While attached to a Contraption, the Mechanical Plough will till any grass blocks below it (change grass blocks to farmland), which can be used to quickly till huge farms."
		""
		"Flinging Entities"
		"While attached to a Contraption that moves the Mechanical Plough in a swinging motion, any colliding entities will be flung in the direction of the swing."
	]
	quest.4F89670D49DD2DE1.quest_desc: [
		"They provide diagnostic function by visualizing the Channel usage on the Cables, the Channels appear as lit colored lines that run along the black stripe on the Cables giving you an understanding of how your Channels are being used on your &9network&f."
		""
		"The first four Channels show as lines matching the color of the Cable, the next four show as white lines."
		""
		"These can also be colored in the same manner as Fluix ME Glass Cable."
	]
	quest.4F899BACFCDFF853.quest_desc: [
		"This table is the heart of magic in &dArs Nouveau&f: with it, we can assemble new &dspells&f!"
		""
		"Click with your book on the table to open a new tab containing all possible spells. Note each book has a tier, so you need a tier 2 book for tier 2 spells."
		""
		"Click on the spell while holding shift to see required items, click select, and drop the items on top of the table."
	]
	quest.4F899BACFCDFF853.quest_subtitle: "Heart of &dMagic&f"
	quest.4FA8D7751246C260.quest_desc: [
		"To enter &eBumblezone&f, we need to find a wild bee hive in the world."
		""
		"Throw an &5ender&f pearl at the hive and you're in!"
		""
		"Welcome to Bumblezone!"
	]
	quest.4FA8D7751246C260.quest_subtitle: "Entering the &5Dimension&f"
	quest.4FAFFC7803894FAF.quest_desc: ["We can build new tools whenever we reach a new &2seed&f tier in &dMystical&f, always getting stronger!"]
	quest.4FAFFC7803894FAF.quest_subtitle: "New Tools"
	quest.4FAFFC7803894FAF.title: "Tertium Tools"
	quest.4FB001CE1BACBFA0.quest_desc: ["Astronaut, reports say this planet has a new radioactive fuel source, watch out!"]
	quest.4FB001CE1BACBFA0.quest_subtitle: "A New World"
	quest.4FB001CE1BACBFA0.title: "Mercury"
	quest.4FB32E41F9FEE89B.quest_desc: ["Helps to boost small planes, pushing the air or sucking it in, to direct it forward or backward"]
	quest.4FB32E41F9FEE89B.quest_subtitle: "Thruster"
	quest.4FB73108EB1716FD.quest_desc: [
		"Watch out for the &ebees&f! Incredible as it seems, bees are amazing and extremely smart, and their &7armor&f is incredibly strong!"
		""
		""
		""
		"{entity:the_bumblezone:beehemoth ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:USE_GLOBAL width:50 height:50 align:center}"
	]
	quest.4FB73108EB1716FD.quest_subtitle: "BZZ BZZZ"
	quest.4FBB6905FB99C141.quest_desc: ["This block works just like a reactor and allows us to &6create&f a 24-block high tower increasing &agrowth&f speed."]
	quest.4FBB6905FB99C141.quest_subtitle: "Speeding Up!"
	quest.5004AE3D175A02A6.title: "{ftb\tquests.chapter.mystical_agriculture.quest5004AE3D175A02A6.title}"
	quest.5047792C6EF6D2AD.quest_desc: ["Created in Pressurized Reaction Chamber from 2 x Bio Fuel, &3Water&f and &3Hydrogen&f (also Ethylene created as side-product)."]
	quest.505A11108180FA05.quest_desc: [
		"Maledictus is an undead &4boss&f found in the Frosted Prison."
		""
		""
		"{entity:cataclysm:maledictus ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:FORCE_OFF idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.505A11108180FA05.quest_subtitle: "Undead"
	quest.50740818E16C1329.quest_subtitle: "Use to Store &bMana&f"
	quest.508BFAAF99BEFEA7.quest_desc: ["Need one more &esocket&f on your tool? Use this &dsigil&f."]
	quest.508BFAAF99BEFEA7.quest_subtitle: "+ 1 &eSocket&f"
	quest.50BAB1914E5B902C.quest_desc: [
		"&5Epic&f, in turn, is a truly incredible option. It is not the best one, but its gear is already on another level!"
		""
		"It appears in the Frontier &eworld tier&f and is more common in the Pinnacle tier."
	]
	quest.50BAB1914E5B902C.quest_subtitle: "&5Epic&f"
	quest.50CE0BD7B0BC4017.quest_desc: ["&3Fluid&f Valves can be switched between open and closed by providing Rotational Force to the side. This is often done with a Valve Handle or Gearshift. A set of directional arrows on the side of the valve will also rotate to indicate whether the valve is open or closed."]
	quest.50D1DECDF16F1FCA.quest_subtitle: "Grab distant items into the backpack"
	quest.50D3BBCA2BFFC292.quest_subtitle: "Make Drinks!"
	quest.50EBD1AA34ADE391.quest_desc: ["Our scientists are still studying Venus; travel there and collect blocks and ores."]
	quest.50EBD1AA34ADE391.quest_subtitle: "A Massive Planet"
	quest.50EBD1AA34ADE391.title: "Venus"
	quest.50ED11C98A859486.quest_desc: ["Want to travel to space and new planets? Well, first you need a launchpad!"]
	quest.50ED11C98A859486.quest_subtitle: "Creating Rockets"
	quest.511DD8761FFFD191.quest_desc: [
		"{ftb\tquests.chapter.mystical_agriculture.quest511DD8761FFFD191.description1}"
		""
		"{ftb\tquests.chapter.mystical_agriculture.quest511DD8761FFFD191.description2}"
	]
	quest.511DD8761FFFD191.title: "{ftb\tquests.chapter.mystical_agriculture.quest511DD8761FFFD191.title}"
	quest.5172745FE6AB853F.quest_desc: ["This table is the foundation in the mod. With a grimoire in hand, click it to open the &dspell&f menu where we put our spell scrolls!"]
	quest.5172745FE6AB853F.quest_subtitle: "Our Table"
	quest.51B0E0A54C84A69B.quest_desc: [
		"The drive unit stores storage disks and &3liquid&f storage disks."
		""
		"Adding storage disks expands the storage capacity of the &9network&f. Total available storage depends on internal disk count and tier. Removing a disk makes its stored contents temporarily inaccessible until reinserted."
	]
	quest.51B0E0A54C84A69B.quest_subtitle: "Storage"
	quest.51CC88481A1FCCC1.quest_desc: ["We understand your excitement to reach &5The End&f... I was like that too, but maybe it's better to &astudy&f a bit and grow stronger..."]
	quest.51CC88481A1FCCC1.quest_subtitle: "Let's Take It Easy"
	quest.51CCB7ACFD7B45F1.quest_subtitle: "Crafting ingredient"
	quest.51D755615A9AFE7A.quest_subtitle: "Tier 3"
	quest.51E22AFE9403C9E1.quest_desc: ["To start, we need a Physics Assembler; with it, we can give physics to the car, and it will be very &eimportant&f!"]
	quest.51E22AFE9403C9E1.quest_subtitle: "Creating our first car"
	quest.521700DC2EED8C3D.quest_subtitle: "Nature School &7Armor&f"
	quest.521700DC2EED8C3D.title: "Plagued &7Armor&f"
	quest.524B1ABB89B1D43A.quest_desc: ["We need to use the target designator to link one &eenergy&f transmission to another."]
	quest.524B1ABB89B1D43A.quest_subtitle: "Linking"
	quest.525F25F4ADE45B50.quest_desc: [
		"The ME Formation Plane acts similarly to the Storage Bus, but treats the world itself as its storage medium. In other words, it will place down any block in its filter directly in front of itself."
		""
		"This can be useful for situations where a block can be processed simply by placing it and breaking it with a certain tool."
	]
	quest.52CF08C3E3BBD68E.quest_desc: [
		"In Iron's &dSpells&f and &dSpellbooks&f, there are 8 magic schools plus 1 special school. The school influences scrolls and armors."
		""
		"The base for making scroll recipes is this forge, where we make Inks."
	]
	quest.52CF08C3E3BBD68E.quest_subtitle: "&dMagic&f Schools"
	quest.531E3FF1F2865C67.quest_desc: ["Similar to the Universal Cable, the Thermodynamic Conductor is &9Mekanism&f's way of transferring &epower&f in the form of heat (essentially a heat pipe)."]
	quest.532EE736F9945ADC.quest_desc: [
		"The base of the entire mod are the grimoires: with them we can cast our &dspells&f and &alearn&f them."
		""
		"Each new book lets us learn more spells or grants different stats!"
	]
	quest.532EE736F9945ADC.quest_subtitle: "Our First Grimoire"
	quest.53965EEC83265F1E.quest_desc: ["We can use various mod cores to &aimprove&f &eenergy&f transmission."]
	quest.53965EEC83265F1E.quest_subtitle: "Core"
	quest.539E38C4CE86BCF6.quest_desc: ["We need this knife to slaughter animals."]
	quest.539E38C4CE86BCF6.quest_subtitle: "Slaughtering Everything!"
	quest.53C0234C053BF0CF.quest_desc: [
		"Place a Stock Link to start a new Logistics &9Network&f. Right-click a placed Stock Link before placement to share that link’s network. Place the link on a Packager to connect the packager’s connected inventory to the network."
		""
		"Stock Links have no range limitations, but the chunk they’re in must be loaded in order to be seen by the network."
		""
		"Stock Links can receive and transmit re\tquests through the Logistics Network."
	]
	quest.53D6E9AE59FC6F79.quest_desc: [
		"One of the most nostalgic and amazing mods! &2Twilight Forest&f touches our feelings, featuring various &4bosses&f and gear."
		""
		"Travel to a new dimension, battle bosses, and much more!"
	]
	quest.53D6E9AE59FC6F79.quest_subtitle: "Classic"
	quest.53D6E9AE59FC6F79.title: "The &2Twilight Forest&f"
	quest.54589F10802DFE16.quest_desc: ["A clutch that is uncoupled unless powered."]
	quest.546396936E06E68A.quest_desc: ["After years storing battle treasures, we can &6loot&f everything! Use this key to open the queen's secret chest."]
	quest.546396936E06E68A.quest_subtitle: "Queen's Key"
	quest.54778BD66812A1CF.quest_desc: ["A transport component used to move &3fluids&f between tanks, machines, and engines. Designed for efficiency and integration with &6Create&f’s mechanical systems, it ensures smooth fluid transfer in your automation setups."]
	quest.54DD837BDF6B31C3.quest_desc: ["We can centrifuge some items with this &9machine&f."]
	quest.54DD837BDF6B31C3.quest_subtitle: "Centrifuging"
	quest.5549AAA9DBE0CD78.quest_desc: [
		"Bowls are the base of the &dmagic&f, you will always place them near the &5ritual&f to offer items to the demons."
		""
		"&6Golden bowls&f are placed in the middle of the ritual and usually require a ritual &ebinding book&f."
	]
	quest.5549AAA9DBE0CD78.quest_subtitle: "Base for the sacrifices"
	quest.554EF19AB0F6F0C7.quest_desc: ["We can &6create&f new types of dirt to speed up the seed &agrowth&f process."]
	quest.554EF19AB0F6F0C7.quest_subtitle: "An &aImproved&f Dirt"
	quest.556D9C78EFAB5091.quest_desc: [
		"The ME Terminal is a HUD which gives you access to items stored in your ME &9Network&f. This will also include items accessible through ME Storage Bus."
		""
		"It has the ability to sort and search, as well as filter by using View Cell. It requires a Channel to function."
	]
	quest.55749230931993F2.quest_desc: [
		"Mostly clear glass made with Certus Quartz &7Dust&f."
		""
		"Can be used to make Vibrant Quartz Glass and other items."
	]
	quest.5585B4CFBD0D287E.quest_subtitle: "Baby Shark"
	quest.5585B4CFBD0D287E.title: "Jagged &7Armor&f"
	quest.558909E4668CBA76.quest_subtitle: "Our Fire &dMagic&f"
	quest.5594489BF12A15FA.quest_desc: ["Hello! Even with all the mods we have, we need to start from the beginning! Gather some wood and craft initial tools."]
	quest.5594489BF12A15FA.quest_subtitle: "First Tools"
	quest.5594489BF12A15FA.title: "Wooden Tools"
	quest.55A7167C123DCC51.quest_subtitle: "Erase the drawings on the floor"
	quest.55A8D6E8206CE8EA.quest_desc: ["This new suit can store diesel and &3oxygen&f! Besides being much stronger."]
	quest.55A8D6E8206CE8EA.quest_subtitle: "A &aBetter&f Armor"
	quest.55A8D6E8206CE8EA.title: "Jet Suit &7Armor&f"
	quest.55C1EB0809EDA131.quest_desc: ["{ftb\tquests.chapter.mystical_agriculture.quest55C1EB0809EDA131.description1}"]
	quest.55C1EB0809EDA131.title: "{ftb\tquests.chapter.mystical_agriculture.quest55C1EB0809EDA131.title}"
	quest.566D6390193DD77D.quest_desc: [
		"Brass Tunnels may be used on &9mechanical&f belts for four functions: 1) purely decorative, 2) splitting streams of items to multiple destinations, 3) sorting streams of items, and 4) combining multiple streams of items. Each tunnel can have an input or output &5portal&f. The status of being an input or output depends purely on the direction of the belt touching a given side."
		""
		"Tunnels which are placed immediately next to each other are automatically treated as a group, in most cases collecting from all inputs and distributing to all outputs. The way that items are distributed is controlled by the tunnels' value setting. Item stacks from different inputs will not be combined prior to distributing."
	]
	quest.56773A0759841B87.quest_desc: [
		"Hello! I know you are here because you want to become a true wizard..."
		""
		"Then you're in the right place! Experiment with new &dspells&f and become a truly powerful wizard."
		""
		"This is &7Iron&f's Spells and &dSpellbooks&f!"
	]
	quest.56773A0759841B87.quest_subtitle: "Becoming a True Wizard"
	quest.56773A0759841B87.title: "Iron &dSpell&f Book"
	quest.57E30971FCEF6709.quest_desc: [
		"The Atomic Disassembler is &9Mekanism&f's an all-in-one tool, essentially the ultimate, electronic version of the paxel."
		""
		"Tools the Atomic Disassembler replaces:"
		""
		"Pickaxe"
		"Axe"
		"Shovel"
		""
		"Notable tools the Atomic Disassembler does not replace:"
		""
		"Shears"
		"Saw"
		"Sword - Although a very formidable weapon dealing an average of 20 health points, the Atomic Disassembler cannot swing &cattack&f."
		""
		"{@pagebreak}"
		""
		"The Atomic Disassembler has five different settings which may be cycled through by Shift + Right clicking or using the Item mode switch keybind:"
		""
		"Normal (202)"
		"The default setting"
		"Works as if a &bdiamond&f version of every tool with Efficiency II."
		"Slow (82)"
		"Works as if a diamond version of every tool."
		"Fast (1282)"
		"Works as if a diamond version of every tool with Efficiency V."
		"Off (02)"
		"Does not affect the world around it, except for mobs."
		"Good setting to leave it on if you intend to use it as your main weapon... and don't want to dig yourself into a &4death&f trap."
	]
	quest.57E30971FCEF6709.quest_subtitle: "LORD"
	quest.580771DAE53B8F15.quest_desc: ["Repair with zombie flesh."]
	quest.580771DAE53B8F15.quest_subtitle: "Summon Zombies"
	quest.5853A6A7DC4BF393.title: "{ftb\tquests.chapter.mystical_agriculture.quest5853A6A7DC4BF393.title}"
	quest.585521EA3ED4827A.quest_desc: ["In this new world we have some monsters that are in love with &2regalium&f, so we can use it as a trading currency."]
	quest.585521EA3ED4827A.quest_subtitle: "The New &2Emerald&f"
	quest.586C269FAAC6D0AB.quest_desc: [
		"{ftb\tquests.chapter.mystical_agriculture.quest586C269FAAC6D0AB.description1}"
		""
		"{ftb\tquests.chapter.mystical_agriculture.quest586C269FAAC6D0AB.description2}"
	]
	quest.586C269FAAC6D0AB.title: "{ftb\tquests.chapter.mystical_agriculture.quest586C269FAAC6D0AB.title}"
	quest.58B125BD4876054C.quest_desc: [
		"This mod introduces many different mid-to-high tier forms of machinery, power generation, and tools to the game that &6create&f a whole new element of &9technology&f to a game originally aimed at survival."
		""
		"The mod focuses on breaking down materials to their chemical makeup, and getting the best out of every material you come across. "
		""
		"This mod features &3Hydrogen&f Powered Jetpacks, a Mini Robotic friend, Reactors, a Digital Miner to automate mining, Reactors, and much more."
	]
	quest.58B125BD4876054C.quest_subtitle: "The &9Mekanism&f"
	quest.58B125BD4876054C.title: "Welcome"
	quest.58B9E5BD5C826184.quest_desc: ["&dMystical&f &7armor&f starter tiers might not be the best, but the final tiers are probably top tier!"]
	quest.58B9E5BD5C826184.quest_subtitle: "Great Equipment!"
	quest.58B9E5BD5C826184.title: "Imperium &7Armor&f"
	quest.58D9ED769A7F1C03.quest_desc: ["In our modpack we can enter the beloved &5Twilight&f and fight the &2Naga&f, which lets us build this incredible and nostalgic armor!"]
	quest.58D9ED769A7F1C03.quest_subtitle: "&2Naga&f"
	quest.58D9ED769A7F1C03.title: "Steeleaf &7Armor&f"
	quest.590746BA503CC770.quest_subtitle: "Routing &ePower&f via Cables"
	quest.599607DF0F2F8961.quest_subtitle: "Routing &3Fluid&f via Cables"
	quest.5A2450162FD24F7E.quest_desc: [
		"Two Crushing Wheels must be placed next to each other horizontally or vertically one block apart. Both wheels must be given opposite rotational force. Any items to be crushed must be inserted where the wheels rotate inwards."
		""
		"Crushing wheels can be automated by placing a hopper at the top directly between the wheels and either a depot or conveyor belt below."
	]
	quest.5A2450162FD24F7E.quest_subtitle: "Crushing Wheels apply Crushing recipes to any items inserted from the direction they are spinning away from."
	quest.5A2450162FD24F7E.title: "Crushing Wheels"
	quest.5A5A30CD4D0C98CB.quest_desc: ["Fluix Crystal is crafted in world by tossing Charged Certus Quartz Crystal, &4Nether&f Quartz and &cRedstone&f Dust in Water."]
	quest.5A5A30CD4D0C98CB.quest_subtitle: "In World"
	quest.5A86869FCFA9C56B.quest_subtitle: "Have a Crafting Table in Backpack"
	quest.5AB93477ADBE26F1.quest_desc: [
		"This crystal is very &eimportant&f for progression: with it we can make a compass that helps us immensely!"
		""
		"To do so, search for a crystal in honey lakes across the world and break it."
	]
	quest.5AB93477ADBE26F1.quest_subtitle: "A Honey Chunk"
	quest.5AFD4912CC8FBBB8.quest_subtitle: "Crafting ingredient"
	quest.5B681BC43371CC5C.quest_desc: [
		"The Logistical Transporter is the basic item transport pipe for Mekanism logistics. With the Configurator the player can choose to \"paint\" the pipe with colors that can be detected by the pipe's color sorter by ⇧ Shift + right-clicking the center of a transporter with a Configurator."
		""
		"It has 2 other cousins called the Diversion Transporter and the Restrictive Transporter."
	]
	quest.5B8090AE76C3EC15.title: "{ftb\tquests.chapter.mystical_agriculture.quest5B8090AE76C3EC15.title}"
	quest.5B99D64F54C94267.quest_desc: ["Connect the powered booster underneath and it will transfer up to 20 stacks and 1000 buckets per second on the extraction cable."]
	quest.5B99D64F54C94267.quest_subtitle: "Upgrading Cables"
	quest.5BACEC2A4C91A001.quest_subtitle: "Level 5"
	quest.5BB1EBD2782C376A.quest_desc: ["Use this multiblock structure to transfer &epower&f wirelessly. Use cores to &aupgrade&f the multiblock."]
	quest.5BB1EBD2782C376A.quest_subtitle: "Transfer &ePower&f"
	quest.5BB1EBD2782C376A.title: "&eEnergy&f Transmission Pole"
	quest.5BB309E264190DB9.quest_desc: ["We can build a mega car with giant wheels, or small cars with smaller wheels; it all depends on what we need to do."]
	quest.5BB309E264190DB9.quest_subtitle: "New types of wheels"
	quest.5BBF7D2BF9486E63.quest_desc: [
		"Ancient Remnant is an undead dinosaur &4boss&f found in the cursed pyramid."
		""
		""
		"{entity:cataclysm:ancient_remnant ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:FORCE_OFF idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.5BBF7D2BF9486E63.quest_subtitle: "A Prehistoric Dinosaur"
	quest.5BBF7FAE04B3A554.quest_desc: ["&6Brutes&f are extremely protective of their pack, so if you are going to &cattack&f one, attack it away from the others!"]
	quest.5BBF7FAE04B3A554.quest_subtitle: "A Piglin Lookalike"
	quest.5C01B848A01FEF92.quest_subtitle: "Blood School &7Armor&f"
	quest.5C01B848A01FEF92.title: "Cultist &7Armor&f"
	quest.5C2108BD3DEEB0E6.quest_desc: [
		"The Spout is a block used for filling &3liquid&f containers such as bottles or buckets, or crafting with liquids."
		""
		"The Spout can be filled with up to 1 bucket of any one liquid via &3Fluid&f Pipes, and it will empty some of its fluid onto compatible items that pass under it via a Conveyor Belt or Depot. "
		""
		"The spout takes 1 second to process an item regardless of the amount of fluid used, though delay between fills may be caused by the time it takes the spout to fill back up."
	]
	quest.5C2BEB7EC5DF52E7.quest_desc: ["Several recipes in the mod require these runes... find them exploring the world."]
	quest.5C2BEB7EC5DF52E7.quest_subtitle: "A Strange Rune"
	quest.5C75B7C6F6464807.quest_subtitle: "Used for recipes"
	quest.5C770DE2F2340335.quest_subtitle: "Level 5"
	quest.5CCECCB9A4238A1F.quest_desc: ["This armor is an extension of &bApplied&f onto your own body! Open the &9system&f and get strong with Applied."]
	quest.5CCECCB9A4238A1F.quest_subtitle: "AE2"
	quest.5CCECCB9A4238A1F.title: "Quantum &7Armor&f"
	quest.5D3EE44FB41D289F.quest_desc: ["An item which contains a configuration similar to a Storage Cell, that allows you to customize the filtering of a particular ME Terminal."]
	quest.5D9D893998EE5989.quest_desc: [
		"Lost in the new Snowy &2Forest&f biome..."
		""
		"We can find the Yeti, hidden inside a pyramid waiting for you with blood in his eyes!"
		""
		""
		"{entity:twilightforest:alpha_yeti ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:FORCE_OFF idle:FORCE_OFF walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.5D9D893998EE5989.quest_subtitle: "A Monster in the Snow"
	quest.5DA2C1E858DC6ABF.quest_desc: ["Use this special map so you don't get lost in the labyrinth."]
	quest.5DA2C1E858DC6ABF.quest_subtitle: "Lost in the Labyrinth?"
	quest.5DAF7F67C153E43F.quest_subtitle: "With Fiery &7Ingot&f we can make new equipment"
	quest.5DAF7F67C153E43F.title: "Fiery &7Armor&f"
	quest.5E0FB1B7DBE6E5A2.quest_desc: [
		"Now that we completed all 16 challenges, we can consume the &2essence&f, making us highly respected."
		""
		"Then we can break blocks, harvest honey, freely enter structures, and &3fluid&f honey gives amazing effects!"
	]
	quest.5E0FB1B7DBE6E5A2.quest_subtitle: "Gaining Respect!"
	quest.5E116409DC7D30BB.quest_desc: ["The Configurator is used to configure many of the items in Mekanism, from changing pipes to \"Pull or Push\" or rotating machines."]
	quest.5E2B9B6AAB1F34F4.quest_desc: ["When we want to fly, we need a flat surface for the wind to pass through; for this, the best option for building planes is to use the windmill as part of the wing, as it is lighter and &aeasier&f."]
	quest.5E2B9B6AAB1F34F4.quest_subtitle: "Fly"
	quest.5E6AB4394F4BDAEC.quest_desc: [
		"To obtain oil, you will need to craft the oil locator."
		""
		"With this item, right-click a block and it tells you if oil exists in the chunk. Use F3 + G to assist chunk visualization."
	]
	quest.5E6AB4394F4BDAEC.quest_subtitle: "Locating Oil"
	quest.5E7C0BC276E6F1F7.quest_desc: [
		"I think this mod needs no introduction..."
		""
		"Inside &dMystical&f we can craft several new armors, and the last two tiers let you put incredible &aupgrades&f on them!"
	]
	quest.5E7C0BC276E6F1F7.quest_subtitle: "&dMystical&f..."
	quest.5E7C0BC276E6F1F7.title: "Awakened Supremium &7Armor&f"
	quest.5ED197309A07FBE3.quest_desc: ["This block works just like a reactor and allows us to build a structure by stacking these blocks to increase &agrowth&f &aspeed&f."]
	quest.5ED197309A07FBE3.quest_subtitle: "Speeding Up!"
	quest.5EDD49E8775D1C77.quest_desc: [
		"Twilight has various challenges and is a completely new world, having a map is essential!"
		""
		"Traveling and exploring you can find &8Obsidian&f Pillars; around these pillars we find ravens, defeat them to get feathers."
		""
		"{entity:twilightforest:raven ent_size:1.0 off_x:0.0 off_y:0.0 rot:35.0 spin:FORCE_OFF idle:FORCE_OFF walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.5EDD49E8775D1C77.quest_subtitle: "Finding a Raven"
	quest.5EE811200D7F9226.quest_desc: ["Besides being strong, this beautiful &7armor&f comes from a &6Create&f addon; it is quite different from the others and simple to make."]
	quest.5EE811200D7F9226.quest_subtitle: "A Different &7Armor&f"
	quest.5F01AC84FEBFE724.quest_desc: ["We can &6create&f new types of dirt to speed up the seed &agrowth&f process."]
	quest.5F01AC84FEBFE724.quest_subtitle: "An &aImproved&f Dirt"
	quest.5F0E877BE50D79D0.quest_desc: ["Used with &6Spatial IO Port&r to store spatial regions."]
	quest.5F96B028BB23FE5D.quest_desc: [
		"To use wireless tools, the storage &9network&f must be wirelessly accessible by installing wireless transmitters. Default range is 16 blocks but can be increased."
		""
		"To link the Wireless Grid to your network, Shift + right-click on any device in your storage network."
	]
	quest.5F96B028BB23FE5D.quest_subtitle: "Access"
	quest.5FA26B0DCC847238.quest_desc: ["Find a stronghold, we need to activate the &5portal&f to &5the End&f."]
	quest.5FA26B0DCC847238.quest_subtitle: "Chasing &5the End&f"
	quest.5FAEE106DEADDD95.quest_desc: ["Welcome to Oritech! Oritech is a completely new and unique mod, visually stunning with incredible features. It brings new cable types, reactors, miners, and much more!"]
	quest.5FAEE106DEADDD95.quest_subtitle: "A New Engineering"
	quest.6013A55D0A31137E.title: "{ftb\tquests.chapter.mystical_agriculture.quest6013A55D0A31137E.title}"
	quest.60331FE2ECA3A946.quest_desc: [
		"To travel long distances, you need to &aupgrade&f this rocket!"
		""
		"There are four types of Rocket Upgrades:"
		""
		"Motor Upgrade: Changes the fuel required by the Rocket"
		"Tank Upgrade: Changes max fuel tank capacity"
		"Model Upgrade: Changes rocket model"
		"Skin Upgrade: Changes rocket skin"
	]
	quest.60331FE2ECA3A946.quest_subtitle: "Want to Travel Further?"
	quest.603877AB96321F1A.quest_desc: [
		"The Thermal Evaporation Plant or a Solar Evaporation Plant with the addition of Advanced Solar Generators, is a multiblock structure that converts water to Brine, and Brine \\& Lithium by the use of a second TEP."
		""
		"To accelerate the rate of production beyond simply placing advanced solar generators at the top, the player must import a source of heat into a valve. This is most easily done by placing a resistive heater next to a valve. Setting the &eenergy&f consumption to 1250 FE/t will provide the maximum boost, with any higher consumption having no effect."
	]
	quest.605C0B84DFC1A4D5.quest_desc: [
		"Gantry Carriages are a Contraption that will collide with unmovable blocks in their path."
		""
		"Place Gantry Shafts along where the Gantry Carriage will move. Apply Rotational &epower&f to the shafts to move the Carriage along them, and invert the power to move it back. Inverting the placement of the shafts will invert all movement. Use a &aWrench&f to help change the orientation."
		""
		"For every 1rpm of rotational power, the gantry carriage will move along the shaft at a linear &aspeed&f of 0.03846 blocks/second."
		""
		"Apply a &cRedstone&f signal to the shaft to stop the carriage and send rotational power through the Carriage's output. This can be used to move another attached Gantry Carriage."
		""
		"Gantry Shafts attached to the Carriage's output will move along with them &9automatically&f."
		""
		"Multiple Carriages on one shaft can also move the same structure built onto it."
	]
	quest.60B5B315CD03E162.quest_desc: ["This &2seed&f is the foundation for starting seeds in the modpack! You need it to start."]
	quest.60B5B315CD03E162.quest_subtitle: "Base &2Seed&f"
	quest.60EC70ED9DC908A0.quest_subtitle: "Uncharged Quartz"
	quest.60F40F9349D3F369.quest_desc: [
		"That’s all for now! You’ve reached &5the end&f of &9Mekanism&f’s progression in this modpack."
		""
		"For the moment, there are no additional Mekanism addons or extensions, so this is as far as your factory can go. You’ve mastered every stage of ore processing and &9automation&f available an impressive achievement!"
		""
		"Keep exploring, experimenting, and integrating Mekanism with other mods to push your production even further. Who knows what upgrades might come in the future?"
	]
	quest.612A0A9F85E338F6.quest_desc: ["This block serves as an extension to our &9system&f, helping link everything together! And we can dye it."]
	quest.612A0A9F85E338F6.quest_subtitle: "Decorating"
	quest.61348E2551E8AD6C.quest_desc: [
		"For the Rotation &aSpeed&f Controller to work, it must be paired with a Large Cogwheel. The Rotation Speed Controller, when powered by the Large Cogwheel, outputs any desired speed of rotational force from its sides. It also does the opposite; when powered from its sides, it controls the speed of the Large Cogwheel."
		""
		"The rotation speed and direction can be changed in the Value Settings Screen at the front or the back of the &9machine&f. The speed can be set to a maximum of 256rpms clockwise or counter-clockwise."
	]
	quest.618AA6F5B498966F.quest_subtitle: "Minotaur Drop"
	quest.61A97968BD86738D.quest_desc: ["So to get this tool you just need to kill a &4boss&f, simple stuff."]
	quest.61A97968BD86738D.quest_subtitle: "Is This a Tool?"
	quest.61FF9A034749467F.quest_desc: ["I know you never thought about being the &1warden&f... but this powerful &dstaff&f can be pretty cool!"]
	quest.61FF9A034749467F.quest_subtitle: "&1Warden&f!"
	quest.6213EC800B6C9A60.title: "{ftb\tquests.chapter.mystical_agriculture.quest6213EC800B6C9A60.title}"
	quest.621F052BCE747E68.quest_desc: [
		"Higher Capacity cable, can carry 32 Channels unlike standard cable which can only carry 8."
		""
		"However it doesn't support buses so you must first step down from dense to a smaller cable (such as Fluix ME Glass Cable or Fluix ME Smart Cable) before using buses or panels."
		""
		"Shows load similarly to Fluix ME Smart Cable, with each line lit representing four Channels in use."
	]
	quest.6235BBB56DA52EAB.quest_desc: [
		"There are many ways for your &9network&f to interact with other &9machines&f. This allows automating processes and making life easier!"
		""
		"The Importer extracts resources from a connected external inventory into the storage network."
		""
		"The Exporter extracts resources from the storage network into a connected external inventory."
		""
		"The Interface combines features of Importer and Exporter."
		""
		"External Storage provides the storage network with storage space from connected external inventories (chests, drawers, barrels). This way you keep large amounts of items without overloading disks."
	]
	quest.626580DB654F128D.quest_desc: ["The Millstone is capable of applying milling recipes to any valid items inserted from above."]
	quest.62BAE54B507B7A21.quest_subtitle: "Crafting ingredient"
	quest.62C537CD789F46A8.quest_desc: ["&dArs Nouveau&f is an incredible mod allowing us to craft custom &dspells&f, customize armor, explore new biomas, new altars and much more!"]
	quest.62C537CD789F46A8.quest_subtitle: "&6Create&f Your Spells!"
	quest.62CD24B33EF2FD15.quest_subtitle: "Netherite &aupgrade&f"
	quest.63116F5AC987C442.quest_desc: ["Once we get our first atomic, everything &aimproves&f drastically!"]
	quest.63116F5AC987C442.quest_subtitle: "Starting to Get Cool"
	quest.633147DFBEDC8F9D.quest_desc: ["These big guys stay in the &3water&f waiting for us to slip up!"]
	quest.633147DFBEDC8F9D.quest_subtitle: "A Little &3Water&f Monster"
	quest.6350ADB7540C368D.quest_desc: [
		"If the Smart Observer is placed with the front facing a container such as a Mechanical Belt, Funnel or &3Fluid&f Pipe, it will emit a &cRedstone&f signal when an item is detected inside. A Smart Observer will also emit a signal if the block placed in front of it matches the filter."
		""
		"If a Filter is applied to the Smart Observer, it will only emit a redstone signal when the item in the filter is detected."
	]
	quest.63A18018090DB63E.quest_desc: ["Store massive quantities of a single item!"]
	quest.63A18018090DB63E.quest_subtitle: "A New Warehouse"
	quest.63B2455BB59EDC81.quest_desc: ["In a new, extremely gross world, we can find a final &4boss&f whose minions will be wearing this &7armor&f..."]
	quest.63B2455BB59EDC81.quest_subtitle: "A Gross World"
	quest.63B2455BB59EDC81.title: "Ancient &7Armor&f"
	quest.63B4B83F528E6AD6.quest_desc: ["{ \"text\": \"Click Me!\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"4CFE8B1C53B429E9\" } }"]
	quest.63E8F78EEA3063F7.quest_desc: ["{ \"text\": \"Click Me!\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"24DDED464AE48E05\" } }"]
	quest.641A6EFAB3BD34F9.quest_desc: ["The final tier of &2seeds&f in the mod and probably one of the most powerful parts of our modpack!"]
	quest.641A6EFAB3BD34F9.quest_subtitle: "THE FINAL"
	quest.648B3A56FD170FBE.quest_desc: [
		"This structure is the largest in the mod!"
		""
		"A massive beehive with interconnected rooms resembling a labyrinth..."
		""
		"Feed bees to receive the bee protection effect."
		""
		"Explore and &6loot&f its resources!"
	]
	quest.648B3A56FD170FBE.quest_subtitle: "A Unique Structure!"
	quest.65524E9701FD370B.quest_subtitle: "Level 10"
	quest.65C0B2AD90D292EE.title: "&bFroststeel&f Armor"
	quest.66042E6264BAC86F.quest_subtitle: "Decorate chests, barrels, etc."
	quest.6617C1A5821899CB.quest_desc: [
		"The &6slingshot&f is a very curious weapon and it takes 4 new types of ammo, which are"
		""
		"- Glitter Goo"
		"- Depthrock Pebbles"
		"- Blisterberries"
		"- Gronglets"
		""
		"Try them all out and test the effects!"
		""
		"Okay... just do not test them on certain monsters. We can split the monsters into 3 categories"
		""
		"- Friend"
		"- &cHostile&f"
		"- &eNeutral&f"
		""
		"Every mob has something new and specific!"
	]
	quest.6617C1A5821899CB.quest_subtitle: "A New Weapon and New Creatures"
	quest.66507950890A5031.quest_desc: ["You can use this compass to locate beehives; use \"Shift + Right-click\" on a hive to track it, or click in the air to locate a cell maze."]
	quest.66507950890A5031.quest_subtitle: "Locating Beehives"
	quest.666E760E6ED96FA5.quest_desc: ["We can collect a white moa egg dropped naturally, incubate it using an incubator, and get a loyal Moa follower."]
	quest.666E760E6ED96FA5.quest_subtitle: "Incubation"
	quest.668D908EB0805AFB.quest_desc: [
		"In the &bAether&f we can find our first challenge..."
		""
		"Find Slider's cave and kill him."
		""
		"Slider is a huge block with an eye that only takes pickaxe &cdamage&f!"
		""
		""
		"{entity:aether:slider ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:FORCE_OFF walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.668D908EB0805AFB.quest_subtitle: "The First Challenge"
	quest.668D908EB0805AFB.title: "Slider"
	quest.66F55A558D9D8046.quest_desc: [
		"{ftb\tquests.chapter.mystical_agriculture.quest66F55A558D9D8046.description1}"
		""
		"{ftb\tquests.chapter.mystical_agriculture.quest66F55A558D9D8046.description2}"
		""
		"{ftb\tquests.chapter.mystical_agriculture.quest66F55A558D9D8046.description3}"
		""
	]
	quest.66F55A558D9D8046.title: "{ftb\tquests.chapter.mystical_agriculture.quest66F55A558D9D8046.title}"
	quest.671A4C7E154A84F7.quest_desc: ["Grabbing the &5lich&f's &dstaff&f? Okay... forget what I said."]
	quest.671A4C7E154A84F7.quest_subtitle: "&5Lich&f"
	quest.674CE01022E73F94.quest_desc: ["Now to mine we need to &aimprove&f our gear a bit! &7Stone&f is a great option for now."]
	quest.674CE01022E73F94.quest_subtitle: "&aBetter&f Equipment"
	quest.674CE01022E73F94.title: "&7Stone&f Tools"
	quest.6819665DA7028C9E.quest_subtitle: "Crafting ingredient"
	quest.6832CFEAFA7922E8.quest_desc: ["A device that produces immense stress when powered, halting the &9network&f by overstressing it."]
	quest.6847F5D14FCB5BF8.quest_desc: [
		"Use the Meteorite Compass to find Skystone Meteorites, which have a chance to contain Quartz blocks and Budding Quartz."
		""
		"It has a max range of roughly 2,700 blocks."
	]
	quest.6847F5D14FCB5BF8.quest_subtitle: "Location"
	quest.6861F1FC1B93A8B5.quest_desc: ["To strengthen friendships with villagers, complete a few trades with them."]
	quest.6861F1FC1B93A8B5.quest_subtitle: "Making Trades"
	quest.6861F1FC1B93A8B5.title: "Trades"
	quest.6879D6F9D509EE89.quest_desc: [
		"The &dSigil&f of Supremacy is incredible, it can make your &daffixes&f even stronger!"
		""
		"To get one you need to beat 100 waves of the endless invader portal!"
	]
	quest.6879D6F9D509EE89.quest_subtitle: "Applying &cStrength&f"
	quest.688DEDE851A70715.quest_desc: ["Too many tools in your inventory? Why not merge them all into one? That is the &apaxel&f!"]
	quest.688DEDE851A70715.quest_subtitle: "Paxels"
	quest.68E689236D4C8B03.quest_subtitle: "Iron -> &6Gold&f"
	quest.6901CE285C0BD33B.quest_subtitle: "Putting Potions Inside"
	quest.6906B642B1CE83C7.quest_desc: ["Activate &5The End&f &5portal&f to discover if this is truly the end."]
	quest.6906B642B1CE83C7.quest_subtitle: "Is It &5the End&f?"
	quest.6906B642B1CE83C7.title: "&5The End&f?"
	quest.697F7FDE01DB8A73.quest_desc: [
		"This big rotten guy is a &cdanger&f, and I think you already noticed it has a whole bloodline behind it..."
		""
		"It is almost a &4mini boss&f."
	]
	quest.697F7FDE01DB8A73.quest_subtitle: "The &cDanger&f"
	quest.69816C16E81355E8.quest_desc: ["A clutch that uncouples after a set delay when the &9network&f is overstressed."]
	quest.699BA2BB99DCA637.quest_desc: ["Now we need to build an &3oxygen&f distributor &9machine&f. Place it in a sealed room with nothing else, then put the oxygen tank in the middle slot! It still requires energy."]
	quest.699BA2BB99DCA637.quest_subtitle: "Distributing &3Oxygen&f without Waste"
	quest.69A89163A0410006.quest_desc: ["Summon &bclouds&f that will help you during combat."]
	quest.69A89163A0410006.quest_subtitle: "&bClouds&f!"
	quest.69C397E5D43B6643.quest_desc: ["It's always good to explore a bit before diving into major mining! Find a village."]
	quest.69C397E5D43B6643.quest_subtitle: "Find a Village"
	quest.69C397E5D43B6643.title: "Best Friends"
	quest.6A16F0EA7F789EF0.quest_desc: [
		"Like electric shocks? I personally don't like them much, but..."
		""
		"To collect a bottle, simply right-click a charged creeper with a glass bottle."
	]
	quest.6A16F0EA7F789EF0.quest_subtitle: "&eLightning&f School"
	quest.6A4CF3A1CF4D4928.quest_desc: [
		"The Charger provides a way to charge supported tools, and Certus Quartz Crystal."
		""
		"Power can be provided via the top or bottom, via either AE2's cables, or other mod power cables. It can accept either AE2's power (AE) or Forge &eEnergy&f (FE). Items can be inserted or removed from any side. Only the results can be removed, so no need for filters to prevent removing certus crystals instead of charged certus. Can be rotated with a Certus Quartz Wrench in order to facilitate &9automation&f."
		""
		"Can be used to &6create&f Charged Certus Quartz Crystal from Certus Quartz Crystal, and Meteorite Compass from Compass."
		""
		"To &epower&f it manually, place a Wooden Crank on the top or bottom and right-click it until the item is charged."
	]
	quest.6A4CF3A1CF4D4928.quest_subtitle: "The Charger"
	quest.6A6149271D988E20.quest_desc: [
		"A new enchanting table! With this new table we can \"enchant\" an item, but with &daffixes&f."
		""
		"The &erarity&f material will clearly determine the rarity of the &daffix&f on the item."
		""
		"It also works to &aupgrade&f some items to a better rarity."
		""
		"It is very similar to an enchanting table, but with this one you can only get affixes up to the Rare tier."
	]
	quest.6A6149271D988E20.quest_subtitle: "Simple Reforging"
	quest.6A7535662506465E.quest_desc: ["By fishing we can put together this beautiful &cbow&f."]
	quest.6A7535662506465E.quest_subtitle: "&cBow&f of the Sea"
	quest.6A84FC7CC5304E10.quest_subtitle: "Crafting ingredient"
	quest.6AC87D338F76D289.quest_desc: ["With knight &7ingots&f we can craft tools and an awesome new &7armor&f set!"]
	quest.6AC87D338F76D289.quest_subtitle: "Knight Drop"
	quest.6AEB8A9845481DF9.quest_desc: ["That is right... lol"]
	quest.6AEB8A9845481DF9.quest_subtitle: "A Simple Bone &7Armor&f"
	quest.6AEB8A9845481DF9.title: "Bone &7Armor&f"
	quest.6AFDDA5FCD53BAC2.quest_desc: ["Gather this new wood: it is identical to normal wood and crafts new tools."]
	quest.6AFDDA5FCD53BAC2.quest_subtitle: "A New Type of Wood"
	quest.6AFDDA5FCD53BAC2.title: "Skyroot Logs"
	quest.6B5C3E68A6A3F3B5.quest_desc: [
		"The Spatial Pylon is used in spatial IO to generate the spatial field and define the volume to be affected."
		""
		"Each continuous line of pylons uses 1 channel"
		""
		"Lines of pylons must be at least 2 blocks long to function."
	]
	quest.6B7188472F6ED6AF.quest_desc: ["Allow &credstone&f links to match any frequency for the slot it is placed in."]
	quest.6B7DE9EA8E828DEE.quest_desc: [
		"The Inscriber creates different types of Processors."
		" "
		"The Inscriber can also \"create\" presses by duplicating an existing press with an Iron Block."
	]
	quest.6B8966D7EA9BB5FB.quest_desc: ["Hand cranks with a cogwheel installed."]
	quest.6B8E544E188FBA4D.quest_subtitle: "The heart of your &9system&f"
	quest.6BDADBD93AD3E66A.quest_subtitle: "Level 3"
	quest.6C25D42C36175BF4.quest_desc: [
		"The Purification Chamber uses &3oxygen&f to refine Ores and shards into clumps. Each ore makes 3 clumps, whereas each shard only gives one clump."
		""
		"The oxygen can be provided externally as gas, internally with an oxygen filled Gas Tank or flint. (See the gas page for how to make oxygen)"
		""
		"For example: you could transform Copper Ore into 3 Copper Clump."
		"Clumps can then be placed in a Crusher, producing dirty ores, which can be enriched in an Enrichment Chamber to &6create&f regular dusts."
		""
		"Additionally you can turn &7gravel&f into flint."
	]
	quest.6C25D42C36175BF4.quest_subtitle: "It makes Clumps"
	quest.6C52741D22052A14.quest_subtitle: "{ftb\tquests.chapter.mystical_agriculture.quest6C52741D22052A14.subtitle}"
	quest.6C52741D22052A14.title: "{ftb\tquests.chapter.mystical_agriculture.quest6C52741D22052A14.title}"
	quest.6CAFFB7C516F4C3A.quest_desc: ["To start in the mod, we need some of its resources!"]
	quest.6CAFFB7C516F4C3A.quest_subtitle: "Starting by Gathering Resources"
	quest.6CAFFB7C516F4C3A.title: "&7Ingots&f"
	quest.6CB1BE8F49612621.quest_desc: ["This is definitely the best &7pickaxe&f option we have... thank you, &dMystical Agriculture&f."]
	quest.6CB1BE8F49612621.quest_subtitle: "The Best"
	quest.6CCC8862AC60DA2A.quest_desc: ["To &6create&f the brake for our car, we need to put a &credstone&f signal on top of the wheel mount block; for that, we will again use 2 redstone links and put 1 on top of each wheel mount block with 2 redstones on each in wireless mode. Pair it with the linked controller and bind a key to brake!"]
	quest.6CCC8862AC60DA2A.quest_subtitle: "Braking"
	quest.6CD96328B7567F46.quest_desc: ["The &9Mechanical&f Harvester will &2harvest&f all mature crops it comes in contact with while moving forward."]
	quest.6CE70938F57D9F4F.quest_desc: ["To move &afaster&f in space, how about hitching a ride? But you drive!"]
	quest.6CE70938F57D9F4F.quest_subtitle: "Driving a Car"
	quest.6D03D3B4D83C1840.quest_desc: [
		"Right click the front of a &9Mechanical&f Crafter with a &aWrench&f to change the direction it sends items during crafting. "
		""
		"Mechanical Crafters can be &9automatically&f filled by Funnels or Hoppers."
		""
		"On the back and sides of Mechanical Crafters, a Wrench can be used to connect or disconnect the inventory of two adjacent crafters. Crafters can share inventories while not participating in the same crafting recipe."
		""
		"{@pagebreak}"
		""
		"Items can also be inserted or removed by hand."
		""
		"Each Mechanical Crafter has an internal gear that can only be powered by adjacent Mechanical Crafters or any size Cogwheel. This means only 1 Mechanical Crafter in a setup needs to be powered by a Cogwheel."
		""
		"When powered by rotational force and either powered with &cRedstone&f or all crafter slots are filled, Mechanical Crafters will send their items to adjacent crafters. For a successful recipe, the items must eventually meet in one crafter. Once all of the items reach the final Crafter, they will turn into the product."
	]
	quest.6D34125C705B2B73.quest_desc: ["We need to add a seat where we will drive the car, or where our companions will go"]
	quest.6D34125C705B2B73.quest_subtitle: "Car seats"
	quest.6D34125C705B2B73.title: "Seat"
	quest.6D53C9F918EC6C22.quest_desc: [
		"Okay, we know the Warden is one of the strongest &4bosses&f in Minecraft right now, but it looks like an ancient &5portal&f has been opened..."
		""
		"Apparently when we kill a warden we get its heart, and that is used to activate a kind of portal that sits in the center of the &1ancient city&f... it really does have a portal shape, just place the heart there and done!"
		""
		"But be careful... we do not know much about this new place, so you can never be too careful!"
	]
	quest.6D53C9F918EC6C22.quest_subtitle: "A New Place..."
	quest.6D5BF32013493D1B.quest_desc: [
		"The Builder places resources from the storage &9network&f into the block space in front of it."
		""
		"Breaks blocks in front of it and stores dropped items in the storage network."
	]
	quest.6D629E63EF18EDB7.quest_desc: ["This is certainly the heart of Tom's Storage: with it we can place a terminal on its face and it links all chests from any mod to our terminal. Its &epower&f is so great that chests don't even need direct wiring—just touching adjacent chests links everything! It's wonderful, but be &ccareful&f as it can lag your world."]
	quest.6D629E63EF18EDB7.quest_subtitle: "Heart of the Mod"
	quest.6DB1AAAD926486BC.quest_desc: [
		"&aFluid Tanks&r are storage blocks to store fluids."
		""
		"The amount of &3fluid&f (mb) a fluid tank can store is based on its tier."
		""
		"It will retain its inventory when broken. You may use a &dMechanical Pipe&r set to &cPull&r in order to extract fluid out of the tank."
		""
		"It has a &o&bbucket&r mode which can be toggled to scoop up liquids. Very useful for &6lava&r in the beginning!"
	]
	quest.6DC15DEA86323177.quest_subtitle: "Tier 3"
	quest.6DC89199CF88AD9D.quest_desc: ["Assemble some processors now. They are basic components for monitors, storage disks, and many other useful devices."]
	quest.6DC89199CF88AD9D.quest_subtitle: "Processor"
	quest.6DE8ACA4F08C420E.quest_desc: ["Transfer stress capacity from one &9network&f to another while keeping the networks separate. Guarantees that the source network will not be affected when the destination network is overstressed."]
	quest.6E09598776B86170.quest_subtitle: "Routing Items via Cables"
	quest.6E84C5F839BE53F8.quest_desc: ["The Silk Touch &aUpgrade&f applies the silk touch effect when breaking blocks."]
	quest.6E8C6A4A07957E5A.quest_desc: [
		"When Rotational Force is given to the Hose Pully, it can extend the hose infinitely. Reversing the Rotational Force will retract the hose back to the block. The hose of the Hose Pully must be extended by at least one block before it can function."
		""
		"A &3Fluid&f Pump is required for the hose to drain or flood &3liquids&f."
		""
		"-If a fluid is pumped out, it will drain a body of liquid down to the level of the hose. If multiple hose pulleys draw from the same source, it will effectively expedite the drainage process, provided that the pipe's capacity is maintained."
		""
		"-If a fluid is pumped in, it will flood a room of any size, with the hose marking the highest point of flooding."
	]
	quest.6E95E958201D50BE.quest_desc: [
		"The personal chest used to be called \"Electric Chest\" and could be locked with electricity. Now it's called Personal Chest and doesn't require electricity. You can still lock it and set it to \"trusted\"."
		""
		"The chest can be placed down and used as a normal chest. This chest has double-chest capacity in a single-chest footprint. Right-clicking air opens your chest storage. When used with a Logistical Transporter, items pipe in and out."
	]
	quest.6EA409C847643AA9.quest_desc: ["It does what a &2hoe&f is supposed to do... THERE IS NOT MUCH TO SAY ABOUT HOES, OKAY?"]
	quest.6EA409C847643AA9.quest_subtitle: "An Honest &2Hoe&f"
	quest.6F2BB87E67529CE2.quest_subtitle: "Minecart with Barrel?"
	quest.6F4566043F03772F.quest_desc: ["To connect storage networks wirelessly, a &9network&f transmitter is needed at the sending end. It sends a wireless signal to a network receiver via a network card."]
	quest.6F51FEB17AB8A628.quest_desc: ["We discovered a new &5dimension&f of the warden and its cousins... in that dimension we can craft this incredible new &7armor&f."]
	quest.6F51FEB17AB8A628.quest_subtitle: "Secrets of the &1Warden&f"
	quest.6F51FEB17AB8A628.title: "Warden &7Armor&f"
	quest.6F62B5510FA881CD.quest_subtitle: "Crafting ingredient"
	quest.6F6423562E56FFE7.quest_subtitle: "Level 10"
	quest.6F72E5E7543FA64F.quest_desc: [
		"Generating &bmana&f is always good! But watch out, it turns blocks underneath into &6lava&f!"
		""
		"Place a pedestal next to the generator; it will consume wood, coal... to generate mana."
	]
	quest.6F72E5E7543FA64F.quest_subtitle: "Generating with Heat"
	quest.6FBC7D12F531A361.quest_desc: ["We can use this &9machine&f to build helicopters or any kind of spacecraft that flies upward (I don't think there's a way to fly downward)"]
	quest.6FBC7D12F531A361.quest_subtitle: "Helicopter"
	quest.6FC6A14FD1460DED.title: "&bFroststeel&f Tools"
	quest.6FE2FE40C2F60183.quest_desc: ["Relays rotation in two directions independently."]
	quest.6FFCB95FF00EFA76.quest_desc: ["Have you ever seen a rocket reverse? Neither have I... so we need this launch pad: for all launches, we place rockets on top of them."]
	quest.6FFCB95FF00EFA76.quest_subtitle: "Landing and Takeoff"
	quest.7076CEF6294F6310.title: "{ftb\tquests.chapter.mystical_agriculture.quest7076CEF6294F6310.title}"
	quest.7097EFDECE9CDAF7.quest_desc: ["Is your car stuck? Use an &7iron&f handler connected to your car, this way you can hold your car in your arm and take it out of somewhere."]
	quest.7097EFDECE9CDAF7.quest_subtitle: "Recovering the broken-down car"
	quest.70EFB06E6ADA9DA6.title: "{ftb\tquests.chapter.mystical_agriculture.quest70EFB06E6ADA9DA6.title}"
	quest.70F2A165F26617E5.quest_subtitle: "Tier 2"
	quest.71209ECF85702E23.title: "Forgotten Weapons"
	quest.713EA1BC9BAAA0AB.quest_desc: [
		"The molecular assembler takes items input into it and carries out the operation defined by an adjacent ME Pattern Provider, or the inserted Crafting Pattern, Smithing Table Pattern, or Stonecutting Pattern, then pushes the result to adjacent inventories."
		""
		"This assembler has a crafting pattern that specifies the 1 oak log = 4 oak planks recipe. When oak logs are fed into the upper hopper, the assembler crafts and spits oak planks into the lower hopper."
	]
	quest.714B577B7516E43D.quest_desc: ["We can build new tools whenever we reach a new &2seed&f tier in &dMystical&f, always getting stronger!"]
	quest.714B577B7516E43D.quest_subtitle: "New Tools"
	quest.714B577B7516E43D.title: "Imperium Tools"
	quest.715FAA375354094A.quest_desc: [
		"This little critter looks more like a rock than anything else..."
		""
		"It drops &2mogmoss&f, which can be used for all kinds of things."
	]
	quest.715FAA375354094A.quest_subtitle: "Looks Like a Rock"
	quest.719218CEA358D540.quest_desc: ["Right-click the ground to place a Train Track facing away from you. Train tracks can be placed in eight different directions corresponding to the closest of the four cardinal direction and 45° increments in between. Tracks may also be placed on the side of blocks that have no blocks immediately above them. These tracks will have a 45° vertical incline. Break tracks using any pickaxe or by right clicking with a &awrench&f while sneaking. Breaking with any other item will cause a track to disappear."]
	quest.71A772DE60643C45.quest_subtitle: "Templates"
	quest.71A8D4B8F0EAFF90.quest_desc: [
		"We need a new glue that is better and more powerful to help us make our first car; with this glue, we can use \"Ctrl\" + \"Scroll\" to better adjust the glue."
		""
		"{image:\tquests:textures/honey.png width:150 height:100 align:center}"
	]
	quest.71A8D4B8F0EAFF90.quest_subtitle: "Gluing everything together"
	quest.721EB46E1F33F60B.quest_desc: ["You might not understand anything yet, but on your tools and armor there is an \"empty\" slot for enchantments! Let me introduce augments: they are a type of enchantment where we can greatly improve armor and tools. There are many types and they are very powerful!"]
	quest.721EB46E1F33F60B.quest_subtitle: "Calm Down!"
	quest.726B0C78F7E74767.quest_desc: ["To make our first Ink, we need to put &3water&f in a cauldron and throw in unused scrolls, then click with a glass bottle to gather it."]
	quest.726B0C78F7E74767.quest_subtitle: "The First Ink"
	quest.72741F61102AD02F.quest_desc: ["Within the mod itself, there is a crafting altar using an imbuement chamber surrounded by &darcane&f pedestals! But unlike what we think, pedestal items aren't consumed, only the mod's gem!"]
	quest.72741F61102AD02F.quest_subtitle: "Creating Recipes"
	quest.72906BB67DCBF4C2.quest_desc: ["Love nature? This school fits you perfectly; use nature &dspells&f."]
	quest.72906BB67DCBF4C2.quest_subtitle: "Nature School"
	quest.72C7565BBB3A54BB.quest_desc: [
		"Getting into the &2Undergarden&f is very simple: just build a new portal similar to the &4nether&f one, but with stone bricks..."
		""
		"Once the portal frame is built, just right-click to light it like a flint and steel and done! Portal created."
	]
	quest.72C7565BBB3A54BB.quest_subtitle: "Entering the &5Dimension&f"
	quest.72D4B6C885DBCB65.quest_subtitle: "Iron &aupgrade&f"
	quest.7322A19FDA5B78E1.quest_desc: ["The Valve Handle functions much like the Hand Crank, though the amount and direction it rotates with one use can be adjusted in its Value Settings Screen."]
	quest.732D1A96512F2BFD.quest_desc: [
		"The Steam &9Engine&f is a block that provides Rotational Force. "
		""
		"It outputs the highest Stress Unit (SU) capacity of all the survival mode &epower&f generating blocks. "
		""
		"It converts the pressure caused by heating &3Water&f in a &3Fluid&f Tank into Rotational Force, allowing for large scale item production and multiple contraptions to be powered."
		""
		"Brace for a huge amount of text."
		""
		"{@pagebreak}"
		""
		"Steam Engines use heated Water for power and are placed on Fluid Tanks, which are then used as a boiler. A Shaft can be used on the engine to &6create&f a kinetic output. The direction of said output can be adjusted through the Value Settings on the side of the engine."
		""
		"Increasing the total power generated requires that one or more of the three characteristics (heat, size, water) of the Fluid Tank boiler be increased. This will increase the boiler's level to the lowest level reached by any of the three characteristics, increasing the maximum amount of SU Steam Engines are capable of generating from the boiler. A single Steam Engine can only extract up to 16,384 SU (The equivalent of 1 boiler level). To combat this, multiple Steam Engines can be attached to a single boiler to extract more power; however, this will not increase the total power generated by the boiler."
		""
		"{@pagebreak}"
		""
		"The tank size is the basic characteristic of a steam boiler. The required &5dimensions&f are affected by the heat supplied. For a passive steam engine (level 0) the boiler must be a 2x2 fluid tank of preferably one block height (making it any higher will be a waste of resources). For an active steam engine (level 1 or higher) the boiler must have 4 blocks per heat level. For example, a level 1 boiler must have a tank made of at least 4 fluid tank blocks, a level 9 boiler must be made of at least 36 blocks and a level 18 boiler (maximum achievable) must be at least made of 72 blocks."
	]
	quest.732F5B974C62A97A.quest_desc: ["We can &6create&f new types of dirt to speed up the seed &agrowth&f process."]
	quest.732F5B974C62A97A.quest_subtitle: "An &aImproved&f Dirt"
	quest.737148FEF43D63AB.quest_desc: ["This is definitely one of the most incredible armors in all of Minecraft, with unique abilities and a completely new and different way of getting stronger."]
	quest.737148FEF43D63AB.quest_subtitle: "The Long-Awaited One..."
	quest.737148FEF43D63AB.title: "&9MekaSuit&f Armor"
	quest.743C84D1D94C5670.quest_desc: ["The Brass Funnel is a block that can extract or insert items into inventories"]
	quest.743D35348A5FA3AA.quest_subtitle: "Our Ender &dMagic&f"
	quest.745255652688D720.quest_desc: ["We need to &6create&f the sphere part of the balloons using this block"]
	quest.745255652688D720.quest_subtitle: "Forming a balloon"
	quest.746C4B9DEC8DE25C.title: "{ftb\tquests.chapter.mystical_agriculture.quest746C4B9DEC8DE25C.title}"
	quest.74CB7630E0651068.quest_desc: ["With the propeller we can &6create&f the final rotation for the spinning of an airplane's blades by connecting it to a windmill."]
	quest.74CB7630E0651068.quest_subtitle: "Rotation"
	quest.74E28EDF15C093FA.quest_desc: ["In &dArs Nouveau&f we can &6create&f enchantments just like crafting and it's perfect: it consumes lots of mana and few resources. To build, place this machine over an Arcane Core surrounded by pedestals!"]
	quest.74E28EDF15C093FA.quest_subtitle: "Creating &dEnchantments&f"
	quest.750FE9289D621671.quest_desc: ["Listen to what I am saying... &7Silent Gear&f is &alife&f."]
	quest.750FE9289D621671.quest_subtitle: "One of the Best"
	quest.7516ECCE942821F1.quest_desc: ["It really is radioactive and functions as fuel, INCREDIBLE!"]
	quest.7516ECCE942821F1.quest_subtitle: "BE &cCAREFUL&f!"
	quest.7553689BC9202E14.quest_desc: ["Universal Cables are &9Mekanism&f's way to transfer &epower&f."]
	quest.75ABCED764FF5C95.quest_desc: ["This &7Silent Gear&f... it is an incredible and very strong mod!"]
	quest.75ABCED764FF5C95.quest_subtitle: "Silent..."
	quest.75ABEA98F245395A.quest_desc: [
		"To start your autocrafting journey, first you need the Pattern Grid and some patterns."
		""
		"Tip: Setting up a pattern for a Pattern Card first is mandatory!"
	]
	quest.75ABEA98F245395A.quest_subtitle: "Auto Craft"
	quest.75E7216AB5411DF6.quest_desc: [
		"Chopping"
		"&9Mechanical&f Saws are powered through rotational force, and when placed down facing to the side they will &9automatically&f chop down wood blocks in front of them. When chopping down a tree or giant mushroom, it will automatically destroy the entire tree by only destroying the bottom-most block."
		""
		"Mechanical saws are only supposed to mine 2x2 trees as long as at least the last block (horizontally) is mined using the saw. The easiest way to bypass this is by removing the block immediately above the block being cut, in which case the entire 2x2 tree will be cut down by the mechanical saw."
		""
		"{@pagebreak}"
		""
		"Mechanical saws can mine any structure of logs that doesn't have a vertical 2x2 square with the block being destroyed as one of the bottom blocks"
		""
		"Mechanical saws are automatically powered when on a &6create&f Contraption. The saw will &cdamage&f entities and break blocks at a certain speed depending on the contraption's speed."
	]
	quest.75F36D95332C5BE7.quest_desc: ["To really get started, you need to grab an &7anvil&f and let it drop onto some &bgems&f!"]
	quest.75F36D95332C5BE7.quest_subtitle: "Getting Started"
	quest.7653935BDE025D18.quest_desc: [
		"The &dScuba Tank&r is a piece of equipment worn on the backpack (the chest armor slot) that provides underwater respiration when a Scuba Mask is worn (on the helmet armor slot)."
		""
		"Like the &cJetpack&r, the &dScuba Tank&r must be filled with &3Oxygen&r gas in order to function."
		""
		"The &eScuba Mask&r is an utility head armor piece, used in conjunction with the &dScuba Tank&r to breathe underwater."
	]
	quest.76693A353DF530C5.quest_desc: ["Not &3fluid&f! FLUIX. This is a great &7pickaxe&f for us to start with."]
	quest.76693A353DF530C5.quest_subtitle: "&3Fluid&f?"
	quest.76729738389C5C5F.quest_desc: [
		"&7While the mutant enderman is dying, you can actually collect &dendersoul fragments&7 by right-clicking them before they explode."
		""
		"&7Now with some &dendersoul fragments&7 following you, all you have to do is drop (&enot right-click&7) an &5eye of ender&7."
		""
		"&7Also, if your &dendersoul hand&7 is running out of uses and you have some spare &dendersoul fragments&7, just toss out your &dendersoul hand&7 while the fragments are following you and it'll recharge the hand again (&fwith 60 uses each fragment&7)."
	]
	quest.768789FEB6EBB8F8.quest_desc: [
		"A Blaze Burner is a heating component that is required for certain Mixing recipes. It can be used for heating Steam &9Engines&f, Bulk Smoking, Bulk &6Smelting&f, and as a decorative light source."
		""
		"{@pagebreak}"
		""
		"Heating"
		"&6Blaze&f Burners are used for Heating and Super-Heating Basins when doing Mixing recipes. In particular, they are required to make Brass. They can also be used as a heat source for boilers used to &epower&f Steam Engines. When a heat-able block is placed above a fueled Blaze Burner, the Burner will appear to channel heat into the block."
		""
		"Right-clicking a Blaze Burner with any item that can be used as &6Furnace&f fuel will temporarily put it in a Heated state. Right-clicking a Blaze Burner with a Blaze Cake will temporarily put it in a Super-Heated state."
	]
	quest.76919513DA354DBC.quest_desc: [
		"The Gearbox is a block used to transfer Rotational &epower&f in 4 directions, either horizontally or vertically."
		""
		"The Gearbox can relay rotational power in four horizontal directions. The vertical counterpart, like the normal version, can relay power in four vertical directions."
		""
		"When receiving input from any input side (sides with a shaft shape), the Gearbox will output/relay rotational power in opposite spin for all of the remaining sides. In another word, when the input is clockwise, the output on the other 3 sides will be anti-clockwise, and vice-versa."
	]
	quest.76A38CCA5816CDAD.quest_desc: ["Combining &3Oxygen&f, Ethylene, and a Substrate in a Pressurized Reaction Chamber will &6create&f an HDPE Pellet."]
	quest.76A38CCA5816CDAD.title: "HDPE Pellet"
	quest.76CD344B6CEB10ED.quest_desc: [
		"Scylla is a storm &4boss&f with an anchor found in the Acropolis."
		""
		""
		""
		"{entity:cataclysm:scylla ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:FORCE_OFF idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.76CD344B6CEB10ED.quest_subtitle: "Anchor"
	quest.76F6A0C9A7E1FF4E.quest_subtitle: "Level 5"
	quest.7700E08416618198.quest_desc: [
		"Interfaces act like a small chest and &3fluid&f tank that fills itself from and empties to &9network&f storage depending on what you set it to keep a stock of in its slots. It tries to complete this in a single gametick, so it can fill itself with or empty itself from up to 9 stacks per gametick, making it a fast method of import or export if you have fast item pipes."
		""
		"Another useful trait is that while most fluid tanks can only store 1 type of fluid, interfaces can store up to 9, as well as items. They're essentially just chests/multi-fluid tanks with some extra functionality, and you can prevent that extra functionality by keeping them disconnected from any networks. Thus, they are useful in some niche cases where you want to store a small amount of a bunch of different stuff."
	]
	quest.770219BE2938823D.quest_desc: ["Your first real RF &epower&f source. It consumes traditional furnace fuels (like coal) and produces 32 RF/t. This power is sufficient to power your first processing &9machines&f. It is recommended to build more than one as your workshop grows."]
	quest.770219BE2938823D.quest_subtitle: "First &eEnergy&f"
	quest.7711AE3434ABFC0D.quest_subtitle: "&bDiamond&f -> Netherite"
	quest.772B8C7D643ABEDE.quest_desc: ["To place an &daugment&f in our tool or &7armor&f, we need this table where we can apply augments!"]
	quest.772B8C7D643ABEDE.quest_subtitle: "Enchanting?"
	quest.7731C962033D0FCD.quest_desc: [
		"The &1Shattered&f are a pretty &7common&f monster in this dimension."
		""
		"They are strong, they are a mini version of the warden, and they drop Sculk Bones."
	]
	quest.7731C962033D0FCD.quest_subtitle: "All Pieced Together!"
	quest.773D79B6E48B6B34.quest_desc: ["Okay, I think this &5Ender Dragon&f took steroids, it's not natural... good thing it's you and not me... just kidding, I'll help you: start by destroying &5the end&f crystals and then kill him, simple right?"]
	quest.773D79B6E48B6B34.quest_subtitle: "We Reached the Place"
	quest.773D79B6E48B6B34.title: "&5The End&f"
	quest.776CD265115222B5.quest_desc: [
		"We cannot use conventional barrels in the mod, we need to convert them all into Sophisticated barrels!"
		""
		"We can use &aupgrades&f to facilitate: just clicking converts them!"
	]
	quest.776CD265115222B5.quest_subtitle: "Upgrading!"
	quest.77C3D285E52CCA0E.quest_desc: ["Table Cloths can be used to sell items to other players."]
	quest.77F74EF187FACB79.quest_desc: ["Walking through our world, we can find a &dmagic&f biome from &dArs Nouveau&f. In this biome we can collect magic wood, needed for almost everything in the mod."]
	quest.77F74EF187FACB79.quest_subtitle: "&dMagic&f Wood"
	quest.77F74EF187FACB79.title: "Archwood Planks"
	quest.77FCCB54DC1AE8BC.quest_desc: ["This new &7ore&f can be found all over the world and is dropped by Rot mobs."]
	quest.77FCCB54DC1AE8BC.quest_subtitle: "Infected &7Ore&f?"
	quest.78082F54F1810E9D.quest_subtitle: "Cook &2Food&f!"
	quest.7822F019C8513578.quest_desc: ["We now need to build our first &9machine&f: this machine draws &epower&f from the air and converts our amethyst or lapis lazuli into a new gem."]
	quest.7822F019C8513578.quest_subtitle: "Gems"
	quest.783C1961806EC8F6.quest_desc: [
		"We need to take the &aWrench&f and turn the chain drive that is 2 blocks in front of the torque generator."
		""
		"{image:\tquests:textures/wrench.png width:150 height:100 align:center}"
	]
	quest.783C1961806EC8F6.quest_subtitle: "Turning into a piece"
	quest.78AF6077B872830D.quest_desc: ["A dream..."]
	quest.78AF6077B872830D.quest_subtitle: "Coming soon..."
	quest.78AF67F97139031E.quest_desc: [
		"Be &ccareful&f not to fly too high so Red Bull doesn't give you &bwings&f..."
		""
		"Jokes aside, beware of shulker attacks making us float, as we could die from fall damage."
	]
	quest.78AF67F97139031E.quest_subtitle: "Fly?"
	quest.78AF67F97139031E.title: "Shulker"
	quest.78B30A8691C2AEFC.quest_subtitle: "?>?"
	quest.78D3E24598B98D4B.quest_desc: [
		"To explore new planets, we need &3oxygen&f in our lungs, so we need to craft the water separator. This machine separates oxygen and &3hydrogen&f from water."
		""
		"Connect a power source to the machine and add &3water&f to start separating oxygen."
		""
		"To automate water, you can craft a Water Pump over a water source next to the water separator."
	]
	quest.78D3E24598B98D4B.quest_subtitle: "&3Oxygen&f!"
	quest.78EE4D3221683BCE.quest_desc: ["Yes, things move fast here my friend, but it's not a speedrun: grab some &bdiamonds&f, we need a pickaxe!"]
	quest.78EE4D3221683BCE.quest_subtitle: "&bDiamond&f Time"
	quest.78EE4D3221683BCE.title: "&bDiamond&f"
	quest.7902575C61FE60B5.quest_subtitle: "&bDiamond&f upgrade"
	quest.7917E75BBA3F0614.quest_desc: [
		"First, use the display link on a Display Block to link it. Then place it on the Source Block that will be read from. Though it will link to any block, not every block can act as a display or source. "
		""
		"Right click the link to access its interface. Additional labels can be added to the output text through this interface. Some sources provide multiple options for formatting the text. Once the interface settings are accepted, the green light on the display link will start blinking, indicating transmission of information to the display blocks."
	]
	quest.7963F38C16178404.quest_subtitle: "Instant Item Pickup to Backpack"
	quest.79BAF6151EA52530.quest_desc: ["We can build new tools whenever we reach a new &2seed&f tier in &dMystical&f, always getting stronger!"]
	quest.79BAF6151EA52530.quest_subtitle: "New Tools"
	quest.79BAF6151EA52530.title: "Supremium Tools"
	quest.79DD3D0D1F8A1E4F.quest_desc: [
		"This creature is really strange and it hits every single one of my worst phobias..."
		""
		"They are centipedes, but they are &eneutral&f... I think it is &abetter&f to leave them in peace..."
	]
	quest.79DD3D0D1F8A1E4F.quest_subtitle: "A Caterpillar?"
	quest.79E5D914406BC0DB.quest_desc: ["Like a &6phoenix&f, this &cbow&f does not rise from the ashes, but it is a beautiful bow."]
	quest.79E5D914406BC0DB.quest_subtitle: "&bAether&f"
	quest.7A03E0EFB34A8676.quest_subtitle: "Item Filter"
	quest.7A2CBBD8F4D0EA8C.quest_desc: ["Okay, &1moon&f was an exaggeration, that's for later (contains spoilers)."]
	quest.7A2CBBD8F4D0EA8C.quest_subtitle: "Stepping on the &1Moon&f..."
	quest.7A39B7C7B0EEBF4F.quest_desc: ["A crystallized &eenergy&f core infused with Fluix essence. It serves as a key crafting material for advanced &9network&f components, storage devices, and wireless systems."]
	quest.7A39B7C7B0EEBF4F.quest_subtitle: "&5Ender&f Pearl"
	quest.7A44F8B9B4CB916C.quest_desc: ["This ghost &7armor&f has a small chance to drop in chests!"]
	quest.7A44F8B9B4CB916C.quest_subtitle: "A Different &7Armor&f"
	quest.7A7EAF55F70DEAC7.quest_desc: ["This little fish is tiny and cute <3"]
	quest.7A7EAF55F70DEAC7.quest_subtitle: "Small"
	quest.7AA7094E591A373B.quest_desc: ["A gearbox with all 4 sides spinning in the same direction."]
	quest.7AE502EDB73BD57A.quest_desc: [
		"The Crusher crushes, among other things, clumps into Dirty Dusts, &7Ingots&f into dusts and Biomatter into Bio Fuel."
		""
		"By default, it consumes 50 J/t and processes one item every 10 seconds."
	]
	quest.7AE502EDB73BD57A.quest_subtitle: "&7Dust&f"
	quest.7AFC10AD67CA30B1.quest_desc: ["Well, maybe a bit of &6gold&f isn't bad at all... it will be heavily used across various mods! Always good to have plenty."]
	quest.7AFC10AD67CA30B1.quest_subtitle: "Run &6Gold&f"
	quest.7AFC10AD67CA30B1.title: "&6Gold&f"
	quest.7B09D79CAEA9E70F.quest_desc: ["Maybe a backpack is always the best option to store items... we can also use its &aupgrades&f... I'll introduce two, the rest you &alearn&f yourself... I'm not your dad either... next you'll want spoon feeding."]
	quest.7B09D79CAEA9E70F.quest_subtitle: "Getting Prepared"
	quest.7B1629DFEA300ADA.quest_desc: [
		"This sanctuary looks like a labyrinth... walk through the rooms until finding white &2essence&f."
		""
		"However, you will have to fight several VERY strong &4bosses&f! Good luck."
	]
	quest.7B1629DFEA300ADA.quest_subtitle: "Cosmic Powers"
	quest.7B35D7E2D252C29D.quest_subtitle: "Efficiency"
	quest.7B5DF264A026BBD0.quest_desc: ["The Adjustable Chain Gearshift functions similarly to Encased Chain Drive, but can change the &aspeed&f of the output when powered with &credstone&f."]
	quest.7BD19A68C0BF95D8.quest_desc: [
		"Finding Her Majesty"
		""
		"A massive bee, truly giant! She is the mother of all bees and she is docile."
		""
		"The Queen Bee is very demanding and will ask you for an item as a challenge; completing her challenge earns a &ereward&f."
		""
		"Furthermore, the queen loves trades; trade with her (use JEI)."
		""
		"Obtain a bee &2essence&f: to get it you must complete all 16 quests."
		""
		""
		""
		"{entity:the_bumblezone:bee_queen ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:FORCE_OFF idle:USE_GLOBAL walk:USE_GLOBAL width:50 height:50 align:center}"
	]
	quest.7BD19A68C0BF95D8.quest_subtitle: "Finding the Queen"
	quest.7BD19A68C0BF95D8.title: "The Queen's Desire"
	quest.7BDA041ACC80BAB1.quest_desc: [
		"Relax, we've all made a &7cobblestone&f generator and turned it into obsidian, but now it's good to have obsidian, grab some to make a &5portal&f, or if you're a hardcore speedrunner, buckets work too... but that's another tutorial."
		""
		"Wait... do I need to mention that you need flint and steel to ignite the portal? That would be too much..."
	]
	quest.7BDA041ACC80BAB1.quest_subtitle: "Lava + &3Water&f = Cobblestone?"
	quest.7BDA041ACC80BAB1.title: "&8Obsidian&f"
	quest.7BFFA2C42025651A.quest_desc: ["With the drops from this new world, we can build armor &abetter&f than &8netherite&f! Incredible, right?"]
	quest.7BFFA2C42025651A.quest_subtitle: "Special &7Armor&f"
	quest.7BFFA2C42025651A.title: "Warden &7Armor&f"
	quest.7C074B5E2A0EAA63.quest_desc: [
		"To assemble a Train, the train must have at least one set of controls that face forward relative to the Train Station the train is created at. If a non-player conductor is desired, a &6Blaze&f Burner or Seat must be placed directly behind the controls."
		""
		"On a Train, Train Controls can be right clicked to take control of the Train. The player's ordinary movement options will affect the Train instead. Use the controls again or sneak to stop. Hold left or right at a fork to choose a path. Use the scroll wheel to adjust maximum &aspeed&f. Hold jump to approach and align at a Station. If a Steam Whistle is attached, press the sprint key to blow it."
	]
	quest.7C18F1DF6262561A.quest_desc: ["In this place the creatures can infect you with a new effect called \"&5Utherium&f\". This effect can only be applied by Rot mobs and it builds up in doses. If you take too much of it, you may no longer be able to heal on your own, and then you will need rogdorium, which you find deep in the &8Dreadrock&f biome. You can eat it or add it to your armor, and with that you can become immune!"]
	quest.7C18F1DF6262561A.quest_subtitle: "Cleaning Yourself Up"
	quest.7C1E0999767D2453.quest_subtitle: "Level 10"
	quest.7C91F7477216A2D2.quest_desc: ["We need to be &ccareful&f with the weight we have on our car; heavy blocks can unbalance the car's weight."]
	quest.7C91F7477216A2D2.quest_subtitle: "Controlling weight"
	quest.7CC49360D07086B8.quest_desc: [
		"The Quantum Entangloporter from &9Mekanism&f is a machine that allows &3liquids&f/items/energy/gas to be sent from one Quantum Entangloporter to another through a channel."
		""
		"Capacity"
		"&eEnergy&f: 102.4 MFE"
		""
		"Liquid: 256000 mB"
		""
		"Gas: 8192000 mB"
		""
		"Heat: Infinite"
		""
		"Item: Items are transferred only when there are connected paths for them to go. The maximum transfer rate is 128 items per second, but idle entangloporters may take a bit to reach this maximum &aspeed&f."
	]
	quest.7CC49360D07086B8.quest_subtitle: "Wireless Power, Gases, &3Fluids&f, Everything."
	quest.7CD3468178DB684E.quest_desc: ["{ftb\tquests.chapter.mystical_agriculture.quest7CD3468178DB684E.description1}"]
	quest.7CD3468178DB684E.quest_subtitle: "{ftb\tquests.chapter.mystical_agriculture.quest7CD3468178DB684E.subtitle}"
	quest.7CD3468178DB684E.title: "{ftb\tquests.chapter.mystical_agriculture.quest7CD3468178DB684E.title}"
	quest.7D0B52744FE086B6.quest_desc: ["The Alchemist Cauldron will be used for various functions, including collecting creature blood or burning old scrolls in &3water&f... yes, in water!"]
	quest.7D0B52744FE086B6.quest_subtitle: "Witchcraft"
	quest.7D38B44607C3B33C.quest_desc: [
		"Ignis is the final &4boss&f of Cataclysm."
		""
		"Ignis does not spawn naturally and requires the player to summon him using Burning Ashes at the Flame Altar in the center of the Burning Arena."
		""
		"As Ignis' health decreases, the chance of destroying nearby blocks in a large radius increases, causing unwary players to fall into &6lava&f beneath the arena floor."
		""
		"This only occurs if gamerule mobGriefing is true and affected blocks are whitelisted in config."
		""
		"Ignis' &cattack&f &cdamage&f scales with player max health, making the fight harder with mods increasing max HP."
		"{entity:cataclysm:ignis ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:FORCE_OFF idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.7D38B44607C3B33C.quest_subtitle: "End &4Boss&f"
	quest.7D59DED35B53BD65.quest_desc: ["In &1Deeper and Darker&f we can also make this beautiful &7armor&f!"]
	quest.7D59DED35B53BD65.quest_subtitle: "In the Depths of &1Deeper and Darker&f"
	quest.7D59DED35B53BD65.title: "Resonarium &7Armor&f"
	quest.7DCA730FD75A6605.quest_desc: ["With this &2essence&f in your off-hand, all aggressive mobs become passive. Of course you cannot &cattack&f them without breaking the essence effect."]
	quest.7DCA730FD75A6605.quest_subtitle: "Relaxing"
	quest.7E3116DDD7CB8C59.quest_desc: ["The Fortune &aUpgrade&f applies luck levels when breaking blocks. Level depends on upgrade tier."]
	quest.7E38ACDAC8ACD079.quest_desc: [
		"The &dME Storage Monitor&r is a simple way to see the current level of a specified item."
		""
		"There are several interactions to modify it:"
		""
		"&bRight-click&r with &aItem&r will &ndisplay&r the current stored amount of that item if not locked"
		""
		"&bRight-click&r with &7Empty Hand&r will reset the display if &nnot&r locked"
		""
		"&bShift+Right-click&r with &7Empty Hand&r will toggle the &nlock&r"
		""
		"&bRight-click&r with &eWrench&r will &nrotate&r the monitor if it is locked and on the ground or ceiling."
	]
	quest.7EA6B942D1294ED6.quest_desc: [
		"The &9Digital Miner&r can be configured to mine ores only within a certain area. The &9Digital Miner&r can also be set to &nsilk touch&r ores, but this results in higher power consumption."
		""
		"Like all other &7Mekanism&r machines, the &9Digital Miner&r can automatically remove ores from its &einventory&r for automated processing by other machines."
		""
		"This machine &ncan mine for you&r!"
		""
		"It is completely configurable, and can even replace mined blocks with &7cobblestone&f, or whatever block you provide it with!"
	]
	quest.7EB1BE897B2B8C1A.quest_desc: ["A &9mechanical&f component that redirects rotational force vertically while keeping the same rotational direction. Perfect for compact contraptions where space is limited and precise gear alignment is essential."]
	quest.7EE37ABD9F8B873D.quest_desc: [
		"Pattern providers are the primary way in which your autocrafting system interacts with the world. They push the ingredients in their patterns to adjacent inventories, and items can be inserted into them in order to insert them into the &9network&f. Often a channel can be saved by piping the output of a &9machine&f back into a nearby pattern provider (often the one that pushed the ingredients) instead of using an ME Import Bus to pull the output of the machine into the network."
		""
		"Of note, since they push the ingredients directly from the crafting storage in a crafting CPU, they never actually contain the ingredients in their inventory, so you cannot pipe out from them. You have to have the provider push to another inventory (like a barrel) then pipe from that."
		""
		"{@pagebreak}"
		"Also of note, the provider has to push ALL of the ingredients at once, it can't push half-batches. This is useful to exploit."
		""
		"Pattern providers have a special interaction with interfaces on subnets: if the interface is unmodified (nothing in the re\tquest slots) the provider will skip the interface entirely and push directly to that subnet's storage, skipping the interface and not filling it with recipe batches, and more importantly, not inserting the next batch until there's space in the machine. This works correctly with blocking mode, the provider will monitor the slots in the machine for ingredients, instead of the slots in the interface."
	]
	quest.7F2F92524DD73C43.quest_desc: ["How about killing a &4boss&f just to make a &2hoe&f?"]
	quest.7F2F92524DD73C43.quest_subtitle: "&2Naga&f"
	quest.7F38E9C6DA5B99EA.quest_desc: ["The &4Flamethrower&r is a ranged weapon which uses &3Hydrogen&r gas as its fuel."]
	quest.7F3960375C5F4046.quest_subtitle: "Silk Touch"
	quest.7F5D32DA7E8D094F.quest_desc: ["{ \"text\": \"Click Me!\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"35639D4A6DDF6FF9\" } }"]
	quest.7F783DD7214B96B2.quest_desc: [
		"The Energy Acceptor converts energy from external systems (e.g., &cRedstone&f Flux RF) into AE and stores it in the &9network&f."
		""
		"Conversion Rate: 2 FE/RF = 1 AE"
		""
		"To see the current &eenergy&f statistics for your network, right-click any part of it with a Network Tool."
	]
	quest.7F9984CFCD2A1C3B.quest_subtitle: "Spoon Feeding"
	quest.7FAA4D4796F470A4.quest_desc: [
		"Stores up to 1,000,000 AE."
		""
		"They do not accept &epower&f directly but are used to add additional power storage to an already existing ME &9Network&f."
	]
	quest.7FAC515C08F1A9B8.quest_desc: [
		"The &6Sun&f God wants to know who we are... and what is causing this disturbance in the &bAether&f, watch out!"
		""
		"Talk to him and he will ask if we really want to fight... and yes, we do!"
		""
		"But watch out! Normal attacks don't work against the Sun God. We need to dodge his strikes and hit air balls to deflect them back at him."
		""
		"After a hit, he will cool down, allowing us to &cattack&f!"
		""
		"{entity:aether:sun_spirit ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:FORCE_ON idle:FORCE_OFF walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.7FAC515C08F1A9B8.quest_subtitle: "Something is Burning..."
	quest.7FB0BABF99C78B45.quest_desc: [
		"{ftb\tquests.chapter.mystical_agriculture.quest7FB0BABF99C78B45.description1}"
		""
		"{ftb\tquests.chapter.mystical_agriculture.quest7FB0BABF99C78B45.description2}"
	]
	quest.7FB0BABF99C78B45.title: "{ftb\tquests.chapter.mystical_agriculture.quest7FB0BABF99C78B45.title}"
	quest.7FFC16C92B75F5D1.quest_subtitle: "Level 10"
	reward_table.184FE60F4D2FA097.title: "&2food&f"
	reward_table.45E90332EE658BA9.title: "&9Technology&f"
