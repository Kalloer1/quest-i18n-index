	quest.28586493542A3B3A.title: "{ftb\tquests.chapter.mystical_agriculture.quest28586493542A3B3A.title}"
	quest.288C06FAA3B8C3B9.quest_desc: ["Inside our modpack we can discover several new &cweapons&f, both melee and ranged!"]
	quest.288C06FAA3B8C3B9.quest_subtitle: "New &cWeapons&f"
	quest.288C06FAA3B8C3B9.title: "&cWeapons&f"
	quest.28ADF1DEAAB6C852.quest_subtitle: "Find Mining"
	quest.292B68852CC24D30.quest_desc: ["We can build new tools whenever we reach a new &2seed&f tier in &dMystical&f, always getting stronger!"]
	quest.292B68852CC24D30.quest_subtitle: "New Tools"
	quest.292B68852CC24D30.title: "Inferium Tools"
	quest.29600A0988EF997C.quest_desc: [
		"To start in &5Occultism&f, we need to break some grass until a &2seed&f drops; it's the beginning of everything."
		""
		"We need to plant it and harvest its fruit, which is extremely important!"
	]
	quest.29600A0988EF997C.quest_subtitle: "Getting Started!"
	quest.29BEE3FF3C832D95.quest_desc: [
		"Inside the &2Dark Forest&f itself we can find the &5Dark Tower&f."
		""
		"Enter the tower, face the puzzles and &cdangerous&f paths to the top."
		""
		"To face the Ur-Ghast, it's best to bring ranged weapons. Additionally, there are 4 traps charged by deaths of &cGhastlings&f, and you can activate the traps with redstone to deal massive damage to the Ur-Ghast."
		""
		""
		"{entity:twilightforest:ur_ghast ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:FORCE_OFF idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.29BEE3FF3C832D95.quest_subtitle: "An Undead Ghast"
	quest.29C451D97A47A48C.quest_desc: ["{ftb\tquests.chapter.mystical_agriculture.quest29C451D97A47A48C.description1}"]
	quest.29C451D97A47A48C.title: "{ftb\tquests.chapter.mystical_agriculture.quest29C451D97A47A48C.title}"
	quest.29E9A9148148D7B1.quest_desc: ["The &6Muncher&f has a huge mouth and its drops are way &abetter&f than the others."]
	quest.29E9A9148148D7B1.quest_subtitle: "Big Mouth"
	quest.2A04882BD97D2D7B.quest_desc: ["Every beginning is a beginning! We need to start with the basics and collecting stones is included."]
	quest.2A04882BD97D2D7B.quest_subtitle: "Our First Stones"
	quest.2A04882BD97D2D7B.title: "&7Cobblestone&f"
	quest.2A1D8F1C7042753D.quest_desc: [
		"&eHello friend&f, welcome to &cAll Ultimate Selection&f"
		""
		"Here I have the pleasure of teaching you a little bit of everything, rest assured, even if things seem &cDifficult&f, they really are... however for everything there is a way and &aWe Are Going to Learn&f!"
	]
	quest.2A1D8F1C7042753D.quest_subtitle: "Welcome"
	quest.2A404708E175235F.quest_desc: [
		"&3Fluids&f can be stored and extracted from fluid tanks via Fluid Pipe. The fluid pipes can be placed on any face of the fluid tank: top, bottom, or sides. The window of a tank can be toggled with a &aWrench&f."
		""
		"The direction of flow in the fluid pipe indicates whether fluids will be put into the tank or extracted from the tank; if fluid is flowing towards the tank, the fluid will be stored in the tank. Likewise, if a fluid pipe is flowing away from the tank (via Mechanical Pump), then fluid from the tank will be extracted into that pipe."
	]
	quest.2A4929CD0A5C3CC0.quest_desc: ["Dropped by the last boss of &5Twilight&f, this &cbow&f is not only beautiful but also very powerful!"]
	quest.2A4929CD0A5C3CC0.quest_subtitle: "3 In 1"
	quest.2A4F001CF2097C28.quest_desc: ["&dMystical&f &7armor&f starter tiers might not be the best, but the final tiers are probably top tier!"]
	quest.2A4F001CF2097C28.quest_subtitle: "Great Equipment!"
	quest.2A4F001CF2097C28.title: "Awakened &7Armor&f"
	quest.2AD9A9806511DD0A.quest_subtitle: "Cables and Cables"
	quest.2AD9ADC19C29F44B.quest_desc: ["Sometimes it's good to get a bit stronger and gain some XP."]
	quest.2AD9ADC19C29F44B.quest_subtitle: "Getting stronger"
	quest.2ADDA74C73C08DB2.quest_desc: ["A gearbox where the rotation direction of all 4 sides are independently configurable."]
	quest.2AF85A5EE9A8CCBA.quest_desc: ["A clutch that is only coupled if the input RPM is &afaster&f than a configurable threshold."]
	quest.2B69F28B098EFFAB.quest_desc: [
		"Reappearing blocks are awesome decoration; clicking them makes them reappear after some time."
		""
		"While Vanishing Blocks disappear forever when clicked!"
	]
	quest.2B69F28B098EFFAB.quest_subtitle: "Stylish Blocks"
	quest.2B7AC4627A121BD8.quest_subtitle: "&6Gold&f upgrade"
