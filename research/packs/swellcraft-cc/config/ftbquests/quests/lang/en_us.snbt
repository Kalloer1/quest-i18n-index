	quest.3B5581B52C28782D.quest_desc: [
		"To get started in create you need to craft some andesite alloy."
		""
		"To craft andesite alloy you will need to gather atleast 2 andesite and 2 iron nuggets. once those have been aqcuired place them in a crafting table in a checker pattern with the nuggets starting in the top left corner of the 2x2 pattern. (zinc nuggets also work for crafting andesite alloy in place of the iron nuggets)"
	]
	quest.3B5581B52C28782D.quest_subtitle: "Craft some Andesite Alloy"
	quest.3B5581B52C28782D.title: "Getting Started with Create!"
	quest.3E69ED458CAD8398.quest_desc: ["Crafting shafts is as simple as taking 2 andesite alloy and placing them one on top of the other in a crafting grid. As you craft a single time for shafts you will receive 8 in return."]
	quest.3E69ED458CAD8398.quest_subtitle: "Craft Shafts"
