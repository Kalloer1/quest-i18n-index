{
	file.0000000000000001.title: "Tempest Origins"
	chapter_group.09DB374D2FA95CDE.title: "Field Guide"
	chapter.0404E15126E50C27.title: "Learning Your Skills"
	quest.445BDEE4CCDD8CAF.title: "Open Your Skills"
	quest.445BDEE4CCDD8CAF.quest_desc: [
		"Every journey begins with what you already know. Open the TenSura Status Menu and look over your current abilities."
		"[\"Your current Status Menu key: \" , { \"keybind\": \"tensura.keybinding.main_gui\", \"color\": \"aqua\" }, \".\"]"
		"If that key is unbound or conflicts with another action, change Status Menu under Controls > TenSura:Reincarnated. Mark this complete once you have found the screen."
	]
	quest.4CE46ADBD5181896.title: "Read a Skill"
	quest.4CE46ADBD5181896.quest_desc: [
		"Choose one of your skills and read its built-in description or wiki entry. Pay attention to what it does and whether it has a special input."
		"The wiki covers individual abilities in detail. This field guide will help you put them to use."
	]
	quest.0D060572701EE21E.title: "Equip a Skill"
	quest.0D060572701EE21E.quest_desc: [
		"A skill in your collection is not necessarily ready to cast. Put one you own into an active ability slot."
		"If the equip action is hard to find, inspect the skill screen and TenSura controls. Mark this complete when an ability is ready in a slot."
	]
	quest.0D2D9C511D47E110.title: "Cast Once"
	quest.0D2D9C511D47E110.quest_desc: [
		"Try your equipped ability somewhere safe. Notice its Magicule cost, cooldown, and whether it needs a target or another input."
		"[\"Ability slots: \", {\"keybind\":\"tensura.keybinding.ability.slot_1\",\"color\":\"aqua\"}, \" / \", {\"keybind\":\"tensura.keybinding.ability.slot_2\",\"color\":\"aqua\"}, \" / \", {\"keybind\":\"tensura.keybinding.ability.slot_3\",\"color\":\"aqua\"}, \".\"]"
		"Consult its wiki entry if nothing happens. A successful cast completes this lesson; no fight is required."
	]
	quest.74E86E6E0E335BCB.title: "Use a Preset"
	quest.74E86E6E0E335BCB.quest_desc: [
		"A good loadout saves time when trouble finds you. Explore the preset controls, save a setup, then switch away and back if you have enough skills."
		"If your skill list is still short, come back when a second loadout would help."
	]
	quest.0871FCC05F33A981.title: "Change Mode"
	quest.0871FCC05F33A981.quest_desc: [
		"Some abilities have more than one mode. If you own one, read its entry, change modes, and observe the difference."
		"[\"Mode controls: Next \", {\"keybind\":\"tensura.keybinding.next_mode\",\"color\":\"aqua\"}, \"; Previous \", {\"keybind\":\"tensura.keybinding.previous_mode\",\"color\":\"aqua\"}, \".\"]"
		"If none of your abilities has modes yet, this can wait."
	]
	quest.24C5283D53368424.title: "Toggle On and Off"
	quest.24C5283D53368424.quest_desc: [
		"If you own a toggleable ability, turn it on, watch its effect, then turn it off. Some active skills continue to consume resources."
		"Pay attention to lingering resource drain before heading into a fight."
	]
	quest.600A0B858ACBA29F.title: "Hold and Release"
	quest.600A0B858ACBA29F.quest_desc: [
		"Some abilities need time to charge or channel. If you own one, follow its entry: hold the input, then release at the right moment."
		"Practice somewhere safe before depending on it in a fight."
	]
	quest.2017D68B8E06A8E9.title: "Analytical Appraisal"
	quest.2017D68B8E06A8E9.quest_desc: [
		"Basic appraisal is available even without the Great Sage skill. Practice it on a safe target."
		"[\"Toggle Assess mode: \", {\"keybind\":\"key.greatsage.assess\",\"color\":\"aqua\"}, \". Aim at a safe target and hold Scan: \", {\"keybind\":\"key.greatsage.scan\",\"color\":\"aqua\"}, \" until the analysis completes.\"]"
		"If either binding is unbound or conflicts with another action, choose a free key under Controls > Great Sage. Read the result to finish the lesson."
		"[\"Other Great Sage controls: Menu \", {\"keybind\":\"key.greatsage.menu\",\"color\":\"aqua\"}, \"; Speak \", {\"keybind\":\"key.greatsage.voice\",\"color\":\"aqua\"}, \"; Stop (panic) \", {\"keybind\":\"key.greatsage.panic\",\"color\":\"aqua\"}, \".\"]"
		"Battle mode and direct conversation require the Great Sage skill."
	]
	chapter.3E490E6C3B769D1E.title: "First Day in a Strange World"
	quest.24EFCAA9E17E21B1.title: "Survey Your Surroundings"
	quest.24EFCAA9E17E21B1.quest_desc: [
		"Before choosing a direction, put names to the world around you. Aim at a block or creature and read Jade's label."
		"Check the minimap for a safe route. Mark this lesson complete when you know where you are heading."
	]
	quest.7C20A679472A1312.title: "Look Up a Recipe"
	quest.7C20A679472A1312.quest_desc: [
		"A good expedition starts with a plan. Search your inventory's recipe viewer for a tool you want, then follow its ingredients back to something you can make today."
		"JEI and EMI are both available. Use whichever viewer you prefer, then mark the lesson complete."
	]
	quest.42E5E36DC092DE52.title: "Make a Workbench"
	quest.42E5E36DC092DE52.quest_desc: [
		"Craft a workbench and keep it in your inventory to complete this objective. One you made earlier will count too."
		"Now you can put that recipe search to work."
	]
	quest.0339AEEC2A662AA0.title: "Secure a Camp"
	quest.0339AEEC2A662AA0.quest_desc: [
		"The first night is easier with a place to retreat. Build a small shelter or find safety in an existing settlement."
		"Set a spawn point if your form allows it, and note where the camp is. Mark this complete when you have somewhere safe to return to."
	]
	quest.345F697FB5316CEB.title: "Feed Your Form"
	quest.345F697FB5316CEB.quest_desc: [
		"Pack food or another source of recovery that works for your form. A diet that suits one TenSura race may do nothing for another."
		"Farmer's Delight and Aquaculture open up more choices later. For now, find one dependable option and mark this lesson complete."
	]
	quest.3374744E6666CFC7.title: "Mark the Way Back"
	quest.3374744E6666CFC7.quest_desc: [
		"Put a waypoint on your shelter or another useful landmark in Xaero's map. Writing down the coordinates works too."
		"Walk a short distance and make sure you can find the way back. With a route home, you are ready to take Guild work."
	]
	quest.5E974EB9AD0129CB.title: "Carry What Matters"
	quest.5E974EB9AD0129CB.quest_desc: [
		"Tools, food, and loot compete for the same pockets. Look up a Sophisticated Backpack and decide whether its recipe fits your next trip."
		"You can make one now or come back later. This route is optional."
	]
	quest.020C83C1B32BA1EC.title: "A Waystone for Later"
	quest.020C83C1B32BA1EC.quest_desc: [
		"A Waystone can turn a distant outpost into a regular stop. If you find one, remember its location and consider how it fits your route."
		"There is no need to hunt for one on the first day. Keep exploring, and the route will come together."
	]
	quest.6FB288F9AF2F338E.title: "Prepare for a Setback"
	quest.6FB288F9AF2F338E.quest_desc: [
		"Learn how the Corpse mod handles your belongings after death, and keep a way home in mind before a risky journey."
		"No field demonstration is required. Mark this complete once you know how you would recover your gear."
	]
	chapter.774C4D7055E4F6B2.title: "Adventurer's Guild"
	quest.19376423F5EB6D7A.title: "Open the Guild"
	quest.19376423F5EB6D7A.quest_desc: [
		"[\"Open the Guild directly with \", {\"keybind\":\"key.tensura_all_the_adventure.open_guild\",\"color\":\"aqua\"}, \"; or open TenSura's Status Menu with \", {\"keybind\":\"tensura.keybinding.main_gui\",\"color\":\"aqua\"}, \" and select the crossed-swords icon.\"]"
		"Both routes lead to the same Guild screen. Visit the Board and Profile tabs, then mark this lesson complete. Change any unbound or conflicting key under Controls."
	]
	quest.0A0A9E8524FAE3D0.title: "Read Your Profile"
	quest.0A0A9E8524FAE3D0.quest_desc: [
		"The Guild keeps its own measure of your work. Open your Profile and find your Adventurer Rank, Adventure XP, and next promotion requirement."
		"Adventure XP is separate from TenSura EP. A full Guild bar opens a five-wave Rank Trial; promotion comes from winning that trial."
	]
	quest.6140B2F34BF6C9B1.title: "Read the Contract"
	quest.6140B2F34BF6C9B1.quest_desc: [
		"Read the fine print before you take Guild work: objective, realm, reward, time limit, and penalty all matter."
		"Choose an assignment your gear and surroundings can support. Supply, gathering, survey, and ordinary hunt contracts can all make good first jobs."
	]
	quest.442A0B4DD8ECC829.title: "Take an Assignment"
	quest.442A0B4DD8ECC829.quest_desc: [
		"Accept your choice on the Board and track it. The Guild HUD should show what remains to be done."
		"For supply work, deliver items through the active assignment. Surveys require the listed biome and realm; gathering asks for matching blocks in the listed realm."
	]
	quest.0E9F09EC16C496AA.title: "Your First Commission"
	quest.0E9F09EC16C496AA.quest_desc: [
		"Finish one Adventurer's Guild contract. The Guild records completed work, and this objective updates from that record."
		"A contract you finished before opening this chapter also counts. Check your Profile if you want to see your personal total."
	]
	quest.613DF46ED7781F09.title: "Visit the Guild Market"
	quest.613DF46ED7781F09.quest_desc: [
		"You have earned Guild Coins. Visit the Market and see what your current rank can buy."
		"Stock rotates, so save your coins for something that supports your next expedition. Mark this complete after inspecting the offers."
	]
	quest.3CD68F9EFB4C1AC7.title: "Earn Rank F"
	quest.3CD68F9EFB4C1AC7.quest_desc: [
		"When your Adventure XP bar fills, the Profile will offer a Rank Trial. Prepare for five waves and start the fight somewhere safe; stay within 64 blocks of the arena."
		"There is no rush. This optional objective completes when you reach Rank F."
	]
	quest.6661904CA2077A53.title: "Village Bounty Board"
	quest.6661904CA2077A53.quest_desc: [
		"Some villages post local work on Bountiful boards. When you find one, read a request and compare it with a Guild contract."
		"Village bounties are separate from Guild commissions. This optional route waits until you encounter a board."
	]
	quest.653831622719ECFB.title: "Travel as a Party"
	quest.653831622719ECFB.quest_desc: [
		"Traveling with friends? Open FTB Teams and decide how your party will share quest-book progress. Solo adventurers can simply inspect the team controls."
		"The Guild still records each player's rank and contracts separately. This branch is optional."
	]
	chapter.2E10592676FA7AE3.title: "Boss Fieldbook"
	quest.60D9E3D169CCD91F.title: "Choose Your Hunt"
	quest.60D9E3D169CCD91F.quest_desc: [
		"A boss hunt starts with a location, a route home, and a way to retreat. Use the dossiers below to scout lairs across TenSura and the other realms in this pack."
		"Each location record completes when you enter its structure. The fights are optional; you can learn where a boss lives long before you challenge it."
	]
	quest.17FE12B342B79CC5.title: "Charybdis Cave"
	quest.17FE12B342B79CC5.quest_desc: [
		"TenSura's Charybdis Cave can appear in temperate, dry, or cold regions. Search for the cave entrance and its dormant core; the beast is not simply waiting at the door."
		"Entering any Charybdis Cave completes this scouting record. Treat the core as a choice to face the boss, and prepare before using it."
	]
	quest.3F963D9371210348.title: "Wandering TenSura Foes"
	quest.3F963D9371210348.quest_desc: [
		"Not every TenSura boss waits in a dungeon. Orcs favor desert and badlands regions, while Otherworlders can appear across plains, savannas, deserts, badlands, and mountain country."
		"The Orc Disaster and the rare Ifrit/Shizue encounter belong to those roaming stories. Watch for signs and Guild leads; mark a sighting here without needing a kill."
	]
	quest.462B21B8206B3A64.title: "The Labyrinth Tree"
	quest.462B21B8206B3A64.quest_desc: [
		"Look for TenSura's Labyrinth Tree in the Ancient Forest. It is the entrance to TenSura's own labyrinth, not the maze beneath the Twilight Forest swamp."
		"Entering the tree structure records the find. Bring a route home before passing through its portal."
	]
	quest.3A4CFB037733F11D.title: "Into the Labyrinth"
	quest.3A4CFB037733F11D.quest_desc: [
		"Enter the labyrinth through the tree in the Ancient Forest. The dimension has its own dangers and its own exit to plan around."
		"TenSura's labyrinth advancement records this visit even if you discovered it before opening the Fieldbook."
	]
	quest.0B918D9D8AF99616.title: "The Elemental Colossus"
	quest.0B918D9D8AF99616.quest_desc: [
		"The Elemental Colossus waits inside TenSura's labyrinth, reached from the Ancient Forest. This is a boss hunt, not a requirement for entering the dimension."
		"Defeat it when you are ready. The kill task credits the fight automatically; a small field reward is separate from its normal drops."
	]
	quest.22DC6AFA97F1CC65.title: "The Orc Disaster"
	quest.22DC6AFA97F1CC65.quest_desc: [
		"The Orc Disaster belongs to TenSura's roaming threats rather than a fixed dungeon. Follow signs and Guild leads through the desert and badlands country."
		"This optional hunt completes only when the boss is defeated. Merely finding one is enough for the separate field note."
	]
	quest.47C5EA4FB868FA1C.title: "The Storm Beast"
	quest.47C5EA4FB868FA1C.quest_desc: [
		"The cave contains the route to Charybdis, but finding it is not the same as waking and surviving the beast."
		"Defeating Charybdis completes this optional kill task. Prepare the retreat before committing to the fight."
	]
	quest.67A43B2D03E78578.title: "Agera's Challenge"
	quest.67A43B2D03E78578.quest_desc: [
		"TR: Nightmare can replace a daemon spawn with Agera. This is a rare encounter, not a named ruin on the map."
		"The task records a victory over Agera; ordinary daemons do not count."
	]
	quest.12541C9549CBD87D.title: "Frey in Flight"
	quest.12541C9549CBD87D.quest_desc: [
		"TR: Nightmare can replace a phantom with Frey. Watch the sky, and do not assume a routine night encounter will stay routine."
		"Defeat Frey to complete this optional record. The reward is travel supplies, not another source of TenSura power."
	]
	quest.413240617369CA45.title: "Milim's Wrath"
	quest.413240617369CA45.quest_desc: [
		"TR: Nightmare's Milim Wrath can replace an Otherworlder spawn. She is distinct from the Princess Milim friendship or spar encounter you may meet near a settlement."
		"This optional task calls for a victory over the Wrath boss. Do not mistake an early meeting with Princess Milim for a command to fight."
	]
	quest.6C93E3D2FC9E1A91.title: "Rimuru: Ogre-Era Trial"
	quest.6C93E3D2FC9E1A91.quest_desc: [
		"Not Enough Bosses adds an early Rimuru encounter built for authored quest or server events. The current pack sets its natural replacement chance to zero."
		"This optional task remains dormant until a server or pack event makes the boss available; it does not imply a natural lair."
	]
	quest.5F29CF4C28510640.title: "Carrion: Beast King Trial"
	quest.5F29CF4C28510640.quest_desc: [
		"Not Enough Bosses includes Carrion, but the current pack does not spawn him naturally. Treat this as a future Guild or server event encounter."
		"If the event is enabled, defeating Carrion records the victory automatically. The Fieldbook does not assign him a false location."
	]
	quest.6A2FF75BB1624A47.title: "Luminous: Final Trial"
	quest.6A2FF75BB1624A47.quest_desc: [
		"Not Enough Bosses reserves Luminous Valentine as a very difficult fight. Her natural replacement chance is zero in the current pack."
		"Only a deliberate event or later pack configuration should make this optional trial available. The quest grants no extra power for an unavailable encounter."
	]
	quest.1C66120D94355A64.title: "Dragon Roosts"
	quest.1C66120D94355A64.quest_desc: [
		"Ice and Fire dragons make surface roosts. Fire roosts favor warm regions, ice roosts cold ones, and lightning roosts swamps, jungles, badlands, or savannas."
		"Scan the horizon before approaching. Enter any roost to record the site; fighting its dragon is a separate decision."
	]
	quest.115DC96AB2EBD292.title: "Dragon Caves"
	quest.115DC96AB2EBD292.quest_desc: [
		"Below the same climate regions, Ice and Fire generates underground dragon caves. Surface roosts and deep caves are different finds."
		"The cave itself completes this record. Bring a safe exit route before disturbing anything inside."
	]
	quest.5985E0E640FFA06D.title: "Hydra of the Swamp"
	quest.5985E0E640FFA06D.quest_desc: [
		"Search swamps and mangrove swamps for an Ice and Fire Hydra Cave. The structure is a surface landmark, despite its name."
		"Enter the cave to mark its location. Return with a plan for a multi-headed fight."
	]
	quest.26442969CA51C155.title: "The Gorgon's Temple"
	quest.26442969CA51C155.quest_desc: [
		"Ice and Fire places Gorgon Temples along beach biomes. A quiet shore can hide a dangerous interior."
		"The temple completes the scouting task. Prepare for petrification before challenging the Gorgon."
	]
	quest.487A4CE0181C37DE.title: "Naga Courtyard"
	quest.487A4CE0181C37DE.quest_desc: [
		"In the Twilight Forest, the Naga waits in a walled courtyard among the ordinary forest biomes and clearings."
		"Find and enter the courtyard first. The Naga is the usual opening fight of the Twilight progression."
	]
	quest.00EFA220311EB581.title: "The Lich Tower"
	quest.00EFA220311EB581.quest_desc: [
		"Twilight Lich Towers rise above the forest and clearings. Look for the tall tower after learning the Naga's route."
		"The Lich waits near the top. Entering the tower records the find, whether or not you are ready to climb it."
	]
	quest.386D1918285B4DA6.title: "The Swamp Labyrinth"
	quest.386D1918285B4DA6.quest_desc: [
		"The Minoshroom's Labyrinth lies under the Twilight Forest swamp. Search beneath the wet ground rather than on the skyline."
		"Enter the structure to record it. The maze and its inhabitants are part of the expedition, not just the boss room."
	]
	quest.222796AFD92E882F.title: "Hydra's Fire Swamp"
	quest.222796AFD92E882F.quest_desc: [
		"The Twilight Hydra's lair sits in the Fire Swamp. Follow the swamp progression before entering this hotter region."
		"Scouting the lair is enough for the dossier. Save the fight for a prepared return trip."
	]
	quest.5C3672EB7B822295.title: "Knight Stronghold"
	quest.5C3672EB7B822295.quest_desc: [
		"Knight Phantoms guard a stronghold below the Twilight Forest's Dark Forest. The entrance is easier to miss than the canopy above it."
		"Enter the stronghold to record its position. Keep a route out before exploring its chambers."
	]
	quest.479422248F66D1C8.title: "The Dark Tower"
	quest.479422248F66D1C8.quest_desc: [
		"The Ur-Ghast waits in the Dark Tower at the center of the Twilight Dark Forest."
		"Record the tower on your map before climbing. The dossier completes when you enter the structure."
	]
	quest.1A3462CBC24E80C7.title: "The Yeti's Cave"
	quest.1A3462CBC24E80C7.quest_desc: [
		"Search the Twilight Snowy Forest for the Yeti Cave and its Alpha Yeti."
		"Entering the cave records the location. Do not confuse the snowy forest with the glacier that holds the next palace."
	]
	quest.26E8A883A03C6BB7.title: "Aurora Palace"
	quest.26E8A883A03C6BB7.quest_desc: [
		"The Snow Queen rules the Aurora Palace in the Twilight glacier region. Look for the palace above the ice."
		"Enter the palace to complete this scouting record; its upper floors can wait until you are ready."
	]
	quest.444743229140D6B4.title: "Bronze Dungeon: Slider"
	quest.444743229140D6B4.quest_desc: [
		"Across the Aether islands, Bronze Dungeons hold the Slider. Search the Aether itself; these dungeons do not generate in the Overworld."
		"Enter a Bronze Dungeon to record the route. Explore its rooms before starting the boss fight."
	]
	quest.1BC08383263ECD38.title: "Silver Dungeon: Valkyrie Queen"
	quest.1BC08383263ECD38.quest_desc: [
		"Silver Dungeons in the Aether lead to the Valkyrie Queen. They are separate landmarks from Bronze Dungeons."
		"Entering one completes the location task. Speak to the Queen only when you are ready for her challenge."
	]
	quest.4C1D79EF1F683223.title: "Gold Dungeon: Sun Spirit"
	quest.4C1D79EF1F683223.quest_desc: [
		"Gold Dungeons in the Aether hold the Sun Spirit. Search the island landscape for this late Aether landmark."
		"Record the entrance first. The boss encounter can wait for another expedition."
	]
	quest.1882DC3A9AAC349A.title: "Soul Blacksmith"
	quest.1882DC3A9AAC349A.quest_desc: [
		"Cataclysm's Netherite Monstrosity is tied to the Soul Blacksmith in the Nether. Its Eye of Monstrous can help locate the structure."
		"Search Nether Wastes, soul sand valleys, and warped or crimson forests. Enter the forge to record it."
	]
	quest.05362EC005DD859E.title: "Burning Arena"
	quest.05362EC005DD859E.quest_desc: [
		"Ignis is summoned at Cataclysm's Burning Arena in the Nether Wastes. The Eye of Flame points toward this arena."
		"Enter the structure to mark its location. Keep the summoning step for a prepared fight."
	]
	quest.0B0C35AD74ED3454.title: "Cursed Pyramid"
	quest.0B0C35AD74ED3454.quest_desc: [
		"Cataclysm's Cursed Pyramid rises in deserts; the Eye of Desert can lead you there. Its Ancient Remnant is awakened through suspicious sand inside."
		"Record the pyramid on entry. Archaeology here can start far more than a dig."
	]
	quest.44A08E22F3615D72.title: "Ancient Factory"
	quest.44A08E22F3615D72.quest_desc: [
		"The Harbinger is found in Cataclysm's Ancient Factory, an underground structure. The Eye of Mech can guide the search."
		"Find a safe way down and enter the factory. Do not wake its machinery by accident."
	]
	quest.60FB89434A82E57A.title: "Sunken City"
	quest.60FB89434A82E57A.quest_desc: [
		"The Leviathan is tied to Cataclysm's Sunken City in deep-ocean biomes. The Eye of Abyss can locate it."
		"Bring a plan for underwater travel and retreat. Entering the city completes the scouting task."
	]
	quest.3EA5CC1FF4A4E7C7.title: "Frosted Prison"
	quest.3EA5CC1FF4A4E7C7.quest_desc: [
		"Maledictus waits in Cataclysm's Frosted Prison, generated in snowy plains. The Eye of Curse is its locator."
		"Mark the prison before descending into it. Entering the structure completes the dossier."
	]
	quest.77B3B3468D58C724.title: "Ruined Citadel"
	quest.77B3B3468D58C724.quest_desc: [
		"The Ender Guardian is linked to Cataclysm's Ruined Citadel in the End highlands and midlands. The Eye of Void can help find it."
		"Enter the citadel to record the site. Keep a secure return route through the End."
	]
	quest.552AE236FE9C0758.title: "Acropolis"
	quest.552AE236FE9C0758.quest_desc: [
		"Scylla's Acropolis generates above warm oceans in Cataclysm. The Eye of Storm can lead you toward it."
		"Plan both sea travel and a climb. Enter the Acropolis to complete this final scouting record."
	]
	chapter.114A722404E8BF79.title: "TenSura Growth"
	quest.125C03FFA676CF63.title: "A Measure of Yourself"
	quest.125C03FFA676CF63.quest_desc: [
		"Open TenSura's Status menu and compare your race, EP, magicule reserve, and current skills. These numbers describe different parts of your character."
		"Mark this lesson after you can find each one again. The status screen is your first reference when a new ability or evolution appears."
	]
	quest.23E64C6FA1650EA3.title: "Read Your Race"
	quest.23E64C6FA1650EA3.quest_desc: [
		"Find your race entry and read its strengths, restrictions, and possible next forms. The same training route will not fit every species."
		"Write down one condition you can work toward now. Human and monster characters may have very different choices."
	]
	quest.173D6788781CCE48.title: "Practice Before Power"
	quest.173D6788781CCE48.quest_desc: [
		"Choose one skill you already own. Equip it, test its active mode or toggle, and watch its cost before using it in danger."
		"A skill description explains that individual ability. This lesson is about using the controls and noticing what the skill actually spends."
	]
	quest.2952AEE69722481A.title: "Keep Your Reserve"
	quest.2952AEE69722481A.quest_desc: [
		"Magicules are not a free second health bar. Watch your reserve during a safe cast and allow it to recover before another test."
		"If your form suffers from an empty reserve or magicule poisoning, stop training and recover first. Mark this after you have seen the cost yourself."
	]
	quest.3F7FFE139EB53B8E.title: "Plan the Next Form"
	quest.3F7FFE139EB53B8E.quest_desc: [
		"Compare the evolution choices shown for your race with the EP, naming, and other conditions you can currently meet. Use TenSura's built-in wiki for the exact form."
		"Choose a direction, not a deadline. Mark this lesson when you know what your next step is and what it would cost."
	]
	quest.64FDFC5C5305D311.title: "Record Your Growth"
	quest.64FDFC5C5305D311.quest_desc: [
		"Return to the Status menu after a meaningful change: a new skill, a higher reserve, a naming event, or an evolution."
		"The book records your decision; TenSura remains the authority for your race and stats. Mark this when you have compared your old plan with your new options."
	]
	quest.2B1863A91B05A52F.title: "A Thousand EP"
	quest.2B1863A91B05A52F.quest_desc: [
		"A larger maximum EP pool opens more possibilities, but it does not replace learning your current abilities."
		"This optional milestone completes from TenSura's maximum EP value when it reaches 1,000. It is not required for the other chapters."
	]
	quest.298CD6DB5A1FC15A.title: "An Evolution of Your Own"
	quest.298CD6DB5A1FC15A.quest_desc: [
		"Follow a valid evolution route for your species, including one supplied by Origins or Cross Evolution if that is the path you chose."
		"After TenSura reports the new form, compare its traits with your old one and mark this record. No particular race is required."
	]
	quest.2332CCAEE3FABB91.title: "A Weapon That Grows"
	quest.2332CCAEE3FABB91.quest_desc: [
		"Gear Evolution gives equipment its own growth story. Inspect one eligible piece and learn what advances it before committing a favorite weapon."
		"Mark this after you have checked its progression in game. Your character's race evolution and your gear's evolution are separate systems."
	]
	quest.12713FDBD6BAFFC1.title: "Other Beginnings"
	quest.12713FDBD6BAFFC1.quest_desc: [
		"Origins and the installed race add-ons expand the set of playable starting forms. Look through the available entries and note one unfamiliar strength or limitation."
		"This is a reference lesson for your next character or a companion's build, not a request to restart this world."
	]
	quest.50AAAB9288225C11.title: "More Than One Teacher"
	quest.50AAAB9288225C11.quest_desc: [
		"More Skills, Magic Growth, and other TenSura add-ons add routes to abilities beyond your starting kit. Look up a skill you want and the condition that unlocks it."
		"Mark this when you have a concrete goal. Do not assume a skill can be obtained just because it appears in the list."
	]
	quest.30C24E7573EA0D76.title: "The Weight of a Name"
	quest.30C24E7573EA0D76.quest_desc: [
		"Naming can change another being's path and consume a serious share of your power. Read the target and cost before confirming a name."
		"Try it only when your reserve and circumstances are safe. The lesson completes once you understand the choice; no subordinate is required."
	]
	chapter.58DB0F7C0EC65E43.title: "Awakening and Responsibility"
	quest.50C136A0E8B20FA8.title: "Before the Threshold"
	quest.50C136A0E8B20FA8.quest_desc: [
		"Awakening is a late goal, not a first-night assignment. Study the relevant Status and wiki entries before you pursue a Demon Lord, Hero, or other route."
		"Check the required deeds and their consequences for your own form. This chapter leaves every route optional."
	]
	quest.0353CCDC49C5440A.title: "Choose the Ground"
	quest.0353CCDC49C5440A.quest_desc: [
		"If an awakening or trial may call enemies to you, scout the area first. Keep settlements, friends, and your return route in mind."
		"Mark this after choosing a safe location and a way to leave. Preparation counts even if you postpone the event."
	]
	quest.4ABABF9E679108BD.title: "Choose Your Legacy"
	quest.4ABABF9E679108BD.quest_desc: [
		"Compare the paths your character can actually pursue. A Demon Lord route, a Hero route, and a race-specific final form are not interchangeable achievements."
		"Write down one route that fits this character. The optional milestones below will record the result without forcing the others."
	]
	quest.4D794715440B1FB4.title: "Power Has Neighbors"
	quest.4D794715440B1FB4.quest_desc: [
		"A stronger character changes the risks around a colony or a party. Consider what you would change in your equipment, skill preset, and local Guild work after a major transformation."
		"Mark this once you have a practical plan, even if awakening is still far away. A stronger boss should not be your first test by default."
	]
	quest.12AC3210C4C2F58B.title: "Demon Lord Seed"
	quest.12AC3210C4C2F58B.quest_desc: [
		"This route records TenSura's Demon Lord Seed status when your character reaches it."
		"The task checks the mod's awakening state. It grants no awakening and does not require another player to follow the same path."
	]
	quest.6D76BF9A5D2E6784.title: "True Demon Lord"
	quest.6D76BF9A5D2E6784.quest_desc: [
		"Complete the Demon Lord route through TenSura's own requirements. Prepare the site and party before triggering any large event."
		"This optional task records the resulting status; the quest book does not create the ceremony or its rewards."
	]
	quest.26198F3F39604457.title: "Hero's Beginning"
	quest.26198F3F39604457.quest_desc: [
		"A Hero candidate follows a different story from a Demon Lord Seed. Read the exact conditions in your Status and wiki entries."
		"The task records Hero Egg status when TenSura recognizes it. Other routes remain open in the book."
	]
	quest.6CA87C2902024CCF.title: "The Hero's Oath"
	quest.6CA87C2902024CCF.quest_desc: [
		"Follow TenSura's Hero requirements to their conclusion and note how your abilities and obligations change."
		"The optional task checks the Hero status itself. No boss kill is invented here to stand in for an awakening."
	]
	chapter.53AEF4B4EFB4BCC5.title: "Ars Academy"
	quest.4515F7D0654689A8.title: "The Novice's Book"
	quest.4515F7D0654689A8.quest_desc: [
		"Start with a Novice Spell Book and read the Ars Nouveau guide that comes with it. The book is the tool; the guide explains the workshop."
		"Keep the spell book in your inventory to complete this lesson. Item tasks in this campaign do not consume what you bring."
	]
	quest.794D1DA95DDC5D69.title: "Find Source"
	quest.794D1DA95DDC5D69.quest_desc: [
		"Source is the academy's fuel. Look up a Source Gem and trace where you can obtain it in your world."
		"Obtain one gem to record your first material. You can return to larger Source production after learning a spell."
	]
	quest.3C195AFFBB447764.title: "Imbuement Chamber"
	quest.3C195AFFBB447764.quest_desc: [
		"The Imbuement Chamber turns early materials into magical components. Read its layout before setting up a permanent bench."
		"Bring a chamber to complete the objective, then place it where you can build around it."
	]
	quest.6D06DCCD67593ED9.title: "Write a Working Spell"
	quest.6D06DCCD67593ED9.quest_desc: [
		"Build a spell with a form and an effect you can test safely. Try it on a harmless target, then check its mana cost and range."
		"Mark this only after casting the spell yourself. A recipe for a spell book is not the same as using one."
	]
	quest.03378A958B29C3FE.title: "Enchanting Apparatus"
	quest.03378A958B29C3FE.quest_desc: [
		"The Enchanting Apparatus is the next workshop step. Read how pedestals and Source feed a recipe before committing expensive ingredients."
		"Obtain an apparatus to complete this station milestone. Its full setup can grow alongside your settlement."
	]
	quest.7D5FE8F0943F22B2.title: "A Source Supply"
	quest.7D5FE8F0943F22B2.quest_desc: [
		"An Agronomic Sourcelink turns nearby plant growth into Source. It suits a farming outpost better than a one-off experiment."
		"Bring one to record this optional supply route, then compare its output with your workshop's demand."
	]
	quest.74463D48BD275010.title: "Elemental Focus"
	quest.74463D48BD275010.quest_desc: [
		"Ars Elemental adds focused schools beyond the base spell book. Inspect a focus that matches the role you want: mobility, defense, damage, or support."
		"Test one elemental glyph or focus, then mark the lesson. Fire is shown as an example, not a required element."
	]
	quest.47E6D134686CE891.title: "Magic in the Workshop"
	quest.47E6D134686CE891.quest_desc: [
		"Ars Creo links spellcraft to Create machines. Ars Technica adds another set of technical glyphs and tools."
		"Choose one bridge to inspect and note a practical use for your base. This lesson does not require a full factory."
	]
	quest.38224E92B9E3DE01.title: "The Unusual Shelves"
	quest.38224E92B9E3DE01.quest_desc: [
		"Ars Ocultas adds stranger applications to Ars Nouveau. Read one of its entries and check any special cost before testing it."
		"Mark this research note after finding an ability you would actually use. The school is optional."
	]
	chapter.00CFF75B9F04F9E9.title: "Spellblade Studies"
	quest.474E3D71CA11CDA6.title: "A Book for Battle"
	quest.474E3D71CA11CDA6.quest_desc: [
		"Iron's Spells uses its own spellbooks, scrolls, mana, and schools. Start with a modest book rather than planning around a rare drop."
		"Bring a Copper Spell Book to begin. TenSura skills and Iron's spells use separate controls and progression."
	]
	quest.6E082ACDDF1DF696.title: "A Spell on Paper"
	quest.6E082ACDDF1DF696.quest_desc: [
		"Find or craft a spell scroll and read its school and level before using it. A scroll is a spell, not a permanent spellbook slot by itself."
		"Keep a scroll in your inventory to record the find. Its exact spell may vary from one expedition to the next."
	]
	quest.35E8B279AE0D693F.title: "A Controlled Cast"
	quest.35E8B279AE0D693F.quest_desc: [
		"Cast one Iron's spell against a safe target or on open ground. Watch the mana cost, cooldown, and any effect left behind."
		"Mark the lesson after a real cast. Practicing away from villagers is part of learning the range."
	]
	quest.2C9881C500F01FFD.title: "The Arcane Anvil"
	quest.2C9881C500F01FFD.quest_desc: [
		"The Arcane Anvil is where a spellblade begins to improve a book and its spells. Read the required materials before spending a rare scroll."
		"Bring an Arcane Anvil to complete the station objective. Upgrade only a spell you intend to keep using."
	]
	quest.66FBE9A2D4A15110.title: "Choose a School"
	quest.66FBE9A2D4A15110.quest_desc: [
		"Different schools solve different problems. Compare one offensive spell with a movement, healing, or utility choice that suits your race."
		"Build a loadout you can afford to cast twice. Mark the lesson when you can explain why those spells share a book."
	]
	quest.7CE847EB2543243E.title: "A Focused Upgrade"
	quest.7CE847EB2543243E.quest_desc: [
		"Upgrade Orbs can improve a spellbook's capabilities. Check the orb's effect before applying it to your best book."
		"This optional objective records a Mana Upgrade Orb; using it is your decision."
	]
	quest.602DDD643D757C24.title: "Spells Beyond the Forest"
	quest.602DDD643D757C24.quest_desc: [
		"Twilight Spellbooks extends Iron's spell choices with magic tied to the Twilight Forest. Compare one of its spells with your current school."
		"Mark this after reading and testing a new option. Entering the Twilight Forest is covered in Borders and Other Realms."
	]
	quest.2D2EB97A3396BFAF.title: "Two Kinds of Magic"
	quest.2D2EB97A3396BFAF.quest_desc: [
		"The TenSura and Iron's compatibility mod links some abilities, but it does not make every spell a TenSura skill."
		"Check one interaction in the installed guide or in game, then record what resource it spends. Keep the systems distinct in your loadout."
	]
	chapter.1F6BA8CC503A8745.title: "Spirits and Ecology"
	quest.1D8AC7A3D84CB645.title: "The Environmentalist's Book"
	quest.1D8AC7A3D84CB645.quest_desc: [
		"Nature's Aura treats the land as part of the machine. Read its book before placing a device that draws from the area."
		"Bring the book to complete this first lesson. Its pages are the reference for the exact structures you build."
	]
	quest.2F5E59FCEA1B35E1.title: "Read the Land"
	quest.2F5E59FCEA1B35E1.quest_desc: [
		"Walk through an untouched patch and a worked patch. Learn how Nature's Aura shows local balance before draining or restoring it."
		"Mark this when you can tell whether your chosen workshop site needs care. A strong base should not leave a dead landscape."
	]
	quest.28A65559044BCD93.title: "A Bottle of Aura"
	quest.28A65559044BCD93.quest_desc: [
		"An Aura Bottle makes an invisible resource tangible. Look up its creation and keep one for your first experiments."
		"Hold a bottle to complete the objective. Do not empty an area simply to fill a chest."
	]
	quest.687ECF8A7B71F746.title: "Build an Altar"
	quest.687ECF8A7B71F746.quest_desc: [
		"The Nature Altar turns fieldwork into useful materials. Check its layout, nearby aura, and ingredient requirements."
		"Bring an altar to record your first Nature's Aura station. Place it where the land can support it."
	]
	quest.262184992BC1D48C.title: "Give Something Back"
	quest.262184992BC1D48C.quest_desc: [
		"Choose one damaged or overworked patch near your base and plan a way to restore its aura or biodiversity."
		"Mark this after making a real improvement and checking the area again. The goal is a living workshop, not a decorative tree."
	]
	quest.29FA17F8B5A13043.title: "A Year Has Seasons"
	quest.29FA17F8B5A13043.quest_desc: [
		"Serene Seasons changes the rhythm of crops and travel. Note the current season and one task that would be easier now than later."
		"Keep a modest reserve for the next season. Mark this after making one practical adjustment."
	]
	quest.2CAA79F28A6FBDB4.title: "Gold in the Canopy"
	quest.2CAA79F28A6FBDB4.quest_desc: [
		"Gold Leaf is one of Nature's Aura's distinct materials. Use the book to find the right process rather than guessing from its name."
		"Obtain one leaf to record the technique. The item task does not consume it."
	]
	quest.7FD7565A74E46F29.title: "Another Kind of Spirit"
	quest.7FD7565A74E46F29.quest_desc: [
		"Malum studies spirits through soulwood, soulstone, and its own rites. Begin with the Encyclopedia Arcana before harvesting blindly."
		"Keep the encyclopedia to complete this optional introduction. Its spirit system is separate from Nature's Aura."
	]
	quest.305072FC20395353.title: "The Spirit Altar"
	quest.305072FC20395353.quest_desc: [
		"The Spirit Altar is a Malum station, not a Nature Altar upgrade. Read its ritual pages and choose a safe place to work."
		"Bring one altar to record the branch. The TenSura Nature's Aura bridge can be explored after both systems make sense."
	]
	quest.43F7F8ABCE1F26BF.title: "A Living Sigil"
	quest.43F7F8ABCE1F26BF.quest_desc: [
		"The pack's Chronicle route links MCA aid, Ars materials, Create brass, and a Nature's Aura altar. Its Living Spirit Sigil begins an optional TenSura fire-spirit trial."
		"Bring a Living Spirit Sigil to record the preparation. Read its in-game instructions before starting the Nether combat rite; this quest does not grant a spirit."
	]
	chapter.4DFD31CE272D0F70.title: "Occult Research"
	quest.4C17553A39C7A2FD.title: "The Dictionary of Spirits"
	quest.4C17553A39C7A2FD.quest_desc: [
		"Occultism begins with its Dictionary of Spirits. Read the entry for a first ritual before copying a circle from memory."
		"Bring the dictionary to complete the objective. Keep it close to the ritual site."
	]
	quest.33B9CEB939B5F6E2.title: "A Circle With a Purpose"
	quest.33B9CEB939B5F6E2.quest_desc: [
		"Chalk marks a ritual pattern, but the pattern and the spirit's conditions matter as much as the color."
		"Obtain white chalk, then read one complete ritual entry. Do not summon into a crowded village to test a theory."
	]
	quest.43622670690C4D4E.title: "Finding What Is Hidden"
	quest.43622670690C4D4E.quest_desc: [
		"The Divination Rod can make an unseen resource search deliberate. Read what it detects and where that target belongs."
		"Bring a rod to complete the lesson. A failed search is a clue about place or conditions, not a reason to dig at random."
	]
	quest.27C7B1D25508ECEB.title: "A Controlled Ritual"
	quest.27C7B1D25508ECEB.quest_desc: [
		"Prepare a small Occultism ritual with the complete pattern, required items, and a clear exit. Watch the process before moving on to larger summons."
		"Mark this only after a successful ritual. Keep the result and its upkeep in mind."
	]
	quest.0C1756517B0B7F48.title: "Containment Is Part of Research"
	quest.0C1756517B0B7F48.quest_desc: [
		"Mysticism and Occultism can both lead to powerful encounters. Decide where a dangerous experiment belongs before beginning it."
		"Mark this after making a boundary and escape plan. This lesson asks for caution, not a forced dark route."
	]
	quest.7AD9060B0B4DD8EA.title: "A Larger Catalogue"
	quest.7AD9060B0B4DD8EA.quest_desc: [
		"Occultism Extra Spirits and Occultism Jars widen the available rituals and storage options. Read one new entry and compare its cost with a basic ritual."
		"Record a use you would actually pursue; the addon catalogue is optional."
	]
	quest.51E517AC380824AB.title: "A Practical Contract"
	quest.51E517AC380824AB.quest_desc: [
		"Occult Engineering connects summoned labor to workshop needs. Look for one job a spirit could do more neatly than a large machine."
		"Mark the note after identifying a real input, output, and safe place for that work."
	]
	quest.79BA33AE47496DB9.title: "Mysticism Casefile"
	quest.79BA33AE47496DB9.quest_desc: [
		"Mysticism adds unusual forms and encounters to the TenSura world. Read a creature or race entry before following a rumor into its territory."
		"Mark this after scouting a site and deciding whether to return later. No particular transformation is required."
	]
	chapter.681A5884B2E35923.title: "Life in the Nations"
	quest.63DD26FD355C850E.title: "A Place With a Name"
	quest.63DD26FD355C850E.quest_desc: [
		"Find a village, colony, or inhabited town and learn its name. A nation begins with people, not with a line on a map."
		"Mark the settlement on Xaero's map and record one safe route back before checking this lesson."
	]
	quest.523CCDA636F6C895.title: "Meet the Neighbors"
	quest.523CCDA636F6C895.quest_desc: [
		"MCA villagers have relationships, routines, and histories. Speak with one resident and learn what they need from a visitor."
		"Mark this after a conversation. Friendship is earned over time; no relationship choice is required."
	]
	quest.348E821CAE769DF7.title: "Useful Work"
	quest.348E821CAE769DF7.quest_desc: [
		"Look for a practical local need: a Bountiful request, food delivery, safe road, or colony supply order."
		"Complete one small job you can verify in game, then mark this lesson. Guild contracts remain a separate record."
	]
	quest.141FBCA87E14FA29.title: "Trust Takes Time"
	quest.141FBCA87E14FA29.quest_desc: [
		"Read the settlement's response to your actions. MCA reputation, MCA Crime, and Guild rank are different systems in this build."
		"Mark this after checking the relevant screen. Do not treat a Guild promotion as proof a village trusts you."
	]
	quest.78081681E2718262.title: "A Town's Memory"
	quest.78081681E2718262.quest_desc: [
		"Ask around or inspect local records. Capitals, descendants, conversations, and quests make more sense when a place has a past."
		"Write down one person, event, or unresolved problem worth returning to, then mark the lesson."
	]
	quest.2A39F53EE9F58F94.title: "Where Will You Belong?"
	quest.2A39F53EE9F58F94.quest_desc: [
		"Choose whether this character will help an existing village, found a MineColonies settlement, or travel between communities."
		"Mark a first project that suits that choice. The other routes stay available as side work."
	]
	quest.23C344863D558BDC.title: "Found a Colony"
	quest.23C344863D558BDC.quest_desc: [
		"MineColonies starts with supplies and a plan for space. Check nearby terrain and claims before placing a Supply Camp."
		"Bring the camp deployer to record this optional founding route. Placing it is a separate decision."
	]
	quest.2EB94B6129FA95DB.title: "A Builder's First Site"
	quest.2EB94B6129FA95DB.quest_desc: [
		"A Builder's Hut turns a camp into a worksite. Read its material requests and leave room for roads and later homes."
		"Bring the hut block to complete this optional station objective. You can support another player's colony instead of founding your own."
	]
	quest.788C0F267859163E.title: "A Broader Map"
	quest.788C0F267859163E.quest_desc: [
		"Townstead, SmallColonies, and Towntalk add more civic texture than one village screen can show. Visit a settlement feature you have not used yet."
		"Record who benefits from it and mark the note. The systems can be explored without claiming the whole region."
	]
	quest.308F9B449ED28858.title: "Borders Between Friends"
	quest.308F9B449ED28858.quest_desc: [
		"Open Parties and Claims and FTB Chunks both appear in this pack. Inspect the party and claim screens before protecting a shared build."
		"Agree which system your group will use for that site, then mark the lesson. Avoid overlapping claims until protection has been tested."
	]
	quest.62D707B87C865345.title: "Law and Consequence"
	quest.62D707B87C865345.quest_desc: [
		"MCA Crime can create a separate legal response to your actions. Learn the local rules before testing them on a settlement you want to keep."
		"Mark this after reading the consequences. Crime is a story branch, not required progress."
	]
	quest.39F659FEE3F81890.title: "The Traveller's Chronicle"
	quest.39F659FEE3F81890.quest_desc: [
		"The pack's Traveller's Chronicle records a local MCA village story and its current supply request. Craft it from a book and compass, then use it near occupied homes."
		"Bring the Chronicle to unlock this optional route. Read its message before choosing whether to deliver supplies."
	]
	quest.054A10203C7C95C4.title: "A Letter of Thanks"
	quest.054A10203C7C95C4.quest_desc: [
		"Sneak-use the Chronicle with the requested supplies in your main inventory. The village records a completed delivery and gives you a Letter of Thanks."
		"Bring the letter to complete this optional deed. It also has a role in the pack's spirit-sigil recipe, so keep it if you want that route."
	]
	chapter.2EC73F2EE33B5761.title: "Tempest Workshops"
	quest.25B2A1389EA0CFB1.title: "A Moving Part"
	quest.25B2A1389EA0CFB1.quest_desc: [
		"A workshop needs a purpose before it needs a wall of shafts. Start with a Cogwheel and a small job you would like to automate."
		"Bring one cogwheel to record your first Create component. Keep the design compact until it works."
	]
	quest.30BF571635EA61F1.title: "Put Motion to Work"
	quest.30BF571635EA61F1.quest_desc: [
		"A Water Wheel turns a steady stream into rotational power. Check flow direction and the stress available to your first machine."
		"Bring a wheel to complete the task, then build where water and maintenance access make sense."
	]
	quest.384A3AAFC59A6223.title: "The Millstone"
	quest.384A3AAFC59A6223.quest_desc: [
		"A Millstone turns simple inputs into useful ingredients. Check one recipe that supports your next food or construction project."
		"Obtain a millstone to record the station. A working belt of machines can wait until this one has a job."
	]
	quest.666AF5134AE18A59.title: "The Mechanical Press"
	quest.666AF5134AE18A59.quest_desc: [
		"A Mechanical Press shapes materials without a spell. Trace its input, output, and required speed before connecting it."
		"Bring a press to complete the objective. Test it with a cheap recipe before feeding rare metal."
	]
	quest.5CBCEF02A2B59E04.title: "Move the Goods"
	quest.5CBCEF02A2B59E04.quest_desc: [
		"Belts make a workshop readable: ingredients enter here, finished goods leave there. Sketch the route before routing it through a colony street."
		"Bring a Belt Connector and build one clear material path. A small, reliable line is already useful."
	]
	quest.6C5E936E2547C14B.title: "A Working Shift"
	quest.6C5E936E2547C14B.quest_desc: [
		"Run your line from input to output, then inspect where it stops when supplies run out or the machine stalls."
		"Mark this after producing a useful item and fixing one bottleneck. That is the beginning of a real workshop."
	]
	quest.4112787E3A11E91A.title: "The Communal Kitchen"
	quest.4112787E3A11E91A.quest_desc: [
		"Create Central Kitchen can connect cooking with mechanical delivery. Plan one meal line for a village or expedition store."
		"Mark this after tracing the ingredients through the kitchen. Feeding people is a better first factory goal than raw output alone."
	]
	quest.3781C1047BFE983D.title: "Careful Enchantment"
	quest.3781C1047BFE983D.quest_desc: [
		"Create Enchantment Industry offers another use for moving parts. Read its process and choose an item worth improving."
		"Mark this after a safe test. Do not route every valuable item through an untested line."
	]
	quest.15DC2ACDBD124A41.title: "Spell and Shaft"
	quest.15DC2ACDBD124A41.quest_desc: [
		"Ars Creo can place magic beside mechanical work. Pick one step where a spell saves effort without hiding how the machine works."
		"Mark this after a practical test or a clear build plan. Magic and motion can share a workshop."
	]
	quest.596AD42C08904A35.title: "The Siege Option"
	quest.596AD42C08904A35.quest_desc: [
		"Create Big Cannons changes the scale and tone of conflict. Study its safety, ammunition, and target rules before building a firing range."
		"This route is optional. Mark it only if siege engineering belongs in your version of Tempest."
	]
	chapter.0C43DA24261F0D3B.title: "Food and Provisions"
	quest.47D6171F76CEF5ED.title: "A Cook's Kit"
	quest.47D6171F76CEF5ED.quest_desc: [
		"A long journey starts in the kitchen. A knife opens Farmer's Delight recipes that make better use of gathered ingredients."
		"Bring an Iron Knife, then look up a meal you can actually cook with supplies from your region."
	]
	quest.3F1606E75EEDEC31.title: "Build a Hearth"
	quest.3F1606E75EEDEC31.quest_desc: [
		"A Cooking Pot turns loose ingredients into meals for a party. Leave room for fuel, storage, and a place to eat."
		"Bring the pot to record the station. Set it up where the cook can reach both ingredients and travelers."
	]
	quest.50C322CC55D6B9B9.title: "Feed the Party"
	quest.50C322CC55D6B9B9.quest_desc: [
		"Prepare a meal that can be repeated from local crops or animals. Notice the difference between a single emergency ration and a reliable food supply."
		"Eat or share the finished meal, then mark this lesson. A settlement can be as fragile as its pantry."
	]
	quest.06EF41D19657016F.title: "From Water to Table"
	quest.06EF41D19657016F.quest_desc: [
		"Aquaculture makes fishing more than an occasional snack. Try a suitable rod or bait, and learn which waters supply useful fish."
		"Bring a raw Fish Fillet. Plan how to cook or preserve the catch before a long expedition."
	]
	quest.2C72131D3BC062BD.title: "Pack for the Road"
	quest.2C72131D3BC062BD.quest_desc: [
		"Set aside food, a spare tool, and a way home before leaving the settled roads. Sophisticated Backpacks can carry supplies, but cannot choose them for you."
		"Pack for a real trip, then mark this lesson. Check your load again after the first night away."
	]
	quest.2FB7F5E0A97A788F.title: "The Common Store"
	quest.2FB7F5E0A97A788F.quest_desc: [
		"Give a community store clear shelves for food, materials, and emergency gear. A shared chest is useful only when people can find what they need."
		"Set up or help maintain one labeled store and mark the field note. Keep rare quest items out of public overflow."
	]
	quest.7E41E7693A9FE9BB.title: "A Field That Lasts"
	quest.7E41E7693A9FE9BB.quest_desc: [
		"Grow a crop that fits the local season and your food plan. Serene Seasons can change when a field thrives."
		"Harvest and replant once, then mark the lesson. A farm is a cycle, not a single harvest."
	]
	quest.3B6A81473DBCBAD0.title: "Strange Seeds"
	quest.3B6A81473DBCBAD0.quest_desc: [
		"Mystical Agriculture offers a slower route from field work to unusual materials. Start with Inferium before planning rare essence production."
		"Bring one Inferium Essence to record this optional agricultural path."
	]
	quest.57DB451615E97ED3.title: "The Angler's Kit"
	quest.57DB451615E97ED3.quest_desc: [
		"A better rod can make a supply trip more deliberate. Compare Aquaculture gear with your usual fishing setup before committing resources."
		"Bring an Iron Fishing Rod to complete this optional equipment lesson."
	]
	chapter.0AF350979D5231A0.title: "Arcane Gear"
	quest.478F58F2DC207638.title: "Enchant with Intent"
	quest.478F58F2DC207638.quest_desc: [
		"Equipment matters when a stronger foe outlasts your first skill. Start with the ordinary Enchanting Table and a modest piece of gear."
		"Bring the table, then read the available enchantments before spending levels or rare materials."
	]
	quest.2B892EC797B9569F.title: "A Working Library"
	quest.2B892EC797B9569F.quest_desc: [
		"Apothic Enchanting changes what shelves contribute to a table. Position a Basic Bookshelf and inspect the enchanting screen again."
		"Bring one shelf to complete the task. Learn the actual ranges shown by your installed setup before expanding it."
	]
	quest.3EC505AB08DE0E6E.title: "The Greater Table"
	quest.3EC505AB08DE0E6E.quest_desc: [
		"The Apothic Enchanting Table opens more demanding equipment work. Build it only when you have enough levels and a reason to improve the result."
		"Bring the table and compare it with the ordinary station."
	]
	quest.02F5F221B3B1F7AF.title: "Read the Enchantment"
	quest.02F5F221B3B1F7AF.quest_desc: [
		"Apothic Enchanting exposes Eterna, Quanta, and Arcana. Check how your shelves affect the offer instead of assuming more is always better."
		"Choose one change you understand, make a safe test, and mark this lesson. The values on your screen are the authority."
	]
	quest.62F29A6FBF60395F.title: "Fit for the Job"
	quest.62F29A6FBF60395F.quest_desc: [
		"Prepare a tool, weapon, or armor piece for a specific threat. Pair its enchantments with the skills you actually use."
		"Take the finished gear into one encounter or expedition, then note what helped and what still needs work."
	]
	quest.19DDA90DDF380C88.title: "A Socketed Opportunity"
	quest.19DDA90DDF380C88.quest_desc: [
		"Apotheosis gems offer another path to specialized equipment. Inspect a gem's affix and the socket rules before using a valuable item."
		"Bring one gem to record this route. A good match matters more than filling every slot."
	]
	quest.7D81F16022C42BEA.title: "Reforge with Care"
	quest.7D81F16022C42BEA.quest_desc: [
		"A Simple Reforging Table can change the character of equipment. Learn the material and rarity costs first."
		"Bring the table to complete this optional workshop lesson. Keep a dependable spare while experimenting."
	]
	quest.7D080E2BD469A0FE.title: "An Artifact's Story"
	quest.7D080E2BD469A0FE.quest_desc: [
		"Ancient Artifacts and Curios add equipment choices outside ordinary armor slots. Inspect an artifact's description and the slot it needs."
		"Mark this after comparing it with your current kit. Finding the item is a separate adventure."
	]
	quest.42802FC4D803E99E.title: "Before the Hunt"
	quest.42802FC4D803E99E.quest_desc: [
		"Before following a Boss Fieldbook lead, check your route, resistances, escape supplies, and the cost of failure."
		"Mark this after preparing for a named encounter. Readiness is a better milestone than a premature kill."
	]
	chapter.0323F35742DDAB7F.title: "Borders and Other Realms"
	quest.0BDB2BDCCF7AEFEB.title: "Mark the Route"
	quest.0BDB2BDCCF7AEFEB.quest_desc: [
		"Every border looks different on a map. Mark your home, a safe return point, and the first distant place you mean to investigate."
		"Record the route before you travel. A waypoint is most useful when it still makes sense after a death or a long absence."
	]
	quest.5EE428F5EEB9C1AB.title: "Across the Nether"
	quest.5EE428F5EEB9C1AB.quest_desc: [
		"The Nether is a dangerous shortcut and a source of rare materials. Carry blocks, food, and a way to identify your return portal."
		"Entering the Nether completes this task. Decide how far to push only after you have secured the exit."
	]
	quest.1BFB435A71955168.title: "Return with a Report"
	quest.1BFB435A71955168.quest_desc: [
		"Bring something useful back from beyond the border: a resource, a route, or a warning. Tell the next traveler what changed."
		"Mark this after returning safely and recording one concrete finding. Exploration should improve the map for everyone."
	]
	quest.49E7D51810B7C698.title: "The Aether"
	quest.49E7D51810B7C698.quest_desc: [
		"The Aether asks for different movement and survival habits. Learn its entry route and carry a way to recover from a fall."
		"Entering the Aether completes this optional survey. Its creatures and dungeons can wait for a better-equipped visit."
	]
	quest.40C378499CCD5B3F.title: "The Twilight Forest"
	quest.40C378499CCD5B3F.quest_desc: [
		"The Twilight Forest has its own landmarks and boss progression. Explore the first safe area before pressing toward a lair."
		"Entering the forest completes this optional survey. Use its local clues for the next destination."
	]
	quest.1A0C9B181EC116F5.title: "The Otherside"
	quest.1A0C9B181EC116F5.quest_desc: [
		"The Otherside is no place for a first expedition. Learn its portal requirements and keep a clear retreat plan."
		"Entering the dimension completes this optional survey. Leave with information before chasing a rare prize."
	]
	quest.33724D4C4AA70A08.title: "A Dungeon Apart"
	quest.33724D4C4AA70A08.quest_desc: [
		"Dimensional Dungeons isolates its challenges from the ordinary world. Pack for a contained run and agree on a regroup point."
		"Entering its dimension completes this optional survey. The expedition is finished only when the party comes home."
	]
	quest.40C7D8CBB91347E8.title: "A Better Search"
	quest.40C7D8CBB91347E8.quest_desc: [
		"Nature's Compass and Explorer's Compass can help locate biomes and structures when compatible versions are enabled in the pack."
		"Use either tool if available, or mark a manual search route. Neither compass is needed to finish the campaign."
	]
	quest.67D0F8E866E2329B.title: "The Living Map"
	quest.67D0F8E866E2329B.quest_desc: [
		"Xaero's maps can preserve discoveries between trips. Separate public routes from private markers and check which waypoints your group shares."
		"Update one waypoint after a journey and mark this field note. Names such as 'danger' are more useful with a reason attached."
	]
	quest.7E0FFBF2ECB4E307.title: "A Landmark Worth Naming"
	quest.7E0FFBF2ECB4E307.quest_desc: [
		"Use the Boss Fieldbook or a structure compass to locate a landmark tied to a future adventure. Record its approach and the nearest safe stopping point."
		"Mark the site on your map. You do not need to enter or defeat its inhabitant yet."
	]
	chapter.601B56C344EAF75A.title: "Guild Fieldwork"
	quest.23A10A45DCF99178.title: "Take a Commission"
	quest.23A10A45DCF99178.quest_desc: [
		"The campaign can point you toward work, but a guild earns its name through what people actually do. Choose one unmet need in a settlement or traveling party."
		"Write a specific objective, a place, and a way to tell when it is done. Keep it small enough to finish."
	]
	quest.2EB4FB7E36227D42.title: "Prepare the Team"
	quest.2EB4FB7E36227D42.quest_desc: [
		"Agree on supplies, a route, and who is responsible for the return. Use the party and claim tools appropriate to your world."
		"Mark this after the team has a plan. Solo travelers can make the same preparations for themselves."
	]
	quest.77A55458F0F707C8.title: "Do the Work"
	quest.77A55458F0F707C8.quest_desc: [
		"Complete the commission you chose: deliver materials, clear a route, repair a workshop, map a danger, or bring back an expedition finding."
		"Mark this only after the work is done. The task is self-reported so you can invent better commissions than a fixed checklist."
	]
	quest.4701F35DAD8E7037.title: "Report Back"
	quest.4701F35DAD8E7037.quest_desc: [
		"Return to the person or place that needed the work. Explain what you delivered, what remains, and any new risk you found."
		"Mark this after the report. A finished quest should leave the world a little more legible than before."
	]
	quest.23E13CDF93C7F47F.title: "The Next Contract"
	quest.23E13CDF93C7F47F.quest_desc: [
		"Open the Adventurer's Guild board again. Compare its contracts with the needs you have noticed while traveling."
		"Choose your next project and mark the lesson. The book ends here; the guild and world do not."
	]
	quest.1533F463672EB056.title: "A Field Photograph"
	quest.1533F463672EB056.quest_desc: [
		"Exposure can turn a structure, settlement, or unusual encounter into a record worth sharing. Bring a camera when the scene itself matters."
		"This task checks for the camera. Taking a photograph is your own optional fieldwork."
	]
	quest.415CE02C608AF439.title: "Clear Communications"
	quest.415CE02C608AF439.quest_desc: [
		"Simple Voice Chat can help a party coordinate, but only with the group's consent and a working microphone setup."
		"Test a short call if everyone wants to use it. Text and waypoints remain valid when voice is unavailable."
	]
	quest.110DD29C3D545D7F.title: "Voice and Skill"
	quest.110DD29C3D545D7F.quest_desc: [
		"The optional TenSura voicecasting add-on can recognize spoken skill names. Check its listening state, aliases, and microphone permissions before using it in combat."
		"Try one harmless command if you have the add-on enabled, then mark the lesson. Voice input is never required for progression."
	]
	quest.41AFD4CA244CE2B4.title: "A Public Record"
	quest.41AFD4CA244CE2B4.quest_desc: [
		"Collect a map, photograph, written warning, or supply list that helps another player understand your route."
		"Place or share that record where your group keeps reports, then mark the field note."
	]

    quest.5DB71814C8B7E942.title: "The Guild Intelligence Dossier"
    quest.5DB71814C8B7E942.quest_desc: [
        "Craft a Guild Intelligence Dossier from a book, a compass, and paper. Right-click it to review your discoveries and recorded boss victories."
        "The reports follow your search through the Ancient Forest and the Labyrinth. They also record victories over the Elemental Colossus, Orc Disaster, and Charybdis."
        "After becoming a True Hero or True Demon Lord, consult the dossier for a settlement request."
    ]
    quest.3F4D168F4F2D3B97.title: "A Place in the Chronicle"
    quest.3F4D168F4F2D3B97.quest_desc: [
        "An awakening becomes part of the world's history through the people it affects. Bring 32 bread and 12 iron ingots to an inhabited MCA village after becoming a True Hero or True Demon Lord."
        "With the supplies in your main inventory, sneak and right-click the air with your Guild Intelligence Dossier. The village records your aid and grants four emeralds and a Letter of Thanks."
        "Read the Village Chronicle there to see the entry. Each character can answer this aftermath request once."
        "This quest updates automatically from the completed delivery record. FTB team members share quest completion; each character keeps their own delivery and awakening record."
    ]
    task.4E9D44B91DC4BF29.title: "Complete an awakening relief delivery"
}
