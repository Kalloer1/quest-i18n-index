{
	chapter_group.151E3065A6314194.title: "The Story"
	chapter_group.33DD2706D9DC058E.title: "Side Quests"
	chapter.7A48A5C74985F285.title: "Act I: The Keeper Wakes"
	chapter.7A48A5C74985F285.chapter_subtitle: [
		"You open your eyes on a single block, hanging in an endless dark."
	]
	quest.4420EDD6D235742E.title: "Welcome, Keeper"
	quest.4420EDD6D235742E.quest_subtitle: "The world was eaten. One block remembers it."
	quest.4420EDD6D235742E.quest_desc: [
		"&7&oThe world did not end in fire. It ended in forgetting.&r"
		""
		"The Ender Dragon ate the world's memory, and everything came apart, one biome at a time. Only one block was too stubborn to be swallowed: the Oneblock."
		""
		"It remembers too much to be eaten. But it needs a pair of hands to rebuild the world. Yours."
		""
		"Click the check when you're ready, Keeper."
	]
	quest.209B47F8917A91E1.title: "It Remembers Out Loud"
	quest.209B47F8917A91E1.quest_subtitle: "Break the block. Watch what it becomes."
	quest.209B47F8917A91E1.quest_desc: [
		"Break the block. It doesn't just vanish: it shudders, glows, and becomes something new."
		""
		"&7&oThe Oneblock isn't giving you resources. It's remembering out loud.&r"
		""
		"Your island is tiny, so collect 12 dirt and build it bigger. Every piece of the world starts somewhere."
	]
	quest.1D5A99EE12A11359.title: "A Seed of Memory"
	quest.1D5A99EE12A11359.quest_subtitle: "Trees remember how to grow."
	quest.1D5A99EE12A11359.quest_desc: [
		"Trees were the first thing the world ever remembered. Find an oak sapling: leaves from the block sometimes drop one, and the wandering NeoTrader sells them too."
		""
		"Hint: the NeoTrader shows up after you've broken a few blocks. Look for a lonely figure on your island!"
	]
	quest.2F9B1094398A1E8A.title: "Roots"
	quest.2F9B1094398A1E8A.quest_subtitle: "Plant it. Give it light and room."
	quest.2F9B1094398A1E8A.quest_desc: [
		"Plant your sapling on dirt and sprinkle it with bone meal. It needs open space above it to grow big."
		""
		"Wood is how you make almost everything: tools, tables, and homes. Collect 6 oak logs."
	]
	quest.06512E123156DB4D.title: "Hands That Build"
	quest.06512E123156DB4D.quest_desc: [
		"Turn logs into planks, and planks into a crafting table. Now your hands can make nearly anything the Oneblock remembers."
	]
	quest.0F11EBFF9F211E23.title: "Something to Break With"
	quest.0F11EBFF9F211E23.quest_subtitle: "The next memory is made of stone."
	quest.0F11EBFF9F211E23.quest_desc: [
		"Soon the block will remember stone, and you can't pick up stone with your bare hands."
		""
		"Craft a wooden pickaxe: sticks for the handle, planks for the head."
	]
	quest.0EDA6D725B6B4B08.title: "The Inscription"
	quest.0EDA6D725B6B4B08.quest_subtitle: "The Forest wakes."
	quest.0EDA6D725B6B4B08.quest_desc: [
		"Carved into the first stone it gave you is a rhyme, worn almost smooth:"
		""
		"&7&oOne Block holds the world entire,&r"
		"&7&oits forests, depths, and nether fire.&r"
		"&7&oWho breaks it builds, who builds restores,&r"
		"&7&oand binds the Dragon's stolen shores.&r"
		""
		"You are the Keeper now. Every block you break, every machine you build, strengthens the Oneblock's memory."
		""
		"&aClaim the reward!&r Then keep breaking: after about 100 blocks, the Oneblock will remember the Forest."
	]
	chapter.0C55F0E22C6E1DF6.title: "Act II: The Memory of Soil"
	chapter.0C55F0E22C6E1DF6.chapter_subtitle: [
		"The first memories are simple: dirt, saplings, and something to eat."
	]
	quest.636F109CB61AA35D.title: "Stone Remembers"
	quest.636F109CB61AA35D.quest_subtitle: "Hold on to the first stone."
	quest.636F109CB61AA35D.quest_desc: [
		"The Forest has woken, and with it, stone. Mine 16 pieces of cobblestone."
		""
		"&7&oStone is patient. It remembers everything it ever held up.&r"
	]
	quest.64EDD85E1F280007.title: "Fire in a Box"
	quest.64EDD85E1F280007.quest_desc: [
		"A furnace turns raw things into useful things: sand into glass, potatoes into snacks, and (soon) ore into metal."
		""
		"Surround the middle of the crafting table with 8 cobblestone."
	]
	quest.62E6A056A1526BA0.title: "Somewhere to Put Things"
	quest.62E6A056A1526BA0.quest_subtitle: "A memory you can't find is a memory you've lost."
	quest.62E6A056A1526BA0.quest_desc: [
		"The more the Oneblock remembers, the more stuff you'll carry. Build a chest to keep it all in."
		""
		"Later you'll upgrade it into something much bigger."
	]
	quest.2008489244695805.title: "A Place for Everything"
	quest.2008489244695805.quest_subtitle: "Sophisticated Storage"
	quest.2008489244695805.quest_desc: [
		"A plain chest fills up fast. A &eSophisticated Storage chest&r looks the same, but it can be upgraded: more room, a magnet that pulls items in, a feeder that fills your stomach, and more."
		""
		"Make one now, and the upgrade bases from the last quest are exactly what it likes to eat."
		""
		"&eRecipe:&r a chest with planks all around it. Hold &eShift&r and right-click it with an upgrade to put the upgrade inside."
	]
	quest.04F561A63FE5B384.title: "Tools for Tilling"
	quest.04F561A63FE5B384.quest_subtitle: "Soil only remembers growing if you wake it up."
	quest.04F561A63FE5B384.quest_desc: [
		"Craft a stone hoe, then use it on dirt to make farmland. Put water next to it and it stays damp."
		""
		"Hint: you'll need a water source. Check the first chest the Oneblock gave you!"
	]
	quest.5ECC91AE8D0EA433.title: "First Harvest"
	quest.5ECC91AE8D0EA433.quest_subtitle: "Wheat: the world's oldest memory."
	quest.5ECC91AE8D0EA433.quest_desc: [
		"Plant wheat seeds on farmland and wait. When the stalks turn golden, harvest them."
		""
		"Collect 3 wheat. You'll need it for bread, and for the Shard."
	]
	quest.06D383936388AA57.title: "Crunch"
	quest.06D383936388AA57.quest_desc: [
		"The NeoTrader sells carrots in the Forest. Plant one and it grows into more. Harvest 3 carrots."
	]
	quest.121F04443DF6B7D2.title: "Underground Treasure"
	quest.121F04443DF6B7D2.quest_desc: [
		"Potatoes grow right in the soil. Harvest 3 potatoes."
	]
	quest.0B56BA037F4035A4.title: "Red as a Memory"
	quest.0B56BA037F4035A4.quest_desc: [
		"Beetroot seeds are another trader find. Harvest 3 beetroot."
	]
	quest.276D03C810FD64FD.title: "Juicy"
	quest.276D03C810FD64FD.quest_subtitle: "Farmer's Delight"
	quest.276D03C810FD64FD.quest_desc: [
		"Tomatoes grow on vines that climb up a rope. Look up their seeds with JEI (press R while hovering an item)."
		""
		"Harvest 3 tomatoes."
	]
	quest.33FFC1AF62CD9F5E.title: "Leafy Green"
	quest.33FFC1AF62CD9F5E.quest_desc: [
		"Cabbage grows in a neat head. Harvest 3 cabbages."
	]
	quest.61A7BEC56CA59482.title: "Don't Cry"
	quest.61A7BEC56CA59482.quest_desc: [
		"Plant an onion in the soil like a carrot. Harvest 3 onions."
	]
	quest.6C5BDE9AC885AFE8.title: "Wet Feet"
	quest.6C5BDE9AC885AFE8.quest_desc: [
		"Rice grows in shallow water. Plant it in a puddle and harvest 3."
	]
	quest.7D884B274B6883CE.title: "Daily Bread"
	quest.7D884B274B6883CE.quest_desc: [
		"Three wheat makes one loaf of bread. Craft some! A Keeper has to eat."
	]
	quest.218127007B3E5696.title: "Hot Potato"
	quest.218127007B3E5696.quest_desc: [
		"Cook a potato in your furnace. It's the easiest meal there is."
	]
	quest.119AD8785EC40EB7.title: "A Cook's Blade"
	quest.119AD8785EC40EB7.quest_subtitle: "Farmer's Delight"
	quest.119AD8785EC40EB7.quest_desc: [
		"Farmer's Delight adds a whole kitchen to the world. A flint knife lets you cut things on a cutting board."
		""
		"Flint comes from gravel. Or ask the NeoTrader!"
	]
	quest.08DD2A8879B0F5CD.title: "A Feathered Friend"
	quest.08DD2A8879B0F5CD.quest_subtitle: "Animals remember too."
	quest.08DD2A8879B0F5CD.quest_desc: [
		"Animals fall onto your island in the wandering NeoTrader's mob tickets. Trade for a chicken, keep it fed with seeds, and collect an egg."
		""
		"&7&oA cow bellowing in confusion on a floating island is a proud tradition.&r"
	]
	quest.312DD3CA1011E698.title: "A Tiny Forest"
	quest.312DD3CA1011E698.quest_subtitle: "Bonsai Trees"
	quest.312DD3CA1011E698.quest_desc: [
		"A bonsai pot grows a whole tree in a tiny space. On an island this small, that matters!"
		""
		"Ask the NeoTrader, or look in the Oneblock's chests for a pot."
	]
	quest.37A88B11E50488DB.title: "Shard of Growth"
	quest.37A88B11E50488DB.quest_subtitle: "Plant everything the block has given you."
	quest.37A88B11E50488DB.quest_desc: [
		"The world remembers how to grow. Prove it: craft the &aShard of Growth&r from the first harvest of eight crops."
		""
		"&eRecipe:&r put a sapling in the middle of the crafting table, and wheat, carrot, potato, beetroot, tomato, cabbage, onion and rice around it."
		""
		"&7&oThe Oneblock pulses green, and grass begins to creep across your builds on its own.&r"
		""
		"&aClaim the reward&r to wake the next memory: the Underground. It needs 300 broken blocks."
	]
	chapter.6010067DAEBFE812.title: "Act III: The Memory of Gears"
	chapter.6010067DAEBFE812.chapter_subtitle: [
		"The old world was not powered by magic alone."
	]
	quest.4C7652296B9B501F.title: "Broken Cogs"
	quest.4C7652296B9B501F.quest_subtitle: "Something stranger than stone."
	quest.4C7652296B9B501F.quest_desc: [
		"&7&oDeeper memories surface: stone, iron, copper, and something stranger.&r"
		""
		"The block is dropping pieces of the engineers' machines. The most important is &eandesite alloy&r, the metal they built everything from."
		""
		"Hint: you can craft it with andesite and an iron nugget. Make 4 pieces."
	]
	quest.37C7E18AFFC43370.title: "Things That Turn"
	quest.37C7E18AFFC43370.quest_subtitle: "Shafts and cogwheels."
	quest.37C7E18AFFC43370.quest_desc: [
		"The engineers' machines all move the same way: a spinning shaft passes turning power from one thing to the next."
		""
		"Craft a &eshaft&r, a &ecogwheel&r and a &elarge cogwheel&r. Large and small cogwheels can mesh together to change speed."
		""
		"Tip: hold W while hovering an item in JEI to see how Create machines work (Ponder)."
	]
	quest.7D7047F599018438.title: "See the Spin"
	quest.7D7047F599018438.quest_desc: [
		"The engineers wore goggles to see how fast a machine was turning. Craft the &eEngineer's Goggles&r and a &ewrench&r. The wrench rotates and picks up machines without breaking them."
	]
	quest.197F309F28E12A23.title: "Power of Hands"
	quest.197F309F28E12A23.quest_subtitle: "The first engine was always an arm."
	quest.197F309F28E12A23.quest_desc: [
		"Before water and wind, there were hands. Attach a &ehand crank&r to a shaft and hold right-click to spin it."
		""
		"&7&oIt is slow, but it works. It is how every engineer started.&r"
	]
	quest.2CA382F6D7FCD625.title: "Water Remembers"
	quest.2CA382F6D7FCD625.quest_subtitle: "Let the river do the work."
	quest.2CA382F6D7FCD625.quest_desc: [
		"Your arms will get tired. Water doesn't. A &ewater wheel&r spins whenever water flows past it, all day, with no one cranking."
		""
		"Hint: you need &eflowing&r water. Pour a bucket on a high block, and let it run down beside the wheel."
	]
	quest.01C0549BA7EFE5BC.title: "A Metal Called Zinc"
	quest.01C0549BA7EFE5BC.quest_subtitle: "Brass needs two metals."
	quest.01C0549BA7EFE5BC.quest_desc: [
		"Some of the Underground blocks are zinc ore: a silvery-blue metal the engineers mixed with copper to make &ebrass&r."
		""
		"Mine zinc ore, then smelt the raw zinc. Collect 4 zinc ingots."
	]
	quest.1F18B715E47B644D.title: "Wheels That Eat Ore"
	quest.1F18B715E47B644D.quest_subtitle: "Two ore chunks from one."
	quest.1F18B715E47B644D.quest_desc: [
		"A pair of &ecrushing wheels&r grinds ore into crushed bits that smelt into MORE metal than the plain ore would."
		""
		"They must spin toward each other, facing in the same direction. The wrench helps."
	]
	quest.4EFE28CCA97AEACF.title: "A Skin for the First Machines"
	quest.4EFE28CCA97AEACF.quest_subtitle: "Andesite casing"
	quest.4EFE28CCA97AEACF.quest_desc: [
		"Every machine you are about to build wears a casing, and the simplest is made of andesite. The millstone, the press, the mixer and the drill are all built around one."
		""
		"Hint: a casing is a &estripped log&r with an andesite alloy applied to it. Strip a log with an axe, then use a deployer or just right-click the alloy onto it by hand. Make 2."
	]
	quest.5FB90F3FA40778B6.title: "Grind It Fine"
	quest.5FB90F3FA40778B6.quest_subtitle: "Millstone"
	quest.5FB90F3FA40778B6.quest_desc: [
		"A &emillstone&r grinds things into powder: wheat into flour, gravel into flint and ore bits. Power it with a shaft and toss items on top."
		""
		"Every other machine in this book starts with powder."
	]
	quest.116972D71F05F41E.title: "Stamp It Flat"
	quest.116972D71F05F41E.quest_subtitle: "Mechanical press"
	quest.116972D71F05F41E.quest_desc: [
		"The &emechanical press&r squashes ingots into thin metal &esheets&r. Sheets are the skin of nearly every machine to come."
		""
		"It needs a &edepot&r or basin underneath to hold the thing being pressed."
	]
	quest.42BB3AD17B9A9961.title: "Shake It Out"
	quest.42BB3AD17B9A9961.quest_subtitle: "Create Sifting"
	quest.42BB3AD17B9A9961.quest_desc: [
		"Gravel isn't just gravel: the Oneblock hides little bits of metal inside it. A &esifter&r with a mesh shakes them loose."
		""
		"Start with a string mesh, and upgrade the mesh to find better things."
	]
	quest.7A67461D6078DA40.title: "A Finer Mesh"
	quest.7A67461D6078DA40.quest_desc: [
		"A sturdier mesh catches smaller, heavier bits. Craft an andesite mesh."
	]
	quest.7C78CBFBF974B038.title: "A Brass Mesh"
	quest.7C78CBFBF974B038.quest_desc: [
		"Brass makes the finest mesh yet. It catches the smallest, heaviest bits: the metals the others miss."
	]
	quest.248E333126A1A03A.title: "The Machines Wake"
	quest.248E333126A1A03A.quest_subtitle: "The Caves remember."
	quest.248E333126A1A03A.quest_desc: [
		"Water turns the wheel, the wheel turns the shaft, the shaft drives the press. A working machine, for the first time since the Unmaking."
		""
		"&7&oWaterwheels turn. Mechanical presses stamp.&r"
		""
		"Show the Oneblock you have a &emechanical press&r and a &emillstone&r ready."
		""
		"&aClaim the reward&r to wake the next memory: the Caves. It needs 650 broken blocks."
	]
	quest.137AC09C714FA808.title: "Stir It Up"
	quest.137AC09C714FA808.quest_subtitle: "Mixer and basin"
	quest.137AC09C714FA808.quest_desc: [
		"Machines can do more than grind and press. A &emechanical mixer&r stirs things together in a &ebasin&r, and what comes out is something new."
		""
		"The mixer sits above the basin and needs power from the side."
	]
	quest.11F27314C94DE556.title: "Gold and Copper Sing"
	quest.11F27314C94DE556.quest_subtitle: "Brass"
	quest.11F27314C94DE556.quest_desc: [
		"The engineers' favourite metal wasn't found: it was made. Mix &ecopper and zinc&r in the mixer and you get brass, the bright yellow metal that holds the finest machines together."
		""
		"Make 8 brass ingots."
		""
		"&7&oBrass-and-andesite: the Oneblock remembers its first alloy.&r"
	]
	quest.56CA72241AB290DE.title: "Skins for Machines"
	quest.56CA72241AB290DE.quest_subtitle: "Casings"
	quest.56CA72241AB290DE.quest_desc: [
		"Strong machines wear a casing. Andesite casings are for the simple ones; &ebrass casings&r are for the clever ones."
		""
		"Hint: a casing is a &estripped log&r with a metal ingot applied to it: an andesite alloy for andesite casing, a brass ingot for brass casing. Strip a log with an axe, then use a deployer or just right-click the ingot onto it by hand."
	]
	quest.28AAD0A92A5C92D7.title: "A Hand That Isn't Yours"
	quest.28AAD0A92A5C92D7.quest_subtitle: "Deployer"
	quest.28AAD0A92A5C92D7.quest_desc: [
		"A &edeployer&r is a robot hand. It can place blocks, use tools, and press things onto other things, all on its own."
		""
		"This is the secret to building tiny, delicate parts."
		""
		"Hint: its &eelectron tube&r needs &erose quartz&r. Crushing diorite with your crushing wheels gives you quartz. Mix it with redstone, then polish it with sandpaper."
	]
	quest.33BCC2DAC51D5B91.title: "Precision"
	quest.33BCC2DAC51D5B91.quest_subtitle: "The part no hand could make."
	quest.33BCC2DAC51D5B91.quest_desc: [
		"The heart of every great machine is a &eprecision mechanism&r. No one can craft it by hand, because it's built in steps: a gold sheet, then cogs, then pressing, over and over."
		""
		"Open JEI and look up its recipe. It's a &esequenced assembly&r: a deployer, a press, and a depot working in a row."
		""
		"Make 2."
	]
	quest.7EBA1F2201FB115D.title: "Slow Fire"
	quest.7EBA1F2201FB115D.quest_subtitle: "More lava than you were given."
	quest.7EBA1F2201FB115D.quest_desc: [
		"&7&oThe deep places make their own fire, if you teach them how.&r"
		""
		"Lava is easy to spend and hard to find. The Oneblock gave you a bucket, perhaps two. Machines and furnaces will want a lot more."
		""
		"Caves have a patient way of growing things downward. A pointed stone grows from the ceiling, one slow drip at a time. What would happen if the thing dripping were fire?"
		""
		"Bring &e2 buckets of lava&r, a &epointed dripstone&r and a &ecauldron&r."
		""
		"&7Hint: a trader might sell dripstone for cobblestone.&r"
	]
	quest.4C77118263B85F08.title: "Digging Deep"
	quest.4C77118263B85F08.quest_subtitle: "Mechanical drill"
	quest.4C77118263B85F08.quest_desc: [
		"A &emechanical drill&r breaks whatever is in front of it, all by itself, as long as it keeps turning."
		""
		"&7&oImagine hauling blocks away faster than hands ever could.&r"
	]
	quest.53151E9D800DC4BA.title: "The Hauler"
	quest.53151E9D800DC4BA.quest_subtitle: "A contraption that breaks the Oneblock for you."
	quest.53151E9D800DC4BA.quest_desc: [
		"A drill on a &emechanical bearing&r spins in circles. Aim it at the Oneblock and it breaks it again and again."
		""
		"&eWatch out:&r a spinning drill breaks everything in its path, so keep your farm out of its way!"
	]
	quest.0E60847530F92EE9.title: "Ssssaw"
	quest.0E60847530F92EE9.quest_subtitle: "Mechanical saw"
	quest.0E60847530F92EE9.quest_desc: [
		"A &emechanical saw&r cuts logs into planks, twice as many as a crafting table gives. It also saws stone into cut blocks."
	]
	quest.6220677340817091.title: "Wind in the Caves"
	quest.6220677340817091.quest_subtitle: "Encased fan"
	quest.6220677340817091.quest_desc: [
		"An &eencased fan&r pushes things along on a breeze, and when the air passes through fire or water it can change what's carried: washing, smoking, blasting."
	]
	quest.76D51B38D94FCC36.title: "Machines in the Field"
	quest.76D51B38D94FCC36.quest_subtitle: "The soil meets the cogs."
	quest.76D51B38D94FCC36.quest_desc: [
		"Put the Memory of Soil and the Memory of Gears together: a &emechanical plough&r tills for you, a &emechanical harvester&r reaps what you sow."
	]
	quest.5A31E18BEC8F730C.title: "A Hand for Every Cell"
	quest.5A31E18BEC8F730C.quest_subtitle: "Mechanical crafter"
	quest.5A31E18BEC8F730C.quest_desc: [
		"Some machines are too big for a crafting table. A &emechanical crafter&r is one cell of a bigger grid: line up a block of them, feed each its piece, and they build one item together."
		""
		"Each crafter needs an &eelectron tube&r, and a tube needs &epolished rose quartz&r. One tube makes &e3 crafters&r with a brass casing and a crafting table. Make 9 crafters (3 tubes)."
		""
		"&eRose quartz:&r a quartz and 8 redstone dust. Rub it with &esandpaper&r to polish it, then add an iron sheet for the tube."
		""
		"&eQuartz is rare here.&r Black quartz comes from sifting gravel with a brass mesh, and from Cave blocks. The trader swaps black quartz for quartz 1 to 1."
	]
	quest.1C704425F945B84F.title: "Potato Cannon"
	quest.1C704425F945B84F.quest_subtitle: "Because you can."
	quest.1C704425F945B84F.quest_desc: [
		"&7&oThe engineers had a very serious workshop, and a very silly one.&r"
		""
		"Set up your crafters in a row of 5 with 2 beneath, and build the &ePotato Cannon&r. It fires &epotatoes&r, and other food, at whatever you point it at."
		""
		"&eRecipe:&r andesite alloy, a precision mechanism and 3 fluid pipes across the top, with 2 copper ingots below. Fluid pipes are a copper ingot and a copper sheet."
	]
	quest.689D77EA31202E25.title: "Shard of Motion"
	quest.689D77EA31202E25.quest_subtitle: "The engineers built a world that moved."
	quest.689D77EA31202E25.quest_desc: [
		"Make the gears turn again. Craft the &6Shard of Motion&r: a brass-and-andesite core that only a working Create assembly line can produce."
		""
		"&eRecipe:&r a brass casing in the middle, a precision mechanism above and below it, andesite alloy left and right, and brass ingots in the four corners."
		""
		"&7&oThe Oneblock hums in a new key, warm, and almost cheerful.&r"
		""
		"&aClaim the reward&r to wake the next memory: the Ocean. It needs 1100 broken blocks."
		""
		"&6Bonus:&r the engineers left you a &eBeacon&r. Build it a pyramid of iron, gold, diamond or emerald blocks, with clear sky above, and it will shine a gift on everyone nearby."
	]
	chapter.1A07B10975090045.title: "Act IV: The Memory of the Deep"
	chapter.1A07B10975090045.chapter_subtitle: [
		"Not every memory is metal. Some of them are alive."
	]
	quest.22934F83BB29641C.title: "Mana in the Tide"
	quest.22934F83BB29641C.quest_subtitle: "The block begins to weep water."
	quest.22934F83BB29641C.quest_desc: [
		"&7&oFish leap from it, then coral, then living flowers that hum with mana.&r"
		""
		"The Ocean has woken, and with it a new glowing dust: &aInferium Essence&r. It is the world's mana, the stuff life is made of."
		""
		"Collect 8. Where from? Smelt &einferium ore&r from the block, open the Ocean's first chest, trade with the NeoTrader, or defeat an animal (20% of them drop some)."
	]
	quest.21325F1339DF6D97.title: "A Seed That Hums"
	quest.21325F1339DF6D97.quest_subtitle: "Seeds that grow mana itself."
	quest.21325F1339DF6D97.quest_desc: [
		"Surround a plain wheat seed with 8 inferium essence in the crafting table, and you get an &einferium seed&r."
		""
		"Plant it, and it grows... more essence! Plants that make their own mana: the first step to never running out."
	]
	quest.4F3AB8AAB27F71C3.title: "Soil That Listens"
	quest.4F3AB8AAB27F71C3.quest_subtitle: "Essence farmland"
	quest.4F3AB8AAB27F71C3.quest_desc: [
		"Plants grow faster in soil that remembers mana. Combine an essence with a plain farmland block to make &einferium farmland&r."
		""
		"Make 4 and plant your inferium seeds on them."
	]
	quest.6F9F34E703DD5D0E.title: "Make It Rain"
	quest.6F9F34E703DD5D0E.quest_subtitle: "The watering can"
	quest.6F9F34E703DD5D0E.quest_desc: [
		"A &ewatering can&r makes every plant it pours on grow a little faster, and it never runs out of water."
		""
		"Iron ingots, a bowl and a little bone meal."
	]
	quest.4716F8C43E26BF9D.title: "Prosperity"
	quest.4716F8C43E26BF9D.quest_subtitle: "The shards that make everything else."
	quest.4716F8C43E26BF9D.quest_desc: [
		"Another little treasure from the block: &bprosperity shards&r. They are the building blocks of almost everything in this Act: the altar's crystal, seed bases, even gemstones."
		""
		"Break prosperity ore and smelt it. Collect 16."
	]
	quest.75FE24D2A04B1F3C.title: "The Ocean Remembers Belts"
	quest.75FE24D2A04B1F3C.quest_subtitle: "A link back to Act III"
	quest.75FE24D2A04B1F3C.quest_desc: [
		"Remember how conveyor belts needed something the Oneblock couldn't give you yet? Kelp! Smelt it dry in a furnace."
		""
		"Dried kelp is the secret ingredient in belts: now Create can move things in a straight line."
	]
	quest.68093990E716EEA1.title: "The First Garden"
	quest.68093990E716EEA1.quest_subtitle: "The Lush Caves bloom."
	quest.68093990E716EEA1.quest_desc: [
		"Plants that make their own mana, growing in listening soil, watered by a can that never runs dry. A garden built from nothing."
		""
		"Harvest enough essence to fill your pockets: &a32 inferium essence&r."
		""
		"&aClaim the reward&r to wake the next memory: the Lush Caves. It needs 1600 broken blocks."
	]
	quest.0017DE221528FCAC.title: "The Altar of Mana"
	quest.0017DE221528FCAC.quest_subtitle: "Infusion Altar"
	quest.0017DE221528FCAC.quest_desc: [
		"Some things can't be made with hands alone. The &eInfusion Altar&r brings ingredients together, with &epedestals&r around it, and weaves them into something new."
		""
		"Build the altar (stone, red wool and gold) and 4 pedestals. Place the pedestals in a ring around the altar."
	]
	quest.35164C99024E6C90.title: "A Crystal Heart"
	quest.35164C99024E6C90.quest_subtitle: "Infusion crystal"
	quest.35164C99024E6C90.quest_desc: [
		"The altar needs a heart: an &einfusion crystal&r. It's made of prosperity shards, inferium essence and a diamond, and it lasts for a thousand uses. (Later, you can make an unbreakable &6master crystal&r that never wears out.)"
		""
		"Put it on the altar when you infuse."
	]
	quest.740FE3B7E8D1D7C8.title: "A Second Voice"
	quest.740FE3B7E8D1D7C8.quest_subtitle: "Prudentium essence"
	quest.740FE3B7E8D1D7C8.quest_desc: [
		"The crystal lets you turn plain essence into a stronger kind. Surround the crystal with 4 inferium essence to make &9prudentium essence&r."
		""
		"Make 4. The more advanced the essence, the stronger the magic."
	]
	quest.06C499382372D434.title: "A Gem of Life"
	quest.06C499382372D434.quest_subtitle: "Prosperity and inferium gemstones"
	quest.06C499382372D434.quest_desc: [
		"Four prosperity shards around a diamond make a &bprosperity gemstone&r. Add two inferium essence and it becomes an &ainferium gemstone&r, a living jewel."
	]
	quest.62C4F6882A493BEA.title: "Impatient Plants"
	quest.62C4F6882A493BEA.quest_subtitle: "Growth accelerators"
	quest.62C4F6882A493BEA.quest_desc: [
		"A &egrowth accelerator&r makes crops near it grow faster, forever, without you having to pour a drop."
		""
		"The recipe makes 3. Put one in the middle of your garden."
	]
	quest.7005C192571AC4ED.title: "Grown Stone"
	quest.7005C192571AC4ED.quest_subtitle: "A quarry that sits in a pot"
	quest.7005C192571AC4ED.quest_desc: [
		"The simplest seeds grow the simplest things. Stone seeds grow stone essence, and stone essence turns into &estone&r."
		""
		"Infuse &estone seeds&r, plant them, and harvest &e8 stone essence&r."
	]
	quest.0E9543A4DB524888.title: "Grown Wood"
	quest.0E9543A4DB524888.quest_subtitle: "A forest in a pot"
	quest.0E9543A4DB524888.quest_desc: [
		"Trees are slow. Wood seeds are not. They grow wood essence, and wood essence crafts into logs."
		""
		"Infuse &ewood seeds&r and harvest &e8 wood essence&r."
	]
	quest.202842134C6FB11D.title: "Four Corners"
	quest.202842134C6FB11D.quest_subtitle: "Air, earth, water and fire"
	quest.202842134C6FB11D.quest_desc: [
		"&7&oBefore there was iron there were only four things, and they were enough.&r"
		""
		"The first tier of seeds grows the elements themselves: &eair&r, &eearth&r, &ewater&r and &efire&r. Combine their essences and strange things happen. Stone with water makes dripstone, and fire with dirt makes sand."
		""
		"Infuse one of each of the four seeds."
	]
	quest.32F4AC787C15E690.title: "A Garden of Flowers"
	quest.32F4AC787C15E690.quest_subtitle: "Nature seeds"
	quest.32F4AC787C15E690.quest_desc: [
		"Now for the clever part: seeds that grow &eresources&r. Nature seeds grow the very essence of flowers and leaves."
		""
		"Open JEI and look up the recipe for &enature seeds&r: it's an infusion at your new altar."
	]
	quest.30E1AE330F24C14D.title: "Wild Mana"
	quest.30E1AE330F24C14D.quest_subtitle: "Harvest your first resource crop"
	quest.30E1AE330F24C14D.quest_desc: [
		"Plant your nature seeds on farmland and harvest them. You'll need &a8 nature essence&r for something special soon."
	]
	quest.2F53D6D4F6F3925E.title: "Grown Iron"
	quest.2F53D6D4F6F3925E.quest_subtitle: "The world forgot its ore. You can grow it."
	quest.2F53D6D4F6F3925E.quest_desc: [
		"The Oneblock doesn't drop as much iron as you'd like. But now you don't have to rely on it: infuse &eiron seeds&r at the altar, and plant them."
		""
		"&7&oResource crops grow essence that turns into the real thing.&r"
	]
	quest.032C2FB49669DAD9.title: "Iron from the Soil"
	quest.032C2FB49669DAD9.quest_desc: [
		"Harvest your crop: 16 iron essence. Craft it into iron ingots in the crafting table (look it up in JEI)."
	]
	quest.1CE71FF271F6649C.title: "A Helper that Reaps"
	quest.1CE71FF271F6649C.quest_subtitle: "Harvester pylon"
	quest.1CE71FF271F6649C.quest_desc: [
		"A &eharvester pylon&r (from the Pylons mod) reaps all the crops around it into a chest. Set it in a water block, give it a chest on top, and hand it a few hoes."
		""
		"It will work tirelessly while you explore."
	]
	quest.2E1A8A8321625260.title: "Grown Copper"
	quest.2E1A8A8321625260.quest_subtitle: "Wires, cables and coils"
	quest.2E1A8A8321625260.quest_desc: [
		"Copper is in everything that carries power. The Oneblock gives you some. The altar can give you more."
		""
		"Infuse &ecopper seeds&r, plant them, and harvest &e8 copper essence&r. Look at the seeds in JEI to see what the altar asks for."
	]
	quest.5E877FE07FDDC76F.title: "Grown Zinc"
	quest.5E877FE07FDDC76F.quest_subtitle: "Brass needs a second metal"
	quest.5E877FE07FDDC76F.quest_desc: [
		"Zinc is shy and hides in the deep stone. The Oneblock does not hand it out often, and brass needs it."
		""
		"Grow it instead: &ezinc seeds&r and &e8 zinc essence&r. Craft the essence into zinc ingots when you want them."
	]
	quest.22021619BA487D59.title: "Grown Coal"
	quest.22021619BA487D59.quest_subtitle: "Fuel without digging"
	quest.22021619BA487D59.quest_desc: [
		"Every furnace and generator is hungry. Coal seeds grow the hungry things something to eat."
		""
		"Plant &ecoal seeds&r and harvest &e8 coal essence&r."
	]
	quest.53449AF8BAC289F5.title: "Grown Redstone"
	quest.53449AF8BAC289F5.quest_subtitle: "A red spark in the soil"
	quest.53449AF8BAC289F5.quest_desc: [
		"Redstone is the spark inside almost every machine. It is found underground, and sometimes not found at all."
		""
		"Grow &eredstone seeds&r and harvest &e8 redstone essence&r."
	]
	quest.05AEC389F512D059.title: "Grown Brass"
	quest.05AEC389F512D059.quest_subtitle: "Copper and zinc, already mixed"
	quest.05AEC389F512D059.quest_desc: [
		"Brass is two metals melted together. Or it is a crop. The altar does not mind which."
		""
		"Infuse &ebrass seeds&r and harvest &e8 brass essence&r. Craft the essence into brass ingots."
	]
	quest.7E7C5EB4CC223F44.title: "Grown Quartz"
	quest.7E7C5EB4CC223F44.quest_subtitle: "White crystal, no Nether needed"
	quest.7E7C5EB4CC223F44.quest_desc: [
		"Nether quartz is one of the hardest things to find. Machines, circuits and the library all want it, and the Oneblock only offers it late."
		""
		"Grow it instead: infuse &enether quartz seeds&r and harvest &e8 nether quartz essence&r. Craft the essence into quartz."
	]
	quest.4983AF9405BDDED9.title: "Grown Glowstone"
	quest.4983AF9405BDDED9.quest_subtitle: "Light you can harvest"
	quest.4983AF9405BDDED9.quest_desc: [
		"Glowstone dust lights lamps, brews potions and goes into a surprising number of recipes."
		""
		"Infuse &eglowstone seeds&r and harvest &e8 glowstone essence&r."
	]
	quest.52971330B7325AC0.title: "Light in the Caves"
	quest.52971330B7325AC0.quest_subtitle: "Glow berries"
	quest.52971330B7325AC0.quest_desc: [
		"The Lush Caves grow glow berries: little glowing fruit that hangs from vines. They're sweet, and a bit magic. Find 8."
	]
	quest.3077F2E48E7C575F.title: "Come Here, Little Ones"
	quest.3077F2E48E7C575F.quest_subtitle: "Simple Magnets"
	quest.3077F2E48E7C575F.quest_desc: [
		"Gardens full of growing things drop a lot of little things: seeds, essence, leftovers, all over the grass. Chasing them is tiring."
		""
		"A &emagnet&r pulls every dropped item toward you. Hold it, and watch the pile walk over."
		""
		"&eRecipe:&r iron ingot, lapis, ender pearl and redstone. (Ender pearls are the tricky one: ask the Oneblock or a trader.)"
		""
		"&eTip:&r right-click the magnet to switch it on and off. Put it in your pocket and let the world come to you."
	]
	quest.576B10D31EE4EA89.title: "Never Lose Another Item"
	quest.576B10D31EE4EA89.quest_subtitle: "Trash Cans"
	quest.576B10D31EE4EA89.quest_desc: [
		"Mana farms make a LOT of leftover stuff: seeds, cobblestone, things you will never use. Your chests are filling up with junk."
		""
		"A &etrash can&r deletes whatever you put in it, so you never have to carry or store the extras again. Careful: what goes in does not come back!"
		""
		"&7&oNot every memory is worth keeping.&r"
	]
	quest.01441334D798BC59.title: "Shard of Life"
	quest.01441334D798BC59.quest_subtitle: "Grown, not crafted."
	quest.01441334D798BC59.quest_desc: [
		"Not every memory is metal. Grow a garden that hums with mana, and the Oneblock will give you the memory of life itself."
		""
		"&eRecipe:&r an inferium gemstone in the middle, 4 prudentium essence on the sides, and 4 nature essence in the corners."
		""
		"&7&oThe Oneblock pulses green, and blooms with a light you have not seen since the Unmaking.&r"
		""
		"&aClaim the reward&r to wake the next memory: the Nether. It needs 2200 broken blocks."
	]
	chapter.0A88B2192D15715E.title: "Act V: The Memory of Fire"
	chapter.0A88B2192D15715E.chapter_subtitle: [
		"This is the age of real power."
	]
	quest.2CE94BF6825F4417.title: "The Block Burns"
	quest.2CE94BF6825F4417.quest_subtitle: "The Nether remembers."
	quest.2CE94BF6825F4417.quest_desc: [
		"&7&oThe Oneblock darkens and burns. Netherrack, soul sand, blaze rods, and Piglins who remember the Dragon and hate it as much as you do.&r"
		""
		"The Nether is hot, and dangerous, and full of things the old world was built from. Gather &e2 blaze rods&r and &e8 nether quartz&r from the block, its chests, and the trader."
	]
	quest.5A354A2E37B10EEA.title: "A Furnace That Gives Back"
	quest.5A354A2E37B10EEA.quest_subtitle: "Iron Furnaces"
	quest.5A354A2E37B10EEA.quest_desc: [
		"Every furnace you've ever used wastes its heat. An &eIron Furnace&r with a &egenerator augment&r catches that heat and turns it into electric power (FE)."
		""
		"Build one and give it coal. This is your first &bpower source&r: you made it yourself."
	]
	quest.63EE2747E38CC4EE.title: "A Coal-Hearted Machine"
	quest.63EE2747E38CC4EE.quest_subtitle: "Actually Additions"
	quest.63EE2747E38CC4EE.quest_desc: [
		"Another way to make power: the &ecoal generator&r burns anything flammable and makes steady power. Use it side by side with your furnace."
		""
		"Want something greener? Try the &eleaf generator&r: it burns leaves!"
	]
	quest.55441D3EAFCAB52A.title: "Moving Power Around"
	quest.55441D3EAFCAB52A.quest_subtitle: "Cables and an energy cube"
	quest.55441D3EAFCAB52A.quest_desc: [
		"Power is no use trapped in the generator. Run &euniversal cables&r (steel and redstone) to your machines, and store the extra in an &eenergy cube&r (it is built around a steel casing)."
		""
		"Hint: Mekanism's machines accept the same power the furnace makes."
	]
	quest.038F15EC4F37F9CD.title: "The Heavy Metal"
	quest.038F15EC4F37F9CD.quest_subtitle: "Osmium"
	quest.038F15EC4F37F9CD.quest_desc: [
		"Osmium is dense, blue-grey and tougher than iron, and it's the key to Mekanism's machines. Smelt osmium ore from the deeper blocks."
		""
		"Collect 8 osmium ingots."
	]
	quest.5AED28E4B1F2BDB5.title: "The Infuser"
	quest.5AED28E4B1F2BDB5.quest_subtitle: "Metallurgic infuser"
	quest.5AED28E4B1F2BDB5.quest_desc: [
		"The &emetallurgic infuser&r mixes a metal with a \"flavour\" (like carbon or redstone) to make better metals. It is the beating heart of Mekanism."
		""
		"It runs on power, so set it beside the generator you built."
	]
	quest.42ADC64FEC236A36.title: "Double the Ore"
	quest.42ADC64FEC236A36.quest_subtitle: "Enrichment chamber"
	quest.42ADC64FEC236A36.quest_desc: [
		"An &eenrichment chamber&r turns one ore into TWO piles of dust, which smelt into two ingots. Ore processing that turns one ingot into more!"
	]
	quest.625D95AC46AD9FCF.title: "Crush It"
	quest.625D95AC46AD9FCF.quest_subtitle: "Crusher"
	quest.625D95AC46AD9FCF.quest_desc: [
		"A &ecrusher&r grinds ingots, gems and cobblestone into dust or gravel. Different jobs from the enrichment chamber: try both!"
	]
	quest.4F649F7C2D2BEC7F.title: "Steel"
	quest.4F649F7C2D2BEC7F.quest_subtitle: "Iron + carbon"
	quest.4F649F7C2D2BEC7F.quest_desc: [
		"Put iron and a bit of &ecoal (carbon)&r in the infuser, and out comes &bsteel&r: stronger than iron, and the metal almost every advanced machine is made of."
		""
		"Make 8 steel ingots. You'll need them for the Shard of Flame!"
	]
	quest.45CEA37A78A9E80F.title: "Better Metals"
	quest.45CEA37A78A9E80F.quest_subtitle: "Infused and reinforced alloys"
	quest.45CEA37A78A9E80F.quest_desc: [
		"Infuse iron with redstone for &cinfused alloy&r. Then infuse that with diamond for &9reinforced alloy&r. Each step makes a stronger, cleverer metal."
		""
		"Make 4 infused alloys and 2 reinforced alloys."
	]
	quest.202B0DB57264A1B5.title: "Thinking Metal"
	quest.202B0DB57264A1B5.quest_subtitle: "Control circuits"
	quest.202B0DB57264A1B5.quest_desc: [
		"Infused alloy wrapped in osmium makes a &econtrol circuit&r: the tiny brain every machine needs. Craft 4."
	]
	quest.1ED58DB3B162EFF2.title: "A Body for the Machine"
	quest.1ED58DB3B162EFF2.quest_subtitle: "Steel casing"
	quest.1ED58DB3B162EFF2.quest_desc: [
		"A &esteel casing&r is the body of the finest machines: steel on the outside, glass and osmium inside. You'll need one for the Shard of Flame."
	]
	quest.1127C5EF797B0F67.title: "A Wrench for Mek"
	quest.1127C5EF797B0F67.quest_subtitle: "Configurator"
	quest.1127C5EF797B0F67.quest_desc: [
		"The &econfigurator&r rotates, picks up, and changes how machines send things around. It's Mekanism's wrench."
	]
	quest.600D58FAF2898C46.title: "Nickel"
	quest.600D58FAF2898C46.quest_subtitle: "Oritech"
	quest.600D58FAF2898C46.quest_desc: [
		"Oritech is a different school of machines: sleek, fast, and powerful. Its machines are built from nickel, copper and electrum. Smelt nickel ore from the Oneblock."
		""
		"Collect 8 nickel ingots."
	]
	quest.46524E0F4C93EA04.title: "The Engineer's Wrench"
	quest.46524E0F4C93EA04.quest_subtitle: "Oritech"
	quest.46524E0F4C93EA04.quest_desc: [
		"Steel and nickel make Oritech's &ewrench&r, the tool that picks up and rotates its machines."
	]
	quest.07C54F02AE0F340F.title: "Machine Frames"
	quest.07C54F02AE0F340F.quest_subtitle: "Oritech"
	quest.07C54F02AE0F340F.quest_desc: [
		"Every Oritech machine stands on a &emachine frame&r: iron bars and nickel. One craft gives you 16."
	]
	quest.3F083109FE2C2B6D.title: "The Pulverizer"
	quest.3F083109FE2C2B6D.quest_subtitle: "Oritech"
	quest.3F083109FE2C2B6D.quest_desc: [
		"The &epulverizer&r crushes ore into dust that smelts into extra metal, just like Mekanism's crusher but faster. It needs a motor, so be nice to the NeoTrader!"
	]
	quest.0093C4D1AB0BF237.title: "Black Quartz"
	quest.0093C4D1AB0BF237.quest_subtitle: "Actually Additions"
	quest.0093C4D1AB0BF237.quest_desc: [
		"A dark crystal from the deep blocks. Actually Additions uses it for almost everything: tools, machines, and one very special crafting table called an empowerer. It will matter later."
	]
	quest.139358A833CF0581.title: "Pipes of Power"
	quest.139358A833CF0581.quest_subtitle: "Oritech: item and energy pipes"
	quest.139358A833CF0581.quest_desc: [
		"Machines need to talk to each other. An &eitem pipe&r (a nickel ingot and planks) carries things from one machine to the next. An &eenergy pipe&r (an electrum ingot) carries power."
		""
		"Make 8 item pipes and 4 energy pipes."
	]
	quest.7B45C3C3E18B785E.title: "A Small Sun"
	quest.7B45C3C3E18B785E.quest_subtitle: "Oritech: the Basic Generator"
	quest.7B45C3C3E18B785E.quest_desc: [
		"Your first Oritech power source. The &eBasic Generator&r burns fuel and makes power. Feed it coal and run a cable out."
	]
	quest.5E9FC7B01175067C.title: "Patient Hands"
	quest.5E9FC7B01175067C.quest_subtitle: "Oritech: the Assembler"
	quest.5E9FC7B01175067C.quest_desc: [
		"Some things are too fiddly to craft by hand. The &eAssembler&r takes the parts and puts them together, with power and a pipe or two."
	]
	quest.3E9EF4BFBCE4A25F.title: "Crumble the Ore"
	quest.3E9EF4BFBCE4A25F.quest_subtitle: "Oritech: the Fragment Forge"
	quest.3E9EF4BFBCE4A25F.quest_desc: [
		"The Pulverizer made dust. The &eFragment Forge&r breaks ore into clumps that smelt into more metal than the plain ore would."
	]
	quest.093538D604192BA8.title: "Spin It Apart"
	quest.093538D604192BA8.quest_subtitle: "Oritech: the Centrifuge"
	quest.093538D604192BA8.quest_desc: [
		"Spin something fast enough and its parts come apart. The &eCentrifuge&r separates mixtures and fluids into their ingredients."
	]
	quest.365FB42429C6AE4B.title: "Ore, Three Times Over"
	quest.365FB42429C6AE4B.quest_subtitle: "Mekanism: the Purification Chamber"
	quest.365FB42429C6AE4B.quest_desc: [
		"An enriched ore smelts into more than a plain one. Put it through a &ePurification Chamber&r with oxygen and it gives you more again."
	]
	quest.2D7D3738E17006E1.title: "Pressure"
	quest.2D7D3738E17006E1.quest_subtitle: "Mekanism: the Osmium Compressor"
	quest.2D7D3738E17006E1.quest_desc: [
		"Squeeze things hard enough and they become something denser. The &eOsmium Compressor&r turns osmium and glowstone and obsidian into their refined forms."
	]
	quest.6ECA6FF4DD8C5818.title: "Liquid Things"
	quest.6ECA6FF4DD8C5818.quest_subtitle: "Mekanism: pumps and tanks"
	quest.6ECA6FF4DD8C5818.quest_desc: [
		"Machines drink as well as eat. An &eElectric Pump&r pulls water or lava out of the ground, and a &eFluid Tank&r holds it."
	]
	quest.5D23055D9E171C3C.title: "A Bigger Pocket"
	quest.5D23055D9E171C3C.quest_subtitle: "Mekanism: the Basic Bin"
	quest.5D23055D9E171C3C.quest_desc: [
		"One slot, thousands of items. A &eBin&r keeps a big stack of one thing for your machines to take from."
	]
	quest.3C9A599F6F08AF8D.title: "Grown Tin"
	quest.3C9A599F6F08AF8D.quest_subtitle: "Mekanism: circuits and more"
	quest.3C9A599F6F08AF8D.quest_desc: [
		"Tin is thin on the ground too. Grow &etin seeds&r and harvest &e8 tin essence&r."
	]
	quest.27B8F183BF7493CF.title: "Grown Bronze"
	quest.27B8F183BF7493CF.quest_subtitle: "Mekanism: tough and cheap"
	quest.27B8F183BF7493CF.quest_desc: [
		"Bronze is copper and tin, and Mekanism likes it. Grow &ebronze seeds&r and harvest &e8 bronze essence&r."
	]
	quest.7BD8B0BA85C0DE35.title: "Shard of Flame"
	quest.7BD8B0BA85C0DE35.quest_subtitle: "The Nether remembers power. Put it to work."
	quest.7BD8B0BA85C0DE35.quest_desc: [
		"Take what the Nether gave and power what you built. Forge the &6Shard of Flame&r: a core of steel, blaze and fire."
		""
		"&eRecipe:&r a steel casing in the middle, 4 steel ingots on the sides, and a blaze rod in each corner."
		""
		"&7&oThe Oneblock darkens and burns, but not with anger: with purpose.&r"
		""
		"&aClaim the reward&r to wake the next memory: the Ancient City. It needs 3000 broken blocks."
	]
	chapter.1CDBCC8077CB0D93.title: "Act VI: The Memory of Thought"
	chapter.1CDBCC8077CB0D93.chapter_subtitle: [
		"The world must be recorded before it can be restored."
	]
	quest.692895B1CD885149.title: "Crystals That Remember"
	quest.692895B1CD885149.quest_subtitle: "The Ancient City is quiet."
	quest.692895B1CD885149.quest_desc: [
		"&7&oThe quietest memory is also the most dangerous. Sculk spreads from the block and the Warden stirs.&r"
		""
		"Here the old builders hid their greatest knowledge: crystals that remember everything you teach them. Collect &b8 certus quartz crystals&r."
		""
		"Hint: a &ebudding quartz&r block grows crystal clusters beside water. Break the clusters for crystals, and it grows more!"
	]
	quest.3BE8BD8530F2FE73.title: "Wake the Crystal"
	quest.3BE8BD8530F2FE73.quest_subtitle: "Charger and crank"
	quest.3BE8BD8530F2FE73.quest_desc: [
		"A plain crystal only remembers. A &echarged&r crystal can do things. The &echarger&r wakes them up, and a &ecrank&r next to it gives it power when you turn it by hand."
		""
		"Later, your Act V power setup can do the cranking for you."
	]
	quest.1B117084E288373A.title: "A Spark Inside"
	quest.1B117084E288373A.quest_subtitle: "Charged certus quartz"
	quest.1B117084E288373A.quest_desc: [
		"Put crystals in the charger and turn the crank. They glow and hum. Make &b4 charged certus quartz crystals&r."
	]
	quest.507F81246CF96FC6.title: "Fluix"
	quest.507F81246CF96FC6.quest_subtitle: "The wonder crystal."
	quest.507F81246CF96FC6.quest_desc: [
		"Drop a charged crystal, a bit of redstone and a nether quartz into water. They fuse into &dfluix&r, the purple crystal the entire library is built from."
		""
		"Make 8."
	]
	quest.0BB070BBE2891D85.title: "Sand That Thinks"
	quest.0BB070BBE2891D85.quest_subtitle: "Silicon"
	quest.0BB070BBE2891D85.quest_desc: [
		"The library's tiny brains are made of silicon. Grind a certus crystal into dust, and smelt the dust in a furnace."
		""
		"Make 8 silicon."
	]
	quest.4B524F0EFD8093E1.title: "Grown Silicon"
	quest.4B524F0EFD8093E1.quest_subtitle: "Sand that thinks, from seed"
	quest.4B524F0EFD8093E1.quest_desc: [
		"Silicon is the slowest thing to collect in the whole library: sand and certus, smelted, again and again, and the Oneblock only gives sand in small amounts."
		""
		"Or you can plant it. Infuse &esilicon seeds&r and harvest &e8 silicon essence&r, then craft the essence into silicon."
	]
	quest.619FF53F86958EC6.title: "The Inscriber"
	quest.619FF53F86958EC6.quest_subtitle: "Press patterns into things."
	quest.619FF53F86958EC6.quest_desc: [
		"The &einscriber&r stamps circuit patterns into silicon and metal with two metal &epresses&r, one on top and one below. It needs power."
	]
	quest.6BCF69674818D4CC.title: "Press Molds"
	quest.6BCF69674818D4CC.quest_subtitle: "No meteorites this time."
	quest.6BCF69674818D4CC.quest_desc: [
		"The old builders left press molds that you can forge yourself. Put &e8 iron ingots&r around:"
		"&6lapis&r for the calculation press,"
		"&bdiamond&r for the engineering press,"
		"&egold&r for the logic press,"
		"&7silicon&r for the silicon press."
		""
		"Forge all four."
	]
	quest.701E4674DCCF0839.title: "Little Brains"
	quest.701E4674DCCF0839.quest_subtitle: "Logic, calculation and engineering processors"
	quest.701E4674DCCF0839.quest_desc: [
		"Inscribe a press print, then press it together with silicon and the right material: redstone for logic and calculation, and a diamond for engineering."
		""
		"Make 2 of each. Every machine in the library needs them."
	]
	quest.281388118E2D2307.title: "Power for the Crystals"
	quest.281388118E2D2307.quest_subtitle: "The library needs electricity."
	quest.281388118E2D2307.quest_desc: [
		"An &eenergy acceptor&r takes power (FE) from your generators and cables and gives it to the whole library. Add an &eenergy cell&r to store some for later."
		""
		"&7&oEverything you built in the Memory of Fire finally has a purpose.&r"
	]
	quest.400CF31735EA421B.title: "The Library Opens"
	quest.400CF31735EA421B.quest_subtitle: "The Deep Dark listens."
	quest.400CF31735EA421B.quest_desc: [
		"A library has three things: a place to keep things, something to hold them in, and a way to ask for them."
		""
		"Show the Oneblock your first &edrive&r, a &e1k storage cell&r to put in it, and an &eME terminal&r to look inside."
		""
		"&aClaim the reward&r to wake the next memory: the Deep Dark. It needs 3800 broken blocks."
	]
	quest.5AE0044C783C7980.title: "A Bigger Memory"
	quest.5AE0044C783C7980.quest_subtitle: "4k storage cell"
	quest.5AE0044C783C7980.quest_desc: [
		"One cell is a small memory. A 4k cell holds four times as many kinds of items. Each cell is made of a &ehousing&r (quartz glass, redstone, iron) and a &ecomponent&r (processors and crystal)."
		""
		"Make a &e4k storage cell&r."
	]
	quest.4C2180B53B1FE236.title: "Hands for the Library"
	quest.4C2180B53B1FE236.quest_subtitle: "Import, export and storage buses"
	quest.4C2180B53B1FE236.quest_desc: [
		"A library that can't move things is just a pile. An &eimport bus&r pulls items in from chests, an &eexport bus&r pushes them out, and a &estorage bus&r lets the library see a chest's contents."
		""
		"Craft one of each."
	]
	quest.719946D72D55032D.title: "Teach the Library"
	quest.719946D72D55032D.quest_subtitle: "Patterns"
	quest.719946D72D55032D.quest_desc: [
		"The library can learn recipes. A &epattern provider&r holds a recipe and sends the ingredients to a machine. A &epattern encoding terminal&r is where you write them. Hint: it is built from a &ecrafting terminal&r."
		""
		"&7&oTeach it once, and it will never forget.&r"
	]
	quest.1240D46FD89ED501.title: "Hands of Crystal"
	quest.1240D46FD89ED501.quest_subtitle: "Molecular assembler"
	quest.1240D46FD89ED501.quest_desc: [
		"A &emolecular assembler&r follows a pattern and crafts the item by itself. Put two next to your pattern provider and the library can make things on its own."
	]
	quest.62F427853A6EB48D.title: "A Mind That Builds"
	quest.62F427853A6EB48D.quest_subtitle: "Crafting CPU"
	quest.62F427853A6EB48D.quest_desc: [
		"Big jobs need a &ecrafting CPU&r: a block of &ecrafting units&r with a storage block inside to remember the steps. Add a &ecrafting terminal&r to ask for things to be made."
		""
		"Craft 4 crafting units, a 1k crafting storage, and a crafting terminal."
	]
	quest.5759B8BEECC74B38.title: "The Heart of the Library"
	quest.5759B8BEECC74B38.quest_subtitle: "ME controller"
	quest.5759B8BEECC74B38.quest_desc: [
		"Small networks do fine without one, but a &econtroller&r is the heart of a big library. It needs sky stone, a lot of fluix and an engineering processor."
		""
		"&7&oSky stone: the one thing the old builders were never able to find a replacement for.&r"
	]
	quest.2F9CB6A92B52C8B4.title: "Grown Certus"
	quest.2F9CB6A92B52C8B4.quest_subtitle: "Crystals without a meteorite"
	quest.2F9CB6A92B52C8B4.quest_desc: [
		"Certus quartz is the heart of the library. No meteor is coming to drop it. Grow it."
		""
		"Infuse &ecertus quartz seeds&r and harvest &e8 certus quartz essence&r."
	]
	quest.267DF3D0A01D7C0C.title: "Grown Sky Stone"
	quest.267DF3D0A01D7C0C.quest_subtitle: "Stone from a sky that is not there"
	quest.267DF3D0A01D7C0C.quest_desc: [
		"Sky stone is the hard black rock of the old library, and it only falls from the sky. The sky is not helping, so grow it."
		""
		"Infuse &esky stone seeds&r and harvest &e8 sky stone essence&r."
	]
	quest.26C1C166D2D25CFD.title: "Impatient Crystals"
	quest.26C1C166D2D25CFD.quest_subtitle: "Growth accelerator"
	quest.26C1C166D2D25CFD.quest_desc: [
		"A &egrowth accelerator&r makes budding quartz grow crystals much faster. It needs power, and it works on Mystical crops too."
	]
	quest.6E5EE7A008D6624E.title: "Power in a Crystal"
	quest.6E5EE7A008D6624E.quest_subtitle: "Applied Flux"
	quest.6E5EE7A008D6624E.quest_desc: [
		"Applied Flux lets the library store &epower (FE)&r the same way it stores items. Make an FE storage cell, and the whole network can use it."
	]
	quest.25FDF1B8FC964AC2.title: "Gears Feed the Library"
	quest.25FDF1B8FC964AC2.quest_subtitle: "Create Applied Kinetics"
	quest.25FDF1B8FC964AC2.quest_desc: [
		"Your Create machines from Act III can power the library. An &eenergy provider&r turns spinning shafts into ME power."
	]
	quest.129776F36D6B582F.title: "Storing Gas"
	quest.129776F36D6B582F.quest_subtitle: "Applied Mekanistics"
	quest.129776F36D6B582F.quest_desc: [
		"The library can even store the gases from your Mekanism machines. A chemical storage cell holds them like items."
	]
	quest.3242CD21FDA3E4F9.title: "Ask Nicely"
	quest.3242CD21FDA3E4F9.quest_subtitle: "ME Requester"
	quest.3242CD21FDA3E4F9.quest_desc: [
		"An &eME requester&r watches a chest and asks the library to craft whatever is missing. Keep it stocked, and nothing ever runs out."
	]
	quest.50499859568B002C.title: "A Strange Seed"
	quest.50499859568B002C.quest_subtitle: "ExtendedAE"
	quest.50499859568B002C.quest_desc: [
		"The Deep Dark sometimes gives up an &eentro seed&r: a dark crystal that grows things the library has never seen. ExtendedAE's machines are built from it."
		""
		"&7&oSome memories are not yours to finish. Not yet.&r"
	]
	quest.1D18862D683B19CD.title: "Shard of Memory"
	quest.1D18862D683B19CD.quest_subtitle: "Store one of everything."
	quest.1D18862D683B19CD.quest_desc: [
		"A world must be recorded before it can be rebuilt. Teach a 4k cell everything the Oneblock has given, and it becomes the &dShard of Memory&r."
		""
		"&eRecipe:&r a 4k storage cell in the middle, 4 fluix crystals in the corners, 2 engineering processors above and below, and 2 logic processors on the sides."
		""
		"&7&oThe Oneblock goes quiet and listens, the way a person does when they're about to say something important.&r"
		""
		"&aClaim the reward&r to wake the last memory: the End. It needs 5000 broken blocks."
	]
	chapter.114A8CA4D0A77461.title: "Act VII: The Memory of the End"
	chapter.114A8CA4D0A77461.chapter_subtitle: [
		"It was never just restoring the world. It was building a door."
	]
	quest.4BF491984DD813A8.title: "The Block Turns Pale"
	quest.4BF491984DD813A8.quest_subtitle: "End stone, chorus fruit, and Endermen who stare and flee."
	quest.4BF491984DD813A8.quest_desc: [
		"&7&oThe Oneblock turns pale and cold.&r"
		""
		"The last memory is the strangest. The Endermen's &5ender pearls&r are the key to what comes next: pearls fall from them, and they can be grown from Mystical essence too."
		""
		"Collect &e12 ender pearls&r."
	]
	quest.39ABCBCF919DFB6D.title: "Eyes That Leak Purple Light"
	quest.39ABCBCF919DFB6D.quest_subtitle: "Eyes of ender"
	quest.39ABCBCF919DFB6D.quest_desc: [
		"Crack a pearl together with blaze powder and you get an &eeye of ender&r. It floats toward the thing it was made to find."
		""
		"You'll need 12 for the door, plus 4 more for a shard. Make &e12&r now."
	]
	quest.2A68BBD312DDEA5C.title: "A Door, Piece by Piece"
	quest.2A68BBD312DDEA5C.quest_subtitle: "End portal frames"
	quest.2A68BBD312DDEA5C.quest_desc: [
		"&7&oTwelve Eyes of Ender, each one cracked and leaking purple light. The Keeper fits them into a portal frame the block has been giving, piece by piece, all along.&r"
		""
		"Collect &e12 end portal frames&r. They come out of the Oneblock, and the NeoTrader sometimes sells them."
	]
	quest.206642D122087060.title: "Shard of the End"
	quest.206642D122087060.quest_subtitle: "The sixth memory."
	quest.206642D122087060.quest_desc: [
		"Five memories, and the sixth is the strangest: the memory of how things end. Craft the &eShard of the End&r from the things that grow in the End."
		""
		"&eRecipe:&r a shulker shell in the middle, popped chorus fruit on the sides, and an eye of ender in each corner. (Smelt chorus fruit to pop it.)"
		""
		"Keep your 12 eyes for the portal: you'll need 4 more for this shard."
		""
		"&7&oSix memories. Only the thief is left.&r"
		""
		"&aClaim the reward&r. The next chapter, &eAct VIII: The Devourer&r, is where you open the door."
	]
	chapter.7A8DAB250290285D.title: "Act VIII: The Devourer"
	chapter.7A8DAB250290285D.chapter_subtitle: [
		"The world was never destroyed. It was eaten."
	]
	quest.75071F2452400998.title: "Reach Across the Dark"
	quest.75071F2452400998.quest_subtitle: "A bow and arrows"
	quest.75071F2452400998.quest_desc: [
		"The Dragon's crystals sit on tall pillars. You'll shoot them from the ground. Craft a &ebow&r and &e64 arrows&r."
		""
		"Hint: arrows need flint, sticks and feathers. Chickens give feathers!"
	]
	quest.21E0645FE565EC1C.title: "Armor of the Keeper"
	quest.21E0645FE565EC1C.quest_subtitle: "The Dragon bites."
	quest.21E0645FE565EC1C.quest_desc: [
		"Make a full set of &eiron armor&r: helmet, chestplate, leggings and boots. Diamond is better if you can manage it!"
	]
	quest.7F18B144B3802B1C.title: "Golden Courage"
	quest.7F18B144B3802B1C.quest_subtitle: "Golden apples"
	quest.7F18B144B3802B1C.quest_desc: [
		"An apple wrapped in gold heals you faster than anything else. Craft &e4 golden apples&r before you go."
	]
	quest.1E77904349833928.title: "Wings of Iron"
	quest.1E77904349833928.quest_subtitle: "Iron Jetpacks"
	quest.1E77904349833928.quest_desc: [
		"The End's islands float far apart, and the pillars are tall. An &eiron jetpack&r lets you fly, if you keep it charged with power (FE). Use the power setup from Act V!"
	]
	quest.43AB120E1E403807.title: "The Door"
	quest.43AB120E1E403807.quest_subtitle: "Step through."
	quest.43AB120E1E403807.quest_desc: [
		"&7&oThe Oneblock was never just restoring the world. It was building a door.&r"
		""
		"Fit the 12 eyes into the 12 frames, in a ring, and the portal opens. Beyond it is the thief who ate your world."
		""
		"Step through the door and into the End. The thief is waiting."
	]
	quest.226058D9C91665D2.title: "The End is Full"
	quest.226058D9C91665D2.quest_subtitle: "It is not empty at all."
	quest.226058D9C91665D2.quest_desc: [
		"&7&oBeyond the portal, the End is not empty. It is FULL.&r"
		""
		"Floating in the dark are the ghosts of everything the Dragon swallowed: half-dissolved mountains, a village frozen mid-collapse, a river hanging in the air with no banks to hold it."
		""
		"The world was never destroyed. It was eaten, and the Dragon has been digesting it ever since. Click the check when you're ready."
	]
	quest.38EA2A0260EBC0E1.title: "Bottle the Breath"
	quest.38EA2A0260EBC0E1.quest_subtitle: "A spell you can carry."
	quest.38EA2A0260EBC0E1.quest_desc: [
		"The Dragon's breath lingers in glowing purple clouds. Hold a &eglass bottle&r in the cloud and right-click to bottle it. You'll need a bottle of &edragon breath&r later, to bind the Worldseed."
		""
		"Stay out of the cloud while it burns!"
	]
	quest.68C38EDB00572A96.title: "Shatter the Crystals"
	quest.68C38EDB00572A96.quest_subtitle: "The pillars are stomachs."
	quest.68C38EDB00572A96.quest_desc: [
		"The obsidian pillars are not prisons for End Crystals. They are stomachs. Each crystal glows with stolen memory, and while they stand, the Dragon heals by feeding on the world itself."
		""
		"Shoot them down with your bow, one at a time. With each one, a piece of the world flickers and fades from the sky, released back toward the Oneblock."
		""
		"Click the check when every crystal is gone."
	]
	quest.471B9EE17591D65B.title: "The Devourer"
	quest.471B9EE17591D65B.quest_subtitle: "Free what was stolen."
	quest.471B9EE17591D65B.quest_desc: [
		"Shatter the crystals. Free what was stolen. Bring back the Heart."
		""
		"Defeat the Ender Dragon."
		""
		"&7&oWhen the Dragon finally falls, it does not burn away. It breaks open like a geode.&r"
	]
	quest.1359D355AEDF6448.title: "The Dragon's Heart"
	quest.1359D355AEDF6448.quest_subtitle: "The last thing it ate, and the one thing it could never digest."
	quest.1359D355AEDF6448.quest_desc: [
		"Inside the shell, glowing faintly: the &dDragon's Heart&r. It is the world's memory of itself, still whole."
		""
		"Claim it from &eThe Devourer&r, take it home, and keep it safe."
	]
	chapter.1DC309602C655AD5.title: "Act IX: The Worldseed"
	chapter.1DC309602C655AD5.chapter_subtitle: [
		"Six memories, one Heart."
	]
	quest.41BA52F61570192E.title: "Silence"
	quest.41BA52F61570192E.quest_subtitle: "The Oneblock has nothing left to remember."
	quest.41BA52F61570192E.quest_desc: [
		"&7&oThe Keeper returns home with the Dragon's Heart and finds the Oneblock silent for the first time.&r"
		""
		"It has nothing left to remember. Everything it knows is now in your hands: six Memory Shards, one Heart, and every machine you built along the way."
		""
		"Now bring it all together. To forge the &aWorldseed&r you also need the &eSeed's Heart&r: a core of four things. Click the check to see them."
	]
	quest.6F78269E9E167576.title: "The Power of a Star"
	quest.6F78269E9E167576.quest_subtitle: "Reactor: Oritech"
	quest.6F78269E9E167576.quest_desc: [
		"The seed needs power: the power the Keeper generated. A &ereactor rod&r from Oritech holds a little star inside it."
		""
		"Craft an &eoritech reactor rod&r (a plastic sheet and two energite ingots)."
	]
	quest.59F61FE33611A33B.title: "Mana, Distilled"
	quest.59F61FE33611A33B.quest_subtitle: "Infusion: Mystical Agriculture"
	quest.59F61FE33611A33B.quest_desc: [
		"The seed must be infused with the strongest mana there is. You climb a ladder to reach it: every rung needs &e4 of the one below&r and your infusion crystal."
		""
		"inferium &8>&r prudentium &8>&r tertium &8>&r &9imperium&r &8>&r &6supremium&r &8>&r &dinsanium&r"
		""
		"First rung: make &9imperium essence&r. (That is 64 inferium essence in total. Growth accelerators and a harvester pylon will help a LOT.)"
	]
	quest.466BDA412327E54F.title: "Rich Soil"
	quest.466BDA412327E54F.quest_subtitle: "Tier four crops: osmium and nickel"
	quest.466BDA412327E54F.quest_desc: [
		"Imperium essence opens the fourth tier of crops. Two of the metals the Oneblock gives out most grudgingly can now be grown: &eosmium&r for Mekanism and &enickel&r for Oritech."
		""
		"Infuse &eosmium seeds&r and &enickel seeds&r at the altar. Check JEI for the recipes: they want imperium essence and the metal itself."
		""
		"You will need imperium farmland to plant them."
	]
	quest.252C52A44090C306.title: "Higher and Higher"
	quest.252C52A44090C306.quest_subtitle: "Supremium essence"
	quest.252C52A44090C306.quest_desc: [
		"Four imperium around the crystal make one &6supremium essence&r. You will need &e4 supremium&r for the last rung, so the climb is steep: 256 inferium essence for each one."
		""
		"&7&oPatience. The Oneblock has waited a very long time.&r"
	]
	quest.1752CD98B9BB33A3.title: "The Unbreakable Crystal"
	quest.1752CD98B9BB33A3.quest_subtitle: "Master infusion crystal: expensive, and worth it."
	quest.1752CD98B9BB33A3.quest_desc: [
		"Your infusion crystal is worn from the long climb: every craft takes a little of it, and it only lasts a thousand. The last rungs are the hungriest of all."
		""
		"There is a better one. The &6master infusion crystal&r &lnever&r wears out, and it works for every upgrade you will ever make."
		""
		"&eRecipe:&r a supremium gemstone in the middle, 4 prosperity shards on the sides, and 4 supremium essence in the corners. (The gemstone is a prosperity gemstone and 2 more supremium essence.)"
		""
		"&7&oThat is a LOT of supremium. But you only ever make it once.&r"
	]
	quest.31C24A63F1E9C56A.title: "The Last Rung"
	quest.31C24A63F1E9C56A.quest_subtitle: "Insanium essence (Mystical Agradditions)"
	quest.31C24A63F1E9C56A.quest_desc: [
		"Four supremium essence around the infusion crystal make one &dinsanium essence&r: the purple, impossible, final tier of mana. A thousand little seeds, folded into a single drop."
		""
		"You only need &e1&r. If your crystal is nearly worn out, the &6master crystal&r (the optional rung above) saves you from ever running out."
	]
	quest.419C1830679434A8.title: "A Library of Everything"
	quest.419C1830679434A8.quest_subtitle: "Storage: AE2"
	quest.419C1830679434A8.quest_desc: [
		"The seed must remember everything you built. The biggest cell the old builders ever made, a &e256k storage cell&r, can hold a world's worth of things."
		""
		"Each size is built on the one below it: a 256k component needs a 64k one (plus a calculation processor, quartz glass and sky stone dust), and a 64k one needs a 16k one (plus glowstone dust)."
	]
	quest.277E1CF9A9613D27.title: "Bound by Breath"
	quest.277E1CF9A9613D27.quest_subtitle: "Binding: the Dragon's own spell"
	quest.277E1CF9A9613D27.quest_desc: [
		"Finally, the seed needs a binding: a word that holds it all together. The Dragon's own breath is the only thing strong enough."
		""
		"Show the bottle of &edragon breath&r you collected."
	]
	quest.71DA614DA06C0E64.title: "The Seed's Heart"
	quest.71DA614DA06C0E64.quest_subtitle: "Power, mana, memory, and a binding."
	quest.71DA614DA06C0E64.quest_desc: [
		"Put the four together to make the &aSeed's Heart&r."
		""
		"&eRecipe:&r a reactor rod and insanium essence on the top row, a 256k storage cell and dragon breath on the bottom row, in the left two columns of the crafting table."
	]
	quest.5603FEF77824198B.title: "The Worldseed"
	quest.5603FEF77824198B.quest_subtitle: "Six memories, one Heart."
	quest.5603FEF77824198B.quest_desc: [
		"The final recipe. Arrange the six shards around the Dragon's Heart, with the Seed's Heart to wake it. What comes out is small enough to hold in one hand."
		""
		"&eRecipe (any arrangement):&r the &dDragon's Heart&r, the &aSeed's Heart&r, and the six shards: &aGrowth&r, &6Motion&r, &bLife&r, &cFlame&r, &dMemory&r and &eThe End&r."
		""
		"&7&oNothing the Keeper built is lost.&r"
	]
	quest.2DF62698D47D8944.title: "Plant It Where It All Began"
	quest.2DF62698D47D8944.quest_subtitle: "Climb onto the Oneblock one last time."
	quest.2DF62698D47D8944.quest_desc: [
		"&7&oThe Keeper climbs onto the Oneblock one last time and plants it.&r"
		""
		"&6Hold the Worldseed and right-click the Oneblock.&r The seed is used up. A bar fills at the top of the screen while the Oneblock remembers the world as it was: real forests, rivers, caves and ores spread out around your island, bigger and bigger, for a few minutes. Stay close and watch it grow."
		""
		"The Oneblock itself becomes an ordinary grass block. Leave it be."
		""
		"&eWarning:&r this can only be done once. Nothing you built is touched: your island and every build stay exactly as they are, and the new land grows around them. Make sure you're ready!"
		""
		"When the light has faded, click the check below."
	]
	quest.2CD2873438B98312.title: "Restoration"
	quest.2CD2873438B98312.quest_subtitle: "Welcome home, Keeper."
	quest.2CD2873438B98312.quest_desc: [
		"Bedrock spreads beneath the island. Stone rises to meet it. Rivers find their banks, forests unfold across hills that were floating in the End an hour ago, and villages snap back into place with villagers blinking in confusion."
		""
		"&7&oThe sky turns blue, and then, for the first time since the Unmaking, the sun sets.&r"
		""
		"Nothing you built is lost. The farms, the factories, the mana gardens and the crystal networks all stand where they were, now resting on solid ground in a living world."
		""
		"&aThe world was not restored around your work. It was restored because of it.&r"
	]
	quest.24EF6B962E18B5E9.title: "What Remains"
	quest.24EF6B962E18B5E9.quest_subtitle: "The world remembers itself now."
	quest.24EF6B962E18B5E9.quest_desc: [
		"Where the Oneblock stood, a single block remains, cool and quiet, no longer hungry to be broken."
		""
		"The world is ordinary again: night and day, creepers in the dark, caves waiting to be found. You are free to explore it, mine it, build on it, and live in it like any other world."
		""
		"&7&oBut somewhere far away, past the edge of the new map, a single End Crystal still glows on a pillar no one has found yet.&r"
		""
		"&6The world remembers itself now. The Keeper will make sure it never forgets again.&r"
		""
		"&7Made for a Keeper, with love, by her family.&r"
	]
	chapter.1FD8A266340CB306.title: "Act X: The Restored World"
	chapter.1FD8A266340CB306.chapter_subtitle: [
		"The sun sets. The bees hum. The world is yours."
	]
	quest.3755C775E9C931D9.title: "Open Country"
	quest.3755C775E9C931D9.quest_subtitle: "Nothing is hungry any more."
	quest.3755C775E9C931D9.quest_desc: [
		"&7&oFor the first time, the Keeper steps off her island on purpose.&r"
		""
		"The world is real now: forests, rivers, caves and ores, all copied from the memory of the old world. Nothing has to be broken to wake it up."
		""
		"Wander. Look at things. Everything in the old story is still here, and so is something new: &ethe world has things in it that the Oneblock never told you about.&r"
		""
		"Click the check when you are ready to go exploring."
	]
	quest.46077F905CCF0B7C.title: "Which Way Is Home?"
	quest.46077F905CCF0B7C.quest_subtitle: "A compass always remembers the island."
	quest.46077F905CCF0B7C.quest_desc: [
		"You can go a long way now. A &ecompass&r points at the place the world began, so you can always find your way back to the island."
		""
		"&eRecipe:&r 4 iron ingots around 1 redstone dust."
	]
	quest.5C2D0CD82EAC32FF.title: "Cartographer"
	quest.5C2D0CD82EAC32FF.quest_subtitle: "Write down what you find."
	quest.5C2D0CD82EAC32FF.quest_desc: [
		"A compass tells you where home is. A &emap&r tells you where everything else is."
		""
		"&eRecipe:&r a compass surrounded by 8 paper makes an empty map. Hold it, and walk around: it draws itself."
		""
		"&7&oThe old world was written down by someone, once. Now it is your turn.&r"
	]
	quest.56BB7AB9A2C94BC2.title: "Black Rain"
	quest.56BB7AB9A2C94BC2.quest_subtitle: "Oritech: crude oil"
	quest.56BB7AB9A2C94BC2.quest_desc: [
		"Somewhere out in the new land, black liquid is &egushing out of the ground&r like a fountain. It is &ecrude oil&r, the leftovers of very old, very buried forests, and Oritech knows what to do with it."
		""
		"Oil wells are much more common in &edeserts&r, so that is the best place to look. Fill a bucket from the fountain."
		""
		"&eHint:&r a bucket is 3 iron ingots in a V. Click the oil with the empty bucket. A Pump can drain a whole well later on."
		""
		"&7&oBlack, thick, and humming with old sunlight.&r"
	]
	quest.248CA23A2E584EFB.title: "Oil to Power"
	quest.248CA23A2E584EFB.quest_subtitle: "Oritech: the Fuel Generator"
	quest.248CA23A2E584EFB.quest_desc: [
		"That bucket of black oil is not just for looking at. The &eFuel Generator&r from Oritech burns it directly and turns it into steady power."
		""
		"Feed it with a pipe or a bucket of crude, and run a cable out. A Pump placed on an oil well can fill your tanks."
		""
		"&7&oSunlight from a forest older than the Oneblock, burning once more.&r"
	]
	quest.4D27C6C316880766.title: "Cracking Black Rain"
	quest.4D27C6C316880766.quest_subtitle: "Oritech: the Refinery"
	quest.4D27C6C316880766.quest_desc: [
		"Crude oil burns, but it is better split into its parts first. The &eRefinery&r takes crude and separates it into lighter fuels, such as diesel, and other useful liquids."
		""
		"Refined fuels last much longer in the Fuel Generator than crude does, so a refinery beside your pump is worth the effort."
		""
		"&eIt needs:&r refinery modules to hold the tanks, a motor, steel and a cauldron."
	]
	quest.7256E2D9E2257063.title: "Catch the Sun"
	quest.7256E2D9E2257063.quest_subtitle: "Oritech: the Solar Panel"
	quest.7256E2D9E2257063.quest_desc: [
		"&7&oOil is old sunlight. This is new sunlight.&r"
		""
		"Oil runs out. The sun does not. the &eSolar Panel&r from Oritech is a 3x3 &emultiblock&r that unfolds in the daytime and turns light into power."
		""
		"It needs a &eclear view of the sky&r and daylight, and it folds up and sleeps at night. Better &emachine cores&r in the structure make it produce more."
		""
		"&eRecipe:&r a basic generator, an advanced battery, fluxite and a flux gate. Pair it with a battery to keep your machines running after dark."
		""
		"&eShopping list:&r platinum, nickel, electrum and steel. All four have &eMystical Agriculture&r crops, so a farm can supply them. &eFluxite&r comes from grinding platinum, or from charging amethyst shards."
	]
	quest.17F69A7BEC35E85D.title: "The Humming"
	quest.17F69A7BEC35E85D.quest_subtitle: "Something is buzzing in the flowers."
	quest.17F69A7BEC35E85D.quest_desc: [
		"Listen for a soft buzzing in the flowery places. Bees have come back, and they live in &ebee nests&r hanging from trees."
		""
		"Find a nest that is dripping honey and use &eshears&r on it to collect &ehoneycomb&r."
		""
		"&eTip:&r put a &ecampfire&r under the nest first. The smoke keeps the bees calm so they will not sting you."
		""
		"&eShears:&r 2 iron ingots, diagonal."
	]
	quest.7C57B22E4521240E.title: "Golden and Sticky"
	quest.7C57B22E4521240E.quest_subtitle: "A bottle of honey."
	quest.7C57B22E4521240E.quest_desc: [
		"With the nest full and the bees calm, hold an empty &eglass bottle&r up to it to scoop out &ehoney&r instead of honeycomb."
		""
		"Honey is a snack that cures poison, and it is also very, very sticky."
	]
	quest.0A0F265870BA699E.title: "A Hive of Your Own"
	quest.0A0F265870BA699E.quest_subtitle: "Bees who stay."
	quest.0A0F265870BA699E.quest_desc: [
		"You can invite bees to live near you. A &ebeehive&r holds bees and gives you honey whenever you want it."
		""
		"&eRecipe:&r 6 planks and 3 honeycomb. Put it near flowers, and wait for the bees to find it."
		""
		"&7&oThe world remembers the bees. They remember you.&r"
	]
	quest.48620E01FC879FC3.title: "Sticky Block"
	quest.48620E01FC879FC3.quest_subtitle: "Four bottles, one very sticky cube."
	quest.48620E01FC879FC3.quest_desc: [
		"Four honey bottles make a &ehoney block&r. Things stick to it, and you slide down its sides slowly, which is great for building slides and traps."
	]
	quest.5FD0F19823B0EDA3.title: "The Atom Smasher"
	quest.5FD0F19823B0EDA3.quest_subtitle: "Actually Additions: Atomic Reconstructor"
	quest.5FD0F19823B0EDA3.quest_desc: [
		"&7&oSome things only become what they are meant to be when you hit them with light.&r"
		""
		"The &eAtomic Reconstructor&r fires a beam that &etransforms&r whatever it hits: dropped items, and even blocks. It is the heart of Actually Additions."
		""
		"It needs &bpower (FE)&r and a &credstone pulse&r to fire. Look it up in JEI to see everything it can change."
		""
		"&eRecipe:&r an iron casing, iron ingots and redstone dust."
	]
	quest.0617EABB3609F4EC.title: "Red Light"
	quest.0617EABB3609F4EC.quest_subtitle: "Restonia Crystal"
	quest.0617EABB3609F4EC.quest_desc: [
		"Shoot a pile of &eredstone dust&r (or a block of it) with the Reconstructor and it grows into a &cRestonia Crystal&r: a deep red gem full of energy."
		""
		"Restonia is what &ecoils&r, &eenergizers&r and half of the Actually Additions machines are built around."
	]
	quest.52BED9A1C6E07FA1.title: "Blue Light"
	quest.52BED9A1C6E07FA1.quest_subtitle: "Palis Crystal"
	quest.52BED9A1C6E07FA1.quest_desc: [
		"The same trick works on &elapis lazuli&r. The beam turns it into a &9Palis Crystal&r."
		""
		"Look for Palis in the recipes of the item-moving machines in Actually Additions."
	]
	quest.0D22E4E661C1EEC9.title: "Black Light"
	quest.0D22E4E661C1EEC9.quest_subtitle: "Void Crystal"
	quest.0D22E4E661C1EEC9.quest_desc: [
		"Even humble &ecoal&r can be changed. Hit it with the beam and it becomes a &8Void Crystal&r, dark as the space between stars."
		""
		"Void crystals go into the &estealthy&r parts, such as the upgrade that makes laser relays invisible."
		""
		"&7&oNot everything the old world lost was lost by accident.&r"
	]
	quest.39E1C28943D7AD38.title: "A Field of Yellow"
	quest.39E1C28943D7AD38.quest_subtitle: "Canola"
	quest.39E1C28943D7AD38.quest_desc: [
		"Out in the fields, a tall plant with bright yellow flowers: &ecanola&r. It is grown from &ecanola seeds&r, which you can find by sifting dirt or buy at a market, and plant like wheat."
		""
		"Harvest a bunch. It is not food, it is &efuel&r."
	]
	quest.110CC22D7B2654E6.title: "Squeeze"
	quest.110CC22D7B2654E6.quest_subtitle: "The Canola Press"
	quest.110CC22D7B2654E6.quest_desc: [
		"Put canola in the &eCanola Press&r, give it power, and it squeezes out &eoil&r."
		""
		"The press needs an &eadvanced coil&r and an &eEnori Crystal&r (a reconstructed &eiron block&r), so the Reconstructor has earned its keep."
	]
	quest.1E5C7D980A8F4B60.title: "Let It Stand"
	quest.1E5C7D980A8F4B60.quest_subtitle: "The Fermenting Barrel"
	quest.1E5C7D980A8F4B60.quest_desc: [
		"Plain canola oil does not burn well. Pour it into a &eFermenting Barrel&r and wait: it turns into &erefined&r canola oil."
		""
		"&7&oGood things take time. So does fuel.&r"
	]
	quest.2080638CE2E59DD4.title: "Green Oil"
	quest.2080638CE2E59DD4.quest_subtitle: "The Oil Generator"
	quest.2080638CE2E59DD4.quest_desc: [
		"Seed, flower, press, barrel: now it pays off. The &eOil Generator&r burns refined canola oil and makes steady power."
		""
		"Pipe the oil in from the barrel, and run a cable out. Unlike an oil well, a field of yellow flowers never runs out."
	]
	quest.7074C3059526A743.title: "Fire and Clay"
	quest.7074C3059526A743.quest_subtitle: "Productive Metalworks: fire bricks"
	quest.7074C3059526A743.quest_desc: [
		"&7&oA hotter fire needs a better oven.&r"
		""
		"The big forge is built from &efire bricks&r. Mix sand and clay into &efire clay&r, then smelt it in a furnace."
	]
	quest.265F992D8683DAC3.title: "The Foundry"
	quest.265F992D8683DAC3.quest_subtitle: "A multiblock forge"
	quest.265F992D8683DAC3.quest_desc: [
		"This is the big one. A &eFoundry&r is a hollow box built from fire-brick blocks with a &eFoundry Controller&r in the wall. Inside it, metal melts into liquid."
		""
		"Add a &eFoundry Tank&r so you can see inside, and a &eLiquid Heating Coil&r to supply heat."
		""
		"&eController:&r a blast furnace and fire bricks."
		"&eCoil:&r a bucket, a copper ingot and a fire brick."
		""
		"&7Any dye colour of foundry block works the same.&r"
	]
	quest.2CD50042ADB79103.title: "Pour It Out"
	quest.2CD50042ADB79103.quest_subtitle: "Taps and casting tables"
	quest.2CD50042ADB79103.quest_desc: [
		"Molten metal is no use sitting in a tank. A &eFoundry Tap&r on the side of the foundry lets it pour out into a &eCasting Table&r to make things, or a &eCasting Basin&r to make blocks."
		""
		"Melt two metals together in the foundry and it &ealloys&r them: copper and tin make bronze, iron and melted coal make steel."
	]
	quest.4F17C344F10E184E.title: "A Mould for Ingots"
	quest.4F17C344F10E184E.quest_subtitle: "Cast a cast"
	quest.4F17C344F10E184E.quest_desc: [
		"To pour an ingot you need something to pour it &einto&r: an &eIngot Cast&r. It is never used up, so you only make one."
		""
		"Put any &eingot&r on the casting table and pour &emolten steel&r over it. The ingot is used up and you get the cast."
		""
		"&eSteel:&r melt iron and coal in the foundry and the two alloy together."
	]
	quest.742DA9865B151574.title: "Pale Gold"
	quest.742DA9865B151574.quest_subtitle: "Alloy and cast electrum"
	quest.742DA9865B151574.quest_desc: [
		"&7&oTwo things that are good alone, and better melted together.&r"
		""
		"Put &egold&r and &eredstone&r in the foundry together and they alloy into &emolten electrum&r. Pour it over your ingot cast to make an &eElectrum Ingot&r."
		""
		"The foundry can alloy many more metals than this, so electrum is only the first of many."
	]
	quest.1FF8116C6BA53457.title: "The Keeper's World"
	quest.1FF8116C6BA53457.quest_subtitle: "It is yours now."
	quest.1FF8116C6BA53457.quest_desc: [
		"You have a map, a bucket of something old and black, and bees who have decided to stay."
		""
		"There are no more quests that have to be done, and no more blocks that have to be broken. The world is not going anywhere. Build in it, farm in it, get lost in it, and come home when the sun goes down."
		""
		"&7&oThe Oneblock sleeps. The world is awake.&r"
		""
		"&6Thank you for remembering it, Keeper.&r"
	]
	reward_table.0A240E2E6AF05FC3.title: "Seeds of Memory"
}
