# 依赖
node_modules/

# 一次性调研残渣（体积大、可重跑，结论已提炼进 research/*.md）
research/tmp/

# pi 本地会话状态（goal 状态机、事件日志）
.pi/

# 本地密钥 / 环境变量
.env
.env.local

# 误存成文件的命令输出（`some-cmd --full-page` 的重定向产物）
--full-page

# 构建产物
dist/
build/

# 站点数据产物（由 scripts/build-site-data.mjs 生成，可重跑）
# 例外：它是零构建站点唯一的运行时依赖，必须随仓库分发
!site/data.json

# 浏览器验证临时 harness
harness.html
.scratch/*.png

# 构建产物（dist/ 由 scripts/build-site-html.mjs 生成）
site/index.html

# 免费层探测/压测的一次性产物（结论已写进 pipeline.mjs 与 ADR，产物可重跑）
research/probe-out/
research/probe-run.log
research/free-tier-probe.json

# 并行翻译的一次性产物（译文在 patches/ 里才是产物，这里是中间态）
research/par-out/
research/concurrency-probe.json

# 本地批量流水线的状态与中间产物
research/local-batch-state.json
research/scan-merged-28816.tsv

# serv00 第二批跑过的 78 个包清单（可重跑，留着做复盘）
research/batch2-serv00-slugs.txt

# 基准源新形态：每个包一个 <slug>.tar.gz（scripts/lib/baseline.mjs 打，可复现）。
# 解包目录 research/packs/<slug>/ 转为本地中间态，永不入库；
# 注意：**已跟踪**的旧目录不受新增 ignore 影响（git 仍跟踪已入库文件）。
research/packs/*/
research/shards/
research/logs/

# quark-sync 的失败清单走 CI artifact / 本地排查用，不进仓库（成功结果在 quark-mirrors.json）
research/quark-sync-failures.json

# 本地排查中间产物（agent 跑校验/测试的落盘输出，不进仓库）
.scratch/

# 本地工作目录：坏包研究残留、agent 会话状态、抓取缓存、临时产物。
# git add -A 会把它们误收进提交（2026-10-25 实测四项都堆在工作区），显式忽略。
research/packs-dead/
.workbuddy/
browse/
TMP/

# wrangler/miniflare 本地开发缓存（KV/Cache 的 sqlite）：曾被误跟踪，每次本地
# 跑 wrangler 都把工作区弄脏（2026-10-25 收官场已 git rm --cached 移出索引）。
.wrangler/
