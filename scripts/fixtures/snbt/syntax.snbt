# 顶层注释：SNBT 语法覆盖夹具
{
	# 字符串转义
	escaped: "quote \" backslash \\ newline \n tab \t unicode \u00a7"
	singleQuoted: 'single "quoted" value'
	# 数字类型后缀
	byte: 1b
	short: 2s
	long: 3L
	float: 1.5f
	double: 2.5d
	int: 42
	negative: -7
	# 数组
	intArray: [I; 1, 2, 3]
	byteArray: [B; 1b, 2b]
	list: [1, 2, 3]
	stringList: [
		"a"
		"b"
	]
	# 嵌套 compound / list
	nested: {
		inner: {
			deep: "value"
		}
		list: [
			{
				x: 1.0d
			}
		]
	}
	bare: some.bare.value
	empty: {}
	emptyList: []
}
# 末尾注释
