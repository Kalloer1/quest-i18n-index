		}
		{
			dependencies: ["24382CF8CF448B40"]
			description: ["转化石板是一种可以随身携带的转化台！EMC和物品将始终随你同在。"]
			id: "538878174A36026A"
			tasks: [{
				id: "77A6123AB6CE0ABB"
				item: "projecte:transmutation_tablet"
				type: "item"
			}]
			x: -2.5d
