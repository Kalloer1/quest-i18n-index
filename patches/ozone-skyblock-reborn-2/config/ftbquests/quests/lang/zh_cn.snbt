		""
		"详情请参阅书籍及设置方法。"
	]
	quest.091A0CAD568B9566.title: "基础反应堆组件"
	quest.091C5591FC5A4116.quest_desc: ["鹅卵石可以通过鹅卵石碎片合成。"]
	quest.092088B386465246.quest_desc: ["一种精炼的红石基材料，用于制作高级组件和后期机器。"]
	quest.0949229274785FB0.quest_desc: ["加载区块，这样你不在时，东西也能继续运作。3x3区域。"]
	quest.0955CDE0AF99C578.quest_desc: ["将青金石和水放入再处理器中会生成蓝晶石。"]
	quest.09616105B2147867.quest_desc: [
		"铁刺是一种可以放置在实体方块任意一侧的基础方块。当生物和玩家接触到铁刺时，会受到伤害。生物会掉落经验和它们正常的掉落物。"
		""
		"Mob Grinding Utils 是一款鼓励玩家创造新方法来刷怪以获取掉落物和经验的模组。该模组包含一个完全模块化的系统，供玩家探索和运用，以充分发挥其刷怪塔的最大效益。"
	]
	quest.09616105B2147867.quest_subtitle: "生物群系刷怪工具包"
	quest.096BF1C5A9A0F0B4.quest_desc: ["就像 Farmer's Delight 里的炉子一样！"]
	quest.097A73052FFD1BFA.quest_desc: ["连接到排水口，将熔化的金属从熔炉中取出。"]
	quest.097B7BF8B0CBC549.quest_desc: ["阻止最多8格内实体的传送。可安装在实心块的任意一侧。右键激活/停用。"]
	quest.098EE0E9BA10FE16.quest_desc: [
		"用于炼金消化的容器，升华所必需。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.099682D4CF5D3CFF.quest_desc: ["放置在管道上，用外立面将其覆盖！"]
	quest.09B16A1A15C81262.quest_desc: ["升级后的熔炉，基础烹饪时间为 40"]
	quest.0A765530617B2B94.quest_desc: [
		"混沌方块和反物质方块受限，耐久度为16。"
		""
		"用魔杖右键点击方块 → 它会变成一个 Enlivened Block 实体。"
		""
		"被激活的实体可被其他模组捕获/复制，从而提供该方块的可持续来源。注意：若生成器不复制NBT，此方法无效。"
		""
		"使用生物囚禁工具作用于你的新实体，并在工业前序生物复制器中进行复制。"
	]
	quest.0AA83FF3BDF54213.quest_desc: [
		"EnderIO 导管可以放置在其他导管所在的同一方块中。"
		""
		"注意：EnderIO 线缆有时会导致卡顿。如果出现这种情况，请考虑更换其他类型的线缆。"
	]
	quest.0AA83FF3BDF54213.title: "导管 - 第一级"
	quest.0ACD4EB32D1616F4.quest_desc: ["奥斯特伦可以在火星上找到。"]
	quest.0AE2BFC6D900AD0F.quest_desc: ["扩大风扇的影响范围——高度、宽度和距离。"]
	quest.0AE2BFC6D900AD0F.title: "风扇升级组件"
	quest.0AFC1C633F5E6D38.quest_desc: ["Tier 2 - 可存储 200 个物品栏。"]
	quest.0B3E66925374481B.quest_desc: ["每秒生产和维持 100 万 EMC。"]
	quest.0B49965D7D3DF4F9.quest_desc: [
		"用石砖建造一个传送门（形状与标准下界传送门相同），并用催化剂激活。"
		""
		"Undergarden 是一个位于主世界基岩深处的黑暗地下世界。这里的植物适应了环境，无需光照即可随处生长。奇特的生物将这片黑暗土地视为家园，但它们正遭受着源自混沌神秘领域的入侵性怪物 Rotspawn 的侵扰。"
	]
	quest.0B49965D7D3DF4F9.quest_subtitle: "地下花园（The Undergarden）"
	quest.0B49965D7D3DF4F9.title: "深入地下花园 (Into the Undergarden)"
	quest.0B5848C907E7753B.quest_desc: ["连接两个或多个末地箱来运输和存取物品！用染料上色以配对箱子。"]
	quest.0B5848C907E7753B.quest_subtitle: "末地存储系统"
	quest.0BB68FE5EE0D7D63.quest_desc: [
		"无需直接接触即可将抽屉链接到它（可通过升级扩展范围）。"
		""
		"要将抽屉与抽屉控制器连接，需要使用链接工具。"
	]
	quest.0BC9DE119AF74A7A.quest_desc: ["Fluix ME 玻璃线缆是最简单的线缆，可传输电力和多达 8 个频道。它有 17 种不同颜色，默认是 Fluix 色，并且可以用 16 种染料中的任意一种染成任何颜色。"]
	quest.0BD2E8188BB912CB.quest_desc: [
		"Crafters 是 RFTools 添加的机器，只要有配方、所需组件和 RF 能量，就能自动合成物品。多步骤合成可以在一台机器内完成，仅受配方槽位数量的限制。"
		""
		"Crafter Tier 3 可以记住 8 个配方。"
	]
	quest.0BEC6FB4D100F23E.quest_desc: [
		"比前两个等级都快！速度更快了！"
		""
		"将火把放在地上，右键单击以打开GUI。"
	]
	quest.0C3DB4A72DC396C5.quest_desc: ["腐肉是一种玩家可食用的食物，但有高风险造成饥饿。由僵尸掉落。"]
	quest.0C3DB4A72DC396C5.quest_subtitle: "Minecraft"
	quest.0C71AB75B63CC9A4.quest_desc: ["它不会消耗耐久度。用绿土锄右键泥土块，会在该块为中心的9x9区域放置农田。"]
	quest.0C80CE674E69189A.quest_desc: ["对被 Mob Masher 造成伤害的生物施加效果 - 每种最多 10 个升级。"]
	quest.0C80CE674E69189A.title: "Masher 升级组件"
	quest.0CA6B94A84718B7D.quest_desc: [
		"E 计划的起点，就在你的脚下。"
		""
		"通过用贤者之石（按 C）合成，你发现合成产生的高温能让你用催化剂（即木炭或煤炭）来冶炼 7 种粉尘或矿石。"
		""
		"贤者之石还能将泥土变为沙子，沙子变为草地。石头也能变成鹅卵石。为其充能（按 V 充电，shift-V 放电）会影响更广阔的区域。"
		""
		"可用于制作各种炼金物品和材料，贤者之石在过程中不会被消耗。"
	]
	quest.0CAFAE72AAEDE844.quest_desc: ["通过再加工蓝铜矿和青金石获得。"]
	quest.0D1BC89C6E1168E2.quest_desc: [
		"盐代表物体的“身体”或“物理物质”。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.0D1BC89C6E1168E2.title: "炼金术盐类"
	quest.0D2292A3FEECE0BB.quest_desc: [
		"并非易事，但若你决定尝试，回报将十分丰厚。在征服暮色森林的过程中收集奖杯。进度页面可以帮助你追踪进展。"
		""
		"&2注意：此任务为可选任务！&r"
	]
	quest.0D2292A3FEECE0BB.title: "暮色奖杯"
	quest.0D30B2FB51D802FD.quest_desc: ["来自太阳的能量，但更先进！"]
	quest.0D455041F06B11CF.quest_desc: ["向通量网络中添加能量"]
	quest.0D65B3E94CC15633.quest_desc: ["模型达到基础或以上后，即可使用模拟舱运行模型模拟。模拟将始终生成通用预测，并可能根据模型准确性生成生物预测。模型等级越高，准确性越高，自我认知模型可达99.5%。运行模拟需要能量（取决于模型类型）和催化剂物品，通常是预测矩阵。"]
	quest.0DA6AB6E6D1BF58C.quest_desc: ["可让你自动化复杂的合成配方。将物品栏放在顶部，即可自动将物品送入合成器。"]
	quest.0DA822417944D807.quest_desc: ["杀死一只鸡并烹饪其肉以获得熟鸡肉"]
	quest.0DA822417944D807.quest_subtitle: "Minecraft"
	quest.0DDA934D37D96D6C.quest_desc: ["多区块结构的一部分。排水口用于将液体排出熔炉。"]
	quest.0E012180FF171EA3.quest_desc: ["压力管的最大等级限制。"]
	quest.0E0DCFDDD225CBE9.quest_desc: ["被暗物质包围听起来是个好主意！它能吸收大量伤害。穿上这套盔甲，你几乎无敌。有时，你似乎能在盔甲的光泽中看到动静。"]
	quest.0E2C104568720EE9.title: "罪恶符文 (Sinful Runes)"
	quest.0E352A7DB0D0E65D.quest_desc: ["用基岩建造一座房子。"]
	quest.0E7A8DAC2DBAEB4D.quest_desc: ["将你的操作范围延伸至终端。距离为16格。"]
	quest.0EBFD58D6F06DFE7.quest_desc: ["每个等级都会增加更多的存储栏位和升级栏位。"]
	quest.0EC5F7CAC60A570B.quest_desc: ["尽量不要去想这件事，否则会更糟"]
	quest.0EC9E0D3EA56886C.quest_desc: [
		"使用高级连接器可以克服普通连接器的限制，从任何其他一侧访问熔炉的底部。高级连接器还有其他优势。它们允许更高的物品和流体传输速度（每次操作最低10个游戏刻，而非20个），并且可以存储更多的RF（这意味着它们也能传输更多的RF）。"
		""
		"注意：高级能量连接器仍无法从另一侧提取能量。原因是发电机本身会推动能量，而不会通过另一侧推动。但向另一侧输入能量是可行的。"
	]
	quest.0EF2FB5DA629DB4A.quest_desc: ["即使穿着暗物质盔甲，情况危急时你还是会受到明显伤害。你决定像优秀的炼金术士一样，用红物质来解决问题，却发现这套新红物质盔甲能阻挡大量伤害，除了被动能量推搡的感觉外，你几乎感觉不到任何东西。但是……或许你还可以更进一步？"]
	quest.0F146A084493D964.quest_desc: ["右键将木头变为去皮原木，再右键即可立即采集。"]
	quest.0F2C31359D60538C.quest_desc: ["每个等级都会增加更多的存储栏位和升级栏位。"]
	quest.0FCE294048DE59F6.quest_desc: ["能量立方可用于存储大量RF。等级越高，存储的RF越多。1级！"]
	quest.10233A3DC0B81EA4.quest_desc: ["放入抽屉中可存放近乎无限的物品数量"]
	quest.10233A3DC0B81EA4.quest_subtitle: "功能性存储系统"
	quest.1045FDFE8AF10401.quest_desc: ["储存能量；也可以是多方块结构。可在远距离和不同维度间传输"]
	quest.10540A8680E2AEF8.quest_desc: [
		"改进的升级添加了：分配模式。"
		""
		"升级物品可以增强管道，提高其传输速度、效率，或增加过滤和堆叠大小等功能。"
	]
	quest.107E79EE3E89F382.quest_desc: [
		"使用对应类型的炼金硝石复制炼金硫磺 - 配方见JEI。点击带有通量发射器的基座以将其绑定。放置在汞催化剂上为基座提供能量。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.107E79EE3E89F382.title: "宗教改革"
	quest.108159E6D64C856A.quest_desc: [
		"Tainted Gold 是一种被更深层、更黑暗气息祝福的材料，这意味着它们在注入时需要更长时间，但消耗更少的气息。请注意，使用材料的方块形式也能完成相同的注入。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.10CE847A01CF2909.quest_desc: [
		"带有升级插槽的 Ender IO 机器需要电容器才能运行。"
		""
		"电容器可以根据其基础修饰符，提升机器的速度、射程或能量存储。"
		""
		"等级：6"
	]
	quest.10ED928F001EA290.quest_desc: ["使用可配置卡片，通过激光网络传输物品、流体、能量或红石的主方块。"]
	quest.10F60275E430ACDE.quest_desc: ["锤子的合成材料 - 5x5x1"]
	quest.1108CD5FBC79FE9C.quest_desc: ["合成时必须使用正确等级的注入器，请查看JEI。融合合成需要能量。这是最高等级的注入器。"]
	quest.112AE0A9B15941D2.quest_desc: ["这些管道可以升级，使其速度更快，并且可以过滤。"]
	quest.112AE0A9B15941D2.title: "管道匠模组"
	quest.117E924B8AD92073.quest_desc: ["4个电路压机用于在刻印机中制作处理器。使用神秘农业来制作这些压机。"]
	quest.117E924B8AD92073.title: "刻印机压制机"
	quest.117F5E5B6230A038.quest_desc: ["能赋予不同增益的特殊苹果！将鼠标悬停在苹果上并按住 Shift 键查看其效果。"]
	quest.11E0906BD605061E.quest_desc: ["带盖电缆在玩法上并无优势，但如果你喜欢带盖外观，可以将其作为替代选择。"]
	quest.11ED9715C659F22E.quest_desc: ["升级后的熔炉，基础烹饪时间为 5"]
	quest.11F12A03CE38A8C7.quest_desc: [
		"Iron Chests 模组为原版游戏中的各种金属添加了不同大小的箱子！随着等级提升，可存储的物品数量也会增加！"
		""
		"铜质箱子由原版箱子升级而来。"
	]
	quest.11F12A03CE38A8C7.quest_subtitle: "铁质箱子"
	quest.11F34F6309A89E31.quest_desc: ["Tier 3 - 可存储 300 个物品栏。"]
	quest.120A4A99099FE5E4.quest_desc: ["无限容量的存储方块，可提供和储存任何流体，且无数量限制。"]
	quest.1221C842C42C7F66.quest_desc: [
		"驱动器是将存储单元接入以用于网络存储的设备。它有10个插槽，每个插槽可容纳一个单元。"
		""
		"如果出于某种原因需要，你可以用漏斗或AE2总线等物品物流系统来推拉其库存中的方块。"
		""
		"可以用 Certus Quartz Wrench 来旋转它。"
	]
	quest.1230550E4A5B23AC.quest_desc: [
		"右键可立即挖掘矿石脉。挖掘（左键）模式如下（按G循环）："
		"- 标准：每次破坏一个方块"
		"- 3x tall shot: 垂直方向一次性破坏3个方块"
		"- 3x wide-shot: 水平方向一次性破坏3个方块"
		"- 3x long-shot: 一次性破坏你前方一条线上的3个方块"
	]
	quest.1231D9AF9F07AD12.quest_desc: ["接收来自物质传输器的传送玩家。"]
	quest.1245AA386AB7F298.quest_desc: [
		"Crafters 是 RFTools 添加的机器，只要有配方、所需组件和 RF 能量，就能自动合成物品。多步骤合成可以在一台机器内完成，仅受配方槽位数量的限制。"
		""
		"Crafter Tier 1 可以记住 2 个配方。"
	]
	quest.1248104A9F7A3F32.quest_desc: ["Iron Jetpacks 是一款功能丰富且易于使用的现代喷气背包模组。背包的等级越高，性能越好。线圈是背包制作过程中不可或缺的一部分。请参见 JEI。"]
	quest.125C064F10CFBF60.quest_desc: [
		"筛子和锤子：插入升级以快速处理大量材料。需要能量（RF）。"
		""
		"Compactor：筛分后压缩材料。任何自动筛分装置的完美补充！需要能量（RF）。"
	]
	quest.125C064F10CFBF60.quest_subtitle: "Ex Machinis"
	quest.125C064F10CFBF60.title: "Flux 升级组件"
	quest.125E5D92A7D84955.quest_desc: ["沉浸式工程学的多方块机器。以3x3排列组装，并用工程师之锤右键。使用煤炭，产出焦炭和焦油。详情见JEI或手册。"]
	quest.125E5D92A7D84955.title: "焦炭炉 Coke Oven"
	quest.1273EAF9DC0A7479.quest_desc: ["在Aether中通过挖矿发现。"]
	quest.12A5561178489FCC.quest_desc: [
		"控制器是ME网络的路由中心。没有它，网络就是“临时的”，最多只能有8个使用频道的设备。"
		""
		"一个ME网络中不能有两个控制器。"
		""
		"控制器每个面提供 32 个通道。"
		""
		"控制器每块需要 6 AE/t 才能运行。每块控制器可存储 8000 AE，因此较大的网络可能需要额外的储能。详情请见能量。"
		""
		"多方块控制器可以以相当自由的形式建造。"
		""
		"不过，有几条规则必须遵守："
		"- ME 网络中的所有控制器方块都必须连接，否则方块会变红。"
		"- 控制器的大小必须在 7x7x7 以内，否则会变为红色。"
		"-控制器最多只能在1个轴向上有2个相邻方块；若有方块违反此规则，控制器将禁用并变红。"
	]
	quest.12AE4AE8955D0364.quest_desc: ["升级版的空气压缩机。"]
	quest.12B32970DF51871F.quest_desc: ["将鼠标悬停在物品上并按住 Shift 键以查看属性。"]
	quest.12D23F12FACE2F36.quest_desc: ["升级后的熔炉，基础烹饪时间为 20"]
	quest.12E388A337027D9F.quest_desc: ["毁灭装置能让你摧毁一大片区域。"]
	quest.12F60B0E98F9D419.quest_desc: ["Tier 4，最高等级 - 可存储 500 个物品栏。"]
	quest.13010CE647E918A3.quest_desc: [
		"带有升级插槽的 Ender IO 机器需要电容器才能运行。"
		""
		"电容器可以根据其基础修饰符，提升机器的速度、射程或能量存储。"
		""
		"等级：7"
	]
	quest.130380166BF98207.quest_desc: ["一种将物品填充流体的多方块结构，例如将空瓶变成药水，或用润滑剂和其他液体浸泡工具。"]
	quest.130380166BF98207.title: "瓶装机"
	quest.13267CC3ECCC01A5.quest_desc: ["这些物品可用于简化在AE存储中添加和移除灵魂的操作。完整详情请参阅指南（将鼠标悬停在物品上并按住“G”键）。"]
	quest.13267CC3ECCC01A5.quest_subtitle: "应用灵魂模组 (Applied Souls)"
	quest.13267CC3ECCC01A5.title: "AE 灵魂"
	quest.137F5A524DB75A97.quest_desc: ["药水材料，可在下界堡垒中找到。"]
	quest.1388958122E58F71.quest_desc: ["药水材料，击杀恶魂即可获得。"]
	quest.138FFE0F7A3437A7.quest_desc: ["奇点储罐是一种基础流体储罐，可容纳32桶任何流体。用它来储存你的生物农场产生的经验值！你还可以制作经验值抽取奇点储罐，将玩家的经验值储存为液态经验值。"]
	quest.13E86FB30A4078F6.quest_desc: ["Froststeel 可以在 Undergarden 的 Frostfield 生物群系中找到。建议使用 Nature's Compass 来寻找该生物群系。"]
	quest.14582B862A91C1E6.quest_desc: ["每个等级都会增加更多的存储栏位和升级栏位。"]
	quest.14ADE52746F0F97D.quest_desc: [
		"当所需的灵气量超过灵气缓存的存储能力，需要频繁补充时，可以使用灵气宝库——一种存储容量是灵气缓存三倍的更高级版本。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.14F9F9F05968992D.quest_desc: ["成功登陆水星以完成此任务。需要Tier 3火箭。这颗行星非常炎热！"]
	quest.151A5E0BF0ED82FC.quest_desc: ["一种无需任何燃料即可为相连机器和网络提供无限能量的无限能源。"]
	quest.153E5E7C7B50FBE8.quest_desc: ["锤子的合成材料 - 3x3x3"]
	quest.156FE2D8DEE4B866.quest_desc: [
		"用于灌注物品，也用于合成乌瑟里姆水晶。"
		""
		"注意：此过程可用漏斗实现自动化，输入和输出与原版熔炉类似。"
	]
	quest.157B60FE82028B25.quest_desc: [
		"要使用框架方块，请执行以下操作："
		""
		"- 用几乎任何实心方块右键点击该方块，使其外观相同。"
		"- 用流体容器右键点击方块，使其看起来像容器中的流体。"
		"- 右键点击方块并使用萤石粉，使其产生光亮。"
		"- 用 Framed Hammer 右键点击方块以移除伪装。"
		"- 用空流体容器右键方块以移除流体伪装。"
	]
	quest.159B578700BEC915.quest_desc: ["合成组件。可升级到下一阶段，请参见JEI。"]
	quest.15AF28F4684F51EF.quest_desc: [
		"要获得下界岩，先在水桶上放置一个水桶，放在菌丝体方块上（通过点击泥土方块上的菌丝体孢子生成）。然后将女巫水和岩浆在石桶中混合，即可创造下界岩。"
		""
		"你也可以用岩浆和女巫水制作下界岩生成器——就像用岩浆和水制作鹅卵石生成器一样！"
	]
	quest.15B720B7F41B48E7.quest_desc: [
		"右键可立即根据充能等级挖掘方块 (V, shift+V)。"
		""
		"- 已禁用"
		"- 3x3x2"
		"- 5x5x3"
		""
		"不会挖掘泥土或砾石。它也是一种强大的武器，可以作为工具一次挖掘一个方块。"
	]
	quest.1642C50313F491BA.quest_desc: ["充电器（Charger）的增强版 - 并行充电。"]
	quest.1642C50313F491BA.quest_subtitle: "ExtendedAE"
	quest.165D83DA8A47584E.quest_desc: ["控制电路用于制作多种Mekanism物品和机器。等级8。"]
	quest.169D553ED480C513.quest_desc: ["存储组件是所有AE2单元的核心，决定了单元容量。每个等级容量提升4倍，消耗3个上一等级的组件。"]
	quest.16A0E92787B231F4.quest_desc: ["累了一天？来泡个舒服的澡，缓解一下压力吧！"]
	quest.16BD3B7720BB6FC5.quest_desc: ["Klein Star Vier 最多可容纳 3,200,000 EMC，也用于制作 Klein Star Sphere。"]
	quest.16F2FE28C9730B3C.quest_desc: ["用链接工具左键点击抽屉频率，然后右键点击另一个末地抽屉，它们的内容就会同步。"]
	quest.16F347B287BA5A57.quest_desc: [
		"将炼金硫磺、盐和汞重新组合成物品的装置 - 配方请见JEI。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.16F347B287BA5A57.title: "孵化"
	quest.1714FDAD185BC9EC.quest_desc: ["在每个星球上建造一个基地。你应该能不用太空服呼吸了。"]
	quest.172A4BF34F6B369D.quest_desc: ["一套完整的无限盔甲将赋予你创造模式飞行和无敌效果 - 即使是面对 /kill 命令也不例外。"]
	quest.172D9D871C55C62F.quest_desc: [
		"一种加速方块的方法，就像“瓶中时光”一样。在背包里待得越久，能节省的时间就越多！多次点击一个方块，可以加速得更快！"
		""
		"[ \"如需自动化加速，请查看此任务 \", { \"text\": \"此处\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"21FD5B61FBBCA913\" } } ]"
	]
	quest.172D9D871C55C62F.quest_subtitle: "Gadgets Against Grind"
	quest.175ABA1A1E81745D.quest_desc: ["用于存储和传输RF能量的物品"]
	quest.177B785A9ECE8F52.quest_desc: ["允许炼金术士使用转换桌的力量，而无需将其放置在表面上。"]
	quest.178C361C75E72C69.quest_desc: ["存储组件是所有AE2单元的核心，决定了单元容量。每个等级容量提升4倍，消耗3个上一等级的组件。"]
	quest.17B3F0BE4B8E85AA.quest_desc: ["Klein Star Drei 最多可容纳 800,000 EMC，也用于制作 Klein Star Vier。"]
	quest.17BA6849B6B75EE5.quest_desc: ["由史莱姆（蓝色黏液状生物）掉落。"]
	quest.17C31E1EEEC41B2E.quest_desc: ["锤子的合成材料 - 5x5x5"]
	quest.17D11E1D85B0544A.quest_desc: ["可让你自动化复杂的合成配方。将物品栏置于顶部，即可自动将物品拉入合成台。"]
	quest.17E258709C662348.quest_desc: ["红物质是ProjectE添加的一种组件。作为一种高EMC值的物品，它适合作为能量凝聚器的模板来储存EMC。作为一种合成组件，红物质用于合成高端机器、工具、盔甲和配饰。"]
	quest.18172E2A9B99A66D.quest_desc: [
		"一种使用溶剂——氯化铵，从物品中提取炼金硫磺的装置。"
		""
		"将炼药锅放在熔炉上。用烈焰棒填满熔炉来加热炼药锅！将硝石填满炼药锅。放入物品以开始过程 - 配方请见JEI。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.1830BED4361BCD12.quest_desc: ["铁木锭是通过熔炼原始铁木获得的物品。"]
	quest.18353B88A8A3CB0B.quest_desc: ["合成时必须使用正确等级的注入器，请参见JEI。融合合成需要能量。注入器可升级至下一级。"]
	quest.185C4CC2B44FE1B1.quest_desc: ["使用基础附魔器来选择要施加在装备上的附魔。"]
	quest.18603E2137F4A2BE.quest_desc: ["无限容量的存储方块，可提供和储存无限量的任何气体。"]
	quest.18B4F54EE5BDD901.quest_desc: [
		"高容量电缆，可承载32个频道，而标准电缆只能承载8个。但它不支持总线，因此在使用总线或面板前，必须先降级到密度较低的较小电缆（如Fluix ME玻璃电缆或Fluix ME智能电缆）。"
		""
		"密集电缆会略微覆盖通道的“最短路径”行为，通道会先找到到密集电缆的最短路径，然后通过该电缆找到到控制器的最短路径。"
	]
	quest.191D4B8350A5B75C.quest_desc: ["比普通导出总线快8倍——物品吞吐量高。"]
	quest.191D4B8350A5B75C.quest_subtitle: "ExtendedAE"
	quest.1931453DB6A06D5B.quest_desc: [
		"Crafters 是 RFTools 添加的机器，只要有配方、所需组件和 RF 能量，就能自动合成物品。多步骤合成可以在一台机器内完成，唯一限制是配方槽的数量。"
		""
		"Crafter Tier 2 可以记住 4 个配方。"
	]
	quest.1953C0F0AE829809.quest_desc: [
		"将治愈水晶转化为通量形态。现在无需熔炉即可使用神学机器！用通量发射器点击机器即可绑定，可选择多个机器。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.19645F031C69B3EB.quest_desc: ["Prosperity Shards 用于制作模组中的许多核心物品，包括 Resource Seeds、Essence Tools 和 Essence Armor。"]
	quest.19653FCE91F4A285.quest_desc: [
		"一种可从物品中提取炼金汞的装置。"
		""
		"将蒸馏器放在熔炉上。用烈焰棒填满熔炉来加热蒸馏器！"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.197DA8087ED0110A.quest_desc: ["存储升级，等级2。悬停物品查看详情。可升级为钻石升级。"]
	quest.198889933E765856.title: "季节性符文 (Seasonal Runes)"
	quest.19F535AFD9F48A8A.quest_desc: [
		"要制作觉醒的超贵金属，你需要收集名为认知粉尘的稀有材料。这可以通过使用附魔了神秘启蒙的精髓武器来击杀凋零或末影龙完成。"
		""
		"你还需要建造一个特殊的祭坛。你需要一个觉醒祭坛、觉醒基座和精华容器。将祭坛放置在世界中会显示基座和精华容器的放置位置。"
	]
	quest.1A0DA69E34F2D7E8.quest_desc: ["将空白PCB暴露在紫外线下，使其向成品PCB方向发展的机器。"]
	quest.1A1B057049B2AB58.quest_desc: ["合成核心可用于合成多种终局物品。所有用途请参见JEI。"]
	quest.1A1B057049B2AB58.quest_subtitle: "扩展合成系统 (Extended Crafting)"
	quest.1A378D0D3AA38021.quest_desc: ["Powah 的独特合成方法，使用物品和能量来合成配方"]
	quest.1A40E97E9775C979.quest_desc: ["这套太空服除了能抵御寒冷环境外，还能保护你在高温天体（金星、水星）上免受伤害。"]
	quest.1A40E97E9775C979.title: "下界合金太空服"
	quest.1A518FF85B798517.quest_desc: [
		"长久以来，研究人员一直困惑于灵气及其在世界的存在。过去，他们曾使用瓶子收集灵气，以便在灵气肉眼可见时能更详细地分析它。但不久后，不明真相的平民开始抱怨：“其他科学家已经有瓶子的用途了，这会引起问题”，他们说道。"
		""
		"因此，为了屏蔽所有无意义的胡言乱语，他们创造了瓶塞：一种与瓶子相似但略有不同的器具，只需手持它与空气互动即可专门收集气场。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.1AB8244D9A52E7F4.quest_desc: [
		"使用 energizing orb 制作。用于制作硬化阶 Powah 物品的配方。"
		""
		"还有更高效的合成方法，请查看 JEI。"
	]
	quest.1AE2DA480EB23947.quest_desc: ["用于制作塑料。请参阅JEI和手册。"]
	quest.1AE506C74AF7D407.quest_desc: ["最优秀的龙族科学家已经找到了复制混沌碎片的方法。将混沌碎片分解成最小的颗粒，你就可以将其转化为可精炼成大型混沌碎片的东西。"]
	quest.1B071BEFDEC69615.quest_desc: ["冷冻器能将冰晶转化为更高效的火箭燃料。1桶冷冻燃料相当于3桶普通燃料。冰晶可在月球、火星和冰川等寒冷天体上找到。"]
	quest.1B146007CA8A3052.quest_desc: [
		"Tier 1 火箭将允许你前往月球旅行。"
		""
		"别忘了带上你的宇航服和氧气瓶！"
	]
	quest.1B17A64C7D6C88F7.quest_desc: ["无线传输电力，为背包中的物品充电！"]
	quest.1B1E9AFA7D0B0970.quest_desc: ["将升级安装在熔炉中，使其更快并禁用合金化！"]
	quest.1B1E9AFA7D0B0970.title: "升级内容"
	quest.1B20650DA11BD5F6.quest_desc: ["最大方块数：128"]
	quest.1B4A6ACF29C9DD46.quest_desc: ["组合器允许玩家用8个粉尘合成一个原矿块。将原矿粉尘放在顶部槽位，底部放一些鹅卵石，即可组合成原矿块。每次操作需要1000能量。支持铜、铁、锡、锇、黑曜石（仅需4个）和金粉尘。此外，1个燧石可合成1个砾石块，16个红石/青金石可合成其原矿。"]
	quest.1B5C8B86CFDBB051.quest_desc: [
		"完成任务时，物品在背包中会被自动检测。请务必将已完成的任务物品留在背包中，直到 FTB Quests 检测到为止 -> 未检测到完成 = 无奖励！"
		""
		"任务奖励包括金币。金币可在金币商店兑换奖励袋！部分任务还会有随机奖励。"
		""
		"点击任务书中的物品或在 JEI 中搜索以查找合成方法。你也可以将鼠标悬停在物品上时按 \"r\"。按 \"u\" 查看物品的用途。"
		""
		"你可以“扭动”来生长树木和某些作物（在电脑上多次按 shift，并确保粘滞键已禁用），也可以进行脉状挖掘（模组名为 FTB Ultimine，默认键位是波浪键 `）。"
		""
		"要吃各种各样的食物，才能获得超过五个基础心！(吃完10种不同的食物后，你就能获得第一个额外的心)"
		""
		"你不必完成一整页的任务才能继续，但请注意，有些任务必须先完成其他任务才能开始。"
	]
	quest.1B5C8B86CFDBB051.quest_subtitle: "重要信息在此！"
	quest.1B6FEBB8D9440617.quest_desc: ["可以锤成粉末。用筛子来获取资源！"]
	quest.1B7E82C08A1FF1B6.quest_desc: ["穿上盔甲后，除了太空服外，也能在太空中呼吸氧气（确保盔甲有合适的附魔/模组/升级以在太空生存）。此氧气仅在寒冷的天体上有效。"]
	quest.1B940854A058386C.quest_desc: ["将有机物转化为生物质燃料"]
	quest.1BAB46320F75A91B.quest_desc: [
		"作为一名魔法植物学家，在深入研究光环之前，直接运用自然的力量会大有裨益。森林仪式利用金粉的特性，将天然成分的力量直接融入一棵新鲜的、正在生长的树木中，将其吞噬，同时将其转化为有用的工具和物品。"
		""
		"要建造此仪式，需按照指南书中的配置放置金粉，并在周围放置用于承载材料的木制支架。然后，将正确的树苗置于中央，通过某种肥料或时间的推移，树苗的生长将触发仪式。注意，仪式需要特定类型的树苗，因此需谨慎操作。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.1BAB46320F75A91B.title: "森林的仪式"
	quest.1BDB8EDBC8F52E9E.quest_desc: ["外观上与Fluix ME Covered Cable有些相似，但它们通过可视化电缆上的通道使用情况来提供诊断功能。这些通道表现为沿着电缆黑色条纹的彩色发光线条，让你了解网络中各通道的使用情况。对于普通智能电缆，前四个通道显示为与电缆颜色匹配的线条，后四个显示为白色线条。对于密集智能电缆，每条条纹代表4个通道。"]
	quest.1BE5549EE1591D23.quest_desc: ["多区块结构的一部分。用于衬里熔炉，在冶炼和铸造过程中抵抗高温。"]
	quest.1C06B9727A06A7D8.quest_desc: [
		"CPU 的合成需要多个方块，必须是无间隙的实心长方体。它们由多个组件构成。"
		""
		"每个CPU必须至少包含1个合成存储方块（事实上，最小可行的CPU就是一个1k合成存储）。"
		""
		"所有标准单元格大小（1k、4k、16k、64k、256k）都提供合成存储。它们存储合成所需的原料和中间产物，因此CPU处理含更多原料的合成任务时需要更大或更多的存储。"
	]
	quest.1C30D7DF9779DD9C.quest_desc: ["一种将矿石等物品研磨成粉末的机器，可实现基础的矿石翻倍。"]
	quest.1C3512BA7B488C67.quest_desc: [
		"注意：Mekanism 模组中的大多数机器都可以升级为工厂。"
		""
		"冶金注入器是Mekanism科技树的第一步。冶金注入器是一种用于生产钢锭、青铜锭、富化合金和玄武岩锭的机器。"
	]
	quest.1C707A653F0D6D54.quest_desc: [
		"无限制，耐久度无限。"
		""
		"用魔杖右键点击方块 → 它会变成一个 Enlivened Block 实体。"
		""
		"被激活的实体可被其他模组捕获/复制，从而提供该方块的可持续来源。注意：若生成器不复制NBT，此方法无效。"
		""
		"使用生物囚禁工具作用于你的新实体，并在工业前序生物复制器中进行复制。"
	]
	quest.1CFE1ABB42819D7E.quest_desc: ["生物风扇旨在让玩家能将生物推至四面八方（包括垂直方向）。生物风扇方块有3种升级选项来扩展其能力——宽度、高度和距离修饰器。"]
	quest.1CFE1ABB42819D7E.quest_subtitle: "Mob Grinding Utils"
	quest.1D0B7AA898DB7CD4.quest_desc: ["生成无限岩浆（缓慢）！放入流体抽屉中"]
	quest.1D1E009C95C47AC9.quest_desc: ["制作Packaged Auto机器所需的材料。"]
	quest.1D33C862778D1437.quest_desc: ["所有传入此处的物品、流体或能量都将被清空。"]
	quest.1D48817AB6A06772.quest_desc: [
		"Mystical Agricuture 中有六个等级的种子。"
		""
		"Tier 6 的种子需要 insanium essence 来制作，并且需要相应的 crux 才能生长。"
	]
	quest.1D96A6DC181BE5ED.quest_desc: ["用于建造和升级发电机、能量电池及其他电力相关设备的合成组件和储能物品。"]
	quest.1DA6EB3AB3035A0F.quest_desc: ["将龙晶与能量及其他物品融合后制成的终局材料。"]
	quest.1DC74FAB7A521DB0.quest_desc: ["击败坚守者后掉落的一件物品。"]
	quest.1DD12302EB92FF24.quest_desc: ["Calorite 可以在金星上找到。"]
	quest.1E0F3E9A7AE4D2F5.quest_desc: ["自动化PCB的创建过程。"]
	quest.1E0F3E9A7AE4D2F5.title: "气动装配装置"
	quest.1E6EE65389C1E9D7.quest_desc: ["一种由龙尘提炼而成的强大材料，用于制造高级能源系统、工具和顶级科技。"]
	quest.1EC14A5DEA09E671.quest_desc: ["由10,000颗祖母绿制成"]
	quest.1EE7658030431E1A.quest_desc: [
		"手册将指导你如何完成这一系列任务。"
		""
		"Powah 是一个科技模组，增加了生成、储存和传输……你猜到了……能量的各种方式！"
		""
		"模组特性："
		"- 能量存储（能量单元，末地网络）"
		"- 末地网络 (末地单元, 末地, 传送门)"
		"- 发电机（熔炉发电机、岩浆发电机、热电发电机、太阳能电池板、反应堆）"
		"- 其他机器（Discharger、Energy Hopper、Player Transmitter）"
	]
	quest.1EE7658030431E1A.quest_subtitle: "Powah"
	quest.1F40FE21EC2AEF22.quest_desc: ["一把攻击力为4的剑。"]
	quest.1F40FE21EC2AEF22.quest_subtitle: "Minecraft"
	quest.1F894A409738DBF4.quest_desc: ["需要这台机器来制作更高级的物品和机器，例如更复杂的机器框架。"]
	quest.1F901B2CE53B3F58.quest_desc: [
		"Ingot of the Skies 是一种注入了神圣能量的强大金属。向众神献上召唤之魂，以及一块注入了能量的铁锭或一块被污染的黄金锭。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.1FCBF2B893EEA7D9.quest_desc: ["控制电路用于制作多种Mekanism物品和机器。第6级。"]
	quest.1FCF25002DEC80BA.quest_desc: ["能赋予不同增益的特殊苹果！将鼠标悬停在苹果上并按住 Shift 键查看其效果。"]
	quest.1FD449A4EB2E1A06.quest_desc: ["反应室是一种消耗大量电力来高效处理材料的机器。它用于制作《高级AE》中所需的各类物品，并为其他模组提供高效的配方。"]
	quest.1FD449A4EB2E1A06.quest_subtitle: "高级自动化系统 (Advanced AE)"
	quest.202A8B47E8AE3376.quest_desc: ["LaserIO 旨在复刻 EnderIO 的机制——让你通过同一个方块面与物品、流体、能量和红石进行交互！此外，每个方块面可放置 9 种独立配置，为资源运输物流带来近乎无限的可能。"]
	quest.202A8B47E8AE3376.quest_subtitle: "激光输入输出接口"
	quest.202C97EC62E3FD47.quest_desc: ["在空中潜行+右键切换模式。右键抽屉可切换选项。"]
	quest.20AA10B19EA9E15F.quest_desc: [
		"总有一天，你会意识到熔炉效率太低，消耗的资源也太多。Extraneous Firestarter 能加速熔炉，只要放置在熔炉任意一侧即可，同时提供足够的热量来冶炼任何材料。注意，虽然会消耗所需的灵气，但自然水平可能会降至负值，导致收益递减。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.20E32463368357B4.quest_desc: ["存储升级4级。悬停物品查看详情。可升级至最大存储升级。"]
	quest.210491F044A5BC31.quest_desc: ["再也不用火把来照亮你的室内了！"]
	quest.210F3A7CABB85DC8.quest_desc: ["右键可立即收割树叶、羊毛和蘑菇（来自牛蘑菇）。充能等级（V，shift+V）控制根据充能状态所收割的区域大小。"]
	quest.21460544B92AF9B4.quest_desc: ["将烈焰棒注入能量，使其能提供更强的动力，持续时间更长"]
	quest.216A0851EAD69DCF.quest_desc: [
		"冲向天空！用于制作木制喷气背包。"
		""
		"喷气背包使用Forge能量让玩家飞行。更高等级的喷气背包速度更快，能量容量也更大。"
		""
		"喷气背包需要Forge能量才能运行。它们可以使用任何支持Forge能量的模组的充能块进行充能。"
		""
		"使用按键绑定（默认 V）可以开启和关闭喷气背包引擎。引擎开启后，按空格键即可飞行。"
		""
		"每个喷气背包都有悬停模式，可以实现更精确的移动。启用此模式（默认键位 H）后，你的喷气背包将在原地悬停，并带有不同程度的下坠。悬停时，喷气背包会消耗能量。"
		""
		"你可以使用节流控制来改变喷气背包的速度。这可以通过节流控制键位（默认是 , 和 .）来实现。"
		""
		"喷气背包可以作为配件装备在身体槽位中。"
		""
		"注意：如果玩家在配饰栏和胸甲栏都佩戴了喷气背包，则以胸甲栏的喷气背包为准。"
	]
	quest.216A0851EAD69DCF.quest_subtitle: "铁质喷气背包"
	quest.219B7ED265976105.quest_desc: ["在下界挖掘下界石英矿石以获得它。"]
	quest.21C27FA410438560.quest_desc: ["催化剂用于复杂的合成配方。它们在层级越高时，合成难度也越大。"]
	quest.21D2F298B32D5B95.quest_desc: [
		"Chisel 为游戏增添了大量装饰性方块。对于喜欢 Minecraft 建筑方面的玩家来说，这个模组非常实用。"
		""
		"获取新方块主要通过一种工具，即凿子。"
		""
		"右键单击可打开凿刻界面。"
	]
	quest.21D2F298B32D5B95.quest_subtitle: "现代凿子模组"
	quest.21D5CF2BC04467D4.quest_desc: ["将水转化为氧气。也可用于填充太空服胸甲和氧气罐中的氧气。"]
	quest.21ECEC8F3D1691F1.quest_desc: ["灌注水晶是一种用于制作更高级别精华的物品。有普通灌注水晶和升级后的大师灌注水晶。两者主要区别在于各自的使用次数。"]
	quest.21FD5B61FBBCA913.quest_desc: [
		"&2中盘游戏加速游戏进程！后续还有时间囊和火炬兽等选项。&r"
		""
		"Industrial Foregoing: Souls 使用从守卫中提取的灵魂来加速你的机器。为此，你需要用装有蓝色透镜的灵魂激光底座从守卫中提取灵魂。如往常一样，静滞室会是你的好帮手。"
		""
		"储存一些灵魂后，你需要放置一个指向目标方块的精神脉冲器，并用灵魂管道将其连接到灵魂激光底座。向脉冲器施加红石信号即可停止其工作。"
		""
		"每个灵魂持续15秒，使机器速度加快4倍。"
		""
		"此整合包包含 Applied Souls，提供在 AE 网络中添加和移除灵魂的方法。"
	]
	quest.21FD5B61FBBCA913.quest_subtitle: "工业先驱的灵魂 (Industrial Foregoing Souls)"
	quest.21FD5B61FBBCA913.title: "灵魂刷新加速模组 (Souls Tick Acceleration)"
	quest.2201A958694C7F35.quest_desc: ["线缆（和连接器）有四种不同颜色（和一个基础版本）。它们用于区分相邻的不同网络（防止线缆相互连接）。控制器会适应其周围找到的第一种彩色线缆的颜色，并记住该颜色（除非该颜色被完全移除）。"]
	quest.220E723BF056F6D6.quest_desc: ["组件用于制作催化剂。越高级别的组件，制作难度越高。"]
	quest.2226EAAF3B304A2D.quest_desc: [
		"要给你的螺旋桨帽充电，请在 JEI 的 Charging Gadgets 里查找 \"Charging Station\"。"
		""
		"Propeller Hats 是一个添加了多个等级的螺旋桨帽的模组，可用于飞行。它们由 FE 供电，因此你需要某种充电器来为它们充电。"
	]
	quest.2230558554C39B34.quest_desc: ["由10,000个锡锭制成"]
	quest.22350912A0D709A2.quest_desc: [
		"生长加速器用于加快上方种植植物的生长速度。它们可以堆叠在一起以提供额外的生长速度。"
		""
		"每个等级范围更大，但提供的生长量相同。放置每个等级的最大值与仅使用最高等级同样高效。注意，范围是相对于作物下方1格而言的。"
		""
		"将它们放置在作物所种植物方块的正下方。对于农作物，即农田方块下方。在其下堆叠更多生长加速器，可进一步提升植物生长速度。"
	]
	quest.22350912A0D709A2.title: "生长加速器"
	quest.224198469D23B8E6.quest_desc: ["Tier 1. 1.21.1 中 Draconic Evolution 仅有的盔甲部件是胸甲。需要模组才能使其生效，请参见 JEI。"]
	quest.22576BE5F4FD9868.quest_desc: ["在每个维度中至少使用一次数字矿工。"]
	quest.2283BAFB726F6AF7.quest_desc: ["可让你自动化复杂的合成配方。将物品栏放在顶部，即可自动将物品送入合成器。"]
	quest.228FC9A995457D3C.quest_desc: ["此区块生成器的速度为 32"]
	quest.22B16AE1B2684DCB.quest_desc: [
		"&2想加快游戏前期的游戏速度，就在JEI里找找时空囊吧！&r"
		""
		"[ \"另请参阅：\", { \"text\": \"灵魂跳动加速\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"21FD5B61FBBCA913\" } } ]"
		""
		"这是一个小巧简单的模组，添加了多种火把，可用于提高方块实体的更新频率。换句话说：它们能让机器运行得更快，作物生长得更快，等等..."
		""
		"将火把放在地上，右键单击以打开GUI。"
	]
	quest.22CEF75979B60798.quest_desc: [
		"烹饪锅是一种工作台，既可以用来准备大量食物，也可以用来储存食物。将其放置在任何合适的热源（篝火、明火、岩浆、炉灶等）上方时，它会开始冒泡，表示已准备好烹饪。"
		""
		"煎锅是一种武器和便携式烹饪站，可以手持或使用。煎锅能处理任何篝火食谱，烹饪每个物品的时间约为原时间的20%。"
		""
		"砧板是一个工作台，玩家可以用合适的工具在上面将一种物品分解成多种产物。"
	]
	quest.22D54134581E5904.quest_desc: ["大家都知道，雪比沙子和泥土更好。试着在雪块上种植甘蔗吧。"]
	quest.22ED4DB8D9CF0A86.quest_desc: ["Ex Machinis机器的升级。将鼠标悬停在升级上并按住Shift键以查看其效果。"]
	quest.232205BA1A02FFF0.quest_desc: ["暗物质是 ProjectE 添加的一种组件。用于制作暗物质工具和盔甲，也是创造红物质的组件。"]
	quest.234B200716CEE3F1.quest_desc: ["风力涡轮机的巨型叶片利用风力发电。每台涡轮机需要1x5x1的小区域（水平方向一个方块）。无论昼夜、晴雨，机器都能发电，但涡轮机必须能清晰看到天空（塔顶的转子罩上方）。发电量与海拔高度成正比。"]
	quest.23553993065249FB.quest_desc: ["一种特殊物品，可在开启机遇方块时让你选择幸运值。"]
	quest.23839A415A10A611.quest_desc: [
		"强化版能让你建造比以往更庞大、更出色的反应堆，以产生和储存巨量的能量！"
		""
		"反应堆的最大尺寸为高48，宽32。"
		"涡轮机的最大尺寸为高32，宽32。"
		""
		"详情请参阅书籍及设置方法。"
	]
	quest.23839A415A10A611.title: "加固反应堆组件"
	quest.239C026A9B572140.quest_desc: ["一种精炼的末影基材料，用于制作高级组件和后期机器。"]
	quest.23F0F9483CB3167B.quest_desc: [
		"圣所之灯不仅装饰性强，还有一个实用功能：当接收到红石信号时，它能让周围约48格范围内的所有怪物完全停止生成，与光照等级无关。红石信号的强度决定了作用范围。每次阻止怪物生成，都会消耗少量。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.2475C81B8ABC19BE.quest_desc: ["在另一个拥有安全基地的维度中，建造一个应用能源系统。"]
	quest.24C4A019D07A1F8B.quest_desc: ["击败末影龙！注意，末影龙可以用4个末地水晶重新召唤。"]
	quest.24C4A019D07A1F8B.quest_subtitle: "Minecraft"
	quest.24C6C85F207E7409.quest_desc: ["净化室使用氧气将矿石和碎片提炼成团块。每种矿石可生成3个团块，而每种碎片只能生成1个团块。"]
	quest.24C964CEB5B34A22.quest_desc: ["Productive Metalworks 为 Minecraft 带来了强大而沉浸的熔炼与铸造系统，让玩家能以更真实高效的方式处理矿石和锻造锭。借助此模组，你可以建造名为“熔炉”的多方块结构，它是一座大型工业熔炉，能一次性处理大量矿石。"]
	quest.24C964CEB5B34A22.quest_subtitle: "高效金属工艺"
	quest.24D65F6FA7D60C0D.quest_desc: ["大师融合水晶还有一个好处，就是可以融合整块的精华，这在融合大量精华时会很有用。无限耐久！"]
	quest.250D50E877136CE2.quest_desc: [
		"用于储存大量能量的物品。"
		""
		"最大尺寸的能源增强器高32格，宽32格。"
	]
	quest.250D50E877136CE2.title: "Energizer 组件"
	quest.2516E592916EFBEB.quest_desc: ["升级后的精华需要使用上一等级的精华和灌注水晶来制作。用于创造5级种子。（专家模式下需要水晶）"]
	quest.251E78ED5A7DF9BF.quest_desc: ["能量立方体可以储存大量RF。等级越高，储存的RF越多。4级！"]
	quest.2530A93E24EE02E2.quest_desc: ["创意模式飞行，无需额外付费！"]
	quest.253B925F5877067D.quest_desc: ["用筛子和筛网筛选砾石以获取矿石块。"]
	quest.25771C0683859846.quest_desc: ["全自动建造凋灵农场，批量生产下界之星。"]
	quest.2591C17114EF1CFC.quest_desc: ["复制终极奇点的一个绝佳方法"]
	quest.2595D390AED8C101.quest_desc: ["钻石宝箱由黄金宝箱升级而来。"]
	quest.25B907E3FDFC236C.quest_desc: [
		"Tinkering Table 用于为本质装备添加/移除增强。增强可应用的工具/盔甲类型列在增强工具的提示框中。"
		""
		"每个增强都有等级。该等级是增强可应用的最低装备等级。你可以将低等级的增强应用到更高等级的装备上。"
		""
		"每件装备都只能有一定数量的增幅槽位。大多数物品只有一个增幅槽位，但觉醒的超贵金属装备有2个！"
	]
	quest.25D8343DDA1A1E7E.quest_desc: [
		"用于将物品转化为纯EMC，再转化为炼金术士所选物品的合成台。以这种方式将物品转化为纯EMC，会将物品的特性烙印在炼金术士的灵魂上。"
		""
		"只要拥有足够的 EMC，炼金术士就能从任何转换台或转换石中提取已知物品。转换台或转换石会向炼金术士显示其绑定的 EMC 数量。"
	]
	quest.25DC4BBF99C776D8.quest_desc: [
		"用于将固体转化为液体。"
		""
		"流体化器的最大尺寸为高16，宽16。"
	]
	quest.25DC4BBF99C776D8.title: "流体化组件"
	quest.2613272C3850463D.quest_desc: ["利用太阳能（太阳）来产生RF。第4级！"]
	quest.262DAA98C18CE427.quest_desc: [
		"细胞可以由一个存储组件和一个外壳，或者用外壳配方围绕一个存储组件制作而成。"
		""
		"物品存储单元最多可容纳 63 种不同类型的物品，并提供所有标准容量。"
		""
		"流体存储单元最多可容纳5种不同类型的流体，并提供所有标准容量。"
	]
	quest.262DAA98C18CE427.title: "细胞住房"
	quest.26587BB45FC82006.quest_desc: ["利用太阳能（太阳）来产生RF。第五级！"]
	quest.267A446CB02207F1.quest_desc: ["Pipez 模组中管道的最大速度！"]
	quest.267A446CB02207F1.quest_subtitle: "管道匠模组"
	quest.269CB18DF9B7D5E3.quest_desc: ["由烈焰棒制成的发电机"]
	quest.26AE724D46A9430B.quest_desc: [
		"原版Minecraft生物的美化收藏毛绒玩具。若想挑战，就试着把它们全部收集起来吧！"
		""
		"注意：这是唯一一个能让你自选物品的任务奖励！"
	]
	quest.26AE724D46A9430B.quest_subtitle: "1 枚硬币"
	quest.26AE724D46A9430B.title: "收藏品"
	quest.271164995133F430.quest_desc: ["由10,000个煤炭制成"]
	quest.2736FF4556236824.quest_desc: [
		"利用红物质的力量，将红物质剪刀、红物质斧、红物质剑和红物质锄头的功能整合到一件工具中。"
		""
		"这把剑的功能提供了炼金术士迄今发现的武器中最强大的近战攻击。"
		""
		"充能后的斧头能一键（右键）将整棵树变成去皮原木，再次激活可挖掘整棵树（不适用于超大树木）。它也能快速砍伐树木。"
		""
		"锄头在完全充能后，单次操作（右键）即可翻耕大片区域。"
		""
		"剪刀可以收割大量树叶或许多相邻绵羊身上的羊毛。"
	]
	quest.27453FAA4CD8BB2C.quest_desc: ["由 387420489 块鹅卵石组成！"]
	quest.279D5C185DE6FBF4.quest_desc: ["将矿石块合成矿石 (2x2)。"]
	quest.27A3D6364800040A.quest_desc: ["户外烹饪 - 尽显格调！"]
	quest.27A4FEB8FF983107.quest_subtitle: "Botania"
	quest.27A8BB58004C1DB9.quest_desc: ["放入其物品栏的任何物品都会转化为 EMC。它能将能量从能量收集器传输到能量冷凝器。传输时，每秒额外提供 3 EMC。它也被用来为 Klein Star 系列充入 EMC。"]
	quest.27C9EAA07B64CDD3.quest_desc: [
		"导入总线会从它接触的物品栏中吸取物品和流体（以及模组添加的任何其他东西），并将其推入网络存储中。"
		""
		"为了减少延迟，如果导入总线最近没有导入任何东西，它会进入一种“睡眠模式”，此时运行缓慢，并在成功导入某物后醒来并加速至全速（每秒4次操作）。"
		""
		"它们是电缆的组成部分。"
	]
	quest.27D559AF2FF8AB16.quest_desc: ["打开一组机会方块（在此之前打开的无效）。"]
	quest.2813AAA22203C6C3.quest_desc: ["成功登陆 Glacio 以完成此任务。需要 Tier 4 火箭。"]
	quest.284AD374B7EC81DF.quest_desc: ["即使穿着暗物质盔甲，情况危急时你还是会受到明显伤害。你决定像优秀的炼金术士一样，用红物质来解决问题，却发现这套新红物质盔甲能阻挡大量伤害，除了被动能量推搡的感觉外，你几乎感觉不到任何东西。但是……或许你还可以更进一步？"]
	quest.288D1A8284EA6444.quest_desc: ["对鸡使用可生成金蛋。将金蛋点击在5x5的泥土块上，即可生成欢乐泥土（点燃后会生成被动生物）"]
	quest.28AADA8236CEE862.quest_desc: [
		"用于制作需要设计图的物品。"
		""
		"工程师工作台制作的物品通常用于其他合成配方。一个很好的例子是动力灯笼，它能阻止敌对生物在一定半径内生成！"
		""
		"&4注意：当在工作台添加或删除蓝图时，有时会导致游戏崩溃。此问题已向模组开发者报告。&r"
	]
	quest.28B2DF42316767BD.quest_desc: ["水槽可以装水！"]
	quest.28E3C30852CAB186.quest_desc: ["穿上奇点坦克，点击即可沐浴经验值！"]
	quest.293B776662114118.quest_desc: ["右键将木头变为去皮原木，再右键即可立即采集。"]
	quest.29454E312AFB3287.quest_desc: ["制作、组装、启动并成功维护一个龙之反应堆（不允许发生爆炸）。"]
	quest.2968D69970CDA8DE.quest_desc: ["将鼠标悬停在物品上并按住 Shift 键以查看属性。"]
	quest.2968D69970CDA8DE.title: "Mk3"
	quest.29A24743F60E711A.quest_desc: ["将玩家传送到物质接收器中。"]
	quest.29E7B708749B9B42.quest_desc: ["由10,000个铜锭制成"]
	quest.2A3CAFB5D3427FB3.quest_desc: ["在祭坛中制作。消耗安布罗修姆作为燃料。"]
	quest.2A6EFE02F0113946.quest_desc: [
		"要给你的螺旋桨帽充电，请在 JEI 的 Charging Gadgets 里查找 \"Charging Station\"。"
		""
		"Propeller Hats 是一个添加了多等级螺旋桨帽的模组，可用于飞行。它们由 FE 供电，因此你需要某种充电器来为它们充电。"
	]
	quest.2ABCE226A3B4F4EE.quest_desc: ["所有导入此处的能量都将被清空。"]
	quest.2AD25DE5F43D3B4A.quest_desc: ["在草地上种植以生长奶牛。确保给它足够的生长空间。"]
	quest.2AEE4D88A489DA16.quest_desc: ["一种能让玩家设置并即时传送到已保存地点的传送物品"]
	quest.2B72356DFAAC12A5.quest_desc: ["一把攻击力为5的剑。"]
	quest.2BBE7E9D9A8772BE.quest_desc: ["这个初始装置会将物品逐个转换为 EMC。当 EMC 积累足够时，目标物品就会被创造并放入箱子中。它似乎会贪婪地从周围的能量收集器和反物质中继器中吸取 EMC 来制造物品。"]
	quest.2BF9F779FD75AA4C.quest_desc: ["用怪物们来自的维度中的材料制作成各种物品。"]
	quest.2BF9F779FD75AA4C.title: "通用预测（Generalized Predictions）"
	quest.2C08FD536602B1BD.quest_desc: ["用于制作 Powah 物品的组件。"]
	quest.2C1A380EBB6AF17C.quest_desc: ["由10,000个萤石粉制成"]
	quest.2C50B9ACE82D517F.quest_desc: [
		"要吃更多永久的心，就试试各种各样的食物吧！用这本书来记录。在达成以下里程碑（吃到不同食物）后，你将获得额外一颗心：10、15、20、25、30。"
		""
		"用这种方法最多可以获得5个额外的心，其他物品可以将生命值提升到更高。"
	]
	quest.2C50B9ACE82D517F.quest_subtitle: "生活的调味剂"
	quest.2C52AF4EB1C85864.quest_desc: ["利用太阳能（太阳）来产生RF。Tier 2！"]
	quest.2C7CB05FD8889BD4.quest_desc: ["将熔岩和熔岩+红石转化为RF。"]
	quest.2C8B647BDD0F481A.quest_desc: [
		"&2默认情况下，整合包处于普通模式。&r"
		""
		"你可以把普通模式想象成泰坦，专家模式想象成卡帕。"
		""
		"没有简单模式，抱歉！"
		""
		"\"&b/packmode normal&r\" = 普通模式 = 配方比普通模组包更难。"
		""
		"\"&b/packmode expert&r\" = 专家模式 = 比普通模式更难的制作配方。准备好迎接挑战吧！"
		""
		"\"&b/packmode current&r\" = 检查当前的数据包模式。"
		""
		"需要开启作弊模式或在服务器中拥有管理员权限。如果在服务器中，这将更改所有玩家的难度。"
		""
		"你也可以在游戏加载前，通过 kubejs/config/common.json 文件进行修改。在 json 文件中，你的 packmode 必须是 &b\"normal\"&r 或 &b\"expert\"&r - 确保全部小写，并且有引号！"
		""
		"&4如果不是正常模式，每次整合包更新后都需要运行命令或修改配置！&r"
		""
		"请注意，任务书针对普通模式进行了优化。如果您游玩的是其他模式，请做好比平时更频繁地跳跃不同任务章节的准备！"
		""
		"你也可以运行命令 \"&b/packmode help&r\" 来查看有关包模式的详细信息。"
	]
	quest.2C8B647BDD0F481A.quest_subtitle: "挑选你的毒药吧！"
	quest.2CD7E699CEEE73F8.quest_desc: [
		"像电池一样储存RF！"
		""
		"它是一个无定形的多方块结构；将一个高级电容器组放在另一个旁边会合并它们的储能。"
	]
	quest.2CE245F9F36F4E39.quest_desc: ["Cloggrum 是 Undergarden 中最常见的矿石之一。"]
	quest.2CEDF16DFC5B7FDC.quest_desc: [
		"每个背包都可以安装一定数量的附加组件或升级。这些组件需要合成，然后放置在背包物品栏的左侧栏位中。"
		""
		"有许多不同的升级可供选择。其中许多还可以升级为更高级的版本，从而进一步提升其效果。"
	]
	quest.2D205E67DE382A31.quest_desc: ["升级可清除多余物品。防止因溢出导致系统堵塞。"]
	quest.2D2B0DB13122E2EA.quest_desc: [
		"将树苗、树叶、木屑（用锤子敲击原木）或其他有机物放入橡木桶中即可创造泥土。"
		""
		"你也可以用水和女巫水制作泥土生成器——就像用熔岩和水制作鹅卵石生成器一样！"
	]
	quest.2D2E4CE0DE0E015F.quest_desc: ["生物燃料（破碎机中的植物材料）产生的电力。"]
	quest.2D928501975CB165.quest_desc: ["存储组件是所有AE2单元的核心，决定了单元容量。每个等级容量提升4倍，消耗3个上一等级的组件。"]
	quest.2DA429EE9D3EEA9B.quest_desc: ["金质箱子由铁质箱子升级而来。"]
	quest.2DB858A32BBA002A.quest_desc: ["存储组件是所有AE2单元的核心，决定了单元容量。每个等级容量提升4倍，消耗3个上一等级的组件。"]
	quest.2DE3DFDBE3595E41.quest_desc: ["精粹护甲部件是更高级别的护甲，可以使用增强组件进行升级。"]
	quest.2DF07E22F5A8CE7C.quest_desc: ["复制粘贴小工具让你可以选择一个大范围进行复制，并粘贴到另一个位置。"]
	quest.2DFA2205857FBA8E.quest_desc: ["由10,000个红石粉制成"]
	quest.2E28C0C1F81CD03B.quest_desc: [
		"任何魔法植物学家都知道，造成负面气场失衡效应可能相当危险，尤其是使用被动消耗气场的装置时。在这种情况下，气场失衡护符可提供保护：将其放置在使用气场的装置旁，当周围气场水平过低时，该装置将停止运行。这不会带来任何代价。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.2E2E82D5376E9D91.quest_desc: ["这些工作台用于更复杂的合成配方。也有自动化版本可用。更多详情请见JEI。"]
	quest.2E6127F7A54D6A58.quest_desc: [
		"将暮色钻石投入被花朵环绕的2x2水池中，即可制作暮色森林传送门。跳入其中，进入森林。"
		""
		"Twilight Forest 是一款以冒险为主题的维度探索模组，它将带你踏上旅程，与奇怪的生物相遇，探索地牢等等。"
	]
	quest.2E6127F7A54D6A58.quest_subtitle: "暮色森林"
	quest.2E6127F7A54D6A58.title: "进入暮色森林 (Into the Twilight Forest)"
	quest.2E7DBB11688E2421.quest_desc: ["模式需要在ME模式编码终端中用空白模式制作，然后插入ME模式提供器或分子组装器中。"]
	quest.2EB673C98F2891DA.quest_desc: ["使用简单的烹饪系统和一些熟悉的食材，农夫乐事让你能准备各种各样的丰盛美食：从三明治到沙拉和炖菜，从精美的甜点到令人垂涎的盛宴，厨房里不会有任何食材被遗忘！"]
	quest.2EC749B4571A7EB9.quest_desc: ["基础磁铁能在玩家5格范围内拾取物品和经验值！"]
	quest.2ECDC7B514932E1C.quest_desc: ["一种注入了末地能量的顶级合成组件。"]
	quest.2EDFF6BAB18DCBC8.quest_desc: ["升级后的精华需要使用前一级的精华和灌注水晶来制作。用于创造2级种子。（专家模式下需要水晶）"]
	quest.2F367F6748A0281C.quest_desc: ["一种由原版游戏后期材料制成的稀有高阶合金。"]
	quest.2F557E8BDF14E2EF.quest_desc: ["斯特林发电机通过燃烧熔炉燃料来发电。其发电速率和燃料效率取决于所安装的电容器。"]
	quest.2F557E8BDF14E2EF.quest_subtitle: "Ender IO"
	quest.2F5803138627E169.quest_desc: ["可让你自动化复杂的合成配方。将物品栏置于顶部，即可自动将物品拉入合成台。"]
	quest.2F5B723497046BFC.quest_desc: ["消灭那些讨厌的幻影！可以放置在护身符槽中。"]
	quest.2F5DF89B8B8B3967.quest_desc: ["Klein Star Zwei 最多可容纳 200,000 EMC，也用于合成 Klein Star Drei。"]
	quest.2F60BEB4CAB4424A.quest_desc: [
		"此终端可用于查看、放入和取出简易存储网络中的物品。"
		""
		"&4注意：为提高性能，建议将终端直接放置在物品连接器方块上。&r"
	]
	quest.2F631C8EE15BA50F.quest_desc: ["自动打开怪物农场里不断掉落的战利品箱！(提示：用漏斗或管道实现自动化！)"]
	quest.2F631C8EE15BA50F.quest_subtitle: "FTB 任务书"
	quest.2F7D243BFA0DE65C.quest_desc: [
		"木桶还可以用来制作黏土、史莱姆、下界岩、末地石、黑曜石等。详情请见JEI。"
		""
		"将尘土放入装满水的桶中即可制作陶土块。"
	]
	quest.2F8633A3B969A2E5.quest_desc: ["用于融合合成。需要一个核心，以及每个物品一个注射器。注射器必须是正确的等级才能合成，请参见JEI。融合合成需要能量。注射器可以升级到下一级。"]
	quest.2FEBA698BF4F7AF2.quest_desc: [
		"带有升级插槽的 Ender IO 机器需要电容器才能运行。"
		""
		"电容器可以根据其基础修饰符，提升机器的速度、射程或能量存储。"
		""
		"等级：1"
	]
	quest.2FF30E29BD7550D5.quest_desc: ["Tier 2 火箭将使你能够前往火星，并具备前一个或多个等级的所有能力。"]
	quest.30016E1C526393CB.quest_desc: ["Mobius Fuel 是 ProjectE 添加的一种燃料。它的燃烧时间是普通煤炭的十六倍，可以冶炼 128 个物品。"]
	quest.305DDEB9CE993D3A.quest_desc: [
		"要给你的螺旋桨帽充电，请在 JEI 的 Charging Gadgets 里查找 \"Charging Station\"。"
		""
		"Propeller Hats 是一个添加了多个等级的螺旋桨帽的模组，可用于飞行。它们由 FE 供电，因此你需要某种充电器来为它们充电。"
	]
	quest.306E8065443E1FC6.quest_desc: ["用于泥土上以创造恐怖泥土 - 会生成敌对生物。(5x5 空间)"]
	quest.30CC71CAC95122E2.quest_desc: ["使用合金熔炉在前期无需电力即可创造合金。建造多方块结构的方法请参见JEI。"]
	quest.30CC71CAC95122E2.quest_subtitle: "Immersive Engineering"
	quest.30CC71CAC95122E2.title: "合金熔炉"
	quest.30EC24CE1E708631.quest_desc: ["厌倦了无尽的合成？来你的新沙发上歇歇脚吧！"]
	quest.30EDDDAA38ED12D1.quest_desc: ["杀死一只羊并烹饪其肉以获得羊肉。"]
	quest.30EDDDAA38ED12D1.quest_subtitle: "Minecraft"
	quest.30FBF029F03571A5.quest_desc: [
		"一位炼金术士总是忙于进行新的实验。由于现有的木制箱子不合适，你研发出了新的炼金术士箱子，可存放104个物品堆叠，是双层木制箱子的1.44倍。"
		""
		"不受此存在平面限制的炼金术宝箱，即使被实心方块覆盖也能被访问。撒在箱盖上的共价尘也赋予了箱子微弱的魔法力量，使某些魔法物品放入箱中时能产生效果。"
		""
		"黑洞乐队 - 将附近的物品吸入箱子中"
		"永恒密度宝石 - 将箱子中的材料压缩成更高EMC值的材料"
		"修复护身符 - 修复箱子内的物品"
	]
	quest.30FE8FCBCDCAA608.quest_desc: ["使用高级附魔融合器，可对已附魔的物品进一步修改附魔。也支持使用等级而非材料来修复物品。与基础融合器相比，成本要低得多。"]
	quest.312E0269110144C5.quest_desc: ["一套完整的无限盔甲将赋予你创造模式飞行和无敌效果 - 即使是面对 /kill 命令也不例外。"]
	quest.313767A445CA2C9B.quest_desc: ["你可以使用浇水壶手动加快作物的生长速度。右键点击水方块即可装满浇水壶。使用时，只需对准植物右键即可。"]
	quest.313767A445CA2C9B.title: "最高等级浇水壶的最大等级"
	quest.3199091CA87F1CD1.quest_desc: ["Extreme Reactors 是经典模组 Big Reactors 的延续。反应堆和涡轮机是多方块结构，能够产生大量电力。本书将引导你完成整个过程。"]
	quest.3199091CA87F1CD1.quest_subtitle: "极端反应堆模组 (Extreme Reactors)"
	quest.31A42D4E46C5856B.quest_desc: [
		"要使用框架方块，请执行以下操作："
		""
		"- 用几乎任何实心方块右键点击该方块，使其外观相同。"
		"- 用流体容器右键点击方块，使其看起来像容器中的流体。"
		"- 右键点击方块并使用发光石粉，使其产生光亮。"
		"- 用 Framed Hammer 右键点击方块以移除伪装。"
		"- 用空流体容器右键方块以移除流体伪装。"
	]
	quest.31D2D1709EB19D54.quest_desc: ["放置在动物前方以生成粉色史莱姆。"]
	quest.31FC1E10FF6B79D5.quest_desc: ["将你的范围进一步延伸至 64 格。添加信标后，此距离会变得更长（按住物品上的 Shift 键查看详情）。"]
	quest.326626C6F888B720.quest_desc: ["要使用此模组，需要制作2个配方模式持有者并用编码器进行编码。"]
	quest.32664FCADE420D48.quest_desc: [
		"附加组件让工业机械更出色！有提升效率、范围、速度等的附加组件！"
		""
		"存在更高等级，请查看 JEI。"
	]
	quest.32664FCADE420D48.title: "附加组件"
	quest.3278DE2E493332DC.quest_desc: ["生成无限水！放入流体抽屉中。"]
	quest.327E60DEDF8D9876.quest_desc: ["充能熔炉是一种基础电炉，使用能量而非燃料来熔炼物品。"]
	quest.3287EB20CFF4AF31.quest_desc: ["建造、维护并使用最大尺寸的Mekanism涡轮机来发电。"]
	quest.329254403D3AE4CC.quest_desc: [
		"在所有其他任务章节完成之前，简易成就不可用。"
		""
		"这些任务旨在无需 EMC 和创造模式物品即可完成。"
		""
		"对简易成就有什么建议吗？请在 Discord 上发送消息！"
	]
	quest.329254403D3AE4CC.title: "简易成就系统"
	quest.329F702B5D9928FB.quest_desc: ["创意级气源，可为相连的气动机器提供无限压缩空气，无需电力或燃料。"]
	quest.32FA63E4958B5E3C.quest_desc: ["使用 energizing orb 制作。用于制作 blazing tier Powah 物品的配方中。"]
	quest.332842533827F298.quest_desc: [
		"在下界挖掘远古残骸并熔炼以获得。"
		""
		"将四个下界合金废料和四个金锭组合，制作一个下界合金锭！"
	]
	quest.333DA241BCF97E3B.quest_desc: ["由10,000个钢锭制成"]
	quest.334C069543F12A2D.quest_desc: [
		"许多活动都需要人在场，大多数是放置方块。在灵气可以替代人工的时代，这实在是一种浪费。不可感知建造者会消耗少量灵气，来放置你提供的任何方块。建造者会从放置在其上方的任何物品容器中收集方块。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.3358A31C7B81C9CB.quest_desc: [
		"不知道怎么建造下界传送门的话，可以看看Minecraft维基哦 :)"
		""
		"&4注意：默认情况下，火焰蔓延被禁用，因此点燃下界传送门需要打火石和钢。&r"
	]
	quest.3358A31C7B81C9CB.quest_subtitle: "Minecraft"
	quest.3358A31C7B81C9CB.title: "进入下界"
	quest.3369867891992907.quest_desc: [
		"充电器可用于为兼容的工具和 Certus Quartz Crystal 充电。"
		""
		"电力可通过顶部或底部提供，使用AE2的线缆或其他模组的电源线。可接受AE2的电力（AE）或Forge Energy（FE）。物品可从任意一侧放入或取出。仅能取出结果，因此无需过滤器来防止误取出带电的Certus晶体而非普通晶体。可用Certus Quartz Wrench旋转以方便自动化。"
		""
		"可用于将 Certus Quartz Crystal 制成 Charged Certus Quartz Crystal，或将 Compass 制成 Meteorite Compass。"
		""
		"手动供电，将木制曲柄放在顶部或底部，右键点击直到物品充满电。"
		""
		"它同时也是Fluix研究员的工作台。"
	]
	quest.33D83D703DB763EF.quest_desc: ["由黏土和骨粉制成，用于制作未烧制的瓷器物品，如坩埚。"]
	quest.33F3134668A08D26.quest_desc: [
		"燃烧任何燃料（煤炭/木材等）。"
		""
		"1 煤炭 = 20,000 RF（与其他大多数模组的燃料水平类似）。"
		""
		"内部存储容量为 1,000,000 RF"
		""
		"燃烧燃料，能迅速为一个物品充能。"
		""
		"在建立完整的能源系统之前，用来给物品充能的权宜之计。"
	]
	quest.33F3134668A08D26.quest_subtitle: "充电小工具"
	quest.33FBEE929807ECFB.quest_desc: [
		"由铁质网格升级而来。"
		""
		"随着网格层级升高，筛分方块产出的物品会发生变化。详情请见 JEI。"
	]
	quest.34172B8D67D6281E.quest_desc: ["合成守卫工具和盔甲所需的材料。"]
	quest.34612C1E6AEDC97F.quest_desc: ["前期矿物复制机 - 速度较慢，但未来会有更好的选择！需要能量（RF）。"]
	quest.34612C1E6AEDC97F.quest_subtitle: "实用机械模组"
	quest.3465BA65A8FF769E.quest_desc: ["刻印机用于用压机刻印电路和处理器，并将各种物品压成粉末。它能接受AE2的电力（AE）或Fabric/Forge能量（E/FE）。它可以分侧放置，即从不同侧面放入的物品会存入其物品栏的不同槽位。为此，可用Certus Quartz Wrench来旋转它。它还可以被设置为将合成结果推送到相邻的物品栏中。"]
	quest.3473210E7AAB80EE.quest_desc: [
		"改进型高炉最多可安装两个高炉预热炉，各一个位于两侧。它们需要电力才能运行。"
		""
		"一个高炉预热器能使改进型高炉的速度提高一倍，两个高炉预热器能使速度提高三倍。"
	]
	quest.3473210E7AAB80EE.title: "高炉预热装置"
	quest.3475FD5AB260705E.quest_desc: ["就像物品抽屉一样，但可以存放流体！"]
	quest.34892B714A83B9BD.quest_desc: [
		"翡翠苹果会赋予以下药水效果："
		""
		"力量 I (4:00)"
		"再生 III (0:20)"
		"吸收 IV (4:00)"
		"火焰抗性 I (4:00)"
		"抗性 II (4:00)"
	]
	quest.34892B714A83B9BD.quest_subtitle: "Pickle Tweaks"
	quest.34A2FFE184432DB6.quest_desc: ["由81块鹅卵石组成！"]
	quest.34BD662310054359.quest_desc: ["能量立方体可用于存储大量RF。等级越高，存储的RF越多。等级3！"]
	quest.34E2D3F310E0D98C.quest_subtitle: "神秘农业 (Mystical Agriculture)"
	quest.34E87FC422893245.quest_desc: ["此区块生成器的速度为 64"]
	quest.3503BC17056BE43D.quest_desc: ["免疫火焰和岩浆伤害，并补充饥饿值。"]
	quest.350D228F048488A4.quest_desc: ["被暗物质包围听起来是个好主意！它能吸收大量伤害。穿上这套盔甲，你几乎无敌。有时，你似乎能看到盔甲光泽下的动静。"]
	quest.351C81062D0749EC.quest_desc: ["被暗物质包围听起来是个好主意！它能吸收大量伤害。穿上这套盔甲，你几乎无敌。有时，你似乎能看到盔甲光泽下的动静。"]
	quest.3535CD981AB4679A.quest_desc: ["火药是一种用于爆炸相关配方和酿造的配方材料。由苦力怕掉落。"]
	quest.354B464B693D4D84.quest_desc: ["用于制作高级机械、组件和合成台的基础资源。"]
	quest.354B464B693D4D84.quest_subtitle: "扩展合成系统 (Extended Crafting)"
	quest.356967A5117434E7.quest_desc: ["恢复生命值，提供水下呼吸和永久夜视（shift+X）。"]
	quest.3574297380D51075.quest_desc: ["一套完整的无限盔甲将赋予你创造模式飞行和无敌效果 - 即使是面对 /kill 命令也不例外。"]
	quest.358CAB03A0CA3B8E.quest_desc: ["在光照等级为15时，每秒最多可产生12 EMC，上限为30,000 EMC。当放置在能量冷凝器、能量冷凝器MK2、能量冷凝器MK3、反物质中继器MK2或反物质中继器MK1旁边时，会将EMC传输至该机器。"]
	quest.35A1FA947B38610C.quest_desc: ["点击带袋子的末地箱以链接。可从你的物品栏访问末地箱！"]
	quest.35F8C7EA2A6A230A.quest_desc: ["穿上史莱姆靴，用你的史莱姆弹弓快速旅行！注意瞄准准确……"]
	quest.3603913FC72967C4.quest_desc: ["可在堡垒中找到；可通过配方复制。"]
	quest.36751E0CBED417FA.quest_desc: ["存储组件是所有AE2单元的核心，决定了单元容量。每个等级容量提升4倍，消耗3个上一等级的组件。"]
	quest.36B761E82E6EFE91.quest_desc: ["升级后的熔炉，基础烹饪时间为 120"]
	quest.36D115CED80477E1.quest_desc: ["在密封结构中分配氧气并调节温度。"]
	quest.36F5C86A7D54D95E.quest_desc: ["存储组件是所有AE2单元的核心，决定了单元容量。每个等级容量提升4倍，消耗3个上一等级的组件。"]
	quest.3700FAC908C2A72E.quest_desc: ["一套完整的无限盔甲将赋予你创造模式飞行和无敌效果 - 即使是面对 /kill 命令也不例外。"]
	quest.372B5CB656A0373E.quest_desc: [
		"如果能飞的话，建造大型生物农场可能会更容易一些……"
		""
		"要给你的螺旋桨帽充电，请在 JEI 的 Charging Gadgets 里查找 \"Charging Station\"。"
		""
		"Propeller Hats 是一个添加了多个等级的螺旋桨帽的模组，可用于飞行。它们由 FE 供电，因此你需要某种充电器来为它们充电。"
	]
	quest.372B5CB656A0373E.quest_subtitle: "螺旋桨帽子"
	quest.375349762EEA75A9.quest_desc: ["一个简单的木制种植箱，无需电力即可自动种植作物和树苗，但速度较慢。无法自动化（除了将产物直接输出到其下方的容器中）。"]
	quest.375349762EEA75A9.quest_subtitle: "Agritech Evolved"
	quest.3756A02BEECBD1E3.quest_desc: ["组件用于制作催化剂。越高级别的组件，制作难度越高。"]
	quest.3760B6D798A48C9B.quest_desc: [
		"备受喜爱的经典模组 Actually Additions 现已回归 Minecraft 1.20.4+，带来了全新的模型、纹理和大量更新！"
		""
		"使用原子重构器和赋能器将矿物转化为强大的晶体，用于制造物品处理和分拣的实用机器、无线传输能量、物品和流体的激光器、用于发电的可再生石油等等。"
	]
	quest.3760B6D798A48C9B.quest_subtitle: "实际上附加的模组 (Actually Additions)"
	quest.3760B6D798A48C9B.title: "实际上附加内容手册"
	quest.376C6AD36CE3F09E.quest_desc: ["制作天使戒指的起点！谁不爱创造模式的飞行呢？"]
	quest.376C6AD36CE3F09E.quest_subtitle: "天使戒指"
	quest.37B82D083578AAE3.quest_desc: [
		"消耗能量和液体经验，灵魂绑定器可以通过绑定装有液体的灵魂瓶来改变破损刷怪器生成的怪物类型。"
		""
		"要向机器添加经验值，可以使用连接到储罐或其他液体经验值来源的流体管道；或者，也可以使用经验值棒直接从玩家将经验值放入机器中"
	]
	quest.380EF464962F81B3.quest_desc: ["生成 10 亿 RF/刻。"]
	quest.3833EC6F7FBBA74F.quest_desc: ["如果需要连接超过控制器六个面的设备，可以链接另一个能看见整个抽屉网络的接入点。"]
	quest.38451728CB184D6A.quest_desc: ["一个能控制时间和天气的强大装置"]
	quest.38451728CB184D6A.quest_subtitle: "Draconic Evolution"
	quest.384531776969BAA4.quest_desc: ["液体压缩机的升级版。"]
	quest.38D7180D07D8A349.quest_desc: [
		"Slice'N'Splice 可以“切片”和“拼接”头颅和其他物品，通过添加组件来创造新组件。它有六个输入槽、两个工具槽和一个输出槽。Slice'N'Splice 每个输入槽的堆叠大小恰好为一。"
		""
		"Slice'N'Splice 需要两种工具才能运作——斧头和剪刀。没有这些工具，制作过程将不会开始。每次操作都会消耗每种工具的一点耐久度。"
	]
	quest.38E8EA5AB3A98610.quest_desc: ["[ \"必须完成此任务 \", { \"text\": \"传送器\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"6EF67A87979A9378\" } }, \" 才能解锁。\" ]"]
	quest.38E8EA5AB3A98610.quest_subtitle: "15 枚硬币"
	quest.38E8EA5AB3A98610.title: "史诗奖励袋"
	quest.3905C1E98C8931B0.quest_desc: [
		"当然，根据你当前所处的世界，收集到的光环类型会略有不同。例如，在正常世界中，光环可以以阳光的形式收集；而在下界中，光环可以以鬼魂的形式收集；在末地中，光环则以过剩的黑暗形式存在。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.39140A5AC01843D2.quest_desc: [
		"“玩多人模式的话，我该如何创造更多岛屿呢？”"
		"- 运行命令 \"&b/skyblock gui&r\"。"
		""
		"“有不同的整合包模式吗？”"
		"- 是的，运行命令 \"&b/packmode help&r\"。"
		""
		"“为什么被动生物不刷新了？”"
		"- 如果动物不刷新，可以制作动物种子，在 JEI 中搜索 \"Haven Animal Seeds\"。"
		""
		"有脉矿采集器吗？\""
		"此整合包包含 FTB Ultimine 模组。默认按键为 Grave 键：`"
		""
		"“暮色森林传送门为什么打不开呢？”"
		"在 JEI 中查找 \"Twilight Diamond\"。这是开启传送门所需的物品。"
		""
		"“我需要按照顺序完成这些任务页面吗？”"
		"- 不。"
		""
		"“怎样才能获得超过五颗心的生命值呢？”"
		"- 吃各种各样的食物来获得永久的心力！"
		""
		"“为什么有这么多类型的能量呢？”"
		"- 有些模组喜欢给能量命名。通常，所有模组的能量都是相同的。RF = FE = CF = µI"
		""
		"“我该如何获得[在此插入物品]呢？”"
		"- 使用 JEI 查找配方。许多原版物品的原版机制仍然适用（例如在堡垒中找到升级模板）。"
		""
		"有 Ozone Skyblock Reborn 1 吗？\""
		"- 是的，在 Curseforge 上搜索 \"Ozone Skyblock Reborn\"。"
		""
		"“如果我读了任务描述，这些问题是不是都能得到解答呢？”"
		"- 是的。"
	]
	quest.39140A5AC01843D2.quest_subtitle: "在这里找不到答案？去 Discord 问问吧！"
	quest.39327666C21DA6F6.quest_desc: ["使用大量强大的红色和深色物质，你成功大幅加快了构造体的速度。它现在能一次将物品分解为 EMC 64。此外，它还新增了一个用于放置转化后物品的独立舱室。"]
	quest.39596CAA42FE6D8A.quest_desc: ["即使穿着暗物质盔甲，情况危急时你还是会受到明显伤害。你决定像优秀的炼金术士一样，用红物质来解决问题，却发现这套新红物质盔甲能阻挡大量伤害，除了被动能量推搡的感觉外，你几乎感觉不到任何东西。但是……或许你还可以更进一步？"]
	quest.397356F1B2238867.quest_desc: ["基础终端，让你可以查看和访问网络存储的内容，并向自动化合成系统请求物品。"]
	quest.3999198FADFC6A44.quest_desc: [
		"由黄金网格升级而来。"
		""
		"随着网格层级升高，筛分方块产出的物品会发生变化。详情请见 JEI。"
	]
	quest.39BB1EE4D2B24353.quest_desc: ["合成时必须使用正确等级的注入器，请参见JEI。融合合成需要能量。注入器可升级至下一级。"]
	quest.39BC864BAA5BEF13.quest_desc: ["PackagedAuto 是 Applied Energistics 2 的一个附加组件，旨在通过物品“包”实现超过9个物品的自动化合成，同时也支持流体合成。"]
	quest.39D148ACFB96F5F9.quest_desc: ["储存的液体量相同，但可以容纳四种不同类型的液体！"]
	quest.39E081184335B6E1.quest_desc: ["觉醒祭坛机是觉醒祭坛的单方块自动化版本。"]
	quest.39E081184335B6E1.quest_subtitle: "神秘自动化"
	quest.39EF5A9782C3678C.quest_desc: ["在反应堆中使用铀产生的废料产物。"]
	quest.3A1D456E94BB9A46.quest_desc: ["元素种子可创造元素精华——用于制作觉醒超贵金属。"]
	quest.3A43D6B2F5FBA5E6.quest_desc: ["火箭需要燃料来提供动力。"]
	quest.3A6A4C98058E48FC.quest_desc: ["来自太阳的能量。"]
	quest.3A7ACD6C36478B09.quest_desc: ["最大方块数：9"]
	quest.3AD0AA05BFD863C2.quest_desc: [
		"Functional Storage 是 Storage Drawers 储物方案的另一种选择，外观更新，功能更丰富。"
		""
		"经典的1x1抽屉，每个抽屉可存放大量同一种物品。另有其他变种可选。可升级。"
	]
	quest.3AD0AA05BFD863C2.quest_subtitle: "功能性存储系统"
	quest.3B17326FFA1DC8F6.quest_desc: [
		"控制电路是制造Mekanism机器/工具的关键组件。它们存在于许多配方中，不同配方可能需要不同等级的控制电路。例如，能量熔炉需要基础控制电路，而化学溶解室则需要终极控制电路。"
		""
		"第一阶。"
	]
	quest.3B39980FD69BE7EE.quest_desc: ["用于泥土上以创造有趣的泥土 - 会生成被动生物。(5x5空间)"]
	quest.3B6BA03724FFA136.quest_desc: ["存储升级，等级3。悬停物品查看详情。可升级为下界合金升级。"]
	quest.3BD7934F9EDAA4A9.quest_desc: [
		"当然，根据你当前所处的世界，收集到的光环类型会略有不同。例如，在正常世界中，光环可以以阳光的形式收集；而在下界中，光环可以以鬼魂的形式收集；在末地中，光环则以过剩的黑暗形式存在。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.3BF6C883E6197374.quest_desc: [
		"虽然为网络提供能量的主要方式是使用能量接收器，但振动室也能直接产生少量到中量的AE。"
		""
		"默认情况下（无升级）可产生 40 AE/秒。"
		""
		"当网络储能装置充满时，振动室会降低功率以节省燃料，但无法完全关闭。"
	]
	quest.3BF7D0F1043813F1.quest_desc: ["使用 energizing orb 制作。用于制作 nitro tier Powah 物品的配方中。"]
	quest.3C213A6C4914FDFA.quest_desc: ["由 59049 块鹅卵石组成！"]
	quest.3D1786596C9FCC88.quest_desc: ["升级物品可以增强管道，提高其传输速度、效率，或增加过滤和堆叠大小等功能。"]
	quest.3D70E1BB2986C4DB.quest_desc: [
		"本模组的基本单位是数据模型——一种包含实体信息的物品，可用于生成该实体的掉落物。要获得数据模型，你必须先制作数据模型框架，并将其用于目标实体以构建模型。模型创建后，你还需要对其进行训练。"
		""
		"数据模型可以通过两种方式训练：使用深度学习器或使用模拟室。深度学习器允许你存储几个数据模型，你收到的击杀将开始训练模型。所有模型最初都处于故障状态，必须在深度学习器中训练至基础级别。"
	]
	quest.3DAA865F15382848.quest_desc: ["使用乳胶处理器制造。熔炼可制成塑料。"]
	quest.3DCC9A603A17DAB3.quest_desc: ["升级后的熔炉，基础烹饪时间为 40"]
	quest.3E0C3A64AC5CD7AC.quest_desc: [
		"要使用框架方块，请执行以下操作："
		""
		"- 用几乎任何实心方块右键点击该方块，使其外观相同。"
		"- 用流体容器右键点击方块，使其看起来像容器中的流体。"
		"- 右键点击发光石粉所在的方块，使其产生光亮。"
		"- 用 Framed Hammer 右键点击方块以移除伪装。"
		"- 用空流体容器右键方块以移除流体伪装。"
	]
	quest.3E14B10C0D95CDF9.quest_desc: [
		"如果你在制作地基前真的需要动物种子，那么你可以在这里购买。价格可不便宜！"
		""
		"每30分钟重复一次。"
	]
	quest.3E14B10C0D95CDF9.quest_subtitle: "出生在糟糕的生物群系里了？"
	quest.3E14B10C0D95CDF9.title: "需要动物吗？"
	quest.3E4218A3CBD9CB28.quest_desc: ["由你在“另一面”找到的资源制作而成。"]
	quest.3E46241002680BCC.quest_desc: [
		"接口就像一个小型箱子，能根据设置自动填充或清空网络存储。它会在单个游戏回合内完成操作，最多可填充或清空9个物品堆叠，因此如果使用高速物品管道，这是一种快速的进出口方法。"
		""
		"另一个有用的特性是，大多数流体储罐只能存储1种流体，而接口最多可存储9种流体和物品。它们本质上就是带有一些额外功能的箱子/多流体储罐，通过将接口与任何网络断开，就可以禁用这些额外功能。因此，在需要存储少量多种不同物品的特定情况下，接口会很有用。"
	]
	quest.3E745AF0ACA85BA6.quest_desc: ["注入器必须为正确等级才能合成，请参见JEI。融合合成需要能量。注入器可升级至下一级。"]
	quest.3E7EFAE0131CDB93.quest_desc: ["骨头是一种主要产自骷髅及类似生物的物品。它可以被制作成骨粉，或用于驯服野狼。"]
	quest.3EB30F879AB9402A.quest_desc: ["在高级种植箱中用作肥料！"]
	quest.3EC6F6C5228BAD28.quest_desc: ["结合了镐、铲子和剑的功能，具有极高的挖掘速度和攻击力"]
	quest.3ED9992DD5070D51.quest_desc: ["使用简单的烹饪系统和一些熟悉的食材，农夫乐事让你能准备各种各样的丰盛美食：从三明治到沙拉和炖菜，从精美的甜点到令人垂涎的盛宴，厨房里不会有任何食材被遗忘！"]
	quest.3ED9992DD5070D51.quest_subtitle: "农夫的欢乐时光"
	quest.3EDA781E026296F3.quest_desc: ["这台机器利用能量从特定方块和矿石中提取粉尘，是制造各类工具所必需的。它与破碎机不同，是其他模组中研磨机的对应物。"]
	quest.3F171C175D462267.quest_desc: [
		"筛子：自动筛选材料！使用与普通筛子相同的筛网。筛网可附魔“时运”和“效率”。需要更多铁？试试筛选深板岩碎块。需要能量（RF）。"
		""
		"锤子：能将鹅卵石变成砾石，砾石变成沙子，沙子变成尘土等！需要锤子（可附魔效率）。需要能量（RF）。"
	]
	quest.3F171C175D462267.title: "机械升级 (Mechanical Upgrades)"
	quest.3F1E49F84A0BA465.quest_desc: ["合成材料。用此材料制成的盔甲可以安抚幻影。"]
	quest.3F3DC4BF5C52FE28.quest_desc: [
		"使用加固材料建造一个最大尺寸的巨型反应堆。"
		"反应堆的最大尺寸为高48，宽32。"
	]
	quest.3F74784097718DB8.quest_desc: [
		"一种和平的资源采集替代方案。"
		""
		"- 一个超平坦世界，包含一层厚厚的石头、然后是深板岩、下界岩和末地石，每一层都有矿石，但没有洞穴或洞窟。"
		"- 完全没有敌对生物。"
		"- 永远是白天。"
	]
	quest.3F8BD6F64BECC35C.quest_desc: ["将乳胶泵入以开始制作橡胶。"]
	quest.3F8D587A704CE81C.quest_desc: ["有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"]
	quest.3F8D587A704CE81C.title: "魔法的奖章 (Magical Medallions)"
	quest.3F9634C76705A187.quest_desc: ["移动更快，下落减速，免疫坠落伤害。无需消耗 EMC 即可飞行（与 [Ring of Arcana] 类似）（按两次空格）。短途飞行冲刺（按住空格）。踏空辅助，无需跳跃即可改变高度（X）。"]
	quest.3FBC14ADA3E118E2.quest_desc: [
		"将末地合成台放置于世界中，右键以打开GUI。内部有一个3x3的合成网格，类似于合成台。将配方材料放入网格中，末地合成台就会开始合成。"
		""
		"要提高合成速度，请在末地合成器周围放置末地交替器。在4格半径内放置的任何交替器都能提高合成速度。如果它们发出粒子效果，就说明正在工作。"
	]
	quest.3FBC14ADA3E118E2.quest_subtitle: "扩展合成系统 (Extended Crafting)"
	quest.3FE0809FC18DD36F.quest_desc: ["一把攻击力为8的剑。"]
	quest.3FFD5071CAB35FE9.quest_desc: ["经典的天空方块。和普通水桶一样，但只能在某些合成配方中使用。用它盛放岩浆会缩短其使用寿命。"]
	quest.402ABC0A6EA35DD4.quest_desc: ["你用连接器将机器连接到网络。通过连接器，各种通道（即使类型不同）也能正常工作。普通连接器只允许从放置连接器的那一侧进行访问。例如，对于原版熔炉，使用普通连接器时，你只能在熔炉底部放置连接器才能获取熔炼后的产物。"]
	quest.402C2DF5EB7E3496.quest_desc: [
		"它不会消耗耐久度，并且能一击秒杀所有生物或玩家，即使玩家在创造模式中。"
		""
		"是的，这甚至在混沌守卫身上也有效。"
	]
	quest.402D82ABE31FC142.quest_desc: ["用于将电路板与蚀刻酸结合，创造未组装的印刷电路板（PCB）"]
	quest.409BF70E8D188CD9.quest_desc: ["控制电路用于制作多种Mekanism物品和机器。第5级。"]
	quest.409BF70E8D188CD9.quest_subtitle: "Mekanism 扩展内容"
	quest.40ABBEE4C6F06C62.quest_desc: ["储存能量；也可以是多方块结构。可在远距离和不同维度间传输"]
	quest.40B6870514C5217B.quest_desc: ["在草地上种植以养鸡。确保给它足够的生长空间。"]
	quest.40BA19D0B80C6F0A.quest_desc: ["被暗物质包围听起来是个好主意！它能吸收大量伤害。穿上这套盔甲，你几乎无敌。有时，你似乎能看到盔甲光泽下的动静。"]
	quest.40F3CC129DFC5BCE.quest_desc: ["将鼠标悬停在物品上并按住 Shift 键以查看属性。"]
	quest.41174CEBEE63B6EA.quest_desc: ["将鼠标悬停在物品上并按住 Shift 键以查看属性。"]
	quest.41174CEBEE63B6EA.title: "Mk1"
	quest.415AB951288AB22C.quest_desc: [
		"将物品压缩成奇点。请在JEI中查看每种奇点所需的物品数量。"
		""
		"每个量子压缩机的配方通常需要催化剂和一定数量的材料。将催化剂放在最左边的槽位，材料放在其旁边的槽位。悬停在蓝色条上可以查看当前材料以及压缩机中该物品的数量。如果催化剂和材料的组合有产出，会显示生成物品的进度。"
		""
		"量子压缩机需要能量才能运行。它只在生成物品时消耗能量。"
	]
	quest.415AB951288AB22C.quest_subtitle: "扩展合成系统 (Extended Crafting)"
	quest.416CD34D9E0E1A74.quest_desc: ["Tier 3 火箭将使你能够前往金星和水星，同时具备前几级的所有能力。"]
	quest.4178CE375A63CDC6.quest_desc: [
		"在处理光环时，要掌握特定区域或存储设备中具体有多少内容，本质上是很困难的。不过，环境之眼能让植物学家看到这些信息：一旦制作完成，只需将其放在快捷栏的任何位置，就会显示多项信息。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.41B0C5A74D0A5AE1.quest_desc: ["需要为 Mystical Agriculture 的机器制作升级组件。"]
	quest.41C7CA8C8FC35D0B.quest_desc: ["锤子的合成材料 - 5x5x3"]
	quest.425F101DD814DA77.quest_desc: ["催化剂用于复杂的合成配方。它们在层级越高时，合成难度也越大。"]
	quest.427B08FAFF602FE5.quest_desc: ["将鼠标悬停在物品上并按住 Shift 键以查看属性。"]
	quest.4289B236F67F89B1.quest_desc: [
		"合成终端与普通终端类似，所有设置和分区都相同，但增加了一个合成网格，该网格会自动从网络存储中填充。注意在左键单击输出时不要误操作！"
		""
		"你应该尽快把你的终端升级为合成终端。"
	]
	quest.42E85B58C9E586C9.quest_desc: ["右键可立即收割树叶、羊毛和蘑菇（来自牛蘑菇）。充能等级（V，shift+V）控制根据充能状态所收割的区域大小。"]
	quest.43044B3D63CA83FA.quest_desc: [
		"要使用框架方块，请执行以下操作："
		""
		"- 用几乎任何实心方块右键点击该方块，使其外观相同。"
		"- 用流体容器右键点击方块，使其看起来像容器中的流体。"
		"- 右键点击发光石粉所在的方块，使其产生光亮。"
		"- 用 Framed Hammer 右键点击方块以移除伪装。"
		"- 用空流体容器右键方块以移除流体伪装。"
	]
	quest.431297CE56DC8A83.quest_desc: ["放置在熔炉下方。点击熔炉，用熔化的材料制作金属块。"]
	quest.43689166DFBFABE8.quest_desc: ["将其置于龙头下。将模具放在上面，然后点击龙头即可填充模具。"]
	quest.43698862AB55F952.quest_desc: [
		"获取以太的方法："
		""
		"制作一个停滞舱。停滞舱的主要用途是无限期地收容一个凋零。将配备流体激光底座和紫色激光透镜的激光钻直接放置在凋零上方，会产生以太气体。这种流体是制作工业先行最昂贵物品（包括最高等级机器框架）所必需的。"
		""
		"在活性停滞仓工作区内生成的凋零会立即被冻结。它不会失去无敌护盾，但激光钻会无视该护盾。凋零不会引发爆炸，也无法采取任何行动。尽管如此，玩家仍可能想用防凋零方块将工作区包裹起来，以防万一停滞仓耗尽电力。"
		""
		"Stasis Chamber 的默认工作区是机器正上方的 3x3x3 立方体。使用 Range Addons 可以扩大其尺寸。玩家在机器工作区内会受到 Slowness 效果的影响。"
	]
	quest.43698862AB55F952.title: "以太气体"
	quest.439C528354838250.quest_desc: ["要使用此模组，需要制作2个配方模式保持器并用编码器进行编码。"]
	quest.4435C785551464AD.quest_desc: [
		"混沌守卫可以在末地的混沌岛屿上找到，每2500个方块就会生成一个。"
		""
		"以下内容摘自 Draconic Evolution 项目页面："
		""
		"剧透警告！"
		""
		"&n装备&r&l"
		""
		"我推荐带龙翼飞行、盾牌（显然）、不灭和至少2个速度模块的龙之胸甲。"
		""
		"高级位移器上的新闪烁功能也非常实用，特别是当你为其分配了按键绑定之后。"
		""
		""
		""
		"&n守护者治疗水晶&r&l"
		""
		"守护者水晶无法再被普通伤害摧毁，因为它们有由岛屿核心的混沌水晶直接供能的护盾。可以通过用混沌伤害击中水晶来暂时中断这种联系。要么让守护者攻击水晶，要么如果你有混沌级武器，就用它。"
		""
		"链接只会中断几秒钟，所以用尽可能多的伤害击打水晶来摧毁它，然后快离开，因为守卫者会很不高兴！"
		""
		""
		""
		"守护者现在拥有多种基础和进阶攻击。"
		""
		""
		""
		"&n基础攻击&r&l"
		""
		"他偶尔会冲向玩家并尝试直接近战，但更常见的是用火球轰炸玩家。"
		""
		"守护者还有一个基本的防御动作，如果玩家靠得太近太久，它会高速飞走，同时将自己包裹在一团火球中。"
		""
		""
		""
		"值得注意的是，守卫的火球威力巨大，只需几个就能击破龙盾。"
		""
		"对抗这些攻击的最佳防御是使用你的龙之鞘翅来躲避/迂回守卫。(龙之飞行模块)"
		""
		""
		""
		"&n蓄力（高级）攻击&r&l"
		""
		"守护者还拥有几种“高级攻击”。为此，守护者会先飞到岛屿中心，直接从岛屿的混沌水晶中汲取能量。这使他暂时免疫伤害。经过短暂的蓄力后，他会激活几种攻击中的一种。"
		""
		""
		""
		"&n激光：&r 这个很简单，守护者会向你发射一束浓缩的混沌能量，几乎能瞬间融化你的盾牌并杀死你（除非你装有充能的永存模块）。"
		""
		"抵御此攻击的最佳方式是寻找掩护，并在你和守卫者之间放置一个水晶柱。光束可以摧毁末地石，但不能摧毁黑曜石。"
		""
		"如果小心操作，这也是个好机会，可以引导激光到柱子的顶部来摧毁水晶。"
		""
		"当守卫即将使用激光攻击时，你很快就能察觉，因为在初始蓄力后，你会听到第二次蓄力声，表明激光正在积蓄能量。"
		""
		"如果有朋友在帮你，并且你已经摧毁了水晶，那么现在正是未被攻击的人对守卫造成伤害的好时机。"
		""
		""
		""
		"&n重力井：&r在以下高级攻击中，守护者将使用混沌水晶的力量生成强大的重力井，阻止你飞行或离开岛屿的边界。"
		""
		"高级位移器的闪烁功能在这里就能派上用场了，它能让你快速移动并躲避攻击。"
		""
		""
		""
		"&n轰炸：&r 这是一种相当简单的攻击，守卫会锁定你的位置并向你发射一连串火球。如果你不能及时躲避，很可能会丧命。"
		""
		""
		""
		"&n多阶段攻击：&r 此攻击有4个阶段。在第一阶段（也是最烦人的阶段），守护者会生成数个守护者凋零来削弱你。它们比普通凋零更强，并且会专注于攻击玩家。"
		""
		"击杀第一波凋零后，守卫者将启动3阶段的空中轰炸。"
		""
		"首先，他会以圆形模式轰炸岛屿的周边（所以请在岛屿中心躲避）"
		""
		"接下来，他会轰炸岛屿中心。所以去外围，小心误射的火球。"
		""
		"最后，他会用随机火球轰炸整个岛屿。要度过这一阶段，最好待在岛屿边缘，尽量躲避朝你飞来的火球。"
		""
		"这个阶段你可能需要一些充能的永存模块。"
	]
	quest.4435C785551464AD.quest_subtitle: "我该怎么和这东西战斗？？"
	quest.444CC3223736987B.quest_desc: ["控制电路用于制作多种Mekanism物品和机器。Tier 3。"]
	quest.4452E64D7145CFE3.quest_desc: ["Mystical Agriculture 是一款围绕作物种植资源的模组。使用作物来种植用于制作材料、生物掉落物、工具、盔甲甚至更多物品的精华！"]
	quest.4452E64D7145CFE3.quest_subtitle: "神秘农业（Mystical Agriculture）"
	quest.4452E64D7145CFE3.title: "神秘农业指南"
	quest.445C1394C2925EE2.quest_desc: [
		"在这里，你可以用辛苦赚来的硬币换取奖励袋。奖励可能毫无用处，也可能非常棒。祝你好运！"
		""
		"&2注意：某些任务线必须在解锁更高阶的奖励袋之前完成。&r"
	]
	quest.445C1394C2925EE2.quest_subtitle: "花掉你的金币吧！"
	quest.44750CE6BE9DB523.quest_desc: ["使用简单的烹饪系统和一些熟悉的食材，农夫乐事让你能准备各种各样的丰盛餐点：从三明治到沙拉和炖菜，从精美的甜点到令人垂涎的盛宴，厨房里不会有任何食材被遗忘！"]
	quest.447C4BB189DF8AB9.quest_desc: ["以极快的速度将你拉向地面并击退生物(shift)。"]
	quest.448DF487E20E3AF5.quest_desc: ["用于在物品、流体、能量或红石网络中配置和连接激光节点的实用工具。"]
	quest.44A2441F00719ADD.quest_desc: [
		"Fluix 晶体拥有吸收并转换能量形式的独特能力，是所有物质能量技术的基础。"
		""
		"AE2 方块、装置和物品的主要材料之一。将下界石英、红石和带电的 Certus 石英晶体投入水中即可制作。"
		""
		"可以使用ME Formation Plane和ME Annihilation Plane进行自动化。"
	]
	quest.44B1489E34B8C8BB.quest_desc: ["这种更高级的线圈是更先进的机器和能量装置所必需的。"]
	quest.44CC1D3469523E4A.quest_desc: ["存储组件是所有AE2单元的核心，决定了单元容量。每个等级将容量提升4倍，并消耗3个上一等级的组件。"]
	quest.44D504D72D362C72.quest_desc: ["存储单元是标准驱动器的两倍。"]
	quest.44D504D72D362C72.quest_subtitle: "ExtendedAE"
	quest.44EFADD7178AAE20.quest_desc: ["此合成组件是一种低阶线圈，用于前期机器和工具的配方中。"]
	quest.451E4F4A7AC324BF.quest_desc: ["将鼠标悬停在物品上并按住 Shift 键以查看属性。"]
	quest.454B473F16B73356.quest_desc: ["每个等级都会增加更多的存储栏位和升级栏位。"]
	quest.4579E77C572486C8.quest_desc: ["升级后的熔炉，基础烹饪时间为 80"]
	quest.457F0F8D2AF686E8.quest_desc: [
		"创意模式升级，可为兼容机器提供无限资源，不消耗任何材料。"
		""
		"可以复制任何物品，包括那些通常无法被复制的物品（例如创造模式物品）。"
		""
		"复制方法：放置一个朝向箱子的单向漏斗。将此升级放入漏斗的升级槽。向漏斗中投入任意物品。大功告成。"
	]
	quest.45887881B110D056.quest_desc: [
		"压缩筛可用于筛选压缩方块——九个方块一次性搞定！"
		""
		"和普通筛子一样，你可以将多个压缩筛子并排放置（试试3x3的正方形）来同时筛选。"
		""
		"在筛子下方放置一个向上指的点击机，就可以实现自动化！还可以实现更高效的筛分自动化。"
		""
		"注意：在 JEI 中，压缩方块筛分掉落物可能不会显示全部。通常，压缩方块会掉落与未压缩方块相同的物品，只是掉落率更高！"
	]
	quest.45A5707D025CD692.quest_desc: [
		"钻石苹果会赋予以下药水效果："
		""
		"再生 II (0:20)"
		"吸收 III (4:00)"
		"火焰抗性 I (4:00)"
		"抗性 I (4:00)"
	]
	quest.45ACDBE42962793A.quest_desc: ["催化剂用于复杂的合成配方。它们在层级越高时，合成难度也越大。"]
	quest.45D448B5B0D04FDB.quest_desc: ["接收无线红石信号。"]
	quest.45E28C06FE4C7789.quest_desc: ["一个可压缩的双格抽屉。"]
	quest.45E3F8498766ED51.quest_desc: ["更快的导管！更高等级也存在，请查看JEI。"]
	quest.45E3F8498766ED51.title: "导管 - 第3等级"
	quest.45EDE15AF534BBF5.quest_desc: ["最初使用蚀刻槽和蚀刻酸制作，之后可以用装配控制器制作。"]
	quest.462375E9E65C799F.quest_desc: [
		"击败末影龙后可以获得这种花。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.465262DA42AAFC33.quest_desc: ["可以锤成沙子。用筛子来获取资源！"]
	quest.46914D5CDA4CAFA7.quest_desc: ["击败末影龙即可获得。开启龙之进化的序幕！"]
	quest.46914D5CDA4CAFA7.quest_subtitle: "Draconic Evolution"
	quest.46A87E7A5F454339.quest_desc: ["这个模组能让你覆盖几乎所有模组里的线缆和管道！"]
	quest.46A87E7A5F454339.quest_subtitle: "电缆外立面"
	quest.46D8585E55448576.quest_desc: [
		"带有升级插槽的 Ender IO 机器需要电容器才能运行。"
		""
		"电容器可以根据其基础修饰符，提升机器的速度、射程或能量存储。"
		""
		"等级：4"
	]
	quest.470BE71BADF07F29.quest_desc: ["36格配方提供者——在一个方块中制作或导出大型配方集。"]
	quest.470BE71BADF07F29.quest_subtitle: "ExtendedAE"
	quest.471E6103F15F0DC3.quest_desc: ["这把神秘的武器能引导声波能量来攻击敌人或与周围环境互动。"]
	quest.47502ABDFAE8843D.quest_desc: [
		"锇压缩机用于将精炼黑曜石粉尘制成精炼黑曜石锭，将萤石粉尘制成萤石锭。"
		""
		"它将液态锇（熔化的锇锭放入机器底部槽位）与原始材料融合，以创造相应的锭。"
	]
	quest.4755B97229118EB4.quest_desc: [
		"觉醒祭坛是觉醒合成结构的核心组件。它与觉醒基座和精华容器主要用于合成觉醒超贵金属。用途请见JEI。"
		""
		"要使用觉醒祭坛，你必须先在世界中放置它。确保周围没有障碍物。然后，在祭坛周围放置觉醒基座和精华容器。祭坛会在世界中显示幽灵基座/容器，指示你放置的位置。"
		""
		"祭坛设置好后，手持物品右键祭坛和底座即可放置物品。容器也是如此，但最多可容纳40个物品。"
		""
		"要激活祭坛，可以用红石信号（如按钮、拉杆）来触发它。"
	]
	quest.47D0492A318B2353.quest_desc: [
		"模式编码终端与普通终端类似，拥有相同的设置和板块，但增加了一个模式编码界面。其外观与合成终端的UI相似，但这个合成网格并不会真正进行合成。"
		""
		"除了制作终端，你还应该拥有一个这个物品。"
	]
	quest.47DAE272EE988E65.quest_desc: [
		"Knightmetal Ingot 是通过熔炼 Armor Shard Clusters 获得的物品。"
		""
		"盔甲碎片簇可以从头盔蟹和哥布林处获得。"
		""
		"或使用电弧炉分解来自骑士幻影的盔甲。"
	]
	quest.480E83DD55448590.quest_desc: ["用于存储和传输RF能量的物品"]
	quest.483DA3FB8D65ED2F.quest_desc: ["[ \"必须完成此任务 \", { \"text\": \"下界合金棒\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"75AD65B7786D4698\" } }, \" 才能解锁。\" ]"]
	quest.483DA3FB8D65ED2F.quest_subtitle: "15 枚硬币"
	quest.483DA3FB8D65ED2F.title: "随机奖励袋"
	quest.48675A769F0D3F9D.quest_desc: ["将这些部件组装起来，制作一个将风力转化为旋转能量的动能发电机。"]
	quest.48675A769F0D3F9D.title: "动能之力"
	quest.488E3B98314C6242.quest_desc: ["在方尖塔周围可配置半径内（3x3至9x9）收割作物，并输出到上方的物品栏。将方尖塔放置于农场的方块内。方尖塔需要一把锄头，每次收割会消耗1点耐久度。可使用不可破坏的锄头，如Mystical Agriculture的Supremium锄头。"]
	quest.488E3B98314C6242.quest_subtitle: "Pylons"
	quest.488EB6F4DF70142A.quest_desc: ["能赋予不同增益的特殊苹果！将鼠标悬停在苹果上并按住 Shift 键查看其效果。"]
	quest.4891B2585594139C.quest_desc: ["一个可通过自定义模块和升级来移动、放置、破坏或与物品和方块互动的方块。"]
	quest.48B64BA472D951B7.quest_desc: [
		"右键可立即将泥土变为路径，或逐层采集泥土和沙子。右键砾石、黏土或雪可立即采集整条矿脉。基于充能等级（V，shift+V）。"
		""
		"- disabled/1 将方块变为路径"
		"- 3x3"
		"- 5x5"
		""
		"用普通铲子挖掘方块的速度极快。"
	]
	quest.48CD3B49D43B3D19.quest_desc: ["将任何可在原版熔炉中冶炼的物品（如煤炭、木材）转化为RF。"]
	quest.493759F763F02B39.quest_desc: ["储存的液体量相同，但可以容纳两种不同的液体！"]
	quest.493B8A2BD7F69B45.quest_desc: ["将鼠标悬停在物品上并按住 Shift 键以查看属性。"]
	quest.493B8A2BD7F69B45.title: "Mk2"
	quest.494884093C4BDEB3.quest_desc: ["元素种子可创造元素精华——用于制作觉醒超贵金属。"]
	quest.49593BB9B587C493.quest_desc: ["提供更强、更快、能量容量更大的效果"]
	quest.49645198C15868C6.quest_desc: ["利用太阳能（太阳）来产生RF。第6级！"]
	quest.496F3837D34D9C5A.quest_desc: ["控制电路用于制作多种Mekanism物品和机器。第7级。"]
	quest.49794080F37AA6D6.quest_desc: ["用这个点击一个僵尸或骷髅怪。"]
	quest.49B1FF0346B228E2.quest_desc: ["Entangled 为你提供将两个方块绑在一起所需的材料，让你可以像操作同一个方块一样操作它们！这样你就可以即时传输物品、能量、流体或任何你想要的东西，你可以拥有超过六个可操作的面，或者只是隐藏你凌乱的线缆，可能性无穷无尽！"]
	quest.49C3172907E94051.quest_desc: ["在空中放置一个方块！无需工具即可破坏，并直接放回你的物品栏中。"]
	quest.49C3172907E94051.quest_subtitle: "实用主义"
	quest.49C8A5689B4F13C8.quest_desc: ["收集游戏中每种盔甲修饰件各一个（列表见JEI）。"]
	quest.4A896062318A7D4A.quest_desc: ["可怕的骷髅让我毛骨悚然！"]
	quest.4A94EFEE171A8EAC.quest_desc: [
		"分子组装器会接收输入的物品，并按照相邻的ME模式提供器、插入的制作配方、锻造台配方或石匠配方执行操作，然后将结果推送到相邻的背包中。"
		""
		"不过，它们的主要用途是搭配 ME 模式提供器。模式提供器在这种情况下有特殊行为，会将相关模式的配方信息和材料一同发送到相邻的装配器。由于装配器会自动将合成结果弹出到相邻的库存（即模式提供器的返回栏位），因此只需在模式提供器上放置一个装配器，即可实现模式的自动化合成。"
	]
	quest.4A97D4D54CD232BF.quest_desc: ["通过电缆传输能量，可升级。"]
	quest.4ADC75DE70AEE87C.quest_desc: ["在末地城市击杀一个潜行贝即可获得。"]
	quest.4ADFC70E3DA60950.quest_desc: [
		"一种可从物品中提取炼金盐的装置。"
		""
		"将熔炉放在熔岩炉上。用烈焰棒填满熔岩炉来加热熔炉！"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.4AEC1E7CE3F054B7.quest_desc: [
		"用锤子砸碎方块。Cobblestone -> Gravel, Gravel -> Sand, Sand -> Dust, Netherrack -> Crushed Netherrack, End Stone -> Crushed End Stone, Cobbled Deepslate -> Crushed Deepslate, Blackstone -> Crushed Blackstone, Crushed Netherrack -> Red Sand. 之后可以用机器自动化。现在，矿脉挖掘和建造棒是你的好帮手。"
		""
		"试着用木槌敲击原木来获得木屑——非常适合堆肥！"
	]
	quest.4B49091675AA1DFA.quest_desc: ["放入其物品栏的任何物品都会转化为 EMC，并将能量从能量收集器传输到能量冷凝器。传输时，每秒提供 10 EMC 的额外能量。它会为 Klein Star 系列的所有物品充入 EMC。"]
	quest.4B5D653985BDC839.quest_desc: [
		"通过仪式，可以获得代币的知识：木制小雕像，描绘着关键情感——由注入了各自符号的树木制成。这些小雕像蕴含着气场本身及其所代表情感的巨大力量。未来，这些代币将成为重要的建造材料。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.4B62DEDA4F901770.quest_desc: [
		"无与伦比的速度、可重配置侧面、用于烟熏和爆破的增强组件，大幅提升冶炼效率。"
		""
		"[ \"存在更高等级，查看 JEI 或 \", { \"text\": \"此处\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"4EAD2382EBF87769\" } } ]"
	]
	quest.4B893A1BDA3CEC33.quest_desc: ["这把黑暗物质之剑本身就很强大，通过蓄力并激活(C)它，会消耗EMC来换取一次毁灭性的横扫攻击。攻击范围由蓄力等级(V, shift+V)控制。"]
	quest.4BC78C7C9A17B43A.quest_desc: [
		"使用基础床，先将数据收集到模拟处理器中。"
		""
		"模拟水培床使用存储的模拟数据生长作物，只需电力即可运行，无需水、以太气体或实体植物。"
	]
	quest.4BC78C7C9A17B43A.title: "模拟水培系统 (Simulated Hydroponics)"
	quest.4BCB152BBCEB3B90.quest_desc: [
		"环境之眼理论上非常有用，但许多魔法植物学家都难以应对其对环境气场探测范围的局限性。一个简单的解决方案是环境之眼。虽然它与环境之眼的工作原理相似，但主要区别在于它对区域气场的探测范围要大得多：足足大了一倍。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.4BD1385340E3C938.quest_desc: [
		"矿石可以开采成原矿，也可以直接熔炼成锭。"
		""
		"除了常规合成配方，铁锭还能用来制作压缩铁锭。在地上扔些铁锭，然后在附近引爆（例如 TNT 或迷你 TNT）。你会损失大约 20% 的铁锭，但其余的会转化为压缩铁锭！之后，你可以用更高效的方法制作。"
	]
	quest.4BDA60A93E629E04.quest_desc: [
		"一级方块生成器的高级版本。产量更高！"
		""
		"此区块生成器的速度为 2"
	]
	quest.4C034DCEC02656A2.quest_desc: ["炽热锭是由一个铁锭和一瓶炽热血液或炽热泪制成的物品。炽热锭具有魔法属性，可使使用它制作的物品获得炽热特性。"]
	quest.4C0BCC84EA19B14A.quest_desc: ["点击生物即可捕捉。把它们全部捉住！"]
	quest.4C1AA8D6EF212081.quest_desc: ["将干橡胶熔炼以制作塑料。"]
	quest.4C6B18C8D270A43E.quest_desc: [
		"XNet 是一款专注于效率的物品、流体、能量和信息传输模组。其电缆系统设计得极为简洁，无需额外占用空间。例如，电缆本身并非方块实体，模型也极其简单。这使得通过一根长达 12000 个方块的电缆传输物品，与通过一根 5 个方块长的电缆传输的效率完全相同。"
		""
		"本模组的核心是一个网络。网络本质上是一段由连接器连接的电缆，连接着各种方块（箱子、机器等）和一个控制器。控制器是负责该网络实际工作的方块。"
	]
	quest.4C6B18C8D270A43E.quest_subtitle: "XNet"
	quest.4C6E023AB7291EE5.quest_desc: ["翱翔于天界之上，\"借\"几朵云带回去吧。"]
	quest.4C6E023AB7291EE5.title: "Aerclouds"
	quest.4C73BD54224F7CC5.quest_desc: ["使用固体燃料来创造气压。"]
	quest.4C9ADC82F706B417.quest_desc: [
		"炼金术上纯度的黄金。可作为催化剂，使各种炼金术过程得以进行。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.4CAFFE19D6158181.quest_desc: ["压力舱的设置和配方请参阅手册。这些物品足以建造一个3x3x3的压力舱，非常适合初学者！"]
	quest.4CAFFE19D6158181.title: "压力舱室"
	quest.4CB6ADD18138ACC6.quest_desc: [
		"出口总线将物品和流体（以及模组添加的任何其他内容）从网络存储中拉取，并推入其接触的背包中。"
		""
		"为减少延迟，若导出总线最近未导出任何物品，它会进入一种“睡眠模式”，此时运行缓慢，并在成功导出物品后醒来并加速至全速（每秒4次操作）。"
		""
		"它们是电缆的组成部分。"
	]
	quest.4CE5621AB71CE988.quest_desc: [
		"- 将工厂管理器放置在世界中，并使用物品栏电缆将其连接到您的物品栏"
		"将程序磁盘放入管理者的GUI中"
		"- 使用按钮或 Ctrl+V 将脚本粘贴到管理器 GUI 中"
		"- 管理员应该会告诉你脚本已加载成功"
		"将鼠标悬停在磁盘上，查看程序的警告和错误信息"
		"手持标签枪，右键单击管理器以从程序中加载标签"
		"- 现在按住 shift 键并滚动鼠标滚轮可以更改活动标签。"
		"- 右键点击世界中的方块以添加或移除标签。"
		"- 还有右键菜单，可以输入自定义标签，即使你的程序里还没有。"
		"- 分配完标签后，不要按住 shift 键，右键单击管理器以将标签保存到程序盘中"
		"- 你的程序现在应该可以正常运行了，没有任何问题"
	]
	quest.4CE5621AB71CE988.title: "工厂管理员工具"
	quest.4CE60F732C4426A3.quest_desc: [
		"Super Factory Manager 是一款 Minecraft 模组，允许用户创建程序来运行工厂。该模组提供了一个专门用于移动物品、流体和其他资源类型的领域特定语言。它包含一个文本编辑器以及一些示例程序。"
		""
		"要开始，你需要一个工厂经理、一个标签枪和一个磁盘。请参考项目页面和 GitHub 了解更多信息！"
	]
	quest.4CEC846A1DD5DB84.quest_desc: [
		"模式提供器是自动合成系统与外界互动的主要方式。它们将模式中的材料推送到相邻的背包，物品也可以被放入其中以加入网络。通常，可以通过将机器的输出通过管道送回附近的模式提供器（通常是推入材料的提供器）来保存通道，而无需使用ME导入总线将机器输出拉入网络。"
		""
		"注意，由于它们直接从制造CPU的存储中推送材料，所以它们的物品栏中实际上没有材料，因此无法直接从中引出管道。你需要让提供者将材料推送到另一个物品栏（如桶），然后再从那里引出管道。"
		""
		"另外需要注意的是，提供者必须一次性推入所有材料，不能分批次。这一点可以利用起来。"
		""
		"模式提供者在与子网接口交互时有特殊行为：如果接口未修改（请求槽为空），提供者将完全跳过接口，直接推送到该子网的存储中，不会填充接口，更不会在机器有空位前插入下一批配方。这在阻塞模式下能正常工作，提供者会监控机器中的槽位以寻找材料，而非接口中的槽位。"
	]
	quest.4CFFA19AA2AA47CD.quest_desc: ["催化剂用于复杂的合成配方。它们在层级越高时，合成难度也越大。"]
	quest.4D15D569E53DE66E.quest_desc: ["末地传送门可以无线从末地电池获取能量（类似于Flux Networks）。两者都可以升级。"]
	quest.4D1BF4F802916D45.quest_desc: ["一把攻击力为7的剑。"]
	quest.4D1FA2C2E6FC7A8C.quest_desc: ["允许在不同维度之间使用终端/合成装置。"]
	quest.4D25AC81B93F326E.quest_desc: [
		"筛选泥土以获得草籽。将草籽点击在泥土块上可将泥土变为草方块。草籽也可用于制作苔藓。"
		""
		"如果你离得足够远，被动生物会出现在草方块上。刷怪有问题？在JEI里搜“Haven Animal Seeds”吧。"
	]
	quest.4D2DA470DCB74326.quest_desc: ["放置在树木或原木前以生成乳胶。"]
	quest.4D462F76B3844D3D.quest_desc: ["精准锯木机用于回收木制物品的木材，并以更高的效率将原木制成木板（每根原木6块木板）。还能制作木屑，用于制造纸板箱。"]
	quest.4D4F4BAEA27DC456.quest_desc: ["使用 Empowerer 合成。查看 JEI。"]
	quest.4D4F4BAEA27DC456.title: "赋能水晶 (Empowered Crystals)"
	quest.4D530984E49A599C.quest_desc: ["一种注入了RF能量的顶级合成组件。"]
	quest.4DB6A9B473DD4107.quest_desc: ["由10,000个金锭制成"]
	quest.4DBA4D50A7627DA4.quest_desc: [
		"带有升级插槽的 Ender IO 机器需要电容器才能运行。"
		""
		"电容器可以根据其基础修饰符，提升机器的速度、射程或能量存储。"
		""
		"等级：10"
	]
	quest.4DE8575D655E8428.quest_desc: ["一种昂贵的锭，用于进入 Project E 和制作其他终局物品"]
	quest.4DEFB84692377A2D.quest_desc: ["合成材料。用此材料制成的盔甲能让猪灵平静下来。"]
	quest.4DFB541B0D2A9FB9.quest_desc: [
		"众所周知，植物学（Botany）即植物的研究，分支众多。过去，许多植物学家都专注于花朵等植物所具有的神奇特性，例如奇特而纯净的雏菊。"
		""
		"然而，植物学远不止于此，尤其是魔法植物学，因为大自然中不仅有比花朵更多的未知事物，很可能还有世界尚未发现的更强大的东西。"
		""
		"当植物学家研究树木、花卉等的影响时，会发现看似熟悉却本质截然不同的自然机制。研究并理解这些正是魔法植物学的目标。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.4DFB541B0D2A9FB9.quest_subtitle: "自然的气息 (Nature's Aura)"
	quest.4E113EAB18FAA897.quest_desc: ["由10,000个铅锭制成"]
	quest.4E42850BC99F8844.quest_desc: ["Tier 1 - 可存储 100 个物品栏。"]
	quest.4E8A216308DE4F60.quest_desc: [
		"带有升级插槽的 Ender IO 机器需要电容器才能运行。"
		""
		"电容器可以根据其基础修饰符，提升机器的速度、射程或能量存储。"
		""
		"等级：3"
		""
		"[ \"存在更高等级，查看 JEI 或 \", { \"text\": \"此处\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"46D8585E55448576\" } } ]"
	]
	quest.4EAD2382EBF87769.quest_desc: ["升级后的熔炉，基础烹饪时间为 160"]
	quest.4EB47C3E07B444F6.quest_desc: ["使用动物种子基座来制作 Haven 动物种子中的任意一种"]
	quest.4EB47C3E07B444F6.quest_subtitle: "Haven Animal Seeds"
	quest.4F24A4C6468A063A.quest_desc: ["用rossinite重制ridiculite获得，而rossinite是使用verderium作为燃料在反应堆中产生的废料。"]
	quest.4F67D41CEFA7A8B0.quest_desc: ["恒星致密的核心，以方便的锭形式呈现。"]
	quest.4F849729CA0DAF2E.quest_desc: ["用筛子可以获得资源！也可以制成粘土块。"]
	quest.4F9D4A5D5C0B81D0.quest_desc: ["自动生长和收割树木！需要插入一把斧头，并在下方放置漏斗和箱子。"]
	quest.4F9D4A5D5C0B81D0.quest_subtitle: "盆景树 (Bonsai Trees)"
	quest.4FB596AD930D87D8.quest_desc: ["将不同的物品栏连接到你的简易存储网络！"]
	quest.4FB596AD930D87D8.title: "电缆和连接器"
	quest.4FB61D44C6A7EB44.quest_desc: ["存储组件是所有AE2单元的核心，决定了单元容量。每个等级容量提升4倍，消耗3个上一等级的组件。"]
	quest.4FDB39030DEDA50A.quest_desc: ["每次命中造成20点伤害，没有耐久度，但仍需在背包中携带1支箭。当箭未击中实体时，会在第一支箭周围以AOE形式召唤出10支箭。这些箭每支也造成20点伤害。所有箭几秒后会消失，无法拾取。"]
	quest.4FEFD780FA021473.quest_desc: ["金苹果是一种食用后可获得有益效果（吸收和再生）的食物，也可用于治疗处于虚弱效果的僵尸村民，使其变为普通村民。"]
	quest.50200EBDECAF2A3B.quest_desc: ["一种高科技种植箱，具有能耗、模块槽、肥料支持和增强的自动化能力"]
	quest.50233C3BE23A074A.quest_desc: ["Angel Ring 模组添加了天使戒指，能让你像创造模式一样飞行，方便建造和旅行。灵感来自 Extra Utilities 的 Angel Ring。"]
	quest.5073B7267BD701D2.quest_desc: ["连接两个或多个末影储罐来运输和获取流体！使用染料进行颜色编码以配对储罐。"]
	quest.50765C7CF71D6A59.quest_desc: ["末影珍珠是一种可以投掷以传送到落点位置，或用于制作末影之眼（进入末地所必需）的物品。由末影人掉落。"]
	quest.507C29EFF8CEFCDA.quest_desc: ["多区块结构的一部分。加热金属，使其能在所需温度下熔炼和合金化。"]
	quest.50852ED19616CDB8.quest_desc: ["缓慢地生成黑曜石。"]
	quest.50A188092863FFFA.quest_desc: ["升级卡牌需要使用基础卡牌或高级卡牌底座来制作"]
	quest.50F59454D604E225.quest_desc: ["将鼠标悬停在物品上并按住 Shift 键以查看属性。"]
	quest.5124714086D19424.quest_desc: ["用绿宝石交换各种种子和树苗吧！"]
	quest.5124714086D19424.quest_subtitle: "方块脑袋的农场生活"
	quest.5133A804F271D046.quest_desc: [
		"欢迎来到Modular Routers！这是一个非常灵活的模组，能以多种方式将物品运送到世界各地。只需一个方块——物品路由器——和一些插件模块，你就可以："
		""
		"- 从物品栏中取出物品（包括 Storage Drawers 等模组物品栏）"
		"- 将它们发送到附近或远处的其他物品栏中"
		"- 将物品作为方块放置"
		"- 破坏方块"
		"- 将物品丢入世界"
		"- 吸收掉落物品"
		"- 将物品投掷到世界的另一端"
		"- 整理物品（包括一些复杂的筛选器，不仅仅是物品/元数据/NBT匹配）"
		"- 丢弃不需要的物品"
		"- 远程操作你的玩家物品栏"
		"- 伸缩方块线条（活动桥！）"
	]
	quest.5133A804F271D046.quest_subtitle: "模块化路由器 (Modular Routers)"
	quest.5160093099979CC8.quest_desc: ["升级卡可以改变AE2设备和机器的行为，提高速度、增强过滤能力、启用红石控制等。"]
	quest.518837817CC3B489.quest_desc: ["由9块鹅卵石组成！"]
	quest.51938F2731D46972.quest_desc: [
		"将煤炭熔炼以创造石墨。"
		""
		"Extreme Reactors 大量使用多区块机器。多区块机器由许多不同方块组成，你需要在世界上将它们相邻放置。继续完成此系列任务，并参考模组书籍寻求帮助！"
	]
	quest.51938F44944122BF.quest_desc: ["升级后的精华需要使用上一等级的精华和灌注水晶来制作。用于创造4级种子。（专家模式下需要水晶）"]
	quest.51AC0E98DDB51802.quest_desc: ["建筑工具包让你能用多种建筑模式来建造结构。"]
	quest.51C61DE36D90B959.quest_desc: [
		"将一个模式保持器放入打包器，另一个放入拆包器，两者都连接到ME网络。"
		""
		"打包机将接收物品并制成配方包，而拆包机则将物品输出到相邻的背包中。"
		""
		"两台机器会根据模式保持器和包装器向ME网络说明其可执行的操作，连接后包装器会将数据包弹出至网络"
	]
	quest.51E5D8D9B1D67E8C.quest_desc: [
		"灌注铁是一种被光环之力祝福的材料，可用于多种魔法自然物品。注意，使用材料的方块形态也能实现同样的灌注。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.51F44681C05DA51B.quest_desc: ["多区块结构的一部分。熔炉多区块结构的中心方块，负责熔炼操作和合金生产。"]
	quest.522B459DA586F112.quest_desc: [
		"这个种子基底用于制作不同的资源种子。"
		""
		"神秘农业的主要用途是资源种子。这些种子可以生长出超过100种不同资源，包括钻石、骨头、铜、红石等。收获时，它们会掉落各自的资源精华，并有10%的几率掉落受精精华。"
		""
		"资源种子有不同的等级。等级取决于所生长材料的稀有度。"
		""
		"这些种子是使用融合祭坛、材料、精华和种子基底制作的。"
		""
		"这些作物无法使用骨粉催熟，也无法通过按 Shift 键加速生长。"
		""
		"它们可以在地里种植，也可以使用花园钟罩、种植箱或农民，并搭配正确的土壤。"
	]
	quest.5267E7C6F511B44B.quest_desc: ["外壳既是装饰性方块，也是功能性方块，用于在该模组中制作和建造各种机器与装置。"]
	quest.526E95BD71FA713C.quest_desc: ["大约3560万吨"]
	quest.52914F9E85778478.quest_desc: ["用于将液体与固体混合的装置。"]
	quest.52914F9E85778478.title: "再处理器组件"
	quest.52AB76818BD22CA3.quest_desc: ["刀是一种普通的近战武器：挥舞速度比剑快，但伤害较低"]
	quest.52DA34ED57CF502B.quest_desc: ["将骷髅斩首并将其烧成焦黑"]
	quest.52EE429D7056B815.quest_desc: [
		"遵循书中概述的步骤，踏上成为炼金术大师的旅程。"
		""
		"Theurgy旨在为Minecraft引入一种全新的炼金术。它摒弃了“四元素”——风、水、火、土——的传统，而是借鉴古典炼金术，运用硫磺、盐和汞等元素，并通过一系列被称为Spagyrics的过程进行处理。"
		""
		"Theurgy 的首要目标是创造平衡的炼金体验——不像 Equivalent Exchange 那样过于强大，但可能比传奇的 Thaumcraft 更实用。"
	]
	quest.52EE429D7056B815.quest_subtitle: "神学魔法模组 Theurgy"
	quest.52F37674EAB17868.quest_desc: ["Aeternalis Fuel 是 ProjectE 添加的一种燃料。将 4 个 Mobius Fuel 与一块 Philosopher's Stone 结合，即可创造出这种新燃料。Aeternalis Fuel 的燃烧时间是 Mobius Fuel 的四倍，能够熔炼 512 个物品。"]
	quest.5309DA86AB2B5596.quest_desc: ["存储的物品数量相同，但可以存放两种不同类型的物品！"]
	quest.531B48D28172F5E4.quest_desc: [
		"最大方块数：3"
		""
		"建造棒能让你一次性放置多个方块，朝你面对的方向扩展建筑。你可以升级建造棒以增强其能力，使建造更快更高效。"
		""
		"建造棒有五个不同等级：木、铜、铁、钻石和下界合金。每个等级都提供更强的耐久度和放置能力，并可通过模板进一步升级。要撤销放置，请在控制菜单中设置按键绑定。"
	]
	quest.531B48D28172F5E4.quest_subtitle: "建造木棍 (Construction Sticks)"
	quest.531FE01522695851.quest_desc: ["Minecraft 里的浴室！"]
	quest.5332F636657E15EC.quest_desc: ["催化剂用于复杂的合成配方。它们在层级越高时，合成难度也越大。"]
	quest.5343BFCD43ECE225.quest_desc: ["控制电路用于制作多种Mekanism物品和机器。Tier 2。"]
	quest.534D29AB411AB0F5.quest_desc: [
		"要使用框架方块，请执行以下操作："
		""
		"- 用几乎任何实心方块右键点击该方块，使其外观相同。"
		"- 用流体容器右键点击方块，使其看起来像容器中的流体。"
		"- 右键点击发光石粉所在的方块，使其产生光亮。"
		"- 用 Framed Hammer 右键点击方块以移除伪装。"
		"- 用空流体容器右键方块以移除流体伪装。"
	]
	quest.537E84EDD29F486A.quest_desc: ["Steeleaf 是一种在 Labyrinth、Hollow Hill 和 Dark Tower 的宝箱中找到的工具和盔甲材料。这种材料作为工具或盔甲时与钻石一样强大，但耐用性甚至低于铁。"]
	quest.53ADBC3ADF1C83C0.quest_desc: ["由10,000个不变合金锭制成"]
	quest.53F53BD4220B295B.quest_desc: [
		"前期强力。用煤炭发电（RF/FE/CF/µI等...）。随着进度推进，还能获得其他发电方式。"
		""
		"注意：前期制作压缩铁，可在铁锭旁引爆爆炸物（TNT加红石信号）。铁锭会转化为压缩铁，平均损耗率为20%。"
		""
		"关于能量：通常，所有模组的能量单位是通用的。RF = FE = CF = µI"
	]
	quest.53F53BD4220B295B.quest_subtitle: "Industrial Foregoing"
	quest.53F5A5A785503096.quest_desc: ["用于存储和传输RF能量的物品"]
	quest.541A74DE0144E082.quest_desc: [
		"带有升级插槽的 Ender IO 机器需要电容器才能运行。"
		""
		"电容器可以根据其基础修饰符，提升机器的速度、射程或能量存储。"
		""
		"等级：2"
	]
	quest.543FAEFE24110294.quest_desc: [
		"该装置无需燃料即可为您的ME网络生成能量。由于该装置产生的晶体振动，每个网络中只能使用一个。这些振动甚至可以穿透石英纤维。"
		""
		"生成率：20.0 AE/秒"
	]
	quest.5476B23B4B60A670.quest_desc: ["Iron Jetpacks 是一款功能丰富且易于使用的现代喷气背包模组。制作更高等级的喷气背包会使其性能更佳。线圈是喷气背包制作过程中不可或缺的一部分。请参见 JEI。"]
	quest.5478FE88578437EC.quest_desc: ["利用太阳能（太阳）来产生RF。Tier 3！"]
	quest.5485AE6A649AC6BC.quest_desc: [
		"用于炼金发酵的容器，是转生所需的。可将炼金硫磺转化为对应的炼金硝石——配方请见JEI。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.548F36AD4A633E9D.quest_desc: ["存储组件是所有AE2单元的核心，决定了单元容量。每个等级容量提升4倍，消耗3个上一等级的组件。"]
	quest.5495A4A946E19DAC.quest_desc: ["由 43046721 块鹅卵石组成！"]
	quest.54AC69527FD39EF7.quest_desc: [
		"种子再处理器是一种将多余种子转化为精质的机器。"
		""
		"种子再处理器需要能量才能运行。你可以通过任何兼容Forge Energy的能量传输方式提供能量，或使用内部基于固体燃料的发电机。"
		""
		"该机器可使用机器升级来加快运行速度并增加内部能量存储。"
	]
	quest.54B033D5CF77D965.quest_desc: [
		"比上一级快多了！"
		""
		"将火把放在地上，右键单击以打开GUI。"
	]
	quest.54BBFA6BC53CD1B7.quest_desc: ["可在高级种植箱中用作肥料！也可用于制作覆盖物。"]
	quest.552CCEDED0AE6D5C.quest_desc: ["使用燃料流体来创造气压。"]
	quest.558FE9042159159D.quest_desc: [
		"如果缺少其他组件，制作单元可以填充CPU的空间，使其成为实心长方体。它们也是其他组件的基础材料。"
		""
		"合成CPU管理合成请求/任务。在多步骤任务执行期间，它们会存储中间材料，并影响任务规模及完成速度。更多详情请见自动合成。"
		""
		"每个合成 CPU 处理 1 个请求或任务，所以如果你想同时请求一个计算处理器和 256 个平滑石，就需要 2 个 CPU 多区块。"
		""
		"它们可以设置为处理玩家的请求、自动化（导出总线与接口）或两者兼有。"
		""
		"右键点击一个会打开一个制作状态UI，你可以在那里查看CPU正在处理的制作任务的进度。"
	]
	quest.55A12669A448C956.quest_desc: ["数字矿工是Mekanism的规模化采矿机。然而，这台机器与众不同，它能将开采的方块“魔法般传送”到其物品栏中。"]
	quest.55A68150572EC898.quest_desc: ["一种将植物油和乙醇结合以生产生物柴油的多方块机器（也存在其他配方，请参见JEI）。"]
	quest.55A68150572EC898.title: "精炼厂"
	quest.55A816E8EB2D0E2E.quest_desc: ["由 531441 块鹅卵石组成！"]
	quest.55B089A848531E3E.quest_desc: ["精粹护甲部件是更高级别的护甲，可以使用增强组件进行升级。"]
	quest.563EF0C91E88B0D5.quest_desc: ["在草地上种植以生长出猪。确保给它足够的生长空间。"]
	quest.56718D2CB87DF305.quest_desc: [
		"压缩锤可以锤击压缩方块！"
		""
		"用锤子砸碎方块。Cobblestone -> Gravel, Gravel -> Sand, Sand -> Dust, Netherrack -> Crushed Netherrack, End Stone -> Crushed End Stone, Cobbled Deepslate -> Crushed Deepslate, Blackstone -> Crushed Blackstone, Crushed Netherrack -> Red Sand. 之后可以用机器自动化。现在，矿脉挖掘和建造棒是你的好帮手。"
		""
		"试着用木槌敲击原木来获得木屑——非常适合堆肥！"
	]
	quest.5675512404BF2759.quest_desc: ["一个三格位的压缩抽屉。"]
	quest.56772ECF0B3C75CE.quest_desc: ["升级后的机器框架使用溶解室制作。参见JEI。需要粉色史莱姆，可从生物屠宰厂获取。"]
	quest.567E3DB67F4F025C.quest_desc: ["烹饪后的食物能提供更多营养！"]
	quest.567E3DB67F4F025C.quest_subtitle: "烹饪食物，我的世界"
	quest.567E3DB67F4F025C.title: "烹饪食物"
	quest.567EA6F53C2AB8D2.quest_desc: ["合成材料，击杀烈焰人即可获得。"]
	quest.56A609B58D0FA6C0.quest_desc: [
		"仅适用于原版方块，耐久度为1。"
		""
		"用魔杖右键点击方块 → 它会变成一个 Enlivened Block 实体。"
		""
		"被激活的实体可被其他模组捕获/复制，从而提供该方块的可持续来源。注意：若生成器不复制NBT，此方法无效。"
		""
		"使用生物囚禁工具作用于你的新实体，并在工业前序生物复制器中进行复制。"
	]
	quest.56CA2BD982503BB0.quest_desc: ["用末地之眼填充蛋糕。需要高级工作台才能制作。"]
	quest.56CA2BD982503BB0.quest_subtitle: "众神之神"
	quest.56CA2BD982503BB0.title: "进入末地"
	quest.56E02661982102F0.quest_desc: ["更多功能，更长的耐用性！"]
	quest.570BE7D3659C6BB0.quest_desc: ["搭建一个能将主基地连接到所有维度的Mekanism传送门网络。"]
	quest.5720FF9BB1596CA1.quest_desc: ["电池用于储存RF。可用于机器和为物品充电。悬停每个电池等级可查看容量和I/O速度。"]
	quest.5735F3DABF096132.quest_desc: ["将液态塑料放置在世界中，使其硬化成塑料板。"]
	quest.573FB7A2379800A5.quest_desc: ["让游戏后期不那么痛苦所需的步骤之一"]
	quest.573FB7A2379800A5.quest_subtitle: "神秘农业（Mystical Agriculture）"
	quest.579B163E3C261DBD.quest_desc: ["冷冻器能将冰晶转化为更高效的火箭燃料。1桶冷冻燃料相当于3桶普通燃料。冰晶可在月球、火星和冰川等寒冷天体上找到。"]
	quest.57C920272A14206C.quest_desc: ["用种子获取觉醒的德拉科尼乌姆，让生活更轻松！"]
	quest.57C920272A14206C.quest_subtitle: "神秘农业（Mystical Agriculture）"
	quest.5818B49C16BB6B8F.quest_desc: ["这件可穿戴物品在获得能量时，会加速附近作物的生长。"]
	quest.5844BCF0147A9BB5.quest_desc: ["这里是存放食物和烹饪用具的绝佳地点！"]
	quest.584678F8D7970634.quest_desc: ["多区块结构的一部分。用于熔炼材料的熔炉熔岩存储容器。"]
	quest.585A89F07F3B4F2D.quest_desc: ["Klein Star Ein 最多可持有 50,000 EMC，也用于制作 Klein Star Zwei。"]
	quest.5873CD588D98B39D.quest_desc: ["一把攻击力为6的剑。"]
	quest.594A3262325FDCFF.quest_desc: ["更多功能，更高耐用性！"]
	quest.595C4352743D4003.quest_desc: ["FramedBlocks 添加了各种形状的方块，可以使其看起来像游戏中的任何其他方块。"]
	quest.595C4352743D4003.quest_subtitle: "带框方块"
	quest.59804052F93F303D.quest_desc: ["将绑定卡用于末影人或末影幼体上。"]
	quest.5999B9EFE3305FAA.quest_desc: ["一把攻击力为 5.75 的剑。"]
	quest.59B11FC479561B73.quest_desc: [
		"要开始探索Aether，你必须用发光石建造框架，并在中间用铁桶装水点燃（只有铁桶有效），这样就能激活传送门，让你踏入这个维度。从这里开始，你就能在Aether充满敌意的天堂中开启生存之旅！"
		""
		"以太世界包含三个神秘的新地牢，每个地牢都有一个可怕的Boss需要击败..."
		""
		"青铜地牢是哨兵们的家园，由神秘的滑行者守卫，这是一种由纯粹石头诞生的生物。小心岛屿间的隐藏隧道，并用你能打造的最好装备做好准备！"
		""
		"银色地牢是美丽的瓦尔基里神殿。挑战瓦尔基里骑士团的骑士，若你证明了自己的价值，便与瓦尔基里女王本人一战。运用你所能想到的所有工具和技巧，战胜这位古老的战士。"
		""
		"在稀有的黄金地牢中，存在着太阳之灵，一个由纯粹火焰与能量构成的永恒存在。他是统治太阳本身的神，要让他注意到你这样的存在，恐怕需要一番说服。但传言称，他守护着以太中最为珍贵的宝藏。"
	]
	quest.59B11FC479561B73.quest_subtitle: "Aether"
	quest.59B11FC479561B73.title: "进入以太维度 (Into the Aether)"
	quest.59E8BA653138CD13.quest_desc: [
		"满足你所有AE2引导需求的一站式指南！"
		""
		"使用时，访问左侧边栏以查找目录表。"
		""
		"许多页面都有互动场景。如果场景旁边有加号和减号（缩放）按钮，你可以旋转和移动相机。左键单击并拖动以旋转，右键单击并拖动以平移。"
	]
	quest.5A24E9024D864081.quest_desc: ["刻印机的改进版 - 并行芯片制造。"]
	quest.5A24E9024D864081.quest_subtitle: "ExtendedAE"
	quest.5A2DB13193C6A2F3.quest_desc: [
		"多年来，植物学家们试图弄清携带光环的物品的魔法特性，他们发现了一个意外却普遍的主题：黄金似乎在人类与光环的互动中始终扮演着重要角色。"
		""
		"要初步接触这种物质的力量，你需要创造一棵璀璨之树。收获时会掉落金叶——一种精致而强大的材料。只需制作一些璀璨纤维，并将其放置在树冠上，时间会带来璀璨。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.5A3A3E5940A21D21.quest_desc: ["这是一个非常昂贵的方块"]
	quest.5A42AA637D80A6B7.quest_desc: ["烈焰人和岩浆怪掉落物。"]
	quest.5A42AA637D80A6B7.quest_subtitle: "Reliquary"
	quest.5A4CD0D779A8410E.quest_desc: ["使用你的新阿马德龙平板电脑来买卖物品！"]
	quest.5A679F29B344C3DC.quest_desc: ["需要魔法种子基地来制作繁荣种子基地和索利乌姆种子基地。"]
	quest.5AC98773FE9B5578.quest_desc: ["可用于种植各种作物，包括神秘农业的作物！查看JEI以确定正确的土壤。"]
	quest.5AD3D5C66E7E50EC.quest_desc: ["用于建造和升级发电机、能量电池及其他电力相关设备的合成组件和储能物品。"]
	quest.5AFFEFD46BEA5855.quest_desc: ["36格接口——在一个方块中制作或导出大型配方集。"]
	quest.5AFFEFD46BEA5855.quest_subtitle: "ExtendedAE"
	quest.5B2D05D4C85086DF.quest_desc: ["所有方块中最终极的方块"]
	quest.5B315DE5C4328B81.quest_desc: ["苹果是可供玩家食用或制作成金苹果的食材。"]
	quest.5B315DE5C4328B81.quest_subtitle: "Minecraft"
	quest.5B9F4455D7D8F7AD.quest_desc: [
		"要在潜声尖叫器上使用潜声核心，才能使其生成潜声守卫（遵循原版机制）。"
		""
		"用加固深板岩建造传送门，就像建造下界传送门一样。要激活它，用之心（击败守卫者获得）点击即可。"
		""
		"记住，加固的深板岩可以破坏，只是挖掘需要非常长的时间！小心放置你的方块！"
		""
		"Deeper and Darker 添加了全新的维度——Otherside——其中包含大量可供探索的内容。以下是一些特色功能列表！"
		""
		"群系：探索深地、回响森林、阴沉柱和繁花洞穴。"
		"结构：寻找远古神殿，这是坚守者的家园！打破远古花瓶时要小心，以免唤醒远古潜行者。"
		"方块：超过一百种新方块可供建造，包括幽暗板岩、潜声石和一种新的木材！"
		"物品：一套全新的卫道士盔甲和工具、升级版鞘翅，还有超酷的潜声信标！"
		"生物：8 种新生物，包括一个迷你首领！"
		"要进入异世界，杀死坚守者并使用其心脏。游玩模组以发现更多内容，探索隐藏的秘密！"
	]
	quest.5B9F4455D7D8F7AD.quest_subtitle: "更深更暗 Deeper and Darker"
	quest.5B9F4455D7D8F7AD.title: "进入另一个世界"
	quest.5BC14A9F19342D22.quest_desc: ["Harvester 是一种能自动收割作物并重新种植的机器。Harvester 收集的物品会放入其内部物品栏中。"]
	quest.5BC8BC388BCA4BA8.quest_desc: [
		"击败混沌守卫以获得混沌碎片，用于制作混沌级和终局物品。"
		""
		"有关混沌守卫战斗的详情，请参阅常见问题解答。"
	]
	quest.5BD8AC498C6088A9.quest_desc: ["从空气中收集中子堆，需要花些时间。"]
	quest.5BD8AC498C6088A9.quest_subtitle: "Avaritia"
	quest.5BE6A18FB99F6C38.quest_desc: [
		"这是一个添加了大量高级物品（如工具和盔甲）、高级储能装置以及其他许多随机功能的模组，例如："
		""
		"- 传送 (Teleportation)"
		"- 生物养殖（生成和击杀）"
		"- 玩家检测"
		"- 时间和天气控制"
		"- 强大的工具和盔甲"
		"- 高级能量存储（RF）"
	]
	quest.5BE6A18FB99F6C38.quest_subtitle: "Draconic Evolution"
	quest.5C0D2D1A229891FA.quest_desc: ["剪切粘贴工具允许你选择一个大半径进行剪切，并将其粘贴到不同位置。"]
	quest.5C1FC3D44F9A3628.quest_desc: ["数字化存储。比不上Applied Energistics或Refined Storage，但总比成百个箱子散落在岛上要好。"]
	quest.5C271A5D912204B4.quest_desc: ["一个内部比外部更大的方块 - 右键放置的 Hyperbox 即可进入！"]
	quest.5C271A5D912204B4.quest_subtitle: "Hyperbox"
	quest.5C271A5D912204B4.title: "紧凑型机器？"
	quest.5C54CFEF6CE75A7A.quest_desc: ["组件用于制作催化剂。越高级别的组件，制作难度越高。"]
	quest.5C968DA6DEDB805A.quest_desc: [
		"成功登陆月球以完成此任务。需要Tier 1火箭。"
		""
		"注意：月亮上含有 Desh。"
	]
	quest.5CAB7799DC531CE6.quest_desc: ["传输压力。可升级。"]
	quest.5CEF864B6400D5F1.quest_desc: [
		"用蚕右键点击树叶方块，即可在树叶上产卵。"
		""
		"注意：用曲柄镐破坏树叶可获得丝绸 - 有1%的几率掉落。"
	]
	quest.5CFAC0E0451F6ADD.quest_desc: ["Tesseract 可以传输物品、流体和能量。Tesseract 在任何距离甚至跨维度都能工作！使用多个频道来管理不同的 Tesseract 群组！"]
	quest.5CFAC0E0451F6ADD.quest_subtitle: "Tesseract"
	quest.5D1A100CF3709F01.quest_desc: ["这些工作台用于更复杂的合成配方。也有自动化版本可用。更多详情请见JEI。"]
	quest.5D378E95DFBB5DCC.quest_desc: ["将火箭放置在发射台上，准备好开始你的太空之旅！"]
	quest.5D5354A10309133E.quest_desc: ["Alchemical Coal 是 ProjectE 添加的一种燃料。它的燃烧时间是普通煤炭的四倍，可以冶炼 32 个物品。Alchemical Coal 用于生产 Mobius Fuel。"]
	quest.5D554AD1078BFB44.quest_desc: ["Actually Additions 的便携工作台可用于魅力槽位！"]
	quest.5D78B43DAB5756C1.quest_desc: ["清理掉多余的怪物掉落物（比如破损的盔甲、弓等）。"]
	quest.5DD07EE53865E25C.quest_desc: ["一即是一切，一切即是一。"]
	quest.5DD07EE53865E25C.quest_subtitle: "Avaritia"
	quest.5DF4D12AFAF3972E.quest_desc: [
		"Ad Astra!（意为“向星辰！”）是一款面向 Fabric 和 Forge 的太空模组，专注于科技、旅行和探索。我们为你准备了成为宇航员所需的一切：火箭、宇航服、空间站和机器。不妨去月球漫步？在火星建造自给自足的避难所？去金星采矿？整个太阳系，乃至银河系，都任你驰骋！"
		""
		"NASA 工作台能让你制造火箭。Astrodux 会为你讲解模组中的所有科技和行星！"
	]
	quest.5DF4D12AFAF3972E.quest_subtitle: "Ad Astra"
	quest.5E2AD42305DE2B60.quest_desc: ["在强光下，或放置在末地时，它每秒会产生40 EMC，最高可达60,000 EMC。当放置在能量冷凝器MK1、能量冷凝器MK2、能量冷凝器MK3、反物质中继器MK1、反物质中继器MK2或反物质中继器MK3旁边时，它会将EMC传输到该机器中。"]
	quest.5E44820EC853BAA9.quest_desc: [
		"由钻石网格升级而来。需要下界合金升级锻造模板，可在下界堡垒中找到。"
		""
		"随着网格层级升高，筛分方块产出的物品会发生变化。详情请见JEI。"
	]
	quest.5E4C03123DB8AB9C.quest_desc: ["挖掘树木的木块会立即挖掘整棵树。挖掘树叶会挖掘一个约5个方块大的球体。不消耗耐久度。"]
	quest.5E6CC59391F00CAA.quest_desc: ["提供多个保存的目的地、更快的传送速度和更多的配置选项"]
	quest.5F0D101AFD3BCA60.quest_desc: [
		"可通过无线终端无线访问。范围和功耗取决于已安装的无线增强器数量。"
		""
		"网络可以包含任意数量的无线接入点，每个接入点可配置任意数量的无线增强器，让你能通过调整设置来优化功耗和覆盖范围。"
		""
		"需要一个频道。"
		""
		"也用于绑定无线终端。"
	]
	quest.5F0F1FFB4160C1C0.quest_desc: ["这台机器将菜籽提取成油，用作燃料或能源系统的燃料。"]
	quest.5F20B63527ED0622.quest_desc: ["Tier 2. Draconic Evolution 1.21.1 中唯一可用的盔甲是胸甲。需要模组才能使其生效，请查看 JEI。"]
	quest.5F4DAFEDC43C0964.quest_desc: [
		"用钩爪钩树叶可获得树苗和蚕（注意：蚕有1%的几率掉落）。还有更高级的钩爪，请查看JEI！"
		""
		"筛子用于获取资源。需要一个网格。"
		""
		"在筛子下方放置一个向上指的点击机，就可以实现自动化！还可以实现更高效的筛分自动化。"
		""
		"注意：前期游戏，建筑魔杖和脉矿采集会是你很好的帮手。将多个筛子并排放置（试试3x3的正方形），可以同时进行筛选。"
	]
	quest.5F4DAFEDC43C0964.quest_subtitle: "众神之神"
	quest.5F4DAFEDC43C0964.title: "Crook and Sieve"
	quest.5F52D927648C1375.quest_desc: ["高级磁铁能在玩家周围11格范围内拾取物品和经验！"]
	quest.5F5BB0B31B3A1C26.quest_desc: ["可让你自动化复杂的合成配方。将物品栏置于顶部，即可自动将物品拉入合成台。"]
	quest.5F7BB2B66376EC4B.quest_desc: ["它能瞬间破坏所有方块，包括基岩。合成时自带财富X附魔，且不会消耗耐久度。"]
	quest.5F83ADFF1BAE5088.quest_desc: [
		"钢是比铁高一级的材料，在本整合包中是进阶所必需的。"
		""
		"在沉浸式工程高炉中，用铁锭（获得钢锭）或铁粉（获得钢粉）来制造钢。"
	]
	quest.5F8670CA83394E74.quest_desc: [
		"当然，根据你当前所处的世界，收集到的光环类型会略有不同。例如，在普通世界中，光环可以以阳光的形式收集；而在下界中，光环则以鬼魂的形式收集；在末地中，光环则以过剩的黑暗形式存在。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.5F90527709383752.quest_desc: ["合成材料。用此材料制作的盔甲能让末影人平静下来。"]
	quest.5F96E888408910ED.quest_desc: ["用铁桶或瓷桶接岩浆——但要小心！瓷桶在倒出岩浆后会破碎。"]
	quest.5F9A5DB4144895CD.quest_desc: ["高级物品收集器的收集范围高达7格！还能过滤物品。"]
	quest.5FDDA50A827FAF75.quest_desc: [
		"右键可立即翻松泥土，取决于充能等级 (V, shift+V)。"
		""
		"- 1x1"
		"- 3x3"
		"- 5x5"
	]
	quest.5FDEB6FE1138399C.quest_desc: ["Iron Jetpacks 是一款功能丰富且易于使用的现代喷气背包模组。背包等级越高，性能越好。线圈是背包制作的重要组成部分。请参见 JEI。"]
	quest.5FDED117D1ADCE5A.quest_desc: ["一种将水果或蔬菜等有机物加工成乙醇的多方块机器，乙醇可用于燃料或合成。"]
	quest.5FDED117D1ADCE5A.title: "工业发酵器"
	quest.601B16ADC17DCC07.quest_desc: ["合成材料。用此材料制成的盔甲能安抚幻影、猪灵和末影人。"]
	quest.6039D8A09D00E4D0.quest_desc: [
		"金叶一旦被采集，就能轻松碾成金粉，可作为森林仪式的重要组成部分铺在地上。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.60553E95A9C0BBF4.quest_desc: ["建造者消耗RF，用放入其物品栏的方块来建造世界区域，或迁移现有区域。它还能清除大片空间或破坏区域内特定方块。"]
	quest.6055F3B2ACE430FC.quest_desc: ["刀具是拾荒工具：它们能让你从动植物身上获得更多资源。"]
	quest.60596DD8FDCEC74A.quest_desc: ["将筛网放入筛子中，即可从泥土、砾石、沙子、尘土等生成资源！筛网可用于普通筛子和压缩筛子"]
	quest.60B2410C50B81C1A.quest_desc: [
		"像电池一样储存RF！"
		""
		"这是一个无定形的多方块结构；将一个 Vibrant Capacitor Bank 放在另一个 Vibrant Capacitor Bank 旁边会合并它们的储能。"
	]
	quest.60F6E5AB8FBA3AD3.quest_desc: [
		"简单的原版风格储物模组。"
		""
		"特色功能："
		"存储与合成终端"
		"物品栏连接器"
		"打开木箱"
		"无线终端"
		"过滤连接器"
		"物品栏漏斗"
		""
		"&4注意：为提高性能，建议将终端直接放置在物品连接器方块上。&r"
	]
	quest.60F6E5AB8FBA3AD3.quest_subtitle: "Tom's Simple Storage"
	quest.60F7B6780A2BEBFC.quest_desc: [
		"要使用框架方块，请执行以下操作："
		""
		"- 用几乎任何实心方块右键点击该方块，使其外观相同。"
		"- 用流体容器右键点击方块，使其看起来像容器中的流体。"
		"- 右键点击发光石粉所在的方块，使其产生光亮。"
		"- 用 Framed Hammer 右键点击方块以移除伪装。"
		"- 用空流体容器右键方块以移除流体伪装。"
	]
	quest.6168444BBA2517D8.quest_desc: [
		"这是一个适用于Applied Energistics 2和ProjectE的模组，旨在加强两者的整合。与常规整合模组不同，AppliedE将ProjectE的EMC转化为独特的“密钥类型”，使其能被ME网络显示、记录和操控，并通过AE2的自动合成系统在需要时转换为物品。"
		""
		"该模块会从放置模块的玩家处获取所有转换/EMC知识，为ME网络提供已存储的EMC和可转换物品的信息。它可以在网络上的任何位置放置以正常工作。"
		""
		"&4注意：使用此模组与大量 EMC 物品时，部分玩家可能会出现 TPS 延迟。&r"
	]
	quest.6168444BBA2517D8.quest_subtitle: "AppliedE"
	quest.6168444BBA2517D8.title: "ME 转换魔法"
	quest.61777EB299FB94E0.quest_desc: ["由10,000个青金石制成"]
	quest.618D53FB7973A7A1.quest_desc: ["将 Ad Astra Oil 放入燃料精炼机即可生成燃料。你也可以使用 EnderIO 熔炉，不过该燃料配方成本更高。"]
	quest.61CFDD199E014C42.quest_desc: ["阻止某些被动生物生成，范围较大"]
	quest.61F806630090ECEC.quest_desc: ["在末地城市飞船上可以找到。"]
	quest.6220ED19B826E0CB.quest_desc: ["农夫是一种自动种植和收割作物的机器。"]
	quest.6220ED19B826E0CB.quest_subtitle: "神秘自动化"
	quest.6246EBDEE4DE4F18.quest_desc: [
		"自然祭坛可用于将特定物品注入光环之力，但它也能帮助将物品从一种类型转化为另一种。要实现这一点，需要制作一个转换催化剂，并将其放置在祭坛周围四个下排金质石砖块中的任意一个上，然后像往常一样将材料放在祭坛上即可。"
		""
		"完整用法列表请参见 JEI。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.6276DB533F7033DB.quest_desc: ["用于建造和升级发电机、能量电池及其他电力相关设备的合成组件和储能物品。"]
	quest.62896E7E2DBD777F.quest_desc: ["用于制作高级和终局物品的强力合成材料"]
	quest.6289D3973C5F61B3.quest_desc: ["将带有最大存储升级的抽屉连接到你的 Applied Energistics 系统中，并用鹅卵石填满它。"]
	quest.6299CB158A777246.quest_desc: ["消耗附近的树叶并将其转化为能量。"]
	quest.62C53D877A059585.quest_desc: ["所有流入此处的流体都将被清空。"]
	quest.62D5202491593442.quest_desc: [
		"水可以通过在橡木桶中收集雨水，或将树苗或树叶放入橡木坩埚来创造。"
		""
		"木桶可用于创造泥土、黏土、灵魂沙、史莱姆等方块！还有石制木桶。请查看JEI。"
	]
	quest.62D5202491593442.quest_subtitle: "众神之神"
	quest.62D5202491593442.title: "木制桶和坩埚"
	quest.630BC32927A8AA77.title: "基础符文 (Basic Runes)"
	quest.633CEC0C789695E7.quest_desc: ["自动化刷怪塔的绝佳开端！再也不用站着自己打怪了。"]
	quest.633CEC0C789695E7.quest_subtitle: "尖刺陷阱"
	quest.6349016135BBD0AC.quest_desc: [
		"高级升级添加了：过滤器和过滤模式。"
		""
		"升级物品可以增强管道，提高其传输速度、效率，或增加过滤和堆叠大小等功能。"
	]
	quest.634E83DDF2911DFD.quest_desc: ["外壳既是装饰性方块，也是功能性方块，用于在该模组中制作和建造各种机器与装置。"]
	quest.6353A39C04EF7F7D.quest_desc: ["用于控制哪些物品、流体或能量可以通过激光节点连接的卡片。"]
	quest.63588316070C73FD.quest_desc: ["即使穿着暗物质盔甲，情况危急时你还是会受到明显伤害。你决定像优秀的炼金术士一样，用红物质来解决问题，却发现这套新红物质盔甲能阻挡大量伤害，除了被动能量推搡的感觉外，你几乎感觉不到任何东西。但是……或许你还可以更进一步？"]
	quest.639103C33226046A.quest_desc: ["刀具在准备餐食时，也适用于切割和分切食材"]
	quest.639219AA32B76CE6.quest_desc: ["增幅器用于为精华工具和精华盔甲添加新能力。"]
	quest.63B25E731B126624.quest_desc: ["[ \"必须完成此任务 \", { \"text\": \"末地抑制器已激活\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"097B7BF8B0CBC549\" } }, \" 以解锁。\" ]"]
	quest.63B25E731B126624.quest_subtitle: "5 枚硬币"
	quest.63B25E731B126624.title: "不常见奖励袋"
	quest.63B5756032EE8F24.quest_desc: ["比中子收集器快多了！"]
	quest.63B5756032EE8F24.quest_subtitle: "神秘农业（Mystical Agriculture）"
	quest.63D6C13107194725.quest_desc: ["在末地城市飞船上可以找到。"]
	quest.63F031C92B77E04E.quest_desc: ["The most ultimate ingot out of all the ingots"]
	quest.6402BA4DBC3774E2.quest_desc: [
		"要使用框架方块，请执行以下操作："
		""
		"- 用几乎任何实心方块右键点击该方块，使其外观相同。"
		"- 用流体容器右键点击方块，使其看起来像容器中的流体。"
		"- 右键点击发光石粉所在的方块，使其产生光亮。"
		"- 用 Framed Hammer 右键点击方块以移除伪装。"
		"- 用空流体容器右键方块以移除流体伪装。"
	]
	quest.641393B3F9C6B8FF.quest_desc: ["过滤器可用于 Ender IO 管道。更多过滤器请参见 JEI。"]
	quest.641393B3F9C6B8FF.title: "导管 - 过滤器"
	quest.6451FD7185BFE271.quest_desc: ["Tier 3. Draconic Evolution 1.21.1 中唯一可用的护甲是胸甲。需要模组才能使其生效，请查看 JEI。"]
	quest.64A4DB89F0523BDF.quest_desc: ["使用简单的烹饪系统和一些熟悉的食材，农夫乐事让你能准备各种各样的丰盛餐点：从三明治到沙拉和炖菜，从精美的甜点到令人垂涎的盛宴，厨房里不会有任何食材被浪费！"]
	quest.64A4DB89F0523BDF.quest_subtitle: "农夫的欢乐时光"
	quest.64C55F0D348097E7.quest_desc: [
		"早期收集灵气的一种简单有效方法是使用自然祭坛。按照指南搭建多方块结构后，祭坛会开始缓慢吸收周围的灵气。但它强度不足，无法造成重大伤害，只会吸收到该区域灵气耗尽为止。收集到的灵气可用于配方，详见JEI。"
		""
		"黄金石砖可用于自然祭坛的多方块结构。或者，也可以用黄金下界砖以类似方式使用。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.64D345ED39C8AF6E.quest_desc: [
		"由燧石网格升级而来。"
		""
		"随着网格层级升高，筛分方块产出的物品会发生变化。详情请见 JEI。"
	]
	quest.650B9EB6E578026C.quest_desc: [
		"制作协处理器能让CPU运行得更快，从而让系统更频繁地从ME模式提供器中发送原料批次。这使得它们能跟上快速处理的机器。例如，一个被分子组装器包围的模式提供器，其原料推送速度可能超过单个组装器的处理能力，从而将原料批次分配给周围的组装器。"
		""
		"一些复杂的配方有多步并行操作，例如同时制作木板和书籍来合成书架。在工艺状态屏幕（右键CPU或使用终端的锤子图标可见）中，这些步骤都会显示为“已计划”。每个额外的协处理器允许多一步并行操作（从而显示为“制作中”）。但这影响不大，因为你通常拥有的协处理器数量远多于配方中可能并行进行的步骤数。"
	]
	quest.6525B48ED37B4C90.quest_desc: [
		"自然指南针是一种实用物品，能让你在世界任何地方搜索生物群系的位置并查看相关信息"
		""
		"探险家罗盘是一种能让你在世界任何地方找到建筑的物品。"
	]
	quest.6525B48ED37B4C90.title: "特殊指南针"
	quest.653BE210E0487B58.quest_desc: ["用于扩大无线接入点的覆盖范围。"]
	quest.654DD2C672816436.quest_desc: ["懒得在炉子上做饭？试试这个新发明——微波炉！"]
	quest.6584CD710EFC59ED.quest_desc: ["黑曜石箱子由钻石箱子升级而来。容量相同，只是能抗爆炸！"]
	quest.65B7E98FC7D9ADBE.quest_desc: ["它能像普通铲子一样瞬间挖掘所有方块。它不会消耗耐久度。"]
	quest.664982C92C008BF9.quest_desc: ["你的基础终端，现已便携！可在ME无线接入点的范围内，随时随地查看网络存储内容并向自动化合成系统发送请求。"]
	quest.6649913A78D19083.quest_desc: ["游戏后期会有更好的方法来制作板，但最好的入门方式是使用工程师之锤。"]
	quest.664FCA66D021E5EB.quest_desc: [
		"多年之后，魔法植物学家终于找到了一种能以新方式驾驭气场力量的新材料：神秘而稀有的 )Netherite。用它，可以打造出一种极其强大的材料：深渊锭。这些锭子，不出所料，也能被制成盔甲和工具。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.665A140AE9AFDEDD.quest_desc: ["一种用于高级配方中的合成材料，包括模组内的机器、工具和高级科技。"]
	quest.665EBED00E67F718.quest_desc: ["合成组件。最高等级（眼泪？）。如果你在混沌守护者战斗中遇到困难，请查看本任务书的FAQ页面，里面有相关介绍。"]
	quest.6687B589680663C6.quest_desc: ["制作一叠第4级恶魔钢（记住，过程中完全不需要EMC）。"]
	quest.669CFE3A168C0788.quest_desc: ["交换装置提供了一套不同的交换模式，从而实现基本的交换能力。"]
	quest.66C4AAA972B39531.quest_desc: ["相信我，这会让你的生活轻松很多（如果你玩的是普通模式的话...）"]
	quest.66C4AAA972B39531.quest_subtitle: "神秘农业 (Mystical Agriculture)"
	quest.67165901C0E6C509.quest_desc: ["制作配方持有器和编码器所需的配方材料。"]
	quest.67165901C0E6C509.quest_subtitle: "PackagedAuto"
	quest.672B673A2F199A90.quest_desc: ["所有腐化生物被杀死时都会掉落乌瑟里克碎片。"]
	quest.67684E03885EB857.quest_desc: ["所有这些方块都可以通过压缩筛来生成资源。"]
	quest.67684E03885EB857.title: "压缩筛分法 (Compressed Sieving)"
	quest.67A73C10038C9156.quest_desc: ["利用太阳能（太阳）来产生RF。第7级！"]
	quest.67E4375F1DD59AA0.quest_desc: ["更快的传导管道！"]
	quest.67E4375F1DD59AA0.title: "导管 - 第2等级"
	quest.67F1A287CB30DC14.quest_desc: ["用刀击杀的任何动物都必定会掉落次要物品，例如皮革和羽毛"]
	quest.67FC751E0E5E8451.quest_desc: ["在远古神殿中找到的潜行者会掉落此物品。"]
	quest.68409C310D6932AC.quest_desc: ["Augments 是通过速度、范围和过滤来增强模块的升级物品。"]
	quest.6857B9C8DAC7D126.quest_desc: [
		"通过仪式，可以获得代币的知识：木制小雕像，描绘着关键情感——由注入了各自符号的树木制成。这些小雕像蕴含着气场本身及其所代表情感的巨大力量。未来，这些代币将成为重要的建造材料。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.6857B9C8DAC7D126.title: "更多代币"
	quest.68A17A4E8C8EA5D9.quest_desc: ["能让附近作物生长更快的睡莲，与其他睡莲相邻放置效果更佳"]
	quest.68AD773B1A241E01.quest_desc: ["使用原子重构机制作。查看JEI。"]
	quest.68AD773B1A241E01.title: "水晶"
	quest.68B8F9FF9F45348B.quest_desc: ["将宇宙的怒火握于你的掌中。"]
	quest.68C53139E1D36746.quest_desc: ["可从所有生物处获得无限灵魂。"]
	quest.68D850868C481078.quest_desc: ["升级后的电子元件，专家模式下制作高级机械和能源系统所必需。普通模式下，仅用于制作溶解室和一些中后期的沉浸式工程组件。"]
	quest.68E1372233643800.quest_desc: [
		"使用光环时，有时无需亲临现场就能知道其区域等级会很有帮助。只要连接了比较器，$Aura Detector 就会根据周围环境的浓度发出红石信号。因此，其显示范围与环境之眼相似。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.68FE2BEC3C90AFFD.quest_desc: [
		"卡槽是一个便携式存储物品，可容纳多张 LaserIO 卡，方便在不同节点之间管理和切换。"
		""
		"卡牌是可升级组件，插入激光节点以定义其传输物品、流体、能量或红石的方式。"
	]
	quest.6920EAFAB5BDA9FE.quest_desc: [
		"将一个模式保持器放入包装器，另一个放入拆包器，两者都连接到ME网络。"
		""
		"包装器会接收物品并将其制成配方包，而拆包器则会将其取出并将物品输出到相邻的背包中。"
		""
		"两台机器会根据模式保持器和包装器向ME网络说明其可执行的操作，连接后包装器会将数据包弹出至网络"
	]
	quest.693C2DD84D42166A.quest_desc: ["Ex Machinis机器的升级。将鼠标悬停在升级上并按住Shift键以查看其效果。"]
	quest.694EEC7F7A1378D8.quest_desc: [
		"拥有一个能储存灵气的自然祭坛固然很好，但能随身携带会更方便。这时，灵气缓存器就能派上用场：它能储存大量灵气，方便随时使用。要填满缓存器，只需将其放置在自然祭坛上，等待灵气流入即可。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.6960CFAA0006178F.quest_desc: [
		"Mob Flow Utilities 是一款模块化自动化模组，通过定向流动控制、集中式伤害系统和智能物品收集来提高刷怪效率。设计简洁，GUI 极少，并有视觉反馈。"
		""
		"流动踏板："
		"- 定向移动：将生物和物品推向你放置的方向"
		"- 三种速度等级：快、更快、最快，对应不同的流速"
		"- Waterloggable：与水基农场设计无缝兼容"
		"- 无需配置：方向由放置朝向决定"
	]
	quest.6960CFAA0006178F.quest_subtitle: "Mob Flow Utilities"
	quest.696A38C5D80A2CDC.quest_desc: [
		"筛选泥土或按住 Shift 点击地面以获得鹅卵石。"
		""
		"将光标悬停在鹅卵石堆上，使用快捷键 \"shift\" + \"k\" 即可自动将其压缩成鹅卵石！"
	]
	quest.696A38C5D80A2CDC.quest_subtitle: "众神之神"
	quest.69C8C3F25F60409F.quest_desc: ["扩大了吸收漏斗可以收集物品/经验值的区域。"]
	quest.69D590FA274E2B41.quest_desc: [
		"将Flux Crafter放置于世界中，右键以查看GUI。内部有一个3x3的合成网格，类似于合成台。将配方材料放入网格中。"
		""
		"用于合成更复杂配方所需的组件。需要在制作者附近放置至少一个通有能量的纹流交替器。\""
	]
	quest.69D590FA274E2B41.quest_subtitle: "扩展合成系统 (Extended Crafting)"
	quest.69FEA176E2A431B2.quest_desc: ["催化剂用于复杂的合成配方。它们在层级越高时，合成难度也越大。"]
	quest.6A0BCEEBEAD7BAAC.quest_desc: ["Carminite 是一种可用于各种合成配方的项目。Carminite 是一种特殊项目，可在击败 Ur-Ghast 或合成后于宝箱中找到。"]
	quest.6A124FD18647572F.quest_desc: ["有时候，建造大型建筑可能有点乏味，而且需要付出很多努力。毕竟不是每个人都是建筑大师！Dire's Building Gadgets 旨在让建造变得更容易一些。"]
	quest.6A124FD18647572F.quest_subtitle: "建筑小工具"
	quest.6A174FEBD2766C23.quest_desc: ["把面包再烤一次，做成吐司——真美味！"]
	quest.6A3BC809F00251A2.quest_desc: ["这把红物质之剑本身就很强大，通过蓄力并激活(C)它，会消耗EMC来换取一次毁灭性的横扫攻击。攻击范围由蓄力等级(V, shift+V)控制。"]
	quest.6A3D025A3018689B.quest_desc: ["由10,000个电金锭制成"]
	quest.6A7C4E246A8EE29C.quest_desc: ["从神经网络数据模型中生成战利品。"]
	quest.6A82289C0937E69B.quest_desc: ["升级版，可同时处理两种物品，加快资源产出。"]
	quest.6AFF4DCE31DDCD21.quest_desc: ["右键控制器进行配置，如果普通抽屉/压缩抽屉/末地抽屉在范围内（默认半径8），右键它们即可将其与控制器关联。"]
	quest.6B205B114E270C9F.quest_desc: [
		"创意精华是所有创意物品的基础材料。"
		""
		"在制作创意物品之前，你必须完成该物品所属模组的任务章节。"
	]
	quest.6B2C7902C393895B.quest_desc: ["Tier 4 火箭将使你能够前往 Glacio，同时具备之前各等级的能力。"]
	quest.6B2F0714255943B6.quest_desc: ["[ \"必须完成此任务：\", { \"text\": \"访问水星\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"14F9F9F05968992D\" } }, \" 以解锁。\" ]"]
	quest.6B2F0714255943B6.quest_subtitle: "20 枚硬币"
	quest.6B2F0714255943B6.title: "传说奖励袋"
	quest.6B549E0874E32E16.quest_desc: ["催化剂用于复杂的合成配方。它们在层级越高时，合成难度也越大。"]
	quest.6BBEA10C1DF18B20.quest_desc: [
		"将绑定卡用于末影人或末影幼体上。"
		""
		"与不同维度的玩家建立连接！"
	]
	quest.6BC5D6D133C3F0A0.quest_desc: ["Ex Machinis机器的升级。将鼠标悬停在升级上并按住Shift键以查看其效果。"]
	quest.6BCDDE81CC8A2A67.quest_desc: ["由 729 块鹅卵石组成！"]
	quest.6C1BC64337960BA4.quest_desc: ["制作所有 Industrial Foregoing（及其他部分）机器都需要机器框架。"]
	quest.6C1D7C9A68FBB65D.quest_desc: [
		"创意模式升级，可无限访问抽屉中存储的物品，而不会消耗原始物品堆栈。"
		""
		"无法与创造模式物品一起使用。"
	]
	quest.6C647123A99A46DD.quest_desc: ["此区块生成器的速度为 8"]
	quest.6C682E372AB94474.quest_desc: ["最大方块数：27"]
	quest.6C71752F5F9B7222.quest_desc: ["和木桶一样，不过这个可以装岩浆等高温液体。"]
	quest.6C931BB4213DC381.quest_desc: ["此区块生成器的速度为 16"]
	quest.6D1640B0CC4ADAF6.quest_desc: [
		"特色功能："
		""
		"- 多区块建造：使用砖块、熔炉、排水口和窗户等各种方块，建造自己的熔炉，打造一套功能齐全的冶炼装置。"
		"高效熔炼：熔炉比传统熔炉熔炼矿石的速度更快，让你可以同时处理多种矿石，并用更少的燃料生产出更多的锭。"
		"- 铸造：熔炉拥有一个铸造系统，你可以将熔融金属倒入铸模中，打造出锭、方块或其他金属物品，为制作和资源管理增添了新的深度。"
		"- 可自定义设计：熔炉的大小和布局均可自定义，所有16种颜色的熔炉块均可与你的基地相匹配。"
	]
	quest.6D16777C65BCA017.quest_desc: [
		"Sophisticated backpacks 是又一个背包模组，这次你可以在世界中放置背包，用不同颜色组合染色，用更多物品栏升级，并用许多功能性升级来增强。"
		""
		"可通过按键访问（默认为 B 键）。"
		""
		"配件兼容性使得将背包放入“背部”槽位时，可以穿戴和渲染背包。"
		""
		"每个等级都会增加更多的存储栏位和升级栏位。"
	]
	quest.6D16777C65BCA017.quest_subtitle: "Sophisticated Backpacks"
	quest.6D594671ED743839.quest_desc: ["控制电路用于制作多种Mekanism物品和机器。Tier 4。"]
	quest.6D73A75D85AB43AE.quest_desc: [
		"利用红物质的力量，将红物质锤、红物质镐和红物质铲的功能整合到一把工具中。"
		""
		"红晨星可以快速采集地下的大部分方块（左键点击）。"
		""
		"和红物质镐一样，它也能单次操作（右键）采集一整条矿脉。"
		""
		"和红物质锤子一样，它可以根据充能等级收割一片区域内的所有方块。"
		""
		"和红物质铲一样，它会根据充能情况收割一大片泥土，或者一整条砾石矿脉。"
	]
	quest.6D73B59E96D6C032.quest_desc: ["杀死一头牛并烹饪其肉以获得牛排"]
	quest.6D73B59E96D6C032.quest_subtitle: "Minecraft"
	quest.6DA1F71A6E40CF8B.quest_desc: ["使用简单的烹饪系统和一些熟悉的食材，农夫乐事让你能准备各种各样的丰盛餐点：从三明治到沙拉和炖菜，从精美的甜点到令人垂涎的盛宴，厨房里不会有任何食材被遗忘！"]
	quest.6DB5CEA763B4C3F6.quest_desc: ["升级后的机器框架使用溶解室制作。参见JEI。"]
	quest.6E03872B3136B79B.quest_desc: ["沉浸式工程的组合机器。用漏斗放在顶部，以3x3的方式组装，然后用工程师之锤右键。就像高炉一样，但更棒！详情参见手册和JEI。"]
	quest.6E03872B3136B79B.title: "改良型高炉 (Improved Blast Furnace)"
	quest.6E0D7B1A597E170E.quest_desc: ["燃烧菜籽油并将其转化为能量。"]
	quest.6E485E15CB87CDC2.quest_desc: ["由 6561 块鹅卵石组成！"]
	quest.6EC8C1F16B88307A.quest_desc: ["Klein Star Omega 最多可容纳 51,200,000 EMC，也用于制作顶级 EMC 种子。"]
	quest.6EC90676B0EEB012.quest_desc: ["一种稀有的宝石，只能在天界群岛的天空岛屿中通过采矿获得。"]
	quest.6EEEDDEA96985BA2.quest_desc: ["基础物品收集器的收集范围最远可达5格！"]
	quest.6EF67A87979A9378.quest_desc: ["可以在不同地点之间创建传送门。跨维度有效！"]
	quest.6F68D029D176C4FC.quest_desc: [
		"浸透铁很不错，本身就有足够的自然力量能做很多事情。但对于更复杂的机制，需要更强大的金属。为此，以及其他许多事情，都需要向众神献上祭品。众神长期以来都是最强、最强大的存在，因此也拥有人类已知最强的金属。"
		""
		"要建造召唤众神的方法，只需按照指南放置祭坛，并在周围摆放一些花朵。然后，将任意数量的物品放入祭坛的碗中，再在祭坛附近投下能召唤众神的物品，通常是召唤之魂。如果运气好，所需的物品就会从天而降。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.6F96B0AF183634BE.quest_desc: ["由10,000个镍锭制成"]
	quest.6FA5A509D5C50572.quest_desc: ["这些工作台用于更复杂的合成配方。也有自动化版本可用。更多详情请见JEI。"]
	quest.701351A41247EC15.quest_desc: ["对鸡使用可生成臭鸡蛋。将鸡蛋点击在5x5的泥土块上，可生成恐怖泥土（天黑时会生成敌对生物）。"]
	quest.701D82D7BB8B6812.quest_desc: [
		"使用手册来学习如何建造沉浸式工程的每个多方块机器。"
		""
		"沉浸式工程是关于现实主义启发的技术："
		"它用真正的悬挂式电线取代了发光的红色管道。"
		"它不再是一个放入矿石就能神奇地吐出粉尘的方块，而是一个带有旋转轮子的大型多方块结构（5x3x3），在破碎矿石时会吐出粒子。"
		"它将激光（将能量转化为魔法光和矿石）替换为挖掘机，另一个巨大的、消耗大量资源的、由多区块（3x7x8）组成的机器，用巨大的旋转铲斗轮从地下挖掘矿石。"
		""
		"IE旨在让科技模组更平衡、更美观，并采用复古未来主义（如《生化奇兵》、《秩序1886》、《天空捕手与明日世界》）而非冷冰冰的白+灰未来立方体，增添独特风味。"
		""
		"它使用了几乎所有科技模组都有的Forge Energy API，但可以完全独立游玩。与其他模组不同，IE不是通过方块线路，而是通过连接器之间的电缆来传输能量。"
		""
		"该模组包含水车、风车、生物柴油等多种发电方式，许多机器都是多方块结构！"
	]
	quest.701D82D7BB8B6812.quest_subtitle: "Immersive Engineering"
	quest.707FCC07A558D9C6.quest_desc: ["利用相邻方块（如冰和岩浆）之间的温差来产生被动电力。"]
	quest.709A48BFDF90C78D.quest_desc: ["穿上盔甲后，除了太空服外，也能在太空中呼吸氧气（确保盔甲有能在太空生存的正确附魔/模组/升级）。此氧气在冷热天体上均可使用。"]
	quest.709AE9E272CD7894.quest_desc: ["升级后的机器框架使用溶解室制作。参见JEI。需要以太气体，用流体激光从凋零处采集。"]
	quest.70A8E4AE5CBA60D7.quest_desc: [
		"要使用框架方块，请执行以下操作："
		""
		"- 用几乎任何实心方块右键点击该方块，使其外观相同。"
		"- 用流体容器右键点击方块，使其看起来像容器中的流体。"
		"- 右键点击发光石粉所在的方块，使其产生光亮。"
		"- 用 Framed Hammer 右键点击方块以移除伪装。"
		"- 用空流体容器右键方块以移除流体伪装。"
	]
	quest.70C9EAA003A86448.quest_desc: ["由游戏中最昂贵的锭制成。可能不是建造的最佳选择。"]
	quest.70D9A79728CFE5F4.quest_desc: ["比繁荣碎片更复杂的合成材料，用于在神秘农业中取得进展。"]
	quest.70D9A79728CFE5F4.title: "宝石和锭（Gemstone and Ingot）"
	quest.70FCC2680E0A8B96.quest_desc: [
		"Mekanism 的基础材料。"
		""
		"在 Mekanism, Inc.，我们为您带来一系列低、中、高阶的机械设备，将您过时的家园和低效的资源处理提升至21世纪。借助我们的高科技工具、高端能源发电机、先进的传输系统和复杂的处理机制，您将摆脱“采矿”和“制作”的繁琐任务，迅速迈向新的科技启蒙境界。"
		""
		"你可能没意识到，每次将矿石直接熔炼成锭，都会浪费大部分开采的资源。Mekanism 经验丰富的化学和机械工程师团队开发了先进的矿石处理设备，能最高效地提取矿石中的资源。借助我们的提纯、溶解、化学注入和结晶技术，只要有足够的基础设施和能源，每单位矿石的锭产量可翻倍、三倍、四倍，甚至五倍。"
		""
		"我们的工程团队理解并支持渐进式技术发展。无论您处于哪个游戏阶段，我们都能提供适合您需求的机械层级。每种Mekanism机器都可升级为工厂，让您能在单一机器中同时处理3（基础）、5（高级）、7（精英）甚至9（终极）种不同物品！告别那些曾遍布家园、缓慢又丑陋的熔炉阵列。立即使用Mekanism，整合您的机械基础设施。"
	]
	quest.70FCC2680E0A8B96.quest_subtitle: "Mekanism"
	quest.7105D5D0A4CAABA2.quest_desc: [
		"灌注祭坛是多方块灌注合成结构的核心组件。它与灌注基座主要用于合成资源种子和增强物。用途请见JEI。"
		""
		"要使用灌注祭坛，你必须先将其放置在世界中。确保周围没有障碍物。然后，必须在祭坛周围放置灌注基座。祭坛会在世界中显示虚影基座，指示你放置基座的位置。"
		""
		"祭坛设置好后，手持物品右键祭坛和基座即可放置物品。"
		""
		"要激活祭坛，可以用红石信号（如按钮、拉杆）来触发它。"
	]
	quest.71104655F18FBDB1.quest_desc: ["用于建造和升级发电机、能量电池及其他电力相关设备的合成组件和储能物品。"]
	quest.712D46C093C92BA7.quest_desc: ["一种高度先进的多方块结构，能产生巨量的RF能量，但需要谨慎管理以防止灾难性爆炸。"]
	quest.712D46C093C92BA7.title: "龙之反应堆"
	quest.7139AC799DC225FA.quest_desc: ["每个等级都会增加更多的存储栏位和升级栏位。"]
	quest.714DD2BC87D5A3A8.quest_desc: ["用钓竿打破被感染的树叶以获得线！"]
	quest.71985D320264CC4B.quest_desc: ["如何更改纹理：在合成窗口中，将用于抽屉外部的纹理方块放在第一格，将用于抽屉内部纹理的方块放在第二格，第三格放置一个带框抽屉。将方块放入第四格可以更改抽屉分隔板的纹理。"]
	quest.71C5B72891529DDB.quest_desc: ["能赋予不同增益的特殊苹果！将鼠标悬停在苹果上并按住 Shift 键查看其效果。"]
	quest.71E75FEACF764F83.quest_desc: [
		"通过仪式，可以获得代币的知识：木制小雕像，描绘着关键情感——由注入了相应符号的树木制成。这些小雕像蕴含着气场本身及其所代表情感的巨大力量。未来，这些代币将成为重要的建造材料。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.71E75FEACF764F83.title: "恐惧与悲伤"
	quest.72353D397FFE788A.quest_desc: ["由10,000青铜锭制成"]
	quest.7267D02BE7F9E8B7.quest_desc: [
		"可用于蓄电器中快速生成用作溶剂的氯化铵。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.72744CCF4110F9DD.quest_desc: [
		"带有升级插槽的 Ender IO 机器需要电容器才能运行。"
		""
		"电容器可以根据其基础修饰符，提升机器的速度、射程或能量存储。"
		""
		"等级：5"
	]
	quest.727C435CCD8998A1.quest_desc: ["使用原子重构器将矿物转化为强大的晶体，用于制造物品处理和分类的实用机器、无线传输能量、物品和流体的激光器、用于发电的可再生石油等等。"]
	quest.7284146C05F63CB7.quest_desc: ["Mekanism 的量子纠缠传送器是一种机器，可通过通道将液体/物品/能量/气体从一个量子纠缠传送器发送到另一个。"]
	quest.7284146C05F63CB7.quest_subtitle: "Mekanism"
	quest.72A28DEFA6AC4A0F.quest_desc: ["这台机器有两个功能。第一，放入其物品栏的任何物品都会转化为 EMC。第二，它将能量从能量收集器传输到能量冷凝器。传输时，每秒会额外提供 1 EMC 的少量加成。它也被用来用 EMC 为 Klein Star 系列充电。"]
	quest.72B11DB251170E68.quest_desc: ["合成组件。可升级至下一阶段，请参见JEI。"]
	quest.72C6F582DAA81CBF.quest_desc: ["一种使用模具和能量将金属锭和其他材料塑造成板、棒、齿轮等的多块机器。"]
	quest.72C6F582DAA81CBF.title: "金属压制机"
	quest.731CFBA9CEF27A6A.quest_desc: [
		"欢迎来到 MuggleOrWizard 制作的专家级整合包 Ozone Skyblock Reborn 2！本整合包是 Ozone Skyblock Reborn 的续作。如果你在游玩过程中有任何疑问或意见，欢迎在项目页面留言、在 Curseforge 上给我发消息，或加入 Discord 服务器。"
		""
		"如果是多人游戏，可以运行命令“&b/skyblock gui&r”来查看如何为每个人/每个小组创建岛屿和团队。要创建或加入用于任务/区块的团队，请在打开物品栏时点击屏幕左上角的团队图标。任务书也在那里可以找到。"
		""
		"&4阅读带有心形图标的任务，了解不同的整合包模式！&r"
		""
		"&2本整合包系列灵感源自 TheCazadorSniper 制作的“Project Ozone”整合包系列。若你未玩过，强烈推荐你去体验一下——你可以在 Curseforge 应用上找到它。&r"
		""
		"部分任务描述可能引用或改编自模组的项目页面、Wiki 或游戏内指南。所有权利归模组和 Wiki 作者所有。如需了解更多信息，请访问 Ozone Skyblock Reborn 2 项目页面，向下滚动至模组列表，然后点击您想了解的模组。"
	]
	quest.731CFBA9CEF27A6A.quest_subtitle: "阅读后请点击勾选框！"
	quest.732A662662650FD1.quest_desc: ["Infusion Altarnator 是 Infusion Altar 的单方块自动化版本。"]
	quest.732A662662650FD1.quest_subtitle: "神秘自动化"
	quest.735C3B21ACEECB35.quest_desc: [
		"Mystical Agricuture 中有六个等级的种子。"
		""
		"Tier 6 的种子需要 insanium essence 来制作，并且需要相应的 crux 才能生长。"
	]
	quest.736D8DE746E2BC8D.quest_desc: [
		"在酿造台内使用可制作或酿造各种物品。也可以食用来治愈你的疾病。"
		""
		"在Undergarden底部的dreadrock下发现。需要一把Forgotten Pickaxe才能破坏dreadrock。"
		""
		"小心，待在 dreadrock 下的时间越长，你就会越不舒服。"
	]
	quest.737DDA1BE324E0ED.quest_desc: ["此区块生成器的速度为 4"]
	quest.737F70A6CF790A64.quest_desc: ["用煤炭或木炭制作的简易发电机"]
	quest.737F70A6CF790A64.quest_subtitle: "RF Tools"
	quest.738F83FF42EC9E08.quest_desc: ["利用煤炭和其他可燃材料来产生电力。"]
	quest.7398BF7730A7D6FF.quest_desc: ["使用 energizing orb 制作。用于创造无线传输能量的物品，请参见 JEI。"]
	quest.739E1E96A6CE1DE8.quest_desc: ["点击以创造气压！"]
	quest.73EFC7030BF6A7DE.quest_desc: ["使用塑料在压力舱中制造而成。"]
	quest.740583FBFABFEC87.quest_desc: [
		"SAG Mill 使用能量将物品研磨成粉碎后的形态，例如将矿石磨成粉尘。SAG Mill 有四个输出槽；配方可以有 1-4 种不同的输出，且每种输出的获得概率各不相同。"
		""
		"SAG Mill的独特之处在于，它可以使用由不同材料制成的研磨球来提高能源效率（从而实现更快的处理速度）、增加额外产出的概率，并有几率使所有产出翻倍。这使得SAG Mill成为处理矿石的热门选择，尤其是那些具有理想额外产出的矿石。"
	]
	quest.74353DACE7BECFB0.quest_desc: ["Desh 可以在月球上找到。"]
	quest.74795B5D24F8B27F.quest_desc: [
		"与存储终端类似，但增加了一个合成界面。"
		""
		"&4注意：为提高性能，建议将终端直接放置在物品连接器方块上。&r"
	]
	quest.749846E05249E17D.quest_desc: [
		"扳手用于配置管道。随着进度推进，还能获得其他电缆选项。"
		""
		"Pipez 模组添加了简单且高度可配置的管道。包含高度可配置的过滤系统和升级等级。现已加入 Pretty x Smart Pipez 资源包！"
		""
		"注意：在管道众多的世界中，部分玩家可能会出现TPS延迟！"
	]
	quest.749846E05249E17D.quest_subtitle: "管道匠模组"
	quest.749E64CD1E5C5529.quest_desc: ["由10,000个银锭制成"]
	quest.74F53C25C2448D66.quest_desc: ["如果你想突破8个通道的限制，或者想连接多个独立网络，可以使用路由器创建一个“路由网络”。单个路由器就足以连接多达六个（路由器六个面）通道，但使用路由电缆和路由连接器，你也可以用路由器构建一个路由网络。注意，单个路由网络中只能有32个已发布的通道。"]
	quest.75399B382F21F8D9.quest_desc: ["使用最大生长加速器自动化至少20种不同神秘农业作物（种植、收获、压缩、存储）。"]
	quest.753C66ACDDE9F171.quest_desc: [
		"带有升级插槽的 Ender IO 机器需要电容器才能运行。"
		""
		"电容器可以根据其基础修饰符，提升机器的速度、射程或能量存储。"
		""
		"等级：9"
	]
	quest.75672DB7BA4D3F9C.quest_desc: ["用于制作玩家发射器。"]
	quest.75748983DF84E9AF.quest_desc: ["使用热源和冷却剂来产生RF。"]
	quest.757EE53215AB84B7.quest_desc: [
		"合金熔炉使用电力来熔炼物品和制造暗钢等合金。合金熔炉有三个输入槽和一个输出槽。"
		""
		"右下角有一个“熔炉模式”按钮，包含三种不同选项："
		""
		"- 仅限熔炉：合金熔炉将只熔炼熔炉配方。"
		"- Alloys Only: 合金熔炉将只生成合金。"
		"- 所有熔炼：合金熔炉既能熔炼熔炉配方，也能制造合金。"
		""
		"默认情况下，该机器能够生产其他模组以及 Ender IO 的合金。"
		""
		"Ender IO 是一款功能齐全的科技模组。它包含盔甲、工具、武器、机器、导管、物品栏管理、生物等。"
		""
		"&4Ender IO 目前仍处于 Beta 阶段，并正在为最新版本的 Minecraft 进行全面重写。因此，部分功能尚未移植，且可能存在一些 bug。&r"
	]
	quest.7580866D67B0614F.quest_desc: ["由10,000个铂锭制成"]
	quest.758C366E1C73F7D3.quest_desc: ["蜘蛛眼是一种有毒的食物和酿造材料。它也被用来引诱和繁殖犰狳。通常由蜘蛛、洞穴蜘蛛和女巫掉落。"]
	quest.75A9DCE3CFFAF413.quest_desc: ["将鼠标悬停在物品上并按住 Shift 键以查看属性。"]
	quest.75AD65B7786D4698.quest_desc: ["最大方块数：1024"]
	quest.75CDC6EFC1F77557.quest_desc: ["杀死一只猪并烹饪其肉以获得猪排"]
	quest.75CDC6EFC1F77557.quest_subtitle: "Minecraft"
	quest.75EAFCA3CA9A12BB.quest_desc: ["制作一个双压缩的 Torcherino。"]
	quest.75EAFCA3CA9A12BB.title: "Torcherino"
	quest.76110B292750ABFA.quest_desc: ["元素种子可创造元素精华——用于制作觉醒超贵金属。"]
	quest.7613DCA157D6F599.quest_desc: ["功能与普通激光连接器相同，但支持更快的传输速度和更长的连接范围。"]
	quest.761C779A9A7EB48B.quest_desc: ["将下界之星转化为RF能量。"]
	quest.7633206043183189.quest_desc: ["在AE系统中储存空气、化学品、能量和灵魂！"]
	quest.7633206043183189.title: "其他方块类型"
	quest.76685F7238F1FDAA.quest_desc: ["用价值2000级的经验填满一座经验方尖碑。"]
	quest.7669D1D2ADABBC61.quest_desc: ["能量立方可用于存储大量RF。等级越高，存储的RF越多。等级2！"]
	quest.7690DEBD9A96EAF3.quest_desc: ["在Aether中通过挖矿发现。"]
	quest.769575F6979C0E37.quest_desc: ["升级后的熔炉，基础烹饪时间为 140"]
	quest.76DD2F948B595981.quest_desc: ["比普通导入总线快8倍——物品吞吐量高。"]
	quest.76DD2F948B595981.quest_subtitle: "ExtendedAE"
	quest.76F78E32732D4474.quest_desc: ["制作每种可用 Mystical Agriculture 种子至少一个（列表见 JEI）。"]
	quest.7707E9D68DDB4F1C.quest_desc: ["在以太地牢中击败女武神即可获得。"]
	quest.77242D5BCA09AD9E.quest_desc: ["由 4782969 块鹅卵石组成！"]
	quest.77290C3E67AAB489.quest_desc: ["附魔金苹果是一种食物，食用后能赋予比金苹果强大得多的效果。"]
	quest.779090C8D9766F2E.quest_desc: ["每秒被动产生4 EMC，最高可达10,000 EMC，具体取决于最高光照等级。当放置在能量冷凝器MK1、能量冷凝器MK2、反物质中继器MK1、反物质中继器MK2或反物质中继器MK3旁边时，会将EMC传输至该机器。"]
	quest.77B98898046B2C62.quest_desc: ["用吊扇的力量保持凉爽吧！"]
	quest.77BC2640080C1E28.quest_desc: [
		"沉浸式工程学的多方块机器。以3x3排列并用工程师之锤右键。用铁和煤炭焦油制作钢。详情见手册和JEI。"
		""
		"需要下界岩吗？当岩浆流入女巫水时，会形成下界岩，从而实现下界岩版的鹅卵石生成器。"
	]
	quest.77BC2640080C1E28.title: "简易高炉 (Crude Blast Furnace)"
	quest.77BFFEA747850123.quest_desc: ["升级后的精华需要使用上一等级的精华和灌注水晶来制作。用于创造第6等级的种子。（专家模式下需要水晶）"]
	quest.77E52A098E50BDEB.quest_desc: [
		"用扳手将发电机连接到工作台。使用工作台来制作家具！"
		""
		"隆重推出新一代 MrCrayfish's Furntiure Mod，采用全新方块、模型、原创音效和游戏机制。体验原版模组既熟悉又新颖的魅力，用数百种全新的装饰和功能方块来布置你的家。电力系统的引入带来了全新的游戏玩法，可为所有电器和电子设备供电。"
	]
	quest.77E52A098E50BDEB.quest_subtitle: "MrCrayfish's Furniture"
	quest.781B94F14DB8567B.quest_desc: [
		"一种通过蒸发来增加水中残留的氯化铵浓度的简易装置。"
		""
		"将蓄水池放在储罐顶部。用装满水，让魔法发生！"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯秘学》（The Hermetica）。"
	]
	quest.783995D4473F8F16.quest_desc: ["Iron Jetpacks 是一款功能丰富且易于使用的现代喷气背包模组。背包等级越高，性能越好。线圈是背包制作的重要组成部分。请参见 JEI。"]
	quest.78551C2B291A2FF4.quest_desc: [
		"右键可立即根据充能等级挖掘方块 (V, shift+V)。"
		""
		"- 已禁用"
		"- 3x3x2"
		"- 5x5x3"
		"- 7x7x4"
		""
		"不会挖掘泥土或砾石。它也是一种强大的武器，可以作为工具一次挖掘单个方块。"
	]
	quest.7865E729501709AB.quest_desc: ["这是游戏中最昂贵的锭。请不要把它掉进虚空里。"]
	quest.7876E8455AEF262E.quest_desc: ["使用 Empowerer 将矿物转化为强大的晶体，用于制造物品加工和分拣的机器、无线传输能量、物品和流体的激光器、用于发电的可再生石油等。"]
	quest.78894BE946EAEC1A.quest_desc: ["使用铀矿、红石、煤炭、水和干冰来产生RF。"]
	quest.78A26490832112B9.quest_desc: ["除非在此期间收到脉冲，否则生成一个定时红石脉冲"]
	quest.78FD281689257180.quest_desc: [
		"由字符串网格升级而来。"
		""
		"随着网格层级升高，筛分方块产出的物品会发生变化。详情请见JEI。"
	]
	quest.79929E7B59774B6F.quest_desc: ["使用 energizing orb 制作。用于制作 niotic tier Powah 物品的配方。"]
	quest.79A6A2865FCF6823.quest_desc: ["利用太阳能（太阳）来产生RF。第一级！"]
	quest.79C940682CE162AD.quest_desc: ["用于建造和升级发电机、能量电池及其他电力相关设备的合成组件和储能物品。"]
	quest.79E4B4E103F1BCD2.quest_desc: ["像个大 boss 一样阻止生物生成！"]
	quest.79F4C05D5286D51B.quest_desc: ["Hostile Neural Networks 是一款基于 Deep Mob Learning 的模组，适用于 1.16.5 及以上版本。它允许你训练数据模型和运行模拟，生成生物预测，可用于生成生物战利品。"]
	quest.79F4C05D5286D51B.quest_subtitle: "敌对神经网络 (Hostile Neural Networks)"
	quest.7A0CF4B9EC0C721A.quest_desc: ["作为熔炉燃料，它的效率是煤炭的两倍；它能冶炼16个物品，而煤炭只能冶炼8个。"]
	quest.7A2458033521612B.quest_desc: ["精粹工具是使用增强器升级的高级工具。"]
	quest.7A5DEEFFB61A001D.quest_desc: [
		"Mystical Agricuture 中有六个等级的种子。"
		""
		"Tier 6 的种子需要 insanium essence 来制作，并且需要相应的 crux 才能生长。"
	]
	quest.7A9732E087A91D3A.quest_desc: ["Klein Star Sphere 最多可容纳 12,800,000 EMC，也用于合成 Klein Star Omega。"]
	quest.7AD5C805CE2E669A.quest_desc: ["无线合成终端与普通无线终端类似，所有设置和版块都相同，但增加了一个合成网格，该网格会自动从网络存储中填充。注意在Shift-点击输出时小心！"]
	quest.7AE22C13A4E632C0.quest_desc: ["能赋予不同增益的特殊苹果！将鼠标悬停在苹果上并按住 Shift 键查看其效果。"]
	quest.7B1F4ED59085AA90.quest_desc: ["使用末地珍珠杀死一个凋零。"]
	quest.7B4A91932EDD8AA6.quest_desc: ["加载区块，这样你不在时，东西也能继续运作。7x7区域。"]
	quest.7B93DDD4D0F141F5.quest_desc: [
		"这样就能轻松自动保持 Applied Energistics 2 ME 系统中的物品和流体库存！"
		""
		"ME 请求器可容纳 5 个请求。你可以在系统中放置任意数量的请求器，并通过 ME 请求器终端远程访问。该终端允许你远程配置请求和监控状态。"
	]
	quest.7B93DDD4D0F141F5.quest_subtitle: "ME 请求器"
	quest.7BB443B4C618BE99.quest_desc: ["由10,000颗钻石制成"]
	quest.7BBDF9B27538EBBF.quest_desc: ["能吸物品和XP球。可以把物品导入箱子，XP导入储罐！"]
	quest.7BBDF9B27538EBBF.quest_subtitle: "生物群系刷怪工具包"
	quest.7BE09731E15491FC.quest_desc: [
		"Industrial Foregoing 是一款全面的工业自动化模组，旨在简化并优化你的游戏内生产系统！它灵感源自经典的 MineFactory Reloaded，为 Minecraft 带来了现代化的科技机械和工具，让玩家能够创建复杂的自动化系统，用于农作物种植、资源加工、动物照料等。"
		""
		"借助各种工业机器和工具，你可以在Minecraft中自动化几乎所有任务。从资源采集、加工到农场和生物管理，Industrial Foregoing都提供高效创新的机器。"
	]
	quest.7BE09731E15491FC.quest_subtitle: "Industrial Foregoing"
	quest.7BF4DBAFDA24E9D8.quest_desc: ["使用 energizing orb 制作。用于制作 spirited tier Powah 物品的配方。"]
	quest.7C14C70D761F3406.quest_desc: ["分子合成器的增强版 - x8 并行合成。"]
	quest.7C14C70D761F3406.quest_subtitle: "ExtendedAE"
	quest.7C2F4BFAE63F720C.quest_desc: ["存储组件是所有AE2单元的核心，决定了单元容量。每个等级容量提升4倍，消耗3个上一等级的组件。"]
	quest.7C2F4BFAE63F720C.quest_subtitle: "MEGA 细胞"
	quest.7C76B69A5387A4B9.quest_desc: [
		"用作配料和能量来源。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯秘学》（The Hermetica）。"
	]
	quest.7CA54B9E1247379E.quest_desc: [
		"像你这样的炼金术士，没时间总是存取物品。你把高纯度共价尘撒在炼金箱上，再用布包裹，成功把它缩小成了一个小袋子的尺寸。"
		""
		"袋子的容量和箱子一样大。有趣的是，袋子似乎连接着某种形而上学的网络，所有同色袋子里的物品都相同，无论袋子是你的还是邻居的。袋子激活物品的方式和箱子也一样。"
	]
	quest.7CA72D24324AAD71.quest_desc: [
		"用于发酵桶中配方的发酵助剂。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.7CB1BDAA829F44E1.quest_desc: ["催化剂用于复杂的合成配方。它们在层级越高时，合成难度也越大。"]
	quest.7CB1BDAA829F44E1.quest_subtitle: "扩展合成系统 (Extended Crafting)"
	quest.7D38B35F53BD03BE.quest_desc: ["允许终端/合成设备无限距离操作。"]
	quest.7D38B35F53BD03BE.quest_subtitle: "AEInfinityBooster"
	quest.7D7844AD2210361D.quest_desc: ["燃烧可燃燃料！"]
	quest.7D854FA56E399F98.quest_desc: ["一种用于扩展和连接激光节点网络的方块，允许物品、流体、能量或红石在长距离内传输。"]
	quest.7D8F28A3E8A48CE7.quest_desc: ["可在传送前选择目的地。必须拥有发射器和接收器。"]
	quest.7DB698F871417522.quest_desc: ["水晶箱由钻石箱升级而来。容量相同，只是能看穿！"]
	quest.7DB74BAC57F10381.quest_desc: ["[ \"必须完成此任务 \", { \"text\": \"牧羊人派\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"44750CE6BE9DB523\" } }, \" 才能解锁。\" ]"]
	quest.7DB74BAC57F10381.quest_subtitle: "10 枚硬币"
	quest.7DB74BAC57F10381.title: "遗迹奖励袋"
	quest.7DCFA1397747BF96.quest_desc: ["加载区块，这样你不在时，东西也能继续运作。5x5区域。"]
	quest.7E1ADEEC8EADE7A8.quest_desc: [
		"ProjectE 是 Equivalent Exchange 2 的开源重制版，适用于 Minecraft 1.7.10 及更高版本。它允许用户使用各种物品和机器将材料转化为其他材料。它添加了一个名为能量-质量共价性（EMC）的系统，用于表示物品的价值。"
		""
		"该值因物品而异，用于确定一种材料需要多少另一种材料。EMC也可以通过其他方式存储和产生。某些方块和物品也会使用EMC来执行强大的效果。"
		""
		"&2注意：并非所有物品都有 EMC 值。&r"
	]
	quest.7E1ADEEC8EADE7A8.quest_subtitle: "ProjectE"
	quest.7E1ADEEC8EADE7A8.title: "共价粉尘"
	quest.7E56A182F8DEF697.quest_desc: ["破碎机，顾名思义，就是用来粉碎东西的。不要和富集室搞混了。"]
	quest.7E7C8A3B94BF6C37.quest_desc: ["用效率和幸运附魔你的工具，提升速度并获得更好的掉落率！"]
	quest.7ED21876B4C1CE24.quest_desc: ["将贝尼托石与罗西尼石再加工获得，而罗西尼石是使用韦德留姆作为燃料在反应堆中产生的废料。"]
	quest.7EEF3486A0EB8B61.quest_desc: ["使用能量来自动化凿刻方块！"]
	quest.7EF319CB8B4339B6.quest_desc: ["这套太空服能在寒冷环境的天体（月球、火星、冰川）上保护你。"]
	quest.7EF319CB8B4339B6.title: "太空服"
	quest.7EFFE27D4D7E6668.quest_desc: [
		"像电池一样储存RF！"
		""
		"它是一个无定形的多方块结构；将一个基础电容器组放在另一个基础电容器组旁边，即可合并它们的储能。"
	]
	quest.7F1466B397B51F04.quest_desc: ["在 Infuser 中结合 Rogdorium（或彩色宝石）和 Utheric Shards 以获得 Utherium Crystals。"]
	quest.7F147A591795B284.quest_desc: [
		"世界中的灵气总量有限，一旦耗尽似乎无法恢复，这确实令人担忧。但事实并非如此：有许多方法可以再生灵气。请参阅指南手册了解具体说明。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.7F147A591795B284.title: "光环生成"
	quest.7F24945B6C1F2800.quest_desc: ["此内容在整合包开始时即已解锁。"]
	quest.7F24945B6C1F2800.quest_subtitle: "3 枚硬币"
	quest.7F24945B6C1F2800.title: "普通奖励袋"
	quest.7F3DEB9D1E5BC790.quest_desc: ["这些是AE2输入输出设备的主要组件。借助Fluix水晶和逻辑处理器的力量，设备可以输入输出物品、方块、流体等。（无实际功能，仅为合成中间体）"]
	quest.7F3DEB9D1E5BC790.title: "核心组件"
	quest.7F6DDDD318E1BFCC.quest_desc: ["铁质箱子由铜质箱子升级而来。"]
	quest.7FF33FA53596F5F3.quest_desc: [
		"一个被黑暗笼罩的单生物群维度。"
		""
		"- 普通火把会随着时间的推移而熄灭。"
		"- 黑暗本身会造成伤害，所以保持光亮。"
		"- 敌对生物频繁生成，并且拥有额外的生命值。"
		"- 矿石丰富，是绝佳（但危险）的采矿区。"
		""
