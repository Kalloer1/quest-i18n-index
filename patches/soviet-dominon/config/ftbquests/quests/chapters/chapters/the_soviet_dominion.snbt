					author: "Voice of the revolution"
					display: { }
					pages: [
						"{\"extra\":[{\"text\":\"The resistance was formed of many great warriors. The Communist rule of the \"},{\"color\":\"dark_red\",\"text\":\"Soviet Dominion\"},{\"text\":\" was getting... out of hand. Stalins \"},{\"bold\":true,\"color\":\"dark_purple\",\"text\":\"head scientist\"},{\"text\":\" was messing with a force that should not be wreckened with.\"}],\"text\":\"\"}"
						"{\"text\":\"The Soviet Dominion had a small secret Resistance pact that was growing... but suddenly... IT came... Many say it was the works of stalin... others say it was a demon sent from hell its self.\"}"
						"{\"extra\":[{\"text\":\"But it destroyed it all. Stalin vanished. The whole country was in ruin... and he is still out there... Survivor you must complete was had begun stop this demon and save us all.. but beware \"},{\"bold\":true,\"obfuscated\":true,\"color\":\"red\",\"text\":\"THe BEAST\"}],\"text\":\"\"}"
					]
					resolved: 1b
					title: "抵抗值"
				}
			}
