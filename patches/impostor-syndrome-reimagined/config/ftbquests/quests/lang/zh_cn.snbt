	quest.7A20F5EAA29FF46B.quest_desc: [
		"这是 Impostor Syndrome - Reimagined 0.7 版本。"
		""
		"该整合包仍在积极开发中，所以你可能会遇到bug或完全无法使用的东西。如果遇到这种情况，请务必在我们的Discord上告诉我，这样我才能修复所有问题！"
		""
		"https://discord.gg/D2cabqkU3m"
	]
	quest.7A20F5EAA29FF46B.quest_subtitle: "仍在建设中！"
	quest.7A20F5EAA29FF46B.title: "版本信息"
	quest.7A32764949BB99E2.quest_desc: [
		"不可思议。我又一次将其推进了更远的领域，但我仍不满意。这还不够。"
		""
		"在探索世界最深处时，我竟忽略了海洋的奥秘。这显然是一个错误，因为我发现了更多前所未见的新生物。这让我反思，是否还有更多未知等待着我？是时候回归基础，重塑我的探索方式了。"
		""
		"更多信息请参见“扩展合成与地下花园”章节！"
	]
	quest.7A32764949BB99E2.quest_subtitle: "比海洋更深的地方并不存在"
