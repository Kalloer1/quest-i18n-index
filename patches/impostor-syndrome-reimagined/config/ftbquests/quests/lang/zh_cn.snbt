	quest.4B25E302A39C51AB.title: "&5厄运&r之盘"
	quest.4B3A1E392D127CCC.quest_desc: [
		"知识树上的某些任务比其他任务更“重要”。这些任务是钻石形状的，完成一个会将你的难度等级设为固定数值。"
		""
		"难度等级变化的任务列表如下，同时标明了它们会将你的难度设置为多少。"
		""
		"Ender IO - 25"
		"Aether - 35"
		"Industrial Foregoing - 50"
		"末地 - 75"
		"Avaritia - 150"
		"The Undergarden - 300"
	]
	quest.4B3A1E392D127CCC.quest_subtitle: "让你时刻保持警惕！"
	quest.4B3A1E392D127CCC.title: "难度里程碑"
	quest.4B4E270489DFE512.title: "&c氮气&r能量电池"
	quest.4B553343BDE7D9B4.quest_desc: ["带有&9Draconium Dust&r标记的普通注射器，供&dFusion Package Crafter&r使用。单独制作可将其还原为普通注射器。"]
	quest.4B553343BDE7D9B4.quest_subtitle: "Tier I 自动化系统"
	quest.4B553343BDE7D9B4.title: "&d已标记&r &9德拉科尼ウム&r 注射器"
	quest.4B836CF50F15E47E.quest_desc: ["添加尖刺、角和翅膀以召唤&cWilden Chimera&r。"]
	quest.4B836CF50F15E47E.title: "&2野性&r仪式"
	quest.4B85D83C46CDB7E5.title: "&6中型&r 坦克"
	quest.4B9453FA92DD763F.title: "&4黑暗阵营的新成员&r加入"
	quest.4B9A5E222F19B674.quest_desc: [
		"不出所料，我征服了那头野兽。"
		""
		"在所有敌人中，他是最顽强的一位。我虽幸存，却伤痕累累，而这些疤痕将永远是他对妻子之爱的象征。"
		""
		"看来和他一样，他也是在保护某样东西。不是孩子，而是一颗纯粹的混沌水晶。当他发现她时，是否任由它占据了主导？他的力量是否都源于此？我不知道。但我知道，我可以用它来为我所用。将这股力量的一丝与我自己创造的力量相结合，应该会得出令人着迷的结果。终于，我能看到这段漫长旅程的终点了。"
		""
		"更多信息请参见“Powah”章节！"
	]
