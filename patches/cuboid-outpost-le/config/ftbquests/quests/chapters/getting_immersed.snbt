			]
			description: [
				"我们即将踏入沉浸式工程学的奇妙世界……"
				""
				"不过，我们在这个阶段还不会淹死！我们有一个明确的目标，这将在不久的将来让种植变得简单得多。"
			]
			id: "656C9C0843F67B03"
			shape: "gear"
			subtitle: "...在工程学中"
			tasks: [{
				id: "2FA23F81FE8D046A"
				title: "沉浸其中，乐在其中"
