				type: "item"
			}]
			x: -1.0d
			y: 1.5d
		}
		{
			dependencies: ["77164C9BAEC48316"]
			description: ["精英物流运输机每秒可将最多64个物品移动4格。"]
			id: "6ABF0D13FB892268"
			tasks: [{
				id: "699E6DFA9FF05587"
				item: "mekanism:elite_logistical_transporter"
