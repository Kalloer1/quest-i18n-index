					id: "02BF74D604F29B44"
					item: "powah:crystal_niotic"
					type: "item"
				}
				{
					id: "72DD36852D86144C"
					item: "cookingforblockheads:preservation_chamber"
					type: "item"
				}
				{
					id: "737EF7E5A68A6FFA"
					item: "cookingforblockheads:fridge"
					type: "item"
				}
				{
					id: "79FAE8B2E8970B31"
