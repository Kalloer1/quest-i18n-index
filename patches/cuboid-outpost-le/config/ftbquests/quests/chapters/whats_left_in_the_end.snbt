	quest_links: [ ]
	quests: [
		{
			description: [
				"正如科学部所推测的，这个维度？世界？存在平面？之间的帷幕似乎正在变薄。他们认为，只需稍加努力，你就能穿透这层帷幕。"
				""
				"在出发前还需要做一些准备，但在尝试跨维度旅行之前，你应该确保自己已经准备好以下物品。建议："
				""
				"- 准备一个喷气背包以防需要飞行（参见“机械化”或“冲上云霄！”）"
				""
				"- 需要一个背包来携带你找到的东西（参见“收拾行囊”）"
				""
				"- 准备好弓箭和充足的箭矢储备"
				""
				"- 准备好合适的护甲和武器，以防需要保护自己"
				""
				"- 准备一套工具、一些食物、燃料和建筑材料，以防你需要在那里待上一段时间"
			]
			id: "3EB44710A602ED1E"
			shape: "gear"
			tasks: [
				{
					id: "489B46244C56D864"
					item: "mekanism:ultimate_control_circuit"
					type: "item"
				}
				{
					id: "039832C9379F82A4"
