			y: -10.0d
		}
		{
			dependencies: ["4779353344322ACD"]
			description: [
				"海带生长在水下。"
				""
				"建议种植深几格，因为它会一直长到地表。"
				""
				"水不需要在整个向上延伸的路径中都是水源方块。"
				""
				"你也可以直接重新种植海带，以长出更多的海带。"
			]
