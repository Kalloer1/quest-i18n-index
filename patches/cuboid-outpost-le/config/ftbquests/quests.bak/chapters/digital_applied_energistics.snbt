	quests: [
		{
			title: "数字存储：应用能源学 (Applied Energistics)"
			x: -3.0d
			y: 0.0d
			shape: "gear"
			description: [
				"除了提升数字存储能力，现在你还能制作存储组件和各种处理器，ME 系统能做的事情也更多了。"
				""
				"本附录旨在为您提供足够的入门知识，希望您能运用 Cuboid Corp (tm) 及我们的合作伙伴 Applied Energistics 的 AlgorithmX2 所提供的这项技术，创造出令人惊叹的成果。"
			]
			dependencies: ["2A0BA655B05B5F2D"]
			id: "1828513DFF41506C"
			tasks: [{
				id: "22697D3B1DCA9046"
