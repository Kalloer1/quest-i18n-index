	quests: [
		{
			title: "X-Men 的变种人网络"
			x: -2.0d
			y: 0.0d
			shape: "gear"
			description: [
				"XNet 是一款强大的工具，能用比平时更少的线缆连接方块。它需要一个控制器，可以设置 8 个描述网络行为的频道。"
				""
				"我们提供了一些示例，展示如何使用 XNet 自动化一些可能具有挑战性的流程。"
			]
			dependencies: ["3B00278F3DDF103C"]
