	id: "1B161961AE8D4542"
	order_index: 1
	quest_links: [ ]
	quests: [
		{
			description: [
				"在旅途中，你会发现世界会随着你的实力增长而改变。当你征服地牢、击败强敌、收集强力装备时，这个世界也会变得愈发危险。"
				""
				"怪物将开始显现强大的&d能力&f，从普通特性到高级甚至传说级力量。有些会反射你的攻击，濒死时再生，召唤盟友，或释放出足以压倒经验丰富的冒险者的毁灭性效果。"
				""
				"这些强大的生物被称为冠军。它们比普通怪物危险得多，但也守护着最珍贵的宝藏。"
				""
				"幸运的是，这个世界提供了一种反击的方法。"
				""
				"隐藏在危险的地下城、稀有的战利品和强大冠军手中的，是传说中的&6神器&f，它们是专为克制特定&d能力&f而锻造的远古遗物。每件神器都能削弱或完全抵消某位冠军的力量，让你能将不可能获胜的战斗变为可能。"
			]
			id: "346AD4946346FC35"
			rewards: [{
				id: "4EDD51CD90117D30"
				item: "skilltree:wisdom_scroll"
				type: "item"
			}]
			shape: "spstar"
			size: 6.0d
			subtitle: "无尽战争的遗物 (Artifacts of Endless War)"
			tasks: [{
				id: "7F53A199688A910A"
				title: "点击以完成"
				type: "checkmark"
			}]
			title: "敌意入门教程"
			x: -15.0d
			y: 3.0d
		}
		{
			dependencies: ["7D48F3259606663E"]
			description: [
				"&6敌意球体&f会降低当前区域的区域性敌意，使探索和建造更安全。"
				""
				"与敌意探测器配合使用，以识别危险区域，并在敌意再次上升前将其收复。"
			]
			id: "3983BCA121155B3E"
			rewards: [{
				id: "39055F6661790918"
				item: "cisco_mod:champion_loot_bag"
				type: "item"
			}]
			subtitle: "仇恨避难所"
			tasks: [{
				id: "03744516EF886383"
				item: "l2hostility:hostility_orb"
				type: "item"
			}]
			x: 2.0d
			y: 4.0d
		}
		{
			dependencies: ["346AD4946346FC35"]
			description: [
				"&4敌意探测器&f是你最宝贵的生存工具。手持时，它会显示你的个人敌意和周围区域的区域性敌意。"
				""
				"个人敌意反映了你在世界中的成长。随着你变强并征服更大的挑战，越来越危险的敌人将开始出现。"
				""
				"区域敌意衡量了当前区域的危险程度。敌意高的区域会生成更强、能力更致命的冠军，但也提供更好的战利品、更稀有的遗物以及更高的奖励。"
				""
				"踏入未知领域前，务必检查你的敌意探测器。了解前方的危险，往往是生与死的分界线。"
			]
			id: "5A2FA9E3C013A435"
			rewards: [{
				id: "47240470B6321CEF"
				item: "cisco_mod:champion_loot_bag"
				type: "item"
			}]
			subtitle: "正在侦测危险"
			tasks: [{
