			}]
			x: 14.75d
			y: -9.25d
		}
		{
			dependencies: ["717E50BAEB4A819B"]
			description: ["召唤三个盟友Vex，攻击附近的敌对生物。这些Vex会持续很短时间，直到受到伤害，但可通过“延长持续时间”增强效果来延长。"]
			id: "783252E10419781A"
