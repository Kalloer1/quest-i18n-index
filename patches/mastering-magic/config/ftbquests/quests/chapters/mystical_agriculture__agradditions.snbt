		{
			dependencies: ["0724A71A4DD53FA2"]
			description: ["将兼容的工具或护甲放入GUI中央槽位。右侧会解锁1个或多个槽位，可放置适用的增强。将工具移出中央槽位，增强即生效。可随时将工具或护甲放回中央槽位并移除增强来取消。"]
			id: "44ECE36AF2079D27"
			rewards: [{
				id: "3286577F044DDF18"
				type: "xp"
				xp: 15
			}]
			shape: "gear"
			size: 1.5d
			subtitle: "Tinkering Table 是一种用于为 Essence Tools 和 Essence Armor 添加 Augments 的方块。"
			tasks: [{
				id: "53ECAA3CF535AFA8"
				item: "mysticalagriculture:tinkering_table"
				type: "item"
