		}
		{
			dependencies: ["3B1719AF526CD517"]
			description: ["要附魔物品，将其放入第3个槽位。然后，将足够的所需物品放入第1或第2个槽位。每个附魔等级都需要额外的物品。"]
			id: "648816A8EDF51B8F"
			rewards: [{
				id: "279E5EE0244D7EAA"
				item: "mysticalagriculture:soulium_ingot"
				type: "item"
			}]
			subtitle: "附魔师是一种可以使用物品和精华对书籍、工具或盔甲施加附魔的方块。"
			tasks: [{
				id: "0608DD3A59E467F6"
