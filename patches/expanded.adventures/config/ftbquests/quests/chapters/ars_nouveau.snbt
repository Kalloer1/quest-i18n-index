					id: "40B2F87046B8595B"
					item: "numismatics:spur"
					type: "item"
				}
				{
					count: 5
					id: "4FF6C635CC2DFB52"
					item: "ars_nouveau:source_gem"
					type: "item"
				}
			]
			tasks: [{
