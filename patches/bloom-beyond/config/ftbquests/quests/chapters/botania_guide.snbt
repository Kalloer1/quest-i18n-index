			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["5000000000000004"]
			description: [
				"**Marguerite Pure** 是创造基础资源最重要的花朵。"
				""
				"Posez-la sur le sol, puis placez des blocs de **Pierre** ou de **Bûches** autour d'elle."
				""
				"Attendez environ une minute, et ils se transformeront en **Rochevivante** et **Boisvivant**."
			]
			id: "5000000000000007"
			rewards: [{
