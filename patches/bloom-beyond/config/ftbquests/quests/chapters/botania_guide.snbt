		}
		{
			dependencies: ["5000000000000001"]
			description: [
				"L'**Apothicaire de Pétales** est votre station de fabrication principale pour les fleurs."
				""
				"1. Remplissez-le d'eau (seau ou clic droit avec de l'eau)."
				"2. Jetez-y les pétales requis (touche A par défaut)."
				"3. 投入一颗种子以完成合成。"
			]
			id: "5000000000000004"
			rewards: [{
				count: 3
