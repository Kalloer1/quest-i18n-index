		""
		"该多区块结构可扩展至 &e7x7x7&f，且所有运算仅使用 &e单通道&f 完成。"
		""
		"{image:questgui:textures/quests/descriptions/quantumcomputer.png width:100 height:100 align:center}"
	]
	quest.47CA4A725E520A1D.title: "&dQuantum Computer"
	quest.47DAAA307A2F53A2.quest_desc: [
