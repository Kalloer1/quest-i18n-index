	quest.5CD560988CC92922.title: "&b16k 存储组件"
	quest.5D1DF6F357A03ABA.quest_desc: ["用&e臭鸡蛋&f可以制作&e欢乐泥土&f，它会生成&e一大堆&f&e友好生物&f。"]
