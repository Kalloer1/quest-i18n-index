	quest.264F293D98EAD25C.quest_desc: ["无需&e破坏&f即可制作&e扩展导入/导出总线&f。"]
	quest.2653C47584DA2125.quest_desc: [
		"裂变反应堆是一种&e多方块结构&f，它能&f产生巨量的&c热量&f，但自身不发电。"
