	quests: [
		{
			description: ["Чтобы стать магом, сначала нужно найти свиток магии. Его можно найти в любом сундуке данжа. Вы можете использовать его, и он исчезнет, или поместить его в книгу, после чего он останется там и не будет расходоваться."]
			id: "381CD0F639C6DDC1"
			rewards: [{
				id: "06A32F84FC02601E"
				type: "xp_levels"
				xp_levels: 1
			}]
			tasks: [{
				id: "71B7F4F2AA9BF762"
				title: "Мага пути начало"
				type: "checkmark"
			}]
			x: -7.5d
			y: 0.5d
		}
		{
			dependencies: ["4BC3A011FE67F4B3"]
			description: ["С помощью этого стола свитки вкладываются в книгу, просто положите книгу и свиток, некоторые книги несовместимы с некоторыми заклинаниями"]
			id: "73123F875C687FBE"
			rewards: [{
