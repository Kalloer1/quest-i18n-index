	order_index: 2
	quest_links: [ ]
	quests: [
		{
			dependencies: ["531382B4F26EB4AA"]
			description: [
				"工业教会了你如何塑形金属和组装机器。然而，许多未来的技术无法仅靠冶金学实现。它们的基础在于化学——一门理解、操控和改变物质本身的科学。"
				""
				"从现在开始，气体、反应和分子工程将成为你科技之旅中不可或缺的工具。"
			]
			id: "464A0D13C315D3EC"
			rewards: [{
				exclude_from_claim_all: true
				id: "7BF79173D14FA3D4"
				table_id: 2719991755198765669L
				type: "random"
			}]
			subtitle: "做好准备迎接挑战吧！！！！"
			tasks: [{
				id: "37A0AE418D7C5564"
				title: "一门新的科学"
				type: "checkmark"
			}]
			x: -7.15d
			y: -1.6500000000000001d
		}
		{
			dependencies: ["464A0D13C315D3EC"]
			dependency_requirement: "all_started"
			description: [
				"每种高级材料都始于一个精心控制的化学过程。提纯、合成、结晶和聚合能让普通物质变为非凡组件。"
				""
				"掌握化学将解锁新材料，为先进电子、智能系统、反应堆技术以及超越传统工业的发现铺平道路。"
			]
			id: "01BEFD9C19479DAB"
			subtitle: "物理学家？！"
			tasks: [{
				id: "57120B87E9712C9F"
				title: "物质重塑（Matter Reimagined）"
				type: "checkmark"
			}]
			x: -4.4d
			y: -1.6500000000000001d
		}
		{
			dependencies: ["01BEFD9C19479DAB"]
			description: ["每种化学过程都依赖可靠的网络来&l生产&r、&l运输&r和&l储存气体与液体&r。建立支持所有未来&l反应&r的基础设施。"]
