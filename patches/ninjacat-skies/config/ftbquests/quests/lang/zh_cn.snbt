	quest.4200000000200500.quest_desc: [
		"将水分解成其两种组成气体。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.4200000000200500.title: "电解分离机"
	quest.4200000000200501.quest_desc: [
		"将两种化学物质结合成一种新物质。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.4200000000200501.title: "化学注入器"
	quest.4200000000200502.quest_desc: [
		"净化流体或矿石。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.4200000000200502.title: "净化仪式"
	quest.4200000000200503.quest_desc: [
		"向矿石中注入化学物质以提高产量。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.4200000000200503.title: "化学注射器"
	quest.4200000000200504.quest_desc: [
		"将锇压缩到物品上以制作更坚固的装备。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.4200000000200504.title: "锇压缩机 (QIO)"
	quest.4200000000200505.quest_desc: [
		"将多个组件组合成一个完整的部件。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.4200000000200505.title: "组合器"
	quest.4200000000210506.quest_desc: [
		"僵尸会掉落它，不管你喜不喜欢。",
		"九族为下一窝猫留下了补给。使用管家宝箱可随机开启补给，或用四个小宝箱合成一个中宝箱，或用三个中宝箱合成一个大宝箱。大宝箱能装下更多卷轴和更丰富的补给种类，单独开启则能获得更基础的补给。里面没有机器或进度代币，但每个宝箱都有极小概率开出线团碎片，极小概率开出完整的回归之线，大宝箱的几率更高。",
		"方法：在夜间于平台上，或在黑暗洞穴中击杀僵尸。"
	]
	quest.4200000000210506.title: "腐肉库存 (Rotten Flesh Stock)"
	quest.4200000000210507.quest_desc: [
		"骷髅会留下这些，之后可以磨成面粉。",
		"方法：夜晚的骷髅，或/clowder hub的守巢者（8个需要16个线）。"
	]
	quest.4200000000210507.title: "骨头库存"
	quest.4200000000210508.quest_desc: [
		"苦力怕会支付这笔费用，有时还会爆炸。",
		"方法：用筛子过滤尘土或灵魂沙，或在夜间用苦力怕在平台上繁殖。收集到一些后，保持边缘照明。"
	]
	quest.4200000000210508.title: "火药枪托 (Gunpowder Stock)"
	quest.4200000000210509.quest_desc: [
		"蜘蛛会掉落它，而筛子永远不会掉落。",
		"方法：拆解毛边线 (1 → 3)。蜘蛛。在回响之缚处用织布机梳理。毛线反向沉入。"
	]
	quest.4200000000210509.title: "字符串库存"
	quest.420000000021050A.quest_desc: [
		"酿造毒药并提供一些奇特的配方。",
		"方法：夜间在平台上放置蜘蛛。"
	]
	quest.420000000021050A.title: "蜘蛛之眼库存"
	quest.420000000021050B.quest_desc: [
		"末影人会掉落这些；建个农场比向虚空乞讨要好得多。",
		"方法：末影人，或/clowder hub 边缘行者的小摊。"
	]
	quest.420000000021050B.title: "末影珍珠农场"
	quest.420000000021050C.quest_desc: [
		"可用于酿造台和烈焰燃烧器的燃料。",
		"方法：爪黑曜石后的下界堡垒。酿造需要一根杖；Ars和Occultism不等待它。"
	]
	quest.420000000021050C.title: "烈焰棒农场"
	quest.420000000021050D.quest_desc: [
		"稀有掉落，再生药水的关键物品。",
		"方法：下界恶魂会追逐爪状黑曜石。"
	]
	quest.420000000021050D.title: "恶魂泪农场"
	quest.420000000021050E.quest_desc: [
		"酿造出火焰抗性，并提供一些合成材料。",
		"方法：将史莱姆球投入熔岩桶，史莱姆加烈焰粉，或岩浆块。"
	]
	quest.420000000021050E.title: "岩浆膏农场"
	quest.420000000021050F.quest_desc: [
		"足够黏稠，适用于活塞、史莱姆块和拴绳。",
		"方法：泥土 x2 + 小麦种子 + 骨粉（垫料堆肥），或 /clowder hub 垫料管理员。"
	]
	quest.420000000021050F.title: "史莱姆球农场"
	quest.4200000000210510.quest_desc: [
		"其中三个会召唤出一个值得挑战的 boss。",
		"方法：下界堡垒获取爪黑曜石。三个头颅可合成凋零。"
	]
	quest.4200000000210510.title: "凋零骷髅头"
	quest.4200000000210511.quest_desc: [
		"凋零自身的税，稀有而沉重，充满力量。",
		"方法：凋零（灵魂沙上放三个头颅），或在/clowder hub的鼓心摊位用12个线钉（972根线）兑换。奖杯可选，不影响末地或刷怪塔100%的获取。"
	]
	quest.4200000000210511.title: "下界之星"
	quest.4200000000210512.quest_desc: [
		"制作一个潜影盒，一种在死亡后也能保留的储物容器。",
		"可选 — 这里没有潜贝，所以整合包会制作贝壳来代替。",
		"方法：配方，六个紫晶块，两个末影珍珠和一个绑定之结。潜行兽不会在此生成。可选。"
	]
	quest.4200000000210512.title: "潜贝壳农场"
	quest.4200000000210513.quest_desc: [
		"当其他方法无效时，修复鞘翅。",
		"方法：连续三晚不睡觉，然后击杀幻影。可选。"
	]
	quest.4200000000210513.title: "幻影膜 (Phantom Membrane)"
	quest.4200000000210514.quest_desc: [
		"鱿鱼墨，可用于染色和老式书写。",
		"方法：木炭加玻璃瓶。鱿鱼永远不会在这里生成。"
	]
	quest.4200000000210514.title: "墨囊农场"
	quest.4200000000210515.quest_desc: [
		"让告示牌和物品展示框在黑暗中发光。",
		"方法：发光鱿鱼永远不会在平台上生成。可选。"
	]
	quest.4200000000210515.title: "发光墨水"
	quest.4200000000210516.quest_desc: [
		"守卫会掉落它来换取海晶灯和灯笼。",
		"方法：海洋纪念碑已消失。除非你种植海晶灯种子，否则可选。"
	]
	quest.4200000000210516.title: "海晶碎片"
	quest.4200000000210517.quest_desc: [
		"守护者的掉落物，能点亮大海，也能用于一些合成。",
		"方法：海洋纪念碑消失了。可选任务。"
	]
	quest.4200000000210517.title: "海晶灯晶体"
	quest.4200000000210518.quest_desc: [
		"敲响一个导管；收集八个以完成框架。",
		"可选的——虚空可能永远不会提供一个。",
		"方法：仅限海洋。可选任务。"
	]
	quest.4200000000210518.title: "鹦鹉螺壳（狩猎）"
	quest.4200000000210519.quest_desc: [
		"死亡会作弊一次，然后就消失了。",
		"方法：仅限任务奖励。Seat Clock和Seat Sigil各给一个，晚期Strand Knot礼物会提供更多。劫掠和唤魔者绝不会来此。可选。"
	]
	quest.4200000000210519.title: "图腾（狩猎）"
	quest.420000000021051A.quest_desc: [
		"石像在守卫时会掉落铁块。",
		"方法：熔炼生铁/铁砂（熔炉或余烬熔炉）。筛取砾石以获取铁块。"
	]
	quest.420000000021051A.title: "铁傀儡的礼物"
	quest.420000000021051B.quest_desc: [
		"会投掷雪球；是实用的弹药，但战斗力不强。",
		"方法：一个冰（套件/冰生成器）无配方合成四个雪球。"
	]
	quest.420000000021051B.title: "雪傀儡"
	quest.420000000021051C.quest_desc: [
		"骷髅会不断为弹药箱补充弹药。",
		"方法：燧石、木棍、羽毛。骷髅会掉落额外的物品。"
	]
	quest.420000000021051C.title: "箭矢农场"
	quest.420000000021051D.quest_desc: [
		"标记任何被击中的物体，使其暂时发光。",
		"方法：在箭的周围放置萤石粉。"
	]
	quest.420000000021051D.title: "光谱箭矢"
	quest.420000000021051E.quest_desc: [
		"找到鞍具后骑上它即可。",
		"可选 — Clowder Hall 的 Pad-keepers 会出售一个。",
		"方法：在 Clowder Hall (/clowder hub) 的商店里，用钻石块和 Pad-keepers 交易。Chocobo Saddle 是另一个物品。"
	]
	quest.420000000021051E.title: "马鞍 (狩猎用)"
	quest.420000000021051F.quest_desc: [
		"命名一个生物，使其永不消失。",
		"可选 — 克劳德大厅的印章雕刻者会出售一个。",
		"方法：钓鱼/稀有宝箱，或去/clowder hub的Seal-carvers' stall（24根线）。可选。"
	]
	quest.420000000021051F.title: "命名牌农场"
	quest.4200000000210520.quest_desc: [
		"拴上一根链接或电缆。",
		"方法：用四根线绑住一个史莱姆球。史莱姆是堆肥垫（泥土、种子、骨粉）。"
	]
	quest.4200000000210520.title: "引导（狩猎）"
	quest.4200000000210521.quest_desc: [
		"鸡下蛋的速度比你收集的速度还快。",
		"方法：在平台上用小麦种子养鸡，或使用 Mob Farm 鸡舍。"
	]
	quest.4200000000210521.title: "鸡蛋库存"
	quest.4200000000210522.quest_desc: [
		"皮革和牛肉高汤。",
		"方法：熔炼或用篝火烤腐肉。用燧石筛网筛泥土。/clowder hub 垫底者以18根线出售两个。"
	]
	quest.4200000000210522.title: "皮革护胸甲"
	quest.4200000000210523.quest_desc: [
		"羊在修剪后会重新长出来。",
		"方法：在长草后剪羊毛，或收集四根线。"
	]
	quest.4200000000210523.title: "羊毛库存"
	quest.4200000000210524.quest_desc: [
		"厨房的食物储备。",
		"方法：在平台上用小麦换取奶牛。"
	]
	quest.4200000000210524.title: "牛肉高汤"
	quest.4200000000210525.quest_desc: [
		"猪可以提供它，食用前请先烹饪。",
		"方法：在平台上用土豆或胡萝卜喂猪。"
	]
	quest.4200000000210525.title: "猪肉高汤"
	quest.4200000000210526.quest_desc: [
		"鸡，用于获取食物和羽毛。",
		"方法：在平台上用种子孵化小鸡。"
	]
	quest.4200000000210526.title: "鸡骨高汤"
	quest.4200000000210527.quest_desc: [
		"羊肉，烤熟总比生的好。",
		"方法：在平台上用小麦换取绵羊。"
	]
	quest.4200000000210527.title: "羊肉库存"
	quest.4200000000210528.quest_desc: [
		"如果能多出来一瓶，就酿造一瓶幸运药水。",
		"可选的——虚空可能永远不会提供一个。",
		"方法：兔子不会在平台上生成。可选。"
	]
	quest.4200000000210528.title: "兔子脚 (Rabbit Foot)"
	quest.4200000000210529.quest_desc: [
		"值得放在龙蛋旁边的展品之一。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000210529.title: "僵尸头颅"
	quest.420000000021052A.quest_desc: [
		"和架子上的龙蛋很搭，相得益彰。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.420000000021052A.title: "骷髅头骨"
	quest.420000000021052B.quest_desc: [
		"鸡蛋旁边奖杯架上的又一个头颅。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.420000000021052B.title: "苦力怕头颅"
	quest.420000000021052C.quest_desc: [
		"还有一个头颅，在靠近龙蛋的家里。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.420000000021052C.title: "猪灵头颅"
	quest.420000000021052D.quest_desc: [
		"最稀有的头颅，只有在战斗结束后才能获得。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.420000000021052D.title: "龙头 (Dragon Head)"
	quest.420000000021052E.quest_desc: [
		"除非有玩家恰好掉落了一个。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.420000000021052E.title: "玩家头颅"
	quest.420000000022052F.quest_desc: [
		"首次合成可获得 2 个——留一个用于 Codex 后续使用。",
		"九族为下一窝猫留下了补给。使用管家宝箱可随机开启补给，或用四个小宝箱合成一个中宝箱，或用三个中宝箱合成一个大宝箱。大宝箱能装下更多卷轴和更丰富的补给种类，单独开启则能获得更基础的补给。里面没有机器或进度代币，但每个宝箱都有极小概率开出线团碎片，极小概率开出完整的回归之线，大宝箱的概率更高。",
		"方法：骨头、线、紫水晶各一个。/clowder hub Pad-keepers 出售骨头。Spark / Hum 门。"
	]
	quest.420000000022052F.title: "骨制风铃"
	quest.4200000000220530.quest_desc: [
		"远古部落之歌的残片 — 需要一个铃铛。",
		"配方：骨铃、紫水晶和红石，无需特定形状。可产出两个。"
	]
	quest.4200000000220530.title: "灵魂碎片"
	quest.4200000000220531.quest_desc: [
		"将金属与精神调和 — 铜环绕着钟摆。",
		"方法：用铜环绕骨铃。可产出两个。"
	]
	quest.4200000000220531.title: "铜制共鸣器"
	quest.4200000000220532.quest_desc: [
		"标记晶格线——粉笔需要一个碎片。",
		"配方：骨粉、青金石和灵魂碎片各两个，无需特定顺序。可产出四个。"
	]
	quest.4200000000220532.title: "仪式用粉笔 (部落风格)"
	quest.4200000000220533.quest_desc: [
		"放置心脏——两个骨铃、一个灵魂碎片、两个皮革和四个木板（守夜人出售皮革）。",
		"配方：两个骨铃、一个灵魂碎片、两个皮革和四个木板。在节奏（17-23刻）中徒手攻击可获得24个脉冲。"
	]
	quest.4200000000220533.title: "鼓心节拍"
	quest.4200000000220534.quest_desc: [
		"九族曾低吟 — 需要一个备用铃铛 + 碎片。",
		"方法：合成或使用火花/部落编织奖励。右键：了解晶格的工作原理。"
	]
	quest.4200000000220534.title: "灵魂法典"
	quest.4200000000220535.quest_desc: [
		"将 ley 线绘制成节拍。",
		"方法：放置于天空下靠近水/绿地的地方。缓慢脉冲。火花阶梯。"
	]
	quest.4200000000220535.title: "莱伊收集器"
	quest.4200000000220536.quest_desc: [
		"携带脉冲，用于工具、法术和旅行。在鼓心处填充。",
		"方法：合成，然后用鼓心（点击单元格）填充。工具、法术和旅行都从单元格中获取。"
	]
	quest.4200000000220536.title: "脉冲电池"
	quest.4200000000220537.quest_desc: [
		"放置一个会随使用而磨损的 Echo 催化剂；在八格内加入两种不同的图腾声音。更多声音能让歌声更响亮。红石会使其暂停。",
		"方法：放置一个回声催化剂，并在8格内放置两种不同的图腾。红石会使其暂停。"
	]
	quest.4200000000220537.title: "脉冲共振器"
	quest.4200000000220538.quest_desc: [
		"石之部落的回应。",
		"方法：骨铃、两根原木、泥土和一个铜共振器。"
	]
	quest.4200000000220538.title: "大地图腾"
	quest.4200000000220539.quest_desc: [
		"火焰部落回应了召唤。",
		"配方：骨铃、两根原木、木炭和一个铜共振器。"
	]
	quest.4200000000220539.title: "火焰图腾"
	quest.420000000022053A.quest_desc: [
		"潮之部落回应了召唤。",
		"方法：骨铃、两根原木、一个水桶（或瓷质水桶）和一个铜共振器。"
	]
	quest.420000000022053A.title: "水之图腾"
	quest.420000000022053B.quest_desc: [
		"风之部落回应了召唤。",
		"配方：骨铃、两根原木、一根羽毛和一个铜共振器。"
	]
	quest.420000000022053B.title: "空气图腾"
	quest.420000000022053C.quest_desc: [
		"第五部落 — 管家核心。",
		"方法：骨铃、两根原木、一块灵魂碎片和一个铜共振器。"
	]
	quest.420000000022053C.title: "灵魂图腾"
	quest.420000000022053D.quest_desc: [
		"开始晶格之歌。它等待石头或回响阶段的物品；原金属在回响碎裂中是杂质。",
		"方法：灵魂法典 + 部落编织。座石或回响阶段的物品。原金属属于回响碎裂。"
	]
	quest.420000000022053D.title: "歌曲工作台"
	quest.420000000022053E.quest_desc: [
		"在图腾之间建立谐波路线。",
		"方法：红石周围放置四个铜共振器。可制作四个。"
	]
	quest.420000000022053E.title: "晶格导体"
	quest.420000000022053F.quest_desc: [
		"第一阶段——破碎矿石。石头变碎片，圆石变砾石，原矿变砂砾。砂砾破碎速度为40 Pulse/s，持续4秒。",
		"方法：石头 + 骨铃 + 铜共振器。8格内的土图腾。石头→碎片；鹅卵石→砾石；原矿→砂砾。40次/秒，持续四秒。"
	]
	quest.420000000022053F.title: "回声破碎"
	quest.4200000000220540.quest_desc: [
		"听见碎裂声的碎片。",
		"方法：回声碎石（非鹅卵石）。字体石层级，或丝绸之触石。"
	]
	quest.4200000000220540.title: "回声碎片 (部落风格)"
	quest.4200000000220541.quest_desc: [
		"嗯，第二阶段——调谐。",
		"方法：七块石头、一个灵魂碎片和一个铜共振器。"
	]
	quest.4200000000220541.title: "回声调谐器"
	quest.4200000000220542.quest_desc: [
		"回音找到了一个钥匙。",
		"方法：灵魂法典 + 部落编织。工作站、图腾和脉冲成本见法典页面。"
	]
	quest.4200000000220542.title: "Attuned Echo"
	quest.4200000000220543.quest_desc: [
		"绑定阶段 — 将灵魂与金属结合。",
		"方法：七块石头、一块紫水晶碎片和一个铜共振器。"
	]
	quest.4200000000220543.title: "回声绑定"
	quest.4200000000220544.quest_desc: [
		"回响，绝不会被遗漏。",
		"方法：灵魂法典 + 部落编织。工作站、图腾和脉冲成本见法典页面。"
	]
	quest.4200000000220544.title: "绑定回响"
	quest.4200000000220545.quest_desc: [
		"重织阶段——呼唤锭子。",
		"方法：五个石头、一个金锭、两个铜共振器和一个灵魂碎片。"
	]
	quest.4200000000220545.title: "回声宣言"
	quest.4200000000220546.quest_desc: [
		"金属在Spirit Pulse的意志下诞生，而非熔炉锻造。",
		"方法：灵魂法典 + 部落编织。工作站、图腾和脉冲成本见法典页面。"
	]
	quest.4200000000220546.title: "具象化锭 (Manifested Ingot)"
	quest.4200000000220547.quest_desc: [
		"保留部落们留下的东西。",
		"方法：七块木板、一个箱子和一个骨铃。"
	]
	quest.4200000000220547.title: "祖先的宝藏"
	quest.4200000000220548.quest_desc: [
		"地窖已朝向 The March 方向链接。",
		"方法：一个祖先宝库、四个铁锭、一个灵魂碎片、两个铜谐振器和一个脉冲单元。"
	]
	quest.4200000000220548.title: "深层缓存"
	quest.4200000000220549.quest_desc: [
		"一枚未书写的封印，等待仪式来填满它。",
		"配方：七张纸、一个灵魂碎片和一个骨铃。可制作两个。"
	]
	quest.4200000000220549.title: "空白印章"
	quest.420000000022054A.quest_desc: [
		"石部落的印章。",
		"方法：空白印章和泥土，无需特定形状。"
	]
	quest.420000000022054A.title: "大地封印"
	quest.420000000022054B.quest_desc: [
		"火焰部落的印章。",
		"方法：空白印章和木炭，无需特定配方。"
	]
	quest.420000000022054B.title: "火焰封印"
	quest.420000000022054C.quest_desc: [
		"潮汐部落的印章。",
		"方法：空白印章和水桶（或瓷质水桶），无需特定顺序。"
	]
	quest.420000000022054C.title: "水之封印"
	quest.420000000022054D.quest_desc: [
		"风之部落的印章。",
		"配方：空白印章和羽毛，无需特定顺序。"
	]
	quest.420000000022054D.title: "空气密封装置"
	quest.420000000022054E.quest_desc: [
		"管家部落的印章。",
		"方法：空白印章和灵魂碎片，无需特定配方。"
	]
	quest.420000000022054E.title: "灵魂封印"
	quest.420000000022054F.quest_desc: [
		"献上封印。询问织布机。",
		"方法：五个石头、一个紫水晶碎片和一个骨铃。"
	]
	quest.420000000022054F.title: "仪式祭坛"
	quest.4200000000220550.quest_desc: [
		"空手使用，演奏门之仪式：在A、S、D、F上敲击下落节拍。成功率为60%即可开启，无需脉冲。",
		"方法：空手使用 Gate Drum 并演奏 Gate Rite：在 A、S、D、F 上敲击下落节拍。成功率为 60% 即可开启；无需 Pulse。请先绑定一个返回指南针。"
	]
	quest.4200000000220550.title: "部落之门鼓 (Tribal)"
	quest.4200000000220551.quest_desc: [
		"用雕刻的灵柩装饰营地入口。指南针和门鼓可助你远行。",
		"方法：四个铁锭、两个灵魂碎片、两个铜谐振器和一个紫水晶碎片。"
	]
	quest.4200000000220551.title: "灵魂之门"
	quest.4200000000220552.quest_desc: [
		"消耗脉冲的工具。",
		"配方：三个 Manifested Ingot、一个 Bone Chime 和一根木棍。"
	]
	quest.4200000000220552.title: "Spiritgear 镐"
	quest.4200000000220553.quest_desc: [
		"消耗脉冲的边缘。",
		"配方：两个 Manifested Ingot、一个 Bone Chime 和一根木棍。"
	]
	quest.4200000000220553.title: "灵装之刃"
	quest.4200000000220554.quest_desc: [
		"来自三月的石头，出现在本不该存在的地方脚下。",
		"方法：熔炼三月鹅卵石。在三月通过鼓门挖掘。"
	]
	quest.4200000000220554.title: "三月石（部落风格）"
	quest.4200000000220555.quest_desc: [
		"三月的残骸，普通却十分丰富。",
		"方法：在三月，通过鼓门开采三月石。"
	]
	quest.4200000000220555.title: "三月的鹅卵石"
	quest.4200000000220556.quest_desc: [
		"在阳光无法照射到的地方生长的木材。",
		"方法：通过鼓门砍伐三月的树木。"
	]
	quest.4200000000220556.title: "三月日志"
	quest.4200000000220557.quest_desc: [
		"三月里砍来的木材，尽管来历不明，却很结实。",
		"方法：一个三月日志可以制作成四个木板。"
	]
	quest.4200000000220557.title: "三月木板"
	quest.4200000000220558.quest_desc: [
		"即使没有风，树叶也会沙沙作响。",
		"方法：用门鼓穿过树木。用剪刀或丝绸之触保留树叶。"
	]
	quest.4200000000220558.title: "三月的叶子"
	quest.4200000000220559.quest_desc: [
		"一根残留着灵魂脉动的芦苇，正嗡嗡作响。",
		"获取方式：三月期间野外生长，芦苇陷阱箱中可找到，Rootbinder Elder 也会出售。"
	]
	quest.4200000000220559.title: "灵魂芦苇 (部落风格)"
	quest.420000000022055A.quest_desc: [
		"将生铁喂给地球图腾旁的回声碎裂。会产出两种砂砾，可熔炼或爆破成锭。其他模组可提供带标签的原始金属。",
		"方法：灵魂法典 + 部落编织。工作站、图腾和脉冲成本见法典页面。"
	]
	quest.420000000022055A.title: "矿石会记住两次发生的事情"
	quest.420000000022055B.quest_desc: [
		"水将羊毛编织成灵织布。从上方或侧面向工作站进料，并从下方取出成品。",
		"方法：灵魂法典 + 部落编织。工作站、图腾和脉冲成本见法典页面。"
	]
	quest.420000000022055B.title: "会说话的面料"
	quest.420000000022055C.quest_desc: [
		"在Spirit下再次凝聚出凝聚锭。共振核心会开启更强大的装备和遥远的道路。",
		"方法：灵魂法典 + 部落编织。工作站、图腾和脉冲成本见法典页面。"
	]
	quest.420000000022055C.title: "跳动的心脏"
	quest.420000000022055D.quest_desc: [
		"将4800个脉冲装入一个大单元，或19200个装入一个大单元。出发前，在鼓心或共振器上为其充能。",
		"方法：一个脉冲单元、两个共振核心和两个具象化锭。"
	]
	quest.420000000022055D.title: "一首更长的歌"
	quest.420000000022055E.quest_desc: [
		"一个水槽可容纳十六个桶。桶和流体管道均可使用。比较器可读取满度；红石可锁定填充和排水。破坏后，流体将留在掉落方块上。Sky Stone Tanks可倾倒。",
		"方法：合成、用桶或管道填充、拾起——流体保留。AE2 Sky Stone Tanks 被破坏时会清空。"
	]
	quest.420000000022055E.title: "铜中锁住的雨水"
	quest.420000000022055F.quest_desc: [
		"用调谐器标记机器面，然后用在继电器板上。用在另一台机器上以替换标记。不要标记板子。",
		"方法：一个灵魂碎片放在两个铜谐振器上。"
	]
	quest.420000000022055F.title: "将远端命名为 far end"
	quest.4200000000220560.quest_desc: [
		"将板片安装在箱子或机器正面。用相同的唯一绑定物品配对两个板片，或通过调谐器绑定目的地。本地货物可送达32格，每秒16个物品，持续8个脉冲。红石可暂停。自5.0起，板片需要在八格内有一个保留的空气共振图腾，否则它将处于空闲状态并提示缺少哪种声音。",
		"方法：漏斗、铜共振器、两种仪式粉和一块具象化锭。"
	]
	quest.4200000000220560.title: "一条用于补给品的路径"
	quest.4200000000220561.quest_desc: [
		"将板片安装到储罐上。配对两个板片或绑定一个目的地。本地流体达到32格：每秒250 mB，持续8次脉冲。两端都必须已加载。自5.0起，板片需要在八格内有一个保留的空气共振图腾，否则它将处于空闲状态并提示缺少哪种声音。",
		"方法：一个 Spirit Cistern、一个 Copper Resonator、两个 Ritual Chalk 和一个 Manifested Ingot。"
	]
	quest.4200000000220561.title: "一条通往雨水的路径"
	quest.4200000000220562.quest_desc: [
		"Longreach 每次成功跳动可携带物品最多 128 格，消耗 16 次脉冲。使用任何兼容模组的常规物品栏。自 5.0 起，该装置需要在八格内放置一个保留的空气共鸣图腾，否则它将处于闲置状态并提示缺少哪种声音。",
		"方法：一个物品中继器、两个共振核心和两个末影珍珠。"
	]
	quest.4200000000220562.title: "遍布整个工坊的各个角落"
	quest.4200000000220563.quest_desc: [
		"Longreach 每次脉冲可传输流体长达 128 格。接收器满时将安全暂停；红石可锁定接收池。自 5.0 起，该板需要八格内有一个保留的空气共振图腾，否则将闲置并提示缺少哪种声音。",
		"方法：一个流体中继器、两个共振核心和两个末影珍珠。"
	]
	quest.4200000000220563.title: "穿过整个水利工程系统"
	quest.4200000000220564.quest_desc: [
		"将部落能量接入Mekanism、Powah或AE2的能源接收器。每次脉冲等于100FE。未升级的转换速率为每秒60脉冲（6,000FE/s）；在回响站升级适配器，空手状态会显示实时速率。它仍然无法接收FE。红石会停止转换和导出。",
		"配方：五个铜锭、三个红石和一个共振核心。"
	]
	quest.4200000000220564.title: "节奏变得流行起来"
	quest.4200000000220565.quest_desc: [
		"六重法杖。潜行使用可循环土、火、水、风、灵和织机。使用可施放；织机语音为“牵引”，将目标拉向你八格，潜行施放无目标则为“缝合”，可瞬移六格。携带充能单元；灵之典籍会解释每个法术及其消耗。",
		"方法：一个 Spirit Seal、一个 Resonant Core、一个 Manifested Ingot 和两根原木。"
	]
	quest.4200000000220565.title: "一只手中的六种声音"
	quest.4200000000220566.quest_desc: [
		"主手潜行使用石质面孔：每块8次脉冲，精确切割3x3区域。常规挖掘保护和工具要求依然适用。",
		"方法：两个 Manifested Ingot、一个 Resonant Core 和两个 Copper Resonator。"
	]
	quest.4200000000220566.title: "石头会生成一个入口"
	quest.4200000000220567.quest_desc: [
		"兜帽提供夜视，充能电池维持。未绑定的部件每四秒消耗2点脉冲；绑定的声音消耗3点。",
		"方法：五个 Spiritweave，呈头盔状。之后装上 Ley Lens 就能看见 ley 线。"
	]
	quest.4200000000220567.title: "寂静中的注视者"
	quest.4200000000220568.quest_desc: [
		"这件长袍能赋予抗性。穿上它去工作，保持你的细胞充满电。",
		"方法：七个 Spiritweave 和一个 Resonant Core。"
	]
	quest.4200000000220568.title: "一个编织而成的庇护所"
	quest.4200000000220569.quest_desc: [
		"编织护腿能提升速度。它们的脉冲消耗与其他部件分开计算。",
		"方法：六个 Spiritweave 和一个 Resonant Core。"
	]
	quest.4200000000220569.title: "营地保持同步前进的步伐"
	quest.420000000022056A.quest_desc: [
		"靴子可以在下落期间提供缓慢下落效果，脉冲存在时亦然。有返回路径的绑定仍然值得携带。",
		"方法：四个 Spiritweave，呈靴子形状。"
	]
	quest.420000000022056A.title: "更平缓的下落方式"
	quest.420000000022056B.quest_desc: [
		"将可重复使用的封印放置在其对应的图腾旁。一个六格的祝福每两秒消耗8个脉冲。高红石信号会暂停它；空手潜行可回收封印。",
		"方法：两个 Manifested Ingot、两个铜锭、一个 Resonant Core 和三个石头。"
	]
	quest.420000000022056B.title: "一个持久的祝福，会一直伴随着你"
	quest.420000000022056C.quest_desc: [
		"潜行使用实心地板顶部以绑定。在同一个世界内返回128格内可获得20脉冲。为着陆地板供电以锁定到达者。",
		"方法：将指南针放入四个 Manifested Ingot 中。"
	]
	quest.420000000022056C.title: "第一条返回路径"
	quest.420000000022056D.quest_desc: [
		"在同一个维度内，跨越任意距离返回，消耗40脉冲。着陆点上方需有两个空方块。",
		"方法：将一块 Waystone Compass 放入四个 Resonant Core 中。"
	]
	quest.420000000022056D.title: "在地平线的彼端"
	quest.420000000022056E.quest_desc: [
		"在鼓门之外寻找行军水晶。用于人、物品和流体的星界路径都源自同一种后期材料。",
		"方法：在三月洞穴中挖掘水晶，或在三月宝箱中找到。先敲响门鼓。"
	]
	quest.420000000022056E.title: "帷幕之外的一个声音"
	quest.420000000022056F.quest_desc: [
		"最后的罗盘穿越维度，消耗100脉冲。探索前绑定安全返回。旅行在两次使用间有五秒冷却。",
		"方法：一个地平线罗盘、两个灵魂印记和两个三月水晶。"
	]
	quest.420000000022056F.title: "连接两个世界的一条道路"
	quest.4200000000220570.quest_desc: [
		"星界货物无视距离限制，跨维度传送。每次成功消耗32点脉冲。接收器必须已加载，不会隐藏区块加载。自5.0起，该板需要八格内有一个保留的织机共鸣图腾，否则将闲置并提示缺少哪种声音。",
		"方法：一个 Longreach Item Relay、两个 Spirit Seal 和两个 March Crystal。"
	]
	quest.4200000000220570.title: "物资穿越了面纱的阻隔，送达此地"
	quest.4200000000220571.quest_desc: [
		"星界流体遵循与玩家和物品相同的维度层级。保持目标储罐装载。满载或空载世界会暂停且不消耗货物。自5.0起，该板需要八格内有一个保留的织机共鸣图腾，否则它将闲置并提示缺少哪种声音。",
		"方法：一个 Longreach 流体中继器、两个 Spirit Seal 和两个 March Crystal。"
	]
	quest.4200000000220571.title: "雨水穿过薄纱，降临世间"
	quest.4200000000220572.quest_desc: [
		"在道路上打开你个人的54格Deep Cache。这是与你的缓存和背包共享的同一个宝库。March调谐可移除其开启成本。",
		"方法：六个 Spiritweave、两个 Resonant Core 和一个 Deep Cache。"
	]
	quest.4200000000220572.title: "交给你照看的营地"
	quest.4200000000220573.quest_desc: [
		"大门通往一片生机勃勃的土地。有些生物仍传唱着古老的歌谣，另一些则在守护着残篇。避开温顺的，用充能的电池和返程路线直面守护者。",
		"方法：合成或使用火花/部落编织奖励。右键：了解晶格的工作原理。"
	]
	quest.4200000000220573.title: "回归之歌"
	quest.4200000000220574.quest_desc: [
		"一种晨雾食草兽，鹿角中承载着古老的森林之歌。用小麦繁殖；刷取成体可获得晨雾天鹅绒。",
		"在Overworld的森林和沼泽中寻找。将试剂带回水下Echo Bind以获取实用材料。建造明亮的道路；敌对生物需要黑暗。",
		"方法：刷一只成年晨鹿。用小麦繁殖它们。"
	]
	quest.4200000000220574.title: "黎明鹿：一首回归的歌曲"
	quest.4200000000220575.quest_desc: [
		"害羞的黄昏觅食者，尾巴会标记安全路径。用甜浆果繁殖；刷取成体可获得灯笼羽毛。",
		"在Overworld的森林和沼泽中寻找。将试剂带回水下Echo Bind以获取实用材料。建造明亮的道路；敌对生物需要黑暗。",
		"方法：刷一只成年灯笼狐。用甜浆果繁殖它们。"
	]
	quest.4200000000220575.title: "灯笼狐：一首歌的回归"
	quest.4200000000220576.quest_desc: [
		"一位耐心的湿地园丁，拥有活体外壳。用海草繁殖；刷取成体可获得自然脱落的苔背鳞片。",
		"在Overworld的沼泽和三月里寻找。将试剂带回水下Echo Bind以获取实用材料。建造明亮的道路；敌对灵魂需要黑暗。",
		"方法：刷一只成年的苔背。用海草来繁殖它们。"
	]
	quest.4200000000220576.title: "苔背：一首歌回来了"
	quest.4200000000220577.quest_desc: [
		"破损的火焰仪式的残骸。近战会短暂点燃目标；请备好水源。",
		"在Overworld的森林和March中搜寻。将试剂带回Spirit下的Echo Attune以换取实用材料。建造照明路径；敌对灵体需要黑暗。",
		"方法：从 Ashbound 掉落。敌对灵魂需要黑暗。"
	]
	quest.4200000000220577.title: "Ashbound：一首歌的回归"
	quest.4200000000220578.quest_desc: [
		"被断裂的 ley line 扭曲的林地守卫。行动缓慢但坚固；其攻击会短暂地定住旅人。",
		"在Overworld的森林和March中搜寻。将试剂带回Spirit下的Echo Attune以换取实用材料。建造照明路径；敌对灵体需要黑暗。",
		"方法：从 Rootbound 掉落。敌对灵魂需要黑暗。"
	]
	quest.4200000000220578.title: "Rootbound：一首歌回来了"
	quest.4200000000220579.quest_desc: [
		"隐藏在灵草中的沼泽猎人。快速攻击带有短暂的毒液。",
		"在Overworld的沼泽和三月里寻找。将试剂带回Spirit下的Echo Attune以换取实用材料。建造明亮的道路；敌对灵魂需要黑暗。",
		"方法：芦苇追踪者掉落。敌对灵魂需要黑暗。"
	]
	quest.4200000000220579.title: "芦苇追踪者：一首歌的回归"
	quest.420000000022057A.quest_desc: [
		"身穿歌唱石盔甲的晶体场拾荒者。远离它的强力推搡。",
		"在三月中寻找它。将试剂归还给 Spirit 下的 Echo Attune 以换取实用材料。建造明亮的道路；敌对灵体需要黑暗。",
		"方法：从碎片背脊掉落。敌对灵魂需要黑暗。"
	]
	quest.420000000022057A.title: "碎片背：一首歌的回归"
	quest.420000000022057B.quest_desc: [
		"一个空无一人的守夜人，仍在守护着古老的道路。它的触碰会削弱攻击者的力量。",
		"在三月中寻找它。将试剂归还给 Spirit 下的 Echo Attune 以换取实用材料。建造明亮的道路；敌对灵体需要黑暗。",
		"方法：来自 Hollow Sentinel 的掉落。敌对灵魂需要黑暗。"
	]
	quest.420000000022057B.title: "Hollow Sentinel: 一首歌的回归"
	quest.420000000022057C.quest_desc: [
		"风暴孕育的灵体，拥有巨大的面纱之翼。飞舞的尘埃预示着它的狂风；遮蔽物可抵御攻击。",
		"在三月中寻找它。将试剂带回水下回响之缚以换取实用材料。建造明亮的道路；敌对灵魂需要黑暗。",
		"方法：风暴飞蛾掉落。敌对灵魂需要黑暗。"
	]
	quest.420000000022057C.title: "风暴之蛾：一曲归来"
	quest.420000000022057D.quest_desc: [
		"敏捷的火花之灵。它在燃烧箭矢前聚集火花；该法术从不点燃地形。",
		"在三月中寻找它。将试剂归还给 Spirit 下的 Echo Attune 以换取实用材料。建造明亮的道路；敌对灵体需要黑暗。",
		"方法：由灰烬小恶魔掉落。敌对灵魂需要黑暗。"
	]
	quest.420000000022057D.title: "Cinder Imp：一首歌回来了"
	quest.420000000022057E.quest_desc: [
		"漂浮的遗迹，铭记着失落的部落。电报般的钟声渐缓，庇护所打断了歌声。",
		"在三月中寻找它。将试剂归还给 Spirit 下的 Echo Attune 以换取实用材料。建造明亮的道路；敌对灵体需要黑暗。",
		"方法：从丧钟中掉落。敌对灵魂需要黑暗。"
	]
	quest.420000000022057E.title: "晨钟：一首回归的歌曲"
	quest.420000000022057F.quest_desc: [
		"被泪水吸引至晶格中的猎人。它能迅速拉近距离，却无法自行穿越世界。",
		"在三月中寻找它。将试剂归还给 Spirit 下的 Echo Attune 以换取实用材料。建造明亮的道路；敌对灵体需要黑暗。",
		"方法：裂谷猎犬掉落。敌对灵魂需要黑暗。"
	]
	quest.420000000022057F.title: "裂谷猎犬：一首歌的回归"
	quest.4200000000220580.quest_desc: [
		"八足守护者，破碎之歌的守者。它的咬伤能减缓猎物，不会结网或损坏营地。",
		"在三月中寻找它。将试剂带回水下回响之缚以换取实用材料。建造明亮的道路；敌对灵魂需要黑暗。",
		"方法：回响编织者掉落。敌对灵魂需要黑暗。"
	]
	quest.4200000000220580.title: "回声编织者：一首歌回来了"
	quest.4200000000220581.quest_desc: [
		"田野笔记已完成。温和的收获与寻回的遗迹，再次化为布匹与回响。夜幕下，营地奏响更丰盈的乐章。",
		"稀有奖励：一次共享的 Clowder 生命，全队共享。整个战役中仅有六个此类奖励。",
		"方法：灵魂法典 + 部落编织。工作站、图腾和脉冲成本见法典页面。"
	]
	quest.4200000000220581.title: "十三个声音，一片天空"
	quest.4200000000220582.quest_desc: [
		"用铜悬挂营地的歌谣。灵魂灯笼无需燃料即可提供完整光照；红石可使其变暗。标记从黑暗中返回的安全路径。",
		"方法：三个铜锭、一个灵魂碎片和一个木板。"
	]
	quest.4200000000220582.title: "为归来者点亮一盏灯"
	quest.4200000000220583.quest_desc: [
		"风铃既是装饰物，也是乐器。晴朗天空时比较器输出0，下雨时为8，雷暴时为15。红石可以使其静音。",
		"方法：三块木板、三个铜锭和一个骨铃。"
	]
	quest.4200000000220583.title: "聆听天气的声音"
	quest.4200000000220584.quest_desc: [
		"雕花桌子可容纳27个物品堆叠。标准物品管道和中继器可共享其内容；比较器可读取满度，红石锁可控制存取。",
		"方法：一个箱子、一个绑定回响、两种木板各两种、两种石头各两种。"
	]
	quest.4200000000220584.title: "壁炉边的一个位置"
	quest.4200000000220585.quest_desc: [
		"将播种机放置在9x9的耕地中，高度与作物齐平。第一行放种子，下面两行放收成。种植消耗4 Pulse，收获和重植消耗12。在八格内提供电源。满负荷输出可保留作物，红石可暂停工作。自5.0起，它需要八格内有一个保留的地球共振图腾，否则它将闲置并提示缺少哪种声音。在它附近放置一个水图腾，它将为耕地的每一垄浇水。",
		"方法：铁锄、泥土印章、绑定回响、两个铜锭和两个木板。"
	]
	quest.4200000000220585.title: "花园里歌声不断回响"
	quest.4200000000220586.quest_desc: [
		"每秒八次脉冲可阻止24格内敌对生物生成。现有生物不受影响。该护盾也阻止敌对生物在摇篮中召唤，请将召唤区设在其外。红石可立即使其失效。自5.0起，它需要8格内有一个保留的Spirit Resonance Totem，否则它将闲置并提示缺少哪种声音。",
		"配方：一个 Spirit Seal、两个 Bound Echoes、一个 Echo Shard 和三个 March Planks。"
	]
	quest.4200000000220586.title: "营地边缘一片寂静"
	quest.4200000000220587.quest_desc: [
		"Wayanchor 每秒保持自身区块活跃 16 次脉冲。在远处的中继接收器处放置一个，以维持其局部电源。一个维度最多可运行 32 个锚。红石或空缓冲器会释放该区块。自 5.0 版本起，它需要八格内有一个保留的 Earth Resonance Totem，否则它将处于空闲状态并提示缺少哪种声音。",
		"方法：两个三月水晶、一个末影之眼、两个具象化锭、一个共振核心和三个三月石。"
	]
	quest.4200000000220587.title: "一个留有记忆的营地"
	quest.4200000000220588.quest_desc: [
		"潜行使用未充能的雕像于受支持的生物上，可获取无害印记。雕像会记住物种。首领无法被束缚；图鉴会说明兼容的灵魂与更新方法。",
		"方法：骨铃、两份灵织、一份共振核心和一份束缚回响。"
	]
	quest.4200000000220588.title: "借来一个鲜活的声音"
	quest.4200000000220589.quest_desc: [
		"将觉醒的雕像放入第一个槽位，灵织放入第二个。每次成功召唤消耗80脉冲、1个灵织和1个绑定线。请在三格内留出安全地板。附近的八个生物会暂停摇篮；红石会暂停所有工作和自动化。自5.0版本起，它需要八格内有一个保留的灵共鸣图腾，否则它将闲置并提示缺少哪种声音。",
		"配方：两个 Manifested Ingot、一个 March Crystal、两个 Bound Echo、一个 Resonant Core 和三个 March Plank。"
	]
	quest.4200000000220589.title: "借来的生命的炉火所在之处"
	quest.420000000022058A.quest_desc: [
		"在仪式火盆中放置一个灵魂印记。将土、风和灵魂图腾置于八格内，并确保背包中有200个脉冲和3个灵魂编织。使用刻印的雕像在火盆上唤醒512个召唤线。全部消耗后，重复此仪式以更新束缚。",
		"方法：仪式火盆中的灵魂印记；8格内的土、风、灵魂图腾；200脉冲；三个灵魂编织；使用刻印的雕像。"
	]
	quest.420000000022058A.title: "三种声音唤醒了这条线"
	quest.420000000022058B.quest_desc: [
		"成功召唤一次。失败或被阻止的尝试不消耗线程或祭品。每个绑定可维持512次成功召唤；打破并更换摇篮不会重置该数值。雕像的提示框会显示剩余使用次数，比较器可读取摇篮剩余的绑定强度。",
		"方法：在摇篮中成功召唤一次。失败不消耗任何物品。"
	]
	quest.420000000022058B.title: "来自摇篮的答案"
	quest.4200000000228001.quest_desc: [
		"大门鼓、行军草原和高地隐藏着下沉的祖先大厅。行走会触发。每座大厅有四块传说石板，全部阅读。宝箱里有织布线、回响、灵织和封印。空洞哨兵仍在守卫。",
		"方法：将鼓带入行军，走进祖先大厅，然后阅读其中的四块传说石碑。"
	]
	quest.4200000000228001.title: "记录着时光的长廊"
	quest.4200000000228002.quest_desc: [
		"织布机线即织布机，手持时：祖先大厅的箱子含2至4根，无名之泪可解开16根以上，织布机缝合者长老在友好状态下会交易1根。它是第六种声音的试剂。",
		"方法：祖先大厅的宝箱、无名者，或友好处的织布长老。"
	]
	quest.4200000000228002.title: "一缕线本身的一根线头"
	quest.4200000000228003.quest_desc: [
		"八个三月石环绕一个回响碎片可制作成两块传说石板。放置后，石板会显示九个部落的残影；在创造模式下潜行使用可循环切换。用它们来装饰你自己的大厅吧。",
		"方法：八个 March Stone 围绕一个 Echo Shard。可制作两个。"
	]
	quest.4200000000228003.title: "把你读到的内容雕刻出来"
	quest.4200000000228004.quest_desc: [
		"在共鸣核心周围铺上皮革和三月木板。三月高地上的鼓圈里已经有一个了；这个留给你在家使用。间隔一个呼吸的时间敲击四次，古老之物便会升起。",
		"方法：三个皮革、五个三月木板和一个共振核心。"
	]
	quest.4200000000228004.title: "一个不会发出声音的鼓"
	quest.4200000000228005.quest_desc: [
		"The Unsung 是三阶段鼓灵。Beat：潜行躲避其冲击波。Chorus：消灭它召唤的 Echo Weavers。Silence：用相同的四拍节奏敲击 Silent Drum 才能伤害它，这会使其眩晕并使你的伤害翻倍。带上充能电池和返回路径。",
		"方法：在寂静鼓上对抗无名者。潜行节拍；四拍制霸寂静。"
	]
	quest.4200000000228005.title: "鼓声回响在记忆中"
	quest.4200000000228006.quest_desc: [
		"每次击杀可获得一个 Unsung Heart，还有 Loom Thread 和 Resonant Core。它只能制作 Loom totem，别无他用，请谨慎使用。",
		"方法：在寂静鼓前，The Unsung 每次击杀会掉落一个。"
	]
	quest.4200000000228006.title: "静止的鼓面 (The stilled drum)"
	quest.4200000000228007.quest_desc: [
		"织布机线团与行军水晶之间的无名之心，置于行军木板上。织布机将土、火、水、空气与精神融为一体：为脉冲共振器与回响解织及 ley 绑定所求的调谐赋予独特之声。",
		"方法：一个 Unsung Heart、四个 March Crystals、两个 Loom Thread 和两个 March Planks。"
	]
	quest.4200000000228007.title: "第六个声音"
	quest.4200000000228008.quest_desc: [
		"空白封印和织布机线。放置在仪式火盆中的织布机封印会祝福张力：每两秒为范围内的所有人携带的细胞补充两点脉冲，并赋予幸运。",
		"方法：空白印章和织布机线，无需特定顺序。"
	]
	quest.4200000000228008.title: "一张充满张力的封印契约"
	quest.4200000000228009.quest_desc: [
		"织布机线、铜谐振器置于三月石上。织布机声下，回响解织将晶格倒转：一个具象锭变为两个束缚回响，束缚回响变为两个调谐回响，调谐回响变为两个碎片，灵魂编织变为两个羊毛，一个共振核心变为三个具象锭，任何磨损的灵魂装备工具变为一个具象锭。",
		"方法：五个 March Stone、一个 Loom Thread、两个 Copper Resonator 和一个 Spirit Shard。"
	]
	quest.4200000000228009.title: "晶格，已反转"
	quest.420000000022800A.quest_desc: [
		"将六重法杖切换到织机模式。牵引术可将目标拉向你八格，持续六次脉冲；无目标的潜行施放为缝合术，可穿越空气瞬移六格，消耗十次。两者都用完后，激活此功能。",
		"方法：在织布机上使用六重法杖。拴住目标，然后潜行缝合。双方都发射后生效。"
	]
	quest.420000000022800A.title: "Tether and Stitch"
	quest.420000000022800B.quest_desc: [
		"九座部落营地矗立在行军路上，每个 Strand 各有一座：小屋、篝火、部落壁炉、图腾、旗帜和四名部落族人。右键壁炉，使用该部落偏好的物品或充能的脉冲电池，即可提升与他们的关系。伤害族人需消耗25，破坏部落旗帜消耗5，壁炉消耗40。通用营地方块不消耗。",
		"方法：右键点击某个部落的图腾，使用该部落的青睐或充能的脉冲电池。"
	]
	quest.420000000022800B.title: "保持温暖"
	quest.420000000022800C.quest_desc: [
		"访客50，朋友150，亲属400，盟友800。在壁炉附近的击杀和完成交易也算在内。长老会按等级提供两种交易：Grit-singers出售Echoes换取原矿，Seal-carvers出售海豹和仪式石板，Loom-stitchers出售Loom Thread和Waystone Compass，亲属等级还可获得Loom Anchor和Loom Seal。`/tribalpower standing`可显示全部九项。",
		"方法：加入部落，与好友 (150) 建立联系。/部落权力声望。"
	]
	quest.420000000022800C.title: "关系良好"
	quest.420000000022800D.quest_desc: [
		"一位长老将一枚部落印记按入你手中。它能打开该部落的族谱页面，是亲属图腾不可或缺的单一材料。",
		"方法：加入部落（800）；长老会授予部落印记。"
	]
	quest.420000000022800D.title: "九人同意"
	quest.420000000022800E.quest_desc: [
		"手持一个部落印记。每个部落的印记都不同，共有九种可能。",
		"方法：加入部落并达到 Voice (800) 等级；部落长老会授予印记。"
	]
	quest.420000000022800E.title: "部落的印记"
	quest.420000000022800F.quest_desc: [
		"部落印记，代表该部落调谐的共鸣图腾和两个灵织。亲属图腾为脉冲共鸣器提供额外独立声线，并将部落调谐赋予站点，使九个部落能将营地之歌传递至十五个声线。",
		"方法：在一个合成网格中放入一个部落印记、该部落的共鸣图腾和两个灵织。"
	]
	quest.420000000022800F.title: "一个并非声音的声音"
	quest.4200000000228010.quest_desc: [
		"营地的鼓手每隔几秒会演奏一次；将一个鼓心放置在鼓手八格内，每次鼓点会为其提供两个脉冲。当鼓手为你的晶格提供能量时，激活此装置。",
		"方法：在营地鼓手8格内放置一个鼓心；当它投喂脉冲时触发。"
	]
	quest.4200000000228010.title: "营地保持着节奏感"
	quest.4200000000228011.quest_desc: [
		"在封印周围放置两个石头和试剂；封印会返还。在土之封印旁放置结节根；600脉冲。二十分钟内，火盆周围九个区块的作物、树苗和茎干生长速度加快。潜行使用该石板，将封印放置在仪式火盆的仪式圈内（四个基座位于对角线，用粉连接）；脉冲会从八格内的晶格中抽取。",
		"配方：两个石头、一个结节根和一个泥土封印，无需特定形状；封印会返还。"
	]
	quest.4200000000228011.title: "仪式石板：绿色祝福"
	quest.4200000000228012.quest_desc: [
		"在封印周围放置两个石头和试剂；封印被交还。芦苇牙放在水封印旁；400脉冲。持续二十分钟的雨，用于蓄水池和作物。在仪式火盆上潜行使用平板电脑，封印需置于其仪式圈内（四个基座位于对角线，用粉笔连接）；脉冲从八格内的晶格中抽取。",
		"配方：两个石头、一个芦苇牙和一个水之印，无需特定形状；封印会返还。"
	]
	quest.4200000000228012.title: "仪式石板：祈雨仪式"
	quest.4200000000228013.quest_desc: [
		"封印周围放两个石头和试剂；封印返还。风暴之翼放在空气封印旁；400脉冲。四十分钟晴空。潜行使用刻有封印的仪式祭坛上的平板电脑，位于其仪式圈内（四个基座在对角线上，用粉笔连接）；脉冲从八格内的晶格中抽取。",
		"配方：两个石头、一个风暴之翼和一个空气密封，无需特定顺序；密封会返还。"
	]
	quest.4200000000228013.title: "仪式石板：天空净化仪式"
	quest.4200000000228014.quest_desc: [
		"在封印周围放置两个石头和试剂；封印被交还。在火焰封印旁放置余烬之心；800脉冲。使整个世界加快到下一个日出。在仪式祭坛上使用该石板，封印位于祭坛的仪式圈内（四个基座位于对角线，用粉笔连接）；脉冲从八格内的晶格中抽取。",
		"配方：两个石头、一个余烬之心和一个火印，无需特定顺序；火印会返还。"
	]
	quest.4200000000228014.title: "仪式石板：黎明召唤"
	quest.4200000000228015.quest_desc: [
		"封印周围的两种石头和试剂；封印被交还。哨兵印记旁的灵魂封印；600脉冲。六十四格内十五分钟无敌怪生成。在仪式火盆上潜行使用刻有该封印的刻表，刻表位于其仪式圈内（四个基座位于对角线，用粉连接）；脉冲从八格内的晶格中抽取。",
		"配方：两个石头、一个哨兵印记和一个灵魂封印，无需特定顺序；封印会返还。"
	]
	quest.4200000000228015.title: "仪式石板：静谧之夜"
	quest.4200000000228016.quest_desc: [
		"在封印周围放置两个石头和试剂；封印会返还。织布机线放在织布机封印旁；1,200 脉冲。将最近的图腾与另一个图腾用一条持续三十分钟的 ley line 连接，在两者之间传输脉冲。潜行使用该石板，将封印放置在仪式火盆的 Rite Circle 内（四个基座位于对角线，用粉笔连接）；脉冲会从八格内的晶格中抽取。",
		"配方：2个石头、1个织布线和1个织布印章，无需特定顺序；印章会返还。"
	]
	quest.4200000000228016.title: "仪式石板： ley 绑定仪式"
	quest.4200000000228017.quest_desc: [
		"执行任意仪式。如果火盆周围的晶格中脉冲过少，则不会消耗任何东西，火盆会显示此信息。",
		"方法：在仪式圈内，使用带有匹配封印和脉动的仪式祭坛，潜行使用任意仪式石板。"
	]
	quest.4200000000228017.title: "第一仪式"
	quest.4200000000228018.quest_desc: [
		"两种灵织、一个灵魂碎片和该物种的试剂。用于成年伙伴。动物：六十%，魅惑失败则保留。残存者希望与部落交流，四十%，魅惑失败则消耗。",
		"方法：两个 Spiritweave、一个 Spirit Shard 和一个熟悉的试剂（如 Dawn Velvet、Lantern Down、Storm Wing 等）。"
	]
	quest.4200000000228018.title: "用于驯服野生生物的护身符"
	quest.4200000000228019.quest_desc: [
		"契约的伙伴会跟随你，能瞬移到你身边，永不消失，无法被你伤害，抚摸时掉落双倍物品。初始伙伴有狐狸、苔背鹿和雄鹿。残骸需要“声音”。最多可跟随一名战士和两名辅助；坐着的伙伴不计在内。",
		"方法：在成年附灵生物上使用绑定护身符。首次绑定即可获得成就。"
	]
	quest.4200000000228019.title: "黑暗中的朋友"
	quest.420000000022801A.quest_desc: [
		"纸张、灵织布和一块灵魂碎片。将特许状用于玩家以邀请他们加入你的营地，或在空中查看。`/tribalpower camp` 用于创建、邀请、加入、离开、踢出、重命名。",
		"配方：纸、灵织布和灵魂碎片，无需特定顺序。"
	]
	quest.420000000022801A.title: "一个汇聚了众多声音的营地"
	quest.420000000022801B.quest_desc: [
		"营地成员共享每个深藏宝库和远行者袋后的五十四格营地宝库，互为设备的所有者，共享十二个远行者锚点，并将部落的四分之一兵力复制到营地。Clowder 并非营地——/tribalpower camp create <name> 才是。",
		"方法：/tribalpower camp create <name> (不是Clowder)。首个营地获得成就。"
	]
	quest.420000000022801B.title: "一个宝库，一个预算"
	quest.420000000022801C.quest_desc: [
		"铜共振器和灵魂碎片上的玻璃板。手持时，透镜会显示你所在位置的 ley 强度，并将其绘制在周围的地面上；潜行使用在 ley 收集器或宠物上，可显示具体数值。",
		"方法：玻璃板、铜共振器和精神碎片按列放置。"
	]
	quest.420000000022801C.title: "看看地脉线在哪里"
	quest.420000000022801D.quest_desc: [
		"石英放在红石上，铜谐振器放在三月石上。朝向任意脉冲保持器，它会以存储值的比例输出0到15的红石信号。",
		"方法：石英、两个红石、一个铜谐振器和三月石。"
	]
	quest.420000000022801D.title: "用于脉冲的针头（A needle for Pulse）"
	quest.420000000022801E.quest_desc: [
		"红石上的红石火把和安山岩上的铜共振器。当朝向的持有物达到或超过阈值时发出脉冲；右键可循环切换25%、50%、75%和100%。脉冲驱动自动化所需的组件。",
		"方法：一个红石火把、两个红石、一个铜共振器和一个三月石。"
	]
	quest.420000000022801E.title: "歌中的一行歌词"
	quest.420000000022801F.quest_desc: [
		"潜行使用 Spirit Codex 在任意 Tribal 方块上以获取基础报告：存储的 Pulse、为其供电的发电机、八格内的调谐、当前配方所缺材料、完整输出、红石暂停、未加载的继电器末端。当报告提供未知信息时勾选此项。",
		"方法：潜行使用 Spirit Codex 作用于 Tribal 方块；当报告指出真实故障时触发。"
	]
	quest.420000000022801F.title: "问问Codex为什么"

	quest.4200000000228020.quest_desc: [
		"向石制喷泉索取鹅卵石。石头并非制成，而是被要求留存。鹅卵石只需形态与脉冲；八格内的泥土图腾可使其索取石头。",
		"方法：五个鹅卵石、一个回声碎片和一个鼓心。"
	]
	quest.4200000000228020.title: "一个石头的来源"
	quest.4200000000228021.quest_desc: [
		"完成任意图案。放置即仪式：零散的设备不算仪式。",
		"方法：放置来自《灵界法典》的仪式图案；完成第一个完整圆圈时，成就即会解锁。"
	]
	quest.4200000000228021.title: "画一个圆形"
	quest.4200000000228022.quest_desc: [
		"向石质喷泉索要第一块鹅卵石。石头并非造出，而是被要求留存。",
		"方法：运行 Stone Font 直到出现 cobble。在第一次停留时获得成就。"
	]
	quest.4200000000228022.title: "石头会保持原样"
	quest.4200000000228023.quest_desc: [
		"在字体工作时，潜行使用灵魂法典。当报告名称存储的脉冲或缺失的图腾时，勾选此项。",
		"方法：潜行使用 Spirit Codex 作用于 Stone Font；当报告指出真实故障或缓冲区已满时触发。"
	]
	quest.4200000000228023.title: "字体给出了答案"
	quest.4200000000228024.quest_desc: [
		"在源头保持一个充能的电池，这样询问就不会停滞。",
		"方法：用鼓心填满脉冲单元，然后在字体被输入时激活此装置。"
	]
	quest.4200000000228024.title: "位于前方的一个单元格"
	quest.4200000000228025.quest_desc: [
		"网格找不到矿石；网格为矿石提供着陆点。将其置于聆听坑上方。",
		"配方：四块三月石、两个调谐回响、两个灵织布和一个铜共振器。"
	]
	quest.4200000000228025.title: "一个会倾听的网格结构"
	quest.4200000000228026.quest_desc: [
		"四块锚石支撑着坑洞的四个角。没有它们，网格将无处立足。",
		"方法：四个 March Stone 和一个 Echo Shard。可制作四个。"
	]
	quest.4200000000228026.title: "四个船锚"
	quest.4200000000228027.quest_desc: [
		"通过聆听坑道将第一批矿石召唤上来。",
		"方法：在锚石围成的坑上放置共振网格；首次挖掘到矿石时，成就即会触发。"
	]
	quest.4200000000228027.title: "问问大地"
	quest.4200000000228028.quest_desc: [
		"坑道里的金砂是继铁之后的下一个目标。",
		"方法：持续询问地面；手持金砂时触发。"
	]
	quest.4200000000228028.title: "来自深坑的黄金"
	quest.4200000000228029.quest_desc: [
		"Pit消耗脉冲。在网格上保留一个单元格，防止询问卡住。",
		"方法：用鼓心填满脉冲单元，然后将其放置在法典所示的位置。"
	]
	quest.4200000000228029.title: "深坑记录着时间"
	quest.420000000022802A.quest_desc: [
		"十一个门框和一枚基石环在前方。缺少一个框，就缺少一步。",
		"配方：六个三月石、两个铜锭和一个回响碎片。可制作四个。"
	]
	quest.420000000022802A.title: "A frame for the way"
	quest.420000000022802B.quest_desc: [
		"基石是第十二块石头。没有它，这枚戒指只是一个图案。",
		"方法：四个门框、一个共振核心、一个灵魂碎片和一个脉冲单元。"
	]
	quest.420000000022802B.title: "基石"
	quest.420000000022802C.quest_desc: [
		"点燃一道传送门。十一个框架，一块基石，和一个目的地。",
		"方法：完成圆环并点燃它；路径打开时，进度会触发。"
	]
	quest.420000000022802C.title: "打开道路"
	quest.420000000022802D.quest_desc: [
		"潜行使用印记在基石上写下它。再使用在另一个基石上，将两者连接起来。",
		"配方：空白印章、织布线和灵魂碎片，无需特定顺序。"
	]
	quest.420000000022802D.title: "输入目的地"
	quest.420000000022802E.quest_desc: [
		"穿越遥远的大门，从一个维度到另一个维度。织机从来都不只是一根线。",
		"方法：用 Gate Sigil 连接两个 keystones，然后走到远端的门。"
	]
	quest.420000000022802E.title: "长长的线头"
	quest.420000000022802F.quest_desc: [
		"火焰的发电机。把它放在图腾附近；手鼓之心无法驱动这声音。",
		"配方：三个铜锭、一个灰烬结、一个火印和两个三月木板。"
	]
	quest.420000000022802F.title: "火焰之声"
	quest.4200000000228030.quest_desc: [
		"风之发电机。把它放在图腾附近，这样六个就能互相听见了。",
		"方法：四个 Spiritweave、一个 Storm Wing、一个 Air Seal 和两个 March Planks。"
	]
	quest.4200000000228030.title: "风的声音"
	quest.4200000000228031.quest_desc: [
		"水之发电机。将其置于图腾旁；蓄水池与泉水将聆听此声。",
		"配方：皮革 x2，三月木板 x3，打结根 x1，水封 x1。"
	]
	quest.4200000000228031.title: "水之低语"
	quest.4200000000228032.quest_desc: [
		"唤醒钟是精神的悠长鸣响。将其与其他五个一同置于图腾旁。",
		"方法：一个钟片、四个铜锭、一个精神印记和一个精神碎片。"
	]
	quest.4200000000228032.title: "大地的苏醒"
	quest.4200000000228033.quest_desc: [
		"第六台织布机。织布机需要织布线；无名者和刺绣长老会保管它。",
		"配方：四个三月水晶、两个织布线、两个灵织布和一个共振核心。"
	]
	quest.4200000000228033.title: "第六个发电机"
	quest.4200000000228034.quest_desc: [
		"石堆将脉冲储存在野外，以便六个声音共享缓冲区。",
		"方法：六个 March Stone、两个 Bound Echoes 和一个 Pulse Cell。"
	]
	quest.4200000000228034.title: "一个脉动石堆的祭坛"
	quest.4200000000228035.quest_desc: [
		"将六个发电机全部放置在彼此32格以内，每个对应一个声音。",
		"方法：在32格内获得 Ember Horn、Wind Harp、Wave Drum、Wake Bell、Loom Anchor 和 Drumheart。完成六声部的进阶。"
	]
	quest.4200000000228035.title: "六个声音在歌唱"
	quest.4200000000228036.quest_desc: [
		"要求蓄水池持续供水。十分钟的水量，即可保持封印。",
		"方法：在仪式圈内，使用带有匹配封印和脉动的仪式火盆，潜行使用平板电脑。"
	]
	quest.4200000000228036.title: "一个源源不断提供资源的泉水"
	quest.4200000000228037.quest_desc: [
		"无人歌颂者仍记得的鼓圈。可选纪念品。",
		"方法：在寂静鼓边的无名者可以掉落。可选。"
	]
	quest.4200000000228037.title: "鼓圈聚会"
	quest.4200000000228038.quest_desc: [
		"第一次仪式后的空白封印，准备好迎接下一个循环。",
		"方法：在火盆处进行首次仪式；当手持备用空白封印时触发。"
	]
	quest.4200000000228038.title: "一个备用印章"
	quest.4200000000228039.quest_desc: [
		"火焰工坊。八个火图腾和脉冲运行每个熔炉配方，包括矿物砂。一个手鼓心无法维持这个窑炉。",
		"方法：熔炉 + 谐振器 + 音叉。火焰图腾。将砂砾熔炼成脉冲——手鼓之心无法驱动。"
	]
	quest.4200000000228039.title: "熔炉中的杂质"
	quest.420000000022803A.quest_desc: [
		"为工坊编织配方封印。空瓶会返回原放置的槽位。Side-IO拒绝观众和其他营地。自5.0起，它要求在八格内有一个保留的织布机共鸣图腾，否则它将闲置并提示缺少哪种声音。",
		"方法：灵魂法典命名了封印织布机。座位瓶会回到该槽位。"
	]
	quest.420000000022803A.title: "用于封存的织布机"
	quest.420000000022803B.quest_desc: [
		"四种便宜的脉冲灯（Glow Reed、Shard Lamp、Echo Sconce、Ember Bowl）每秒从晶格中吸收1-2个脉冲。红石可以调暗它们。",
		"方法：制作一个碎片灯，将其放置在八个脉冲方块内，然后用红石调暗以获得夜晚。"
	]
	quest.420000000022803B.title: "一盏会喝脉冲的灯盏"
	quest.420000000022803C.quest_desc: [
		"十个精神护身符可佩戴在三个部落饰品栏位中，不可作为奇物。天空与空气可让你自由翱翔。潜行使用共鸣图腾可绑定一个声音；和声图腾可绑定熔炉附近的所有声音。",
		"方法：合成天空护符，然后潜行使用在空气图腾上。灵魂法典：灵魂护符。"
	]
	quest.420000000022803C.title: "一个会说话的小饰品"
	quest.420000000022803D.quest_desc: [
		"水工坊。与 Spiritgear 一样，在 Echo 站进行排名；排名越高，加速消耗越多的 Pulse。排名在拾取后保留。自 5.0 起，它需要在一个八格范围内有一个保留的 Water Resonance Totem，否则它将闲置并提示缺少哪种声音。",
		"方法：使用灵界法典工坊页面。将潮汐泵放置在水箱上，若保持安静，则潜行使用法典。"
	]
	quest.420000000022803D.title: "用于蓄水池的泵浦"
	quest.420000000022803E.quest_desc: [
		"每个脉冲仍为100FE。未评级转换率为每秒60脉冲。将适配器评级为Echo Attune、Bind，然后是Manifest和empty-hand，以命名实时速率。它仍然无法接收FE。",
		"方法：潜行使用谐振增强器作用于回声调谐，然后绑定，再显化。当诊断名称的速率高于60时触发。"
	]
	quest.420000000022803E.title: "对当前排名进行排序"
	quest.420000000022803F.quest_desc: [
		"在已放置的共鸣图腾（40脉冲）上使用任意灵器部件或护身符即可绑定该声音。混合套装亦可。图腾不会被消耗。织布机需要织布机图腾。",
		"方法：在附近有40个脉冲的图腾上潜行使用工具、盔甲部件或护身符。当提示框显示已绑定的声音时触发。"
	]
	quest.420000000022803F.title: "绑定一个语音命令"
	quest.4200000000228040.quest_desc: [
		"芦苇灯。营地小径用的廉价脉冲灯。可选。",
		"方法：合成发光芦苇。放置在脉冲附近。可选。"
	]
	quest.4200000000228040.title: "芦苇灯"
	quest.4200000000228041.quest_desc: [
		"一个会喝脉冲的壁灯。可选物品。",
		"方法：制作回声壁灯并悬挂。可选步骤。"
	]
	quest.4200000000228041.title: "回声壁灯"
	quest.4200000000228042.quest_desc: [
		"Pulse 上的篝火碗。可选的。",
		"方法：制作 Ember Bowl。可选步骤。"
	]
	quest.4200000000228042.title: "Ember bowl"
	quest.4200000000228043.quest_desc: [
		"将风铃挂在天花板上。营地家具：凳子、桌子、瓮、垫子、架子和这个。可选。",
		"方法：制作风之护身符并悬挂。可选纪念品。"
	]
	quest.4200000000228043.title: "风中飘扬的一个护身符"
	quest.4200000000228044.quest_desc: [
		"在仪式熔炉处，Chorus会绑定所有附近的图腾之声。有Sky在手后为可选步骤。",
		"方法：合成 Chorus Charm，然后在有声音的熔炉旁潜行使用。可选。"
	]
	quest.4200000000228044.title: "附近的所有声音都会消失，仿佛被某种力量吞噬了一般。"
	quest.4200000000228045.quest_desc: [
		"斧头消耗脉冲，如同镐子。在回响站升级；潜行使用图腾绑定声音。可选。",
		"方法：制作 Spiritgear 斧。有镐子后也可选做。"
	]
	quest.4200000000228045.title: "木材加工用的锋利度提升"
	quest.4200000000228046.quest_desc: [
		"砖块和碗，外加三个铜。把它放在点燃的篝火、火、岩浆、熔岩或余烬碗上，完全不需要脉冲。最多四种食材和一个碗，顺序不限，大约十二秒做一份。漏斗可以从上方和侧面喂食，并从下方取餐。",
		"方法：砖块和碗，三个铜块。放在篝火、火、岩浆、熔岩或余烬碗上；不能用脉冲。"
	]
	quest.4200000000228046.title: "一个用于露营的锅具"
	quest.4200000000228047.quest_desc: [
		"来自余烬荒野的炽热红块茎。你采摘的是种子，像土豆一样种在农田里。灵器锄头可以一次性收割和重植。",
		"方法：在余烬荒地通过鼓门自然生长。采摘下来的就是种子，种植在农田上即可。"
	]
	quest.4200000000228047.title: "Emberroot"
	quest.4200000000228048.quest_desc: [
		"在芦苇沼泽中野生生长。采摘一片并种植；在翻耕的土地上经历四个阶段，蜜蜂会为其授粉。",
		"方法：在芦苇沼泽中通过鼓门自然生长。将采摘的植物种植在农田上。"
	]
	quest.4200000000228048.title: "芬·莱斯 (Fen Rice)"
	quest.4200000000228049.quest_desc: [
		"来自雪原。它也算作灵药壶的一种草药。",
		"方法：在雪原中通过鼓门自然生长。将采摘的作物种植在农田上。"
	]
	quest.4200000000228049.title: "霜莓（Frostberry）"
	quest.420000000022804A.quest_desc: [
		"来自Glimmer Ridge。既是水壶的草药，也是一种作物。",
		"方法：在闪烁山脊的鼓门中自然生长。将采摘的植物种在农田上。"
	]
	quest.420000000022804A.title: "Glimmer Bean"
	quest.420000000022804B.quest_desc: [
		"来自草原，大多数部落菜肴都以此为基础。在种植其他作物前，先种上一片。",
		"方法：在草原上通过鼓门自然生长。将采摘的植物种植在农田上。"
	]
	quest.420000000022804B.title: "草原谷物"
	quest.420000000022804C.quest_desc: [
		"炉灶锅中放入两份草原谷物和一份铁砂。食用部落菜肴可获得其增益效果五分钟；砂歌者部落的菜肴能获得更多矿石。一旦部落称你为族人，即可用四份作物出售该菜肴，或在部落炉灶献上其菜肴可获得六点声望。",
		"方法：在炉灶锅中用两个草原谷物和一个铁砂加热。砂之歌者会在友好处出售。"
	]
	quest.420000000022804C.title: "The Grit-singers' loaf"
	quest.420000000022804D.quest_desc: [
		"两份生肉和一份余烬根。生肉来自三月的猎物。边缘行者之赐：潜行时永不坠落。每个部落都有自己的菜肴；JEI在锅下列出了全部九种。",
		"方法：在炉灶锅中放入两个生肉和一根余烬根。生肉由三月的猎物动物掉落。"
	]
	quest.420000000022804D.title: "边缘行者们的抽搐式移动"
	quest.420000000022804E.quest_desc: [
		"锅中装有守护者根泥、粗粒烤面包、余烬根和草原谷物。将盛宴置于实心方块上，可容纳六份；每份能填饱你并赋予八分钟的地球祝福——挖掘更快，站立更稳。每种声音都有其专属的菜肴。",
		"方法：在炉灶锅中放入守护者之根泥、砂砾烤面包、余烬根和草原谷物。放置后，可得到六份食物。"
	]
	quest.420000000022804E.title: "用于露营的桌子一张"
	quest.420000000022804F.quest_desc: [
		"熔炉周围放骨头和铁，底下放骨铃。置于火上。三种材料：一个生试剂、一株三月草、一个基底——玻璃瓶可制作两种酊剂，蜂巢可制作两种软膏，木炭可制作四种熏香。一批需要十秒和来自晶格的24点脉冲。八格内最近的图腾会唱入配方中。",
		"方法：在熔炉周围放置骨头和铁，下方放一个骨铃。将其置于热源上；在8格范围内放置图腾即可酿造。"
	]
	quest.420000000022804F.title: "火上的水壶"
	quest.4200000000228050.quest_desc: [
		"试剂家族选择疗法：引火剂增强力量，冷却剂增强火焰抗性，解毒剂解除中毒，修补剂增强再生能力，以此类推。一瓶药剂持续三分钟，使用后瓶子返还。所有疗法都能解除精神疾病、静默、磨损和 ley 疾病。",
		"方法：灵魂水壶——原始试剂、三月草和玻璃瓶。十秒，24脉冲，两种酊剂。"
	]
	quest.4200000000228050.title: "把它喝下去"
	quest.4200000000228051.quest_desc: [
		"蜂巢为基底。将药膏用于自己、朋友、村民或伙伴：一次性恢复三颗心，消除所有负面效果，药效持续半瓶药剂的时间。一堆这样的药膏，能让你在严冬的夜晚安然无恙，而不是徒步回家。",
		"方法：灵魂水壶——原始试剂、三月草和蜂巢。每批制作两种药膏。"
	]
	quest.4200000000228051.title: "把它放在上面"
	quest.4200000000228052.quest_desc: [
		"以木炭为底座。在仪式火盆中放置熏香——最多十六根，无需封印和脉冲——每两秒，八格内的所有生物都会获得治疗，使宠物恢复一颗心。每根熏香燃烧三十秒。红石会将其熄灭；空手潜行可将其收回。",
		"方法：Spirit Kettle — 原始试剂、三月草和木炭。每批四根香；在 Ritual Brazier 中燃烧。"
	]
	quest.4200000000228052.title: "为了所有人，把它烧掉吧"
	quest.4200000000228053.quest_desc: [
		"两根骨铃围绕一根棒子上的具象化锭。按住使用，每半秒修复你在六格内注视的目标，或你自己：消耗2个脉冲，恢复三刻之心。它与其余的灵器一样，在回响站中排名；从束缚开始，每次摇动都能减轻一级的灵器病。",
		"方法：用两根骨铃围绕一根棒子上的具象化锭。按住使用可修复你注视的任何生物。"
	]
	quest.4200000000228053.title: "摇晃它"
	quest.4200000000228054.quest_desc: [
		"用岩浆块铺路可得到四块。高温下它们会冒蒸汽。在屋顶下，五格内有热石的床上睡一晚：醒来你将完全治愈、净化，并获得十分钟的圣灵祝福，疾病无法侵袭。",
		"方法：用岩浆块覆盖可生成四个。将它们放置在屋顶床五格内的热源上。"
	]
	quest.4200000000228054.title: "在木屋中度过的一个夜晚"
	quest.4200000000228055.quest_desc: [
		"在Spirit Seal周围放置两块石头、一个Mossback Scale和一个Spirit Reed；封印会返还。将其投掷到Rite Circle内放置有Spirit Seal的brazier上，可获得500 Pulse：十二格内的所有生物将恢复十颗心，被净化和祝福，且圆圈将保持开启十分钟。先将fallen familiar的Spirit Remnant放在pedestal上，它便会完好无损地归来。",
		"配方：2个石头、1个苔背鳞片、1个灵草和1个灵印，无需特定顺序；灵印会返还。在仪式圈的密封火盆上施放。"
	]
	quest.4200000000228055.title: "仪式石板：治愈之环"
	quest.4200000000228056.quest_desc: [
		"对角放置一个具象化锭、一个骨铃和一个木棍。伤害+7，攻击距离+1.5，冲刺突刺伤害提高35%。下面是刃：它在回响站中排名，消耗脉冲用于回响打击，并带有图腾之声。它能将裂口犬拒之门外。",
		"方法：斜着放置 Manifested Ingot、Bone Chime 和一根棍子。在 Echo 站台的排名与 Blade 相同。"
	]
	quest.4200000000228056.title: "先到达目的地"
	quest.4200000000228057.quest_desc: [
		"骨铃上方T形排列的四个具象化锭。伤害10，射程+0.5，沉重——手持时减慢移动速度——该系列中横扫范围最广、威力最强。战斧、战锤、匕首、镰刀和三叉戟的制法相同；每种都通过射程、速度和重量相互取舍。",
		"方法：在骨铃上方用四个具象化锭摆成T形。重型；横扫范围最广。"
	]
	quest.4200000000228057.title: "最宽广的横扫范围"
	quest.4200000000228058.quest_desc: [
		"骨铃周围的弦和铜共振器。它会用你携带的细胞发射脉冲音波，并吸收箭矢。快速失手，匆忙时半抽。",
		"方法：在骨铃周围放置弦和铜共振器。在携带脉冲时发射声波。"
	]
	quest.4200000000228058.title: "会唱歌的弓"
	quest.4200000000228059.quest_desc: [
		"Pulse Bow 两侧各放一个 Manifested Ingot，下方放 tripwire hook 和 sticks。按住使用键上弦——向前拉 10 个 Pulse，比完全拉弦稍长——再按使用键发射。冲击力约为普通箭的 1.5 倍，飞行轨迹近乎直线，可长时间保持射击。",
		"方法：在脉冲弓两侧放置铸锭，下方放置绊线钩和木棍。按住使用键装填，使用键射击。"
	]
	quest.4200000000228059.title: "弓箭的更重一些的姐妹武器"
	quest.420000000022805A.quest_desc: [
		"Song Bench 的输出旁有一个武器座。将图腾放在可及范围内，晶格中放入 Pulse，将装有四种同种强化试剂的 Reagent Pouch 放在快捷栏上，安装 Spiritgear 武器，选择试剂并按 Anoint：需要四种试剂和 32 点 Pulse。Searing 灼烧，Stormcall 引雷，Bloodthirst 偷取生命，Mending 修复武器——共十一种，每次一种；更换试剂即可替换。除非部落力量：可涂抹包被打开，否则只有 Spiritgear 能在该台座上制作。若武器携带此包，请勾选此项。",
		"方法：在Song Bench的武器位放置Spiritgear武器，在袋中放入四个强化试剂和32个Pulse；按下Anoint。涂油成功时会触发。"
	]
	quest.420000000022805A.title: "刀刃中的一种试剂"
	quest.420000000022805B.quest_desc: [
		"藤蔓缠绕灵草和末影珍珠可制作两个。将两个放在同一列的不同楼层，它们会相互找到，但不会链接或产生能量。跳跃可升至上方电梯，潜行可降至下方电梯，每方向最多48格。带有天花板的电梯会被越过。",
		"方法：用藤蔓环绕 Spirit Reed 和一个末影珍珠，合成两个。将它们堆叠成一列；向上跳跃，向下潜行。"
	]
	quest.420000000022805B.title: "向上移动一列"
	quest.420000000022805C.quest_desc: [
		"一根线下的灵草。用它作用于生物可将其带走，作用于方块则可安全放置。无论是玩家、首领还是行军精英，皆可使用。编织袋有两种用途——单次旅行；铜制、显化及共鸣罐可携带更多，且共鸣罐永不磨损。当编织袋仅剩一次使用时，无法带走生物。",
		"方法：用线拴住灵魂芦苇。用于生物可拾起，用于方块可放置。可使用两次。"
	]
	quest.420000000022805C.title: "将生物带回家中"
	quest.420000000022805D.quest_desc: [
		"皮革覆盖木板，环绕音符方块。门仪式是一款没有终点传送门的游戏：包里的每首曲子，在A、S、D、F上随着节拍到达终点线。它会记录每首曲子的最佳成绩和服务器前五名的排行榜。在真正的门鼓前，先在这里练习吧。",
		"方法：皮革包裹木板，再围住一个音符方块。用它来选择曲目，然后按 A、S、D、F 键。"
	]
	quest.420000000022805D.title: "为乐趣而敲击鼓点"
	quest.420000000022805E.quest_desc: [
		"四块围绕 Spirit Seal 的发光石、两个 Manifested Ingot、一个金胡萝卜和 Spiritweave。使用它来穿戴；潜行使用可打开三个护身符槽位。Lantern 护身符承载着 Spirit 之声：夜视，以及你身上的任何声音祝福持续时间延长一半。穿戴的护身符每两秒消耗 2 点 Pulse，来自携带的单元格。",
		"方法：用四个萤石、两个具象锭、一个金胡萝卜和灵织布围成一个灵魂印记。右键穿戴；潜行右键打开插槽。"
	]
	quest.420000000022805E.title: "一款可以佩戴的光源物品"
	quest.420000000022805F.quest_desc: [
		"部落称你为客，右键长老交谈。请求工作，他们会给你一个任务——每天开放三个，每个部落保留一个，报酬为声望和每第三个任务的部落印记。询问他们的故事，七步之路便开始了：朋友、珍视之物、篝火旁的狩猎、营地的仪式、烹饪菜肴，以及他们的目的地。最后一步是与守卫者的试炼。完成一个故事，并持有其遗物。",
		"方法：右键点击部落的长老（访客或以上），请求他们的故事；七个步骤最终会指向一个守护者。在第一个遗物上获得成就。"
	]
	quest.420000000022805F.title: "一段被讲述的故事"
	quest.4200000000228060.quest_desc: [
		"垫石守护者的遗物。他们的故事终结于草原上践踏环旁的奔腾之灵；赢得试炼，长老便会将其交予你。无论地位如何，只要携带此物，他们的祝福便会伴随你左右：你永远不会践踏农田。",
		"方法：与长老一同完成垫守护者（Pad-keepers）的故事；考验是草原上的奔腾之灵（Stampede Spirit）。"
	]
	quest.4200000000228060.title: "保留了余烬（Kept Ember）"
	quest.4200000000228061.quest_desc: [
		"Grit-singers的遗物。他们的故事终结于水晶原野的Singling Fracture处的Prism Serpent；赢得试炼，长老便会将其交予你。无论携带在背包何处，它都会持续赋予你祝福，不受地位影响：你从矿石中获得的产出更多。",
		"方法：与长老一同完成 Grit-singers 的故事；考验是水晶原野中的棱镜蛇。"
	]
	quest.4200000000228061.title: "鸣响石"
	quest.4200000000228062.quest_desc: [
		"Rootbinders的遗物。他们的故事终结于Reed Fen的Drowned Root处的Bog Matriarch；赢得试炼，长老便会将其交予你。无论地位如何，只要携带在身上，作物的生长速度就会在你周围加快。",
		"方法：完成与长老的根缚者故事；试炼对象是芦苇沼泽中的沼泽女族长。"
	]
	quest.4200000000228062.title: "第一根根须"
	quest.4200000000228063.quest_desc: [
		"边缘行者们的遗物。他们的故事终结于高地的巢穴中的风暴巨鹰；赢得试炼，长老便会将其交予你。无论地位如何，只要携带它，潜行时便永不坠落。",
		"方法：与他们的长老一同完成边缘行者们的故事；考验是高原上的风暴巨鹰。"
	]
	quest.4200000000228063.title: "桥梁钉"
	quest.4200000000228064.quest_desc: [
		"鼓心者的遗物。他们的故事终结于余烬荒原的熔渣王座旁的熔渣泰坦；赢得试炼，长老便会将其交予你。无论地位如何，只要携带在身上，他们的祝福便会持续生效：你的挥舞速度更快。",
		"方法：与鼓心部落的长老完成他们的故事；试炼是在余烬荒原中的熔渣泰坦。"
	]
	quest.4200000000228064.title: "稳定的鼓点"
	quest.4200000000228065.quest_desc: [
		"织纹者的遗物。他们的故事终结于浅滩潮石旁的潮鼓手；赢得试炼，长老便会将其交予你。无论携带何处，其祝福将始终伴随你：附近的回响站效果翻倍。",
		"方法：与织纹者的长老一同完成他们的故事；试炼对象是浅滩中的潮汐鼓手。"
	]
	quest.4200000000228065.title: "Silent Gear"
	quest.4200000000228066.quest_desc: [
		"殖民者们的遗物。他们的故事终结于雪原的环形土冢中的亡者冢；赢得试炼，长老便会将其交予你。无论地位如何，只要携带在身上，他们的庇佑便会持续生效：你将永不被蜇伤。",
		"方法：完成与部落长者相关的部落守护者故事；试炼对象是雪原中的雪冢亡灵。"
	]
	quest.4200000000228066.title: "蜂巢封印"
	quest.4200000000228067.quest_desc: [
		"封印匠的遗物。他们的故事终结于闪光山脊的封印之门处的宝库守卫；赢得试炼，长老便会将其交予你。无论放在背包何处，它都会持续为你提供恩惠：你的护身符所需脉动减半。",
		"方法：与他们的长老一起完成封印匠的故事；考验是位于闪光山脊的宝库哨兵。"
	]
	quest.4200000000228067.title: "礼貌的海豹"
	quest.4200000000228068.quest_desc: [
		"织布匠的遗物。他们的故事终结于《静默鼓声的无名者》；赢得试炼，长老便会将其交予你。无论地位如何，只要携带在身上，他们的祝福便会持续生效：你的歌声更廉价。",
		"方法：与织布工长老一同完成他们的故事；考验是在静默鼓声中的无名者。"
	]
	quest.4200000000228068.title: "第九根线 (Ninth Thread)"
	quest.4200000000228069.quest_desc: [
		"每个部落的故事都已结束：八位守护者与《无名者》均已面对。九个遗迹全部在手，第九协议近在咫尺。`/tribalpower standing` 会显示各部落与你的关系。",
		"方法：完成全部九个故事。第九个遗物入手时获得成就。"
	]
	quest.4200000000228069.title: "九件圣物"
	quest.420000000022806A.quest_desc: [
		"熔渣王座位于余烬荒原：中心是守护者祭坛的环形石台，置于四支点燃的蜡烛间的抛光深板岩上，位于开阔地带。空手潜行使用祭坛，它会说出所需之物——八个岩浆鳞片——然后将它们放置上去并退后。潜行可抵御其重击；被激怒后，环形石台会点燃，熔渣中升起灰烬小恶魔。半血时它会彻底激怒并召唤同族生物，但这些生物不会掉落任何东西。等待半分钟它会再次入睡；祭坛两次召唤间隔二十分钟。它会掉落熔渣核心，而它的倒下也标志着鼓心部落故事的终结。",
		"方法：空手潜行使用国家的守护者祭坛，放置八种它指定的试剂，即可获胜。通过击杀获得进度。"
	]
	quest.420000000022806A.title: "熔渣泰坦已静止不动"
	quest.420000000022806B.quest_desc: [
		"芦苇沼泽的沉没之根：中心有守护者祭坛的环形石台，位于四支点燃的蜡烛之间的抛光深板岩上，上方是开阔地带。空手潜行使用祭坛，它会说出所需之物——八根芦苇獠牙——然后将它们放置上去并退后。它的陷阱会将你拖入并减速；待在坚实的地面上，并砍倒它召唤的芦苇追踪者。当生命值减半时，它会苏醒并召唤同族的生物，这些生物不会掉落任何东西。等待半分钟，它会再次入睡；祭坛在两次召唤之间会休息二十分钟。它会掉落沼泽之心，而它的倒下也结束了根缚者的故事。",
		"方法：空手潜行使用国家的守护者祭坛，放置八种它指定的试剂，即可获胜。通过击杀获得进度。"
	]
	quest.420000000022806B.title: "沼泽女族长静止不动了"
	quest.420000000022806C.quest_desc: [
		"雪原中的石冢环：中心有守护者祭坛的石头环，置于四支点燃的蜡烛间的抛光深板岩上，位于户外。空手潜行使用祭坛，它会说出所需之物——八个霜冻下颚——然后将它们放置上去并退后。它的气息会冻结前方的一切。绕到后面；它召唤的霜冻爬行体行动缓慢。当生命值减半时，它会苏醒并召唤其同类的生物，这些生物不会掉落任何东西。等待半分钟，它又会入睡；祭坛在两次召唤之间会休息二十分钟。它会掉落石冢石，而它的坠落也结束了殖民者们的故事。",
		"方法：空手潜行使用国家的守护者祭坛，放置八种它指定的试剂，即可获胜。通过击杀获得进度。"
	]
	quest.420000000022806C.title: "Cairn Wight 已被静默"
	quest.420000000022806D.quest_desc: [
		"水晶原野的歌唱裂隙：中心有守护者祭坛的环形石台，置于四支点燃的蜡烛间的抛光深板岩上，位于开阔地带。空手潜行使用祭坛，它会说出所需之物——八个棱镜甲壳——然后将它们放置上去并退后。它会发射标记你的光箭。移动靠近，并注意被激怒后添加的第二支箭。半血时它会受惊并召唤其同类的生物，这些生物不会掉落任何东西。等待半分钟它会再次入睡；祭坛两次召唤之间会休息二十分钟。它会掉落棱镜核心，而它的坠落也结束了砂砾歌者的故事。",
		"方法：空手潜行使用国家的守护者祭坛，放置八种它指定的试剂，即可获胜。通过击杀获得进度。"
	]
	quest.420000000022806D.title: "棱镜蛇已静止不动"
	quest.420000000022806E.quest_desc: [
		"Glimmer Ridge的封印之门：中心有守护者祭坛的石环，置于四支点燃的蜡烛间的抛光深板岩上，上方是开阔地带。空手潜行使用祭坛，它会说出所需之物——八个哨兵印记——然后将它们放置上去并退后。它会穿上行军中最重的盔甲，并用横扫将你击落山脊。被唤醒后，它会每隔三秒为自己施加防护：只需等待即可。当生命值减半时，它会再次被唤醒并召唤本国的生物，但这些生物不会掉落任何东西。等待半分钟，它又会入睡；祭坛在两次召唤之间会休息二十分钟。它会掉落宝库封印，而它的坠落也终结了封印雕刻者的故事。",
		"方法：空手潜行使用国家的守护者祭坛，放置八种它指定的试剂，即可获胜。通过击杀获得进度。"
	]
	quest.420000000022806E.title: "Vault Sentinel 已静止不动"
	quest.420000000022806F.quest_desc: [
		"浅滩的潮汐石：中心有守护者祭坛的环形石，置于四支点燃的蜡烛间的抛光深板岩上，位于开阔地带。空手潜行使用祭坛，它会说出所需之物——八个咸水獠牙——然后将它们放置上去并退后。每次心跳都会将所有人拉向它并造成伤害。从岸边背对坚固物体与其战斗。半血时它会苏醒并召唤同族的生物，这些生物不会掉落任何东西。等待半分钟它会再次入睡；祭坛两次召唤间隔二十分钟。它会掉落潮汐贝壳，其坠落标志着织纹者的故事终结。",
		"方法：空手潜行使用国家的守护者祭坛，放置八种它指定的试剂，即可获胜。通过击杀获得进度。"
	]
	quest.420000000022806F.title: "潮汐鼓手已静止不动"
	quest.4200000000228070.quest_desc: [
		"草原上的践踏之环：中心有守护者祭坛的石环，置于四支点燃的蜡烛间的抛光深板岩上，位于户外。空手潜行使用祭坛，它会说出所需之物——八根 Shank Sinew——然后将它们放置上去并退后。它会发起冲锋。在它经过时侧身攻击；当 Burrow Gnashers 出现时，站在一个方块上。当它血量减半时会苏醒并召唤其同族的生物，这些生物不会掉落任何东西。等待半分钟，它会再次入睡；祭坛在两次召唤之间会休息二十分钟。它会掉落 Herd Horn，它的倒下也标志着 Pad-keepers 故事的终结。",
		"方法：空手潜行使用国家的守护者祭坛，放置八种它指定的试剂，即可获胜。通过击杀获得进度。"
	]
	quest.4200000000228070.title: "Stampede Spirit 已被驯服"
	quest.4200000000228071.quest_desc: [
		"高地上的巢穴：中心有守护者祭坛的环形石台，位于四支点燃的蜡烛之间的抛光深板岩上，上方是开阔地带。空手潜行使用祭坛，它会说出所需之物——八个风暴之翼——然后将它们放置上去并退后。它会俯冲并将你抛向空中；被激怒后，每次俯冲都会引来闪电。弓箭和屋顶比盾牌更管用。当它生命值减半时会再次被激怒，并召唤其同类的生物，这些生物不会掉落任何东西。等待半分钟，它会再次入睡；祭坛在两次召唤之间会休息二十分钟。它会掉落风暴羽毛，而它的坠落终结了边缘行者们的故事。",
		"方法：空手潜行使用国家的守护者祭坛，放置八种它指定的试剂，即可获胜。通过击杀获得进度。"
	]
	quest.4200000000228071.title: "风暴岩雀已静止不动"
	quest.4200000000228072.quest_desc: [
		"八个守护者核心和一个无名之心，形状不定。带织布线的核心会产出六个共振核心，所以想要两者就再拿一组掉落物。每个守护者的boss条都显示其部落的颜色。",
		"方法：八个守护者核心和一个无名之心，无需特定形状。在身上放置九个遗迹，用织布机围成一个圈。"
	]
	quest.4200000000228072.title: "九格石板"
	quest.4200000000228073.quest_desc: [
		"画一个织布机圆圈——织布机印章置于祭坛内的仪式圈内——并将刻有九件遗物的石板投掷在身上；仪式会在生效前汲取脉动。九盏灯升起，每盏都代表一个部落的颜色。从此，所有部落都至少会把你视为族人，九项祝福会暂时降临于你，每当你站在极光下，它都会完全燃烧。每名玩家仅限一次；第二次投掷只会点亮圆圈。",
		"方法：在祭坛内的熔炉中编织封印，背包里有九件遗物；潜行使用石板作用于熔炉。"
	]
	quest.4200000000228073.title: "织布机同意了"
	quest.4200000000228074.quest_desc: [
		"织机的历史碎片共十六块，镌刻于三月：八块刻石在遗迹的墙壁上，八幅二乘二的壁画在守卫的领地。右键阅读，法典会保存并整理到编年史中。读完全部十六块，故事便完整了。",
		"方法：右键点击三月遗迹中的所有八块雕刻石和守护者领地中的所有八幅壁画。"
	]
	quest.4200000000228074.title: "编年史全篇"
	quest.4200000000228075.quest_desc: [
		"镶嵌在三月废墟的墙壁上——旧作坊、下沉的神庙、土丘、坟墓、地窖。在发现的地方阅读，然后拿起它，放在你自己的墙上；你读过的内容将永久保留。",
		"方法：将其放置在三月废墟的墙壁中。阅读后，将其打破并放置在你自己的墙壁上。"
	]
	quest.4200000000228075.title: "一块会记忆的石头"
	quest.4200000000228076.quest_desc: [
		"每个守卫脚下宽两格高两格，描绘着各自所在的国家。阅读任意部分即阅读全部。作为一个整体放置，整体拆除；在创造模式下切割壁画，右键即可更改章节。",
		"方法：在每个守卫的地面上两两站立。阅读它，然后将其完整取下并放置在家中。"
	]
	quest.4200000000228076.title: "一面能描绘出国家风貌的墙壁"
	quest.4200000000228077.quest_desc: [
		"三月会自行行动。灰烬、闪烁风暴、白化和芬雾笼罩大地，提升士气；每种都会滋养一个声音的发电机，同时阻碍另一个。偶尔，某个声音的 ley 线会激增：携带它的收集器产量翻倍，但若在无人收集器的空旷十字路口，Ley 病会动摇地面并消耗你的脉搏。每个部落轮流举办节日——加入盛宴可获得礼物。漂浮在你附近的暖光是游荡的灵魂；靠近它能获得该国故事的一段和一份小礼物。风暴和激增将在聊天和快捷栏中提前两分钟提示。抵御一次后勾选此项。",
		"方法：在天气、浪潮或节日当天进行；完成后勾选。"
	]
	quest.4200000000228077.title: "三月的微风在吹拂"

	quest.420000000023058C.quest_desc: [
		"砂砾歌手从不两次以相同方式切割石头。这张长凳记得每一次切割。",
		"九族为下一窝猫留下了补给。使用管家宝箱可随机开启补给，或用四个小宝箱合成一个中宝箱，或用三个中宝箱合成一个大宝箱。大宝箱能装下更多卷轴和更丰富的补给种类，单独开启则能获得更基础的补给。里面没有机器或进度代币，但每个宝箱都有极小概率开出线团碎片，极小概率开出完整的回归之线，大宝箱的几率更高。",
		"方法：在 JEI 中用石头 + 桌子部件。放置一个方块并选择一个变体。"
	]
	quest.420000000023058C.title: "石匠工作台"
	quest.420000000023058D.quest_desc: [
		"木材的相同技巧——用一块木头得到一百块木板。",
		"方法：JEI中的削面木匠台。和石匠台一样，用于木材。"
	]
	quest.420000000023058D.title: "木工台 (Carpenter's Table)"
	quest.420000000023058E.quest_desc: [
		"沙子变成玻璃，再将玻璃塑造成光线所能呈现的每一种形态。",
		"方法：JEI 中的切石台（石匠、木匠、玻璃匠…）。将方块放入工作台并选择切割方式。"
	]
	quest.420000000023058E.title: "玻璃吹制匠人"
	quest.420000000023058F.quest_desc: [
		"羊毛和布匹，重新编织——很适合用来修补织布机的垫子。",
		"方法：JEI 中的切石台（石匠、木匠、玻璃匠…）。将方块放入工作台并选择切割方式。"
	]
	quest.420000000023058F.title: "织布机工作台"
	quest.4200000000230590.quest_desc: [
		"树叶、树苗和生长中的植物，按种类分好类。",
		"方法：JEI 中的切石台（石匠、木匠、玻璃匠…）。将方块放入工作台并选择切割方式。"
	]
	quest.4200000000230590.title: "植物学家工作台"
	quest.4200000000230591.quest_desc: [
		"彩色方块和陌生石头。选一个变种；长凳上放着其余的。",
		"方法：JEI 中的切石台（石匠、木匠、玻璃匠…）。将方块放入工作台并选择切割方式。"
	]
	quest.4200000000230591.title: "炼金术工作台"
	quest.4200000000230592.quest_desc: [
		"金属和机械风格的方块，按需切割。",
		"方法：JEI 中的切石台（石匠、木匠、玻璃匠…）。将方块放入工作台并选择切割方式。"
	]
	quest.4200000000230592.title: "Tinkering Table"
	quest.4200000000230593.quest_desc: [
		"将方块投入 Mason Table，并从各种变体中选择。",
		"方法：用四个石头摆成正方形，或使用切石机。"
	]
	quest.4200000000230593.title: "一块切割好的石头"
	quest.4200000000230594.quest_desc: [
		"木匠台对木材也做同样的事情。",
		"方法：合成网格中一个原木可制作四个。"
	]
	quest.4200000000230594.title: "一块切好的木板"
	quest.4200000000230595.quest_desc: [
		"玻璃匠所知的每一块玻璃板都始于此处。",
		"方法：熔炼沙子。用锤子把鹅卵石打成砾石，砾石打成沙子，然后用熔炉。"
	]
	quest.4200000000230595.title: "一块切割的玻璃"
	quest.4200000000230596.quest_desc: [
		"Grit-singers最喜欢的争论用石头。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000230596.title: "深层板岩多样性"
	quest.4200000000230597.quest_desc: [
		"烧制粘土，百变千态。",
		"方法：四个砖块物品。陶土球可以熔炼成砖块。"
	]
	quest.4200000000230597.title: "各种各样的砖块"
	quest.4200000000230598.quest_desc: [
		"粗磨，细切。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000230598.title: "砂岩种类多样"
	quest.4200000000240599.quest_desc: [
		"将一块地皮变成住所的第一样东西。",
		"九族为下一窝猫留下了补给。使用管家宝箱可随机开启补给，或用四个小宝箱合成一个中宝箱，或用三个中宝箱合成一个大宝箱。大宝箱能装下更多卷轴和更丰富的补给种类，单独开启则能获得更基础的补给。里面没有机器或进度代币，但每个宝箱都有极小概率开出线团碎片，极小概率开出完整的回归之线，大宝箱的概率更高。",
		"方法：JEI 中的橡木木板。首个手工合成物品。"
	]
	quest.4200000000240599.title: "一把椅子"
	quest.420000000024059A.quest_desc: [
		"供你思考时放置法典的地方。",
		"方法：在JEI中用木板手工合成家具。第一把椅子是橡木的。"
	]
	quest.420000000024059A.title: "一张桌子"
	quest.420000000024059B.quest_desc: [
		"给猫群一个在桶工作时的休息空间。",
		"方法：在JEI中用木板手工合成家具。第一把椅子是橡木的。"
	]
	quest.420000000024059B.title: "一张工作台"
	quest.420000000024059C.quest_desc: [
		"对于那些你总想重读的图鉴页面。",
		"方法：在JEI中用木板手工合成家具。第一把椅子是橡木的。"
	]
	quest.420000000024059C.title: "一个架子"
	quest.420000000024059D.quest_desc: [
		"手工打造的储物柜，看起来浑然天成。",
		"方法：在JEI中用木板手工合成家具。第一把椅子是橡木的。"
	]
	quest.420000000024059D.title: "一个碗柜"
	quest.420000000024059E.quest_desc: [
		"垫板守护者们都睡得很香。你也应该如此。",
		"方法：在JEI中用木板手工合成家具。第一把椅子是橡木的。"
	]
	quest.420000000024059E.title: "一张华丽的床"
	quest.420000000024059F.quest_desc: [
		"一盏灯笼，一页纸，两者皆有容身之处。",
		"方法：在JEI中用木板手工合成家具。第一把椅子是橡木的。"
	]
	quest.420000000024059F.title: "一个床头柜"
	quest.42000000002405A0.quest_desc: [
		"切出一个框架，然后用任意方块装饰它。一个形状，所有皮肤。",
		"方法：将铁锭放在三个框架方块上。可切割框架方块。"
	]
	quest.42000000002405A0.title: "Framing Saw"
	quest.42000000002405A1.quest_desc: [
		"一个空白的立方体，等待伪装方块的到来。",
		"方法：用锯子画框，然后用方块画框立方体/石板/楼梯。伪装是右键点击方块。"
	]
	quest.42000000002405A1.title: "带框立方体"
	quest.42000000002405A2.quest_desc: [
		"半幅画面，双倍选择。",
		"方法：用锯子画框，然后用方块画框立方体/石板/楼梯。伪装是右键点击方块。"
	]
	quest.42000000002405A2.title: "带框的半砖"
	quest.42000000002405A3.quest_desc: [
		"步骤会磨损它们所附着的任何墙壁。",
		"方法：用锯子画框，然后用方块画框立方体/石板/楼梯。伪装是右键点击方块。"
	]
	quest.42000000002405A3.title: "带框架的楼梯"
	quest.42000000002405A4.quest_desc: [
		"对于那些虚空从未给予你的屋顶和屋脊而言。",
		"方法：用锯子画框，然后用方块画框立方体/石板/楼梯。伪装是右键点击方块。"
	]
	quest.42000000002405A4.title: "带框架的斜坡"
	quest.42000000002405A5.quest_desc: [
		"边缘行者以更少的东西跨越虚空。以优雅的方式抵达下一个平台。",
		"方法：在JEI中用匹配的石头/木头制作鹦鹉螺桥。"
	]
	quest.42000000002405A5.title: "绳索桥"
	quest.42000000002405A6.quest_desc: [
		"停机坪上有个屋顶。这里的雨，不过是野心在作祟。",
		"方法：在 JEI 中使用匹配的木材制作鹦鹉螺屋顶。"
	]
	quest.42000000002405A6.title: "阁楼屋顶"
	quest.42000000002405A7.quest_desc: [
		"舒适也是一种基础设施。",
		"方法：在JEI中用木板手工合成家具。第一把椅子是橡木的。"
	]
	quest.42000000002405A7.title: "沙发"
	quest.42000000002405A8.quest_desc: [
		"农夫之乐系列的厨房边缘装饰。",
		"方法：在JEI中用木板手工合成家具。第一把椅子是橡木的。"
	]
	quest.42000000002405A8.title: "计数器"
	quest.42000000002405A9.quest_desc: [
		"胡须法典的页边空白从何而来。",
		"方法：在JEI中用木板手工合成家具。第一把椅子是橡木的。"
	]
	quest.42000000002405A9.title: "书桌"
	quest.42000000002405AA.quest_desc: [
		"与桌子相匹配的小型储物柜。",
		"方法：在JEI中用木板手工合成家具。第一把椅子是橡木的。"
	]
	quest.42000000002405AA.title: "抽屉"
	quest.42000000002405AB.quest_desc: [
		"隐藏在墙壁中的一个阈值装置。",
		"方法：用锯子画框，然后用方块画框立方体/石板/楼梯。伪装是右键点击方块。"
	]
	quest.42000000002405AB.title: "带框门"
	quest.42000000002405AC.quest_desc: [
		"薄薄的伪装，彻底的掩饰。",
		"方法：用锯子画框，然后用方块画框立方体/石板/楼梯。伪装是右键点击方块。"
	]
	quest.42000000002405AC.title: "带框面板"
	quest.42000000002405AD.quest_desc: [
		"一条可以按你喜好装饰的边缘轨道。",
		"方法：用锯子画框，然后用方块画框立方体/石板/楼梯。伪装是右键点击方块。"
	]
	quest.42000000002405AD.title: "带框架的栅栏"
	quest.42000000002405AE.quest_desc: [
		"灰色而诚实，就像它诞生的砂砾一样。",
		"方法：在JEI中用匹配的石头/木头制作鹦鹉螺桥。"
	]
	quest.42000000002405AE.title: "安山岩桥梁"
	quest.42000000002505AF.quest_desc: [
		"一盏不是火把的墙壁灯，羞耻地卡住了。管家们可是有标准的。",
		"九族为下一窝猫留下了补给。使用管家宝箱可随机开启补给，或用四个小宝箱合成一个中宝箱，或用三个中宝箱合成一个大宝箱。大宝箱能装下更多卷轴和更丰富的补给种类，单独开启则能获得更基础的补给。里面没有机器或进度代币，但每个宝箱都有极小概率开出线团碎片，极小概率开出完整的回归之线，大宝箱的几率更高。",
		"方法：火把 + 铁粒。首个管家工艺配方。"
	]
	quest.42000000002505AF.title: "壁灯"
	quest.42000000002505B0.quest_desc: [
		"沙子，正在落下。在时钟群岛之前，唯一诚实的时钟。",
		"方法：在JEI中合成补充品（壁灯、麻袋、保险箱、绳子…）。管家会命名车站。"
	]
	quest.42000000002505B0.title: "沙漏"
	quest.42000000002505B1.quest_desc: [
		"从方块中滴下流体。小巧；莫名令人满足。",
		"方法：在JEI中合成补充品（壁灯、麻袋、保险箱、绳子…）。管家会命名车站。"
	]
	quest.42000000002505B1.title: "水龙头"
	quest.42000000002505B2.quest_desc: [
		"用手转动它。鼓心人也是从某个地方开始的。",
		"方法：在JEI中合成补充品（壁灯、麻袋、保险箱、绳子…）。管家会命名车站。"
	]
	quest.42000000002505B2.title: "曲柄"
	quest.42000000002505B3.quest_desc: [
		"展示一件物品。一个代币，一页纸，一座奖杯。",
		"方法：在JEI中合成补充品（壁灯、麻袋、保险箱、绳子…）。管家会命名车站。"
	]
	quest.42000000002505B3.title: "物品存放架"
	quest.42000000002505B4.quest_desc: [
		"一个装着袋子的袋子。恢复了整洁，收拾干净了。",
		"方法：在JEI中合成补充品（壁灯、麻袋、保险箱、绳子…）。管家会命名车站。"
	]
	quest.42000000002505B4.title: "袋子"
	quest.42000000002505B5.quest_desc: [
		"把磨损的线锁起来，以免被你更坏的想法利用。",
		"方法：在JEI中合成补充品（壁灯、麻袋、保险箱、绳子…）。管家会命名车站。"
	]
	quest.42000000002505B5.title: "安全"
	quest.42000000002505B6.quest_desc: [
		"将整页内容钉在Clowder能读到的地方。",
		"方法：在JEI中合成补充品（壁灯、麻袋、保险箱、绳子…）。管家会命名车站。"
	]
	quest.42000000002505B6.title: "公告板"
	quest.42000000002505B7.quest_desc: [
		"一个怀有抱负的罐子。在薄弱的地方生长一点。",
		"方法：在JEI中合成补充品（壁灯、麻袋、保险箱、绳子…）。管家会命名车站。"
	]
	quest.42000000002505B7.title: "种植箱"
	quest.42000000002505B8.quest_desc: [
		"将纺锤织布机碎片放置到可以欣赏的位置。",
		"方法：在JEI中合成补充品（壁灯、麻袋、保险箱、绳子…）。管家会命名车站。"
	]
	quest.42000000002505B8.title: "基座"
	quest.42000000002505B9.quest_desc: [
		"储存饼干、蜜蜂，或是秩序带来的微小尊严。",
		"方法：在JEI中合成补充品（壁灯、麻袋、保险箱、绳子…）。管家会命名车站。"
	]
	quest.42000000002505B9.title: "Jar (37)"
	quest.42000000002505BA.quest_desc: [
		"设置一个出生点，不用把整张床都搬上梯子。",
		"方法：JEI 中的羊毛。白色睡袋；有染色变种。套装在没有完整床的情况下生成。"
	]
	quest.42000000002505BA.title: "睡袋"
	quest.42000000002505BB.quest_desc: [
		"睡过白天，让怪物们来见一个休息充分的Skybound。",
		"方法：JEI中羊毛+线。用绳子和钉子悬挂。"
	]
	quest.42000000002505BB.title: "吊床"
	quest.42000000002505BC.quest_desc: [
		"把吊床挂在两根柱子之间，悬空着，然后大胆地跳下去。",
		"方法：一根线和一块铁锭。放置两个，然后挂上吊床。"
	]
	quest.42000000002505BC.title: "绳索与钉子"
	quest.42000000002505BD.quest_desc: [
		"为基地的漫漫长夜带来更稳定的火焰。",
		"方法：在JEI中合成补充品（壁灯、麻袋、保险箱、绳子…）。管家会命名车站。"
	]
	quest.42000000002505BD.title: "蜡烛台"
	quest.42000000002505BE.quest_desc: [
		"攀爬、悬挂或搭桥。边缘行者都信赖它。",
		"方法：在JEI中合成补充品（壁灯、麻袋、保险箱、绳子…）。管家会命名车站。"
	]
	quest.42000000002505BE.title: "绳索 (37)"
	quest.42000000002505BF.quest_desc: [
		"用红石按钮来升降绳索。",
		"方法：在JEI中合成补充品（壁灯、麻袋、保险箱、绳子…）。管家会命名车站。"
	]
	quest.42000000002505BF.title: "滑轮方块"
	quest.42000000002505C0.quest_desc: [
		"落到上面，虚空便会忘记惩罚你。",
		"方法：在JEI中合成补充品（壁灯、麻袋、保险箱、绳子…）。管家会命名车站。"
	]
	quest.42000000002505C0.title: "羽毛方块"
	quest.42000000002505C1.quest_desc: [
		"制定一个能让整个猫群都争论不休的计划。",
		"方法：在JEI中合成补充品（壁灯、麻袋、保险箱、绳子…）。管家会命名车站。"
	]
	quest.42000000002505C1.title: "黑板"
	quest.42000000002505C2.quest_desc: [
		"携带一件你最好别带的东西在身上。",
		"方法：在JEI中合成补充品（壁灯、麻袋、保险箱、绳子…）。管家会命名车站。"
	]
	quest.42000000002505C2.title: "笼子"
	quest.42000000002605C3.quest_desc: [
		"第一根导线。鼓心人保留的脉冲现在有去处了。",
		"九族为下一窝猫留下了补给。使用管家宝箱可随机开启补给，或用四个小宝箱合成一个中宝箱，或用三个中宝箱合成一个大宝箱。大宝箱能装下更多卷轴和更丰富的补给种类，单独开启则能获得更基础的补给。里面没有机器或进度代币，但每个宝箱都有极小概率开出线团碎片，极小概率开出完整的回归之线，大宝箱的几率更高。",
		"方法：用轧机轧制铜板。当前章节从这里开始。"
	]
	quest.42000000002605C3.title: "铜线"
	quest.42000000002605C4.quest_desc: [
		"一侧是旋转，另一侧是Forge能量。两条线握手言和。",
		"方法：制作与添加 — 用轧钢厂制作铜线，然后制作连接器和电机。"
	]
	quest.42000000002605C4.title: "连接器"
	quest.42000000002605C5.quest_desc: [
		"能量回流。时钟链现在由火花链驱动。",
		"方法：制作与添加 — 用轧钢厂制作铜线，然后制作连接器和电机。"
	]
	quest.42000000002605C5.title: "电动机"
	quest.42000000002605C6.quest_desc: [
		"将电荷保持在导线和工作之间。",
		"方法：制作与添加 — 用轧钢厂制作铜线，然后制作连接器和电机。"
	]
	quest.42000000002605C6.title: "电容器"
	quest.42000000002605C7.quest_desc: [
		"用储存的电流筑起一道墙，尽可能铺得又大又宽。",
		"方法：制作与添加 — 用轧钢厂制作铜线，然后制作连接器和电机。"
	]
	quest.42000000002605C7.title: "模块化蓄电器"
	quest.42000000002605C8.quest_desc: [
		"由锭制成的棒和线——Create 对压力的回应。",
		"方法：制作与添加 — 用轧钢厂制作铜线，然后制作连接器和电机。"
	]
	quest.42000000002605C8.title: "Rolling Mill"
	quest.42000000002605C9.quest_desc: [
		"无需附魔台，直接附魔。投入经验，获取意图。",
		"方法：在烈焰燃烧器后创建附魔工业。JEI会显示打印机和XP桶的名称。"
	]
	quest.42000000002605C9.title: "烈焰人附魔师"
	quest.42000000002605CA.quest_desc: [
		"液态练习，已携带。管家们会认为这既粗俗又实用。",
		"方法：在烈焰燃烧器后创建附魔工业。JEI会显示打印机和XP桶的名称。"
	]
	quest.42000000002605CA.title: "经验值桶 (Experience Bucket)"
	quest.42000000002605CB.quest_desc: [
		"复制一本书，一份计划，一页纸。法典静静地表示赞同。",
		"方法：在烈焰燃烧器后创建附魔工业。JEI会显示打印机和XP桶的名称。"
	]
	quest.42000000002605CB.title: "打印机"
	quest.42000000002605CC.quest_desc: [
		"熔岩与热能转化为动力。一座桥梁，而非轰鸣本身。",
		"方法：锇 + 熔炉 + 铜。首个Mekanism发电机。"
	]
	quest.42000000002605CC.title: "热能发电机"
	quest.42000000002605CD.quest_desc: [
		"在完全由天空组成的平台上，太阳是唯一不会被限制的资源。",
		"方法：在 Works 生产线之后制作 Mekanism 发电机。热发电机是第一个配方。"
	]
	quest.42000000002605CD.title: "太阳能发电机"
	quest.42000000002605CE.quest_desc: [
		"平台越高，转向越困难。建得高一点。",
		"方法：在 Works 生产线之后制作 Mekanism 发电机。热发电机是第一个配方。"
	]
	quest.42000000002605CE.title: "风力发电机"
	quest.42000000002605CF.quest_desc: [
		"燃烧多余的Sprout Strand。垫子上的东西没有废物。",
		"方法：在 Works 生产线之后制作 Mekanism 发电机。热发电机是第一个配方。"
	]
	quest.42000000002605CF.title: "生物生成器"
	quest.42000000002605D0.quest_desc: [
		"深入Mekanism的猫群，电力不足。",
		"方法：在 Works 生产线之后制作 Mekanism 发电机。热发电机是第一个配方。"
	]
	quest.42000000002605D0.title: "燃气燃烧发电机"
	quest.42000000002605D1.quest_desc: [
		"数字织布机，尽在掌握。随时随地，随心重织。",
		"方法：AE2 网络和已充能的无线套件后的无线终端。JEI 会显示配方。"
	]
	quest.42000000002605D1.title: "无线终端 (38)"
	quest.42000000002605D2.quest_desc: [
		"Mekanism的化学物质，储存在AE2网络中。两根晚期支柱，编织在一起。",
		"方法：AE2 外壳 + Mekanism 化学品，使用 Applied Mekanistics 化学电池。"
	]
	quest.42000000002605D2.title: "化学电池"
	quest.42000000002605D3.quest_desc: [
		"用于铜线无法承载完整脉冲信号的情况。",
		"方法：制作与添加 — 用轧钢厂制作铜线，然后制作连接器和电机。"
	]
	quest.42000000002605D3.title: "大型连接器"
	quest.42000000002605D4.quest_desc: [
		"能让你升级的蛋糕。不要告诉厨房的人。",
		"方法：在烈焰燃烧器后创建附魔工业。JEI会显示打印机和XP桶的名称。"
	]
	quest.42000000002605D4.title: "经验蛋糕"
	quest.42000000002605D5.quest_desc: [
		"更大一口免费的天空，味道依旧。",
		"方法：在 Works 生产线之后制作 Mekanism 发电机。热发电机是第一个配方。"
	]
	quest.42000000002605D5.title: "高级太阳能系统"
	quest.42000000002605D6.quest_desc: [
		"每个化学单元所需的保护壳。",
		"方法：AE2 外壳 + Mekanism 化学品，使用 Applied Mekanistics 化学电池。"
	]
	quest.42000000002605D6.title: "化学物品存放区"
	quest.42000000002605D7.quest_desc: [
		"从网络中携带一定量的气体离开。",
		"方法：AE2 外壳 + Mekanism 化学品，使用 Applied Mekanistics 化学电池。"
	]
	quest.42000000002605D7.title: "便携式化学电池"
	quest.42000000002705D8.quest_desc: [
		"每条线都有一位守护者，被“剪”所俘获：一个野化的织机构造体。你不是要杀死怪物，而是要通过击打它来重新张紧这条线。当线就位后，制作它的磨损图腾，在竞技场外的任何地方使用，你和32格内所有的猫群伙伴都将被吸入其舞台。获胜，你们每个人都将带着那位守护者的编织遗物回家。失败，你将被吐回，图腾也随之耗尽。",
		"Relics 可从 Curios 遗物栏、副手或快捷栏使用：穿戴时有被动效果，右键则有冷却中的强力效果。`/guardians leave` 可放弃战斗；`/guardians status` 显示 Clowder 的记录。",
		"九族为下一窝猫留下了补给。使用管家宝箱可随机开启补给，或用四个小宝箱合成一个中宝箱，或用三个中宝箱合成一个大宝箱。大宝箱能装下更多卷轴和更丰富的补给种类，单独开启则能获得更基础的补给。里面没有机器或进度代币，但每个宝箱都有极小概率开出线团碎片，极小概率开出完整的回归之线，大宝箱的几率更高。",
		"方法：勾选。在该线放置后，制作每个磨损的图腾；在竞技场外使用。"
	]
	quest.42000000002705D8.title: "裁断的答案 (Answer for the Cut)"
	quest.42000000002705D9.quest_desc: [
		"The Burrow Bowl: 一个下沉的碗，由四层土向下延伸至一个泥坑，上方有六个深色橡木根拱门，坑底有七个发光的青绿色根脉。",
		"四根磨损的线头和四块纱线方块环绕着一根虚空纱线。",
		"方法：胡须法典、锁定的守护者——图腾、竞技场、遗物。图腾的答案在面板上。"
	]
	quest.42000000002705D9.title: "图腾：床铺之地（Totem: the Beddown）"
	quest.42000000002705DA.quest_desc: [
		"每损失四分之一的血量，Beddown就会撞击并用一层泥土淹没坑洞，使其免疫。七个岩层中有一个会亮起：挖一条通道过去，暴露核心并击中它来打破封印。第一道门，而且是一道宽容的门。",
		"方法：使用对应的破旧图腾，然后赢得竞技场。完成此成就即可。"
	]
	quest.42000000002705DA.title: "重新张紧：床铺放下"
	quest.42000000002705DB.quest_desc: [
		"Rootheart：受到的击退减少百分之六十，且无法被任何实体拉动。Root Down：在吸收八颗心的伤害后，将自身扎根于原地五秒。",
		"获胜的 Clowder 成员每人一个，直接存入背包。",
		"方法：胡须法典、锁定的守护者——图腾、竞技场、遗物。图腾的答案在面板上。"
	]
	quest.42000000002705DB.title: "遗迹：根之心 (Rootheart)"
	quest.42000000002705DC.quest_desc: [
		"磨坊坑：一个深板岩采石场，地板上有旋转的砂轮环，四个石质筛斗将砾石倒入中央的砂坑。",
		"四根磨损的线头和四块纱线方块环绕着一根虚空纱线。",
		"方法：胡须法典、锁定的守护者——图腾、竞技场、遗物。图腾的答案在面板上。"
	]
	quest.42000000002705DC.title: "图腾：The Grindmaw"
	quest.42000000002705DD.quest_desc: [
		"Grindmaw在闭合时免疫。每个滑道每十五秒掉落一个grit块；携带一个到环上，让它滑入坑口，将下颌卡住十二秒。每个阶段环都会反转，将粗心者推入坑中。",
		"方法：使用对应的破旧图腾，然后赢得竞技场。完成此成就即可。"
	]
	quest.42000000002705DD.title: "重新张紧：齿轮研磨机"
	quest.42000000002705DE.quest_desc: [
		"Grindcore：免疫挖掘疲劳，手持筛子可获得一次额外的幸运判定。Shred：对下一个击中的目标造成两点护甲值的伤害。",
		"获胜的 Clowder 成员每人一个，直接存入背包。",
		"方法：胡须法典、锁定的守护者——图腾、竞技场、遗物。图腾的答案在面板上。"
	]
	quest.42000000002705DE.title: "遗迹：Grindcore 核心"
	quest.42000000002705DF.quest_desc: [
		"Overgrowth Terrace：四座花园露台，位于叶冠之下，配有八根棚架柱和四层楼上的四个修剪站。",
		"四根磨损的线头和四块纱线方块环绕着一根虚空纱线。",
		"方法：胡须法典、锁定的守护者——图腾、竞技场、遗物。图腾的答案在面板上。"
	]
	quest.42000000002705DF.title: "图腾：荆棘之母 (Totem: the Thornmother)"
	quest.42000000002705E0.quest_desc: [
		"荆棘之母从不直接攻击；她会种下荆棘篱笆，接触即蔓延燃烧，并在修剪站被过度生长时治愈。用剪刀和斧头可以清除。在一个站中将八个篱笆堆肥，可触发修剪波，清除地面并眩晕她——这是唯一能造成有效伤害的窗口。",
		"方法：使用对应的破旧图腾，然后赢得竞技场。完成此成就即可。"
	]
	quest.42000000002705E0.title: "重新张紧：荆棘之母 (Re-tension: the Thornmother)"
	quest.42000000002705E1.quest_desc: [
		"Thornseed：荆棘，无浆果或仙人掌伤害。开花会升起一圈树篱，使你和你的猫群在内部获得再生 II。",
		"获胜时每只Clowder成员可获得一个，直接存入背包。",
		"方法：胡须法典、锁定的守护者——图腾、竞技场、遗物。图腾的答案在面板上。"
	]
	quest.42000000002705E1.title: "遗迹：荆棘种子 (Relic: Thornseed)"
	quest.42000000002705E2.quest_desc: [
		"天空碎片：十个漂浮在虚空中的深板岩碎片，碎片之间有摇摇欲坠的桥梁，主碎片上有金爪痕，是首领落地的地方。",
		"四根磨损的线头和四块纱线方块环绕着一根虚空纱线。",
		"方法：胡须法典、锁定的守护者——图腾、竞技场、遗物。图腾的答案在面板上。"
	]
	quest.42000000002705E2.title: "图腾：边缘行者 (Totem: the Edgewalker)"
	quest.42000000002705E3.quest_desc: [
		"纯粹的决斗。边缘行者会跃过碎片，扑向离墙最远的人；金色爪印会标记着陆点——快离开。身后的桥会崩塌，稍后才能返回。坠落会损失六颗心，并把你送回巢穴。",
		"方法：使用对应的破旧图腾，然后赢得竞技场。完成此成就即可。"
	]
	quest.42000000002705E3.title: "重新张紧：边缘行者 (Re-tension: the Edgewalker)"
	quest.42000000002705E4.quest_desc: [
		"边缘行走：十二格以下无坠落伤害，不会从边缘滑落。边缘行走冲刺六格，两次，末端有更强的击打。",
		"获胜的 Clowder 成员每人一个，直接存入背包。",
		"方法：胡须法典、锁定的守护者——图腾、竞技场、遗物。图腾的答案在面板上。"
	]
	quest.42000000002705E4.title: "遗迹：边缘行者（Edgestep）"
	quest.42000000002705E5.quest_desc: [
		"锻造鼓：一个熔岩坑上的黄铜鼓台，前面有八个带敲击板的铜活塞锤，地板下有四条熔岩通道。",
		"四根磨损的线头和四块纱线方块环绕着一根虚空纱线。",
		"方法：胡须法典、锁定的守护者——图腾、竞技场、遗物。图腾的答案在面板上。"
	]
	quest.42000000002705E5.title: "图腾：鼓心 Totem: the Drumheart"
	quest.42000000002705E6.quest_desc: [
		"鼓心只在每四拍后的瞬间才能被伤害。在重拍时站在节拍垫上可蓄积三倍计数的火花；第四拍时熔岩通道会上升，所以要站在垫上，而不是通道里。每个阶段节奏都会加快。",
		"方法：使用对应的破旧图腾，然后赢得竞技场。完成此成就即可。"
	]
	quest.42000000002705E6.title: "重新张紧：鼓心装置"
	quest.42000000002705E7.quest_desc: [
		"Drumpulse：每第四次击中会额外恢复两颗心。Downbeat会眩晕并击退七格范围内的所有生物。",
		"获胜的 Clowder 成员每人一个，直接存入背包。",
		"方法：胡须法典、锁定的守护者——图腾、竞技场、遗物。图腾的答案在面板上。"
	]
	quest.42000000002705E7.title: "遗迹：鼓动之心 (Relic: Drumpulse)"
	quest.42000000002705E8.quest_desc: [
		"擒纵器：四个旋转的铜环，围绕着铁质中心轴转动，上面铺着深色橡木序列瓷砖，六个齿轮塔和一个十六格长的摆锤负责计时。",
		"四根磨损的线头和四块纱线方块环绕着一根虚空纱线。",
		"方法：胡须法典、锁定的守护者——图腾、竞技场、遗物。图腾的答案在面板上。"
	]
	quest.42000000002705E8.title: "图腾：齿轮匠（Totem: the Cogwright）"
	quest.42000000002705E9.quest_desc: [
		"齿轮匠的每个阶段：旋转环上的方块会依次亮起，你有十二秒的时间按顺序踏上去。成功会使其底盘开启八秒；失败会触发所有齿轮塔。摆锤是节拍器；当它大幅摆动时，环会反转。",
		"方法：使用对应的破旧图腾，然后赢得竞技场。完成此成就即可。"
	]
	quest.42000000002705E9.title: "重新张紧：齿轮匠（Re-tension: the Cogwright）"
	quest.42000000002705EA.quest_desc: [
		"Cogloop：速度I，工具磨损速度减慢五分之一。Rewind会重置你携带的每两件遗物，并将你回溯三秒。",
		"获胜的 Clowder 成员每人一个，直接存入背包。",
		"方法：胡须法典、锁定的守护者——图腾、竞技场、遗物。图腾的答案在面板上。"
	]
	quest.42000000002705EA.title: "遗迹：齿轮循环器 (Cogloop)"
	quest.42000000002705EB.quest_desc: [
		"蜂巢：一个由升降蜂巢、蜂蜜池和六个壁内工蜂巢组成的六边形蜂蜡竞技场。",
		"四根磨损的线头和四块围绕虚空纱线的纱线方块。",
		"方法：胡须法典、锁定的守护者——图腾、竞技场、遗物。图腾的答案在面板上。"
	]
	quest.42000000002705EB.title: "图腾：蜂巢思维（Totem: the Hivemind）"
	quest.42000000002705EC.quest_desc: [
		"蜂巢思维很脆弱，但每波都会派出六个蜂巢。在蜂巢上点燃篝火可封印三十秒；封印全部六个，王室密室将开启十分钟。你自己的产卵蜜蜂会一见到无人机就发起攻击。",
		"方法：使用对应的破旧图腾，然后赢得竞技场。完成此成就即可。"
	]
	quest.42000000002705EC.title: "重新张紧：蜂巢意识"
	quest.42000000002705ED.quest_desc: [
		"蜂巢召唤：蜜蜂永远不会背叛你，且在十六格内的蜂巢工作效率提高十倍。蜂群召唤：你攻击的目标将引来四只遗物蜜蜂。",
		"获胜的 Clowder 成员每人一个，直接存入背包。",
		"方法：胡须法典、锁定的守护者——图腾、竞技场、遗物。图腾的答案在面板上。"
	]
	quest.42000000002705ED.title: "遗迹：蜂巢之呼（Hivecall）"
	quest.42000000002705EE.quest_desc: [
		"守卫之环：一个由金色圆圈和九个镶嵌紫水晶尖塔的符文柱组成的石质圣所，中心是一个带有金色桩子的九边形基座。",
		"四根磨损的线头和四块纱线方块环绕着一根虚空纱线。",
		"方法：胡须法典、锁定的守护者——图腾、竞技场、遗物。图腾的答案在面板上。"
	]
	quest.42000000002705EE.title: "图腾：封印破译者（Totem: the Sealbreaker）"
	quest.42000000002705EF.quest_desc: [
		"封印破者藏在三个激活的护盾后。基座钉每阶段只亮一次——先观察。用Ars驱散或任意Sigil-strand物品按顺序驱散石柱；选错会重新激活所有三个，护盾玻璃会反击。三次成功，封印将开启十二秒。后续阶段会打乱符文并加入诱饵。",
		"方法：使用对应的破旧图腾，然后赢得竞技场。完成此成就即可。"
	]
	quest.42000000002705EF.title: "重新张紧：封印破译者"
	quest.42000000002705F0.quest_desc: [
		"海豹印记：所受魔法伤害减少五分之一。海豹印记可为你或你注视的猫群同伴抵挡一次重击。",
		"获胜的 Clowder 成员每人一个，直接存入背包。",
		"方法：胡须法典、锁定的守护者——图腾、竞技场、遗物。图腾的答案在面板上。"
	]
	quest.42000000002705F0.title: "遗迹：封印印记（Relic: Sealmark）"
	quest.42000000002705F1.quest_desc: [
		"坍塌织布机：一个宽六十六格的织布机，其地板是纬纱——当梭子杆落下时，木板条会解开成线桥。",
		"四根磨损的线头和四块围绕虚空纱线的纱线方块。",
		"方法：胡须法典、锁定的守护者——图腾、竞技场、遗物。图腾的答案在面板上。"
	]
	quest.42000000002705F1.title: "图腾：未编织者 (Totem: the Unwoven)"
	quest.42000000002705F2.quest_desc: [
		"五个阶段。每个阶段会引用另外八个机制中的两个，持续三十秒，然后一个梭子条落下，再解开三条带子。在最终形态下，最后四条带子会保留，而变形线是唯一能通往它所在横梁的路。在那里击败它：重织。",
		"方法：使用对应的破旧图腾，然后赢得竞技场。完成此成就即可。"
	]
	quest.42000000002705F2.title: "重新张紧：未编织之物"
	quest.42000000002705F3.quest_desc: [
		"Loomthread：为你的Clowder提供两个额外的Loom Tension，减缓其衰败。Loomthread将你的Clowder束缚在你身边。它是真正Reweave的基石，也是开启两个封印竞技场的关键。",
		"获胜的 Clowder 成员每人一个，直接存入背包。",
		"方法：胡须法典、锁定的守护者——图腾、竞技场、遗物。图腾的答案在面板上。"
	]
	quest.42000000002705F3.title: "遗迹：织布机线 (Loomthread)"
	quest.42000000002705F4.quest_desc: [
		"码头垃圾箱：码头的一角——木板场、晾衣绳上的布单、羊毛篮、红色地毯。",
		"四根磨损的线和四根羊毛围着一个虚空纱线。",
		"方法：胡须法典、锁定的守护者——图腾、竞技场、遗物。图腾的答案在面板上。"
	]
	quest.42000000002705F4.title: "图腾：绒毛傀儡（Totem: the Lint Golem）"
	quest.42000000002705F5.quest_desc: [
		"一场毫无风险的战斗。哥布林会投掷只能短暂致盲的毛球，并躲在洗衣机后；拍打地毯，它会打喷嚏并踉跄。它能传授图腾、竞技场和传送门。",
		"方法：使用对应的破旧图腾，然后赢得竞技场。完成此成就即可。"
	]
	quest.42000000002705F5.title: "重新张紧：Lint Golem（林特傀儡）"
	quest.42000000002705F6.quest_desc: [
		"Lintwisp：免疫仙人掌、浆果和灌木的伤害，不会被推开。Puff会致盲附近的生物以助逃脱。",
		"获胜的 Clowder 成员每人一个，直接存入背包。",
		"方法：胡须法典、锁定的守护者——图腾、竞技场、遗物。图腾的答案在面板上。"
	]
	quest.42000000002705F6.title: "遗迹：Lintwisp（林特威斯）"
	quest.42000000002705F7.quest_desc: [
		"The Knotgarden：一个被四圈带缺口和支路的树篱迷宫环绕的草岛，上面有鹅卵石小径和悬挂的绳结环。",
		"四根磨损的线团和四片叶子环绕着一根虚空纱线。",
		"方法：胡须法典、锁定的守护者——图腾、竞技场、遗物。图腾的答案在面板上。"
	]
	quest.42000000002705F7.title: "图腾：纠缠之木 (Totem: the Tangle)"
	quest.42000000002705F8.quest_desc: [
		"蜘蛛用绳结将路径封死，需三击才能切断，还会咬死胡同里独自一人的玩家。请在迷宫中保持在一起。可选，中后期，一个外观奖励。",
		"方法：使用对应的破旧图腾，然后赢得竞技场。完成此成就即可。"
	]
	quest.42000000002705F8.title: "重新张紧：纠缠之网"
	quest.42000000002705F9.quest_desc: [
		"Knotcharm：在蜘蛛网、灵魂沙、蜂蜜或粉雪上不会减速，在冰上的滑移减半。会缠住第一个命中的生物。",
		"获胜的 Clowder 成员每人一个，直接存入背包。",
		"方法：胡须法典、锁定的守护者——图腾、竞技场、遗物。图腾的答案在面板上。"
	]
	quest.42000000002705F9.title: "遗迹：结符咒（Knotcharm）"
	quest.42000000002705FA.quest_desc: [
		"两座疯狂的竞技场藏在一扇只有 Reweave 才能开启的门后。它们的图腾需要织布机线遗迹在合成台上，并且只会回应一个已经关闭天空的 Clowder。首领是你的十到二十倍大。带上所有人。",
		"方法：将九个Strand全部放置，然后进行Reweave。当天空闭合时，成就会触发。"
	]
	quest.42000000002705FA.title: "被封印的门"
	quest.42000000002705FB.quest_desc: [
		"断绝：一块巨大的黑曜石碎片，被发光的切割线贯穿，二十个世界碎片环绕，空中漂浮着青色的虚空之泪。",
		"围绕织布机残骸的磨损线头和黑曜石；残骸被交还。",
		"方法：胡须法典、锁定的守护者——图腾、竞技场、遗物。图腾的答案在面板上。"
	]
	quest.42000000002705FB.title: "图腾：最初的切割"
	quest.42000000002705FC.quest_desc: [
		"碎片上留下的切口，而非挥砍者的告白。每二十秒，它会在碎片上切出一道线，方块会掉落十五秒；接缝带来速度，但其光束会沿着接缝移动。漂移的碎片会粉碎，虚空裂隙会拉扯，当生命值降至五分之一时，碎片会沿着切口一分为二。仅在重织之后。",
		"方法：使用对应的破旧图腾，然后赢得竞技场。完成此成就即可。"
	]
	quest.42000000002705FC.title: "重新张紧：第一刀切下"
	quest.42000000002705FD.quest_desc: [
		"初切之碎片：可切开防护阶段。同类最佳，仅限通过者持有。",
		"获胜时每只Clowder成员可获得一个，直接存入背包。",
		"方法：胡须法典、锁定的守护者——图腾、竞技场、遗物。图腾的答案在面板上。"
	]
	quest.42000000002705FD.title: "遗迹：第一切割碎片"
	quest.42000000002705FE.quest_desc: [
		"上方的织布机：一个紫晶编织，九个桥串起九个柱台，二十七根大教堂线，通往六十四个方块高的基石。",
		"纺锤线残骸周围有磨损的线和紫晶块；残骸被交还。",
		"方法：胡须法典、锁定的守护者——图腾、竞技场、遗物。图腾的答案在面板上。"
	]
	quest.42000000002705FE.title: "图腾：织网者（Totem: the Overweaver）"
	quest.42000000002705FF.quest_desc: [
		"你修复的织布机反咬一口。织布者将九位守护者的幻影投掷到它们的线束上；杀死一个幻影，其线会绷紧二十五秒，只有那时织布机本身才能被伤害。之后它会投掷三个，再然后是全部九个。",
		"方法：使用对应的破旧图腾，然后赢得竞技场。完成此成就即可。"
	]
	quest.42000000002705FF.title: "重新张紧：织网者（Overweaver）"
	quest.4200000000270600.quest_desc: [
		"Overweaver's Shuttle：集齐了所有Strand遗物的回响，能重塑坠落的Clowder伴侣。",
		"获胜的 Clowder 成员每人一个，直接存入背包。",
		"方法：胡须法典、锁定的守护者——图腾、竞技场、遗物。图腾的答案在面板上。"
	]
	quest.4200000000270600.title: "遗迹：织网者穿梭机"
	quest.42000000002805E3.quest_desc: [
		"野生垫脚兽不会在虚空垫上生成。在门鼓上演奏门之仪式（空手使用，敲击A、S、D、F的节拍）并完成行军。黄雀在草原和芦苇沼泽觅食。高地偏爱宏伟。雪原隐藏着奇妙的等级。余烬荒地守护着火焰鸟。",
		"九族为下一猫群留下了补给。使用管家宝箱可随机开启补给，或用四个小宝箱合成一个中宝箱，或用三个中宝箱合成一个大宝箱。大宝箱能装下更多卷轴和更丰富的补给种类，单独开启则能获得更基础的补给。里面没有机器或进度代币，但每个宝箱都有极小概率开出线团碎片，极小概率开出完整的回归之线，大宝箱的几率更高。",
		"方法：空手使用 Gate Drum 并演奏 Gate Rite：在 A、S、D、F 上敲击下落节拍。成功率为 60% 即可开启；无需 Pulse。请先绑定一个返回指南针。"
	]
	quest.42000000002805E3.title: "通往三月的门户"
	quest.42000000002805E4.quest_desc: [
		"野生吉萨尔生长在芦苇沼泽、草原和高地，沼泽中最为密集。采摘会掉落种子，用锄头破坏三月叶或草地会掉落更多。将种子种植在家里的农田上。",
		"方法：在三月采集野生的吉萨尔（芦苇沼泽最密集）。采集还会掉落种子，在家里的农田上种植它们。"
	]
	quest.42000000002805E4.title: "吉萨尔绿"
	quest.42000000002805E5.quest_desc: [
		"一本书和一片吉萨叶。随处可用：书页会列出你每只鸟的颜色、等级、班级、种族胜利数和最后坚果。",
		"方法：一本书和一只gysahl。随处可用；页面会列出你自己的鸟类。"
	]
	quest.42000000002805E5.title: "奇可宝年鉴"
	quest.42000000002805E6.quest_desc: [
		"喂食 Gysahl 以驯服野生的黄色生物。用皮革、线和铁制作鞍具，然后骑乘。冲刺消耗耐力，松开按键可恢复。",
		"方法：皮革、线和铁。用gysahl驯服野生的黄色生物，然后给它装上鞍。"
	]
	quest.42000000002805E6.title: "奇可宝马鞍"
	quest.42000000002805E7.quest_desc: [
		"时钟周围的金币，还有一个吉萨尔。它能带你往返于胡须风。完成行军后，埃斯特也会出现在克劳德大厅：骑有鞍的鸟去见她，或询问胡须风向导。",
		"方法：用金粒围成一个时钟，中间放一个吉萨尔。用它将时间拨到 Whiskerwind 再拨回来；一只骑乘的鸟会跟你一起走。"
	]
	quest.42000000002805E7.title: "奇可宝怀表"
	quest.42000000002805E8.quest_desc: [
		"手中的鱼饵吸引着野鸟，在田野上勾勒出它们的轮廓。",
		"方法：制作鱼饵。手持鱼饵即可找到三月黄。"
	]
	quest.42000000002805E8.title: "奇可宝诱饵"
	quest.42000000002805E9.quest_desc: [
		"在农田上种植格萨尔种子。家庭菜园是农场发展的起点。",
		"方法：采集野生格萨尔会掉落种子，用锄头破坏草地和三月叶也会掉落。种植在农田上。"
	]
	quest.42000000002805E9.title: "Gysahl 种子"
	quest.42000000002805EA.quest_desc: [
		"给两个异性成年体喂食Carob Nut。两个良好或更好的黄色加上Carob可以孵化出绿色或蓝色。每个亲本需要在C级比赛中赢得五个第一名；合计十六次可确保颜色。一个伟大的绿色和一个伟大的蓝色，各自在B级比赛中赢得八次第一名，可孵化出黑色（失败则为白色；合计二十四次可确保孵化）。",
		"方法：胡须风的坚果保管员 Bilo 出售角豆。A 级比赛也会发放。"
	]
	quest.42000000002805EA.title: "角豆坚果"
	quest.42000000002805EB.quest_desc: [
		"中等梯度的绿色。训练速度、耐力、智力或合作；每种都能让鸟儿心满意足。",
		"方法：在Whiskerwind找Sage Wynn。"
	]
	quest.42000000002805EB.title: "Curiel Green"
	quest.42000000002805EC.quest_desc: [
		"顶部的训练区是绿色的。等鸟吃够了便宜的叶子后，再爬梯子上去。",
		"方法：胡须风的智慧者温恩，或S级赛事奖品。"
	]
	quest.42000000002805EC.title: "丝绸般的绿色"
	quest.42000000002805ED.quest_desc: [
		"没有 Zeio，黄金永远不会孵化。一个 Wonderful Black 加一个 Wonderful Yellow，每个在 A 级比赛中赢得十个第一名（总共三十二个以确保孵化）。",
		"方法：胡须风的坚果保管员 Bilo 出售 Zeio。S 级比赛很少能赢到它。"
	]
	quest.42000000002805ED.title: "Zeio 坚果"
	quest.42000000002805EE.quest_desc: [
		"GP 在赛道上获胜。广场上的所有商品都按标价出售。",
		"方法：在Whiskerwind的竞技场顶部三格放置。骑上带鞍的鸟去Esther处加入。"
	]
	quest.42000000002805EE.title: "GP"
	quest.42000000002805EF.quest_desc: [
		"第一颗交配坚果。天赋随坚果，颜色随父母，除非涉及Carob或Zeio。",
		"方法：胡须风的坚果保管员 Bilo 出售 Pepio。C 级葡萄酒也可以兑换。"
	]
	quest.42000000002805EF.title: "Pepio 坚果"
	quest.42000000002805F0.quest_desc: [
		"两个吉萨尔和骨粉。比普通蔬菜高一级的作物。",
		"合成方式：无定形合成 — 两个 gysahl 和骨粉。"
	]
	quest.42000000002805F0.title: "Krakka Green"
	quest.42000000002805F1.quest_desc: [
		"下一个训练绿。农场运行后可选。",
		"方法：Sage Wynn，或在 JEI 中查找配方。"
	]
	quest.42000000002805F1.title: "Tantal Green"
	quest.42000000002805F2.quest_desc: [
		"另一个训练用的绿色方块。可选的。",
		"方法：广场处的智者温恩 (Sage Wynn) 处。"
	]
	quest.42000000002805F2.title: "帕哈萨纳绿"
	quest.42000000002805F3.quest_desc: [
		"另一个训练用的绿色方块。可选的。",
		"方法：广场处的智者温恩 (Sage Wynn) 处。"
	]
	quest.42000000002805F3.title: "Mimett Green"
	quest.42000000002805F4.quest_desc: [
		"另一个训练用的绿色方块。可选的。",
		"方法：广场处的智者温恩 (Sage Wynn) 处。"
	]
	quest.42000000002805F4.title: "里根·格林"
	quest.42000000002805F5.quest_desc: [
		"一个中等坚果。可选的。",
		"方法：胡须风的坚果保管员 Bilo 出售 Luchile。"
	]
	quest.42000000002805F5.title: "Luchile 坚果"
	quest.42000000002805F6.quest_desc: [
		"一个中等坚果。可选的。",
		"方法：胡须风的坚果保管员 Bilo 出售 Saraha。"
	]
	quest.42000000002805F6.title: "萨拉哈坚果"
	quest.42000000002805F7.quest_desc: [
		"一个中等坚果。可选的。",
		"方法：胡须风的坚果保管员 Bilo 出售 Lasan。"
	]
	quest.42000000002805F7.title: "拉斯安坚果"
	quest.42000000002805F8.quest_desc: [
		"中后期交配用的坚果。可选。坚果保管员 Bilo 出售。",
		"方法：胡须风的坚果保管员 Bilo 出售 Pram。"
	]
	quest.42000000002805F8.title: "Pram Nut"
	quest.42000000002805F9.quest_desc: [
		"Whiskerwind 的集市摊位出售烟花、牵引绳、怀表和 Chocobo 年鉴，售价 GP。",
		"方法：纸加火药。可选的爆发效果。"
	]
	quest.42000000002805F9.title: "绚丽的烟花表演"
	quest.42000000002805FA.quest_desc: [
		"晚期的交配坚果。可选物品。",
		"方法：胡须风的坚果保管员 Bilo 出售 Porov。"
	]
	quest.42000000002805FA.title: "Porov Nut"
	quest.42000000002905FB.quest_desc: [
		"虚空从未培育过帕姆的灌木。用纱网筛土。打破花园，获取干地种子——辣椒、玉米、仙人掌果。",
		"九族为下一窝猫留下了补给。使用管家宝箱可随机开启补给，或用四个小宝箱合成一个中宝箱，或用三个中宝箱合成一个大宝箱。大宝箱能装下更多卷轴和更丰富的补给种类，单独开启则能获得更基础的补给。里面没有机器或进度代币，但每个宝箱都有极小概率开出线团碎片，极小概率开出完整的回归之线，大宝箱的几率更高。",
		"方法：用弦网或更好的筛子（Ex Deorum 或 Voidloom）筛土。"
	]
	quest.42000000002905FB.title: "干旱花园"
	quest.42000000002905FC.quest_desc: [
		"同一种泥土长出不同的作物。打破灌木，种植你需要的作物。",
		"方法：用线网筛子或更好的工具筛掉泥土。"
	]
	quest.42000000002905FC.title: "霜冻花园"
	quest.42000000002905FD.quest_desc: [
		"树叶下的作物。同一个筛子，不同的灌木。",
		"方法：用线网筛子或更好的工具筛掉泥土。"
	]
	quest.42000000002905FD.title: "Shaded Garden"
	quest.42000000002905FE.quest_desc: [
		"湿润的作物。水稻和其他沼泽植物种子都生长在这里。",
		"方法：用线网筛子或更好的工具筛掉泥土。"
	]
	quest.42000000002905FE.title: "潮湿花园"
	quest.42000000002905FF.quest_desc: [
		"温暖的作物。把灌木放在箱子里；种植后它们仍会蔓延。",
		"方法：用线网筛子或更好的工具筛掉泥土。"
	]
	quest.42000000002905FF.title: "热带花园"
	quest.4200000000290600.quest_desc: [
		"六种植物中的最后一种。垫子上的每个HarvestCraft种子都始于这种灌木。",
		"方法：用线网筛子或更好的工具筛掉泥土。"
	]
	quest.4200000000290600.title: "风之花园"
	quest.4200000000290601.quest_desc: [
		"不是农夫之乐板。铜、木棍和木板。在食材入锅前准备好水果和蔬菜。",
		"方法：铜、木棍和木板。不是农夫的欢乐板。"
	]
	quest.4200000000290601.title: "Harvest Board"
	quest.4200000000290602.quest_desc: [
		"汤、炖菜和高汤。铜和一根木棍。每次制作后，锅都会返还。",
		"方法：铜和木棍。每次无配方烹饪后，锅都会返还。"
	]
	quest.4200000000290602.title: "丰收之锅"
	quest.4200000000290603.quest_desc: [
		"平底锅食物。铜和木棍。与Delight煎锅的配方不同；JEI能区分它们。",
		"方法：铜和木棍。与 Delight 的煎锅不同。"
	]
	quest.4200000000290603.title: "收获煎锅 (Harvest Skillet)"
	quest.4200000000290604.quest_desc: [
		"酱汁和浓缩汁。铜和一根木棍。放在锅的旁边。",
		"方法：铜和一根木棍。"
	]
	quest.4200000000290604.title: "炖锅"
	quest.4200000000290605.quest_desc: [
		"陶土环。派、面包，以及任何需要烤箱形状的东西。",
		"方法：在中心空位周围放置八个陶瓦块。"
	]
	quest.4200000000290605.title: "烘焙用具"
	quest.4200000000290606.quest_desc: [
		"木板和木棍。面糊、面团、沙拉。安静的车站。",
		"方法：木板和一根木棍。"
	]
	quest.4200000000290606.title: "混合碗"
	quest.4200000000290607.quest_desc: [
		"陶土。果实入，拳头出。配之以树，而非花园。",
		"方法：陶土。T形排列四块。"
	]
	quest.4200000000290607.title: "榨汁机"
	quest.4200000000290608.quest_desc: [
		"木棍和原木。揉平面团。烘焙用具在等待。",
		"方法：原木两侧各放一根木棍。"
	]
	quest.4200000000290608.title: "擀面杖"
	quest.4200000000290609.quest_desc: [
		"燧石筛中的安山岩卵石，然后是一根木棍。面粉、香料、糊状物。",
		"方法：安山岩（燧石筛土或砾石鹅卵石）和一根木棍。"
	]
	quest.4200000000290609.title: "研磨机"
	quest.420000000029060A.quest_desc: [
		"一个分成八份的水桶。大多数配方需要这个，而不是原版水桶。",
		"方法：一个水桶水 → 八个淡水桶。"
	]
	quest.420000000029060A.title: "淡水"
	quest.420000000029060B.quest_desc: [
		"平台上没有牛。椰子（铁丝网泥土）加淡水，或者之后用牛奶桶分开。",
		"方法：椰子（铁丝网泥土）加淡水，或者倒出半桶牛奶。"
	]
	quest.420000000029060B.title: "新鲜牛奶"
	quest.420000000029060C.quest_desc: [
		"罐子里的水，或是研磨。几乎每种咸味食谱都需要。",
		"方法：锅加水或淡水。锅会返还给你。"
	]
	quest.420000000029060C.title: "盐分"
	quest.420000000029060D.quest_desc: [
		"小麦通过研磨机。面团由此开始。",
		"方法：研磨机加小麦（或其他面粉植物）。研磨机会返还。"
	]
	quest.420000000029060D.title: "面粉"
	quest.420000000029060E.quest_desc: [
		"面粉、盐和淡水。派和面包都共用这一堆。",
		"方法：搅拌碗、面粉、水、盐。"
	]
	quest.420000000029060E.title: "面团"
	quest.420000000029060F.quest_desc: [
		"锅里要放骨头或蔬菜。汤需要一瓶这个，而不是模糊的浓汤。",
		"方法：锅加骨头（Pad-keepers 出售骨头）或剩菜。"
	]
	quest.420000000029060F.title: "库存"
	quest.4200000000290610.quest_desc: [
		"铁丝网泥土。在基座上种植；原版橡木不会掉落帕姆的苹果。",
		"方法：用铁丝网筛泥土获取厨房树苗，然后种出果实。"
	]
	quest.4200000000290610.title: "苹果树"
	quest.4200000000290611.quest_desc: [
		"酸用于敷料和鱼。同一个铁筛子。",
		"方法：用铁丝网筛泥土获取厨房树苗，然后种出果实。"
	]
	quest.4200000000290611.title: "柠檬树"
	quest.4200000000290612.quest_desc: [
		"树皮香料。烘焙和茶品。",
		"方法：用铁丝网筛泥土获取厨房树苗，然后种出果实。"
	]
	quest.4200000000290612.title: "肉桂树"
	quest.4200000000290613.quest_desc: [
		"牛奶、油和热带烹饪。",
		"方法：用铁丝网筛泥土获取厨房树苗，然后种出果实。"
	]
	quest.4200000000290613.title: "椰子树 (Coconut Palm)"
	quest.4200000000290614.quest_desc: [
		"用于制作甜点的豆子。像其他作物一样种植。",
		"方法：用铁丝网筛泥土获取厨房树苗，然后种出果实。"
	]
	quest.4200000000290614.title: "原版藤蔓"
	quest.4200000000290615.quest_desc: [
		"帕姆的苹果树结的普通苹果，比橡树叶掉落得多。榨汁机和烘焙用具都需要这些。",
		"方法：橡木树叶会掉落几个；帕姆的苹果树（铁丝网泥土中的树苗）会结出许多。"
	]
	quest.4200000000290615.title: "帕姆的苹果"
	quest.4200000000290616.quest_desc: [
		"烘焙器具、面团、糖、苹果。首个完成的HarvestCraft烘焙品。",
		"方法：烘焙用具、面团、糖、苹果树上的帕姆苹果。"
	]
	quest.4200000000290616.title: "苹果派（收获）"
	quest.4200000000290617.quest_desc: [
		"Juicer plus 混合水果。一种不是西瓜汁的垫底饮料。",
		"方法：juicer plus 混合水果。"
	]
	quest.4200000000290617.title: "水果宾治"
	quest.4200000000290618.quest_desc: [
		"煎锅、面包、奶酪。在树木生长期间快速享用午餐。",
		"方法：平底锅、面包、黄油和奶酪——全部由淡水、椰奶和面粉制成。"
	]
	quest.4200000000290618.title: "烤奶酪三明治"
	quest.4200000000290619.quest_desc: [
		"干辣椒、番茄、洋葱、豆子、香料叶，还有肉或绢豆腐。食物扩展模组终于派上用场了。",
		"做法：锅、干辣椒、番茄、洋葱、豆子、香料叶，以及肉或绢豆腐。"
	]
	quest.4200000000290619.title: "辣椒碗"
	quest.420000000029061A.quest_desc: [
		"研磨器里的香料，花园里的蔬菜，还有陶器制作。",
		"方法：平底锅、米、椰子、辣椒、黑胡椒、咖喱粉（香料叶+芥末+肉桂）。"
	]
	quest.420000000029061A.title: "咖喱肉排 (Curry Plate)"
	quest.420000000029061B.quest_desc: [
		"面团、酱汁、肉。烘焙食品。一顿完整的HarvestCraft大餐。",
		"方法：烘焙器具、面团、番茄、奶酪、意大利辣香肠（枫糖+大豆制成的猪肉或豆腐培根）。"
	]
	quest.420000000029061B.title: "意大利辣香肠披萨"
	quest.420000000029061C.quest_desc: [
		"湿漉漉的园子、水稻、胡萝卜、洋葱、豌豆和鸡蛋——在鸡出现之前，用绢豆腐代替。",
		"方法：煎锅、湿软花园米饭、胡萝卜、洋葱、豌豆和鸡蛋——绢豆腐算作鸡蛋。"
	]
	quest.420000000029061C.title: "花园炒饭"
	quest.420000000029061D.quest_desc: [
		"茶树叶和香料叶在壶中。遮荫和潮湿的花园覆盖着两者。",
		"方法：锅、茶叶和香料叶。遮荫花园会掉落茶叶和香料。"
	]
	quest.420000000029061D.title: "绿茶"
	quest.420000000029061E.quest_desc: [
		"油和开胃水果。可选配铁丝网笼。",
		"方法：用铁丝网筛泥土获取厨房树苗，然后种出果实。"
	]
	quest.420000000029061E.title: "橄榄树"
	quest.420000000029061F.quest_desc: [
		"果汁和柠檬皮。可选的。",
		"方法：用铁丝网筛泥土获取厨房树苗，然后种出果实。"
	]
	quest.420000000029061F.title: "橙树"
	quest.4200000000290620.quest_desc: [
		"夏季水果。可选物品。",
		"方法：用铁丝网筛泥土获取厨房树苗，然后种出果实。"
	]
	quest.4200000000290620.title: "桃树"
	quest.4200000000290621.quest_desc: [
		"用于研磨机的胡椒。可选物品。",
		"方法：用铁丝网筛泥土获取厨房树苗，然后种出果实。"
	]
	quest.4200000000290621.title: "胡椒树"
	quest.4200000000290622.quest_desc: [
		"煎炸用肥油。可选主食。",
		"方法：在JEI中点击种子或橄榄。可选主食。"
	]
	quest.4200000000290622.title: "烹饪油"
	quest.4200000000290623.quest_desc: [
		"牛奶和盐。可选的主食。",
		"方法：锅加牛奶（椰子淡水牛奶也行）。"
	]
	quest.4200000000290623.title: "黄油"
	quest.4200000000290624.quest_desc: [
		"用榨汁机处理一个鸡蛋。可选步骤。",
		"方法：榨汁机和鸡蛋（绢豆腐也算）。可选。"
	]
	quest.4200000000290624.title: "蛋黄酱（Mayonnaise）"
	quest.4200000000290625.quest_desc: [
		"砧板，混合水果。可选。",
		"方法：砧板和混合水果。可选步骤。"
	]
	quest.4200000000290625.title: "水果沙拉"
	quest.4200000000290626.quest_desc: [
		"意面之夜。可选任务。",
		"方法：花园和果树提供食材。大豆豆腐代替肉类和鸡蛋。JEI会显示工作站名称。"
	]
	quest.4200000000290626.title: "意大利面晚餐"
	quest.4200000000290627.quest_desc: [
		"早餐炫耀。可选的。",
		"方法：花园和果树提供食材。大豆豆腐代替肉类和鸡蛋。JEI会显示工作站名称。"
	]
	quest.4200000000290627.title: "培根煎饼"
	quest.4200000000290628.quest_desc: [
		"铁丝网泥土用于牛油果树苗，然后是煎锅、吐司、盐、大蒜、香料叶。",
		"方法：铁丝网、牛油果树苗，然后是平底锅、吐司、盐、大蒜、香料叶。"
	]
	quest.4200000000290628.title: "牛油果吐司"
	quest.4200000000290629.quest_desc: [
		"不是Delight汉堡。可选的。",
		"方法：花园和果树提供食材。大豆豆腐代替肉类和鸡蛋。JEI会显示工作站名称。"
	]
	quest.4200000000290629.title: "洋葱汉堡包"
	quest.420000000029062A.quest_desc: [
		"榨汁机，苹果。可选物品。",
		"方法：榨汁机和帕姆的苹果。可选。"
	]
	quest.420000000029062A.title: "苹果汁"
	quest.420000000029062B.quest_desc: [
		"煎锅、面包和黄油。可选物品。",
		"方法：煎锅、面包和黄油。可选。"
	]
	quest.420000000029062B.title: "烤面包片"
	quest.42000000002A062C.quest_desc: [
		"四根木棍围成正方形。将它们放在农田上。原版种子种植后会转化——神秘农业的种子则不会。",
		"在同一方块中放入第二组木棍以制作十字作物——它会模仿旁边成熟作物的空位。在四周放置亲本作物，几分钟内就会自行播种；在十字上撒骨粉可立即尝试。",
		"九族为下一猫群留下了补给。使用管家宝箱可随机开启补给，或用四个小宝箱合成一个中宝箱，或用三个中宝箱合成一个大宝箱。大宝箱能装下更多卷轴和更丰富的补给种类，单独开启则能获得更基础的补给。里面没有机器或进度代币，但每个宝箱都有极小概率开出线团碎片，极小概率开出完整的回归之线，大宝箱的几率更高。",
		"方法：四个木棍围成正方形。放置在农田上，然后种下种子。"
	]
	quest.42000000002A062C.title: "木制作物棒"
	quest.42000000002A062D.quest_desc: [
		"一本可编辑的书（书、墨囊、羽毛）加上小麦种子。将其留在分析仪中。",
		"方法：可写书（书、墨囊、羽毛）加小麦种子。木炭加玻璃瓶可制作墨水。"
	]
	quest.42000000002A062D.title: "作物日志"
	quest.42000000002A062E.quest_desc: [
		"玻璃板和木棍。查看作物可读取生长、增益和强度，无需采摘。",
		"方法：木棍之间放玻璃板，再放木棍手柄。看向已种植的作物。"
	]
	quest.42000000002A062E.title: "放大镜"
	quest.42000000002A062F.quest_desc: [
		"玻璃、石板、木板、木棍。把种子和日志放在一起。繁殖就会显现出来。",
		"繁殖力是驱动杂交的指标：新种子初始值为1/10，每增加一点，植物被选为亲本的概率就提高。分析、重植最好的，杂交速度就会加快。",
		"方法：玻璃板、石板、木板和木棍。放置日志，然后放置种子。"
	]
	quest.42000000002A062F.title: "种子分析器"
	quest.42000000002A0630.quest_desc: [
		"本整合包里没有杂草，但耙子仍能清理木棍。还是带一个吧。",
		"方法：木栅栏加木棍。杂草已清除，但仍需木棍。"
	]
	quest.42000000002A0630.title: "木制耙子"
	quest.42000000002A0631.quest_desc: [
		"捡起一株植物再放下，保持其属性不变。移动一个 10-10 而不破坏它。",
		"方法：两个铁锭和一个木棍。捡起植物并保留其属性。"
	]
	quest.42000000002A0631.title: "铁锹"
	quest.42000000002A0632.quest_desc: [
		"采集成熟植物的产物并重置它。花朵和一些HarvestCraft作物。",
		"方法：剪刀、铁锭和木棍。剪下成熟的植物并重置它。"
	]
	quest.42000000002A0632.title: "剪报员"
	quest.42000000002A0633.quest_desc: [
		"携带一个繁殖线。用分析仪填充，然后用木棍倒出。",
		"方法：皮革和线。从分析仪中填充。"
	]
	quest.42000000002A0633.title: "种子袋"
	quest.42000000002A0634.quest_desc: [
		"更结实的木棍。种植规则相同，碰撞时更省心。",
		"方法：两列铁粒可合成八个铁锭。"
	]
	quest.42000000002A0634.title: "铁质作物棒 (Iron Crop Sticks)"
	quest.42000000002A0635.quest_desc: [
		"更好的耙子。即使杂草都除完了，这个习惯还是改不掉。",
		"方法：铁栏杆加一根木棍。"
	]
	quest.42000000002A0635.title: "铁质耙子"
	quest.42000000002A0636.quest_desc: [
		"为渠道蓄水。一个每天早上都不用提桶的农场。",
		"方法：木板。用水填充渠道。"
	]
	quest.42000000002A0636.title: "灌溉水箱"
	quest.42000000002A0637.quest_desc: [
		"将水从水箱沿着田垄引过去。作物从沟渠里喝水，而不是你。",
		"方法：使用储罐进行无定形合成——一个储罐可合成八个通道。"
	]
	quest.42000000002A0637.title: "灌溉渠道"
	quest.42000000002A0638.quest_desc: [
		"停止并启动一条线路，不要中断坦克的运行。",
		"方法：铁栏杆、红色染料和一个铁锭。在不破坏坦克的情况下，停止并启动一条线。"
	]
	quest.42000000002A0638.title: "通道阀门"
	quest.42000000002A0639.quest_desc: [
		"在方块上放置雨。把它放在木棍上方的通道上。",
		"方法：把它放在木棍上方的通道上。JEI会显示配方名称。"
	]
	quest.42000000002A0639.title: "洒水器"
	quest.42000000002A063A.quest_desc: [
		"覆盖一个通道，这样你就可以沿着行走了。",
		"方法：覆盖一个通道，这样你就可以沿着水道行走了。"
	]
	quest.42000000002A063A.title: "排水沟格栅"
	quest.42000000002A063B.quest_desc: [
		"观察环境。光线、湿度、作物停滞的原因。",
		"方法：合成，然后放置在房间内以读取光线和湿度。"
	]
	quest.42000000002A063B.title: "温室监测器"
	quest.42000000002A063C.quest_desc: [
		"晚熟的木棍。防火、固执，适合那些对木材要求极高的植物。相邻的两株成熟作物可以杂交。",
		"方法：两列黑曜石可合成八个。相邻的两株成熟作物可以杂交。"
	]
	quest.42000000002A063C.title: "黑曜石作物棒"
	quest.42000000002A063D.quest_desc: [
		"一个可以行走的通道。可选的。",
		"方法：一条可以行走的通道。可选。"
	]
	quest.42000000002A063D.title: "中空的通道"
	quest.42000000002A063E.quest_desc: [
		"矿石作物会掉落这些。可选的繁殖路线。",
		"方法：木棍制作木制作物棒；日志本是可写书籍加种子；分析仪是玻璃和木头。种植在农田上。"
	]
	quest.42000000002A063E.title: "铜粒作物"
	quest.42000000002A063F.quest_desc: [
		"用木棍制作石英。可选步骤。",
		"方法：木棍制作木制作物棒；日志本是可写书籍加种子；分析仪是玻璃和木头。种植在农田上。"
	]
	quest.42000000002A063F.title: "石英碎片作物"
	quest.42000000002A0640.quest_desc: [
		"作物燃料。可选。",
		"方法：木棍制作木制作物棒；日志本是可写书籍加种子；分析仪是玻璃和木头。种植在农田上。"
	]
	quest.42000000002A0640.title: "煤炭鹅卵石"
	quest.42000000002A0641.quest_desc: [
		"晚期矿石作物。可选任务。",
		"方法：木棍制作木制作物棒；日志本是可写书籍加种子；分析仪是玻璃和木头。种植在农田上。"
	]
	quest.42000000002A0641.title: "翡翠碎片作物"
	quest.42000000002A0642.quest_desc: [
		"晚期矿石作物。可选任务。",
		"方法：木棍制作木制作物棒；日志本是可写书籍加种子；分析仪是玻璃和木头。种植在农田上。"
	]
	quest.42000000002A0642.title: "钻石碎片作物"
	quest.42000000002A0643.quest_desc: [
		"峰值矿石作物。可选且缓慢。",
		"方法：木棍制作木制作物棒；日志本是可写书籍加种子；分析仪是玻璃和木头。种植在农田上。"
	]
	quest.42000000002A0643.title: "下界合金碎片"
	quest.42000000002A0644.quest_desc: [
		"AgriCraft 自己的花朵。可选的。",
		"方法：木棍制作木制作物棒；日志本是可写书籍加种子；分析仪是玻璃和木头。种植在农田上。"
	]
	quest.42000000002A0644.title: "阿玛西莉斯花瓣"
	reward.5000000000060135.title: "回归之线：+1 猫群生命"
	reward.5000000000080193.title: "回归之线：+1 猫群生命"
	reward.50000000000901CC.title: "回归之线：+1 猫群生命"
	reward.5000000000170337.title: "回归之线：+1 猫群生命"
	reward.50000000002004DD.title: "回归之线：+1 猫群生命"
	reward.5000000000220581.title: "回归之线：+1 猫群生命"
	reward.7200000000000101.title: "回归之线：+1 猫群生命（右键消耗）"
	reward.7200000000000102.title: "守夜人补给（四卷）"
	reward.7200000000000201.title: "回归之线：+1 猫群生命（右键消耗）"
	reward.7200000000000202.title: "Grit-singers' provisions (four rolls)"
	reward.7200000000000301.title: "回归之线：+1 猫群生命（右键消耗）"
	reward.7200000000000302.title: "Rootbinders 的补给品（四卷）"
	reward.7200000000000401.title: "回归之线：+1 猫群生命（右键消耗）"
	reward.7200000000000402.title: "边缘行者补给（四份）"
	reward.7200000000000501.title: "回归之线：+1 猫群生命（右键消耗）"
	reward.7200000000000502.title: "鼓心部落的补给（四份）"
	reward.7200000000000601.title: "回归之线：+1 猫群生命（右键消耗）"
	reward.7200000000000602.title: "织纹者的补给品（四卷）"
	reward.7200000000000701.title: "回归之线：+1 猫群生命（右键消耗）"
	reward.7200000000000702.title: "殖民地管理员的补给（四卷）"
	reward.7200000000000801.title: "回归之线：+1 猫群生命（右键消耗）"
	reward.7200000000000802.title: "海豹雕刻者的口粮（四卷）"
	reward.7200000000000901.title: "回归之线：+1 猫群生命（右键消耗）"
	reward.7200000000000902.title: "织布工的口粮（四卷）"
	reward.7200000000000A01.title: "九族部落的补给品（四份）"
	reward_table.7100000000000001.title: "垫石守护者的馈赠"
	reward_table.7100000000000002.title: "坚韧之歌者的馈赠"
	reward_table.7100000000000003.title: "根缚者的馈赠"
	reward_table.7100000000000004.title: "边缘行者之礼"
	reward_table.7100000000000005.title: "鼓心之人的馈赠"
	reward_table.7100000000000006.title: "织纹者的馈赠"
	reward_table.7100000000000007.title: "来自殖民者的馈赠-keepers"
	reward_table.7100000000000008.title: "印章雕刻者的馈赠"
	reward_table.7100000000000009.title: "织布匠的馈赠 (Gift of the Loom-stitchers)"
	reward_table.710000000000000A.title: "九部落的馈赠"
	chapter.310000000000002B.chapter_subtitle: [
		"旧世界的碎片正飘向你的平台。在它们消散前，快去抓住它们。"
	]
	chapter.310000000000002B.title: "漂流残骸"
	quest.42000000002B0801.quest_desc: [
		"土壤被张紧后，旧世界的碎片会不时漂到你的平台上，并挂住你的纬纱。管家会通知整个猫群当碎片到来时。",
		"它们不会停留：残骸会保留一段时间，直到你的 Clowder 下线，然后便会消散于虚空。没有人会坠落，你获得的任何东西也不会丢失。"
	]
	quest.42000000002B0801.title: "有东西在飘荡着，若隐若现"
	quest.42000000002B0802.quest_desc: [
		"站在平台边缘，面向残骸并使用牵引卷轴：一座绳索桥会自行铺展开来，你可以分步攀爬过去。",
		"坠落时被线接住，可获得三颗心。虚空是风景，而非惩罚。"
	]
	quest.42000000002B0802.title: "穿越虚空"
	quest.42000000002B0803.quest_desc: [
		"每个残骸都要求一件事：打开它的心之箱，破坏它的生成器，重接它的支柱，沿着回声走回家，或是守住接缝。",
		"完成它，所有踏上它的人都会得到 Salvaged Weft 和一枚 Seal。Salvager's Frame 能将 Weft 制成线轴、鱼饵、钥匙和装饰品。"
	]
	quest.42000000002B0803.title: "打捞物资"
	quest.42000000002B0804.quest_desc: [
		"残骸图集会记录你完成的每个部落地点：六种地点的九个分支。填满一列、一行或每个印章，都能获得永久的小幅增益。",
		"书页在Codex中带有背景故事。在宝箱中找到的提示页可以打开隐藏房间。打开Wreck Atlas来标记此项。"
	]
	quest.42000000002B0804.title: "《阿特拉斯》"
	quest.42000000002B0805.quest_desc: [
		"带回五个漂流残骸：由你猫群中的任意成员完成五个残骸。",
		"可重复：可以多次提交以获得奖励。",
		"方法：完成一次 Driftwreck 的任务。所有踏上它的人都会获得一枚 Seal。"
	]
	quest.42000000002B0805.title: "五个封印"
	quest.42000000002B0806.quest_desc: [
		"打破三个磨损的刷怪器，并上交它们的内核。",
		"可重复：可以多次提交以获得奖励。",
		"方法：在残骸上打破一个磨损的刷怪器；每个都会掉落其核心。"
	]
	quest.42000000002B0806.title: "磨损的核心"
	quest.42000000002B0807.quest_desc: [
		"一块修复过的残骸碎片。把它交上来。",
		"可重复：可以多次提交以获得奖励。",
		"方法：用纬线钥匙打开封印的裂隙，修复里面的残骸。"
	]
	quest.42000000002B0807.title: "裂隙碎片"
	quest.42000000002B0808.quest_desc: [
		"每个Strand的核心。该部落的诱饵半价，残骸掉落更频繁，旗帜也归你所有。"
	]
	quest.42000000002B0808.title: "一整列方块"
	quest.42000000002B0809.quest_desc: [
		"九个部落中唯一存在的地方。它的隐藏房间现已全部开放。"
	]
	quest.42000000002B0809.title: "一整排的物品"
	quest.42000000002B080A.quest_desc: [
		"完成每种修饰器的残骸。你的残骸能多存四分之一。"
	]
	quest.42000000002B080A.title: "六个印章"
	quest.42000000002B080B.quest_desc: [
		"二十五页内容已填写完毕。"
	]
	quest.42000000002B080B.title: "半个地图册 (Half the Atlas)"
	quest.42000000002B080C.quest_desc: [
		"用织布钥匙切开残骸的锁链，就能打开要塞的封印裂隙。里面有个长着守护者形状的小东西，看起来破旧不堪。"
	]
	quest.42000000002B080C.title: "进入裂隙之中"
	quest.42000000002B080D.quest_desc: [
		"修复所有九个残片。织布钥匙半价出售。"
	]
	quest.42000000002B080D.title: "每个残骸生物都会掉落一个残骸碎片。"
	quest.42000000002B080E.quest_desc: [
		"全部五十四页。在某个天空之下，旧世界的心脏正朝你飘来。"
	]
	quest.42000000002B080E.title: "每一页都包含一个物品，物品名称和配方会显示在物品栏中。"
	quest.42000000002B080F.quest_desc: [
		"站在旧世界的中心，重新编织它。机会只有一次。"
	]
	quest.42000000002B080F.title: "编织之心"
}
