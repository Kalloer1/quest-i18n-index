		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000001D0483.title: "模式提供者（网络）"
	quest.42000000001D0484.quest_desc: [
		"按照存储的图案组装已制作的物品。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000001D0484.title: "分子组装器（网络版）"
	quest.42000000001D0485.quest_desc: [
		"网络在合成时使用的内存块。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000001D0485.title: "合成单元（网络）"
	quest.42000000001D0486.quest_desc: [
		"加速网络中正在运行的一个合成任务。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000001D0486.title: "合成加速器"
	quest.42000000001D0487.quest_desc: [
		"为合成单位添加了合成记忆功能。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000001D0487.title: "1k Craft Storage"
	quest.42000000001D0488.quest_desc: [
		"更大的任务需要更多的合成内存。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000001D0488.title: "4k Craft Storage"
	quest.42000000001D0489.quest_desc: [
		"一块严肃的合成记忆方块。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000001D0489.title: "16k 工艺储物箱"
	quest.42000000001D048A.quest_desc: [
		"网络最大规模工作的合成内存已足够。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000001D048A.title: "64k 工艺存储"
	quest.42000000001D048B.quest_desc: [
		"存档级合成记忆，很少需要，但需要时就在。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000001D048B.title: "256k 工艺存储"
	quest.42000000001D048C.quest_desc: [
