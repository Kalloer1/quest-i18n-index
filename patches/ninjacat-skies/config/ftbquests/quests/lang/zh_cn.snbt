	]
	chapter.3100000000000001.title: "主题：土壤"
	chapter.3100000000000002.chapter_subtitle: [
		"恢复 — 将坠落的世界拉回物质之中。"
	]
	chapter.3100000000000002.title: "主题：石头"
	chapter.3100000000000003.chapter_subtitle: [
		"根部 — 生长锚点，防止衬垫继续磨损。"
	]
	chapter.3100000000000003.title: "分支：发芽（Sprout）"
	chapter.3100000000000004.chapter_subtitle: [
		"边缘 — 整理好装备，故意离开平台。"
	]
	chapter.3100000000000004.title: "任务系列：爪痕 (Claw)"
	chapter.3100000000000005.chapter_subtitle: [
		"嗯——在电线之前，先有节奏和脉搏。"
	]
	chapter.3100000000000005.title: "任务系列：火花"
	chapter.3100000000000006.chapter_subtitle: [
		"模式——一首自我承载的歌曲，即一座工厂。"
	]
	chapter.3100000000000006.title: "任务系列：时钟"
	chapter.3100000000000007.chapter_subtitle: [
		"殖民地——维持一个能维持另一个生物生存的生物。"
	]
	chapter.3100000000000007.title: "任务系列：蜂群"
	chapter.3100000000000008.chapter_subtitle: [
		"绑定 — 将封印、仪式和两条编织路径系于一根绳上。"
	]
	chapter.3100000000000008.title: "任务系列：Sigil（符文）"
	chapter.3100000000000009.chapter_subtitle: [
		"重织 — 数字织布机，三月，碎片。"
	]
	chapter.3100000000000009.title: "任务系列：纺锤锭"
