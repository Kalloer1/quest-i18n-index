		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000001D048C.title: "等级发射器（网络）"
	quest.42000000001D048D.quest_desc: [
		"将网络中的方块放置到世界中。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000001D048D.title: "Formation Plane (Network)"
	quest.42000000001D048E.quest_desc: [
		"破坏方块并将掉落物吸入网络。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000001D048E.title: "湮灭平面（网络）"
	quest.42000000001D048F.quest_desc: [
		"在电缆中断处承载一个网络通道。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000001D048F.title: "P2P 隧道"
	quest.42000000001D0490.quest_desc: [
		"将一小块空间折叠成一个便携的单元格。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000001D0490.title: "Spatial 2"
	quest.42000000001D0491.quest_desc: [
		"只要有增幅器在附近，就能从任何地方浏览网络的存储内容。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000001D0491.title: "无线终端 (网络)"
	quest.42000000001D0492.quest_desc: [
		"无需返回终端，即可通过网络进行合成。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000001D0492.title: "无线工艺 (Wireless Craft)"
	quest.42000000001D0493.quest_desc: [
		"火球需要蓄力，在需要之前先准备好。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000001D0493.title: "物质加农炮"
	quest.42000000001D0494.quest_desc: [
		"用于控制器外壳和电缆走线的清晰方块。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000001D0494.title: "石英玻璃"
	quest.42000000001D0495.quest_desc: [
		"能自己发光的玻璃，不需要火把。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000001D0495.title: "石英 鲜艳"
	quest.42000000001D0496.quest_desc: [
		"坚固的存储方块，四颗晶体凝聚为一。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000001D0496.title: "Fluix 方块"
	quest.42000000001D0497.quest_desc: [
		"将存储单元划分为几个较小的池子。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000001D0497.title: "单元格工作台"
	quest.42000000001E0498.quest_desc: [
		"黏土和骨粉，迈向瓷质工具的一步。",
		"九族为下一猫群留下了补给。使用管家宝箱可随机开启补给，或用四个小宝箱合成一个中宝箱，或用三个中宝箱合成一个大宝箱。大宝箱能装下更多卷轴和更丰富的补给种类，单独开启则能获得更基础的补给。里面没有机器或进度代币，但每个宝箱都有极小概率开出线团碎片，极小概率开出完整的回归之线，大宝箱的几率更高。",
		"配方：黏土球 + 骨粉，无需特定顺序。黏土来自张力桶。"
	]
	quest.42000000001E0498.title: "Porcelain Clay (虚空工艺)"
	quest.42000000001E0499.quest_desc: [
		"更轻的桶，更适合早期拮据的预算。",
		"方法：将瓷土塑造成未烧制的桶，然后将其冶炼。"
	]
	quest.42000000001E0499.title: "Porcelain Bucket"
	quest.42000000001E049A.quest_desc: [
		"在火焰上融化方块，使其变为液体。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000001E049A.title: "Porcelain Crucible (虚空工艺)"
	quest.42000000001E049B.quest_desc: [
		"第一张筛网；速度慢，但能用。",
		"方法：3x3 排列九个线。Grit-singers' stall 出售 Voidloom 线网，可以筛选出同样的线。"
	]
	quest.42000000001E049B.title: "字符串 Mesh (虚空工艺)"
	quest.42000000001E049C.quest_desc: [
		"比线筛得更快，升级值得了。",
		"方法：棋盘格中放四个燧石和五个线。燧石是砾石，或是线+砾石。"
	]
	quest.42000000001E049C.title: "燧石网格 (虚空工艺)"
	quest.42000000001E049D.quest_desc: [
		"坚固的中间筛网，适合稳定筛分。",
		"方法：棋盘上放置四个铁锭和五个线。没有摊位出售。"
	]
	quest.42000000001E049D.title: "铁质网格 (虚空工艺)"
	quest.42000000001E049E.quest_desc: [
		"掉落物比铁意志更稀有。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000001E049E.title: "黄金网格 (虚空工艺)"
	quest.42000000001E049F.quest_desc: [
		"筛子速度足够快，能保持漏斗链的持续供应。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000001E049F.title: "钻石网格 (虚空工艺)"
	quest.42000000001E04A0.quest_desc: [
		"筛子所能容纳的最佳网格。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000001E04A0.title: "下界合金网格 (虚空工艺)"
	quest.42000000001E04A1.quest_desc: [
		"由纺锤纺成的，织布机自身的纤维。",
		"方法：四根线 → 两根毛线。张力桶：线 + 珍珠。四根织布机绒毛。"
	]
	quest.42000000001E04A1.title: "虚空纱线库存"
	quest.42000000001E04A2.quest_desc: [
		"织布机的软门：支柱、压杆和控制器都需要一个。",
		"方法：将虚空纱线环绕在史莱姆球周围。"
	]
	quest.42000000001E04A2.title: "绑定绳库存 (Binding Knot Stock)"
	quest.42000000001E04A3.quest_desc: [
		"虚空织机版的基础筛网结构。",
		"方法：用线把字符串缠起来。Grit-singers的摊位有卖。"
	]
	quest.42000000001E04A3.title: "线网编织线"
	quest.42000000001E04A4.quest_desc: [
		"虚空织布机网格，比普通线更胜一筹。",
		"方法：用打火石围绕一根线编织成网。"
	]
	quest.42000000001E04A4.title: "线状网格燧石"
	quest.42000000001E04A5.quest_desc: [
		"专为稳定输出而建造的虚空织机网格。",
		"方法：用铁围绕火打石线网。线束从这里开始。"
	]
	quest.42000000001E04A5.title: "铁线网格 (Thread Mesh Iron)"
	quest.42000000001E04A6.quest_desc: [
		"将粗砾进一步粉碎：鹅卵石成碎石，碎石成沙，沙成沙粉。",
		"方法：鹅卵石 + 木棍。将砂砾分解成碎石、沙子、粉尘。"
	]
	quest.42000000001E04A6.title: "纺锤锤 (虚空工艺)"
	quest.42000000001E04A7.quest_desc: [
		"剥下树叶以获取树苗和蚕。",
		"方法：四根木棍。Grit-singers的摊位出售一根。"
	]
	quest.42000000001E04A7.title: "纺锤钩（Spindle Crook）"
	quest.42000000001E04A8.quest_desc: [
		"织布机的筛网框架：在上面绷紧一张网，然后喂入沙砾。",
		"方法：用木板围住一个绑定结。拉伸网格，倒入漏斗沙砾，再放在漏斗上。"
	]
	quest.42000000001E04A8.title: "织布机框架"
	quest.42000000001E04A9.quest_desc: [
		"水和泥土变成黏土；线和珍珠变成毛线。",
		"方法：木板、线和虚空纱。倒入水（桶会返还），加入泥土→黏土。"
	]
	quest.42000000001E04A9.title: "张力桶 (虚空工艺)"
	quest.42000000001E04AA.quest_desc: [
		"九块泥土折叠成一块，用于向上攀爬。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000001E04AA.title: "压缩泥土"
	quest.42000000001E04AB.quest_desc: [
		"九块紧密的鹅卵石，廉价又无穷无尽。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000001E04AB.title: "压缩鹅卵石 (虚空工艺)"
	quest.42000000001E04AC.quest_desc: [
		"九份砾石被压实；一个压缩筛将其全部容纳。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000001E04AC.title: "压缩砾石"
	quest.42000000001E04AD.quest_desc: [
		"九个沙块压缩成一个，方便运输。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000001E04AD.title: "压缩沙土"
	quest.42000000001E04AE.quest_desc: [
		"九个尘埃块因同样的原因被压了下去。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000001E04AE.title: "压缩粉尘"
	quest.42000000001E04AF.quest_desc: [
		"下界石被压缩，以减轻背包负担。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000001E04AF.title: "压缩的下界岩"
	quest.42000000001E04B0.quest_desc: [
		"压实末石，当虚空需要填饱时很有用。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000001E04B0.title: "压缩的末地石"
	quest.42000000001E04B1.quest_desc: [
		"深层板岩压实九比一，仍然是石头。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000001E04B1.title: "压缩深板岩"
	quest.42000000001E04B2.quest_desc: [
		"一次性粉碎一整组压缩方块。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000001E04B2.title: "压缩锤 (Compressed Hammer)"
	quest.42000000001E04B3.quest_desc: [
		"用于破坏压缩块的较弱锤子。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000001E04B3.title: "压缩铁锤"
	quest.42000000001E04B4.quest_desc: [
		"一个宽筛子，一次处理几堆砾石。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000001E04B4.title: "压缩筛子 (虚空工艺)"
	quest.42000000001E04B5.quest_desc: [
		"和橡木一样，只是谷物种类不同。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000001E04B5.title: "桦木筛子"
	quest.42000000001E04B6.quest_desc: [
		"发酵方式与其他任何桶相同。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000001E04B6.title: "桦木桶"
	quest.42000000001E04B7.quest_desc: [
		"与其他任何熔炉一样，可以熔炼方块。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000001E04B7.title: "桦木熔炉"
	quest.42000000001E04B8.quest_desc: [
		"沙滩的货币；赚取它，花费它，切勿浪费。",
		"获取方式：任务奖励、织布机上的燧石网格泥土、管家储藏箱。"
	]
	quest.42000000001E04B8.title: "磨损的线库存 (Frayed Thread Stock)"
	quest.42000000001E04B9.quest_desc: [
		"存档页面和笔记。",
		"方法：在邮局或/clowder hub的封蜡匠摊位放置一个Strand（8个Thread）。右键阅读；它们会保留，不会被消耗。"
	]
	quest.42000000001E04B9.title: "Codex Pages"
	quest.42000000001E04BA.quest_desc: [
		"右键打开“从这里开始”。Grave (`)：任务列表。该书籍不分配任务。",
		"方法：新手包/船坞箱。右键书籍；Grave (`) 是任务列表。"
	]
	quest.42000000001E04BA.title: "胡须典籍"
	quest.42000000001F04BB.quest_desc: [
		"包裹内部、密封前的那张纸。",
		"九族为下一窝猫留下了补给。使用管家宝箱可随机开启补给，或用四个小宝箱合成一个中宝箱，或用三个中宝箱合成一个大宝箱。大宝箱能装下更多卷轴和更丰富的补给种类，单独开启则能获得更基础的补给。里面没有机器或进度代币，但每个宝箱都有极小概率开出线团碎片，极小概率开出完整的回归之线，大宝箱的几率更高。",
		"方法：在末影之眼周围放置金锭和木板。首次包装自动合成。"
	]
	quest.42000000001F04BB.title: "整合包组件"
	quest.42000000001F04BC.quest_desc: [
