	quest.420000000018035C.title: "Imperium Accel"
	quest.420000000018035D.quest_desc: [
		"能建造的加速精华中最快的一种。",
		"方法：在JEI中用神秘农业合成。Inferium和Prosperity来自筛子；种子在Infusion Altar上灌注。"
