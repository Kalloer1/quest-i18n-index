	quest.42000000001F04C3.quest_desc: [
		"标记一个配送中心可以派送包裹的目的地。",
		"方法：组件，然后是 Packager / Encoder。ME 部件需要 AE2 网络。"
	]
	quest.42000000001F04C3.title: "分配器标记"
	quest.42000000001F04C4.quest_desc: [
		"将完成的包裹送入传送带以供拾取。",
		"方法：组件，然后是 Packager / Encoder。ME 部件需要 AE2 网络。"
	]
	quest.42000000001F04C4.title: "包装提供者"
	quest.42000000001F04C5.quest_desc: [
		"改为通过此方块向远处的工匠发出请求。",
		"方法：Proxy Marker、Packaging Component、两个 Shulker Shells、两个 ender pearls、两个 crying obsidian 和一个铁块。外壳：pack recipe、六个 purpur blocks、两个 ender pearls 和一个 Binding Knot。"
	]
