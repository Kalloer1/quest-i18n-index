	chapter.3100000000000022.title: "部落编织物"
	chapter.3100000000000023.chapter_subtitle: [
		"Grit-singers 能以百种方式切割一块石头。"
	]
	chapter.3100000000000023.title: "石匠"
	chapter.3100000000000024.chapter_subtitle: [
		"在没有椅子放上去之前，踏板就是一个边缘。"
	]
	chapter.3100000000000024.title: "家具陈设"
	chapter.3100000000000025.chapter_subtitle: [
		"管家们留下的那些小机器。"
	]
	chapter.3100000000000025.title: "小型管家服务"
	chapter.3100000000000026.chapter_subtitle: [
		"鼓心脉学会了在铜中奔跑。"
	]
	chapter.3100000000000026.title: "当前任务：收集 10 个铁锭，并在熔炉中将其熔炼成铁块。完成后，将铁块放置在地面上。"
	chapter.3100000000000027.chapter_subtitle: [
		"十三位守护者被切断。通过击败其守卫来重新绷紧每一根弦。"
	]
	chapter.3100000000000027.title: "被定住的守卫者"
	chapter.3100000000000028.chapter_subtitle: [
		"参加游行。驯服一只黄色的。埃丝特会在你到访大厅后在那里等你。"
	]
	chapter.3100000000000028.title: "垫脚者（Pad-runners）"
	chapter.3100000000000029.chapter_subtitle: [
		"从筛子中培育花园。烹饪虚空之垫从未生长之物。"
	]
	chapter.3100000000000029.title: "收获台"
	chapter.310000000000002A.chapter_subtitle: [
		"作物棒、属性、灌溉。杂草在边缘处不会生长。"
	]
	chapter.310000000000002A.title: "作物种植棒"
	chapter_group.2100000000000001.title: "天际翱翔"
	chapter_group.2100000000000002.title: "Craft and Tension"
	chapter_group.2100000000000003.title: "重新编织"
	chapter_group.2100000000000004.title: "侧边小径"
	file.0000000000000001.title: "Ninjacat Skies"
	quest.4200000000018001.quest_desc: [
		"你在一处悬崖上醒来。看看下面的掉落，然后点击这个。",
		"Grave (`) 是任务列表。Whisker Codex 是起点。",
		"方法：点击任务。然后打橡树。"
	]
	quest.4200000000018001.title: "看看掉落物是什么"
	quest.4200000000010001.quest_desc: [
		"你已被束缚于天际。这就是未能坠落之物。",
		"八根原木。从树开始；一切始于你。",
		"九族为下一窝猫留下了补给。使用管家宝箱可随机开启补给，或用四个小宝箱合成一个中宝箱，或用三个中宝箱合成一个大宝箱。大宝箱能装下更多卷轴和更丰富的补给种类，单独开启则能获得更基础的补给。里面没有机器或进度代币，但每个宝箱都有极小概率开出线团碎片，极小概率开出完整的回归之线，大宝箱的几率更高。",
		"方法：用拳头打你脚下的橡木。八根原木会唤醒它。"
	]
	quest.4200000000010001.title: "在软垫上醒来"
	quest.4200000000010002.quest_desc: [
		"泥土是地毯对你靴子许下的承诺。",
		"十六个方块。拓宽承诺的边界。",
		"方法：新手箱、鹅卵石+线槽、筛子余料，或/clowder hub（Pad-keepers）。"
	]
	quest.4200000000010002.title: "可供站立之物"
	quest.4200000000010003.quest_desc: [
		"手需要一块表面。此后的所有东西都是表面。",
		"方法：四个木板围成一个正方形。"
	]
	quest.4200000000010003.title: "制作一张工作台"
	quest.4200000000010004.quest_desc: [
		"爪子的事以后再说。眼下，先对付会咬人的木头。",
		"方法：三块木板和两根木棍。"
	]
	quest.4200000000010004.title: "木制镐子"
	quest.4200000000010005.quest_desc: [
		"绿色对抗掉落物。",
		"在你感到饥饿之前把它种下去。",
		"方法：破坏橡木树叶，或使用/clowder hub Rootbinders（8根线换4个）。"
	]
	quest.4200000000010005.title: "第一棵树苗"
	quest.4200000000010006.quest_desc: [
		"六十四块木板铺成的平台，才不再像一块悬空的小平台。",
		"方法：合成网格中一个原木可制作四个。"
	]
	quest.4200000000010006.title: "木板库存"
	quest.4200000000010007.quest_desc: [
		"手柄、框架、工具的骨骼结构。",
		"方法：将两块木板垂直放置。"
	]
	quest.4200000000010007.title: "木棍束"
	quest.4200000000010008.quest_desc: [
		"把东西放在该放的地方。猫群会先共享一个箱子，再共享其他东西。",
		"方法：在空中心周围放置八个木板。"
	]
	quest.4200000000010008.title: "猫群专用箱子"
	quest.4200000000010009.quest_desc: [
		"在边缘发现你之前，先发现边缘。",
		"方法：木棍加煤炭或木炭。/clowder hub Kin 会出售一包。"
	]
	quest.4200000000010009.title: "火把线路"
	quest.420000000001000A.quest_desc: [
		"冰和岩浆在原本没有石头的地方创造了石头。",
		"普通和困难模式都会发货。在/clowder hub的垫子管理员那里可以买到水桶。",
		"方法：岩浆和水（或融化的冰）相邻。用铁锤砸石头。/clowder hub Grit-singers' stall 出售一捆。"
	]
	quest.420000000001000A.title: "Cobble Cache"
	quest.420000000001000B.quest_desc: [
		"尚未成为火花的那份温暖。",
		"垫石守护者会称此为壁炉。",
		"方法：在空中心周围放置八个鹅卵石。"
	]
	quest.420000000001000B.title: "熔炉热量"
	quest.420000000001000C.quest_desc: [
		"饥饿是一个柔软的虚空。八个面包可以暂时填补它。",
		"方法：三小麦排成一行，或使用/clowder hub Hearth-keeper。"
	]
	quest.420000000001000C.title: "烹饪一顿美食"
	quest.420000000001000D.quest_desc: [
		"放置岩浆，融化冰块成水源，装满水桶。",
		"简单模式船只浮水；普通和困难模式船只拼装。",
		"方法：将空桶置于水源上。普通/困难：放置岩浆，融化冰块，填充。"
	]
	quest.420000000001000D.title: "接住雨水"
	quest.420000000001000E.quest_desc: [
		"织布机的残片，依然留存。每个任务都会返还一些。",
		"分解一个获取线，或在/clowder hub的Kin摊位出售它们。",
		"获取方式：任务奖励、织布机上的燧石网格泥土、管家储藏箱。"
	]
	quest.420000000001000E.title: "磨损的货币"
	quest.420000000001000F.quest_desc: [
		"虽然损坏了，但它仍然能教学。打开“从这里开始”即可。",
		"右键书籍并打开“从这里开始”。Grave (`)：任务列表。",
		"方法：新手包/船坞箱。右键书籍；Grave (`) 是任务列表。"
	]
	quest.420000000001000F.title: "手持的Codex手册"
	quest.4200000000010010.quest_desc: [
		"设置一个出生点。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在面板上列出所有来源。"
	]
	quest.4200000000010010.title: "床领地标记"
	quest.4200000000010011.quest_desc: [
		"没有绳子就爬进地底。足够便宜，可以留在每个竖井里。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在面板上列出所有来源。"
	]
	quest.4200000000010011.title: "向下爬梯子"
	quest.4200000000010012.quest_desc: [
		"蜘蛛丝留着以后用。每根线最终都会被用上。",
		"方法：拆解毛边线 (1 → 3)。蜘蛛。在回响之缚处用织布机梳理。毛线反向沉入。"
	]
	quest.4200000000010012.title: "字符串缓存"
	quest.4200000000010013.quest_desc: [
		"加速绿色的东西。",
		"方法：网格中的骨头，或线+腐肉陷阱，或/clowder hub 垫底者。"
	]
	quest.4200000000010013.title: "骨粉库存"
	quest.4200000000010014.quest_desc: [
		"扩大平台。",
		"方法：新手箱、鹅卵石+线槽、筛子余料，或/clowder hub（Pad-keepers）。"
	]
	quest.4200000000010014.title: "泥土平台"
	quest.4200000000010015.quest_desc: [
		"先修剪，再堆肥。放在垫子上的东西都不会浪费。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在面板上列出所有来源。"
	]
	quest.4200000000010015.title: "橡木树叶"
	quest.4200000000010016.quest_desc: [
		"一个安静的角落。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000010016.title: "花盆"
	quest.4200000000010017.quest_desc: [
		"Ex Deorum's barrel: 用慢速方法将堆肥和水变成黏土。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在面板上列出所有来源。"
	]
	quest.4200000000010017.title: "木桶"
	quest.4200000000010018.quest_desc: [
		"变废为宝，化腐朽为神奇。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000010018.title: "堆肥桶"
	quest.4200000000010019.quest_desc: [
		"Scratch a row.",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000010019.title: "木制锄头"
	quest.420000000001001A.quest_desc: [
		"比徒手砍伐更快。Skybound拥有的第一件真正工具。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.420000000001001A.title: "木制斧头"
	quest.420000000001001B.quest_desc: [
		"将泥土和砾石变为平整地面。速度慢，但有效。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.420000000001001B.title: "木制铲子"
	quest.420000000001001C.quest_desc: [
		"勉强能挡住僵尸，但也算挡住了。总比空手挥舞要好。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.420000000001001C.title: "木制剑"
	quest.420000000001001D.quest_desc: [
		"能装汤、炖菜，别的就不多了。适合简陋小屋的简单陶器。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.420000000001001D.title: "碗"
	quest.420000000001001E.quest_desc: [
		"给这个平台贴上标签。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.420000000001001E.title: "物品展示框"
	quest.420000000001001F.quest_desc: [
		"把它变成你的家。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.420000000001001F.title: "绘画作品"
	quest.4200000000010020.quest_desc: [
		"将风和生物保持在墙壁的同一侧。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000010020.title: "橡木木门"
	quest.4200000000010021.quest_desc: [
		"标记边缘而不遮挡视野。在掉落高度真实的地方很有用。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000010021.title: "橡木围栏"
	quest.4200000000010022.quest_desc: [
		"将光滑的墙壁变成可以攀爬的表面。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000010022.title: "橡木台阶"
	quest.4200000000010023.quest_desc: [
		"半格大小，双倍铺地选择。在狭小空间里很有用。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000010023.title: "橡木半砖"
	quest.4200000000010024.quest_desc: [
		"带陷阱门的入口舱口。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000010024.title: "橡木活板门"
	quest.4200000000010025.quest_desc: [
		"有东西踩上去时会触发信号。门会自动打开。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000010025.title: "橡木压力板"
	quest.4200000000010026.quest_desc: [
		"用于红石采集的按钮。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在面板上列出所有来源。"
	]
	quest.4200000000010026.title: "橡木按钮"
	quest.4200000000010027.quest_desc: [
		"用围栏围住平台边缘。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000010027.title: "木棍栅栏门"
	quest.4200000000010028.quest_desc: [
		"烹饪速度缓慢，且烟雾在数英里外都清晰可见。",
		"方法：原木、木棍和煤炭或木炭。"
	]
	quest.4200000000010028.title: "篝火"
	quest.4200000000010029.quest_desc: [
		"在火把不合适的位置悬挂光源。更暖的光，同样的作用。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000010029.title: "灯笼"
	quest.420000000001002A.quest_desc: [
		"燃烧呈淡蓝色，并阻止大多数生物在附近生成。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在面板上列出所有来源。"
	]
	quest.420000000001002A.title: "灵魂灯笼"
	quest.420000000001002B.quest_desc: [
		"会跟你一起攀爬，被拉走时会消失。高空建筑不再可怕。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.420000000001002B.title: "脚手架"
	quest.420000000001002C.quest_desc: [
		"用于悬挂流苏的链条。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.420000000001002C.title: "连锁"
	quest.420000000001002D.quest_desc: [
		"将边缘困在笼子里。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.420000000001002D.title: "铁栏杆"
	quest.420000000001002E.quest_desc: [
		"用于平台窗户的玻璃。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.420000000001002E.title: "玻璃板"
	quest.420000000001002F.quest_desc: [
		"柔软、易燃，易于染色。每个方块最终都需要一张床。",
		"方法：在长草后剪羊毛，或收集四根线。"
	]
	quest.420000000001002F.title: "白色羊毛"
	quest.4200000000010030.quest_desc: [
		"一层薄薄的羊毛，适用于不需要整块方块的地面。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000010030.title: "白色地毯"
	quest.4200000000010031.quest_desc: [
		"为粗糙的底座增添了一抹绿色和粉色。",
		"方法：苔藓加橡木，或用骨粉催生苔藓。蜜蜂会接受花蕾。"
	]
	quest.4200000000010031.title: "开花杜鹃花 (Flowering Azalea)"
	quest.4200000000010032.quest_desc: [
		"缓慢蔓延，使原始石质平台的外观更加柔和。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000010032.title: "苔藓方块"
	quest.4200000000010033.quest_desc: [
		"软垫下方垂挂着树根。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000010033.title: "垂挂的根系"
	quest.4200000000010034.quest_desc: [
		"能附着在墙壁上，无需火把即可照亮四周。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000010034.title: "发光地衣类植物"
	quest.4200000000010035.quest_desc: [
		"尖刺风格的滴水石锥。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000010035.title: "尖刺滴水石锥"
	quest.4200000000010036.quest_desc: [
		"一个紫水晶块。Sigil 之后会想要碎片。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000010036.title: "紫水晶块"
	quest.4200000000010037.quest_desc: [
		"九个锭子压在一起。放在外面会氧化成绿色。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在面板上列出所有来源。"
	]
	quest.4200000000010037.title: "铜块"
	quest.4200000000010038.quest_desc: [
		"九块生铁紧密堆叠，等待熔炉的冶炼。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000010038.title: "原始铁块"
	quest.4200000000010039.quest_desc: [
		"比普通煤炭燃烧得更久。投入熔炉，然后走开。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000010039.title: "煤炭块"
	quest.420000000001003A.quest_desc: [
		"喂养动物，减缓坠落。农民会随身携带以作两用。",
		"方法：九个小麦。三个小麦也能做面包。"
	]
	quest.420000000001003A.title: "干草块"
	quest.420000000001003B.quest_desc: [
		"九根海带被压制成燃料。熔炼出的东西比看起来要多得多。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.420000000001003B.title: "干海带块"
	quest.420000000001003C.quest_desc: [
		"纸张和皮革，等待配方将它们组合成新的物品。",
		"方法：三个纸加一个皮革。纸是甘蔗做的。"
	]
	quest.420000000001003C.title: "书籍"
	quest.420000000001003D.quest_desc: [
		"用于制作书籍和地图的纸张。",
		"方法：甘蔗排成一行。甘蔗可通过用燧石筛网或更好的筛网筛土获得。"
	]
	quest.420000000001003D.title: "纸（Paper）"
	quest.420000000001003E.quest_desc: [
		"染料和书需要墨水。",
		"方法：木炭加玻璃瓶。鱿鱼永远不会在这里生成。"
	]
	quest.420000000001003E.title: "墨囊"
	quest.420000000001003F.quest_desc: [
		"用于制作箭和书的羽毛。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.420000000001003F.title: "羽毛"
	quest.4200000000010040.quest_desc: [
		"皮革用于书籍和工具包。",
		"方法：熔炼或用篝火烤腐肉。用燧石筛网筛泥土。/clowder hub 垫底者以18根线出售两个。"
	]
	quest.4200000000010040.title: "皮革"
	quest.4200000000010041.quest_desc: [
		"工作台、树苗、壁炉、水、法典。底座能承重。",
		"拉紧琴弦：垫石守护者回应了，令牌归你所有，可以安座了。",
		"认领它并从部落中选择一个礼物：一条用于共享生命的“回归之线”，或是补给品。",
		"方法：完成与此任务相关的任务，然后用 Strand 代币领取。将代币放置在你的 Tension Post 上。"
	]
	quest.4200000000010041.quest_subtitle: "醒来"
	quest.4200000000010041.title: "土壤结节"
	quest.4200000000010042.quest_desc: [
		"右键点击 Clowder's Tension Post 并使用令牌。",
		"凹槽灯亮起，部落铃铛作响，踏板发生变化。",
		"方法：手持 Strand token，右键点击你的 Tension Post。"
	]
	quest.4200000000010042.title: "座椅土壤"
	quest.4200000000010043.quest_desc: [
		"一个没有洞穴的垫子上的僵尸。虚空向您致以问候。",
		"点燃边缘部分。",
		"方法：在夜间于平台上杀死一只僵尸。点燃边缘。"
	]
	quest.4200000000010043.title: "突然出现了一些状况"
	quest.4200000000020044.quest_desc: [
		"一个记得自己从何而来的线程。",
		"将线团纺成线；四根线可纺成两根毛线。",
		"九族为下一窝猫留下了补给。使用管家宝箱可随机开启补给，或用四个小宝箱合成一个中宝箱，或用三个中宝箱合成一个大宝箱。大宝箱能装下更多卷轴和更丰富的补给种类，单独开启则能获得更基础的补给。里面没有机器或进度代币，但每个宝箱都有极小概率开出线团碎片，极小概率开出完整的回归之线，大宝箱的几率更高。",
		"方法：四根线 → 两根毛线。张力桶：线 + 珍珠。四根织布机绒毛。"
	]
	quest.4200000000020044.title: "拉取虚空纱线"
	quest.4200000000020045.quest_desc: [
		"鹅卵石和木棍。将落下的沙砾分解成碎石、沙子、尘土。",
		"方法：鹅卵石 + 木棍。将砂砾分解成碎石、沙子、粉尘。"
	]
	quest.4200000000020045.title: "纺锤锤"
	quest.4200000000020046.quest_desc: [
		"用线把毛线球缠起来。它能接住织布机掉落的线头，还能把织布机毛絮从泥土里梳出来。",
		"方法：用线把字符串缠起来。Grit-singers的摊位有卖。"
	]
	quest.4200000000020046.title: "将网格穿入线中"
	quest.4200000000020047.quest_desc: [
		"倒水，桶会直接返回。加入泥土。等待粘土。",
		"同一个桶里的线和珍珠可以合成毛线。",
		"方法：木板、线和虚空纱。倒入水（桶会返还），加入泥土→黏土。"
	]
	quest.4200000000020047.title: "张力桶"
	quest.4200000000020048.quest_desc: [
		"从桶里取十六个黏土。每次装载八个泥土。",
		"方法：张力桶 — 水 + 泥土。回声碎裂将沙子锤成黏土。"
	]
	quest.4200000000020048.title: "粘土口袋"
	quest.4200000000020049.quest_desc: [
		"泥土和骨粉。塑造未烧制的桶。",
		"方法：黏土球 + 骨粉，无需特定形状。黏土来自张力桶。"
	]
	quest.4200000000020049.title: "Porcelain Clay"
	quest.420000000002004A.quest_desc: [
		"把它熔了。当铁还只是传说时，瓷器就已承载着熔岩。",
		"方法：将瓷土塑造成未烧制的桶，然后将其冶炼。"
	]
	quest.420000000002004A.title: "Porcelain 工具"
	quest.420000000002004B.quest_desc: [
		"吟唱者用回响为每一块碎片命名。",
		"筛选，直到你能听到铁的声音为止。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.420000000002004B.title: "筛选落下的沙砾"
	quest.420000000002004C.quest_desc: [
		"一套备用的打击次数。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.420000000002004C.title: "木制锤子"
	quest.420000000002004D.quest_desc: [
		"尘埃化成的物质。六十四块石头，一小时前还是尘土。",
		"方法：岩浆和水（或融化的冰）相邻。用铁锤砸石头。/clowder hub Grit-singers' stall 出售一捆。"
	]
	quest.420000000002004D.title: "小石子堆"
	quest.420000000002004E.quest_desc: [
		"织布机粉尘在砾石中等待。燧石也是如此。",
		"方法：用 Spindle Hammer 或 Echo Shatter 锤击鹅卵石。"
	]
	quest.420000000002004E.title: "砾石小径"
	quest.420000000002004F.quest_desc: [
		"细沙。之后是玻璃，铁丝网能过滤得最干净。",
		"方法：用锤子敲击砾石。"
	]
	quest.420000000002004F.title: "沙子储藏箱"
	quest.4200000000020050.quest_desc: [
		"坠落的世界的灰烬。红石和火药藏在里面。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.4200000000020050.title: "尘埃堆"
	quest.4200000000020051.quest_desc: [
		"用线缠绕史莱姆。用垫料堆肥来制作史莱姆。",
		"The Knot 是 Loom 的软门；保留两个。",
		"方法：将虚空纱线环绕在史莱姆球周围。"
	]
	quest.4200000000020051.title: "打结捆绑术（Tie Binding Knot）"
	quest.4200000000020052.quest_desc: [
		"围绕结点的木板。拉伸网格，加载砂砾，让它发挥作用。",
		"漏斗为其供料。这是平台的第一台机器。",
		"方法：用木板围住一个绑定结。拉伸网格，倒入漏斗沙砾，再放在漏斗上。"
	]
	quest.4200000000020052.title: "升起织布机框架"
	quest.4200000000020053.quest_desc: [
		"铁含量低，请耐心等待。距离网格还有八个区块。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.4200000000020053.title: "铁矿石区块"
	quest.4200000000020054.quest_desc: [
		"一点点从砾石中筛出。筛网比你的眼睛更早发现铜。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.4200000000020054.title: "铜矿石区块"
	quest.4200000000020055.quest_desc: [
		"金几乎懒得回答。四个就足够了。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.4200000000020055.title: "金矿石区块"
	quest.4200000000020056.quest_desc: [
		"为生产线提供燃料。",
		"方法：筛选砾石，或熔炼煤炭矿石。"
	]
	quest.4200000000020056.title: "煤炭"
	quest.4200000000020057.quest_desc: [
		"将区块转为原矿。继续冶炼。",
		"方法：筛选砾石获取铁矿石块；四个合成一个铁矿石块，开采可掉落生铁。"
	]
	quest.4200000000020057.title: "原矿铁"
	quest.4200000000020058.quest_desc: [
		"回收成功。十六根虚空不想让你拥有的锭。",
		"方法：熔炼生铁/铁砂（熔炉或余烬熔炉）。筛取砾石以获取铁块。"
	]
	quest.4200000000020058.title: "铁锭"
	quest.4200000000020059.quest_desc: [
		"电线和灯泡，还有部落共振器，晚点再说。",
		"方法：熔炼原铜/铜砂。筛分砾石。"
	]
	quest.4200000000020059.title: "铜制锭块"
	quest.420000000002005A.quest_desc: [
		"镀金工具，还有供图案编织者使用的金板。",
		"方法：熔炼生金/金砂。更稀有的筛子捕获。"
	]
	quest.420000000002005A.title: "金锭"
	quest.420000000002005B.quest_desc: [
		"更锋利的捕捉。燧石网将磨损的线从沙砾中筛出。",
		"方法：用打火石围绕一根线编织成网。"
	]
	quest.420000000002005B.title: "燧石网格"
	quest.420000000002005C.quest_desc: [
		"用于更重灰尘的金属线。铁丝网是 Strand Filament 的归属。",
		"方法：用铁围绕火打石线网。线束从这里开始。"
	]
	quest.420000000002005C.title: "铁质网格"
	quest.420000000002005D.quest_desc: [
		"融化与滴落。历经时间，原石化为熔岩。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.420000000002005D.title: "熔炉（Crucible）"
	quest.420000000002005E.quest_desc: [
		"Ex Deorum's barrel: 用慢速方法将堆肥和水变成黏土。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.420000000002005E.title: "木桶（石制）"
	quest.420000000002005F.quest_desc: [
		"更硬的打击，更长的生命。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.420000000002005F.title: "石锤"
	quest.4200000000020060.quest_desc: [
		"将矿石碾成砾石和砂砾，筛子背后的喧闹技巧。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.4200000000020060.title: "铁锤 (Iron Hammer)"
	quest.4200000000020061.quest_desc: [
		"更宽的网格，一次九个。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.4200000000020061.title: "压缩筛子"
	quest.4200000000020062.quest_desc: [
		"看透一切。沙砾化为玻璃。",
		"方法：熔炼沙子。用锤子把鹅卵石打成砾石，砾石打成沙子，然后用熔炉。"
	]
	quest.4200000000020062.title: "玻璃"
	quest.4200000000020063.quest_desc: [
		"现在用铁来承载雨水吧。",
		"方法：三个铁锭，或/clowder hub Pad-keepers（8个线）。用融化的冰填充。"
	]
	quest.4200000000020063.title: "水桶"
	quest.4200000000020064.quest_desc: [
		"虚空的热量，掌握在手中。",
		"方法：Ex Deorum 熔岩坩埚，或在爪黑曜石后的下界熔岩池。"
	]
	quest.4200000000020064.title: "岩浆桶"
	quest.4200000000020065.quest_desc: [
		"传送门思考。水在熔岩源上。",
		"方法：将水倒在岩浆源上（或将岩浆倒在水上）。保留岩浆源。"
	]
	quest.4200000000020065.title: "黑曜石"
	quest.4200000000020066.quest_desc: [
		"稀有的砂砾运气。有两个就算不错了。",
		"方法：用铁丝网或更好的筛子筛取砾石，或用回声震碎钻石原矿。"
	]
	quest.4200000000020066.title: "钻石"
	quest.4200000000020067.quest_desc: [
		"网格升级燃料。",
		"方法：砾石，或线 + 砾石水槽。"
	]
	quest.4200000000020067.title: "燧石"
	quest.4200000000020068.quest_desc: [
		"由沙粒和灰尘制成，并非从苦力怕身上掠夺。请小心处理。",
		"方法：用筛子过滤尘土或灵魂沙，或在夜间用苦力怕在平台上繁殖。收集到一些后，保持边缘照明。"
	]
	quest.4200000000020068.title: "火药"
	quest.4200000000020069.quest_desc: [
		"火花会想要这个。保持干燥。",
		"方法：筛分砾石，或在恢复后震碎红石矿石。"
	]
	quest.4200000000020069.title: "红石电路"
	quest.420000000002006A.quest_desc: [
		"为附魔台提供能量。能让装备更听话的蓝色粉末。",
		"方法：筛选砾石，或用回声震碎处理青金石矿石。"
	]
	quest.420000000002006A.title: "青金石"
	quest.420000000002006B.quest_desc: [
		"常见的石头混合物，主要用于建筑和后续配方混合。",
		"方法：在JEI中筛选泥土/砾石小石子，或用鹅卵石加正岩。"
	]
	quest.420000000002006B.title: "安山岩"
	quest.420000000002006C.quest_desc: [
		"斑点石，装饰性大于结构性。沙砾歌手称其为喧闹者。",
		"方法：筛选鹅卵石，或用圆石加下界石英合成。"
	]
	quest.420000000002006C.title: "Diorite"
	quest.420000000002006D.quest_desc: [
		"质地致密，带有粉色斑点，适合用作引人注目的地板。",
		"方法：筛选鹅卵石，或用正岩加下界石英。"
	]
	quest.420000000002006D.title: "花岗岩"
	quest.420000000002006E.quest_desc: [
		"来自另一个地方的多孔岩。一旦点燃，就会永远燃烧。",
		"方法：此处的下界是虚空，而非地形。将岩浆倒入装有女巫之水的 Ex Deorum 桶中（一个放在菌丝上的水桶；菌丝孢子可从泥土中筛选）。"
	]
	quest.420000000002006E.title: "下界岩"
	quest.420000000002006F.quest_desc: [
		"减缓所有穿过它的脚步，并为灵魂之火注入更冷的蓝色。",
		"方法：将沙子倒入装有女巫水的 Ex Deorum 桶中。堡垒的疣体房间会生成少量。在灵魂沙上放置三个骷髅即可召唤凋零。"
	]
	quest.420000000002006F.title: "灵魂沙"
	quest.4200000000020070.quest_desc: [
		"来自下界的发光石粉末，可用于酿造和制作更柔和的光源。",
		"方法：筛选灵魂沙，或用女巫在平台上。"
	]
	quest.4200000000020070.title: "Glowstone Dust"
	quest.4200000000020071.quest_desc: [
		"无需挥斧砍树干，即可剥下树叶。",
		"方法：四根木棍。Grit-singers的摊位出售一根。"
	]
	quest.4200000000020071.title: "Crook"
	quest.4200000000020072.quest_desc: [
		"从筛子中拉出，越堆越多。但永远不够用。",
		"方法：拆解毛边线 (1 → 3)。蜘蛛。在回响之缚处用织布机梳理。毛线反向沉入。"
	]
	quest.4200000000020072.title: "String"
	quest.4200000000020073.quest_desc: [
		"结绳器——或者垫料堆肥配方。",
		"方法：泥土 x2 + 小麦种子 + 骨粉（垫料堆肥），或 /clowder hub 垫料管理员。"
	]
	quest.4200000000020073.title: "史莱姆球"
	quest.4200000000020074.quest_desc: [
		"磨成粉当食物，或留整只来繁殖狼群的后代。",
		"方法：夜晚的骷髅，或/clowder hub的守巢者（8个需要16个线）。"
	]
	quest.4200000000020074.title: "骨头"
	quest.4200000000020075.quest_desc: [
		"苦涩且略带毒性。酿酒师会用它，没人会直接生吃。",
		"方法：夜间在平台上放置蜘蛛。"
	]
	quest.4200000000020075.title: "蜘蛛之眼"
	quest.4200000000020076.quest_desc: [
		"毛线、瓷、一个可用的织布机框架、箱子里的铁。",
		"拉紧琴弦：砾石歌者作出了回应。",
		"认领它并从部落中选择一个礼物：一条用于共享生命的“回归之线”，或是补给品。",
		"方法：完成与此任务相关的任务，然后用 Strand 代币领取。将代币放置在你的 Tension Post 上。"
	]
	quest.4200000000020076.quest_subtitle: "恢复"
	quest.4200000000020076.title: "石质绳结"
	quest.4200000000020077.quest_desc: [
		"右键点击 Clowder's Tension Post 并使用令牌。",
		"凹槽灯亮起，部落铃铛作响，踏板发生变化。",
		"方法：手持 Strand token 右键点击你的 Tension Post。"
	]
	quest.4200000000020077.title: "座位石"
	quest.4200000000020078.quest_desc: [
		"苦力怕，解决了。火药的价值比惊吓更高。",
		"方法：杀死三个苦力怕。奖励是火药。"
	]
	quest.4200000000020078.title: "轰隆一声，完事收工"
	quest.4200000000030079.quest_desc: [
		"在写字板上刻下划痕。",
		"九族为下一窝猫留下了补给。使用管家宝箱可随机开启补给，或用四个小宝箱合成一个中宝箱，或用三个中宝箱合成一个大宝箱。大宝箱能装下更多卷轴和更丰富的补给种类，单独开启则能获得更基础的补给。里面没有机器或进度代币，但每个宝箱都有极小概率开出线团碎片，极小概率开出完整的回归之线，大宝箱的几率更高。",
		"方法：两根铁锭和一根木棍。"
	]
	quest.4200000000030079.title: "铁质锄头"
	quest.420000000003007A.quest_desc: [
		"面包是基础设施。三十二个小麦是一片田，而不是一块地。",
		"方法：在农田上种小麦种子，然后用骨粉。种子可从破坏草地或初始宝箱中获得。"
	]
	quest.420000000003007A.title: "小麦田"
	quest.420000000003007B.quest_desc: [
		"种下你将要吃的东西。",
		"方法：破坏草，或用燧石筛过滤泥土。种植在农田上；骨粉可加速第一块田的生长。"
	]
	quest.420000000003007B.title: "种子袋"
	quest.420000000003007C.quest_desc: [
		"速度即友善。堆肥与骨头。",
		"方法：网格中的骨头，或线+腐肉陷阱，或/clowder hub 垫底者。"
	]
	quest.420000000003007C.title: "骨粉引擎 (Bone Meal Engine)"
	quest.420000000003007D.quest_desc: [
		"准备好迎接丰收吧。",
		"方法：在 JEI 中用 Farmer's Delight 合成（合成台、砧板或烹饪锅）。作物种子来自筛土。"
	]
	quest.420000000003007D.title: "农夫刀 (Farmers Knife)"
	quest.420000000003007E.quest_desc: [
		"厨房就从这里开始建造吧。",
		"方法：在 JEI 中用 Farmer's Delight 合成（合成台、砧板或烹饪锅）。作物种子来自筛土。"
	]
	quest.420000000003007E.title: "砧板 Cutting Board"
	quest.420000000003007F.quest_desc: [
		"温暖的饭菜不仅能填饱肚子。",
		"方法：在 JEI 中用 Farmer's Delight 合成（合成台、砧板或烹饪锅）。作物种子可通过筛土获得。"
	]
	quest.420000000003007F.title: "烹饪锅"
	quest.4200000000030080.quest_desc: [
		"整齐地长在头上，煮熟了再吃比生吃要好。",
		"方法：在 JEI 中用 Farmer's Delight 合成（合成台、砧板或烹饪锅）。作物种子可通过筛土获得。"
	]
	quest.4200000000030080.title: "卷心菜"
	quest.4200000000030081.quest_desc: [
		"爬上自己的棚架，熟透变红。酱汁由此开始。",
		"方法：在 JEI 中用 Farmer's Delight 合成（合成台、砧板或烹饪锅）。作物种子可通过筛土获得。"
	]
	quest.4200000000030081.title: "番茄"
	quest.4200000000030082.quest_desc: [
		"喜悦的泪水。",
		"方法：在 JEI 中用 Farmer's Delight 合成（合成台、砧板或烹饪锅）。作物种子可通过筛土获得。"
	]
	quest.4200000000030082.title: "洋葱"
	quest.4200000000030083.quest_desc: [
		"精华采集开始。第一行十六个。",
		"方法：在JEI中用神秘农业合成。Inferium和Prosperity来自筛子；种子在Infusion Altar上灌注。"
	]
	quest.4200000000030083.title: "Inferium"
	quest.4200000000030084.quest_desc: [
		"种子的骨架。用筛子过滤或让它生长。",
		"方法：在JEI中用神秘农业合成。Inferium和Prosperity来自筛子；种子在Infusion Altar上灌注。"
	]
	quest.4200000000030084.title: "Prosperity"
	quest.4200000000030085.quest_desc: [
		"用精华培育种子。",
		"方法：在JEI中用神秘农业合成。Inferium和Prosperity来自筛子；种子在Infusion Altar上灌注。"
	]
	quest.4200000000030085.title: "灌注祭坛"
	quest.4200000000030086.quest_desc: [
		"祭坛周围放置四个。",
		"方法：在JEI中用神秘农业合成。Inferium和Prosperity来自筛子；种子在Infusion Altar上灌注。"
	]
	quest.4200000000030086.title: "灌注祭坛 (Infusion Pedestal)"
	quest.4200000000030087.quest_desc: [
		"种植更多的垫子方块。",
		"方法：在JEI中用神秘农业合成。Inferium和Prosperity来自筛子；种子在Infusion Altar上灌注。"
	]
	quest.4200000000030087.title: "泥土种子"
	quest.4200000000030088.quest_desc: [
		"不用斧头就能长出树冠。",
		"方法：在JEI中用神秘农业合成。Inferium和Prosperity来自筛子；种子在Infusion Altar上灌注。"
	]
	quest.4200000000030088.title: "木材种子"
	quest.4200000000030089.quest_desc: [
		"生长而非挖掘。用收获精华代替挥舞镐子。",
		"方法：在JEI中用神秘农业合成。Inferium和Prosperity来自筛子；种子在Infusion Altar上灌注。"
	]
	quest.4200000000030089.title: "石制种子"
	quest.420000000003008A.quest_desc: [
		"作物中获得的金属。回收第二台引擎。",
		"方法：在JEI中用神秘农业合成。Inferium和Prosperity来自筛子；种子在Infusion Altar上灌注。"
	]
	quest.420000000003008A.title: "铁质种子"
	quest.420000000003008B.quest_desc: [
		"一种能产出铜精而非铜矿石的作物。",
		"方法：在JEI中用神秘农业合成。Inferium和Prosperity来自筛子；种子在Infusion Altar上灌注。"
	]
	quest.420000000003008B.title: "铜制种子"
	quest.420000000003008C.quest_desc: [
		"一种镀金作物，可在种植板上直接生长出金质精华。",
		"方法：在JEI中用神秘农业合成。Inferium和Prosperity来自筛子；种子在Infusion Altar上灌注。"
	]
	quest.420000000003008C.title: "黄金种子"
	quest.420000000003008D.quest_desc: [
		"将农场地块变为燃料源，无需挖矿。",
		"方法：在JEI中用神秘农业合成。Inferium和Prosperity来自筛子；种子在Infusion Altar上灌注。"
	]
	quest.420000000003008D.title: "煤炭种子"
	quest.420000000003008E.quest_desc: [
		"作物中收集的瓶装雨水。",
		"方法：在JEI中用神秘农业合成。Inferium和Prosperity来自筛子；种子在Infusion Altar上灌注。"
	]
	quest.420000000003008E.title: "水之种子"
	quest.420000000003008F.quest_desc: [
		"小型平台上的紧凑型生长。",
		"方法：JEI中的陶土植物盆。泥土+盆中的种子；骨粉仍然有效。"
	]
	quest.420000000003008F.title: "植物学花盆"
	quest.4200000000030090.quest_desc: [
		"能够自我收割的陶罐。",
		"方法：在JEI中查找漏斗植物学盆。放置在箱子/漏斗上即可自动收集。"
	]
	quest.4200000000030090.title: "漏斗锅 (Hopper Pot)"
	quest.4200000000030091.quest_desc: [
		"升级了。种子变得更贪婪，也更优秀了。",
		"方法：在JEI中用神秘农业合成。Inferium和Prosperity来自筛子；种子在Infusion Altar上灌注。"
	]
	quest.4200000000030091.title: "审慎（Prudentium）"
	quest.4200000000030092.quest_desc: [
		"更深层的作物精华，比你最初使用的种子更强。",
		"方法：在JEI中用神秘农业合成。Inferium和Prosperity来自筛子；种子在Infusion Altar上灌注。"
	]
	quest.4200000000030092.title: "Tertium"
	quest.4200000000030093.quest_desc: [
		"九个方块组成一个区块。引擎的存储空间。",
		"方法：九个骨粉。来自骷髅或帕德守护者。"
	]
	quest.4200000000030093.title: "骨块 (Bone Block)"
	quest.4200000000030094.quest_desc: [
		"多余的树苗，已堆叠好。",
		"方法：九个小麦。三个小麦也能做面包。"
	]
	quest.4200000000030094.title: "干草谷仓"
	quest.4200000000030095.quest_desc: [
		"更好的农田。Rootbinders 会批准的。",
		"方法：放置有机堆肥并等待；它会慢慢成熟为肥沃土壤。"
	]
	quest.4200000000030095.title: "肥沃的土壤"
	quest.4200000000030096.quest_desc: [
		"滋养你的土壤，你也要滋养它。",
		"方法：在 JEI 中用 Farmer's Delight 合成（合成台、砧板或烹饪锅）。作物种子可通过筛土获得。"
	]
	quest.4200000000030096.title: "有机堆肥 (Organic Compost)"
	quest.4200000000030097.quest_desc: [
		"种一排，喂马，或者直接生吃。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在面板上列出所有来源。"
	]
	quest.4200000000030097.title: "胡萝卜"
	quest.4200000000030098.quest_desc: [
		"作为主食的作物，土豆。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000030098.title: "土豆"
	quest.4200000000030099.quest_desc: [
		"生长迅速，呈红色。可做成汤、炖菜，或直接从地里挖取。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000030099.title: "甜菜根"
	quest.420000000003009A.quest_desc: [
		"用于食物和交易的甜瓜。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.420000000003009A.title: "甜瓜"
	quest.420000000003009B.quest_desc: [
		"南瓜可用于食物和装饰。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在面板上列出所有来源。"
	]
	quest.420000000003009B.title: "南瓜"
	quest.420000000003009C.quest_desc: [
		"纸和糖。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.420000000003009C.title: "甘蔗 (Sugar Cane)"
	quest.420000000003009D.quest_desc: [
		"无需水即可生长，并且会伤害任何靠近它的生物。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在面板上列出所有来源。"
	]
	quest.420000000003009D.title: "仙人掌"
	quest.420000000003009E.quest_desc: [
		"燃烧迅速，火力强劲。树木稀少的着陆台的好燃料。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在面板上列出所有来源。"
	]
	quest.420000000003009E.title: "竹子"
	quest.420000000003009F.quest_desc: [
		"建造的同时收集浆果。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在面板上列出所有来源。"
	]
	quest.420000000003009F.title: "甜美的浆果"
	quest.42000000000300A0.quest_desc: [
		"生长于丛林原木，研磨成赋予万物甜味的棕色粉末。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在面板上列出所有来源。"
	]
	quest.42000000000300A0.title: "可可豆"
	quest.42000000000300A1.quest_desc: [
		"橡树叶会自行落下。迟早能吃到免费的食物。",
		"方法：橡木树叶会掉落几个；帕姆的苹果树（铁丝网泥土中的树苗）会结出许多。"
	]
	quest.42000000000300A1.title: "苹果"
	quest.42000000000300A2.quest_desc: [
		"一个碗，没有工作台。懒农民的晚餐。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在面板上列出所有来源。"
	]
	quest.42000000000300A2.title: "蘑菇浓汤"
	quest.42000000000300A3.quest_desc: [
		"在开始与蜜蜂的深层工作前，先来品尝蜂巢的味道。",
		"方法：将玻璃瓶放在完整的蜂巢上。下方放置篝火。"
	]
	quest.42000000000300A3.title: "蜂蜜瓶"
	quest.42000000000300A4.quest_desc: [
		"在洞穴藤蔓上生长，边吃边点亮隧道。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.42000000000300A4.title: "发光浆果"
	quest.42000000000300A5.quest_desc: [
		"所有值得装瓶的药水的基础。仅生长于灵魂沙上。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在面板上列出所有来源。"
	]
	quest.42000000000300A5.title: "下界疣"
	quest.42000000000300A6.quest_desc: [
		"一片田野，一间厨房，精华在升腾。",
		"拉紧绳索：根缚者们的回应。",
		"认领它并从部落中选择一个礼物：一条用于共享生命的“回归之线”，或是补给品。",
		"方法：完成与此任务相关的任务，然后用 Strand 代币领取。将代币放置在你的 Tension Post 上。"
	]
	quest.42000000000300A6.quest_subtitle: "根目录"
	quest.42000000000300A6.title: "发芽的绳结"
	quest.42000000000300A7.quest_desc: [
		"右键点击 Clowder's Tension Post 并使用令牌。",
		"凹槽灯亮起，部落铃铛作响，踏板发生变化。",
		"方法：手持 Strand token 右键点击你的 Tension Post。"
	]
	quest.42000000000300A7.title: "座椅发芽（Seat Sprout）"
	quest.42000000000300A8.quest_desc: [
		"每个根缚者最终都会抽取一个。",
		"不要吃它。也不要把它扔掉。",
		"方法：稀有的土豆收成。可选的发芽秘密。"
	]
	quest.42000000000300A8.title: "错误的土豆"
	quest.42000000000400A9.quest_desc: [
		"按照你的规则切割虚空。八张设计图。",
		"九族为下一窝猫留下了补给。使用管家宝箱可随机开启补给，或用四个小宝箱合成一个中宝箱，或用三个中宝箱合成一个大宝箱。大宝箱能装下更多卷轴和更丰富的补给种类，单独开启则能获得更基础的补给。里面没有机器或进度代币，但每个宝箱都有极小概率开出线团碎片，极小概率开出完整的回归之线，大宝箱的几率更高。",
		"配方：4个纸和1个蓝色染料，无需特定形状。可产出4张纸。"
	]
	quest.42000000000400A9.title: "蓝图图纸"
	quest.42000000000400AA.quest_desc: [
		"装在箱子里的设计图。",
		"四张蓝图纸，无需特定配方——领取后Silent Gear的加入礼物将被清除。右键以展开初始蓝图。",
		"方法：4个蓝图纸，无需特定配方。右键展开初始蓝图。领取后Silent Gear的加入礼物将被清除。"
	]
	quest.42000000000400AA.title: "蓝图数据包"
	quest.42000000000400AB.quest_desc: [
		"模块化工具在添加部件前，会从模板开始构建。",
		"方法：展开蓝图包，或使用JEI。爪会命名工具栏。"
	]
	quest.42000000000400AB.title: "鱼竿蓝图"
	quest.42000000000400AC.quest_desc: [
		"锻造一把超越金属本身的镐子。",
		"方法：展开蓝图包，或使用 JEI。爪会命名工具栏。"
	]
	quest.42000000000400AC.title: "拾取蓝图"
	quest.42000000000400AD.quest_desc: [
		"制作一把斧头。",
		"方法：展开蓝图包，或使用JEI。爪会命名工具栏。"
	]
	quest.42000000000400AD.title: "斧头蓝图"
	quest.42000000000400AE.quest_desc: [
		"制作一把铲子。",
		"方法：展开蓝图包，或使用JEI。爪会命名工具栏。"
	]
	quest.42000000000400AE.title: "铲子蓝图"
	quest.42000000000400AF.quest_desc: [
		"锻造一把刀刃。",
		"How: unwrap the Blueprint Package, or JEI. Claw names the tool line."
	]
	quest.42000000000400AF.title: "武器蓝图"
	quest.42000000000400B0.quest_desc: [
		"还有成长的空间。",
		"方法：蓝图纸后的 JEI。爪会命名升级线。"
	]
	quest.42000000000400B0.title: "升级基地"
	quest.42000000000400B1.quest_desc: [
		"用于制作零件的三十二块材料锭。",
		"方法：熔炼生铁/铁砂（熔炉或余烬熔炉）。筛取砾石以获取铁块。"
	]
	quest.42000000000400B1.title: "铁质巨块"
	quest.42000000000400B2.quest_desc: [
		"将刀刃的锋利度提升至仅靠铁器无法达到的程度。",
		"方法：用铁丝网或更好的筛子筛取砾石，或用回声震碎钻石原矿。"
	]
	quest.42000000000400B2.title: "钻石尖端"
	quest.42000000000400B3.quest_desc: [
		"树叶和羊毛，还有梳子，待会再说。",
		"方法：斜着放置两个铁锭。剪羊毛和蜂巢。"
	]
	quest.42000000000400B3.title: "Shears"
	quest.42000000000400B4.quest_desc: [
		"踏板有边缘。生物也有边缘。",
		"方法：铁块周围放六个木板。非主手方块。"
	]
	quest.42000000000400B4.title: "盾牌"
	quest.42000000000400B5.quest_desc: [
		"故意在夜晚生存下来。",
		"方法：八个铁锭。熔炼筛砂。"
	]
	quest.42000000000400B5.title: "铁质胸甲"
	quest.42000000000400B6.quest_desc: [
		"注意掉落物品。",
		"方法：五个铁锭。"
	]
	quest.42000000000400B6.title: "铁质头盔"
	quest.42000000000400B7.quest_desc: [
		"先覆盖腿部。反正大部分伤害都来自下方。",
		"方法：七个铁锭。"
	]
	quest.42000000000400B7.title: "铁质护腿"
	quest.42000000000400B8.quest_desc: [
		"在悬崖边缘站稳脚步，否则就会坠入虚空。",
		"方法：四个铁锭。"
	]
	quest.42000000000400B8.title: "铁靴子"
	quest.42000000000400B9.quest_desc: [
		"将虚空生物保持在一定距离之外。",
		"方法：三根线和三根木棍。"
	]
	quest.42000000000400B9.title: "弓"
	quest.42000000000400BA.quest_desc: [
		"保持距离的六十四条理由。",
		"方法：燧石、木棍、羽毛。骷髅会掉落额外的物品。"
	]
	quest.42000000000400BA.title: "箭矢束"
	quest.42000000000400BB.quest_desc: [
		"照亮前方的道路，继续前进。",
		"方法：铁锭加燧石。"
	]
	quest.42000000000400BB.title: "燧石与钢"
	quest.42000000000400BC.quest_desc: [
		"十块方块。一扇边缘行者会认识的门。",
		"方法：将水倒在岩浆源上（或将岩浆倒在水上）。保留岩浆源。"
	]
	quest.42000000000400BC.title: "黑曜石框架"
	quest.42000000000400BD.quest_desc: [
		"立足点准备。别处存在一个地方。",
		"方法：珍珠（边缘行者摊位/末影人）加上下界堡垒的烈焰粉（在获得爪黑曜石之后）。八眼库存可选；末地水晶使用相同的配方。"
	]
	quest.42000000000400BD.title: "末地之眼"
	quest.42000000000400BE.quest_desc: [
		"强大的工具，源自柔和的力量。",
		"方法：钻石两个，黑曜石四个，书一本。钻石来自铁丝网砾石。"
	]
	quest.42000000000400BE.title: "附魔台 Enchanting Table"
	quest.42000000000400BF.quest_desc: [
		"修理并命名你携带的物品。",
		"方法：三个铁块和四个铁锭。"
	]
	quest.42000000000400BF.title: "铁砧"
	quest.42000000000400C0.quest_desc: [
		"就叫它你的名字吧。",
		"方法：钓鱼/稀有宝箱，或去/clowder hub的Seal-carvers' stall（24根线）。可选。"
	]
	quest.42000000000400C0.title: "名称标签"
	quest.42000000000400C1.quest_desc: [
		"模块化锄头的初始模板，可分部分建造。",
		"方法：展开蓝图包，或使用 JEI。"
	]
	quest.42000000000400C1.title: "锄头蓝图"
	quest.42000000000400C2.quest_desc: [
		"单次挥砍即可清除一大片作物，而非仅一株植物。",
		"方法：展开蓝图包，或使用 JEI。"
	]
	quest.42000000000400C2.title: "镰刀蓝图"
	quest.42000000000400C3.quest_desc: [
		"一把能挖掘、砍伐和挖掘的工具。再也不用换手了。",
		"方法：展开蓝图包，或使用 JEI。"
	]
	quest.42000000000400C3.title: "Paxel 蓝图"
	quest.42000000000400C4.quest_desc: [
		"单次击碎三乘三的石块区域。",
		"方法：展开蓝图包，或使用 JEI。"
	]
	quest.42000000000400C4.title: "锤子蓝图"
	quest.42000000000400C5.quest_desc: [
		"清理泥土和沙子中的大洞比任何铲子都快。",
		"方法：展开蓝图包，或使用 JEI。"
	]
	quest.42000000000400C5.title: "挖掘机蓝图"
	quest.42000000000400C6.quest_desc: [
		"小巧、快速、精准。专为近距离作业而生，而非战争。",
		"方法：展开蓝图包，或使用 JEI。"
	]
	quest.42000000000400C6.title: "刀具蓝图"
	quest.42000000000400C7.quest_desc: [
		"柔软的板甲，易于附魔，其魔法价值高于防御价值。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.42000000000400C7.title: "黄金盔甲碎片"
	quest.42000000000400C8.quest_desc: [
		"海之利爪。",
		"可选的——虚空可能永远不会提供一个。",
		"方法：仅限溺尸。可选任务。"
	]
	quest.42000000000400C8.title: "三叉戟"
	quest.42000000000400C9.quest_desc: [
		"加载慢，打击强，电量持久，直到你需要它为止。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.42000000000400C9.title: "十字弓"
	quest.42000000000400CA.quest_desc: [
		"扫描虚空。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.42000000000400CA.title: "望远镜（Spyglass）"
	quest.42000000000400CB.quest_desc: [
		"图纸，背上的铁，一扇出去的门。",
		"拉紧绳索：边缘行者响应。发辫打开。",
		"认领它并从部落中选择一个礼物：一条用于共享生命的“回归之线”，或是补给品。",
		"方法：完成与此任务相关的任务，然后用 Strand 代币领取。将代币放置在你的 Tension Post 上。"
	]
	quest.42000000000400CB.quest_subtitle: "边缘"
	quest.42000000000400CB.title: "爪形结绳"
	quest.42000000000400CC.quest_desc: [
		"右键点击 Clowder's Tension Post 并使用令牌。",
		"凹槽灯亮起，部落铃铛作响，踏板发生变化。",
		"方法：手持 Strand token 右键点击你的 Tension Post。"
	]
	quest.42000000000400CC.title: "座椅之爪"
	quest.42000000000400CD.quest_desc: [
		"某个高大的生物回头望了望。边缘行者称他们为守门人。",
		"方法：杀死一个末影人。珍珠也来自边缘行者的小摊。"
	]
	quest.42000000000400CD.title: "边缘的边缘"
	quest.42000000000500CE.quest_desc: [
		"嗡鸣前的短暂信号。六十四粒尘埃。",
		"九族为下一窝猫留下了补给。使用管家宝箱可随机开启补给，或用四个小宝箱合成一个中宝箱，或用三个中宝箱合成一个大宝箱。大宝箱能装下更多卷轴和更丰富的补给种类，单独开启则能获得更基础的补给。里面没有机器或进度代币，但每个宝箱都有极小概率开出线团碎片，极小概率开出完整的回归之线，大宝箱的几率更高。",
		"方法：筛分砾石，或在恢复后震碎红石矿石。"
	]
	quest.42000000000500CE.title: "红石粉"
	quest.42000000000500CF.quest_desc: [
		"平行加热。八号是一条线，不是熔炉。",
		"方法：在空中心周围放置八个鹅卵石。"
	]
	quest.42000000000500CF.title: "熔炉阵列"
	quest.42000000000500D0.quest_desc: [
		"徒手搬运砂砾，无需借助工具。",
		"方法：在箱子周围放置五个铁锭。将其置于织布机框架或张力桶下方（向下提取）。"
	]
	quest.42000000000500D0.title: "漏斗传输线"
	quest.42000000000500D1.quest_desc: [
		"测量一下节拍。",
		"方法：下界石英、红石火把、石头。用灵魂沙筛出石英，无需前往下界。"
	]
	quest.42000000000500D1.title: "比较器"
	quest.42000000000500D2.quest_desc: [
		"骨头、线、紫水晶。第一拍子。",
		"会产出两个——留一个用于灵魂法典。",
		"方法：骨头、线、紫水晶各一个。/clowder hub Pad-keepers 出售骨头。Spark / Hum 门。"
	]
	quest.42000000000500D2.title: "Hum: 骨制风铃"
	quest.42000000000500D3.quest_desc: [
		"一块古老的部落歌谣碎片。需要一个铃铛。",
		"配方：骨铃、紫水晶和红石，无需特定形状。可产出两个。"
	]
	quest.42000000000500D3.title: "名称：灵魂碎片 (Spirit Shard)"
	quest.42000000000500D4.quest_desc: [
		"钟铃周围的铜：与精神共鸣的金属。",
		"方法：用铜围绕骨铃。可产出两个。"
	]
	quest.42000000000500D4.title: "名称：铜制共鸣器"
	quest.42000000000500D5.quest_desc: [
		"敲击它。保持脉冲。在连接任何东西之前先倾听。",
		"两个铃铛、一个碎片、两个皮革、四个木板——/clowder hub 的守夜人出售皮革。",
		"配方：两个骨铃、一个灵魂碎片、两个皮革和四个木板。在节奏（17-23刻）中徒手攻击可获得24个脉冲。"
	]
	quest.42000000000500D5.title: "Hum: Drumheart"
	quest.42000000000500D6.quest_desc: [
		"携带脉冲用于工具、法术和旅行 — 需要共振器 + 碎片。",
		"方法：合成，然后用鼓心（点击单元格）填充。工具、法术和旅行都从单元格中获取。"
	]
	quest.42000000000500D6.title: "名称：脉冲电池"
	quest.42000000000500D7.quest_desc: [
		"在开阔的天空下，将环境脉动转化为节拍。加入图腾之声；无需鼓心。",
		"方法：放置于天空下靠近水/绿地的地方。缓慢脉冲。火花阶梯。"
	]
	quest.42000000000500D7.title: "任务：莱伊收集器"
	quest.42000000000500D8.quest_desc: [
		"放置一个回声催化剂（它会随着使用而磨损）和两种不同的元素图腾。营地会颂唱自身的力量；红石会暂停和谐。",
		"方法：放置一个回声催化剂，并在8格内放置两种不同的图腾。红石会使其暂停。"
	]
	quest.42000000000500D8.title: "名称：脉冲共振器"
	quest.42000000000500D9.quest_desc: [
		"一个用于Forge能量的缓冲器——如果你想从脉冲连接到电线，这就是你的桥梁。",
		"方法：Powah Grid 章节 — 在 Spark Pulse 存在后，制作 energizing orb 和电缆。"
	]
	quest.42000000000500D9.title: "Powah 启动电池"
	quest.42000000000500DA.quest_desc: [
		"燃烧燃料以获取Forge能量。",
		"方法：Powah Grid 章节 — 在 Spark Pulse 存在后，制作 energizing orb 和电缆。"
	]
	quest.42000000000500DA.title: "Powah 熔炉"
	quest.42000000000500DB.quest_desc: [
		"让能量流动起来。",
		"方法：Powah Grid 章节 — 在 Spark Pulse 存在后，制作 energizing orb 和电缆。"
	]
	quest.42000000000500DB.title: "Powah 电缆"
	quest.42000000000500DC.quest_desc: [
		"天空的力量，在一个全是天空的平台上。",
		"方法：Powah Grid 章节 — 在 Spark Pulse 存在后，制作 energizing orb 和电缆。"
	]
	quest.42000000000500DC.title: "太阳能电池板入门包"
	quest.42000000000500DD.quest_desc: [
		"将温差转化为电能。一边输入高温，另一边输入低温。",
		"方法：Powah Grid 章节 — 在 Spark Pulse 存在后，制作 energizing orb 和电缆。"
	]
	quest.42000000000500DD.title: "热能发电机"
	quest.42000000000500DE.quest_desc: [
		"将物品放置于棒组成的环形阵列中充电。",
		"方法：Powah Grid 章节 — 在 Spark Pulse 存在后，制作 energizing orb 和电缆。"
	]
	quest.42000000000500DE.title: "能量球 (Energizing Orb)"
	quest.42000000000500DF.quest_desc: [
		"喂养这个球体。",
		"方法：Powah Grid 章节 — 在 Spark Pulse 存在后，制作 energizing orb 和电缆。"
	]
	quest.42000000000500DF.title: "能量化棒"
	quest.42000000000500E0.quest_desc: [
		"口袋里装满了储存的能量。",
		"方法：Powah Grid 章节 — 在 Spark Pulse 存在后，制作 energizing orb 和电缆。"
	]
	quest.42000000000500E0.title: "电池"
	quest.42000000000500E1.quest_desc: [
		"原地旋转机器，而不是将其破坏并替换。",
		"方法：Powah Grid 章节 — 在 Spark Pulse 存在后，制作 energizing orb 和电缆。"
	]
	quest.42000000000500E1.title: "扳手"
	quest.42000000000500E2.quest_desc: [
		"熔炼矿石的速度是普通熔炉的两倍，仅限矿石。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.42000000000500E2.title: "高炉 Blast Furnace"
	quest.42000000000500E3.quest_desc: [
		"烹饪速度是营火的2倍，仅限食物。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.42000000000500E3.title: "Smoker"
	quest.42000000000500E4.quest_desc: [
		"九块煤炭压成一块。一块顶上一整堆原矿。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.42000000000500E4.title: "煤炭块（火花）"
	quest.42000000000500E5.quest_desc: [
		"每次将物品推入其前方的任何容器中。",
		"方法：用红石周围的鹅卵石建造。"
	]
	quest.42000000000500E5.title: "物品投掷器"
	quest.42000000000500E6.quest_desc: [
		"带着目标去推动。",
		"方法：鹅卵石、弓和红石。"
	]
	quest.42000000000500E6.title: "分配器"
	quest.42000000000500E7.quest_desc: [
		"在接收到信号时向前推动一个方块，然后等待下一个信号。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.42000000000500E7.title: "活塞"
	quest.42000000000500E8.quest_desc: [
		"当信号消失时，会推出一块方块并将其拉回。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在面板上列出所有来源。"
	]
	quest.42000000000500E8.title: "粘性活塞"
	quest.42000000000500E9.quest_desc: [
		"观察者读取了节拍。",
		"方法：鹅卵石、红石和下界石英。"
	]
	quest.42000000000500E9.title: "观察者"
	quest.42000000000500EA.quest_desc: [
		"中继器控制电路的计时。",
		"方法：红石火把、红石、石头。管道章节用它来做时钟。"
	]
	quest.42000000000500EA.title: "中继器"
	quest.42000000000500EB.quest_desc: [
		"根据击中位置与中心的距离，以信号强度形式记录命中。",
		"方法：用红石围住干草。干草需要三个小麦。"
	]
	quest.42000000000500EB.title: "目标"
	quest.42000000000500EC.quest_desc: [
		"在屋顶以外的地方引雷，并引导电荷落地。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.42000000000500EC.title: "引雷针"
	quest.42000000000500ED.quest_desc: [
		"是时候展现真正的实力了。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.42000000000500ED.title: "时钟"
	quest.42000000000500EE.quest_desc: [
		"没有火把却有光亮。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.42000000000500EE.title: "铜制灯泡"
	quest.42000000000500EF.quest_desc: [
		"收到信号时亮起，信号停止后立即熄灭。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.42000000000500EF.title: "红石灯"
	quest.42000000000500F0.quest_desc: [
		"读取天空，并发送一个随太阳升降的信号。",
		"方法：玻璃、下界石英、木板。"
	]
	quest.42000000000500F0.title: "日光探测器"
	quest.42000000000500F1.quest_desc: [
		"手动开启或关闭信号。最古老的开关了。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.42000000000500F1.title: "Lever"
	quest.42000000000500F2.quest_desc: [
		"按钮会触发一次红石脉冲。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.42000000000500F2.title: "按钮"
	quest.42000000000500F3.quest_desc: [
		"当有比空气重的物体站在上面时会发出信号。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.42000000000500F3.title: "压力板"
	quest.42000000000500F4.quest_desc: [
		"用线穿过路径，能捕捉任何经过的东西。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.42000000000500F4.title: "压力板触发器"
	quest.42000000000500F5.quest_desc: [
		"每块方块下方会播放一个音符。鼓心人能在它们排成一行时听到一首歌。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在面板上列出所有来源。"
	]
	quest.42000000000500F5.title: "音符方块"
	quest.42000000000500F6.quest_desc: [
		"用于提升士气的音乐盒。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在面板上列出所有来源。"
	]
	quest.42000000000500F6.title: "唱片机"
	quest.42000000000500F7.quest_desc: [
		"在重力或推动下沿轨道滚动。没有轨道，就无法行驶。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.42000000000500F7.title: "矿车"
	quest.42000000000500F8.quest_desc: [
		"铁轨横跨虚空，绵延不绝。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在面板上列出所有来源。"
	]
	quest.42000000000500F8.title: "轨道"
	quest.42000000000500F9.quest_desc: [
		"用于矿车的动力铁轨。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在面板上列出所有来源。"
	]
	quest.42000000000500F9.title: "动力铁轨"
	quest.42000000000500FA.quest_desc: [
		"读取经过的矿车，并在其驶过时发出信号。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.42000000000500FA.title: "侦测轨道"
	quest.42000000000500FB.quest_desc: [
		"替代太阳能飞行器。",
		"方法：三块玻璃、三块青金石和三面镜子，各放一排。"
	]
	quest.42000000000500FB.title: "太阳能通量电池"
	quest.42000000000500FC.quest_desc: [
		"简易物品管道。",
		"方法：铁 + 红石。用 Pipez 扳手对准各个面。"
	]
	quest.42000000000500FC.title: "管道物品 (Pipez Item)"
	quest.42000000000500FD.quest_desc: [
		"简易流体管道。",
		"方法：铁 + 水桶 + 红石。潜行使用扳手提取侧面；右键该侧面可设置过滤器。"
	]
	quest.42000000000500FD.title: "Pipez 流体"
	quest.42000000000500FE.quest_desc: [
		"机器之间的普通能量管道。",
		"方法：铁 + 红石。在机器之间传输FE。"
	]
	quest.42000000000500FE.title: "管道能量系统 (Pipez Energy)"
	quest.42000000000500FF.quest_desc: [
		"设置管道从机器的哪一侧抽取，或切断一侧，而不会破坏管道。",
		"方法：两个燧石和两个木棍。潜行使用管道侧面于机器上以使其提取，再次使用以切断；右键点击提取侧面以设置过滤器。"
	]
	quest.42000000000500FF.title: "管道扳手 (Pipez Wrench)"
	quest.4200000000050100.quest_desc: [
		"标记晶格线 — 需要一个灵魂碎片。",
		"配方：骨粉、青金石和灵魂碎片各两个，无需特定顺序。可产出四个。"
	]
	quest.4200000000050100.title: "仪式用粉笔"
	quest.4200000000050101.quest_desc: [
		"鼓槌落下，脉冲蓄积，共鸣器就位。",
		"拉紧琴弦：鼓心部落回应了。",
		"认领它并从部落中选择一个礼物：一条用于共享生命的“回归之线”，或是补给品。",
		"方法：完成与此任务相关的任务，然后用 Strand 代币领取。将代币放置在你的 Tension Post 上。"
	]
	quest.4200000000050101.quest_subtitle: "嗯，让我想想，该怎么描述这个任务呢？"
	quest.4200000000050101.title: "火花结 (Spark Knot)"
	quest.4200000000050102.quest_desc: [
		"右键点击 Clowder's Tension Post 并使用令牌。",
		"凹槽灯亮起，部落铃铛作响，踏板发生变化。",
		"方法：手持 Strand token 右键点击你的 Tension Post。"
	]
	quest.4200000000050102.title: "座椅火花"
	quest.4200000000050103.quest_desc: [
		"跟随部落编织，经回响精炼至共振核心。谐波增效器将营地的和谐转化为本章机器的FE。未评级转换率为每秒60脉冲；在回响站评级可提高。它无法接收FE。红石会暂停转换和导出。",
		"配方：五个铜锭、三个红石和一个共振核心。"
	]
	quest.4200000000050103.title: "Hum 变为当前状态"
	quest.4200000000050104.quest_desc: [
		"夜晚，女巫出现在你的脚下。鼓声未能预警。",
		"方法：在夜间于平台上杀死女巫。"
	]
	quest.4200000000050104.title: "瓶装麻烦"
	quest.4200000000060105.quest_desc: [
		"在你睡觉时工作的双手。三十二。",
		"九族为下一窝猫留下了补给。使用管家宝箱可随机开启补给，或用四个小宝箱合成一个中宝箱，或用三个中宝箱合成一个大宝箱。大宝箱能装下更多卷轴和更丰富的补给种类，单独开启则能获得更基础的补给。里面没有机器或进度代币，但每个宝箱都有极小概率开出线团碎片，极小概率开出完整的回归之线，大宝箱的几率更高。",
		"方法：在合成台（或搅拌机）中用安山岩 + 铁粒。"
	]
	quest.4200000000060105.title: "安山岩合金"
	quest.4200000000060106.quest_desc: [
		"旋转脊柱。",
		"方法：在 JEI 中列出的合成配方里使用安山合金。"
	]
	quest.4200000000060106.title: "竖井"
	quest.4200000000060107.quest_desc: [
		"一个齿轮。然后再是同一个齿轮。",
		"方法：竖井 + 木板。"
	]
	quest.4200000000060107.title: "Cogwheel"
	quest.4200000000060108.quest_desc: [
		"牙齿更多，转向更慢。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.4200000000060108.title: "大型齿轮"
	quest.4200000000060109.quest_desc: [
		"安山岩外壳框架，创造模式。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.4200000000060109.title: "安山岩外壳"
	quest.420000000006010A.quest_desc: [
		"天空中有一条河流，正在转弯。",
		"方法：围绕一个竖井放置八个木板。旁边需要水流。"
	]
	quest.420000000006010A.title: "水车"
	quest.420000000006010B.quest_desc: [
		"当没有其他东西在旋转时，用手转动旋转方向。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.420000000006010B.title: "手动曲柄"
	quest.420000000006010C.quest_desc: [
		"用磨石将粗面粉磨成面粉，无需锤子。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.420000000006010C.title: "磨坊石"
	quest.420000000006010D.quest_desc: [
		"盆中装有创造混合器。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.420000000006010D.title: "盆地"
	quest.420000000006010E.quest_desc: [
		"石板与路径。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.420000000006010E.title: "机械压榨机"
	quest.420000000006010F.quest_desc: [
		"批量配方，速度飞快。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.420000000006010F.title: "机械搅拌机"
	quest.4200000000060110.quest_desc: [
		"用于固定物品在传送带或压机上的平坦表面。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.4200000000060110.title: "Depot"
	quest.4200000000060111.quest_desc: [
		"传送带将物品沿着竖井输送。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.4200000000060111.title: "传送带连接器"
	quest.4200000000060112.quest_desc: [
		"物品直接掉落至机器之间，无需传送带。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.4200000000060112.title: "滑道"
	quest.4200000000060113.quest_desc: [
		"清洗、烘干，并将砾石变成沙子。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.4200000000060113.title: "Encased Fan"
	quest.4200000000060114.quest_desc: [
		"一根手柄，装在杆子上。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.4200000000060114.title: "部署器"
	quest.4200000000060115.quest_desc: [
		"有足够的旋转次数，可将原木切成木板或将树木砍成木材。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.4200000000060115.title: "机械锯子"
	quest.4200000000060116.quest_desc: [
		"钻透砾石方块。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.4200000000060116.title: "机械钻头"
	quest.4200000000060117.quest_desc: [
		"以旋转的弧线收割庄稼。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.4200000000060117.title: "机械收割机"
	quest.4200000000060118.quest_desc: [
		"无需搬起一个箱子，即可装载或清空已停下的火车的货物。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.4200000000060118.title: "便携式存储接口"
	quest.4200000000060119.quest_desc: [
		"将九个箱子的存储空间整合成一个大型方块。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.4200000000060119.title: "物品宝库"
	quest.420000000006011A.quest_desc: [
		"可大量储存液体，并与相邻方块连接以储存更多。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.420000000006011A.title: "流体储罐"
	quest.420000000006011B.quest_desc: [
		"将流体倾倒入盆中。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.420000000006011B.title: "Spout"
	quest.420000000006011C.quest_desc: [
		"从源头抽取流体。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.420000000006011C.title: "软管滑轮"
	quest.420000000006011D.quest_desc: [
		"标志着建筑的流体处理侧，安山岩的更华丽表亲。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.420000000006011D.title: "铜质外壳"
	quest.420000000006011E.quest_desc: [
		"涵盖那些仅靠旋转无法满足的精密机器。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.420000000006011E.title: "黄铜外壳"
	quest.420000000006011F.quest_desc: [
		"机械之心。需要一颗束缚结作为核心。",
		"织布机，请求被包含在内。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.420000000006011F.title: "精密机械装置"
	quest.4200000000060120.quest_desc: [
		"控制旋转速度。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.4200000000060120.title: "旋转速度控制器"
	quest.4200000000060121.quest_desc: [
		"转过这个弯角。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.4200000000060121.title: "齿轮箱"
	quest.4200000000060122.quest_desc: [
		"离合器停止了一个传动轴线路。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.4200000000060122.title: "抓紧了"
	quest.4200000000060123.quest_desc: [
		"齿轮换挡会翻转旋转方向。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.4200000000060123.title: "齿轮换挡器"
	quest.4200000000060124.quest_desc: [
		"程序化的旋转。图案编织者的歌谣，已被记下。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.4200000000060124.title: "顺序化的齿轮换挡器"
	quest.4200000000060125.quest_desc: [
		"快速旋转时，会在盆中混合各种材料。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.4200000000060125.title: "用刷子刷干净所有东西，然后交给我。"
	quest.4200000000060126.quest_desc: [
		"安装在轴上会旋转并推动空气，或安装在船上会推动船。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.4200000000060126.title: "螺旋桨"
	quest.4200000000060127.quest_desc: [
		"风车能捕捉风力，如果想有图案，也很容易染色。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.4200000000060127.title: "白色风帆"
	quest.4200000000060128.quest_desc: [
		"将一圈风帆转化为直接从天空中拉来的旋转动力。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.4200000000060128.title: "风车轴承"
	quest.4200000000060129.quest_desc: [
		"将整个结构围绕一个固定点旋转，包括墙壁在内。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.4200000000060129.title: "机械轴承"
	quest.420000000006012A.quest_desc: [
		"龙门吊沿着轨道滑动。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.420000000006012A.title: "龙门架车厢"
	quest.420000000006012B.quest_desc: [
		"将固定建筑转变为沿轨道行驶的建筑。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.420000000006012B.title: "Cart Assembler"
	quest.420000000006012C.quest_desc: [
		"将两节矿车连接起来，使其像一列火车一样行驶。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.420000000006012C.title: "矿车连接器"
	quest.420000000006012D.quest_desc: [
		"铺设矿车或装置所行驶的轨道。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.420000000006012D.title: "轨道"
	quest.420000000006012E.quest_desc: [
		"车厢的火车门。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.420000000006012E.title: "火车门"
	quest.420000000006012F.quest_desc: [
		"规划火车路线。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.420000000006012F.title: "日程安排"
	quest.4200000000060130.quest_desc: [
		"在你能看到的方块上显示来自别处的数字。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.4200000000060130.title: "显示链接"
	quest.4200000000060131.quest_desc: [
		"显示板会显示数据。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.4200000000060131.title: "显示板"
	quest.4200000000060132.quest_desc: [
		"发射一颗足以击退物体的土豆。主要是为了好玩。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.4200000000060132.title: "土豆大炮"
	quest.4200000000060133.quest_desc: [
		"能伸得更远，打破手臂长度无法触及的方块。",
		"方法：在 JEI 中制作（合成台、压机、搅拌机或部署器）。安山合金和水轮是起点。"
	]
	quest.4200000000060133.title: "Extendo Grip"
	quest.4200000000060134.quest_desc: [
		"一个轮子，一个压榨机，一个搅拌机，一个风扇，一个钟表之心。",
		"拉紧丝线：织纹者的回应。",
		"认领它并从部落中选择一个礼物：一条用于共享生命的“回归之线”，或是补给品。",
		"方法：完成与此任务相关的任务，然后用 Strand 代币领取。将代币放置在你的 Tension Post 上。"
	]
	quest.4200000000060134.quest_subtitle: "图案"
	quest.4200000000060134.title: "时钟节点"
	quest.4200000000060135.quest_desc: [
		"右键点击 Clowder's Tension Post 并使用令牌。",
		"凹槽灯亮起，部落铃铛作响，踏板发生变化。",
		"稀有奖励：一次共享的 Clowder 生命，全队共享。整个战役中仅有六个此类奖励。",
		"方法：手持 Strand token 右键点击你的 Tension Post。"
	]
	quest.4200000000060135.title: "座椅时钟"
	quest.4200000000060136.quest_desc: [
		"二十具骷髅。保持灯光开启，规律就会成立。",
		"方法：杀死二十只骷髅。保持踏板处于激活状态。"
	]
	quest.4200000000060136.title: "齿轮中的咔嗒声"
	quest.4200000000070137.quest_desc: [
		"将橡木巢放在基座上，用小花右键点击它。等待。有翅膀的东西会从木头里钻出来。",
		"看看它。这也算数了。",
		"方法：用小花右键橡树巢穴，然后看向第一只飞出来的蜜蜂。"
	]
	quest.4200000000070137.quest_subtitle: "殖民地"
	quest.4200000000070137.title: "第一双翅膀"
	quest.4200000000070138.quest_desc: [
		"八根橡木原木环绕着一朵小花。放置它，并用另一朵花唤醒它；木材会记住翅膀。",
		"九族为下一窝猫留下了补给。使用管家宝箱可随机开启补给，或用四个小宝箱合成一个中宝箱，或用三个中宝箱合成一个大宝箱。大宝箱能装下更多卷轴和更丰富的补给种类，单独开启则能获得更基础的补给。里面没有机器或进度代币，但每个宝箱都有极小概率开出线团碎片，极小概率开出完整的回归之线，大宝箱的几率更高。",
		"方法：将巢穴材料环绕在小花周围。放置后，用小花右键唤醒它；过一会儿蜜蜂就会出来。"
	]
	quest.4200000000070138.title: "橡木戒指"
	quest.4200000000070139.quest_desc: [
		"草地上撒上骨粉。蜜蜂不会停留在没有花朵的地方。",
		"方法：骨粉加草。蜜蜂需要任何小花。"
	]
	quest.4200000000070139.title: "一朵用来争吵的花"
	quest.420000000007013A.quest_desc: [
		"木板和花朵——野生蜜蜂会搬进去的家。",
		"方法：两排木板之间放三朵小花。蜂群会命名巢穴。"
	]
	quest.420000000007013A.title: "蜂巢"
	quest.420000000007013B.quest_desc: [
		"风中的殖民地。在/clowder hub的殖民地守护者摊位可以买到梳子，如果没有流浪者经过的话。",
		"方法：蜜蜂采集花朵后，剪下蜂巢或蜂箱。/clowder hub 的 Colony-keepers' stall 以 16 个 Thread 出售八个。"
	]
	quest.420000000007013B.title: "蜂巢蜜块"
	quest.420000000007013C.quest_desc: [
		"为工人准备的住所。",
		"方法：三个蜂巢和六个木板。在下方生个篝火可以安抚它们。"
	]
	quest.420000000007013C.title: "蜂巢"
	quest.420000000007013D.quest_desc: [
		"香甜、黏稠，对熔炉的价值远大于你的胃。",
		"方法：将玻璃瓶放在完整的蜂巢上。下方放置篝火。"
	]
	quest.420000000007013D.title: "蜂蜜瓶（蜂群）"
	quest.420000000007013E.quest_desc: [
		"在伸手进入蜂巢前，能让躁动的蜜蜂平静下来的点心。",
		"配方：蜂巢加蜂蜜瓶，无需特定顺序。"
	]
	quest.420000000007013E.title: "蜂蜜小点心"
	quest.420000000007013F.quest_desc: [
		"花朵周围的砾石。采矿蜜蜂和挖掘者喜欢这种尘埃。",
		"方法：将巢穴材料环绕在小花周围。放置后，用小花右键唤醒它；过一会儿蜜蜂就会出来。"
	]
	quest.420000000007013F.title: "坚韧戒指 (Ring of Grit)"
	quest.4200000000070140.quest_desc: [
		"花朵周围的粗土。叶切蚁和灰矿工。",
		"方法：将巢穴材料环绕在小花周围。放置后，用小花右键唤醒它；过一会儿蜜蜂就会出来。"
	]
	quest.4200000000070140.title: "粗糙泥土戒指 (Ring of Coarse Dirt)"
	quest.4200000000070141.quest_desc: [
		"花朵周围的石头。石匠蜜蜂和啃食岩石的挖掘者。",
		"方法：将巢穴材料环绕在小花周围。放置后，用小花右键唤醒它；过一会儿蜜蜂就会出来。"
	]
	quest.4200000000070141.title: "石之戒指"
	quest.4200000000070142.quest_desc: [
		"一个富有成效的家园。",
		"方法：JEI中制作生产蜜蜂。蜂群名称、蜂巢、离心机和繁殖步骤。"
	]
	quest.4200000000070142.title: "高级蜂巢"
	quest.4200000000070143.quest_desc: [
		"在蜂群分群寻找新巢穴前，为蜂巢提供更多空间。",
		"方法：JEI中制作生产蜜蜂。蜂群名称、蜂巢、离心机和繁殖步骤。"
	]
	quest.4200000000070143.title: "扩展箱 Expansion Box"
	quest.4200000000070144.quest_desc: [
		"瓶子在没有手接触的情况下也能产出作物。",
		"方法：JEI中制作生产蜜蜂。蜂群名称、蜂巢、离心机和繁殖步骤。"
	]
	quest.4200000000070144.title: "装瓶器"
	quest.4200000000070145.quest_desc: [
		"将梳子旋转，让它们隐藏在一切之中。",
		"方法：JEI中制作生产蜜蜂。蜂群名称、蜂巢、离心机和繁殖步骤。"
	]
	quest.4200000000070145.title: "离心机"
	quest.4200000000070146.quest_desc: [
		"同样的东西，更快的速度，更强的动力。",
		"方法：JEI中制作生产蜜蜂。蜂群名称、蜂箱、离心机和繁殖步骤。"
	]
	quest.4200000000070146.title: "动力离心机"
	quest.4200000000070147.quest_desc: [
		"在空中捕捉蜜蜂，完全不会受到叮咬。",
		"方法：JEI中制作生产蜜蜂。蜂群名称、蜂巢、离心机和繁殖步骤。"
	]
	quest.4200000000070147.title: "捕手"
	quest.4200000000070148.quest_desc: [
		"像提灯笼一样携带蜜蜂。",
		"方法：JEI中制作生产蜜蜂。蜂群名称、蜂巢、离心机和繁殖步骤。"
	]
	quest.4200000000070148.title: "蜜蜂笼"
	quest.4200000000070149.quest_desc: [
		"孵化你想要的基因。",
		"方法：JEI中合成“Productive Bees”。蜂群名称、离心机和繁殖步骤。"
	]
	quest.4200000000070149.title: "孵化器"
	quest.420000000007014A.quest_desc: [
		"有意地配对两个殖民地。",
		"方法：JEI中合成“Productive Bees”。蜂群名称、离心机和繁殖步骤。"
	]
	quest.420000000007014A.title: "繁殖室"
	quest.420000000007014B.quest_desc: [
		"像种子一样对特性进行排序。",
		"方法：JEI中制作生产蜜蜂。蜂群名称、蜂巢、离心机和繁殖步骤。"
	]
	quest.420000000007014B.title: "基因索引器"
	quest.420000000007014C.quest_desc: [
		"一堆美食：殖民地的工资单。",
		"配方：蜂巢加蜂蜜瓶，无需特定顺序。"
	]
	quest.420000000007014C.title: "喂食升级"
	quest.420000000007014D.quest_desc: [
		"一种更深层的精华作物，远超基础作物的生长范围。",
		"方法：在JEI中用神秘农业合成。Inferium和Prosperity来自筛子；种子在Infusion Altar上灌注。"
	]
	quest.420000000007014D.title: "钻石种子"
	quest.420000000007014E.quest_desc: [
		"一个农场地块，可以产出尘埃，无需挖掘获取。",
		"方法：在JEI中用神秘农业合成。Inferium和Prosperity来自筛子；种子在Infusion Altar上灌注。"
	]
	quest.420000000007014E.title: "红石种子"
	quest.420000000007014F.quest_desc: [
		"生长出蓝色精华，附魔台总是饥渴难耐。",
		"方法：在JEI中用神秘农业合成。Inferium和Prosperity来自筛子；种子在Infusion Altar上灌注。"
	]
	quest.420000000007014F.title: "青金石种子"
	quest.4200000000070150.quest_desc: [
		"在农田里种植的石英，而不是从下界洞穴中挖掘的。",
		"方法：在JEI中用神秘农业合成。Inferium和Prosperity来自筛子；种子在Infusion Altar上灌注。"
	]
	quest.4200000000070150.title: "下界石英种子"
	quest.4200000000070151.quest_desc: [
		"比挖掘下界天花板更温和的刷光方法。",
		"方法：在JEI中用神秘农业合成。Inferium和Prosperity来自筛子；种子在Infusion Altar上灌注。"
	]
	quest.4200000000070151.title: "Glowstone Seeds"
	quest.4200000000070152.quest_desc: [
		"一种无需岩浆桶即可产出黑曜石精粹的硬化作物。",
		"方法：在JEI中用神秘农业合成。Inferium和Prosperity来自筛子；种子在Infusion Altar上灌注。"
	]
	quest.4200000000070152.title: "黑曜石种子"
	quest.4200000000070153.quest_desc: [
		"高浓度的精华。田野间如今一片繁忙景象。",
		"方法：在JEI中用神秘农业合成。Inferium和Prosperity来自筛子；种子在Infusion Altar上灌注。"
	]
	quest.4200000000070153.title: "帝国"
	quest.4200000000070154.quest_desc: [
		"最后一个精华等级。无论你建什么，这都才是好的版本。",
		"方法：在JEI中用神秘农业合成。Inferium和Prosperity来自筛子；种子在Infusion Altar上灌注。"
	]
	quest.4200000000070154.title: "Supremium"
	quest.4200000000070155.quest_desc: [
		"蜂群盈余，已堆叠完毕。",
		"方法：四个蜂蜜瓶。瓶子会返还。"
	]
	quest.4200000000070155.title: "蜂蜜块"
	quest.4200000000070156.quest_desc: [
		"在你建造巢穴之前并不存在的蜜蜂。",
		"矿工、石匠、挖掘者、木匠——看哪一个。",
		"方法：巢穴激活后，看向一只生产蜜蜂。第一对翅膀是橡木巢。"
	]
	quest.4200000000070156.quest_subtitle: "殖民地"
	quest.4200000000070156.title: "Something New Hums 嗡嗡作响的新事物"
	quest.4200000000070157.quest_desc: [
		"花周围的沙子。灰土和巧克力矿工。",
		"方法：将巢穴材料环绕在小花周围。放置后，用小花右键唤醒它；过一会儿蜜蜂就会出来。"
	]
	quest.4200000000070157.title: "沙之戒指"
	quest.4200000000070158.quest_desc: [
		"花周围的甘蔗。芦苇蜜蜂和石匠。",
		"方法：将巢穴材料环绕在小花周围。放置后，用小花右键唤醒它；过一会儿蜜蜂就会出来。"
	]
	quest.4200000000070158.title: "芦苇戒指"
	quest.4200000000070159.quest_desc: [
		"花周围的史莱姆块。猜一猜。",
		"方法：将巢穴材料环绕在小花周围。放置后，用小花右键点击以唤醒它；一段时间后蜜蜂会出来。"
	]
	quest.4200000000070159.title: "史莱姆戒指"
	quest.420000000007015A.quest_desc: [
		"花丛周围有草。有熊蜂，也有普通蜜蜂。",
		"方法：将巢穴材料环绕在小花周围。放置后，用小花右键唤醒它；过一会儿蜜蜂就会出来。"
	]
	quest.420000000007015A.title: "干草戒指"
	quest.420000000007015B.quest_desc: [
		"花周围的雪。奇怪的是，还有蜜蜂。",
		"方法：将巢穴材料环绕在小花周围。放置后，用小花右键唤醒它；过一会儿蜜蜂就会出来。"
	]
	quest.420000000007015B.title: "雪之戒指"
	quest.420000000007015C.quest_desc: [
		"燃烧蜂蜜以获取能量。蜂巢身兼二职。",
		"方法：JEI中制作生产蜜蜂。蜂群名称、蜂巢、离心机和繁殖步骤。"
	]
	quest.420000000007015C.title: "蜂蜜生成器"
	quest.420000000007015D.quest_desc: [
		"展示一只蜜蜂，包括翅膀，但没有附着蜂巢。",
		"方法：JEI中制作生产蜜蜂。蜂群名称、蜂巢、离心机和繁殖步骤。"
	]
	quest.420000000007015D.title: "Jar"
	quest.420000000007015E.quest_desc: [
		"在采集蜂巢蜜之前，先安抚一下蜂箱里的蜜蜂。",
		"方法：原木、木棍和煤炭或木炭。"
	]
	quest.420000000007015E.title: "篝火 (蜂群)"
	quest.420000000007015F.quest_desc: [
		"每年喂食蜜蜂和花朵两次，其余时间保持常绿。",
		"方法：苔藓加橡木，或用骨粉催生苔藓。蜜蜂会接受花蕾。"
	]
	quest.420000000007015F.title: "开花杜鹃花（蜂群）"
	quest.4200000000070160.quest_desc: [
		"高大、黄色，总是朝向太阳。蜜蜂很容易找到它。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在面板上列出所有来源。"
	]
	quest.4200000000070160.title: "向日葵"
	quest.4200000000070161.quest_desc: [
		"两块紫色花丛，蜜蜂会穿过踏板才能到达。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000070161.title: "紫罗兰色"
	quest.4200000000070162.quest_desc: [
		"蜜蜂喜欢的高大花朵，花园又多了一种颜色。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000070162.title: "玫瑰灌木"
	quest.4200000000070163.quest_desc: [
		"粉红色且饱满，种植在蜂巢附近需要更多食物的地方。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000070163.title: "牡丹花（Peony）"
	quest.4200000000070164.quest_desc: [
		"一朵短小单株的花，但蜜蜂不介意高度。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000070164.title: "橙色郁金香"
	quest.4200000000070165.quest_desc: [
		"你建造的巢穴，你迁移的蜂群，离心机，孵化器，精华原野。",
		"拉紧蛛丝：殖民者们的回应。",
		"认领它并从部落中选择一个礼物：一条用于共享生命的“回归之线”，或是补给品。",
		"方法：完成与此任务相关的任务，然后用 Strand 代币领取。将代币放置在你的 Tension Post 上。"
	]
	quest.4200000000070165.quest_subtitle: "殖民地"
	quest.4200000000070165.title: "蜂群节点"
	quest.4200000000070166.quest_desc: [
		"右键点击 Clowder's Tension Post 并使用令牌。",
		"凹槽灯亮起，部落铃铛作响，踏板发生变化。",
		"方法：手持 Strand token 右键点击你的 Tension Post。"
	]
	quest.4200000000070166.title: "蜂群座椅"
	quest.4200000000070167.quest_desc: [
		"你杀死了一只蜜蜂。",
		"殖民者想和你谈谈。这是一瓶信，请仔细考虑一下。",
		"方法：杀死一只蜜蜂（隐藏）。瓶子就是线索。"
	]
	quest.4200000000070167.title: "后悔"
	quest.4200000000080168.quest_desc: [
		"管家们在水晶中留下了陷阱。三十二块碎片。",
		"九族为下一窝猫留下了补给。使用管家宝箱可随机开启补给，或用四个小宝箱合成一个中宝箱，或用三个中宝箱合成一个大宝箱。大宝箱能装下更多卷轴和更丰富的补给种类，单独开启则能获得更基础的补给。里面没有机器或进度代币，但每个宝箱都有极小概率开出线团碎片，极小概率开出完整的回归之线，大宝箱的概率更高。",
		"方法：用筛子，或者用生长出的晶洞线获取紫晶。Occultism需要碎片。"
	]
	quest.4200000000080168.title: "紫水晶"
	quest.4200000000080169.quest_desc: [
		"右键点击持有 16 Strand Filaments 的张力柱。无需安装任何 Strand。",
		"绑定就此开始。",
		"方法：右键点击持有16根纤维线的张力柱。用铁质纱网筛取砾石或沙子来寻找它们。"
	]
	quest.4200000000080169.title: "编织绳 (Braid Cord)"
	quest.420000000008016A.quest_desc: [
		"在雕刻之前，先写下仪式的咒文。",
		"方法：书、墨囊、羽毛。木炭加玻璃瓶可以制作墨水。"
	]
	quest.420000000008016A.title: "书和羽毛笔"
	quest.420000000008016B.quest_desc: [
		"强大的工具，源自柔和的力量。",
		"方法：钻石两个，黑曜石四个，书一本。钻石来自铁丝网砾石。"
	]
	quest.420000000008016B.title: "附魔台（符文）"
	quest.420000000008016C.quest_desc: [
		"为桌子补充燃料。",
		"方法：九个青金石。筛选砾石或回响破碎青金石矿石。"
	]
	quest.420000000008016C.title: "青金石方块"
	quest.420000000008016D.quest_desc: [
		"围绕附魔台放置，可解锁其最强的附魔效果。",
		"方法：六个木板和三个书。书是纸加皮革。"
	]
	quest.420000000008016D.title: "书架"
	quest.420000000008016E.quest_desc: [
		"深度治愈，并赋予一分钟后会褪去的闪耀效果。",
		"方法：八个金锭围成一个苹果。不是附魔的那个。"
	]
	quest.420000000008016E.title: "金苹果"
	quest.420000000008016F.quest_desc: [
		"跳过掉落物品这一部分。",
		"方法：末影人，或/clowder hub 边缘行者的小摊。"
	]
	quest.420000000008016F.title: "末影珍珠"
	quest.4200000000080170.quest_desc: [
		"将水瓶变成具有实际效果的物品。",
		"方法：烈焰棒加三块鹅卵石。烈焰棒来自下界堡垒的爪形黑曜石。"
	]
	quest.4200000000080170.title: "酿造台"
	quest.4200000000080171.quest_desc: [
		"为药水提供热量。",
		"方法：用烈焰棒合成，或在堡垒中挖掘爪状黑曜石。"
	]
	quest.4200000000080171.title: "烈焰粉"
	quest.4200000000080172.quest_desc: [
		"为酿造台提供燃料，并证明你已经直面了下界。",
		"方法：爪黑曜石后的下界堡垒。酿造需要一根杖；Ars和Occultism不等待它。"
	]
	quest.4200000000080172.title: "烈焰棒"
	quest.4200000000080173.quest_desc: [
		"故意将药水的效果扭曲成更糟糕的东西。",
		"方法：蜘蛛眼、褐色蘑菇、糖。"
	]
	quest.4200000000080173.title: "发酵之眼"
	quest.4200000000080174.quest_desc: [
		"配方所需的萤石粉。",
		"方法：筛选灵魂沙，或用女巫在平台上。"
	]
	quest.4200000000080174.title: "Glowstone Dust (Sigil)"
	quest.4200000000080175.quest_desc: [
		"守护末地的生物所赋予的气息。",
		"方法：将玻璃瓶放在龙上。末地岛屿消失了。可选。"
	]
	quest.4200000000080175.title: "龙之息 (Dragon Breath)"
	quest.4200000000080176.quest_desc: [
		"还有一次机会。",
		"可选 — 没有袭击会到达着陆点，该整合包也不会制作一个。",
		"方法：仅限任务奖励。Seat Clock和Seat Sigil各给一个，晚期Strand Knot礼物会提供更多。劫掠和唤魔者绝不会来到这个平台。可选。"
	]
	quest.4200000000080176.title: "图腾"
	quest.4200000000080177.quest_desc: [
		"储存源，燃料咒语燃烧殆尽。",
		"方法：神秘侧 — 苔藓中的拱形木和源浆果，然后是瀑布。"
	]
	quest.4200000000080177.title: "源宝石 Source Gem"
	quest.4200000000080178.quest_desc: [
		"已生长，未发现。用于铸造工具和法术基座的木材。",
		"方法：神秘侧 — 苔藓中的拱形木和源浆果，然后是瀑布。"
	]
	quest.4200000000080178.title: "远古木"
	quest.4200000000080179.quest_desc: [
		"首先是法术。如果你想和仪式并列，就用同阶魔法。",
		"方法：Arcane Side — 苔藓中的拱形木材和源浆果，然后是瀑布。"
	]
	quest.4200000000080179.title: "新手魔法书"
	quest.420000000008017A.quest_desc: [
		"一种神秘作物，既因其魔法，也因其织物而种植。",
		"方法：神秘侧 — 苔藓中的拱形木和源浆果，然后是瀑布。"
	]
	quest.420000000008017A.title: "法师之花"
	quest.420000000008017B.quest_desc: [
		"用于仪式工作的火盆。",
		"方法：神秘侧 — 苔藓中的拱形木和源浆果，然后是瀑布。"
	]
	quest.420000000008017B.title: "仪式祭坛"
	quest.420000000008017C.quest_desc: [
		"显示一种试剂，并将其投入需要它的仪式中。",
		"方法：Arcane Side — 苔藓中的拱形木材和源浆果，然后是瀑布。"
	]
	quest.420000000008017C.title: "神秘祭坛 (Arcane Pedestal)"
	quest.420000000008017D.quest_desc: [
		"书写咒语和书页。",
		"方法：Arcane Side — 苔藓中的拱形木材和源浆果，然后是瀑布。"
	]
	quest.420000000008017D.title: "抄写员工作台"
	quest.420000000008017E.quest_desc: [
		"将源能量注入反应物中。",
		"方法：神秘侧 — 苔藓中的拱形木和源浆果，然后是瀑布。"
	]
	quest.420000000008017E.title: "附魔室 (Imbuement Chamber)"
	quest.420000000008017F.quest_desc: [
		"储存额外的源，确保法术在施放过程中不会枯竭。",
		"方法：Arcane Side — 苔藓中的拱形木材和源浆果，然后是瀑布。"
	]
	quest.420000000008017F.title: "源 Jar 文件"
	quest.4200000000080180.quest_desc: [
		"用名字呼唤灵魂，让它们现身。",
		"方法：一本书和恶魔之梦种子，无需特定配方。阅读它；接下来是灵魂之火。"
	]
	quest.4200000000080180.title: "Occultism Dictionary"
	quest.4200000000080181.quest_desc: [
		"一种用于仪式的冷火焰，普通火焰无法将其熄灭。",
		"方法：按照《灵魂词典》所示点燃灵魂之火（它会燃烧！），然后将安山岩投入其中。"
	]
	quest.4200000000080181.title: "灵魂之火"
	quest.4200000000080182.quest_desc: [
		"召唤的焦点。仪式需要耐心。",
		"方法：用黄金环绕祭品碗。词典会说明仪式名称。"
	]
	quest.4200000000080182.title: "黄金祭品碗"
	quest.4200000000080183.quest_desc: [
		"以周围土地为基准，调整了光环合成系统。",
		"方法：森林仪式 (JEI)：三个石头、一个金叶子、一个金锭和一个欢乐代币。光环之心系列。"
	]
	quest.4200000000080183.title: "自然祭坛"
	quest.4200000000080184.quest_desc: [
		"被高能量浸染的植物，被纺成更稀有的东西。",
		"方法：在短草周围放置四片树叶和四个金粒，可获得四根璀璨纤维。将其置于树冠上，树叶会随时间变金。"
	]
	quest.4200000000080184.title: "璀璨纤维"
	quest.4200000000080185.quest_desc: [
		"被光环浸染的材料，比它躺在地上时的样子要珍贵得多。",
		"方法：破坏由 Brilliant Fiber 生长出的金叶。"
	]
	quest.4200000000080185.title: "金叶子"
	quest.4200000000080186.quest_desc: [
		"吸收了周围灵气，价值超过矿石本身的铁。",
		"方法：树上的 Brilliant Fiber → Gold Leaf → Natural Altar。Aura 章节名称的令牌和生成器。"
	]
	quest.4200000000080186.title: "附魔铁块 (Infused Iron)"
	quest.4200000000080187.quest_desc: [
		"让你能看到周围土地的灵气等级。",
		"配方：金箔 + 蜘蛛眼。显示局部气场。"
	]
	quest.4200000000080187.title: "眼睛"
	quest.4200000000080188.quest_desc: [
		"一份喜悦的赠礼。自然祭坛和食草吸收器都建在它上面。",
		"方法：树上的 Brilliant Fiber → Gold Leaf → Natural Altar。Aura 章节名称的令牌和生成器。"
	]
	quest.4200000000080188.title: "快乐的代币"
	quest.4200000000080189.quest_desc: [
		"法术卷轴库存。",
		"方法：神秘侧 — 苔藓中的拱形木和源浆果，然后是瀑布。"
	]
	quest.4200000000080189.title: "法术羊皮纸"
	quest.420000000008018A.quest_desc: [
		"用言语而非脚步，标记一个可以返回的地点。",
		"方法：神秘侧 — 苔藓中的拱形木和源浆果，然后是瀑布。"
	]
	quest.420000000008018A.title: "传送卷轴"
	quest.420000000008018B.quest_desc: [
		"种植它，照料它，收获浸透了低魔力的布料。",
		"方法：Arcane Side — 苔藓中的拱形木材和源浆果，然后是瀑布。"
	]
	quest.420000000008018B.title: "Magebloom作物"
	quest.420000000008018C.quest_desc: [
		"咒语被书写上去的空白书页。",
		"方法：神秘侧 — 苔藓中的拱形木和源浆果，然后是瀑布。"
	]
	quest.420000000008018C.title: "空白符文"
	quest.420000000008018D.quest_desc: [
		"无需手持魔杖即可施放战斗法术。",
		"配方：三个铁链、四个皮革和两张纸。法术章节名称的墨水。"
	]
	quest.420000000008018D.title: "铁匠的魔法书"
	quest.420000000008018E.quest_desc: [
		"燃料耗尽的施法者们，一个又一个地释放着法术。",
		"方法：击杀施法者或在JEI中制作。用于制作墨水和书籍的燃料。"
	]
	quest.420000000008018E.title: "神秘精华 (Arcane Essence)"
	quest.420000000008018F.quest_desc: [
		"将法术逐层刻录到一本书中。",
		"方法：瓶子 + 精华 + 染料。首个铭文墨水。"
	]
	quest.420000000008018F.title: "普通墨水（Ink Common）"
	quest.4200000000080190.quest_desc: [
		"仪式使用的颜色。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000080190.title: "神秘的花朵"
	quest.4200000000080191.quest_desc: [
		"来自深邃黑暗的回响。",
		"可选的——虚空可能永远不会提供一个。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.4200000000080191.title: "回声碎片"
	quest.4200000000080192.quest_desc: [
		"编织发辫，调制药水，召唤咒语与灵魂。",
		"拉紧琴弦：封印匠们做出了回应。",
		"认领它并从部落中选择一个礼物：一条用于共享生命的“回归之线”，或是补给品。",
		"方法：完成与此任务相关的任务，然后用 Strand 代币领取。将代币放置在你的 Tension Post 上。"
	]
	quest.4200000000080192.quest_subtitle: "绑定"
	quest.4200000000080192.title: "Sigil Knot"
	quest.4200000000080193.quest_desc: [
		"右键点击 Clowder's Tension Post 并使用令牌。",
		"凹槽灯亮起，部落铃铛作响，踏板发生变化。",
		"稀有奖励：一次共享的 Clowder 生命，全队共享。整个战役中仅有六个此类奖励。",
		"方法：手持 Strand token 右键点击你的 Tension Post。"
	]
	quest.4200000000080193.title: "座椅符文"
	quest.4200000000080194.quest_desc: [
		"一个管家们从未吃过的苹果。你大概也不应该吃。",
		"方法：非合成台。可选的秘诀——它不会封锁Sigil Knot。"
	]
	quest.4200000000080194.title: "旧黄金"
	quest.4200000000090195.quest_desc: [
		"铁丝网、砾石或沙子，还有耐心。",
		"Strand Filament 是织布机的专属纱线。辫子就是用它纺成的。",
		"九族为下一窝猫留下了补给。使用管家宝箱可随机开启补给，或用四个小宝箱合成一个中宝箱，或用三个中宝箱合成一个大宝箱。大宝箱能装下更多卷轴和更丰富的补给种类，单独开启则能获得更基础的补给。里面没有机器或进度代币，但每个宝箱都有极小概率开出线团碎片，极小概率开出完整的回归之线，大宝箱的几率更高。",
		"方法：在砾石、沙子或尘土上放置铁线网格（织布机框架或筛子）。"
	]
	quest.4200000000090195.title: "旋转纺锤线"
	quest.4200000000090196.quest_desc: [
		"十六根纤维，右键点击一次电线杆。",
		"绑定已开始；重织由此开始。",
		"方法：右键点击持有16根纤维线的张力柱。用铁质纱网筛取砾石或沙子来寻找它们。"
	]
	quest.4200000000090196.title: "将一缕头发编织成辫子"
	quest.4200000000090197.quest_desc: [
		"Certus quartz — 数字织布机的冰冷丝线。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.4200000000090197.title: "寒冷的纬线 (Cold Weft)"
	quest.4200000000090198.quest_desc: [
		"地面石英，数字织布机的基础材料。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.4200000000090198.title: "Certus 尘埃"
	quest.4200000000090199.quest_desc: [
		"每个网络机器的外壳方块，开采自 certus 矿床。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.4200000000090199.title: "天空石"
	quest.420000000009019A.quest_desc: [
		"Fluix — 在水中充能的 certus、石英和红石。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.420000000009019A.title: "充能传送门"
	quest.420000000009019B.quest_desc: [
		"石英、红石和玻璃的混合物，研磨成粉用于网络合成。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.420000000009019B.title: "Fluix 粉尘"
	quest.420000000009019C.quest_desc: [
		"用于AE2处理器的硅晶圆。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.420000000009019C.title: "硅晶圆"
	quest.420000000009019D.quest_desc: [
		"铭文师压制电路，就像织布机压制布料一样。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.420000000009019D.title: "按下图案按钮以继续任务。"
	quest.420000000009019E.quest_desc: [
		"用织布机织布的方式，将硅板进行压制。",
		"方法：铁块、绑定结、铁和石英。AE2 只会复制你已有的压机。"
	]
	quest.420000000009019E.title: "Inscriber Silicon Press"
	quest.420000000009019F.quest_desc: [
		"为逻辑处理器冲压模具，每次按压一个。",
		"方法：铁块、绑定结、铁和金。第一个副本是结的合成配方。"
	]
	quest.420000000009019F.title: "逻辑压缩器"
	quest.42000000000901A0.quest_desc: [
		"为计算处理器盖印模具。",
		"方法：铁块、绑定之结、铁和 certus（筛沙）。第一份是结的配方。"
	]
	quest.42000000000901A0.title: "计算压机"
	quest.42000000000901A1.quest_desc: [
		"工程学配方合成。",
		"方法：铁块、绑定结、铁和钻石。第一个是结的合成配方。"
	]
	quest.42000000000901A1.title: "Engineering Press"
	quest.42000000000901A2.quest_desc: [
		"AE2的逻辑处理器。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901A2.title: "逻辑处理器"
	quest.42000000000901A3.quest_desc: [
		"自动合成配方中的一个组件，由硅和 Certus 石英制成。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901A3.title: "计算处理器 (Calculation Processor)"
	quest.42000000000901A4.quest_desc: [
		"更密集的处理器，用于网络中要求更高的部分。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901A4.title: "工程处理器"
	quest.42000000000901A5.quest_desc: [
		"存放着网络所记住的一切内容的单元。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901A5.title: "ME 驱动器"
	quest.42000000000901A6.quest_desc: [
		"外壳内部建造了一个存储单元。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901A6.title: "物品槽位住宅系统"
	quest.42000000000901A7.quest_desc: [
		"第一个数字化的箱子。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901A7.title: "1k 物品存储单元"
	quest.42000000000901A8.quest_desc: [
		"看看这张网。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901A8.title: "ME终端"
	quest.42000000000901A9.quest_desc: [
		"允许你直接从网络中已有的内容直接合成。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901A9.title: "合成终端"
	quest.42000000000901AA.quest_desc: [
		"控制器。想要一个绑定绳在它的中心。",
		"纺锤核心。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901AA.title: "数字织布机"
	quest.42000000000901AB.quest_desc: [
		"空手使用，演奏门之仪式：在A、S、D、F上敲击下落节拍。成功率为60%即可开启，无需脉冲。",
		"方法：空手使用 Gate Drum 并演奏 Gate Rite：在 A、S、D、F 上敲击下落节拍。成功率为 60% 即可开启；无需 Pulse。请先绑定一个返回指南针。"
	]
	quest.42000000000901AB.title: "传送门鼓"
	quest.42000000000901AC.quest_desc: [
		"从门外带来的基石。带一块回家。",
		"方法：熔炼三月鹅卵石。在三月通过鼓门挖掘。"
	]
	quest.42000000000901AC.title: "三月的石头"
	quest.42000000000901AD.quest_desc: [
		"将网络的频道从一个机器传输到下一个机器。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901AD.title: "Fluix 电缆"
	quest.42000000000901AE.quest_desc: [
		"将物品拉入存储容器中。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901AE.title: "导入总线"
	quest.42000000000901AF.quest_desc: [
		"将物品从网络推送到箱子或机器中。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901AF.title: "出口总线"
	quest.42000000000901B0.quest_desc: [
		"将外部物品栏读取到网络中，如同它是一个单元格一样。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901B0.title: "Storage Bus"
	quest.42000000000901B1.quest_desc: [
		"为网络的自动合成增加了批量合成能力。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901B1.title: "合成单元 Crafting Unit"
	quest.42000000000901B2.quest_desc: [
		"加快了单次运行的合成任务数量。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901B2.title: "联合加工合成单元 (Crafting Co-Processing Unit)"
	quest.42000000000901B3.quest_desc: [
		"在合成时，网络会在此绘制图案。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901B3.title: "1k 合成储物空间"
	quest.42000000000901B4.quest_desc: [
		"像织布机向梭子供线一样，向机器提供模式。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901B4.title: "模式提供者"
	quest.42000000000901B5.quest_desc: [
		"由图案建造。需要一根辫子绳作为核心。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901B5.title: "分子组装器"
	quest.42000000000901B6.quest_desc: [
		"一个空白的模式，等待用配方进行编码。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901B6.title: "空白图案"
	quest.42000000000901B7.quest_desc: [
		"向数字织布机输入能量。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901B7.title: "能量接收器"
	quest.42000000000901B8.quest_desc: [
		"AE 燃烧 — 可选的电力分支。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901B8.title: "振动室"
	quest.42000000000901B9.quest_desc: [
		"一个比上一个尺寸容量更大的存储单元。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901B9.title: "4k 物品存储单元"
	quest.42000000000901BA.quest_desc: [
		"容量远超任何箱子，是驱动器装满前最密集的存储单元。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901BA.title: "16k 物品存储单元"
	quest.42000000000901BB.quest_desc: [
		"外壳内部建造了一个流体存储单元。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901BB.title: "流体容器外壳"
	quest.42000000000901BC.quest_desc: [
		"一个数字储罐，可以存储网络中任何地方提取的液体。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901BC.title: "1k 流体单元"
	quest.42000000000901BD.quest_desc: [
		"在没有手的情况下，用网络放置方块，就像用手一样。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901BD.title: "Formation Plane"
	quest.42000000000901BE.quest_desc: [
		"会破坏前方的方块并将其送入网络。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901BE.title: "湮灭之域"
	quest.42000000000901BF.quest_desc: [
		"来自网络的红石。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901BF.title: "等级发射器"
	quest.42000000000901C0.quest_desc: [
		"将网络连接到世界，在边缘进行物品交易。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901C0.title: "界面"
	quest.42000000000901C1.quest_desc: [
		"将普通电缆无法触及的两个网络远距离连接起来。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901C1.title: "量子戒指"
	quest.42000000000901C2.quest_desc: [
		"量子环的另一半，用于将两个网络连接在一起。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901C2.title: "量子链接"
	quest.42000000000901C3.quest_desc: [
		"在范围内任何地方都能连接到网络，脚下无需铺设电缆。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901C3.title: "无线终端"
	quest.42000000000901C4.quest_desc: [
		"将一台机器的设置复制到另一台机器上，无需重新输入。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901C4.title: "存储卡"
	quest.42000000000901C5.quest_desc: [
		"AE2 的网络工具。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901C5.title: "网络工具"
	quest.42000000000901C6.quest_desc: [
		"为 Certus 石英充能，直到准备好进行更精细的制造。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901C6.title: "充电器"
	quest.42000000000901C7.quest_desc: [
		"使正在生长的水晶花蕾加速，朝向一个完整大小的晶簇生长。",
		"方法：纺锤网络 — 用沙子制作 certus，控制器需要一个 Knot。"
	]
	quest.42000000000901C7.title: "晶体生长加速器"
	quest.42000000000901C8.quest_desc: [
		"三月树冠证明 — 可选重织纪念品。",
		"获取方式：三月期间野外生长，芦苇陷阱箱中可找到，Rootbinder Elder 也会出售。"
	]
	quest.42000000000901C8.title: "灵魂芦苇"
	quest.42000000000901C9.quest_desc: [
		"一束辫子，一台数字织布机，一扇大门，一块来自三月的石头。",
		"拉紧第九根弦。然后是碎片，再是支柱。",
		"认领它并从部落中选择一个礼物：一条用于共享生命的“回归之线”，或是补给品。",
		"方法：完成与此任务相关的任务，然后用 Strand 代币领取。将代币放置在你的 Tension Post 上。"
	]
	quest.42000000000901C9.quest_subtitle: "重新编织"
	quest.42000000000901C9.title: "纺锤结 (Spindle Knot)"
	quest.42000000000901CA.quest_desc: [
		"右键点击 Clowder's Tension Post 并使用令牌。",
		"凹槽灯亮起，部落铃铛作响，踏板发生变化。",
		"方法：手持 Strand token 右键点击你的 Tension Post。"
	]
	quest.42000000000901CA.title: "座椅纺锤"
	quest.42000000000901CB.quest_desc: [
		"九个坐着的，一个三月石，右键点击告示牌：碎片。",
		"坐下。切口会在你的座垫上方闭合。",
		"方法：放置九个代币，然后用三月石右键点击柱子。"
	]
	quest.42000000000901CB.quest_subtitle: "重新编织"
	quest.42000000000901CB.title: "织布机碎片"
	quest.42000000000901CC.quest_desc: [
		"将碎片置于张力柱上。",
		"九个部落，一条线索。去瞧瞧三月为你留下了什么。",
		"稀有奖励：一次共享的 Clowder 生命，全队共享。整个战役中仅有六个此类奖励。",
		"方法：将纺锤织布碎片安装在张力柱上。当天空关闭时，进度会触发。"
	]
	quest.42000000000901CC.quest_subtitle: "切割，关闭"
	quest.42000000000901CC.title: "重新编织"
	quest.42000000000901CD.quest_desc: [
		"天空中，一个凋零站在基座上。织布匠们会先惊叹，然后暴怒。",
		"方法：凋零（灵魂沙上放三个头颅），或在/clowder hub的鼓心摊位用12个线钉（972根线）兑换。奖杯可选——不影响末地或刷怪塔100%的获取。"
	]
	quest.42000000000901CD.title: "一颗星星，不知为何出现在这里"
	quest.42000000000A01CE.quest_desc: [
		"树叶会掉落更多的树苗。",
		"九族为下一窝猫留下了补给。使用管家宝箱可随机开启补给，或用四个小宝箱合成一个中宝箱，或用三个中宝箱合成一个大宝箱。大宝箱能装下更多卷轴和更丰富的补给种类，单独开启则能获得更基础的补给。里面没有机器或进度代币，但每个宝箱都有极小概率开出线团碎片，极小概率开出完整的回归之线，大宝箱的概率更高。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000000A01CE.title: "Crook 基础知识"
	quest.42000000000A01CF.quest_desc: [
		"比木制钩子筛得更快，而且耐用得多。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000000A01CF.title: "骨钩（Bone Crook）"
	quest.42000000000A01D0.quest_desc: [
		"最普通的筛网。所有你筛选的东西都要先通过这个。",
		"方法：3x3 排列九个线。Grit-singers' stall 出售 Voidloom 线网，可以筛选出同样的线。"
	]
	quest.42000000000A01D0.title: "字符串 Mesh"
	quest.42000000000A01D1.quest_desc: [
		"能捕捉比线更精细的碎片。更少的残片会从编织中溜走。",
		"方法：棋盘格中放四个燧石和五个线。燧石是砾石，或是线+砾石。"
	]
	quest.42000000000A01D1.title: "燧石筛网 (Sieve)"
	quest.42000000000A01D2.quest_desc: [
		"铁线能勾住更重的杂质，并从堆中拉出更稀有的废料。",
		"方法：棋盘上放置四个铁锭和五个线。没有摊位出售。"
	]
	quest.42000000000A01D2.title: "铁丝网（筛子）"
	quest.42000000000A01D3.quest_desc: [
		"黄金级网格。概率向重要矿石倾斜。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000000A01D3.title: "黄金网格"
	quest.42000000000A01D4.quest_desc: [
		"用这个筛沙砾，钻石出现的频率会高得多。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000000A01D4.title: "钻石网格"
	quest.42000000000A01D5.quest_desc: [
		"最顶级的网格。没有任何东西能筛得过下界合金线。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000000A01D5.title: "下界合金网格"
	quest.42000000000A01D6.quest_desc: [
		"黏土经精细打磨，已准备好投入能产生真火的熔炉中。",
		"方法：粘土球 + 骨粉，无需特定形状。粘土来自张力桶。"
	]
	quest.42000000000A01D6.title: "Porcelain Clay (Sieve)"
	quest.42000000000A01D7.quest_desc: [
		"将瓷土塑造成坩埚。在熔炉中将其烧制。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000000A01D7.title: "未烧制的炼药锅"
	quest.42000000000A01D8.quest_desc: [
		"能承载熔融热量而不破裂。将筛子筛选出的东西冶炼。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000000A01D8.title: "Porcelain Crucible"
	quest.42000000000A01D9.quest_desc: [
		"将水喷洒到作物上，而不会践踏作物行。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000000A01D9.title: "浇水壶木材"
	quest.42000000000A01DA.quest_desc: [
		"溅射范围更广，蓄水池更深。每次能覆盖更多地面。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000000A01DA.title: "铁质浇水壶 Watering Can Iron"
	quest.42000000000A01DB.quest_desc: [
		"在叶子上放养，它会一边进食一边吐丝。",
		"方法：用曲柄锄头撸树叶；蚕会偶尔掉落。"
	]
	quest.42000000000A01DB.title: "Silkworm"
	quest.42000000000A01DC.quest_desc: [
		"能将树苗和种子推向更奇特作物的奇怪水源。",
		"方法：将一桶水倒在菌丝上，会变成女巫水，然后用桶舀起。用筛子从泥土中过滤出菌丝孢子。"
	]
	quest.42000000000A01DC.title: "女巫药水桶"
	quest.42000000000A01DD.quest_desc: [
		"将它们散布开来，菌丝便会一节一节地向外蔓延。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000000A01DD.title: "菌丝孢子"
	quest.42000000000A01DE.quest_desc: [
		"撒上泥土和草籽，无需等待下雨即可蔓延。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000000A01DE.title: "草的种子"
	quest.42000000000A01DF.quest_desc: [
		"鹅卵石替换用的砂砾。喂回锤子获得更多。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000000A01DF.title: "石质鹅卵石"
	quest.42000000000A01E0.quest_desc: [
		"九块紧密堆叠的储物石铺成的种植床。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000000A01E0.title: "压缩的鹅卵石"
	quest.42000000000A01E1.quest_desc: [
		"比之前的任何锤子都更快地将鹅卵石破碎成砾石。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000000A01E1.title: "下界合金锤"
	quest.42000000000A01E2.quest_desc: [
		"下界石，粉碎成粉。玄武岩和黑色石都由此开始。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000000A01E2.title: "黑石鹅卵石"
	quest.42000000000A01E3.quest_desc: [
		"深板岩被碾成粉末，又可以过筛子了。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000000A01E3.title: "深层板岩鹅卵石"
	quest.42000000000A01E4.quest_desc: [
		"从深层筛选出的苍白石材，主要用于建造。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000000A01E4.title: "方解石"
	quest.42000000000A01E5.quest_desc: [
		"来自深海的灰色石头，朴实无华，易于塑形。",
		"方法：使用 Ex Deorum 筛子、锤子、坩埚或桶。将筛网与颗粒大小匹配。"
	]
	quest.42000000000A01E5.title: "Tuff"
	quest.42000000000A01E6.quest_desc: [
		"地下生长缓慢；堆叠起来，让它再次滴落成钟乳石。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.42000000000A01E6.title: "滴水石锥"
	quest.42000000000A01E7.quest_desc: [
		"能迅速吸干积水，农场被淹后很方便。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.42000000000A01E7.title: "海绵块"
	quest.42000000000B01E8.quest_desc: [
		"将周围的存储链接成一个可搜索的网络。",
		"九族为下一窝猫留下了补给。使用管家宝箱可随机开启补给，或用四个小宝箱合成一个中宝箱，或用三个中宝箱合成一个大宝箱。大宝箱能装下更多卷轴和更丰富的补给种类，单独开启则能获得更基础的补给。里面没有机器或进度代币，但每个宝箱都有极小概率开出线团碎片，极小概率开出完整的回归之线，大宝箱的几率更高。",
		"方法：木桶或箱子、两个比较器、木板和石头。链接附近的Sophisticated桶。"
	]
	quest.42000000000B01E8.title: "存储控制器"
	quest.42000000000B01E9.quest_desc: [
		"可升级的桶：过滤器、漏斗、磁铁、虚空。",
		"方法：用铜升级一个桶。JEI会显示配方名称。"
	]
	quest.42000000000B01E9.title: "铜制桶"
	quest.42000000000B01EA.quest_desc: [
		"更多槽位，更多升级行。",
		"方法：JEI中的桶和升级。控制器将一堵桶墙连接起来。"
	]
	quest.42000000000B01EA.title: "铁桶"
	quest.42000000000B01EB.quest_desc: [
		"从平台对面将掉落物品直接拉入桶中。",
		"方法：JEI中的桶和升级。控制器将一堵桶墙连接起来。"
	]
	quest.42000000000B01EB.title: "高级磁石升级组件"
	quest.42000000000B01EC.quest_desc: [
		"从一边进，另一边出，不需要漏斗方块。",
		"方法：JEI中的桶和升级。控制器将一堵桶墙连接起来。"
	]
	quest.42000000000B01EC.title: "漏斗升级包"
	quest.42000000000B01ED.quest_desc: [
		"删除超出容量的物品，抽屉永远不会卡住。",
		"方法：JEI中的桶和升级。控制器将一堵桶墙连接起来。"
	]
	quest.42000000000B01ED.title: "虚空升级包"
	quest.42000000000B01EE.quest_desc: [
		"将附近的掉落物直接吸入所安装的存储装置中。",
		"方法：JEI中的桶和升级。控制器将一堵桶墙连接起来。"
	]
	quest.42000000000B01EE.title: "拾取物品升级模组"
	quest.42000000000B01EF.quest_desc: [
		"一个格子，已分类且可见。存储大量物品的最简单方式。",
		"方法：橡木原木 + 箱子。第一个抽屉。"
	]
	quest.42000000000B01EF.title: "橡木抽屉 1x1"
	quest.42000000000B01F0.quest_desc: [
		"两个相邻的格子，用于存放不同的同类物品。",
		"方法：橡木抽屉 1x1 / 1x2 / 2x2，然后压缩抽屉和控制器。JEI 会显示配方名称。"
	]
	quest.42000000000B01F0.title: "橡木抽屉 1x2"
	quest.42000000000B01F1.quest_desc: [
		"一格四槽。高密度存储，节省空间。",
		"方法：橡木抽屉 1x1 / 1x2 / 2x2，然后压缩抽屉和控制器。JEI 会显示配方名称。"
	]
	quest.42000000000B01F1.title: "橡木抽屉 2x2"
	quest.42000000000B01F2.quest_desc: [
		"填充时会将其内部物品自动压缩成方块。",
		"方法：橡木抽屉 1x1 / 1x2 / 2x2，然后压缩抽屉和控制器。JEI 会显示配方名称。"
	]
	quest.42000000000B01F2.title: "紧凑型抽屉"
	quest.42000000000B01F3.quest_desc: [
		"将周围的存储链接成一个可搜索的网络。",
		"方法：橡木抽屉 1x1 / 1x2 / 2x2，然后压缩抽屉和控制器。JEI 会显示配方。"
	]
	quest.42000000000B01F3.title: "存储控制器 (Storage)"
	quest.42000000000B01F4.quest_desc: [
		"将附近的物品掉落物直接吸入抽屉。",
		"方法：橡木抽屉 1x1 / 1x2 / 2x2，然后压缩抽屉和控制器。JEI 会显示配方名称。"
	]
	quest.42000000000B01F4.title: "收藏家升级组件"
	quest.42000000000B01F5.quest_desc: [
		"从旁边的箱子或机器中取出物品。",
		"方法：橡木抽屉 1x1 / 1x2 / 2x2，然后压缩抽屉和控制器。JEI 会显示配方名称。"
	]
	quest.42000000000B01F5.title: "牵引器升级"
	quest.42000000000B01F6.quest_desc: [
		"将存储的物品推入其相邻的任何物品栏中。",
		"方法：橡木抽屉 1x1 / 1x2 / 2x2，然后压缩抽屉和控制器。JEI 会显示配方。"
	]
	quest.42000000000B01F6.title: "推推器升级"
	quest.42000000000B01F7.quest_desc: [
		"删除超出容量的物品，抽屉永远不会卡住。",
		"方法：橡木抽屉 1x1 / 1x2 / 2x2，然后压缩抽屉和控制器。JEI 会显示配方名称。"
	]
	quest.42000000000B01F7.title: "虚空升级（存储）"
	quest.42000000000B01F8.quest_desc: [
		"一个便携的背包，可以腾出快捷栏和口袋空间。",
		"方法：皮革 + 箱子。然后用铁/金/钻石升级。"
	]
	quest.42000000000B01F8.title: "背包"
	quest.42000000000B01F9.quest_desc: [
		"比普通背包多几个格子，还有一个升级槽位。",
		"方法：皮革背包，然后在 JEI 中用铁/金/钻石升级。"
	]
	quest.42000000000B01F9.title: "铁质背包"
	quest.42000000000B01FA.quest_desc: [
		"空间更宽敞了，还留出了升级的可用插槽。",
		"方法：皮革背包，然后在JEI中用铁/金/钻石升级。"
	]
	quest.42000000000B01FA.title: "黄金背包"
	quest.42000000000B01FB.quest_desc: [
		"在附魔之前，最深层的口袋将把存储扩展得更远。",
		"方法：皮革背包，然后在JEI中用铁/金/钻石升级。"
	]
	quest.42000000000B01FB.title: "钻石背包"
	quest.42000000000B01FC.quest_desc: [
		"将附近的掉落物直接吸入所安装的存储装置中。",
		"方法：皮革背包，然后在JEI中用铁/金/钻石升级。"
	]
	quest.42000000000B01FC.title: "拾取升级（存储）"
	quest.42000000000B01FD.quest_desc: [
		"过滤进入背包的物品。",
		"方法：皮革背包，然后在JEI中用铁/金/钻石升级。"
	]
	quest.42000000000B01FD.title: "过滤器升级"
	quest.42000000000B01FE.quest_desc: [
		"允许背包使用已存储的物品进行合成。",
		"方法：皮革背包，然后在 JEI 中用铁/金/钻石升级。"
	]
	quest.42000000000B01FE.title: "合成升级配方：将物品放入合成台，即可升级配方。"
	quest.42000000000B01FF.quest_desc: [
		"饥饿值过低时，会自动从储存中为你提供食物。",
		"方法：皮革背包，然后在 JEI 中用铁/金/钻石升级。"
	]
	quest.42000000000B01FF.title: "喂食升级"
	quest.42000000000B0200.quest_desc: [
		"将损坏的工具替换为整合包中的全新工具。",
		"方法：皮革背包，然后在JEI中用铁/金/钻石升级。"
	]
	quest.42000000000B0200.title: "重新补给升级"
	quest.42000000000B0201.quest_desc: [
		"靠近时会将背包里的物品倒进附近的箱子里。",
		"方法：皮革背包，然后在 JEI 中用铁/金/钻石升级。"
	]
	quest.42000000000B0201.title: "存款升级"
	quest.42000000000B0202.quest_desc: [
		"在背包内添加了一个液体储罐，用于运输液体。",
		"方法：皮革背包，然后在JEI中用铁/金/钻石升级。"
	]
	quest.42000000000B0202.title: "坦克升级"
	quest.42000000000C0203.quest_desc: [
		"本生产线中大多数机器和外壳的背骨金属。",
		"九族为下一窝猫留下了补给。使用管家宝箱可随机开启补给，或用四个小宝箱合成一个中宝箱，或用三个中宝箱合成一个大宝箱。大宝箱能装下更多卷轴和更丰富的补给种类，单独开启则能获得更基础的补给。里面没有机器或进度代币，但每个宝箱都有极小概率开出线团碎片，极小概率开出完整的回归之线，大宝箱的概率更高。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.42000000000C0203.title: "钢锭"
	quest.42000000000C0204.quest_desc: [
		"大多数电缆、储罐和早期机器的核心金属。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.42000000000C0204.title: "锇锭"
	quest.42000000000C0205.quest_desc: [
		"用黑曜石粉尘压制而成的坚硬合金，用于制作更坚固的装备。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.42000000000C0205.title: "精炼黑曜石"
	quest.42000000000C0206.quest_desc: [
		"最简单的逻辑板。大多数早期机器都需要几个。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.42000000000C0206.title: "基础控制电路"
	quest.42000000000C0207.quest_desc: [
		"用于机器的更精密逻辑板，生产线上的一个升级。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.42000000000C0207.title: "高级控制电路"
	quest.42000000000C0208.quest_desc: [
		"最顶尖的机器才配拥有的最精密逻辑板。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.42000000000C0208.title: "精英控制电路"
	quest.42000000000C0209.quest_desc: [
		"在冶炼前将金属与碳、红石或钻石粉尘融合。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.42000000000C0209.title: "冶金学注入器"
	quest.42000000000C020A.quest_desc: [
		"将大多数原矿粉碎成两种粉尘，而非一种。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.42000000000C020A.title: "富集室"
	quest.42000000000C020B.quest_desc: [
		"批量材料研磨或粉碎。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.42000000000C020B.title: "破碎机"
	quest.42000000000C020C.quest_desc: [
		"用能量代替燃料熔炼矿石，速度也略快一些。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.42000000000C020C.title: "能量熔炼炉"
	quest.42000000000C020D.quest_desc: [
		"用氧气净化富矿，可获得第三种产物，有时更多。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.42000000000C020D.title: "净化室"
	quest.42000000000C020E.quest_desc: [
		"向矿石中注入气体，以获得该产线最丰富的产出。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.42000000000C020E.title: "化学注射剂"
	quest.42000000000C020F.quest_desc: [
		"比单独的熔炉更快地将锇粉压缩成锭。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.42000000000C020F.title: "锇压缩机"
	quest.42000000000C0210.quest_desc: [
		"一个物品栏格，能装下的东西远比一个箱子多得多。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.42000000000C0210.title: "基础分类器"
	quest.42000000000C0211.quest_desc: [
		"将一种流体的大量液体存储在单个方块中。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.42000000000C0211.title: "基础流体储罐"
	quest.42000000000C0212.quest_desc: [
		"在机器间缓冲电力，防止电压骤升导致停机。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.42000000000C0212.title: "基础能量立方体"
	quest.42000000000C0213.quest_desc: [
		"为机器输送电力。平台上最常见的电缆。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.42000000000C0213.title: "基础通用线缆"
	quest.42000000000C0214.quest_desc: [
		"在储罐和机器之间沿轨道输送流体。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.42000000000C0214.title: "基础机械管道"
	quest.42000000000C0215.quest_desc: [
		"在相连的背包之间自动移动物品。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.42000000000C0215.title: "基础物流运输机"
	quest.42000000000C0216.quest_desc: [
		"使用一种工具即可旋转、拆卸和重新配置机器朝向。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.42000000000C0216.title: "配置器"
	quest.42000000000C0217.quest_desc: [
		"Mek 喷气背包 — 可选的飞行装置。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.42000000000C0217.title: "喷气背包"
	quest.42000000000C0218.quest_desc: [
		"减轻坠落伤害，并在虚空吞噬你之前争取一秒的时间。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.42000000000C0218.title: "自由奔跑者"
	quest.42000000000C0219.quest_desc: [
		"一种能挖掘、切割和战斗的工具，每次升级都更锋利。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.42000000000C0219.title: "原子分解机"
	quest.42000000000C021A.quest_desc: [
		"大多数多方块机器都围绕这个结构框架建造。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.42000000000C021A.title: "钢制外壳"
	quest.42000000000C021B.quest_desc: [
		"连接两点，踏过即可跳过中间的行走过程。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.42000000000C021B.title: "传送器"
	quest.42000000000C021C.quest_desc: [
		"会自动挖掘大范围区域，并为你整理产出物。",
		"方法：Mekanism Works 章节——用筛子获取矿石块，然后用工厂生产线。"
	]
	quest.42000000000C021C.title: "数字矿工"
	quest.42000000000D021D.quest_desc: [
		"大多数机器背后的一种粘性基础材料。",
		"九族为下一窝猫留下了补给。使用管家宝箱可随机开启补给，或用四个小宝箱合成一个中宝箱，或用三个中宝箱合成一个大宝箱。大宝箱能装下更多卷轴和更丰富的补给种类，单独开启则能获得更基础的补给。里面没有机器或进度代币，但每个宝箱都有极小概率开出线团碎片，极小概率开出完整的回归之线，大宝箱的几率更高。",
		"方法：Powah Grid 章节 — 在 Spark Pulse 存在后，制作 energizing orb 和电缆。"
	]
	quest.42000000000D021D.title: "介电质浆料"
	quest.42000000000D021E.quest_desc: [
		"储存一定量的能量。",
		"方法：Powah Grid 章节 — 在 Spark Pulse 存在后，制作 energizing orb 和电缆。"
	]
	quest.42000000000D021E.title: "基础电容器"
	quest.42000000000D021F.quest_desc: [
		"为周围的机器储存着大量的备用电力。",
		"方法：Powah Grid 章节 — 在 Spark Pulse 存在后，制作 energizing orb 和电缆。"
	]
	quest.42000000000D021F.title: "基础能量单元 (Energy Cell Basic)"
	quest.42000000000D0220.quest_desc: [
		"比普通熔炉更高效地将燃料转化为能量。",
		"方法：Powah Grid 章节 — 在 Spark Pulse 存在后，制作 energizing orb 和电缆。"
	]
	quest.42000000000D0220.title: "Furnator 基础版"
	quest.42000000000D0221.quest_desc: [
		"只要岩浆存在，就能将其转化为稳定的能量。",
		"方法：Powah Grid 章节 — 在 Spark Pulse 存在后，制作 energizing orb 和电缆。"
	]
	quest.42000000000D0221.title: "Magmator 基础版"
	quest.42000000000D0222.quest_desc: [
		"利用日光发电，效率高于单个电池单独工作。",
		"方法：Powah Grid 章节 — 在 Spark Pulse 存在后，制作 energizing orb 和电缆。"
	]
	quest.42000000000D0222.title: "太阳能基础版"
	quest.42000000000D0223.quest_desc: [
		"利用附近冷热方块之间的温差来产生电力。",
		"方法：Powah Grid 章节 — 在 Spark Pulse 存在后，制作 energizing orb 和电缆。"
	]
	quest.42000000000D0223.title: "基础热力学模组"
	quest.42000000000D0224.quest_desc: [
		"稳定燃烧固体燃料，提供强劲可靠的持续动力。",
		"方法：Powah Grid 章节 — 在 Spark Pulse 存在后，制作 energizing orb 和电缆。"
	]
	quest.42000000000D0224.title: "基础反应堆"
	quest.42000000000D0225.quest_desc: [
		"每刻传输的电量比初始电缆更多。",
		"方法：Powah Grid 章节 — 在 Spark Pulse 存在后，制作 energizing orb 和电缆。"
	]
	quest.42000000000D0225.title: "基础能量电缆"
	quest.42000000000D0226.quest_desc: [
		"直接为玩家充电，无需电线或插槽。",
		"方法：Powah Grid 章节 — 在 Spark Pulse 存在后，制作 energizing orb 和电缆。"
	]
	quest.42000000000D0226.title: "玩家基础传输器"
	quest.42000000000D0227.quest_desc: [
		"像漏斗一样向附近的机器输送能量。",
		"方法：Powah Grid 章节 — 在 Spark Pulse 存在后，制作 energizing orb 和电缆。"
	]
	quest.42000000000D0227.title: "基础能量漏斗"
	quest.42000000000D0228.quest_desc: [
		"放置在晶体装置旁时，能更快地为储能单元充能。",
		"方法：Powah Grid 章节 — 在 Spark Pulse 存在后，制作 energizing orb 和电缆。"
	]
	quest.42000000000D0228.title: "基础能量化装置棒 (Energizing Rod Basic)"
	quest.42000000000D0229.quest_desc: [
		"可在机器间手动携带的便携式备用电源。",
		"方法：Powah Grid 章节 — 在 Spark Pulse 存在后，制作 energizing orb 和电缆。"
	]
	quest.42000000000D0229.title: "基础电池"
	quest.42000000000D022A.quest_desc: [
		"用于能量棒细胞室的第一级晶体。",
		"方法：Powah Grid 章节 — 在 Spark Pulse 存在后，制作 energizing orb 和电缆。"
	]
	quest.42000000000D022A.title: "Niotic 水晶"
	quest.42000000000D022B.quest_desc: [
		"更强大的水晶层级，位于能量化室建造进程的更深处。",
		"方法：Powah Grid 章节 — 在 Spark Pulse 存在后，制作 energizing orb 和电缆。"
	]
	quest.42000000000D022B.title: "灵性水晶"
	quest.42000000000D022C.quest_desc: [
		"能量室所能容纳的最强晶体等级。",
		"方法：Powah Grid 章节 — 在 Spark Pulse 存在后，制作 energizing orb 和电缆。"
	]
	quest.42000000000D022C.title: "氮气水晶"
	quest.42000000000E022D.quest_desc: [
		"由法师之花纺成，织入长袍与法术装备中。",
		"九族为下一猫群留下了补给。使用管家宝箱可随机开启补给，或用四个小宝箱合成一个中宝箱，或用三个中宝箱合成一个大宝箱。大宝箱能装下更多卷轴和更丰富的补给种类，单独开启则能获得更基础的补给。里面没有机器或进度代币，但每个宝箱都有极小概率开出线团碎片，极小概率开出完整的回归之线，大宝箱的几率更高。",
		"方法：Arcane Side — 苔藓中的拱形木材和源浆果，然后是瀑布。"
	]
	quest.42000000000E022D.title: "法师纤维"
	quest.42000000000E022E.quest_desc: [
		"一种在收获后纤维会重新生长在茎上的花。",
		"How: Arcane Side — archwood and sourceberry from moss, then the cascade."
	]
	quest.42000000000E022E.title: "Magebloom"
	quest.42000000000E022F.quest_desc: [
		"储存着浓密的原初池，即所有法术背后的燃料。",
		"方法：神秘侧 — 苔藓中的拱形木和源浆果，然后是瀑布。"
	]
	quest.42000000000E022F.title: "源宝石方块"
	quest.42000000000E0230.quest_desc: [
		"能容纳的符文比初始书籍所允许的多。",
		"方法：Arcane Side — 苔藓中的拱形木材和源浆果，然后是瀑布。"
	]
	quest.42000000000E0230.title: "学徒魔法书"
	quest.42000000000E0231.quest_desc: [
		"最大的魔法书，足以容纳全套符文武器库的空间。",
		"方法：法师咒语书、三个末影珍珠、二个绿宝石、一个不死图腾、一个下界之星和一个野人贡品，无需特定形状。图腾：整合包配方，四个金块和四个绿宝石围绕一个金苹果。"
	]
	quest.42000000000E0231.title: "大魔导师的魔法书"
	quest.42000000000E0232.quest_desc: [
		"感知到目标时会自动施放已绑定的法术。",
		"方法：Arcane Side — 苔藓中的拱形木材和源浆果，然后是瀑布。"
	]
	quest.42000000000E0232.title: "法术炮台"
	quest.42000000000E0233.quest_desc: [
		"在稳定的计时器上施放已绑定的法术，而非一看到目标就施放。",
		"方法：Arcane Side — 苔藓中的拱形木材和源浆果，然后是瀑布。"
	]
	quest.42000000000E0233.title: "定时法术炮台"
	quest.42000000000E0234.quest_desc: [
		"制作法术书、魔杖和其他神秘装备的核心组件。",
		"方法：神秘侧 — 苔藓中的拱形木和源浆果，然后是瀑布。"
	]
	quest.42000000000E0234.title: "附魔装置 Enchanting Apparatus"
	quest.42000000000E0235.quest_desc: [
		"坐在附魔装置内部，驱动其配方。",
		"方法：Arcane Side — 苔藓中的拱形木材和源浆果，然后是瀑布。"
	]
	quest.42000000000E0235.title: "Arcane Core"
	quest.42000000000E0236.quest_desc: [
		"在秘法点与链接的罐子或法术之间传递源。",
		"方法：神秘侧 — 苔藓中的拱形木和源浆果，然后是瀑布。"
	]
	quest.42000000000E0236.title: "中继器"
	quest.42000000000E0237.quest_desc: [
		"将一行源数据拆分为多行，以同时向多个位置输送。",
		"方法：神秘侧 — 苔藓中的拱形木和源浆果，然后是瀑布。"
	]
	quest.42000000000E0237.title: "中继器分离器"
	quest.42000000000E0238.quest_desc: [
		"将附近的作物生长转化为缓慢的源流。",
		"方法：Arcane Side — 苔藓中的拱形木材和源浆果，然后是瀑布。"
	]
	quest.42000000000E0238.title: "农业学源链接 Agronomic Sourcelink"
	quest.42000000000E0239.quest_desc: [
		"将附近的熔岩热量转化为稳定的源流。",
		"方法：神秘侧 — 苔藓中的拱形木和源浆果，然后是瀑布。"
	]
	quest.42000000000E0239.title: "火山源链接 Volcanic Sourcelink"
	quest.42000000000E023A.quest_desc: [
		"召唤一个威克西，在你做其他事情时为你制作配方。",
		"方法：神秘侧 — 苔藓中的拱形木和源浆果，然后是瀑布。"
	]
	quest.42000000000E023A.title: "Wixie 护身符"
	quest.42000000000E023B.quest_desc: [
		"召唤一个星团，可应命令从存储中取回物品。",
		"方法：神秘侧 — 苔藓中的拱形木和源浆果，然后是瀑布。"
	]
	quest.42000000000E023B.title: "星团魅力 (Starbuncle Charm)"
	quest.42000000000E023C.quest_desc: [
		"召唤一个干格米，它会在附近缓慢生成所选资源。",
		"方法：神秘侧 — 苔藓中的拱形木和源浆果，然后是瀑布。"
	]
	quest.42000000000E023C.title: "干地格米护身符"
	quest.42000000000E023D.quest_desc: [
		"召唤一个能自行照料和种植作物的涡旋小精灵。",
		"方法：神秘侧 — 苔藓中的拱形木和源浆果，然后是瀑布。"
	]
	quest.42000000000E023D.title: "漩涡精灵护身符"
	quest.42000000000E023E.quest_desc: [
		"召唤一个无需拿起镐就能采集紫晶花蕾的哥布林。",
		"方法：神秘侧 — 苔藓中的拱形木和源浆果，然后是瀑布。"
	]
	quest.42000000000E023E.title: "紫水晶哥布林护身符"
	quest.42000000000E023F.quest_desc: [
		"远程拾取和放置方块，远距离连接机器电路。",
		"方法：神秘侧 — 苔藓中的拱形木和源浆果，然后是瀑布。"
	]
	quest.42000000000E023F.title: "Dominion Wand"
	quest.42000000000E0240.quest_desc: [
		"将物品标记为允许通过，当被放入过滤器中时生效。",
		"方法：神秘侧 — 苔藓中的拱形木和源浆果，然后是瀑布。"
	]
	quest.42000000000E0240.title: "允许滚动条显示（Allow Scroll）"
	quest.42000000000E0241.quest_desc: [
		"将物品放入过滤器时，将其标记为拒绝。",
		"方法：Arcane Side — 苔藓中的拱形木材和源浆果，然后是瀑布。"
	]
	quest.42000000000E0241.title: "拒绝卷轴"
	quest.42000000000F0242.quest_desc: [
		"在绑定结周围放置原木，顶部放线。将其放在基座上。",
		"站在它附近：一旦放置了 Strand，平台就会开始为你修复。",
		"九族为下一窝猫留下了补给。使用管家宝箱可随机开启补给，或用四个小宝箱合成一个中宝箱，或用三个中宝箱合成一个大宝箱。大宝箱能装下更多卷轴和更丰富的补给种类，单独开启则能获得更基础的补给。里面没有机器或进度代币，但每个宝箱都有极小概率开出线团碎片，极小概率开出完整的回归之线，大宝箱的几率更高。",
		"方法：将日志围绕一个绑定结放置，顶部放上线。将其放在基座上。注视它即可完成。"
	]
	quest.42000000000F0242.title: "竖起告示牌"
	quest.42000000000F0243.quest_desc: [
		"手持Hub Key，或使用/clowder hub。服务器里的所有Clowder都会在这里集合。",
		"/clowder return 带你回家。",
		"方法：Hub Key 或 `/clowder hub`。使用 `/clowder return` 可返回家园。"
	]
	quest.42000000000F0243.title: "进入大厅"
	quest.42000000000F0244.quest_desc: [
		"码头上方矗立着一根缓慢的深色石柱：切口本身。",
		"当 Clowders 坐下 Strands 时，它会变薄。回来时常常检查一下。",
		"方法：/clowder hub，抬头看码头上方的深色柱子，然后点击对勾。"
	]
	quest.42000000000F0244.title: "看向纷争之地 (Fray) 的方向"
	quest.42000000000F0245.quest_desc: [
		"将一块床命名为你的名字。",
		"方法：K 打开岛屿面板。手持特许状，潜行使用于主世界地面以锁定出生点。从这里开始命名步骤。"
	]
	quest.42000000000F0245.title: "岛屿特许状"
	quest.42000000000F0246.quest_desc: [
		"可从海滩的任何地方开启返回猫群大厅的道路。",
		"方法：starter kit / Hall。`/clowder hub` 和 Hub Key 前往 Clowder Hall；`/clowder return` 返回家。"
	]
	quest.42000000000F0246.title: "枢纽钥匙"
	quest.42000000000F0247.quest_desc: [
		"标记你的 Strand 行进距离的旗帜图案。",
		"方法：在大厅或JEI中合成。需要旗帜标记，而非Strand代币。"
	]
	quest.42000000000F0247.title: "沙滩旗帜"
	quest.42000000000F0248.quest_desc: [
		"Grave (`) 打开任务列表。右键 Whisker Codex 以开始。同一战役；无需 Shift-点击书本。",
		"配方：一本书和任意石头，无需特定形状。Grave (`) 可打开相同配方列表。"
	]
	quest.42000000000F0248.title: "任务列表"
	quest.42000000000F0249.quest_desc: [
		"在领地探索中保持饱腹感。",
		"方法：胡萝卜周围放八个金粒。胡萝卜是僵尸的稀有掉落物；这个小吃是可选的。"
	]
	quest.42000000000F0249.title: "区块所有权零食"
	quest.42000000000F024A.quest_desc: [
		"随着你的猫群向外扩散，标记你周围的踏板。",
		"方法：指南针被纸张包围。"
	]
	quest.42000000000F024A.title: "地图"
	quest.42000000000F024B.quest_desc: [
		"指向世界出生点，在传送垫增多后很有用。",
		"方法：用红石围住铁块。"
	]
	quest.42000000000F024B.title: "指南针"
	quest.42000000000F024C.quest_desc: [
		"将指南针固定在一个精确的位置，而不是出生点。",
		"方法：在雕纹石砖中放置下界合金锭。晚期Clowder奢侈品。"
	]
	quest.42000000000F024C.title: "磁石块"
	quest.42000000000F024D.quest_desc: [
		"指向你上次死亡的位置，这样在虚空里就不会迷失方向。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.42000000000F024D.title: "恢复指南针"
	quest.42000000000F024E.quest_desc: [
		"铃铛声足够大，能把整窝猫都召集到一个猫窝里。",
		"方法：无合成配方。Occultism的Contact Wild Spirit仪式可以制作一个，但需要山羊，而山羊从不到达祭坛。可选。"
	]
	quest.42000000000F024E.title: "铃铛"
	quest.42000000000F024F.quest_desc: [
		"打开一本书，供整个猫群阅读。",
		"方法：书架周围放置木板台阶。"
	]
	quest.42000000000F024F.title: "Lectern"
	quest.42000000000F0250.quest_desc: [
		"为新来的居民标记区域，让他们知道哪个停机坪是哪一个。",
		"方法：木板加一根木棍。"
	]
	quest.42000000000F0250.title: "橡木告示牌"
	quest.42000000000F0251.quest_desc: [
		"一面空白的旗帜，准备好染上 Clowder 的颜色。",
		"方法：用羊毛和木棍合成。"
	]
	quest.42000000000F0251.title: "白色旗帜"
	quest.42000000000F0252.quest_desc: [
		"盾牌已准备好用于旗帜。",
		"方法：铁块周围放六个木板。非主手方块。"
	]
	quest.42000000000F0252.title: "盾牌旗帜已准备就绪"
	quest.42000000000F0253.quest_desc: [
		"当一条Strand最终重组时，将这些装置启动。",
		"方法：纸加火药。可选的爆发效果。"
	]
	quest.42000000000F0253.title: "烟花（Firework）"
	quest.42000000000F0254.quest_desc: [
		"与大厅分享。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.42000000000F0254.title: "饼干贡品"
	quest.42000000000F0255.quest_desc: [
		"庆祝Strand被彻底重织的共享美食。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.42000000000F0255.title: "蛋糕"
	quest.42000000000F0256.quest_desc: [
		"猫唱片 — 包内氛围。",
		"可选的——虚空可能永远不会提供一个。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.42000000000F0256.title: "音乐唱片"
	quest.42000000000F0257.quest_desc: [
		"将驯服或购买的动物带回基地，而不会追逐它们。",
		"方法：用四根线缠绕一个史莱姆球。史莱姆是堆肥垫（泥土、种子、骨粉）。"
	]
	quest.42000000000F0257.title: "铅制物品"
	quest.42000000000F0258.quest_desc: [
		"找到鞍具后骑上它即可。",
		"可选 — Clowder Hall 的 Pad-keepers 会出售一个。",
		"方法：在 Clowder Hall (/clowder hub) 的商店里，用钻石块和 Pad-keepers 交易。Chocobo Saddle 是另一个物品。"
	]
	quest.42000000000F0258.title: "马鞍"
	quest.42000000000F0259.quest_desc: [
		"总有一天会有人建造一片海。可选任务。",
		"方法：合成、冶炼、筛选，或从生物掉落。JEI 会在提示板上列出所有来源。"
	]
	quest.42000000000F0259.title: "船"
	quest.4200000000110278.quest_desc: [
		"显示气场池在陆地上的分布厚薄情况。",
		"九族为下一窝猫留下了补给。使用管家宝箱可随机开启补给，或用四个小宝箱合成一个中宝箱，或用三个中宝箱合成一个大宝箱。大宝箱能装下更多卷轴和更丰富的补给种类，单独开启则能获得更基础的补给。里面没有机器或进度代币，但每个宝箱都有极小概率开出线团碎片，极小概率开出完整的回归之线，大宝箱的几率更高。",
		"配方：金箔 + 蜘蛛眼。显示局部气场。"
	]
	quest.4200000000110278.title: "眼睛（光环）"
	quest.4200000000110279.quest_desc: [
		"由黄金编织而成，用于为植物注入浓缩的灵气。",
		"方法：在短草周围放置四片树叶和四个金粒，可获得四根璀璨纤维。将其置于树冠上，树叶会随时间变金。"
	]
	quest.4200000000110279.title: "璀璨纤维 (光环)"
	quest.420000000011027A.quest_desc: [
		"用于祭坛更高级别配方的一种精炼材料。",
		"方法：破坏由 Brilliant Fiber 生长出的金叶。"
	]
	quest.420000000011027A.title: "金叶子 (光环)"
	quest.420000000011027B.quest_desc: [
		"全年都散发着柔和金色光芒的树叶。",
		"方法：树上的 Brilliant Fiber → Gold Leaf → Natural Altar。Aura 章节名称的令牌和生成器。"
	]
	quest.420000000011027B.title: "金色的叶子"
	quest.420000000011027C.quest_desc: [
		"用于围绕树苗布置的森林仪式的祭品之一。",
		"方法：树上的 Brilliant Fiber → Gold Leaf → Natural Altar。Aura 章节名称的令牌和生成器。"
	]
	quest.420000000011027C.title: "木制支架"
	quest.420000000011027D.quest_desc: [
		"祭坛，让气场强化更强大的合成配方。",
		"方法：森林仪式 (JEI)：三个石头、一个金叶子、一个金锭和一个欢乐代币。光环之心系列。"
	]
	quest.420000000011027D.title: "自然祭坛 (光环)"
	quest.420000000011027E.quest_desc: [
		"充满光环的铁矿石，迈向深海锭的一步。",
		"方法：树上的 Brilliant Fiber → Gold Leaf → Natural Altar。Aura 章节名称的令牌和生成器。"
	]
	quest.420000000011027E.title: "附魔铁（光环）"
	quest.420000000011027F.quest_desc: [
		"古树剥下的树皮，可用于制作光环配方。",
		"方法：树上的 Brilliant Fiber → Gold Leaf → Natural Altar。Aura 章节名称的令牌和生成器。"
	]
	quest.420000000011027F.title: "远古树皮"
	quest.4200000000110280.quest_desc: [
		"一份喜悦的赠礼。自然祭坛和食草吸收器都建在它上面。",
		"方法：树上的 Brilliant Fiber → Gold Leaf → Natural Altar。Aura 章节名称的令牌和生成器。"
	]
	quest.4200000000110280.title: "欢乐的代币 (光环)"
	quest.4200000000110281.quest_desc: [
		"恐惧的象征。Canopy Diminisher 和 Lingering Absorber 都建造在它之上。",
		"方法：树上的 Brilliant Fiber → Gold Leaf → Natural Altar。Aura 章节名称的令牌和生成器。"
	]
	quest.4200000000110281.title: "恐惧的令牌"
	quest.4200000000110282.quest_desc: [
