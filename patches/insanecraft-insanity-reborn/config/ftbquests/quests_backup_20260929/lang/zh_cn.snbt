	quest.04184E8D0FDDE50C.quest_desc: [
		"欢迎来到 InsanityCraft: Insanity Reborn，这是由知名 YouTuber SSundee、JeromeASF 和 BiffleWiffle 所玩的 1.12.2 模组包 InsaneCraft 的粉丝重制版。"
		""
		"你会是那个获得无限手套及其所有宝石的人吗？又或者你会在过程中失去理智？时间会给出答案。"
		"{@pagebreak}"
		"目前，我建议你先弄点木头。总得从哪儿开始嘛。毕竟是Minecraft，名字里就有挖矿。"
	]
	quest.04184E8D0FDDE50C.quest_subtitle: "总得从某个地方开始不是吗"
