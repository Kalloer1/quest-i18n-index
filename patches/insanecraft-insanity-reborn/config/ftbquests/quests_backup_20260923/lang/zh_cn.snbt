	quest.040A2968F5D9ABDD.quest_desc: ["准备好自动化了吗？&o没？&r &l真遗憾。&r你可能得花点时间把这些都做了。你肯定想要那个护手，对吧？"]
	quest.040A2968F5D9ABDD.quest_subtitle: "还剩下多少理智值？"
	quest.04184E8D0FDDE50C.quest_desc: [
		"欢迎来到 InsanityCraft: Insanity Reborn，这是一个由知名 YouTuber SSundee、JeromeASF 和 BiffleWiffle 游玩的 1.12.2 模组包 InsaneCraft 的粉丝重制版。"
		""
		"你会是那个获得无限手套及其所有宝石的人吗？又或者你会在过程中失去理智？时间会给出答案。"
		"{@pagebreak}"
		"目前，我建议你先弄点木头。总得从哪儿开始嘛。毕竟是Minecraft，名字里就有挖矿。"
	]
	quest.04184E8D0FDDE50C.quest_subtitle: "总得从某个地方开始不是吗"
	quest.04184E8D0FDDE50C.title: "开端"
