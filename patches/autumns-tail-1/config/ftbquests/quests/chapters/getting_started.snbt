	quest_links: [ ]
	quests: [
		{
			description: ["Create 是一个完全关于自动化的模组。你从简单的水轮开始，最终建立一个完整的帝国和工厂，但该从哪里开始呢？其实非常简单，我们需要制作安山合金，这是整个模组的核心物品，所以一个简单而好的开端就是收集大量安山岩以备将来使用。"]
			id: "606FE8DC5DCBEB44"
			rewards: [
				{
					count: 32
					id: "58C49348AC5C7B5C"
					item: "minecraft:andesite"
					type: "item"
				}
				{
					count: 32
					id: "1AF8EB46BE841738"
					item: "minecraft:iron_nugget"
					type: "item"
				}
			]
			shape: "gear"
			size: 2.0d
			subtitle: "一切开始的地方"
			tasks: [{
				count: 64L
				id: "79AFCAFD363CEE0E"
				item: "minecraft:andesite"
				type: "item"
			}]
			title: "开启这段旅程的序幕"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["606FE8DC5DCBEB44"]
			description: ["现在我们收集了安山岩，假设你有多余的铁，就可以制作安山岩合金了。多做一些，因为我保证你永远都不够用，而且大多数时候你都会发现自己需要更多，因为它出现在创造模式的每一个合成配方里。"]
			id: "0966D79931908DE0"
			rewards: [{
				id: "44F4B5AEC90F9852"
				type: "xp_levels"
				xp_levels: 5
			}]
			subtitle: "你总是会把它用得一干二净"
