	order_index: 0
	quest_links: [ ]
	quests: [
		{
			description: ["Antes da Ruptura, eles eram protetores. Agora, são apenas sombras distorcidas pela queda de Eldion. O Dragão do Vazio, o Vigia das Profundezas e a Manifestação da Decadência guardam os segredos de um mundo que não existe mais. Enfrente-os não por recompensa, mas para provar que os Despertos podem desafiar até o que a própria ruína criou"]
			icon: "minecraft:ender_eye"
			id: "7BAE2C8E7CEF11E6"
			rewards: [{
				id: "1A419557552CCAB1"
				type: "xp"
				xp: 69
			}]
			subtitle: "埃尔德恩的古代人"
			tasks: [{
				id: "6621C611189F3D60"
				type: "checkmark"
			}]
			title: "被腐化的守护者"
			x: 0.0d
			y: -1.5d
		}
		{
			dependencies: ["7BAE2C8E7CEF11E6"]
			dependency_requirement: "one_started"
			description: ["O Wither não é um monstro. É a própria ruptura feita carne, um aviso de que Eldion ainda sangra. Enfrentá-lo não é sobre vitória—é sobre resistir à escuridão que quer consumir o que resta dos Despertos. Quando ele cair, apenas o eco do vazio responderá."]
			id: "4907F31175150291"
			rewards: [
				{
					id: "6CE561DB8131B122"
					type: "xp"
					xp: 5000
				}
				{
					id: "65FAB8FF5F1DEFDA"
					item: "good_ol_currency_reforged:one_dollar"
					type: "item"
				}
			]
			subtitle: "Três cabeças, uma única dor: o lamento do Rupturamento"
			tasks: [{
				entity: "minecraft:wither"
				icon: "minecraft:wither_skeleton_skull"
				id: "046BC9454C69D1DA"
				type: "kill"
				value: 1L
			}]
			title: "衰败的显现 (The Manifestation of Decay)"
			x: 1.5d
			y: 0.0d
		}
		{
			dependencies: ["7BAE2C8E7CEF11E6"]
			dependency_requirement: "one_completed"
			description: ["dizem que o Ender Dragon era um ser celestial que guardava os portais entre as dimensões de Eldion. Agora, é apenas um espectro da névoa, um reflexo do que se perdeu. Derrotá-lo não trará glória—apenas o silêncio vazio de um mundo que ainda espera ser lembrado"]
			icon: "minecraft:dragon_head"
			id: "44A051657055120E"
			rewards: [
				{
					id: "73F85CE63BA5E876"
					type: "xp"
					xp: 5000
				}
				{
					id: "4068A9E339E7471E"
					item: "good_ol_currency_reforged:one_dollar"
					type: "item"
				}
			]
			subtitle: "Um espírito alado preso entre o fim e o eterno"
			tasks: [{
				advancement: "minecraft:end/kill_dragon"
				criterion: ""
				id: "4CA9EA6E5BF7615D"
				type: "advancement"
			}]
			title: "虚空之龙"
			x: 0.0d
			y: 0.5d
		}
		{
			dependencies: ["7BAE2C8E7CEF11E6"]
			dependency_requirement: "one_completed"
			description: ["在破碎的海洋深处，远古守卫者依然存在。它那令人麻痹的目光，是昔日维系着Eldion的魔法的余响。杀死它不会揭示宝藏——只会证明，即便是最古老的守卫者，也会在觉醒者的决心面前倒下。"]
			icon: "oceansdelight:guardian"
			id: "4AC403B9A98107CE"
			rewards: [
				{
					id: "6B19AA1CE056E315"
					type: "xp"
					xp: 2000
				}
				{
					id: "6BECCADD15591FAC"
					item: "good_ol_currency_reforged:one_dollar"
					type: "item"
				}
			]
			subtitle: "你的视野是沉没都市最后的记忆"
			tasks: [{
				entity: "minecraft:elder_guardian"
				id: "53B711FA40D67191"
