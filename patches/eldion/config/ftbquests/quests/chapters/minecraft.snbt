		}
		{
			dependencies: [
				"4907F31175150291"
				"44A051657055120E"
				"4AC403B9A98107CE"
			]
			description: ["Você derrotou o que restava dos Guardiões. O Dragão não cruza mais os céus vazios. O Vigia não vigia. O Wither não consome. Mas a Barreira permanece. O mundo ainda está fragmentado. E agora? Talvez não haja resposta. Talvez a verdadeira missão só comece aqui—não como um herói, mas como um sobrevivente. Eldion observa. E espera."]
			id: "4C5DE48BB6AB8AC8"
