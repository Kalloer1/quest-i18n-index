	order_index: 1
	quest_links: [ ]
	quests: [
		{
			description: ["Os antigos portais do End agora exigem Olhos Especiais. Existem 16 tipos espalhados por estruturas do mundo; para ativar um End Gate, são necessários 12 olhos distintos. Comece sua busca encontrando seu primeiro Olho — vá até a estrutura correspondente e recupere-o."]
			icon: "minecraft:ender_eye"
			id: "71BBB567215278FD"
			rewards: [{
				id: "3C5B13D85EF6160A"
				type: "xp"
				xp: 2500
			}]
			size: 1.5d
			subtitle: "Como abrir o Portão do End"
			tasks: [{
				id: "7A10C4597378FFDC"
				title: "O Chamado dos Olhos"
				type: "checkmark"
			}]
			x: 0.0d
			y: 0.5d
		}
		{
			dependencies: ["71BBB567215278FD"]
			description: ["O Olho Negro repousa em baús enterrados, perdidos sob praias e mares. Dizem que pertenceu a um pirata que ousou desafiar o próprio End."]
			id: "0E1C4D0460F43920"
			rewards: [{
				id: "6AE35959D013C3DC"
				item: "good_ol_currency_reforged:ten_cent"
				type: "item"
			}]
			subtitle: "隐藏在波涛之下"
			tasks: [{
