			title: "O Olho Negro"
			x: 3.5d
			y: 0.5d
		}
		{
			dependencies: ["71BBB567215278FD"]
			description: ["Sob o frio das tundras e nos Iglus abandonados, o Cold Eye aguarda. Um fragmento congelado do poder do End, guardado por ecos do passado."]
			id: "3B4EE9CC8E8B6B42"
			rewards: [{
				id: "66A85742F5477E98"
