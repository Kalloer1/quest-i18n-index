	quest_links: [ ]
	quests: [
		{
			description: [
				"温度现在是一个看不见的敌人。"
				"如果你想长时间远离家园生存，就需要适应环境了。"
				"Prepare-se para criar ferramentas que ajudem a manter o equilíbrio térmico."
			]
			id: "7256A956F09065D7"
			subtitle: "身体感受着天气的变化"
			tasks: [{
				id: "42B630CE25457DAA"
				item: "cold_sweat:thermometer"
				type: "item"
			}]
			title: "Adaptação ao Frio"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["7256A956F09065D7"]
			description: [
				"A Waterskin permite armazenar água para aliviar o calor ou o frio."
				"Mantenha a chave — em expedições longas, pode significar a diferença entre vida e morte."
			]
			id: "15907E710579AF82"
			subtitle: "Uma maneira simples de equilibrar a temperatura"
			tasks: [{
				id: "02240BE07704C9A2"
				item: "cold_sweat:waterskin"
				type: "item"
			}]
			title: "水袋"
			x: 0.0d
			y: 2.0d
		}
		{
			dependencies: ["7256A956F09065D7"]
			description: [
				"A Sewing Table é essencial para melhorar suas armaduras."
				"Com ela, você pode aplicar isolamento e se proteger melhor contra o frio intenso ou o calor extremo."
			]
			id: "6B1F4C1EF956D3C1"
			subtitle: "正在构建隔热层，以抵御严寒侵袭"
			tasks: [{
				id: "15B9A098F2AE002D"
				item: "cold_sweat:sewing_table"
				type: "item"
			}]
			title: "缝纫台"
			x: 0.0d
			y: -2.0d
		}
		{
			dependencies: ["7256A956F09065D7"]
			description: [
				"壁炉会持续散发热量，并在周围形成一个安全区域。"
				"Construa um em sua base para se aquecer durante as noites geladas."
			]
			id: "5ECDC392A55BF211"
			subtitle: "守护我们的火焰之光"
			tasks: [{
				id: "00CB934B5EE76EB9"
				item: "cold_sweat:hearth"
				type: "item"
			}]
			title: "壁炉"
			x: -2.0d
			y: 0.0d
		}
		{
			dependencies: ["7256A956F09065D7"]
			description: [
				"O Icebox faz o oposto do Hearth: ele reduz a temperatura e ajuda em regiões escaldantes."
				"Ideal para bases em desertos ou cavernas profundas."
			]
			id: "64547C3C6022B6C7"
			subtitle: "Refúgio contra o calor"
			tasks: [{
