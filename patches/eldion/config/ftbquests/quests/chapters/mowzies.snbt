			title: "O anjo da luz"
			x: 2.0d
			y: -2.0d
		}
		{
			dependencies: ["5D6FEE33E5204EFB"]
			description: ["Nascido do coração congelado de Eldion, Frostmaw é a tempestade que anda. Seus cristais de gelo cortam como lâminas, e seu bafo é o último suspiro de qualquer chama. Dizem que ele guarda o segredo do primeiro inverno—aquele que nunca terminou."]
			icon: {
				Count: 1
				id: "mowziesmobs:ice_crystal"
				tag: {
					Damage: 0
				}
			}
			id: "2267DFBDE6E62B24"
