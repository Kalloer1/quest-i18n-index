	order_index: 1
	quest_links: [ ]
	quests: [
		{
			description: ["Antes da Ruptura, eram guardiões, mestres, criaturas de luz. Agora, são apenas ecos distorcidos—Filhos da Ruptura, presos entre a existência e o esquecimento. Cada um carrega um fragmento da história que Eldion perdeu. Enfrente-os. Não por glória, mas para entender o preço de um mundo despedaçado."]
			icon: {
				Count: 1
				id: "minecraft:iron_sword"
				tag: {
					Damage: 0
				}
			}
			id: "5D6FEE33E5204EFB"
			subtitle: "它们不是疾病。它们是提醒。"
			tasks: [{
				id: "573DCC3CC9A7B0E6"
				type: "checkmark"
			}]
			title: "破裂之子"
			x: 0.0d
			y: 2.0d
		}
		{
			dependencies: ["5D6FEE33E5204EFB"]
			description: ["Umvuthi ainda canta hinos para um céu que não existe mais. Suas asas queimam com o reflexo de um sol que Eldion perdeu. Derrubá-lo não apagará a luz… só prolongará a noite."]
			icon: {
				Count: 1
				ForgeCaps: {
					"cold_sweat:item_insulation": {
						Insulation: [ ]
					}
				}
				id: "mowziesmobs:sol_visage"
			}
			id: "56206A84B10ABD7A"
			rewards: [
				{
					id: "65F1574EC7C56F10"
