					id: "368C291154984703"
					type: "xp"
					xp: 250
				}
			]
			subtitle: "你的王座是尘埃。你的太阳，是谎言。"
			tasks: [{
				entity: "mowziesmobs:umvuthi"
				icon: {
					Count: 1
					ForgeCaps: {
