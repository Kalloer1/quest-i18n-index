				value: 1L
			}]
			title: "冰原的哀歌"
			x: -2.0d
			y: -2.0d
		}
		{
			dependencies: ["5D6FEE33E5204EFB"]
			description: ["Ele guarda um trono vazio, para um rei que nunca voltará. Sua espada é um ritmo ancestral. Silenciá-lo não trará paz… só mais um vazio na fileira."]
