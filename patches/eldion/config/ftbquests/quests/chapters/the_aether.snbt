	order_index: 2
	quest_links: [ ]
	quests: [
		{
			description: ["O portal para o Éter é construído da mesma forma que um portal do Nether, mas em vez de Obsidiana, você usa Glowstone, e em vez de um isqueiro, você utiliza um balde de água."]
			icon: "aether:aether_portal_frame"
			id: "32226ED25E813908"
			rewards: [{
				id: "4D4DA7A91ACF3F08"
				type: "xp_levels"
				xp_levels: 5
			}]
			size: 2.0d
			subtitle: "O portal celestial"
			tasks: [{
				dimension: "aether:the_aether"
				icon: "aether:aether_portal_frame"
				id: "1A6561D8DE5A63CE"
				title: "进入&e以太维度"
				type: "dimension"
			}]
			title: "进入 Aether 维度"
			x: 0.0d
			y: 2.0d
		}
		{
			dependencies: ["32226ED25E813908"]
			description: [
				"As Masmorras de Bronze têm entradas nas laterais das ilhas normais. Elas podem ter várias salas, sendo que as salas comuns contêm sentinelas que atacam o jogador, além de baús sobre mesas 4x4 — alguns deles são mímicos."
				"O chefe desta masmorra não pode ser atacado com espadas, mas pode receber dano de qualquer ferramenta (picareta, pá, etc.)."
				"前厅的地块无法被挖掘，而首领房间的墙壁只能在首领死后才能被破坏。"
			]
			id: "0A99C7852725BFC2"
			rewards: [{
				count: 5
				id: "4A832C71E2196827"
				item: "deep_aether:chromatic_aercloud"
				type: "item"
			}]
			shape: "square"
			size: 1.3d
			subtitle: "探索隐藏在以太岛屿侧面的古老遗迹。"
			tasks: [{
				icon: "aether:carved_stone"
				id: "3865A3E4D4A9A5F3"
				structure: "aether:bronze_dungeon"
				title: "访问一个 &e青铜地牢"
				type: "structure"
			}]
			title: "访问一个青铜地牢"
			x: -2.0d
			y: 2.0d
		}
		{
			dependencies: [
				"100082345FA03A9B"
				"3BE6E50AA8E0170D"
			]
			description: ["O Deslizante é o chefe encontrado nas Masmorras de Bronze. É uma máquina viva de pedra, imóvel até ser provocada — após despertar, atacará impiedosamente quem se aproximar."]
			icon: "umbral_skies:slider_trophy"
			id: "0E349CAEF1D249B6"
			rewards: [{
				id: "00CF504850C054AD"
				item: "deep_aether:skyjade"
				type: "item"
			}]
			shape: "circle"
			size: 1.2d
			subtitle: "击败青铜地牢的机械守卫者。"
			tasks: [{
				entity: "aether:slider"
				icon: {
					Count: 1
					id: "deep_aether:slider_eye"
