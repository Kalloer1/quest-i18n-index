	quest.520931345FB2F9DA.title: "金属压制机"
	quest.5237C37562D7748E.quest_desc: ["将&5树苗&r、&5树叶&r或任何可堆肥的物品放入桶中，会生成&a&l泥土&r&r。"]
	quest.52A20E22747C45F6.quest_desc: ["&a&lFTB Ultimine&r&r 包含在本整合包中。默认快捷键是 &a&l`&r&r"]
	quest.535D2BCB80461DE7.title: "装配器"
	quest.549B4759D21EB01F.quest_desc: ["把泥土扔进水里可以找到很多东西。试着弄点菌丝孢子吧。"]
	quest.558E9EE70875027C.quest_desc: ["用你的新曲柄钩钩住一些树叶，试着弄条美味的 &a&l丝虫&r&r 来尝尝。"]
	quest.5592D2FAAD06041E.quest_desc: [
		"{bold}数字矿工{/r}是终极采矿机器。"
		""
		"使用“过滤器”（标签或物品）配置，将方块直接传送到其物品栏。在 Skyblock 中，这非常适合“挖掘”压缩方块或生成的平台。"
	]
	quest.5592D2FAAD06041E.title: "数字矿工"
	quest.55EB7DED6C00C8D1.quest_desc: [
		"{bold}原子分解器{/r}是你唯一需要的工具。"
		""
		"可作为稿子、铲子、斧头和锄头使用。Shift+右键可切换挖掘模式（普通、缓慢、快速、矿脉、扩展矿脉）。"
	]
	quest.55EB7DED6C00C8D1.title: "原子工具：分解机 The Disassembler"
	quest.55F29A7414A84178.quest_desc: ["把一些尘埃扔进女巫水，会得到黏土？你肯定会以为是别的东西。"]
	quest.56FEE9AE14232F3F.title: "功能性存储系统"
	quest.57A14872F382D4CD.quest_desc: ["&4警告，此虚空能量&r。如需获取能量，请使用&aPowah 创意能量电池&r"]
	quest.589A4B5C1CE8ADD6.quest_desc: [
		"要前进，你需要{bold}强化合金{/r}。这需要在融合器中使用融合合金和{bold}钻石{/r}（最好是富集的）。"
		""
		"此阶段可解锁{bold}锇压缩机{/r}，让你能制作精制黑曜石和萤石。"
	]
	quest.589A4B5C1CE8ADD6.title: "第三阶段：加固（Tier 3: Reinforcement）"
	quest.59C9713C49D8B8C0.title: "预测"
	quest.59E542E401EA3A46.title: "管理好那些抽屉（Drawers）吧"
	quest.59F6FB890F94EE21.title: "最大生成延迟"
	quest.5AA1132CE32FEEB4.quest_desc: [
		"使用{bold}超临界相移器 (SPS){/r}，你可以将钋转化为{bold}反物质颗粒{/r}。"
		""
		"这需要天文数字的能量。幸好你有涡轮机和聚变反应堆！"
	]
	quest.5AA1132CE32FEEB4.title: "第五阶段：反物质与更遥远的未来"
	quest.5CB25214C6F7DF46.title: "忽略光照效果"
	quest.5CC2029774B1A7B3.quest_desc: ["如果你想让蜜蜂产蜜更快，就需要一个新朋友。在 JEI 中查找配方，了解它们的获取方式。"]
	quest.5D352F8D434EFA6D.title: "获取叶子的力量 (Get Leafy)"
	quest.5D36F5598C7E2844.quest_desc: [
		"本模组的基石。几乎所有 Tier 1 配方都需要 {bold}Infused Alloys{/r}。"
		""
		"要制作{bold}钢{/r}："
		"1. 将铁与碳（煤炭）融合，获得富铁矿。"
		"2. 再次将富化铁与碳融合，以获得钢粉。"
		"3. 将粉尘进行冶炼。"
	]
	quest.5D36F5598C7E2844.title: "第一级：基础合金与钢铁"
	quest.5E22B6FA7901FA85.quest_desc: [
		"5x 回响的潜行根茎"
		"5x 灵魂浸染的潜行根"
