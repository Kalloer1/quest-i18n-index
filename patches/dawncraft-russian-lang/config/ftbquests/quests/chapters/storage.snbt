	filename: "storage"
	title: "Видишь ящики? Загружай в ящики!"
	icon: "minecraft:chest"
	default_quest_shape: ""
	default_hide_dependency_lines: false
	quests: [
		{
			x: 0.0d
			y: 0.0d
			shape: "hexagon"
			description: ["В этом модпаке вам помогут только базовые сундуки, так как в нем тысячи уникальных предметов, и вы быстро обнаружите, что тонете в море сундуков, которые нужно отсортировать. К счастью, в этот модпак включены моды, которые значительно упрощают сортировку ваших сокровищ (и хлама)."]
			size: 2.0d
			id: "4D1B105EE54EDEAF"
			tasks: [{
				id: "3B86BA54AA15287D"
				type: "item"
				item: "minecraft:chest"
			}]
			rewards: [{
				id: "40A712D85762E768"
				type: "xp"
				xp: 1
			}]
		}
		{
			title: "储物箱"
			x: 2.25d
			y: 0.0d
			description: ["Ящики для хранения — идеальное решение, когда нужно хранить много предметов одного типа. Отлично подходят для вещей, которых у вас будет масса и к которым вы хотите получить легкий доступ (или выбросить). Они могут быть изготовлены с дополнительными выдвижными ящиками для хранения нескольких различных стопок в одном блоке, а также могут быть модернизированы для хранения большего количества предметов."]
			dependencies: ["4D1B105EE54EDEAF"]
			size: 1.5d
			id: "15C8700EFE52353A"
			tasks: [{
				id: "6FC7DD9A5732C9B4"
				type: "item"
				item: "storagedrawers:oak_full_drawers_1"
			}]
			rewards: [{
				id: "36BF6F96178BAC7D"
				type: "xp"
				xp: 5
			}]
		}
		{
			title: "云端存储仓库"
			icon: "cloudstorage:cloud_chest"
			x: 0.0d
			y: -2.0d
			description: ["Облачному хранилищу может потребоваться некоторое время для приобретения необходимых материалов, однако оно предлагает очень гибкую систему хранения. Нужна одна большая сеть хранения данных? Несколько штук поменьше? Несколько крупных, отдельных сетей? Облачное хранилище может сделать все это - просто убедитесь, что вы не боитесь высоты!"]
			dependencies: ["4D1B105EE54EDEAF"]
			size: 1.5d
			id: "6578C82B120DE0EA"
			tasks: [{
				id: "7F2BD0E1BBFBF5C1"
				type: "checkmark"
				title: "阅读一下"
			}]
			rewards: [{
				id: "6529B7B6EEBBFEB9"
				type: "item"
				item: "cloudstorage:guide_book"
			}]
		}
		{
			title: "空中气球"
			x: 0.0d
			y: -3.5d
			description: ["Чтобы начать работу с облачным хранилищем, вам понадобятся кусочки воздушного шара для изготовления воздушного шара и облачные блоки. Мобы из воздушных шаров появляются выше Y =196, как и облачные мобы, так что вам лучше найти какие-нибудь горы! Неплохая идея соорудить платформу в воздухе, чтобы легче было сражаться с ними, и лук, безусловно, помогает. Воздушные шары сбрасывают кусочки, которые можно изготовить из бечевки, чтобы сделать воздушный шар, а облачные мобы сбрасывают облачные блоки, которые можно использовать для создания облачных сундуков."]
			dependencies: ["6578C82B120DE0EA"]
			id: "34A5470646A4CE63"
			tasks: [{
				id: "24C6540B62EB8438"
				type: "item"
				item: "cloudstorage:balloon_inventory"
			}]
			rewards: [{
				id: "381FB78BCB25EFCD"
				type: "item"
				item: "minecraft:iron_ingot"
			}]
		}
		{
			title: "云端储物箱"
			x: 0.0d
			y: -5.0d
			description: ["Последний шаг настройки облачного хранилища — разместить облачный сундук под любым небесным блоком (не в помещении!). Щелкните по нему правой кнопкой мыши с воздушным шаром, и его инвентарь синхронизируется со всеми облачными сундуками того же цвета, что и воздушный шар. Все дополнительные сундуки того же цвета, что и воздушные шары, будут подключены к одной сети хранения."]
			dependencies: ["34A5470646A4CE63"]
			id: "5209737ECC6EC599"
			tasks: [{
				id: "7FF35AF151CD8866"
				type: "item"
				item: "cloudstorage:cloud_chest"
			}]
			rewards: [{
				id: "4F9D60196696D136"
