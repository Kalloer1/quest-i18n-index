	quest.365DA0E1FDA31DFB.title: "&e交个朋友吧 (Make a Friend)"
	quest.37E43341FA234E84.quest_desc: [
		"花店是花匠在提供堆肥和斧头后，为殖民地种植花朵的地方。"
		""
		"需要注意的一个重要因素是，花店的每日花卉限额取决于小屋等级。1级每日上限为4，2级为8。5级时每日上限为20。"
	]
	quest.37E43341FA234E84.quest_subtitle: "为殖民地种植&f花朵&r。"
	quest.37E43341FA234E84.title: "&f建造一家&6花店"
