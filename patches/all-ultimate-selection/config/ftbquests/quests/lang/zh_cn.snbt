	quest.2BA6A13429E1242B.quest_desc: [
		"下界合金巨兽是一个大型哥布林&4boss&f，是灵魂熔炉的 boss。它旨在成为玩家最早遇到的&4boss&f之一，也是最弱的 boss。"
		""
		"每个&5Soul&fForge结构中都会生成一个下界合金巨兽，在主厅后方的灵魂火中沉睡。当玩家进入其视野范围时，首领会苏醒。"
		""
		"免疫火焰、冰冻、坠落伤害、中毒和漂浮效果。"
		""
		"{entity:cataclysm:netherite_monstrosity ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:FORCE_OFF idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.2BA6A13429E1242B.quest_subtitle: "下界合金&4首领&f"
	quest.2BB30AED452773EB.quest_desc: ["便携式设备，让你能远程访问整个存储&9网络&f。它将多种功能整合到一个界面中，让你可以在任何有信号的地方无缝管理物品、制作物品和监控状态。"]
	quest.2BC941FC17558D35.quest_desc: ["这场有点热的冒险结束后，我们需要回到主世界，找到通往&5The End&f的堡垒。"]
	quest.2BC941FC17558D35.quest_subtitle: "返回世界"
	quest.2C0D9C9107FE0916.quest_desc: ["一家大酒店，或者我不知道这是什么……好多蜜蜂聚在一起，超级可爱。"]
	quest.2C0D9C9107FE0916.quest_subtitle: "旅馆？"
	quest.2C61DC46F2135CCE.quest_desc: ["继续我们的模组，现在还需要 inferium &2essence&f，可以在洞穴中找到！"]
	quest.2C61DC46F2135CCE.quest_subtitle: "我们的第一份&2精华&f"
	quest.2C68B51F72D824BD.quest_desc: [
		"&6Cloggrum&f &7ore&f 并不坚固……恰恰相反。"
		""
		"不过，作为入门矿石，它能帮你启动一些东西，还是不错的。"
	]
	quest.2C68B51F72D824BD.quest_subtitle: "一种新的&7矿石&f"
	quest.2C715DF198FD89CD.quest_desc: [
		"这个世界里发现了一个新的地牢……"
		""
		"这个地牢是一个巨大的房间，布满了蜘蛛网和羊毛，以蜘蛛为主..."
		""
		"别问我它们是怎么到那里的……我们需要她的掉落物！包括一个 Throne Pillar 指南针。"
	]
	quest.2C715DF198FD89CD.quest_subtitle: "蜜蜂地牢"
	quest.2C72EB0B879E0919.quest_desc: [
		"在&dApotheosis&f中，我们能找到一种名为“&4Invaders&f”的新类型首领"
		""
		"它们是更强大的生物，会突然出现在我们的世界中，并且总是携带带有&d前缀&f的物品。"
		""
		"它们有更多生命、更高伤害、更强的&c力量&f和&a再生&f，并且总是由它们的宝石代表。"
		""
		"它们生成的稀有度始终由世界等级决定！"
		""
		"世界层级是 Apotheosis 的附加内容，用于确定你的世界所处的层级。要查看世界层级，请使用 \"CTRL + T\""
	]
	quest.2C72EB0B879E0919.quest_subtitle: "更多等级与更高等级"
	quest.2CD0FC8F82599F65.quest_subtitle: "第10级"
	quest.2CD70FCC8B119D7A.quest_desc: ["泵上的棕色箭头符号表示流动方向。使用&a扳手&f可以改变流动方向。使用扳手后，整个阀门看起来会旋转180度。棕色的方向箭头会出现在泵齿轮的另一侧。"]
	quest.2D10C3340BA7BA6D.quest_desc: [
		"被称为机械&4凋零&f的Harbinger，是一种在远古工厂中找到的机械&4首领&f。"
		""
		""
		""
		"{entity:cataclysm:the_harbinger ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:FORCE_OFF idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.2D10C3340BA7BA6D.quest_subtitle: "&4凋零&f 首领+"
	quest.2D286D3EC63E7063.quest_subtitle: "我们还是不知道吗？"
	quest.2D2CC0B1CE4AE09E.quest_desc: [
		"在我们的模组中，可以在世界中找到&3钢&f矿石。这种矿石是我们一切的开始！去收集一些钢吧。"
		""
		"钢铁被用作原油加工、机器、钢铁工具、宇航服和&3氧气&f罐的组件。"
	]
	quest.2D2CC0B1CE4AE09E.quest_subtitle: "万物的基础！The Foundation of Everything!"
	quest.2D2CC0B1CE4AE09E.title: "&3钢&f锭"
	quest.2D2F427287880ED9.quest_subtitle: "研磨 &2食物&f"
	quest.2D910F2DCE1D042D.quest_desc: ["Inferium &2种子&f是一切的基础；有了它，我们就能更&a轻松&f地获取模组启动所需的资源。"]
	quest.2D910F2DCE1D042D.quest_subtitle: "第一阶"
	quest.2DB15D6F32CA8243.quest_desc: ["这个方块就像反应堆一样，可以通过堆叠这些方块来加快&a生长&f的&a速度&f。"]
	quest.2DB15D6F32CA8243.quest_subtitle: "加速中！"
	quest.2DCE17DC20F0248D.quest_desc: ["Cataclysm 是一个大型模组，添加了数十种新生物，包括&4boss&f。Cataclysm 还添加了各种新盔甲、工具等级、8种结构、武器、装饰方块、宠物、奇物和音乐。"]
	quest.2DCE17DC20F0248D.quest_subtitle: "新增&4首领&f"
	quest.2DCE17DC20F0248D.title: "大灾难"
	quest.2DD8B4E9780FC649.quest_desc: [
		"这件强大的&7盔甲&f可以通过杀死一头地狱&4巨龙&f来获得！"
		""
		""
		""
		"{entity:block_factorys_bosses:infernal_dragon ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:USE_GLOBAL width:50 height:50 align:center}"
	]
	quest.2DD8B4E9780FC649.quest_subtitle: "骸骨中的骸骨"
	quest.2DD8B4E9780FC649.title: "&4龙&f骨盔甲"
	quest.2DE01FA9BBA462DA.quest_desc: ["有了这本&6书&f，你就能找到指引，确切地知道需要哪个&5仪式&f，以及如何完成仪式。"]
	quest.2DE01FA9BBA462DA.quest_subtitle: "指南手册"
	quest.2DE734D44F2EAB05.quest_subtitle: "用于制作稀有卷轴的配方"
	quest.2DE8CB93BC76A70E.quest_desc: ["嗯，这个模组里总得有个好东西，而这把&2锄头&f还真不错。"]
	quest.2DE8CB93BC76A70E.quest_subtitle: "&2海之锄&f"
	quest.2E274BEEF2B0B8C7.quest_desc: [
		"化学氧化器用于将材料制成&3气体&f。它是&9Mekanism&f5倍矿石生产系统所需的至关重要机器。"
		""
		"好的，我们先来制作二氧化硫吧。"
		""
		"将硫磺粉投入这台&9机器&f，即化学氧化器中，就能&6生成&f二氧化硫。"
		""
		"现在需要制造三氧化硫。将二氧化硫送入化学催化器，与&3氧气&f结合，生成三氧化硫。"
		""
		"将三氧化物送到另一个化学注入器中，与水蒸气结合以生成硫酸。"
	]
	quest.2E2B9C432CC64CB6.quest_desc: ["{entity:occultism:foliot ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:FORCE_OFF idle:FORCE_OFF walk:FORCE_ON width:100 height:100 align:center}"]
	quest.2E2B9C432CC64CB6.quest_subtitle: "第一只&5恶魔&f"
	quest.2E747C1C2DB534B5.quest_desc: ["{ftb\tquests.chapter.mystical_agriculture.quest2E747C1C2DB534B5.description1}"]
	quest.2E747C1C2DB534B5.title: "{ftb\tquests.chapter.mystical_agriculture.quest2E747C1C2DB534B5.title}"
	quest.2E8B8DBE61162084.quest_desc: [
		"它们可以过滤特定物品，并用&c红石&f信号阻止。与漏斗不同，它们能同时插入和提取，但只能垂直工作。"
		""
		"当漏斗槽位于物品栏正下方时，它会像黄铜漏斗一样，同时作为值设置二极管。滑槽可调整以提取最多或精确的指定数量的物品。智能滑槽的值设置在上方物品栏被破坏后仍会保存，但这不影响滑槽在不在物品栏下方的行为。"
	]
	quest.2EC18075C62BAAF4.quest_desc: ["普通的骨粉对&d神秘&f&2作物&f无效，但我们可以用这个！"]
	quest.2EC18075C62BAAF4.quest_subtitle: "新食谱：美味佳肴（New Meal）"
	quest.2EF4DD5CC254CC80.quest_desc: [
		"机械管道是&9Mekanism&f的&3流体&f管道。"
		""
		"可用于连接任何带有流体处理器的方块。"
	]
	quest.2EF6EB536C67FFA9.quest_desc: [
		"找到一个名为&1Deep Dark&f的新生物群系... 在这个生物群系里有一个新的&4Boss&f。"
		""
		"我们需要从他那里获得一个掉落物。"
	]
	quest.2EF6EB536C67FFA9.quest_subtitle: "一个奇怪的地方"
	quest.2EF6EB536C67FFA9.title: "&1深层黑暗&f"
	quest.2F0B0D4401AA455E.quest_desc: [
		"可以使用&a扳手&f来为隧道添加窗户。"
		""
		"隧道不会阻止传送带上物品的封装风扇处理，但会阻止气流超出传送带。"
		""
		"安山岩隧道也可用于将单个物品与通过的堆叠分离到侧面输出。"
	]
	quest.2F0B0D4401AA455E.title: "隧道"
	quest.2F6B432512FA2A65.quest_desc: ["连接到任何物品栏以扩展其表面面积。非常适合在狭小空间和与阈值开关的智能设置中存取物品。"]
	quest.2F9782EE3A7826A2.quest_desc: [
		"恶意印记&d&f是一种新印记，会随机重掷工具或装备的&d前缀&f。"
		""
		"只能通过击败其他维度（如下界）的 boss 才能获得。"
	]
	quest.2F9782EE3A7826A2.quest_subtitle: "&4入侵者&f"
	quest.30039F24EC97CC6C.quest_desc: ["这个新层级也出现在 Haven &eworld tier&f 中，但在 &eFrontier&f 层级中出现的频率要高得多。"]
	quest.30039F24EC97CC6C.quest_subtitle: "&a不常见&f"
	quest.302D29E43E9C9A94.quest_desc: [
		"放置在任意物品栏旁时，包装器可以从所附物品栏中&6创建&f纸板包裹。此过程不需要额外材料。"
		""
		"当用&c红石&f信号供电时，包装器会尽可能多地填充包裹。纸板包裹有9个物品栏。在包装器上放置附魔台标签，可为生成的纸板包裹标注要寄送的地址。"
	]
	quest.30590B11F96963BB.quest_desc: [
		"这个简单的&2精华&f可以拯救你的&a生命&f..."
		""
		"当你濒临死亡时，一切都会变暗，然后你会在床里醒来，&a安然无恙&f……生命值和饱食度都满。"
		""
		"一份关于你濒死经历的日记将被送达！"
	]
	quest.30590B11F96963BB.quest_subtitle: "图腾&2精华&f"
	quest.305F917BCC702806.quest_subtitle: "&1月亮&f矿石！"
	quest.307207FA459CD598.quest_desc: ["……我永远不会厌倦在这里谈论&dMystical&f。"]
	quest.307207FA459CD598.quest_subtitle: "... 2.0"
	quest.30A84C6A54BD336E.quest_desc: [
		"固定的&9机械&f钻头会以 (45 x 硬度)/RPM 秒的速度破坏前方的方块，并对周围实体造成伤害。"
		""
		"由机械装置驱动的机械钻会破坏方块，并&c伤害&f与之碰撞的实体，无需直接提供旋转力。"
		""
		"机械钻头破坏方块所需的时间取决于装置的&a速度&f和方块的硬度值。对实体造成的伤害也取决于装置的速度。"
	]
	quest.30C364AC05822920.quest_desc: ["物理引擎助我们一臂之力，能建造出不可思议的事物，而新机制让一切变得&a更简单&f。"]
	quest.30C364AC05822920.quest_subtitle: "更好地了解这个模组 &abetter&f"
	quest.30C364AC05822920.title: "&6创建&f航空学 2"
	quest.30CA7387B27B439C.title: "&6Cloggrum&f 工具"
	quest.30D6BFA1A3B6B205.quest_desc: ["一个齿轮箱，其4个面的旋转方向均可独立配置。"]
	quest.31279859BEEB3E5E.quest_desc: ["就是这样……这是一把经验&c剑&f。"]
	quest.31279859BEEB3E5E.quest_subtitle: "经验值"
	quest.313754B1B708BC31.quest_desc: [
		"有了锻造台，我们就可以把工具和&b宝石&f组合在一起了。"
		""
		"确保你的工具有一个空的 &esocket&f，把工具和宝石放在桌子上，就完成了！"
	]
	quest.313754B1B708BC31.quest_subtitle: "融合两个世界"
	quest.314DBD2F4AD83FD3.quest_desc: [
		"&5末地&f守卫是一种大型鞘翅类傀儡&4boss&f，是废弃堡垒的领主。"
		""
		"如果玩家靠近位于废弃堡垒三楼的虚空祭坛，末地守卫就会出现。"
		""
		"{entity:cataclysm:ender_guardian ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:FORCE_OFF idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.314DBD2F4AD83FD3.quest_subtitle: "末地&4首领&f"
	quest.31A06D0CDFE935A7.quest_desc: [
		"{ftb\tquests.chapter.mystical_agriculture.quest31A06D0CDFE935A7.description1}"
		""
		"{ftb\tquests.chapter.mystical_agriculture.quest31A06D0CDFE935A7.description2}"
	]
	quest.31A06D0CDFE935A7.title: "{ftb\tquests.chapter.mystical_agriculture.quest31A06D0CDFE935A7.title}"
	quest.31D8BC1E58DD46E0.quest_desc: ["这个模组太棒了！这就是 Sophisticated Storage，公认的最佳之一。我们可以&6创造&f箱子、桶、末影人箱和其他物品，拥有巨大的存储空间和让一切更棒的&a升级&f！"]
	quest.31D8BC1E58DD46E0.quest_subtitle: "Sophisticated Storage"
	quest.31E90057B6F054BB.quest_desc: ["我们可以&6创建&f一个控制器，并将其绑定到我们的&9系统&f上，以便远程打开存储系统。"]
	quest.31E90057B6F054BB.quest_subtitle: "无线访问权限已授予。您可以使用无线方式访问您的物品。"
	quest.31F32DDFB3F53EF2.quest_desc: ["我们需要一些源&7石&f来进行各种制作，这非常简单。"]
	quest.31F32DDFB3F53EF2.quest_subtitle: "&7宝石镶嵌的石头&f"
	quest.31F32DDFB3F53EF2.title: "来源 &7石头&f"
	quest.327AD63BFE3170D2.quest_desc: [
		"要前往暮色&5维度&f，我们首先需要找到一颗钻石并把它扔进&5传送门&f。为此，请收集12朵花。"
		""
		"按照这张图片，将一颗 &b钻石&f 投入水中。"
		""
		"{image:\tquests:textures/gui/twilight.png width:100 height:100 align:center}"
	]
	quest.327AD63BFE3170D2.quest_subtitle: "扔掉 1 个 &b钻石&f 方块"
	quest.327AD63BFE3170D2.title: "正在创建&5传送门&f"
	quest.32846AB135D2A5E3.quest_desc: ["这是所有其他&a升级&f卡牌的基本组件。"]
	quest.32DE0C256F164B9F.quest_desc: ["朋友，你好！我们的整合包里有许多模组，其中之一就是 Sophisticated Backpacks。这是一个很棒的背包模组，能让我们把物品存入背包，并用&a升级件&f来增强它们。"]
	quest.32DE0C256F164B9F.quest_subtitle: "Sophisticated Backpacks"
	quest.32F11FC9B6082A0C.quest_desc: [
		"我们终于达到了最后一个等级，而这是装备和工具的最佳等级！"
		""
		"&5mythic&f 等级仅在 Summit &eworld tier&f 中出现，而在 Pinnacle world tier 中更为常见。"
	]
	quest.32F11FC9B6082A0C.quest_subtitle: "&5神话&f"
	quest.331698AEA2CFCB4A.quest_desc: ["&2Gloomper&f是一种非常有趣且极其聪明的怪物。它不会先攻击你，但如果你攻击它，它会自卫并用&2毒&f来反击你！"]
	quest.331698AEA2CFCB4A.quest_subtitle: "一只小青蛙"
	quest.338E4A4F41889959.quest_desc: [
		"ME 合成终端是 ME 终端的升级版，集成了合成网格，并可访问 ME &9网络&f的联网存储。"
		""
		"和ME终端一样，它也需要一个频道才能运行。"
	]
	quest.3424B27C62D3D2CF.quest_desc: [
		"可通过无线终端无线访问。范围和&e功率&f消耗取决于已安装的无线增强器数量。"
		""
		"一个 &9网络&f 可以包含任意数量的无线接入点，每个接入点又可以安装任意数量的无线增强器，让你可以通过调整配置来优化功耗和覆盖范围。"
		""
		"需要一个频道。"
		""
		"也用于绑定无线终端设备"
	]
	quest.3433F3084D9ACCAE.quest_desc: ["宇航员，欢迎来到&1月球&f……这挺酷的，对吧？好了，别太激动，注意你的&3氧气&f，希望你有足够的氧气，要不找找新的矿石？"]
	quest.3433F3084D9ACCAE.quest_subtitle: "我们偷走了&1月亮&f！"
	quest.3433F3084D9ACCAE.title: "&1月亮&f"
	quest.34C2F6B171372824.quest_desc: [
		"我们需要杀死一些&4凋零骷髅&f来寻找凋零头颅，并完成我们的原版路线。"
		""
		"{entity:minecraft:wither_skeleton ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:FORCE_OFF idle:FORCE_OFF walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.34C2F6B171372824.quest_subtitle: "寻找骷髅头骨的任务书文本"
	quest.34C2F6B171372824.title: "&4凋零骷髅&f 骷髅"
	quest.34E1AB8D35A5DB54.quest_desc: ["要获得这件最漂亮的&7盔甲&f，我们必须击败&2九头蛇&f。"]
	quest.34E1AB8D35A5DB54.quest_subtitle: "像&6太阳&f一样炽热"
	quest.34E1AB8D35A5DB54.title: "火焰&7盔甲&f"
	quest.34F617DDF423C6C1.quest_subtitle: "增加每个格子的最大容量"
	quest.3525FD510FCA7C6C.quest_desc: [
		"我相信你不是喜欢血的吸血鬼……但这所学校非常强大，还拥有惊人的&d法术&f！"
		""
		"要制作血瓶，请在熔炉下放一个篝火，然后将动物投入熔炉中。"
	]
	quest.3525FD510FCA7C6C.quest_subtitle: "血魔法学校"
	quest.3527A4E254F094F2.quest_desc: ["这套不可思议的&7盔甲&f来自一个&d新艺术运动&f的附加包。它相当坚固，如果制作得当，会更强！"]
	quest.3527A4E254F094F2.quest_subtitle: "Ars"
	quest.3527A4E254F094F2.title: "Thunderguard的&7盔甲&f"
	quest.35365535ED46DAD0.quest_desc: ["Applied Energistics 2 (AE2) 是一款全面的 Minecraft 模组，引入了独特的游戏内物品管理方式。其主题围绕将物质转化为&e能量&f及反之，以即时存储和运输物品与&3流体&f！"]
	quest.35365535ED46DAD0.quest_subtitle: "开始冒险！"
	quest.35365535ED46DAD0.title: "AE2"
	quest.3562111D841CF498.quest_desc: [
		"顺序齿轮可更精细地控制旋转&e功率&f，允许在一段时间内多次改变旋转。"
		""
		"顺序齿轮换挡器一次最多可输入5个命令。将鼠标悬停在命令上并滚动即可调整每个命令。"
		""
		"第一列包含命令：按角度转向、活塞转向、定时延迟、等待新的&c红石&f脉冲和结束。前两个分别是机械活塞和机械轴承对应的不同旋转量，第三个使齿轮换挡在继续前等待，第四个则使序列在齿轮换挡接收到另一个脉冲前停止。结束表示序列的&5末尾&f，但并非完成序列所必需。"
		""
		"{@pagebreak}"
		""
		"第二列调整了每个命令的测量值。转向最多360度，活塞最多128格，等待最多30秒。"
		""
		"第三列可调整&a速度&f和方向。此处可加倍旋转、反向旋转、两者兼有或两者皆无。"
		""
		"红石比较器可用于检测序列齿轮换挡器处于哪个指令。无论换挡器包含多少指令，其输出信号强度最高可达5。"
	]
	quest.35639D4A6DDF6FF9.quest_desc: [
		"当施加&c红石&f信号时，Clutch会停止向外旋转。"
		""
		"当Clutch未激活时，它将像Shaft一样传递旋转。当激活时，它将停止传递旋转。"
	]
	quest.35A5750F7BA0B7CF.quest_desc: [
		"啊，原来是&bAether&f……"
		""
		"一款深受我们喜爱且令人怀念的模组。"
		""
		"但它隐藏着难以想象的危险……面对新生物，在一个与我们截然不同的世界中玩耍……这就是Aether。"
	]
	quest.35A5750F7BA0B7CF.quest_subtitle: "怀旧与乐趣"
	quest.35C37231C1C86294.quest_desc: [
		"强力胶水有两种应用模式：逐块模式和区域模式。这两种模式可以在同一个装置中混合使用。"
		""
		"每次使用强力胶水都会使其耐久度减少一点。（此处的耐久度指一管强力胶水可使用的次数。胶水粘合的方块在未被移除前是永久性的。）强力胶水可以通过附魔“不损坏”和“修补”来延长其&a寿命&f。"
		""
		"{@pagebreak}"
		""
		"逐块建造模式"
		"在逐块模式下，强力胶水的使用方式与史莱姆球相同。手持强力胶水右键点击线性底盘或径向底盘，即可将底盘表面涂覆上绿色胶水，从而可以附着其他方块。"
		""
		"放置方块时，副手也可手持强力胶水以&9自动&f将每个方块单独粘合。注意，底盘边缘无法像表面一样涂上胶水。不过，副手持强力胶水时，仍可把方块附着在底盘边缘。"
		""
		"潜行状态下，手持空手右键点击底盘的各个面，即可移除胶水涂层。"
		""
		"{@pagebreak}"
		""
		"区域模式"
		"区域模式用于在放置后粘合区块集合。按住强力胶水，右键点击区域一角上的方块。将光标移至区域的对角。会出现一个绿色方框，表示将被粘合的方块。再次右键完成粘合。要取消，请潜行状态下右键。"
		""
		"第二个方块最多可偏离初始选中的方块24格，最大选择体积为2312。无论选择大小，耐久度仅消耗1。重叠的强力胶水会合并，同时保持其形状。注意，在区域模式下，游戏不允许选择底盘的面，而是会切换回逐块模式。要在区域模式下选择底盘，请点击侧面而非正面。"
		""
		"只需在主手持有强力胶水，即可看到已粘合的区域。粘合区域会显示绿色轮廓。注意，先涂胶水再放置方块（如“逐块模式”）粘合的方块不会显示绿色轮廓。但用副手强力胶水粘合的方块会显示绿色轮廓。"
	]
	quest.35C37231C1C86294.title: "&a强力胶水"
	quest.35C69F1A9F2D95AB.quest_subtitle: "第5级"
	quest.35CB6CA0EEE8C848.quest_desc: ["这片圣所已被遗忘，怪物占领了这里，有很多……所以保持警惕！"]
	quest.35CB6CA0EEE8C848.quest_subtitle: "怪物与更多怪物"
	quest.35F24F6E403AADA1.quest_desc: ["六个面都有轴的齿轮箱。概念上使用了与平行齿轮箱相同的内部机制，因此顶部和底部的转速是&a速度&f的一半。"]
	quest.360FC112BC79E9DB.quest_subtitle: "我们的血液魔法 &dMagic&f"
	quest.3617DE87C4E1BCB9.quest_desc: ["手摇曲柄通过玩家互动产生少量旋转力。"]
	quest.36268EBCE1143F0A.quest_desc: [
		"我们可以用史莱姆球来修复汽车、船只、飞机...受损或破损的角落"
		"用史莱姆球点击损坏的部分即可修复。"
	]
	quest.36268EBCE1143F0A.quest_subtitle: "修复"
	quest.371BB0B5D2347185.quest_desc: ["我们可以用&7矿石&f来升级我们的&7斧头&f，这样能稍微提升性能并赋予它一个新属性。"]
	quest.371BB0B5D2347185.quest_subtitle: "告别常规，迈向非凡"
	quest.3734081CB77CDBB5.quest_desc: [
		"物质炮中的物质球可以被颜料球替代，颜料球会在被射击的方块表面产生颜料飞溅效果。"
		""
		"Lumen Paint Balls 是 Matter Cannon 专用的特殊颜料球，其颜料溅落物在生成后也会发出光亮。"
	]
	quest.37388CAD4435A48B.quest_desc: ["这把漂亮的武器简直是游戏中最好的&c剑&f之一，而且有了&a升级&f槽，它会变得更强大！"]
	quest.37388CAD4435A48B.quest_subtitle: "最强大的生物之一"
	quest.376304CC25EFAFCF.quest_subtitle: "召唤学校 &7盔甲&f"
	quest.376304CC25EFAFCF.title: "远古召唤者&7盔甲&f"
	quest.3763C9494249EC62.quest_subtitle: "{ftb\tquests.chapter.mystical_agriculture.quest3763C9494249EC62.subtitle}"
	quest.3763C9494249EC62.title: "{ftb\tquests.chapter.mystical_agriculture.quest3763C9494249EC62.title}"
	quest.378C79BB8DDE9AE8.quest_subtitle: "更好的&6熔炉&f"
	quest.37CEF3958664FD41.quest_desc: ["作为我们的第一个&d法术&f，我们可以制作一个光之&d符文&f。在空中点击它即可学习这个法术！有了它，我们就能照亮世界！"]
	quest.37CEF3958664FD41.quest_subtitle: "第一道&d法术&f"
	quest.383784BD11018358.title: "{ftb\tquests.chapter.mystical_agriculture.quest383784BD11018358.title}"
	quest.383C6C030B6A5F90.quest_desc: ["这些&d法术&f有种神圣感……好吧，听起来不可思议，这里没有女巫要烧……但这些法术确实有种神圣感……这所学校很有趣。"]
	quest.383C6C030B6A5F90.quest_subtitle: "神圣的学校"
	quest.383D6F1A001A0AEC.quest_desc: ["滑道用于垂直运输物品，通常向下，除非使用封闭式风扇向上吹送。滑道有两种类型：普通滑道和智能滑道。智能滑道允许玩家控制通过的物品类型及其堆叠大小。"]
	quest.38B84F3ADA7952F5.quest_desc: ["在我们的整合包里，我们可以超越&8下界合金&f盔甲：将下界合金与一些&7矿石&f结合，使其更坚固、更强大！"]
	quest.38B84F3ADA7952F5.quest_subtitle: "改善最佳方案 (Improving the Best)"
	quest.38B84F3ADA7952F5.title: "&8下界合金&f-翡翠盔甲"
	quest.38C6D933BE2A7E5D.quest_desc: ["我们的新多方块结构允许混合材料，并从这些材料中获得合金。"]
	quest.38C6D933BE2A7E5D.quest_subtitle: "混合中"
	quest.38E84EA139A2316C.quest_desc: [
		"驱动器是将存储单元接入以用于&9网络&f存储的设备。它有10个插槽，每个插槽可容纳一个单元。"
		""
		"如果出于某种原因需要，你可以用漏斗或AE2总线等物品物流系统来推拉其物品栏中的物品。"
		""
		"可以用 Certus Quartz &a扳手&f 来旋转它。"
	]
	quest.38E9C4DB82B1279A.quest_desc: [
		"静止状态下，可将某些物品应用到方块过滤器上。若有过滤器，则只会影响该装置实体。若在组装前后及组装期间用&c红石&f信号供电，装置实体将初始化为禁用状态。注意，在装置上组装的红石和杠杆无效。"
		""
		"在已组装的装置上，右键点击装置控制器可以启用或禁用特定的装置执行器。"
	]
	quest.3931273289B3A68C.quest_desc: [
		"Fluix ME 玻璃线缆是最简单的线缆，可传输&e电力&f和最多8个频道。它有17种不同颜色，默认是Fluix色，并且可以用16种染料中的任意一种染成任何颜色。"
		""
		"要制作彩色线缆，用8根同类型线缆包围任意染料（线缆颜色无关紧要，但类型必须相同，如玻璃、智能等）。你也可以在世界上用任何Forge兼容的画笔来给线缆上色。"
		""
		"你可以用一桶&3水&f来制作任何颜色的电缆以去除染料。"
		""
		"你可以用羊毛覆盖电缆来&6创造&fFluix ME 覆盖电缆，并制作Fluix ME 智能电缆，从而更&a清楚&f地了解你的频道状况。"
	]
	quest.3990828CCE937FA0.quest_desc: ["看来&1卫道士&f确实来自另一个世界……这个地方有超自然的东西。找到&1古城&f并击败卫道士，这样我们才能开始探索这个神秘的地方。"]
	quest.3990828CCE937FA0.quest_subtitle: "&1坚守者&f的家园"
	quest.3990828CCE937FA0.title: "深邃与黑暗"
	quest.3999760881C855FA.quest_desc: [
		"The Chemical Crystallizer turns Clean Slurry into Crystals, Lithium into Lithium Dust and Antimatter into Antimatter Pellet. This is one of the select many &9machines&f in &9Mekanism&f to have dedicated, unchangeable sides, for input and output, with the exception of Item's config sides."
		""
		"输入是气体（使用 Pressurized Tube），输出是物品（使用 Logistical Transporter）"
	]
	quest.39B0061C40FD5B67.quest_subtitle: "将羽毛投入&6火焰&f中"
	quest.39D2E5654A911DBB.quest_desc: ["此发电机利用&2食物&f子提取物来生成你的&b法力&f！在旁边放一个带食物的基座！"]
	quest.39D2E5654A911DBB.quest_subtitle: "使用 &2食物&f 生成中"
	quest.39F43CF8BFFA46A0.quest_desc: ["这台&9机器&f可以组合物品，非常适合制作新类型的配方。"]
	quest.39F43CF8BFFA46A0.quest_subtitle: "我们的第二个多方块结构"
	quest.3A2633B6030BBC52.quest_desc: ["佩戴工程师护目镜时，可以查看运行中&9机器&f的压力影响。查看压力计或速度计时，会显示数值并高亮当前转速。此外，还能显示储罐中的&3流体&f量及总存储容量。"]
	quest.3ADDA80FD3DFB33B.quest_desc: [
		"当我们吃掉这种水果时，就能用不同的眼睛看待世界，一窥隐藏在..."
		""
		"在果实效果下，我们能更&a好&f地破坏&5Occultism&f方块！"
		""
		"有时候可能会失败！"
	]
	quest.3ADDA80FD3DFB33B.quest_subtitle: "用不同的眼睛看待世界！"
	quest.3ADF5889DFB9121C.quest_desc: ["{entity:minecraft:ender_dragon ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:FORCE_OFF walk:FORCE_OFF width:200 height:100 align:center}"]
	quest.3ADF5889DFB9121C.quest_subtitle: "击杀 &5末影龙&f"
	quest.3ADF5889DFB9121C.title: "&5末影龙&f"
	quest.3AFA504735B789C0.quest_desc: ["在工程学中，我们需要毫米级的精度；这个杠杆可能正是你所寻找的！"]
	quest.3AFA504735B789C0.quest_subtitle: "&e力量&f 掌控"
	quest.3B3C89649DF57161.quest_desc: [
		"量子&9网络&f桥可以将网络延伸至无限距离，甚至跨越&5维度&f。它们总共可承载32个频道（无论电缆如何连接到各个面），本质上就像一根无线高密度电缆。"
		""
		"在ME量子链接室周围放置八个量子环即可创建一个量子网络桥。只有与ME量子链接室相邻的4个ME量子环方块可以接受网络连接，4个角上的方块无法连接电缆。"
	]
	quest.3B43DB1A6B0A7B44.quest_desc: ["生物燃料由 &9Mekanism&f 添加，是一种在生物发电机中使用的燃料。此外，生物燃料还用于高压反应室来 &6创造&f 乙烯。"]
	quest.3BA16477C131C63C.quest_subtitle: "第4阶段"
	quest.3BC139FA66626100.quest_desc: ["这把&7斧头&f非常适合前期游戏！"]
	quest.3BC139FA66626100.quest_subtitle: "Fluix？"
	quest.3BDFA23A7CE8E173.quest_desc: [
		"将橡木树苗投入神秘&6火焰&f，将其变为神秘树苗！种下树苗，看着它&a生长&f！但要看到其真正的形态，还需吃掉另一个果实！并且只能在果实的作用下才允许破坏。"
		""
		"你需要把各种物品扔进火里才行！"
	]
	quest.3BDFA23A7CE8E173.quest_subtitle: "神秘古树！"
	quest.3BF486B9A4924DEB.quest_desc: ["有时候，基础的东西用起来就是这么顺手。"]
	quest.3BF486B9A4924DEB.quest_subtitle: "保持传统风格"
	quest.3C13A07E90BC9312.quest_desc: ["没什么好解释的，名字已经说明了一切。"]
	quest.3C13A07E90BC9312.quest_subtitle: "&b钻石&f + 钻石 = 超级钻石"
	quest.3C1B56EBC567CB02.quest_desc: ["这个&4boss&f是新&8dungeon&f的守护者...小心点，它的力量超乎想象。"]
	quest.3C1B56EBC567CB02.quest_subtitle: "&4首领&f"
	quest.3C1DD9DBED86AE6F.quest_desc: ["我们可以通过这个发电机，在周围消灭或繁殖生物来生成&b法力&f。"]
	quest.3C1DD9DBED86AE6F.quest_subtitle: "使用生命值生成中"
	quest.3C352E5DCE537254.quest_desc: ["使用娜迦的掉落物来制作&7盔甲&f。"]
	quest.3C352E5DCE537254.quest_subtitle: "Naga 掉落物"
	quest.3C49F2EEDCCAF1DF.quest_desc: [
		"你的工厂基本布局应该是这样的："
		""
		"原矿石进入化学溶解室，泵入气体至化学洗涤器，再泵入气体至化学结晶器，输出晶体至化学注射室，输出碎片至净化室，输出块体至破碎机，输出脏粉尘至富集室，最后输出干净的&7粉尘&f至熔炼炉。"
	]
	quest.3C50723252069D30.quest_desc: ["本模组中，没有比探索更&e重要&f的事情了。探索世界，寻找巫师小屋和其他建筑，在那里我们能找到第一卷卷轴和几件关键物品。"]
	quest.3C50723252069D30.quest_subtitle: "探索"
	quest.3C5D84B0D51474E7.title: "{ftb\tquests.chapter.mystical_agriculture.quest3C5D84B0D51474E7.title}"
	quest.3CAB660D10C42BB4.quest_desc: [
		"好吧，我知道再次进入这个心爱的&5维度&f感觉就像做梦一样..."
		""
		"但醒醒！别忘了你此行的目的：击败&4bosses&f，确保天空的和平。"
	]
	quest.3CAB660D10C42BB4.quest_subtitle: "进入梦境中"
	quest.3CDEA7F1A004F8DC.quest_subtitle: "修补（Mending）"
	quest.3D2F4E9242F96F4D.quest_desc: ["学生们去到队伍&5的末尾&f来&6创建&f这所学校。他们的法术令人印象深刻，而且威力强大。"]
	quest.3D2F4E9242F96F4D.quest_subtitle: "&5末影&f学校"
	quest.3DC74356834228D8.quest_desc: ["调节器&a升级&f是出口商和进口商的升级，用于在连接的物品栏中维持一定量的资源。"]
	quest.3E0003E4F668E92A.quest_desc: ["This little monster is extremely furious! Be &ccareful&f with it."]
	quest.3E0003E4F668E92A.quest_subtitle: "愤怒！"
	quest.3E66107BBC14089B.quest_subtitle: "第5级"
	quest.3EB76F4243716FB5.quest_subtitle: "附魔核心 (Core for Enchanting)"
	quest.3ED5669772436080.title: "&5Utherium&f 工具"
	quest.3F64E97936F08E15.quest_subtitle: "我们的神圣&d魔法&f"
	quest.3F925BFD3CF1DC0B.quest_subtitle: "用于扩大无线接入点的覆盖范围。"
	quest.3FEEED5377A90191.quest_desc: ["这就是黄色的庇护所！一个充满挑战的庇护所，有着不可思议的&e奖励&f。"]
	quest.3FEEED5377A90191.quest_subtitle: "一项伟大的挑战！"
	quest.4083834439278AC3.quest_subtitle: "&b钻石&f 宝箱"
	quest.40CDA8B7AAC831B0.quest_desc: [
		"这个世界上住着一只巨大的蛇，它是暮色森林的第一个&4boss&f。"
		""
		"The Naga must be defeated in segments: she is massive, and you need to keep damaging her body parts to bring her down at &5the end&f."
		""
		"{entity:twilightforest:naga ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:FORCE_OFF walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.40CDA8B7AAC831B0.quest_subtitle: "第一个挑战"
	quest.413869D9ACF48D10.quest_desc: ["来打些怪物吧……在找到要塞前，先收集点经验值，测试下我们的实力。"]
	quest.413869D9ACF48D10.quest_subtitle: "击败一些怪物"
	quest.413869D9ACF48D10.title: "击杀生物"
	quest.4143F14C28FA7960.quest_desc: [
		"在这个世界中探索，我们可以找到&2黑暗森林&f..."
		""
		"在这片黑暗的森林里，你会发现一个通往地下的建筑。"
		""
		"要进入，你需要将击败的&4boss&f之一的奖杯头颅放在基座上；离开时，头颅会被取回。"
		""
		"穿过层层叠叠的土层，直到你找到&4boss&f。"
		""
	]
	quest.4143F14C28FA7960.quest_subtitle: "&2黑暗森林&f"
	quest.4167B92ED5B27A15.quest_desc: ["每当我们达到新的&2seed&f等级，就能在&dMystical&f中获得新工具，变得越来越强！"]
	quest.4167B92ED5B27A15.quest_subtitle: "新工具"
	quest.4167B92ED5B27A15.title: "觉醒的工具"
	quest.417457E2EB5F3657.quest_desc: ["你知道吗，交易不是获得&5末影&f珍珠的唯一方法。还有一种生物叫&5末影人&f会掉落它们……我正在教你最简单的方法，我可是Minecraft职业玩家（开玩笑的）。"]
	quest.417457E2EB5F3657.quest_subtitle: "贸易之王"
	quest.417457E2EB5F3657.title: "&5末影&f珍珠"
	quest.41792C2BB29C3449.quest_desc: ["我们的整合包里仍然有原版盔甲，但它们在这里并不会很强。"]
	quest.41792C2BB29C3449.quest_subtitle: "原版内容"
	quest.41792C2BB29C3449.title: "&b钻石&f盔甲"
	quest.4181323BF72047A9.quest_desc: [
		"右键点击一个有效的调度员，将调度表交给他们。调度员必须是坐在已组装的火车的火车控制器正前方的生物，或是以类似方式放置的&6烈焰人&f燃烧器。"
		""
		"可以添加 3 种类型的命令。"
		""
		"前往车站 - 导航至指定的火车站。"
		"更新计划标题&r - 显示链接中火车站摘要所显示的路线名称。"
		"限制最大&a速度&f - 更改前往车站时的最大速度。"
	]
	quest.419BBE875D40B1D6.quest_desc: [
		"ME 导出总线会从 ME &9网络&f的联网存储中提取物品，并将其放入其正对的物品栏中。"
		""
		"你必须配置要插入的物品，否则将不会有任何效果。"
		""
		"ME 导出总线会尝试导出列表中的任何物品，无法放入目的地的物品将被跳过。"
		""
		"ME 导出总线&r需要通道才能运行。"
		""
		"这是ME导入总线（ME Import Bus）的功能性反义装置。"
	]
	quest.41CEBA836A8BA22C.quest_desc: [
		"现在需要在发电机前放置一个离合器，离合器前放置一个垂直齿轮箱。发电机顶部放置一个安山岩外壳，外壳前放置一个红石，外壳顶部放置一个带2个火把的红石链接。使用“Shift”+“点击”将其设为接收模式。"
		""
		"{image:\tquests:textures/gearbox.png width:180 height:100 align:center}"
	]
	quest.41CEBA836A8BA22C.quest_subtitle: "正在连接"
	quest.41E5E6BF7CB5063F.quest_subtitle: "{ftb\tquests.chapter.mystical_agriculture.quest41E5E6BF7CB5063F.subtitle}"
	quest.41E5E6BF7CB5063F.title: "{ftb\tquests.chapter.mystical_agriculture.quest41E5E6BF7CB5063F.title}"
	quest.41EB0C570FC54F43.quest_desc: [
		"&a化学储罐&r用于储存&7气体&r。"
		""
		"它们可以作为方块放置，并能与&dPressurized Tubes&r互动。"
		""
		"共有四个等级，每个等级的容量和产出率都是前一个等级的两倍。"
	]
	quest.4204702AA6FBF40B.quest_desc: [
		"Chargepad 是一个无线充电站。只要站在上面，背包里的任何可充电物品都会被充电。"
		""
		"Chargepad可以为任何需要任何形式的&e能量&f的物品充能。它同时也是你的Robit的部署和传送点。"
	]
	quest.4204702AA6FBF40B.quest_subtitle: "充电站"
	quest.420D7ABA06B2A643.quest_desc: ["在&dIron's Spellbooks&f中，除了几种新&d法术&f，我们还能获得与法术搭配的超棒新盔甲。"]
	quest.420D7ABA06B2A643.quest_subtitle: "&d法术&f！"
	quest.4236B9F071BE18F3.quest_desc: [
		"旋转冷凝器（发音为“con-DEN-sen-traitor”）用于以1:1的比例将物质在液体和气态之间相互转换。它有两种模式：脱冷凝，将液体转化为气体；冷凝，将气体转化为液体。"
		""
		"在 Decondensentrating 模式下："
		""
		"&3液体&f→气体"
		"&3水&f→水蒸气"
		"液态硫酸→硫酸"
		"液态&3氯化氢&f→氯化氢"
		"液态&3氧气&f→氧气"
		"液态氢→氢气"
		"液态乙烯→乙烯"
		"液态氯→氯气"
		"液态二氧化硫→二氧化硫"
		"液态三氧化硫→三氧化硫"
		"&3盐水&f→气态盐水"
		"液态锂→锂"
		"而在 Condensentrating 模式中则正好相反。"
		""
		"将机械管道设置为“抽取”来提取液体（使用配置器并 Shift+右键点击管道外缘）。"
	]
	quest.4266BF7FCE3B4330.quest_desc: [
		"齿轮是 &6Create&f 中用于传递旋转的基本&9机械&f组件。"
		"大型齿轮是齿轮的一种较大变体，可以在拐角处传递旋转并为旋转速度控制器提供动力。"
	]
	quest.4266BF7FCE3B4330.title: "齿轮组件"
	quest.4276B941670CE0E2.quest_desc: [
		"P2P隧道是一种在网络上移动物品、流体、&c红石&f信号、能量、光线和信道的途径，而无需它们与网络直接交互。P2P隧道有多种变体，但每种都只运输特定类型的东西。它们本质上就像&5传送门&f，直接连接远程的两个方块面。它们不是双向的，有明确的输入和输出。"
		""
		"{@pagebreak}"
		""
		"P2P隧道有许多类型。只有ME P2P隧道可以直接制作，其他类型则需要用特定物品右键点击其他P2P隧道来制作："
		""
		"ME P2P 隧道可通过右键任意电缆来选择。"
		"使用多种红石组件右键即可选择红石P2P隧道。"
		"物品 P2P 隧道可通过右键点击箱子或漏斗来选择。"
		"&3Fluid&f P2P tunnels are selected by right-clicking with a bucket or bottle."
		"&e能量&f P2P 隧道可通过右键点击几乎任何含能量的物品来选择。"
		"使用火把或萤石右键即可选择光P2P隧道"
		"某些隧道类型有其特性。例如，ME P2P隧道的通道无法穿过其他ME P2P隧道，而Energy P2P隧道则会通过增加自身能耗，间接对其通过的FE征收2.5%的税。"
		""
		"{@pagebreak}"
		""
		"P2P隧道的最常见用途是使用ME P2P隧道来压缩频道传输的密度。一根高密度电缆即可替代成捆的电缆，用于传输多个频道。"
	]
	quest.4291A72FF87220D5.quest_desc: [
		"还有反向切换总线，当输入&c红石&r信号时，会&n禁用&r连接。"
		""
		"当&c红石&r信号输入时，该部分会&n启用&r连接；而&6ME反向切换总线&r则通过&n禁用&r连接来实现&n相反&r的行为。"
	]
	quest.42BF5EE98DE53564.quest_subtitle: "+++ &dAugment&f"
	quest.43E504E88FCD08CF.quest_desc: [
		"是的！我们的整合包里仍然有原版&c刀剑&f……"
		""
		"如今这已经是个意外了，相信我……"
	]
	quest.43E504E88FCD08CF.quest_subtitle: "原版内容"
	quest.43FFDFDD7958443C.quest_desc: ["前往&bAether&f，我们就能打造出这把近乎不可思议的&c剑&f！"]
	quest.43FFDFDD7958443C.quest_subtitle: "&b以太世界&f"
	quest.4434D7B66521D69A.quest_desc: ["Pressurized Tubes 用于运输 &3气体&f。"]
	quest.449C60985F16226E.quest_desc: [
		"{ftb\tquests.chapter.mystical_agriculture.quest449C60985F16226E.description1}"
		""
		"{ftb\tquests.chapter.mystical_agriculture.quest449C60985F16226E.description2}"
		""
		"{ftb\tquests.chapter.mystical_agriculture.quest449C60985F16226E.description3}"
		""
		"{ftb\tquests.chapter.mystical_agriculture.quest449C60985F16226E.description4}"
	]
	quest.449C60985F16226E.title: "{ftb\tquests.chapter.mystical_agriculture.quest449C60985F16226E.title}"
	quest.44BA8AF70B6911C2.quest_desc: ["储存多余的&e能量&f！不浪费。"]
	quest.44BA8AF70B6911C2.quest_subtitle: "储存 &e能量&f"
	quest.44DD55460BE2E576.quest_desc: ["在&bAether&f里，我们可以收集一小片云朵，像悟空一样骑着它飞行。"]
	quest.44DD55460BE2E576.quest_subtitle: "孙悟空"
	quest.4512B97451C2221F.quest_desc: ["The &9Mechanical&f Arm can take or deposit items from various blocks within a 5 block radius of where it is placed. A placed Mechanical Arm's selected blocks can be viewed by hovering over it with a &aWrench&f. The Mechanical Arm is capable of transferring up to a stack of items at once."]
	quest.458276C0CAE3F85A.quest_desc: ["我们的装备可以有&a更棒&f的版本了！"]
	quest.458276C0CAE3F85A.quest_subtitle: "原版+"
	quest.458276C0CAE3F85A.title: "超级&b钻石&f盔甲"
	quest.458826F7BC0D3554.quest_desc: [
		"{ftb\tquests.chapter.mystical_agriculture.quest458826F7BC0D3554.description1}"
		""
		"{ftb\tquests.chapter.mystical_agriculture.quest458826F7BC0D3554.description2}"
	]
	quest.458826F7BC0D3554.title: "{ftb\tquests.chapter.mystical_agriculture.quest458826F7BC0D3554.title}"
	quest.45BA5B8A785E1B82.quest_desc: [
		"使用&a扳手&f点击组件，可以围绕你交互的面来旋转该组件。"
		""
		"使用扳手点击组件、&c红石&f组件、轨道或原版轨道变体，即可将其拆除并放入背包。任何可通过右键旋转或交互的方块，都必须在潜行状态下拆除。"
		""
		"将鼠标悬停在某些可配置组件上，即可通过滚动进行配置。"
		""
		"对于某些组件，如线性底盘，按住 ctrl 可同时配置所有已连接的组件。"
	]
	quest.45D99E459A6A38F3.quest_desc: ["我们需要给我们的载具上色；没有人值得拥有一模一样的颜色。我们可以用任何染料来给方块染色！"]
	quest.45D99E459A6A38F3.quest_subtitle: "绘画作品"
	quest.46004D01A142777E.quest_desc: ["智能&3流体&f管道可用于只允许特定的&3液体&f通过。"]
	quest.464B95EE9D942B03.quest_desc: [
		"最好把周围清理一下……这些&5末影人&f真烦人，要不戴个南瓜头？"
		""
		"{entity:minecraft:enderman ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:FORCE_OFF idle:FORCE_OFF walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.464B95EE9D942B03.quest_subtitle: "正在清理区域"
	quest.464B95EE9D942B03.title: "&5末影人&f"
	quest.468232EFC7379EC6.quest_desc: ["我们可以制作这把 &1Stellaris&f &c剑&f，在行星间旅行（这把剑和旅行没什么关系）。"]
	quest.468232EFC7379EC6.quest_subtitle: "穿越世界之旅！"
	quest.468BCDDF89C03143.quest_subtitle: "有了炽热的&7锭&f，我们就可以制作新工具了"
	quest.468BCDDF89C03143.title: "火焰工具"
	quest.46A1A6F4D6C5E62E.quest_desc: ["&dMystical&f &7armor&f 的入门套装可能不是最好的，但最终套装绝对是顶级的！"]
	quest.46A1A6F4D6C5E62E.quest_subtitle: "很棒的装备！"
	quest.46A1A6F4D6C5E62E.title: "审慎&7盔甲&f"
	quest.46BC3623B86D64AF.quest_subtitle: "掉落"
	quest.46EBE6B0E06D750D.quest_desc: ["与 &6Spatial IO Port&r 配合使用，以存储空间区域。"]
	quest.470B1F84D01E4F7A.quest_desc: ["将 Certus Quartz Crystal 放入充电器并为其供电，即可制作出 Charged Certus Quartz。"]
	quest.470B1F84D01E4F7A.quest_subtitle: "带电石英"
	quest.47106CE1937C4340.quest_desc: ["要获得HDPE片，请在富集室中放置3个HDPE颗粒。"]
	quest.47975B3E8E3D3AD1.quest_desc: [
		"利维坦是沉没都市中强大的水生&4boss&f。"
		""
		"{entity:cataclysm:the_leviathan ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:FORCE_OFF idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.47975B3E8E3D3AD1.quest_subtitle: "水生&4首领&f"
	quest.47CF6535737D2172.quest_desc: [
		"这个&2精华&f非常强大。要使用它，请确保："
		""
		"1 - 现在是白天"
		"2 - 它在你的非主手物品栏中"
		"3 - 你暴露在&6阳光&f下"
		""
		"它能提供饱食度、再生、&a速度&f、效率和抗性。"
	]
	quest.47CF6535737D2172.quest_subtitle: "&2光明&f的精髓"
	quest.484BEC8FEEC0F4DA.quest_desc: [
		"走路要小心。在深暗之地的深处，我们可能会踩到被感染的&1潜声方块&f，然后..."
		""
		"它们算作&4迷你首领&f，而且特别喜欢咬人！"
	]
	quest.484BEC8FEEC0F4DA.quest_subtitle: "一条巨大的蠕虫"
	quest.488DBE69595F38F8.quest_desc: ["充能熔炉是一种基础的电动&6熔炉&f，使用&e能量&f而非燃料来熔炼物品。"]
	quest.48BA2E46C8B40EEE.quest_subtitle: "用于制作不常见卷轴的配方"
	quest.48CDFAEEE0408019.quest_subtitle: "&6创造&f一个精粹"
	quest.491FDCFB1431A038.quest_desc: ["如果要将一个远离我们&9系统&f的箱子连接起来，我们可以将这个物品栏电缆连接器连接到箱子上，然后用电缆连接到我们的物品栏连接器上。"]
	quest.491FDCFB1431A038.quest_subtitle: "从远方建立连接中"
	quest.49418B7D8CEDB15E.quest_desc: [
		"好吧，我真的有必要解释这个吗？行吧，随你便……"
		""
		"你可以重命名物品..."
	]
	quest.49418B7D8CEDB15E.quest_subtitle: "重命名中"
	quest.49532B5E8B2D13CE.quest_desc: ["在 Occultism 中，我们可以用粉笔在地板上“绘制”咒语，并搭配蜡烛。不同类型的咒语需要使用不同类型的蜡烛和粉笔。"]
	quest.49532B5E8B2D13CE.quest_subtitle: "&d魔法&f基金会"
	quest.4970CC2851818A02.quest_subtitle: "{ftb\tquests.chapter.mystical_agriculture.quest4970CC2851818A02.subtitle}"
	quest.4970CC2851818A02.title: "{ftb\tquests.chapter.mystical_agriculture.quest4970CC2851818A02.title}"
	quest.49BA104F2E73D3D0.title: "{ftb\tquests.chapter.mystical_agriculture.quest49BA104F2E73D3D0.title}"
	quest.49BC643884373A65.quest_desc: [
		"Croptopia 是一款超棒的模组，能让我们制作各种食物，并在屋外拥有一个巨大的&2农场&f！"
		""
		"我们可以用各种方式&2种植&f和准备美味的食物；每种餐具都有其独特的用途！"
	]
	quest.49BC643884373A65.quest_subtitle: "新奇的可口&2食物&f"
	quest.49BC643884373A65.title: "Croptopia"
	quest.49CADAEDDB724373.quest_subtitle: "自动&9进食&f"
	quest.49E36D3C3092346E.quest_desc: [
		"IO Port 可以让你快速地将存储单元中的数据填充到或从 &9网络&f 存储中取出。"
		""
		"可以用 Certus Quartz &a扳手&f 来旋转它。"
		""
		"IO Port 可设置为在单元格为空、已满或工作完成时将单元格移至输出槽。"
		"插入&c红石&f卡后，将出现各种红石条件的选项。"
		"在GUI的中央，有一个箭头用于设置物品传输方向，即从单元格到网络存储，或从存储到单元格。"
		"&a升级&f"
		"IO 端口支持以下升级："
		""
		"加速卡可增加每次操作移动的物品数量"
		"Redstone Card 添加了红石控制，支持高信号、低信号或脉冲单次触发"
	]
	quest.49F3C168C8946C08.quest_subtitle: "第5级"
	quest.4A0BA9574A2FF755.quest_desc: [
		"这件令人惊叹又美丽的&7盔甲&f，只有在找到并击败隐藏在&6沙漠&f中的怪物后才能制作！"
		""
		""
		"{entity:cataclysm:kobolediator ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:USE_GLOBAL width:100 height:100 align:center}"
	]
	quest.4A0BA9574A2FF755.quest_subtitle: "祖先的遗产"
	quest.4A0BA9574A2FF755.title: "骨骼爬行动物&7盔甲&f"
	quest.4A0BC148F29ADA79.quest_desc: [
		"几乎所有事情都需要奥术之火来推进！把水果扔在地上，用燧石和&3钢&f点燃它，就能&6创造&f奥术之火！"
		""
		"要使其无限且不熄灭，请将其放置在橡木、下界岩或煤炭块上。"
	]
	quest.4A0BC148F29ADA79.quest_subtitle: "神秘学 &6火焰&f！"
	quest.4A21ACC5F89557D7.quest_subtitle: "第10级"
	quest.4A47E558AD90EB64.quest_desc: ["提供一个可同时访问两个背包的界面。还配有过滤槽，可快速整理收到的物品。"]
	quest.4A7F96E62A5845C5.quest_desc: [
		"&9Mechanical&f Pistons 是一种会与不可移动方块碰撞的装置。"
		""
		"要伸出，活塞必须在&5末端&f有活塞延伸杆，以及旋转&e动力&f。最大延伸杆长度为64格，可在配置文件中更改。"
		""
		"当旋转方向相反时，活塞会缩回。末端必须用史莱姆球制成粘性活塞，才能将推出的方块带回来。"
	]
	quest.4AF08181C6BED2FD.quest_desc: ["我们肯定需要好装备；这个先用着，但你需要&a研究&f&9Mekanism&f。"]
	quest.4AF08181C6BED2FD.quest_subtitle: "&aBetter&f 装备"
	quest.4AF08181C6BED2FD.title: "精炼黑曜石&7盔甲&f"
	quest.4AFF81D3D0E78255.quest_desc: ["化学洗涤器使用水将矿浆转化为清洁矿浆。清洁矿浆需进一步通过泵入化学结晶器进行提纯。注意，与大多数Mekanism机器不同，本机器矿物流动的“入口”和“出口”是固定的。首次放置时，“入口”在左侧，“出口”在右侧。当然，它可以通过配置器进行旋转。水通过机器顶部输入。"]
	quest.4B574B802F83F725.quest_desc: ["我们需要为汽车产生扭矩；可以使用一个由&8煤炭&f驱动的扭矩发电机，把它放在汽车的后部。"]
	quest.4B574B802F83F725.quest_subtitle: "正在生成扭矩"
	quest.4B5CEA6D90440B24.quest_desc: [
		"&e朋友&f，这个地方真不可思议！"
		""
		"跟我来，我会向你展示隐藏在简易&5传送门&f背后的奇迹……"
	]
	quest.4B5CEA6D90440B24.quest_subtitle: "一个奇怪的&5维度&f……"
	quest.4B5CEA6D90440B24.title: "地下花园 &2Undergarden&f"
	quest.4B6F1EC56FA5B9F7.quest_subtitle: "我们的冰系&d魔法&f"
	quest.4B976C143EDA4317.quest_desc: [
		"外壳是 &6Create&f 中许多合成配方、装饰和美化用途所使用的方块。"
		""
		"外壳有四种类型：安山岩外壳主要用于基础机械装置。"
		""
		"{@pagebreak}"
		"外壳只能通过将有效的合金或&7锭&f物理地应用到任何去皮的原木或木头上才能制作。原木会自行转换为外壳。"
		""
		"&9Mechanical&f Belts, Shafts, and Cogwheels can be encased in most casings, creating a decoration around the encased block. Copper casings, however, can be used only on &3Fluid&f Pipes. Likewise, a fluid pipe will not accept any other kind of casing."
	]
	quest.4B976C143EDA4317.title: "安山岩外壳"
	quest.4BB13C80196FD034.quest_desc: [
		"&6Create&f 模组为 Minecraft 带来了真正的工程学！"
		"你不再使用简单的&9机器&f，而是利用由&3水&f轮、风车和其他装置产生的旋转动力。"
		""
		"有了Create，你可以自动化农场、建造工厂，甚至可以设计出运行流畅、外观精美的移动机械。"
	]
	quest.4BB13C80196FD034.quest_subtitle: "&6创建&f"
	quest.4BB13C80196FD034.title: "&6创建&f"
	quest.4BDB64F6522FBB78.title: "&6Cloggrum&f 盔甲"
	quest.4BDE773C3359D584.quest_desc: [
		"Robit 是 &9Mekanism&f 的 &9机械&f伙伴。它可以充当合成台、熔炉、铁砧、箱子，或者只是一个可爱的小伙伴。它免疫火焰伤害，包括火焰喷射器。"
		""
		"{@pagebreak}"
		""
		"要让你的机器人朋友诞生，你必须先制作它。将 Robit 放入背包后，手持它对 Chargepad 右键。这样 Robit 就会生成并被分配到该充能板。哦，别忘了确保 Chargepad 有 &epower&f 供应。否则，它可没法跟着你到处走！"
		""
		"任何时候，只要用配置器右键单击 Robit 即可将其拾起。"
		""
		"不用担心 Robit 会丢失，当电量/生命值耗尽时，它会&9自动&f传回充电板。它没有常规生命值：相反，受到&c伤害&f会消耗电量。一个充满电的 Robit 等效于 100 或 50 颗心。"
		""
		"当充能板被破坏时，Robit会变成一个可拾取物品。它会保留物品，但如果未被拾取，可能会消失。"
	]
	quest.4BDE773C3359D584.quest_subtitle: "小罗比特 (Little Robit)"
	quest.4C1E974C70987717.quest_desc: [
		"在&dArs Nouveau&f中有3本&d魔法书&f！每本书都会解锁特定类型的魔法和使用方法！"
		""
		"按住“C”键查看配方。配方是我们施放法术的方法，例如：投射物、接触..."
		""
		"正下方是效果：效果就是法术本身。每种至少选1个，选好想要的然后点击“创建”。"
	]
	quest.4C1E974C70987717.quest_subtitle: "最初的"
	quest.4C63A2E92319B8A2.quest_desc: [
		"准备好迎接&c冒险&f吧！"
		""
		"在我们这个奇妙世界里，有许多全新的&e建筑&f和新的&4怪物&f，简直疯狂又令人惊叹。 &a做好准备&f！"
	]
	quest.4C63A2E92319B8A2.quest_subtitle: "做好准备，迎接挑战"
	quest.4C71B80784B4F8FB.quest_desc: ["..."]
	quest.4C71B80784B4F8FB.quest_subtitle: "..."
	quest.4C756FFD357F091F.quest_desc: ["我甚至不需要解释，对吧？"]
	quest.4C756FFD357F091F.quest_subtitle: "最棒的……"
	quest.4C7CD3858A2BE870.quest_desc: [
		"&9机械&f压机是一个机械组件，可将压制、填充和压缩配方应用于其下方的物品。它用于将锭压制为薄片，而薄片是更高级组件的&e重要&f材料。"
		""
		"机械压机由内部转轴驱动，可从相对的两面接入。与转轴类似，压机会沿其轴线传递旋转。当接收到更快的旋转动力时，它能更快地处理物品。"
	]
	quest.4C990203ACAAB823.quest_desc: ["现在终于可以控制车轮和汽车移动了；点击每个&c红石&f连接器的顶部，用绑定控制器配置按键来定义加速和车辆转向。"]
	quest.4C990203ACAAB823.quest_subtitle: "是时候掌控一切了"
	quest.4CE350628327599A.quest_desc: [
		"&eME 等级发射器&r可以显示指定物品的等级或&dME 网络&r的能量水平。"
		""
		"你可以设置阈值，如果&e ME Level Emitter&r会发出红石信号或将其关闭。"
		""
		"无需 &e通道&r 即可运行，若失去电源，发射器将转为关闭状态。"
		""
		"当安装一张合成卡时，这些装置可以接入&b合成系统&r，允许你在物品合成期间输出红石，甚至可以配置系统输出红石来执行合成任务。需要注意的是，你不能将&c红石&r与&b接口模式&r混合使用。"
	]
	quest.4CEBCC5C6F5E5D37.quest_desc: ["在Minecraft里创造&5传送门&f去另一个&5维度&f，简直太疯狂了... Notch创造这个的时候一定疯了！"]
	quest.4CEBCC5C6F5E5D37.quest_subtitle: "是时候旅行了"
	quest.4CEBCC5C6F5E5D37.title: "下界（Nether）&4&f"
	quest.4CFE8B1C53B429E9.quest_desc: ["合成台槽位盖用于表示&9机械&f合成台设置中的空位。"]
	quest.4D3AEF3DB6E7BBC7.quest_desc: ["堆叠&a升级&f可提升已安装设备的单次传输量。"]
	quest.4D41F29E44398EA8.quest_desc: ["这根小小的&d法杖&f相当强力，除了造成伤害外，还会点燃你的&c敌人&f。"]
	quest.4D41F29E44398EA8.quest_subtitle: "&6火&f"
	quest.4D482A1A908ABFDA.quest_desc: [
		"与线性底盘不同，径向底盘会连接到周围一圈的方块，而非一条直线。如果附近有不想连接到装置上的方块，这可能会很麻烦。"
		""
		"手持史莱姆球或强力胶水，右键点击底盘侧面可使其变粘，再次点击可应用于所有侧面。物品不会被消耗。可用&a扳手&f更改每个底盘受影响方块的范围。按住 Ctrl 可滚动查看所有已连接的底盘。"
	]
	quest.4D72CE140352B796.quest_desc: ["快到了……也许我在撒谎，这还不到我们实际要做的事情的1%。"]
	quest.4D72CE140352B796.quest_subtitle: "收集之眼 Gathering Eyes"
	quest.4D72CE140352B796.title: "末地之眼：&5末地之眼&f"
	quest.4D89B47FFF31585D.quest_desc: ["我们可以用链传动来制造汽车的底盘，但如果太大，可能会消耗更多燃料。"]
	quest.4D89B47FFF31585D.quest_subtitle: "汽车车身"
	quest.4D89B47FFF31585D.title: "封闭式链轮传动装置"
	quest.4D8CB12FD2A6A8D9.quest_desc: [
		"&7石生者&f是令人难以置信且极其温顺的怪物，它们是&e中立&f的。"
		""
		"你可以和它们交易，它们会为你对抗敌对生物。"
	]
	quest.4D8CB12FD2A6A8D9.quest_subtitle: "交易内容"
	quest.4D8F11A3F801A303.quest_subtitle: "正在转换中"
	quest.4D966F8C5AD62896.quest_subtitle: "神圣学校&7盔甲&f"
	quest.4D966F8C5AD62896.title: "牧师&7盔甲&f"
	quest.4D999E42010FFB85.quest_desc: ["电池中储存着 1.6r AE，每远离最近的 ME 无线接入点一个方块，就会消耗 1 AE/t。"]
	quest.4DAC24440803FE58.quest_desc: [
		"要让任何设备正常工作，AE2 &9网络&f都需要被加载区块，如果只加载部分网络，它可能无法正常运行。空间锚点解决了这个问题。它会强制加载其网络所占用的区块。一根横跨区块边界的电缆就足以加载该新区块。"
		""
		"它会在量子桥上传播“加载”状态，但不会跨维度传播，所以如果你有通往下界的量子桥，就需要在基地网络和下界网络的网络上放置空间锚点。"
		""
		"默认情况下，它还会在已加载的区块中启用随机更新，这可以在 ae2 配置中关闭。"
	]
	quest.4DB8552EE2DB7C53.quest_desc: ["我们需要这套太空服才能在其他星球上行走！将太空服放入&3氧气&f&9机&f中，为其充满氧气！"]
	quest.4DB8552EE2DB7C53.quest_subtitle: "太空服"
	quest.4DB8552EE2DB7C53.title: "太空&7盔甲&f"
	quest.4DF53B9D43166F7F.quest_desc: ["这把弓是女王掉的，它会锁定你的&c敌人&f，直到命中为止！"]
	quest.4DF53B9D43166F7F.quest_subtitle: "寻路箭矢"
	quest.4E1B3417F498892B.quest_desc: ["&dMystical&f &7armor&f 的入门套装可能不是最好的，但最终套装绝对是顶级的！"]
	quest.4E1B3417F498892B.quest_subtitle: "很棒的装备！"
	quest.4E1B3417F498892B.title: "Inferium &7盔甲&f"
	quest.4E424D3A4D514B73.quest_desc: [
		"Refined Storage 是一款存储模组，允许使用各种设备构建存储&9网络&f。这些设备可以存储、整理和管理你的物品和&3流体&f。"
		""
		"它比AE2更简单。没有频道和物品类型限制。而且，它支持AE2的功能，如存储和自动合成。"
	]
	quest.4E424D3A4D514B73.title: "Refined Storage"
	quest.4E5C6F23628A9982.quest_desc: [
		"Encased Chain Drive 是一种可以传递旋转的方块，与 &9Mechanical&f Belt 类似。"
		""
		"封闭式链传动可垂直或水平并列放置，形成一条在所有方块间传递旋转&e动力&f的链条。方块必须侧边相接（而非轴与侧边），并呈单一直线才能形成链条。封闭式链传动的轴线可以全部平行，也可以将方块旋转使轴线垂直。封闭式链传动也可以通过其旋转轴传递旋转动力，但这并非同一链条的延续。"
	]
	quest.4E6FF002D6C5580E.title: "{ftb\tquests.chapter.mystical_agriculture.quest4E6FF002D6C5580E.title}"
	quest.4EAA3F9C314914BF.quest_desc: [
		"好，太棒了！有了这个模组，前期游戏会变得更&a轻松&f，只需要一个简单的物品栏&9系统&f！一切都要从这个终端开始。"
		""
		"制作这个终端，我们就可以真正开始工作了。它有一个超棒的机制：把它放在任何箱子或物品连接器前，就能打开我们的界面！"
	]
	quest.4EAA3F9C314914BF.quest_subtitle: "预算已应用"
	quest.4EC20D5D0EEC1DF7.quest_desc: [
		""
		"{ \"text\": \"Click Me!\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"3617DE87C4E1BCB9\" } }"
	]
	quest.4EC499B88FBFA01C.quest_desc: ["储存动能应力以备后用。以物品形式保留电荷，实现远程&e能量&f传输。电池容量、放电转速和应力影响值均可配置。"]
	quest.4F1307BB5B01F90F.quest_desc: [
		"ME 箱子就像一个带有 ME 终端、ME 驱动器和 &e能量&f接收器的微型 &9网络&f。虽然它可以用作小型存储网络，但由于只有一个存储单元，其用途有限。"
		""
		"相反，它与内部安装的存储单元交互时会很有用。其集成终端只能看到和访问已安装的驱动器中的物品，而通用网络上的设备可以访问任何网络存储中的物品，包括ME箱子。"
		""
		"它有2种不同的GUI，用于物品运输。与顶部终端交互会打开集成终端。物品可通过此面插入到已安装的存储单元中，但不能取出。与任何其他面交互会打开包含存储单元插槽和优先级设置的GUI。存储单元只能通过带有插槽的面，由物品物流系统进行插入和移除。"
		""
		"可以用 Certus Quartz &a扳手&f 来旋转它。"
		""
		"它有一个小型AE能量存储缓冲器，所以如果没有连接到带能量细胞的网络，一次性插入或提取太多物品可能会导致其断电。"
	]
	quest.4F1C04C0F6769825.quest_desc: [
		"化学注射室使用&3氯化氢&f气体将矿石转化为4个碎片，将原矿转化为8个碎片。"
		""
		"这标志着4倍矿石加工的开端，需要稳定的氯化氢供应，而氯化氢只能通过热蒸发&2植物&f来生产。"
		""
		"这台&9机器&f是扩建你的矿石加工厂的关键一步。将其放置在净化室左侧，即可接入现有设备，继续推进进度。"
	]
	quest.4F436770D30D8520.quest_desc: [
		"我们需要在现有装置上再添加 3 台 &9机器&f。"
		""
		"化学溶解室是5倍矿石处理装置中的第一台机器。它用硫酸将原矿石转化为矿浆。"
		""
		"机器每溶解一种矿石会消耗100mB硫酸，并产出1000mb的浆料。这些浆料需要在化学洗浆机中清洗。"
	]
	quest.4F78122BABAB041C.quest_desc: [
		"&9Mechanical&f Plough 是一种用于破坏不可碰撞方块和抛掷实体的移动行为体。"
		""
		"放置方式"
		"犁只能放置在实心方块的水平面上，但放置后该方块无需继续支撑犁。"
		""
		"破坏方块"
		"连接到机械装置后，机械犁会破坏接触到的非碰撞方块（如雪层）。机械犁还能移动或发射实体，并翻耕土壤方块。"
		""
		"耕地"
		"连接到机械装置后，机械犁可以翻耕下方的任何草方块（改为农田），可用于快速翻耕大型农田。"
		""
		"投掷实体 (Flinging Entities)"
		"当与能使机械犁摆动的装置相连时，任何碰撞实体都将被甩向摆动方向。"
	]
	quest.4F89670D49DD2DE1.quest_desc: [
		"它们通过在电缆上可视化通道使用情况来提供诊断功能，通道表现为沿电缆黑色条纹运行的彩色发光线条，让你了解你的通道在&9网络&f中如何使用。"
		""
		"前四个通道显示为与线缆颜色匹配的线条，后四个显示为白色线条。"
		""
		"这些也可以用和Fluix ME玻璃线缆相同的方式进行染色。"
	]
	quest.4F899BACFCDFF853.quest_desc: [
		"这张桌子是&dArs Nouveau&f魔法的核心：有了它，我们就能组合出新的&d法术&f！"
		""
		"用你的书点击桌子上的新标签页，即可打开包含所有可能法术的新页面。注意每本书都有等级，所以你需要2级书才能学习2级法术。"
		""
		"按住 shift 点击法术查看所需物品，点击选择，然后将物品放在桌子上方。"
	]
	quest.4F899BACFCDFF853.quest_subtitle: "魔法之心 &dMagic&f"
	quest.4FA8D7751246C260.quest_desc: [
		"要进入&eBumblezone&f，我们需要在世界上找到一个野生蜂巢。"
		""
		"向蜂巢投掷一颗&5末影&f珍珠，你就能进去了！"
		""
		"欢迎来到Bumblezone！"
	]
	quest.4FA8D7751246C260.quest_subtitle: "进入&5维度&f中"
	quest.4FAFFC7803894FAF.quest_desc: ["每当我们达到新的&2seed&f等级，就能在&dMystical&f中获得新工具，变得越来越强！"]
	quest.4FAFFC7803894FAF.quest_subtitle: "新工具"
	quest.4FAFFC7803894FAF.title: "Tertium 工具"
	quest.4FB001CE1BACBFA0.quest_desc: ["宇航员，报告显示这颗行星有新的放射性燃料源，小心！"]
	quest.4FB001CE1BACBFA0.quest_subtitle: "一个新世界"
	quest.4FB001CE1BACBFA0.title: "水星"
	quest.4FB32E41F9FEE89B.quest_desc: ["有助于推动小型飞机，通过推或吸空气来引导其前进或后退"]
	quest.4FB32E41F9FEE89B.quest_subtitle: "推进器"
	quest.4FB73108EB1716FD.quest_desc: [
		"小心&e蜜蜂&f！难以置信的是，蜜蜂非常聪明，而且它们的&7盔甲&f异常坚固！"
		""
		""
		""
		"{entity:the_bumblezone:beehemoth ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:USE_GLOBAL width:50 height:50 align:center}"
	]
	quest.4FB73108EB1716FD.quest_subtitle: "嗡嗡嗡 嗡嗡嗡嗡"
	quest.4FBB6905FB99C141.quest_desc: ["这个方块就像反应堆一样，能让我们&6建造&f一座24格高的塔来加快&a生长&f速度。"]
	quest.4FBB6905FB99C141.quest_subtitle: "正在加速！"
	quest.5004AE3D175A02A6.title: "{ftb\tquests.chapter.mystical_agriculture.quest5004AE3D175A02A6.title}"
	quest.5047792C6EF6D2AD.quest_desc: ["在高压反应室中用 2 x 生物燃料、&3水&f和&3氢气&f（副产品还包括乙烯）制成。"]
	quest.505A11108180FA05.quest_desc: [
		"Maledictus 是冰冻监狱中出现的亡灵&4首领&f。"
		""
		""
		"{entity:cataclysm:maledictus ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:FORCE_OFF idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.505A11108180FA05.quest_subtitle: "不死生物"
	quest.50740818E16C1329.quest_subtitle: "用于储存&b法力&f"
	quest.508BFAAF99BEFEA7.quest_desc: ["你的工具上还需要一个 &esocket&f 吗？使用这个 &dsigil&f。"]
	quest.508BFAAF99BEFEA7.quest_subtitle: "+ 1 &eSocket&f"
	quest.50BAB1914E5B902C.quest_desc: [
		"&5Epic&f 也是一个非常棒的选择。虽然不是最好的，但它的装备已经处于另一个层次了！"
		""
		"它出现在 Frontier &e世界层级&f中，在 Pinnacle 层级更为常见。"
	]
	quest.50BAB1914E5B902C.quest_subtitle: "史诗级&5&f"
	quest.50CE0BD7B0BC4017.quest_desc: ["&3流体&f阀门可以通过向侧面提供旋转力来切换开闭状态。这通常使用阀门手柄或齿轮换挡器完成。阀门侧面的一组方向箭头也会旋转，以指示阀门是开启还是关闭。"]
	quest.50D1DECDF16F1FCA.quest_subtitle: "将远处的物品捡起放入背包中"
	quest.50D3BBCA2BFFC292.quest_subtitle: "制作饮品！"
	quest.50EBD1AA34ADE391.quest_desc: ["我们的科学家仍在研究金星，请前往那里收集方块和矿石。"]
	quest.50EBD1AA34ADE391.quest_subtitle: "一颗巨大的星球"
	quest.50EBD1AA34ADE391.title: "金星"
	quest.50ED11C98A859486.quest_desc: ["想去太空和新的星球旅行吗？那么，首先你需要一个发射台！"]
	quest.50ED11C98A859486.quest_subtitle: "制造火箭"
	quest.511DD8761FFFD191.quest_desc: [
		"{ftb\tquests.chapter.mystical_agriculture.quest511DD8761FFFD191.description1}"
		""
		"{ftb\tquests.chapter.mystical_agriculture.quest511DD8761FFFD191.description2}"
	]
	quest.511DD8761FFFD191.title: "{ftb\tquests.chapter.mystical_agriculture.quest511DD8761FFFD191.title}"
	quest.5172745FE6AB853F.quest_desc: ["这张桌子是本模组的基础。手持魔典，点击它即可打开&d法术&f菜单，用于放置我们的法术卷轴！"]
	quest.5172745FE6AB853F.quest_subtitle: "我们的桌子"
	quest.51B0E0A54C84A69B.quest_desc: [
		"驱动单元存储存储磁盘和&3液体&f存储磁盘。"
		""
		"添加存储盘可扩展 &9网络&f 的存储容量。总可用存储取决于内部磁盘数量和等级。移除磁盘后，其存储内容在重新插入前将暂时无法访问。"
	]
	quest.51B0E0A54C84A69B.quest_subtitle: "储物空间"
	quest.51CC88481A1FCCC1.quest_desc: ["我们理解你渴望抵达&5The End&f的心情……我当初也是如此，但或许先&a学习&f一下，变强一点会更好……"]
	quest.51CC88481A1FCCC1.quest_subtitle: "轻松一点，慢慢来"
	quest.51CCB7ACFD7B45F1.quest_subtitle: "合成配方所需材料"
	quest.51D755615A9AFE7A.quest_subtitle: "第三阶段"
	quest.51E22AFE9403C9E1.quest_desc: ["首先，我们需要一个物理组装器；有了它，我们就能给汽车添加物理效果，这将会非常&e重要&f！"]
	quest.51E22AFE9403C9E1.quest_subtitle: "制造我们的第一辆汽车"
	quest.521700DC2EED8C3D.quest_subtitle: "自然学校 &7盔甲&f"
	quest.521700DC2EED8C3D.title: "被瘟疫侵染的&7盔甲&f"
	quest.524B1ABB89B1D43A.quest_desc: ["我们需要用目标选择器将另一个&e能量&f传输与另一个连接起来。"]
	quest.524B1ABB89B1D43A.quest_subtitle: "链接中"
	quest.525F25F4ADE45B50.quest_desc: [
		"ME Formation Plane 与 Storage Bus 类似，但它将世界本身作为存储介质。换句话说，它会将过滤器中的任何方块直接放置在自己前方。"
		""
		"当某个方块只需放置并用特定工具破坏即可被处理时，此方法会很有用。"
	]
	quest.52CF08C3E3BBD68E.quest_desc: [
		"在 Iron's &dSpells&f 和 &dSpellbooks&f 中，有 8 个魔法学派外加 1 个特殊学派。学派会影响卷轴和护甲。"
		""
		"制作卷轴配方的基础是这个锻造台，我们在这里制作墨水。"
	]
	quest.52CF08C3E3BBD68E.quest_subtitle: "&d魔法&f学校"
	quest.531E3FF1F2865C67.quest_desc: ["与通用电缆类似，热力学导体是&9Mekanism&f以热量形式传输&e能量&f的方式（本质上是一种热管）。"]
	quest.532EE736F9945ADC.quest_desc: [
		"整个模组的基石是魔导书：用它们我们可以施放和&d学习&f我们的&a法术&f。"
		""
		"每本新书都能让我们学会更多法术或获得不同属性！"
	]
	quest.532EE736F9945ADC.quest_subtitle: "我们的第一本魔导书"
	quest.53965EEC83265F1E.quest_desc: ["我们可以使用各种模组核心来&a改进&f &e能量&f传输。"]
	quest.53965EEC83265F1E.quest_subtitle: "核心"
	quest.539E38C4CE86BCF6.quest_desc: ["我们需要这把刀来屠宰动物。"]
	quest.539E38C4CE86BCF6.quest_subtitle: "屠杀一切！"
	quest.53C0234C053BF0CF.quest_desc: [
		"放置一个 Stock Link 以开始一个新的 Logistics &9Network&f。在放置前右键已放置的 Stock Link 以共享其网络。将链接放置在 Packager 上，以将其连接的物品栏连接到网络。"
		""
		"Stock Links 没有范围限制，但它们所在的区块必须被加载，网络才能看到它们。"
		""
		"Stock Links 可以通过物流网络接收和发送任\t务。"
	]
	quest.53D6E9AE59FC6F79.quest_desc: [
		"最怀旧最棒的模组之一！&2Twilight Forest&f触动人心，包含各种&4boss&f和装备。"
		""
		"前往新维度，挑战首领，还有更多内容！"
	]
	quest.53D6E9AE59FC6F79.quest_subtitle: "经典版"
	quest.53D6E9AE59FC6F79.title: "暮色森林&2&f"
	quest.54589F10802DFE16.quest_desc: ["除非有动力，否则无法解开的离合器。"]
	quest.546396936E06E68A.quest_desc: ["储存了多年的宝藏，终于可以&6搜刮&f一空了！用这把钥匙打开女王的秘密宝箱。"]
	quest.546396936E06E68A.quest_subtitle: "女王之钥"
	quest.54778BD66812A1CF.quest_desc: ["用于在储罐、机器和引擎之间输送&3流体&f的运输组件。专为高效运行并与&6Create&f的机械系统集成而设计，可确保自动化装置中流体的顺畅传输。"]
	quest.54DD837BDF6B31C3.quest_desc: ["我们可以用这台&9机器&f来离心一些物品。"]
	quest.54DD837BDF6B31C3.quest_subtitle: "离心分离中"
	quest.5549AAA9DBE0CD78.quest_desc: [
		"碗是&d魔法&f的基础，你总要将它们放在&5仪式&f附近，向恶魔献上物品。"
		""
		"&6黄金碗&f放在仪式中央，通常需要一本仪式&e束缚之书&f。"
	]
	quest.5549AAA9DBE0CD78.quest_subtitle: "献祭的祭坛基础部分"
	quest.554EF19AB0F6F0C7.quest_desc: ["我们可以&6创造&f新的泥土类型来加快种子的&a生长&f过程。"]
	quest.554EF19AB0F6F0C7.quest_subtitle: "一个&a改良&f泥土方块"
	quest.556D9C78EFAB5091.quest_desc: [
		"ME终端是一个HUD，能让你访问ME &9网络&f中存储的物品。这还包括可通过ME存储总线访问的物品。"
		""
		"它可以通过 View Cell 进行排序、搜索和筛选。运行时需要一个 Channel。"
	]
	quest.55749230931993F2.quest_desc: [
		"主要由 Certus Quartz &7Dust&f 制成的透明玻璃。"
		""
		"可用于制作活力石英玻璃和其他物品。"
	]
	quest.5585B4CFBD0D287E.quest_subtitle: "小鲨鱼宝宝"
	quest.5585B4CFBD0D287E.title: "锯齿状&7盔甲&f"
	quest.558909E4668CBA76.quest_subtitle: "我们的火焰&d魔法&f"
	quest.5594489BF12A15FA.quest_desc: ["你好！即使我们已经安装了所有模组，也得从头开始！收集一些木头，制作初始工具。"]
	quest.5594489BF12A15FA.quest_subtitle: "第一工具"
	quest.5594489BF12A15FA.title: "木制工具"
	quest.55A7167C123DCC51.quest_subtitle: "擦掉地板上的那些画稿吧"
	quest.55A8D6E8206CE8EA.quest_desc: ["这套新装备能储存柴油和&3氧气&f！而且强度也高得多。"]
	quest.55A8D6E8206CE8EA.quest_subtitle: "一套&a更好的&f盔甲"
	quest.55A8D6E8206CE8EA.title: "喷气背包 &7盔甲&f"
	quest.55C1EB0809EDA131.quest_desc: ["{ftb\tquests.chapter.mystical_agriculture.quest55C1EB0809EDA131.description1}"]
	quest.55C1EB0809EDA131.title: "{ftb\tquests.chapter.mystical_agriculture.quest55C1EB0809EDA131.title}"
	quest.566D6390193DD77D.quest_desc: [
		"黄铜隧道可用于&9机械&f传送带的四种功能：1) 纯装饰，2) 将物品流分送至多个目的地，3) 分拣物品流，以及 4) 合并多个物品流。每个隧道都可以有一个输入或输出&5端口&f。是输入还是输出，完全取决于传送带接触该侧面的方向。"
		""
		"相邻放置的隧道通常会被视为一个整体，从所有输入收集并分发到所有输出。物品的分发方式由隧道的价值设置控制。来自不同输入的堆叠物品在分发前不会合并。"
	]
	quest.56773A0759841B87.quest_desc: [
		"你好！我知道你来到这里，是因为你想成为一名真正的巫师……"
		""
		"那你就来对地方了！尝试新的&d法术&f，成为一名真正强大的巫师。"
		""
		"这就是&7Iron&f的魔法和&d魔法书&f！"
	]
	quest.56773A0759841B87.quest_subtitle: "成为一名真正的巫师"
	quest.56773A0759841B87.title: "铁质&d魔法书&f"
	quest.57E30971FCEF6709.quest_desc: [
		"原子分解器是&9Mekanism&f的多功能工具，堪称电子版的终极万能工具。"
		""
		"原子分解器所取代的工具："
		""
		"Pickaxe"
		"斧头"
		"铲子"
		""
		"原子分解器不会替换的显著工具："
		""
		"Shears"
		"锯子"
		"剑 - 尽管原子分解器平均能造成20点生命值的伤害，但它无法挥舞&c攻击&f。"
		""
		"{@pagebreak}"
		""
		"原子分解器有五种不同设置，可通过 Shift + 右键或使用物品模式切换键位进行循环："
		""
		"普通 (202)"
		"默认设置"
		"所有工具都如同拥有效率 II 的 &b钻石&f 版本一样。"
		"缓慢 (82)"
		"就像每种工具都有钻石版一样好用。"
		"快速 (1282)"
		"就像所有工具的钻石版，带有效率V的效果。"
		"关闭 (02)"
		"除了生物之外，不会对周围的世界产生影响。"
		"如果你打算把它当主武器...又不想把自己挖成&4死亡&f陷阱，最好开着这个设置。"
	]
	quest.57E30971FCEF6709.quest_subtitle: "领主"
	quest.580771DAE53B8F15.quest_desc: ["用僵尸肉进行修复。"]
	quest.580771DAE53B8F15.quest_subtitle: "召唤僵尸"
	quest.5853A6A7DC4BF393.title: "{ftb\tquests.chapter.mystical_agriculture.quest5853A6A7DC4BF393.title}"
	quest.585521EA3ED4827A.quest_desc: ["在这个新世界里，有些怪物爱上了&2regalium&f，所以我们可以用它作为交易货币。"]
	quest.585521EA3ED4827A.quest_subtitle: "新的&2祖母绿&f"
	quest.586C269FAAC6D0AB.quest_desc: [
		"{ftb\tquests.chapter.mystical_agriculture.quest586C269FAAC6D0AB.description1}"
		""
		"{ftb\tquests.chapter.mystical_agriculture.quest586C269FAAC6D0AB.description2}"
	]
	quest.586C269FAAC6D0AB.title: "{ftb\tquests.chapter.mystical_agriculture.quest586C269FAAC6D0AB.title}"
	quest.58B125BD4876054C.quest_desc: [
		"该模组为原本以生存为主的游戏引入了许多中高级别的机械、发电装置和工具，&6创造&f了全新的&9科技&f元素。"
		""
		"该模组专注于将材料分解为其化学成分，从而充分利用你遇到的每一种材料。"
		""
		"此模组包含 &3氢&f动力喷气背包、迷你机器人伙伴、用于自动化采矿的数字矿工、反应堆等等。"
	]
	quest.58B125BD4876054C.quest_subtitle: "The &9Mekanism&f"
	quest.58B125BD4876054C.title: "欢迎"
	quest.58B9E5BD5C826184.quest_desc: ["&dMystical&f &7armor&f 的入门套装可能不是最好的，但最终套装绝对是顶级的！"]
	quest.58B9E5BD5C826184.quest_subtitle: "很棒的装备！"
	quest.58B9E5BD5C826184.title: "帝国&7盔甲&f"
	quest.58D9ED769A7F1C03.quest_desc: ["在我们的整合包里，可以进入心爱的&5暮色森林&f，击败&2Naga&f，从而打造出这套令人怀念的超棒盔甲！"]
	quest.58D9ED769A7F1C03.quest_subtitle: "&2Naga&f"
	quest.58D9ED769A7F1C03.title: "Steeleaf &7盔甲&f"
	quest.590746BA503CC770.quest_subtitle: "通过电缆传输 &e电力&f"
	quest.599607DF0F2F8961.quest_subtitle: "通过电缆传输&3流体&f"
	quest.5A2450162FD24F7E.quest_desc: [
		"两个粉碎轮必须水平或垂直相邻放置，间隔一个方块。两个轮子必须施加相反的旋转力。任何要粉碎的物品都必须放入轮子向内旋转的位置。"
		""
		"将漏斗放置在车轮顶部，正对着下方的料仓或传送带，即可实现压轮自动化。"
	]
	quest.5A2450162FD24F7E.quest_subtitle: "Crushing Wheels 会将 Crushing 配方应用于从旋转方向的反向插入的任何物品。"
	quest.5A2450162FD24F7E.title: "压碎车轮"
	quest.5A5A30CD4D0C98CB.quest_desc: ["Fluix Crystal 是在水中将 Charged Certus Quartz Crystal、&4Nether&f Quartz 和 &cRedstone&f Dust 混合制成的。"]
	quest.5A5A30CD4D0C98CB.quest_subtitle: "在世界中"
	quest.5A86869FCFA9C56B.quest_subtitle: "背包里有一个合成台 (Crafting Table)"
	quest.5AB93477ADBE26F1.quest_desc: [
		"这个水晶对推进进度非常&e重要&f：有了它，我们就能制作出能极大帮助我们的指南针！"
		""
		"为此，请在世界各地的蜂蜜湖中寻找水晶并将其打破。"
	]
	quest.5AB93477ADBE26F1.quest_subtitle: "一个蜂蜜区块"
	quest.5AFD4912CC8FBBB8.quest_subtitle: "合成配方所需材料"
	quest.5B681BC43371CC5C.quest_desc: [
		"物流运输管是Mekanism物流系统的基础物品运输管道。使用配置器，玩家可以通过⇧ Shift + 右键运输管中心，用配置器“上色”管道，颜色可被管道的颜色分拣器识别。"
		""
		"它还有另外两个表亲，分别是 Diversion Transporter 和 Restrictive Transporter。"
	]
	quest.5B8090AE76C3EC15.title: "{ftb\tquests.chapter.mystical_agriculture.quest5B8090AE76C3EC15.title}"
	quest.5B99D64F54C94267.quest_desc: ["在下方连接动力推进器，它将通过提取电缆每秒传输最多20个物品栏和1000个桶。"]
	quest.5B99D64F54C94267.quest_subtitle: "升级电缆"
	quest.5BACEC2A4C91A001.quest_subtitle: "第5级"
	quest.5BB1EBD2782C376A.quest_desc: ["使用此多方块结构无线传输&e能量&f。使用核心来&a升级&f多方块。"]
	quest.5BB1EBD2782C376A.quest_subtitle: "传输 &e能量&f"
	quest.5BB1EBD2782C376A.title: "&e能量&f传输杆"
	quest.5BB309E264190DB9.quest_desc: ["我们可以用巨轮造一辆巨型车，也可以用小轮造一辆小车，这完全取决于我们的需求。"]
	quest.5BB309E264190DB9.quest_subtitle: "新型号的轮子种类"
	quest.5BBF7D2BF9486E63.quest_desc: [
		"远古残骸是诅咒金字塔中出现的亡灵恐龙&4boss&f。"
		""
		""
		"{entity:cataclysm:ancient_remnant ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:FORCE_OFF idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.5BBF7D2BF9486E63.quest_subtitle: "一只史前恐龙"
	quest.5BBF7FAE04B3A554.quest_desc: ["&6残暴者&f对自己的族群极为护短，所以如果要&c攻击&f它，请远离其他残暴者！"]
	quest.5BBF7FAE04B3A554.quest_subtitle: "一个猪灵模仿者"
	quest.5C01B848A01FEF92.quest_subtitle: "血族学校 &7盔甲&f"
	quest.5C01B848A01FEF92.title: "邪教徒&7盔甲&f"
	quest.5C2108BD3DEEB0E6.quest_desc: [
		"注水口是一种用于填充&3液体&f容器（如瓶子或桶）或与液体进行合成的方块。"
		""
		"Spout 可通过 &3Fluid&f Pipes 填充最多 1 桶任意液体，并通过 Conveyor Belt 或 Depot 将部分液体倾倒在从其下方经过的兼容物品上。"
		""
		"无论使用多少流体，出水管处理一个物品需要1秒，但两次注水之间的延迟可能由出水管重新注满所需的时间引起。"
	]
	quest.5C2BEB7EC5DF52E7.quest_desc: ["模组中的几个配方需要这些符文……去探索世界寻找它们吧。"]
	quest.5C2BEB7EC5DF52E7.quest_subtitle: "奇怪的符文 (A Strange Rune)"
	quest.5C75B7C6F6464807.quest_subtitle: "用于配方制作"
	quest.5C770DE2F2340335.quest_subtitle: "第5级"
	quest.5CCECCB9A4238A1F.quest_desc: ["这套盔甲是 &bApplied&f 在你身体上的延伸！打开 &9system&f，与 Applied 一起变强。"]
	quest.5CCECCB9A4238A1F.quest_subtitle: "AE2"
	quest.5CCECCB9A4238A1F.title: "量子&7盔甲&f"
	quest.5D3EE44FB41D289F.quest_desc: ["一种类似于存储单元的物品，可让你自定义特定ME终端的过滤设置。"]
	quest.5D9D893998EE5989.quest_desc: [
		"迷失在崭新的雪地&2森林&f生物群系中..."
		""
		"我们能找到雪怪，他藏在金字塔里，满眼血丝地等着你！"
		""
		""
		"{entity:twilightforest:alpha_yeti ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:FORCE_OFF idle:FORCE_OFF walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.5D9D893998EE5989.quest_subtitle: "雪中的怪物"
	quest.5DA2C1E858DC6ABF.quest_desc: ["使用这张特殊地图，以免在迷宫里迷路。"]
	quest.5DA2C1E858DC6ABF.quest_subtitle: "在迷宫里迷路了吗？"
	quest.5DAF7F67C153E43F.quest_subtitle: "用炽热的&7锭&f，我们可以制作新装备"
	quest.5DAF7F67C153E43F.title: "火焰&7盔甲&f"
	quest.5E0FB1B7DBE6E5A2.quest_desc: [
		"现在我们完成了全部16个挑战，可以消耗&2essence&f，从而获得极高的声望。"
		""
		"这样我们就可以破坏方块、采集蜂蜜、自由进入建筑，而且&3流体&f蜂蜜还有超棒的效果！"
	]
	quest.5E0FB1B7DBE6E5A2.quest_subtitle: "正在赢得尊重！"
	quest.5E116409DC7D30BB.quest_desc: ["配置器用于配置 Mekanism 中的许多物品，例如更改管道为“拉入或推入”或旋转机器。"]
	quest.5E2B9B6AAB1F34F4.quest_desc: ["想要飞行，我们需要一个能让风通过的平坦表面；为此，建造飞机最好的方法是将风车用作机翼的一部分，因为它更轻、&a更容易&f。"]
	quest.5E2B9B6AAB1F34F4.quest_subtitle: "飞行模式开启，可以翱翔天际了！"
	quest.5E6AB4394F4BDAEC.quest_desc: [
		"要获得石油，你需要制作石油探测器。"
		""
		"用此物品右键点击方块，即可判断该区块中是否存在石油。使用 F3 + G 辅助区块可视化。"
	]
	quest.5E6AB4394F4BDAEC.quest_subtitle: "正在定位石油"
	quest.5E7C0BC276E6F1F7.quest_desc: [
		"我想这个模组无需过多介绍……"
		""
		"在&dMystical&f中，我们可以制作几种新盔甲，最后两个等级还能为其添加强大的&a升级&f！"
	]
	quest.5E7C0BC276E6F1F7.quest_subtitle: "&dMystical&f..."
	quest.5E7C0BC276E6F1F7.title: "觉醒的超贵金属&7盔甲&f"
	quest.5ED197309A07FBE3.quest_desc: ["这个方块就像反应堆一样，可以通过堆叠这些方块来加快&a生长&f的&a速度&f。"]
	quest.5ED197309A07FBE3.quest_subtitle: "正在加速！"
	quest.5EDD49E8775D1C77.quest_desc: [
		"暮色森林有许多挑战，是一个全新的世界，所以地图必不可少！"
		""
		"旅行和探索中，你可以找到&8黑曜石&f柱；在这些柱子周围有渡鸦，击败它们以获得羽毛。"
		""
		"{entity:twilightforest:raven ent_size:1.0 off_x:0.0 off_y:0.0 rot:35.0 spin:FORCE_OFF idle:FORCE_OFF walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.5EDD49E8775D1C77.quest_subtitle: "寻找一只渡鸦（Finding a Raven）"
	quest.5EE811200D7F9226.quest_desc: ["除了坚固，这套漂亮的 &7盔甲&f 还来自 &6Create&f 附加包；它与其他盔甲截然不同，而且制作简单。"]
	quest.5EE811200D7F9226.quest_subtitle: "与众不同的&7盔甲&f"
	quest.5F01AC84FEBFE724.quest_desc: ["我们可以&6创造&f新的泥土类型来加快种子的&a生长&f过程。"]
	quest.5F01AC84FEBFE724.quest_subtitle: "一个&a改良&f泥土方块"
	quest.5F0E877BE50D79D0.quest_desc: ["与 &6Spatial IO Port&r 配合使用，以存储空间区域。"]
	quest.5F96B028BB23FE5D.quest_desc: [
		"要使用无线工具，必须安装无线发射器，使存储&9网络&f可以无线访问。默认范围为16格，但可以扩大。"
		""
		"要将无线电网连接到您的网络，请按住 Shift 键并右键单击存储网络中的任意设备。"
	]
	quest.5F96B028BB23FE5D.quest_subtitle: "访问权限"
	quest.5FA26B0DCC847238.quest_desc: ["找到一个要塞，我们需要激活通往&5末地&f的&5传送门&f。"]
	quest.5FA26B0DCC847238.quest_subtitle: "追逐着&5末地&f的旅程"
	quest.5FAEE106DEADDD95.quest_desc: ["欢迎来到 Oritech！Oritech 是一款全新独特的模组，视觉效果惊艳，功能强大。它带来了新型电缆、反应堆、采矿机等等！"]
	quest.5FAEE106DEADDD95.quest_subtitle: "一项全新的工程学成就"
	quest.6013A55D0A31137E.title: "{ftb\tquests.chapter.mystical_agriculture.quest6013A55D0A31137E.title}"
	quest.60331FE2ECA3A946.quest_desc: [
		"要长途旅行，你需要&a升级&f这枚火箭！"
		""
		"火箭升级有四种类型："
		""
		"引擎升级：更改火箭所需的燃料"
		"油箱升级：更改最大油箱容量"
		"模型升级：更改火箭模型"
		"皮肤升级：更改火箭皮肤"
	]
	quest.60331FE2ECA3A946.quest_subtitle: "想走得更远一点吗？"
	quest.603877AB96321F1A.quest_desc: [
		"热蒸发厂或太阳能蒸发厂，加上高级太阳能发电机，是一种将水转化为卤水，并通过第二个TEP将卤水转化为锂的模块化结构。"
		""
		"要加快生产速度，除了将高级太阳能发电机放在顶部外，还必须将热源导入阀门。最简单的方法是将电阻加热器放在阀门旁边。将&e能量&f消耗设为1250 FE/t可获得最大提升，更高的消耗无效。"
	]
	quest.605C0B84DFC1A4D5.quest_desc: [
		"Gantry Carriages 是一种会碰撞路径上不可移动方块的装置。"
		""
		"沿轨道车移动路径放置龙门导轨。向导轨施加旋转&e动力&f以移动轨道车，反向动力可使其返回。倒置导轨的放置方向将倒置所有移动。使用&a扳手&f来辅助改变方向。"
		""
		"每1转/分钟的旋转功率，龙门架将沿轴以0.03846块/秒的线性&a速度&f移动。"
		""
		"向竖井发送&c红石&f信号以停止矿车，并通过矿车的输出端传递旋转动力。这可用于移动另一辆已连接的龙门架矿车。"
		""
		"连接到车厢输出的龙门架将随其&9自动&f移动。"
		""
		"多个车厢在同一个轴上也可以移动建造在其上的相同结构。"
	]
	quest.60B5B315CD03E162.quest_desc: ["这个&2种子&f是整合包中开始种植的基础！你需要它才能开始。"]
	quest.60B5B315CD03E162.quest_subtitle: "基础&2种子&f"
	quest.60EC70ED9DC908A0.quest_subtitle: "未充能的石英"
	quest.60F40F9349D3F369.quest_desc: [
		"目前就这些！你已经完成了本整合包中&5the end&f的&9Mekanism&f进度。"
		""
		"目前还没有额外的 Mekanism 附加组件或扩展，所以你的工厂只能做到这一步了。你已经掌握了所有可用的矿石处理和&9自动化&f阶段，是一项了不起的成就！"
		""
		"继续探索、实验，并将Mekanism与其他模组整合，将你的生产推向更高峰。谁知道未来会有什么升级呢？"
	]
	quest.612A0A9F85E338F6.quest_desc: ["这个方块是我们&9系统&f的扩展，有助于将所有东西连接起来！而且我们还可以给它染色。"]
	quest.612A0A9F85E338F6.quest_subtitle: "装饰中"
	quest.61348E2551E8AD6C.quest_desc: [
		"要让旋转&a速度&f控制器正常工作，必须搭配一个大型齿轮。当旋转速度控制器由大型齿轮供电时，它会从侧面输出任意所需的旋转力速度。反之亦然：当从侧面供电时，它会控制大型齿轮的速度。"
		""
		"旋转速度和方向可以在&9机器&f的前后侧的价值设置屏幕中更改。速度最高可设置为顺时针或逆时针256转/分钟。"
	]
	quest.618AA6F5B498966F.quest_subtitle: "牛头人掉落物"
	quest.61A97968BD86738D.quest_desc: ["所以要得到这个工具，你只需要杀死一个&4boss&f，很简单。"]
	quest.61A97968BD86738D.quest_subtitle: "这是一个工具吗？"
	quest.61FF9A034749467F.quest_desc: ["我知道你从没想过当&1狱警&f... 但这根强大的&d法杖&f会很酷！"]
	quest.61FF9A034749467F.quest_subtitle: "&1卫道士&f！"
	quest.6213EC800B6C9A60.title: "{ftb\tquests.chapter.mystical_agriculture.quest6213EC800B6C9A60.title}"
	quest.621F052BCE747E68.quest_desc: [
		"高容量电缆，可承载32个通道，而标准电缆只能承载8个。"
		""
		"但它不支持总线，所以在使用总线或面板前，必须先从高密度电缆降级到较小的电缆（如 Fluix ME Glass Cable 或 Fluix ME Smart Cable）。"
		""
		"与Fluix ME智能电缆类似，每条亮起的线代表四个正在使用的通道。"
	]
	quest.6235BBB56DA52EAB.quest_desc: [
		"你的 &9网络&f 可以通过多种方式与其他 &9机器&f 互动。这能实现流程自动化，让生活更轻松！"
		""
		"导入器将资源从相连的外部物品栏中提取到存储网络中。"
		""
		"Exporter 将资源从存储网络中提取到相连的外部物品栏中。"
		""
		"该接口结合了导入器和导出器的功能。"
		""
		"外部存储为存储网络提供来自已连接外部物品栏（箱子、抽屉、桶）的存储空间。这样您就能存放大量物品，而不会占用过多磁盘空间。"
	]
	quest.626580DB654F128D.quest_desc: ["磨石能够将研磨配方应用于从上方投入的任何有效物品。"]
	quest.62BAE54B507B7A21.quest_subtitle: "合成配方材料"
	quest.62C537CD789F46A8.quest_desc: ["&dArs Nouveau&f 是一款超棒的模组，能让我们制作自定义的 &d法术&f、定制盔甲、探索新群系、新祭坛等等！"]
	quest.62C537CD789F46A8.quest_subtitle: "&6创造&f你的法术！"
	quest.62CD24B33EF2FD15.quest_subtitle: "下界合金&a升级&f"
	quest.63116F5AC987C442.quest_desc: ["一旦我们获得了第一个原子，一切都会&a大幅&f改善！"]
	quest.63116F5AC987C442.quest_subtitle: "开始变得酷起来了"
	quest.633147DFBEDC8F9D.quest_desc: ["这些大家伙待在&3水里&f，等着我们犯错呢！"]
	quest.633147DFBEDC8F9D.quest_subtitle: "一只小小的&3水&f怪"
	quest.6350ADB7540C368D.quest_desc: [
		"如果智能观察者正面朝向机械带、漏斗或&3流体&f管道等容器，当检测到内部有物品时，它会发出&c红石&f信号。如果放置在它前面的方块与过滤器匹配，智能观察者也会发出信号。"
		""
		"如果智能观察者应用了过滤器，那么只有在检测到过滤器中的物品时，它才会发出红石信号。"
	]
	quest.63A18018090DB63E.quest_desc: ["储存大量单一物品！"]
	quest.63A18018090DB63E.quest_subtitle: "一个新的仓库"
	quest.63B2455BB59EDC81.quest_desc: ["在一个全新的、极其恶心的世界里，我们能找到最终的&4boss&f，它的爪牙会穿着这套&7armor&f..."]
	quest.63B2455BB59EDC81.quest_subtitle: "一个肮脏的世界"
	quest.63B2455BB59EDC81.title: "远古&7盔甲&f"
	quest.63B4B83F528E6AD6.quest_desc: ["{ \"text\": \"Click Me!\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"4CFE8B1C53B429E9\" } }"]
	quest.63E8F78EEA3063F7.quest_desc: ["{ \"text\": \"Click Me!\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"24DDED464AE48E05\" } }"]
	quest.641A6EFAB3BD34F9.quest_desc: ["模组中最后一档的&2种子&f，或许也是我们整合包最强大的部分之一！"]
	quest.641A6EFAB3BD34F9.quest_subtitle: "最终章"
	quest.648B3A56FD170FBE.quest_desc: [
		"这个结构是这个模组里最大的！"
		""
		"一个由相互连接的房间组成的巨大蜂巢，看起来像一个迷宫……"
		""
		"喂食蜜蜂以获得蜜蜂保护效果。"
		""
		"探索并&6掠夺&f其中的资源！"
	]
	quest.648B3A56FD170FBE.quest_subtitle: "一个独特的建筑！"
	quest.65524E9701FD370B.quest_subtitle: "第10级"
	quest.65C0B2AD90D292EE.title: "&b霜钢&f盔甲"
	quest.66042E6264BAC86F.quest_subtitle: "装饰箱子、桶等物品。"
	quest.6617C1A5821899CB.quest_desc: [
		"&6弹弓&f是一种非常奇特的武器，需要4种新型弹药，分别是"
		""
		"- 闪亮黏液 (Glitter Goo)"
		"- 深度岩砾石"
		"- 泡泡浆果"
		"- 格鲁恩格莱特（Gronglets）"
		""
		"全部试一遍，测试它们的效果吧！"
		""
		"好的……只是在某些怪物身上别测试。我们可以把怪物分成3类"
		""
		"- 朋友"
		"- &c敌对生物&f"
		"- &e中立&f"
		""
		"每种生物都有新颖独特的东西！"
	]
	quest.6617C1A5821899CB.quest_subtitle: "新武器与新生物登场"
	quest.66507950890A5031.quest_desc: ["你可以用这个指南针来定位蜂巢；“Shift + 右键”蜂巢即可追踪，或在空中点击以定位蜂巢迷宫。"]
	quest.66507950890A5031.quest_subtitle: "正在查找蜂巢位置"
	quest.666E760E6ED96FA5.quest_desc: ["我们可以收集自然掉落的白色恐鸟蛋，用孵化器孵化，从而获得一只忠诚的恐鸟随从。"]
	quest.666E760E6ED96FA5.quest_subtitle: "孵化"
	quest.668D908EB0805AFB.quest_desc: [
		"在&bAether&f中，我们能找到第一个挑战……"
		""
		"找到滑块的洞穴并杀死他。"
		""
		"滑块是一个带有眼睛的巨大方块，只能用镐子&c破坏&f！"
