	quest.288C06FAA3B8C3B9.title: "&c武器&f"
	quest.28ADF1DEAAB6C852.quest_subtitle: "寻找采矿地点"
	quest.292B68852CC24D30.quest_desc: ["每当我们达到新的&2seed&f等级，就能在&dMystical&f中获得新工具，变得越来越强！"]
	quest.292B68852CC24D30.quest_subtitle: "新工具"
	quest.292B68852CC24D30.title: "Inferium 工具"
	quest.29600A0988EF997C.quest_desc: [
		"要开始玩&5Occultism&f，我们需要撸一些草，直到掉落一个&2种子&f；这是一切的开端。"
		""
		"我们必须种植它并收获果实，这非常重要！"
	]
	quest.29600A0988EF997C.quest_subtitle: "入门指南！"
	quest.29BEE3FF3C832D95.quest_desc: [
		"在&2黑暗森林&f内部，我们能找到&5黑暗塔&f。"
		""
		"进入塔楼，直面谜题和通往顶端的&c危险&f路径。"
		""
		"要对抗Ur-Ghast，最好带上远程武器。此外，还有4个由&cGhastlings&f死亡充能的陷阱，你可以用红石激活它们，对Ur-Ghast造成巨额伤害。"
		""
		""
		"{entity:twilightforest:ur_ghast ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:FORCE_OFF idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.29BEE3FF3C832D95.quest_subtitle: "一个不死族加斯特"
	quest.29C451D97A47A48C.quest_desc: ["{ftb\tquests.chapter.mystical_agriculture.quest29C451D97A47A48C.description1}"]
	quest.29C451D97A47A48C.title: "{ftb\tquests.chapter.mystical_agriculture.quest29C451D97A47A48C.title}"
	quest.29E9A9148148D7B1.quest_desc: ["&6Muncher&f的嘴巴很大，掉落物也比别的生物&a好得多&f。"]
	quest.29E9A9148148D7B1.quest_subtitle: "大嘴怪"
	quest.2A04882BD97D2D7B.quest_desc: ["万事开头难！我们需要从基础开始，收集石头就是其中之一。"]
	quest.2A04882BD97D2D7B.quest_subtitle: "我们的第一块石头"
	quest.2A04882BD97D2D7B.title: "&7鹅卵石&f"
	quest.2A1D8F1C7042753D.quest_desc: [
		"&e朋友，你好&f，欢迎来到 &cAll Ultimate Selection&f"
		""
		"我很乐意教你各种各样的东西，放心吧，即使事情看起来&c很难&f，但它们确实如此……不过凡事总有办法，而且&a我们一定会学会&f！"
	]
	quest.2A1D8F1C7042753D.quest_subtitle: "欢迎"
	quest.2A404708E175235F.quest_desc: [
		"&3Fluids&f can be stored and extracted from fluid tanks via Fluid Pipe. The fluid pipes can be placed on any face of the fluid tank: top, bottom, or sides. The window of a tank can be toggled with a &aWrench&f."
		""
		"流体管道的流向表示流体是流入储罐还是流出储罐；如果流体流向储罐，则流体将被储存在储罐中。同样，如果流体管道远离储罐（通过机械泵），则储罐中的流体将被抽出到该管道中。"
	]
	quest.2A4929CD0A5C3CC0.quest_desc: ["由&5Twilight&f的最终首领掉落，这把&cbow&f不仅美丽，而且威力巨大！"]
	quest.2A4929CD0A5C3CC0.quest_subtitle: "三合一"
	quest.2A4F001CF2097C28.quest_desc: ["&dMystical&f &7armor&f 的入门套装可能不是最好的，但最终套装绝对是顶级的！"]
	quest.2A4F001CF2097C28.quest_subtitle: "很棒的装备！"
	quest.2A4F001CF2097C28.title: "觉醒的&7盔甲&f"
	quest.2AD9A9806511DD0A.quest_subtitle: "电缆与电缆"
	quest.2AD9ADC19C29F44B.quest_desc: ["有时候，变强一点、涨点经验总是好的。"]
	quest.2AD9ADC19C29F44B.quest_subtitle: "正在变强中"
	quest.2ADDA74C73C08DB2.quest_desc: ["一个齿轮箱，其4个面的旋转方向均可独立配置。"]
	quest.2AF85A5EE9A8CCBA.quest_desc: ["A clutch that is only coupled if the input RPM is &afaster&f than a configurable threshold."]
	quest.2B69F28B098EFFAB.quest_desc: [
		"会复活的方块是超棒的装饰，点击它们一段时间后就会重新出现。"
		""
		"而消失方块在点击后会永久消失！"
	]
	quest.2B69F28B098EFFAB.quest_subtitle: "时尚方块"
	quest.2B7AC4627A121BD8.quest_subtitle: "&6黄金&f升级"
