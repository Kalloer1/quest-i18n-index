					xp_levels: 1
				}
			]
			size: 1.1d
			tasks: [{
				id: "210D062819CD9386"
				item: "reliquary:infernal_tear"
				type: "item"
			}]
			x: 1.950000000000002d
			y: 14.049999999999999d
		}
		{
			dependencies: ["081070F7CBF61207"]
			description: [
				"&o&7埃莱奥诺尔游记，第六卷"
				""
				"&c“皇帝的圣杯是我较为温和的发明之一，仅仅是一个无限水源。绝对实用，只是对我来说不够刺激。我通常用它来填充我的药剂师坩埚，口渴时也会喝上一口。只要别把它倒着放就行。我差点淹了一个街区，损失惨重，至今难忘……”&r"
				"{@pagebreak}"
				"&f\"但这和提着两桶水不是一样吗？\""
				""
				"&c\"什么？\"&r"
				""
				"&f\"你知道的，物理定律。\""
			]
			entity_vis_size: 1.0f
			id: "4128B0BDF74E7913"
			rewards: [
