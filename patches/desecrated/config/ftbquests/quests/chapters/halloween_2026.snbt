	order_index: 0
	quest_links: [ ]
	quests: [
		{
			description: [
				"&o&7埃莱奥诺尔游记，第七卷笔记"
				""
				"&f我来到了这个名为Red Barar的奇异土地，一个充满吸血鬼……哦抱歉，是他们自称的Sanguines的热闹地方。吸血鬼只是人造的Sanguine。我来此是为了寻找掌握Moon Pathway知识的Moon Cult。至少我前段时间已经获得了我的Temperance牌。"
				""
				"&f看来他们每年这个时候都会举办盛大的节日。是时候融入其中了。"
				""
				"&a本章的 quest 会在上一章的 quest 完成后解锁。本章的 quest 大多需要提交物品。"
			]
			entity_vis_size: 1.0f
			id: "0822814E563A5044"
			rewards: [{
				id: "5B4CF561B6FE1579"
				item: {
					Count: 1
					id: "vampirism:blood_bottle"
					tag: {
						Damage: 9
					}
				}
				type: "item"
			}]
			tasks: [{
				consume_items: true
				id: "62C638C03777884A"
				item: "minecraft:carved_pumpkin"
				type: "item"
			}]
			title: "血祭典"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["0822814E563A5044"]
			description: [
				"&o&7埃莱奥诺尔游记，第七卷笔记"
				""
				"&f看来这个节日的一部分是血族之间的竞赛，看谁能在三周内收获最多的血。我原以为贵族们会占尽优势，毕竟他们有十几个工厂日夜不停地生产血，事实证明我的猜测是对的。还有一个儿童组，用手工收集血。"
			]
			entity_vis_size: 1.0f
			id: "63785492CE884D72"
			rewards: [{
				count: 13
				id: "3B294FAC22F44080"
				item: "minecraft:gold_ingot"
				type: "item"
			}]
			size: 1.15d
			tasks: [{
				consume_items: true
				id: "720829EB32FB31D7"
				item: {
					Count: 1
					id: "vampirism:blood_bottle"
					tag: {
						Damage: 9
					}
				}
				match_nbt: true
				type: "item"
			}]
			title: "竞赛开始了，准备好迎接挑战了吗？"
			x: 0.0d
			y: -2.0d
		}
		{
			dependencies: ["63785492CE884D72"]
			description: [
				"&o&7埃莱奥诺尔游记，第七卷笔记"
				""
				"&f我有时会忘了这些血族得一直喝血。很久以前我拿到节制牌后，就靠喝自己的血过日子。体验并不好，但我当时穷得叮当响。"
				""
				"&f看来这次庆典的收入要捐给慈善机构了……有穷的吸血鬼吗？我以为这附近的人都很有钱。如果没有，他们为什么不直接晒晒太阳？他们的人类牲畜肯定不需要血。"
			]
			entity_vis_size: 1.0f
			id: "0702805376964E53"
			rewards: [{
				count: 9
				id: "69555A41FF67667C"
				item: "minecraft:diamond"
				type: "item"
			}]
			tasks: [{
				consume_items: true
				count: 10L
				id: "67C27B705ED5D36A"
				item: {
					Count: 1
					id: "vampirism:blood_bottle"
					tag: {
						Damage: 9
					}
				}
				match_nbt: true
				type: "item"
			}]
			x: 0.0d
			y: -3.5d
		}
		{
			dependencies: ["0702805376964E53"]
			description: [
				"&o&7埃莱奥诺尔游记，第七卷笔记"
				""
				"&f我沮丧地发现，我捐的血其实还没算进节日的收藏总数。这其实只是个扭曲的入场费，或者说，是证明自己有资格参赛的凭证。"
				""
				"&f也就是说，我只献血，却什么凭证都拿不到！真坑！不过，要真正在血族中竞争，大概还差五十份左右就能生产完成了。"
			]
			entity_vis_size: 1.0f
			id: "1BE7F4AA8E307379"
			rewards: [{
				id: "6A1AF49B0A4C0A69"
