			}]
			x: 0.0d
			y: -5.0d
		}
		{
			dependencies: ["1BE7F4AA8E307379"]
			description: [
				"&o&7埃莱奥诺尔游记，第七卷笔记"
				""
				"&f至少，我从捐赠给节日的一些物品中收到了一些小奖品。我得到了一把方便的铁镐……不过我觉得它比不上我的大法师魔典。更诱人的似乎是一把古董活血剑。它不是最强大的武器，但却很优雅。"
			]
			entity_vis_size: 1.0f
