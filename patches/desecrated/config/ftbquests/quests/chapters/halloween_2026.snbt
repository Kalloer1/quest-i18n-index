		}
		{
			dependencies: ["0822814E563A5044"]
			description: [
				"&o&7埃莱奥诺尔游记，第七卷笔记"
				""
				"&f每年的这个时候，有个传统是把南瓜诅咒成血南瓜。过程很简单，只要有人知道怎么用一桶血在南瓜上画出正确的咒语，它就会受到诅咒，并慢慢充满神秘的血液。"
			]
			entity_vis_size: 1.0f
			id: "6F7D1EDC2EF88924"
			rewards: [{
				id: "0709DE257E26C79B"
