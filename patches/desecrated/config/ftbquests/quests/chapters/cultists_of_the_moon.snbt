					Count: 1
					id: "perdition:halcyon"
					tag: {
						Damage: 0
					}
				}
				type: "item"
			}]
			x: -4.6d
			y: 5.1d
		}
		{
			dependencies: ["19CD7CA150532811"]
			description: [
				"&o&7埃莱奥诺尔游记，第二卷笔记"
				""
				"&f血液为古老的巫术提供了必要的精神力量，但如果有多余的，它也能提供身体所需的营养。一些古代女巫甚至完全以血液为食，我本人也曾有过一段时间是这样。过了一段时间，你的胃就会习惯并接受它……"
				"{@pagebreak}"
				"&o&7埃莱奥诺尔游记，第九卷笔记"
				""
				"&2在炼狱各处，尤其是炼狱深渊中，都能找到一些奇特的珍贵矿石。"
				""
				"&2这些是银矿石和黄铁矿，熔炼成银和女巫金后都同样有用。女巫金可能对女巫更实用，但银对科技和魔法等所有发展路线都很有用。&r"
			]
			entity_vis_size: 1.0f
			hide_until_deps_complete: true
			id: "585D9482FF0C3669"
			rewards: [{
				id: "77BC42B3AE71E6A3"
				type: "xp_levels"
				xp_levels: 1
			}]
			tasks: [{
				id: "408228206A22A454"
				item: "perdition:pyrite"
				type: "item"
			}]
			x: -1.6999999999999993d
			y: 3.0999999999999996d
		}
		{
			dependencies: ["5D06B3DA89CB0B2E"]
			description: [
				"&o&7埃莱奥诺尔旅行笔记，第九卷"
				""
				"&2炼狱是一个迷人的维度，充满了神秘的原料和各种异常现象。&r"
				""
				"&2我已将找到的各种材料及其用途记录如下。穿越黑暗之地时，你需要一盏灯笼才能看到前方2英尺以外的东西。&r"
				"{@pagebreak}"
				"&2进入炼狱主要有两种方式：第一种是使用哈尔西恩之剑，可由已进入炼狱者，或用足够多的异常或元素部件制造出人工哈尔西恩者（如&m--------------&r &2的研究员或&m-----------&r&2的元素主义者）制作。第二种是饮用由&m--------&r&2的巫师制作的位面行者药水。&r"
			]
			entity_vis_size: 1.0f
			hide_until_deps_complete: true
			id: "19CD7CA150532811"
			rewards: [
				{
					id: "01EF1573C828544C"
