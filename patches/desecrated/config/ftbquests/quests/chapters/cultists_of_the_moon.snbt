				""
				"&2一把奇特的剑，是少数能开启通往另一个维度的裂缝的武器之一，该维度与某些宗教描述中的林勃颇为相似。&r"
				"{@pagebreak}"
				"&2炼狱是个奇怪的地方，有时看似毫无生机。但它含有一些元素术士有用的材料，在许多配方中都能作为很好的替代品。&r"
			]
			entity_vis_size: 1.0f
			hide_until_deps_complete: true
			id: "5D06B3DA89CB0B2E"
			rewards: [{
				id: "597ACEAFFBB55A91"
				type: "xp_levels"
				xp_levels: 1
			}]
			tasks: [{
				id: "004A83AA325509BC"
