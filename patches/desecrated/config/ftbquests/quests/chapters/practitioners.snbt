						Damage: 0
					}
				}
				type: "item"
			}]
			x: 0.0d
			y: -4.0d
		}
		{
			description: [
				"黑暗术士与伟大存在、其他世界和灵魂签订契约。他们束缚生物，运用灵魂的力量，并研究周围的世界。"
				""
				"修行者需要一份契约才能进入这个颠倒的世界。在那里，他们既可以施展契约魔法，也可以研究灵魂的力量。"
			]
			entity_vis_size: 1.0f
			id: "28113F3C960EC2FB"
			size: 1.1d
			tasks: [{
				id: "10F6168D3045E419"
				item: "desecratedcore:practitioner_key_item"
				type: "item"
			}]
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["37B247664DB669DC"]
			description: [
				"&4你可以在地底深处以矿石的形式找到硫磺。"
				""
				"&4你必须用微量汞混合这种硫磺，为仪式做好准备。"
			]
			entity_vis_size: 1.0f
