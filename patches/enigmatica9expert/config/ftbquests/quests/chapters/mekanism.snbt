		{
			dependencies: ["51ABA98A9755702F"]
			description: ["Logistical Transporters本身可能未配置为红石敏感，但这并不意味着该选项完全消失。将一段管道替换为Diversion Transporter，其每个面都可单独配置红石控制。"]
			id: "79F3C54ACC550AB9"
			rewards: [{
				command: "/execute at @p run loot spawn ~ ~1 ~ loot enigmatica:loot_boxes/mekanism/rare"
				icon: "kubejs:rare_lootbox"
