			}]
			tasks: [{
				id: "6B6252E342220039"
				item: "mekanism:diversion_transporter"
				type: "item"
			}]
			x: 3.5d
			y: 0.5d
		}
		{
			dependencies: ["51ABA98A9755702F"]
			description: [
				"物流运输机可以从任何物品栏中取货，但这会按“就近优先”的顺序进行。若想要更高级的功能，可以使用物流分拣机。"
				""
				"分拣器可放置在任何物品栏旁，用于标记物品的提取点。它们不能放置在管道段的中间或末端。"
				""
				"分拣器必须先配置一个或多个过滤器。例如，点击“新过滤器”，然后选择“物品栏”。左侧有两个框。上方的框可以拖入物品。点击下方的框可设置颜色通道。这些颜色与配置物流运输器时的颜色一致，并能指示物品的去向。"
				""
				"沿用上面的例子，假设石头设置了蓝色过滤器，花岗岩设置了绿色过滤器。分类器在吸入石头或花岗岩时，这些物品会分别被蓝色或绿色的框框包围。当它们在管道中移动时，如果有蓝色或绿色的管道可选，它们会优先选择走那条路。"
				""
				"方便的是，其他 Mekanism 机器也使用相同的系统。每台机器都有一个 Transporter Config，可以为输入端口指定颜色，并为所有输出端口设置颜色。例如，熔炼厂可以指定黄色来接收 Cobblestone，并为输出指定蓝色，将产生的 Stone 路由到前例中的蓝色线路。"
				""
				"这个系统远比这里能涵盖的要复杂得多，但只要耐心一点，弄清楚也不难。"
			]
			id: "42499C7047322203"
			min_width: 300
			rewards: [{
				command: "/execute at @p run loot spawn ~ ~1 ~ loot enigmatica:loot_boxes/mekanism/rare"
				icon: "kubejs:rare_lootbox"
				id: "72D2A9208D24A98B"
				title: "稀有的Mekanism战利品箱"
				type: "command"
