	file.0000000000000001.title: "Cobblemon: aBunchaMods"
	quest.03F8B40FE7F14849.quest_desc: ["无线终端和普通终端完全一样，只不过是无线的！"]
	quest.06F8F145D1583F23.quest_desc: [""]
	quest.06F8F145D1583F23.quest_subtitle: "捕捉更多宝可梦来组建你的队伍！"
	quest.07B89EF627CA6824.quest_desc: [
		"要认领区块，请按 M 键或打开物品栏，然后点击左上角的地图"
		""
		"在那里，你可以拖动鼠标来认领你周围的土地。"
		""
		"强制加载（类似 OG Chunk Loader）：Shift+左键点击区块，操作正确的话，区块上会出现线条。"
		""
		"要取消认领土地，请重复上述操作，但按住右键或按住 Shift 键再右键点击已认领的区块。"
	]
	quest.0C02A39661CAEEE3.quest_desc: ["Applied Energistics 2 最重要的部分无疑是其存储系统，它使用数字化的 &e存储单元&f。这些单元可以通过单个单元的 &eME 箱子&r 或多个单元的 &eME 驱动器&r 来访问。\\n\\n&bME 箱子&f 一次只能容纳一个单元，并且可以从同一网络上的任何其他终端读取和写入。ME 箱子本身顶部也自带终端屏幕，但只能访问其内部包含的单元。\\n\\n&bME 驱动器&f 可以在单个方块和单个 ME 通道的空间内容纳多达 10 个不同类型的存储单元。但它没有自己的终端屏幕，因此需要通过网络中其他地方的外部终端来访问存储。"]
	quest.149C428E2DD03173.quest_desc: ["从 Articuno、Moltres 和 Zapdos 处获得 25% 的掉落率加成"]
	quest.196135905C3FB8C6.quest_subtitle: "捕捉一些宝可梦吧！"
	quest.1A2907B2912877B6.quest_desc: ["欢迎来到 Cobblemon: aBunchaMods，一个类似于 ATM10 但没有那些超强力模组的整合包！"]
	quest.1AEE730F867D2E11.quest_subtitle: "制作一个超球！Craft an Ultra Ball!"
	quest.1AEE730F867D2E11.title: "制作一个超球！Craft an Ultra Ball!"
	quest.1E6D907242530577.quest_subtitle: "制作一个大球！Craft a Great Ball!"
	quest.1E6D907242530577.title: "制作一个大球 (Craft a Great Ball)"
	quest.1E995B862F0AE98C.quest_desc: ["这些线缆与其他线缆的工作原理相同，但它们会以彩色的线条形式，在线缆上显示正在使用的通道数量。"]
	quest.1E995B862F0AE98C.title: "高级线缆模组 (Advanced Cables)"
	quest.237D1B02B0893CAE.quest_desc: [
		"&3Certus Quartz&f 是 Ae2 中几乎所有东西都需要的材料。"
		""
		"用无暇的芽生石英就能无限培育它们（而且还能用纸板箱从陨石上偷这些 O_O）"
		""
		"找到这些，然后开采它们生长的石英，以获得所需的 Certus Quartz Dust 和水晶。"
	]
	quest.255B67E6C830F1B6.quest_desc: [
		"终端可以让你访问ME网络中的内容。"
		""
		""
		"ME 合成终端也内置了合成网格。"
	]
	quest.2D6AFCD1270AC75D.quest_subtitle: "使用所有类型的鱼饵！"
	quest.2F3DCFB10DEEF700.quest_desc: [
		"集齐所有刻印机后，就开始制作处理器吧。"
		""
		"这些是制作大多数 Ae2 设备所必需的。"
	]
	quest.2F3DCFB10DEEF700.title: "处理器"
	quest.2F5118C4576D0155.quest_desc: ["默认情况下，没有ME控制器时，ME网络自身的内部缓冲区只有800AE，而控制器每块可增加8kAE。对于足够大的网络，这可能不够，并可能导致网络在尝试为任何已连接设备回收能量时间歇性断电。\\n\\n&b能量单元&f允许ME网络存储更多的能量，每个普通能量单元可增加200kAE，每个&b致密&f能量单元可增加1.6MAE。这些单元也可以放置在网络的任何位置以提供增大的能量缓冲区。"]
	quest.309344E43A3619E5.quest_desc: ["将存储驱动器插入你之前制作的ME驱动器中，然后通过终端向你的系统中添加物品"]
	quest.3904FCE72AD28292.quest_desc: [
		"要开始使用 AE2，你需要一个 &3充电器&f 和一个 &5刻写器&f。"
		""
		"&3充电器&f在通电后会为 Certus Quartz 晶体进行充电。"
		"用充能水晶可以制作成流质水晶。"
		""
		"&5Inscriber&f用于将不同晶体转化为粉尘，但它的主要用途是"
		"使用&5Inscriber &f来制造&cPrinted Circuits &f和&cProcessors&f。"
	]
	quest.3904FCE72AD28292.quest_subtitle: "开始行动吧！"
	quest.3904FCE72AD28292.title: "入门指南"
	quest.3B75D64302BCB50B.quest_desc: ["该整合包的最终目标是制作出大师之星。"]
	quest.449652FB57155835.quest_desc: [
		"你可以在世界各处找到含有 Sky Stone 的陨石。"
		""
		"挖掘它们，寻找神秘的立方体"
		""
		"一旦你挖掘到立方体，就会拥有所有需要的压榨机。"
		""
		"如果找不到陨石，你可以制作一个&c陨石罗盘&f来指引你找到陨石。"
	]
	quest.449652FB57155835.quest_subtitle: "寻找陨石 (Find the Meteorites)"
	quest.449652FB57155835.title: "陨石"
	quest.4BD84369B1A67780.quest_desc: ["弑神：使用剑击杀阿尔宙斯，100%掉落。"]
	quest.4BD84369B1A67780.title: "杀死神明"
	quest.50F8B11EB1197810.quest_desc: [
		"刻写器和充电器可以接受RF/FE能量，但AE2使用名为AE的独立电力系统。"
		""
		"将RF/FE能量接入能量接收器，以2:1的比例转换RF/FE，也可直接接入ME控制器。"
	]
	quest.531EFE286CC7D077.quest_desc: ["制作一个快速球、一个等级球、一个诱饵球、一个沉重球、一个爱心球、一个友谊球和一个月亮球"]
	quest.531EFE286CC7D077.title: "制作所有 Apricorn 球"
	quest.56A39F86EF2E6FB2.quest_desc: ["To connect the vast majority of your ME network together, you will need some cable. &eME Glass Cable&f is the first and most basic kind of cable, and you'll be making this all throughout as the first step towards crafting the other kinds of cable.\\n\\nBoth glass cables and their &ecovered&f counterpart can carry up to 8 channels along a single section of cabling. Unlike glass cables, covered cables can subsequently be crafted into &edense&f covered cables, capable of carrying up to 32 channels. However, most 'multipart' devices such as buses and terminals cannot be directly attached to dense cables, requiring normal-width cables to form a connection instead.\\n\\nAll cables can also be crafted with dye to colour them. Uncoloured ('Fluix') cables can connect to any other colour of cable, but otherwise differently-coloured cables will never connect to one another."]
	quest.56A39F86EF2E6FB2.title: "电缆"
	quest.57349D1DEC37DFD6.quest_desc: [
		"欢迎来到 &l&3Applied Energistics 2"
		""
