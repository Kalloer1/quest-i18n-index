			}]
			title: "把鹅卵石都挖出来吧"
			x: -7.0d
			y: 0.0d
		}
		{
			dependencies: ["5D15FE6243A58273"]
			description: ["每个庞大的地下工厂都始于几块散落的石头。将这四个鹅卵石在物品栏中合并，形成一块坚固的鹅卵石块。这虽是粗活，却能为你提供建造基地所需的基础材料。"]
			id: "25A79BDB429E9C1B"
