	quests: [
		{
			description: ["你发现自己身处一个无尽的石头世界。为了生存和繁荣，你必须掌握工厂的艺术，夺回地下深处，并解锁隐藏在表面之下的秘密。从收集资源、建造自动化系统和在黑暗中开辟自己的传奇开始。你的旅程由此开始。"]
			icon: "immersiveengineering:light_bulb"
			id: "5EE94712191853CB"
			rewards: [{
				id: "553C38AEE2586DCD"
				type: "xp_levels"
				xp_levels: 15
			}]
			subtitle: "欢迎来到洞穴工厂 -重制版-"
			tasks: [{
				id: "349C1221FCD5E921"
				type: "checkmark"
			}]
			title: "欢迎"
			x: -8.5d
			y: 0.0d
		}
		{
			dependencies: ["5EE94712191853CB"]
			description: ["徒手收集初始资源。 &2潜行并用空手右键点击任何实心石块&r来采集小碎石。收集它们来开始制作第一批鹅卵石方块。"]
			id: "5D15FE6243A58273"
			rewards: [{
				id: "7692A6F09A37B573"
