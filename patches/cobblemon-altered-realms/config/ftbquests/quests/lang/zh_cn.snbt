	quest.1375E64578CCEE1B.title: "已注册阿罗拉地区的10%"
	quest.138B9B78764567CF.title: "卡洛斯地区"
	quest.13D6F4BE44D881D6.title: "捕捉/获得关东地区的超能力宝可梦"
