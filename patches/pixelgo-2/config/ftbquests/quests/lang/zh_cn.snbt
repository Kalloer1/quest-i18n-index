	quest.781B1B9C4BE3BE55.quest_desc: ["{quest.minions.description.16}"]
	quest.781B1B9C4BE3BE55.title: "{quest.minions.title.17}"
	quest.78B323245FFEC53B.quest_desc: [
		"&7Infuser 是 &bMekanism&7 的第一台真正机器，也是通往所有其他机器的门户。它将物品和 &n化学物质&r&7 结合，产出更优质的物品。"
		""
		"&6&l为什么这很重要&r"
		"&7它将像素兽维生素转化为&f“加努力值”&7和&f“加个体值”&7物品——&6PixelGO&7效果球的核心。红石注入加努力值，钻石注入加个体值。"
		""
		"&e&l提示：&r &7给它喂食&c红石&7来填充化学罐。一个红石块相当于十个红石粉。"
	]
	quest.78B323245FFEC53B.quest_subtitle: "&7Mekanism starts here, and so do the balls"
	quest.78B323245FFEC53B.title: "&b&l冶金注入器 (The Metallurgic Infuser)</c2></c1>"
	quest.78BCB91742B6B5F4.quest_desc: [
		"&7&6PixelGO Minions&7 模组为农具和矿具添加了 &f11 种附魔&7。它们都无法通过附魔台获得，也无法购买：必须用你的仆从堆积的资源来 &n建造&r&7 它们。"
		""
		"&6&l三个等级&r</c2></c1>"
		"&7- &a高级工作台&7 (5x5) — 两种常见的书。"
		"&7- &b精英工作台&7 (7x7) — 四本稀有书籍。"
		"&7- &d精英工作台 + 附魔秘银&7 — 五种最稀有的。"
		""
		"&e&l提示：&r &7一个附魔物品 = &f160基础资源&7。在开启配方前，先让仆从们用正确的资源&n&r&7运作起来。"
	]
	quest.78BCB91742B6B5F4.quest_subtitle: "&7Eleven enchantments the vanilla table will never give you"
	quest.78BCB91742B6B5F4.title: "&6&l随从魔导书 (The Minion Grimoire)</c2></c1>"
	quest.78C1271D0678127F.quest_desc: ["{quest.kanto.description.2}"]
	quest.78C25F5F1EFC72E1.quest_subtitle: "&7捕捉 &f&l50&r&7 只岩石属性的宝可梦"
	quest.78C25F5F1EFC72E1.title: "&e&l岩石收集者"
	quest.7912927FF29427F1.quest_desc: [
		"&7捕获的宝可梦有&f31的速度个体值&7——最大值。个体值无法通过训练降低或提升，除非使用超级训练，所以这代表一项属性的永久完美。"
		""
		"&7&f添加 IV 速度&7需要消耗 &f4 个碳素&7和 &b钻石注入&7。每批三个盖子需要两个。"
		""
		"&e&l提示：&r &7用不同的IV球反复捕捉同一种生物并繁殖后代——&f命运之结&7会遗传五个IV值。"
	]
	quest.7912927FF29427F1.quest_subtitle: "&7完美的31，保证成功"
	quest.7912927FF29427F1.title: "&e&lIV 速度球"
	quest.7931C133B2FED77A.quest_desc: ["{quest.minions.description.3}"]
	quest.7931C133B2FED77A.title: "{quest.minions.title.4}"
	quest.7957CFD388B13419.quest_desc: [
		"&7首次加入时，你可以选择一个&a&l训练师&r&7外观和背景。这就是起源界面，而且它&n&l完全不影响游戏&r&7——没有技能、属性、惩罚，也没有错误答案。"
		""
		"&f&lO &8- &7再仔细看看你的选择吧"
		""
		"&e&l趁着我们正在聊钥匙的话题"
		"&f&lK &8- &7the &a&lskill tree&r&7 &8- &7and the &5&lProjectE&r&7 tablet, much later, if you wear one"
		"&f&lN &8- &7the &b&lPokeNav&r&7, 一旦你拥有一个"
		"&f&lB &8- &7打开你的&6&lSophisticated Backpack&r&7，前提是你已经拥有一个"
		"&f&l中键点击 &8- &7随时随地整理任何物品栏"
		"&f&l[ &7和 &f&l] &8- &7将整个物品栏移入或移出容器"
		""
		"&7&o选一个你喜欢的样子，然后回到岛上。"
	]
	quest.7957CFD388B13419.quest_subtitle: "&7还有一些其他的钥匙碎片"
