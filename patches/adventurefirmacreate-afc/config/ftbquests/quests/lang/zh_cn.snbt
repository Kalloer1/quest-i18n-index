# AI 初翻，未人工校对
{
	chapter.15B72FB61FF1FB46.subtitle: "青铜、铁和钢"
	chapter.15B72FB61FF1FB46.title: "TFC金属加工"
	chapter.1F2759872355BB36.subtitle: "飞机、火车和汽车"
	chapter.1F2759872355BB36.title: "创造：交通运输系统 (Transportation)"
	chapter.7E988D317268FEE5.subtitle: "钢铁、石油和电力"
	chapter.7E988D317268FEE5.title: "工厂必须不断发展壮大"
	chapter.30E758BE1B4009ED.subtitle: "真实的电压，真实的电流，真实的电阻"
	chapter.30E758BE1B4009ED.title: "创建：电力网络 (Power Grid)"
	chapter.5449CE858435805F.subtitle: "矿石加工，却没有自己的电网"
	chapter.5449CE858435805F.title: "Mekanism 和 Immersive Engineering"
	chapter.37EDE754D75D5324.subtitle: "第二个熔炉，第二个矿井"
	chapter.37EDE754D75D5324.title: "创建冶金学（Metallurgy）"
	chapter.4579E96491254291.subtitle: "从松散的岩石到第一件金属工具"
	chapter.4579E96491254291.title: "TFC 基础知识"
	chapter.5EB38D59CA591B1A.subtitle: "第一步：初始步骤"
	chapter.5EB38D59CA591B1A.title: "入门指南"
	chapter.640FC998E680F1AC.subtitle: "旋转的力量，锻造而非合成"
	chapter.640FC998E680F1AC.title: "创造基础模组 (Create Fundamentals)"
	chapter_group.0A19049E2EFBBCDC.title: "工业发展"
	chapter_group.295D59696748C777.title: "冒险"
	chapter_group.757B2A0ABFF0DC73.title: "创造与科技 (Create and Technology)"
	chapter_group.7ECFBA7A9FB006E2.title: "生存模式"
	quest.00337C3C1BFC8CC0.quest_desc: ["你有了石头和木棍——制作第一件手制工具的两种材料。去 &aTFC Basics&r 里实际制作吧。"]
	quest.00337C3C1BFC8CC0.subtitle: "准备好学习TFC基础了吗"
	quest.00337C3C1BFC8CC0.title: "继续前进"
	quest.015B09758586B949.quest_desc: [
		"矿石脉系图集（一个箱子、一个紫水晶、一张地图和一本书）会将你采集过的脉系记录在可分享的地图上。"
		""
		"旧版 Ore Vein Finder 已无法合成，取而代之的是 Prospector's Radar（末影之眼、紫水晶碎片、红石和两根木棍）。右键打开实时雷达，显示16个区块半径内的所有矿脉、当前区块及最近矿脉的距离；潜行右键可切换追踪的矿脉类型。该雷达有3秒冷却时间，需定期检查，而非持续开启。"
	]
	quest.015B09758586B949.subtitle: "在挖掘之前先找到矿脉再说"
	quest.015B09758586B949.title: "侦察工具"
	quest.017EB16EA61D12AC.quest_desc: ["将黄铜板和电子管应用于普通钻孔轴承，即可得到 Simurail 的升级版，前提是同时加载了越野和 Simurail 附加包。"]
	quest.017EB16EA61D12AC.subtitle: "越野与轨道在此交汇"
	quest.017EB16EA61D12AC.title: "黄铜钻孔轴承"
	quest.01D1EB709BDE8400.quest_desc: [
		"用5个石块围住7-8层的木炭堆并点燃，将其转化为木炭熔炉。它需要一条清晰的视线通往天空——正上方，或周围8个方块之一——以吸入空气。"
		""
		"顶部的五个槽位直接加热物品；侧面的槽位放置容器和模具，内部金属熔化时会自动填充。这使得坩埚可用——仅靠火坑是无法达到足够高温的。"
	]
	quest.01D1EB709BDE8400.subtitle: "一个合适的热源"
	quest.01D1EB709BDE8400.title: "木炭锻造炉"
	quest.04482B9865564E09.quest_desc: ["齿轮、工业铁块和一块黑曜石板。可自动耦合模拟火车车厢，无需依赖Create的矿车手动耦合。"]
	quest.04482B9865564E09.subtitle: "自动化的耦合装置，自动化"
	quest.04482B9865564E09.title: "自动连接器 (The Automatic Coupler)"
	quest.04573090C36BFB97.quest_desc: [
		"用下界岩和四块铁板制作一个空烈焰炉。单独使用时它只是个装饰品——右键点击活烈焰来捕获一只，或者直接从下界堡垒的生成器里拿一个已点燃的炉子，这样它才能用于工业制热。"
		""
		"喂食普通易燃物可使其保持“点燃”（即“加热”）状态，这是本书中多台机器所需的。而烈焰蛋糕能将其推进到“沸腾”（即“过热”）状态：在加热的压机和盆中混合一个鸡蛋、糖和灰烬粉（用磨石将下界岩磨成），然后用250mB的岩浆填充。这两种状态都可以通过部署器或机械臂自动喂食。"
	]
	quest.04573090C36BFB97.subtitle: "一个拥有自己思想的发热源"
	quest.04573090C36BFB97.title: "烈焰人燃烧器"
	quest.05366E9B5105E12D.quest_desc: [
		"没有工作台。生存模式从&6打制石器&r开始——徒手将散落的岩石打造成你的第一件工具。"
		""
		"饥饿被分为五个营养类别，而非单一进度条，热量则影响烹饪、锻造和金属加工。岩层决定附近的矿石，真实日历驱动季节变化。"
		""
		"下一章，&aTFC Basics&r，将逐步讲解所有这些内容。"
	]
	quest.05366E9B5105E12D.subtitle: "这里没有合成台"
	quest.05366E9B5105E12D.title: "这是一个 TerraFirmaCraft 整合包"
	quest.069C537B7B4C7CFA.quest_desc: ["你已经掌握了TFC的核心生存循环：石器、火、第一金属、农业和动物。从这里开始，TFC本身的进阶将进入青铜、铁和钢——但本书的下一章将转向使此整合包与众不同的内容，以及建立在TFC之上的技术。"]
	quest.069C537B7B4C7CFA.subtitle: "核心生存，已完成"
	quest.069C537B7B4C7CFA.title: "继续前进"
	quest.0798108559067F59.quest_desc: [
		"你的营养状况不再用单一饥饿条表示，而是分为水果、蔬菜、谷物、蛋白质和乳制品五个类别。保持所有类别充足会随时间提升你的最大生命值；让它们过低则会降低生命值。"
		""
		"食物也有保质期，放太久会腐烂。用密封容器或大容器储存可使其保质期延长约一倍，而加盐或腌制则可延长更久。"
	]
	quest.0798108559067F59.subtitle: "五个分类，而不是一个进度条"
	quest.0798108559067F59.title: "食物与营养学 (Food and Nutrition)"
	quest.079B96AEE58F17CE.quest_desc: ["轨道和道路都遵循本章早些时候的气球所采用的同一底层模拟。将这三种中的任意两种结合，物理引擎都分不清你正在驾驶哪一种。"]
	quest.079B96AEE58F17CE.subtitle: "所有移动方式，同时开启"
	quest.079B96AEE58F17CE.title: "轨道和道路准备就绪"
	quest.0801144C8E041FB3.quest_desc: [
		"齿轮、铜外壳（将铜锭应用到去皮的原木上，与安山岩外壳相同）和坚固搅拌桨（安山岩合金和坚固搅拌桨）组合成铸造搅拌机。"
		""
		"与带玻璃盖的熔炉配套使用时，它的作用就像机械搅拌机对盆的作用一样——只不过这里运行的是真实合金的配方，通过精确比例混合，而非在坩埚中手工混合。"
	]
	quest.0801144C8E041FB3.subtitle: "没有熔炉的合金冶炼"
	quest.0801144C8E041FB3.title: "熔炉搅拌机"
	quest.0AF228B784C923B7.quest_desc: [
		"准备好轨道、外壳、控制器和车站后，你就可以建造一列真正的火车了：打开车站的UI并切换到组装模式，然后将火车外壳直接用于轨道上以创建转向架——再次点击轨道可在转向架设计之间切换。使用强力胶水粘合其余方块，将一套火车控制器放置在结构上的某处，并从车站UI中确认组装。"
		""
		"扳手可将已组装好的火车移至附近的轨道。储存在已组装的箱子或桶中的燃料能使其加速——储存在Vault中的燃料不会被消耗。"
	]
	quest.0AF228B784C923B7.subtitle: "从方块到一列真正的火车"
	quest.0AF228B784C923B7.title: "组装一列火车"
	quest.0BFEF82B9646ED4B.quest_desc: ["转向架、耦合器和渡桥——足以组装一辆完全物理模拟的火车。Simurail 仍处于早期阶段，可能会有粗糙之处，但核心组件都已具备。"]
	quest.0BFEF82B9646ED4B.subtitle: "火车，模拟的方式"
	quest.0BFEF82B9646ED4B.title: "火车已准备就绪"
	quest.0C47C2CF43D07D11.quest_desc: [
		"找到一个未经破坏的岩浆岩原矿（花岗岩、闪长岩、辉长岩、玄武岩、流纹岩、安山岩或粗面岩），用任意锤子右键点击其暴露的顶面。它会立即变成砧台——无需任何合成配方。"
		""
		"岩石砧是0级，最弱的等级：它只能焊接I级锭，完全无法处理更高级的金属。它只是一个垫脚石，但能让你开始锻造。"
	]
	quest.0C47C2CF43D07D11.subtitle: "只需一锤即可将其击碎"
	quest.0C47C2CF43D07D11.title: "铁砧（The Anvil）"
	quest.0D235FE1645713CF.quest_desc: [
		"陀螺螺旋桨轴承和普通轴承一样，但它会不断调整桨叶角度以朝上——这正是直升机式建筑所需的，因为普通的螺旋桨轴承无法自行保持该方向。"
		""
		"向下安装时，同样的自稳机制会稳定重心偏高的结构。红石信号可将累积的倾斜重置为零。"
	]
	quest.0D235FE1645713CF.subtitle: "一个能自动矫正方向的螺旋桨"
	quest.0D235FE1645713CF.title: "陀螺式螺旋桨轴承"
	quest.0EAE0060AFBFB335.quest_desc: [
		"在坩埚中精确混合熔化的金属，超出范围只会得到无用的混合物，而非合金。"
		""
		"&6青铜&r - 88-92% 铜, 8-12% 锡"
		"&6铋青铜&r - 50-65% 铜, 20-30% 锌, 10-20% 铋"
		"&6黑青铜&r - 50-70% 铜, 10-25% 银, 10-25% 金"
		""
		"这三种金属在砧上都能升级到 Tier II——比铜大跨一步，也是升到铁之前的最后一站。"
	]
	quest.0EAE0060AFBFB335.subtitle: "真正的比例关系"
	quest.0EAE0060AFBFB335.title: "青铜与合金"
	quest.102ED576775F12ED.quest_desc: [
		"TFC 的锻造台和铁砧让你亲手打造了全套金属工具。创造机器来代替你完成同样的工作——由水轮驱动的旋转动力，通过传动轴和齿轮传递，输送到压机、搅拌机和磨坊中。"
		""
		"本整合包将Create的材料通过TFC自身的系统进行加工。安山合金像真金属一样被熔炼和铸造，而Create的一些机器则需要TFC的锻造产品——锻铁双锭、双层板——作为原料，而非Create的普通原版材料。"
	]
	quest.102ED576775F12ED.subtitle: "旋转功能，终于来了"
	quest.102ED576775F12ED.title: "欢迎来到创造模式"
	quest.1148A71DD1F74CCB.quest_desc: ["木板、齿轮箱和工业铁块。连接到前方的方块上，反转输入的旋转并以四分之一速度运转——与储物容器和岩石切割轮配合使用时，整个装置会变成一个移动钻头。"]
	quest.1148A71DD1F74CCB.subtitle: "一辆地面载具的钻头轴承"
	quest.1148A71DD1F74CCB.title: "钻孔轴承 (The Borehead Bearing)"
	quest.13A79E259CBF0CFC.quest_desc: [
		"选择一个轨道，然后在附近放置一个信号机将其分成多个区段——同一时间只允许一列非玩家控制的火车进入一个区段，并且计划列车绝不会穿过朝向相反方向的信号机，除非添加第二个反向信号机。"
		""
		"红石信号可以强制一个红色，红色信号会输出自己的比较器输出。扳手可将其切换到黄铜级的第二种模式，该模式还能阻止列车，如果列车无法立即通过下一段轨道——这对于防止排队列车进入繁忙的交汇处很有用。"
	]
	quest.13A79E259CBF0CFC.subtitle: "防止火车相撞的任务书文本"
	quest.13A79E259CBF0CFC.title: "轨道信号机"
	quest.1407308FEBE8B75C.quest_desc: ["这里的木棍不是用木板制作的——在树下寻找，或用小树枝合成。"]
	quest.1407308FEBE8B75C.subtitle: "并非由木板制作而成"
	quest.1407308FEBE8B75C.title: "找到一根木棍"
	quest.14BA5E52341B0912.quest_desc: ["一种无需旋转力即可运行的告示牌替代方案。书面剪贴板可提供静态文本；显示链接（来自 Create 的基本包网络）则用于驱动动态文本。每行文字可单独染色，徒手点击一行可将其重置。"]
	quest.14BA5E52341B0912.subtitle: "一个可以自我更新的告示牌"
	quest.14BA5E52341B0912.title: "显示板 The Display Board"
	quest.16685C33CA1677A2.quest_desc: [
		"物品宝库和发射器（避雷针、三块铜板和红石）可以组成一个库存链接。放置一个会创建一个全新的库存网络——在放置第二个链接前，右键点击现有的链接，即可加入该网络，而不是创建一个新的网络。"
		""
		"与该网络相连的每个包装器都会使其附带的物品栏在网络上任何其他地方可见且可请求。信号本身范围无限；但它生成的包裹仍需被物理携带、运送或以其他方式移动到所需之处。"
	]
	quest.16685C33CA1677A2.subtitle: "一个网络，上面有每个打包器"
	quest.16685C33CA1677A2.title: "物品链接器"
	quest.1728460D33D78EA7.quest_desc: [
		"AdventureFirmaCreate 是一个基于 TerraFirmaCraft 的整合包：写实、节奏较慢的生存模式，叠加了部分机械自动化和冒险内容。"
		""
		"此任务列表按章节顺序，从TFC的生存基础开始。"
	]
	quest.1728460D33D78EA7.subtitle: "请先阅读以下内容"
	quest.1728460D33D78EA7.title: "欢迎来到 AdventureFirmaCreate！"
	quest.173DF4E7749FBEC4.quest_desc: [
		"所需的 Whisk 也无法合成 - 在 Tier III 砧上，使用锻造炉建造所用的锻铁双层板，按照界面顶部的规则进行锻造即可。"
		""
		"将搅拌棒与齿轮和安山岩外壳组合，即可得到搅拌机。将其置于水槽上方，可自动化所有无定形配方，以及一些 Create 独有的配方——部分配方需要下方的烈焰燃烧器提供热量，与压模机相同。"
	]
	quest.173DF4E7749FBEC4.subtitle: "Tier III 铁砧的最后一个任务"
	quest.173DF4E7749FBEC4.title: "机械搅拌机"
	quest.1C0ACFE74E11A391.quest_desc: [
		"一个转轴加一个木板可制作齿轮；一个转轴加两个木板可制作大齿轮。两者均可直接放置在转轴上，或与另一个齿轮啮合以横向传递旋转。"
		""
		"两个相同大小的齿轮以相反方向同速旋转。将小齿轮与大齿轮啮合，小齿轮的转速会加倍——这就是你的第一个真实齿轮比。"
	]
	quest.1C0ACFE74E11A391.subtitle: "重定向与齿轮旋转"
	quest.1C0ACFE74E11A391.title: "齿轮组件"
	quest.1DF7CAD92FC96ED4.quest_desc: ["用链条将普通矿车连接起来，使其作为一个整体移动——这是在火车装置出现前，一次性运行多辆矿车的简单方法，也是 Simurail 连接器本身的基础。"]
	quest.1DF7CAD92FC96ED4.subtitle: "古老的矿车连接方式"
	quest.1DF7CAD92FC96ED4.title: "矿车连接器"
	quest.1F0A1733E7236B46.quest_desc: [
		"挖一个深1格的洞，用“V”键往里扔最多4个物品。用8个稻草（或2个干草块）盖住，再堆上8个原木，点燃结构即可——把火把扔上去和用打火石效果一样。"
		""
		"坑窑燃烧约6分钟，可达1400°C（白炽状态），足以将未烧制的黏土烧成陶瓷器皿，或在无需火坑的情况下熔炼你的第一批矿石。"
	]
	quest.1F0A1733E7236B46.subtitle: "不需要火坑"
	quest.1F0A1733E7236B46.title: "熔炉窑炉"
	quest.200F0B08D0CD5775.quest_desc: [
		"用3个平滑石和3个其他石头（已塑形，顶部光滑）制作底座，再用3个石头和1根木棍制作手石。放置底座，然后用手石右键点击顶部即可安装。"
		""
		"右键手石加载物品，然后用旁边的把手转动它——或者Shift+点击底座，在研磨完成后获取结果。这就是获取粉末（包括纹银粉）、染料和面粉的方法。如果手动转动太累，以后还可以将其连接到机械动力网络。"
	]
	quest.200F0B08D0CD5775.subtitle: "手工或机械的研磨方式，任君选择"
	quest.200F0B08D0CD5775.title: "石磨（The Quern）"
	quest.20C31BA156857A1C.quest_desc: ["垂直放置的两个安山合金可制作成8个传动轴。单独的传动轴没有作用，只有连接到能产生或传递旋转力的装置上时才会转动，并将旋转力直接传递到另一端。"]
	quest.20C31BA156857A1C.subtitle: "沿直线进行旋转移动"
	quest.20C31BA156857A1C.title: "竖井"
	quest.20EB31C3383FC60A.quest_desc: ["手握扳手，头戴护目镜，搅拌机运转着——在熔炉和第一台机器之间，早期 Create 中已没什么能阻挡你前进的了。"]
	quest.20EB31C3383FC60A.subtitle: "已配置、测量和混合中"
	quest.20EB31C3383FC60A.title: "装备升级"
	quest.2182667976A60E39.quest_desc: [
		"收集至少90mB的铜矿石（天然铜、孔雀石或四方辉石——每块小矿石9mB，整块矿石更多），并将其放入小容器中。在土窑或火坑中加热容器，直到矿石完全熔化。"
		""
		"将熔化的金属倒入烧制模具中，铸造你的第一件工具。铜质较软，比后来的金属磨损更快，但它能开启真正的铁砧工艺。"
	]
	quest.2182667976A60E39.subtitle: "TFC 真正的第一种金属"
	quest.2182667976A60E39.title: "熔炼你的第一块铜"
	quest.21938355214FA1BC.quest_desc: [
		"将锻铁双锭锻造成板材是 Tier III 操作——你的 Tier II 青铜砧可以焊接锻铁，但不能锻造。你需要真正的工具。"
		""
		"像之前一样焊接7个锻铁双锭，按同样的3x3环形排列，你就得到了一个Tier III砧。这也是能让你把那些铁板锻造成高炉所需的双层铁板的砧。"
	]
	quest.21938355214FA1BC.subtitle: "Tier III - 现在你可以使用铁了"
	quest.21938355214FA1BC.title: "锻铁砧（The Wrought Iron Anvil）"
	quest.22487ED0E224B271.quest_desc: [
		"铁块和铁锭可以制作成铁钻头——这是装在采样钻或钻机上才能使用的钻头。钻石钻头（钻石块、宝石和铁钻头本身）可以进一步升级，而锻造台则能将钻石钻头升级为下界合金钻头。"
		""
		"你需要哪种取决于你的目标。铁钻能开采普通矿脉——TFC 的大多数金属和实用矿物。不常见和稀有矿脉（如镍、银、金、宝石，以及 TFCM 的稀有金属）至少需要钻石钻。而本整合包中唯一史诗级矿脉的密提尔，则需要下界合金钻才能开采。"
	]
	quest.22487ED0E224B271.subtitle: "你将加载到每个钻井架里的东西"
	quest.22487ED0E224B271.title: "铁质钻头"
	quest.232F6B7B1E9C80CB.quest_desc: [
		"钨矿的冶炼方式与其他TFC矿石完全相同——开采、加热至熔点以上，然后正常铸造即可。Create Metallurgy模组也将Necromium和Void Steel列为合金，但本整合包中没有任何可用的固态形式——纯属死胡同，不值得追求。"
		""
		"Obdurium 是唯一例外。在超高温熔炉搅拌机中混合 60mB 熔化的钨和安山合金，可获得 150mB 熔化的 Obdurium，然后在铸造台将其铸成锭或板——这是本模组独有的、真正可使用的顶级金属。"
	]
	quest.232F6B7B1E9C80CB.subtitle: "制造冶金学独有的顶级金属"
	quest.232F6B7B1E9C80CB.title: "钨和奥布杜里乌姆"
	quest.2397E2AD79542E2B.quest_desc: [
		"在熔炉和钻床之间，TFC的锻造炉不再是把矿石变成成品零件的唯一途径——它只是你最初开始用的那一种。"
		""
		"接下来，&a创造：航空学&r将旋转动力带入天空。"
	]
	quest.2397E2AD79542E2B.subtitle: "现在有两种方法可以获得你的金属了"
	quest.2397E2AD79542E2B.title: "继续前进"
	quest.25892B48F311E99B.quest_desc: [
		"共有六种石制工具头，每种都由独特的图案打制而成。将任意工具头与木棍或树枝在合成网格中组合即可制成工具，无需其他材料。"
		""
		"&6刀&r - 可收割稻草和植物纤维"
		"&6斧&r - 可以砍倒整棵树，包括树干和树叶"
		"&6铲子&r - 挖掘泥土，平整道路"
		"&6锄头&r - 翻耕农田，剥取树叶"
		"&6锤子&r - 一种弱武器，但却是你用来敲打铁砧的工具"
		"&6标枪&r - 唯一为真实战斗打造的石制武器"
		""
		"耐用性取决于岩石：沉积岩和变质岩最弱，侵入性火成岩较好，而喷出性火成岩（玄武岩、流纹岩、安山岩、粗面岩）能打造出最坚固的石制工具。"
	]
	quest.25892B48F311E99B.subtitle: "六个头颅，一个流程"
	quest.25892B48F311E99B.title: "石制工具"
	quest.258B6E4E1ECA97B7.quest_desc: ["升力、推力，还有自稳装置——一个模拟装置要自主飞行，这些就够了。剩下的就是建造机身了。"]
	quest.258B6E4E1ECA97B7.subtitle: "准备好起飞了"
	quest.258B6E4E1ECA97B7.title: "你的第一艘空中飞船"
	quest.269B0406F099EBBE.quest_desc: ["Simurail 是一个实验性的早期 alpha 附加包，它将火车装置（Train Contraption）的普通转向架替换为 Aeronautics 所使用的物理引擎所模拟的转向架。无动力物理转向架（Unpowered Physics Bogie）是基础部件——由火车外壳（Train Casing）、玫瑰石英（Rose Quartz）、一根轴（Shaft）和钢板组成，由于本整合包自身的钢锭符合其检测的标签，因此此处使用钢锭建造。"]
	quest.269B0406F099EBBE.subtitle: "一个经过物理模拟的车轮组"
	quest.269B0406F099EBBE.title: "无动力物理轨道车"
	quest.271D4A95A007C35D.quest_desc: [
		"用耐火粘土烧制一个未烧制的坩埚，然后在坑窑或木炭锻造炉中将其烧制。将其置于点燃的木炭锻造炉上，可一次性熔炼最多9个物品，并显示混合物中每种金属的确切百分比。"
		""
		"放置在上面的模具和容器也会缓慢地将其倒入其中，即使被打破并拾起，它也能保持熔化的内容物——非常适合将半成品合金带到别处。"
	]
	quest.271D4A95A007C35D.subtitle: "精密合金冶炼"
	quest.271D4A95A007C35D.title: "The Crucible"
	quest.280C570E6F379BAB.quest_desc: [
		"地表的小矿石块本身只含有约10mB的金属，但找到一个就预示着附近地下深处可能埋藏着真正的矿脉。"
		""
		"矿石只会出现在特定类型的岩石中——有些金属与火成岩有关，有些则与沉积岩或变质岩层有关——因此学会辨认脚下的石头能帮你省去大量盲目挖掘的功夫。"
	]
	quest.280C570E6F379BAB.subtitle: "阅读地面信息"
	quest.280C570E6F379BAB.title: "矿物勘探与采集指南"
	quest.292780CF7E8DCFFE.quest_desc: [
		"四个齿轮围着一个安山岩外壳就能组成一个齿轮箱——一个能将旋转方向拐个弯的单个方块，比堆叠多个齿轮实现相同效果更实用。"
		""
		"直接通过的管道会反向输出；拐角通过的管道会镜像输出。在建筑周围布线时，备上几个会很有用。"
	]
	quest.292780CF7E8DCFFE.subtitle: "转角处不再杂乱无章"
	quest.292780CF7E8DCFFE.title: "齿轮箱"
	quest.2A1BD732EDE3E72B.quest_desc: [
		"由8个青铜双层板堆叠而成，每层可容纳16个物品，三层共48个。爬到顶部投入铁矿石和木炭，然后点燃并等待12分钟。"
		""
		"出炉的只能熔成铸铁，而非锻铁——必须先在铁砧上锻成精铸锭，再锻成锻铁锭。要经过两道完整工序，没有捷径——至少需要二级铁砧才能完成。"
	]
	quest.2A1BD732EDE3E72B.subtitle: "锻铁，用硬的方式获取"
	quest.2A1BD732EDE3E72B.title: "The Bloomery"
	quest.2C2F91E17A717C12.quest_desc: [
		"七个安山合金可以制作一个铸造台。它能将熔炉中的熔融金属直接铸造成成品——但使用的是 Productive Metalworks 的锭/金块/板/棒/齿轮模具，而非 Create Metallurgy 的石墨模具，后者在本整合包中被完全禁用。"
		""
		"铸造盆与锻造台类似，可将液态金属批量铸造成成品部件，是替代锻造台的完整方案。"
	]
	quest.2C2F91E17A717C12.subtitle: "锭、板和齿轮，无需 anvils 即可锻造"
	quest.2C2F91E17A717C12.title: "铸造台"
	quest.2C60FC8BC3FF74D9.quest_desc: ["方块式土豆炮：弹药与手持版相同，但可通过旋转力蓄能，并由红石信号在蓄能完毕后发射。持续按住红石信号即可连续发射，并且可以通过自动化方式装填，而不仅仅是手动装填。"]
	quest.2C60FC8BC3FF74D9.subtitle: "土豆大炮，已安装完毕"
	quest.2C60FC8BC3FF74D9.title: "骑乘马铃薯加农炮"
	quest.32FE41E5C15FEC91.quest_desc: ["皮革缝制在工程师护目镜上。功能完全相同——它会增强你的HUD，显示你所查看的任何动能或流体组件的压力、容量和内容读数——只是风格更适合驾驶舱而非工作台。"]
	quest.32FE41E5C15FEC91.subtitle: "同样的护目镜，换了个样式"
	quest.32FE41E5C15FEC91.title: "飞行员护目镜"
	quest.33605436C948E7C5.quest_desc: [
		"围绕一个装有8个锻铁双层板的坩埚建造，顶部是加固耐火砖烟囱——每层8块，最多5层，每层可增加4个矿石容量。"
		""
		"将等量的铁矿石和助熔剂与木炭一起从烟囱投入，在侧面放置一个风口，然后点燃。连接到任意一侧的鼓风机能使其温度超过木炭的常规上限——足以将矿石直接熔化成生铁，滴入下方的坩埚中。"
	]
	quest.33605436C948E7C5.subtitle: "钢铁之旅由此开始"
	quest.33605436C948E7C5.title: "高炉（The Blast Furnace）"
	quest.3414EFD029CB0698.quest_desc: [
		"将硼砂、石灰石、白云石、粉笔或大理石放入磨石中，转动手柄即可生产助熔剂粉——贝壳和贝类残骸也行。"
		""
		"没有它，你无法在铁砧上焊接两块金属，高炉也无法运行。务必随时备有一组。"
	]
	quest.3414EFD029CB0698.subtitle: "焊接所需物品"
	quest.3414EFD029CB0698.title: "Flux"
	quest.354AFF146A8BD372.quest_desc: [
		"这个不是在合成台里制作的。手持安山合金，右键任何TFC去皮原木或去皮木材——所有种类都行——就能用外壳包裹住它。"
		""
		"外壳是大多数创造模式机器中的材料——齿轮箱、磨石、机械压机和机械搅拌机都需要至少一个。"
	]
	quest.354AFF146A8BD372.subtitle: "已应用，未制作"
	quest.354AFF146A8BD372.title: "安山岩外壳"
	quest.3902FE60DBE87CEB.quest_desc: ["几乎所有地方，地表都散落着松散的岩石。捡起一块吧——任何类型都可以。"]
	quest.3902FE60DBE87CEB.subtitle: "你需要几个这样的东西"
	quest.3902FE60DBE87CEB.title: "捡起一块石头"
	quest.3922605C9E2B98F2.quest_desc: [
		"一个安山合金和TFC的干海带可以制作成2个安山漏斗。正常放置的漏斗会将物品从所连接的物品栏中取出；潜行放置的漏斗则会将其推入——用扳手可以翻转方向。"
		""
		"红石信号会完全关闭漏斗。但它无法在两个封闭的箱子之间或空中直接移动物品，需要搭配传送带或滑道使用。"
	]
	quest.3922605C9E2B98F2.subtitle: "提取、插入、自动化"
	quest.3922605C9E2B98F2.title: "安山岩漏斗"
	quest.3ABD87425966CCEC.quest_desc: [
		"一个真正复杂的建造：黄铜板、电子管、精密机制、黄铜外壳、Create 自己的机械钻头（安山合金、安山外壳和一个铁锭——没什么新东西）和坚固薄片，全部排列在 3x3 的机械合成网格中。"
		""
		"放置它，装上钻头，并在顶部放置铜制背罐以运行。采样完成后，用矿石脉络图谱右键点击以记录其发现。"
	]
	quest.3ABD87425966CCEC.subtitle: "在投入之前先测试一下矿脉"
	quest.3ABD87425966CCEC.title: "样本钻头"
	quest.3B38FFAB634AEED7.quest_desc: ["同一理念下的方块版：旋转时产生推力，像陀螺推进器轴承一样向上倾斜，用扳手右键可反转推力。"]
	quest.3B38FFAB634AEED7.subtitle: "陀螺仪轴承，已装箱打包"
	quest.3B38FFAB634AEED7.title: "智能螺旋桨"
	quest.3BF8823019D9BEF8.quest_desc: ["一个发射器、一个石英宝石和一个火车外壳。可远程读取绑定物理转向架的位置和状态，是远程控制器发出的命令的对应部分。"]
	quest.3BF8823019D9BEF8.subtitle: "正在读取 bogie 的状态信息"
	quest.3BF8823019D9BEF8.title: "Bogie 探测器读取器"
	quest.3D1CD62F572EE098.quest_desc: ["安山岩外壳、铁板和弹簧（2个铁板和1个铁粒）可以制作轮轴——它为地面移动安装轮状物品，通过上方的动力制动所附车轮，并根据信号来源进行转向。"]
	quest.3D1CD62F572EE098.subtitle: "轮子实际附着的位置在哪里"
	quest.3D1CD62F572EE098.title: "轮式坐骑"
	quest.3DAB2E63E7003AB9.quest_desc: [
		"在3x3的网格中制作一个：顶部一排木材，中间一排皮革，底部一排木材（共6木材，3皮革）。将其朝向火坑或木炭锻造炉放置（低一格也可以），然后使用。"
		""
		"它会暂时提高设备的最高温度，但会消耗燃料的速度更快。只在真正需要额外热量时使用，不要养成默认习惯。"
	]
	quest.3DAB2E63E7003AB9.subtitle: "更多热量，更多燃料"
	quest.3DAB2E63E7003AB9.title: "风箱 (The Bellows)"
	quest.3E5262DD4D7BFFD4.quest_desc: [
		"Shift+右键点击原木以开始堆叠，然后将更多原木右键堆入其中。将木堆埋在泥土（或其他非易燃方块）下并点燃——经过15游戏小时后，它会变成木炭，一种比原木更热、更干净的燃料。"
		""
		"本章的所有装置都需要大量消耗它——木炭锻造炉、炼钢炉和冲天炉都需要，所以尽早囤积是值得的。"
	]
	quest.3E5262DD4D7BFFD4.subtitle: "被埋藏并被烧毁的遗迹"
	quest.3E5262DD4D7BFFD4.title: "制作木炭"
	quest.3FF0C57E8478029F.quest_desc: [
		"普通粘土在用于重要金属加工前会熔化。耐火粘土能承受高温——将石墨粉（用石磨研磨石墨矿石）与高岭土粉混合制成，而高岭土粉本身是通过加热高岭土以20%的产率获得的。"
		""
		"它与普通粘土的烧制方式相同，是制作坩埚、耐火砖（用于高炉）和比普通模具更耐用的耐火锭模具所必需的。"
	]
	quest.3FF0C57E8478029F.subtitle: "能够承受高温的黏土"
	quest.3FF0C57E8478029F.title: "火焰粘土"
	quest.4083D6FE9F1C293A.quest_desc: ["火或蒸汽，你现在有办法让气球升空了。这两种升力源都适用于相同的信封方块——选择适合你其他建筑的那一种。"]
	quest.4083D6FE9F1C293A.subtitle: "保持清醒的两种方法"
	quest.4083D6FE9F1C293A.title: "升降系统"
	quest.408C8829BC0702BF.quest_desc: [
		"你可以生成、传输和使用旋转动力——这是创造模式中一切的基础。后续章节会量化所有数据：每台机器的运行应力、每台发电机的容量，以及整个网络如何平衡。"
		""
		"不过，下一站是向上——&a创造：航空学&r，介绍了本整合包中用于移动和升空的装置。"
	]
	quest.408C8829BC0702BF.subtitle: "旋转仅仅是个开始而已"
	quest.408C8829BC0702BF.title: "继续前进"
	quest.41A1AD445A0D2907.quest_desc: [
		"本整合包中无合成配方 - 安山合金是真正的TFC合金。将安山岩（原矿或切块均可）在920°C下熔化，然后用坩埚将熔岩与锡或锌混合，温度需在此范围内："
		""
		"&6含锡&r - 89-91% 安山岩，9-11% 锡"
		"&6含锌&r - 89-91% 安山岩，9-11% 锌"
		""
		"将90mB的成品合金倒入陶瓷锭模中，即可铸造一个安山合金——与其他铸造一样存在开裂风险。几乎所有早期的Create方块都源自这一物品。"
	]
	quest.41A1AD445A0D2907.subtitle: "合金铸造，而非合成制作"
	quest.41A1AD445A0D2907.title: "安山岩合金"
	quest.42B4FE20E7244CCC.quest_desc: ["磨石用于研磨，压块机和搅拌机用于塑形和混合，传送带和漏斗用于在它们之间运输。这就是一个完整的小型生产线——用同样的几个部件，通过不同的排列组合，就能扩展出所有 Create 的建造内容。"]
	quest.42B4FE20E7244CCC.subtitle: "从头到尾，未经人工干预"
	quest.42B4FE20E7244CCC.title: "自动化处理系统"
	quest.454252DFF74FF895.quest_desc: ["一个发射器、玫瑰石英和火车外壳——也就是在《创造基础》中用于启动创造数据包网络的发射器。它能让物理火车远程驾驶或发车，而无需驾驶员坐在车上。"]
	quest.454252DFF74FF895.subtitle: "从远处驾驶而来"
	quest.454252DFF74FF895.title: "Bogie 远程控制器"
	quest.4578F4AA8D02D9BA.quest_desc: [
		"用动物喜欢的食物右键+Shift键可以提升与它的亲密度。动物越亲近你，能做的就越多——根据种类不同，可以繁殖、挤奶、剪毛或骑乘。"
		""
		"停止喂食动物后，驯服度会慢慢下降，所以放养太久的畜群会再次变得野性难驯。大多数动物在成年前也无法提供肉类以外的任何用处。"
		""
		"养几只鸡，这个任务就完成了。建好鸡舍后，交一个鸡蛋即可。"
	]
	quest.4578F4AA8D02D9BA.subtitle: "喂养它们，不要忽视它们"
	quest.4578F4AA8D02D9BA.title: "饲养动物"
	quest.46CAA6C7FC2E4FAB.quest_desc: ["将黄铜板和精密机械装置添加到未供电的物理轨道车上，使其成为可驱动模拟火车的供电版本，而不仅仅是随车滚动。"]
	quest.46CAA6C7FC2E4FAB.subtitle: "现在它能自己驱动了"
	quest.46CAA6C7FC2E4FAB.title: "物理轨道车"
	quest.46FCAD49663FA8E4.quest_desc: [
		"两个安山合金、两个安山外壳、一块玻璃板和一根电子管可以制作一个存储终端。将其安装在物品宝库（或其他任何可存放物品的方块）的侧面，右键屏幕即可打开一个可搜索、可排序的内部物品视图。"
		""
		"点击条目可取一叠，右键取半叠，按住 Shift 点击可取尽可能多。全部存入会将你背包中匹配的物品推回存储。未连接到任何存储的终端只会发出警告，而不会假装查看空仓库。"
	]
	quest.46FCAD49663FA8E4.subtitle: "与其翻箱倒柜，不如直接搜索它"
	quest.46FCAD49663FA8E4.title: "存储终端"
	quest.471C088B9172D177.quest_desc: [
		"在加热后的机械搅拌器和盆中混合一个铜锭和一个锌锭，可获得2个黄铜锭——这两种金属你已通过TFC获得。与安山合金不同，黄铜本身在这里是真正的TFC物品，而非Create的专属物品。"
		""
		"用去皮的原木制作黄铜外壳，方法与制作安山岩外壳相同（此部分仍为 Create 的自带物品）。黄铜是本章后半部分一切事物的开端——精密组件，以及 Create 矿物挖掘围绕它们构建的机器。"
	]
	quest.471C088B9172D177.subtitle: "铜和锌，混合并封装在一起"
	quest.471C088B9172D177.title: "黄铜"
	quest.47983D2A8A320B99.quest_desc: [
		"手持陶土球右键打开陶土塑形界面——一个独立于岩石塑形界面的小型4x5网格。用同样的方式敲击塑形，匹配你想要的模具轮廓（锭、斧头、刀锋等）。"
		""
		"结果是一个未烧制的模具——脆弱无用，直到被烧制。将其放入火坑或坩埚炉中，加热至接近1400°C，使其硬化成真正的模具，准备好浇注熔融金属。"
	]
	quest.47983D2A8A320B99.subtitle: "陶土雕刻，而非岩石雕刻"
	quest.47983D2A8A320B99.title: "制作模具"
	quest.47FD948BA797E940.quest_desc: ["用存储终端、黄铜外壳、工作台、安山合金和另一个电子管将其升级为合成存储终端——同样是搜索提取界面，但内置了合成网格，直接从相连的存储中获取材料，而非你的背包。"]
	quest.47FD948BA797E940.subtitle: "直接从已存储的物品中合成"
	quest.47FD948BA797E940.title: "合成存储终端"
	quest.48335FBE17DB50BF.quest_desc: [
		"打破野外生长的作物以收集种子，然后用锄头将泥土翻成农田再播种。"
		""
		"作物生长不严格需要土壤养分，但农田中的氮、磷、钾水平能加快生长并提高产量。不同作物类型（谷物、豆类、蔬菜和覆盖作物）消耗或补充的养分各不相同，因此轮作作物能保持土壤健康。"
	]
	quest.48335FBE17DB50BF.subtitle: "耕地，种植，等待"
	quest.48335FBE17DB50BF.title: "农业种植"
	quest.48904CEEC0C69260.quest_desc: [
		"将高炉坩埚中的生铁铸成锭，然后在铁砧上将其锻造成高碳钢，再将其锻造成真正的钢锭。"
		""
		"钢铁有四种类型——普通钢铁，以及更高级别的黑钢、红钢和蓝钢。后三种都需要先将“弱”钢在坩埚中合金化（弱钢含50-70%的钢、15-25%的镍和15-25%的黑青铜），再与铸铁焊接并重新锻造。"
		""
		"钢本身是 Tier IV - 你首先需要 Tier III (锻铁) 的砧来将其锻造成钢锭，而要更进一步，则需要用双层钢锭打造的 Tier IV 砧。"
	]
	quest.48904CEEC0C69260.subtitle: "用铸铁锻造两次即可得到"
	quest.48904CEEC0C69260.title: "钢铁"
	quest.4D5EBDD8F45E2B37.quest_desc: [
		"一个 Stock Link、一个金锭和玻璃可以制作一个 Stock Ticker。在放置前，用它对现有的 Stock Link 右键点击以加入同一网络，然后在它前面放置一个生物（或放置一个 Blaze Burner）——这就是你的 Stock Keeper 了。"
		""
		"右键点击守护者，浏览所有已链接的打包器中的可用物品并下单。提交请求将自动从存储位置打包，随时准备运送到你需要的地方。"
	]
	quest.4D5EBDD8F45E2B37.subtitle: "订购网络中已有的物品"
	quest.4D5EBDD8F45E2B37.title: "股票行情显示器"
	quest.4E48B5FE94DEB074.quest_desc: [
		"两块铁板和木桶可以合成物品宝库——一种容量远超箱子的存储方块。多个宝库并排放置会合并成一个更大的物品栏，就像Create的流体储罐一样。"
		""
		"有个前提：无法手动向Vault中添加或移除物品。只有漏斗、传送带、投掷器等能真正传输物品的组件才能伸入其中。"
	]
	quest.4E48B5FE94DEB074.subtitle: "你不能直接走到储物箱跟前去的"
	quest.4E48B5FE94DEB074.title: "物品宝库 (The Item Vault)"
	quest.51A6EE3F7D635DA6.quest_desc: [
		"用五个安山岩合金摆成特定形状可制作一个盆 - 在操作台下方放置一个，因为操作台的功能有一半取决于它。"
		""
		"这个机械本身也不是原版 Create 的配方：一个转轴、一个安山岩外壳和一个锻铁双锭——也就是你 Tier III 铁砧所用的双锭——组合成一个机械压机。"
		""
		"放置在Depot上方，可将下方掉落的物品一张张压制成片。若放置在Basin上方，则会将任何已填写的2x2或3x3配方应用到Basin内的物品上——部分配方需要真正的热量，由下方的Blaze Burner提供（下一个任务会教你建造一个）。"
	]
	quest.51A6EE3F7D635DA6.subtitle: "由你自己的锻造作品所建造而成"
	quest.51A6EE3F7D635DA6.title: "机械压榨机"
	quest.521B56616AF187A4.quest_desc: ["建造方式与冶金学中的精密机制相同：将铁板经过5轮序列组装——部署齿轮、然后是轴、最后是黄铜锭——最后在机械压机或锯子上完成序列。"]
	quest.521B56616AF187A4.subtitle: "又一个按顺序进行的环节"
	quest.521B56616AF187A4.title: "陀螺仪机制 (The Gyroscopic Mechanism)"
	quest.54153A5A8542998C.quest_desc: ["右键点击任意轮胎并拖放到轮轴上即可安装：标准轮胎、适合紧凑设计的小型轮胎、围绕皮带连接器建造的大型轮胎，以及用于最大型地面载具的巨型轮胎。所有轮胎的建造方式相同，只需围绕一根轴放置不同数量的干海带即可。"]
	quest.54153A5A8542998C.subtitle: "四种尺寸的越野轮胎"
	quest.54153A5A8542998C.title: "轮胎"
	quest.559B64F4FB8A551A.quest_desc: [
		"制作一个熔炉盆（七个安山岩合金和一个耐火砂浆）和一个熔炉盖（五个安山岩合金）来制作一个小型熔炉——它能容纳最多9个物品，盖上盖子并用下方的烈焰燃烧器加热即可熔炼。"
		""
		"投入几乎任何普通的TFC金属锭，它都会熔化成同种金属的液体，可以铸造成不同形状。但铜和金等少数金属会生成无法使用的原版物品，所以遇到这些情况不必惊讶。"
	]
	quest.559B64F4FB8A551A.subtitle: "第二个熔炉，这个带有自动功能"
	quest.559B64F4FB8A551A.title: "铸造厂"
	quest.5626EAFAEEEA82F5.quest_desc: [
		"在现有设施之上，创建冶金学第二套平行的熔炼和铸造设备——熔炉可直接熔炼任何TFC金属锭，铸造台则能将其铸成锭、板、棒和齿轮，全程无需使用铁砧。"
		""
		"创建矿石挖掘系统，如这里所示，它能自动化另一半工作：旋转动力钻，一旦找到值得开采的矿脉，就能直接从地里把矿石挖出来。"
	]
	quest.5626EAFAEEEA82F5.subtitle: "金属，工业规模的生产"
	quest.5626EAFAEEEA82F5.title: "欢迎来到创造冶金学 (Create Metallurgy)"
	quest.56807F4C82F6C636.quest_desc: [
		"将黑曜石压成粉末，注入500mB岩浆，再按压两次即可得到坚固板——Create自制的一种强化板材料，用你已有的机器就能制作。"
		""
		"电子管更简单：将抛光玫瑰石英堆叠在铁板上。两者都直接连接到样本钻头和钻头机本身。"
	]
	quest.56807F4C82F6C636.subtitle: "每个钻井平台都需要两个部件"
	quest.56807F4C82F6C636.title: "小部件"
	quest.56B97A7FB0A90AC5.quest_desc: [
		"齿轮、安山岩外壳和任意TFC石头垂直堆叠即可制成磨石。用传动轴或齿轮从侧面为其提供动力，然后将物品投入顶部——短暂延迟后，右键点击即可收集研磨后的产物。"
		""
		"每个处理的物品只会产生一种产物。一套完整的 Crushing Wheels——更晚出现的进阶配置——研磨速度更快，并有几率产出额外的第二种产物，这在开始投入矿石后非常重要。"
	]
	quest.56B97A7FB0A90AC5.subtitle: "你的第一台机器"
	quest.56B97A7FB0A90AC5.title: "磨坊石 (The Millstone)"
	quest.5848C4CB9355FB4C.quest_desc: [
		"蒸汽喷口和红石信号下的热空气燃烧器作用相同——为上方的气球充气——但它用蒸汽而非火焰驱动，需要与蒸汽机相同的加热、注水和锅炉空间。"
		""
		"规则相同：信封的大小限制了升力，多个排气口可以合并为一个气球。"
	]
	quest.5848C4CB9355FB4C.subtitle: "用蒸汽的力量升起来"
	quest.5848C4CB9355FB4C.title: "蒸汽喷口"
	quest.58697FF2B344CB6D.quest_desc: ["轨道、车站、信号，以及列车调度或运行方式——Create 的专属铁路系统现已完全实现。Simurail 则在其之上构建了一个物理模拟的升级系统。"]
	quest.58697FF2B344CB6D.subtitle: "创造自己的火车，已覆盖"
	quest.58697FF2B344CB6D.title: "Rolling Stock"
	quest.590B1AF9CF260033.quest_desc: ["火车外壳、电子管和压轮。模拟火车底盘的可选配件。"]
	quest.590B1AF9CF260033.subtitle: "一个额外的底盘部件"
	quest.590B1AF9CF260033.title: "物理滚动装置"
	quest.593E306E3C713CD0.quest_desc: ["选择一个轨道，然后在附近放置一个观察者——它能检测任何经过标记的火车，并且可以筛选以仅对特定货物触发。"]
	quest.593E306E3C713CD0.subtitle: "检测到一辆经过的火车"
	quest.593E306E3C713CD0.title: "轨道观察者 (The Track Observer)"
	quest.5987DA3762DA7D0A.quest_desc: [
		"信封块围成一个体积，填充热空气后会产生升力。热空气从顶部填充气球，必须由密封方块封闭才能正常工作。转轴可以封装在信封块中，以穿过气球而不破坏密封性。"
		""
		"信封有全部16种染料颜色——右键单击并用染料重涂，或在流动水下的水轮或盆中洗回白色。"
	]
	quest.5987DA3762DA7D0A.subtitle: "气球本身"
	quest.5987DA3762DA7D0A.title: "信封方块 (Envelope Blocks)"
	quest.5BEF08AD5D95D444.quest_desc: ["选择一个轨道，然后在附近放置一个车站——车站是整个轨道网络的途经点，也是唯一能将火车装置组装或拆解回方块的地方。在车站上使用地图会为其位置添加一个带标签的标记。"]
	quest.5BEF08AD5D95D444.subtitle: "网络上的一个路标位置"
	quest.5BEF08AD5D95D444.title: "火车站"
	quest.5D31A5DC1A983003.quest_desc: [
		"这两条路线都经过你刚建造的机械压机。先把金锭压成金箔，然后："
		""
		"&6扳手&r - 3个金片、1个齿轮和1根TFC树枝。右键大多数Create方块可旋转或重组，Shift+右键可拾取整个方块而非破坏。"
		""
		"&6护目镜&r - 金锭、TFC羊毛线和玻璃。戴上它，看向任何旋转轴、齿轮或机器，即可在屏幕上读取其精确的RPM和应力单位数值。"
	]
	quest.5D31A5DC1A983003.subtitle: "既然印刷机已经开始运行了"
	quest.5D31A5DC1A983003.title: "扳手和护目镜"
	quest.5F653C1992AF5BC2.quest_desc: [
		"此处的每个任务都是一项挑战——有些只需简单勾选，有些则需要上交特定物品。完成一个任务通常能获得奖励，可从奖励图标处领取。"
		""
		"章节列在侧边栏的选项卡中。部分任务依赖于其他任务，在前一个任务完成前无法解锁。"
	]
	quest.5F653C1992AF5BC2.subtitle: "这本书的使用方法如下"
	quest.5F653C1992AF5BC2.title: "使用此任务列表"
	quest.5FA57DC42371202C.quest_desc: ["有了可用的钻头和对准工具，就没什么能阻止你搭建第一个自动化挖掘点了。"]
	quest.5FA57DC42371202C.subtitle: "已侦察并配备装备"
	quest.5FA57DC42371202C.title: "准备好挖掘了吗"
	quest.6150FE87C0034D10.quest_desc: ["矿车连接器周围放置两个黑曜石板。Simurail 自制的连接器物品，由 Create 普通矿车已使用的同款连接器制成。"]
	quest.6150FE87C0034D10.subtitle: "Simurail 自己的连接器"
	quest.6150FE87C0034D10.title: "轨道连接器 (The Bogie Connector)"
	quest.62567FA6CD2EAFD5.quest_desc: [
		"手持至少两块相同岩石类别（沉积岩、变质岩、侵入岩或喷出岩）的石头，在空中右键打开打制界面。这是一个5x5的网格，初始时完全填充了石头。"
		""
		"点击单个方块来将其移除。你并非在填充形状，而是在移除不属于该形状的一切——清除方块，直到剩余部分与已知的工具头图案之一匹配。图案在网格上的位置并不重要，且多种工具接受不止一种有效排列，因此允许一定程度的误差。"
		""
		"打制会消耗两种石头中的一种，并在形状正确时产出一个工具头。本章将教你如何制作第一把斧头和刀，但同样的方法适用于游戏中所有石质工具头。"
	]
	quest.62567FA6CD2EAFD5.subtitle: "两块石头，一个工具头"
	quest.62567FA6CD2EAFD5.title: "制作你的第一件工具"
	quest.6262E5A58142DF2A.quest_desc: ["每列火车装置都必须配备。右键开始驾驶——移动键可加速和转向，鼠标滚轮可微调最高速度。按住空格键驶入附近的车站，潜行或再次点击停止驾驶。第二组按钮可用于让火车双向驶离车站。"]
	quest.6262E5A58142DF2A.subtitle: "实际上是在驾驶这个东西了"
	quest.6262E5A58142DF2A.title: "火车控制系统"
	quest.62C6C4097E0593FD.quest_desc: [
		"本整合包的精密机制完全跳过了Create常用的黄铜配方。从TFC金板开始，先放置齿轮，再放置黄铜机制（在盆中加热黄铜锭两次），然后用铁砧直接制作锻铁棒，重复两次该流程即可完成。"
		""
		"除了黄铜机械装置步骤外，这里的所有东西都可以通过 TFC 单独制作。"
	]
	quest.62C6C4097E0593FD.subtitle: "由锻造炉而非黄铜铸成"
	quest.62C6C4097E0593FD.title: "精密机械装置"
	quest.64E91DEEC8FD6960.quest_desc: ["一个 Crushing Wheel、一个 Block of Industrial Iron 和一个 Iron Sheet。与普通钻头不同，Rock Cutting Wheels 会破坏自身周围范围内的所有方块，并能自动与其他方块及彼此连接——无需强力胶水。挖掘速度取决于输入的转速，而更多的 Borehead Bearings 可以抵消同时切割更多方块带来的减速影响。"]
	quest.64E91DEEC8FD6960.subtitle: "边挖掘边前进，就像开车一样"
	quest.64E91DEEC8FD6960.title: "岩石切割轮"
	quest.64F1DD5A3CC0997E.quest_desc: ["放置在蓄足热量的流体储罐上，蒸汽哨在激活时会发出音符——哨子物品会降低音高，扳手可在三个八度之间切换。安装在行驶火车上的组装哨子，可在驾驶时按冲刺键吹响。"]
	quest.64F1DD5A3CC0997E.subtitle: "每列火车都需要一个"
	quest.64F1DD5A3CC0997E.title: "蒸汽汽笛"
	quest.67F91A01E4432163.quest_desc: [
		"青铜是 Tier II，所以将两个青铜锭焊接在一起（纹石、加热、锤子，和之前一样）成一个双锭，重复七次。你需要 Tier I 的铜砧来进行焊接——Tier N 的砧可以焊接 Tier N+1 的锭，不能跳过步骤。"
		""
		"将7个双锭按之前的3x3环形排列，你就能得到Tier II砧台——现在既能锻造又能焊接青铜，距离能锻造铁也只差一步焊接了。"
	]
	quest.67F91A01E4432163.subtitle: "Tier II - 铁之前的最后一站"
	quest.67F91A01E4432163.title: "青铜砧台"
	quest.68B3523C5F0761AF.quest_desc: [
		"从深板岩砖开始，涂上耐火砂浆，再铺上奥布杜里乌姆板，将其研磨，并注入30mB的熔融钨，即可完成工业熔炉——这是一个完整的序列组装，而非简单的合成配方。"
		""
		"多个熔炉并排放置会合并成一个更大的结构，就像Create的流体储罐一样。5x5的结构能达到最高温度，但前提是结构内的每个方块下方都必须有自己的烈焰燃烧器——漏掉一个，整个结构都会变凉。"
	]
	quest.68B3523C5F0761AF.subtitle: "铸造厂的大哥大"
	quest.68B3523C5F0761AF.title: "工业熔炉 (Industrial Crucible)"
	quest.694680A9A7D620D0.quest_desc: ["可供滚动之轮与可供挖掘之轴承——一切组件，用于制造可在本章所有事物相同模拟物理下自行驶过崎岖地形的地面载具。"]
	quest.694680A9A7D620D0.subtitle: "车轮滚滚向前行"
	quest.694680A9A7D620D0.title: "越野就绪"
	quest.6A42CAE76F6E20A4.quest_desc: [
		"螺旋桨轴承会连接到正前方建造的任何结构上——至少2个船帆状方块组成的任何排列都算作有效螺旋桨，船帆越多推力越大。"
		""
		"转动轴承会产生推力，可将装置推入空中；扳手可反向推力。在较高空速和较高海拔（空气稀薄处）时，推力都会下降。"
	]
	quest.6A42CAE76F6E20A4.subtitle: "推力，而非升力"
	quest.6A42CAE76F6E20A4.title: "螺旋桨轴承 (The Propeller Bearing)"
	quest.6BC40AEBBFCB5CC1.quest_desc: [
		"六个TFC的干海带可以制作一个带轮连接器。放置方式不同于普通方块——右键点击一个竖井，再右键点击距离2至20格远的另一个竖井，两者之间就会拉出一条传送带。"
		""
		"两个转轴以相同的速度和方向旋转。传送带本身会携带任何被丢弃或放置在其上的物品或实体，是机器间物理移动的主要方式。"
	]
	quest.6BC40AEBBFCB5CC1.subtitle: "不是方块，而是一个物品"
	quest.6BC40AEBBFCB5CC1.title: "机械传送带"
	quest.6C6BD602F494DF36.quest_desc: ["将黑曜石板部署到黄铜外壳上以制作火车外壳——几乎所有轨道车辆、车站和信号机的基础材料。"]
	quest.6C6BD602F494DF36.subtitle: "铁路背后的材料是未知的，需要进一步探索。"
	quest.6C6BD602F494DF36.title: "火车外壳"
	quest.6CC22697BC6007E0.quest_desc: ["熔化、合金、铸造，以及用手或舀子搬运液态金属——Foundry 系列实现了 TFC 锻造炉的所有功能，只是实现了自动化并与之并行运行。"]
	quest.6CC22697BC6007E0.subtitle: "每一块都协同工作，共同发挥作用"
	quest.6CC22697BC6007E0.title: "完整的铸造厂（The Complete Foundry）"
	quest.6CDECBA71D5AC615.quest_desc: [
		"一种专为火车装置而非普通矿车建造的新轨道。点击现有轨道，然后放置或选择第二点以一次性连接整排轨道——连接时按住冲刺键，可获得最合适的长弯道而非最急的弯道。轨道可以铺设为弯道或斜坡，并且非主手物品会自动铺在轨道下方。"
		""
		"与精密机制的制造方式相同：在石头或安山岩板上进行序列组装，两次放置铁或锌块，最后进行压制。"
	]
	quest.6CDECBA71D5AC615.subtitle: "用于真实火车的轨道模组"
	quest.6CDECBA71D5AC615.title: "铁路轨道"
	quest.6FD8E7AE6E6238D0.quest_desc: [
		"右键点击时刻表以编程目的地，然后将其交给驾驶员——坐在火车控制台前的任何生物或烈焰燃烧器都算，拴着的生物可以直接安排座位。编程后的火车将自行运行；时刻表可随时从其驾驶员处取回。"
		""
		"放在车站的调度表会自动复制到停靠该站的任何列车上——与直接交给司机不同，列车不会带走该副本。"
	]
	quest.6FD8E7AE6E6238D0.subtitle: "让火车自动驾驶"
	quest.6FD8E7AE6E6238D0.title: "时间表"
	quest.6FE0BC29D1E4B6F0.quest_desc: ["飞机、火车和汽车——三种交通工具现已涵盖，并基于同一物理模拟。还有一些扩展内容：空中飞艇的折叠空间曲率引擎、线控驾驶、可收纳和部署整辆载具的工具枪、炮弹弹道雷达，以及专门的飞艇/火车调度站——如果你想进一步探索，这些内容都值得尝试。"]
	quest.6FE0BC29D1E4B6F0.subtitle: "所有可用的移动方式都列出来了"
	quest.6FE0BC29D1E4B6F0.title: "继续前进"
	quest.6FE7A8A4ADD116C7.quest_desc: ["现在你可以从原矿石直接制作成成品钢制工具，无需使用工作台。接下来的章节将转向 Create 模组以及所有你所学到的内容之上的其他科技。"]
	quest.6FE7A8A4ADD116C7.subtitle: "锻造炉是你的了"
	quest.6FE7A8A4ADD116C7.title: "继续前进"
	quest.701DE07BF684DEA8.quest_desc: ["将4份末石粉（由末石粉碎而成）和2份锌粒混合到500mB的水中并加热，即可得到Levitite Blend——本章反重力材料的原始未结晶形态。"]
	quest.701DE07BF684DEA8.subtitle: "某种程度上是反重力的原始形态"
	quest.701DE07BF684DEA8.title: "Levitite Blend"
	quest.729A379F32BA554C.quest_desc: [
		"将热源靠近 Levitite Blend，它就会开始结晶成固体 Levitite——一旦开始，反应会自行蔓延至整个流体，无法再将其变回 Blend。"
		""
		"足够的 Levitite 附着在装置上可使其悬浮——仅靠 Levitite 无法升高，因为它低速时会抵抗运动（高速时阻力会下降），但无需燃烧器或排气口即可稳定悬停。标记为结晶时破碎的方块可用于将 Levitite 塑造成特定形状。"
	]
	quest.729A379F32BA554C.subtitle: "悬浮现象发生的地方"
	quest.729A379F32BA554C.title: "Levitite"
	quest.7466D020492F80B8.quest_desc: ["随着海拔升高，空气变稀薄，升力和推力都会减弱。高度传感器能读取其所在位置的精确气压，这样红石装置就能直接响应，而无需猜测。"]
	quest.7466D020492F80B8.subtitle: "读取空气中的信息"
	quest.7466D020492F80B8.title: "高度传感器 (The Altitude Sensor)"
	quest.755332AA752A98DB.quest_desc: [
		"每个铁砧都有一个等级，规则不变：它能锻造同等级金属，并能焊接高一级的金属。你的岩石铁砧是0级，所以它能焊接一级的铜，但完全无法锻造铜。"
		""
		"&6Tier 0&r - 岩石 &6Tier I&r - 铜 &6Tier II&r - 青铜系列 &6Tier III&r - 锻铁 &6Tier IV&r - 钢 &6Tier V&r - 黑钢 &6Tier VI&r - 红/蓝钢"
		""
		"用纹银将两个铜锭熔炼成双锭，重复七次，然后在3x3的锻造网格中按环形排列（7个角和中间为空），即可获得第一个金属砧。从此你既能锻造又能熔炼铜，并且之后每个阶段都需要重复这种双锭升级。"
		""
		"锻造物品就是用锤子对齐进度条，遵循界面顶部的规则。做得好，结果会是“拙劣”、“良好”、“专家”或“完美”锻造，每一步都会提升耐久度、速度或伤害。"
	]
	quest.755332AA752A98DB.subtitle: "第一阶 - 总算开工了"
	quest.755332AA752A98DB.title: "铜制铁砧"
	quest.75557EDA9E07C0E7.quest_desc: [
		"由红石供能的充气式燃烧器会逐渐填充其上方气袋的热空气——输入面板设置最大输出，红石信号强度则按比例调节该输出。多个燃烧器可为单个气球供能以获得更大升力。"
		""
		"气球能产生的升力取决于它的大小，所以更大的气球包不仅仅是为了好看。"
	]
	quest.75557EDA9E07C0E7.subtitle: "从火焰中升起"
	quest.75557EDA9E07C0E7.title: "热气燃烧器"
	quest.75C04C84220A2CA2.quest_desc: [
		"将原木、3根木棍和最多5个引火物（稻草、纸或松果——每种可增加约+10%成功率）放在同一方块上。用两根木棍制作火种器，然后右键点击火堆，直到冒出烟雾，接着是火焰。"
		""
		"点燃的火坑有四个燃料槽（原木、泥炭或木棍束）和一个温度计。用它来烹饪生食和面团，将木棍制成火把，并在温度足够高时熔炼第一批金属。"
	]
	quest.75C04C84220A2CA2.subtitle: "你的第一个真正的热源"
	quest.75C04C84220A2CA2.title: "建造一个火坑"
	quest.77AE9D3D84D06910.quest_desc: ["用木板围成一个3x3的区域，中间放置转轴即可制作水轮。将其叶片朝向流动的水放置，它就能自行产生旋转力，无需燃料或玩家操作——后续章节会详细说明它和其他发电装置的实际发电量。"]
	quest.77AE9D3D84D06910.subtitle: "你的第一份力量来源"
	quest.77AE9D3D84D06910.title: "水车装置"
	quest.78321E0C66E146B5.quest_desc: [
		"黏土藏在地下，但总会在地表露出马脚：留意附近生长的&6athyrium fern、canna、goldenrod、pampas grass、perovskia 或 water canna&r。只要看到其中一种，附近草丛下就一定有黏土。"
		""
		"用铲子（石头的也行）挖掘它，每个方块会掉落1-3个陶土球。多拿一组，因为容器、模具和后面的陶器会消耗大量陶土。"
	]
	quest.78321E0C66E146B5.subtitle: "跟随植物前进"
	quest.78321E0C66E146B5.title: "寻找黏土"
	quest.7AFA0763108AE957.quest_desc: [
		"正牌货：和样本钻头同系列的零件，只是数量更多，排列成完整的5x5机械合成网格。装上钻头并用旋转力驱动，它就能直接从占据该区块的矿脉中直接抽取矿石——无需挖矿。"
		""
		"本整合包添加的所有矿脉都是无限的，完全无视 TFC 自身的岩层。流体井提取器也存在，建造方式相同，但本整合包中只有水脉是活跃的，所以它更像是一个小彩蛋，而非值得追求的东西。"
	]
	quest.7AFA0763108AE957.subtitle: "旋转的力量负责挖掘工作"
	quest.7AFA0763108AE957.title: "钻孔机"
	quest.7B3513914F95C9E8.quest_desc: [
		"Transfer Ladle（一种小型序列组装物品，有多种外观变体）可以直接从熔炉或坩埚中舀取流体，并手动将其倒入任何地方——小任务无需泵或流体管道。"
		""
		"标签站利用红石能量控制勺子，将附带剪贴板上所有以'#'开头的行写入地址，用于在多个勺子同时运行时按目的地进行分拣。"
	]
	quest.7B3513914F95C9E8.subtitle: "在没有管道的情况下移动液态金属"
	quest.7B3513914F95C9E8.title: "传送勺（The Transfer Ladle）"
	quest.7C2B403E913EC9D2.quest_desc: [
		"旋转动力构建了机器；黄铜和精密机制打造了冶金学的精细工具。航空学将两者引向一个新问题：离开地面。"
		""
		"这里的一切都由你已知的创造部件构成——黄铜外壳、安山合金、铁板——外加本章引入的一些新材料。"
	]
	quest.7C2B403E913EC9D2.subtitle: "离开地面，开始起飞"
	quest.7C2B403E913EC9D2.title: "欢迎来到创造：航空学模组"
	quest.7EBB0197C5BE0EF7.quest_desc: ["飞行要素就齐了：升力、推力，还有自稳装置，气球就能自主飞行。火车和汽车遵循相同的物理原理——下一项。"]
	quest.7EBB0197C5BE0EF7.subtitle: "飞行，已覆盖飞行能力。"
	quest.7EBB0197C5BE0EF7.title: "飞行器已准备就绪"
	quest.7F72C06FA326C8A5.quest_desc: [
		"将四种可制浆物品（竹子或任意树苗）与250mB水在加热过的 Basin and Mixer for Pulp 中混合，然后将其压制为 Cardboard - 四个 Cardboard 可制作一个 Cardboard Block。"
		""
		"将其与铁锭和红石结合，即可制作一个包装器。将其连接到物品栏侧面并输入红石信号，它会将物品栏内的物品打包成一个包裹——一个可以携带、放在腰带上，或输入另一个包装器中拆开的实体物品。先在上面写个牌子，这样它制作的每个包裹都会携带该文本作为地址。"
	]
	quest.7F72C06FA326C8A5.subtitle: "将物品栏里的东西全部装箱打包"
	quest.7F72C06FA326C8A5.title: "包装工（The Packager）"
	quest.7FCCF25953A60E02.quest_desc: ["工业铁块和两个黑曜石板可以制作出4个通道框架——用于将模拟火车车厢连接成一体结构的连接走廊部件，具有真实火车所需的多种倾斜和错位形状。"]
	quest.7FCCF25953A60E02.subtitle: "在车厢之间穿行"
	quest.7FCCF25953A60E02.title: "The Gangway Frame"

	quest.690239F4E1A94E03.quest_desc: [
		"冶金学的黄铜和精密机械解锁了创造模组的精细机器。此附加包在此之上构建了第二个工业层级：石油被钻探和提炼成燃料和塑料，产生电力，并制造出印刷电路板。"
		""
		"有一点与模组自带的教程不同：在本整合包中，铸铁和钢是TFC自己的——即你的金属加工系统已经能生产的铸铁锭和钢锭。本附加包的冲天炉仍然存在且值得建造，但它真正的回报是硅，而不是你已经拥有的金属。"
	]
	quest.690239F4E1A94E03.subtitle: "钢和铸铁，已经到手了"
	quest.690239F4E1A94E03.title: "欢迎来到《工厂必须成长》"
	quest.569FB7E5F377BD86.quest_desc: ["将火粘土（与金属加工中的同一种）在普通熔炉中熔炼成防火砖，然后用4个合成防火砖块。这是唯一能用于建造功能性高炉或化学槽的材料。"]
	quest.569FB7E5F377BD86.subtitle: "火焰粘土，赋予其新的用途"
	quest.569FB7E5F377BD86.title: "防火砖块"
	quest.128833CEF75A5520.quest_desc: [
		"煤炭输入，焦油输出——过程缓慢，建议并排运行多个焦油炉。煤炭可从任意位置投入；二氧化碳从顶部排出，焦油可从其他任意侧面抽出。"
		""
		"Creosote（以及高炉运行的副产品Furnace Gas）正是Blast Stove的燃料——本扩展的第一个闭环。"
	]
	quest.128833CEF75A5520.subtitle: "缓慢，但值得布阵以待"
	quest.128833CEF75A5520.title: "焦炭炉 Coke Oven"
	quest.20A15AA866AB30BE.quest_desc: [
		"将燃料（Creosote 或 Furnace Gas）从底部加入，空气从侧面加入，Blast Stove 就会从顶部排出 Hot Air——这是 Blast Furnace 运行的热源。"
		""
		"运行时还会产生二氧化碳，如果不排放会导致停机——请在附近建造烟囱或排气管以保持运行。"
	]
	quest.20A15AA866AB30BE.subtitle: "将燃料和空气转化为热空气"
	quest.20A15AA866AB30BE.title: "爆炸炉（The Blast Stove）"
	quest.7322B17969B6D21C.quest_desc: [
		"用防火砖围成一个炉膛出口，将炉膛炉门设为热风入口，并在外部添加炉膛加固以加速。从顶部开口进料。"
		""
		"在TFMG中，这个多方块结构可以制造钢，但本整合包已通过TFC的炼铁炉直接提供钢和铸铁，所以无需投入碎铁。它真正的用途在本章稍后才会显现：改用石英喂养，完全相同的结构就能生产出用于电路板的液态硅。"
	]
	quest.7322B17969B6D21C.subtitle: "值得建造，为后面的内容做准备"
	quest.7322B17969B6D21C.title: "高炉（The Blast Furnace）"
	quest.3EBDB1B02D913C8D.quest_desc: ["钢制齿轮和大型钢制齿轮是简单的锭加轴的合成，可以直接用你已有的钢锭制作。钢制外壳需要手动放置：将钢锭放在硬化木板上，就像冶金学里将黄铜外壳放在去皮原木上一样。"]
	quest.3EBDB1B02D913C8D.subtitle: "黄铜零件，但却是钢制的"
	quest.3EBDB1B02D913C8D.title: "钢铁级动力学模组"
	quest.3DBEF6700140548A.quest_desc: ["将钢板应用到钢制外壳上，即可得到重型机械外壳——从此之后，本扩展包中几乎所有的机器都围绕这个方块建造。"]
	quest.3DBEF6700140548A.subtitle: "所有工业设备背后的外壳结构"
	quest.3DBEF6700140548A.title: "重型机械外壳"
	quest.4D66D931F9F3CAA7.quest_desc: ["建造方式与冶金学精密机制相同：将钢片通过序列组装，部署钢齿轮、镍片、大型钢齿轮、铅片、螺丝和螺丝刀，共2个完整循环。此处的所有金属片均为真实的TFC和TFCM金属，与其他金属片采用相同的压制方式，本附加内容并未引入独立的新材料。"]
	quest.4D66D931F9F3CAA7.subtitle: "此附加包的精密机制 (Precision Mechanism)"
	quest.4D66D931F9F3CAA7.title: "钢铁机械装置"
	quest.196248DBF5923552.quest_desc: ["重型机械外壳周围环绕着一圈钢制齿轮——Create 原版齿轮箱的钢制替代品。"]
	quest.196248DBF5923552.subtitle: "重定向钢制旋转装置"
	quest.196248DBF5923552.title: "钢铁齿轮箱"
	quest.10B72D484823918E.quest_desc: ["建造一个高炉（即使目前金属产出未被使用），以及一套完整的钢制外壳和机械装置——这是本章所有其他内容运行的基础。"]
	quest.10B72D484823918E.subtitle: "熔炉已建造，工具包已组装"
	quest.10B72D484823918E.title: "钢铁时代"
	quest.1648763B5CB1919A.quest_desc: ["由下方的 Machine Input 供电，Surface Scanner 会照亮周围 5x5 的区块网格——任何发光的区块都至少含有一个 Oil Deposit。几秒钟内没有光亮通常意味着附近没有。如果需要对齐，按 F3+G 可在游戏中显示区块边界。"]
	quest.1648763B5CB1919A.subtitle: "在挖掘前找到石油"
	quest.1648763B5CB1919A.title: "地表扫描仪"
	quest.0F4AD82C6B04E45C.quest_desc: ["用工业管道将石油矿床引至地表，在顶部放置一个背向锤柄的抽油机底座，然后在抽油机曲柄上方建造锤柄、连接器和锤头，并用强力胶水粘合。曲柄上方的机器输入提供旋转动力，驱动整个装置抽提原油。"]
	quest.0F4AD82C6B04E45C.subtitle: "正在钻探原油"
	quest.0F4AD82C6B04E45C.title: "抽油机（Pumpjack）"
	quest.19ED4EC34E12C53F.quest_desc: [
		"堆叠钢制流体储罐，连接钢制蒸馏控制器以输入原油，并用工业管道连接最多6个钢制蒸馏输出环绕塔身。底部的热源为其提供动力——塔上的刻度显示当前功率水平，而实际建造的输出数量会影响输出的燃料组分。"
		""
		"一座完全建成且完全加热的塔可以同时将原油分离为重油、柴油、煤油、石脑油、汽油和液化石油气；如果产出较少或热量不足，部分馏分会合并。"
	]
	quest.19ED4EC34E12C53F.subtitle: "将原油裂解成燃料"
	quest.19ED4EC34E12C53F.title: "蒸馏塔 (The Distillation Tower)"
	quest.31D978B715AB2280.quest_desc: ["一个可用的抽油机和一座蒸馏塔——原油不再只是地下的流体，而是柴油、汽油、石脑油及其下游的所有产物。"]
	quest.31D978B715AB2280.subtitle: "从原始燃料到可用燃料的转化"
	quest.31D978B715AB2280.title: "开采石油"
	quest.6298334B7A0A299E.quest_desc: ["防火砖、铸铁板和铸铁管可以制作一个铸造盆。它的主要用途是铸造金属锭，但你有TFC的钢和铸铁——这里用于铸造塑料板，之后还有硅锭。"]
	quest.6298334B7A0A299E.subtitle: "这次不是金属的了，不是金属的"
	quest.6298334B7A0A299E.title: "铸造盆 (The Casting Basin)"
	quest.5F0D5361C63A348E.quest_desc: ["化学槽在未连接任何东西前只是一个普通外壳。插入工业混合器的搅拌桨，它就变成了能执行本部分配方的混合器；其他配件可将同一化学槽变为电解器（2个电极座）或电弧炉（3个石墨电极）。"]
	quest.5F0D5361C63A348E.subtitle: "一台机器，多种用途"
	quest.5F0D5361C63A348E.title: "化学反应釜 (The Chemical Vat)"
	quest.178078BB0247A7CD.quest_desc: ["在改装为搅拌机的加热反应釜中，石脑油裂解成乙烯和丙烯；任其一与热量再次混合，即可生成熔融塑料。将其倒入铸造盆中，即可得到塑料片——电路板、电阻器、晶体管和各种合成材料的幕后材质。"]
	quest.178078BB0247A7CD.subtitle: "石脑油，裂解与铸造"
	quest.178078BB0247A7CD.title: "塑料"
	quest.10FD72A2934883C1.quest_desc: ["硫磺粉和重油在化学槽中混合加热，可直接生成橡胶片——无需中间流体。这是一个完全可选的副产品，本章后续内容均不需要它。"]
	quest.10FD72A2934883C1.subtitle: "硫磺和重油"
	quest.10FD72A2934883C1.title: "橡胶"
	quest.03FD75D29220A5FF.quest_desc: ["硫磺粉、硝酸盐粉和水在化学槽中混合会产生硫酸——虽然不起眼，但这正是本章后面蚀刻电路板要浸泡的溶液。"]
	quest.03FD75D29220A5FF.subtitle: "用于蚀刻，稍后会用到"
	quest.03FD75D29220A5FF.title: "硫酸 (Sulfuric Acid)"
	quest.135E0001D267273D.quest_desc: ["重油在搅拌机中加热后会凝结成沥青。将其与沙子和砾石（或炉渣和砾石，产量翻倍）混合成沥青混合物，再与水混合成液态沥青用于铺路。这个配方完全省去了化学槽，只是一个普通的机械搅拌机配方，并且完全可选。"]
	quest.135E0001D267273D.subtitle: "铺设工厂的地板"
	quest.135E0001D267273D.title: "沥青"
	quest.0A41C516E73C9C7C.quest_desc: ["铝在这里不是熔炼，而是电解，和 TFC/TFCM 的制作方法一样。用 2 个电极座和铜电极装配化学槽，制成电解器，然后用铝土矿粉来制造铝锭。这是本部分唯一非可选的输出：下一部分的引擎都围绕着铝制零件来建造。"]
	quest.0A41C516E73C9C7C.subtitle: "电解，而非熔炼"
	quest.0A41C516E73C9C7C.title: "铝（Aluminum）"
	quest.5B185E9659A3BA80.quest_desc: ["塑料、硫酸和电解铝——化学槽已从新奇之物，变为本扩展包半数材料的来源。"]
	quest.5B185E9659A3BA80.subtitle: "石油，被制成其他所有东西"
	quest.5B185E9659A3BA80.title: "石化工业"
	quest.3283660720DE7F6D.quest_desc: ["每个气缸层级都基于前一个：简易发动机气缸只需铁板和打火石；柴油发动机气缸是铝板；加上火花塞即为完整发动机气缸，再在其上加上黄铜管即为自动燃气发动机气缸。更好的气缸能使用更多（也更未经提炼的）燃料。"]
	quest.3283660720DE7F6D.subtitle: "四个等级，一个部分"
	quest.3283660720DE7F6D.title: "发动机气缸"
	quest.7B82A9518004A39F.quest_desc: ["将柴油、煤油、石脑油或炉气等空气和燃料注入，并通过排气管排出二氧化碳，发动机就能通过连接的传动轴将其转化为旋转动力，原理与蒸汽机相同。也有功率更大的径向和涡轮发动机，但它们都输出旋转动力而非电力——电力需要另一台机器。"]
	quest.7B82A9518004A39F.subtitle: "旋转，而不是电力"
	quest.7B82A9518004A39F.title: "常规引擎 (The Regular Engine)"
	quest.01504D349B6B1195.quest_desc: ["建造方式与钢制机械相同：从转轴开始顺序组装，部署电容器、钢板，然后用绕线机为其缠绕铜线轴，接着部署磁铁和钢制机械，共3个循环。将完成的发电机连接到旋转的转轴上——例如引擎的转轴——它便开始产生真正的电力：电压和功率。"]
	quest.01504D349B6B1195.subtitle: "将旋转转化为电能"
	quest.01504D349B6B1195.title: "发电机"
	quest.25A6F89E66B3C3D5.quest_desc: ["电线杆（和五种金属等级的电缆枢纽）是电网的物理锚点，但电缆本身是虚拟的。右键点击两个电缆绝缘体，并用铜、铝或康铜线轴将它们连接起来，就像创造模组中的滑轮一样，通过右键而非放置方块来连接。"]
	quest.25A6F89E66B3C3D5.subtitle: "将所有线路连接在一起"
	quest.25A6F89E66B3C3D5.title: "电线杆和电缆 (Posts and Cables)"
	quest.5FCCEC092582A22E.quest_desc: ["为变压器安装2个匝数不同的电磁线圈，电压会按匝数比变化——50匝输入连接100匝输出，输出电压会翻倍。这是一个真实的电气模型：每个设备都有电压、电流和电阻，接入同一编号组别的设备会按电阻分配电压。配置扳手可以更改设备所属的组别。"]
	quest.5FCCEC092582A22E.subtitle: "通过匝数比改变电压"
	quest.5FCCEC092582A22E.title: "变形金刚（The Transformer）"
	quest.0F9D1CA729107017.quest_desc: ["铅酸蓄电池（铅板和硫酸）或锂离子电池（一块锂和镍板）都会产生相同的电池方块：电荷从底部进入，并从顶部缓慢流出。这只是便利功能，非必需项。"]
	quest.0F9D1CA729107017.subtitle: "无论如何，都需要一块电池"
	quest.0F9D1CA729107017.title: "蓄能器 (The Accumulator)"
	quest.5DD23DE1046BAD7E.quest_desc: ["引擎驱动发电机，通过电线杆和变压器连接——这里的电力不是固定数值，而是电压、电流和电阻构成的真实电路。"]
	quest.5DD23DE1046BAD7E.subtitle: "真正的电网系统"
	quest.5DD23DE1046BAD7E.title: "Electrified"
	quest.0E51508739235558.quest_desc: ["将原本会产出钢的熔炉改为产出石英，这样就能得到液态硅——这正是钢铁时代建造它的理由。在铸造盆中将其铸成硅锭。"]
	quest.0E51508739235558.subtitle: "高炉，现已改作他用"
	quest.0E51508739235558.title: "硅晶圆"
	quest.7C68B40E85CF6677.quest_desc: ["将硅与硫磺粉混合可制成N型半导体，或与铝混合可制成P型半导体——均为普通机械混合器配方，无需熔炉或加热。它们共同构成了此后所有晶体管的内部核心。"]
	quest.7C68B40E85CF6677.subtitle: "N型和P型"
	quest.7C68B40E85CF6677.title: "半导体元件"
	quest.7A768468706EF3C7.quest_desc: ["塑料片和绿色染料可制成空白电路板。部署器用金板将其涂覆，制成涂层电路板。在化学槽中浸泡硫酸进行蚀刻。最后，序列组装将电容器、电阻器、晶体管和第二个电阻器部署其上，共4个循环，制成成品电路板——本模组几乎所有高级机器都至少需要一个该组件。"]
	quest.7A768468706EF3C7.subtitle: "四个阶段，从头到尾完成"
	quest.7A768468706EF3C7.title: "电路板 (The Circuit Board)"
	quest.725D2A9697073911.quest_desc: ["2 镍锭、1 硅锭和 2 钢锭混合加热，可生产出磁性合金锭——TFC 的镍和钢与该模组硅的真正融合。可选分支：将其压制为薄片用于变形金刚，或继续向下制作真正的磁铁和线圈。"]
	quest.725D2A9697073911.subtitle: "镍、硅和钢组合在一起"
	quest.725D2A9697073911.title: "磁性合金"
	quest.3A2EDAA6D9EEAC38.quest_desc: ["将磁合金锭放入偏振器中，右键点击并等待片刻，即可将其制成磁铁。绕线机将铜线绕在未完成的线圈（钢锭包裹磁合金锭）上，制成电磁线圈，两者均可用于电机、变压器和发电机。"]
	quest.3A2EDAA6D9EEAC38.subtitle: "偏振器和绕线机有什么用"
	quest.3A2EDAA6D9EEAC38.title: "磁铁与线圈"
	quest.2A2341354E9F1220.quest_desc: ["用建造钢炉的同一座高炉重熔硅，混合出半导体，再组装出完整的电路板——电子元件层级已完成。"]
	quest.2A2341354E9F1220.subtitle: "从沙子到电路板"
	quest.2A2341354E9F1220.title: "电子产品，准备就绪"
	quest.4E03EB121ED15E32.quest_desc: ["石油、电力和电路板——这个附加包的核心部分已完成，基于 TFC 已有的钢和铸铁。内容远不止于此：凝固汽油和铝热武器、升级后的土豆炮、数十种用于工厂地板的混凝土和警示方块颜色，以及一个独立的 Create 风格流体管道、泵和阀门教程，这些在 Create 基础篇中已有基础教学，本章无需赘述。准备好时，随时可以在游戏中探索。"]
	quest.4E03EB121ED15E32.subtitle: "工厂仍在不断扩张中"
	quest.4E03EB121ED15E32.title: "继续前进"

	quest.36619116E6F1FA81.quest_desc: [
		"The Factory Must Grow的发电机在抽象层面上运行电压和功率。Power Grid更进一步：它模拟真实的电路——电压、电流和电阻遵循欧姆定律，有闭合回路、导线电阻损耗，甚至还有过流损坏。"
		""
		"这两个系统并非孤立：Power Grid 的 Device Connector 可以直接连接到 TFMG 线路（以及普通的 Forge Energy）——这是一个开发者构建的真正兼容性功能，而非巧合。"
	]
	quest.36619116E6F1FA81.subtitle: "基于真实物理学的第二套电气系统"
	quest.36619116E6F1FA81.title: "欢迎来到创造：动力电网"
	quest.7ECEDA5ADAB4370C.quest_desc: [
		"用机械锯切割铜板可获得4根电线。接线并非放置方块——选择一个连接器，然后右键点击第二个以连接它们，消耗的距离取决于两者之间的距离。电线连接器（安山合金加铜粒）只是一个无其他功能的转接点。"
		""
		"电流只能在完整的闭合回路中流动，每根导线都有电阻——线路越长，电压损失越大，过细的导线承载过大电流会导致过热而损坏。"
	]
	quest.7ECEDA5ADAB4370C.subtitle: "右键链接，而非放置电缆"
	quest.7ECEDA5ADAB4370C.title: "电线和连接器"
	quest.2E95EF4A43F16EE5.quest_desc: ["铁板、锌板、纸和铜板可以制作电容器——一种储存少量电力的小型面包板元件，而非大型电池。"]
	quest.2E95EF4A43F16EE5.subtitle: "少量的电荷储备"
	quest.2E95EF4A43F16EE5.title: "电容器 (The Capacitor)"
	quest.58461B46723A481E.quest_desc: ["用铜板和锌板部署安山合金，即可得到设备连接器——用于连接未直接暴露电气端口的设备。如果安装了Forge Energy或Factory Must Grow，它还能自动以真实转化率（显示在工具提示中）转换为这两种能源。"]
	quest.58461B46723A481E.subtitle: "通往一切事物的桥梁"
	quest.58461B46723A481E.title: "设备连接器 (The Device Connector)"
	quest.5E006AAB8CD9501B.quest_desc: [
		"动力电网发电机由两部分组成：定子（铜线圈——用线圈物品右键点击两个转轴制成，而非放置为方块）用于产生磁场，以及电枢（转子、换向器和离合器）用于实际感应电流。通过设备连接器向定子输入少量励磁电流以启动，然后用任意 Create 旋转动力源来驱动整个装置。"
		""
		"发电机离合器（Create 离合器加安山合金）可在你的动能网络和发电机轴之间提供一个弱耦合，可通过红石调节。请在组成该装置其余部分的感应转子、换向器和外壳旁建造一个。"
	]
	quest.5E006AAB8CD9501B.subtitle: "真正的交流发电机，由旋转驱动"
	quest.5E006AAB8CD9501B.title: "发电机"
	quest.4F8518D0F850B080.quest_desc: ["在玻璃板上按顺序放置：史莱姆球，然后是抛光玫瑰石英，切割它，放置铜锭，压制它，再放置铜板——即可制成太阳能电池板。它必须朝向太阳并保持清晰的角度；障碍物、生物群系热量，甚至路上的玻璃或树叶都会降低发电量。其实际功率遵循真实的太阳能IV曲线（开路电压、短路电流，以及需要匹配负载电阻的最大功率点）——是动能发电机的一种可选替代方案。"]
	quest.4F8518D0F850B080.subtitle: "真正的IV曲线，而非平坦的输出"
	quest.4F8518D0F850B080.title: "太阳能电池板"
	quest.7DADA269F92FD78E.quest_desc: ["将红石和烈焰粉混入热水中制成酸。接着，将导电外壳（安山岩外壳加锌锭）经过3个循环——部署铜板、锌板，再填充酸——制成真正的铅酸电池。放电时，其电压和内阻都会漂移，就像真实的电池一样。"]
	quest.7DADA269F92FD78E.subtitle: "铜、锌和酸"
	quest.7DADA269F92FD78E.title: "电池 (The Battery)"
	quest.076FB027A6BD8857.quest_desc: ["每个层级都用更多金属包裹前一个：电池加8个铜锭是小电池；小电池加8个铁锭是中电池；加8个金锭是高压电池，再加8个下界合金锭就是完整的变电站电池——真正的升级链，每个层级都直接由上一个建造而成。"]
	quest.076FB027A6BD8857.subtitle: "铜，然后是铁，再是金，最后是下界合金"
	quest.076FB027A6BD8857.title: "更大的电池 (Bigger Batteries)"
	quest.59D3271BB7592CA0.quest_desc: ["LV开关（杠杆加组件）和LV按钮可手动操作。MV开关需要铜板而非普通组件。HV开关则由动能输入机械触发，而非手动拨动——就像现实中高压隔离开关绝不会直接用手触碰一样。"]
	quest.59D3271BB7592CA0.subtitle: "三种电压等级"
	quest.59D3271BB7592CA0.title: "开关装置"
	quest.02276D6D6AB924AC.quest_desc: ["玻璃板、铁板、石英和铁线可以制作成长灯——一种能加速周围作物生长的带电灯泡。"]
	quest.02276D6D6AB924AC.subtitle: "能让作物生长更快的光"
	quest.02276D6D6AB924AC.title: "生长灯 (The Growth Lamp)"
	quest.5016B70D7CAC52A1.quest_desc: ["铜板、精密机制、铁锭和导电外壳可以制作一个高压断路器。要关闭它，先上紧，然后用红石脉冲切换。无需上紧即可再次打开，但关闭时总是需要再次上紧。"]
	quest.5016B70D7CAC52A1.subtitle: "必须先上弦的开关装置"
	quest.5016B70D7CAC52A1.title: "高压断路器 (HV Breaker)"
	quest.78A8ECDF3AEE44C7.quest_desc: ["导电外壳周围的铁板和铜板可以制作成保险丝座——这是抵御电网真实模拟的过载和熔线伤害的廉价保险。"]
	quest.78A8ECDF3AEE44C7.subtitle: "在一切融化之前做好防护"
	quest.78A8ECDF3AEE44C7.title: "引信支架"
	quest.29572D949B702BFF.quest_desc: ["铜线圈、导电外壳、铁板、磁铁（经磁化工艺处理的安山合金）和转轴可组装成电动机——发电机的反向装置，将电能转化为旋转，转速由输入的电压决定。若将其与精密机制结合，则可制成恒速电机：无论电压如何，转速恒定，而电压则决定了其承受压力和旋转方向的能力。"]
	quest.29572D949B702BFF.subtitle: "电力回归运转轨道"
	quest.29572D949B702BFF.title: "电动机 (The Electric Motor)"
	quest.587C7CC42F506896.quest_desc: ["六个铜线圈、一个导电外壳和铁板可以制作一个电磁铁——通电时，它能自动拾取和处理放置在或掉落在其下方货仓（或由传送带输送）的物品。"]
	quest.587C7CC42F506896.subtitle: "附魔物品分类器"
	quest.587C7CC42F506896.title: "电磁铁 (The Electromagnet)"
	quest.0C34DE4D57EE94A4.quest_desc: ["铁板、针和2个电阻线圈可制作加热线圈——它为流经的空气加热，足够的电压能将其转化为真正的强力热量。若将其集成到盆式加热器（由5个电阻线圈、铜板和导电外壳组成的机械合成组件）中，相同的电热将直接输入到创造盆中——通过的电压越高，处理速度越快。"]
	quest.0C34DE4D57EE94A4.subtitle: "用于批量处理的电热设备"
	quest.0C34DE4D57EE94A4.title: "加热线圈"
	quest.0B1E3D1C92413D04.quest_desc: ["电流表、电压表和功率表各自读取所连接物体的单一数值。万用表（由电流表、电压表、电气装置和导电外壳制成）可同时读取三项数值，外加电阻以及整个网络的总发电量和消耗量——不过，如果你同时戴着工程师护目镜，它将无法工作。"]
	quest.0B1E3D1C92413D04.subtitle: "电流、电压、功率，以及三者同时"
	quest.0B1E3D1C92413D04.title: "阅读网格信息"
	quest.148A3705159954E0.quest_desc: ["电阻线圈加煤炭可制作电阻器。抛光玫瑰石英加铜板可制作二极管——电流仅从其浅色端流出。在铁板上按顺序组装玫瑰石英、金线，再按下，可制作NPN BJT，但也有可能意外得到PNP BJT。这三种元件是后续电路板的核心组件。"]
	quest.148A3705159954E0.subtitle: "构成真正电路的各个组成部分"
	quest.148A3705159954E0.title: "面包板组件"
	quest.67D4FF334FCCFFD8.quest_desc: ["电子管、空白蓝图、插座、铜板和导电外壳可以制作电路设计台——放置走线、放置元件，并将结果保存为蓝图，就像在真实的电路板上布线一样。成品电路板本身没有固定配方；它取决于你在设计台上实际设计的内容。"]
	quest.67D4FF334FCCFFD8.subtitle: "真正的蓝图，而非固定配方"
	quest.67D4FF334FCCFFD8.title: "设计一个电路"
	quest.504E43C5B19E8B0C.quest_desc: ["石英、煤炭、铁粒和铜粒混合（加热）成一个芯片外壳。序列组装则将完成的电路板——部署铁板、双击两次，再部署芯片外壳——组装成一个芯片：你的整个电路图被编译成一个可放置在大板上的单个组件。芯片可以嵌套在其他芯片中，直到深度限制，每种芯片大小都有自己的功耗上限。"]
	quest.504E43C5B19E8B0C.subtitle: "将电路编译成一个组件"
	quest.504E43C5B19E8B0C.title: "芯片碎片"
	quest.26EC82A98288D97B.quest_desc: ["铜板和铜锭可以制作接地棒——为你的网络提供地面参考，非常实用：无处可去的多余电流会损坏附近没有接地棒保护的任何东西。"]
	quest.26EC82A98288D97B.subtitle: "流浪电荷会代替你承受伤害的地方"
	quest.26EC82A98288D97B.title: "接地点杆 (The Grounding Rod)"
	quest.370393D5705A47B1.quest_desc: ["生成、存储、切换、电机、热量、测量，以及设计自己电路的方式——Power Grid 的电力从头到尾都表现得像真实的电力一样，而且在你需要时，它仍然可以通过 Device Connector 直接将电力输送到 Factory Must Grow 的生产线上。"]
	quest.370393D5705A47B1.subtitle: "电压、电流和电阻，都是真实的"
	quest.370393D5705A47B1.title: "Grid Online"
	quest.0C00047FF7F502A7.quest_desc: ["本章涵盖了脊柱的生成、存储、切换和电路设计。Power Grid 更进一步：串灯和模块化 CRT 显示器、穿孔卡编程器、闪电吸引器和接地危险、与下界传送门相连的变压器，以及带电的警棍和电钻等电动工具。掌握基础后，这些都值得一探。"]
	quest.0C00047FF7F502A7.subtitle: "两个电气系统，一座连接它们的桥梁"
	quest.0C00047FF7F502A7.title: "继续前进"

	quest.03FC1483DAE61F9A.quest_desc: [
		"这两个模组通常自带电力系统——Mekanism 的通用电缆和发电机，以及 Immersive Engineering 的 LV/MV/HV 线路和发电机。在本整合包中，两者均无法制作，有意为之，Power Grid 是唯一的电力系统。"
		""
		"剩下的也不少：一个能叠加使用的、与Create的压轮兼容的真正矿石翻倍处理链，外加每个模组里一些本来就不需要电力的非电动机器。"
	]
	quest.03FC1483DAE61F9A.subtitle: "处理能力，而不是发电厂"
	quest.03FC1483DAE61F9A.title: "欢迎来到机械动力和沉浸式工程的世界"
	quest.2C41DAA541055377.quest_desc: ["Power Grid的Device Connector可将自身电力转换为Forge Energy，而FE Inverter则能替代专用方块完成相同功能。两者均可直接连接到Mekanism或Immersive Engineering的机器上，无需使用模组专用线缆，因为这两个模组都接受普通Forge Energy。"]
	quest.2C41DAA541055377.subtitle: "同一座桥，只是方向相反"
	quest.2C41DAA541055377.title: "为这些机器提供动力"
	quest.44F2756E861FF620.quest_desc: ["搅拌机、金属压机和榨汁机是另外三种由沉浸式工程学的Forge能源驱动的机器——与电网相同的设备连接器或FE逆变器可为三者供电。注意，压板功能已在整个整合包中移除（TFC的砧现在是唯一的板材来源）——金属压机仍能很好地处理金属棒、齿轮和电线。"]
	quest.44F2756E861FF620.subtitle: "混合、压制、挤压"
	quest.44F2756E861FF620.title: "更多机器需要供电以提供动力"
	quest.74577891FA8723B7.quest_desc: ["Immersive Engineering 专属的合成台，由处理过的木材和铁锭制成，无需电力。该模组的大部分配方都显示在这里，而非普通的原版合成网格上。"]
	quest.74577891FA8723B7.subtitle: "一个工作台，基本上就是这样了"
	quest.74577891FA8723B7.title: "工程师工作台"
	quest.46F978979273C091.quest_desc: ["熔炉、铁锭、锇锭和红石粉——全部在合成桌上完成，无需其他机器。Mekanism 的所有加工流程都始于此：这是制造基础控制电路的唯一方法，而每种 Tier 1 机器都需要它。"]
	quest.46F978979273C091.subtitle: "Mekanism 的实际入口点"
	quest.46F978979273C091.title: "冶金学注入器 (The Metallurgic Infuser)"
	quest.0EAE3BEC95572246.quest_desc: ["向冶金注入器输入红石气体和锇锭，可获得基础控制电路。另外，钢锭、廉价玻璃和锇锭可制作钢制外壳。这两者是富集室、破碎机和能量熔炉的共同基础。"]
	quest.0EAE3BEC95572246.subtitle: "所有Mekanism机器都由什么建造而成"
	quest.0EAE3BEC95572246.title: "电路与外壳 (Circuits and Casings)"
	quest.0A33C4C95AB03DB5.quest_desc: ["富集室可将粉末或尘埃转化为下一阶段的2倍产物——这台机器能将Create自身的压轮产物翻倍。破碎机则对非本整合包矿石链的物品执行Create压轮的初步步骤。能量熔炉就是个电炉——没有倍增效应，但可以自动化且不会耗尽燃料。"]
	quest.0A33C4C95AB03DB5.subtitle: "富集、粉碎、冶炼 - 使用电力"
	quest.0A33C4C95AB03DB5.title: "Mekanism 的机器"
	quest.40935BCF9893653C.quest_desc: ["将物品组合在一起——经典用法是将原矿和鹅卵石组合成对应的原版矿石块，此外还有一些其他物品组合配方。"]
	quest.40935BCF9893653C.subtitle: "原矿石加上鹅卵石"
	quest.40935BCF9893653C.title: "组合器 (The Combiner)"
	quest.6FCF79ED902A9D95.quest_desc: ["用Create的轮子压碎矿石，再用Enrichment Chamber加倍——产量是原矿石的四倍。Mekanism的加工会更深入，如Purification、Injection、Crystallizing，但这些需要Mekanism自己的气体处理系统，本整合包并未包含。若想突破4倍，可自行探索，但并非必需。"]
	quest.6FCF79ED902A9D95.subtitle: "先创造，再机械动力"
	quest.6FCF79ED902A9D95.title: "4x 矿石加工"
	quest.5CB12DC6215C4943.quest_desc: ["Immersive Engineering 的 Crusher 能复制 Create 轮子能做的所有粉碎配方，适用于本整合包中的任何内容——不仅仅是矿石。如果你宁愿建造一台机器而不是轮轴装置，那么这是一个真正的完全替代方案，而非缩水版。"]
	quest.5CB12DC6215C4943.subtitle: "Create 齿轮的替代方案，适用于整个整合包"
	quest.5CB12DC6215C4943.title: "IE的破碎机"
	quest.58EF633CC9B323D7.quest_desc: ["将真正的 Enrichment Chamber 放入配方中，你就能得到 Basic Enriching Factory——同样是 2x 倍增，但可以并行处理多个物品，而非一次一个。这是一个真正的升级，而不是独立的机器。"]
	quest.58EF633CC9B323D7.subtitle: "富集室，数量翻倍了"
	quest.58EF633CC9B323D7.title: "富矿加工厂"
	quest.01C2E7E00E635E4F.quest_desc: ["一根线、一个铁锭和一根木棍。每个沉浸式工程的组合方块——包括电弧炉——都始于以正确形状放置的组件方块，然后用这个右键点击，将它们锁定成一个可用的机器。"]
	quest.01C2E7E00E635E4F.subtitle: "什么东西能把一堆方块变成一台机器"
	quest.01C2E7E00E635E4F.title: "工程师之锤"
	quest.6AEE3DC80ACB73CB.quest_desc: ["建造结构，然后用工程师之锤密封。用已翻倍过的富集室粉尘或块料喂养，电弧炉会再翻倍一次——是原始矿石的8倍，构成了本整合包自身矿石处理链的顶端。它还有空的添加剂槽位，用于模组中其他地方的真实合金配方，并产生炉渣作为副产品——不是废料，可以压制成炉渣砖或粉碎成炉渣砾石。"]
	quest.6AEE3DC80ACB73CB.subtitle: "该矿石链的最后一个阶段"
	quest.6AEE3DC80ACB73CB.title: "电弧熔炉"
	quest.6EFB95F24D0C0BDD.quest_desc: ["粉碎、富集、电弧熔炼——三种模组工艺叠加在同一矿石上，产量是单纯挖掘的八倍。"]
	quest.6EFB95F24D0C0BDD.subtitle: "Create、Mekanism 和 Immersive Engineering"
	quest.6EFB95F24D0C0BDD.title: "8x 矿石加工"
	quest.1356D06D154F51AC.quest_desc: ["Immersive Engineering 自带 Coke Oven，运行方式与整合包中已重定向至 The Factory Must Grow 的 Coke Oven 的煤饼相同——两者完全并行，互不冲突，你可以选择建造其中一个。"]
	quest.1356D06D154F51AC.subtitle: "第二个焦炭炉，燃料相同"
	quest.1356D06D154F51AC.title: "IE的焦炭炉"
	quest.6C45FF8565A7EFD4.quest_desc: ["与本章中几乎所有其他东西不同，合金熔炉仅靠热量和燃料运行，不需要Forge Energy。它能直接熔合金属，与TFC坩埚的功能相同，只是通过不同的机器实现。"]
	quest.6C45FF8565A7EFD4.subtitle: "这个不需要任何电力支持就能运行"
	quest.6C45FF8565A7EFD4.title: "合金熔炼炉"
	quest.2F5F3DDB0055E37E.quest_desc: ["同样完全依赖燃料，而非电力——煤炭、焦炭或木炭可将铁加热成钢，副产品为炉渣。了解这一点很重要，因为这是与TFC原有的Bloomery和Blast Furnace同属一个钢制级别的另一条途径——如果你希望保持TFC原有的铁制升级路线为唯一途径，则不应依赖此法。"]
	quest.2F5F3DDB0055E37E.subtitle: "第二条从铁到钢的进阶路线"
	quest.2F5F3DDB0055E37E.title: "IE的冲天炉"
	quest.511B48DF1DED0783.quest_desc: ["大多数沉浸式工程的线圈都因电网失效而失去了用途——但结构绳索是纯机械的（可攀爬、承重、与电力无关），而剃刀线则是由处理过的栅栏和钢制成的普通伤害陷阱。两者都仍能按预期工作。"]
	quest.511B48DF1DED0783.subtitle: "那些仍然有用的电线线圈"
	quest.511B48DF1DED0783.title: "绳索和铁丝网"
	chapter.596053404295DE98.subtitle: "去哪里探索，那里有什么在等待"
	chapter.596053404295DE98.title: "冒险：探索之旅"

	quest.3972E5BEAD693520.quest_desc: [
		"本章及其配套章节 Boss Hunting 完全独立于主线进程——完成本章的任何内容都不是完成其他章节的必要条件，反之亦然。当探索比建造更有趣时，随时加入吧。"
		""
		"本章节介绍了整合包中地牢和结构模组的内容放置位置，以及两个真正的Boss封锁维度：Otherside（通过Deep Dark进入）和Aether。"
	]
	quest.3972E5BEAD693520.subtitle: "这里没有任何通往别处的传送门"
	quest.3972E5BEAD693520.title: "欢迎来到冒险：探索之旅"
	quest.701FF404402732AD.quest_desc: ["Yung's Better Dungeons、Mineshafts、Nether Fortresses、Strongholds、Ocean Monuments 和 Better End Island 都将各自的默认结构重设计得更大、更丰富——它们完全取代了默认版本，而非并行添加。一个专门的兼容模组使 Better Dungeons 能在 TFC 的自定义生物群系中正确生成。"]
	quest.701FF404402732AD.subtitle: "完全重制，而非简单添加内容"
	quest.701FF404402732AD.title: "Yung's Structures"
	quest.7A13DE2877A91428.quest_desc: ["Moog's Mineshafts Reimagined、Nether Structures、Temples Reimagined、Voyager Structures 和 End Structures 添加了由原版方块构成的全新结构，而非替换现有内容——仅 Voyager Structures 就在所有生物群系中新增了一百多种村庄和遗迹变体。"]
	quest.7A13DE2877A91428.subtitle: "新内容，而非重新设计"
	quest.7A13DE2877A91428.title: "Moog's Structures"
	quest.3C0A13FEA6CB5385.quest_desc: ["TFC Ruins 添加了专属的地下室、海滩、富饶和小型遗迹变体。TFC Ancient City 将原版远古城市整合进 TFC 的山脉和高原群系，其关键方块与 TFC 的方块相对应，不再显得格格不入。"]
	quest.3C0A13FEA6CB5385.subtitle: "专为这个世界而生的建造"
	quest.3C0A13FEA6CB5385.title: "TFC 专属遗迹"
	quest.0B73C3EBE1E9CD6B.quest_desc: ["Beneath 将下界本身重制为 TFC 风格的非独立维度。开启方式：手持镰刀，在远古祭坛附近收集 7 份祭品（骷髅、砧、放置的金块、铸铁或黑钢），然后在距离祭品 5 格内杀死猪、山羊或绵羊——传送门便会开启，并短暂延伸至主世界。"]
	quest.0B73C3EBE1E9CD6B.subtitle: "一个仪式，而不是传送门框架"
	quest.0B73C3EBE1E9CD6B.title: "开启地下世界 Beneath 的入口"
	quest.63899A598B23CE27.quest_desc: ["下界金、下界黄铁矿、黑石硅石和下界诅咒煤是新矿石；幽灵胡椒、闪光花和绯红/扭曲根是新作物。地狱熔炉是此处的热源。没有特定的首领在等你——真正的危险是失落的书页赌书机制，如果运气耗尽，你可能会被诅咒，获得一个强化的凋零骷髅冠军。"]
	quest.63899A598B23CE27.subtitle: "新矿石，新作物，真正的风险"
	quest.63899A598B23CE27.title: "地下深处，究竟隐藏着什么秘密"
	quest.669413BD9E408B7D.quest_desc: ["通往异界的道路穿过原版深暗森林——找到一个远古城市，并杀死守卫它的卫道士。卫道士本身没有任何变化；改变的只是入口，而非目的地。"]
	quest.669413BD9E408B7D.subtitle: "深暗之地的守护者，毫无变化"
	quest.669413BD9E408B7D.title: "The Warden"
	quest.2E8C0C919AEEBEA1.quest_desc: ["在卫道士的彼岸，一个异次元传送门开启了真正的第二维度，拥有四个独特的生物群系：深地、回响森林、繁花洞穴和阴沉柱。"]
	quest.2E8C0C919AEEBEA1.subtitle: "一个完整的次级维度"
	quest.2E8C0C919AEEBEA1.title: "进入另一个世界"
	quest.5A69820872D67BBF.quest_desc: ["在异次元世界的某处，矗立着一座远古神殿——目的地建筑，也是该地区最强大居民所在之处。"]
	quest.5A69820872D67BBF.subtitle: "你来到这里想要寻找的东西"
	quest.5A69820872D67BBF.title: "远古神殿"
	quest.1A5BE1CC7A8301DD.quest_desc: ["200点生命值、类似卫道士的振动感应伏击，以及以远古神殿为地盘——潜行者才是这片区域的真正考验，远超其他任何生物。"]
	quest.1A5BE1CC7A8301DD.subtitle: "异界的顶级掠食者"
	quest.1A5BE1CC7A8301DD.title: "潜行者 (The Stalker)"
	quest.034F4F9B29CD9901.quest_desc: ["幻影、第二只潜行者、钓鱼鱼、潜行者蜈蚣、潜行者水蛭、潜行者捕手、破碎体和尖叫蠕虫——“另一面”的全部生物名单，每种各确认击杀一次。"]
	quest.034F4F9B29CD9901.subtitle: "完整的名单，一个一个来"
	quest.034F4F9B29CD9901.title: "所有潜声生物"
	quest.5D2742B2341907BC.quest_desc: ["Aether 是一个独立的天界维度，包含三个命名地下城，需依次击败前一个的守卫才能获得下一个的入口——青铜、白银，最后是黄金。本整合包的深空 Aether 扩展包新增了一个与青铜平行的第四地下城——黄铜。"]
	quest.5D2742B2341907BC.subtitle: "一个拥有真正首领阶梯的天空维度"
	quest.5D2742B2341907BC.title: "抵达以太维度 (Aether Dimension)"
	quest.541C7DC123DAADCF.quest_desc: ["这是Aether三大主要地牢中的第一个。Slider守卫着入口：400生命值，它通过冲锋和碰撞而非传统近战来攻击。"]
	quest.541C7DC123DAADCF.subtitle: "滑块"
	quest.541C7DC123DAADCF.title: "青铜地牢"
	quest.0292B80C24DD4251.quest_desc: ["Deep Aether 的专属内容，与青铜器并列而非在其之后。风暴之眼是一个分段式飞行 boss——一个 220 血量的控制器加上许多 10 血量的身体分段，每个分段都是独立的可攻击部分——漂浮在地下城上方的天空中。"]
	quest.0292B80C24DD4251.subtitle: "风暴之眼"
	quest.0292B80C24DD4251.title: "黄铜地牢"
	quest.3779CEED5DDBE3FB.quest_desc: ["滑块放下后开启。女武神女王守卫着它：500生命值，13.5攻击力，并有小女武神随从护卫。"]
	quest.3779CEED5DDBE3FB.subtitle: "瓦尔基里女王"
	quest.3779CEED5DDBE3FB.title: "银色地牢"
	quest.478AD913394258CA.quest_desc: ["这是埃特拉斯三大主地牢的最后一个，在女武神女王倒下后开启。太阳之灵守护着它：500点生命值，完全远程用火攻击，并有火焰仆从支援。"]
	quest.478AD913394258CA.subtitle: "太阳之灵"
	quest.478AD913394258CA.title: "黄金地牢"
	quest.64EE5A3DA9734BDC.quest_desc: ["真正的终极挑战：击败风暴之眼、瓦尔基里女王和太阳之灵，战斗中不能受到任何伤害。这是对技术的真正考验，而非简单的清单。"]
	quest.64EE5A3DA9734BDC.subtitle: "全部四个，不能受到任何伤害"
	quest.64EE5A3DA9734BDC.title: "Aether 冠军"
	quest.2954152D6719E018.quest_desc: ["The Otherside 已清理，Aether 的三个地牢也已攻克，连同 Deep Aether 的第四个地牢——在所有这些模组的结构中，总有下一个可以挖掘、航行或飞往的地方。"]
	quest.2954152D6719E018.subtitle: "总会有另一个建筑等着我们去探索"
	quest.2954152D6719E018.title: "探索，暂时先这样"
	chapter.3CB10A29BFFFDBD5.subtitle: "四个不同模组中真正的难度排序"
	chapter.3CB10A29BFFFDBD5.title: "冒险：首领狩猎"

	quest.1AB6DAFE4883C4E9.quest_desc: [
		"Cataclysm、Ice and Fire、Legendary Monsters 和 Bosses of Mass Destruction 各自添加了独特的 boss 列表，但它们之间缺乏横向对比。本章将所有 boss 按照实际生命值（所有模组都公开的单一数值）进行排序，分为早期、中期和晚期三个梯队，并在最末尾设置了两场真正的巅峰之战。"
		""
		"本章完全独立于主流程之外——完成本章内容并非达成其他目标的必需条件，反之亦然。"
	]
	quest.1AB6DAFE4883C4E9.subtitle: "一个难度等级，四个不同的模组"
	quest.1AB6DAFE4883C4E9.title: "欢迎来到 Boss 狩猎之旅"
	quest.454F822C907BE2F6.quest_desc: ["Apotheosis 添加了一条值得了解的装备升级路线：可镶嵌武器和护甲的附魔与宝石、可重铸的锻造台，以及一个名为 Gateways 的 Roguelike 地牢（包含 Ascent、Frontier、Summit、Pinnacle 四个难度层级），让你在挑战以下任何 boss 之前，先在这里刷取更好的装备。"]
	quest.454F822C907BE2F6.subtitle: "Apotheosis 存在"
	quest.454F822C907BE2F6.title: "开始前须知"
	quest.0651450D45B5BF4F.quest_desc: ["Ignited Revenant、Ender Golem 和 Clawdian——这三个较弱的战斗（80-225 生命值）是 Cataclysm 对其三个最强大 boss 的封锁。先击败它们，每个都会解锁其背后真正的战斗。"]
	quest.0651450D45B5BF4F.subtitle: "Cataclysm 专属的暖身战斗"
	quest.0651450D45B5BF4F.title: "早期阶段：先驱者（The Precursors）"
	quest.59F835CA7C9A5F66.quest_desc: ["远古守护者、蔓生巨像和沙丘哨兵——这三个拥有170点生命值的Boss分别守护着远古堡垒、苔藓神庙和废弃金字塔。远古守护者的攻击力远高于其生命值——20点攻击伤害，是整个榜单中原始攻击力最高的。"]
	quest.59F835CA7C9A5F66.subtitle: "传奇怪物的入口点"
	quest.59F835CA7C9A5F66.title: "早期阶段：主世界地牢"
	quest.55B4411056C7CBF5.quest_desc: ["熔岩吞噬者和骷髅龙（两者均为170-200血，传说级怪物）、枯萎的怪物（190血，同样为传说级怪物）和下界手套（250血，毁灭级首领，死亡掉落远古残骸）——构成了真正难度提升前的早期阶段。"]
	quest.55B4411056C7CBF5.subtitle: "再收集四个，然后向上移动"
	quest.55B4411056C7CBF5.title: "早期阶段：下界之战"
	quest.500DDE8060189322.quest_desc: ["虚空之花 (350，主世界的玻璃大炮 - 护甲低但血量最高)，夜之巫妖 (300，强制夜间并召唤不死军团)，和奥布西迪利斯 (300，末地生成)。如果不持续施压，三者都会恢复生命值。"]
	quest.500DDE8060189322.subtitle: "四个都闲置治疗，如果你拖延的话"
	quest.500DDE8060189322.title: "中级：毁灭性打击的领主们"
	quest.7C61C07ECF367EFE.quest_desc: ["末地守卫（333点生命，调查过的所有首领中护甲最高 - 20）、预兆者（390点，完全远程战斗）和斯库拉（390点，风暴女皇）——末地哥斯拉和爪迪安正站在它们面前。"]
	quest.7C61C07ECF367EFE.subtitle: "前驱者们所守护的东西究竟是什么"
	quest.7C61C07ECF367EFE.title: "中阶：大灾难，第一部分"
	quest.7DB4BA891D03A8DB.quest_desc: ["利维坦（400，仅在水中脆弱——在沉没之城与之战斗）、玛勒迪库斯（420，霜冻监狱）、伊格尼斯（450，燃烧竞技场，点燃的亡魂曾在此守卫）和远古残骸（450，诅咒金字塔）——灾变中期的四大结构，各自拥有专属首领。"]
	quest.7DB4BA891D03A8DB.subtitle: "四个结构，四场战斗"
	quest.7DB4BA891D03A8DB.title: "中级：大灾难，第二部分"
	quest.42E4ADF5EEBDF21A.quest_desc: ["Chorusent (200, Ancient Tower Remains)、Shulker Mimic (200, Shulker Tower)、Annihilation Pursuer (210, deep in the Space Station chain)、Cloud Golem (350, Cloudy Temple - 真正的 boss 版本，不是同名较弱小的 Cumulonimbus mob)、以及 Frostbitten Golem (220, Frostbitten Temple)。"]
	quest.42E4ADF5EEBDF21A.subtitle: "五场战斗，五种不同的建筑"
	quest.42E4ADF5EEBDF21A.title: "中阶：传奇怪物，深海尽头"
	quest.27DE5EB560B79121.quest_desc: ["600点生命值——灾变中任何生物的最高值，可通过下界的灵魂锻造匠获得。其持续伤害输出也是灾变所有首领中最高的。"]
	quest.27DE5EB560B79121.subtitle: "Cataclysm's toughest"
	quest.27DE5EB560B79121.title: "后期阶段：下界合金巨兽"
	quest.0EB9D03DD4BAE985.quest_desc: ["被附身的帕拉丁（400，废弃地窖链的终点）为前往终结者（450）扫清了道路——终结者位于空间站，深入末地分支六个进阶等级，拥有复杂的传送抓取和投掷炸弹的招式，其原始数值低估了战斗难度。这是传奇怪物模组自己设计的最终Boss。"]
	quest.0EB9D03DD4BAE985.subtitle: "传奇怪物们的真正最终首领"
	quest.0EB9D03DD4BAE985.title: "后期阶段：湮灭者（The Obliterator）"
	quest.1027B166EA5BCFC2.quest_desc: ["冰与火的三种元素龙，成年个体血量上限约为500，除共享的17点基础攻击力外，还拥有各自的元素伤害加成。每种颜色都栖息在专属的洞穴和巢穴结构中——狩猎每种颜色的成年个体。"]
	quest.1027B166EA5BCFC2.subtitle: "火、冰，还有闪电"
	quest.1027B166EA5BCFC2.title: "后期阶段：巨龙们 (The Dragons)"
	quest.1AE10373EBE7DAB0.quest_desc: ["750点生命值和30点护甲——在本整合包所有四个模组首领中，遥遥领先，毫无悬念。这才是真正的最终决战，而非击败巨龙后的走形式。"]
	quest.1AE10373EBE7DAB0.subtitle: "本章中最艰难的一场战斗"
	quest.1AE10373EBE7DAB0.title: "Apex：恐怖的女王"
	quest.49634CD032DDA4F4.quest_desc: ["四个不同模组中所有有名望的 boss，大致按你离击败他们还差多少血量来排序。血量并非全部——伤害上限、多阶段攻击和复杂的招式都重要，但这是所有模组都公开的唯一数值，也是你来到这里的原因。"]
	quest.49634CD032DDA4F4.subtitle: "总会有更艰难的战斗在某个地方等着你"
	quest.49634CD032DDA4F4.title: "狩猎完成"
	chapter.12A0CB238126E034.title: "铁匠的魔法书系列"
	chapter.12A0CB238126E034.subtitle: "长袍、符文，还有两个真正的 boss"
	quest.017192D0C1FA6DF3.title: "欢迎来到 Iron's Spellbooks"
	quest.017192D0C1FA6DF3.subtitle: "魔法也位于主进度线之外存在"
	quest.017192D0C1FA6DF3.quest_desc: [
		"Iron's Spellbooks 增加了一个完整的施法进阶线：魔法书、主题服饰、法杖和专属地牢。与其余冒险章节一样，完成此章节无需前置条件，也无需前置条件即可开始。"
		""
		"下面的路径：拿起基础站台，获取第一本魔法书，选择一个学派并装备起来，然后穿过地下墓穴和城堡，挑战两位真正的首领。"
	]
	quest.5F5C5603449D3E0E.title: "铭文工作台 (The Inscription Table)"
	quest.5F5C5603449D3E0E.subtitle: "每位施法者都从这里开始的地方"
	quest.5F5C5603449D3E0E.quest_desc: [
		"简易的初始站点——木板、木栅栏和一本书。铭文台是将卷轴刻入法术书的地方，所以是第一个要建造的。"
	]
	quest.0BFD46C47F4EB529.title: "卷轴锻造台"
	quest.0BFD46C47F4EB529.subtitle: "将墨水转化为卷轴"
	quest.0BFD46C47F4EB529.quest_desc: [
		"由抛光深板岩和哭泣黑曜石制成。卷轴锻造台将墨水变为卷轴，再由铭文台将其读入法术书。更高稀有度的卷轴需要更高等级的法术书才能容纳——脆弱的日志无法承载古代法典的力量。"
	]
	quest.29493AE0584772AC.title: "神秘锻造台 (The Arcane Anvil)"
	quest.29493AE0584772AC.subtitle: "升级球和附魔物品放在这里"
	quest.29493AE0584772AC.quest_desc: [
		"由紫晶块、钻石、铁砧和抛光深板岩制成。秘法砧可用于在装备和法术书上应用升级球和附魔，而使用剥皮石则能移除其上的附魔或升级。"
	]
	quest.52B6243D28BDBEEB.title: "你的第一本魔法书"
	quest.52B6243D28BDBEEB.subtitle: "脆弱的日志到古代法典"
	quest.52B6243D28BDBEEB.quest_desc: [
		"咒语书的等级与材料等级同步提升，顺序与原版工具一致：铜（Flimsy Journal）→铁（Ironbound Tome）→金（Apprentice's Spell Book）→钻石（Enchanted Spell Book）→下界合金（Ancient Codex）。使用铜锭、纸和线制作铜制咒语书开始。"
		""
		"卷轴墨水在炼金锅中拥有自己的五级进阶链：普通 -> (+铜锭) -> 不常见 -> (+铁锭) -> 稀有 -> (+金锭) -> 史诗 -> (+紫水晶) -> 传说。一本书只能接受自身稀有度等级或更低等级的卷轴，因此墨水链和法术书链需要同时升级。"
	]
	quest.31BF36845FE09971.title: "巫师长袍"
	quest.31BF36845FE09971.subtitle: "每个学校套装的基础都是由以下材料建造的"
	quest.31BF36845FE09971.quest_desc: [
		"由魔法布制成。巫师长袍是八套盔甲（火系、冰系、电系、牧师、暗影行者、邪教徒、远古召唤者和瘟疫系）的初始升级材料。"
	]
	quest.75BF3DBB480018AA.title: "选择一个学校"
	quest.75BF3DBB480018AA.subtitle: "八个符文，八个学派"
	quest.75BF3DBB480018AA.quest_desc: [
		"八个魔法学派各有完整的装备系列，每种都对应一个符文：火 -> 火符文，冰 -> 冰符文，闪电 -> 闪电符文，神圣 -> 神圣符文，末地 -> 末地符文，血液 -> 血液符文，召唤 -> 召唤符文，自然 -> 自然符文。将符文与巫师长袍（不限形状，或在锻造台）结合，即可升级为对应学派的盔甲套装。"
		""
		"还有两个学派——虚空学派和远古学派——但它们都没有符文、升级球或盔甲套装。远古学派需通过远古手稿（古代知识碎片和回响碎片）单独学习。"
	]
	quest.102F950AB588E6B7.title: "学校盔甲"
	quest.102F950AB588E6B7.subtitle: "此处展示的是 Pyromancer Robe，八件均为相同图案"
	quest.102F950AB588E6B7.quest_desc: [
		"一套完整的学派套装（图中为火系法师袍），相同的符文升级配方适用于八大学派中的任意一套，穿戴完整套装后，每件装备可增加一个额外的法术位。"
	]
	quest.16ED6F3090986798.title: "基础法杖（A Basic Staff）"
	quest.16ED6F3090986798.subtitle: "灰胡子、冰杖，或是工匠杖"
	quest.16ED6F3090986798.quest_desc: [
		"一开始可以制作三种法杖：灰须法杖（最便宜 - 木制铲子、铁和奥术精华）、冰霜法杖（霜冻手柄和永久冻土碎片）和工匠杖（紫水晶、绯红木板和金）。第四种，血法杖，完全无法制作 - 它只会由死王掉落。"
	]
	quest.580760B3BDA8A427.title: "法术位和属性（Spell Slots and Attributes）"
	quest.580760B3BDA8A427.subtitle: "更多插槽，更强动力"
	quest.580760B3BDA8A427.quest_desc: [
		"低级附魔书改进（魔法布和猪皮）可增加附魔书的法术容量，与护甲无关。铁质附魔书也添加了值得关注的属性——最大法力、法力再生、法术强度、施法时间和冷却缩减，以及各元素的独立魔法抗性和法术强度。"
	]
	quest.6DA1C6AB02B87073.title: "迷失的指南针 (The Wayward Compass)"
	quest.6DA1C6AB02B87073.subtitle: "指向地下墓穴的方向"
	quest.6DA1C6AB02B87073.quest_desc: [
		"由秘术精华、铁和灵魂灯笼制成。迷途罗盘指向最近的地下墓穴——守护着亡国之王的地下城。"
	]
	quest.3BEF947B1CD7566E.title: "深入地下墓穴"
	quest.3BEF947B1CD7566E.subtitle: "骨头钥匙可以打开它的宝库"
	quest.3BEF947B1CD7566E.quest_desc: [
		"跟随罗盘进入地下墓穴。探索时发现的骨钥匙可以开启地窖——前往中心王座室途中收集尽可能多的物品。"
	]
	quest.50BA79366F2A45A9.title: "死去的国王"
	quest.50BA79366F2A45A9.subtitle: "地下墓穴的领主"
	quest.50BA79366F2A45A9.quest_desc: [
		"在地下墓穴的宝座间等待。"
	]
	quest.723A36876DF94EC4.title: "国王的战利品"
	quest.723A36876DF94EC4.subtitle: "血之法杖 或 死灵之书"
	quest.723A36876DF94EC4.quest_desc: [
		"死王有几率掉落无法合成的血杖或亡灵之书。他还会留下死王之魂：收集护身符碎片，在灵魂灯笼处制作新护身符，并用它在灵魂上与他再战。"
	]
	quest.1E85EA59DC347EA4.title: "折叠地图：城堡要塞"
	quest.1E85EA59DC347EA4.subtitle: "灰烬精华与远古知识"
	quest.1E85EA59DC347EA4.quest_desc: [
		"由灰烬精华和古代知识碎片合成。此地图通往堡垒——那里有第二个真实首领和强大的精英守卫。"
	]
	quest.05706416D08D95A0.title: "泰罗斯的回响，初代火焰承载者"
	quest.05706416D08D95A0.subtitle: "城堡的真正首领"
	quest.05706416D08D95A0.quest_desc: [
		"城堡的真正首领战。必定掉落神圣灵魂碎片——两种终局毕业胸甲所需的材料——此外还有几率掉落破败镰刀或背叛者印记。"
	]
	quest.49CED4C2B3416CD9.title: "古代骑士（The Ancient Knight）"
	quest.49CED4C2B3416CD9.subtitle: "守卫城堡宝库（可选）"
	quest.49CED4C2B3416CD9.quest_desc: [
		"并非完整的 boss 战——远古骑士没有自己的 boss 条——但它是一位守卫着城堡残破钥匙和宝库的强力精英。值得清剿以获取战利品：必定掉落灰烬精华，并有几率掉落下界合金废料。"
	]
	quest.7C49618CC499FFF8.title: "秘银编织物"
	quest.7C49618CC499FFF8.subtitle: "TFC 秘银，不是模组本身的废料"
	quest.7C49618CC499FFF8.quest_desc: [
		"本整合包中，Iron's Spellbooks 的 Mithril Scrap 已被重定向，改为需要 TFC 铸造的 Mithril Sheet（Mithril 是 TFC/TFCM 的金属，史诗稀有度，可通过 Create 的矿石勘探获得）。但 Mithril Weave 本身完全跳过了重定向——它是一个由 TFC Mithril Ingot 和 Chain 组成的 3x3 配方，也是下面两种顶级胸甲的制作材料。"
	]
	quest.7BACF52EF0EB31F0.title: "光明使者胸甲"
	quest.7BACF52EF0EB31F0.subtitle: "牧师长袍 + 神圣灵魂碎片 + 秘银编织"
	quest.7BACF52EF0EB31F0.quest_desc: [
		"本模组中两件真正的毕业胸甲之一。光明胸甲由牧师胸甲、神圣灵魂碎片、秘银编织和金块升级而成。另一件，即地狱巫师胸甲，则遵循相同的配方，由火焰术士胸甲升级，但将金块替换为火岩。"
	]
	quest.7188DDBF1E752EBE.title: "成为一名完整的施法者"
	quest.7188DDBF1E752EBE.subtitle: "每个学校，两个首领，两把钥匙"
	quest.7188DDBF1E752EBE.quest_desc: [
		"全套装备：带真实法术位的学校盔甲套装、法杖，以及由首领掉落物制成的顶石胸甲。和本整合包的其他冒险内容一样，来到这里并不需要这些装备，此后的内容也同样不需要。"
	]
}
