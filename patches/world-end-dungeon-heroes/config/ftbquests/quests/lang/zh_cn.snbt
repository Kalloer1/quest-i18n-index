	quest.68AEBBB62172E280.quest_desc: [
		"找到你的咒语绑定台（确保它被书架包围着）。"
		""
		"{image:dungeon_heroes:textures/gui/spell_binding.png width:100 height:67 align:center}"
		""
		"将之前制作的法术书放入工作台。"
		""
		"消耗青金石 + 经验值来解锁你的第一个法术。"
		""
		"{image:dungeon_heroes:textures/tutorial/arcane_bind.png width:100 height:48 align:center}"
		""
		"搜刮到的法术卷轴是解锁法术的另一种廉价方式。"
		""
		"{image:dungeon_heroes:textures/tutorial/arcane_scroll.png width:100 height:48 align:center}"
		""
		"（注意：法术卷轴只能添加到匹配的魔法书中）"
	]
	quest.68AEBBB62172E280.quest_subtitle: "使用咒语绑定台来解锁一个新咒语！"
	quest.68AEBBB62172E280.title: "解锁一个新法术"
