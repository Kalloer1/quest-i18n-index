	quest.0D2003D44FCBB3E9.title: "进化"
	quest.0DE3E1490EECE64D.quest_desc: ["全部连起来：挤出机、磨石、清洗、冶炼，还有你的牧场。收集一整套铁锭。"]
	quest.0DE3E1490EECE64D.title: "自动化铁锭生产机"
