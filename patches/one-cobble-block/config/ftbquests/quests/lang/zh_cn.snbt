	quest.286F50B2C4C93187.title: "栖息地：自然闪电保护器"
	quest.29669F16DFBE0EE9.quest_desc: ["当你的岛屿达到第5阶段时解锁。"]
	quest.29669F16DFBE0EE9.title: "第五阶段"
	quest.2A005B85145356FD.quest_desc: ["捕捉 50 只宝可梦。"]
	quest.2A005B85145356FD.title: "收藏家 III"
	quest.2A02981EC557A44E.quest_desc: ["物品、流体、能量和气体，全部在一条管道中。"]
	quest.2A02981EC557A44E.title: "通用管道 (Universal Pipe)"
	quest.2A49821AA0EC01FC.quest_desc: ["传说级的钢系宝可梦。在它从方块中出来时抓住它，然后加入你的队伍。"]
	quest.2A49821AA0EC01FC.title: "Registeel"
	quest.2AA13A005DC4918D.quest_desc: ["创造：Cobblemon 整合包。将红色 Apricorn 压成薄片，再压入顶部。用锯子切割铜片，将空白部分压入底部。"]
	quest.2AA13A005DC4918D.title: "精灵球零件"
	quest.2AC067CCD96EE555.quest_desc: ["合成全息战斗塔（一台治疗机、一台显示器和一台电脑）并将其放置在你的岛屿上。用它来开始一轮挑战：训练师在每一层都会变强。"]
	quest.2AC067CCD96EE555.title: "战斗塔"
	quest.2B54D055ED5CEEB9.quest_desc: ["传说级的龙/飞行系宝可梦。在它从方块中出来时抓住它，然后加入你的队伍。"]
	quest.2B54D055ED5CEEB9.title: "裂空座"
	quest.2B9D01D0884294CE.quest_desc: ["金块上的序列组装：你的第一条真正生产线。金块现在可以直接从方块中获取。"]
	quest.2B9D01D0884294CE.title: "精密机械装置"
	quest.2BBA1798A816C9E3.quest_desc: ["用染料制作你的 PokéNav 以改变其颜色。"]
	quest.2BBA1798A816C9E3.title: "你的颜色"
	quest.2C3E4802DEA211C4.quest_desc: ["CobbleFurnies：精灵球椅子、桌子、灯和精灵球羊毛。"]
	quest.2C3E4802DEA211C4.title: "宝可梦家具模组"
	quest.2CD0ED3336A81B8D.quest_desc: ["捕捉10只钢属性的宝可梦。"]
	quest.2CD0ED3336A81B8D.title: "钢铁专家"
	quest.2D266F298A95D46F.quest_desc: ["椅子、桌子、书架等等。"]
	quest.2D266F298A95D46F.title: "又一件家具物品（Furniture）"
	quest.2ED6468D28211B53.quest_desc: ["Mega Showdown：Mega Bracelet 和正确的 Mega Stone 可在战斗中解锁新形态。Key Stone 矿石藏在散布于虚空中的漂浮陨石（Megaroid）里；Mega Stones 则生长在 Mega Site 中。"]
	quest.2ED6468D28211B53.title: "超级进化"
	quest.2EF97253851B405D.quest_desc: ["在末地或下界，它会过滤并挖掘周围的一切。"]
	quest.2EF97253851B405D.title: "数字矿工"
	quest.2F27FACDCA09CDFC.quest_desc: ["化学溶解室、洗涤器和结晶器：完整的Mekanism流程，每种矿石五个锭。"]
	quest.2F27FACDCA09CDFC.title: "矿石 ×5"
	quest.2F44EE79763A3B2C.quest_desc: ["工厂的终极挑战：自动化整条生产线（末地城获取的潜贝壳、下界合金、部分配方所需的下界之星），并生产出16个大师球。"]
	quest.2F44EE79763A3B2C.title: "大师球工厂"
	quest.2F734F056D77F526.quest_desc: ["捕捉10只虫属性的宝可梦。"]
	quest.2F734F056D77F526.title: "Bug Specialist"
	quest.2FEC6D6CD0BD79CA.quest_desc: ["仅在稀有的蘑菇岛上。毒属性的宝可梦在巨型蘑菇中茁壮成长。"]
	quest.2FEC6D6CD0BD79CA.title: "栖息地：真菌巢穴"
	quest.30DF4D5556D0CD69.quest_desc: ["储物抽屉：抽屉可存放大量单一物品。控制器可将它们全部连接起来。"]
	quest.30DF4D5556D0CD69.title: "整理好了！"
	quest.315FB1BD6A4DBFDE.quest_desc: ["放置一个宝可梦零食来吸引周围的野生宝可梦。"]
	quest.315FB1BD6A4DBFDE.title: "宝可梦零食"
	quest.3172D37A0A8F2489.quest_desc: ["罐子、麻袋、地球仪和许多实用的小方块。"]
	quest.3172D37A0A8F2489.title: "补充物品"
	quest.3174DBC150249080.quest_desc: ["发电机（热能、太阳能、风能…）和一个用于储存所发电能的能量立方。"]
	quest.3174DBC150249080.title: "Mekanism 能源"
	quest.318A03BA5EFDE940.quest_desc: ["拾起的物品会直接放入背包中。"]
	quest.318A03BA5EFDE940.title: "拾取物品升级"
	quest.32EEEBEE983B0DD8.quest_desc: ["被烧毁的橡树、桦树或云杉林，是火属性宝可梦的聚集地。"]
	quest.32EEEBEE983B0DD8.title: "栖息地：野火疤痕 (Wildfire Scars)"
	quest.32FEE83095F08EC1.quest_desc: ["捕捉25只宝可梦。"]
	quest.32FEE83095F08EC1.title: "收藏家 II"
	quest.33060962A92382B8.quest_desc: ["速度加倍，可容纳三张升级卡。"]
	quest.33060962A92382B8.title: "高级处理器"
	quest.3319C94CE2684C44.quest_desc: ["捕捉、击败并进化宝可梦来培育这棵树。它的最后一个技能，野性呼唤，有时会使额外的野生宝可梦从方块中现身。"]
	quest.3319C94CE2684C44.title: "训练师"
	quest.33D69322325C1B9A.quest_desc: ["击败500只野生宝可梦。"]
	quest.33D69322325C1B9A.title: "老兵"
	quest.33F9DEE3E7BE0C7C.quest_desc: ["传说级的岩石系宝可梦。在它从方块中出来时抓住它，然后加入你的队伍。"]
	quest.33F9DEE3E7BE0C7C.title: "雷吉洛克"
	quest.347AFFE5C6383816.quest_desc: ["在砧板上切食物。"]
	quest.347AFFE5C6383816.title: "刀"
	quest.35318D85DBDBF88B.quest_desc: ["旋转放置方块，或使用潜行+右键瞬间拾取。"]
	quest.35318D85DBDBF88B.title: "扳手"
	quest.35C139102FB99314.quest_desc: ["将物品搬进搬出背包、传送带和仓库。"]
	quest.35C139102FB99314.title: "漏斗和滑道"
	quest.35E7FB9BFAB4A8C0.quest_desc: ["无定形配方、合金和流体，全部自动化。"]
	quest.35E7FB9BFAB4A8C0.title: "搅拌机和盆子"
	quest.36184736A4BD5EAE.quest_desc: ["铜矿石有时会从方块中掉落。在熔炉里冶炼它：每个精灵球都需要铜。"]
	quest.36184736A4BD5EAE.title: "铜矿石"
	quest.362845899777FBF7.quest_desc: ["用铁升级以获得更多槽位，然后是金、钻石和下界合金。"]
	quest.362845899777FBF7.title: "更大的背包模组 (Bigger Backpack)"
	quest.3642B2215B01D4F9.quest_desc: ["捕捉10只龙属性的宝可梦。"]
	quest.3642B2215B01D4F9.title: "龙之专家"
	quest.367F290F42149220.quest_desc: ["激进的 Cobblemon 训练家：你的训练家卡显示了你的等级上限和已击败的训练家。"]
	quest.367F290F42149220.title: "训练师卡片"
	quest.376D5ECE77BE3144.quest_desc: ["传说级的格斗系宝可梦。在它破块而出时捕捉，然后加入队伍。阅读两卷卷轴中的一卷，将其进化为Urshifu。"]
	quest.376D5ECE77BE3144.title: "Kubfu"
	quest.3A4214C38A2D63C7.quest_desc: ["一个能使用物品来组装你面前物品的机械臂。它会组装你的精灵球。"]
	quest.3A4214C38A2D63C7.title: "部署器"
	quest.3AC8E7895C5D5787.quest_desc: ["机械压机需要整整一个铁块。但它很值得：能把锭变成薄片。"]
	quest.3AC8E7895C5D5787.title: "巨额投资"
	quest.3AE607C1878E11D1.quest_desc: ["传说级的飞行系宝可梦。在它从方块中出来时抓住它，然后加入你的队伍。揭示玻璃会在自然力量的两种形态之间切换。"]
	quest.3AE607C1878E11D1.title: "Tornadus"
	quest.3B36200DED86C029.quest_desc: ["捕捉10只格斗属性的宝可梦。"]
	quest.3B36200DED86C029.title: "战斗专家"
	quest.3C31ED426453338D.quest_desc: ["建造旋转机器。流动水中的水车是最简单的来源；风车也行。"]
	quest.3C31ED426453338D.title: "旋转动力"
	quest.3C3F09C1F3782CF8.quest_desc: ["一种毒属性的究极异兽。在它从方块中出来时捕捉，然后加入你的队伍。"]
	quest.3C3F09C1F3782CF8.title: "波荡皮"
	quest.3CE82BDE6E6833BF.quest_desc: ["虚空中没有要塞，所以没有末地传送门可寻。收集12个末影之眼（末影珍珠和烈焰粉，或从方块箱中获得），你将获得传送门的12个框架。将它们像要塞一样朝内围成一圈，然后加入眼睛。"]
	quest.3CE82BDE6E6833BF.title: "通往末地的传送门"
	quest.3D63AAE6FD99EBB4.quest_desc: ["当你的岛屿达到第5阶段时解锁。"]
	quest.3D63AAE6FD99EBB4.title: "第五阶段"
	quest.3DC669AC38FA676D.quest_desc: ["金块、锭和方块会自动转换。"]
	quest.3DC669AC38FA676D.title: "紧凑型抽屉"
	quest.3E059A0AF3C99C9F.quest_desc: ["一种悖论草/超能力系的宝可梦。在它从方块中出来时捕捉，然后加入你的队伍。"]
	quest.3E059A0AF3C99C9F.title: "铁树叶 (Iron Leaves)"
	quest.3E13CE882E876E3A.quest_desc: ["在移动装置上，它能收割作物而不会破坏作物。"]
	quest.3E13CE882E876E3A.title: "收割机"
	quest.3EFF4611FAD94615.quest_desc: ["Refined Storage (第3阶段)：将整个网络装进口袋。"]
	quest.3EFF4611FAD94615.title: "无线电网 (Wireless Grid)"
	quest.3F452D140A574530.quest_desc: ["OneBlock 旁边的钻头可以帮你打破它：自动化方块本身的第一步！"]
	quest.3F452D140A574530.title: "机械钻头"
	quest.40754A1FB10CDF53.quest_desc: ["沙地生物群系中的绿洲、阴凉岩石和烈日炙烤的空地。地面型宝可梦喜欢它们。"]
	quest.40754A1FB10CDF53.title: "栖息地：沙漠"
	quest.4080D462CC771DED.quest_desc: ["锇、锡、铅、铀和萤石矿石现在会从方块中产出。锇是Mekanism的金属。"]
	quest.4080D462CC771DED.title: "锇（Osmium）"
	quest.40EC9B458B62FB65.quest_desc: ["升级后的 Cobblemon 篝火锅烹饪速度更快，从铜到下界合金。"]
	quest.40EC9B458B62FB65.title: "改良版篝火锅 (Better Campfire Pot)"
	quest.41A721E548DD0014.quest_desc: ["传说级的黑暗/火属性宝可梦。在它从方块中出来时抓住它，然后加入你的队伍。"]
	quest.41A721E548DD0014.title: "奇玉 (Chi-Yu)"
	quest.4208AA462F46AE63.quest_desc: ["PokéNav会列出你所在位置可能出现的宝可梦，并追踪你选择的那只。铜、铁、钻石、Electirizer和Up-Grade。"]
	quest.4208AA462F46AE63.title: "PokéNav"
	quest.4231C275FD776216.quest_desc: ["Silvère 使用钢系和岩石系宝可梦战斗。也捕捉几只你自己的吧。"]
	quest.4231C275FD776216.title: "钢铁船员"
	quest.4263BEE97838ED33.quest_desc: ["卷心菜和番茄种子、洋葱、大米、Hearty Grains 和 Vivichoke 种子藏在第 1 阶段的箱子中。"]
	quest.4263BEE97838ED33.title: "新作物"
	quest.42820B2D001B3121.quest_desc: ["大小齿轮可以改变旋转速度。"]
	quest.42820B2D001B3121.title: "齿轮"
	quest.42B341AE019A554A.quest_desc: ["用风扇吹动水流来清洗砾石：能得到打火石和铁粒。大量砾石意味着大量铁。"]
	quest.42B341AE019A554A.title: "批量清洗"
	quest.42BD0ECDCFA02650.quest_desc: ["捕捉10只水属性的宝可梦。"]
	quest.42BD0ECDCFA02650.title: "水之专家"
	quest.43370808FACCB969.quest_desc: ["部署器连接顶部和底部。从 Apricorn 树开始自动化整个链条，装满一叠。"]
	quest.43370808FACCB969.title: "精灵球制造厂"
	quest.437A6A7B876C24D8.quest_desc: ["Silvère的宝可梦等级为28至32级，你的上限现在是32级，即他最强宝可梦的等级。"]
	quest.437A6A7B876C24D8.title: "准备好迎接西尔弗了吗"
	quest.44B0CB93060A3B0D.quest_desc: ["进化10只宝可梦。"]
	quest.44B0CB93060A3B0D.title: "进化爱好者"
	quest.453FC00769DEE9B8.quest_desc: ["在点燃的烈焰燃烧器上的盆中混合铜和锌。"]
	quest.453FC00769DEE9B8.title: "黄铜"
	quest.4574D68864A07416.quest_desc: ["冰块有时会从方块中掉落：把它放在岛屿的火炬旁，它就会融化成水。保留两个冰块：两个水源并排放置可形成无限水源，创造模式第一阶段需要它。水桶需要铁（第一阶段），但方块里的箱子有时会装有水桶。"]
	quest.4574D68864A07416.title: "一个水源方块（Water Source）"
	quest.4677371F5BEFD901.quest_desc: ["金锭周围的黄黑相间杏角。白黑相间的杏角树苗现在会从方块中长出。"]
	quest.4677371F5BEFD901.title: "超球 (Ultra Balls)"
	quest.46893E765507CC5C.quest_desc: ["铁锭周围的蓝色和红色杏核：对抗更强宝可梦的更佳选择。"]
	quest.46893E765507CC5C.title: "伟大的球体"
	quest.468A7EA81707E49E.quest_desc: ["用捕虫网将宝可梦从水中钓起。它由钓鱼竿、精灵球和捕虫网模板在锻造台制作：用普通鱼竿在宝藏中找一个，然后复制。添加鱼饵以吸引某些种类。"]
	quest.468A7EA81707E49E.title: "神奇宝贝球竿"
	quest.468FD92E7504075B.quest_desc: ["将锭放在压床下方的料仓或传送带上。"]
	quest.468FD92E7504075B.title: "铁质板材"
	quest.47C4D0C1391A8B01.quest_desc: ["你的宝可梦图鉴会记录你看到和捕捉到的所有宝可梦。制作一个，然后点击右键打开。"]
	quest.47C4D0C1391A8B01.title: "宝可梦图鉴"
	quest.47E272DB2DB104B0.quest_desc: ["拾起物品并将其放置到你指向的任何地方。"]
	quest.47E272DB2DB104B0.title: "机械臂"
	quest.47EE0CE3F90FD30C.quest_desc: ["可独立运作，并能制作大于 3×3 配方的合成台。"]
	quest.47EE0CE3F90FD30C.title: "机械工匠 (Mechanical Crafters)"
	quest.48A0D451F5B7EA60.quest_desc: ["虚空之中散布着小型浮空岛：Cobblemon栖息地。每个栖息地都会吸引宝可梦聚集在其方块周围。站在栖息地内即可发现它。传送石和飞空艇让旅行更轻松。"]
	quest.48A0D451F5B7EA60.title: "栖息地 The Habitats"
	quest.493E6CB07B6D0F81.quest_desc: ["英雄之剑和英雄之盾正等待在骑士英雄的王座室：带回一件以唤醒Zacian或Zamazenta。"]
	quest.493E6CB07B6D0F81.title: "英雄们的遗迹 Relics of the Heroes"
	quest.496C875B352B3098.quest_desc: ["Pipez：简易轻便的管道。用扳手配置每一侧。"]
	quest.496C875B352B3098.title: "物品管道 (Item Pipes)"
	quest.4ABCCB57F5A936DC.quest_desc: ["Marine的宝可梦等级为45至50，你的等级上限现在也是50，即她最强宝可梦的等级。"]
	quest.4ABCCB57F5A936DC.title: "准备好迎接海洋生物了吗"
	quest.4B56D5CA2DAD4D82.quest_desc: ["雪地中的冰锥、洞穴、岩洞和温泉：冰系宝可梦的家园。"]
	quest.4B56D5CA2DAD4D82.title: "栖息地：雪原"
	quest.4BF65C8B99A64E76.quest_desc: ["传说级的火/飞行系宝可梦。在它从方块中出来时捕捉，然后加入你的队伍。"]
	quest.4BF65C8B99A64E76.title: "Ho-Oh"
	quest.4C0888A9E47FC7C9.quest_desc: ["自冒险开始以来捕捉了100只宝可梦。其余的由图鉴章节追踪。"]
	quest.4C0888A9E47FC7C9.title: "百次捕获"
	quest.4C15803004FBCDAA.quest_desc: ["当你的岛屿达到第2阶段时解锁。"]
	quest.4C15803004FBCDAA.title: "第二阶段"
	quest.4C565E342FC174EB.quest_desc: ["会随着升级而长大的桶和箱子。"]
	quest.4C565E342FC174EB.title: "Sophisticated Barrel"
	quest.4D90A598DB55CE2F.quest_desc: ["外壳中的螺旋桨。吹过水，可冲走物品；吹过岩浆，可将其熔炼。"]
	quest.4D90A598DB55CE2F.title: "Encased Fan"
	quest.4ED7C51BDFBB1623.quest_desc: ["当你的岛屿达到第5阶段时解锁。"]
	quest.4ED7C51BDFBB1623.title: "第五阶段"
	quest.4F7D3200DC1DCF53.quest_desc: ["传说级的冰系宝可梦。在它从方块中出来时抓住它，然后加入你的队伍。"]
	quest.4F7D3200DC1DCF53.title: "Regice"
	quest.4FA68FBD1AD542C8.quest_desc: ["打破脚下的方块：它会每次回来都带着新东西。掉落物会留在上面。"]
	quest.4FA68FBD1AD542C8.title: "第一块方块"
	quest.4FEBD0937DACEEF4.quest_desc: ["深海尖塔与漂浮冰山。水属性宝可梦需要水：带点水来，或用钓竿钓鱼。"]
	quest.4FEBD0937DACEEF4.title: "栖息地：开阔的海洋"
	quest.504B1B870C3A123F.quest_desc: ["捕捉10只黑暗属性的宝可梦。"]
	quest.504B1B870C3A123F.title: "黑暗专家"
	quest.513B28B9BBA11BF5.quest_desc: ["PokéFinder指向最近的宝可梦。任意颜色的树果、指南针、铜和Electirizer。"]
	quest.513B28B9BBA11BF5.title: "PokéFinder"
	quest.518690843DC968FE.quest_desc: ["传说级的普通系宝可梦。在它从方块中出来时抓住，然后加入你的队伍。"]
	quest.518690843DC968FE.title: "雷吉奇卡斯"
	quest.51D2E9918320C7AF.quest_desc: ["捕捉5只钢系宝可梦来填满你的牧场。"]
	quest.51D2E9918320C7AF.title: "钢铁船员团"
	quest.5206489D4A47EFB8.quest_desc: ["捕捉150只宝可梦。"]
	quest.5206489D4A47EFB8.title: "150 种宝可梦"
	quest.521F05D919E52319.quest_desc: ["队伍里有六只宝可梦：随时准备应对一切。"]
	quest.521F05D919E52319.title: "完整团队"
	quest.5230B27D7503A614.quest_desc: ["四天王和冠军想再战一场，比以往更强（等级92至100）。岛屿菜单→[首领]：逐个挑战。服务器每周一次重赛，单人模式每3小时游戏时间；获胜者可获得联盟奖章、稀有糖果和能力碎片。"]
	quest.5230B27D7503A614.title: "联盟重赛"
	quest.526CED0031C1CC5A.quest_desc: ["牧场里的宝可梦会偶尔掉落物品：阿罗娜会掉落生铁，罗格恩罗拉会掉落铜，罗利可利会掉落煤炭…"]
	quest.526CED0031C1CC5A.title: "牧场战利品"
	quest.5279598564B46349.quest_desc: ["捕捉10只妖精属性的宝可梦。"]
	quest.5279598564B46349.title: "仙女专家"
	quest.534802254D3FC862.quest_desc: ["将宝可梦升到30级。注意等级上限：击败阶段首领才能升级。"]
	quest.534802254D3FC862.title: "经验丰富者"
	quest.5356787D01AECD59.quest_desc: ["磨石将鹅卵石碾成砾石：未来你获取铁的来源。"]
	quest.5356787D01AECD59.title: "磨坊石"
	quest.53592938903DF25C.quest_desc: ["树的每一层都会提供一个技能点。打破几个方块，用 J 打开你的树，并将第一个点花在“方块矿工”上。每棵树都会独立升级，并有自己的活动。"]
	quest.53592938903DF25C.title: "一项新技能"
	quest.5364082DD319E670.quest_desc: ["电解分离器提供的氧气，使净化室每块矿石产出三锭。"]
	quest.5364082DD319E670.title: "矿石 ×3"
	quest.53BCD784DF23288B.quest_desc: ["木块中会生成 Apricorn 树苗。将它们种在泥土上：它们的果实是每种 Poké Ball 的基础。提示：反复蹲在它们旁边可以加快生长速度。"]
	quest.53BCD784DF23288B.title: "Apricorn Grove"
	quest.55371EB02CFD4DFE.quest_desc: ["茂盛或干旱的泥炭沼泽，是结实格斗系宝可梦的训练场。"]
	quest.55371EB02CFD4DFE.title: "栖息地：泥炭沼泽"
	quest.5551CBBA542B4A08.quest_desc: ["石英和硅制成处理器；控制器为整个网络供电。"]
	quest.5551CBBA542B4A08.title: "Refined Storage"
	quest.55625BFA5DD44551.quest_desc: ["水泵、储罐和喷嘴：移动和使用水、岩浆等。"]
	quest.55625BFA5DD44551.title: "流体"
	quest.55F4DAF90AB3ECAE.quest_desc: ["捕捉600只宝可梦。"]
	quest.55F4DAF90AB3ECAE.title: "600 宝可梦"
	quest.565A55D4C1063D35.quest_desc: ["四个红杏果围着一个铜锭可以制作出四个精灵球。"]
	quest.565A55D4C1063D35.title: "自制的精灵球"
	quest.568F54664F28E804.quest_desc: ["温带平原和森林中的浆果丛、池塘和阳光充足的空地。最常见的栖息地。"]
	quest.568F54664F28E804.title: "栖息地：草地 (Meadows)"
	quest.56D95BE5DE192A10.quest_desc: ["传说级的格斗系宝可梦。在它破块而出时捕捉，然后加入队伍。给予它生锈的盾牌，以唤醒其加冕形态。"]
	quest.56D95BE5DE192A10.title: "Zamazenta"
	quest.56FB461130AF17D7.quest_desc: ["因为，为什么不呢。"]
	quest.56FB461130AF17D7.title: "土豆大炮"
	quest.5AE688696D16F999.quest_desc: ["激活一块传送石，即可从任何其他传送石处传回。"]
	quest.5AE688696D16F999.title: "传送石"
	quest.5AEB3EE6BADBE82C.quest_desc: ["传说级的电/飞行属性宝可梦。在它从方块中出来时抓住它，然后加入你的队伍。"]
	quest.5AEB3EE6BADBE82C.title: "Zapdos"
	quest.5CAD96BDB7294441.quest_desc: ["传说宝可梦几乎不会待在普通球里。大师球的第一步：盖子，由潜贝壳和下界合金制成，使用Create序列组装器或Mekanism组合器。配方请在JEI中查看。"]
	quest.5CAD96BDB7294441.title: "大师球盖子"
	quest.5CC2BFFEF1EAC770.quest_desc: ["高级机器需要精英控制电路（精炼黑曜石和强化合金）。"]
	quest.5CC2BFFEF1EAC770.title: "精英电路"
	quest.5DB375F43D2FA1B1.quest_desc: ["创造：Power Loader 会在你旅行时保持工厂的加载。"]
	quest.5DB375F43D2FA1B1.title: "Always Running"
	quest.5E2D1B852B61F437.quest_desc: ["浆果能治愈你的宝可梦，还能烹饪成多种食谱。种植它们来收获更多。"]
	quest.5E2D1B852B61F437.title: "浆果"
	quest.5EBB433EE59F929D.quest_desc: ["最终目标：访问全部30个Cobblemon栖息地。"]
	quest.5EBB433EE59F929D.title: "栖息地大师"
	quest.5FF864B8D67692CE.quest_desc: ["布劳图斯擅长使用格斗属性的宝可梦。"]
	quest.5FF864B8D67692CE.title: "精英四强：布鲁图斯 (Brutus)"
	quest.609217ADFE2F53C4.quest_desc: ["自动化所有主要资源。每种显示一叠。"]
	quest.609217ADFE2F53C4.title: "Everything Automated"
	quest.60D9F8066F75D739.quest_desc: ["强力胶将方块粘合，并用机械轴承使其移动。"]
	quest.60D9F8066F75D739.title: "机械装置（Contraptions）"
	quest.61E7BBECB0B33CBA.quest_desc: ["当你的岛屿达到第1阶段时解锁。"]
	quest.61E7BBECB0B33CBA.title: "第一阶段"
	quest.620E5148A1C0F47C.quest_desc: ["可升级的箱子和桶：更多格子、堆叠、过滤器和自动化。"]
	quest.620E5148A1C0F47C.title: "Sophisticated Storage"
	quest.62197618341A7721.quest_desc: ["四神中的最后一位，诺克斯，在黑暗中战斗。"]
	quest.62197618341A7721.title: "精英四强：Nox"
	quest.62D86832C4145121.quest_desc: ["直接从你的网络中搜索和合成。"]
	quest.62D86832C4145121.title: "合成网格"
	quest.633C21FCAE282EE1.quest_desc: ["Tung的宝可梦等级为15至17级。目前，你的宝可梦在20级后停止获得经验：击败首领会提高这个上限。"]
	quest.633C21FCAE282EE1.title: "训练模式"
	quest.638F92CBB0644936.quest_desc: ["火、水、雷和叶石矿石现在会从方块中产出。"]
	quest.638F92CBB0644936.title: "进化石"
	quest.63A02574E7F8798D.quest_desc: ["你的对手使用三只宝可梦战斗。你的队伍中至少要有三只。"]
	quest.63A02574E7F8798D.title: "真正的团队"
	quest.648E8020961A2F4B.quest_desc: ["当你的岛屿达到第1阶段时解锁。"]
	quest.648E8020961A2F4B.title: "第一阶段"
	quest.64F89ECCB4B33D3D.quest_desc: ["将宝可梦培育至50级。"]
	quest.64F89ECCB4B33D3D.title: "资深训练师"
	quest.6632C975B6211FA5.quest_desc: ["在阶段0种植所有颜色的Apricorn：红色、蓝色和黄色，阶段1种植绿色和粉色，阶段2种植白色和黑色。"]
	quest.6632C975B6211FA5.title: "所有的小马驹蛋（所有的小马驹蛋）"
	quest.67BE5E70892C81F1.quest_desc: ["将模式编码到模式网格中，然后放置在自动合成器中：网络会按需进行合成。"]
	quest.67BE5E70892C81F1.title: "自动合成"
	quest.68FA3CDE3305D0C1.quest_desc: ["终极控制电路，用于游戏中最强大的机器。"]
	quest.68FA3CDE3305D0C1.title: "终极版"
	quest.6968F739B7F2EC4D.quest_desc: ["将抽屉的容量扩大数倍。"]
	quest.6968F739B7F2EC4D.title: "储物升级"
	quest.698064745C1E55F2.quest_desc: ["捕捉10只岩石属性的宝可梦。"]
	quest.698064745C1E55F2.title: "岩石专家"
	quest.6A1F50D04E0133DD.quest_desc: ["Tera Orb 可以在战斗中改变宝可梦的类型。"]
	quest.6A1F50D04E0133DD.title: "Terastallization"
	quest.6A7A863777ED7392.quest_desc: ["用于生产线的巨型多区块存储装置。"]
	quest.6A7A863777ED7392.title: "物品宝库"
	quest.6A87F57E6BEA7A22.quest_desc: ["游戏提示时选择你的初始宝可梦（或用 M 打开摘要）。用 R 派出它。"]
	quest.6A87F57E6BEA7A22.title: "一位伙伴"
	quest.6AAF7BB14E5EEE1F.quest_desc: ["右键和声合金与去皮的原木以制作外壳：每台机器都围绕一个外壳建造。"]
	quest.6AAF7BB14E5EEE1F.title: "安山岩外壳"
	quest.6B30A0EAE22BB188.quest_desc: ["用手发电，等待水流到来。"]
	quest.6B30A0EAE22BB188.title: "手动曲柄"
	quest.6B4AAC1AF7CDA00A.quest_desc: ["捕捉10只幽灵属性的宝可梦。"]
	quest.6B4AAC1AF7CDA00A.title: "幽灵专家"
	quest.6B9A6BCB21A95AC9.quest_desc: ["当你的岛屿达到第1阶段时解锁。"]
	quest.6B9A6BCB21A95AC9.title: "第一阶段"
	quest.6BAA1AA6CEDC8075.quest_desc: ["传说级的妖精/飞行系宝可梦。在它从方块中出来时捕捉，然后加入队伍。揭示玻璃会在自然的两股力量之间切换形态。"]
	quest.6BAA1AA6CEDC8075.title: "Enamorus"
	quest.6C0A0836B84A8CEA.quest_desc: ["流体储罐、烈焰燃烧器和蒸汽引擎：Create 最强的动力。"]
	quest.6C0A0836B84A8CEA.title: "蒸汽动力"
	quest.6CB5190D85C7A87A.quest_desc: ["传说级的火/飞行系宝可梦。在它从方块中出来时捕捉，然后加入你的队伍。"]
	quest.6CB5190D85C7A87A.title: "Moltres"
	quest.6D0A170E6FACA234.quest_desc: ["捕捉10只飞行属性的宝可梦。"]
	quest.6D0A170E6FACA234.title: "飞行专家"
	quest.6D422E120D98984E.quest_desc: ["传说级的妖精系宝可梦。在它从方块中出来时抓住，然后加入队伍。给它生锈的剑，就能唤醒它的加冕形态。"]
	quest.6D422E120D98984E.title: "Zacian"
	quest.6DAE1AB52930DE1C.quest_desc: ["传说级的龙/地面系宝可梦。在它从方块中出来时捕捉，然后加入队伍。齐卡古立方体会储存细胞并改变形态。"]
	quest.6DAE1AB52930DE1C.title: "Zygarde"
	quest.6F3A76830F7FCFAC.quest_desc: ["在方块周围放置泥土来扩建你的岛屿。当空间足够时，野生宝可梦会自行出现在草地上。"]
	quest.6F3A76830F7FCFAC.title: "成长的空间"
	quest.7015F4A1299EAB92.quest_desc: ["铁矿石现在会从方块中产出，但很少见。保存好每个锭：你的第一台机器需要它。"]
	quest.7015F4A1299EAB92.title: "珍贵的铁块 (Precious Iron)"
	quest.71D70C1E40791825.quest_desc: ["干海带块现在可以分解了：六个干海带可以做一个腰带。用它连接两个竖井。"]
	quest.71D70C1E40791825.title: "传送带系统 (Conveyor Belts)"
	quest.7203981A1B283CA2.quest_desc: ["带一只宝可梦到最顶端去。"]
	quest.7203981A1B283CA2.title: "等级 100"
	quest.721BB72D06B00993.quest_desc: ["传说级的龙系宝可梦。在它从方块中出来时抓住它，然后加入你的队伍。"]
	quest.721BB72D06B00993.title: "雷吉德拉戈"
	quest.72BFAC69309917C3.quest_desc: ["突袭巢穴需要坚实的地面，因此不会在虚空生成：冠军留下了突袭巢穴水晶。将其放置在你的岛屿上，与巨型宝可梦一同作战。5星及以上的突袭会掉落突袭碎片；巢穴每两小时会更换宝可梦和等级。"]
	quest.72BFAC69309917C3.title: "突袭巢穴"
	quest.72DADAF7FA8E80AB.quest_desc: ["传说级的龙/超能力系宝可梦。在它从方块中出来时捕捉，然后加入你的队伍。"]
	quest.72DADAF7FA8E80AB.title: "拉帝欧斯"
	quest.72E08216D576331F.quest_desc: ["一种神话般的黑暗/草系宝可梦。当它从方块中出来时抓住它，然后把它加入你的队伍。"]
	quest.72E08216D576331F.title: "Zarude"
	quest.72EB194A846DFE5B.quest_desc: ["当你的岛屿达到第5阶段时解锁。"]
	quest.72EB194A846DFE5B.title: "第五阶段"
	quest.7301E5D7942A2D78.quest_desc: ["传说级的地面/飞行系宝可梦。在它从方块中出来时捕捉，然后加入队伍。揭示玻璃会在自然的两股力量之间切换形态。"]
	quest.7301E5D7942A2D78.title: "Landorus"
	quest.7338ECCF119DC348.quest_desc: ["传说级的超能力系宝可梦。在它从方块中出来时抓住，然后加入你的队伍。"]
	quest.7338ECCF119DC348.title: "Mewtwo"
	quest.7345B7BDC2A03375.quest_desc: ["有些宝可梦可以骑乘：步行、游泳或飞行。"]
	quest.7345B7BDC2A03375.title: "骑上它去"
	quest.74108F3B9F3D0E92.quest_desc: ["将阿伦、磁石怪、青铜钟或齿轮怪放入牧场：它们会偶尔掉落生铁。阿伦和磁石怪现在会从方块中出来。奖励：背包的磁铁升级，可吸引附近的物品。"]
	quest.74108F3B9F3D0E92.title: "工作中的宝可梦"
	quest.74A0D57BF8FADB92.quest_desc: ["捕捉10只冰属性的宝可梦。"]
	quest.74A0D57BF8FADB92.title: "冰雪专家"
	quest.74C70DF4751532F4.quest_desc: ["石头和鹅卵石从方块中产出。石制镐可以开采阶段0提供的一切。"]
	quest.74C70DF4751532F4.title: "石器时代"
	quest.74FD62B2BD920AE2.quest_desc: ["捕捉10只超能力属性的宝可梦。"]
	quest.74FD62B2BD920AE2.title: "心灵感应专家"
	quest.75F27B376AE1720C.quest_desc: ["传说级的普通系宝可梦。在它从方块中出来时抓住，然后加入你的队伍。"]
	quest.75F27B376AE1720C.title: "Terapagos"
	quest.76081DA438C9A279.quest_desc: ["西比尔用超能力系宝可梦读取你的行动。"]
	quest.76081DA438C9A279.title: "精英四强：西比尔（Sibylle）"
	quest.765E02573F9A6143.quest_desc: ["当你的岛屿达到第1阶段时解锁。"]
	quest.765E02573F9A6143.title: "第一阶段"
	quest.770893C6F0A9E356.quest_desc: ["击败20只野生宝可梦来训练你的队伍。"]
	quest.770893C6F0A9E356.title: "练习对战"
	quest.77255D3C2EA07E44.quest_desc: ["看看你看到的每台机器的速度和压力。"]
	quest.77255D3C2EA07E44.title: "工程师护目镜"
	quest.7899FBE049EEFAB5.quest_desc: ["化学注射室中的氯化氢：每种矿石四个锭。"]
	quest.7899FBE049EEFAB5.title: "矿石 ×4"
	quest.78CF867CD1C5139B.quest_desc: ["一台治疗机可以恢复全队。需要红石（在方块中）和Max Revive：两个Revive和一个Vivichoke放在篝火锅中。Revival Herbs和Vivichoke种子藏在方块第1阶段的箱子里：把它们种下。"]
	quest.78CF867CD1C5139B.title: "治疗机器"
	quest.78E4170A9B4BB4CD.quest_desc: ["Cobblemon 篝火锅可以为你的宝可梦烹饪零食和美食。"]
	quest.78E4170A9B4BB4CD.title: "Cobblemon 烹饪"
	quest.78FD6054F64C1D5A.quest_desc: ["创建附魔产业：液态经验和为你附魔的烈焰人。"]
	quest.78FD6054F64C1D5A.title: "附魔工业 Enchantment Industry"
	quest.792D0655418A7BB8.quest_desc: ["流体管道和能量管道的工作原理相同。"]
	quest.792D0655418A7BB8.title: "流体与能量"
	quest.796250915FAF20DD.quest_desc: ["传说级的龙/超能力系宝可梦。在它从方块中出来时捕捉，然后加入你的队伍。"]
	quest.796250915FAF20DD.title: "拉帝亚斯"
	quest.79C3967A356FC944.quest_desc: ["传说级的冰/飞行系宝可梦。在它从方块中出来时抓住它，然后加入你的队伍。"]
	quest.79C3967A356FC944.title: "Articuno"
	quest.79CC6BFFAEFDA249.quest_desc: ["几乎所有Mekanism机器都需要钢。多做一些吧。"]
	quest.79CC6BFFAEFDA249.title: "钢铁"
	quest.79CC6EF7566E130D.quest_desc: ["Crafts & Additions：交流发电机将旋转转化为能量（FE）。它连接了Create和Mekanism。"]
	quest.79CC6EF7566E130D.title: "电力"
	quest.79EF8BF6193C1AB6.quest_desc: ["游戏后期，该方块有时会变成加勒粒子矿石或远古残骸：纪念碑的仪式需要它们掉落的东西。"]
	quest.79EF8BF6193C1AB6.title: "加勒尔粒子"
	quest.7B58C8DBDD4770BF.quest_desc: ["捕捉10只普通属性的宝可梦。"]
	quest.7B58C8DBDD4770BF.title: "普通专家型生物"
	quest.7C935F4D0BBA8AE0.quest_desc: ["与怪物战斗、钓鱼、旅行到其他维度来种植这棵树：专为下界、末地和遥远栖息地而造。"]
	quest.7C935F4D0BBA8AE0.title: "探险家"
	quest.7CA32E1AA4F17E55.quest_desc: ["建造6个包装机和库存显示器：从整个工厂订购物品。"]
	quest.7CA32E1AA4F17E55.title: "物流系统"
	quest.7D0AE26C88145DB2.quest_desc: ["传说级的超能力/飞行系宝可梦。在它从方块中出来时抓住它，然后加入你的队伍。"]
	quest.7D0AE26C88145DB2.title: "Lugia"
	quest.7D5038CBB1356AA0.quest_desc: ["捕捉10只草属性的宝可梦。"]
	quest.7D5038CBB1356AA0.title: "草地专家"
	quest.7E3E23C5F0CAC0FD.quest_desc: ["樱桃林、花之森林和魔法小山，充满了妖精属性的宝可梦。"]
	quest.7E3E23C5F0CAC0FD.title: "栖息地：鲜花空地"
	quest.7E97053D7094216E.quest_desc: ["用 /trigger cf.boss 挑战海洋生物。胜利将开启第3阶段：Mekanism 和 Refined Storage。"]
	quest.7E97053D7094216E.title: "海洋之主，水域的女王"
	quest.7F490CCA5794F5A4.quest_desc: ["钻石原矿现在会从方块中掉落，但很少见：用铁镐挖掘。黑曜石也会出现，只有钻石镐才能采集：用其他镐挖掘会无功而返。"]
	quest.7F490CCA5794F5A4.title: "钻石镐"
	quest.7FE929A1ED57EF93.quest_desc: ["点燃传送门并穿过它。巨龙可打可不打，末地有超能力宝可梦等你。要回来，就跳进巨龙死亡后出现的传送门，或者直接死亡：你会重生在岛上。"]
	quest.7FE929A1ED57EF93.title: "The End"
	quest.7FF2B2D9C16A880E.quest_desc: ["磁盘驱动器中的存储磁盘：将你的基地中的所有物品都集中在一个地方。"]
	quest.7FF2B2D9C16A880E.title: "磁盘驱动器"
