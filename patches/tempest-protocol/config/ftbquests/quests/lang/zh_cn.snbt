	quest.5A870FE3C2A66207.title: "完整药水"
	quest.5AF55984D85DEF04.title: "流体存储"
	quest.5B0272862AD59DC0.quest_desc: ["剑、魔法与弓！“凋零武器”模组添加了各种稀奇古怪甚至严肃的武器，可用于战斗、探索或收藏。"]
	quest.5BC819E1AC17F204.quest_desc: [
		"初始法术书"
		""
		"将包含可装配于低阶权杖的基础法术"
		""
		"每种法术都属于一个学派（智慧、狂怒、优雅）"
		"施放对应学派的法术即可为该学派获得经验值"
		""
		"不同法术需要对应学派达到最低等级后才能装配到权杖上"
	]
	quest.5C12F4CC1F6F6C32.quest_desc: ["这艘巨大的飞艇悬浮于云端，配备了层层防御，船员也充满敌意。骑乘幻灵的恶魔在头顶盘旋，而骑乘猪灵的鱼形掠夺者则在甲板上游荡。登上它绝非易事。成功者将名留青史，成为少数敢于挑战天空的人之一。"]
	quest.5C12F4CC1F6F6C32.quest_subtitle: "寻找天界挑战者"
	quest.5C6E3A132DA87D8E.quest_desc: [
		"有 1/900 的几率取代兽人生成"
		"或向皇家兽人喂食 10 份皇家血液（需拥有 80K 经验值、自我再生能力，且不能被驯服。它们将对你保持中立）"
	]
	quest.5CB4AE8F885FA977.title: "黄金"
	quest.5CFB8816EC358D0E.quest_desc: ["在背包中持有已收容的残骸和符文石板，并在末地中即可获取被篡改的残骸"]
	quest.5D03950204CF0A3F.quest_desc: ["恶魂是中立生物"]
	quest.5D1496715927573F.title: "信使鸟"
	quest.5D31A587418D7A31.quest_desc: ["生成于灵魂沙峡谷的 Y=0 到 Y=32 之间（主要在 Y=16）"]
	quest.5D98747A6A7DC853.title: "经验种子"
	quest.5DF3632A6DAEF1F6.quest_desc: [
