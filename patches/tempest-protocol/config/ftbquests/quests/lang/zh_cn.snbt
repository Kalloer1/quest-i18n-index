	quest.61191E86AC0B1ECD.quest_desc: ["直接将星辰注入翅膀似乎并不能提升它们，但至少看起来很酷。"]
	quest.61191E86AC0B1ECD.title: "瞄准星辰"
	quest.612D4462F21B6F14.quest_desc: [""]
