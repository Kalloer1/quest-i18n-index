	quest.5A0C91B49F99672C.title: "从存储开始"
	quest.5A24E02EA279E320.quest_desc: ["手持“承诺宝石”时被闪电击中"]
	quest.5A5C59138FE80BFA.title: "生命值药剂"
	quest.5A6AF2B44780BA6F.title: "奥术之墓"
