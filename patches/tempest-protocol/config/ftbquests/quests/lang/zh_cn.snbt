	quest.151BCC341A9E6C87.quest_desc: ["有 3.33% 的几率生成，而非异界生物"]
	quest.154C80564E18D35E.quest_desc: ["法术更强，需要更高等级的权杖和更高的学派等级"]
	quest.15C91FD1F17B45E4.quest_subtitle: "原始以太晶可在末地城宝箱中找到"
