	quest.6602265BCBFE2A86.quest_desc: [
		"“坚韧如铁”是一款生存模组，它增加了多种提升游戏难度的功能，包括体温和口渴度。"
		""
		"[\"\",{\"text\":\"访问维基\",\"color\":\"blue\",\"bold\":true,\"underlined\":false,\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://github.com/Glitchfiend/ToughAsNails/wiki/\"}}]"
	]
	quest.669A894F596B45FF.quest_desc: ["手持承诺宝石时，从敌对生物身上承受伤害"]
	quest.66DF27FBE1CABE6B.title: "大神孵化蛋"
	quest.67030CEFEC1CEF37.quest_desc: ["这些坚韧的商人被逐出村庄，如今在野外游荡，栖身于简单的青色与棕色帐篷之下。尽管流亡令他们疲惫不堪，他们仍会为那些有勇气寻找他们的旅人提供交易与庇护。在这个危机四伏的世界中，这样的营地是难得的信任港湾。"]
	quest.67030CEFEC1CEF37.quest_subtitle: "找到一个商人营地"
	quest.6732ED2ADF9964A4.title: "黑石"
	quest.676CFC5DF4EBD243.quest_desc: ["将一颗心熔炼成金锭"]
	quest.67C886CE3D934AAA.quest_desc: ["获得烈焰风"]
	quest.67E02BCEC60B29FB.quest_desc: ["红宝石工具的挖掘速度更快，手持时会给予挖掘速度效果"]
	quest.6817F3E2D036C3C8.quest_desc: [
		"流浪猫会从7格范围内的任何玩家身边疾跑逃离，并会避开16格范围内的玩家。然而，当手持生鳕鱼或生鲑鱼的玩家靠近到10格范围内时，它们会慢慢靠近，允许玩家投喂并驯服。如果玩家在6格范围内转身过快或停止手持鱼，猫咪便会逃跑，并在几秒钟内不再尝试靠近该玩家。"
		"{@pagebreak}"
		"当玩家睡觉时，被驯服的猫会走向它们的主人并在附近睡觉。当玩家醒来时，它们驯服的猫也会醒来。玩家醒来后有70%的几率收到被驯服的猫送来的礼物，但前提是玩家必须在夜间睡觉；如果玩家是在白天的雷暴天气中睡觉，或者被驯服的猫被命令坐下，则玩家不会收到任何礼物。掉落物列表请参见下一页。"
		"{@pagebreak}"
		"&9常见&r"
		"- 兔皮"
		"- 兔脚"
		"- 生鸡肉"
		"- 羽毛"
		"- 腐肉"
		"- 线"
		"- 幻影膜"
		"- 甜瓜片"
		"{@pagebreak}"
		"&6较稀有&r"
		"- 钻石"
		"- 金苹果"
		"- 金胡萝卜"
		"- 不死图腾"
		"{@pagebreak}"
		"&d稀有&r"
		"- 紫水晶碎片"
		"- 海之心"
		"- 凋零骷髅头颅"
		"- 回声碎片"
		"- 海绵"
		"- 试炼钥匙 (1.21+)"
		"{@pagebreak}"
		"&4极稀有&r"
		"- 末影水晶"
		"- 鹦鹉螺壳"
		"- 下界之星"
		"- 不祥之瓶 (1.21+) "
	]
	quest.6817F3E2D036C3C8.title: "BFF"
	quest.6833A35134B174DE.title: "自然魔法书"
	quest.6858E25E510AE0FA.quest_desc: ["这艘来自异世界的飞艇如巨型乌贼般漂浮于天际，周身布满了防御设施。骑乘幻象的怪物在其船体周围盘旋，而骑在疣猪上的鱼类战士则守卫着甲板。直面征服者，就意味着要与一支天空军团作战。唯有最强者才能赢得胜利。"]
	quest.6858E25E510AE0FA.quest_subtitle: "找到一位天堂征服者"
	quest.68629FA63DAA64A8.quest_desc: ["获取灵魂熔炼器"]
	quest.6888AEC387D11E0F.quest_desc: ["慢慢地喂你蛋糕"]
	quest.6888AEC387D11E0F.quest_subtitle: "蛋糕是假的"
