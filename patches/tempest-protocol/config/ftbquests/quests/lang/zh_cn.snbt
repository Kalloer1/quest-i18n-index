	quest.6568719BDB3C0A69.quest_subtitle: "给予 5 银币"
	quest.65C36F9A4167E3DB.quest_desc: [""]
	quest.65E0D38940CC1D5B.quest_subtitle: "消耗 2 个惰性卡律布狄斯核心"
