	quest.0696C865D708A76C.quest_desc: ["查看并选择敌人。"]
	quest.088F0C75B813F8FF.quest_desc: ["他们在搞什么鬼？看看你的朋友在背包里做什么！而不是只是呆呆地看着你。"]
	quest.09B5491C199CC12A.quest_desc: ["河流现在都流向大海了。"]
	quest.0A4EFED0540E7F23.quest_desc: ["切下一大块岩石。"]
	quest.0C4AB15B642F186C.quest_desc: ["睡眠体验更沉浸。时间会快进到白天，而非跳过。怪物无法接近床时即可入睡，隐藏的床会发光。还有双人睡袋。"]
	quest.0DE39B347AA88F46.quest_desc: ["现在你可以通过下界传送门为竖井供电并连接管道了！"]
	quest.0E054B2A3D2C7AB2.quest_desc: ["动态光源在所有地方都有效！"]
	quest.0E6CE9883686F78B.quest_desc: ["保护你的创造物免受侵害。"]
	quest.10B5FD6CCD11562C.quest_desc: ["当物品还在背包里时，你仍然可以四处走动，但现在要小心别摔下去了。"]
	quest.11B0A4CD4D95A900.quest_desc: ["用于在物理对象之间传输能量的绳索。"]
	quest.1353898DE8EF55EA.quest_desc: ["建造平行的管道！"]
	quest.191123C07B1A55AD.quest_desc: ["可与创造大炮配合使用，实现自动化防御系统。也可放置在创造物上。"]
	quest.191123C07B1A55AD.title: "雷达"
	quest.1C461941131F7E29.title: "找到一个已经组装好的装置"
	quest.1FA39D774724E2D0.quest_desc: ["一种在较小装置中产生旋转能量的简易方法。"]
	quest.1FA39D774724E2D0.title: "快速又简单"
	quest.2198223A03CB246C.quest_desc: ["花田、快乐的恶魂和硫磺洞。应有尽有。"]
	quest.22BD6AD22EF97A67.quest_desc: ["翻滚翻滚翻滚翻滚 耶"]
	quest.27D12BCC88D8A91F.quest_desc: ["现在无需扳手即可攀爬了。"]
	quest.27ED9806EF253822.quest_desc: ["未来会重做平衡性，放心吧。"]
	quest.2A7F14E5EA4A8312.quest_desc: ["骑乘改为按键输入，而非鼠标。现在可以两个人同时骑乘！"]
	quest.2A7F14E5EA4A8312.title: "我爱我的小马驹，还有……"
	quest.2C29043A5040D440.quest_desc: ["这是一个我利用大学课余时间制作的个人兴趣项目。欢迎大家提出建议，尤其需要一些任务奖励的创意。感谢所有喜欢这个整合包的人。"]
	quest.2D70579777D2B5F3.quest_desc: ["就像可以通过气球信封放置竖井一样。现在你也可以用管道做到同样的事情。"]
	quest.2F1A2657BE4BE318.quest_desc: ["电能的力量！"]
	quest.30661A363629593A.quest_desc: ["村民的交易可以循环浏览，附魔书也能在物品栏中显示！更智能了。"]
	quest.31CD3A744C79BF9D.quest_desc: ["河流在流淌。"]
	quest.331859F01011B36D.quest_desc: ["电网系统又难又烦人，直接开干吧。"]
	quest.3427139387BDA309.quest_desc: ["成就看起来更棒了！有不知道的成就？在聊天框里点它！成就菜单比以前更好了！"]
	quest.342FC7980B12A67B.quest_desc: ["设置好地图和迷你地图（默认关闭）。在地图上见证你的创造！现在可以在地图上按 R 键为区域命名。"]
	quest.342FC7980B12A67B.title: "Xaeros 地图"
	quest.34973BC16FB78A11.quest_subtitle: "我几乎不认识她！"
	quest.3556096FF6E928D0.title: "即将推出"
	quest.35D96DB96DB9E050.quest_desc: ["你雷达的控制中心所在之处。"]
	quest.365FB7A9F1C74AE6.quest_desc: ["禁用或设置特定声音的音量。"]
	quest.36EE5EB45DDE6FB3.quest_desc: ["蹲下时左右点击，即可将世界中的物体拾起并创建物理对象！（仅适用于特定方块，试试南瓜吧）也可用于宝箱！"]
	quest.372A147A63E3C1F6.quest_desc: ["我不知道这玩意儿有什么用。"]
	quest.382C8D010230A321.quest_desc: ["找到这个随机生成的资源，才能进入更高温度的冶炼阶段。"]
	quest.390B308FF1C2BF6A.quest_desc: ["你现在可以用饰带、旗帜和颜色来定制你的鞘翅了。鞘翅的物理效果也改了。"]
	quest.39FD66D78C77681D.quest_desc: ["查看世界任何地方的实时画面。使用 FOV 滑块时，请禁用远景。"]
	quest.39FD66D78C77681D.title: "Vista"
	quest.3BEFB29627E473AC.quest_desc: ["原石的生成机制已优化，但此更新仅为安心之用。"]
	quest.3C26F77B88827749.quest_desc: ["展示你的艺术才华吧！"]
	quest.40E6D0B945B28A63.quest_desc: ["你可以把它放进一个奇物栏位里。"]
	quest.422BBC8A779498A2.quest_desc: ["树木现在会受物理引擎影响，砍伐时会倒下。蹲下可阻止此行为。"]
	quest.422BBC8A779498A2.title: "树木物理模拟模组"
	quest.4256FF71C84450B3.quest_desc: ["沙色生物现在可以通过传送门旅行。"]
	quest.43148D8078952955.quest_desc: ["可以放置在拉杆和各种其他物品上。"]
	quest.436050CFDBE2CF01.quest_desc: ["无需漫无目的地寻找，自然指南针和探险家指南针会带你找到目标！路径点会自动添加到你的地图上。"]
	quest.45C02648A7BBA7E2.quest_desc: ["用闪电击中经验块即可获得。"]
	quest.45E1BAF63CA6B38F.quest_desc: ["获取运动状态的绝佳选择，价值连城。"]
