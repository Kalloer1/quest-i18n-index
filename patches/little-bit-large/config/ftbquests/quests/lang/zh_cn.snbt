	quest.4DA0BC20061D0D9A.quest_desc: ["灯发挥作用的所在之处"]
	quest.4DB20110D20F250B.quest_desc: [
		"将一些&e材料&r（作为&d催化剂&r）与其他&6材料&r结合以获得更多！"
