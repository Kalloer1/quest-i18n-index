	quest.22E2F44C5CA270E0.title: "&#b4e2e2以太气体&r桶"
	quest.22EDBC86484EDCAE.quest_desc: ["这基本上是一种&#B0BEC5合成材料&r，用于为物品获取&#4DD0E1无线能量&r"]
