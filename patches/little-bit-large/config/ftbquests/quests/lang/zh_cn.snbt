	quest.3A1E3EE6CCDBB560.quest_subtitle: "TP"
	quest.3A25C866395DB478.quest_desc: ["建议将你的第一块PCB用于组装多区块，这样能让你制作PCB变得容易得多"]
	quest.3A25C866395DB478.quest_subtitle: "思考的岩石"
	quest.3A5E0A470630131E.quest_desc: [
