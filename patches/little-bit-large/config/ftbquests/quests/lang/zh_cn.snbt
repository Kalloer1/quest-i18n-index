	quest.38676DCAAC53414A.quest_subtitle: "最差的版本？"
	quest.386792182535EFAE.quest_desc: [
		"此模块用于保护管道，基础管和加强管在4.9Bar、高级管在19.9Bar时会泄压。"
		""
		"如果你想自己设置阈值，可以稍后用模块扩展卡来修改。"
		""
