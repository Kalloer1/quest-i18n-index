	quest.0AA2F1EDDCA7808C.quest_subtitle: "&a动力&r电缆，请勿&c触碰&r"
	quest.0AA62BB30D9DD1BC.quest_desc: ["Basically &binput&r and &coutput&r all the needed &eitems&r or &5results&r"]
