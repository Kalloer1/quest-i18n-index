	quest.4B59110691340891.quest_desc: ["主要用于组装多区块的不同组件中"]
	quest.4B5D3F2185AF84D5.quest_desc: [
		"这是机器外壳的&e第二&r&a级&r，意味着更&d强大&r的机器！"
