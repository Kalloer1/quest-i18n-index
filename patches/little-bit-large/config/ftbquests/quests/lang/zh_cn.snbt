	quest.6903879F94810373.title: "&6欢迎&r &f来到 <pulse base=0.75 a=1.0 f=1.0 w=1.0>工业</pulse> &#26b7ec先行者&r！"
	quest.690BCDCCE7DCDF19.quest_desc: ["和普通&b界面&r一样，但它多给了你27个物品栏！"]
	quest.690BCDCCE7DCDF19.quest_subtitle: "同样的事情发生在其他生物身上，它们会因饥饿而死亡，并且无法再生生命值。"
	quest.692B9166D51F4B2A.quest_desc: [
		"I will &ateach&r you from the basic to the more &#FF54EDinteresting&r ways to get into this mod"
		""
		"乍一看，这看起来像是一个正常的 &5Ars&r 进度，而事实上，它确实如此"
		""
		"我会尽量让它对你来说尽可能有趣"
		"[{\"text\":\"\"},{\"text\":\"所以现在，你可以去这个任务，看看那些 <grad from=#b838ff to=#f303ae hue=false f=1.0 sp=10.0 uni=true>超酷的</grad> 东西！\"},{\"color\":\"#55FFFF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4C0E826CE13D9471\"},\"hoverEvent\":{\"action\":\"show_text\",\"contents\":{\"text\":\"点击此处更改任务\"}}},{\"text\":\"\"}]"
	]
	quest.692B9166D51F4B2A.quest_subtitle: "魔法的国度"
	quest.692B9166D51F4B2A.title: "欢迎来到 &#ff36faArs&r <wiggle a=0.75 f=0.25 w=0.5><grad from=#9812cd to=#4312cd hue=true f=0.1 sp=20.0 uni=true>Nouveau</grad></wiggle>"
	quest.6943723147A58727.quest_desc: [
		"种植游戏中&c几乎&r所有&6树木&r，生成&e原木&r和树苗。"
		"可选地，你也可以将&b冰冻&r剪刀作为输入来获得&2树叶&r"
		""
		"You will need some &9water&r, the &esapling&r you want to farm and &aenergy&r, at least 10k FE per &btick&r"
		""
		"{image:catalyst:textures/quest_images/modular_machinery_reborn/arboretum.png width:200 height:200 align:center}"
	]
	quest.6953868916F81BE6.quest_desc: ["与其他版本不同，此版本可将时间缩短 &#22c55e1/4&r，并且可以同时发送更多物品。但你无法重复使用舱口；你必须获得一个 &#00d2ff更大的版本&r"]
	quest.695D2D4B299452DA.quest_desc: [
		"粒子加速器线性马达用于提高粒子速度。"
		""
		"粒子穿过电机时，速度会增加1 m/s，消耗RF/FE取决于当前粒子速度。速度越高耗能越多，因此高效的电机布局至关重要。"
		""
		"{image:catalyst:textures/quest_images/oritech/linear_motor.png width:200 height:100 align:center}"
		""
		"&l&6提示&f：沿粒子路径放置多个马达，能更高效地达到更高速度！"
	]
	quest.695D2D4B299452DA.title: "&l粒子加速器线性马达"
	quest.697A5E53CC53ADDB.quest_desc: [
		"你已经受够了大量的手动合成，感到&6厌烦&r了。"
		"好吧，是时候改变这一点了。"
		"有很多关于&6自动合成&r的设置，但我会让你做一个最简单的。"
		""
		"之后可以扩展，增加&c更多&r &a塔楼&r或其他配置。为此需要8个频道，也就是一个&d智能电缆&r。"
		""
		"{image:catalyst:textures/quest_images/applied_energetic/pattern_provider.png width:100 height:100 align:center fit:true}"
	]
	quest.697A5E53CC53ADDB.quest_subtitle: "如何自动化各种事情"
	quest.697A5E53CC53ADDB.title: "&6自动合成"
	quest.697B9815FF380F6E.quest_desc: ["机器的能量容量和传输能力有限，但这些小小的&#8e44ad升级&r能让你改变现状"]
	quest.69868BBC56DA8F95.quest_desc: ["掉落自&#81C784Breezes&r，比其他掉落物更稀有，但获得&e4&r个后，你就能获得&#4FC3F7无限&r数量的它们"]
	quest.6995F60A94673332.quest_desc: [
		"将一些&e物品&r粉碎成其他物品。"
		""
		"通常是&b锭&r到&d粉尘&r"
	]
	quest.6995F60A94673332.quest_subtitle: "蒸汽动力破碎机"
	quest.69A81468F8BB8871.quest_desc: [
		"&bApothic Enchanting&r 添加了适用于任何盔甲、武器或工具类别的特殊魔典。"
		""
		"这样你就可以通过丢弃（或分解）不想要的附魔，来实现&o\"无风险\"&r附魔了。"
	]
	quest.69A81468F8BB8871.quest_subtitle: "挑挑拣拣，随心挑选！"
	quest.69A81468F8BB8871.title: "可附魔的卷轴 (Enchantable Tomes)"
	quest.69C52B5841E4CA8F.quest_desc: [
		"\"在广袤的 &#10ACFF宇宙&r中，有 2 股 &z力量&r &4相互摧毁&r，却又无法做到。似乎这块 &b水晶&r正在 &c阻止&r它们这样做\" - &#FFAD0E大法师&r #12"
		""
		"需要这个&c水晶&r来召唤&#484848宇宙&r本身，为此我们需要一些&4祭品&r，只是为了得到原始形态的副本。"
		""
		"如果我们移动&#FF0000原始&r碎片，我们所知的&#484848宇宙&r就会终结"
	]
	quest.69C52B5841E4CA8F.quest_subtitle: "宇宙中蕴含着无尽的可能性，等待着被发掘。"
	quest.69CC686485001A33.quest_subtitle: "赋予夜视能力"
	quest.69CC686485001A33.title: "&lExo Helmet"
	quest.69D6ACCAC3B91456.quest_desc: [
		"模组 &bTime in a Bottle&r 让我们有机会通过 &6Tick accelerate&r 大量物品来缩短冷却时间，或者直接 &laccelerating&r 事物，让它们嗖嗖地转~~"
		""
		"不过，要使用这个瓶子，我们需要等一会儿，让它储存&d时间&r。"
		""
		"是的，你没看错。瓶中时光模组会记录现实时间，供我们稍后使用。建议在制作后将其留在物品栏中，同时完成其他任务。"
		""
		"&lIT DOES NOT STORE TIME IF IT'S INSIDE A BACKPACK NOR THE TOOL BELT&r."
		""
		"&5注意&r：强烈建议不要对生物使用。这会严重影响TPS，可能导致FPS问题，甚至游戏崩溃！"
		""
		"模组创作者： &6MangoRage"
	]
	quest.69D6ACCAC3B91456.quest_subtitle: "在《极品飞车》中"
	quest.69D6ACCAC3B91456.title: "&l&e瓶中时光"
	quest.69D74428BB9CC623.quest_desc: [
		"Ever want &bMending,&r &bSwift Sneak&r, or &bFrost Walker&r? The &6Deepshelf of Arcane Treasures&r enables all treasure enchants like them!"
		""
		"&o但要小心&r，这意味着&4诅咒&r也会在列表中！"
		""
		"下一页列出了所有有效的附魔！"
		"{@pagebreak}"
		"以下是 Little Bit Large 中所有宝藏附魔的列表！"
		""
		"- 修补 (Mending)"
		"- 迅捷潜行"
		"- Frost Walker"
		"- 灵魂速度"
		"- 风之爆发"
		"- &4束缚诅咒&r"
		"- &4消失的诅咒&r"
		"- 毒液提示"
		"- 生命窃取"
		"- 未使用"
	]
	quest.69D74428BB9CC623.quest_subtitle: "X 标记了宝藏的位置！"
	quest.69D74428BB9CC623.title: "&6获取宝藏附魔效果"
	quest.69E5E1E33F978ABE.quest_desc: ["这基本上是用来制作盔甲的"]
	quest.69E5E1E33F978ABE.quest_subtitle: "昂贵"
	quest.6A1F6F3694025B4A.quest_desc: [
		"厌倦了用1块煤炭烧制单个物品，结果煤炭烧完却无事可做吗？"
		""
		"这就是&d小煤炭&r和&d木炭&r能派上用场的地方。"
		""
		"请记住，1个煤炭或木炭总共可以冶炼8个物品。即80秒，换算成游戏时间则是1600t。"
		""
		"1秒 = 20个游戏刻"
		""
		"用1个煤炭换1个物品，我们可以用这些迷你煤炭，1个迷你煤炭=1个物品。"
		""
		"顺便攒点煤炭，一举两得。"
	]
	quest.6A1F6F3694025B4A.quest_subtitle: "最小最小的煤炭碎片之一"
	quest.6A1F6F3694025B4A.title: "&l小（查理）煤炭"
	quest.6A4C0711EE98332C.quest_desc: ["这枚吊坠简直是救命的……它会用一点血自动清除我们玩家受到的所有负面药水效果！"]
	quest.6A57F27424491032.quest_desc: [
		"你需要去&5下界&r，在&7堡垒&r里找到这些。"
		""
		"After &6getting&r one, make sure you make &ecopies&r!"
	]
	quest.6A57F27424491032.quest_subtitle: "来自堡垒遗迹的宝藏"
	quest.6A8971E96045CBA2.quest_desc: [
		"&#B0BEC5Uraninite&r 是本模组的基础材料之一，不过，与其近亲的 &#81C784uranium&r 也同样适用。"
		""
		"&#FFB74DPowah mod&r is just about 1 single thing, &#4DD0E1generating lots of power&r, and in &#CE93D8industrial scale&r."
		""
		"分为&#EF53507个等级&r，每个等级都比前一个需要&#FF8A65更多的能量&r。"
		""
		"该模组经过调整，以免落后于其他模组或拥有替代能源，其中一些机器的任务细节更丰富，不过大多数都可以忽略"
	]
	quest.6A8971E96045CBA2.title: "&#81C784乌拉纳尼特"
	quest.6A93859FAFD312AA.quest_desc: [
		"积累了太多&6板&r？把它们变回&d粉尘&r，再熔成锭吧！"
		""
		"包含与多个主流模组的整合内容。"
	]
	quest.6AA8B7AE8A952909.quest_desc: [
		"每个&d关键词&r都决定了程序运行的&6频率&r。"
		""
		"它具有&b如下&r结构："
		""
		"&d每隔&r X <ticks or seconds> 执行一次"
		"--代码在此处"
		"end"
		""
		"其中 X 是 &e计时器&r 或 秒数。你只能 &6选择&r 计时器 或 秒数，&c不能&r 两者兼得。"
		"By default, only &aenergy&r can be done in a \"&devery&r 1 ticks do\" and the &brest&r can be &6done&r in \"every 20 ticks do\" or &ehigher&r"
		""
		"有个技巧可以&6避免&r20刻的延迟，使用“每&c次红石&r脉冲都”，但你需要一个2&b刻&r的红石时钟，比如用2个&e侦测器&r，放在&6管理器&r方块上"
	]
	quest.6AA8B7AE8A952909.title: "Every Keyword"
	quest.6ABCA0BC4B6164E6.quest_desc: ["请使用比这些更&d可靠&r的其他东西。"]
	quest.6AC0FB6E412D827B.quest_desc: [
		"基本上就是&c红石粉&r，但不会随距离降低&a功率&r"
		""
		"我们来解释一下&b频道&r，因为&c红石&r最能从中受益。"
		""
		"&a通道&r是物品、流体、气体等的独立&6路径&r。"
		"基本上，你可以在同一个节点&e网络&r上拥有16种&d不同&r的设置，从而节省放置不同节点所需的&6空间&r。"
		"但你仍然需要&b塞&r下所有那些卡牌"
	]
	quest.6AC0FB6E412D827B.quest_subtitle: "无线红石电路"
	quest.6AE8325772D14EA0.quest_desc: ["用了一些&#B0BEC5铁&r和一些&#FFD54F介电材料&r后，这就是大多数机器的外壳了"]
	quest.6AE86F948D9A4472.quest_desc: [
		"好了，是时候施展一些&b真正&r的&d魔法&r了。"
		"我们需要一个陨石罗盘，需要一个罗盘和一个&d充电器&r（之后会重复使用）"
		"目前，先制作一个曲柄吧。"
		""
		"它会指向最近的陨石，那里有神秘立方体（后续所需）和一些 certus 芽。"
		""
		"&c打破&r所有花蕾，&c除了&r无暇花蕾，需要用箱子处理它们。"
		"&b无瑕花蕾&r 如果你不破坏它，它就不会随时间降解。"
	]
	quest.6AE86F948D9A4472.quest_subtitle: "你需要两者都有"
	quest.6AF6F200251C478B.quest_desc: [
		"这种蜜蜂通常出现在&dThe End&r，在击败&eJean&r（又名&5The Ender Dragon&r）后的岛屿上。"
		""
		"你不需要建造这个巢穴，直接寻找就好，它们到处都是"
	]
	quest.6AF6F200251C478B.quest_subtitle: "/tp @e 0 0 0"
	quest.6B159418F332B368.quest_desc: [
		"你释放了一股不可阻挡的力量……"
		""
		"要是我，我肯定会一边听着 Muse 的 Super Massive Black Hole，一边欣赏这美景，不过可别碰它。我开玩笑的，你的坟都找不到。"
		""
		"&4&l你无法阻止它... &r除非你制作一个 Schröndiger 笼子，之后可以用 AE2 Spatial IO 删除"
		""
		"如果你还没看过，最好去瞧瞧 Tachyon Absorber 的任务！"
	]
	quest.6B159418F332B368.quest_subtitle: "世界末日到了，一切都结束了"
	quest.6B159418F332B368.title: "&l&0你做了什么鬼事情"
	quest.6B170BA05FDF56BF.quest_desc: [
		"开启&5传送门&r很危险——激活时请保持距离！:p"
		""
		"这个巨大的&6多方块结构&r是推进进度所必需的，并且与&#ec3e64Pastel&r和&#8e29daMalum&r相兼容。"
		""
		"包含自动处理生物和&a增强配方产率&r等优质生活升级！"
	]
	quest.6B1734299D45AFD3.quest_desc: [
		"将&b污泥&r转化为有用的材料，如&c红色&r沙子、砾石或灵魂沙。"
		""
		"或者陶土，也就是 &#77D0FFclay&r 平衡的 :p"
	]
	quest.6B1734299D45AFD3.quest_subtitle: "粘土保持平衡状态"
	quest.6B43DA8A8EFAC636.quest_desc: ["跳过此升级"]
	quest.6B43DA8A8EFAC636.quest_subtitle: "更快一点"
	quest.6B4C6BEDD35D7F0F.quest_desc: [
		"本任务链旨在将&b&l网格比例&r设为&b&l0.15&r。"
		""
		"可以通过进入&b&l设置 > 编辑文件 > 网格比例 0.15&r来更改网格比例"
		""
		"给未来其他工作者的提示（Titop54在此），你不需要更改网格比例，可以平移来自由移动。如果不行，你可以将坐标设为IEEE 754范围内的任意浮点值"
	]
	quest.6B4C6BEDD35D7F0F.title: "&#4DD0E1致未来的任务作者的通知"
	quest.6B50E447E97394A8.quest_desc: [
		"我们需要一个&bcertus农场&r，但该怎么做呢？"
		"你可以用高级AE的&6蜜蜂&r、&d种子&r或&c复制&r方法，但这是AE2的指定方式。（可能用种子和蜜蜂更容易）"
		""
		"此任务来自指南，其中包含农场的&e3D&r视图。搜索示例和&b&n简易的certus农场&r。但我们稍作修改，使其产量更高。"
		""
		"这样我们就能塞下3个湮灭飞机，提高产量。"
		""
		"下一页的照片&2&r"
		""
		"{@pagebreak}"
		""
		"{image:catalyst:textures/quest_images/applied_energetic/first_farm_certus.png width:100 height:100 align:center fit:true}"
	]
	quest.6B50E447E97394A8.quest_subtitle: "你能再往上一点吗？"
	quest.6B50E447E97394A8.title: "&bCertus 农场"
	quest.6B5295ABF1D7D71D.quest_desc: [
		"厌倦了装备和工具上出现的&c消失诅咒&r或其他烦人的附魔吗？"
		""
		"&5Dis-Enchanting Table&r 可以解决这个问题！"
		""
		"此模组仅添加了这张既美观又实用的桌子，无需像&d附魔台&r或机器那样复杂地搭建。"
		""
		"只需放置这张桌子，你就可以开始为物品解除附魔了！很简单，对吧？"
		""
		"&l重要提示&r：我写这个的时候，附魔分解台的配方还处于“原版”状态，不过他们可能会稍微改动配方来平衡游戏性。"
		""
		"模组创作者：&eLupin"
	]
	quest.6B5295ABF1D7D71D.quest_subtitle: "最棒的附魔分解体验！"
	quest.6B5295ABF1D7D71D.title: "&5&l附魔分解台"
	quest.6B552B61C702C105.quest_desc: ["听说过并行处理吗？没有？好吧，你很快就会知道了"]
	quest.6B552B61C702C105.quest_subtitle: "&b底部&r"
	quest.6B552B61C702C105.title: "&b印刷并行电路板"
	quest.6B959ECB2BE3A6B2.quest_desc: [
		"&d碎片锻造炉&r是升级到 Tier 3 的关键一步！"
		""
		"用这台漂亮的机器，我们可以通过处理&l&b铂&r来更轻松地获取Fluxite！"
		""
		"有些过程可能稍慢，但我强烈建议给这台可爱的机器装上&6速度插件&r！"
	]
	quest.6B959ECB2BE3A6B2.title: "&l碎片锻造台"
	quest.6BC3B2101B9FD737.quest_desc: ["&e科技&r进步发现了一些&5魔法&r建筑，能够赋予&8碳&r元素"]
	quest.6BC3B2101B9FD737.quest_subtitle: "碳基生物"
	quest.6BCBCA0C3BAF3EFC.quest_desc: [
		"这台机器获得了 &#81C784x10 的生产速率&r，同时还获得了 &#4DD0E1新资源&r来产生能量。"
		""
		"使用&#4FC3F7水&r或&#B39DDB液态黑暗&r冷却内部可获得&#FFD54F更多能量&r（需将流体泵入内部），而在机器下方的世界中使用&#EF5350更高温度方块&r则可产生更强大的动力"
	]
	quest.6BD3608816BBCB21.quest_desc: ["从&#1E90FF16到48个方块&r，不错，但如果再投入一点，我们还能做得更好！"]
	quest.6C0650C6DE97447E.quest_desc: ["总的来说并不便宜，但仍然被用于许多&#FF00FF流程&r中！"]
	quest.6C0650C6DE97447E.quest_subtitle: "&#00FF7F&l改进的&r"
	quest.6C10C757F924E1DD.quest_desc: [
		"&b附魔图书馆&r可以让你存储附魔书。"
		""
		"&6等级上限&r指的是它能存储的最高附魔等级，这里是&b16级&r。 &o不过，&r这在&bLittle Bit Large&r中并不重要，因为附魔等级不会那么高。"
		""
		"你只能取出你放入的&b最高等级&r的附魔。例如，如果你放入了一本&b锋利度V&r的书，你&o不能&r取出锋利度VI的书，只能是V级及以下。"
		""
		"你可以&bShift-Click&r来移除最高等级的附魔。"
	]
	quest.6C10C757F924E1DD.quest_subtitle: "附魔物品存储！"
	quest.6C45CC92E552B738.quest_desc: [
		"&cLaser&r &bNodes&r 基本上会完成所有&e工作&r。"
		""
		"They can do 6 &coperations&r at the &b&nsame&r time by default (1 for &5each&r side), but you can &eupgrade&r this by using some upgrades. More &2info&r later"
