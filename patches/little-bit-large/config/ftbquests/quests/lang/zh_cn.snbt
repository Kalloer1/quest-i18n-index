	quest.5C51BA9406B66C78.quest_desc: ["&#3498dbChambers&r 是那种你应该尽早投资的机器，以免后期等待，主要是为了获取 &#85c1e9crystallized lapis&r 和 &#d2b4deamethyst buds&r"]
	quest.5C5BF198EA21687B.quest_desc: [
