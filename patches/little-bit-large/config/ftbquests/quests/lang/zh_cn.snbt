	quest.4DCBA85D24DFDC5C.quest_subtitle: "把他们的脑袋都砍下来！"
	quest.4DCBA85D24DFDC5C.title: "&c更多量子！"
	quest.4DDEB897B37E1DD3.quest_desc: [
