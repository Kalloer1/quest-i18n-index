	quest.252CC4B31AA8EA09.quest_subtitle: "工业规模的蜂蜜生产"
	quest.2533EC424651E685.quest_desc: [
		"有几种方法可以在不种植树苗的情况下收获&#22c55e树木&r。"
		""
		"这个&#00d2ff多方块结构&r使用&#f59e0b能量&r、一些&#38bdf8水&r和&#84cc16树苗&r来获取原木"
	]
	quest.25359F928F16C047.quest_desc: ["&b鱼&r的供应总是短缺，主要是因为缺乏高效的&a养殖&r方法。这里有一个能同时净化水中&e钻石&r的&6多方块结构&r！"]
	quest.254B7CA3BF8C296B.quest_desc: [
