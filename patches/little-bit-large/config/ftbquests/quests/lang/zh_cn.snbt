	quest.12EA8624E059C93E.title: "&c<shake a=1.0 f=1.0>仪式！！！</shake>&r"
	quest.12F9EC1494D192A6.quest_desc: ["&dFissile Fuel&r 是你的 &eFission&r Reactor 的燃料，问题是你 &buse&r 的量很大，除非你保持 &6production&r 很低"]
	quest.12F9EC1494D192A6.title: "&d裂变燃料"
	quest.13060BF8D2D4AB76.quest_desc: [
		"将刷怪笼提取器放置在刷怪笼上，然后施加负压以开始提取核心。"
