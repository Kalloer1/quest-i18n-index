	quest.5CE2A10C711EC3C9.quest_subtitle: "扳手 v2"
	quest.5CE5F4D42935BD90.quest_desc: ["好了，该到&#EF5350最后一档&r了，能完成&#CE93D85M IO&r或&#4DD0E11 tick&r的配方！"]
	quest.5CF3600A45D365F5.quest_desc: [
