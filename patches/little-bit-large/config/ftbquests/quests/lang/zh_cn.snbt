	quest.7CEB48C4D541F7CB.quest_desc: ["该电缆的传输速率获得了&#81C784提升&r，从&#B0BEC5200000 FE/t&r提升至&#EF53508000000 FE/t&r"]
	quest.7D01DD78B475DD0C.quest_desc: [
