	quest.2CEAF24B0C9264D1.title: "&l机器效率附加包"
	quest.2CEED480C5F876D6.quest_desc: ["这是一个新物品，旨在为更好的配置增加一个步骤。或者，也许它背后隐藏着什么魔法"]
	quest.2CEED480C5F876D6.quest_subtitle: "无尽的力量，无穷无尽"
	quest.2D00BD62F5A81EF6.quest_desc: [
		"我们首先需要找到的东西是蜜蜂。"
		""
		"不是蜜蜂模组里的蜜蜂，而是原版蜜蜂，普通的蜜蜂"
