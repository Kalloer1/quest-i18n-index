	quest.0270173E2FE25CCA.quest_desc: [
		"&#CE93D8Eldrith&r 是所有&#B39DDBspirits&r中最简单的，它会从&#EF5350bosses&r、&#81C784endermen&r或&aendermites&r身上掉落"
