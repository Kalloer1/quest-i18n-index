		"{image:catalyst:textures/quest_images/productive_bees/hives.png width:100 height:100 align:center fit:true}"
	]
	quest.3CDBC61BD4DAA7F6.quest_subtitle: "更新内容"
	quest.3CF21B494F821EFC.quest_desc: ["它们的输入输出是&#81C784容量的1/4&r，而且&#FFD54F相对便宜&r，所以最好造&#4FC3F7几个&r"]
	quest.3D0E018ED7E528D3.quest_desc: [
		"&6Extruder&r 是一个重要的多方块结构，在制作板、箔、齿轮、电线和棒材时能带来&a更高的资源产出率&r。"
		""
		"只需3次操作，你就能赚回足够的&d小粉尘&r来制作一个&e免费锭&r！"
	]
	quest.3D147F258BF7975E.quest_desc: [
		"这些核心会进入&#FFD54FCrucible&r，并产生一些有趣的效果："
		""
		"- &#EF5350可疑装置&r会炸毁坩埚，但生成物与&#B39DDB灵魂木仪式&r相同"
		""
		"- &#FFAB91Symphatic Drive&r会忽略冲力造成的伤害，但并非总是如此，当发生时，它将避免&e3次配方&r的伤害"
		"{@pagebreak}"
		"- &#4FC3F7共振调谐器&r会移除&c不稳定&r，但会使配方耗时更长，有时会让&a催化剂&r变得更强大"
		""
		"- 当&d不稳定&r上升时，&#81C784腐蚀催化剂&r会增强音叉调谐的威力，因此承受冲击的伤害越高，获得的增益就越多"
		"{@pagebreak}"
		""
		"- &#CE93D8Stellar Mechanism&r 将改善你的手动调节体验"
		""
		"你需要选一个，但我推荐选 &#4DD0E1共振调谐器&r，因为它最简单，而 &b可疑装置&r 可以给朋友"
	]
	quest.3D394FEA4D7724C6.quest_desc: [
		"管道扳手（The Pipez Wrench）。"
		"没有配置管道的方法，你寸步难行。"
		"不过Pipez并不挑剔，会接受游戏中的大多数其他扳手，比如mek configurator、certus wrench等。"
		""
		"扳手用于分离和断开管道段，并设置管道以进行提取。"
		""
		"&6Pipez 的所有过滤器和配置都在提取端进行，输入端没有配置。&r"
		""
		"&4注意！&r"
		"&4如果管道提取点所在的方块更新导致管道断开连接，管道会恢复为普通连接，并将升级组件掉落到地上。因此不建议将管道与Mekanism的多方块结构结合使用，因为它们可能会随意变形和重组。&r"
	]
	quest.3D49AD0E6EE75487.quest_desc: [
		"这可能是本模组里&b第二&r&a好&r的工具了。"
		""
		"当机器出了点小意外时，你可以用它来&c删除&r&9流体&r和&d化学物质&r：&b机器&r:p"
		""
		"它&c不&r会移除与&a核&r相关的&d化学&r品"
	]
	quest.3D49AD0E6EE75487.quest_subtitle: "第二种工具"
	quest.3D67D9948E936DC4.quest_desc: [
		"You are &lnot&r allowed to use these quests in any public pack without &4&nexplicit permission&r from Catalyst Studios."
		""
		"Modular Machinery 任务线制作者：&aApex&r &dSlayer&r 和 &cTito&ep&c54&r"
		""
		"如果你看到这句话，说明你正处于编辑模式并且开了作弊模式 :/"
