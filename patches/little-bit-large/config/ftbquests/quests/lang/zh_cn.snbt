	quest.0A691F71CA79DCB0.quest_desc: [
		"这是整个模组化MC里我最喜欢的流体储罐之一，价格便宜，而且和Mekanism储罐极其相似！"
		""
		"它可以用作桶来放置任何类型的流体。"
		""
		"关于这个储罐的另一个事是，如果我们造第二个储罐，可以在任何合成网格中合并它们来增加容量。"
	]
	quest.0A691F71CA79DCB0.quest_subtitle: "可以储存任何流体"
	quest.0A691F71CA79DCB0.title: "黑暗坦克"
	quest.0A7679A16AFCFE50.quest_desc: ["它能&d让你&r在每一个&6栏位&r中&c存放&r多8倍的东西"]
	quest.0A7679A16AFCFE50.quest_subtitle: "一个奇点"
	quest.0A89941FEB91D334.quest_desc: ["&#a855f7Universium&r, a mix of &#d946efmagic&r and &#00d2fftechnology&r, so powerful, yet, there is something &#7c3aedhiding&r behind it, something &#f43f5emore&r"]
