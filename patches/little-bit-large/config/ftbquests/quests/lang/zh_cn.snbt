	quest.3405073B9E93AC70.quest_desc: [
		"这是你&d首次&r尝试&a传输&r&c热量&r，但这并不太&e高效&r。"
		""
		"[{\"text\":\"But there are a \",\"color\":\"#FFFFFF\"},{\"text\":\"simpler\",\"color\":\"#18ffea\"},{\"text\":\" and better way to \",\"color\":\"#FFFFFF\"},{\"text\":\"transport\",\"color\":\"#FF55FF\"},{\"text\":\" heat, touching! \",\"color\":\"#FFFFFF\"},{\"text\":\"Mekanism\",\"color\":\"#55FF55\"},{\"text\":\"'s \",\"color\":\"#FFFFFF\"},{\"text\":\"multiblocks\",\"color\":\"#AA00AA\"},{\"text\":\" can have their \",\"color\":\"#FFFFFF\"},{\"text\":\"inputs\",\"color\":\"#b1ff18\"},{\"text\":\" and \",\"color\":\"#FFFFFF\"},{\"text\":\"outputs\",\"color\":\"#ff186a\"},{\"text\":\" next to each other, having 0 \",\"color\":\"#FFFFFF\"},{\"text\":\" looses\",\"color\":\"#ff1818\",\"underlined\":true,\"hoverEvent\":{\"action\":\"show_text\",\"value\":{\"text\":\"基本上，你的效率是100%！\"}}}]"
