	quest.387EBA2C53658344.quest_desc: ["基本上，建造房屋在制作细胞时毫无用处，因为还有另一个配方能一步到位。"]
	quest.387EBA2C53658344.quest_subtitle: "可选的"
	quest.387EBA2C53658344.title: "细胞式住房"
	quest.38926CA5889429A9.quest_desc: [
