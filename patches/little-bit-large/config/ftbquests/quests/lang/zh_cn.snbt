	quest.4CDF67A932172054.quest_subtitle: "&#fa37b8无限的力量...&r"
	quest.4CDF67A932172054.title: "&l&5终极太阳能电池板"
	quest.4D178B3F79B07236.quest_desc: ["要自动化这台&d机器&r，你需要在&a基座&r上有一个&6有效&r的配方，然后添加主要的&d材料&r并开始制作"]
	quest.4D178B3F79B07236.quest_subtitle: "工厂必须不断发展壮大"
	quest.4D1D631C473A24CA.quest_desc: [
