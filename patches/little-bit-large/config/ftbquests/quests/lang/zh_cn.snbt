	quest.4921A22866F9253C.quest_desc: [
		"收集一些物品后，你需要一些&#B39DDBspirits&r，这比你想象的简单"
		""
		"你只需要用特定武器杀死一些生物，或者制作一个大型多方块结构，这里我们主要讲武器部分。"
		""
		"你可以攻击生物直到它拥有&c1个炉灶&r，然后用这把武器杀死它们来获取灵魂。"
		""
		"此任务线中的部分物品只能通过使用&#FFD54F镰刀&r击杀，例如&#4DD0E1Warp&r或&#CE93D8Grim Talc&r"
	]
	quest.49286C762F383267.quest_desc: [
		"&b钻石。&r..."
		""
		"嗯，我跟你说过我们需要它们的，不是吗？"
	]
	quest.49286C762F383267.quest_subtitle: "&b底部&r"
	quest.49286C762F383267.title: "&b印刷工程电路"
	quest.495DE286325A307B.quest_desc: [
		"这个多方块结构能让你制作高级压力管，也能在没有光箱和蚀刻步骤的情况下，更轻松地制作空PCB。"
		""
		"这些是制作一个完全可用的装配装置所需的所有方块"
		""
		"组装平台放在最中间的位置。"
		""
		"激光器和钻头必须与组装站接触，对角线不算。"
		""
		"IO可以放置在组装平台为中心的3x3区域内，它们会向自身为中心的3x3区域内的任何容器进行进出口，这可以是箱子，也可以是接口等。"
		""
		"最后，控制器可以放在任何位置，只要它接触着其余的多方块结构，这里就是输入压力和程序的地方。"
		""
		"&4（注意！所有方块都必须相互接触）&r"
	]
	quest.495DE286325A307B.title: "装配生产线"
	quest.4993E2F13B366D77.quest_desc: ["朝某个方向收集&e地板&r上的&6物品&r"]
	quest.4993E2F13B366D77.quest_subtitle: "无线收集器"
	quest.49968399FA309A2C.quest_desc: ["蜂巢的首次升级，能让蜜蜂产出更多蜂蜜"]
	quest.49968399FA309A2C.quest_subtitle: "Gives more"
	quest.499D9BD47A14B0F4.quest_desc: ["要制作这个蜜蜂，你需要史莱姆球"]
	quest.499D9BD47A14B0F4.quest_subtitle: "黏滑的"
	quest.49A56AA70AC97E6F.quest_desc: ["&e科技&r进步中发现了一些&5魔法&r建筑，能够提供&e锇&r"]
	quest.49A56AA70AC97E6F.quest_subtitle: "锇（Osmium）"
	quest.49BBEDF4375C1D79.quest_desc: ["&5魔法生物&r会引导你找到这些&d幼虫巢穴&r，并给你&7牵引绳&r"]
	quest.49BBEDF4375C1D79.quest_subtitle: "铅（Plumbum）"
	quest.49BCF1CF622DE723.quest_desc: [
		"过滤实体，可用于制作&2废弃的&r蜜蜂"
