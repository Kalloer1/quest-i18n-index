		"&5ultimate = 64&r"
		""
		"&b[fluid_pipe.amount]&r"
		"每刻秒传输的字节数（MB）"
		"&8no_upgrade = 50&r"
		"基础值 = 100"
		"&e改进 = 500&r"
		"&badvanced = 2000&r"
		"&5ultimate = 10000&r"
		""
