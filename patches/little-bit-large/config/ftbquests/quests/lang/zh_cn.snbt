	quest.5AF5E6D9EAB19CAC.quest_desc: ["每&n0.05&r &6秒&r生成&d&r 2桶&b水&r"]
	quest.5AF5E6D9EAB19CAC.quest_subtitle: "无限的水塔（Infinite watah）"
	quest.5B33740F16769AB9.quest_desc: [
