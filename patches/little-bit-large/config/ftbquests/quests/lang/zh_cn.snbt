	quest.4617EEB6FEF26DC7.quest_desc: ["在理想条件下，某些&a植物&r产生的资源比野生物产&3多得多&r，因此这是一个很好的替代&e资源生成器&r。"]
	quest.466E6E599616279B.quest_desc: [
