		""
		"还添加了一些其他东西，但请注意，每个反应堆同时不需要&#CE93D8超过2个&r"
	]
	quest.39F13C2725B3176A.quest_desc: ["新的&#1abc9c电路&r，新的头痛，现在需要&#ff6b6b4个最高阶的&r才能继续"]
	quest.3A075D348101ADDD.quest_subtitle: "提高移动速度"
	quest.3A075D348101ADDD.title: "&l外骨骼护腿"
	quest.3A0AA809E5E72877.quest_desc: [
		"每个&2末影&r抽屉都有自己的&d频率&r"
