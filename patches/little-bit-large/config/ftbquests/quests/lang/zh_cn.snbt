	quest.13734C22DB105837.title: "量子戒指"
	quest.138A7C04CB62E30D.quest_desc: [
		"使用重油或生物柴油，是时候换更好的燃料了。"
		""
		"你可以用这种燃料将Blaze Burners加热，但生物柴油能使其超高温"
