	]
	quest.157B2B9583F18AB7.quest_subtitle: "由&c红石&r控制"
	quest.158671F0AE6C45B1.quest_desc: ["我们没有采用低数值，而是将&#81C784x100&r的&#4DD0E1IO速率&r提高，以与&#CE93D8Flux Networks&r竞争"]
	quest.15A0A6C21C55F3D8.quest_desc: ["它们的输入输出是&#81C784容量的1/4&r，而且&#FFD54F相对便宜&r，所以最好造&#4FC3F7几个&r"]
	quest.15A332FAA18CB017.quest_desc: ["更多&6过滤&r和&d允许&r你压缩3x3和2x2的方块，比如&b冰&r或&d紫水晶&r！"]
	quest.15A332FAA18CB017.quest_subtitle: "&amelon&r.zip"
	quest.15BA38377EA9D7A2.quest_desc: ["Now that we are generating &#bbfa374096FE/t&r we can begin to grow our factory with more &#37fa55machines&r..."]
	quest.15BA38377EA9D7A2.quest_subtitle: "我的字幕用完了，需要更多字幕才能继续任务。"
	quest.15BA38377EA9D7A2.title: "&l&#37a5fa共振太阳能电池板"
	quest.15D3EA775A53D557.quest_desc: [
		"&5Insanium&r Essence, one of the most &dpowerful&r &etier&r that the mod can give you."
		""
		"通常需要一些&4supremium&r来制作这种精华，但现在你需要&6awakened&r &4supremium&r精华和一些新的&dseeds&r！"
