	quest.3DC47265861A4FCD.title: "&l反应堆热量吸收器"
	quest.3DC846B8C02E58F5.quest_desc: ["让你可以&#8e44ad无线充电&r物品，支持&#3498db范围升级&r以扩大影响半径"]
	quest.3DCC894DDE82C6DD.quest_desc: [
