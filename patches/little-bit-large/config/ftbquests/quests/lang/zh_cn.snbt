	quest.5B33740F16769AB9.quest_subtitle: "水桶"
	quest.5B35722761CF6D75.quest_desc: [
		"末地激光器可真是个大家伙。"
		""
		"它能轻松破坏方块、输送能量，还能蒸发掉烦人的流浪商人！"
		""
		"但是这具体是怎么运作的呢？"
