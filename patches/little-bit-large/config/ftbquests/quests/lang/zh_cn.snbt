	quest.398BCD889B2B137C.quest_subtitle: "第三阶段"
	quest.398BCD889B2B137C.title: "&6Tertium&r 精华"
	quest.398E698C66EAA005.quest_desc: ["和霓虹蜜蜂一样，但这次是灰矿工蜂"]
	quest.398E698C66EAA005.quest_subtitle: "又来一个？！？"
	quest.39E1F80D9E823CB2.quest_desc: [
