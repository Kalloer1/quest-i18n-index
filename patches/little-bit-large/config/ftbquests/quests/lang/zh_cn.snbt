	quest.37C0C77F3C32FEC9.quest_desc: ["&5魔法生物&r会引导你找到这些&d卵&r，并赐予你&7石英&r"]
	quest.37C0C77F3C32FEC9.quest_subtitle: "Quarz"
	quest.37C2435E327EFF1B.quest_desc: ["3个&a桶&r才1个方块？而且还只有点&e金&r？"]
	quest.37C2435E327EFF1B.quest_subtitle: "有很多空间可以放置物品"
	quest.37D7AE4EFE0B3333.quest_desc: [
