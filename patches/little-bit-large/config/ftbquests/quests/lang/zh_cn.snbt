	]
	quest.14384D2E8873E4F2.quest_subtitle: "&#fbbf24抵达了旧文明&r"
	quest.14392B1AB523E1BF.quest_desc: ["将&e污水&r转化为&6肥料&r，它们可用于制作&d水培植物&r！"]
	quest.14392B1AB523E1BF.quest_subtitle: "肥料生产者"
	quest.14457BC2EC4E43C4.quest_desc: [
		"必须在机器框架上建造才能正常工作。"
		""
		"和AE2的湮灭平面一样，这台机器会破坏它视野内的任何方块！"
