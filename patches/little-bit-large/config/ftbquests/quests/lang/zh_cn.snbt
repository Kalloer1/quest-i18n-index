	quest.250AB1CE07085055.quest_desc: ["这是机器外壳的&e第二&r&a级&r，意味着更&d强大&r的机器！"]
	quest.250AB1CE07085055.quest_subtitle: "第二层级"
	quest.250F6919F4CD9CAF.quest_desc: [
