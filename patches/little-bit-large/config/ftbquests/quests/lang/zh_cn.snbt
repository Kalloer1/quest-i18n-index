	quest.50015003F884A788.quest_desc: [
		"[{\"text\":\"\"},{\"text\":\"删除核废料或乏核废料的最简单方法是将它们放入桶中，然后打破桶，再放置桶，重复操作。\"},{\"text\":\"easiest\",\"color\":\"#FF55FF\"},{\"text\":\" way to \"},{\"text\":\"delete\",\"color\":\"#FF5555\"},{\"text\":\" \"},{\"text\":\"nuclear\",\"color\":\"#48cf63\"},{\"text\":\" waste or spent \"},{\"text\":\"nuclear\",\"color\":\"#48cf63\"},{\"text\":\" waste is to put in on a \"},{\"text\":\"barrel\",\"color\":\"#FFAA00\"},{\"text\":\" and \"},{\"text\":\"break\",\"color\":\"#FF55FF\"},{\"text\":\" it, place the \"},{\"text\":\"barrel\",\"color\":\"#FF55FF\"},{\"text\":\" again and repeat.\"}]"
