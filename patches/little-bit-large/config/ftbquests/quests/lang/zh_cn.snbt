	quest.12D67E0652C01B3F.title: "沙子"
	quest.12EA8624E059C93E.quest_desc: [
		"我们快完成&5Ars Nouveau&r的进度了，现在是时候进行最强大的部分了，&c <shake a=1.0 f=1.0>仪式！！！</shake>&r"
