	quest.3405073B9E93AC70.quest_subtitle: "[{\"text\":\"第一\",\"color\":\"#FF55FF\"},{\"text\":\"定律：\",\"color\":\"#FFFFFF\"},{\"text\":\"热力学\",\"color\":\"#18ff92\"}]"
