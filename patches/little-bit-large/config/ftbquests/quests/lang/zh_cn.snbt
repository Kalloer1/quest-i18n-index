	quest.02A1C699031C7DBD.quest_subtitle: "&#FFD700&l安全第一&r"
	quest.02B6E87C67A4BFFE.quest_desc: ["嗯，它们速度更快，但合成成本更高，&#8B00FF精英版&r并不必要，因为&#00FF00速度升级&r和&#FF7F00堆叠升级&r的效果要好得多"]
