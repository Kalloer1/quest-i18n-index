	quest.4D1D631C473A24CA.quest_subtitle: "扩大范围"
	quest.4D34F7914A316C16.quest_desc: ["允许机器通过&c红石&r进行控制"]
	quest.4D34F7914A316C16.quest_subtitle: "&c红石&r开启"
	quest.4D3922AE72FBECC7.quest_desc: [
