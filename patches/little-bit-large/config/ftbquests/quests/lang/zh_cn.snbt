		"{image:catalyst:textures/quest_images/applied_energetic/dense_cable_example.png width:150 height:100 align:center fit:true}"
	]
	quest.4CB758202B13207D.quest_subtitle: "更大，更大，更棒"
	quest.4CB758202B13207D.title: "高密度智能电缆"
	quest.4CDF67A932172054.quest_desc: [
		"制作这些太阳能电池板时可能遇到了一些问题，但我们终于成功了……"
		""
