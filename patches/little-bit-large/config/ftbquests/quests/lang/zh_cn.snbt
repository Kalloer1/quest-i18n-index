	quest.13CA67D14B62120B.title: "其他模组"
	quest.13E38108EE8D35E6.quest_desc: ["这类&c存储&r组件用于存放多种&d类型&r的物品，因为它们能在&d类型&r和可&c存储&r的物品数量之间取得平衡。"]
	quest.13E38108EE8D35E6.quest_subtitle: "NASv.3: 开启"
	quest.14384D2E8873E4F2.quest_desc: [
