	quest.138B1E0670F27C35.title: "&l燃料发电机"
	quest.13AA8A73A923DDB4.quest_desc: ["首先，我们需要一个&#3b82f6基地&r，所以找一个你想待的地方，如果关了一个&#78716c洞穴&r，那可能是一个不错的选择"]
	quest.13AA8A73A923DDB4.quest_subtitle: "&#ef4444你正在被注视着&r"
