	quest.7E3DEEDFF6803B35.quest_subtitle: "在农业方面取得了进展！"
	quest.7E4327903A20ADEC.quest_desc: [
		"You are &lnot&r allowed to use these quests in any public pack without &4&nexplicit permission&r from Catalyst Studios."
		""
		"&bOritech&r questline made by: &aRadz&7Ratz&r"
