	quest.3822CD1546F0BC9B.quest_subtitle: "这才叫说到点子上"
	quest.3822CD1546F0BC9B.title: "&l&cSignalum 太阳能电池板"
	quest.383079759AD50C01.quest_desc: ["可存储 &#00FF7F64K 种不同物品&r"]
	quest.383079759AD50C01.quest_subtitle: "&#FFD700&o嗯，比AE2便宜，但占的空间更大&r"
	quest.3831701C09E3CC03.quest_desc: ["允许模组中的熔炉充当&#e74c3c烟熏炉&r"]
	quest.3834D00BCA561CB7.quest_desc: ["这是游戏中大量生产&6锭&r和&e合金&r的主要方式，仅限用于与&bAE2&r相关的材料！"]
	quest.3834D00BCA561CB7.quest_subtitle: "步骤一，混合材料"
	quest.384E7E52EB0C42D2.quest_desc: [
		"提升你的刷怪器&#FFE2594个属性&r，但有&#FF512F1个缺点&r：会生成更多敌人。"
		"不正是这个道理吗？嗯，是的，但你要准备好面对海量的&#FFA751战利品&r和&c&l垃圾&r"
		""
		"每个生成器只需要&#FFB75E1个升级符文&r。以后可以用&#6441A5更高等级&r的符文来升级！"
