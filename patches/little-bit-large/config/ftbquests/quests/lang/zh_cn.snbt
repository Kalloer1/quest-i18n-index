	quest.4DC0C27803D50263.title: "最后的&l&b承诺"
	quest.4DCBA85D24DFDC5C.quest_desc: [
		"需要额外的 &cQuanta？&r 放些 &bskulls&r 来增加吧！"
		""
		"&b普通头颅&r会提供&c+5% Quanta&r，而&0凋零头颅&r会提供&c+10% Quanta&r。"
