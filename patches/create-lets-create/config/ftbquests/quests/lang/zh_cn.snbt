	quest.2CFEE04BA574921E.quest_desc: [
		"&6Constructor&r 将物品或流体从存储网络放置到世界中。"
		""
		"建造器前方不能有其他方块（流体除外），并且该方块必须可以被放置（例如：树苗需要泥土）。"
		""
		"建造者也可以在世界中掉落物品，而不是放置实际的方块。当提供堆叠升级时，它会一次性掉落成堆的物品。"
	]
	quest.2DCA30B19B8F361F.title: "找到一个&2庄园&r"
	quest.2DCF9C41FA7D28E4.quest_desc: ["&6火车站&r是让火车运行的关键部分。你可以在火车站的GUI中创建火车。它的作用还包括作为火车沿路线停靠的站点，这些站点会在你输入&e列车时刻表&r时作为停靠点显示。"]
	quest.2DCF9C41FA7D28E4.quest_subtitle: "火车的途经点设置"
	quest.2DEF6ABC9BCBEB82.quest_subtitle: "用于制作各种独特的食物。"
	quest.2E159F21FFAA8235.quest_subtitle: "玻璃工匠的工作台"
	quest.2E2811D1A0F2A492.quest_desc: [
		"范围升级可以增加无线发射器的传输范围。"
		""
