	quest.310969B8FE0A94DE.quest_desc: [""]
	quest.314E41B84C8DD464.quest_desc: [""]
	quest.318593DEE275F999.quest_desc: ["可以用扳手为隧道添加窗户。隧道不会阻止传送带上的物品被封闭式风扇处理，但会阻止气流超出传送带。安山岩隧道也可用于将单个物品从通过的堆叠中分离到侧面出口。"]
	quest.318593DEE275F999.title: "合成 &b安山岩隧道"
	quest.31E69CA962A58692.quest_desc: [""]
	quest.31E69CA962A58692.quest_subtitle: "智能流体管道可用于只允许特定液体通过。将一桶或一瓶该液体放入管道的过滤器槽中即可设置。智能管道可能需要“尊重数据”的列表过滤器来区分某些液体，例如药水。"
	quest.31E69CA962A58692.title: "合成 &6智能流体管道"
	quest.3267C71EB8176867.quest_desc: [
		"灵晶需要用一颗绿宝石来制作。"
		"用于制作带有灵魂附魔的物品。"
	]
	quest.3267C71EB8176867.title: "灵性水晶"
	quest.3281BDCB53C2399A.quest_subtitle: "堆叠大小 16x"
	quest.328FEEA1A7803F0B.quest_desc: ["&6钻石背包&r是&e黄金背包&r的升级版。它有108个储物格，可容纳5个升级"]
	quest.328FEEA1A7803F0B.quest_subtitle: "随时随地，海量存储"
	quest.329A0A04AAE4E21E.quest_desc: [""]
	quest.329A0A04AAE4E21E.quest_subtitle: "&6远古工厂&r是位于主世界的罕见地下地牢，可通过&6机械之眼&r进入。在此设施内，玩家会遇到发射激光束的观察者，以及装备旋转锯和追踪导弹的机器人小头目——潜行者。工厂的核心是休眠的预兆者，一种机械凋零变种。当玩家将下界之星放入其胸腔时，它会苏醒，开启一场包含导弹、激光和毁灭性冲锋的激烈战斗。玩家可以战略性地使用遍布竞技场的电磁脉冲块来暂时禁用预兆者。胜利后，玩家将获得凋零岩块，可用于制作肉末破碎机、激光加特林和凋零突击肩炮等强力武器，以及机械融合砧。&6&l击败首领预兆者以获得凋零岩锭&r&r"
	quest.329A0A04AAE4E21E.title: "找到&4远古工厂"
	quest.32B9EAE28E1C5D7A.quest_desc: [""]
	quest.32B9EAE28E1C5D7A.quest_subtitle: "&c电子管是一种仅用于合成配方中的物品。&r"
	quest.34346949C3804907.quest_desc: ["和往常一样，最好按住 &b'Ponder'&r 来观看它的运作。"]
	quest.34346949C3804907.quest_subtitle: "&e犁&r可以清除非碰撞方块（如火把等）并将泥土变为农田，但它们最擅长的用途是&c击飞实体&r。"
	quest.34346949C3804907.title: "合成 &5机械犁"
	quest.34C409E6FF596E2A.quest_desc: [
		"&6列车时刻表&r很有用，你可以决定列车在车站之间的行驶顺序，以及在出发前在车站停留的时间。"
		""
		"右键点击火车控制器旁的&e红色座椅&r上的生物，即可将其设为火车司机，他们会遵循火车时刻表"
	]
	quest.34C409E6FF596E2A.quest_subtitle: "决定火车何时移动"
