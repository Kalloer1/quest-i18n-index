	]
	quest.2E9D393C13EEEAEC.quest_desc: [
		"&6沉没之城&r是一座罕见的海底神殿，生成于深海生物群系，包含图书馆、监狱和矿脉等多个房间。神殿内有各种敌对生物，如手持珊瑚矛的深海怪和守卫各区域的珊瑚巨兽。玩家必须穿过神殿，并制作出深渊祭品。"
		""
		"&6&l击杀 Warlock、priest 和 Coralssus 以获取 Athame 和 Coral Chunk&r&r"
		""
		"&l&4沉没之城&r"
		"{image:kubjs:textures/shuken.png width:200 height:100 align:center}"
		"&l&2生物群系生物"
		"&l&6术士（Warlock）"
		"{image:kubjs:textures/warloack.png width:200 height:100 align:center}"
		"&l&6Coralssus"
		"{image:kubjs:textures/coralssus.png width:200 height:100 align:center}"
	]
	quest.2E9D393C13EEEAEC.title: "找到&4沉没之城"
	quest.2ECEAFAF8FDFF38B.title: "收集迅捷潜行 3"
	quest.2ED982AECD1576C0.quest_subtitle: "播放音乐唱片，化身行走的 DJ 台"
	quest.2EFA38D9491535EA.quest_subtitle: "&e显示链接&r可以读取方块并向链接的显示器输出信息。非常适合读取物品栏等。"
