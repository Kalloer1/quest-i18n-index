	quest.43DCAE3252C7FBA1.quest_subtitle: "&cClockwork Bearing&r 是 &bMechanical Bearing&r 的进阶版，可根据当前游戏时间旋转最多两根时钟指针。&r"
	quest.43DCAE3252C7FBA1.title: "合成 &6Clockwork Bearing"
	quest.43E8912CB307E421.quest_desc: [
