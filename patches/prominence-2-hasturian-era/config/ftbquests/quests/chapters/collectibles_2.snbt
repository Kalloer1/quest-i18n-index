	quests: [
		{
			icon: "minecraft:spyglass"
			id: "5D3A89762F7D75E1"
			shape: "gear"
			size: 1.5d
			subtitle: "欢迎，年轻的收藏家。在你面前的，是一个收集各种小物件和配饰，供人们欣赏的地方。你准备好迎接挑战了吗？"
			tasks: [{
				id: "22BAEFCC54EFB488"
				title: "获取 Hoardin！"
				type: "checkmark"
			}]
			title: "收藏家之旅"
			x: 1.5d
			y: 0.75d
		}
		{
			dependencies: ["5D3A89762F7D75E1"]
			icon: "things:gleaming_compound"
			id: "2C85CD8FC581F6AD"
			shape: "diamond"
			subtitle: "欢迎来到 The Thing！你必须找到 Things 并收集它们来造福自己。你不能给每件小物件命名，只需称它们为 Thing，不多不少。"
			tasks: [{
				id: "45A2B5B77BE11595"
				title: "需要收集的物品"
				type: "checkmark"
			}]
			title: "那个东西！"
			x: -10.0d
			y: 0.5d
		}
		{
			dependencies: ["5D3A89762F7D75E1"]
			icon: "artifacts:mimic_spawn_egg"
			id: "4A01B44240D7BE4A"
			shape: "diamond"
			tasks: [{
				id: "0469124D2B6A5899"
				title: "需要收集的饰品类物品碎片"
				type: "checkmark"
			}]
			x: 13.0d
			y: 0.5d
		}
		{
			dependencies: ["5D3A89762F7D75E1"]
			icon: "minecraft:jukebox"
			id: "2043E02E41A0B203"
			shape: "diamond"
			subtitle: "嗨，年轻的音乐爱好者！既然你来了，就说明你知道音乐是我们生活中不可或缺的一部分！这些唱片几乎被时间遗忘，但我们仍能抢救它们！你必须找到它们，聆听其中的美妙旋律。"
			tasks: [{
				id: "3A226781B8153052"
				title: "找到唱片碎片 (Discs)"
				type: "checkmark"
			}]
			x: 1.5d
			y: -2.0d
		}
		{
			dependencies: ["5D3A89762F7D75E1"]
			icon: "soulsweapons:iron_skull"
			id: "786473059A3C26CD"
			shape: "diamond"
			subtitle: "尊重逝者固然重要，但发现有趣的遗骸并将其展示出来，以彰显历史，也是一件值得骄傲的事。找到后用刷子挖出来，并向它们致以敬意。"
			tasks: [
				{
					id: "60C5D2A6FA3515D1"
					title: "找到生物头颅 (Mob Heads)"
					type: "checkmark"
