	order_index: 1
	quest_links: [ ]
	quests: [
		{
			description: [
				"&7制作或获取工具、盔甲或武器时，你会发现它们有不同的品质。"
				""
				"&7品质范围如下："
				"&8- &f普通"
				"&8- &2不常见物品"
				"&8- &3稀有物品"
				"&8- &d史诗级"
				"&8- &6传说级"
				"&8- &c神话模组"
				""
				"{@pagebreak}"
				""
				"&6重铸&7是你自身进阶的重要组成部分，因为它能让你改变物品的稀有度。"
				""
				"&7To do so, you can find the &eReforging&7 tab in an &eAnvil&7. You will require:"
				""
				"&8- &e基础材料 &8(左侧栏位)"
				"&8- &e需要重铸的物品 &8(中间栏位)"
				"&8- &e重铸材料 &8(右侧栏位)"
				""
				""
				"{@pagebreak}"
				""
				"&e&l基础材料 &r&8(左侧栏位)"
				""
				"&7基础材料与你想要重铸的物品直接相关。例如，&eHoly Wand&7需要&eGold Ingot&7作为基础材料。将物品放入中间槽位后，悬停在重铸按钮上即可查看所需材料。"
				""
				""
				"{@pagebreak}"
				""
				"&e&l基础物品 &r&8(中间槽位)"
				""
				"&7基础物品是指你想要更改稀有度的物品。并非所有物品都可以重铸，只有工具、武器和盔甲可以。"
				""
				""
				"{@pagebreak}"
				""
				"&e&l重铸材料"
				""
				"&7此材料将决定你的物品被重铸后的品质，共有3个材料等级，可在本系列任务的后续任务中看到。"
				""
				""
				"{@pagebreak}"
				""
				"&a&l提高你的几率</c2></c1>"
				""
				"&7并非只有肝！你可以用&a幸运&7来&e提高高品质物品的掉落率&7！幸运物品、幸运药水、饰品、葡萄酒，统统拿下！"
			]
			id: "3C95FD1F14D109CF"
			shape: "hexagon"
			subtitle: "&8[点击阅读说明]"
			tasks: [{
				id: "71FAC91280FBBF9C"
				item: "minecraft:anvil"
				title: "制作一个铁砧 Anvil"
				type: "item"
			}]
			title: "&e什么是重铸？(What is Reforging?)"
