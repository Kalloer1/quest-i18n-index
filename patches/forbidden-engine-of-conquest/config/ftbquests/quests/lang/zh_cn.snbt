	file.0000000000000001.title: "&6&l禁忌：&b征服引擎"
	quest.000BE9DC2C9D3FE7.quest_desc: ["&6The&r Brass Chestplate is part of the Brass Suit from Create Stuff 'N Additions. It is crafted with &b8&r Brass Ingots and has 400 durability, making it the most durable piece of the &bstandard&r brass armor set."]
	quest.000BE9DC2C9D3FE7.quest_subtitle: "为工厂建造的防护设施"
	quest.000C959368903F8B.quest_desc: [
		"&dThe&r Scarecrow Hat is part of the Scarecrow Armor set in Iron's Spells 'n Spellbooks. When equipped, it provides &b+3&r Armor and &b+75&r Max Mana."
		""
		"用皮革帽和雕刻南瓜制作这顶奇特的魔法帽，拥抱稻草人的&b神秘&r力量。"
	]
	quest.000C959368903F8B.quest_subtitle: "拥抱稻草人的奇妙魔法吧"
	quest.000FC26B648D7721.quest_desc: ["从Cataclysm模组中获取&aIgnitium锭&r。Ignitium由下界的&b传奇&r金属锻造而成，主要在击败Ignis后获得，用于制作Cataclysm中一些&b最强大&r的武器、盔甲和遗物。"]
	quest.000FC26B648D7721.quest_subtitle: "火焰领主锻造出的金属"
	quest.00105AA28075F66E.quest_desc: ["&a从Cataclysm模组中获取&r The Immolator。这件&b传奇&r武器蕴含着火焰的力量，每次挥砍都能灼烧敌人，&b象征着&r下界的毁灭之力。只有&b征服了Burning Arena火焰的&r勇士&b才能&r拥有这样一件武器。"]
	quest.00105AA28075F66E.quest_subtitle: "在炼狱之心锻造的锋利刀刃"
	quest.00105AA28075F66E.title: "&c焚毁者 (The Immolator)"
	quest.0019C8CF26C8D6E6.quest_desc: ["&6Nixie&r Tubes 是 Create 的紧凑型数字显示屏。它们可以通过命名牌显示文本和数字，并且可以&b将多个&r管子放在一起以创建更长的显示屏。它们还可以显示从 0 到 15 的红石信号强度，因此可用于计数器、定时器、状态指示器和其他自动化系统。Nixie Tubes 可以被染色以&b更改&r其显示颜色，并且可以通过 Display Links &b接收&r信息。"]
	quest.0019C8CF26C8D6E6.quest_subtitle: "让数字来说明一切"
	quest.003A8D9C85DB66D9.quest_desc: ["当你的子弹命中时，会&d设置&r目标为&b火焰&r，随时间附加额外的燃烧伤害。"]
	quest.003A8D9C85DB66D9.quest_subtitle: "把它们点亮吧"
	quest.005C13436B51FF2D.quest_subtitle: "更多盔甲 (More Armor)"
	quest.006D79A07FE206CC.quest_desc: ["&6A&r simple lamp that glows when you pass &bcurrent&r through it. It needs a current-limiting resistor or it breaks right after lighting up."]
	quest.006D79A07FE206CC.quest_subtitle: "通电时会发出光芒"
	quest.008D567C087C638C.quest_desc: [
		"Amaramber 镐是永恒星光中&a采矿&r工具，&b于&r0.4.2版本作为Amaramber装备套装的一部分引入。"
		""
		"&aIt&r is &bused&r for standard mining progression within the Starlight dimension and is crafted from Amaramber materials obtained from Torreya-related &bresources&r."
	]
	quest.008D567C087C638C.quest_subtitle: "琥珀采矿工具"
	quest.009F54FC4421820A.quest_desc: ["&d秘法&r锭是 Iron's Spells 'n Spellbooks 的重要合成材料。它由浓缩秘法精华制成，用于&b高级&r魔法合成，包括强大的&b装备&r和武器部件。"]
	quest.009F54FC4421820A.quest_subtitle: "将魔法精华凝聚成强大的秘银金属"
	quest.00AA36F8E1AB4842.quest_desc: [
		"&d火&r符文是 Iron's Spells 'n Spellbooks 中的一个合成材料，用于高级的与&b火&r相关的合成，包括火焰升级球。它是&b火系&r的符文石版本。"
		""
		"将空白符文石与8根烈焰棒结合，&b创造&r火焰符文。烈焰棒是该模组的火焰焦点。"
	]
	quest.00AA36F8E1AB4842.quest_subtitle: "用火焰魔法的炽热力量灌注一块符文石"
	quest.00ABC8F7876F68AD.quest_subtitle: "真美味！"
	quest.00C2B4287BE62369.quest_desc: ["&6镀金石英铲子&r是 Create Stuff 'N Additions 镀金石英工具套装的一部分。它有 1644 的耐久度，是标准铲子的强力&b替代品&r。它由&b抛光玫瑰石英、铁板、金子和优质工具手柄&r制作而成。镀金石英工具以其&b更快的&r挖掘和攻击速度而闻名。"]
	quest.00C2B4287BE62369.quest_subtitle: "用黄金般的手去挖掘吧"
	quest.00D9C1D70B5E3AC3.quest_desc: [
		"&dSpellbreaker&r 是 Iron's Spells 'n Spellbooks 中一把强大的附魔剑。它可以被&b附魔&r1个法术，自带 Counterspell I 作为附魔法术。"
		""
		"主手持有时，提供&b10&r点攻击力、&b1.8&r的攻击速度以及&b+15%&r的冷却缩减。Counterspell I消耗&b50&r点法力值，并有&b5秒&r的冷却时间。"
		""
		"它是一种与武器部件系统一同推出的&b可制作&r武器。"
	]
	quest.00D9C1D70B5E3AC3.quest_subtitle: "用专为反击咒语锻造的利刃，粉碎敌人的魔法"
	quest.00E3EBCB9222F522.quest_desc: [
		"&a热泉石胸甲&r是永恒星光中一件用&b热泉石锭&r制作的防护盔甲。"
		""
		"Thermal Springstone &aarmor&r 点燃攻击的敌人，并提供显著的火伤防护，使其在危险的炎热环境中&b十分有用&r。"
	]
	quest.00E3EBCB9222F522.quest_subtitle: "防火的盔甲护身装备"
	quest.00FC2A0CB2BA8D1E.quest_subtitle: "真美味！"
	quest.011376CB499B67C9.quest_desc: ["&6制作&r卡片刻录器，创建独特的脚本卡片。插入卡片并配置其代码以记录信息。使用&b卡片读取器&r可检查生成的卡片，而卡片的&b脚本&r则可用放大镜查看。卡片会注册到创建者名下，&b防止&r其他玩家直接复制相同的脚本卡片。"]
	quest.011376CB499B67C9.quest_subtitle: "编写你自己的卡牌程序"
	quest.011394DC44B442FC.quest_subtitle: "真美味！"
	quest.01195E83FF391E1C.quest_desc: ["&6从Create模组中获取&r智能滑道。它是滑道的进阶版，可以过滤提取的&b物品&r，因此对于自动化存储和分拣系统非常&b有用&r。结合过滤器、列表过滤器或属性过滤器，它可以选择性移动特定物品，同时&b留下&r其余物品。"]
	quest.01195E83FF391E1C.quest_subtitle: "精准整理你的物品分类"
	quest.013488785BFC139B.quest_subtitle: "更多盔甲 (More Armor)"
	quest.013CEB32007F6505.quest_desc: ["&dThe&r Cowboy Hat has a special ability: when you &bkill&r something with a gun, your gun is instantly reloaded. It has a cooldown before it can trigger again, so make every kill count."]
	quest.013CEB32007F6505.quest_subtitle: "原地重新加载世界"
	quest.0150B552F3BB0296.quest_subtitle: "真美味！"
	quest.01510311E42F692C.quest_desc: ["使用Cataclysm模组的材料，&a制作&r一件Cursium胸甲。这件&b强大的&r胸甲，需要在锻造台里，用Cursium &b升级&r锻造模板和Cursium锭，来升级下界合金胸甲。它是Cursium盔甲套装的一部分，穿戴后可提供强大的&b能力&r。"]
	quest.01510311E42F692C.quest_subtitle: "由被诅咒的灵魂锻造而成的盔甲"
	quest.0185F48F7668F433.quest_desc: [
		"&9&lThe&r&r Limited Oak Barrel I is an early storage option from Sophisticated Storage. While its capacity is limited, it &bprovides&r a practical and compact place to keep your items organized."
		""
		"&bUse&r it as a stepping stone toward larger and &bmore&r advanced storage containers as your storage system grows."
	]
	quest.0185F48F7668F433.quest_subtitle: "一个紧凑的桶，还有改进的空间"
	quest.0191B94C2BBEE2BE.quest_desc: [
		"Thallasium 剑柄是用于在 &a锻造台&r 上组装 Thallasium 剑的组件。"
		""
		"它通过 &b工具组装&r锻造模板与塔拉西姆工具头相结合。"
	]
	quest.0191B94C2BBEE2BE.quest_subtitle: "用于Thallasium刀刃的握柄"
	quest.019BF7D04AEEDC5F.quest_desc: ["&a击败&r来自Cataclysm模组的3个深海祭司。这些强大的水生敌人&b使用&r魔法攻击，可在深海中的深海祭司&b结构&r中找到。击败它们有助于清除水下遗迹中&b危险的&r居民。"]
	quest.019BF7D04AEEDC5F.quest_subtitle: "击败海洋的黑暗萨满们"
	quest.019BF7D04AEEDC5F.title: "击杀深渊牧师（Deepling Priest）"
	quest.01C20F39FB43985D.quest_desc: [
		"&l&9Improve&r&r the efficiency of compatible Refined Storage devices with the Stack Upgrade. It &ballows&r devices to process or transfer larger quantities of items at once, reducing the number of operations &bneeded&r and making your automated systems more efficient."
		""
		"将其安装在&b兼容&r的设备中，让您的网络以更大的批次处理资源。"
	]
	quest.01C20F39FB43985D.quest_subtitle: "每次操作处理更多物品"
	quest.020BB6244390D975.quest_desc: ["&6获取&r一个来自Create的Sticker。它是一种机械附着块，用于将方块临时粘附在移动的机械装置上。当用红石信号&b激活&r时，它会伸出并附着到前方的方块上，使该方块能随装置一同移动。Sticker尤其适用于较小的、有选择的&b附着&r，而Super Glue在这种情况下会过于强大。"]
	quest.020BB6244390D975.quest_subtitle: "把你的装置组合起来吧"
	quest.02497D0A52780F58.title: "整合包创作者生病了"
	quest.024B506A6251907A.quest_desc: [
		"&d隐身戒指&r是 Iron's Spells 'n Spellbooks 中的一个有趣小物件。尽管&b名字&r如此，但它并不会让&b佩戴者&r隐身——戒指本身才是隐身的。"
		""
		"模组魔法奇物中隐藏的&b神秘&r小玩笑。"
	]
	quest.024B506A6251907A.quest_subtitle: "戒指是隐形的，但笑话可不是"
	quest.0253E8C650B6D950.quest_desc: [
		"&e并非&r所有遗迹都必须有用。"
		""
		"Whoopee Cushion 在潜行开始时&b偶尔&r会发出放屁声。仅此而已。没有隐藏力量，没有秘密能力——纯粹是幼稚的喜剧效果。"
		""
		"&b悄悄&r潜行。或者不潜行。"
	]
	quest.0253E8C650B6D950.quest_subtitle: "悄悄地潜行。或者不潜行也行。"
	quest.02541FC2E84A51F8.quest_desc: ["&6从Create模组中获取&r齿轮换挡器。它通常像传动轴一样传递&b旋转&r力，但当接收到红石信号时，它会反转输出的旋转&b方向&r。这使得它可用于&b控制&r机械系统的方向。"]
	quest.02541FC2E84A51F8.quest_subtitle: "逆转能量的流动方向"
	quest.0266D98A5FBF3790.quest_desc: [
		"&6Not&r every aircraft needs a powerful engine. The Gyrodyne relies on human power and requires a good initial push to &bget&r its rotor spinning, while the Quadrocopter &btakes&r a more experimental approach with four propellers mounted on a bamboo frame."
		""
		"建造两种飞行器，&b体验&r两种截然不同的飞行方式。"
	]
	quest.0266D98A5FBF3790.quest_subtitle: "从人力到四个旋转的螺旋桨。"
	quest.0266D98A5FBF3790.title: "Gyrodyne \& 四轴飞行器"
	quest.0268C80107F12D7A.quest_desc: [
		"&e能跑&r何必走？"
		""
		"跑步鞋能让你冲刺时移动速度提升&b40%&r，还能越过&b一格高&r的障碍而不需要跳跃。非常适合在旅途中快速穿行，不必因地形而&b频繁&r停下脚步。"
		""
		"&b保持&r奔跑。没有什么能阻挡你。"
	]
	quest.0268C80107F12D7A.quest_subtitle: "跑得更快。跳得更高"
	quest.027736EF66F1B626.quest_subtitle: "升级+"
	quest.0289A9A5C9B1631E.quest_desc: ["黄金&a能为你的护甲增强&r独特属性。这副护腿可能防御力不是最高，但在&b战斗中&r能提供实用的加成和灵活性。"]
	quest.0289A9A5C9B1631E.quest_subtitle: "敏捷与风格"
	quest.0289A9A5C9B1631E.title: "黄金下界合金护腿"
	quest.028BB0FE39A10D3E.quest_desc: ["&6从Create模组中获取&r对称魔杖。这是一种强大的建筑工具，可&b自动&r镜像你放置或&b破坏的方块，&r沿所选轴或图案。它支持单次镜像、矩形和八角模式，尤其适用于对称建筑和大型结构。其&b默认&r范围为50个方块。"]
	quest.028BB0FE39A10D3E.quest_subtitle: "建造速度提升两倍"
	quest.028FF00496C34DB2.quest_desc: [
		"&aCraft&r a Photo Album to &bstore&r your Developed Film Rolls and Photographs."
		"使用Interplanar Projector整理照片，轻松查看或投影。"
	]
	quest.028FF00496C34DB2.quest_subtitle: "保护好你的记忆，让它们免受伤害"
	quest.02AAF18545E544D1.quest_desc: [
		"&d棱镜&r骑士胸甲是棱镜骑士盔甲套装的一部分，也是《水晶编年史》中&b最坚固&r的盔甲套装。"
		""
		"使用 Iron’s Spells ’n Spellbooks 中的 Divine Soulshard 来&b制作&r，也可以通过升级任意&b增强&r的 Crystal Chronicles 盔甲套装的胸甲来制造。Prismatic Knight Armor &b代表&r了 Crystal Chronicles 盔甲进阶的最终也是最强大的阶段。"
	]
	quest.02AAF18545E544D1.quest_subtitle: "由水晶编年史的力量锻造而成的终极胸甲"
	quest.02D89EF9720A17CC.quest_desc: ["&dBloody&r Vellum is a crafting ingredient added to Iron's Spells 'n Spellbooks. It is made using Hogskin and Blood in the Alchemist Cauldron and is used in recipes for powerful &bblood-related&r magical equipment, &bincluding&r the Vampiric Spell Book."]
	quest.02D89EF9720A17CC.quest_subtitle: "将古代羊皮纸注入血液的精华"
	quest.02DB1F6B9D031153.quest_subtitle: "真美味！"
	quest.02E0B3B8DCD33635.quest_desc: [
		"The Deepsilver Pickaxe is a &amining&r tool from Eternal Starlight crafted &busing&r Deepsilver Ingots."
		""
		"它&a是&r沼泽和暮色区域使用的早期到中期的镐，&b耐用性&r介于铁和钻石之间。"
	]
	quest.02E0B3B8DCD33635.quest_subtitle: "沼泽采矿工具"
	quest.02E1B47EAEDBA692.quest_subtitle: "更多盔甲 (More Armor)"
	quest.02FD2A409C20DF22.quest_desc: [
		"&a制作&r鱼竿，探索水面下&b隐藏&r的无数宝藏。虽然&b鱼&r是最常见的收获，但耐心的垂钓者可能会钓到附魔书、贵重装备或其他意想不到的奖励。"
		""
		"&a钓鱼&r不仅是可靠的食源，也是一种在河流、湖泊和广阔海洋中，&b收集&r稀有战利品并为即将到来的&b冒险&r做准备的方式。"
	]
	quest.02FD2A409C20DF22.quest_subtitle: "将鱼线抛向未知的远方"
	quest.02FD2A409C20DF22.title: "钓鱼竿"
	quest.0302A490E961138F.quest_subtitle: "真美味！"
	quest.030FE9082358AAB5.quest_desc: [
		"&9&l你&r&r不必替换所有箱子和桶来建造数字存储系统。外部存储允许你的 Refined Storage 网络&b访问&r相连物品栏中存储的物品，仿佛它们是网络的一部分。"
		""
		"将其连接到箱子、桶或其他&b兼容&r的存储方块，让 Refined Storage 直接访问其&b内容&r。无需将所有物品移至存储盘中即可扩展网络的绝佳方式。"
	]
	quest.030FE9082358AAB5.quest_subtitle: "将现有存储连接到你的数字网络"
	quest.031177D7283A6D4A.quest_desc: [
		"&9&lBefore&r&r creating a storage disk, you &bneed&r a proper housing to hold its components together. Storage Housing is a key crafting component &bused&r to create storage disks for your Refined Storage network."
		""
		"制作一个，&b迈&r向扩展数字存储容量的第一步。"
	]
	quest.031177D7283A6D4A.quest_subtitle: "建造你的存储磁盘的基础设施"
	quest.0313789839DC5379.quest_desc: [
		"&d空白&r升级球是制作铁之法术与法术书系列中不同升级球的基础材料。它可以被转化为&b特殊&r球，例如火焰、冰霜、闪电、神圣、血液、召唤、自然、末地、法力、保护和冷却升级球。"
		""
		"&b使用&r空白升级球来&b开始&r在秘法砧上升级魔法装备。"
	]
	quest.0313789839DC5379.quest_subtitle: "强大魔法升级的基础设施"
	quest.03195A236D34AD1B.quest_desc: [
		"&e水&r不必拖慢你的脚步。"
		""
		"Flippers 能大幅提升游泳速度，让你能以更高的敏捷性在水下&b移动&r。装备后，你将能更快地探索海洋、河流和水下&b结构&r。默认情况下，它们提供 &b+100%&r 的游泳速度。"
		""
		"&b潜入&r吧。这片水域属于你。"
	]
	quest.03195A236D34AD1B.quest_subtitle: "像天生就会游泳一样畅游水中"
	quest.031D6C4EFA6F9ACB.quest_desc: ["&d每次射击都有几率&r&b返还&r所消耗的弹药，延长弹匣的续航能力。"]
	quest.031D6C4EFA6F9ACB.quest_subtitle: "永远不要让自己干渴难耐"
	quest.0354FE634B3BA6EB.quest_desc: ["&aSimple Voice Chat&r 让你能用麦克风在游戏内与其他玩家交谈。只有附近的玩家才能听到你的声音，使互动更具沉浸感和真实感。你可以在模组的设置菜单中调整麦克风&b设置&r、音量和拾音距离。确保麦克风设置正确，这样每个人都能清楚地听到你。"]
	quest.0354FE634B3BA6EB.quest_subtitle: "请先阅读此内容！"
	quest.0354FE634B3BA6EB.title: "&a简易语音聊天"
	quest.0361ECBFF743E37B.quest_desc: ["&6分层磁体&r是Create: New Age中的一个高级磁性组件。通过将多种磁性材料分层组合，它能提供更强&b的磁力，&r用于更先进的电气和&b发电&r技术。升级你的磁性装置，为工厂电气发展的&b下一&r阶段做好准备。"]
	quest.0361ECBFF743E37B.quest_subtitle: "将磁力层层叠加起来"
	quest.036BD1517ACB7B22.quest_desc: [
		"&a炽热锭&r是暮色森林中最&b珍贵&r的锻造材料之一。它由九头蛇的神秘精华锻造而成，蕴含着巨大的热量和魔法能量，能让&b技艺高超&r的锻造师打造出能抵御最残酷战斗的&b装备&r。"
		""
		"&aWeapons&r and armor &bcrafted&r from Fiery Ingots are renowned for their exceptional durability and blazing power, making them an essential upgrade for adventurers preparing to challenge the strongest &bcreatures&r hidden within the Twilight Forest."
	]
	quest.036BD1517ACB7B22.quest_subtitle: "在九头蛇的火焰中锻造而成"
	quest.036D672ABA4A9608.quest_desc: ["从Cataclysm模组中&a获取&rBlazing Grips。这副&b传奇&r手套&b注入了&r下界永恒火焰的力量，能让佩戴者释放出毁灭性的火焰攻击。对于那些&b征服&r地狱领域的人来说，这是一件当之无愧的奖杯。"]
	quest.036D672ABA4A9608.quest_subtitle: "毫无畏惧地抓住火焰吧"
	quest.036DBC8E98B9BD89.quest_desc: ["&6从Create模组中获取&r火车外壳。它是&b建造&r火车和铁路基础设施所需的关键组件之一。火车外壳是通过将&b坚固板应用到黄铜外壳上&r制成的"]
	quest.036DBC8E98B9BD89.quest_subtitle: "锻造你铁路帝国的基石"
	quest.03826AFFC76629E2.quest_desc: ["从Cataclysm模组中&a获取&r被诅咒的弓。这件&b强大的&r远程武器由Frosted Prison中的Maledictus掉落。它是一把具有特殊攻击的&b独特&r弓，可无视&b常规&r伤害减免机制。"]
	quest.03826AFFC76629E2.quest_subtitle: "一把被黑暗力量诅咒的弓"
	quest.03826AFFC76629E2.title: "&d被诅咒的弓"
	quest.0390D4F9CEDAD5CC.quest_desc: [
		"&dPyromancer&r靴是Iron's Spells 'n Spellbooks中Pyromancer盔甲套装的一部分。穿戴后可提供&b+3&r护甲、&b+125&r最大法力、&b+10%&r火焰法术强度和&b+5%&r法术强度。"
		""
		"在当前版本中，它们使用火符文、巫师靴和奥术精华来&b制作&r或升级。"
	]
	quest.0390D4F9CEDAD5CC.quest_subtitle: "借助火焰魔法的力量，在烈焰中穿行"
	quest.03B1C538ED56A66F.quest_subtitle: "更多盔甲 (More Armor)"
	quest.03B2155FDB3E1844.quest_desc: [
		"有时候光建造还不够——你还需要清理空间。"
		"破坏模板能让你的建造棒一次性破坏多个方块，让大型清理任务变得轻松许多。"
		""
		"使用此升级来快速移除方块，为新建筑做好准备。"
	]
	quest.03B2155FDB3E1844.quest_subtitle: "更快地破坏方块"
	quest.03C2520CBD4C3309.quest_desc: [
		"&d《&r雷伊之书》是 Iron's Spells 'n Spellbooks 的 Cataclysm Spellbook Addon 中的一本强大魔典。它提供 &b12&r 个法术位、&b+30%&r 深渊法术强度和 &b+300&r 最大法力值，是致力于深渊恐怖力量的法师的绝佳&b选择&r。"
		""
		"挥舞这本禁忌魔典，&b拥抱&r潜藏于深渊之外的远古邪力。"
	]
	quest.03C2520CBD4C3309.quest_subtitle: "释放来自深海的深渊之力"
	quest.03C4AE7A97E285C2.quest_desc: ["&a获取&r Lacrima，一种来自 L_Ender’s Cataclysm 的稀有材料。该&b材料&r是 Cataclysm 的合成资源之一；该模组也收到了更新，&b专门&r改变了 Lacrima 的外观。"]
	quest.03C4AE7A97E285C2.quest_subtitle: "一滴蕴含着远古力量的泪水"
	quest.03CB549D5D816498.quest_desc: ["&6经验堆&r是 Create Stuff 'N Additions 的一种经验合成材料。它由 9 个经验锭合成，并&b用作&r该模组经验类工具和装备的合成组件。储备好这些经验堆，为更先进的&b经验&r技术&b做好准备&r。"]
	quest.03CB549D5D816498.quest_subtitle: "收集你的知识，做好准备迎接挑战"
	quest.03D75A772FA1D39F.quest_desc: [
		"&9&lTired&r&r of running out of inventory space? The Backpack gives you extra storage that you can carry wherever you go. It can be worn on your back, &bopened&r directly from your inventory or placed in the world when you need a proper storage container."
		""
		"而这仅仅是&b开始&r——升级背包以扩大容量并解锁强力升级。"
	]
	quest.03D75A772FA1D39F.quest_subtitle: "无论冒险将你带向何方，你的储物空间都随你而动"
	quest.03F1250FD8A16DA3.quest_subtitle: "升级+"
	quest.042954A042B740AF.quest_desc: [
		"&a获取&r工具组装锻造模板，用于在锻造台将更好的末地工具头和手柄组合成完整的&b工具&r。"
		""
		"这是制作 Thallasium、Terminite 和 Aeternium 工具和&b武器&r的核心部分。"
	]
	quest.042954A042B740AF.quest_subtitle: "将工具组装在一起"
	quest.0438C4A2D6F5CB01.quest_subtitle: "更多盔甲 (More Armor)"
	quest.044A7AA5CB774CEC.quest_desc: ["&d一种&r珍贵的合成材料，&b用于&rHazen N Stuff 中武器、装备和其他特殊物品的各种配方。"]
	quest.044A7AA5CB774CEC.quest_subtitle: "一种用于强力合成的深色材料"
	quest.045B48F33E0F4F13.quest_desc: ["&6Craft&r the Magnifying Glass and &buse&r it to inspect scripted Cards. With a Card in your off-hand, the Magnifying Glass lets you view the card's script, making it easier to examine and understand &bprogrammed&r cards in Create: Misc \\& Things."]
	quest.045B48F33E0F4F13.quest_subtitle: "探索其中的秘密吧"
	quest.0473C3BA0E426525.quest_desc: ["&d你的&r子弹在击中时会生成一个&b毒&r云，并对目标施加中毒效果。"]
	quest.0473C3BA0E426525.quest_subtitle: "毒云"
	quest.0480BA45729F5784.quest_desc: [
		"&d稀有&r墨水是 Iron's Spells 'n Spellbooks 中第三级的魔法墨水。它用于卷轴锻造台来制作&b稀有稀有度&r的卷轴，以及在神秘砧中升级需要稀有墨水的卷轴。"
		""
		"在魔法结构中查找这种&b珍贵&r的墨水，或从强大的魔法生物处获取。"
	]
	quest.0480BA45729F5784.quest_subtitle: "用于强大魔法的精炼精华"
	quest.0480BA45729F5784.title: "&b稀有墨水"
	quest.049EE80BF0B3E210.quest_desc: ["&6获得&r来自Create的Encased Fan。当旋转力驱动时，它能&b产生&r可推动或拉动实体的气流。通过正确的&b处理&r装置，其气流还能进行批量爆破、烟熏、清洗和惊吓，使其成为Create最通用的&b处理&r组件之一。"]
	quest.049EE80BF0B3E210.quest_subtitle: "驾驭流动空气的力量，掌控气流"
	quest.04A61F614DD87EC4.quest_desc: ["&6An&r electric bell that makes sound when you &bpower&r it. Use it as an alarm for faults or overloads."]
	quest.04A61F614DD87EC4.quest_subtitle: "一个警报铃铛"
	quest.04A6BA7CF2878664.quest_desc: [
		"随着你在永恒星光中&a进步&r，更强壮的&b生物&r和更稀有的资源开始出现。"
		"最重要的包括精炼的 Aethersent Ingot 和稀有的 &aCreator&r Hide——这些材料与高级 &acrafting&r 和更高等级的 &bprogression&r 相关。"
		""
		"&a获得&r这两者都证明你已超越基础生存，进入了维度中更危险的阶段。"
	]
	quest.04A6BA7CF2878664.quest_subtitle: "深层维度的资源"
	quest.04A6BA7CF2878664.title: "&6高级星光材料"
	quest.04A8EA39E3354930.quest_desc: [
		"在充满活力的永恒星光&b大地&r中，绯红森林以其深红色的植被和独特的氛围脱颖而出。"
		"这个&a生物群系&r富含独特资源，但也栖息着适应其密集环境的危险生物。"
		""
		"&a探索&r能扩展你对该维度的了解，并解锁新的&b进阶&r机会。"
	]
	quest.04A8EA39E3354930.quest_subtitle: "绯红荒野"
	quest.04A8EA39E3354930.title: "&c绯红森林"
	quest.04BE87C434B821DA.quest_desc: [
		"&e既然能像兔子一样蹦蹦跳跳，&r干嘛要满足于&b普普通通&r的跳跃？"
		""
		"兔跳靴能将你的跳跃高度增加一格，最高可跳至 &b2&r 格高。它们还能 &b保护&r 你免受坠落伤害，让高空跳跃更安全。"
		""
		"飞跃&b障碍&r，无畏着陆。"
	]
	quest.04BE87C434B821DA.quest_subtitle: "跳得更高，摔得更安全"
	quest.04D1B2AE5F05F374.quest_desc: [
		"&e凋零的&r力量可能&b令人恐惧&r——但如果你能自己掌控它呢？"
		""
		"枯萎手镯&b使&r你的近战攻击有一定几率对敌人施加枯萎效果。单次攻击就能让你的&b对手&r在被击中很久后仍持续衰弱。"
		""
		"&b攻击&r他们。削弱他们。终结战斗。"
	]
	quest.04D1B2AE5F05F374.quest_subtitle: "让衰败成为你的武器"
	quest.04DD4560D9BA7C06.quest_desc: [
		"&a马拉里特长矛&r是永恒星光中的前期武器，使用&b沼泽群系中找到的&r马拉里特制作而成。"
		""
		"&a它&r是基础&b进阶&r阶段的一部分，能增加近战攻击的射程。"
	]
	quest.04DD4560D9BA7C06.quest_subtitle: "沼泽远程近战武器"
	quest.04F277210CE487DC.quest_desc: ["&aObtain&r the Meat Shredder from L_Ender’s Cataclysm. This &bpowerful&r weapon is associated with The Harbinger and has a unique ability that bypasses the normal damage-invulnerability time of enemies. It was specifically updated to ignore Damage Time, making it &bespecially&r effective &bagainst&r Cataclysm bosses."]
	quest.04F277210CE487DC.quest_subtitle: "撕裂最强大的敌人，粉碎一切阻碍"
	quest.04F277210CE487DC.title: "&c肉末机"
	quest.04F410EADCF1F37E.quest_desc: [
		"&dPaladin&r Leggings 是 Crystal Chronicles 对 Iron’s Spells ’n Spellbooks 中 Priest Leggings 的升级版。"
		""
		"They are upgraded using a Divinite Shard, &btransforming&r the original Priest Armor into the powerful Paladin Armor set. The Divinite Shard infuses the armor with the power of Holy magic, strengthening the &bwearer&r and their divine abilities."
	]
	quest.04F410EADCF1F37E.quest_subtitle: "由神圣能量加持的强化版牧师腿甲"
	quest.050EC00E93BAA558.quest_desc: ["&a击败&r L_Ender’s Cataclysm 中的 The Harbinger。直面隐藏在 Overworld 深处&b的&r这台强大古机，战胜其&b毁灭性&r的武器库。摧毁 The Harbinger，证明你已准备好挑战 Cataclysm 的&b最伟大&r的威胁。"]
	quest.050EC00E93BAA558.quest_subtitle: "从深渊中苏醒的远古生物"
	quest.050EC00E93BAA558.title: "&l&f&c先兆者 (Harbinger)</c3></c2></c1>"
	quest.051669E86A9ACBA9.quest_desc: ["&6从Create中获取&r坚固钢板。这是一种用于重要Create结构的进阶材料，&b尤其&r是火车和其他重型组件。 &b它的&r生产涉及粉末黑曜石和熔岩，然后用机械压机进行反复&b加工&r。"]
	quest.051669E86A9ACBA9.quest_subtitle: "锻造一种经久耐用的材料"
	quest.0518B57201351D29.quest_subtitle: "升级+"
	quest.0540825ACC29B90E.title: "出发吧"
	quest.05492015A5B293E7.quest_desc: ["&d赋予&r你的子弹&b穿透&r效果，使其能穿过目标，击中一排的多个敌人。"]
	quest.05492015A5B293E7.quest_subtitle: "一拳打穿一切"
	quest.055849A6CD502B56.quest_desc: ["从 L_Ender’s Cataclysm 中&a获取&r Azure Sea Shield。该盾牌使用 Lacrima 和金锭&b制作&r。除了正常的盾牌防护外，成功格挡攻击还能触发反击效果，将攻击者&b击退&r，对其施加 Slowness II，并赋予你 Strength II。"]
	quest.055849A6CD502B56.quest_subtitle: "将风暴转向你的敌人，让他们自相残杀"
	quest.055849A6CD502B56.title: "&b蔚蓝海盾"
	quest.0564322620D312AF.quest_desc: [
		"永恒锭斧是顶级的&a伐木&r和战斗工具，由比下界合金本身更坚固的材料——永恒锭锻造而成。"
		""
		"它代表了 Better End 工具进阶的&b巅峰&r。"
	]
	quest.0564322620D312AF.quest_subtitle: "最高阶的伐木工具"
	quest.056D02CAE000F853.quest_desc: ["&aThe&r Cutting Board is a useful kitchen tool from Farmer's Delight. It is &bused&r together with a knife to &bprocess&r and prepare various ingredients, allowing you to create components &bneeded&r for different recipes and meals."]
	quest.056D02CAE000F853.quest_subtitle: "用于准备新鲜食材的简易工具"
	quest.057F00BCB3EB2790.quest_desc: [
		"使用融入了暮色森林魔法的铁木锭来&a制作&r铁木斧。这把斧头结合了铁的耐用性和森林的神秘力量，是采集木材的&b绝佳&r工具，在&b危险&r来临时也是一件可靠的武器。"
		""
		"&aAs&r part of the Ironwood &bequipment&r set, it offers improved performance over conventional tools and prepares adventurers for the increasingly dangerous &bregions&r of the Twilight Forest."
	]
	quest.057F00BCB3EB2790.quest_subtitle: "一把由远古魔法强化的斧头"
	quest.05818657116C1DC5.quest_subtitle: "真美味！"
	quest.05825915587667CC.quest_desc: [
		"The Thermal Springstone Axe is a woodcutting tool &afrom&r Eternal Starlight crafted &busing&r Thermal Springstone Ingots."
		""
		"&a它&r用于地热区域的木材采集，是一种具有耐热特性的中阶&b进阶&r工具。"
	]
	quest.05825915587667CC.quest_subtitle: "地热伐木武器"
	quest.0591697AFC04B55F.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.05A39F537E50F571.quest_desc: ["&a从&rCataclysm模组中获得Tidal Claws。这些传奇的爪类武器蕴含着大海的力量，能让使用者释放出迅猛而&b毁灭性&r的攻击。它们&b从&rThe Leviathan统治的深海中被寻获，象征着海洋永不停歇的力量。"]
	quest.05A39F537E50F571.quest_subtitle: "以浪潮的愤怒发起猛攻"
	quest.05A39F537E50F571.title: "&5Tidal Claws"
	quest.05A9474567148510.quest_desc: ["&6Craft&r the Candy Cane Axe from Create: Confectionery and take on your woodcutting with a festive touch. It is &bpart&r of the Candy Cane Tools set, alongside the Candy Cane Pickaxe, Sword, Shovel, and Hoe."]
	quest.05A9474567148510.quest_subtitle: "用带糖味的斧头砍木头"
	quest.05AAA2C58CA314CA.quest_desc: [
		"Terminite 剑柄是用于在 &a锻造台&r 上组装 Terminite 剑的组件。"
		""
		"与其他 Better End 手柄一样，它与匹配的武器头部组合成最终的 &b武器&r。"
	]
	quest.05AAA2C58CA314CA.quest_subtitle: "用于终结者之刃的握柄"
	quest.05BB9E617CE2A084.quest_desc: ["&6Unlock&r the three &bessential&r connectors from Create Crafts \\& Additions: the Small Connector, Small Connector with Light and Large Connector. &bUse&r them to connect machines and electrical components with spools and transfer Forge Energy throughout your factory. The Small Connector &bsupports&r up to four connections, while the Large Connector can handle up to eight. The Small Connector with Light also &billuminates&r when powered."]
	quest.05BB9E617CE2A084.quest_subtitle: "构建你电气网络的主干道"
	quest.05CC111803C94400.quest_subtitle: "更多盔甲 (More Armor)"
	quest.05D350E2F170F039.quest_desc: ["从Create模组中获取&6黄铜锭&r。黄铜是制造&b高级&rCreate机械和物流系统的关键材料之一。将铜和锌在加热机械搅拌机中混合，用&b1个&r铜锭和1个锌锭可产出&b2个&r黄铜锭。"]
	quest.05D350E2F170F039.quest_subtitle: "锻造高级创造的金属，铸就非凡的传奇"
	quest.05DA11CCAC46AABD.quest_subtitle: "更多盔甲 (More Armor)"
	quest.05DC2F31D7534BC8.quest_desc: ["&e每台&r机器都始于正确的组件！钟表匠的&b齿轮&r是用于制造钟表匠科技的基础材料。获取一些齿轮，并用它们来&b建造&r新设备，例如&b机械&r翅膀和高级弩。是时候开始建造你自己的武器库了！"]
	quest.05DC2F31D7534BC8.quest_subtitle: "每一项发明的基石都始于此处"
	quest.05F04C35F8D6C617.quest_desc: [
		"&a探索&r暗影森林，一个能见度低、有会致盲的&b墨草&r的黑暗生物群系。"
		""
		"&b暗影行者&r与幻影一同在黑暗中潜伏于此生物群系——保持警惕，危险会毫无征兆地降临。"
	]
	quest.05F04C35F8D6C617.quest_subtitle: "在阴影注视你的地方"
	quest.05F04C35F8D6C617.title: "暗影森林"
	quest.05F5772645C09695.quest_desc: [
		"&aThe&r Thermal Springstone Helmet is a fire-resistant armor piece from Eternal Starlight crafted &busing&r Thermal Springstone Ingots."
		""
		"每件&aThermal Springstone&r盔甲都能点燃攻击的敌人并减少受到的火焰伤害，在&b危险的&r炎热环境中效果显著。"
	]
	quest.05F5772645C09695.quest_subtitle: "防火的头盔装备"
	quest.05F5D6041BCA4AAD.quest_desc: ["从Cataclysm模组中获取&a深渊祭品&r。这件&b稀有&r物品用于召唤深海古遗——利维坦。收集所需的&b材料&r，准备一场强大的水下战斗。"]
	quest.05F5D6041BCA4AAD.quest_subtitle: "用于召唤利维坦的仪式物品"
	quest.05F5D6041BCA4AAD.title: "&d深渊的献祭"
	quest.05FD09EA7882DDBB.quest_desc: ["&aThe&r Diamond Grappling Hook is the diamond version of the grappling hook. &bUse&r it to move through the &bworld&r more efficiently, overcome obstacles, and reach &bhard-to-access&r places."]
	quest.05FD09EA7882DDBB.quest_subtitle: "更进一步的移动能力"
	quest.0605E26686B45A03.quest_desc: ["&6The&r Smart Hopper is an advanced logistics block from Create: Dreams n' Desires. Use it to control and automate the &bmovement&r of items through your factory, giving you more precise control over your &bitem-processing&r systems. It was added in the 2.2a-BETA update and later &breceived&r fixes for item voiding and filter updates."]
	quest.0605E26686B45A03.quest_subtitle: "更智能的物品处理方式"
	quest.061C1577D29C847B.quest_subtitle: "更多盔甲 (More Armor)"
	quest.0627E419171E75B1.quest_desc: ["从 Create 中获得&6强力胶水&r。这个必备工具用于将方块粘合在一起，使其能作为一个整体装置移动。它可以粘合&b单个&r方块或整个区域，尤其适用于线性底盘、径向底盘和其他移动装置。强力胶水有&b99&r点耐久度，并可通过 Unbreaking 和 Mending 进行修复或增强。"]
	quest.0627E419171E75B1.quest_subtitle: "将你的创造物组合在一起"
	quest.063E2E1953B794FB.quest_desc: ["&d一种&r特殊的护身符，&b能为&r佩戴者提供强大的加成。"]
	quest.063E2E1953B794FB.quest_subtitle: "一位总督的尊贵护身符"
	quest.063F7110F10ADAD2.quest_desc: ["&d一种&r特殊的护符，&b用于&r增强佩戴者的能力。"]
	quest.063F7110F10ADAD2.quest_subtitle: "来自Legate的强大护身符"
	quest.0659AC4211264DED.quest_desc: [
		"&dPriest&r Leggings are part of the Priest Armor set in Iron's Spells 'n Spellbooks. When worn, they provide &b+6&r Armor, &b+125&r Max Mana, &b+10%&r Holy Spell Power and &b+5%&r Spell Power."
		""
		"它们可以用 7 个 Arcane Cloth 和 1 个 Holy Rune 来&b制作&r，或者在 Smithing Table 上用 1 个 Holy Rune 和 1 个 Arcane Essence 从 Wizard Leggings 升级而来。"
	]
	quest.0659AC4211264DED.quest_subtitle: "将神圣魔法的力量灌注到你的盔甲中"
	quest.066C078E77AECA39.quest_desc: [
		"&dThe&r fusion of Celestisynth and arcane knowledge &bunlocks&r a new path of progression. The Celestial Genesis is a unique spellbook available only when &bused&r alongside Iron’s Spells ‘n Spellbooks. It &benhances&r Celestial Weapon Damage, reduces &bskill&r cooldowns, and improves mana regeneration. Discover the &bbalance&r between steel and magic, and surpass the limits of an ordinary warrior."
		""
		"&bN&r - 超凡下界合金 Inogt"
		""
		"&bNW&r - SolarCrystal"
		""
		"&bW&r - 绯红碎片"
		" "
		"&bSW&r - 冬季冰晶碎片"
		""
		"&bS&r - 星迷羽毛"
		""
		"&bSE&r - 星迷废料"
		""
		"&bE&r - 眼球怪物"
		""
		"&bNE&r - 月球废料"
		""
		"&b输入&r - 残破的书籍"
	]
	quest.066C078E77AECA39.quest_subtitle: "天界魔法的开端"
	quest.066C078E77AECA39.title: "&l&c天&6文&a创&b世&9记&5&d&f"
	quest.0681FF596BE81B0D.quest_desc: ["从 Create 模组中获取&6&r工程师护目镜。这款护目镜能揭示 Create 动力系统和机械的&b&r更多信息，是理解和操作你的机械造物所&b&r必需的工具。"]
	quest.0681FF596BE81B0D.quest_subtitle: "看看机器背后的运作机制"
	quest.06AFEA2405911077.quest_desc: ["&a制作&r一个铁砧，开始组合和修理你的工具和盔甲。有了铁砧，你还可以命名物品并对它们施加附魔以获得更强的&b力量&r。"]
	quest.06AFEA2405911077.quest_subtitle: "金属大师"
	quest.06C1C8DE6D197849.quest_subtitle: "更多盔甲 (More Armor)"
	quest.06C2B5EC54BC4A73.quest_desc: [
		"&a暮光权杖&r是暮光巫妖掉落的最强大的&b魔法&r物品。它代表了他被腐化的魔法最纯粹的形式，凝聚成一件&b不稳定&r却威力惊人的武器。"
		""
		"&aUnlike&r the other scepters, this one channels raw twilight energy, allowing the wielder to &bunleash&r powerful magical &battacks&r that can overwhelm enemies quickly. However, its power is chaotic and must be &bhandled&r with care, as it draws from unstable arcane forces."
	]
	quest.06C2B5EC54BC4A73.quest_subtitle: "巫妖的真正力量已被夺回"
	quest.06D3887B7690D265.quest_subtitle: "真美味！"
	quest.06D49660A7DD972C.quest_desc: [
		"&dCultist&r Armor 是 Iron's Spells 'n Spellbooks 中 Cultist 盔甲套装的胸甲。它能提供 &b+8&r 护甲、&b+125&r 最大法力、&b+10%&r 血系法术强度和 &b+5%&r 法术强度。"
		""
		"全套包括 Cultist Hood、Cultist Armor、Cultist Leggings 和 Cultist Boots。盔甲可以用 8 个 Arcane Cloth 和 1 个 Blood Rune 来&b制作&r，或在更新版本中用 Smithing Table 和 Blood Rune 从 Wizard Robes 升级而来。"
	]
	quest.06D49660A7DD972C.quest_subtitle: "拥抱血魔法的黑暗力量吧"
	quest.06EB08C27EF2299A.quest_desc: [
		"&l&9赋予&r&r你的储物容器石匠台的功能。石匠台升级能让你直接在储物容器中处理兼容方块，将原材料加工成石板、台阶等石材制品，而无需&b另外&r准备工作台。"
		""
		"将此&b升级&r添加到你的存储中，让方块处理更便捷高效。"
	]
	quest.06EB08C27EF2299A.quest_subtitle: "将精准的石料切割带入你的储物空间"
	quest.071A27ADD8E0422C.quest_desc: ["&6A&r可穿戴电池。穿戴后可为需要&b能量&r的设备供电（Electro-Zapper、Electro-Baton、便携式钻头、便携式锯）。放置并接上电源后，充电速度取决于输入的&b电压&r。"]
	quest.071A27ADD8E0422C.quest_subtitle: "可穿戴的电池装置"
	quest.072353BCDB43A8B1.quest_desc: ["&6The&r Prismarine Alloy Rod is an advanced crafting component from Create: Aquatic Ambitions. It is &bused&r in the mod's aquatic &bprogression&r to create more advanced equipment and components. Combine the power of Prismarine with metalworking to &bprepare&r for the deeper stages of your oceanic technology."]
	quest.072353BCDB43A8B1.quest_subtitle: "锻造海洋的力量，锻造海洋的力量"
	quest.07355D601044047D.quest_desc: ["&aThe fusion&r of diamond and Netherite results in one of the strongest armors possible. This chestplate provides exceptional durability and defense, perfect for endgame &bchallenges&r."]
	quest.07355D601044047D.quest_subtitle: "终极保护"
	quest.07355D601044047D.title: "钻石下界合金胸甲"
	quest.073AA617D30A4D9E.quest_desc: ["&6Obtain&r Train Controls from Create. They are an essential component for creating and operating trains. At &bleast&r one set of Train Controls must face forward relative to the Train Station &bduring&r assembly. Once the train is assembled, &bright-clicking&r the controls lets you take &bcontrol&r of the train and drive it using the usual movement keys."]
	quest.073AA617D30A4D9E.quest_subtitle: "驾驶你的第一列火车，掌握方向盘"
	quest.073C3DFAD5006E32.quest_desc: ["&d虚空&r撕裂者是《水晶编年史》中一件武器，&b与&r强化后的虚空行者装备相关。它凝聚了深渊与深渊水晶的黑暗能量，&b使其&r成为掌控虚空之力者的强大武器。"]
	quest.073C3DFAD5006E32.quest_subtitle: "一把注入了深渊之力的毁灭性武器"
	quest.073E32C33BC19775.quest_desc: [
		"&dElectromancer&r Boots are part of the Electromancer Armor set in Iron's Spells 'n Spellbooks. When worn, they provide &b+3&r Armor, &b+125&r Max Mana, &b+10%&r Lightning Spell Power and &b+5%&r Spell Power."
		""
		"它们可以用 4 个 Arcane Cloth 和 1 个 Lightning Rune 来&b制作&r，或者用 1 个 Lightning Rune 和 1 个 Arcane Essence 从 Wizard Boots 升级而来。"
	]
	quest.073E32C33BC19775.quest_subtitle: "驾驭闪电魔法的毁灭性力量"
	quest.07429AB709FA2768.quest_desc: [
		"&dPriest&r Robes are the chestpiece of the Priest Armor set in Iron's Spells 'n Spellbooks. When worn, they provide &b+8&r Armor, &b+125&r Max Mana, &b+10%&r Holy Spell Power and &b+5%&r Spell Power. They can also be imbued with 1 spell."
		""
		"它们可以用 8 件 Arcane Cloth 和 1 件 Holy Rune 来&b制作&r，或在 Minecraft 1.20+ 的 Smithing Table 上用 1 件 Holy Rune 从 Wizard Robes 升级而来。"
	]
	quest.07429AB709FA2768.quest_subtitle: "引导神圣魔法的神圣力量"
	quest.074CA911A75DFFB6.quest_subtitle: "真美味！"
	quest.0764B71B15F7C43E.quest_desc: ["&aCraft&r the Ignis Mage Robes and Winged Mage Robes from the Cataclysm: Spellbooks addon. &bThese&r powerful mage garments are infused with the power of Ignis, combining ancient fire magic with the &bknowledge&r of spellcasters. They represent the mastery of infernal flames and the &blegacy&r of the Lord of Fire."]
	quest.0764B71B15F7C43E.quest_subtitle: "永恒火焰法师的长袍"
	quest.0765B61205952B2F.quest_desc: [
		"&d末影&r升级球是 Iron's Spells 'n Spellbooks 中的一种升级材料。在神秘砧上使用时，可提供 &b+5%&r 的末影法术强度。"
		""
		"它由 1 个空升级球和 8 个末影符文&b合成&r。末影符文是与末影魔法学派相关的符文石。"
	]
	quest.0765B61205952B2F.quest_subtitle: "用末地魔法的力量灌注你的装备"
	quest.076890D97AF1EA4A.quest_desc: [
		"&a僵尸权杖&r是一种从暮光巫妖处获得的黑暗魔法&b遗物&r。与防御性权杖不同，它能引导坏死能量，让持有者在战斗中召唤或&b控制&r僵尸仆从。"
		""
		"&aIt&r is a corrupted &bfragment&r of the Lich’s magic, infused with undead essence and unstable power. While powerful, it is unpredictable and best &bused&r in controlled situations, especially against groups of enemies or dungeon encounters."
	]
	quest.076890D97AF1EA4A.quest_subtitle: "指挥那些未死的残骸部队"
	quest.077B307FA89623CF.quest_desc: ["&6A&r high-power resistor for limiting &bcurrent&r in a circuit. Click its top to change the &bresistance&r. Current equals the &bvoltage&r across the resistor divided by its resistance (I = V / R)."]
	quest.077B307FA89623CF.quest_subtitle: "一个高功率电阻器"
	quest.078241021F81ACA5.quest_subtitle: "真美味！"
	quest.0795CBD288E28F30.quest_subtitle: "真美味！"
	quest.079D7EA37D839FEB.quest_desc: ["&aObtain&r the Soul Brazier from the Cataclysm: Spellbooks addon. This &blegendary&r magical weapon burns with &bspectral&r soul fire, allowing its wielder to channel the power of the damned into &bdevastating&r attacks. It is a relic forged from the darkest magic of Cataclysm."]
	quest.079D7EA37D839FEB.quest_subtitle: "挥舞着迷失灵魂的诅咒火焰"
	quest.079D7EA37D839FEB.title: "&b灵魂熔炉"
	quest.07A205AC0642A0E3.title: "heeee"
	quest.07B3AF57F8DAAEF9.quest_desc: [
		"&aFlowglaze 弓&r是 Eternal Starlight 模组中 Flowglaze &b进阶&r阶段的远程武器。"
		""
		"&a在&r该模组的更新版本中，制作它需要锻造模板，这是用于后期装备的&b进阶&r锻造系统的一部分。"
	]
	quest.07B3AF57F8DAAEF9.quest_subtitle: "融入了流动之力的远程武器"
	quest.07DDAF6B2DCF77D7.quest_desc: ["&aObtain&r the Bloom Stone Staff from the Cataclysm: Spellbooks addon. &bAdd&r this powerful magical weapon to your collection and continue your &bjourney&r through the secrets and relics introduced by the addon."]
	quest.07DDAF6B2DCF77D7.quest_subtitle: "引导远古石头的力量，让它为你所用"
	quest.07DDAF6B2DCF77D7.title: "&d绽放石法杖"
	quest.07EC2DA039C7F9F3.quest_desc: [
		"&a制作&r一根铁质鱼竿，并&b丢弃&r普通装备。这根加固的铁制鱼竿坚固耐用，能经受住无数次抛投和水面下潜伏的更大、更值钱的鱼类的&b挣扎&r。"
		""
		"&aAs&r your fishing &badventures&r take you across rivers, lakes, and the open ocean, dependable equipment becomes essential. The Iron Fishing Rod offers the durability needed for long expeditions and brings you one step closer to uncovering the rarest treasures &bhidden&r within the depths."
	]
	quest.07EC2DA039C7F9F3.quest_subtitle: "更坚固的鱼竿，捕获更丰富的渔获"
	quest.07F433267D08D295.quest_desc: [
		"&d暗影行者&r盔甲是 Iron's Spells 'n Spellbooks 中暗影行者盔甲套装的胸甲。穿戴后可提供 &b+8&r 护甲、&b+125&r 最大法力、&b+10%&r 末影法术强度和 &b+5%&r 法术强度。它还可以被注入 1 个法术。"
		""
		"可以用 8 块 Arcane Cloth 和 1 个 Ender Rune 来&b制作&r，也可以用 1 个 Ender Rune 和 1 个 Arcane Essence 从 Wizard Robes 升级而来。"
	]
	quest.07F433267D08D295.quest_subtitle: "引导神秘的末地魔法的力量"
	quest.07FE2CE9572AB625.title: "&l&e凋零者（The Wither）"
	quest.081B6DB73E4777B5.quest_desc: ["&6稻草&r是Create Crafts & Additions中的一个实用物品。将其应用于烈焰燃烧器，可为燃烧器提供一个&b内部&r4000 mB的流体储罐，使其能够使用易燃流体作为燃料。流体可手动供应或通过流体管道网络输送，&b从而&r无需使用固体燃料即可自动化为烈焰燃烧器加油。在当前的1.21.1版本中，该模组还包括稻草的&b替代&r配方。"]
	quest.081B6DB73E4777B5.quest_subtitle: "用流体为你的烈焰燃烧器喂食"
	quest.082128F728795E9F.quest_desc: ["&dA&r special orb &bused&r to upgrade melee &bequipment&r in Hazen N Stuff."]
	quest.082128F728795E9F.quest_subtitle: "用于近战升级的强大球体"
	quest.082B8652D0A208B8.quest_desc: ["&6更小的&r Rheostat 版本：通过与其互动来调整其数值。"]
	quest.082B8652D0A208B8.quest_subtitle: "一个小型变阻器"
	quest.082C1D5A7A144078.quest_subtitle: "升级+"
	quest.083018556858E4EF.quest_desc: ["&a获得&r来自Cataclysm模组的音乐唱片：The Leviathan。这张&b稀有&r的音乐唱片是&b专属&r奖杯，由The Leviathan掉落，承载着&b萦绕耳畔&r的深渊统治者旋律。它是你战胜海洋下潜伏的最恐怖&b生物&r之一的象征。该&b唱片&r有10%的几率从首领处掉落。"]
	quest.083018556858E4EF.quest_subtitle: "无尽深渊的歌声"
	quest.0833C7E3E65AAAE7.quest_desc: ["&6欢迎来到&r创造：烘焙工坊！&b将&r你的创造工厂变成一个美味的糖果作坊。加工可可碎、可可脂和可可粉，然后生产黑巧克力、白巧克力和红宝石巧克力、焦糖、巧克力糖果、棉花糖、姜饼、热巧克力、蜂蜜糖果等等。建造自动化的&b生产&r线，探索创造的另一面。"]
	quest.0833C7E3E65AAAE7.quest_subtitle: "建造你自己的巧克力工厂"
	quest.0833C7E3E65AAAE7.title: "&l&6欢迎来到创造烘焙工坊"
	quest.0842D3CE6A2B2281.quest_desc: ["&a获取&r Excelius 推进护胫。将这件强大的盔甲加入你的收藏，继续你的&b旅程&r，探索 Excelius 武器库的先进&b装备&r。"]
	quest.0842D3CE6A2B2281.quest_subtitle: "以势不可挡的力量移动"
	quest.0862C996C549201A.quest_desc: [
		"&e给&r追求速度的矿工们准备的点心。"
		""
		"吃完洋葱圈后，会获得加速&bII&r，持续时间&b取决于&r食物恢复的饱食度。默认情况下，每恢复一点饱食度，会获得&b6&r秒的加速 II。"
		""
		"&b填饱&r肚子。然后打破石头。"
	]
	quest.0862C996C549201A.quest_subtitle: "好好吃饭。快速挖掘"
	quest.086451087EA205F9.quest_desc: [
		"&e一&r把普通的雨伞？不完全正确。"
		""
		"这件神秘的物品能保护你免受坠落伤害，让你在空中安全漂浮。它还能当盾牌用，是任何冒险者都意想不到的&b实用&r伙伴。"
		""
		"&b打开&r它，然后一跃而下。"
	]
	quest.086451087EA205F9.quest_subtitle: "有伞了还要翅膀干什么？"
	quest.087D2C80A582AB68.quest_subtitle: "升级+"
	quest.088CA5E81F7D93BD.quest_subtitle: "真美味！"
	quest.0890D3A0F5B2174C.quest_desc: ["&6一张&r用于存储&b信号&r序列的卡片，以便在读取器中播放。"]
	quest.0890D3A0F5B2174C.quest_subtitle: "一张打孔卡"
	quest.08943C9B6BFE7A9B.quest_desc: ["&6Craft&r the Radar, an advanced utility from Create: Misc \\& Things. It uses the mod's Vibration Mechanism and provides a way to &bdetect&r activity around you, adding a useful sensing tool to your Create &bautomation&r and contraptions. The Radar was introduced as a new use for the Vibration Mechanism."]
	quest.08943C9B6BFE7A9B.quest_subtitle: "探测你周围的环境，发现其中的奥秘"
	quest.089B72C3DAA3542C.quest_desc: ["&6带上&r黄铜喷气背包及其&b终极&r升级款——下界合金喷气背包，将你的机动性提升到新高度。黄铜喷气背包能让你用燃料和水飞行，而下界合金版则更进一步，让你能游过岩浆。 &b升级&r你的喷气背包，让你的工厂&b冒险&r超越地面。"]
	quest.089B72C3DAA3542C.quest_subtitle: "从飞行到熔岩"
	quest.089B72C3DAA3542C.title: "黄铜与下界合金喷气背包"
	quest.08B2549AD67E546F.quest_desc: ["&6An&r advanced component needed for the Servo, FE Inverter, Multimeter, Portable Battery and the portable tools."]
	quest.08B2549AD67E546F.quest_subtitle: "一个先进的组件"
	quest.08C0A49E1ED441D4.quest_desc: [
		"&aCraft&r the Knightmetal Pickaxe using &brefined&r Knightmetal Ingots recovered from the Goblin Stronghold. Forged from one of the strongest alloys in the Twilight Forest, this pickaxe offers exceptional &bdurability&r and mining power, allowing you to break through even the toughest stone and uncover valuable &bresources&r hidden &bdeep&r underground."
		""
		"&a备受&r昔日守护堡垒的&b古代&r骑士青睐的 Knightmetal 镐，专为承受无数次探险而打造。对于寻求埋藏在暮色森林下的被遗忘的&b宝藏&r的冒险者而言，它是不可或缺的工具。"
	]
	quest.08C0A49E1ED441D4.quest_subtitle: "在古老的石头上凿出一条道路"
	quest.08DC50F3AF89E3E7.quest_desc: [
		"&a召唤&r并&a击败&r凋零。"
		"这个强大的首领极其危险，但击败它将奖励你一颗&b下界之星&r。"
	]
	quest.08DC50F3AF89E3E7.quest_subtitle: "击败致命的最终首领"
	quest.08DC50F3AF89E3E7.title: "&e凋零者 (The Wither)"
	quest.08E22710D284F725.quest_desc: ["&a黄金钩锁&r是钩锁的&b黄金制作版&r。使用钩锁和绳索穿越世界，抵达&b难以到达的&r地方。"]
	quest.08E22710D284F725.quest_subtitle: "更深远，更崇高"
	quest.090F03F66D7CD8D1.quest_desc: [
		"&a马拉里特镰刀&r是永恒星光模组中早期的收割工具，使用&b沼泽群系中找到的&r马拉里特制作而成。"
		""
		"&a它&r是基础进阶阶段的一部分，&b用于&r更高效地采集植物和植被。"
	]
	quest.090F03F66D7CD8D1.quest_subtitle: "沼泽地收割工具"
	quest.096861ABA052871E.title: "简单模式"
	quest.0971A95BBAA2B1CD.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.0974073AA5404B5D.quest_desc: [
		"&l&9为什么&r&r要止步于一个背包？Inception &b升级&r允许你将其他背包存放在主背包中，为你带来全新的便携存储维度。"
		""
		"&bNested&r backpacks can still use their own upgrades, while upgrades in the main backpack can interact with their contents. Just remember: backpacks inside &bother&r backpacks cannot contain another backpack."
	]
	quest.0974073AA5404B5D.quest_subtitle: "背包里的背包"
	quest.097EBBC8499E3076.quest_desc: [
		"下界堡垒中找到的烈焰人&b会掉落&r烈焰棒，这是推进进度的重要资源。"
		"它们用于酿造药水，以及制作酿造台等重要物品。"
		"&a小心&r — 烈焰人会远程用火球攻击，可能很快就能压倒&b毫无防备&r的玩家。"
	]
	quest.097EBBC8499E3076.quest_subtitle: "火焰精华"
	quest.097EBBC8499E3076.title: "&e烈焰棒"
	quest.099AC871FCA36CE5.quest_desc: ["在 Create: Confectionery 中制作&6红宝石巧克力&r，为你的巧克力收藏增添一抹亮眼的粉色。红宝石巧克力以其天然的粉色和独特的果酸风味而&b闻名&r。"]
	quest.099AC871FCA36CE5.quest_subtitle: "一款明亮而充满果香的巧克力美味"
	quest.09A3711748C8B289.quest_subtitle: "升级+"
	quest.09C6ABB4721DCED4.quest_subtitle: "更多盔甲 (More Armor)"
	quest.09F5F2584FBCAB0C.quest_desc: ["&d一种&r特殊符文，&b用于&r在 Hazen N Stuff 中制作邪灵武器和盔甲。"]
	quest.09F5F2584FBCAB0C.quest_subtitle: "注入了远古邪力的符文"
	quest.09F6C51C3AE27198.quest_desc: ["&6Obtain&r a Copper Diving Helmet from Create. &bWhen&r worn together with a Backtank containing &bpressurized&r air, it allows you to breathe underwater. It is the basic diving helmet of Create and forms the &bfoundation&r for the upgraded Netherite Diving Helmet."]
	quest.09F6C51C3AE27198.quest_subtitle: "在波涛之下自由呼吸"
	quest.09F8EFEC97F7555A.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.09F91AADEBAF3476.quest_desc: [
		"&d脆弱的&r日记本是 Iron's Spells 'n Spellbooks 的基础入门咒语书。由铜、纸和线制成，提供 5 个咒语栏位，并且&b专为&r存放普通稀有度的咒语而设计。"
		""
		"使用&b铭文台&r将卷轴中的法术刻入日志，并开始构建你的&b首个&r魔法配置。"
	]
	quest.09F91AADEBAF3476.quest_subtitle: "开启你的施法者之旅吧"
	quest.09FF0133A36649F6.quest_desc: [
		"&a获取&r一块海王星锭，这是海洋深处最珍贵金属之一的稀有&b碎片&r。大多数冒险者都遇不到这种珍贵材料，因为它只能通过钓鱼，凭借耐心、技巧和一点运气来&b获得&r。"
		""
		"&a尽管&r体积小，但每一块海王星锭都是锻造传奇海王星装备的&b一&r步。 &b收集&r足够的这些稀有碎片，大海的宝藏将属于你。"
	]
	quest.09FF0133A36649F6.quest_subtitle: "来自深海的宝藏"
	quest.09FF0133A36649F6.title: "&bNeptunium Nugget"
	quest.0A09F74C4FEC156E.quest_desc: [
		"&a花瓣镰刀&r是永恒星光中的一个&b近战&r武器，与植物材料以及该维度中中后期&b进度&r相关。"
		""
		"其确切的&a合成&r或获取方法在现有公开资料中并无明确记载，可能与模组进度系统或&bJEI&r配方相关。"
	]
	quest.0A09F74C4FEC156E.quest_subtitle: "一件来自大自然的武器"
	quest.0A09F74C4FEC156E.title: "&6花瓣镰刀"
	quest.0A121590649514A9.quest_desc: ["&6Obtain&r a Smart Fluid Pipe from Create. Unlike a regular Fluid Pipe, it can be &bconfigured&r to &ballow&r only a specific fluid to pass through it. Place a bucket or bottle &bcontaining&r the desired fluid in its filter slot to define what the pipe accepts."]
	quest.0A121590649514A9.quest_subtitle: "精准过滤流动中的杂质"
	quest.0A17802CCD07DA32.quest_subtitle: "更多盔甲 (More Armor)"
	quest.0A20F0B19B603EC3.quest_desc: [
		"&e锻造&r于炽热的核心，火焰手套将&b每次&r近战攻击都变为火焰武器。"
		""
		"被你的攻击命中的敌人会燃烧 &b8&r 秒，即使你打完之后它们仍在燃烧。"
		""
		"&b让&r你的敌人尝尝火焰的滋味。"
	]
	quest.0A20F0B19B603EC3.quest_subtitle: "将每一次攻击都转化为灼热的打击"
	quest.0A25AD3260056973.quest_desc: ["&6经验斧&r是 Create Stuff 'N Additions 模组中的一种特殊斧头。用它砍伐方块时，有&b一定概率&r会&b生成&r一个经验球，让你在收集资源的同时获得额外的经验值。它的耐久度为 270，需要铁质工具才能挖掘，攻击力为 7，攻击速度为 &b1.5&r。它由 3 堆经验和 2 个锌制工具柄&b合成&r而成。"]
	quest.0A25AD3260056973.quest_subtitle: "劈砍出一条通往体验的道路"
	quest.0A3472BE91C2FA28.quest_desc: [
		"&d冷却时间&r升级球是 Iron's Spells 'n Spellbooks 中的一种升级材料。在 Arcane Anvil 上使用时，可提供 &b+5%&r 冷却缩减。最多可应用于 3 件兼容的 &b装备&r上。"
		""
		"它由 1 个空升级球和 8 个冷却符文&b合成&r而成。"
	]
	quest.0A3472BE91C2FA28.quest_subtitle: "缩短你最强大法术之间的冷却时间"
	quest.0A3AC20EC825D19E.quest_desc: [
		"&aCraft&r a Light Hook, a mysterious fishing &bupgrade&r infused with a faint magical glow. Designed for explorers who venture into unknown waters, this unique hook represents the connection between ancient magic and the endless &bpossibilities&r of the ocean."
		""
		"&a大海&r隐藏着无数秘密，普通的工具可能不足以揭开它们。装备了 Light Hook &b后，&r你已准备好继续旅程，去探索波浪之下最稀有的 &b渔获&r和被遗忘的宝藏。"
	]
	quest.0A3AC20EC825D19E.quest_subtitle: "海浪之下，一抹魔法的气息"
	quest.0A4803FEFA2D989E.quest_desc: ["&6Obtain&r a Package Filter from Create. It is an advanced logistics &bcomponent&r introduced in Create 6.0, designed specifically for sorting Cardboard Packages. By &bconfiguring&r its filter, you can match package addresses or use Create's simplified pattern system to control where &bpackages&r are routed. It is crafted from 2 Zinc Nuggets and 1 Wool."]
	quest.0A4803FEFA2D989E.quest_subtitle: "精准地整理每一个包裹"
	quest.0A6ACBEF747EF0A3.quest_desc: ["&6PNP&r 双极型晶体管，是开关和放大电路中 NPN 的对应类型。"]
	quest.0A6ACBEF747EF0A3.quest_subtitle: "一个PNP晶体管"
	quest.0A6C124B3D87E963.quest_subtitle: "更多盔甲 (More Armor)"
	quest.0A7D3FF686D990AB.quest_desc: ["&a从&rBosses' Rise模组中获得龙骨。这种&b稀有&r材料&b采集自&r强大的地狱龙的骸骨，用以锻造强大的龙主题武器和盔甲，证明你已&b击败&r了世界上最伟大的巨兽之一"]
	quest.0A7D3FF686D990AB.quest_subtitle: "夺取远古巨龙的残骸碎片"
	quest.0A841B56D6727BC7.quest_desc: [
		"&a隐藏&r在永恒星光的地形中，原始阿玛兰伯是一种注入了星光能量的稀有珍贵材料。"
		"用于制作高级物品，并&b推进&r该维度技术和&b魔法&r的发展。"
		""
		"收集足够的这种资源，以开始&b解锁&r它的潜力。"
	]
	quest.0A841B56D6727BC7.quest_subtitle: "一种会发光的资源"
	quest.0A841B56D6727BC7.title: "原始阿玛兰伯矿石"
	quest.0A8DEABA13C07E1C.quest_desc: ["&dA&r 特殊符文，用于合成 Hazen N Stuff 中&b近战相关的&r装备。"]
	quest.0A8DEABA13C07E1C.quest_subtitle: "用于近战相关合成的符文"
	quest.0A980F79E98B30F0.quest_subtitle: "真美味！"
	quest.0AE0B1E1386816AA.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.0AF89AFB836129BB.quest_desc: ["&d你的&r子弹击中后会释放&b连锁闪电&r，传导至附近的敌人造成额外伤害。"]
	quest.0AF89AFB836129BB.quest_subtitle: "连锁闪电"
	quest.0AFA66CC198F587A.quest_desc: [
		"在末地的深处，坐落着&a堡垒&r——一座充满强大魔法敌人、陷阱和神秘&b秘密&r的巨大危险建筑。"
		"这座&a远古堡垒&r与黑暗巫师有关，里面藏有稀有的战利品，等待着足够勇敢去&b探索&r的人。"
		""
		"&a在进入前请仔细&r准备，因为堡垒戒备森严，旨在考验经验丰富的&b冒险者&r。"
	]
	quest.0AFA66CC198F587A.quest_subtitle: "一座被禁忌魔法笼罩的堡垒"
	quest.0AFA66CC198F587A.title: "&d堡垒遗迹"
	quest.0B0DFECF205BF01A.quest_subtitle: "真美味！"
	quest.0B1AB6E3CFE150FB.quest_desc: ["&6Craft&r the Lava Spout Gun and use lava as your ammunition. Fill it with &b1,000&r mB of lava &busing&r a Spout, then fire liquid projectiles at your targets. Lava deals 2 damage and sets the target on fire for &b10&r seconds. The gun has 500 durability."]
	quest.0B1AB6E3CFE150FB.quest_subtitle: "点燃你的目标，让它们熊熊燃烧"
	quest.0B2DEA16075AAA6C.quest_desc: [
		"在 Iron's Spells 'n Spellbooks 相关的&a危险&r魔法遗迹深处，一股古老的力量——Tyros 的回响，依然萦绕不散。"
		"这个实体并非完全活着的，而是被遗忘的法师留下的强大神秘能量的残余显现。"
		""
		"它会扭曲周围的现实，释放出不稳定的&b法术&r，并用混乱的&b魔法&r淹没入侵者。"
		"&a只有&r能承受强大魔法压力并对不可预测的攻击做出快速反应的人，才有机会&b击败&r它。"
	]
	quest.0B2DEA16075AAA6C.quest_subtitle: "被遗忘的远古遗迹残骸"
	quest.0B2DEA16075AAA6C.title: "&l&4泰罗斯的回声"
	quest.0B364EB72E807776.quest_desc: ["&6The&r part of the armature where you usually connect the electrical load. Together with the rotors and the clutch it forms the part of the generator where &belectricity&r is made."]
	quest.0B364EB72E807776.quest_subtitle: "收集转子的电流"
	quest.0B6F95779C8C2BFB.quest_desc: ["&a从Aquaculture 2中获取&r一个锁箱。这个稀有的钓鱼战利品容器可以在钓鱼时&b找到&r，里面装有宝贵的奖励。 &b打开&r锁箱，发现里面隐藏的物品。"]
	quest.0B6F95779C8C2BFB.quest_subtitle: "一个受保护的钓鱼宝藏"
	quest.0B7ECB6991AD3592.quest_desc: [
		"&a铁木锭&r是通过暮色森林魔法创造的独特材料。与普通金属不同，它由铁与森林的附魔&b精华&r结合锻造而成，是一种既耐用又与大自然&b紧密相连&r的资源。"
		""
		"&aIronwood&r 锭可用于制作全套盔甲、强力工具和可靠武器。它们是你在进阶路上的重要里程碑，能为你提供装备，以战胜暮色森林中日益&b危险&r的&b生物&r。"
	]
	quest.0B7ECB6991AD3592.quest_subtitle: "铁与自然在此融为一体"
	quest.0B84FCFCF17BA68C.quest_desc: ["&6经验&r碎块是 Create: Enchantment Industry 中一种浓缩的经验形式。它可以通过 Create 的 &b自动化&r工艺获取，并能转化为液态经验，因此在工厂中用于存储和 &b运输&r经验。它也被 &b用于&r需要浓缩经验的配方中。"]
	quest.0B84FCFCF17BA68C.quest_subtitle: "一点小小的知识就能派上用场"
	quest.0BCDA917265F1D7A.quest_desc: [
		"&6赋予&r你的机车蒸汽引擎的独特外观。Locometal Smokebox 提供坚固的金属前脸，非常适合&b搭配&r锅炉，为你的机车带来经典的工业外观。"
		""
		"建造你的烟箱，给你的蒸汽机车画上&b点睛&r之笔。"
	]
	quest.0BCDA917265F1D7A.quest_subtitle: "为强大的机车打造的坚固前脸。"
	quest.0BD3D868C8C5154E.quest_desc: [
		"制作一个&a烛台&r，安全放置蜡烛并装饰你的家。"
		"&b使用&r它，将蜡烛放在桌子、架子或任何你喜欢的地方。"
	]
	quest.0BD3D868C8C5154E.quest_subtitle: "用时尚的方式展示你的蜡烛"
	quest.0BD3D868C8C5154E.title: "烛台支架"
	quest.0BE8BF3B79E93EED.quest_subtitle: "更多盔甲 (More Armor)"
	quest.0BF49A67983B4591.quest_desc: [
		"&aDiscover&r the Umbrella Jungle, a dense biome overgrown with moss and towering fungal trees whose canopies spread like &bumbrellas&r."
		""
		"垂落的藤蔓、蕨类和漂浮的菌菇孢子充满了空气——在这片&b茂密&r的植被中要小心探索。"
	]
	quest.0BF49A67983B4591.quest_subtitle: "茂密的真菌丛林"
	quest.0BF49A67983B4591.title: "雨伞丛林"
	quest.0BF7E8B23E6281C4.quest_desc: [
		"&l&9别再&r&r每隔几秒就切换稿子、斧头和铲子了。工具切换升级&b会在挖掘方块或攻击实体时，&r自动&b将背包中&r最合适的工具&b&r带到你的手中。"
		""
		"高级工具交换器升级通过过滤器和更多交换选项，让你拥有更强的控制力。它还能在攻击时切换武器，并提供一个&b可配置&r的按键绑定，用于&b手动&r切换到适合你所注视的方块或实体的工具。"
	]
	quest.0BF7E8B23E6281C4.quest_subtitle: "手中永远握着合适的工具"
	quest.0BF7E8B23E6281C4.title: "工具交换器 \& 高级工具交换器升级"
	quest.0BFBD48AD0980F1C.quest_desc: [
		"&l&9再结实的背包&r&r也可能遭遇不幸。永恒升级能保护你的背包免受几乎所有&b危险&r的侵害——爆炸、火焰、熔岩和仙人掌都无法再&b摧毁&r它。即使你把它掉落，它也不会消失，扔进虚空也不会让它不见踪影。"
		""
		"&bWith&r this upgrade, your most valuable supplies will always have a way back to you."
	]
	quest.0BFBD48AD0980F1C.quest_subtitle: "确保你的背包再也不会丢失了"
	quest.0BFCBB8F6D953863.quest_subtitle: "更多盔甲 (More Armor)"
	quest.0C01EB4E1F38BEE7.quest_desc: [
		"&aWithin&r the dangerous regions of Eternal Starlight, Thermal Springstone can be refined into powerful &bingots&r infused with geothermal energy."
		"这些材料与高级合成相关，是掌握该维度稀有资源的又一步。"
		""
		"Its &bunstable&r heat makes it both valuable and &bdifficult&r to obtain."
	]
	quest.0C01EB4E1F38BEE7.quest_subtitle: "在烈焰中锻造而成"
	quest.0C01EB4E1F38BEE7.title: "&6温泉石锭"
	quest.0C048727BD25F26A.quest_desc: ["&d启用&r &b地形&r破坏，让你的子弹可以破坏方块。"]
	quest.0C048727BD25F26A.quest_subtitle: "打破墙壁，突破障碍"
	quest.0C10DD586167DBB5.quest_desc: ["&d便捷之环&r提供&b+15%&r施法速度加成，让你施法更快，战斗中反应更迅速。 &b将其&r作为戒指佩戴，提升施法响应速度。"]
	quest.0C10DD586167DBB5.quest_subtitle: "更快地施放你的法术"
	quest.0C1803C14525AE15.quest_subtitle: "更多盔甲 (More Armor)"
	quest.0C21A51D100A1AA7.quest_desc: [
		"&9&l借助升级，将&r&r你的 Refined Storage 系统发挥到极致。升级能让你&b增强&r兼容设备，提升其&b性能&r，让你的数字存储网络更高效。"
		""
		"&b使用&r升级来扩展机器的功能，并从自动化存储系统中获得更多收益。"
	]
	quest.0C21A51D100A1AA7.quest_subtitle: "提升你的存储网络的能力"
	quest.0C36F991D0F7520F.quest_desc: ["&6A&r component whose resistance depends on &bvoltage&r, used to protect circuits."]
	quest.0C36F991D0F7520F.quest_subtitle: "一个压敏电阻器"
	quest.0C4E4DC0B4CC6CEE.quest_desc: [
		"在&b灌注基座&r周围，使用幻影膜和四块水晶碎片，通过灌注仪式来&a制作&r附魔膜。"
		""
		"这是将普通鞘翅附魔为&b晶化鞘翅&r所需的關鍵材料。"
	]
	quest.0C4E4DC0B4CC6CEE.quest_subtitle: "被魔法触碰的薄膜"
	quest.0C4E4DC0B4CC6CEE.title: "&d附魔膜 (Enchanted Membrane)"
	quest.0C6618DA74D4F147.quest_desc: [
		"&a木工台&r能让你将木块变成多种装饰性方块。"
		"用它来建造精细的木制结构，提升你的建筑外观。"
	]
	quest.0C6618DA74D4F147.quest_subtitle: "将木材塑造成型"
	quest.0C712D4FF4294787.quest_desc: [
		"在困难的地方建造可能具有挑战性。"
		"天使模板能让你的建造棒在没有可附着的方块时也能放置方块。"
		""
		"这个升级非常适合在空中建造桥梁、平台和结构。"
	]
	quest.0C712D4FF4294787.quest_subtitle: "空中建造"
	quest.0C724DE572A05B76.title: "村民 67... 是啊"
	quest.0C78A1F2DD0596B1.quest_desc: ["&a获得&r一把三叉戟。这种稀有武器可由手持三叉戟的溺尸掉落。它既可以作为&b近战&r武器，也可以通过投掷作为远程武器，并且可以被&b附魔&r上&b独特的&r三叉戟附魔。"]
	quest.0C78A1F2DD0596B1.quest_subtitle: "来自海洋深处的武器"
	quest.0C78A1F2DD0596B1.title: "&d三叉戟"
	quest.0CA6C89B260ED21F.quest_desc: [
		"&dElectromancer&r Boots are the Crystal Chronicles upgraded version of the Electromancer Boots from Iron’s Spells ’n Spellbooks."
		""
		"使用伏特碎片&b升级&r，为原本的电磁魔盔甲套装增强了额外的晶体力量。伏特碎片引导了闪电魔法的力量，创造了更强大的&b原版&r电磁魔装备。"
	]
	quest.0CA6C89B260ED21F.quest_subtitle: "由伏特矿石强化的电磁法师靴的增强版"
	quest.0CC11B3703C971A2.quest_subtitle: "更多盔甲 (More Armor)"
	quest.0CD9609E318F9042.quest_subtitle: "更多盔甲 (More Armor)"
	quest.0CEAEC791D4CD1F1.quest_desc: ["&6从Create模组中获取&r脉冲延长器。它能将红石脉冲延长一段&b可配置&r的时间，使短暂信号保持激活，从而控制机器和其他自动化系统。其持续时间可从&b2&r刻调整至最长&b60&r分钟，也可反向设置，使其默认保持供电，并产生临时关闭脉冲。"]
	quest.0CEAEC791D4CD1F1.quest_subtitle: "保持信号持续有效"
	quest.0CF3683B8C127405.quest_subtitle: "更多盔甲 (More Armor)"
	quest.0CFA16A0F5807E23.quest_desc: [
		"&a获得&r守护者手套，击败末地守护者后掉落。"
		""
		"它既是具有吸引实体能力的&a武器&r，也是护甲部件，并可进一步升级为Gauntlet of Bulwark。"
	]
	quest.0CFA16A0F5807E23.quest_subtitle: "城堡首领的奖杯"
	quest.0CFA16A0F5807E23.title: "&d守护者手套"
	quest.0D0199257A097C8D.quest_desc: [
		"&a星辉&r锤是永恒星光中后期的一种重型武器，属于星辉&b装备&r系列。"
		""
		"&a它&r专为高伤害的近战攻击而设计，属于模组中&b引入&r的高级武器套装。"
	]
	quest.0D0199257A097C8D.quest_subtitle: "星光重型武器"
	quest.0D01CBDB09778B1C.quest_desc: [
		"&a在暮色森林的高处，&r高耸的&b巨大&r黑暗塔顶，栖息着该维度最可怕的统治者之一——远古恶魂。这个巨大的漂浮&b恐怖之物&r已将塔楼扭曲成自己的堡垒，用&b致命&r的机器、陷阱和忠诚的仆从填满了大厅。"
		""
		"&a与&r以往&b任何&r敌人不同，远古灾厄很少会停留在近处。它在竞技场高空盘旋，用爆炸火球轰炸入侵者，同时发出&b震耳欲聋&r的咆哮回荡天际。胜利需要耐心、策略和精准的时机，你必须&b先&r将巨兽引诱至攻击范围内才能出击。"
		""
		"&a击败&r远古恶魂，证明你已&b掌握&r了黑暗塔的危险与暮色森林的挑战。它的&b战败&r是征服魔法世界又一大步。"
	]
	quest.0D01CBDB09778B1C.quest_subtitle: "让云层之上的尖叫归于沉寂"
	quest.0D01CBDB09778B1C.title: "&c厄加斯特"
	quest.0D0498EE73C343D9.quest_desc: ["&6The&r Heat Engine is one of the engines added by Create Stuff 'N Additions. It uses fuel to &bgenerate&r Heat Energy, which can be used to power compatible equipment from the mod. It is the main power source for &bequipment&r that relies on heat energy, making it an important step toward more &badvanced&r gear."]
	quest.0D0498EE73C343D9.quest_subtitle: "将燃料转化为动力"
	quest.0D1378C905A60B53.quest_desc: [
		"使用遍布暮色森林的魔法钢叶材料，&a制作&r一把钢叶斧。这把斧头蕴含着森林的古老魔法，既是可靠的伐木工具，也是对抗敌对生物的得力&b武器&r。"
		""
		"&aAs&r part of the Steeleaf equipment set, it provides a significant upgrade over ordinary tools and will aid you throughout your &bexploration&r of the Twilight Forest."
	]
	quest.0D1378C905A60B53.quest_subtitle: "被附魔的伐木工人"
	quest.0D1CF27B3864527D.quest_subtitle: "更多盔甲 (More Armor)"
	quest.0D203235B9A36E3F.quest_desc: [
		"&9&l为&r&r你的 Refined Storage 网络提供一个存放&b&r数字存储磁盘的地方。磁盘驱动器可容纳存储磁盘，并使其内容&b&r可供网络的其他部分使用。"
		""
		"将其连接到你的系统，并开始构建一个能容纳海量资源的&b集中式&r数字存储网络。"
	]
	quest.0D203235B9A36E3F.quest_subtitle: "将你的数字资源存储在存储磁盘上"
	quest.0D30AC3FA07898B9.quest_desc: [
		"&dCryomancer&r Coat 是 Iron's Spells 'n Spellbooks 中 Cryomancer Armor 套装的胸甲。穿戴后可提供 &b+8&r 护甲、&b+125&r 最大法力、&b+10%&r 冰系法术强度和 &b+5%&r 法术强度。它还可以附魔 1 个法术。"
		""
		"&bUpgrade&r Wizard Robes using 1 Ice Rune and 1 Arcane Essence to obtain Cryomancer Coat."
	]
	quest.0D30AC3FA07898B9.quest_subtitle: "引导冰魔法的冻结之力"
	quest.0D566870D0BB04ED.quest_desc: [
		"&l&9让&r&r背包替你解决饥饿。喂食升级功能会在你饥饿时，自动使用背包内的食物来为你提供补给。你可以配置过滤器来&b决定&r允许或禁止哪些食物。"
		""
		"高级进食升级让你能更精细地控制进食时机。它能更高效地优先选择食物以避免浪费&b饥饿&r值，并提供额外条件，包括受到伤害时&b进食&r。"
	]
	quest.0D566870D0BB04ED.quest_subtitle: "再也不用担心饥饿的问题了"
	quest.0D566870D0BB04ED.title: "喂食与高级喂食升级 (Feeding & Advanced Feeding Upgrade)"
	quest.0D5FCCF588C6D9C1.quest_subtitle: "更多盔甲 (More Armor)"
	quest.0D64A726F990C937.quest_desc: [
		"&a制作&r一把铁制鱼刀，将你的钓鱼&b装备&r提升到新高度。这把由坚固铁块锻造而成的可靠工具，具有出色的耐用性和精准度，非常适合处理来自河流、湖泊和公海的优质&b渔获&r。"
		""
		"&a当&r冒险引领你走向更稀有的鱼和&b传奇&r宝藏，可靠的装备便至关重要。铁制鱼刀能确保每份渔获都高效处理，助你&b充&r分利用在水上的时间。"
	]
	quest.0D64A726F990C937.quest_subtitle: "专为经验丰富的垂钓者打造"
	quest.0D89506DC26400A0.quest_desc: ["&6便携式钻头&r是 Create Stuff 'N Additions 模组中一种燃料驱动的多功能工具。它具有钻石级&b挖掘&r能力，挖掘速度比铁镐更快，同时也能当作斧头和铲子使用。与普通工具不同，它没有耐久度，而是需要燃料和水来运作。通过&b合适的&r附魔，它可以在一个&b3×3&r的区域挖掘特定的石块。"]
	quest.0D89506DC26400A0.quest_subtitle: "一款可以随身携带的钻头"
	quest.0DAB4700648EB3ED.quest_desc: ["&6Add&r the Redstone Detector Tube Attachment to your Hypertube system and expand its redstone capabilities. &bUse&r it to detect activity within the tube network and connect your &btransportation&r system to automated redstone mechanisms."]
	quest.0DAB4700648EB3ED.quest_subtitle: "检测通过的东西是什么"
	quest.0DB8E810F8D979F6.quest_desc: [
		"&6欢迎来到&r Create: Power Grid，一个为 Create 带来真实&b电力&r的模组。连接设备，通过旋转或阳光发电，并了解&b电压&r、电流和电阻如何协同工作。"
		""
		"&6跟随&r任务，从这里向外探索，学习布线、发电机、太阳能&b发电&r、电子学和便携工具。"
	]
	quest.0DB8E810F8D979F6.quest_subtitle: "用电力为你的世界注入能量"
	quest.0DB8E810F8D979F6.title: "&l&6欢迎使用创造能源网络"
	quest.0DCAEC79BEDE8BE6.quest_desc: [
		"永恒靴子是在锻造台用&a永恒&r锻造板升级终末靴子制作的。"
		""
		"它们构成了完整的&bAeternium&r盔甲套装，是Better End中最坚固的防护装备。"
	]
	quest.0DCAEC79BEDE8BE6.quest_subtitle: "最高阶的靴子，坚不可摧"
	quest.0DD0CBBAE885F488.quest_desc: ["使用Aquaculture 2制作&aNeptunium斧&r。这件&b强大的&r工具由Neptunium制成，这是一种通过钓鱼宝藏获得的稀有材料。它具有高耐久度和效率，是你&b高级工具&r收藏中&b宝贵的&r补充。"]
	quest.0DD0CBBAE885F488.quest_subtitle: "来自海洋宝藏的强大工具"
	quest.0DEB3110F27083E6.quest_desc: [
		"&e沙漠&r一望无际地延伸着。继续奔跑，注意&b四周&r，避开挡路的仙人掌。"
		""
		"你能走多远呢？"
	]
	quest.0DEB3110F27083E6.quest_subtitle: "不被发现地穿越沙漠。"
	quest.0E147AC3400C4889.quest_desc: [
		"欢迎来到你的&2新&r&a世界&r！"
		"这是冒险的第一步&b&r——探索周围，收集基础资源，为前方的挑战做好准备。每段旅程始于一步&b&r，你的&a世界&r正等待着你去发现！"
	]
	quest.0E147AC3400C4889.quest_subtitle: "冒险的第一步踏出奇幻世界"
	quest.0E147AC3400C4889.title: "&l&2新建&a世界"
	quest.0E42F9CE105A4450.quest_desc: ["&e是时候&r释放纯粹的混乱了！火焰喷射器能让你点燃眼前的一切。要&b使用&r它，必须用烈焰粉装填，&b可提供&r长达60秒的续航。快&b储备&r燃料，向敌人展示机械之火的力量！"]
	quest.0E42F9CE105A4450.quest_subtitle: "让战场燃烧起来吧！"
	quest.0E571930C417347F.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.0E5E4DC1A6A19DBF.quest_subtitle: "真美味！"
	quest.0E69A4626C5865CC.quest_desc: ["&6The&r Copper Helmet is part of the Copper Suit added by Create Stuff 'N Additions. It provides the same armor value as an Iron Helmet, while offering &b1&r point of armor toughness and higher &bdurability&r than iron armor. The full Copper Suit can be repaired with Honeycombs in an Anvil, making copper a practical alternative to &bearly-game&r iron armor."]
	quest.0E69A4626C5865CC.quest_subtitle: "简易防护，由 Create 模组打造"
	quest.0E6F6D09770E2D70.title: "地狱不存在的，别想了"
	quest.0E7ECBAB667CFD86.quest_desc: ["&6为&r在盆中处理的物品提供&b热量&r。有足够的&b能量&r，即可达到最高热量等级。"]
	quest.0E7ECBAB667CFD86.quest_subtitle: "为你的盆提供热量"
	quest.0E7F4A989DB6342D.quest_desc: ["&e一款&r 让你用游戏机玩Pong的游戏光盘。控制你的球拍上下移动，不要让球越过你。考验你的&b反应速度&r，努力击回每一球，战胜你的&b对手&r。"]
	quest.0E7F4A989DB6342D.quest_subtitle: "让球保持运动，击败你的对手！"
	quest.0E855DABB1FCD46B.quest_desc: [
		"制作一个 &aLightroom&r 来 &b编辑&r 你的已冲洗胶卷。"
		"用它，你可以在投射图像前调整亮度、对比度和颜色。"
	]
	quest.0E855DABB1FCD46B.quest_subtitle: "编辑你的照片"
	quest.0E87AC6E1318D654.quest_subtitle: "更多盔甲 (More Armor)"
	quest.0E8BB3913CB90410.quest_desc: ["&aObtain&r the Cursium Upgrade Smithing Template from the Cataclysm mod. This smithing template is &bused&r in a Smithing Table to upgrade Netherite &bequipment&r into Cursium equipment using Cursium Ingots"]
	quest.0E8BB3913CB90410.quest_subtitle: "升级 Cursium 的力量"
	quest.0E92544484BC20B8.quest_desc: ["&dPoltergeist&r 是一把装有大量末影之眼的大型重型斧头。它专为造成巨额爆发伤害而设计。其主要材料为末影之眼，可通过合成&b获取&r。"]
	quest.0E92544484BC20B8.quest_subtitle: "光谱之力"
	quest.0E92544484BC20B8.title: "&l&aPoltergeist"
	quest.0EB8304741CB03C7.quest_subtitle: "更多盔甲 (More Armor)"
	quest.0EC0971CBAF5ACAA.quest_desc: [
		"&aDeep&r within Eternal Starlight, a twisted &bstructure&r known as the Cursed Garden hides the Lunar Monstrosity."
		"&a这片&r迷宫般的区域被奇怪的&b植被&r覆盖，充满了危险。"
		""
		"要找到它，请手持与该维度相关的自然物品，并使用“Seeking Eye”。"
		"&b只有&r这样，眼睛才会指引你到&b正确&r的位置。"
	]
	quest.0EC0971CBAF5ACAA.quest_subtitle: "巨兽等待的地方"
	quest.0EC0971CBAF5ACAA.title: "被诅咒的花园"
	quest.0ED1749C1B5B7583.quest_subtitle: "更多盔甲 (More Armor)"
	quest.0EEE68FD056D8EA2.quest_desc: [
		"&dNature&r符文是Iron's Spells 'n Spellbooks中的一个合成材料，用于高级的&b自然相关&r合成，包括自然升级球。自然学派&b使用&r毒马铃薯作为其魔法焦点。"
		""
		"将空白符文石和8个毒马铃薯结合，&b创造&r自然符文。"
	]
	quest.0EEE68FD056D8EA2.quest_subtitle: "用自然魔法的狂野力量灌注一块符文石"
	quest.0EF28169B581CC6E.quest_desc: ["&d虚空之&r握是《水晶编年史》中一件武器，与强化后的虚空行者装备&b相关&r。它凝聚了深渊与黑暗晶能的&b力量&r，是掌握虚空与暗影魔法者的强大&b武器&r。"]
	quest.0EF28169B581CC6E.quest_subtitle: "一把能驾驭深渊碾压之力的黑暗武器"
	quest.0EFC932492253DA8.quest_subtitle: "更多盔甲 (More Armor)"
	quest.0F0122BB93E8B07B.quest_desc: ["&a击败&r L_Ender’s Cataclysm 中的 10 个 The Watchers。追踪并消灭这些&b神秘&r的生物，证明你足够&b强大&r，能够直面 Cataclysm 中潜藏的危险。"]
	quest.0F0122BB93E8B07B.quest_subtitle: "狩猎神秘的观察者（Watchers）"
	quest.0F0122BB93E8B07B.title: "观察者"
	quest.0F07C5A8E6D0432A.quest_desc: [
		"&l&9你的&r&r背包很适合携带战利品，但最终你&b需要&r清空它。存款升级模块会在你互动时，将背包中筛选过的物品自动转移到附近的容器（如箱子或桶）中。它&b提供&r9个筛选栏位。"
		""
		"高级存款&b升级&r将系统扩展为16个过滤槽，并能按物品、模组、标签、NBT数据和耐久度进行更精确的过滤。它还可以被配置为只存款那些在目标物品栏中&b已经&r存在的物品。"
	]
	quest.0F07C5A8E6D0432A.quest_subtitle: "只需一次交互即可清空背包中的所有物品"
	quest.0F07C5A8E6D0432A.title: "存款与高级存款升级模块"
	quest.0F18BA8D8EBDDCB1.quest_desc: [
		"基座&b被&r用来在您的世界中展示物品和装饰。"
		"将你最喜爱的物品放在基座上，向所有人展示吧。"
	]
	quest.0F18BA8D8EBDDCB1.quest_subtitle: "展示你的宝藏"
	quest.0F2A2810EA1946B1.quest_desc: ["&a从Cataclysm模组中获取&r燃烧灰烬。这件远古遗物是&b唤醒&r燃烧竞技场中Ignis的必需之物。没有这些余烬，火焰之主将&b继续&r沉睡于他的王座上。"]
	quest.0F2A2810EA1946B1.quest_subtitle: "唤醒火焰之主的余烬火花"
	quest.0F64E81EA2372255.quest_desc: [
		"&d瘟疫&r护腿是 Iron's Spells 'n Spellbooks 中瘟疫盔甲套装的一部分。穿戴后可提供 &b+6&r 护甲、&b+125&r 最大法力、&b+10%&r 自然法术强度和 &b+5%&r 法术强度。"
		""
		"它们是通过用 1 个自然符文和 1 个奥术精华升级巫师腿甲来&b制作&r的。"
	]
	quest.0F64E81EA2372255.quest_subtitle: "驾驭自然魔法的狂野与剧毒之力"
	quest.0F711B661EAE6F4F.quest_subtitle: "真美味！"
	quest.0F73032F23C2CC85.quest_subtitle: "真美味！"
	quest.0F7D9F42F177D44F.quest_desc: ["&6The&r Conduit is the core of Create: Aquatic Ambitions' aquatic automation system. When activated, it acts as a &bcatalyst&r for Conduit Channeling, allowing Create's fans to process materials through special aquatic recipes. It can transform byproducts into useful resources and is the &bkey&r to automating materials such as Prismarine, Coral and Copper."]
	quest.0F7D9F42F177D44F.quest_subtitle: "驾驭海洋的力量，让它为你所用"
	quest.0F8686CA54D25658.quest_desc: [
		"&d稻草人&r靴子是 Iron's Spells 'n Spellbooks 中稻草人盔甲套装的一部分。 &b它们&r提供 &b+3&r护甲和 &b+75&r最大法力值。"
		""
		"Craft them &bfrom&r Hay Bales and complete your Scarecrow Armor set."
	]
	quest.0F8686CA54D25658.quest_subtitle: "与稻草人的奇妙魔法一同前行"
	quest.0F889054E352287C.quest_desc: [
		"&dWizard&r靴是Iron's Spells 'n Spellbooks中基础Wizard盔甲套装的&b一部&r分。装备后可提供&b+3&r护甲、&b+125&r最大法力值和&b+5%&r法术强度。"
		""
		"完成巫师套装，并用&b额外&r的法力和法术强度来增强你的魔法能力。"
	]
	quest.0F889054E352287C.quest_subtitle: "踏上神秘力量的道路"
	quest.0FA493E56395172B.quest_subtitle: "真美味！"
	quest.0FB04687C0F5D8B1.quest_desc: ["从 L_Ender’s Cataclysm 中获取&a风暴精华&r。这种&b稀有&r材料由 Scylla 掉落，每次击败可获得 3-4 个风暴精华。用于&b制作&r强大的 Acropolis 武器，包括 &bAstrape&r 和 Ceraunus。"]
	quest.0FB04687C0F5D8B1.quest_subtitle: "风暴女皇力量的一小部分碎片"
	quest.0FE1F9E9F024ECCD.quest_subtitle: "更多盔甲 (More Armor)"
	quest.0FE76D3D0161BDBB.quest_subtitle: "更多盔甲 (More Armor)"
	quest.0FF0C8FC476D8039.quest_desc: ["&a击败&r 10 溺尸。这些水下&b不死生物&r会生成在海洋和河流中。如果它们手持三叉戟，可能会掉落腐肉、铜锭、鹦鹉螺壳和&b三叉戟&r等实用物品。"]
	quest.0FF0C8FC476D8039.quest_subtitle: "击败海洋中的不死生物"
	quest.0FF0C8FC476D8039.title: "击杀溺尸"
	quest.0FF66DA3887636F5.quest_desc: ["&6Craft&r the Inventory Bridge and Inventory Access Port to improve item &blogistics&r in your factory. The Inventory Access Port expands the &baccessible&r sides of an inventory, while the Inventory Bridge connects two inventories so they can be accessed simultaneously. Both are &bpart&r of Create: Connected."]
	quest.0FF66DA3887636F5.quest_subtitle: "随时随地访问你的物品栏"
	quest.0FF66DA3887636F5.title: "物品栏桥梁 \& 物品栏访问端口"
	quest.1003FBB884B33A10.quest_subtitle: "真美味！"
	quest.1009DDB3C044CEC1.quest_desc: [
		"&6没有&r合适的锅炉，蒸汽机车就不算完整。Locometal 锅炉将 Locometal 的粗犷外观与经典蒸汽机车锅炉的&b独特&r外形相结合。"
		""
		"把它装到你的机车里，&b赋予&r火车应有的工业之心。"
	]
	quest.1009DDB3C044CEC1.quest_subtitle: "蒸汽火车头的核心部件。"
	quest.101BDDA3CD5CF3FE.quest_desc: ["&d一种&r常见的合成材料，&b用于&rHazen N Stuff 中许多工具、武器和其他&b装备&r的配方。"]
	quest.101BDDA3CD5CF3FE.quest_subtitle: "用于制作和装备的可靠材料"
	quest.10399D121FFAF706.quest_desc: ["从Cataclysm模组中&a获取&r假瓦杰特之杖。这件神秘物品酷似沙漠守护蛇瓦杰特的武器。尽管并非&b真正&r的法杖，但它仍蕴含着&b远古沙漠力量的&r残余。"]
	quest.10399D121FFAF706.quest_subtitle: "沙漠巨蛇的虚假遗物"
	quest.10399D121FFAF706.title: "&e虚假的瓦杰特之杖"
	quest.105089B860220491.quest_desc: ["&dHermomancer&r胸甲是《水晶编年史》中Hermomancer盔甲套装的胸甲，该套装是《铁之魔法与魔典》的&b附加包&r。"]
	quest.105089B860220491.quest_subtitle: "驾驭赫罗曼瑟的力量，掌控一切"
	quest.1075D7EB9D53E900.quest_subtitle: "真美味！"
	quest.1076777CFF885694.quest_desc: ["&6Craft&r the 6-Way Gearbox and Vertical 6-Way Gearbox to create versatile kinetic connections in your factory. These gearboxes &bprovide&r multiple shaft connections, making it easier to distribute &brotational&r power through compact and complex &bmechanical&r setups. The Vertical 6-Way Gearbox has six shaft-facing sides, with the top and bottom rotating at half speed."]
	quest.1076777CFF885694.quest_subtitle: "从每个方向连接旋转部分"
	quest.1076777CFF885694.title: "六向齿轮箱 (6-Way Gearboxes)"
	quest.107FA2DB980BC9A8.quest_desc: [
		"&aAfter&r locating the &bhidden&r structure in Eternal Starlight, you must face its guardian — the Starlight Golem."
		"这个强大的构造体以其卓越的强度和耐久度守护着自己的领地。"
		""
		"&aDefeating&r it proves that you are ready to handle &aelite&r threats within the dimension."
	]
	quest.107FA2DB980BC9A8.quest_subtitle: "摧毁这个构造体"
	quest.107FA2DB980BC9A8.title: "&l&b星光 &f哥布林"
	quest.1086E751618DA8C1.quest_desc: ["&a获得 5 个&r棱镜晶。这些物品由&b守卫和远古守卫&r掉落，并&b用于&r制作海灯和其他装饰方块。"]
	quest.1086E751618DA8C1.quest_subtitle: "来自海洋纪念碑的宝藏"
	quest.1086E751618DA8C1.title: "海晶碎片 (Prismarine Crystals)"
	quest.1087CF0DF2FE716F.quest_desc: ["&6Give&r your railway builds a distinct industrial finish with Flat Slashed Locometal. &bIts&r flat shape and slashed metal pattern &bmake&r it perfect for locomotive bodies, train cars and detailed railway structures."]
	quest.1087CF0DF2FE716F.quest_subtitle: "干净、工业化的表面，带有粗犷的边缘。"
	quest.1089F103361EC854.quest_desc: ["锻造一套完整的&a铁质防&r具，保护自己免受前方危险的侵害。装备头盔、胸甲、护腿和靴子，以战胜更强大的敌人并&b自信地&r探索。"]
	quest.1089F103361EC854.quest_subtitle: "为战斗做好准备，穿戴好装备"
	quest.1089F103361EC854.title: "铁质盔甲"
	quest.108C534782668B81.quest_desc: ["&a击败&r来自Cataclysm模组的Wadjet。这条强大的蛇形迷你Boss栖息在Cursed Pyramid中，用&b毁灭性&r的沙之魔法守护着古老的宝藏。击败Wadjet会奖励你&bAncient&r Metal Ingots，这是制作古代装备的必需材料。"]
	quest.108C534782668B81.quest_subtitle: "击杀沙漠的守护者——巨蛇"
	quest.108C534782668B81.title: "&6瓦德&e杰特"
	quest.108CBE345FE0233C.quest_desc: ["&6The&r Hydraulic Engine is an engine from Create Stuff 'N Additions that uses water as its energy source. It is part of the mod's hydraulic technology and is &bused&r to power advanced Copper equipment, including &bhydraulic-powered&r gear. The engine is &bcrafted&r through Create's &bmechanical&r assembly process, using a Copper Sheet, Cogwheels, Large Cogwheels, Andesite Alloy and Water."]
	quest.108CBE345FE0233C.quest_subtitle: "驾驭水的力量，让它为你所用"
	quest.10D4A4A58AAAA36A.quest_desc: ["&6Converts&r redstone signals into &bresistance&r changes (like a potentiometer). Attached to a block it acts like a Redstone Comparator, and for some blocks it gives more precision."]
	quest.10D4A4A58AAAA36A.quest_subtitle: "红石转化为抗性"
	quest.10DB2DCC3B25FCCC.quest_desc: ["&a前往&r下界竞技场，这是一个位于 Bosses'Rise 维度&b深处&r的危险 boss 副本。 &a该&r竞技场是一个封闭的战斗区，强大的下界 boss 正等待着&b挑战者&r。"]
	quest.10DB2DCC3B25FCCC.quest_subtitle: "进入BOSS竞技场权限"
	quest.10DB2DCC3B25FCCC.title: "&3地下世界&f竞技场"
	quest.10DDBC906AAD23D7.quest_desc: [
		"&a探索&r乌姆布拉谷，一个由&b乌姆布拉石&r构成的昏暗朦胧生物群系，位于末地外围岛屿之间。"
		""
		"其灰暗、幽暗的地形与 Better End 的明亮群系截然不同——因其&b独特&r的资源而值得一探。"
	]
	quest.10DDBC906AAD23D7.quest_subtitle: "被阴影笼罩的山谷"
	quest.10DDBC906AAD23D7.title: "乌姆布拉山谷"
	quest.10E5A66E748CD6A2.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.10F061C6C982A43A.quest_desc: ["从Cataclysm模组中&a获取&r沙漠项链。这件&b远古&r的宝物位于被诅咒的金字塔中，是唤醒沙漠深处&b隐藏&r的强大守护者——远古遗骸所必需的。带上这件遗物，准备与&b一股&r&b远古&r势力展开战斗。"]
	quest.10F061C6C982A43A.quest_subtitle: "唤醒远古力量的关键所在"
	quest.10F061C6C982A43A.title: "&d沙漠项链 (Necklace Of The Desert)"
	quest.10F509A7074A38C3.quest_desc: ["&a击败&r一个雪傀儡。雪傀儡通常是友善的生物，可以通过将&b雕刻南瓜&r放在两个雪块上制作。它们会留下&b雪迹&r并向敌对生物投掷雪球。"]
	quest.10F509A7074A38C3.quest_subtitle: "雪地里艰难的决定"
	quest.10F509A7074A38C3.title: "杀死雪傀儡 :("
	quest.10FBE8E0885F168D.quest_desc: [
		"建造一个&a下界传送门&r并进入下界。"
		"这个危险的维度充满了宝贵的资源，但也有致命的&b生物&r。"
	]
	quest.10FBE8E0885F168D.quest_subtitle: "进入危险的维度中"
	quest.10FBE8E0885F168D.title: "&5进入下界"
	quest.11261ECC91B8E046.quest_subtitle: "真美味！"
	quest.1129D9E0F8CEA9FC.quest_desc: [
		"&dArcane&r Cloth is an important crafting material in Iron's Spells 'n Spellbooks. It is &bcreated&r by condensing Arcane Essence and is used to craft &bpowerful&r magical equipment, including spellcaster armor."
		""
		"Arcane Cloth 在&b中后期&r的进程中尤为重要，那时你开始制作更强的护甲和&b扩展&r你的魔法武器库。"
	]
	quest.1129D9E0F8CEA9FC.quest_subtitle: "将原始魔法精华编织成附魔织物"
	quest.113B9F1863072735.quest_desc: [
		"通过制作石制鱼刀来&a升级&r你的钓鱼&b装备&r。这种改进的工具比木制工具更强、更耐用，能让你更轻松地处理渔获，从而提取到&b宝贵&r的资源。"
		""
		"&aEvery&r skilled angler &bknows&r that quality tools make all the difference. The Stone Fillet Knife is the next step toward mastering the art of fishing and making the most of the treasures hidden &bbeneath&r the water's surface."
	]
	quest.113B9F1863072735.quest_subtitle: "更锋利的刀刃，带来更干净的切割"
	quest.114820C8ED37783F.quest_desc: [
		"&9&lTake&r&r your Sophisticated Storage &bcontainer&r from the Iron Tier to the Gold Tier. This upgrade expands the capabilities of your storage and brings you closer to the highest &blevels&r of storage available."
		""
		"强化你的存储系统，&b为更强大的容量和升级&r做好准备。"
	]
	quest.114820C8ED37783F.quest_subtitle: "给你的储物箱来个黄金升级"
	quest.11A869A54AF60695.quest_desc: ["&6烈焰升级锻造模板&r用于将烈焰燃烧器升级为高级的&b烈焰驱动的&r机器，如烈焰附魔机和烈焰锻造机。它与 Create: Enchantment Industry 相关，可在下界&b堡垒&r和堡垒遗迹中作为战利品找到。"]
	quest.11A869A54AF60695.quest_subtitle: "升级烈焰人燃烧器"
	quest.11B8CE94B9C038C0.quest_desc: ["&d专注&r护符能让&b施法时间长的&r法术无法被打断。将其佩戴在颈部，即使在受到伤害或遭遇其他打断时，也能在长时间施法过程中保持&b施法&r。"]
	quest.11B8CE94B9C038C0.quest_subtitle: "无需分心即可施放强力法术"
	quest.11D19C10264300EC.quest_desc: ["&6The&r Block of Experience is a compact form of Liquid Experience from Create: Enchantment Industry. It can be &bused&r as a concentrated source of experience in advanced enchanting processes and is also involved in the mod's Super &bEnchanting&r progression. In newer versions, &blightning&r can transform Experience Blocks as part of this progression."]
	quest.11D19C10264300EC.quest_subtitle: "凝聚你的知识，将其浓缩"
	quest.11D562DD0F0F4BFB.quest_desc: ["&6从Create模组中获取&r机械臂。这是一种先进的&b物品传输&r组件，可在其工作范围内将物品从一个物品栏、传送带、漏斗、水槽或其他兼容方块传输到另一个。 &b它的&r行为可通过Round Robin、Forced Round Robin或Prefer First模式进行配置，非常适合用于&b自动化&r分拣和生产线。"]
	quest.11D562DD0F0F4BFB.quest_subtitle: "自动化你的工厂的双手，让它们自动工作"
	quest.11E1446BE612A8A0.quest_desc: [
		"&9&l每个&r&r Refined Storage 网络 &b都&r需要可靠的电源和控制。控制器是存储网络的核心组件，为连接的设备提供运行所需的能量。"
		""
		"将你的存储&b组件&r连接到控制器，构建强大数字存储系统的基础。"
	]
	quest.11E1446BE612A8A0.quest_subtitle: "你数字存储网络的核心所在"
	quest.11E4AC4D88C9D606.quest_subtitle: "真美味！"
	quest.11F11DE2C2DFCD62.quest_desc: ["从&aSupplementaries&r中获得一把扳手。这个工具对于旋转和配置许多科技&bmods&r中的机器或方块至关重要。"]
	quest.11F11DE2C2DFCD62.quest_subtitle: "用于机器的工具包"
	quest.11F11DE2C2DFCD62.title: "获取你的扳手"
	quest.12113DC3AD237125.quest_desc: ["&6制作&r Create Crafts & Additions 中使用的三种基础金属棒：铜棒、铁棒和金棒。这些&b金属棒&r通过轧机生产，是该模组电气部件（包括电线、线轴和连接器）的重要制作&b组件&r。一个金属锭可生产&b2&r根金属棒。"]
	quest.12113DC3AD237125.quest_subtitle: "为电气工程塑造金属的形状"
	quest.122606911457B4EC.quest_desc: [
		"fawfafeaf"
		"{image:relics:textures/abilities/blazing_flask/bonfire.png width:100 height:100 align:center} aff aa f"
		"{@pagebreak}"
		"（新页面占位符文本）"
	]
	quest.122606911457B4EC.quest_subtitle: "你好，欢迎来到我的世界整合包任务书！"
	quest.122606911457B4EC.title: "你好，欢迎来到我的世界整合包任务书！"
	quest.122964ACEB2F091B.quest_desc: [
		"&aFlowglaze Hoe&r 是 Eternal Starlight 的一种农具，属于 Flowglaze &b装备&r 系列。"
		""
		"&aIt&r is &bused&r for farmland creation and is part of the mid-to-late game Flowglaze progression system."
	]
	quest.122964ACEB2F091B.quest_subtitle: "流动式农业工具"
	quest.1269F25E5558BE74.quest_desc: [
		"&e好&r渔夫知道耐心很重要。伟大的渔夫知道如何&b提高&r成功率。"
		""
		"渔夫帽&b将&r鱼饵和海洋幸运度各提升1级，让每次抛竿都更有收获。"
	]
	quest.1269F25E5558BE74.quest_subtitle: "抛出鱼竿，剩下的交给运气"
	quest.128E639A82FB1678.quest_desc: ["&6Craft&r a Dark Chocolate Glazed Marshmallow and combine a soft, fluffy marshmallow with a rich dark chocolate coating. It makes a &bperfect&r sweet treat for your Create: Confectionery collection. Chocolate-covered marshmallows are a classic &bconfection&r combining a soft marshmallow center with a chocolate shell."]
	quest.128E639A82FB1678.quest_subtitle: "裹着浓郁黑巧克力的蓬松点心"
	quest.12A5A3C5BB7BC3C8.quest_desc: [
		"永恒锄头是一种顶级&a农具&r，由 Better End 添加的最强材料——永恒锭锻造而成。"
		""
		"它与其余的 &bAeternium&r 套装一起，构成了该模组的工具进阶体系。"
	]
	quest.12A5A3C5BB7BC3C8.quest_subtitle: "最高阶的农业工具"
	quest.12A793014D8A05DE.quest_desc: [
		"&aDefeat&r the Ender Golem, a slow but powerful mini-boss found throughout the Ruined Citadel's upper levels, wielding melee and shockwave attacks."
		""
		"每次击杀都会掉落一个 &b虚空核心&r，可用于召唤造成伤害的虚空符文，并制作灾变中多个虚空主题的物品。"
	]
	quest.12A793014D8A05DE.quest_subtitle: "城堡上层区域的守护者"
	quest.12A793014D8A05DE.title: "&l&6末影人 &dGolem"
	quest.12A9BF6B0380CF5B.quest_subtitle: "更多盔甲 (More Armor)"
	quest.12AA6CA74CECB87F.quest_desc: [
		"Terminite 剑在锻造台用 Terminite 工具头和剑柄组装而成，是对 Thallasium 剑刃的改进。"
		""
		"这是迈向 Better End 的&a更强&r的 Aeternium 剑的垫脚石。"
	]
	quest.12AA6CA74CECB87F.quest_subtitle: "第二阶的刀刃"
	quest.12CC277C4F032C68.title: "&l&a地狱烈焰龙"
	quest.12CD30FECE9A575D.quest_desc: ["使用Aquaculture 2制作&aNeptunium Leggings&r。这款强大的护腿由Neptunium制成，这是一种通过钓鱼宝藏获得的稀有&b材料&r。它能提供强大的&b保护&r，并且是Neptunium盔甲套装的&b一部分&r。"]
	quest.12CD30FECE9A575D.quest_subtitle: "用海洋宝藏锻造的盔甲"
	quest.12E32506A5E233E5.quest_desc: [
		"&dElectromancer&r Chestplate is the Crystal Chronicles upgraded version of the Electromancer Robe from Iron’s Spells ’n Spellbooks."
		""
		"使用伏特碎片&b升级&r，为原本的电磁魔盔甲套装增强了额外的晶体力量。伏特碎片&b引导&r着闪电魔法的力量，创造出更强大的原始电磁魔装备版本。"
	]
	quest.12E32506A5E233E5.quest_subtitle: "由伏特石强化的电磁法师长袍的增强版"
	quest.1302520A3595C738.quest_subtitle: "升级+"
	quest.132151F1833DF82A.quest_desc: ["&6获取&r一个来自Create的黄铜手。它是一种由安山合金和黄铜板制成的进阶制作&b组件&r。黄铜手用于制作部署器和伸缩夹等关键组件，是迈向&b高级&rCreate机械的重要一步。"]
	quest.132151F1833DF82A.quest_subtitle: "迈向更先进的机械装置"
	quest.13435A8982162B8F.quest_subtitle: "升级+"
	quest.1343988144113072.quest_desc: [
		"&9&lTurn&r&r your Refined Storage network into an automated building system with the Constructor. It takes items from your network and places them &binto&r the world as blocks, allowing you to &bautomate&r construction and block placement."
		""
		"将其连接到您的网络，&b配置&r所需的方块，让您的数字存储系统为您完成建造。"
	]
	quest.1343988144113072.quest_subtitle: "自动从你的存储网络中建造方块"
	quest.135B8AF8E5D61A92.quest_desc: [
		"&6普通&r的十字弓在地面上很有用，但空中需要更强大的武器。重型十字弓&b能以巨大威力&r发射箭矢，为你的飞行器提供可靠的空中威胁武器。"
		""
		"&bMount&r 它到你的飞行器上，装上箭，从空中瞄准射击。"
	]
	quest.135B8AF8E5D61A92.quest_subtitle: "专为空中战斗打造的强力十字弓。"
	quest.1372FFDD8D0EB4EB.quest_desc: [
		"&eThe&r Cowboy Hat grants a Speed II effect while worn, making your ridden mounts &bsignificantly&r faster. Whether you're crossing vast plains or &bescaping&r danger, every journey becomes a little quicker."
		""
		"&b骑上&r马，踏上旅途。"
	]
	quest.1372FFDD8D0EB4EB.quest_subtitle: "骑得更快。骑得更远"
	quest.13734D174BC106DD.quest_desc: ["&d翡翠石板戒指&r通过击败生物来奖励你，使它们掉落的经验值增加25%。将其作为戒指佩戴，即可&b加快&r你的进度，通过让每场战斗都更有回报来实现附魔和&b升级&r。"]
	quest.13734D174BC106DD.quest_subtitle: "将每一次胜利转化为更丰富的经验"
	quest.1382CCEE707BE5D5.quest_desc: [
		"&a战锤&r是一种威力强大的武器，能造成巨额伤害，尤其是在下落攻击时使用。"
		""
		"从空中俯冲攻击敌人，能释放出少数生物都无法承受的毁灭性打击。这把武器奖励&b高超的技艺&r和&b精准的时机&r。"
		""
		"制作你的战锤，学习在战斗中运用其粉碎的力量。"
	]
	quest.1382CCEE707BE5D5.quest_subtitle: "粉碎之力"
	quest.1382CCEE707BE5D5.title: "战锤（Mace）"
	quest.1394098F76A762A2.quest_desc: ["&aDefeat&r the Haunter, one of the enemies encountered while &bexploring&r the Ancient Keep. Survive the &bencounter&r with this ghostly foe and continue &bfollowing&r the remnants of the Ancients. The Haunter was &badded&r to Archaion in update 1.3.0."]
	quest.1394098F76A762A2.quest_subtitle: "远古堡垒的幽灵 (Specter of the Ancient Keep)"
	quest.1394098F76A762A2.title: "击杀幻影者 (Haunter)"
	quest.139E8751E5B11841.quest_desc: ["从 Create 模组中获取&6纸板靴&r。它们是纸板盔甲套装的一部分，提供 &b1&r 点护甲值，耐久度为 &b52&r。穿戴全套并潜行时，你会变成纸板包裹，大幅缩短&b敌对&r生物能探测到你的距离。"]
	quest.139E8751E5B11841.quest_subtitle: "完成纸板伪装任务"
	quest.13A3AFA58B4A4C2D.quest_desc: [
		"&e小型&r活塞。巨大力量。"
		""
		"口袋活塞能增强你攻击造成的击退&b效果&r，将敌人击得比普通情况更远。非常适合用来保持与危险生物的距离——或者干脆把它们&b发射&r下悬崖。"
		""
		"重击。再用力推。"
	]
	quest.13A3AFA58B4A4C2D.quest_subtitle: "让你的敌人飞得远远的"
	quest.13AB6543B815AA7F.quest_desc: [
		"&a岩浆奶油&r &a是一种酿造材料，&r由烈焰粉和史莱姆球&a合成&r而成。"
		"常用于制作防火药水，因此对于下界探索来说极其&b宝贵&r。&b&r"
		"它不稳定且呈熔融状态，是火系炼金术的关键材料之一。&b&r"
	]
	quest.13AB6543B815AA7F.quest_subtitle: "防火炼金术材料"
	quest.13AB6543B815AA7F.title: "岩浆奶油"
	quest.13AFC17AEAB3540C.quest_desc: ["&6火花间隙&r，一种用于电气放电的装置。"]
	quest.13AFC17AEAB3540C.quest_subtitle: "一个火花间隙装置"
	quest.13B90ED29E48BA4D.quest_desc: ["&6处理&r放置在它下方的物品：掉落、放入 Depot 或送入传送带，它就会自动&b持有和处理&r。这就是制作磁铁的方法。"]
	quest.13B90ED29E48BA4D.quest_subtitle: "处理物品"
	quest.13C43784078199F2.quest_desc: ["合成&6Hypertube 方块&r，开始建造你的&b高速&r运输网络。将它们连接起来，在工厂中创建路线，并为&bHypertube 入口&r做好准备。"]
	quest.13C43784078199F2.quest_subtitle: "建造道路"
	quest.13C8ECBAE2D492BE.quest_desc: ["&6Craft&r the Candy Cane Pickaxe from Create: Confectionery and take your mining to a sweeter level. It is one of the Candy Cane Tools &badded&r to the mod, alongside the Candy Cane Sword, Axe, Shovel, and Hoe."]
	quest.13C8ECBAE2D492BE.quest_subtitle: "让你的挖矿体验更甜蜜"
	quest.13E10F2EDD56447C.quest_subtitle: "更多盔甲 (More Armor)"
	quest.13E702AA3E4E825A.quest_desc: ["&6获取&r一个来自Create的安山岩隧道。它是一种运输组件，&b专为&r机械传送带设计，允许&b物品&r通过，同时提供将物品从传送带分至侧向出口的功能。它还可以与Encased Fans配合&b使用&r，而不会中断传送带的处理。"]
	quest.13E702AA3E4E825A.quest_subtitle: "引导你工厂的物料流动方向"
	quest.13E84DCED53E11B5.quest_desc: ["&6工业风扇&r是 Create: Dreams n' Desires 模组中为工厂增添的强大组件。专为更大规模的&b加工&r和通风而设计，可为工业&b应用&r提供更强的气流，助你将机械系统提升至新高度。"]
	quest.13E84DCED53E11B5.quest_subtitle: "增加空气流通量"
	quest.13EC6BEF25B6D743.quest_desc: ["&6Measures&r &benergy&r used over time. In the menu, hover over the gauges to see usage in Wh or kWh. It sends a redstone pulse through a comparator every 1 Wh or 1 kWh (depending on mode), and reversed &bpower&r makes it count backwards. Changing the unit does not alter the value already measured."]
	quest.13EC6BEF25B6D743.quest_subtitle: "一个能量计量表"
	quest.13EF14F9C0C1AC10.quest_desc: [
		"&aThe&r Diamond Minotaur Axe is a legendary &bweapon&r once wielded by the mighty Minoshroom, ruler of the Labyrinth. Combining immense &bphysical&r strength with the unmatched sharpness of diamond, this massive axe delivers devastating blows &bcapable&r of cutting through even the toughest enemies."
		""
		"&aMore&r than just a trophy, it &bserves&r as proof that you have conquered one of the Twilight Forest's greatest challenges. Whether used against &bpowerful&r bosses or the countless monsters lurking within the forest, the Diamond Minotaur Axe is a &bweapon&r worthy of any seasoned adventurer."
	]
	quest.13EF14F9C0C1AC10.quest_subtitle: "迷宫冠军所使用的武器"
	quest.13F841C650DE1922.quest_desc: ["&6空白蓝图&r用于将存档蓝图加载到Create的蓝图系统中。将其放置在蓝图表中，从你的&b蓝图&r文件夹中选择已保存的.nbt蓝图，蓝图表便会将所选蓝图写入物品中。填写完成后，该蓝图可作为全息投影放置，并使用蓝图炮来&b自动&r建造该结构。"]
	quest.13F841C650DE1922.quest_subtitle: "等待被填充的蓝图"
	quest.1406E9E6FBEC722C.quest_desc: ["&dPaladin&r 盾是《水晶编年史》的防御物品，&b专为&r Paladin 装备套装设计。它与 Paladin 盔甲的神圣魔法相关，能为持有者提供神圣的&b保护&r。"]
	quest.1406E9E6FBEC722C.quest_subtitle: "为保护信徒而锻造的神圣护盾"
	quest.141772EFE05F1C0B.quest_desc: ["&6会击退&r敌人并使其眩晕，前提是敌人不强。佩戴便携式电池时，它不会消耗耐久度，而是消耗电池中的&b能量&r。一个集成电路可使其&b增强&r，但仅限有限次使用。"]
	quest.141772EFE05F1C0B.quest_subtitle: "一根电击棒"
	quest.1420CB48C3207336.quest_desc: [
		"&aCraft&r the Fiery Helmet &busing&r Fiery Ingots forged from the Hydra's blazing essence. Tempered in magical fire, this helmet protects its wearer with both exceptional &bdurability&r and the lingering warmth of the legendary beast's power."
		""
		"&aAs&r part of the Fiery Armor set, it represents your growing mastery over the Twilight Forest's most &bdangerous&r creatures. Every spark radiating from its enchanted metal serves as a reminder of your &bvictory&r over the mighty Hydra."
	]
	quest.1420CB48C3207336.quest_subtitle: "永恒的火焰加冕于我身"
	quest.143AC7705F09C9C4.quest_subtitle: "更多盔甲 (More Armor)"
	quest.1443FDF618D734B2.quest_subtitle: "更多盔甲 (More Armor)"
	quest.1449C2DE34E52C83.quest_desc: [
		"&dPyromancer&r Hat 是 Iron's Spells 'n Spellbooks 中 Pyromancer Armor 套装的头盔。佩戴后可提供 &b+3&r 护甲、&b+125&r 最大法力、&b+10%&r 火焰法术强度和 &b+5%&r 法术强度。"
		""
		"可以用5个Arcane Cloth和1个Fire Rune来&b制作&r，或者在新版本中用Smithing Table和1个Fire Rune从Wizard Helmet升级而来。"
	]
	quest.1449C2DE34E52C83.quest_subtitle: "掌握火焰魔法的炽热力量"
	quest.144E7A9CA0852D69.quest_desc: [
		"&a以太颂咏兜帽&r是一件来自永恒星光的神秘头盔，使用&b以太颂咏锭&r制作而成。"
		""
		"&a它&r是Aethersent盔甲进阶的一部分，与陨石和星光维度中找到的天体&b材料&r有关。"
	]
	quest.144E7A9CA0852D69.quest_subtitle: "陨石锻造的神秘兜帽"
	quest.145E8D98E3350178.quest_desc: [
		"&dPyromancer&r Robe 是 Iron's Spells 'n Spellbooks 中 Pyromancer Armor 套装的胸甲。穿戴后可提供 &b+8&r 护甲、&b+125&r 最大法力、&b+10%&r 火焰法术强度和 &b+5%&r 法术强度。它还可以被注入 1 个法术。"
		""
		"可以用8个奥术布和1个火焰符文&b制作&r，或用锻造台和1个火焰符文将巫师长袍升级而成。"
	]
	quest.145E8D98E3350178.quest_subtitle: "释放火焰魔法的炽热力量"
	quest.14660EAC79654B6B.quest_desc: [
		"&e越往&r深处走，在水中移动就越困难。不过有了这个护身符就不一样了。"
		""
		"沉没魅力能让你在水中自由移动，让水下&b探索&r变得轻松许多。无需与水对抗，即可&b径直&r沉底，探索沉船、海底遗迹和其他水下&b宝藏&r。"
		""
		"停止与洋流&b搏斗&r。拥抱深海。"
	]
	quest.14660EAC79654B6B.quest_subtitle: "潜入到深处之中"
	quest.149AA01535ACA800.quest_desc: ["从Cataclysm模组中&a获取&r一把Athame。这把武器由Deepling敌人掉落，用作特殊的&b近战&r武器。击败Deeplings以&b获取&r这把稀有的海洋武器。"]
	quest.149AA01535ACA800.quest_subtitle: "来自海洋深处的仪式之刃"
	quest.14A9324E914715C5.quest_desc: ["&6Craft&r the Cross Connector to route two &bindependent&r rotational connections through the same block. It allows shafts to cross without their &brotational&r power interacting, making compact mechanical layouts much &beasier&r to build."]
	quest.14A9324E914715C5.quest_subtitle: "交叉竖井，旋转方向不混合"
	quest.14BE598376D7CE47.title: "&l&b雪女王"
	quest.14C6EA6A586F51B1.quest_subtitle: "真美味！"
	quest.14C88377DBCABCB9.quest_desc: ["使用Cataclysm模组的材料，&a制作&r一把黑钢镐。这件强大的&b工具&r由黑钢制成，具有&b极佳&r的耐久度和挖掘效率。它是黑钢&b装备&r套装的一部分。"]
	quest.14C88377DBCABCB9.quest_subtitle: "由黑钢锻造而成的采矿工具"
	quest.14CF98F399532B33.quest_desc: ["&6Craft&r a White Chocolate Glazed Marshmallow by combining a soft, fluffy marshmallow with a smooth white chocolate coating. Add this sweet treat to your Create: Confectionery &bcollection&r and enjoy the &bperfect&r combination of creamy chocolate and airy marshmallow."]
	quest.14CF98F399532B33.quest_subtitle: "裹着奶油白巧克力的蓬松点心"
	quest.14DB7E9FB8A507A6.quest_desc: ["制作钻石盾牌，获得最大程度的攻击防护。"]
	quest.14DB7E9FB8A507A6.quest_subtitle: "用最强的盾牌来保护自己吧！"
	quest.14E4B6BAD5C61B69.quest_desc: ["&d驱逐戒指&r能为你提供被动的魔法爆发保护。受到攻击时，它会自动释放一股排斥性气流，将&b附近的&r敌人推开。该能力有&b2秒&r的冷却时间，是保持与敌人距离的有效防御工具。"]
	quest.14E4B6BAD5C61B69.quest_subtitle: "击退那些胆敢攻击你的人吧"
	quest.14EB1FFC9489209C.title: "&l&6&bMaledictus 诅咒者"
	quest.14EC8D406383CA77.quest_subtitle: "更多盔甲 (More Armor)"
	quest.14EEA899999F4B52.quest_desc: ["&6获取&r一个来自Create的模拟拉杆。与普通拉杆不同，它能输出0到15之间的任意红石信号强度。右键可&b增加&r信号强度，潜行右键可减小。佩戴工程师护目镜时，你可以直接看到当前的&b信号&r强度。"]
	quest.14EEA899999F4B52.quest_subtitle: "接管信号的控制权"
	quest.14F57DB930D2B243.quest_desc: [
		"&dMagehunter&r 是 Iron's Spells 'n Spellbooks 中一把强大的剑，由 Archevoker 堡垒二层的 Vindicator 所使用。击败该 Vindicator 后，这把剑会&b自然&r掉落。"
		""
		"主手持有 Magehunter 可提供 &b7&r 攻击力、&b1.6&r 攻速、&b2.5&r 攻击范围和 &b+15%&r 法术抗性。"
	]
	quest.14F57DB930D2B243.quest_subtitle: "追捕那些胆敢使用魔法的人"
	quest.153782E196BAC609.quest_desc: ["&6利用阳光产生&r &b电力&r。必须朝向太阳（越近，&b功率&r越高）且有直射光，障碍物会大幅降低输出。在炎热生物群系中会损失&b效率&r。相邻放置的面板会组成多方块结构。"]
	quest.153782E196BAC609.quest_subtitle: "来自太阳的能量"
	quest.15431E0BCD88A88D.quest_desc: [
		"&dDecrepit&r Scythe 是 Iron's Spells 'n Spellbooks 中一件强大的武器。主手持有时，可提供 &b11&r 的攻击伤害和 &b1.4&r 的攻击速度。"
		""
		"可以使用 1 个 Timeless Slurry 和 1 个 Pyrium Ingot 将其&r升级&b为 Hellrazor &r&b。"
	]
	quest.15431E0BCD88A88D.quest_subtitle: "挥舞着陨落火王的古老镰刀"
	quest.155698708D31061A.quest_desc: ["&a获得 5 个&r海绵。海绵可以在海洋遗迹的海绵房间内找到，也可以通过&b击败&r远古守卫者获得。它们能吸收水，有助于&b水下&r探索。"]
	quest.155698708D31061A.quest_subtitle: "来自海洋纪念碑的宝藏"
	quest.155698708D31061A.title: "海绵宝宝海绵！！！"
	quest.1558A3470622608C.quest_subtitle: "真美味！"
	quest.155EC01438BFF295.quest_desc: ["&dTesla&r Rod is a weapon from Crystal Chronicles, associated with the enhanced Electromancer equipment. It &bharnesses&r the power of Lightning magic and Voltite, unleashing concentrated electrical energy against enemies."]
	quest.155EC01438BFF295.quest_subtitle: "充满伏特石能量的强大秘法魔杖"
	quest.15684C8DC5461821.quest_desc: ["&6The&r Generator Coil is a key component of the electrical system in Create: New Age. &bCombined&r with the appropriate generator setup, it allows &brotational&r power from Create to be converted into electrical energy. Build your first coil and take the next &bstep&r toward powering your factory with electricity."]
	quest.15684C8DC5461821.quest_subtitle: "将旋转转化为电能"
	quest.15692C6648259269.quest_desc: ["&6Craft&r the Andesite Configurable Gearbox to gain more control over your kinetic connections. &bConfigure&r its shaft faces to route rotational power exactly where you need it, making compact and flexible mechanical layouts easier to build. It is &bpart&r of Create: Encased."]
	quest.15692C6648259269.quest_subtitle: "配置你的旋转方式"
	quest.1579479A9BDC15EF.quest_desc: ["&6Craft&r a Mechanical Press from Create. &bIt&r is one of the mod's most important early machines, &bused&r primarily to press Ingots into Sheets. When placed above a Basin, it can &balso&r perform Packing and Compacting recipes."]
	quest.1579479A9BDC15EF.quest_subtitle: "用机械的力量锻造金属"
	quest.15801FA5DAA3426E.quest_subtitle: "真美味！"
	quest.1589DFF8D8B70BDB.quest_desc: [
		"&e有时候&r体型小也有好处。"
		""
		"The Charm of Shrinking &breduces&r your size to roughly half of your normal height. Become harder to spot, squeeze into tight spaces and see the world from a whole &bnew&r perspective."
		""
		"&b渺小的&r身躯，伟大的冒险。"
	]
	quest.1589DFF8D8B70BDB.quest_subtitle: "保持谦逊，胸怀大志"
	quest.1598143ABE2A3FE6.quest_desc: ["&a击败&r来自Cataclysm模组的5只Draugr。这些亡灵战士在Frosted Prison中徘徊，会无情地&b攻击&r任何&b进入&r其冰冻领域的生物。"]
	quest.1598143ABE2A3FE6.quest_subtitle: "击败被冰冻的不死生物"
	quest.1598143ABE2A3FE6.title: "击杀德拉格（Draugr）"
	quest.15A0DA57EF17E2A8.quest_desc: ["&6烈焰战斧&r是Create Stuff 'N Additions中烈焰套装的武器。它有450点耐久度，造成6.5点攻击伤害，攻速为1.5。它的&b攻击&r会点燃生物，使其成为近战中的强力&b武器&r。"]
	quest.15A0DA57EF17E2A8.quest_subtitle: "让你的刀刃燃烧起来"
	quest.15A176491FE6C59D.quest_desc: ["&6Build&r a Windchest to manage the &bairflow&r and stops of your pipe organ. Windchests make it easier to control multiple organ stops on a larger scale, &bhelping&r you build more complex musical instruments."]
	quest.15A176491FE6C59D.quest_subtitle: "让你的器官重获新生，注入灵魂"
	quest.15A41616700124C0.quest_desc: ["使用Create模组制作&6磨石&r。这是一种早期的机械加工设备，&b利用&r旋转动力将各种物品研磨成&b有用的&r材料。它可以处理从上方投入的物品，是更&b高级&r的粉碎轮的一种简化替代方案。"]
	quest.15A41616700124C0.quest_subtitle: "努力研磨，获得更好的材料"
	quest.15A4D35BF2B8AFD9.quest_desc: [
		"&d吸血魔咒书&r是 Iron's Spells 'n Spellbooks 中一本强大的血魔法咒语书。它能将血斩和血步的等级提升&b+1&r，装备后可提供&b+10%&r的血魔法强度、&b+10%&r的魔法抗性以及&b+200&r的最大法力值。"
		""
		"驾驭血液魔法的&b力量&r，成为一名更强大的施法者。"
	]
	quest.15A4D35BF2B8AFD9.quest_subtitle: "拥抱血魔法的强大力量"
	quest.15AE326A4267692B.quest_subtitle: "升级+"
	quest.15AE8E766962AD23.quest_desc: [
		"&6A&r 简单的陀螺仪能让你的飞行器保持稳定，但更先进的工程能实现更多功能。高级陀螺仪增加了一个机械&b仪表&r板，让你能在飞行时监控速度、俯仰和警告信息。"
		""
		"&b安装&r它，并在起飞后密切关注飞机的状况。"
	]
	quest.15AE8E766962AD23.quest_subtitle: "精密仪器，掌控全局。"
	quest.15D6009B5D72CB2B.quest_desc: [
		"&d学徒的魔法书&r是 Iron's Spells 'n Spellbooks 中的黄金级魔法书。装备后可提供 &b8&r 个法术栏位，并赋予 &b+15%&r 施法速度减免和 &b+50&r 最大法力值。"
		""
		"&b升级&r至铁封魔典，准备好迎接更&b高级&r的魔法。新增法术位、更快的施法速度和更多的法力值，这本书将显著&b提升&r你的魔法成长。"
	]
	quest.15D6009B5D72CB2B.quest_subtitle: "踏入咒语施放的下一个阶段"
	quest.15DB9273EF70A5A6.quest_desc: ["&dExplore&r Hazen N Stuff, discover new items and &bexpand&r your Minecraft adventure!"]
	quest.15DB9273EF70A5A6.quest_subtitle: "发现新物品和实用新增内容！"
	quest.15DB9273EF70A5A6.title: "&l&d欢迎，Hazen 'N Stuff"
	quest.15EBC896DD9A8B6A.quest_desc: [
		"&a获取&r皮革手柄附魔模板，用于在锻造台将皮革包裹的木棍附魔到工具头上。"
		""
		"在更好的手柄出现之前，它为&b组装&r更好的末地工具提供了更便宜、更早的替代方案。"
	]
	quest.15EBC896DD9A8B6A.quest_subtitle: "更简单的控制器"
	quest.15F29EF5F937029E.quest_subtitle: "更多盔甲 (More Armor)"
	quest.16121596903B5B3A.quest_desc: [
		"&a探索&r繁花尖塔——岛屿和漂浮尖塔上覆盖着茂盛的粉蓝色植被，&b花瓣&r从空中飘落。"
		""
		"Tenanea 树生长于此，丝绸飞蛾在树枝间筑巢，使其成为末地中最&b宁静&r的生物群之一。"
	]
	quest.16121596903B5B3A.quest_subtitle: "漂浮的尖塔在绽放"
	quest.16121596903B5B3A.title: "绽放的尖塔"
	quest.162239A6A7321602.quest_desc: ["&eCombine&r alchemy with technology! The Potion Sprayer allows you to shoot droplets of potions, spraying their effects onto your target. Simply aim and &bright-click&r to fire. The device &bconsumes&r only a fraction of the potion's duration, allowing you to use its effects more efficiently. &bPrepare&r your potions and put this ingenious invention to the test!"]
	quest.162239A6A7321602.quest_subtitle: "炼金术与机械的碰撞"
	quest.1639C5CF8C2E46DE.quest_desc: ["&6Zinc&r Boots are part of the Zinc Suit from Create Stuff 'N Additions. They provide an &balternative&r set of armor made from Zinc and have &b260&r durability. They are crafted using &b4&r Zinc Ingots."]
	quest.1639C5CF8C2E46DE.quest_subtitle: "踏入更强大的事物之中"
	quest.165A3D4899C7CE3E.quest_desc: [
		"&a击败&r末影龙，末地的原始首领，中央岛屿的守护者。"
		""
		"击败它即可开启通往外围岛屿的&b末地传送门&r，那里才是 Better End 生物群系和&b资源&r的真正起点。"
	]
	quest.165A3D4899C7CE3E.quest_subtitle: "直面末地的守护者"
	quest.165A3D4899C7CE3E.title: "&l&d末影龙"
	quest.16660EB4BF922732.quest_subtitle: "更多盔甲 (More Armor)"
	quest.1669DB82AD915EEC.title: "村民西格玛"
	quest.1696835CA5C1E502.quest_desc: [
		"&e为什么&r要随身携带熔炉，当你的双手可以完成工作时？"
		""
		"Pickaxe Heater 会在你挖掘时自动熔炼方块。矿石会&b直接&r熔炼成成品，而其他方块也能产生&b有用的&r&b结果&r——例如原木变成木炭，沙子变成玻璃。"
		""
		"&b向下&r挖掘。熔炉会随你一同前往。"
	]
	quest.1696835CA5C1E502.quest_subtitle: "开采它。冶炼它。继续前进"
	quest.16A91D6314BCEE89.quest_desc: ["从Cataclysm模组中&a获取&r一把Khopesh。这把&b古老的&r弯刀由栖息在沙漠遗迹的Koboleton使用。&b击败&r这些骷髅守卫，就有机会夺走他们的&b标志性&r武器。"]
	quest.16A91D6314BCEE89.quest_subtitle: "沙漠守护者的弧形刀刃"
	quest.16C9E1B9DC493B42.quest_desc: ["&6欢迎来到&r Create: Encased！这个&b扩展包&r扩展了 Create 的外壳系统，让转轴、齿轮和管道可以使用多种外壳。打造更整洁、更统一的机器，同时让你的动能系统更具&b工业风&r。该扩展包还包含&b额外的&r带壳组件和与新版本的兼容性功能。"]
	quest.16C9E1B9DC493B42.quest_subtitle: "给你的机器一个合适的外壳"
	quest.16C9E1B9DC493B42.title: "&l&6欢迎来到 Create Encased 模组"
	quest.16CFE3EF0ABCF30E.quest_desc: [
		"&a穿过&r末地传送门，踏入&b末地&r——一个充满无尽虚空、浮空岛屿和末影龙的维度。"
		""
		"这里是通往 Better End 一切内容的&a门户&r，从奇特的新生物群到强大的&b游戏后期&r装备。"
	]
	quest.16CFE3EF0ABCF30E.quest_subtitle: "在外部岛屿的更深处"
	quest.16CFE3EF0ABCF30E.title: "&l&d末地"
	quest.16D17F7B20048399.quest_subtitle: "真美味！"
	quest.1719197C39F46D1B.quest_desc: ["&d火绳枪&r是一种由简单机械部件组成的长管枪。当想从&b远处&r而非近处射击目标时使用它，并打开其修饰器菜单以根据你的游戏风格进行调整。"]
	quest.1719197C39F46D1B.quest_subtitle: "一款经典的长管枪械"
	quest.172786BB1D31B4AB.quest_desc: ["&aCraft&r the Cursium Mage Skirt from the Cataclysm: Spellbooks addon. Woven with the cursed &bessence&r of Cursium, this &benchanted&r garment completes the Cursium Mage set, allowing its wearer to fully embrace the &bforbidden&r power hidden within the Ancient Factory."]
	quest.172786BB1D31B4AB.quest_subtitle: "禁忌服饰的最后一件物品"
	quest.17323CADFAE8D198.title: "不错，干得好，专业玩家"
	quest.174BA7516500B67A.quest_subtitle: "更多盔甲 (More Armor)"
	quest.175A327DC1A4322B.quest_desc: [
		"&9&l随身携带&r&r你的 Refined Storage 网络。无线网格让你可以远程&b访问&r数字存储，无需直接&b连接&r网络即可查看、搜索和管理物品。"
		""
		"搭配无线发射器，即可享受远程&b管理&r存储的自由。"
	]
	quest.175A327DC1A4322B.quest_subtitle: "随时随地访问你的整个存储网络"
	quest.1762F955DD44424E.quest_subtitle: "升级+"
	quest.176378DFBC009C93.quest_subtitle: "升级+"
	quest.177D9D68B790740B.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.178C046DD22870A7.quest_desc: [
		"&aDeepsilver&r 是永恒星光中常见的基础金属之一。"
		"可以将其熔炼成锭，用于制作工具、盔甲和多种实用配方。"
		""
		"最初被称为沼泽银，现在这种材料会&b生成&r在该维度的地下区域。"
	]
	quest.178C046DD22870A7.quest_subtitle: "来自深海的金属"
	quest.178C046DD22870A7.title: "&6深海银锭"
	quest.17ADAF445CB8C8B0.quest_desc: ["&d一种&r特殊符文，&b用于&r在 Hazen N Stuff 中制作水武器。"]
	quest.17ADAF445CB8C8B0.quest_subtitle: "注入了水之力量的符文"
	quest.17CA7BF8E75A4B72.quest_desc: [
		"&9&l将&r&r你的铜质储物箱带到铁质储物箱处。此升级可提升你的储物能力，让你更&b进&r一步接近最高级的储物箱。"
		""
		"不断&b升级&r你的容器，建造一个能容纳最大收藏品的存储系统。"
	]
	quest.17CA7BF8E75A4B72.quest_subtitle: "锻造你的道路，迈向更强大的存储"
	quest.17CCA970EE3B5224.quest_subtitle: "更多盔甲 (More Armor)"
	quest.17DC5821AB6385E7.quest_subtitle: "升级+"
	quest.1801803F06F75E60.quest_desc: ["&6从Create中获取&r轨道。轨道是Create铁路系统的基础，能让火车在车站之间&b行驶&r。轨道可以铺设成直线、曲线和岔道，让你能建造复杂的铁路网络。将火车站与轨道&b连接&r后，即可&b开始&r组装火车。"]
	quest.1801803F06F75E60.quest_subtitle: "铺设你铁路的基础设施"
	quest.18037EBDF89FDA39.quest_subtitle: "更多盔甲 (More Armor)"
	quest.1824205C75ADA826.quest_desc: [
		"Schalk Sticks are &bused&r in decorating and crafting advanced decorative items."
		"制作一个，即可开始在您的世界中创造独特的图案和设计。"
	]
	quest.1824205C75ADA826.quest_subtitle: "制作你的第一根装饰性木棍"
	quest.1824205C75ADA826.title: "恶作剧之棒"
	quest.183B980DAE2FE750.quest_desc: ["&6从Create模组中获取&r一个火车信号机。火车信号机将铁轨分为多个&b区段&r，并控制火车是否&b被允许&r进入，有助于防止碰撞并保持自动化铁路网络的有序。使用扳手可以将&b信号机&r配置为入口信号机或交叉信号机。"]
	quest.183B980DAE2FE750.quest_subtitle: "保持铁路的安全运行"
	quest.18461FDC254CB816.quest_desc: ["&6Obtain&r a Desk Bell, Peculiar Bell, and Haunted Bell from Create. Each bell has its own purpose: the Desk Bell can emit a Redstone pulse, the Peculiar Bell serves as a &bdecorative&r brass bell and can be transformed into a Haunted Bell, while the Haunted Bell can reveal areas where &bhostile&r mobs may spawn."]
	quest.18461FDC254CB816.quest_subtitle: "敲响创造的钟声，唤醒世界的诞生"
	quest.185CD1A2FA6040DC.quest_desc: [
		"&l&9Never&r&r run out of the items you use most. The Refill Upgrade &bautomatically&r replenishes selected items in your inventory &busing&r supplies stored inside your backpack. It can keep up to 6 different items stocked wherever they are in your inventory."
		""
		"高级补给升级更进一步，支持多达12个物品，并可精确选择&b每个&r物品的补给位置——背包、主手、副手或特定快捷栏槽位。"
	]
	quest.185CD1A2FA6040DC.quest_subtitle: "随时保持必需品储备充足"
	quest.185CD1A2FA6040DC.title: "重新填充 \& 高级重新填充升级"
	quest.186B2F89052D3915.quest_desc: [
		"&a制作&r传奇的下界之星鱼钩，一个融入了现存最稀有宝藏之一的力量的钓鱼&b升级&r。它由陨落的凋零的残骸制成，这款非凡的鱼钩&b代表了&r危险魔法与高级钓鱼技艺的完美结合。"
		""
		"&aOnly&r the bravest adventurers who have &bconquered&r the horrors of the Nether can obtain the materials required for such a powerful tool. With the Nether Star Hook, your fishing journey reaches a new level, &ballowing&r you to seek treasures worthy of a true master."
	]
	quest.186B2F89052D3915.quest_subtitle: "一块来自下界的强大能量碎片"
	quest.188625FB1A6A1EAD.quest_desc: [
		"&a深银靴&r是永恒星光中用&b深银锭&r制作的防护鞋。"
		""
		"Deepsilver armor &aimproves&r movement speed, attack speed, and knockback resistance, while the complete set grants &bimmunity&r to several harmful effects."
	]
	quest.188625FB1A6A1EAD.quest_subtitle: "迅捷的银色鞋履"
	quest.189216DAAD0170F1.quest_desc: ["使用高级太阳能加热板来&6升级&r你的太阳能加热系统。这个&b改进版&r能为你的热力系统提供更&b强劲&r的热量来源，让你能构建更高效的&b装置&r，并为工厂产生更多的热量。"]
	quest.189216DAAD0170F1.quest_subtitle: "利用更多的太阳能热量来发电"
	quest.18952C22F2AFCFA7.quest_desc: [
		"&dCryomancer&r靴是Iron's Spells 'n Spellbooks中Cryomancer盔甲套装的一部分。穿戴后可提供&b+3&r护甲、&b+125&r最大法力、&b+10%&r冰系法术强度和&b+5%&r法术强度。"
		""
		"它们可以用 4 个 Arcane Cloth 和 1 个 Ice Rune 来&b制作&r，或者用 1 个 Ice Rune 和 1 个 Arcane Essence 从 Wizard Boots 升级而来。"
	]
	quest.18952C22F2AFCFA7.quest_subtitle: "运用冰魔法的力量，漫步于冰冻的国度"
	quest.189D73BFFD934933.quest_desc: ["&6Craft&r the Candy Cane Sword from Create: Confectionery and take on your enemies with a festive weapon. It is part of the Candy Cane Tools set &badded&r to the mod, alongside the Candy Cane Pickaxe, Axe, Shovel, and Hoe. The latest 1.20.1 &brelease&r includes the Candy Cane Tools."]
	quest.189D73BFFD934933.quest_subtitle: "适合节日战斗的甜美之刃"
	quest.189F394C8BA85129.quest_desc: ["&6黄铜立方体&r是 Create Stuff 'N Additions 添加的一种特殊可移动实体。它可以被&b放置&r在世界上，并作为一个可以支撑其他实体的固体物体。它不会自行移动，但可以用方块抓取器将其拾起和&b运输&r。黄铜立方体使用&b8&r个黄铜锭和&b1&r个下界合金锭制作，是更&b高级&r装置和机械的实用组件。"]
	quest.189F394C8BA85129.quest_subtitle: "一块坚固的黄铜工程制品"
	quest.18B3D07EC43ABBB0.quest_desc: [
		"&a寻找&r一座末地城，这是一种由紫晶块和末地石砖构成的巨型结构，生成于末地的外岛。"
		""
		"有潜行者的守护，这些塔楼里藏着该维度最棒的战利品——包括鞘翅和&b潜行者的壳&r。"
	]
	quest.18B3D07EC43ABBB0.quest_subtitle: "紫颂与潜贝的塔楼"
	quest.18B3D07EC43ABBB0.title: "&d末地城市"
	quest.18BA5F1590BDD5FD.quest_desc: ["&6Biomass&r is an organic fuel resource added by Create Crafts \\& Additions. It can be &bprocessed&r into Biomass Pellets and used as a fuel, providing a &brenewable&r way to power your factory. The mod also includes further &bprocessing&r into Bioethanol, giving biomass a useful role in your fuel production chain."]
	quest.18BA5F1590BDD5FD.quest_subtitle: "将有机物转化为燃料"
	quest.18BE95E97E843ECC.quest_desc: ["从Cataclysm模组中&a获取&rGauntlet of Bulwark。这件&b传奇&r护手能引导下界的力量，让佩戴者释放出火焰冲击波，并以压倒性的力量控制&b战场&r。它是地狱领域的标志性遗物之一。"]
	quest.18BE95E97E843ECC.quest_subtitle: "命令火焰，守护与毁灭"
	quest.18BE95E97E843ECC.title: "&c堡垒手套 (Gauntlet Of Bulwark)"
	quest.18CB628FED0538D8.quest_desc: [
		"&dShriving&r Stone 是 Iron's Spells 'n Spellbooks 中的一种合成材料，可在铁砧或秘法铁砧上移除装备的附魔和&b升级&r。在新版本中，&b在秘法铁砧上&r使用它还能返还物品上&b使用&r过的升级球。"
		""
		"It is &bcrafted&r from 1 Raw Iron and 1 Amethyst Shard."
	]
	quest.18CB628FED0538D8.quest_subtitle: "清除附魔，回收你的装备"
	quest.18D23701DC40E769.quest_desc: ["&d火绳枪&r是一种用钟表组件打造的长管火器。获得一把即可解锁维基百科历史学家成就，其修饰符插槽能让你真正打造专属自己的武器。"]
	quest.18D23701DC40E769.quest_subtitle: "来自另一个时代的武器"
	quest.18E6C8C7E54DE095.quest_subtitle: "更多盔甲 (More Armor)"
	quest.18F0B98EADA14792.quest_desc: ["&6Obtain&r Andesite Alloy, one of the fundamental materials in Create. It is &bused&r extensively in early mechanical components, including Shafts, Cogwheels, and Andesite Casings. &bIt&r can be crafted &busing&r Andesite and Iron Nuggets or Zinc Nuggets, or produced by mixing Andesite with an Iron or Zinc Nugget."]
	quest.18F0B98EADA14792.quest_subtitle: "机械工程的基础知识"
	quest.18F0B98EADA14792.title: "安山岩合金"
	quest.1902F55A2E3FD6FD.quest_desc: ["&6Process&r Thorium into Radioactive Thorium and take the next step toward nuclear technology in Create: New Age. These &bmaterials&r are essential for progressing into the reactor branch and &bunlocking&r more advanced nuclear components."]
	quest.1902F55A2E3FD6FD.quest_subtitle: "提炼原子的力量"
	quest.1902F55A2E3FD6FD.title: "Thorium 进度系统"
	quest.19036DBA141117A3.quest_desc: [
		"在永恒星光中，&a以太&r是一种易挥发物质，可以用桶来&b收集&r。"
		"&aUnlike&r lava, it does not destroy items — but it is still &bdangerous&r to handle."
	]
	quest.19036DBA141117A3.quest_subtitle: "危险的精华"
	quest.193323B714918063.quest_desc: ["从 L_Ender’s Cataclysm 中获取&a&r凋零突击肩炮。这件&b强大的&r远程武器会发射凋零&b&r导弹，造成伤害、引发爆炸并施加凋零 II 效果。潜行时，它则会发射凋零手榴弹，造成高伤害的&b&r爆炸和一片凋零烟雾。"]
	quest.193323B714918063.quest_subtitle: "释放凋零的恐怖力量"
	quest.193323B714918063.title: "&c凋零突击肩扛武器"
	quest.1939D50868404EA2.quest_subtitle: "升级+"
	quest.193D395B36B75F28.quest_subtitle: "更多盔甲 (More Armor)"
	quest.196132151FD59708.quest_desc: ["&6获取&r一个来自Create的传动轴。传动轴是该模组中最&b基础&r的机械组件之一，&b用于&r在相连组件间传递旋转力。它也是机械带轮的&b基础&r。一个安山合金可以锯成&b6&r个传动轴，或者用&b2&r个安山合金可以制作成&b8&r个传动轴。"]
	quest.196132151FD59708.quest_subtitle: "机械动力的中流砥柱"
	quest.196132151FD59708.title: "竖井"
	quest.1977F95F83CD7190.quest_desc: ["&6The&r Spiky Shell is an aquatic crafting material added in Create: Aquatic Ambitions 2.0. It is used in the crafting of the Trident, &breplacing&r the old Polished Quartz Tine from earlier versions. Collect Spiky Shells to &bunlock&r one of the most powerful weapons of the sea."]
	quest.1977F95F83CD7190.quest_subtitle: "来自深海的武器"
	quest.1978F7E664C6B9C8.quest_desc: ["探索世界深层，收集 &a5 颗钻石&r。钻石极为稀有，是打造顶级工具、武器和高级装备的基础。找到它们，意味着你已达到新的 &b进度&r 水平。"]
	quest.1978F7E664C6B9C8.quest_subtitle: "最珍贵的地下资源"
	quest.1978F7E664C6B9C8.title: "&b钻石！"
	quest.1986376E0B2C0462.quest_desc: [
		"&aSeeking Eye&r 是一种特殊物品，用于在 Eternal Starlight 中定位维度内的强大&bboss&r。"
		"使用时，它会引导你走向无法通过常规&a探索&r发现的隐藏威胁。"
	]
	quest.1986376E0B2C0462.quest_subtitle: "它会指引方向"
	quest.1986376E0B2C0462.title: "&l&5寻找之眼"
	quest.19A2B8AEEBEB630A.quest_desc: ["制作&6短笛管&r，为你的管风琴增添明亮、&b高亢&r的音色。短笛管是 Create: Sound of Steam 中管风琴的&b音栓&r之一，其他还有大管、基音管和伽马管等。"]
	quest.19A2B8AEEBEB630A.quest_subtitle: "添加一个明亮、尖细的声音"
	quest.19A822E3223E5218.quest_desc: ["&6The&r Copper Exoskeleton is a wearable piece of equipment from Create Stuff 'N Additions that enhances your physical abilities. It can provide Strength or Haste, &bmaking&r you more effective in combat and while working with tools. The exoskeleton is crafted &busing&r Create's mechanical crafting &bprocesses&r and requires hydraulic energy to operate."]
	quest.19A822E3223E5218.quest_subtitle: "提升你的力量和速度"
	quest.19CF5920F5C100DF.quest_desc: [
		"Craft a &aSleeping Bag&r to sleep safely without a bed."
		"睡袋让你可以在世界任何地方设置重生点并休息。"
	]
	quest.19CF5920F5C100DF.quest_subtitle: "在任何地方睡觉都可以"
	quest.19CF5920F5C100DF.title: "睡袋"
	quest.19EE02F8FACB74A7.quest_desc: [
		"&aCraft&r the Ironwood Boots using Ironwood Ingots &binfused&r with the ancient magic of the Twilight Forest. Forged to withstand the dangers of forgotten ruins and enchanted wilderness, these boots provide dependable protection while remaining comfortable enough for long &bexpeditions&r across the magical realm."
		""
		"&aAs&r the final piece of the Ironwood Armor set, they &bcomplete&r a balanced collection of equipment capable of carrying you through the many &bchallenges&r that await within the Twilight Forest."
	]
	quest.19EE02F8FACB74A7.quest_subtitle: "在附魔的土地上站稳脚跟"
	quest.1A03C838956DBD18.quest_desc: ["&6用于&r开关&b、固定装置和其他部件的小型&r接触点。"]
	quest.1A03C838956DBD18.quest_subtitle: "接触针脚"
	quest.1A0BA09F04CC257D.quest_desc: [
		"&d告别&r平凡世界，踏入充满强大法术、古老知识和魔法物品的奇幻国度。Iron's Spells 'n Spellbooks 为你的冒险带来深度魔法系统，赋予你&b力量&r学习法术、挥舞&b附魔&r武器，成为真正的奥术大师。"
		""
		"&b收集&r你的第一件魔法装备，发现新法术，并&b开启&r成为强大施法者的旅程。"
	]
	quest.1A0BA09F04CC257D.quest_subtitle: "开启你的魔法世界之旅吧"
	quest.1A0BA09F04CC257D.title: "&l&d欢迎来到 Iron's Spell 'n Spellbooks"
	quest.1A1748E3BE20CC81.quest_desc: ["&6制作&r金属走道台阶，开始扩建你&b工厂&r的高架走道。这些结实的&b台阶&r是 Create: Escalated 模组&b添加&r的运输系统的一部分，能帮你为工厂规划实用的路线。"]
	quest.1A1748E3BE20CC81.quest_subtitle: "建造通往下一级的道路"
	quest.1A20DB140D7D7229.quest_subtitle: "更多盔甲 (More Armor)"
	quest.1A3E117D9AC47513.quest_desc: [
		"Thallasium Ingot 是 Better End 工具和盔甲进阶的基础金属。"
		""
		"用遍布末地的&bThallasium&r矿石熔炼，再用铁砧和锻造锤打造成护甲和工具头。"
	]
	quest.1A3E117D9AC47513.quest_subtitle: "第一梯度的金属"
	quest.1A412349DDF29366.quest_desc: ["&6一款&r多功能工具，适合所有想玩弄&b电力&r的人。手持时，可以探测端子间的&b电压&r或导线中的电流（可通过切换模式进行）。"]
	quest.1A412349DDF29366.quest_subtitle: "多功能测量仪"
	quest.1A56BB38BDD9F25C.quest_desc: [
		"&e每次&r冒险都该有个小伴侣。"
		""
		"欢迎毛绒玩具是一个小小的提醒，提醒着你无需独自踏上任何&b旅程&r。把它带在身边，在你的家中给它一个&b位置&r，让它在你每次探险归来后都欢迎你回家。"
		""
		"一个&b新&r世界在等着你。欢迎回家。"
	]
	quest.1A56BB38BDD9F25C.quest_subtitle: "为每一次冒险献上热情的欢迎"
	quest.1A56BB38BDD9F25C.title: "&f&l欢迎使用 &9Plushie MOD"
	quest.1A5AD879324A92A5.quest_desc: ["&6铜制工具&r是 Create Stuff 'N Additions 添加的一套完整工具。它们为日常工作提供了基于铜的&b替代方案&r，包括全套镐、斧、铲、锄和剑。制作&b完整&r套装，让你的铜在机器之外发挥作用。"]
	quest.1A5AD879324A92A5.quest_subtitle: "为你的工具增添新锋刃"
	quest.1A5AD879324A92A5.title: "铜制工具"
	quest.1A63793F65B24A75.quest_desc: [
		"&a马拉里特斧&r是永恒星光模组的前期工具，使用来自沼泽相关群系的马拉里特&b制作而成&r。"
		""
		"&a它&r属于基础进阶阶段，用于伐木和&b早期&r战斗。"
	]
	quest.1A63793F65B24A75.quest_subtitle: "沼泽地伐木工具"
	quest.1A6C9BFFB7DE7FCC.quest_desc: [
		"&d传奇&r墨水是 Iron's Spells 'n Spellbooks 中最高阶的魔法墨水。它极少出现在魔法结构中，或由强大的魔法生物&b获取&r。"
		""
		"在卷轴锻造炉中&b使用&r它，创造传说卷轴，并&b解锁&r最强大的魔法等级。"
	]
	quest.1A6C9BFFB7DE7FCC.quest_subtitle: "最稀有的魔法力量精华"
	quest.1A6C9BFFB7DE7FCC.title: "&6传奇墨水"
	quest.1A95FC4F73694D81.quest_desc: [
		"&9&lKeep&r&r your storage &borganized&r with the Filter Upgrade. It allows you to control which items can enter or leave your storage, making it easier to &bconnect&r your containers to automated item transport systems."
		""
		"高级过滤升级&b能&r更精确地控制物品移动，为你提供额外的过滤&b选项&r，来决定你的储物空间究竟要接收或提供哪些物品。"
	]
	quest.1A95FC4F73694D81.quest_subtitle: "完全掌控你的存储空间"
	quest.1A95FC4F73694D81.title: "过滤器 \& 高级过滤器升级"
	quest.1AB7F05CD50ED0F9.quest_desc: ["&dSanguine&r Edge 是《Crystal Chronicles》中一款武器，该模组是《Iron's Spells 'n Spellbooks》的&baddon&r。其深红的特性体现了血魔法的力量，使其成为&b血系&r构筑的强力武器。"]
	quest.1AB7F05CD50ED0F9.quest_subtitle: "一把浸透了血魔法力量的利刃"
	quest.1ABE0E54542EAC0F.quest_subtitle: "更多盔甲 (More Armor)"
	quest.1ACBC0809E193D2B.quest_desc: [
		"&a通过挖掘和冶炼金矿石或其他方法获得&r金锭。"
		"黄金可用于多种合成&b配方&r，在末地中尤其有用。"
	]
	quest.1ACBC0809E193D2B.quest_subtitle: "一种珍贵的资源"
	quest.1ACBC0809E193D2B.title: "金锭"
	quest.1AE40FE5B2553236.quest_desc: ["&6从Create中获取&r一个List Filter和一个Nozzle。List Filter可以让你创建自定义的&b物品&r列表，以允许或禁止过滤运输组件。Nozzle则与Create的物品运输系统&b配合使用&r，以控制和引导物品移动，两者都更适用于实现&b更精确&r的工厂物流。&b&r"]
	quest.1AE40FE5B2553236.quest_subtitle: "掌控流经你工厂的一切物品"
	quest.1AE40FE5B2553236.title: "列表过滤器 \& 喷嘴"
	quest.1AEF11A228882EA6.quest_desc: [
		"&aArctic&r Fur is a soft yet incredibly resilient &bmaterial&r gathered from the creatures that inhabit the icy reaches of the Twilight Forest. Its &bremarkable&r insulating properties make it one of the finest &bmaterials&r for crafting &bequipment&r capable of enduring the relentless cold."
		""
		"&aHighly&r prized by experienced adventurers, Arctic Fur is &bessential&r for creating the Arctic Armor set. Wearing equipment crafted from this rare pelt &ballows&r you to brave the frozen wilderness and continue your &bjourney&r toward the final challenges hidden within the Twilight Forest"
	]
	quest.1AEF11A228882EA6.quest_subtitle: "抵御寒风侵袭的斗篷一件"
	quest.1AF2481AB26B4EE7.quest_desc: [
		"&aIn this world&r, the End is not reached the usual way."
		"要解锁&d末地&r，你必须收集12个来自End Remastered的末影之眼，每个都代表你通过探索、故事任务和击败首领所获得的进度碎片。"
		""
		"这些&b眼睛&r并非凭空而来，而是需要赢取。从击败强大首领到完成重要剧情节点，冒险的每一步都让你更接近解锁末地传送门。"
		""
		"只有当所有&e 12&r 个眼睛都&a收集&r完毕后，最终的通路才会&b开启&r。"
	]
	quest.1AF2481AB26B4EE7.quest_subtitle: "请先阅读此内容！"
	quest.1AF2481AB26B4EE7.title: "&e末地之眼 &d的 &c眼睛 &9Of The End"
	quest.1AFC9C32E846980F.quest_subtitle: "更多盔甲 (More Armor)"
	quest.1AFDFB316B5358F7.quest_desc: ["在子弹击中处&d生成&r一个&b引力井&r，将附近的生物拉向撞击点。非常适合群体控制。"]
	quest.1AFDFB316B5358F7.quest_subtitle: "把它们聚集在一起"
	quest.1B1A21C20E23AAC8.quest_desc: [
		"&aTinkering Table&r 能让你实验和制作各种装饰性方块变体。"
		"用它来组合材料，为你的建筑创造独特的设计。"
	]
	quest.1B1A21C20E23AAC8.quest_subtitle: "尝试使用不同的方块进行实验"
	quest.1B256CB91C3D4B7D.quest_desc: [
		"&a星焰铲&r是永恒星光中后期的一种挖掘工具，属于星焰&b装备&r系列。"
		""
		"&aIt&r is used for excavation and terrain clearing, offering improved performance &bcompared&r to lower-tier tools."
	]
	quest.1B256CB91C3D4B7D.quest_subtitle: "星光挖掘工具"
	quest.1B3A0190AE2DBAAF.quest_desc: ["&6欢迎来到&r创造：超管！使用动力管与超管入口，建造一个&b高速&r运输网络。连接工厂的不同部分，在管道中飞驰，实现快速无缝的旅行。该系统与创造模组中的&b旋转&r动力直接&b集成&r。"]
	quest.1B3A0190AE2DBAAF.quest_subtitle: "以创造的速度旅行 (Travel at the speed of Create)"
	quest.1B3A0190AE2DBAAF.title: "&l&6欢迎来到创造超管模块"
	quest.1B539D9A88A15B9E.quest_subtitle: "更多盔甲 (More Armor)"
	quest.1B5ABB63DDABE534.quest_desc: ["&dYour&r bullets &bexplode&r on impact, damaging everything in a small radius."]
	quest.1B5ABB63DDABE534.quest_subtitle: "爆炸性收尾"
	quest.1B62BA7293AED04F.quest_desc: [
		"&6The&r railway is more than just a way to get from one place to another. Steam 'n' Rails expands Create's railway system with new tracks, signals, train equipment and &bdecorative&r details, giving you &beverything&r you need to build a truly impressive railway network."
		""
		"铺设新轨道，建造车站，整理你的&b铁路&r，让你的火车投入工作。你的铁路帝国由此开始。"
	]
	quest.1B62BA7293AED04F.quest_subtitle: "将你的铁路网络提升到新的水平。"
	quest.1B62BA7293AED04F.title: "&l&6欢迎来到创造蒸汽与铁路模组包"
	quest.1B82B436FBEDA07C.quest_subtitle: "真美味！"
	quest.1B883679D57514B2.quest_desc: ["&a交易站&r可自动化与猪灵&b交易&r。将金锭放入其中，交易站会将其交给附近的猪灵，并&b自动&r收集换来的物品。"]
	quest.1B883679D57514B2.quest_subtitle: "让猪灵为你工作吧"
	quest.1B9B5991EA5ACAAB.quest_desc: [
		"&6更&r坚固的飞机意味着更安全的旅程。船体加固能将飞机的耐久度翻倍，使其在充满挑战的飞行中更&b能抗&r受损伤。"
		""
		"Reinforce the hull and gi&bve&r your aircraft the durability it needs to withstand whatever the skies throw at it."
	]
	quest.1B9B5991EA5ACAAB.quest_subtitle: "强化你的飞行器，在颠簸的飞行中生存下来。"
	quest.1B9BE01D79119189.quest_subtitle: "更多盔甲 (More Armor)"
	quest.1BA82AB0BCEA7D8F.quest_desc: ["在《创造：梦想与欲望》中，&6反向齿轮&r能让你更好地控制&b旋转&r动力。使用它来&b改变&r机械装置中旋转的方向，打造更&b灵活&r紧凑的工厂设计。"]
	quest.1BA82AB0BCEA7D8F.quest_subtitle: "将旋转方向反过来"
	quest.1BBD702B010EF944.quest_desc: [
		"&6有时&r，解决&b问题&r的最佳方式是从高空入手。炸弹舱能让你的飞机从空中投下小型TNT&b弹药&r，为你提供处理目标和清理地面目标的新方法。"
		""
		"安装炸弹舱，&b飞&r上天空，准备好你的有效载荷。"
	]
	quest.1BBD702B010EF944.quest_subtitle: "将你的飞行器改装成一架飞行轰炸机。"
	quest.1BC410D696FF7D46.quest_desc: ["&6A&r 适用于仓库和高楼的灯具。右键点击任意&blight&r灯泡即可安装。相邻的灯可以连接，一盏灯可为下方最多16个方块的高度提供15级的光照。"]
	quest.1BC410D696FF7D46.quest_subtitle: "一盏仓库用的灯"
	quest.1BD714B825A03EEC.quest_subtitle: "更多盔甲 (More Armor)"
	quest.1BDB6377CEACF423.quest_desc: ["&6用于连接重型&r线缆的&b接口点&r。"]
	quest.1BDB6377CEACF423.quest_subtitle: "一根粗重的铁丝网桩"
	quest.1BFE7189DCD0345B.quest_desc: ["&aCraft&r a Black Steel Targe from the Cataclysm mod. This &bsturdy&r shield is made using Black Steel and provides &breliable&r protection against &bpowerful&r enemies. It is part of the Black Steel equipment set."]
	quest.1BFE7189DCD0345B.quest_subtitle: "由黑钢锻造而成的盾牌"
	quest.1C00BDA0521E7A74.quest_subtitle: "更多盔甲 (More Armor)"
	quest.1C1110E06AFFCBDB.quest_subtitle: "真美味！"
	quest.1C281BF968E63FE9.quest_subtitle: "真美味！"
	quest.1C48D11547020BCB.quest_desc: [
		"&a植物学家工作台&r能将植物类方块转化为多种装饰性方块。"
		"用它来创造美丽的花园和自然的装饰品。"
	]
	quest.1C48D11547020BCB.quest_subtitle: "塑造自然"
	quest.1C4DB2C1CCA72180.quest_desc: ["&dPaladin&r Sword 是《水晶编年史》中强大的武器，专为 Paladin 装备系列打造。它与 Paladin Armor 的圣魔法&b相关&r，并使用 Divinite 的力量锻造而成。"]
	quest.1C4DB2C1CCA72180.quest_subtitle: "用神圣能量锻造而成的圣剑"
	quest.1C4DBE7D26171AB4.quest_desc: ["&6Craft&r a Basin, one of the core processing blocks in Create. Basins hold items and fluids and are &bused&r together with &bmachines&r such as the Mechanical Mixer and Mechanical Press for Mixing, Packing, and Compacting recipes. They are especially important for advanced Create automation, including the &bproduction&r of Brass."]
	quest.1C4DBE7D26171AB4.quest_subtitle: "创造（Create）处理系统的核心"
	quest.1C524ED3FAF4A6AF.quest_subtitle: "更多盔甲 (More Armor)"
	quest.1C6A7425F0A77464.quest_desc: [
		"&a恭喜！&r"
		"你已经完成了教程标签页中的所有任务！"
		"现在你已经了解了整合包的基础知识、机制、任务和所有实用功能。"
		"你可以自信地运用所学知识，继续前进探索世界。"
		"请记住，如果你想重温技巧，随时可以返回教程。"
	]
	quest.1C6A7425F0A77464.quest_subtitle: "请先阅读此内容！"
	quest.1C6A7425F0A77464.title: "&a完成"
	quest.1C7BA20EE982F192.quest_desc: ["&6通过动能输入来切换&r &b电力&r，这样你就可以用Create机器来控制它了。"]
	quest.1C7BA20EE982F192.quest_subtitle: "一个机械开关"
	quest.1C86202A43DC49D0.quest_subtitle: "真美味！"
	quest.1C949DCB8C31C404.quest_desc: ["&6The&r Hydraulic Press brings powerful hydraulic &bprocessing&r to your factory. Use it to compact and process materials in ways &bbeyond&r the standard Create machinery. Build the press and &bunlock&r a new method of industrial processing."]
	quest.1C949DCB8C31C404.quest_subtitle: "粉碎、压实和加工"
	quest.1C9859ACCF9D8E58.quest_desc: ["制作&6史莱姆蛋糕&r，这是 Create: Misc \& Things 模组里的一种趣味食物。它取代了该模组之前的史莱姆粥，为你的工厂提供了一种颇为特别的甜点来&b生产&r和享用。"]
	quest.1C9859ACCF9D8E58.quest_subtitle: "一个带有粘性惊喜的蛋糕"
	quest.1CB99ED122C09615.quest_desc: [
		"&aDeep&r within the Nether, a terrifying creation of fire and metal awaits. The Netherite Monstrosity is a colossal being, born from ancient power and destruction. Its immense strength and devastating attacks&b make&r it one of the most dangerous foes you will ever face."
		""
		"&a准备好&r最坚固的盔甲、最强大的武器和充足的资源，再去挑战这只巨兽。只有最技艺高超的勇士才能击败它，赢得胜利。"
	]
	quest.1CB99ED122C09615.quest_subtitle: "击败下界的巨人"
	quest.1CB99ED122C09615.title: "&l&c下界合金 &6怪&e物"
	quest.1CC1AAF97A5660CE.quest_desc: ["&6Prepare&r a Pumpkin Milkshake and fill a bucket with it. Add this seasonal treat to your &bcollection&r of milkshakes and bring a little autumn flavor to your factory."]
	quest.1CC1AAF97A5660CE.quest_subtitle: "每一口都蕴含着秋日的风味"
	quest.1CDFDF05ED708612.quest_desc: [
		"&dAbyssal&r Crystal Shard is a rare upgrade material from Crystal Chronicles. It is used to &bupgrade&r the Shadow Walker Armor from Iron’s Spells ’n Spellbooks into the powerful Voidwalker Armor set."
		""
		"The shard &bchannels&r the power of the Abyss, infusing the original Shadow Walker equipment with dark crystalline energy. It is also used in the &bcreation&r of Void Ripper and Void's Grasp, weapons associated with the &benhanced&r Voidwalker equipment."
	]
	quest.1CDFDF05ED708612.quest_subtitle: "用于强化暗影行者装备的黑暗水晶碎片"
	quest.1CEB242A4864FFF7.quest_desc: [
		"&d恶意法典&r是一本来自Cataclysm: Spellbooks的强力冰系魔典。它能提供&b12个&r法术位、&b+30%&r冰系法术强度和&b+300点&r最大法力值。"
		""
		"这本邪恶的魔典专为&b施法者&r打造，旨在将冰魔法的破坏潜力发挥到极致。"
	]
	quest.1CEB242A4864FFF7.quest_subtitle: "释放无情的霜冻之力，让它肆虐吧"
	quest.1CF8EA752412335C.quest_desc: [
		"&dPyrium&r Staff 是 Iron's Spells 'n Spellbooks 中强大的火焰法杖。主手持有时，可提供 &b9&r 攻击力、&b1.5&r 攻击速度、&b+15%&r 火焰法术强度、&b+10%&r 施法速度降低和 &b+5%&r 法术强度。"
		""
		"它由 2 个 Pyrium Ingot、1 个 Arcane Cloth 和 1 个 Netherite Ingot &b合成&r而成。"
	]
	quest.1CF8EA752412335C.quest_subtitle: "挥舞着炽热的 Pyrium 之力"
	quest.1D0B0A6FA4D976C9.quest_desc: [
		"&6Combine&r the industrial strength of Locometal with the distinctive look of copper. Copper Wrapped Locometal adds a refined metallic finish to your railway builds, making it perfect for locomotives, train cars and &bdetailed&r industrial structures."
		""
		"&b赋予&r你的列车一抹铜色，使其设计脱颖而出。"
	]
	quest.1D0B0A6FA4D976C9.quest_subtitle: "一个包裹着抛光铜的粗犷金属框架。"
	quest.1D15663F0B922976.quest_desc: ["&6The&r Reactor Glass is a transparent structural &bcomponent&r used when building a reactor in Create: New Age. It lets you keep the reactor &bvisible&r while maintaining the structure needed for &badvanced&r nuclear power generation."]
	quest.1D15663F0B922976.quest_subtitle: "密切关注核心装置的情况"
	quest.1D229A418DC6618C.quest_desc: [
		"&dEpic&r Ink is the fourth tier of magical ink in Iron's Spells 'n Spellbooks. It is used in the Scroll Forge to create &bEpic-rarity&r spell scrolls and for &bupgrading&r spells that require Epic Ink."
		""
		"这种稀有的魔法物质可以在魔法建筑中找到，或者从强大的魔法生物&b获取&r。"
	]
	quest.1D229A418DC6618C.quest_subtitle: "真正强大魔法的精髓所在"
	quest.1D229A418DC6618C.title: "&dEpic Ink"
	quest.1D34976E848CAAE7.quest_desc: [
		"&a获取&r下界合金升级锻造模板，原版模板也被多个后期 Better End 配方所必需。"
		""
		"锻造该模组最强大的工具和武器时，需要与&bAeternium&r材料一同使用。"
	]
	quest.1D34976E848CAAE7.quest_subtitle: "一个熟悉的模板，被重复使用了"
	quest.1D35D45AC3394DE1.quest_desc: ["&6欢迎来到&r《创造：加料版》！这个 Create 扩展包为你的世界增添了九种坚果、新树木、植物、食物、装饰方块和&b更多&r加工可能性。探索世界，收集材料，从简单的坚果到具有&b独特&r效果的先进哈代安变种，实现自动化生产。"]
	quest.1D35D45AC3394DE1.quest_subtitle: "坚果与新食材的饕餮盛宴"
	quest.1D35D45AC3394DE1.title: "&l&6欢迎来到创造与装饰整合包"
	quest.1D5790D49EC30F25.quest_subtitle: "更多盔甲 (More Armor)"
	quest.1D681F9FB5C22548.quest_desc: ["从Cataclysm模组中获取&aSoul Render&r。这把&b强大的&rCursium&b武器&r是终局武器库的一部分，&b使用&r特殊的灵魂系攻击来打击敌人。掌握这把武器，释放其&b毁灭性&r的能力。"]
	quest.1D681F9FB5C22548.quest_subtitle: "一把被诅咒的亡魂之刃"
	quest.1D681F9FB5C22548.title: "&bSoul Render"
	quest.1D6D7790CF362359.quest_desc: [
		"Amaramber 镰刀是永恒星光中于 0.4.2 版本推出的 Amaramber &b装备&r套装的&a收割&r工具。"
		""
		"&a它&r用于在星光维度高效采集植物和&b植被&r。"
	]
	quest.1D6D7790CF362359.quest_subtitle: "采集琥珀的工具"
	quest.1D70602283A47145.quest_desc: ["&aCraft&r Cursium Boots from the Cataclysm mod. These &bpowerful&r boots are created by &bupgrading&r Netherite Boots with a Cursium Upgrade Smithing Template and a Cursium Ingot in a Smithing Table. They are &bpart&r of the Cursium armor set and grant the Ghostly &bWeightless&r ability, reducing fall damage and allowing a quick backdash ability."]
	quest.1D70602283A47145.quest_subtitle: "如深渊的幽灵般移动"
	quest.1D70C8CD5B8C7C41.quest_desc: [
		"&dNature&r 升级球是 Iron's Spells 'n Spellbooks 中的一种升级材料。在 Arcane Anvil 上使用后，可获得 &b+5%&r 自然法术强度。"
		""
		"它由 1 个空升级球和 8 个自然符文&b合成&r而成。"
	]
	quest.1D70C8CD5B8C7C41.quest_subtitle: "用自然魔法的力量来强化你的装备"
	quest.1D7DA6D04AF37CF3.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.1D84A1C6F75DDDA0.quest_desc: ["&6欢迎来到&r创造：梦想与渴望！此附加包汇集了&b一系列&r新功能、实用补充和创意，&b灵感&r源自新老版本的创造。探索新材料、方块、配方和机制，以意想不到的方式扩展你的工厂。"]
	quest.1D84A1C6F75DDDA0.quest_subtitle: "重新发现那些被遗忘的创造物"
	quest.1D84A1C6F75DDDA0.title: "&l&6欢迎来到创造梦想与欲望"
	quest.1D9564F2B67A4492.quest_desc: ["&6从Create模组中获取&r一个水轮。当水流经它时，水轮会产生&b旋转&r动力，使其成为Create早期最简单的自动动力源之一。标准水轮可产生&b8&r RPM和&b256&r SU的应力容量。"]
	quest.1D9564F2B67A4492.quest_subtitle: "驾驭流动的水所蕴含的力量"
	quest.1D971010A5D83B2A.quest_desc: [
		"&d龙皮魔法书&r是一本传奇的魔法书，专为末地魔法而设。它提供&b12&r个法术位、&b+10%&r末地法术强度和&b+200&r最大法力值，是专精末地魔法的施法者&b绝佳&r选择。"
		""
		"用末影龙&b掉落&r的龙皮制作这本强大的魔典，解锁末影法术的全部潜力。"
	]
	quest.1D971010A5D83B2A.quest_subtitle: "掌握末地的神秘力量"
	quest.1DACD5972C6D4323.quest_subtitle: "升级+"
	quest.1DB6458252560C0D.quest_desc: [
		"&aCraft&r the Yeti Jacket &busing&r the thick fur of the Alpha Yeti. Woven from one of the warmest materials in the Twilight Forest, this sturdy &bchestpiece&r provides exceptional protection while shielding its wearer from the &brelentless&r cold of the Glacier."
		""
		"&aAs&r the centerpiece of the Yeti Armor set, the jacket &bsymbolizes&r your victory over the Alpha Yeti and your ability to survive the harshest frozen environments. Its &benchanted&r fur retains heat &beven&r in the coldest climates, preparing you for the final trials that lie ahead."
	]
	quest.1DB6458252560C0D.quest_subtitle: "被冰川的温暖所包裹的舒适感"
	quest.1DBE2B6695831DFF.quest_desc: ["&dEvoker's&r Twinblade is a weapon from Crystal Chronicles, associated with the Battle-Evoker equipment set. It channels the power of Evocation magic and &bcomplements&r the enhanced Archevoker &bequipment&r upgraded with Avaricite."]
	quest.1DBE2B6695831DFF.quest_subtitle: "注入了 Evocation 力量的双刃武器"
	quest.1DC2B930AF7DC2DC.quest_desc: ["&6Turns&r the panels toward the sun and collects their output on its terminals. Place panels in front of the bearing and click to assemble. On its side you choose the layout: strings in &bparallel&r and panels per string (max 25 per string). More panels per string gives more &bvoltage&r, more strings gives more current."]
	quest.1DC2B930AF7DC2DC.quest_subtitle: "追踪太阳的位置"
	quest.1DC970C582A4E7FB.quest_desc: [
		"&a在普通世界&r之外，存在着一个未被时间侵蚀的&b远古&r维度——暮色森林。这片被永恒暮光笼罩、遍布巨大森林、被遗忘的遗迹和强大生物的土地，充满了等待被发掘的&b秘密&r。"
		""
		"&aTo&r begin the journey, a magical portal must be created using nature itself. Once activated, it opens the path &bto&r one of the greatest &aadventure&r dimensions ever discovered."
	]
	quest.1DC970C582A4E7FB.quest_subtitle: "通往永恒黄昏的传送门"
	quest.1DC970C582A4E7FB.title: "&l&6暮色森林&r"
	quest.1DCE04DB6C0EEF46.quest_desc: [
		"使用&a锻造自哥布林堡垒传奇合金的&r精炼骑士金属锭来&b制作&r骑士金属头盔。这顶头盔曾是堡垒无畏守护者的战利品，旨在&b经受住&r无数战役的考验，同时&b保护&r佩戴者免受最猛烈攻击的侵袭。"
		""
		"&aAs&r part of the Knightmetal Armor set, the helmet &brepresents&r the resilience and discipline of the ancient knights. Its reinforced &bconstruction&r and masterful craftsmanship make it an essential piece of equipment for any adventurer preparing to face the greatest dangers &bhidden&r within the Twilight Forest."
	]
	quest.1DCE04DB6C0EEF46.quest_subtitle: "一位远古守护者的凝视"
	quest.1DD6531D84052AB9.quest_desc: [
		"永恒头盔需要在锻造台用&a永恒&r锻造板升级泰米尼特头盔来制作。"
		""
		"作为 Better End 的顶级盔甲，它提供了模组中最好的&b防护&r，甚至超过了下界合金。"
	]
	quest.1DD6531D84052AB9.quest_subtitle: "最高阶的头盔装备"
	quest.1DD72F4EDD4851D7.quest_desc: ["&a击败&r 5 名守卫者。这些水下敌对生物&b保护&r着海洋神殿，并用激光束攻击&b入侵者&r。它们会掉落棱镜岩碎片、棱镜晶和生鱼。"]
	quest.1DD72F4EDD4851D7.quest_subtitle: "保卫海洋纪念碑"
	quest.1DD72F4EDD4851D7.title: "击杀守卫者"
	quest.1DD88B8F1770755D.title: "你没有足够的心理承受能力"
	quest.1DF07E95DDAC558B.quest_desc: ["&a获得&r Excelsius Velocity 胸甲、Excelsius Adversary 胸甲和 Excelsius Oppressor 胸甲。集齐这三种&b特殊&r胸甲，并&b完成&r Excelius 武器库的下一部分。"]
	quest.1DF07E95DDAC558B.quest_subtitle: "三种盔甲，一条通往力量的道路"
	quest.1DF1409120127162.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.1E0701BC18C2B6AD.quest_desc: ["&aFind&r the Amethyst Nest hidden within the Overworld. &bDeep&r inside lies the lair of the Amethyst Crab, a dangerous creature &bsurrounded&r by the power of amethyst. Locate its nest and prepare yourself &bfor&r the fight that awaits within."]
	quest.1E0701BC18C2B6AD.quest_subtitle: "进入水晶巨兽的巢穴中"
	quest.1E0701BC18C2B6AD.title: "&l&d紫水晶巢穴"
	quest.1E0E8DFD39A68077.quest_desc: [
		"Thallasium Forged Plate 需要用 Smith Hammer 在 Anvil 上，用 Thallasium Ingot 来制作。"
		""
		"在锻造台合成，用于组装一套完整的&aThallasium&r盔甲。"
	]
	quest.1E0E8DFD39A68077.quest_subtitle: "为塔拉西姆盔甲进行镀层处理"
	quest.1E139593EB6DB93A.quest_desc: ["使用Cataclysm模组的材料，&a制作&rIgnitium靴子。这双靴子由&b传奇的&rIgnitium金属锻造而成，能提供卓越的防护，让穿戴者能够承受下界的危险。它们是强大的Ignitium盔甲套装的一部分，该套装由&b火焰领主&r的残骸&b打造&r而成。"]
	quest.1E139593EB6DB93A.quest_subtitle: "穿过火焰，安然无恙地前行"
	quest.1E1AD9C05DD1A094.quest_desc: [
		"&dPyromancer&r Chestplate 是 Crystal Chronicles 对 Iron’s Spells ’n Spellbooks 中 Pyromancer Chestplate 的升级版。"
		""
		"使用&b火山岩碎片&r进行升级，可为原有的火魔法师盔甲增添额外的晶体力量。火山岩碎片&b用于&r将铁匠铺的魔法与魔典火魔法师盔甲套装升级为水晶编年史版本。"
	]
	quest.1E1AD9C05DD1A094.quest_subtitle: "An enhanced Pyromancer chestplate empowered by Volcanite"
	quest.1E1BCEA796C71DF8.quest_desc: ["&6经验&r镐是 Create Stuff 'N Additions 模组中的一种特殊镐。挖掘方块时有几率&b生成&r经验球，让你在工作时获得额外经验。它有 270 点耐久度，需要铁镐挖掘，攻击力为 5，攻速为 2.0。使用 3 堆&b经验&r和 2 个锌制工具柄合成。"]
	quest.1E1BCEA796C71DF8.quest_subtitle: "挖矿获取更多经验值"
	quest.1E209817FAB1FB06.quest_subtitle: "更多盔甲 (More Armor)"
	quest.1E4B6AF851790D25.quest_desc: [
		"&a星焰锄头&r是永恒星光中的农具，属于星焰&b装备&r系列。"
		""
		"&a它&r被&b用&r来耕地，是模组中后期推出的星辉工具套装的一部分。"
	]
	quest.1E4B6AF851790D25.quest_subtitle: "星光采集工具"
	quest.1E6008069991B063.quest_desc: ["&d提升&r你枪械的&b换弹&r速度，让你更少地空仓待命。"]
	quest.1E6008069991B063.quest_subtitle: "操作流畅，行云流水"
	quest.1E692E7FDC4BC436.quest_desc: ["&6The&r Mechanical Saw is a powerful cutting tool that uses rotational power to &bprocess&r materials and cut blocks. &bIt&r can perform many cutting recipes, including turning logs into planks and &bprocessing&r other materials. When attached to a moving Contraption, the saw can destroy suitable blocks and damage entities depending on the Contraption's speed, making it useful for automated &btree&r farms and other harvesting machines."]
	quest.1E692E7FDC4BC436.quest_subtitle: "斩断你前进道路上的一切障碍"
	quest.1E7200DC136FD7C4.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.1E916C61E5DE6AD3.title: ",,,"
	quest.1E91AFA0368460D9.quest_desc: [
		"&l&9背包都能熔炼矿石了，&r&r何必停下熔炼呢？熔炼升级模组将熔炉直接添加到背包中，让你无需在世界上放置熔炉即可熔炼物品。但它仍然&b需要&r你自行提供燃料并管理输入和输出。"
		""
		"升级到 &b自动熔炼&r 升级，让你的背包自动处理一切。它会从背包中取出合适的物品和燃料，并将成品 &b送&r 回储存处。"
	]
	quest.1E91AFA0368460D9.quest_subtitle: "将你的背包变成一个熔炉"
	quest.1E91AFA0368460D9.title: "冶炼 & 自动冶炼升级"
	quest.1E94908B4E9FBA01.quest_desc: ["&6让&r &b电流&r只朝一个方向流动，从而保护电路免受反向电流的损害。"]
	quest.1E94908B4E9FBA01.quest_subtitle: "二极管"
	quest.1EDD9DE31C9F29FE.quest_desc: ["&d一种&r特殊的护身符，&b能为&r佩戴者提供强大的加成。"]
	quest.1EDD9DE31C9F29FE.quest_subtitle: "来自议会的尊贵护身符"
	quest.1EEB30E456BBFD09.quest_desc: ["&a获取&r Ceraunus，来自 L_Ender’s Cataclysm 中 Acropolis 武器库的强大武器。Ceraunus 是一个巨大的锚，&b16&r 点攻击力，可投掷向敌人。潜行时，它会&b释放&r扇形波。使用 2 个 Essence of the Storm 和 3 个 Lacrima 合成。"]
	quest.1EEB30E456BBFD09.quest_subtitle: "挥舞风暴的怒火，释放雷霆万钧的力量"
	quest.1EEB30E456BBFD09.title: "&b塞拉乌努斯"
	quest.1EF8C927AACD9472.quest_subtitle: "升级+"
	quest.1EFFE16C3E85DBCC.quest_desc: [
		"&9&lGive&r&r your storage the power of a blast furnace with the Blasting Upgrade. It allows compatible items to be processed &busing&r blast furnace recipes directly from your storage."
		""
		"&bUpgrade&r it further with the Auto-Blasting Upgrade to automate the entire process. Your storage can handle the input, fuel and finished &bproducts&r automatically, making large-scale processing faster and more convenient."
	]
	quest.1EFFE16C3E85DBCC.quest_subtitle: "以惊人的速度处理材料"
	quest.1EFFE16C3E85DBCC.title: "爆破 & 自动爆破升级"
	quest.1F010A331D33EB74.quest_desc: ["制作&6Diapason管&r，为你的乐器增添管风琴特有的音色。Diapason能发出强劲、&b富有特色&r的管风琴音，是Create: Sound of Steam中核心的管风琴音栓之一。"]
	quest.1F010A331D33EB74.quest_subtitle: "让你的器官发出经典的声音"
	quest.1F2444EB90AF2586.quest_desc: [
		"&a星光钻石胸甲&r是永恒星光系列的高级护甲，使用&b星光钻石&r制作而成。"
		""
		"星光钻石盔甲 &a提供&r与下界合金相当的防护，同时大幅提升盔甲的&b韧性&r和击退抗性。"
	]
	quest.1F2444EB90AF2586.quest_subtitle: "天体钻石制身体护甲"
	quest.1F3816FACF9A8217.quest_desc: ["&dThe&r Heavy Chain is a necklace from Iron's Spells 'n Spellbooks that grants &b+15%&r Spell Resistance when equipped. Strengthen your defenses &bagainst&r hostile magic and become harder to &boverwhelm&r with enemy spells."]
	quest.1F3816FACF9A8217.quest_subtitle: "坚定地抵抗魔法攻击"
	quest.1F5166D0102CAFC4.quest_desc: ["从 Create 中获得&6纸板护腿&r。它们是纸板盔甲套装的一部分，提供 &b1&r 点护甲值，耐久度为 60。穿戴&b完整&r套装并潜行时，你会伪装成一个纸板包裹，缩短敌对生物能&b侦测&r到你的距离。"]
	quest.1F5166D0102CAFC4.quest_subtitle: "完成纸板伪装任务"
	quest.1F5A077DC4F4FB7D.quest_subtitle: "更多盔甲 (More Armor)"
	quest.1F6A03365EB7328B.quest_desc: [
		"&d秘银&r废料是《Iron's Spells 'n Spellbooks》中的一种稀有合成材料。通过爆破原矿秘银获得，&b用于&r制作秘银锭和其他&b强大的&r秘银装备。"
		""
		"秘银废料是秘银进阶的重要一步，能打造出模组中一些最强的魔法&b装备&r。"
	]
	quest.1F6A03365EB7328B.quest_subtitle: "传奇秘银的精致碎片"
	quest.1FA0021D2BBC3A9B.quest_desc: ["&6从Create模组中获取&r速度表和应力表。速度表测量动能系统的转速（单位：&bRPM&r），而应力表测量系统的&b动能应力&r和可用应力容量。它们能帮助你监控机器是否以合适的速度运行，以及网络是否接近&b进入&r过载状态。"]
	quest.1FA0021D2BBC3A9B.quest_subtitle: "测量你机器的强大之处"
	quest.1FA0021D2BBC3A9B.title: "速度/压力计"
	quest.1FA0CDB67BA1996F.quest_desc: ["从 Create 模组中获取&6安山岩漏斗&r。它是一种基础的物品运输&b组件&r，用于在物品栏、储料箱和机械传送带之间移动&b物品&r。可以用扳手调整&b它的&r方向，因此对于控制工厂内的物品流动非常&b有用&r。"]
	quest.1FA0CDB67BA1996F.quest_subtitle: "保持物品的持续移动状态"
	quest.1FA13272B5A06A5F.quest_subtitle: "更多盔甲 (More Armor)"
	quest.1FA2DCC92F14D525.quest_subtitle: "升级+"
	quest.1FAF3113F25BC7C2.quest_desc: [
		"&aFlowglaze 镰刀&r是永恒星光中的近战武器，属于 Flowglaze &b装备&r系列。"
		""
		"&a它&r专为横扫攻击和增强近战范围而设计，是中后期&b武器&r进阶的一部分。"
	]
	quest.1FAF3113F25BC7C2.quest_subtitle: "收割流动之力的武器"
	quest.1FBF1655BB9244A9.quest_subtitle: "升级+"
	quest.1FCF06D2175FE302.title: "没问题"
	quest.1FFF06B304141346.title: "兄弟，我有个任务要交给你。"
	quest.20168D86B69961B4.quest_desc: [
		"&dCryomancer&r靴子是Crystal Chronicles中&b升级&r自Iron’s Spells ’n Spellbooks的Cryomancer靴子。"
		""
		"使用 Cryolite Shard 进行升级，它能&b增强&r原有的 Cryomancer Armor 套装，赋予其&b额外的&r结晶之力。Cryolite Shard 用冰魔法的力量强化装备，&b创造&r出原版 Cryomancer 装备的改进版。"
	]
	quest.20168D86B69961B4.quest_subtitle: "一种由 Cryolite 强化的 Cryomancer Boots 增强版"
	quest.2018043C0CE539B3.quest_desc: ["使用Cataclysm模组的材料，&a制作&r一把黑钢剑。这把&b强力&r武器由&b使用&r黑钢制成，专为重创危险敌人而设计。它是黑钢&b装备&r套装的一部分。"]
	quest.2018043C0CE539B3.quest_subtitle: "由黑钢锻造而成的刀刃"
	quest.202D0805BE78404E.quest_desc: ["&6从Create中获取&r一个烈焰蛋糕。它&b用于&r将烈焰燃烧器暂时转变为超高温状态，从而能够执行最复杂的熔炉配方。烈焰蛋糕是用漏斗将&b250&r mB的岩浆填充到烈焰蛋糕底座中制成的。烈焰蛋糕底座是通过压实鸡蛋、糖和灰烬面粉来&b制作&r的。"]
	quest.202D0805BE78404E.quest_subtitle: "为超高温加热提供燃料"
	quest.2034876CE576F3FE.quest_subtitle: "更多盔甲 (More Armor)"
	quest.2045C43F8B6916CB.quest_desc: [
		"&aCraft&r the Yeti Leggings &busing&r the thick fur of the Alpha Yeti. Woven from one of the warmest materials found in the Twilight Forest, these leggings offer &bexceptional&r protection while shielding their &bwearer&r from the relentless cold of the Glacier."
		""
		"&aAs&r an essential part of the Yeti Armor set, they provide the durability needed to survive the frozen &bwilderness&r and face the powerful creatures that dwell within it. Their enchanted fur preserves warmth even in the &bharshest&r conditions, ensuring you're always ready for the next challenge."
	]
	quest.2045C43F8B6916CB.quest_subtitle: "忍受无尽的严冬"
	quest.2065BE744E37E2A4.quest_desc: ["&6Craft&r a Ruby Chocolate Glazed Marshmallow by coating a soft marshmallow with Ruby Chocolate. It is one of the chocolate-glazed marshmallow variants &badded&r by Create: Confectionery, alongside dark and white chocolate versions."]
	quest.2065BE744E37E2A4.quest_subtitle: "裹着水果红宝石的蓬松小点心"
	quest.209857F6F9627A0E.quest_desc: ["&6从Create模组中获取&r一个阈值开关。它能监测&b物品栏&r或流体容器中的填充程度，并在达到可配置的阈值时发出红石信号。它还支持过滤，&b让你&r只监测特定物品。这使得它在存储&b达到&r指定水平时自动启停机器方面非常有用。"]
	quest.209857F6F9627A0E.quest_subtitle: "通过限制来控制你的工厂"
	quest.209C02664C1D975B.quest_desc: ["&6从Create模组中获取&r一个旋转速度控制器。它能提供&b精确&r的旋转速度和方向控制。当与&b大型齿轮&r搭配使用时，它可以输出高达&b256&r RPM的任意方向旋转速度，非常适合需要特定运行速度的机器。"]
	quest.209C02664C1D975B.quest_subtitle: "精确控制旋转角度"
	quest.20BB591B2BF2A6DD.quest_desc: ["&6从Create模组中获取&r流体管道。流体管道用于在储罐、机器和其他流体处理组件之间运输液体。 &b它们&r一次只能输送一种流体，而机械泵则提供推动流体在管网中流动&b所需的&r动力。管道也可以用扳手改装为带窗流体管道，以便&b观察&r内部流动的流体。"]
	quest.20BB591B2BF2A6DD.quest_subtitle: "你流体网络的生命线所在之处"
	quest.20BB591B2BF2A6DD.title: "流体管道"
	quest.20C6B1D1C1D8708D.quest_desc: [
		"&e任务&r是完成一个任务所需执行的动作。"
		"如果任务涉及物品，点击该物品会显示其配方。"
		"完成所有任务后，即可领取&c奖励&r——只需点击即可收集。"
		"右上角的图钉图标可将&6任务&r固定到您的屏幕上。"
	]
	quest.20C6B1D1C1D8708D.quest_subtitle: "请先阅读此内容！"
	quest.20C6B1D1C1D8708D.title: "&6FTB 任务书"
	quest.20CF892CE03107AB.quest_subtitle: "更多盔甲 (More Armor)"
	quest.20D12EB2551F7E26.quest_desc: ["&a从Cataclysm: Spellbooks模组中获取&r Hellfire Forge。这件&b传奇&r的魔法武器能驾驭&b毁灭性&r的炼狱之火，让持有者释放出由下界火焰驱动的&b毁灭性&r攻击。它与该模组的其他毕业武器一同作为最新遗物推出。"]
	quest.20D12EB2551F7E26.quest_subtitle: "用来自地狱的火焰锻造熔炉"
	quest.20D12EB2551F7E26.title: "&6地狱之火&c锻造炉"
	quest.20E897D283D7016D.title: "村民 PRO"
	quest.20F65C0D555D07F0.quest_desc: ["&6准备&r一杯顺滑的香草奶昔，为你的工厂食品生产线再添一杯&b经典&r饮品。将所需材料组合起来，让 Create: Dreams n' Desires &b负责&r混合工作。"]
	quest.20F65C0D555D07F0.quest_subtitle: "历久弥新的风味，新鲜调制"
	quest.20F767F224E2990E.quest_desc: [
		"&a阿玛兰伯面具&r是永恒星光中的一个盔甲部件，使用阿玛兰伯&b材料&r制作而成。"
		""
		"&a它是&r阿玛兰伯装备&b进阶&r的一部分，用作防护头盔。"
	]
	quest.20F767F224E2990E.quest_subtitle: "琥珀锻造的头盔装备"
	quest.212129109C5F6E52.quest_desc: ["从Aquaculture 2中获取&a鱼线&r。此组件在制作和升级鱼竿时&b使用&r。将其与其他渔具部件结合，可打造出&b更强大&r、更先进的渔具。"]
	quest.212129109C5F6E52.quest_subtitle: "必备的钓鱼装备"
	quest.2144EF088C0E18C0.quest_desc: [
		"在地下深处，你可能会发现被称为试炼之室的神秘结构。"
		"在这些危险的走廊里，强大的生物会从特殊的试炼生成器中诞生。"
		""
		"如果你成功通过挑战，将获得一把试炼钥匙。"
		"这些钥匙可用于开启密室内的特殊宝库，并领取贵重奖励。"
		""
		"击败敌人，完成试炼，并收集一把&a试炼钥匙&r。"
	]
	quest.2144EF088C0E18C0.quest_subtitle: "密室中的奖励"
	quest.2144EF088C0E18C0.title: "试炼钥匙"
	quest.215D6E89BAFD51E5.quest_desc: ["&6Prismarine&r Shards are an important resource in Create: Aquatic Ambitions. With Conduit Channeling, you can &bobtain&r Prismarine Shards from Flint, giving you a renewable way to produce Prismarine &bwithout&r relying on Guardians. This is one of the first &bsteps&r toward fully automating aquatic resources."]
	quest.215D6E89BAFD51E5.quest_subtitle: "利用海洋的丰富资源"
	quest.215D8172E77FB95D.quest_desc: ["&6Create&r the three essential spool types from Create Crafts \\& Additions: Empty Spool, Copper Spool and Gold Spool. The Empty Spool is the base component &bused&r to create wired spools. Copper and Gold Spools can connect Connectors and transfer electrical energy between them. Copper Spools use &b4&r Copper Wires, while Gold Spools use &b4&r Gold Wires."]
	quest.215D8172E77FB95D.quest_subtitle: "连接你的电气网络"
	quest.2162C4558E290071.quest_desc: ["&6The&r Electric Motor is the counterpart to the Alternator in Create Crafts \\& Additions. It converts Forge Energy &b(FE)&r into rotational power, allowing electricity to &bdrive&r Create machinery. The motor can be configured to different RPM values, with higher speeds requiring more FE. It can generate up to &b2048&r SU of rotational force."]
	quest.2162C4558E290071.quest_subtitle: "将电能转化为动能"
	quest.218293AC8BB043AD.quest_desc: ["&6从Create模组中获取&r一个铜制背囊。它能储存压缩空气，通过向背囊顶部的轴施加&b旋转&r力来&b填充&r。与潜水头盔一同穿戴时，能在水下提供水下呼吸效果。当背囊中有空气时，它还能&b为&rExtendo Grip和土豆炮&b提供&r动力，而不会消耗它们的耐久度。"]
	quest.218293AC8BB043AD.quest_subtitle: "用高压空气充满你的肺部"
	quest.219496E39E637D9B.quest_subtitle: "真美味！"
	quest.21AF2B7914DD5F83.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.21C32068BFCE19E5.quest_desc: [
		"永恒星光中的托雷亚森林的&a树木&r会产出一种名为托雷亚原木的独特木材。"
		"This material carries the essence of the ancient forest and can be &bused&r for crafting and building within the dimension."
		""
		"收集它标志着你在&a探索&r和利用此生物群系资源的进度。"
	]
	quest.21C32068BFCE19E5.quest_subtitle: "远古木材"
	quest.21C32068BFCE19E5.title: "托雷亚木材"
	quest.21E3EE5B89C198E0.title: "他？"
	quest.21F0D3F2645EFD91.quest_desc: ["&6用于伐木的&r锯子。由便携式电池供电，不消耗耐久度，只消耗能量。拥有足够的&b能量&r后，按 Shift 可一次性收割整棵树。集成的电路可使其在有限次数内获得&b性能提升&r。"]
	quest.21F0D3F2645EFD91.quest_subtitle: "一把手持式锯子"
	quest.21F652F622125F5F.quest_desc: ["&aCraft&r the Cursium Mage Greaves from the Cataclysm: Spellbooks addon. Forged from the cursed power of Cursium, these &benchanted&r greaves are an essential part of the Cursium Mage armor set, empowering their wearer with the dark magic once wielded by the &brulers&r of the &bAncient&r Factory."]
	quest.21F652F622125F5F.quest_subtitle: "驾驭禁忌魔法的力量，大步前行"
	quest.21F96D90B841A6C5.quest_desc: ["&a从Aquaculture 2中获取&r一个箱子。这些&b容器&r可以作为钓鱼战利品获得，可能包含各种贵重物品。打开它们，看看里面&b隐藏着&r什么&b宝藏&r。"]
	quest.21F96D90B841A6C5.quest_subtitle: "一个神秘的钓鱼奖励"
	quest.21FB3B9C98364B40.title: "yyy 好的"
	quest.221C62C2D659A065.quest_desc: [
		"&dPyrium&r Ingot 是 Iron's Spells 'n Spellbooks 中一种稀有的合成材料。可在 Citadel Vaults 中找到。它被&b用来&r合成 Pyrium Staff 等强力物品，以及将 Decrepit Scythe &b升级&r为 Hellrazor，Decrepit Flamberge 升级为 Legionnaire Flamberge。"
		""
		"Pyrium 锭也可以通过爆破产生 5 个 Ancient Debris，使其成为宝贵的&b后期&r资源。"
	]
	quest.221C62C2D659A065.quest_subtitle: "夺取堡垒中的炽热金属"
	quest.2220A3339D628B97.quest_desc: ["&6A&r 用于更强发电机的大型转子版本。"]
	quest.2220A3339D628B97.quest_subtitle: "一个更大的转子"
	quest.22239400DAC93BF3.quest_subtitle: "真美味！"
	quest.222FFF8D4D1510B0.quest_desc: ["&aCraft&r the Bone Reptile Chestplate from the Cataclysm mod. Made from Ancient Metal Ingots and Koboleton Bones, this durable chestplate offers &bexcellent&r protection and knockback resistance, making it a reliable &breward&r for conquering the Cursed Pyramid."]
	quest.222FFF8D4D1510B0.quest_subtitle: "由远古骨骼锻造而成的盔甲"
	quest.223560DA5BB4A890.quest_subtitle: "真美味！"
	quest.224D0A91A04F405B.quest_desc: ["&6使用红石信号来&r &b切换&r电路。必须放置在箭头所示的边缘上。"]
	quest.224D0A91A04F405B.quest_subtitle: "一个由红石驱动的继电器"
	quest.226D2FF47293880B.quest_desc: [
		"&d简易&r机械组件是初级枪械硬件。它们用于火绳枪和散弹枪等早期武器，以及许多&b实用&r配件，如瞄准镜和刺刀。"
		""
		"&dThey&r also lead to the next tier of &bcomponents&r."
	]
	quest.226D2FF47293880B.quest_subtitle: "用于简单机器的微型齿轮"
	quest.227B24AA6CB80442.quest_desc: [
		"&a酿造台&r是酿造药水的主要设备。"
		"你可以将水瓶与下界疣和其他材料结合，创造出能增强战斗、生存和探索能力的强力药水。"
		"有了它，你就能&b解锁&r&aMinecraft中炼金术的全部潜力。&r"
	]
	quest.227B24AA6CB80442.quest_subtitle: "开始你的炼金术之旅吧"
	quest.227B24AA6CB80442.title: "&e酿造台"
	quest.22819151DE1C53E4.quest_desc: ["在平原和森林群系中&6寻找&r并种植白葡萄。从葡萄藤上收获，并用它们作为&b原料&r，使用Create的机器生产白葡萄酒和其他酿酒&b产品&r。"]
	quest.22819151DE1C53E4.quest_subtitle: "开启你的优质葡萄酒之旅"
	quest.229362E5765C8C86.quest_desc: ["&6Obtain&r a Factory Gauge from Create. This advanced logistics component can monitor the stock of items connected to a logistics network and can also be &bconfigured&r to automatically request items &bwhen&r their supply falls below a chosen threshold. Factory Gauges were introduced in Create 6.0 and are crafted &busing&r a Stock Link and a Precision Mechanism."]
	quest.229362E5765C8C86.quest_subtitle: "见证你工厂的脉动所在"
	quest.22A0552643425901.quest_desc: [
		"&a使用&r阿尔法雪怪的厚毛皮和冰冻巨兽的强壮角来制作&b&r雪怪角盔。这顶&b威严的&r头盔体现了冰川统治者的力量与坚韧，在保护佩戴者的同时，&b令任何胆敢与之对抗者&r心生畏惧。"
		""
		"&aAs&r part of the Yeti Armor set, the Horned Helm offers outstanding protection and exceptional resistance to the bitter cold. Its &biconic&r horns serve as a reminder that you have conquered one of the Twilight Forest's most &bformidable&r guardians."
	]
	quest.22A0552643425901.quest_subtitle: "戴上冰冻之王的王冠"
	quest.22BB86C77127CF6D.quest_desc: [
		"&e显然&r，即便是最无畏的冒险者，也有让苦力怕无法忍受的东西。"
		""
		"猫爪拖鞋能让苦力怕&b避开&r你并逃跑，将这些会爆炸的绿色噩梦拒之门外。在 Artifacts 的更新&b版本&r中，它们还能击退幻影。"
		""
		"&b轻步&r前行。让苦力怕逃跑。"
	]
	quest.22BB86C77127CF6D.quest_subtitle: "苦力怕知道不该招惹猫主子们"
	quest.22D172A234AF9AF2.quest_desc: [
		"&9&l通过范围升级，扩大兼容的 Refined Storage 设备的&r&r工作范围。它能增加支持的设备与你的网络&b&r互动的距离，让你在设计布局时有更多&b&r自由。"
		""
		"将其安装在&b兼容&r的设备中，并从更远的地方连接系统的各个部分。"
	]
	quest.22D172A234AF9AF2.quest_subtitle: "扩展你的网络覆盖范围"
	quest.22DEA311E61D3E11.quest_desc: ["制作&a木制工具&r，如斧头、镐和铲子。它们是收集资源、采矿和为未来挑战做准备所必需的。木制工具是你迈向&b高效&r制作和探索的第一步。"]
	quest.22DEA311E61D3E11.quest_subtitle: "用基础工具开启你的冒险之旅"
	quest.22DEA311E61D3E11.title: "&#6A3B1D木制&#A56701工具"
	quest.22E209AA4D7515BA.quest_desc: [
		"当&a黑暗&r笼罩永恒星光之地，夜幕蜘蛛便从阴影中现身。"
		"这些生物速度快、攻击性强，且在能见度最低时发动攻击，因此在探索时尤其危险。"
		""
		"面对它们，将是对你不熟悉的世界中&b战斗&r意识的&a真正&r考验。"
	]
	quest.22E209AA4D7515BA.quest_subtitle: "黑暗中的猎手们"
	quest.22E209AA4D7515BA.title: "夜幕降临的蜘蛛们"
	quest.2309D500FCA63C7C.quest_desc: [
		"黄金能为你的&b工具&r增强特殊属性。"
		"这些&b工具&r并非总是&a最强大&r的，但在某些&b情况下&r能提供速度和独特优势。"
	]
	quest.2309D500FCA63C7C.quest_subtitle: "快速且灵活"
	quest.2309D500FCA63C7C.title: "黄金下界合金工具"
	quest.230EB3AA5E23547E.quest_desc: [
		"Deepsilver Axe 是一款来自 Eternal Starlight 的&a伐木&r和战斗工具，使用&bDeepsilver Ingots&r制作而成。"
		""
		"&a它&r用于沼泽和暮色渐进区域，比铁质工具更耐用，同时保持中前期的&b采矿&r水平。"
	]
	quest.230EB3AA5E23547E.quest_subtitle: "沼泽银木砍伐工具"
	quest.2316B46DBEF1DDF0.quest_desc: [
		"&a月环弓&r是一种远程武器，&b可在&r永恒星光中的诅咒花园内，从月球怪物的首领处获得。"
		""
		"&a它&r是首领掉落物&b池&r的一部分，击败该遭遇战时必定掉落。"
	]
	quest.2316B46DBEF1DDF0.quest_subtitle: "首领奖励武器"
	quest.2316B46DBEF1DDF0.title: "&6月亮环弓"
	quest.2329437E93F1E7F2.quest_desc: [
		"&a锻造&r传奇的Neptunium钓鱼竿，堪称水下工艺的最终杰作。由海洋中隐藏的&b神话&r金属打造而成，这根非凡的鱼竿拥有无与伦比的&b耐用性&r和性能，是垂钓者能拥有的最顶级的鱼竿。"
		""
		"&a唯有&r那些&b发掘过&r海洋中最稀有宝藏的人才能够打造出如此不可思议的工具。手持海王星鱼竿，每一次抛竿都是发现&b传奇&r渔获和潜藏于波涛之下的无价宝藏的又一次机会。"
	]
	quest.2329437E93F1E7F2.quest_subtitle: "统领深海的宝藏，掌控一切"
	quest.232DA339B30AF081.quest_desc: [
		"&a星辉锻造模板&r是永恒星光&b新增&r的一种锻造模板。"
		""
		"&a它&r被&b用&r于锻造台，用于应用星火风格的盔甲修饰，并且在模组更新版本中，某些星火相关武器和装备的合成配方也需要它。"
	]
	quest.232DA339B30AF081.quest_subtitle: "锻造进度物品"
	quest.232DA339B30AF081.title: "&c星火锻造模板"
	quest.233B3916BF0DE57B.quest_desc: [
		"使用击败的娜迦收集到的鳞片，&a制作&r娜迦鳞片护腿。这款护腿兼具敏捷性与防护性，是娜迦鳞片盔甲套装的重要组成部分，能助你应对暮色森林中愈发危险的&b敌人&r。"
		""
		"&a锻造&r自森林远古守护者的遗骸，它们象征着你征服暮色森林之谜的第一&b步&r。"
	]
	quest.233B3916BF0DE57B.quest_subtitle: "由远古鳞片编织而成的防护"
	quest.233D06FBEB8CB016.quest_subtitle: "更多盔甲 (More Armor)"
	quest.235A8D449115DAF7.quest_desc: ["&a获得&r来自Cataclysm模组的Monstrous Helm。由恐怖怪物的&b残骸&r锻造而成，这顶&b传奇&r头盔赋予佩戴者昔日野兽般的坚韧与凶猛。对于那些&b征服&rCataclysm最恐怖存在的人来说，这是一件真正的战利品。"]
	quest.235A8D449115DAF7.quest_subtitle: "佩戴野兽的面具，展现野性一面"
	quest.235A8D449115DAF7.title: "&c怪物头盔"
	quest.236DC13478565F28.quest_desc: ["&a击败&r L_Ender’s Cataclysm 中的 3 只 The Prowlers。这些致命的&b生物&r是 Cataclysm 添加的&b危险&r敌人之一。追踪它们，证明你能在这场狩猎中生存下来。"]
	quest.236DC13478565F28.quest_subtitle: "在阴影之下狩猎那头野兽"
	quest.236DC13478565F28.title: "潜行者 (The Prowler)"
	quest.23769B7230C8FD71.quest_subtitle: "更多盔甲 (More Armor)"
	quest.2378F690AD6E0E90.quest_desc: ["&a击败&r来自Cataclysm模组的Ignis。在燃烧竞技场中觉醒的这位&b传奇&r战士，以无与伦比的强大力量掌控着&b下界的&r火焰。直面他无情的攻击，在烈焰中幸存，并通过&b击败&rCataclysm最伟大的首领之一来证明你的实力。"]
	quest.2378F690AD6E0E90.quest_subtitle: "击败火焰领主"
	quest.2378F690AD6E0E90.title: "&l&cIgnis"
	quest.2397334E78B34973.quest_subtitle: "更多盔甲 (More Armor)"
	quest.23AEC7F684ADDBA7.quest_desc: ["&6接触器&r用低控制&b电压&r切换大电流。可将接触器堆叠在开关板上，只需为其中一个供电即可。"]
	quest.23AEC7F684ADDBA7.quest_subtitle: "一个重型中继器"
	quest.23B8606952D7DD5D.quest_desc: ["&6从Create模组中获取&r一个加权弹出器。它像一个动力发射台，&b让你&r可以设置一个目标&b位置&r，并以弹道弧线向该位置投掷物品或实体。可以通过潜行并&b右键单击&r目标方块来配置目标。"]
	quest.23B8606952D7DD5D.quest_subtitle: "将你的物品发射到工厂的各个角落"
	quest.23BD856DF5543797.quest_subtitle: "更多盔甲 (More Armor)"
	quest.23C4625691B57CBE.quest_subtitle: "更多盔甲 (More Armor)"
	quest.23CCCF0C41814172.quest_desc: ["&6Roll Table&r 是 Create: Dreams n' Desires 中的一种机械加工设备。利用旋转动力将&b材料&r加工成新的形态，从而扩展你工厂的&b制造&r能力。"]
	quest.23CCCF0C41814172.quest_subtitle: "精准地塑造材料形状"
	quest.23DDA40A29793507.quest_desc: [
		"Thermal Springstone Pickaxe 是 Eternal Starlight 的一种采矿工具，&a使用&r &bThermal Springstone Ingots&r制作而成。"
		""
		"&aIt&r is &bused&r for mid-tier mining progression and is resistant to heat-based environments, making it suitable for geothermal &bregions&r of the Starlight dimension."
	]
	quest.23DDA40A29793507.quest_subtitle: "地热采矿工具"
	quest.23E3C6A88D284556.quest_desc: [
		"&aCraft&r a Redstone Hook, a unique fishing &bupgrade&r that combines the ingenuity of engineering with the patience of an angler. Infused with redstone technology, this specialized hook represents a new approach to fishing, &busing&r clever mechanisms to improve your equipment."
		""
		"&a当&r你继续&b探索&r河流、湖泊和海洋时，创新变得和经验丰富同样重要。红石钩&b证明&r，即使是钓鱼也能从发明的力量中受益。"
	]
	quest.23E3C6A88D284556.quest_subtitle: "工程学遇上钓鱼的艺术"
	quest.23FD898AC15E9267.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.2407D02EF84A2980.quest_subtitle: "升级+"
	quest.240FEA275A842E71.quest_desc: [
		"&d铁封魔典&r是标准咒语书进阶流程中，薄皮日志之后的下一步。它能提供&b6&r个咒语栏，让你在发展魔法武器库时有更多&b空间&r容纳咒语。"
		""
		"&b升级&r你的魔咒书，为更强大的魔法和更高级别的魔咒书做好准备。"
	]
	quest.240FEA275A842E71.quest_subtitle: "为你的不断增长的法术收藏锻造一个更强大的容器"
	quest.241160A16D32AD91.quest_desc: ["&6Obtain&r a Rope Pulley from Create. Powered by rotational force, it moves &battached&r blocks and &bstructures&r vertically. With Linear Chassis, Radial Chassis, or Super Glue, it can move entire contraptions &binstead&r of just a single block. Its rope can also be climbed."]
	quest.241160A16D32AD91.quest_subtitle: "抵达深处"
	quest.241265877320A08F.quest_desc: ["&d机械&r组件是第二级的枪械硬件。它们能让你建造像六连发和火药转轮手枪这样的&b转轮式&r枪械，也是迈向钟表组件的垫脚石。"]
	quest.241265877320A08F.quest_subtitle: "更好的零件，更好的枪械"
	quest.24258C14DAF156AE.quest_desc: ["&6安全地&r切换高&b功率&r负载。要关闭它，必须先上紧，然后用&b红石&r脉冲切换状态。再次打开时无需上紧。"]
	quest.24258C14DAF156AE.quest_subtitle: "一台大功率的破坏者"
	quest.2443A0C7BBA034EF.quest_desc: [
		"&d邪教徒&r护腿是 Iron's Spells 'n Spellbooks 中邪教徒盔甲套装的一部分。穿戴后可提供 &b+6&r 护甲、&b+125&r 最大法力、&b+10%&r 血系法术强度和 &b+5%&r 法术强度。"
		""
		"它们可以通过组合巫师护腿、1个血符文和1个奥术精华来&b制作&r，或在支持的版本中使用锻造台进行升级。"
	]
	quest.2443A0C7BBA034EF.quest_subtitle: "通过你的盔甲，引导血魔法的黑暗力量"
	quest.2444C798BB7B0F33.quest_desc: [
		"&a旅途中&r你收集了钱币，现在是时候&b花&r掉它们了。商人&b出售&r任何地牢都找不到的商品：符文、Celestisynth 材料和盔甲、天界下界合金锭以及钩爪。"
		""
		"用魔法币支付。物品越&b稀有&r，花费的硬币越多，所以要明智地消费。"
	]
	quest.2444C798BB7B0F33.quest_subtitle: "万物皆有其价。"
	quest.245589F3966479B0.quest_desc: [
		"&a获取&r末地碎片，通过破坏散布在许多末地群系中的末地矿石来获得。"
		""
		"用于在砧台中合成末影尘，并且是&b永恒水晶&r灌注仪式的必需材料。"
	]
	quest.245589F3966479B0.quest_subtitle: "来自末地的矿石碎片"
	quest.245AF94431CA55DB.quest_desc: ["&6A&r 充满气体的管子，当阳极&b电压&r超过栅极设定的击穿电压时放电。放电后即使栅极电压为负也会持续导通，只有当阳极&b电流&r下降或反向时才会熄灭。请先为加热器供电。"]
	quest.245AF94431CA55DB.quest_subtitle: "一个四极管（thyratron）"
	quest.245AFE1A3A64D992.quest_subtitle: "更多盔甲 (More Armor)"
	quest.247ADE12BB44823E.quest_subtitle: "更多盔甲 (More Armor)"
	quest.2492B8315A80B873.quest_subtitle: "更多盔甲 (More Armor)"
	quest.249B9A558C29C581.quest_desc: ["&6使用&r Create: Winery 中完全自动化的工作站——酒窖来&b酿造&r苹果酒。将苹果类原料送入你的 Create 机械装置，让酒窖负责生产。苹果酒是该模组酒窖&b支持&r的饮品类别之一。"]
	quest.249B9A558C29C581.quest_subtitle: "按下按钮，发酵，享受丰收的喜悦"
	quest.249E932761EF5C0A.quest_subtitle: "更多盔甲 (More Armor)"
	quest.249F1BCA8AFB5470.quest_desc: [
		"&aDeep&r within the frozen reaches of the Twilight Forest, &batop&r the icy Glacier, lives the Alpha Yeti—the undisputed ruler of the eternal winter. Towering over &bordinary&r Yetis, this colossal beast commands the &bfury&r of snow and ice, defending its frozen cave with overwhelming strength."
		""
		"&a阿尔法雪怪&r是永不言败的对手，能投掷巨大的冰块，&b制造&r冰冻的冲击波，并用其惊人的力量碾碎疏忽大意的冒险者。要在这场战斗中幸存，&b需要&r强大的装备、谨慎的站位，以及忍受&b刺骨&r严寒的决心。"
		""
		"&aDefeating&r the Alpha Yeti &bproves&r your mastery over the frozen wilderness and unlocks the path toward even greater &bchallenges&r hidden within the Twilight Forest."
	]
	quest.249F1BCA8AFB5470.quest_subtitle: "征服冰冻冰川的统治者"
	quest.249F1BCA8AFB5470.title: "&bAlphaYeti"
	quest.24A8AB0875DCF41A.quest_desc: [
		"&a星光钻石腿甲&r是永恒星光系列的高级护甲，使用&b星光钻石&r制作而成。"
		""
		"星光钻石盔甲 &a提供&r与下界合金相当的防护，同时显著&b提升&r盔甲韧性和击退抗性。"
	]
	quest.24A8AB0875DCF41A.quest_subtitle: "天体钻石腿部盔甲"
	quest.24AF87A2C9AB4139.quest_desc: ["&a寻找&r来自Cataclysm模组的沙漠遗迹。这座小型沙漠建筑生成于沙漠群系，充满了致命的砂岩陷阱、隐藏的宝藏和&b危险的&r敌人。在深入地下前，&b搜查&r每一个角落。"]
	quest.24AF87A2C9AB4139.quest_subtitle: "探索一处被遗忘的沙漠遗迹"
	quest.24AF87A2C9AB4139.title: "&e沙漠遗址"
	quest.24BA201A1C6C0A7A.quest_desc: [
		"&a穿越&r葱郁的森林和&b连绵&r的平原，去发现一个白雪永不融化的国度。雪地群系是一片严酷而美丽的荒野，覆盖着无尽的&b白雪&r、冰冻的河流和耸立的冰峰。"
		""
		"&a尽管&r外表平静，这片&b冰封&r的土地上栖息着危险的生物和宝贵的资源。每踏出一步，都可能发现新的探索机会、&b隐藏的&r建筑和冰层下的&b冒险&r。"
	]
	quest.24BA201A1C6C0A7A.quest_subtitle: "踏入这片永恒的冰雪世界"
	quest.24BA201A1C6C0A7A.title: "&l访问雪地生物群系"
	quest.24BEAD74CD174EEC.quest_desc: [
		"&9&l使用“丝绸之触”附魔来&r&r采集&b你&r挖掘的方块。兼容的机器和设备可以使用“丝绸之触”附魔来采集方块，从而获得方块本身而非其常规掉落物。"
		""
		"非常适合&b收集&r那些原本会被分解成不同材料的珍贵方块。"
	]
	quest.24BEAD74CD174EEC.quest_subtitle: "原样采集方块，不要改变其形态"
	quest.24C35F1018EF333F.quest_desc: [
		"&a旅行者的翅膀&r是一件非凡的&b装备&r，使用暮色森林中神奇的&b资源&r制成。虽然无法真正飞行，但它们能让穿戴者安全滑翔很远，使&b探索&r变得更快速、更安全。"
		""
		"&a非常适合&r穿越深邃的峡谷、高耸的悬崖和广袤的&b魔法&r森林树冠，这对翅膀提供了无与伦比的机动性。每一次跳跃，你都会发现新的道路和&b隐秘&r的地点，而这些地方&b否则&r将遥不可及。"
	]
	quest.24C35F1018EF333F.quest_subtitle: "滑翔穿越森林的树冠层"
	quest.24C6F98CFC322079.quest_subtitle: "真美味！"
	quest.24D0091965A8DEA1.quest_desc: ["&6机械磨石&r是 Create: Enchantment Industry 中强大的机器，可将原版磨石引入你的工厂。它能&b自动&r处理物品、移除附魔并提取经验，同时还能为兼容配方提供&b额外的&r打磨功能。将其连接到 Create 的旋转动力，实现研磨和&b附魔处理&r系统的自动化。"]
	quest.24D0091965A8DEA1.quest_subtitle: "自动化研磨和附魔分解"
	quest.24DB004C6C3B742E.quest_desc: ["&6酿造&r黑皮诺，一种用红葡萄制成的优雅红葡萄酒。在创造：酿酒厂中，可以通过自动化酿酒工艺&b使用&r酒窖来生产。黑皮诺以其细腻的&b红色水果&r风味和泥土、花香而闻名。"]
	quest.24DB004C6C3B742E.quest_subtitle: "由精致葡萄酿制的优质红酒"
	quest.251451E155779930.quest_desc: [
		"&e没&r跳到平台上？再跳一次就好。"
		""
		"The &bCloud&r in a Bottle lets you perform a double jump while airborne, giving you an extra burst of mobility. It can also help save you from a dangerous fall if you time the &bsecond&r jump correctly."
		""
		"有时候，仅仅&b跳跃&r一次是不够的。"
	]
	quest.251451E155779930.quest_subtitle: "一点小小的额外助力"
	quest.2540A9BCFD7AA514.quest_subtitle: "更多盔甲 (More Armor)"
	quest.254CBF98692FCBE8.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.254F2ECD9A982FEB.quest_desc: ["&6安山岩外骨骼&r是Create Stuff 'N Additions模组中一件动力胸甲，&b旨在&r提升你的效率。穿戴时，它能提供速度II和虚弱II效果，使采矿速度&b显著&r加快，但会降低你的战斗能力。它需要燃料来运行，耐久度为&b320&r。在2.0.1版本中，它通过机械合成，使用安山岩合金、转轴、带轮连接器、热机、锌锭和石头来&b制作&r。"]
	quest.254F2ECD9A982FEB.quest_subtitle: "更努力，挖得更快"
	quest.254FE9D920F37661.quest_desc: [
		"&e释放&r你狂野的一面。"
		""
		"野性利爪&b会&r提升你的攻击速度，让你能更快地挥舞武器，在敌人反应过来之前将其撕碎。在当前的&bArtifacts&r版本中，它们提供&b40%&r的攻击速度加成。"
		""
		"&b用&r你的爪子来说话。"
	]
	quest.254FE9D920F37661.quest_subtitle: "出拳更快。出拳更狠"
	quest.255286B3896F7565.quest_subtitle: "更多盔甲 (More Armor)"
	quest.2575FE3D87D1945D.quest_desc: ["&6Alternator&r 是 Create Crafts \& Additions 的关键机器之一。它将 Create 的 &b旋转&r 动力转换为 Forge 能量 (FE)，让你能直接从 &b工厂的&r 动能机械中发电。在 NeoForge 1.21.1 的 1.6.0 版本中，它两侧都有轴接口，便于 &b集成&r 到你的动力系统中。它需要至少 &b32&r RPM 才能运行，并拥有 &b5&r kFE 的内部能量缓冲。"]
	quest.2575FE3D87D1945D.quest_subtitle: "将动能转化为电能"
	quest.257874F4BC99414C.quest_desc: ["&6获取&r物品仓库和物品筒仓。这些存储方案&b专为&r自动化&b工厂中处理大量物品而&r设计。物品仓库可连接成大型存储结构，而物品筒仓则在 Create 扩展中提供紧凑的垂直&b存储&r。"]
	quest.257874F4BC99414C.quest_subtitle: "储存你工厂的财富吧"
	quest.257874F4BC99414C.title: "物品宝库 \& 物品筒仓"
	quest.258C7824B863FC6B.quest_desc: [
		"&d恢复戒指&r能缩短法术冷却时间15%，让你更频繁地使用最&b强&r的法术，持续压制敌人。"
		""
		"&b装备&r戒指，让你的每个法术间隔都更有意义。"
	]
	quest.258C7824B863FC6B.quest_subtitle: "更快地恢复你的法术"
	quest.258E07D6C6627C6D.quest_desc: [
		"这些&b工具&r结合了下界合金的强度与铁的可靠性。"
		"它们是钻石工具的可靠&a升级&r，也是更深层&b进阶&r的良好基础。"
	]
	quest.258E07D6C6627C6D.quest_subtitle: "可靠的开端"
	quest.258E07D6C6627C6D.title: "铁质下界合金工具"
	quest.258F8395D8D45BB0.quest_desc: [
		"&aTrees&r in the Eternal Starlight dimension are infused with lunar energy."
		"它们的日志，即&b Lunar&r Logs，是用于制作工具、建造结构和在这个神秘世界中前进的基本资源。"
		""
		"收集足够的这种木材，开始在星光维度塑造你的&b生存&r之路。"
	]
	quest.258F8395D8D45BB0.quest_subtitle: "收割星光树木"
	quest.258F8395D8D45BB0.title: "月亮木"
	quest.25A98178C5A2A02F.quest_desc: [
		"&l&9Running&r&r out of power far from home can bring your adventure to a sudden halt. The Battery Upgrade adds energy storage directly to your backpack, allowing you to charge and discharge &bcompatible&r energy-based items while on the move."
		""
		"&b为背包充电&r，无论旅途将你带向何方，都让动力工具和装备随时待命。"
	]
	quest.25A98178C5A2A02F.quest_subtitle: "无论走到哪里，都让你的机器保持运转"
	quest.25AFB0A69CE6B264.quest_desc: ["&6Design&r and write Circuit Schematics here. Components you want to place on the board must be in your inventory. Insert an empty schematic to save the design."]
	quest.25AFB0A69CE6B264.quest_subtitle: "一个电路设计台"
	quest.25B4FEAFBBFEFDCE.quest_desc: ["&eDon't&r let your target escape! The Clockwork Arrow is a special arrow that automatically steers towards the nearest mob to your crosshair when fired. Take &badvantage&r of this remarkable technology to &bimprove&r your attacks and hit your enemies with greater precision!"]
	quest.25B4FEAFBBFEFDCE.quest_subtitle: "机械辅助精准度"
	quest.25BC90657571F33F.quest_desc: [
		"&aExplore&r the main island of the End — a barren stretch of end stone and obsidian pillars surrounding the central fountain."
		""
		"这是抵达后你将踏上的第一片土地，也是每次远征&b外岛&r的&b起点&r。"
	]
	quest.25BC90657571F33F.quest_subtitle: "中央岛屿"
	quest.25BC90657571F33F.title: "&l&e末地"
	quest.25C8E0C001721567.quest_desc: ["&6制作&r轨道缓冲器，为您的铁路增添最后一抹亮色。这款装饰性缓冲器旨在&b放置&r在轨道末端，为您的车站、车库和侧线提供一个标准的铁路式停靠点。在 Create: Misc \& Things 中，它主要是一个装饰方块，而非&b功能性&r火车制动器。"]
	quest.25C8E0C001721567.quest_subtitle: "让火车在轨道上戛然而止"
	quest.25CFE8AC523454F9.quest_desc: ["&6获取&r固体熔融物和熔融物，它们是过热核反应堆产生的&b危险&r产物。处理这些材料时必须格外&b小心——它们&r是反应堆内部出现严重&b问题&r的信号。"]
	quest.25CFE8AC523454F9.quest_subtitle: "在熔毁中生存下来"
	quest.25E15B862AC93653.quest_desc: [
		"&a在&r下界深处挖掘远古残骸。"
		"这种稀有材料可以熔炼成&b下界合金废料&r，并最终制成下界合金。"
	]
	quest.25E15B862AC93653.quest_subtitle: "最稀有的下界资源"
	quest.25E15B862AC93653.title: "&6远古残骸"
	quest.26084DC3B8F5AEAF.quest_desc: ["收集 8 个 &a煤炭&r 和 16 个 &a圆石&r，然后制作一个 &a熔炉&r。煤炭将是你最初的燃料，而石头能让你制造更强大的工具和方块。熔炉开启了冶炼功能，是迈向 &b进阶&r 的关键一步。"]
	quest.26084DC3B8F5AEAF.quest_subtitle: "基本资源和你的第一个熔炉"
	quest.26084DC3B8F5AEAF.title: "&7石制&8进阶指南"
	quest.26252B59DD543507.quest_desc: [
		"&9&l告别&r&r物品溢出和无尽搜寻。Refined Storage 将你的物品接入强大的数字存储网络，&b让你&r能从一个系统中访问、整理和管理你的全部&b收藏品&r。"
		""
		"建造你的首个存储网络，连接你的存储&b磁盘&r，探索一种全新的资源&b管理&r方式。"
	]
	quest.26252B59DD543507.quest_subtitle: "踏入数字存储的世界吧"
	quest.26252B59DD543507.title: "&l&b欢迎使用 Refined Storage"
	quest.2639E265A51A671F.quest_desc: ["&6Craft&r Honey Candy in Create: Confectionery and &badd&r a touch of sweetness to your factory. This treat is made &busing&r honey and can be enjoyed as a simple confection alongside the mod's many other sweets."]
	quest.2639E265A51A671F.quest_subtitle: "用金色蜂蜜制成的美味甜点"
	quest.26688FEB91E1B67A.quest_desc: ["&6Converts&r Forge Energy into this mod's &belectricity&r. Use the control pin to set the output &bvoltage&r and improve conversion efficiency. It lets you feed your grid from other mods' machines."]
	quest.26688FEB91E1B67A.quest_subtitle: "来自Forge Energy的一座桥梁"
	quest.266B1BF54658D4B0.quest_desc: ["&6保护&r你的设备免受过大&b电流&r的侵害：当电流超过设定值时它会烧毁。将其放置在要保护的设备前方的电路中。"]
	quest.266B1BF54658D4B0.quest_subtitle: "一个引信座"
	quest.267CAA9E6F1A31D2.quest_desc: [
		"&a在世界的黑暗深处&r，Underworld Knight 作为古老力量的诅咒守护者而屹立。"
		"&a这个首领&r身披重甲，极具攻击性，会用凶猛的近战和持续的压力来压倒对手。"
		"在迎战它之前，准备好强大的装备和恢复物品，因为这场&b战斗很长&r而且&b危险&r。"
	]
	quest.267CAA9E6F1A31D2.quest_subtitle: "被诅咒的守护者"
	quest.267CAA9E6F1A31D2.title: "&l&3地下世界骑士"
	quest.268BBA40E3EF5994.quest_subtitle: "更多盔甲 (More Armor)"
	quest.2693FECFF203A6F9.quest_desc: ["&6从Create模组中获取&r流体储罐。它用于储存流体，并且可以&b连接&r流体管道以实现&b自动化&r填充和提取。单个储罐最多可容纳8桶（8,000 mB）流体，多个储罐可以&b组合&r成更大的结构，最大可达3×32×3个方块。"]
	quest.2693FECFF203A6F9.quest_subtitle: "储存你工厂的生命之源"
	quest.26A67F2654797A8B.quest_desc: [
		"&dThe&r Scarecrow Coat is part of the Scarecrow Armor set in Iron's Spells 'n Spellbooks. It provides &b+8&r Armor and &b+75&r Max Mana."
		""
		"用干草垛和皮革制作这件&b不寻常的&r魔法斗篷，拥抱稻草人的&b神秘&r力量。"
	]
	quest.26A67F2654797A8B.quest_subtitle: "拥抱稻草人的奇妙魔法吧"
	quest.26B541AF546B8FFA.quest_desc: ["&6Obtain&r a Radial Chassis, Linear Chassis, and Secondary Linear Chassis from Create. These chassis are &bessential&r components for building moving contraptions. The Radial Chassis connects blocks within a radius, while the Linear Chassis &bconnects&r structures along a line. The Secondary Linear Chassis works like the Linear Chassis but does not connect to regular Linear Chassis, allowing separate sections of a &bcontraption&r to move independently."]
	quest.26B541AF546B8FFA.quest_subtitle: "建造移动装置的基础结构"
	quest.26B541AF546B8FFA.title: "所有底盘"
	quest.26E01323474AD157.quest_desc: [
		"&9&l你的&r&r存储网络正变得庞大。64k 存储磁盘提供了巨大的数字存储容量，&b让你&r可以在 Refined Storage 系统中存放海量资源。"
		""
		"将其插入磁盘驱动器，向构建真正庞大的数字存储网络又迈出了重要的一步&b&r。"
	]
	quest.26E01323474AD157.quest_subtitle: "将海量资源存储在一个磁盘里"
	quest.26EF0403229474B6.quest_desc: [
		"&a搜寻&r下界，找到一个下界堡垒——一座由暗砖构成的巨大建筑，悬浮在熔岩海洋之上。"
		"这些堡垒极其危险，遍布烈焰人、凋零骷髅和其他敌对生物，但它们也是推进进程所必需的，因为里面含有用于&b酿造&r和&b召唤首领&r的宝贵战利品和资源。"
	]
	quest.26EF0403229474B6.quest_subtitle: "远古的下界堡垒遗迹"
	quest.26EF0403229474B6.title: "&4下界堡垒"
	quest.26FCC88CA508AA64.quest_desc: [
		"Chain of Souls 是 Eternal Starlight 中一件&a神秘&r的物品，与更高级别的进阶和&b维度&r实体相关。"
		""
		"其具体获取&a方式&r在现有公开资料中并无明确记载，可能&b取决于&r战利品表、进度奖励或模组内的 JEI 合成配方。"
	]
	quest.26FCC88CA508AA64.quest_subtitle: "被束缚的本质"
	quest.26FCC88CA508AA64.title: "&6灵魂锁链 Chain Of Souls"
	quest.2718707A2FF24FAF.quest_desc: [
		"&9&lThe&r&r Limited Oak Barrel IV continues the progression of compact storage in Sophisticated Storage. With &beven&r more capacity than the previous tiers, it provides plenty of room for expanding your collection while &bmaintaining&r the practical barrel design."
		""
		"继续&b改进&r你的存储系统，为下一级的存储技术做好准备。"
	]
	quest.2718707A2FF24FAF.quest_subtitle: "向高级存储迈出的更大一步"
	quest.27279EA6D60985B1.quest_subtitle: "升级+"
	quest.273271508FA51035.quest_subtitle: "升级+"
	quest.273B534C64F4D80E.quest_desc: ["从 Cataclysm: Spellbooks 扩展包中获取&a怪诞巫师帽&r。将这个&b强大&r的魔法头饰加入你的收藏，继续探索该扩展包引入的怪物遗物和&b禁忌&r魔法。"]
	quest.273B534C64F4D80E.quest_subtitle: "拥抱这位强大魔师的无穷力量"
	quest.273B534C64F4D80E.title: "&6怪诞的&e巫师帽"
	quest.273C2DBE718BBCD0.quest_desc: [
		"在暮色森林的&a深处&r，坐落着被黑暗和时间吞噬的古老堡垒——&b哥布林&r堡垒。在其宏伟的坟墓中，隐藏着骑士幻影，这群幽灵战士在死后仍&b继续&r守护着他们已故的国王。"
		""
		"&aUnlike&r most bosses, the Knight Phantoms fight as a &bcoordinated&r group, surrounding their enemies with relentless attacks and refusing to give their opponents a moment to recover. Their spectral weapons, &bdisciplined&r formations, and overwhelming numbers make this encounter one of the greatest tests of skill in the Twilight Forest."
		""
		"&a唯有&r击败所有&b幻影&r骑士，你才能获得胜利，继续向&b附魔&r领域中隐藏的最终秘密迈进。"
	]
	quest.273C2DBE718BBCD0.quest_subtitle: "击败哥布林堡垒中被遗忘的守护者"
	quest.273C2DBE718BBCD0.title: "&2骑士幻影骑士团 (Knight Phantom)</c1>"
	quest.273C8343488350C5.quest_desc: ["&6The&r Copper Jetpack is a &bflight-capable&r chestplate from Create Stuff 'N Additions powered by hydraulic energy. It is &bfueled&r with water and allows you to fly through the air, giving you a much more mobile way to explore and work around your factory. It is crafted &busing&r 4 Copper Ingots, a Cogwheel, a Hydraulic Engine, 2 Fluid Tanks and an Andesite Alloy."]
	quest.273C8343488350C5.quest_subtitle: "借助液压动力，展翅高飞"
	quest.273DC287156455D1.quest_desc: ["&d击中&r时有几率掉落一枚&bSoulfire Coin&r。射击硬币可为你的子弹赋能并使其反弹，赋能后的射击会无视&b护甲&r并造成额外的灵魂伤害。"]
	quest.273DC287156455D1.quest_subtitle: "由灵魂力量驱动的子弹"
	quest.2741A59CB91C0F9E.quest_desc: [
		"&a收割&r强大九头蛇的肉，准备一份暮色森林中最滋补的菜肴之一。九头蛇肉排是一种稀有美味，只有在击败&b传奇&r生物后才能获得，蕴含着该&b生物&r惊人生命力的一部分。"
		""
		"&aWhen&r properly cooked, it restores a &blarge&r amount of hunger and provides &bexcellent&r nourishment for long expeditions. A meal fit for those who have proven themselves capable of slaying one of the forest's greatest monsters."
	]
	quest.2741A59CB91C0F9E.quest_subtitle: "一场配得上屠龙者的盛宴"
	quest.2743EA3B926C7174.quest_desc: ["&6Schematicannon&r 是 Create 的自动化建造机器。加载一个定位好的蓝图，为其提供火药，并将所需的建筑材料放置在炮台&b旁&r边的物品栏中。然后它会&b逐块&r建造蓝图，从下往上进行。可以使用书或剪贴板生成&b材料&r清单，而放置设置则能让你&b控制&r现有方块的处理方式。炮台使用火药作为燃料，并根据放置的方块数量来&b消耗&r火药。"]
	quest.2743EA3B926C7174.quest_subtitle: "无需动手，轻松建造完成"
	quest.2758902B0ECCDE9B.quest_desc: ["&a击败&r来自 L_Ender’s Cataclysm 的 5 只 Cindaria，向这些危险的生物证明你的&b实力&r。"]
	quest.2758902B0ECCDE9B.quest_subtitle: "狩猎辛迪亚里安（Cindaria）"
	quest.2758902B0ECCDE9B.title: "辛迪亚里亚"
	quest.277606BE5C92F2C4.quest_subtitle: "更多盔甲 (More Armor)"
	quest.279AC2F5997E753D.quest_desc: ["&6烈焰附魔机&r是Create: Enchantment Industry中一种将烈焰能量转化为自动化附魔的高级机器。使用其过滤器&b配置&r所需的附魔，提供所需的液态经验值，即可让机器自动附魔&b兼容&r的物品。它是将完全&b自动化&r的附魔引入你的Create工厂的核心机器之一。"]
	quest.279AC2F5997E753D.quest_subtitle: "将附魔的艺术自动化"
	quest.27A6212CA26C7EE5.quest_subtitle: "更多盔甲 (More Armor)"
	quest.27AF89C1E41CE68F.quest_desc: ["在 Create: Confectionery 中制作&6白巧克力棒&r，享受丝滑浓郁的巧克力美味。将其&b加入&r你的糖果生产线，与黑巧克力和红宝石巧克力一同扩展你的巧克力棒&b收藏&r。白巧克力主要由可可脂、糖和牛奶制成。"]
	quest.27AF89C1E41CE68F.quest_subtitle: "适合所有甜食爱好者的经典奶油甜点"
	quest.27B58DE6B4A8F507.quest_subtitle: "真美味！"
	quest.27B7F8713C375E65.quest_desc: ["移除子弹的&d&r&b重力&r，使其能直线飞行而非随距离下落。非常适合远程射击。"]
	quest.27B7F8713C375E65.quest_subtitle: "直线射击"
	quest.27C42E8855F9570E.quest_desc: [
		"&e幸运围巾&r在挖矿时提供额外的财富等级，增加你从依赖财富的方块中获得的资源数量。对于那些希望&b让&r每一处矿脉都物超所值的玩家来说，是一款简单的&b配饰&r。"
		""
		"穿上它，让&b每一&r个方块都发挥作用。"
	]
	quest.27C42E8855F9570E.quest_subtitle: "矿工的最佳伙伴"
	quest.27E1F3AD0F733BC2.quest_desc: ["&aCraft&r a Mini Snowman from the Dusty Decorations mod. This decorative block is &bperfect&r for adding a festive winter atmosphere to your home, campsite, or snowy village."]
	quest.27E1F3AD0F733BC2.quest_subtitle: "一个迷人的冬季装饰品"
	quest.27EA40EBC18A109F.quest_desc: [
		"&9&l限定橡木桶 III 是&r&r你仓储进阶的又一步&b&r。与前几代相比，它的&b&r容量更大，在保持桶状紧凑形态的同时，能容纳你日益增长的收藏品。"
		""
		"&b不断&r扩展你的存储能力，逐步迈向最强大的可用容器。"
	]
	quest.27EA40EBC18A109F.quest_subtitle: "将你的紧凑型存储推向更远的极限"
	quest.27FC1EE9736824E4.quest_desc: ["&6Craft&r the Vox Humana pipe and add its &bdistinctive&r reed voice to your pipe organ. Vox Humana is one of the &boriginal&r pipe types in Create: Sound of Steam and is classified as a reed pipe. In version 0.8, it is crafted through sequenced assembly &busing&r the mod's reed and tuning wire components."]
	quest.27FC1EE9736824E4.quest_subtitle: "让你的器官拥有人类的声音"
	quest.28000599322AC1CC.quest_desc: ["&d用于&r在 Hazen N Stuff 中升级暗影装备的&b特殊&r球体。"]
	quest.28000599322AC1CC.quest_subtitle: "一个注入了暗影力量的球体"
	quest.281D9A7BFAE56D98.quest_desc: [
		"深海银剑是永恒星光中的一个&a武器&r，使用深海银锭&b制作而成&r。"
		""
		"&a它&r是一种用于沼泽和黑暗生物群系的早期至中期过渡武器，比阿马拉琥珀等基本&b材料&r更胜一筹。"
	]
	quest.281D9A7BFAE56D98.quest_subtitle: "沼泽钢刃"
	quest.284D660E93B059C4.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.284F646DF817CA47.quest_desc: [
		"&e既然大地能为你提供能量，&r为何还要携带食物？"
		""
		"扎根靴在草地上行走时会缓慢恢复饥饿值。默认情况下，每15秒恢复1点饥饿值。在草地上&b站立&r时进食，还会对&b附近&r的植物施加骨粉效果，使这双靴子既适合生存也适合种植。"
		""
		"&b与自然&r同行。让它来照顾你。"
	]
	quest.284F646DF817CA47.quest_subtitle: "让大自然为你提供食物"
	quest.284FCA69BD12F40A.quest_subtitle: "更多盔甲 (More Armor)"
	quest.285B0A4BEF5565FA.quest_subtitle: "真美味！"
	quest.285C86C0D8327492.quest_desc: [
		"使用存储监视器来&9&l监控&r&r你的精炼存储网络内容。它能显示所选物品及其当前数量，让你无需打开主存储界面，就能轻松&b追踪&r重要的&b资源&r。"
		""
		"&bUse&r it to create convenient status &bdisplays&r around your base and always know when your supplies are running low."
	]
	quest.285C86C0D8327492.quest_subtitle: "一眼就能掌握你的储物空间情况"
	quest.286FC21659BE8EB8.quest_subtitle: "真美味！"
	quest.289307E6B572C1F8.quest_subtitle: "真美味！"
	quest.28959A1FE12C57A8.quest_desc: [
		"&l&9A&r&r smithing table is useful, but carrying one everywhere isn't. The Smithing Upgrade adds a fully &bfunctional&r smithing table directly to your backpack, allowing you to upgrade your gear with smithing templates wherever you are."
		""
		"保持你的&b装备&r更新，随时随地进行锻造。"
	]
	quest.28959A1FE12C57A8.quest_subtitle: "无需离开背包即可升级你的装备"
	quest.28BEB1B635328BA5.quest_desc: ["&dCrescentia&r 是一把闪耀的镰刀，专注于&b防御&r增益和持续伤害。"]
	quest.28BEB1B635328BA5.quest_subtitle: "新月形月亮"
	quest.28BEB1B635328BA5.title: "&l&5月桂树（Crescentia）"
	quest.28C9F7D8DB115F9E.quest_desc: ["&aThe&r Moonring Greatsword is a craftable weapon in some versions or modpack &bconfigurations&r of Eternal Starlight, related to lunar-themed progression."]
	quest.28C9F7D8DB115F9E.quest_subtitle: "结晶化的月亮武器"
	quest.28C9F7D8DB115F9E.title: "&6月亮环大剑"
	quest.28E654549C75AC52.quest_desc: ["&6The&r Blaze Forger 是 Create: Enchantment Industry 的自动化砧。它&b利用&r烈焰的力量来&b处理&r附魔物品，让你可以通过 Create 自动化来应用、组合、拆分和移除附魔。它还支持超级附魔，在配置后能让你突破正常的&b附魔&r等级限制。"]
	quest.28E654549C75AC52.quest_subtitle: "超越寻常的Forge附魔效果"
	quest.28FC81C5F5D95D54.quest_desc: [
		"&a下界星&r是一种击败凋零后获得的稀有强力物品。"
		"它蕴含着巨大的能量，可用于制作信标等高级方块，象征着你对 &bMinecraft&r 中最&a危险&r的 boss 之一的掌控。"
	]
	quest.28FC81C5F5D95D54.quest_subtitle: "源自混沌的力量"
	quest.28FC81C5F5D95D54.title: "&d下界之星"
	quest.28FF043041C789E9.quest_desc: ["&6拾取器&r是 Create Stuff 'N Additions 的一个实用工具，能让你拾起和移动通常无法手动移动的方块。它尤其&b适合&r用于&b运输&r特殊方块和搭建装置。在新版本中，拾取器使用模组的 Lifted Block 实体&b来&r替代 Falling Block 实体。"]
	quest.28FF043041C789E9.quest_subtitle: "移动本不该移动的方块"
	quest.29051B96AAC37515.quest_desc: ["&6Craft&r the Centrifugal Clutch to automatically &bcontrol&r mechanical power based on rotational speed. The clutch engages when the input RPM exceeds its configured threshold and disconnects when the speed falls below it. The &bthreshold&r can be adjusted with the value panel, making it &buseful&r for automatic speed-based machinery."]
	quest.29051B96AAC37515.quest_subtitle: "仅在速度合适时才进行交战"
	quest.2909A3AF6BF326B4.quest_subtitle: "真美味！"
	quest.290A69031D71AA01.quest_desc: [
		"&d不常见&r墨水是 Iron's Spells 'n Spellbooks 中第二级的魔法墨水。它被&b用于&r卷轴锻造台来创造&b不常见稀有度&r的卷轴。"
		""
		"在魔法结构中查找，或从强大的魔法生物处&b获取&r，然后用它来制作比普通墨水更强大的法术。"
	]
	quest.290A69031D71AA01.quest_subtitle: "更强大的精华，用于更强大的法术"
	quest.290A69031D71AA01.title: "&a不常见的墨水"
	quest.29129B91E5661646.quest_subtitle: "更多盔甲 (More Armor)"
	quest.291B45D19468ED15.quest_desc: [
		"使用由九头蛇的炽烈精华锻造的炽热锭来&a制作&r火焰镐。在&b魔法&r火焰中淬炼，这件非凡工具兼具惊人的耐久性与火焰的破坏力，能以&b卓越&r的效率撕裂岩石和矿石。"
		""
		"&aThe&r Fiery Pickaxe is &bmore&r than a mining tool—it is a symbol of your mastery over the Hydra's power. Carrying the heat of the Fire Swamp within its enchanted metal, it will faithfully accompany you as you uncover the rarest &btreasures&r hidden beneath the Twilight Forest."
	]
	quest.291B45D19468ED15.quest_subtitle: "用烈焰的力量凿穿岩石"
	quest.294D9C192F40B07B.quest_desc: ["&d一种&r珍贵的合成材料，&b用于&rHazan N Stuff中各种强力装备和&b特殊&r物品的配方。"]
	quest.294D9C192F40B07B.quest_subtitle: "用于强大合成的神圣材料"
	quest.2963A6D1EA6F1E6A.quest_desc: ["&a猪灵奖杯&r是 My Nether's Delight 的装饰性奖杯，用以&b纪念&r你在下界的冒险和与&b其危险生物&r的遭遇。"]
	quest.2963A6D1EA6F1E6A.quest_subtitle: "纪念击败 Hoglin 的奖杯"
	quest.29730358A0A0855B.quest_desc: ["&6Thorium&r 矿石是一种放射性资源，用于推进 Create: New Age 的核技术。开采并处理矿石以获得钍，&b开启&r通往&b高级&r反应堆组件和核能发电的道路。"]
	quest.29730358A0A0855B.quest_subtitle: "发现一种新的核能来源"
	quest.2976D4E7CEB57815.quest_desc: ["&6获取&r安山岩外壳，它是Create的基本构建模块之一。它&b被&r用来制作&b许多&r早期机械组件，包括机械搅拌机、机械轴承和其他机器。"]
	quest.2976D4E7CEB57815.quest_subtitle: "迈向机械工程的第一步"
	quest.2976D4E7CEB57815.title: "安山岩外壳"
	quest.2987C9E257AE142A.quest_desc: ["&6Obtain&r the Brown Toolbox from Create. This portable storage block provides &b8&r inventory slots, with each slot holding up to &b4&r stacks of items. When placed, nearby players can also access its contents remotely &busing&r the toolbox keybind. The Brown Toolbox is the &bdefault&r toolbox color."]
	quest.2987C9E257AE142A.quest_subtitle: "把工具放在手边，随时可用"
	quest.29C8541FE7881000.quest_subtitle: "真美味！"
	quest.29D7C8E46B80572C.quest_desc: ["&6龙门架车厢&r是一种沿龙门架导轨移动的装置。向导轨施加旋转动力即可沿轨道移动车厢，方向取决于导轨的旋转方向。在车厢上建造你自己的&b移动&r结构，以创建自动化农场、龙门起重机、电梯或其他线性机械。红石信号可以停止&b车厢&r并通过其输出传递旋转，使多个车厢和导轨协同工作。使用扳手可以改变龙门架导轨的&b朝向&r，从而控制移动&b方向&r。"]
	quest.29D7C8E46B80572C.quest_subtitle: "将你的机器沿直线移动"
	quest.29D7C8E46B80572C.title: "龙门架车厢 \& 龙门架立杆"
	quest.29DAC4F8DDC1ED91.quest_desc: [
		"&aCraft&r the Fiery Leggings using Fiery Ingots forged from the Hydra's blazing essence. &bReinforced&r by ancient magic and the endless flames of the Fire Swamp, these leggings provide &bexceptional&r protection while allowing you to move freely through the most dangerous &bregions&r of the Twilight Forest."
		""
		"&aAs&r an essential part of the Fiery Armor set, they embody the strength of the Hydra itself. Their &benchanted&r metal radiates warmth and resilience, ensuring you are prepared for the legendary foes that await &bbeyond&r the burning marshes."
	]
	quest.29DAC4F8DDC1ED91.quest_subtitle: "锻造于火焰沼泽的心脏之中"
	quest.29EBACD0EC57DAD3.quest_desc: ["制作所有 Chipped 桌子。"]
	quest.29EBACD0EC57DAD3.quest_subtitle: "制作所有桌子"
	quest.29EBACD0EC57DAD3.title: "Chipped 大师"
	quest.29EC006C81866271.quest_desc: ["&a从&rCataclysm模组中获得远古金属锭。这种稀有的&b材料&r可在沙漠遗迹和诅咒金字塔中找到，可通过击败Koboletons、Kobolediators、Wadjet或远古残骸获得。远古金属&b用于&r制作远古长矛、骨爬行动物盔甲和&b其他&r远古装备。"]
	quest.29EC006C81866271.quest_subtitle: "由古代文明锻造的一件遗物"
	quest.29F326A8C981EF09.quest_desc: ["&d灰烬&r精华是 Iron's Spells 'n Spellbooks 中一种稀有的合成材料。它由远古骑士掉落，主要用于制作升级球，是&b升级&r魔法装备的重要&b材料&r。"]
	quest.29F326A8C981EF09.quest_subtitle: "驾驭古代骑士的灼热精髓"
	quest.29F3AFA9F07FB87E.quest_subtitle: "更多盔甲 (More Armor)"
	quest.2A3347CB16530AEC.quest_desc: ["&6Insulated&r copper wire. You can &bdye&r it to tell circuits apart: right-click it with a dye or hold a dye in your offhand while placing. It is also an ingredient of the Copper Cord."]
	quest.2A3347CB16530AEC.quest_subtitle: "带绝缘层的铜线"
	quest.2A3A4F53283AB71F.quest_desc: [
		"永恒锭可在&a末地石熔炉&r中用泰拉纳锭和下界合金锭锻造，或在末地村庄等建筑中作为稀有战利品找到。"
		""
		"这是 Better End 中最坚固的材料，用于制作&b超越&r下界合金装备的道具。"
	]
	quest.2A3A4F53283AB71F.quest_subtitle: "比下界合金更坚固的金属"
	quest.2A4C4819B7FA01C5.quest_desc: [
		"&a你&r在暮色森林的旅程终于走到了尽头。从简陋的纳迦庭院到冰封的极光宫殿，你克服了这片&d魔法&r&d维度&r的每一项挑战。远古巨兽、被遗忘的国王、被诅咒的堡垒，以及&6传奇&r&b守护者&r，都败在了你的决心之下。"
		""
		"&aAlong&r the way, you &bforged&r powerful equipment, uncovered long-lost treasures, mastered magical artifacts, and proved yourself worthy of wielding the relics of the Twilight Forest. Every victory brought you one step closer to the &cheart&r of this enchanted realm."
		""
		"&a随着&r雪后&4被击败&r，维度中&a最伟大&r的秘密揭晓，你的冒险见证了你的勇气、毅力与技艺。尽管你在暮色森林的旅程已经结束，但无数新的&a冒险&r仍在边界之外等待着你。"
	]
	quest.2A4C4819B7FA01C5.quest_subtitle: "魔法世界已被征服"
	quest.2A4C4819B7FA01C5.title: "&l&6完成章节"
	quest.2A777613CD50AEAD.quest_desc: ["&6准备&r一杯香草奶昔，并用桶装满。这款&b美味&r的饮品是 Create: Dreams n' Desires 中多种奶昔之一，在模组更&b复杂的&r流体配方中也能发挥&b作用&r。"]
	quest.2A777613CD50AEAD.quest_subtitle: "经典口味，适合工厂建造者"
	quest.2A81E1C8AB2A9318.quest_desc: [
		"&l&9既然能随身携带，&r&r为何要将音乐&b&r留在身后？唱片机升级将你的背包变成便携式唱片机，让你可以直接在升级标签页中播放唱片。"
		""
		"借助高级唱片机升级，将体验再&b提升&r一步。可存储多张唱片、切换曲目、随机播放歌单，并在冒险途中&b开启&r重复模式，让音乐一路相伴。"
	]
	quest.2A81E1C8AB2A9318.quest_subtitle: "无论走到哪里，都带上你的音乐"
	quest.2A81E1C8AB2A9318.title: "唱片机 \& 高级唱片机升级"
	quest.2A849AF898939CE0.quest_desc: [
		"在&a机械融合砧&r上，将凋零突击肩炮与虚空核心融合，以&a获取&r虚空突击肩武器。"
		""
		"它能发射毁灭性的投射物，是Cataclysm中最强大的&b远程&r武器之一。"
	]
	quest.2A849AF898939CE0.quest_subtitle: "与虚空融为一体的加农炮"
	quest.2A849AF898939CE0.title: "&d虚空突袭肩扛武器"
	quest.2A87A9B363740DF3.quest_subtitle: "更多盔甲 (More Armor)"
	quest.2A923AE51C9DC9E3.quest_desc: [
		"&6欢迎，冒险者&r"
		""
		"你进入了一个由两种本不该共存的力量所塑造的世界。"
		""
		"工业与魔法的结合。"
		""
		"数个世纪以来，文明试图理解隐藏在地球之下、星辰之中以及生物体内的力量。有人寻求知识，有人寻求权力。"
		""
		"他们中的大多数都付出了惨痛的代价。"
		""
		"你即将发现其中的原因所在。"
		"{@pagebreak}"
		"&6蒸汽时代&r"
		""
		"你所知的世界并非从一开始就充满了机器。"
		""
		"很久以前，人类依靠简单的工具和粗糙的机械。后来，人们发现了动能工程学——一种通过齿轮、轴、皮带和精心设计的机器来传递运动的艺术。"
		""
		"始于好奇的事物，最终引发了一场工业革命。"
		""
		"工厂拔地而起。铁路连接了遥远的城市。巨大的机器开始重塑山脉和河流。"
		""
		"人类终于学会了如何让世界运转起来。"
		"{@pagebreak}"
		"&6另一种力量&r"
		""
		"但机器并非唯一有待发现的强大力量。"
		""
		"在第一批工厂建成很久以前，古代文明就谈论着 Arcana——一种流淌在世间无形的力量。"
		""
		"魔法变幻莫测。它能治愈或毁灭，能创造生命、弯曲物质、改变心智，也能撕裂现实。"
		""
		"几代以来，魔法与技术一直相互分离。"
		""
		"直到有人发现它们可以被组合在一起为止。"
		"{@pagebreak}"
		"&6首次融合&r"
		""
		"最初的实验被认为是无法实现的。"
		""
		"工程师开始在机器中放置魔法水晶。法师学会了通过机械装置引导奥术。蒸汽机变得更强大。自动人偶开始无需人力即可移动。"
		""
		"整座城市都由注入了魔法能量的机器提供动力。"
		""
		"有那么一瞬间，人类以为自己已经解决了所有问题。"
		""
		"他们错了。"
		""
		"有什么东西注意到了他们。"
		"{@pagebreak}"
		"&6坠落&r"
		""
		"No surviving record describes exactly what happened."
		""
		"有一天，伟大的城市们停止了交流。"
		""
		"机器在没有创造者的情况下继续运转。工厂燃烧了数周。在没有建造传送门的地方，传送门出现了。史无前例的生物从地下涌现。"
		""
		"随后，寂静降临了。"
		""
		"当它结束时，整个文明都消失了。"
		""
		"他们的机器都留了下来。"
		""
		"他们的遗迹留存了下来。"
		""
		"而他们唤醒的任何东西也都随之留存了下来。"
		"{@pagebreak}"
		"&6今日の世界&r"
		""
		"数个世纪已经过去了。"
		""
		"自然已经夺回了废墟，但旧世界从未真正消失。"
		""
		"废弃的工厂仍在被遗忘的山谷中运转。古老的实验室隐藏在废墟城市之下。由不可能引擎驱动的船只穿越遥远的海洋。"
		""
		"在无人踏足的地方，可以发现奇怪的古代遗物。"
		""
		"而在这一切之下，古老的机器仍在继续运转。"
		""
		"慢慢地来。"
		""
		"请耐心等待。"
		""
		"仿佛在等待某人的归来一般。"
		"{@pagebreak}"
		"&6你的旅程&r"
		""
		"你并不是英雄。"
		""
		"还没有。"
		""
		"你开始时一无所有，只有一双好奇的手和能聚集起来的勇气。"
		""
		"开采你的第一批矿石。建造你的第一批机器。了解能量如何在齿轮和电路中流动。"
		""
		"但不要就此止步不前。"
		""
		"研究秘典。探索被遗忘的结构。搜寻遗迹。前往文明疆界之外。"
		""
		"Every discovery will bring you closer to the truth."
		"{@pagebreak}"
		"&6一个充满可能性的世界&r"
		""
		"并没有唯一的一条道路可以遵循。"
		""
		"成为一名工程师，建造能够重塑世界的机器。"
		""
		"成为一名炼金术士，揭开隐藏在物质中的秘密。"
		""
		"成为一名法师，学习操控早于人类而存在的力量。"
		""
		"成为一名探险家，揭开前代文明留下的遗迹。"
		""
		"或者成为他们所有人。"
		""
		"世界并不在乎你选择了哪条道路。"
		""
		"它只关心那条路径通向何方。"
		"{@pagebreak}"
		"&6任务列表&r"
		""
		"前方的道路并不总是显而易见的。"
		""
		"你的任务书将作为你的向导。遵循其中的章节，完成目标，并从每一次发现中学习。"
		""
		"有些任务会教你基础知识。"
		""
		"其他地方会将你推向那些准备与否就意味着生与死的地方。"
		""
		"不要将任务视为简单的指令来对待。"
		""
		"它们是一个更宏大故事中的片段。"
		""
		"最终，你可能会发现从一开始就有人在引导你的旅程。"
		"{@pagebreak}"
		"&6最后的警告&r"
		""
		"这个世界上有些事情，就应该被遗忘在角落里。"
		""
		"本不该移动的机器，却开始运转。"
		""
		"本不该被掌控的魔法力量。"
		""
		"那些本不该被打开的门扉。"
		""
		"你最终会和他们相遇的。"
		""
		"当这种情况发生时，请记住一件事："
		""
		"好奇心创造了这个世界。"
		""
		"贪婪差点毁掉了一切。"
		""
		"如何使用其中的秘密，全由你决定。"
		""
		"你的冒险从现在开始。"
	]
	quest.2A923AE51C9DC9E3.quest_subtitle: "阅读中"
	quest.2A923AE51C9DC9E3.title: "&l&f描述文本"
	quest.2A971732D1809F14.quest_desc: [
		"&aDeep&r within the world of Eternal Starlight, the Torreya Forest grows with ancient, towering &atrees&r and a calm yet eerie atmosphere."
		"这个生物群系在&b最初&r看似平静，但深入探索者会发现隐藏的危险和宝贵的资源。"
		""
		"发现这片森林是迈向&b掌控&r该维度的又一步。"
	]
	quest.2A971732D1809F14.quest_subtitle: "寂静的远古森林"
	quest.2A971732D1809F14.title: "&d托雷亚森林"
	quest.2A9EB04C35C7C168.quest_desc: ["&6Zinc&r Leggings are part of the Zinc Suit from Create Stuff 'N Additions. They provide an &balternative&r armor option made from Zinc and have &b300&r durability. They are crafted using &b7&r Zinc Ingots."]
	quest.2A9EB04C35C7C168.quest_subtitle: "完成锌元素保护任务"
	quest.2AB632D79C0A6DE1.quest_desc: ["从Cataclysm模组中&a获取&r珊瑚矛。这种武器可由深海怪&b掉落&r，并可&b用作&r强大的近战武器。击败深海怪以收集这把&b稀有的&r海洋武器。"]
	quest.2AB632D79C0A6DE1.quest_subtitle: "来自珊瑚深处的武器"
	quest.2ABA024593945536.quest_desc: [
		"&d血杖&r是 Iron's Spells 'n Spellbooks 中一根强大的血杖。它是&b普通&r掉落物，来自死国王。"
		""
		"主手持有时，提供&b8&r点攻击力、&b1&r点攻速、&b+15%&r血系法术强度、&b+10%&r召唤物伤害和&b+5%&r法术强度。"
	]
	quest.2ABA024593945536.quest_subtitle: "挥舞死之王所拥有的深红之力"
	quest.2ABA462AA76F12F9.quest_subtitle: "真美味！"
	quest.2ADB6FE1CB30828B.title: "不错"
	quest.2ADCAA590F8E17E9.quest_desc: [
		"&a探索&r冰封的末地星域，这片覆盖着冰层和闪烁的、&b如星辰般&r的晶体结构的冰冻之地。"
		""
		"寒冷开阔的地形中隐藏着 Better End 的 &b生物群系&r 中独一无二的资源。"
	]
	quest.2ADCAA590F8E17E9.quest_subtitle: "冰冻的星光原野"
	quest.2ADCAA590F8E17E9.title: "冰之星域"
	quest.2ADD9599BDEC36C3.quest_desc: [
		"&9&l借助拾取升级，&r&r轻松收集物品。它能&b自动&r拾取附近的掉落物，并&b&r直接存入你的储物箱，帮你保持背包整洁，同时收集资源。"
		""
		"高级拾取升级能让您更好地控制拾取物，可以&b配置&r过滤器并&b微调&r要拾取的物品类型。"
	]
	quest.2ADD9599BDEC36C3.quest_subtitle: "让你的储物箱为你收集物品"
	quest.2ADD9599BDEC36C3.title: "拾取物品 \& 高级拾取升级"
	quest.2AE274FE18DAE509.quest_desc: ["&e再&r非凡的机器也需要维修。生成&b损坏&r的机械蜻蜓，并&b准备&r将其修复。用合适的钟表齿轮，你就能修好机械蜻蜓，获得一个能伴你翱翔天际、驰骋陆地的机械&b伙伴&r！"]
	quest.2AE274FE18DAE509.quest_subtitle: "机械蜻蜓的新生命 A New Life for a Mechanical Dragonfly"
	quest.2AE9658758CD1656.quest_desc: ["&d开启&r &b自动&r开火，让你按住扳机即可持续射击。"]
	quest.2AE9658758CD1656.quest_subtitle: "按住扳机键不松手"
	quest.2AEABE985A375787.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.2AF99F2DD039BB8B.quest_desc: [
		"塔拉西乌姆胸甲需要在锻造台用塔拉西乌姆板合成。"
		""
		"它是 Better End 推出的第一批&a盔甲&r的一部分。"
	]
	quest.2AF99F2DD039BB8B.quest_subtitle: "第一阶的胸甲"
	quest.2B04952C86C3FB6D.quest_subtitle: "更多盔甲 (More Armor)"
	quest.2B19669AC2AF8EEE.quest_desc: ["&6Craft&r a Mechanical Mixer from Create. It &buses&r rotational power to process Mixing recipes and multi-item &bshapeless&r crafting recipes inside a Basin. The Mixer requires at least &b32&r RPM to operate and is &bessential&r for creating materials such as Brass Ingots."]
	quest.2B19669AC2AF8EEE.quest_subtitle: "将材料转化为更伟大的事物"
	quest.2B24D4A0F2A37C18.quest_desc: [
		"晶化靴是通过灌注仪式制作的——将末地靴、琥珀宝石和晶化碎片放置在&a灌注基座&r周围。"
		""
		"穿戴后，可永久获得&b速度 I&r，非常适合探索末地。"
	]
	quest.2B24D4A0F2A37C18.quest_subtitle: "由灌注而生的靴子"
	quest.2B24D4A0F2A37C18.title: "&d晶化靴子"
	quest.2B2B279613C3F379.quest_desc: ["&6The&r Heat Pump allows you to &btransfer&r heat through your thermal network in Create: New Age. Use it together with Heat Pipes to move heat between different &bparts&r of your &bsetup&r and build more &badvanced&r heat-powered systems."]
	quest.2B2B279613C3F379.quest_subtitle: "精准地移动热量"
	quest.2B367C012076EE72.quest_desc: ["&dFrozen&r Bone is the Ice Focus in Iron's Spells 'n Spellbooks. It is dropped by Strays and can also be found in mod structures, with a higher &bchance&r in Mountain Tower loot. It is used to craft &bIce-school&r spells in the Scroll Forge, as well as items &bsuch&r as the Frost Rune and Frosted Helve."]
	quest.2B367C012076EE72.quest_subtitle: "驾驭流浪者的冰冻精髓"
	quest.2B56F9F02BA7AEB2.quest_desc: ["&a击败&r来自Cataclysm模组的远古残骸。这条&b庞大的&r远古巨龙守护者沉睡在诅咒金字塔下，守护着被遗忘文明的&b秘密&r与宝藏。用沙漠项链唤醒它，准备好与最&b强大&r的沙漠首领之一展开毁灭性的战斗。"]
	quest.2B56F9F02BA7AEB2.quest_subtitle: "击败被遗忘的沙漠的守护者"
	quest.2B56F9F02BA7AEB2.title: "&l&6远古的&e遗迹"
	quest.2B5F6F6DC5688B94.quest_desc: [
		"在&a永恒星光&r维度深处，坐落着茂密森林——一个植被高耸、能见度低下的阴暗生物群系。"
		"这里的导航变得困难，危险可能突然从茂密的周围环境中出现。"
		""
		"这个&a生物群系&r通常是新维度中探索&b技巧&r的&b首个&r真正考验。"
	]
	quest.2B5F6F6DC5688B94.quest_subtitle: "迷失在树林之中"
	quest.2B5F6F6DC5688B94.title: "&b茂密的森林"
	quest.2B6972654421AE30.quest_desc: ["&6A&r special-purpose device that, under the right conditions, gives a very stable &bvoltage&r reference."]
	quest.2B6972654421AE30.quest_subtitle: "一个调节管"
	quest.2B80E1852C650AD6.quest_subtitle: "真美味！"
	quest.2B8FD70ED00C97CD.quest_desc: [
		"Thallasium 锄头是一种由 Thallasium 锭锻造的&a农具&r，用于开垦农田。"
		""
		"这是 Better End 的&b工具&r进阶体系中最早期的部分。"
	]
	quest.2B8FD70ED00C97CD.quest_subtitle: "第一等级的农具"
	quest.2BB0FB60CB5B2E7C.quest_desc: ["&6用于制造&r电动机和发电机。当电磁铁处理安山合金时会产生，放置在&b闪电&r落点附近的铁锭也有几率被磁化。"]
	quest.2BB0FB60CB5B2E7C.quest_subtitle: "一块天然的磁铁"
	quest.2BB57849AB8C3F99.quest_desc: [
		"&d紫水晶&r长剑是 Iron's Spells 'n Spellbooks 中可制作的附魔剑。它可以附魔 1 个法术，并且自带回响打击 &bV&r 的附魔。"
		""
		"主手持有时，提供 &b8&r 点攻击力与 &b2.3&r 的攻击速度。回响打击 V 造成 &b75%&r 的伤害，产生 &b7&r 次回响打击，消耗 &b90&r 点法力值，并有 &b30秒&r 的冷却时间。"
		""
		"使用&b紫水晶碎片和锁链&r来制作。"
	]
	quest.2BB57849AB8C3F99.quest_subtitle: "以共振紫水晶的速度发起攻击"
	quest.2BC45EC14C31CF98.quest_subtitle: "真美味！"
	quest.2BD1540D539C2697.quest_subtitle: "更多盔甲 (More Armor)"
	quest.2BD43313ACBB6D84.quest_desc: [
		"&e雪&r在你懂得如何在上面行走时，就不是&b障碍&r了。"
		""
		"雪鞋&b能&r提高你在雪地上的移动速度，还能让你安全地走在粉雪上而不会陷进去。非常适合&b探索&r普通靴子会让你陷进去的冰冻生物群系。"
		""
		"&b轻&r轻地走。雪会托住你。"
	]
	quest.2BD43313ACBB6D84.quest_subtitle: "走向那片能将你吞噬的白雪"
	quest.2BE65A6041AC87BD.quest_subtitle: "更多盔甲 (More Armor)"
	quest.2BEA0EC499751B7E.quest_desc: [
		"&9&lTake&r&r your Refined Storage network beyond simple item storage with the Autocrafting Upgrade. It enables your system to automatically craft &brequested&r items &busing&r stored resources and configured crafting patterns."
		""
		"&bSet&r up your crafting patterns, connect the required machines and let your network handle production for you. From &bbasic&r components to complex recipes, automation takes care of the work."
	]
	quest.2BEA0EC499751B7E.quest_subtitle: "从头到尾自动化你的合成过程"
	quest.2C077F925EB919B7.quest_desc: ["从 Bosses' Rise 模组中&a获取&r沙蠕虫飞镖。这件稀有物品由潜伏在沙漠沙丘下的巨型捕食者——沙蠕虫&b掉落&r。在&b击败&r这头巨兽后，即可领取这件致命的战利品。"]
	quest.2C077F925EB919B7.quest_subtitle: "来自沙漠掠食者的剧毒奖杯"
	quest.2C0FF89F850634EF.quest_desc: [
		"&9&l使用自动合成管理器来管理&r&r你的自动化合成系统。它能让你更好地控制与精炼存储网络&b&r相连的自动合成器，从而更轻松地组织和管理&b&r复杂的合成设置。"
		""
		"&b使用&r它来保持自动化生产的井然有序，并确保你的合成网络顺畅运行。"
	]
	quest.2C0FF89F850634EF.quest_subtitle: "完全掌控你的自动化合成系统"
	quest.2C18AB90FCF7553C.quest_subtitle: "更多盔甲 (More Armor)"
	quest.2C23F02C83E2091F.quest_desc: [
		"永恒之剑柄是用于在&a锻造台&r上组装永恒之剑的组件。"
		""
		"这是完成 Better End 的&b最强&r刃武器所必需的。"
	]
	quest.2C23F02C83E2091F.quest_subtitle: "永恒之石刀刃的握柄"
	quest.2C2DAA65F0DCBFB6.quest_subtitle: "真美味！"
	quest.2C32A8D56584EC9D.quest_subtitle: "真美味！"
	quest.2C722B4A34985C44.quest_desc: ["&dSolaris&r 是 Celestisynth 中的一把火焰剑。它专为机动性和&b持续&r伤害而设计。制造它所需的&b材料&r可以在下界中找到。"]
	quest.2C722B4A34985C44.quest_subtitle: "太阳的火焰"
	quest.2C722B4A34985C44.title: "&l&6索拉里斯"
	quest.2C735E9DB2A5A009.quest_desc: [
		"&9&l借助虚空升级，保持&r&r你的储物空间&b&r免受不想要物品的侵扰。它能自动销毁符合你配置过滤器的物品，防止&b&r不必要的资源占用宝贵的储物空间。"
		""
		"高级虚空升级提供更&b精确&r的过滤功能，并能更好地控制哪些物品被&b送入&r虚空，非常适合全自动存储系统。"
	]
	quest.2C735E9DB2A5A009.quest_subtitle: "让不需要的物品永远消失不见"
	quest.2C735E9DB2A5A009.title: "虚空 \& 虚空高级升级组件"
	quest.2C7C0D132A3A82E6.quest_subtitle: "真美味！"
	quest.2C92519EF7630B9E.quest_subtitle: "真美味！"
	quest.2C9E9839B9EF169B.quest_desc: ["&6Sweet&r berries become an even better treat when covered in dark chocolate. Inject 250 mB of Dark Chocolate into Sweet Berries to create this &bdelicious&r combination. Each serving restores &b7&r hunger and &b11.2&r saturation, while granting Stimulation for &b6&r seconds."]
	quest.2C9E9839B9EF169B.quest_subtitle: "裹着浓郁黑巧克力的香甜浆果。"
	quest.2CB3E4E142A189BD.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.2CCE8F18ECC0B1D4.quest_desc: ["&6The&r Quality Tool Handle is a crafting component used in the recipes of certain tools from Create Stuff 'N Additions. It &breplaces&r the ordinary Stick in these recipes, providing a more specialized handle for &bhigher-quality&r equipment."]
	quest.2CCE8F18ECC0B1D4.quest_subtitle: "更好的手柄，更好的工具"
	quest.2D1A20BB5B5C9C8E.quest_subtitle: "真美味！"
	quest.2D1B28A5BC4D0B0F.quest_desc: [
		"&9&l赋予&r&r你的储物箱通过“烟熏升级”来烟熏食物的能力。兼容的物品可以直接在储物箱中&b使用&r烟熏炉的功能进行处理。"
		""
		"&bTake&r it a step further with the Auto-Smoking Upgrade and automate the entire process. Let your storage handle the input, fuel and finished &bproducts&r while you focus on more important tasks."
	]
	quest.2D1B28A5BC4D0B0F.quest_subtitle: "将你的储物箱变成一个便携式烟熏炉"
	quest.2D1B28A5BC4D0B0F.title: "自动吸烟与手动吸烟升级组件"
	quest.2D43CCFE92FB407A.quest_desc: [
		"&a热泉石腿甲&r是永恒星光中用&b热泉石锭&r制作的腿部护甲。"
		""
		"每件&aThermal Springstone&r盔甲都能点燃攻击的敌人并减少受到的火焰伤害，在炎热和&b危险&r的环境中提供绝佳保护。"
	]
	quest.2D43CCFE92FB407A.quest_subtitle: "防火腿部盔甲"
	quest.2D51FF8457909F5F.quest_desc: ["&6欢迎来到&r创造：新时代！用电力、电机、发电机和热能技术扩展你的创造工厂。利用&b磁&r能，通过&b旋转&r能量发电，运输和管理热量，并最终解锁&b强大的&r反应堆技术。逐步构建你的电气基础设施，将工厂带入一个全新的&b技术&r时代。"]
	quest.2D51FF8457909F5F.quest_subtitle: "用电力为你的工厂提供动力"
	quest.2D51FF8457909F5F.title: "&l&6欢迎来到创造新时代"
	quest.2D5224DB95345E46.quest_desc: ["制作一个&a附魔台&r，用魔法强化你的工具、武器和盔甲。附魔能大幅提升它们的效率、耐久度，并赋予特殊能力。这是你进阶和应对更严峻挑战的关键一步。"]
	quest.2D5224DB95345E46.quest_subtitle: "赋予装备力量的魔法"
	quest.2D5224DB95345E46.title: "&b附魔台&c"
	quest.2D5F025642CA4CFA.quest_desc: ["&6Brass&r Boots are part of the Brass Suit from Create Stuff 'N Additions. They are &bcrafted&r from 4 Brass Ingots and have &b325&r durability, making them a durable piece of the brass armor set."]
	quest.2D5F025642CA4CFA.quest_subtitle: "踏入黄铜的世界"
	quest.2D6E66D71EC8F571.quest_desc: [
		"&d神圣&r升级球是 Iron's Spells 'n Spellbooks 中的一种升级材料。在神秘砧上使用时，可提供 &b+5%&r 的神圣法术强度。"
		""
		"用1个空升级球和8个神圣符文合成。默认情况下，升级球最多可以对&b适用&r的物品使用3次。"
	]
	quest.2D6E66D71EC8F571.quest_subtitle: "用神圣魔法的力量灌注你的装备"
	quest.2D9A16104E931363.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.2DA48695BE44AD3D.quest_desc: [
		"&dPyromancer&r靴是Iron’s Spells ’n Spellbooks中Pyromancer靴的升级版。使用Volcanite Shard进行强化，&b为&r原有的Pyromancer装备注入了额外的晶体力量。"
		""
		"Volcanite Shards 可用于将 Iron’s Spells ’n Spellbooks 的 Pyromancer Armor 套装&b升级&r为其增强版 Crystal Chronicles。"
	]
	quest.2DA48695BE44AD3D.quest_subtitle: "一种由火山岩强化的火魔法师靴子增强版"
	quest.2DA50FFFCEAC95A3.quest_subtitle: "真美味！"
	quest.2DBE999CEB347B12.quest_desc: ["&a从Aquaculture 2中获取&r浮漂。这个钓鱼&b配件&r可用于升级鱼竿和改进钓鱼装备。将其与合适的材料结合，可打造出具有&b不同&r加成的专用鱼竿。"]
	quest.2DBE999CEB347B12.quest_subtitle: "一个用于更好钓鱼的小升级"
	quest.2E03C166D14B0D0D.quest_subtitle: "更多盔甲 (More Armor)"
	quest.2E0A9B0A60A0873A.quest_desc: [
		"Terminite头盔在锻造台用Terminite板甲合成，防护优于Thallasium。"
		""
		"它也是用来制作更强大的 &bCrystalite&r 和 &bAeternium&r 头盔的基础材料。"
	]
	quest.2E0A9B0A60A0873A.quest_subtitle: "第二阶段的头盔装备"
	quest.2E0F5CFCE625F843.quest_desc: ["&6从Create模组中获取&r一个显示链接器。 &b它能&r读取兼容方块的信息，并将其发送到&b显示&r方块，如Nixie Tubes、Display Boards、Signs、Hanging Signs和Lecterns。它可以显示物品名称、库存水平、火车状态、旋转速度、应力、流体信息等。默认的链接范围为&b64&r个方块。"]
	quest.2E0F5CFCE625F843.quest_subtitle: "将信息转化为知识"
	quest.2E2A3EA2FE65E787.quest_desc: [
		"使用来自暮色森林&b冰冻&r荒野的柔软北极毛皮来&a制作&r北极腿甲。经过精湛缝制，既能保暖又能保证&b完全&r自由的活动，专为不愿被恶劣&b气候&r所束缚的冒险者打造。"
		""
		"&aAs&r an &bessential&r part of the Arctic Armor set, they provide dependable protection against the relentless cold and the dangers lurking within the Glacier. Every &bstep&r through the snow proves that neither ice nor &bfreezing&r winds can stop your journey toward the Twilight Forest's greatest challenges."
	]
	quest.2E2A3EA2FE65E787.quest_subtitle: "直面无尽的严寒，屹立不倒"
	quest.2E2E94F1E53D44EE.quest_subtitle: "真美味！"
	quest.2E2EF29BA660A19C.quest_desc: ["&6Craft&r the Gamba pipe and add another distinctive &bvoice&r to your pipe organ. Gamba is one of the original pipe types in Create: Sound of Steam, introduced alongside Gedackt, Diapason, Piccolo, Subbass, Trompette &band&r Nasard."]
	quest.2E2EF29BA660A19C.quest_subtitle: "添加一个类似富文本的语音系统"
	quest.2E35F2A4FAE14DFC.quest_desc: [
		"&a深海银腿甲&r是永恒星光中用深海银锭&b制作&r的腿部护甲。"
		""
		"Deepsilver 盔甲&a能&r提升移动速度、攻击速度和击退抗性，全套穿戴则免疫多种&b负面&r效果。"
	]
	quest.2E35F2A4FAE14DFC.quest_subtitle: "迅捷的银色腿部护甲"
	quest.2E423B867205D22D.quest_desc: ["&6蓝图与羽毛笔&r能让你捕捉并保存结构为 Create 蓝图文件。右键选择区域的第一角，再选择&b对角&r来定义结构。在保存为 schematics 文件夹的 .nbt 文件前，你可以调整&b选区&r。保存后，可用蓝图台将结构加载到空白蓝图中，之后用蓝图发射器&b放置&r或建造。"]
	quest.2E423B867205D22D.quest_subtitle: "保存你的创造成果"
	quest.2E6D334A2AFD8D1A.quest_subtitle: "更多盔甲 (More Armor)"
	quest.2E76E25C0E285936.quest_desc: [
		"&aSteeleaf&r 是一种神秘的材质，存在于暮色森林中，隐藏在巨型&b树木&r和其他自然结构的空心树干里。它虽然看起来像普通的树叶，却兼具钢铁的强度和森林的魔力，是一种非凡的制造材料。"
		""
		"&aSteeleaf&r can be used to craft a complete set of armor, durable tools, and reliable weapons, making it one of the first major equipment upgrades available &bwithin&r the Twilight Forest."
	]
	quest.2E76E25C0E285936.quest_subtitle: "来自魔法森林的一份礼物"
	quest.2EBBEB2B3FBF7ACC.quest_desc: ["你探索&a高级&r&b材料&r的旅程仍在继续。这双靴子融合了下界合金的韧性与铁的可靠，为你提供更好的&a防护&r，助你长途跋涉、应对险境。"]
	quest.2EBBEB2B3FBF7ACC.quest_subtitle: "更强劲的步伐"
	quest.2EBBEB2B3FBF7ACC.title: "铁质下界合金靴子"
	quest.2EC744419A904B68.quest_desc: ["从Create模组中获取&6软管滑轮&r。它可以通过升降软管来排空或填充大型流体。当与&b机械泵和流体管道&r连接时，它可以从世界中抽取流体，或将流体&b输送&r到大型区域。在满足特定条件时，水和岩浆通常被视为&b无限&r流体源。"]
	quest.2EC744419A904B68.quest_subtitle: "驾驭浩瀚流体储备的强大力量"
	quest.2ECD7AAF2A7D9A68.quest_desc: [
		"Glacite Scythe 是一种源自 Eternal Starlight 的&a带有霜冻效果的&r区域武器，使用&bGlacite Ingots&r制作而成。"
		""
		"&aIt&r is &bused&r for wide-range melee attacks and applies slowing effects to enemies, making it &beffective&r for crowd control in cold biomes."
	]
	quest.2ECD7AAF2A7D9A68.quest_subtitle: "霜冻区域武器"
	quest.2ECEB94C026B5EF5.quest_desc: ["&a从&rCataclysm模组中获得焚化炉。锻造自Ignis的&b传奇&r力量，这把&b毁灭性&r的巨斧将敌人吞噬在灼热的火焰中，身后只留下灰烬。一把配得上那些&b征服&r了燃烧竞技场之人的武器。"]
	quest.2ECEB94C026B5EF5.quest_subtitle: "将所有东西都化为灰烬"
	quest.2ECEB94C026B5EF5.title: "&c焚化炉 (The Incinerator)"
	quest.2EF4BBA4470B35A0.quest_desc: [
		"&e有些&r力量，注定要抵抗。"
		""
		"Steadfast Spikes &bmake&r you completely immune to knockback and reduce the &bslipperiness&r of ice &bbeneath&r your feet. Whether you're fighting powerful enemies or &bcrossing&r frozen terrain, these spikes keep you firmly in control."
		""
		"&b坚守&r阵地。没有什么能将你击退。"
	]
	quest.2EF4BBA4470B35A0.quest_subtitle: "坚守阵地，不要后退半步"
	quest.2EFCA294AB118D03.quest_desc: ["&dHermomancer&r靴子是《水晶编年史》中Hermomancer盔甲套装的一部分，该套装是《Iron's Spells 'n Spellbooks》的&b附加包&r。"]
	quest.2EFCA294AB118D03.quest_subtitle: "驾驭赫尔莫曼德的强大力量"
	quest.2F051F1116EFDD82.quest_desc: ["使用Aquaculture 2制作&aNeptunium胸甲&r。这件强大的胸甲由Neptunium制成，这是一种通过钓鱼宝藏获得的&b稀有&r &b材料&r。它能提供出色的&b防护&r，是Neptunium盔甲套装的一部分。"]
	quest.2F051F1116EFDD82.quest_subtitle: "用海洋宝藏锻造的盔甲"
	quest.2F05AAB8DC941C72.quest_desc: ["&a从Aquaculture 2中获取&rNeptune's Bounty。这件&b稀有的&r钓鱼战利品可在钓鱼时获得，内含宝贵的海洋相关奖励。它是高级钓鱼期间可能&b发现的&r&b特殊&r宝藏之一。"]
	quest.2F05AAB8DC941C72.quest_subtitle: "来自深海的宝藏"
	quest.2F05DFA770A02239.quest_subtitle: "更多盔甲 (More Armor)"
	quest.2F0AC3A6DC8CC188.quest_desc: [
		"要在永恒星光中&a定位&r月球怪，必须使用寻眼与特定的自然材料。"
		""
		"&a将&rSeeking Eye握在主手，并在副手放置以下物品之一。"
		"只有这样，之眼才会指引你前往诅咒花园——首领所在的建筑。"
		""
		"有效物品："
		""
		"&b藤蔓&r"
		"&b月夜浆果&r"
		"&b洞穴苔藓 / 洞穴苔藓方块 / 洞穴苔藓地毯&r"
		"&b红晶苔（方块/地毯）&r"
		"&b蓝色水晶苔（方块/地毯）&r"
		"&b红色水晶根&r"
		"&b蓝色水晶根&r"
		""
		"这些&a物品&r与环境产生共鸣，能让之眼探测到正确的位置。"
	]
	quest.2F0AC3A6DC8CC188.quest_subtitle: "跟随月亮的信号前进"
	quest.2F0AC3A6DC8CC188.title: "寻找首领"
	quest.2F2A2E6FBF977E41.quest_desc: ["&6The&r Reactor Casing is a structural component &bused&r to build the reactor in Create: New Age. Assemble the casing together with the &brequired&r reactor components to create a stable structure capable of handling the intense heat &bgenerated&r during nuclear power production."]
	quest.2F2A2E6FBF977E41.quest_subtitle: "建造反应堆的基础设施"
	quest.2F3A00428DA266F7.quest_desc: [
		"&d邪恶骨环&r可提升法术投射物反弹次数+1，使兼容的法术投射物能额外反弹一次。这件&b强大的&r饰品能让单个投射物在目标间&b来回&r弹射，造成更巨大的威胁。"
		""
		"这枚戒指是 Ominous Dead King 的奖励，是任何 &b施法者&r 都梦寐以求的稀有珍贵装备。"
	]
	quest.2F3A00428DA266F7.quest_subtitle: "让你的法术在敌人之间来回弹射"
	quest.2F3E7E519FD38CAD.quest_desc: ["&a击败&r深板岩哨兵——守护着&b古代&r文明遗迹的强大守卫。与它一战，证明你已准备好深入探索古代堡垒的秘密。在 Archaion 的当前版本中，它的&b生命值&r已增至 &b100&r HP，护甲也增至 10"]
	quest.2F3E7E519FD38CAD.quest_subtitle: "远古堡垒的守护者"
	quest.2F3E7E519FD38CAD.title: "击杀深层板岩哨兵"
	quest.2F44A31E7A20C130.quest_desc: ["&a从Cataclysm模组中获得&r不可破坏的头骨。这件古老的&b遗物&r是与沙漠中被诅咒的战士们相关的稀有战利品。其不屈的特性&b象征着&r那些在对抗古代恐怖生物的战斗中&b幸存下来&r的勇士们的力量。"]
	quest.2F44A31E7A20C130.quest_subtitle: "不可阻挡的战士们的遗物"
	quest.2F55C2860311F78C.quest_desc: ["&a击败&r来自Cataclysm模组的15只Koboleton。这些骨骼爬行动物战士栖息在沙漠遗迹中，守护着那里的&b密室&r和宝藏。消灭它们才能安全地&b探索&r遗迹。"]
	quest.2F55C2860311F78C.quest_subtitle: "清理远古沙漠遗迹"
	quest.2F55C2860311F78C.title: "Koboleton"
	quest.2F77BADABEAD5873.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.2F93E1B532D8E13B.quest_desc: [
		"&dEvocation&r Rune 是 Iron's Spells 'n Spellbooks 中的一个合成材料，用于高级的与&bEvocation&r相关的合成，包括 Evocation Upgrade Orb。"
		""
		"将空白符文石与8颗祖母绿结合，&b创造&r一个召唤符文。祖母绿是召唤学派所需的魔法焦点。"
	]
	quest.2F93E1B532D8E13B.quest_subtitle: "用Evocation魔法的力量灌注一块符文石"
	quest.2F9BC357C443A396.quest_desc: [
		"&b借助&r预言之球的能量，你现在可以&a激活&r传送门，进入一个全新的维度——一个充满未知危险、奇特生物群系和强大秘密的世界。"
		""
		"这便是在永恒星光中开启的旅途的真正的&b开端&r。"
		"做好准备——一旦你&b踏入&r，除非承担风险，否则无法回头。"
	]
	quest.2F9BC357C443A396.quest_subtitle: "跨越那道帷幕，迈向未知"
	quest.2F9BC357C443A396.title: "&l&b步入&9星光之中"
	quest.2F9F0E46752067CF.quest_subtitle: "升级+"
	quest.2FAD369DA5B5A3C1.quest_desc: [
		"&9&lYour&r storage system is about to become a lot more sophisticated. With powerful storage blocks and &bupgradeable&r backpacks, you can organize your items, expand your capacity and take your supplies with you wherever you go."
		""
		"从你的&b基地&r到最深的洞穴，保持一切井然有序，触手可及。"
	]
	quest.2FAD369DA5B5A3C1.quest_subtitle: "更智能的存储，随时随地可用"
	quest.2FAD369DA5B5A3C1.title: "&l&b欢迎来到Sophisticated模组世界"
	quest.2FB6C3D80DBF4CC7.quest_desc: [
		"&6Give&r your locomotive a refined industrial &bappearance&r with the Copper Wrapped Locometal Boiler. Combining rugged Locometal with a copper exterior, this boiler is perfect for creating a &bdistinctive&r steam locomotive with a warm metallic finish."
		""
		"&b把它装到&r你的机车里，让铜闪闪发光。"
	]
	quest.2FB6C3D80DBF4CC7.quest_subtitle: "为尊贵的蒸汽机车提供铜质动力。"
	quest.2FC72A4BCC38597D.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.2FCE923A68B9541A.quest_desc: [
		"你的旅途正变得愈发危险，基础工具已不再够用。"
		"&aDiamonds allow you to craft&r stronger and more durable equipment that will help you mine faster and fight tougher enemies."
		""
		"有了这些强大的工具，收集资源和保护自己都会变得容易得多。"
	]
	quest.2FCE923A68B9541A.quest_subtitle: "一次真正的升级"
	quest.2FCE923A68B9541A.title: "钻石工具"
	quest.2FF11FA214BA1F33.quest_subtitle: "更多盔甲 (More Armor)"
	quest.2FFD72500A1A1AD1.quest_desc: ["&a回声战锤&r是一件与古代战士的&b神秘&r相关的独特武器。获得它是揭开一个已亡文明遗迹的又一个&b步骤&r。"]
	quest.2FFD72500A1A1AD1.quest_subtitle: "获取回响战锤 (Echo Mace)"
	quest.2FFD72500A1A1AD1.title: "&b回响战锤"
	quest.300FCFB0D0A8ABF6.quest_desc: [
		"&l&9每个&r&r伟大的存储系统&b都&r需要一个坚实的基础。升级底座是用于为存储容器创建强大升级的关键组件。"
		""
		"制作一个，&b开始&r将你的普通储物箱变成更高级的东西。"
	]
	quest.300FCFB0D0A8ABF6.quest_subtitle: "更优存储系统的基础设施"
	quest.30169528A9C24453.quest_desc: ["从Cataclysm模组中&a获取&r沙漠之怒。这把&b传奇&r弓是强大的远程武器，&b与&r古老的沙漠文明相关。驾驭沙尘暴的力量，用沙漠的&b愤怒&r从远处打击敌人。"]
	quest.30169528A9C24453.quest_subtitle: "能号令沙漠风暴的弓"
	quest.30169528A9C24453.title: "&eWrath Of The Desert"
	quest.301804DB605CE430.quest_desc: ["&dRainfall&r Serenity 是一款未来主义的长弓，能发射穿透目标的&b激光&r。它专为远程造成伤害而设计。其基础材料可由 Crescentia 的基础材料&b合成&r和酿造而成。"]
	quest.301804DB605CE430.quest_subtitle: "星辰如雨"
	quest.301804DB605CE430.title: "&l&9雨落之宁静"
	quest.304BC5C3121C8725.quest_desc: ["从Cataclysm模组中获取&aIgnitium升级锻造模板&r。这个&b稀有&r的模板是将下界合金&b装备&r升级为Ignitium装备所必需的，从而释放这种在Nether烈焰中锻造的&b传奇&r金属的全部潜力。"]
	quest.304BC5C3121C8725.quest_subtitle: "解锁伊格尼修姆的力量"
	quest.305111084C34764F.quest_subtitle: "更多盔甲 (More Armor)"
	quest.305E4A5E0198D58D.quest_desc: ["制作&6读卡器&r，并用它来验证用卡片刻写器&b制作&r的脚本卡片。它会检查卡片的注册信息，并能输出红石信号，因此&b适用于&r身份验证和自动化系统。"]
	quest.305E4A5E0198D58D.quest_subtitle: "验证你的脚本化卡牌"
	quest.309C1F26A5EA3BEC.quest_desc: ["&6Craft&r the Encased Chain Cogwheel and expand your kinetic &bnetwork&r with a compact chain-driven connection. It can &bconnect&r alongside other chain components, allowing &brotational&r power to travel through compact layouts and around corners. Its cogwheel can also connect to large cogwheels."]
	quest.309C1F26A5EA3BEC.quest_subtitle: "在所有方向上连接旋转部分"
	quest.30AA2D41FD209797.quest_desc: [
		"&d霜印之书&r是《Iron's Spells 'n Spellbooks》中&b顶级的&r冰系魔典。它提供&b12个&r法术位、&b+10%&r冰系法术强度和&b+200点&r最大法力值，是专精冰系魔法的法师的绝佳选择。"
		""
		"制作这本&b强大的&r魔典，掌控冰魔法的冻结之力。"
	]
	quest.30AA2D41FD209797.quest_subtitle: "掌控冰块的冻结之力"
	quest.30B39FFA91754BFE.quest_desc: [
		"&dCryomancer&r头盔是Crystal Chronicles对Iron's Spells 'n Spellbooks中Cryomancer兜帽的升级版。"
		""
		"使用 Cryolite Shard 进行 &b升级&r，它能 &b增强&r 原有的 Cryomancer Armor 套装，赋予其 &b额外的&r 结晶之力。Cryolite Shard 用冰魔法的力量强化了头盔，创造了原版 Cryomancer 装备的改进版。"
	]
	quest.30B39FFA91754BFE.quest_subtitle: "由 Cryolite 强化的 Cryomancer Hood 增强版"
	quest.30BB8A9C18CFE18E.quest_desc: [
		"&a击败&r遍布废弃堡垒的昆虫类生物——末影翼。"
		""
		"它们会掉落&b虚空颌骨&r，这是制作虚空散射箭所需的合成材料。"
	]
	quest.30BB8A9C18CFE18E.quest_subtitle: "废墟大厅中的昆虫们"
	quest.30C281D293B85B4F.quest_desc: ["&dA&r 用于 Hazen N Stuff 中各种配方来制作&b强力&r装备和特殊物品的稀有合成材料。"]
	quest.30C281D293B85B4F.quest_subtitle: "用于强大合成的稀有材料"
	quest.30CB87E7B9690B32.quest_desc: [
		"&9&lYour&r&r fluid storage has reached an enormous scale. The 4096B Fluid Storage Disk provides an immense &bamount&r of digital fluid storage, allowing your Refined Storage network to &bhold&r vast quantities of liquids in a single disk."
		""
		"将其插入磁盘驱动器，将你的&b集中式&r流体存储系统提升到全新水平。"
	]
	quest.30CB87E7B9690B32.quest_subtitle: "轻松处理巨量的流体储备"
	quest.30DB0BFD5B8949C8.quest_desc: ["&6酿造&r梅洛，一款适合自动化酿酒厂的经典红酒。 &b使用&r酒窖处理所需原料，将收获的葡萄转化为你酒品收藏的又一精致佳酿。创造：酿酒厂为创造模式添加了&b以葡萄酒为主题的&r配方和一个可完全自动化的酒窖。"]
	quest.30DB0BFD5B8949C8.quest_subtitle: "顺滑、浓郁，随时可以成熟"
	quest.30DFDB44C1070132.quest_subtitle: "更多盔甲 (More Armor)"
	quest.30E351C55C201DF1.quest_desc: ["&6Craft&r the Tube Scanner &bAttachment&r and add redstone detection to your Hypertube network. When an entity passes through the tube, the attachment emits a redstone signal, allowing you to trigger doors, machines, lights, or other &bautomated&r systems."]
	quest.30E351C55C201DF1.quest_subtitle: "侦测每一位旅行者"
	quest.30F4F283FB6379BB.quest_desc: [
		"&aCraft&r an Iron Hook, a reliable &bupgrade&r for any serious angler. Forged from sturdy iron, this hook is designed to withstand the pull of stronger catches and the &bchallenges&r of fishing in deeper waters."
		""
		"&aAs&r your journey takes you beyond simple &bfishing&r and toward the greatest treasures of the ocean, improving every part of your equipment &bbecomes&r essential. The Iron Hook is a small but important step toward mastering the seas."
	]
	quest.30F4F283FB6379BB.quest_subtitle: "海浪之下，握得更牢"
	quest.30F8EBE91C2E26C0.quest_subtitle: "更多盔甲 (More Armor)"
	quest.3109C994B3645D62.quest_desc: ["&a获取&r一块威瑟岩锭，这是一种融合了威瑟之力与&b古代文明&r技术的强大合金。这种稀有的&b材料&r可用于制造高级&b装备&r和机械融合砧。"]
	quest.3109C994B3645D62.quest_subtitle: "由凋零的本质锻造而成"
	quest.3109FC38A54D2EE5.quest_subtitle: "更多盔甲 (More Armor)"
	quest.3124CC63454C3569.quest_desc: [
		"&9&lTake&r&r your fluid storage to the next level with the 1024B Fluid Storage Disk. With vastly increased capacity, it allows your Refined Storage network to &bhold&r enormous quantities of fluids while keeping everything &baccessible&r from a centralized system."
		""
		"将其插入&b磁盘驱动器&r，并建造一个能容纳你最大储备量的流体存储网络。"
	]
	quest.3124CC63454C3569.quest_subtitle: "在一个磁盘里储存惊人的大量流体"
	quest.3127A14025718485.quest_desc: ["&6加特林破碎机&r是 Create: Dreams n' Desires 中的一种高级机械工具。专为快速破坏方块而设计，它能提供&b持续&r的机械力，使&b大规模&r挖掘和自动化采矿的速度大幅提升。"]
	quest.3127A14025718485.quest_subtitle: "以机关枪的速度破坏方块"
	quest.312F446F79636DC4.quest_desc: ["&6Craft&r the Fan Smoking Catalyst and use it in an Encased Fan setup to perform bulk smoking without needing a campfire in the airflow. It acts as a &bdedicated&r catalyst for Create's smoking recipes, keeping the &bprocessing&r setup compact and clean. Create: Connected includes Fan Catalysts as &bpart&r of its feature set."]
	quest.312F446F79636DC4.quest_subtitle: "没有篝火却有袅袅炊烟"
	quest.314065C484AF5254.quest_subtitle: "真美味！"
	quest.31420AEE989BC381.quest_desc: [
		"&a获得&r一个潜贝壳，潜贝壳由末地城市中的潜贝掉落。"
		""
		"用于制作潜影盒，也是虚空图腾模组中&b虚空不灭图腾&r的必需材料之一。"
	]
	quest.31420AEE989BC381.quest_subtitle: "悬浮物品堆叠的秘密所在"
	quest.31420AEE989BC381.title: "潜贝壳"
	quest.314735DD099CCAFC.quest_subtitle: "更多盔甲 (More Armor)"
	quest.3171206E89391DEF.quest_desc: ["&6The&r Handheld Saw is a portable tool from Create: Dreams n' Desires &bdesigned&r for quick material processing. Keep it on hand when working around your factory and &buse&r it to handle &bcutting&r tasks without relying on a stationary machine."]
	quest.3171206E89391DEF.quest_subtitle: "无论走到哪里，都能切割材料"
	quest.31798839F4E5E6CF.quest_desc: [
		"&a蜘蛛之眼&r由蜘蛛和洞穴蜘蛛掉落，常用于酿造药水。"
		"它们是酿造负面效果药水的关键材料，例如毒药、虚弱和隐身（发酵后）。"
		"小心处理——它们的毒性即使在&b炼金术&r形态下也&b很危险&r。"
	]
	quest.31798839F4E5E6CF.quest_subtitle: "有毒的酿造材料"
	quest.319E03DD80DA5441.quest_subtitle: "真美味！"
	quest.31A114861FB09266.quest_desc: [
		"&d衍射戒指&r是《水晶编年史》中一件&b强大的&r配饰。"
		""
		"要&b发挥&r其全部威力，你必须穿戴完整的棱镜骑士盔甲套装。穿戴完整套装并&b装备&r折射戒指后，按 R 键可切换当前魔法类型。"
		""
		"戒指&b允许&r棱镜骑士在&b不同类型的魔法之间&r切换，使完整的棱镜骑士套装极具多样性。"
	]
	quest.31A114861FB09266.quest_subtitle: "能让佩戴者改变魔法类型的棱镜戒指"
	quest.31A114861FB09266.title: "&l&c反&6应&e之&a环&b环&9环&d环&5环"
	quest.31A2EFE52AD1F45B.quest_desc: [
		"&9&lThe&r&r Oak Chest is one of the basic storage containers from Sophisticated Storage. It provides a reliable place to store your items while &bsupporting&r the mod's powerful upgrade system."
		""
		"&b将其用作&r存储系统的基石，未来可扩展更大容量、自动化和&b专业&r升级。"
	]
	quest.31A2EFE52AD1F45B.quest_subtitle: "开始建造你的复杂存储系统吧"
	quest.31ADB10258F9AA04.quest_desc: [
		"&6标准&r锅炉很有用，但钢铁能&b将&r性能更进一步。钢铁锅炉能为你的飞行器提供更强的动力，让你的机器突破基本性能的限制。"
		""
		"升级你的锅炉，让你的飞机为更&b高难度&r的飞行做好准备。"
	]
	quest.31ADB10258F9AA04.quest_subtitle: "追求更高性能飞行器的玩家，将获得更强的动力。"
	quest.31BF966ACD65359B.quest_desc: [
		"&dDivine&r Pearl is the Holy Focus in Iron's Spells 'n Spellbooks. It is &bused&r to create Holy spells in the Scroll Forge and to craft Holy Runes."
		""
		"用1个金锭和1个紫水晶碎片合成，或在魔法结构中查找。神圣珍珠是神圣魔法的核心&b焦点&r，专精于治疗、辅助和增益。"
	]
	quest.31BF966ACD65359B.quest_subtitle: "引导神圣学校的圣洁力量"
	quest.31C9751A66E461AF.quest_desc: ["&d一种&r特殊符文，&b用于&r在 Hazen N Stuff 中制作暗影武器和盔甲。"]
	quest.31C9751A66E461AF.quest_subtitle: "注入了暗影力量的符文刻印"
	quest.31D8E8CBEEE1B7B7.quest_desc: [
		"&aCraft&r the Knightmetal Chestplate using refined Knightmetal &bIngots&r forged from the &blegendary&r alloy of the Goblin Stronghold. Once worn by the fortress' elite defenders, this formidable armor was built to withstand &brelentless&r assaults and protect its bearer in the fiercest battles."
		""
		"&aAs&r the centerpiece of the Knightmetal Armor set, the &bchestplate&r combines incredible &bdurability&r with exceptional protection. Forged for those who refuse to yield, it stands as a symbol of unwavering courage and the enduring &blegacy&r of the ancient knights of the Twilight Forest."
	]
	quest.31D8E8CBEEE1B7B7.quest_subtitle: "坚不可摧的守护者的盔甲"
	quest.31E2FF67DAA74439.quest_desc: [
		"&aCarminite&r 是一种在黑暗塔中发现的神秘魔法材料。它由被遗忘的 &b实验&r 创造，并由远古能量驱动，是塔中许多奇特机器和 &b机械&r 装置的基础。"
		""
		"&a这种&r稀有资源是制作&b高级&r装置和暮色森林特有强力装备的必需品。掌握卡米尼特的秘密，你就能更近一步理解隐藏在黑暗塔中的被遗忘的&b科技&r。"
	]
	quest.31E2FF67DAA74439.quest_subtitle: "神秘的黑塔所拥有的神秘力量"
	quest.31E5091B64509956.quest_desc: ["&6线圈&r是许多设备的组成部分：仪表、电磁铁、转子、电机和继电器。用线圈右键点击两个创造转轴可以制作发电机绕组。"]
	quest.31E5091B64509956.quest_subtitle: "多种设备的线圈组件"
	quest.31F314955A039D53.quest_subtitle: "升级+"
	quest.31F69C866AC1F37F.quest_desc: [
		"&a盾牌&r是抵御敌人的&b必备&r工具。"
		"它能阻挡许多攻击，保护你免受弓箭和近战伤害。"
		""
		"制作一面盾牌，用它来在危险的战斗中生存下来。"
	]
	quest.31F69C866AC1F37F.quest_subtitle: "阻挡来袭的攻击"
	quest.324156897AAC5D6B.quest_desc: ["&6The&r world looks different from above. Immersive Aircraft brings a collection of rustic, vanilla-style aircraft &bdesigned&r for travel, transport and exploration. From the classic Biplane to the &bpowerful&r Warship, there is an aircraft for every kind of pilot."]
	quest.324156897AAC5D6B.quest_subtitle: "翱翔天际，从高空探索世界。"
	quest.324156897AAC5D6B.title: "&l&6欢迎来到沉浸式航空模组 Immersive Aircraft"
	quest.324A2404CAE5D9F2.quest_desc: ["星光钻石锄是永恒星光模组中一种&a中后期&r的农具，使用星光钻石材料制作。用于在&b高级&r生物群系中开垦农田，是&b进入&r天体终局材料前最高阶的耕作工具。"]
	quest.324A2404CAE5D9F2.quest_subtitle: "中后期用于收集天体资源的工具"
	quest.324ACE5BF3AA1334.title: "woooo"
	quest.3258322768C3F151.quest_desc: ["&aCraft&r a Cursium Helmet from the Cataclysm mod. This powerful helmet is created by upgrading a Netherite Helmet with a Cursium &bUpgrade&r Smithing Template and a Cursium Ingot in a Smithing Table. It is part of the Cursium armor set and grants the &bGhost Vision&r ability, &ballowing&r you to reveal living entities through walls"]
	quest.3258322768C3F151.quest_subtitle: "超越生者世界的界限，洞悉一切"
	quest.325B1738E6BD1883.quest_desc: [
		"&a制作&r一个保险箱，安全存放你最珍贵的物品。"
		"保险箱可提供额外保护，并帮助&b保持&r资源井然有序且安全存放。"
	]
	quest.325B1738E6BD1883.quest_subtitle: "保护好你的贵重物品"
	quest.325B1738E6BD1883.title: "安全"
	quest.325E233A78D94A7A.quest_desc: ["使用创造：糖果工艺制作&6圣诞拐杖糖铲子&r，让你的挖掘充满节日气息。它是圣诞拐杖糖工具套装的一部分，&b与&r圣诞拐杖糖镐、斧头、剑和锄头一同加入。"]
	quest.325E233A78D94A7A.quest_subtitle: "挖掘，带着一丝节日的甜蜜气息"
	quest.326849A066C4382D.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.32703A85EA177EB5.quest_subtitle: "真美味！"
	quest.327FF2355EE63073.title: "开始"
	quest.3284081D45B07AF8.quest_desc: [
		"&dTimeless&r Slurry 是 Iron's Spells 'n Spellbooks 中一种强大的合成材料。它通过在炼金锅中将普通药水与回声碎片&b加工&r而成。"
		""
		"需要将此&b神秘&r物质用于将破败镰刀升级为地狱之刃，将破败火焰剑&b升级为&r军团火焰剑。"
	]
	quest.3284081D45B07AF8.quest_subtitle: "能将远古武器转化的神秘精华"
	quest.3286B298FA2FF4AC.quest_desc: ["&a金色奖杯&r是 My Nether's Delight 的一款装饰性奖杯。其金色的外观使其成为引人注目的&b装饰品&r，也是你收藏品的绝佳补充。"]
	quest.3286B298FA2FF4AC.quest_subtitle: "收藏用的珍贵金色奖杯，价值连城"
	quest.32929A14BDF323D1.quest_desc: ["用于建筑和装饰的铜板&6楼梯&r。"]
	quest.32929A14BDF323D1.quest_subtitle: "正在铺设楼梯的板子"
	quest.32B6A7CA443F8DB5.quest_desc: ["&6Craft&r the Rohrflote pipe and expand your organ with another &bdistinctive&r flute stop. Rohrflote was &badded&r in Create: Sound of Steam 0.8.0 alongside six other new pipe types. It is a standard pipe stop rather than a reed pipe."]
	quest.32B6A7CA443F8DB5.quest_subtitle: "添加清晰明亮的长笛音色"
	quest.32C0207E83DBBDE3.quest_subtitle: "更多盔甲 (More Armor)"
	quest.32C8DB1CF4737725.quest_desc: [
		"&aMeef&r Stroganoff 是一道用从 Minoshroom 获得的稀有 Meef 制作的丰盛菜肴。它富含&b风味&r，并&b富含&r营养，能大量恢复饥饿值，是&b深入&r暮色森林前的完美餐食。"
		""
		"&a尽管&r最初是用&b迷宫&r守护者的肉制成的，但它已成为经验丰富的冒险者寻求&b力量&r以应对前方危险的最爱。"
	]
	quest.32C8DB1CF4737725.quest_subtitle: "一份适合无畏冒险者的丰盛大餐"
	quest.32D865C5E8120290.quest_desc: [
		"&dEvocation&r 升级球是 Iron's Spells 'n Spellbooks 中的一种升级材料。在 Arcane Anvil 上使用时，可提供 &b+5%&r 的 Evocation 法术强度。"
		""
		"它由 1 个空升级球和 8 个召唤符文&b合成&r而成。"
	]
	quest.32D865C5E8120290.quest_subtitle: "Infuse your equipment with the power of Evocation magic"
	quest.32F1FBCC32A13EF3.quest_desc: [
		"&aDeep&r within the ruins of the Sunken City lurks one of the most terrifying &bcreatures&r ever to emerge from the abyss—the Leviathan. Awakened through an ancient ritual, this colossal sea monster commands the crushing pressure of the deep and wields &bdevastating&r abyssal magic against anyone &bfoolish&r enough to challenge it."
		""
		"&aThe&r battle is a true test of courage, preparation, and endurance. &bBetween&r its powerful jaws, sweeping tentacles, and deadly ranged attacks, few &badventurers&r survive long enough to &bwitness&r its downfall. Only the strongest warriors can claim victory over the ruler of the deep."
	]
	quest.32F1FBCC32A13EF3.quest_subtitle: "征服深渊的统治者吧"
	quest.32F1FBCC32A13EF3.title: "&l&5利维坦巨兽"
	quest.330476E04E2E98F1.quest_subtitle: "更多盔甲 (More Armor)"
	quest.3305B00B00C05D3E.quest_desc: ["&6无人机控制器&r用于远程操控黄铜无人机。将其与无人机配对，即可远距离操控，无需直接&b交互&r就能&b操作&r你的飞行机器。控制器由&b4个&r黄铜锭和一个无线红石遥控器合成。"]
	quest.3305B00B00C05D3E.quest_subtitle: "远程操控，掌控全局"
	quest.331CF9517106F238.quest_desc: [
		"&a新月长矛&r是永恒星光中的一个&b近战&r武器，与高级进阶和月亮主题材料相关。"
		""
		"其确切的&a合成&r或获取方法在现有公开资料中并无明确记载，可能取决于 JEI 配方、战利品表或模组内的进度&b系统&r。"
	]
	quest.331CF9517106F238.quest_subtitle: "月亮锻造武器"
	quest.331CF9517106F238.title: "&6三日月之矛"
	quest.331F9072F848E6F9.quest_subtitle: "升级+"
	quest.334715382080142C.quest_desc: ["&6制作&r一块黑巧克力，享受来自 Create: Confectionery 的特色甜点。整块巧克力可以&b多次&r食用，并提供 Chocolated 效果，既是美味佳肴，也是冒险途中的实用&b零食&r。"]
	quest.334715382080142C.quest_subtitle: "给你的工厂带来一份丰厚的巧克力甜点"
	quest.334735A30E13C3B7.quest_desc: ["&6Craft&r the Black Chocolate Bucket and store liquid Black Chocolate for use in your confectionery factory. Fill the bucket with chocolate &busing&r a Spout, then place the chocolate back into the world when needed. Chocolate buckets can also be drained into Create's fluid systems."]
	quest.334735A30E13C3B7.quest_subtitle: "随身携带你的巧克力，走到哪里都带着它"
	quest.334BB22FEA032420.quest_desc: [
		"&l&9Your&r&r backpack can hold more than just items. The Tank Upgrade &badds&r fluid storage directly to your backpack, &ballowing&r you to carry water, lava and even fluids from other mods wherever you go."
		""
		"使用流体容器填充和&b排空&r储罐，或将背包放置在世界中时连接管道。堆叠升级也可以增加其流体容量。"
	]
	quest.334BB22FEA032420.quest_subtitle: "随身携带一整辆坦克，走到哪里都方便"
	quest.33659C3E32075EE6.quest_desc: ["&6酿造&r赤霞珠，一种由红葡萄制成的浓郁饱满的红酒。在创造：酿酒坊中，可以通过使用酒窖的&b自动化&r酿酒工艺来生产。赤霞珠以其&b深色水果&r风味、单宁强劲和陈年潜力而闻名。"]
	quest.33659C3E32075EE6.quest_subtitle: "来自葡萄园的经典之作，风味浓郁"
	quest.3377B06DCFCF2653.quest_subtitle: "更多盔甲 (More Armor)"
	quest.337FE86343F1B617.quest_subtitle: "更多盔甲 (More Armor)"
	quest.33AB148F957977D0.quest_desc: ["&6黄铜无人机&r是 Create Stuff 'N Additions 的一种远程&b操控&r飞行器。右键开启，然后用无人机控制器远程操控其移动。无人机可以通过模块进行&b升级&r，包括风扇模块、黄铜钻头、保险库模块和磁铁模块，从而获得额外功能。如果它着陆，就会停止飞行，直到你重新操控并起飞。无人机有 &b6&r 点生命值，操作时要留意它。"]
	quest.33AB148F957977D0.quest_subtitle: "天空中注视着你的眼睛"
	quest.33B0E8E7730AF096.quest_desc: ["&6Craft&r the Nasard pipe and add another &bdistinctive&r stop to your pipe organ. Nasard is one of the &boriginal&r pipe types in Create: Sound of Steam, introduced alongside Gedackt, Diapason, Gamba, Piccolo, Subbass and Trompette."]
	quest.33B0E8E7730AF096.quest_subtitle: "添加一个明亮和谐的音色"
	quest.33B8071BA96D19CE.quest_desc: ["&a击败&r来自Cataclysm模组的5只皇家德拉格。这些&b精英&r亡灵战士比普通德拉格更强，并用强大的&b近战&r攻击守卫着冰冻监狱的深处。"]
	quest.33B8071BA96D19CE.quest_subtitle: "击败冰冻王国的精英们"
	quest.33B8071BA96D19CE.title: "击杀皇家龙骑士（Royal Draugr）"
	quest.33CC03E36372168D.quest_subtitle: "真美味！"
	quest.33D9FA69D52EF86A.quest_desc: ["&6The&r casing most devices in this mod are built from: motors, gauges, fuses, contactors and more. You get it by applying a zinc ingot to an Andesite Casing."]
	quest.33D9FA69D52EF86A.quest_subtitle: "一个导电的外壳"
	quest.33F9F1682858EC41.quest_subtitle: "升级+"
	quest.33FDF3929EC2EA6F.quest_subtitle: "更多盔甲 (More Armor)"
	quest.34035A851B4A4368.quest_desc: ["&6The&r Fluid Gauge is a utility block from Create: Dreams n' Desires for monitoring fluid systems. Use it to keep track of fluids in your factory and make managing &blarge-scale&r fluid setups easier. In the &blatest&r 2.3a-BETA update, its display was also improved to show boiler statistics."]
	quest.34035A851B4A4368.quest_subtitle: "注意你的流体情况，不要出任何问题"
	quest.34077458979AB44B.quest_desc: ["&6垂直&r建造的发电机所用的垂直版换向器。"]
	quest.34077458979AB44B.quest_subtitle: "一个垂直换向器"
	quest.342459F281DDE795.quest_desc: [
		"&b使用&r一卷胶片并将其冲洗以创建已冲洗的胶片卷。"
		"这样你就可以使用 &aInterplanar Projector&r 来查看和投射你拍摄的照片了。"
	]
	quest.342459F281DDE795.quest_subtitle: "将你的照片变成珍贵的回忆"
	quest.342459F281DDE795.title: "已冲洗的胶卷卷筒"
	quest.3446602178E2A0B3.quest_desc: [
		"&d瘟疫&r斗篷是 Iron's Spells 'n Spellbooks 中瘟疫盔甲套装的胸甲。穿戴后可提供 &b+8&r 护甲、&b+125&r 最大法力、&b+10%&r 自然法术强度和 &b+5%&r 法术强度。它还可以附魔1个法术。"
		""
		"可以用 8 个 Arcane Cloth 和 1 个 Nature Rune 来 &b制作&r，也可以用 Wizard Robes + Nature Rune + Arcane Essence 合成。"
	]
	quest.3446602178E2A0B3.quest_subtitle: "引导自然魔法的剧毒力量"
	quest.349E7C15214FAEAC.quest_desc: ["&aCraft&r the Pharaoh's Sacred Hauberk from the Cataclysm: Spellbooks addon. This powerful mage chestpiece is part of the Pharaoh &bWizard&r Armor set, inspired by the Ancient Remnant and the forgotten kingdoms buried beneath the desert sands. It &benhances&r Sand magic and &bcomplements&r the Pharaoh's Wrath spell."]
	quest.349E7C15214FAEAC.quest_subtitle: "被古代法老祝福的祭司长袍"
	quest.34E70958A0464834.quest_subtitle: "真美味！"
	quest.34FB7DBF4A3DD1D3.quest_subtitle: "真美味！"
	quest.34FEE268EC380791.quest_desc: [
		"塔拉西姆斧是一种用塔拉西姆锭在铁砧上配合锻造锤打造的&a伐木&r和战斗工具。"
		""
		"这标志着 Better End 分级&b装备&r进阶的开始。"
	]
	quest.34FEE268EC380791.quest_subtitle: "第一等级的伐木工具"
	quest.351EDBECCA323AE7.quest_desc: [
		"&dThe&r Villager Bible is the dedicated spellbook of Holy magic in Iron's Spells 'n Spellbooks. It provides &b10&r spell slots, &b+10%&r Holy Spell Power, &b+10%&r Cast Time Reduction and &b+200&r Max Mana."
		""
		"获取它需要完成一个特殊任务，涉及 Evoker 堡垒、一本翻译过的书和牧师。 &b装备&r圣经，并用更快的施法速度和更大的法力池来&b强化&r你的神圣魔法。"
	]
	quest.351EDBECCA323AE7.quest_subtitle: "引导神圣魔法的力量，使其流动起来"
	quest.3523B50535B3C1D3.quest_subtitle: "更多盔甲 (More Armor)"
	quest.35302EBF03DA0C39.quest_desc: ["&6Filling&r Tanks 是 Create Stuff 'N Additions 的便携式流体容器，&b用于&r储存水或其他适用流体，并为使用流体作为燃料的 &b设备&r 提供燃料。它们有小、中、大三种尺寸，容量分别为 800 mB、1600 mB 和 3200 mB。较大的储罐可通过用铜锭升级较小的储罐来制作。在新版本中，Filling Tank 也&b可以&r使用 Create Spout 来填充。"]
	quest.35302EBF03DA0C39.quest_subtitle: "随身携带燃料，走到哪里都方便"
	quest.3536C832048D66FC.title: "村民基础版"
	quest.3549A7E70D88AE61.quest_desc: [
		"&d寒晶&r碎片是《水晶编年史》中的一种稀有升级材料。它&b用于&r将铁器魔法套装升级为增强版《水晶编年史》版本。"
		""
		"碎片&b引导&r着冰魔法的力量，为原本的霜魔装备增添额外的结晶之力。它也被用于制造冰锥破碎机，一种与增强后的霜魔装备&b相关&r的武器。"
	]
	quest.3549A7E70D88AE61.quest_subtitle: "能强化冰系法师装备的冷冻水晶碎片"
	quest.35805923D5A1F6E7.quest_desc: ["&6The&r Stirling Engine converts heat into rotational power. &bUse&r a temperature difference to &bgenerate&r mechanical energy and bring &banother&r source of power to your Create factory."]
	quest.35805923D5A1F6E7.quest_subtitle: "将热能转化为动能"
	quest.358AA0C44861DA9C.quest_subtitle: "真美味！"
	quest.358FCC0ABB311959.quest_desc: ["&6Craft&r the Chocolate Spout Gun and &buse&r chocolate as your ammunition. Fill the gun with chocolate using a Spout, then fire chocolate &bprojectiles&r at your targets. The chocolate variant is one of the &badditional&r Spout Guns included in Create: Misc \\& Things."]
	quest.358FCC0ABB311959.quest_subtitle: "让你的弹药更香甜一些"
	quest.3593AEF66A049D45.quest_desc: ["&6Heats&r 提供足够的 &bpower&r 即可加热气流。更高的 &bvoltage&r 能让气流足够热以进行批量爆破，线圈也能加快批量处理速度。"]
	quest.3593AEF66A049D45.quest_subtitle: "加热气流温度"
	quest.35953FC467B22FF4.quest_desc: [
		"&dArchevoker&r 护腿是 Iron's Spells 'n Spellbooks 中 Archevoker 盔甲套装的一部分。穿戴后可提供 &b+6&r 护甲、&b+125&r 最大法力、&b+10%&r 召唤术法术强度和 &b+5%&r 法术强度。"
		""
		"它们可以用 7 个 Arcane Cloth 和 1 个 Evocation Rune 来&b制作&r，或者在锻造台用 1 个 Evocation Rune 将 Wizard Leggings 升级而成。"
	]
	quest.35953FC467B22FF4.quest_subtitle: "通过你的盔甲，引导出召唤魔法的奥术力量"
	quest.359F7C86BA7C1B40.quest_desc: [
		"永恒锭胸甲可通过在锻造台用&a永恒锭&r锻造板升级泰拉尼亚胸甲制作。"
		""
		"It's part of Better End's strongest armor set, tougher than anything found &bvanilla&r Minecraft has to offer."
	]
	quest.359F7C86BA7C1B40.quest_subtitle: "最高防御等级的胸甲"
	quest.35DBA3484924C860.quest_desc: [
		"塔拉西姆靴子需要在锻造台用塔拉西姆板合成。"
		""
		"They complete the first full set of &aBetter End&r armor."
	]
	quest.35DBA3484924C860.quest_subtitle: "第一阶的靴子"
	quest.35E6A94C4A13A93F.quest_desc: [
		"&a深海银胸甲&r是永恒星光中一件使用深海银锭&b制作&r的防护盔甲。"
		""
		"Deepsilver 盔甲&a能提升&r移动速度、攻击速度和击退抗性，全套穿戴则免疫多种有害的&b状态&r效果。"
	]
	quest.35E6A94C4A13A93F.quest_subtitle: "迅捷的银色盔甲"
	quest.35EB1AF4A08681F9.quest_desc: ["&6欢迎来到&r创造与增添！本模组为创造增添了新工具、小工具和装备，为你带来全新的工作、战斗和&b移动&r方式。从&b强力&r工具和实用小工具，到能帮助你跳跃、漂浮甚至飞翔的装备，等你探索。第一步，探索新的&b科技&r，看看创造能为你做些什么。"]
	quest.35EB1AF4A08681F9.quest_subtitle: "更多工具，更强力量，更多可能性"
	quest.35EB1AF4A08681F9.title: "&l&6欢迎来到创造与添加模组包"
	quest.35EFE837F9540985.quest_desc: ["Glacite Axe 是 Eternal Starlight 的一款中阶&a伐木&r武器，由 Glacite Ingots &b制作&r而成。它适用于寒冷生物群系，既能伐木又能战斗，比低阶&b材料&r更耐用、更高效。"]
	quest.35EFE837F9540985.quest_subtitle: "冰冻伐木武器"
	quest.35FCD20F5631136A.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.3604977F6F031F3C.quest_subtitle: "更多盔甲 (More Armor)"
	quest.3610E6FEB72770D6.quest_subtitle: "更多盔甲 (More Armor)"
	quest.3619D91EB5232401.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.3625311FE17EE28A.quest_desc: [
		"要在永恒星光中正确地&a定位&r星光傀儡，你必须以特定方式使用寻光之眼。"
		""
		"&a将&rSeeking Eye握在主手，同时将所需物品之一放入副手。"
		"只有这样，之眼才会指引你前往哥莱姆的正确位置。"
		""
		"有效的&a副手&r物品："
		""
		"&b红石&r"
		"&bGolem Steel Ingot&r"
		"&b氧化钢锭&r"
		""
		"没有正确的设置，眼睛不会引导你到这场遭遇。"
	]
	quest.3625311FE17EE28A.quest_subtitle: "一次有向导的召唤仪式"
	quest.3625311FE17EE28A.title: "寻找首领"
	quest.3634820CA6FD2B83.quest_desc: [
		"&a寻找&rCataclysm 模组的 Ruined Citadel，这是一个隐藏在末地外围岛屿上的迷宫式建筑。"
		""
		"栖息着末影翼、末影傀儡和陷阱方块，可以用紫晶、潜贝壳和末影之眼合成的&b虚空之眼&r来追踪。"
	]
	quest.3634820CA6FD2B83.quest_subtitle: "紫晶与陷阱的迷宫"
	quest.3634820CA6FD2B83.title: "&l&d废弃的堡垒遗迹"
	quest.36403C854D3B2DCE.quest_desc: [
		"&a获取&r末地水晶，用于治愈末影龙并摧毁竞技场周围的黑曜石柱子。"
		""
		"它也是通过灌注仪式制作 Better End 的 &bEternal Crystal&r 的基础材料。"
	]
	quest.36403C854D3B2DCE.quest_subtitle: "末地水晶 (Crystal of the End)"
	quest.3645BEBA2FF8B974.quest_desc: ["使用灾变模组制作&a远古长矛&r。由远古金属锭锻造而成，这件&b传奇&r武器保留了远古沙之魔法的力量。其特殊&b能力&r会发射&b沙尘暴&r弹体，对敌人造成伤害并施加沙漠诅咒 II。"]
	quest.3645BEBA2FF8B974.quest_subtitle: "驾驭远古沙粒的力量，掌控一切"
	quest.364A7110B3B20F48.quest_desc: ["&a获得&rExcelsius Velocity Visor、Excelsius Adversary Visor和Excelsius Oppressor Visor。集齐这三种&b特殊&r目镜，证明你对Excelius武器库中&b不同&r路径的精通。"]
	quest.364A7110B3B20F48.quest_subtitle: "三个面罩，三条通往力量的道路"
	quest.366ADFEC023B0A7F.quest_desc: [
		"Glacite Hoe 是一种来自 Eternal Starlight 的&a农具&r，使用&bGlacite Ingots&r制作而成。"
		""
		"&a它&r被&b用&r来在寒冷生物群系中准备农田，代表了中等阶段的农业&b发展&r，比早期材料更耐用。"
	]
	quest.366ADFEC023B0A7F.quest_subtitle: "霜冻农场工具"
	quest.366E3BA33E060742.quest_desc: ["&6The&r Accumulator 是 Create Crafts \& Additions 中的一个&b储能&r方块。它能储存 Forge 能量 (FE)，并可连接到你的电气网络，将电力储存起来备用。它在平衡发电机和机器之间波动的功率需求方面尤其&b有用&r。Create Crafts \& Additions 的当前&bNeoForge 1.21.1&r版本为 1.6.0。"]
	quest.366E3BA33E060742.quest_subtitle: "储存能量，以备不时之需"
	quest.36A7E028835C70EF.quest_desc: [
		"&6Give&r your locomotives a proper industrial foundation. Riveted Locometal combines sturdy metal construction with rows of visible rivets, making it &bperfect&r for building rugged locomotive bodies, boilers and railway structures."
		""
		"一位专业铁路工程师的经典&b材料&r。"
	]
	quest.36A7E028835C70EF.quest_subtitle: "坚韧耐用，铆钉铸就，一步一个脚印。"
	quest.36BE3707A002FB69.quest_desc: [
		"&eExploring&r the depths is much easier when you don't have to worry about running out of air. The Snorkel lets you breathe underwater, giving you more time to &bexplore&r the ocean and uncover what lies beneath the surface."
		""
		"潜入水中，&b更久地&r待在水下。"
	]
	quest.36BE3707A002FB69.quest_subtitle: "在波涛之下自由呼吸"
	quest.36C7CFCB9119873F.quest_subtitle: "更多盔甲 (More Armor)"
	quest.36CB0DC6E0BFECA2.quest_subtitle: "真美味！"
	quest.36CFEE93D5653183.quest_desc: [
		"&dHellrazor&r 是 Iron's Spells 'n Spellbooks 中 Decrepit Scythe 的升级版。它可以被灌注 1 个法术，并且已预先灌注了 Raise Hell &bIII&r。"
		""
		"主手持有时，提供&b13&r点攻击力与&b1.4&r的攻击速度。Raise Hell &bIII&r造成&b15&r点伤害，影响半径为&b8格&r，施放次数为&b3&r次，消耗&b180&r点法力，并有&b12.5秒&r的冷却时间。"
		""
		"使用 1 份 Timeless Slurry 和 1 个 Pyrium Ingot 来&b升级&r这把破旧的镰刀。"
	]
	quest.36CFEE93D5653183.quest_subtitle: "释放远古镰刀的地狱之力"
	quest.36E1CA7A475EA71E.quest_desc: [
		"使用遍布暮色森林的附魔钢叶材料来&a制作&r钢叶镐。这把镐将非凡的耐久性与森林的魔法相结合，是开采古老地貌下&b隐藏&r的宝贵资源的绝佳&b选择&r。"
		""
		"&aAs&r part of the Steeleaf equipment set, it offers a dependable upgrade for explorers preparing to face stronger enemies and uncover the deeper &bsecrets&r of the Twilight Forest."
	]
	quest.36E1CA7A475EA71E.quest_subtitle: "用森林的力量去挖掘吧"
	quest.36E84F21DF00EA0B.quest_subtitle: "升级+"
	quest.36F89ABAEA7DE1E6.quest_subtitle: "更多盔甲 (More Armor)"
	quest.36F9EB566E250DF0.quest_subtitle: "更多盔甲 (More Armor)"
	quest.371A12D6E94E11E5.quest_subtitle: "更多盔甲 (More Armor)"
	quest.371E519C071F5626.quest_desc: [
		"在&a灌注基座&r周围，使用末地水晶、四个末影碎片和四个水晶碎片，通过灌注仪式来&a制作&r永恒水晶。"
		""
		"放置在&b永恒传送门&r的六个基座上，即可点燃通往主世界的入口。"
	]
	quest.371E519C071F5626.quest_subtitle: "开启永恒传送门的能量"
	quest.371E519C071F5626.title: "&d永恒水晶"
	quest.372C8BEB2A062663.quest_desc: [
		"&6Not&r every flight needs raw power. The Eco Engine is designed with efficiency in mind, reducing fuel &bconsumption&r at the cost of engine power. A perfect choice for long journeys where saving fuel matters more than speed."
		""
		"&b升级&r你的飞行器，让每一滴燃料都物尽其用。"
	]
	quest.372C8BEB2A062663.quest_subtitle: "燃料更少，旅途更远。"
	quest.372E31F066FFAC31.quest_desc: [
		"&dDivine&r Soulshard is a rare crafting material in Iron's Spells 'n Spellbooks, &bassociated&r with the Holy school of magic. It is used in &badvanced&r crafting recipes for powerful Holy equipment and magical items."
		""
		"寻找强大的神圣敌人和魔法结构，以获得这片珍贵的碎片，继续你的&b进阶&r，掌握更强大的神圣魔法。"
	]
	quest.372E31F066FFAC31.quest_subtitle: "驾驭一位陨落冠军的神圣精髓"
	quest.374BC40F43F0B18B.quest_desc: [
		"&9&l将&r&r你的基础Sophisticated Storage容器升级到铜质等级。 &b此&r升级会增强你的存储能力，并让你&b&r能够使用更高级的存储选项。"
		""
		"构建一个&b强大&r且高度可定制的存储系统的第一步。"
	]
	quest.374BC40F43F0B18B.quest_subtitle: "将你的储物空间升级到下一个层级"
	quest.374CD64FA84BBDA9.quest_desc: [
		"穿越世界可能需要花费大量时间。"
		"传送石能让你快速地在已发现的地点之间&a传送&r。"
		""
		"激活路标石后，它将被添加到你的网络中，你就可以从其他路标石传送到这里了。"
		""
		"它们非常适合用于探索、回家或在世界中的重要地点之间移动。"
		""
		"制作并放置你的&b第一块路标石&r。"
	]
	quest.374CD64FA84BBDA9.quest_subtitle: "快速旅行"
	quest.374CD64FA84BBDA9.title: "Waystone"
	quest.376A00BF686C345F.quest_desc: ["&6The&r Magnetite Block is an important material in Create: New Age, used as the &bfoundation&r for creating stronger magnetic components. Harness its magnetic &bproperties&r to progress toward &badvanced&r generators and electrical machinery."]
	quest.376A00BF686C345F.quest_subtitle: "磁能的基础知识，尽在掌握之中"
	quest.376E0C8776474535.quest_desc: [
		"&aCraft&r the Phantom Helmet using the rare &btreasures&r claimed from the defeated Knight Phantoms. Once worn by the spectral guardians of the Goblin Stronghold, this &benchanted&r helmet still carries the strength and honor of the ancient warriors who defended the fortress long after death."
		""
		"&aAs&r part of the Phantom Armor set, it offers &bexceptional&r protection and serves as proof that you have overcome one of the Twilight Forest's most &bchallenging&r group battles."
	]
	quest.376E0C8776474535.quest_subtitle: "堕落骑士的皇冠"
	quest.379A23CBBD48624B.quest_desc: ["在 Create: Confectionery 中制作&6完整巧克力棒&r，享受其&b持久&r耐饿的效果。该巧克力棒可食用16次，恢复饥饿并提供 Chocolated 效果。在新版本中，它被&b修改&r为更接近真实食物的行为。"]
	quest.379A23CBBD48624B.quest_subtitle: "一块能让你保持活力的巧克力棒"
	quest.379B7DD17002C62A.quest_desc: [
		"&aVenture&r 越过中央岛屿，抵达外围的末地——由末地传送门相连的小末地岛屿、末地中地和末地高地。"
		""
		"这里有紫颂树、末地城和潜影者，还有通往 Better End 新&b群系&r的入口。"
	]
	quest.379B7DD17002C62A.quest_subtitle: "外围岛屿"
	quest.379B7DD17002C62A.title: "普通末地"
	quest.37A3B4D9529109AC.quest_desc: ["&6获取&r一个来自Create的滑道。滑道用于垂直和斜向的物品运输。物品通常从上端移动到下端，滑道可以直接与上下方的&b物品栏&r&b交互&r。结合封闭式风扇，它们还可以&b改变&r物品的&b移动&r方向，将其向上输送。"]
	quest.37A3B4D9529109AC.quest_subtitle: "让重力来做这项工作"
	quest.37B354D8FDE65AF7.quest_desc: [
		"&dBoreal&r Blade 是 Iron's Spells 'n Spellbooks 模组中一把强大的魔法冰系双手剑。它可以被&b附魔&r1个法术，并自带 Frostbite &bIII&r 作为附魔法术。"
		""
		"主手持有时，提供&b16&r攻击力与&b0.9&r攻速。Frostbite III造成&b8&r碎裂伤害，持续&b30&r秒，消耗&b100&r法力，并有&b30秒&r冷却时间。"
		""
		"使用&bmithril和冰毒&r制作，是一款强大的&b后期&r冰系武器。"
	]
	quest.37B354D8FDE65AF7.quest_subtitle: "挥舞冰蜘蛛的冰冻之力"
	quest.37B44781A6EBC519.quest_desc: [
		"&9&l数&r&r字化存储网络的效用取决于其组件间的&b连接&r。电缆可将 Refined Storage 设备相互连接，在已连接的机器间传输电力和网络数据&b&r。"
		""
		"使用&b线缆&r扩展网络，将控制器、存储设备、电网和其他组件连接成一个统一系统。"
	]
	quest.37B44781A6EBC519.quest_subtitle: "连接你的存储网络的每一个部分"
	quest.37BEADEBB84C2E74.quest_desc: ["&6Craft&r the Roll Authoring Table and a Music Roll to begin &bcreating&r music for your mechanical organ. The Roll Authoring Table lets you &bprepare&r music rolls for the organ, opening the door to playing MIDI music inside Minecraft."]
	quest.37BEADEBB84C2E74.quest_subtitle: "谱写你自己的音乐"
	quest.37D932844D831D19.quest_desc: [
		"&d闪电&r升级球是 Iron's Spells 'n Spellbooks 中的一种升级材料。在神秘砧上使用时，可提供 &b+5%&r 的闪电法术强度。"
		""
		"它由1个空升级球和8个闪电符文制成。升级球可用于兼容的&b装备&r上，以提升其魔法威力。"
	]
	quest.37D932844D831D19.quest_subtitle: "用闪电魔法的力量来强化你的装备"
	quest.37DE6085DECF222C.quest_desc: ["&6获取&r一个来自Create的序列齿轮。它能通过执行最多&b5&r个命令的编程序列，实现对旋转动力的&b精确&r控制。你可以让它旋转特定角度、移动活塞或滑轮特定距离、等待定时延迟，或暂停直到接收到另一个红石脉冲。这使得它非常适合用于&b自动化&r和需要精确定时的装置。"]
	quest.37DE6085DECF222C.quest_subtitle: "编写运动程序"
	quest.37EF5D7EACBA8253.quest_subtitle: "更多盔甲 (More Armor)"
	quest.3803F98209D3B03F.quest_desc: ["&6Craft&r the Fan Blasting Catalyst and use it with a &bfan-based&r processing setup to perform blasting recipes without needing a lava source. It provides a compact alternative to placing lava in front of the fan, making &bautomated&r blasting setups cleaner and easier to build."]
	quest.3803F98209D3B03F.quest_subtitle: "没有熔岩的爆破体验"
	quest.380C98AC90E56CF5.quest_desc: [
		"&a星光钻石靴&r是永恒星光系列的高级鞋履，使用&b星光钻石&r制作而成。"
		""
		"星光钻石盔甲 &a提供&r与下界合金相当的防护，同时显著&b提升&r盔甲韧性和击退抗性。"
	]
	quest.380C98AC90E56CF5.quest_subtitle: "天体钻石制鞋履"
	quest.381A385CF39A6090.quest_subtitle: "升级+"
	quest.382304CA67C02B09.quest_desc: [
		"&dPriest&r Boots are part of the Priest Armor set in Iron's Spells 'n Spellbooks. When worn, they provide &b+3&r Armor, &b+125&r Max Mana, &b+10%&r Holy Spell Power and &b+5%&r Spell Power."
		""
		"They can be &bcrafted&r from 4 Arcane Cloth and 1 Holy Rune, or upgraded from Wizard Boots with 1 Holy Rune at a Smithing Table."
	]
	quest.382304CA67C02B09.quest_subtitle: "与神圣魔法的神圣力量同行"
	quest.3828CC1FE903C799.quest_desc: [
		"&a制作&r冰之剑，一把蕴含着暮色森林冰冻之地寒霜魔法的武器。由&b附魔&r冰和&b远古&r魔法锻造而成，其剑刃承载着永恒的冬季之力，让&b每一&r次挥砍都能剥夺敌人的体温和力量。"
		""
		"&a这把&r冰剑&b不仅&r是一件精良的武器，更是你征服冰冻荒野的象徵。无论是面对炽热的&b怪物&r还是强大的首领，它的冰冷锋刃都&b确保&r敌人能感受到冰川的寒意。"
	]
	quest.3828CC1FE903C799.quest_subtitle: "将你的敌人冻结在原地不动"
	quest.383F9EE23C04C97C.quest_subtitle: "更多盔甲 (More Armor)"
	quest.38459DCFB7E506F8.quest_desc: ["用蜂巢和线来制作&a蜡烛&r。蜡烛可以放置来装饰你的家，并在夜间提供&b光亮&r。"]
	quest.38459DCFB7E506F8.quest_subtitle: "点亮你的世界！"
	quest.38459DCFB7E506F8.title: "蜡烛"
	quest.3848B9AC3BC949B2.quest_desc: ["&d子弹&r是所有枪械的&b弹药&r。将它们放在物品栏中，并按下&b重新装填&r键来填充枪械的弹匣。许多修饰器也是由子弹制成的。"]
	quest.3848B9AC3BC949B2.quest_subtitle: "所有枪械的弹药都准备好了"
	quest.3859C15424161DB6.quest_desc: [
		"&6一列&r真正的火车，细节至关重要。安山岩、铜和黄铜的转向架台阶，不仅提供了实用的登车方式，还为你的火车增添了&b独特的&r工业气息。"
		""
		"&b收集&r所有三种变体，给你的火车画上应有的点睛之笔。"
	]
	quest.3859C15424161DB6.quest_subtitle: "三种金属，离完美列车更近了一步。"
	quest.3865DC29C1F7A4A4.quest_subtitle: "更多盔甲 (More Armor)"
	quest.3870EF72432AAB3C.quest_desc: [
		"永恒锭需要在铁砧上，用锻造锤来制作永恒锻造板。"
		""
		"在锻造台将其与一件 &bTerminite&r 盔甲和 Aeternium 升级模板结合，即可制作出一件 &bAeternium&r 盔甲。"
	]
	quest.3870EF72432AAB3C.quest_subtitle: "用于最强护甲的镀层材料"
	quest.388B016386760B13.quest_desc: ["&dHermomancer&r头盔是《水晶编年史》中Hermomancer盔甲套装的头盔，该模组是《Iron's Spells 'n Spellbooks》的&b附加包&r。"]
	quest.388B016386760B13.quest_subtitle: "驾驭赫罗曼瑟的力量，掌控一切"
	quest.38A9AD20D4A6BF68.quest_desc: ["&d巫师&r长袍是 Iron's Spells 'n Spellbooks 中基础巫师盔甲套装的&b一部&r分。它们由奥术布制成，提供专注于提升法力值和法术强度的魔法&b加成&r。"]
	quest.38A9AD20D4A6BF68.quest_subtitle: "将奥术之力灌注于你的长袍之中"
	quest.38E80402E9163612.quest_desc: [
		"&a织布台&r能让你制作羊毛和织物块的装饰性变种。"
		"用它来制作多彩的设计，装饰你的建筑吧。"
	]
	quest.38E80402E9163612.quest_subtitle: "编织新的图案设计"
	quest.38F6639BB82B5D7B.quest_desc: ["&6镀金石英剑&r是 Create Stuff 'N Additions 镀金石英工具套装的一部分。它拥有 1644 的耐久度，造成 8 点攻击&b伤害&r，并具有 1.8 的攻击速度，是强大的战斗武器。它由&b抛光玫瑰石英、铁板、黄金和锌制工具手柄&r合成。"]
	quest.38F6639BB82B5D7B.quest_subtitle: "带有金色边缘的玫瑰石英"
	quest.390BA55ED5D0EABE.quest_desc: [
		"&6赋予&r你的铁路&b建筑&r坚固的工业基础。Locometal Pillar将机车&b金属&r的粗犷外观融入简洁的建筑形式，非常适合支撑车站、桥梁、车间和其他铁路建筑。"
		""
		"用Locometal建造，让你的&b铁路&r巍然耸立。"
	]
	quest.390BA55ED5D0EABE.quest_subtitle: "为你的铁路帝国打下坚实的基础。"
	quest.391298DD11705526.quest_desc: [
		"&d瘟疫&r面具是 Iron's Spells 'n Spellbooks 中瘟疫盔甲套装的头盔。佩戴后可提供 &b+3&r 护甲、&b+125&r 最大法力、&b+10%&r 自然法术强度和 &b+5%&r 法术强度。"
		""
		"使用1个自然符文和1个奥术精华&b升级&r巫师头盔即可制作。"
	]
	quest.391298DD11705526.quest_subtitle: "驾驭自然魔法的狂野与剧毒之力"
	quest.39171469D2398312.quest_desc: ["黄金&a会赋予&r你的装备独特的&b特性&r。这双靴子可能不是最坚固的，但它们能提供敏捷性和特殊优势，能在棘手情况下&b帮助&r你生存。"]
	quest.39171469D2398312.quest_subtitle: "轻盈而迅捷"
	quest.39171469D2398312.title: "黄金下界合金靴子"
	quest.3928476B983E4DFE.quest_subtitle: "更多盔甲 (More Armor)"
	quest.3933A4162A6BB223.quest_desc: [
		"&aCraft&r the Seeker Bow, a remarkable &bweapon&r infused with the enchanted magic of the Twilight Forest. Unlike ordinary bows, its arrows &bpossess&r an uncanny &bability&r to seek out nearby enemies, bending through the air to strike targets that would otherwise escape a perfect shot."
		""
		"&aForged&r for hunters who value precision &babove&r all else, the Seeker Bow transforms every arrow into a relentless pursuit. Whether fighting swift &bmonsters&r or elusive foes, this legendary &bweapon&r ensures that few enemies can outrun its enchanted arrows."
	]
	quest.3933A4162A6BB223.quest_subtitle: "没有任何目标能逃脱它的瞄准"
	quest.3936B60A2971CE92.quest_desc: [
		"使用下界合金锭和锻造模板，将工具&a升级&r到下界合金。"
		"这些工具比钻石工具&b更&r耐用、更高效。"
	]
	quest.3936B60A2971CE92.quest_subtitle: "升级你的工具"
	quest.3936B60A2971CE92.title: "下界合金工具"
	quest.3938F9BC5003844F.quest_desc: ["&eA&r Game Disc that lets you play Flappy Bee &busing&r the Game Console. Control the bee, flap through the gaps and avoid the pipes to achieve the highest score. The disc can be obtained when a bee is &bkilled&r by a skeleton."]
	quest.3938F9BC5003844F.quest_subtitle: "挥舞你的蜜蜂，避开管道！"
	quest.395995BE44311602.quest_desc: [
		"合成&a紫晶基座&r，这是一种装饰性柱状方块，用于建造&a永恒传送门&r周围的环形结构。"
		""
		"它支持点燃通往主世界的&b传送门&r的永恒水晶。"
	]
	quest.395995BE44311602.quest_subtitle: "用于仪式的祭坛柱体"
	quest.395995BE44311602.title: "Purpur Pedestal"
	quest.396C1060A1064C21.quest_desc: [
		"&aFlowglaze 斧&r是永恒星光中的一个工具和武器，属于 Flowglaze &b装备&r系列。"
		""
		"&a它&r使用Flowglaze材料制作，是该模组中后期&b进阶&r系统的一部分。"
	]
	quest.396C1060A1064C21.quest_subtitle: "流动锻造斧"
	quest.396F8AD4C5B45321.quest_subtitle: "升级+"
	quest.39760FFD4F770930.quest_subtitle: "真美味！"
	quest.397F3A2525AC6915.quest_desc: ["从Cataclysm模组中&a获取&r风暴手套。这件&b传说级&r武器是一副强大的手套，能释放出毁灭性的风系攻击，驾驭风暴的力量&b对抗&r你的敌人。它是从海洋深处及其主宰生物中获得的罕见&b宝藏&r。"]
	quest.397F3A2525AC6915.quest_subtitle: "驾驭无尽风暴的力量，让它为你所用"
	quest.397F3A2525AC6915.title: "&e风暴手套 (Gauntlet Of Maelstrom)"
	quest.3987DDC1C8ABFA24.quest_desc: [
		"&a星焰镰刀&r是永恒星光中后期近战武器，属于星焰&b装备&r系列。"
		""
		"&aIt&r is designed for sweeping &battacks&r and enhanced combat reach compared to standard weapons."
	]
	quest.3987DDC1C8ABFA24.quest_subtitle: "星光收割武器"
	quest.39A8D3F548FACFD3.quest_desc: ["&6Craft&r the Crank Wheel and turn manual effort into mechanical power. Unlike a &bstandard&r Hand Crank, it includes a cogwheel, &ballowing&r it to connect directly to other gears and drive your kinetic network. It generates &b32&r RPM and provides a fixed &b256&r SU of stress capacity."]
	quest.39A8D3F548FACFD3.quest_subtitle: "手动为你的工厂提供动力"
	quest.39AF48307865E746.title: "oh sh*t"
	quest.39BB29B2BBB80DD4.quest_subtitle: "真美味！"
	quest.39BE05FFC9EE9414.quest_desc: ["&6Craft&r the Pipe Base, one of the fundamental &bcomponents&r of the pipe organ system in Create: Sound of Steam. It provides the base for mounting your organ pipes and is an essential step toward building a &bcomplete&r mechanical organ. The Pipe Base was &bintroduced&r alongside the first organ pipe stops in the mod."]
	quest.39BE05FFC9EE9414.quest_subtitle: "为您的管风琴管道铺设地基"
	quest.39C6D650D7C5C931.quest_desc: ["&6齿轮手柄&r是 Create: Dreams n' Desires 中一个简单的&b手摇&r组件。当没有其他动力&b源&r可用时，用它手动提供旋转力来驱动你的 Create 机械装置。"]
	quest.39C6D650D7C5C931.quest_subtitle: "让事情动起来"
	quest.39CCB7A19656B95D.quest_subtitle: "升级+"
	quest.39E398990DAE6E8A.quest_subtitle: "更多盔甲 (More Armor)"
	quest.39EE107B4B3B00A8.quest_desc: ["&6Fluxuated&r Magnetite 是 Create: New Age 中的一种高级磁性材料。其增强的磁特性使其成为&b更高级&r电气和磁性机械的&b重要&r组成部分。 &b使用&r它来将你的电力系统推向基本极限之上。"]
	quest.39EE107B4B3B00A8.quest_subtitle: "让你的磁力科技火力全开"
	quest.39F8DB8A4BF19415.quest_subtitle: "真美味！"
	quest.39FC1D6871E96DD4.quest_desc: ["&6获得&r一个来自Create的Flywheel。它是一种与Create旋转机械相关的机械组件。在现代&b版本&r中，Flywheel主要是一个装饰性组件，因为它在Furnace Engine中的旧作用已被移除；但它仍然是Create&b收藏&r中动能和机械组件的一部分。"]
	quest.39FC1D6871E96DD4.quest_subtitle: "保持运动持续转动下去"
	quest.3A03788C481BE56D.quest_desc: [
		"&aWithin&r Eternal Starlight, Starlight Crystal Blocks are dense formations of condensed &bcrystal&r energy."
		"但它们并非任何主要&b进度&r或合成系统所必需——它们主要作为稀有收藏品和展示资源而存在。"
		""
		"收集它们并非必需，而是探索精神的象征，而非&b力量&r的进阶。"
	]
	quest.3A03788C481BE56D.quest_subtitle: "固化的星光"
	quest.3A03788C481BE56D.title: "星光水晶方块"
	quest.3A0F51CFED89CDBB.quest_desc: [
		"&dBattle-Evoker&r Leggings 是 Crystal Chronicles 对 Iron’s Spells ’n Spellbooks 中 Archevoker Leggings 的升级版。"
		""
		"使用 Avaricite Shard 对其进行 &b升级&r，将原本的 Archevoker Armor 转变为强大的 Battle-Evoker Armor 套装。Avaricite Shard 为护腿注入了额外的 &bEvocation&r 魔法，创造出更强大的、&b专注于战斗&r 的 Archevoker 装备版本。"
	]
	quest.3A0F51CFED89CDBB.quest_subtitle: "由 Avaricite 强化的 Archevoker 护腿增强版"
	quest.3A241FDA02331592.quest_desc: ["&aDefeat&r 7 Glow Squid. These aquatic mobs can be &bfound&r in dark underwater areas, such as deep &boceans&r and underground water sources. Glow Squid drop Glow Ink Sac, which is &bused&r for glowing signs, item frames, and decorative purposes."]
	quest.3A241FDA02331592.quest_subtitle: "狩猎深海中的发光生物"
	quest.3A241FDA02331592.title: "击杀发光鱿鱼"
	quest.3A3249BEAB99922C.quest_desc: [
		"在最高&b等级&r的进度中，这顶头盔能提供无与伦比的耐久度和防御力。"
		"它旨在保护你免受最&a危险&r的战斗伤害。"
	]
	quest.3A3249BEAB99922C.quest_subtitle: "峰值保护机制"
	quest.3A3249BEAB99922C.title: "钻石下界合金头盔"
	quest.3A46EC4545D5CEA4.quest_desc: ["&a寻找&rL_Ender’s Cataclysm 中的 Acropolis。这座巨型建筑&b生成&r于深海，是风暴女皇 Scylla 的领地。使用 Eye of Storm 来&b定位&r&bAcropolis&r，揭开隐藏在波涛之下的远古堡垒。"]
	quest.3A46EC4545D5CEA4.quest_subtitle: "探索波浪之下的失落之城"
	quest.3A46EC4545D5CEA4.title: "&l&bAcropolis"
	quest.3A6B03B108CF0AE5.quest_desc: ["&6Deployer&r 是 Create 最通用的自动化组件之一。通电后，它会伸出手臂 &b2&r 格，模拟玩家的交互。默认情况下，它会执行右键操作，可以放置方块、&b使用&r物品、与机器互动、挤牛奶、剪羊毛、剥树皮、撒骨粉等。用&b扳手&r点击正面可切换到攻击模式，使其能用工具破坏方块或攻击实体。过滤器可以限制 Deployer 使用的物品，非常适合用于&b自动化&r生产和装置。"]
	quest.3A6B03B108CF0AE5.quest_subtitle: "让自动化系统开始工作"
	quest.3A6E892D4B563DF8.quest_desc: ["&6Craft&r the Fan Haunting Catalyst to perform haunting recipes &busing&r a &bfan-based&r processing setup. It provides a dedicated catalyst for the haunting process, letting you replace the usual soul fire setup with a compact &bcatalyst-based&r solution. The catalyst system is designed for Create's &bfan-processing&r mechanics."]
	quest.3A6E892D4B563DF8.quest_subtitle: "让你的工厂陷入混乱的运转中"
	quest.3A759AD208A1EF77.quest_subtitle: "更多盔甲 (More Armor)"
	quest.3A82061A372BB75D.title: "&l&b星光 &f哥布林"
	quest.3A8CA2237E845799.quest_desc: ["&d启用&r &b刺刀&r冲锋：向前猛冲，近战碾压敌人。用此方式击杀可解锁成就：带枪上战场？"]
	quest.3A8CA2237E845799.quest_subtitle: "冲啊！"
	quest.3A9BA82E032C71E9.quest_subtitle: "更多盔甲 (More Armor)"
	quest.3A9EEC3EB88D8038.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.3AA8749706C97EA1.quest_desc: [
		"Golem Steel 是 Eternal Starlight 中一种&a高级&r合成材料，可通过精炼 Starlight Golem 遭遇中掉落&b的&rOxidized Golem Steel Ingot 获得。"
		""
		"&aOnce&r refined, the ingot can be &bused&r for stronger equipment, weapons, tools, and additional crafting recipes added by the mod."
	]
	quest.3AA8749706C97EA1.quest_subtitle: "精炼构造金属"
	quest.3AA8749706C97EA1.title: "&dGolem Steel Ingot"
	quest.3AACA358B9373DF9.quest_desc: [
		"&e并非&r所有威胁都来自刀剑。"
		""
		"解毒剂容器能削弱&b有害&r状态效果，大幅缩短它们在身上的持续时间。有了这个小容器，中毒、凋零等负面效果就会变得不那么&b危险&r。"
		""
		"让治愈来消除毒液的影响吧。"
	]
	quest.3AACA358B9373DF9.quest_subtitle: "让毒液失去它的毒性，不再伤人"
	quest.3ABD2D8AD7ECE72B.quest_desc: ["&d秘术&r符文是 Iron's Spells 'n Spellbooks 的配方材料。它与秘术学派相关，并&b用于&r魔法制作。符文石是通过将空白符文石与所需学派的 8 个专注石&b融合&r来制作的。"]
	quest.3ABD2D8AD7ECE72B.quest_subtitle: "用纯粹的奥术魔法精华注入一块符文石"
	quest.3ABE6F522019BDF4.quest_desc: [
		"在永恒星光 &a风景&r 中，绯红 &a树木&r 以其深红色泽脱颖而出。"
		"它们的日志是用于制作、建造和推进维度进程的宝贵资源。"
		""
		"收集足够的&b绯红&r原木来扩展你的材料选择，并继续你的进度。"
	]
	quest.3ABE6F522019BDF4.quest_subtitle: "绯红的力量"
	quest.3ABE6F522019BDF4.title: "绯红木林"
	quest.3AC9F637627E7236.quest_desc: ["收集并&a实验&r各种&b小工具&r，帮助你在冒险和挑战中取得成功。"]
	quest.3AC9F637627E7236.quest_subtitle: "探索有用的工具和装置"
	quest.3AC9F637627E7236.title: "小工具"
	quest.3ACEBFEA2B03424E.quest_subtitle: "更多盔甲 (More Armor)"
	quest.3AE3CF39B3EF77BD.quest_subtitle: "更多盔甲 (More Armor)"
	quest.3B02EFDAF46A1B09.quest_desc: [
		"在屏幕底部，你会看到一个搜索栏。"
		"这是 &dJust Enough Items (JEI)&r——一款帮助你快速在游戏中查找物品的工具。"
		"例如，输入“Stone”，JEI就会在屏幕右侧显示所有与石头相关的物品。"
		"在单词前加上 &e@&r，可以筛选特定模组的物品，例如 &e@Addon&r。"
		"要将物品标记为收藏，请将光标悬停在上面并按 A 键，这样就能轻松找到它了。"
	]
	quest.3B02EFDAF46A1B09.quest_subtitle: "请先阅读此内容！"
	quest.3B02EFDAF46A1B09.title: "&dJust Enough Items(JEI)"
	quest.3B032DF7438E7A1F.quest_desc: [
		"Terminite 锻造板需要用锻造锤在铁砧上，用 Terminite 锭来制作。"
		""
		"这是锻造台制作全套&aTerminite&r盔甲的基础组件。"
	]
	quest.3B032DF7438E7A1F.quest_subtitle: "泰拉尼亚盔甲的镀层材料"
	quest.3B15BF306A65F852.quest_desc: [
		"&9&l用自动合成器来&r&r自动化你的合成。它能&b使用&r已存储的合成配方来自动生产所需物品，并从你的 Refined Storage 网络中直接获取&b资源&r。"
		""
		"&bConnect&r it to your network, provide the &brequired&r patterns and let your system handle crafting while you focus on bigger projects."
	]
	quest.3B15BF306A65F852.quest_subtitle: "将你的存储网络变成一台合成机器"
	quest.3B18663875A93CD8.quest_desc: [
		"&aObtain&r the Void Forge from Cataclysm, an upgraded crafting weapon fused using Void Cores at the &aMechanical Fusion Anvil&r."
		""
		"它代表了该模组后期较强大的&b武器&r升级之一。"
	]
	quest.3B18663875A93CD8.quest_subtitle: "将武器与虚空之力进行融合"
	quest.3B18663875A93CD8.title: "&d虚空锻造炉"
	quest.3B21F423411A58EA.quest_desc: ["&6经验之剑&r是Create Stuff 'N Additions模组中的一种特殊武器。成功击中生物时，它有几率&b生成&r一个经验球，&b让你&r在战斗中能获得额外的经验值。它拥有270点耐久度，造成5.5点攻击伤害，并具有2.0的攻击速度。使用2个经验堆和1个锌制工具柄即可&b制作&r。"]
	quest.3B21F423411A58EA.quest_subtitle: "将每场战斗都转化为经验值"
	quest.3B234BAB0CF6ABE7.quest_desc: [
		"&e当水流挡路时，&r何必减速慢行？"
		""
		"Aqua Dashers let you sprint &bacross&r the surface of fluids, allowing you to run over water without sinking. Perfect for crossing oceans, rivers and other watery obstacles without &bbreaking&r your stride."
		""
		"&b保持&r奔跑。水不会阻止你。"
	]
	quest.3B234BAB0CF6ABE7.quest_subtitle: "在他人游泳的地方奔跑"
	quest.3B312E7CA4D99D86.quest_desc: [
		"The Glacite Pickaxe is a &amining&r tool from Eternal Starlight crafted &busing&r Glacite Ingots."
		""
		"&a它&r用于寒冷生物群系的中阶采矿进阶，比早期的&b材料&r如Deepsilver和Amaramber效率更高。"
	]
	quest.3B312E7CA4D99D86.quest_subtitle: "霜冻采矿工具"
	quest.3B346442DD872D2A.quest_desc: [
		"&aCraft&r Runed Flavolite, a variant of Flavolite gathered in the Painted Mountains and inscribed for ritual use."
		""
		"需要建造一个&a永恒传送门&r的传送环，这是从末地深处返回主世界所用的结构。"
	]
	quest.3B346442DD872D2A.quest_subtitle: "引导仪式的石头"
	quest.3B346442DD872D2A.title: "&d符文风味石"
	quest.3B3E85DE3E5935B2.quest_desc: [
		"&aCraft&r the Knightmetal Greaves &busing&r &brefined&r Knightmetal Ingots forged from the legendary alloy of the Goblin Stronghold. Designed to protect a warrior's legs without &bsacrificing&r mobility, these greaves combine remarkable &bdurability&r with the masterful craftsmanship of the ancient knights."
		""
		"&aAs&r an essential part of the Knightmetal Armor set, they provide reliable &bprotection&r for every expedition through the Twilight Forest. Whether exploring forgotten ruins or facing powerful bosses, the &bKnightmetal Greaves&r ensure you can stand your ground against any threat."
	]
	quest.3B3E85DE3E5935B2.quest_subtitle: "堡垒守卫者配得上使用的盔甲"
	quest.3B48F8AFC5B3121E.quest_desc: ["&aCraft&r the Ignis Mage Leggings from the Cataclysm: Spellbooks addon. These &benchanted&r leggings are part of the Ignis Mage Robes set, &bcarrying&r the power of Ignis and the eternal flames of the Nether. They enhance the &bconnection&r between the wearer and the destructive force of fire magic."]
	quest.3B48F8AFC5B3121E.quest_subtitle: "由地狱魔法锻造而成的护腿"
	quest.3B559DC9EC7E4787.quest_desc: [
		"The Thermal Springstone Sword is a &afire-infused&r weapon from Eternal Starlight crafted &busing&r Thermal Springstone Ingots."
		""
		"&a它&r能造成中等伤害并施加强烈的灼烧效果，使其在星光维度中对抗中前期阶段的生物时&b十分有效&r。"
	]
	quest.3B559DC9EC7E4787.quest_subtitle: "地热燃烧之刃"
	quest.3B5914CBE7904874.quest_desc: ["&6A&r bucket of acid, the liquid used to etch circuit boards and pour into batteries. Make acid in a Create mixer from &bredstone&r, blaze powder and water."]
	quest.3B5914CBE7904874.quest_subtitle: "蚀刻酸"
	quest.3B8820B3D65D3C3B.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.3B8DD58693FDC198.quest_subtitle: "真美味！"
	quest.3B9B3230B794BAB4.quest_desc: ["&eA&r Game Disc that lets you play Blocktris using the Game Console. Place and rotate the falling pieces to fill &bcomplete&r lines and score points. &bUse&r A and D to move, W to rotate, S to move down, SPACE for a hard &bdrop&r and ENTER to hold a piece."]
	quest.3B9B3230B794BAB4.quest_subtitle: "拼好方块，消除连线，获得最高分！"
	quest.3BA85A17B29682A9.quest_desc: [
		"&d欢迎来到&rIron's Arms 'n Artifice，一个关于&b枪支&r和使其致命的巧妙齿轮的模组。枪支通过弹匣发射&b子弹&r，用重载键即可重新装填，每种枪支都有&b修饰器&r插槽，可填充以改变其行为。"
		""
		"&d完成&r任务，制作弹药，建造更强大的武器，并为每种玩法解锁修饰器。"
	]
	quest.3BA85A17B29682A9.quest_subtitle: "先武装，再改造"
	quest.3BA85A17B29682A9.title: "&d&l欢迎来到 Iron's Arms 'n Artifice"
	quest.3BAF72E5640B7358.quest_desc: [
		"&e有时候&r，生存的最佳方式就是让自己不被发现。"
		""
		"这条&b神秘&r的围巾能让穿戴者隐身，隐藏身形于世界之中，同时盔甲和手持物品依然可见。非常适合悄悄溜过敌人、侦察&b危险&r地带，或者在局势失控时直接消失。"
		""
		"&b保持&r隐蔽。保持生存。"
	]
	quest.3BAF72E5640B7358.quest_subtitle: "不留任何痕迹地消失不见"
	quest.3BE25C828669ABC8.quest_desc: [
		"&dLegionnaire&r Flamberge is the upgraded version of the Decrepit Flamberge in Iron's Spells 'n Spellbooks. It has &b11&r Attack Damage, &b1.5&r Attack Speed and &b+4&r Armor."
		""
		"在锻造台使用1个永恒泥浆和1个火钢锭来&b升级&r破败的火焰剑。"
	]
	quest.3BE25C828669ABC8.quest_subtitle: "将这把古老的利刃恢复其完整的火焰荣耀"
	quest.3BFCB485B9144396.quest_desc: [
		"&aCraft&r the Fiery Sword using Fiery Ingots forged from the blazing essence of the Hydra. This &blegendary&r weapon burns with an everlasting flame, striking enemies with both steel and fire. Every swing &bcarries&r the fury of the Fire Swamp, making it a fearsome choice &bagainst&r even the toughest foes."
		""
		"&aForged&r by combining masterful &bcraftsmanship&r with the Hydra's power, the Fiery Sword is a symbol of your triumph over one of the Twilight Forest's greatest challenges and a weapon worthy of the &badventures&r still to come."
	]
	quest.3BFCB485B9144396.quest_subtitle: "释放九头蛇的火焰之力"
	quest.3C0543DB0409499A.quest_subtitle: "真美味！"
	quest.3C0E5701F69D9970.quest_desc: ["&a回声钥匙&r能让你打开远古堡垒中隐藏的深板岩&b宝库&r。要获得钥匙，就必须完成深板岩试炼，并击败遇到的&b敌人&r。宝库里有贵重物品、材料、附魔，以及后续进阶所需的&b回声充能&r。"]
	quest.3C0E5701F69D9970.quest_subtitle: "被遗忘宝库的钥匙 Key to the Forgotten Vaults"
	quest.3C16E628EDD80C31.quest_desc: ["&6黄铜工具&r是 Create Stuff 'N Additions 添加的一套完整工具。该套装包括镐、斧、剑、铲子和锄，为你提供一套由 Create 黄铜制成的&b耐用&r工具。这些工具有 &b450&r 的耐久度，并为黄铜提供了另一种&b实用&r用途，&b超越了&r建造机械的范畴。"]
	quest.3C16E628EDD80C31.quest_subtitle: "让黄铜发挥作用吧"
	quest.3C16E628EDD80C31.title: "黄铜工具"
	quest.3C1D418D14110BE9.quest_desc: ["&6Calcium&r Rich Powder is a crafting ingredient added in Create: Aquatic Ambitions 2.0. It is used in several of the mod's &bnew&r recipes and helps expand the aquatic production chain, including recipes connected to Calcite and Spiky Shells. It was &bintroduced&r alongside the other &bmajor&r 2.0 features."]
	quest.3C1D418D14110BE9.quest_subtitle: "丰富你的水生生物产出"
	quest.3C3332B54F1FF5D1.quest_subtitle: "真美味！"
	quest.3C403AF9AB388DF7.quest_desc: ["&6镀金石英镐&r是 Create Stuff 'N Additions 模组中一种强大的镐，由抛光玫瑰石英、黄金和铁板制成。它具有 &b1644&r 的耐久度、黑曜石级别的&b挖掘&r能力，并造成 &b4&r 的攻击伤害，攻击速度为 &b1.2&r。它能挖掘黑曜石和远古残骸等方块，是钻石镐的强力&b替代品&r。"]
	quest.3C403AF9AB388DF7.quest_subtitle: "玫瑰石英的金色边缘装饰"
	quest.3C4734213A90B8AC.quest_desc: [
		"&6航空学&r不仅关乎动力——效率也很重要。工业齿轮&b能&r改善飞机的内部构造，将油耗降低20%。"
		""
		"将它们&b安装&r到您的飞机上，让每一滴燃料都更耐用。"
	]
	quest.3C4734213A90B8AC.quest_subtitle: "精密工程，实现更高效飞行。"
	quest.3C5DE918135EB728.quest_desc: ["&a探险家指南针&r是一种用于定位世界中各种建筑的导航工具。你的&b任务&r是获取指南针，并&b使用&r它来寻找选定的建筑，它会直接引导你前往该建筑的位置。"]
	quest.3C5DE918135EB728.quest_subtitle: "获取并使用探险家指南针来定位一个结构"
	quest.3C5FD7C5942F32A8.quest_desc: [
		"在永恒星光闪烁的 &b区域&r中，结晶化的飞蛾如光之碎片般在空中飘荡。"
		"尽管它们看起来很脆弱，但它们会主动攻击，受到惊扰时会以&a群体&r形式发起进攻。"
		""
		"&aTheir&r bodies are infused with &bstarlight&r crystals, making them both dangerous enemies and valuable sources of rare materials."
	]
	quest.3C5FD7C5942F32A8.quest_subtitle: "发光的掠食者"
	quest.3C5FD7C5942F32A8.title: "结晶化的飞蛾"
	quest.3C7082F5ECB64ED5.quest_desc: [
		"星光钻石剑是永恒星光中&a后期&r武器，由0.5.0版本引入的星光钻石&b材料&r制作而成。"
		""
		"&a它&r是Glacite和Springstone等中阶装备的重要&b升级&r，在达到&b真正&r的天体级武器前，为后期提供稳定的高伤害。"
	]
	quest.3C7082F5ECB64ED5.quest_subtitle: "中后期的天体之刃"
	quest.3C9063F2E85E5EBD.quest_desc: ["&6Turn&r your chocolate into a small, delicious treat. Fill a Caramel Bar, Chocolate Bar or White Chocolate Bar with 250 mB of Dark Chocolate to create Dark Chocolate Candy. A single &bpiece&r restores 8 hunger and 11 saturation."]
	quest.3C9063F2E85E5EBD.quest_subtitle: "一种填满了浓郁黑巧克力的迷你甜点。"
	quest.3C9828D3B974A763.quest_desc: ["从Cataclysm模组中&a获取&r深渊之卵。这件神秘遗物源自利维坦的领域，承载着无尽深渊的&b精髓&r。它是从海洋最深处回收的最稀有的&b宝藏&r之一。"]
	quest.3C9828D3B974A763.quest_subtitle: "来自深渊深处的古老遗物"
	quest.3C9DA2A6505AC8DB.quest_desc: ["从附近的树上收集&a一些&r木头。木头是基础资源，可用于制作工具、家具和许多其他对&b生存&r和&b探索&r世界至关重要的物品。"]
	quest.3C9DA2A6505AC8DB.quest_subtitle: "收集基本资源，开启你的冒险之旅"
	quest.3C9DA2A6505AC8DB.title: "&#A56701第一份&#6A3B1D木材"
	quest.3CB6D7A92AB424D6.quest_subtitle: "更多盔甲 (More Armor)"
	quest.3CB705697C33FFE0.quest_desc: [
		"&9&lTurn&r&r your storage into a personal music station with the Jukebox Upgrade. It allows you to play music discs directly from your storage, giving you &baccess&r to your favorite tunes without &bneeding&r a separate jukebox."
		""
		"高级唱片机升级扩展了你的音乐选择，让你能更好地控制音乐唱片和&b播放&r，无论唱片放在哪里，都能尽情享受你的收藏。"
	]
	quest.3CB705697C33FFE0.quest_subtitle: "把你最喜欢的音乐带到你的储物空间里"
	quest.3CB705697C33FFE0.title: "唱片机 \& 高级唱片机升级"
	quest.3CB7668BAAABA7E1.quest_desc: [
		"&dCultist&r Hood 是 Iron's Spells 'n Spellbooks 中 Cultist Armor 套装的头盔。穿戴后可提供 &b+3&r 护甲、&b+125&r 最大法力、&b+10%&r 血系法术强度和 &b+5%&r 法术强度。"
		""
		"它可以用5个奥术布和1个血符文制作，或在当前版本中用血符文在锻造台&b升级&r法师兜帽。"
	]
	quest.3CB7668BAAABA7E1.quest_subtitle: "引导血魔法的黑暗力量"
	quest.3CD152D1AD3DC1BC.quest_desc: ["&6The&r Enchanting Template is a special item from Create: Enchantment Industry &bused&r in the mod's automated enchanting system. It is associated with the Blaze Enchanter and &ballows&r enchantments to be &bprocessed&r and applied through Create's machinery. In newer versions, the unenchanted Enchanting Template no longer has an &benchantment&r glint, making it easier to &bdistinguish&r from an enchanted template."]
	quest.3CD152D1AD3DC1BC.quest_subtitle: "准备好自动附魔了"
	quest.3CE36639F3E12DA3.quest_desc: [
		"永恒锭镐是一款顶级的&a采矿&r工具，因其永恒锭组件而比下界合金更坚固耐用。"
		""
		"永恒锭由&b泰拉纳&r和下界合金锻造而成，或在更好的末地结构中作为稀有战利品找到。"
	]
	quest.3CE36639F3E12DA3.quest_subtitle: "最高阶的采矿工具"
	quest.3CEE204304776F95.quest_desc: ["&aThe&r Nether Stove is a specialized cooking station from My Nether's Delight, &bdesigned&r for preparing food &busing&r ingredients found in the Nether. It brings the cooking mechanics of Farmer's Delight &binto&r the fiery depths of the Nether."]
	quest.3CEE204304776F95.quest_subtitle: "专为下界打造的火焰烹饪台"
	quest.3CF0B31B8952042F.quest_desc: [
		"&a权杖&r of Fortification 是一件从 Twilight Lich 处获得的&b强大&r魔法物品。它曾属于统治 Lich Tower 的诅咒术士，并&b注入了&r不稳定的防御魔法。"
		""
		"&a这根&r权杖能让使用者创造防护屏障或堡垒，是战斗和生存中都非常宝贵的工具。然而，它的力量有限，并且&b需要&r谨慎使用，因为它直接从&b古老&r而不稳定的魔法来源中汲取能量。"
	]
	quest.3CF0B31B8952042F.quest_subtitle: "巫妖遗失的力量碎片之一"
	quest.3CF5DD022720CDBD.quest_subtitle: "更多盔甲 (More Armor)"
	quest.3D02C1DC3BAD13EC.quest_desc: ["从 Create 模组中获取&6&r精密机制。这种先进的&b&r合成组件需要通过&b&r序列组装，使用金锭、齿轮、大型齿轮和铁粒来制作。它是制造&b&r机械臂、伸缩爪、土豆炮、旋转速度控制器、对称法杖和火车控制器等高级机械的必备组件。"]
	quest.3D02C1DC3BAD13EC.quest_subtitle: "掌握精准的艺术，成为真正的匠人"
	quest.3D048F3702C13593.quest_desc: [
		"&a探索&r发光草原，这片覆盖着多彩植物和大型花朵的开阔地，&b照亮&r着周围，萤火虫在其中飞舞。"
		""
		"在这里，你不仅能找到用于制作吊灯、与该生物群系&b绚丽&r植物相关的Loom Corn，还有其他材料。"
	]
	quest.3D048F3702C13593.quest_subtitle: "被照亮的田野"
	quest.3D048F3702C13593.title: "发光的草原"
	quest.3D0D6BD228A40DB0.quest_desc: [
		"&aCraft&r a Diamond Hook, an exceptional upgrade &bdesigned&r for the most dedicated anglers. Forged with the strength of diamonds, this hook offers unmatched durability and reliability, allowing you to pursue rare &bfish&r and valuable treasures hidden within the deepest waters."
		""
		"&aOnly&r those who have &bmastered&r the art of fishing and gathered the finest materials can create such a remarkable tool. The Diamond Hook represents your dedication and prepares you for the greatest &bdiscoveries&r the oceans have to offer."
	]
	quest.3D0D6BD228A40DB0.quest_subtitle: "传奇捕获的完美抓握力"
	quest.3D43A15A063440AC.quest_subtitle: "更多盔甲 (More Armor)"
	quest.3D508229A4EF2EBA.quest_desc: ["&a煎锅&r是 Farmer's Delight 的一种烹饪工具，&b用于&r煎炸和&b准备&r各种食材。它&b很有用&r，能制作多种菜肴，让烹饪更便捷高效。"]
	quest.3D508229A4EF2EBA.quest_subtitle: "一个方便烹饪各种菜肴的平底锅"
	quest.3D6015E933436AD3.quest_desc: ["&6从Create中获取&r下界合金潜水靴。它们是潜水靴的升级版，在保留特殊潜水能力的同时，提供了&b更佳的&r防护。穿戴后，能让你在液体中下沉得更快，可以&b在水下行走&r和&b跳跃&r，并且不会被&b机械带&r所影响。它们可以通过使用&b一个下界合金锭&r从铜制潜水靴升级而来。"]
	quest.3D6015E933436AD3.quest_subtitle: "走向水流湍急的深邃之处"
	quest.3DA1BF04DF070E87.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.3DB00A7A20534E0E.quest_desc: ["&6Build&r the Mechanical Extruder and unlock a new way to &bautomate&r resource production. By using adjacent blocks and fluids together with &brotational&r power, the extruder can generate different blocks and items. The 1.21.1 version also supports recipe &brequirements&r such as speed, height, and biome, opening the door to more specialized production setups."]
	quest.3DB00A7A20534E0E.quest_subtitle: "挤出你的自动化之路"
	quest.3DBBEF47766A607B.quest_desc: [
		"使用融入了暮色森林古老魔法的铁木锭，&a锻造&r出铁木胸甲。这款胸甲融合了铁与魔法森林的能量，&b为&r冒险者提供卓越的耐久度和可靠的防护，助其探索愈发危险的区域。"
		""
		"&aAs&r the centerpiece of the Ironwood Armor set, it greatly enhances your &bsurvivability&r and prepares you for the powerful bosses and forgotten dungeons hidden throughout the Twilight Forest."
	]
	quest.3DBBEF47766A607B.quest_subtitle: "由附魔铁锻造而成的保护"
	quest.3DC56637C9258EAB.quest_desc: [
		"需要永恒锭锤和永恒锭，才能将&a永恒锭&r锻造成板材和工具头。"
		""
		"这是达到 Better End 的&b最强&r装备等级所需的最后一个合成台。"
	]
	quest.3DC56637C9258EAB.quest_subtitle: "锻造最坚固的金属"
	quest.3DCFD37B2600A64D.quest_desc: ["&d一种&r特殊符文，用于在 Hazen N Stuff 中&b制作&r光辉装备和物品。"]
	quest.3DCFD37B2600A64D.quest_subtitle: "注入了光辉力量的符文"
	quest.3DE72CFC5A9D58D4.quest_desc: ["&6为&r你的电网提供 0 V 的&b接地&r参考。你可以用它来传输&b电力&r，但要小心：高电位和接地不良会导致地面带电，并对附近的实体造成伤害。导电方块可以改善接地效果。"]
	quest.3DE72CFC5A9D58D4.quest_subtitle: "一根接地棒"
	quest.3E02EDA7B1E00F3C.quest_desc: [
		"使用从哥布林堡垒中回收的&b精炼&r骑士金属锭来制作&a骑士金属斧&r。这把斧头由以无与伦比的韧性闻名的古代合金锻造而成，无论是砍倒&b参天&r大树还是劈开重甲敌人，都同样有效。"
		""
		"&a它&r锋利无比，经久耐用，体现了昔日&b守护&r暮色森林的骑士们的精湛工艺。无论是采集资源还是面对强敌，&b骑士金属&r斧都是每次探险的可靠伙伴。"
	]
	quest.3E02EDA7B1E00F3C.quest_subtitle: "为战斗和木材而锻造，两者皆宜"
	quest.3E1EF903B1766A34.quest_desc: ["&6A&r tool for removing &bwires&r. Right-click a wire to remove a hanging wire or a selected segment of a block wire; Shift + right-click removes the whole block wire. Keep it handy whenever you build wiring."]
	quest.3E1EF903B1766A34.quest_subtitle: "用于移除电线的工具"
	quest.3E3A379D3259AC90.quest_subtitle: "更多盔甲 (More Armor)"
	quest.3E5817559D2F96EE.quest_desc: [
		"&l&9你的&r&r背包不必塞满垃圾。虚空升级会自动销毁符合你筛选条件的物品，防止不想要的掉落物占用&b宝贵的&r存储空间。"
		""
		"需要更多控制？高级虚空升级通过增加更多槽位和&b额外&r过滤选项来扩展过滤系统，让你能精确控制哪些物品会消失于虚空。"
	]
	quest.3E5817559D2F96EE.quest_subtitle: "将不需要的物品化为虚无"
	quest.3E5817559D2F96EE.title: "虚空 \& 虚空高级升级组件"
	quest.3E615A7057AD51F8.quest_desc: [
		"&a星焰剑&r是永恒星光中的高级武器，在&b星焰&r进阶系统中制作。"
		""
		"&a它&r使用锻造机制制作，需要与星火相关的材料，并&b推进&r模组的高级内容。"
	]
	quest.3E615A7057AD51F8.quest_subtitle: "星光锻造而成"
	quest.3E7475004445436C.quest_desc: [
		"&dFloralite&r Shard is a rare crafting and upgrade material from Crystal Chronicles. It is &bused&r to &bupgrade&r the Plagued Armor from Iron’s Spells ’n Spellbooks into the powerful Venomous Crusader Armor set."
		""
		"碎片引导自然魔法的力量，将&b瘟疫侵染的&r装备转化为更强大的形态，并增强了其毒性。它还与毒牙的创造有关，毒牙是毒液十字军的&b武器&r。"
	]
	quest.3E7475004445436C.quest_subtitle: "一种能强化瘟疫盔甲的有毒水晶碎片"
	quest.3E8C0F1EF057758D.quest_desc: [
		"&dThe&r Wizard Hat and Wizard Hood are two variants of the same Wizard Armor headpiece in Iron's Spells 'n Spellbooks. Both provide &b+3&r Armor, &b+125&r Max Mana and &b+5%&r Spell Power."
		""
		"使用 Arcane Cloth 制作任意 &b版本&r，并完成你的巫师 &b套装&r，以增强你的魔法能力。"
	]
	quest.3E8C0F1EF057758D.quest_subtitle: "选择你的风格，开启你作为真正巫师的道路"
	quest.3E91EDA953E82973.quest_desc: ["&6Obtain&r a Copper Sheet from Create. &bIt&r is produced by using a Mechanical Press on a Copper Ingot and is an important &bcomponent&r for crafting Fluid Pipes, Copper Casings, Fluid Tanks, Hose Pulleys, and other Create components."]
	quest.3E91EDA953E82973.quest_subtitle: "用铜块创造更伟大的作品"
	quest.3E91EDA953E82973.title: "铜质薄片"
	quest.3EA64EDF89239B99.quest_desc: ["&6储存&r &b电力&r以备后用。放电时，其&b电压&r和电阻会发生变化。"]
	quest.3EA64EDF89239B99.quest_subtitle: "储存电力"
	quest.3EACCB9717A18792.quest_desc: ["&aCraft&r a Block of Ancient Metal from the Cataclysm mod. This dense block is created by combining &b9&r Ancient Metal Ingots and represents a large collection of the &brare&r material recovered from &bancient&r desert civilizations."]
	quest.3EACCB9717A18792.quest_subtitle: "由被遗忘的金属锻造而成的纪念碑"
	quest.3EB5C38DB4E64A95.title: "很好"
	quest.3EC0F1242546B99D.quest_desc: [
		"&9&lSpeed&r&r up compatible Refined Storage devices with the Speed Upgrade. It increases the processing speed of &bsupported&r machines, allowing them to perform &btheir&r tasks more quickly and making your automated systems more efficient."
		""
		"将其安装在&b兼容&r的设备中，让你的网络以更快的速度处理工作。"
	]
	quest.3EC0F1242546B99D.quest_subtitle: "让你的网络运行得更快"
	quest.3EC2174857A71EDC.quest_desc: [
		"&a热泉石铲&r是永恒星光中的一个挖掘工具，使用&b热泉石锭&r制作而成。"
		""
		"用于地热地区的&a挖掘&r，是 Springstone 装备系列中中等水平的&b进阶&r。"
	]
	quest.3EC2174857A71EDC.quest_subtitle: "地热挖掘工具"
	quest.3ED18522AF559C2C.quest_subtitle: "更多盔甲 (More Armor)"
	quest.3EDBE4F1B6766229.quest_desc: ["&aObtain&r the Spirit Sunderer from the Cataclysm: Spellbooks addon. This legendary weapon is imbued with dark spiritual energy, &ballowing&r its wielder to shatter the souls of enemies with &bdevastating&r strikes. It is a relic forged for those who have mastered the &bforbidden&r powers of Cataclysm. The item's recipe was updated in newer versions of the addon."]
	quest.3EDBE4F1B6766229.quest_subtitle: "身心俱裂，斩断一切"
	quest.3EDBE4F1B6766229.title: "&b灵魂撕裂者"
	quest.3EF4816FC8FA1720.quest_desc: ["合成&6史莱姆桶&r以储存液态史莱姆。它被&b用于&rCreate: Misc \& Things 来处理史莱姆流体，可以通过该模组的流体处理机制进行填充或倒空。该模组的&b更新日志&r还包括了史莱姆桶倒空配方的修复。"]
	quest.3EF4816FC8FA1720.quest_subtitle: "将你的史莱姆以液体形式储存起来"
	quest.3EF99D3FF6FE02A9.quest_desc: [
		"制作一个 &a相机&r 来 &b开始&r 拍摄你世界的照片。"
		"用它来记录生物、建筑和景观，创建你自己的发现相册。"
	]
	quest.3EF99D3FF6FE02A9.quest_subtitle: "捕捉你周围的世界，收入囊中"
	quest.3F01924DCEDFCDDF.quest_desc: ["&6Craft&r the Fan Sanding Catalyst to give an Encased Fan a sanding effect. Place it in the fan's airflow to perform bulk sanding without &bneeding&r sand as the catalyst. It was added to Create: Connected &bspecifically&r for compatibility with Create: Dreams \\& Desires."]
	quest.3F01924DCEDFCDDF.quest_subtitle: "除了空气之外别无他物的沙子"
	quest.3F06982D4867D4BF.quest_desc: ["星光钻石镐是永恒星光模组中一种&a中后期&r的采矿工具，由星光钻石材料制成。它的采矿&b效率&r远高于冰川石和春石工具，是进入真正天体武器进阶前的&b最后一步&r。"]
	quest.3F06982D4867D4BF.quest_subtitle: "中后期的天体采矿工具"
	quest.3F0BFA3B1F19E687.quest_subtitle: "更多盔甲 (More Armor)"
	quest.3F1546190B6A6455.quest_subtitle: "更多盔甲 (More Armor)"
	quest.3F233646744ED538.quest_subtitle: "真美味！"
	quest.3F2A877CEDBEE653.quest_desc: [
		"&aCraft&r the Knightmetal Sword using refined Knightmetal &bIngots&r recovered from the Goblin Stronghold. Forged from an ancient alloy prized for its &bincredible&r strength, this sword embodies the martial legacy of the knights who once &bdefended&r the Twilight Forest from every threat."
		""
		"&a其&r完美平衡的刀刃既能&b重创&r敌人，又异常耐用，是踏入魔法世界前最出色的武器之一。手握&bKnightmetal&r之剑，你便继承了&b勇士&r们跨越时代的勇气。"
	]
	quest.3F2A877CEDBEE653.quest_subtitle: "被遗忘的守护者的利刃"
	quest.3F3A3DE0D50F9E17.quest_desc: ["&aLocate&r 灾变模组中的诅咒金字塔。这个巨大的&bdungeon&r 很少在沙漠群系中生成，并且&bserves&r 作为远古遗民的家园。在里面，你会遇到致命的陷阱、隐藏的密室、Koboletons、Kobolediators、Wadjet 和宝贵的战利品。为了更轻松地找到&bstructure&r，制作并使用沙漠之眼，它会&bpoints&r 指向最近的诅咒金字塔"]
	quest.3F3A3DE0D50F9E17.quest_subtitle: "寻找远古遗骸的安息之所"
	quest.3F3A3DE0D50F9E17.title: "&6被诅咒的金字塔"
	quest.3F5A3A014131ECFB.quest_subtitle: "升级+"
	quest.3F6285C1B5B1C201.quest_desc: [
		"&a获取&r水晶碎片，通过在&a水晶山脉&r中挖掘发光的极光水晶矿床来收集。"
		""
		"它们是 Better End 的 &bInfusion Rituals&r 中最常用的材料之一。"
	]
	quest.3F6285C1B5B1C201.quest_subtitle: "极光水晶的碎片 (Shards of the Aurora Crystal)"
	quest.3F7E8885F0AB8EE0.quest_desc: [
		"&9&l借助毁灭者，将自动化&r&r延伸至存储之外。它能自动破坏前方的方块，并将&b收集&r到的掉落物送回你的精炼存储网络。"
		""
		"将其连接到您的网络，用于自动化资源收集、区域清理或将&b材料&r输送到其他自动化系统中。"
	]
	quest.3F7E8885F0AB8EE0.quest_subtitle: "破坏方块并将资源送回储存处"
	quest.3F8479EB2D826221.quest_subtitle: "真美味！"
	quest.3F8D08A9D5262E95.quest_desc: [
		"&d暗影行者&r护腿是 Iron's Spells 'n Spellbooks 中暗影行者盔甲套装的一部分。穿戴后可提供 &b+6&r护甲、&b+125&r最大法力、&b+10%&r末影法术强度和 &b+5%&r法术强度。"
		""
		"They can be &bcrafted&r from 7 Arcane Cloth and 1 Ender Rune, or upgraded from Wizard Leggings with 1 Ender Rune at a Smithing Table in supported versions. Runestones are used to craft stronger school-specific armor."
	]
	quest.3F8D08A9D5262E95.quest_subtitle: "通过你的盔甲，引导神秘的末地魔法的力量"
	quest.3FBF365A6CA7396C.quest_desc: [
		"&e有时候&r，你只需要在挥拳时多些力量。"
		""
		"动力手套&b将&r你的攻击伤害提高&b4&r点，让每一次打击都变得沉重无比。简单、粗暴又有效。"
		""
		"&b穿上它，&r然后打得更狠点。"
	]
	quest.3FBF365A6CA7396C.quest_subtitle: "力量掌握在你手中"
	quest.3FC28E1387EC53BE.quest_desc: ["&a探访&r每个下界生物群系，探索这个充满敌意的维度。 &b从&r绯红&b森林&r到灵魂沙谷，每个生物群系都隐藏着独特的危险、资源和秘密，&b等待&r着你去发现。"]
	quest.3FC28E1387EC53BE.quest_subtitle: "探索地狱维度的每一个角落"
	quest.3FC28E1387EC53BE.title: "&l&c下界之主"
	quest.3FC55EE27A30FADB.quest_desc: [
		"晶化胸甲是通过灌注仪式制作的——将一个泰拉胸甲、一块琥珀宝石和晶化碎片放置在&a灌注基座&r周围。"
		""
		"穿戴后，可提供额外护甲和永久&b加速 I&r，是 Better End 的顶级护甲之一。"
	]
	quest.3FC55EE27A30FADB.quest_subtitle: "由灌注锻造而成的胸甲"
	quest.3FC55EE27A30FADB.title: "&d晶化胸甲"
	quest.3FC9AB54F29DC2C5.quest_desc: ["&6Upgrade&r your electric motors with the Basic Motor Extension and Advanced Motor Extension. &bThese&r components expand the capabilities of their re&bspective&r motor tiers, allowing you to build more &bpowerful&r and efficient electrical drive systems."]
	quest.3FC9AB54F29DC2C5.quest_subtitle: "让你的引擎更进一步运转吧"
	quest.3FE18FEA1B0B4889.quest_desc: ["&6The&r Fluid Hatch is a utility block added in Create: Dreams n' Desires. It provides a convenient way to insert and &bextract&r fluids from fluid tanks, making fluid handling easier in automated factory setups. It was &bintroduced&r alongside the Fluid Gauge in the 2.2a-BETA &bupdate&r for Minecraft 1.21–1.21.1."]
	quest.3FE18FEA1B0B4889.quest_subtitle: "轻松访问你的流体资源"
	quest.40067D14E89C9DBB.quest_desc: [
		"Terminite 铲子是一种由 Terminite 锭锻造的&a挖掘&r工具，比 Thallasium 级别的工具更耐用。"
		""
		"用于挖掘，以获取 Better End 的&b更高级别&r装备。"
	]
	quest.40067D14E89C9DBB.quest_subtitle: "挖掘工具，精炼版"
	quest.40209A8EB64D978A.quest_desc: [
		"&eLooking&r to get better deals from the villagers? This simple hat might be exactly what you need."
		""
		"佩戴村民帽&b会&r提升你在村民中的声望，使他们的交易变得更便宜。为了更划算的交易，付出的微小&b代&r价。"
	]
	quest.40209A8EB64D978A.quest_subtitle: "一点小小的魅力就能带来巨大的改变"
	quest.406A1AC2857DD193.quest_subtitle: "更多盔甲 (More Armor)"
	quest.406FE853DF7C06B0.quest_subtitle: "升级+"
	quest.4072857BFD478132.quest_desc: ["&a制作&r一套完整的铁制工具——稿子、斧头和剑。这将帮助你更快地收集资源，并&b生存&r更严峻的挑战。"]
	quest.4072857BFD478132.quest_subtitle: "前方有更强的工具等待着你"
	quest.4072857BFD478132.title: "铁质工具"
	quest.407DB3F12F46CA53.quest_desc: ["&6Craft&r the Empty Fan Catalyst and use it as a base for specialized fan-processing catalysts. Apply a compatible item to convert it into the &bcorresponding&r catalyst, allowing the same compact block to provide different effects when air from an Encased Fan passes through it. The &bcatalyst&r can later be returned to its empty state through crafting."]
	quest.407DB3F12F46CA53.quest_subtitle: "留给粉丝创作的空白画布"
	quest.4098CE9ADD68B6BC.quest_desc: [
		"&6一列&r真正的火车&b值得&r一位真正的驾驶员。安山合金火车驾驶员为驾驶座带来了熟悉的创造美学，让你的机车拥有独特的工业外观。"
		""
		"&b安装&r到你的火车上，然后接管控制权。铁路由你掌控。"
	]
	quest.4098CE9ADD68B6BC.quest_subtitle: "以时尚的方式掌控你的火车。"
	quest.40AECDBEEED9B76F.quest_desc: ["&6金&r制导线。用于BJT晶体管，也可用作普通电线。"]
	quest.40AECDBEEED9B76F.quest_subtitle: "由黄金制成的电线"
	quest.40BC86739EDE056D.quest_desc: ["&6从Create模组中获取&r脉冲计时器。它像一个紧凑的红石时钟，&b反复&r发出短的红石脉冲，间隔可手动调节。计时范围从&b2&r刻到&b60&r分钟，适用于自动化机器、农场、门和其他定时装置。它还可以反向工作，默认保持供电并产生短暂的关闭脉冲。"]
	quest.40BC86739EDE056D.quest_subtitle: "掌握自动化的节奏，成为大师"
	quest.40D36BF2359F1C49.quest_desc: ["&6住宅的&r垂直版本。建造垂直发电机时使用。"]
	quest.40D36BF2359F1C49.quest_subtitle: "一个垂直方向的住所"
	quest.40D45535B1A846CF.quest_desc: ["&aCraft&r the Ignis Mage Hat from the Cataclysm: Spellbooks addon. This &benchanted&r headpiece is part of the Ignis Mage Robes set, infused with the &bpower&r of Ignis and the eternal flames of the Nether. It represents the &bmastery&r of fire magic and the legacy of the Lord of Fire."]
	quest.40D45535B1A846CF.quest_subtitle: "火焰术士的皇冠"
	quest.40F8ADF3428A2EDC.quest_desc: ["&dKeres&r 是一把被诅咒的长柄武器，刀刃上刻有血红色的标志。该武器对&b高血量&r目标尤其有效。要获取其基础材料，请在下界堡垒中寻找血石，并击败其中出现的穿越者。"]
	quest.40F8ADF3428A2EDC.quest_subtitle: "被诅咒的长柄武器"
	quest.40F8ADF3428A2EDC.title: "&l&c克雷斯"
	quest.41050CD762EB31A4.quest_desc: ["从 Create 中获取&6黄铜板&r。它由黄铜锭通过机械压机压制而成，是制造&b高级&rCreate 组件（如黄铜外壳、黄铜手、黄铜隧道、机械臂和红石链接）的重要材料。"]
	quest.41050CD762EB31A4.quest_subtitle: "将黄铜压制成高级组件"
	quest.4109B752110879B4.quest_desc: ["&d一&r枚能&b提升&r佩戴者效率的特殊戒指。"]
	quest.4109B752110879B4.quest_subtitle: "一个能提高你魔法效率的戒指"
	quest.412C1C81447406A5.quest_desc: ["&aCraft&r the Pharaoh's Sacred Skirt from the Cataclysm: Spellbooks addon. This &benchanted&r garment is part of the Pharaoh Wizard Armor set, inspired by the Ancient Remnant and the forgotten pharaohs buried beneath the desert. It enhances Sand &bmagic&r and completes the sacred &battire&r of the ancient rulers."]
	quest.412C1C81447406A5.quest_subtitle: "完成沙漠国王的礼装套装"
	quest.413AEF73C243C26B.quest_desc: [
		"&6长&r途旅行需要可靠的燃料供应。燃料箱可将液体燃料直接储存在火车上，&b让&r机车在行驶过程中随时取用。"
		""
		"&bInstall&r a Fuel Tank, fill it with fuel and keep your train &brunning&r wherever the tracks may lead."
	]
	quest.413AEF73C243C26B.quest_subtitle: "保持机车燃料充足，迎接前方的旅程。"
	quest.4159DC055AEBC63E.quest_desc: ["&a消灭&r下界堡垒中的15个烈焰人。这些火系生物是进阶酿造和末地&b进入&r准备的关键。"]
	quest.4159DC055AEBC63E.quest_subtitle: "下界堡垒歼灭行动"
	quest.4159DC055AEBC63E.title: "烈焰人"
	quest.416A444335065180.quest_subtitle: "真美味！"
	quest.416BA569BF21D6E7.quest_desc: ["&6Obtain&r an Empty Blaze Burner from Create. It is the first &bstep&r toward creating a functioning Blaze Burner, one of the &bessential&r heating components for advanced Create machinery. The Empty Blaze Burner can be filled by right-clicking a Blaze or Blaze Spawner with it. Once filled, it can &bprovide&r heat for heated and superheated recipes, including the production of Brass."]
	quest.416BA569BF21D6E7.quest_subtitle: "捕获创造的火焰"
	quest.417B1EC50CC12318.quest_subtitle: "更多盔甲 (More Armor)"
	quest.418C4186A1C86543.quest_desc: [
		"&aFlowglaze 铲子&r是 Eternal Starlight 的一种挖掘工具，属于 Flowglaze &b装备&r系列。"
		""
		"&a它&r用于中后期游戏流程中的挖掘和地形清理，是 Flowglaze &b进阶&r系统的一部分。"
	]
	quest.418C4186A1C86543.quest_subtitle: "流动挖掘工具"
	quest.41964134B525775C.quest_subtitle: "真美味！"
	quest.41B1E26A355F0D28.quest_desc: ["&6超级附魔模板是&r创造：附魔工业中的一个&b高级&r物品。它通过将超经验块放入机械压机中制作而成。该模板&b用于&r超级附魔，允许将&b附魔&r在正常限制之外&b转移&r或移除。它必须使用处于超级附魔模式的烈焰锻造炉来&b处理&r。"]
	quest.41B1E26A355F0D28.quest_subtitle: "超越普通附魔的极限，探索未知领域"
	quest.41C3C5CD7A81B511.quest_subtitle: "真美味！"
	quest.41C9A66CA85B6D10.quest_desc: ["&6基础太阳能加热板&r利用阳光为 Create: New Age 中的热力系统&b产生&r热量。将其连接到热管，&b开始&r为工厂建造可再生能源。"]
	quest.41C9A66CA85B6D10.quest_subtitle: "Harness the heat of the sun"
	quest.41D05D51E88391EF.title: "&5&l利维坦巨兽"
	quest.41D4A0A849FDE705.quest_desc: [
		"&a末地箱&r是一种与末地相连的特殊存储方块。"
		"存放在里面的物品会共享到你放置在世界上的所有末地箱中，但只有你才能访问它们。"
		"在&b探索&r和&b危险&r&b冒险&r期间，安全存放&b贵重&r物品非常有用。"
	]
	quest.41D4A0A849FDE705.quest_subtitle: "个人维度存储空间"
	quest.41D4A0A849FDE705.title: "末影箱"
	quest.41D5492A3FB2B9DF.quest_desc: ["&dA&r special rune used for crafting &bhealth-related&r equipment in Hazen N Stuff."]
	quest.41D5492A3FB2B9DF.quest_subtitle: "注入了生命能量的符文"
	quest.41E15FB448BB13FC.quest_desc: [
		"&dCryomancer&r 兜帽是 Iron's Spells 'n Spellbooks 中 Cryomancer 盔甲套装的头盔。穿戴后可提供 &b+3&r 护甲、&b+125&r 最大法力、&b+10%&r 冰系法术强度和 &b+5%&r 法术强度。"
		""
		"可以用 5 个 Arcane Cloth 和 1 个 Ice Rune 来&b制作&r。"
	]
	quest.41E15FB448BB13FC.quest_subtitle: "掌握冰魔法的冻结之力"
	quest.41ED63552616BCF5.title: "&6&lIgnis"
	quest.42076947AD7E263F.quest_desc: [
		"&d棱镜&r骑士护腿是棱镜骑士盔甲套装的一部分，也是《水晶编年史》中&b最坚固&r的盔甲套装。"
		""
		"它们使用来自 Iron’s Spells ’n Spellbooks 的神圣灵魂碎片&b制作&r，可以通过升级任何增强型 Crystal Chronicles 盔甲套装的护腿来&b获得&r。Prismatic Knight Armor 代表了 Crystal Chronicles 盔甲进阶的&b最终也是最强大的&r阶段。"
	]
	quest.42076947AD7E263F.quest_subtitle: "由水晶编年史的力量锻造而成的终极护腿"
	quest.420C27578506FB64.quest_desc: ["&aObtain&r the Bloom Stone Greaves from the Cataclysm: Spellbooks addon. Add this &bpowerful&r piece of equipment to your collection and continue your journey through the secrets and &brelics&r introduced by the addon."]
	quest.420C27578506FB64.quest_subtitle: "源自远古石头的力量"
	quest.421737CC1BBE3105.quest_desc: ["&a从&rBosses' Rise模组中获得龙颅骨。这件古老的&b遗物&r取自一头强大巨龙的骸骨，象征着战胜世界上最令人畏惧的&b生物&r之一。真正的屠龙者&b才&r配拥有这样的战利品。"]
	quest.421737CC1BBE3105.quest_subtitle: "来自陨落巨龙的奖杯"
	quest.422978F1319FC774.quest_desc: ["&a金质附魔&r能为下界合金赋予独特属性。虽然未必最强，但它能带来特殊品质，助你在&b危险情况下&r化险为夷。"]
	quest.422978F1319FC774.quest_subtitle: "力量与优雅的结合"
	quest.422978F1319FC774.title: "黄金下界合金锭"
	quest.42358ED7CCE6EBB3.quest_desc: ["&6Six&r Dark Chocolate Bars wrapped in paper create a Full Dark Chocolate Bar. This rich treat can be eaten up to 16 times, and every bite &bgrants&r the Stimulation effect for 5 seconds."]
	quest.42358ED7CCE6EBB3.quest_subtitle: "一块浓郁的黑巧克力，准备好迎接十六口的美味享受。"
	quest.424371C3AAC0A9EE.quest_desc: ["&b制作&r星捕钩，并将其安装在鱼竿上。这将让你更有效地捕鱼，并钓起稀有的&b宝藏&r。"]
	quest.424371C3AAC0A9EE.quest_subtitle: "制作钓鱼钩"
	quest.424371C3AAC0A9EE.title: "星捕手钩爪"
	quest.425D0951904E068B.quest_desc: ["&6A&r 用于建筑的装饰性铜质饰面。也用于电路设计台和太阳能电池轴承。"]
	quest.425D0951904E068B.quest_subtitle: "铜质覆层"
	quest.426043824AFC8A77.quest_desc: ["&6Obtain&r a Clutch, Encased Chain Drive, and Adjustable Chain Gearshift from Create. Together, these &bcomponents&r give you greater control over rotational power: the Clutch can stop power &btransmission&r when powered by Redstone, the Encased Chain Drive transfers rotation through connected chains, and the Adjustable Chain Gearshift allows the &bspeed&r of those chains to be precisely adjusted &busing&r a Redstone signal."]
	quest.426043824AFC8A77.quest_subtitle: "控制机械动力的流动方向"
	quest.426DFA958D4BC450.quest_desc: [
		"&aThe&r Flowglaze Sword is a weapon from Eternal Starlight, part of the Flowglaze equipment &bprogression&r system."
		""
		"&a它&r使用&bFlowglaze材料&r制作，属于该模组的中后期武器。"
	]
	quest.426DFA958D4BC450.quest_subtitle: "流动锻造的刀刃"
	quest.4284E40A2D236E99.quest_desc: ["&a寻找&r来自Cataclysm模组的Frosted Prison。这座冰冻结构隐藏在冰雪生物群系中，内有危险的敌人、珍贵的战利品和强大的&b挑战&r。"]
	quest.4284E40A2D236E99.quest_subtitle: "探索冰封的堡垒遗迹"
	quest.4284E40A2D236E99.title: "&6找到&3霜冻监狱"
	quest.4286344D3350D02E.quest_desc: ["&aObtain&r the Ring of Grudged from the Cataclysm mod. This rare Curios ring can be found in chests inside the &bAbandoned&r Temple structure. &bWhen&r equipped, it grants &b+10%&r Critical Damage."]
	quest.4286344D3350D02E.quest_subtitle: "被遗忘的遗迹中流传下来的残骸"
	quest.4286344D3350D02E.title: "&b怨恨之戒 (Ring Of Grudged)"
	quest.428A768B5D2EEC62.quest_desc: ["&d你的&r子弹卷轴会将生物&b用锁链&r拉向你，最远有一定范围。"]
	quest.428A768B5D2EEC62.quest_subtitle: "快到我这边来"
	quest.4295BC2776372EAB.quest_desc: ["用机械压榨机&6处理&r苹果以生产苹果汁。这种新鲜压榨的苹果汁是创造：酿酒厂的关键原料，可以用酒窖进一步&b处理&r成苹果酒。"]
	quest.4295BC2776372EAB.quest_subtitle: "压榨苹果，开启完美开局"
	quest.42DF3D7F94ED5105.quest_desc: ["&a获取&r音乐唱片《Scylla》，这是击败Scylla后她会掉落的&b稀有&r唱片。唱片播放的是Rotch Gwylt的《Scylla》，这首音乐与对抗风暴女皇的战斗&b相关&r。"]
	quest.42DF3D7F94ED5105.quest_subtitle: "风暴女王的颂歌"
	quest.42FED4B781CBE750.quest_subtitle: "更多盔甲 (More Armor)"
	quest.4310A3F0D103F3BB.quest_subtitle: "真美味！"
	quest.431220B37B625AF7.quest_desc: [
		"&6当&r探索还不够时，将战斗带上天空。这艘战舰由铜和钢制成，&b配备&r四个座位、一个可移动炮塔和六个武器挂载点。"
		""
		"建造这座&b空中&r堡垒，将其武装到牙齿，掌控天空。"
	]
	quest.431220B37B625AF7.quest_subtitle: "一座为统治天空而建造的飞行堡垒。"
	quest.4320C19B8F643761.quest_desc: ["&a回声&r充能器可在远古堡垒中隐藏的深板岩宝库内&b寻&r找。收集足够的充能器来唤醒沉睡的&b机&r器——深板岩的终结者。你穿越远古&b堡&r垒的&b旅&r程才刚刚开始。"]
	quest.4320C19B8F643761.quest_subtitle: "堕落者的能量"
	quest.432497F8917F0C59.quest_desc: [
		"&a获取&r Aeternium 升级锻造模板，在锻造台使用可将全套 Terminite 盔甲升级为 &bAeternium&r。"
		""
		"Aeternium 是 Better End 添加的最强材料，甚至超过了 &bNetherite&r。"
	]
	quest.432497F8917F0C59.quest_subtitle: "正在向永恒锭升级中"
	quest.4328D2F295C8640C.quest_desc: ["&6从Create模组中获取&r机械合成器。这些机器协同工作，利用旋转动力自动合成物品。多个合成器可以&b以复杂模式&r连接，让你能自动化那些普通合成台无法完成的配方，包括像 Crushing Wheels、Extendo Grip、Potato Cannon 和 Wand of Symmetry 等&b高级&r组件。"]
	quest.4328D2F295C8640C.quest_subtitle: "将合成工艺自动化，解放双手"
	quest.434B7CA4C1D5CCB0.quest_subtitle: "更多盔甲 (More Armor)"
	quest.4351D7310BADF087.quest_desc: [
		"&dDivinite&r Shard 是《水晶编年史》中的一种稀有合成材料。可用于将铁质魔法套装升级为&b强大的&r圣骑士套装。"
		""
		"碎片引导着神圣魔法的力量，使原本的牧师装备能够被&b转化&r为增强后的圣骑士形态。"
	]
	quest.4351D7310BADF087.quest_subtitle: "用于强化牧师盔甲的神圣水晶碎片"
	quest.43679C401B345C76.quest_desc: ["&6Prepare&r a delicious Chocolate Milkshake using the &bprocessing&r power of Create: Dreams n' Desires. A simple and sweet recipe that adds a tasty &bnew&r product to your factory's food production."]
	quest.43679C401B345C76.quest_subtitle: "巧克力与奶油的甜蜜融合"
	quest.4388CC49044CE26B.quest_desc: [
		"&e使用&r领地标记地图系统，你现在可以将世界的区块标记为自己的领地。"
		"&a已认领&r区块受其他玩家保护，可安全地&b建造、&r存放物品和创建基地，不受干扰。"
		"这是完全掌控你的生存&a世界&r的重要一步。"
	]
	quest.4388CC49044CE26B.quest_subtitle: "请先阅读此内容！"
	quest.4388CC49044CE26B.title: "&e占领领地中"
	quest.438E5892B8012353.title: "天哪，又来了？！"
	quest.43B03B96D3B58837.quest_desc: ["&dThe&r Tricorne increases the &bdamage&r of the first shot fired from a full magazine. Wear it when you plan your shots carefully; a kill with that first shot earns Pistols at Dawn."]
	quest.43B03B96D3B58837.quest_subtitle: "确保第一枪就能奏效"
	quest.43B796678ABA8146.quest_desc: [
		"在永恒星光的严酷&b区域&r中，口渴行者漫无目的地游荡，受着对能量或精粹的&a未知&r渴望所驱使。"
		"这些敌对生物在靠近时会变得极具攻击性，它们会凭借&b速度&r和&b无情&r的攻击迅速压倒毫无防备的玩家。"
		""
		"&a击败&r它们是深入不稳定环境探索所必需的。"
	]
	quest.43B796678ABA8146.quest_subtitle: "运动中干涸的饥饿感"
	quest.43B796678ABA8146.title: "口渴的行者"
	quest.43BBA5365233F199.quest_desc: [
		"&9&lIncrease&r&r the yield of compatible mining operations with the Fortune I Upgrade. It allows supported machines and devices to benefit from the first level of Fortune, giving you a chance to obtain more &bresources&r when processing certain blocks."
		""
		"一个&b实用&r的升级，可最大化你的资源产量，并使自动化采矿系统更具回报。"
	]
	quest.43BBA5365233F199.quest_subtitle: "从每个方块获取更多资源"
	quest.43F59DEA9BF0CAD8.quest_subtitle: "更多盔甲 (More Armor)"
	quest.44168C844B8DBABD.quest_desc: ["&a从 L_Ender’s Cataclysm 中获得&r Brontes。Brontes 是 Cataclysm 添加的强大武器之一，与 Ceraunus 同属重型锤子&b武器库&r。Cataclysm 的更新日志&b明确&r指出，Brontes 是与 Ancient Spear 配置选项一同添加的。"]
	quest.44168C844B8DBABD.quest_subtitle: "挥舞雷鸣般的锤子"
	quest.44168C844B8DBABD.title: "&b布龙特斯"
	quest.442062D6B4CB62BC.quest_desc: ["&6Rose&r Quartz is a crafting material used throughout Create's progression. Its main purpose is to be polished with Sand Paper, producing Polished Rose Quartz. The polished version is an important &bingredient&r for Electron Tubes and Rose Quartz Lamps, as well as decorative Rose Quartz blocks. Rose Quartz can also be &bprocessed&r through Create's automation using a &bDeployer&r with Sand Paper."]
	quest.442062D6B4CB62BC.quest_subtitle: "一种带有玫瑰色滤镜的配料"
	quest.442463019B23DBA1.quest_desc: [
		"&9&lExpand&r&r your Refined Storage network with the Disk Interface. It allows storage disks to be accessed and managed through an external connection, giving you more &bflexibility&r when designing your digital storage system."
		""
		"&bUse&r it to connect compatible storage &bcomponents&r and create a more versatile setup for managing your storage disks."
	]
	quest.442463019B23DBA1.quest_subtitle: "将外部存储直接连接到您的网络"
	quest.444F80A3A15EDAC9.quest_desc: ["&d炼金术士坩埚&r是 Iron's Spells 'n Spellbooks 中的一个魔法工作站。它可以酿造药水与灵药，将法术卷轴回收为墨水，&b将墨水&r升级为更高稀有度，并&b生产&r血瓶。它有4个输入和4个输出槽，且需要水才能运作。"]
	quest.444F80A3A15EDAC9.quest_subtitle: "掌握魔法炼金术的精髓"
	quest.445BBBB98EF2E005.quest_desc: [
		"&dElectromancer&r Robe is the chestpiece of the Electromancer Armor set in Iron's Spells 'n Spellbooks. When worn, it provides &b+8&r Armor, &b+125&r Max Mana, &b+10%&r Lightning Spell Power and &b+5%&r Spell Power. It can also be imbued with 1 spell."
		""
		"It can be &bcrafted&r from 8 Arcane Cloth and 1 Lightning Rune, or upgraded from Wizard Robes with 1 Lightning Rune at a Smithing Table in supported versions."
	]
	quest.445BBBB98EF2E005.quest_subtitle: "引导闪电魔法的毁灭性力量"
	quest.4461D8E0E15DABBB.quest_subtitle: "更多盔甲 (More Armor)"
	quest.446A261C6E77931A.quest_desc: ["&6Craft&r the Sticky Boots from Create: Misc \\& Things. While sneaking, they &bprotect&r you from fall damage from falls of up &bto&r 8 blocks. Hold sneak + jump to perform a powerful jump, reaching a maximum height of about &b4.125&r blocks. They provide &b3&r armor points and 1 armor toughness."]
	quest.446A261C6E77931A.quest_subtitle: "紧贴地面，然后跳开去"
	quest.446FF4F9537F5FBB.quest_desc: ["铁锭是许多&b工具&r、&b武器&r和&b盔甲&r的基础。在熔炉中熔炼铁矿石，获取这些必备的建筑材料，为即将到来的冒险做好准备。"]
	quest.446FF4F9537F5FBB.quest_subtitle: "正确冶炼它"
	quest.446FF4F9537F5FBB.title: "熔化的潜能"
	quest.447A227260CFFD99.quest_subtitle: "真美味！"
	quest.4480A44A95F9B8C0.quest_subtitle: "更多盔甲 (More Armor)"
	quest.44827007A009AB60.quest_desc: ["&6Whip&r up a Chocolate Milkshake and &bfill&r a bucket with it. A delicious addition from Create: Dreams n' Desires, perfect for anyone who wants to &bbring&r a little sweetness into their factory."]
	quest.44827007A009AB60.quest_subtitle: "工厂地板上的一道美味甜点"
	quest.4499B939F0167AC3.quest_desc: ["&6播放&r一系列&b信号&r：读取孔洞时，它将公共端子连接到输出引脚。需要动能输入，且&b旋转&r速度决定了读取速度。卡片可手动或&b自动&r插入。"]
	quest.4499B939F0167AC3.quest_subtitle: "一个打孔卡读取器"
	quest.44C0D8A6DF8C5CE3.quest_subtitle: "更多盔甲 (More Armor)"
	quest.44C37A25BA4D5570.quest_desc: ["&6The&r Crafting Blueprint lets you save crafting recipes and craft them on demand. Place it like a painting and &bright-click&r a slot to open its interface, then insert the ingredients to save a recipe. You can use Filters to allow multiple possible recipes for a slot. Once a recipe is saved, right-clicking the Blueprint crafts the item &busing&r available materials, while Shift + &bright-click&r crafts up to a full stack. &bLeft-clicking&r removes a saved recipe. The Blueprint can cover an area up to &b3×3&r blocks."]
	quest.44C37A25BA4D5570.quest_subtitle: "将配方保存以备后用"
	quest.44D968C6F3BDF1DD.quest_desc: [
		"&eThe&r world is full of &btreasures&r waiting to be discovered. Artifacts are powerful relics that cannot simply be crafted — you must explore, search and take risks to &bobtain&r them."
		""
		"从远古遗迹到隐秘营地，每一次&b探险&r都可能让你发现非凡之物。保持警惕，因为并非&b所有&r宝箱都如表面那般简单..."
		""
		"收集这些&b神秘的&r文物，探索它们所蕴含的力量。"
	]
	quest.44D968C6F3BDF1DD.quest_subtitle: "超乎寻常的宝藏，等待着你去发掘。"
	quest.44D968C6F3BDF1DD.title: "&f&l欢迎来到&6Artifacts"
	quest.44DD7D28A4508512.quest_desc: ["夜幕降临，亡灵便会遍布世界。击败 &b20&r 只僵尸和 &b20&r 只骷髅，证明你能在夜晚生存并面对世界的基本危险。这是成为真正战士的重要一步。"]
	quest.44DD7D28A4508512.quest_subtitle: "净化世界，消灭不死生物"
	quest.44DD7D28A4508512.title: "&4夜间狩猎"
	quest.44E1D5E415056898.quest_subtitle: "真美味！"
	quest.44F1B8D4B6BCC1F1.quest_desc: [
		"{image:waystones:item/warp_stone width:100 height:100 align:center}"
		"变量"
	]
	quest.44F1B8D4B6BCC1F1.title: "我是一名同性恋者"
	quest.44F9622D310E881A.quest_desc: [
		"&dBattle-Evoker&r Tunic 是 Crystal Chronicles 对 Iron’s Spells ’n Spellbooks 中 Archevoker Coat 的升级版。"
		""
		"使用 Avaricite Shard 进行 &b升级&r，将原本的 Archevoker Armor 转变为强大的 Battle-Evoker Armor 套装。Avaricite Shard 为长袍注入了 &b额外的&r Evocation 魔法，创造出更强大的、&b专注于战斗&r 的 Archevoker 装备版本。"
	]
	quest.44F9622D310E881A.quest_subtitle: "由 Avaricite 强化的 Archevoker 外套增强版"
	quest.450E7B501081C4CE.quest_desc: ["&6Fueling&r Tanks 是 Create Stuff 'N Additions 的便携式燃料容器，&b旨在&r为喷气背包和外骨骼等兼容设备提供燃料。它们有小、中、大三种尺寸，&b容量&r分别为 800 mB、1600 mB 和 3200 mB。较大的版本是对较小储罐的 &b升级&r，能让你在更长的冒险中拥有更多燃料，并延长动力设备的 &b运行&r时间。"]
	quest.450E7B501081C4CE.quest_subtitle: "保持你的机器持续运转"
	quest.450E7B501081C4CE.title: "燃料储存罐"
	quest.4530DE42E43FC68B.quest_desc: [
		"&l&9某些&r&r资源过于&b珍贵&r，永远不会耗尽。生存无限升级可将选定的背包栏位变为无限物品源。只要升级有效，放入受影响的栏位中的任何物品都可以被无限提取。"
		""
		"Unlike the &badmin-only&r Infinity Upgrade, this version is made for survival gameplay — but obtaining it is meant to be a true endgame achievement."
	]
	quest.4530DE42E43FC68B.quest_subtitle: "将你最稀有的资源转化为无尽的供应"
	quest.4548E44B70A2AF8F.quest_subtitle: "真美味！"
	quest.454B93C602615809.quest_desc: ["&dA&r special rune used for crafting &barchery-related&r equipment in Hazen N Stuff."]
	quest.454B93C602615809.quest_subtitle: "注入了弓箭之力的符文铭文"
	quest.4568300E5E2FD231.quest_subtitle: "更多盔甲 (More Armor)"
	quest.456DDE7BE0D37214.quest_desc: ["&6从Create中获取&r便携式流体接口。它允许流体在&b固定式&r流体系统和移动机械的流体库存之间&b传输&r。两个接口必须相对放置，一个&b连接到&r机械上，另一个保持固定。需要流体泵来&b移动&r流体。"]
	quest.456DDE7BE0D37214.quest_subtitle: "让你的装置走到哪里，流体就跟到哪里"
	quest.45893C5D648C164B.quest_desc: ["&6保险库组件&r是黄铜无人机的一个模块，可为其提供&b额外&r的储物空间。将其安装在无人机上，即可在远程操控时携带物品。这使得黄铜无人机不仅适用于侦察，也适用于从难以&b到达&r的地方&b运输&r和收集物品。保险库组件是黄铜无人机可选模块之一，其他模块还有风扇、钻头和磁铁模块。"]
	quest.45893C5D648C164B.quest_subtitle: "给你的无人机增加一些存储空间"
	quest.4594F69974180053.quest_subtitle: "更多盔甲 (More Armor)"
	quest.459FAFCD147C1A9E.quest_subtitle: "升级+"
	quest.45AA767D92A64DFD.quest_subtitle: "更多盔甲 (More Armor)"
	quest.45CC771F7380273D.quest_desc: ["&a从Cataclysm模组中获取&r活力安卡。这件古老的配饰是一件强大的防御性&b遗物&r，能提升穿戴者的&b生存能力&r，并保护其免受致命情况的伤害。它由&b稀有&r材料锻造而成，象征着古代生命能量的掌控。"]
	quest.45CC771F7380273D.quest_subtitle: "一件能战胜死亡的圣物"
	quest.45D0E5A061585578.quest_desc: [
		"&d虚空行者&r靴是《水晶编年史》中，源自《铁之咒语与咒语书》的&b升级版&r暗影行者靴。"
		""
		"使用深渊水晶碎片升级，将原本的暗影行者盔甲&b转化&r为&b强大的&r虚空行者盔甲套装。深渊水晶碎片为靴子注入了深渊的力量，增强了原装备的黑暗与阴影能力。"
	]
	quest.45D0E5A061585578.quest_subtitle: "由深渊水晶强化的暗影行者靴的增强版"
	quest.45D8B95FB70703AC.quest_desc: ["&6Craft&r the Brass Speaker and bring sound and &bannouncements&r to your Create builds. Use it to play sounds and send custom messages in chat, making it especially &buseful&r for train stations and &bautomated&r factories. The Brass Speaker uses the Vibration Mechanism in its crafting."]
	quest.45D8B95FB70703AC.quest_subtitle: "制造点噪音吧"
	quest.45DAC58E4B0DB02C.quest_desc: ["&a铁质钩爪&r能让你&b使用&r钩子和绳索来移动。把它固定在&b物体上，&r就能更轻松地穿越困难区域。"]
	quest.45DAC58E4B0DB02C.quest_subtitle: "到达以前无法到达的地方"
	quest.45DF3A28B5316C54.quest_desc: [
		"&aCraft&r a Diamond Fillet Knife, the &bpinnacle&r of traditional fishing tools. Forged with an incredibly sharp diamond blade, it offers unmatched &bdurability&r and precision, making it the ideal companion for processing the rarest fish and treasures found beneath the waves."
		""
		"&a每位&r经验丰富的垂钓者都知道，非凡的收获需要非凡的工具。手握钻石鱼刀，无论宁静的河流还是&b最&r深的海洋，你都能充分利用&b每次&r探险。"
	]
	quest.45DF3A28B5316C54.quest_subtitle: "最棒的鱼获，配最锋利的刀刃"
	quest.45E388EE28BC67BC.quest_desc: ["&6The&r electric version of the Create Mechanical Pump: pumps fluids through pipes, powered by &belectricity&r instead of rotation."]
	quest.45E388EE28BC67BC.quest_subtitle: "一个电动水泵"
	quest.45E8E9DAD1628F87.quest_desc: [
		"&dVenomous&r Crusader Chestplate is the Crystal Chronicles upgraded version of Plagued Coat from Iron’s Spells ’n Spellbooks."
		""
		"使用Floralite Shard进行&b升级&r，将原本的Plagued Armor转化为强大的Venomous Crusader Armor套装。Floralite Shard为盔甲注入了自然魔法的&b力量&r，增强了其毒性和&b瘟疫相关的&r能力。"
	]
	quest.45E8E9DAD1628F87.quest_subtitle: "由Floralite强化的瘟疫斗篷的增强形态"
	quest.45F0CAADA098BBBF.quest_desc: ["&6Upgrade&r to the Mechanical Brass Extruder and unlock the &badvanced&r side of mechanical extrusion. &bUnlike&r the basic Andesite Extruder, the Brass Extruder can handle advanced recipes that may consume input blocks, opening the way to more powerful &bautomated&r resource production."]
	quest.45F0CAADA098BBBF.quest_subtitle: "解锁高级挤出功能"
	quest.45FC8958716277F7.quest_subtitle: "更多盔甲 (More Armor)"
	quest.45FFE05FDCE9280E.quest_subtitle: "真美味！"
	quest.4603A9AE94ABD38F.quest_subtitle: "更多盔甲 (More Armor)"
	quest.460CFDEE95AACA8A.quest_desc: [
		"&aCraft&r the Infusion Pedestal, the core block of Better End's Infusion Ritual system."
		""
		"围绕中央基座排列成组，用于制作&aEnchanted Membrane&r、永恒水晶和水晶盔甲等物品。"
	]
	quest.460CFDEE95AACA8A.quest_subtitle: "每个仪式的核心所在"
	quest.461EE4C67668870F.quest_subtitle: "更多盔甲 (More Armor)"
	quest.46369185A5712874.quest_subtitle: "更多盔甲 (More Armor)"
	quest.46379D4450E3BA1D.quest_subtitle: "真美味！"
	quest.4642FD4A9F6EDA40.quest_desc: [
		"使用融入了暮色森林古老魔法的&b铁木&r锭来制作&a铁木腿甲&r。这款腿甲旨在平衡防护与机动性，让冒险者既能自由行动，又能抵御&b魔法&r荒野中潜藏的各种危险。"
		""
		"&aAs&r a key part of the Ironwood Armor set, they &bstrengthen&r your overall defense and help you endure the increasingly dangerous encounters found &bdeeper&r in the Twilight Forest."
	]
	quest.4642FD4A9F6EDA40.quest_subtitle: "为狂野森林提供均衡的保护"
	quest.465834E4C5B52BD4.quest_desc: ["&6Craft&r the Haunted Whistle and add an eerie voice to your pipe organ. &bIt&r is one of the seven pipe types &bintroduced&r in Create: Sound of Steam 0.8.0, giving your organ a distinctly haunting character."]
	quest.465834E4C5B52BD4.quest_subtitle: "让管风琴从彼岸发出声响"
	quest.466864328518872B.quest_desc: ["将星捕手浮标&aAttach&r到你的鱼竿上，以标记钓鱼点并提高捕获几率。"]
	quest.466864328518872B.quest_subtitle: "为你的鱼竿制作浮漂"
	quest.466864328518872B.title: "星捕手浮标"
	quest.466C0D65B55765C6.quest_subtitle: "升级+"
	quest.466FA806237D45DD.quest_desc: ["&6A&r 用于电子电路的真空管。"]
	quest.466FA806237D45DD.quest_subtitle: "一个更宽的管状物"
	quest.4684CE598586717F.quest_desc: ["&aThe&r Cooking Pot is an essential cooking tool from Farmer's Delight. It allows you to combine different ingredients and prepare a wide &bvariety&r of meals, making it a key part of your kitchen and food production."]
	quest.4684CE598586717F.quest_subtitle: "用于烹制美味佳肴的多功能锅具"
	quest.469476DDCF3FED28.quest_desc: [
		"机械弩是永恒星光中一种&a高级&r远程武器，使用&b精炼的维度材料和构造工程学来&r制作。"
		""
		"It &aoffers&r a stronger alternative to standard ranged combat, rewarding players who have &bprogressed&r through the mod’s material and boss systems."
	]
	quest.469476DDCF3FED28.quest_subtitle: "通过工程学实现精准操作"
	quest.469476DDCF3FED28.title: "&6机械弩手 (Mechanical Crossbow)"
	quest.469B64421439E360.quest_desc: [
		"&6一架&r飞机需要的不止是引擎才能翱翔。螺旋桨将引擎的动力转化为前进推力，让你的飞机&b持续&r在空中移动。"
		""
		"制作你的第一个&b螺旋桨&r，给你的飞行器装上起飞所需的动力。"
	]
	quest.469B64421439E360.quest_subtitle: "推动你的飞行器前进的那股力量。"
	quest.46A69BCFF6744616.quest_desc: [
		"&a石匠台&r能让你把石头方块变成多种装饰性方块。"
		"用它来建造精细的石质结构，改善你的建筑。"
	]
	quest.46A69BCFF6744616.quest_subtitle: "塑造石头"
	quest.46AA5260745A949E.quest_desc: [
		"&6Combine&r the rugged look of Locometal with the distinctive shine of brass. Brass Wrapped Locometal is perfect for adding elegant industrial &bdetails&r to locomotives, train cars and railway structures."
		""
		"&b赋予&r你的列车精致的金属质感，让黄铜脱颖而出。"
	]
	quest.46AA5260745A949E.quest_subtitle: "工业强度，带有一丝黄铜的质感。"
	quest.46BB2F4549949A32.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.46CA848218860D6D.quest_desc: [
		"&dBattle-Evoker&r头盔是Crystal Chronicles对Iron’s Spells ’n Spellbooks中Archevoker帽子的升级版。"
		""
		"使用 Avaricite Shard 进行 &b升级&r，将原本的 Archevoker Armor 转变为强大的 Battle-Evoker Armor 套装。Avaricite Shard 为头盔注入了额外的 Evocation 魔法，&b创造&r了更强大的、&b专注于战斗的&r Archevoker 装备版本。"
	]
	quest.46CA848218860D6D.quest_subtitle: "由 Avaricite 强化的 Archevoker 帽子增强版"
	quest.46D584103F33AE01.quest_subtitle: "真美味！"
	quest.46DD248B39004FF0.quest_desc: [
		"&9&l从&r&r必须靠近 Refined Storage 网络的&b&r束缚中&b&r解放自己。无线发射器能扩展无线设备的范围，让你能更远距离地访问数字存储系统。"
		""
		"将其连接到您的网络，以扩大无线网格和其他设备与系统&b通信&r的区域。"
	]
	quest.46DD248B39004FF0.quest_subtitle: "将你的网络置于无线信号范围内"
	quest.47083ED15C0F3DE5.quest_desc: ["&a从Aquaculture 2中获取&r一个宝箱。这个&b钓鱼&r战利品容器可以在钓鱼时找到，里面装有贵重物品。打开宝箱即可&b收集&r藏在里面的奖励。"]
	quest.47083ED15C0F3DE5.quest_subtitle: "来自深海的珍贵发现"
	quest.470D4D1A09C0C455.quest_subtitle: "更多盔甲 (More Armor)"
	quest.47134CF6AC532845.title: "你在干什么！！！"
	quest.47177AEEFEB5BD97.quest_desc: [
		"&l&9The&r&r Limited Oak Barrel II offers an improved storage option for your growing collection. With more capacity than its previous tier, it gives you &badditional&r room while keeping the compact design of the barrel."
		""
		"&b升级&r你的存储系统，为更大、更强大的容器做好准备。"
	]
	quest.47177AEEFEB5BD97.quest_subtitle: "在不牺牲紧凑性的前提下获得更多存储空间"
	quest.47328555E8FB2605.quest_desc: ["&a欢迎来到&r Farmer's Delight，一个扩展 Minecraft 种植和烹饪体验的模组。种植新作物，收集新鲜食材，准备&b美味&r佳肴，并使用新烹饪工具来创造各种各样的食物。建造你自己的农场，改善你的厨房，探索这个模组能提供的&b一切&r！"]
	quest.47328555E8FB2605.quest_subtitle: "探索一个全新的农场、烹饪和美食世界！"
	quest.47328555E8FB2605.title: "&l&a欢迎来到农夫乐事模组"
	quest.4732EEBDEAA4EC0C.quest_subtitle: "真美味！"
	quest.4736643A29E3B4E4.quest_desc: [
		"&aHidden&r deep beneath the ocean's &bsurface&r lies the Ocean Monument, a colossal structure built by an ancient civilization long forgotten. Guarded by the relentless Elder Guardians and countless Guardians, this &bunderwater&r fortress conceals valuable treasures and mysteries waiting to be uncovered."
		""
		"&aReaching&r the monument is only the beginning. &bNavigating&r its maze-like halls while battling the dangers of the deep will test both your courage and your preparation. Few adventurers dare to &bchallenge&r the rulers of the ocean."
	]
	quest.4736643A29E3B4E4.quest_subtitle: "波涛之下的古老堡垒"
	quest.4736643A29E3B4E4.title: "&3找到一个海洋神殿"
	quest.47384BA676BD425F.quest_desc: [
		"&6你的&r火车不仅能运载&b乘客&r和货物，还能携带自己的燃料。便携式燃料接口能让你将液体燃料直接转移到行驶中的火车上安装的燃料箱里。"
		""
		"&bConnect&r it to your fuel system and keep your locomotives running wherever the tracks may lead."
	]
	quest.47384BA676BD425F.quest_subtitle: "将燃料直接运送到你的移动列车上。"
	quest.473B6BB78E58CBB5.quest_desc: ["&dBreezebreaker&r 是一把锋利、修长且轻便的剑，&b专为&r机动性和爆发伤害而设计。"]
	quest.473B6BB78E58CBB5.quest_subtitle: "风之刃 Blade of the Wind"
	quest.473B6BB78E58CBB5.title: "&l&fBreezebreaker"
	quest.476132B037ACA341.quest_desc: [
		"&dAvaricite&r 碎片是《水晶编年史》中的一种稀有升级材料。可用于将“铁之咒语与咒语书”中的远古召唤者盔甲升级为强大的&b战斗召唤者&r盔甲套装。"
		""
		"碎片将&b原始&r的Archevoker装备注入了强化的Evocation魔法，&b将其&r转变为更强大、专注于战斗的形式。它也与Evoker's Twinblade的创造&b相关&r。"
	]
	quest.476132B037ACA341.quest_subtitle: "用于增强阿基沃克装备的强大水晶碎片"
	quest.4779CB63122DE3F7.quest_subtitle: "更多盔甲 (More Armor)"
	quest.477A3F928303BA4F.quest_desc: [
		"&aCombine&r Netherite Scrap with Gold Ingots to create a Netherite Ingot."
		"这种强大的材料&b用于&r升级你最强大的装备。"
	]
	quest.477A3F928303BA4F.quest_subtitle: "最坚固的材料"
	quest.477A3F928303BA4F.title: "&6下界合金锭"
	quest.4789F9858918B0D7.quest_desc: ["&6经验桶&r包含来自 Create: Enchantment Industry 的液态经验。它允许将经验以流体的形式存储和运输，使其&b适用于&r向机器（如烈焰锻造炉）及其他&b经验处理&r设备中输送经验。该模组&b专门&r支持使用经验桶与自动化系统配合。"]
	quest.4789F9858918B0D7.quest_subtitle: "将经验值以液体形式储存起来"
	quest.47A394FD8E54F490.quest_desc: ["&6Craft&r the Honey Spout Gun and &buse&r honey as your ammunition. Fill the gun with honey using a Spout, then fire honey &bprojectiles&r at your targets. The honey variant is one of the specialized Spout Guns &bavailable&r in Create: Misc \\& Things."]
	quest.47A394FD8E54F490.quest_subtitle: "让你的敌人赖着不走，寸步难行"
	quest.47ACEEFFEB611799.quest_desc: ["&6获取&rChorium Ingot，这是Create: Encased添加的一种特殊材料。这种奇特的锭用于高级配方和机械，是推进模组&b更高级别&r技术的重要资源。"]
	quest.47ACEEFFEB611799.quest_subtitle: "锻造这种奇怪的金属"
	quest.47AF5FEF0643AA7E.quest_desc: ["制作&6Hypertube Accelerator&r，提高穿过你的Hypertube网络的实体的&b速度&r。将其放置在管道系统中，为旅行者提供额外推力，使&b长途&r运输更加快捷。该方块是Create: Hypertubes的实际组成部分；该模组的更新日志中明确&b提及&r了对加速器方块的修复。"]
	quest.47AF5FEF0643AA7E.quest_subtitle: "将你的交通工具推向极限"
	quest.47BADA4235535429.quest_desc: ["&e是时候&r提升火力了！自动弩是一种装有&b旋转&r弩臂的机械弩，可自动装填箭矢。装填速度提升一倍，让你能倾泻出猛烈的&b箭雨&r，在战斗中占据优势。准备好你的&b弹药&r，来测试这把非凡的武器吧！"]
	quest.47BADA4235535429.quest_subtitle: "连发机械武器"
	quest.47C268D0D0265CB4.quest_desc: [
		"&aComplete&r your Steeleaf tool collection by crafting the Steeleaf Hoe and Steeleaf Shovel. Forged from the enchanted Steeleaf material, these tools combine the resilience of steel with the magic of the Twilight Forest, making everyday &btasks&r faster and more efficient."
		""
		"&aWhether&r preparing farmland for crops or clearing paths through dirt and gravel, these tools will serve as reliable &bcompanions&r throughout your adventure."
	]
	quest.47C268D0D0265CB4.quest_subtitle: "用于耕作和挖掘的工具"
	quest.47C268D0D0265CB4.title: "Steeleaf 农业工具"
	quest.47CE8704CD58F8FF.quest_subtitle: "更多盔甲 (More Armor)"
	quest.47D18D97CE66089B.quest_desc: [
		"&6Built&r for a locomotive that means business. The Iron Wrapped Locometal Boiler combines the rugged appearance of Locometal with a sturdy &biron-wrapped&r design, making it a perfect centerpiece for a heavy industrial steam locomotive."
		""
		"&bBuild&r the boiler, assemble your locomotive and put some serious steam power on the rails."
	]
	quest.47D18D97CE66089B.quest_subtitle: "为强大的蒸汽机车打造的坚固铁艺。"
	quest.47D72FA088721244.quest_desc: [
		"&d附魔咒语本&r是 Iron's Spells 'n Spellbooks 的钻石级咒语本。它提供 &b10&r 个咒语栏位，并赋予 &b+100&r 最大法力值，让你能施展更强大的魔法，并拥有更大的法力池。"
		""
		"&b升级&r学徒魔法书，准备好迎接更强大的魔法力量。"
	]
	quest.47D72FA088721244.quest_subtitle: "驾驭附魔知识的力量，释放无尽潜能"
	quest.47E301B12F8E97C0.quest_desc: ["&6The&r Brass Rod and Electrum Rod are metal components used in the crafting of advanced equipment and electrical &bcomponents&r in Create Crafts \\& Additions. Add both rods to your collection and prepare the &bmaterials&r needed for more &badvanced&r electrical engineering. Electrum Rods are &bpart&r of the mod's electrical component progression."]
	quest.47E301B12F8E97C0.quest_subtitle: "为高级工程准备金属材料"
	quest.47E7E7128951C073.quest_subtitle: "真美味！"
	quest.47EED74B95063F61.quest_desc: ["&d一套&r强大的翅膀，能让穿戴者获得&b飞行&r的能力。"]
	quest.47EED74B95063F61.quest_subtitle: "神圣力量赋予的宏伟双翼"
	quest.47F5CD437391B607.quest_desc: ["&6从创造模组中获得&r一个Extendo Grip。这个强大的工具能大幅&b提升&r你的方块交互和攻击距离，让你能更轻松地远程放置、破坏和交互。它也可以在副手使用，与另一工具配合。若双手都使用Extendo Grip，&b使用&r时能进一步延长距离。当佩戴有加压空气的铜或下界合金Backtank时，其使用会&b消耗&r储罐的空气，而非Grip的耐久度。"]
	quest.47F5CD437391B607.quest_subtitle: "超越你的极限，更进一步"
	quest.4810A2E81F1B3318.quest_desc: [
		"绿宝石代表着&b知识&r和&b价值&r。"
		"&a与下界合金结合，&r打造出兼具力量与声望的杰出头盔。"
	]
	quest.4810A2E81F1B3318.quest_subtitle: "智慧与财富"
	quest.4810A2E81F1B3318.title: "绿宝石下界合金头盔"
	quest.4836CFA7D5E47849.quest_desc: [
		"Amaramber 斧是 Eternal Starlight 中 &a用于伐木&r的工具，&b于版本 0.4.2 随 Amaramber 装备套装一同&r推出。"
		""
		"&a它&r用&b于&r采集 Torreya 树的木材，是 Starlight 维度中基础的&b进阶&r工具。"
	]
	quest.4836CFA7D5E47849.quest_subtitle: "琥珀木伐木工具"
	quest.483C2BFD70CED49A.quest_desc: [
		"Deepsilver Sickle 是一种来自 Eternal Starlight 的&a收割&r工具，使用&bDeepsilver Ingots&r制作而成。"
		""
		"&a它&r被&b用&r于高效采集沼泽和暮色区域的植物，是深海银套装中早期到中期的&b进阶&r工具。"
	]
	quest.483C2BFD70CED49A.quest_subtitle: "沼泽地收割工具"
	quest.484C148B135F2DC6.quest_subtitle: "更多盔甲 (More Armor)"
	quest.484C2F55E67F3802.quest_subtitle: "更多盔甲 (More Armor)"
	quest.485AF245607835C0.quest_desc: [
		"The Deepsilver Shovel is a &adigging&r tool from Eternal Starlight crafted &busing&r Deepsilver Ingots."
		""
		"&a它&r用于沼泽和暮色区域的挖掘，比铁制工具更耐用，同时&b仍&r是前中期过渡的一部分。"
	]
	quest.485AF245607835C0.quest_subtitle: "沼泽挖掘工具"
	quest.486E0292995D0A16.quest_desc: [
		"&dCultist&r靴是Iron's Spells 'n Spellbooks中Cultist盔甲套装的一部分。穿戴后可提供&b+3&r护甲、&b+125&r最大法力、&b+10%&r血系法术强度和&b+5%&r法术强度。"
		""
		"They can be &bcrafted&r from 4 Arcane Cloth and 1 Blood Rune, or upgraded from Wizard Boots with 1 Blood Rune at a Smithing Table in supported versions."
	]
	quest.486E0292995D0A16.quest_subtitle: "踏上血魔法的道路，勇往直前"
	quest.4870F1D895BF5B67.quest_desc: ["&a击败&r来自Cataclysm模组的3个深海怪。这些敌对水生生物可以在水下&b结构&r和深海区域找到。它们是&b海洋深处&r的危险居民之一。"]
	quest.4870F1D895BF5B67.quest_subtitle: "击败深海的生物们"
	quest.4870F1D895BF5B67.title: "击杀深海守卫"
	quest.48889D7AC8BBD356.quest_desc: ["&6Build&r the Basic Energiser, Advanced Energiser, and Reinforced Energiser to &bprogress&r through the electrical &btechnology&r of Create: New Age. Each tier provides a stronger and more advanced way to use electricity in your factory. &bUpgrade&r your Energisers as your power &binfrastructure&r grows."]
	quest.48889D7AC8BBD356.quest_subtitle: "让你的生产充满能量"
	quest.48889D7AC8BBD356.title: "Energiser 进度系统"
	quest.48A56DDDA5DA4979.quest_desc: ["&6Electron&r Tubes are advanced crafting components used to &bunlock&r many of Create's more complex machines and automation blocks. They are crafted from Polished Rose Quartz and an Iron Sheet. Electron Tubes are used in recipes for components such as the Deployer, Mechanical Crafter, Mechanical Roller, Sequenced Gearshift, Smart Chute, Smart Fluid Pipe, Nixie Tube and more. They &bdon't&r have a function on their own, but are an important step toward &badvanced&r Create automation."]
	quest.48A56DDDA5DA4979.quest_subtitle: "高级自动化的关键所在"
	quest.48A87C1B6721A46A.quest_desc: ["&eA&r Game Disc featuring TNT Swapper, a fast-paced game where you must &breact&r quickly and swap TNT to avoid &bgetting&r caught in the explosions. Test your reflexes and try to achieve the highest score."]
	quest.48A87C1B6721A46A.quest_subtitle: "交换 TNT 并在这场爆炸中生存下来！"
	quest.48B0380E8AFB165A.quest_desc: [
		"&a砂轮&r是一种简单而强大的工具，可用于修复和清洁武器。用它来移除附魔或恢复装备的锋利度。"
		""
		"收集它，考验你的战斗技巧！确保你的武器已准备好迎接任何前方的&b挑战&r。"
	]
	quest.48B0380E8AFB165A.quest_subtitle: "掌握研磨技艺"
	quest.48B0380E8AFB165A.title: "磨练你的技艺"
	quest.48CF25B2EA87230B.quest_desc: [
		"在永恒星光维度&a的深处&r，结晶沙漠无限延伸，其沙土与地形都&b融入了&r闪烁的&b水晶&r能量。"
		"环境恶劣而不稳定，但富含稀有晶体资源和&b隐藏&r的危险。"
		""
		"&aExploring&r this biome is essential for advancing into higher-tier crafting and uncovering the secrets of starlight materials."
	]
	quest.48CF25B2EA87230B.quest_subtitle: "星辰的玻璃杯"
	quest.48CF25B2EA87230B.title: "&5结晶化的沙漠"
	quest.48D914252224225C.quest_desc: ["&6获取&r一个来自Create的Item Drain。它用于收集桶和瓶子等物品中的流体，适用于&b自动化&r流体处理。Item Drain也可以从像Basin和Crushing Wheel这样的&b加工&r装置中接收流体。"]
	quest.48D914252224225C.quest_subtitle: "收集机器们留下的残骸碎片"
	quest.48FEA157EC48231C.quest_desc: ["&aCraft&r a Neptunium Hoe from Aquaculture 2. This tool is made from Neptunium, a &brare material&r obtained from fishing treasures. It offers high &bdurability&r and &bcompletes&r the Neptunium tool set."]
	quest.48FEA157EC48231C.quest_subtitle: "来自海洋宝藏的稀有工具"
	quest.4906468642C87C12.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.491DA89E2EE814B7.quest_desc: [
		"&a探索世界&r有时会让你很难找到想要寻找的生物群系。"
		"自然指南针可以帮助你定位世界中的任何生物群系。"
		""
		"用它来搜寻稀有环境、特殊资源，或是新的探索地点。"
	]
	quest.491DA89E2EE814B7.quest_subtitle: "找到任意生物群系"
	quest.491EA7E5B2C9DDAA.quest_subtitle: "升级+"
	quest.493A5EACADDD3B6C.quest_desc: ["&e一张&r可以在游戏机里玩史莱姆的游戏光盘。控制你长长的黏糊糊的身体，吃苹果来&b提高&r分数，避免撞到自己。当史莱姆被骷髅杀死时，就能&b获得&r这张光盘。"]
	quest.493A5EACADDD3B6C.quest_subtitle: "控制你的史莱姆，吃掉苹果！"
	quest.493BB012638A87A8.quest_desc: ["&6Craft&r a Depot from Create. &bIt&r acts as a stationary item-processing platform, allowing items to be placed on it and &binteracted&r with by machines such as the Mechanical Press and Mechanical Arm. &bItems&r placed on a Depot remain there until extracted by a player or another machine."]
	quest.493BB012638A87A8.quest_subtitle: "用于机械加工的自动化平台"
	quest.494086F68261B13C.quest_desc: ["&6从Create模组中获取&r一个火车侦测器。 &b它能&r检测到火车经过其指定的&b轨道&r区段，并在火车处于探测范围内时输出红石信号。可用于铁路道口、警报器、门、灯和其他&b自动化&r铁路系统。"]
	quest.494086F68261B13C.quest_subtitle: "注意经过的火车，不要分心"
	quest.496205C04458BA6C.quest_subtitle: "升级+"
	quest.49ADC9F715973002.quest_desc: [
		"使用由九头蛇的炽热精华锻造的烈焰锭来&a制作&r烈焰胸甲。这件盔甲蕴含着强烈的热量和&b远古&r魔法，能提供卓越的防护，同时散发着曾统治火焰沼泽的&b传奇&r巨兽的力量。"
		""
		"&aAs&r the centerpiece of the Fiery Armor set, the chestplate provides &bunmatched&r durability and symbolizes your triumph over one of the Twilight Forest's most fearsome bosses. With its burning strength at your side, few &benemies&r will dare stand in your way."
	]
	quest.49ADC9F715973002.quest_subtitle: "穿戴九头蛇的心脏护甲"
	quest.49BEE3A8084C246B.quest_desc: ["&6A&r 特殊灯泡，通电后可加速区域内作物的生长。将其安装在农田上方并接好电线。"]
	quest.49BEE3A8084C246B.quest_subtitle: "加快作物生长速度"
	quest.49C08FD7E6A4C52C.quest_desc: ["&aCraft&r a Black Steel Axe from the Cataclysm mod. This &bdurable&r tool is made using Black Steel and provides high &befficiency&r for chopping wood. It is part of the Black Steel &bequipment&r set."]
	quest.49C08FD7E6A4C52C.quest_subtitle: "由黑钢锻造而成的强大工具"
	quest.49C486B2FF808B11.quest_desc: ["&6Limestone&r is a new resource from Create: Aquatic Ambitions. It can be processed using Conduit Channeling to obtain Nautilus Shells, providing a &brenewable&r way to acquire this otherwise &buncommon&r ocean treasure. It is also part of the mod's expanded aquatic resource progression."]
	quest.49C486B2FF808B11.quest_subtitle: "一块蕴含着深海秘密的石头"
	quest.49DB50F19942B35D.quest_desc: ["&a击败&r来自Cataclysm模组的3个深海怪暴徒。这些强大的近战敌人是深海怪的更强&b变种&r，可在深海怪水下&b结构&r和深海区域找到。"]
	quest.49DB50F19942B35D.quest_subtitle: "击败最强的深海守卫战士"
	quest.49DB50F19942B35D.title: "击杀深海守卫壮汉"
	quest.49E14A4712AA4F09.quest_desc: ["&6Craft&r a Chocolate Glazed Marshmallow by coating a soft, fluffy marshmallow with chocolate. It is a sweet combination of a light marshmallow center and a rich chocolate coating, perfect for your Create: Confectionery collection. &bChocolate-coated&r marshmallows are a classic confection with many variations."]
	quest.49E14A4712AA4F09.quest_subtitle: "裹着浓郁巧克力的蓬松小点心"
	quest.49E4501E720A0B70.quest_subtitle: "更多盔甲 (More Armor)"
	quest.49E68A5767EA34D5.quest_desc: [
		"&9&lTake&r&r your Refined Storage network to the next level with the &b1k&r Storage Disk. This disk provides digital storage for up to 1,000 different item types, giving your &bnetwork&r a compact and efficient way to &bmanage&r your resources."
		""
		"将其插入磁盘驱动器，开始用你收集的一切填满数字存储网络。"
	]
	quest.49E68A5767EA34D5.quest_subtitle: "存储你的第一千种不同类型的物品"
	quest.49FE9EA0F48BF36D.quest_desc: ["从 Create 中获取&6&r下界合金潜水头盔。它是潜水头盔的&b&r升级版，与背囊配合使用时可提供水下呼吸能力，并改善水下视野。作为&b&r下界合金级别的物品，它还具备与下界合金装备相关的耐久度和火焰/岩浆抗性&b&r。下界合金潜水头盔在 Create 0.5.1 中引入。"]
	quest.49FE9EA0F48BF36D.quest_subtitle: "下降到他人无法企及的地方"
	quest.4A106AFA1714BD05.quest_desc: [
		"&d残破之书&r是一种史诗级的魔法物品，可在被&b潜行者侵扰的&r远古城市中找到。这本&b神秘的&r典籍是制作强大法术书的重要材料，对任何有志成为施法者的人来说都是一项宝贵的发现。"
		""
		"&b搜寻&r远古遗迹，找回这份被遗忘的知识，并&b运用&r它以推进你的魔法进程。"
	]
	quest.4A106AFA1714BD05.quest_subtitle: "从古代城市中恢复被遗忘的知识"
	quest.4A172CC6B6D3CEA6.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.4A20F570984048DC.quest_desc: [
		"&dBlank&r Runestone is the base material &bused&r to create the different school-specific runes in Iron's Spells 'n Spellbooks. It can be &bfound&r rarely in vanilla structures and more commonly in magical structures."
		""
		"&b使用&r 8 个魔法焦点，将空白符文石转化为特定魔法学派的一种符文。"
	]
	quest.4A20F570984048DC.quest_subtitle: "每一条魔法符文的基础所在"
	quest.4A29CFB3B64223A9.quest_desc: ["&6A&r 装饰性天花板方块。你可以为其添加某些方块来扩展其功能。"]
	quest.4A29CFB3B64223A9.quest_subtitle: "一个时尚的天花板"
	quest.4A2FF89D06467FF8.quest_desc: ["&6The&r Heat Pipe is a key component of the thermal system in Create: New Age. It allows heat to be transferred between machines and components, &bmaking&r it possible to build larger and more efficient &bheat-based&r setups. Use Heat Pipes to connect your heat sources with the machinery that &bneeds&r their power."]
	quest.4A2FF89D06467FF8.quest_subtitle: "将热量带到该去的地方"
	quest.4A3907C2223E07C1.quest_desc: ["&6Rolling Mill&r 是 Create Crafts & Additions 中一种将金属加工成金属棒和金属丝的动能机器。它是该模组&b电气&r进阶的重要步骤，能让你准备好铜、铁、金、黄铜和电金等&b材料&r来制作电气元件。用 Create 的旋转力为其供电，&b开始&r生产电气网络所需的元件吧。"]
	quest.4A3907C2223E07C1.quest_subtitle: "将金属轧制成有用的组件"
	quest.4A49086B89A98BA7.quest_desc: ["&6欢迎来到&r《创造：水下雄心》！此扩展包为《创造》增添了&b以水下为主题的&r机器、工艺和&b生产&r链。利用导管的力量自动化处理棱镜岩、珊瑚和铜，复兴珊瑚，生产可再生&b资源&r，并以新方式将海洋的&b宝藏&r带入你的工厂。"]
	quest.4A49086B89A98BA7.quest_subtitle: "潜入一个全新的自动化世界"
	quest.4A49086B89A98BA7.title: "&l&6欢迎来到创造：水下雄心模组"
	quest.4A57F38EC26647B5.quest_desc: [
		"&d暗影行者&r靴是 Iron's Spells 'n Spellbooks 中暗影行者盔甲套装的一部分。穿戴后可提供 &b+3&r护甲、&b+125&r最大法力、&b+10%&r末影法术强度和 &b+5%&r法术强度。"
		""
		"They can be &bcrafted&r from 4 Arcane Cloth and 1 Ender Rune, or upgraded from Wizard Boots with 1 Ender Rune at a Smithing Table in supported versions."
	]
	quest.4A57F38EC26647B5.quest_subtitle: "借助末地魔法的力量，在世界之间穿行"
	quest.4A57F57C824016CB.quest_desc: [
		"制作&a音符钩子&r，一种独特的钓鱼升级，将&b创造力&r与垂钓艺术相结合。受&b音乐与海洋奥秘&r启发，这个&b别致的&r鱼钩将为你的钓鱼之旅增添一丝和谐。"
		""
		"&aThe&r greatest explorers &bunderstand&r that every journey has its own rhythm. With the Note Hook, you continue expanding your collection of specialized &bfishing&r tools while uncovering the hidden wonders of the waters."
	]
	quest.4A57F57C824016CB.quest_subtitle: "海浪之下的旋律"
	quest.4A6C2910F457E665.quest_subtitle: "更多盔甲 (More Armor)"
	quest.4A75D2C036284DCB.quest_desc: ["&6储存&r少量&b电力&r。将其放置在电路板的电子电路中。"]
	quest.4A75D2C036284DCB.quest_subtitle: "一个电容器"
	quest.4AAFEDBF0AB83B90.quest_desc: [
		"&a星焰斧&r是永恒星光中的一个武器，&b属于&r星焰装备系列。"
		""
		"&a它&r是模组进阶进度系统的一部分，使用后期内容引入的星焰&b材料&r制作而成。"
	]
	quest.4AAFEDBF0AB83B90.quest_subtitle: "星光锻造武器"
	quest.4AB1DD95EB928F87.quest_desc: ["&6酿造&r香槟，为您的酿酒厂增添气泡风味。使用酒窖和Create的机械装置来加工所需的&b原料&r，为您的收藏再添一款精致饮品。Create: Winery模组添加了葡萄酒主题的配方和一个可完全自动化的酒窖，用于&b酿造&r葡萄酒和苹果酒。"]
	quest.4AB1DD95EB928F87.quest_subtitle: "庆祝你酿酒坊的累累硕果"
	quest.4ABE2718DCC5D7EB.quest_desc: [
		"&d法力&r升级球是 Iron's Spells 'n Spellbooks 中的一种升级材料。在神秘砧上使用时，可提供 &b+50&r 最大法力。"
		""
		"它可以&b被应用&r到兼容的装备上，从而显著增加你的最大法力值。默认情况下，一件可应用的&b装备&r最多可接受3次升级。"
	]
	quest.4ABE2718DCC5D7EB.quest_subtitle: "将你的法力池扩展到其极限之外"
	quest.4AE697EE6FBF5960.quest_desc: [
		"&e既然能让物品来找你，&r何必到处捡拾呢？"
		""
		"通用引力会将附近的掉落物吸向你，&b让&r收集战利品、&b资源&r和散落在地上的其他物品变得更容易。"
		""
		"让世界将它的&b宝藏&r带给你。"
	]
	quest.4AE697EE6FBF5960.quest_subtitle: "没有什么东西是遥不可及的"
	quest.4B01BC3CE092F66E.quest_subtitle: "更多盔甲 (More Armor)"
	quest.4B1A61026D1EE612.title: "好的，我明白了。我将从你提供的文本中翻译出任务书的内容。"
	quest.4B26401BFE038111.quest_desc: ["&6欢迎来到&r创造：附魔工业！此扩展包为创造增添了处理经验和附魔的新方式。 &b储存&r和运输液态经验，自动化附魔与去附魔，修复修补装备，并建造能将&b附魔&r之力带入工厂的&b机器&r。"]
	quest.4B26401BFE038111.quest_subtitle: "将附魔带入你的工厂中"
	quest.4B26401BFE038111.title: "&6&l欢迎来到创造附魔工业模组"
	quest.4B35FBD711F6FCC5.quest_desc: [
		"&aGlacite Boots&r 是一种由永恒星光制成的抗寒靴子，使用&bGlacite材料&r制作而成。"
		""
		"冰川盔甲能减缓受冰冻效果影响的&a敌人&r的攻击速度，并提高在&b寒冷&r环境中的生存能力。"
	]
	quest.4B35FBD711F6FCC5.quest_subtitle: "冰冻的防护鞋履"
	quest.4B4FC2AA2A20E7E3.quest_desc: [
		"Terminite Anvil 需要配合 Smith Hammer 使用，将 Terminite Ingot 锻造成 &aForged Plates&r 和工具头。"
		""
		"可以访问 Terminite 改进的 &b工具&r 和盔甲。"
	]
	quest.4B4FC2AA2A20E7E3.quest_subtitle: "加工第二层金属制品中"
	quest.4B5A6B66CBDFA9E6.quest_desc: [
		"&a万用表&r用于Chipped的许多装饰性工作台的制作配方中。"
		"这些工作站能将普通方块变成多种装饰性方块。"
	]
	quest.4B5A6B66CBDFA9E6.quest_subtitle: "用于制作工作站的一种工具"
	quest.4B5FB73C4D1282A6.quest_desc: [
		"塔拉西姆护腿在锻造台用塔拉西姆板合成。"
		""
		"它们提供了 Better End 的 &a盔甲&r系列的入门级防护。"
	]
	quest.4B5FB73C4D1282A6.quest_subtitle: "第一阶的护腿装备"
	quest.4B77EA20C31AD953.quest_desc: ["&6从Create模组中获取&r一个转盘。当用&b旋转&r力驱动时，它会旋转站在上面的实体，包括玩家和盔甲架。它由&b一根轴和一块木板&r合成。"]
	quest.4B77EA20C31AD953.quest_subtitle: "让你的创造充满动感，旋转起来"
	quest.4BA6F9A3E87FDC34.quest_subtitle: "升级+"
	quest.4BAB09ECE6C2C644.quest_desc: ["&6一&r个需要设置的复杂装置：在加热器和阴极引脚之间提供12伏电压，在阳极和阴极之间提供约1000伏电压。用偏转线圈移动光点，并用负的栅极&b电压&r改变轨迹亮度。"]
	quest.4BAB09ECE6C2C644.quest_subtitle: "一个阴极射线管"
	quest.4BC1D4BCEDD0A03A.quest_desc: ["从Cataclysm模组中获取&aAnnihilator&r。这把强大的终局武器可以使用&b机械&r融合&b砧&r进行升级，是模组中&b最强&r武器库的一部分。"]
	quest.4BC1D4BCEDD0A03A.quest_subtitle: "一种毁灭性的破坏武器"
	quest.4BC1D4BCEDD0A03A.title: "&b湮灭者 (The Annihilator)</c1>"
	quest.4BC56D1B40AB327B.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.4BCF7A1B36B2B345.quest_desc: ["&eWelcome&r to the world of Clockwork! &bGet&r ready to discover extraordinary inventions, mechanical gadgets, and &badvanced&r technology. &bFrom&r the automatic crossbow to mechanical wings, there are plenty of possibilities waiting for you. Explore the available devices and discover how to &buse&r them on your adventure!"]
	quest.4BCF7A1B36B2B345.quest_subtitle: "机制、发明与新的可能性"
	quest.4BCF7A1B36B2B345.title: "&l&f欢迎，&eClockwork"
	quest.4BD01B57E5E269DE.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.4BDBD1D7C39E0037.quest_desc: [
		"&dPyromancer&r Helmet 是 Crystal Chronicles 对 Iron's Spells 'n Spellbooks 中 Pyromancer Helmet 的升级版。"
		""
		"使用火山岩碎片升级，可&b增强&r原始的火球术师盔甲，赋予其&b额外的&r晶体力量。火山岩碎片用于将铁匠铺的魔法与魔典火球术师盔甲套装&b升级&r为增强版水晶编年史版本。"
	]
	quest.4BDBD1D7C39E0037.quest_subtitle: "由火山岩强化的增强型火魔法师头盔"
	quest.4BE07CB092BABFF0.quest_subtitle: "升级+"
	quest.4BE67B84445A1AB2.quest_desc: [
		"The Amaramber Shovel is a &adigging&r tool from Eternal Starlight introduced in version 0.4.2 as &bpart&r of the Amaramber equipment set."
		""
		"&a它&r被&b用&r于在星光维度挖掘地形和采集软方块。"
	]
	quest.4BE67B84445A1AB2.quest_subtitle: "琥珀挖掘工具"
	quest.4BE9919FC2DABEFA.title: "&l&d月之怪物"
	quest.4BF14CA9D2296730.quest_desc: [
		"&d借助法力戒指，驾驭&r法力的力量。这件魔法配饰能通过提供额外的&b法力相关&r增益来辅助你的施法，是每位魔法学徒的宝贵装备。"
		""
		"&b装备&r戒指，在继续掌握强大法术的同时，加强与神秘艺术的联系。"
	]
	quest.4BF14CA9D2296730.quest_subtitle: "随身携带强大的法力，无论走到哪里"
	quest.4C185288A6D081F5.quest_desc: [
		"这顶头盔&a结合了&r下界合金的耐久性和铁的可靠性。"
		"它能&a提供&r坚固的保护，让你能在长时间的战斗和&b探索&r中保持专注。"
	]
	quest.4C185288A6D081F5.quest_subtitle: "清晰的视野，强大的防御"
	quest.4C185288A6D081F5.title: "铁质下界合金头盔"
	quest.4C3650C5A427761F.quest_desc: ["&6Craft&r the Viola pipe and expand your pipe organ with a distinctive &bstring-like&r voice. Viola was &bintroduced&r in Create: Sound of Steam 0.8.0 as one of seven new pipe types."]
	quest.4C3650C5A427761F.quest_subtitle: "添加一个温暖、富有磁性的声音"
	quest.4C3CFFC7F0F022AC.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.4C401993C8B782AA.quest_desc: ["&aObtain&r the Monstrous Flamberge from the Cataclysm: Spellbooks addon. This &blegendary&r greatsword channels overwhelming monstrous power and grants its wielder access to the &bunique&r Tectonic Tremble spell, &bdevastating&r anything that stands in its path. It is one of the signature magical &bweapons&r of the addon."]
	quest.4C401993C8B782AA.quest_subtitle: "挥舞着怪物般愤怒的利刃"
	quest.4C401993C8B782AA.title: "&c怪物级火焰剑"
	quest.4C526EBA57193B1C.quest_subtitle: "更多盔甲 (More Armor)"
	quest.4C59B91129B05AE5.quest_desc: [
		"&a玻璃瓶&r是酿造药水所必需的。"
		"它们用于收集水，并作为游戏中几乎所有药水的基础容器。"
		"没有它们，炼金术就无法开始，因此它们是酿造&b进度&r所需的最初物品之一。"
	]
	quest.4C59B91129B05AE5.quest_subtitle: "用于放置药水的容器"
	quest.4C9297B792670B80.quest_desc: ["&6带&r调速器的电机：它以恒定速度旋转，输入的&b电压&r决定了其应力承受能力和旋转方向。"]
	quest.4C9297B792670B80.quest_subtitle: "一个受控的电机"
	quest.4CB6A063431A3E1B.quest_desc: ["&dThe&r Clockwork Rifle is the most advanced gun in the mod, built from Clockwork Components and &bnetherite&r. Obtaining one earns the Tick-Tock advancement."]
	quest.4CB6A063431A3E1B.quest_subtitle: "精密工程学"
	quest.4CBAA74AE9696366.quest_desc: ["&6Obtain&r a Mechanical Bearing, Windmill Bearing, and Clockwork Bearing from Create. These three bearings are specialized movement anchors &bused&r to create rotating Contraptions. The Mechanical Bearing rotates &battached&r structures using rotational power, the Windmill Bearing turns attached sails or sail-like blocks into a windmill that generates rotational power, and the Clockwork Bearing &brotates&r structures according to the in-game time, allowing you to build working clock hands."]
	quest.4CBAA74AE9696366.quest_subtitle: "掌握旋转的艺术，成为真正的旋转大师"
	quest.4CC1743355211846.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.4CCEA5C17095D575.quest_desc: [
		"&d奥术&r精华是 Iron's Spells 'n Spellbooks 中最常见且最重要的魔法材料之一。它可以在原版和魔法结构中寻获，也可以&b从&r魔法敌人处获得。"
		""
		"Use Arcane Essence in a wide variety of crafting recipes, including the &bcreation&r of Arcane Cloth and Arcane Ingots. Gather plenty of it as you progress, because it becomes one of the most frequently &bneeded&r materials in magical crafting."
	]
	quest.4CCEA5C17095D575.quest_subtitle: "魔法工艺的基础知识"
	quest.4CDBE61718E72389.quest_desc: ["&6Craft&r the White Chocolate Bucket and store liquid White Chocolate for your confectionery factory. Use it to &btransport&r and handle white chocolate as part of your automated production lines in Create: Confectionery, which adds white, black, and ruby chocolate alongside other confectionery ingredients."]
	quest.4CDBE61718E72389.quest_subtitle: "随身携带奶油般的甜蜜，走到哪里都如影随形"
	quest.4CE33FC72CAC65CF.quest_desc: [
		"使用暮色森林冰冻荒野中采集的柔软北极皮毛，&a制作&r北极兜帽。这款兜帽&b精心&r剪裁，保暖的同时不妨碍视野，能保护佩戴者免受刺骨寒风和&b无情&r雪落的侵袭。"
		""
		"&aAs&r part of the Arctic Armor set, the Arctic Hood is &bdesigned&r for adventurers who venture into the &bcoldest&r regions of the Twilight Forest. Its enchanted fur traps heat while remaining lightweight, making it an ideal &bcompanion&r for long expeditions across the Glacier."
	]
	quest.4CE33FC72CAC65CF.quest_subtitle: "用盾牌抵御刺骨的寒风吧"
	quest.4CE6AC5970FB638E.quest_desc: [
		"&6普&r通螺旋桨能完成任务，但总有改进的空间。经铜加强的增强螺旋桨，能&b大幅&r降低空气阻力，让你的飞行器更高效地保持动量。"
		""
		"&b升级&r你的螺旋桨，轻松划破空气。"
	]
	quest.4CE6AC5970FB638E.quest_subtitle: "减少阻力，提升速度。"
	quest.4CEB97C524D1D45C.quest_desc: ["&6机械收割机&r是一种用于&b自动化&r耕种的装置组件。当移动的装置经过作物时，收割机会收集成熟作物及其掉落物，而不会&b破坏&r农田。它还能收割甘蔗等特定植物类型，以及其他被Create注册为可收割的方块。在移动农场上使用多个收割机，即可实现&b大规模&r作物生产的自动化。"]
	quest.4CEB97C524D1D45C.quest_subtitle: "让机器来完成收割工作吧"
	quest.4CEFEE233D1B722D.quest_desc: [
		"&a深海银头盔&r是永恒星光中的一个盔甲部件，使用&b深海银锭&r制作而成。"
		""
		"深海银盔甲能提高&a移动&r速度、攻击速度和击退抗性。穿戴全套还能免疫多种负面&b状态&r效果。"
	]
	quest.4CEFEE233D1B722D.quest_subtitle: "迅捷的银色头盔"
	quest.4CF55AADAB2218B8.quest_desc: [
		"&aDiscover&r the Amber Land — an orange-hued forest of tall, annular Helix trees and glowing high-leaf plants such as &bLanceleaf&r and Amber Root."
		""
		"这是琥珀矿石自然生成的&b唯一生物群系&r，对于收集琥珀宝石至关重要。"
	]
	quest.4CF55AADAB2218B8.quest_subtitle: "扭曲的螺旋树之森林"
	quest.4CF55AADAB2218B8.title: "琥珀之地"
	quest.4CFCCBE2309E8EC2.quest_subtitle: "更多盔甲 (More Armor)"
	quest.4D032F927E1EEA92.quest_desc: ["&6Contraption&r 控制器可以让你在装置组装期间&b启用&r或&b禁用&r特定的 Contraption Actor。右键控制器可以切换支持的组件，如机械钻头、机械锯、部署器、收割机、滚筒、漏斗、便携式存储接口和红石接触器。你也可以在方块静止时应用过滤器，使控制器&b仅&r影响特定类型的 Actor。如果在组装&b前&r和组装期间控制器接收到红石信号，所选 Actor 将以禁用状态开始。"]
	quest.4D032F927E1EEA92.quest_subtitle: "掌控你的机器，让它听从你的命令"
	quest.4D1B5D77205C0308.quest_desc: [
		"&dElectromancer&r Helmet is the Crystal Chronicles upgraded version of the Electromancer Hat from Iron’s Spells ’n Spellbooks."
		""
		"使用伏特碎片进行&b升级&r，为原本的电磁魔导师盔甲套装增强了额外的晶体力量。伏特碎片&b引导&r着闪电魔法的力量，创造出更强大的&b版本&r的原始电磁魔导师装备。"
	]
	quest.4D1B5D77205C0308.quest_subtitle: "由伏特石强化的电磁法师帽的增强版"
	quest.4D22EB48E8F809A1.quest_subtitle: "升级+"
	quest.4D41297C9A7296E4.quest_desc: [
		"&a翡翠附魔的&r工具代表着稀有与高效。"
		"它们强大、耐用，是掌控宝贵&b资源&r的象征。"
	]
	quest.4D41297C9A7296E4.quest_subtitle: "稀有而强大"
	quest.4D41297C9A7296E4.title: "绿宝石下界合金工具"
	quest.4D419B82842C08CD.quest_desc: ["&6酿造&r雷司令，为您的自动化酿酒厂增添一款优雅的白葡萄酒。 &b使用&r酒窖和Create机器来加工所需原料，将收获的葡萄酿造成精致的雷司令。Create：酿酒厂 &b为&rCreate体验增添了葡萄加工和可自动化的酒窖。"]
	quest.4D419B82842C08CD.quest_subtitle: "来自葡萄园的经典佳酿，口感清爽"
	quest.4D44B7D40397F514.quest_subtitle: "更多盔甲 (More Armor)"
	quest.4D652344B212814A.quest_desc: ["&6从Create模组中获取&r机械带。皮带连接传动轴以传递&b旋转&r动力，并能&b运输&r物品和实体。它们可以水平、垂直或&b对角线&r放置在对齐的传动轴之间，是自动化最实用的工具之一。"]
	quest.4D652344B212814A.quest_subtitle: "建造你工厂的骨干结构"
	quest.4D6E5A2127330896.quest_desc: [
		"&9&l用扳手&r&r掌控你的 Refined Storage 网络。 &b使用&r它与已连接的 Refined Storage 设备互动和&b配置&r，让管理设置更轻松。"
		""
		"对于任何构建和维护高级数字存储系统的玩家来说，这是一款简单但&b必要&r的工具。"
	]
	quest.4D6E5A2127330896.quest_subtitle: "配置并维护你的存储网络"
	quest.4D73262F4F52510D.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.4D8BAB5CDE8BFBC0.quest_desc: ["&e来认识&r你的新采矿伙伴！Clockwork Drill 是一款机械工具，能朝其面向的方向直线采矿。它会&b收集&r采到的物品到自己的物品栏中，让你能&b专注于&r其他任务。注意钻头会因使用而磨损，可用 Clockwork Gears 进行修复。 &b激活&r它，让机器来干脏活！"]
	quest.4D8BAB5CDE8BFBC0.quest_subtitle: "自动化采矿"
	quest.4D8ED9083AD53A3F.quest_subtitle: "更多盔甲 (More Armor)"
	quest.4DA1A9ADA6EAE341.quest_desc: [
		"&dThe&r Wandering Magician Hood is part of the early-game Wandering Magician Armor set in Iron's Spells 'n Spellbooks. It provides &b+2&r Armor and &b+25&r Max Mana."
		""
		"将皮革帽与奥术精华结合即可制作，&b开启&r你的魔法护甲之旅。"
	]
	quest.4DA1A9ADA6EAE341.quest_subtitle: "用第一缕神秘力量守护你的心灵"
	quest.4DBBB9179B1F7432.quest_desc: ["Rage of Stars 是 Eternal Starlight 中一款中等星主题的 &a武器&r，用于元素材料向 &b后期&r天体装备的过渡。它侧重于爆发魔法伤害和范围星效，而非 &b纯粹&r的后期强度。"]
	quest.4DBBB9179B1F7432.quest_subtitle: "星光中阶武器"
	quest.4DE0FF6EF901B590.quest_desc: [
		"The Glacite Sword is a &afrost-infused&r weapon from Eternal Starlight crafted &busing&r Glacite Ingots."
		""
		"用于中阶&a进阶&r，能对敌人施加减速效果，在星光维度&b寒冷&r生物群系中能有效控制人群。"
	]
	quest.4DE0FF6EF901B590.quest_subtitle: "霜冻控制之刃"
	quest.4DEC36CB7610E0F7.quest_desc: [
		"使用在暮色森林中收集的附魔钢叶材料来&a制作&r钢叶护腿。这些护腿融合了森林的古老魔法，在提供&b出色&r保护的同时不会影响机动性，让你能安全穿越&b危险&r的生物群系、古代遗迹和充满怪物的地牢。"
		""
		"&aAs&r an important part of the Steeleaf Armor set, they &bstrengthen&r your defenses and prepare you for the greater challenges that await deeper within the Twilight Forest."
	]
	quest.4DEC36CB7610E0F7.quest_subtitle: "受森林之灵的庇护，免受侵害"
	quest.4E02E40EA466844E.title: "&l&3Underworld Knight"
	quest.4E0C8720F0AE3A90.quest_desc: ["&6Give&r sweet berries a luxurious twist with Ruby Chocolate. Inject 250 mB of Ruby Chocolate into Sweet Berries to create this &bcolorful&r treat. Each serving restores &b7&r hunger and &b11.2&r saturation, while granting the Saturation effect for &b2&r seconds."]
	quest.4E0C8720F0AE3A90.quest_subtitle: "裹着奢华红宝石巧克力的香甜浆果。"
	quest.4E1A28D72BD04D36.quest_desc: [
		"Glacite Axe 是 Eternal Starlight 的一种&a伐木&r工具，使用&bGlacite Ingots&r制作而成。"
		""
		"&aIt&r is &bused&r for harvesting wood in cold biomes and provides improved durability and combat &befficiency&r compared to earlier-tier tools."
	]
	quest.4E1A28D72BD04D36.quest_subtitle: "冰冻伐木工具"
	quest.4E433B7C8FE67C0D.quest_subtitle: "更多盔甲 (More Armor)"
	quest.4E439D0CB3D14389.quest_desc: [
		"&a探索&r水晶山脉，这片丘陵岛屿上，色彩缤纷、闪闪发光的水晶山峰从贫瘠的土地中拔地而起。"
		""
		"在这里开采明亮的&b极光水晶&r矿床，偶尔会产出用于融合仪式的关键材料——水晶碎片。"
	]
	quest.4E439D0CB3D14389.quest_subtitle: "散发着光芒的晶体山峰"
	quest.4E439D0CB3D14389.title: "水晶山脉"
	quest.4E7437052378DF33.quest_desc: [
		"&9&l赋予&r&r你的储物箱通过熔炼升级来熔炼兼容物品的能力。它让你可以直接在储物箱中处理矿石、食物和其他&b可熔炼&r材料，无需单独的熔炉。"
		""
		"通过自动熔炼升级，将自动化更进一步。它能自动处理熔炼过程，包括输入原料、使用燃料和存储成品，使&b大规模&r熔炼变得简单高效。"
	]
	quest.4E7437052378DF33.quest_subtitle: "将你的储物箱变成一个自动化熔炉"
	quest.4E7437052378DF33.title: "冶炼 & 自动冶炼升级"
	quest.4E7B79C12957DA08.quest_subtitle: "真美味！"
	quest.4E9A266A0679029F.quest_desc: ["&6获取&r一个来自Create的物品出料口。在Create 6.0中添加的物品出料口，提供了一种将物品快速存入相连存储设备（如物品存储库）的便捷方式。对于大型&b自动化&r存储系统，它&b尤其&r有用。"]
	quest.4E9A266A0679029F.quest_subtitle: "打开通往你储物空间的传送门"
	quest.4EAE91C552A83A04.quest_desc: ["&d增加&r射击时的&b后坐力&r，将玩家推离瞄准点。创造模式玩家可用它来移动。"]
	quest.4EAE91C552A83A04.quest_subtitle: "被吹了回去"
	quest.4EB976A42496C971.quest_desc: [
		"Terminite Hammer 是一种由 Terminite 锭锻造的重型&a工具&r和武器，既可在铁砧上使用，也可在战斗中用于强力击退。"
		""
		"Terminite 是通过在 &bEnd Stone Smeltery&r 中用 End Dust 熔炼 Thallasium Ingot 制成的。"
	]
	quest.4EB976A42496C971.quest_subtitle: "重型工具和武器，经过精炼"
	quest.4EE25A746729E0D2.quest_desc: ["&d子弹盒&r能将大量子弹储存在单个物品中，这样你就不用担心物品栏杂乱，就能携带充足的&b弹药&r。查看其工具提示，了解其容量。"]
	quest.4EE25A746729E0D2.quest_subtitle: "携带更多弹药"
	quest.4EECF73BD3E5F9F4.quest_desc: ["&d提高&r你枪械的&b开火速度&r，这样你就可以更频繁地扣动扳机。"]
	quest.4EECF73BD3E5F9F4.quest_subtitle: "更快的反应速度"
	quest.4F01E4637FF19336.quest_desc: [
		"Glacite 盾是永恒星光中的一个&a防御性&r物品，使用&bGlacite&r材料制作而成。"
		""
		"它比原版盾牌&a更耐用&r，在寒冷生物群系中，霜冻效果&b很常见&r，能提供更好的生存能力。"
	]
	quest.4F01E4637FF19336.quest_subtitle: "霜冻防御盾牌"
	quest.4F1FD5D36701CD85.quest_subtitle: "真美味！"
	quest.4F3C4F623E85F5BC.quest_desc: [
		"&dTwilight&r Gale is a powerful crystalline spear infused with Lightning magic in Iron's Spells 'n Spellbooks. It has &b13&r Attack Damage and &b1.4&r Attack Speed and comes imbued with Volt Strike &bV&r."
		""
		"暮色之风可以像三叉戟一样投掷。投掷不会消耗武器，但会使其进入&b10秒&r的冷却时间。它还可以附魔剑类附魔、忠诚和引雷。"
	]
	quest.4F3C4F623E85F5BC.quest_subtitle: "在晶化长矛中释放内心的风暴"
	quest.4F475C30FD8E2E6F.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.4F7D8B325F91CE45.quest_desc: ["从Cataclysm模组中&a获取&r紫晶蟹壳。这个&b稀有&r的贝壳是从被击败的紫晶蟹身上获得的战利品，蕴含着晶兽的力量和紫晶巢的&b威力&r。"]
	quest.4F7D8B325F91CE45.quest_subtitle: "由水晶与怒火锻造而成的外壳"
	quest.4F9326EC48083D49.quest_desc: ["&a绿宝石&r能为你的装备带来稀有度和声望。与下界合金结合，能打造出在&b强度&r和&b独特性&r上都脱颖而出的盔甲。"]
	quest.4F9326EC48083D49.quest_subtitle: "价值和力量"
	quest.4F9326EC48083D49.title: "绿宝石下界合金护腿"
	quest.4FA02401C47E388C.quest_desc: ["&6可变电&r压器：通过动能输入改变&b电压&r比，从而平滑地升降电压。"]
	quest.4FA02401C47E388C.quest_subtitle: "一个可变的变压器"
	quest.4FB9D03981206026.quest_desc: [
		"&e有些&r &b冒险家&r信赖武器，而另一些则信赖运气。"
		""
		"戴上迷信帽，击杀实体时可获得额外的&b等级&r的抢夺效果，从而更&b容易&r地从敌人身上获得有价值的掉落物。"
		""
		"也许是运气。也许是&b这顶帽子&r。不管怎样，都别把它摘下来。"
	]
	quest.4FB9D03981206026.quest_subtitle: "一点迷信总没有坏处"
	quest.4FBCF48A80687440.quest_desc: ["使用Aquaculture 2制作&aNeptunium头盔&r。这款强大的头盔由Neptunium制成，这是一种通过钓鱼宝藏获得的稀有&b材料&r。它能提供强大的&b防护&r，并且是Neptunium盔甲套装的&b一部分&r。"]
	quest.4FBCF48A80687440.quest_subtitle: "用海洋宝藏锻造的盔甲"
	quest.4FBDDAEB4BB98D95.quest_desc: ["&6一种&r NPN 双极型晶体管，用于电路中信号的开关和放大&b&r。"]
	quest.4FBDDAEB4BB98D95.quest_subtitle: "一个NPN晶体管"
	quest.4FC6D49180163005.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.4FC749FD84D5C02E.quest_desc: ["制作一个&a避雷针&r。这个方块将保护你的&b建筑&r免受雷击。"]
	quest.4FC749FD84D5C02E.quest_subtitle: "驾驭风暴的力量"
	quest.4FC749FD84D5C02E.title: "捕捉闪电"
	quest.4FDE0D84FB894A08.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.4FF6113C0C5AB301.quest_desc: ["&6打印机&r是Create: Enchantment Industry中的一个机器，可以让你&b自动&r复制已写成的书、附魔书、命名牌、列车时刻表和其他支持的物品。它使用&b相应的&r空白物品作为打印材料，复制附魔书时可以&b使用&r液态经验。它还可以复制Create物流的&b包裹&r模式或包裹地址。"]
	quest.4FF6113C0C5AB301.quest_subtitle: "复制你最珍贵的创造物"
	quest.5009B335115B7D24.quest_desc: ["&6Prepare&r a delicious Strawberry Milkshake and add a refreshing &bfruit-based&r drink to your factory's production line. Mix the required &bingredients&r and enjoy a sweet new creation from Create: Dreams n' Desires."]
	quest.5009B335115B7D24.quest_subtitle: "经典玩法的果味新变化"
	quest.5040AEF744A85F14.quest_desc: ["&6酿造&r霞多丽，一款适合你&b自动化&r酿酒厂的优质白葡萄酒。使用酒窖处理所需原料，将收获的葡萄酿成你&b白葡萄酒&r收藏的又一款佳酿。酿酒厂模组添加了葡萄酒主题配方、葡萄加工系统，以及一个可完全自动化的酒窖。"]
	quest.5040AEF744A85F14.quest_subtitle: "来自葡萄园的经典佳酿，口感清爽"
	quest.5044B5A42DC32D14.quest_desc: ["&6The&r Grapplin Whisk is a grappling tool that lets you hook onto blocks and pull &byourself&r toward them. Aim at a block and right-click to launch the hook, then right-click again to release it. It has a &bmaximum&r range of about &b75&r blocks and uses fuel while the hook is attached. It can be especially useful for quickly climbing structures, crossing gaps and moving through the world. The item also supports the Impact enchantment, which can deal &bdamage&r when colliding with entities at &bhigh&r speed."]
	quest.5044B5A42DC32D14.quest_subtitle: "挥舞着武器，横扫整个世界"
	quest.504A757586C3B1F5.quest_subtitle: "真美味！"
	quest.509BE69A1FDD93BB.quest_desc: ["&6The&r Brass Helmet is part of the Brass Suit added by Create Stuff 'N Additions. It is crafted from &b5&r Brass Ingots and has &b275&r durability, providing a more &badvanced&r armor option made from Create's brass."]
	quest.509BE69A1FDD93BB.quest_subtitle: "值得黄铜的庇护"
	quest.50B0B99B8C384EE9.quest_desc: [
		"从《Cataclysm Spellbooks》中获取&a&r虚空法杖，这是一把与通关&a《Ruined Citadel》&r后解锁的虚空主题内容相关的武器。"
		""
		"它将虚空核心的能量转化为强大的远程&b攻击&r。"
	]
	quest.50B0B99B8C384EE9.quest_subtitle: "一把纯粹的虚空能量武器"
	quest.50B0B99B8C384EE9.title: "&d虚空法杖"
	quest.50B1F5510C37DC14.quest_desc: ["&6Craft&r the Brass Gearbox and Vertical Brass Gearbox to gain precise control over rotational direction. Each shaft connection can be &bconfigured&r independently, letting you create compact and flexible kinetic networks. The Vertical Brass Gearbox provides the same &bfunctionality&r in a vertical arrangement."]
	quest.50B1F5510C37DC14.quest_subtitle: "掌控每一个连接，尽在你的掌握之中"
	quest.50B1F5510C37DC14.title: "黄铜齿轮箱"
	quest.50CEF0918E92F0E6.quest_subtitle: "真美味！"
	quest.50E77BBBABDD9FDF.title: "精神层面"
	quest.510EA403E0E37E35.quest_desc: [
		"铁制装备不错，但它无法永远保护你。"
		"是时候升级你的防护，制作一套完整的&a钻石盔甲&r了。"
		""
		"钻石是主世界最坚固的材料之一，能让你抵御更强的敌人和危险的冒险。穿上这套盔甲，你将准备好迎接更艰难的战斗和更深入的&b探索&r。"
	]
	quest.510EA403E0E37E35.quest_subtitle: "真正的保护（True Protection）"
	quest.510EA403E0E37E35.title: "&b钻石盔甲"
	quest.51100C3A9844C57E.quest_desc: ["从Cataclysm模组中&a获取&r珊瑚巴迪奇。这把强大的&b武器&r由深海怪&b&r掉落，以其重击和&b独特&r的设计而闻名。击败深海怪以收集这把稀有的海洋武器。"]
	quest.51100C3A9844C57E.quest_subtitle: "深海中的重型武器"
	quest.511627AE87E19763.quest_desc: [
		"&dPrismatic&r Knight Boots are p&bart&r of the Prismatic Knight Armor set, the strongest armor set in Crystal Chronicles."
		""
		"它们使用来自 Iron’s Spells ’n Spellbooks 的神圣灵魂碎片&b制作&r，可以通过升级任何增强型 Crystal Chronicles 盔甲套装的靴子来&b获得&r。这使得 Prismatic Knight 套装成为 Crystal Chronicles 盔甲进阶的终极&b形态&r。"
	]
	quest.511627AE87E19763.quest_subtitle: "由水晶编年史的力量锻造而成的终极靴子"
	quest.5118194319F816DC.quest_subtitle: "更多盔甲 (More Armor)"
	quest.511F8FFA4608FC67.quest_desc: ["&6Turn&r a simple chocolate bar into a bite-sized treat. Inject 250 mB of Chocolate into a Caramel Bar, White Chocolate Bar or Dark Chocolate Bar &bto&r create Chocolate Candy. Each candy restores &b8&r hunger and &b11&r saturation."]
	quest.511F8FFA4608FC67.quest_subtitle: "经典的巧克力甜点，小巧而美味。"
	quest.512380A29094424E.quest_desc: ["&d火抗戒指&r能让你完全免疫火焰，&b保护&r你免受世界上最危险的元素之一。 &b装备&r它，即可毫无畏惧地穿行于火焰、岩浆和其他火源之中。"]
	quest.512380A29094424E.quest_subtitle: "获得对火焰的免疫效果"
	quest.5128F112C21A18E6.quest_desc: ["&6用于连接设备端子的基本&r电线。电流仅在电路形成完整&b回路&r时流动。每根电线都有电阻：越长，&b电压&r降越大，损耗的电能会转化为热量。电流过大可能导致电线过热并断裂。"]
	quest.5128F112C21A18E6.quest_subtitle: "每个电路的基础组成部分"
	quest.512D2E05632955B4.quest_desc: ["&6Create&r the Gingerbread Man in Create: Confectionery and bring a little &bholiday&r magic to your factory. The mod &badds&r Gingerdough, Gingerbread, and the Gingerbread Man, with later versions also fixing and improving the little Gingerbread Man. It can even &bbecome&r a train conductor in Create builds."]
	quest.512D2E05632955B4.quest_subtitle: "让你的姜饼人活起来"
	quest.5134FF2EFACD3AD7.quest_desc: ["&6Craft&r the Blaze Balloon Cannon, a &bnew&r way to deploy the tiny Blaze Balloon. The cannon launches Blaze Balloons, which can attack &bnearby&r mobs and disappear after defeating their target. It was introduced as &bpart&r of the Blaze Balloon rework in Create: Misc \\& Things 4.0."]
	quest.5134FF2EFACD3AD7.quest_subtitle: "把一只小烈焰人送上天空"
	quest.51386C52D32866DB.quest_desc: ["&6可变电阻器：&r通过动能输入改变其&b电阻&r。在自励发电机中，它能帮助你控制输出的&b电压&r。"]
	quest.51386C52D32866DB.quest_subtitle: "一个可变电阻器"
	quest.514CB6EB132BFD32.quest_desc: [
		"使用融入了暮色森林古老魔法的铁木锭来&a制作&r铁木镐。这把附魔镐专为寻找稀有资源的&b探险者&r设计，具有出色的耐久度和挖掘效率，是深入洞穴、遗迹和地下结构进行&b远征&r的宝贵伙伴。"
		""
		"&aAs&r part of the Ironwood equipment set, it marks another &bstep&r forward in your adventure, allowing you to gather the materials &bneeded&r for even greater challenges."
	]
	quest.514CB6EB132BFD32.quest_subtitle: "发掘森林中隐藏的宝藏"
	quest.5168034C6C8B8360.quest_desc: ["&d降低&r你枪械的镜头&b后坐力&r，让你更容易在两次射击间保持瞄准。"]
	quest.5168034C6C8B8360.quest_subtitle: "驯服后坐力"
	quest.51CDB37B1C51C2A7.quest_desc: [
		"&dCryomancer&r Leggings 是 Iron's Spells 'n Spellbooks 中 Cryomancer Armor 套装的一部分。穿戴后可提供 &b+6&r 护甲、&b+125&r 最大法力、&b+10%&r 冰系法术强度和 &b+5%&r 法术强度。"
		""
		"它们可以用 7 个奥术布和 1 个冰符文制作，或用 1 个冰符文和 1 个奥术精华从巫师护腿&b升级&r而成。"
	]
	quest.51CDB37B1C51C2A7.quest_subtitle: "将冰魔法的冻结之力灌注到你的盔甲中"
	quest.51EB17B61F3779A7.quest_desc: [
		"&aThe&r Starlit Diamond Helmet is a high-tier armor piece from Eternal Starlight crafted us&bing&r Starlit Diamonds."
		""
		"星光钻石盔甲提供的&a防护&r堪比下界合金盔甲，同时具有更高的&b盔甲&r韧性和击退抗性。"
	]
	quest.51EB17B61F3779A7.quest_subtitle: "天体钻石头饰"
	quest.51F2B327C73BD224.quest_desc: ["&6一个&r能同时&b切换&r两条路径的中继器。"]
	quest.51F2B327C73BD224.quest_subtitle: "一个双极继电器"
	quest.5204FCC2B0AA7609.quest_desc: ["&6像&r三极管一样，带有一个额外的屏极栅格（G2）以获得更高的增益。先&b给&r灯丝供电；管子要导通，屏极必须正向偏置。"]
	quest.5204FCC2B0AA7609.quest_subtitle: "一个五极管放大器"
	quest.520FCAEED121844D.quest_subtitle: "升级+"
	quest.5210EC97FDA6152E.quest_subtitle: "更多盔甲 (More Armor)"
	quest.52410E0106CF5307.quest_subtitle: "升级+"
	quest.5245F1F3ED39769B.quest_subtitle: "真美味！"
	quest.52572710E4A97D40.quest_desc: [
		"&dBlood&r Vial 是 Iron's Spells 'n Spellbooks 中的血液焦点，&b用于&r酿造血液法术。要获得它，请在熔炉下放一个点燃的篝火，然后将生物放入熔炉。生物会被烤熟，&b熔炉&r会充满血液，之后可以用玻璃瓶收集。"
		""
		"血瓶也用于制作与&b血液相关的&r魔法物品，包括血符文和古代法典。"
	]
	quest.52572710E4A97D40.quest_subtitle: "收割血魔法的精髓"
	quest.52636AD2E262B7A3.quest_desc: [
		"使用由九头蛇的炽热精华锻造的火焰锭来&a制作&r火焰靴。这双附魔靴蕴含着&b永不停歇&r的火焰沼泽之热，每一步都承载着&b传奇&r巨兽的精神。"
		""
		"&aAs&r the final piece of the Fiery Armor set, they &bcomplete&r one of the most powerful armor collections in the Twilight Forest. Forged in dragonfire and tempered by magic, they are a symbol of your triumph over the &bHydra&r and your readiness for the even greater dangers that await."
	]
	quest.52636AD2E262B7A3.quest_subtitle: "毫无畏惧地穿行于火焰之中"
	quest.5279778C7AE12A98.quest_desc: [
		"&e死亡&r并不总是意味着终结。"
		""
		"合唱图腾能保护你免受致命一击，会把你&b传送&r到别处，而不是&b让你&r死去。图腾激活后会消耗掉，所以遇到危险时一定要带上一个。"
		""
		"&b当&r死亡降临，就让紫颂将你带走。"
	]
	quest.5279778C7AE12A98.quest_subtitle: "在终点给予的第二次机会"
	quest.527F8F06FBAE607C.quest_desc: [
		"&9&l通过从外部物品栏提取物品来扩展&r&r你的 Refined Storage &b网络&r。Importer 会自动从已连接的容器中提取物品，并将其直接发送到你的数字存储系统中。"
		""
		"将其连接到箱子、桶或其他&b兼容&r的容器中，剩下的交给网络处理。"
	]
	quest.527F8F06FBAE607C.quest_subtitle: "将物品带入你的数字存储网络中"
	quest.528388990A969214.quest_desc: ["&6烈焰斧&r是Create Stuff 'N Additions模组中烈焰工具套装的一部分。它有450点耐久度，并且&b在砍伐木材时会自动&r将原木熔炼成木炭。它还会点燃&b被攻击的&r生物。该斧头造成8.5点攻击伤害，攻速为1.0。"]
	quest.528388990A969214.quest_subtitle: "将木材转化为燃料"
	quest.52904ED7A755A219.quest_desc: ["&6Craft&r the Redstone Link Wildcard and &bgive&r your Redstone Links a flexible new way to match frequencies. Assign the Wildcard to a frequency slot and it will match any item in that slot, including air, &ballowing&r one link to interact with a much wider &brange&r of frequencies. It was added to Create: Connected 1.1.0."]
	quest.52904ED7A755A219.quest_subtitle: "匹配任意频率"
	quest.529B0F155E680058.quest_desc: ["&6Build&r the Windchest Controller to control the &bairflow&r of your pipe organ. It works alongside the Windchest and is part of the &bsystem&r used to manage the organ's wind supply. In Create: Sound of Steam, Windchest Controllers can be placed similarly to fans, with their direction reversible &busing&r Shift while placing."]
	quest.529B0F155E680058.quest_subtitle: "控制管风琴的气流方向"
	quest.529D4F0288578416.quest_desc: [
		"&a这&r是你迈向充满冒险与挑战的世界的&b第一&r步。"
		"本任务将向你介绍基础知识，助你开启旅程，探索更多机制。"
		"慢慢来——一步一步地学习所有事情！"
	]
	quest.529D4F0288578416.quest_subtitle: "请先阅读此内容！"
	quest.529D4F0288578416.title: "&l欢迎"
	quest.52AA4866B4D21370.quest_desc: [
		"&dPriest&r Mask is the headpiece of the Priest Armor set in Iron's Spells 'n Spellbooks. When worn, it provides &b+3&r Armor, &b+125&r Max Mana, &b+10%&r Holy Spell Power and &b+5%&r Spell Power."
		""
		"使用升级配方，可以用1个神圣符文、1个巫师头盔和1个奥术精华来&b制作&r。"
	]
	quest.52AA4866B4D21370.quest_subtitle: "引导神圣魔法的神圣力量"
	quest.52CE94EE7C18F40D.quest_desc: ["&dUpgrade&r your Iron’s Spells ’n Spellbooks armor with special shards, discover powerful weapons, and reach the ultimate Prismatic Knight Armor. &bUse&r Divine Soulshard to create it and Ring of Diffraction + R to &bchange&r your magic type."]
	quest.52CE94EE7C18F40D.quest_subtitle: "开启你的终极魔法升级系统之旅"
	quest.52CE94EE7C18F40D.title: "&l&d水晶&b编年史"
	quest.52CFCFB5A591BB4B.quest_subtitle: "真美味！"
	quest.52D5B5205520E523.quest_desc: [
		"你&a穿越&r了永恒星光中的众多区域，直面其中的生物，收集资源，并揭开了它的秘密。"
		"从茂密的森林到水晶沙漠，你的&b旅程&r证明了你能在这个陌生的世界生存和适应。"
		""
		"这并非关于单个任务——而是关于你完成的&a一切&r。"
	]
	quest.52D5B5205520E523.quest_subtitle: "掌握未知的一切，成为真正的强者"
	quest.52D5B5205520E523.title: "星光探险家"
	quest.52DCB270B1BE149F.quest_subtitle: "真美味！"
	quest.52E27F23DFB8AE00.quest_desc: [
		"&dVenomous&r Crusader Helmet is the Crystal Chronicles upgraded version of Plagued Mask from Iron’s Spells ’n Spellbooks."
		""
		"使用Floralite Shard进行&b升级&r，将原本的Plagued Armor转化为强大的Venomous Crusader Armor套装。Floralite Shard为头盔注入了自然魔法的&b力量&r，增强了其毒性和&b瘟疫相关的&r能力。"
	]
	quest.52E27F23DFB8AE00.quest_subtitle: "由Floralite强化的瘟疫面具的增强形态"
	quest.52E342A348772EC8.quest_desc: [
		"&d秘银&r锭是 Iron's Spells 'n Spellbooks 中的一种稀有合成材料。它由秘银废料合成，&b用于&r制作强大的秘银&b装备&r和武器。"
		""
		"秘银是该模组中最有价值的材料之一，是后期&b魔法&r进阶的重要&b部分&r。"
	]
	quest.52E342A348772EC8.quest_subtitle: "用精炼秘银锻造传奇装备"
	quest.52FD0758E3C79ADA.title: "认真的吗？"
	quest.530A8C2E8DE698A5.quest_subtitle: "更多盔甲 (More Armor)"
	quest.530BFD8610704834.quest_desc: ["&dCreatures&r 被连续击中后会&b连锁&r在一起，彼此保持靠近。"]
	quest.530BFD8610704834.quest_subtitle: "将你的目标链接起来"
	quest.534FBA8BC6F117F0.quest_subtitle: "升级+"
	quest.5368EF5D6BBE0FE8.quest_desc: ["&e是时候&r升级你的武器库了！瞄准镜十字弓是一种&b机械&r十字弓，配有望远镜，可以更准确地瞄准。它的箭比&b普通&r十字弓射出的箭&b更快&r、更远。充分利用它的优势，从安全距离攻击敌人吧！"]
	quest.5368EF5D6BBE0FE8.quest_subtitle: "远程精准射击"
	quest.5379AFF2231F2779.quest_subtitle: "更多盔甲 (More Armor)"
	quest.5379F8CE6C8EE40C.quest_desc: ["从 Create 获取&6铜制潜水靴&r。它们是 Create 潜水装备的一部分，专为&b水下&r移动而设计。穿戴后，你会在液体中下沉得更快，无法正常游泳，但可以在水下行走和跳跃。它们还能让你&b免疫&r机械带，这在操作移动装置时非常&b有用&r。"]
	quest.5379F8CE6C8EE40C.quest_subtitle: "在波涛之下行走"
	quest.53809B8ED22A6C98.quest_subtitle: "更多盔甲 (More Armor)"
	quest.53849ECADC1162F5.quest_desc: [
		"&d冰&r符文是 Iron's Spells 'n Spellbooks 的配方材料，用于高级的与&b冰&r相关的配方，包括冰升级球。冰系使用冰冻骨作为魔法焦点。"
		""
		"将1个空白符文石与8个冰冻骨骼结合，可制作出冰符文石。符文石是通过将空白符文石与所选元素的8个焦点&b融合&r制成的。"
	]
	quest.53849ECADC1162F5.quest_subtitle: "用冰魔法的冻结之力注入一块符文石"
	quest.5396A806C9436D51.quest_desc: ["&6Prepare&r a Glowberry Milkshake and bring the &bluminous&r taste of Glow Berries into your factory. This glowing variation adds a unique touch to your &bcollection&r of milkshake recipes from Create: Dreams n' Desires."]
	quest.5396A806C9436D51.quest_subtitle: "经典甜点的发光新花样"
	quest.5399D19A4428F46C.quest_desc: [
		"&eCooked&r to perfection — and somehow impossible to finish. Eternal Steak restores your hunger without being consumed, letting you &benjoy&r the same steak again and again."
		""
		"不过&b有个小&r问题：吃完后，你得等15秒才能再吃一口。"
	]
	quest.5399D19A4428F46C.quest_subtitle: "永不结束的盛宴"
	quest.53BE5E8D3A303F75.quest_desc: ["&6A&r 电池、土豆电池和电容器所需的锌板。用锌锭和创造机制作。"]
	quest.53BE5E8D3A303F75.quest_subtitle: "一块锌板"
	quest.53C6333891CDEC6E.quest_desc: [
		"&bTake&r your first photograph using the Camera and store it on a &aFilm Roll&r."
		"照片可以使用Interplanar Projector进行冲洗和展示。"
	]
	quest.53C6333891CDEC6E.quest_subtitle: "捕捉一个瞬间"
	quest.53D7FCF5FF4DF4E8.quest_desc: ["&6砂纸&r是Create中简单却重要的加工工具。用它处理玫瑰石英等物品，将其抛光成抛光玫瑰石英。将砂纸和物品分别握在双手，然后&b右键&r即可抛光。该&b过程&r也可通过部署器自动化，使砂纸成为实现Create更高级组件&b自动化&r的重要一步。"]
	quest.53D7FCF5FF4DF4E8.quest_subtitle: "用你的方式，打磨至尽善尽美"
	quest.53D7FCF5FF4DF4E8.title: "任何砂纸（Any Sand Paper）"
	quest.53EC04826E16C35D.quest_desc: ["&6The&r Golden Mixer is a kinetic machine added by the Create: Dreams n' Desires feature set. It is a specialized mixer used for processing recipes and is crafted &busing&r a Golden Whisk. The Golden Mixer &bexpands&r your factory's mixing capabilities with new &bprocessing&r possibilities."]
	quest.53EC04826E16C35D.quest_subtitle: "用黄金般的精准度进行混合"
	quest.53F7BC75BF59E4F0.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.540AE69BCE928B52.quest_desc: [
		"&a制作&r寒冰弓，一把注入了冰川古老魔法的武器。从其&b附魔&r弦射出的每支箭都携带着永恒冬季的冰冷&b精髓&r，在敌人接近你之前使其减速并变得&b脆弱&r。"
		""
		"&a备受&r技艺精湛的猎人和&b极地探险家&r青睐的冰弓，能让您在战场上掌控全局。 &b无论&r面对敏捷的怪物还是强大的首领，其冰箭都能让您的敌人陷入冰川的怀抱。"
	]
	quest.540AE69BCE928B52.quest_subtitle: "用冬日的力量从远处发起攻击"
	quest.5410D37C4B979F14.quest_desc: ["&a击败&r来自Cataclysm模组的Coralssus。这个强大的&b海洋&r首领是一种栖息于水下环境的巨型珊瑚&b生物&r。 &b准备好&r迎接一场艰难的战斗，战胜这位深海守护者。"]
	quest.5410D37C4B979F14.quest_subtitle: "击败珊瑚深处的守护者"
	quest.5410D37C4B979F14.title: "击杀珊瑚巨兽 Coralssus"
	quest.54150A1175E277C9.quest_desc: [
		"塔拉西乌姆砧需要配合锻造锤，将塔拉西乌姆锭锻造成&a锻造板&r和工具头。"
		""
		"这是 Better End 的 &b装备&r进阶系统中的首个合成台。"
	]
	quest.54150A1175E277C9.quest_subtitle: "加工第一阶段的金属制品"
	quest.5442F0731BF3AFE2.quest_desc: [
		"&6将&r你的机车工业设计更进一步。铁包裹机车金属结合了机车金属的粗犷外观与&b铁包裹&r的结构，是坚固机车车身和精细铁路建造的绝佳选择。"
		""
		"把它添加到你的火车上，&b赋予&r你的机车更重、更具机械感的外观。"
	]
	quest.5442F0731BF3AFE2.quest_subtitle: "工业级的强度，包裹在铁质外壳中。"
	quest.544E42DF89627778.quest_desc: [
		"Chipped &badds&r 多种用于制作装饰性方块和工作台的特殊工具。"
		"收集这些工具，解锁更多创意建筑选项。"
	]
	quest.544E42DF89627778.quest_subtitle: "用于装饰的工具"
	quest.544E42DF89627778.title: "Chipped Tools"
	quest.5461386AA6C16AD2.quest_desc: ["&6节日彩灯铜凳&r是一款将铜凳与节日灯光结合的&b装饰性&r物品。用它为您的工厂、工作室或生活区增添一些&b独特的&r个性和氛围。"]
	quest.5461386AA6C16AD2.quest_subtitle: "为你的工厂增添一些节日气氛"
	quest.54718DF7D28E91FA.quest_desc: ["&dRemoves&r &bunderwater&r drag, so your bullets fly straight and far even when submerged."]
	quest.54718DF7D28E91FA.quest_subtitle: "穿透水面进行射击"
	quest.5472CD376AC38047.quest_desc: [
		"制作一个&a刷子&r，开始粉刷和装饰你的方块。"
		"用画笔，你可以在创作中添加图案、颜色和个性化元素。"
	]
	quest.5472CD376AC38047.quest_subtitle: "用时尚的方式装饰你的家"
	quest.5472CD376AC38047.title: "刷子艺术"
	quest.5473370385EF24F5.quest_desc: [
		"&a制作&r传奇的Neptunium Fillet Knife，每位大师级垂钓者的终极工具。 &b锻造&r自海洋中&b隐藏的&r神话金属，这把非凡的刀刃兼具无与伦比的耐用性和锋利的精准度，是迄今最出色的鱼片刀。"
		""
		"&a唯有&r那些&b发掘过&r海洋中最稀有宝藏的人才配使用如此杰作。有了海王星鱼排刀，每种渔获都能以无与伦比的效率处理，证明你已真正&b掌握&r了钓鱼的艺术。"
	]
	quest.5473370385EF24F5.quest_subtitle: "由海洋的宝藏锻造而成"
	quest.54760CB8A31B3C8F.quest_desc: ["&6获取&r Crushed Magma，来自 Create: Misc \& Things 的实用燃料。它可以用作熔炉燃料，并且&b足够&r强大，每块能冶炼 12 个物品。"]
	quest.54760CB8A31B3C8F.quest_subtitle: "将岩浆转化为强大的燃料"
	quest.549C88615E62EA0F.quest_desc: [
		"&a探索&r彩绘山脉，这片富含&b紫晶&r和弗拉沃石矿脉的多彩山脉。"
		""
		"其引人注目的多彩石头，使其成为收集 Better End 的 &bportal&r 仪式所需材料的关键生物群系。"
	]
	quest.549C88615E62EA0F.quest_subtitle: "色彩缤纷的岩石山峰"
	quest.549C88615E62EA0F.title: "彩绘山脉"
	quest.54D2447B98F2DCD6.quest_desc: ["制作黄金盾牌，更有效地抵御攻击，在战斗中闪耀光芒。"]
	quest.54D2447B98F2DCD6.quest_subtitle: "用黄金盾牌来升级你的防御力吧！"
	quest.54D8F46882E36BA9.quest_desc: [
		"&aCraft&r a Golden Fishing Rod, a refined tool &bworthy&r of the most dedicated anglers. Though forged from gold, this elegant rod is designed for those who seek rare catches and hidden treasures &brather&r than ordinary fish."
		""
		"&a无论是在&r宁静的&b河流&r还是浩瀚的海洋中垂钓，黄金鱼竿都象征着经验和财富。有时，最丰厚的&b回报&r属于那些愿意使用顶级装备垂钓的人。"
	]
	quest.54D8F46882E36BA9.quest_subtitle: "时尚与财富中的鱼儿"
	quest.54E982A07A5CCEDF.quest_desc: [
		"&dCryomancer&r 胸甲是 Crystal Chronicles 对 Iron's Spells 'n Spellbooks 中 Cryomancer Robe 的升级版。"
		""
		"使用 Cryolite Shard 进行 &b升级&r，为原有的 Cryomancer Armor 套装增强了额外的结晶之力。Cryolite Shard 用冰魔法的 &b力量&r 强化了胸甲，&b创造&r了原版 Cryomancer 装备的改进版。"
	]
	quest.54E982A07A5CCEDF.quest_subtitle: "由 Cryolite 强化的 Cryomancer Robe 增强版"
	quest.54EA9D964A72868A.quest_desc: ["&6获取&r一个来自Create的蒸汽机。它将锅炉的蒸汽转化为旋转动力，为大型Create工厂提供最&b强大&r的压力单位（SU）来源之一。蒸汽机由流体储罐锅炉驱动，锅炉由烈焰燃烧器等&b热源&r加热，&b更强的&r热量和更大的锅炉能让发动机产生更多动力。"]
	quest.54EA9D964A72868A.quest_subtitle: "驾驭蒸汽的力量，释放无尽潜能"
	quest.54EE13A5502CC9C1.quest_desc: ["&d提高&r子弹的&b伤害&r和&b速度&r，但枪的后坐力会更大，&b后坐力&r更明显。"]
	quest.54EE13A5502CC9C1.quest_subtitle: "更多爆炸声"
	quest.5507A99644F53A2C.quest_desc: ["&bOpen&r the &aStarcatcher&r guide to understand how to catch fish, find rare species, and use special bait. Follow the instructions to become a &bskilled&r fisher!"]
	quest.5507A99644F53A2C.quest_subtitle: "学习钓鱼的基础知识"
	quest.55813BE1B345A5B2.quest_desc: [
		"Thallasium 剑是 Better End 的入门级刃类武器，在锻造台用 Thallasium 工具头和剑柄组装而成。"
		""
		"这标志着该模组&a武器&r进阶的开始。"
	]
	quest.55813BE1B345A5B2.quest_subtitle: "第一阶的刀刃"
	quest.5583D946C8B6DE46.quest_desc: [
		"&d传送护符&r在释放&b传送法术&r后提供3秒的闪避效果。传送不仅能让你重新定位，&b还能&r短暂躲避来袭的攻击，在战斗中占据优势。"
		""
		"&b佩戴&r护身符，让每次传送都成为强大的防御性动作。"
	]
	quest.5583D946C8B6DE46.quest_subtitle: "将每一次传送都变成一次闪避的机会"
	quest.558992CA0C2BFFEF.quest_subtitle: "更多盔甲 (More Armor)"
	quest.558A08F7B05E46AC.quest_desc: [
		"&e世界&r会铭记最伟大的战士。"
		""
		"在遗忘的王国、&b覆灭&r的帝国和遥远的文明中，战士们曾站在早已化为尘埃的旗帜下。他们的&b武器&r或许已失，&b王国&r被遗忘，但他们的盔甲幸存了下来。"
		""
		"如今，那些古老遗产的碎片已经落入你的手中。"
		""
		"从古代军队的&b纪律严明&r的战士，到传奇冠军和神秘守护者，每一套都承载着逝去时代的印记。"
		""
		"这些不仅仅是&b普通&r的盔甲套装。"
		""
		"它们是历史的遗留物。"
	]
	quest.558A08F7B05E46AC.quest_subtitle: "穿戴先人留下的传奇遗产"
	quest.558A08F7B05E46AC.title: "&f&l欢迎来到&cArmor Of The Ages"
	quest.55ABA8290A19DBBF.quest_desc: ["&dA&r special orb that enhances &bHydro-related&r abilities and equipment."]
	quest.55ABA8290A19DBBF.quest_subtitle: "一个能增强水之力量的球体"
	quest.55C1255DEAEC2181.quest_desc: ["&e来自Simply Swords的&r特殊物品，放置在背包中一段时间后，会随机变成一件&b独特的&r武器。"]
	quest.55C1255DEAEC2181.quest_subtitle: "被末地之力转化的神秘残骸"
	quest.55C719DE189DDA9D.quest_desc: [
		"&dThe&r Scroll Forge is a magical crafting station in Iron's Spells 'n Spellbooks used to create spell scrolls. Combine Paper, Ink and a Focus to &bcreate&r a scroll from the chosen school of magic. The &btype&r of Ink determines the rarity and starting level of the spell."
		""
		"&bUse&r the Scroll Forge to expand your collection of spells and prepare powerful magic for your Spell Book."
	]
	quest.55C719DE189DDA9D.quest_subtitle: "用墨水、纸张和魔法焦点锻造魔法卷轴"
	quest.55C84DF3A8FE57AE.quest_desc: ["&6Obtain&r a Brass Tunnel and a Brass Funnel from Create. Both are &badvanced&r item-logistics components used for filtering and routing items through automated factories. Brass Funnels can filter specific items and control the &bamount&r transferred, while Brass Tunnels can split or merge item flows &bbetween&r multiple Mechanical Belts."]
	quest.55C84DF3A8FE57AE.quest_subtitle: "掌握你工厂的运作流程"
	quest.55C84DF3A8FE57AE.title: "黄铜隧道 \& 黄铜漏斗"
	quest.55CEDA5DBCD41E9B.quest_desc: ["&a击败&r来自Cataclysm模组的4名Ignited Berserkers。这些&b凶猛&r的战士在Burning Arena中巡逻，以&b坚定不移&r的忠诚效忠于Ignis。战胜他们残酷的攻击，证明你有资格&b挑战&r火焰之主。"]
	quest.55CEDA5DBCD41E9B.quest_subtitle: "打破竞技场冠军的愤怒"
	quest.55CEDA5DBCD41E9B.title: "被点燃的狂战士"
	quest.55D18D15D658ECC0.quest_desc: [
		"&a马拉里特铲子&r是永恒星光中早期的&b挖掘&r工具，使用沼泽群系的马拉里特制作而成。"
		""
		"&a它&r属于基础进阶阶段，用于&b挖掘&r和清理地形。"
	]
	quest.55D18D15D658ECC0.quest_subtitle: "沼泽挖掘工具"
	quest.55D6BD8708A61BAD.quest_desc: ["&6赋予&r你的铁路建筑坚固的工业外观，使用 Flat Riveted Locometal。其平坦的金属表面和成排的铆钉 &b使其&r非常适合机车车身、车厢和大型铁路结构。"]
	quest.55D6BD8708A61BAD.quest_subtitle: "铆接钢般坚固的洁净表面。"
	quest.55D9819EA5D790BA.quest_desc: ["The Starlit Diamond Shovel is a &alate-game&r utility tool from Eternal Starlight crafted from Starlit Diamond materials. It is &bused&r for efficient excavation in advanced biomes and represents the highest tier of digging tools before celestial-endgame &bprogression&r."]
	quest.55D9819EA5D790BA.quest_subtitle: "中后期使用的天体挖掘工具"
	quest.55E4477DF09C4D63.quest_desc: [
		"&9&l将&r&r精炼存储系统&b&r的远程部分与网络接收器连接。它能接收网络发射器发出的网络连接，使连接的设备能从不同位置与主网络&b&r通信。</c8></c6></c5></c4></c3></c2></c1>"
		""
		"&bUse&r it alongside a Network Transmitter to expand your network and connect &bdistant&r storage and automation systems."
	]
	quest.55E4477DF09C4D63.quest_subtitle: "连接你存储网络的遥远部分"
	quest.55E719F937AAA6C3.quest_desc: ["在最高级别的&a进阶&r中，这些护腿能提供卓越的耐久度和&b防护&r。它们能经受住你最艰难的战斗考验。"]
	quest.55E719F937AAA6C3.quest_subtitle: "高峰防御"
	quest.55E719F937AAA6C3.title: "钻石下界合金护腿"
	quest.55E87AAB65B4CBBA.quest_desc: [
		"&dElectromancer&r Leggings are part of the Electromancer Armor set in Iron's Spells 'n Spellbooks. When worn, they provide &b+6&r Armor, &b+125&r Max Mana, &b+10%&r Lightning Spell Power and &b+5%&r Spell Power."
		""
		"它们可以用 7 个 Arcane Cloth 和 1 个 Lightning Rune 来&b制作&r，或者用 1 个 Lightning Rune 和 1 个 Arcane Essence 从 Wizard Leggings 升级而来。"
	]
	quest.55E87AAB65B4CBBA.quest_subtitle: "将闪电魔法的毁灭性力量灌注到你的盔甲中"
	quest.55E9411DDD764F4D.quest_desc: ["用机械压榨机&6处理&r苹果以生产苹果汁。它是 Create: Winery 添加的果汁之一，可用于该模组的&b酿酒&r和苹果酒生产过程。苹果汁在通过 Create 传送带&b运输&r时也会更新为直立状态。"]
	quest.55E9411DDD764F4D.quest_subtitle: "刚从苹果中压榨出来的汁液"
	quest.55F7405278F872FF.quest_desc: ["&d背信者&r的印章可授予&b+10%&r的邪典法术强度。其被动能力有&b5秒&r的冷却时间，并根据生物的最大法力值造成额外伤害，使其对强大的施法者和法力丰富的敌人&b尤为&r致命。"]
	quest.55F7405278F872FF.quest_subtitle: "惩罚那些使用法力的人吧"
	quest.5609B808A0001BBE.quest_desc: ["&6赋予&r甜浆果丝滑的升级。向甜浆果注入 250 mB 白巧克力，即可制作出这款美味。每份可恢复 &b7&r 饥饿值和 &b11.2&r 饱食度，同时&b赋予&r“休息”效果，持续 &b30&r 秒。"]
	quest.5609B808A0001BBE.quest_subtitle: "裹着丝滑奶油白巧克力的香甜浆果。"
	quest.560D1E175323518F.quest_desc: ["&a获得 5 个&r 雕刻南瓜。雕刻南瓜可以用剪刀在南瓜上使用来&b制作&r。它们可用于制作杰克灯、建造雪傀儡和铁傀儡，或作为头盔佩戴，以防止末影人在被注视时&b变得&r具有攻击性。"]
	quest.560D1E175323518F.quest_subtitle: "为冬季做好准备"
	quest.560D1E175323518F.title: "&6雕刻过的南瓜"
	quest.561582D2F38075E1.quest_subtitle: "真美味！"
	quest.5627C108FDC37930.quest_desc: ["&a获取&r一个铜锭。铜是制作前期&b工具&r、&b机器&r和&b组件&r的必需材料。"]
	quest.5627C108FDC37930.quest_subtitle: "铜的基础知识"
	quest.5627C108FDC37930.title: "铜矿收集器"
	quest.56591D1CEECED2B2.quest_desc: [
		"&aThe&r Thermal Springstone Boots are protective footwear from Eternal Starlight crafted &busing&r Thermal Springstone Ingots."
		""
		"&aAs&r part of the Thermal Springstone armor set, they ignite attacking enemies and help reduce incoming fire damage, making them effective in &bdangerous&r hot environments."
	]
	quest.56591D1CEECED2B2.quest_subtitle: "防火耐热的鞋子"
	quest.565F5F43CBF7E726.quest_desc: ["&d一种&r稀有的合成材料，&b用于&rHazen N Stuff 中各种强力&b装备&r的配方。"]
	quest.565F5F43CBF7E726.quest_subtitle: "用于高级制作的稀有宇宙材料"
	quest.56609D8BB013442F.quest_desc: ["&6酿造&r波尔多葡萄酒，灵感源自著名的波尔多产区。在《创造：酿酒厂》中，它可被呈现为酿酒厂通过&b自动化&r加工和熟成系统生产的优质葡萄酒。波尔多以其悠久的酿酒传统和由不同葡萄品种&b混酿&r而成的佳酿而闻名。"]
	quest.56609D8BB013442F.quest_subtitle: "源自法国葡萄园的经典混合风味"
	quest.5669378A6EF63D6D.quest_desc: ["&dThe&r Six-Shooter is a revolver built for &brapid&r fire. Fan the hammer to unload shots in quick succession; firing 15 shots in one second earns the Fan the Hammer advancement."]
	quest.5669378A6EF63D6D.quest_subtitle: "挥舞锤子，煽起风来"
	quest.566E61618FCA03C5.title: "不，我拒绝接受这个任务，我拒绝接受这个任务，我拒绝接受这个任务！"
	quest.5672EEEB49F6A473.quest_desc: [
		"传送魔杖是一件与永恒星光&a相关&r的实用物品，允许使用者在该维度内操控移动或位置。"
		""
		"其&a确切&r的制造&b方法&r或获取来源在现有公共资源中并无明确&b记载&r，可能取决于&bJEI&r配方、进度解锁或整合包特定的配置。"
	]
	quest.5672EEEB49F6A473.quest_subtitle: "空间弯曲的遗迹物品"
	quest.5672EEEB49F6A473.title: "&6 传送魔杖"
	quest.567423E20434C791.quest_desc: [
		"&6专为天空与海洋而造&r，竹制滑翔机是一款配备浮筒的三座飞机，可安全在水面着陆。 &b与大多数飞机不同，&r它在水面着陆时不会下沉。"
		""
		"带上它翱翔，安全降落在波涛上，&b探索&r其他飞行器无法企及的地方。"
	]
	quest.567423E20434C791.quest_subtitle: "一架在水上如鱼得水的坚固飞行器。"
	quest.567559DC006F369A.quest_desc: ["&6欢迎来到&r创造工艺与附加！此附加包为创造模式增添了电气&b系统&r和新型机器，让你能利用旋转动力之外的&b电力&r来生成、储存和使用能量。请先学习&b电力&r的基础知识，再逐步将其接入你的工厂。"]
	quest.567559DC006F369A.quest_subtitle: "为你的工厂接入电力"
	quest.567559DC006F369A.title: "&l&6创建工艺与附加内容"
	quest.56767209670F77B3.quest_desc: ["&d黑火药转轮手枪&r是一种用黑火药驱动的转轮手枪。填充它的&b修饰器&r槽位，根据你的战斗方式对其进行专精。"]
	quest.56767209670F77B3.quest_subtitle: "老派的火力支援"
	quest.5685C252794B4F3F.quest_desc: [
		"&dWandering&r Magician Pants 是 Iron's Spells 'n Spellbooks 中基础 Wandering Magician Armor 套装的一部分。它们提供 &b+5&r 护甲和 &b+25&r 最大法力值。"
		""
		"将皮革裤子与奥术精华结合即可制作。它们是前期获取额外&b法力&r的绝佳&b前期&r护甲部件，同时还能保持不错的防护能力。"
	]
	quest.5685C252794B4F3F.quest_subtitle: "承载一位流浪法师的神秘力量"
	quest.56867D4FD824C102.quest_desc: [
		"&9&lThe&r&r Grid is your main interface for &binteracting&r with the Refined Storage network. Use it to view, search for and &bmanage&r every item stored within your connected storage system from one convenient location."
		""
		"将其连接到你的网络，告别在无数箱子中&b搜寻&r的日子。你&b需要&r的一切，现在只需轻轻点击即可获取。"
	]
	quest.56867D4FD824C102.quest_subtitle: "访问你的整个数字存储网络"
	quest.568C6E2957D5C6D0.quest_desc: ["&6Build&r the Basic Motor, Advanced Motor, and Reinforced Motor to unlock the different &btiers&r of electric-powered rotation in Create: New Age. &bStart&r with a basic motor and work your way up to the &breinforced&r tier for more demanding machinery."]
	quest.568C6E2957D5C6D0.quest_subtitle: "将电能转化为动能"
	quest.568C6E2957D5C6D0.title: "引擎推进系统"
	quest.5691EF52308A9056.quest_desc: [
		"酿造一瓶&a抗火药水&r，保护自己免受岩浆和火焰的伤害。"
		"这瓶药水对于安全地&b探索&r下界至关重要。"
	]
	quest.5691EF52308A9056.quest_subtitle: "在火焰中生存下来"
	quest.5691EF52308A9056.title: "火焰抗性药水"
	quest.5692EB467C095DA0.quest_desc: [
		"&dEnergized&r Core 是 Iron's Spells 'n Spellbooks 中的一个合成材料，&b用于&r制作 Rod o' Lightning。它由 1 个铜块和 8 个闪电瓶合成。"
		""
		"在雷暴期间，将充能核心用于放置的避雷针上，释放强力闪电，并将避雷针&b转化&r为闪电之杖。"
	]
	quest.5692EB467C095DA0.quest_subtitle: "驾驭闪电的力量，释放无尽潜能"
	quest.569C0FB870AE4CD3.quest_desc: ["&6欢迎来到&r Create: Misc & Things！本模组包含了一系列实用有趣的扩展，它们不属于单一主题。建造火车&b站&r扬声器、交通标志、卡片系统、粘性发射器、霓虹管、Spout Gun、便携式哨子等等。探索这些额外的工具和装置，寻找扩展&b你&r的 Create 工厂的新方法。"]
	quest.569C0FB870AE4CD3.quest_subtitle: "实用、有趣又意想不到的新增内容"
	quest.569C0FB870AE4CD3.title: "&l&6欢迎来到创造与杂项模组包"
	quest.56A4A9B3950792E1.quest_desc: [
		"&a获取&r手柄附魔锻造模板，用于在锻造台将成品的 Better End 工具头与手柄组合。"
		""
		"这是组装 &bThallasium&r 和 &bTerminite&r 等级工具和武器所需的步骤。"
	]
	quest.56A4A9B3950792E1.quest_subtitle: "将手柄安装到头部上"
	quest.56A94C1721F0E1FE.quest_desc: ["&6Craft&r the Posaune pipe and &badd&r a deep, powerful reed voice to your pipe organ. Posaune is one of the &boriginal&r organ stops in Create: Sound of Steam and received a full 5-octave range in version 0.8.0."]
	quest.56A94C1721F0E1FE.quest_subtitle: "添加一个强大的黄铜嗓音"
	quest.56AEBAFE684B4F56.quest_desc: [
		"Amaramber 锄头是永恒星光中于 0.4.2 版本推出的&a农具&r，属于&bAmaramber&r装备系列。"
		""
		"&a它&r被&b用&r来准备农田，是星光维度早期发展的组成部分。"
	]
	quest.56AEBAFE684B4F56.quest_subtitle: "琥珀色农场工具"
	quest.56DDD6F89F2F8C3C.quest_subtitle: "更多盔甲 (More Armor)"
	quest.56F1D6936CE849A0.quest_desc: ["&6Fill&r a Caramel Bar, Chocolate Bar or Dark Chocolate Bar with 250 mB of White Chocolate to create this creamy treat. Each candy &brestores&r 8 hunger and 11 saturation, while the white chocolate grants the Rest effect for 30 seconds."]
	quest.56F1D6936CE849A0.quest_subtitle: "一种填满了顺滑白巧克力的美味小点心。"
	quest.56F5E38FDD172F6E.quest_desc: [
		"&dElectromancer&r Leggings are the Crystal Chronicles upgraded version of the Electromancer Leggings from Iron’s Spells ’n Spellbooks."
		""
		"使用伏特碎片进行升级，它能&b增强&r原始电磁魔导师套装，赋予其&b额外的&r晶体力量。伏特碎片引导着闪电魔法的力量，创造出更强大的原始电磁魔导师装备版本。"
	]
	quest.56F5E38FDD172F6E.quest_subtitle: "由伏特矿石强化的电磁法师护腿增强版"
	quest.56F65FC29596EE7B.quest_desc: [
		"&a获取&r琥珀宝石，可在更好的末地中制作或找到，最常见的是在琥珀之地采集&a琥珀矿石&r。"
		""
		"其主要用途在于&b灌注仪式&r，不过它也可以用来制作末影之眼和装饰性琥珀块。"
	]
	quest.56F65FC29596EE7B.quest_subtitle: "用于仪式的宝石一枚"
	quest.56F6AC7979412477.quest_subtitle: "真美味！"
	quest.56FD0D6D5CC0687D.quest_desc: ["&e来自Simply Swords的&r神秘物品，能变成独特武器。其&b变形&r取决于条件和方块，是获取强力&b稀有&r武器的宝贵途径。"]
	quest.56FD0D6D5CC0687D.quest_subtitle: "蕴含着独特武器力量的神秘残骸"
	quest.571C4996415BE05B.quest_desc: ["&aEcho's&r Grace 是一件强大的物品，与远古堡垒中古代&b居民&r的遗产息息相关。获取它的力量，在穿越古人遗迹的旅途中再&b进一步&r。"]
	quest.571C4996415BE05B.quest_subtitle: "陨落者之遗产"
	quest.57333A2DDBD5C1F0.quest_subtitle: "更多盔甲 (More Armor)"
	quest.573AC6B4F6A39CD2.quest_desc: ["&d武器&r部件是 Iron's Spells 'n Spellbooks 中一种&b稀有&r的配方材料。它们由 3 个秘银锭和 2 个奥术锭合成，用于制作像咒术破击者和紫水晶刺剑这类&b强力&r的魔法武器。"]
	quest.573AC6B4F6A39CD2.quest_subtitle: "锻造强大魔法武器的组件"
	quest.57424654EF8928B0.quest_desc: [
		"晶化腿甲是通过灌注仪式制作的——将泰拉腿甲、琥珀宝石和晶化碎片放置在&a灌注基座&r周围。"
		""
		"穿戴它们除了坚固盔甲和韧性外，还能额外获得 2 点&b最大生命值&r。"
	]
	quest.57424654EF8928B0.quest_subtitle: "由灌注而生的护腿装备"
	quest.57424654EF8928B0.title: "&d晶化护腿"
	quest.57490E7B7125796F.quest_desc: ["&6Craft&r a Redstone Magnet by combining magnetite with Redstone. This stronger magnetic component is an important &bstep&r in the progression of Create: New Age, paving the way toward more &badvanced&r magnetic and electrical technology."]
	quest.57490E7B7125796F.quest_subtitle: "给你的磁铁充上电吧"
	quest.574BDD4179393D11.quest_desc: ["使用Aquaculture 2制作&aNeptunium剑&r。这把强大的武器由Neptunium制成，这是一种通过钓鱼宝藏获得的稀有&b材料&r。它是Neptunium&b装备&r套装中耐用且强大的&b武器&r。"]
	quest.574BDD4179393D11.quest_subtitle: "由海洋宝藏锻造而成的刀刃"
	quest.5767713EB40F707E.quest_subtitle: "升级+"
	quest.578EB7E4CF7E3785.quest_desc: ["用Create的机器&6处理&r葡萄以酿造葡萄汁，这是酿酒的关键原料。在酒窖中，用它作为基底，结合Create: Winery&b添加&r的其他原料来&b酿造&r葡萄酒。"]
	quest.578EB7E4CF7E3785.quest_subtitle: "新鲜压榨，随时可以发酵"
	quest.578FF9E18EF476F4.quest_subtitle: "更多盔甲 (More Armor)"
	quest.57A5F443FB751E17.quest_subtitle: "更多盔甲 (More Armor)"
	quest.57AE51A8BFF87D10.quest_desc: [
		"塔拉西姆头盔需要在锻造台用塔拉西姆板合成。"
		""
		"这是 Better End 的 &a盔甲&r进阶的起点，提供的保护比铁更多。"
	]
	quest.57AE51A8BFF87D10.quest_subtitle: "第一阶的头盔装备"
	quest.57BFB10B88DC5500.quest_desc: [
		"&a末影之眼&r由末影珍珠和烈焰粉合成。"
		"投掷后，它会漂浮在空中，引导你前往要塞——包含末地传送门的隐藏结构。"
		"它是抵达末地维度、直面&b末影龙&r的关键物品。"
	]
	quest.57BFB10B88DC5500.quest_subtitle: "堡垒指南（假的 XD）"
	quest.57BFB10B88DC5500.title: "末影之眼"
	quest.57C7FEC533FD8170.quest_desc: ["&6Craft&r the Subbass pipe and add a deep, &bpowerful&r bass voice to your pipe organ. Subbass is one of the original pipe types in Create: Sound of Steam and is a &breed&r pipe. In version 0.8, it received the full &b5-octave&r range and is crafted through sequenced assembly."]
	quest.57C7FEC533FD8170.quest_subtitle: "为你的管风琴带来深沉的音色"
	quest.57D98CCC6D30EAFE.quest_desc: [
		"Amaramber 剑是永恒星光中在 0.4.2 版本推出的&a武器&r，与&b其他&r Amaramber 工具一同发布。"
		""
		"Amaramber &a装备&r与星光维度中Torreya &b树木&r采集的火焰效果和材料相关。"
	]
	quest.57D98CCC6D30EAFE.quest_subtitle: "燃烧的琥珀之刃"
	quest.57DE931DE3C664AF.quest_desc: ["从 Create 中获取&6&r下界合金背囊。它是铜制背囊的&b&r升级版，可储存&b&r压缩空气，供潜水头盔、延长柄和土豆炮使用。通过向储罐提供旋转力即可填充。下界合金版本防护更强，并且&b&r能抵抗火焰和熔岩。"]
	quest.57DE931DE3C664AF.quest_subtitle: "随身携带，随时随地都能呼吸的力量"
	quest.57E1677E487D619A.quest_subtitle: "更多盔甲 (More Armor)"
	quest.57FCD72ED4193436.quest_desc: [
		"&dVenomous&r Crusader Leggings are the Crystal Chronicles upgraded version of Plagued Leggings from Iron’s Spells ’n Spellbooks."
		""
		"使用Floralite Shard进行&b升级&r，将原本的Plagued Armor转化为强大的Venomous Crusader Armor套装。Floralite Shard将自然魔法的力量&b注入&r盔甲，增强了其毒性和&b瘟疫相关的&r能力。"
	]
	quest.57FCD72ED4193436.quest_subtitle: "由Floralite强化的瘟疫护腿的增强版"
	quest.58044C7D45BE5862.quest_desc: ["&6变压器的&r底座，你可以在上面建造绕组。"]
	quest.58044C7D45BE5862.quest_subtitle: "变压器核心"
	quest.5805A83D3AF0EE1E.quest_desc: [
		"&e黑暗&r不再可怕。这副护目镜&b赋予&r佩戴者夜视能力，让最黑暗的洞穴和隧道也变得易于穿行。"
		""
		"穿上&b它们&r，让黑暗显现出真面目。"
	]
	quest.5805A83D3AF0EE1E.quest_subtitle: "看看黑暗中隐藏着什么秘密"
	quest.58070E79D47823BA.quest_desc: ["&6从Create模组中获取&r一个Spout。它能最多储存1桶流体，并将该流体&b倾泻&r到从其下方&b经过&r的传送带或储料箱上的兼容物品上。这能让你自动化流体相关的合成和填充配方，例如&b制作&r烈焰蛋糕和其他需要填充流体的物品。"]
	quest.58070E79D47823BA.quest_subtitle: "让流体塑造你的创造物"
	quest.580D277648F9D193.quest_desc: ["&aLocate&r a Trial Chamber hidden deep beneath the Overworld. Built &bfrom&r tuff and copper, these ancient &bunderground&r halls are filled with deadly traps, Trial Spawners, Vaults, and powerful enemies awaiting anyone brave enough to enter. A Journeyman Cartographer can sell a Trial &bExplorer&r Map leading to the nearest chamber."]
	quest.580D277648F9D193.quest_subtitle: "寻找被遗忘的战士们的试炼之地"
	quest.580D277648F9D193.title: "试炼密室"
	quest.580E7DE57206B9CC.quest_desc: ["&6The&r Zinc Helmet is part of the Zinc Suit from Create Stuff 'N Additions. It provides an &balternative&r set of armor made from Zinc, giving you another way to turn Create's resources into useful equipment. The helmet has &b220&r durability and is crafted from &b5&r Zinc Ingots."]
	quest.580E7DE57206B9CC.quest_subtitle: "更轻一层的保护方式"
	quest.582F0AA40622C858.quest_desc: ["&aEcho's&r Grace 是阿基翁的关键物品之一，与&b远古&r的遗产相关。获取它并运用其力量，继续穿越远古堡垒的旅程，&b揭开&r&b远古&r文明留下的秘密。"]
	quest.582F0AA40622C858.quest_subtitle: "回响的恩赐"
	quest.582F0AA40622C858.title: "&b回声的恩宠"
	quest.5855A31B7C59BC54.quest_desc: ["&6工业外壳&r是 Create: Dreams n' Desires 模组中坚固的构建组件。专为&b高级&r机械和大型机械系统而设计，为更复杂的工厂建造提供&b所需的&r工业基础。"]
	quest.5855A31B7C59BC54.quest_subtitle: "专为重型机械而设计"
	quest.5855AC82EE35329E.quest_desc: ["&6获取&r一个来自Create的机械泵。它是流体&b物流&r系统的关键组件，利用&b旋转&r动力推动流体通过相连的流体管道。泵可以在管道网络中移动流体，最远可达&b15&r格，之后需要另一个泵。其抽送&b方向&r可用扳手更改。"]
	quest.5855AC82EE35329E.quest_subtitle: "让流体流动起来"
	quest.585E81760D56ED15.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.58707B7EB3185422.quest_subtitle: "升级+"
	quest.5878011164766C2F.quest_desc: [
		"&aUpgrade&r your armor to a full Netherite set using Netherite Ingots and Smithing Templates."
		"这是目前最&a强大&r的盔甲，能极大地&b提高&r你的生存能力。"
	]
	quest.5878011164766C2F.quest_subtitle: "终极保护"
	quest.5878011164766C2F.title: "下界合金套装"
	quest.587A4A7644A43502.quest_desc: ["&6从Create模组中获取&r铜制阀门手柄。这是一种由玩家驱动的旋转力源，能让你精确控制&b旋转&r的角度和方向。默认情况下，每次激活会旋转&b45°，&r并且可以将其旋转角度配置为&b不同的&r角度。它能产生&b32&r RPM和&b256&r SU。"]
	quest.587A4A7644A43502.quest_subtitle: "精确控制旋转角度"
	quest.58850A645FBACBFE.quest_desc: ["&6Suspicious&r Rock 是 Create: Aquatic Ambitions 2.0 新增的水下资源。它与钙质粉末和尖刺贝壳一同构成了模组的新配方和生产链。探索并&b处理&r这种神秘岩石，以&b解锁&r更多海洋主题的进阶内容。"]
	quest.58850A645FBACBFE.quest_subtitle: "古老的秘密就隐藏在内部"
	quest.588AA795568CAA8B.quest_subtitle: "更多盔甲 (More Armor)"
	quest.588BBD3F66AA2081.quest_desc: ["&b使用&r铜锭和紫水晶碎片来制作望远镜。它能让你放大并清楚地看到远处的地方。"]
	quest.588BBD3F66AA2081.quest_subtitle: "制作一个望远镜（Spyglass）"
	quest.588BBD3F66AA2081.title: "望远镜（Spyglass）"
	quest.58CB5865C71C7CE9.quest_desc: [
		"&9&lThe&r&r Machine Casing is a fundamental component used to construct &badvanced&r Refined Storage machines and devices. It forms the framework that brings together the components needed for more complex automation."
		""
		"制作一个，为 Refined Storage 网络的下一阶段&b做好准备&r。"
	]
	quest.58CB5865C71C7CE9.quest_subtitle: "构建高级自动化的基础架构"
	quest.58DEB5354E203161.title: "..."
	quest.58EF3CB34B796886.quest_desc: [
		"&dWandering&r Magician Shoes 是 Iron's Spells 'n Spellbooks 中基础 Wandering Magician Armor 套装的一部分。它们提供 &b+2&r 护甲和 &b+25&r 最大法力值。"
		""
		"将皮革靴与奥术精华结合即可&b制作&r，是前期容易获得的魔法装备。"
	]
	quest.58EF3CB34B796886.quest_subtitle: "开始你作为流浪法师的旅程吧"
	quest.5909CFBF3019F400.quest_desc: ["坚固可靠的&a升级&r，这款胸甲结合了下界合金的耐用性和铁的稳定性。能为长途旅行和危险遭遇提供可靠的&b防护&r。"]
	quest.5909CFBF3019F400.quest_subtitle: "可靠的防御系统"
	quest.5909CFBF3019F400.title: "铁质下界合金胸甲"
	quest.590BB110A333BB00.quest_desc: ["&dIcicle&r Crusher 是《水晶编年史》中一件武器，&b与&r强化后的 Cryomancer 装备相关。它凝聚了冰魔法的力量和 Cryolite 的结晶强度，是用于&b冻结&r和粉碎敌人的强大武器。"]
	quest.590BB110A333BB00.quest_subtitle: "由寒玉的冰冻之力锻造而成的毁灭性武器"
	quest.591378335B70C02C.quest_desc: [
		"用幻影骑士的&b传奇&r遗骸来&a制作&r幻影胸甲。这件曾被守护哥布林堡垒的幽灵冠军穿戴的附魔盔甲，至今仍回荡着那些即使在死后也未曾放弃职责的勇士们的&b坚定不移&r的意志。"
		""
		"&aAs&r the centerpiece of the Phantom Armor set, the chestplate offers outstanding &bprotection&r and symbolizes your victory over one of the Twilight Forest's most demanding encounters. Its ghostly craftsmanship makes it a prized possession for any &bseasoned&r adventurer."
	]
	quest.591378335B70C02C.quest_subtitle: "幽灵冠军们所穿戴的盔甲"
	quest.591E0B9694CC8ACF.quest_desc: ["用机械压榨机处理&6红葡萄&r以获得红葡萄渣。这是 Create: Winery 中使用的副产品之一，也是自动化酿酒流程的&b一部&r分。"]
	quest.591E0B9694CC8ACF.quest_subtitle: "好好利用你压榨过的葡萄吧"
	quest.592697AEA0303633.quest_desc: [
		"在神秘维度的入口处，一位强大的守护者正在值守——&a守门人&r。"
		"此实体保护着&bEternal Starlight&r世界的入口，只有足够强大者才能通过。"
		""
		"击败后，它会掉落一个特殊的&blootbag&r，里面装有激活传送门所需的预言之球等关键物品。"
		""
		"不击败守门人，前方的道路将保持&b封闭&r。"
	]
	quest.592697AEA0303633.quest_subtitle: "道路必须靠努力赢得尊重"
	quest.592697AEA0303633.title: "&b第一步 &9在星光中"
	quest.5941E926825E0C69.quest_desc: [
		"工具的耐久度会限制你维修前的建造时间。"
		"不可破坏模板能让你的建造棒在不损失耐久度的情况下工作。"
		""
		"有了这个升级，你可以建造更久，而不用担心工具会损坏。"
	]
	quest.5941E926825E0C69.quest_subtitle: "永远不会损坏的工具 (Tools That Never Break)"
	quest.59442C166C65590F.title: "不错"
	quest.594BD90AB78AB09B.quest_desc: ["&d赋予&r你的子弹&b追踪&r效果，使其能曲线飞向目标，更容易命中。"]
	quest.594BD90AB78AB09B.quest_subtitle: "能够精准命中目标的子弹"
	quest.5968131D1B6EC6FE.quest_desc: [
		"&dElectromancer&r Hat is the headpiece of the Electromancer Armor set in Iron's Spells 'n Spellbooks. When worn, it provides &b+3&r Armor, &b+125&r Max Mana, &b+10%&r Lightning Spell Power and &b+5%&r Spell Power."
		""
		"在支持此功能的版本中，可通过 5 个 Arcane Cloth 和 1 个 Lightning Rune 在锻造台 &b制作&r，或用 1 个 Lightning Rune 在锻造台升级 Wizard Helmet 获得。"
	]
	quest.5968131D1B6EC6FE.quest_subtitle: "掌握闪电魔法的毁灭性力量"
	quest.59697E8A236AE5E8.quest_desc: ["&6发电机最基本的部分：&r它在定子的磁场中旋转时会产生&b电力&r。你可以通过放置更多转子来扩展装置。"]
	quest.59697E8A236AE5E8.quest_subtitle: "一个旋转的转子"
	quest.5977D9C4172608DA.quest_desc: ["从Cataclysm模组中&a获取&r火焰堡垒。这件&b传奇&r盾牌蕴含着Ignis的力量，&b使其&r持有者能在挥舞下界怒火的同时抵御毁灭性攻击。它是燃烧竞技场锻造的&b最伟大&r的圣物之一。"]
	quest.5977D9C4172608DA.quest_subtitle: "在熊熊烈火前屹立不倒"
	quest.5977D9C4172608DA.title: "&c火焰堡垒 (Bulwark Of The Flame)"
	quest.59A34CCE1A0539F9.quest_desc: ["&aCraft&r the Cursium Mage Breastplate and Winged Mage Breastplate from the Cataclysm: Spellbooks addon. &bInfused&r with the dark power of Cursium, these enchanted robes grant &bexceptional&r magical prowess while embodying the legacy of the cursed rulers who once commanded forbidden sorcery. The Winged Mage Breastplate represents the ultimate evolution of this &blegendary&r attire."]
	quest.59A34CCE1A0539F9.quest_subtitle: "穿上被诅咒的大魔导师的长袍"
	quest.59E8835D4066EC44.quest_desc: [
		"Malarite 是永恒星光中一种在沼泽类生物群系中找到的&a基础&r进阶&b材料&r。"
		""
		"&a它&r用于制作前期工具和武器，构成了该模组&b进阶&r系统的基础。"
	]
	quest.59E8835D4066EC44.quest_subtitle: "沼泽矿石材料"
	quest.59EDE9FFD9AC8195.quest_desc: [
		"使用&b压缩&r升级，&l&9让&r&r你的储物空间更高效。它能自动将&b兼容&r的物品压缩成紧凑形态，减少所需存储空间。"
		""
		"&bPerfect&r for materials that quickly fill your containers, this upgrade keeps your storage organized while making better use of every available slot."
	]
	quest.59EDE9FFD9AC8195.quest_subtitle: "将多余的物品转化为紧凑的存储空间"
	quest.59F46A0A7AF23B02.quest_subtitle: "真美味！"
	quest.59FE206DA8C33112.quest_desc: ["&a获取&r来自Cataclysm模组的珊瑚块。这种&b材料&r由Coralssus掉落，可用于制作与模组海洋&b内容&r相关的物品。"]
	quest.59FE206DA8C33112.quest_subtitle: "珊瑚深处的一块碎片"
	quest.5A0F1E0A29C82609.quest_desc: ["&a此&r锻造模板与回响战锤相关。获取它，以便在后续与回响战锤相关的合成或&b升级&r过程中使用。"]
	quest.5A0F1E0A29C82609.quest_subtitle: "获取回响战锤锻造模板"
	quest.5A216B4751249E91.quest_desc: ["&dPoisonfang&r 是《水晶编年史》中一件武器，与剧毒十字军装备系列相关。它&b引导&r自然魔法的力量和花晶的毒性能量，&b使其&r成为&b使用剧毒魔法者的致命&r选择。"]
	quest.5A216B4751249E91.quest_subtitle: "注入了自然之力的剧毒武器"
	quest.5A408D048C70443B.quest_desc: ["&d你的&r子弹&b会冻结&r目标，并在命中时爆发出冰冻的&b弹片&r。"]
	quest.5A408D048C70443B.quest_subtitle: "冷血动物"
	quest.5A47265BA18F0E83.quest_desc: [
		"&9&l使用安全管理器，保持&r&r你的 Refined Storage 网络安全。它能让你管理网络访问权限，并控制谁能与你的存储系统&b交互&r。"
		""
		"&bSet&r up security cards and permissions to protect your &bvaluable&r resources and keep unwanted users from accessing your network."
	]
	quest.5A47265BA18F0E83.quest_subtitle: "保护你的数字存储网络"
	quest.5A473C2FDB2DD8B3.quest_desc: ["&6Craft&r the Caramel Bucket and Chocolate Bucket to transport liquid ingredients for your confectionery factory. &bUse&r them with Create's fluid systems to move caramel and chocolate between different stages of production. Create: Confectionery &badds&r caramel as well as black, white, and ruby chocolate to Create."]
	quest.5A473C2FDB2DD8B3.quest_subtitle: "储存最甜美的液体"
	quest.5A473C2FDB2DD8B3.title: "焦糖桶 \& 巧克力桶"
	quest.5A5A487004ECA799.quest_subtitle: "真美味！"
	quest.5A5B60BA157A17C8.quest_subtitle: "升级+"
	quest.5A5C3C67CC12A21C.quest_subtitle: "升级+"
	quest.5A7F96B24A411ECB.quest_desc: ["&d一件&r特殊的&b配饰&r，能为佩戴者提供和谐的法力。"]
	quest.5A7F96B24A411ECB.quest_subtitle: "一个带来平衡与和谐的吊坠"
	quest.5A82A4E0A825BEFB.quest_desc: ["&d使&r子弹&b在方块上&r反弹，这样你就能绕过拐角击中敌人。用反弹射击杀死生物可获得“台球杆”成就。"]
	quest.5A82A4E0A825BEFB.quest_subtitle: "反弹射击"
	quest.5A9C3BC0BE9975E4.quest_subtitle: "更多盔甲 (More Armor)"
	quest.5AA26BFC94370303.quest_desc: ["用纸张包裹的六块&6白巧克力棒&r可以合成一个完整的白巧克力棒。最多可享用16次，是一款&b方便&r又美味的零食。每口还能提供休息效果。"]
	quest.5AA26BFC94370303.quest_subtitle: "一块适合多口享用的丝滑白巧克力棒。"
	quest.5AA62330741CAD92.quest_desc: [
		"Terminite 胸甲需要在锻造台用 Terminite 板甲合成。"
		""
		"它是后期升级为&bCrystalite&r或&bAeternium&r盔甲的基础。"
	]
	quest.5AA62330741CAD92.quest_subtitle: "第二等级的胸甲"
	quest.5AA7A876F9E5EB5D.quest_desc: ["&aCraft&r the Dragon Bones Boots from the Bosses' Rise mod. &bForged&r from the bones of ancient dragons, these &blegendary&r boots provide exceptional protection and complete the Dragon Bones Armor set. They &bcarry&r the resilience of the creatures that once ruled the skies."]
	quest.5AA7A876F9E5EB5D.quest_subtitle: "与远古巨兽的力量同行，踏上征程"
	quest.5AACD9C11C399A36.quest_desc: ["&6碳堆的&r底座：在其上方放置煤炭块即可组装碳堆。"]
	quest.5AACD9C11C399A36.quest_subtitle: "堆栈的线圈"
	quest.5AB7DAC0DEF2D1BE.quest_desc: ["&6导管笼&r是Create: Aquatic Ambitions中的一个高级方块，提供了一种更紧凑的导管引导设置方式。它还可以&b施加&r或移除附近玩家和生物的效果，&b具体&r取决于所使用的流体或效果。在新版本中，它支持&b更多&r流体，如岩浆、蜂蜜和巧克力。"]
	quest.5AB7DAC0DEF2D1BE.quest_subtitle: "掌控 Conduit 的力量"
	quest.5AC37ACA354D5843.quest_desc: ["&6铜靴&r是Create Stuff 'N Additions铜制套装的一部分。它们提供&b2&r点护甲值和1点护甲韧性，防护力与铁靴相同，但耐久度更高。耐久度为&b195&r，可用蜂巢在铁砧上&b修复&r。靴子由&b4&r个铜锭制作而成。"]
	quest.5AC37ACA354D5843.quest_subtitle: "保护好你的双脚，免受伤害"
	quest.5ACD097A25B0C50D.quest_desc: [
		"&a下界疣&r是下界堡垒中发现的一种重要资源。"
		"它是酿造大多数药水的关键原料，包括初级药水。没有它，就无法进行高级炼金术。"
		"小心采集，带回基地开始你的酿造&b进度&r。"
	]
	quest.5ACD097A25B0C50D.quest_subtitle: "炼金术的基础知识"
	quest.5ACD097A25B0C50D.title: "&c下界疣"
	quest.5ADBF1BE660F348B.quest_desc: [
		"&aThe&r Glacite Chestplate is a cold-resistant armor piece from Eternal Starlight crafted &busing&r Glacite materials."
		""
		"冰川盔甲能减缓受冰冻效果影响的&a敌人&r的攻击速度，并提升在严寒环境中的&b生存能力&r。"
	]
	quest.5ADBF1BE660F348B.quest_subtitle: "冰冻的盔甲套装"
	quest.5AE2EC9A70E5A140.quest_desc: [
		"&a获取&r Plate Upgrade Smithing Template，在 Smithing Table 上将其用于将 &bForged Plate&r 制成一件成品的 Better End 盔甲。"
		""
		"每件 Thallasium、Terminite 和 Aeternium 盔甲都必须经过这个 &b步骤&r 才能穿戴。"
	]
	quest.5AE2EC9A70E5A140.quest_subtitle: "将铁板锻造成盔甲"
	quest.5AEA1A3CFBEA20D4.quest_subtitle: "更多盔甲 (More Armor)"
	quest.5AFA9C63C5BFCE24.quest_subtitle: "更多盔甲 (More Armor)"
	quest.5B05B9AC26B26B50.quest_desc: [
		"使用遍布暮色森林的&b附魔&r钢叶材料来&a制作&r钢叶靴。这双靴子凝聚了森林的古老魔法，能提供可靠的防护，同时足够&b轻便&r，适合穿越茂密森林、高耸山丘和废弃遗迹的长途旅行。"
		""
		"&aAs&r the final piece of the Steeleaf Armor set, they &bcomplete&r a dependable armor collection that will accompany you through the early &bstages&r of your Twilight Forest adventure."
	]
	quest.5B05B9AC26B26B50.quest_subtitle: "自信地漫步于森林之中"
	quest.5B19160165B5E883.quest_subtitle: "更多盔甲 (More Armor)"
	quest.5B27717ACCFE4A1C.quest_desc: ["从 Create 中获取&6粉末状黑曜石&r。它是一种特殊材料，用于更&b高级&r的 Create 制作和加工。"]
	quest.5B27717ACCFE4A1C.quest_subtitle: "将黑曜石变成非凡之物"
	quest.5B3BD9C0124BD4F6.quest_desc: ["&6The&r Portable Energy Interface is an electrical component from Create Crafts \\& Additions used to transfer Forge Energy to and from moving Create contraptions. It allows a &bcontraption&r to connect to an &bexternal&r power network when the interfaces meet, making it ideal for electrically &bpowered&r trains and other moving machines."]
	quest.5B3BD9C0124BD4F6.quest_subtitle: "为移动装置提供动力"
	quest.5B3C917C779AC15A.quest_subtitle: "更多盔甲 (More Armor)"
	quest.5B3F6ED494A819BA.quest_subtitle: "更多盔甲 (More Armor)"
	quest.5B4AB17DADF25E18.quest_desc: [
		"&a末影珍珠&r是末影人掉落的神秘物品，末影人是在维度间游荡的生物。"
		"它们用于传送，是抵达要塞并最终到达末地维度所必需的。"
		"小心使用&a&r——使用不当可能会导致&b坠落伤害&r或&b危险情况&r。"
	]
	quest.5B4AB17DADF25E18.quest_subtitle: "虚空侵染的本质"
	quest.5B4AB17DADF25E18.title: "末影珍珠"
	quest.5B6598F86409092E.quest_subtitle: "真美味！"
	quest.5B835BD694026514.quest_desc: ["&6Craft&r the Fan Washing Catalyst and use it with an Encased Fan to &bperform&r bulk washing. It provides the washing &beffect&r without requiring a water source directly in front of the fan, making automated processing setups more compact. Create: Connected added Fan Washing Catalyst as one of its original &bfan-catalyst&r variants."]
	quest.5B835BD694026514.quest_subtitle: "用强劲的气流将其冲洗干净"
	quest.5B87365C08C8CF57.quest_subtitle: "升级+"
	quest.5B8F07E4708A1624.quest_desc: [
		"&9&l借助漏斗升级，将&r&r漏斗功能直接引入你的储物系统。它能让你的储物箱&b自动&r存取物品，方便连接容器和构建自动化&b物品处理&r系统。"
		""
		"高级漏斗&b升级&r能更好地控制物品移动，让你配置物品传输的方向和行为，并实现更&b复杂&r的自动化存储。"
	]
	quest.5B8F07E4708A1624.quest_subtitle: "自动化物品在存储系统中的流动"
	quest.5B8F07E4708A1624.title: "漏斗 \& 高级漏斗升级"
	quest.5BB761680A0E7A17.quest_desc: [
		"&dCryomancer&r Leggings 是 Crystal Chronicles 对 Iron’s Spells ’n Spellbooks 中 Cryomancer Leggings 的&b升级&r版。"
		""
		"使用 Cryolite Shard 进行升级，它能&b增强&r原有的 Cryomancer Armor 套装，赋予其额外的结晶之力。Cryolite Shard 用冰魔法的力量强化装备，&b创造&r出原版 Cryomancer 装备的改进版。"
	]
	quest.5BB761680A0E7A17.quest_subtitle: "一种由 Cryolite 强化的 Cryomancer Leggings 增强版"
	quest.5BD797DA1D2A7A9A.quest_subtitle: "真美味！"
	quest.5BD9D1C1FC98C0BB.quest_subtitle: "更多盔甲 (More Armor)"
	quest.5C00F1DF6D6FECF7.quest_desc: [
		"青金石是附魔装备的&a关键资源&r。收集它来解锁秘密，但要小心——它那深邃的蓝光蕴含着只有懂得如何使用的人才能驾驭的力量。"
		""
		"带些回来，准备好升级你的&b武器&r和&b盔甲&r。"
	]
	quest.5C00F1DF6D6FECF7.quest_subtitle: "魔法的石头"
	quest.5C00F1DF6D6FECF7.title: "青金石发现任务"
	quest.5C04CC8F94D991CC.title: "@#$@$@"
	quest.5C0D6AE03AF04316.quest_desc: [
		"塔拉西镐是一种使用锻造锤和铁砧，由塔拉西锭锻造而成的&a采矿&r工具。"
		""
		"它是 Better End 工具进阶的起点，位于铁之上，&bTerminite&r 和 &bAeternium&r 之下。"
	]
	quest.5C0D6AE03AF04316.quest_subtitle: "第一等级的采矿工具"
	quest.5C0FBC7EA0225092.quest_desc: [
		"&a星焰&r十字弓是永恒星光中后期的一种远程武器，属于星焰&b装备&r系列。"
		""
		"&a它&r专为强大的远程战斗而设计，是模组中&b引入&r的高级武器套装的一部分。"
	]
	quest.5C0FBC7EA0225092.quest_subtitle: "星光远程武器"
	quest.5C11189FA69E30E9.quest_subtitle: "升级+"
	quest.5C191BDEF5446D95.quest_subtitle: "真美味！"
	quest.5C4B89BF93162426.quest_desc: ["&aDefeat&r Clawdian, a powerful mini-boss found within the Acropolis in L_Ender’s Cataclysm. Clawdian is a massive &bcrustacean&r warrior wielding a huge claw and guarding the ancient stronghold. Overcome its powerful attacks and &bclaim&r victory over one of the Acropolis' most dangerous guardians."]
	quest.5C4B89BF93162426.quest_subtitle: "击败卫城（Acropolis）的守护者"
	quest.5C4B89BF93162426.title: "&c克劳迪安"
	quest.5C59481363324F17.quest_desc: [
		"&a以太颂咏斗篷&r是一件来自永恒星光的神秘胸甲，使用&b以太颂咏锭&r制作而成。"
		""
		"&a它&r属于与陨石和星光维度中找到的天体&b材料&r相关的Aethersent进度。"
	]
	quest.5C59481363324F17.quest_subtitle: "天界神秘盔甲"
	quest.5C78815176F253DA.title: "为什么"
	quest.5C859B9C308A2262.quest_desc: ["&a从&rCataclysm模组中获得Infernal Forge。这把传奇武器由强大的Netherite Monstrosity&b掉落&r，同时也是一把不可损坏的Netherite级镐。当持有者&b重伤&r时，通过敲击地面，它能释放出&b毁灭性&r的冲击波，击退敌人、击碎盾牌，并点燃附近的敌人。"]
	quest.5C859B9C308A2262.quest_subtitle: "驾驭下界合金巨兽的怒火"
	quest.5C859B9C308A2262.title: "&c炼狱熔炉 Infernal Forge"
	quest.5C87FE353318F034.quest_desc: [
		"&d火焰&r升级球是 Iron's Spells 'n Spellbooks 中的一种升级材料。在神秘砧上使用时，可提供 &b+5%&r 的火焰法术强度。"
		""
		"它由 1 个空升级球和 8 个火焰符文&b合成&r。适用的物品通常最多可接受 3 次升级。"
	]
	quest.5C87FE353318F034.quest_subtitle: "用火焰魔法的力量来强化你的装备"
	quest.5C92BD84F58E0D9C.quest_desc: ["&d添加了&r &b吸血&r箭：发射时会消耗部分你的&b生命&r，但能造成额外伤害。请谨慎使用。"]
	quest.5C92BD84F58E0D9C.quest_subtitle: "用血来偿还代价"
	quest.5C92BECD1EED0AC4.quest_subtitle: "更多盔甲 (More Armor)"
	quest.5C94947847B0880F.quest_desc: ["&e捕虫网&r能让你捕捉动物并将其转移到&b其他&r地点。它是&b安全&r迁移自然学家世界居民的好工具。"]
	quest.5C94947847B0880F.quest_subtitle: "捕捉一只野生动物"
	quest.5C94947847B0880F.title: "&e捕虫网"
	quest.5C97748C4B702898.quest_desc: [
		"在暮色森林的&a深处&r，坐落着一个庞大的&b地下&r迷宫，栖息着最强大的守护者之一——牛蘑菇。这头融合了强大&b牛头怪&r和巨型蘑菇的可怕生物，已将迷宫中心视为自己的领地，粉碎任何胆敢挑战它的&b冒险者&r。"
		""
		"&a找到&r Minoshroom 并非易事。你必须先&b穿越&r Labyrinth 的蜿蜒走廊，克服致命的陷阱，并存活下来以对抗潜伏其中的&b怪物&r。只有这样，你才能&b赢得&r在竞技场中直面那头野兽的机会。"
		""
		"&aDefeating&r the Minoshroom is a major milestone in your Twilight Forest adventure, rewarding you with &bvaluable&r loot and opening the path toward even greater challenges."
	]
	quest.5C97748C4B702898.quest_subtitle: "征服迷宫的守护者（Conquer the guardian of the Labyrinth）"
	quest.5C97748C4B702898.title: "&cMinoshroom"
	quest.5C99B6FEDC36090D.quest_desc: [
		"&6每&r架飞机都需要可靠的动力来源。锅炉将燃料转化为机器所需的能量，以&b保持&r发动机运转，带你翱翔天际。"
		""
		"建造锅炉，为你的飞行器加油，为起飞&b做好准备&r。"
	]
	quest.5C99B6FEDC36090D.quest_subtitle: "维持飞行器运转的动力源。"
	quest.5CA65A5C75C63568.quest_desc: ["&6欢迎来到&r创造：酿酒坊！&b种植&r红白葡萄，用创造机械处理，酿成红酒、白酒、桃红和苹果酒。建造全自动化的酒窖，探索创造机械系统与酿酒之间的&b新&r配方和&b互动&r。"]
	quest.5CA65A5C75C63568.quest_subtitle: "建造你自己的自动化酿酒厂"
	quest.5CA65A5C75C63568.title: "&l&6欢迎来到创造酿酒坊"
	quest.5CB2580A05B6ED7D.quest_desc: ["&aCraft&r the Cursium Mage Circlet from the Cataclysm: Spellbooks addon. Forged with the power of Cursium, this enchanted circlet is worn by &bmasters&r of dark magic, strengthening their &bspellcasting&r and serving as the centerpiece of the Cursium Mage armor set."]
	quest.5CB2580A05B6ED7D.quest_subtitle: "被诅咒的魔法所浸染的王冠"
	quest.5CB679CBBD78B0E7.quest_desc: ["&6烈焰镐&r是Create Stuff 'N Additions模组中一款火焰工具。它有450点&b耐久度&r和开采黑曜石的挖掘等级，可以开采黑曜石和远古残骸。可熔炼的方块在开采时会&b自动&r熔炼，但这意味着该工具无法受益于时运。它还会点燃被攻击的生物。"]
	quest.5CB679CBBD78B0E7.quest_subtitle: "用下界的炽热来挖掘吧"
	quest.5CBE694E060BB1B9.quest_desc: ["&6The&r Redstone Relay is an electrical component from Create Crafts \\& Additions that allows you to control the flow of electrical energy &busing&r a Redstone signal. It can be integrated into your electrical network to switch power on or off, making it useful for automated factories and &bRedstone-controlled&r machines."]
	quest.5CBE694E060BB1B9.quest_subtitle: "让红石控制你的力量"
	quest.5CD3EBB8D4853429.quest_subtitle: "真美味！"
	quest.5CD948E420CD22EC.quest_desc: [
		"按下 &bH&r – YDM 武器大师"
		"按下 &bZ&r – 执行一次投掷"
		"按下 &bM&r – 打开世界地图"
		"按下 &bO&r – 打开着色器选择菜单"
		"按下 &bB&r – 打开背包                                                             &l配置任意&r&b"
	]
	quest.5CD948E420CD22EC.quest_subtitle: "请先阅读此内容！"
	quest.5CD948E420CD22EC.title: "&b设置控制"
	quest.5CE02F705DF1A5BE.quest_desc: ["&6用于电气小工具的&r集成电路。部署在兼容设备上，可&b增强&r其性能，限使用次数。"]
	quest.5CE02F705DF1A5BE.quest_subtitle: "一个集成电路"
	quest.5CF67B714252B32C.quest_desc: [
		"&6既然可以修建高架铁路，&r何必局限于普通铁路？单轨铁路轨道模组引入了&b一种截然不同的&r铁路网络建造方式，让你能打造出时尚的高架和&b悬挂式&r铁路。"
		""
		"铺设你的&b第一条&r单轨铁路，将铁路带向新的高度。"
	]
	quest.5CF67B714252B32C.quest_subtitle: "一根铁轨。一种全新的旅行方式。"
	quest.5D0FDCEFB5BD7BB5.quest_desc: [
		"永恒锭铲是顶级&a挖掘&r工具，由永恒锭锻造而成，拥有 Better End 工具系列中最高的耐用性。"
		""
		"使用&b永恒砧&r和下界合金或永恒锻造锤来制作。"
	]
	quest.5D0FDCEFB5BD7BB5.quest_subtitle: "最强等级的挖掘工具"
	quest.5D186CD6AAD57073.quest_desc: ["&6The&r Display Board is a scalable information screen for your factory. &bIndividual&r boards can connect together into a display up to 32×32 blocks in size, with each block holding two lines of text. &bPower&r the board with at least &b32&r RPM to display text. You can write text directly using a Clipboard or Name Tag, color it with Dyes, or make it glow with Glow Ink Sacs. For automated information, use a Display Link to show data such as rotation speed, fluid levels, boiler status, item names and other &bmachine&r information. The items used to configure the text are not consumed."]
	quest.5D186CD6AAD57073.quest_subtitle: "把你的工厂展示出来给大家看"
	quest.5D302C6DA0561BF4.quest_subtitle: "更多盔甲 (More Armor)"
	quest.5D49B95246579A3D.quest_desc: ["&b使用材料&r制作星捕者之杖。这是你捕捉鱼类和发现稀有水生&a生物&r的第一步"]
	quest.5D49B95246579A3D.quest_subtitle: "制作你的第一根钓鱼竿"
	quest.5D6BA83890C17CFD.quest_desc: ["&6Craft&r the Sequenced Pulse Generator and take precise control over redstone timing. Program a sequence of instructions that runs &bwhen&r the block receives a redstone signal. It can perform &bsignal-strength&r comparisons, arithmetic and bitwise operations, making it a powerful tool for &badvanced&r automation. A Control Chip is required to craft it."]
	quest.5D6BA83890C17CFD.quest_subtitle: "编写你的红石信号程序"
	quest.5D764CDE02CECDFF.quest_desc: [
		"&9&lTake&r&r your resource production a step further with the Fortune II Upgrade. It provides the second level of Fortune to compatible operations, giving you an even greater &bchance&r of obtaining additional &bresources&r from supported blocks."
		""
		"&b升级&r你的自动化系统，让每次采矿都收获更丰厚。"
	]
	quest.5D764CDE02CECDFF.quest_subtitle: "进一步提高你的资源产出效率"
	quest.5D7E2401CA74F57E.quest_desc: [
		"&d《&rIgnis 魔法书》是 Cataclysm: Spellbooks 中一本强大的火系魔法书。它能提供 &b12&r 个法术位、&b+30%&r 火系法术强度和 &b+300&r 最大法力值，是专注于毁灭性火魔法的法师的绝佳选择。"
		""
		"&b掌控&r Ignis 的火焰，向敌人释放毁灭性的火系法术。"
	]
	quest.5D7E2401CA74F57E.quest_subtitle: "挥舞着毁灭性的火焰 Ignis 的力量"
	quest.5D8F5E6E65FB4E6F.quest_desc: ["&6制作&r木制步道台阶，扩展工厂的高架步道。这些&b台阶&r是 Create: Escalated 木制&b运输&r系统的一部分，为你提供连接工厂不同&b层级&r的实用方法。"]
	quest.5D8F5E6E65FB4E6F.quest_subtitle: "沿着木制路线向上走"
	quest.5D94D2A0B9B33F18.quest_desc: ["&6Craft&r the Prestant pipe and &bexpand&r your pipe organ with a strong, clear principal voice. Prestant is one of the organ stops &badded&r by Create: Sound of Steam in version 0.8.0."]
	quest.5D94D2A0B9B33F18.quest_subtitle: "添加一个强大的主声音轨"
	quest.5D9ECA964DCB5556.quest_desc: ["&6Craft&r the Kinetic Bridge and Kinetic Battery to gain greater control over your kinetic networks. The Kinetic Bridge transfers stress &bcapacity&r between two separate networks while keeping them isolated, protecting the source network if the &bdestination&r becomes overstressed. The Kinetic Battery stores kinetic stress for later use and retains its charge even as an item, &ballowing&r mechanical power to be transported over long distances."]
	quest.5D9ECA964DCB5556.quest_subtitle: "储存和传递机械应力"
	quest.5D9ECA964DCB5556.title: "动能桥梁 & 动能电池"
	quest.5DA5211A9A2240F3.quest_desc: ["&6获取&r来自 Create: Slice & Dice 的 Slicer。它是一种自动化切割机，&b主要&r用于 Farmer's Delight 的配方。它的工作原理与 Create 的 Mechanical Mixer 或 Mechanical Press 类似，并且能&b自动&r注册切割配方，让你可以自动化&b通常&r用 Cutting Board 完成的操作。Slicer &b需要&r将合适的工具，如 Knife 或 Axe，&b插入&r机器中。"]
	quest.5DA5211A9A2240F3.quest_subtitle: "自动化切割的艺术，尽在掌握之中"
	quest.5DD6D72E96F8A5D8.quest_desc: ["从Cataclysm模组中&a获取&r一个Cursium Ingot。这种&b稀有&r的&b材料&r由Maledictus在Frosted Prison中掉落，用于制作强大的Cursium &b装备&r。"]
	quest.5DD6D72E96F8A5D8.quest_subtitle: "来自冰冻监狱的诅咒金属"
	quest.5DDE97F467CF6DB7.quest_subtitle: "更多盔甲 (More Armor)"
	quest.5DE69F2C7802A979.quest_subtitle: "更多盔甲 (More Armor)"
	quest.5DE8F69201253A50.quest_desc: ["下界合金之路&b由此&r开启。将下界合金与铁结合，你&a创造&r出更耐用、更可靠的材质。这只是迈向更强大&b力量&r的第一步。"]
	quest.5DE8F69201253A50.quest_subtitle: "更坚固的基础"
	quest.5DE8F69201253A50.title: "铁质下界合金锭"
	quest.5E16BAD64A4B17E2.quest_desc: ["&6从Create中获取&r一份列车时刻表。它能让你通过&b定义&r目的地、&b行驶&r条件和速度限制来编程自动化列车。时刻表可包含车站目的地、延迟、时间段条件、货物要求、红石链接、玩家数量等。它们还可以被&b配置&r为持续重复运行。"]
	quest.5E16BAD64A4B17E2.quest_subtitle: "让你的铁路进入自动驾驶模式"
	quest.5E1FED1118233908.quest_desc: ["&6万用表&r是用于处理 Create: Dreams n' Desires 所&b添加&r的电气系统的实用工具。用它来检查电气&b元件&r，更好地了解流经&b你工厂机械的&r电力。"]
	quest.5E1FED1118233908.quest_subtitle: "建造前请先测量好尺寸"
	quest.5E22FAB8A62D6461.quest_desc: ["&6制作&rGedeckt管，为你的管风琴增添柔和的、&b类似长笛的&r音色。Gedeckt是Create: Sound of Steam最初的管型之一。在0.8版本中，它的外观也&b被更改&r为表示其为闭管。"]
	quest.5E22FAB8A62D6461.quest_subtitle: "添加温暖的长笛声线"
	quest.5E43E62B2B5C57F4.quest_desc: ["&a从Cataclysm模组中获取&r新手腰带。 &b这条&r简单的腰带为头骨提供了两个额外的Curio插槽，让你可以装备诸如Unbreakable Skull之类的遗物。尽管外观朴素，但它&b标志着&r你迈向&b掌握&r古代遗物之路的开始。"]
	quest.5E43E62B2B5C57F4.quest_subtitle: "迈向更强大遗物的重要一步"
	quest.5E45EBC3E36FDA4C.quest_desc: [
		"&9&l无需绑定主网络，即可&r&r随时关注精炼存储的自动合成任务。无线自动合成监视器让您远程访问正在进行的合成任务，随时查看进度，管理您的&b自动化&r生产流程。"
		""
		"&bConnect&r it to your network and stay in control of your crafting jobs wherever you are."
	]
	quest.5E45EBC3E36FDA4C.quest_subtitle: "随时随地监控你的自动化合成过程"
	quest.5E5745E799BB7B58.quest_subtitle: "更多盔甲 (More Armor)"
	quest.5E5AA188F68E2B6E.quest_desc: ["&6Welcome&r to Create: Mechanical Extruder! Build your &bfirst&r mechanical extruder and discover a new way to automate the &bproduction&r of blocks and items. By combining adjacent blocks and fluids with rotational power, the extruder can generate &buseful&r resources and expand the &bpossibilities&r of your factory."]
	quest.5E5AA188F68E2B6E.quest_subtitle: "用挤出法走向自动化之路"
	quest.5E5AA188F68E2B6E.title: "&l&6欢迎使用创造机械挤出机"
	quest.5E6192DF85596293.quest_desc: [
		"&l&9何&r&r要等到危险来临才喝药水？炼金术升级会在满足设定条件时自动消耗药水、效果食物甚至牛奶 &b当&r满足设定条件时。无论是潜水、冲刺还是受到负面效果，背包都能为你自动反应。"
		""
		"&b高级&r炼金术升级将更进一步，让你能更精确地控制药水持续时间和效果强度。"
	]
	quest.5E6192DF85596293.quest_subtitle: "让你的背包帮你管理药水吧"
	quest.5E6192DF85596293.title: "炼金术与高级炼金术升级"
	quest.5E6408A2CAC0321C.quest_desc: [
		"&aGlacite头盔&r是一种抗寒的盔甲部件，&b源自&rEternal Starlight，使用Glacite材料制作而成。"
		""
		"Glacite 盔甲&a有助于&r抵御冰冻环境，并用&b冰冷&r效果减缓敌人的攻击。"
	]
	quest.5E6408A2CAC0321C.quest_subtitle: "冰冻的防护头盔"
	quest.5E70B9C39D63424E.quest_desc: ["&6The&r Capacitor is an energy-storage component from Create Crafts \\& Additions. It allows you to store Forge Energy &b(FE)&r and &buse&r that stored power when needed, making it useful for &bstabilizing&r and managing your factory's electrical network. In version 1.6.0 for NeoForge 1.21.1, the Capacitor can also be charged directly with FE."]
	quest.5E70B9C39D63424E.quest_subtitle: "储存电能"
	quest.5E798A66A4A73131.quest_desc: ["&d使&r你的子弹更重，提升其&b击退力&r，但会牺牲&b子弹速度&r。"]
	quest.5E798A66A4A73131.quest_subtitle: "更重的炮弹"
	quest.5E87C003DBAC4CB9.quest_desc: [
		"&d虚空行者&r护腿是《铁之咒语与咒语书》中《暗影行者护腿》在《水晶编年史》中的升级版。"
		""
		"使用深渊水晶碎片&b升级&r，将原本的暗影行者盔甲&b转变为&r强大的虚空行者盔甲套装。深渊水晶碎片为护腿注入了深渊的力量，&b增强了&r原装备的黑暗与阴影能力。"
	]
	quest.5E87C003DBAC4CB9.quest_subtitle: "由深渊水晶强化的暗影行者护腿的增强版"
	quest.5E97E01DAF94EF91.quest_subtitle: "更多盔甲 (More Armor)"
	quest.5EA5A8B4E9C589F8.quest_desc: ["&6The&r Electrical Connector is a key component of the power network in Create: New Age. Use it to &bconnect&r electrical machines and transfer power between &bdifferent&r parts of your factory. Build a reliable &belectrical&r network and prepare for more advanced machinery."]
	quest.5EA5A8B4E9C589F8.quest_subtitle: "将你的工厂连接到电网中"
	quest.5EB82AFEBB1E761A.quest_desc: [
		"&l&9Make&r&r better use of your backpack's storage space with the Compacting Upgrade. It automatically compacts compatible items into their block or &bhigher-form&r equivalents and can unpack them again when needed."
		""
		"高级压缩升级能让您更好地控制流程，&b允许&r您&b配置&r要压缩的物品及压缩系统的行为。"
	]
	quest.5EB82AFEBB1E761A.quest_subtitle: "将溢出的储物空间变为紧凑的便利"
	quest.5EB82AFEBB1E761A.title: "压缩与高级压缩升级模块"
	quest.5EBE62F99616E6AF.quest_subtitle: "真美味！"
	quest.5ED9D5ED047D6F17.quest_desc: [
		"制作一个&aInterplanar Projector&r，将捕捉到的图像以&b3D&r形式显示。"
		"该装置能让你以独特的方式投射照片，分享你的发现。"
	]
	quest.5ED9D5ED047D6F17.quest_subtitle: "将你的发现投影出来"
	quest.5EF72A6EE9C86A28.quest_desc: ["使用龙之息和封闭式风扇制作&6终结催化剂&r，并用其与终结配方配合使用。该催化剂提供了一种&b专用的&r、基于&b风扇&r的自动化方式来触发终结过程。"]
	quest.5EF72A6EE9C86A28.quest_subtitle: "用龙之息来结束这个过程"
	quest.5F1BA4438855750D.quest_subtitle: "升级+"
	quest.5F231AF1EB93743D.quest_desc: ["&6Craft&r the Vibration Mechanism, an &badvanced&r component from Create: Misc \\& Things. It is used as a crafting ingredient for specialized items, including the Radar and Brass Speaker. Its recipe is made through &bsequenced&r assembly."]
	quest.5F231AF1EB93743D.quest_subtitle: "将振动转化为技术"
	quest.5F3F334D0E9F1EAC.quest_subtitle: "更多盔甲 (More Armor)"
	quest.5F6AD59476EA9ED3.title: "为什么？..."
	quest.5F8B310E8F347803.quest_desc: [
		"&e你造成的每一&r道伤口，都可能成为生命的源泉。"
		""
		"吸血手套使你的近战攻击有 &b20%&r 的几率，根据你造成的 &b伤害&r 来恢复生命。默认情况下，每次攻击最多可吸收 6 点生命。"
		""
		"&b造成伤害&r。窃取生命。继续战斗。"
	]
	quest.5F8B310E8F347803.quest_subtitle: "让你的敌人来为你的力量充能"
	quest.5F970C6B27659E02.quest_subtitle: "真美味！"
	quest.5FAA5CF98B35F420.quest_subtitle: "真美味！"
	quest.5FC1AFC00CD8479B.quest_desc: [
		"&6当&r你的飞行器需要不止速度，带上火力吧。旋转炮是一种安装在陀螺稳定器上的&b自动&r武器，让你能在飞行中持续倾泻火力。"
		""
		"装上火药，瞄准，然后&b向&r敌人展示谁才是天空之王。"
	]
	quest.5FC1AFC00CD8479B.quest_subtitle: "一款用于控制天空的速射武器。"
	quest.5FC4294BFD859994.quest_desc: [
		"&dProtection&r 升级球是 Iron's Spells 'n Spellbooks 中的一种升级材料。在 Arcane Anvil 上使用时，可提供 &b+5%&r 的魔法抗性。"
		""
		"使用 1 个空升级球和 8 个防护符文来&b制作&r。升级球可用于升级&b兼容&r的装备，默认每件物品最多可升级 3 次。"
	]
	quest.5FC4294BFD859994.quest_subtitle: "Strengthen your defenses against the forces of magic"
	quest.5FFAE598BCB1BF7E.quest_subtitle: "更多盔甲 (More Armor)"
	quest.6008177DE90FE654.quest_desc: [
		"The Thermal Springstone Scythe is a &ahybrid&r weapon-tool from Eternal Starlight crafted &busing&r Thermal Springstone Ingots."
		""
		"&a它&r用于大范围近战攻击和高效采集，同时作为 Springstone 武器套装的一部分，能对敌人施加燃烧&b效果&r。"
	]
	quest.6008177DE90FE654.quest_subtitle: "地热区域武器"
	quest.600F06E22F4352E0.quest_desc: ["&aCraft&r a Black Steel Hoe from the Cataclysm mod. This &bdurable&r tool is made &busing&r Black Steel and is part of the Black Steel equipment set."]
	quest.600F06E22F4352E0.quest_subtitle: "由黑钢锻造而成的农具"
	quest.601D4234CBB94226.quest_desc: [
		"&aCraft&r a Wooden Fillet Knife, a simple yet &bessential&r tool for any aspiring angler. While ordinary tools may catch fish, a fillet knife allows you to properly process your catches, yielding valuable &bresources&r and making the most of every successful fishing trip."
		""
		"&a尽管&r外表朴素，这把木制小刀&b标志&r着你钓鱼之旅的开始。有了它，你就能将捕获的猎物转化为有用的食材和补给，迎接前方的&b冒险&r。"
	]
	quest.601D4234CBB94226.quest_subtitle: "准备好你的第一次捕获吧"
	quest.601FAACE19CA2A4B.quest_desc: [
		"&e一&r次&b危险&r的旅程正等待着你的五只小青蛙。穿过铁轨，躲开矿车，跳过原木，并在回家的路上避开&b龟&r。"
		""
		"你能把五只青蛙都安全地带到对岸吗？&b&r"
	]
	quest.601FAACE19CA2A4B.quest_subtitle: "把五只青蛙都安全地带回家。"
	quest.6027A8C8D707CB89.quest_desc: ["&6便携式存储接口&r允许物品在移动装置和固定存储之间传输。将两个&b接口&r相对放置，中间留出&b1-2&r个&b方块&r的空间，其中一个连接到移动装置，另一个保持固定。连接时，移动装置会短暂停止，其&b物品栏&r即可从固定端访问。使用漏斗、滑道或其他运输组件来放入或取出物品。红石&b信号&r可以立即断开连接。"]
	quest.6027A8C8D707CB89.quest_subtitle: "一个用于放置物品的入口"
	quest.6035DF6B8A51456F.quest_desc: [
		"&aDefeat&r the Ender Guardian, the boss hidden on the Ruined Citadel's lowest floor, awakened by approaching the Altar of Void."
		""
		"残酷的第二阶段会震碎竞技场地板——击败它会奖励你&bGauntlet of Guard&r。"
	]
	quest.6035DF6B8A51456F.quest_subtitle: "堡垒的最后一位守护者"
	quest.6035DF6B8A51456F.title: "&l&d末地守卫者"
	quest.603A83BC4034259F.quest_desc: [
		"&9&l永远&r&r不要让饥饿拖慢你的脚步。喂食升级会在你&b需要&r时自动从储物中提供食物，确保你随时都有现成的食物。"
		""
		"高级喂食升级让你能更好地控制喂食系统，可以&b配置&r食物使用时间和优先顺序。"
	]
	quest.603A83BC4034259F.quest_subtitle: "随时准备好食物，以防饥饿来袭"
	quest.603A83BC4034259F.title: "喂食与高级喂食升级 (Feeding & Advanced Feeding Upgrade)"
	quest.6043D6ED38152913.quest_desc: ["&dClockwork&r 组件是最高级的枪械硬件。它们用于制造 Arquebus 和 Clockwork Rifle，以及像 Mechanical Repeater 和 Suppressor 这样的&b高级&r改装件。"]
	quest.6043D6ED38152913.quest_subtitle: "高级武器的精准度提升"
	quest.6054FC57CE0B4413.quest_desc: [
		"&a离开&r大陆的安全地带，启航驶向浩瀚的海洋。在它无尽的&b波涛&r下，是一个充满宝藏、神秘遗迹、危险生物和等待&b被&r发现的秘密的世界。"
		""
		"&aThe&r Ocean is far more than an endless &bexpanse&r of water. It is home to shipwrecks, underwater caves, coral reefs, and ancient monuments that reward those brave enough to explore its depths. Every voyage across the sea is the beginning of a &bnew&r adventure."
	]
	quest.6054FC57CE0B4413.quest_subtitle: "无尽的大海在等着你"
	quest.6054FC57CE0B4413.title: "&l&9去海洋探险吧"
	quest.6056ED356B65D891.quest_desc: [
		"&d神秘铁砧是 Iron's Spells 'n Spellbooks 中&r最&b强大&r的合成台。用于升级卷轴、改进装备和为武器附魔。是&b后期&r魔法进阶的必备工作站。"
		""
		"&bUse&r Upgrade Orbs to enhance applicable armor and Spell Books, combine scrolls with Ink to increase their level, and imbue &bweapons&r with magical spells."
	]
	quest.6056ED356B65D891.quest_subtitle: "掌握高级魔法强化的艺术"
	quest.605AAF1B7598F6A6.quest_desc: ["&a从Cataclysm模组中获取&r瓶中沙尘暴。这件神秘的&b遗物&r蕴含着&b远古&r沙漠风暴的力量，能让持有者驾驭沙子的威力。它与埋藏在沙漠下的被遗忘文明相关的罕见&b宝藏&r。"]
	quest.605AAF1B7598F6A6.quest_subtitle: "捕捉沙漠之风的狂暴力量"
	quest.60630DEB2B6A5908.quest_desc: ["&6A&r 标准灯泡。将其放入灯座并通电；如果&b电压&r过低，亮度会较低。用染料右键单击可更改其&b光&r色。"]
	quest.60630DEB2B6A5908.quest_subtitle: "一个标准的灯泡"
	quest.607D585BD717F67A.quest_desc: ["&6Craft&r the Steam Whistle and add another &bpowerful&r voice to your mechanical organ. In Create: Sound of Steam, the &bwhistle-based&r pipes are part of the organ system and can be used to expand the range of sounds your instrument can produce. The mod &bspecifically&r includes the Haunted Steam Whistle among its pipe types."]
	quest.607D585BD717F67A.quest_subtitle: "让你的器官用蒸汽发声"
	quest.60834016DDE092EC.quest_desc: [
		"&a以太靴&r是一种源自永恒星光的神秘靴子，使用&b以太锭&r制作而成。"
		""
		"&aThey&r are part of the Aethersent progression connected to meteors and celestial &bmaterials&r found in the Starlight dimension."
	]
	quest.60834016DDE092EC.quest_subtitle: "天体神秘主义者的鞋履"
	quest.60836A242C6AEDB2.quest_desc: ["&6利用&r电力&b移动空气&r。方向和强度取决于所施加的&b电压&r。用它来冷却发热的组件和电路板。"]
	quest.60836A242C6AEDB2.quest_subtitle: "一个用电的爱好者"
	quest.608C22B016C2E757.quest_desc: ["用电信号&6精确&r控制机械运动：控制引脚为-5至5伏，对应&b旋转&r的-360°至360°。"]
	quest.608C22B016C2E757.quest_subtitle: "精准移动"
	quest.60953F1CB3065914.quest_desc: ["&d原矿&r Mithril 是 Iron's Spells 'n Spellbooks 中的一种稀有合成材料。开采 Mithril Ore 和 Deepslate Mithril Ore 时会掉落。在高炉中熔炼可&b获得&r Mithril Scrap，然后用它来&b制作&r Mithril Ingot 和其他强力装备。"]
	quest.60953F1CB3065914.quest_subtitle: "蕴含着古老魔力的未精炼金属"
	quest.60A628F3BCECB4F0.quest_desc: [
		"&a马拉里特剑&r是永恒星光中的前期武器，使用在黑暗沼泽地区&b获取&r的马拉里特制作而成。"
		""
		"&a它&r是模组基础进阶阶段的一部分，并且&b使用&r合成台中的简易配方。"
	]
	quest.60A628F3BCECB4F0.quest_subtitle: "沼泽锻造武器"
	quest.60B86999CB28ED7B.quest_desc: ["&6Craft&r the Overstress Clutch as a safety mechanism for your kinetic network. When the network becomes overstressed, the clutch automatically disconnects after a &bconfigurable&r delay, &bpreventing&r the overload from continuing through the connected machinery. It can be reconnected with a wrench, and its delay can be &badjusted&r from the side. It also supports a comparator output &bwhen&r coupled and can be reset with a redstone pulse."]
	quest.60B86999CB28ED7B.quest_subtitle: "在系统崩溃前关机"
	quest.60D022BA2B9F98D3.quest_desc: ["&a欢迎来到&r My Nether's Delight，这是一个将 Farmer's Delight 的烹饪与种植体验带入下界的模组。探索受 Minecraft 危险维度启发的全新下界食材、&b独特&r食物、烹饪配方和&b实用&r烹饪物品。"]
	quest.60D022BA2B9F98D3.quest_subtitle: "探索下界的火热美食吧！"
	quest.60D022BA2B9F98D3.title: "&l&a我的下界之乐"
	quest.60DD9FC925957248.quest_desc: ["&6Craft&r the Fan Seething Catalyst to perform seething recipes using an Encased Fan. It provides a dedicated catalyst for high-temperature fan &bprocessing&r and was added to Create: Connected as a &bcompatibility&r item for Create: Dreams \\& Desires."]
	quest.60DD9FC925957248.quest_subtitle: "把火开大点"
	quest.60DF6A58DAC3125E.quest_desc: [
		"&6任务书故障排除&r"
		""
		"打开背包后，如果任务图标没有出现，请不要惊慌。这有时可能是因为着色器或任务界面未能正确加载而导致的。"
		""
		"解决方案："
		""
		"游戏中按 R。这将重新加载着色器，并刷新任务界面。"
		""
		"重载后，再次打开你的物品栏。任务图标应该会正常显示。"
		""
		"如果问题仍然存在，请再次按下 R 键或重启游戏。"
		""
		"记住这个任务——它或许能帮你避免后续的挫败感。"
		"{@pagebreak}"
		"&6Need Help?&r"
		""
		"并非所有问题都有简单的解决方案。如果遇到本章未涵盖的问题，请随时寻求帮助。"
		""
		"请在我们的 Discord 服务器上报告您的问题。"
		""
		"你可以在任务书的教程部分找到 Discord 链接。"
		""
		"出错了？请告知我们。"
	]
	quest.60DF6A58DAC3125E.quest_subtitle: "常见问题的简单解决方案"
	quest.60DF6A58DAC3125E.title: "&f&l禁止使用的辅助工具"
	quest.60E721A9A608B618.quest_desc: [
		"&aAmong&r the rarest treasures of Eternal Starlight are the mysterious Starlit Diamonds."
		"这些&b宝石&r蕴含着天界能量，代表着该维度中更高级别的材料&a进阶&r。"
		""
		"&a找到&r一个，意味着你已开始抵达星光世界更深、更危险的区域。"
	]
	quest.60E721A9A608B618.quest_subtitle: "被星辰所触碰的水晶"
	quest.60E721A9A608B618.title: "&6星光钻石"
	quest.60E9767AC825258B.quest_desc: [
		"&dThe&r Druidic Tome is an epic Nature spellbook focused on the power of the natural world. It provides &b10&r spell slots, &b+200&r Max Mana and &b+10%&r Nature Spell Power, making it an excellent choice for spellcasters specializing in Nature magic."
		""
		"&b装备&r法典，加强与自然力量的&b联系&r。"
	]
	quest.60E9767AC825258B.quest_subtitle: "驾驭大自然的力量"
	quest.60F96662688EDC1A.quest_desc: [
		"&a获取&r音乐唱片：末地守卫，来自废弃堡垒的末地守卫首领的稀有掉落物。"
		""
		"与其他Cataclysm boss唱片一样，将其放入唱片机时会播放与其地牢相关的&b主题&r音乐。"
	]
	quest.60F96662688EDC1A.quest_subtitle: "来自虚空的旋律"
	quest.60F96662688EDC1A.title: "音乐唱片"
	quest.60FDFBDED2583D6F.quest_desc: ["&d启用&r &b瞄准&r：通过缩放视图进行精确的远程射击。"]
	quest.60FDFBDED2583D6F.quest_subtitle: "放大视角"
	quest.6115A157E4A81A68.quest_desc: [
		"&d毒抗性戒指&r能完全免疫&b毒物&r，保护你免受中毒效果的影响，让你可以毫无畏惧地面对有毒的敌人和危险。"
		""
		"&b装备&r戒指，将最&b危险&r的负面效果之一变为历史威胁。"
	]
	quest.6115A157E4A81A68.quest_subtitle: "获得对毒液的免疫效果"
	quest.61224C127468D17C.quest_desc: ["&dInferno&r Disc 是 Crystal Chronicles 中的一种武器。它由 &b使用&r Volcanite Shards 制作而成，与扩展包新增的增强版 Pyromancer 装备相关。其炽热的威力使其成为火系魔法使用者的天然 &b武器&r。"]
	quest.61224C127468D17C.quest_subtitle: "由火山岩的力量锻造而成的炽热圆盘"
	quest.6122706161D768D9.quest_desc: [
		"&aCraft&r the Ironwood Helmet using Ironwood Ingots &binfused&r with the ancient magic of the Twilight Forest. Combining the strength of iron with the mystical &benergy&r of the enchanted forest, this helmet offers reliable protection while embodying the craftsmanship of a forgotten civilization."
		""
		"&aAs&r part of the Ironwood Armor set, it strengthens your defenses and &bprepares&r you for the dangerous creatures, dungeons, and &bbosses&r that await deeper within the Twilight Forest."
	]
	quest.6122706161D768D9.quest_subtitle: "用古老的魔法守护你的心灵"
	quest.61246DD0435F1D05.quest_desc: ["&a寻找&r一片沙漠生物群系。广阔的沙地、仙人掌和古代遗迹正等待着那些愿意&b穿越&r灼热荒野的人。沙漠中有着像沙漠金字塔、沙漠村庄和沙漠水井等&b宝贵&r的建筑。"]
	quest.61246DD0435F1D05.quest_subtitle: "在无尽的沙海中搜寻"
	quest.61246DD0435F1D05.title: "&l&e找到一个沙漠"
	quest.613B45640F884627.quest_desc: [
		"Terminite 斧是一种由 Terminite 锭锻造而成的&a伐木&r和战斗工具，比 Thallasium 等级更胜一筹。"
		""
		"Terminite 装备本身并非最强，但它却是迈向 Aeternium 和 Crystalite 装备的必备&b垫脚石&r。"
	]
	quest.613B45640F884627.quest_subtitle: "木材加工工具，精炼版"
	quest.6140A6E97F827366.quest_desc: [
		"&aSomewhere&r within the world of Eternal Starlight, ancient structures hide powerful constructs known as Starlight Golems."
		"这些地点不易找到，通常需要正确使用带有合适物品的&bSeeking Eye&r。"
		""
		"&a跟随&r信号，揭开结构，探索其中的奥秘。"
	]
	quest.6140A6E97F827366.quest_subtitle: "找到守护遗迹的东西是什么"
	quest.6140A6E97F827366.title: "哥布林锻造炉"
	quest.614A03480EBFEF1A.quest_desc: ["使用Cataclysm模组的材料，制作&aIgnitium Elytra Chestplate&r。这件&b传奇&r盔甲结合了Ignitium胸甲的保护性和Elytra的机动性，是使用火焰之主金属锻造的最强大的&b装备&r之一。"]
	quest.614A03480EBFEF1A.quest_subtitle: "由下界火焰锻造而成的盔甲"
	quest.614ABD14341C88FE.quest_desc: [
		"&9&lPut&r&r your digital storage network to work with the Exporter. It &bautomatically&r extracts selected items from your Refined Storage &bnetwork&r and sends them into connected inventories."
		""
		"将其连接到箱子、机器或其他兼容方块，并配置要导出的物品。构建自动化系统时，这是一个简单但&b必要&r的组件。"
	]
	quest.614ABD14341C88FE.quest_subtitle: "将物品从你的网络中发送到任何需要的地方"
	quest.614CBA540862DF7D.quest_desc: [
		"&6Give&r your locomotive a tougher industrial &bappearance&r with Slashed Locometal. Its distinctive cut-metal pattern adds depth and character to your train while keeping the unmistakable Steam 'n' Rails aesthetic."
		""
		"&b使用&r它，为你的机车增添最后一抹粗犷的细节。"
	]
	quest.614CBA540862DF7D.quest_subtitle: "为你的机车带来粗犷的外观。"
	quest.6153B298AE74D818.quest_desc: [
		"&a以太之靴&r是永恒星光中用&b以太锭&r制成的神秘腿部护甲。"
		""
		"&aThey&r are part of the Aethersent progression tied to meteors and celestial &bmaterials&r found in the Starlight dimension."
	]
	quest.6153B298AE74D818.quest_subtitle: "天体神秘家腿甲"
	quest.615B240EC8017A1E.quest_desc: [
		"&aMalarite-related&r smithing &bprogression&r in Eternal Starlight uses smithing templates as part of weapon upgrade systems."
		""
		"&a这些&r模板用于通过锻造台升级或强化马拉里特级武器。它们的获取与&b进度&r内容和该维度内的&b结构&r战利品相关。"
	]
	quest.615B240EC8017A1E.quest_subtitle: "武器升级的远古遗物"
	quest.615B240EC8017A1E.title: "&5马拉里特锻造模板"
	quest.6160F754ACE16D63.title: "&l&c下界合金 &6怪&e物"
	quest.617B7BE17022FC0F.quest_desc: [
		"&e谁&r有时间停下来喝杯东西？"
		""
		"这顶&b奇怪的&r塑料帽子能让你吃喝快得多，让你无需浪费宝贵时间就能重返冒险。"
		""
		"&b穿上&r它，喝点东西，然后继续前进。"
	]
	quest.617B7BE17022FC0F.quest_subtitle: "喝得更快。吃得更快。保持移动"
	quest.617F700F91153D89.quest_desc: ["&6欢迎来到&r创造。探索机械工程、旋转机械和自动化系统的&b力量&r。从学习如何将简单的&b材料&r转化为复杂的机器和有用的装置开始你的旅程。"]
	quest.617F700F91153D89.quest_subtitle: "一个充满齿轮、机器和无限可能性的世界"
	quest.617F700F91153D89.title: "&l&6欢迎来到创造模式"
	quest.618307252C357AAD.quest_desc: [
		"&aCraft&r the Ironwood Sword using Ironwood Ingots forged with the ancient magic of the Twilight Forest. This finely crafted blade combines the resilience of iron with the mystical power of the enchanted woods, creating a dependable weapon capable of &bstanding&r against the dangerous &bcreatures&r that roam the forest."
		""
		"&aAs&r one of the core weapons of the Ironwood equipment set, it provides a noticeable improvement in both &bdurability&r and combat performance, preparing you for the increasingly difficult bosses and &bdungeons&r that lie ahead."
	]
	quest.618307252C357AAD.quest_subtitle: "由钢铁与森林魔法锻造而成的利刃"
	quest.61885962E531AC61.quest_desc: ["&a蜡封的猪灵奖杯&r是猪灵奖杯的装饰性保存版本。蜡层有助于保护奖杯，&b使其&r成为你基地的永久装饰。"]
	quest.61885962E531AC61.quest_subtitle: "一头被击败的猪灵的保存奖杯"
	quest.6188D7490C607899.quest_subtitle: "更多盔甲 (More Armor)"
	quest.618AD1A819B8105E.quest_desc: ["&a击败&r来自Cataclysm模组的5名精英德拉格。这些强大的不死&b战士&r是冰冻监狱中最危险的守卫者。击败他们以证明你的&b实力&r，继续你的&b旅程&r穿越这座冰封堡垒。"]
	quest.618AD1A819B8105E.quest_subtitle: "击败监狱中最强大的战士们"
	quest.618AD1A819B8105E.title: "击杀精英德拉格（Elite Draugr）"
	quest.61913CFAB19D8C92.quest_desc: [
		"&a玻璃匠&r是一种用于将玻璃块转化为多种装饰性变体的合成台。"
		"尝试不同风格，让你的建筑独具特色。"
	]
	quest.61913CFAB19D8C92.quest_subtitle: "塑造玻璃的形状"
	quest.61AE095F93EF5CAB.quest_desc: [
		"使用遍布暮色森林的附魔钢叶材料来&a制作&r钢叶胸甲。这件胸甲融合了森林的古老魔法，防护可靠却出奇轻便，是穿越&b危险&r生物群系和远古遗迹长途探险的理想之选。"
		""
		"&aAs&r the centerpiece of the Steeleaf armor set, it offers a significant defensive upgrade and prepares adventurers for the challenges that lie &bdeeper&r within the Twilight Forest."
	]
	quest.61AE095F93EF5CAB.quest_subtitle: "融入了森林魔法的盔甲"
	quest.61AE17528CDE5C93.quest_desc: ["&6酿造&r辛伐尔，为您的自动化酿酒厂增添一款独特的红葡萄酒。 &b使用&r酒窖和Create的机械来加工葡萄，并&b生产&r出您酒窖中又一个精致的佳酿。Create: Winery 专注于&b自动化&r葡萄加工和葡萄酒生产。"]
	quest.61AE17528CDE5C93.quest_subtitle: "来自葡萄园的浓郁葡萄酒"
	quest.61B7DF42DC1D3DB1.quest_desc: [
		"&d暗影行者&r面具是 Iron's Spells 'n Spellbooks 中暗影行者盔甲套装的头盔。佩戴后可提供 &b+3&r护甲、&b+125&r最大法力、&b+10%&r末影法术强度和 &b+5%&r法术强度。"
		""
		"它可以用5个Arcane Cloth和1个Ender Rune&b制作&r，或在支持版本中用1个Ender Rune和1个Arcane Essence升级Wizard Helmet获得。"
	]
	quest.61B7DF42DC1D3DB1.quest_subtitle: "掌握神秘的末地魔法的力量"
	quest.61C2E8B8CEC84581.quest_desc: ["&e欢迎来到&r Game Discs，一个为 Minecraft 添加复古游戏机和经典小游戏的模组。找到 Game Discs，&b收集&r它们，然后&b使用&r游戏机来&b畅玩&r不同游戏，无需离开你的 Minecraft 世界。"]
	quest.61C2E8B8CEC84581.quest_subtitle: "将经典游戏带入我的世界！"
	quest.61C2E8B8CEC84581.title: "&l&f欢迎使用 &a游戏光盘"
	quest.61D9AEB9EB5F4BB9.quest_subtitle: "更多盔甲 (More Armor)"
	quest.61DBDB4C046CE058.title: "yyyyyyy"
	quest.61DDD281F01A10BB.quest_desc: ["&6Brass&r Leggings are part of the Brass Suit from Create Stuff 'N Additions. They are &bcrafted&r from &b7&r Brass Ingots and have &b375&r durability, making them a durable part of the brass armor set."]
	quest.61DDD281F01A10BB.quest_subtitle: "完成黄铜套装的制作"
	quest.621ACFB71957DACF.quest_desc: [
		"&9&l借助磁化升级，&r&r让拾取掉落物变得毫不费力。它能吸引附近的物品，并&b自动&r将其放入你的储物空间中，&b保持&r周围环境整洁，让你的物品栏不再杂乱。"
		""
		"高级磁铁升级扩展了磁铁的功能，让你拥有更远的&b范围&r，并能更好地控制吸引的物品。使用过滤器，确保只有你&b真正&r想要的资源进入你的储物空间。"
	]
	quest.621ACFB71957DACF.quest_subtitle: "将附近的物品直接吸入你的储物箱中"
	quest.621ACFB71957DACF.title: "磁石 \& 高级磁石升级组件"
	quest.62474A1802B2E109.quest_subtitle: "真美味！"
	quest.6248B75B2221B854.quest_subtitle: "升级+"
	quest.62628FBCBA78E7E6.quest_desc: [
		"&dDecrepit&r Flamberge 是 Ancient Knights 在 Iron's Spells 'n Spellbooks 中使用的强力双手剑。他们可能会&bnaturally&r掉落它。"
		""
		"主手持有时，提供&b11&r点攻击力、&b1.3&r的攻击速度以及&b+4&r的护甲。之后可以用永恒泥浆和一块Pyrium Ingot将其&b升级&r为军团长火焰剑。"
	]
	quest.62628FBCBA78E7E6.quest_subtitle: "挥舞被遗忘的骑士们的远古之刃"
	quest.6276AF4B828C53D9.quest_desc: [
		"&d冰&r升级球是 Iron's Spells 'n Spellbooks 中的一种升级材料。在神秘砧上使用时，可提供 &b+5%&r 的冰系法术强度。"
		""
		"它由 1 个空升级球和 8 个冰符文&b合成&r而成。"
	]
	quest.6276AF4B828C53D9.quest_subtitle: "用冰魔法的力量来强化你的装备"
	quest.62858FA44AA44E80.title: "兄弟"
	quest.62AD3B71953D2BAC.title: "yh"
	quest.62B96FD0EF8229FC.quest_desc: [
		"&d铭文台&r是 Iron's Spells 'n Spellbooks 中最重要的魔法工作台之一。用它将卷轴中的法术转移到你的法术书中，&b永久地&r将其添加到&b可用的&r法术栏位中。你也可以将已解锁的法术从法术书中提取回卷轴。"
		""
		"这张桌子占两个方块，是构建和管理你的法术书配置所&b必需&r的。 &b寻找&r或制作一本法术书，收集卷轴，并开始用你想掌握的魔法来填充你的书吧。"
	]
	quest.62B96FD0EF8229FC.quest_subtitle: "用强大的法术填满你的法术书"
	quest.62BA7685BF01904B.quest_desc: [
		"&6飞行&r不仅关乎速度，稳定性也很重要。陀螺仪能让你的飞行器保持稳定，并完全&b消除&r风的影响，使飞行更可控、更稳定。"
		""
		"安装陀螺仪，更自信地&b操控&r你的飞行器。"
	]
	quest.62BA7685BF01904B.quest_subtitle: "无论风力如何，都保持飞行器稳定。"
	quest.62C6D37BDFF143BD.quest_desc: ["&6Craft&r the English Horn pipe and &bexpand&r your organ with its distinctive reed tone. English Horn is one of the pipe stops added in Create: Sound of Steam 0.8.0. As a reed pipe, it is crafted through &bsequenced&r assembly using the mod's reed and tuning wire components."]
	quest.62C6D37BDFF143BD.quest_subtitle: "添加一个温暖的芦苇嗓音"
	quest.630CA9C23881A985.quest_desc: [
		"&dArchevoker&r 帽是 Iron's Spells 'n Spellbooks 中 Archevoker 盔甲套装的头盔。佩戴后可提供 &b+3&r 护甲、&b+125&r 最大法力、&b+10%&r 召唤术法术强度和 &b+5%&r 法术强度。"
		""
		"可以用5个Arcane Cloth和1个Evocation Rune来&b制作&r，或者在Smithing Table上用1个Evocation Rune将Wizard Helmet升级而成。"
	]
	quest.630CA9C23881A985.quest_subtitle: "掌握召唤魔法的奥术力量"
	quest.6311D7362CCEBE8A.quest_desc: ["&6Build&r the Wine Cellar, the heart of your winery. This fully automatable workstation processes grape juice, apple must, and other &bingredients&r into Red Wine, White Wine, Rosé, and Cider. Connect funnels and Create machinery to &bautomate&r the entire winemaking process."]
	quest.6311D7362CCEBE8A.quest_subtitle: "发酵、熟成，并将你最优秀的作品装瓶"
	quest.6319576F1AAF714B.title: "PRO"
	quest.632DB3C11495D9A1.quest_subtitle: "更多盔甲 (More Armor)"
	quest.63387AF850FEAA94.quest_desc: [
		"&dAutoloader&r 十字弓是 Iron's Spells 'n Spellbooks 中独特的远程武器。它能自动从背包中加载下一个可用的投射物，包括箭和烟花。 &b按住左键&r可取消自动装填。"
		""
		"它可以在 Ominous Vaults 中作为稀有奖励&b找到&r。耐久度为 465，可施加普通的弩附魔。"
	]
	quest.63387AF850FEAA94.quest_subtitle: "拥有无限的投射物，永不停止地开火"
	quest.636CD2E37C7B1F4E.quest_desc: [
		"&aCraft&r the Arctic Boots &busing&r soft Arctic Fur gathered from the frozen reaches of the Twilight Forest. &bDesigned&r to keep your feet warm while traversing snow and ice, these boots provide dependable &bprotection&r without sacrificing comfort or mobility."
		""
		"&aAs&r part of the Arctic Armor set, they are essential for surviving the unforgiving climate of the Glacier. Whether climbing &bfrozen&r cliffs or crossing endless snowy plains, the Arctic Boots will keep you &bmoving&r toward the final secrets of the Twilight Forest."
	]
	quest.636CD2E37C7B1F4E.quest_subtitle: "除了决心，不要留下任何踪迹"
	quest.638387B448672958.quest_desc: ["&aObtain&r an Ancient Metal Nugget from the Cataclysm mod. These fragments of ancient metal are commonly dropped by Koboletons and can also be &bfound&r throughout the Desert Site and Cursed Pyramid. Combine 9 Ancient Metal Nuggets to craft an &bAncient&r Metal Ingot, a key &bmaterial&r for ancient equipment."]
	quest.638387B448672958.quest_subtitle: "被遗忘的文明的残片碎片"
	quest.639BD5444809C7EB.quest_desc: ["&aCraft&r the Bone Reptile Helmet from the Cataclysm mod. This &bunique&r helmet is crafted using Ancient Metal Ingots, Koboleton Bones, and a Kobolediator Skull, making it a true &btrophy&r earned by &bconquering&r the Cursed Pyramid."]
	quest.639BD5444809C7EB.quest_subtitle: "佩戴沙漠冠军的头骨头盔"
	quest.639CE862CC9E6065.quest_desc: ["&d黑火药&r是本模组几乎所有物品的基础。它用于制作&b子弹&r、枪支和大量&b修饰器&r，所以务必保持充足的储备。"]
	quest.639CE862CC9E6065.quest_subtitle: "每一发子弹背后的火花"
	quest.63A8822AE7315353.quest_desc: ["&d喷火枪&r是一种近距离霰弹枪。它最适合对付近距离的&b群体&r或单个目标，向单个目标倾泻大量子弹可获得“通风”成就。"]
	quest.63A8822AE7315353.quest_subtitle: "近距离的混乱"
	quest.63CB8BC129A734C0.quest_subtitle: "升级+"
	quest.63CF9DFE04D5CB1D.quest_desc: ["&6测量&r设备的&b温度&r。手持时，会显示指向物体的温度。放置在设备上，会测量其随时间的&b当前&r和最高温度。"]
	quest.63CF9DFE04D5CB1D.quest_subtitle: "测量温度"
	quest.63E56C890C99BE64.quest_desc: [
		"&6实验是探索的一部分。&r"
		""
		"并非所有事物都会自行解释。有些机器需要测试，有些物品有意外用途，而有些机制只有通过亲自尝试才能理解。"
		""
		"组合物品。测试机器。尝试不同工具。探索未知系统。"
		""
		"你会打破东西。你会犯错。这就是学习的过程。"
		""
		"不要害怕去尝试——有时最有益的发现，恰恰是你意想不到的收获。"
	]
	quest.63E56C890C99BE64.quest_subtitle: "最棒的发现往往并非计划所得"
	quest.63E56C890C99BE64.title: "&l&f不要害怕实验，大胆尝试吧！</c2></c1>"
	quest.63EF96C7B8FE5011.quest_desc: ["用机械压榨机处理&6白葡萄&r以&b获得&r白葡萄渣，这是 Create: Winery 酿酒过程的副产品。该葡萄渣可与其他酿酒原料一同用于进一步处理和&b自动化&r。"]
	quest.63EF96C7B8FE5011.quest_subtitle: "把每一颗葡萄都充分利用起来"
	quest.6406B05C60A7BA67.quest_desc: [
		"装甲鞘翅是使用 Better End 材料加固的升级版鞘翅，滑翔时更耐用。"
		""
		"它可以在铁砧上使用&aAeternium&r锭修复，或通过修补附魔进行修复。"
	]
	quest.6406B05C60A7BA67.quest_subtitle: "加固的翅膀"
	quest.6423C49E7EC083E1.quest_desc: [
		"&aCraft&r a Gold Hook, a &brefined&r piece of fishing equipment created for anglers who seek more than ordinary catches. Crafted with precious gold, this hook &brepresents&r a balance between elegance and efficiency, helping you pursue the rare treasures hidden beneath the waves."
		""
		"&aThe&r ocean rewards &bthose&r who are prepared. With the Gold Hook as part of your equipment, you are one step closer to discovering the secrets of the deep and the &bvaluable&r finds waiting in unexplored waters."
	]
	quest.6423C49E7EC083E1.quest_subtitle: "用于吸引海洋宝藏的黄金鱼饵"
	quest.64275AD4D0C56F95.quest_subtitle: "升级+"
	quest.6439C150DA3F1E22.quest_subtitle: "更多盔甲 (More Armor)"
	quest.6441CDA42F631D3C.quest_desc: ["&d一种&r稀有且珍贵的合成材料，&b用于&rHazen N Stuff 中的多种配方。"]
	quest.6441CDA42F631D3C.quest_subtitle: "一种用于许多强力配方中的珍贵材料"
	quest.6455DAC5C9E5DDFF.quest_desc: ["&6蓝图工作台&r用于将保存的 .nbt 蓝图写入空白蓝图。将空白蓝图放入输入槽，&b从蓝图文件夹中&r选择一个蓝图，并确认选择。工作台会将结构数据上传到物品上，使其成为可用的蓝图。加载后，该蓝图可以作为全息&b蓝图&r放置，并使用蓝图炮在生存模式建造，或在创造模式直接打印。处理时间取决于所选结构的&b大小&r。"]
	quest.6455DAC5C9E5DDFF.quest_subtitle: "将蓝图变为现实"
	quest.645C82A3532AED90.quest_desc: ["&6机械钻头&r利用旋转力量直接破坏前方的方块。转速越快，挖掘越&b快&r。它还能对接触旋转钻头的实体造成伤害。安装在移动装置上时，它能&b自动&r破坏路径上的方块，&b因此&r非常适合用于采矿机、隧道钻和自动化采石场。"]
	quest.645C82A3532AED90.quest_subtitle: "向下挖掘得更深一点"
	quest.646116DDCB5D0803.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.64737A846B22061E.quest_desc: ["&a击败&r来自Cataclysm模组的Kobolediator。这些强大的&b精英&r战士守护着Cursed Pyramid的深处，挥舞着重型&b武器&r，保护着通往Ancient Remnant的道路。 &b击败&r一个以证明你的实力。"]
	quest.64737A846B22061E.quest_subtitle: "击败被诅咒金字塔的冠军"
	quest.64737A846B22061E.title: "Kobolediator"
	quest.6476156CB4ECE2D1.title: "好的，我明白了。我将从你提供的文本中翻译出任务书的内容。"
	quest.6478CCA843E198AA.quest_desc: [
		"&d虚空行者&r胸甲是《水晶编年史》中，源自《铁之咒语与咒语书》的&b升级版&r暗影行者盔甲胸甲。"
		""
		"使用深渊水晶碎片进行&b升级&r，将原本的暗影行者盔甲转变为强大的虚空行者盔甲套装。深渊水晶碎片为胸甲注入了深渊的力量，增强了原装备黑暗与阴影的&b能力&r。"
	]
	quest.6478CCA843E198AA.quest_subtitle: "由深渊水晶强化的暗影行者盔甲的增强形态"
	quest.648824143B6CB7EB.quest_desc: [
		"&dThe&r Rotten Spell Book is a rare piece of world loot in Iron's Spells 'n Spellbooks. When equipped as your spellbook, it provides &b8&r spell slots and grants &b+100&r Max Mana, but at the cost of &b-15%&r Spell Resistance."
		""
		"一本被腐化的魔典，代价高昂：以&b削弱&r对敌法抗为代价，换取更强的魔法储备。"
	]
	quest.648824143B6CB7EB.quest_subtitle: "拥抱腐化，获得禁忌的力量"
	quest.6489A7EA609347D8.quest_desc: ["&6获取&r任意一个Create的座位。座位有&b16&r种颜色，可以&b用来&r坐在移动的装置上，因此特别适合火车、车辆和其他机械装置。"]
	quest.6489A7EA609347D8.quest_subtitle: "坐下来，享受这趟旅程吧"
	quest.6489A7EA609347D8.title: "创建座位"
	quest.64992BB68270DECF.quest_subtitle: "更多盔甲 (More Armor)"
	quest.64A1134999AB1508.quest_desc: ["&6Craft&r a Shear Pin and add a simple safety mechanism to your kinetic network. When the connected system &bbecomes&r overstressed, the Shear Pin breaks and disconnects the network, preventing the overload from bringing down the entire setup. It is a consumable component, so keep &breplacements&r ready."]
	quest.64A1134999AB1508.quest_subtitle: "在它之前，先让它破碎吧，在它之前，先让它破碎吧"
	quest.64A2E52F46697285.quest_desc: [
		"&aFar&r beneath the waves, where &bsunlight&r can no longer reach, lies the Sunken City—an immense underwater metropolis abandoned by time. Hidden within the deepest oceans, its ruined halls are &bguarded&r by terrifying creatures and ancient &bmagic&r that has endured for countless ages."
		""
		"&aLegends&r 传说，在城市的中心沉睡着一位&b不可言喻&r的恐怖，等待着胆大妄为者来打扰它的安眠。找到沉没之城，是&b揭开&r大海之下最大秘密的第一步。它自然生成于深海生物群系，并且&b是&rThe &bLeviathan&r 的领地。"
	]
	quest.64A2E52F46697285.quest_subtitle: "深渊中隐藏着古老的文明"
	quest.64A2E52F46697285.title: "&d寻找沉没之城"
	quest.64C33111DD58A498.quest_desc: [
		"&d虚空行者&r头盔是《水晶编年史》中，源自《铁之咒语与咒语书》的&b升级版&r暗影行者面具。"
		""
		"使用深渊水晶碎片进行&b升级&r，将原本的暗影行者盔甲转变为&b强大的&r虚空行者盔甲套装。深渊水晶碎片为头盔注入了深渊的力量，增强了原装备黑暗与阴影的&b能力&r。"
	]
	quest.64C33111DD58A498.quest_subtitle: "由深渊水晶强化的暗影行者面具的增强形态"
	quest.64CA1CB9C3613638.quest_desc: [
		"&9&lPrepare&r&r your Refined Storage network for &bautomated&r crafting with the Pattern Grid. It provides a dedicated interface for creating crafting patterns, allowing you to define recipes that your network can &buse&r later for automatic production."
		""
		"Connect it to your network, place the required ingredients into the grid and save the pattern for your &bfuture&r crafting automation."
	]
	quest.64CA1CB9C3613638.quest_subtitle: "轻松创建和管理合成配方"
	quest.64DB8A01416875C1.quest_desc: ["&6可以&r将绕组以一定角度环绕转子连接，使发电机更整洁，并且有较少的&b电线&r。"]
	quest.64DB8A01416875C1.quest_subtitle: "一个发电机外壳"
	quest.64EA1F8E5E62BF02.quest_desc: ["&dHermomancer&r 护腿是《水晶编年史》套装的一部分，该套装是《铁之魔法与魔典》的&b附加包&r。"]
	quest.64EA1F8E5E62BF02.quest_subtitle: "驾驭赫罗曼瑟的力量，掌控一切"
	quest.64EB7EE019147045.quest_desc: ["&6炽热铲子&r是Create Stuff 'N Additions中炽热工具套装的一部分。它用火焰处理你挖掘的方块，&b自动&r熔炼可熔炼的掉落物。攻击生物时还会使其着火，&b因此&r在采集资源和战斗中都非常实用。该模组&b描述&r炽热工具为：能熔炼所破坏方块、灼烧所击中生物的武器。"]
	quest.64EB7EE019147045.quest_subtitle: "用下界的炽热来挖掘吧"
	quest.64ECB881301B5C3F.quest_desc: ["&6获取&r一个来自Create的链式输送机。它用于运输纸板包裹，也可以在机械带无法使用的地方传递&b旋转&r力。链式输送机通过链条连接，让你能创建&b长途&r运输网络。"]
	quest.64ECB881301B5C3F.quest_subtitle: "将你的工厂跨越重重障碍地带去"
	quest.64EDDFF6EC5B218C.quest_subtitle: "升级+"
	quest.64FC5CB2F3BE1398.quest_desc: ["&a击败&r 7 只鱿鱼。这些和平的海洋生物可以在河流和海洋中游泳。鱿鱼会掉落墨囊，一种用于制作和给物品&b上色&r的&b实用&r材料。"]
	quest.64FC5CB2F3BE1398.quest_subtitle: "猎捕海洋中的生物吧"
	quest.64FC5CB2F3BE1398.title: "击杀鱿鱼"
	quest.65034A7DC75B290A.quest_desc: ["&6右键&r会发射一道&b闪电&r，在附近敌人间弹跳并分摊伤害。佩戴便携式电池时，它不会消耗耐久度，而是消耗电池的&b能量&r。一个集成电路会&b增强&r它，使其能使用有限次数。"]
	quest.65034A7DC75B290A.quest_subtitle: "一把闪电枪"
	quest.650669ADA78A35B5.quest_desc: ["&6Build&r the Hypertube Entrance to connect your factory to a &bhigh-speed&r transportation network. Power the entrance with a cogwheel and use it to launch players and other entities through connected Hypertubes. The &bentrance&r can also be configured with a wrench between different modes."]
	quest.650669ADA78A35B5.quest_subtitle: "快车道，即刻体验"
	quest.650ECB3047B12DCA.quest_desc: ["&6一桶&r种子油包含种子油，这是一种由 Create Crafts & Additions 添加的流体。种子油通过加工种子生产，可以&b用作&r&b兼容的&r Create 机器的燃料，为原本&b普通的&r种子赋予了另一个实用用途。"]
	quest.650ECB3047B12DCA.quest_subtitle: "将种子转化为有用的燃料"
	quest.651F8F268D2CFC3E.quest_desc: ["&dA&r special orb that increases draw &bspeed&r by 5%."]
	quest.651F8F268D2CFC3E.quest_subtitle: "能提高射箭速度的球体"
	quest.652588740098F721.quest_desc: [
		"&9&lIncrease&r&r the stacking capacity of items in your Sophisticated Storage containers with the Stack Upgrade Tier 1+. This upgrade lets compatible &bitems&r stack beyond their normal limit, allowing you to store more &bresources&r without using additional slots."
		""
		"一个&b简单&r的升级，让每个储物容器都更&b高效&r，并为你的不断增长的收藏品提供更多空间。"
	]
	quest.652588740098F721.quest_subtitle: "让每个堆叠都容纳更多内容"
	quest.6525C8D1AA1212CA.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.652855610941A655.quest_desc: ["使用Aquaculture 2制作&aNeptunium Shovel&r。这件强力工具由Neptunium制成，这是一种通过钓鱼宝藏获得的&b稀有&r &b材料&r。它具有高&b耐久度&r和挖掘效率，是Neptunium装备套装的一部分。"]
	quest.652855610941A655.quest_subtitle: "来自海洋宝藏的强大工具"
	quest.6530A1F90F372190.quest_desc: ["&6准备&r一杯南瓜奶昔，为你的工厂饮品增添&b季节性&r风味。将南瓜与&b所需&r材料结合，制作这款来自 Create: Dreams n' Desires 的浓郁奶油甜点。"]
	quest.6530A1F90F372190.quest_subtitle: "奶油般浓郁的秋日风味"
	quest.6533F849759661AD.quest_subtitle: "更多盔甲 (More Armor)"
	quest.653CC055797F0927.quest_desc: ["&d无亲和力戒指&r让你摆脱魔法专精的限制，可以&b使用&r魔法装备而无需局限于特定魔法学派。对于偏好多样化、想结合不同魔法能力的施法者来说，这是一个&b绝佳&r的选择。"]
	quest.653CC055797F0927.quest_subtitle: "无需选择阵营，掌握所有学派的知识"
	quest.6556684EFB044E69.quest_subtitle: "更多盔甲 (More Armor)"
	quest.655AF2B574D2FA9E.quest_desc: ["使用Cataclysm: Spellbooks模组制作&aIgnis Mage Greaves&r。这套&b附魔&r的护胫是Ignis Mace Armor套装的一部分，灵感源自Ignis的力量与下界的火焰。它将古老的火焰魔法与强大的防护相结合，让&b战士&r能掌控燃烧竞技场的怒火。"]
	quest.655AF2B574D2FA9E.quest_subtitle: "火焰领主祝福过的盔甲"
	quest.656410AFBCA6979B.quest_desc: [
		"&l&9将&r&r背包变成便携式&b流体处理&r系统。泵升级可将背包储罐与流体存储或容器之间传输流体。而&b高级&r泵升级更进一步，可与世界中的流体方块和手持容器互动，并能过滤可移动的流体类型。"
		""
		"&b经验&r泵升级将经验纳入考量。与储罐升级结合，可将经验存储为流体，并根据你的&b已配置&r等级在背包和自身间自动转移。它甚至能自动帮助修复带有修补附魔的装备。"
	]
	quest.656410AFBCA6979B.quest_subtitle: "掌握流体的流动，体验其中的乐趣"
	quest.656410AFBCA6979B.title: "水泵，高级水泵 & 经验水泵升级"
	quest.6576B72D57A123E1.quest_desc: ["&a击败&r L_Ender’s Cataclysm 中的 5 只 Urchinkin。追踪这些深海的&b生物&r，逐一消灭。向 Cataclysm 海洋中&b危险&r的居民证明你的实力。"]
	quest.6576B72D57A123E1.quest_subtitle: "狩猎深海的生物们"
	quest.6576B72D57A123E1.title: "Urchinkin"
	quest.658219533A6C93DB.quest_desc: ["&aCraft&r the Pharaoh's Sacred Greaves from the Cataclysm: Spellbooks addon. These &benchanted&r leggings are part of the Pharaoh Wizard Armor set, inspired by the Ancient Remnant and the forgotten rulers of the desert. They &benhance&r Sand magic and strengthen the wearer's magical abilities."]
	quest.658219533A6C93DB.quest_subtitle: "与古代法老的力量同行，踏上征程"
	quest.6591631711CE8C17.quest_subtitle: "更多盔甲 (More Armor)"
	quest.6598FDE8CAE1D0F6.quest_desc: ["&6Craft&r the Spout Gun and use it to fire liquid projectiles. Fill it with a fluid using a Spout and unleash different effects &bdepending&r on the liquid used. Water deals damage, while lava, honey, chocolate, and slime can provide &badditional&r effects. The gun has 500 durability."]
	quest.6598FDE8CAE1D0F6.quest_subtitle: "将流体转化为弹药"
	quest.65A005EDC1864CE5.quest_desc: ["&6A&r digit or character module for displays. When powered it rotates half a number, and when &bpower&r is removed it finishes the turn. Reset: &bground&r the reset line and pulse the power again. Change its look and color in the design table."]
	quest.65A005EDC1864CE5.quest_subtitle: "一个展示模块"
	quest.65A4B36C2E970552.quest_desc: [
		"&aCraft&r and activate a Beacon using a Nether Star and rare resources."
		"信标能释放强大的效果，增强你的&b能力&r并保护基地，是末游阶段最重要的&b建筑&r之一。"
	]
	quest.65A4B36C2E970552.quest_subtitle: "下界之星的力量"
	quest.65B7CFAFB7A0DCFA.quest_desc: [
		"&a制作&r双钩，一个进阶的钓鱼升级道具，&b专为&r希望每次抛竿都收获满满的垂钓者设计。这款独特的配件拥有两个协同工作的鱼钩，能提升你&b发现&r水面下隐藏的价值渔获和稀有宝藏的几率。"
		""
		"&a技艺精湛的&r渔夫深知，&b成功&r源于充分的准备和合适的装备。双钩代表着垂钓技艺的新高度，&b让你&r每次出海都收获更丰厚、效率更高。"
	]
	quest.65B7CFAFB7A0DCFA.quest_subtitle: "双倍几率，双倍奖励"
	quest.65B87E469FB01B3D.quest_desc: [
		"&dArchevoker&r 外套是 Iron's Spells 'n Spellbooks 中 Archevoker 盔甲套装的胸甲。穿戴后可提供 &b+8&r 护甲、&b+125&r 最大法力、&b+10%&r 召唤法术强度和 &b+5%&r 法术强度。它还可以附魔 1 个法术。"
		""
		"可以用 8 块 Arcane Cloth 和 1 枚 Evocation Rune 来&b制作&r，或者在 Smithing Table 上用 1 枚 Evocation Rune 将 Wizard Robes 升级而成。"
	]
	quest.65B87E469FB01B3D.quest_subtitle: "引导出 Evocation 魔法的奥术力量"
	quest.65C3AC81A5F2406B.quest_desc: ["&a击败&r来自Cataclysm模组的Maledictus。这个&b强大的&r首领可以在位于雪地群系中的冰冻结构Frosted Prison内&b找到&r。击败这位被诅咒的&b战士&r，夺取其强大的战利品。"]
	quest.65C3AC81A5F2406B.quest_subtitle: "被诅咒的冰冻囚牢中的战士"
	quest.65C3AC81A5F2406B.title: "&l&6雄&3Male&bdictus"
	quest.65CD24700D1B39AD.quest_desc: ["&6The&r Burner Stock is a component from Create: Dreams n' Desires &bused&r in heat-based machinery. Add it to your &bsetup&r to support more advanced heating and &bprocessing&r systems in your factory."]
	quest.65CD24700D1B39AD.quest_subtitle: "保持热量在可控范围内"
	quest.65E959288A762976.quest_subtitle: "更多盔甲 (More Armor)"
	quest.65F02A93627352C4.quest_desc: [
		"&dThe&r Desert Spellbook is a Unique Spell Book from Cataclysm Spellbooks for Iron's Spells 'n Spellbooks. It provides &b12&r spell slots, &b+300&r Max Mana, &b+20%&r Nature Spell Power and &b+30%&r Holy Spell Power."
		""
		"这本强大的魔典融合了自然与神圣魔法的力量，是希望同时掌握这两种魔法的&b施法者&r的百搭之选。"
	]
	quest.65F02A93627352C4.quest_subtitle: "掌控沙土与自然的神圣力量"
	quest.65F189B0CAA91354.quest_desc: ["&6Obtain&r a Copper Casing from Create. Copper Casings are primarily &bused&r for fluid-related &bmachinery&r and can also be applied to Fluid Pipes to encase them and control &btheir&r connections. To make one, apply a Copper Ingot to a Stripped Log or Stripped Wood."]
	quest.65F189B0CAA91354.quest_subtitle: "建造流体工程的基础设施"
	quest.65F189B0CAA91354.title: "铜质外壳"
	quest.66087880D92A880A.quest_desc: [
		"&a马拉里特锄头&r是永恒星光模组的前期农具，使用沼泽相关生物群系中&b发现的&r马拉里特制作而成。"
		""
		"&a它&r是基础&b进阶&r阶段的一部分，用于创造农田。"
	]
	quest.66087880D92A880A.quest_subtitle: "沼泽地农业工具"
	quest.6622CB6BC38C6B1E.quest_desc: ["&aCraft&r a Neptunium Bow from Aquaculture 2. This &bpowerful&r bow is made from Neptunium, a rare &bmaterial&r obtained from fishing treasures. It is a durable &branged&r weapon and part of the Neptunium equipment set."]
	quest.6622CB6BC38C6B1E.quest_subtitle: "来自海洋宝藏的传奇武器"
	quest.663A815A2817F96D.quest_desc: ["&6经验孵化箱&r是Create: Enchantment Industry中的一个实用方块，可直接连接到流体储罐。它能让你&b储存&r自己的经验为液态经验，之后可从储罐中取回。它还具有可配置的过滤器，每次交互最多可处理&b1000&r &b经验&r值。"]
	quest.663A815A2817F96D.quest_subtitle: "将你的经验转化为资源"
	quest.666263BF5B3188ED.quest_desc: ["绿宝石附魔的下界合金能打造出在威力和稀有度上都脱颖而出的&a装备&r。这双靴子象征着对&b宝贵&r资源的进步与掌控。"]
	quest.666263BF5B3188ED.quest_subtitle: "财富就在你的脚下"
	quest.666263BF5B3188ED.title: "绿宝石下界合金靴子"
	quest.6665071920CBBC1C.quest_desc: [
		"&a获取&r一对鞘翅，这是一种长在末地船上的龙翼，能让你在空中滑翔。"
		""
		"探索末地散落岛屿的必备装备，也是 Better End 升级版 &bArmored&r 和 &bCrystalite&r 鞘翅的基础组件。"
	]
	quest.6665071920CBBC1C.quest_subtitle: "来自末地的翅膀"
	quest.6665071920CBBC1C.title: "&d鞘翅"
	quest.6667B249D5254C4D.quest_desc: ["&aObtain&r the Bloom Stone Hat from the Cataclysm: Spellbooks addon. Add this &bpowerful&r piece of equipment to your collection and continue your journey through the secrets and relics &bintroduced&r by the addon."]
	quest.6667B249D5254C4D.quest_subtitle: "源自远古石头的力量"
	quest.6677A1EA8675283A.quest_desc: ["&dIce&r Venom Vial is a crafting material in Iron's Spells 'n Spellbooks. It is refined from Icy Fangs using an Alchemist Cauldron filled with water. It is &bused&r to craft powerful &bIce-related&r equipment, including the Frostbranded Book and Boreal Blade."]
	quest.6677A1EA8675283A.quest_subtitle: "提炼冰蜘蛛的致命毒液"
	quest.667FEFEDEE689AF0.quest_desc: ["从Aquaculture 2中获取&a渔具箱&r。这个钓鱼战利品容器可以在钓鱼时找到，里面装有&b各种&r与钓鱼相关的物品，包括&b装备&r和钓鱼者有用的资源。"]
	quest.667FEFEDEE689AF0.quest_subtitle: "渔夫的工具收藏集"
	quest.6691D3606189D3DA.quest_desc: ["&a击败&r Infernal Dragon，Bosses' Rise 章节的最终首领。这场&b战斗&r将考验玩家在成长过程中获得的所有技能——战斗技巧、机动性以及极限压力下的生存能力。获胜后，玩家将获得&aOld Eye&r，这是解锁 End 维度所&b必需&r的关键物品。"]
	quest.6691D3606189D3DA.quest_subtitle: "旅程仍在继续"
	quest.6691D3606189D3DA.title: "&l&a地狱烈焰龙"
	quest.66964C84F5EE3262.quest_desc: [
		"&a寻找&r或获取锻造模板，以解锁强大的升级和盔甲修饰。"
		"这些模板是升级装备所必需的，例如将&b钻石&r装备升级为&b下界合金&r。"
	]
	quest.66964C84F5EE3262.quest_subtitle: "升级你的装备"
	quest.66964C84F5EE3262.title: "&c锻造模板&3"
	quest.66A49885BA41BD1F.quest_subtitle: "更多盔甲 (More Armor)"
	quest.66CAC564E26FBAE0.quest_desc: [
		"&e恐惧&r在能让你活下来的时候会很有用。"
		""
		"恐慌项链在受到伤害后会赋予你一阵速度加成，&b帮助&r你逃离危险的&b状况&r或快速脱离敌人的攻击范围。默认情况下，该效果持续8秒，速度等级为I。"
		""
		"当&b事情&r出错时，先跑再说，别想太多。"
	]
	quest.66CAC564E26FBAE0.quest_subtitle: "当危险来临时，立即行动起来"
	quest.66D7C5EB51D1040A.quest_subtitle: "更多盔甲 (More Armor)"
	quest.66E439CB536F5C3B.quest_desc: [
		"&bF&aT&cB &fTeams&r 允许你创建或加入&e团队，与其他玩家一起游戏。&r"
		""
		"加入团队可以共享任务进度、共同认领区块，并更轻松地管理权限。"
		""
		"你可以使用&e团队&r菜单来创建团队、邀请其他玩家或加入现有团队。"
		""
		"在继续之前，请务必组建好队伍，因为某些&6任务&r可能需要你在队伍中。"
	]
	quest.66E439CB536F5C3B.quest_subtitle: "请先阅读此内容！"
	quest.66E439CB536F5C3B.title: "&bF&aT&cB &f团队"
	quest.66F283168EBCC4B7.quest_desc: [
		"&l&9需要&r&r从箱子里拿补给，不想手动搬每一堆？Restock升级能让你的背包从箱子或桶等容器中取出&b选定&r的物品。只需配置过滤器，并与容器互动即可&b转移&r所需物品。它提供9个过滤器槽位。"
		""
		"高级补给&b升级&r更进一步，提供16个过滤槽，并能按物品、模组、标签、NBT数据和耐久度进行更精确的&b过滤&r。它还可以被配置为只提取背包中已有的物品。"
	]
	quest.66F283168EBCC4B7.quest_subtitle: "Keep your backpack stocked with everything you need"
	quest.66F283168EBCC4B7.title: "重新补给 & 高级重新补给升级"
	quest.6703AAB2A5811460.quest_desc: ["&6Build&r the Tracker Bar to bring your music rolls to life. It reads Music Rolls and uses them to play &bMIDI&r music through your pipe organ. Place it in your &bsetup&r and let your mechanical organ &bperform&r automatically."]
	quest.6703AAB2A5811460.quest_subtitle: "让音乐滚动起来"
	quest.6703DE08804ED1EA.quest_desc: [
		"&a炼金术士长袍&r是永恒星光中的一个神秘装备，与炼金术&b的进展&r相关。"
		""
		"&a它&r是炼金术士装备套装的一部分，用于增强探索或与炼金术相关的机制，具体&b因&r版本而异。"
	]
	quest.6703DE08804ED1EA.quest_subtitle: "神秘炼金术服装"
	quest.6714D962C898EF4E.quest_subtitle: "升级+"
	quest.671842F0BC20C1B4.quest_desc: [
		"&aCraft&r the Knightmetal Boots &busing&r &brefined&r Knightmetal Ingots forged from the legendary alloy of the Goblin Stronghold. Built to endure long campaigns and the harshest battlefields, these boots provide &bexceptional&r protection while allowing their wearer to confidently traverse the &bdangerous&r lands of the Twilight Forest."
		""
		"&a作为&r骑士金属盔甲套装的最后一件，它们完善了这座堡垒&b最伟大&r的守卫者曾穿戴过的装备。每一步都回响着古代骑士的传奇，证明你有资格将他们的&b力量&r带入未来的战斗中。"
	]
	quest.671842F0BC20C1B4.quest_subtitle: "迈着远古骑士般坚实的步伐前进"
	quest.67310D2BB1D9FE7B.quest_desc: [
		"Terminite 靴子需要在锻造台用 Terminite 板甲合成。"
		""
		"它们能合成 Terminite 套装，也是 Better End 的&b更高级&r盔甲的基础。"
	]
	quest.67310D2BB1D9FE7B.quest_subtitle: "第二等级的靴子"
	quest.673C7F23F4D60FAB.quest_desc: [
		"&6An&r aircraft is only as good as the machine that drives it. The Engine provides the power needed to leave the &bground&r and keep your aircraft moving through the skies."
		""
		"建造你的&b第一台&r引擎，为下一次飞行做好准备。"
	]
	quest.673C7F23F4D60FAB.quest_subtitle: "赋予你的飞行器生命的心脏。"
	quest.676799C020566A5E.quest_desc: [
		"&dPyromancer&r Leggings 是 Crystal Chronicles 对 Iron’s Spells ’n Spellbooks 中 Pyromancer Leggings 的升级版。"
		""
		"使用火山岩碎片&b升级&r，可为原有的火魔盔甲增添额外的晶体力量。火山岩碎片&b用于&r将Iron’s Spells ’n Spellbooks的火魔盔甲套装升级为增强版Crystal Chronicles。"
	]
	quest.676799C020566A5E.quest_subtitle: "由火山岩强化的火魔法师护腿的增强版"
	quest.6768A5966AF25FA9.quest_desc: ["&6从Create中获取&r纸板头盔。它是Create 6.0引入的纸板盔甲套装的一部分。头盔&b提供&r基础防护，但其真正用途是潜行：穿戴全套纸板盔甲并潜行时，你会&b伪装&r成纸板包裹，大幅缩短敌对生物能探测到你的&b距离&r。"]
	quest.6768A5966AF25FA9.quest_subtitle: "在明处隐藏自己，不被任何人察觉"
	quest.676B2B0E361D13D7.quest_desc: ["&a击败&r Bosses' Rise 模组中的 Sandworm。这个庞然大物潜伏在沙漠地下，毫无征兆地现身，&b伏击&r任何胆敢闯入其领地者。准备好与这片沙漠最强大的掠食者之一展开一场残酷的战斗&b&r。"]
	quest.676B2B0E361D13D7.quest_subtitle: "击败沙地下的那头巨兽"
	quest.676B2B0E361D13D7.title: "Sandworm"
	quest.67998704595BCC4C.quest_desc: [
		"&a获取&r塔拉西乌姆升级锻造模板，可在锻造台使用，为兼容装备应用塔拉西乌姆级别的修饰和配方。"
		""
		"它标志着 Better End 的&b装备&r进阶的第一步。"
	]
	quest.67998704595BCC4C.quest_subtitle: "正在向塔拉西姆进行升级"
	quest.67C76975FF52E2B5.quest_desc: [
		"&aThe&r Energy Sword is a special weapon from Eternal Starlight, designed as a stronger late-game combat option &bcompared&r to standard tools and weapons."
		""
		"它的刀刃&a注入了&r浓缩的维度能量，使其成为该模组进阶系统中&b较为先进&r的武器之一。"
	]
	quest.67C76975FF52E2B5.quest_subtitle: "力量凝聚于一把刀刃之中"
	quest.67C76975FF52E2B5.title: "&6能量之剑"
	quest.67D7D6884849D393.quest_desc: [
		"&aDefeating&r the Hydra rewards more than glory—it grants two of the rarest &bmaterials&r found within the Twilight Forest. Fiery Blood and Fiery Tears are infused with the immense power of the legendary beast, each &bcontaining&r a fragment of its fiery essence."
		""
		"&a这些&r非凡的&b材料&r是&b锻造&r强大装备所必需的，也是你旅途中的重要一步。借助九头蛇的残余力量，你将准备好面对在暮色森林更深处等待着的更伟大的&b危险&r。"
	]
	quest.67D7D6884849D393.quest_subtitle: "九头蛇的燃烧精华"
	quest.67D8A2586E403063.quest_subtitle: "更多盔甲 (More Armor)"
	quest.6831D45654EF4F8A.quest_desc: ["黄金能为你的盔甲带来&b独特&r的特性。这件胸甲或许会牺牲一些耐久度，但它能提供的特殊&a优势&r或许能扭转战局。"]
	quest.6831D45654EF4F8A.quest_subtitle: "以巧劲驾驭力量"
	quest.6831D45654EF4F8A.title: "黄金下界合金胸甲"
	quest.68327C24BAEA874D.quest_desc: ["&6反应堆散热口&r是Create: New Age中&b管理&r反应堆产生的热量所必需的组件。它能帮助将&b多余&r的热量排出反应堆，保持系统稳定，防止&b危险的&r过热。"]
	quest.68327C24BAEA874D.quest_subtitle: "保持反应堆在可控范围内"
	quest.68341879EEE5B467.quest_subtitle: "真美味！"
	quest.683470EE5034462E.quest_desc: [
		"Terminite Pickaxe 是一种由 Terminite Ingots 锻造的&a采矿&r工具，比 Thallasium 同类工具更坚固。"
		""
		"Terminite 是连接 &bThallasium&r 和更强大的 &bAeternium&r 及 Crystalite 等级的桥梁。"
	]
	quest.683470EE5034462E.quest_subtitle: "采矿工具，精炼版"
	quest.6840B394A4AC9936.quest_desc: [
		"&l&9背包都能代劳，何必&r&r在熔炉旁等待？Blasting 升级将熔炉的&b&r功能直接带到背包，让你能边走边处理兼容物品。"
		""
		"使用自动爆破升级，让你的背包自动处理整个&b流程&r。"
	]
	quest.6840B394A4AC9936.quest_subtitle: "走到哪里都能引爆你的矿石"
	quest.6840B394A4AC9936.title: "爆破 & 自动爆破升级"
	quest.684AF2A35919C085.quest_subtitle: "升级+"
	quest.684E81287B3674D5.quest_desc: [
		"&9&l将&r&r背包变成便携式烟熏炉。烟熏升级让你无需在世界上放置烟熏炉，就能直接在背包中使用烟熏炉的&b&r功能&r烹饪食物。"
		""
		"&bUpgrade&r it to Auto-Smoking Upgrade and let the process run automatically. Your backpack can handle the input, fuel and finished products for you, making food preparation quick and effortless &bwherever&r your adventure takes you."
	]
	quest.684E81287B3674D5.quest_subtitle: "无论走到哪里，都能享用你的货物"
	quest.684E81287B3674D5.title: "自动吸烟与手动吸烟升级组件"
	quest.6851B51C5760CDDA.quest_desc: [
		"&9&l赋予&r&r你的储物箱通过炼金术升级来处理药水的能力。这使得兼容的药水相关物品能够&b直接&r在储物箱中&b管理&r，从而更轻松地整理和自动化你的酿造材料。"
		""
		"高级炼金术&b升级&r能更好地控制药水处理和自动化，帮你更高效地管理炼金&b资源&r。"
	]
	quest.6851B51C5760CDDA.quest_subtitle: "将炼金术的力量带入你的储物空间"
	quest.6851B51C5760CDDA.title: "炼金术与高级炼金术升级"
	quest.6854B15B483321FE.quest_desc: [
		"&dWizard&r Leggings are part of the basic Wizard Armor set in Iron's Spells 'n Spellbooks. &bWhen&r equipped, they provide &b+6&r Armor, &b+125&r Max Mana and &b+5%&r Spell Power."
		""
		"使用 7 件 Arcane Cloth 制作，并&b完成&r你的 Wizard Armor 套装以增强魔法能力。"
	]
	quest.6854B15B483321FE.quest_subtitle: "将奥术之力灌注于每一步之中"
	quest.68555B3DC6690DF4.quest_desc: [
		"Deepsilver Hoe 是 Eternal Starlight 的一种&a农具&r，使用&bDeepsilver Ingots&r制作而成。"
		""
		"&a它&r用于在沼泽和暮色区域开垦农田，是一种比铁更耐用的中前期&b发展&r工具。"
	]
	quest.68555B3DC6690DF4.quest_subtitle: "沼泽地农业工具"
	quest.687E9BB952FCD233.quest_desc: [
		"&6A&r 真正的航空经典。双翼飞机速度快、体积小，专为单人飞行员设计。它的操控需要一些练习，但一旦掌握了窍门，你就会拥有一架可靠的飞机来旅行&b到&r世界各地。"
		""
		"建造你的双翼飞机，起飞并&b征服&r天空。"
	]
	quest.687E9BB952FCD233.quest_subtitle: "适合准备展翅高飞的玩家的经典飞行器。"
	quest.6883CBAE7DD14409.quest_desc: [
		"&d秘银&r编织是《Iron's Spells 'n Spellbooks》中的一种稀有合成材料。它由5个秘银锭和4个铁链&b合成&r而成。"
		""
		"这种特殊的秘银织物&b用于&r制作强大的魔法装备，包括光明使者胸甲和速度靴。"
	]
	quest.6883CBAE7DD14409.quest_subtitle: "将传奇的秘银编织成强大的装备"
	quest.6892D1939DE84589.quest_desc: [
		"使用源自哥布林堡垒古代合金的&b精炼&r骑士金属锭来&a制作&r骑士金属盾。这面盾曾是堡垒精英守卫的佩物，&b旨在&r抵御&b无情的&r猛攻，在最为激烈的战斗中保护持有者。"
		""
		"&a其&r加固的结构和卓越的&b耐用性&r使其成为探索暮色森林最危险区域的理想伙伴。无论是抵挡重击还是偏转致命投射物，骑士金属盾都象征着&b坚定不移&r的勇气与坚韧。"
	]
	quest.6892D1939DE84589.quest_subtitle: "坚定地抵抗任何敌人的攻击"
	quest.68937C93D9B55460.quest_desc: [
		"&dPaladin&r Helmet is the Crystal Chronicles &bupgraded&r version of Priest Mask from Iron’s Spells ’n Spellbooks."
		""
		"使用 Divinite Shard 进行 &b升级&r，将原本的 Priest Armor 转变为强大的 Paladin Armor 套装。Divinite Shard 将神圣魔法的力量&b注入&r头盔，创造出比原版 Priest 装备更强大的版本。"
	]
	quest.68937C93D9B55460.quest_subtitle: "由神圣能量加持的强化牧师头盔"
	quest.689C7758F5C6772E.quest_desc: ["制作下界合金盾牌，获得游戏中最强的保护。非常适合在艰难的战斗中生存。"]
	quest.689C7758F5C6772E.quest_subtitle: "终极防御！"
	quest.68AE80687FAE04F4.quest_desc: [
		"&dIcy&r Fang 是 Iron's Spells 'n Spellbooks 中的一个合成&b材料&r。它来自致命的 Ice Spider，可以加工成 Mithril Scrap。"
		""
		"&b使用&r冰牙，迈向强大的秘银&b装备&r和其他高级魔法制作。"
	]
	quest.68AE80687FAE04F4.quest_subtitle: "采集冰冻捕食者的冰冻獠牙"
	quest.68B352EF2A1FCB07.quest_desc: ["&6经验灯笼&r是Create: Enchantment Industry中的一个实用方块，它能吸收玩家和附近经验球的&b经验&r。它还能在Create装置中充当执行器，让你自动化经验&b收集&r并将其送入你的&b经验处理&r系统。"]
	quest.68B352EF2A1FCB07.quest_subtitle: "无论走到哪里，都能捕捉经验值"
	quest.68C6C3BACF4779BD.quest_desc: ["&6Obtain&r a Brass Casing from Create. &bIt&r is one of the main building blocks for advanced Create machinery and is &bused&r in components such as the Mechanical Arm, Rotation Speed Controller, Train Station, Train Signal, and Train Controls. To obtain it, apply a Brass Ingot to a Stripped Log or Stripped Wood."]
	quest.68C6C3BACF4779BD.quest_subtitle: "建造高级机械的核心部分"
	quest.68C6C3BACF4779BD.title: "黄铜外壳"
	quest.68CCBF8FE865B642.quest_desc: ["&6Craft&r the Freewheel Clutch to control the &bdirection&r of rotational power in your kinetic network. It allows rotation to pass in one direction while preventing reverse rotation from being transferred back through the system. It is &bespecially&r useful for preventing unwanted &bback-driving&r in mechanical setups. The Freewheel Clutch is part of Create: Connected."]
	quest.68CCBF8FE865B642.quest_subtitle: "保持朝一个方向持续旋转"
	quest.68D4320A3DE537A9.quest_desc: ["&6Craft&r the Water Spout Gun and &buse&r water as your ammunition. Fill the gun through a Spout, then fire streams of water at your targets. The Spout Gun is one of the weapons &badded&r by Create: Misc \\& Things, which supports different liquids as ammunition."]
	quest.68D4320A3DE537A9.quest_subtitle: "给那片水施加一点压力吧"
	quest.68DFCC2ADCE32C6B.quest_desc: ["&a获取&r鹦鹉螺壳。这个稀有的海洋物品可以通过钓鱼&b获得&r，从手持鹦鹉螺壳的溺尸身上&b掉落&r，或者向&b流浪商人&r购买。用于制作海晶灯。"]
	quest.68DFCC2ADCE32C6B.quest_subtitle: "来自海洋的稀有宝藏"
	quest.68E9562BE443782D.quest_desc: [
		"&e有些&r敌人会明白这个道理。"
		""
		"每当攻击者伤害你时，闪电吊坠有&b几率&r对其召唤一道闪电。闪电只会影响攻击者，而吊坠本身则&b保护&r你免受闪电伤害。"
		""
		"&b攻击&r我，迎接暴风雨的洗礼。"
	]
	quest.68E9562BE443782D.quest_subtitle: "让他们后悔攻击你吧"
	quest.68F63E4158025641.quest_desc: [
		"&a马拉里特&r镐是永恒星光模组的前期采矿工具，使用在该维度沼泽相关生物群系中&b获取&r的马拉里特制作而成。"
		""
		"&a它&r是基础&b进阶&r阶段的一部分，使用标准的合成台配方。"
	]
	quest.68F63E4158025641.quest_subtitle: "沼泽采矿工具"
	quest.68F6C0E3BCD500A4.quest_desc: ["&a击败&r来自Cataclysm模组的3个深海垂钓者。这些水生敌人是&b特化&r的深海生物，使用与钓鱼相关的武器进行远程攻击。它们可以在深海生物的水下&b结构&r和深海区域中找到。"]
	quest.68F6C0E3BCD500A4.quest_subtitle: "猎捕海洋中致命的渔夫"
	quest.68F6C0E3BCD500A4.title: "击杀深海垂钓者（Deeping Angler）"
	quest.6901A957458D61AD.quest_subtitle: "真美味！"
	quest.69137268E9C67BC9.quest_desc: ["&e符文石板&r是与Simply Swords古代符文相关的神秘物品。其用途与该模组的&b独特&r武器和魔法系统有关。"]
	quest.69137268E9C67BC9.quest_subtitle: "一块蕴含着神秘符文力量的古代石碑"
	quest.692378124DC9DDE3.quest_desc: ["&6Craft&r the Hohlflute pipe and expand your organ with its &bdistinctive&r flute tone. Hohlflute is one of the seven new pipe types &bintroduced&r in Create: Sound of Steam 0.8.0, alongside Prestant, English Horn, Rohrflote, Viola, Vox Celeste and the Haunted Steam Whistle."]
	quest.692378124DC9DDE3.quest_subtitle: "添加一种丰富、空灵的双簧管音色"
	quest.694923685A97BACE.quest_desc: [
		"&aThe&r Twilight Lich is one of the major bosses of the Twilight Forest, residing in a massive, corrupted tower &bfilled&r with undead magic. Once a powerful ruler, he has become a twisted sorcerer who &bcommands&r armies of skeletons and dark magic to protect his domain."
		""
		"&aDefeating&r the Lich is a major milestone in your progression through the Twilight Forest. His fight &bintroduces&r complex mechanics involving shields, magical projectiles, and summoned minions, making it a true test of &bpreparation&r and skill."
	]
	quest.694923685A97BACE.quest_subtitle: "被诅咒的死亡之塔统治者"
	quest.694923685A97BACE.title: "&e暮色巫妖"
	quest.695BBD58965B44EE.quest_desc: ["&6A&r 用于放大&b信号&r的真空管。先给加热器供电；阳极为正时，电流从阳极流向阴极，栅极&b电压&r的微小变化会引起阳极电流的巨大变化。"]
	quest.695BBD58965B44EE.quest_subtitle: "一个三极管电路"
	quest.695CB66232D20E0F.quest_desc: ["&6准备&r一杯发光浆果奶昔，并用桶装满。这种发光的变种为奶昔系列增添了魔法气息，将发光浆果的&b独特&r风味带入你的&b工厂&r食品生产中。"]
	quest.695CB66232D20E0F.quest_subtitle: "经典美食的发光新花样"
	quest.6961D7C0B301B307.quest_desc: ["&6The&r Heater &bconverts&r electrical energy into heat for your thermal systems in Create: New Age. Connect it to your electrical network and use Heat Pipes to &btransport&r the generated heat &bwhere&r it is needed."]
	quest.6961D7C0B301B307.quest_subtitle: "将电能转化为热能"
	quest.6977E75496660973.quest_desc: ["&d寒冰&r法杖是 Iron's Spells 'n Spellbooks 的魔法杖。主手持有时，提供 &b5&r 攻击力、&b1&r 攻速、&b+15%&r 冰系法术强度、&b+25%&r 法力再生和 &b+5%&r 法术强度。"]
	quest.6977E75496660973.quest_subtitle: "挥舞冰魔法的冻结之力"
	quest.698AA9335E119552.quest_desc: ["&6获取&r来自Create的曲柄。这个简单的动能&b发电机&r在手动操作时会产生旋转力。按住右键可逆时针旋转，或使用时潜行可&b反向&r旋转。曲柄的转速为&b32&r RPM，并且&b使用&r它会消耗饱食度。"]
	quest.698AA9335E119552.quest_subtitle: "用手为你的机器提供动力"
	quest.698F0C13ED7A92E1.quest_desc: [
		"The Glacite Shovel is a &adigging&r tool from Eternal Starlight crafted &busing&r Glacite Ingots."
		""
		"&a它&r用于寒冷生物群系的&b挖掘&r，比低阶工具更耐用，是中阶&b进阶&r的一部分。"
	]
	quest.698F0C13ED7A92E1.quest_subtitle: "冰冻挖掘工具"
	quest.6990F5C8EF979465.quest_desc: [
		"&e有氦气球填充的火烈鸟，还&r要翅膀干嘛？"
		""
		"氦气球火烈鸟能让你在空中游泳，提供临时飞行能力，并&b允许&r你向任何方向自由移动。但这种效果并非永久——&b8&r秒后，你需要等待&b15&r秒让火烈鸟重新充能。"
		""
		"&b抓起&r你的火烈鸟，飞向天空。"
	]
	quest.6990F5C8EF979465.quest_subtitle: "挑战重力，一次呼吸，一次挑战"
	quest.69B9100DF4B8831A.quest_desc: ["&6Craft&r the Parallel Gearbox and Vertical Parallel Gearbox to transmit &brotational&r power between parallel shafts while keeping the connected shafts rotating in the same direction. The Vertical Parallel Gearbox provides the same &bfunction&r for vertically adjacent shafts, making compact kinetic &blayouts&r easier to build in Create: Connected."]
	quest.69B9100DF4B8831A.quest_subtitle: "保持朝同一个方向持续旋转你的身体"
	quest.69B9100DF4B8831A.title: "平行齿轮箱"
	quest.69C39BE1FF3DE0A1.quest_desc: ["&6从Create模组中获取&r Crushing Wheels。它们是Millstone的更&b高级&r版本，用于通过强大的粉碎配方来&b处理&r物品。一个可用的装置需要两个Crushing Wheels，放置间隔一个方块且朝相反方向旋转。它们对于&b高级&r矿石处理和自动化&b尤为&r有用。"]
	quest.69C39BE1FF3DE0A1.quest_subtitle: "分解最坚硬的材料"
	quest.69C7DE2B7796DBD0.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.69CA0BC5F6D5D28A.quest_subtitle: "更多盔甲 (More Armor)"
	quest.69F1B3F1F1E9B771.quest_subtitle: "真美味！"
	quest.69F582287C18DE1E.quest_desc: [
		"&aCraft&r a Heavy Hook, a powerful fishing upgrade designed for anglers who seek the &bbiggest&r catches beneath the waves. Built with strength and durability in mind, this sturdy hook is prepared to handle the struggle of powerful aquatic &bcreatures&r and valuable treasures hidden in the depths."
		""
		"&aThe&r ocean is filled with &bchallenges&r that test even the most experienced fishermen. With the Heavy Hook equipped, you are ready to face stronger catches and continue your pursuit of the greatest &bsecrets&r the seas have to offer."
	]
	quest.69F582287C18DE1E.quest_subtitle: "专为承受最强拉力而建造"
	quest.69FC48647ED1F443.quest_desc: ["&6The&r Steam Engine is one of the three engines added by Create Stuff 'N Additions. It uses steam to generate rotational power, providing an alternative way to &bpower&r your Create machinery. It is part of the mod's progression toward powered &bequipment&r such as the Andesite Jetpack and Andesite Exoskeleton."]
	quest.69FC48647ED1F443.quest_subtitle: "用蒸汽为你的工厂提供动力"
	quest.6A069388E07D6A5C.quest_desc: ["&6从Create中获取&r一个Blaze Burner。将烈焰人困在空的Blaze Burner中，即可创建一个&b可用的&r热源。 &b当&r燃料充足时，它能为Basin配方提供Heated能量，而投入Blaze Cake则可将其升级为Super-Heated，解锁最复杂的加热配方。Blaze Burner还可以为Steam Engine锅炉&b提供&r热量。"]
	quest.6A069388E07D6A5C.quest_subtitle: "驾驭烈焰的力量，释放它的潜能"
	quest.6A28DAB2D8E85D0D.quest_desc: [
		"&a预言之球&r是与永恒星光中守门人之力相关的稀有物品。"
		"这不仅仅是一件收藏品——它是开启通往该维度&bportal&r的钥匙，并将你的进度与星光世界的命运紧密相连。"
		""
		"没有它，无论你怎么&a探索&r，前方的道路都依然封闭。"
	]
	quest.6A28DAB2D8E85D0D.quest_subtitle: "命运的关键"
	quest.6A28DAB2D8E85D0D.title: "&f预言&b之&9球体"
	quest.6A2EC7F1102FF295.quest_desc: [
		"&dThe&r Wandering Magician Robe is part of the basic Wandering Magician Armor set in Iron's Spells 'n Spellbooks. It provides &b+6&r Armor and &b+25&r Max Mana."
		""
		"将皮革束腰外衣与奥术精华结合即可制作。这是一件出色的前期装备，可在保持良好防护的同时获得额外的&b法力&r。"
	]
	quest.6A2EC7F1102FF295.quest_subtitle: "用游吟法师的长袍开启你的旅程"
	quest.6A3210C5212EC2F6.quest_desc: [
		"&l&9别再&r&r把捡到的东西都塞进背包了。拾取升级会根据可&b配置&r的过滤器，将拾取物直接发送到背包。它有9个过滤器槽位，用来决定要收集哪些物品。"
		""
		"&b高级&r拾取升级为你提供更强控制，拥有 &b16&r 个过滤槽，支持按物品、模组、标签、NBT 数据和耐久度进行 &b过滤&r。甚至可以配置为只拾取背包中已有的物品。"
	]
	quest.6A3210C5212EC2F6.quest_subtitle: "让你的背包替你收集战利品"
	quest.6A3210C5212EC2F6.title: "拾取物品 \& 高级拾取升级"
	quest.6A457706C53B4F21.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.6A45CC6B4F13A555.quest_desc: [
		"永恒锤是一种由永恒锭锻造而成的重型&a工具&r和武器，而永恒锭是 Better End 提供的最坚固的材料。"
		""
		"锻造永恒锭需要一块&b永恒锭砧&r，以及一把下界合金或永恒锭锻造锤。"
	]
	quest.6A45CC6B4F13A555.quest_subtitle: "最强力等级的重型工具和武器"
	quest.6A57379127505A8C.quest_desc: ["&a篮子&r是 Farmer's Delight 中&b实用&r的存储和运输物品。可用于存放和携带各种食物和&b烹饪&r食材，是农场或厨房的便捷补充。"]
	quest.6A57379127505A8C.quest_subtitle: "一个方便储存和携带食物的容器"
	quest.6A6E8447429510CB.quest_desc: [
		"&9&l将&r&r你的钻石级容器升级到下界合金级。这是最后的升级阶段，可解锁最高级别的存储&b能力&r，并完成容器的&b进阶&r过程。"
		""
		"&b升级&r你的储物空间，使用下界合金无与伦比的耐用性，打造适合最严苛存储系统的容器。"
	]
	quest.6A6E8447429510CB.quest_subtitle: "达到终极存储层级"
	quest.6A6F7996C03EADAB.quest_desc: ["&6The&r Flamethrower is a fuel-powered weapon from Create Stuff 'N Additions that lets you &bcontinuously&r spray flames in front of you. It can ignite entities and, when its flames pass over certain dropped items, can process them &busing&r Create's bulk smelting or smoking recipes. It stores up to &b1600&r units of fuel and can be refilled using furnace fuels. The Hellfire &benchantment&r changes the flames to soul fire and allows them to ignite blocks."]
	quest.6A6F7996C03EADAB.quest_subtitle: "将灼热带给你的敌人吧"
	quest.6A810716A4940BAB.quest_desc: [
		"&dGraybeard&r Staff 是 Iron's Spells 'n Spellbooks 中最早期的魔法杖之一。主手持有时，可提供 &b3&r 点攻击力、&b1&r 点攻速，以及 &b+10%&r 法术强度和 &b+25%&r 法力再生。"
		""
		"使用 1 个 Arcane Essence、1 个 Wooden Shovel 和 1 个 Iron Ingot 来 &b制作&r。它是提升法力再生和法术强度的绝佳&b前期&r法杖。"
	]
	quest.6A810716A4940BAB.quest_subtitle: "用一位老法师的法杖开启你的旅程"
	quest.6A8C5DA0C8310A31.quest_desc: [
		"&aCraft&r the Totem of Void Undying from the Void Totem mod, made from a Totem of Undying, Chorus Fruit, Eyes of Ender, and Lapis Lazuli."
		""
		"手持此物，一旦落入虚空，便能&b将你&r传送回坚实地面，使你免于&b必死&r无疑的结局。"
	]
	quest.6A8C5DA0C8310A31.quest_subtitle: "虚空之上的第二次机会"
	quest.6AA23C0F94F6F61C.quest_subtitle: "更多盔甲 (More Armor)"
	quest.6AAC2BDD100B15F0.quest_subtitle: "更多盔甲 (More Armor)"
	quest.6AD63FDA288F96BD.quest_subtitle: "更多盔甲 (More Armor)"
	quest.6ADF66F72E06AAC5.quest_desc: [
		"&d闪电&r符文是 Iron's Spells 'n Spellbooks 的配方材料，用于高级的与&b闪电&r相关的配方，包括闪电升级球。闪电学派&b使用&r闪电瓶作为其魔法焦点。"
		""
		"将1个空白符文石和8个闪电瓶组合起来，&b创造&r一个闪电符文。"
	]
	quest.6ADF66F72E06AAC5.quest_subtitle: "用浓缩的闪电魔法力量注入一块符文石"
	quest.6AFD2661BE96DC29.quest_desc: ["&a获取&r包含自我毁灭序列的「先兆者」音乐唱片，该主题与&b对抗&r先兆者&b的战役&r相关。"]
	quest.6AFD2661BE96DC29.quest_subtitle: "垂死机器最后的旋律"
	quest.6B0616C2B11B5ADD.quest_desc: [
		"&dPaladin&r Boots 是 Crystal Chronicles 对 Iron’s Spells ’n Spellbooks 中 Priest Boots 的升级版。"
		""
		"使用&bDivinite Shard&r进行升级，可将原本的牧师盔甲转化为强大的圣骑士盔甲套装。Divinite Shard将&b装备&r注入神圣魔法的力量，创造出比原版牧师装备更强大的形态。"
	]
	quest.6B0616C2B11B5ADD.quest_subtitle: "牧师靴的增强版，由神圣能量加持"
	quest.6B0BD3A2DAC12945.quest_desc: ["&a从&rBosses' Rise模组中获得龙卫盾。这面传奇盾牌由远古巨龙的&b遗骸&r锻造而成，能提供卓越的防护，象征着&b曾经统治天空的&b生物&r那&r坚定不移&b的力量。对于任何狩猎者而言，它都是一件珍贵的战利品。"]
	quest.6B0BD3A2DAC12945.quest_subtitle: "在巨龙之怒面前，屹立不倒"
	quest.6B2C9305EAE258A3.quest_desc: [
		"&dVolcanite&r Shard is a rare crafting and upgrade material from Crystal Chronicles. It is used to upgrade the Pyromancer Armor from Iron’s Spells ’n Spellbooks into its &benhanced&r Crystal Chronicles version."
		""
		"Volcanite Shard 也&b被用于&r制作 Inferno Disc，使其成为专注于火焰魔法的&b装备&r的重要材料。"
	]
	quest.6B2C9305EAE258A3.quest_subtitle: "一种能强化火魔法师装备的火山水晶碎片"
	quest.6B2FF24D4AE7FFB7.quest_desc: ["&d一种&r特殊符文，&b用于&r在 Hazen N Stuff 中制作宇宙武器和盔甲。"]
	quest.6B2FF24D4AE7FFB7.quest_subtitle: "注入了宇宙力量的符文"
	quest.6B386C4B7C12EEB4.quest_subtitle: "更多盔甲 (More Armor)"
	quest.6B418B3D591AF926.quest_subtitle: "更多盔甲 (More Armor)"
	quest.6B457385DA893C59.quest_desc: ["&6Copper&r Leggings are part of the Copper Suit from Create Stuff 'N Additions. They provide 5 armor points and &b1&r armor toughness, giving the same protection as Iron Leggings while having greater durability. They have &b225&r durability and can be repaired &busing&r Honeycombs in an Anvil. They are crafted from &b7&r Copper Ingots."]
	quest.6B457385DA893C59.quest_subtitle: "从头到脚，坚固防护，面面俱到"
	quest.6B491C5DBC046984.quest_subtitle: "更多盔甲 (More Armor)"
	quest.6B5A54DFFA845E0C.quest_subtitle: "真美味！"
	quest.6B5FA49A9541E2C7.quest_desc: [
		"&dBlood&r 升级球是 Iron's Spells 'n Spellbooks 中的一种升级材料。在 Arcane Anvil 上使用后，可获得 &b+5%&r 的血液法术强度。"
		""
		"它由1个空升级球和8个血符文制成。升级球可用于兼容的&b装备&r上，以提升其魔法威力。"
	]
	quest.6B5FA49A9541E2C7.quest_subtitle: "用血魔法的力量灌注你的装备"
	quest.6B925D25127DCB4C.quest_desc: ["&a获取&r Astrape，L_Ender’s Cataclysm 中的强力武器。Astrape 造成 10.5 点攻击伤害，使用时可投掷闪电长矛。长矛造成闪电&b伤害&r，并留下一个持续&b伤害&r附近生物的静电&b场&r。它由 2 个 Essence of the Storm 和 3 个 Lacrima 合成。"]
	quest.6B925D25127DCB4C.quest_subtitle: "召唤天地的愤怒，降下神罚"
	quest.6B925D25127DCB4C.title: "&bAstrape"
	quest.6B99A186C173FB69.quest_subtitle: "更多盔甲 (More Armor)"
	quest.6BA18CA5F164C18A.quest_desc: [
		"&dArtificer's&r Cane 是 Iron's Spells 'n Spellbooks 中一款多功能的法杖。主手持有时，可提供 &b4&r 点攻击力、&b1&r 点攻速，以及 &b+10%&r 法术强度、&b+10%&r 施法速度加成和 &b+10%&r 冷却缩减。"
		""
		"制作这件&b强大的&r神秘工具，提升你的施法速度和效率。"
	]
	quest.6BA18CA5F164C18A.quest_subtitle: "Master the art of faster and more efficient spellcasting"
	quest.6BB1BCCE91450A21.quest_desc: ["&a冲击珍珠&r是一种与&b传送&r机制相关的特殊阿基翁物品。利用它的力量，在旅途中&b穿越&r古人的世界。"]
	quest.6BB1BCCE91450A21.quest_subtitle: "冲击的回响"
	quest.6BEE4287A4B0BEB9.quest_desc: ["&dAquaflora&r is a very light blade with a pointed tip, adorned with plants and flowers. It focuses on area control and continuous damage. Its base &bmaterials&r mainly consist of plants and flowers found thr&boughout&r the Overworld."]
	quest.6BEE4287A4B0BEB9.quest_subtitle: "自然之刃"
	quest.6BEE4287A4B0BEB9.title: "&l&dAquaflora"
	quest.6BEFEB4AF8FAACEF.quest_desc: [
		"&d瘟疫&r靴子是 Iron's Spells 'n Spellbooks 中瘟疫盔甲套装的一部分。穿戴后可提供 &b+3&r 护甲、&b+125&r 最大法力、&b+10%&r 自然法术强度和 &b+5%&r 法术强度。"
		""
		"它们可以用 1 个自然符文、1 双巫师靴和 1 个奥术精华来&b制作&r或升级。"
	]
	quest.6BEFEB4AF8FAACEF.quest_subtitle: "与自然魔法的剧毒之力同行"
	quest.6BF196CC5ABD3EDA.quest_desc: ["&a寻找&r来自Cataclysm模组的远古工厂。这座深藏地下的被遗忘建筑里，有&b危险的&r机械、珍贵的宝藏和古代文明的秘密。 &b探索&r它的殿堂，准备好迎接里面强大的敌人。"]
	quest.6BF196CC5ABD3EDA.quest_subtitle: "揭开被遗忘的机械装置的面纱"
	quest.6BF196CC5ABD3EDA.title: "&l&c远古&e工厂"
	quest.6C06DA081E245BD2.quest_desc: ["&6使用黄铜外骨骼及其升级后的下界合金外骨骼，将&r你的装备提升到新高度。黄铜&b外骨骼&r能赋予你力量或速度等强力效果，而下界合金版本则作为终局升级，将这项&b技术&r推向更高峰。下界合金外骨骼于版本 2.1.4.a 被&b添加&r至 Create Stuff 'N Additions 中。"]
	quest.6C06DA081E245BD2.quest_subtitle: "将你的身体潜能发挥到极致"
	quest.6C06DA081E245BD2.title: "黄铜与下界合金外骨骼"
	quest.6C228387FFDE8B49.quest_desc: [
		"&d火枪&r是模组里最简单的火器，也是完美的入门选择。它能发射子弹，有可填充的&b修饰符&r槽位，还能教你基础操作：瞄准、开火，再装填。"
		""
		"&d点燃&r火焰以获取武器进阶。"
	]
	quest.6C228387FFDE8B49.quest_subtitle: "你的第一件火器"
	quest.6C39723DAA360E3A.quest_desc: ["&dEvery&r shot fired in the last second adds bonus &bdamage&r, so sustained fire hits harder and harder."]
	quest.6C39723DAA360E3A.quest_subtitle: "造成伤害以积累经验值"
	quest.6C3BF0CE848EB015.quest_subtitle: "真美味！"
	quest.6C612E542824BA8D.quest_desc: [
		"&a能量回旋镖&r是永恒星光中的一个远程武器，出现在该模组的进阶&b流程&r中。"
		""
		"其&a确切&r的获取方法在现有资料中并无明确记载，可能与该维度中更高级别的合成、战利品表或进度&b奖励&r有关。"
	]
	quest.6C612E542824BA8D.quest_subtitle: "不稳定的远程武器"
	quest.6C612E542824BA8D.title: "&6能量回旋镖"
	quest.6C6DB945A0BB708D.quest_desc: [
		"&d远古法典&r是 Iron's Spells 'n Spellbooks 中传说级的下界合金法术书。它提供 &b12&r 个法术槽、&b+20%&r 冷却缩减和 &b+200&r 最大法力值，是现存最强大的&b通用&r法术书之一。"
		""
		"锻造这本&b传奇&r法典，将你的施法提升至最高境界。"
	]
	quest.6C6DB945A0BB708D.quest_subtitle: "掌握古老的魔法奥秘吧"
	quest.6C7AD8E59D08C36E.quest_desc: [
		"使用&b阿尔法雪怪的&r厚皮&a制作&r雪怪靴。专为抵御冰川的恶劣&b环境&r而设计，这双结实的靴子能让穿戴者保持温暖，并在穿越冰雪的长途旅行中提供可靠的&b保护&r。"
		""
		"&aAs&r part of the Yeti Armor set, the boots complete the attire of those who have &bconquered&r the frozen wilderness. Every step is a reminder that even the endless winter could not stop your &badvance&r through the Twilight Forest."
	]
	quest.6C7AD8E59D08C36E.quest_subtitle: "在雪地上留下你的印记"
	quest.6C898FB20C5AA890.quest_desc: ["收集不同类型的鱼饵，提高钓到稀有和&b珍贵鱼类&r的几率。"]
	quest.6C898FB20C5AA890.quest_subtitle: "用合适的鱼饵吸引来更多的鱼"
	quest.6C898FB20C5AA890.title: "鱼饵"
	quest.6C90E641B6B4C233.quest_desc: [
		"钻石和下界合金的&a组合&r能打造出最高&a效&r率的工具。"
		"它们专为游戏后期的&b采矿&r、&b战斗&r和&b生存&r而设计。"
	]
	quest.6C90E641B6B4C233.quest_subtitle: "终极效率"
	quest.6C90E641B6B4C233.title: "钻石下界合金工具"
	quest.6C97B56678EF8F02.quest_subtitle: "更多盔甲 (More Armor)"
	quest.6CB208911EA0AA28.quest_desc: [
		"&d血液&r符文是 Iron's Spells 'n Spellbooks 中用于高级&b血液相关&r合成的材料，包括血液升级球。它是&b血液学派&r的符文石版本。"
		""
		"将空白符文石与8个血瓶结合，&b创造&r一个血符文。血瓶是该模组的血液焦点。"
	]
	quest.6CB208911EA0AA28.quest_subtitle: "用血魔法的黑暗力量灌注一块符文石"
	quest.6CB4F6B18847DB94.quest_desc: [
		"&eTired&r of carrying stacks of food everywhere you go?"
		""
		"这块&b奇怪的&r牛肉永远不会被吃掉。饿的时候咬一口，它总会为下一次饥饿保留着——&b不过&r两次进食之间需要等一会儿。"
		""
		"一份牛排，无限美食。"
	]
	quest.6CB4F6B18847DB94.quest_subtitle: "一份永远不会吃完的牛排"
	quest.6CC2BC62154711B8.quest_desc: ["&dA&r valuable crafting &bmaterial&r from Hazen N Stuff, used in various recipes for powerful equipment and items."]
	quest.6CC2BC62154711B8.quest_subtitle: "用于高级制作的黑暗而强大的材料"
	quest.6CFCE3D5C2FE56FB.quest_desc: [
		"&aThe&r Flowglaze Smithing Template is a smithing item in Eternal Starlight &bused&r for upgrading Flowglaze-related equipment."
		""
		"&a无法制作，&r只能在特定维度结构的宝箱中作为战利品获得。它是制作涉及Flowglaze装备的进阶配方所&b必需&r的。"
	]
	quest.6CFCE3D5C2FE56FB.quest_subtitle: "流动升级的远古残骸"
	quest.6CFCE3D5C2FE56FB.title: "&aFlowglaze 锻造模板"
	quest.6D23296A1B69D601.quest_desc: ["&6Craft&r the Neon Tube and use it as a throwable torch. Toss it into dark areas to illuminate caves and other hard-to-reach places, or use it as a simple &bdecorative&r light source for your builds. It is one of the &bmiscellaneous&r blocks added by Create: Misc \\& Things."]
	quest.6D23296A1B69D601.quest_subtitle: "用可投掷的火炬照亮前方的道路"
	quest.6D35AA41F1EDF93C.quest_desc: [
		"&dPyromancer&r Leggings 是 Iron's Spells 'n Spellbooks 中 Pyromancer Armor 套装的一部分。穿戴后可提供 &b+6&r 护甲、&b+125&r 最大法力、&b+10%&r 火焰法术强度和 &b+5%&r 法术强度。"
		""
		"它们可以用 7 个 Arcane Cloth 和 1 个 Fire Rune 来&b制作&r，或者在 Smithing Table 上用 1 个 Fire Rune 从 Wizard Leggings 升级而来。"
	]
	quest.6D35AA41F1EDF93C.quest_subtitle: "将火焰魔法的炽热力量灌注到你的盔甲中"
	quest.6D3897F037E10D8A.quest_desc: [
		"使用来自暮色森林&b冰冻&r区域的柔软北极毛皮来&a制作&r北极夹克。这件夹克经过精心缝制，既能保暖又轻便灵活，&b提供&r可靠的防护，抵御严寒和&b冰冷&r荒野中潜藏的危险。"
		""
		"&aAs&r the centerpiece of the Arctic Armor set, it is designed for &bexplorers&r who refuse to let the frozen climate halt their journey. With every layer of &benchanted&r fur, you'll be &bbetter&r prepared to survive the unforgiving lands that lead to the Twilight Forest's final challenges."
	]
	quest.6D3897F037E10D8A.quest_subtitle: "直面寒冷，无所畏惧"
	quest.6D43B733CCC136CD.quest_desc: ["&6The&r Reactor Fuel Acceptor is a &bkey&r component of the reactor system in Create: New Age. It provides a controlled way to introduce fuel into the reactor, &ballowing&r it to operate and &bgenerate&r the heat needed for nuclear power production."]
	quest.6D43B733CCC136CD.quest_subtitle: "为反应堆提供燃料"
	quest.6D5BFEC387663B94.quest_desc: [
		"&aKnightmetal&r 是一种稀有的合金，&b从&r哥布林堡垒的古老大厅中回收而来。这种非凡的金属由一个久远的文明锻造而成，兼具惊人的耐用性和锋利的刃口，是制作强大武器、坚固盔甲和专用工具的&b理想&r材料。"
		""
		"&a这种合金上仍有&r最初创造者的&b印记&r，承载着曾守护暮色森林的骑士们的传奇。掌握&b骑士金属&r是你旅途中的又一大步，能让你装备上足以匹配王国最伟大战士的武器。"
	]
	quest.6D5BFEC387663B94.quest_subtitle: "被遗忘的冠军们的金属"
	quest.6D8F9DB6E34D1401.quest_desc: ["&e在你面前&r有29套中世纪风格的盔甲，从英雄盔甲到黑暗领主盔甲。要&b领取&r它们，需要准备下界合金盔甲和月亮水晶，因为没有哪个&b配方&r能缺少它们。先从&b制作&r你的第一块水晶开始。"]
	quest.6D8F9DB6E34D1401.quest_subtitle: "蕴含传奇之魂的中世纪盔甲"
	quest.6D8F9DB6E34D1401.title: "&l&f欢迎来到&dFantasy Armor"
	quest.6D90046D7E576A03.quest_desc: ["使用Aquaculture 2制作&aNeptunium靴子&r。这双强大的靴子由Neptunium制成，这是一种通过钓鱼宝藏获得的稀有&b材料&r。它能提供强大的&b防护&r，是Neptunium盔甲套装的一部分。"]
	quest.6D90046D7E576A03.quest_subtitle: "用海洋宝藏锻造的盔甲"
	quest.6D99EAA99DE859AB.quest_desc: ["&6特斯拉线圈是 Create Crafts \& Additions 的&r一种&b高级&r电气机器。它使用 Forge 能量为兼容的电气物品充电，还能用电击伤害&b玩家&r和生物。在 NeoForge 1.21.1 的 1.6.0 版本中，特斯拉线圈在激活时会发出光，并且在能量即将耗尽时能&b正确地&r报告剩余运行时间。"]
	quest.6D99EAA99DE859AB.quest_subtitle: "用惊人的力量进行充能"
	quest.6DCA252DF7E9A442.quest_desc: [
		"&6每列&r火车都需要合适的登车方式。台阶能为入口提供紧凑而&b实用&r的阶梯，而安山岩、铜和黄铜变种则能匹配火车的风格。"
		""
		"&b收集&r所有三种变体，为火车门画上点睛之笔。"
	]
	quest.6DCA252DF7E9A442.quest_subtitle: "一小步，一大步。带来巨大的改变。"
	quest.6DED96BA9D01194D.quest_desc: ["&6Obtain&r both a Cogwheel and a Large Cogwheel from Create. Cogwheels transfer rotational force &bbetween&r mechanical components, while combining a small and large cogwheel allows you to change rotational speed. A small cogwheel spins twice as fast when &bpowered&r by a large one, while the large cogwheel &brotates&r at half the speed."]
	quest.6DED96BA9D01194D.quest_subtitle: "掌握机械动力的齿轮奥秘"
	quest.6DED96BA9D01194D.title: "齿轮组件"
	quest.6E06C9D850E82200.quest_desc: [
		"&l&9通过泵升级，赋予&r&r你的储物箱处理流体的能力。它能让流体在储物箱和&b相连的&r流体系统之间转移，让自动化流体管理变得更容易。"
		""
		"高级水泵升级扩展了这些功能，提供了更精确的流体传输和过滤选项。经验水泵升级更进一步，让你的存储系统能够&b处理&r经验，并在需要时进行传输。"
	]
	quest.6E06C9D850E82200.quest_subtitle: "掌握流体的流动，体验其中的乐趣"
	quest.6E06C9D850E82200.title: "水泵，高级水泵 & 经验水泵升级"
	quest.6E08CDB6F8B04B85.quest_desc: [
		"&e为何&r要满足于普通的奖励？"
		""
		"黄金钩&b能将生物掉落的经验值&r提高75%，让每场战斗都更有回报。对于那些想从敌人身上榨取全部经验的&b冒险者&r来说，这是一个简单的道具。"
		""
		"&b更多&r击杀。更多经验。更强力量。"
	]
	quest.6E08CDB6F8B04B85.quest_subtitle: "将每一次击杀都转化为更多的经验值"
	quest.6E18CA1095B24FC2.quest_desc: ["&6A&r 双芯电缆，让连接变得更简单。两端可接普通终端和大多数消费设备。用 Cord Junction 将其分叉，并通过插座连接到单个 &bwires&r。"]
	quest.6E18CA1095B24FC2.quest_subtitle: "一根双芯电缆"
	quest.6E20EEF9FF78206E.quest_desc: ["&d一种&r特殊的合成&b材料&r，专用于在 Hazen N Stuff 中合成神圣物品。"]
	quest.6E20EEF9FF78206E.quest_subtitle: "用于制作神圣物品的稀有材料"
	quest.6E2E1132DC61E5F7.quest_desc: [
		"&d大&r召唤师护身符可授予&b+15%&r召唤伤害，使你的召唤生物在战斗中更&b强力&r。它还能防止召唤法术在召唤物自然消失后进入冷却。"
		""
		"&b升级&r你的召唤魔法，让你的召唤盟友随时准备战斗。"
	]
	quest.6E2E1132DC61E5F7.quest_subtitle: "增强你的召唤物，让它们持续战斗"
	quest.6E2F60D8F1FD2ACB.quest_desc: ["&dFrostbound&r 是一把看起来由冰制成的闪亮镰刀。它&b专为&r区域控制和均衡伤害而设计。"]
	quest.6E2F60D8F1FD2ACB.quest_subtitle: "永恒寒冰之刃"
	quest.6E2F60D8F1FD2ACB.title: "&l&b霜冻束缚"
	quest.6E3796A9DA8F05DC.quest_desc: [
		"&6一列好火车&r，不能只有&b机车&r和车厢。扶手不仅方便上下车和走动，还有不同的&b材质&r，能搭配你的建筑风格。"
		""
		"&b收集&r安山岩、黄铜和铜这三种变体，为您的火车画上点睛之笔。"
	]
	quest.6E3796A9DA8F05DC.quest_subtitle: "抓紧了，让每一列火车都充满完整感。"
	quest.6E4806E64F05905B.quest_desc: ["&6The&r Fan Component is a module for the Brass Drone from Create Stuff 'N Additions. Install it on a Brass Drone to give the drone an &badditional&r movement capability. It is one of the drone modules &bintroduced&r alongside the Brass Drone, including the Drill Head and Vault Component."]
	quest.6E4806E64F05905B.quest_subtitle: "给你的无人机加点升力吧"
	quest.6E537C91E3C6460F.quest_desc: [
		"&e岩浆&r不一定要成为道路的终点。"
		""
		"Strider Shoes 能让你在潜行时&b站立&r在岩浆上，从而穿过下界湖泊和岩浆池而不会掉入。它们还能&b保护&r你免受高温地板的伤害，例如岩浆块的伤害。"
		""
		"&b小心&r脚下。岩浆可拦不住你。"
	]
	quest.6E537C91E3C6460F.quest_subtitle: "行走在他人会燃烧的地方"
	quest.6E544C273282B915.title: "&l&9九头蛇"
	quest.6E5852928DBF6ED0.quest_desc: [
		"&aUnderminer&r 是 Eternal Starlight 的一种专用采矿工具。"
		"它被列为一件专用的挖掘/采矿物品，&b用于&r资源采集和高级地下探索。"
		""
		"具体的&a获取方式&r取决于模组内的进度或战利品来源。"
	]
	quest.6E5852928DBF6ED0.quest_subtitle: "深层采矿工具"
	quest.6E5852928DBF6ED0.title: "&6Underminer"
	quest.6E780ADB22239DF7.quest_desc: [
		"永恒锭护腿可通过在锻造台用&a永恒锭&r锻造板升级泰拉尼亚护腿获得。"
		""
		"它们能完成 Better End 的最高防御套装，专为最&b危险&r的遭遇而设计。"
	]
	quest.6E780ADB22239DF7.quest_subtitle: "最高阶的护腿装备"
	quest.6E7E02CF0565B384.quest_subtitle: "更多盔甲 (More Armor)"
	quest.6E98A4FCE3F28956.quest_desc: [
		"&d召唤之书&r是一本充满强大召唤魔法的独特魔典。它&b预先刻有&r爪击6、爪盾4和召唤恼鬼4。装备后，可提供&b+10%&r的召唤法术强度和&b+200&r的最大法力值。"
		""
		"这本&b稀有的&r魔典可以从Evoker或Archevoker那里&b获得&r。挥舞它，将Evoker的魔法反作用于你的敌人。"
	]
	quest.6E98A4FCE3F28956.quest_subtitle: "驾驭唤魔者的魔法力量"
	quest.6E9CB152EA753392.quest_desc: [
		"&a探索&r下界并找到一个堡垒遗迹。"
		"这些危险的建筑里充满了猪灵、&b贵重战利品&r和&b古代宝藏&r。"
	]
	quest.6E9CB152EA753392.quest_subtitle: "找到猪灵堡垒"
	quest.6E9CB152EA753392.title: "&6堡垒遗迹 &e残骸"
	quest.6E9CF42B911A11A4.quest_desc: ["从Cataclysm模组中&a获取&r远古遗迹音乐唱片。这张&b稀有&r的音乐唱片是与远古遗迹——被诅咒金字塔的古代守护者——&b相关&r的独特奖杯。找回这首被遗忘的&b旋律&r，以证明你击败了沙漠中最伟大的威胁之一。"]
	quest.6E9CF42B911A11A4.quest_subtitle: "遗失在沙海深处的旋律"
	quest.6EA3D5EB506CCEE7.quest_desc: [
		"建造大型建筑会花费大量时间。"
		"建造棒能让你一次性放置多个方块，让建筑变得更快更简单。"
	]
	quest.6EA3D5EB506CCEE7.quest_subtitle: "建造速度提升模组（Build Faster）"
	quest.6EA3D5EB506CCEE7.title: "建筑之杖 Construction Stick"
	quest.6EA9C38625CAF4F1.quest_desc: [
		"&a烈焰粉&r由烈焰棒合成，是许多酿造&b配方&r的重要材料。"
		"它还用于为末影之眼提供能量，对于定位要塞和推进到末地至关重要。"
		"这种炽热的材料是掌握炼金术和次元旅行的关键&b步骤&r。"
	]
	quest.6EA9C38625CAF4F1.quest_subtitle: "精炼火焰精华"
	quest.6EA9C38625CAF4F1.title: "烈焰粉"
	quest.6EBEDBDF59557AFC.quest_desc: ["&d一个&r能将&b你的最大生命值&r提升5%的特殊球体。"]
	quest.6EBEDBDF59557AFC.quest_subtitle: "一个能提升你生命力的球体"
	quest.6EC27F73D3545810.quest_desc: ["&d移除了&r射击时把你向后推的&b后坐力&r。"]
	quest.6EC27F73D3545810.quest_subtitle: "尽情享受这强劲的一击吧"
	quest.6EE1AB3433F08DC3.quest_subtitle: "升级+"
	quest.6EE20B8BEC38306A.quest_desc: ["&6Craft&r the Mending Rune, a useful item from Create: Misc \\& Things. Use it to repair items that have the Mending enchantment by consuming &bexperience&r from your XP bar. The rune also has its own &bdurability&r system in newer versions."]
	quest.6EE20B8BEC38306A.quest_subtitle: "修复你的附魔装备"
	quest.6EF082D1D7EC1E95.quest_subtitle: "真美味！"
	quest.6EF8ED1E090A2BDF.quest_desc: ["&a击败&r来自Cataclysm模组的Aptrgangr。这个强大的不死&b首领&r位于Frosted Prison，会使用毁灭性的&b近战&r攻击。准备好迎接这场与冰冻堡垒中&b最强大&r敌人之一的艰难战斗吧。"]
	quest.6EF8ED1E090A2BDF.quest_subtitle: "击败冰冻监狱的亡灵守护者"
	quest.6EF8ED1E090A2BDF.title: "Aptrgangr"
	quest.6EFF8F38EF2E56D8.quest_desc: [
		"&l&9既然可以创造无尽供给，&r&r何必满足于普通储物？生存无尽&b&r升级&b能让你将储物中的物品设为无限，从而&r提取它们而不会消耗存量。"
		""
		"对于那些已完成存储之旅并希望最重要的&b资源&r永不枯竭的人来说，这是一个强大的升级。"
	]
	quest.6EFF8F38EF2E56D8.quest_subtitle: "让您的最宝贵资源永远持续下去"
	quest.6F02A015F77B10ED.quest_desc: ["&dHemalite&r 碎片是《水晶编年史》中的一种稀有合成材料。它可用于制作 Sanguine Edge，以及通过升级 Cultist Armor 来制作 Hermomancer Armor 套装。该碎片蕴含着血魔法的力量，是制作&b含血&r装备的必需材料。"]
	quest.6F02A015F77B10ED.quest_subtitle: "一种用于锻造强大血晶装备的含血水晶"
	quest.6F0B2EE489B2B350.quest_desc: ["&6从Create模组中获取&r脉冲延长器。它能将红石脉冲延长一段&b可配置&r的时间，使短暂信号保持激活，从而控制机器和其他自动化系统。其持续时间可从&b2&r刻调整至最长&b60&r分钟，并且可以&b反向&r，使其默认保持供电，并产生临时关闭脉冲。"]
	quest.6F0B2EE489B2B350.quest_subtitle: "保持信号持续有效"
	quest.6F1A91F90359AAFB.quest_desc: ["&6机械滚轮&r是一种用于清理和铺平道路的机械装置。它有三种模式：清理和铺路，可破坏&b合适的&r方块并用筛选后的方块替换；直接填充下方，可填充正下方的空间；以及斜坡填充下方，可创建斜坡填充。使用筛选器来&b选择&r滚轮放置的方块。当&b机械装置&r朝滚轮方向水平移动时，它便会工作。"]
	quest.6F1A91F90359AAFB.quest_subtitle: "建造前方的道路"
	quest.6F1C1671731B5F06.quest_desc: [
		"晶化鞘翅是通过在&a灌注基座&r周围使用鞘翅、琥珀宝石、附魔膜和晶化碎片进行灌注仪式制作的。"
		""
		"穿戴完整的晶岩套装，除了本身的护甲加成外，还能永久获得&b再生 I&r。"
	]
	quest.6F1C1671731B5F06.quest_subtitle: "由灌注而生的翅膀"
	quest.6F1C1671731B5F06.title: "&d水晶翼膜 Elytra"
	quest.6F232A26F0E2E273.quest_desc: ["&a从&rCataclysm模组中获得一个黑钢锭。这种珍贵材料&b用于&r制作强大的武器、盔甲和装备。它可以从Cataclysm的&b建筑&r和&b击败的&r敌人掉落物中获得。"]
	quest.6F232A26F0E2E273.quest_subtitle: "来自冰冻深处的稀有金属"
	quest.6F232A26F0E2E273.title: "&9黑钢锭"
	quest.6F2A4EEABC255FE4.quest_subtitle: "真美味！"
	quest.6F2D5D53FB939012.quest_desc: ["&d用于在 Hazen N Stuff 中升级宇宙装备的&r特殊球体&b&r。"]
	quest.6F2D5D53FB939012.quest_subtitle: "一颗注入了宇宙力量的球体"
	quest.6F2DEF08095B724C.quest_desc: ["&aThe&r Naga is the first major boss of the Twilight Forest and the guardian of the ancient Naga Courtyard. Defeating it marks the beginning of your journey through the dimension and unlocks the path to greater challenges. Though it may seem simple &bcompared&r to the foes ahead, underestimating the Naga can quickly lead to defeat."]
	quest.6F2DEF08095B724C.quest_subtitle: "暮色森林的守护者"
	quest.6F2DEF08095B724C.title: "&2Naga"
	quest.6F3FA05F0085411B.quest_desc: ["&6铜磁铁&r是一种实用物品和黄铜无人机模块。手持时，它会缓慢吸引半径4格内的附近&b实体&r。安装在黄铜无人机上后，可通过&b使用&r无人机控制器来切换。激活后，无人机会吸引附近的方块、掉落物品和实体，而&b收集&r的掉落物品会储存在无人机内部。"]
	quest.6F3FA05F0085411B.quest_subtitle: "把所有东西都拉近一点"
	quest.6F439DAAF72A973C.quest_desc: [
		"&aFlowglaze Pickaxe&r 是 Eternal Starlight 的一种采矿工具，属于 Flowglaze &b进阶&r阶段。"
		""
		"&a它&r使用Flowglaze的&b材料&r制作，属于该模组的中后期装备系统。"
	]
	quest.6F439DAAF72A973C.quest_subtitle: "流动锻造采矿工具"
	quest.6F458F89F0C7BEB5.quest_desc: ["&6从Create模组中获取&r一个智能观察者。它能检测容器中的特定物品或流体，也能检测其正前方&b放置&r的匹配方块。当过滤条件满足时，它会发出红石信号，适用于&b自动化&r分类、处理和机器控制。它还可以&b连接到&r显示链接，以显示所观察内容的信息。"]
	quest.6F458F89F0C7BEB5.quest_subtitle: "注意你工厂里的物品内容"
	quest.6F4A0425C3870A4F.quest_desc: [
		"制作铁木锄头和铁木铲子，&a完成&r你的铁木工具收藏。这些工具由融入了暮色森林魔法的铁木锭锻造而成，在完成日常任务时更加快捷高效，同时&b保持&r附魔装备应有的耐用性。"
		""
		"&aWhether&r cultivating farmland or clearing paths through dirt, sand, and gravel, these tools are essential companions for every adventurer &bexploring&r the Twilight Forest."
	]
	quest.6F4A0425C3870A4F.quest_subtitle: "用附魔的技艺来准备这片土地"
	quest.6F4A0425C3870A4F.title: "铁木实用工具包"
	quest.6F8761D2F89F0372.quest_subtitle: "更多盔甲 (More Armor)"
	quest.6F9A5E6C090459E7.quest_desc: ["&6Build&r the Spud Sentry, a new defensive contraption added to Create: Dreams n' Desires. Put this &bpotato-powered&r sentry to work and give your factory an unusual way to deal with unwanted visitors. The Spud Sentry was &badded&r in Create: Dreams n' Desires 2.3a-BETA for Minecraft 1.21.1."]
	quest.6F9A5E6C090459E7.quest_subtitle: "用土豆来保卫你的工厂"
	quest.6FAEB69D37596618.quest_desc: ["&6从Create模组中获取&r一个矿车组装器。将其&b放置在&r轨道上并用红石供电，它可以将方块组装成一个移动的矿车装置。使用合适的轨道设置时，它还能拆解该装置，&b让你&r能够建造移动农场、机器、存储系统以及其他&b移动的&r创造物。"]
	quest.6FAEB69D37596618.quest_subtitle: "让你的机器动起来，踏上征程"
	quest.6FB249CCB42D948B.quest_subtitle: "升级+"
	quest.6FBA5E25FD297832.quest_desc: ["&6A&r 显示模块的插槽：将模块拖入空槽，按 Shift + 点击可移除。长按插槽可更改模块显示内容，用扳手切换空白页，用&b染料&r更改颜色。"]
	quest.6FBA5E25FD297832.quest_subtitle: "一个模块化的展示台"
	quest.6FC589CAD68D5F0C.quest_subtitle: "更多盔甲 (More Armor)"
	quest.6FD28B9BF9E8CCDA.quest_desc: ["在 Create: Confectionery 中，将糖和水加热混合，&6制作&r圣诞拐杖糖。这种节日美食可以&b恢复&r饥饿，并提供短暂的加速效果。"]
	quest.6FD28B9BF9E8CCDA.quest_subtitle: "一部温馨的圣诞经典之作"
	quest.6FD3DE97948FF9A0.quest_desc: [
		"有时你需要在已建成的结构中更改方块。"
		"替换模板让你的建造棒能将现有方块替换为新方块，让重建和升级建筑变得更容易。"
		""
		"使用此升级，快速修改你的建筑，而无需先破坏一切。"
	]
	quest.6FD3DE97948FF9A0.quest_subtitle: "轻松替换方块"
	quest.6FD79C1CA4E34567.quest_subtitle: "更多盔甲 (More Armor)"
	quest.6FDDB5076535054F.quest_desc: [
		"&a炼金术工作台&r能让你用神秘的方法创造出不同方块的各种装饰性变种。"
		"尝试不同材料，为你的建筑探索新风格。"
	]
	quest.6FDDB5076535054F.quest_subtitle: "将你的材料进行转化"
	quest.6FF58118772764FE.quest_desc: ["使用 Bosses' Rise 模组制作&a龙骨腿甲&r。由远古巨龙的骸骨&b锻造&r而成，这套传奇腿甲能提供强大的防护，象征着&b曾翱翔天际的&b生物&r所具有的&r坚韧不拔。它们是龙骨盔甲套装的重要组成部分。"]
	quest.6FF58118772764FE.quest_subtitle: "承载远古巨龙的力量，勇往直前"
	quest.7015C0190516B308.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.7026127DAD76EB74.quest_desc: [
		"&e被击中&r有时在所难免。重要的是能否挺过下一次攻击。"
		""
		"十字项链&b会&r延长你受击后获得的短暂无敌时间，让你在被再次伤害前多出一小段时间。默认情况下，它会增加20个游戏刻——即1秒的&b额外&r无敌时间。"
		""
		"当危险降临时，让&b每&r一刻的防护都发挥作用。"
	]
	quest.7026127DAD76EB74.quest_subtitle: "每一次攻击都至关重要的第二次机会"
	quest.702BD2FE9B17086C.quest_desc: [
		"&a探索&r铋矿层，这是 Crystal Chronicles 在末地中添加的一个生物群系。"
		""
		"你可以在这里收集 &b铋&r 来建造传送门框架，然后用铋凿组装后，就能开启通往与魔法学派相关的广阔 &b地下&r 维度的道路。"
	]
	quest.702BD2FE9B17086C.quest_subtitle: "魔法学派起源之处"
	quest.702BD2FE9B17086C.title: "铋矿脉 (Bismuth Formations)"
	quest.70427EAC20FC848B.quest_desc: [
		"在永恒的星光笼罩的诡异&a土地&r上，猎手们追捕一切会动的东西。"
		"它们速度快、好斗且穷追不舍——一旦&b发现&r你，逃跑就&a变得&r困难。"
		""
		"学会与它们战斗，是&b生存&r于这个危险维度深处探索的必备条件。"
	]
	quest.70427EAC20FC848B.quest_subtitle: "不懈的追逐"
	quest.70427EAC20FC848B.title: "Seeker"
	quest.7056B4CA80E9CA75.quest_desc: [
		"&a获得&r幻影膜，由幻影掉落。"
		""
		"除了修复鞘翅，它还是通过灌注仪式制作更佳末地维度&b附魔膜&r的基础材料。"
	]
	quest.7056B4CA80E9CA75.quest_subtitle: "坠落幻象的翅膀碎片"
	quest.705A370ACF2D3F25.quest_desc: ["使用Cataclysm模组的材料，&a制作&rIgnitium护腿。由&b传奇的&rIgnitium金属锻造而成，提供超强防护，象征着下界火焰的力量。它们是源自&b火焰领主&r力量的&b完整&rIgnitium盔甲套装的重要组成部分。"]
	quest.705A370ACF2D3F25.quest_subtitle: "永恒炼狱的盔甲"
	quest.7066AD43EB0ADC06.quest_desc: [
		"&9&lStay&r&r informed about your Refined Storage autocrafting jobs with the Autocrafting Monitor. It displays active crafting requests and their progress, &ballowing&r you to quickly see what your network is currently producing."
		""
		"&b使用&r它来监控复杂的合成&b过程&r，并保持自动化生产的可控性。"
	]
	quest.7066AD43EB0ADC06.quest_subtitle: "追踪每一个自动化合成任务的状态"
	quest.7070E5B28A04197E.quest_desc: ["&aCraft&r Cursium Leggings from the Cataclysm mod. These &bpowerful&r leggings are created by upgrading Netherite Leggings with a Cursium Upgrade Smithing Template and a Cursium Ingot in a Smithing Table. They are &bpart&r of the Cursium armor set and grant the Ethereal Form ability, giving a chance to dodge &bincoming&r attacks."]
	quest.7070E5B28A04197E.quest_subtitle: "被诅咒的战士的盔甲"
	quest.70763861AE1AC983.quest_desc: ["&6The&r Reactor Rod is a core component of the reactor system in Create: New Age. &bIt&r plays an &bessential&r role in the reactor's operation, working together with the fuel and heat-management components to generate the intense heat needed for &badvanced&r power production."]
	quest.70763861AE1AC983.quest_subtitle: "驾驭反应堆的核心能量"
	quest.7083BF753227DE31.quest_desc: ["&6欢迎来到&r《创造：自动扶梯》！利用功能性、&b旋转驱动的&r走道和扶梯，在工厂中时尚地移动。建造你自己的&b垂直&r交通系统，让在工厂中&b穿行&r变得更快捷便利。《创造：自动扶梯》添加了两种材质的&b走道&r和扶梯，由《创造》的旋转力驱动。"]
	quest.7083BF753227DE31.quest_subtitle: "将你的工厂带上一个新高度"
	quest.7083BF753227DE31.title: "&l&6欢迎来到 Create Escalated 整合包"
	quest.708A96BAB4E8D0ED.quest_desc: ["&6The&r Slime Helmet is part of the slime equipment from Create Stuff 'N Additions. It is &bdesigned&r to work together with the Slime Boots, &bgiving&r you a bouncy and safer way to move around. The helmet also has a special interaction with Elytra: it can prevent Elytra durability damage. The mod &bspecifically&r fixed the Slime Helmet's functionality in the 1.21.1 version."]
	quest.708A96BAB4E8D0ED.quest_subtitle: "在不破坏方块的情况下进行弹跳"
	quest.70976C640A457C6E.quest_desc: ["&6Prepare&r a Strawberry Milkshake and fill a bucket with it. Add this sweet and &brefreshing&r drink to your growing &bcollection&r of milkshake recipes from Create: Dreams n' Desires."]
	quest.70976C640A457C6E.quest_subtitle: "把工厂装饰得更温馨一点"
	quest.70A005B30CBCEB48.quest_desc: ["&aThe&r Netherite Grappling Hook is the &bhighest-tier&r version of the grappling hook. Use it to move &befficiently&r through the world and overcome &bhard-to-reach&r areas."]
	quest.70A005B30CBCEB48.quest_subtitle: "下界应有的强大力量"
	quest.70A2C0FAD2525DC3.quest_desc: [
		"&a获得&r一套完整的锁链甲，一套由&b相互交锁&r的铁环锻造而成的稀有盔甲。与大多数盔甲不同，锁链甲通常无法合成，因此每一件都是通过探索、战斗或交易获得的&b宝贵&r奖励。"
		""
		"&a尽管比实心&r&b板甲&r更轻，锁子甲能提供可靠的防护，是&b经验丰富的&r冒险者的象征。完成全套装备，证明你愿意走出工作台，去探寻更远处的&b宝藏&r。"
	]
	quest.70A2C0FAD2525DC3.quest_subtitle: "由铁锻造而成的防护之力"
	quest.70A2C0FAD2525DC3.title: "锁链甲护具"
	quest.70AC11285D941F01.quest_desc: ["&6The&r Zinc Chestplate is part of the Zinc Suit &badded&r by Create Stuff 'N Additions. It provides an &balternative&r set of armor made from Zinc and has &b320&r durability. Craft it using &b8&r Zinc Ingots."]
	quest.70AC11285D941F01.quest_subtitle: "比看起来要强大得多"
	quest.70BA04BBF382CAE6.quest_desc: [
		"&dThe&r Blaze Instruction Manual is a rare spellbook associated with the Fire school in Iron's Spells 'n Spellbooks. It provides &b10&r spell slots, &b+10%&r Fire Spell Power and &b+200&r Max Mana, making it an excellent choice for a mage &bspecializing&r in fire magic. It is a rare drop from Blazes."
		""
		"&b装备&r手册，在携带更多法力储备的同时释放更强大的火焰法术。"
	]
	quest.70BA04BBF382CAE6.quest_subtitle: "掌握火焰的毁灭性力量"
	quest.70BBFCA56B2B7A3B.quest_desc: [
		"泰拉修姆锭（或铁锭）与末地粉尘结合，在&a末地石熔炉&r中锻造出泰拉修姆锭。"
		""
		"它偶尔也能在 Better End 结构中寻获，用于制作&b更强大&r的工具、盔甲和铁砧。"
	]
	quest.70BBFCA56B2B7A3B.quest_subtitle: "第二等级的金属"
	quest.70C45779F8D6D4C2.quest_desc: ["&d一种&r能&b强化&r邪灵武器和护甲的特殊球体。"]
	quest.70C45779F8D6D4C2.quest_subtitle: "一个能强化邪典力量的球体"
	quest.70C963CA48DC1406.quest_desc: [
		"&l&9再&r&r也不用每次想做东西都找工作台了。Crafting Upgrade 模组将&b内置&r的合成网格直接添加到你的背包中，让你无论走到哪里都能随时合成。"
		""
		"The &bcrafting&r grid keeps its items even when the backpack is closed and supports recipe filling through JEI, REI and EMI."
	]
	quest.70C963CA48DC1406.quest_subtitle: "一个可以随身携带的合成台"
	quest.70CC95DB7E5F0ACB.quest_desc: [
		"&a探索&r灯笼森林，一片充满活力的森林，树上挂着像发光&b灯笼&r一样的花朵，在空中飘荡。"
		""
		"柔和的光线使其成为末地中最受欢迎的生物群系之一——一个安全收集&b资源&r的好地方。"
	]
	quest.70CC95DB7E5F0ACB.quest_subtitle: "发光灯笼的森林"
	quest.70CC95DB7E5F0ACB.title: "灯笼森林"
	quest.70CF4CD3D8FE3489.quest_desc: ["&6机械&r活塞&b利用&r旋转动力来伸缩活塞延伸杆，从而推动创造装置。活塞的&b伸出&r长度取决于所连接的延伸杆数量，而非&b每次&r仅移动一个方块。用史莱姆球可将其&b制成&r粘性机械活塞，使其在收回时能将推动的方块拉回。"]
	quest.70CF4CD3D8FE3489.quest_subtitle: "再往前推进一步"
	quest.70CF4CD3D8FE3489.title: "机械活塞 \& 粘性机械活塞"
	quest.70EFEC783ADBE394.quest_subtitle: "更多盔甲 (More Armor)"
	quest.70F0656B6D0E98EE.quest_subtitle: "真美味！"
	quest.70F0A7670BA3DF20.quest_desc: ["&6A&r 用于电路的空白板。用创造锯切割木板即可。"]
	quest.70F0A7670BA3DF20.quest_subtitle: "一个空白的电路"
	quest.7114C6B3463D3C25.quest_subtitle: "升级+"
	quest.71216CD0DAB58DCB.quest_subtitle: "升级+"
	quest.712C7D49715DBF88.quest_desc: ["&l&9无需&r&r随身携带采石机。采石机升级模组将一台功能齐全的采石机&b&r直接添加到你的背包中，让你无需在工作台放置工作台即可处理方块。它还会&b&r记住你上一次的配方，并在你&b&r插入相同方块时自动再次选择，使重复的采石过程快得多。"]
	quest.712C7D49715DBF88.quest_subtitle: "无论走到哪里，都带上精准的石匠技艺"
	quest.71312A25176585F6.quest_desc: [
		"&9&lAs&r&r your collection continues to grow, a 16k Storage Disk gives your Refined Storage network the capacity it needs. With &bsignificantly&r more storage than the smaller tiers, it allows you to keep a huge amount of resources in a single digital storage system."
		""
		"&b插入&r到磁盘驱动器中，继续建造以获得更大的存储容量。"
	]
	quest.71312A25176585F6.quest_subtitle: "将你的数字存储提升到新的高度"
	quest.7149C97501E38AF7.quest_subtitle: "更多盔甲 (More Armor)"
	quest.714A619197D756CD.quest_desc: ["&aCraft&r the Mechanical Fusion Anvil from L_Ender’s Cataclysm. This powerful &bcrafting&r station combines high-tier weapons, armor, and rare &bmaterials&r to create upgraded equipment. &bIts&r recipe requires 6 Witherite Ingots, 2 Blocks of Redstone, and an Anvil."]
	quest.714A619197D756CD.quest_subtitle: "锻造古代机器的武器"
	quest.714A619197D756CD.title: "&c机械融合砧板"
	quest.716CE65977CDDAD9.quest_desc: [
		"使用在暮色森林中发现的附魔钢叶材料来&a制作&r钢叶头盔。这顶头盔由古老森林魔法强化的树叶锻造而成，在体现自然与工艺之间&b和谐&r的同时，提供了可靠的保护。"
		""
		"&aAs&r part of the Steeleaf Armor set, it offers an excellent balance of durability and defense, making it an ideal choice for adventurers preparing to &bexplore&r the deeper regions of the Twilight Forest."
	]
	quest.716CE65977CDDAD9.quest_subtitle: "一顶由附魔树叶制成的王冠"
	quest.717404B34A4CA9E5.quest_subtitle: "真美味！"
	quest.71824AC78C66F629.quest_desc: ["&dHogskin&r 是 Iron's Spells 'n Spellbooks 中的一种合成材料，由 Hoglin 掉落。它可&b用&r来合成魔法&b物品&r，也可以被制成皮革。"]
	quest.71824AC78C66F629.quest_subtitle: "收集下界野性巨兽的皮毛"
	quest.7184322815D40F10.quest_desc: [
		"&a在&r宏伟的极光&b宫殿&r之巅，终焉女王静候着。她是冰封之地的末代君主，亦是暮色森林最强大的统治者之一。被活冰与&b远古&r魔法环绕，她掌控着凛冬的怒火，拒绝任何人窥探其领地之外&b隐藏&r的秘密。"
		""
		"&a雪后&r是空中格斗的&b大师&r，她会切换多个阶段，召唤漂浮的冰盾，向敌人降下致命的冰锥，并释放出&b毁灭性&r的&b冰冻&r魔法。只有能适应战斗每个阶段的人才能取得胜利。"
		""
		"&a击败&r雪女王，标志着&b暮色森林最伟大的冒险之一&r的完成。随着永恒的冬季终于被打破，通往魔法世界最深奥秘的&b道路&r现已向你敞开。"
	]
	quest.7184322815D40F10.quest_subtitle: "终结这永恒的严冬吧"
	quest.7184322815D40F10.title: "&l&b雪&9女王"
	quest.71C599C45F9993E4.quest_desc: [
		"&9&lThe&r&r Oak Barrel is a basic storage &bcontainer&r from Sophisticated Storage, offering a compact way to &borganize&r and store your items."
		""
		"&bThanks&r to the mod's upgrade system, the barrel can be expanded with additional storage capacity and &bspecialized&r upgrades, making it a versatile part of any storage setup."
	]
	quest.71C599C45F9993E4.quest_subtitle: "可扩展的紧凑型存储空间"
	quest.71DB07520840057B.quest_desc: ["&6用于&r延长和分叉铜缆。将其放置在需要分叉或延长的位置。"]
	quest.71DB07520840057B.quest_subtitle: "延长并分叉电线"
	quest.71F4EDD39B779AF9.quest_desc: ["&d为每发子弹添加&r额外的&b弹丸&r，将任何枪械变为散射武器。每发弹丸造成的&b伤害&r较低，因此近距离作战效果更佳。"]
	quest.71F4EDD39B779AF9.quest_subtitle: "许多子弹，一枪解决"
	quest.71F98F53EE7BC8A4.quest_desc: ["&dA&r special crafting template used to create Flaming &bequipment&r in Hazen N Stuff."]
	quest.71F98F53EE7BC8A4.quest_subtitle: "用于强力合成的火焰模板"
	quest.71FD40B986C9AF50.quest_desc: ["&6Copper&r Wire is a basic electrical component from Create Crafts \\& Additions. It is produced using the Rolling Mill and is used to craft &belectrical&r components and connections. It forms one of the first &bsteps&r toward building your electrical network and &bconnecting&r machines that use Forge Energy."]
	quest.71FD40B986C9AF50.quest_subtitle: "将电力输送到你的工厂中"
	quest.722217A507114210.quest_desc: ["&6制作&r洒水器，让你的作物茁壮成长。当用&b稀释的骨粉&r浇灌时，它能在&b5×5&r的区域内加速植物生长，非常适合紧凑型自动化农场。洒水器在 Create: Misc \& Things 4.0 中&b引入&r。"]
	quest.722217A507114210.quest_subtitle: "保持你的作物持续生长"
	quest.723C50A0AF1A155C.quest_desc: ["&e是时候&r告别地面了！齿轮翅膀让你&b飞&r上天空，开启全新的移动方式。探索这些机械翅膀的工作原理，用它们从&b全新&r的角度探索世界。天空由你征服！"]
	quest.723C50A0AF1A155C.quest_subtitle: "翱翔天际"
	quest.724D1288AD744051.quest_desc: [
		"The Thermal Springstone Hammer is a &aheavy&r impact weapon from Eternal Starlight crafted &busing&r Thermal Springstone Ingots."
		""
		"&a它&r能缓慢而有力地挥出重击，击退效果显著，适合中阶战斗中的群体控制&b进阶&r。"
	]
	quest.724D1288AD744051.quest_subtitle: "地热冲击武器"
	quest.724FD4C593826FE9.quest_desc: [
		"&d棱镜&r骑士头盔是棱镜骑士盔甲套装的一部分，该套装是《水晶编年史》中最强的盔甲套装。"
		""
		"It is crafted &busing&r a Divine Soulshard from Iron’s Spells ’n Spellbooks and can be created by &bupgrading&r the helmet from any enhanced Crystal Chronicles armor set. The Prismatic Knight Armor &brepresents&r the final and most powerful stage of the Crystal Chronicles armor progression."
	]
	quest.724FD4C593826FE9.quest_subtitle: "由水晶编年史的力量锻造而成的终极头盔"
	quest.7252812119B93C29.quest_desc: [
		"&aThe Cinderous Soulcaller&r 是来自 Iron’s Spells ‘n Spellbooks 深处的强大魔法敌人。"
		"这个敌人同时操控火焰和灵魂，能释放出&b危险&r的攻击，既能灼烧你，又能吸取你的生命精华。"
		"击败它需要强大的魔法抗性和小心的移动，因为它的能力会压倒未准备好的&b冒险者&r。"
	]
	quest.7252812119B93C29.quest_subtitle: "火焰与灵魂交织缠绕"
	quest.7252812119B93C29.title: "&6辛德&e罗斯 &7灵魂召唤者"
	quest.7256C1684DCFEE60.quest_desc: ["&eNaturalist&r 为我的世界带来了各种动物，让生物群系感觉&b更&r生动多样。探索&b新&r物种，观察它们的行为，探索野生动物世界。"]
	quest.7256C1684DCFEE60.quest_subtitle: "探索野生动物世界"
	quest.7256C1684DCFEE60.title: "&f&l欢迎，&a博物学家"
	quest.7258712F5D2D8539.quest_subtitle: "更多盔甲 (More Armor)"
	quest.7261635BE6E853F7.quest_desc: [
		"&a制作&r三箭弓，一把用暮色森林魔法锻造的、经过精湛&b附魔&r的武器。与普通弓不同，每次射击都会同时释放三支箭，让你能以&b毁灭性&r的箭雨压倒敌人，同时保持惊人的准确性。"
		""
		"&a备受&r技艺精湛的弓箭手和&b传奇&r猎人的青睐，三弓在对付各类怪物和强大首领时都表现出色。其独特的&b附魔&r能将单支箭变为致命的箭雨，证明了&b精准&r与压倒性的火力可以完美融合。"
	]
	quest.7261635BE6E853F7.quest_subtitle: "一箭三雕，一石三鸟"
	quest.7262CBE4093FBD31.quest_desc: ["从Cataclysm模组中&a获取&rIgnis音乐唱片。这张稀有的&b音乐&r唱片是强大&b统治者&rIgnis在灼热竞技场中掉落的专属奖杯。找回这首炽热的旋律，以证明你战胜了地狱最伟大的冠军之一。&b胜利&r的证明。"]
	quest.7262CBE4093FBD31.quest_subtitle: "火焰之主回响的余音"
	quest.7268819963CA1643.quest_subtitle: "更多盔甲 (More Armor)"
	quest.727317B8BF1A8C21.quest_desc: [
		"&a隐藏在&r炽热的火焰沼泽中的，是暮色森林中最可怕的生物之一——九头蛇。这个巨大的多头巨兽统治着焦灼的&b沼泽地&r已有数个世纪，&b将&r任何胆敢挑战它的家伙都化为灰烬。"
		""
		"&aEach&r of the Hydra's heads is capable of &bunleashing&r devastating attacks, from torrents of fire to powerful bites that can crush even the strongest warriors. As the battle progresses, the beast becomes even more dangerous, forcing you to stay alert and adapt to its &brelentless&r assault."
		""
		"&a击败&r九头蛇是你冒险中&b标志性的&r时刻。除了证明你的实力，它还会让你获得宝贵宝藏，并助你更接近揭开暮色森林最深层的&b秘密&r。"
	]
	quest.727317B8BF1A8C21.quest_subtitle: "击败火焰沼泽的巨兽"
	quest.727317B8BF1A8C21.title: "&9&l九头蛇"
	quest.727A8816DF2E0057.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.727BB2535A4613E5.quest_desc: ["从 Cataclysm: Spellbooks 扩展包中获取&a&rBloom Stone Skirt。将这件强大的装备加入你的收藏，继续探索该扩展包引入的&b秘密&r和&b遗迹&r。"]
	quest.727BB2535A4613E5.quest_subtitle: "源自远古石头的力量"
	quest.727FBC47B6C610E7.quest_desc: ["&6经验铲子&r是 Create Stuff 'N Additions 模组中的一种特殊铲子。挖掘方块时，它有几率&b生成&r一个经验球，让你在&b收集&r资源的同时获得额外的经验值。它的耐久度为 270，挖掘等级为铁，造成 4 点攻击伤害，攻速为 1.7。它的制作配方是&b使用&r3 堆经验和 2 个锌制工具柄。"]
	quest.727FBC47B6C610E7.quest_subtitle: "挖掘你的道路，获得更多经验"
	quest.7282EA488D3599CE.quest_desc: ["&6The&r Copper Chestplate is part of the Copper Suit from Create Stuff 'N Additions. It provides &b6&r armor points and &b1&r armor toughness, matching the protection of an Iron Chestplate while offering higher durability. The chestplate has &b240&r durability and can be &brepaired&r with Honeycombs in an Anvil. It is crafted from &b8&r Copper Ingots."]
	quest.7282EA488D3599CE.quest_subtitle: "可靠的保护，由铜提供动力"
	quest.728C59A3A21CEDFE.quest_desc: ["&6欢迎来到&r Create: Connected! 本扩展包为 Create 添加了提升生活品质的方块和技术组件，&b旨在&r让你的工厂更加灵活。探索新的离合器、变速箱、红石组件、可旋转的储物箱和储罐，以及对现有 Create 机制的&b增强&r功能。"]
	quest.728C59A3A21CEDFE.quest_subtitle: "以前所未有的方式连接你的工厂"
	quest.728C59A3A21CEDFE.title: "&l&6欢迎来到 Create Connected 整合包"
	quest.729E05B09A10784F.quest_desc: [
		"&9&l你的&r&r流体网络在扩展，你的&b存储&r容量也应随之增长。256B流体存储磁盘提供&b海量&r的数字流体存储，让你的精炼存储网络能容纳比64B层级多得多的液体。"
		""
		"将其插入磁盘驱动器，并继续&b扩展&r你的集中式流体存储系统。"
	]
	quest.729E05B09A10784F.quest_subtitle: "将你的流体存储容量扩大到惊人的规模"
	quest.72B645B303EDCEAF.quest_subtitle: "更多盔甲 (More Armor)"
	quest.72D1FBC4D676696D.quest_desc: [
		"&d普通&r墨水是 Iron's Spells 'n Spellbooks 中最基础的魔法墨水。它用于卷轴锻造台来创造普通稀有度的卷轴，是&b新手&r施法者&b必不可少&r的资源。"
		""
		"在魔法结构中寻找，或从强大的魔法生物处获取，然后用它来开始构建你的法术&b收藏&r。"
	]
	quest.72D1FBC4D676696D.quest_subtitle: "掌握魔法的第一步就是从这里开始"
	quest.72D4315ABFB04B00.quest_desc: [
		"&9&l借助调节器升级，&r&r掌控物品在精炼存储网络中的分配。它能帮助您在相连的容器中维持所选物品的&b设定&r数量，&b在需要时&r自动补充或移除资源。"
		""
		"&b使用&r它来保持机器库存、维持精确的物品水平并创建&b可靠的&r自动化生产系统。"
	]
	quest.72D4315ABFB04B00.quest_subtitle: "保持你的自动化存储系统完美平衡"
	quest.72D51A00E1D552EA.quest_desc: [
		"&a获取&r泰拉纳升级锻造模板，用于锻造台为兼容的工具和盔甲应用泰拉纳级别的升级。"
		""
		"Terminite 位于 &bThallasium&r 和 &bAeternium&r 之间，由 Thallasium 锭和末地尘埃锻造而成。"
	]
	quest.72D51A00E1D552EA.quest_subtitle: "正在向泰拉尼亚终极形态升级"
	quest.72E28BC9EFD626FD.quest_desc: [
		"&aFlowglaze 护盾&r是 Eternal Starlight 的防御物品，属于 Flowglaze &b装备&r系列。"
		""
		"&a它&r用于阻挡即将到来的伤害，是中后期 Flowglaze &b进阶&r系统的一部分。"
	]
	quest.72E28BC9EFD626FD.quest_subtitle: "流动防御装备"
	quest.72F735CEFAEFB084.quest_desc: ["&6Craft&r the Ruby Chocolate Bucket and store liquid Ruby Chocolate for your confectionery factory. Use it to transport and handle ruby chocolate in automated &bproduction&r lines alongside the other chocolate varieties from Create: Confectionery. Ruby chocolate is known for its naturally pink &bcolour&r and fruity, slightly sour flavour."]
	quest.72F735CEFAEFB084.quest_subtitle: "随身携带一份鲜活的甜蜜，走到哪里都充满乐趣"
	quest.72F9FD1FB4160E14.quest_desc: ["使用Cataclysm模组的材料，&a制作&rIgnitium头盔。这款头盔由&b传奇的&rIgnitium金属锻造而成，能&b借助&r下界永恒火焰的力量来保护佩戴者。它是源自火焰之主残骸的&bIgnitium&r盔甲套装的重要组成部分。"]
	quest.72F9FD1FB4160E14.quest_subtitle: "地狱战士的皇冠"
	quest.72FB636CAA9777CD.quest_desc: [
		"&l&9Why&r&r carry a heavy anvil &bwhen&r your backpack can do the job? The Anvil Upgrade adds full anvil functionality directly to your backpack, allowing you to repair, rename and combine items without placing an anvil in the world."
		""
		"保持装备处于最佳&b状况&r，随时随地快速修复。"
	]
	quest.72FB636CAA9777CD.quest_subtitle: "带上砧板，去任何冒险能带你的地方"
	quest.72FC9FCB998D4D92.quest_desc: ["&a寻找&r来自Cataclysm模组的燃烧竞技场。这座隐藏在末地深处的巨型堡垒，是&b地狱&r中最强大战士之一Ignis的领地。在进入前做好准备，只有&b最强大&r的冒险者才能幸存于其炽热的殿堂。"]
	quest.72FC9FCB998D4D92.quest_subtitle: "寻找火焰之主的王座"
	quest.72FC9FCB998D4D92.title: "&l&6燃烧的&3竞技场"
	quest.730AEE092EF6ACE0.quest_desc: [
		"制作一个&a相机支架&r，将相机固定住，以获得精准稳定的拍摄效果。"
		"&b使用&r它来拍摄细节照片，无需担心移动相机。"
	]
	quest.730AEE092EF6ACE0.quest_subtitle: "让你的射击更稳定一些"
	quest.7325805123A3A0A0.quest_desc: [
		"&d末影&r符文是 Iron's Spells 'n Spellbooks 的配方材料，&b用于&r高级的与&b末影相关的&r配方，包括末影升级球。末影学派使用末影珍珠作为其魔法焦点。"
		""
		"将1个空白符文石和8个末影珍珠结合，&b创造&r一个末影符文。"
	]
	quest.7325805123A3A0A0.quest_subtitle: "用末地的神秘力量灌注一块符文石"
	quest.7326A1D524CC68F0.quest_desc: [
		"&9&l用中继器扩展&r&r你的精炼存储网络。它能让你连接和延伸网络到更远的地方，帮助你&b触达&r更远处的设备和存储&b&r系统。"
		""
		"&bUse&r the Relay to create a more flexible network layout and connect distant &bparts&r of your automated storage system."
	]
	quest.7326A1D524CC68F0.quest_subtitle: "将网络延伸至电缆无法触及的地方"
	quest.7337E3FD3B967AF3.quest_subtitle: "真美味！"
	quest.733A8E5ACBBCCACD.quest_desc: [
		"&6将&r飞行控制提升至新高度，配备电子飞行显示屏。电子陀螺仪可提供更佳的&b稳定性&r，完全消除风力影响，同时其HUD会让您随时了解飞行速度、俯仰角及潜在警告。"
		""
		"&b安装&r它，起飞并保持每个重要细节都在掌控之中。"
	]
	quest.733A8E5ACBBCCACD.quest_subtitle: "精准的飞行数据，尽在眼前。"
	quest.7351860AE2725AD2.quest_subtitle: "更多盔甲 (More Armor)"
	quest.7358802FCC5E65C9.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.73614AFF4C52DABE.quest_desc: [
		"&9&lReach&r&r the highest level of Fortune with the Fortune III Upgrade. It provides Fortune III to compatible operations, giving you the greatest &bchance&r of obtaining &badditional&r resources from supported blocks."
		""
		"&b装备&r带有最高幸运值的&b自动化&r系统，让每次采矿都收益最大化。"
	]
	quest.73614AFF4C52DABE.quest_subtitle: "最大化每次采矿作业的产出量"
	quest.7378F112C09BB03F.quest_desc: ["&6A&r Contactor 的缩小版。当输入设定的 &bvoltage&r 时，它会切换常开端子，使较弱信号也能控制另一个电路。"]
	quest.7378F112C09BB03F.quest_subtitle: "一个中继器"
	quest.737EB4074AEB68A2.quest_subtitle: "更多盔甲 (More Armor)"
	quest.738623F2EBA30C3C.quest_desc: ["&6The&r Omni Gearbox is a versatile mechanical component added by Create: Dreams n' Desires. It expands your factory's rotational &bsetups&r by providing a flexible way to connect and redirect mechanical power. &bUse&r it to create more compact and versatile kinetic networks. The Omni Gearbox was &badded&r in the 2.2a-BETA update for Minecraft 1.21–1.21.1."]
	quest.738623F2EBA30C3C.quest_subtitle: "从各个方向连接旋转部分"
	quest.73904E581F79BC87.quest_desc: ["深入洞穴或山脉，寻找闪闪发光的紫水晶碎片。这些晶体以其魔法能量而闻名，可用于&a制作强大的物品&r。"]
	quest.73904E581F79BC87.quest_subtitle: "挖掘一个碎片（Shard）"
	quest.73904E581F79BC87.title: "紫水晶碎片"
	quest.73B9CB51E29B93C1.quest_subtitle: "更多盔甲 (More Armor)"
	quest.73C49BF00B7BF875.quest_subtitle: "真美味！"
	quest.73C4B1140491C2EF.quest_desc: [
		"&d《死灵之书》&r是一本由亡者之王掉落的独特魔法书。它预先刻有血刃5、血步5、虹吸射线5和烈焰风暴5。当&b作为魔法书&r装备时，还能使&b“复活死者”&r提升2级，并&b使最大法力值&r提升200点。"
		""
		"挥舞这本&b禁忌&r魔典，驾驭强大的血魔法，同时指挥亡灵。"
	]
	quest.73C4B1140491C2EF.quest_subtitle: "驾驭死者的禁忌力量"
	quest.73D726572EA95ACF.quest_desc: ["&aCraft&r a Black Steel Shovel from the Cataclysm mod. This powerful tool is made using Black Steel and provides high &bdurability&r and &befficiency&r for digging. It is part of the Black Steel equipment set."]
	quest.73D726572EA95ACF.quest_subtitle: "由黑钢锻造而成的一件工具"
	quest.73EDF585EE03CE80.quest_subtitle: "更多盔甲 (More Armor)"
	quest.73F194B01A86C9E1.quest_desc: ["&6Gold&r Wire is an electrical crafting component from Create Crafts \\& Additions. It is produced using the Rolling Mill by &bprocessing&r a Gold Sheet, yielding 2 Gold Wires. It is used in electrical components such as the Gold Spool and can also be used as an alternative to &bElectrum&r Wire in certain recipes."]
	quest.73F194B01A86C9E1.quest_subtitle: "精准地传导电流"
	quest.74218BCBDC5E5E3D.quest_desc: ["&aThe fusion&r of diamond and Netherite results in extremely powerful gear. These boots provide top-tier &bprotection&r and &bdurability&r for the most &adangerous&r challenges."]
	quest.74218BCBDC5E5E3D.quest_subtitle: "不匹配的耐久度"
	quest.74218BCBDC5E5E3D.title: "钻石下界合金靴子"
	quest.743E85C4F3586BBD.quest_desc: [
		"&a星焰&r镐是永恒星光中来自星焰&b进阶&r系统的高级挖掘工具。"
		""
		"&a它&r是使用锻造机制和模组后期内容引入的进阶&b材料&r制作的。"
	]
	quest.743E85C4F3586BBD.quest_subtitle: "火焰采矿！！！"
	quest.74482378B1AB4B4B.quest_desc: ["&6A&r 灯泡灯座：装上灯泡并接好电线，就能把&b电&r转换成光。"]
	quest.74482378B1AB4B4B.quest_subtitle: "一个灯泡灯座"
	quest.744B6FFA4DA83F7E.quest_desc: [
		"&6一&r次好的起飞是每次成功飞行开始的关键。改进的起落架能提高飞机的起飞速度，&b帮助&r你更快地升空，让旅程有个更平稳的开端。"
		""
		"&b升级&r你的起落架，自信地离开地面。"
	]
	quest.744B6FFA4DA83F7E.quest_subtitle: "更快地离开地面。"
	quest.746BB4F2E115CFEF.quest_desc: ["制作一个&a合成&r台，将资源组合成新的物品和工具。这个重要的合成中心能帮助你扩展合成技巧，为更深入的&b探索&r做好准备。"]
	quest.746BB4F2E115CFEF.quest_subtitle: "用你收集的资源来制作物品和工具"
	quest.746BB4F2E115CFEF.title: "&#A56701合成台"
	quest.747470136FC85059.quest_desc: ["使用 Bosses' Rise 模组制作&a龙骨胸甲&r。由远古巨龙的骸骨锻造而成，这件&b传奇&r的盔甲能提供强大的防护，并承载着曾一度主宰天空的&b生物&r的力量。唯有真正的屠龙者才能&b获得&r如此圣物。"]
	quest.747470136FC85059.quest_subtitle: "由巨龙骸骨雕刻而成的盔甲"
	quest.7476E50E470DE285.quest_desc: [
		"一些高级工具可以使用能量代替耐久度。"
		"电池模板能让你的建造棒在操作时储存和使用能量。"
		""
		"有了这个升级，你的建筑工具就能使用储存的电力，让大型项目更高效。"
	]
	quest.7476E50E470DE285.quest_subtitle: "为你的工具注入能量"
	quest.7489E6B88FAFF41B.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.748C7C56B1BB12F6.quest_desc: ["&a获取&r一个海之心。这种稀有的海洋宝藏可以在埋藏的宝箱中找到。它被&b用来&r制作导管，这是一种强大的水下装置，在&b探索&r海洋时能提供特殊效果。"]
	quest.748C7C56B1BB12F6.quest_subtitle: "隐藏在波涛之下的宝藏"
	quest.748FEE4E7397ED70.quest_subtitle: "更多盔甲 (More Armor)"
	quest.7494DD3B639CE1B7.title: "&6&l远古的&e遗迹"
	quest.74998A2B2A9AC311.quest_desc: ["&6A&r wire made of iron. It is also an ingredient in &blight&r bulbs and Resistive Coils, so make a stock of it."]
	quest.74998A2B2A9AC311.quest_subtitle: "由铁制成的电线"
	quest.74BD3FC9D5E94739.quest_desc: ["&6The&r Handheld Drill is a portable tool from Create: Dreams n' Desires that brings mechanical drilling into your hands. Use it for convenient material &bprocessing&r and construction work around your factory without &bneeding&r a stationary drill setup."]
	quest.74BD3FC9D5E94739.quest_subtitle: "没有机器就进行钻孔作业"
	quest.74C3C62A7CE9ECCC.quest_subtitle: "更多盔甲 (More Armor)"
	quest.74D4FA49F6DF2E75.quest_subtitle: "更多盔甲 (More Armor)"
	quest.74FD5CCA87553E9B.quest_subtitle: "真美味！"
	quest.7502E77917078A8E.quest_subtitle: "真美味！"
	quest.750475178F4B4473.quest_desc: [
		"使用遍布暮色森林的附魔钢叶材料来&a制作&r钢叶剑。这把武器融合了古老森林的魔法，在力量与耐久度之间取得了绝佳的&b平衡&r，是探索危险地牢、对抗森林生物时的可靠伙伴。"
		""
		"&aAs&r one of the signature weapons of the Steeleaf equipment set, it is an important step toward conquering the many &bchallenges&r hidden within the Twilight Forest."
	]
	quest.750475178F4B4473.quest_subtitle: "一片被古老森林祝福的刀刃"
	quest.750789BAB1BA2BBF.quest_subtitle: "更多盔甲 (More Armor)"
	quest.750CFECC6F6EFD90.quest_desc: ["&aCraft&r the Pharaoh's Sacred Headdress from the Cataclysm: Spellbooks addon. This mystical headpiece is part of the Pharaoh Wizard Armor set, &binspired&r by the Ancient Remnant and the forgotten rulers of the desert. It &benhances&r Sand magic and unlocks the full potential of the Pharaoh's equipment."]
	quest.750CFECC6F6EFD90.quest_subtitle: "戴上古代法老的皇冠吧"
	quest.752115DA021966D7.quest_desc: ["&6赋予&r你的糖果一丝奢华。将250 mB的Ruby Chocolate注入Caramel Bar、Chocolate Bar或Dark Chocolate Bar即可&b创造&rRuby Chocolate Candy。每颗糖果可恢复&b8&r饥饿值和&b11&r饱食度，同时红宝石巧克力会赋予Saturation效果持续&b2&r秒。"]
	quest.752115DA021966D7.quest_subtitle: "A delicate candy infused with exotic ruby chocolate."
	quest.752F4E175B03C0E2.quest_desc: ["从 Create 模组中获取&6纸板胸甲&r。它是纸板盔甲套装的一部分，胸甲提供 &b1&r 点护甲值和 64 点耐久度。穿戴全套并潜行时，你会伪装成一个纸板包裹，大幅缩短敌对生物能&b探测&r到你的&b距离&r。"]
	quest.752F4E175B03C0E2.quest_subtitle: "与货物合二为一"
	quest.753108DAB5FE74E0.quest_desc: [
		"&eEnder&r Pearls are useful, but constantly losing them can get expensive."
		""
		"Warp Drive &b改变了&r你的使用方式。末影珍珠在传送时不会被消耗，也不再造成常规的传送伤害。取而代之的是，每次&b使用&r都会消耗一些饥饿值。"
		""
		"&b旅行&r得更远。保管好你的珍珠。"
	]
	quest.753108DAB5FE74E0.quest_subtitle: "传送时不会丢失你的珍珠物品"
	quest.7536A8395948FB54.quest_subtitle: "升级+"
	quest.753B6220292D7FD7.quest_subtitle: "真美味！"
	quest.755FD1E86B82449C.quest_desc: ["&a绿宝石&r是财富的象征，但与下界合金结合后，它们便拥有了更非凡的意义。这种材料既代表了&b力量&r，也代表了稀有性。"]
	quest.755FD1E86B82449C.quest_subtitle: "财富与力量在此交汇"
	quest.755FD1E86B82449C.title: "绿宝石下界合金锭"
	quest.75681D5874E356F0.quest_desc: ["&e欢迎来到&rSimply Swords，一个为Minecraft添加了各种各样的&b独特&r刀剑和武器的模组。探索新的战斗风格、强大的能力和武器，&b旨在&r让战斗更&b刺激&r和多样化。"]
	quest.75681D5874E356F0.quest_subtitle: "用强大的新武器来扩充你的武器库！"
	quest.75681D5874E356F0.title: "&f&l欢迎来到 &bSimply Swords"
	quest.756AA2DCD82FDA21.quest_desc: [
		"Terminite Leggings 需要用 Terminite Plating 在锻造台（Smithing Table）上制作。"
		""
		"与套装的其他部分一样，它们之后可以升级为 &bCrystalite&r 或 &bAeternium&r 盔甲。"
	]
	quest.756AA2DCD82FDA21.quest_subtitle: "第二等级的护腿装备"
	quest.756B5163BBD5B247.quest_desc: ["学习如何制作木制盾牌，保护自己免受即将到来的攻击。"]
	quest.756B5163BBD5B247.quest_subtitle: "制作你的第一个盾牌来保护自己！"
	quest.75731E4E0D6C19C9.quest_subtitle: "更多盔甲 (More Armor)"
	quest.75779455A76440DA.quest_desc: ["从Aquaculture 2中获取&aNeptunium Ingot&r。这种稀有材料可通过钓取&b宝藏&r获得，并&b用于&r制作强大的钓鱼装备，包括Neptunium工具、盔甲和高级钓鱼物品。"]
	quest.75779455A76440DA.quest_subtitle: "来自海洋的稀有金属"
	quest.7580842FDD09E35C.quest_desc: ["从 L_Ender’s Cataclysm 中获取&a&rLaser Gatling。这把强大的远程武器发射与 The Harbinger 相关的同种毁灭性激光&b&r。该&b武器&r使用红石作为&b弹药&r，开火时可点燃方块。"]
	quest.7580842FDD09E35C.quest_subtitle: "释放先知的致命火力"
	quest.7580842FDD09E35C.title: "&c激光加特林枪"
	quest.75974D41A214001A.quest_desc: [
		"&aThe&r Glacite Leggings are cold-resistant armor from Eternal Starlight crafted &busing&r Glacite materials."
		""
		"冰川盔甲能减缓受冰冻效果影响的&a敌人&r的攻击速度，并在严寒环境中提供更高的&b防护&r。"
	]
	quest.75974D41A214001A.quest_subtitle: "冰冻腿部盔甲"
	quest.75A696A9CED7243E.quest_desc: ["&a击败&r 3 远古守卫者。这些强大的&b水下&r生物栖息于海洋遗迹中，负责抵御入侵者。它们会施加&b挖掘&r疲劳效果，并掉落湿海绵、&b海晶灯&r材料以及鱼类等珍贵物品。"]
	quest.75A696A9CED7243E.quest_subtitle: "征服海洋神殿的守卫者"
	quest.75A696A9CED7243E.title: "击杀远古守卫者"
	quest.75B529873E7CAB78.quest_desc: ["&aObtain&r the Bloom Stone Chestplate and Bloom Stone Pauldrons from the Cataclysm: Spellbooks addon. Add both pieces of Bloom Stone equipment to your &bcollection&r and &bcontinue&r your &bjourney&r through the powerful relics of the addon."]
	quest.75B529873E7CAB78.quest_subtitle: "远古石头的盔甲套装"
	quest.75CA1FD77FBC5D6E.quest_desc: [
		"在永恒星光这片&b神秘&r的土地上，孤星&a骷髅&r在微弱的天光下徘徊。"
		"这些敌对生物会从远处发起攻击，能迅速压倒毫无防备的探险者。"
		""
		"击败它们是证明你能够在这个奇异的新维度中生存下来的关键步&b骤&r。"
	]
	quest.75CA1FD77FBC5D6E.quest_subtitle: "星光下的阴影"
	quest.75CA1FD77FBC5D6E.title: "LoneStar 骷髅"
	quest.75CA3A5B4CC0F125.quest_desc: [
		"&a制作&r一套完整的皮革盔甲，开启你作为真正冒险家的旅程。这种由牲畜和野生动物&b收集&r的皮革制成的轻便盔甲，在提供基本保护的同时，能让你&b完全&r自由地行动。"
		""
		"&aAlthough&r simple in design, Leather Armor is often the first step toward &bsurviving&r the &bdangers&r of the world. Every great hero begins somewhere, and this humble set marks the start of your adventure, &bpreparing&r you for the stronger equipment and greater challenges that lie ahead."
	]
	quest.75CA3A5B4CC0F125.quest_subtitle: "你的第一道防线"
	quest.75CA3A5B4CC0F125.title: "皮革盔甲"
	quest.75D1344390F6374D.quest_desc: ["&6Ruby&r Chocolate is already a rare treat, but why stop at a single bite? Wrap six Ruby Chocolate Bars in paper to create a Full Ruby Chocolate Bar. It can be &benjoyed&r up to 16 times, making &bevery&r bite a little sweeter."]
	quest.75D1344390F6374D.quest_subtitle: "一块奢华的红宝石巧克力，经久耐放。"
	quest.75ED5EE9E0A7FC3C.quest_desc: ["&6Craft&r the Fan Freezing Catalyst and use it with an Encased Fan to perform bulk freezing. The catalyst gives the fan's &bairflow&r a freezing effect without &brequiring&r a separate powdered snow setup. It was added to Create: Connected 0.8.0 for compatibility with Create: Garnished and Create: Dreams \\& Desires."]
	quest.75ED5EE9E0A7FC3C.quest_subtitle: "在寒冷的空气中冻结身体，感受刺骨的寒意"
	quest.75EFD84AC15FE957.quest_desc: [
		"&dVenomous&r Crusader Boots are the Crystal Chronicles upgraded version of Plagued Boots from Iron’s Spells ’n Spellbooks."
		""
		"使用Floralite Shard进行&b升级&r，将原本的Plagued Armor转化为强大的Venomous Crusader Armor套装。Floralite Shard为装备注入了自然魔法的力量，增强了原盔甲的毒性和&b瘟疫相关的&r能力。"
	]
	quest.75EFD84AC15FE957.quest_subtitle: "由Floralite强化的瘟疫靴的增强形态"
	quest.75F60AC23BFF24B4.quest_desc: ["&6Mines&r with the strength of a diamond. Powered by a Portable Battery it mines faster the longer you use it and uses no durability, only battery &benergy&r. An integrated circuit &bboosts&r it for a limited number of uses."]
	quest.75F60AC23BFF24B4.quest_subtitle: "手持式电钻"
	quest.75F84157D0F8BC1A.quest_desc: [
		"&aCraft&r a Gold Fillet Knife, an elegant tool &bfavored&r by anglers who appreciate both style and precision. While gold may not be the toughest material, its exceptional craftsmanship allows for swift and &befficient&r preparation of even the finest catches."
		""
		"&aWhether&r you're processing &bcommon&r fish or rare aquatic treasures, the Gold Fillet Knife proves that true mastery isn't measured only by strength, but also by finesse. A worthy addition to the toolkit of any &bdedicated&r fisherman."
	]
	quest.75F84157D0F8BC1A.quest_subtitle: "奢华与精密的完美结合"
	quest.760CC342A5EB4846.quest_subtitle: "真美味！"
	quest.760D1C0CD7518BCE.quest_desc: ["&6Craft&r the Trompette pipe and &badd&r a bold, powerful &breed&r voice to your pipe organ. Trompette is one of the reed pipes in Create: Sound of Steam and is crafted through sequenced assembly, &busing&r reed and tuning wire components."]
	quest.760D1C0CD7518BCE.quest_subtitle: "添加一个强大的芦苇声音效果"
	quest.7620D2CD5D4B607F.quest_desc: [
		"水晶头盔是通过灌注仪式制作的——将一个泰拉头盔、琥珀宝石和水晶碎片放置在&a灌注基座&r周围。"
		""
		"穿戴全套后，可获得永久性的&b再生 I&r效果。"
	]
	quest.7620D2CD5D4B607F.quest_subtitle: "由灌注而生的头盔"
	quest.7620D2CD5D4B607F.title: "&d水晶头盔"
	quest.762A0B992C58D442.quest_desc: [
		"&dVoltite&r Shard is a rare upgrade material from Crystal Chronicles. It is used to &bupgrade&r the Electromancer Armor from Iron’s Spells ’n Spellbooks into its &benhanced&r Crystal Chronicles version."
		""
		"碎片&b引导&r着闪电魔法的力量，为原始的Electromancer装备注入了额外的晶体能量。它也被用于制作Volt Spear和Tesla Rod，这些武器与&b增强版&rElectromancer装备相关。"
	]
	quest.762A0B992C58D442.quest_subtitle: "一种能为电磁术士装备提供力量的充能水晶碎片"
	quest.762ECCD358FEDF52.quest_subtitle: "真美味！"
	quest.76394F23CEE297D2.quest_desc: [
		"&dBattle-Evoker&r 靴子是 Crystal Chronicles 对 Iron’s Spells ’n Spellbooks 中 Archevoker 靴子的升级版。"
		""
		"使用 Avaricite Shard 对其进行 &b升级&r，将原本的 Archevoker Armor 转变为强大的 Battle-Evoker Armor 套装。Avaricite Shard 为 &b装备&r注入了额外的 Evocation 魔法，创造出更侧重于战斗的 Archevoker 装备版本。"
	]
	quest.76394F23CEE297D2.quest_subtitle: "由 Avaricite 强化的 Archevoker 靴子增强版"
	quest.763A98BB26BB58BF.quest_desc: [
		"水晶十字弓是永恒星光中的一个&a远程&r武器。"
		"它属于该模组的进阶装备等级，与维度中发现的结晶&b材料&r有关。"
		""
		"具体的&a合成&r或获取方法在现有公开资料中并无明确说明，可能取决于游戏进度、JEI配方或模组&b内部&r的特定战利品表。"
	]
	quest.763A98BB26BB58BF.quest_subtitle: "一种晶体远程武器"
	quest.763A98BB26BB58BF.title: "&6水晶十字弓"
	quest.763B02AC59B861D6.quest_subtitle: "升级+"
	quest.76412602849E8C38.quest_desc: ["&6Craft&r the Slime Spout Gun and use slime as your ammunition. Fill the gun with slime &busing&r a Spout, then fire slime &bprojectiles&r at your targets. The slime variant was &badded&r alongside the honey and chocolate Spout Guns in Create: Misc \\& Things."]
	quest.76412602849E8C38.quest_subtitle: "让你的敌人赖着不走，寸步难行"
	quest.765393B9D3FD9BE2.quest_desc: [
		"&9&l借助&r&rSophisticated Storage，将潜影盒的便利&b提升&r到新高度。这种储物容器&b提供&r了紧凑便携的方式来整理和运输大量物品。"
		""
		"支持 Sophisticated Storage 升级的 &b支持&r，可定制以满足您的存储需求，成为您物品栏和存储系统的强大 &b部分&r。"
	]
	quest.765393B9D3FD9BE2.quest_subtitle: "使用便携式容器扩展你的存储空间"
	quest.7661EC252F3C2327.quest_desc: ["&6大型齿轮曲柄是Create: Dreams n' Desires中升级版的&r&b手摇式&r旋转动力源。其更大的设计提供了更强大的&b手动&r驱动机械的方式，在需要额外&b旋转&r动力而未设置完整动力源时非常实用。"]
	quest.7661EC252F3C2327.quest_subtitle: "更大的杠杆，更强的力量"
	quest.76A2E1D53091B6E4.quest_desc: ["&6所有发电机都有的&r底座：它将你的&b动能&r网络与发电机主轴弱耦合。红石可改变耦合强度。要启动发电机，可通过设备连接器向定子输入励磁&b电流&r，或使用变阻器建造自励发电机。"]
	quest.76A2E1D53091B6E4.quest_subtitle: "发电机离合器"
	quest.76A5662F1B3DAFE1.quest_desc: ["&6The&r Block of Super Experience is a powerful form of experience from Create: Enchantment Industry. It is &bcreated&r when lightning strikes a Block of Experience, &btransforming&r it into Super Experience. It can be used for Super Enchanting and can &balso&r be compacted into Nuggets of Super Experience. Unlike normal experience, Super Experience has no liquid form."]
	quest.76A5662F1B3DAFE1.quest_subtitle: "超越寻常的体验，踏上非凡的旅程"
	quest.76AC125F870FA77F.quest_desc: [
		"&e忘掉&r稿子吧。这些加固的爪子专为撕裂岩石和泥土而生。"
		""
		"挖掘爪&b能&r提升你的挖掘速度，并将基础挖掘等级提升至石器时代，让你即使不手持工具也能挖掘通常需要至少&b石器时代&r工具才能挖掘的方块。默认情况下，它们提供&b32点&r挖掘速度加成。"
		""
		"&b穿上它们，&r撕裂大地吧。"
	]
	quest.76AC125F870FA77F.quest_subtitle: "挖掘得更深。速度更快"
	quest.76B7EFCD847F8806.quest_desc: ["&6Iron&r Wire is an electrical crafting component from Create Crafts \\& Additions. It is produced &busing&r the Rolling Mill and is used in recipes for various &belectrical&r components. Add it to your collection &balongside&r Copper Wire and the other metal wires needed to expand your electrical network."]
	quest.76B7EFCD847F8806.quest_subtitle: "强化你的电气网络"
	quest.76BEBF0AED6F72C9.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.76C0A64E5EDECF30.quest_desc: ["&6The&r Electrum Spool is an electrical component from Create Crafts \\& Additions used to connect &bcompatible&r Connectors and transfer electrical energy between them. One spool uses 4 Electrum Wires and 1 Empty Spool. When connected, it can &btransfer&r up to 5 kFE/t. Breaking a &bconnected&r connector returns &b4&r Electrum Wires."]
	quest.76C0A64E5EDECF30.quest_subtitle: "连接你的电气网络"
	quest.76EC8406BB62927F.quest_subtitle: "更多盔甲 (More Armor)"
	quest.7724BB5F80C35C73.quest_desc: ["在地下开采铜矿石以获得&a原铜&r。铜是你最早接触到的金属之一，可用于制作、装饰和未来科技。这是学习开采和加工&b金属&r的重要一步。"]
	quest.7724BB5F80C35C73.quest_subtitle: "你与金属的第一次接触"
	quest.7724BB5F80C35C73.title: "&3原矿 &#FD6E01铜矿石"
	quest.772845DF9F6165B7.quest_desc: [
		"&aGlacite Shards 和 Thioquartz Shards 都是&r在 Eternal Starlight 中常见的&b合成材料&r。"
		""
		"&aGlacite Shards&r 产自冰冻地区地下的 Glacite 矿石，主要用于制作 Glacite 装备和锻造修饰色。"
		"&aThioquartz Shards&r 产自晶体洞窟中生长的 Thioquartz 簇，主要用于制作基础盔甲和装饰色。"
		""
		"&aNeither&r material is especially important for major progression, but both are useful early resources while &bexploring&r the dimension."
	]
	quest.772845DF9F6165B7.quest_subtitle: "该维度的简易材料"
	quest.772845DF9F6165B7.title: "&6冰冻和硫磺晶体"
	quest.7739C8981ACF110E.quest_desc: [
		"&e某些&r攻击需要得到回应。"
		""
		"火焰吊坠有&b几率&r点燃伤害你的敌人。成功时，吊坠会短暂地&b保护&r你免受火焰伤害，让你将敌人的攻击反弹回去。"
		""
		"&b先发&r制人，否则会被烧伤。"
	]
	quest.7739C8981ACF110E.quest_subtitle: "触碰我，感受灼热的温度"
	quest.773A93DE2C083A08.quest_desc: ["在继续&a升级&r装备时，这款护腿能很好地平衡耐久度和强度。含铁的末地合金能在大多数&b情况下&r提供可靠的防护。"]
	quest.773A93DE2C083A08.quest_subtitle: "加固保护（Reinforced protection）"
	quest.773A93DE2C083A08.title: "铁质下界合金护腿"
	quest.7743A465A3C79F1C.quest_desc: [
		"&a生命汲取权杖&r是暮光巫妖掉落的一件黑暗&b遗物&r。它能引导腐化的灵魂能量，让持有者在战斗中吸取&b敌人&r的生命力，并&b恢复&r自身活力。"
		""
		"&a这根&r权杖代表了巫妖魔法中最&b具攻击性&r的形式，能将每次攻击转化为治疗。然而，它的力量不稳定，以生命为食，因此在持久战中是一把&b危险&r却强大的武器。"
	]
	quest.7743A465A3C79F1C.quest_subtitle: "从敌人那里窃取生命的力量"
	quest.77516919D2A84805.quest_desc: ["&6从Create模组中获取&r流体阀门。它能控制流体在管道网络中的流动。阀门通过对其侧面施加旋转力来&b操作&r，通常使用阀门手柄或齿轮换挡器。侧面的箭头&b指示&r阀门是开启还是关闭。"]
	quest.77516919D2A84805.quest_subtitle: "掌控水流的方向"
	quest.77881DD6C3F9A04C.quest_desc: ["使用创造：糖果制作的工具合成&6圣诞拐杖糖锄头&r，为耕作增添节日气息。它是圣诞拐杖糖工具套装的&b一部分&r，与圣诞拐杖糖镐、斧头、剑和铲子一同加入。"]
	quest.77881DD6C3F9A04C.quest_subtitle: "用甜蜜的方式让你的作物茁壮成长"
	quest.779BF5DC4024CDE9.quest_desc: [
		"&6Not&r every aircraft needs to rely &bentirely&r on its engine. A Sail harnesses the wind to help your aircraft travel through the skies. A simple piece of equipment, but an essential part of classic airships."
		""
		"制作你的船帆，并&b准备&r好飞机，迎接开阔的天空。"
	]
	quest.779BF5DC4024CDE9.quest_subtitle: "让风载你翱翔于天际之上。"
	quest.779F9785621E0BC0.quest_subtitle: "真美味！"
	quest.77AF9B104B17F5C3.quest_desc: ["&e月亮水晶&r是奇幻系列所有盔甲的&b基础&r。要制作一个，需要用九个发光墨囊包围一块&b紫水晶&r碎片。然后在锻造台将水晶与下界合金盔甲部件及合适的组件&b结合&r，即可将其制成传奇套装之一。"]
	quest.77AF9B104B17F5C3.quest_subtitle: "每件奇幻盔甲的关键所在"
	quest.77AF9B104B17F5C3.title: "&d月亮水晶"
	quest.77B53DF48668E2BB.quest_desc: ["&6从Create模组中获取&r一个火车站。它用于创建、组装、拆卸和管理火车。将其放置在铁轨旁，并使用&b其界面来&r创建新火车、命名车站和&b管理&r火车时刻表。车站对于使用火车时刻表和火车信号实现的&b自动化&r铁路网络也至关重要。"]
	quest.77B53DF48668E2BB.quest_subtitle: "建造通往你铁路网络的门户"
	quest.77B5E4C6B8EE69C9.quest_desc: [
		"&e经历了&r这一切之后，听到熟悉的声音真不错。"
		""
		"&bPut&r this disc in a jukebox and let its music fill the room. Whether you're &breturning&r from an &bexpedition&r or settling into your new home, every adventure deserves a soundtrack."
		""
		"欢迎回来，冒险家。"
	]
	quest.77B5E4C6B8EE69C9.quest_subtitle: "一首欢迎你回家的歌谣"
	quest.77B5E4C6B8EE69C9.title: "&l&f欢迎使用&e音乐唱片"
	quest.77BB3EBE888EE2F8.quest_desc: ["从 Create 模组中获取&6电梯滑轮&r。这是一种用于建造&b多层&r电梯的特殊机械组件。与绳索滑轮不同，它能穿过方块移动，并与同一高度的其他电梯滑轮同步。配合红石接触器定义楼层和&b可选的&r机械控制，你就能创建一个功能齐全的电梯系统。"]
	quest.77BB3EBE888EE2F8.quest_subtitle: "超越极限，不断上升"
	quest.77BED095AD4223B0.quest_desc: [
		"&dBottle&r o' Lightning 是 Iron's Spells 'n Spellbooks 中的闪电焦点。它被&b用&r来制作闪电法术和闪电相关装备。"
		""
		"要获得一个，请在带电的苦力怕上使用空瓶子。你可以通过闪电法术、引雷针或使用“引雷”的三叉戟来&b创造&r带电的苦力怕。"
	]
	quest.77BED095AD4223B0.quest_subtitle: "捕捉雷暴的力量，掌控其中蕴含的能量"
	quest.77FFB5E674EC3F06.quest_desc: [
		"&aAmaramber胸甲&r是永恒星光中一件防护性盔甲，使用Amaramber&b材料&r制作而成。"
		""
		"&a它&r是 Amaramber 盔甲进阶的一部分，能在&b探索&r和战斗中提供更强保护。"
	]
	quest.77FFB5E674EC3F06.quest_subtitle: "琥珀锻造的盔甲"
	quest.78167587A2190E60.quest_desc: ["&a唤醒&r并击败最后的深板岩——隐藏在远古堡垒中的强大机器。使用从深板岩宝库中&b获取&r的回响电荷可以&b唤醒&r它。击败首领标志着挑战的终结，并奖励你一个用于&b制造&r强大武器的珍贵锻造模板。"]
	quest.78167587A2190E60.quest_subtitle: "远古末裔的最后一人"
	quest.78167587A2190E60.title: "&l&b最后的&3&f深板岩</c4></c3></c2>"
	quest.782030F31C8C7045.quest_desc: ["&6从Create中获取&r锌锭。锌是与铜结合使用的必需材料，用于制造黄铜，而黄铜是更&b高级&r的Create机械和物流系统的关键材料之一。锌可以通过熔炼锌矿石或压碎的锌矿石来&b获取&r。"]
	quest.782030F31C8C7045.quest_subtitle: "锻造将万物凝聚为一体的金属"
	quest.78405A333E6AB789.quest_desc: ["&6镀金石英斧&r是 Create Stuff 'N Additions 镀金石英工具套装的一部分。它有 1644 的耐久度，造成 8 点攻击伤害，攻速为 1.2。它由&b使用&r抛光玫瑰石英、铁板、金和锌工具手柄制作而成。它被&b设计&r为标准工具的强力替代品，&b将&r玫瑰石英与黄金结合，以提升性能。"]
	quest.78405A333E6AB789.quest_subtitle: "用玫瑰石英的力量来切割吧"
	quest.78412F65ABE0A6E1.quest_subtitle: "真美味！"
	quest.7852999D151D4577.quest_desc: [
		"&6普通&r引擎的局限性很大。下界引擎能带你突破极限，利用下界&b材料&r的强大力量，大幅提升引擎性能。"
		""
		"这种力量的代价是燃料。更强的引擎需要&b更多&r燃料——但当速度是第一位的，就必须做出牺牲。"
	]
	quest.7852999D151D4577.quest_subtitle: "驾驭来自下界的强大力量。"
	quest.785FDC18E2689C83.quest_desc: [
		"&d银环&r是 Iron's Spells 'n Spellbooks 中一款简约而珍贵的魔法配饰。它为你的魔法装备提供了坚实的基础，并能成为你踏入神秘艺术领域的&b旅途&r中的重要一环。"
		""
		"&b装备&r戒指，向掌握可用魔法装备的目标又迈进了一步。"
	]
	quest.785FDC18E2689C83.quest_subtitle: "开始收集你的魔法配饰吧"
	quest.7876B4DDAC6F76F0.quest_desc: [
		"&6赋予&r你的机车 Plated Locometal，让它看起来更流畅坚固。光滑的金属板非常适合&b为&r你的铁路建筑增添干净的工业表面和精致的细节。"
		""
		"&b使用&r Plated Locometal 为你的机车赋予应有的坚固、精致外观。"
	]
	quest.7876B4DDAC6F76F0.quest_subtitle: "为您的机车带来洁净的金属质感。"
	quest.787E61BD64245B94.quest_subtitle: "更多武器模组 (More Weapon)"
	quest.78A69968A7134E7F.title: "uhhh"
	quest.78D6EE733F2A5C24.quest_desc: [
		"&d紫晶共振护符&r是 Iron's Spells 'n Spellbooks 中的一个魔法项链，装备后可将法力恢复速度提高 &b15%&r。这能让你更快地恢复法力，并&b更早&r地回归施法状态。"
		""
		"&b制作&r护身符，强化与体内流动的神秘力量之间的联系。"
	]
	quest.78D6EE733F2A5C24.quest_subtitle: "用紫水晶共振来恢复你的法力值"
	quest.78E8137F10935F08.title: "该死的"
	quest.78EC6769CB15B15B.quest_subtitle: "更多盔甲 (More Armor)"
	quest.790B8D1EDD719770.quest_desc: ["&6获取&r来自Create的扳手。这个&b必备&r的工程工具能让你旋转、拆解和配置许多Create组件。它由&b金箔、齿轮和木棍&r合成。"]
	quest.790B8D1EDD719770.quest_subtitle: "将机器塑造成你期望的模样"
	quest.791F1EDF06263CDA.quest_desc: [
		"&a获取&r阿尔法雪怪的厚毛皮，这是一种从冰川霸主身上取得的稀有&b材料&r。这种非凡的&b毛皮&r能适应最恶劣的&b环境&r，即使在暮色森林最寒冷的角落也能保持温暖。"
		""
		"&aAlpha&r Yeti Fur is an essential crafting material &bused&r to create armor capable of protecting its wearer from freezing &btemperatures&r. More than just a trophy, it is proof that you have conquered one of the most powerful &bcreatures&r lurking within the frozen wilderness."
	]
	quest.791F1EDF06263CDA.quest_subtitle: "永恒冬季的温暖气息"
	quest.7922B68C83D0916D.quest_desc: ["制作&6制动器&r，按需停止旋转机械。通电后，它会&b对连接的动能网络施加&r阻力，让你能停止旋转部件，控制机械的运转时机。制动器是 Create: Connected 中包含的动能&b方块&r之一。"]
	quest.7922B68C83D0916D.quest_subtitle: "让你的机器设备全部停止运转"
	quest.79288D545C2DFDD7.quest_desc: ["&6Obtain&r both a Gearbox and a Vertical Gearbox from Create. Gearboxes redirect rotational power between &bdifferent&r axes. The &bstandard&r Gearbox handles horizontal directions, while the Vertical Gearbox allows &brotational&r power to be redirected between horizontal and vertical axes."]
	quest.79288D545C2DFDD7.quest_subtitle: "将能量朝任意方向旋转"
	quest.7931258DEAC96F83.quest_desc: [
		"&aTenacious&r Petals 是永恒星光中找到的植物材料，与整个维度生长的植被有关。"
		"主要用于制作与该模组相关的&b自然&r资源和进阶物品。"
		""
		"&a这些&r花瓣是众多独特&b植物&r之一，让这片维度充满生机与异感。"
	]
	quest.7931258DEAC96F83.quest_subtitle: "一个坚韧的花瓣碎片"
	quest.7931258DEAC96F83.title: "&b坚韧的花瓣"
	quest.794215F11EAD7BA4.quest_desc: [
		"Terminite 锄头是一种由 Terminite 锭锻造的&a农具&r，比 Thallasium 工具能更高效地准备农田。"
		""
		"这是 Better End 中阶&b装备&r进阶的一部分。"
	]
	quest.794215F11EAD7BA4.quest_subtitle: "经过精炼的农具，已完成"
	quest.7947F699605459FA.quest_desc: ["&a击败&r来自Cataclysm模组的3个深海巫师。这些危险的&b水生&r敌人使用黑暗魔法和强力攻击来保卫它们的领地。你可以在深海区域的深海巫师&b建筑&r中&b找到&r它们。"]
	quest.7947F699605459FA.quest_subtitle: "击败深海的黑暗魔法"
	quest.7947F699605459FA.title: "击杀深渊术士（Deepling Warlock）"
	quest.795598A64E80837D.quest_desc: ["合成&6连锁发射器，以便在连锁组件间无线&r&b发送&r红石信号。它&b&r支持不同类型的按钮、拉杆和连锁拉杆，让你无需铺设&b&r实体红石线路即可控制远处的机械。它还可以连接到&b&r兼容的控制装置，例如 Create: Aeronautics 的节流拉杆。"]
	quest.795598A64E80837D.quest_subtitle: "将红石信号传送到工厂的各个角落"
	quest.7960C5339897DA76.quest_desc: [
		"&d神圣&r符文是 Iron's Spells 'n Spellbooks 的配方材料，&b用于&r高级的与&b神圣&r相关的配方，包括神圣升级球和神圣装备。"
		""
		"&b将空白符文石用8个神圣珍珠包围，即可&r创建一个神圣符文。神圣珍珠是该模组的神圣焦点。"
	]
	quest.7960C5339897DA76.quest_subtitle: "用神圣魔法的力量注入一块符文石中"
	quest.796FC1FC35689C77.quest_desc: [
		"&9&lExpand&r&r your Refined Storage network with the Network Transmitter. It &ballows&r you to connect and &bextend&r your network over greater distances, making it possible to build larger and more flexible storage systems."
		""
		"&bUse&r it to connect distant &bsections&r of your network and bring all your storage and automation devices together into one system."
	]
	quest.796FC1FC35689C77.quest_subtitle: "将你的存储网络扩展到其极限之外"
	quest.79886FA0A6925681.quest_desc: ["&6A&r VFET晶体管，一种用于电子电路的半导体。"]
	quest.79886FA0A6925681.quest_subtitle: "一个场效应晶体管 (VFET transistor)"
	quest.7997AB49C57E3EE5.quest_desc: [
		"&6乘坐&r经典的飞艇，翱翔&b天际&r。它可能不是最快的飞行器，但其简单的操控和两个座位&b使其&r成为休闲探索和旅行的绝佳选择。"
		"&bBuild&r your Airship, find an open stretch of land, and let the wind carry you above the world."
	]
	quest.7997AB49C57E3EE5.quest_subtitle: "在天空中享受一次轻柔的飞行。"
	quest.79B6A938CD4B59AF.quest_desc: ["&a击败&r Scylla，L_Ender’s Cataclysm 的主要首领之一。她统治着 Acropolis，并掌控着&b毁灭性的&r风暴攻击。战胜这位风暴女皇，赢得 Cataclysm 最强大首领之一的&b胜利&r。"]
	quest.79B6A938CD4B59AF.quest_subtitle: "击败风暴女皇"
	quest.79B6A938CD4B59AF.title: "&l&b斯库拉"
	quest.79C4B465DE591473.quest_subtitle: "更多盔甲 (More Armor)"
	quest.79D5A389CEAF290D.quest_desc: ["&d降低&r枪声的&b声音&r传播范围并隐藏枪口火焰，助你保持潜行。"]
	quest.79D5A389CEAF290D.quest_subtitle: "安静的射击声"
	quest.79D6957D9C4A05D9.quest_desc: ["&6Nuclear&r Fuel is the energy source &bused&r to operate the reactor in Create: New Age. Prepare the fuel and supply it to the reactor to &bbegin&r generating the intense heat required for nuclear &bpower&r production."]
	quest.79D6957D9C4A05D9.quest_subtitle: "为反应堆提供动力"
	quest.79D7DC2B91A5DC8D.quest_desc: [
		"使用强大的纳迦掉落的鳞片，&a制作&r纳迦鳞片胸甲。这件轻便的胸甲能在暮色森林冒险的初期为你提供绝佳保护，也是你首次伟大&b胜利&r的证明。"
		""
		"&aThe&r Naga Scale armor is the first unique armor set available in the Twilight Forest and an important step toward overcoming the dangers that lie &bdeeper&r within the dimension."
	]
	quest.79D7DC2B91A5DC8D.quest_subtitle: "由堕落守卫锻造而成的盔甲"
	quest.79F2F7B1DA98476F.title: "很好"
	quest.79F669C9257F1E46.quest_desc: ["&d一种&r特殊材料，&b用于&rHazen N Stuff 中强大的合成配方。"]
	quest.79F669C9257F1E46.quest_subtitle: "一种稀有而神秘的 divine 食材"
	quest.7A05048E63FCE38C.quest_desc: [
		"&a炼金术士面具&r是永恒星光中的一个实用物品，与炼金术主题的&b进度&r相关。"
		""
		"&a它&r是一种特殊装备，能提升探索或炼金机制，具体&b因&r版本而异。"
	]
	quest.7A05048E63FCE38C.quest_subtitle: "神秘炼金术士的地球仪"
	quest.7A0692A32E91438D.quest_desc: [
		"&6Give&r your steam locomotive a &brefined&r industrial look with the Brass Wrapped Locometal Boiler. Combining sturdy Locometal with elegant brass detailing, this boiler is perfect for building a locomotive that &bstands&r out from the crowd."
		""
		"&b添加到&r你的机车，让你的蒸汽引擎获得应有的抛光外观。"
	]
	quest.7A0692A32E91438D.quest_subtitle: "专为真正杰出的机车打造的黄铜锅炉。"
	quest.7A0CAFF63C0ACEE5.quest_desc: [
		"&a原始&r阿玛兰伯可以在永恒星光中提炼成强大的锭。"
		"这些锭含有浓缩的星光能量，可用于制作更强大的装备、&b高级&r合成和更高等级的进阶内容。"
		""
		"&a制作&r第一块阿玛兰伯锭，标志着掌握该维度资源的重大&b一步&r。"
	]
	quest.7A0CAFF63C0ACEE5.quest_subtitle: "精炼星光金属"
	quest.7A0CAFF63C0ACEE5.title: "&6阿玛兰伯锭"
	quest.7A136A2F2F73CC60.quest_desc: ["&6安山岩喷气背包&r是 Create Stuff 'N Additions 模组中一款能飞行的胸甲。它&b使用&r蒸汽动力，&b由水和燃料&r产生，来推动你升空。按住跳跃键向上飞行，按跳跃+Shift 原地悬停。喷气背包最高可升至地面约 &b17&r 格的高度，耐久度为 &b320&r。注意燃料，如果在&b空中&r耗尽，你会坠落。"]
	quest.7A136A2F2F73CC60.quest_subtitle: "乘着蒸汽翱翔天际吧"
	quest.7A2C9DE914989B6E.quest_subtitle: "真美味！"
	quest.7A56B0E3485A8F77.quest_desc: ["&6制作&r你的第一个空白电路和铜电路。这些&b基础&r组件是 Create: New Age 电气技术的基础，也是建造更&b先进&r的电气机器和组件所&b必需&r的。"]
	quest.7A56B0E3485A8F77.quest_subtitle: "开始建造你的电气系统吧"
	quest.7A56B0E3485A8F77.title: "电路元件"
	quest.7A9233E8C4FCD5E1.quest_desc: [
		"&a链锁巨锤&r是一种残酷的&b武器&r，曾被重甲哥布林骑士所使用。它将巨大的铁块与坚固的锁链相连，牺牲速度换取&b压倒性的&r冲击力，能够碾碎&b敌人&r，击退挡在路上的任何东西。"
		""
		"&a虽然&r难以掌握，但学会&b使用&r它的人，就能获得暮色森林中最独特的武器之一。每一次挥舞都蕴含着巨大的力量，使其在对抗高&b防御&r的敌人和大型敌群时尤为&b有效&r。"
	]
	quest.7A9233E8C4FCD5E1.quest_subtitle: "将敌人的力量反过来对付他们"
	quest.7AA899604C3F48EE.quest_desc: [
		"星落长弓是永恒星光中一种&a远程&r武器，通过星落机制增强了标准弓的&b玩法&r。"
		""
		"击中后，会召唤下落的&a星星&r，在短暂延迟后击中目标，在单体和小范围战斗中造成额外的爆发&b伤害&r。"
	]
	quest.7AA899604C3F48EE.quest_subtitle: "天体远程武器"
	quest.7AB002298C6B5AF1.quest_desc: ["&6Craft&r the Large Crank Wheel to &bmanually&r power your kinetic network. Like the standard Crank Wheel, it combines a hand crank with a cogwheel, allowing it to connect directly to other gears. It generates &b32&r RPM and provides &b256&r SU of stress capacity while consuming player hunger when operated."]
	quest.7AB002298C6B5AF1.quest_subtitle: "更大的杠杆，更强的力量"
	quest.7AB25F6EF984EAB8.quest_desc: ["&6Craft&r the Bar of Caramel in Create: Confectionery and add a rich, golden treat to your collection of sweets. Caramel is made by heating sugar and is widely &bused&r in confectionery as a filling, topping, or candy."]
	quest.7AB25F6EF984EAB8.quest_subtitle: "一块散发着纯粹甜意的金条"
	quest.7ACC76719A352665.quest_desc: ["&6A&r 铜板，可用于建筑和装饰。"]
	quest.7ACC76719A352665.quest_subtitle: "一个用于铺路的石板"
	quest.7AD7959BC45582DC.quest_desc: ["&6一种&r简单的机电装置，用于绘制&b电压&r随时间变化的曲线。右键单击图表并用&b染料&r更改颜色。"]
	quest.7AD7959BC45582DC.quest_subtitle: "一个电压绘图仪"
	quest.7B02656C0420407C.quest_subtitle: "真美味！"
	quest.7B2B79752ED8B4A0.quest_subtitle: "更多盔甲 (More Armor)"
	quest.7B2CBAD13EF2925F.quest_desc: ["&6风车&r帆&b用于&r建造风车并产生旋转动力。将它们连接到风车轴承上以制作叶片。风车需要至少&b8&r个帆状方块才能开始旋转，每增加&b8&r个帆，其速度和功率输出都会增加&b1&r转/分和&b512&rSU。风车帆会自动连接到风车上，无需强力胶水。它们也可以被染成&b不同&r的颜色。"]
	quest.7B2CBAD13EF2925F.quest_subtitle: "驾驭风的力量"
	quest.7B40DD0CCBD39F33.quest_desc: ["在创造：酿酒厂中&6寻找&r并种植红葡萄。它们可以从葡萄藤上&b收获&r，并用创造机械&b加工&r成葡萄渣和红葡萄汁，然后可以在酒窖中酿造红酒。红白葡萄常见于平原和&b森林类型&r的生物群系。"]
	quest.7B40DD0CCBD39F33.quest_subtitle: "培育红葡萄酒之心"
	quest.7B47D1581C9650D6.quest_subtitle: "更多盔甲 (More Armor)"
	quest.7B48C6EFAA54F4EB.quest_desc: ["&6Build&r the Keyboard Relay and connect a &bphysical&r piano keyboard to your computer to play your pipe organ in Create: Sound of Steam. It &btranslates&r keyboard input into notes for your organ, allowing you to &bperform&r music live."]
	quest.7B48C6EFAA54F4EB.quest_subtitle: "用你自己的键盘弹奏管风琴"
	quest.7B4B94DE562F4EEB.quest_desc: ["&6Craft&r Carbon Brushes, an &bessential&r component for electrical machines in Create: New Age. They work together with the &bgenerator&r system to transfer electrical energy from rotating machinery, helping turn your factory's mechanical power into &busable&r electricity."]
	quest.7B4B94DE562F4EEB.quest_subtitle: "保持当前的流动状态不变"
	quest.7B51B7512923B8B3.quest_desc: ["&a获取&r Excelius 推进护腿。将这件强大的盔甲加入你的收藏，并&b继续&r在 Excelius 武器库的&b高级&r装备中踏上你的旅程。"]
	quest.7B51B7512923B8B3.quest_subtitle: "驾驭推进的力量，掌控前行方向"
	quest.7B52E53809394AB6.quest_desc: [
		"&dRod&r o' Lightning 是 Iron's Spells 'n Spellbooks 模组中的闪电法杖。主手持有时，可提供 &b5&r 点攻击力、&b1&r 点攻击速度、&b+15%&r 闪电法术强度、&b+10%&r 冷却缩减和 &b+5%&r 法术强度。"
		""
		"在雷暴天气下，用充能核心在避雷针上即可制作。充能核心本身是制作法杖的&b特殊&r材料。"
	]
	quest.7B52E53809394AB6.quest_subtitle: "引导闪电那毁灭性的力量"
	quest.7B6FF34E241663B5.quest_desc: ["&a击败&r来自Cataclysm模组的紫水晶蟹。这个强大的晶体生物会凶猛地守护它的&b巢穴&r。战胜这头巨兽，&b夺取&r紫水晶巢守护者的胜利。"]
	quest.7B6FF34E241663B5.quest_subtitle: "击败紫晶巢穴的守护者"
	quest.7B6FF34E241663B5.title: "&l&d紫水晶 &f螃蟹"
	quest.7B879AD2714FE5D2.quest_desc: [
		"&l&9停止&r&r追逐战场上的掉落物。磁吸升级可将附近的物品直接吸入背包，并配有&b可配置&r的过滤器来决定收集哪些物品。"
		""
		"高级磁石升级能扩大收集&b范围&r，并提供更强大的&b过滤&r选项，包括物品、模组、标签、NBT数据和耐久度。它还提供了16个过滤槽而非9个，让你能更轻松地控制背包吸引的物品。"
	]
	quest.7B879AD2714FE5D2.quest_subtitle: "让你的背包把战利品吸引过来"
	quest.7B879AD2714FE5D2.title: "磁石 \& 高级磁石升级组件"
	quest.7B8B1AEE1191A350.quest_desc: ["从Cataclysm模组中获取&a祝福的紫水晶蟹肉&r。这种&b强化&r的珍馐蕴含着紫水晶的神秘力量，将击败的紫水晶蟹的肉转化为&b更加非凡&r的存在。"]
	quest.7B8B1AEE1191A350.quest_subtitle: "经过水晶力量加持的美味佳肴"
	quest.7B988199727590B1.quest_subtitle: "更多盔甲 (More Armor)"
	quest.7B9D480E0804CBD1.quest_desc: [
		"&a制作&r虚空散射箭，一种使用末影翼在废墟堡垒中掉落的虚空下颚制成的特殊弹药。"
		""
		"它们可与Cataclysm的远程&b武器&r配合使用，对敌人造成额外伤害。"
	]
	quest.7B9D480E0804CBD1.quest_subtitle: "被虚空污染的弹药"
	quest.7BA586AFA332049E.quest_subtitle: "真美味！"
	quest.7BAC4062AE5CD961.quest_desc: ["&d咒术师的护身符&r是 Iron's Spells 'n Spellbooks 中的一个项链，能&b将&r你召唤生物的伤害提高 15%。 &b装备&r它，让你的召唤盟友在战斗中更强大，&b使&r你的召唤物成为更大的威胁。"]
	quest.7BAC4062AE5CD961.quest_subtitle: "强化你召唤的盟友的力量"
	quest.7BAD76F4A92FB434.quest_desc: ["&6史莱姆&r靴子是 Create Stuff 'N Additions 模组中一种特殊的靴子，能&b赋予&r你史莱姆方块的特性。落地时，它们会把你弹回空中，并完全&b防止&r坠落伤害。它们提供 2 点护甲值，耐久度为 65。有趣的是，靴子在弹跳时不会损失&b耐久度&r。"]
	quest.7BAD76F4A92FB434.quest_subtitle: "用弹跳的方式逃到安全的地方"
	quest.7BAE2E754EE4E451.quest_subtitle: "更多盔甲 (More Armor)"
	quest.7BBB18C48105D22B.quest_desc: [
		"Thallasium Hammer 是一种两用&a工具&r——它能在铁砧上锻造锭，同时也是一把带有强力击退效果的重型近战武器。"
		""
		"这是Thallasium层级对Better End独特武器类型&bHammer&r的回应。"
	]
	quest.7BBB18C48105D22B.quest_subtitle: "重型工具和武器二合一"
	quest.7BC2238AA1778A3D.quest_desc: [
		"Golem Steel Greatsword 是一种重型武器，使用通过 Eternal Starlight 中 Starlight Golem 的&b进阶&r获得的 Golem Steel Ingot 来&a制作&r。"
		"它属于模组添加的&a高级&r武器等级，需要与Golem Forge遭遇相关的材料&bconnected&r。"
	]
	quest.7BC2238AA1778A3D.quest_subtitle: "构造体的武器之一"
	quest.7BC2238AA1778A3D.title: "&6Golem Steal 巨剑"
	quest.7BEF6AD8FBE2A795.quest_desc: ["使用Aquaculture 2制作&aNeptunium Pickaxe&r。这件强大的&b工具&r由Neptunium制成，这是一种通过钓鱼宝藏获得的稀有材料。它具有高&b耐久度&r和&b挖掘&r效率，是&b高级&r装备的宝贵升级。"]
	quest.7BEF6AD8FBE2A795.quest_subtitle: "来自海洋宝藏的强大工具"
	quest.7C128C9AC8D74FE4.quest_desc: [
		"在永恒星光（Eternal Starlight）的&a沙漠&r地区，名为Lunaris仙人掌的奇异植物在微弱的星光下生长。"
		"这些仙人掌状的生物适应了晶体环境，常用于&a制作&r或资源&b精炼&r系统中。"
		""
		"安全地&a采集&r它们很重要，因为它们&b锋利&r又不稳定的&a特性&r仍可能伤害未做好准备的人。"
	]
	quest.7C128C9AC8D74FE4.quest_subtitle: "月光下的植物"
	quest.7C1AC05BA55FE29B.quest_desc: ["绿宝石&a 象征&r 财富与稀有。与下界合金结合，可&a 创造&r 一件既强大又极具&b 价值&r 的胸甲。"]
	quest.7C1AC05BA55FE29B.quest_subtitle: "声望与权力"
	quest.7C1AC05BA55FE29B.title: "绿宝石下界合金胸甲"
	quest.7C391285F28322D1.quest_desc: [
		"塔拉西姆铲子是一种由塔拉西姆锭锻造的&a挖掘&r工具，用于挖掘和清理地形。"
		""
		"它能完成 Better End 的 &bThallasium&r 工具基础套装。"
	]
	quest.7C391285F28322D1.quest_subtitle: "第一等级的挖掘工具"
	quest.7C61D4BF3076BBB3.quest_desc: ["从 Create 模组中获取&6大型水轮&r。当水流过或流下它时，水轮会产生&b旋转&r动力。与普通水轮相比，它的转速为&b4&r RPM，并提供&b512&r SU 的应力容量，使其成为转速更慢但更强大的发电机。"]
	quest.7C61D4BF3076BBB3.quest_subtitle: "从水中汲取更强大的力量"
	quest.7C96D8A68EB11FB8.quest_desc: [
		"&e每次&r攻击都是有代价的。"
		""
		"荆棘吊坠有45%的几率在敌人&b伤害&r你时进行反击，对攻击者造成1-4点伤害。对于任何想让敌人后悔&b&r靠得太近的人来说，这都是一款完美的&b&r选择。"
		""
		"&b让它们&r发起攻击。让荆棘做出回应。"
	]
	quest.7C96D8A68EB11FB8.quest_subtitle: "伤害我，你也会尝到苦果的"
	quest.7C98F5E299CFF13A.quest_desc: [
		"Gold &aenhances&r your helmet with unique &bproperties&r."
		"虽然不太耐用，但它能提供有用的加成，在合适的&b情况下&r会非常有效。"
	]
	quest.7C98F5E299CFF13A.quest_subtitle: "明亮且自适应的照明系统，可根据环境自动调节亮度。"
	quest.7C98F5E299CFF13A.title: "黄金下界合金头盔"
	quest.7C9D95994C9F48CB.quest_desc: ["&6Craft&r the Vox Celeste pipe and add its distinctive, celestial &btone&r to your pipe organ. Vox Celeste was &bintroduced&r in Create: Sound of Steam 0.8.0 as one of seven new pipe types."]
	quest.7C9D95994C9F48CB.quest_subtitle: "为你的管风琴增添空灵之声"
	quest.7CAD28686DB99642.quest_desc: [
		"&d可见性戒指&r能让你看到被隐形效果影响的生物，揭示那些原本会隐藏起来的敌人。它还能保护你免受失明和黑暗效果的影响，在&b探索&r危险且光线不足的区域时尤其有用。"
		""
		"&b装备&r戒指，即使在魔法试图夺走你视力的时候，也能保持视野清晰。"
	]
	quest.7CAD28686DB99642.quest_subtitle: "看看黑暗试图隐藏了什么秘密"
	quest.7CB5942511E7673E.quest_desc: ["&a从&rCataclysm模组中获得紫晶蟹肉。 &b取自&r被击败的紫晶蟹，这道奇特的珍馐是&b那个&r曾守护紫晶巢穴的怪物的怪异纪念品。"]
	quest.7CB5942511E7673E.quest_subtitle: "品尝一下水晶巨兽的味道"
	quest.7CC2AEE66DCC8412.quest_desc: [
		"&d稻草人&r护腿是 Iron's Spells 'n Spellbooks 中稻草人盔甲套装的一部分。提供 &b+6&r 护甲和 &b+75&r 最大法力值。"
		""
		"Craft them &busing&r Hay Bales and Leather, and &bcomplete&r your Scarecrow Armor set."
	]
	quest.7CC2AEE66DCC8412.quest_subtitle: "携带稻草人的神秘力量"
	quest.7CC858E51115B273.quest_desc: [
		"Thermal Springstone 锄头是 Eternal Starlight 的一种&a农具&r，使用 Thermal Springstone 锭&b制作&r而成。"
		""
		"&a它&r用&b来&r在星光维度地热区域的农田做准备，属于中阶&b进阶&r套装。"
	]
	quest.7CC858E51115B273.quest_subtitle: "地热农业工具"
	quest.7CFD93F6BCF72CA8.quest_subtitle: "更多盔甲 (More Armor)"
	quest.7D029F14471BEDF7.quest_desc: ["&aSkoglin奖杯&r是My Nether's Delight中的一个装饰奖杯，让你可以在基地中展示一件独特的&b下界主题&r装饰品。"]
	quest.7D029F14471BEDF7.quest_subtitle: "来自危险的下界的奖杯"
	quest.7D1BEFA38EFB87B9.quest_desc: [
		"&9&lTake&r&r your digital storage to the next level with the Crafting Grid. It combines the convenience of the Grid with a crafting interface, &ballowing&r you to access your stored items and craft recipes without &bmanually&r retrieving materials."
		""
		"将其连接到你的 Refined Storage 网络，直接从你的 &b集中式&r存储系统中合成。"
	]
	quest.7D1BEFA38EFB87B9.quest_subtitle: "直接从你的数字存储中制作任何物品"
	quest.7D386E5ADF45F118.quest_desc: [
		"书架不仅仅是装饰——它们能增强你的附魔台，让你的法术更强大、更有效。"
		""
		"收集足够的书架来环绕你的附魔装置，最大化你的&b魔法潜力&r！"
	]
	quest.7D386E5ADF45F118.quest_subtitle: "堆叠你的智慧，让它不断增长"
	quest.7D386E5ADF45F118.title: "知识就是力量"
	quest.7D39644F07161EB6.quest_desc: ["&6甜&r浆果本来就很美味，但加上糖衣会更棒。将焦糖和巧克力&b注入&r甜浆果，即可制作焦糖浆果和巧克力浆果。"]
	quest.7D39644F07161EB6.quest_subtitle: "用焦糖和巧克力让香甜浆果变得更美味。"
	quest.7D39644F07161EB6.title: "焦糖浆果和巧克力浆果"
	quest.7D6DBF46D57DD713.quest_subtitle: "真美味！"
	quest.7DC412D85F2CC926.quest_desc: ["&a炉灶&r是 Farmer's Delight 中的一个烹饪台，&b用于&r制作各种菜肴。将&b食材&r放入其中，即可将其变成美味佳肴，是任何厨房都不可或缺的组成部分。"]
	quest.7DC412D85F2CC926.quest_subtitle: "一个用于制作美味佳肴的实用烹饪台"
	quest.7DC9F6CA60817D5C.quest_desc: [
		"&aCraft&r a Diamond Fishing Rod, the &bpinnacle&r of traditional fishing equipment. Reinforced with diamond, this exceptional rod offers incredible &bdurability&r and reliability, allowing you to spend countless hours searching for the rarest fish and the greatest treasures &bhidden&r beneath the waves."
		""
		"&aFrom&r peaceful lakes to the &bdeepest&r oceans, the Diamond Fishing Rod is built for anglers who demand nothing less than excellence. With such a dependable tool in your hands, every cast brings you closer to &buncovering&r the ocean's greatest secrets"
	]
	quest.7DC9F6CA60817D5C.quest_subtitle: "每位垂钓者都梦寐以求的终极工具"
	quest.7DE87A4BA0CEBAC7.quest_desc: ["从Cataclysm模组中&a获取&rBerserker Soul Amulet。这件稀有的Curios饰品可以在&b废弃&r尖塔结构的宝箱中&b找到&r。装备后可提供+15%的攻击伤害，是近战冒险者&b宝贵&r的道具。"]
	quest.7DE87A4BA0CEBAC7.quest_subtitle: "被遗弃尖塔的遗迹之一"
	quest.7DE87A4BA0CEBAC7.title: "&b狂战士灵魂护身符"
	quest.7DF6F1C7A1FFB1AE.quest_subtitle: "升级+"
	quest.7DF8F09C2658AB69.quest_desc: [
		"&e火焰&r可能致命，但这具古颅能让你反将一军。"
		""
		"当你&b受到&r火焰伤害时，黑曜石头骨会为你提供30秒的火焰抗性。激活后，它需要进入&b60秒&r的冷却时间才能再次保护你。"
		""
		"在火焰中&b穿行&r。无所畏惧。"
	]
	quest.7DF8F09C2658AB69.quest_subtitle: "直面火焰，无所畏惧"
	quest.7DFE97839AF0EE7B.quest_desc: [
		"&dArchevoker&r 靴是 Iron's Spells 'n Spellbooks 中 Archevoker 盔甲套装的一部分。穿戴后可提供 &b+3&r 护甲、&b+125&r 最大法力、&b+10%&r 召唤术法术强度和 &b+5%&r 法术强度。"
		""
		"它们使用 1 个巫师靴、1 个召唤符文和 1 个奥术精华来&b制作&r或升级。"
	]
	quest.7DFE97839AF0EE7B.quest_subtitle: "驾驭召唤魔法的奥术力量"
	quest.7DFFB96E59705C93.quest_desc: [
		"永恒之剑是在锻造台用永恒工具头和剑柄组装而成的。"
		""
		"作为 Better End 最强的刃类武器，它的威力&a超越了&r甚至下界合金剑。"
	]
	quest.7DFFB96E59705C93.quest_subtitle: "最强阶层的刀刃"
	quest.7E191DA83D23336E.quest_subtitle: "真美味！"
	quest.7E345451D20ABDBF.quest_desc: ["&6Electrum&r Wire is an electrical component from Create Crafts \\& Additions, used to transfer electrical energy between &bcompatible&r components. It is &bpart&r of the mod's electrical system, alongside connectors and other wiring components. Use it to build reliable &bconnections&r between your &belectrical&r machines and power network."]
	quest.7E345451D20ABDBF.quest_subtitle: "将电力输送到你的工厂各处"
	quest.7E35AC9122466A50.quest_desc: [
		"&a在末地要塞深处猎杀&r凋零骷髅。"
		"这些危险的亡灵战士比普通骷髅更强，还能施加凋零效果，即使是经验丰富的冒险者也会感到威胁。"
		"它们也是召唤&b凋零首领&r所需的凋零骷髅头的关键来源。"
	]
	quest.7E35AC9122466A50.quest_subtitle: "下界之骨"
	quest.7E35AC9122466A50.title: "凋零骷髅"
	quest.7E3ED0BE284235C4.quest_desc: ["&d用于在 Hazen N Stuff 中升级 Radiance 装备的&r特殊球体&b&r。"]
	quest.7E3ED0BE284235C4.quest_subtitle: "一个注入了光辉能量的球体"
	quest.7E3FBF9FD8AAE62C.quest_desc: [
		"&l&9A&r&r bigger backpack is useful, but what if every stack could hold more? The Starter Stack Upgrade increases the &bmaximum&r number of items that can be &bstored&r in a single stack inside your backpack."
		""
		"开始&b提升&r你的存储效率，让每个格子都物尽其用。"
	]
	quest.7E3FBF9FD8AAE62C.quest_subtitle: "让每个物品栏能装下更多内容"
	quest.7E3FD26AAEDAF5C8.quest_desc: ["制作一个铁盾，更好地保护自己免受更强敌人的伤害。"]
	quest.7E3FD26AAEDAF5C8.quest_subtitle: "用铁盾来升级你的防御力吧！"
	quest.7E5DC58F49F2247C.quest_desc: [
		"&9&l你的&r&r收藏在增长，你的存储空间也应随之增长。4k 存储磁盘比 1k 版本提供了大得多的数字存储容量，&b让你&r可以在 Refined Storage 网络中存放更多资源。"
		""
		"将其插入磁盘驱动器，并&b继续&r扩展你的数字存储系统。"
	]
	quest.7E5DC58F49F2247C.quest_subtitle: "扩展你的数字存储容量"
	quest.7E97A19892D67000.quest_desc: [
		"在永恒星光中，被诅咒花园的&a中心&r，月之怪物正在等待。"
		"这个强大的首领无法被正常伤害——必须先点燃它的身体，才能使其变得脆弱。"
		""
		"只有那些&b了解&r其&b弱点&r并在混乱竞技场中幸存下来的人才能击败它。"
	]
	quest.7E97A19892D67000.quest_subtitle: "焚烧巨兽"
	quest.7E97A19892D67000.title: "&l&d月之&b怪物"
	quest.7E9AB07322B4C76F.quest_desc: ["&a结合&r两种最强的材料，能创造出真正强大的东西。钻石下界合金是你能获得的最先进的&b材料&r之一。"]
	quest.7E9AB07322B4C76F.quest_subtitle: "终极融合体"
	quest.7E9AB07322B4C76F.title: "钻石下界合金锭"
	quest.7EA0BB2A661CAF74.quest_desc: ["&aZoglin奖杯&r是My Nether's Delight中的一个装饰性奖杯。它能展示你在下界的&b冒险&r，并可放置以纪念你&b击败&r了其中一种危险的生物。"]
	quest.7EA0BB2A661CAF74.quest_subtitle: "纪念击败了一只Zoglin的奖杯"
	quest.7EAA5FBC5D509380.quest_desc: [
		"&e一顶&r看似滑稽却意外实用的帽子。"
		""
		"&b新奇&r饮帽能让你吃喝更快，随时准备迎接下一场冒险。非常适合那些&b拒绝&r原地不动的冒险家。"
		""
		"&b戴上它，&r再也不会浪费时间喝东西了。"
	]
	quest.7EAA5FBC5D509380.quest_subtitle: "既然可以一直移动，何必停下来喝水呢？"
	quest.7EB471CBE7F64C2F.quest_desc: [
		"&6当&r普通飞艇不够用时，就该出动重型运输机了。货运飞艇是一种&b更大&r的变种，专为在天空中旅行时携带你的物资而设计。"
		""
		"装载货物，启动引擎，让你的下一次冒险将你的货物带向&b任何地方&r。"
	]
	quest.7EB471CBE7F64C2F.quest_subtitle: "更多空间，更多货物，更多翱翔天际的理由。"
	quest.7EC9E6436F61CA3C.quest_subtitle: "更多盔甲 (More Armor)"
	quest.7ECB1BDBCA5D9161.quest_desc: ["&6全向速度控制器&r是 Create: Dreams n' Desires 中的一个高级旋转组件。它&b用作&r串联式速度控制器，让你能精确控制机械系统的转速。在需要直接速度控制的紧凑和先进的 Create &b装置&r中，它尤其&b实用&r。"]
	quest.7ECB1BDBCA5D9161.quest_subtitle: "精准控制旋转角度"
	quest.7EDD4D32BB876974.quest_subtitle: "更多盔甲 (More Armor)"
	quest.7EDF3CA9D97E2642.quest_desc: [
		"&9&l物品&r&r并非你的 Refined Storage 网络所能存储的唯一内容。64B 流体存储磁盘可提供海量的数字流体存储空间，&b让你&r能够在网络内储存大量液体。"
		""
		"&b插入&r到磁盘驱动器中，并&b连接&r流体系统，通过一个集中网络来存储和访问液体。"
	]
	quest.7EDF3CA9D97E2642.quest_subtitle: "以数字形式存储大量流体"
	quest.7EED2CC7E07E2A1E.quest_desc: ["&6Turns&r &belectricity&r into rotation. The motor's speed depends on the &bvoltage&r you provide. Connect its shaft to Create machines."]
	quest.7EED2CC7E07E2A1E.quest_subtitle: "将电能转化为旋转动力"
	quest.7EF5E5A1A6C395E5.quest_desc: [
		"&9&lPush&r&r your Sophisticated Storage container beyond Gold Tier and upgrade it to Diamond Tier. This powerful upgrade &bsignificantly&r improves your storage &bcapabilities&r and brings your container closer to the ultimate storage tiers."
		""
		"&b升级&r你的储物空间，用钻石的力量和声望，为你的储物进阶做好最后&b阶段&r的准备。"
	]
	quest.7EF5E5A1A6C395E5.quest_subtitle: "将你的储物系统提升到全新的高度"
	quest.7EF732C90BA7DB6D.quest_desc: [
		"&dPaladin&r Chestplate is the Crystal Chronicles &bupgraded&r version of Priest Robes from Iron’s Spells ’n Spellbooks."
		""
		"使用 Divinite Shard 进行 &b升级&r，将原本的 Priest Armor 转变为强大的 Paladin Armor 套装。Divinite Shard 将神圣魔法的力量&b注入&r盔甲，创造出比原版 Priest 装备更强大的形态。"
	]
	quest.7EF732C90BA7DB6D.quest_subtitle: "由神圣能量加持的增强型牧师胸甲"
	quest.7F1027ED71B7F405.quest_desc: [
		"&d霜卫戒指&r能免疫冰冻，保护你免受低温和&b霜冻类&r危险的影响。"
		""
		"&b装备&r戒指，在寒冷环境中探索而不会被减速。"
	]
	quest.7F1027ED71B7F405.quest_subtitle: "获得对严寒的免疫效果"
	quest.7F35E9098DEB72C3.quest_subtitle: "更多盔甲 (More Armor)"
	quest.7F36DEA0C5DA7B78.title: "不可能，绝对不可能！"
	quest.7F3C32860D751BAC.quest_desc: [
		"下界合金锤是一种重型工具和武器，需要与&a永恒砧&r一起锻造永恒装备。"
		""
		"没有它，就无法将原始Aeternium加工成板状物和&b工具头&r。"
	]
	quest.7F3C32860D751BAC.quest_subtitle: "下界合金锻造锤的锻造锤"
	quest.7F62DF594F61A754.quest_desc: ["&6从Create模组中获取&r蒸汽哨。它是一种由蒸汽驱动、用红石激活的乐器方块。可以&b将其&r放置在流体储罐上，调校不同音高，并扩展以&b创造&r不同的音阶。蒸汽哨也可以&b安装在&r火车上，用作火车的专属鸣笛声。"]
	quest.7F62DF594F61A754.quest_subtitle: "让工厂宣告它的到来吧"
	quest.7F6DABCFDD09F335.quest_desc: ["&dVolt&r Spear 是《水晶编年史》中的一把武器，&b与&r强化的 Electromancer 装备相关。它汇聚了闪电魔法和 Voltite 的电能，&b使其&r成为专注于闪电的施法者手中的强力武器。"]
	quest.7F6DABCFDD09F335.quest_subtitle: "用伏特矿石的力量锻造的雷矛"
	quest.7F6F028F8415FD4D.quest_desc: [
		"&a探索&r龙之墓，一个遍布着破损苔石黑曜石柱和发光蓝蘑菇的醒目红色生物群系。"
		""
		"萤火虫在空中飞舞，为这片诡异而充满活力的生物群系增添了独特的&b景致&r。"
	]
	quest.7F6F028F8415FD4D.quest_subtitle: "陨落巨人的安息之所"
	quest.7F6F028F8415FD4D.title: "龙之墓穴"
	quest.7F70095415342E3E.quest_desc: ["&6The&r Zinc Tools are a complete set of tools added by Create Stuff 'N Additions. The set includes a Pickaxe, Axe, Sword, Shovel and Hoe, giving Zinc another &buseful&r purpose beyond the &bmachinery&r of Create. Craft the full set and put this versatile &bmaterial&r to work."]
	quest.7F70095415342E3E.quest_subtitle: "让锌发挥作用吧"
	quest.7F70095415342E3E.title: "锌制工具"
	quest.7F79E892485837D5.quest_desc: [
		"&9&l使用过滤升级，保持&r&r你的存储系统井然有序。它能控制哪些物品可以通过漏斗、管道和&b其他&r物品运输系统等&b自动化&r手段放入或取出背包。基础版提供9个过滤槽位。"
		""
		"高级过滤升级&b让你&r拥有更精细的控制，提供16个过滤槽，可按物品、模组、标签、NBT数据和耐久度过滤。你还可以选择过滤器是作用于物品&b进入&r背包、离开背包，还是两者兼有。"
	]
	quest.7F79E892485837D5.quest_subtitle: "完全掌控进出背包的物品内容"
	quest.7F79E892485837D5.title: "过滤器 \& 高级过滤器升级"
	quest.7F80BB691F39098A.quest_desc: ["&6Craft&r the Inverted Clutch and Inverted Gearshift to gain &breversed&r redstone control over your &bkinetic&r network. Unlike their normal counterparts, these components operate with inverted logic, making them useful when you want machinery to run by default and stop or change behavior when a &bredstone&r signal is applied. Both are part of Create: Connected."]
	quest.7F80BB691F39098A.quest_subtitle: "将红石逻辑反转"
	quest.7F80BB691F39098A.title: "倒置离合器 \& 倒置换挡杆"
	quest.7F8E2B32B4DD5A06.quest_desc: ["&6Craft&r the Fan Ending Catalyst using a Dragon Head and &buse&r it with an Encased Fan to perform Ending recipes. Bring the power of the End into your automated &bfan-processing&r setups."]
	quest.7F8E2B32B4DD5A06.quest_subtitle: "驾驭末地的力量，释放无尽潜能"
	quest.7F96EEF096B64D00.quest_desc: ["&6A&r 通电后会发光的装饰性电线。在合成台里用任意数量的染料和它结合，可以改变它的图案。"]
	quest.7F96EEF096B64D00.quest_subtitle: "装饰性串灯"
	quest.7F9B93826B86334E.quest_desc: [
		"&6有时&r，最好的探索方式是向前看。望远镜的放大倍数是普通潜望镜的两倍，能让你更&b清晰地&r看到远方的地形、建筑以及地平线之外的任何事物。"
		""
		"&bMount&r 到你的飞行器上，并注视前方。"
	]
	quest.7F9B93826B86334E.quest_subtitle: "从一个全新的视角看待世界。"
	quest.7FA998C2837BBED4.quest_desc: ["在地下开采铁矿石以获得&a生铁&r。铁是Minecraft中最重要的&b材料&r之一，能让你制作耐用的工具、盔甲和许多实用物品。这是你旅途中的重大进展。"]
	quest.7FA998C2837BBED4.quest_subtitle: "推进进度所需的关键资源"
	quest.7FA998C2837BBED4.title: "&#A9A9A9原矿 &#E7E7E7铁"
	quest.7FADE016969EDE00.quest_desc: ["&6欢迎来到&r《创造：蒸汽之声》！这个&b扩展包&r为《创造》带来了管风琴，包含多种风琴音栓和音乐组件。建造你自己的机械风琴，用音乐填满你的&b工厂&r吧。"]
	quest.7FADE016969EDE00.quest_subtitle: "用音乐让你的工厂充满活力"
	quest.7FADE016969EDE00.title: "&l&6欢迎来到创造蒸汽之声模组"
	quest.7FB0BB3E24A7FADA.quest_desc: ["&6A&r 用于高于LV开关电压的手动开关。将其放入电路中并点击以切换&b电力&r。"]
	quest.7FB0BB3E24A7FADA.quest_subtitle: "一个中压开关"
	quest.7FEA532FECAEBCAD.quest_desc: [
		"&9&l每个&r&r伟大的背包升级都始于某处。升级基座是创造各种升级所必需的核心组件，从物品&b&r收集和存储改进到强大的实用工具。"
		""
		"制作一个，然后&b开始&r按照你想要的方式建造你的背包。"
	]
	quest.7FEA532FECAEBCAD.quest_subtitle: "更出色的背包的基础建设正在进行中"
	quest.7FFB253F69B7A1A1.quest_desc: [
		"制作一个&a胶卷&r来存储用相机拍摄的照片。"
		"需要使用胶片卷来&b捕捉图像&r，然后用你的星际投影仪进行投影。"
	]
	quest.7FFB253F69B7A1A1.quest_subtitle: "捕捉你的回忆，封存美好瞬间"
