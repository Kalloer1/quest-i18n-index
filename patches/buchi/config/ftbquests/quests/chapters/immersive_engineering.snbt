	order_index: 8
	quest_links: [ ]
	quests: [
		{
			description: [
				"此模组没有外部维基，因此我们必须依赖游戏中的&a手册&r。幸运的是，开发者投入了大量时间编写这份&a手册&r，它将为你提供很好的帮助。&r"
				""
				"哦，是的，这个模组需要很大的空间。 计划建一个大工厂吧 :)"
			]
			id: "5A60751EB3771E5A"
			rewards: [{
				count: 2
				id: "0A4B4EB4E2E8B6BE"
				item: "minecraft:iron_ingot"
				type: "item"
			}]
			size: 1.5d
			subtitle: "&c轨道炮&r、&b特斯拉线圈&r、&e转轮手枪&r、&d带电围栏&r、&a自动化炮台&r。这一切及更多内容，尽在&e沉浸式工程&r。我们的旅程始于制作详尽的&a工程师手册&r。&r"
			tasks: [{
				id: "1B70CE3E079B87B9"
				item: "immersiveengineering:manual"
				type: "item"
			}]
			x: -20.0d
			y: 0.0d
		}
		{
			dependencies: ["5A60751EB3771E5A"]
