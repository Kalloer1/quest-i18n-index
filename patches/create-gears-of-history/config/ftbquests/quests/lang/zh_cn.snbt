		""
		"&e自动修复&r：穿戴时，金质盔甲会逐渐恢复耐久度，使该套装更实用。"
	]
	quest.547BA1908D596A0E.title: "黄金盔甲"
	quest.55A06B8657545AF2.title: "玫瑰石英"
	quest.55C8462AEA66561B.quest_desc: ["在本整合包中，龙之蛋可以作为配饰佩戴，为玩家提供特殊效果。"]
	quest.55C8462AEA66561B.title: "一个蛋？要它干嘛用？"
	quest.595EFF9DC26552C5.title: "黄铜机器"
