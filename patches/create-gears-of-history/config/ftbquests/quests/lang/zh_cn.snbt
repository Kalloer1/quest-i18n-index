	quest.2A9ABB7C959C665C.quest_subtitle: "{count:1,id:\"refinedstorage:1024b_fluid_storage_block\"}"
	quest.2B27E4E04A628C60.quest_desc: [
		"&9速度升级&r的作用正如其名。它能加快界面和方块的工作速度。需要更快的导入器？想让合成台更快？这就是你的升级！"
		""
		"&9堆叠升级&r将传输速度提升至一整个物品堆叠，而非单个物品。可与速度升级结合使用！"
	]
	quest.2B27E4E04A628C60.title: "让一切都加速起来！"
	quest.2BB884AF43ADC4A6.title: "需要更多力量吗？"
	quest.2CCC67629B95C82C.title: "[开发中] 山谷的彼端"
	quest.2E2811D1A0F2A492.quest_desc: [
		"要扩大与系统的无线连接范围，你需要制作&9范围升级&r。"
		""
		"无线发射器最多只能容纳4个。这里有一个免费的送给你。"
	]
	quest.2E2811D1A0F2A492.title: "增加传输范围 (Increasing Transmitting Range)"
	quest.306FBB49118CCA8D.quest_desc: ["这在服务器上会非常有用。"]
	quest.30AC00BDC58730C5.quest_desc: [
		"在本整合包中，使用砧板修复物品变得更便宜了，这样你的工具就能用得久一些。任何有效的修复材料都适用。"
		""
		"与原版不同，使用砧板重命名或修复物品时，不会对后续操作造成等级惩罚。"
	]
	quest.30AC00BDC58730C5.title: "廉价修复"
	quest.3102F1F1F7ABCAA8.quest_desc: [
		"基础的黄铜装置需要3个水槽排成一行，每个间隔1格。"
		""
		"两个外盆地分别产出熔铜和熔锌"
		""
		"想办法将两种液体都推入中央的 Basin 以生成黄铜。"
	]
	quest.3102F1F1F7ABCAA8.title: "黄铜合金"
	quest.312996060B90E18A.quest_desc: ["几乎所有创造装置，你都可以按住物品的“Ponder”键来查看它们的设置。"]
	quest.3134AA1A1DAE3E4D.quest_desc: [
		"在本整合包中，黄金工具更强大："
		""
		"&e采矿等级提升&r：黄金工具可以挖掘至铁质工具级别的方块。"
		""
		"&e自动修复&r：当工具在主动手持时，金质工具会随时间缓慢恢复耐久度，使其更实用。"
	]
	quest.3134AA1A1DAE3E4D.title: "黄金工具"
	quest.31469CC0E51402FB.quest_desc: [
		"此整合包包含脉矿挖掘功能。"
		""
		"只需按住可配置键（默认为“U”）即可同时采集多个方块，简化你的挖矿流程。"
		""
		"在早期游戏中尤其有用。"
	]
	quest.31469CC0E51402FB.title: "脉矿挖掘"
	quest.326ABA1B37E77C73.quest_desc: [
		"在本整合包中，你无法徒手撸木头。试着通过撸树叶来收集木棍吧。"
		""
		"如果你附近没有树，可以种一棵。这里有一棵树苗送给你！"
	]
	quest.326ABA1B37E77C73.title: "获取木材"
	quest.32A81A24A8565209.quest_desc: [
		"工具腰带默认只有2个格子。你可以在铁砧上用口袋来增加它的容量"
		"（最多9个物品栏，或7个升级）。"
	]
	quest.32CC5131DA8A2CE8.quest_desc: [
		"你可以在合成台里使用 Crushing Hammer 来提高所收集的原矿石的产量。"
		""
		"这对早期游戏尤其有帮助。"
		""
		"不过要小心，它的耐久度很低。建议用铜锭在铁砧上修理，比制作新的便宜得多。"
	]
	quest.34DB6863E6CF1B70.quest_desc: [
		"让你可以访问你的 RS 系统的每个部分。"
		""
		"这是一体化无线终端。你可以在这里使用合成网格、流体网格，并查看自动化合成。"
	]
	quest.34DB6863E6CF1B70.title: "通用网格 (Universal Grid)"
	quest.34F6CCF469F8BA42.quest_desc: [
		"在本整合包中，箱子、熔炉或刷怪器等方块实体可以轻松移动，同时保留其内容物。"
		""
		"空手状态下，对着其中一个箱子按 SHIFT + 右键试试！"
	]
	quest.34F6CCF469F8BA42.title: "可移动的箱子"
	quest.3540A5013B90BF67.quest_desc: [
		"你可以用 Watterlogged Leaves 和 岩浆 制作一个 &3鹅卵石生成器&r。"
		""
		"现在你只需要找到方法把产物取回来就行了..."
	]
	quest.3540A5013B90BF67.title: "早期游戏自动化整合包"
	quest.35637D0BF8CD6E95.title: "铜质盔甲"
	quest.3851D000F69C99F0.title: "熔融锌"
	quest.39C8833E6BE21817.title: "超巨型管道！"
	quest.39FFCAD0284E5F66.title: "可再生烈焰蛋糕"
	quest.3AFD7C2C6F4810E0.quest_desc: [
		"存储终端可以连接到任何类型的物品栏或存储设备，并显示其中的物品。"
		""
		"借助线缆，它可以充当物品栏之间的连接器，从而创建一个大型储物空间。"
	]
	quest.3B089CA14459F118.title: "装在箱子里的猪灵"
	quest.3BDFE13115293F23.title: "物品正在移动中！"
	quest.4068B736CA930513.title: "木制工具"
	quest.407B628466BD30DA.title: "铜制工具"
	quest.4103D16FD1FC2B1E.title: "安山岩机器 (Andesite Machines)"
	quest.4310709D0F1539EB.title: "木棍"
	quest.437C5320DE378471.title: "Electrum 工具"
	quest.43E8912CB307E421.quest_desc: [
		"太棒了！我们可以在虚拟空间里存放物品，但怎么查看网络上的内容呢？"
		""
		"要访问该系统，你需要创建一个&9网格&r。网格是展示背包中物品最基本的“显示”形式。"
	]
	quest.43E8912CB307E421.title: "正在访问我们的网络存储设备"
	quest.44881E39AB1D62AA.quest_desc: [
		"&9Crafter&r是我们存储配方用的，网络需要它来知道如何合成物品。"
		""
		"这些存储的配方被称为&9模式&r。你可以使用模式网格将配方印刻到网络的模式中。"
		""
		"将配方放入合成台后，你就可以向网格“请求”合成物品。点击有配方的物品，按住 CTRL+Shift 即可打开合成界面。"
		""
		"此方块也可朝向机器放置以使用&9处理模式&r。例如，将合成台对准熔炉，即可放入需要熔炉的配方，如熔炼原始处理器。"
		""
		"只要制造台连接到你的系统，熔炉也连接了导入器，制造台就会允许你请求熔炼后的处理器！"
	]
	quest.44881E39AB1D62AA.title: "自动化合成"
	quest.453F38AA8D11C581.title: "可再生燃料"
	quest.4721565D8F4840AB.quest_desc: [
		"本整合包采用了与原版不同的&3食物系统&r，使 Farmer's Delight 在你的冒险中占据重要地位。"
		""
		"这里有&n三个食物栏&r，你必须用各种餐食填满它们。"
		""
		"食用食物会填充一个槽位，为你提供增加生命值和再生效果的增益，直到效果消失。"
		""
		"计时器结束（或快结束）之前，你都无法再吃那种食物。"
		"{@pagebreak}"
		"你将拥有&n三颗心&r，并获得缓慢的再生效果。"
		""
		"你必须吃东西来增加它，最多可以增加一整格额外的爱心，前提是你&n吃营养餐&r（例如来自 Farmer's Delight 的）。"
		""
		"食物品质也会影响再生效果，以及食物栏中用餐的总时长。"
		""
		"将鼠标悬停在食物上即可查看这些属性。食用后，计时器会出现在快捷栏上方。"
		"{@pagebreak}"
		"该系统最终平衡了游戏的许多方面："
		""
		"- 你必须&n规划何时进食&r和吃什么食物，而不是只啃面包。"
		"生存更困难，因为你不会满血开局，并且&n必须吃好东西&r来恢复饱食度。"
		"- 战斗更困难，因为&n你只有在几秒钟内未受到伤害时才会恢复生命值&r（不过你仍然可以随时吃金苹果）。"
		"{@pagebreak}"
		"- 种植和烹饪更有回报，因为你不能再靠普通食物过日子，而&n必须制作美味佳肴&r。"
		"- 最后，烘焙蛋糕终于派上了用场，能为你提供多餐食物，重生后能快速补充体力。"
		""
		"你也可以通过&n呕吐&r来&n重置&r当前已吃的食物，而呕吐可以通过吃腐肉来触发。"
	]
	quest.4721565D8F4840AB.title: "农夫的欢乐时光"
	quest.4CE8193EBC756274.quest_desc: ["铁矿石最常见于Y坐标15左右。"]
	quest.4CE8193EBC756274.title: "分解：12x 粗铁"
