	quest.6904EC449FBEE387.quest_desc: [
		"&9电缆&r用于将方块和物品连接到你的系统中。"
		""
		"起初，你只需将方块并排放置即可连接到系统中，但电缆能让你扩展得更远！这是任何 Refined Storage 网络的基础。"
		""
		"Exporter、Importer 和 External Storage 线缆可以让你将物品进出你的系统。"
	]
	quest.6904EC449FBEE387.title: "电缆"
	quest.6A0BA04368961A62.title: "铁质工具"
	quest.6AFC0E78A205B2D0.title: "锭的铸造"
	quest.6B04FC81351CD1AB.quest_desc: [
		"如果你想无线访问你的 Refined Storage 网络，首先需要创建一个 &9无线发射器&r 和任意类型的 &9无线网格&r。"
		""
		"你可以在系统的任何位置放置发射器。然后用右键将无线电网与你的系统连接。现在你应该可以远程访问你的存储了。"
	]
	quest.6D536132DFC006DC.quest_desc: ["制作或回收你的第一个熔炉。"]
	quest.6FF860AD25032DC8.quest_desc: [
		"在本整合包中，你可以使用回溯药水瞬间传回存档位置！还有适用于下界和末地的药水。"
		""
		"在任意有效方块上潜行+右键，即可保存你在各个维度的位置。"
		""
		"可用于保存的有效方块包括："
		"- 主世界： &e篝火、床、磁石&r"
		"- 下界： &e灵魂营火、重生锚、磁石&r"
		"- 末地： &e磁石"
	]
	quest.6FF860AD25032DC8.title: "简易旅行"
	quest.732A1FFD1C2A2889.quest_desc: ["坚固的板状方块是唯一与黑曜石一样坚固的可移动方块。"]
	quest.76C7F2718C532020.quest_desc: [
		"传送石：用于传送。最常见于村庄中。"
		""
		"服务器传送石："
		"- 共享石：与传送石不同，它们无需激活，并且始终对所有人公开。"
		"- 传送石：单向传送。"
		"两者对服务器都非常有用。"
		""
		"Warp Plates：双向传送，适用于你和生物！"
	]
	quest.77A4A0857722D46B.title: "游戏末期装备包"
	quest.7978425AF7F46E09.quest_desc: ["坚固盔甲非常耐用，能提供相当不错的保护。"]
	quest.79B1B4D97101A3FB.quest_desc: ["可免费传送到任意传送石，但有冷却时间。"]
	quest.79E403931F26A161.quest_desc: [
		"在本整合包中，盾牌的机制略有不同。"
		""
		"当盾牌在非主手且未使用时，它将不会被渲染。当玩家右键举起盾牌时，它会再次显示，以原版方式保护玩家。"
		""
		"当盾牌未举在副手或闲置在主手时，&3它仍能提供部分被动防护&r，最高可达举起时的三分之一。"
	]
