# AI 初翻，未人工校对
{
	chapter.1000000000000001.chapter_subtitle: ["食物、水、气候、石器、稻草、陶器，以及迈向铜器的第一步。"]
	chapter.1000000000000001.title: "石器时代"
	chapter.1000000000000002.chapter_subtitle: ["第一种稳定的金属，铸造铜制砧，并为机械动力做早期准备。"]
	chapter.1000000000000002.title: "铜器/青铜器时代"
	chapter.1000000000000004.chapter_subtitle: ["铸铁、锻块、锻铁，以及第一批正式的容器。"]
	chapter.1000000000000004.title: "铁器时代"
	chapter.1000000000000006.chapter_subtitle: ["全面电气化之前的橡胶、树脂、泵、发动机和重型机械。"]
	chapter.1000000000000006.title: "工业时代"
	chapter.1000000000000007.chapter_subtitle: ["早期电力、电缆、船体、电路和基本机器。"]
	chapter.1000000000000007.title: "LV电气时代"
	chapter.1000000000000008.chapter_subtitle: ["MV/HV、石油、化学、不锈钢、铝、钛和先进电子元件。"]
	chapter.1000000000000008.title: "高级工业模组 (Advanced Industry)"
	chapter.72BB266DC9850667.title: "军事基地"
	quest.01AAA0C672C79A66.quest_desc: ["早期的水轮在引擎普及前可提供低技术旋转动力。在有河流或渠道的地方，它们非常实用。"]
	quest.01AAA0C672C79A66.title: "水车"
	quest.02DE0D80435AAAAA.quest_desc: ["钢制剑是第一批真正的钢制武器。随着锻造的深入，更高级的钢制变种会提升耐久度和战斗性能。"]
	quest.034C79C5A64A4703.quest_desc: ["皮革盔甲是用加工过的兽皮制成的简易护具。在金属盔甲实用之前，它很有用。"]
	quest.034C79C5A64A4703.title: "皮革盔甲"
	quest.04ADDDEBAEC0FEC4.quest_desc: ["热气燃烧器加热气球内的空气以帮助升空。根据建造物的重量提供燃料并调整气球大小。"]
	quest.04DC559BCF7D3BF9.quest_desc: ["早期的矿石处理始于手动破碎和清洗。动力清洗后期可产生副产品，但手动清洗更简单。"]
	quest.04DC559BCF7D3BF9.title: "矿石加工"
	quest.053253FDD26A991E.quest_desc: ["涡轮机位于标准 More Propulsion 涡扇发动机的燃烧室之后，利用高温燃气流产生的能量。尺寸和发动机系列需与其他部分匹配。"]
	quest.05651052965E463B.quest_desc: ["温度计让热量和气候更易于直接读取。后期版本在更简单的温度仪器基础上构建，而非免费取代其作用。"]
	quest.062D8346AAD26F1A.quest_desc: ["土豆既是土豆炮的弹药，也是食物。凝固汽油变种有燃烧效果，请在远离基地的地方测试。"]
	quest.068E4A64B6441A50.quest_desc: ["矢量推进器使用FE能量，支持定向推力控制。提供能量并配置红石控制，以操控你的飞行器。"]
	quest.07232440F45E4B70.quest_desc: [
		"原始隔热层和原始衣物是气候防护的第一层。它们不是完整的季节性服装，但可以防止早期天气成为持续的紧急情况。"
		"隔热材料可在缝纫桌上添加。蓝色或青色隔热可抵御寒冷，橙色或红色可抵御炎热，紫色或中性隔热效果较弱，绿色或自适应隔热则能针对当前问题进行调整。"
	]
	quest.079180C843C8A329.quest_desc: ["凿子和大锤扩展了铜制工具的用途。它们是用于塑形方块和更重体力劳动的实用工具。"]
	quest.07D3D536F74CC090.quest_desc: ["固体燃料推进器从后方接收燃料。布置物品供应，并用红石信号控制推进器的开关。"]
	quest.0847DBC1DEFEC89F.quest_desc: ["青铜可以来自多种支持的青铜合金。共享材料标签让这些变体在合金种类不重要的情况下共享进度。"]
	quest.0847DBC1DEFEC89F.title: "青铜锭"
	quest.08DACF0EB5CBB14A.quest_desc: ["鼓风机能改善温度控制，是多个加热系统所需的部件。皮革加工也开始产生回报了。"]
	quest.08F3AE24F79F88B1.quest_desc: ["床既是舒适的工具，也是生成工具，但它需要合适的纺织工艺，而不是简单的原版羊毛配方。"]
	quest.08F3AE24F79F88B1.title: "床"
	quest.090F143FA904A97F.quest_desc: ["花蕊是制作钉子、铆钉和其他小金属零件的中间材料。后期使用锻造配方可以自动化生产。"]
	quest.090F3EF30426D4FA.quest_desc: ["压缩机在怪异的 More Propulsion 涡轮喷气发动机的燃烧室前压缩空气。匹配其他部分的大小和发动机系列。"]
	quest.09D35B334652CBC0.quest_desc: ["Tier 3 的硝棉枪械使用更强的推进剂和更精密的钢材，但仍避免使用最高级的后期合金。"]
	quest.09D35B334652CBC0.title: "Tier 3 火棉枪系列"
	quest.0A4617B66E27552B.quest_desc: ["锻炉产出的是原矿，必须将其冶炼成精矿，锻铁才能发挥作用。"]
	quest.0AD0DECE0BE3CD0B.quest_desc: ["砧板和榨汁机开启了更实用的食物准备工作。它们能将生食材变成菜肴和有用的中间食品。"]
	quest.0B1C18787FA20C6D.quest_desc: ["在熔炉中熔炼含铜的早期材料，然后倒入锭模。这是从石器生存过渡到金属加工的环节。"]
	quest.0BB552AE27BF12DC.quest_desc: ["坩埚是关键的合金步骤。它与材料系统中其余部分使用的统一熔融金属配合工作。"]
	quest.0BB552AE27BF12DC.title: "熔炉（Crucible）"
	quest.0BB6B852D162EABF.quest_desc: ["高炉是青铜时代通往铁器的门户。它将铁矿石锻成铁块，而非纯净的铁。"]
	quest.0BFC8E82B5D3CF3F.quest_desc: ["Helve Hammer 可自动化重锤作业。Bloom 处理等加热锤击操作应归于此，而非通用加热压制。"]
	quest.0C816AE96DA31980.quest_desc: ["焦炭是下一阶段冶金的动力。在本整合包中，高炉需要焦炭；它也可以为木炭锻造炉提供燃料。"]
	quest.0CF7FFECE746826E.quest_desc: ["钢制标枪是简易投掷武器系列的高端版本。红色和蓝色钢制版本价格昂贵，但经久耐用。"]
	quest.0D5CD84C5AA9AC35.quest_desc: ["用稻草和原木建造一个坑窑来烧制未烧制的陶器。在专用窑炉和机器出现前，这仍然是你的主要陶瓷烧制路线。"]
	quest.0D5CD84C5AA9AC35.title: "Pit Kiln"
	quest.0D6EC3FB0FF0657C.quest_desc: ["Wattle and daub 是早期的建筑材料。在石制和金属建筑普及之前，它们提供了一种实用的建造方式。"]
	quest.0E315AE89CC0E531.quest_desc: ["燧石工具是早期的替代刀刃和点火部件。通过手持燧石或燧石废料并右键单击实心石头来塑造燧石链，而不是使用普通的合成网格。"]
	quest.0EE1DD2A4489F103.quest_desc: ["喷嘴构成了大型 More Propulsion 涡扇发动机的排气端，并引导气流。尺寸和发动机系列需与其他部分匹配。"]
	quest.0FF4263C6B13AC3E.quest_desc: ["常规引擎是继最简单的便携式和斯特林引擎之后，更强大的机械选项。预计其配方会侧重于真实的引擎部件。"]
	quest.1100000000000001.quest_desc: [
		"你的第一步是生存，而不是熔炉速成。原版熔炉和冶金学并非预期的早期发展路线。"
		"寻找食物、水、石头、木棍、植物纤维、燧石和骨头。接下来是黏土和坑窑。"
	]
	quest.1100000000000001.title: "第一天"
	quest.1100000000000002.quest_desc: [
		"收集地上的散石。这才是石器时代的真正开端。"
		"有两种石器加工方式。经典打制会打开一个模式 GUI，让你直接塑形工具头。另一种方式是与世界互动：手持松散岩石或石制工具头，右键点击实心石块。"
		"分裂链不同于普通打制：松散岩石 -> 锤头 + 铲头；锤头 -> 斧头；铲头 -> 锄头；锄头 -> 刀头 + 标枪头；刀头 -> 标枪头。不要将这些放入合成台，右键石头即可。产出基于概率，请多带石头。"
	]
	quest.1100000000000002.title: "散落的岩石"
	quest.1100000000000004.quest_desc: ["斧头能将树木变成可靠的物资来源。倒下的树会变成实体原木，所以要规划好它们的落点。"]
	quest.1100000000000004.title: "石制工具"
	quest.1100000000000005.quest_desc: ["火种器是首个可控的点火源。多备几个，早期的火焰本就不稳定。"]
	quest.1100000000000005.title: "火种者"
	quest.1100000000000006.quest_desc: ["火坑开启了基础的烹饪和加热功能，但它还不能完全替代原版熔炉。"]
	quest.1100000000000006.title: "火坑"
	quest.1100000000000007.quest_desc: ["黏土是通往陶器的大门。在潮湿地区附近寻找含黏土的土壤和地表标记。"]
	quest.1100000000000007.title: "粘土"
	quest.1100000000000008.quest_desc: ["小型容器是你处理和运输材料的第一重要容器。"]
	quest.1100000000000008.title: "陶瓷容器"
	quest.1100000000000009.quest_desc: ["锭模为过渡到铜做好准备。金属仍然需要木炭和正确的矿石。"]
	quest.1100000000000009.title: "锭模 Ingot Mold"
	quest.110000000000000B.quest_desc: ["木炭是第一种正经燃料，也是通往金属加工的桥梁。"]
	quest.110000000000000B.title: "木炭（Charcoal）"
	quest.110000000000000C.quest_desc: ["地表的小块天然铜、孔雀石或四方硫化铜矿，标志着铜器时代的开端。"]
	quest.110000000000000C.title: "铜矿踪迹"
	quest.110000000000000D.quest_desc: ["草垛是早期建筑、陶器、茅草、床铺和多种简易材料所需的材料。"]
	quest.110000000000000D.title: "干草块"
	quest.110000000000000F.quest_desc: ["小心砍伐真实的树木，原木会像实体物体一样移动。"]
	quest.110000000000000F.title: "砍伐树木"
	quest.1100000000000010.quest_desc: ["饥饿和口渴是持续的生存压力。不要总依赖一种填充物，要多样化饮食，喝干净的水。食物营养会提升你的最大生命值：均衡的饮食能让你更坚韧，而营养不良即使饥饿条已满，生命值也会很低。食物会随时间变质，所以要储存好，必要时烹饪，并在作物失效前储备过冬的食物。锯末和其他填充物在紧急情况下可以充饥，但它们不是过冬的良策。"]
	quest.1100000000000010.title: "饥饿与口渴"
	quest.1100000000000012.quest_desc: ["大型容器是第一个大型陶瓷容器。在金属储罐之前，它支持存储和几个低技术处理步骤。"]
	quest.1100000000000012.title: "大型船只"
	quest.1100000000000017.quest_desc: [
		"收集草中的植物纤维，将其拧成植物线。许多石制工具不仅需要石头和木棍，还需要一种粘合材料。"
		"植物纤维也是早期过渡到草编、简易工具和后期低科技制作的桥梁。"
	]
	quest.1100000000000017.title: "植物纤维"
	quest.1100000000000018.quest_desc: ["右键拾取地上的树枝，或折断小枝。此分支通向火焰而非石器锻造。"]
	quest.1100000000000018.title: "木棍"
	quest.1100000000000019.quest_desc: ["燧石是一种实用的早期锋利材料，也是多种生存配方中的替代选择。要采集燧石，手持燧石并右键点击实心石块；燧石碎片和箭头使用相同的石块点击采集方式。"]
	quest.1100000000000019.title: "燧石"
	quest.110000000000001A.quest_desc: ["骨头是早期从地面覆盖物和动物身上获得的材料。手持骨头或骨头碎片，右键点击实心石块即可将其分解为原始工具部件。骨头对于胶水、骨粉和后期的实用配方也很重要。"]
	quest.110000000000001A.title: "骨头"
	quest.111922867CC7F722.quest_desc: ["压缩焦粘土和焦炉砖开启了低科技焦炉生产线。此路线特意在含铁量高的机械之前开放。"]
	quest.1200000000000001.quest_desc: [
		"铜遵循的是铸造金属的进阶路线，而非原版锭的路线。"
		"配方需要铜时，请使用通过常规铸造链制成的铜锭。"
	]
	quest.1200000000000001.title: "铜制锭块"
	quest.1200000000000002.quest_desc: ["铁砧解锁了正式的锻造。直接锤制板状物品的功能已被禁用。"]
	quest.1200000000000002.title: "铜制铁砧"
	quest.1261AC20AECB6917.quest_desc: ["机械压机负责处理那些不应是简单手工的板料、塑形和压缩配方。"]
	quest.12C7CC406C871B74.quest_desc: ["钢制砧将锻造提升至熟铁之上，为更高级的钢制等级做好准备。"]
	quest.131A405EC26E81C1.quest_desc: ["使用高炉进行钢铁时代的冶金。更简单的原始熔炉进阶路线并非本整合包的设计方向。"]
	quest.13C9A5D51E7FB5A9.quest_desc: [
		"淬火硬化与锻造质量是独立的。钢制工具头除了原有的锻造加成外，还可以获得淬火效果。"
		"加热工具头，然后将发热的工具头放入装有淬火液体的桶中。"
		"淡水是最安全的基础淬火方式：通常能获得专家级结果，获得完美淬火和淬火失败的概率都较低。"
		"油质水比淡水更稳定，完美硬化的几率略高，失败风险更低。"
		"油是最可靠的可控淬火：仍能产生完美硬化，通常能带来专家级结果，且不会导致淬火失败的负面效果。"
		"盐水是最具攻击性的淬火方式：完美淬火概率最高，但淬火失败的概率也最高。"
	]
	quest.13C9A5D51E7FB5A9.title: "淬火硬化（Quench-Hardening）"
	quest.1400000000000001.quest_desc: ["铁矿石熔炼成铸铁。纯铁并非早期从矿石中大量生产的产物。"]
	quest.1400000000000001.title: "铸铁 (Cast Iron)"
	quest.1400000000000003.quest_desc: ["锻铁是大多数配方中早期铁的通用替代品。它不能通过简单的重熔获得。"]
	quest.1400000000000003.title: "锻铁（Wrought Iron）"
	quest.1408EB67CA96DC67.quest_desc: ["燃烧室在巨大的 More Propulsion 涡扇发动机中燃烧燃料。在本整合包中，GTCEu 轻质燃料替代煤油。请匹配其他部分的尺寸和发动机系列。"]
	quest.14C11CAF8C6E87C3.quest_desc: ["燃烧室在标准的 More Propulsion 涡轮喷气发动机中燃烧燃料。在本整合包中，GTCEu 轻质燃料替代煤油。请匹配其他部分的尺寸和发动机系列。"]
	quest.14EA33EC86BE9029.quest_desc: ["背包是存储升级，不是移动工厂。仅保留少数几个提升便利性的背包升级。"]
	quest.152DDD9C3BA36B82.quest_desc: [
		"亚麻衣物是一种透气植物纤维制成的服装，比粗糙的早期衣物更结实舒适，但仍比羊毛或皮毛更轻便。在温和和温暖的气候中，是一套不错的日常服装。"
		"{\"text\":\"Orange\",\"color\":\"gold\",\"extra\":[{\"text\":\"/\",\"color\":\"white\"},{\"text\":\"Red\",\"color\":\"red\"},{\"text\":\" insulation fits linen best when you want a light outfit for warm travel.\",\"color\":\"white\"}]}"
	]
	quest.152DDD9C3BA36B82.title: "亚麻衣物"
	quest.15846E97B55E4C03.quest_desc: ["早期的篮子和箱子很重要，因为物品栏压力是生存的一部分。在金属物流系统普及前，先使用它们。"]
	quest.1600000000000003.quest_desc: ["便携式引擎是一种中期动力源。它应该比柴油更容易，但不是免费的。"]
	quest.1600000000000003.title: "便携式引擎"
	quest.1600000000000004.quest_desc: ["柴油发动机是一种更先进、更昂贵的机械动力形式，与钢铁组件和燃料链相关。"]
	quest.1600000000000004.title: "柴油发动机"
	quest.160B48C0DBF93BBD.quest_desc: [
		"原始衣物是前几季的粗糙应急装备。最好用作抵御轻微寒冷或炎热的临时缓冲，直到有合适的布制服装为止。"
		"{\"text\":\"Purple/Neutral\",\"color\":\"light_purple\",\"extra\":[{\"text\":\" insulation is the most sensible use here: primitive clothing is a stopgap, not a specialized winter or desert set.\",\"color\":\"white\"}]}"
	]
	quest.160B48C0DBF93BBD.title: "原始服装"
	quest.16B25A93BEC5CACE.quest_desc: ["经过处理的木材由焦油制成。使用桶浸泡是推荐方法；桶合成已被移除。"]
	quest.16E0B307489B86A3.quest_desc: ["将木棍收集成束，保持紧凑的库存。这在需要比单根木棍更多木材的配方中很有用。"]
	quest.1700000000000001.quest_desc: ["LV机器外壳是通往真正电气时代的主要入口。"]
	quest.1700000000000001.title: "LV 机器外壳"
	quest.1700000000000002.quest_desc: ["电路的进阶仍是电气时代的主要限制。机械组件应支持此阶段，而非绕过它。"]
	quest.1700000000000002.title: "基础电路"
	quest.1700000000000003.quest_desc: ["机械车床能处理许多早期的车削任务，而这种电动车床则成为更可靠的机器标准。"]
	quest.1700000000000003.title: "LV 车床"
	quest.1700000000000004.quest_desc: ["电气矿石加工能实现更深入的加工，但副产品会调整为更真实的材料。"]
	quest.1700000000000004.title: "LV 破碎机"
	quest.171E066BBA9C9590.quest_desc: ["Pre-steel swords are bronze-age weapons. They are useful before steel, but they should not replace proper steel blades forever."]
	quest.171E066BBA9C9590.title: "Pre-Steel Swords"
	quest.17D786CD9696C663.quest_desc: ["大锤比普通锤子更重。适合需要大力而非精细塑形的工作。"]
	quest.17D918A2CBDE9961.quest_desc: ["许多配方中，普通工作台会被专业工作台取代。能制作专业木材后就建造一个吧。"]
	quest.17D918A2CBDE9961.title: "工作台"
	quest.1800000000000001.quest_desc: ["不锈钢和铬被统一到一个材料链中，以避免重复的锭、板和流体。"]
	quest.1800000000000001.title: "不锈钢"
	quest.1800000000000002.quest_desc: ["铝将成为航空、引擎以及后期机械的重要结构材料。"]
	quest.1800000000000002.title: "铝（Aluminium）"
	quest.1800000000000003.quest_desc: ["合成橡胶遵循正确的中间组件，沿石油化学链进行。跳过这些阶段的快捷方式已被禁用。"]
	quest.1800000000000003.title: "合成橡胶"
	quest.1800000000000004.quest_desc: ["磁性材料被统一为专用的磁性锭、板和方块，而不是单独的重复合金。"]
	quest.1800000000000004.title: "磁性材料"
	quest.183DBBCEDEB4544A.quest_desc: ["锻锤和钢泵标志着更重的机械基础设施。它们应在钢铁冶炼建立之后出现。"]
	quest.189FA5CEAE8867F4.quest_desc: ["密封风扇是一种实用的机械基础设施。当正确放置并通电时，它可以替代风箱，为需要气流的加热系统提供气流。"]
	quest.18C87A8331734DCE.quest_desc: ["土豆炮是一种简单的远程实用武器。可安装的版本属于更重的机械装置。"]
	quest.18EE80F7F03F5CF4.quest_desc: ["加固耐火砖能提升你的耐热材料。在本整合包中，它们用于制作 Create Metallurgy 工业熔炉。"]
	quest.19145F5A6C371929.quest_desc: ["火药装填量大有不同。小堆、中堆、普通火药和压实装填代表不同的弹药负载。"]
	quest.192E98B7D45B0AE7.quest_desc: [
		"棉质衣物是适合温暖季节和炎热地区的轻便透气装备。它不是冬季套装，但在过热是主要危险时穿着会很舒适。"
		"{\"text\":\"Purple/Neutral\",\"color\":\"light_purple\",\"extra\":[{\"text\":\" insulation is cotton's main role: broad light protection for mixed everyday weather.\",\"color\":\"white\"},{\"text\":\" Blue/Cyan\",\"color\":\"aqua\"},{\"text\":\" adds a small cold-side bias, so it can help a little when temperatures dip without becoming a winter outfit.\",\"color\":\"white\"}]}"
	]
	quest.192E98B7D45B0AE7.title: "棉质衣物"
	quest.194C8BD503B7824A.quest_desc: ["风力是一种早期的可再生机械动力来源，但仍需要布和适当的机械装置。"]
	quest.1984143A17F54ED5.quest_desc: ["风车叶片来自织布机制作的布。这使得大型早期动力源与农业和纺织工作相关联。"]
	quest.1984143A17F54ED5.title: "风车"
	quest.198DBCA8CD28476E.quest_desc: ["地表矿脉枯竭后，探矿镐是寻找更深层矿体的正确工具。"]
	quest.1A646F5E6A26E0CE.quest_desc: ["木制多块储罐在金属储罐和电动泵普及前，提供了早期的流体批量存储。"]
	quest.1A646F5E6A26E0CE.title: "木制多区块坦克"
	quest.1AA0060656FD9BA8.quest_desc: ["木炭坑是可扩展的木炭路线。任务要求更大的批次，因为金属加工消耗燃料很快。"]
	quest.1AA0060656FD9BA8.title: "木炭坑"
	quest.1B31811F67A97289.quest_desc: ["Tier 2 火药枪械添加了更好的材料和更完整的机制，但仍使用传统的黑火药装填。"]
	quest.1B31811F67A97289.title: "Tier 2 火药枪械"
	quest.1BB15EFEA542C45F.quest_desc: ["喷嘴构成了大型 More Propulsion 涡轮喷气发动机的排气端，并引导气流。尺寸和发动机系列需与其他部分匹配。"]
	quest.1DC1487FAD35E112.quest_desc: ["砖制焦炭炉将煤炭转化为焦炭，用于更高温的冶金。褐煤产量最低，烟煤较好，而无烟煤每块产生的焦炭最多。"]
	quest.1DC1487FAD35E112.title: "焦炭炉 Coke Oven"
	quest.1DEAFF215DB3124B.quest_desc: ["Tier 1 的硝棉枪械为武器引入了更清洁、更强劲的推进剂，而这些武器仍主要依赖钢铁制造。"]
	quest.1DEAFF215DB3124B.title: "Tier 1 火棉枪"
	quest.1E13C86414920C57.quest_desc: ["Firmalife 养蜂支持食物和材料链。可选，但木工稳定后很有用。"]
	quest.1E911D6BC074BC6F.quest_desc: ["青铜砧是青铜级锻造的真正开端，并为向高炉铁过渡做好准备。"]
	quest.1E911D6BC074BC6F.title: "青铜砧台"
	quest.1EC4E3B26941EDDD.quest_desc: ["径向引擎是一种更复杂的引擎路径。它们应该在更简单的机械引擎之后，而不是在发电的最初阶段。"]
	quest.1F487C93822B190B.quest_desc: ["锻铁砧是严肃的铁器时代工作和许多后期锻造配方所必需的基础砧。"]
	quest.20A2781A8A2AD9E7.quest_desc: ["红色和蓝色的钢桶能处理普通容器无法处理的流体。它们是后期的金属工具，而非早期的捷径。"]
	quest.20A2781A8A2AD9E7.title: "红色和蓝色钢制水桶"
	quest.21A442A498A8F08F.quest_desc: ["液体矢量推进器结合了燃料动力和方向控制。从下方供给燃料，并设置红石信号来控制引擎。"]
	quest.23F28A68974F8634.quest_desc: ["涡轮机位于燃烧室之后，是巨型 More Propulsion 涡扇发动机的一部分，利用高温燃气流产生的能量。尺寸和发动机系列需与其他部分匹配。"]
	quest.254458BB76CE6394.quest_desc: ["曲轴是用于更精密发动机和移动组件的精密机械部件。"]
	quest.258FB389085D5C46.quest_desc: ["金属桶和罐子是紧凑的流体和食物容器。它们的配方与正确的金属加工相关，而非简单的原版合成。"]
	quest.259F5DA36110C1BD.quest_desc: ["黑钢是一个主要的钢制等级。它需要更多的合金加工，并引出传统锻造流程中的红钢和蓝钢。"]
	quest.25A01E629A546DE8.quest_desc: ["TFMG 管状炸弹是一种用于战斗和破坏方块的爆炸性武器。请远离盟友、储备物资和重要建筑使用。"]
	quest.261EF74F869ADD67.quest_desc: ["磨坊可将谷物磨成面粉。食物加工是游戏进程的一部分，因为长途探险和采矿都需要可靠的口粮。"]
	quest.261EF74F869ADD67.title: "面粉"
	quest.266D3339B7444D3B.quest_desc: ["压缩机在小型 More Propulsion 涡扇发动机的燃烧室前对进气进行预处理。尺寸和发动机系列需与其他部分匹配。"]
	quest.267410AB04A71900.quest_desc: ["手套是早期的隔热装备。它们能让你更容易处理高温物品，但金属钳子后期更好用。"]
	quest.2743BC35CA14BA64.quest_desc: ["喷嘴构成了小型 More Propulsion 涡轮喷气发动机的排气端，并引导气流。尺寸和发动机系列需与其他部分匹配。"]
	quest.27CC5C4B1CE0745A.quest_desc: ["喷嘴构成了标准 More Propulsion 涡扇发动机的排气端，并引导气流。尺寸和发动机系列需与其他部分匹配。"]
	quest.287D83696E62DC6C.quest_desc: ["机械泵是首个实用的流体搬运装置，对引擎、浸泡和加工链都至关重要。"]
	quest.289860FC89B80983.quest_desc: ["马力是引擎出现前的低科技机械方案。它符合整合包前电气时代的设定，且不跳过冶金学。"]
	quest.28F265334755D336.quest_desc: ["三明治是旅行和采矿的便携实用食物。升级谷物、蔬菜、肉类和乳制品基础设施可获得奖励。"]
	quest.28F265334755D336.title: "三明治"
	quest.292D9BFE92914C72.quest_desc: ["木箱和木质箱子是早期的整理式储物方式。兼容的木箱变体通过通用标签共享配方。"]
	quest.292D9BFE92914C72.title: "木箱"
	quest.2A25D9AC41DA4DD0.quest_desc: ["皮带研磨机可自动化抛光和研磨类配方，适用于需要摩擦而非切割或锤击的情况。"]
	quest.2A677AC839BECEE9.quest_desc: ["硝石粉和硬化硝石是更强的爆炸物。它们应被视为后期化学品，而非早期的火药替代品。"]
	quest.2A873B3AF6276B8D.quest_desc: ["行走手杖是可选的实用物品。它们自然出现在木制和布制工具的进阶阶段。"]
	quest.2A9BBB0B1E6EB45A.quest_desc: ["能锻造鱼钩后，钓鱼就能提供稳定的食物来源。这对金属进阶非必需，但对生存有帮助。"]
	quest.2A9BBB0B1E6EB45A.title: "钓鱼"
	quest.2AF48211F7D699A9.quest_desc: ["火焰喷射器和炮式工具将远程装备转变为动力或燃料驱动型武器。"]
	quest.2BAFD4A89829DB8D.quest_desc: ["高级化学喷雾器和重型土豆炮是特种武器。它们比简单的便携式远程工具需要更多的基础设施。"]
	quest.2C05527A688B87E3.quest_desc: ["青铜双锭是制作青铜砧的投资步骤。任何受支持的青铜合金都可以满足此通用材料标签。"]
	quest.2C05527A688B87E3.title: "青铜双锭"
	quest.2C19D97121EC1110.quest_desc: ["榨汁和碗处理支持更高效的烹饪。用它们将作物变成更实用的食物和食材。"]
	quest.2CEFAB5A303E092F.quest_desc: ["封闭式风扇可产生气流以处理物品。普通空气也能加快TFC模具和Create冶金铸造台的冷却速度：效果随速度增强，256 RPM时可达×2。"]
	quest.2D3ABA160CBE63B5.quest_desc: ["高岭土和高岭土粉末属于耐火材料链的一部分。高岭土并非普通黏土，应被视为更高价值的材料。"]
	quest.2D43505233CEBF41.quest_desc: ["大型引擎是后期的一种机械动力源。其成本应能体现从简易引擎到重型机械的跨越。"]
	quest.2DA40A40B345D125.quest_desc: ["手持碗，Shift + 右键制作沙拉"]
	quest.2E6EF8C65D438E49.quest_desc: ["玻璃加工始于专用工具。吹管、模具、桨和宝石锯是制作成型玻璃和精密零件的基础。"]
	quest.2E6EF8C65D438E49.title: "玻璃工艺"
	quest.2EF8CE6B4888448A.quest_desc: ["Tier 2 的硝棉枪械比早期的硝棉武器使用更好的推进剂和更先进的机制。"]
	quest.2EF8CE6B4888448A.title: "Tier 2 Guncotton Guns"
	quest.2F00B00A0353550A.quest_desc: ["水轮是原生的水力驱动方式。它们独立于大型机械轮，适合低科技机械阶段。"]
	quest.2F00B00A0353550A.title: "水车"
	quest.2F85B7F8E8379AE7.quest_desc: ["陶瓷纺锤开启了金属机械之前的纱线和线团链。像其他陶器一样烧制它。"]
	quest.30719285194168FE.quest_desc: [
		"温度会随周围环境而变化：季节、当地气候、一天中的时间、天气、海拔、附近的热源和水都会产生影响。Cold Sweat 在此基础上增加了体温系统。"
		"服装上彩色的隔热条显示了该物品如何为你提供保护："
		"{\"text\":\"Blue/Cyan\",\"color\":\"aqua\",\"extra\":[{\"text\":\" insulation protects from cold and freezing.\",\"color\":\"white\"}]}"
		"{\"text\":\"Orange\",\"color\":\"gold\",\"extra\":[{\"text\":\"/\",\"color\":\"white\"},{\"text\":\"Red\",\"color\":\"red\"},{\"text\":\" insulation protects from heat and overheating.\",\"color\":\"white\"}]}"
		"{\"text\":\"Purple/Neutral\",\"color\":\"light_purple\",\"extra\":[{\"text\":\" insulation covers both sides at once, but is less specialized than dedicated heat or cold protection.\",\"color\":\"white\"}]}"
		"{\"text\":\"Green/Adaptive\",\"color\":\"green\",\"extra\":[{\"text\":\" insulation shifts toward the condition you are currently facing.\",\"color\":\"white\"}]}"
		"用温度计观察情况，用衣物加隔热层来应对冬季、夏季、山区、沙漠和锻造炉附近的高温工作。隔热层可通过缝纫台添加。"
	]
	quest.30719285194168FE.title: "温度"
	quest.3076CF717A400D8B.quest_desc: ["化学喷雾器和炮塔是专用设备。在掌握基础武器和燃料操作后才能安装。"]
	quest.30BD561A7A6EA4B1.quest_desc: ["食品添加剂扩展了烹饪选项。锯末被视为低价值的可食用填充物，而磨坊和手磨则支持面粉链。"]
	quest.30BD561A7A6EA4B1.quest_subtitle: "我们可以在食物里加锯末，这样吃起来更顶饱，虽然不一定好吃——或者健康"
	quest.30BD561A7A6EA4B1.title: "食品添加剂"
	quest.3184D76C3F4E234A.quest_desc: ["扁面包是首个舒适的烘焙路线。它将谷物加工变成了可靠的旅途口粮。"]
	quest.3184D76C3F4E234A.title: "第一块面包"
	quest.31997A3F35F2DC40.quest_desc: ["黑曜石和高级原始武器是在全套金属装备前强大的生存工具。"]
	quest.31AB8BE3E7997CBA.quest_desc: ["红色和蓝色钢制砧是最高等级的砧，标志着传统锻造流程的终点。"]
	quest.31B0D1EF75ECBD91.quest_desc: ["空罐子可以长期储存食物。一旦有消毒和清洗功能，罐装就会变得更强大。"]
	quest.31FEED38425FCDB8.quest_desc: ["蒸汽口将蒸汽送入上方的气球以产生升力。为锅炉供水和加热；红石信号控制蒸汽输出。"]
	quest.3334D8C9EBACBC5C.quest_desc: ["压缩机在标准 More Propulsion 涡扇发动机的燃烧室前对进气进行预处理。尺寸和发动机系列需与其他部分匹配。"]
	quest.335BA2499DAFB1A8.quest_desc: ["炸药桶会爆炸并清除大片岩石。请注意附近的建筑，并在引爆前移动到安全距离。"]
	quest.33E49B6E8A8CE524.quest_desc: ["Tier 1 的火药枪械是早期钢制枪械，机制优于最简模型，但仍使用黑火药弹药。"]
	quest.33E49B6E8A8CE524.title: "Tier 1 火药枪械"
	quest.355B5C36B6D05539.quest_desc: ["杆件是重要的中间产物。它们用于制造铆钉、圆环、电线、弹簧、手柄和机器配方。"]
	quest.380009CABCAD8273.quest_desc: ["燃烧器使用燃料来加热生产设备。在安装前，请确认其接受的燃料种类并安排好供应。"]
	quest.3897FD62BD9205D7.quest_desc: ["隔热手套是布制的隔热装备。它们不如钳子工业化，但在有更好的工具之前很有用。"]
	quest.3897FD62BD9205D7.title: "隔热手套"
	quest.3A0130A8D0BC10E9.quest_desc: ["巨大的柴油发动机故意设计得很昂贵，并与高炉基础设施绑定。它应该感觉像一次重大的动力升级。"]
	quest.3AD8A6CAFEC100AE.quest_desc: ["捕鱼不仅能得到鱼排，还能得到鱼骨。将鱼骨磨成骨粉，让你的渔获物物尽其用。"]
	quest.3CA52C36A2CC605B.quest_desc: ["该水闸提供低技术的清洗和收集功能，而不会取代完整的矿石处理链。"]
	quest.3CA52C36A2CC605B.title: "水闸"
	quest.3CC1DF3CB576C5FE.quest_desc: ["胶水由骨粉制成，是木材、皮革和实用配方中实用的粘合剂。"]
	quest.3DB084E7A3A6E944.quest_desc: ["支撑梁可以在金属锯之前制作。先剥树皮，然后手持斧头右键剥皮后的原木或木材以粗略切割支撑梁。用斧头的产量低且磨损快，合适的锯子效率要高得多。"]
	quest.3DB084E7A3A6E944.title: "支撑梁"
	quest.3E2EFA41938D7EFD.quest_desc: ["玫瑰金是一种早期合金分支，用于多种装饰和进阶配方。"]
	quest.3F32730F6D83ADBD.quest_desc: ["骨粉是一种简单的加工骨产品，可用于制作胶水和支持农业。"]
	quest.3F7F614121E34E01.quest_desc: ["钢制泵和曲轴是用于更强大机械系统的实用机器部件。"]
	quest.3F93605EDE7A876B.quest_desc: [
		"丝绸衣物是适合多变或温暖气候的精致轻便旅行装。它优于粗糙的早期衣物，在需要防护又不想厚重臃肿时依然实用。"
		"{\"text\":\"Green/Adaptive\",\"color\":\"green\",\"extra\":[{\"text\":\" insulation suits silk well for travel, because the outfit is light and useful when conditions change.\",\"color\":\"white\"}]}"
	]
	quest.3F93605EDE7A876B.title: "丝绸衣物"
	quest.40531D671C1D1818.quest_desc: ["曲柄压床和动力织布机可自动化专业塑形和纺织工作。它们对较大的机械生产链很重要。"]
	quest.410ECB07011FD0AC.quest_desc: ["桶是重要的加工方块，不仅仅是存储。可用于皮革加工、浸泡配方和多种材料转换。"]
	quest.410ECB07011FD0AC.title: "木桶"
	quest.4129C8BFFAC8E4B8.quest_desc: ["木制钳子能让你早点处理热物。它们比普通木制工具更耐用，但在金属钳子出现前仍是临时方案。"]
	quest.41580C5BAECF0CAE.quest_desc: ["斯特林发动机及其燃烧器是早期的机械发动机。它们的平衡性低于便携式发动机，并使用铁器时代的材料而非晚期的钢材。"]
	quest.41A9B18EA289F755.quest_desc: ["陀螺仪机制通过序列组装由精密机制制成。它被用于先进的控制系统中，包括智能螺旋桨。"]
	quest.41B356618789C6D6.quest_desc: ["燃烧室在大型 More Propulsion 涡扇发动机中燃烧燃料。在本整合包中，GTCEu 轻质燃料替代煤油用于这些发动机。请匹配其他部分的尺寸和发动机系列。"]
	quest.4484F1E91728CD18.quest_desc: ["铜制锄头和镰刀能提升早期种田和采集的效率。它们是实用工具，而非战斗进阶道具。"]
	quest.44B892B4B8FD1AED.quest_desc: ["压缩机在小型 More Propulsion 涡轮喷气发动机的燃烧室前对进气进行预处理。尺寸和发动机系列需与其他部分匹配。"]
	quest.44F30EFA34EB4B07.quest_desc: ["Tier 4 的氮化武器使用高级推进剂和更苛刻的材料。它们在基础武器链成熟后才能使用。"]
	quest.44F30EFA34EB4B07.title: "Tier 4 氮气枪"
	quest.465CAAA0689771F0.quest_desc: ["铜镐是第一件真正的采矿工具。用它从地表痕迹进入真正的矿脉。"]
	quest.46F5A8C7B27438D8.quest_desc: ["养蜂人保护能让蜂巢工作更安全。可选的，但如果蜂蜡、蜂蜜或相关材料变得重要，会很有用。"]
	quest.46F5A8C7B27438D8.title: "养蜂人保护机制"
	quest.477F56CEAFC34197.quest_desc: ["离子推进器是一种需要高级电子元件的后期电动推进选项。在将其用于飞行器前，请先提供FE能量和红石控制。"]
	quest.478ABE068E3CC3E5.quest_desc: ["Tier 6 穿甲枪械使用最强的AP材料和后期建造要求。"]
	quest.478ABE068E3CC3E5.title: "Tier 6 AP Guns"
	quest.47A23ABB2E9D1716.quest_desc: [
		"植物衣物是最简单的纤维服装。它们很弱且临时，但在初期哪怕一点气候缓冲都很重要的时候很有用。"
		"{\"text\":\"Purple/Neutral\",\"color\":\"light_purple\",\"extra\":[{\"text\":\" insulation is the practical choice for plant clothes: weak, cheap, and useful only as early mixed protection.\",\"color\":\"white\"}]}"
	]
	quest.47A23ABB2E9D1716.title: "种植衣物"
	quest.4844F41F64A6483E.quest_desc: ["浮石可用于加工石头和制作冰箱。找到的浮石碎片别只用来建造。"]
	quest.48F3A0C8ABBFE899.quest_desc: ["燃烧室在小型 More Propulsion 涡扇发动机中燃烧燃料。在本整合包中，GTCEu 轻质燃料替代煤油用于这些发动机。请匹配其他部分的尺寸和发动机系列。"]
	quest.49EE02CCEC95D0F7.quest_desc: ["机械水轮可以利用河水工作。河流能提供最佳产量，但玩家建造的渠道在硬方块堵塞时依然有用。"]
	quest.4A5BA00DF8FB292F.quest_desc: ["Rolling and curving machines automate sheet, pipe, and shaped metal work that should not be simple hand crafting."]
	quest.4AF1F127B7BC33C5.quest_desc: ["未烧制的陶器需先塑形再烧制。早期铸造需要模具，而容器和水罐则支撑着生存经济。"]
	quest.4AF1F127B7BC33C5.title: "未烧制的陶土模具和工具"
	quest.4B10FE58DAC0C662.quest_desc: ["钢是在锻炉铁和冲天炉之后出现的。不能直接跳过简单的盆混合来生产。"]
	quest.4BC02698E4B8398D.quest_desc: ["从该任务奖励中领取移动指南，学习 ParCool 提供的动作。请在控制设置中查看分配按键。"]
	quest.4BC02698E4B8398D.title: "移动方式"
	quest.4C97DE5E37B09382.quest_desc: [
		"麻布衣物廉价、粗糙且透气。它比深冬衣物更适合早期温带或温暖地区的旅行，是植物衣物和更优质纺织品之间的实用过渡。"
		"{\"text\":\"Purple/Neutral\",\"color\":\"light_purple\",\"extra\":[{\"text\":\" insulation is burlap's real role: cheap mixed protection that helps a bit on both sides, but does not specialize in severe cold or heat.\",\"color\":\"white\"}]}"
	]
	quest.4C97DE5E37B09382.title: "麻布衣物"
	quest.4D85F7D97E5C075C.quest_desc: ["黄金主要用于机制、电子和货币，而非基础工具。"]
	quest.4E2BF256575ED45E.quest_desc: ["弹簧卷绕机可将棒材和细丝自动制成弹簧、环形件、线圈等卷曲部件。"]
	quest.4E92681429999E11.quest_desc: ["金属烤架能扩展你的篝火烹饪方式。把它放在火上，用来烧烤食物。"]
	quest.4F2193B75F3BE965.quest_desc: ["Tier 4 的火药枪械是晚期黑火药武器，材料更坚固，结构也更完整。"]
	quest.4F2193B75F3BE965.title: "Tier 4 火药枪械"
	quest.4F9A67618F6706DE.quest_desc: ["铲子和挖掘机用于挖掘。一旦准备好金属工具，较大的工具更适合大规模地形改造。"]
	quest.4FA644197DDBF508.quest_desc: ["该推进器使用液体燃料。通过管道为其供能，并使用红石信号来激活推力。"]
	quest.4FD6AC216ACF8E12.quest_desc: ["Tier 6 的氮化铀枪械位于常规枪械的顶端，使用先进的推进剂和高级材料。"]
	quest.4FD6AC216ACF8E12.title: "Tier 6 氮气枪"
	quest.4FE9ED58B22A56D4.quest_desc: ["铜双锭在砧上焊接时需要助焊剂。这样可以准备好制作铜砧所需的七个双锭。"]
	quest.50F3F8311E3AF995.quest_desc: ["黄铜是早期用于机械和配件的重要合金。它与青铜互补，而非取代青铜。"]
	quest.513F3C5028DFD854.quest_desc: ["喷嘴构成了巨型 More Propulsion 涡扇发动机的排气端，并引导气流。尺寸和发动机系列需与其他部分匹配。"]
	quest.5160DCFF7CD2F1E4.quest_desc: [
		"羊毛衣物是可靠的防寒纺织品。适合冬季、高地和寒冷生物群系；炎热季节若叠加过多防寒保护，可能会成为负担。"
		"{\"text\":\"Blue/Cyan\",\"color\":\"aqua\",\"extra\":[{\"text\":\" insulation is the natural match for wool: stack it when winter, altitude, or cold biomes are the problem.\",\"color\":\"white\"}]}"
	]
	quest.5160DCFF7CD2F1E4.title: "羊毛衣物"
	quest.523C6394AFC91646.quest_desc: ["Tier 3 的火药枪械是改良的黑火药武器，拥有更坚固的钢材结构和更复杂的内部构造。"]
	quest.523C6394AFC91646.title: "Tier 3 火药枪械"
	quest.5267E5618C972EF1.quest_desc: ["高温下工作的设备需要耐火砖。为冶金和后续制作加固耐火砖准备好一批。"]
	quest.5377AF696D339F05.quest_desc: ["磨石和手磨石是最早的研磨系统。在机器出现前，它们用于处理谷物和多种早期手工加工配方。"]
	quest.541F330719897F8D.quest_desc: ["大型柴油发动机是柴油动力的加强版，应该在基础发动机系列之后出现。"]
	quest.5599C5E8D8A51F36.quest_desc: ["红色和蓝色钢锭是最终的钢材。它们价格昂贵，但可以解锁最强的传统砧和工具。"]
	quest.5599C5E8D8A51F36.title: "红/蓝钢锭"
	quest.560F2039395D2B93.quest_desc: ["水推进器能让船在水中前进。将其放置在预定航向的前方以产生推力，并在下水后进行测试。"]
	quest.568E6D8833E72A49.quest_desc: ["机械搅拌机负责处理盆中混合，包括热控配方。部分合金和金属的快捷方式已从普通混合中移除。"]
	quest.5698D507553313B1.quest_desc: ["Tier 3 的氮化枪械使用更强劲的化学推进剂，但仍低于最先进的枪械材料。"]
	quest.5698D507553313B1.title: "Tier 3 氮气枪"
	quest.5748340466493442.quest_desc: ["炉灶是永久性厨房的基础。将燃料放在附近，并为食材和成品腾出空间。"]
	quest.5853FB39186545CA.quest_desc: ["燃烧室在巨大的 More Propulsion 涡轮喷气发动机中燃烧燃料。在本整合包中，GTCEu 轻质燃料替代煤油。请匹配其他部分的尺寸和发动机系列。"]
	quest.58CA9856922BAF42.quest_desc: ["熔炉盆和舀勺能帮你处理熔融金属。用它们来转移熔液，并在模具旁整理铸造区。"]
	quest.59EB90336F5F41EF.quest_desc: ["铸造沙和铸造机开始生产重型武器。这些是工业工具，而非早期武器。"]
	quest.5AEBAB300FAAE99A.quest_desc: ["羊毛线让纺织品超越了原始纤维。它能制成布匹、床、船帆和风车。"]
	quest.5BB3B24C72823E1E.quest_desc: ["燃烧室在大型 More Propulsion 涡轮喷气发动机中燃烧燃料。在本整合包中，GTCEu 轻质燃料替代煤油。请匹配其他部分的尺寸和发动机系列。"]
	quest.5C1A18A9494036BD.quest_desc: ["天然原火粘土通常存在于含煤浅层周围的沉积岩中。将其放入水桶中即可转化为精炼火粘土。"]
	quest.5C335E88271F6766.quest_desc: ["压缩机在大型 More Propulsion 涡轮喷气发动机的燃烧室前对进气进行预处理。尺寸和发动机系列需与其他部分匹配。"]
	quest.5CAD3A014B4A2033.quest_desc: ["动力织布机和锻锤可自动化纺织和重锻工作。它们减少了手动重复操作，但并未跳过钢铁阶段。"]
	quest.5CCA79DF998E3751.quest_desc: ["钢铁机械是TFMG设备的中间组件。设置其部件的生产，将使工厂扩建变得更加容易。"]
	quest.5D4A0C644A242F14.quest_desc: ["斯特林银是一种合金分支，支持工具、组件和后期的材料多样性。"]
	quest.5D914AAF6145B796.quest_desc: ["风车是另一种原生的机械动力来源。它们依赖于纺织业，在完全工业化引擎之前就已存在。"]
	quest.5D914AAF6145B796.title: "风车"
	quest.5DAD3DAE4D144476.quest_desc: ["涡轮机位于燃烧室之后，是小型 More Propulsion 涡扇发动机的一部分，利用高温燃气流产生的能量。尺寸和发动机系列需与其他部分匹配。"]
	quest.5DEE5207EDC15ADF.quest_desc: ["涡轮引擎代表高输出的机械阶段。其配方需要具有意义的引擎基础设施。"]
	quest.5E6A79F95A92D6C1.quest_desc: ["滑翔翼能将高度转化为行进距离。起飞前选好降落点，并注意耐力值。"]
	quest.5F07DD8DC78612F2.quest_desc: ["陶罐和大容器可提供早期建筑和陶瓷用途。它们结构简单，但仍适用于低技术加工。"]
	quest.5F1DC535A7DB60BA.quest_desc: ["机械钻头是一个关键的机器组件。它的配方使用完整的钻头，而不是零散的铁块。"]
	quest.5F2DB93EB21E06E6.quest_desc: ["铜锯能让木材生产更可靠。手持锯子，右键去皮的原木或木材，即可在配方查看器显示的世界交互处进行支撑切割。在此之前，石斧也能生产一些木板和支撑物，但产量更低，工具磨损也更快。"]
	quest.5F2DB93EB21E06E6.title: "铜制锯子"
	quest.5F4993AC2F6178EA.quest_desc: ["在砧板上用铸铁双层板锻造一个煎锅碗。加上一个陶瓷手柄，把它变成一个用于烹饪的成品煎锅。"]
	quest.60920470A916146F.quest_desc: ["Pre-steel javelins are early thrown weapons. They are cheaper than steel weapons, but limited by their material tier."]
	quest.60920470A916146F.title: "Pre-Steel Javelin"
	quest.6113901F3ACC904F.quest_desc: ["锻铁可解锁早期生产机器：轧机、带式研磨机、弹簧卷绕机、真空室和磨石。将它们连接到旋转动力，并查看可用的加工配方。"]
	quest.6113901F3ACC904F.title: "锻铁机器模组 (Wrought Iron Machines)"
	quest.613C53304C480F2D.quest_desc: ["树木采集器开始收集天然树脂。针叶树的采集与松节油和树脂的处理有关。"]
	quest.6157451FA720B7B9.quest_desc: ["造纸始于废木。将木屑在木灰碱液中煮沸，分解成可用的纤维，再与面粉混合并在低温下烘干。一旦木材加工体系建立，这就能为你提供稳定的书写材料制作方式。"]
	quest.61F4EF9398DBBE1F.quest_desc: ["燃烧室在小型 More Propulsion 涡轮喷气发动机中燃烧燃料。在本整合包中，GTCEu 轻质燃料替代煤油用于这些发动机。请匹配其他部分的尺寸和发动机系列。"]
	quest.63051C79408B3B8E.quest_desc: ["动力织布机将纺织生产引入TFC机械动力。储备纤维，为织布做好准备。"]
	quest.630E67B9983A97F0.quest_desc: ["铆钉是一种小型但常见的金属部件。它们可以通过锻造或机械车削的方式，由花蕊和杆件制成。"]
	quest.63DC4B82A6826AF7.quest_desc: ["皮革容器和基础皮革装备有助于在金属容器普及前旅行和生存。"]
	quest.656FB1E934C804DA.quest_desc: ["将木屑压缩成颗粒，再将颗粒压缩成块。这样就能把锯末废料变成紧凑的燃料。"]
	quest.6571F69F3047163D.quest_desc: ["这座桥梁将低技术机械能转化为旋转机械。它将早期电力与物理基础设施紧密相连。"]
	quest.6571F69F3047163D.title: "机械动力桥"
	quest.65DAB1AE0E348736.quest_desc: ["制造推进器引擎可为移动结构提供推力。大小版本可通过合成相互转换，以适应你的飞船。"]
	quest.6664C6E21DB8B152.quest_desc: ["钢铁能让你建造机械压机、弯曲机、锻锤和搅拌机。这些机器利用旋转动力来塑形工件，并为后续生产准备材料。"]
	quest.6664C6E21DB8B152.title: "钢铁机械模组"
	quest.672A3D7F2C716544.quest_desc: [
		"布匹来自织布机，可解锁床、船帆、风车、衣物和气候防护。麻布、羊毛、丝绸、棉花和亚麻布分别引导你选择不同的衣物。"
		"织物也可以成为隔热材料。在缝纫桌上将其添加到衣物或盔甲上。"
		"{\"text\":\"Blue/Cyan\",\"color\":\"aqua\",\"extra\":[{\"text\":\" protects from cold and freezing.\",\"color\":\"white\"}]}"
		"{\"text\":\"Orange\",\"color\":\"gold\",\"extra\":[{\"text\":\"/\",\"color\":\"white\"},{\"text\":\"Red\",\"color\":\"red\"},{\"text\":\" protects from heat and overheating.\",\"color\":\"white\"}]}"
		"{\"text\":\"Purple/Neutral\",\"color\":\"light_purple\",\"extra\":[{\"text\":\" protects both sides at once, but less efficiently than specialized insulation.\",\"color\":\"white\"}]}"
		"{\"text\":\"Green/Adaptive\",\"color\":\"green\",\"extra\":[{\"text\":\" shifts toward the temperature problem you are currently facing.\",\"color\":\"white\"}]}"
	]
	quest.672A3D7F2C716544.title: "Cloth"
	quest.679ABBFCC97386E2.quest_desc: ["石墨是耐火材料和坩埚进阶所必需的。石墨粉尘和粉末通过转换配方统一。"]
	quest.67EC03BA2CAD3FF5.quest_desc: ["皮革是早期的重要材料。在橡胶过于先进或昂贵时，皮革会被使用。"]
	quest.685D5ADFD9FDB312.quest_desc: ["Tier 5 的氮化武器需要比早期氮化武器更坚固的材料和更先进的化学基底。"]
	quest.685D5ADFD9FDB312.title: "第五级氮气枪"
	quest.687135F73A0157F8.quest_desc: ["金属焦炉比早期的砖炉更先进。它能产生更多焦油，并且能将一根原木变成两块木炭，是更优的工业木炭生产方式。"]
	quest.68AE7C1B54E63D83.quest_desc: ["Create 磨石利用旋转动力来研磨材料。用齿轮、安山岩外壳和 TFC 手磨石合成，然后设置输入和输出接口。"]
	quest.69987C0B389D2624.quest_desc: ["黑钢砧可解锁上层钢锻造线，并为红钢和蓝钢锻造做好准备。"]
	quest.6A12BAEEFDECF9F6.quest_desc: ["火粘土可以用高岭土和石墨制作，但也有天然的火粘土原矿。在浅层煤炭附近的沉积区寻找，然后用木桶处理。"]
	quest.6B8AB41B4059E565.quest_desc: ["工业熔炉用于处理 Create Metallurgy 中的熔融材料。配方需要加固耐火砖，请在附近留出空间存放材料和铸造。"]
	quest.6BF6FCE80E16527E.quest_desc: ["青铜多块储罐和蒸汽外壳在电力出现前，为更大的流体和蒸汽基础设施做好准备。"]
	quest.6C253000BEE7F675.quest_desc: ["燃烧室在标准的 More Propulsion 涡扇发动机中燃烧燃料。在本整合包中，GTCEu 轻质燃料替代煤油。请匹配其他部分的尺寸和发动机系列。"]
	quest.6DB2577010ACA29C.quest_desc: ["黑钢解锁了另一套机器：熔炉搅拌机、车床和钻孔设备。提供旋转动力，并为金属和组件加工腾出空间。"]
	quest.6DB2577010ACA29C.title: "黑钢机械 (Black Steel Machines)"
	quest.6F094FC87D3E348C.quest_desc: ["Tier 0 的火药枪械是最简单的钢制枪械。它们没有复杂的机制，使用基础的黑色火药弹药。"]
	quest.6F094FC87D3E348C.title: "Tier 0 火药枪械"
	quest.6F24BD2659F4BCA5.quest_desc: ["真空室可处理真空和干燥式加工，包括一些橡胶和树脂步骤，这些步骤用普通搅拌机效果不佳。"]
	quest.6F6F63274C5DDE5F.quest_desc: ["在工业枪械实用之前，弩和原始刀剑是实用的远程和近战替代方案。"]
	quest.7044B9A7B4470550.quest_desc: ["压缩机在大型 More Propulsion 涡扇发动机的燃烧室前对吸入的空气进行预处理。尺寸和发动机系列需与其他部分匹配。"]
	quest.717136C73DEE3C16.quest_desc: ["喷嘴构成了巨型 More Propulsion 涡轮喷气发动机的排气端，并引导气流。尺寸和发动机系列需与其他部分匹配。"]
	quest.72156499578E5044.quest_desc: ["硝化棉和压缩硝化棉是更强大的推进剂阶段。压缩装药适用于更大或更强大的弹药。"]
	quest.7256AC92286A90A8.quest_desc: ["涡轮机位于燃烧室之后，是大型 More Propulsion 涡扇发动机的一部分，利用高温燃气流产生的能量。尺寸和发动机系列需与其他部分匹配。"]
	quest.72A8CFC5C9F55695.quest_desc: ["蒸汽机很有用，但它不应取代所有早期的动力源。将其视为机械发展的一条分支即可。"]
	quest.72C4F696BDC0122C.quest_desc: ["粘性树脂通过定制树脂链获取，而非早期的史莱姆球。使用天然树木产物，经过干燥和化学步骤。"]
	quest.738EEC3DDFE0A897.quest_desc: ["骨制工具是石制和燧石制工具的早期替代品。将骨头或骨碎片对准实心石头右键，然后用得到的部件制作工具配方。"]
	quest.7414E3054676831F.quest_desc: ["机械车床是早期用于加工杆、螺栓、齿轮和异形零件的简易车床。"]
	quest.7441B37AEDB6D13F.quest_desc: ["压缩机在标准 More Propulsion 涡轮喷气发动机的燃烧室前对进气进行预处理。尺寸和发动机系列需与其他部分匹配。"]
	quest.745267924175CEA4.quest_desc: ["Tier 5 穿甲枪械使用更硬的投射物材料，武器构造要求也更高。"]
	quest.745267924175CEA4.title: "第五级自动步枪"
	quest.74C4DCC5DCFEA450.quest_desc: ["纸板由粗木浆制成。将木屑在水中煮沸，然后用面粉将浆料粘合并压实，同时用小火加热。它比纸张粗糙，但更适合用于坚固的包装和轻质部件。"]
	quest.75ABAF1E737E7593.quest_desc: ["精密机制需从黄铜板开始，通过序列组装制成。准备好加工线和更高级设备的组件储备。"]
	quest.75AC90323A6D8776.quest_desc: [
		"毛皮衣物是冬季、山区和极地气候的重型防寒装备。在炎热环境下并不适用，但在寒冷环境中能提供极强防护。"
		"{\"text\":\"Blue/Cyan\",\"color\":\"aqua\",\"extra\":[{\"text\":\" insulation reinforces what fur is already for: surviving serious cold, snow, mountains, and polar regions.\",\"color\":\"white\"}]}"
	]
	quest.75AC90323A6D8776.title: "毛皮衣物"
	quest.77C2190C3455DD29.quest_desc: ["煤饼是一种紧凑的燃料。请查看木炭和蜂巢饼的配方，因为它们在本整合包中的制作方式已经改变。"]
	quest.77C2190C3455DD29.title: "煤炭饼砖"
	quest.77F5F66782875AFA.quest_desc: ["Tier 4 的硝化棉枪械使用更强大的机制和材料，但仍低于硝基和AP的终局阶段。"]
	quest.77F5F66782875AFA.title: "Tier 4 火棉枪系列"
	quest.781DD8775EB68A7E.quest_desc: ["穿甲弹使用钨钢等硬芯材料。价格昂贵，适用于高级弹药。"]
	quest.781DD8775EB68A7E.title: "AP子弹"
	quest.787DA20C2E66A0DD.quest_desc: ["压缩机在巨型 More Propulsion 涡扇发动机的燃烧室前对进气进行预处理。尺寸和发动机系列需与其他部分匹配。"]
	quest.792D4ADAA37091EE.quest_desc: ["大炮需要专用工具来钻孔、建造和焊接大型炮管。把它们当作重工业来处理。"]
	quest.792D4ADAA37091EE.title: "大炮"
	quest.79AB0164D65576FC.quest_desc: ["在火枪生产稳定之前，弓和早期投掷武器仍然很有用。"]
	quest.7AD30622983B5592.quest_desc: ["蓄水池并非第一天就能获得的方块。它对加热混合、水坑式熟铁自动化以及后续配方都至关重要。"]
	quest.7B129451EB903BB5.quest_desc: ["机械锯自动化了切割配方：木板、木棍、螺栓，以及多种木材和金属中间体。这是电动锯的版本；手锯在切割某些木材时仍需右键交互。"]
	quest.7B2ED766A87E8138.quest_desc: ["Tier 3 穿甲枪械在最高穿甲材料可用前会引入更硬的投射物。"]
	quest.7B2ED766A87E8138.title: "Tier 3 AP Guns"
	quest.7B94418FC5222F2D.quest_desc: ["喷嘴构成了小型 More Propulsion 涡扇发动机的排气端，并引导气流。尺寸和发动机系列需与其他部分匹配。"]
	quest.7B9A11689BDAAE35.quest_desc: ["喷嘴构成了标准 More Propulsion 涡轮喷气发动机的排气端，并引导气流。尺寸和发动机系列需与其他部分匹配。"]
	quest.7BA8E343F752FF66.quest_desc: ["刀具涵盖简单的切割和生存战斗。更好的刀片材料使其更可靠。"]
	quest.7BE9CB31791FC62C.quest_desc: ["Tier 0 的硝化棉枪械使用早期的硝化棉弹药，装在简单的钢制武器中。"]
	quest.7BE9CB31791FC62C.title: "Tier 0 火棉枪"
	quest.7D49D9B98BE0F7F7.quest_desc: ["木材通常来自锯木，但用斧头也能制作粗糙的石器时代木板。粗糙路线：右键斧头，去皮原木或木材可变为支撑物，垂直支撑物可变为木材。斧头路线损耗大且磨损工具；锯木路线是高效标准。"]
	quest.7D49D9B98BE0F7F7.title: "木材"
	quest.7E5E6AE99DE606E8.quest_desc: ["焊接和多种金属加工步骤都需要Flux。在深入锻造前，请保持稳定的供应。"]
	quest.7EAFB78EBF830BA9.quest_desc: ["黄铜机械和玻璃加工工具是后期机械部件的精密工艺基础。"]
	quest.7FAF55BA9A087E3A.quest_desc: [
		"织布机开启了真正的纺织链。布可用于床、风力、帆、衣物和气候控制；亚麻则与麻袋、羊毛、丝绸和棉成为另一种实用织物。"
		"缝纫台可将布料或隔热材料缝制成衣物和盔甲。隔热颜色代表用途：蓝/青用于防寒，橙/红用于保暖，紫/中性用于较弱的双向防护，绿/自适应用于应对变化的环境。"
	]
	quest.7FAF55BA9A087E3A.title: "织布机"
	quest.7FEC1B8DC1A9F513.quest_desc: ["高级土豆炮是比简易手持版更强大的实用武器。"]
