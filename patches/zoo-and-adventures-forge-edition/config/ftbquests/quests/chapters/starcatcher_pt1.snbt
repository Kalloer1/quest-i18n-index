			x: 0.0d
			y: -4.5d
		}
		{
			dependencies: ["60F68F4A2EB80D75"]
			description: [
				"在追寻深海传说之前，你需要一根基础的鱼竿。"
				""
				"制作一根谦逊之竿（或老式鱼竿）来开启你的旅程。"
			]
			id: "1AB44CC6654E8A1B"
