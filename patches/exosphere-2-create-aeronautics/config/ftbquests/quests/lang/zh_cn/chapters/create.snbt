# AI 初翻，未人工校对
{
	quest.0149B3F7F08D7E35.quest_subtitle: "一个基础的制作组件。"
	quest.09BE3D92053AE1F8.quest_desc: ["&eRoller&r放置在目标方块上方一格，类似于&bMechanical Mixer&r或&bMechanical Press&r。可以通过潜行并使用&bWrench&r来拾取它。"]
	quest.0BBE6CADED48A971.quest_desc: [
		"点击一个&b股票链接&r，将&e股票行情板&r连接到网络。在其后方放置一个&b坐席生物座&r或&b烈焰燃烧器&r，即可创建一个&d股票保管员&r。"
		""
		"&dStock Keeper&r 允许玩家搜索网络并请求物品。锁定后其他玩家无法访问其UI，但它仍会接受 &bShopping Lists&r。"
	]
	quest.0EE2E9EB6DC01E34.quest_subtitle: "一种重要的合成材料。"
	quest.135E27A19B935CD7.quest_desc: [
		"&eFrogport&r会接收与其地址匹配的物品。右键点击&bChain Conveyor&r以设置目标，然后将&eFrogport&r放置在4格以内。"
		""
		"右键点击放置的 &eFrogport&r 以设置地址。除非在UI中另有配置，否则它只会发送不匹配其地址的包裹。"
	]
	quest.147FC2959F9FC5F5.quest_desc: [
		"&e火车&r是在&b铁轨&r上运行的装置。"
		""
		"要组装火车，将&b车站&r放在轨道旁，然后选择“创建火车”。将&b火车外壳&r放在轨道上形成转向架。添加&b火车控制器&r和&b座位&r或&b烈焰燃烧器&r作为驾驶室。"
		""
		"使用&b强力胶水&r连接所有部件，然后通过&b车站的&r接口组装火车。组装失败会显示错误。"
	]
	quest.147FC2959F9FC5F5.quest_subtitle: "建造并定制你自己的火车。"
	quest.177C0E37A35A14F4.quest_desc: [
		"通电后，&eClockwork Bearing&r会将所附结构旋转至当前小时。另一个独立结构可用作分针。"
		""
		"价值设置界面可以更改手持顺序或切换到24小时制。"
	]
	quest.1837076B0EA3C11A.quest_desc: ["&e机械传送带&r可运输物品和实体，同时传递&d旋转力&r。将两个呈直线的&b传动轴&r右键即可创建一个。传动轴之间的最大距离为20格。"]
	quest.1837076B0EA3C11A.quest_subtitle: "运输物品并转移旋转方向。"
	quest.19754AE8C11A6317.quest_desc: [
		"&eDeployer&r 会模拟玩家对相隔2个方块的目标进行操作。可以给它物品来使用，也可以用 &bRedstone Signal&r 来停止。"
		""
		"可以设置一个&b过滤器&r来指定要使用的物品。"
		"{@pagebreak}"
		"默认情况下，&eDeployer&r会模拟右键。用&bWrench&r点击正面可切换为左键模式，使其能使用稿子和剑等工具。"
	]
	quest.1B04A295850D0F00.quest_desc: ["&e火车观察者&r用于检测经过的&b火车&r。"]
	quest.1B65E8BE91A087DA.quest_desc: [
		"&e链式传送带&r可以通过右键点击并用&b链条&r来连接。最大连接距离为32格。"
		""
		"它们能应对的最大坡度大约是每2个水平方块对应1个垂直方块。"
	]
	quest.1D00D782B8F0B6D6.quest_desc: [
		"&e机械搅拌机&r由内部齿轮驱动，需要至少30转/分钟的转速。"
		""
		"必须放置在&bBasin&r上方一格。当有效配方所需的材料被投入&bBasin&r时，搅拌机将自动激活并进行混合。"
	]
	quest.1DBA8DD396081924.quest_desc: [
		"&e便携式流体接口&r可在移动装置和固定位置之间传输流体。"
		""
		"接口必须相对放置，间隔1-2格。需要一台&b流体泵&r来移动液体。"
	]
	quest.1FDBB75ECD39FB24.quest_desc: [
		"&e物品抽取器&r最多可容纳 1500mb 的流体。需要使用 &b流体泵&r 才能将其抽出。"
		""
		"&bBasin&r会自动将产物流体排入相邻的&eItem Drain&r中。"
	]
	quest.21A830CC8DAD6566.quest_desc: [
		"将 &e车站&r 放置在笔直的 &b铁轨&r 15格以内以创建火车。"
		""
		"车站可以在界面中命名。列车员会用此名称进行导航，如果使用地图，名称会显示在&b地图&r上。"
	]
	quest.21B40BEC30B40491.quest_desc: [
		"&e漏斗&r用于向物品栏输入或输出物品。潜行右键可将其设为输入模式。"
		""
		"使用&b扳手&r切换输入和输出模式。可用&b红石信号&r禁用。右键点击&b机械带&r可将其向前延伸。"
	]
	quest.21B40BEC30B40491.title: "漏斗"
	quest.23A9A2D399A7BF94.quest_desc: ["&e电梯滑轮&r可垂直移动装置，并能穿过方块。组装时需要装置上有一个水平的&b红石接触器&r。"]
	quest.24CFA0022432887E.quest_desc: [
		"&e阈值开关&r会根据物品栏的满溢程度发出&b红石信号&r。放置时，它会朝向相邻的物品栏。"
		"{@pagebreak}"
		"信号开启和关闭的阈值可以在其UI中配置。信号也可以被反转。"
	]
	quest.24DDED464AE48E05.quest_desc: ["当&eGearshift&r接收到&bRedstone Signal&r时，会反转&dRotational Force&r的方向。"]
	quest.2A404708E175235F.quest_desc: [
		"&e流体储罐&r用于储存液体。"
		""
		"使用 &b流体管道&r 来注入或抽出流体。管道的流动方向决定了流体是添加还是移除。"
		""
		"可以用&b扳手&r来切换窗户。"
	]
	quest.2CD70FCC8B119D7A.quest_desc: ["&e机械泵&r通过管道输送流体。箭头符号表示流动方向，使用&b扳手&r可以反转方向。"]
	quest.2E8B8DBE61162084.quest_desc: ["&e智能滑槽&r的运作方式与普通&b滑槽&r相同，但可以过滤以仅允许特定物品通过。它还可以被配置为从上方物品栏中提取固定数量的物品。"]
	quest.2F0B0D4401AA455E.quest_desc: [
		"&e安山岩隧道&r放置在&b机械传送带&r上，既能让物品通过，又能封闭&b封闭式风扇&r的气流。可用于将物品堆栈中的单个物品分流至侧面输出。"
		""
		"使用&b扳手&r来添加窗户。"
	]
	quest.2F0B0D4401AA455E.title: "隧道"
	quest.302D29E43E9C9A94.quest_desc: ["放置在物品栏旁时，&ePackager&r会生成&bCardboard Packages&r。使用&bRedstone Signal&r可使其尽可能多地填充包裹。在&ePackager&r上放置一个带文字的&bSign&r可为包裹指定地址。"]
	quest.30A84C6A54BD336E.quest_desc: ["固定的&e机械钻头&r会破坏前方的方块。安装在&b装置&r上时，它会破坏碰撞到的方块。破坏速度和伤害取决于转速或装置速度。"]
	quest.3562111D841CF498.quest_desc: [
		"&e顺序齿轮&r通过执行一系列编程指令，实现对&d旋转动力&r的精确控制。你可以配置多达五个命令，例如转动特定角度、移动&b机械活塞&r一定距离，或等待定时延迟。"
		"{@pagebreak}"
		"每个命令的参数，包括角度、距离和持续时间，都可在UI中调整。旋转的速度和方向也可以在每一步中修改。可以使用&b红石比较器&r来读取序列的当前步骤，输出1到5的信号强度。"
	]
	quest.35C37231C1C86294.quest_desc: [
		"&e强力胶水&r用于将方块连接到装置上。可以逐块应用于&b底盘&r，或使用区域模式将选中的多个方块粘合在一起。"
		"{@pagebreak}"
		"&l逐块放置模式&r"
		"右键点击&b底盘&r的某个面，并使用&e强力胶水&r进行涂覆。你也可以在放置方块时将其放在副手，实现自动粘合。"
		"{@pagebreak}"
		"&l区域模式&r"
		"右键点击选区相对的两个对角，即可粘合该区域内的所有方块。"
	]
	quest.35C37231C1C86294.title: "&a强力胶水"
	quest.3617DE87C4E1BCB9.quest_desc: [
		"当玩家右键点击&e手摇柄&r时，会产生少量的&d旋转力&r。"
		""
		"&e水轮&r是一种产生&d旋转力&r的发电机。当&b水&r流过其侧面时，它会发电。"
	]
	quest.3617DE87C4E1BCB9.title: "生成力量！"
	quest.383D6F1A001A0AEC.quest_desc: ["&e滑道&r可将物品垂直向下运输。使用&b封闭式风扇&r可将物品向上吹送。而&d智能滑道&r则支持物品过滤功能。"]
	quest.38E9C4DB82B1279A.quest_desc: ["&eContraption Controls&r 方块可用于启用或禁用移动装置上的执行器，如钻头或锯子。应用过滤器以控制特定执行器。"]
	quest.3A2633B6030BBC52.quest_desc: ["佩戴&e工程师护目镜&r时，会显示机械系统的信息，如应力冲击、转速和&b流体储罐&r中的流体量。"]
	quest.4181323BF72047A9.quest_desc: ["将&e时刻表&r给列车长（&b坐姿生物&r或&b烈焰燃烧器&r）以自动化列车。时刻表可包含前往车站或设置最高速度等指令。"]
	quest.4266BF7FCE3B4330.quest_desc: [
		"&eShaft&r 是一种基本机械组件，用于在其他组件之间传递旋转动力。可以在上面放置 &bMechanical Belts&r。"
		"{@pagebreak}"
		"&eCogwheel&r 是一种用于传递旋转的基本组件。其更大的变种，&eLarge Cogwheel&r，可以绕过拐角传递旋转并为 &bRotation Speed Controllers&r 提供动力。"
	]
	quest.4266BF7FCE3B4330.quest_subtitle: "旋转的基本构建模块。"
	quest.4512B97451C2221F.quest_desc: ["&e机械臂&r可以在5格半径内的物品栏之间移动物品。将鼠标悬停其上并使用&b扳手&r，即可查看其选定的输入和输出点。"]
	quest.45BA5B8A785E1B82.quest_desc: ["使用&e扳手&r可以旋转组件并安全地拆除它们。潜行状态下使用可拆除带有右键功能的方块。你也可以在悬停于某些组件上时，用鼠标滚轮进行配置。"]
	quest.46004D01A142777E.quest_desc: ["&e智能流体管道&r是一种&b流体管道&r，可以通过过滤来只允许特定液体通过。"]
	quest.4A7F96E62A5845C5.quest_desc: [
		"&e机械活塞&r是一种在接收到&d旋转动力&r时会伸出的装置。"
		""
		"碰到无法移动的方块就会停止。需要 &bPiston Extension Poles&r 来伸出。反转旋转即可缩回。在末端使用 &bSlimeball&r 使其变粘，从而拉回方块。"
	]
	quest.4B976C143EDA4317.quest_desc: [
		"&e外壳&r是许多合成配方中使用的装饰性方块。 &d安山岩外壳&r用于基础装置。"
		"{@pagebreak}"
		"将&b合金&r或&b锭&r应用到&b去皮原木&r上即可制作外壳。大多数外壳可用于装饰性包裹&b传动轴&r、&b齿轮&r和&b机械皮带&r。而&d铜外壳&r则专门用于&b流体管道&r。"
	]
	quest.4B976C143EDA4317.quest_subtitle: "兼具装饰性与实用性的方块。"
	quest.4B976C143EDA4317.title: "安山岩外壳"
	quest.4C7CD3858A2BE870.quest_desc: ["&e机械压机&r将放置在下方&b料斗&r或&b盆&r上的物品进行压制和压缩。它由传动轴驱动，用于将&b锭&r制成&b板&r。"]
	quest.4D482A1A908ABFDA.quest_desc: ["&e径向底盘&r会连接到其周围的方块半径。使用&b史莱姆球&r或&b强力胶水&r使其表面变得粘性。半径可以用&b扳手&r进行调整。"]
	quest.4E5C6F23628A9982.quest_desc: ["&eEncased Chain Drive&r 是一种传递旋转的组件。将多个驱动并排放置，垂直或水平呈直线排列，即可形成一个在它们之间传递动力的链条。"]
	quest.4F78122BABAB041C.quest_desc: ["&e机械犁&r安装在移动装置上时，可以破坏作物和高草丛等非实心方块。它还可以用来将土壤翻耕为&b农田&r。"]
	quest.50CE0BD7B0BC4017.quest_desc: ["当对&e流体阀门&r的侧面施加旋转力时，可以阻止或允许液体流动。这通常通过&b阀门手柄&r或&b齿轮换挡器&r来实现。"]
	quest.51CCB7ACFD7B45F1.quest_subtitle: "一种用于制作钥匙的材料。"
	quest.53ADE53114671F23.quest_desc: [
		"&dCreate&r 模组的核心是旋转动力，一种由水车和风力发电机产生的能量形式。"
		""
		"用它来为装置供电，自动化你的世界。"
	]
	quest.53ADE53114671F23.quest_subtitle: "关于该模组的介绍。"
	quest.53ADE53114671F23.title: "欢迎来到创造模式"
	quest.53C0234C053BF0CF.quest_desc: ["将 &eStock Link&r 放置在 &bPackager&r 上，将其物品栏连接到物流网络。 &eStock Links&r 没有距离限制，但必须在已加载的区块中才能工作。"]
	quest.54778BD66812A1CF.quest_desc: ["&e流体管道&r是一种用于在储罐和机器之间运输流体的组件。它是流体自动化装置的重要组成部分。"]
	quest.566D6390193DD77D.quest_desc: [
		"&e黄铜隧道&r用于&b机械传送带&r，以分割、分类和合并物品流。"
		""
		"相邻放置时，它们会组成一个群组，收集所有相连输入的物品，并根据各自的设置将其分配到输出端。"
	]
	quest.5A2450162FD24F7E.quest_desc: ["要使用&eCrushing Wheels&r，将两个轮子并排放置，间隔一个方块，并以相反方向驱动。掉落在它们之间的物品将被压碎。"]
	quest.5A2450162FD24F7E.quest_subtitle: "将压碎配方应用于物品。"
	quest.5A2450162FD24F7E.title: "压碎车轮"
	quest.5AFD4912CC8FBBB8.quest_subtitle: "一个必要的合成组件。"
	quest.5C2108BD3DEEB0E6.quest_desc: ["&eSpout&r用于填充容器液体或用于涉及流体的配方。它必须通过&bFluid Pipes&r提供液体，并将其倾倒在下方的&bConveyor Belt&r或&bDepot&r上的物品上。"]
	quest.605C0B84DFC1A4D5.quest_desc: ["当&bGantry Shafts&r被供电时，&eGantry Carriage&r会沿其移动。反转旋转方向可使其反向行驶。向竖轴施加&bRedstone Signal&r可停止车厢。"]
	quest.61348E2551E8AD6C.quest_desc: ["&e旋转速度控制器&r必须与&b大型齿轮&r搭配使用。它能让你设置精确的旋转速度输出，最高可达256 RPM，方向可逆。"]
	quest.626580DB654F128D.quest_desc: ["&eMillstone&r会将小麦磨成面粉等配方，应用于从上方投入的任何有效物品。"]
	quest.62BAE54B507B7A21.quest_subtitle: "用于合成的原材料之一。"
	quest.6350ADB7540C368D.quest_desc: [
		"当&e智能观察者&r检测到特定物品或方块时，会发出&b红石信号&r。"
		""
		"它可以观察&b机械传送带&r、&b漏斗&r或&b流体管道&r中的物品。"
		""
		"使用 &bFilter&r 来指定要检测的物品。"
	]
	quest.66D9F91519D52482.quest_desc: ["&e烈焰蛋糕&r是一种特殊燃料，用于在&b烈焰燃烧器&r上达到&d超高温&r状态，这是某些高级配方所必需的。"]
	quest.6819665DA7028C9E.quest_subtitle: "用于多种合成配方中。"
	quest.6CD96328B7567F46.quest_desc: ["当&e机械收割机&r安装在移动装置上时，会自动收割接触到的成熟作物。"]
	quest.6D03D3B4D83C1840.quest_desc: [
		"&eMechanical Crafter&r 用于自动化合成。使用 &bWrench&r 点击正面以设置输出方向。多个合成器可组合成一个合成网格。"
		"{@pagebreak}"
		"当机器通电且有效配方所需的所有材料槽位都已填满时，合成器会将物品组合成最终产物。"
	]
	quest.6E8C6A4A07957E5A.quest_desc: ["&e软管滑轮&r可以伸缩软管，将大面积区域排空或注满液体。需要&b流体泵&r来移动液体。"]
	quest.719218CEA358D540.quest_desc: ["&e铁轨&r可以放置在地面或方块侧面以创建斜坡。潜行时使用&b扳手&r可安全拾取。"]
	quest.7322A19FDA5B78E1.quest_desc: ["&e阀门手柄&r的功能与&b手摇柄&r类似，但可以在其UI中配置旋转量和方向。"]
	quest.732D1A96512F2BFD.quest_desc: [
		"&e蒸汽机&r是一种强大的发电机，可提供&d旋转力&r。在生存模式下，它的应力单位（SU）容量是所有发电机中最高的。要使其正常工作，必须将其放置在装有&b水&r的&b流体储罐&r上，水在底部加热时会充当锅炉。"
		"{@pagebreak}"
		"锅炉的功率由三个因素决定：大小、水量和输入热量。单个&e蒸汽引擎&r只能提取一定量的功率（16,384 SU）。要充分发挥锅炉的潜力，可以连接多个引擎。功率通过&b传动轴&r进行传输。"
		"{@pagebreak}"
		"对于一级或以上的活性锅炉，&b流体储罐&r的容量必须至少为所施加热量等级的4倍。例如，9级锅炉需要至少由36个方块组成的储罐。"
	]
	quest.743C84D1D94C5670.quest_desc: ["&e黄铜漏斗&r是&b漏斗&r的进阶版，可配置特定数量的物品移动，适用于精确自动化。"]
	quest.75E7216AB5411DF6.quest_desc: [
		"&e机械锯&r在通电后，会砍掉前方的树木。它只需砍掉最底部的树干，就能砍倒整棵树。"
		"{@pagebreak}"
		"在移动装置上时，它会损坏接触到的实体并破坏木头方块。"
	]
	quest.768789FEB6EBB8F8.quest_desc: [
		"&e烈焰熔炉&r是某些&b混合&r配方所需的加热源，例如制作&d黄铜&r。它还可以为&b蒸汽机&r的锅炉供暖。"
		"{@pagebreak}"
		"正在加热"
		"用&b熔炉燃料&r右键加热，或用&b烈焰蛋糕&r来&d超高温加热&r以进行高级工艺。"
	]
	quest.768789FEB6EBB8F8.quest_subtitle: "某些配方所需的必要热源。"
	quest.76919513DA354DBC.quest_desc: ["&e齿轮箱&r可将&d旋转动力&r向四个方向传递。当一侧接收动力时，其余三侧将反向输出旋转。它既有水平版，也有垂直版。"]
	quest.78A9A4A3089E17B9.quest_desc: [
		"&e外壳&r是许多合成配方中使用的装饰性方块。 &d铜外壳&r专用于&b流体管道&r"
		"{@pagebreak}"
		"将&b合金&r或&b锭&r应用到&b去皮原木&r上即可制作外壳。大多数外壳可用于装饰性包裹&b传动轴&r、&b齿轮&r和&b机械皮带&r。"
	]
	quest.7917E75BBA3F0614.quest_desc: ["&e显示链接&r将信息从一个源方块传输到&b显示板&r。在显示器上使用链接，然后将其放置在源上。右键单击链接以配置输出文本。"]
	quest.7B5DF264A026BBD0.quest_desc: ["&e可调式链轮&r的运作方式与&b封闭式链传动&r相同，但其输出速度可通过&b红石信号&r进行切换。"]
	quest.7C074B5E2A0EAA63.quest_desc: ["要操作火车，需要放置&eTrain Controls&r方块。其后必须放置&bBlaze Burner&r或&bSeat&r供司机使用。右键点击控制器可手动驾驶火车。"]
}
