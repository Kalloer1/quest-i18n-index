				title: "建筑材料方块"
				type: "checkmark"
			}]
			x: -4.5d
			y: 0.5d
		}
		{
			id: "37173A06CDEA81AC"
			subtitle: "支撑物能让洞穴潜水更安全！采矿也一样！一定要支撑好天花板，不然会变成洞穴煎饼！"
			tasks: [{
				id: "3FFAB5FE15DEA5F5"
				title: "支持者们！"
				type: "checkmark"
			}]
			x: -6.0d
			y: -5.0d
		}
		{
			id: "3C3CBFA466EF3B50"
			subtitle: "用泥土块和稻草可以制作泥砖！这样能获得1/4个泥砖块！然后，手持湿泥砖右键地面，放置它进行晾干！经过一整天的晾干，就可以和3个同类砖块组合，制作你的第一个坚固屋顶！注意，下雨时晾干会停止！"
			tasks: [{
				id: "10138F9B475A7EB1"
				title: "泥土砖块"
				type: "checkmark"
			}]
			x: -4.5d
			y: 2.5d
		}
		{
			id: "1B985BBA3D203E72"
			subtitle: "草皮是绝佳的早期屋顶！它能挡住雨水，保护你和你下方的东西。但它也能被穿过，所以不适合作为墙壁、地板或一般建筑的建材！"
			tasks: [{
				id: "6B6F3A1633C20255"
				title: "茅草屋顶"
				type: "checkmark"
			}]
			x: -5.5d
			y: 2.5d
