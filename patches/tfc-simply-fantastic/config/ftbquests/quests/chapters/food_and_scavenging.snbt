			}]
			x: 0.0d
			y: 0.0d
		}
		{
			id: "38A7DADACD802AD6"
			subtitle: "动物不会重生。也就是说，如果你想养动物，就必须避免杀死你想养殖的动物！"
			tasks: [{
				id: "2864CF234A35FA5A"
