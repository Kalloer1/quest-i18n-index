	quest.719014BC6E32D93D.quest_desc: ["更大的作物和植物？"]
	quest.71D59895A2536322.quest_desc: [
		"请注意，打开此消息即表示您已签署合同，承诺在完成本文件（下称“任务书”）中所有任务前，将继续为 Opolis Inc. 工作。您亦同意免除 Opolis Inc. 在任职期间可能发生的任何损害责任，包括您的意外死亡。"
		""
		"感谢您选择 Opolis Inc.，希望您在这里度过愉快的时光！请记住，效率第一。"
	]
	quest.71D59895A2536322.title: "合法的叽里咕噜语"
	quest.720CBDE4D0F34D5B.title: "不可破坏的精英悬赏许可证"
	quest.72145250E2C6518F.title: "Signalum"
	quest.723D2DFD3C04F993.quest_desc: ["用于将电力从一个地方传输到另一个地方"]
	quest.729683BCAE8162FD.quest_desc: ["由“Punch Tree, Get Wood”的创作者为您呈现"]
	quest.729683BCAE8162FD.title: "日志"
	quest.72C96279B2DE4446.title: "现实被颠覆"
	quest.72CB924ABE508C6C.quest_desc: [
		"奥波利斯公司员工请注意保管好自己的物品。但我们理解，人非圣贤，难免会犯错，比如遗忘。因此，我们提供了奥波利斯公司过滤物品定位探测器，简称F.I.N.D.。在物品上按“Y”键，F.I.N.D.将显示附近含有该物品的存储方块。"
		""
		"过度使用本设备可能导致被转介至精神科医生处，以排查早期痴呆症的可能。"
	]
	quest.73120C36E765678E.quest_desc: [
		"允许你将物品出售以换取精英农场币。"
		""
		"订单可能包括："
		"哭泣的藤蔓"
		"扭曲的藤蔓"
	]
	quest.73345A46ACA6E6C4.title: "路由器"
	quest.737B28F09C4B211F.quest_desc: ["村民会随着你的交易而升级。达到最高等级后，牧羊人、木匠和石匠会提供此物品。"]
	quest.741B9E8DA175CB55.title: "不可破坏的基础存储许可证"
	quest.7473FC1BC15A4BA3.title: "蜘蛛之眼"
	quest.7481FF23EFC4EDD0.title: "不可破坏的高级加工许可证"
	quest.74CDD85558E1A976.quest_desc: ["基础采矿材料"]
	quest.74D5A2BB6858DBCF.title: "恶魂之泪"
	quest.74DA5ACCDD97CD63.quest_desc: ["好了，这就是史上最强大的合金——奥波利特！它将为我们的高端电子产品提供一个极其强大的基础。"]
	quest.74DA5ACCDD97CD63.quest_subtitle: "完美的合金配方"
	quest.74DA5ACCDD97CD63.title: "奥波利特"
	quest.74EFACD051BCB09A.quest_desc: ["完成交易后，猪灵会提供收据。不过，它们并不总是会给。会计部门的人说这是逃税，但他们坚持这只是“朋友间偶尔的随意交易”。"]
	quest.750E3B4C2196EEA1.title: "激活的末影珍珠"
	quest.75E3A3764D1DE51E.quest_desc: ["Signalum 是一种由铜、银和红石制成的合金。"]
	quest.765424007AEB1FE2.quest_desc: ["觉醒祭坛是融合祭坛的替代版本，用于使用更多材料来创造更强大或更复杂的物品。"]
	quest.765424007AEB1FE2.title: "觉醒祭坛"
	quest.765B13B54586B316.quest_desc: [
		"厌倦了许可证要求你没有的东西吗？想安心卖掉所有心爱的原石吗？别担心了，亲爱的员工，许可证技术的未来已经到来！"
		""
		"隆重推出，特种许可证！有了这个自由市场的奇迹，所有烦恼都将烟消云散。订单们将不再纠缠你索要多余物品，而是遵循固定的模式。听起来很棒吧？"
		""
		"但是，这需要代价！这项技术很昂贵，所以我们需要确认你有足够的资金来维持。只需支付一笔大额定金，我们就会授予你该物品的专属许可证，让你能卖出更多，&l完全免费&r！"
		"{@pagebreak}"
		"&o特殊许可证视供应情况而定。优惠有效期为未来30秒。适用条款与条件。&r"
	]
	quest.765B13B54586B316.title: "今日就开始专精吧！"
	quest.76F2626A0A44FD0A.quest_desc: ["将 Noisy Activation Essence 与 Liquid Null 一同放入 Chemical Washer 中，即可清除背景杂音，得到 Filtered Activation Essence。"]
	quest.76FE92675A390765.quest_desc: ["可以在市场上出售"]
	quest.784C48A1CC79199D.quest_desc: [
		"混合你的合金将创造惰性奥波利斯合金。该合金最初由奥波利斯公司首席运营官 E. Zoro 提出理论，并由奥波利斯公司创始人兼首席执行官 B. Benlaw 首次合成。它被誉为“完美合金”，并使奥波利斯公司声名鹊起。它已被用于制造从完全稳定的建筑到不可穿透的辐射屏蔽等各种东西。"
		""
		"不过，要这样使用它，还需要几步。合金化过程会极大地提高所用金属的能量容量。这使得它尽管含有大量激活能，却实际上处于惰性状态。你需要更强大的东西来填充它。"
	]
	quest.78542DD57A94AADB.quest_desc: [
		"我们不确定破碎奇点是如何存在的，但它似乎比普通奇点更兼容常规物质。"
		""
		"在此提醒您，您在工作中造成的自身或随身物品的任何损坏，Opolis Inc. 概不负责。"
	]
	quest.78542DD57A94AADB.title: "本不该存在的事物 (Matter that Shouldn't Exist)"
	quest.788336FE241C1FBC.quest_desc: ["黏土方块掉落物"]
	quest.78C8A7A6ED94E498.title: "不可破坏的高级采矿许可证"
	quest.793DD6DAA9756916.title: "终极不可破坏加工许可证"
	quest.79762A148C8E0ECE.quest_desc: ["不可破坏的许可证不会过期"]
	quest.79762A148C8E0ECE.title: "不可破坏的基础采矿许可证"
	quest.798C22A23B7642F8.quest_desc: ["冶金注入器可用于制作基础控制电路，这是一种用作高级系统坚实基础的电子元件。"]
	quest.798C22A23B7642F8.title: "岩石与……思想？"
	quest.79B28E845BA5DDA9.quest_desc: ["将价值2个（铜为7个，红石为8个）的熔炼材料（锭/粉尘/宝石）浇铸在石头、深板岩、下界岩或末地石上，会生成一种新的矿石，可供你投入工业流程中"]
	quest.79B28E845BA5DDA9.title: "矿石铸造"
	quest.7A09C20566FD4981.quest_desc: [
		"燃料充足时，它会完全挖掘放置所在区块的所有方块。请注意放置位置，切勿在单个区块内放置超过2个。"
		""
		"请记住，采石场相关伤害不在 Opolis Inc. 健康保险范围内。你的健康也不在，如合同所述。"
	]
	quest.7A24441FF953CC9E.quest_desc: [
		"你可以使用物品栏左下角的&l暗模式&r按钮来启用不同级别的&l暗模式&r"
		""
