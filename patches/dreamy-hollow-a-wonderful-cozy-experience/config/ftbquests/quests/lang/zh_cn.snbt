	quest.4F20A92FD993CD9F.quest_desc: ["&6Modulating Linked Receivers&r 可以检测到其他附近 Redstone Links 的距离，而 &6Directional Linked Receivers&r 可以检测到其他附近 Redstone Links 的角度。"]
	quest.4F20A92FD993CD9F.title: "&6连锁接收器"
