	quest.666685F10CB518DA.title: "大师试炼"
	quest.66731E7E2CE0FB5F.quest_desc: ["§6Green Matter§r，物质层级 §e10§r。层级 §e10§r 收集器、中继器、花朵和链接的制造材料。"]
