	quest.451E4F4A7AC324BF.quest_desc: ["将鼠标悬停在物品上并按住 Shift 键以查看属性。"]
	quest.454B473F16B73356.quest_desc: ["每个等级都会增加更多的存储栏位和升级栏位。"]
	quest.45887881B110D056.quest_desc: [
		"压缩筛可用于筛选压缩方块——九个方块一次性搞定！"
		""
		"将多个压缩筛并排放置（可尝试3x3的正方形），即可同时筛选。普通筛和压缩筛的区别在于，你需要逐个填充压缩筛，之后才能同时筛选。"
	]
	quest.4590A81AEF047F81.quest_desc: ["收集装备，直到每种稀有度（普通、不常见、稀有、史诗和神话）的附加材料各有一个。这些材料用于重铸和宝石镶嵌。"]
	quest.4590A81AEF047F81.quest_subtitle: "Apotheosis"
	quest.4590A81AEF047F81.title: "稀有度材料"
