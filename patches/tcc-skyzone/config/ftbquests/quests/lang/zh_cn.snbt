	quest.5EADF3206B765CB3.quest_subtitle: "大灾难"
	quest.5EADF3206B765CB3.title: "利维坦（The Leviathan）"
	quest.5ED3B76A5E486F6E.quest_desc: ["巫师套装可提升最大法力值和法力再生。在附魔台用法师花纤维和金质盔甲合成。"]
	quest.5ED3B76A5E486F6E.quest_subtitle: "Ars Nouveau"
	quest.5EDF6ACCA6C8FAB0.quest_desc: ["§6改进型机器核心§r，由碳纤维和红石粉锁定。可解锁三级机器。"]
