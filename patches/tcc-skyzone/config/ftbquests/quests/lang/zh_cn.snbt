	quest.36E5CD76A71A3FB3.quest_desc: ["右键单击方块以选中它，然后在该建造范围内将其替换为匹配方块。潜行右键单击空气以更改模式。"]
	quest.36E5CD76A71A3FB3.quest_subtitle: "BetterBlockz"
