	quest.07ACB0F8CBD46771.quest_desc: [
		"无线供电！你还能奢求什么呢？"
		""
		"从通量网络中移除能量"
	]
	quest.07C8A0E167663878.quest_desc: ["用于压制§b量子电路§r的刻印机。将其放置在刻印机中即可印制处理器。"]
	quest.07C8A0E167663878.quest_subtitle: "高级自动化系统 (Advanced AE)"
	quest.07FD17445A955429.quest_desc: ["可让你自动化复杂的合成配方。将物品栏置于顶部，即可自动将物品拉入合成台。"]
	quest.0802317B97D895D4.quest_desc: ["[ \"必须完成此任务 \", { \"text\": \"Canola Press\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"5F0F1FFB4160C1C0\" } }, \" 才能解锁。\" ]"]
	quest.0802317B97D895D4.quest_subtitle: "10 枚硬币"
	quest.0802317B97D895D4.title: "稀有奖励袋"
	quest.080351918262382E.quest_desc: ["§6终极能量花§r，等级§e16§r，共§e16§r级。能量花是一个集收集器、中继器和冷凝器于一体的自给自足方块，能自行产生EMC。"]
	quest.080351918262382E.quest_subtitle: "项目扩展：能量花朵"
	quest.080351918262382E.title: "终极力量之花 [MK 16]"
	quest.080B650EBD5E9738.quest_desc: ["处理器是AE2设备和机器的主要材料之一，也是早期自动化的一大挑战。处理器有三种类型，分别由金、Certus石英晶体和钻石制成。它们需要通过刻印机，经过多步骤操作（通常使用一系列刻印机和过滤管道）来制造。"]
	quest.080B650EBD5E9738.title: "处理器"
	quest.08179DC19520193E.quest_desc: ["这些工作台用于更复杂的合成配方。也有自动化版本可用。更多详情请见JEI。"]
	quest.083961E5D54A4AF2.quest_desc: ["合成组件。可升级至下一阶段，请参见JEI。"]
