	quest.03EB4D6A471B02DF.title: "悬赏任务"
	quest.03F21A20BD91F3CA.quest_desc: ["在地下花园击败遗忘守护者，可获得四到十六个遗忘金块。建议使用探险家罗盘来寻找它们生成的地下墓穴结构。"]
	quest.03FA028665CF7EA7.quest_desc: ["抵达Tier §e7§r §6Dank§r，这是整合包里最大的便携式存储，一个完整的存储系统仅占一个物品栏。"]
	quest.03FA028665CF7EA7.quest_subtitle: "Dank Storage"
	quest.03FA028665CF7EA7.title: "最大容量"
	quest.04018F4D53E5E1F4.quest_desc: ["在改装站安装的 MekaSuit/Meka-Tool 模块。"]
	quest.04018F4D53E5E1F4.quest_subtitle: "MekaSuit \& Meka-Tool"
	quest.04018F4D53E5E1F4.title: "营养注射模块"
	quest.0405CE0795C03068.quest_desc: ["在混沌岛上收集 §e128§r 个混沌碎片。"]
	quest.0405CE0795C03068.quest_subtitle: "宗师级大师"
	quest.0405CE0795C03068.title: "混沌的碎片 (Shards of Chaos)"
	quest.04194DB3DE85D3B4.quest_desc: ["翡翠喷射背包是本模组中最高级的喷射背包。"]
	quest.04302B91E4C81869.quest_desc: ["制作一个§6Dank蓝图§r，将某个Dank的锁定和过滤设置复制到另一个，保持你设置中的所有Dank行为一致。"]
	quest.04302B91E4C81869.quest_subtitle: "Dank Storage"
	quest.04302B91E4C81869.title: "蓝图"
	quest.04368E0530B208BD.quest_desc: [
		"右键可立即挖掘矿石脉。挖掘（左键）模式如下（按G循环）："
		"- 标准：每次破坏一个方块"
		"- 3x 高射速：可垂直破坏3个方块"
		"- 3x wide-shot: 水平方向一次性破坏3个方块"
		"- 3x long-shot: 一次性破坏你前方一行中的3个方块"
	]
	quest.0458AAC63DACF081.quest_desc: ["在改装站安装的 MekaSuit/Meka-Tool 模块。"]
	quest.0458AAC63DACF081.quest_subtitle: "MekaSuit \& Meka-Tool"
	quest.0458AAC63DACF081.title: "脉矿挖掘模块"
	quest.045981728DE009FB.quest_desc: ["在改装站安装的 MekaSuit/Meka-Tool 模块。"]
	quest.045981728DE009FB.quest_subtitle: "MekaSuit \& Meka-Tool"
	quest.045981728DE009FB.title: "机车助推模块"
	quest.046AA10B979CE7CF.quest_desc: ["中后期物品的合成材料！"]
	quest.0479C735A364CBDA.quest_desc: ["使用赞石宝石制作的§6祭坛§r可用于附魔重力矿石。"]
	quest.048562A37605A388.quest_desc: ["§6精英精炼工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.048562A37605A388.quest_subtitle: "额外内容：工厂"
	quest.048562A37605A388.title: "精英富集工厂"
	quest.04DA4E4CA09C332D.quest_desc: ["§6终极感应单元§r。提升感应矩阵的能源容量。"]
	quest.04DA4E4CA09C332D.quest_subtitle: "额外内容：储物空间"
	quest.04DA4E4CA09C332D.title: "终极感应线圈"
	quest.04E6EB2D8FFE1EBA.quest_desc: ["用刀具收割草类植物（如草、小麦、水稻等）偶尔会产出稻草，这是一种坚固实用的纤维"]
	quest.04EE4DB9CCBE041E.quest_desc: ["§6终极净化工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.04EE4DB9CCBE041E.quest_subtitle: "额外内容：工厂（Factories）"
	quest.04EE4DB9CCBE041E.title: "终极净化工厂"
	quest.04F821C6068063F1.quest_desc: ["组件用于制作催化剂。越高级别的组件，制作难度越高。"]
	quest.05016BF9CC2CA48B.quest_desc: [
		"末地传送门可以无线从末地电池获取能量（类似于Flux Networks）。两者都可以升级。"
		""
		"别忘了给末影电池装上电池来储存能量！"
	]
	quest.05084CEFFE45A73D.quest_desc: ["锻造全套 §6Cursium§r 套装：头盔、胸甲、护腿和靴子。"]
	quest.05084CEFFE45A73D.quest_subtitle: "大灾难"
	quest.05084CEFFE45A73D.title: "Cursium 盔甲"
	quest.050B1798A960782A.quest_desc: ["制作一个§6精英园艺盆§r。更高等级的花盆能让作物长得更快、容量更大，是扩大你花园的好方法。"]
	quest.050B1798A960782A.quest_subtitle: "植物学花盆"
	quest.050B1798A960782A.title: "精英种植园"
	quest.050E9ECB6D658C96.quest_desc: ["实体传送器将生物和物品沿水平方向移动。"]
	quest.0547E8486642D847.quest_desc: ["电路靠红石运行。在电线耗尽前，采集2048个红石。"]
	quest.0547E8486642D847.quest_subtitle: "见习工程师"
	quest.0547E8486642D847.title: "红色警报"
	quest.0565492F3A30C232.quest_desc: ["用磁铁矿重加工 Ludicrite 获得，磁铁矿是使用 Bluetonium 作为反应堆燃料的废料。"]
	quest.056581323A984B97.quest_desc: ["§a简易村民§r让你潜行右键村民，将其变为可携带和放置的§6村民§r物品。抓住一个开始吧。"]
	quest.056581323A984B97.quest_subtitle: "简易村民模组 (Easy Villagers)"
	quest.056581323A984B97.title: "抓捕一个村民"
	quest.058EB5BF17DB9CBD.quest_desc: ["通过旋转的涡轮机来产生电力。"]
	quest.058EB5BF17DB9CBD.quest_subtitle: "多区块结构"
	quest.058EB5BF17DB9CBD.title: "电磁线圈"
	quest.05991983A094DFED.quest_desc: ["在抄写台（Scribes Table）上为其编写咒语，然后将其应用于施法魔典（Caster Tome）、法术弓（Spell Bow）或炮塔（turret）。"]
	quest.05991983A094DFED.quest_subtitle: "Ars Nouveau"
	quest.05C818675A4A2782.quest_desc: ["利用煤炭和太阳能来发电。"]
	quest.05C818675A4A2782.title: "生成器"
	quest.05DCA3861D5CA80F.quest_desc: ["§6鲁比汀修饰器§r。将它们放入鲁比汀矿机以进行调整：§e能量§r降低功耗，§e物品§r提高产量，§e速度§r使其运行更快。制作全部三种以获得§e1§r级。"]
	quest.05DCA3861D5CA80F.quest_subtitle: "虚空矿工"
	quest.05DCA3861D5CA80F.title: "鲁比汀修饰器"
	quest.05E67DC4DEA264A6.quest_desc: ["为每个 Industrial Foregoing 透镜创建一个采矿激光装置（列表见 JEI）。"]
	quest.05EC1D616C2A9AD8.quest_desc: ["发送无线红石信号。"]
	quest.05F03B665480F135.quest_desc: ["在改装站安装的 MekaSuit/Meka-Tool 模块。"]
	quest.05F03B665480F135.quest_subtitle: "MekaSuit \& Meka-Tool"
	quest.05F03B665480F135.title: "陀螺稳定模块"
	quest.05FBD6E845323EA0.quest_desc: ["§65x 矿石处理§r核心：将矿石溶解成肮脏的浆料。"]
	quest.05FBD6E845323EA0.quest_subtitle: "化学与加工 (Chemistry \& Processing)"
	quest.05FBD6E845323EA0.title: "化学溶解室"
	quest.05FDF7CEC51457BE.quest_desc: [
		"可用于消化、发酵和液化配方中。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.0621C7B771E959F0.quest_desc: [
		"开启这一切的精髓所在……"
		""
		"Inferium Essence 是制作 Mystical Agriculture 方块和物品所需的关键材料之一。可以通过击杀敌对和被动生物，以及种植 Inferium Seeds 来收集。"
		""
		"用于创造 Tier 1 和元素种子。（专家模式下需要晶体）"
	]
	quest.0631A71ED542F1DB.quest_desc: ["戴上野兽的头骨作为头盔。"]
	quest.0631A71ED542F1DB.quest_subtitle: "大灾难"
	quest.0631A71ED542F1DB.title: "怪物头盔"
	quest.06397541643EE9E4.quest_desc: [
		"末地方块受限，耐久度为4。"
		"无法在混沌方块、终极方块、无限方块、无限核心、终极核心、克莱因星核心、HDPE方块、钚方块、钋方块或反物质方块上使用。"
		""
		"用魔杖右键点击方块 → 它会变成一个 Enlivened Block 实体。"
		""
		"被激活的实体可被其他模组捕获/复制，从而提供该方块的可持续来源。注意：若生成器不复制NBT，此方法无效。"
		""
		"使用生物囚禁工具作用于你的新实体，并在工业前序生物复制器中进行复制。"
	]
	quest.0660FFD00517B41D.quest_desc: ["§6白色燃料§r。由物质提炼的致密 EMC 燃料，用于上层机器。"]
	quest.0660FFD00517B41D.quest_subtitle: "项目扩展：燃料 (Project Expansion: Fuel)"
	quest.0660FFD00517B41D.title: "白色燃料"
	quest.066243CCEE772F0A.quest_desc: [
		"魔法豆是一堆色彩缤纷的豆子，可以在巨魔洞穴的小宝库中找到。通常需要钻石镐或同等强度的镐来打开宝库并获取豆子。你还可以通过幸运地击杀巨魔来获得魔法豆。"
		""
		"当魔法豆种在Uberous土壤中时，会长出一根直达云层的巨大豆茎。这是通往高地之上Cloud Cottage的便捷方式。"
	]
	quest.066E2CD8219B369B.quest_desc: ["存储升级，等级1。悬停物品查看详情。可升级为黄金升级。"]
	quest.0678B5715CCEEE6A.quest_desc: ["§6化学注射室§r使用氯化氢气体将矿石转化为4个碎片。这是x4矿石处理的开端，需要稳定的氯化氢供应，而这又要求玩家运行一个热蒸发装置。"]
	quest.067ECCB49F68CBFA.quest_desc: ["可升级的尖刺。计为玩家击杀。需要红石信号。"]
	quest.067F064F06BF1AB7.quest_desc: ["256M量子存储单元。终局ME存储。"]
	quest.067F064F06BF1AB7.quest_subtitle: "高级自动化系统 (Advanced AE)"
	quest.06937888BFF8D767.quest_desc: [
		"带有升级插槽的 Ender IO 机器需要电容器才能运行。"
		""
		"电容器可以根据其基础修饰符，提升机器的速度、射程或能量存储。"
		""
		"等级：8"
	]
	quest.069E63ED541E52F5.quest_desc: ["§6闪耀§r材质，超越热核。通往宇宙级的门户。"]
	quest.069E63ED541E52F5.quest_subtitle: "合金"
	quest.069E63ED541E52F5.title: "闪耀着光芒的矿石块（Shining Ore）：用于制作发光方块，可放置在地面上。放置后，会发出柔和的光芒，照亮周围的环境。可用于制作发光方块，也可作为装饰物放置。"
	quest.06A46A5949A9F3BA.quest_desc: [
		"成功登陆金星以完成此任务。"
		""
		"注意：金星含有氘化铀（具有放射性）。"
	]
	quest.06AFFD35118536C2.quest_desc: ["建造一个凋零农场并击败16个凋零。"]
	quest.06AFFD35118536C2.quest_subtitle: "大师"
	quest.06AFFD35118536C2.title: "凋零风暴"
	quest.06BAFFA40A561DA9.quest_desc: [
		"Farmer's Delight 是一个温和扩展了 Minecraft 中种植和烹饪内容的模组。"
		""
		"炉灶是篝火烹饪功能的直接升级，也是烹饪锅的合适热源。"
	]
	quest.06BAFFA40A561DA9.quest_subtitle: "农夫的欢乐时光"
	quest.06C455029272B91E.quest_desc: ["每张§b量子能力卡§r都由空白卡制成。将卡牌插入量子护甲。"]
	quest.06C455029272B91E.quest_subtitle: "高级自动化系统 (Advanced AE)"
	quest.06CD97C9646E044D.quest_desc: ["量子能量饱和的尘埃，用于锻造量子合金和处理器。"]
	quest.06CD97C9646E044D.quest_subtitle: "高级自动化系统 (Advanced AE)"
	quest.06D2CFE80DDB16E1.quest_desc: ["收集大师印记：重生、恶意和至高，它们是完善装备最稀有的工具。"]
	quest.06D2CFE80DDB16E1.quest_subtitle: "Apotheosis"
	quest.06D2CFE80DDB16E1.title: "Sigil 大师们"
	quest.06E11A9D54E76D4B.quest_desc: ["§6至尊回收工厂§r。仅限Extras模组的一种工厂类型，可在最高四个等级中出现。"]
