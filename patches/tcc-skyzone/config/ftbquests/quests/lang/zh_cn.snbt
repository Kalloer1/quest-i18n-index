	quest.11EFB5CC1817CF37.quest_subtitle: "反应堆"
	quest.11EFB5CC1817CF37.title: "激光"
	quest.11F34F6309A89E31.quest_desc: ["Tier 3. 可存储 300 个物品栏。"]
	quest.120A4A99099FE5E4.quest_desc: ["无限容量的存储方块，可提供和储存任何流体，且无数量限制。"]
	quest.1210D7BF557B267B.quest_desc: ["§6宇宙冲压工厂§r。仅限Extras模组的工厂类型，可在最高四个等级中出现。"]
	quest.1210D7BF557B267B.quest_subtitle: "额外内容：工厂"
	quest.1210D7BF557B267B.title: "宇宙冲压工厂"
	quest.1221C842C42C7F66.quest_desc: [
		"驱动器是将存储单元接入以用于网络存储的设备。它有10个插槽，每个插槽可容纳一个单元。"
		""
		"如果出于某种原因需要，你可以用漏斗或AE2总线等物品物流系统来推拉其物品栏中的物品。"
		""
		"可以用 Certus Quartz Wrench 来旋转它。"
	]
	quest.1230550E4A5B23AC.quest_desc: [
		"右键可立即挖掘矿石脉。挖掘（左键）模式如下（按G循环）："
		"- 标准：每次破坏一个方块"
		"- 3x tall shot: 垂直方向一次性破坏3个方块"
		"- 3x wide-shot: 水平方向一次性破坏3个方块"
		"- 3x long-shot: 一次性破坏你前方一行中的3个方块"
	]
	quest.1231D9AF9F07AD12.quest_desc: ["接收来自物质传输器的传送玩家。"]
	quest.1235ED41E2CA0203.quest_desc: ["§6青色能量花§r，等级 §e9§r，共 §e16§r 级。能量花是一个集收集器、中继器和冷凝器于一体的自给自足方块，能自行产生 EMC。"]
	quest.1235ED41E2CA0203.quest_subtitle: "项目扩展：能量花朵"
	quest.1235ED41E2CA0203.title: "青色能量花 [MK 9]"
	quest.1245AA386AB7F298.quest_desc: [
		"Crafters 是 RFTools 添加的机器，只要有配方、所需组件和 RF 能量，就能自动合成物品。多步骤合成可以在一台机器内完成，唯一限制是配方槽的数量。"
		""
		"Crafter Tier 1 可以记住 2 个配方。"
	]
	quest.1248104A9F7A3F32.quest_desc: ["Iron Jetpacks 是一款功能丰富且易于使用的现代喷气背包模组。背包等级越高，性能越好。线圈是背包制作的重要组成部分。请参见 JEI。"]
	quest.125B153693091816.quest_subtitle: "多区块结构"
	quest.125B153693091816.title: "动态储罐"
	quest.125C064F10CFBF60.quest_desc: [
		"筛子和锤子：插入升级以快速处理大量材料。需要能量（RF）。"
		""
		"Compactor：筛分后压缩材料。任何自动筛分装置的完美补充！需要能量（RF）。"
	]
	quest.125C064F10CFBF60.quest_subtitle: "Ex Machinis"
	quest.125C064F10CFBF60.title: "Flux 升级组件"
	quest.125E5D92A7D84955.title: "焦炭炉 Coke Oven"
	quest.126CE71405216250.quest_desc: ["通过物品或流体标签过滤的存储总线 §btags§r，使用基本逻辑运算符（例如 C:ingots/* | c:gems/*）。"]
	quest.126CE71405216250.quest_subtitle: "ExtendedAE"
	quest.12712FFFB3B0BCBE.quest_desc: ["来自深渊的凋零恐怖生物。用§6Abyss Eye§r召唤它，然后将其击败。"]
	quest.12712FFFB3B0BCBE.quest_subtitle: "大灾难"
	quest.12712FFFB3B0BCBE.title: "先遣者 (The Harbinger)"
	quest.1273EAF9DC0A7479.quest_desc: ["在Aether中通过挖矿发现。"]
	quest.12A5561178489FCC.quest_desc: [
		"控制器是ME网络的路由中心。没有它，网络就是“临时的”，最多只能有8个使用频道的设备。"
		""
		"一个ME网络中不能有两个控制器。"
		""
		"控制器每个面提供 32 个通道。"
		""
		"控制器每块需要 6 AE/t 才能运行。每块控制器可存储 8000 AE，因此较大的网络可能需要额外的储能。详情请见能量。"
		""
		"多方块控制器可以以相当自由的形式建造。"
		""
		"不过，有几条规则必须遵守："
		"- ME 网络中的所有控制器方块都必须连接，否则方块会变红。"
		"- 控制器的大小必须在 7x7x7 以内，否则会变为红色。"
		"-控制器最多只能在一个轴向上有2个相邻方块；若有方块违反此规则，控制器将禁用并变红。"
	]
	quest.12A78906CCEB9888.quest_desc: ["制作一个§6精英园艺盆§r。更高等级的花盆能让作物长得更快、容量更大，是扩大你花园的好方法。"]
	quest.12A78906CCEB9888.quest_subtitle: "植物学花盆"
	quest.12A78906CCEB9888.title: "精英种植园"
	quest.12AE4AE8955D0364.quest_desc: ["升级版的空气压缩机。"]
	quest.12B32970DF51871F.quest_desc: ["将鼠标悬停在物品上并按住 Shift 键以查看属性。"]
	quest.12C98CEEB49B54D8.quest_desc: ["§6机械臂§r会按照编程顺序从源处拾取物品并放置到目的地。可与制造台和仓库配合使用。"]
	quest.12C98CEEB49B54D8.quest_subtitle: "创建"
	quest.12E388A337027D9F.quest_desc: ["§6Destruction Gadget§r 能让你摧毁一大片区域。"]
	quest.12E6949EDE55D49D.quest_desc: ["§6绝对能量立方§r。储存Forge能量。更高等级可储存和传输的能量多得多。"]
	quest.12E6949EDE55D49D.quest_subtitle: "额外内容：储物系统"
	quest.12E6949EDE55D49D.title: "绝对能量立方体"
	quest.12F5CD9FCFE9C4B0.quest_desc: ["§6手持钻§r是一种由Adamant、Steel、Enderic化合物和Motor制成的动力采矿工具。"]
	quest.12F5CD9FCFE9C4B0.quest_subtitle: "Oritech"
	quest.12F60B0E98F9D419.quest_desc: ["Tier 4，最高等级。可存储 500 个物品栏。"]
	quest.13010CE647E918A3.quest_desc: [
		"带有升级插槽的 Ender IO 机器需要电容器才能运行。"
		""
		"电容器可以根据其基础修饰符，提升机器的速度、射程或能量存储。"
		""
		"等级：7"
	]
	quest.130380166BF98207.title: "瓶装机"
	quest.13068D9B517A3900.quest_desc: ["升级到“灌注地狱书架”和“灌注海洋书架”。它们能将最大永恒等级提升至60，让你的物品获得更高等级的附魔。"]
	quest.13068D9B517A3900.quest_subtitle: "Apothic Enchanting"
	quest.13068D9B517A3900.title: "附魔书架"
	quest.131C107136664967.quest_desc: ["§6绝对注入工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.131C107136664967.quest_subtitle: "额外内容：工厂（Factories）"
	quest.131C107136664967.title: "绝对注入工厂"
	quest.13355E12EBAFEB45.quest_desc: ["§6Sequenced Gearshift§r在红石脉冲下会运行预设的旋转步骤列表。它是移动装置的大脑。"]
	quest.13355E12EBAFEB45.quest_subtitle: "创建"
	quest.136AFDE5AD5E851E.quest_desc: ["抵达Tier §e7§r §6Dank§r，这是整合包里最大的便携式存储，一个完整的存储系统仅占一个物品栏。"]
	quest.136AFDE5AD5E851E.quest_subtitle: "Dank Storage"
	quest.136AFDE5AD5E851E.title: "最大容量"
	quest.13712FCB48D4570F.quest_desc: ["§6无限压缩工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.13712FCB48D4570F.quest_subtitle: "额外内容：工厂"
	quest.13712FCB48D4570F.title: "无限压缩工厂"
	quest.1378F02E2DC36DD4.quest_desc: ["§6紫罗兰物质§r，物质等级 §e7§r。用于制作等级 §e7§r 的收集器、中继器、花朵和连接器。"]
	quest.1378F02E2DC36DD4.quest_subtitle: "项目扩展：物质（Project Expansion: Matter）"
	quest.1378F02E2DC36DD4.title: "紫罗兰物质"
	quest.137F5A524DB75A97.quest_desc: ["药水材料，可在下界堡垒中找到。"]
	quest.1388958122E58F71.quest_desc: ["药水材料，击杀恶魂即可获得。"]
	quest.138FFE0F7A3437A7.quest_desc: ["§6Singularity Tank§r 是一种基础流体储罐，可容纳 32 桶任何流体。用它来储存你的生物农场产生的经验值！你还可以制作 XP Drain Singularity Tank 来将玩家的经验值储存为液态经验。"]
	quest.139F32F65FEB7305.quest_desc: ["§6至高通用线缆§r。传输Forge能量。"]
	quest.139F32F65FEB7305.quest_subtitle: "额外内容：运输系统"
	quest.139F32F65FEB7305.title: "至尊通用电缆"
	quest.13A3B72AB1263377.quest_desc: ["抵达Tier §e7§r §6Dank§r，这是整合包里最大的便携式存储，一个完整的存储系统仅占一个物品栏。"]
	quest.13A3B72AB1263377.quest_subtitle: "Dank Storage"
	quest.13A3B72AB1263377.title: "最大容量"
	quest.13C7A5F0B1449B50.quest_desc: ["Apothic Enchanting 围绕附近书架的三项属性重制了附魔台：ETERNA 提高最大附魔等级，QUANTA 控制附魔强度和随机性，ARCANA 提升稀有和宝藏附魔的概率。制作一个 Hellshelf，它能将附魔台抬高远超原版书架的高度。"]
	quest.13C7A5F0B1449B50.quest_subtitle: "Apothic Enchanting"
	quest.13C7A5F0B1449B50.title: "更好的书架模组 (A Better Bookshelf)"
	quest.13DCA7AF691E7448.quest_desc: ["§6空气专注§r。增加击退和额外坠落伤害，并提升移动法术。"]
	quest.13DCA7AF691E7448.quest_subtitle: "元素魔法学 (Ars Elemental)"
	quest.13DFF0B82F19DECF.quest_desc: ["§6绝对液化工厂§r。仅限Extras模组的工厂类型，可在最高四个等级中出现。"]
	quest.13DFF0B82F19DECF.quest_subtitle: "额外内容：工厂"
	quest.13DFF0B82F19DECF.title: "绝对液化工厂"
	quest.13E86FB30A4078F6.quest_desc: ["Froststeel 可以在 Undergarden 的 Frostfield 生物群系中找到。建议使用 Nature's Compass 来寻找该生物群系。"]
	quest.141B335FEBEEDD31.quest_desc: ["任何基地的必备物资。收集 §e4,096§r 块鹅卵石。"]
	quest.141B335FEBEEDD31.quest_subtitle: "学徒"
	quest.141B335FEBEEDD31.title: "石之冷酷"
	quest.14582B862A91C1E6.quest_desc: ["每个等级都会增加更多的存储栏位和升级栏位。"]
	quest.1478123C2F7C4BC4.quest_desc: ["将能量注入SPS以驱动相移的线圈。"]
	quest.1478123C2F7C4BC4.quest_subtitle: "反应堆"
	quest.1478123C2F7C4BC4.title: "超充能线圈"
	quest.147EDD15E47A8F5F.quest_desc: ["§6宇宙富集工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.147EDD15E47A8F5F.quest_subtitle: "额外内容：工厂"
	quest.147EDD15E47A8F5F.title: "宇宙级富集工厂"
	quest.14ADE52746F0F97D.quest_desc: [
		"当所需的灵气量超过灵气缓存的存储能力，需要频繁补充时，可以使用灵气宝库——一种存储容量是灵气缓存三倍的更高级版本。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.14AF48C25AE56D3F.quest_desc: ["§d§l反物质§r，Mekanism中最有价值的物质，为核合成器提供动力，也是终极燃料。"]
	quest.14AF48C25AE56D3F.quest_subtitle: "反应堆"
	quest.14AF48C25AE56D3F.title: "反物质颗粒"
	quest.14DB2ECA0800EE1C.quest_desc: ["§6精英通用线缆§r。传输Forge能量。"]
	quest.14DB2ECA0800EE1C.quest_subtitle: "额外内容：运输系统"
	quest.14DB2ECA0800EE1C.title: "精英通用电缆"
	quest.14F2C9B2A6467580.quest_desc: ["§6无限复制工厂§r。仅限Extras模组的工厂类型，可在最高四个等级中获得。"]
	quest.14F2C9B2A6467580.quest_subtitle: "额外内容：工厂（Factories）"
	quest.14F2C9B2A6467580.title: "无限复制工厂"
	quest.14F7B0D01578C1F7.quest_desc: ["由源石、黄金和源宝石制成。附魔装置的基础方块。"]
	quest.14F7B0D01578C1F7.quest_subtitle: "Ars Nouveau"
	quest.14F9F9F05968992D.quest_desc: [
		"成功登陆水星以完成此任务。"
		""
		"注意：水星含有铀（具有放射性）。"
	]
	quest.151A5E0BF0ED82FC.quest_desc: ["一种无需任何燃料即可为相连机器和网络提供无限能量的无限能源。"]
	quest.153AA7D3857E26D9.quest_desc: ["§6Infused Alloy§r（铜和红石），首个合金等级。开启高级机器。"]
	quest.153AA7D3857E26D9.quest_subtitle: "合金"
	quest.153AA7D3857E26D9.title: "Infused Alloy"
	quest.153E5E7C7B50FBE8.quest_desc: ["锤子的合成材料。3x3x3"]
	quest.153EE8B5D87D7012.quest_desc: ["§6最终EMC连接器§r，等级§e16§r，共§e16§r级。EMC连接器用于导入导出物品、流体和原始EMC，是EMC自动化的核心。"]
	quest.153EE8B5D87D7012.quest_subtitle: "项目扩展：EMC 链接"
	quest.153EE8B5D87D7012.title: "最终 EMC 链接 [MK 16]"
	quest.15503F926E724AC0.quest_desc: ["§6Infinite Tier Installer§r。可将机器或工厂原地升级到下一个等级。"]
	quest.15503F926E724AC0.quest_subtitle: "额外内容：储物系统"
	quest.15503F926E724AC0.title: "无限层级安装器"
	quest.155428BC748BC8E5.quest_desc: ["§6矿工智慧罐§r可以储存经验，并能随时倒出经验。"]
	quest.155428BC748BC8E5.quest_subtitle: "Ars Additions"
	quest.156FE2D8DEE4B866.quest_desc: [
		"用于灌注物品，也用于合成乌瑟里姆水晶。"
		""
		"注意：此过程可用漏斗实现自动化，输入和输出与原版熔炉类似。"
	]
	quest.1577F24F9901E9BA.quest_desc: ["§6橙色收集器§r，等级 §e13§r/§e16§r。收集器通过光产生 EMC。等级越高，存储越多，产出越快。"]
	quest.1577F24F9901E9BA.quest_subtitle: "项目扩展：收藏家们的探险"
	quest.1577F24F9901E9BA.title: "橙色收集器 [MK 13]"
	quest.157B60FE82028B25.quest_desc: [
		"要使用框架方块，请执行以下操作："
		""
		"- 用几乎任何实心方块右键点击该方块，使其外观相同。"
		"- 用流体容器右键点击方块，使其看起来像容器中的流体。"
		"- 右键点击方块并使用发光石粉，使其产生光亮。"
		"- 用 Framed Hammer 右键点击方块以移除伪装。"
		"- 用空流体容器右键方块以移除流体伪装。"
	]
	quest.159B578700BEC915.quest_desc: ["合成组件。可升级至下一阶段，请参见JEI。"]
	quest.15A12EAEAE23ADD5.quest_desc: ["在改装站安装的 MekaSuit/Meka-Tool 模块。"]
	quest.15A12EAEAE23ADD5.quest_subtitle: "MekaSuit \& Meka-Tool"
	quest.15A12EAEAE23ADD5.title: "太阳能充电模块"
	quest.15A4AA9BB58E2AD4.quest_subtitle: "项目扩展：EMC实用工具包"
	quest.15A4AA9BB58E2AD4.title: "神秘转化石板 Arcane Transmutation Tablet"
	quest.15AF28F4684F51EF.quest_desc: [
		"要获得下界岩，先在水桶上放置一个水桶，放在菌丝体方块上（通过点击泥土方块上的菌丝体孢子生成）。然后将女巫水和岩浆在石桶中混合，即可创造下界岩。"
		""
		"你也可以用岩浆和女巫水制作下界岩生成器——就像用岩浆和水制作鹅卵石生成器一样！"
	]
	quest.15B720B7F41B48E7.quest_desc: [
		"右键可立即根据充能等级挖掘方块 (V, shift+V)。"
		""
		"- 已禁用"
		"- 3x3x2"
		"- 5x5x3"
		""
		"不会挖掘泥土或砾石。它也是一种强大的武器，可以作为工具一次挖掘单个方块。"
	]
	quest.15BDB25650CD2E5E.quest_desc: ["一个已打印的量子电路，随时可以组装成完整的处理器。"]
	quest.15BDB25650CD2E5E.quest_subtitle: "高级自动化系统 (Advanced AE)"
	quest.15BF208FFF737801.quest_desc: ["放置在存储多方块中，可让物品通过管道输入。优化后对TPS影响较低。"]
	quest.15BF208FFF737801.quest_subtitle: "Sophisticated Storage"
	quest.15C1CC7877EF936A.quest_desc: ["一种能阻挡光线但又能让你看穿的彩色玻璃。"]
	quest.15C1CC7877EF936A.quest_subtitle: "BetterBlockz"
	quest.15C7E5283D55D887.quest_desc: ["§6大型太阳能电池板§r利用高级电池和纹石，利用阳光产生RF。适合天空方块。"]
	quest.15C7E5283D55D887.quest_subtitle: "Oritech"
	quest.15D2906720EA7A99.quest_desc: ["§6Infinite Mechanical Pipe§r。用于在机器之间传输流体。"]
	quest.15D2906720EA7A99.quest_subtitle: "额外内容：运输系统"
	quest.15D2906720EA7A99.title: "无限机械管道"
	quest.162ADE72E779657E.quest_desc: ["首次击败末影龙。"]
	quest.162ADE72E779657E.quest_subtitle: "见习工程师"
	quest.162ADE72E779657E.title: "首次飞行"
	quest.163A929F8869BDEF.quest_desc: ["§6终极热传导体§r。可传导热量。"]
	quest.163A929F8869BDEF.quest_subtitle: "额外内容：运输系统"
	quest.163A929F8869BDEF.title: "终极热力学导体"
	quest.1642C50313F491BA.quest_desc: ["充电器（Charger）的增强版。支持并行充电。"]
	quest.1642C50313F491BA.quest_subtitle: "ExtendedAE"
	quest.164B3564CEA502BB.quest_desc: ["§6终极粉碎工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
