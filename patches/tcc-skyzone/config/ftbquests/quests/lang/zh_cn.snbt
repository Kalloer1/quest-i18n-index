	quest.64671DE22383D45A.quest_desc: ["制作稿、武器和弓的卷轴，以完善你全套装备的直接附魔应用。"]
	quest.64671DE22383D45A.quest_subtitle: "Apothic Enchanting"
	quest.64671DE22383D45A.title: "工具 武器 典籍"
	quest.646EB43D9CD54D14.quest_desc: ["由 Adamant 和 Advanced Computing Engine 锁定的 §6精英机器核心§r。可解锁终局机器。"]
	quest.646EB43D9CD54D14.quest_subtitle: "Oritech"
	quest.6478188BEA713E5B.quest_desc: ["将机器、伙伴和炮塔连接在一起。Shift+右键单击源，然后右键单击目标以设置行为。"]
	quest.6478188BEA713E5B.quest_subtitle: "Ars Nouveau"
	quest.6489F47FF9AF5B9A.quest_subtitle: "宗师级大师"
	quest.6489F47FF9AF5B9A.title: "晶体晶格"
	quest.64A4DB89F0523BDF.quest_desc: ["使用简单的烹饪系统和一些熟悉的食材，农夫乐事让你能准备各种各样的丰盛美食：从三明治到沙拉和炖菜，从精美的甜点到令人垂涎的盛宴，厨房里不会有任何食材被遗忘！"]
	quest.64A4DB89F0523BDF.quest_subtitle: "农夫的欢乐时光"
	quest.64B6BA0865EF5AA3.quest_desc: ["Assembler Matrix 的核心组件。每个核心可并行运行一个合成任务。"]
	quest.64B6BA0865EF5AA3.quest_subtitle: "ExtendedAE"
	quest.64C55F0D348097E7.quest_desc: [
		"早期收集灵气的一种简单有效方法是使用自然祭坛。按照指南搭建多方块结构后，祭坛会开始缓慢吸收周围的灵气。但它强度不足，无法造成重大伤害，只会吸收到该区域灵气耗尽为止。收集到的灵气可用于配方，详见JEI。"
		""
		"黄金石砖可用于自然祭坛的多方块结构。或者，也可以用黄金下界砖以类似方式使用。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.64C5B5F6F364C709.quest_desc: ["§6高级粉碎工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.64C5B5F6F364C709.quest_subtitle: "额外内容：工厂"
	quest.64C5B5F6F364C709.title: "高级粉碎工厂"
	quest.64D345ED39C8AF6E.quest_desc: [
		"由燧石网格升级而来。"
		""
		"随着网格层级升高，筛分方块产出的物品会发生变化。详情请见JEI。"
	]
	quest.64F5FAC4FB505A48.quest_desc: ["由Duratium和可疑容器锁定的§6超机器核心§r。Tier 6机器框架。"]
	quest.64F5FAC4FB505A48.quest_subtitle: "Oritech"
	quest.65051312B4D24691.quest_desc: ["在改装站安装的 MekaSuit/Meka-Tool 模块。"]
	quest.65051312B4D24691.quest_subtitle: "MekaSuit \& Meka-Tool"
	quest.65051312B4D24691.title: "财富模块 (Fortune Module)"
	quest.650B9EB6E578026C.quest_desc: [
		"制作协处理器能让CPU运行得更快，从而让系统更频繁地从ME模式提供器中发送原料批次。这使得它们能跟上快速处理的机器。例如，一个被分子组装器包围的模式提供器，其原料推送速度可能超过单个组装器的处理能力，从而将原料批次分配给周围的组装器。"
		""
		"一些复杂的配方有多步并行操作，比如同时制作木板和书籍来合成书架。在工艺状态屏幕（右键CPU或使用终端的锤子图标可见）中，这些步骤都会显示为“已计划”。每个额外的协处理器允许多一步并行操作（从而显示为“制作中”）。但这影响不大，因为你通常拥有的协处理器数量远超配方中可能并行操作的步骤数。"
	]
	quest.6525B48ED37B4C90.quest_desc: [
		"自然指南针是一种实用物品，能让你在世界任何地方搜索生物群系的位置并查看相关信息"
		""
		"探险家指南针是一种能让你在世界任何地方找到结构的物品。"
	]
	quest.6525B48ED37B4C90.title: "特殊指南针"
	quest.652F11E9B250FF05.quest_desc: ["Mekanism Tools 的 Refined Glowstone 等级剑。"]
	quest.652F11E9B250FF05.quest_subtitle: "Mekanism 工具"
	quest.652F11E9B250FF05.title: "精炼的发光石剑"
	quest.653BE210E0487B58.quest_desc: ["用于扩大无线接入点的覆盖范围。"]
	quest.6587F763CB8D22A3.quest_desc: ["唤醒 §e128§r 个龙晶锭。"]
	quest.6587F763CB8D22A3.quest_subtitle: "大师"
	quest.6587F763CB8D22A3.title: "苏醒"
	quest.65A61225ABFA5760.quest_desc: ["一个相机方块。与Scryer's Crystal搭配，通过Oculus查看远程位置。"]
	quest.65A61225ABFA5760.quest_subtitle: "Ars Nouveau"
	quest.65B7E98FC7D9ADBE.quest_desc: ["它能像普通铲子一样瞬间挖掘所有方块。它不会消耗耐久度。"]
	quest.65E047518D8767EA.quest_desc: ["§6绝对粉碎工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.65E047518D8767EA.quest_subtitle: "额外内容：工厂"
