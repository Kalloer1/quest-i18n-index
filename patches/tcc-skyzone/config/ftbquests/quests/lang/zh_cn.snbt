	quest.1EDFBF414B55D56C.quest_subtitle: "创建"
	quest.1EE7658030431E1A.quest_desc: [
		"手册将指导你如何完成这一系列任务。"
		""
		"Powah 是一个科技模组，增加了生成、储存和传输……你猜到了……能量的各种方式！"
		""
		"模组特性："
		"- 能量存储（能量单元，末地网络）"
		"- 末地网络 (末地单元, 末地, 传送门)"
		"- 发电机（熔炉发电机、岩浆发电机、热电发电机、太阳能电池板、反应堆）"
		"- 其他机器（Discharger、Energy Hopper、Player Transmitter）"
	]
	quest.1EE7658030431E1A.quest_subtitle: "Powah"
	quest.1EF23C5BD8CB377A.quest_desc: ["§6粉红中继器§r，等级§e5§r，共§e16§r级。中继器在方块间传输EMC，每秒提供额外收益。等级越高，传输量越大。"]
	quest.1EF23C5BD8CB377A.quest_subtitle: "项目扩展：中继器 (Project Expansion: Relays)"
	quest.1EF23C5BD8CB377A.title: "粉色中继器 [MK 5]"
	quest.1EF8A2D45EAD47BD.quest_desc: ["钻石级桶：比黄金级有更多的行和升级槽。"]
	quest.1EF8A2D45EAD47BD.quest_subtitle: "Sophisticated Storage"
	quest.1F2085BCD0225440.quest_desc: ["§6橙色燃料§r。由物质提炼的浓缩 EMC 燃料，用于上层机器。"]
	quest.1F2085BCD0225440.quest_subtitle: "项目扩展：燃料 (Project Expansion: Fuel)"
	quest.1F2085BCD0225440.title: "橙色燃料"
	quest.1F30A84BA2B2108C.quest_desc: ["§6宇宙注入工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.1F30A84BA2B2108C.quest_subtitle: "额外内容：工厂（Factories）"
	quest.1F30A84BA2B2108C.title: "宇宙注入工厂"
	quest.1F40FE21EC2AEF22.quest_desc: ["一把攻击力为4的剑。"]
	quest.1F40FE21EC2AEF22.quest_subtitle: "Minecraft"
	quest.1F4977A1BBD1FEEE.quest_desc: ["将匹配方块的范围向外延伸。潜行右击空气可切换模式。"]
	quest.1F4977A1BBD1FEEE.quest_subtitle: "BetterBlockz"
	quest.1F4AEFBB6E04F477.quest_desc: ["一个结合了导入/导出总线，过滤和吞吐量都大幅扩展了。"]
	quest.1F4AEFBB6E04F477.quest_subtitle: "高级自动化系统 (Advanced AE)"
	quest.1F6B75D2715BD8A2.quest_desc: ["存储总线经过数量过滤，因此每种物品最多只存储该数量。"]
	quest.1F6B75D2715BD8A2.quest_subtitle: "ExtendedAE"
	quest.1F731F3D25019553.quest_desc: ["能反射法术投射物的方块，适合用来引导炮火绕过拐角。"]
	quest.1F731F3D25019553.quest_subtitle: "元素魔法学 (Ars Elemental)"
	quest.1F894A409738DBF4.quest_desc: ["需要这台机器来制作更高级的物品和机器，例如更复杂的机器框架。"]
	quest.1F901B2CE53B3F58.quest_desc: [
		"Ingot of the Skies 是一种注入了神圣能量的强大金属。向众神献上召唤之魂，以及一块注入了能量的铁锭或一块被污染的黄金锭。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.1FC9556F87253DB5.quest_subtitle: "开始"
	quest.1FC9556F87253DB5.title: "锻造未来"
	quest.1FCBF2B893EEA7D9.quest_desc: ["控制电路用于制作多种Mekanism物品和机器。第6级。"]
	quest.1FCF25002DEC80BA.quest_desc: ["能赋予不同增益的特殊苹果！将鼠标悬停在苹果上并按住 Shift 键查看其效果。"]
	quest.1FD449A4EB2E1A06.quest_desc: ["反应室是一种消耗大量电力来高效处理材料的机器。它用于制作《高级AE》中所需的各类物品，并为其他模组提供高效的配方。"]
	quest.1FD449A4EB2E1A06.quest_subtitle: "高级自动化系统 (Advanced AE)"
	quest.2020A9852B63E43E.quest_desc: ["§6ME Source Jar§r将Ars Source暴露给Applied Energistics网络，以便机器能从ME存储中取用。"]
	quest.2020A9852B63E43E.quest_subtitle: "Ars Energistique"
	quest.202A8B47E8AE3376.quest_desc: ["LaserIO 旨在复刻 EnderIO 的机制。让你能通过与同一方块面交互，操作物品、流体、能量和红石！此外，每个方块面可放置 9 种独立配置，为资源运输物流带来近乎无限的可能。"]
	quest.202A8B47E8AE3376.quest_subtitle: "激光输入输出接口"
	quest.202C97EC62E3FD47.quest_desc: ["在空中潜行+右键切换模式。右键抽屉可切换选项。"]
	quest.2037B0A5C05A1E7F.quest_desc: ["反应堆的红石控制和SCRAM安全联锁线路。"]
	quest.2037B0A5C05A1E7F.quest_subtitle: "反应堆"
	quest.2037B0A5C05A1E7F.title: "裂变逻辑适配器"
	quest.2038C02EDD390977.quest_desc: ["§6无限能量立方§r。可储存Forge能量。更高等级可储存和传输的能量多得多。"]
	quest.2038C02EDD390977.quest_subtitle: "额外内容：储物空间"
	quest.2038C02EDD390977.title: "无限能量立方体"
	quest.20928758A5B09DCC.quest_desc: ["Mekanism Tools 的锇级胸甲。"]
	quest.20928758A5B09DCC.quest_subtitle: "Mekanism 工具"
	quest.20928758A5B09DCC.title: "锇合金胸甲"
	quest.2095B6F8E1E81E75.quest_desc: ["将残存的沙尘暴装进§6沙漠的怒火§r中。"]
	quest.2095B6F8E1E81E75.quest_subtitle: "大灾难"
	quest.2095B6F8E1E81E75.title: "沙漠的愤怒"
	quest.20A4643BD1004B56.quest_desc: ["Mekanism Tools 的 Refined Glowstone 等级锄头。"]
	quest.20A4643BD1004B56.quest_subtitle: "Mekanism 工具"
	quest.20A4643BD1004B56.title: "精炼发光石锄头"
	quest.20AA10B19EA9E15F.quest_desc: [
		"总有一天，你会意识到熔炉效率太低，消耗的资源也太多。Extraneous Firestarter 能加速熔炉，只要放置在熔炉任意一侧即可，同时提供熔炼任何材料所需的热量。注意，虽然会消耗所需的灵气，但自然水平可能会降至负值，导致收益递减。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.20AC9D0A3D0C9811.quest_desc: ["§6Electrum Ingot§r，在熔炉中用金和红石粉合金而成。用于传导能量以驱动高级部件。"]
	quest.20AC9D0A3D0C9811.quest_subtitle: "Oritech"
	quest.20D62C31A62D10AA.quest_desc: ["§d§l聚变反应堆§r将氘和氚聚变为清洁、巨大的能量。建造控制器。"]
	quest.20D62C31A62D10AA.quest_subtitle: "反应堆"
	quest.20D62C31A62D10AA.title: "聚变反应堆"
	quest.20E32463368357B4.quest_desc: ["存储升级4级。悬停物品查看详情。可升级至最大存储升级。"]
	quest.210F3A7CABB85DC8.quest_desc: ["右键可立即收割树叶、羊毛和蘑菇（来自牛蘑菇）。充能等级（V，shift+V）控制根据充能所收割的区域大小。"]
	quest.21460544B92AF9B4.quest_desc: ["将烈焰棒注入能量，使其能提供更强的动力，持续时间更长"]
	quest.216A0851EAD69DCF.quest_desc: [
		"冲向天空！用于制作木制喷气背包。"
		""
		"喷气背包使用Forge能量让玩家飞行。更高等级的喷气背包速度更快，能量容量也更大。"
		""
		"喷气背包需要Forge能量才能运行。它们可以使用任何支持Forge能量的模组的充能块进行充能。"
		""
		"使用按键绑定（默认 V）可以开启和关闭喷气背包引擎。引擎开启后，按空格键即可飞行。"
		""
		"每个喷气背包都有悬停模式，可以实现更精确的移动。启用此模式（默认键位 H）后，你的喷气背包将在原地悬停，下坠程度有所不同。悬停时，喷气背包会消耗能量。"
		""
		"你可以使用节流控制来改变喷气背包的速度。这可以通过节流控制键位（默认是 , 和 .）来实现。"
		""
		"喷气背包可以作为配件装备在身体槽位中。"
		""
		"注意：如果玩家在配饰栏和胸甲栏都佩戴了喷气背包，则以胸甲栏的喷气背包为准。"
	]
	quest.216A0851EAD69DCF.quest_subtitle: "铁质喷气背包"
	quest.21873AADBA35C6A1.quest_desc: ["Mekanism Tools 的锇级镐。"]
	quest.21873AADBA35C6A1.quest_subtitle: "Mekanism 工具"
	quest.21873AADBA35C6A1.title: "锇镐"
	quest.219B7ED265976105.quest_desc: ["在下界挖掘下界石英矿石以获得它。"]
	quest.21C27FA410438560.quest_desc: ["催化剂用于复杂的合成配方。它们在层级越高时，合成难度也越大。"]
	quest.21CCF5818B335123.quest_desc: ["唤醒 128 个 Draconium 锭。"]
	quest.21CCF5818B335123.quest_subtitle: "大师"
	quest.21CCF5818B335123.title: "苏醒"
	quest.21D2F298B32D5B95.quest_desc: [
		"Chisel 为游戏增添了大量装饰性方块。对于喜欢 Minecraft 建筑方面的玩家来说，这个模组非常实用。"
		""
		"获取新方块主要通过一种工具，即凿子。"
		""
		"右键单击可打开凿刻界面。"
	]
	quest.21D2F298B32D5B95.quest_subtitle: "重新雕刻的"
	quest.21D5CF2BC04467D4.quest_desc: [
		"水分离器可将水转化为氧气和氢气。"
		""
		"将水放入第二个槽位即可启动机器。机器会生成氢气和氧气，你可以在储罐下方放置桶来收集它们。"
	]
	quest.21FD5B61FBBCA913.quest_desc: [
		"中盘游戏2倍加速！后续还有时间囊和火炬兽等选项。"
		""
		"Industrial Foregoing: Souls 使用从守卫中提取的灵魂来加速你的机器。为此，你需要用装有蓝色透镜的灵魂激光底座从守卫中提取灵魂。如往常一样，静滞室会是你的好帮手。"
		""
		"储存一些灵魂后，你需要放置一个指向目标方块的精神脉冲器，并用灵魂管道将其连接到灵魂激光底座。向脉冲器施加红石信号即可停止其工作。"
		""
		"每个灵魂持续15秒，使机器速度提升4倍。"
	]
	quest.21FD5B61FBBCA913.quest_subtitle: "工业先驱的灵魂 (Industrial Foregoing Souls)"
	quest.2201A958694C7F35.quest_desc: ["线缆（和连接器）有四种不同颜色（和一个基础版本）。它们用于区分相邻的不同网络（防止线缆相互连接）。控制器会适应其周围找到的第一种彩色线缆的颜色，并记住该颜色（除非该颜色被完全移除）。"]
	quest.22029F72D9691499.quest_desc: ["§6至尊冶炼厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.22029F72D9691499.quest_subtitle: "额外内容：工厂（Factories）"
	quest.22029F72D9691499.title: "至尊冶炼工厂"
	quest.220E723BF056F6D6.quest_desc: ["组件用于制作催化剂。越高级别的组件，制作难度越高。"]
	quest.222C9E858D850D29.quest_desc: ["召唤一个Wixie，它能通过Crafting Lectern自动合成物品和药水。"]
	quest.222C9E858D850D29.quest_subtitle: "Ars Nouveau"
	quest.2230558554C39B34.quest_desc: ["由10,000个锡锭制成"]
	quest.22350912A0D709A2.quest_desc: [
		"生长加速器用于加快上方种植植物的生长速度。它们可以堆叠在一起以提供额外的生长速度。"
		""
		"每个等级范围都更大，但提供的生长量相同。放置每个等级的最大值与只使用最高等级的效率一样。注意，范围是相对于作物下方1格的位置而言的。"
		""
		"将它们放置在作物所种植物方块的正下方。对于农作物，即农田方块下方。在其下堆叠更多生长加速器，可进一步提升植物生长速度。"
	]
	quest.22350912A0D709A2.title: "生长加速器"
	quest.224198469D23B8E6.quest_desc: ["Tier 1. 1.21.1 中 Draconic Evolution 仅有的盔甲部件是胸甲。需要模组才能使其生效，请参见 JEI。"]
	quest.22445BCA99A83E54.quest_desc: ["将 EMC 存入最高等级。获取 §e8§r 个巨型星欧米茄。"]
	quest.22445BCA99A83E54.quest_subtitle: "宗师级大师"
	quest.22445BCA99A83E54.title: "巨额的宝藏堆积如山"
	quest.22576BE5F4FD9868.quest_desc: ["在每个维度中至少使用一次数字矿工。"]
	quest.2283BAFB726F6AF7.quest_desc: ["可让你自动化复杂的合成配方。将物品栏放在顶部，即可自动将物品送入合成器。"]
	quest.228FC9A995457D3C.quest_desc: ["此区块生成器的速度为 32"]
	quest.22A7C83DBB2329ED.quest_desc: ["合成终极 EMC 电池——§6最终之星§r。"]
	quest.22A7C83DBB2329ED.quest_subtitle: "宗师级大师"
	quest.22A7C83DBB2329ED.title: "最终的星辰"
	quest.22B16AE1B2684DCB.quest_desc: [
		"2游戏前期加速游戏进程，请在JEI中查找时空囊！r"
		""
		"这是一个小巧简单的模组，添加了多种火把，可用于提高方块实体的更新频率。换句话说：它们能让机器运行得更快，作物生长得更快，等等..."
		""
		"将火把放在地上，右键单击以打开GUI。"
	]
	quest.22CEF75979B60798.quest_desc: [
		"烹饪锅是一种工作台，既可以用来准备大量食物，也可以用来储存食物。将其放置在任何合适的热源（篝火、明火、岩浆、炉灶等）上方，它就会开始冒泡，表示已准备好烹饪。"
		""
		"煎锅是一种武器和便携式烹饪站，可以手持或使用。煎锅能处理任何篝火食谱，烹饪每个物品的时间约为原时间的20%。"
		""
		"砧板是一个工作台，玩家可以用合适的工具在上面将一种物品分解成多种产物。"
	]
	quest.22D54134581E5904.quest_desc: ["大家都知道，雪比沙子和泥土更好。试着在雪块上种植甘蔗吧。"]
	quest.22E72357B6CD615F.quest_desc: ["认领§6湮灭者§r，一把充满虚空能量的巨剑。"]
	quest.22E72357B6CD615F.quest_subtitle: "大灾难"
	quest.22E72357B6CD615F.title: "湮灭者"
	quest.230FA0B5BC8534A5.quest_desc: ["§6§l最后的星辰§r。扩张计划的巅峰，终极的EMC遗物。你已经征服了每一个收集器、中继器、花朵、链接器和星辰。"]
	quest.230FA0B5BC8534A5.quest_subtitle: "项目扩展：毕业项目（Capstone）"
	quest.230FA0B5BC8534A5.title: "最终的星辰"
	quest.232205BA1A02FFF0.quest_desc: ["§6暗物质§r是ProjectE添加的一种组件。它可用于制作暗物质工具和盔甲，也是创造红物质的组件之一。"]
	quest.23299DC764A5E12D.quest_desc: ["§6§l钻石套索§r，大师级套索。它能捕捉§d几乎所有§r生物，无论中立或敌对，且无生命限制。"]
	quest.23299DC764A5E12D.quest_subtitle: "生物套索模组"
	quest.23299DC764A5E12D.title: "钻石套索"
	quest.232EBBE321BA83A2.quest_desc: ["§6品红中继器§r，等级 §e4§r，共 §e16§r 级。中继器在方块间传输 EMC 并每秒提供额外收益。等级越高，传输量越大。"]
	quest.232EBBE321BA83A2.quest_subtitle: "项目扩展：中继器 (Project Expansion: Relays)"
	quest.232EBBE321BA83A2.title: "品红色中继器 [MK 4]"
	quest.2334E3E0CB803CB3.quest_desc: ["铁是你所建一切的基础。收集 §e1,024§r 个铁锭。"]
	quest.2334E3E0CB803CB3.quest_subtitle: "学徒"
	quest.2334E3E0CB803CB3.title: "钢铁意志"
	quest.23409F24BCEBF0C5.quest_desc: ["§6大地专注§r。增加来自方块和根系的额外伤害，并定身目标。"]
	quest.23409F24BCEBF0C5.quest_subtitle: "元素魔法学 (Ars Elemental)"
	quest.234B200716CEE3F1.quest_desc: ["风力涡轮机的巨型叶片利用风力发电。每台涡轮机需要1x5x1的小区域（水平方向一个方块）。无论昼夜、晴雨，机器都能发电，但涡轮机必须能清晰看到天空（塔顶的转子罩上方）。发电量与海拔高度成正比。"]
	quest.23553993065249FB.quest_desc: ["一种特殊物品，可在开启机遇方块时让你选择幸运值。"]
	quest.2358EBCBAFC509DA.quest_desc: ["以棋盘格模式循环方块变体。潜行右键可循环回原状。潜行右键空气可切换模式。"]
	quest.2358EBCBAFC509DA.quest_subtitle: "BetterBlockz"
	quest.2361F02283F10600.quest_desc: ["§6基础压缩工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.2361F02283F10600.quest_subtitle: "额外内容：工厂"
	quest.2361F02283F10600.title: "基础压缩工厂"
	quest.236694AED2B88E0F.quest_desc: ["§6Magnum Star Ein§r。便携式EMC电池，远超Klein Star Omega。容量从§eEin§r到§eOmega§r随尺寸递增。"]
	quest.236694AED2B88E0F.quest_subtitle: "项目扩展：更伟大的星辰"
	quest.236694AED2B88E0F.title: "马格南之星 一"
	quest.236FEC6BEAF7367A.quest_desc: ["§bQuantum armor§r helmet. Holds ability cards and draws power from your ME network."]
	quest.236FEC6BEAF7367A.quest_subtitle: "高级自动化系统 (Advanced AE)"
	quest.2380C0B40263475C.quest_desc: ["一种类似罗盘的道具，能指向已记录的坐标点。"]
	quest.2380C0B40263475C.quest_subtitle: "Ars Additions"
	quest.23839A415A10A611.quest_desc: [
		"强化版能让你建造比以往更庞大、更出色的反应堆，以产生和储存巨量的能量！"
		""
		"详情请参阅书籍及设置方法。"
	]
	quest.23839A415A10A611.title: "加固反应堆组件"
	quest.238CBF6FA49D76BC.quest_desc: ["§6渐逝收集器§r，等级§e15§r/§e16§r。收集器通过光产生EMC。等级越高，存储越多，产出越快。"]
	quest.238CBF6FA49D76BC.quest_subtitle: "项目扩展：收藏家们的探险"
	quest.238CBF6FA49D76BC.title: "渐隐收藏家 [MK 15]"
	quest.239474463EFE6D18.quest_desc: ["§6生物钢锭§r，由生物发电机链生产的生物质精炼而成。用于有机升级。"]
	quest.239474463EFE6D18.quest_subtitle: "Oritech"
	quest.239C026A9B572140.quest_desc: ["一种精炼的末影基材料，用于制作高级组件和后期机器。"]
	quest.23A17A73967F0F8C.quest_desc: ["§6堆叠升级§r。让机器一次性处理整组物品。"]
	quest.23A17A73967F0F8C.quest_subtitle: "附加内容：杂项"
	quest.23A17A73967F0F8C.title: "物品堆叠升级器"
	quest.23D398A85B7F346C.quest_desc: ["一个拥有大量额外物品栏空间的魔法包。"]
	quest.23D398A85B7F346C.quest_subtitle: "Ars Additions"
	quest.23F0F9483CB3167B.quest_desc: [
		"圣所之灯不仅装饰性强，还有一个实用功能：当接收到红石信号时，它能让周围约48格范围内的所有怪物完全停止生成，与光照等级无关。红石信号的强度决定了作用范围。每次阻止怪物生成，都会消耗少量。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.240D5C8039E07D2F.quest_desc: ["举起§6火焰壁垒§r，一面能灼伤攻击者的盾牌。"]
	quest.240D5C8039E07D2F.quest_subtitle: "大灾难"
	quest.240D5C8039E07D2F.title: "火焰堡垒"
	quest.2415CE61DEC57D0D.quest_desc: ["由黄金和远古木木板制成。在其上放置青金石或紫水晶碎片，并在附近放置源石，即可将物品缓慢转化为源石宝石。"]
	quest.2415CE61DEC57D0D.quest_subtitle: "Ars Nouveau"
	quest.243868CAE3BA4DAD.quest_desc: ["这个世界上没有任何东西是你无法得到的。你已经征服了狼群。"]
	quest.243868CAE3BA4DAD.quest_subtitle: "Tier 4 Trial"
	quest.243868CAE3BA4DAD.title: "大师试炼"
	quest.244014EA64A9147A.quest_desc: ["§6终极注入工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.244014EA64A9147A.quest_subtitle: "额外内容：工厂（Factories）"
	quest.244014EA64A9147A.title: "终极注入工厂"
	quest.247127E8F5EF1884.quest_desc: ["让装配器全天候运行，并打印出 256 个工程处理器。"]
	quest.247127E8F5EF1884.quest_subtitle: "大师"
	quest.247127E8F5EF1884.title: "硅谷"
	quest.2475C81B8ABC19BE.quest_desc: ["在另一个拥有安全基地的维度中，建造一个应用能源系统。"]
	quest.247C592A8298279C.quest_desc: ["Mekanism Tools 的锇级护腿。"]
	quest.247C592A8298279C.quest_subtitle: "Mekanism 工具"
	quest.247C592A8298279C.title: "锇合金护腿"
	quest.249A5F529EA2645C.quest_desc: ["制作一个§6附魔图书馆§r，用于批量存储、分类和搜索附魔书。"]
	quest.249A5F529EA2645C.quest_subtitle: "Apothic Enchanting"
	quest.249A5F529EA2645C.title: "图书馆"
	quest.24B95AEABF640AB5.quest_desc: ["§6石灰燃料§r。由物质提炼的致密 EMC 燃料，用于上层机器。"]
	quest.24B95AEABF640AB5.quest_subtitle: "项目扩展：燃料 (Project Expansion: Fuel)"
	quest.24B95AEABF640AB5.title: "石灰燃料"
	quest.24C202A118AE8FAD.quest_subtitle: "终局阶段"
	quest.24C202A118AE8FAD.title: "不可能材料 (Impossible Material)"
	quest.24C4A019D07A1F8B.quest_desc: ["击败末影龙！注意，末影龙可以用4个末地水晶重新召唤。"]
	quest.24C4A019D07A1F8B.quest_subtitle: "Minecraft"
	quest.24C6C85F207E7409.quest_desc: ["§6净化室§r使用氧气将矿石和碎片提炼成簇。每种矿石可生成3个簇，而每种碎片只能生成1个簇。"]
	quest.24C964CEB5B34A22.quest_desc: ["Productive Metalworks 为 Minecraft 带来了强大而沉浸的熔炼与铸造系统，让玩家能以更真实高效的方式处理矿石和锻造锭。借助此模组，你可以建造名为“熔炉”的多方块结构，它是一个能一次性处理大量矿石的大型工业熔炉。"]
	quest.24C964CEB5B34A22.quest_subtitle: "高效金属工艺"
	quest.24CB19ADFE73AE3C.quest_desc: ["Mekanism Tools 的钢制胸甲。"]
	quest.24CB19ADFE73AE3C.quest_subtitle: "Mekanism 工具"
	quest.24CB19ADFE73AE3C.title: "钢铁胸甲"
	quest.24CC3D7E4041BFB3.quest_desc: ["§6绝对离心工厂§r。一种仅包含额外内容的工厂类型，可在最高四个等级中获得。"]
	quest.24CC3D7E4041BFB3.quest_subtitle: "额外内容：工厂"
	quest.24CC3D7E4041BFB3.title: "绝对离心分离工厂"
	quest.24D6D003A6630D95.quest_desc: ["链接和锁定存储，并切换方块上的计数、等级、锁、升级和填充水平的显示。 §7潜行+滚动可切换模式。§r"]
	quest.24D6D003A6630D95.quest_subtitle: "Sophisticated Storage"
	quest.24DFF0ADBAFCCACB.quest_desc: ["§6Aurantium Modifiers§r。将它们放入 Aurantium Miner 以进行调整：§eEnergy§r 降低功耗，§eItem§r 提高产量，§eSpeed§r 加快运行速度。制作全部三种以获得 §e2§r 级。"]
	quest.24DFF0ADBAFCCACB.quest_subtitle: "虚空矿工"
	quest.24DFF0ADBAFCCACB.title: "Aurantium 修饰器"
	quest.250D50E877136CE2.quest_desc: ["用于储存大量能量的物品。"]
	quest.250D50E877136CE2.title: "Energizer 组件"
	quest.250FDCED97533196.quest_desc: ["制作一个§6Dank§r，这是一种便携式存储设备，可将数十种物品的多个堆叠整合到一个紧凑的背包中。Tier §e1§r规模不大，但可以快速扩展。"]
	quest.250FDCED97533196.quest_subtitle: "Dank Storage"
	quest.250FDCED97533196.title: "口袋储物箱"
	quest.251E78ED5A7DF9BF.quest_desc: ["能量立方体可以储存大量RF。等级越高，储存的RF越多。4级！"]
	quest.252C6C64F6AD0466.quest_desc: ["升级至 §e4§r §6Dank§r 等级。每个等级每种物品的容量都更大，将口袋变成便携式仓库。"]
	quest.252C6C64F6AD0466.quest_subtitle: "Dank Storage"
	quest.252C6C64F6AD0466.title: "内部比外部大 (Bigger on the Inside)"
	quest.2530A93E24EE02E2.quest_desc: ["创意模式飞行，无需额外付费！"]
	quest.253B925F5877067D.quest_desc: ["用筛子和筛网筛选砾石以获取矿石块。"]
	quest.253C30F7A01EEDC4.quest_desc: ["收集装备，直到你每种稀有度都拥有一个附加材料：§f普通§r、§a不常见§r、§b稀有§r、§5史诗§r和§6神话§r。"]
	quest.253C30F7A01EEDC4.quest_subtitle: "Apotheosis"
	quest.253C30F7A01EEDC4.title: "稀有度材料"
	quest.253CDA981C96726E.quest_desc: ["由镍锭和铁条制成。 §6机器框架§r 是所有奥里泰克机器建造的基础方块。"]
	quest.253CDA981C96726E.quest_subtitle: "Oritech"
	quest.253F505CF7E67B78.quest_desc: ["§6基础能量花§r，等级§e1§r，共§e16§r个。能量花是一个集收集器、中继器和冷凝器于一体的自给自足方块，能自行产生EMC。"]
	quest.253F505CF7E67B78.quest_subtitle: "项目扩展：能量花朵"
	quest.253F505CF7E67B78.title: "基础动力花 [MK 1]"
	quest.254382B767F78ECB.quest_desc: ["§6机械锯§r安装在移动装置上时，能将原木切成木板、剥树皮和砍伐树木。"]
	quest.254382B767F78ECB.quest_subtitle: "创建"
	quest.254D20C9C194045E.quest_desc: ["锻造一把无限镐。"]
	quest.254D20C9C194045E.quest_subtitle: "宗师级大师"
	quest.254D20C9C194045E.title: "Cosmic Ascension"
	quest.25647187FC524573.quest_desc: ["§6宇宙绘画工厂§r。仅限Extras模组的工厂类型，可在最高四个等级中出现。"]
	quest.25647187FC524573.quest_subtitle: "额外内容：工厂"
	quest.25647187FC524573.title: "宇宙绘画工厂"
	quest.25771C0683859846.quest_desc: ["全自动建造凋灵农场，批量生产下界之星。"]
	quest.258A19E0013B324F.quest_desc: ["燃烧竞技场的地狱守卫。用§6火焰之眼§r召唤它，然后扑灭它的怒火。"]
	quest.258A19E0013B324F.quest_subtitle: "大灾难"
	quest.258A19E0013B324F.title: "Ignis"
	quest.2591C17114EF1CFC.quest_desc: ["复制终极奇点的一个绝佳方法"]
	quest.25B907E3FDFC236C.quest_desc: [
		"Tinkering Table 用于为本质装备添加/移除增强。增强可应用的工具/盔甲类型列在增强工具的提示框中。"
		""
		"每个增强都有等级。该等级是增强可应用的最低装备等级。你可以将低等级的增强应用到更高等级的装备上。"
		""
		"每件装备都只能有一定数量的增幅槽位。大多数物品只有一个增幅槽位，但觉醒的超贵金属装备有2个！"
	]
	quest.25D8343DDA1A1E7E.quest_desc: [
		"用于将物品转化为纯EMC，再转化为炼金术士所选物品的合成台。以这种方式将物品转化为纯EMC，会将物品的特性烙印在炼金术士的灵魂上。"
		""
		"只要拥有足够的 EMC，炼金术士就能从任何转换台或转换石中提取已知物品。转换台或转换石会向炼金术士显示其绑定的 EMC 数量。"
	]
	quest.25DC4BBF99C776D8.quest_desc: ["用于将固体转化为液体。"]
	quest.25DC4BBF99C776D8.title: "流体化组件"
	quest.260A9EDBBE3C6149.quest_desc: ["用于SPS的原料，在同位素离心机中制造。"]
	quest.260A9EDBBE3C6149.quest_subtitle: "反应堆"
	quest.260A9EDBBE3C6149.title: "钋-210 颗粒"
	quest.2613272C3850463D.quest_desc: ["利用太阳能（太阳）来产生RF。第4级！"]
	quest.2613F08D72715388.quest_desc: ["§6橙色能量花§r，等级 §e13§r，共 §e16§r 级。能量花是一个集收集器、中继器和冷凝器于一体的自给自足方块，能自行产生 EMC。"]
	quest.2613F08D72715388.quest_subtitle: "项目扩展：能量花朵"
	quest.2613F08D72715388.title: "橙色力量花 [MK 13]"
	quest.262DAA98C18CE427.quest_desc: [
		"细胞可以用一个存储组件和一个外壳，或者用外壳配方围绕一个存储组件来制作。"
		""
		"物品存储单元最多可容纳 63 种不同类型的物品，并提供所有标准容量。"
		""
		"流体存储单元最多可容纳5种不同类型的流体，并提供所有标准容量。"
	]
	quest.262DAA98C18CE427.title: "细胞住房"
	quest.263580EFE40C382D.quest_desc: ["Mekanism Tools 的钢制工具台。"]
	quest.263580EFE40C382D.quest_subtitle: "Mekanism 工具"
	quest.263580EFE40C382D.title: "钢制帕克塞尔"
	quest.2642AACC04D56761.quest_desc: ["§6黑暗 EMC 连接器§r，等级 §e2§r 的 §e16§r。EMC 连接器用于导入导出物品、流体和原始 EMC，是 EMC 自动化的支柱。"]
	quest.2642AACC04D56761.quest_subtitle: "项目扩展：EMC 链接"
	quest.2642AACC04D56761.title: "黑暗 EMC 链接 [MK 2]"
	quest.26466151D40A9B4A.quest_desc: [
		"在没有氧气的行星/卫星上，玩家无法进食。要解决这个问题，你需要用真空机将食物装入罐中。"
		""
		"真空罐能让你把食物放进罐子里，这样就能在太空里吃东西了。"
		""
		"要让这台机器工作，你需要在第一格放一个罐子，第二格放食物，第三格放一个空的玻璃瓶。机器会给你一个装有食物的罐子和一个水瓶。"
		""
		"在太空里你会更饿，所以多带点食物！"
	]
	quest.26587BB45FC82006.quest_desc: ["利用太阳能（太阳）来产生RF。第五级！"]
	quest.2658AC97D233385C.quest_desc: ["通过相邻方块将流体泵入或泵出存储流体罐。"]
	quest.2658AC97D233385C.quest_subtitle: "Sophisticated Storage"
	quest.269CB18DF9B7D5E3.quest_desc: ["由烈焰棒制成的发电机"]
	quest.26A9B658A7E6EDF3.quest_desc: ["手持凿子，制作一个 AntiBlock。这些平坦的发光彩色方块能为任何建筑增添干净、现代的点缀。"]
	quest.26A9B658A7E6EDF3.quest_subtitle: "AntiBlocks"
	quest.26A9B658A7E6EDF3.title: "明亮的创意"
	quest.26AB766F3F485DDF.quest_desc: ["制作一个§6植物学家工作台§r。每个刻面工作台都会打开一个包含数百种外观变体的目录，适用于某一类材料。"]
	quest.26AB766F3F485DDF.quest_subtitle: "装饰物"
	quest.26AB766F3F485DDF.title: "Chipped Workbench"
	quest.26CE98352B37F24A.quest_desc: ["§6高级机器核心§r，由末地化合物和金属板锁定。解锁装配器层级。"]
	quest.26CE98352B37F24A.quest_subtitle: "Oritech"
	quest.26E464976AE71F10.quest_desc: ["§6黄色 EMC 连接器§r，等级 §e12§r/§e16§r。EMC 连接器用于导入导出物品、流体和原始 EMC，是 EMC 自动化的核心。"]
	quest.26E464976AE71F10.quest_subtitle: "项目扩展：EMC 链接"
	quest.26E464976AE71F10.title: "黄色 EMC 链接 [MK 12]"
	quest.271164995133F430.quest_desc: ["由10,000个煤炭制成"]
	quest.2736FF4556236824.quest_desc: [
		"利用红物质的力量，将红物质剪刀、红物质斧、红物质剑和红物质锄头的功能整合到一件工具中。"
		""
		"这把剑的功能提供了炼金术士迄今发现的武器中最强大的近战攻击。"
		""
		"充能后的斧头能一键（右键）将整棵树变成去皮原木，再次激活可挖掘整棵树（不适用于超大树木）。它也能快速砍伐树木。"
		""
		"锄头在完全充能后，单次操作（右键）即可翻耕大片区域。"
		""
		"剪刀可以收割大量树叶或许多相邻绵羊身上的羊毛。"
	]
	quest.273D24565726FB6F.quest_desc: ["工业建筑用的警示条纹危险方块。"]
	quest.273D24565726FB6F.quest_subtitle: "BetterBlockz"
	quest.27453FAA4CD8BB2C.quest_desc: ["由 387420489 块鹅卵石组成！"]
	quest.276CE327A9D8583B.quest_desc: ["使用存储的颜料来绘制物品和方块。"]
	quest.276CE327A9D8583B.quest_subtitle: "化学与加工 (Chemistry \& Processing)"
	quest.276CE327A9D8583B.title: "绘画机器"
	quest.2770A66C6B6DC7BD.quest_desc: ["Mekanism Tools 的精致黑曜石级剑。"]
	quest.2770A66C6B6DC7BD.quest_subtitle: "Mekanism 工具"
	quest.2770A66C6B6DC7BD.title: "精炼黑曜石之剑"
	quest.277B6E8EA36EC324.quest_desc: ["§6无限颜料提取工厂§r。仅限Extras模组，可在最高四个等级中使用。"]
	quest.277B6E8EA36EC324.quest_subtitle: "额外内容：工厂"
	quest.277B6E8EA36EC324.title: "无限颜料提取工厂"
	quest.27857C05A4BC7BF0.quest_desc: ["§6列车时刻表§r编码了自动化列车的目的地和条件。将其插入列车长座椅中。"]
	quest.27857C05A4BC7BF0.quest_subtitle: "创建"
	quest.278B9EE18303E641.quest_desc: ["在水源旁放置，可随时间干燥物品。挤压前，先在其中富集 Menril 原木。"]
	quest.278B9EE18303E641.quest_subtitle: "Integrated Dynamics"
	quest.27953F6724212DCC.quest_desc: ["§6Spellcaster Bag§r可以存放法术书和施法卷轴，让你能快速切换使用。"]
	quest.27953F6724212DCC.quest_subtitle: "元素魔法学 (Ars Elemental)"
	quest.279D5C185DE6FBF4.quest_desc: ["将矿石块合成矿石 (2x2)。"]
	quest.27A4FEB8FF983107.quest_subtitle: "Botania"
	quest.27A8BB58004C1DB9.quest_desc: ["放入其物品栏的任何物品都会转化为 EMC。它能将能量从能量收集器传输到能量冷凝器。传输时，每秒额外提供 3 EMC。它也被用来为 Klein Star 系列充入 EMC。"]
	quest.27C6500602C43B1E.quest_desc: ["用于§bConcurrent Circuits§r的刻印机。在刻印机或电路切片器中使用它来盖章。"]
	quest.27C6500602C43B1E.quest_subtitle: "ExtendedAE"
	quest.27C9EAA07B64CDD3.quest_desc: [
		"导入总线会从它接触的物品栏中吸取物品和流体（以及模组添加的任何其他东西），并将其推入网络存储中。"
		""
		"为了减少延迟，如果导入总线最近没有导入任何东西，它会进入一种“睡眠模式”，此时运行缓慢，并在成功导入某物后醒来并加速至全速（每秒4次操作）。"
		""
		"它们是电缆的组成部分。"
	]
	quest.27D559AF2FF8AB16.quest_desc: ["打开一个堆叠的机遇方块（在此之前打开的无效）。"]
	quest.283192E3B8DBB818.quest_desc: ["添加一个§6烤箱§r用于烹饪和烘焙，还有一个§6水槽§r作为无尽水源。在浮空岛上，水槽本身就能救你一命。"]
	quest.283192E3B8DBB818.quest_subtitle: "烹饪方块脑袋们的美食"
	quest.283192E3B8DBB818.title: "烹饪大师"
	quest.284AD374B7EC81DF.quest_desc: ["即使穿着暗物质盔甲，情况危急时你还是会受到明显伤害。你决定像优秀的炼金术士一样，用红物质来解决问题，却发现这套新红物质盔甲能阻挡大量伤害，除了被动能量推搡的感觉外，你几乎感觉不到任何东西。但是……或许你还可以更进一步？"]
	quest.287A51D0AE8AF938.quest_desc: ["§6高级感应器§r。提高感应矩阵的传输速率。"]
	quest.287A51D0AE8AF938.quest_subtitle: "附加内容：储物系统"
	quest.287A51D0AE8AF938.title: "高级感应式能量供应器"
