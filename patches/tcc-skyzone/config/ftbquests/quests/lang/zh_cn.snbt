	quest.1E0F3E9A7AE4D2F5.quest_desc: ["自动化PCB的创建过程。"]
	quest.1E0F3E9A7AE4D2F5.title: "气动装配装置"
	quest.1E12C974C836B43E.quest_desc: ["将仪式石板放置其上，用试剂环绕，并提供源能来运行强大的单次或区域仪式。"]
	quest.1E12C974C836B43E.quest_subtitle: "Ars Nouveau"
