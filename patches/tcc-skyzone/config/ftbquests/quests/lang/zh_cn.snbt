	]
	quest.7A55FA1389EC2BD5.quest_subtitle: "虚空矿工"
	quest.7A55FA1389EC2BD5.title: "无效修饰符"
	quest.7A5DEEFFB61A001D.quest_desc: [
		"Mystical Agricuture 中有六个等级的种子。"
		""
		"Tier 6 的种子需要 insanium essence 来制作，并且需要相应的 crux 才能生长。"
	]
	quest.7A5F0311F2BED396.quest_desc: ["召唤一个旋风小精灵，它会收割并重新种植范围内的作物和树木，从而产出源物品。"]
	quest.7A5F0311F2BED396.quest_subtitle: "Ars Nouveau"
	quest.7A9732E087A91D3A.quest_desc: ["§6Klein Star Sphere§r 最多可容纳 12,800,000 EMC，也用于合成 Klein Star Omega。"]
	quest.7AA1ACC34DCC1F65.quest_desc: ["§6精英流体储罐§r。便携式流体存储设备。"]
	quest.7AA1ACC34DCC1F65.quest_subtitle: "额外内容：储物空间"
	quest.7AA1ACC34DCC1F65.title: "精英流体储罐"
	quest.7AD430E1AE06C587.quest_desc: ["§6§l最后的星辰§r。扩张计划的巅峰，终极的EMC遗物。你已经征服了每一个收集器、中继器、花朵、链接器和星辰。"]
	quest.7AD430E1AE06C587.quest_subtitle: "项目扩展：毕业项目（Capstone）"
	quest.7AD430E1AE06C587.title: "最终的星辰"
	quest.7AD5C805CE2E669A.quest_desc: ["§6无线合成终端§r与普通无线终端类似，所有设置和版块都相同，但增加了一个合成网格，该网格会自动从网络存储中填充。注意在Shift-点击输出时小心！"]
	quest.7AE22C13A4E632C0.quest_desc: ["能赋予不同增益的特殊苹果！将鼠标悬停在苹果上并按住 Shift 键查看其效果。"]
	quest.7AE8504DDB209445.quest_desc: ["唤醒深暗，并让4个坚守者永久地陷入沉睡。"]
	quest.7AE8504DDB209445.quest_subtitle: "大师"
	quest.7AE8504DDB209445.title: "深邃黑暗恐惧症"
	quest.7AF37E016F344764.quest_desc: ["用于与药水扩散器和熔合器配合使用，可储存大量单一药水。"]
	quest.7AF37E016F344764.quest_subtitle: "Ars Nouveau"
	quest.7AFE5F12AE9B1563.quest_desc: ["在改装站安装的 MekaSuit/Meka-Tool 模块。"]
	quest.7AFE5F12AE9B1563.quest_subtitle: "MekaSuit \& Meka-Tool"
	quest.7AFE5F12AE9B1563.title: "辐射剂量计模块"
	quest.7B1F4ED59085AA90.quest_desc: ["使用末地珍珠杀死一个凋零。"]
	quest.7B4552E195554A5C.quest_desc: ["合成一个Seashelf。当Hellshelf能提升Eterna和Quanta时，Seashelf则能提升Arcana，增加获得稀有附魔的几率。"]
	quest.7B4552E195554A5C.quest_subtitle: "Apothic Enchanting"
	quest.7B4552E195554A5C.title: "神秘潮汐"
	quest.7B5F5D53AA5AC917.quest_desc: ["构成蒸发塔墙壁的外壳方块。"]
	quest.7B5F5D53AA5AC917.quest_subtitle: "多区块结构"
	quest.7B5F5D53AA5AC917.title: "蒸发方块 Evaporation Block"
	quest.7B6C29163D00D68D.quest_desc: ["将 Entro 晶体与金锭融合以提高延展性。用于机器框架和其他 ExtendedAE 组件。"]
	quest.7B6C29163D00D68D.quest_subtitle: "ExtendedAE"
	quest.7B7A6EB43847F2E5.quest_subtitle: "Apothic Spawners"
	quest.7B7A6EB43847F2E5.title: "捕获一个刷怪器"
	quest.7B7E759D5A97A298.quest_desc: ["§6至尊增压管§r。用于输送气体和化学品。"]
	quest.7B7E759D5A97A298.quest_subtitle: "额外内容：运输系统"
	quest.7B7E759D5A97A298.title: "至尊增压管"
	quest.7B93DDD4D0F141F5.quest_desc: [
		"这样就能轻松自动保持 Applied Energistics 2 ME 系统中的物品和流体库存！"
		""
		"ME 请求器可容纳 5 个请求。你可以在系统中放置任意数量的请求器，并通过 ME 请求器终端远程访问。该终端允许你远程配置请求和监控状态。"
	]
	quest.7B93DDD4D0F141F5.quest_subtitle: "ME 请求器"
	quest.7B945D9A5A4C4358.quest_subtitle: "ExtendedAE"
	quest.7BB443B4C618BE99.quest_desc: ["由10,000颗钻石制成"]
	quest.7BBDF9B27538EBBF.quest_desc: ["吸取物品和XP球。可将物品导入箱子，XP导入储罐！"]
	quest.7BBDF9B27538EBBF.quest_subtitle: "生物群系刷怪工具包"
	quest.7BCA2D53E2D11B77.quest_desc: ["§6目标指示器§r为 Enderic 激光和无人机标记目标方块。"]
	quest.7BCA2D53E2D11B77.quest_subtitle: "Oritech"
	quest.7BD9F1452895A38A.quest_desc: ["§6压缩收集器§r是能量花的制作核心。制作一个§6基础§r和一个§6最终§r压缩收集器即可解锁花朵。"]
	quest.7BD9F1452895A38A.quest_subtitle: "项目扩展：能量花朵"
	quest.7BD9F1452895A38A.title: "压缩收藏家"
	quest.7BE09731E15491FC.quest_desc: [
		"Industrial Foregoing 是一款全面的工业自动化模组，旨在简化并优化你的游戏内生产系统！它灵感源自经典的 MineFactory Reloaded，为 Minecraft 带来了现代化的科技机械和工具，让玩家能够创建复杂的自动化系统，用于农作物种植、资源加工、动物照料等。"
		""
		"借助各种工业机器和工具，你可以在Minecraft中自动化几乎所有任务。从资源采集、加工到农场和生物管理，Industrial Foregoing都提供高效创新的机器。"
	]
	quest.7BE09731E15491FC.quest_subtitle: "Industrial Foregoing"
	quest.7BF4DBAFDA24E9D8.quest_desc: ["使用 energizing orb 制作。用于制作 spirited tier Powah 物品的配方。"]
	quest.7C14C70D761F3406.quest_desc: ["分子合成器的增强版。X8并行合成。"]
	quest.7C14C70D761F3406.quest_subtitle: "ExtendedAE"
	quest.7C2F4BFAE63F720C.quest_desc: ["存储组件是所有AE2单元的核心，决定了单元容量。每个等级容量提升4倍，消耗3个上一等级的组件。"]
	quest.7C2F4BFAE63F720C.quest_subtitle: "MEGA 细胞"
	quest.7C53AA61503EE5F6.quest_desc: ["提供§b幸运§r加成的量子护甲卡。"]
	quest.7C53AA61503EE5F6.quest_subtitle: "高级自动化系统 (Advanced AE)"
	quest.7C76B69A5387A4B9.quest_desc: [
		"用作配料和能量来源。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.7C8BA3A68BFFCA62.quest_desc: ["§6基础感应器§r。提高感应矩阵的传输速率。"]
	quest.7C8BA3A68BFFCA62.quest_subtitle: "额外内容：储物空间"
	quest.7C8BA3A68BFFCA62.title: "基础感应器提供者"
	quest.7CA54B9E1247379E.quest_desc: [
		"像你这样的炼金术士，没时间总是存取物品。你把高纯度共价尘撒在炼金箱上，再用布包裹起来，成功把箱子缩小到了口袋大小。"
		""
		"袋子的容量和箱子一样大。有趣的是，袋子似乎连接着某种形而上学的网络，所有同色袋子里的物品都相同，无论袋子是你的还是邻居的。袋子激活物品的方式和箱子也一样。"
	]
	quest.7CA597D067DB38AF.quest_desc: ["§6宇宙锯木厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.7CA597D067DB38AF.quest_subtitle: "额外内容：工厂"
	quest.7CA597D067DB38AF.title: "宇宙锯木厂"
	quest.7CA72D24324AAD71.quest_desc: [
		"用于发酵桶中配方的发酵助剂。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.7CB1BDAA829F44E1.quest_desc: ["催化剂用于复杂的合成配方。它们在层级越高时，合成难度也越大。"]
	quest.7CB1BDAA829F44E1.quest_subtitle: "扩展合成系统 (Extended Crafting)"
	quest.7CC865D605F12FD9.quest_subtitle: "虚空矿工"
	quest.7CC865D605F12FD9.title: "框架底座"
	quest.7CD0088B7B07DE69.quest_desc: ["§6沼泽焦点§r，融合水与土，带来减速与中毒效果。"]
	quest.7CD0088B7B07DE69.quest_subtitle: "Ars Elemancy"
	quest.7CD97D59F0CAF35F.quest_desc: ["Mekanism Tools 的 Refined Glowstone 级斧头。"]
	quest.7CD97D59F0CAF35F.quest_subtitle: "Mekanism 工具"
	quest.7CD97D59F0CAF35F.title: "精炼发光石斧"
	quest.7CDD4A7A1A27B5F1.quest_desc: ["用于向 §b量子制造机§r 下达制作任务的终端。"]
	quest.7CDD4A7A1A27B5F1.quest_subtitle: "高级自动化系统 (Advanced AE)"
	quest.7D0E0071DC6B5196.quest_desc: ["§6Spout§r 会将下方瓶子、桶和物品填充来自相连储罐或管道的流体。"]
	quest.7D0E0071DC6B5196.quest_subtitle: "创建"
	quest.7D2A677786DC83F6.quest_desc: ["储备好你的电路。收集 §e2,048§r 个红石。"]
