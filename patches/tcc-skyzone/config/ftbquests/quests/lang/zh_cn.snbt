	quest.5818B49C16BB6B8F.quest_desc: ["这件可穿戴物品在获得能量时，会加速附近作物的生长。"]
	quest.5844BCF0147A9BB5.quest_desc: ["这里是存放食物和烹饪用具的绝佳地点！"]
	quest.585A89F07F3B4F2D.quest_desc: ["§6Klein Star Ein§r 最多可持有 50,000 EMC，也用于制作 Klein Star Zwei。"]
	quest.586B32859161033E.quest_subtitle: "晚期"
	quest.586B32859161033E.title: "凋零殆尽"
	quest.5873CD588D98B39D.quest_desc: ["一把攻击力为6的剑。"]
	quest.58ABC728A3E0CCE3.quest_desc: ["§6蓝色 EMC 连接器§r，等级 §e8§r/§e16§r。EMC 连接器用于导入导出物品、流体和原始 EMC，是 EMC 自动化的核心。"]
	quest.58ABC728A3E0CCE3.quest_subtitle: "项目扩展：EMC 链接"
