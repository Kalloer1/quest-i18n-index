	quest.0D5C87E8466C117B.title: "精炼发光石胸甲"
	quest.0D65B3E94CC15633.quest_desc: ["模型达到基础或以上后，即可使用模拟舱运行模型模拟。模拟将始终生成通用预测，并可能根据模型准确性生成生物预测。模型等级越高，准确性越高，自我认知模型可达99.5%。运行模拟需要能量（取决于模型类型）和催化剂物品，通常是§6预测矩阵§r。"]
	quest.0D880703BADDD518.quest_desc: ["§6安山岩外壳齿轮§r是一种带外壳保护的齿轮，用于紧凑型建筑和连接器。"]
	quest.0D880703BADDD518.quest_subtitle: "创建"
	quest.0D9DF89AF707B1DE.quest_desc: ["与无线连接器类似，但可一次性连接多达8个枢纽或连接器。"]
	quest.0D9DF89AF707B1DE.quest_subtitle: "ExtendedAE"
	quest.0DA6AB6E6D1BF58C.quest_desc: ["可让你自动化复杂的合成配方。将物品栏放在顶部，即可自动将物品送入合成器。"]
	quest.0DA822417944D807.quest_desc: ["杀死一只鸡并烹饪其肉以获得熟鸡肉"]
	quest.0DA822417944D807.quest_subtitle: "Minecraft"
	quest.0DB068928FD0F683.quest_desc: ["赋予存储漏斗的行为。通过过滤器从上方拉取并推送到下方的物品栏。"]
	quest.0DB068928FD0F683.quest_subtitle: "Sophisticated Storage"
	quest.0DB569D8C6FCFB3A.quest_desc: ["制作一个§6Dank蓝图§r，将某个Dank的锁定和过滤设置复制到另一个，保持你设置中的所有Dank行为一致。"]
	quest.0DB569D8C6FCFB3A.quest_subtitle: "Dank Storage"
	quest.0DB569D8C6FCFB3A.title: "蓝图"
	quest.0DB618D6E4D50DA1.quest_desc: ["§6紫罗兰中继器§r，等级 §e7§r，共 §e16§r 级。中继器在方块间传输 EMC 并每秒提供额外收益。等级越高，传输量越大。"]
	quest.0DB618D6E4D50DA1.quest_subtitle: "项目扩展：中继器 (Project Expansion: Relays)"
	quest.0DB618D6E4D50DA1.title: "紫罗兰中继器 [MK 7]"
	quest.0DD30F7106D1B084.quest_desc: ["收集 Glassential 的专用玻璃板：§6Glowstone Lamp§r、§6Lava Lamp§r 和 §6Redstone§r 玻璃，以及用于隐藏房间和观景台的单向 §6Ethereal§r 和 §6Dark Ethereal§r 玻璃。"]
	quest.0DD30F7106D1B084.quest_subtitle: "Glassential"
	quest.0DD30F7106D1B084.title: "玻璃动物标本馆"
	quest.0DE503DBE65F8EED.quest_desc: ["§6Citrinetine 修饰器§r。将它们放入 Citrinetine 矿机以进行调整：§e能量§r可降低功耗，§e物品§r可提高产量，§e速度§r可使其运行更快。制作全部三种以获得 §e3§r 级矿机。"]
	quest.0DE503DBE65F8EED.quest_subtitle: "虚空矿工"
	quest.0DE503DBE65F8EED.title: "Citrinetine 修饰器"
	quest.0E012180FF171EA3.quest_desc: ["压力管的最大等级限制。"]
	quest.0E0DCFDDD225CBE9.quest_desc: ["被暗物质包围听起来是个好主意！它能吸收大量伤害。穿上这套盔甲，你几乎无敌。有时，你似乎能在盔甲的光泽中看到动静。"]
	quest.0E2C104568720EE9.title: "罪恶符文 (Sinful Runes)"
	quest.0E2C52943E79D629.quest_desc: ["组装完整的 Chipped 套件：植物学家工作台、炼金术台、木匠桌、织布机台、石匠台和工匠台。涵盖所有材料类别。"]
	quest.0E2C52943E79D629.quest_subtitle: "装饰物"
	quest.0E2C52943E79D629.title: "完整的工作坊 The Full Workshop"
	quest.0E352A7DB0D0E65D.quest_desc: ["用基岩建造一座房子。"]
	quest.0E41661C427B45D2.quest_desc: ["§6宇宙液化工厂§r。仅限Extras模组，可在最高四个等级中出现。"]
	quest.0E41661C427B45D2.quest_subtitle: "额外内容：工厂"
	quest.0E41661C427B45D2.title: "宇宙液化工厂"
	quest.0E7A8DAC2DBAEB4D.quest_desc: ["将你的操作范围延伸至终端。距离为16格。"]
	quest.0EBFD58D6F06DFE7.quest_desc: ["每个等级都会增加更多的存储栏位和升级栏位。"]
	quest.0EC0A9113D7B1D70.quest_desc: ["§6能量锭§r，由纹石和镍合金制成。用于电池和高级能源组件。"]
	quest.0EC0A9113D7B1D70.quest_subtitle: "Oritech"
	quest.0EC5F7CAC60A570B.quest_desc: ["尽量不要去想这件事，否则会更糟"]
	quest.0EC9E0D3EA56886C.quest_desc: [
		"使用高级连接器可以克服普通连接器的限制，从任何其他一侧访问熔炉的底部。高级连接器还有其他优势。它们允许更高的物品和流体传输速度（每次操作最低10个游戏刻，而非20个），并且可以存储更多的RF（这意味着它们也能传输更多的RF）。"
		""
		"注意：高级能量连接器仍无法从另一侧提取能量。原因是发电机本身会推动能量，而不会通过另一侧推动。但向另一侧输入能量是可行的。"
	]
	quest.0ECF2501E3A2BC77.quest_desc: ["将堆叠大小限制进一步提高（Tier 3）。"]
	quest.0ECF2501E3A2BC77.quest_subtitle: "Sophisticated Storage"
	quest.0ED1D5CE75D09FD6.quest_desc: ["Apotheosis 会在装备上添加随机词缀。制作简易重铸台，然后是完整的重铸台，以重掷装备的词缀。"]
	quest.0ED1D5CE75D09FD6.quest_subtitle: "Apotheosis"
	quest.0ED1D5CE75D09FD6.title: "重铸锻造"
