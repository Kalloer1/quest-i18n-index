	quest.089A3C6D452E3D3A.quest_desc: ["消灭不死生物。击败 §e256§r 只僵尸。"]
	quest.089A3C6D452E3D3A.quest_subtitle: "学徒"
	quest.089A3C6D452E3D3A.title: "消灭兽群"
	quest.089EE930957020B6.quest_desc: [
		"右键可立即将泥土变为路径，或逐层采集泥土和沙子。右键砾石、黏土或雪可立即采集整条矿脉。基于充能等级（V，shift+V）。"
		""
		"- 禁用/1 将方块设为路径"
		"- 3x3"
		"- 5x5"
		"- 7x7"
		""
		"用普通铲子挖掘方块的速度极快。"
	]
	quest.08A3EAEA9EE255DA.quest_desc: ["运行 AE§e2§r 装配器。生产 §e256§r 个工程处理器。"]
	quest.08A3EAEA9EE255DA.quest_subtitle: "大师"
	quest.08A3EAEA9EE255DA.title: "硅谷"
	quest.08AA3BD49CDA1CE9.quest_desc: ["§6无限回收工厂§r。仅限Extras模组的工厂类型，可在最高四个等级中获得。"]
	quest.08AA3BD49CDA1CE9.quest_subtitle: "额外内容：工厂"
	quest.08AA3BD49CDA1CE9.title: "无限回收工厂"
	quest.08B173A9EF4FB5AF.quest_desc: ["Extended Crafting 增加了更多物品合成方式、更多可合成的物品以及更多合成工具。"]
	quest.08BB82725AF1F810.quest_desc: ["将瓷质坩埚置于热源（如火把或篝火）上，并用鹅卵石填满，即可获取熔岩。"]
	quest.08C405602991B1A9.quest_desc: ["催化剂用于复杂的合成配方。它们在层级越高时，合成难度也越大。"]
	quest.08CDC830ACC6C468.quest_desc: ["清除亡者的行列。击败 256 只骷髅。"]
	quest.08CDC830ACC6C468.quest_subtitle: "学徒"
	quest.08CDC830ACC6C468.title: "骨粉破碎机"
	quest.08D40792EF899533.quest_desc: ["在Apparatus中升级Novice之书，提升其法术等级和槽位，解锁Tier 2的符文。"]
	quest.08D40792EF899533.quest_subtitle: "Ars Nouveau"
	quest.09060158AD55E141.quest_desc: ["§6宇宙物流运输机§r。通过网络移动物品。"]
	quest.09060158AD55E141.quest_subtitle: "额外内容：运输系统"
	quest.09060158AD55E141.title: "宇宙物流运输器"
	quest.090ABAC437B6F047.quest_desc: ["Assembler Matrix 的速度核心。提高矩阵的合成速度。"]
	quest.090ABAC437B6F047.quest_subtitle: "ExtendedAE"
	quest.091A0CAD568B9566.quest_desc: [
		"基础版是你的入门级反应堆。最大尺寸为5x5x5方块（外部尺寸），是开启该模组的理想选择！"
		""
		"详情请参阅书籍中的说明和设置方法。"
	]
	quest.091A0CAD568B9566.title: "基础反应堆组件"
	quest.091C42C9120D20FE.quest_desc: ["将电缆上的红石或模拟输入转换为网络变量。输出版本则反之。"]
	quest.091C42C9120D20FE.quest_subtitle: "Integrated Dynamics"
	quest.091C5591FC5A4116.quest_desc: ["§6鹅卵石§r可以由小石子制作而成。"]
	quest.092088B386465246.quest_desc: ["一种精炼的红石基材料，用于制作高级组件和后期机器。"]
	quest.0927C0B78E58F6E1.quest_desc: ["§6至尊精炼工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.0927C0B78E58F6E1.quest_subtitle: "额外内容：工厂"
	quest.0927C0B78E58F6E1.title: "至尊富集工厂"
	quest.0955CDE0AF99C578.quest_desc: ["将青金石和水放入再处理器中会生成蓝晶石。"]
	quest.09616105B2147867.quest_desc: [
		"铁刺是一种可以放置在实体方块任意一侧的基础方块。当生物和玩家接触到铁刺时，会受到伤害。生物会掉落经验和它们正常的掉落物。"
		""
		"Mob Grinding Utils 是一款鼓励玩家创造新方法来刷怪以获取掉落物和经验的模组。该模组包含一个完全模块化的系统，供玩家探索和运用，以充分发挥其刷怪塔的最大效益。"
	]
	quest.09616105B2147867.quest_subtitle: "生物群系刷怪工具包"
	quest.097A73052FFD1BFA.quest_desc: ["连接到排水口，将熔化的金属从熔炉中取出。"]
	quest.097B7BF8B0CBC549.quest_desc: ["阻止最多8格内实体的传送。可安装在实心块的任意一侧。右键激活/停用。"]
	quest.098EE0E9BA10FE16.quest_desc: [
		"用于炼金消化的容器，升华所必需。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.099682D4CF5D3CFF.quest_desc: ["放置在管道上，用外立面将其覆盖！"]
	quest.099A830840CF7C83.quest_desc: ["建造一个真正的刷怪塔：有最低延迟、红石控制、无AI、无视生成条件和附近玩家，且最大附近生物数很高。优化完成后即可领取。"]
	quest.099A830840CF7C83.quest_subtitle: "Apothic Spawners"
	quest.099A830840CF7C83.title: "终极刷怪器"
	quest.09A1179D5A37DBA7.quest_desc: ["§6稳定附魔者§r使用书籍、Duratium、Energite和催化剂来应用自定义附魔。"]
	quest.09A1179D5A37DBA7.quest_subtitle: "Oritech"
	quest.09BD79C7160B1F8F.quest_desc: ["精华树的顶端。请带来 1,024 个 Supremium。"]
	quest.09BD79C7160B1F8F.quest_subtitle: "大师"
	quest.09BD79C7160B1F8F.title: "至高的丰收"
	quest.09D0FEC1B1CFEF03.quest_desc: ["聚变反应堆的红石监控系统。"]
	quest.09D0FEC1B1CFEF03.quest_subtitle: "反应堆"
	quest.09D0FEC1B1CFEF03.title: "融合逻辑适配器"
	quest.09D6B999D5BCBEDC.quest_desc: ["制作一个§6植物盆§r。放入泥土和种子，它就会自己生长，不需要农田或阳光，非常适合浮空岛。种植花朵，你就能得到染料。"]
	quest.09D6B999D5BCBEDC.quest_subtitle: "植物学花盆"
	quest.09D6B999D5BCBEDC.title: "盆栽植物"
	quest.09D93C2F0F0C937E.quest_desc: ["在改装站安装的 MekaSuit/Meka-Tool 模块。"]
	quest.09D93C2F0F0C937E.quest_subtitle: "MekaSuit \& Meka-Tool"
	quest.09D93C2F0F0C937E.title: "色彩调制模块"
