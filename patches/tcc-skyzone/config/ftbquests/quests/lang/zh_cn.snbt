	quest.0A0F0008E0D1CC79.quest_subtitle: "Mekanism 工具"
	quest.0A0F0008E0D1CC79.title: "精炼发光石镐"
	quest.0A22E8909145730B.quest_desc: ["§6至尊色素提取工厂§r。仅限Extras模组，可在最高四个等级中出现。"]
	quest.0A22E8909145730B.quest_subtitle: "额外内容：工厂"
	quest.0A22E8909145730B.title: "至尊色素提取工厂"
	quest.0A4EDCF0898E8EED.quest_subtitle: "附加内容：杂项"
	quest.0A4EDCF0898E8EED.title: "创意升级包"
	quest.0A5DB49129712EA6.quest_desc: ["升级到§6Hopper Botany Pot§r。每次收获时，作物会落入下方的容器中，这是实现自动化农场的第一步。"]
	quest.0A5DB49129712EA6.quest_subtitle: "植物学花盆"
	quest.0A5DB49129712EA6.title: "自动收获机 Self-Harvesting"
	quest.0A730332A7CCA69D.quest_desc: ["§6终极热传导体§r。可传导热量。"]
	quest.0A730332A7CCA69D.quest_subtitle: "额外内容：运输系统"
	quest.0A730332A7CCA69D.title: "终极热力学导体"
	quest.0A765530617B2B94.quest_desc: [
		"混沌方块和反物质方块受限，耐久度为16。"
		""
		"用魔杖右键点击方块 → 它会变成一个 Enlivened Block 实体。"
		""
		"被激活的实体可被其他模组捕获/复制，从而提供该方块的可持续来源。注意：若生成器不复制NBT，此方法无效。"
		""
		"使用生物囚禁工具作用于你的新实体，并在工业前序生物复制器中进行复制。"
	]
	quest.0A8001AD04225131.quest_subtitle: "中间部分"
	quest.0A8001AD04225131.title: "园艺大师"
	quest.0A801EC28698CE1C.quest_desc: ["收集物品时，会拾取符合其过滤条件的物品。"]
	quest.0A801EC28698CE1C.quest_subtitle: "Sophisticated Storage"
	quest.0AA4CC88ED145436.quest_desc: ["§6转换器§r可以改变村民的职业或治愈僵尸村民，这样你就能随机获得想要的交易了。"]
	quest.0AA4CC88ED145436.quest_subtitle: "简易村民模组 (Easy Villagers)"
	quest.0AA4CC88ED145436.title: "转换器"
	quest.0AA83FF3BDF54213.quest_desc: [
		"EnderIO 导管可以放置在其他导管所在的同一方块中。"
		""
		"注意：EnderIO 线缆有时会导致卡顿。如果出现这种情况，请考虑更换其他类型的线缆。"
	]
	quest.0AA83FF3BDF54213.title: "导管 - 第一级"
	quest.0ADF50AC0881C1F7.quest_desc: ["§6高级精炼工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.0ADF50AC0881C1F7.quest_subtitle: "额外内容：工厂"
	quest.0ADF50AC0881C1F7.title: "高级富集工厂"
	quest.0AE2BFC6D900AD0F.quest_desc: ["扩大风扇的影响范围。包括高度、宽度和距离。"]
	quest.0AE2BFC6D900AD0F.title: "风扇升级组件"
	quest.0AE88504DADA2042.quest_desc: ["§6基础EMC连接器§r，等级§e1§r，共§e16§r级。EMC连接器用于导入导出物品、流体和原始EMC，是EMC自动化的核心。"]
	quest.0AE88504DADA2042.quest_subtitle: "项目扩展：EMC 链接"
