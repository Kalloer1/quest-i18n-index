	quest.2E0CBF61CE4B854A.quest_subtitle: "Ars Additions"
	quest.2E28C0C1F81CD03B.quest_desc: [
		"任何魔法植物学家都知道，造成负面气场失衡效应可能相当危险，尤其是使用被动消耗气场的装置时。在这种情况下，气场失衡护符可提供保护：将其放置在使用气场的装置旁，当周围气场水平过低时，该装置将停止运行。这不会带来任何代价。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.2E2E82D5376E9D91.quest_desc: ["这些工作台用于更复杂的合成配方。也有自动化版本可用。更多详情请见JEI。"]
	quest.2E32F67973CA5FF1.quest_desc: ["回收废蒸汽中的水分，实现闭环循环。"]
	quest.2E32F67973CA5FF1.quest_subtitle: "多区块结构"
	quest.2E32F67973CA5FF1.title: "饱和冷凝器"
	quest.2E40BA2630769D7E.quest_desc: ["§6Mechanical Harvester§r 附着在移动装置上，经过时收割成熟的作物。火车和龙门式农场的核心。"]
	quest.2E40BA2630769D7E.quest_subtitle: "创建"
	quest.2E6127F7A54D6A58.quest_desc: [
		"将暮色钻石投入被花朵环绕的2x2水池中，即可制作暮色森林传送门。跳入其中，进入森林。"
		""
		"暮色森林是一款以冒险为主题的维度探索模组，它将带你踏上旅程，与奇怪的生物相遇，探索地牢等等。"
	]
	quest.2E6127F7A54D6A58.quest_subtitle: "暮色森林"
	quest.2E6127F7A54D6A58.title: "进入暮色森林 (Into the Twilight Forest)"
	quest.2E7DBB11688E2421.quest_desc: ["模式需要在ME模式编码终端中用空白模式制作，然后插入ME模式提供器或分子组装器中。"]
	quest.2E8E0996E7C5BF01.quest_desc: ["锻造§6烈焰手套§r，活火的拳套。"]
	quest.2E8E0996E7C5BF01.quest_subtitle: "大灾难"
	quest.2E8E0996E7C5BF01.title: "烈焰之握"
	quest.2EB673C98F2891DA.quest_desc: ["使用简单的烹饪系统和一些熟悉的食材，农夫乐事让你能准备各种各样的丰盛美食：从三明治到沙拉和炖菜，从精美的甜点到令人垂涎的盛宴，厨房里不会有任何食材被遗忘！"]
	quest.2EC749B4571A7EB9.quest_desc: ["基础磁铁能在玩家5格范围内拾取物品和经验值！"]
	quest.2ECAE9F5947F5270.quest_desc: ["锻造全套 §6Ignitium§r 套装：头盔、胸甲、护腿和靴子。"]
	quest.2ECAE9F5947F5270.quest_subtitle: "大灾难"
	quest.2ECAE9F5947F5270.title: "Ignitium 盔甲"
	quest.2ECDC7B514932E1C.quest_desc: ["一种注入了末地能量的顶级合成组件。"]
	quest.2ED907496E1163C2.quest_desc: ["一个已打印的并发电路，准备好被组装成并发处理器。"]
	quest.2ED907496E1163C2.quest_subtitle: "ExtendedAE"
	quest.2EF50D487B76083F.quest_desc: ["在改装站安装的 MekaSuit/Meka-Tool 模块。"]
	quest.2EF50D487B76083F.quest_subtitle: "MekaSuit \& Meka-Tool"
	quest.2EF50D487B76083F.title: "喷气背包模块"
	quest.2F047A6D539E8AE6.quest_desc: ["§6Cosmic Pressurised Reacting Factory§r。仅限Extras模组的工厂类型，可在最高四个等级中使用。"]
	quest.2F047A6D539E8AE6.quest_subtitle: "额外内容：工厂（Factories）"
	quest.2F047A6D539E8AE6.title: "宇宙高压反应工厂"
	quest.2F069C29D9F4833F.quest_desc: ["§6绝对灌注工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.2F069C29D9F4833F.quest_subtitle: "额外内容：工厂"
	quest.2F069C29D9F4833F.title: "绝对灌注工厂"
	quest.2F083964ED554A23.quest_desc: ["§6放射性废料桶§r。可随时间安全降解放射性废料。"]
	quest.2F083964ED554A23.quest_subtitle: "额外内容：储物空间"
	quest.2F083964ED554A23.title: "放射性废料桶"
	quest.2F2EBE39E0531CF0.quest_desc: ["不可能的宝库：512个反物质颗粒，而且还在增加。"]
	quest.2F2EBE39E0531CF0.quest_subtitle: "宗师级大师"
	quest.2F2EBE39E0531CF0.title: "反物质宝藏"
	quest.2F358745D17495B6.quest_desc: ["缩放你的网格，直到一个任务界面消耗掉整整十亿FE。"]
	quest.2F358745D17495B6.quest_subtitle: "大师"
	quest.2F358745D17495B6.title: "Surge"
	quest.2F367F6748A0281C.quest_desc: ["一种由原版游戏后期材料制成的稀有高阶合金。"]
	quest.2F38ABE89C69602C.quest_desc: ["将两个村民和一些食物放入§6Breeder§r中，它就会自动生产村民宝宝。"]
	quest.2F38ABE89C69602C.quest_subtitle: "简易村民模组 (Easy Villagers)"
	quest.2F38ABE89C69602C.title: "繁殖器"
	quest.2F557E8BDF14E2EF.quest_desc: ["§6斯特林发电机§r通过燃烧熔炉燃料来发电。其发电速率和燃料效率取决于所安装的电容器。"]
	quest.2F557E8BDF14E2EF.quest_subtitle: "Ender IO"
	quest.2F5803138627E169.quest_desc: ["可让你自动化复杂的合成配方。将物品栏置于顶部，即可自动将物品拉入合成台。"]
	quest.2F5DF89B8B8B3967.quest_desc: ["§6Klein Star Zwei§r 最多可持有 200,000 EMC，也用于制作 Klein Star Drei。"]
	quest.2F60BEB4CAB4424A.quest_desc: ["此终端可用于查看、放入和取出简易存储网络中的物品。"]
	quest.2F631C8EE15BA50F.quest_desc: ["自动打开怪物农场里不断掉落的战利品箱！(提示：用漏斗或管道实现自动化！)"]
	quest.2F631C8EE15BA50F.quest_subtitle: "FTB 任务书"
	quest.2F7D243BFA0DE65C.quest_desc: [
		"木桶还可以用来制作黏土、史莱姆、下界岩、末地石、黑曜石等。详情请见JEI。"
		""
		"将尘土放入装满水的桶中即可制作陶土块。"
	]
	quest.2F8633A3B969A2E5.quest_desc: ["用于融合合成。需要一个核心，以及每个物品一个注射器。注射器必须是正确的等级才能合成，请参见JEI。融合合成需要能量。注射器可以升级到下一级。"]
	quest.2F986AF8D2E3F3B2.quest_desc: ["将生物捕捉在玻璃罐中。源链接和一些机器可以使用罐装生物，而且展示效果干净利落。"]
	quest.2F986AF8D2E3F3B2.quest_subtitle: "Ars Nouveau"
	quest.2FA5D1EC11891F62.quest_desc: ["通过踩踏（或用活塞）来粉碎物品。将富集的 Menril 原木转化为 §b结晶化 Menril 块§r 和 Menril 树脂。"]
	quest.2FA5D1EC11891F62.quest_subtitle: "Integrated Dynamics"
	quest.2FB3ED7DE434209F.quest_desc: ["§6高级法术棱镜§r。可重定向经过的法术投射物，并接受棱镜透镜以在空中修改它们。"]
	quest.2FB3ED7DE434209F.quest_subtitle: "元素魔法学 (Ars Elemental)"
	quest.2FE09FD84766025B.quest_desc: ["将附近的掉落物和经验值直接吸入储存箱。"]
	quest.2FE09FD84766025B.quest_subtitle: "Sophisticated Storage"
	quest.2FEBA698BF4F7AF2.quest_desc: [
		"带有升级插槽的 Ender IO 机器需要电容器才能运行。"
		""
		"电容器可以根据其基础修饰符，提升机器的速度、射程或能量存储。"
		""
		"等级：1"
	]
	quest.2FF30E29BD7550D5.quest_desc: ["让你的火箭看起来像一只小火箭！"]
	quest.2FF63E4A94A01A0A.quest_desc: ["Mekanism Tools 的锇级护盾。"]
	quest.2FF63E4A94A01A0A.quest_subtitle: "Mekanism 工具"
	quest.2FF63E4A94A01A0A.title: "锇盾"
	quest.30016E1C526393CB.quest_desc: ["§6Mobius Fuel§r 是 ProjectE 添加的一种燃料。它的燃烧时间是普通煤炭的十六倍，可以冶炼 128 个物品。"]
	quest.301709689D6B3682.quest_desc: ["§6Cosmic Bin§r。用于批量存储单个物品的方块。"]
	quest.301709689D6B3682.quest_subtitle: "额外内容：储物空间"
	quest.301709689D6B3682.title: "宇宙垃圾桶"
	quest.3032479E4DA215BB.quest_desc: ["在网络中持有变量卡，以便各部分可以读取它们。"]
	quest.3032479E4DA215BB.quest_subtitle: "Integrated Dynamics"
	quest.3035C8B965FC9044.quest_desc: ["残党的远程武器，一把用于长距离突刺的§6长矛§r。"]
	quest.3035C8B965FC9044.quest_subtitle: "大灾难"
	quest.3035C8B965FC9044.title: "远古长矛"
	quest.303971F1FDD71937.quest_desc: ["运行冶金强化炉，直到积累 1,024 个富化铁锭。"]
	quest.303971F1FDD71937.quest_subtitle: "见习工程师"
	quest.303971F1FDD71937.title: "冶金术师"
	quest.30587EF91C0A1A5E.quest_desc: ["§6绝对车床工厂§r。一种仅限附加内容的工厂类型，可在最高四个等级中获得。"]
	quest.30587EF91C0A1A5E.quest_subtitle: "额外内容：工厂"
	quest.30587EF91C0A1A5E.title: "绝对车床制造厂"
	quest.306298B3CB9AD756.quest_desc: ["动态储罐的输入和输出端口。"]
	quest.306298B3CB9AD756.quest_subtitle: "多区块结构"
	quest.306298B3CB9AD756.title: "动态阀门"
	quest.306E8065443E1FC6.quest_desc: ["用于泥土上以创造恐怖泥土。会生成敌对生物。(5x5 空间)"]
	quest.3085D50BA2B4AD00.quest_desc: ["召唤一个塞壬伙伴，魅惑附近的敌对生物为你而战。"]
	quest.3085D50BA2B4AD00.quest_subtitle: "元素魔法学 (Ars Elemental)"
	quest.30BC126A10851913.quest_desc: ["存储已满时会清空所有过滤后的物品，因此永远不会堵塞。"]
	quest.30BC126A10851913.quest_subtitle: "Sophisticated Storage"
	quest.30C42D2AB95701B0.quest_desc: ["领取§6Tidal Claws§r，将利维坦的利爪作为你的双持武器。"]
	quest.30C42D2AB95701B0.quest_subtitle: "大灾难模组"
	quest.30C42D2AB95701B0.title: "潮汐之爪"
	quest.30C6D8DBB3E2FEC4.quest_desc: ["将固体、液体和气体混合，可制作§6substrate§r、HDPE等物品。"]
	quest.30C6D8DBB3E2FEC4.quest_subtitle: "化学与加工 (Chemistry \& Processing)"
	quest.30C6D8DBB3E2FEC4.title: "增压反应室 (Pressurized Reaction Chamber)"
