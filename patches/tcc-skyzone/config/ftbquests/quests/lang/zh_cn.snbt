	quest.661395C3796887EC.quest_desc: ["手持凿子，制作一个 AntiBlock。这些平坦的发光彩色方块能带来干净现代的质感，是任何建筑的完美点缀。"]
	quest.661395C3796887EC.quest_subtitle: "装饰物"
	quest.661395C3796887EC.title: "明亮的创意"
