	quest.0AE945A68871D86B.quest_desc: ["§6宇宙回收工厂§r。仅限Extras模组的一种工厂类型，可在最高四个等级中出现。"]
	quest.0AE945A68871D86B.quest_subtitle: "额外内容：工厂"
	quest.0AE945A68871D86B.title: "宇宙回收工厂"
	quest.0AEC18E35C5F3490.quest_subtitle: "中间。将能量输送到任务屏幕中"
	quest.0AEC18E35C5F3490.title: "力量提升"
	quest.0AF19DB95C930EF6.quest_desc: ["§6Infinite Lathing Factory§r。仅限Extras模组的工厂类型，可在最高四个等级中获得。"]
	quest.0AF19DB95C930EF6.quest_subtitle: "额外内容：工厂"
	quest.0AF19DB95C930EF6.title: "无限车床工厂"
	quest.0AFC1C633F5E6D38.quest_desc: ["Tier 2. 可存储 200 个物品栏。"]
	quest.0B3225D4F3C37851.quest_desc: ["The §6Ultimate Machine Core§r, gated by Prometheum and a Superconductor. The peak of Oritech progression."]
	quest.0B3225D4F3C37851.quest_subtitle: "Oritech"
	quest.0B3E66925374481B.quest_desc: ["每秒生产和维持 100 万 EMC。"]
	quest.0B40F4440F001BC3.quest_desc: ["§6BlockZ 大师§r。将 BlockZ 编辑功能整合于一根魔杖中。"]
	quest.0B40F4440F001BC3.quest_subtitle: "BetterBlockz"
	quest.0B49965D7D3DF4F9.quest_desc: [
		"用石砖建造一个传送门（形状与标准下界传送门相同），并用催化剂激活。"
		""
		"Undergarden 是一个位于主世界基岩深处的黑暗地下世界。这里的植物适应了环境，无需光照即可随处生长。奇特的生物将这片黑暗土地视为家园，但它们正遭受着源自混沌神秘领域的入侵性怪物——Rotspawn 的侵扰。"
	]
	quest.0B49965D7D3DF4F9.quest_subtitle: "地下花园（The Undergarden）"
	quest.0B49965D7D3DF4F9.title: "进入地下花园 (Into the Undergarden)"
	quest.0B5185587E1EA0E7.quest_desc: ["§6石灰收集器§r，§e16§r级中的§e11§r级。收集器通过光产生EMC。等级越高，存储越多，产出越快。"]
	quest.0B5185587E1EA0E7.quest_subtitle: "项目扩展：收藏家们的探险"
	quest.0B5185587E1EA0E7.title: "石灰收集器 [MK 11]"
	quest.0B5848C907E7753B.quest_desc: ["连接两个或多个末地箱来运输和存取物品！用染料上色以配对箱子。"]
	quest.0B5848C907E7753B.quest_subtitle: "末地存储系统"
	quest.0B63BC7A78506D83.quest_desc: ["保持洞穴的干净。击败 §e256§r 只蜘蛛。"]
	quest.0B63BC7A78506D83.quest_subtitle: "学徒"
	quest.0B63BC7A78506D83.title: "蛛网射手"
	quest.0BAC0F0A203B45DF.quest_desc: ["§6基础中继器§r，等级§e1§r，共§e16§r个。中继器在方块间传输EMC，每秒提供额外收益。更高等级传输量更大。"]
	quest.0BAC0F0A203B45DF.quest_subtitle: "项目扩展：中继器 (Project Expansion: Relays)"
	quest.0BAC0F0A203B45DF.title: "基础中继器 [MK 1]"
	quest.0BB68FE5EE0D7D63.quest_desc: [
		"无需直接接触即可将抽屉连接到它（可通过升级扩展范围）。"
		""
		"要将抽屉与抽屉控制器连接，需要使用链接工具。"
	]
	quest.0BC9DE119AF74A7A.quest_desc: ["§6Fluix ME Glass Cable§r 是最简单的线缆，可传输电力和最多8个频道。它有17种不同颜色，默认是Fluix色，并且可以用16种染料中的任意一种染成任何颜色。"]
	quest.0BCC8E0A991A6D2F.quest_desc: ["制作一个§6Dank蓝图§r，将某个Dank的锁定和过滤设置复制到另一个，保持你设置中的所有Dank行为一致。"]
	quest.0BCC8E0A991A6D2F.quest_subtitle: "Dank Storage"
	quest.0BCC8E0A991A6D2F.title: "蓝图"
	quest.0BD2E8188BB912CB.quest_desc: [
		"Crafters 是 RFTools 添加的机器，只要有配方、所需组件和 RF 能量，就能自动合成物品。多步骤合成可以在一台机器内完成，仅受配方槽位数量的限制。"
		""
		"Crafter Tier 3 可以记住 8 个配方。"
	]
	quest.0BEC6FB4D100F23E.quest_desc: [
		"比前两个等级都快！速度更快了！"
		""
		"将火把放在地上，右键点击以打开GUI。"
	]
	quest.0C3DB4A72DC396C5.quest_desc: ["腐肉是一种玩家可食用的食物，但有高风险造成饥饿。由僵尸掉落。"]
	quest.0C3DB4A72DC396C5.quest_subtitle: "Minecraft"
	quest.0C6F86ABF8F070B8.quest_desc: ["制作§6末地图书馆§r和§6末地牵引绳§r，即可远程访问你的藏书。"]
	quest.0C6F86ABF8F070B8.quest_subtitle: "Apothic Enchanting"
	quest.0C6F86ABF8F070B8.title: "末地图书馆"
	quest.0C71AB75B63CC9A4.quest_desc: ["它不会消耗耐久度。用§6Hoe of the Green Earth§r右键泥土块，会在该方块为中心的9x9区域放置农田。"]
	quest.0C80CE674E69189A.title: "Masher 升级组件"
	quest.0C996810BEF9338E.quest_desc: ["§6绿色燃料§r。由物质提炼的浓缩 EMC 燃料，用于上层机器。"]
	quest.0C996810BEF9338E.quest_subtitle: "项目扩展：燃料 (Project Expansion: Fuel)"
	quest.0C996810BEF9338E.title: "绿色燃料"
	quest.0CA6B94A84718B7D.quest_desc: [
		"E 计划的起点，就在你的脚下。"
		""
		"通过用贤者之石（按 C）合成，你发现合成产生的高温能让你用催化剂（即木炭或煤炭）来冶炼 7 种粉尘或矿石。"
		""
		"贤者之石还能将泥土变为沙子，沙子变为草地。石头也能变成鹅卵石。为其充能（按 V 充电，shift-V 放电）会影响更广阔的区域。"
		""
		"可用于制作各种炼金物品和材料，贤者之石在过程中不会被消耗。"
	]
	quest.0CAF7DA28CEC7A44.quest_desc: ["§6安山岩合金§r，一种将安山岩与铁在机械搅拌机或手工混合制成的基石材料。几乎所有早期机器都需要它。"]
	quest.0CAF7DA28CEC7A44.quest_subtitle: "创建"
	quest.0CAFAE72AAEDE844.quest_desc: ["通过再加工蓝铜矿和青金石获得。"]
	quest.0CC030EC49D17ADA.quest_desc: ["§6Infinite Universal Cable§r。可传输Forge能量。"]
	quest.0CC030EC49D17ADA.quest_subtitle: "额外内容：运输系统"
	quest.0CC030EC49D17ADA.title: "无限通用电缆"
	quest.0CCA15996B187E63.quest_desc: ["一座利用阳光或热量将水和盐水煮沸，提炼出§6锂§r和盐的高塔。请先建造控制器。"]
	quest.0CCA15996B187E63.quest_subtitle: "多区块结构"
	quest.0CCA15996B187E63.title: "热蒸发植物工厂"
	quest.0CCCCE7BFA9940C6.quest_desc: ["制作一个§6Dank§r，这是一种便携式存储设备，可将数十种物品的多个堆叠整合到一个紧凑的背包中。Tier §e1§r规模不大，但可以快速扩展。"]
	quest.0CCCCE7BFA9940C6.quest_subtitle: "Dank Storage"
	quest.0CCCCE7BFA9940C6.title: "口袋储物箱"
	quest.0CDDBD022F6EA1E1.quest_desc: ["制作一个深书架和一个回响深书架。回响版会向桌子注入+15的奥术能量，用于最稀有的附魔。"]
	quest.0CDDBD022F6EA1E1.quest_subtitle: "Apothic Enchanting"
	quest.0CDDBD022F6EA1E1.title: "深海回响 (Echoes of the Deep)"
	quest.0D0070B6A135FD70.quest_desc: ["§6绿色收集器§r，等级 §e10§r/§e16§r。收集器通过光产生 EMC。等级越高，存储越多，产出越快。"]
	quest.0D0070B6A135FD70.quest_subtitle: "项目扩展：收藏家们的探险"
	quest.0D0070B6A135FD70.title: "绿色收藏家 [MK 10]"
	quest.0D1BC89C6E1168E2.quest_desc: [
		"盐代表物体的“身体”或“物理物质”。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.0D1BC89C6E1168E2.title: "炼金术盐类"
	quest.0D2292A3FEECE0BB.quest_desc: [
		"并非易事，但若你决定尝试，回报将十分丰厚。在征服暮色森林的过程中收集奖杯。进度页面可以帮助你推进。"
		""
		"注意：此任务为可选任务！r"
	]
