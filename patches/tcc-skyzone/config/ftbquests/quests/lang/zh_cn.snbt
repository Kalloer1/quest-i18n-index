	quest.4388843803E1A5B0.quest_desc: ["QIO 存储驱动器。更高级别的驱动器可容纳更多种类和数量的物品。"]
	quest.4388843803E1A5B0.quest_subtitle: "QIO 网络"
	quest.4388843803E1A5B0.title: "坍缩驱动装置"
