	quest.06E11A9D54E76D4B.title: "至尊回收工厂"
	quest.0700342C84D56669.quest_desc: ["村民不会被迫进入翡翠套索。先给他们一个§6契约§r。一旦他们§a接受§r，翡翠套索就可以捕捉他们了。"]
	quest.0700342C84D56669.quest_subtitle: "生物套索模组"
