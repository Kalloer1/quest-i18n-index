	quest.327E60DEDF8D9876.quest_desc: ["充能熔炉是一种基础电炉，使用能量而非燃料来熔炼物品。"]
	quest.3287EB20CFF4AF31.quest_desc: ["建造、维护并使用最大尺寸的Mekanism涡轮机来发电。"]
	quest.329254403D3AE4CC.quest_desc: [
		"在所有其他任务章节完成之前，简易成就不可用。"
		""
		"这些任务旨在无需 EMC 和创造模式物品即可完成。"
		""
	]
	quest.329254403D3AE4CC.title: "简易成就系统"
	quest.3296D84C610290C7.quest_desc: ["用末地石、紫颂岩和潜贝壳合成§6虚空之眼§r，以召唤§c末地守卫§r。"]
	quest.3296D84C610290C7.quest_subtitle: "大灾难"
	quest.3296D84C610290C7.title: "虚空之眼"
	quest.329CBD04496A12BF.quest_desc: ["§6Cosmic Tier Installer§r。将机器或工厂就地升级到下一个等级。"]
	quest.329CBD04496A12BF.quest_subtitle: "额外内容：储物空间"
	quest.329CBD04496A12BF.title: "Cosmic Tier Installer"
	quest.329F702B5D9928FB.quest_desc: ["创意级气源，可为相连的气动机器提供无限压缩空气，无需电力或燃料。"]
	quest.32C26D1802FC9FCB.quest_desc: ["§6至尊放射性废料桶§r。可随时间安全降解放射性废料。"]
	quest.32C26D1802FC9FCB.quest_subtitle: "额外内容：储物空间"
	quest.32C26D1802FC9FCB.title: "至尊放射性废料桶"
	quest.32EB8F60F261B4DE.quest_desc: ["§6Cosmic Replicating Factory§r。仅限Extras模组的工厂类型，可在最高四个等级中使用。"]
	quest.32EB8F60F261B4DE.quest_subtitle: "额外内容：工厂"
	quest.32EB8F60F261B4DE.title: "宇宙复制工厂"
	quest.32EDE10C0FB7FEFC.quest_desc: ["§6高级感应单元§r。提升感应矩阵的能源容量。"]
	quest.32EDE10C0FB7FEFC.quest_subtitle: "额外内容：储物空间"
	quest.32EDE10C0FB7FEFC.title: "高级感应式熔炉"
	quest.32FA63E4958B5E3C.quest_desc: ["使用 energizing orb 制作。用于制作 blazing tier Powah 物品的配方中。"]
	quest.330F18BE9451E5CA.quest_desc: ["收集可用的符文： §6Unnaming§r、§6Withdrawal§r 和 §6Enhancement§r。"]
	quest.330F18BE9451E5CA.quest_subtitle: "Apotheosis"
	quest.330F18BE9451E5CA.title: "力量的印记 (Sigils of Power)"
	quest.3310154217A9247E.quest_desc: ["§6Focus of Cinder§r，来自 Ars Elemancy 的复合元素。结合两种基础 Focus 以解锁高级学派。"]
	quest.3310154217A9247E.quest_subtitle: "Ars Elemancy"
	quest.332842533827F298.quest_desc: [
		"在下界挖掘远古残骸并熔炼以获得。"
		""
		"将四个下界合金废料和四个金锭组合，制作一个下界合金锭！"
	]
	quest.333DA241BCF97E3B.quest_desc: ["由10,000个钢锭制成"]
	quest.33453A9CE5884461.quest_desc: ["§6至尊冲压工厂§r。仅限Extras模组的工厂类型，可在最高四个等级中出现。"]
	quest.33453A9CE5884461.quest_subtitle: "额外内容：工厂（Factories）"
	quest.33453A9CE5884461.title: "至尊冲压工厂"
	quest.334C069543F12A2D.quest_desc: [
		"许多活动都需要人在场，大多数是放置方块。在灵气可以替代人工的时代，这实在是一种浪费。不可感知建造者会消耗少量灵气来放置你提供的任何方块。建造者会从放置在其上方的任何物品容器中收集方块。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.3358A31C7B81C9CB.quest_desc: [
		"不知道怎么建造下界传送门的话，可以看看Minecraft维基哦 :)"
		""
		"注意：点燃下界传送门需要打火石和钢，因为火焰蔓延默认被禁用了。"
	]
	quest.3358A31C7B81C9CB.quest_subtitle: "Minecraft"
	quest.3358A31C7B81C9CB.title: "进入下界"
	quest.3369867891992907.quest_desc: [
		"充电器可用于为兼容的工具和 Certus Quartz Crystal 充电。"
		""
		"电力可通过顶部或底部提供，使用AE2的线缆或其他模组的电源线。可接受AE2的电力（AE）或Forge Energy（FE）。物品可从任意一侧放入或取出。仅能取出结果，因此无需过滤器来防止误取出带电的Certus晶体而非普通晶体。可用Certus Quartz Wrench旋转以方便自动化。"
		""
		"可用于将 Certus Quartz Crystal 制成 Charged Certus Quartz Crystal，或将 Compass 制成 Meteorite Compass。"
		""
		"手动供电：将木制曲柄放在顶部或底部，右键点击直到物品充满电。"
		""
		"它同时也是Fluix研究员的工作台。"
	]
	quest.33779E62A940B27D.quest_desc: ["§6精密机械§r是高级创造的核心。在机械合成台里，用齿轮、大齿轮、铁板和金板按顺序合成。"]
	quest.33779E62A940B27D.quest_subtitle: "创建"
	quest.33D83D703DB763EF.quest_desc: ["由黏土和骨粉制成，用于制作未烧制的瓷器物品，如坩埚。"]
	quest.33F3134668A08D26.quest_desc: [
		"燃烧任何燃料（煤炭/木材等）。"
		""
		"1 煤炭 = 20,000 RF（与其他大多数模组的燃料水平类似）。"
		""
		"内部存储容量为 1,000,000 RF"
		""
		"燃烧燃料，能迅速为一个物品充能。"
		""
		"在建立完整的能源系统之前，用来给想用的物品充能的权宜之计。"
	]
	quest.33F3134668A08D26.quest_subtitle: "充电小工具"
	quest.33FBEE929807ECFB.quest_desc: [
		"由铁质网格升级而来。"
		""
		"随着网格层级升高，筛分方块产出的物品会发生变化。详情请见JEI。"
	]
	quest.34043CF7D7634B5F.quest_desc: ["被死亡魔法缠绕的诅咒法老。用§6诅咒之眼§r召唤它，终结它的统治。"]
	quest.34043CF7D7634B5F.quest_subtitle: "大灾难"
	quest.34043CF7D7634B5F.title: "被诅咒者（The Maledictus）"
	quest.3415416F44406EE4.quest_desc: ["收集 Glassential 的专用玻璃板：§6Glowstone Lamp§r、Lava Lamp 和红石玻璃，以及用于隐藏房间和观景画廊的单向 Ethereal 和 Dark Ethereal 玻璃。"]
	quest.3415416F44406EE4.quest_subtitle: "Glassential"
	quest.3415416F44406EE4.title: "玻璃动物标本馆"
	quest.34172B8D67D6281E.quest_desc: ["合成守卫工具和盔甲所需的材料。"]
	quest.341747596D5FDD56.quest_desc: ["QIO 存储驱动器。更高级别的驱动器可容纳更多种类和数量的物品。"]
	quest.341747596D5FDD56.quest_subtitle: "QIO 网络"
	quest.341747596D5FDD56.title: "奇点驱动 (Singularity Drive)"
	quest.34395A704B52130C.quest_desc: ["§6核反应堆控制器§r运行着由反应堆墙壁和处理单元建造的裂变反应堆。用工业冷却器为其降温。"]
	quest.34395A704B52130C.quest_subtitle: "Oritech"
	quest.344D23546D194491.quest_desc: ["银行急需 EMC。获取 §e8§r 把 Magnum Star Omega。"]
	quest.344D23546D194491.quest_subtitle: "大师"
	quest.344D23546D194491.title: "马格南储备"
	quest.3457FE5FD126C5CD.quest_desc: ["Mekanism Tools 的精致黑曜石级斧头。"]
	quest.3457FE5FD126C5CD.quest_subtitle: "Mekanism 工具"
	quest.3457FE5FD126C5CD.title: "精炼黑曜石斧头"
	quest.3465BA65A8FF769E.quest_desc: ["刻印机用于用压机刻印电路和处理器，并将各种物品压成粉末。它能接受AE2的电力（AE）或Fabric/Forge能量（E/FE）。它可以分侧放置，即从不同侧面放入的物品会存入其物品栏的不同槽位。为此，可用Certus Quartz Wrench来旋转它。它还可以被设置为将合成结果推送到相邻的物品栏中。"]
	quest.3473210E7AAB80EE.quest_desc: [
		"改进型高炉最多可安装两个高炉预热炉，各一个位于两侧。它们需要电力才能工作。"
		""
		"一个高炉预热器能使改进型高炉的速度提高一倍，两个高炉预热器能使速度提高三倍。"
	]
	quest.3473210E7AAB80EE.title: "高炉预热装置"
	quest.34753DE00C8F5736.quest_desc: ["Mekanism Tools 的钢制锄头。"]
	quest.34753DE00C8F5736.quest_subtitle: "Mekanism 工具"
	quest.34753DE00C8F5736.title: "钢制锄头"
	quest.3475FD5AB260705E.quest_desc: ["就像物品抽屉一样，但可以存放流体！"]
	quest.34892B714A83B9BD.quest_desc: [
