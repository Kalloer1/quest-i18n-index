	quest.7D319BB781227B4F.title: "电解分离机"
	quest.7D38B35F53BD03BE.quest_desc: ["允许终端/合成设备无限距离操作。"]
	quest.7D38B35F53BD03BE.quest_subtitle: "AEInfinityBooster"
	quest.7D5FE49359F7C34F.quest_desc: ["§6Magnum Star Drei§r。便携式EMC电池，远超Klein Star Omega。容量随尺寸从§eEin§r到§eOmega§r递增。"]
	quest.7D5FE49359F7C34F.quest_subtitle: "项目扩展：更伟大的星辰"
	quest.7D5FE49359F7C34F.title: "马格南星三"
	quest.7D6C7A5C4C3712DE.quest_desc: ["建造一个§6冰箱§r来存放食材。烹饪台烹饪时会直接从冰箱取用。"]
	quest.7D6C7A5C4C3712DE.quest_subtitle: "烹饪方块脑袋们的美食"
	quest.7D6C7A5C4C3712DE.title: "低温存储"
	quest.7D7844AD2210361D.quest_desc: ["燃烧可燃燃料！"]
	quest.7D854FA56E399F98.quest_desc: ["一种用于扩展和连接激光节点网络的方块，允许物品、流体、能量或红石在长距离内传输。"]
	quest.7D8772DB186192F4.quest_desc: ["§6Gargantuan Star Drei§r。便携式EMC电池，游戏中最大的EMC存储设备。容量从§eEin§r到§eOmega§r的每个尺寸都会提升。"]
	quest.7D8772DB186192F4.quest_subtitle: "项目扩展：更伟大的星辰"
	quest.7D8772DB186192F4.title: "巨型星舰三号"
	quest.7D8F28A3E8A48CE7.quest_desc: ["可在传送前选择目的地。必须拥有发射器和接收器。"]
	quest.7DA7C025B4D9C8FF.quest_desc: ["右键点击 BlockZ 方块可循环切换其变体。潜行右键可循环切换回原状。潜行右键空气可切换模式。"]
	quest.7DA7C025B4D9C8FF.quest_subtitle: "BetterBlockz"
	quest.7DB595BFEA348A8C.quest_desc: ["§6钢制外壳§r，钢加锇加玻璃。每个机器方块都围绕它建造。"]
	quest.7DB595BFEA348A8C.quest_subtitle: "资源"
	quest.7DB595BFEA348A8C.title: "钢制外壳"
	quest.7DB74BAC57F10381.quest_desc: ["[ \"必须完成此任务 \", { \"text\": \"牧羊人派\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"44750CE6BE9DB523\" } }, \" 才能解锁。\" ]"]
	quest.7DB74BAC57F10381.quest_subtitle: "10 枚硬币"
	quest.7DB74BAC57F10381.title: "遗迹奖励袋"
	quest.7DBE30B06B7DA642.quest_desc: ["一个128M的量子存储单元。巨大的ME网络容量。"]
	quest.7DBE30B06B7DA642.quest_subtitle: "高级自动化系统 (Advanced AE)"
	quest.7DD3D83E67045F6B.quest_desc: ["§6蓝色中继器§r，等级 §e8§r，共 §e16§r 级。中继器在方块间传输 EMC 并每秒提供额外收益。等级越高，传输量越大。"]
	quest.7DD3D83E67045F6B.quest_subtitle: "项目扩展：中继器 (Project Expansion: Relays)"
	quest.7DD3D83E67045F6B.title: "蓝色中继器 [MK 8]"
	quest.7E1ADEEC8EADE7A8.quest_desc: [
		"ProjectE 是 Equivalent Exchange 2 的开源重制版，适用于 Minecraft 1.7.10 及更高版本。它允许用户使用各种物品和机器将材料转化为其他材料。它添加了一个名为能量-质量共价性（EMC）的系统，用于表示物品的价值。"
		""
		"该值因物品而异，用于确定一种材料需要多少另一种材料。EMC也可以通过其他方式存储和产生。某些方块和物品也会使用EMC来执行强大的效果。"
		""
		"注意：并非所有物品都有 EMC 值。"
	]
	quest.7E1ADEEC8EADE7A8.quest_subtitle: "ProjectE"
	quest.7E1ADEEC8EADE7A8.title: "共价粉尘"
	quest.7E44F5798FA1AF44.quest_desc: ["一个物品可同时存放多种工具和扳手。右键单击工具即可存入，然后通过轮盘菜单切换为所需的工具。一个物品栏即可替代多个。"]
	quest.7E44F5798FA1AF44.quest_subtitle: "Morph-o-Tool"
	quest.7E56A182F8DEF697.quest_desc: ["§6Crusher§r，顾名思义，是用来粉碎东西的。不要和 Enrichment Chamber 搞混了。"]
	quest.7E7C8A3B94BF6C37.quest_desc: ["用效率和幸运附魔你的工具，提升速度并获得更好的掉落率！"]
	quest.7E905409B7196EF7.quest_desc: ["远古沙漠的守护者。用§6Desert Eye§r召唤它，然后击败它。"]
	quest.7E905409B7196EF7.quest_subtitle: "大灾难"
	quest.7E905409B7196EF7.title: "远古遗迹 (The Ancient Remnant)"
	quest.7E9067C221C0F016.quest_desc: ["§6Cosmic Induction Provider§r。提高感应矩阵的传输速率。"]
	quest.7E9067C221C0F016.quest_subtitle: "额外内容：储物空间"
	quest.7E9067C221C0F016.title: "Cosmic Induction Provider"
	quest.7E961B4E81A1A7BE.quest_desc: ["秘术师套装偏爱法力再生，适合持续施法。"]
	quest.7E961B4E81A1A7BE.quest_subtitle: "Ars Nouveau"
	quest.7E9653092FEC97B2.quest_desc: ["将捕获的村民放入§6Trader§r方块中，即可通过简易GUI浏览和购买其交易，无需再与村民进行繁琐的点击交互。"]
	quest.7E9653092FEC97B2.quest_subtitle: "简易村民模组 (Easy Villagers)"
	quest.7E9653092FEC97B2.title: "商人"
	quest.7E9695F23733BE77.quest_desc: ["§6至尊灌注工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.7E9695F23733BE77.quest_subtitle: "额外内容：工厂"
	quest.7E9695F23733BE77.title: "至尊灌注工厂"
	quest.7EADFB4A0F82C875.quest_desc: ["Apothic Enchanting 围绕书架上的三个属性重建附魔台：§bEterna§r（提高最大附魔等级）、§dQuanta§r（威力和随机性）和 §5Arcana§r（稀有和宝藏附魔的概率）。从一个比普通书架强得多的 §6Hellshelf§r 开始。"]
	quest.7EADFB4A0F82C875.quest_subtitle: "Apothic Enchanting"
	quest.7EADFB4A0F82C875.title: "三大属性"
	quest.7EB6A73F2129D124.quest_desc: ["§6最终星碎片§r。仅在掌握所有 EMC 机器的最终等级后才能锻造。终极力量的碎片。"]
	quest.7EB6A73F2129D124.quest_subtitle: "项目扩展：毕业项目（Capstone）"
	quest.7EB6A73F2129D124.title: "最终星核碎片"
	quest.7ED21876B4C1CE24.quest_desc: ["将贝尼托石与罗西尼石再加工获得，而罗西尼石是使用韦德留姆作为燃料在反应堆中产生的废料。"]
	quest.7EE2214DA65D041B.quest_desc: ["让你的火箭看起来像一个大火箭！"]
	quest.7EEB8A1EC9332A30.quest_desc: ["被反应室撕裂的§b奇点§r。所有高级AE量子技术的核心材料。"]
	quest.7EEB8A1EC9332A30.quest_subtitle: "高级自动化系统 (Advanced AE)"
	quest.7EECA16AD037F2D7.quest_desc: ["§6皮带连接器§r能让你在两根转轴间拉皮带，用来运输物品、生物和玩家。Create自动化的核心组件。"]
	quest.7EECA16AD037F2D7.quest_subtitle: "创建"
	quest.7EF319CB8B4339B6.quest_desc: [
		"在其他行星和卫星上生存需要宇航服。"
		""
		"在不同星球/月球的重力下，小心坠落伤害！"
	]
	quest.7EF319CB8B4339B6.title: "太空服"
	quest.7EF9C0F555742CD5.quest_desc: ["使用储存的燃料，像熔炉一样熔炼存储箱内的物品。"]
	quest.7EF9C0F555742CD5.quest_subtitle: "Sophisticated Storage"
	quest.7EFFE27D4D7E6668.quest_desc: [
		"像电池一样储存RF！"
		""
		"它是一个无定形的多方块结构；将一个基础电容器组放在另一个基础电容器组旁边，即可合并它们的储能。"
	]
	quest.7F147A591795B284.quest_desc: [
		"世界中的灵气总量有限，一旦耗尽似乎无法恢复，这确实令人担忧。但事实并非如此：有许多方法可以再生灵气。请参阅指南手册了解具体说明。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.7F147A591795B284.title: "光环生成"
	quest.7F231B4A745A7EBD.quest_desc: ["潜行+右键点击普通ME驱动器，可将其原地转换为§b扩展驱动器§r，并保留其单元。"]
	quest.7F231B4A745A7EBD.quest_subtitle: "ExtendedAE"
	quest.7F24945B6C1F2800.quest_desc: ["此内容在整合包开始时即已解锁。"]
	quest.7F24945B6C1F2800.quest_subtitle: "3 枚硬币"
	quest.7F24945B6C1F2800.title: "普通奖励袋"
	quest.7F3DEB9D1E5BC790.quest_desc: ["这些是AE2输入输出设备的主要组件。借助Fluix水晶和逻辑处理器的力量，设备可以输入输出物品、方块、流体等。（无实际功能，仅为合成中间体）"]
	quest.7F3DEB9D1E5BC790.title: "核心组件"
	quest.7F3F70413226C054.quest_desc: ["§6绿色 EMC 连接器§r，等级 §e10§r，共 §e16§r 级。EMC 连接器用于导入导出物品、流体和原始 EMC，是 EMC 自动化的核心。"]
	quest.7F3F70413226C054.quest_subtitle: "项目扩展：EMC 链接"
	quest.7F3F70413226C054.title: "绿色 EMC 链接 [MK 10]"
	quest.7F46932377752DD0.quest_desc: [
		"§6锇§r，Mekanism 的标志性金属，用于外壳、电路和合金。"
		""
		"在 Mekanism, Inc.，我们为您带来一系列低、中、高阶的机械设备，将您过时的家园和低效的资源处理提升至21世纪。借助我们的高科技工具、高端能源发电机、先进的传输系统和复杂的处理机制，您将摆脱“采矿”和“制作”的繁琐任务，迅速迈向新的科技启蒙境界。"
		""
		"你可能没意识到，每次将矿石直接熔炼成锭，都会浪费大部分开采的资源。Mekanism 经验丰富的化学和机械工程师团队开发了先进的矿石处理设备，能最高效地提取矿石中的资源。借助我们的提纯、溶解、化学注入和结晶技术，只要有足够的基础设施和能源，每单位矿石的锭产量可翻倍、三倍、四倍，甚至五倍。"
		""
		"我们的工程团队理解并支持渐进式技术发展。无论您处于哪个游戏阶段，我们都能提供适合您需求的机械层级。每台Mekanism机器都可升级为工厂，让您在一台机器中同时处理3（基础）、5（高级）、7（精英）甚至9（终极）种不同物品！告别那些曾遍布家园的缓慢丑陋熔炉。立即使用Mekanism，整合您的机械基础设施。"
	]
	quest.7F46932377752DD0.quest_subtitle: "资源"
	quest.7F46932377752DD0.title: "锇锭"
	quest.7F5799FA9929A829.quest_desc: ["§6至尊合成工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.7F5799FA9929A829.quest_subtitle: "额外内容：工厂"
	quest.7F5799FA9929A829.title: "至尊合成工厂"
	quest.7F757497DE9AEC9C.quest_desc: ["§6最终中继器§r，共§e16§r级中的§e16§r级。中继器在方块间传输EMC，每秒提供额外加成。更高等级传输量更大。"]
	quest.7F757497DE9AEC9C.quest_subtitle: "项目扩展：中继器 (Project Expansion: Relays)"
	quest.7F757497DE9AEC9C.title: "最终接力 [MK 16]"
	quest.7F82B1A92A7D555E.quest_desc: ["使用咒语羊皮纸，使箭矢将咒语带到它们落下的任何地方。"]
	quest.7F82B1A92A7D555E.quest_subtitle: "Ars Nouveau"
	quest.7FA97841FE7426E8.quest_desc: ["右键方块可在其上散布一组中的随机图案。潜行右键空气可切换模式。"]
	quest.7FA97841FE7426E8.quest_subtitle: "BetterBlockz"
	quest.7FD7C93F0A05D9EB.quest_desc: ["§6变量卡§r包含逻辑编程器中构建的值或公式。将其插入网络部件以驱动它们。"]
	quest.7FD7C93F0A05D9EB.quest_subtitle: "Integrated Dynamics"
	quest.7FE0310EAFDE3DB5.quest_desc: ["§6绝对感应单元§r。提升感应矩阵的能源容量。"]
	quest.7FE0310EAFDE3DB5.quest_subtitle: "额外内容：储物空间"
	quest.7FE0310EAFDE3DB5.title: "绝对感应单元"
	quest.7FF33FA53596F5F3.quest_desc: [
		"一个被黑暗笼罩的单生物群维度。"
		""
		"- 普通火把会随着时间的推移而熄灭。"
		"- 黑暗本身会造成伤害，所以要保持光亮。"
		"- 敌对生物频繁生成，并且拥有额外的生命值。"
		"- 矿石丰富，是绝佳（但危险）的采矿区。"
		""
		"原版矿石随处可见，但要找到更多多样的模组矿石，你需要下到Y坐标80以下。"
	]
	quest.7FF33FA53596F5F3.quest_subtitle: "维度扩展（Dimension Expansion）"
	quest.809CD89BF6E31C02.quest_desc: ["可通过输入/输出材料名称搜索配方并在世界中高亮显示提供者的配方访问终端。"]
	quest.8AA62BA12E5DAEEA.quest_desc: ["编码了比原版AE2输入输出都多的§b高级处理模式§r。"]
	quest.8B0E7153BF7C3706.quest_subtitle: "Morph-o-Tool"
	quest.8D7A6CDE5F09BEF2.quest_desc: ["为机械装置和耗能部件储存Forge能量。"]
	quest.8F7D134BB8831B5B.quest_desc: ["通过物品或流体标签过滤的存储总线 §btags§r，使用基本逻辑运算符（例如 C:ingots/* | c:gems/*）。"]
	quest.908B6C0237394DFF.quest_desc: ["右键单击方块以选中它，然后在该建造范围内将其替换为匹配方块。潜行右键单击空气以更改模式。"]
	quest.908CAD8B3EF28F5F.quest_desc: ["以棋盘格模式循环方块变体。潜行右键可循环回原状。潜行右键空气可切换模式。"]
	quest.911A95891FCA76A9.quest_desc: ["一个无限的水和鹅卵石单元格式水槽，最多可容纳21亿。"]
	quest.914F149F83B5AE08.quest_desc: ["潜行+右键点击普通导入/导出总线，即可将其原地转换为§b扩展§r版本。"]
	quest.9185D401CE257AD4.quest_desc: ["限制可以放入存储器的物品类型。"]
	quest.97702652F2B23A01.quest_desc: ["Extended Pattern Access Terminal 的无线版本。"]
	quest.A38976EE082C309F.quest_desc: ["通过相邻方块将流体泵入或泵出存储流体罐。"]
	quest.AC74200567A820D3.quest_desc: ["使用储存的燃料，像熔炉一样熔炼存储箱内的物品。"]
	quest.AD77BF39768915E2.quest_desc: ["制作合成台无法完成的复杂扩展设备，并运行游戏中的转换，如流化。 §e其屏幕无法连接到网络。§r"]
	quest.AFA74193304885EE.quest_desc: ["潜行+右键点击普通ME接口，可将其就地转换为§b扩展接口§r，并保留其配置。"]
	quest.B936965EFA838016.quest_desc: ["将匹配方块的范围向外延伸。潜行右击空气可切换模式。"]
	quest.BA552ABB45DEB93F.quest_desc: ["监控ME网络中的物品/流体吞吐量，以调整自动化。"]
	quest.BC4986E10B742C0B.quest_desc: ["在存储界面中添加一个合成网格，使用已存储的物品。"]
	quest.C481EE214E69886D.quest_desc: ["将材料方块直接切成处理器打印件，速度比刻印机快9倍。 §e没有端口的玻璃面无法连接到网络。§r"]
	quest.D21B5AAA1C87409C.quest_desc: ["将附近的掉落物和经验值直接吸入储存箱。"]
	quest.D2BFDC8AB3872178.quest_desc: ["赋予存储漏斗的行为。通过过滤器从上方拉取并推送到下方的物品栏。"]
	quest.D5A03D76E82F142F.quest_desc: ["仅在网络中存储的数量高于或低于设定阈值时导出物品。"]
	quest.D75D167853D00645.quest_desc: ["收集物品时，会拾取符合其过滤条件的物品。"]
	quest.D9078D3FE0A0887B.quest_desc: ["将物品填充为流体，如果使用附加组件（如 Applied Flux），还可以填充 Mekanism 气体、Botania 法力或 §eAE 能量§r。每次操作消耗 80 AE。"]
	quest.DCD63A3E05BA05A6.quest_desc: ["一个可移动的参考，指向网络中的某个位置。可以读写远处的方块，就像它们是本地的一样。"]
	quest.DE573ECAD06B0974.quest_desc: ["潜行+右键点击普通ME驱动器，可将其就地转换为§b扩展驱动器§r，并保留其单元。"]
	quest.E28BECDCB820372C.quest_desc: ["一个可存放36个物品或流体堆栈的存储方块。"]
	quest.E9DF0B3F13052BA1.quest_desc: ["潜行+右键点击普通模式提供者，可将其原地转换为§b扩展模式提供者§r。"]
	quest.ED89CAFF0D6E9901.quest_desc: ["右键点击一个CTM方块，可以将其纹理与相邻方块连接或断开。"]
	quest.EDA739C628EFA201.quest_desc: ["存储和分配经验值，并可以将其泵入或泵出存储单元。"]
	quest.F2B57F63D654F758.quest_desc: ["存储已满时会清空所有过滤物品，因此永远不会堵塞。"]
	quest.FC1EB03300183873.quest_desc: ["接口槽位与正常相同，但每个槽位可容纳多16倍物品（默认每槽1024）。"]
