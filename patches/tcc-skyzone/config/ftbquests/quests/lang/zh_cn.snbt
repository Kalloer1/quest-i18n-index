	quest.1DC74FAB7A521DB0.quest_desc: ["击败坚守者后掉落的一件物品。"]
	quest.1DD3880009B3FBC4.quest_desc: ["§6品红色 EMC 连接器§r，等级 §e4§r 的 §e16§r。EMC 连接器用于导入导出物品、流体和原始 EMC，是 EMC 自动化的核心。"]
	quest.1DD3880009B3FBC4.quest_subtitle: "项目扩展：EMC 链接"
