	quest.7815564DCE9DC236.title: "精炼的发光石靴子"
	quest.781B94F14DB8567B.quest_desc: [
		"一种通过蒸发来增加水中残留的氯化铵浓度的简易装置。"
		""
		"将蓄水池放在储罐顶部。用装满水，让魔法发生！"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.78209BE358EA36E1.quest_desc: ["将气体提炼成用于核工作的§d钚§r和§d钋§r颗粒。"]
