	quest.1DDECE3EFDD8A546.quest_desc: ["升级至 §e4§r §6Dank§r 等级。每个等级每种物品的容量都更大，将口袋变成便携式仓库。"]
	quest.1DDECE3EFDD8A546.quest_subtitle: "Dank Storage"
