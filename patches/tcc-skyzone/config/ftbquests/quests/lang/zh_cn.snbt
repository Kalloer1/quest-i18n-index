	quest.68B6FBC4CBB414BC.quest_subtitle: "大灾难"
	quest.68B6FBC4CBB414BC.title: "远古遗迹 (The Ancient Remnant)"
	quest.68B8F9FF9F45348B.quest_desc: ["宇宙的怒火，尽在掌握之中。"]
	quest.68C53139E1D36746.quest_desc: ["可从所有生物处获得无限灵魂。"]
	quest.68E1372233643800.quest_desc: [
		"使用光环时，有时无需亲临现场就能知道其区域等级会很有帮助。只要连接了比较器，$Aura Detector 就会根据周围环境的浓度发出红石信号。因此，其显示范围与环境之眼相似。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.68EE43F0E092BDE8.quest_desc: ["§6最终星碎片§r。仅在掌握所有 EMC 机器的最终等级后才能锻造。终极力量的碎片。"]
	quest.68EE43F0E092BDE8.quest_subtitle: "项目扩展：毕业项目（Capstone）"
	quest.68EE43F0E092BDE8.title: "最终星核碎片"
	quest.68FC57B52DFDD8F1.quest_desc: ["§6白色中继器§r，等级 §e14§r，共 §e16§r 级。中继器在方块间传输 EMC 并每秒提供额外收益。等级越高，传输量越大。"]
	quest.68FC57B52DFDD8F1.quest_subtitle: "项目扩展：中继器 (Project Expansion: Relays)"
	quest.68FC57B52DFDD8F1.title: "白色中继器 [MK 14]"
	quest.68FE2BEC3C90AFFD.quest_desc: [
		"卡槽是一个便携式存储物品，可容纳多张 LaserIO 卡，方便在不同节点之间管理和切换。"
		""
		"卡牌是可升级组件，插入激光节点以定义其传输物品、流体、能量或红石的方式。"
	]
	quest.6920EAFAB5BDA9FE.quest_desc: [
		"将一个模式保持器放入打包器，另一个放入拆包器，两者都连接到ME网络。"
		""
		"包装器会接收物品并将其制成配方包，而拆包器会将其取出并将物品输出到相邻的背包中。"
		""
		"两台机器会根据模式保持器和包装器向ME网络说明其可执行的操作，连接后包装器会将数据包弹出至网络"
	]
	quest.69421087555EA454.quest_desc: ["§6铜强化板§r在装配器中由铜、钢和塑料制成。大多数更高级机器配方都需要它。"]
	quest.69421087555EA454.quest_subtitle: "Oritech"
	quest.694EEC7F7A1378D8.quest_desc: [
		"拥有一个能储存灵气的自然祭坛固然很好，但能随身携带会更方便。这时，灵气缓存器就能派上用场：它能储存大量灵气，方便随时使用。要填满缓存器，只需将其放置在自然祭坛上，等待灵气流入即可。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.6955CB596F230267.quest_desc: ["用怪物的角锻造出它的标志性锤子。"]
	quest.6955CB596F230267.quest_subtitle: "大灾难"
	quest.6955CB596F230267.title: "焚化炉 (The Incinerator)"
	quest.696A38C5D80A2CDC.quest_desc: [
		"筛选泥土或按住 Shift 点击地面以获得鹅卵石。"
		""
		"将光标悬停在鹅卵石堆上，使用快捷键 \"shift\" + \"k\" 即可自动将其压缩成鹅卵石！"
	]
	quest.696A38C5D80A2CDC.quest_subtitle: "众神之神"
