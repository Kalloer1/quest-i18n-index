	quest.1CEC818DF0EE4222.title: "旋转综合体"
	quest.1CFE1ABB42819D7E.quest_subtitle: "生物群系刷怪工具包"
	quest.1D0B7AA898DB7CD4.quest_desc: ["生成无限岩浆（缓慢）！放入流体抽屉中"]
	quest.1D1A619588096B35.quest_desc: ["饥饿时会从内部储存的食物中自动进食。"]
	quest.1D1A619588096B35.quest_subtitle: "Sophisticated Storage"
	quest.1D1E009C95C47AC9.quest_desc: ["制作Packaged Auto机器所需的材料。"]
	quest.1D29A7571CB9284D.quest_desc: ["§6基础冶炼厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
