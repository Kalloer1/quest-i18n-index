	quest.30CC71CAC95122E2.title: "合金熔炉"
	quest.30CD97D5BF9586B2.quest_desc: ["在改装站安装的 MekaSuit/Meka-Tool 模块。"]
	quest.30CD97D5BF9586B2.quest_subtitle: "MekaSuit \& Meka-Tool"
	quest.30CD97D5BF9586B2.title: "Silk Touch 模块"
	quest.30E6B9AF08BE0E28.quest_desc: ["§6无限富集工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.30E6B9AF08BE0E28.quest_subtitle: "额外内容：工厂（Factories）"
	quest.30E6B9AF08BE0E28.title: "无限富集工厂"
	quest.30EDDDAA38ED12D1.quest_desc: ["杀死一只羊并烹饪其肉以获得羊肉。"]
	quest.30EDDDAA38ED12D1.quest_subtitle: "Minecraft"
	quest.30FBF029F03571A5.quest_desc: [
		"一位炼金术士总是忙于进行新的实验。由于现有的木制箱子不合适，你研发出了新的炼金术士箱子，可存放104个物品堆叠，是双层木制箱子的1.4倍。"
		""
		"不受此存在平面限制的炼金术宝箱，即使被实心方块覆盖也能被访问。撒在箱盖上的共价尘也赋予了箱子微弱的魔法力量，使某些魔法物品放入箱中时能产生效果。"
		""
		"黑洞乐队 - 将附近的物品吸入箱子中"
		"永恒密度宝石 - 将箱子中的材料压缩成更高EMC值的材料"
		"修复护身符 - 修复箱子内的物品"
	]
	quest.30FE8FCBCDCAA608.quest_desc: ["使用高级附魔融合器，可对已附魔的物品进行额外修改。也支持使用等级而非材料来修复物品。与基础融合器相比，成本要低得多。"]
	quest.310F04040699F0C6.quest_desc: ["在同一维度内，以有限距离无线连接两个ME网络。仅限一对一。使用§b无线设置套件§r绑定两者。"]
	quest.310F04040699F0C6.quest_subtitle: "ExtendedAE"
	quest.3110522AA0089289.quest_desc: ["建造一个凋零农场并击败 §e16§r 个凋零。"]
	quest.3110522AA0089289.quest_subtitle: "大师"
	quest.3110522AA0089289.title: "凋零风暴"
	quest.3128FC49F69E885E.quest_desc: ["可重复使用的打包胶带，用途广泛，适合反复搬迁储物空间。"]
	quest.3128FC49F69E885E.quest_subtitle: "Sophisticated Storage"
	quest.312E0269110144C5.quest_desc: ["一套完整的无限盔甲将赋予你创造模式飞行和无敌。即使是面对 /kill 命令。"]
	quest.313767A445CA2C9B.quest_desc: ["你可以使用浇水壶手动加快作物的生长速度。右键点击水方块即可装满浇水壶。使用时，只需对准植物长按右键即可。"]
	quest.313767A445CA2C9B.title: "最高等级浇水壶的最大等级"
	quest.3139DC5259B80BAC.quest_desc: ["§6绝对氧化工厂§r。一种仅限Extras模组的工厂类型，可在最高四个等级中使用。"]
	quest.3139DC5259B80BAC.quest_subtitle: "额外内容：工厂（Factories）"
	quest.3139DC5259B80BAC.title: "绝对氧化工厂"
	quest.31486ECEB69DB4EC.quest_subtitle: "Apothic Enchanting"
	quest.31486ECEB69DB4EC.title: "烈焰水晶"
	quest.31525FA27A6ABDE3.quest_desc: ["细胞形式的冷凝器。 §c必须先在细胞工作台进行分区。§r 删除匹配的物品或将它们凝聚成奇点。"]
	quest.31525FA27A6ABDE3.quest_subtitle: "ExtendedAE"
	quest.3193C4ED86D517D7.quest_desc: ["§6终极流体储罐§r。便携式流体存储设备。"]
	quest.3193C4ED86D517D7.quest_subtitle: "额外内容：储物空间"
	quest.3193C4ED86D517D7.title: "终极流体储罐"
	quest.31967850FE5EECBF.quest_desc: ["收纳并组织一套传送卷轴，让你能从列表中选择一个目的地。"]
	quest.31967850FE5EECBF.quest_subtitle: "Ars Additions"
	quest.3199091CA87F1CD1.quest_desc: ["Extreme Reactors 是经典模组 Big Reactors 的延续。反应堆和涡轮机是多方块结构，能够产生大量电力。本书将引导你完成整个过程。"]
	quest.3199091CA87F1CD1.quest_subtitle: "极端反应堆模组 (Extreme Reactors)"
	quest.31A42D4E46C5856B.quest_desc: [
		"要使用框架方块，请执行以下操作："
		""
		"- 用几乎任何实心方块右键点击该方块，使其外观相同。"
		"- 用流体容器右键点击方块，使其看起来像容器中的流体。"
		"- 右键点击方块并使用萤石粉，使其产生光亮。"
		"- 用 Framed Hammer 右键点击方块以移除伪装。"
		"- 用空流体容器右键方块以移除流体伪装。"
	]
	quest.31AABC96FBE7CAA1.quest_desc: ["§6基础机器核心§r，由青金石和铜块围起。所有基础加工机器都需要它。"]
	quest.31AABC96FBE7CAA1.quest_subtitle: "Oritech"
	quest.31BF2CE22A7C697E.quest_desc: ["Mekanism Tools 中的钢制工具剑。"]
	quest.31BF2CE22A7C697E.quest_subtitle: "Mekanism 工具"
	quest.31BF2CE22A7C697E.title: "钢制剑"
	quest.31CAFD8D2006E87A.quest_desc: ["铜、镍、一个磁线圈和一个熔炉。 §6基础发电机§r燃烧燃料，为机器提供第一份稳定的RF。"]
	quest.31CAFD8D2006E87A.quest_subtitle: "Oritech"
	quest.31D2D1709EB19D54.quest_desc: ["放置在动物前方以生成粉色史莱姆。"]
	quest.31FC1E10FF6B79D5.quest_desc: ["将你的范围进一步延伸至 64 格。添加信标后，此距离会变得更长（按住物品上的 Shift 键查看详情）。"]
	quest.3225998C4F72ED6D.quest_desc: ["§6Fading Matter§r，物质层级 §e15§r。层级 §e15§r 收集器、中继器、花朵和链接的制造材料。"]
	quest.3225998C4F72ED6D.quest_subtitle: "项目扩展：物质（Project Expansion: Matter）"
	quest.3225998C4F72ED6D.title: "消逝的物质"
	quest.325B1A713B91F847.quest_desc: ["将铜和锡熔炼成 512 个青铜锭。"]
	quest.325B1A713B91F847.quest_subtitle: "见习工程师"
	quest.325B1A713B91F847.title: "青铜时代"
	quest.3263AE2A41A47982.quest_desc: ["Mekanism Tools 的 Refined Glowstone 级铲子。"]
