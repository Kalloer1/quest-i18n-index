	quest.46335129B67A86B6.quest_desc: ["Integrated Dynamics 的核心合成材料，由富集的 Menril 压榨而成。几乎每个部件和机器都需要它。"]
	quest.46335129B67A86B6.quest_subtitle: "Integrated Dynamics"
	quest.465262DA42AAFC33.quest_desc: ["可以锤成沙子。用筛子来获取资源！"]
	quest.46707D8AD63320EA.quest_desc: ["§6宇宙注入工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.46707D8AD63320EA.quest_subtitle: "额外内容：工厂"
