	quest.79E4B4E103F1BCD2.quest_desc: ["像个大 boss 一样阻止生物生成！"]
	quest.79F4C05D5286D51B.quest_desc: ["Hostile Neural Networks 是一款基于 Deep Mob Learning 的模组，适用于 1.16.5 及以上版本。它允许你训练数据模型和运行模拟，生成生物预测，可用于生成生物战利品。"]
	quest.79F4C05D5286D51B.quest_subtitle: "敌对神经网络 (Hostile Neural Networks)"
	quest.7A0A23F249E59869.quest_desc: ["§6滑道§r是一种垂直的物品管道。可从上方箱子拉取，推入下方传送带或箱子，并有智能变种用于过滤。"]
	quest.7A0A23F249E59869.quest_subtitle: "创建"
	quest.7A0B734D49D53B69.quest_desc: ["用于控制钠达反应堆的红石电路。"]
	quest.7A0B734D49D53B69.quest_subtitle: "反应堆"
	quest.7A0B734D49D53B69.title: "纳夸达逻辑适配器"
	quest.7A0CF4B9EC0C721A.quest_desc: ["作为熔炉燃料，它的效率是煤炭的两倍。它能熔炼16个物品，而煤炭只能熔炼8个。"]
	quest.7A24EA3399FD6D67.quest_desc: ["生产 §e16§r 混沌核心。"]
	quest.7A24EA3399FD6D67.quest_subtitle: "宗师级大师"
	quest.7A24EA3399FD6D67.title: "混沌锻造台"
	quest.7A4526B9E3692400.quest_desc: [
		"有些行星距离很远，需要更多的燃料。"
		""
