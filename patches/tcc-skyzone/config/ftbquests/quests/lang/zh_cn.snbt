	quest.7836C84E7F9A2950.quest_subtitle: "多区块结构"
	quest.7836C84E7F9A2950.title: "感应矩阵"
	quest.783995D4473F8F16.quest_desc: ["Iron Jetpacks 是一款功能丰富且易于使用的现代喷气背包模组。背包等级越高，性能越好。线圈是背包制作的重要组成部分。请参见 JEI。"]
	quest.78551C2B291A2FF4.quest_desc: [
		"右键可立即根据充能等级挖掘方块 (V, shift+V)。"
		""
		"- 已禁用"
		"- 3x3x2"
		"- 5x5x3"
		"- 7x7x4"
		""
		"不会挖掘泥土或砾石。它也是一种强大的武器，可以作为工具一次挖掘单个方块。"
	]
	quest.7865E729501709AB.quest_desc: ["这是游戏中最昂贵的锭。请不要把它掉进虚空里。"]
	quest.78695C567497FEDE.quest_desc: ["§6黄色中继器§r，等级 §e12§r，共 §e16§r 级。中继器在方块间传输 EMC 并每秒提供额外收益。等级越高，传输量越大。"]
	quest.78695C567497FEDE.quest_subtitle: "项目扩展：中继器 (Project Expansion: Relays)"
