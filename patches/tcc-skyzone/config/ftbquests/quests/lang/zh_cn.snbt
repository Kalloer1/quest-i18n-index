	quest.108159E6D64C856A.quest_desc: [
		"Tainted Gold 是一种被更深层、更黑暗气息祝福的材料，这意味着它们在注入时需要更长时间，但消耗更少的气息。请注意，使用材料的方块形式也能完成相同的注入。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
