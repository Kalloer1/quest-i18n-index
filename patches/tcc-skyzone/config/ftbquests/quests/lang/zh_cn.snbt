	quest.083B3835B5774EE2.title: "无限力量"
	quest.083C5C533FEED7C2.quest_desc: ["解决爆炸问题。击败 256 个苦力怕。"]
	quest.083C5C533FEED7C2.quest_subtitle: "学徒"
	quest.083C5C533FEED7C2.title: "别再嘶嘶作响"
	quest.085AD20D6B4FEF32.quest_desc: ["加速§b量子计算机§r。堆叠加速器以实现更快的自动合成。"]
	quest.085AD20D6B4FEF32.quest_subtitle: "高级自动化系统 (Advanced AE)"
	quest.086FCA2998394D17.quest_subtitle: "开始"
