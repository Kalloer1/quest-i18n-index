	quest.60F7B6780A2BEBFC.quest_desc: [
		"要使用框架方块，请执行以下操作："
		""
		"- 用几乎任何实心方块右键点击该方块，使其外观相同。"
		"- 用流体容器右键点击方块，使其看起来像容器中的流体。"
		"- 右键点击发光石粉所在的方块，使其产生光亮。"
		"- 用 Framed Hammer 右键点击方块以移除伪装。"
		"- 用空流体容器右键方块以移除流体伪装。"
	]
	quest.6100948D492482CB.quest_desc: ["在ME系统中储存源能的§61k ME源能存储单元§r。"]
	quest.6100948D492482CB.quest_subtitle: "Ars Energistique"
	quest.610D028922EA9320.quest_desc: ["右键点击 BlockZ 方块可循环切换其颜色。潜行右键可循环切换回原色。"]
	quest.610D028922EA9320.quest_subtitle: "BetterBlockz"
	quest.6168444BBA2517D8.quest_desc: [
		"这是一个适用于Applied Energistics 2和ProjectE的模组，旨在加强两者的整合。与常规整合模组不同，AppliedE将ProjectE的EMC转化为独特的“密钥类型”，使其能被ME网络显示、记录和操控，并通过AE2的自动合成系统在需要时转换为物品。"
		""
		"该模块会从放置模块的玩家处获取所有转换/EMC知识，为ME网络提供已存储的EMC和可转换物品的信息。它可以在网络上的任何位置放置以正常工作。"
		""
		"注意：使用此功能时，若包含大量 EMC 物品，部分玩家可能会出现 TPS 延迟。r"
	]
	quest.6168444BBA2517D8.quest_subtitle: "AppliedE"
	quest.6168444BBA2517D8.title: "ME 转换魔法"
	quest.61777EB299FB94E0.quest_desc: ["由10,000个青金石制成"]
	quest.6178917456E212A3.quest_desc: ["§6至尊氧化工厂§r。仅限Extras模组的一种工厂类型，可在最高四个等级中出现。"]
	quest.6178917456E212A3.quest_subtitle: "额外内容：工厂（Factories）"
	quest.6178917456E212A3.title: "至尊氧化工厂"
	quest.618D53FB7973A7A1.quest_desc: ["要制作燃料，需要在第一个槽位输入石油。这样就会生成燃料，可以通过在最后一个槽位放置桶来获取。你也可以使用 EnderIO 熔炉，它要稳定得多。"]
	quest.61AE3A99FAC2B56F.quest_desc: ["§6Radiance§r，超越原子的 Extras 材料。通往绝对层级的大门。"]
	quest.61AE3A99FAC2B56F.quest_subtitle: "合金"
	quest.61AE3A99FAC2B56F.title: "光辉（Radiance）"
	quest.61CFDD199E014C42.quest_desc: ["阻止某些被动生物生成，范围较大"]
	quest.61D49DEEEDEE5C86.quest_desc: ["§6Infinite Steak§r 可以从你的 EMC 池中无限为你提供食物。"]
	quest.61D49DEEEDEE5C86.quest_subtitle: "项目扩展：EMC实用工具包"
	quest.61D49DEEEDEE5C86.title: "无限牛排"
	quest.61DBCC3AD9432BFD.quest_desc: ["抵达Tier §e7§r §6Dank§r，这是整合包里最大的便携式存储，一个完整的存储系统仅占一个物品栏。"]
	quest.61DBCC3AD9432BFD.quest_subtitle: "Dank Storage"
	quest.61DBCC3AD9432BFD.title: "最大容量"
	quest.61F806630090ECEC.quest_desc: ["在末地城市飞船上可以找到。"]
	quest.620F57FBAB914B20.quest_desc: ["Mekanism Tools 的钢制工具斧。"]
	quest.620F57FBAB914B20.quest_subtitle: "Mekanism 工具"
	quest.620F57FBAB914B20.title: "钢制斧头"
	quest.6220ED19B826E0CB.quest_desc: ["§6Farmer§r 是一种用于自动种植和收割作物的机器。"]
	quest.6220ED19B826E0CB.quest_subtitle: "神秘自动化"
	quest.62393E6BD6F914C0.quest_desc: ["§6Infinite Liquifying Factory§r。仅限Extras模组的工厂类型，可在最高四个等级中获得。"]
	quest.62393E6BD6F914C0.quest_subtitle: "额外内容：工厂"
	quest.62393E6BD6F914C0.title: "无限液化工厂"
	quest.6246EBDEE4DE4F18.quest_desc: [
		"自然祭坛可用于将特定物品注入光环之力，但它也能帮助将物品从一种类型转化为另一种。要实现这一点，需要制作一个转换催化剂，并将其放置在祭坛周围四个下排金质石砖块中的任意一个上，然后像往常一样将材料放在祭坛上即可。"
		""
		"完整用法列表请参见 JEI。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.627DE54A18AF6224.quest_desc: ["自动化一个烈焰人刷怪器。击败 §e512§r 个烈焰人。"]
	quest.627DE54A18AF6224.quest_subtitle: "大师"
	quest.627DE54A18AF6224.title: "荣耀的烈焰"
	quest.62896E7E2DBD777F.quest_desc: ["用于制作高级和终局物品的强力合成材料"]
	quest.6299CB158A777246.quest_desc: ["消耗附近的树叶并将其转化为能量。"]
	quest.62A913190A1C5D81.quest_desc: ["限制可以放入存储器的物品类型。"]
	quest.62A913190A1C5D81.quest_subtitle: "Sophisticated Storage"
	quest.62BDFCC37705060B.quest_desc: ["§6红石动力花§r，等级§e3§r，共§e16§r个。动力花是一个集收集器、中继器和冷凝器于一体的自给自足方块，能自行产生EMC。"]
	quest.62BDFCC37705060B.quest_subtitle: "项目扩展：能量花朵"
	quest.62BDFCC37705060B.title: "红石动力花 [MK 3]"
	quest.62C53D877A059585.quest_desc: ["所有流入此处的流体都将被清空。"]
	quest.62D5202491593442.quest_desc: [
		"水可以通过在橡木桶中收集雨水，或将树苗或树叶放入橡木坩埚来创造。"
		""
		"木桶可用于创造泥土、黏土、灵魂沙、史莱姆等方块！还有石制木桶。请查看JEI。"
	]
	quest.62D5202491593442.quest_subtitle: "众神之神"
	quest.62D5202491593442.title: "木制桶和坩埚"
	quest.630BC32927A8AA77.title: "基础符文 (Basic Runes)"
	quest.634E83DDF2911DFD.quest_desc: ["外壳既是装饰性方块，也是功能性方块，用于在该模组中制作和建造各种机器与装置。"]
	quest.6353A39C04EF7F7D.quest_desc: ["用于控制哪些物品、流体或能量可以通过激光节点连接的卡片。"]
	quest.63588316070C73FD.quest_desc: ["即使穿着暗物质盔甲，情况危急时你还是会受到明显伤害。你决定像优秀的炼金术士一样，用红物质来解决问题，却发现这套新红物质盔甲能阻挡大量伤害，除了被动能量推搡的感觉外，你几乎感觉不到任何东西。但是……或许你还可以更进一步？"]
	quest.6363812E63D15421.quest_desc: ["消耗源以生成在生物罐中捕获的生物的复制品。"]
	quest.6363812E63D15421.quest_subtitle: "Ars Additions"
	quest.6371C0DED59AAD25.quest_desc: ["将残存的沙尘暴装进§6沙漠的怒火§r中。"]
