	quest.4683D5F30AA3EF61.quest_desc: ["§6高级压缩工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.4683D5F30AA3EF61.quest_subtitle: "额外内容：工厂（Factories）"
