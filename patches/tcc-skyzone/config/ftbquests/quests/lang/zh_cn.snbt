	quest.437A89425D5FCDA3.quest_desc: ["你已经掌握了火焰、精华和力量。继续攀登吧。"]
	quest.437A89425D5FCDA3.quest_subtitle: "Tier 2 Trial"
	quest.437A89425D5FCDA3.title: "学徒试炼"
