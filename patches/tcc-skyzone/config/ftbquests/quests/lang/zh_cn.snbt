	quest.5C7795877E539FFA.quest_subtitle: "额外内容：工厂"
	quest.5C7795877E539FFA.title: "Cosmic Lathing Factory"
	quest.5C7DD486E4E9F1D0.quest_desc: ["将其放置于地面，用装有试剂的 Arcane Pedestal 环绕，并从附近的 Source Jar 提供 Source。将核心试剂放入 Apparatus 中，右键即可制作大部分 Ars 装备和机器。"]
	quest.5C7DD486E4E9F1D0.quest_subtitle: "Ars Nouveau"
