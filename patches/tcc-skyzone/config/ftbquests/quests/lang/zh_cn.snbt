	quest.3700CB704D4A5B9B.quest_desc: ["§6宇宙感应单元§r。提升感应矩阵的能源容量。"]
	quest.3700CB704D4A5B9B.quest_subtitle: "额外内容：储物空间"
	quest.3700CB704D4A5B9B.title: "宇宙感应单元 (Cosmic Induction Cell)"
	quest.3700FAC908C2A72E.quest_desc: ["一套完整的无限盔甲将赋予你创造模式飞行和无敌。即使是面对 /kill 命令。"]
	quest.371722B0FBABF0D4.quest_desc: ["§6Emerald Lasso§r可以捕捉§avillagers§r，但仅限那些同意跟你走的人。"]
	quest.371722B0FBABF0D4.quest_subtitle: "生物套索模组"
	quest.371722B0FBABF0D4.title: "翡翠套索"
	quest.37400B72CCA09A9C.quest_desc: ["§6绝对机械管道§r。用于在机器之间传输流体。"]
	quest.37400B72CCA09A9C.quest_subtitle: "额外内容：运输系统"
	quest.37400B72CCA09A9C.title: "绝对机械管道"
	quest.375228E150421286.quest_desc: ["合成§6Blazing Hellshelf§r：需要大量的§e+10§r §bEterna§r和§dQuanta§r，上限§e65§r。强大的附魔能力。"]
	quest.375228E150421286.quest_subtitle: "Apothic Enchanting"
	quest.375228E150421286.title: "烈焰地狱书架"
	quest.375349762EEA75A9.quest_desc: ["一个无需电力、自动种植作物和树苗的简易木制花盆，但生长速度较慢。无法自动化（除了将产物直接输出到其下方的容器中）。"]
	quest.375349762EEA75A9.quest_subtitle: "Agritech Evolved"
	quest.3756A02BEECBD1E3.quest_desc: ["组件用于制作催化剂。越高级别的组件，制作难度越高。"]
	quest.3760B6D798A48C9B.quest_desc: [
		"备受喜爱的经典模组 Actually Additions 现已回归 Minecraft 1.20.4+，带来了全新的模型、纹理和大量更新！"
		""
		"使用原子重构器和赋能器将矿物转化为强大的晶体，用于制造物品处理和分拣的实用机器、无线传输能量、物品和流体的激光器、用于发电的可再生石油等等。"
	]
	quest.3760B6D798A48C9B.quest_subtitle: "实际上附加的模组 (Actually Additions)"
	quest.3760B6D798A48C9B.title: "实际上附加内容手册"
	quest.376C6AD36CE3F09E.quest_desc: ["制作天使戒指的起点！谁不爱创造模式的飞行呢？"]
	quest.376C6AD36CE3F09E.quest_subtitle: "天使戒指"
	quest.3776041C37A3C9C3.quest_desc: ["§6Refined Glowstone§r，一种用于工具和装饰的发光合金锭。"]
	quest.3776041C37A3C9C3.quest_subtitle: "资源"
	quest.3776041C37A3C9C3.title: "精炼发光石"
	quest.3777274E9F5C5A14.quest_desc: ["§6高级流体储罐§r。便携式流体存储设备。"]
	quest.3777274E9F5C5A14.quest_subtitle: "额外内容：储物空间"
	quest.3777274E9F5C5A14.title: "高级流体储罐"
	quest.37A738516C0645B3.quest_desc: ["通过附近生物死亡来生成源。"]
	quest.37A738516C0645B3.quest_subtitle: "Ars Nouveau"
	quest.37B82D083578AAE3.quest_desc: [
		"消耗能量和液体经验，灵魂绑定器可以通过绑定装有液体的灵魂瓶来改变破损刷怪器生成的怪物类型。"
		""
		"要向机器添加经验值，可以使用连接到储罐或其他液体经验值来源的流体管道；或者，也可以使用经验值棒直接从玩家将经验值放入机器中"
	]
	quest.37C2E6E1232CDA89.quest_desc: ["制作光玻璃。Glassential的玻璃在完全透明的同时还能发出全亮度光芒，让你的窗户照亮房间而不是遮挡视线。"]
	quest.37C2E6E1232CDA89.quest_subtitle: "装饰物"
	quest.37C2E6E1232CDA89.title: "显然可以正常运作"
	quest.37C94E34D9E90527.quest_desc: ["§aShrink§r 添加了 §6Personal Shrinking Device§r。装备它并按下切换键即可缩小到微型尺寸，再按一次即可恢复原状。从蚂蚁的视角看待世界。"]
	quest.37C94E34D9E90527.quest_subtitle: "缩小"
	quest.37C94E34D9E90527.title: "个人缩小装置"
	quest.37F3E23619863187.quest_desc: ["适用于密集自动化合成设置的紧凑型高级模式提供器。"]
	quest.37F3E23619863187.quest_subtitle: "高级自动化系统 (Advanced AE)"
	quest.380496BD763D15E9.quest_desc: ["接口槽位与正常相同，但每个槽位可容纳多16倍物品（默认每槽1024）。"]
	quest.380496BD763D15E9.quest_subtitle: "ExtendedAE"
	quest.380EF464962F81B3.quest_desc: ["生成 10 亿 RF/刻。"]
	quest.38115D4486CF6CD3.quest_desc: ["将发电机接入任务界面，并提供 §e5000万§r FE。"]
	quest.38115D4486CF6CD3.quest_subtitle: "见习工程师"
	quest.38115D4486CF6CD3.title: "力量提升"
	quest.3833EC6F7FBBA74F.quest_desc: ["如果需要连接超过控制器六个面的设备，可以链接另一个能看见整个抽屉网络的接入点。"]
	quest.38451728CB184D6A.quest_desc: ["一个能控制时间和天气的强大装置"]
	quest.38451728CB184D6A.quest_subtitle: "Draconic Evolution"
	quest.384531776969BAA4.quest_desc: ["液体压缩机的升级版。"]
	quest.3895CBE4E408C629.quest_desc: ["升级后的支配魔杖，可以复制粘贴连接，并且作用距离更远。"]
	quest.3895CBE4E408C629.quest_subtitle: "Ars Additions"
	quest.389D24CB471BF633.quest_desc: ["§6Fading Power Flower§r，等级 §e15§r，共 §e16§r 级。Power Flower 是一个集收集器、中继器和冷凝器于一体的自给自足方块，能自行产生 EMC。"]
	quest.389D24CB471BF633.quest_subtitle: "项目扩展：能量花朵"
	quest.389D24CB471BF633.title: "枯萎的力量之花 [MK 15]"
	quest.38C9E48289F1665E.quest_desc: ["§6通用基础线缆§r。传输Forge能量。"]
	quest.38C9E48289F1665E.quest_subtitle: "额外内容：运输系统"
	quest.38C9E48289F1665E.title: "基础通用线缆"
	quest.38D7180D07D8A349.quest_desc: [
		"Slice'N'Splice 可以“切片”和“拼接”头颅和其他物品，通过添加组件来创造新组件。它有六个输入槽、两个工具槽和一个输出槽。Slice'N'Splice 每个输入槽的堆叠大小恰好为一。"
		""
		"Slice'N'Splice 需要两种工具才能运作——斧头和剪刀。没有这些工具，制作过程将不会开始。每次操作都会消耗每种工具的一点耐久度。"
	]
	quest.38D8ABC0F83FDD37.quest_desc: ["§6Spectrum§r 材料，最后的 Extras 资源。通往无限阶层的入口。"]
	quest.38D8ABC0F83FDD37.quest_subtitle: "合金"
	quest.38D8ABC0F83FDD37.title: "光谱"
	quest.38E15612069E3D35.quest_desc: ["燃烧固体燃料，为热发电机或锅炉提供热量。"]
	quest.38E15612069E3D35.quest_subtitle: "生成器"
	quest.38E15612069E3D35.title: "燃料木取暖器"
	quest.38E8EA5AB3A98610.quest_desc: ["[ \"必须完成此任务 \", { \"text\": \"传送器\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"6EF67A87979A9378\" } }, \" 才能解锁。\" ]"]
	quest.38E8EA5AB3A98610.quest_subtitle: "15 枚硬币"
	quest.38E8EA5AB3A98610.title: "史诗奖励袋"
	quest.3904F6539FFE7CF3.quest_desc: ["在混沌岛上收集 128 个混沌碎片。"]
	quest.3904F6539FFE7CF3.quest_subtitle: "宗师级大师"
	quest.3904F6539FFE7CF3.title: "混沌的碎片"
	quest.3905C1E98C8931B0.quest_desc: [
		"当然，根据你当前所处的世界，收集到的光环类型会略有不同。例如，在普通世界中，光环可以以阳光的形式收集；而在下界中，光环则以鬼魂的形式收集；在末地中，光环则以极度的黑暗形式存在。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.39140A5AC01843D2.quest_desc: [
		"“玩多人模式的话，我该如何创造更多岛屿呢？”"
		"- 运行命令 \"b/skyblock guir\"。"
		""
		"“有不同的整合包模式吗？”"
		"- 是的，运行命令 \"b/packmode helpr\"。"
		""
		"“为什么被动生物不刷新了？”"
		"- 如果动物没有刷新，可以制作动物种子，在 JEI 中搜索 \"Haven Animal Seeds\"。"
		""
		"有脉矿采集器吗？\""
		"此整合包包含 FTB Ultimine 模组。默认按键为 Grave 键：`"
		""
		"“暮色森林传送门为什么打不开呢？”"
		"在 JEI 中查找 \"Twilight Diamond\"。这是开启传送门所需的物品。"
		""
		"“我需要按照顺序完成这些任务页面吗？”"
		"- 不。"
		""
		"“怎样才能获得超过五颗心的生命值呢？”"
		"- 吃各种各样的食物来获得永久的心力！"
		""
		"“我该如何获得[在此插入物品]呢？”"
		"- 使用 JEI 查找配方。许多原版物品的原版机制仍然适用（例如在堡垒中找到升级模板）。"
		""
		""
	]
	quest.39140A5AC01843D2.quest_subtitle: "在这里找不到答案？去 Discord 问问吧！"
	quest.39327666C21DA6F6.quest_desc: ["使用大量强大的红色和深色物质，你成功大幅加快了构造体的速度。它现在能一次将物品分解为 EMC 64。此外，它还新增了一个用于放置转化后物品的独立舱室。"]
	quest.3955588BE8BB2019.quest_desc: ["Mekanism Tools 的精致黑曜石护腿。"]
	quest.3955588BE8BB2019.quest_subtitle: "Mekanism 工具"
	quest.3955588BE8BB2019.title: "精炼黑曜石护腿"
	quest.39596CAA42FE6D8A.quest_desc: ["即使穿着暗物质盔甲，情况危急时你还是会受到明显伤害。你决定像优秀的炼金术士一样，用红物质来解决问题，却发现这套新红物质盔甲能阻挡大量伤害，除了被动能量推搡的感觉外，你几乎感觉不到任何东西。但是……或许你还可以更进一步？"]
	quest.397356F1B2238867.quest_desc: ["基础终端，让你可以查看和访问网络存储的内容，并向自动化合成系统请求物品。"]
	quest.3999198FADFC6A44.quest_desc: [
		"由黄金网格升级而来。"
		""
		"随着网格层级升高，筛分方块产出的物品会发生变化。详情请见JEI。"
	]
	quest.39AEB0990DEC4A1B.quest_desc: ["§6安山岩漏斗§r用于在物品栏和传送带之间存取物品。基础物流接口。"]
	quest.39AEB0990DEC4A1B.quest_subtitle: "创建"
	quest.39BB1EE4D2B24353.quest_desc: ["合成时必须使用正确等级的注入器，请查看JEI。融合合成需要能量。注入器可升级至下一级。"]
	quest.39BC864BAA5BEF13.quest_desc: ["PackagedAuto 是 Applied Energistics 2 的一个附加组件，旨在通过物品“包”实现超过9个物品的自动化合成，同时也支持流体合成。"]
	quest.39BC864BAA5BEF13.quest_subtitle: "包装自动化"
	quest.39D148ACFB96F5F9.quest_desc: ["储存的液体量相同，但可以容纳四种不同类型的液体！"]
	quest.39D2256A7658FAE6.quest_desc: ["§6高级化学储罐§r。用于储存气体、浆料和其他化学品。"]
	quest.39D2256A7658FAE6.quest_subtitle: "额外内容：储物系统"
	quest.39D2256A7658FAE6.title: "高级化学储罐"
	quest.39E081184335B6E1.quest_desc: ["§6觉醒交替器§r是觉醒祭坛的单方块自动化版本。"]
	quest.39E081184335B6E1.quest_subtitle: "神秘自动化"
	quest.39EF5A9782C3678C.quest_desc: ["在反应堆中使用铀产生的废料产物。"]
	quest.39FB0BF639BAF694.quest_desc: ["在改装站安装的 MekaSuit/Meka-Tool 模块。"]
	quest.39FB0BF639BAF694.quest_subtitle: "MekaSuit \& Meka-Tool"
	quest.39FB0BF639BAF694.title: "辐射屏蔽模块"
	quest.3A110C233076158A.quest_desc: ["仅在网络中存储的数量高于或低于设定阈值时导出物品。"]
	quest.3A110C233076158A.quest_subtitle: "ExtendedAE"
	quest.3A1D456E94BB9A46.quest_desc: ["元素种子可创造元素精华。用于制作觉醒超贵金属。"]
	quest.3A2B60C3A0D08BA5.quest_desc: ["铁是你所建一切的基础。收集 1,024 个铁锭。"]
	quest.3A2B60C3A0D08BA5.quest_subtitle: "学徒"
	quest.3A2B60C3A0D08BA5.title: "钢铁意志"
	quest.3A3A697E61C43FD9.quest_desc: ["§6基础物流运输机§r。通过网络移动物品。"]
	quest.3A3A697E61C43FD9.quest_subtitle: "额外内容：运输系统"
	quest.3A3A697E61C43FD9.title: "基础物流运输机"
	quest.3A3DE0145E7A9038.quest_desc: ["§6精英感应器§r。提高感应矩阵的传输速率。"]
	quest.3A3DE0145E7A9038.quest_subtitle: "额外内容：储物空间"
	quest.3A3DE0145E7A9038.title: "精英感应器提供者"
	quest.3A4028A9FC91C8C1.quest_desc: ["§6Caerium Miner§r，等级 §e6§r/§e8§r。用上一等级的材料建造框架，然后组装采矿机，从虚空中提取 §bCaerium§r 和其他资源。"]
	quest.3A4028A9FC91C8C1.quest_subtitle: "虚空矿工"
	quest.3A4028A9FC91C8C1.title: "铀矿工 (Caerium Miner)"
	quest.3A4FF66513F8B30A.quest_desc: ["§6装备充电器§r通过从电网汲取能量来为能量工具和盔甲充能。"]
	quest.3A4FF66513F8B30A.quest_subtitle: "Oritech"
	quest.3A6A4C98058E48FC.quest_desc: ["来自太阳的能量。"]
	quest.3A6C554DC1D00CAB.quest_desc: ["召唤一个紫水晶哥布林，它会照料和采集初生的紫水晶。"]
	quest.3A6C554DC1D00CAB.quest_subtitle: "Ars Nouveau"
	quest.3A7184439FA07BE9.quest_subtitle: "中间部分"
	quest.3A7184439FA07BE9.title: "末地跑腿任务"
	quest.3A9CD835C3E1D626.quest_desc: ["§2Naquadah§r，Mekanism Extras 添加的超密度矿石，是包里最强反应堆的燃料。"]
	quest.3A9CD835C3E1D626.quest_subtitle: "反应堆"
	quest.3A9CD835C3E1D626.title: "纳夸达合金"
	quest.3AACD2ACAFBC7177.quest_desc: ["建造§6终极生物工厂§r：极低的生成延迟，红石控制，无AI，无视生成条件和附近玩家，且最大附近生物数极高。"]
	quest.3AACD2ACAFBC7177.quest_subtitle: "Apothic Spawners"
	quest.3AACD2ACAFBC7177.title: "终极刷怪器"
	quest.3AB51CF2A5D78472.quest_desc: ["放置一个Dank Dock，将Dank放入世界。管道和漏斗可以从此处存取物品，实现便携式存储自动化。"]
	quest.3AB51CF2A5D78472.quest_subtitle: "Dank Storage"
	quest.3AB51CF2A5D78472.title: "停靠站"
	quest.3ABF2B8DCA6967BA.quest_desc: ["§6精英注入工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.3ABF2B8DCA6967BA.quest_subtitle: "额外内容：工厂（Factories）"
	quest.3ABF2B8DCA6967BA.title: "精英灌注工厂"
	quest.3AD0AA05BFD863C2.quest_desc: [
		"Functional Storage 是 Storage Drawers 储物方案的另一种选择，外观更新，功能更丰富。"
		""
		"经典的1x1抽屉，每个抽屉可存放大量同一种物品。另有其他变种可选。可升级。"
	]
	quest.3AD0AA05BFD863C2.quest_subtitle: "功能性存储系统"
	quest.3AD36BCC1BE53E9D.quest_desc: ["§6Infinite Induction Provider§r。提高感应矩阵的传输速率。"]
	quest.3AD36BCC1BE53E9D.quest_subtitle: "额外内容：储物空间"
	quest.3AD36BCC1BE53E9D.title: "无限感应器提供者"
	quest.3B17326FFA1DC8F6.quest_desc: [
		"控制电路是制造Mekanism机器/工具的关键组件。它们存在于许多配方中，不同配方可能需要不同等级的控制电路。例如，能量熔炉需要基础控制电路，而化学溶解室则需要终极控制电路。"
		""
		"第一阶。"
	]
	quest.3B2F34ADFEEF855C.quest_desc: ["制作一个§6附魔图书馆§r，用于批量存储、分类和搜索附魔书。"]
	quest.3B2F34ADFEEF855C.quest_subtitle: "Apothic Enchanting"
	quest.3B2F34ADFEEF855C.title: "图书馆"
	quest.3B39980FD69BE7EE.quest_desc: ["作用于泥土以创造有趣的泥土。会生成被动生物。(5x5空间)"]
	quest.3B4CFE1766600596.quest_desc: ["§6渐隐 EMC 连接器§r，等级 §e15§r/§e16§r。EMC 连接器用于导入导出物品、流体和原始 EMC，是 EMC 自动化的核心。"]
	quest.3B4CFE1766600596.quest_subtitle: "项目扩展：EMC 链接"
	quest.3B4CFE1766600596.title: "渐变的 EMC 链接 [MK 15]"
	quest.3B6BA03724FFA136.quest_desc: ["存储升级，等级3。悬停物品查看详情。可升级为下界合金升级。"]
	quest.3B83509F7EDCD9E7.quest_desc: ["把村民放进§6铁傀儡农场§r，让它们生成并杀死铁傀儡，以获得稳定的§6铁§r供应。"]
	quest.3B83509F7EDCD9E7.quest_subtitle: "简易村民模组 (Easy Villagers)"
	quest.3B83509F7EDCD9E7.title: "铁匠铺农场"
	quest.3B8419C45E4CE791.quest_desc: ["Mekanism Tools 的锇级铲子。"]
	quest.3B8419C45E4CE791.quest_subtitle: "Mekanism 工具"
	quest.3B8419C45E4CE791.title: "锇制铲子"
	quest.3B8D8DC08B6B8294.quest_desc: ["用砂岩、骨头、仙人掌和末影之眼制作一个§6沙漠之眼§r。用它来召唤§c远古残骸§r，无需金字塔。"]
	quest.3B8D8DC08B6B8294.quest_subtitle: "大灾难"
	quest.3B8D8DC08B6B8294.title: "沙漠之眼"
	quest.3BD7934F9EDAA4A9.quest_desc: [
		"当然，根据你当前所处的世界，收集到的光环类型会略有不同。例如，在正常世界中，光环可以以阳光的形式收集；而在下界中，光环可以以鬼魂的形式收集；在末地中，光环则以过剩的黑暗形式存在。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.3BE1964D3A01FDB3.quest_desc: ["将太阳能凝聚于方块，倍增其旁放置的收集器产出。"]
	quest.3BE1964D3A01FDB3.quest_subtitle: "项目扩展：EMC 实用工具包"
	quest.3BE1964D3A01FDB3.title: "紧凑型太阳能板"
	quest.3BF6C883E6197374.quest_desc: [
		"虽然为网络提供能量的主要方式是使用能量接收器，但振动室也能直接产生少量到中量的AE。"
		""
		"默认情况下（无升级）可产生 40 AE/秒。"
		""
		"当网络储能装置充满时，振动室会降低功率以节省燃料，但无法完全关闭。"
	]
	quest.3BF7D0F1043813F1.quest_desc: ["使用 energizing orb 制作。用于制作 nitro tier Powah 物品的配方中。"]
	quest.3C155849B9EC1AE9.quest_desc: ["§6Lava Generator§r消耗岩浆桶以稳定RF。向基础发电机添加了Electrum和Magnetic Coil。"]
	quest.3C155849B9EC1AE9.quest_subtitle: "Oritech"
	quest.3C213A6C4914FDFA.quest_desc: ["由 59049 块鹅卵石组成！"]
	quest.3C256D29F276D8D0.quest_desc: ["§6绝对复制工厂§r。一种仅限Extras模组的工厂类型，可在最高四个等级中获得。"]
	quest.3C256D29F276D8D0.quest_subtitle: "额外内容：工厂"
	quest.3C256D29F276D8D0.title: "绝对复制工厂"
	quest.3C3E2C2E554E5CC3.quest_desc: ["§6绿色能量花§r，等级 §e10§r，共 §e16§r 级。能量花是一个集收集器、中继器和冷凝器于一体的自给自足方块，能自行产生 EMC。"]
	quest.3C3E2C2E554E5CC3.quest_subtitle: "项目扩展：能量花朵"
	quest.3C3E2C2E554E5CC3.title: "绿色能量花 [MK 10]"
	quest.3C6AF9FD55DFCE0C.quest_desc: ["§6青色 EMC 连接器§r，等级 §e9§r/§e16§r。EMC 连接器用于进出口物品、流体和原始 EMC，是 EMC 自动化的核心。"]
	quest.3C6AF9FD55DFCE0C.quest_subtitle: "项目扩展：EMC 链接"
	quest.3C6AF9FD55DFCE0C.title: "青色 EMC 链接 [MK 9]"
	quest.3C73C07F7AAD8C05.quest_desc: ["§6绝对放射性废料桶§r。可随时间安全衰变放射性废料。"]
	quest.3C73C07F7AAD8C05.quest_subtitle: "额外内容：储物空间"
	quest.3C73C07F7AAD8C05.title: "绝对放射性废料桶"
	quest.3C759E58328977C6.quest_desc: ["§6Colossal Star Zwei§r。便携式EMC电池，巨型EMC电池。容量从§eEin§r到§eOmega§r随尺寸递增。"]
	quest.3C759E58328977C6.quest_subtitle: "项目扩展：更伟大的星辰"
	quest.3C759E58328977C6.title: "Colossal Star Zwei"
	quest.3CB3F209680AB43E.quest_desc: ["§6紫色收集器§r，§e16§r中的§e6§r级。收集器通过光产生EMC。等级越高，存储越多，产出越快。"]
	quest.3CB3F209680AB43E.quest_subtitle: "项目扩展：收藏家们的探险"
	quest.3CB3F209680AB43E.title: "紫色收藏家 [MK 6]"
	quest.3CF9B4E19430F7B8.quest_desc: ["§6品红燃料§r。由物质提炼的浓缩 EMC 燃料，用于上层机器。"]
	quest.3CF9B4E19430F7B8.quest_subtitle: "项目扩展：燃料 (Project Expansion: Fuel)"
	quest.3CF9B4E19430F7B8.title: "品红色燃料"
	quest.3CFA5C51114EB83D.quest_desc: ["制作盔甲卷轴（头盔、胸甲、护腿、靴子）。卷轴储存附魔效果，并直接应用于匹配的装备。"]
	quest.3CFA5C51114EB83D.quest_subtitle: "Apothic Enchanting"
	quest.3CFA5C51114EB83D.title: "盔甲卷轴 (Armor Tomes)"
	quest.3D10A363B07B51F2.quest_desc: ["Mekanism Tools 的 Refined Glowstone 级头盔。"]
	quest.3D10A363B07B51F2.quest_subtitle: "Mekanism 工具"
	quest.3D10A363B07B51F2.title: "精炼发光石头盔"
	quest.3D1449264E180405.quest_desc: ["Battlemage 套装用法力换取护甲，专为近战施法者打造。"]
	quest.3D1449264E180405.quest_subtitle: "Ars Nouveau"
	quest.3D306CAD27DCB389.quest_desc: ["从染料和植物中提取彩色§d色素§r。"]
	quest.3D306CAD27DCB389.quest_subtitle: "化学与加工 (Chemistry \& Processing)"
	quest.3D306CAD27DCB389.title: "颜料提取器"
	quest.3D41E84C0D2DDDE4.quest_desc: ["在改装站安装的 MekaSuit/Meka-Tool 模块。"]
	quest.3D41E84C0D2DDDE4.quest_subtitle: "MekaSuit \& Meka-Tool"
	quest.3D41E84C0D2DDDE4.title: "霜行者模块"
	quest.3D687AB5F80496E7.quest_desc: ["§6基础流体储罐§r。便携式流体存储设备。"]
	quest.3D687AB5F80496E7.quest_subtitle: "额外内容：储物空间"
	quest.3D687AB5F80496E7.title: "基础流体储罐"
	quest.3D70E1BB2986C4DB.quest_desc: [
		"本模组的基本单位是数据模型——一种包含实体信息的物品，可用于生成该实体的掉落物。要获得数据模型，你必须先制作数据模型框架，并将其用于目标实体以构建模型。模型创建后，你还需要对其进行训练。"
		""
		"数据模型可以通过两种方式训练：使用深度学习器或使用模拟室。深度学习器允许你存储几个数据模型，你收到的击杀将开始训练模型。所有模型最初都处于故障状态，必须在深度学习器中训练至基础级别。"
	]
	quest.3D7235F076947147.quest_desc: ["用烈焰粉、灵魂沙和下界合金废料合成§6火焰之眼§r，召唤燃烧的骑士§cIgnis§r。"]
	quest.3D7235F076947147.quest_subtitle: "大灾难"
	quest.3D7235F076947147.title: "火焰之眼"
	quest.3D7B9D339F5F667B.quest_desc: ["用黑石、下界合金废料和岩浆制作一个§6怪物之眼§r，以召唤§c下界合金巨兽§r。"]
	quest.3D7B9D339F5F667B.quest_subtitle: "大灾难"
	quest.3D7B9D339F5F667B.title: "怪物之眼"
	quest.3D85F5460E7FB63F.quest_desc: ["§6钢锭§r，在动力熔炉中用铁和煤粉合金而成。高级机械的支柱金属。"]
	quest.3D85F5460E7FB63F.quest_subtitle: "Oritech"
	quest.3D8BFC568A459C6E.quest_desc: ["§6石灰中继器§r，等级 §e11§r，共 §e16§r 级。中继器在方块间传输 EMC 并每秒提供额外收益。等级越高，传输量越大。"]
	quest.3D8BFC568A459C6E.quest_subtitle: "项目扩展：中继器 (Project Expansion: Relays)"
	quest.3D8BFC568A459C6E.title: "石灰中继器 [MK 11]"
	quest.3DAA865F15382848.quest_desc: ["使用乳胶处理器制造。熔炼可制成塑料。"]
	quest.3DADB25EBDA4BF03.quest_desc: ["§6精英冶炼厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.3DADB25EBDA4BF03.quest_subtitle: "额外内容：工厂"
	quest.3DADB25EBDA4BF03.title: "精英冶炼厂"
	quest.3DAE18F04A718CBE.quest_desc: ["§6精英感应单元§r。提升感应矩阵的能源容量。"]
	quest.3DAE18F04A718CBE.quest_subtitle: "额外内容：储物空间"
	quest.3DAE18F04A718CBE.title: "精英感应单元"
	quest.3DB50DD3D894E3E5.quest_desc: ["§6无限化学储罐§r。用于储存气体、浆料和其他化学品。"]
	quest.3DB50DD3D894E3E5.quest_subtitle: "额外内容：储物空间"
	quest.3DB50DD3D894E3E5.title: "无限化学储罐"
	quest.3DC50D49076BCE01.quest_desc: ["§6Verdium 修饰器§r。将它们放入 Verdium 矿机以进行调整：§e能量§r可降低功耗，§e物品§r可提高产量，§e速度§r可使其运行更快。制作全部三种以获得 §e4§r 级矿机。"]
	quest.3DC50D49076BCE01.quest_subtitle: "虚空矿工"
	quest.3DC50D49076BCE01.title: "Verdium 修饰器"
	quest.3DCF2760970747FA.quest_desc: ["Forge §6The Incinerator§r，怪物的标志性锤子。"]
	quest.3DCF2760970747FA.quest_subtitle: "大灾难"
	quest.3DCF2760970747FA.title: "焚化炉 (The Incinerator)"
	quest.3DE14C0429B4EEF4.quest_desc: ["§6蓝色能量花§r，等级 §e8§r，共 §e16§r 级。能量花是一个集收集器、中继器和冷凝器于一体的自给自足方块，能自行产生 EMC。"]
	quest.3DE14C0429B4EEF4.quest_subtitle: "项目扩展：能量花朵"
	quest.3DE14C0429B4EEF4.title: "蓝色动力花 [MK 8]"
	quest.3DEE519E4BFF0D8A.quest_desc: ["放置一个§6Dank Dock§r，将Dank放入世界。管道和漏斗可以从此处存取物品，实现便携式存储自动化。这里还有第二个船坞，用于构建网络。"]
	quest.3DEE519E4BFF0D8A.quest_subtitle: "Dank Storage"
	quest.3DEE519E4BFF0D8A.title: "停靠站"
	quest.3E01ACF28AD5D0DB.quest_desc: ["§6§l最后的星辰§r。扩张计划的巅峰，终极的EMC遗物。你已征服了所有收集器、中继器、花朵、链接器和星辰。"]
	quest.3E01ACF28AD5D0DB.quest_subtitle: "项目扩展：毕业项目（Capstone）"
	quest.3E01ACF28AD5D0DB.title: "最终的星辰"
	quest.3E0C3A64AC5CD7AC.quest_desc: [
		"要使用框架方块，请执行以下操作："
		""
		"- 用几乎任何实心方块右键点击该方块，使其外观相同。"
		"- 用流体容器右键点击方块，使其看起来像容器中的流体。"
		"- 右键点击发光石粉所在的方块，使其产生光亮。"
		"- 用 Framed Hammer 右键点击方块以移除伪装。"
		"- 用空流体容器右键方块以移除流体伪装。"
	]
	quest.3E0C71387121A24E.quest_desc: ["§6Conjure Island: Starter§r。在仪式熔炉上运行，升起一个全新的浮空岛，非常适合扩展空岛生存。"]
	quest.3E0C71387121A24E.quest_subtitle: "天空的艺术"
	quest.3E14B10C0D95CDF9.quest_desc: [
		"如果你在制作地基前真的需要动物种子，那么你可以在这里购买。价格可不便宜！"
		""
		"每30分钟重复一次。"
	]
	quest.3E14B10C0D95CDF9.quest_subtitle: "出生在糟糕的生物群系里了？"
	quest.3E14B10C0D95CDF9.title: "需要动物吗？"
	quest.3E4218A3CBD9CB28.quest_desc: ["由你在“另一面”找到的资源制作而成。"]
	quest.3E46241002680BCC.quest_desc: [
		"接口就像一个小型箱子，能根据设置自动填充或清空网络存储。它会在单个游戏回合内完成操作，最多可填充或清空9个物品堆叠，因此如果使用高速物品管道，这是一种快速的进出口方法。"
		""
		"另一个有用的特性是，大多数流体储罐只能存储1种流体，而接口最多可存储9种流体和物品。它们本质上就是带有一些额外功能的箱子/多流体储罐，通过将接口与任何网络断开，就可以禁用这些额外功能。因此，在需要存储少量多种不同物品的特定情况下，接口会很有用。"
	]
	quest.3E51E9D3550062D8.quest_desc: ["消耗每移动一格所需的 EMC 来瞬移到任何地方。"]
	quest.3E51E9D3550062D8.quest_subtitle: "项目扩展：EMC实用工具包"
	quest.3E51E9D3550062D8.title: "炼金术之书"
	quest.3E64496AD2877DE4.quest_desc: ["精炼 §e512§r 金锭，为接下来的工作做好准备。"]
	quest.3E64496AD2877DE4.quest_subtitle: "学徒"
	quest.3E64496AD2877DE4.title: "追求黄金"
	quest.3E745AF0ACA85BA6.quest_desc: ["合成时必须使用正确等级的注入器，请参见JEI。融合合成需要能量。注入器可升级至下一级。"]
	quest.3E7A1B46933CB6FB.quest_desc: ["来自 Ars Ocultas 的 §6祭坛§r，用于制作该模组的黑暗与潜行主题符文。"]
	quest.3E7A1B46933CB6FB.quest_subtitle: "Ars Ocultas"
	quest.3E7EFAE0131CDB93.quest_desc: ["骨头是一种主要产自骷髅及类似生物的物品。它可以被制作成骨粉，或用于驯服野狼。"]
	quest.3EA141C7DA9CD3E8.quest_desc: ["制作一个§6Endshelf§r。Endshelf最多可携带§bEterna§r，上限为§e90§r，通往顶级附魔的入口。"]
	quest.3EA141C7DA9CD3E8.quest_subtitle: "Apothic Enchanting"
	quest.3EA141C7DA9CD3E8.title: "前往末地"
	quest.3EB30F879AB9402A.quest_desc: ["在高级种植箱中用作肥料！"]
	quest.3EC6F34F365E3878.quest_desc: ["§6Magnum Star Zwei§r。便携式EMC电池，远超Klein Star Omega。容量随尺寸从§eEin§r到§eOmega§r逐级提升。"]
	quest.3EC6F34F365E3878.quest_subtitle: "项目扩展：更伟大的星辰"
	quest.3EC6F34F365E3878.title: "马格南星二型"
	quest.3EC6F6C5228BAD28.quest_desc: ["结合了镐、铲子和剑的功能，具有极高的挖掘速度和攻击力"]
	quest.3ED71A33E1C08473.quest_desc: ["获得一个宝石和一个镶嵌印记。印记可为装备添加一个插槽。将宝石镶嵌进去即可获得永久加成。"]
	quest.3ED71A33E1C08473.quest_subtitle: "Apotheosis"
	quest.3ED71A33E1C08473.title: "宝石 镶嵌槽"
	quest.3ED9992DD5070D51.quest_desc: ["使用简单的烹饪系统和一些熟悉的食材，农夫乐事让你能准备各种各样的丰盛美食：从三明治到沙拉和炖菜，从精美的甜点到令人垂涎的盛宴，厨房里不会有任何食材被遗忘！"]
	quest.3ED9992DD5070D51.quest_subtitle: "农夫的欢乐时光"
	quest.3EDA781E026296F3.quest_desc: ["这台机器利用能量从特定方块和矿石中提取粉尘，是制造各类工具所必需的。它与破碎机不同，是其他模组中研磨机的对应物。"]
	quest.3EF82BFE97024F03.quest_desc: ["§6高级目标指示器§r为 Enderic 激光和无人机添加了区块范围和多重目标功能。"]
	quest.3EF82BFE97024F03.quest_subtitle: "Oritech 物品"
	quest.3EFC5E4DCC32D80B.quest_desc: ["再处理的裂变碎片，即你的反应堆所消耗的反应堆燃料。"]
	quest.3EFC5E4DCC32D80B.quest_subtitle: "反应堆"
	quest.3EFC5E4DCC32D80B.title: "可裂变燃料"
	quest.3F0B04F35FFC99B6.quest_desc: ["在 Entro 芽完全长成前破坏时会掉落。8 个碎片可合成回一个 §dEntro 水晶§r。"]
	quest.3F0B04F35FFC99B6.quest_subtitle: "ExtendedAE"
	quest.3F171C175D462267.quest_desc: [
		"筛子：自动筛选材料！使用与普通筛子相同的筛网。筛网可附魔“时运”和“效率”。需要更多铁？试试筛选深板岩碎块。需要能量（RF）。"
		""
		"锤子：能将鹅卵石变成砾石，砾石变成沙子，沙子变成尘土等！需要锤子（可附魔效率）。需要能量（RF）。"
	]
	quest.3F171C175D462267.title: "机械升级 (Mechanical Upgrades)"
	quest.3F1E49F84A0BA465.quest_desc: ["合成材料。用此材料制成的盔甲可以安抚幻影。"]
	quest.3F208ECDB556335A.quest_desc: ["§6§lRosarium Miner§r，等级§e8§r，最终也是最快的虚空矿工。在满配修饰符下，它能凭空向你的仓库倾泻资源。"]
	quest.3F208ECDB556335A.quest_subtitle: "虚空矿工"
	quest.3F208ECDB556335A.title: "玫瑰园矿工"
	quest.3F374B0073688579.quest_desc: ["解决爆炸问题。击败 §e256§r 个苦力怕。"]
	quest.3F374B0073688579.quest_subtitle: "学徒"
	quest.3F374B0073688579.title: "别再嘶嘶作响"
	quest.3F3DC4BF5C52FE28.quest_desc: ["使用加固材料建造一个最大尺寸的巨型反应堆。"]
	quest.3F41F55338B45804.quest_desc: ["§6农夫§r会安排被俘的村民循环地照料作物并为你收割。"]
	quest.3F41F55338B45804.quest_subtitle: "简易村民模组 (Easy Villagers)"
	quest.3F41F55338B45804.title: "农夫"
	quest.3F685D4C6FD56091.quest_desc: ["在改装站安装的 MekaSuit/Meka-Tool 模块。"]
	quest.3F685D4C6FD56091.quest_subtitle: "MekaSuit \& Meka-Tool"
	quest.3F685D4C6FD56091.title: "Shearing Module"
	quest.3F74784097718DB8.quest_desc: [
		"一种和平的资源采集替代方案。"
		""
		"- 一个超平坦世界，包含一层厚厚的石头、然后是深板岩、下界岩和末地石，每一层都有矿石，但没有洞穴或洞窟。"
		"- 完全没有敌对生物。"
		"- 永远是白天。"
	]
	quest.3F7C17E60A335E1B.quest_desc: ["Mekanism Tools 的 Refined Glowstone 级盾牌。"]
	quest.3F7C17E60A335E1B.quest_subtitle: "Mekanism 工具"
	quest.3F7C17E60A335E1B.title: "精炼发光石盾牌"
	quest.3F8BD6F64BECC35C.quest_desc: ["将乳胶泵入以开始制作橡胶。"]
	quest.3F8D587A704CE81C.quest_desc: ["有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"]
	quest.3F8D587A704CE81C.title: "魔法的奖章 (Magical Medallions)"
	quest.3F9634C76705A187.quest_desc: ["移动更快，下落减速，免疫坠落伤害。无需消耗 EMC 即可飞行（与 [Ring of Arcana] 类似）（按两次空格）。短途飞行加速（按住空格）。踏空辅助，无需跳跃即可改变高度（X）。"]
	quest.3FB7B9130426EBD8.quest_desc: ["在改装站安装的 MekaSuit/Meka-Tool 模块。"]
	quest.3FB7B9130426EBD8.quest_subtitle: "MekaSuit \& Meka-Tool"
	quest.3FB7B9130426EBD8.title: "激光消散模块"
	quest.3FBC14ADA3E118E2.quest_desc: [
		"将末地合成台放置于世界中，右键以查看GUI。内部有一个3x3的合成网格，类似于合成台。将配方材料放入网格中，末地合成台就会开始合成。"
		""
		"要提高合成速度，请在末地合成器周围放置末地交替器。在4格半径内放置的任何交替器都能提高合成速度。如果它们发出粒子效果，就说明正在工作。"
	]
	quest.3FBC14ADA3E118E2.quest_subtitle: "扩展合成系统 (Extended Crafting)"
	quest.3FBCBB7370C13585.quest_desc: ["制作一个§6拆解台§r，将附魔装备分解成不同稀有度的§9附魔材料§r。"]
	quest.3FBCBB7370C13585.quest_subtitle: "Apotheosis"
	quest.3FBCBB7370C13585.title: "回收物资"
	quest.3FE0809FC18DD36F.quest_desc: ["一把攻击力为8的剑。"]
	quest.3FF5EFB1D1BBE7D3.quest_desc: ["§6精英压缩工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.3FF5EFB1D1BBE7D3.quest_subtitle: "额外内容：工厂（Factories）"
	quest.3FF5EFB1D1BBE7D3.title: "精英压缩工厂"
	quest.3FFD5071CAB35FE9.quest_desc: ["经典的天空方块。和普通水桶一样，但只能在某些合成配方中使用。用它盛放岩浆会缩短其使用寿命。"]
	quest.40051E467AB4A36E.quest_desc: ["ExtendedAE 的基础。由 §dEntro§r 材料制成。大多数方块机器都建在这些框架上。"]
	quest.40051E467AB4A36E.quest_subtitle: "ExtendedAE"
	quest.400B3C383231B9BE.quest_desc: ["§6Meka-Tool§r 会一次性替换所有工具，并通过模组扩展。"]
	quest.400B3C383231B9BE.quest_subtitle: "MekaSuit \& Meka-Tool"
	quest.400B3C383231B9BE.title: "Meka-Tool"
	quest.402ABC0A6EA35DD4.quest_desc: ["你用连接器将机器连接到网络。通过连接器，各种通道（即使类型不同）也能正常工作。普通连接器只允许从放置连接器的那一侧进行访问。例如，对于原版熔炉，使用普通连接器时，你只能在熔炉底部放置连接器才能获取熔炼后的产物。"]
	quest.402C2DF5EB7E3496.quest_desc: [
		"它不会消耗耐久度，并且能一击秒杀所有生物或玩家，即使玩家在创造模式中。"
		""
		"是的，这甚至在混沌守卫身上也有效。"
	]
	quest.402D82ABE31FC142.quest_desc: ["用于将电路板与蚀刻酸结合，创造未组装的印刷电路板（PCB）"]
	quest.402E44B728DB4434.quest_desc: ["§6青色中继器§r，等级 §e9§r/§e16§r。中继器在方块间传输EMC，每秒提供额外收益。等级越高，传输量越大。"]
	quest.402E44B728DB4434.quest_subtitle: "项目扩展：中继器 (Project Expansion: Relays)"
	quest.402E44B728DB4434.title: "青色中继器 [MK 9]"
	quest.4052BC600A11FEB8.quest_subtitle: "QIO 网络"
	quest.4052BC600A11FEB8.title: "QIO 驱动阵列"
	quest.40639087E44ED689.quest_desc: ["§6Gargantuan Star Vier§r。便携式EMC电池，游戏中最大的EMC存储设备。容量从§eEin§r到§eOmega§r的每个尺寸都会提升。"]
	quest.40639087E44ED689.quest_subtitle: "项目扩展：更伟大的星辰"
	quest.40639087E44ED689.title: "巨型恒星四号"
	quest.40835DA2F48D756E.quest_desc: ["§6白色能量花§r，等级 §e14§r/§e16§r。能量花是一个集收集器、中继器和冷凝器于一体的自给自足方块，能自行产生 EMC。"]
	quest.40835DA2F48D756E.quest_subtitle: "项目扩展：能量花朵"
	quest.40835DA2F48D756E.title: "白色力量花 [MK 14]"
	quest.4086DD3CD2A1CE99.quest_desc: ["用海晶灯、避雷针和末影之眼合成§6风暴之眼§r，召唤出深海的风暴§c斯库拉§r。"]
	quest.4086DD3CD2A1CE99.quest_subtitle: "大灾难"
	quest.4086DD3CD2A1CE99.title: "风暴之眼"
	quest.409BF70E8D188CD9.quest_desc: ["控制电路用于制作多种Mekanism物品和机器。第5级。"]
	quest.409BF70E8D188CD9.quest_subtitle: "Mekanism 扩展内容"
	quest.40A0F17B2D586DFD.quest_desc: ["§6高级机械管道§r。用于在机器之间输送流体。"]
	quest.40A0F17B2D586DFD.quest_subtitle: "额外内容：运输系统"
	quest.40A0F17B2D586DFD.title: "高级机械管道"
	quest.40B2030CD2B574B0.quest_desc: ["EMC传送费用§e50%§r折扣。"]
	quest.40B2030CD2B574B0.quest_subtitle: "项目扩展：EMC 实用工具包"
	quest.40B2030CD2B574B0.title: "高级炼金术之书"
	quest.40B6870514C5217B.quest_desc: ["在草地上种植以养鸡。确保给它足够的生长空间。"]
	quest.40BA19D0B80C6F0A.quest_desc: ["被暗物质包围听起来是个好主意！它能吸收大量伤害。穿上这套盔甲，你几乎无敌。有时，你似乎能在盔甲的光泽中看到动静。"]
	quest.40F3CC129DFC5BCE.quest_desc: ["将鼠标悬停在物品上并按住 Shift 键以查看属性。"]
	quest.410105599B92D2A8.quest_desc: ["QIO 存储驱动器。更高级别的驱动器可容纳更多种类和数量的物品。"]
	quest.410105599B92D2A8.quest_subtitle: "QIO 网络"
	quest.410105599B92D2A8.title: "黑洞驱动器"
	quest.41110F97CD2CC596.quest_desc: ["§6终极合成工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.41110F97CD2CC596.quest_subtitle: "额外内容：工厂（Factories）"
	quest.41110F97CD2CC596.title: "终极合成工厂"
	quest.41174CEBEE63B6EA.quest_desc: ["将鼠标悬停在物品上并按住 Shift 键以查看属性。"]
	quest.41174CEBEE63B6EA.title: "Mk1"
	quest.4120B418636419F8.quest_desc: ["§6火焰焦点§r。手持或佩戴手镯时，可为你的伤害法术附加火焰伤害和灼烧效果。"]
	quest.4120B418636419F8.quest_subtitle: "元素魔法学 (Ars Elemental)"
	quest.41272A7A1AB12284.quest_desc: ["§6Gearshift§r 在接收到红石信号时会反转旋转。活塞、轴承或任何移动装置都不可或缺。"]
	quest.41272A7A1AB12284.quest_subtitle: "创建"
	quest.414D5BBD655805DD.quest_desc: ["残党的远程武器，一把远程投掷长矛。"]
	quest.414D5BBD655805DD.quest_subtitle: "大灾难"
	quest.414D5BBD655805DD.title: "远古长矛"
	quest.41544159462CF7B3.quest_desc: ["在改装站安装的 MekaSuit/Meka-Tool 模块。"]
	quest.41544159462CF7B3.quest_subtitle: "MekaSuit \& Meka-Tool"
	quest.41544159462CF7B3.title: "吸入净化模块"
	quest.415AB951288AB22C.quest_desc: [
		"将物品压缩成奇点。请在JEI中查看每种奇点所需的物品数量。"
		""
		"每个量子压缩机的配方通常需要催化剂和一定数量的材料。将催化剂放在最左边的槽位，材料放在其旁边的槽位。悬停在蓝色条上可以查看当前材料以及压缩机中该物品的数量。如果催化剂和材料的组合有产出，会显示生成物品的进度。"
		""
		"量子压缩机需要能量才能运行。它只在生成物品时消耗能量。"
	]
	quest.415AB951288AB22C.quest_subtitle: "扩展合成系统 (Extended Crafting)"
	quest.416CD34D9E0E1A74.quest_desc: ["让你的火箭看起来像一个小火箭！"]
	quest.4178CE375A63CDC6.quest_desc: [
		"在处理光环时，要掌握特定区域或存储设备中的具体数量本就困难。不过，环境之眼能让植物学家看到这些信息：一旦制作完成，只需将其放在快捷栏的任何位置，就会显示多项信息。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.41856469F387B339.quest_desc: ["§6终极收集器§r，等级§e16§r，共§e16§r级。收集器通过光产生EMC。等级越高，存储越多，产出越快。"]
	quest.41856469F387B339.quest_subtitle: "项目扩展：收藏家们的探险"
	quest.41856469F387B339.title: "最终收集器 [MK 16]"
	quest.418E5D65A9A21971.quest_desc: ["无线版的扩展模式访问终端。"]
	quest.418E5D65A9A21971.quest_subtitle: "ExtendedAE"
	quest.418E8DB5F049E211.quest_desc: ["§6末地激光§r可远程采矿和加工。使用碳纤维、末地透镜、电金和电机。"]
	quest.418E8DB5F049E211.quest_subtitle: "Oritech"
	quest.41C7CA8C8FC35D0B.quest_desc: ["锤子的合成材料。5x5x3"]
	quest.41EA233D4DA850CE.quest_desc: ["§6红色收集器§r，等级§e3§r，共§e16§r级。收集器通过光产生EMC。等级越高，存储越多，产出越快。"]
	quest.41EA233D4DA850CE.quest_subtitle: "项目扩展：收藏家们的探险"
	quest.41EA233D4DA850CE.title: "红色收集器 [MK 3]"
	quest.41EAD87888AC9AAA.quest_desc: ["燃烧燃料为能源电池和机械装置提供能量。"]
	quest.41EAD87888AC9AAA.quest_subtitle: "Integrated Dynamics"
	quest.41F033FFDFBBEB9D.quest_desc: ["潜行+右键点击普通模式提供者，可将其原地转换为§b扩展模式提供者§r。"]
	quest.41F033FFDFBBEB9D.quest_subtitle: "ExtendedAE"
	quest.420F9353A7061064.quest_desc: ["§6Azurine Miner§r，等级 §e5§r/§e8§r。用上一等级的框架建造，然后组装矿工，从虚空中提取 §bAzurine§r 和其他资源。"]
	quest.420F9353A7061064.quest_subtitle: "虚空矿工"
	quest.420F9353A7061064.title: "阿祖林矿工"
	quest.4221D0E01AD435C6.quest_desc: ["Mekanism Tools 的锇级靴子。"]
	quest.4221D0E01AD435C6.quest_subtitle: "Mekanism 工具"
	quest.4221D0E01AD435C6.title: "锇合金靴子"
	quest.42374C695F91CBC5.quest_desc: ["§c§l裂变反应堆§r燃烧铀产生巨大热量和蒸汽，但会因疏忽而熔毁。建造外壳。"]
	quest.42374C695F91CBC5.quest_subtitle: "反应堆"
	quest.42374C695F91CBC5.title: "裂变反应堆"
	quest.425F101DD814DA77.quest_desc: ["催化剂用于复杂的合成配方。它们在层级越高时，合成难度也越大。"]
	quest.42677AFCFC31F5AE.quest_desc: ["抵达精华树的顶端。收集 1,024 个超纯精华。"]
	quest.42677AFCFC31F5AE.quest_subtitle: "大师"
	quest.42677AFCFC31F5AE.title: "至高的丰收"
	quest.426BDE8883566346.quest_desc: ["头盔，来自§6MekaSuit§r，本整合包中最强的盔甲。"]
	quest.426BDE8883566346.quest_subtitle: "MekaSuit \& Meka-Tool"
	quest.426BDE8883566346.title: "MekaSuit 头盔"
	quest.426D02BA20CEF5C4.quest_desc: ["§6精英级安装器§r。可将机器或工厂原地升级到下一个等级。"]
	quest.426D02BA20CEF5C4.quest_subtitle: "额外内容：储物空间"
	quest.426D02BA20CEF5C4.title: "精英级安装器"
	quest.427B08FAFF602FE5.quest_desc: ["将鼠标悬停在物品上并按住 Shift 键以查看属性。"]
	quest.4289B236F67F89B1.quest_desc: [
		"合成终端与普通终端类似，所有设置和分区都相同，但增加了一个合成网格，该网格会自动从网络存储中填充。注意在左键单击输出时不要误操作！"
		""
		"你应该尽快把你的终端升级为合成终端。"
	]
	quest.429ACC512A7C4219.quest_desc: ["可用于储罐、锅炉和涡轮机的透视外壳。"]
	quest.429ACC512A7C4219.quest_subtitle: "多区块结构"
	quest.429ACC512A7C4219.title: "结构性玻璃"
	quest.42A627918AA8B9E2.quest_desc: ["§6Infinite Fluid Tank§r。便携式流体存储装置。"]
	quest.42A627918AA8B9E2.quest_subtitle: "额外内容：储物空间"
	quest.42A627918AA8B9E2.title: "无限流体储罐"
	quest.42DB004467C44452.quest_desc: ["储备 1,024 个觉醒的龙晶锭。"]
	quest.42DB004467C44452.quest_subtitle: "宗师级大师"
	quest.42DB004467C44452.title: "龙之山脉"
	quest.42E85B58C9E586C9.quest_desc: ["右键可立即收割树叶、羊毛和蘑菇（来自牛蘑菇）。充能等级（V，shift+V）控制根据充能所收割的区域大小。"]
	quest.43044B3D63CA83FA.quest_desc: [
		"要使用框架方块，请执行以下操作："
		""
		"- 用几乎任何实心方块右键点击该方块，使其外观相同。"
		"- 用流体容器右键点击方块，使其看起来像容器中的流体。"
		"- 右键点击方块并使用萤石粉，使其产生光亮。"
		"- 用 Framed Hammer 右键点击方块以移除伪装。"
		"- 用空流体容器右键方块以移除流体伪装。"
	]
	quest.430E58A3B3E09D36.quest_desc: ["将两种气体结合成第三种气体，例如生成§b氯化氢§r。"]
	quest.430E58A3B3E09D36.quest_subtitle: "化学与加工 (Chemistry \& Processing)"
	quest.430E58A3B3E09D36.title: "化学注入器"
	quest.431297CE56DC8A83.quest_desc: ["放置在熔炉下方。点击熔炉，用熔化的材料制作金属块。"]
	quest.43689166DFBFABE8.quest_desc: ["将其置于龙头下。将模具放在上面，然后点击龙头即可填充模具。"]
	quest.43698862AB55F952.quest_desc: [
		"获取以太的方法："
		""
		"制作一个停滞舱。停滞舱的主要用途是无限期地收容一个凋零。将配备流体激光底座和紫色激光透镜的激光钻直接放置在凋零上方，会产生以太气体。这种流体是制作工业先行最昂贵物品所必需的，包括其最高级别的机器框架。"
		""
		"在活性停滞仓工作区内生成的凋零会立即被冻结。它不会失去无敌护盾，但激光钻会无视该护盾。凋零不会引发爆炸，也无法采取任何行动。尽管如此，玩家仍可能想用防凋零方块将工作区封闭起来，以防万一停滞仓耗尽电力。"
		""
		"Stasis Chamber 的默认工作区是机器正上方的 3x3x3 立方体。使用 Range Addons 可以扩大其尺寸。玩家在机器工作区内会受到 Slowness 效果的影响。"
	]
	quest.43698862AB55F952.title: "以太气体"
	quest.436A95F28C61DBFD.quest_desc: ["用扳手从世界尽头的岛屿上收集128个混沌碎片。"]
	quest.436A95F28C61DBFD.quest_subtitle: "宗师级大师"
	quest.436A95F28C61DBFD.title: "混沌的碎片"
	quest.4370EEE29BCB3639.quest_desc: ["§6青色收集器§r，等级 §e9§r/§e16§r。收集器通过光产生 EMC。等级越高，存储越多，产出越快。"]
