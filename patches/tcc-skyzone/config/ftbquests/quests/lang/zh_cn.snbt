	quest.1D33C862778D1437.quest_desc: ["所有传入此处的物品、流体或能量都将被清空。"]
	quest.1D48817AB6A06772.quest_desc: [
		"Mystical Agricuture 中有六个等级的种子。"
		""
		"Tier 6 的种子需要 insanium essence 来制作，并且需要相应的 crux 才能生长。"
	]
