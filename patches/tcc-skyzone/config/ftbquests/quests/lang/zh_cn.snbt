	quest.60468CD4C32947DF.title: "终极层级安装器"
	quest.60553E95A9C0BBF4.quest_desc: ["§6Builder§r消耗RF，用放入其物品栏的方块来建造世界区域，或迁移现有区域。它还能清除一大片空间，或破坏区域内特定方块。"]
	quest.6055F3B2ACE430FC.quest_desc: ["刀具是拾荒工具：它们能让你从动植物身上获得更多资源。"]
	quest.60596DD8FDCEC74A.quest_desc: ["将筛网放入筛子中，即可从泥土、砾石、沙子、尘土等生成资源！筛网可用于普通筛子和压缩筛子"]
	quest.60A667FC60362B9A.quest_desc: ["用青金石块合成一本笔记，即可获得《旧笔记本》，即游戏中的《新艺术》指南。阅读它以了解咒语合成、源以及本系列中的所有机器。"]
	quest.60A667FC60362B9A.quest_subtitle: "Ars Nouveau"
	quest.60ACA167231EB32B.quest_desc: ["Mekanism Tools 的钢制工具中的钢制镐。"]
