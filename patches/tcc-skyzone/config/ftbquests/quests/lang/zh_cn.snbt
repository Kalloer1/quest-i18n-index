	quest.471C36AB374C6355.quest_desc: ["一个将源能输送到ME网络另一端的点对点隧道。"]
	quest.471C36AB374C6355.quest_subtitle: "Ars Energistique"
	quest.471E6103F15F0DC3.quest_desc: ["这把神秘的武器能引导声波能量来攻击敌人或与周围环境互动。"]
	quest.4728B9D7EB72BDA1.quest_desc: ["抵达Tier §e7§r §6Dank§r，这是整合包里最大的便携式存储，一个完整的存储系统仅占一个物品栏。"]
	quest.4728B9D7EB72BDA1.quest_subtitle: "Dank Storage"
	quest.4728B9D7EB72BDA1.title: "最大容量"
	quest.47502ABDFAE8843D.quest_desc: [
		"锇压缩机用于将精炼黑曜石粉尘制成精炼黑曜石锭，将萤石粉尘制成萤石锭。"
		""
		"它将液态锇（熔化的锇锭放入机器底部槽位）与原始材料融合，以创造相应的锭。"
	]
	quest.4755B97229118EB4.quest_desc: [
		"觉醒祭坛是觉醒合成结构的核心组件。它与觉醒基座和精华容器主要用于合成觉醒超贵金属。用途请见JEI。"
		""
		"要使用觉醒祭坛，你必须先在世界中放置它。确保周围没有障碍物。然后，在祭坛周围放置觉醒基座和精华容器。祭坛会在世界中显示幽灵基座/容器，指示你放置的位置。"
		""
		"祭坛设置好后，手持物品右键祭坛和底座即可放置物品。容器也是如此，但最多可容纳40个物品。"
		""
		"要激活祭坛，可以用红石信号（如按钮、拉杆）来触发它。"
	]
	quest.4759E95B08777FDB.quest_desc: ["一个由下界合金熔铸而成的巨像。用§6怪物之眼§r召唤它，然后将其推倒。"]
	quest.4759E95B08777FDB.quest_subtitle: "大灾难"
	quest.4759E95B08777FDB.title: "下界合金的怪物形态"
	quest.475DE7E314360238.quest_desc: ["§6宇宙种植工厂§r。仅限Extras模组的一种工厂类型，可在最高四个等级中出现。"]
	quest.475DE7E314360238.quest_subtitle: "额外内容：工厂"
	quest.475DE7E314360238.title: "宇宙种植工厂"
	quest.479419B42BB377F5.quest_desc: ["§6§l最后的星辰§r。扩张计划的巅峰，终极的EMC遗物。你已征服了每一个收集器、中继器、花朵、链接器和星辰。"]
	quest.479419B42BB377F5.quest_subtitle: "项目扩展：毕业项目（Capstone）"
	quest.479419B42BB377F5.title: "最终的星辰"
	quest.47C55BD17C2CF3B3.quest_desc: ["Mekanism Tools 的锇级帕克斯尔。"]
	quest.47C55BD17C2CF3B3.quest_subtitle: "Mekanism 工具"
	quest.47C55BD17C2CF3B3.title: "锇质帕塞尔"
	quest.47D0492A318B2353.quest_desc: [
		"模式编码终端与普通终端类似，拥有相同的设置和板块，但额外增加了模式编码界面。其外观与合成终端的UI相似，但这个合成网格并不会真正进行合成。"
		""
		"除了制作终端，你还应该拥有一个这个物品。"
	]
	quest.47DAE272EE988E65.quest_desc: ["§6骑士金属锭§r是通过熔炼盔甲碎片簇获得的物品。"]
	quest.480E83DD55448590.quest_desc: ["用于存储和传输RF能量的物品"]
	quest.4811CD4ED7E8EA0D.quest_desc: ["生产 256 个中子锭。"]
	quest.4811CD4ED7E8EA0D.quest_subtitle: "宗师级大师"
	quest.4811CD4ED7E8EA0D.title: "中子星"
	quest.48353C91ED6D6D39.quest_desc: ["§6Magnum Star Sphere§r。便携式EMC电池，远超Klein Star Omega。容量随尺寸从§eEin§r到§eOmega§r逐级提升。"]
	quest.48353C91ED6D6D39.quest_subtitle: "项目扩展：更伟大的星辰"
	quest.48353C91ED6D6D39.title: "马格南星球"
	quest.483DA3FB8D65ED2F.quest_desc: ["[ \"必须完成此任务 \", { \"text\": \"下界合金棒\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"75AD65B7786D4698\" } }, \" 才能解锁。\" ]"]
	quest.483DA3FB8D65ED2F.quest_subtitle: "15 枚硬币"
	quest.483DA3FB8D65ED2F.title: "随机奖励袋"
	quest.4854DD299625E0EC.quest_desc: ["§6Azurine Modifiers§r。将它们放入 Azurine Miner 以进行调整：§eEnergy§r 降低功耗，§eItem§r 提高产量，§eSpeed§r 加快运行速度。制作全部三种以获得 §e5§r 级。"]
	quest.4854DD299625E0EC.quest_subtitle: "虚空矿工"
	quest.4854DD299625E0EC.title: "Azurine 修饰器"
	quest.485CEEB352AEC7F6.quest_desc: ["Botany Pots Mystical 让你可以在花盆里种植 §6Mystical Agriculture§r 作物。设置一个种植 §aessence 作物§r 的花盆，然后点击确认你的自动化 essence 农场正在运行。"]
	quest.485CEEB352AEC7F6.quest_subtitle: "植物学花盆"
	quest.485CEEB352AEC7F6.title: "神秘花园"
	quest.4864DEEF3DA992C1.quest_desc: ["§6绝对种植工厂§r。一种仅限Extras模组的工厂类型，可在最高四个等级中获得。"]
	quest.4864DEEF3DA992C1.quest_subtitle: "额外内容：工厂"
	quest.4864DEEF3DA992C1.title: "绝对种植工厂"
	quest.48675A769F0D3F9D.quest_desc: ["将这些部件组装起来，制作一个将风力转化为旋转能量的动能发电机。"]
	quest.48675A769F0D3F9D.title: "动能之力"
	quest.488E3B98314C6242.quest_desc: ["在方尖塔周围可配置半径内（3x3至9x9）收割作物，并输出到上方的物品栏。将方尖塔放置于农场的方块内。方尖塔需要一把锄头，每次收割会消耗1点耐久度。可使用不可破坏的锄头，如Mystical Agriculture的Supremium锄头。"]
	quest.488E3B98314C6242.quest_subtitle: "Pylons"
	quest.488EB6F4DF70142A.quest_desc: ["能赋予不同增益的特殊苹果！将鼠标悬停在苹果上并按住 Shift 键查看其效果。"]
	quest.488FD84129EFCB37.quest_desc: ["§6石灰色能量花§r，等级 §e11§r，共 §e16§r 级。能量花是一个集收集器、中继器和冷凝器于一体的自给自足方块，能自行产生 EMC。"]
	quest.488FD84129EFCB37.quest_subtitle: "项目扩展：能量花朵"
	quest.488FD84129EFCB37.title: "石灰色力量花 [MK 11]"
	quest.48944D8DEB5755A3.quest_desc: ["§6紫色中继器§r，等级§e6§r，共§e16§r级。中继器在方块间传输EMC，每秒提供额外收益。等级越高，传输量越大。"]
	quest.48944D8DEB5755A3.quest_subtitle: "项目扩展：中继器 (Project Expansion: Relays)"
	quest.48944D8DEB5755A3.title: "紫色中继器 [MK 6]"
	quest.4897573E28F37533.quest_subtitle: "晚期"
	quest.4897573E28F37533.title: "数字前沿"
	quest.48A2A4D44D3E72AB.quest_desc: ["在改装站安装的 MekaSuit/Meka-Tool 模块。"]
	quest.48A2A4D44D3E72AB.quest_subtitle: "MekaSuit \& Meka-Tool"
	quest.48A2A4D44D3E72AB.title: "能量模块"
	quest.48B38A199C0690E6.quest_desc: ["Mekanism Tools 的锇级斧头。"]
	quest.48B38A199C0690E6.quest_subtitle: "Mekanism 工具"
	quest.48B38A199C0690E6.title: "锇合金斧头"
	quest.48B64BA472D951B7.quest_desc: [
		"右键可立即将泥土变为路径，或逐层采集泥土和沙子。右键砾石、黏土或雪可立即采集整条矿脉。基于充能等级（V，shift+V）。"
		""
		"- disabled/1 将方块变为路径"
		"- 3x3"
		"- 5x5"
		""
		"用普通铲子挖掘方块的速度极快。"
	]
	quest.48B6C9424344CEF4.quest_desc: ["提高存储槽位的堆叠大小限制（Tier 1）。"]
	quest.48B6C9424344CEF4.quest_subtitle: "Sophisticated Storage"
	quest.48CD3B49D43B3D19.quest_desc: ["将任何可在原版熔炉中冶炼的物品（如煤炭、木材）转化为RF。"]
	quest.48D07CD07C9D1D11.quest_desc: ["可通过输入/输出材料名称搜索配方并在世界中高亮显示提供者的配方访问终端。"]
	quest.48D07CD07C9D1D11.quest_subtitle: "ExtendedAE"
	quest.48E4F59FF296897C.quest_desc: ["§6宇宙溶解工厂§r。仅限Extras模组的工厂类型，可在最高四个等级中出现。"]
	quest.48E4F59FF296897C.quest_subtitle: "额外内容：工厂"
	quest.48E4F59FF296897C.title: "宇宙溶解工厂"
	quest.48EAF0F64FC1A4F7.quest_desc: ["§6元素魔法焦点§r，融合所有学派于一体的终极焦点。"]
	quest.48EAF0F64FC1A4F7.quest_subtitle: "Ars Elemancy"
	quest.48F7CFE486114237.quest_desc: ["§6大型储能装置§r能为中后期能源网络储存更多RF。"]
	quest.48F7CFE486114237.quest_subtitle: "Oritech"
	quest.48FBD5317738F7A8.quest_desc: ["§6至尊能量立方§r。可储存Forge能量。更高等级可储存和传输的能量多得多。"]
	quest.48FBD5317738F7A8.quest_subtitle: "额外内容：储物空间"
	quest.48FBD5317738F7A8.title: "至尊能量立方体"
	quest.490AE6B07381C059.quest_desc: ["§6Rosarium Modifiers§r。将它们放入 Rosarium Miner 以进行调整：§eEnergy§r 降低功耗，§eItem§r 提高产量，§eSpeed§r 加快运行速度。制作全部三种以获得 §e8§r 级。"]
	quest.490AE6B07381C059.quest_subtitle: "虚空矿工"
	quest.490AE6B07381C059.title: "玫瑰园修饰器模组"
	quest.4915E0D17F4A2E1F.quest_desc: ["Sophisticated Storage 的核心。插槽中可放置升级，可通过铜/铁/金/钻石/下界合金等级提升。 §7使用存储工具潜行右键管理它。§r"]
	quest.4915E0D17F4A2E1F.quest_subtitle: "Sophisticated Storage"
	quest.49239DDB0ADB74B9.quest_desc: ["§6Fading Relay§r，等级 §e15§r，共 §e16§r 级。中继器在方块间传输 EMC 并每秒提供额外收益。等级越高，传输量越大。"]
	quest.49239DDB0ADB74B9.quest_subtitle: "项目扩展：中继器 (Project Expansion: Relays)"
	quest.49239DDB0ADB74B9.title: "渐隐中继器 [MK 15]"
	quest.4933105141BFC178.quest_desc: ["用黑曜石和哭泣的黑曜石制作一个§6Abyss Eye§r，以召唤沉没之城的§cHarbinger§r。"]
	quest.4933105141BFC178.quest_subtitle: "大灾难"
	quest.4933105141BFC178.title: "深渊之眼"
	quest.493759F763F02B39.quest_desc: ["储存的液体量相同，但可以容纳两种不同的液体！"]
	quest.493B8A2BD7F69B45.quest_desc: ["将鼠标悬停在物品上并按住 Shift 键以查看属性。"]
	quest.493B8A2BD7F69B45.title: "Mk2"
	quest.494884093C4BDEB3.quest_desc: ["元素种子可创造元素精华。用于制作觉醒超贵金属。"]
	quest.49593BB9B587C493.quest_desc: ["提供更强、更快、能量容量更大的效果"]
	quest.495D395DC3289858.quest_desc: ["将存储方块打包。保留其内容和升级。变成一个可携带的物品，以便你完整无损地移动它。"]
	quest.495D395DC3289858.quest_subtitle: "Sophisticated Storage"
	quest.49645198C15868C6.quest_desc: ["利用太阳能（太阳）来产生RF。第6级！"]
	quest.4968E5880A15BBF1.quest_desc: ["将物品填充为流体，如果使用附加组件（如 Applied Flux），还可以填充 Mekanism 气体、Botania 法力或 §eAE 能量§r。每次操作消耗 80 AE。"]
	quest.4968E5880A15BBF1.quest_subtitle: "ExtendedAE"
	quest.496EBA5BB478D5CC.quest_desc: ["将二百五十亿FE投入任务界面。让网格哭泣吧。"]
	quest.496EBA5BB478D5CC.quest_subtitle: "宗师级大师"
	quest.496EBA5BB478D5CC.title: "无限力量"
	quest.496F3837D34D9C5A.quest_desc: ["控制电路用于制作多种Mekanism物品和机器。第7级。"]
	quest.49794080F37AA6D6.quest_desc: ["用这个点击一个僵尸或骷髅怪。"]
	quest.498D46615B73E487.quest_desc: ["§6Spawner Controller§r可将Spawner Cage和Respawn Anchor转换为由Arcane Catalyst驱动的、可配置的生物生成器。"]
	quest.498D46615B73E487.quest_subtitle: "Oritech"
	quest.49955E535F516F43.quest_desc: ["存储和分配经验值，并可以将其泵入或泵出存储单元。"]
	quest.49955E535F516F43.quest_subtitle: "Sophisticated Storage"
	quest.49B1FF0346B228E2.quest_desc: ["Entangled 为你提供将两个方块绑在一起所需的材料，让你可以像操作单个方块一样与它们互动！这样你就可以即时传输物品、能量、流体等，你可以拥有超过六个可操作的面，或者只是隐藏凌乱的线缆，可能性无穷无尽！"]
	quest.49C3172907E94051.quest_desc: ["在空中放置一个方块！无需工具即可破坏，并直接放回你的物品栏中。"]
	quest.49C3172907E94051.quest_subtitle: "实用主义"
	quest.49C8A5689B4F13C8.quest_desc: ["收集游戏中每种盔甲修饰件各一个（列表请见JEI）。"]
	quest.49CCA974C5416EDB.quest_desc: ["SPS 的输入和输出端口。"]
	quest.49CCA974C5416EDB.quest_subtitle: "反应堆"
	quest.49CCA974C5416EDB.title: "SPS 端口"
	quest.49D1B3EF88869286.quest_desc: ["一个注入了火焰专注力量的炮台，为其施放的任何法术附加该效果。"]
	quest.49D1B3EF88869286.quest_subtitle: "元素魔法学 (Ars Elemental)"
	quest.4A1445A4A4D63D8A.quest_desc: ["§6基础安装器§r。可将机器或工厂原地升级到下一个等级。"]
	quest.4A1445A4A4D63D8A.quest_subtitle: "额外内容：储物空间"
	quest.4A1445A4A4D63D8A.title: "基础层级安装器"
	quest.4A43514C3AAC8261.quest_desc: ["§6宇宙离心工厂§r。仅限Extras模组，可在最高四个等级中出现。"]
	quest.4A43514C3AAC8261.quest_subtitle: "额外内容：工厂"
	quest.4A43514C3AAC8261.title: "宇宙离心分离机工厂"
	quest.4A48C9233678C0E2.quest_desc: ["Mekanism Tools 的锇级头盔。"]
	quest.4A48C9233678C0E2.quest_subtitle: "Mekanism 工具"
	quest.4A48C9233678C0E2.title: "锇合金头盔"
	quest.4A7914DE1EE8C228.quest_desc: ["§6Pink EMC Link§r, tier §e5§r of §e16§r. EMC Links import and export items, fluids and raw EMC, the backbone of EMC automation."]
	quest.4A7914DE1EE8C228.quest_subtitle: "项目扩展：EMC 链接"
	quest.4A7914DE1EE8C228.title: "粉色 EMC 链接 [MK 5]"
	quest.4A896062318A7D4A.quest_desc: ["可怕的骷髅让我毛骨悚然！"]
	quest.4A94EFEE171A8EAC.quest_desc: [
		"分子组装器会接收输入的物品，并按照相邻的ME模式提供器、插入的制作配方、锻造台配方或石匠配方执行操作，然后将结果推送到相邻的背包中。"
		""
		"不过，它们的主要用途是搭配 ME 模式提供器。模式提供器在这种情况下有特殊行为，会将相关模式的配方信息和材料一同发送到相邻的装配器。由于装配器会自动将合成结果弹出到相邻的背包（即模式提供器的返回栏位），因此只需在模式提供器上放置一个装配器，即可实现模式的自动化合成。"
	]
	quest.4A97D4D54CD232BF.quest_desc: ["通过电缆传输能量，可升级。"]
	quest.4A9E341B69EDA897.quest_desc: ["§6粒子加速器速度传感器§r向控制器报告粒子速度。"]
	quest.4A9E341B69EDA897.quest_subtitle: "Oritech 物品"
	quest.4AB396AED180FC43.quest_desc: ["§6机械轴承§r能让附着的装置围绕其轴心旋转。是风车、火车转向架和旋转桥的基础。"]
	quest.4AB396AED180FC43.quest_subtitle: "创建"
	quest.4AB667CCE02BE8CA.quest_desc: ["一个能在其区域内生成石头和含矿石的仪式。"]
	quest.4AB667CCE02BE8CA.quest_subtitle: "天空的艺术"
	quest.4ADC75DE70AEE87C.quest_desc: ["在末地城市击杀一个潜行贝即可获得。"]
	quest.4ADFC70E3DA60950.quest_desc: [
		"一种可从物品中提取炼金盐的装置。"
		""
		"将熔炉放在熔岩炉上。用烈焰棒填满熔岩炉来加热熔炉！"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.4AEC1E7CE3F054B7.quest_desc: [
		"用锤子砸碎方块。Cobblestone -> Gravel, Gravel -> Sand, Sand -> Dust, Netherrack -> Crushed Netherrack, End Stone -> Crushed End Stone, Cobbled Deepslate -> Crushed Deepslate, Blackstone -> Crushed Blackstone, Crushed Netherrack -> Red Sand. 之后可以用机器自动化。现在，矿脉挖掘和建造棒是你的好帮手。"
		""
		"试着用木槌敲击原木来获得木屑——非常适合堆肥！"
	]
	quest.4AF7ACF846C43CCB.quest_desc: ["§6Caerium 修饰器§r。将它们放入 Caerium 矿机以进行调整：§e能量§r降低功耗，§e物品§r提高产量，§e速度§r使其运行更快。制作全部三种以获得 §e6§r 级矿机。"]
	quest.4AF7ACF846C43CCB.quest_subtitle: "虚空矿工"
	quest.4AF7ACF846C43CCB.title: "Caerium 修饰器"
	quest.4B06F197D8757873.quest_desc: ["戴上§6工程师护目镜§r，即可查看应力、转速和装置详情。不可或缺的调试工具。"]
	quest.4B06F197D8757873.quest_subtitle: "创建"
	quest.4B22EF984AA9E58E.quest_subtitle: "高级自动化系统 (Advanced AE)"
	quest.4B49091675AA1DFA.quest_desc: ["放入其物品栏的任何物品都会转化为 EMC，并将能量从能量收集器传输到能量冷凝器。传输时，每秒提供 10 EMC 的额外能量。它能为 Klein Star 系列的所有物品充能 EMC。"]
	quest.4B4F025A5D54F8D6.quest_desc: ["§6精英注入工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.4B4F025A5D54F8D6.quest_subtitle: "额外内容：工厂"
	quest.4B4F025A5D54F8D6.title: "精英注射工厂"
	quest.4B5873D3379CB4B5.quest_desc: ["§6Infinite Bin§r。用于批量存储单一物品的方块。"]
	quest.4B5873D3379CB4B5.quest_subtitle: "额外内容：储物空间"
	quest.4B5873D3379CB4B5.title: "无限储物箱"
	quest.4B5D653985BDC839.quest_desc: [
		"通过仪式，可以获得代币的知识：木制小雕像，描绘着关键情感——由注入了各自符号的树木制成。这些小雕像蕴含着气场本身及其所代表情感的巨大力量。未来，这些代币将成为重要的建造材料。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.4B62DEDA4F901770.quest_desc: ["无与伦比的速度、可重配置侧面、用于烟熏和爆破的增强组件，大幅提升冶炼效率。"]
	quest.4B7A9E79D4CAE2E1.quest_desc: ["Mekanism Tools 的钢制铲子。"]
	quest.4B7A9E79D4CAE2E1.quest_subtitle: "Mekanism 工具"
	quest.4B7A9E79D4CAE2E1.title: "钢制铲子"
	quest.4B893A1BDA3CEC33.quest_desc: ["通过蓄力并激活 (C) §6暗物质之剑§r，这把强大的剑将消耗 EMC 来换取一次毁灭性的横扫攻击。攻击范围由蓄力等级 (V, shift+V) 控制。"]
	quest.4B8B7DFAE855A0E2.quest_desc: ["§6Shining Alloy§r。一种Extras合成合金。"]
	quest.4B8B7DFAE855A0E2.quest_subtitle: "附加内容：杂项"
	quest.4B8B7DFAE855A0E2.title: "闪耀合金"
	quest.4B93E6027F503503.quest_desc: ["量子盔甲卡，赋予§b创造模式飞行§r。"]
	quest.4B93E6027F503503.quest_subtitle: "高级自动化系统 (Advanced AE)"
	quest.4BA31070C50306EF.quest_desc: ["§6基础灌注工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.4BA31070C50306EF.quest_subtitle: "额外内容：工厂"
	quest.4BA31070C50306EF.title: "基础附魔工厂"
	quest.4BC8C8F0B0ADFCA2.quest_desc: ["在改装站安装的 MekaSuit/Meka-Tool 模块。"]
	quest.4BC8C8F0B0ADFCA2.quest_subtitle: "MekaSuit \& Meka-Tool"
	quest.4BC8C8F0B0ADFCA2.title: "液压推进模块"
	quest.4BCB152BBCEB3B90.quest_desc: [
		"环境之眼理论上非常有用，但许多魔法植物学家都难以应对其对环境气场探测范围的局限性。一个简单的解决方案是环境之眼。虽然它与环境之眼的工作原理相似，但主要区别在于它对区域气场的探测范围要大得多：足足大了一倍。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.4BD1385340E3C938.quest_desc: [
		"矿石可以开采成原矿，也可以直接熔炼成锭。"
		""
		"除了常规合成配方，铁锭还能用来制作压缩铁锭。在地上扔些铁锭，然后在附近引爆（例如 TNT 或迷你 TNT）。你会损失大约 20% 的铁锭，但其余的会转化为压缩铁锭！之后，你可以用更高效的方法制作。"
	]
	quest.4BD51E857E3CFC26.quest_desc: ["建造完整的 Chipped 套件：§6植物学家工作台§r、§6炼金术士工作台§r、§6木匠桌§r、§6织布机桌§r、§6石匠桌§r和§6工匠桌§r。涵盖所有材料类别。"]
	quest.4BD51E857E3CFC26.quest_subtitle: "Chipped"
	quest.4BD51E857E3CFC26.title: "完整的工作坊 The Full Workshop"
	quest.4BDA60A93E629E04.quest_desc: [
		"一级方块生成器的高级版本。产量更高！"
		""
		"此区块生成器的速度为 2"
	]
	quest.4BDCE44893B5E2C4.quest_desc: ["你已经掌握了火焰、精华和力量。继续攀登吧。"]
	quest.4BDCE44893B5E2C4.quest_subtitle: "Tier 2 Trial"
	quest.4BDCE44893B5E2C4.title: "学徒试炼"
	quest.4C034DCEC02656A2.quest_desc: ["§6火焰锭§r是由一个铁锭和一瓶火焰血液或火焰眼泪制成的物品。火焰锭具有魔法属性，能使使用它制作的物品获得火焰特性。"]
	quest.4C0B27AEC1BBC826.quest_desc: ["§6基础净化工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.4C0B27AEC1BBC826.quest_subtitle: "额外内容：工厂"
	quest.4C0B27AEC1BBC826.title: "基础净化工厂"
	quest.4C0BCC84EA19B14A.quest_desc: ["点击生物即可捕捉。把它们全部捉住！"]
	quest.4C180332FEA63BB3.quest_subtitle: "ExtendedAE"
	quest.4C1AA8D6EF212081.quest_desc: ["将干橡胶熔炼以制作塑料。"]
	quest.4C5BF6150C71F18C.quest_desc: ["§6白色收集器§r，等级 §e14§r/§e16§r。收集器通过光产生 EMC。等级越高，存储越多，产出越快。"]
	quest.4C5BF6150C71F18C.quest_subtitle: "项目扩展：收藏家们的探险"
	quest.4C5BF6150C71F18C.title: "白色收藏家 [MK 14]"
	quest.4C66F5F9AE000E04.quest_desc: ["§6绝对清洗工厂§r。一种仅限Extras模组的工厂类型，可在最高四个等级中出现。"]
	quest.4C66F5F9AE000E04.quest_subtitle: "额外内容：工厂"
	quest.4C66F5F9AE000E04.title: "绝对清洗工厂"
	quest.4C6B18C8D270A43E.quest_desc: [
		"XNet 是一款专注于效率的物品、流体、能量和信息传输模组。其电缆系统设计得极为简洁，无需额外占用空间。例如，电缆本身并非方块实体，模型也极其简单。这使得通过一根长达 12000 个方块的电缆传输物品，与通过一根 5 个方块长的电缆传输的效率完全相同。"
		""
		"本模组的核心是一个网络。网络本质上是一段由连接器连接的电缆，连接着各种方块（箱子、机器等）和一个控制器。控制器是负责该网络实际工作的方块。"
	]
	quest.4C6B18C8D270A43E.quest_subtitle: "XNet"
	quest.4C6E023AB7291EE5.quest_desc: ["翱翔于天界之上，\"借\"几朵云带回去吧。"]
	quest.4C6E023AB7291EE5.title: "Aerclouds"
	quest.4C72C19719188E39.quest_desc: ["§6Colossal Star Ein§r。便携式EMC电池，巨型EMC电池。容量从§eEin§r到§eOmega§r随尺寸递增。"]
	quest.4C72C19719188E39.quest_subtitle: "项目扩展：更伟大的星辰"
	quest.4C72C19719188E39.title: "Colossal Star Ein"
	quest.4C73BD54224F7CC5.quest_desc: ["使用固体燃料来创造气压。"]
	quest.4C9ADC82F706B417.quest_desc: [
		"炼金术上纯度的黄金。可作为催化剂，使各种炼金术过程得以进行。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.4CAFFE19D6158181.quest_desc: ["压力舱的设置和配方请参阅手册。这些物品足以建造一个3x3x3的压力舱。非常适合初学者！"]
	quest.4CAFFE19D6158181.title: "压力舱室"
	quest.4CB408FAD78D2AD5.quest_desc: ["§6绿色中继器§r，等级 §e10§r，共 §e16§r 级。中继器在方块间传输 EMC 并每秒提供额外收益。等级越高，传输量越大。"]
	quest.4CB408FAD78D2AD5.quest_subtitle: "项目扩展：中继器 (Project Expansion: Relays)"
	quest.4CB408FAD78D2AD5.title: "绿色中继器 [MK 10]"
	quest.4CB6ADD18138ACC6.quest_desc: [
		"出口总线将物品和流体（以及模组添加的任何其他内容）从网络存储中拉取，并推入其接触的背包中。"
		""
		"为了减少延迟，如果导出总线最近没有导出任何东西，它会进入一种“睡眠模式”，此时运行缓慢，并在成功导出某物时醒来并加速至全速（每秒4次操作）。"
		""
		"它们是电缆的组成部分。"
	]
	quest.4CB8D287F34ACC56.quest_desc: ["§bQuantum armor§r boots. Holds ability cards and draws power from your ME network."]
	quest.4CB8D287F34ACC56.quest_subtitle: "高级自动化系统 (Advanced AE)"
	quest.4CC50B32C8780595.quest_desc: ["§6高级合成工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.4CC50B32C8780595.quest_subtitle: "额外内容：工厂"
	quest.4CC50B32C8780595.title: "高级合成工厂"
	quest.4CE5621AB71CE988.quest_desc: [
		"- 将工厂管理器放置在世界中，并使用物品栏电缆将其连接到你的物品栏"
		"将程序磁盘放入管理者的GUI中"
		"- 使用按钮或 Ctrl+V 将脚本粘贴到管理器 GUI 中"
		"- 管理员应该会告诉你脚本已加载成功"
		"将鼠标悬停在磁盘上，查看程序的警告和错误信息"
		"手持标签枪，右键单击管理器，即可从程序中加载标签"
		"- 现在按住 shift 键并滚动鼠标滚轮可以更改活动标签。"
		"- 右键点击世界中的方块以添加或移除标签。"
		"- 还有右键菜单，可以输入自定义标签，即使你的程序里还没有。"
		"- 分配标签后，不要按住 shift 键，右键单击管理器以将标签保存到程序盘中"
		"- 你的程序现在应该可以正常运行了，没有任何问题"
	]
	quest.4CE5621AB71CE988.title: "工厂管理员工具"
	quest.4CE60F732C4426A3.quest_desc: [
		"Super Factory Manager 是一款 Minecraft 模组，允许用户创建程序来运行工厂。该模组提供了一个专门用于移动物品、流体和其他资源类型的领域特定语言。它包含一个文本编辑器以及一些示例程序。"
		""
		"要开始，你需要一个工厂经理、一个标签枪和一个磁盘。请参考项目页面和 GitHub 了解更多信息！"
	]
	quest.4CEC846A1DD5DB84.quest_desc: [
		"模式提供器是自动合成系统与外界交互的主要方式。它们将模式中的材料推送到相邻的背包，物品也可以被放入其中以加入网络。通常，可以通过将机器的输出通过管道送回附近的模式提供器（通常是推入材料的提供器）来保存通道，而无需使用ME导入总线将机器输出拉入网络。"
		""
		"注意，由于它们直接从制造CPU的存储中推送材料，所以它们的物品栏中实际上没有材料，因此无法直接从中引出管道。你需要让提供者将材料推送到另一个物品栏（如桶），然后再从那里引出管道。"
		""
		"另外需要注意的是，提供者必须一次性推入所有材料，不能分批次。这一点可以利用起来。"
		""
		"模式提供者在与子网接口交互时有特殊行为：如果接口未修改（请求槽为空），提供者将完全跳过接口，直接推送到该子网的存储中，不会填充接口，更不会在机器有空位前插入下一批配方。这在阻塞模式下能正常工作，提供者会监控机器中的原料槽，而非接口中的槽位。"
	]
	quest.4CFFA19AA2AA47CD.quest_desc: ["催化剂用于复杂的合成配方。它们在层级越高时，合成难度也越大。"]
	quest.4D1BF4F802916D45.quest_desc: ["一把攻击力为7的剑。"]
	quest.4D1EE9BC7F478C29.quest_desc: ["MekaSuit 的靴子。"]
	quest.4D1EE9BC7F478C29.quest_subtitle: "MekaSuit \& Meka-Tool"
	quest.4D1EE9BC7F478C29.title: "MekaSuit 靴子"
	quest.4D1FA2C2E6FC7A8C.quest_desc: ["允许在不同维度之间使用终端/合成装置。"]
	quest.4D20E887F885154C.quest_subtitle: "附加内容：杂项"
	quest.4D20E887F885154C.title: "至尊电解核心"
	quest.4D210B500F88DC85.quest_desc: ["§6无限粉碎工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.4D210B500F88DC85.quest_subtitle: "额外内容：工厂"
	quest.4D210B500F88DC85.title: "无限粉碎工厂"
	quest.4D25AC81B93F326E.quest_desc: [
		"筛选泥土以获得草籽。将草籽点击在泥土块上可将泥土变为草方块。草籽也可用于制作苔藓。"
		""
		"如果你离得足够远，被动生物会出现在草方块上。刷怪有问题？在JEI里搜“Haven Animal Seeds”吧。"
	]
	quest.4D2DA470DCB74326.quest_desc: ["放置在树木或原木前以生成乳胶。"]
	quest.4D462F76B3844D3D.quest_desc: ["§6Precision Sawmill§r 用于回收木制物品的木材，并以更高的效率将原木制成木板（每根原木6块木板）。还能产生木屑，用于制作纸板箱。"]
	quest.4D4F4BAEA27DC456.quest_desc: ["使用 Empowerer 合成。查看 JEI。"]
	quest.4D4F4BAEA27DC456.title: "赋能水晶 (Empowered Crystals)"
	quest.4D52A465CEFA0C97.quest_desc: ["§6淤泥焦点§r，融合土与风，带来致盲的沙尘效果。"]
	quest.4D52A465CEFA0C97.quest_subtitle: "Ars Elemancy"
	quest.4D530984E49A599C.quest_desc: ["一种注入了RF能量的顶级合成组件。"]
	quest.4D53CCF697772AF5.quest_desc: ["§6绝对回收工厂§r。仅限Extras模组的工厂类型，可在最高四个等级中获得。"]
	quest.4D53CCF697772AF5.quest_subtitle: "额外内容：工厂"
	quest.4D53CCF697772AF5.title: "绝对回收工厂"
	quest.4D595AA2145B3613.quest_desc: ["§6基础合成工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.4D595AA2145B3613.quest_subtitle: "额外内容：工厂（Factories）"
	quest.4D595AA2145B3613.title: "基础合成工厂"
	quest.4D7864A9545508EB.quest_desc: ["§6高级冶炼厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.4D7864A9545508EB.quest_subtitle: "额外内容：工厂"
	quest.4D7864A9545508EB.title: "高级冶炼工厂"
	quest.4DB6A9B473DD4107.quest_desc: ["由10,000个金锭制成"]
	quest.4DBA4D50A7627DA4.quest_desc: [
		"带有升级插槽的 Ender IO 机器需要电容器才能运行。"
		""
		"电容器可以根据其基础修饰符，提升机器的速度、射程或能量存储。"
		""
		"等级：10"
	]
	quest.4DCA7A8D1DC07A09.quest_desc: ["缩小后的生物可以被捕捉。右键点击缩小后的实体，使用§6玻璃瓶§r即可捕捉、携带和释放它们。"]
	quest.4DCA7A8D1DC07A09.quest_subtitle: "缩小"
	quest.4DCA7A8D1DC07A09.title: "将缩小之物装瓶"
	quest.4DDD781A90CA9C86.quest_desc: ["涡轮机的蒸汽输入和能量输出端口。"]
	quest.4DDD781A90CA9C86.quest_subtitle: "多区块结构"
	quest.4DDD781A90CA9C86.title: "涡轮阀门"
	quest.4DE8575D655E8428.quest_desc: ["一种昂贵的锭，用于进入 Project E 和制作其他终局物品"]
	quest.4DEA561D362AD06E.quest_desc: ["§6橙色 EMC 连接器§r，等级 §e13§r/§e16§r。EMC 连接器用于进出口物品、流体和原始 EMC，是 EMC 自动化的核心。"]
	quest.4DEA561D362AD06E.quest_subtitle: "项目扩展：EMC 链接"
	quest.4DEA561D362AD06E.title: "橙色 EMC 链接 [MK 13]"
	quest.4DEFB84692377A2D.quest_desc: ["合成材料。用此材料制成的盔甲可以安抚猪灵。"]
	quest.4DF2DDB5B41DEB0E.quest_desc: ["§6仇恨套索§r能抓住§c敌对§r生物，但前提是它们的血量低于某个阈值。先削弱它们吧。"]
	quest.4DF2DDB5B41DEB0E.quest_subtitle: "生物套索模组"
	quest.4DF2DDB5B41DEB0E.title: "敌对生物套索"
	quest.4DF4CCA612E87BC1.quest_desc: ["在改装站安装的 MekaSuit/Meka-Tool 模块。"]
	quest.4DF4CCA612E87BC1.quest_subtitle: "MekaSuit \& Meka-Tool"
	quest.4DF4CCA612E87BC1.title: "电荷分配模块"
	quest.4DFB541B0D2A9FB9.quest_desc: [
		"众所周知，植物学（Botany）即植物的研究，分支众多。过去，许多植物学家都专注于花朵等植物所具有的神奇特性，例如奇特而纯净的雏菊。"
		""
		"然而，植物学远不止于此，尤其是魔法植物学，因为大自然中不仅有比花朵更多的未知事物，很可能还有世界尚未发现的更强大的东西。"
		""
		"当植物学家研究树木、花卉等的影响时，会发现看似熟悉却本质截然不同的自然机制。研究并理解这些正是魔法植物学的目标。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.4DFB541B0D2A9FB9.quest_subtitle: "自然的气息 (Nature's Aura)"
	quest.4E113EAB18FAA897.quest_desc: ["由10,000个铅锭制成"]
	quest.4E1194AA88D8B433.quest_desc: ["锻造§6Gauntlet of Guard§r，守护者专属的防御手套。"]
	quest.4E1194AA88D8B433.quest_subtitle: "大灾难"
	quest.4E1194AA88D8B433.title: "守护者手套 (Gauntlet of Guard)"
	quest.4E1EE2DDFF343017.quest_subtitle: "开始"
	quest.4E1EE2DDFF343017.title: "消灭兽群"
	quest.4E42850BC99F8844.quest_desc: ["Tier 1. 可存储 100 个物品栏。"]
	quest.4E4C890D02C484F9.quest_desc: ["§6物品抽取器§r会排空经过的装满液体的桶和瓶子，将液体回收回网络中。"]
	quest.4E4C890D02C484F9.quest_subtitle: "创建"
	quest.4E5963DE6C015DFE.quest_desc: ["将金质套索升级为§6水色套索§r，捕捉§b水生§r生物：鱼、蝾螈、海豚和鱿鱼。"]
	quest.4E5963DE6C015DFE.quest_subtitle: "生物套索模组"
	quest.4E5963DE6C015DFE.title: "水蓝色套索"
	quest.4E5D64E959B87554.quest_desc: ["§6跨维度§r自由传送。"]
	quest.4E5D64E959B87554.quest_subtitle: "项目扩展：EMC实用工具包"
	quest.4E5D64E959B87554.title: "神秘炼金术之书"
	quest.4E7EE98930BB17EE.quest_desc: ["§6便携式存储接口§r能让固定库存和移动装置在对接时交换物品。"]
	quest.4E7EE98930BB17EE.quest_subtitle: "创建"
	quest.4E8A216308DE4F60.quest_desc: [
		"带有升级插槽的 Ender IO 机器需要电容器才能运行。"
		""
		"电容器可以根据其基础修饰符，提升机器的速度、射程或能量存储。"
		""
		"等级：3"
	]
	quest.4E8B6A3D2727666F.quest_desc: ["制作一个§6贝壳架§r。贝壳架会添加§5秘术§r，让你更有可能获得§f稀有§r附魔。"]
	quest.4E8B6A3D2727666F.quest_subtitle: "Apothic Enchanting"
	quest.4E8B6A3D2727666F.title: "神秘潮汐"
	quest.4EB47C3E07B444F6.quest_desc: ["使用动物种子基座来制作 Haven 动物种子中的任意一种"]
	quest.4EB47C3E07B444F6.quest_subtitle: "Haven Animal Seeds"
	quest.4F24A4C6468A063A.quest_desc: ["将 Ridiculite 与 Rossinite 再加工获得，Rossinite 是使用 Verderium 作为燃料在反应堆中产生的废料。"]
	quest.4F293ED34904B80D.quest_desc: ["制作一个末地书架。末地书架最多可携带90个永恒，是通往顶级附魔的入口。"]
	quest.4F293ED34904B80D.quest_subtitle: "Apothic Enchanting"
	quest.4F293ED34904B80D.title: "前往末地"
	quest.4F67D41CEFA7A8B0.quest_desc: ["恒星致密的核心，以方便的锭形式呈现。"]
	quest.4F849729CA0DAF2E.quest_desc: ["用筛子可以获得资源！也可以制成粘土块。"]
	quest.4F87D484CF50F980.quest_desc: ["MekaSuit 的腿部护甲。"]
	quest.4F87D484CF50F980.quest_subtitle: "MekaSuit \& Meka-Tool"
	quest.4F87D484CF50F980.title: "MekaSuit 裤子"
	quest.4F9D4A5D5C0B81D0.quest_desc: ["自动生长和收割树木！需要插入一把斧头，并在下方放置漏斗和箱子。"]
	quest.4F9D4A5D5C0B81D0.quest_subtitle: "盆景树 (Bonsai Trees)"
	quest.4FB3C741BA5CDD86.quest_subtitle: "装饰物"
	quest.4FB3C741BA5CDD86.title: "要有光，就有了光"
	quest.4FB596AD930D87D8.quest_desc: ["将不同的物品栏连接到你的简易存储网络！"]
	quest.4FB596AD930D87D8.title: "电缆和连接器"
	quest.4FB61D44C6A7EB44.quest_desc: ["存储组件是所有AE2单元的核心，决定了单元容量。每个等级容量提升4倍，消耗3个上一等级的组件。"]
	quest.4FB6563457D3F5F7.quest_desc: ["§6流体管道§r可将泵连接到储罐、水槽和出水口。使用玻璃或封闭式变体以获得更好的视觉效果。"]
	quest.4FB6563457D3F5F7.quest_subtitle: "创建"
	quest.4FB8374ED3E6F6D2.quest_desc: ["§6终极物流运输机§r。通过网络移动物品。"]
	quest.4FB8374ED3E6F6D2.quest_subtitle: "额外内容：运输系统"
	quest.4FB8374ED3E6F6D2.title: "终极物流运输机"
	quest.4FDB39030DEDA50A.quest_desc: ["每次命中造成20点伤害，没有耐久度，但仍需在背包中携带1支箭。当箭未击中实体时，会在第一支箭周围以AOE形式召唤出10支箭。这些箭每支也造成20点伤害。所有箭几秒后会消失，无法拾取。"]
	quest.4FE0ECC3F0835525.quest_desc: ["突袭堡垒获取燃灯。击败 §e256§r 个烈焰人。"]
	quest.4FE0ECC3F0835525.quest_subtitle: "见习工程师"
	quest.4FE0ECC3F0835525.title: "火中求生"
	quest.4FEFD780FA021473.quest_desc: ["金苹果是一种食用后可获得有益效果（吸收和再生）的食物，也可用于治疗处于虚弱效果的僵尸村民，使其变为普通村民。"]
	quest.50128D820CAB37FF.quest_subtitle: "Apotheosis"
	quest.50128D820CAB37FF.title: "宝石切割"
	quest.50200EBDECAF2A3B.quest_desc: ["一种高科技种植箱，具有能耗、模块槽、肥料支持和增强的自动化能力"]
	quest.50233C3BE23A074A.quest_desc: ["§6Angel Ring§r 模组添加了天使戒指，能让你像创造模式一样飞行，方便建造和旅行。灵感来自 Extra Utilities 的 Angel Ring。"]
	quest.5036B979A09A665F.quest_desc: ["§aMob Lassos§r 能让你把生物装进物品里带到任何地方。 §6Golden Lasso§r 能抓住像牛、羊和鸡这样的 §epassive§r 生物。"]
	quest.5036B979A09A665F.quest_subtitle: "生物套索模组"
	quest.5036B979A09A665F.title: "黄金套索"
	quest.503B6EFB0108A626.quest_subtitle: "晚期"
	quest.503B6EFB0108A626.title: "线路的终点"
	quest.506B2A8271BBE621.quest_subtitle: "额外内容：工厂"
	quest.506B2A8271BBE621.title: "无限结晶化工厂"
	quest.506BB6BF98FB8138.quest_desc: ["燃烧熔岩和燃料，将源生成到附近的罐子中。"]
	quest.506BB6BF98FB8138.quest_subtitle: "Ars Nouveau"
	quest.5073B7267BD701D2.quest_desc: ["连接两个或多个末影储罐来运输和获取流体！使用染料进行颜色编码以配对储罐。"]
	quest.5074057CA6E5B857.quest_desc: ["升级至 §e4§r §6Dank§r 等级。每个等级每种物品的容量都更大，将口袋变成便携式仓库。"]
	quest.5074057CA6E5B857.quest_subtitle: "Dank Storage"
	quest.5074057CA6E5B857.title: "内部比外部大 (Bigger on the Inside)"
	quest.50765C7CF71D6A59.quest_desc: ["末影珍珠是一种可以投掷以传送到落点位置，或用于制作末影之眼（进入末地所必需）的物品。由末影人掉落。"]
	quest.5076C87D6BC2C5BD.quest_desc: ["Mekanism Tools 的 Refined Glowstone 级帕塞尔。"]
	quest.5076C87D6BC2C5BD.quest_subtitle: "Mekanism 工具"
	quest.5076C87D6BC2C5BD.title: "精炼发光石帕塞尔"
	quest.507F2D5C7FC27B08.quest_desc: ["§6高级锯木厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.507F2D5C7FC27B08.quest_subtitle: "额外内容：工厂"
	quest.507F2D5C7FC27B08.title: "高级锯木厂"
	quest.50852ED19616CDB8.quest_desc: ["缓慢地生成黑曜石。"]
	quest.509481AEF61C87B5.quest_desc: ["持有试剂物品。在制作时使用这些物品来激活附魔装置。"]
	quest.509481AEF61C87B5.quest_subtitle: "Ars Nouveau"
	quest.50A188092863FFFA.quest_desc: ["升级卡牌需要使用基础卡牌或高级卡牌底座来制作"]
	quest.50C0A755188A39D3.quest_desc: ["§6紫晶修饰器§r。将它们放入紫晶矿工以进行调整：§e能量§r降低功耗，§e物品§r提高产量，§e速度§r使其运行更快。制作全部三种以获得 §e7§r 级矿工。"]
	quest.50C0A755188A39D3.quest_subtitle: "虚空矿工"
	quest.50C0A755188A39D3.title: "紫水晶修饰器"
	quest.50E86C2C5F2CA963.quest_desc: ["高级AE的背骨金属。被镀层、压制并集成到几乎所有量子设备中。"]
	quest.50E86C2C5F2CA963.quest_subtitle: "高级自动化系统 (Advanced AE)"
	quest.50F59454D604E225.quest_desc: ["将鼠标悬停在物品上并按住 Shift 键以查看属性。"]
	quest.50F9CFFA63793FC3.quest_desc: ["§6无限种植工厂§r。仅限Extras模组的一种工厂类型，可在最高四个等级中获得。"]
	quest.50F9CFFA63793FC3.quest_subtitle: "额外内容：工厂"
	quest.50F9CFFA63793FC3.title: "无限种植工厂"
	quest.5104601D07DF6035.quest_desc: ["§6宇宙合成工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.5104601D07DF6035.quest_subtitle: "额外内容：工厂"
	quest.5104601D07DF6035.title: "宇宙级合成工厂"
	quest.5124714086D19424.quest_desc: ["用绿宝石交换各种种子和树苗！"]
	quest.5124714086D19424.quest_subtitle: "方块脑袋的农场生活"
	quest.5133A804F271D046.quest_desc: [
		"欢迎来到Modular Routers！这是一个非常灵活的模组，能以多种方式将物品运送到世界各地。只需一个方块——物品路由器——和一些插件模块，你就可以："
		""
		"- 从物品栏中取出物品（包括 Storage Drawers 等模组物品栏）"
		"- 将它们发送到附近或远处的其他物品栏中"
		"- 将物品作为方块放置"
		"- 破坏方块"
		"- 将物品丢入世界"
		"- 吸收掉落物品"
		"- 将物品投掷到世界的另一端"
		"- 整理物品（包括一些复杂的筛选器，不仅仅是物品/元数据/NBT匹配）"
		"- 丢弃不需要的物品"
		"- 远程操作你的玩家物品栏"
		"- 伸缩方块线条（活动桥！）"
	]
	quest.5133A804F271D046.quest_subtitle: "模块化路由器 (Modular Routers)"
	quest.5153DD95F93A2BF1.quest_desc: ["§6宇宙粉碎工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.5153DD95F93A2BF1.quest_subtitle: "额外内容：工厂"
	quest.5153DD95F93A2BF1.title: "宇宙粉碎工厂"
	quest.5160093099979CC8.quest_desc: ["升级卡可以改变AE2设备和机器的行为，提高速度、增强过滤能力、启用红石控制等。"]
	quest.516295D16CE018AD.quest_desc: ["喂养冶金催化器。生产 §e1,024§r 富化铁。"]
	quest.516295D16CE018AD.quest_subtitle: "见习工程师"
	quest.516295D16CE018AD.title: "冶金术师"
	quest.5183D0521334BA27.quest_desc: ["裂变反应堆的冷却剂、蒸汽和废料端口。"]
	quest.5183D0521334BA27.quest_subtitle: "反应堆"
	quest.5183D0521334BA27.title: "裂变反应堆端口"
	quest.518837817CC3B489.quest_desc: ["由9块鹅卵石组成！"]
	quest.51938F2731D46972.quest_desc: [
		"将煤炭熔炼以创造石墨。"
		""
		"Extreme Reactors 大量使用多区块机器。多区块机器由许多不同方块组成，你需要在世界上将它们相邻放置。继续完成此系列任务，并参考模组书籍寻求帮助！"
	]
	quest.51A05CB5261270C4.quest_desc: ["§6至尊锻造厂§r。仅限Extras模组的一种工厂类型，可在最高四个等级中出现。"]
	quest.51A05CB5261270C4.quest_subtitle: "额外内容：工厂"
	quest.51A05CB5261270C4.title: "至尊木条加工厂"
	quest.51AC0E98DDB51802.quest_desc: ["§6建筑工具§r让你可以使用多种建筑模式来建造结构。"]
	quest.51B17D757A288506.quest_desc: ["将物质压缩成存储方块，实现紧凑式囤积。"]
	quest.51B17D757A288506.quest_subtitle: "项目扩展：物质（Project Expansion: Matter）"
	quest.51B17D757A288506.title: "物质方块"
	quest.51B3BFB20B56F955.quest_desc: ["§6紫色物质§r，物质等级 §e6§r。用于制作等级 §e6§r 的收集器、中继器、花朵和连接器。"]
	quest.51B3BFB20B56F955.quest_subtitle: "项目扩展：物质（Project Expansion: Matter）"
	quest.51B3BFB20B56F955.title: "紫色物质"
	quest.51B757FA4DB37E84.quest_desc: ["§6手摇柄§r右键点击时会产生短暂的旋转。最早的机械动力来源。"]
	quest.51B757FA4DB37E84.quest_subtitle: "创建"
	quest.51C46499FC3F2F03.quest_desc: ["用骨头、腐肉和幻象膜合成一个§6诅咒之眼§r，以召唤§cMaledictus§r。"]
	quest.51C46499FC3F2F03.quest_subtitle: "大灾难"
	quest.51C46499FC3F2F03.title: "被诅咒之眼"
	quest.51C61DE36D90B959.quest_desc: [
		"将一个模式保持器放入打包器，另一个放入拆包器，两者都连接到ME网络。"
		""
		"包装器会接收物品并将其制成配方包，而拆包器则会将其取出并将物品输出到相邻的背包中。"
		""
		"两台机器会根据模式保持器和包装器向ME网络说明其可执行的操作，连接后包装器会将数据包弹出至网络"
	]
	quest.51D1C30EA83859DA.quest_desc: ["通过配置过滤器来破坏方块或吸收物品，无需子网。"]
	quest.51D1C30EA83859DA.quest_subtitle: "ExtendedAE"
	quest.51E5D8D9B1D67E8C.quest_desc: [
		"灌注铁是一种被光环之力祝福的材料，可用于多种魔法自然物品。注意，使用材料的方块形态也能实现相同的灌注。"
		""
		"有关自然之力的完整详细信息，请参阅《自然之力指南》（指南书）。"
	]
	quest.51FA43329C5128C3.quest_desc: ["将存储组件变为便携式或ME源存储单元的房屋。"]
	quest.51FA43329C5128C3.quest_subtitle: "Ars Energistique"
	quest.522B459DA586F112.quest_desc: [
		"这个种子基底用于制作不同的资源种子。"
		""
		"资源种子是神秘农业的主要用途。这些种子可以生长出超过100种不同资源，包括钻石、骨头、铜、红石等等。收获时，它们都会掉落自己的资源精华，并且有10%的几率掉落受精精华。"
		""
		"资源种子有不同的等级。等级取决于所生长材料的稀有度。"
		""
		"这些种子是使用融合祭坛、材料、精华和种子基底制作的。"
		""
		"这些作物无法使用骨粉催熟，也无法通过按 Shift 键加速生长。"
		""
		"它们可以在地里种植，也可以使用花园钟罩、种植箱或农民，并搭配正确的土壤。"
	]
	quest.523EC60C3C451A3A.quest_desc: ["§6青色物质§r，物质等级 §e9§r。等级 §e9§r 的收集器、中继器、花朵和连接器背后的合成材料。"]
	quest.523EC60C3C451A3A.quest_subtitle: "项目扩展：物质（Project Expansion: Matter）"
	quest.523EC60C3C451A3A.title: "青色物质"
	quest.5256AA3BCD7975B1.quest_desc: ["§6绝对通用线缆§r。传输Forge能量。"]
	quest.5256AA3BCD7975B1.quest_subtitle: "额外内容：运输系统"
	quest.5256AA3BCD7975B1.title: "绝对通用电缆"
	quest.5267E7C6F511B44B.quest_desc: ["外壳既是装饰性方块，也是功能性方块，用于在该模组中制作和建造各种机器与装置。"]
	quest.526E95BD71FA713C.quest_desc: ["大约3560万吨"]
	quest.52777DC278AAF630.quest_desc: ["在存储内部自动将物品压缩成方块形式（例如，将锭压缩成方块）。"]
	quest.52777DC278AAF630.quest_subtitle: "Sophisticated Storage"
	quest.52914F9E85778478.quest_desc: ["用于将液体与固体混合的装置。"]
	quest.52914F9E85778478.title: "再处理器组件"
	quest.52A668C71DD69D71.quest_desc: ["§6宇宙净化工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.52A668C71DD69D71.quest_subtitle: "额外内容：工厂（Factories）"
	quest.52A668C71DD69D71.title: "宇宙净化工厂"
	quest.52AB76818BD22CA3.quest_desc: ["刀是一种普通的近战武器：挥舞速度比剑快，但伤害较低"]
	quest.52B58E5D7BBE7FDA.quest_desc: ["§6Gargantuan Star Sphere§r。便携式EMC电池，游戏中最大的EMC存储设备。容量随尺寸从§eEin§r到§eOmega§r而提升。"]
	quest.52B58E5D7BBE7FDA.quest_subtitle: "项目扩展：更伟大的星辰"
	quest.52B58E5D7BBE7FDA.title: "巨型星体球体"
	quest.52DA34ED57CF502B.quest_desc: ["将骷髅斩首并将其烧成焦黑"]
	quest.52EE429D7056B815.quest_desc: [
		"遵循书中概述的步骤，踏上成为炼金术大师的旅程。"
		""
		"Theurgy旨在为Minecraft引入一种全新的炼金术。它摒弃了“四元素”——风、水、火、土——的传统，而是借鉴古典炼金术，运用硫磺、盐和汞等元素，并通过一系列被称为Spagyrics的过程进行处理。"
		""
		"Theurgy 的首要目标是创造平衡的炼金体验——不像 Equivalent Exchange 那样过于强大，但可能比传奇的 Thaumcraft 更实用。"
	]
	quest.52EE429D7056B815.quest_subtitle: "神学魔法模组 Theurgy"
	quest.52F37674EAB17868.quest_desc: ["§6Aeternalis Fuel§r 是 ProjectE 添加的一种燃料。将 4 个 Mobius Fuel 与一块 Philosopher's Stone 结合，即可创造出这种新燃料。Aeternalis Fuel 的燃烧时间是 Mobius Fuel 的四倍，能够熔炼 512 个物品。"]
	quest.5309DA86AB2B5596.quest_desc: ["存储的物品数量相同，但可以存放两种不同类型的物品！"]
	quest.5310F88053FC3FCD.quest_desc: ["按下 §b量子合金§r。量子护甲和能力卡的基底。"]
	quest.5310F88053FC3FCD.quest_subtitle: "高级自动化系统 (Advanced AE)"
	quest.53117A158D446DFF.quest_desc: ["§6Lime Matter§r，物质等级 §e11§r。用于制作等级 §e11§r 的收集器、中继器、花朵和连接器。"]
	quest.53117A158D446DFF.quest_subtitle: "项目扩展：物质（Project Expansion: Matter）"
	quest.53117A158D446DFF.title: "石灰质物质"
	quest.5332F636657E15EC.quest_desc: ["催化剂用于复杂的合成配方。它们在层级越高时，合成难度也越大。"]
	quest.5343BFCD43ECE225.quest_desc: ["控制电路用于制作多种Mekanism物品和机器。Tier 2。"]
	quest.534D29AB411AB0F5.quest_desc: [
		"要使用框架方块，请执行以下操作："
		""
		"- 用几乎任何实心方块右键点击该方块，使其外观相同。"
		"- 用流体容器右键点击方块，使其看起来像容器中的流体。"
		"- 右键点击发光石粉所在的方块，使其产生光亮。"
		"- 用 Framed Hammer 右键点击方块以移除伪装。"
		"- 用空流体容器右键方块以移除流体伪装。"
	]
	quest.537E84EDD29F486A.quest_desc: ["§6Steeleaf§r 是一种在 Labyrinth、Hollow Hill 和 Dark Tower 的宝箱中找到的工具和盔甲材料。这种材料作为工具或盔甲时的强度与钻石相当，但耐用性甚至低于铁。"]
	quest.5392973FED16D6DF.quest_desc: ["放置一个§6Dank Dock§r，将Dank放入世界。管道和漏斗可以从此处存取物品，实现便携式存储自动化。这里还有第二个船坞，用于构建网络。"]
	quest.5392973FED16D6DF.quest_subtitle: "Dank Storage"
	quest.5392973FED16D6DF.title: "停靠站"
	quest.53AA32A4817FF008.quest_desc: ["深渊的泰坦。用§6深渊祭品§r召唤它，然后击败不可战胜的敌人。"]
	quest.53AA32A4817FF008.quest_subtitle: "大灾难"
	quest.53AA32A4817FF008.title: "利维坦（The Leviathan）"
	quest.53ADBC3ADF1C83C0.quest_desc: ["由10,000个不变合金锭制成"]
	quest.53C589F58BFB0BAF.quest_desc: ["§6至尊压缩工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.53C589F58BFB0BAF.quest_subtitle: "额外内容：工厂"
	quest.53C589F58BFB0BAF.title: "至尊压缩工厂"
	quest.53DDFA5A9F8E055B.quest_desc: ["将投入其中的药水和经验值转化为源。"]
	quest.53DDFA5A9F8E055B.quest_subtitle: "Ars Nouveau"
	quest.53EA498BDFCD9AE3.quest_desc: ["§6无人机港口§r负责派遣无人机进行长途运输。需要使用高级计算引擎、超导体和邪能智能。"]
	quest.53EA498BDFCD9AE3.quest_subtitle: "Oritech"
	quest.53EC26D2780A52A2.quest_desc: ["名称为变量的卡片，让你的逻辑保持井然有序。"]
	quest.53EC26D2780A52A2.quest_subtitle: "Integrated Dynamics"
	quest.53F53BD4220B295B.quest_desc: [
		"前期电力。用煤炭发电（RF）。随着进度推进，还能获得其他发电方式。"
		""
		"注意：前期制作压缩铁，可在铁锭旁引爆爆炸物（TNT加红石信号）。铁锭会转化为压缩铁，平均损耗率为20%。"
	]
	quest.53F53BD4220B295B.quest_subtitle: "Industrial Foregoing"
	quest.53F5A5A785503096.quest_desc: ["用于存储和传输RF能量的物品"]
	quest.5415823E72EF2E93.quest_desc: ["§6高级增压管§r。用于输送气体和化学品。"]
	quest.5415823E72EF2E93.quest_subtitle: "额外内容：运输系统"
	quest.5415823E72EF2E93.title: "高级增压管"
	quest.541A74DE0144E082.quest_desc: [
		"带有升级插槽的 Ender IO 机器需要电容器才能运行。"
		""
		"电容器可以根据其基础修饰符，提升机器的速度、射程或能量存储。"
		""
		"等级：2"
	]
	quest.542ABA63C5122630.quest_subtitle: "Apothic Enchanting"
	quest.542ABA63C5122630.title: "水晶贝壳架"
	quest.542F897E747F5612.quest_desc: ["可施放单个法术的物品。在抄写台为其刻录法术，即可得到一个廉价的专用施法器。"]
	quest.542F897E747F5612.quest_subtitle: "Ars Nouveau"
	quest.543FAEFE24110294.quest_desc: [
		"该装置无需燃料即可为您的ME网络生成能量。由于该装置产生的晶体振动，每个网络中只能使用一个。这些振动甚至可以穿透石英纤维。"
		""
		"生成率：20.0 AE/秒"
	]
	quest.54400DF255CE3A0B.quest_desc: ["自给自足的量子自动合成器。无需CPU集群即可实现大规模并行合成。"]
	quest.54400DF255CE3A0B.quest_subtitle: "高级自动化系统 (Advanced AE)"
	quest.5450D90CA26076F5.quest_desc: ["§6Gargantuan Star Zwei§r。便携式EMC电池，游戏中最大的EMC存储设备。容量从§eEin§r到§eOmega§r的每个尺寸都会提升。"]
	quest.5450D90CA26076F5.quest_subtitle: "项目扩展：更伟大的星辰"
	quest.5450D90CA26076F5.title: "巨型恒星二号"
	quest.5476B23B4B60A670.quest_desc: ["Iron Jetpacks 是一款功能丰富且易于使用的现代喷气背包模组。背包的等级越高，性能越好。线圈是背包制作过程中不可或缺的一部分。请参见 JEI。"]
	quest.5478FE88578437EC.quest_desc: ["利用太阳能（太阳）来产生RF。Tier 3！"]
	quest.5485AE6A649AC6BC.quest_desc: [
		"用于炼金发酵的容器，是物质转化的必需品。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.548F36AD4A633E9D.quest_desc: ["存储组件是所有AE2单元的核心，决定了单元容量。每个等级容量提升4倍，消耗3个上一等级的组件。"]
	quest.5495A4A946E19DAC.quest_desc: ["由 43046721 块鹅卵石组成！"]
	quest.54A51DF726928CE0.quest_desc: ["处理 §e256§r 块精制黑曜石。"]
	quest.54A51DF726928CE0.quest_subtitle: "见习工程师"
	quest.54A51DF726928CE0.title: "驯服易怒的生物"
	quest.54AC69527FD39EF7.quest_desc: [
		"种子再处理器是一种将多余种子转化为精质的机器。"
		""
		"种子处理器需要能量才能运行。你可以通过任何兼容Forge能量的能量传输方式提供能量，或使用内部基于固体燃料的发电机。"
		""
		"可以使用机器升级来升级机器，以实现更快的操作和更大的内部能量存储。"
	]
	quest.54B033D5CF77D965.quest_desc: [
		"比上一级快多了！"
		""
		"将火把放在地上，右键单击以打开GUI。"
	]
	quest.54BBFA6BC53CD1B7.quest_desc: ["可在高级种植箱中用作肥料！也可用于制作覆盖物。"]
	quest.54C1BF4D600DB9EC.quest_desc: ["缩放你的网格，并为任务界面提供 §e10亿§r FE。"]
	quest.54C1BF4D600DB9EC.quest_subtitle: "大师"
	quest.54C1BF4D600DB9EC.title: "Surge"
	quest.54D49D29620140DB.quest_desc: ["锅炉的液体和蒸汽端口。"]
	quest.54D49D29620140DB.quest_subtitle: "多区块结构"
	quest.54D49D29620140DB.title: "锅炉阀门"
	quest.55084772B82D1A0B.quest_desc: ["§6黄铜隧道§r能以可配置的分发模式，将物品在多条传送带之间分叉或循环分配。"]
	quest.55084772B82D1A0B.quest_subtitle: "创建"
	quest.552CCEDED0AE6D5C.quest_desc: ["使用燃料流体来创造气压。"]
	quest.555892B16F56A381.quest_desc: ["制作一个 Salvaging Table，将附魔装备分解成按稀有度分类的 Affix Materials。"]
	quest.555892B16F56A381.quest_subtitle: "Apotheosis"
	quest.555892B16F56A381.title: "回收物资"
	quest.5564E31A353195F0.quest_desc: ["§6至尊洗涤工厂§r。仅限Extras模组，可在最高四个等级中出现。"]
	quest.5564E31A353195F0.quest_subtitle: "额外内容：工厂"
	quest.5564E31A353195F0.title: "至尊洗涤工厂"
	quest.5567D284CB6F01AD.quest_desc: ["You have summoned and slain §cevery horror§r Cataclysm could throw at you. The world is yours."]
	quest.5567D284CB6F01AD.quest_subtitle: "大灾难"
	quest.5567D284CB6F01AD.title: "大灾变征服者"
	quest.557AE0C4DC3F74F6.quest_desc: ["在改装站安装的 MekaSuit/Meka-Tool 模块。"]
	quest.557AE0C4DC3F74F6.quest_subtitle: "MekaSuit \& Meka-Tool"
	quest.557AE0C4DC3F74F6.title: "地热发电机模块"
	quest.5587E29C3AFA70B6.quest_desc: ["升级至 §e4§r §6Dank§r 等级。每个等级每种物品的容量都更大，将口袋变成便携式仓库。"]
	quest.5587E29C3AFA70B6.quest_subtitle: "Dank Storage"
	quest.5587E29C3AFA70B6.title: "内部比外部大 (Bigger on the Inside)"
	quest.558FE9042159159D.quest_desc: [
		"如果缺少其他组件，制作单元可以填充CPU的空间，使其成为实心长方体。它们也是其他组件的基础材料。"
		""
		"合成CPU管理合成请求/任务。在多步骤任务执行期间，它们会存储中间材料，并影响任务规模及完成速度。更多详情请见自动合成。"
		""
		"每个合成 CPU 处理 1 个请求或任务，所以如果你想同时请求一个计算处理器和 256 个平滑石，就需要 2 个 CPU 多区块。"
		""
		"它们可以设置为处理玩家的请求、自动化（导出总线与接口）或两者兼有。"
		""
		"右键点击一个会打开一个制作状态UI，你可以在那里查看CPU正在处理的制作任务的进度。"
	]
	quest.55A12669A448C956.quest_desc: ["§6Digital Miner§r 是 Mekanism 的规模化采矿机。然而，这台机器与众不同，它能将开采的方块“神奇地传送”到其物品栏中。"]
	quest.55A68150572EC898.title: "精炼厂"
	quest.55A816E8EB2D0E2E.quest_desc: ["由 531441 块鹅卵石组成！"]
	quest.55D712DF4FD62578.quest_desc: ["升级至 §e4§r §6Dank§r 等级。每个等级每种物品的容量都更大，将口袋变成便携式仓库。"]
	quest.55D712DF4FD62578.quest_subtitle: "Dank Storage"
	quest.55D712DF4FD62578.title: "内部比外部大 (Bigger on the Inside)"
	quest.55EC62499FA962EA.quest_desc: ["装备§6个人缩小装置§r并开启以缩小自己。缩小到§e微型§r状态后领取此任务。"]
	quest.55EC62499FA962EA.quest_subtitle: "缩小尺寸"
	quest.55EC62499FA962EA.title: "变小去冒险"
	quest.56002C75403F4480.quest_desc: ["Mekanism Tools 的钢制护腿。"]
	quest.56002C75403F4480.quest_subtitle: "Mekanism 工具"
	quest.56002C75403F4480.title: "钢制护腿"
	quest.560B96E29FB0B9FA.quest_desc: ["§6高级电动泵§r。比普通泵抽液速度快得多。"]
	quest.560B96E29FB0B9FA.quest_subtitle: "附加内容：杂项"
	quest.560B96E29FB0B9FA.title: "高级电动泵"
	quest.562821503FB3426F.quest_desc: ["§6Radiance Alloy§r。用于高级电路的高阶 Extras 合金。"]
	quest.562821503FB3426F.quest_subtitle: "附加内容：杂项"
	quest.562821503FB3426F.title: "光辉合金"
	quest.5629109B44D3766A.quest_desc: ["QIO 存储驱动器。更高级别的驱动器可容纳更多种类和数量的物品。"]
	quest.5629109B44D3766A.quest_subtitle: "QIO 网络"
	quest.5629109B44D3766A.title: "超大质量驱动器"
	quest.563EF0C91E88B0D5.quest_desc: ["在草地上种植以生长出猪。确保给它足够的生长空间。"]
	quest.566041739730D509.quest_desc: ["铁质桶：比铜质桶有更多的行和升级槽。"]
	quest.566041739730D509.quest_subtitle: "Sophisticated Storage"
	quest.56718D2CB87DF305.quest_desc: [
		"压缩锤可以锤击压缩方块！"
		""
		"用锤子砸碎方块。Cobblestone -> Gravel, Gravel -> Sand, Sand -> Dust, Netherrack -> Crushed Netherrack, End Stone -> Crushed End Stone, Cobbled Deepslate -> Crushed Deepslate, Blackstone -> Crushed Blackstone, Crushed Netherrack -> Red Sand. 之后可以用机器自动化。现在，矿脉挖掘和建造棒是你的好帮手。"
		""
		"试着用木槌敲击原木来获得木屑——非常适合堆肥！"
	]
	quest.5675512404BF2759.quest_desc: ["一个三格位的压缩抽屉。"]
	quest.56772ECF0B3C75CE.quest_desc: ["升级后的机器框架使用溶解室制作。参见JEI。需要粉色史莱姆，可从生物屠宰厂获取。"]
	quest.567E3DB67F4F025C.quest_desc: ["烹饪后的食物能提供更多营养！"]
	quest.567E3DB67F4F025C.quest_subtitle: "烹饪食物，我的世界"
	quest.567E3DB67F4F025C.title: "烹饪食物"
	quest.567EA6F53C2AB8D2.quest_desc: ["合成材料，击杀烈焰人即可获得。"]
	quest.56A2E5BCEAC34C1F.quest_desc: ["§6高级净化工厂§r。可同时处理多种物品。更高等级会增加更多槽位和速度。"]
	quest.56A2E5BCEAC34C1F.quest_subtitle: "额外内容：工厂"
	quest.56A2E5BCEAC34C1F.title: "高级净化工厂"
	quest.56A609B58D0FA6C0.quest_desc: [
		"仅适用于原版方块，耐久度为1。"
		""
		"用魔杖右键点击方块 → 它会变成一个 Enlivened Block 实体。"
		""
		"被激活的实体可被其他模组捕获/复制，从而提供该方块的可持续来源。注意：若生成器不复制NBT，此方法无效。"
		""
		"使用生物囚禁工具作用于你的新实体，并在工业前序生物复制器中进行复制。"
	]
	quest.56A94DAFCAD45B09.quest_desc: ["制作一个§6植物学家工作台§r。每个刻面工作站都会打开一个包含数百种外观变体的目录，适用于某一类材料。"]
	quest.56A94DAFCAD45B09.quest_subtitle: "Chipped"
	quest.56A94DAFCAD45B09.title: "Chipped Workbench"
	quest.56AEDCDC723C22F6.quest_desc: ["§6Bedrock Extractor§r 挖掘基岩以产出稀有资源。需要 Duratium、Heisenberg Compensator 和 Overcharged Crystal。"]
	quest.56AEDCDC723C22F6.quest_subtitle: "Oritech"
	quest.56C64C2B2A2EE15F.quest_desc: ["九块晶化曼里尔块已压缩。用于存储和制造大型设备的材料。"]
	quest.56C64C2B2A2EE15F.quest_subtitle: "Integrated Dynamics"
	quest.56CA2BD982503BB0.quest_desc: ["用末地之眼填充蛋糕。需要高级工作台才能制作。"]
	quest.56CA2BD982503BB0.quest_subtitle: "众神之神"
	quest.56CA2BD982503BB0.title: "进入末地"
	quest.56E6564F39FC9864.quest_desc: ["制作一个§6Dank§r，这是一种便携式存储设备，可将数十种物品的多个堆叠整合到一个紧凑的背包中。Tier §e1§r规模不大，但可以快速扩展。"]
	quest.56E6564F39FC9864.quest_subtitle: "Dank Storage"
	quest.56E6564F39FC9864.title: "口袋储物箱"
	quest.56E6CB368A75610E.quest_desc: ["制作一个§6Dank§r，这是一种便携式存储设备，可将数十种物品的多个堆叠整合到一个紧凑的背包中。Tier §e1§r规模不大，但可以快速扩展。"]
	quest.56E6CB368A75610E.quest_subtitle: "Dank Storage"
	quest.56E6CB368A75610E.title: "口袋储物箱"
	quest.56E9EC4ECE3113B7.quest_desc: ["§6机械活塞§r可推动所附装置沿直线移动。与底盘结合可移动方块群。"]
	quest.56E9EC4ECE3113B7.quest_subtitle: "创建"
	quest.56F4EB239C973603.quest_desc: ["§6Modification Station§r 将模块安装到 Meka-Tool 和 MekaSuit 中。"]
	quest.56F4EB239C973603.quest_subtitle: "MekaSuit \& Meka-Tool"
	quest.56F4EB239C973603.title: "修改工作台"
	quest.570BE7D3659C6BB0.quest_desc: ["建立一个能将你的主基地连接到所有维度的Mekanism传送门网络。"]
	quest.571814A9A148A680.quest_desc: ["刀刃捕捉蒸汽。刀刃越多，动力越强。"]
	quest.571814A9A148A680.quest_subtitle: "多区块结构"
	quest.571814A9A148A680.title: "涡轮叶片"
	quest.5720FF9BB1596CA1.quest_desc: ["电池用于储存RF。可用于机器和为物品充电。悬停每个电池等级可查看容量和I/O速度。"]
	quest.5735F3DABF096132.quest_desc: ["将液态塑料放置在世界中，使其硬化成塑料板。"]
	quest.573FB7A2379800A5.quest_desc: ["让游戏后期不那么痛苦所需的步骤之一"]
	quest.573FB7A2379800A5.quest_subtitle: "神秘农业 (Mystical Agriculture)"
	quest.576F87C59A3DEA24.quest_desc: ["燃烧熔岩和燃料以提供稳定电力，可与§6燃料木加热器§r搭配使用。"]
	quest.576F87C59A3DEA24.quest_subtitle: "生成器"
