	quest.6D079323AB52885B.quest_subtitle: "高级自动化系统 (Advanced AE)"
	quest.6D1640B0CC4ADAF6.quest_desc: [
		"特色功能："
		""
		"- 多区块建造：使用砖块、熔炉、排水口和窗户等各种方块，建造自己的熔炉，打造一套功能齐全的冶炼装置。"
		"- 高效熔炼：熔炉比传统熔炉熔炼矿石的速度更快，让你可以同时处理多种矿石，并用更少的燃料生产出更多的锭。"
		"- 铸造：熔炉拥有铸造系统，可将熔化的金属倒入铸模中，打造出锭、方块或其他金属物品，为制作和资源管理增添了新的深度。"
		"- 可自定义设计：熔炉的大小和布局均可自定义，所有16种颜色的熔炉块均可与你的基地相匹配。"
	]
	quest.6D16777C65BCA017.quest_desc: [
		"Sophisticated backpacks 是又一个背包模组，这次你可以在世界中放置背包，用不同颜色组合染色，用更多物品栏升级，并用许多功能性升级来增强。"
		""
		"可通过按键访问（默认为 B 键）。"
		""
		"配件兼容性使得将背包放入“背部”槽位时，可以穿戴和渲染背包。"
		""
		"每个等级都会增加更多的存储栏位和升级栏位。"
	]
	quest.6D16777C65BCA017.quest_subtitle: "Sophisticated Backpacks"
	quest.6D3A89842423C783.quest_subtitle: "晚期"
	quest.6D3A89842423C783.title: "至高的丰收"
	quest.6D4635B37C54B16A.quest_desc: ["§6至尊化学储罐§r。用于储存气体、浆料和其他化学品。"]
	quest.6D4635B37C54B16A.quest_subtitle: "额外内容：储物空间"
	quest.6D4635B37C54B16A.title: "至尊化学储罐"
	quest.6D594671ED743839.quest_desc: ["控制电路用于制作多种Mekanism物品和机器。Tier 4。"]
	quest.6D73A75D85AB43AE.quest_desc: [
		"利用红物质的力量，将红物质锤、红物质镐和红物质铲的功能整合到一把工具中。"
		""
		"红晨星可以快速采集地下的大部分方块（左键点击）。"
		""
		"和红物质镐一样，它也能单次操作（右键）采集一整条矿脉。"
		""
		"和红物质锤子一样，它可以根据充能等级收割一片区域内的所有方块。"
		""
		"和红物质铲一样，它会根据充能情况收割一大片泥土，或者一整条砾石矿脉。"
	]
	quest.6D73B59E96D6C032.quest_desc: ["杀死一头牛并烹饪其肉以获得牛排"]
	quest.6D73B59E96D6C032.quest_subtitle: "Minecraft"
	quest.6DA1F71A6E40CF8B.quest_desc: ["使用简单的烹饪系统和一些熟悉的食材，农夫乐事让你能准备各种各样的丰盛美食：从三明治到沙拉和炖菜，从精美的甜点到令人垂涎的盛宴，厨房里不会有任何食材被遗忘！"]
