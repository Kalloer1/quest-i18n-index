					item: "apotheosis:rare_material"
					type: "item"
				}
			]
			subtitle: "&5&o追求不寻常的附加属性</c2></c1>"
			tasks: [{
				advancement: "apotheosis:affix/rare_gem"
				criterion: ""
				id: "58D59875E0A4B562"
