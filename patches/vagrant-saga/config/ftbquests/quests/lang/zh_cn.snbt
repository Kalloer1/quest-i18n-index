	quest.7FA48611AFFCF4CB.title: "雨伞"
	quest.7FC0A68D731B1796.quest_desc: [
		"装备套装的部分或全套装备可以提供若干增益效果"
		""
		"例如，套装的2个部件可以提供+2生命值，而全套则可以提供+6"
		"套装中的某些部件包含一把武器或必须手持于副手的物品"
	]
	quest.7FF27A2AEAD5A672.quest_desc: [
		"要认领区块，请打开地图（默认键为 &cM&r），点击左上角的已认领区块图标，然后左键点击一个区块进行认领。右键点击可取消认领。"
		""
		"要创建队伍，请在物品栏界面点击左上角的 &c队伍图标&r，然后将玩家添加到你的队伍中。"
		""
		"要随机传送（rtp），请使用 &c/trigger darkrtp&r"
		"如果你被困住，请使用 &c/trigger darkdeath&r（立即杀死你）或 &cdarkspawn&r（将你传送到世界出生点）"
		""
		"要查看你的技能，请使用 &cK&r 键"
	]
