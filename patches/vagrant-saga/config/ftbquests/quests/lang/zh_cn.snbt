	quest.3A21C1DD3F351EAB.quest_desc: ["制作机械之眼，用于寻找利维坦"]
	quest.3ABC376A5B3CA26E.quest_desc: ["在“末地”的圆形竞技场中击杀庇护者，用TNT炸掉它的护盾，并在它暴露时进行攻击"]
	quest.3ABC376A5B3CA26E.quest_subtitle: "在召唤祭坛上使用下界之星来召唤庇护者"
	quest.3ABC376A5B3CA26E.title: "击杀庇护者"
	quest.3B367B197438601C.quest_desc: ["获得风暴之刃，像闪电一样冲刺"]
	quest.3C012D71A44C914C.title: "生命汁液"
	quest.3CB834647CE59C74.quest_desc: [
		"用莫尔凯特填充，然后右键点击即可获得一把快速的多功能工具"
		""
		"你可以用稀有材料升级钻头，例如卡莫特石（时运额外加成）和普罗米修姆花束（自动修复被动效果）"
	]
	quest.3D01A0CD7DECB05B.quest_desc: ["阅读暮色森林章节以获取更多信息……"]
	quest.3D896B541475DA04.title: "皇家加冕礼"
	quest.3DC4AD73C4A9B5BF.quest_desc: ["清除所有负面效果"]
	quest.3E64A74CC55FC7DF.quest_desc: [""]
	quest.3F05BF65B716C67E.quest_desc: [
		"部署器可以充当假玩家，用于右键点击和左键点击。"
		""
		"遗憾的是，它无法通过Shift键快速点击来移动物品"
	]
	quest.3F1CBB7E60BE2736.quest_desc: ["获得冰语者"]
	quest.3F3748C4D2A3C520.quest_desc: ["在可疑的沙中找到沙漠项链"]
	quest.3F5910EFF08D4AB0.quest_desc: [
		"类似于不死图腾，但有冷却时间"
		""
		"在濒死时会留下一个苦力怕的爆炸"
		"提供火焰抗性、生命再生和护盾吸收效果"
	]
	quest.3F865CB1B3C8EE7B.title: "被遗忘的人性"
	quest.4057ACD1CBC438E5.quest_desc: ["获得传说中的“剑柄”！"]
	quest.4067CAB8C85AEBE7.quest_desc: ["一个能够发射爆炸物并召唤各种下界生物来协助战斗的Boss。"]
	quest.40885BD4B47360D6.quest_desc: ["放置灌注祭坛，并用6根祭坛柱（每根3个）将其环绕，然后在每根柱子上放置一个祭坛尖顶。最后，用金块填满所有的祭坛柱。"]
	quest.40885BD4B47360D6.quest_subtitle: "制作用于吸血鬼 5-14 级的灌注祭坛"
	quest.40885BD4B47360D6.title: "制作灌注祭坛"
	quest.40DE612DB7DD5F9D.quest_desc: ["只需靠近你已经放置好的盔甲架，然后使用指令 &l/trigger armorstandarms&r，它就会为你生成手臂。请确保你与盔甲架的距离不超过 3 个方块。"]
	quest.4165DFB55A326D26.title: "优雅之道"
	quest.426031EA29D48787.title: "硫磺花蜜"
	quest.431F65615EC0B82E.quest_desc: ["保存你的后期游戏配置。这样你就可以在不同整合包中加载它们。你可以在 instances/modpackname/schematics 中找到已保存的结构图。"]
	quest.431F65615EC0B82E.title: "选择区域并保存"
	quest.433F5A2621C89D9C.quest_subtitle: "吸引物品！"
	quest.434CF27AA953319F.quest_desc: ["击败末影龙以获得龙鳞，并制作龙鳞盔甲和工具。"]
	quest.434CF27AA953319F.title: "龙之传说"
	quest.4376F611C069BF41.quest_desc: ["一个能够蓄力并使用腹鼓来提升力量的首领。"]
	quest.43871741B9452CE1.title: "Geckotoa"
	quest.4392AAD5570CAA23.quest_desc: ["对敌人施加 0.5 秒的冰冻效果"]
	quest.43A297BF817DC0A9.title: "地狱蝙蝠"
	quest.43CB316D10806693.quest_subtitle: "“冠军坚韧”与“无上复仇”套装的一部分"
	quest.44144DB465A43A62.quest_desc: [
		"在丛林金字塔中找到"
		""
		"据说这只眼睛赋予了我们祖先红石知识"
	]
	quest.4429921F7893A98A.quest_desc: [
		"使用水生物品制作它"
		""
		"追随这只眼睛的人再也没有出现过；有传言说他们找到了伟大的亚特兰蒂斯城，或是在寻找时迷失了方向"
	]
	quest.4439AA65A8C639AE.quest_desc: [
		"图腾模组的核心在于图腾柱、自然以及音乐的力量。"
		""
		"其重点在于图腾柱。它们能为附近的玩家提供被动增益，但更重要的是，它们是仪式的核心：围绕图腾柱跳舞并演奏各种乐器，以引发强烈效果并操控世界。"
	]
	quest.44B66C501013E9BD.quest_desc: ["击杀 20 名吸血鬼男爵，获取升级所需的纯净血液。"]
	quest.45282B378CBB9457.quest_desc: ["击杀生物后获得额外且更优质的战利品！"]
	quest.4550219254877A7C.quest_desc: [
		"概览"
		"深境是一个 1 级维度。从深境出发，玩家可以进入晶域。"
		""
		"进入方式"
		"该维度的深境界石可通过在末地表层挖掘矿石获得，同时玩家的物品栏中需含有空白界石。"
	]
	quest.45B7DDA8A478ED0F.quest_desc: [
		"提供矿工护盾"
		""
		"矿工护盾会对敌人施加 1.5 秒的挖掘疲劳效果。"
	]
	quest.47254D6445EA760C.title: "火焰之墓"
	quest.47412F94B78F7DB9.quest_desc: ["&a可重复&r"]
	quest.4797BD50D9071863.quest_desc: ["生成于绯红森林的 Y=0 至 Y=32 之间（主要在 Y=16）。"]
	quest.47A565ED1460E2E4.quest_desc: [
		"现在你可以制作不同类型的面包，并在食用后获得持续时间更长的状态效果。"
		""
		"点击“面包种类”章节以了解更多信息。"
	]
	quest.47AF63F1BC035A9A.quest_desc: [
		"有 10% 的几率生成于堡垒遗迹中。"
		"在宝箱中出现的几率为 50%。"
	]
	quest.47D2EEAFB5ABF3B7.quest_desc: [
		"枪"
		""
		"使用火焰法术击杀生物可获得烧焦之物。"
	]
	quest.47F4385EF5992A33.quest_subtitle: "游戏中最好的镐。"
	quest.4883EE3FD3FEB319.quest_desc: ["在 Y=-64 至 Y=32 之间的沙漠中生成（主要在 Y=-16）"]
	quest.49133CFAF5DC3CDE.quest_desc: ["在末地维度 Y=0 至 Y=32 之间生成（主要在 Y=16）"]
	quest.493569A569009BA3.quest_desc: [
		"概览"
		"L'Borean 是一个 3 级维度，也是从 Precasia 开始的进化链中的最后一个维度。"
		""
		"进入方式"
		"前往此维度的 Borean 界石，需要通过将一只 Gardencia 生物引诱到糖果水中，然后将其击败来获得。"
	]
	quest.493B5B1E7EF014AA.title: "符文石板"
	quest.495E1DA7D26E3C31.quest_desc: [
		"这些石板无法重复兑换，它们的作用是让玩家在坐骑未生成时也能拥有坐骑。"
		""
		"你可以对坐骑使用召唤杖来束缚它。"
		"这样你就能在使用召唤杖时传送你的坐骑，或者用它来指挥坐骑执行指令（坐下、跟随或游荡）。"
	]
	quest.49D114932D0B996B.quest_desc: ["阅读《暮光森林》章节以了解更多信息……"]
	quest.49DC62A750ED8B71.quest_desc: [
		"在 Nocturnus 这片暗影领域中，暮光永远笼罩着大地，那里住着一位黑魔法师，他的名字甚至能让最勇敢的灵魂心生恐惧。"
		""
		"Ravenlocke，曾是一位备受尊崇的奥术学者，却被对禁忌知识永不满足的渴望吞噬。他踏入黑暗深渊的旅程，始于那本禁忌之书——《幽影秘典》。随着他不断深入研读，Ravenlocke 解开了早已被遗忘的奥术秘密，从阴影的本质中汲取力量。"
		""
		"{@pagebreak}"
		""
		"Ravenlocke 的最终目标是掌握死灵术——这门最黑暗的艺术。他企图召唤一支受他意志支配的不死军团，统治诺克图努斯乃至更广阔的领域。但他的野心并未止步于此。传说曾预言，一位黑暗法师终将崛起，超越凡人的界限，成为黑暗之神。Ravenlocke 坚信自己就是预言中的那个人，并以不懈的决心追寻这一命运……"
	]
	quest.49DC62A750ED8B71.quest_subtitle: "黑暗法师"
	quest.4A7B8115AD4E8184.quest_desc: ["阅读《暮光森林》章节以获取更多信息……"]
	quest.4AC05265DFA77DA8.quest_desc: ["获得“守望者”"]
	quest.4B131E02F97B84EE.quest_subtitle: "原始以太矿可在末地城的箱子中找到"
	quest.4B841A2D9DB2181B.quest_desc: [
		"精英头目是现有头目的升级版，拥有更高的属性和修改后的行为模式。"
		""
		"精英头目可通过在头目祭坛上使用相应普通头目的金杯来召唤。召唤精英头目不会消耗金杯。"
	]
	quest.4BD19451C8245ED9.quest_desc: ["将钻石铲放在你的副手栏（按 F），然后使用指令 &l/trigger flight&r 开始悬浮。当状态效果消失后，你可以再次使用该触发指令。"]
	quest.4BE00074BCE57EE1.quest_desc: ["你可以吃掉这个"]
	quest.4C2752FFFB094761.quest_desc: ["DarkMenu 会更改主菜单文本（类似于 DarkRPG），并添加一个类似《黑暗之魂》的死亡界面。"]
	quest.4CD410A2D9BE1104.quest_desc: ["获取荆棘刺并毒害你的敌人"]
	quest.4D3D0F8DE0546B64.quest_desc: ["生成于末地，Y 坐标在 0 到 32 之间（主要在 Y=16）。"]
	quest.4D5C96B6EF862A18.quest_desc: ["+2 护甲"]
	quest.4DBEFF0D3E4E2FEB.quest_desc: [
		"欢迎来到《流浪传奇》，一个充满魔法、探索与神秘的世界……"
		""
		"本指南旨在帮助你了解我们核心模组的基础知识，并提供一些可供完成的挑战。"
	]
	quest.4DBEFF0D3E4E2FEB.quest_subtitle: "指南由 Cthulu's Lawyer 和 SnowTheArcticFox 制作。"
	quest.4DBEFF0D3E4E2FEB.title: "欢迎来到《流浪传奇》！"
	quest.4DC65B6607DCD7D2.quest_desc: ["在背包中持有腐败遗物时，被监守者的音波冲击击中即可获得魔能镰。"]
	quest.4DFACD903C60E581.quest_desc: ["将许愿宝石放在副手，即可通过权杖或卷轴施放法术。"]
	quest.4EB31C928AF262B3.quest_subtitle: "经典版"
	quest.4EC1E4F1F5FC0D82.quest_desc: [
		"如果你的出身地因此受到伤害，它能保护你免受雨和太阳的伤害。"
		"它可以染色。"
		""
		"可用 3 块皮革以箭头形状置于顶部、两根木棍沿中间向下排列的方式合成。"
	]
	quest.4EC1E4F1F5FC0D82.title: "雨伞"
	quest.4EFE2478BEC64FE0.quest_desc: ["将服务器中玩家的睡眠百分比更改为 50%，这样你就不必担心挂机玩家不睡觉了。"]
	quest.4F20A6D221016D0C.quest_desc: ["使用沙漠项链唤醒远古遗骸"]
	quest.4F20A6D221016D0C.quest_subtitle: "击杀远古遗骸"
	quest.4F20A6D221016D0C.title: "死亡，它总能找到出路"
	quest.4F30AB375DB637B3.quest_desc: ["将背包中的储水罐装满水"]
	quest.4F64CFF4FE29B482.quest_desc: ["通过击杀被点燃的亡灵来获取燃烧灰烬"]
	quest.4F92E979195A652E.quest_desc: [
		"在堡垒的宝箱中找到"
		""
		"一件强大而又具有破坏性的神器；猪灵曾发誓不惜生命代价也要保护它"
	]
	quest.4FC7CD52B4C855DB.quest_desc: ["获取妙尔尼尔"]
	quest.504D53408DED34C5.quest_desc: [
		"在埋藏的宝箱中找到"
		""
		"海盗们说，它赋予了传奇的黑珍珠号视力"
	]
	quest.508BC25D8292023B.quest_desc: ["要开始，你首先需要创建一个传送门进入暮光森林，完成后就可以开始探索了！"]
	quest.508F270269978AE1.quest_desc: [
		"另一种二级锻造材料是海晶块"
		""
		"一次熔炼 2 个，产出 4 个锭"
	]
	quest.508F270269978AE1.quest_subtitle: "二级"
	quest.508F270269978AE1.title: "双输或无赢。"
	quest.50F0E5E6DEE5B26F.quest_desc: ["获取余烬之刃并射出炽热的弹片"]
	quest.515D8A6A2F7226C0.title: "经验值不足"
	quest.51F02EBB204690B2.quest_desc: ["为背包添加一个合成台"]
	quest.51F02EBB204690B2.title: "随时随地合成"
	quest.523756F8A7160D12.quest_desc: ["获取 Caelitis"]
	quest.527146451B3C0516.quest_desc: ["使用下方的配方制作速度棒，或在 EMI/JEI 中搜索面包，然后点击香草木棍图标查看配方。"]
	quest.527146451B3C0516.title: "速度棒"
	quest.52DE33767B49D20F.quest_desc: ["通过制作并使用绽放之眼来召唤米科拉什"]
	quest.52DE33767B49D20F.title: "击杀噩梦之主米科拉什"
	quest.53CAE65755B983ED.quest_desc: ["你可以攀爬墙壁"]
	quest.53CAE65755B983ED.quest_subtitle: "蜘蛛侠！！"
	quest.53D4B9FBE487BD5F.quest_desc: ["别飞得太靠近太阳"]
	quest.53D4B9FBE487BD5F.title: "蜡制翅膀"
	quest.544108F0DC986104.quest_desc: ["与猪灵交易点金石金块，有几率让它们给你附魔的点金石金块"]
	quest.544B1DBE4922CFFF.quest_desc: [
		"传送石是让你瞬间从 A 点到达 B 点的绝佳方式"
		""
		"使用经验值，你可以从一个传送石传送到另一个传送石"
	]
	quest.548CD78F6509D03E.quest_desc: [
		"每 30 分钟，你将从以下列表中随机获得一件物品并添加到你的物品栏中。当物品奖励发放给你时，会显示一条消息。"
		"{@pagebreak}"
		"每 30 分钟随机发放的可能物品列表：-"
		""
		"4x 熟兔肉"
		"4x 熟鳕鱼"
		"5x 熟三文鱼"
		"6x 烤马铃薯"
		"4x 熟猪排"
		"3x 南瓜派"
		"3x 兔子炖菜"
		"4x 粉色羊毛"
		"2x 甜瓜"
		"8x 苹果"
		"1x 钻石"
		"6x 雪球"
		"4x 粘液球"
	]
	quest.54944984CC548479.quest_desc: [
		"使用你已有的狼牙棒制作不同类型的狼牙棒。每种狼牙棒都有独特的效果。"
		""
		"你也可以用 3 个铁锭将你的新狼牙棒转换成原版狼牙棒。请查看下方的合成配方。"
	]
	quest.54CD1EFB7587AA0B.title: "永光"
	quest.54E8DCB92F9EFD2C.quest_desc: [
		"使用下方的配方制作不同类型的面包，或在 EMI/JEI 中搜索面包，然后点击原版面包图标查看配方。"
		""
		"制作 POG 面包，因为它太棒了！"
	]
	quest.551198764E52DF28.quest_desc: [
		"按下 L 键并点击书籍图标 (DarkQuesting) 查看基于进度的任务。你也可以像往常一样正常游戏，途中会自动完成各种任务。"
		"还包含一个赌场！更多信息请查看赌场章节中的苦力怕赌场。"
	]
	quest.5531559B3CB154E6.quest_subtitle: "奥术智慧套装的一部分"
	quest.5554220CF5AB569B.quest_desc: ["获取硫磺阔剑，用爆炸性的硫磺轰击你的敌人"]
	quest.557040E1BEC8704F.quest_desc: ["提供速度 III 和跳跃提升 III"]
	quest.55A4187C1656DFB8.title: "信使鸟"
	quest.55F49FEAC6CE1758.quest_desc: ["像海绵一样，将水收集到背包水箱中（需要有空水箱才能生效）"]
	quest.56F766337FCCEBF4.quest_desc: ["对 Mr Crayfish 的家具物品来说是个有用的工具……"]
	quest.5848CF34C09530AD.quest_desc: [
		"站在钻石块上，然后交替使用主手和副手中的钻石（按 F），即可将物品收入你的背包。每次消耗 5 颗钻石。"
		""
		"以下是你可以赢得的物品列表："
		""
		"45x 腐肉"
		""
		"2x 不死图腾"
		""
		"1x 末影水晶"
		""
		"1x 鞘翅"
		""
		"10x 海绵"
		""
		"1x 下界之星"
		""
		"1x 下界合金剑"
		""
		"1x 下界合金镐"
		""
		"{@pagebreak}"
		""
		"6x 下界合金锭"
		""
		"25x 金锭"
		""
		"45x 铁锭"
		""
		"5x 钻石矿石"
		""
		"5x 青金石"
		""
		"10x 附魔金苹果"
		""
		"1x 海洋之心"
		""
		"45x 烟花火箭"
		""
		"3x 灰色潜影盒"
		""
		"1x 石头"
	]
	quest.58981A25454BD5C9.quest_desc: ["一排带有金属挂钩的横杆，可用于悬挂兽尸。让屠宰工作变得更轻松，尤其是处理大型生物时。"]
	quest.594B7CDA3BE12818.quest_subtitle: "喂食时间"
	quest.594B7CDA3BE12818.title: "猪刷怪点"
	quest.59A277C4605E23D7.quest_desc: ["已获得的头颅……"]
	quest.5A0C91B49F99672C.title: "从储物开始"
	quest.5A24E02EA279E320.quest_desc: ["手持“希望宝石”时被闪电击中"]
