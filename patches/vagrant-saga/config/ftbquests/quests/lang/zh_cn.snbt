	quest.25FEF5A5DE0D3583.title: "铜制时装"
	quest.261840F62D1C1418.quest_desc: ["蓝宝石工具的攻击力更高，能造成相当于敌人最大生命值 +3% 的伤害"]
	quest.2621298771394DB4.title: "一个可以睡觉的地方"
	quest.26447421BEC27859.quest_desc: ["用图腾顶部和图腾底座建造一个吸血鬼村庄"]
	quest.26447421BEC27859.title: "达到吸血鬼等级 14"
