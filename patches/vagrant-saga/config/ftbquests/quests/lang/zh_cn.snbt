	quest.6888AEC387D11E0F.quest_subtitle: "蛋糕是假的"
	quest.689E484E5F251CE0.quest_desc: [
		"概览"
		"巴拉托斯是一个一级维度，是两个维度链中的第一个。从巴拉托斯，玩家可以进入伊罗明。"
		""
		"进入"
		"巴拉托斯界石 巴拉托斯界石是通过玩家在手持空白界石时击败一只尸壳获得的。"
	]
	quest.68ADE7D6A95090FF.title: "航行"
	quest.68AE2DD9109311EA.title: "危险之路"
	quest.68B9AEDEA56A8E2A.quest_desc: ["制作用于寻找古代残骸的沙漠之眼"]
	quest.68D06733F4F3411D.title: "牛排"
	quest.68D909A9123613F2.quest_desc: [
		"欢迎来到：禁忌与秘法。"
		"充满魔法内容，以及精美的纹理！"
		""
		"[\"\",{\"text\":\"点击访问维基\",\"color\":\"blue\",\"bold\":true,\"underlined\":false,\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://wiki.valhelsia.net/external-mods/forbidden-and-arcanus/wiki\"}}]"
		""
		""
		"{@pagebreak}"
		"特色："
		"- 在赫淮斯托斯锻造炉中创造各种仪式，并升级你的赫淮斯托斯锻造炉等级。"
		"- 升级你的武器和工具，变得前所未有的强大！"
		"- 具有独特特性的新物品和新饰品。"
		"- 在克里巴诺中冶炼矿石，并有机会借助灵魂使你的锭数量翻倍。"
		"- 研究新研究系统中的所有秘密，并解锁所有禁忌魔典内容！"
	]
	quest.68ED7AB82272EC16.quest_desc: [
		"模组中的首领必须手动召唤才能进行战斗。这需要先获得对应首领的首领代币物品。获得首领代币物品后，可以通过以下两种方式使用它："
		"{@pagebreak}"
		"在“虚无首领大厅”的首领祭坛上使用首领代币物品。"
		"如果玩家尚未能直接进入虚无之地，则手持首领代币物品并长按右键 3 秒钟，会将玩家传送到“虚无禁用首领大厅”。在那里，同样可以将物品用于该大厅的首领祭坛，以进入首领战斗。如果玩家已经可以直接进入虚无之地，则会被传送到“虚无首领大厅”。"
		"{@pagebreak}"
		"所有首领都在虚无之地进行战斗，但它们的首领代币物品与各自所在的维度相关联。召唤首领并不会消耗首领代币物品。"
	]
	quest.692BC44C7B9AF3B4.quest_desc: [
		"这款简单的基础模组允许你通过一条指令放大某个区域。该功能在服务器端同样有效，因此你无需在客户端安装。只需使用触发指令 &l/trigger darkzoom&r，即可进入放大模式，查看你所见景象的放大视图。此效果持续 2 秒，可再次激活。"
		""
		"注意：此功能使用了游戏内的 FOV 功能。请确保你的 FOV 滑块已调至 100%，以便其正常工作。"
	]
	quest.694372C448477D6F.quest_desc: [
		"由凋零掉落"
		""
		"曾目睹过毁灭。或许它也见证了你的物品消失不见。"
	]
	quest.6944ED782E2947B0.quest_desc: ["主世界是《我的世界》中的主要维度。这里有种类繁多的独特生物群系可供探索，无疑是所有维度中最为多样化的一个。玩家通常会在这个维度度过大部分时间。"]
	quest.694B62520750117F.quest_desc: [
		"欢迎来到紫水晶附魔模组，这是一个完全关于水晶、宝石以及你自身内在魔力的模组！"
		""
		"将你的经验值作为一种资源，用来转化各种水晶和材料，为装备注入魔法能力，打造强大的新物品等等。"
		""
		"本指南仅介绍基础内容，如需了解更多详情，请使用指南书和 JEI。"
	]
