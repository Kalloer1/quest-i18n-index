	quest.14D5C1C2F1765823.quest_desc: ["恢复生命值、饥饿度和口渴度。"]
	quest.14D5C1C2F1765823.title: "冰沙"
	quest.14E4597D1223B6BC.quest_desc: ["神秘农业的核心概念是通过种植作物来获取资源。使用作物培育精华，用以制作材料、生物掉落物、工具、盔甲，甚至可能还有更多！"]
	quest.1500997386FCDE64.quest_desc: ["《铁之法术与法书指南》"]
	quest.154C80564E18D35E.quest_desc: ["更强的法术需要更高等级的权杖和更高的学派等级"]
	quest.15C91FD1F17B45E4.quest_subtitle: "原始以太锭可在末地城宝箱中找到"
	quest.168995DFEE534DB0.title: "超越人性"
	quest.16C7F1F9F17CFF19.title: "技巧之道"
	quest.16EFB6C2D87A4303.quest_subtitle: "可重复"
	quest.16EFB6C2D87A4303.title: "奥术抛光黑石柱"
	quest.176D5F2BA1F141DB.quest_desc: [
		"如果你被困在某个地方，或想快速重生在上一个出生点，可使用以下命令杀死你的角色：-"
