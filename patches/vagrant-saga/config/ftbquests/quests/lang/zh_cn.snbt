	quest.06FAE54770F5B6B5.quest_desc: [
		"Epic Fight 为你的游戏增添了复杂的机制与战斗风格。它融合了类魂战斗元素与独特的动画处理，为《我的世界》带来了全新的变化，让你的游戏体验提升到全新水平，并带来诸多全新挑战。你将面对一种全新的《我的世界》战斗方式，所有实体都拥有了新颖且富有挑战性的战斗机制。"
		""
		"按下 &aHOME&r 键可在战斗/挖掘模式之间切换"
		""
		"按下 &aLeft-ALT&r 键进行闪避（学习技能后）"
	]
	quest.06FAE54770F5B6B5.title: "战斗！"
	quest.073BD6D5D021CB3C.quest_desc: ["有 10% 的几率生成于冰屋中"]
