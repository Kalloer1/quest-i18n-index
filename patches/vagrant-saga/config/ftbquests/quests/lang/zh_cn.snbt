	quest.28AC20D4F4C9A287.quest_desc: ["在背包中持有腐烂遗物时获得黑暗效果，即可得到魔枪"]
	quest.294BBA5AC6EF32D5.quest_desc: [
		"推进进度所需的工具。"
		""
		"该工作台可当作更强大的附魔台使用，也是该模组的合成台"
	]
	quest.294BBA5AC6EF32D5.title: "第一步"
	quest.2A3BCF09349D2904.quest_subtitle: "像天使一样飞翔"
	quest.2A41A270337B08E2.quest_desc: ["末地是一个类似太空的维度，由漂浮的末石岛屿组成，可通过末地传送门进入。它通常被认为是下界的反面。末地是一片荒芜的环境，但却是游戏中一些最独特、最有用物品（如鞘翅或潜影盒）的唯一获取地点。"]
	quest.2A76B5022AFE633C.quest_desc: ["2024 冬季活动奖励物品"]
	quest.2A76B5022AFE633C.title: "冬季乐趣"
	quest.2A7E097C3495D539.quest_subtitle: "不再受凋零头颅之痛"
	quest.2AAF6DD5BA72F9F8.quest_desc: ["+2 护甲"]
	quest.2B2B113A16A83C87.quest_desc: ["击杀狂乱阴影"]
	quest.2B3EA95F82C910AA.title: "钢制时装"
	quest.2B5884D4A5692121.quest_desc: ["将区块熔炼成可用的锭"]
	quest.2C4568B746EBCC62.quest_desc: ["手持许愿宝石进行治疗"]
	quest.2C5EA5D93CDC7875.quest_desc: [
		"这些物品只能通过灌注台获得的附魔进行赋能"
		""
		"最基础的类型可以在野外找到，对其使用“吉萨尔绿叶”即可驯服。吉萨尔绿叶是一种野生植物，也可以通过播种吉萨尔种子来种植。吉萨尔种子可以通过吉萨尔绿叶合成获得，也可以从已种植的吉萨尔绿叶上收获。"
	]
	quest.2C5EA5D93CDC7875.title: "附魔时装"
	quest.2C75494E30257EE1.quest_desc: [
		"生成于末地，Y 坐标在 0 到 32 之间（主要在 Y=16）"
		""
		"用于合成神话锭"
	]
	quest.2CFAFA19D117B69E.quest_desc: [
		"概览"
		"普雷卡西亚是一个 1 级维度。"
		""
		"进入方式"
		"使用普雷卡西亚界石对传送门中的雕纹符文之石进行交互即可进入普雷卡西亚。界石可通过考古学获得——《飞升降临》模组会在主世界丛林类群系的表面以较低概率生成小片的可疑沙砾。对这些可疑沙砾进行清理时，有机会获得界石。"
	]
	quest.2D003949033346CF.quest_desc: ["远程更换服务。"]
	quest.2D003949033346CF.title: "电视遥控器"
	quest.2D54DFBAE4A16962.quest_desc: ["合成一颗红宝石以召唤加斯冈神父"]
	quest.2DB72C0DE805C6DC.title: "凋零恶魔之心"
	quest.2DCE7611A995B73D.quest_desc: ["奥术主义指南"]
	quest.2DCE7611A995B73D.title: "奥术主义"
	quest.2DE7FF157A99178A.quest_desc: [
		"提供剧毒荆棘"
		""
		"剧毒荆棘可在 5 秒内对敌人施加荆棘和中毒效果"
	]
	quest.2E4CCFE615C88D0A.quest_desc: ["在 3x2 区域内采矿"]
	quest.2F44D5340015AF2E.quest_desc: [
		"最基础的类型可以在野外找到，使用“吉萨尔绿”即可驯服它们。吉萨尔绿是一种可以在野外找到的植物，也可以通过播种吉萨尔种子来种植。吉萨尔种子可以通过吉萨尔绿合成获得，也可以从已种植的吉萨尔绿上收获。"
		"{@pagebreak}"
		"陆行鸟可以繁殖和繁衍后代。后代将是雏鸟，即陆行鸟的幼年形态。一段时间后，雏鸟会成长为陆行鸟。雏鸟出生时是野生的，必须经过驯服。雏鸟会从父母一方继承类型，也可能突变为新的类型。因此，通过不断繁殖陆行鸟，就可以从驯服的野生陆行鸟中获得所有普通类型的陆行鸟。不过，有几种特殊的陆行鸟类型只能通过特殊方式获得。"
	]
	quest.2F4F7951D441F537.quest_subtitle: "原始以太存在于末地城的宝箱中"
	quest.2FB267EEE5A01C5C.quest_desc: [
		"使用亡灵之魂进行合成"
		""
		"铭记那些逝者生前的过往"
	]
	quest.30358A88AED0FE19.quest_desc: [
		"赋予奥术气场 5"
		""
		"奥术气场会对敌人施加3级漂浮效果，持续0.75秒"
	]
	quest.304C3B71743AA217.quest_desc: ["使用这颗牙齿后睡觉即可变成狼人"]
	quest.304C3B71743AA217.title: "变成狼人"
	quest.304DD6D486D4F56E.quest_desc: [
		"正在访问"
		"要获得前往此维度的界石，可以在下界手持空白界石的同时召唤一个凋零。"
	]
	quest.30724FD5A00AF779.title: "智者之路"
	quest.308D9A656D86AAE3.quest_desc: ["手持许愿宝石与动物进行繁殖"]
	quest.30C44DEB5FD5EC7A.title: "炭火鸟"
	quest.30DC69F4A5338139.quest_desc: ["击败龙后，领主便会生成。龙蛋由他掉落。"]
	quest.32454EF3EBF0CD82.quest_desc: ["橄榄石工具会施加3级中毒效果，持续1.5秒"]
	quest.33F3CDCF71223716.quest_desc: [
		"概览"
		"“无境”在等级体系中官方被视为“无等级”。它是目前唯一被如此对待的维度。"
		""
		"进入方式"
		"有多种方式可以进入“无境”维度；每种进入方式都会导向“无境”的不同“区域”。"
		""
		"{@pagebreak}"
		""
		"在已构建的传送门框架中，对“刻印符文之力”使用“无境界石”，即可进入“无境”。此进入方式将导向“无境枢纽”。"
		""
		"此外，手持任意首领代币物品并长按右键 3 秒，也可进入“无境”。此进入方式将导向“无境禁用首领大厅”，可用于进入首领战。如果玩家此前已使用界石进入过“无境”，则此方法会将玩家带至“无境首领大厅”。"
	]
	quest.34398D0CFE96D0C9.quest_subtitle: "击杀利维坦"
	quest.34398D0CFE96D0C9.title: "多维捕食者"
	quest.343D9B29876A1071.title: "巨像铠甲"
	quest.34AE283A5ADCAE1B.quest_desc: ["将“沉眠巫妖之刃”升级为“觉醒巫妖之刃”"]
	quest.34BCCC7E57370BD5.quest_desc: ["获取“风暴使者”并格挡攻击"]
	quest.34BE0D07780A8999.quest_desc: ["《神秘遗产》指南"]
	quest.34CA9F5BC2ED8ACC.quest_desc: [
		"在冰屋中找到"
		""
		"冰学家们从世界中突然消失前遗留下的最后几件神器之一"
	]
	quest.35411B4B004F098A.quest_desc: ["击杀末影龙"]
	quest.354E77D2EBC37D11.quest_desc: ["射程延长一格"]
	quest.366A60731E0989AE.quest_desc: [
		"在矿井中找到"
		""
		"据说它是由时间之初的第一批铁匠锻造的"
	]
	quest.36FCC9F01646B8F9.quest_subtitle: "永恒生命套装的一部分"
	quest.370A078A1AAB289C.quest_subtitle: "击杀末影守卫"
	quest.370A078A1AAB289C.title: "那是潜影贝吗？"
	quest.37133BBC773F1539.quest_desc: ["可怕的恶魂出现在下界的灵魂沙结构中"]
	quest.37133BBC773F1539.quest_subtitle: "在下界之星祭坛上使用下界之星来召唤可怕的恶魂"
	quest.37133BBC773F1539.title: "击杀可怕的恶魂"
	quest.376314CA92EDE736.quest_subtitle: "可重复"
	quest.376314CA92EDE736.title: "奥术水晶粉尘粒"
	quest.3828ECF3777FFAE2.quest_desc: [
		"标准的原版方块在被挖掘或破坏时只会掉落 1 种特定物品。现在你在挖掘时就有机会获得一些稀有物品了。"
		""
		"想找些吃的？去泥土或下界岩里找找看吧"
		"想找钻石或绿宝石？去挖掘一些矿石，甚至能获得双倍的标准奖励！"
		"想找更稀有的物品？去挖掘一些末地方块吧"
		""
		"掉落物基于权重系统。你必定能获得标准的原版掉落物，并有机会获得其他物品。"
	]
	quest.383970C79F43B2F1.quest_subtitle: "可重复"
	quest.383970C79F43B2F1.title: "暗石"
	quest.385B7DC4812520F4.quest_desc: ["放置后能像红石块一样运作"]
	quest.389D22C8F062040C.title: "从已保存的选项中选择"
	quest.3912B4FC2E2FA7CB.quest_desc: [
		"这将涵盖模组巫师及其附加组件以及任何其他魔法相关内容"
		""
		"制作能施法的武器，或用附魔书强化武器，以便你能用任何武器施法"
