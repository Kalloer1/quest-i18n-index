		"&l/trigger darkdeath&r"
	]
	quest.17AC48579EE310CD.quest_desc: ["阅读《暮色森林》章节以获取更多信息……"]
	quest.17B3165C9CCE59B8.quest_desc: ["在永恒黎明的毒液地牢中击杀蛛后"]
	quest.17B3165C9CCE59B8.title: "蛛后"
	quest.17C120451363412A.quest_desc: ["别是蜜蜂！"]
	quest.17F5609B399C99E8.quest_desc: ["一大堆增益（我懒得写了，直接按旧版Shift键并将鼠标悬停在背包上就行）"]
	quest.184964F3E281BDF3.quest_desc: ["一个实用的邮件投递系统，允许你将物品发送和接收到自己的邮箱中。别忘了使用邮箱！邮箱可以让你向服务器上的其他玩家发送邮件。你可以将物品和一条可选消息附在任何放置在世界中的邮箱里。它也能跨维度使用。当你收到邮件时，你的邮箱上会出现一面红色小旗。"]
	quest.1907ED920EB79C55.quest_desc: ["获取灵魂火葬堆，并与你的敌人交换位置"]
	quest.1936A6D13852789A.quest_desc: [
		"使用以下命令传送回出生点：-"
		""
		"&l/trigger darkspawn&r"
	]
	quest.1A0D2433C6FA49AB.title: "霜冻之墓"
	quest.1A461C4DB6D97C1E.quest_desc: [
		"在主世界中找到星光门户遗迹结构，并击败守门人。"
		""
		"使用寻目之眼找到首领，然后按照新维度中《星光故事》上的指示操作……"
	]
	quest.1A70D8272BF27C68.quest_desc: ["接受任何吸血鬼知识之书。"]
	quest.1A70D8272BF27C68.title: "人类心脏"
	quest.1AEBCBF2E40C85CF.quest_desc: ["制作用于寻找伊格尼斯的火焰之眼"]
	quest.1B0BED74F75325FC.quest_desc: ["制作用于寻找末影守卫的虚空之眼"]
	quest.1B609EB915C9B813.quest_desc: [
		"从一位高阶牧师处购买"
		""
		"据说能保护其主人免受厄运的神圣护身符"
	]
	quest.1C4D9192472ACC3F.quest_desc: [
		"门户可以组装成你想要的任何形状和大小，上图只是最低尺寸要求，门户可以制成多种不同的形状和大小。"
		"{@pagebreak}"
		"只要满足以下条件，门户就能正常运行："
		"1.)   框架由草、泥土、腐殖土、菌丝体等构成。"
		"2.)   草的上方有花朵、蘑菇、树叶、植物等。"
		"3.)   框架必须完全注满水。"
	]
	quest.1D08E40F37CA63B7.quest_desc: ["将一只绯红蚊幼虫放入衣壳中，即可获得神秘蠕虫。"]
	quest.1D244505FBDF461D.quest_desc: ["允许设置一个仅支持单次交易的简易交易机。物品可以从配置好的侧面放入或取出。"]
	quest.1D8090835DE90CDB.quest_desc: [
		"探索是《末地重制版》的主要玩法。为了抵达末地并击败末影龙，你需要通过探索原版结构和对抗原版首领来找到 16 个自定义之眼。一旦你拥有至少 &l12&r 个眼睛，就可以跟随它们的指引抵达要塞。你必须将 &l12&r 个自定义之眼放入传送门中才能将其激活。如果框架中有一个原版末影之眼，你可以使用自定义之眼对其右键来将其移除。"
		"{@pagebreak}"
		"眼睛是《末地重制版》中非常重要的组成部分。与原版末影之眼一样，它们能用来激活前往末地的传送门。但不同的是，它们不会由末影人掉落，而是需要通过探索、战斗和挖掘来获得。"
	]
	quest.1DBE70C472B3237C.quest_desc: ["在副手持有许愿宝石，为自己获得大量效果。"]
	quest.1E1AC78F100BE5BF.quest_desc: ["+4 护甲"]
	quest.1E54ADB365BD7C51.quest_desc: [
		"另一侧传送门是进入另一侧的入口。它的形状与下界传送门相同，但默认最小高度为 2 而非 3，并由加固深成岩构成。未点燃的另一侧传送门可以在远古城市的中心以及远古神殿中找到。"
		""
		"使用深海之心而非打火石来开启另一侧传送门。"
	]
	quest.1E5F7443C78E0138.quest_desc: ["合成用于寻找先兆者的机械之眼"]
	quest.1EB1005ED8C6BAC6.quest_desc: [
		"&8石质&r魔杖：16 方块上限。"
		"&6铁质&r魔杖：32 方块上限。"
		"&b钻石&r魔杖：64 方块上限。"
		"&5下界合金&r魔杖：256 方块上限。"
	]
