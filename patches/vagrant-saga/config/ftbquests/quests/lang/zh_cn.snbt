	quest.656FBF5231240143.quest_desc: [
		"禁止恶意破坏或盗窃他人物品。"
		"未经同意的 PVP 被视为恶意破坏和骚扰行为。"
		""
		"禁止刷屏/发送全大写消息。"
		""
		"禁止广告。"
		""
		"禁止辱骂/禁止持续辱骂。"
		""
		"禁止恶意挑衅/引战。"
		""
		"禁止使用被封禁的物品。"
		"{@pagebreak}"
		"禁止索要 OP 权限。"
		""
		"尊重所有玩家。"
		""
		"服从工作人员。"
		""
		"禁止发表种族主义、性别歧视或其他歧视性言论。"
		""
		"禁止使用外挂（包括任何形式的透视、脚本或宏）。"
		""
		"禁止在出生点附近建造。"
		""
		"无 1x1 高塔"
		""
		"不得以口头或文字形式恶意针对任何人的身体、心理或社交状况"
		"{@pagebreak}"
		"不得使用不当用户名或皮肤"
		""
		"任何被证实会导致服务器严重卡顿的玩家、物品、农场或已占区块，均可由服务器管理员酌情移除。"
		""
		"请不要在服务器中试图建立邪教或宗教。"
		""
		"不得冒充工作人员，无论是使用其皮肤还是假装成其本人"
		""
		"不得使用沉浸式绘画来放置 NSFW 图片"
	]
	quest.656FBF5231240143.quest_subtitle: "我们公共服务器的规则"
	quest.65C36F9A4167E3DB.quest_desc: [""]
	quest.6602265BCBFE2A86.quest_desc: [
		"“坚如铁钉”是一款生存模组，它增加了多种功能来提高游戏难度，包括体温和口渴度。"
		""
		"[\"\",{\"text\":\"访问维基\",\"color\":\"blue\",\"bold\":true,\"underlined\":false,\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://github.com/Glitchfiend/ToughAsNails/wiki/\"}}]"
	]
	quest.6691DD68B8C7692A.quest_desc: ["授予“体内温暖”效果，持续 5 分钟。"]
	quest.6691DD68B8C7692A.title: "体内温暖效果"
	quest.669A894F596B45FF.quest_desc: ["当副手持有“承诺宝石”时，受到伤害来自敌对生物"]
	quest.6732ED2ADF9964A4.title: "黑石"
	quest.676CFC5DF4EBD243.quest_desc: ["将一颗心脏熔炼成金块"]
	quest.67C886CE3D934AAA.quest_desc: ["获得“烈焰风”"]
	quest.67E02BCEC60B29FB.quest_desc: ["红宝石工具具有更高的挖掘速度，手持时会赋予挖掘速度效果"]
	quest.6817F3E2D036C3C8.quest_desc: [
		"流浪猫会逃离7格范围内的任何玩家，并避开16格范围内的玩家。但是，如果玩家在10格范围内手持生鳕鱼或生鲑鱼，它们会慢慢靠近，从而允许玩家喂养并驯服它们。如果玩家在6格范围内转身过快或不再手持鱼，猫咪就会逃跑，并在几秒钟内不再尝试靠近玩家。"
		"{@pagebreak}"
		"当玩家睡觉时，被驯服的猫会走向它们的主人并在附近睡觉。当玩家醒来时，它们驯服的猫也会醒来。玩家醒来后有70%的几率收到被驯服的猫送出的礼物，但前提是玩家必须在夜间睡觉；如果玩家在白天雷雨天气时睡觉，或者被驯服的猫已被命令坐下，则玩家不会收到任何礼物。礼物列表请见下一页。"
		"{@pagebreak}"
		"&9常见&r"
		"- 兔皮"
		"- 兔脚"
		"- 生鸡肉"
		"- 羽毛"
		"- 腐肉"
		"- 线"
		"- 幻翼膜"
		"- 西瓜片"
		"{@pagebreak}"
		"&6较稀有&r"
		"- 钻石"
		"- 金苹果"
		"- 金胡萝卜"
		"- 不死图腾"
		"{@pagebreak}"
		"&d稀有&r"
		"- 紫水晶碎片"
		"- 海之心"
		"- 凋零骷髅头颅"
		"- 回声碎片"
		"- 海绵"
		"- 试炼钥匙 (1.21+)"
		"{@pagebreak}"
		"&4极稀有&r"
		"- 末影水晶"
		"- 鹦鹉螺壳"
		"- 下界之星"
		"- 不祥之瓶 (1.21+)"
	]
