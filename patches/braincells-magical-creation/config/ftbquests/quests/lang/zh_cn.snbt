	quest.2A835E11C15CC9A5.title: "击杀下界合金巨兽"
	quest.2C1DEB9B05665B25.quest_desc: [
		"躺在金字塔底部的&eThe Ancient Remenent&r必须先被唤醒才能受到伤害。为此，你需要在金字塔内找到&6Necklace of the Desert&r&7(提示：留意可疑的沙子)&r"
		""
		"击败首领后，可以用&6沙漠之眼&r将其重新召唤，无需项链即可唤醒。"
	]
	quest.2C1DEB9B05665B25.title: "击杀远古残骸（Ancient Remnant）"
	quest.2DCA55C74D061B81.quest_desc: ["在研究 &eZenelite,&r 你意识到它正在 &z&o吸收周围的灵气。&r 如果把它放在你的 &2natural altar&r 上会发生什么呢？"]
	quest.2DCA55C74D061B81.quest_subtitle: "一件物品能有多少潜力呢"
	quest.2E0BD94A45E561BB.quest_desc: [
