	quest.734FBEC068B2172D.quest_subtitle: "击杀 3 只 [长矛托罗]"
	quest.734FBEC068B2172D.title: "C级 “长矛鱼”"
	quest.740B6E0CC8D7EAD8.quest_subtitle: "击杀 2 只 [斯廷法洛斯鸟]"
	quest.740B6E0CC8D7EAD8.title: "D级 [铁雨]"
	quest.77B1FCE94ECEAEAF.quest_desc: [
		"---------------------------------"
		"生命值 - 1000"
		""
		"精神健康 - 2000"
		""
		"护甲 - 50"
		""
		"最低EP - 1036331"
		""
		"最高EP - 1036332"
		"---------------------------------"
		"一位稀有的异界来客，也是游戏中最强的首领之一。"
		"对“魔人”种族持敌对态度（因为根据背景设定，它憎恨怪物），对非魔人种族持中立态度"
		""
		"每秒会被动恢复2点HP和20点SHP，并使用治疗魔法，每10秒恢复100点HP和200点SHP。"
		""
		"日奈塔无法被驯服"
		""
		"日奈塔免疫所有负面效果，但以下效果除外："
		""
		"反技能"
		"无限监牢"
		"欲望之拥"
		"压迫者的压迫"
		"无情者的灵魂汲取"
		"懒惰之困"
		"---------------------------------"
		"阶段1"
		"召唤5只高阶精灵并进入断层领域模式，高阶精灵被击败后，日奈塔将进入阶段2"
		"---------------------------------"
		"阶段2"
		"在此阶段，日奈塔只会使用其被动能力以及“死胡同彩虹”进行攻击，并会进行一些传送。当其HP低于75%时，将进入阶段3"
		"---------------------------------"
		"阶段3"
		"雏田仍将继续使用她的剑术，并配合精神魔法、地狱之火、暴风雪、大地牢狱和空中利刃。当她的生命值低于 50% 时，她还将开始使用分解术。在她施法期间，目标会受到减速效果。若要取消该攻击，需用足够的伤害攻击她。如果分解术命中，目标将被立即击杀。一旦生命值条降至 25%，她将进入阶段 4。"
		"---------------------------------"
		"阶段 4"
		"进入此阶段后，雏田将恢复至其生命值的 50%，这将成为她的新最大生命值，同时她的被动生命再生变为每秒 10 点生命值 + 50 点精神生命值。在此阶段，雏田将使用之前所有阶段的所有招式，但这次她会装备神圣武装和月光剑，并使出熔岩斩。如果熔岩斩命中目标，目标将受到相当于雏田伤害 10 倍的伤害，且无视护甲（最低 1000 点伤害）、抗性和断裂效果，随后还会在 5 秒内每 10 次造成 100 点的持续伤害。"
		"---------------------------------"
	]
	quest.77B1FCE94ECEAEAF.quest_subtitle: "击杀英雄 [雏田·坂口]"
