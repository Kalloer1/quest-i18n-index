	quest.5D2114856DB40947.quest_desc: ["这位银发吸血鬼魔王在神圣的卢贝利乌斯帝国背后秘密行事。此版本记录了截至动画第三季结束时的她的实力状况。"]
	quest.5D2114856DB40947.quest_subtitle: "\"黑夜统治者 / 吸血鬼女王\""
	quest.5D2114856DB40947.title: "[Luminous Valentine]"
	quest.5DADEE7C6B8C9FFC.quest_desc: [
		"---------------------------------"
		"生命值 - 80"
		""
		"精神值 - 160"
		""
		"护甲 - 20"
		""
		"最低 EP - 5000"
		""
		"最高 EP - 5999"
		"---------------------------------"
		"使用“怪物鞍”和“箱子”，可以为一只已命名的“护甲龙”装备鞍和鞍袋。鞍袋的储物空间相当于两个箱子，使其可以被骑乘。"
		""
		"使用骑乘能力键 &l（默认 R）&r 会使护甲龙转身并发动一次甩尾攻击。骑乘时，护甲龙会破坏方块，具体效果取决于骑乘者的朝向。如果向上看，向前移动会破坏一个向上的阶梯状区域的方块；如果向下看，则会破坏向下的阶梯状区域的方块。"
		""
		"被破坏的方块会被放入鞍袋中。如果鞍袋已满，或者没有鞍袋，掉落的物品会掉在地面上。"
		""
		"身披重甲的地下巨兽正在扰乱山区的采矿作业。击碎它们的壳吧。"
		""
		""
		"生成于“台地”和“山脉”生物群系。拥有极高的防御护甲值，若没有魔法技能，击杀它们会非常棘手。"
	]
	quest.5DADEE7C6B8C9FFC.quest_subtitle: "击杀 5 只[护甲龙]"
	quest.5E1693EE9AF240A3.quest_subtitle: "击杀 1 只[塞壬]"
	quest.5E1693EE9AF240A3.title: "B 级[深海之歌]"
	quest.5E83E4CE86BB2A8B.quest_desc: [
		"---------------------------------"
		"生命值 - 15"
		""
		"精神值 - 60"
		""
		"护甲 - 1"
		""
		"最低 EP - 1000"
		""
		"最高 EP - 3000"
		"---------------------------------"
		"一种常见于水中的体型相当大的鱼。"
	]
	quest.5E83E4CE86BB2A8B.quest_subtitle: "击杀 8 只[巨型鳕鱼]"
	quest.5E83E4CE86BB2A8B.title: "F 级“最大的鱼”"
	quest.5EC8CE5E5CE9CC19.quest_desc: [
		"---------------------------------"
		"生命值 - 65"
		""
		"精神生命值 - 130"
		""
		"护甲 - 6"
		""
		"最低 EP - 6000"
		""
		"最高 EP - 6999"
		"---------------------------------"
		"一种大型蜘蛛类怪物。它潜伏在地下或洞穴中。命名后，可以为其装备怪物鞍具并进行骑乘。骑乘时按下赛跑/坐骑能力键（默认为 R），它会以一个大弧度的方式射出粘性钢制蛛丝。当被骑乘或追逐玩家时，它会破坏路径上的树叶和原木。按住跳跃键（与马匹类似）会蓄力跳跃条，使蜘蛛能够跃起约 10 个方块的高度。"
		""
		"森林和丛林的更深处正被巨大的毒蛛占据。净化这片林地吧。"
		""
		"它们出现在平原、丛林和森林中。与普通蜘蛛相比，它们的生命值和移动速度略有提升，可作为前期装备的试金石。"
	]
	quest.5EC8CE5E5CE9CC19.quest_subtitle: "击杀 5 只[黑蜘蛛]"
	quest.5EC8CE5E5CE9CC19.title: "D 级“蜘蛛恐惧症”"
	quest.627C62FE7EB45A34.quest_desc: [
		"---------------------------------"
		"生命值 400"
		""
		"精神生命值 800"
		""
		"护甲 5"
		""
		"最低 EP 120000"
		""
		"最高 EP 150000"
		""
		"---------------------------------"
		"“大火焰之灵”是日奈拥有的众多灵体之一，同时也寄宿在志津的身体里。"
		""
		"该灵体在坂口日奈的第一阶段出现。"
		""
		"该灵体也在志津的第二阶段出现。"
		""
		"如果你拥有该灵体，也可以使用“召唤大元素灵”自行召唤它。"
		"但这不会掉落任何物品。"
	]
	quest.627C62FE7EB45A34.quest_subtitle: "击杀 [伊芙利特]"
	quest.627C62FE7EB45A34.title: "S级“不屈之灵”"
