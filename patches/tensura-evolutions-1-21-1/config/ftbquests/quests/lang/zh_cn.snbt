	quest.70B55AB1760FC5AE.title: "D 级“蜘蛛骑士”"
	quest.71691924B33D67D5.quest_desc: [
		"---------------------------------"
		"生命值 1000"
		""
		"精神值 3600"
		""
		"护甲 50"
		""
		"最低经验值 1036331"
		""
		"最高经验值 1036332"
		"---------------------------------"
		"矮人王，游戏中最强的首领之一，当然，唯一的例外是坂口日向。"
		"对闯入其密室挑战他的人，以及对矮人而言被视为罪犯的人，都抱有敌意。"
		""
		"加泽尔无法被驯服。"
		""
		"加泽尔免疫所有负面效果，但以下效果除外："
		""
		"反技能"
		"无限监狱"
		"欲望之拥"
		"压迫者的压迫"
		"无情者的灵魂汲取"
		"懒惰之困"
	]
	quest.71691924B33D67D5.quest_subtitle: "“可怕的矮人”"
	quest.71691924B33D67D5.title: "[加泽尔·德瓦戈]"
	quest.734FBEC068B2172D.quest_desc: [
