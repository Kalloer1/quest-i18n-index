	quest.65DB41B4D7E991EE.title: "水冷核聚变反应堆"
	quest.66BE1795F791E24B.quest_subtitle: "你的力量正在增强"
	quest.66BE1795F791E24B.title: "铜抽屉/控制器升级"
	quest.67951D95AFDC6415.title: "成功所需的工具"
	quest.67E4976F5548FBD6.quest_desc: ["这些资源应该足够你起步了。可能看起来很多，但我保证每个都很重要。慢慢来，这是一场马拉松，而不是短跑。"]
	quest.67E4976F5548FBD6.quest_subtitle: "你注定要带来毁灭，是好是坏，由你抉择"
