	quest.57A7B6077A13BD9C.title: "飞向天空"
	quest.57CF9FA8AF97F966.title: "龙之时代的终结 The End of The Dragon Age"
	quest.58220A21DDB11524.quest_subtitle: "高效地走捷径"
	quest.59504D5B9AA81E03.quest_subtitle: "氢气是新时代的煤炭"
	quest.59504D5B9AA81E03.title: "能量充能中"
	quest.59DA255AE2D11DDC.title: "创建"
	quest.5A324E05D43FEBFA.quest_desc: ["找到方向很重要，找到特定生物群系和建筑可能是你生存的唯一途径。你真的需要知道自己身在何处，以及如何最高效地到达目的地。"]
	quest.5A324E05D43FEBFA.quest_subtitle: "雪和水很危险。请避开它们！"
	quest.5A324E05D43FEBFA.title: "旅行与寻找回家的路"
	quest.5A3BA2296475A332.quest_subtitle: "不要眨眼"
	quest.5A3BA2296475A332.title: "眼睛说了算 (The Eyes Have It)"
	quest.5A7044E1C5B1FB09.quest_desc: ["用控制器连接储物抽屉，可将物品直接存入控制器或控制器接入点"]
	quest.5A7044E1C5B1FB09.quest_subtitle: "这个世界的邪恶将在你脚下瑟瑟发抖"
	quest.5A7044E1C5B1FB09.title: "连接您的存储设备"
	quest.5AA3D4C6F81157D6.quest_subtitle: "工业级篝火烹饪系统"
	quest.5AA3D4C6F81157D6.title: "熔炼大师养成记"
	quest.5B5294B9D15241C5.quest_subtitle: "成就获取：吹嘘的权利 (Bragging Rights)"
	quest.5B5294B9D15241C5.title: "末地的终结"
	quest.5C23FAE0375BC1D7.quest_subtitle: "氢和氧——简单却能维持生命"
	quest.5C7E4EFCACAA4541.quest_subtitle: "大家都在承受压力，不是吗？"
	quest.5C7E4EFCACAA4541.title: "增压器 (The Pressurizer)"
	quest.5CB683641704E938.quest_subtitle: "闻起来像鱼的味道"
	quest.5CB683641704E938.title: "纪念碑的守护者"
	quest.5CD48B44DE81CCA4.quest_desc: ["你醒了。眼前的世界很熟悉，但又有些不对劲。虽然能弄清楚，但现在有更紧急的事要处理。夜幕降临，这个世界有许多敌人。先掌握基础，做好准备。祝你好运！"]
	quest.5CD48B44DE81CCA4.quest_subtitle: "我们一直在等待着你到来"
	quest.5CD48B44DE81CCA4.title: "苏醒时刻"
	quest.5D4CA89048606CF5.quest_subtitle: "如凤凰般浴火重生"
	quest.5DAD42D78753E8AF.quest_subtitle: "大胆、张扬、俏皮、叛逆"
	quest.5DAD42D78753E8AF.title: "黄铜时代"
	quest.5DBEB8B6083DBF13.quest_desc: [
		"序幕："
		""
		"你被困住了。世界仿佛是你的，但原因不明，一切都变了。无论走到哪里，你总感觉有双眼睛在背后盯着你。你知道自己没疯。到了晚上，情况会变得更加……严峻。你能感觉到一股黑暗的存在从地心深处传来。难道黑暗就是你被困在这里的原因？难道它……把你困住了？你有一本任务书，完成任务才能推进剧情。你需要摆脱黑暗，解放这个平行世界的人们。或许可以先做些副业，赚取所需的资源。首先，你需要一个行动基地。最好找个……大一点的地方。"
	]
	quest.5DBEB8B6083DBF13.quest_subtitle: "你本不该来的....."
	quest.5EDF81E7F16B1C51.quest_subtitle: "自动化贪婪的极致体现"
	quest.5EDF81E7F16B1C51.title: "数字矿工在线"
	quest.607D8C8005C3F6CD.quest_subtitle: "镐子能打败石头人"
	quest.607D8C8005C3F6CD.title: "青铜地牢（滑行者）"
	quest.615FF5E6643FBA44.title: "探索主世界 (Exploring The Overworld)"
	quest.62CB15C9D2E71CCF.quest_desc: ["是时候给你点信息了。你以前做过这个，不是你本人，而是你的另一个版本，你的……版本。他们被困在时间循环里，可能已经和你沟通过，只是你不知道。他们会来帮助你，无论好坏，都会一直陪着你。"]
	quest.62CB15C9D2E71CCF.quest_subtitle: "二进制 二进制 二进制"
	quest.62CB15C9D2E71CCF.title: "锁与钥匙 (The Lock n' Key)"
