# AI 初翻，未人工校对
{
	chapter.1088DE9219BFAC7C.title: "&f&l欢迎"
	chapter.12CDF5CBC3F3857A.title: "&f&lPowah"
	chapter.29327EDA7EABA2D7.title: "&f&l现代工业化"
	chapter.38B491FF56A249C0.title: "&f&l沉浸式工程学"
	chapter.5C3FF9D1ECAC4860.title: "&l&f创建 \& 附加组件"
	chapter.6DF110DEE277173B.title: "&f&lApplied Energistics 2"
	chapter.6FD1496307A969ED.title: "&f&lOritech"
	chapter.B1E6D954A7F8032C.title: "Applied Energistics 2"
	file.0000000000000001.title: "&r&l超频：科技自动化"
	quest.003DA39A1577F438.quest_desc: ["用电弧炉熔炼不锈钢粉以获得热锭，然后用真空冷冻器将其冷却为固体锭。这是通往MV级机械和大多数中后期进展的入门材料。"]
	quest.003DA39A1577F438.quest_subtitle: "一种优质合金，可解锁高级机械船体和中期科技树。"
	quest.00511651BDBCBE0B.quest_desc: ["由处理单元、海森堡补偿器和铂金在原子熔炉中组装而成。制造超级AI芯片和其他一些终局系统所必需。"]
	quest.00511651BDBCBE0B.quest_subtitle: "用于复杂逻辑和控制系统的中高端处理器。"
	quest.00F44F4FA88A59F9.quest_desc: ["右键点击绳索绞车和绳索连接器，并用绳索耦合器将两者连接。施加旋转力后，绞车会根据旋转方向收放绳索。剪刀可以切断绳索，手持扳手右键点击绳索即可像滑索一样滑下。"]
	quest.00F44F4FA88A59F9.quest_subtitle: "一种在旋转力作用下收放绳索的电动卷轴。"
	quest.01A35962129F85B8.quest_desc: ["将管道连接到任何具有流体处理功能的方块上。右键点击相关管道部分以切换抽取。无需扳手。不过，扳手可用于禁用管道连接。"]
	quest.01A35962129F85B8.quest_subtitle: "在机器和储罐之间运输液体。默认传输速率为每3个游戏刻0.5个桶。流体管道没有内部存储。"
	quest.01AF8F8A669974E4.quest_desc: ["使用陨石战利品中的计算处理器压印机，在刻印器中打印。将打印电路与打印硅和逻辑处理器在刻印器中组合，即可组装最终的计算处理器。"]
	quest.01AF8F8A669974E4.quest_subtitle: "计算处理器是制作高级AE2组件（如终端和存储设备）所必需的。"
	quest.01C7A2DB13CD1747.quest_desc: ["通过化学反应和冷冻制造，用于量子电路板和引力胸甲。代表了模组中低温技术的尖端水平。"]
	quest.01C7A2DB13CD1747.quest_subtitle: "一种用于量子级机械的超冷却模块。"
	quest.0231C7713767FDE9.quest_desc: ["将用过的铀棒中提取的钚粉熔炼成完整的锭。用于制作MOX式燃料棒，大幅提升反应堆效率。"]
	quest.0231C7713767FDE9.quest_subtitle: "用于制造高效核燃料棒的裂变金属锭。"
	quest.025A48679E01A696.quest_desc: ["大幅提升将粉尘合成青铜、耐火砖和生钢的效率。还能用简单材料生成原石和黏土，是首批值得建造的青铜机器之一。"]
	quest.025A48679E01A696.quest_subtitle: "一种将粉尘混合成合金的蒸汽动力机器。"
	quest.027BA3FBAE0592AA.quest_desc: ["每条流体管道内部存储1桶，直接相连的管道共享缓冲区——因此每条额外管道都能提高网络吞吐量。右键点击管道中心并用扳手切换连接，或按住Shift右键拆除。"]
	quest.027BA3FBAE0592AA.quest_subtitle: "在储罐、机器和舱口之间运输流体。"
	quest.028EA9E631877ABE.quest_desc: ["Budding Certus 方块的生长方式与紫水晶相似，会生成 Certus Quartz Buds。Flawed 是倒数第二级——每次芽体生长，方块都有概率退化，最终变成普通的 Certus 方块。将其与 Charged Certus Quartz Crystals 一同投入水中即可修复或升级。在旁放置 Growth Accelerators 可大幅加快芽体生成速度。"]
	quest.028EA9E631877ABE.quest_subtitle: "一种可在陨石中找到的可降解的 Certus Quartz 源。会随时间在其表面生长出 Certus Quartz Buds。"
	quest.02BA3F75BA3429CC.quest_desc: ["Quarry、Silk Touch、Hunter 和 Crop Filter 等激光专用附加组件均可安装在激光臂上。组合它们，将激光塑造成你所需的采矿或防御工具。"]
	quest.02BA3F75BA3429CC.quest_subtitle: "修改安德利奇激光行为的专家级附加组件。"
	quest.02E3A39A95EE6F22.quest_desc: ["将三种材料同时投入水中以触发反应。此过程可通过子网络上的形成与湮灭平面实现自动化。"]
	quest.02E3A39A95EE6F22.quest_subtitle: "Fluix Crystal 是一种 AE2 材料，由带电的 certus quartz、nether quartz 和红石在水中合成。"
	quest.02EF953AA55E2123.quest_desc: ["在相邻方块和末地网络之间以烈焰速率传输FE。当不需要容量升级时，是末地单元的经济替代方案。"]
	quest.02EF953AA55E2123.quest_subtitle: "烈焰网络网关"
	quest.02FCA29535F30817.quest_desc: ["每个等级都会降低每次操作的能量消耗，但同时也会减慢机器速度。通常与速度附加组件搭配使用，在保持低运营成本的同时重新平衡吞吐量。"]
	quest.02FCA29535F30817.quest_subtitle: "来自 Oritech Things 的高级效率附加组件，可降低功耗。"
	quest.02FCA29535F30817.title: "更高的效率"
	quest.0399B710043D3817.quest_desc: ["右键无线终端，将其绑定到接入点。可通过无线增强升级卡扩展范围。运行需要1个频道。"]
	quest.0399B710043D3817.quest_subtitle: "可在范围内任何地方无线访问你的ME网络。"
	quest.03F79DC1D00217F5.quest_desc: ["网络中存储的流体可通过ME终端访问。流体单元与物品单元使用相同的驱动器插槽。使用导入/导出总线或接口来自动化流体处理。"]
	quest.03F79DC1D00217F5.quest_subtitle: "ME流体存储单元用于在ME网络中储存液体，其工作原理与物品单元相同，但适用于流体。"
	quest.03F79DC1D00217F5.title: "ME流体存储单元"
	quest.041C1088D9DEE433.quest_desc: ["在原子熔炉中用超导体和铂制成。高级增强站、超导电缆和多种后期控制方块的核心材料。"]
	quest.041C1088D9DEE433.quest_subtitle: "Flux gate 是 Oritech 用于调节大量能量的中高端控制组件。"
	quest.045DDEE342CC7D0F.quest_desc: ["自动合成系统的核心组件。放置在分子合成器或其他合成机器旁。支持锁定模式防止批次重叠，并可循环分配任务至多台机器。"]
	quest.045DDEE342CC7D0F.quest_subtitle: "模式提供器将合成材料推送到相邻机器，并将结果收集回网络。"
	quest.046B24BB8F09AF04.quest_desc: [
		"要设置目标方向，请在激光块上使用目标指示器。激光的最大射程为128格，在被红石信号阻挡或禁用前会持续发射。注意，你设置的是目标方向，而非目标方块。它将尝试摧毁该方向上的所有方块。"
		""
		"挖矿时，激光会自动将掉落物收集到其内部物品栏中。"
	]
	quest.046B24BB8F09AF04.quest_subtitle: "安德利激光消耗大量能量，向特定方向发射高功率光束。主要用于快速远程采矿或作为远程输电系统。"
	quest.04A514CC5CDC9440.quest_desc: ["通过超导组件经由化学和冷冻生产线生产。需要冷却单元和量子电路板才能组装量子电路。"]
	quest.04A514CC5CDC9440.quest_subtitle: "量子比特——量子计算的基本单位。"
	quest.04B893E41EA91853.quest_desc: ["比硬化棒具有更高的输入输出。在能量球周围堆叠多个烈焰棒，可进一步提高处理速度。"]
	quest.04B893E41EA91853.quest_subtitle: "烈焰吞吐量"
	quest.04BFB3091C5A2AD2.quest_desc: ["插入后，粒子会沿着引导环定义的路线移动。右键点击可在一侧添加45度转弯。路径上必须存在另一个引导环。根据速度，引导方块之间的允许距离会增加。"]
	quest.04BFB3091C5A2AD2.quest_subtitle: "引导环决定了加速器内部粒子的路径。第一个必须紧挨着控制器，并与它的视觉指示器对齐。"
	quest.04D21104CBDC4FE9.quest_desc: ["密集电缆是连接控制器与网络远端高通道主干线的必需品。智能型会显示 32 个通道中当前有多少个正在使用。"]
	quest.04D21104CBDC4FE9.quest_subtitle: "智能密集电缆可承载多达32个通道，并通过彩色指示灯显示单个通道的活动状态。"
	quest.04E0B6B6D3A04972.quest_desc: ["放入铁、铜或锡矿石，每块可产出2个原矿。在槽位中加入锤子可提高产出率并解锁更多配方。锻造锤是迈向自动化加工的第一步。"]
	quest.04E0B6B6D3A04972.quest_subtitle: "用于基础矿石和材料加工的简易工作台。"
	quest.04EB6DC23F87A915.quest_desc: ["用于制作进口总线（Import Bus）和湮灭飞机（Annihilation Plane）。湮灭飞机会直接破坏其前方的方块并存储掉落物。与形成核心（Formation Core）搭配使用可实现完整的物品输入输出。"]
	quest.04EB6DC23F87A915.quest_subtitle: "湮灭核心是AE2位面系统的输入端，负责将物品和方块从世界中拉入网络。"
	quest.051477732CB88DC3.quest_desc: ["连接到任意机器上，即可根据红石输入切换运行模式。可在正常和反向模式之间切换，方便按需控制昂贵机器的运行。"]
	quest.051477732CB88DC3.quest_subtitle: "启用红石对机器运行的控制功能。"
	quest.0520236A417538FA.quest_desc: ["一种能将流体和物品输入结合成混合流体输出的动力多块结构。用于生产混凝土、药水流体和其他混合配方。需要动力和流体管道才能运行。"]
	quest.0520236A417538FA.quest_subtitle: "将流体和物品混合在一起，创造新产品。"
	quest.053FDD5AD459D89A.quest_desc: ["将轴承朝向将成为螺旋桨的结构放置：任何至少由两个船帆状方块组成的组合都算作有效叶片，更多的船帆会产生更大的推力。反转旋转，或用扳手右键轴承，可反转推力方向。气压会减少高海拔地区的输出。"]
	quest.053FDD5AD459D89A.quest_subtitle: "在自身前方安装螺旋桨，将输入的旋转力转化为推力。"
	quest.054B196C55432353.quest_desc: ["给它喂食一个过载晶体和大量RF以开始提取。它能直接从深层区块样本中获取高级资源，无需手动开采大片区域。"]
	quest.054B196C55432353.quest_subtitle: "一种能从基岩层中提取稀有材料的终局采矿机。"
	quest.0572CCD3BBC71103.quest_desc: ["将高温流体转化为大量FE。在Niotic等级，维持一个大型熔岩池对于保持发电机持续运行至关重要。"]
	quest.0572CCD3BBC71103.quest_subtitle: "Niotic 熔岩之力"
	quest.05DC05AF38649B73.quest_desc: ["石油钻井平台和电动采石场需要它来开采更深处的稀有矿藏，如铂和钛。比青铜钻头耐用得多。"]
	quest.05DC05AF38649B73.quest_subtitle: "被电动采石场和石油钻井平台消耗的高级钻头。"
	quest.0648BF8253CA29BD.quest_desc: ["使用记忆卡连接两个 Light P2P 隧道：右键单击输入隧道以复制其频率，然后右键单击输出隧道以连接它们。一个输入可以连接多个输出隧道。"]
	quest.0648BF8253CA29BD.quest_subtitle: "通过ME网络将光照强度从一个位置传输到另一个位置。"
	quest.06B63DD4AF1541A6.quest_desc: ["用于制作红石和容量卡。将升级卡插入任何兼容的AE2设备接口中的升级槽。"]
	quest.06B63DD4AF1541A6.quest_subtitle: "基础升级卡，可为AE2设备启用简单的控制选项。"
	quest.07165E0EB1BE2850.quest_desc: ["Powah 中输出最高的太阳能发电机。紧凑的氮化太阳能阵列可在白天提供可观的被动 FE，且运行成本为零。"]
	quest.07165E0EB1BE2850.quest_subtitle: "氮化镓太阳能阵列"
	quest.075E97B2BB5F93DF.quest_desc: ["物品无法由玩家添加或移除，而是由滑槽、漏斗和物品口等组件完成。"]
	quest.075E97B2BB5F93DF.quest_subtitle: "默认情况下，每个物品宝库方块有 20 个堆叠的存储空间。"
	quest.081BF8F9E3C8F2B3.quest_desc: ["Overclocks 将电线产量提升至 32 EU/t。与生产电缆的 Assemblers 搭配使用，可消除早期电路设置的最大瓶颈之一。"]
	quest.081BF8F9E3C8F2B3.quest_subtitle: "钢铁线材厂的电动版本。"
	quest.0840C62E91BAD7FE.quest_desc: ["右键切换打字机，可控制每个按键的绑定频率。潜行右键打开配置界面；用连锁控制器右键可复制其绑定；用键位物品右键红石链接接收器可进入绑定模式，用于单次按键分配。绑定在物品被破坏后仍会保留。"]
	quest.0840C62E91BAD7FE.quest_subtitle: "将键盘按键绑定到红石链接频率：为整个装置打造的定制键盘。"
	quest.087FC87AA653E808.quest_desc: ["将FE存储在末地网络的通道中。连接到同一通道的任何末地电池都可以在维度内的任何地方访问存储的能量。"]
	quest.087FC87AA653E808.quest_subtitle: "无线储能装置"
	quest.098624BAEC3965A5.quest_desc: ["放置在物品栏旁边，会自动为其中的 FE 物品充电。非常适合被动地保持工具和电池充满电。"]
	quest.098624BAEC3965A5.quest_subtitle: "自动物品充电器"
	quest.099A4C2181B22A34.quest_desc: ["以极快的速度从已充能的物品中提取FE。将其放置在存储系统旁，可快速从存储物品中恢复能量。"]
	quest.099A4C2181B22A34.quest_subtitle: "Spirited FE 提取器"
	quest.09BE3D92053AE1F8.quest_desc: ["尝试将 Roller 放置在方块顶部时，它会像机械搅拌机或机械压机一样，被放置在方块上方一格。虽然看起来占据了几格空间，但实际上只占一格。此外还有放置辅助功能，可以轻松地将 Roller 放置在另一个 Roller 的两侧。可以通过潜行并使用扳手来拾起 Roller。"]
	quest.09BE3D92053AE1F8.quest_subtitle: "机械滚轮可用于清理和铺平机械装置上的路径。"
	quest.0A3B92620D7B6EDC.quest_desc: ["用桶或其他储罐右键交互以转移流体。内容物相同的储罐可在背包中堆叠，并能直接连接到机器以实现自动化流体输入输出。"]
	quest.0A3B92620D7B6EDC.quest_subtitle: "一个可放置的储罐，最多可储存4桶单一流体。"
	quest.0A55B411AB662280.quest_desc: ["将物品放置在烈焰锻造台。在供应液态经验值的情况下，它的熔炼速度比普通熔炉更快，甚至可以熔炼原版无法熔炼的材料。经验值流体会根据每次操作的价值被消耗。"]
	quest.0A55B411AB662280.quest_subtitle: "在烈焰燃烧器的热量下，通过燃烧液态经验来熔炼物品。"
	quest.0A8814659B697F55.quest_desc: ["运行于RF和骨粉类物质。每个刻都有几率加速附近作物、树苗及其他对骨粉有反应的植物的生长。"]
	quest.0A8814659B697F55.quest_subtitle: "将周围小范围内的作物施用骨粉。"
	quest.0B68610D72F11257.quest_desc: ["在搅拌机中将 Coke Dust 与水混合即可生成。在蒸汽高炉中燃烧这种原油，可将其提炼成合成油，这是所有早期橡胶生产的前身。"]
	quest.0B68610D72F11257.quest_subtitle: "合成橡胶链的第一步。"
	quest.0B7D86BB91AEED2F.quest_desc: ["缓冲少量RF，可通过能量管道连接机器和发电机。在达到大型存储方块前，平滑生产的简单方法。"]
	quest.0B7D86BB91AEED2F.quest_subtitle: "早期电力网络的紧凑型储能方块。"
	quest.0B86006B88A2F2E0.quest_desc: ["每个层级的单元组件都需要前一个层级来制作。将任意组件与单元外壳结合，即可创建相应的ME存储单元。"]
	quest.0B86006B88A2F2E0.quest_subtitle: "1k 单元组件是所有 ME 存储单元的基础材料。"
	quest.0BA721CA39D6A358.quest_desc: ["给它提供动力，它就会挖掘正前方的方块。用物品代理或管道来收集掉落物——非常适合用于受控采石场或鹅卵石发电机。"]
	quest.0BA721CA39D6A358.quest_subtitle: "会自动破坏其前方的方块。"
	quest.0BA80D8E876994D6.quest_desc: ["可在维度内任何位置，无线为关联玩家的物品栏充电。容量和I/O速度高于硬化版。"]
	quest.0BA80D8E876994D6.quest_subtitle: "烈焰无线充电器"
	quest.0BB7765E3190C88A.quest_desc: ["由核反应堆外壳和核反应堆舱门建造，该反应堆使用燃料棒将水加热成蒸汽，产生的EU/t是柴油的数百倍。它也是钚、氘和氚的唯一来源。"]
	quest.0BB7765E3190C88A.quest_subtitle: "一种可扩展的多方块结构，能从核燃料中产生巨大能量。"
	quest.0BBE6CADED48A971.quest_desc: [
		"用股票Ticker点击股票链接，将其连接到该网络。将生物放置在座位上，或在股票Ticker后方放置烈焰燃烧器，将其变为股票保管员。"
		""
		"库存管理员能看到网络中的所有物品。UI会显示已连接的库存链接数。如果库存管理员未锁定，玩家可以搜索网络、请求物品，并为请求指定一个发送地址。"
		""
		"如果库存管理员被锁定，其他玩家将无法访问其UI。库存管理员仍然可以接受购物清单。"
	]
	quest.0BBE6CADED48A971.quest_subtitle: "股票行情显示器用于向物流网络请求物品。"
	quest.0C2058ED0EF41590.quest_desc: ["Applied Energistics 2 (AE2) 采用独特的物品栏管理和自动化方法。其未来科幻主题围绕将物质转化为能量并反之，以实现即时资源传输。"]
	quest.0C2058ED0EF41590.quest_subtitle: "一个关于物质、能量以及用它们征服世界的模组..."
	quest.0C2BFE016DF61A2D.quest_desc: ["用于线缆、电路板和几乎所有电子元件的制造。早期使用合成器自动化钢线厂的动机之一。"]
	quest.0C2BFE016DF61A2D.quest_subtitle: "由 Wiremill 生产的细铜丝。"
	quest.0C9D044821AA0C64.quest_desc: ["用于制作IE电子电路配方的一种特殊工作台。将其放置于世界中，并通过GUI插入所需组件。用于生产电路板，再组装成完整的电子元件。"]
	quest.0C9D044821AA0C64.quest_subtitle: "制作电路板并组装电子元件。"
	quest.0CBE86996CD49BAF.quest_desc: ["从相邻的燃料棒中吸收热量，并将其扩散至邻近的通风口或吸收器。每刻的最大传输量随两侧温差增大而增加。"]
	quest.0CBE86996CD49BAF.quest_subtitle: "在反应堆组件之间传递热量。"
	quest.0D46D11DF8968CF5.quest_desc: ["用金属压子弹壳模具制作弹匣。可用弹药：Casull（10点伤害）、穿甲、鹿弹、龙息、追踪和狼群。在工程师工作台升级弹匣容量。"]
	quest.0D46D11DF8968CF5.quest_subtitle: "一种拥有多种弹药类型的八发转轮手枪。"
	quest.0D6B980A109BDD67.quest_desc: ["基础增幅站的升级版。用于安装飞行和战斗增强等后期增幅，标准增幅站无法安装。"]
	quest.0D6B980A109BDD67.quest_subtitle: "为玩家应用高级的赛博格增强模块。"
	quest.0E5FC39E6C71A872.quest_desc: [
		"可以用&6&o轴&r&r来连接两个机械部件，使一个的旋转带动另一个旋转。"
		""
		"当两个机械部件通过传动轴连接时，施加在任一部件上的任何&2旋转力&r都会同时施加到另一个部件上，并叠加其原有的&d速度&r。因此，如果两个部件都提供应力，可能会导致机器过载。"
	]
	quest.0E5FC39E6C71A872.quest_subtitle: "Shaft 是 Create 中的一个基础机械组件。"
	quest.0E5FC39E6C71A872.title: "&l&6竖井"
	quest.0E78B1230C3C72FF.quest_desc: ["右键并拖动节流阀手柄以设置其位置。手柄会保持在你放置的位置，并输出稳定的模拟信号，非常适合发动机功率、螺旋桨桨距或燃烧器强度。使用扳手右键单击会反转输出，因此相同的物理位置可能因配置不同而代表全开或全关。"]
	quest.0E78B1230C3C72FF.quest_subtitle: "一种紧凑的手动拉杆，可发出精确的模拟红石信号。"
	quest.0EE2E9EB6DC01E34.quest_desc: ["通过顺序组装制作：将金片放在储料箱上，然后在其沿传送带移动时，按正确顺序放置铁粒、齿轮和铁片。精密机制是机械合成器、轧机、火车及许多其他高级 Create 方块的关键组件。"]
	quest.0EE2E9EB6DC01E34.quest_subtitle: "精密机制是众多合成组件之一。"
	quest.0EE6A2DA8CC33480.quest_desc: [
		"这种金属用于多种合金，如adamant和energit，也用于大多数机器和机器部件中。"
		""
		"在碎片锻造炉中处理原镍或镍矿石，是获得副产品铂的好方法。"
	]
	quest.0EE6A2DA8CC33480.quest_subtitle: "镍是你在 Oritech 中需要收集的最初资源之一。镍矿石生成于主世界 Y -65 到 Y 40 之间。"
	quest.0F19A5ECCE602889.quest_desc: ["右键多块结构控制器方块即可构建。还能旋转机器和方块。在砧上，用它将锭锤成金属板。"]
	quest.0F19A5ECCE602889.quest_subtitle: "任何沉浸式工程师的主要工具。"
	quest.0F35B4F66DCE25F2.quest_desc: ["通过涉及核时代材料的复杂工艺制成。量子级组件、Gravichestplate 和高端电缆所必需。"]
	quest.0F35B4F66DCE25F2.quest_subtitle: "一种电阻为零的奇异金属。"
	quest.0F5EE9AA42AAC393.quest_desc: ["用于建造任何反应堆多区块的外壳。反应堆墙壁能承受巨大的热量和压力，在出现问题时能将辐射和损害控制在内部。"]
	quest.0F5EE9AA42AAC393.quest_subtitle: "必须包裹核反应堆的抗爆外壳。"
	quest.0F8A0BCA29114A38.quest_desc: [
		"分解原矿时，碎片锻造炉总会产出1个原矿块和3个同类型的小矿块。同时还会产生3个不同资源的小矿块作为副产品。"
		""
		"给机器附加一个产量增效器，可以将这些副产品的产量翻倍。仅支持1个产量增效器。"
	]
	quest.0F8A0BCA29114A38.quest_subtitle: "碎片锻造炉是提高矿石加工链产量的重要一步。将矿石块碎片化可生成原矿石，将原矿石碎片化可生成矿石团块。"
	quest.0FAA13768BE48E5C.quest_desc: ["将末影珍珠与其他试剂一同研磨而成。是制作末影透镜的原材料，而末影透镜能解锁末影激光和远程奥里泰克工具。"]
	quest.0FAA13768BE48E5C.quest_subtitle: "一种融合了末地传送特性的稳定化合物。"
	quest.0FB5D3D6F3B72C89.quest_desc: ["在 Basin 中混合种子、糖和水，并用 Blaze Burner 加热即可酿造。生物乙醇可在 Create: Crafts & Additions 的 Diesel Generator 中燃烧，提供完全可再生的电力来源。"]
	quest.0FB5D3D6F3B72C89.quest_subtitle: "一种通过将植物发酵成乙醇产生的可再生液体燃料。"
	quest.0FFBE9E17B891A03.quest_desc: ["使用陨石战利品中的工程处理器压印机，在刻印器中打印。将打印电路与打印硅片在刻印器中组合，即可制作最终的工程处理器。"]
	quest.0FFBE9E17B891A03.quest_subtitle: "最先进AE2设备，包括驱动器和密集电缆，都需要工程处理器。"
	quest.108BCD0312837D00.quest_desc: ["每个等级都会增加更大的内部RF储备，让机器能应对太阳能板或低优先级发电机等间歇性电源的功率波动。"]
	quest.108BCD0312837D00.quest_subtitle: "来自 Oritech Things 的更高级电容器扩展，用于更大的内部能量缓冲。"
	quest.108BCD0312837D00.title: "更大的容量"
	quest.10D3487EA2B6F95C.quest_desc: ["右键单击任何网络组件，即可查看其频道分配和已连接设备。可容纳9张升级卡，当该工具在背包中时，可通过任何设备的界面访问。"]
	quest.10D3487EA2B6F95C.quest_subtitle: "显示频道使用、设备连接和网络信息的诊断工具。"
	quest.10EDEA4D89FB7865.quest_desc: ["用不锈钢板和电子电路组件合成。在装配器中与硅晶圆和其他部件结合，可生产出用于高压级机器的数字电路。"]
	quest.10EDEA4D89FB7865.quest_subtitle: "用于数字电路组装的高压级电路板。"
	quest.1104570BF68AD415.quest_desc: ["使用EU代替燃料熔炼任何原版熔炉配方，最高可超频至32 EU/t。与Assemblers和物品管道搭配，实现任何材料的自动化熔炼。"]
	quest.1104570BF68AD415.quest_subtitle: "原版熔炉的电动替代品。"
	quest.11178481529B6D01.title: "Overclock: 无尽自动化"
	quest.111DE9EC42E7AFEE.quest_desc: ["通过能量球用能量钢锭制作而成。所有 Powah 等级的核心合成材料。"]
	quest.111DE9EC42E7AFEE.quest_subtitle: "充能钢"
	quest.1126E6CB8E90C171.quest_desc: ["制作模拟电路所需的五种基本组件之一。由碳、铜线和橡胶片组装而成。"]
	quest.1126E6CB8E90C171.quest_subtitle: "一种用于限制电路中电流的被动电子元件。"
	quest.11DD34E91AE6B53B.quest_desc: ["直接从物品栏中的物品访问存储的流体。将其插入驱动器或箱子以同步其内容与网络。"]
	quest.11DD34E91AE6B53B.quest_subtitle: "一种便携式ME流体单元，可储存液体，无需网络连接即可访问。"
	quest.11DD34E91AE6B53B.title: "ME便携式流体单元"
	quest.11F60954825FEF2B.quest_desc: ["如果目标物品不可用，插入导出总线即可向网络请求合成。同时启用等级发射器，在设定阈值时触发合成。需要高级卡才能合成。"]
	quest.11F60954825FEF2B.quest_subtitle: "允许导出总线（Export Bus）和电平发射器（Level Emitter）在物品缺货时触发自动合成。"
	quest.121F07DA327BC0E6.quest_desc: ["量子盔甲套装的每件装备都有25%的几率完全抵消所受伤害。穿戴全套可免疫所有伤害并获得创造模式般的飞行能力。"]
	quest.121F07DA327BC0E6.quest_subtitle: "终局头部盔甲，完整量子套装的一部分。"
	quest.124C78D84A86D64B.quest_desc: [
		"扩展器必须直接连接到机器或其他已连接的扩展器上。机器所能支持的扩展器最大数量由其机器核心的品质决定。品质更高的核心允许更复杂、分层的附加组件设置。"
		""
		"将鼠标悬停在机器核心图标上，即可在机器UI的左上角查看机器质量。"
	]
	quest.124C78D84A86D64B.quest_subtitle: "机器扩展插件用于增加机器可用的插件槽位数量。它本身不提供任何加成，但能让你放置比机器基础品质通常允许的更多插件。"
	quest.1252B455DCF21453.quest_desc: ["右键点击连接器并选择线圈，可将电线连接到另一个连接器。LV电线在16格内传输电流，损耗为1.25%，最大2048 IF/t。在玩家可接触的区域请使用绝缘版本以防触电。"]
	quest.1252B455DCF21453.quest_subtitle: "LV（低压）电力等级的铜线线圈。"
	quest.127610CE7CD5B2F5.quest_desc: ["放置于模式提供器旁，可自动接收原料并返回结果。多个装配器共享一个提供器，可同时工作。支持速度卡升级。"]
	quest.127610CE7CD5B2F5.quest_subtitle: "根据相邻的配方提供者所指示，执行单个的配方步骤。"
	quest.128D626EAF2986EA.quest_desc: ["生物类型由第一个走到控制器上的实体决定。该类型只能通过破坏并替换控制器来更改。一旦生物类型设置，控制器会高亮显示其下方所需的刷怪笼笼体大小。"]
	quest.128D626EAF2986EA.quest_subtitle: "刷怪控制器用于管理自动刷怪系统。将其放置在刷怪笼上方，即可用来刷出特定类型的生物。"
	quest.12E87700B0003145.quest_desc: ["将输入端的红石信号强度原样传输至输出端。使用记忆卡连接隧道：潜行右键点击输入端，再右键点击输出端即可绑定。"]
	quest.12E87700B0003145.quest_subtitle: "通过ME网络在两点之间传输红石信号。"
	quest.135D6B0AC9FE2478.quest_desc: ["它是硅晶圆和流体管道的原材料。也用于机器红石附加组件和肥料中。"]
	quest.135D6B0AC9FE2478.quest_subtitle: "一种用于电子和高级计算的纯化半金属。它以沙子和石英为基础。"
	quest.135E27A19B935CD7.quest_desc: [
		"右键点击链式传送带的链条以设置青蛙港的目标，然后放置青蛙港。青蛙港最多可以放置在目标链条的侧边和下方4个方块处。"
		""
		"蛙港只会接收与其地址匹配的物品。地址可以通过右键点击已放置的蛙港或其UI来设置。"
		""
		"除非在UI中设置为“仅发送包裹”，否则青蛙港只会发送与其地址不匹配的包裹。"
	]
	quest.135E27A19B935CD7.quest_subtitle: "Frogports 用于将 Cardboard Packages 搬进搬出 Chain Conveyors。"
	quest.14518E2BE509FE9E.quest_desc: ["管理ME网络的重要工具。用这把扳手破坏AE2方块，物品会安全留在方块内而不会掉落。"]
	quest.14518E2BE509FE9E.quest_subtitle: "旋转并拆解AE2机器，不会掉落物品。"
	quest.1458BE6B3726A232.quest_desc: ["灵性电容器是 Powah 最高等级组件之一。灵性组件需要稀有材料，但能带来卓越的性能。"]
	quest.1458BE6B3726A232.quest_subtitle: "Spirited Tier 已解锁"
	quest.146E9675E4C747C9.quest_desc: ["通过AE线缆或顶部/底部的FE供电。每个加速器可将生长速度提升约90倍。留出部分发芽方块的面以最大化晶体产量。"]
	quest.146E9675E4C747C9.quest_subtitle: "大幅加快相邻的 Budding Certus 方块和其他植物的生长速度。"
	quest.147FC2959F9FC5F5.quest_desc: [
		"&6火车&r是&3&3在轨道上运行的机械装置&r&r。"
		""
		"组装任务书"
		"1) 放置轨道，并用车站方块右键点击。将车站方块放置在轨道附近。"
		""
		"2) 右键点击车站并选择“创建列车”以进入组装模式（车站上会显示蓝色旗帜）。"
		""
		"3) 在蓝色标记的轨道上放置一个或多个 Train Casings。外壳将变成车厢。"
		""
		"4) 组装后，每个车厢将自动与火车的其他部分连接在一起。"
		" "
		"5) 将火车控制台朝向车站指定的方向放置。在控制台后方放置座位或烈焰燃烧器作为驾驶员座。"
		""
		"6) 使用超级胶水等方块附着工具将所有部分连接起来（绿色高亮）。"
		""
		"7) 完成后，使用车站的界面尝试组装列车。如果列车组装失败，车站界面会显示错误。常见错误详见下文。"
	]
	quest.147FC2959F9FC5F5.quest_subtitle: "火车外壳用于机车运输。"
	quest.14F476F9E4DA66F7.quest_desc: ["通过工程师工作台使用蓝图合成。用于电子元件、电路板和多种武器。中后期电气发展的关键材料。"]
	quest.14F476F9E4DA66F7.quest_subtitle: "一种用于电子元件和武器的真空管。"
	quest.1505A258938D0BEE.quest_desc: ["通过电解硫酸锰溶液生产。九种小粉尘可合成一种完整粉尘，用于不锈钢合金配方。"]
	quest.1505A258938D0BEE.quest_subtitle: "少量的锰，用于制作不锈钢。"
	quest.15463C9BF0ED728A.quest_desc: ["用2个铁锭和2个煤炭手工合成以缓慢开局，或使用碎矿机加熔炉以获得更高效率。一旦开始多区块建造，钢的需求量会非常大。"]
	quest.15463C9BF0ED728A.quest_subtitle: "大多数机器和结构配方中使用的核心奥里泰克合金。"
	quest.1552DB72D35B6E47.quest_desc: [
		"功能特性"
		"-Unbreakable: 该工具没有耐久度，永远不会损坏。"
		""
		"-Extended Reach: 手持时增加与方块和实体的交互距离。"
		""
		"-双模式：按 Shift + 右键可在两种模式之间切换。"
	]
	quest.1552DB72D35B6E47.quest_subtitle: "Prometheum Pickaxe 是一种不可损坏的高级挖掘工具。挖掘速度极快，并可在区域挖掘和精准采集之间切换。"
	quest.155C8ED420FB96A0.quest_desc: ["掉落到玩家附近的物品会直接吸入ME网络存储。通过终端界面开启或关闭磁体。需要高级卡才能制作。"]
	quest.155C8ED420FB96A0.quest_subtitle: "为无线终端添加了一个磁铁，可自动将附近的掉落物品拾取到网络中。"
	quest.1578CD99BF62B9DF.quest_desc: ["最大吞吐量线缆。使用氮化镓线缆连接最高等级的发电机，消除网络中的任何传输瓶颈。"]
	quest.1578CD99BF62B9DF.quest_subtitle: "最大传输电缆数量"
	quest.15792F2259536F4F.quest_desc: ["利用阳光产生FE。需要清晰的天空视野——上方有任何方块都会停止生产。放置在开阔处以获得稳定的被动电力。"]
	quest.15792F2259536F4F.quest_subtitle: "太阳能供电"
	quest.157E2E320FABF1CC.quest_desc: ["最强大的 Powah 水晶。用于制作所有 Nitro 级组件。"]
	quest.157E2E320FABF1CC.quest_subtitle: "氮气水晶"
	quest.1599CB66B5FF9631.quest_desc: ["每个多区块都需要入口来接收蒸汽、水或其他流体，并排出流体副产品。将它们放置在多区块的框架上，而不是外壳方块上。"]
	quest.1599CB66B5FF9631.quest_subtitle: "用于将流体进出多区块的输入和输出口。"
	quest.1599CB66B5FF9631.title: "青铜流体舱门"
	quest.15EB55A74D9E45FF.quest_desc: ["用于融合反应堆、等离子涡轮等终局多模块。右键点击任意机器，将其升级为量子级，并将电缆接口升至最高电压。"]
	quest.15EB55A74D9E45FF.quest_subtitle: "终极机器外壳，由量子电路建造而成。"
	quest.1628EA94239174BF.quest_desc: ["镉、铍和防爆合金的压制板。用于核反应堆的核心结构方块——核外壳和核舱门。"]
	quest.1628EA94239174BF.quest_subtitle: "一种能抵抗热量和辐射的致密板状物。"
	quest.1640E9FAB3710E00.quest_desc: ["运作方式与普通精炼炉相同，但接受涉及不祥之智和其他稀有输入的配方。用于该模组中一些较为奇特的流体链。"]
	quest.1640E9FAB3710E00.quest_subtitle: "用于特殊处理链的炼油厂的腐化变种。"
	quest.1674D9532E8AE19C.quest_desc: ["可在同一维度内的任何地方，无线为绑定玩家的物品（包括盔甲和副手）充电。使用绑定卡进行绑定。"]
	quest.1674D9532E8AE19C.quest_subtitle: "无线充电"
	quest.16B623EFDB934ADB.quest_desc: [
		"&4&l核反应堆&r&r"
		"&a&l粒子加速器&r&r"
		"&5&l原子锻造炉&r&r"
		"&0&l奇点&r&r"
	]
	quest.17133BDB056D6AE9.quest_desc: ["比硬化熔炉器更快地燃烧燃料以产生FE。每单位燃料的能量保持不变——增加的是生成速度。"]
	quest.17133BDB056D6AE9.quest_subtitle: "烈焰熔炉动力"
	quest.177C0E37A35A14F4.quest_desc: [
		"当由动能驱动时："
		""
		"开始将附着的结构朝向当前小时旋转。如果第一个结构前方存在独立的第二个结构，它将作为分针使用。"
		""
		"价值设置界面位于方块侧面，可用于更改显示顺序或切换到类似时钟物品的24小时制。"
	]
	quest.177C0E37A35A14F4.quest_subtitle: "钟表轴承是机械轴承的进阶版，可根据当前游戏时间旋转最多两根钟表的指针。"
	quest.179612CD2067008D.quest_desc: ["接近顶级活力棒。在球体周围放置数个活力棒，大多数配方都能近乎即时完成。"]
	quest.179612CD2067008D.quest_subtitle: "接近最大吞吐量"
	quest.17E0F7A3AB88C7B0.quest_desc: ["用铝板和铜线制作。可在合成器中与其他组件结合，形成用于MV级机械的电子电路。"]
	quest.17E0F7A3AB88C7B0.quest_subtitle: "用于MV级电路的铝基电路板。"
	quest.1837076B0EA3C11A.quest_desc: [
		"机械传动带是一种传递旋转、移动物品和实体的机械组件。"
		""
		"放置传送带需要至少两个&6竖井&r。右键第一个竖井，再右键第二个即可放置。无论长度如何，都只消耗一条机械传送带。两个竖井必须朝向同一方向。"
		""
		"机械皮带可以放置在由水平、垂直或对角（朝向y轴45度）排列的单排多个转轴上，前提是没有障碍物且总长度不超过二十个方块。机械皮带还要求两个转轴朝向相同。"
	]
	quest.1837076B0EA3C11A.quest_subtitle: "用于用机械皮带连接两个平行的竖井，以传递旋转和移动物品。"
	quest.18534D85674467A2.quest_desc: ["站在流体储罐旁，或手持可饮用液体的桶时右键，即可饮用。适用于饮用液体经验、药水、牛奶、蜂蜜或其他 Create 扩展添加的自定义可饮用流体。"]
	quest.18534D85674467A2.quest_subtitle: "一个简单的吸管，可以直接从储罐或桶里喝液体。"
	quest.18594A0013B696D4.quest_desc: ["默认情况下，信号从下坡方向发出。数值框可配置对应完整15强度信号的角度，并可反转输出方向。每个轴独立读取，因此单个Gimbal Sensor可为同一飞行器的俯仰和横倾驱动独立的自动调平电路。"]
	quest.18594A0013B696D4.quest_subtitle: "根据装置的俯仰、横滚和偏航输出模拟红石信号。"
	quest.187211CD5B4C5488.quest_desc: ["每秒散发的热量与相邻方块的温度成正比——邻近的方块越热，冷却越快。通风口廉价且无需冰块，是大多数小型反应堆设计的核心。"]
	quest.187211CD5B4C5488.quest_subtitle: "一个被动冷却组件，可从最热的相邻方块中移除热量。"
	quest.187A33B12FCCFE75.quest_desc: ["可无线高速为链接玩家的物品充电。此等级可跟上大多数高功率工具在游戏中的充电速度。"]
	quest.187A33B12FCCFE75.quest_subtitle: "Niotic 无线充电器"
	quest.18A6C13EDFF60CAF.quest_desc: ["每发消耗800IF。使用钢棒、铁棒或其他金属物品作为投射物。伤害随投射物材料而变化。在工程师工作台用散热器（加快装填）和瞄准镜（可缩放）进行升级。"]
	quest.18A6C13EDFF60CAF.quest_subtitle: "一种以高速发射金属棒的电磁轨道炮。"
	quest.18C950FD6B1095E4.quest_desc: ["结构与蒸汽采石场相同，但由EU而非蒸汽驱动，因此能超频运行，矿石产量更快。运行时消耗钻头。"]
	quest.18C950FD6B1095E4.quest_subtitle: "蒸汽采石场的电力升级版本。"
	quest.190E3832116C398A.quest_desc: ["将锭压缩成板，比例为1:1，并用双锭使产量翻倍。几乎所有蒸汽时代配方都需要板，所以这是你应该建造的第一台青铜机器。"]
	quest.190E3832116C398A.quest_subtitle: "一种将锭子变成板件的蒸汽机。"
	quest.193DB50FA4DAE2C6.quest_desc: ["每个轴上的电线杆必须形成封闭的矩形以定义捕获体积。每条连续的电线杆线使用1个网络通道。每行至少需要2根电线杆。"]
	quest.193DB50FA4DAE2C6.quest_subtitle: "定义了用于空间IO捕获操作的空间场的边界。"
	quest.194A90AFBE502859.quest_desc: ["导入总线从相邻物品栏中拉取物品，导出总线向外推送物品，存储总线则将外部物品栏暴露为网络存储。结合升级卡实现精确控制。"]
	quest.194A90AFBE502859.quest_subtitle: "总线将你的ME网络与外部世界连接，实现物品的导入、导出和访问外部存储。"
	quest.1956D5445A6C0348.quest_desc: ["当机器开始缺少附加组件插槽时，替换此物品。每个等级都会增加多区块所能处理的附加组件和扩展层总数。"]
	quest.1956D5445A6C0348.quest_subtitle: "中后期多区块结构所需的高品质机器核心。"
	quest.19754AE8C11A6317.quest_desc: ["将工具、武器或方块放入部署器，赋予其功能。当物品从上方掉落时，它会攻击生物、放置方块、收割作物、装满水桶或执行配方。上方的漏斗可自动为其提供物品。"]
	quest.19754AE8C11A6317.quest_subtitle: "部署器在获得旋转力后，会像玩家一样进行攻击和使用物品。"
	quest.197AB0E07A40512F.quest_desc: ["将水轮尽可能多地放置在流动水的相邻侧，以最大化其旋转输出。大型水轮是一个3x3的多方块结构，产生的旋转力远大于小型水轮。"]
	quest.197AB0E07A40512F.quest_subtitle: "水车是一种旋转动力源。当水流过时，它会生成旋转力。"
	quest.19D9034316B75460.quest_desc: ["基础棒比入门棒的输入输出更高。多个棒围绕能量球放置，可叠加吞吐量以加快制作。"]
	quest.19D9034316B75460.quest_subtitle: "每根魔杖获得更多能量"
	quest.1B04A295850D0F00.quest_desc: ["放置在铁轨旁以检测火车经过。轨道观察者会发出红石信号，可过滤以响应特定火车、货物或时刻表条目。"]
	quest.1B04A295850D0F00.quest_subtitle: "火车观察者用于检测经过的火车。"
	quest.1B1874D974567D5F.quest_desc: ["Oritech 中最好的核心。适合需要多层扩展器和全套附加组件的满载机器。"]
	quest.1B1874D974567D5F.quest_subtitle: "顶级机器核心，提供最高的多方块质量。"
	quest.1BB4767075B9534E.quest_desc: ["用小麦、土豆、甘蔗或其他植物喂食。此处的乙醇会与压榨机产生的植物油在炼油厂中结合，生产生物柴油。保持此流程自动化以确保燃料稳定供应。"]
	quest.1BB4767075B9534E.quest_subtitle: "将作物转化为乙醇，用于生产生物柴油。"
	quest.1C032D0D0A89C70E.quest_desc: ["用一本书和一个杠杆来制作。手册包含所有多方块结构、机器配方和布线的建造图。请随时将其放在快捷栏中。"]
	quest.1C032D0D0A89C70E.quest_subtitle: "工程师手册——你的必备游戏内参考指南。"
	quest.1C1750EF62B5F965.quest_desc: ["插入导入或导出总线，可将过滤条目扩展至最多5张卡。更多的过滤槽位使选择性自动化管理更简单，无需多个总线。"]
	quest.1C1750EF62B5F965.quest_subtitle: "为AE2设备添加了额外的过滤槽，允许更精确的白名单或黑名单。"
	quest.1C4BF710A2F8C7A6.quest_desc: ["通过结合相同等级的速度和效率附加组件生成。比纯速度附加组件攻击性低，但在常开机器中更容易维持。"]
	quest.1C4BF710A2F8C7A6.quest_subtitle: "混合附加组件，在提高速度的同时，减轻部分额外的能量消耗。"
	quest.1C4BF710A2F8C7A6.title: "效率与速度"
	quest.1C9DE408C1A1246B.quest_desc: ["将其放置在反应堆的任何一面墙上。右键控制器以组装或重新检查结构，并使用其UI来监控燃料、热量和能量输出。"]
	quest.1C9DE408C1A1246B.quest_subtitle: "核反应堆多区块结构的控制核心。"
	quest.1C9DE408C1A1246B.title: "&4&l核反应堆&r&r"
	quest.1CC319979AA132AB.quest_desc: ["利用薛定谔方程的原始力量，任何被击中的实体都会立即死亡。现代工业化的终极武器。"]
	quest.1CC319979AA132AB.quest_subtitle: "能瞬间气化任何目标的量子武器。"
	quest.1CDCAC69B9D62348.quest_desc: ["将每立方米普通蒸汽转换为1 EU，每立方米高压蒸汽转换为8 EU，最高可达16,384 EU/t。注意：它不返回任何水，需搭配热交换器回收高压水。"]
	quest.1CDCAC69B9D62348.quest_subtitle: "一个可接受普通蒸汽和高压蒸汽的多块涡轮机。"
	quest.1D99B9B0CBE267E0.quest_desc: ["在化学反应器中生产，用于溶解含锰材料和精炼油。是一款核心的中后期化学流体。"]
	quest.1D99B9B0CBE267E0.quest_subtitle: "在化学反应器中生产的强酸。"
	quest.1DA2A4200ED6542F.quest_desc: ["将其连接到量子桥后插入无线终端，即可实现无距离限制的无线访问。需要高级卡来制作。"]
	quest.1DA2A4200ED6542F.quest_subtitle: "将您的无线终端连接到跨越无限距离的ME网络，甚至可以跨维度连接。"
	quest.1DBA8DD396081924.quest_desc: ["接口必须面对面放置，间隔1-2格，一个在带流体储罐的机械装置上，另一个固定不动。需要流体泵将液体注入或抽出机械装置。要将液体泵送到另一个储罐，只需将固定接口和储罐用流体管道连接，但仍需泵来移动液体。"]
	quest.1DBA8DD396081924.quest_subtitle: "便携式流体接口用于向机械装置的流体库存中插入或提取流体。"
	quest.1E07FBD17CE427D9.quest_desc: ["用于安全存放核燃料、炸药和黑洞组件等易挥发材料。该模组最危险物品的配方中需要此物。"]
	quest.1E07FBD17CE427D9.quest_subtitle: "用于运输危险终局物品的加固容器。"
	quest.1E22AF3E3AF63D3E.quest_desc: ["通过压缩铱锭获得。一种稀有的致密板，用于量子电路板和末期其他合成。"]
	quest.1E22AF3E3AF63D3E.quest_subtitle: "一盘极其致密的贵金属制成的盘子。"
	quest.1E6756594847F70D.quest_desc: ["Energizing Orb 使用 FE 处理特殊配方。在 9 格内放置至少一根 Energizing Rod，将其连接到电源，然后用配方材料右键 Orb。"]
	quest.1E6756594847F70D.quest_subtitle: "活力充沛的装置设置"
	quest.1E6756594847F70D.title: "注入能量中"
	quest.1E7FE1C207ACA95F.quest_desc: ["这个3x5x1的多方块使用可互换的模具来压制组件。可用模具：板、杆、线、齿轮、子弹壳和包装。可用传送带自动化——物品从上方落下并从侧面排出。"]
	quest.1E7FE1C207ACA95F.quest_subtitle: "将锭冲压成板、棒、线和其他形状。"
	quest.1EB7B268E95308DC.quest_desc: ["比青铜压缩机更快地生产板、双层板等多种形状。在LV上可自动超频至32 EU/t。"]
	quest.1EB7B268E95308DC.quest_subtitle: "青铜压缩机的LV级电动版本。"
	quest.1F12AF347184699F.quest_desc: ["为机器的储能增加额外容量。堆叠多个可让机器在断电后持续运行更久，或吸收快速发电机产生的脉冲。"]
	quest.1F12AF347184699F.quest_subtitle: "增加机器的内部RF缓冲容量。"
	quest.1F47050EF1B2DD29.quest_desc: ["将变压器放置在LV和MV电网之间以升压或降压。LV从小线圈侧输入，MV从大线圈侧输出。如有需要，可用螺丝刀反转方向。"]
	quest.1F47050EF1B2DD29.quest_subtitle: "将LV电力转换为MV，反之亦然。"
	quest.1FDBB75ECD39FB24.quest_desc: [
		"物品抽取器一次最多可容纳 1500mb 的流体。需要流体泵来抽取流体。"
		""
		"水槽会自动将产物流体倒入放置在附近的物品排水器中。"
	]
	quest.1FDBB75ECD39FB24.quest_subtitle: "物品抽取器可以从放置在其上的桶和瓶子等物品中抽取流体。"
	quest.1FDD66162316013C.quest_desc: ["用处理过的木栅栏建一个至少3x3x3的空心矩形框架，然后用锤子右键底部中心。如需大量流体，可扩展尺寸。缓冲生物柴油和其他工艺流体所必需。"]
	quest.1FDD66162316013C.quest_subtitle: "可扩展的多方块储罐，用于批量流体存储。"
	quest.2030693D3DAA8894.quest_desc: ["结合量子比特、冷却单元和量子电路板。量子机器外壳及所有量子升级或终局装备所需。"]
	quest.2030693D3DAA8894.quest_subtitle: "所有量子级机器都使用的终局电路。"
	quest.205FB8637491CDAE.quest_desc: ["优先级高的驱动器会先填充，最后清空。每个插槽的LED灯会显示单元格的填充状态。物品和流体单元格可以混合在同一个驱动器中。"]
	quest.205FB8637491CDAE.quest_subtitle: "ME 驱动器最多可容纳 10 个 ME 存储单元，构成网络的主要物理存储。"
	quest.20872740F5F79B26.quest_desc: ["以高速度为相邻物品栏中的FE物品充电。非常适合保持整箱工具或电池完全充满。"]
	quest.20872740F5F79B26.quest_subtitle: "Niotic 物品充能"
	quest.2090C7FA0A352D0E.quest_desc: ["氮化电容是 Powah 的巅峰之作。所有氮化级组件都能为末游阶段的能源需求提供最大容量和吞吐量。"]
	quest.2090C7FA0A352D0E.quest_subtitle: "氮气等级：峰值功率"
	quest.20A46CA1B63C7C97.quest_desc: ["连接到高压电线网络。激活后，特斯拉线圈会持续对范围内的所有生物造成伤害。可与红石破坏器或破坏器开关结合以控制激活。一种强大的自动化基地防御工具。"]
	quest.20A46CA1B63C7C97.quest_subtitle: "通电时会电击附近的生物。"
	quest.20D210486DF2504E.quest_desc: ["插入导入/导出总线以启用模糊匹配。支持四种模式：忽略所有、匹配损坏、匹配NBT、匹配两者。需要高级卡来制作。"]
	quest.20D210486DF2504E.quest_subtitle: "允许AE2设备无视物品耐久度或NBT数据进行匹配。"
	quest.20E81D9330FA1564.quest_desc: ["一旦你的机械装置能移动，就需要控制它。这里解锁的方块涵盖了人类端输入（方向盘、油门杆、联动打字机），以及将机械装置的状态转化为红石的传感器和无线连接方块，还有将两艘船合并为一个刚性结构的对接连接器。"]
	quest.20E81D9330FA1564.quest_subtitle: "导航：驾驶舱方块用于实际驾驶、操作和连接一个机械装置。"
	quest.2134C15C42E7C1CD.quest_desc: ["每刻携带的流体比普通管道多得多。适用于炼油厂或反应堆冷却循环的主动脉，普通管道会在此处造成瓶颈。"]
	quest.2134C15C42E7C1CD.quest_subtitle: "一组传输速率更高的流体管道束。"
	quest.21A830CC8DAD6566.quest_desc: [
		"右键点击铁轨，然后将车站放置在距离铁轨15格以内。只有在笔直的轨道上才能建造火车，而转向架只能放置在长度为3格的笔直轨道上。"
		""
		"在界面中可以为车站命名；非玩家乘务员将以此命名来识别车站。乘务员无法被指令导航至与当前所在车站同名的车站，否则将从多个同名车站中选择最近的可到达车站。"
		""
		"如果使用在车站上，名称也会显示在地图上，与旗帜类似。"
	]
	quest.21A830CC8DAD6566.quest_subtitle: "火车站用于创建、拆解和引导火车。"
	quest.21B40BEC30B40491.quest_desc: [
		"手持漏斗时，玩家无法访问物品栏，而是放置漏斗。潜行右击漏斗可将其置于输入模式。"
		""
		"用扳手点击漏斗可切换其输入和输出模式。红石信号可阻止漏斗的输入或输出。右键点击机械带上的漏斗，可使其向前延伸一个方块。"
	]
	quest.21B40BEC30B40491.quest_subtitle: "安山岩漏斗用于将材料提取到或放入物品栏中，性质与黄铜漏斗相似。"
	quest.21B40BEC30B40491.title: "漏斗"
	quest.21CE50730E9BA0B3.quest_desc: ["最高级的合成存储。非常适合涉及多种中间材料的深度递归或复杂的自动化合成链。"]
	quest.21CE50730E9BA0B3.quest_subtitle: "为ME Crafting CPU提供256k字节的合成存储。"
	quest.21DB908D7DFAAD84.quest_desc: ["可作为普通传送带使用，但红石供电时会暂停。可用于创建缓冲带、定时释放门，或在自动化生产线中控制机器间的物品流动。"]
	quest.21DB908D7DFAAD84.quest_subtitle: "接收到红石信号时，会阻止物品的移动。"
	quest.223202251340B498.quest_desc: ["通过末地网络传输大量FE。适用于覆盖多个区域的大型分布式电网。"]
	quest.223202251340B498.quest_subtitle: "充满活力的末地网络"
	quest.224113E3E4EFED0D.quest_desc: ["Oritech 是一个包含众多新机器和工具的科技模组。内容涵盖加工机器、世界交互机器、物流组件、整合进世界生成的新功能、装备等。机器多为可动画化的多方块结构，升级则通过附加方块实现。"]
	quest.224113E3E4EFED0D.quest_subtitle: "一个以科技为主题的模组，包含动画机械、多样的处理选项，以及大量新机制和装备"
	quest.228124D466758B61.quest_desc: ["接口可自动从网络中存储物品，并充当子网之间的桥梁。子网络可让您隔离存储、保存通道和构建模块化自动化系统。"]
	quest.228124D466758B61.quest_subtitle: "你的网络已准备好用于子网络和高级物流。"
	quest.228CD1314315A9E9.quest_desc: ["轻型、重型和重型工程方块是建造柴油发电机和其他后期多区块的结构组件。发电机和散热器方块是柴油发电机的功能核心。"]
	quest.228CD1314315A9E9.quest_subtitle: "工业工程大型多方块机器的核心结构方块。"
	quest.228CD1314315A9E9.title: "多区块方块 (Multiblocks Blocks)"
	quest.22ADEF33B5CE9504.quest_desc: ["将喷气背包装备在胸甲栏位。按住&e跳跃&r键上升，潜行下降。在Banktank站或通过插入已充气的瓶子来补充压缩空气。空气消耗量随垂直速度和海拔升高而增加。"]
	quest.22ADEF33B5CE9504.quest_subtitle: "来自 Create 的喷气背包：Jetpack — 使用内置的 Banktank 储存的压缩空气进行飞行。"
	quest.2380F699DCA74863.quest_desc: ["右键电容器并用电压表读取其储能水平。点击电线时还会显示电线损耗和其他诊断信息。是排查电网故障的必备诊断工具。"]
	quest.2380F699DCA74863.quest_subtitle: "测量相连电容器中储存的能量。"
	quest.23A9A2D399A7BF94.quest_desc: [
		"电梯滑轮与绳索滑轮类似，共享部分功能。但与绳索滑轮不同，它能穿过方块，除非右键点击滑轮，否则不会变回方块。"
		""
		"要组装电梯滑轮，装置中必须只有一个水平的红石接触器。如果添加了多个，电梯将无法组装。如果以上任一条件不满足，在查看电梯滑轮时会显示相应的错误信息。"
	]
	quest.23A9A2D399A7BF94.quest_subtitle: "电梯滑轮是一种有助于轻松建造多层电梯的装置。"
	quest.23E8AF1037E20880.quest_desc: ["Niotic Reactor 产生的 FE 远高于低阶反应堆。使用 36 个 Niotic Reactor 方块建造 3x4 的多方块结构，以获得高输出的核能。"]
	quest.23E8AF1037E20880.quest_subtitle: "Niotic Nuclear Power"
	quest.24CB634D4A52A13E.quest_desc: [
		"除了基本的矿石加工，粉碎机通常用于研磨生物质以发电，或生产煤粉用于碳复合材料。"
		""
		"输出栏中的小粉尘在可能的情况下会自动合并。"
	]
	quest.24CB634D4A52A13E.quest_subtitle: "粉碎机是一个缓慢而简单的方块，可将矿石和生物质粉碎成粉尘。"
	quest.24D36EEF14875117.quest_desc: ["由安德瑞化合物、亚丹和处理器单元组装而成。作为所有奥里泰克激光器和多种与视野相关的玩家增强组件的聚焦元件。"]
	quest.24D36EEF14875117.quest_subtitle: "末地透镜是传感器、激光器和视觉增强器中使用的紧凑部件。"
	quest.24DDED464AE48E05.quest_desc: ["放置在两个Shafts之间以控制旋转。没有红石时，它会正常传递旋转。当有红石供电时，旋转方向会反转，但不会影响速度。"]
	quest.24DDED464AE48E05.quest_subtitle: "当红石信号被施加时，会反转输出的旋转力。"
	quest.24E110DD6901A761.quest_desc: ["将其放置在有提取功能的管道旁，然后向其输入RF。可用能量越多，物品或流体从相连的容器中抽取的速度就越快。"]
	quest.24E110DD6901A761.quest_subtitle: "管道助推器是高吞吐量物流网络的升级组件。将其放置在管道提取点旁并用RF供电，可大幅提升物品和流体从相连容器中抽取的速度。"
	quest.24F3C167EF240473.quest_desc: ["一个输入隧道可以分配给多个输出以进行物品路由。使用记忆卡链接隧道：潜行右键点击输入，再右键点击每个输出。每对ME P2P隧道使用1个频道。"]
	quest.24F3C167EF240473.quest_subtitle: "无需单独的物品运输，即可在网络的两点之间传输物品。"
	quest.25204D6C0F67747A.quest_desc: ["熔炼速度与原版熔炉相同，但使用蒸汽而非固体燃料，搭配锅炉后燃料效率提升约十倍。"]
	quest.25204D6C0F67747A.quest_subtitle: "用于高效熔炼的蒸汽动力熔炉。"
	quest.25B581A958F22442.quest_desc: ["光学传感器会投射内部光束，并发出红石信号，其强度取决于障碍物方块的距离。在数值面板中调整最大探测距离，并使用过滤器限制特定方块：适用于跑道检测、自动着陆和飞行中躲避附近墙壁。"]
	quest.25B581A958F22442.quest_subtitle: "检测传感器前方最近的方块，并以红石信号报告其距离。"
	quest.25B5ED085EF3C1A0.quest_desc: ["增压器消耗能量产生高压蒸汽，但大型蒸汽轮机不回收高压水。热交换器从废蒸汽中回收高压水以供重复使用，从而大幅降低能耗。"]
	quest.25B5ED085EF3C1A0.quest_subtitle: "回收已消耗的HP蒸汽中的HP水以供重复使用。"
	quest.25C4C27A852AEB1A.quest_desc: ["铀矿在地下开采，用作反应堆多区块结构的燃料。熔炼铀矿石即可获得。"]
	quest.25C4C27A852AEB1A.quest_subtitle: "核燃料 (Nuclear Fuel)"
	quest.26FD4BA4B2780AFF.quest_desc: ["占领一个区域后，该单元将永久分配这些维度。使用空间IO端口来存储和检索空间内容。更高级别的单元支持更大的体积。"]
	quest.26FD4BA4B2780AFF.quest_subtitle: "存储了由 Spatial IO 系统捕获的 2x2x2 物理空间区域。"
	quest.271132D9BB3DB4C1.quest_desc: ["从已充能的物品中抽取FE并发送到你的网络。Blazing版本的提取速度比Hardened版本更快。"]
	quest.271132D9BB3DB4C1.quest_subtitle: "烈焰能量提取器"
	quest.2740D458F64ED143.quest_desc: ["同色电缆可自动连接，异色则不可，让你能在同一空间布设并行线路。当单条线路需要超过8个通道时，请使用密集电缆。"]
	quest.2740D458F64ED143.quest_subtitle: "基础AE2线缆，可传输最多8个频道，连接所有网络设备。"
	quest.276AC4E6504EA7E8.quest_desc: ["大容量FE缓冲器。Niotic Cell能储存足够的能量，为大型发电机或多个机器同时提供缓冲。"]
	quest.276AC4E6504EA7E8.quest_subtitle: "大容量缓冲器"
	quest.2838DAC61BC66E6D.quest_desc: ["可产出铜、锡及其他用于电缆和电子元件的电线。将其产物与橡胶片结合，即可制作相应等级的电缆。"]
	quest.2838DAC61BC66E6D.quest_subtitle: "一种将锭拉成线的钢制多块结构。"
	quest.283CCD1DAFB4EF83.quest_desc: ["插入导入/导出总线，即可导入/导出除所列物品外的一切。无需逐一枚举物品，即可轻松设置广泛的自动化。"]
	quest.283CCD1DAFB4EF83.quest_subtitle: "将设备的过滤列表从白名单转换为黑名单。"
	quest.289AACEC4A871AC9.quest_desc: ["终极无线充电器。可跨维度为链接玩家的整个物品栏充电，无视工具能耗。"]
	quest.289AACEC4A871AC9.quest_subtitle: "Nitro 无线充电器"
	quest.28D6BCECF0282EB3.quest_desc: ["在化学反应器中用盐和硫酸生产。用于溶解含铬化合物，进一步加工成不锈钢原料。"]
	quest.28D6BCECF0282EB3.quest_subtitle: "在化学反应器中生产的强酸。"
	quest.294341A06EB742AD.quest_desc: ["在电动高炉中冶炼铝土矿粉，或先电解铝土矿以提高产量。所有MV级机器外壳和电路所需。"]
	quest.294341A06EB742AD.quest_subtitle: "在电动高炉中熔炼的一种轻质金属。"
	quest.29B1C295E5FD899B.quest_desc: ["无需额外电缆即可远距离传输电力。一个输入隧道可为多个输出供电。使用记忆卡连接隧道。"]
	quest.29B1C295E5FD899B.quest_subtitle: "通过ME网络在两点之间传输Forge能量（RF/FE）。"
	quest.2A404708E175235F.quest_desc: [
		"流体可以通过流体管道在流体储罐中存储和提取。流体管道可以放置在储罐的任何一面：顶部、底部或侧面。储罐的窗口可以用扳手切换。"
		""
		"流体管道的流向表示流体是流入储罐还是流出储罐；如果流体流向储罐，则流体将被储存在储罐中。同样，如果流体管道远离储罐（通过机械泵），则储罐中的流体将被抽出到该管道中。"
	]
	quest.2A404708E175235F.quest_subtitle: "流体储罐是一种流体存储装置，每个方块最多可存储8桶流体。"
	quest.2A41C8154F3E2FBA.quest_desc: ["燃料端口输入颗粒，吸收端口输入冰块进行主动冷却，能量端口每个可推高至25,000 RF/t，红石端口则通过比较器控制燃料输入或输出反应堆数据。"]
	quest.2A41C8154F3E2FBA.quest_subtitle: "反应堆多区块结构的输入和输出端口。"
	quest.2A41C8154F3E2FBA.title: "反应堆端口"
	quest.2A4B2961FF3B9020.quest_desc: ["蕴含精神能量的以太水晶。用于制作精神系组件。"]
	quest.2A4B2961FF3B9020.quest_subtitle: "灵性水晶"
	quest.2A56950F549955A0.quest_desc: ["无需物理接触每台机器，即可在任意连接的配方提供者中搜索、查看和编辑配方。管理大型自动化合成系统不可或缺。"]
	quest.2A56950F549955A0.quest_subtitle: "显示网络中所有模式提供者存储的模式，支持远程管理。"
	quest.2A65DC22E1A254FC.quest_desc: ["将棒放入反应堆，并通过每根柱子上方的燃料端口供应燃料棒。每块放置的棒越多，产生的热量和RF就越高，但需要更多的冷却来保持稳定。"]
	quest.2A65DC22E1A254FC.quest_subtitle: "反应堆的燃料燃烧核心，有单、双和四重三种变体。"
	quest.2A65DC22E1A254FC.title: "反应堆燃料棒"
	quest.2AFC646EF1E1FFBD.quest_desc: ["燃烧岩浆等高温流体以产生FE。更高等级产出的FE/t更高，但消耗流体更快。连接流体管道以保持供应。"]
	quest.2AFC646EF1E1FFBD.quest_subtitle: "熔岩驱动"
	quest.2B39FC965869395C.quest_desc: ["消耗岩浆或其他高温流体，产生的FE/t远高于硬化版。保持稳定的流体供应以维持其运行。"]
	quest.2B39FC965869395C.quest_subtitle: "更热的熔岩力量"
	quest.2B5535981ED79938.quest_desc: ["在锻造台用下界合金锭升级普通喷气背包，可获得下界合金喷气背包。它能储存更多压缩空气，并在长时间飞行时保护穿戴者免受火焰和岩浆的伤害。"]
	quest.2B5535981ED79938.quest_subtitle: "经过强化的下界合金级喷气背包，拥有更大的空气容量和完全防火能力。"
	quest.2B82FD333EDA0DED.quest_desc: ["快速从已充能的物品中提取FE并发送到你的电力网络。适用于从存储或备用电池中回收能量。"]
	quest.2B82FD333EDA0DED.quest_subtitle: "Niotic FE 提取器"
	quest.2BE4057C9F6A8D31.quest_desc: ["功能上与8通道的Fluix玻璃线缆完全相同。使用覆盖线缆可使结构更整洁或减少视觉杂乱。两种类型共享相同的颜色连接系统。"]
	quest.2BE4057C9F6A8D31.quest_subtitle: "玻璃线缆的视觉更整洁的变种，将线缆纹理隐藏在实心方块内。"
	quest.2C75A3D98E9A8BB0.quest_desc: ["适用于大型建筑或生物刷怪塔的中等空间单元。占领一个区域后，单元大小将永久固定。可与空间柱和空间IO端口结合使用。"]
	quest.2C75A3D98E9A8BB0.quest_subtitle: "存储了由 Spatial IO 系统捕获的 16x16x16 物理空间区域。"
	quest.2C860AA192FF0116.quest_desc: ["终极AE2终端。通过单个物品访问所有网络功能。用存储卡将其绑定到无线接入点，并添加无线增强器以扩大范围。"]
	quest.2C860AA192FF0116.quest_subtitle: "将所有终端类型整合到单个无线设备中：存储、合成、模式编码和模式访问。"
	quest.2CD70FCC8B119D7A.quest_desc: ["泵上的棕色箭头符号表示流动方向。使用扳手可以改变流动方向。使用扳手时，整个阀门看起来会旋转180度。棕色的方向箭头会出现在泵齿轮的另一侧。"]
	quest.2CD70FCC8B119D7A.quest_subtitle: "机械泵一次只能将流体朝一个方向移动。"
	quest.2D2EAA51286CD51A.quest_desc: ["一旦机械装置能飞行或滚动，就需要传感器来读取周围环境、磁体和绳索用于物理连接，以及激光系统来探测距离和障碍物。"]
	quest.2D2EAA51286CD51A.title: "更多方块"
	quest.2D3144CB915A304C.quest_desc: ["用机械压机将铜或金锭压成线，然后将线卷到空的线轴上。铜线轴和金线轴是制作交流发电机、电动机、连接器和其他电气机器所必需的。"]
	quest.2D3144CB915A304C.quest_subtitle: "一卷电线，是 Create: Crafts & Additions 中电气元件的基础。"
	quest.2D3F0254AB0F9F16.quest_desc: ["将其安装到任何接受附加组件的机器插槽中。多个处理附加组件可组合使用，以消耗更多能量为代价换取显著的速度提升。"]
	quest.2D3F0254AB0F9F16.quest_subtitle: "缩短机器完成每项操作所需的时间。"
	quest.2D70F503EA6F2994.quest_desc: ["螺旋桨轴承会将前方的结构视为螺旋桨；任何至少有二个船帆状方块的布局都算数，但船帆越多产生的推力越大。木制和安山岩螺旋桨是最简单的桨叶。先从这里开始，理解轴承后再尝试更大或手工建造的螺旋桨形状。"]
	quest.2D70F503EA6F2994.quest_subtitle: "基础螺旋桨叶片：在螺旋桨轴承前组合它们以制作一个可用的螺旋桨。"
	quest.2D70F503EA6F2994.title: "螺旋桨"
	quest.2D8D3AD2714AE611.quest_desc: [
		"可用于从碎片锻造炉获得的矿石团中提取矿石粉尘，将煤炭粉尘纺成碳纤维丝，或处理各种液体。"
		""
		"这使得离心机成为 Oritech 的主要升级机器之一，因为它位于矿石精炼、组件生产以及后期的石油和塑料链条之间。"
		""
		"&l流体分离&r"
		""
		"流体可以直接泵入和泵出离心机方块本身，而非附加组件。附加组件仅用于启用流体处理兼容性。常见用途包括将原油提炼成不同燃料，或将小麦加工成塑料片。"
		""
		"如果流体配方未启动，通常是因为附加组件已安装，但机器状态尚未刷新。放置附加组件后，请打开机器以使其正确初始化。"
	]
	quest.2D8D3AD2714AE611.quest_subtitle: "离心机通过高速旋转来分离和转化物品。"
	quest.2DA0527BD1EED709.quest_desc: ["燃烧时间是普通煤炭的4倍，可被研磨成焦炭粉，用于未锻钢配方。焦炭炉的主要产物。"]
	quest.2DA0527BD1EED709.quest_subtitle: "在焦炭炉中生产的一种高能量燃料。"
	quest.2DB25CF289FAAF6C.quest_desc: ["Powah 手册是一本游戏内参考书，涵盖了每个等级的所有方块、物品和能量数值。请随身携带。"]
	quest.2DB25CF289FAAF6C.quest_subtitle: "Powah 指南手册"
	quest.2E20E50095EF62F8.quest_desc: ["通过离心分离机用小麦和水处理，或在炼油厂用石油衍生品生产。出现在电路板、机器外壳和许多后期合成配方中。"]
	quest.2E20E50095EF62F8.quest_subtitle: "塑料是一种有用的聚合物，可用于制造绝缘体、外壳以及许多中后期游戏组件。"
	quest.2E66275A4A0295F6.quest_desc: ["在巨大的点火脉冲后，将氘、氚或氦-3结合成氦等离子体。将等离子体送入等离子涡轮机，可产生约1 MEU/t的功率——模组中最高。"]
	quest.2E66275A4A0295F6.quest_subtitle: "终极能源，将氢同位素聚变为等离子体。"
	quest.2E74FA693DB180C5.quest_desc: ["无需共享频道或存储访问权限，即可从主网络为子网络供电。也是分隔相邻网络段比彩色线缆更便宜的替代方案。"]
	quest.2E74FA693DB180C5.quest_subtitle: "在两个网络之间传输AE能量，无需逻辑连接。"
	quest.2EB7C4022E270816.quest_desc: ["Powah 中燃烧最快的发电机。消耗燃料极快——此阶段必须配备全自动的大规模燃料供应系统。"]
	quest.2EB7C4022E270816.quest_subtitle: "熔炉最大产出量"
	quest.2ED5AFA4EAB2809B.quest_desc: ["熔炉以高速度燃烧燃料，产出的FE/t相当可观。在Niotic等级，强烈建议使用漏斗或管道进行自动化燃料供应。"]
	quest.2ED5AFA4EAB2809B.quest_subtitle: "工业熔炉动力"
	quest.2EFD3CEC00CFA838.quest_desc: ["先用 Core Sample Drill 确认区块中的矿脉——没有矿脉，Excavator 将一无所获。这个巨大的多方块结构消耗 4,096 IF/t。每个矿床在枯竭前可产出约 38,400 个物品。"]
	quest.2EFD3CEC00CFA838.quest_subtitle: "无需挖掘即可从地下开采矿物矿床。"
	quest.2F0B0D4401AA455E.quest_desc: [
		"可以用扳手来为隧道装上窗户。"
		""
		"隧道不会阻止传送带上物品的封装风扇处理，但会阻止气流超出传送带。"
	]
	quest.2F0B0D4401AA455E.quest_subtitle: "用于机械带的装饰性隧道。"
	quest.2F0B0D4401AA455E.title: "隧道"
	quest.2F7C30CFCD7A1215.quest_desc: ["动力激光笔投射的光束可被方块阻挡；光束路径上的激光传感器会发出与激光强度成正比的红石信号。过滤器可限制特定颜色，扳手可反转红石行为，最大投射距离可在笔的背面调节。"]
	quest.2F7C30CFCD7A1215.quest_subtitle: "激光发射器和配套传感器：发射一束光，读取其落点。"
	quest.2F7C30CFCD7A1215.title: "激光"
	quest.2FB92BC03FFF09EE.quest_desc: ["适用于Niotic层级基础设施的高速传输电缆。连接大功率发电机与存储或机器时可避免瓶颈。"]
	quest.2FB92BC03FFF09EE.quest_subtitle: "高传输电缆"
	quest.302779FFD5F13891.quest_desc: ["你可以用紧凑的ME网络取代堆满箱子的巨大房间，但这仅仅是个开始。Applied Energistics旨在与其他模组协同工作并实现自动化。"]
	quest.302779FFD5F13891.quest_subtitle: "Applied Energistics 2 添加了组件和机制，提供物流和存储解决方案"
	quest.302D29E43E9C9A94.quest_desc: [
		"放置在任意物品栏旁时，Packagers 可以从所附物品栏中创建 Cardboard Packages。此过程不需要额外材料。"
		""
		"当用红石信号供电时，包装器会尽可能多地填充包裹。纸板包裹有9个物品栏。在包装器上放置附魔台标签，可为生成的纸板包裹贴上要送达的地址标签。"
	]
	quest.302D29E43E9C9A94.quest_subtitle: "包装器用于创建纸板包裹。"
	quest.303FC5162271DCA5.quest_desc: ["配置为在满载、空载或处理完成时弹出单元格。支持速度和红石卡。使用导入/导出总线自动化单元格进料。"]
	quest.303FC5162271DCA5.quest_subtitle: "快速将ME存储单元的内容传输到网络中或从网络中传输。"
	quest.30A84C6A54BD336E.quest_desc: [
		"固定式机械钻头会以 (45 x 硬度)/转速 秒的速度破坏前方的方块，并对周围实体造成伤害。"
		""
		"由&3Contraptions&r驱动的机械钻床无需直接提供旋转力，即可破坏与其碰撞的方块并对实体造成伤害。"
		""
		"机械钻头破坏方块所需的时间取决于装置的速度和方块的硬度值。对实体造成的伤害也取决于装置的速度。"
	]
	quest.30A84C6A54BD336E.quest_subtitle: "机械钻头是一种用于破坏方块的方块。"
	quest.30AB452E6B222ABA.quest_desc: ["以极快的速度为链接玩家的整个物品栏充电。在此等级下，它可以在正常游戏期间无限支持高耗能工具。"]
	quest.30AB452E6B222ABA.quest_subtitle: "灵动的无线充电器"
	quest.30AE6897560E6C83.quest_desc: ["与普通帆产生的垂直于帆面的升力不同，对称帆只会抵抗穿过帆面的运动。当帆面与行进方向平行时无效，倾斜时会产生阻力，非常适合用作舵、鳍和减速板。它们无需强力胶水即可附着在方块或其他帆上，用染料右键可重新上色。"]
	quest.30AE6897560E6C83.quest_subtitle: "一种仅产生阻力的帆变体：适用于操控、稳定和制动机械装置。"
	quest.31151795124F0ED3.quest_desc: ["将3个压碎的粉尘或原矿转化为4.5个粉尘，实现矿石四倍化。还能将工具和机器回收为粉尘，非常适合纠正错误配方。"]
	quest.31151795124F0ED3.quest_subtitle: "一种将矿石研磨成更细粉末的蒸汽机。"
	quest.3128BFA5B2FB9840.quest_desc: ["在路线起点放置一个Hypertube入口，然后用一系列Hypertube连接到目的地。通过漏斗或滑槽送入入口的物品会高速穿过管道，非常适合长距离运输。"]
	quest.3128BFA5B2FB9840.quest_subtitle: "Hypertube 系统的入口。插入此处的物品会通过连接的 Hypertube 发射出去。"
	quest.314F493196BF2D0A.quest_desc: ["直接从物品栏访问已存储的物品。将单元插入驱动器或箱子中，即可将其内容与网络同步。非常适合在基地之间运输大量物品。"]
	quest.314F493196BF2D0A.quest_subtitle: "便携式ME物品存储单元，无需网络连接即可存取物品。"
	quest.314F493196BF2D0A.title: "便携式物品存储单元"
	quest.31759AC7A34E5440.quest_desc: ["可连接到高压电线网络，并在接收到红石信号时断开连接。可用于远程切断危险机器的电源，或在自动化流程中控制能量输送。"]
	quest.31759AC7A34E5440.quest_subtitle: "根据红石信号切断一段线路的电源。"
	quest.318BFB09F067D7EE.quest_desc: ["高FE/t太阳能输出。灵性太阳能阵列可在白天提供可观的被动电力，且无运行成本。"]
	quest.318BFB09F067D7EE.quest_subtitle: "充满活力的太阳能农场"
	quest.31A24279B77C8367.quest_desc: ["以高速度在相邻方块和末地网络之间传输FE。非常适合需要快速无线电力连接的机器。"]
	quest.31A24279B77C8367.quest_subtitle: "Niotic 网络网关"
	quest.31B68E9A65B9404F.quest_desc: [
		"基础生成速率为 64 RF/t。Sheol 火也可以使用，燃烧时间比普通岩浆长得多。"
		""
		"流体输入可以用储罐、泵或管道自动化。早期手动用桶填充也可以，但一旦接入完整的流体网络，机器会好得多。"
	]
	quest.31B68E9A65B9404F.quest_subtitle: "使用熔岩作为燃料来发电。可以使用泵来大量收集熔岩。"
	quest.3213F0585C961011.quest_desc: ["用于大规模无线电力传输的高速率末影单元。Niotic 版本的 FE/t 处理能力远超其 Blazing 对应版本。"]
	quest.3213F0585C961011.quest_subtitle: "高倍率末地存储系统"
	quest.323BCD8DE6E817B3.quest_desc: ["Powah 中最强大的熔岩发生器。排液速度极快——持续运行需要无限熔岩源或非常大的储罐。"]
	quest.323BCD8DE6E817B3.quest_subtitle: "最大岩浆产量"
	quest.326E18EEF8A2560A.quest_desc: ["传送带上移动的物体会穿过活板门，落入下方的方块中。对于向破碎机料斗或物品筒仓等机器顶部输入口供料至关重要。与提取传送带配合使用可完成循环。"]
	quest.326E18EEF8A2560A.quest_subtitle: "物品会直接掉落至下方的物品栏或机器中。"
	quest.32AD9848A19E9CD8.quest_desc: ["将合成单元与合成存储、加速器和监视器组合成一个完整的CPU。每个CPU一次只能处理一个自动合成任务。"]
	quest.32AD9848A19E9CD8.quest_subtitle: "ME 制造 CPU 多方块结构的基本构建模块。"
	quest.3302D8AB93B2ED6A.quest_desc: ["在离心机中切割自硅。从处理器单元到超级AI芯片，Oritech中所有先进电路的基础。"]
	quest.3302D8AB93B2ED6A.quest_subtitle: "用作微处理器基板的薄层纯化硅。"
	quest.3324850B36696E23.quest_desc: ["用铁锭在机械压机下压制，或用轧机轧制而成。铁板是制作扳手、机械活塞、坚固板、安山岩/黄铜外壳（间接）以及各种机器的必需材料。"]
	quest.3324850B36696E23.quest_subtitle: "压制铁板，许多创造组件的基础材料。"
	quest.3347297D306113E2.quest_desc: ["将超密金属球与核弹在极端条件下结合而成。量子升级所需的最终材料。"]
	quest.3347297D306113E2.quest_subtitle: "利用量子物理学掌控的微型黑洞。"
	quest.337F293179141392.quest_desc: ["工作原理与普通能量管道相同，但吞吐量要高得多。它们比普通管道更粗。超导管无法与普通能量管道连接。"]
	quest.337F293179141392.quest_subtitle: "用于超大规模RF传输的高端能源电缆。默认传输速率为4.1M RF/t。"
	quest.34027D1063CA4F80.quest_desc: ["通过AE线缆或FE从顶部或底部供电。三个输入槽（顶部、中部、底部）对应特定配方位置。使用Certus Quartz Wrench旋转以实现自动化。支持Speed Card升级。"]
	quest.34027D1063CA4F80.quest_subtitle: "刻印者能将电路刻印在组件上，并能将切尔图斯石英碾成粉末。"
	quest.34C9A6A553284203.quest_desc: ["将连接器放置在发电机、电动机或蓄能器的侧面，然后潜行状态下用铜线或金线右键点击另一个连接器即可将其连接。大型连接器每刻能传输的电量要高得多——适合用作高吞吐量主干线。"]
	quest.34C9A6A553284203.quest_subtitle: "将FE/RF电缆与Create: Crafts \& Additions的电力方块连接的电线接口。"
	quest.34C9A6A553284203.title: "连接器"
	quest.3508D879FCE6FC95.quest_desc: ["用21块砖和3个青铜闸门（物品进/出和流体进）建造，可选配焦油流体出口。无需氧气即可将煤炭炼成焦炭——你的首个重大进展里程碑。"]
	quest.3508D879FCE6FC95.quest_subtitle: "你的第一个多块结构，用于将煤炭炼成焦炭。"
	quest.35639D4A6DDF6FF9.quest_desc: ["当Clutch未激活时，它将像Shaft一样传递旋转。当激活时，它将停止传递旋转。"]
	quest.35639D4A6DDF6FF9.quest_subtitle: "当红石信号被施加时，停止向外旋转。"
	quest.35791C0AEC750F0D.quest_desc: ["用绑定卡右击末影单元，将其链接到网络频道。维度变体可在不同维度间使用。"]
	quest.35791C0AEC750F0D.quest_subtitle: "链接您的网络"
	quest.35C37231C1C86294.quest_desc: [
		"强力胶水有两种使用方式：逐块模式和区域模式。你可以在同一个装置中混合使用这两种方法。"
		""
		"每次使用胶水，它的耐久度都会减少一点。你可以用“耐久”和“修补”附魔来延长它的使用寿命。"
		""
		"在逐块模式下，胶水的作用与史莱姆球相同。右键单击线性或径向底盘可将胶水涂覆于一个面，以便连接其他方块。要从底盘上移除胶水，请潜行并空手右键单击。"
		""
		"在区域模式下，你可以粘合一组已放置的方块。先右键点击该区域的其中一个角，然后移动到对角。一个绿色方框会显示所选区域。再次右键即可粘合方块。若要取消，请潜行并右键。第二个角最多可相距24个方块，总体积最多为2312个方块。无论选择范围多大，都只消耗一点耐久度。重叠的粘合区域会合并，但保持各自的形状。在区域模式下，你不能选择底盘的面——系统会切换到逐块模式。为避免此问题，请点击底盘的侧面。"
	]
	quest.35C37231C1C86294.quest_subtitle: "强力胶水能将&3机械装置&r的结构粘合在一起。"
	quest.35C37231C1C86294.title: "&a强力胶水"
	quest.35C87F2E9A0D4B61.quest_desc: ["将单元外壳与任意单元组件（1k-256k）结合，即可创建一个ME物品存储单元。等级决定了总字节容量和可存储的不同物品类型的最大数量。"]
	quest.35C87F2E9A0D4B61.quest_subtitle: "用于存放 ME 物品存储单元组件的容器，可创建一个可用的存储单元。"
	quest.35CAEBFD102522F9.quest_desc: ["插入ME存储单元或导入总线以启用虚空模式。超出容量的物品将被永久删除，而非备份。请谨慎使用。需要高级卡来制作。"]
	quest.35CAEBFD102522F9.quest_subtitle: "当网络或单元格已满时，会自动丢弃无法存储的物品。"
	quest.35E71782230B13B8.quest_desc: ["以极快的速度燃烧熔炉燃料来产生FE。此阶段强烈建议使用漏斗或管道进行自动化燃料输送。"]
	quest.35E71782230B13B8.quest_subtitle: "灵动的熔炉动力"
	quest.3652962C0D016853.quest_desc: ["以最高可能速率为相邻物品栏中的物品充能。一个 Nitro Energy Hopper 可为整个仓库的物品提供服务。"]
	quest.3652962C0D016853.quest_subtitle: "物品最大充能次数"
	quest.36C46B44A143719B.quest_desc: ["每个CPU多区块结构都需要至少一个Crafting Storage方块。更高级的存储能让CPU同时管理包含多种中间材料的更复杂连锁。"]
	quest.36C46B44A143719B.quest_subtitle: "为ME Crafting CPU提供1000字节的合成工作内存。"
	quest.36C87C5F40D3FAE7.quest_desc: ["铀燃料棒是日常使用的反应堆燃料。由浓缩铀棒制成的钚燃料棒燃烧更旺、持续时间更长——非常适合能承受高温的先进反应堆设计。"]
	quest.36C87C5F40D3FAE7.quest_subtitle: "反应堆燃料的颗粒形式，已准备好装入燃料端口。"
	quest.36C87C5F40D3FAE7.title: "反应堆燃料"
	quest.36FC74C4E3CE7806.quest_desc: ["终极活力棒。在活力球周围放一些氮气棒，制作几乎瞬间完成。"]
	quest.36FC74C4E3CE7806.quest_subtitle: "最大吞吐量"
	quest.370E134701621E1C.quest_desc: [
		"破坏后，小型储罐会保留所有物品 NBT 数据。比较器输出可反映储罐的填充水平。堆叠的储罐会自动让流体向下流动。"
		""
		"你可以通过将物品点击储罐或使用GUI中的槽位来插入或提取流体。"
	]
	quest.370E134701621E1C.quest_subtitle: "小型流体储罐最多可储存 256 桶流体。"
	quest.3722E03FC4BE7FE4.quest_desc: ["要建立连接，请使用目标指定器将发送端口绑定到特定目的地。目标端口必须相距至少50格，且位于已加载区块中。一个端口只能向一个目的地发送物品，但可以接收来自多个外部端口的货物。然而，如果一个端口持续发送物品，可能会“堵塞”目标端口，导致其他端口的货物无法送达。"]
	quest.3722E03FC4BE7FE4.quest_subtitle: "无人机港口通过自主飞行无人机运输物品和流体，实现远程物流。起降点都需要有匹配的无人机港口。"
	quest.376F3D1A8B4EED1D.quest_desc: ["用于制作Fuzzy、Crafting、Void和Equal Distribution卡。适用于抗损过滤、按需制作、自动清空和分区存储。"]
	quest.376F3D1A8B4EED1D.quest_subtitle: "更高级的升级卡，可启用模糊过滤和自动合成触发器等高级选项。"
	quest.37CA40F69A0285C4.quest_desc: ["用空间支柱定义捕获范围，然后将空间存储单元插入端口并提供电源。支柱边界内的所有物品都将被切割并存入单元中。"]
	quest.37CA40F69A0285C4.quest_subtitle: "控制空间输入输出操作，让你可以捕获和恢复整个物理空间体积。"
	quest.3832300BBF5991E4.quest_desc: ["MV 导线可在 16 格内传输高达 8,192 IF/t，损耗仅 0.3%。需要 Electrum 锭制作。必须与 MV 连接器和 MV 电容器搭配使用。长距离传输比 LV 更高效。"]
	quest.3832300BBF5991E4.quest_subtitle: "中压（MV）电力等级的电金线线圈。"
	quest.383360C7021B2144.quest_desc: ["用于将不锈钢、钛、铂等高温合金的炽热锭冷却回可用形态。由防冻机器外壳建造。"]
	quest.383360C7021B2144.quest_subtitle: "一种能将热金属锭冷却成可用金属锭的多方块结构。"
	quest.383D6F1A001A0AEC.quest_desc: ["滑槽可将物品从上方拉下并投掷到下方。堆叠多个滑槽可形成物品竖井。将向上吹风的封闭式风扇放置在滑槽中，可逆转流向并提升物品。右键单击扳手可切换方向或切换到侧向连接变体。"]
	quest.383D6F1A001A0AEC.quest_subtitle: "垂直物品运输。物品可自然下落；借助向上吹风的 Encased Fan，物品也能被提升。"
	quest.388154CE72614A36.quest_desc: ["用铱板和超导电线制作。量子电路内部使用的最终层级电路基板。"]
	quest.388154CE72614A36.quest_subtitle: "量子电路所使用的电路板。"
	quest.3899304D69013639.quest_desc: ["也可用作加速器环内的直接指南方块。其比较器输出从静止时的0到15,000 m/s时的15不等，是调节环速度的主要读数。"]
	quest.3899304D69013639.quest_subtitle: "粒子的速度可以用粒子传感器来测量。比较器可以根据粒子的速度提供红石信号。"
	quest.38E9C4DB82B1279A.quest_desc: [
		"静止状态下，可将某些物品应用到方块过滤器上。若有过滤器，则只会影响该装置实体。若在组装前和组装期间用红石信号供电，装置实体将处于禁用状态。注意，在&3装置&r上组装的红石和杠杆无效。"
		""
		"在已组装的装置上，右键点击装置控制器可以启用或禁用特定的装置执行器。"
	]
	quest.38E9C4DB82B1279A.quest_subtitle: "Contraption Controls 用于控制 Contraption Actors。"
	quest.38EC378844976A93.quest_desc: ["将飞行员护目镜装备在头部，即可在观察方块时读取各种数据：旋转部件的动能应力和容量、气球内的升力气体、螺旋桨的推力和气流、高度传感器的气压，以及兼容方块中的物品或流体内容。"]
	quest.38EC378844976A93.quest_subtitle: "工程师护目镜的航空学对应物：在HUD中显示已放置组件的信息。"
	quest.3912B9486673B33A.quest_desc: [
		"机器框架总是建成长方形，上面会连接一台或多台龙门机器。框架的内部方块应为空的。"
		""
		"建造以下机器时需要用到它："
		""
		"方块破坏者"
		"放置方块工具"
		"肥料方块"
		""
		"机器总是瞄准框架下方的方块，并且可以安装在框架的任何位置，包括角落。"
	]
	quest.3912B9486673B33A.quest_subtitle: "机器框架是奥里泰克大型工业机器的结构基础。它为多个复杂的多方块结构充当基础底盘。"
	quest.39CE9D4413EC1621.quest_desc: ["挖掘到陨石中心，找到神秘立方体。摧毁它能获得&e逻辑&r、&e计算&r、&e工程&r和&e硅压板&r——这四种物品在刻印器中生产处理器时缺一不可。如果还没找到陨石，可以制作一个陨石罗盘，它会指向最近的陨石。"]
	quest.39CE9D4413EC1621.quest_subtitle: "神秘立方体位于每个AE2陨石的核心。打破它会掉落全部四种刻印机。"
	quest.39CE9D4413EC1621.title: "&l神秘的立方体&r"
	quest.3A2633B6030BBC52.quest_desc: ["佩戴工程师护目镜时，可以查看运行中机器的应力冲击。查看应力计或速度计时，还能显示数值并高亮当前转速。此外，还能显示油箱内的液体量及总容量。"]
	quest.3A2633B6030BBC52.quest_subtitle: "工程师护目镜是一种可穿戴物品，能让使用者看到放置的机器更多细节。"
	quest.3AF148AB8FC614A5.quest_desc: ["最强的 Powah 发电机之一。在 3x4 的区域放置 36 个 Spirited Reactor 方块即可获得巨大的 FE 输出。该结构可自动组装。"]
	quest.3AF148AB8FC614A5.quest_subtitle: "充满活力的核能发电"
	quest.3B3B91A3F98A4078.title: "Immersive Engineering"
	quest.3B4BD7C2E48E59EB.quest_desc: ["用电镀金粉熔炼而成，在熔炉中混合等量的金和银。这是你首先需要大量储备的电子级合金之一。"]
	quest.3B4BD7C2E48E59EB.quest_subtitle: "Electrum 是一种基础合金，用于制作电线、连接器和各种电子元件。"
	quest.3B60F32F1A23153F.quest_desc: ["相连的容器内的物品会像储存在存储单元中一样显示在网络中。设置过滤器和优先级以控制物品的流向。支持容量、模糊、反相和虚空卡。"]
	quest.3B60F32F1A23153F.quest_subtitle: "将相邻的任何物品栏暴露为ME网络的一部分进行存储。"
	quest.3B6763B1CF0427DB.quest_desc: ["右键可存入一叠物品（按住 Shift 可倒入全部），左键可取出。破坏已填充的桶会保留其内容物，桶本身也可用于便捷运输。"]
	quest.3B6763B1CF0427DB.quest_subtitle: "一个可携带的物品存储方块，可存放32组同一种物品。"
	quest.3B97E75CF259701C.quest_desc: ["将其安装在采石场激光臂上，即可同时伤害采矿区的敌对生物。无需手动干预，轻松保持挖掘点清洁。"]
	quest.3B97E75CF259701C.quest_subtitle: "为开采模式的激光臂添加了攻击能力。"
	quest.3BFD1E8F79FB9C8F.quest_desc: ["由电池合金粉尘熔炼而成。用于制作可存储EU的电动多区块电池舱的核心材料。"]
	quest.3BFD1E8F79FB9C8F.quest_subtitle: "用于电池的纯铅锑合金锭。"
	quest.3C6DA21DC234CE54.quest_desc: ["将其置于燃料棒旁，无需添加其他棒即可提升中子脉冲计数。可增加热量和RF输出，且不消耗额外燃料。"]
	quest.3C6DA21DC234CE54.quest_subtitle: "将燃料棒中的中子反射回反应堆核心。"
	quest.3C6E18AC535941AB.quest_desc: [
		"点击带有工厂仪表的库存链接，将其与该网络关联。最多可在一个方块中放置4个工厂仪表。"
		""
		"将物品放入过滤器槽位或在UI中设置后，即可将工厂计量器设为监控该物品。设置完成后，主UI将变为可用状态。"
		""
		"可以在UI中设置请求包裹的发送地址。这样包裹就能被分拣到正确的位置。可以为承诺设置一个过期时间。"
		""
		"UI会显示价值设置界面中设定的存储水平和已开启的承诺数量。价值设置界面：右键以打开价值设置界面，调整要保持在存储中的物品数量。可设置为任意数量(*)，或最多100个物品或堆叠。"
	]
	quest.3C6E18AC535941AB.quest_subtitle: "工厂计量器用于通过物流网络发送请求，以维持链接存储中物品的数量。"
	quest.3C9332E790089F40.quest_desc: ["放置电动机，并在其后部连接传动轴。通过连接器用FE为其供电。打开GUI以配置所需的RPM和应力容量，无需水轮或蒸汽机即可精细控制Create旋转网络。"]
	quest.3C9332E790089F40.quest_subtitle: "将FE/RF能量转换为旋转力，与Alternator相反。"
	quest.3CEDB498102A6F57.quest_desc: ["给它喂食青金石、书籍和目标物品。只要有能量和相邻的带充能的附魔催化剂，它就会自动施加附魔。"]
	quest.3CEDB498102A6F57.quest_subtitle: "由RF供电的自动化附魔工作站。"
	quest.3D2723CB751AD083.quest_desc: ["通过电解铬盐酸溶液生成。九种小尘埃可合成一种完整尘埃，用于不锈钢合金配方。"]
	quest.3D2723CB751AD083.quest_subtitle: "少量铬，不锈钢的关键原料。"
	quest.3DE11BCB02E56C2A.quest_desc: ["传输速率高于硬化电缆。使用这些电缆连接炽热级发电机和存储设备，避免瓶颈。"]
	quest.3DE11BCB02E56C2A.quest_subtitle: "更高吞吐量电缆"
	quest.3E00000000000009.quest_desc: ["将爆裂砖块排列成中空的3x3x3立方体以建造高炉。每个铁锭加一个焦煤可生产一个钢锭。炉渣是副产品。"]
	quest.3E00000000000009.quest_subtitle: "高炉多区块结构的组成方块。"
	quest.3E0000000000000A.quest_desc: ["将合金砖块排列成 2x2x2 的立方体以形成合金熔炉。它无需电力即可将两种金属结合成合金——例如，金 + 银 = 电金，铜 + 镍 = 康斯坦丁合金。"]
	quest.3E0000000000000A.quest_subtitle: "合金熔炉多区块结构的组成方块。"
	quest.3E0000000000000B.quest_desc: ["在高炉中用煤炭焦炭冶炼铁锭可生产（1铁+1焦炭=1钢）。钢铁是大多数中后期机器、电线和组件的必需材料。"]
	quest.3E0000000000000B.quest_subtitle: "沉浸式工程的支柱性材料。"
	quest.3E0000000000000C.quest_desc: ["在合金熔炉中用1个金锭和1个银锭合成。电金线卷的传输能力高达8,192 IF/t，是MV电力等级所必需的。"]
	quest.3E0000000000000C.quest_subtitle: "用于MV线圈的金银合金。"
	quest.3E0000000000000E.quest_desc: ["需要工程师工作台中的组件蓝图。用于许多多方块机器的配方中。作为低阶结构的钢制机械组件的廉价替代品。"]
	quest.3E0000000000000E.quest_subtitle: "在工作台用铁板制作的合成组件。"
	quest.3E0000000000000F.quest_desc: ["需要工程师工作台中的组件蓝图。用于高级机器和多方块结构。比铁制变种更耐用、更精确，是更高级结构所必需的。"]
	quest.3E0000000000000F.quest_subtitle: "由钢板制成的优质制作组件。"
	quest.3E00000000000014.quest_desc: ["每个LV连接器可接一根导线。用工程师之锤将面配置为输入（蓝色）或输出（橙色）。连接器是端点——用中继器做分岔和拐角。"]
	quest.3E00000000000014.quest_subtitle: "连接到机器和方块上以接收LV电线。"
	quest.3E00000000000015.quest_desc: ["放置于电源与机器之间，以平衡供需。使用工程师螺丝刀配置输入/输出侧。间歇性发电机（如水轮）的必备组件。"]
	quest.3E00000000000015.quest_subtitle: "最多可存储 100,000 IF — LV 级能量缓冲器。"
	quest.3E0000000000001D.quest_desc: ["功能与 LV Connector 类似，但适用于中压等级。可与 Electrum Wire Coils 和 MV Capacitors 搭配使用。使用 Engineer's Screwdriver 配置输入/输出端。"]
	quest.3E0000000000001D.quest_subtitle: "连接到机器和方块上以接收MV电线。"
	quest.3E00000000000020.quest_desc: ["组件蓝图允许在工程师工作台制作铁和钢的机械组件。不同的蓝图会解锁不同的配方类别。蓝图可重复使用。"]
	quest.3E00000000000020.quest_subtitle: "蓝图可在工程师工作台解锁高级组件的制造。"
	quest.3E00000000000024.quest_desc: ["将电源连接到背面。右键物品进行充电——颜色指示器显示充电水平（红、黄、绿）。再次右键以取回已充电的物品。支持采矿钻、轨道炮等。"]
	quest.3E00000000000024.quest_subtitle: "为已充能的工业时代工具和装备充能。"
	quest.3E00000000000027.quest_desc: ["功能与低阶连接器类似，但可处理高压电力。与钢线线圈和高压电容器搭配使用。高压电线接触即会触电——将其架设在电线杆上以保护玩家。"]
	quest.3E00000000000027.quest_subtitle: "可连接到机器和方块以接收高压电线。"
	quest.3E63AD5B01630DAD.quest_desc: ["与低阶核心相比，提升了多区块结构的品质评级。仅允许添加的组件数量会变化——运行速度和配方时间保持不变。"]
	quest.3E63AD5B01630DAD.quest_subtitle: "用于多区块建造的中级机器核心。"
	quest.3EC2C047A9DCAEB5.quest_desc: ["由青铜锭在青铜压缩机中以1:1的比例制成。用于大多数青铜活板门、机器、储罐和青铜桶。"]
	quest.3EC2C047A9DCAEB5.quest_subtitle: "一块扁平的青铜板，蒸汽时代制作的组件核心。"
	quest.3EC84EB6EA2E0FDC.quest_desc: ["右键点击车轮架前部的任意轮胎即可安装。小轮胎适合轻型轻便车，而大轮胎能缓冲更大的落差、攀爬更陡峭的地形，并越过更高的障碍物。请选择与你的装置质量和拟穿越地面相匹配的尺寸。"]
	quest.3EC84EB6EA2E0FDC.quest_subtitle: "可安装在轮轴上的全地形轮胎：小型、常规、大型和巨型尺寸。"
	quest.3EC84EB6EA2E0FDC.title: "轮胎"
	quest.3ECAB9177F57B67F.quest_desc: ["适用于紧凑的垂直工厂布局。物品会沿传送带向上爬升，并在顶部卸下。可在顶层搭配基础传送带，将物品水平导向下一台机器。"]
	quest.3ECAB9177F57B67F.quest_subtitle: "物品会直接向上移动，而不是水平移动。"
	quest.3F61705264EDAFFE.quest_desc: ["在工程师工作台合成。用作电子元件和高级电路物品的中间材料。建造电路工作台前必需。"]
	quest.3F61705264EDAFFE.quest_subtitle: "电子电路的基础组件。"
	quest.3F6C6F2FCE8453A0.quest_desc: ["Powah 中最好的便携式电池。可储存海量 FE，为最耗电的工具提供无限续航。"]
	quest.3F6C6F2FCE8453A0.quest_subtitle: "终极便携式电源"
	quest.3F75ADBA5B33A849.quest_desc: ["输出高于硬化反应堆。需要36个烈焰反应堆方块，以3x4的区域放置——它们会自动组装成多方块结构。"]
	quest.3F75ADBA5B33A849.quest_subtitle: "烈焰核能发电站"
	quest.3F78F467D241F10B.quest_desc: ["容量和充电速度都比硬化电池高。放在快捷栏里，就能被动地更快地给你的工具充电。"]
	quest.3F78F467D241F10B.quest_subtitle: "更便携的动力来源"
	quest.3FCDE0D862F1D5A7.quest_desc: ["在极端压力下与超密金属球结合，核弹会坍缩成一个奇点。同时它仍是一种可使用的TNT类炸药——请小心处理。"]
	quest.3FCDE0D862F1D5A7.quest_subtitle: "用作工业原料的大规模杀伤性武器。"
	quest.3FE52F9F825798B4.quest_desc: ["每增加一层，精炼配方就会解锁一种新的产物。全高塔可以同时将原油分解为所有馏分，从而实现最高效率。"]
	quest.3FE52F9F825798B4.quest_subtitle: "多层多区块结构，可同时蒸馏多种流体。"
	quest.402D606916C9F27B.quest_desc: ["插入总线或其他兼容设备，使其响应红石信号。配置为高或低信号激活，实现时钟或条件自动化。"]
	quest.402D606916C9F27B.quest_subtitle: "启用基于红石的AE2设备操作条件控制。"
	quest.4058BCBC7493D7BB.quest_desc: ["点击两个端点创建粘合区域，按 Ctrl+滚轮缩放；按住 ALT 可将端点锚定在空中。蜂蜜胶水不会附着在动态装置上，仅作用于模拟装置，从而避免超级胶水可能造成的复杂结构中不必要的连接。"]
	quest.4058BCBC7493D7BB.quest_subtitle: "强力胶的便捷替代品，专为模拟装置而设计。"
	quest.406BECED06648BF1.quest_desc: ["通过侧面用RF供电。将其放置在箱子或漏斗下方，这样电池、钻头和其他可充电物品在你工作时会自动充满。"]
	quest.406BECED06648BF1.quest_subtitle: "可为放置在其上方的电池和动力工具充电。"
	quest.406C745A38597DEE.quest_desc: ["安装在 Quarry 模式下运行的激光臂上，使其不会破坏农田和成熟作物。适用于保护与采矿区重叠的农场。"]
	quest.406C745A38597DEE.quest_subtitle: "防止采石场收割农作物。"
	quest.40FB7ECF967AE45A.quest_desc: ["没有红石信号时，传输器就像一个普通的封闭式齿轮。从侧面输入动力和信号会减速齿轮；从齿轮输入动力和信号会加速传动轴。信号强度越高，传动比越大，而在满输入时，两个输出会断开并独立旋转。"]
	quest.40FB7ECF967AE45A.quest_subtitle: "红石控制的齿轮箱：使用模拟红石来改变轴和齿轮之间的传动比。"
	quest.4181323BF72047A9.quest_desc: [
		"右键点击一个有效的调度员，将调度表交给他们。调度员必须是坐在已组装的火车的火车控制器正前方的生物，或是以类似方式放置的烈焰燃烧器。"
		""
		"可以添加 3 种类型的命令。"
		""
		"&n前往车站&r - 导航至指定的火车站。"
		"&n更新计划标题&r - 显示链接中火车站摘要所显示的路线名称。"
		"&n限制最高速度 &r- 更改前往车站时的最高速度。"
	]
	quest.4181323BF72047A9.quest_subtitle: "列车时刻表用于指导非玩家的列车乘务员。"
	quest.41CC2C620D525A81.quest_desc: ["每个模块都用作精炼过程中次要和次要流体产品的专用储罐。流体必须直接从模块方块中提取，而不是主炼油厂基座。这些模块还需要自己的机器核心才能成为多方块组装的一部分。"]
	quest.41CC2C620D525A81.quest_subtitle: "精炼室模块是工业精炼器的扩展组件。最多可在单个精炼器方块上堆叠两个模块，以启用额外的流体输出通道。"
	quest.41D61040B686270D.quest_desc: ["使用工业TNT压缩钨、防爆合金、铍等坚硬材料，最终是钻石。核反应堆阶段的先决条件。"]
	quest.41D61040B686270D.quest_subtitle: "一种用TNT压缩坚硬材料的组合方块。"
	quest.41F55F09A699E070.quest_desc: [
		"&l神秘的立方体&r"
		"&l&bCertus Quartz&r&r"
		"&l&9我的控制器&r&r"
	]
	quest.4253012E6325DE60.quest_desc: ["在原子熔炉中提炼铀资源时产生。进一步加工可获得用作核反应堆燃料棒的燃料颗粒。"]
	quest.4253012E6325DE60.quest_subtitle: "从原子熔炉矿石加工链中提取的原始铀。"
	quest.4266BF7FCE3B4330.quest_desc: [
		"大型齿轮是齿轮的一种较大变体，可以在拐角处传递旋转并为旋转速度控制器提供动力。"
		""
		"齿轮主要有三种相互啮合的方式："
		""
		"- 两个齿轮并排（非对角）放置且朝向相同时会相互啮合。当其中一个齿轮受到旋转力时，该力会以相同的速度反向传递到另一个齿轮。"
		""
		"-两个大型齿轮垂直放置时会相互啮合，从而改变其轴和方向，但速度不变。"
		""
		"-齿轮和大型齿轮斜向放置且朝向相同时会啮合。大型齿轮的转速是齿轮的一半。"
	]
	quest.4266BF7FCE3B4330.quest_subtitle: "齿轮是Create中用于传递旋转的基本机械组件。"
	quest.4266BF7FCE3B4330.title: "齿轮组件"
	quest.42B1841C89378829.quest_desc: ["比普通电池能储存更多FE。在末影电池GUI中Shift点击可升级末影网络通道容量。"]
	quest.42B1841C89378829.quest_subtitle: "更大的缓冲器"
	quest.42EB5F2CA57DFFC4.quest_desc: ["用于连接中压和高压网络。中压从小线圈侧输入，高压从大线圈侧输出。将其放置在柴油发电机附近，将高压电力输送至工厂各处。"]
	quest.42EB5F2CA57DFFC4.quest_subtitle: "将MV电力转换为HV，反之亦然。"
	quest.43E0F14C0FB64186.quest_desc: ["将多个Modular Accumulator方块相邻放置，形成一个更大的电池。总容量随方块数量增加。使用Connectors和电线连接，以便从发电机充电或向机器放电。"]
	quest.43E0F14C0FB64186.quest_subtitle: "由堆叠的模块化蓄能器方块构成的可扩展储能多区块结构。"
	quest.4480A4F3C97DF34B.quest_desc: ["储能和传输能力远超烈焰电池。高耗能工具和盔甲的必备升级。"]
	quest.4480A4F3C97DF34B.quest_subtitle: "中高级电池"
	quest.44B0BCF99D6102FF.quest_desc: ["Powah 中最大的便携式电池之一。几乎可以为任何高端工具从零充满，电量不会耗尽。"]
	quest.44B0BCF99D6102FF.quest_subtitle: "近乎无限的便携式电源"
	quest.44B268631ABBAB0E.quest_desc: [
		"与大多数机器不同，锻造炉并非只是消耗固定的RF/t。每个配方都必须将机器充至所需能量水平才能完成。"
		""
		"也就是说，你的主要瓶颈通常是激光吞吐量。更多的激光、更快的激光操作和专用的电源都能提高生产速度。"
		""
		"原子熔炉有不同的输入模式，方便自动化。\"Fill-Evenly\" 或 \"Sided\" 模式可确保每件物品都放入正确的槽位。"
		""
		"自动化也可以通过AE2/RS2完成。配方提供者与Forge兼容，开箱即用。"
	]
	quest.44B268631ABBAB0E.quest_subtitle: "原子熔炉是一种用于制造高级计算机芯片、加固深层板岩以及帮助高产量矿石处理的机器。"
	quest.44B268631ABBAB0E.title: "&5&l原子锻造炉&r&r"
	quest.44D44A289BE87B05.quest_desc: ["生长于充满魔力的水域附近。用于制作Niotic阶组件。"]
	quest.44D44A289BE87B05.quest_subtitle: "Niotic 水晶"
	quest.45BA5B8A785E1B82.quest_desc: [
		"使用扳手点击组件，可以围绕你点击的面旋转该组件。"
		""
		"使用扳手点击组件、红石组件、轨道或原版轨道变体，即可将其拆除并放入背包。任何可通过右键旋转或交互的方块，都必须在潜行状态下拆除。"
		""
		"将鼠标悬停在某些可配置组件上，即可通过滚动进行配置。"
		""
		"对于某些组件，如线性底盘，按住 ctrl 可同时配置所有已连接的组件。"
	]
	quest.45BA5B8A785E1B82.quest_subtitle: "扳手是一种用于旋转、拆卸和配置组件的工具"
	quest.45D0C73C31EE09F5.quest_desc: ["在蒸汽冲天炉中用未煮熟的钢粉锻造而成。钢是所有升级蒸汽时代装备、舱门和二级机器的基础，要做好大量制作的准备。"]
	quest.45D0C73C31EE09F5.quest_subtitle: "一种坚固的合金，可解锁钢制舱门和蒸汽采石场。"
	quest.46004D01A142777E.quest_desc: ["右键智能流体管道侧面的小过滤器槽位，以指定允许通过的流体。适用于多个液体共享相同管道布局的分支网络中，用于对流体进行分类。"]
	quest.46004D01A142777E.quest_subtitle: "智能流体管道可用于只允许特定液体通过。"
	quest.463C86AD49125B33.quest_desc: ["将其连接到 quarry-configured 激光上，即可在不破坏方块的情况下进行挖掘，从而完整采集矿石、紫水晶和其他仅支持丝绸采集的方块。"]
	quest.463C86AD49125B33.quest_subtitle: "给予激光臂采石场真丝触摸采矿。"
	quest.464608519D87AB04.quest_desc: ["通过岩浆或其他高温流体产生极高的FE/t。建议使用无限岩浆源或大型流体储罐以维持其长期运行。"]
	quest.464608519D87AB04.quest_subtitle: "充满活力的熔岩之力"
	quest.46530B71D98AEC2F.quest_desc: [
		"使用方法："
		"-保存位置：右键点击方块以保存其坐标。"
		"-给予机器：手持设计器，右键单击机器以设置其新目标。"
	]
	quest.46530B71D98AEC2F.quest_subtitle: "目标指示器是一种用来告诉机器该指向哪里的工具。你可以保存一个位置，然后将其交给机器。"
	quest.465892DC6DE51597.quest_desc: ["右键机器可旋转，或潜行右键可完整拾起，配置和物品栏均保留。用于管道末端时，还会切换管道连接。"]
	quest.465892DC6DE51597.quest_subtitle: "管道扳手是管理工厂物流的主要工具。它能与该模组中所有类型的管道和电缆配合使用。"
	quest.471473260D03D155.quest_desc: ["通过工程师工作台使用蓝图制作。用于高级机器和电气设备。生产需要电子元件和其他材料。"]
	quest.471473260D03D155.quest_subtitle: "用于高级机器的优质电子元件。"
	quest.473B4EB6E4484257.quest_desc: ["围绕数字电路板建造。蒸馏塔、涡轮机船体、处理单元和大多数高压级设备所必需。"]
	quest.473B4EB6E4484257.quest_subtitle: "HV级电路，解锁涡轮机械和高级多联块。"
	quest.47799F09127E76B2.quest_desc: ["在电路桌上合成。逻辑单元读取来自连接电线的输入信号，并根据配置的逻辑条件输出红石信号。用于高级自动化和基于电路的控制系统。"]
	quest.47799F09127E76B2.quest_subtitle: "可编程的红石逻辑控制器。"
	quest.47862D044419BCD5.quest_desc: ["Powah 中容量最高的 FE 存储方块。单个 Nitro Cell 可为整个基地的机器提供长时间的动力。"]
	quest.47862D044419BCD5.quest_subtitle: "氮气能量宝库"
	quest.48192BB04A89B98E.quest_desc: ["用海森堡补偿器和多种稀有材料在原子锻造炉中制成。唯一用途是锻造具有特殊能力的不可破坏的普罗米修姆工具。"]
	quest.48192BB04A89B98E.quest_subtitle: "Prometheum 是 Oritech 的最终游戏材料。它只能在原子锻造炉中生产，标志着进度中的最后一步。"
	quest.4823AF94FAB4D628.quest_desc: ["将锭切割成螺栓、齿轮、环和杆，效率远高于合成台。每次操作消耗少量润滑剂。"]
	quest.4823AF94FAB4D628.quest_subtitle: "用于制作螺栓、齿轮、圆环和杆件的蒸汽机。"
	quest.486045C6B730FCED.quest_desc: ["利用直射阳光产生稳定的RF。需要与天空无障碍的视线——其上方的任何实心方块都会停止生产。"]
	quest.486045C6B730FCED.quest_subtitle: "比普通太阳能板发电量更大的大型太阳能板。"
	quest.487FC21C27FDE915.quest_desc: ["将含铬粉尘溶于盐酸即可生成。用电解器处理可获得微型铬粉尘。"]
	quest.487FC21C27FDE915.quest_subtitle: "一种用于提取铬的中间解决方案。"
	quest.48DB190A2FE5736C.quest_desc: ["更高级的单元能存储更多物品，但每种物品仍占用1个类型槽。选择等级时，请在类型数量和总字节数之间取得平衡。将单元插入ME驱动器。"]
	quest.48DB190A2FE5736C.quest_subtitle: "ME物品存储单元有1k到256k字节的不同等级，每个等级可容纳的物品数量也不同。"
	quest.48DB190A2FE5736C.title: "ME物品存储单元"
	quest.494B52645FFCDB12.quest_desc: ["这个3x5x3的多方块结构需要能量，并能处理投入漏斗的物品。每种原矿可产出两份砂砾，每份砂砾可熔炼成一份锭，从而有效将产量翻倍。是高效矿石处理的必备装置。"]
	quest.494B52645FFCDB12.quest_subtitle: "将矿石研磨成砂砾，使矿石产量翻倍。"
	quest.495A5734B967785B.quest_desc: ["定向齿轮箱的运作与普通齿轮箱相同，但仅在传动轴以特定方式旋转时才会反转。将两个定向齿轮箱组合起来，可以为你的物理模拟船只构建棘轮、单向离合器或制动系统。"]
	quest.495A5734B967785B.quest_subtitle: "一个只能朝一个方向翻转的齿轮，适用于棘轮和单向驱动。"
	quest.49823607583217B7.quest_desc: ["比硬化版太阳能输出更高。保持无障碍，全天获得稳定的被动电力。"]
	quest.49823607583217B7.quest_subtitle: "烈焰太阳能"
	quest.4994FCC30198779D.quest_desc: ["能量消耗随加载区块数变化：e = 80 + (x*(x+1))/2 AE/t。可在量子桥间工作，但不能跨维度。可显示当前加载的区块的全息投影。"]
	quest.4994FCC30198779D.quest_subtitle: "只要网络有电，就会保持所有被占用的区块加载。"
	quest.49D1093BBD16D760.quest_desc: ["为中后期工厂提供更大的能量缓冲。顶部可接MV导线，并从配置好的侧面输出。非常适合在发电脉冲与机器需求之间填补空白。"]
	quest.49D1093BBD16D760.quest_subtitle: "最多可存储 1,000,000 IF — MV 等级能量缓冲。"
	quest.49E8D25D63CC335F.quest_desc: ["由 Create 制作：处理经验的附魔工业机器。手持方块右键吸收经验，或破坏放置的经验方块释放光球。在基地间储存或运输经验值的实用方法。"]
	quest.49E8D25D63CC335F.quest_subtitle: "储存浓缩液体经验的实心方块，可掉落和堆叠，便于携带经验值。"
	quest.4A7F96E62A5845C5.quest_desc: [
		"机械活塞是一种会与不可移动方块发生碰撞的装置。"
		""
		"要伸出，活塞末端必须装有活塞延伸杆，并且需要旋转动力。延伸杆的最大长度为64格，可以在配置文件中更改。"
		""
		"当旋转方向相反时，活塞会缩回。末端必须用史莱姆球制成粘性活塞，才能将推出的方块带回来。"
	]
	quest.4A7F96E62A5845C5.quest_subtitle: "机械活塞是一种在获得旋转动力时可以推动&3机械装置&r的活塞。"
	quest.4AA6E52423B4A264.quest_desc: ["两个红石磁铁会根据极性相互吸引或排斥：异极相吸，同极相斥。相互吸引的磁铁会主动对齐，因此适用于自对准对接点、电磁锁和两个装置之间的近距离触发控制。"]
	quest.4AA6E52423B4A264.quest_subtitle: "一种可被吸引和排斥的磁铁，会响应附近的其他红石磁铁。"
	quest.4AB8851EB48B45E9.quest_desc: ["这个3x5x3的多方块机器通过顶部漏斗输入物品。种子和麻籽会被压榨成植物油和一些副产品麻纤维。植物油是炼油厂生产生物柴油所需的两种原料之一。"]
	quest.4AB8851EB48B45E9.quest_subtitle: "从种子和大麻中提取植物油。"
	quest.4AC47D023474B69F.quest_desc: ["需要16k单元组件来制作。用于创建64k ME物品和流体存储单元。在更高级别中，类型限制而非总字节数成为主要瓶颈。"]
	quest.4AC47D023474B69F.quest_subtitle: "提供 64k 字节的存储空间，使 ME 单元能够存储大量物品。"
	quest.4ACD5B2753DA531A.quest_desc: ["使用加固爆裂砖建造（钢锭+爆裂砖）。支持漏斗自动化：顶部输入铁和焦炭，正面出钢，背面出炉渣。比普通高炉更快。"]
	quest.4ACD5B2753DA531A.quest_subtitle: "改进版、可自动化的高炉。"
	quest.4B4650977344381A.quest_desc: ["量子级工艺锻造。在极端条件下与核弹结合，可成为最终阶段合成的奇点。"]
	quest.4B4650977344381A.quest_subtitle: "一个由压缩物质构成的密度极高的球体。"
	quest.4B689937EE3EAF0B.quest_desc: ["吞吐量极高的线缆。使用Spirited线缆，在高级机器间传输大量FE，避免瓶颈。"]
	quest.4B689937EE3EAF0B.quest_subtitle: "超高吞吐量电缆"
	quest.4B7DA12F3813CBF1.quest_desc: ["机器会为你生成和处理所有资源，而你则可以翱翔天际，做任何你想做的事！当然，要实现这一点还有很长的路要走。你能做到吗？"]
	quest.4B7DA12F3813CBF1.quest_subtitle: "Modern Industrialization 是一款独立的科技模组，终极目标是实现完全自动化。"
	quest.4B87EC7969F69A38.quest_desc: ["放置在地面上，它会面向你注视的方向。使用工程师之锤可以旋转或开启倾斜模式（shift-点击）。用任意颜色给传送带染色，以直观地整理生产线。"]
	quest.4B87EC7969F69A38.quest_subtitle: "将物品沿传送带朝一个方向移动。"
	quest.4B976C143EDA4317.quest_desc: [
		"外壳有四种类型：安山岩外壳主要用于基础的&3机械装置&r。"
		""
		"外壳只能通过将有效的合金或锭物理地应用到任何去皮的原木或木头上才能制作。原木会自行转换为外壳。"
		""
		"机械皮带、传动轴和齿轮可以安装在大多数外壳中，为被包裹的方块创建一个装饰。然而，铜制外壳只能用于流体管道。同样，流体管道不接受任何其他类型的外壳。"
	]
	quest.4B976C143EDA4317.quest_subtitle: "外壳是《创造》中许多合成配方、装饰和美化用途所使用的方块。"
	quest.4B976C143EDA4317.title: "&l&6安山岩外壳"
	quest.4BEBD83362A70D55.quest_desc: ["消耗青铜钻头，自动从基岩下开采原矿。需要大量钢铁投入——尝试前请先建造多个蒸汽冲天炉。"]
	quest.4BEBD83362A70D55.quest_subtitle: "一种在基岩下开采矿石的蒸汽多区块结构。"
	quest.4C4EAB9BC8244FBD.quest_desc: ["该泵可排空最大100,000格大小的液体储库。对于更大的储库，可能无法完全排空。它以每秒4桶的速度将液体处理到内部存储中，每移除一格消耗512 RF。对于非常大的液体，扫描过程可能需要几秒钟才能初始化。"]
	quest.4C4EAB9BC8244FBD.quest_subtitle: "水泵用于从世界中抽取大量液体。放置后，它会向下延伸树干，直到找到液体源，然后开始扫描并排干所有相连的液体。"
	quest.4C778D955569D21C.quest_desc: [
		"在默认加法设置下，速度提升75%，即机器以正常速度的175%运行，而能耗仅增加10%。原本需要100个刻度的配方，现在约57个刻度即可完成。"
		""
		"适用于所有在运行时每刻消耗能量的机器。"
		""
		"由于其高效性和巨大的速度加成，效果远优于叠加多个标准的速度和效率附加组件。"
	]
	quest.4C778D955569D21C.quest_subtitle: "Synergy Matrix 附加组件是最高阶的机器优化附加组件。"
	quest.4C7CD3858A2BE870.quest_desc: [
		"用于将锭压制为薄片，这是更高级组件的重要材料。"
		""
		"机械压榨机由内部转轴驱动，可从相对的两面接入。与转轴类似，压榨机也会沿其轴线传递旋转。当接收到更快的&a旋转动力&r时，它能更快地处理物品。"
	]
	quest.4C7CD3858A2BE870.quest_subtitle: "机械压机是一个机械组件，可将压制、填充和压缩配方应用于其下方的物品。"
	quest.4C8DDA689FE8369D.quest_desc: ["将混合物倒入模具并加热以启动反应。催化后，结晶会扩散至整个流体中且不可逆转；部分方块甚至会在此过程中被摧毁，这对铸造模具很有用。生成的 Levitite 能让模拟装置悬浮而不升高，并能显著抵抗低速运动。"]
	quest.4C8DDA689FE8369D.quest_subtitle: "一桶 Levitite Blend：一种加热后会结晶成固体 Levitite 的液体。"
	quest.4C9DE3294FAD64F6.quest_desc: ["放置在制造CPU多区块的任意一面。显示正在制造的物品和剩余数量。对于忙碌的自动化制造系统来说，这是一个有用的视觉指示器。"]
	quest.4C9DE3294FAD64F6.quest_subtitle: "显示当前由合成CPU处理的自动合成作业的状态。"
	quest.4CD2258FC3CA2972.quest_desc: ["比模拟电路更复杂的电路，围绕电子电路板建造。可解锁离心机、化学反应器、酿酒器、电解器和整个MV等级。"]
	quest.4CD2258FC3CA2972.quest_subtitle: "用于高级机器船体的MV级电路。"
	quest.4CD4BEB0362B0FE4.quest_desc: ["仅在需要时消耗燃料，电网充满时无能量浪费。在石油加工上线前，可靠的备用发电机。"]
	quest.4CD4BEB0362B0FE4.quest_subtitle: "燃烧焦油等液体燃料以产生LV电力。"
	quest.4CD822763FCBF7EF.quest_desc: ["默认情况下，信号从运动方向的反向发出。数值框设置对应完整15强度信号的速度，输出方向可翻转以面向行进方向。速度仅沿传感器朝向的轴测量，因此请使用多个传感器获取完整的3D速度读数。"]
	quest.4CD822763FCBF7EF.quest_subtitle: "输出与装置沿传感器朝向轴的速度成正比的红石信号。"
	quest.4CE7AD3185C95DC0.quest_desc: ["右键单击侧面过滤槽以设置允许通过的物品。智能滑槽还可配置每次传输的最大堆叠大小，从而精确控制混合物品系统中的吞吐量。"]
	quest.4CE7AD3185C95DC0.quest_subtitle: "一个带过滤器的漏斗，只传输与配置过滤器匹配的物品。"
	quest.4DCD3B98329A6CCC.quest_desc: ["橡胶衬里钢制外壳，由模拟电路供电。与电机、泵或活塞等功能部件结合，可构建所有基础LV机器。"]
	quest.4DCD3B98329A6CCC.quest_subtitle: "用于制作大多数基础电气机器的LV级外壳。"
	quest.4DFBCB76A6FAF97E.quest_desc: ["每个等级都会增加配方循环的产出量，从2级到9级递增。需要匹配输入吞吐量和能量才能全速运行。"]
	quest.4DFBCB76A6FAF97E.quest_subtitle: "升级了 Oritech Things 的加工附加组件，每次操作可获得更多物品。"
	quest.4DFBCB76A6FAF97E.title: "更多加工步骤"
	quest.4E1BC8D45B378A04.quest_desc: ["右键单击电流互感器，将其连接到电线上。输出与电线中流动的电流成正比的红石信号。可用于监控负载和自动化过载线路的断电操作。"]
	quest.4E1BC8D45B378A04.quest_subtitle: "测量电线网络段中的功率流动。"
	quest.4E2324A171263416.quest_desc: ["适合大多数自动合成链的中端选项。CPU的总字节容量决定了其在复杂合成中可同时追踪的中间材料数量。"]
	quest.4E2324A171263416.quest_subtitle: "为ME Crafting CPU提供4k字节的合成工作内存。"
	quest.4E482C528E9C1B0B.quest_desc: ["默认生成 40 AE/t，网络能量满时自动节流。支持能量卡和速度卡，可将输出提升至 150%。小型网络的简易前期电源。"]
	quest.4E482C528E9C1B0B.quest_subtitle: "燃烧固体燃料为ME网络生成AE电力。"
	quest.4E5C6F23628A9982.quest_desc: ["封闭式链传动可垂直或水平并列放置，形成一条在所有方块间传递旋转动力的链条。方块必须侧边相接（而非轴与侧边），并呈单一直线才能形成链条。封闭式链传动的轴线可以全部平行，也可以将方块旋转使轴线垂直。封闭式链传动也可以通过其旋转轴传递&a旋转动力&r，但这并非同一链条的延续。"]
	quest.4E5C6F23628A9982.quest_subtitle: "Encased Chain Drive 是一种可以传递旋转的方块，与 Mechanical Belt 类似。"
	quest.4ECF248F17A9F7B0.quest_desc: ["通过电动切割机切割硅锭生产。所有数字和量子级电路、存储芯片及处理器单元所需。"]
	quest.4ECF248F17A9F7B0.quest_subtitle: "数字电子学核心的薄硅晶圆。"
	quest.4EDC13D1D7AC5392.quest_desc: ["用于制造高压蒸汽，其能量密度是普通蒸汽的8倍。双向工作，水可以在高压锅炉和涡轮机中循环使用。"]
	quest.4EDC13D1D7AC5392.quest_subtitle: "一种将水和蒸汽转化为HP形式的钛合金多块结构。"
	quest.4F0396D84F98B65C.quest_desc: ["粒子每次经过动力马达，速度增加1 m/s。能耗随当前速度变化，为10 RF/m/s，因此高速环需要强大的电源。"]
	quest.4F0396D84F98B65C.quest_subtitle: "粒子在通过加速器环时被赋予能量。"
	quest.4F1E280925CAE803.quest_desc: ["一个方块大小的FE缓冲器。放置在发电机和机器之间以平滑功率波动。Shift点击它以打开Ender Cell GUI，升级该通道的容量。"]
	quest.4F1E280925CAE803.quest_subtitle: "FE 缓冲方块"
	quest.4F833B3C9D20C616.quest_desc: ["通过处理贫铀棒或在特定原子锻造链中合成获得。将其熔炼成锭，可生产MOX风格的钚芯，提高反应堆效率。"]
	quest.4F833B3C9D20C616.quest_subtitle: "裂变钚的粉尘，由燃尽的铀棒产出。"
	quest.500FA9792456C013.quest_desc: ["使用强力胶水或蜂蜜胶水标记一组方块，然后点击合成器并拉动其杠杆即可组装。对角边缘的方块也会被包含在内，组装完成后，原始合成器将不再需要。任何物理合成器都可以用来拆解该装置。"]
	quest.500FA9792456C013.quest_subtitle: "每个模拟装置的核心：将粘合的方块组转换为可自由移动的物理体。"
	quest.502DC31C1B136131.quest_desc: ["在方块间传输FE。在配置模式下，右键Powah Wrench可将每个面设为输入、输出或禁用。"]
	quest.502DC31C1B136131.quest_subtitle: "更好的传送 (Better Transfer)"
	quest.5052F5BF2FDACC38.quest_desc: ["Powah Wrench 可以移除方块并配置电缆传输模式。在 Config 模式下右键电缆，可切换其朝向行为。"]
	quest.5052F5BF2FDACC38.quest_subtitle: "配置 \& 移除"
	quest.507B64A1544AE806.quest_desc: ["只要上方的冷却端口接收到冰，每个相邻的发热组件每刻都会移除16点热量。被热管或燃料棒完全包围时效率最高。"]
	quest.507B64A1544AE806.quest_subtitle: "一个主动冷却组件，可从每个相邻方块移除固定量的热量。"
	quest.50A4DD76AC5D5C2B.quest_desc: ["每种类型都需要陨石战利品中独特的压印器。在刻印器中打印每个电路，然后用打印的硅片组合成最终的处理器。逻辑型最常见，工程型最稀有。"]
	quest.50A4DD76AC5D5C2B.quest_subtitle: "逻辑、计算和工程处理器是大多数AE2设备的核心组件。"
	quest.50A4DD76AC5D5C2B.title: "处理器"
	quest.50AAFB9362931BDB.quest_desc: ["终极末地传送门。在相邻方块和末地网络之间传输最大可能的FE，无任何速率限制。"]
	quest.50AAFB9362931BDB.quest_subtitle: "Nitro 网络网关"
	quest.50CE0BD7B0BC4017.quest_desc: ["通过向侧面提供旋转力，可以在开启和关闭之间切换流体阀门。这通常使用阀门手柄或齿轮来实现。阀门侧面的一组方向箭头也会旋转，以指示阀门是开启还是关闭。"]
	quest.50CE0BD7B0BC4017.quest_subtitle: "流体阀门可用于开启或关闭管道中的流动。"
	quest.5124AE3540FE86D3.quest_desc: ["使用蓝图在工程师工作台，用电路板和电子管制作。连接器、电容器和其他中后期电气装置所需。"]
	quest.5124AE3540FE86D3.quest_subtitle: "中阶配方中使用的电子元件基础组件。"
	quest.5162D05B4B409264.quest_desc: ["其他物品会左右分开，将流量50/50地分配到两个输出。非常适合在并行机器间平衡负载或在两条生产线间均匀分配资源。"]
	quest.5162D05B4B409264.quest_subtitle: "在两个输出方向之间交替物品。"
	quest.51B410F84560B541.quest_desc: ["粒子从粒子加速器方块开始，你可以插入任何物品作为粒子。在控制器正后方放置一个直的导轨环，朝向侧面，并确保视觉效果对齐。"]
	quest.51B410F84560B541.quest_subtitle: "粒子加速器的作用，正如你所猜，就是加速粒子。当不同物品的粒子碰撞时，它们可以创造出新的物品。"
	quest.51B410F84560B541.title: "&a&l粒子加速器&r&r"
	quest.51C5881E3693ED00.quest_desc: ["将光标悬停在某些物品上并按 \"G\"，即可立即打开该物品的指南。"]
	quest.51CCB7ACFD7B45F1.quest_desc: [""]
	quest.51CCB7ACFD7B45F1.quest_subtitle: "黄铜弹壳用于更先进的机器中。"
	quest.51CF03840DB50993.quest_desc: ["利用温差产生大量被动FE。无需燃料——只需置于熔岩上方，附近有水即可运行。"]
	quest.51CF03840DB50993.quest_subtitle: "Niotic 热交换器"
	quest.51E943FE5F941B7C.quest_desc: ["利用温差被动产生FE。烈焰版本每刻产生更多。将其置于岩浆上方，旁边有水，并保持运行。"]
	quest.51E943FE5F941B7C.quest_subtitle: "炽热的热交换器"
	quest.5287D9F564797135.quest_desc: ["像普通螺旋桨一样产生推力，但会主动围绕一个轴旋转桨叶，使升力矢量始终向上，无论装置朝哪个方向移动。用扳手右键可反转推力方向。适用于需要稳定向上力而非方向控制的垂直推进器。"]
	quest.5287D9F564797135.quest_subtitle: "一个能沿单一轴自动调整桨叶角度以保持向上的螺旋桨。"
	quest.52F3280E4D03CAA6.quest_desc: ["用于需要多种中间材料的合成任务。在同一 CPU 中混合多种存储层级，以微调总容量。"]
	quest.52F3280E4D03CAA6.quest_subtitle: "为ME Crafting CPU提供16k字节的合成工作内存。"
	quest.534DC754FE656C78.quest_desc: ["ME P2P隧道接收32个输入通道并在另一位置输出，从而实现密集通道路由。与记忆卡连接。ME P2P隧道不能相互嵌套。"]
	quest.534DC754FE656C78.quest_subtitle: "通过单个电缆连接，在网络中最多可建立 32 个通道。"
	quest.538EAF614E818A9C.quest_desc: ["替换多区块结构内的机器核心1，以提升其总质量。这样机器就能支持更多附加组件和扩展层，而不会影响运行速度。"]
	quest.538EAF614E818A9C.quest_subtitle: "机器核心的第二层级，比基础核心略强。"
	quest.53C0234C053BF0CF.quest_desc: [
		"放置一个 Stock Link 以开始一个新的物流网络。在放置前右键已放置的 Stock Link 以共享该链接的网络。将链接放置在 Packager 上，以将其连接的物品栏连接到网络。"
		""
		"Stock Links 没有范围限制，但它们所在的区块必须被加载，网络才能看到它们。"
		""
		"Stock Links 可以通过物流网络接收和发送请求。"
	]
	quest.53C0234C053BF0CF.quest_subtitle: "Stock Link 用于将 Packager 连接到 Logistics Network。"
	quest.54778BD66812A1CF.quest_desc: ["将流体管道连接到流体储罐和机器之间。没有机械泵，流体不会自行流动。使用扳手切换管道连接，或按住 Shift 右键移除。每个管道段在主动运输流体时会显示水流粒子。"]
	quest.54778BD66812A1CF.quest_subtitle: "在储罐、泵和机器之间运输流体。需要机械泵来主动移动液体。"
	quest.54ABF96F1929FBBE.quest_desc: ["将附魔物品放入机械磨石，同时提供旋转力。物品上的附魔会被剥离并转化为液态经验，可将其输送至储罐，用于烈焰附魔器或经验灯笼。"]
	quest.54ABF96F1929FBBE.quest_subtitle: "一个能将物品附魔解除并转化为液态经验的动力砂轮。"
	quest.54D739670D221333.quest_desc: ["无需有线连接即可查看和编辑所有相连的配方提供者中的配方。使用存储卡将其绑定到无线接入点。"]
	quest.54D739670D221333.quest_subtitle: "用于远程查看和管理模式提供器中模式的无线模式访问终端。"
	quest.5533C87913404B05.quest_desc: ["Niotic Capacitor 开启了中高阶组件，其功率比 Blazing 阶有显著提升。"]
	quest.5533C87913404B05.quest_subtitle: "Niotic 等级已解锁"
	quest.5576ED2880B6B14F.quest_desc: ["连接到任意LV电线网络即可持续照明。使用会随时间老化且必须更换的灯泡。比火把更具美感——非常适合照亮工业工厂。"]
	quest.5576ED2880B6B14F.quest_subtitle: "一种由工业电气网络供电的灯。"
	quest.5584B1F4C4F227BD.quest_desc: ["储存大量RF，为后期高耗能机器提供缓冲。串联多个可为反应堆、激光阵列或粒子加速器供电。"]
	quest.5584B1F4C4F227BD.quest_subtitle: "用于工业网络的高容量储能方块。"
	quest.55C94BCC704DDE97.quest_desc: ["在处理器单元内执行算术和逻辑运算。与 RAM、MMU 和处理器单元板组装成最终电路。"]
	quest.55C94BCC704DDE97.quest_subtitle: "处理单元核心的逻辑核心组件。"
	quest.55F36CB628017F16.quest_desc: ["由钢制机械外壳、钢制管道外壳和链条制成。需要物品输入用于钻头、流体输出用于油，以及能量输入来运行。解锁所有石油加工和高级燃料。"]
	quest.55F36CB628017F16.quest_subtitle: "一个巨大的多区块结构，可从基岩下钻探原油。"
	quest.55F923F918AFBFA6.quest_desc: ["右键点击一个电线杆，再点另一个，即可用目标选择器连接两者。它们也可以连接到普通能源管道，将远程发电机或消耗器接入同一电网。"]
	quest.55F923F918AFBFA6.quest_subtitle: "在长距离的电线杆之间无线传输RF能量。"
	quest.56246697CB3638D5.quest_desc: [""]
	quest.56246697CB3638D5.quest_subtitle: "一个添加了多种生成、存储和传输能量方式的科技模组。"
	quest.562C83804B9147B0.quest_desc: [
		"当某些元素以过高能量碰撞时，会撕裂时空，引发小型维度入侵。所需能量极大，相关诱因知之甚少。研究指出，碰撞能量超5000 J的火药似乎会拉近下界。而能量超10000 J的末影珍珠，则对末地维度有类似效果。"
		""
		"有传言称，一些鲁莽的科学家试图用已知测量方法无法企及的速度轰炸这些入侵点，企图制造自己的奇点。然而，无人归来分享成果，他们的命运笼罩在神秘之中。自那时起，传感器便记录到了来自实验地点的神秘超光速粒子流。"
	]
	quest.562C83804B9147B0.quest_subtitle: "以极高能量碰撞特定元素，撕裂时空本身的一个小孔。"
	quest.562C83804B9147B0.title: "&0&l奇点&r&r"
	quest.5662467B224C7B4D.quest_desc: ["将其连接到碎片锻造炉或兼容机器上，可将已获得的小块副产品产量翻倍。每台机器仅支持一个产量增效模组。"]
	quest.5662467B224C7B4D.quest_subtitle: "将矿石加工的副产品产量翻倍。"
	quest.568566551EEEB75A.quest_desc: ["介电浆是 Powah 所有组件的核心材料。先制作它来解锁模组的其他内容。"]
	quest.568566551EEEB75A.quest_subtitle: "Powah 的基础设施"
	quest.56C393E41CD8B3BD.quest_desc: ["AE2 方块、装置和物品的主要材料之一。通过培育发芽的 certus 来制作。"]
	quest.56C393E41CD8B3BD.quest_subtitle: "Certus Quartz Crystals 的独特特性是能将大量能量导入其晶体结构中"
	quest.56C393E41CD8B3BD.title: "&l&bCertus Quartz&r&r"
	quest.56D7F8CC3F3FEB4F.quest_desc: ["从放入其中的带电物品中提取FE，并将能量存储在内部缓冲区中。连接电缆以将电力重新分配到您的网络。"]
	quest.56D7F8CC3F3FEB4F.quest_subtitle: "FE 提取器"
	quest.56FB8E82C0492691.quest_desc: ["通过高速旋转将材料分解为组成粉尘。可解锁更优质的钢和硅配方，是氩等稀有气体的主要来源。"]
	quest.56FB8E82C0492691.quest_subtitle: "高速旋转材料以分离其组成部分。"
	quest.5750AF014D40A98E.quest_desc: ["功能上与有线模式编码终端完全相同。使用存储卡将其绑定到无线接入点。向接入点添加无线增强器以扩展其范围。"]
	quest.5750AF014D40A98E.quest_subtitle: "无需有线连接即可编码自动合成模式的无线模式编码终端。"
	quest.575573497C0512B7.quest_desc: ["需要1k单元组件来制作。用于制作4k ME物品和流体存储单元。决定哪个等级适合你的存储需求时，请平衡单元槽位和总字节数。"]
	quest.575573497C0512B7.quest_subtitle: "提供4k字节的存储空间，增加ME存储单元容量。"
	quest.576219F34BCAD0E8.quest_desc: ["储存的更多能量能让能量接收器更快地转换功率。电池侧面会显示填充状态。将多个电池串联起来，可以构建更大的能量储备。"]
	quest.576219F34BCAD0E8.quest_subtitle: "为ME网络储存高达200,000 AE的能量，在停电时起到缓冲作用。"
	quest.5771DB9E5BB9A87E.quest_desc: ["在离心机中用煤炭或生物质生产。用于制作碳板、生物钢以及各种结构和装甲组件。"]
	quest.5771DB9E5BB9A87E.quest_subtitle: "一种由富含碳的粉尘制成的坚固轻质材料。"
	quest.57CB0C8A583BB5C4.quest_desc: ["右键点击存储经验的物品和经验孵化箱，或站在上面将自身经验排入连接的流体网络。搭配机械砂轮或烈焰附魔机可实现全自动经验处理。"]
	quest.57CB0C8A583BB5C4.quest_subtitle: "一个用于在玩家、生物和储罐之间交换液体经验的组合方块接口。"
	quest.5809D00CF2B9057B.quest_desc: ["每个等级都比前一个大幅缩短处理时间，但能耗也相应增加。搭配接收器或电容器附加组件，让机器能真正消耗它们。"]
	quest.5809D00CF2B9057B.quest_subtitle: "Oritech Things 的升级速度附加组件，每个等级都有大幅度的跳跃提升。"
	quest.5809D00CF2B9057B.title: "更快的速度"
	quest.5853D6B92B5B9CA7.quest_desc: ["需要4k单元组件来制作。中后期网络中成本与存储的甜点。与单元外壳结合可制作16k ME存储单元。"]
	quest.5853D6B92B5B9CA7.quest_subtitle: "提供16k字节的存储空间，极大地增加了ME单元容量。"
	quest.58C815045C964ABC.quest_desc: ["手持任意实心方块，右键复制猫方块即可应用该方块的外观。结合复制猫台阶、半砖或面板等形状，可建造出外观酷似木材、石头、砖块或金属，但却是原版游戏所没有的独特装饰物。"]
	quest.58C815045C964ABC.quest_subtitle: "一种装饰性方块，模仿任何其他方块的纹理，同时保留其自身的自定义形状。"
	quest.58E158C8F2C04BEB.quest_desc: ["将 Levitite 混合物倒在热源上，或以其他方式启动反应，以获得固体 Levitite：这种神奇的抗重力材料能让模拟装置漂浮。一旦第一块晶体形成，该成就便会触发，标志着你真正进入航空学。推进系统需要升力来对抗阻力。"]
	quest.58E158C8F2C04BEB.quest_subtitle: "将 Levitite Blend 结晶化为固体的 Levitite，这是第一次。"
	quest.596183C99C77BA6B.quest_desc: ["在熔炉中用2个铁粉和1个镍粉合金，或手动混合。常见于大多数初级机械、组装器和首个机器核心中。"]
	quest.596183C99C77BA6B.quest_subtitle: "Adamant 是一种基础合金，用于制造装配器、蒸汽引擎、机器核心以及各种组件和工具。"
	quest.596CBA47803F1E2D.quest_desc: ["网络每刻消耗的能量不能超过其当前存储量。对于有数十个活跃设备的大型网络，或单次消耗数百万AE的Spatial Storage装置，Dense Energy Cell必不可少。它的存储量是普通Energy Cell的8倍。"]
	quest.596CBA47803F1E2D.quest_subtitle: "存储 1.6M AE — 用于在存储的电力上运行网络，或吸收大型空间存储操作产生的巨大瞬时功耗。"
	quest.597C4A2C39E7D8FB.quest_desc: ["硬化电容器是所有硬化级组件的关键材料。在能量球中合成它，以解锁重大的电力升级。"]
	quest.597C4A2C39E7D8FB.quest_subtitle: "硬化等级已解锁"
	quest.5994B1D74A0D61D1.quest_desc: ["使用Generator、Radiator、Heavy Engineering、RS Engineering、Fluid Pipes和Steel Scaffolding建造这个3x5x3的多方块结构。使用生物柴油（或Creosote Oil）运行。通过顶部HV连接器输出高达4,096 IF/t。"]
	quest.5994B1D74A0D61D1.quest_subtitle: "IE中最强大的电源——每秒输出4,096 IF。"
	quest.599CBC177D3D745D.quest_desc: ["用耦合器右键绳索绞车，再用右键绳索连接器，即可在两者间拉起绳索。绳索会像真实物理约束一样，两端都能传递拉力、摆荡和动量。一对绳索连接器也可以相连，但两个绞车不能相互连接。"]
	quest.599CBC177D3D745D.quest_subtitle: "用于将绳索绞车和绳索连接器用绳索物理连接的物品。"
	quest.59C507D6FF48D97A.quest_desc: ["在酿酒厂生产，是石油加工链的一部分。进一步提炼可将其转化为石脑油和柴油等轻质燃料。"]
	quest.59C507D6FF48D97A.quest_subtitle: "石油精炼过程中产生的中间流体。"
	quest.5A2450162FD24F7E.quest_desc: [
		"两个粉碎轮必须水平或垂直相邻放置，间隔一个方块。两个轮子必须施加相反的旋转力。任何要粉碎的物品都必须放入轮子向内旋转的位置。"
		""
		"将漏斗放置在车轮顶部，正对着下方的料仓或传送带，即可实现压轮自动化。"
	]
	quest.5A2450162FD24F7E.quest_subtitle: "Crushing Wheels 会将 Crushing 配方应用于从旋转方向的反向插入的任何物品。"
	quest.5A2450162FD24F7E.title: "压碎车轮"
	quest.5AB1F8F69D3865F4.quest_desc: ["用生物柴油填充内部油箱以提供动力。可在工程师工作台接受由不同金属制成的锯片，每种锯片属性各异。可升级伤害、速度等。"]
	quest.5AB1F8F69D3865F4.quest_subtitle: "由生物柴油驱动的圆锯机。"
	quest.5AD485C1FFB63CBF.quest_desc: ["硬化棒能大幅提升能量球的吞吐量。在能量球周围放置多根棒子，叠加其输入输出以实现更快的处理速度。"]
	quest.5AD485C1FFB63CBF.quest_subtitle: "更快的能量补充速度"
	quest.5AEB7591C3F34E92.quest_desc: ["需要 64k 单元组件来制作。用于创建 256k ME 物品和流体存储单元。每单元存储密度最大化，适合存储多种物品类型的网络。"]
	quest.5AEB7591C3F34E92.quest_subtitle: "最高阶的单元组件，提供256k字节的ME存储。"
	quest.5AEC3DBF64F32212.quest_desc: ["自动化游戏中几乎所有合成配方——一台机器最多支持3种配方，并支持锁定槽位。立即建造多台，低成本量产船体、马达、活塞、电路和电缆。"]
	quest.5AEC3DBF64F32212.quest_subtitle: "电气时代最重要的机器。"
	quest.5AF03A768711B278.quest_desc: ["这个巨大的5x5x5多方块结构使用会随时间降解的石墨电极。每批最多可处理12个物品，能将金属盔甲和工具回收成锭。副产品为炉渣。"]
	quest.5AF03A768711B278.quest_subtitle: "终极熔炉——高速处理多种物品。"
	quest.5AF9B99B68A2BBFB.quest_desc: ["放在背包里，它会在你游戏时默默为FE物品充能。越高的等级，每刻储存和传输的能量就越多。"]
	quest.5AF9B99B68A2BBFB.quest_subtitle: "便携式电源"
	quest.5AFD4912CC8FBBB8.quest_desc: ["通过顺序组装制作：将安山合金置于货栈，然后按正确顺序部署铁板和粉末状黑曜石，同时提供旋转力。铁路外壳和其他后期 Create 物品所需。"]
	quest.5AFD4912CC8FBBB8.quest_subtitle: "一种异常坚硬的板材，用于制作游戏后期的 Create 组件和轨道。"
	quest.5AFDF2B26178E14F.quest_desc: ["以高比率将阳光转化为FE。Niotic太阳能电池板阵列可提供全天稳定的被动电力。"]
	quest.5AFDF2B26178E14F.quest_subtitle: "Niotic 太阳能阵列"
	quest.5BDBD5D3B766B55C.quest_desc: ["熔炼铜矿石或原铜以获得铜锭。用机械压机将其压成铜板，以制作流体管道、流体储罐、蒸汽引擎等流体处理方块，这些是创造模式中期进程的核心。"]
	quest.5BDBD5D3B766B55C.quest_subtitle: "铜可以解锁Create的流体系统：管道、储罐、阀门和整个泵送基础设施。"
	quest.5BDBD5D3B766B55C.title: "铜制天堂"
	quest.5C2108BD3DEEB0E6.quest_desc: [
		"Spout 可通过流体管道填充最多 1 桶任意液体，并通过传送带或货台将部分液体倾倒在从其下方经过的兼容物品上。"
		""
		"无论使用多少流体，出水管处理一个物品需要1秒，但两次注水之间的延迟可能由出水管重新注满所需的时间引起。"
	]
	quest.5C2108BD3DEEB0E6.quest_subtitle: "Spout 是一种用于填充瓶子或桶等液体容器，或与液体进行合成的方块。"
	quest.5C3BE3DA49F5F70C.quest_desc: ["最高速率的末影单元。通过末影网络传输FE的速度比其他任何等级都快。是末游分布式电网的必需品。"]
	quest.5C3BE3DA49F5F70C.quest_subtitle: "Max-Rate 末影网络"
	quest.5C6E945F38EA9846.quest_desc: ["右键点击车轮装置正面的轮胎物品即可安装。从顶部供能会增加摩擦力从而刹车，而从侧面供能则会向该侧转向。结合两者，即可制造出具备正常加速、刹车和转向能力的越野漫游者。"]
	quest.5C6E945F38EA9846.quest_subtitle: "将轮胎安装在装置侧面，提供一个可转向、可制动的地面接触点。"
	quest.5C961A8A3DF4AA5A.quest_desc: ["炽热电容器可解锁所有炽热级组件。需要下界水晶——比硬化级明显更强大。"]
	quest.5C961A8A3DF4AA5A.quest_subtitle: "炽热等级已解锁"
	quest.5CA1BB6723200937.quest_desc: ["在模式编码终端中编码模式。合成模式遵循合成台规则；处理模式则完全灵活，输入输出均可。将编码后的模式插入模式提供器。"]
	quest.5CA1BB6723200937.quest_subtitle: "一个空模板，可用于编码自动合成的配方或处理配方。"
	quest.5CA95DC4EDDB7936.quest_desc: ["开启（无红石信号）时，电流正常流动。关闭（有红石脉冲）时，会断开电路，停止输电。适用于安全断电和可控电源分配。"]
	quest.5CA95DC4EDDB7936.quest_subtitle: "手动断开LV电线网络的一个部分。"
	quest.5D1807E0231C7C68.quest_desc: ["将其接入离心机或兼容机器，即可解锁塑料或精炼燃料等液体相关配方。流体可直接从主机器方块中泵入和泵出。"]
	quest.5D1807E0231C7C68.quest_subtitle: "在支持流体配方的机器上启用流体配方。"
	quest.5D8C03BDCC73701C.quest_desc: ["用钛板和数字电路合成。可解锁大型蒸汽轮机、热交换器、压力容器和蒸馏塔。"]
	quest.5D8C03BDCC73701C.quest_subtitle: "用于高功率机器和涡轮机的 HV 级船体。"
	quest.5D987045B401ED86.quest_desc: ["巨大的FE存储容量。Spirited Cell可以作为整个Powah网络的集中式充电宝。"]
	quest.5D987045B401ED86.quest_subtitle: "巨型能量缓冲器"
	quest.5D9FA42A9A60EDA8.quest_desc: ["放入充电器充入RF，然后用它为手持工具供电，或将其插入机器作为初始能量缓冲。迈向Oritech便携电源的第一步。"]
	quest.5D9FA42A9A60EDA8.quest_subtitle: "早期机器和工具的基础储能单元。"
	quest.5DA469AF40EF9738.quest_desc: ["将其放置在附魔机旁，可为每次附魔提供所需的催化剂。没有催化剂方块，附魔机将无法运行。"]
	quest.5DA469AF40EF9738.quest_subtitle: "用于稳定附魔师附魔过程的方块。"
	quest.5DACF716CBD6E744.quest_desc: ["在碰撞点周围放置收集器。每个收集器都能捕捉随机方向飞行的快子，回收的能量最多可达加速原始粒子所用能量的4倍。在更高速度下将它们分散开来，以免过度填充。"]
	quest.5DACF716CBD6E744.quest_subtitle: "捕获高能粒子碰撞产生的快子并将其转化为RF。"
	quest.5DB52BA6604B9487.quest_desc: ["用高级计算引擎在原子熔炉中制造。为模组中最复杂的设备提供动力，包括附魔催化剂、无人机端口和生成控制器。"]
	quest.5DB52BA6604B9487.quest_subtitle: "超级AI芯片是Oritech的最终计算组件之一。"
	quest.5DC940A2902E092B.quest_desc: [
		"当机械轴承被旋转力驱动时，右键点击轴承即可开始旋转，前提是其前方连接着潜在结构。"
		""
		"结构行为"
		"结构会旋转。如果在装置中使用了另一个机械轴承，并且朝向与原始轴承相同，那么连接到该轴承的方块在结构移动时将保持其对齐状态。"
	]
	quest.5DC940A2902E092B.quest_subtitle: "机械轴承用于制造和旋转机械装置。"
	quest.5DDE12D0E3FB6A63.quest_desc: ["装入不同流体：Creosote Oil点燃敌人，Ethanol造成火焰伤害，Herbicide施加中毒。每次喷洒消耗10 mB。升级包括Multitank（多流体）和Focused Nozzle（更远的射程）。"]
	quest.5DDE12D0E3FB6A63.quest_subtitle: "向敌人喷洒液体，产生各种战斗效果。"
	quest.5DE83161BF01A939.quest_desc: ["当你的多区块需要大量附加组件时使用。机器本身运行速度不变，只是其升级容量会增加。"]
	quest.5DE83161BF01A939.quest_subtitle: "一台先进的机器核心，几乎处于等级列表的顶端。"
	quest.5E133E00197A6535.quest_desc: ["放入锻造锤中，能将矿石产量提高三倍，并解锁更多配方，但会消耗耐久度。手持时，它能像IE风格的锤子一样，直接将锭转化为板。"]
	quest.5E133E00197A6535.quest_subtitle: "一种能提升锻造锤产出的耐用铁制工具。"
	quest.5E43076252F2F382.quest_desc: ["功能上与有线 Crafting Terminal 相同。使用 Memory Card 将其绑定到 Wireless Access Point。添加 Wireless Boosters 以扩展其范围。"]
	quest.5E43076252F2F382.quest_subtitle: "无需有线连接即可提供完整网络和合成访问的无线合成终端。"
	quest.5E56F602B8815496.quest_desc: [
		"右键点击红石请求器，将其连接到物流网络，然后放置。"
		""
		"红石请求器的请求可以在其菜单中配置。它可以请求最多 256 个 9 种不同类型的物品，并发送到指定的地址。"
		""
		"当红石信号供电时，请求器会发出UI中设置的请求。如果网络中找不到所需物品，请求将不会被发出。"
	]
	quest.5E56F602B8815496.quest_subtitle: "红石请求器用于向已连接的包装器请求纸板包裹。"
	quest.5E71A9D153C9C00D.quest_desc: ["非常适合将流体长距离输送或干净地穿过墙壁。一个输入隧道可服务于多个输出。使用记忆卡连接隧道。"]
	quest.5E71A9D153C9C00D.quest_subtitle: "无需流体管道即可在两个网络点之间传输流体。"
	quest.5E865A4AE339EA79.quest_desc: ["由能量石和高级组件制成。比普通电池存储的RF多得多，支持后期工具和增强装备的高能耗。"]
	quest.5E865A4AE339EA79.quest_subtitle: "用于中后期游戏的高容量电池，满足电力需求。"
	quest.5F0529F84BBC470A.quest_desc: ["将木板浸泡在焦油（来自焦炉）中可生产出处理木材。沉浸式工程中的几乎所有机器都需要它。尽早建造多个焦炉来储备焦油。"]
	quest.5F0529F84BBC470A.quest_subtitle: "经Creosote Oil处理的木材——一种关键的合成材料。"
	quest.5F4DE0F8F3D97A06.quest_desc: ["终端能让你访问网络中存储的一切。模式提供器和分子组装器是自动合成的核心，让你能随时请求自动合成物品。"]
	quest.5F4DE0F8F3D97A06.quest_subtitle: "准备好终端和模式提供器后，是时候设置ME自动合成系统了。"
	quest.5FFC30447F711C84.quest_desc: ["放置在多层方块中，取代低阶核心。随着工厂日益复杂，为附加组件和机器扩展层提供更多空间。"]
	quest.5FFC30447F711C84.quest_subtitle: "用于大型自动化装置的高级机器核心。"
	quest.605337EA27022515.quest_desc: ["将卡片插入总线、驱动和其他设备的升级槽。卡片可添加红石控制、更快的速度、白名单/黑名单过滤、虚空溢出和自动合成触发器。"]
	quest.605337EA27022515.quest_subtitle: "升级卡可自定义AE2设备的行为，以获得更高的控制度和效率。"
	quest.6108E95FBA6DDFBF.quest_desc: ["连接到除基础发电机外的任意发电机。该发电机将停止直接产生RF，改为以2:1的比例输出蒸汽，蒸汽可输入蒸汽机。"]
	quest.6108E95FBA6DDFBF.quest_subtitle: "将发电机的输出从RF转换为蒸汽。"
	quest.6115BB4B5CCD9FDC.quest_desc: ["用于制作所有MV机器，或对现有LV机器右键升级。升级后的机器将只接受MV线缆。"]
	quest.6115BB4B5CCD9FDC.quest_subtitle: "由不锈钢制成的MV级机器外壳。"
	quest.61348E2551E8AD6C.quest_desc: [
		"要让旋转速度控制器正常工作，必须搭配一个大齿轮。当旋转速度控制器由大齿轮供电时，它会从侧面输出任意所需的旋转速度。反之亦然：当从侧面供电时，它会控制大齿轮的速度。"
		""
		"旋转速度和方向可在机器前后端的数值设置界面中更改。速度最高可达顺时针或逆时针256转/分钟。"
	]
	quest.61348E2551E8AD6C.quest_subtitle: "旋转速度控制器是一种机械组件，能让玩家精确控制旋转速度。"
	quest.61394B66E3FE94B2.quest_desc: ["自动为相邻物品栏中的FE物品充能。Blazing版本每刻的充能速度明显更快。"]
	quest.61394B66E3FE94B2.quest_subtitle: "更快的物品充能速度"
	quest.6185B8080800BA40.quest_desc: ["由铀矿供能的 FE 多块结构发电机。手持 36 个反应堆方块，在 3x4 的空地上放置，它们会自动组装成反应堆结构。"]
	quest.6185B8080800BA40.quest_subtitle: "核能发电"
	quest.61A8395B0B76F622.quest_desc: ["在相邻方块和末地网络之间传输大量FE。非常适合将高级发电机直接连接到电网。"]
	quest.61A8395B0B76F622.quest_subtitle: "灵性网络网关"
	quest.61B98A3B8FAEC1CB.quest_desc: ["由硅晶圆、电子元件和红石在装配器中建造。大多数中后期物流方块、过滤器和需要复杂控制逻辑的机器都需要它。"]
	quest.61B98A3B8FAEC1CB.quest_subtitle: "处理器是游戏中期的逻辑板，当 Oritech 配方超越基础储能和电机，进入自动化、控制和机器智能阶段时才会用到。"
	quest.61FF140A38E205E3.quest_desc: ["用方块输入并提供RF，即可在机器前逐个放置。搭配破坏者，可建造自动原石农场等循环装置。"]
	quest.61FF140A38E205E3.quest_subtitle: "将内部物品栏中的方块放置到世界中。"
	quest.622F2F211736582B.quest_desc: ["通过工程师工作台使用蓝图制作。灯泡用于电灯笼和一些电路组件中。如果不更换，它会随时间烧毁。"]
	quest.622F2F211736582B.quest_subtitle: "为电灯和其他发光设备提供电力。"
	quest.6235E91D8FE09423.quest_desc: ["以最大速率从已充能物品中提取FE。Nitro Discharger能在数秒内耗尽最大的电池。"]
	quest.6235E91D8FE09423.quest_subtitle: "最大能量提取量"
	quest.626580DB654F128D.quest_desc: ["Crushing Wheels 的紧凑低阶替代品。将物品置于顶部或通过漏斗和漏斗桶送入；底部提供旋转力，磨石将输入物缓慢研磨成可从底部或侧面提取的输出物。"]
	quest.626580DB654F128D.quest_subtitle: "磨石能够将研磨配方应用于从上方投入的任何有效物品。"
	quest.629536DB0EE7F8D1.quest_desc: ["IE中容量最高的电容器。用于缓冲柴油发电机产生的电力。通过高压电线连接，并用螺丝刀配置输入/输出。为后期高耗能机器供电所必需。"]
	quest.629536DB0EE7F8D1.quest_subtitle: "最多可存储 4,000,000 IF — HV 级能量缓冲器。"
	quest.62A63BA875670AAC.quest_desc: [
		"获取中"
		""
		"-实体捕获：将Dubios容器交给Allay，或与Vex互动以捕获它们的精华。"
		""
		"-离心机（替代方案）：用Strange Matter处理Dubios Container即可合成。此方法成本远高于捕捉实体。"
	]
	quest.62A63BA875670AAC.quest_subtitle: "通过捕捉特定魔法实体获得的稀有逻辑核心。"
	quest.62BAE54B507B7A21.quest_desc: ["将物品装入纸板箱，寄往青蛙港或货运站，系统会通过滑道、管道和火车自动转运。打包机、货运显示器和红石请求器构成了该网络的核心。"]
	quest.62BAE54B507B7A21.quest_subtitle: "欢迎来到创造物流：将物品装入带地址的纸板包裹，在工厂内运输。"
	quest.62BAE54B507B7A21.title: "物流系统"
	quest.62D91C2154F462E3.quest_desc: ["将Alternator放置在Shaft上并提供Rotational Force。转速越快、应力越高，产生的FE就越多。使用Connectors和铜线或金线将产生的电力接入你的电网。"]
	quest.62D91C2154F462E3.quest_subtitle: "将Create的旋转力转换为FE/RF能量。"
	quest.62E51F67812F501F.quest_desc: ["由处理单元板、RAM、ALU、MMU和数字电路组装而成。高度先进的机器和所有核时代设备所必需。"]
	quest.62E51F67812F501F.quest_subtitle: "EV级电路，结合了多种先进的子组件。"
	quest.6308617812E40CA5.quest_desc: ["用水平方向的水源包围它，每5秒最多产生1桶水。消耗1 EU/t的蒸汽，并在输出端自动向机器供水。"]
	quest.6308617812E40CA5.quest_subtitle: "为锅炉和冷却装置自动化生产水源。"
	quest.633AEA927B6C926C.quest_desc: ["配置过滤器以仅导出特定物品。支持速度、容量、模糊、合成和红石卡。合成卡允许总线在物品缺货时请求自动合成。"]
	quest.633AEA927B6C926C.quest_subtitle: "从ME网络中拉取物品或流体，并将其推入相邻的容器中。"
	quest.634F916431D828E8.quest_desc: ["可用的最大空间单元层级。运行需要大量AE能量。一旦区域被捕获，该单元将永久分配给这些精确的维度。"]
	quest.634F916431D828E8.quest_subtitle: "存储了由 Spatial IO 系统捕获的 128x128x128 物理空间区域。"
	quest.6350ADB7540C368D.quest_desc: [
		"如果智能观察者正面朝向机械带、漏斗或流体管道等容器，当检测到内部有物品时，它会发出红石信号。如果放置在它前面的方块与过滤器匹配，智能观察者也会发出信号。"
		""
		"如果智能观察者应用了过滤器，那么只有在检测到过滤器中的物品时，它才会发出红石信号。"
	]
	quest.6350ADB7540C368D.quest_subtitle: "智能观察者是一种机器，其发出的红石信号取决于其前方容器中方块或物品的状态。"
	quest.6381E9B427FCD5A0.quest_desc: ["用于制作出口总线（Export Bus）和成型平面（Formation Plane）。成型平面可将网络中的方块直接放置在其前方。与湮灭核心（Annihilation Core）搭配使用，可实现完整的输入输出自动化。"]
	quest.6381E9B427FCD5A0.quest_subtitle: "Formation Core 是 AE2 位面系统的输出端，负责将物品从网络传输到世界中。"
	quest.638386FA2D6D86B8.quest_desc: ["布局与 Coke Oven 相同，但使用 Fire Clay Bricks 并多一层空心顶层。可将未煮熟的钢粉熔炼成钢锭，后期可燃烧 Raw Synthetic Oil。"]
	quest.638386FA2D6D86B8.quest_subtitle: "一个能够锻造钢锭的蒸汽多区块结构。"
	quest.63AEE6C4C4505DD9.quest_desc: ["在蒸汽高炉中燃烧原始合成油即可获得。在搅拌机中将其与纸张混合，可生产出橡胶片。"]
	quest.63AEE6C4C4505DD9.quest_subtitle: "精炼油用于大规模生产橡胶片。"
	quest.63C10A24B9BF2E8E.quest_desc: ["将附加组件直接连接到机器或已连接的扩展器。每台机器仅在特定插槽接受附加组件，具体位置显示在其UI的附加组件标签页或方块上的可见标记中。"]
	quest.63C10A24B9BF2E8E.quest_subtitle: "附加组件是升级 Oritech 机器的主要方式。"
	quest.63C659647BFE3224.quest_desc: ["用铜线加固的塑料板。在合成器中将其与电容、电阻、电感和铜线结合，即可制作模拟电路。"]
	quest.63C659647BFE3224.quest_subtitle: "用于安装模拟电路组件的基板。"
	quest.64615688A753A824.quest_desc: ["通过流体管道连接到液态经验储罐。经验灯笼在缓慢消耗流体的同时发出强光，非常适合营造氛围的魔法建筑、附魔室，或装饰在 Create: Enchantment Industry 机械附近的照明。"]
	quest.64615688A753A824.quest_subtitle: "一盏消耗液态经验值来发光，且永不熄灭的魔法灯笼。"
	quest.64BF887B8D1A5C49.quest_desc: ["将26个焦炭砖排列成一个中空的3x3x3立方体，然后用工程师之锤右键任意一面的中心即可形成焦炭炉。投入煤炭以生产煤炭焦炭和焦油油。"]
	quest.64BF887B8D1A5C49.quest_subtitle: "焦炭炉多区块结构的组成方块。"
	quest.64D313FF4B35D959.quest_desc: ["放置在高温方块（岩浆、熔岩）顶部，旁边需有冷却流体（如水）。只要温差存在，即可被动生成FE。"]
	quest.64D313FF4B35D959.quest_subtitle: "温差动力装置"
	quest.654FBC78D1C3B35D.quest_desc: ["默认情况下，传感器上升时信号会增强。数值面板可设置对应0和15的最小及最大高度，并可反转输出方向。佩戴工程师护目镜可显示精确气压和高度，而扳手则能显示细微高度变化：这对自动驾驶和定高逻辑至关重要。"]
	quest.654FBC78D1C3B35D.quest_subtitle: "根据当前高度输出模拟红石信号。"
	quest.65715BCC3BF025C1.quest_desc: ["用红石供电后，热气球燃烧器会逐渐填充上方的密封气球囊。输入面板设置最大热气流输出，红石信号会按比例调节该输出。升力受气球体积限制，因此多个燃烧器可以组合成一个大型气球。灵魂附魔物品会改变火焰的外观。"]
	quest.65715BCC3BF025C1.quest_subtitle: "热气球燃烧器通过从下方用热空气填充气球来产生升力。"
	quest.657210DE728CE88E.quest_desc: ["每个网络只能有一个晶体共振发电机处于激活状态；多个装置会冲突并降低输出。适用于小型或早期网络的可信被动电源。"]
	quest.657210DE728CE88E.quest_subtitle: "无需消耗任何燃料即可被动生成AE电力。"
	quest.657CE123F92867DF.quest_desc: ["得益于自动超频，在LV下可达32 EU/t，比青铜搅拌机快得多。非常适合批量生产合金粉尘。"]
	quest.657CE123F92867DF.quest_subtitle: "青铜搅拌机的LV电力升级组件。"
	quest.65EDA8A6BAEA9E6C.quest_subtitle: "要手动为充电器供电，请在顶部或底部放置一个木制曲柄，并右键单击直到物品充满电。"
	quest.6678D1BD61B3D589.quest_desc: ["内置的《现代工业化》手册。右键打开，浏览从蒸汽时代到终局的完整流程，包括多方块布局和材料链。"]
	quest.6678D1BD61B3D589.quest_subtitle: "官方现代工业化指南手册。"
	quest.667FE50D9BAFF3C0.quest_desc: ["通常作为镍加工的副产品，或使用不锈钢钻头开采深层矿床获得。用于内存管理单元、处理器单元板和高级电路。"]
	quest.667FE50D9BAFF3C0.quest_subtitle: "一种用于高端电子产品的稀有金属。"
	quest.668F5E811B63CDF5.quest_desc: ["这个3x5x3的多方块结构有两个输入罐和一个输出罐。加入硝酸盐粉尘作为一次性催化剂（可永久使用）。输入植物油和乙醇，炼油机将自动产出生物柴油供你的柴油发电机使用。"]
	quest.668F5E811B63CDF5.quest_subtitle: "将植物油和乙醇结合成生物柴油燃料。"
	quest.6698A0C214E884D2.quest_desc: ["在原子熔炉中用超导体和多种稀有材料制成。用于制作普罗米修姆、高级计算引擎和粒子收集器。"]
	quest.6698A0C214E884D2.quest_subtitle: "用于游戏后期制作的先进量子组件。"
	quest.66AA8ED9D1B0F8B8.quest_desc: ["HV 电线在 32 格内传输高达 32,768 IF/t，损耗仅为 0.08%。始终存在触电风险——请将其抬高或远离。在机器附近使用变压器降压至 MV 或 LV。"]
	quest.66AA8ED9D1B0F8B8.quest_subtitle: "高压（HV）电力等级的钢线线圈。"
	quest.66AC200F6CF1A9CD.quest_desc: ["电机、活塞、泵、传送带和铜镍磁线这些基础部件是所有电动机的基石。尽早用装配器自动化它们，LV 制造几乎就免费了。"]
	quest.66AC200F6CF1A9CD.quest_subtitle: "所有LV电气机器都使用的基础机械部件。"
	quest.66AC200F6CF1A9CD.title: "组件"
	quest.6709FB005C1B6BAE.quest_desc: ["量子盔甲套装的每件装备都有25%的几率完全抵消所受伤害。穿戴全套可免疫所有伤害并获得创造模式般的飞行能力。"]
	quest.6709FB005C1B6BAE.quest_subtitle: "终末靴，完整量子套装的一部分。"
	quest.67351B5448868E59.quest_desc: ["基础粒子传感器的加强版。通过比较器更精确地读取粒子速度，帮助你调整需要特定速度的环形布局。"]
	quest.67351B5448868E59.quest_subtitle: "升级后的速度传感器，在加速器环中也可用作直线导轨方块。"
	quest.678B06CDCCBEB089.quest_desc: ["在合成器中用硅晶圆和数字电路制成。构成处理单元的四种高级子组件之一。"]
	quest.678B06CDCCBEB089.quest_subtitle: "用于处理器单元内部的存储芯片。"
	quest.679392DF76DBCB26.quest_desc: ["每个等级都会使机器通过电缆能吸收的最大RF成倍增加。需要配合更高速度或处理附加组件，这样瓶颈就会变成电力而非电缆。"]
	quest.679392DF76DBCB26.quest_subtitle: "使用 Oritech Things 的升级接收器附加组件，以实现极高的 RF/t 输入。"
	quest.679392DF76DBCB26.title: "更多接收器 (More Acceptor)"
	quest.67B350EF1D4639A1.quest_desc: ["由铂金、硅晶圆和数字电路制成。组装处理器单元等高级电路所必需。"]
	quest.67B350EF1D4639A1.quest_subtitle: "用于指导处理单元访问内存的控制芯片。"
	quest.6819665DA7028C9E.quest_desc: ["用金锭在机械压机下压制，或用轧机轧制而成。金箔是制作黄铜外壳（间接）、电子管、精密机械和许多中后期组件所必需的。"]
	quest.6819665DA7028C9E.quest_subtitle: "压制金箔，用于许多先进的创造组件和电路中。"
	quest.6887C6B7ED8727B3.quest_desc: ["热空气源从顶部向下填充气球，气体必须由密封方块封住。气球的封闭式竖管变种能让你在保持密封的同时传递旋转。放置在气球内的实心方块会减少其可用体积。右键点击气球并使用染料可重新上色。"]
	quest.6887C6B7ED8727B3.quest_subtitle: "包裹一个密封体积，用于储存提升气球所用的热气或蒸汽。"
	quest.68C1F956504587C4.quest_desc: ["在蒸馏塔建造前，原油加工的核心。将原油、石脑油和其他中间馏分油逐一分离成较轻的燃料。"]
	quest.68C1F956504587C4.quest_subtitle: "将流体提炼成更轻的馏分。"
	quest.69063947A26DD21F.quest_desc: ["右键点击以在Storage Unit或Transformer中为其充电。它能防止坠落伤害并启用创造模式风格的飞行，但不提供其他任何伤害防护。"]
	quest.69063947A26DD21F.quest_subtitle: "一种通过反重力提供飞行能力的欧盟能源动力胸甲。"
	quest.692F1705458F1AD1.quest_desc: ["将其与目标指示器一同安装在激光臂上，即可开采整个区域。掉落物会收集到激光的内部物品栏中，可从任意一侧提取。"]
	quest.692F1705458F1AD1.quest_subtitle: "将enderic激光转换为自动化采矿场。"
	quest.693DA91C959A72CC.quest_desc: ["转换比例：2 FE = 1 AE。转换速度随网络中AE储能量的多少而变化。也可用作电缆子部件。添加更多能量单元可提高转换吞吐量。"]
	quest.693DA91C959A72CC.quest_subtitle: "将外部Forge能量（FE/RF）转换为ME网络的AE能量。"
	quest.6965C90600AD43E7.quest_desc: ["用 Sheet Metal 块建造一个底部有 Silo 块的空心塔，然后用 Hammer 塑形。可存储大量物品。与 Extract Conveyors 集成以自动化物品的进出流动。"]
	quest.6965C90600AD43E7.quest_subtitle: "可扩展的多方块塔式物品批量存储。"
	quest.69733A128FA0BEA9.quest_desc: ["Oritech 的电力是基于推力的，发电机和存储方块将电力推入管道，再由管道输送至连接的机器。管道本身没有抽取模式。可以使用扳手来禁用管道连接。"]
	quest.69733A128FA0BEA9.quest_subtitle: "在机器和储能设备之间传输能量（RF）。默认传输速率为 10,000 RF/t。"
	quest.69AD0DAA33150063.quest_desc: ["将物品从 JEI/REI 拖入配方槽。处理模式最灵活：任何输入都可对应任何输出。编码模式需放入模式提供者以激活自动合成。"]
	quest.69AD0DAA33150063.quest_subtitle: "将合成、加工、锻造和石匠配方编码为自动合成的模式。"
	quest.6A4BFC1DE5297803.quest_desc: ["没有控制器，你的网络最多只能连接8个设备。控制器会沿最短路径将频道路由到每个设备。通过能量接收器供电。可扩展至7x7x7的多方块结构。"]
	quest.6A4BFC1DE5297803.quest_subtitle: "ME控制器是一个大型网络的核心，每个面提供32个频道。"
	quest.6A4BFC1DE5297803.title: "&l&9我的控制器&r&r"
	quest.6A7EB5E361DEE769.quest_desc: ["将Hypertube放置在Hypertube入口和目的地之间。物品通过弯道和拐角的速度比滑道或管道快得多，非常适合连接遥远的工厂或分拣中心。"]
	quest.6A7EB5E361DEE769.quest_subtitle: "用于将物品输送到远距离的高速物品传输管。"
	quest.6A8049E2BD7C1F53.quest_desc: ["配置过滤器以仅导入特定物品。支持速度、容量、模糊、反相和红石卡。源物品栏为空时会进入睡眠模式，以提高性能。"]
	quest.6A8049E2BD7C1F53.quest_subtitle: "从相邻的容器中吸取物品或流体，并存入ME网络。"
	quest.6A84FC7CC5304E10.quest_desc: ["在熔炉中混合一个铜锭和一个锌锭以生产熔炼黄铜，然后将其倒入锭模（或倒入储存箱）以获得黄铜锭。黄铜是制作黄铜外壳、漏斗、隧道、部署器和大多数自动化工具所必需的。"]
	quest.6A84FC7CC5304E10.quest_subtitle: "黄铜是高级创造组件的材料，由铜和锌制成。"
	quest.6A8CC3AFF76DDC26.quest_desc: ["将内部油箱加满生物柴油。用铁或钢钻头升级以提高速度。工作台可选升级包括时运、大型油箱和3x3挖掘模式。在充电站进行充电。"]
	quest.6A8CC3AFF76DDC26.quest_subtitle: "一种可更换钻头、以燃料为动力的采矿工具。"
	quest.6AB8AFB1EC34E2FF.quest_desc: ["用于制作无法在普通工作台制作的 IE 专属配方的一种多方块工作台。也用于升级采矿钻头和轨道炮等工具。某些配方需要蓝图。"]
	quest.6AB8AFB1EC34E2FF.quest_subtitle: "工程师的进阶配方和升级的合成台。"
	quest.6BC833A2D916A0DC.quest_desc: ["扩展对接连接器会主动对齐，靠近后便会刚性锁定，使两侧保持独立机械装置。物品和流体可双向流动，但插入和提取需在两侧都布线。任一连接器均可缩回以解除对接，比较器可读取对接进度。"]
	quest.6BC833A2D916A0DC.quest_subtitle: "一对闩锁，可将两个机械装置刚性连接，并实现物品和流体的传输。"
	quest.6BCCCD24597C1846.quest_desc: ["利用温差产生最大可能的FE/t。一组Nitro Thermo Generator可用作近乎无限的被动电源。"]
	quest.6BCCCD24597C1846.quest_subtitle: "终极热交换器"
	quest.6BDBE9743156C753.quest_desc: ["燃烧任何固体熔炉燃料（煤炭、木材等）以产生FE。更高等级能产生更多FE/秒，但燃料消耗率保持不变。"]
	quest.6BDBE9743156C753.quest_subtitle: "把它烧掉"
	quest.6BF1B6F2253A33C4.quest_desc: ["Toggle Bus 在接收到红石信号时会阻断流动；Inverted Toggle Bus 则相反。可用于条件隔离网络部分或通过自动化控制设备活动。"]
	quest.6BF1B6F2253A33C4.quest_subtitle: "Toggle Buses 会根据红石信号启用或禁用电缆连接。"
	quest.6BFA9314B5F51CFD.quest_desc: ["生产硫酸、盐酸以及铬和锰生产所需溶液所必需。最重要的MV机器之一。"]
	quest.6BFA9314B5F51CFD.quest_subtitle: "一种用于混合物品和流体以进行化学反应的机器。"
	quest.6C0DFC9667196100.quest_desc: ["比烈焰棒提供高得多的输入输出。在能量球周围放置多个尼奥特之杖可大幅缩短制作时间。"]
	quest.6C0DFC9667196100.quest_subtitle: "Niotic Throughput"
	quest.6C34728CB6B63A37.quest_desc: [
		"这些装置利用高浓缩核材料引发大规模局部爆炸，用于大规模地形改造和清除敌对区域。"
		""
		"它们可通过红石信号或附近的爆炸触发。注意，信号和爆炸之间没有延迟。"
	]
	quest.6C34728CB6B63A37.quest_subtitle: "曼哈顿模块是一种用于战略拆除的巨大爆炸装置。"
	quest.6C8ECDCBEDCD3677.quest_subtitle: "陨石罗盘指向最近的神秘立方体，从而指向最近的陨石。"
	quest.6CD96328B7567F46.quest_desc: ["机械收割机在前进时会收割所有接触到的成熟作物。"]
	quest.6CD96328B7567F46.quest_subtitle: "机械收割机是用于&3机械装置&r中收割作物的组件。"
	quest.6D03D3B4D83C1840.quest_desc: [
		"用扳手右键机械合成器的正面，可以改变它在合成时传送物品的方向。"
		""
		"机械工匠可以由漏斗或漏斗桶自动填充。"
		""
		"在机械合成台的背面和侧面，可以用扳手连接或断开相邻合成台的物品栏。合成台可以共享物品栏，而无需参与相同的合成配方。"
		""
		"物品也可以通过手动方式放入或取出。"
		""
		"每个机械工匠都有一个内部齿轮，只能由相邻的机械工匠或任意大小的齿轮提供动力。这意味着装置中只需一个机械工匠由齿轮供电。"
		""
		"当旋转力驱动，并用红石供电或所有合成槽填满时，机械合成器会将物品发送至相邻的合成器。配方成功需所有物品最终在同一个合成器中相遇。所有物品到达最后一个合成器后，将转化为产物。"
	]
	quest.6D03D3B4D83C1840.quest_subtitle: "机械合成器是一种能自动合成物品的机器。"
	quest.6D6B9DEC00212D1A.quest_desc: ["在粒子加速器中，通过特定资源的高速碰撞锻造而成。用于组装深钻和其他能引导不稳定能量的装置。"]
	quest.6D6B9DEC00212D1A.quest_subtitle: "一块散发着强烈不稳定能量的水晶。"
	quest.6DE566C6E0AD1CB4.quest_desc: ["由橡胶片和锡线围绕纸芯制成的小型电容器。制作模拟电路所需的五种被动元件之一。"]
	quest.6DE566C6E0AD1CB4.quest_subtitle: "用于模拟电路组装的被动电子元件。"
	quest.6E3DE28E9B0185C8.quest_desc: [
		"在默认加法设置下，速度提升50%，即机器以正常速度的150%运行。原本需要100刻的配方，因此将在约67刻内完成。"
		""
		"性能提升以牺牲能效为代价，使机器能耗增加20%。可在单个机器上使用多个速度附加组件以进一步提高总速度。"
		""
		"适用于每个工作周期都会消耗能量的所有机器。"
	]
	quest.6E3DE28E9B0185C8.quest_subtitle: "速度附加组件用于加快机器的处理时间。"
	quest.6E736E3EFA5C57CC.quest_desc: ["将物品和附魔书放入其 Depot，然后提供 Liquid Experience 和 Rotational Force。Blaze Enchanter 会将附魔从书中转移到物品上。通过重复操作可以叠加多个附魔。"]
	quest.6E736E3EFA5C57CC.quest_subtitle: "一种消耗液态经验和旋转力来附魔物品的烈焰熔炉。"
	quest.6E7AE6371A787560.quest_desc: ["以极佳的比例生产螺栓、齿轮、环和杆，并自动超频至 32 EU/t。可与插槽锁定结合，一次性自动化多种零件类型。"]
	quest.6E7AE6371A787560.quest_subtitle: "用于切割高级零件形状的LV切割机。"
	quest.6E8C6A4A07957E5A.quest_desc: [
		"当旋转力作用于软管滑轮时，软管可无限延伸。反转旋转力会使软管缩回方块。软管滑轮必须在运作前至少延伸一个方块。"
		""
		"软管需要流体泵来排水或注水。"
		""
		"-如果流体被抽出，它将把液体排空至软管所在的高度。如果多个软管滑轮从同一水源抽水，在管道容量允许的情况下，将有效加快排水过程。"
		""
		"-如果泵入流体，它将淹没任意大小的房间，软管会标记出最高淹没点。"
	]
	quest.6E8C6A4A07957E5A.quest_subtitle: "软管滑轮可以放下一根软管来排空液体。"
	quest.6E9903B7AEDD66CD.quest_desc: ["一台能处理高温合金化的多区块机器。投入如 adamant、energit 或 biosteel 等粉尘混合物，比手工合成能更高效地获得对应的合金锭。"]
	quest.6E9903B7AEDD66CD.quest_subtitle: "将粉尘熔炼成锭，并将合金粉尘结合成熔融金属。"
	quest.6EEB67A49B23E37C.quest_desc: [
		"功能特性"
		"-Unbreakable: 与其他 Prometheum 工具一样，这把斧头没有耐久度，永远不会损坏。"
		""
		"-伐木：潜行（Shift）状态下采集原木，战斧将自动砍断目标方块上方的整棵树。原木和树叶会被收集并掉落至树下。"
		""
		"-Extended Reach: 手持时增加与方块和实体的交互距离。"
		""
		"-Combat: 它能造成可观的伤害，除了工具外，也是一件可行的武器。"
		""
		"-标准斧头操作：可用于剥树皮、刮铜矿，以及执行所有其他标准斧头功能。"
	]
	quest.6EEB67A49B23E37C.quest_subtitle: "Prometheum 战斧是一种不可损坏的多用途采集工具。它既能作为强力斧头剥取木材和攻击敌人，也能一击砍倒整棵树。"
	quest.6F0C9DAC70081FC9.quest_desc: ["在核反应堆中运行过的贫铀棒内发现。进一步提炼成钚锭，以制造更高效的燃料棒。"]
	quest.6F0C9DAC70081FC9.quest_subtitle: "从乏核燃料中提取的裂变粉尘。"
	quest.6F502CADBF1A4BBA.quest_desc: ["更好的核心并不会自动让机器变快。它们的主要作用是增加机器所能支持的扩展器和附加组件的层数。"]
	quest.6F502CADBF1A4BBA.quest_subtitle: "机器核心决定了 Oritech 多块机器的好坏。"
	quest.6FA74E0E712CEB85.quest_desc: ["放置在箱子、机器出口或多方块出口旁边。传送带会提取物品并将其输送到下一段。无需红石——只要有物品，就会被动工作。"]
	quest.6FA74E0E712CEB85.quest_subtitle: "自动从相邻的背包中取出物品。"
	quest.702820D5CD9D1E97.quest_desc: [
		"电力可通过顶部或底部提供，使用AE2的线缆或其他模组的电源线。可接受AE2的电力（AE）或Forge Energy（FE）。物品可从任意一侧放入或取出。仅能取出结果，因此无需过滤器来防止误取出带电的Certus晶体而非普通晶体。可用Certus Quartz Wrench旋转以方便自动化。"
		""
		"可用于将 Certus Quartz Crystal 制成 Charged Certus Quartz Crystal，或将 Compass 制成 Meteorite Compass。"
	]
	quest.702820D5CD9D1E97.quest_subtitle: "充电器可用于为兼容的工具和 Certus Quartz Crystal 充电。"
	quest.703D3D5EEF09E72F.quest_desc: ["将流体存储单元与任意单元组件（1k-256k）结合，即可创建一个ME流体存储单元。流体单元与物品单元使用相同的驱动器槽位。"]
	quest.703D3D5EEF09E72F.quest_subtitle: "用于存储ME网络中液体的ME流体存储单元的外壳。"
	quest.70512E2BFC236AC9.quest_desc: [
		"在主世界，铂矿石生成于地下深处 Y -60 至 Y -20 之间。在末地中，它的分布则要丰富得多。"
		""
		"铂金也可以通过在碎片锻造炉中加工镍来获得。"
	]
	quest.70512E2BFC236AC9.quest_subtitle: "铂金是一种宝贵资源，用于高端电子产品、杜拉钛姆等高级合金以及顶级机械。"
	quest.705C8ABB2339A5D5.quest_desc: ["右键按住以抓住轮盘，移动鼠标即可旋转。潜行状态下旋转会锁定在45°的间隔上，最大旋转角度可在数值面板中设置。轮盘背面的比较器可报告当前是否被握住，适用于飞行员松手时自动解除的功能。"]
	quest.705C8ABB2339A5D5.quest_subtitle: "手持模拟输入：抓住轮子并转动，以产生与角度成比例的 Redstone 信号。"
	quest.7157002074776C07.quest_desc: ["放入导航物品（如指南针或磁石罗盘），该装置便会向该目标发出红石信号。当装置未正对目的地时，信号强度会减弱，这使得简单的转向回路能用比较器锁定已设定的航点。不同的导航物品会提供独特的目标。"]
	quest.7157002074776C07.quest_subtitle: "读取导航物品，并输出指向其目的地的红石信号。"
	quest.719218CEA358D540.quest_desc: ["右键地面放置一条背向你的铁轨。铁轨可朝八个方向放置，对应四个基本方向及其之间的45°夹角。铁轨也可放置在上方没有方块覆盖的方块侧面，此时铁轨将呈45°垂直倾斜。使用任意镐或潜行状态下用扳手右键即可破坏铁轨。使用其他物品破坏会导致铁轨消失。"]
	quest.719218CEA358D540.quest_subtitle: "铁轨是一种用于支撑火车的特殊方块。"
	quest.71B459D7437E09A8.quest_desc: ["将铜和锡锤成粉末，混合以获得更好的比例，然后将青铜粉熔成锭。青铜是你将要建造的每台蒸汽时代机器的基础材料。"]
	quest.71B459D7437E09A8.quest_subtitle: "你工业之旅的第一种合金，由铜和锡制成。"
	quest.71FFF73784CE49C2.quest_desc: ["将锰粉溶于硫酸即可生成。用电解器处理，可获得不锈钢配方所需的锰微粉。"]
	quest.71FFF73784CE49C2.quest_subtitle: "用于提取锰的一种中间解决方案。"
	quest.723909D5EE9B71A7.quest_desc: ["量子盔甲套装的每件装备都有25%的几率完全抵消所受伤害。穿戴全套可免疫所有伤害并获得创造模式般的飞行能力。"]
	quest.723909D5EE9B71A7.quest_subtitle: "终局胸甲，完整量子套装的一部分。"
	quest.724123C2B194AA87.quest_desc: ["搜索、提取和存入网络中任意终端的物品。支持正则表达式搜索，并显示网络总容量。Crafting Terminal 变种增加了内置的合成网格。"]
	quest.724123C2B194AA87.quest_subtitle: "ME终端是你访问和管理网络中存储物品的首要界面。"
	quest.724A47E73B5B35C5.quest_desc: ["量子盔甲套装的每件装备都有25%的几率完全抵消所受伤害。穿戴全套可免疫所有伤害并获得创造模式般的飞行能力。"]
	quest.724A47E73B5B35C5.quest_subtitle: "终局护腿，完整量子套装的一部分。"
	quest.72548E78CCAECE39.quest_desc: ["插入便携式电池可延长其内部能量缓冲。同时提升其他兼容设备的能效。需要高级卡来制作。"]
	quest.72548E78CCAECE39.quest_subtitle: "提高ME设备的储能容量，减少重新充能的频率。"
	quest.7255AA08F71158E1.quest_desc: [
		"用法"
		"用生物质燃料和配方查看器接受的生物材料喂养它。这是一台需要机器核心才能工作的多方块机器。"
		""
		"如果你有树木农场、作物农场或其他能稳定产生有机废物的系统，那么这是最容易自动化的发电机之一。由于它支持附加组件，即使在基本发电机退役后，它仍然能保持实用价值。"
	]
	quest.7255AA08F71158E1.quest_subtitle: "将生物质和其他生物材料转化为能量。回收农场有机废物的好方法。基础生成率为 64 RF/t。"
	quest.725ABFB0F86E3B84.quest_desc: ["在末地中找到。通过充能球，用烈焰水晶为其充能，以解锁烈焰级组件。"]
	quest.725ABFB0F86E3B84.quest_subtitle: "烈焰水晶"
	quest.728A15DCD6D95495.quest_desc: ["由铂金板和数字电路组件制成。包含构成处理单元所需的 RAM、ALU 和 MMU。"]
	quest.728A15DCD6D95495.quest_subtitle: "用于处理器单元组装的高级电路板。"
	quest.728BA6F9043EC5D1.quest_desc: ["和普通能量管道行为一样，但每刻传输的RF更多。当单个管道无法满足高耗能机器时，是主供电干线的理想选择。"]
	quest.728BA6F9043EC5D1.quest_subtitle: "一组能量管道，吞吐量大大增加。"
	quest.7322A19FDA5B78E1.quest_desc: ["阀门手柄的功能与手摇柄类似，但单次使用时的旋转量和方向可以在其值设置屏幕中调整。"]
	quest.7322A19FDA5B78E1.quest_subtitle: "可重复使用的、手摇式旋转力源。右键可旋转相连的机械。"
	quest.732D1A96512F2BFD.quest_desc: [
		"蒸汽引擎是一种提供旋转力的方块。它在生存模式中是所有发电方块中应力单位（SU）容量最高的。它将加热流体储罐中的水所产生的压力转化为旋转力，从而支持大规模物品生产和多个&3机械装置&r的运作。"
		""
		"蒸汽引擎使用加热过的水来提供动力，并放置在流体储罐上，储罐则用作锅炉。引擎上可以安装传动轴来产生动能输出。该输出的方向可以通过引擎侧面的数值设置进行调整。"
		""
		"要提高总发电量，必须提升流体储罐锅炉的三项特性（热量、大小、水量）中的一项或多项。这将使锅炉等级提升至三项特性中最低的一项，从而增加蒸汽引擎能从锅炉中获取的最大SU。单个蒸汽引擎最多只能提取16,384 SU（相当于1个锅炉等级）。为此，可以为单个锅炉连接多个蒸汽引擎以提取更多能量，但这并不会增加锅炉的总发电量。"
		""
		""
		"水箱大小是蒸汽锅炉的基本特性。所需尺寸受输入热量影响。对于被动蒸汽机（0级），锅炉必须是一个2x2的流体水箱，高度最好为一格（再高将浪费资源）。对于主动蒸汽机（1级或以上），锅炉每级热量需有4个方块。例如，1级锅炉至少需4个流体水箱方块，9级锅炉至少需36个方块，而最高可达的18级锅炉则至少需72个方块。"
		""
		""
		"蒸汽锅炉需要热量才能运行。热源必须放置在锅炉罐下方才能生效。所有被动热源产生的热量相同。使用烈焰燃烧器可以产生更多热量，其产热量取决于其状态。"
	]
	quest.732D1A96512F2BFD.quest_subtitle: "蒸汽引擎是一种提供旋转力的方块。"
	quest.733682694C9BB657.quest_desc: ["当来自不同粒子加速器控制器的2个粒子相互碰撞时，可能会产生不同的物品。所需的碰撞能量取决于配方。碰撞能量是两个粒子速度的总和。物品类型在此无关紧要，只有速度才重要。"]
	quest.733682694C9BB657.quest_subtitle: "所有粒子加速器的起点。插入任何物品，将其作为粒子发射到环形轨道中。"
	quest.734AFCD90EC0A6D1.quest_desc: ["利用温差产生大量被动FE。多个Spirited Thermo Generator组成的阵列可构成强大的被动电力支柱。"]
	quest.734AFCD90EC0A6D1.quest_subtitle: "充满活力的热交换器"
	quest.734FECA2ED34F0D7.quest_desc: [
		"可通过管道或桶接受液体燃料。这是一个需要机器核心的多方块结构。你也可以用装有液体的物品点击机器来添加或提取燃料。"
		""
		"原油足以让它运行，但精炼燃料才能让机器真正高效。如果你已有炼油厂，这通常是升级燃料的最佳初始消耗品。"
	]
	quest.734FECA2ED34F0D7.quest_subtitle: "燃烧油或柴油等液体燃料以产生大量能量。默认生成率为 256 RF/t。"
	quest.73B10BDCA634D5FD.quest_desc: ["每个爆发附加组件都会将机器的当前配方复制到额外的内部槽中，从而以成比例更高的能耗为代价，使每刻的输出倍增。"]
	quest.73B10BDCA634D5FD.quest_subtitle: "让机器并行处理多种物品。"
	quest.73FC122F228CEB96.quest_desc: [
		"部分机器组件无需装配器即可合成，但会消耗更多资源。"
		""
		"输入槽中组件的顺序并不重要。如果机器需要2个相同的物品，也可以从同一个槽中取出。"
	]
	quest.73FC122F228CEB96.quest_subtitle: "合成器有一个2x2的合成网格，只要有能量、输入槽中的物品，以及输出槽中成品的位置，它就会自动合成物品。"
	quest.741AC03B9652EF8D.quest_desc: ["通过熔炼沙子或 certus quartz dust 获得 Silicon。无需压印台即可刻印，制成 Printed Silicon。在 Inscriber 中将 Printed Silicon 与相应的印刷电路结合，组装每种处理器。"]
	quest.741AC03B9652EF8D.quest_subtitle: "将硅刻入刻印器可生成印刷硅，这是三种处理器类型都使用的组件。"
	quest.7429FC1E27707218.quest_desc: ["适用于包含多种中间材料的复杂自动化合成链。将多个存储层级整合到一个CPU中，以精确满足您的自动化需求。"]
	quest.7429FC1E27707218.quest_subtitle: "为ME Crafting CPU提供64k字节的合成工作内存。"
	quest.742F950FFFDE819F.quest_desc: ["将其应用于机器，即可解锁远超以往所有升级的极限超频。这是现代工业化终局内容的奖杯。"]
	quest.742F950FFFDE819F.quest_subtitle: "有史以来最强大的机器升级组件。"
	quest.7437F04E5413A8E0.quest_desc: ["安装后可让机器更快地从线缆中吸取能量。当高消耗配方超过机器默认输入速率时需要。"]
	quest.7437F04E5413A8E0.quest_subtitle: "提高机器可接受的最大RF/t。"
	quest.746DACE8912A9DE2.quest_desc: ["在熔炉中用镍、红石和金合成。用于高级电池、大型存储块和大多数高吞吐量能源基础设施。"]
	quest.746DACE8912A9DE2.quest_subtitle: "Energite 是一种高级合金，用于制造先进的电力相关组件和机器。它可用于大容量储能和先进的电力分配。"
	quest.74AD9C3B54878FDB.quest_desc: ["在直升机和其他重心偏高的结构中，当普通螺旋桨轴承会导致升力矢量晃动时，请使用陀螺轴承。它能主动抵消横滚和俯仰，使螺旋桨保持垂直，输入红石信号可将倾斜重置为零。与所有螺旋桨一样，高海拔处输出会减弱。"]
	quest.74AD9C3B54878FDB.quest_subtitle: "自稳螺旋桨轴承：即使装置倾斜，也能保持螺旋桨垂直向上。"
	quest.74B030D7831F13EE.quest_desc: ["这座三格高的结构利用电力和水持续种植作物。投入种子、泥土，可选肥料。电力接顶部，水管接背面。维持生物柴油生产链所必需。"]
	quest.74B030D7831F13EE.quest_subtitle: "一台由电力驱动的自动化作物生长机。"
	quest.74D3B34DC534515D.quest_desc: ["将超管加速器沿超管线路放置。每个加速器都会重新加速通过的物品，从而实现近乎无限的运输范围。适用于跨基地或跨维度的物品物流。"]
	quest.74D3B34DC534515D.quest_subtitle: "提升物品在超管中的传输速度，延长传输范围并提高速度。"
	quest.756715CFB394F888.quest_desc: ["在电动高炉中熔炼成热锭，再用真空冷冻器冷却。涡轮机船体、增压器和内爆压缩机的基础金属。"]
	quest.756715CFB394F888.quest_subtitle: "一种用于高级机械的坚硬高温金属。"
	quest.7578A1015C1ED66D.quest_desc: [
		"能量缓冲器"
		""
		"除了提供额外的附加组件插槽外，该方块还将机器的总容量增加 2,500,000 RF，并将能量吞吐量提高 1,000 RF/t。对于需要大量附加组件的高耗能机器来说，这是一个不错的选择。"
	]
	quest.7578A1015C1ED66D.quest_subtitle: "Power Bank Addon Extender 结合了扩展器的插槽扩展功能与巨大的内部能量储备。适用于所有具有能量的方块。"
	quest.7593E42AEBD98923.quest_desc: ["在相邻方块和末地网络之间传输FE。与末地单元不同，它无法升级网络通道容量，但制造成本更低。"]
	quest.7593E42AEBD98923.quest_subtitle: "网络网关"
	quest.75A7837D3FB78833.quest_desc: [
		"产生蒸汽会消耗水。水和蒸汽可以直接通过附加组件泵入泵出，但机器本身不行。"
		""
		"要使用蒸汽，可以用蒸汽机来产生RF。它以蒸汽为输入，输出水。不过，在此过程中会损失大约20%的水，因此发电机需要稳定的供水。"
	]
	quest.75A7837D3FB78833.quest_subtitle: "所有发电机（基础发电机除外）都可以通过添加蒸汽锅炉附加组件来升级为产生蒸汽。添加后，机器将不再直接产生RF，而是以2:1的比例产生蒸汽。"
	quest.75E7216AB5411DF6.quest_desc: ["朝上放置时，机械锯在旋转力足够时会处理掉落在上面的物品（如原木变木板、石头变台阶等）。安装在朝前的装置上时，它会随着装置移动，砍倒整棵树并破坏前方的方块。"]
	quest.75E7216AB5411DF6.quest_subtitle: "将原木切成木板，处理各种配方，并对机械装置使用时会砍伐树木。"
	quest.76014E3C5DE99810.quest_desc: ["多联块通过物品输入口接收材料，并通过物品输出口排出产物。每个接口会替换结构上的一个外壳槽位。"]
	quest.76014E3C5DE99810.quest_subtitle: "用于将物品进出多区块的输入和输出口。"
	quest.76014E3C5DE99810.title: "青铜物品孵化箱"
	quest.76107F9E33FF5DC9.quest_desc: ["用于将电线绝缘成电缆，以及作为电容器、电阻器和电感器等电子元件的核心材料。自动化是电气时代的首要任务之一。"]
	quest.76107F9E33FF5DC9.quest_subtitle: "由合成油和纸张制成的灵活绝缘片。"
	quest.7640050ABC78F0B2.quest_desc: ["无需额外EU电缆即可远距离传输MI电力。使用记忆卡连接隧道。工作原理与其他P2P能量隧道相同，但传输的是EU而非FE。"]
	quest.7640050ABC78F0B2.quest_subtitle: "通过点对点隧道在两个网络节点之间传输现代工业化EU能源。"
	quest.765009CFB3626487.quest_desc: ["由铁、铜和红石制成的常见 Oritech 组件。它几乎出现在所有机器、附加组件和工具的配方中，因此需要储备大量库存。"]
	quest.765009CFB3626487.quest_subtitle: "用于驱动工业机械中机械部件的标准电动机。"
	quest.7684343E3C2DB080.quest_desc: ["一种将原油和其他混合物分离成精炼成分的模块化机器。堆叠最多两个精炼室模块可解锁额外的流体输出槽。"]
	quest.7684343E3C2DB080.quest_subtitle: "精炼器用于处理物品和流体混合物。它有一个物品输入口、一个流体输入口和多个输出选项。"
	quest.768789FEB6EBB8F8.quest_desc: [
		"可用于加热蒸汽机、批量熏制、批量冶炼，也可用作装饰性光源。"
		""
		"烈焰燃烧器必须有烈焰才能工作。要将烈焰放入空的烈焰燃烧器中，请手持空的烈焰燃烧器右键点击烈焰。或者，也可以通过右键点击烈焰生成器来填充空的烈焰燃烧器。此方法可以重复使用，且不会损坏烈焰生成器。"
		""
		"用任何可作为熔炉燃料的物品右键烈焰燃烧器，会使其暂时进入加热状态。用烈焰蛋糕右键烈焰燃烧器，会使其暂时进入过热状态。"
		""
		"内部的烈焰人会根据提供的燃料量改变其大小和纹理，遵循以下阶段："
		""
		"第一阶段 — 余烬 — 无法提供热量用于混合。放置燃烧器或燃料耗尽时，会进入默认状态。"
		"阶段2 — 加热/点燃 — 启用需要加热的配方。持续时间为燃料的燃烧时间，并为每个烈焰燃烧器提供1个加热等级给蒸汽引擎"
		"阶段3 — 超高温/沸腾 — 解锁所有混合配方，并为每个烈焰燃烧器为蒸汽引擎提供2个加热等级。仅能通过烈焰蛋糕达成。持续时间始终为160秒。此阶段内烈焰燃烧器无法再次喂食。"
	]
	quest.768789FEB6EBB8F8.quest_subtitle: "烈焰燃烧器是一种加热组件，某些混合配方需要它。"
	quest.76919513DA354DBC.quest_desc: [
		"齿轮箱可以将旋转动力向四个水平方向传递。垂直齿轮箱则和普通版本一样，能将动力向四个垂直方向传递。"
		""
		"当齿轮箱从任意输入侧（带轴的形状）接收输入时，它将在所有剩余侧以相反方向输出/传递&a旋转动力&r。换句话说，当输入为顺时针时，其余3个侧的输出为逆时针，反之亦然。"
	]
	quest.76919513DA354DBC.quest_subtitle: "齿轮箱是一种用于在4个方向（水平或垂直）传递旋转动力的方块。"
	quest.76CCE7B3F1922436.quest_desc: ["将机械搅拌机置于水槽上方并提供旋转力。将材料投入水槽以执行混合配方。部分配方——如黄铜和安山合金——还需要水槽下方放置的烈焰燃烧器提供的热量。"]
	quest.76CCE7B3F1922436.quest_subtitle: "将投入盆中的材料组合，可生产出合金、食物和其他混合产物。"
	quest.7703F0CA1A8AB6F9.quest_desc: ["除了多种用途外，它还是制作Shafts和大小Cogwheels的必需材料。Andesite Alloy是Create中最基础的组件构建材料。"]
	quest.7703F0CA1A8AB6F9.quest_subtitle: "安山合金是安山外壳和创造模组中简单动能方块所用的材料。"
	quest.77C3D285E52CCA0E.quest_desc: [""]
	quest.77C3D285E52CCA0E.quest_subtitle: "桌布可以用来向其他玩家出售物品。"
	quest.77D4B279CB51820E.quest_desc: ["让漏斗、管道和其他运输方块通过附加组件而非机器本身与机器互动。当主方块被其多方块结构阻挡时非常有用。"]
	quest.77D4B279CB51820E.quest_subtitle: "将机器的物品栏展示在附加组件的正面。"
	quest.77E21E3DC184C363.quest_desc: ["使用固体燃料缓慢升温，最高温度时每刻产生最多8mb蒸汽——足以驱动4台青铜机器。蒸汽会自动输送至相邻机器。"]
	quest.77E21E3DC184C363.quest_subtitle: "任何蒸汽工厂的核心，将燃料和水转化为蒸汽。"
	quest.77EA98920E57EB27.quest_desc: ["Powah 最强大的发电机。将 36 个 Nitro Reactor 方块放置成 3x4 的区域，它们会自动组装成一个能为整个终局基地供电的发电站。"]
	quest.77EA98920E57EB27.quest_subtitle: "氮化核能"
	quest.7817759A925A289B.quest_desc: ["由耐热外壳和铜镍线圈制成，可生产铝、不锈钢、钛等。运行时需要相应等级的能量输入口。"]
	quest.7817759A925A289B.quest_subtitle: "用于熔炼高级合金所需的电动多区块结构。"
	quest.786E3F93D5908366.quest_desc: ["每个激活的通道都会点亮电缆上的一个彩色圆点。在控制器或瓶颈区域附近使用智能电缆，以诊断通道使用情况并规划电缆布局。"]
	quest.786E3F93D5908366.quest_subtitle: "智能线缆通过其表面的彩色指示灯显示其8个通道中有多少正在使用。"
	quest.788BD46B45162E49.quest_desc: ["通过合成台或在青铜机器上潜行右键来升级。钢制机器速度翻倍，消耗最多4 EU/t，并解锁更多配方。"]
	quest.788BD46B45162E49.quest_subtitle: "将青铜机器升级到钢铁级别的更新。"
	quest.78CCA9EC988BA445.quest_desc: ["将铝土矿粉尘精炼为铝粉尘，解锁铬和锰的微量粉尘，并能分解许多其他化合物。高级化学必备。"]
	quest.78CCA9EC988BA445.quest_subtitle: "利用强大的电流将材料分解成元素。"
	quest.78DEEE44DA6DC746.quest_desc: ["将多个 Crafting Accelerator 添加到 CPU 中，以提高自动合成的吞吐量。对于多个合成步骤快速连续进行的高吞吐量操作至关重要。"]
	quest.78DEEE44DA6DC746.quest_subtitle: "通过减少将材料送入机器之间的延迟来加快合成CPU的速度。"
	quest.78EE63AA4A75C011.quest_desc: ["以极快的速度为相邻物品栏中的FE物品充电。多个Spirited Energy Hopper可同时为一个大型存储系统服务。"]
	quest.78EE63AA4A75C011.quest_subtitle: "物品附魔充能系统"
	quest.7917E75BBA3F0614.quest_desc: [
		"首先，使用显示链接在显示方块上进行链接。然后将其放置在将被读取的源方块上。虽然它可以链接到任何方块，但并非所有方块都能作为显示或源方块。"
		""
		"右键链接以访问其界面。可通过此界面为输出文本添加更多标签。部分源提供多种文本格式化选项。接受界面设置后，显示链接上的绿灯会开始闪烁，表示信息正传输至显示方块。"
	]
	quest.7917E75BBA3F0614.quest_subtitle: "显示链接用于从方块获取信息，并将其发送到可以显示信息的方块。"
	quest.794C0CD2DA500874.quest_desc: ["便携式引擎可使用熔炉燃料运行，并能配置为双向旋转。燃料可通过自动化方式投入，喂食烈焰蛋糕可使引擎过热，暂时提升输出功率。将其与螺旋桨轴承搭配，即可获得无需外部旋转源的完全自航飞艇。"]
	quest.794C0CD2DA500874.quest_subtitle: "一种通过燃烧燃料为移动装置产生旋转力的自包含引擎。"
	quest.7959095B34262545.quest_desc: ["每张速度卡都能提升单次操作的处理量。最多可插入4张卡到导入/导出总线及其他兼容设备中。需要高级卡才能制作。"]
	quest.7959095B34262545.quest_subtitle: "提高兼容的AE2设备的运行速度。"
	quest.7988D1BB63A66FC7.quest_desc: ["比硬化版I/O更快的末地细胞。适用于高吞吐量的末地网络设置。"]
	quest.7988D1BB63A66FC7.quest_subtitle: "更快的末地传送网络"
	quest.798C46DA99925144.quest_desc: ["配置过滤器以允许或阻止特定物品，然后将其与物品管道串联。对于引导离心机、熔炉和多配方机器的特定输出至关重要。"]
	quest.798C46DA99925144.quest_subtitle: "过滤通过物品管道网络传输的物品。"
	quest.79BA0067A6864FC6.quest_desc: ["由处理单元和超导组件建造。核反应堆、大型柴油发电机及其他终局多区块所必需。"]
	quest.79BA0067A6864FC6.quest_subtitle: "用于核能时代机械的EV级机械外壳。"
	quest.79C053DA124BF68E.quest_desc: ["最多可配置9个物品或流体槽位，由网络自动补货。当子网上的模式提供器指向主网络上的接口时，会创建一个高效的物流桥。"]
	quest.79C053DA124BF68E.quest_subtitle: "一种多功能设备，可从网络中补充物品，接收机器的退货，并连接子网络。"
	quest.7B1F8B964612BFD5.quest_desc: ["使用陨石战利品中的逻辑处理器压机在刻印机中打印。将打印电路与打印硅片在刻印机中组合，即可组装最终的逻辑处理器。"]
	quest.7B1F8B964612BFD5.quest_subtitle: "逻辑处理器是最常见的处理器，许多基础AE2组件都需要它。"
	quest.7B3CE9A0B077B28F.quest_desc: ["通过单元工作台分割单元时，此卡会均匀填充每个部分，而不是完全填充一个再处理下一个。需要高级卡才能制作。"]
	quest.7B3CE9A0B077B28F.quest_subtitle: "将物品平均分配到ME存储单元的分隔部分中。"
	quest.7B89FFBFE6C8565A.quest_desc: ["将锭放入轧机并提供旋转力。该方块会将锭轧成金属片（或金属棒，取决于配方）。比机械压机更快更紧凑，是早期自动化金属片的理想选择。"]
	quest.7B89FFBFE6C8565A.quest_subtitle: "来自 Create: Crafts \& Additions 的紧凑型压机，可将锭轧成板材和棒材。"
	quest.7C074B5E2A0EAA63.quest_desc: [
		"组装火车时，必须至少有一个控制器朝向火车创建所在的车站正面。如果需要非玩家乘务员，则必须在控制器正后方放置一个Blaze Burner或座位。"
		""
		"在火车上，右键点击火车控制器即可接管火车。此时玩家的常规移动操作将作用于火车。再次使用控制器或潜行可停止。在岔路口按住左或右键选择路线。使用滚轮调整最高速度。按住跳跃键可进站并对齐。如果装有蒸汽汽笛，按冲刺键即可吹响。"
	]
	quest.7C074B5E2A0EAA63.quest_subtitle: "创建火车时需要火车控制系统。"
	quest.7C2FC333931AB319.quest_desc: ["Create 是由 simibubi 制作的 Minecraft 模组，它允许你使用旋转动力来制造机械装置和自动化流程。它为游戏添加了多种机械组件和方块变体。该模组优化良好，帧率表现优异，几乎可以在任何电脑上流畅运行！"]
	quest.7C2FC333931AB319.quest_subtitle: "赋予玩家力量的美学科技"
	quest.7C922886917D04B6.quest_desc: ["网络中存储的物品会显示在合成网格中。点击 JEI/REI 中的任何可合成配方即可自动填充网格。结果将自动存储回网络中。"]
	quest.7C922886917D04B6.quest_subtitle: "将ME终端访问与内置的合成网格相结合，直接从网络存储中获取物品。"
	quest.7CFBA7624721FE32.quest_desc: [
		"安装此附加组件可将机器的能耗降低20%。机器速度不变，但所需的RF/t会减少。"
		""
		"这对持续运行的机器或能源有限的装置尤其有用。可以叠加多个效率附加组件，进一步降低功耗。"
		""
		"适用于每个工作周期都消耗能量的所有机器。"
	]
	quest.7CFBA7624721FE32.quest_subtitle: "效率附加组件可以降低你机器设备的能耗。"
	quest.7D22EAA37519D4FA.quest_desc: ["在离心机中从空气中提取。用作高级EBF冶炼配方（尤其是最高等级金属）的惰性气体。"]
	quest.7D22EAA37519D4FA.quest_subtitle: "通过离心法提取的一种惰性气体。"
	quest.7D28418129EE6957.quest_desc: ["先放置主机器方块，然后右键点击以高亮显示核心放置位置。更优质的核心不会加快运行速度，只会增加机器所能支持的附加组件和扩展层数量。"]
	quest.7D28418129EE6957.quest_subtitle: "部分机器需要额外的机器核心才能运行。这些核心必须放置在机器本身的特定位置。机器所需的核芯数量会显示在提示框中。核心不能在机器之间共享。"
	quest.7D28418129EE6957.title: "多区块机器"
	quest.7DB15E58060E3CF5.quest_desc: ["将电路板与所有五个被动元件——电容器、电阻器、电感器、铜线和电路板本身——组合在一起。每个基础电动机器外壳内都必需。"]
	quest.7DB15E58060E3CF5.quest_subtitle: "第一级电子电路，可解锁LV机器。"
	quest.7DE1A43C0269F8B5.quest_desc: ["由缠绕在铁芯上的铜线制成。出现在发电机、电动机和大多数依赖电磁组件的中阶机器配方中。"]
	quest.7DE1A43C0269F8B5.quest_subtitle: "机器中产生电磁场的基本组件之一。"
	quest.7DF0D95CD3FE879C.quest_desc: ["在搅拌机中混合铅和锑粉即可制作。熔炼成电池合金锭，用于低压电池舱和储能。"]
	quest.7DF0D95CD3FE879C.quest_subtitle: "用于制作电池的铅锑粉尘混合物。"
	quest.7E1FF283706C48F7.quest_desc: ["模拟装置需要动力才能移动。此处解锁的方块可通过热气球或蒸汽气球产生升力，或通过螺旋桨、帆和引擎产生推力。组合它们即可攀爬、巡航、悬停或动力飞行。注意，随着海拔升高气压降低，所有装置都会变弱，因此高空设计需要更大的气球或更多的螺旋桨。"]
	quest.7E1FF283706C48F7.quest_subtitle: "推进器：将旋转力转化为模拟装置上的推力和升力的方块。"
	quest.7E7202497F167C39.quest_desc: ["蒸汽口和蒸汽机一样，需要足够的热量、水和锅炉空间才能运行。用红石供电时，它会逐渐填充上方的外壳；输入面板设置最大蒸汽输出，红石信号可调节其大小。多个蒸汽口可以合并，但锅炉必须提供足够的功率，使所有蒸汽口都能全负荷运行。"]
	quest.7E7202497F167C39.quest_subtitle: "通过蒸汽填充气球来产生升力，就像蒸汽机产生浮力而非旋转一样。"
	quest.7EA42E9B3FBB179E.quest_desc: ["将每兆焦耳蒸汽直接转换为1EU，最高可达32EU/t。输出端仅连接LV电缆——通常是你要建造的第一个发电机。"]
	quest.7EA42E9B3FBB179E.quest_subtitle: "将蒸汽直接转化为低压电力。"
	quest.7F80C23C2681904D.quest_desc: ["用包裹着铁芯的杯镍磁线制成。模拟电路的必备组件。"]
	quest.7F80C23C2681904D.quest_subtitle: "一种将能量储存在磁场中的被动电子元件。"
	quest.7FA5A4EC7599D28E.quest_desc: ["右键点击水源可将其填满，然后在背包中右键点击燃料物品，将其插入钻头。使用丝绸之触挖掘3x3区域——非常适合与锻造锤搭配，用于早期收集矿石。"]
	quest.7FA5A4EC7599D28E.quest_subtitle: "一台蒸汽动力钻头，能以丝绸之触挖掘3x3范围内的方块。"
