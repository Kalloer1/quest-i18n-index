	order_index: 3
	quest_links: [ ]
	quests: [
		{
			description: [
				"LaserIO 的核心是通过激光传输物品、流体、FE 和红石信号。"
				""
				"该模组的主要方块是激光节点。每次想要放入或取出物品时，你都需要使用一个。"
				""
				"你需要将卡牌插入激光节点才能使其工作。右键点击卡牌或在卡牌上右键点击以打开GUI，切换卡牌的插入或提取模式。在这里你还可以设置过滤器和超频器。"
				""
				"使用激光扳手连接激光节点，如果需要移动超过8格，请使用激光连接器来移动更长的距离。"
				""
				"卡牌无法堆叠，你可以将它们放入卡牌收纳器中，将所有卡牌、过滤器和超频器都保存在一个容器里。"
				""
				"过滤器可用于多种方式决定物品的去向，超频器可用于升级卡牌和激光节点，使其运行更快。"
			]
			id: "519B636AF8E06A4C"
			shape: "gear"
			subtitle: "激光传输！"
			tasks: [{
				id: "0AF0FE8ADCE7B86A"
				title: "LaserIO"
				type: "checkmark"
			}]
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["45A6CD266FAA6DBF"]
			description: [
				"激光节点用于通过卡牌与物品互动。插入卡牌以决定其操作。每个面最多可容纳9张卡牌。"
				""
				"手持卡牌时，右键激光节点的某个面，即可将卡牌插入该面。"
				""
				"用激光扳手将2个激光节点连接起来。最大连接距离为8格，使用激光连接器可连接更远的距离。"
				""
				"基本设置如下所示："
				""
				"- 旁边有激光节点的箱子。"
				"- 在朝向箱子的激光节点上插入一张物品卡。"
				"- 右键点击物品卡以打开GUI。"
				"- 将此物品卡设置为提取。"
				"- 另一个在8格范围内的箱子，旁边有一个激光节点。"
				"- 用激光扳手潜行右键点击第一个激光节点，再右键点击第二个激光节点。"
				"- 在与宝箱接触的面上的第二个激光节点中插入一张物品卡。"
				"默认情况下所有卡牌都设置为插入模式，所以你不需要更改它。"
				"- 现在第一个箱子里的物品将被发送到第二个箱子里。"
				""
				"物品、流体、FE和红石信号都适用同样的原理。"
				""
				"如果需要走得更远，可以研究一下激光连接器。"
				""
				"关于着色器的发光问题，请关闭着色器中的 bloom。\"Options...\" -> \"Video Settings...\" -> \"Shader Packs...\" -> \"Shader Pack Settings...\" -> \"Camera\" -> \"Bloom\": Off。"
			]
			id: "679ABE9E98C1709B"
			subtitle: "传送的根源！"
			tasks: [{
				id: "0D7BA0C3574232C4"
				item: "laserio:laser_node"
				type: "item"
			}]
			x: 0.0d
			y: 3.0d
		}
		{
			description: [
				"用于在更长的距离内旅行。"
				""
				"激光节点只能在8格范围内连接到另一个激光节点或激光连接器。如果需要超过8格，就需要用激光连接器作为中继，连接到另一个激光连接器或激光节点。"
				""
				"- 将激光节点连接到激光中继器。"
				"- 将激光中继器连接到另一个激光节点。"
				"- 两个激光节点现在会相互交互了。"
				""
				"高级激光连接器可以连接更远的距离。"
			]
			id: "45A6CD266FAA6DBF"
			subtitle: "继续前进！"
			tasks: [{
				id: "30E968F153EFF9F6"
				item: "laserio:laser_connector"
