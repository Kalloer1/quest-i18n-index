			x: 16.0d
			y: 0.0d
		}
		{
			description: ["该模组的核心是其机制，增加了新的攻防方式。这些机制旨在补充原版战斗系统，并创造新的玩法。若不知如何开始，可使用一本书和金剑制作一本Patchouli指南。"]
			icon: {
				Count: 1b
				ForgeCaps: {
					"dungeons_libraries:built_in_enchantments": { }
				}
				id: "cnb:cinder_sword"
