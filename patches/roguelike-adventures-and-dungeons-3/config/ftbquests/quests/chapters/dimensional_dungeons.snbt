		}
		{
			dependencies: ["06FDB1551D976F28"]
			description: ["其次，将你的三个镀金传送门方块之一与陷阱箱和末影之眼结合，形成一个传送门钥匙孔方块。"]
			id: "467404C9A88BA929"
			rewards: [{
				id: "77E853324AA3466E"
				item: "aquaculture:lockbox"
				type: "item"
			}]
