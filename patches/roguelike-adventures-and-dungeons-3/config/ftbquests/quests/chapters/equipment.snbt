			}]
			shape: "octagon"
			size: 1.5d
			subtitle: "将附加组件物品分解为稀有材料"
			tasks: [{
				id: "0E4FF1A330394B0A"
				item: "apotheosis:salvaging_table"
				type: "item"
			}]
			x: 8.5d
			y: -1.5d
		}
		{
			dependencies: ["673DE11282C85AD4"]
			description: [
				"要将宝石镶嵌到物品中，请在锻造台里将两者组合。每种宝石都标明了可以镶嵌的物品。部分宝石是独特的，意味着一个物品中只能镶嵌该宝石的一个副本。"
				""
				"&l移除宝石&r"
				"在锻造台将镶嵌物品与撤回印记结合，即可从物品中移除镶嵌的宝石。物品和所有宝石都将被返还。"
			]
			id: "31F1B5BF67E7FC49"
			rewards: [{
				id: "61C9B0F9B9FFC839"
				type: "xp"
				xp: 50
			}]
			subtitle: "用于将宝石镶嵌到物品中"
			tasks: [{
