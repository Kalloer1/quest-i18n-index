	quest_links: [ ]
	quests: [
		{
			description: [
				"它们可以在&5锻造台&r上插入到装备中。"
				""
				"每种&4宝石&r都会根据所装备的类型提供不同的属性加成。"
				""
				"宝石可以通过以下方式获得："
				""
				"- 作为其他维度的战利品掉落"
				"- &c下界&r - 不常见至史诗级"
				"- &f末地&r - 稀有至神话"
				"- &bAether&r - 不常见至神话级"
				"- &eLands of Icaria&r - 不常见至神话级"
				"- &2Undergarden&r - 不常见至神话"
				"- &6大黄蜂地带&r - 不常见至神话级"
				"- &8Dimdungeons&r - 稀有至神话"
				"- &5Bloodmagic Dungeon&r - 稀有至神话"
				"- &1Mining Dimension&r - 稀有至神话级"
				""
				"- 作为&4Apotheosis Bosses&r的掉落物"
				""
				"在“&e市场&r”任务章节中兑换"
			]
			id: "673DE11282C85AD4"
			shape: "octagon"
			size: 1.5d
			subtitle: "寻找可以镶嵌到附魔物品中的阿波西宝石"
			tasks: [{
				advancement: "apotheosis:affix/gem"
				criterion: ""
				id: "03F8DD3FF045B3A7"
				type: "advancement"
			}]
