			}]
			x: 1.0d
			y: -1.5d
		}
		{
			dependencies: ["6024FAA4C01F2FC6"]
			description: [
				"重铸台有三个输入槽位："
				"- 中间的槽位放置你想要重铸的物品。"
				"- 左上角的槽位放置你想要重铸的稀有度所需的稀有度材料。"
				"- 右下角的槽位放置重生印记，这是重铸过程中使用的特殊燃料物品。"
			]
