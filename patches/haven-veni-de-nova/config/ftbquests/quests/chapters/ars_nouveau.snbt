	quests: [
		{
			description: [
				"Ars Nouveau 是一款魔法模组，允许玩家自定义法术、创造魔法物品、执行仪式等等。"
				""
				"借助 Ars Nouveau，你将学会驾驭万物中的法力，施放强力法术，驱动神秘机械，甚至还能在途中为一些可爱的伙伴赋能。"
			]
			disable_toast: true
			icon: "ars_nouveau:creative_spell_book"
			id: "0FF49F7DD4D172CF"
			min_width: 300
			shape: "gear"
			size: 1.5d
