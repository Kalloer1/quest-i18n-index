		"{image:atm:textures/questpics/basicarmor/armor_wayfinder.png width:100 height:150 align:center}"
	]
	quest.62161BDE9AAAA4BF.quest_subtitle: "遗迹废墟"
	quest.62161BDE9AAAA4BF.title: "寻路者盔甲纹饰"
	quest.65A529C8238E89F1.quest_desc: ["多亏了 &5&lMekanism&r，我们现在可以用 &9青金石&r 制作盔甲了！\n\n不过它有点拉胯……"]
	quest.65A529C8238E89F1.quest_subtitle: "9"
	quest.65A529C8238E89F1.title: "&9青金石盔甲"
	quest.65E733AACBE62EDB.quest_desc: [
