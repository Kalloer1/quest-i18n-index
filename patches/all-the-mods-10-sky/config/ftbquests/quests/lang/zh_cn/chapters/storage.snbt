	quest.11A351E2CDE2A31E.title: "便携式储物访问"
	quest.11D4EEAC61C7E530.quest_desc: ["收集器升级会让抽屉从一侧将物品吸入。"]
	quest.11D57C768032E3F7.quest_subtitle: "更多过滤选项"
	quest.11D57C768032E3F7.title: "&e高级磁石升级"
	quest.122FBF5110E4CFF2.quest_desc: ["铁质降级会将抽屉的最大空间降级为一个堆叠量。这有助于控制物品库存，但不会囤积太多。"]
	quest.1310C1E14C259807.quest_desc: ["想要拥有自定义抽屉？无需再寻，这些抽屉的外部可以模仿某个方块的纹理，而正面则可以使用另一种纹理。\n\n请按照提示中的说明操作。"]
	quest.134608BB2B04D96E.quest_desc: ["箱子有 27 个格子，可以组合成双箱来存储两倍的物品。"]
	quest.134608BB2B04D96E.quest_subtitle: "箱子"
	quest.134608BB2B04D96E.title: "原版储物"
