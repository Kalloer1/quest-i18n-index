	quest.4E4C8BCD45766F03.quest_subtitle: "自动压缩/解压"
	quest.508A8366219175FE.quest_desc: ["配置工具用于锁定抽屉，使其记住内部的物品。\n\n这在设置从抽屉存取物品的系统时非常有用。被锁定的抽屉不会替换掉已锁定的物品！"]
	quest.52672B7FFFD51D16.quest_desc: ["为背包添加一个切石机 GUI。"]
	quest.53F861876B991C36.quest_desc: ["为背包添加一个唱片机 GUI。"]
	quest.53F861876B991C36.quest_subtitle: "现在我们来嗨起来"
	quest.544791880F315D5A.quest_desc: ["带箱子的船就是船上带有箱子的船。你可以在船里打开箱子，也可以右键点击它。一次只能有一个人乘坐这艘船。"]
	quest.56B80A7EBFE21428.quest_subtitle: "更多过滤选项"
	quest.56B80A7EBFE21428.title: "&e高级泵升级"
	quest.57CF8C6C867B9BDA.quest_subtitle: "更多过滤选项"
	quest.57CF8C6C867B9BDA.title: "&e高级过滤器升级"
	quest.58514FDE153FD971.quest_subtitle: "铁箱？"
	quest.58514FDE153FD971.title: "&f铁箱"
	quest.5A94A2664BFDD7B9.quest_desc: ["欢迎来到基础存储章节！\n\n你将在这里找到所有无需能源的基础物品存储方法，以及满足你存储需求的实用物品！"]
	quest.5A94A2664BFDD7B9.title: "基础存储"
	quest.5E4BC0F59C90433A.quest_desc: ["Sophisticated Storage 允许你用金属升级箱子和木桶，从而增加它们的存储容量！你还可以添加升级项来提升它们的功能性。\n\n这些箱子就像原版箱子或木桶一样，但它们有一个用于存储升级的插槽！"]
	quest.5E4BC0F59C90433A.quest_subtitle: "\"原版箱子\""
	quest.5E4BC0F59C90433A.title: "Sophisticated Storage"
	quest.5E4FE420B6D2C97F.quest_desc: ["将背包中的物品按照 3x3 配方进行压缩。"]
	quest.5E4FE420B6D2C97F.quest_subtitle: "更多过滤选项"
	quest.5E4FE420B6D2C97F.title: "&e高级压缩升级"
	quest.5FA9BC0D8476D322.quest_desc: ["自动从背包中取出食物喂给你。"]
	quest.615B9062FE8CCD36.quest_desc: ["自动切换为你当前所看方块最高效的工具。"]
	quest.61A22707DBC83818.quest_desc: ["存储访问点在与存储控制器关联后，可充当存储控制器，能够向其推送或从中提取物品。它基本上就是抽屉的入口点。"]
	quest.668C313FF46B6005.quest_desc: ["为背包添加一个熔炉 GUI。"]
	quest.67704F7341EDCC49.title: "&b钻石背包"
	quest.696E063016CAD1B9.quest_desc: ["为背包添加带刻痕工作台的合成 GUI。"]
	quest.6A2B2C5E2ADCE366.quest_desc: ["Sophisticated Backpacks 提供了可升级的背包，它们可以使用过滤器来增添实用功能！\n\n背包可以放入你的 Curios 背包槽中，并且可以被染色。"]
	quest.6A2B2C5E2ADCE366.quest_subtitle: "物品栏太小了"
	quest.6A2B2C5E2ADCE366.title: "Sophisticated Backpacks"
	quest.6E3D53D1C4569A89.quest_desc: ["允许你在你和背包之间传输经验值。"]
	quest.6E3D53D1C4569A89.quest_subtitle: "存储经验值"
	quest.6E3D53D1C4569A89.title: "&a经验值传输升级"
	quest.6E9041744C592573.quest_desc: ["添加从储罐升级中传输液体的功能。"]
	quest.6F6A23579CAE8013.quest_desc: [
		"接下来，制作一些物品接口和逻辑线缆吧。"
		""
		"将接口放置在你想连接的箱子上，再用逻辑线缆将它们全部连接起来。"
		""
		"然后你只需放上一个存储终端，瞧！你就能访问整个存储系统了。"
	]
	quest.6F6A23579CAE8013.title: "连接你的存储系统"
	quest.6FBAE89EE782DABA.quest_desc: ["当使用 &a链接工具&r 放置并连接到其他抽屉后，控制器就会充当一个“枢纽”。\n\n如果你右键双击它，所有在抽屉网络中有插槽的物品栏中的物品都会被拉取过来。\n\n手持空手右键点击控制器（同时潜行），可以打开升级选项卡，为这些插槽添加普通存储升级，从而扩大控制器的范围。最大范围为所有方向各 40 个方块，即一个 80x80x80 的立方体。"]
	quest.6FBAE89EE782DABA.quest_subtitle: "抽屉的大脑"
	quest.70902EF96F060672.quest_desc: ["此升级会使抽屉在所有方向上输出红石信号，信号强度表示其填充/空置程度。\n\n对于多插槽抽屉，可以配置此升级以监控特定的插槽。\n\n0 - 表示为空。\n15 - 表示已满。"]
	quest.7649D648A3688D4A.quest_desc: ["拉取升级能让抽屉从任意一侧拉取物品。"]
	quest.77F241BEE9902751.quest_desc: ["Sophisticated Storage 模组中最大的箱子"]
	quest.77F241BEE9902751.quest_subtitle: "空间巨大，可供你尽情发挥！"
	quest.77F241BEE9902751.title: "&d下界合金箱"
	quest.785951190FFDAA21.quest_desc: ["背包的堆叠数量增加 4。"]
	quest.785951190FFDAA21.title: "&e堆叠升级 2 级"
	quest.78E51D22C16C4686.quest_desc: ["存储控制器也能通过无线方式连接其他存储设备。只需使用存储工具，右键单击存储控制器进行绑定，再右键单击其他存储设备即可将它们连接。\n\n无线连接的范围与普通连接相同，均为 14 格空间。"]
	quest.7AE3C8134F5ED726.quest_desc: ["背包的堆叠数量增加 16。"]
	quest.7AE3C8134F5ED726.title: "&d堆叠升级 4 级"
