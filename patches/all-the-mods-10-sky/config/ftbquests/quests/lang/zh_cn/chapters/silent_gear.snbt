	quest.3D2C6FF462B17205.quest_desc: ["伤害低，攻击速度极快。减少目标的无敌时间。"]
	quest.3D2C6FF462B17205.quest_subtitle: "猛刺"
	quest.3F39BEB788175CEF.quest_subtitle: "3x3 挖掘！"
	quest.405DCD3E36232EEA.quest_desc: ["伤害低于剑，但攻击距离更长。"]
	quest.405DCD3E36232EEA.quest_subtitle: "释放你内心的斯巴达之魂"
	quest.427516AA3E8C9442.quest_subtitle: "多功能锄头"
	quest.45899579D9B92D91.quest_desc: ["&a控制器&r是&c&l铸造厂&r的核心。\n\n每个&c&l铸造厂&r在制造时至少需要 1 个。\n\n我们可以使用&c&l铸造厂&r来查看&c&l铸造厂&r的 GUI。在这里，我们可以看到&c&l铸造厂&r内的液体数量。\n\n我们还可以用它来向&c&l铸造厂&r中放入和取出物品。"]
	quest.45899579D9B92D91.title: "&c&l铸造厂&r&a控制器"
	quest.462C1F75A2FB9F02.quest_subtitle: "威利去哪儿了？"
	quest.48D358470A019E7A.title: "1 级星辉充能器催化剂"
	quest.52CDB46F6CBF007B.quest_subtitle: "你这是在挖这个吗？"
