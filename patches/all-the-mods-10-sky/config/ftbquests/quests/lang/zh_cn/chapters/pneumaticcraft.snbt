	quest.4C0D00B5305117A1.quest_subtitle: "砰砰（没有你）"
	quest.4CA17B0A80020B2F.quest_desc: ["&3压力表&r用于显示有关机器的额外信息。"]
	quest.4CA17B0A80020B2F.quest_subtitle: "我需要更多信息！"
	quest.4E1E31EDD544EE10.quest_subtitle: "64,000mb"
	quest.4F5348D0C83C3B0D.quest_desc: ["&3太阳能电池&r用于制造太阳能压缩机。"]
	quest.4F5348D0C83C3B0D.quest_subtitle: "太阳的电池"
	quest.4F5348D0C83C3B0D.title: "太阳能电池"
	quest.4FCC20D9F8F87B2F.quest_desc: ["&3气动扳手&r用于移动或拆除你的机器和管道。"]
	quest.4FCC20D9F8F87B2F.quest_subtitle: "关于工具的扭矩！"
	quest.5103C817381181DE.quest_desc: ["让你可以在穿着气动胸甲的同时使用鞘翅。"]
	quest.5103C817381181DE.quest_subtitle: "最大：1"
	quest.520EFA7F446AFBF2.quest_desc: ["&3润滑剂&r可用于制造钻头。"]
	quest.520EFA7F446AFBF2.quest_subtitle: "生产润滑剂！"
	quest.520EFA7F446AFBF2.title: "润滑剂"
	quest.521656D425E2FDBA.quest_desc: ["速度比 II 级还要快。"]
	quest.521656D425E2FDBA.quest_subtitle: "最大：1"
	quest.52D3697F1F5625C7.quest_desc: ["&3蚀刻酸&r是在压力室中用熔融塑料……和一些其他东西制成的。用于蚀刻槽。"]
	quest.52D3697F1F5625C7.quest_subtitle: "别问……"
	quest.5303509A1C2B1CCD.quest_desc: ["&3气动破碎锤&r利用压力进行挖掘，它可以升级到非常厉害的程度！"]
	quest.5303509A1C2B1CCD.quest_subtitle: "抱歉，杰克！"
	quest.53518D4ED99A242F.quest_desc: ["&3伪装涂抹器&r可用于将 PneumaticCraft 机器隐藏在其他方块内部。"]
	quest.53518D4ED99A242F.quest_subtitle: "想让你的装置看起来很酷吗？"
	quest.54169B69725C49DF.quest_desc: ["将你的液态塑料放置在地面上，或将其储存在带有加热框架的箱子里，这样你就得到了 &3塑料片&r！"]
	quest.54169B69725C49DF.quest_subtitle: "终于！"
	quest.54169B69725C49DF.title: "&f塑料"
	quest.5A0860631323B5E3.quest_desc: ["由 &3小麦粉&r 制成。可用于制作三文鱼天妇罗和酸面包。"]
	quest.5A0860631323B5E3.quest_subtitle: "你需要揉捏它"
	quest.5A9D6672385D3D82.quest_desc: ["升级时只需使用 1 个青金石，而非 4 个。"]
	quest.5A9D6672385D3D82.quest_subtitle: "节省青金石"
	quest.5AEE86EB39FD4087.quest_desc: ["&3涡流管&r 可将压力分离为热空气和冷空气。冷空气流向蓝色一侧，热空气流向红色一侧。"]
	quest.5AEE86EB39FD4087.quest_subtitle: "仍然不是 RF……"
	quest.5AEE86EB39FD4087.title: "热量生产"
	quest.5B9F933ECD6B24FD.quest_desc: ["让你跳跃得比 Tier II 更高。"]
	quest.5B9F933ECD6B24FD.quest_subtitle: "最大值：1"
	quest.5C7D9BCDF19B86BD.quest_desc: ["防止物品爆炸。"]
	quest.5C7D9BCDF19B86BD.quest_subtitle: "安全！"
	quest.5D64250B940BC8FD.quest_desc: ["压缩铁可用于制作 &3压缩铁盔甲&r，它与铁盔甲相同，但具有更强的盔甲硬度和击退抗性。\n\n该盔甲可以制作，也可以常见于战利品箱中。"]
	quest.5D64250B940BC8FD.quest_subtitle: "出色的击退抗性"
	quest.5D64250B940BC8FD.title: "压缩铁盔甲"
	quest.5D71ED16FD4E725A.quest_desc: ["使猪灵保持被动（与穿戴金盔甲相同），你只需将升级安装在任意一件盔甲上即可。"]
	quest.5D71ED16FD4E725A.quest_subtitle: "最大值：1"
	quest.5D7B34761E8FD212.quest_desc: [
		"&3静电压缩机&r 可通过闪电产生大量压力。\n\n更多信息请查看 JEI 中的“信息”选项卡。\n"
		"{image:pneumaticcraft:textures/patchouli/electrostatic_compressor.png width:100 height:100 align:left fit:true}"
	]
	quest.5D7B34761E8FD212.title: "闪电压力"
	quest.5E71F8A046C60346.quest_desc: ["是谁告诉你 PneumaticCraft 不发电的？\n\n&3气动发电机&r能让你将压力转化为 FE。阅读工具提示或在 PNC:R 中了解其工作原理。"]
	quest.5E71F8A046C60346.quest_subtitle: "压力 = 能量"
	quest.5E71F8A046C60346.title: "发电"
	quest.602C3E88D96F8843.quest_desc: ["将一块已带电的空白 PCB 放入蚀刻槽中，加入一些蚀刻酸并加热，你就能得到 &3未组装的 PCB&r。"]
	quest.602C3E88D96F8843.quest_subtitle: "快完成了！"
	quest.61AD2207E770CD7F.quest_desc: ["让你能从更远的地方拾取物品和经验。"]
	quest.61AD2207E770CD7F.quest_subtitle: "上限：6"
	quest.61B479079DC1C69C.quest_desc: ["让你能比 I 级跳得更高。"]
	quest.61B479079DC1C69C.quest_subtitle: "上限：1"
	quest.61BA2932EC86DA2E.quest_desc: ["让你能跳得非常高。"]
	quest.61BA2932EC86DA2E.quest_subtitle: "上限：1"
	quest.63F6F4EBCEB914B0.quest_desc: ["&3压力舱&r是一种重要的多方块结构，由&3压力舱墙壁&r构成（其面可以用&3压力舱玻璃&r替换）。压力舱最小可以是 3x3x3 的多方块，最大可以是 5x5x5 的多方块。完成此任务需要的是 5x5x5 规格所需的方块。\n\n要使用压力舱，你需要用之前制作的&3压力管&r将压力导入&3压力舱阀门&r，记得在压力阀门中放入一个安全升级。&l不同的配方需要不同量的压力&r。\n\n你需要能够将物品输入和输出到压力舱中，这就需要用到&3压力舱接口&r。蓝色朝外表示用于输入物品，而金色朝外则表示用于输出物品，请在任意面上各放置一个。"]
	quest.63F6F4EBCEB914B0.quest_subtitle: "加压！"
	quest.63F6F4EBCEB914B0.title: "压力舱"
	quest.649167FC31EB916E.quest_desc: ["&3植物油&r可以通过将作物或种子放入&3热压处理机&r中来制作。"]
	quest.649167FC31EB916E.quest_subtitle: "更好的油"
	quest.649167FC31EB916E.title: "植物油"
	quest.64D34A6C3487C5DF.quest_desc: ["&3空中接口&r可用于为你的可加压物品补充压力。现在你可以使用你的气动护甲而无需重新充能了！"]
	quest.64D34A6C3487C5DF.quest_subtitle: "无线压力！"
	quest.64E2E05B228EA53E.quest_desc: ["&3高级压力管&r是市面上最好的压力管，能够承受 20 个大气压的压力！\n\n虽然它们本身就很酷，但还能用于一些更酷的配方中。"]
	quest.64E2E05B228EA53E.quest_subtitle: "全新的境界！"
	quest.657DB994B029F61C.quest_desc: [
		"当&3加热框架&r放置在装有特定液体的容器上并被充分冷却时，会将这些液体转化为物品。"
		""
		"将熔融塑料转化为塑料。"
		"将水转化为冰。"
		"将岩浆转化为黑曜石。"
	]
	quest.65E2AF881709C896.quest_desc: ["你最需要的材料之一是&3强化石&r，先用压缩铁和一些普通石头制作 32 块。"]
	quest.65E2AF881709C896.quest_subtitle: "你需要大量的这个。"
	quest.65E2AF881709C896.title: "强化石"
	quest.6674270897997BF7.quest_desc: ["让你能跳得比平时更高，并赋予你弹性，从而实现更快的移动。\n\n护腿一次只能装备一个等级的这种升级。"]
	quest.6674270897997BF7.quest_subtitle: "上限：1"
	quest.681A3F31FB242555.quest_desc: ["&3乙醇&r可用于制造生物柴油。"]
	quest.681A3F31FB242555.title: "乙醇"
	quest.68F92455A9483AD6.quest_desc: ["只有使用过喷气靴后，你才会看到这个任务。\n\n使用喷气靴时不可能不受到伤害，千万别试……"]
	quest.68F92455A9483AD6.quest_subtitle: "你以为使用鞘翅很难吗？"
	quest.68F92455A9483AD6.title: "喷气靴"
	quest.6B1C06C753C10E44.quest_desc: ["&3物流配置器&r可用于配置物流框架和传输小工具。"]
	quest.6CA01DCE1F4A0EC3.quest_desc: ["下一阶段的模组需要收集 &3原油&r。这种原油可以在主世界的地表自然找到。"]
	quest.6CA01DCE1F4A0EC3.quest_subtitle: "通往塑料之路"
	quest.6CA01DCE1F4A0EC3.title: "原油"
	quest.6D124ACF4AE80490.quest_desc: ["有了微型导弹，你就能从远处发动爆炸！现在谁也别想逃掉！"]
	quest.6D124ACF4AE80490.quest_subtitle: "从远处发射爆炸！"
	quest.6EB53CDCB80D4B66.quest_desc: [
		"&3气动门&r是一种自动门，可以设置成只为你开启！"
		""
		"{image:pneumaticcraft:textures/patchouli/pneumatic_door.png width:200 height:200 align:right fit:true}"
	]
	quest.6FD65139CD50A8C0.quest_desc: ["这真的可行吗？\n\n如果你想自动化这个过程，可以使用 &eProductive Bees&r 或 &aMystical Agriculture&r。或者我猜你也可以用……爆炸来自动化它。"]
	quest.6FD65139CD50A8C0.quest_subtitle: "厌倦了炸东西？"
	quest.7040CA41C0A3C2F2.quest_desc: [
		"&3PCB 蓝图&r 现正促销，售价 8 颗绿宝石。（仅限限时）。"
