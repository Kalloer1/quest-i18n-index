	quest.715B86DC82EA636B.quest_desc: [
		"&3液体压缩机&r 利用特定液体来产生压力。你可以通过右键将桶点击到机器上来注入燃料，通过向其中泵入流体，或者将桶放入 GUI 顶部的插槽中。"
		""
		"{image:pneumaticcraft:textures/gui/gui_liquid_compressor.png width:200 height:200 align:center fit:true}"
	]
	quest.715B86DC82EA636B.title: "来自液体的压力"
	quest.7177E49BF9ECA5CF.quest_desc: [
		"&3热压缩机&r利用热量产生压力！在一侧放置热源，另一侧放置冷源即可产生压力。"
		""
		"{image:pneumaticcraft:textures/patchouli/thermal_compressor.png width:100 height:100 align:left fit:true}"
	]
	quest.7177E49BF9ECA5CF.title: "热量增压"
	quest.718DABA6C9E5982A.quest_desc: ["佩戴后可赋予玩家夜视效果。"]
	quest.718DABA6C9E5982A.quest_subtitle: "上限：1"
	quest.72C09FD89C28B1EC.quest_desc: [
		"我们将制作的&3炼油厂&r是一个 1x1x5 的多方块结构，由 1 个&3炼油控制器&r（位于底部）和 4 个&3炼油出口&r（位于顶部）组成。你需要为其输入原油并提供热量才能使其运作。它会产出柴油、煤油、汽油和液化石油气。在侧面安装&3隔热层&r有助于保温。"
		""
		"{image:atm:textures/questpics/pneumaticcraft/oil_refinery.png width:300 height:150 align:center}"
	]
	quest.72C09FD89C28B1EC.quest_subtitle: "这下总算有进展了"
	quest.72C09FD89C28B1EC.title: "炼油厂"
	quest.7386A8433698946C.quest_desc: [
		"选择一个物品，此升级将在附近的箱子或地面上搜寻该物品。若要在箱子中搜寻，则需要方块追踪升级；若要在地面上搜寻，则需要实体追踪升级。\n"
		"{image:atm:textures/questpics/pneumaticcraft/item_search_upgrade.png width:200 height:200 align:center}"
	]
	quest.7386A8433698946C.quest_subtitle: "上限：1"
	quest.7395B41685F4BC1A.quest_desc: ["&3通量压缩机&r可以利用能量产生大量压力。只需注入一些FE，它就会开始产生压力。如果你有充足的FE剩余，这大概是产生压力的最简单方法。"]
	quest.7395B41685F4BC1A.quest_subtitle: "能量 = 压力"
	quest.7395B41685F4BC1A.title: "通过能量产生压力"
	quest.74015945716FD10A.quest_desc: ["&3全向漏斗&r可以从任意一侧输入物品，而且还能升级，速度远超普通漏斗！在不需要管道时非常实用。"]
	quest.74015945716FD10A.quest_subtitle: "可配置的漏斗"
	quest.74AE214747A3DB1A.quest_desc: ["增加物品能够容纳的压力值。"]
	quest.74AE214747A3DB1A.quest_subtitle: "把它调高！"
	quest.75D3F3C1D4A3EAA2.quest_desc: ["要转移涡流管产生的热量，请制作一些&3热管&r。"]
	quest.75D3F3C1D4A3EAA2.quest_subtitle: "我们有热量可以转移 :)"
	quest.75D3F3C1D4A3EAA2.title: "转移热量"
