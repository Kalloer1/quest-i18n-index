	quest.0AEAEA976ED0C470.quest_desc: ["&3充电站&r用于在 &aPneumaticCraft&r 中利用压力为各种工具和电子设备充电。"]
	quest.0AEAEA976ED0C470.quest_subtitle: "电线在哪儿？"
	quest.0CC48C2AA553A314.quest_desc: ["&3钻头&r可用于气动冲击钻。"]
	quest.0D2F5CC96269F9E3.quest_desc: ["制作 PCB 的下一步是使用带蚀刻酸的 &3蚀刻槽&r。运行时需要加热。"]
