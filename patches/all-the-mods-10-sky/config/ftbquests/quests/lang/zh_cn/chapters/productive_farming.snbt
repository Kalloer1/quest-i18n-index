	quest.439705A42B6DC4D1.quest_desc: ["{image:atm:textures/questpics/pro_farming/farm_cattail.png width:100 height:150 align:center}"]
	quest.439705A42B6DC4D1.quest_subtitle: "棕色"
	quest.439705A42B6DC4D1.title: "&8香蒲"
	quest.44DA8B6C651B3456.quest_desc: ["混合食用枸杞和黄金覆盆子可以得到奇迹果。\n\n奇迹果有一种神奇的效果，可以改变你的味蕾，让它们尝不出酸味。因此，所有本应是酸味的东西，尝起来都只有甜味！\n\n快去试试吧！"]
	quest.46932B57EF21D346.quest_desc: ["&9饮水槽&r是另一种可以帮助动物的方块。\n\n不过，它需要的不是&c动物饲料&r，而是&9水桶&r！\n\n当幼崽动物在&9饮水槽&r附近时，它们会比不在附近的幼崽长得更快。\n\n不过别忘了，要持续往里面加&9水&r哦！"]
	quest.46932B57EF21D346.title: "&9饮水槽"
	quest.48323FABB7E3D31E.quest_desc: ["将罗马番茄与它的二次进化形态——牛排番茄相结合，我们就能得到蓝美番茄。\n\n不过，它也有几率变成另外两种番茄。"]
	quest.4B2754CD11FFE247.quest_desc: ["{image:atm:textures/questpics/pro_farming/farm_amaryllis.png width:100 height:150 align:center}"]
	quest.4B2754CD11FFE247.quest_subtitle: "暗红色"
	quest.4B2754CD11FFE247.title: "&4朱顶红"
	quest.507821D8F9C064CF.quest_desc: ["将绿色和红色葡萄混合，可以得到康科德葡萄。\n\n它也被称为紫色葡萄！"]
	quest.512A525B513DA118.quest_desc: ["{image:atm:textures/questpics/pro_farming/farm_chrysanthemum.png width:100 height:150 align:center}"]
