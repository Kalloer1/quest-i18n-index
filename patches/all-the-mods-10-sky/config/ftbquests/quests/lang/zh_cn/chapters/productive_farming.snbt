# AI 初翻，未人工校对
{
	quest.01B7B66FAAAAEAE5.quest_desc: ["{image:atm:textures/questpics/pro_farming/farm_anemone.png width:100 height:150 align:center}"]
	quest.01B7B66FAAAAEAE5.quest_subtitle: "白色"
	quest.06B197EB778C17AC.quest_desc: ["与 &6杂交&r&d花卉&r类似，我们也可以对 &2作物&r这样做！\n\n当 &6蜜蜂在&r有特定 &2作物&r的区域进行 &6授粉&r时，有些可能会发生 &l变异&r。\n\n查看 &2JEI&r 以了解你需要培育哪些 <c17>作物<c18>。"]
	quest.06B197EB778C17AC.title: "&6变异"
	quest.095024BF19ABA326.quest_desc: ["橙色甜椒和绿色甜椒的组合。"]
	quest.0D04BCF5940E2AF1.quest_desc: ["将蓝玉玉米和黑阿兹特克玉米组合，可以得到糖珠玉米。"]
	quest.126CCC6B187C0B18.quest_desc: ["最后，将黑阿兹特克玉米和糖珠玉米混合，可以得到彩虹玉米。"]
	quest.15474BAF1997CD27.quest_desc: ["{image:atm:textures/questpics/pro_farming/farm_balloon.png width:100 height:150 align:center}"]
	quest.15474BAF1997CD27.quest_subtitle: "紫色"
	quest.15474BAF1997CD27.title: "&5气球花"
	quest.158978D35BDA805D.quest_desc: ["这些是覆盆子……和阳光番茄的混合体？\n\n但一个是浆果，一个是番茄？这完全说不通！"]
	quest.167554E0A562B60A.quest_desc: ["红色和黄色甜椒的混合物！\n\n这应该很明显……它就是橙色的……"]
	quest.1699BD1B8B348B7C.quest_desc: ["蓝玉玉米和黄粒玉米的组合可以得到黑阿兹特克玉米。"]
	quest.2117CE8C21A9EE98.quest_desc: ["红色和黑色甜椒的组合。"]
	quest.223F47BDD763F306.quest_desc: ["樱桃番茄有几率随机突变为巧克力梨番茄。\n\n我不知道巧克力或梨是从哪儿来的，不过好吧！"]
	quest.244B10862943A802.quest_subtitle: "疯狂世界"
	quest.2AFB12E742596864.quest_desc: ["&a农场控制器&r是&a&l自动农场&r的核心，这是一款适用于所有农场的多方块机器！\n\n我将在下一个任务中讲解如何建造它，这里我只讲解如何使用它。\n\n这个&a&l自动农场&r会种植、收获并重新种植结构内的所有&2作物&r。无论是&a&l高效农业&r、&2&l神秘农业&r还是&2&l原版&r&2作物&r，统统都能种植！\n\n它会将所有掉落物收集到控制器中，这些掉落物可以手动取出，也可以通过管道取出。"]
	quest.2AFB12E742596864.title: "&a&l自动农场"
	quest.2BFC97460B4B49F1.quest_desc: ["巧克力番茄和黄梨番茄混合后，会得到阳光金番茄。"]
	quest.2CFD0DF119CC5E85.quest_desc: [
		"现在我们来到“建造”部分。首先是“所选方块”。\n\n你可能会看到一个超长的方块列表，你可以使用这些方块来完成此任务，它们都可以用来构成&a&l结构&r。\n\n（基本上就是任何砖块和玻璃）。你也可以随意组合搭配这些方块，对方块种类没有要求！\n\n实际的&a&l结构&r仅指墙壁和内部空间。墙壁必须用这些方块建造，而内部空间的方块体积则需要低于某个特定数值。\n\n你能建造的最小尺寸是 2x2 的&a&l自动农场&r。而最大尺寸则取决于你能容纳多少 200 个方块的内部体积。我之所以说“体积”，是因为计算时会将区域高度计为 2 个方块，以包含作物本身。这意味着，如果你的内部区域是 10x10 的大小，那它就是最大尺寸了。\n\n内部空间是用来放置你的&2农田&r、&9水&r或任何用于种植东西的地方。&2农田&r仍然需要&9水&r来保持湿润（我推荐使用 XyCraft 的&9水方块&r）。\n\n你仍然可以在&2作物 &f附近或&2农田&r上使用肥料或生长加速器来加快它们的生长速度！"
		"{image:atm:textures/questpics/pro_farming/farm_autofarm.png width:150 height:100 align:center}"
	]
	quest.2CFD0DF119CC5E85.title: "建造它"
