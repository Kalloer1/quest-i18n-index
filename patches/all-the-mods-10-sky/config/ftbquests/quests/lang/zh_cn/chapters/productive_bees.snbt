	quest.4DDF647FE6494DE1.quest_desc: ["本模组所能提供的最佳生产力升级。自带模拟和方块升级功能。"]
	quest.4ED01E04D55999D9.quest_subtitle: "将熔融 Uru 浇在 Unobtainium 蜜蜂生成蛋上"
