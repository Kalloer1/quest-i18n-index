	quest.4FE7F45C72EF5DC1.quest_subtitle: "铁 + 汗"
	quest.4FE7F45C72EF5DC1.title: "Nickel 蜜蜂"
	quest.500BEAD94C97DF96.quest_desc: ["可以放置在蜂巢或离心机中。\n\n放置在蜂巢中时，蜜蜂在蜂巢中花费的时间减少 20%。\n\n放置在离心机中时，会提高处理速度。\n\n这些效果可以叠加。"]
	quest.500BEAD94C97DF96.quest_subtitle: "声波蜜蜂"
