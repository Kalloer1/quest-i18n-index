	quest.40E4F1172A164DD1.title: "糖囊蜂"
	quest.419DD6FE84B91749.quest_desc: ["收集基因时，你会获得一定百分比的性状。你可以在合成台中将它们组合起来进行叠加，也可以将它们放入基因索引器中自动组合。无需红石信号。"]
	quest.419DD6FE84B91749.quest_subtitle: "基因组合器与箱子"
