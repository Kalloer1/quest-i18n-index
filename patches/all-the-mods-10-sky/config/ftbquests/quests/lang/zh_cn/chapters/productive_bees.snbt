	quest.6E4C3B87FABE9EFA.title: "青铜蜜蜂"
	quest.6E819CCD57B15D54.quest_desc: ["使用熔炼炉，将 &#4CE688熔融振金&r 浇在 &#F2EB2E全泰姆金属蜜蜂生成蛋&r 上。"]
	quest.6E819CCD57B15D54.quest_subtitle: "将熔融振金浇在全泰姆金属蜜蜂生成蛋上"
