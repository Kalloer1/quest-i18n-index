	quest_links: [ ]
	quests: [
		{
			description: [
				"你跋涉千里，与众多村民相遇，用成千上万的绿宝石换取了在这片陌生世界中生存和发展的所需物资。你的基地固若金汤，后勤井然有序，足以让你的子民衣食无忧，熔炉熊熊燃烧。"
				""
				"剩下的就是去征服未驯服的领地，证明你统治它们的权利！整装待发，召集旗帜，聚集最坚韧的伙伴，迎接挑战吧！"
			]
			icon: {
				Count: 1
				id: "born_in_chaos_v1:skullbreaker_hammer"
				tag: {
					Damage: 0
				}
			}
			id: "03E28F1CA713BA8E"
			rewards: [{
				id: "75A53A199C0D6453"
				type: "xp"
				xp: 100
			}]
			shape: "pentagon"
			size: 1.5d
			subtitle: "从这里出发，你一定能到达那里！"
			tasks: [{
				id: "3DF5AFBA14E834C6"
				title: "建立可信度"
				type: "checkmark"
			}]
			title: "是时候开始你的冒险了！"
			x: -9.0d
			y: -19.0d
		}
		{
			dependencies: ["03E28F1CA713BA8E"]
			description: [
				"欢迎来到下界——一个充满躁动灵魂的世界，灼热的气息缠绕着每一口呼吸，硫磺的气味弥漫在空气中，悲伤的回响在绯红的天空中飘荡。"
				""
				"弥漫此地的腐臭与堕落，让你想起与夜巫和暮光巫师的战斗。这片灼热的炼狱中，有某种邪恶而强大的存在，与你在主世界和暮光领域感受到的不死生物如出一辙。找到它，或许你就能对复活的死者及其在诸界中的庞大存在有所领悟。"
				""
				"&6所需成就：&f"
				"在&a暮色森林&f中击败&2Naga&f才能进入&cThe Nether&f！ 遵循标准传送门建造规则！"
			]
			icon: "minecraft:crying_obsidian"
			id: "1E71B57AD2BD8F84"
			rewards: [{
				exclude_from_claim_all: true
				id: "12FE1BF3C5C6AF7E"
				table_id: 5393747632124787178L
				type: "loot"
			}]
			subtitle: "地板的大部分区域实际上是岩浆。"
			tasks: [{
				dimension: "minecraft:the_nether"
				id: "54EC71016D464C6B"
				type: "dimension"
			}]
			title: "下界"
			x: -5.857142857142861d
			y: -18.98214285714286d
		}
		{
			dependencies: ["03E28F1CA713BA8E"]
			description: [
				"一些爱冒险的流浪商人曾提到，有一片笼罩在暮光中的森林，充满了待探索的新区域和宝藏。根据他们的描述，要进入这片幽暗的林地，你需要用珍贵的宝石举行仪式，并掌握足以赋予装备超凡能量的魔法，以超越你见过的最神奇材料的极限。"
				""
				"&6所需成就：&f"
				"&d附魔&f你的第一件装备或工具，以便进入&a暮色森林&f"
			]
			icon: "twilightforest:twilight_portal_miniature_structure"
