	quest.313C5F9DB1E6C798.quest_subtitle: "全部捕获，第 1 部分"
	quest.315289A0F00E4BDE.quest_desc: ["背包里要有熔炉！可以用木材、煤炭或岩浆等很多东西当燃料！"]
	quest.315289A0F00E4BDE.quest_subtitle: "把它熔炼了！"
	quest.315289A0F00E4BDE.title: "制作一个熔炉"
	quest.3163768E54FA4D87.quest_subtitle: "你知道风车是什么吧？这个利用风力旋转来生成可供使用的SU。"
	quest.3163768E54FA4D87.title: "可不要被风吹走哦"
	quest.31931F0456B30D23.quest_subtitle: "桌布可以用来向其他玩家出售物品。"
	quest.31D27BC289311172.quest_subtitle: "Schematicannon 是一种特殊机器，用于使用蓝图来建造结构。"
	quest.31DBA34D02105015.quest_desc: ["用望远镜观察一只鹦鹉"]
	quest.322B3211C261CDB5.quest_subtitle: "书桌铃在右键点击时会发出声音并发出红石信号。"
	quest.3248EDEB8FA1CF34.quest_desc: ["收集所有 7 个彩虹巨型手镯"]
	quest.32A07AD571088CB6.quest_desc: ["背包里要有南瓜、南瓜片和南瓜籽。"]
	quest.32A07AD571088CB6.title: "获取一个水泵 In"
	quest.3318BE37A535EA55.quest_desc: [
		"手持工具，使用砧板来分解物品。"
		""
		"使用兼容的工具分解放置在砧板上的物品。"
		""
		"例如，将稻苗放在砧板上，然后用刀点击它来获取稻米。"
	]
	quest.33405529382A166A.quest_desc: ["制作一个宝可梦零食。一种可以根据所用浆果吸引特定宝可梦的蛋糕。"]
	quest.33405529382A166A.quest_subtitle: "给孩子们准备的饼干"
	quest.3395388771D6B0A9.quest_subtitle: "大多数机器都有内置过滤器，用于决定如何处理输入。列表过滤器用于同时调整多种物品的处理方式。"
	quest.33A3C5E023420CDD.quest_desc: [
		"同时给玩家施加这34种状态效果："
		"吸收、不祥之兆、失明、鹦鹉螺之息、导管之力、黑暗、海豚之礼、火焰抗性、发光、速度、英雄、饥饿、感染、隐身、跳跃提升、漂浮、挖掘疲劳、恶心、夜视、渗出毒液、袭击、预感、再生、抗性、缓慢下落、迟缓、速度、力量、试炼、预感、水下呼吸、虚弱、编织、风力、蓄力凋零"
		"本进阶中，效果的来源并不重要。其他状态效果可能作用于玩家，但在此进阶中被忽略。"
	]
	quest.33A3C5E023420CDD.quest_subtitle: "我到底有多坏呢？（how bad could i be?）"
	quest.340C3BA86FD70A50.quest_desc: ["完成一个试炼，然后用钥匙打开宝库"]
	quest.340C3BA86FD70A50.quest_subtitle: "一个秘密（或是战利品！）的密室"
	quest.342FF6E8C2823E20.quest_desc: ["背包里有一颗钻石"]
	quest.342FF6E8C2823E20.quest_subtitle: "你需要很多这些东西才能完成"
	quest.345EEBD0D6C065D6.quest_subtitle: "鸡蛋生成器"
	quest.34DAAF880FC0F5BB.title: "油炸甜甜圈卷（Deepfry Churros）"
	quest.363B45F77F95D88F.quest_desc: ["背包里有一个岩浆桶。"]
	quest.363B45F77F95D88F.quest_subtitle: "用岩浆装满一个桶"
	quest.367D1A20BE7A93B6.quest_subtitle: "包装器用于创建纸板包裹。"
