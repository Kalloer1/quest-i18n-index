	quest.38CD2CF7A58BA37D.quest_desc: [
		"同时给玩家施加这17种状态效果："
		"火焰抗性 感染 隐身 跳跃提升 夜视 渗出毒液 再生 抗性 缓慢下落 迟缓 速度 力量 水下呼吸 虚弱 编织 风 蓄力。"
		"本进阶中，效果的来源并不重要。其他状态效果可能作用于玩家，但在此进阶中被忽略。"
	]
	quest.38CD2CF7A58BA37D.quest_subtitle: "你不应该混合你的药水……或者应该吗？"
	quest.38FBA65BD957ABC5.quest_desc: ["FTBQuests 不喜欢可选任务！尽管如此，我还是想加入一些可选任务，让人们能领取章节完成奖励。于是，可选类别就诞生了。"]
	quest.390CA48CD622B19F.title: "油炸一份小吃"
	quest.39AB8F6F5CD91DA7.quest_desc: [
		"驯服以下9种可驯服动物中的一种："
		"猫、驴、马、羊驼、骡子、鹦鹉、贸易羊驼、狼、僵尸马"
	]
	quest.39AB8F6F5CD91DA7.quest_subtitle: "让他们爱上你，这样他们就会帮助你完成所有任务了"
	quest.39CF18F0C2B06818.quest_subtitle: "一种能让你储存大量能量的多区块结构。"
	quest.39E865F0D72CF9B8.quest_subtitle: "转轴是另一种基础但重要的机械部件，用于使物体旋转运动。你还可以延长转轴，使其影响多个需要旋转的装置。"
	quest.39E865F0D72CF9B8.title: "持续旋转之杖"
	quest.3A310D0E5728B9A2.quest_subtitle: "可以通过额外的锻造模板获得超越下界合金的武器。这些武器制作极其困难，但能赋予武器独特的被动能力。"
	quest.3A46681B802F3DB5.quest_desc: ["同时拥有珍珠色、赭色和翠绿色的青蛙灯。"]
	quest.3A46681B802F3DB5.quest_subtitle: "パワーパフガールズ"
	quest.3A49A9967C71A129.quest_desc: ["用树皮来制作纸张吧！"]
	quest.3A49A9967C71A129.quest_subtitle: "一种更可持续的来源！"
	quest.3A861B21F4724A9A.quest_subtitle: "在柴油发动机上使用可使其加速。创建柴油发电机"
	quest.3A95793467582862.quest_subtitle: "肌肉驱动的直升机。用力一推，它就能飞起来！"
	quest.3AD43837FB3C1CAC.quest_desc: ["收集所有巨型配件"]
	quest.3B10D31EFD80798C.quest_subtitle: "让你可以创建自己专属的定制功能性时钟。"
