	quest.798CADF6B8930572.quest_subtitle: "一台能自动合成配方和调配药水等物品的机器。\\n\\n需要至少30转/分钟的转速才能工作"
	quest.79EE6544D611B487.quest_desc: ["获得一个下界合金锭"]
	quest.79EE6544D611B487.quest_subtitle: "地狱，不管你知不知道就是了"
	quest.7B1AB9035BF00BA8.quest_desc: ["制作一杯药用饮品"]
	quest.7B1AB9035BF00BA8.quest_subtitle: "药剂师日记 第2部分"
	quest.7B3913CCEBC7717D.quest_subtitle: "检测到火车时会发出红石信号。"
	quest.7B3E5DC40424FA3E.quest_desc: ["背包里有一个石质镐子"]
	quest.7B3E5DC40424FA3E.quest_subtitle: "制作一把更好的镐子"
	quest.7B4FA7F70BB393A6.quest_subtitle: "机械滚轮可用于清理和铺平机械装置上的路径。"
	quest.7B66512221C1D667.quest_desc: ["[ \"完成所有位于 \", { \"text\": \"末地\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"78A86CC39551B8E6\" } }, \" 的 quest。\" ]"]
	quest.7B66512221C1D667.quest_subtitle: "完成章节：「The End」"
	quest.7B66512221C1D667.title: "The End"
	quest.7B90A1A66B750F76.quest_subtitle: "给你的烈焰燃烧器一个附魔指南，把它变成烈焰附魔台"
	quest.7B90A1A66B750F76.title: "烈焰人的新工作"
	quest.7B9D2F7F33818837.quest_subtitle: "本质上是对磨石机的升级，提供了一些不同的配方，所以两种都留着可能比较值得。"
	quest.7BE3AAA9531B650B.quest_subtitle: "Crushing Wheels 是 Millstone 的进阶版。它对从旋转方向的反向插入的任何物品应用 Crushing 配方。"
	quest.7C015A2CA4645E7A.quest_subtitle: "可调式链轮变速箱的功能与封闭式链传动相似，但用红石供电时可以改变输出的速度。"
	quest.7C0C87AECC742AC0.quest_subtitle: "基本上，电力就等于速度"
	quest.7C5CDB413D2EBD0C.quest_subtitle: "Copycat 方块能让你用通常无法制成台阶和面板的材料来制作它们。"
	quest.7C77FA44B80B6BB4.quest_subtitle: "此模组需要 Cookie 才能正常工作。请将它们放入罐子中"
	quest.7C77FA44B80B6BB4.title: "接受并继续"
	quest.7CAF95DAF8B2ABEC.quest_subtitle: "穿过水流来熔炼物品。"
	quest.7CD315EEF62CFCC2.quest_subtitle: "合成一个石墨块 (Graphite)"
	quest.7CD315EEF62CFCC2.title: "高碳密度"
	quest.7CE1C76E647907BC.quest_subtitle: "大型水车是小型水车的放大版。"
	quest.7D0671C49C20667F.quest_subtitle: "机械钻头是一种用于破坏方块的方块。"
	quest.7D2EDEBE326CFCDE.quest_desc: [
		"背包里有肥沃的土壤。"
		""
		"将有机堆肥暴露在阳光和水下。这需要相当长的时间。"
		""
		"富饶的土壤促进作物生长，就像随机撒了骨粉一样。富饶的农田即使被跳上也不会变回普通土壤。"
	]
	quest.7D2EDEBE326CFCDE.quest_subtitle: "我很有钱……很有泥土钱"
	quest.7DD05DDD6A816DFC.quest_subtitle: "创造：Bitterballen 是一个为创造模式添加荷兰零食的模组。 (任务待完成)"
	quest.7DD05DDD6A816DFC.title: "苦味球 (Bitterballen)"
	quest.7E254258111AF5A3.quest_desc: ["潜行靠近潜声传感器8格内，或潜声守卫16格内。"]
	quest.7E254258111AF5A3.quest_subtitle: "令人毛骨悚然的恐怖守卫者"
	quest.7E33B2353751C098.quest_subtitle: "速度计测量的是旋转力的速度。"
	quest.7E542C3A13A30663.quest_desc: ["当信标意识到它被一个4号金字塔供电时，你必须位于一个以信标为中心、大小为20×20×14的长方体区域内。"]
	quest.7E542C3A13A30663.quest_subtitle: "超越极限！"
	quest.7E5E1449A58A12E6.quest_desc: ["制作一个扑克罗德（pokerod）"]
	quest.7E5E1449A58A12E6.quest_subtitle: "欢迎来到钓鱼的世界！"
	quest.7E88F523959EB707.quest_subtitle: "Powered Latch 会发出红石信号，该信号可被其他信号开启或关闭。"
	quest.7E8E6019017D76EC.quest_subtitle: "受红石激活时会粘附在方块上。"
	quest.7E8FC6A9FE02D50B.quest_subtitle: "机械轴承用于制造和旋转机械装置。"
	quest.7EA4E2D90A0FBC21.quest_subtitle: "让你能像陆地上一样在水下行走，也能在传送带上行走而不会被带走，仔细想想，一定很滑。"
	quest.7EE936A64C9A2603.quest_desc: ["制作一个全息战斗塔！此任务要求你将其放在背包中"]
	quest.7EE936A64C9A2603.quest_subtitle: "一路杀过去，战胜一切！"
	quest.7EEA80208C504DDC.quest_desc: ["背包中有一个铁锭"]
	quest.7EEA80208C504DDC.quest_subtitle: "熔炼一个铁锭"
	quest.7F4D5B0A7A3CA576.quest_subtitle: "用于控制火车在轨道和轨道交叉口上的流动。"
	quest.7F5E2D38C40E93F7.quest_subtitle: "让你可以在一定范围内无线传输红石信号。不，这可不是用来连 Wi-Fi 的。"
	quest.7F5E2D38C40E93F7.title: "Wi-Fi？没有？"
	quest.7F7128525BD7CF39.quest_desc: ["从 Y=319 至少下降到 Y=-59，垂直距离超过 379 格。不建议在坠落前跳跃，因为这通常无法获得成就。"]
	quest.7F7128525BD7CF39.quest_subtitle: "把你的身体带到边缘，看看它会不会飞起来"
