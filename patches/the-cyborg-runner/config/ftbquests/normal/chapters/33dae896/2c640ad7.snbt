		uid: "e51de1a6",
		type: "command",
		auto: "invisible",
		command: "/tellraw @p {\"text\":\"Wessex, can you hold onto this for me? I'm setting it aside for later\", \"color\":\"white\"}"
	},
	{
		uid: "a8109af6",
		type: "command",
		auto: "invisible",
		command: "/tellraw @p {\"text\":\"Well, I suppose so... what's it for?\", \"color\":\"green\"}"
	},
	{
		uid: "5f34ac56",
		type: "command",
		auto: "invisible",
		command: "/tellraw @p {\"text\":\"I'm going to take down the Defamation Foundation. Will you help me?\", \"color\":\"white\"}"
	},
	{
		uid: "cd12f27c",
		type: "xp",
		team_reward: false,
		auto: "enabled",
		xp: 100
	},
	{
		uid: "73da0ee4",
		type: "command",
		auto: "invisible",
		command: "/tellraw @p {\"text\":\"Have you gone mad?! Do you have any idea how many guards they have?!\", \"color\":\"green\"}"
	},
	{
		uid: "62eca7bd",
		type: "command",
		auto: "invisible",
		command: "/tellraw @p {\"text\":\"Not at all! But I know I can do this, I just need you to help me set up a base near one of their outposts.\", \"color\":\"white\"}"
	},
	{
		uid: "ea4fd7ed",
		type: "command",
		auto: "invisible",
		command: "/tellraw @p {\"text\":\"I.... I can try, but I don't think they would take too kindly to that.\", \"color\":\"green\"}"
	},
	{
		uid: "7fc04f96",
		type: "command",
		auto: "invisible",
		command: "/tellraw @p {\"text\":\"Can't you put it into a storage capsule or something? Build it off-site then transport it?\", \"color\":\"white\"}"
	},
	{
		uid: "456e30de",
		type: "command",
		auto: "invisible",
		command: "/tellraw @p {\"text\":\"Well yes, but.... alright, I'll do it. If you think this is the way to take down Defamont and his goons, you have my help.\", \"color\":\"green\"}"
	},
	{
		uid: "10c7f3a7",
		type: "command",
		auto: "invisible",
		command: "/tellraw @p {\"text\":\"Bring me some extra resources and I can construct a basic base with them.\", \"color\":\"green\"}"
