# AI 初翻，未人工校对
{
	title: "通信",
	x: 0.0d,
	y: 5.0d,
	text: [
		"我得想办法和某个人建立联系才行。",
		"",
		"我知道韦塞克斯博士会帮我的。我们是朋友，不是吗？",
		"",
		"希望我能先找到他，而不是那些不怀好意的人。",
		"",
		"（作者注：发音是托伊-拉-瑞）"
	],
	dependencies: [
		"bb6be075"
	],
	tasks: [{
		uid: "b653093e",
		type: "item",
		items: [{
			item: "cyberware:beacon"
		}]
	}],
	rewards: [{
		uid: "cbe76c20",
		type: "command",
		title: "消息已接收",
		icon: "minecraft:writable_book",
		auto: "no_toast",
		command: "/tellraw @p {\"text\":\"Hello? Who is this?\", \"color\":\"green\"}"
	},
	{
		uid: "12c2ff38",
		type: "command",
		auto: "invisible",
		command: "/tellraw @p {\"text\":\"Dr. Wessex, it's me! Do you remember?\", \"color\":\"white\"}"
	},
	{
		uid: "c841d1f6",
		type: "command",
		auto: "invisible",
		command: "/tellraw @p {\"text\":\"Ah, that voice modulation.... I recognize it. You'd somehow crawled all the way to my lab, limbs and organs failing. I was able to patch you up, but you soon turned to a life of crime.\", \"color\":\"green\"}"
	},
	{
		uid: "78d820aa",
		type: "command",
		auto: "invisible",
		command: "/tellraw @p {\"text\":\"Yes, that was me.... I'm sorry I did that to you.... but I need your help. I've just escape an IPC Holding Facility, but my augments are failing and my equipment isn't up for another fight.\", \"color\":\"white\"}"
	},
	{
		uid: "c507c1be",
		type: "command",
		auto: "invisible",
		command: "/tellraw @p {\"text\":\"Ah, I see.... I can't send much through this tablet, but I will help in any way I can. In return, don't get caught again - especially by the Cyborg Defamation Foundation\", \"color\":\"green\"}"
	},
	{
		uid: "db928633",
		type: "command",
		team_reward: true,
		auto: "invisible",
		command: "/tellraw @p {\"text\":\"Here are some credits to help. I know it's not much, but it should let you buy some basic supplies if you can find someone who's selling them. In the meantime, I'll try to help as much as I can, Runner.\", \"color\":\"green\"}"
	},
	{
		uid: "c9d5cd57",
		type: "item",
		auto: "invisible",
		item: "contenttweaker:chip5",
		random_bonus: 4
	},
