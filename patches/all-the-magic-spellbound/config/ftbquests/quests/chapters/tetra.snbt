				}
			]
			rewards: [{
				id: "669CB6B09D1F6998"
				type: "xp"
				xp: 50
			}]
		}
		{
			x: 0.5d
			y: -0.5d
			description: ["Tetra 工具可通过两种方式升级：磨砺和沉淀。磨砺和沉淀在使用时发生。沉淀会提升工具部件的数值，而磨砺则能为该部件添加特定能力。例如，镐可以添加速度、耐久度和挖掘效率。某些部件（如绿宝石）无法继续升级，取而代之的是“停滞”能力。"]
			dependencies: ["1F26E712089AAA2A"]
			id: "6C742359FD16AC83"
			tasks: [{
				id: "117782CFF4F6084A"
				type: "checkmark"
				title: "升级了？"
			}]
			rewards: [{
				id: "489AE40561E82528"
				type: "xp"
				xp: 50
			}]
		}
		{
			x: -4.0d
			y: -0.5d
			description: ["Tetra双头工具能做多件事，例如一把镐可以有一个镐头和斧头。如果同一工具上装有斧头和锤头，工具会获得一个酷炫的名字，比如木匠锤。"]
			dependencies: ["1F26E712089AAA2A"]
