	quest.5ED06421E60A86A8.quest_subtitle: "锻造星辉铂金和天界铂金需要用到铂金。"
	quest.5FB3452F49842832.quest_subtitle: "用于复活化石所需的方块。"
	quest.5FBDFE01BAFC4141.quest_subtitle: "&b丛林、温带、繁茂"
	quest.5FFC8C8C8E1792B9.quest_subtitle: "钯可以制作成盔甲和工具。它与钻石相当，并提供自然火焰抗性以及在岩浆中增加移动速度。"
	quest.603F1D71DAAA35F9.quest_subtitle: "&b丛林，沼泽"
	quest.6163D3F52CF4FCAC.quest_subtitle: "&b海岸、淡水、岛屿、海洋"
	quest.6195D8CF453E42CC.quest_desc: ["每级有5%的几率每秒恢复耐久度。若此特性修复工具1200次，工具将+1伤害"]
	quest.61AF725D4B4995ED.quest_subtitle: "复活化石所需的一种方块。"
	quest.61F114C198BF0CDB.quest_subtitle: "最基础的生存指南"
	quest.61F114C198BF0CDB.title: "&9Tier 1"
	quest.62701AA8050C475E.quest_desc: [
		"最多可提升3次收获中浆果树的突变概率。"
		""
		"它还能将完全成熟的复兴草变异为精神草、力量草、白色草或镜像草。"
	]
	quest.62701AA8050C475E.quest_subtitle: "点击了解更多详情！"
	quest.62AF6599A598A694.quest_desc: [
		"卡莫特法杖是一种强大的武器，其能力取决于放入其中的方块。"
		""
		"可在村庄神庙中找到，但若找不到，也可以用32个卡莫特锭购买！"
		"卡莫特法杖有多种不同的能力："
		""
		"&b铁&r：将对手击飞，强化法杖。"
		""
		"&b黄金&r: 持续两分钟，赋予你幸运。"
		""
		"&b铜&r：会召唤闪电劈到自己身上。"
		""
		"&b钻石&r: 强化法杖。"
		""
		"&b青铜&r：用闪电击倒对手。"
		""
		"&b下界合金&r：强大的近战武器，能大幅增强法杖。"
		""
		"&bMetallurgium&r：神话金属中单次伤害最高，但速度极慢。"
		""
		"&bCarmot&r: 为你和附近的实体恢复5点生命值。"
		""
		"&b米达斯黄金&r：使你及附近实体在四分钟内获得幸运度 2。"
		""
		"&b白金之星&r：超快的攻击速度。"
		""
		"&b信标&r：在18格半径内，为玩家提供随机的信标效果，持续30分钟。"
		""
		"&b青金石&r: 手持时增加经验值获取量。"
		""
		"&bStormyx&r: 手持时生成可反弹投射物的护盾。"
		""
		"&b海绵&r: 移除半径12格内的水。"
		""
		"&bHallowed&r: 显著增强了法杖。"
	]
