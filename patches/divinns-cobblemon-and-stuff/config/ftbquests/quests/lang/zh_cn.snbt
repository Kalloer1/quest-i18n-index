	quest.5764F92B1ADAA1D3.quest_desc: ["生命值较低时伤害提升"]
	quest.596EC0CFEBB7B6DB.quest_desc: ["可以用线来修理工具"]
	quest.5A0187C7D97C2BCE.quest_subtitle: "&b山脉"
	quest.5A16D266081ACA0F.quest_desc: ["挖掘任何类型的石头时，有一定几率使工具免受未来损坏"]
	quest.5A5E63C5B47AB9F5.quest_subtitle: "一种极其稀有的矿石，用于制作 Celestium 和 Metallurgium。"
	quest.5BAD4B48714E6D83.quest_subtitle: "部分优质食物具有饱腹效果，可防止非再生饥饿值的消耗。"
	quest.5BEAC1B3CAEC7806.quest_desc: ["使工具挖掘速度加快，速度为特性等级平方根的一半 x 耐久度损耗"]
	quest.5C0CBB1C1D5A3673.quest_desc: ["在初始阶段，以额外25%的维修成本为代价，防止33%的伤害"]
	quest.5CADFCC0C5226AAB.quest_desc: ["海拔越低挖掘越快，海拔越高挖掘越慢（y坐标）。"]
	quest.5D1813C8E162A736.quest_desc: ["将材料应用于工具时，每提升一级便提供一个额外的升级槽位"]
	quest.5D1BA4DC2B47A924.quest_subtitle: "使浆果树的行为如同处于平原生物群系中一样，且持续时间无限。"
	quest.5D35B20038301C6D.quest_desc: ["无需工具即可更快地挖掘方块"]
	quest.5DBFD6079C68F572.quest_subtitle: "用于教授宝可梦招式。（单次使用）"
