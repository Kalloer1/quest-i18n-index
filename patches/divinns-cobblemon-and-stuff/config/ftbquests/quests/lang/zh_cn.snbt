	quest.75AB1BBA64DA9670.quest_desc: ["耐久度越低挖掘越快，但造成的伤害越低"]
	quest.76161ADE48922230.quest_subtitle: "与锰结合以创造杜拉钢！"
	quest.766EAE0E11070A1C.quest_subtitle: "制作神话钻探机所需的材料之一。"
