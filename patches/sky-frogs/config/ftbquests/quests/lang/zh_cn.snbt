# AI 初翻，未人工校对
{
	chapter.1F00000000000001.title: "工具和物品"
	chapter.2A5700000A570001.title: "扩大殖民地规模"
	chapter.570A6E0000000001.title: "存储与合成"
	chapter.60ADE60000000001.title: "通往宝石的道路"
	chapter.6C1F0A2B3D4E5F60.title: "你的第一块铁锭"
	chapter.6E0DE00000000001.title: "Geode 青蛙"
	chapter.6ECA150000000001.title: "电力与机械模组整合包任务书"
	chapter.70B0000000000001.title: "通往沼泽的道路"
	chapter.71DE000000000001.title: "通往潮汐之路"
	chapter.784143B9C5D63814.title: "欢迎"
	chapter.7B06000000000001.title: "沼泽青蛙"
	chapter.7CA7E000C0DE0001.title: "洞穴青蛙"
	chapter.3E17000000000001.title: "熔点 (Melting Point)"
	chapter.70E0000000000001.title: "能量增强"
	chapter.7D00000000000001.title: "溺亡者宝藏"
	chapter.7F00000000000001.title: "振翅高飞"
	chapter_group.0C4F0E0000000001.title: "第一级：洞穴"
	chapter_group.0C4F0E0000000002.title: "Tier 2: Geode"
	chapter_group.0C4F0E0000000003.title: "第三级：沼泽地（Bog）"
	chapter_group.0C4F0E0000000004.title: "第4阶段：潮汐"
	chapter_group.0C4F0E0000000007.title: "收集癖玩家"
	quest.111D15C0DE000001.quest_desc: [
		"Sky Frogs 的开发源于玩家的反馈——每次更新的一半都始于社区 Discord 上的消息。无论是 bug、建议，还是你池塘的截图，都影响着本整合包的塑造。"
		""
		"点击此任务上方的&9Discord徽章&r以打开邀请链接，或在浏览器中输入&bdiscord.gg/r6MhZ73nsM&r。"
	]
	quest.111D15C0DE000001.quest_subtitle: "其他青蛙正在等待着你。"
	quest.111D15C0DE000001.title: "加入池塘 (Join the Pond)"
	quest.01A8E068925B319F.quest_desc: [
		"漂浮在虚空中的草岛。这就是整个世界——没有矿石，无处可挖。"
		""
		"相反，你可以孵化自己的&a青蛙&r。喂它们合适的史莱姆，就能得到你通常会挖掘的资源。"
		""
		"跟随任务书。从洞穴层级到虚空层级，孵化能吞噬凋零和末影龙的青蛙。"
	]
	quest.01A8E068925B319F.quest_subtitle: "从这里开始。"
	quest.01A8E068925B319F.title: "欢迎来到 Sky Frogs 模组整合包"
	quest.6A5B4C3D2E1F0001.quest_desc: [
		"用于暗房的&a生成探测器&r。当刷怪笼不生成任何生物时，它会检查方块是否符合游戏的真实生成规则，并指出阻碍因素：光照等级、地板、生物数量上限，或是你站得太近。"
		""
		"在暗房的地板上潜行右键以固定探针，然后从列表中选中 &aCave Slime&r，探针会告诉你该方块能否生成。走开后右键空气即可远距离读取结果。"
		""
		"史莱姆需要不止一个方块的空地，所以紧贴墙壁的每个方块都被视为被阻挡。这不是探测错误，只是房间边缘对他们来说是无效区域。"
	]
	quest.6A5B4C3D2E1F0001.quest_subtitle: "通常不是光的问题所在。"
	quest.6A5B4C3D2E1F0001.title: "为什么它不生成呢？"
	quest.2F1E0D0C0B0A0001.quest_desc: [
		"Productive Frogs 有自己独立的书籍。模组里的每只青蛙、史莱姆和电器都有专属页面，多方块条目会投影出建筑的虚影，让你放置前就能看到每个方块的位置。"
		""
		"加入时会发一本给你。弄丢了？用一本 &f书&r 和一个 &e史莱姆球&r 就能再造一本。"
	]
	quest.2F1E0D0C0B0A0001.quest_subtitle: "不是这本。是另外一本。"
	quest.2F1E0D0C0B0A0001.title: "野外指南手册"
	quest.05BFA1537298A589.quest_desc: [
		"不用挖矿，你可以通过&a青蛙&r来获取材料。给一只&a青蛙&r喂食对应的&b资源史莱姆&r，它就会产出一个&6蛙灯&r。熔炼蛙灯即可获得资源。"
	]
	quest.05BFA1537298A589.quest_subtitle: "整个提案，三个字概括。"
	quest.05BFA1537298A589.title: "青蛙，不是稿子"
	quest.1F00000000000002.quest_desc: [
		"Just Dire Things 需要 &eGoo&r 来运行。将 &fclay balls&r、&frotten flesh&r、&fsugar&r 和一块 &fmycelium&r 合成 &ePrimogel Goo&r。mycelium 来自你的 &aBog frog&r；在本整合包中，它替代了配方中通常需要的泥土。"
		""
		"放置凝胶，并在旁边放置一个&f铁块&r或&f煤炭块&r。几分钟后，凝胶会将该方块变为原矿。像往常一样开采即可。"
	]
	quest.1F00000000000002.quest_subtitle: "Just Dire Things 开始了。"
	quest.1F00000000000002.title: "第一份凝胶样本"
	quest.1F00000000000020.quest_desc: ["&eSlime Churn&r 会装填史莱姆而不是生成它们。用一桶任意&eSlime Milk&r和一叠空桶装载它；它会以与放置的牛奶池相同的速度、消耗和催化剂，将每个桶装满对应变体的&bBucket of Slime&r。世界上不会生成任何东西，所以无需追逐。"]
	quest.1F00000000000020.quest_subtitle: "挤奶机，反向运转。"
	quest.1F00000000000020.title: "史莱姆搅拌器"
	quest.1F00000000000005.quest_desc: ["&fFerricore&r 是 JDT 的铁。将 &f铁块&r 放置在你的 &ePrimogel Goo&r 上，几分钟后它们会变为 &fRaw Ferricore Ore&r；开采并熔炼即可获得 &bFerricore Ingot&r。多储备一些，因为后面的流体收集器、流体放置器和物品收集器都需要 ferricore。"]
	quest.1F00000000000005.quest_subtitle: "JDT 的基底金属。"
	quest.1F00000000000005.title: "Ferricore Ingot"
	quest.1F0000000000000E.quest_desc: [
		"一个&e物品收集器&r会吸走半径内落在地板上的所有东西：&6蛙灯&r、史莱姆球、流浪者掉落物。把它放在青蛙栖息地的地板上，不要走到平台上捡拾。"
		""
		"需要一颗 &f末影珍珠&r、钻石、漏斗和铁核，所以如果还没有，先去暗房里刷一个末影人吧。"
	]
	quest.1F0000000000000E.quest_subtitle: "一个物品磁铁。"
	quest.1F0000000000000E.title: "打扫地板上的灰尘"
	quest.1F00000000000011.quest_desc: [
		"&e交换工具&r（建筑工具2）能将一个方块原地替换为另一个：无需拆除即可重贴墙壁或翻新住所。"
		""
		"你曾在 Mekanism 的 Enrichment Chamber 奖励中见过 &bBuilding Gadget&r；Exchanging Gadget 是用于交换方块的对等物，并非它的升级版。"
	]
	quest.1F00000000000011.quest_subtitle: "批量交换方块。"
	quest.1F00000000000011.title: "交换小工具中，请稍候..."
	quest.1F00000000000014.quest_desc: [
		"&e复制/粘贴小工具&r可将形状捕捉到&b模板&r中，并在任何地方粘贴。建造一个青蛙栖息地，然后将副本粘贴到整个平台上，而无需手动重建每个栖息地。"
		""
		"你的奖励，&b模板管理器&r，可以命名和保存模板，以便你日后重复使用。"
	]
	quest.1F00000000000014.quest_subtitle: "建造两次。"
	quest.1F00000000000014.title: "复制，粘贴"
	quest.1F00000000000017.quest_desc: [
		"&e流体收集器&r会将其前方的流体源（水、岩浆、乳胶、任何能桶取的东西）排入内部储罐，你可以用管道将其导出。"
		""
		"将其倒入你的 &bDissolution Chamber&r 的乳胶入口或 cobblegen 的水入口，任何你以前手动搬运水桶的地方。"
	]
	quest.1F00000000000017.quest_subtitle: "舀取流体，无需水桶。"
	quest.1F00000000000017.title: "流体收集器"
	quest.1F0000000000001A.quest_desc: [
		"&e流体放置器&r正好相反：它将储罐中的液体倒入前方的方块。用它来为 cobblegen 供水或岩浆。"
		""
		"搭配一个 &e流体收集器&r 实现闭环：一个抽取源，另一个将其放置到你需要的地方。"
	]
	quest.1F0000000000001A.quest_subtitle: "倒液体，别用桶。"
	quest.1F0000000000001A.title: "流体放置器"
	quest.21B2C3D4E5F60001.quest_desc: ["制作一个橡木桶。它能收集雨水，比初始的一个水桶能装更多的水。"]
	quest.21B2C3D4E5F60001.quest_subtitle: "从天而降的水。"
	quest.21B2C3D4E5F60001.title: "一个雨水收集桶"
	quest.21B2C3D4E5F60011.quest_desc: ["用剪刀收集橡木叶，制作完整的树叶方块。橡木熔炉可将它们熔化成水。"]
	quest.21B2C3D4E5F60011.quest_subtitle: "叶子，完整的。"
	quest.21B2C3D4E5F60011.title: "剥去树叶的皮层"
	quest.21B2C3D4E5F60021.quest_desc: ["建造一个橡木熔炉，然后右键点击树叶方块放入其中。它们会自动熔化成水，不需要加热。"]
	quest.21B2C3D4E5F60021.quest_subtitle: "树叶落入水中。"
	quest.21B2C3D4E5F60021.title: "The Crucible"
	quest.21B2C3D4E5F60031.quest_desc: ["两个水源间隔一个方块，中间的空隙会形成无限水源。"]
	quest.21B2C3D4E5F60031.quest_subtitle: "一个无限供应的来源。"
	quest.21B2C3D4E5F60031.title: "流动的水"
	quest.2A5700000A570002.quest_desc: ["到目前为止，你手动喂食了史莱姆并熔炼了蛙灯。本章将自动化这两项：可持续的食物和繁殖供应，然后用漏斗和熔炉来运行循环，无需你操作。"]
	quest.2A5700000A570002.quest_subtitle: "让殖民地自行运转吧。"
	quest.2A5700000A570002.title: "请勿触摸物品，否则后果自负！"
	quest.2A5700000A570005.quest_desc: ["用你的&e铁锤&r，把鹅卵石压成砾石，把砾石压成沙子，再把沙子压成&e粉尘&r。粉尘之后能做成黏土。"]
	quest.2A5700000A570005.quest_subtitle: "将鹅卵石磨成粉末。"
	quest.2A5700000A570005.title: "把它磨个粉碎"
	quest.2A5700000A570008.quest_desc: ["将你的 &eDust&r 放入装满水的橡木桶中，它就会变成一块 &fclay&r。和雨水用的桶是一样的。"]
	quest.2A5700000A570008.quest_subtitle: "将尘土变为黏土。"
	quest.2A5700000A570008.title: "只需加水"
	quest.2A5700000A57000B.quest_desc: ["将黏土烧制为&e陶土砖&r，将黏土球烧制为砖块以制作&e花盆&r。接下来制作&a植物盆&r需要五个陶土砖和一个花盆。"]
	quest.2A5700000A57000B.quest_subtitle: "将黏土烧制为陶土砖。"
	quest.2A5700000A57000B.title: "Fired Earth"
	quest.2A5700000A57000F.quest_desc: [
		"&aBotany Pot&r 是一种自动种植器：加入土壤和作物，它就会自己生长。树苗也行——它会长成一棵树。"
		""
		"种植 &a甘蔗&r，以获得稳定的糖供应，你接下来会需要糖。"
	]
	quest.2A5700000A57000F.quest_subtitle: "一个用于种植植物的花盆。"
	quest.2A5700000A57000F.title: "可供生长的花盆"
	quest.2A5700000A570012.quest_desc: ["&dSweetslime&r 是用来繁殖青蛙的食物，也是用现有资源史莱姆合成新资源史莱姆的原料。用糖和 &aslime ball&r 制作。"]
	quest.2A5700000A570012.quest_subtitle: "糖，青蛙的方式。"
	quest.2A5700000A570012.title: "甜食爱好者"
	quest.2A5700000A570015.quest_desc: ["将橡木桶装满有机废料——树苗、树叶、种子——它就会腐化成 &6泥土&r 方块。"]
	quest.2A5700000A570015.quest_subtitle: "堆肥成泥土。"
	quest.2A5700000A570015.title: "腐敗之地块（Dirt from Decay）"
	quest.2A5700000A570018.quest_desc: [
		"用水瓶右键泥土块，它就会变成&6泥土&r。"
		""
		"泥土略小于一个完整方块，所以掉落物会直接穿过它落到下方——这样你就能接住你的蛙灯了。用九个方块铺一个3x3的围栏底部。"
	]
	quest.2A5700000A570018.quest_subtitle: "湿土，是有意为之的。"
	quest.2A5700000A570018.title: "制作泥土"
	quest.2A5700000A57001B.quest_desc: ["在九个泥土方块下方各放置一个&7漏斗&r，以接住掉落的青蛙灯。"]
	quest.2A5700000A57001B.quest_subtitle: "接住掉落下来的东西。"
	quest.2A5700000A57001B.title: "漏斗构成的地板"
	quest.2A5700000A57001E.quest_desc: [
		"制作一个&e铁质熔炉&r。与原版熔炉不同，它可以将产物推入相邻的背包——打开熔炉并开启&e自动输出&r。"
		""
		"将青蛙放在泥地上，将漏斗连接到熔炉上，并在熔炉的出料口放置一个箱子。这样青蛙掉落的每个蛙灯都会自动熔炼成铁并落入箱子中。"
	]
	quest.2A5700000A57001E.quest_subtitle: "在你睡觉的时候进行冶炼。"
	quest.2A5700000A57001E.title: "免提青蛙灯"
	quest.2A5700000A570022.quest_desc: [
		"将&dSweetslime&r喂给两只同品种的成年青蛙，它们就会在&b水池&r中繁殖产卵——每只青蛙需要一个Sweetslime。"
		""
		"配对后，它们需要几分钟的冷却时间才能再次繁殖。如果什么都没发生，请耐心等待并确保有水：青蛙只在水池里产卵，绝不会在陆地上产卵。"
	]
	quest.2A5700000A570022.quest_subtitle: "将它们两两配对起来吧。"
	quest.2A5700000A570022.title: "繁殖你的青蛙"
	quest.2A5700000A570034.quest_desc: [
		"繁殖能培育出更棒的青蛙，而不仅仅是数量上的增加。"
		""
		"每只资源青蛙都有三个属性。查看青蛙、蝌蚪或蛋的提示框即可阅读它们："
		""
		"&a食欲&r：进食速度。数值越高，史莱姆之间的冷却时间越短，每分钟产出的蛙灯越多。"
		"&e赏金&r：每个史莱姆能产出的蛙灯数量。数值越高，相同数量的史莱姆产出越多。"
		"&b感知范围&r：感知史莱姆的距离。数值越高，一只青蛙能覆盖的区域越大。"
		""
		"Stats 的数值范围是 &b1 到 10&r。从孵化机孵出的青蛙初始值为 &b1/1/1&r，只能通过繁殖来提升它们。"
		""
		"宝宝的属性始于父母的&e平均值&r，之后每个属性都有机会&a提升一级&r。每次繁殖至少提升一项，且宝宝属性绝不会低于父母的平均值——所以要将&l最优秀的与最优秀的结合&r，以保持平均值。混入弱蛙会拉低平均值。"
	]
	quest.2A5700000A570034.quest_subtitle: "培育出更优秀的青蛙。"
	quest.2A5700000A570034.title: "提升防线"
	quest.2A5700000A570031.quest_desc: ["给青蛙命名只是为了好玩，并不会改变它们的工作方式。在&e砧板&r上重命名一个&e命名牌&r，然后点击青蛙右键即可命名。"]
	quest.2A5700000A570031.quest_subtitle: "给他们起名字吧。"
	quest.2A5700000A570031.title: "给你的青蛙起个名字"
	quest.32C3D4E5F6A10001.quest_desc: ["用钩爪破坏橡木树叶可获得额外掉落：树苗可供重新种植，偶尔还能钓到&eSilkworm&r。"]
	quest.32C3D4E5F6A10001.quest_subtitle: "对待树叶要轻柔一些。"
	quest.32C3D4E5F6A10001.title: "一个狡猾的骗子"
	quest.32C3D4E5F6A10011.quest_desc: ["用钩镰斧砍橡树叶，直到掉落蚕，然后把它放在叶子上。它会向外扩散，感染周围的叶子。被感染的叶子才能产出线。"]
	quest.32C3D4E5F6A10011.quest_subtitle: "摇晃树木，收集掉落物。"
	quest.32C3D4E5F6A10011.title: "Silkworms"
	quest.32C3D4E5F6A10021.quest_desc: ["当叶子被&e完全侵扰&r后，再次折断它们，会掉落&f线&r而不是蚕。收集四根。"]
	quest.32C3D4E5F6A10021.quest_subtitle: "不需要蜘蛛。"
	quest.32C3D4E5F6A10021.title: "来自丝绸的字符串"
	quest.32C3D4E5F6A10031.quest_desc: ["用你的线合成一张床。睡在里面可以跳过夜晚并设置重生点。"]
	quest.32C3D4E5F6A10031.quest_subtitle: "跳过夜晚。"
	quest.32C3D4E5F6A10031.title: "一张属于你自己的床"
	quest.378B93672C31CF5D.quest_desc: [
		"你的第一只青蛙是&e洞穴青蛙&r。它能为你带来锭和其他洞穴资源：铁、铜、金以及其他洞穴层级资源。"
		""
		"首先需要完成基础建设。你需要玻璃瓶、圆石，还要一个史莱姆农场。之后你就能孵化出第一只洞穴青蛙了。"
	]
	quest.378B93672C31CF5D.quest_subtitle: "所有迹象都指向了铁元素。"
	quest.378B93672C31CF5D.title: "通往铁的道路"
	quest.43D4E5F6A1B20001.quest_desc: ["木制镐能帮你获得所需的鹅卵石。"]
	quest.43D4E5F6A1B20001.quest_subtitle: "石头能打败拳头。"
	quest.43D4E5F6A1B20001.title: "贸易的工具"
	quest.43D4E5F6A1B20011.quest_desc: [
		"鹅卵石生成器会在流动的岩浆流入水中时生成鹅卵石。开采后它会重新生成，所以你永远不会用完。"
		""
		"让岩浆流入水中，而非水流入岩浆源：流动的岩浆会生成鹅卵石，但被水接触的岩浆源会变为黑曜石。"
	]
	quest.43D4E5F6A1B20011.quest_subtitle: "第一种可再生的岩石。"
	quest.43D4E5F6A1B20011.title: "Cobblestone"
	quest.43D4E5F6A1B20021.quest_desc: ["使用&e铁锤&r将鹅卵石压成砾石，再将砾石压成沙子。"]
	quest.43D4E5F6A1B20021.quest_subtitle: "由鹅卵石粉碎而成。"
	quest.43D4E5F6A1B20021.title: "沙子"
	quest.43D4E5F6A1B20031.quest_desc: ["把沙子熔炼成玻璃。"]
	quest.43D4E5F6A1B20031.quest_subtitle: "沙子，来和火焰见个面吧。"
	quest.43D4E5F6A1B20031.title: "玻璃"
	quest.43D4E5F6A1B20041.quest_desc: [
		"&eStone Block Generator&r 能自动生成鹅卵石。一侧放水，一侧放岩浆，顶部放储物箱。"
	]
	quest.43D4E5F6A1B20041.quest_subtitle: "岩石，随取随用。"
	quest.43D4E5F6A1B20041.title: "石头方块生成器"
	quest.54E5F6A1B2C30001.quest_desc: ["&aCave Slimes&r 会出现在黑暗中。建造一个密封、无光的房间，&e至少5x5且高3格&r。在你周围 &b24格&r 内不会生成任何生物，所以走开等它填满，然后击杀史莱姆获得 &eslime balls&r。"]
	quest.54E5F6A1B2C30001.quest_subtitle: "史莱姆感到安全的地方。"
	quest.54E5F6A1B2C30001.title: "一个黑暗的房间"
	quest.54E5F6A1B2C30011.quest_desc: ["一个&a堆肥桶&r能将多余的树苗、树叶和种子转化为&e骨粉&r。"]
	quest.54E5F6A1B2C30011.quest_subtitle: "腐烂成绿色。"
	quest.54E5F6A1B2C30011.title: "一个堆肥桶"
	quest.54E5F6A1B2C30021.quest_desc: ["&aThe Spawnery&r 的运行方式就像熔炉：一个 &f玻璃瓶&r、一个史莱姆球作为燃料，以及一个决定你获得哪种青蛙的资源。瓶子里就会产出那种青蛙的蛋。"]
	quest.54E5F6A1B2C30021.quest_subtitle: "青蛙工厂。"
	quest.54E5F6A1B2C30021.title: "The Spawnery"
	quest.54E5F6A1B2C30031.quest_desc: [
		"将&a鹅卵石&r（洞穴青蛙的资源）、一个史莱姆球燃料和一个玻璃瓶放入孵化器。出来的就是&e洞穴青蛙蛋瓶&r。"
		""
		"制作&b两个&r作为繁殖对，然后右键将它们放置在水源方块上以孵化。"
	]
	quest.54E5F6A1B2C30031.quest_subtitle: "你的第一批青蛙。"
	quest.54E5F6A1B2C30031.title: "合成生命"
	quest.570A6E0000000002.quest_desc: [
		"&eSophisticated Storage Barrel&r 像箱子一样储存物品，但它需要 &f升级&r：更大的容量等级、自动拾取、压缩等。本章所有内容都基于它构建。"
		""
		"制作一个。"
	]
	quest.570A6E0000000002.quest_subtitle: "一个可以倾倒一切的地方。"
	quest.570A6E0000000002.title: "属于你自己的木桶"
	quest.570A6E0000000005.quest_desc: [
		"&e桶&r会逐级升级——&6铜&r、&e铁&r，然后是&e金&r——每级容量更大。你已从洞穴青蛙处获得了全部三种材料。"
		""
		"将其中一个升级为&e金桶&r。"
	]
	quest.570A6E0000000005.quest_subtitle: "升级桶子。"
	quest.570A6E0000000005.title: "更深层的桶 (Deeper Barrels)"
	quest.570A6E0000000008.quest_desc: [
		"&e堆叠升级&r能将桶中每个格子的容量翻倍。更高等级会进一步倍增，一个桶就能跟上青蛙养殖场的产量。"
		""
		"制作一个，然后放入物品栏中。"
	]
	quest.570A6E0000000008.quest_subtitle: "每个物品栏位更多。"
	quest.570A6E0000000008.title: "堆高高"
	quest.570A6E000000000B.quest_desc: [
		"&e拾取升级&r能让桶吸引周围掉落的物品。青蛙掉落物会落入桶中，而不是掉在地上。"
		""
		"需要一个&a粘性活塞&r——活塞加史莱姆球。制作一个。"
	]
	quest.570A6E000000000B.quest_subtitle: "它会跟在你的身后拾取物品。"
	quest.570A6E000000000B.title: "免提式物品拾取器"
	quest.570A6E000000000E.quest_desc: [
		"每个&bCompacting Drawers&r可存放数千种单一资源，并能自动转换其原矿、锭和方块。"
		""
		"一个&e存储控制器&r能将它们连接起来，让你在一个地方就能取用所有抽屉里的东西。它的配方通常需要下界石英，但在这个整合包里不是——用石头、红石块和几个抽屉就能制作。"
	]
	quest.570A6E000000000E.quest_subtitle: "一个方块，一个物品，数量众多。"
	quest.570A6E000000000E.title: "一排抽屉组成的墙壁"
	quest.570A6E0000000011.quest_desc: [
		"桶的最后一块拼图。一个 &eStorage Controller&r 能将所有与之接触的桶连接成一个集群——将物品存入控制器或通过管道输送，这一个方块就能为整个集群供料。一个 &eStorage Link&r 和 &eStorage Tool&r 能将未与堆叠接触的桶接入其中。"
		""
		"它不需要电力，这个整合包的配方会掉落下界石英——一个用中继器取代了比较器的装置。链接需要&d末影珍珠&r，你的暗室已经能生产了。"
		""
		"这是你在 Infernal 阶段之前的存储方式，之后 &eRefined Storage&r 会将其数字化。"
	]
	quest.570A6E0000000011.quest_subtitle: "一个存储网络。"
	quest.570A6E0000000011.title: "每个桶，一个方块"
	quest.570A6E0000000014.quest_desc: [
		"你现在有了全套存储设备：升级桶、控制器抽屉墙、流体储罐、垃圾桶，还有能从旁边存储单元直接取零件的 &eCrafting Station&r。"
		""
		"这是整个整合包后续内容的基础。在 Infernal 阶段，&eRefined Storage&r 将一切数字化。"
	]
	quest.570A6E0000000014.quest_subtitle: "整套的存储设备组合。"
	quest.570A6E0000000014.title: "万物各得其所的归属地"
	quest.570A6E0000000019.quest_desc: [
		"&e流体抽屉&r是一种液体抽屉：它可容纳一种液体——水、岩浆、牛奶、蜂蜜——并在正面显示数量。用木板和一个桶来制作。"
		""
		"它与你的物品抽屉使用同一个&eStorage Controller&r，从而加入网络。"
	]
	quest.570A6E0000000019.quest_subtitle: "流体也一起储存起来吧。"
	quest.570A6E0000000019.title: "流动资产"
	quest.570A6E000000001C.quest_desc: ["一个&e基础流体储罐&r可以储存一种流体，只需要&f铁&r和&c红石&r，不需要Mekanism机器或锇。打破储罐后，里面的流体仍会保留，所以你可以直接搬走装满的储罐。"]
	quest.570A6E000000001C.quest_subtitle: "一个流体储罐。"
	quest.570A6E000000001C.title: "非常感谢你的帮助"
	quest.570A6E000000001F.quest_desc: [
		"将物品投入&e物品垃圾桶&r后，该物品将被永久删除。"
		""
		"设置过滤器，使其只丢弃你选择的物品，然后将物品倒入漏斗中。"
	]
	quest.570A6E000000001F.quest_subtitle: "把垃圾清空掉。"
	quest.570A6E000000001F.title: "把垃圾倒掉"
	quest.60ADE60000000002.quest_desc: [
		"洞穴青蛙给了你金属。晶洞青蛙会给你宝石，首先是青金石。"
		""
		"给&eSpawnery&r喂一个史莱姆球，但把引信换成&c红石&r（鹅卵石给了你洞穴蛋）。它会装一瓶&d地质青蛙蛋瓶&r。把它倒进水里孵化地质青蛙。"
	]
	quest.60ADE60000000002.quest_subtitle: "Tier 2 开始了。"
	quest.60ADE60000000002.title: "通往宝石的道路 (The Road to Geode)"
	quest.60ADE60000000005.quest_desc: ["将&bLapis Slime in a Bucket&r倒入&eSlime Milker&r，可获得一桶&9Lapis Slime Milk&r。倒出后，Lapis Slimes 就会开始生成。"]
	quest.60ADE60000000005.quest_subtitle: "把蓝色的挤奶。"
	quest.60ADE60000000005.title: "一桶青金石史莱姆牛奶"
	quest.60ADE60000000008.quest_desc: [
		"用青金石史莱姆喂养地质青蛙，可获得&6青金石蛙灯&r。上交一个，然后将剩下的熔炼成&9青金石&r。"
		""
		"奖励 &e简易压缩抽屉&r 会在填满时将青金石压缩成方块。"
	]
	quest.60ADE60000000008.quest_subtitle: "宝石被打开了。"
	quest.60ADE60000000008.title: "第一块青金石"
	quest.60ADE6000000000B.quest_desc: ["用一桶&c红石史莱姆牛奶&r合成&b桶装青金石史莱姆&r：四个砾石、三个甜史莱姆和一瓶脉化石蛙卵。洞穴蛙的最后一种资源为脉化石蛙提供了最初的资源。"]
	quest.60ADE6000000000B.quest_subtitle: "蓝色史莱姆，已装瓶。"
	quest.60ADE6000000000B.title: "桶里的一只青金石史莱姆"
	quest.65F6A1B2C3D40001.quest_desc: [
		"两个值得了解的生活质量小技巧："
		""
		"&aSquat Grow&r - 反复潜行到树苗或作物旁，它就会生长。种下你的橡树，在上面蹲几次，跳过等待时间。"
		""
		"&bFTB Ultimine&r - 一次性破坏一整棵树或一片作物。在选项 -> 控制中绑定 &eUltimine&r 键，然后按住该键并破坏一个方块；所有相连的原木或作物都会一同被破坏。"
	]
	quest.65F6A1B2C3D40001.quest_subtitle: "少工作，多当青蛙。"
	quest.65F6A1B2C3D40001.title: "两个快捷方式"
	quest.6C1F0A2B3D4E5F61.quest_desc: [
		"在孵化青蛙前，先建个它们跳不出去的围栏。青蛙跳得高，一旦越过墙就会消失。建高墙，或者盖上屋顶。"
		""
		"将 &b水&r池嵌入地板中，&b3x3 且深两格&r。卵会在那里孵化，繁殖对也会在那里产卵；宽敞的水池比一格水洼更可靠。"
		""
		"蝌蚪很脆弱：它们必须在长成的几分钟内待在水中，一旦上岸就会死亡。"
	]
	quest.6C1F0A2B3D4E5F61.quest_subtitle: "为他们建造一个家园。"
	quest.6C1F0A2B3D4E5F61.title: "青蛙的家园 (A Place for Frogs)"
	quest.6C1F0A2B3D4E5F64.quest_desc: ["用&e牵引绳&r把青蛙拴在围栏上，这样它就不能跳出岛屿了。青蛙长大后，用牵引绳拴住每只青蛙。"]
	quest.6C1F0A2B3D4E5F64.quest_subtitle: "悬崖边的牵引绳。"
	quest.6C1F0A2B3D4E5F64.title: "让他们保持靠近"
	quest.6C1F0A2B3D4E5F67.quest_desc: ["&e史莱姆挤奶机&r会消耗一个&b桶装史莱姆&r，几秒后将其转化为该史莱姆的奶桶。"]
	quest.6C1F0A2B3D4E5F67.quest_subtitle: "想办法把史莱姆挤奶挤出来。"
	quest.6C1F0A2B3D4E5F67.title: "史莱姆挤奶机"
	quest.6C1F0A2B3D4E5F6A.quest_desc: [
		"你的&a洞穴青蛙&r需要史莱姆来吃。先在一个桶里制作一个&b铁质史莱姆&r。这是你要制作的许多资源史莱姆中的第一个。"
		""
		"至少准备好一桶史莱姆、一桶史莱姆牛奶，或每种资源各一个&6Froglight&r，否则你可能得从头开始制作。"
	]
	quest.6C1F0A2B3D4E5F6A.quest_subtitle: "铁，你可以把它倒出来。"
	quest.6C1F0A2B3D4E5F6A.title: "桶里的铁质史莱姆"
	quest.6C1F0A2B3D4E5F6D.quest_desc: [
		"将你的&b桶装铁史莱姆&r放入&e史莱姆榨汁机&r，可获得一桶&b铁史莱姆牛奶&r。"
		""
		"把桶倒在地上，就会生成&a铁史莱姆&r。一批史莱姆后水池会干涸，所以要捕捉并挤奶获得更多桶来维持运作。"
	]
	quest.6C1F0A2B3D4E5F6D.quest_subtitle: "把牛奶挤出来。"
	quest.6C1F0A2B3D4E5F6D.title: "挤奶时间到了"
	quest.6C1F0A2B3D4E5F70.quest_desc: ["一只&a洞穴青蛙&r吃掉一个&a铁史莱姆&r，会掉落一个&6铁蛙灯&r。"]
	quest.6C1F0A2B3D4E5F70.quest_subtitle: "史莱姆进去，蛙灯出来。"
	quest.6C1F0A2B3D4E5F70.title: "喂养青蛙"
	quest.6C1F0A2B3D4E5F73.quest_desc: ["在熔炉中熔炼 &6Iron Froglight&r 以获取铁锭。"]
	quest.6C1F0A2B3D4E5F73.quest_subtitle: "没有矿石受到伤害。"
	quest.6C1F0A2B3D4E5F73.title: "你的第一块铁锭"
	quest.6E0DE00000000002.quest_desc: [
		"你从 Geode frog 里拿出了青金石。其余的地质块石头和宝石也是如此：凝灰岩、方解石、紫水晶、祖母绿、钻石。"
		""
		"和金属一样的循环，每一步一种资源史莱姆。一直提炼到钻石。"
	]
	quest.6E0DE00000000002.quest_subtitle: "地质层链已开启。"
	quest.6E0DE00000000002.title: "超越青金石"
	quest.6E0DE00000000005.quest_desc: ["制作一个&b桶装紫晶史莱姆&r，喂养你的&a晶洞青蛙&r，并提交&6紫晶蛙灯&r。"]
	quest.6E0DE00000000005.quest_subtitle: "紫色的，尖尖的。"
	quest.6E0DE00000000005.title: "紫水晶"
	quest.6E0DE00000000008.quest_desc: ["制作一个&b桶装翡翠史莱姆&r，喂养你的&a晶洞青蛙&r，并提交&6翡翠蛙灯&r。"]
	quest.6E0DE00000000008.quest_subtitle: "村民级，青蛙制作。"
	quest.6E0DE00000000008.title: "Emerald"
	quest.6E0DE0000000000B.quest_desc: ["制作一个&b桶装钻石史莱姆&r，喂养你的&a晶洞青蛙&r，并上交&6钻石蛙灯&r。"]
	quest.6E0DE0000000000B.quest_subtitle: "来自一只青蛙。真的。"
	quest.6E0DE0000000000B.title: "钻石"
	quest.6E0DE0000000000E.quest_desc: ["用你的&elapis milk&r（四个砾石、三个sweetslime、一瓶Geode Frog Eggs）制作一个&bTuff Slime in a Bucket&r。挤奶，喂养Geode Frog，然后上交&6Tuff Froglight&r。将其熔炼以获得tuff。"]
	quest.6E0DE0000000000E.quest_subtitle: "粗糙但实用。"
	quest.6E0DE0000000000E.title: "Tuff"
	quest.6E0DE00000000011.quest_desc: ["制作一个&b桶装方解石史莱姆&r，喂养你的&a晶洞青蛙&r，并上交&6方解石蛙灯&r。"]
	quest.6E0DE00000000011.quest_subtitle: "地质体的苍白外壳。"
	quest.6E0DE00000000011.title: "方解石"
	quest.6E0DE00000000014.quest_desc: [
		"史莱姆牛奶源在多次生成后会枯竭。一个&b丰饶催化剂&r（两个&fsweetslime&r和&f骨粉&r）可以增加其持续时间：将其投入已放置的&e史莱姆牛奶&r池中即可。"
		""
		"该增益会保存到源头，再次装桶后依然存在。没有上限，想堆多少就堆多少。"
	]
	quest.6E0DE00000000014.quest_subtitle: "每个来源产出更多史莱姆。"
	quest.6E0DE00000000014.title: "丰饶催化剂"
	quest.6E0DE00000000017.quest_desc: ["一个&b快速催化剂&r（两个&fsweetslime&r和&fsugar&r）可以缩短生成间隔。像上一个一样把它扔进池子里。加速有上限，所以每个来源放几个就够了。"]
	quest.6E0DE00000000017.quest_subtitle: "更快的史莱姆。"
	quest.6E0DE00000000017.title: "快速催化剂"
	quest.6E0DE0000000001A.quest_desc: ["&bTeeming Catalyst&r（两个 &fsweetslime&r 和 &fredstone&r）会在每个生成点增加一个史莱姆。像其他催化剂一样放置即可。效果和 Rapid Catalyst 一样有上限，放几个就够了。"]
	quest.6E0DE0000000001A.quest_subtitle: "更大的批量处理。"
	quest.6E0DE0000000001A.title: "Teeming Catalyst"
	quest.6E0DE0000000001D.quest_desc: [
		"将八个&b丰饶催化剂&r围绕一个&f钻石&r放置，即可制作一个&b无尽催化剂&r，然后将其投入已放置的&e史莱姆牛奶&r源中。该源将永不枯竭。"
		""
		"每个来源一个，而且永远不会重新充能。钻石就是为此准备的。"
	]
	quest.6E0DE0000000001D.quest_subtitle: "取之不尽的源泉。"
	quest.6E0DE0000000001D.title: "永不枯竭 (Never Runs Dry)"
	quest.6ECA150000000002.quest_desc: [
		"Mekanism 需要 &f锇&r 来运行，但这里没有可以开采的锇矿石。用你的 &e红石史莱姆牛奶&r、四块石头、三块甜史莱姆和一瓶洞穴青蛙卵来制作一个 &b桶装锇史莱姆&r。"
		""
		"挤奶，把史莱姆喂给洞穴青蛙，然后熔炼&6锇青蛙灯&r以获取锇。"
	]
	quest.6ECA150000000002.quest_subtitle: "Mekanism 的入门金属。"
	quest.6ECA150000000002.title: "锇（Osmium）"
	quest.6ECA150000000005.quest_desc: ["Mekanism 机器需要电力。建造一个入门级的 &eHeat Generator&r，并用 &fcoal&r（你的洞穴青蛙可以制作）或一桶岩浆来供能。虽然很慢，但能为早期机器供电。"]
	quest.6ECA150000000005.quest_subtitle: "电力已经送达。"
	quest.6ECA150000000005.title: "第一之力"
	quest.6ECA150000000008.quest_desc: ["&e冶金注入器&r能将一种材料压制成另一种，由发电机提供动力。这是将铁转化为&f富集铁&r的第一步，也是炼钢的第一步。"]
	quest.6ECA150000000008.quest_subtitle: "注入并组合。"
	quest.6ECA150000000008.title: "冶金学注入器 (The Metallurgic Infuser)"
	quest.6ECA15000000000B.quest_desc: [
		"在 &e冶金熔炉&r中，用 &f碳&r（煤炭或木炭）熔炼铁，得到 &f富铁&r，再用碳熔炼一次，得到 &f钢粉&r。将钢粉熔炼成 &b钢锭&r。"
		""
		"从现在开始，几乎所有Mekanism机器都需要用到钢。"
	]
	quest.6ECA15000000000B.quest_subtitle: "铁，经过硬化处理。"
	quest.6ECA15000000000B.title: "钢铁"
	quest.6ECA15000000000E.quest_desc: ["&b钢制外壳&r是所有Mekanism机器构建的基础。制作一个吧，本章后续的机器都需要它。"]
	quest.6ECA15000000000E.quest_subtitle: "机器外壳。"
	quest.6ECA15000000000E.title: "钢制外壳"
	quest.6ECA150000000011.quest_desc: [
		"钢可以批量获取，而不是一次性炼制。在 &e冶金熔炉&r中，将你的 &b铁史莱姆奶&r 与 &f碳&r（煤炭或木炭）融合，即可得到 &7桶装钢史莱姆&r，这与炼钢的步骤完全相同。"
		""
		"挤奶，把史莱姆喂给洞穴青蛙，然后熔炼&6钢制蛙灯&r来获取钢。"
	]
	quest.6ECA150000000011.quest_subtitle: "钢铁，青蛙的方式。"
	quest.6ECA150000000011.title: "钢铁史莱姆"
	quest.6ECA150000000014.quest_desc: [
		"&e风力发电机&r利用高度发电：位置越高，发电量越大。这里已经接近世界顶端，所以无需燃料，昼夜都能正常运行。"
		""
		"建造一个。几个&f能量锭&r就能覆盖大部分成本，之后就能自动运行了。"
	]
	quest.6ECA150000000014.quest_subtitle: "免费电力，微风习习。"
	quest.6ECA150000000014.title: "风力发电机"
	quest.6ECA150000000017.quest_desc: ["熔炉燃烧燃料；而&eEnergized Smelter&r则使用你已产生的焦耳能量，速度更快。它也是矿石翻倍机制的后半部分——粉尘输入，锭子输出。"]
	quest.6ECA150000000017.quest_subtitle: "使用能量进行熔炼。"
	quest.6ECA150000000017.title: "能量熔炼炉"
	quest.6ECA15000000001A.quest_desc: [
		"&eEnrichment Chamber&r 是 Mekanism 的矿石倍增器。将金属 &6Froglight&r 放入其中，它会分裂成 &b两种粉尘&r；将这些粉尘送入 Energized Smelter，一个 Froglight 就能变成 &b两个锭&r。"
		""
		"只有金属粉尘能通过。宝石蛙灯会原样通过，所以继续在熔炉里冶炼它们。"
	]
	quest.6ECA15000000001A.quest_subtitle: "双倍，带电的。"
	quest.6ECA15000000001A.title: "富集室"
	quest.70B0000000000002.quest_desc: ["用你的&d富矿钻石&r点燃&e刷怪器&r，再用史莱姆球提供燃料。这样就能得到一瓶&2沼泽青蛙卵&r。"]
	quest.70B0000000000002.quest_subtitle: "第三阶段开始了。"
	quest.70B0000000000002.title: "通往沼泽的道路"
	quest.70B0000000000005.quest_desc: ["用一桶&b钻石史莱姆牛奶&r、四个&a苔藓圆石&r、三个甜史莱姆和一瓶沼泽青蛙蛋来制作&2桶装泥土史莱姆&r。此后的所有沼泽资源都使用相同配方，将前一种资源的史莱姆牛奶替换即可。"]
	quest.70B0000000000005.quest_subtitle: "可以倾倒的泥土方块。"
	quest.70B0000000000005.title: "桶里装着泥土史莱姆"
	quest.70B0000000000008.quest_desc: ["将泥土史莱姆放入&e史莱姆挤奶机&r中，得到一桶&2泥土史莱姆牛奶&r。倒出牛奶，泥土史莱姆就会自行生成。"]
	quest.70B0000000000008.quest_subtitle: "把棕色的挤奶。"
	quest.70B0000000000008.title: "一桶泥土史莱姆牛奶"
	quest.70B000000000000B.quest_desc: [
		"用泥土史莱姆喂养你的沼泽青蛙，它会掉落一个&6泥土蛙灯&r。上交一个，然后将剩下的熔炼成泥土——从青蛙身上获得的可持续土地。"
		""
		"沼泽链的其余部分——泥、黏土、苔藓、菌丝、睡莲——都来自同一个循环。"
	]
	quest.70B000000000000B.quest_subtitle: "沼泽的基础设施。"
	quest.70B000000000000B.title: "泥土"
	quest.70B000000000000E.quest_desc: ["将一颗&b钻石&r放入&e富集室&r，制作&d富集钻石&r。这将为你的第一只沼泽青蛙激活产卵器。"]
	quest.70B000000000000E.quest_subtitle: "粉碎它以获得更多奖励。"
	quest.70B000000000000E.title: "富集一颗钻石 Enrich a Diamond"
	quest.70B0000000000011.quest_desc: ["在 &eMetallurgic Infuser&r 中用 &aBiomass&r 注入 &7cobblestone&r，每个 10 mB。苔石是沼泽层的填充物——此链中每个史莱姆步骤需要四块。"]
	quest.70B0000000000011.quest_subtitle: "石头变成了绿色。"
	quest.70B0000000000011.title: "长满苔藓的鹅卵石"
	quest.70B0000000000014.quest_desc: ["制作一个&eMekanism Crusher&r。投入植物材料——树苗、树叶、任何多余的有机物——它就能产出&aBio Fuel&r。"]
	quest.70B0000000000014.quest_subtitle: "把它磨个粉碎。"
	quest.70B0000000000014.title: "破碎机 The Crusher"
	quest.70B0000000000017.quest_desc: [
		"将植物材料放入&eCrusher&r中，以获取&aBio Fuel&r——初始为八个。"
		""
		"&e冶金催化器&r使用生物燃料作为&b生物质&r催化剂，能将鹅卵石变成苔藓。多备点，沼泽链全靠它。"
	]
	quest.70B0000000000017.quest_subtitle: "沼泽的注入物。"
	quest.70B0000000000017.title: "生物燃料"
	quest.71DE000000000002.quest_desc: [
		"每个工业前序机器都需要一个&e机器框架&r作为核心。最便宜的是&e怜悯机器框架&r，不需要塑料：原木、铁和红石块即可。"
		""
		"&bDissolution Chamber&r 建造于这个之上。"
	]
	quest.71DE000000000002.quest_subtitle: "Industrial Foregoing 现已加入。"
	quest.71DE000000000002.title: "机器框架"
	quest.71DE000000000005.quest_desc: [
		"&bDissolution Chamber&r 使用 &flatex&r 运行。在 &eCrucible&r 中熔炼一个 &6plastic Froglight&r 即可获得一桶，无需橡胶树或流体提取器。"
		""
		"为密室准备一罐乳胶备用。"
	]
	quest.71DE000000000005.quest_subtitle: "在坩埚中熔炼一个塑料的青蛙灯。"
	quest.71DE000000000005.title: "一桶乳胶"
	quest.71DE000000000008.quest_desc: [
		"&eDissolution Chamber&r将物品溶解在流体中，并挤压出新的东西。这里会生成资源史莱姆：原始资源、层级填充物、甜史莱姆，以及少量的&flatex&r，挤压成该变体的&bSlime in a Bucket&r。在JEI中查找你需要的。"
		""
		"洞穴、晶洞和沼泽也有合成台连锁配方。从&eTide&r开始，密室是制作资源史莱姆的唯一途径。"
	]
	quest.71DE000000000008.quest_subtitle: "溶解室。The Dissolution Chamber."
	quest.71DE000000000008.title: "史莱姆引擎 (The Slime Engine)"
	quest.71DE00000000000E.quest_desc: ["用你的沼泽顶石&b粉史莱姆&r激活&e刷怪器&r，以获得&b一瓶潮汐蛙卵&r。将其倒入水中孵化出你的&e潮汐蛙&r。"]
	quest.71DE00000000000E.quest_subtitle: "为海洋而生，做好准备。"
	quest.71DE00000000000E.title: "潮汐青蛙蛋"
	quest.71DE000000000014.quest_desc: ["你的第一个腔室史莱姆。将&b粉色史莱姆&r作为原料投入&e溶解腔室&r，即可产出&b一桶海晶灯史莱姆&r。JEI中有完整配方。"]
	quest.71DE000000000014.quest_subtitle: "桶里装着大海。"
	quest.71DE000000000014.title: "一桶海晶灯史莱姆"
	quest.71DE000000000017.quest_desc: [
		"将&bPrismarine Slime&r放入&eSlime Milker&r中，可获得&bPrismarine Slime Milk&r。"
		""
		"放置牛奶和棱镜石史莱姆，供你的&eTide Frog&r食用。"
	]
	quest.71DE000000000017.quest_subtitle: "海晶灯史莱姆牛奶。"
	quest.71DE000000000017.title: "挤奶时间到了"
	quest.71DE00000000001A.quest_desc: [
		"将海晶灯史莱姆喂给&e潮汐青蛙&r可获得&6海晶灯蛙灯&r，然后将其熔炼成&f海晶灯碎片&r。"
		""
		"&eTide&r 已开启。其余水生资源在 &eDrowned Riches&r 中。"
	]
	quest.71DE00000000001A.quest_subtitle: "第4等级已解锁。"
	quest.71DE00000000001A.title: "第一块海晶灯碎片"
	quest.79D9A7438B1DD129.quest_desc: ["先打木头。从第一棵树上获取橡木原木。"]
	quest.79D9A7438B1DD129.quest_subtitle: "你的脚下有什么东西。"
	quest.79D9A7438B1DD129.title: "可供站立的原木"
	quest.70E0000000000004.quest_desc: [
		"Powah 的核心组件，本章所有机器都需要。配方：三个 &f煤炭&r，两个用你的 &a沼泽青蛙&r 制作的 &b黏土&r，和一个熔岩桶。"
		""
		"一个配方能做出24个，所以一批就能满足这个配方要的&a4&r，甚至还有富余。"
	]
	quest.70E0000000000004.quest_subtitle: "粘土制成的门。"
	quest.70E0000000000004.title: "介电质浆料"
	quest.70E0000000000007.quest_desc: ["将一个小电容器、一个&e介电外壳&r和一个普通熔炉组合起来，就能制作出Powah的入门发电机——&eFurnator&r。它能燃烧任何熔炉燃料；用你的&a洞穴青蛙&r提供的&f煤炭&r就能持续供能。"]
	quest.70E0000000000007.quest_subtitle: "一个能制造FE而不是食物的熔炉。"
	quest.70E0000000000007.title: "熔炉制造者"
	quest.70E000000000000B.quest_desc: [
		"&e能量电池&r可在发电机和机器之间缓冲电力，防止突然的电力消耗导致机器停机。"
		""
		"奖励是&e电缆外罩&r：它们能将电缆隐藏在任意你喜欢的方块内部。"
	]
	quest.70E000000000000B.quest_subtitle: "在洒出来之前先把它存起来。"
	quest.70E000000000000B.title: "瓶装闪电"
	quest.70E000000000000E.quest_desc: ["&eEnergizing Orb&r 是 Powah 的制造台。用 &eEnergizing Rods&r 环绕它，输入 FE，并投入材料进行融合。所有非入门级的物品都需在此制造。"]
	quest.70E000000000000E.quest_subtitle: "合成，不过是带电的。"
	quest.70E000000000000E.title: "能量充盈的球体"
	quest.70E0000000000011.quest_desc: [
		"将&f铁&r和&6金&r合成为&e能量钢&r。首个配方符合本整合包的熔炉法则：手工合成资源后，&e溶解室&r即可将其分解。"
		""
		"将钢锭放入充能钢史莱姆，喂食一只&a洞穴青蛙&r，然后上交&6充能钢蛙灯&r。再也不用手动合成了。"
	]
	quest.70E0000000000011.quest_subtitle: "铁和金走进一个球体里。"
	quest.70E0000000000011.title: "充能钢"
	quest.70E0000000000014.quest_desc: [
		"这里没有铀矿石，但 Orb 会用 &b铀锭&r 制作 &b铀矿石&r。铀也没有矿石——它是 &aAll the Ores&r 金属链中靠后的环节，源自你的 &aCave frog&r（从锇奶开始，与其他洞穴金属相同的奶和蛋配方）。"
		""
		"收集铀矿，喂养球体。洞穴青蛙也能自行分裂出铀矿史莱姆；无论哪种方式，一个史莱姆就能扩大农场。上交&6铀矿蛙灯&r。"
	]
	quest.70E0000000000014.quest_subtitle: "青蛙就是铀矿所在的位置。"
	quest.70E0000000000014.title: "铀矿石"
	quest.70E0000000000017.quest_desc: [
		"Powah 的冷却剂，用于反应堆和热力学装置。球体将两个 &b蓝冰&r 压缩成 &b干冰&r，而蓝冰是 81 个 &b冰块&r 压缩两次而成——冰块来自你的 &e潮汐青蛙&r。"
		""
		"上交 &6Dry Ice Froglight&r。"
	]
	quest.70E0000000000017.quest_subtitle: "低温储存。"
	quest.70E0000000000017.title: "干冰"
	quest.70E000000000001A.quest_desc: [
		"球体将四个&c烈焰粉&r转化为一个&c烈焰水晶&r——相当于两根烈焰棒的量，来自你的&c地狱蛙&r。制作一个，装入其中，喂养地狱蛙。"
		""
		"上交 &6Blazing Froglight&r。"
	]
	quest.70E000000000001A.quest_subtitle: "粉末输入，晶体输出。"
	quest.70E000000000001A.title: "烈焰水晶"
	quest.70E000000000001D.quest_desc: [
		"用&b钻石&r做的，你的Geode青蛙可以轻松获得。史莱姆骑的是&5虚空青蛙&r，所以农场要等到Tier 6。"
		""
		"上交&6Niotic Froglight&r。"
	]
	quest.70E000000000001D.quest_subtitle: "钻石，充满能量。"
	quest.70E000000000001D.title: "Niotic 水晶"
	quest.70E0000000000020.quest_desc: [
		"用&a绿宝石&r兑换，比顶部低一级。和Niotic一样，史莱姆是&5虚空蛙&r的产物。"
		""
		"上交&6Spirited Froglight&r。"
	]
	quest.70E0000000000020.quest_subtitle: "拥有工作伦理的绿宝石。"
	quest.70E0000000000020.title: "灵性水晶"
	quest.70E0000000000023.quest_desc: [
		"Powah's ladder 的顶端。Orb 想要一个 &enether star&r、两个红石块和一块 &cBlazing Crystal&r，一次性支付 16。这里的史莱姆都骑着 &5Void frog&r。"
		""
		"上交 &6Nitro Froglight&r。"
	]
	quest.70E0000000000023.quest_subtitle: "请用钳子处理。"
	quest.70E0000000000023.title: "氮气水晶"
	quest.70E0000000000026.quest_desc: [
		"&eReactor&r 是一种由多个方块组成的机器，使用 &auraninite&r 运行，产生的 FE 远超本章的任何其他机器。这就是建造 uraninite 农场的原因。"
		""
		"建造一个&e初级反应堆&r。"
	]
	quest.70E0000000000026.quest_subtitle: "严肃的FE。"
	quest.70E0000000000026.title: "铀矿石反应堆"
	quest.70E0000000000029.quest_desc: [
		"&dFlux Dust&r 来自 Flux Networks 的仪式：&c红石&r 被放置在位于 &8基岩&r 上的 &8黑曜石&r 上。本整合包此时代的岛屿在底部中心有一个基岩方块——在出生点向下挖掘即可找到。"
		""
		"在该方块上放置黑曜石，在其上投掷红石，然后点击黑曜石将其压缩成粉末。没有基岩？用两个&8黑曜石&r和一个&c红石&r在合成网格中即可。"
		""
		"第一种尘埃为你的&c地狱蛙&r做好准备。制作&a4&r个。"
	]
	quest.70E0000000000029.quest_subtitle: "你的岛屿隐藏了一个秘密。"
	quest.70E0000000000029.title: "Flux Dust"
	quest.70E000000000002C.quest_desc: ["你手动制作了粉尘，所以密室法则已满足。将其炼制成 Flux Dust Slime，喂养你的 &cInfernal frog&r，然后上交 &6Flux Dust Froglight&r。"]
	quest.70E000000000002C.quest_subtitle: "青蛙也支持无线传输功能。"
	quest.70E000000000002C.title: "Flux on Tap"
	quest.70E0000000000031.quest_desc: [
		"Flux Networks 无需电缆即可传输能量。一个 &dFlux Controller&r 运行网络，一个 &dPlug&r 输入 FE，一个 &dPoint&r 可将其引出——任何地方，任何维度。反应堆在一个岛屿，机器在每一个其他岛屿。"
		""
		"把这三个都建造出来。"
	]
	quest.70E0000000000031.quest_subtitle: "无需电线，即可供电。"
	quest.70E0000000000031.title: "网络已激活"
	quest.7B06000000000002.quest_desc: [
		"沼泽蛙带来了沼泽的资源，每种都由前一种制成：泥土造泥，泥造陶，以此类推。"
		""
		"和之前几层一样：一个&e史莱姆牛奶&r加四个苔石、三个甜史莱姆和一瓶沼泽青蛙卵，就能合成下一个&2桶装史莱姆&r。分解掉它。"
	]
	quest.7B06000000000002.quest_subtitle: "沼泽链开启了。"
	quest.7B06000000000002.title: "超越泥土"
	quest.7B06000000000005.quest_desc: ["制作一个&b桶装泥史莱姆&r，喂养你的&a沼泽青蛙&r，并上交&6泥蛙灯&r。"]
	quest.7B06000000000005.quest_subtitle: "噗叽叽的踩水声。"
	quest.7B06000000000005.title: "泥土"
	quest.7B06000000000040.quest_desc: [
		"在没有牛奶池的情况下，会在地板上生成史莱姆。将任意&e史莱姆牛奶&r倒入盆中，就会在其周围生成对应变种的史莱姆，但牛奶会密封在方块内，不会在世界上流动放置。"
		""
		"用管道接入或手动加满。它支持水浸，可以沉入水池，而且不会消耗 boss 奶。"
	]
	quest.7B06000000000040.quest_subtitle: "不会流走的牛奶。"
	quest.7B06000000000040.title: "史莱姆牛奶盆"
	quest.7B06000000000008.quest_desc: ["制作一个&b桶装粘土史莱姆&r，喂养你的&a沼泽青蛙&r，然后上交&6粘土蛙灯&r。"]
	quest.7B06000000000008.quest_subtitle: "等待着的砖块。"
	quest.7B06000000000008.title: "粘土"
	quest.7B0600000000000B.quest_desc: ["制作一个&b桶装苔藓史莱姆&r，喂养你的&a沼泽青蛙&r，并提交&6苔藓蛙灯&r。"]
	quest.7B0600000000000B.quest_subtitle: "柔软且具有延展性。"
	quest.7B0600000000000B.title: "苔藓"
	quest.7B0600000000000E.quest_desc: ["制作一个&b桶装菌丝史莱姆&r，喂养你的&a沼泽青蛙&r，并提交&6菌丝蛙灯&r。"]
	quest.7B0600000000000E.quest_subtitle: "蘑菇地。"
	quest.7B0600000000000E.title: "菌丝体"
	quest.7B06000000000011.quest_desc: ["制作一个&b桶装睡莲史莱姆&r，喂养你的&a沼泽青蛙&r，并提交&6睡莲蛙灯&r。"]
	quest.7B06000000000011.quest_subtitle: "青蛙最喜欢的座位。"
	quest.7B06000000000011.title: "睡莲叶"
	quest.7B06000000000034.quest_desc: [
		"右键点击放置的 &a睡莲&r，并使用 &d甜史莱姆&r，即可制作出 &a甜史莱姆睡莲&r。最近的青蛙会走过来并栖息在上面——每片睡莲一只青蛙——并且会待在原地，不再四处游荡。"
		""
		"它会不断吃掉范围内的史莱姆，并当场掉落&6Froglights&r。将其置于漏斗上方，旁边是&eSlime Milk&r池，即可自动收集。打破踏板即可释放青蛙。"
	]
	quest.7B06000000000034.quest_subtitle: "栓住一只青蛙，不要拴绳。"
	quest.7B06000000000034.title: "一个青蛙栖息地"
	quest.7B06000000000014.quest_desc: ["制作一个&b桶装皮革史莱姆&r，喂养你的&a沼泽青蛙&r，然后上交&6皮革蛙灯&r。"]
	quest.7B06000000000014.quest_subtitle: "不需要奶牛。"
	quest.7B06000000000014.title: "皮革"
	quest.7B06000000000017.quest_desc: ["制作一个&b桶装羽毛史莱姆&r，喂养你的&a沼泽青蛙&r，然后上交&6羽毛蛙灯&r。"]
	quest.7B06000000000017.quest_subtitle: "也没有小鸡。"
	quest.7B06000000000017.title: "羽毛"
	quest.7B0600000000001A.quest_desc: [
		"&f塑料&r来自你的&e睡莲奶&r：熔炼塑料&6蛙灯&r即可。该整合包移除了工业先行者原版塑料配方（熔炼干橡胶），因此这种青蛙是包内塑料的&l唯一&r来源。"
		""
		"Industrial Foregoing 的机器需要塑料来建造，所以没有 Bog frog 就无法推进该模组。"
	]
	quest.7B0600000000001A.quest_subtitle: "史莱姆，精炼版。"
	quest.7B0600000000001A.title: "塑料"
	quest.7B0600000000001D.quest_desc: [
		"&dPink Slime&r 是最后一个沼泽资源，由你的 &eplastic milk&r 制成。熔炼 &6Froglight&r 可获得 Industrial Foregoing 的粉色史莱姆。"
		""
		"奖励是一套完整的二阶机器附加组件 - &b速度&r、&a效率&r和&e处理&r，用于调整你的 Industrial Foregoing 机器。"
	]
	quest.7B0600000000001D.quest_subtitle: "沼泽的奖品。"
	quest.7B0600000000001D.title: "粉色史莱姆"
