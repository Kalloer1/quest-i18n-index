	chapter_group.58A44FB6781AFC03.title: "提示"
	quest.14EB7346131ED3ED.quest_desc: ["用水车或风车创造旋转动力。不必建一个巨大的工厂。只要它转起来，你就成功了。"]
	quest.14EB7346131ED3ED.title: "旋转动力装置"
	quest.1535725BFF7F089F.quest_desc: ["建造一个小商店、摊位或服务窗口，并挂上牌子，无论你是否已经开始销售商品。"]
	quest.1535725BFF7F089F.title: "带牌子的商店"
	quest.21FAEB703BCCB2BC.quest_desc: ["贡献一些石头、木头、玻璃、铁、安山岩合金或其他社区建造所需的材料。"]
	quest.21FAEB703BCCB2BC.title: "材料捐赠任务书文本"
	quest.230CDE7D4ED4D6F3.quest_desc: ["如果经济循环围绕食物、装饰、建材和交通便利展开，而非稀有装备，服务器经济会感觉更好更持久。"]
	quest.230CDE7D4ED4D6F3.title: "价格标签礼仪"
	quest.23E0267E295CA8D3.quest_desc: ["承接中央车站项目的一部分：场地、轨道、站台、指示牌或附近的商店。"]
	quest.23E0267E295CA8D3.title: "中央车站项目"
	quest.2402AABC11A06E51.quest_desc: ["收集适合车站、市场街道、温室和路灯的玻璃和照明材料。"]
	quest.2402AABC11A06E51.title: "玻璃和照明"
	quest.24D424DE7F64B839.quest_desc: ["如果有商人或商店，四处看看，了解价格。如果没有，想象一下他们之后可能会去哪里。"]
	quest.24D424DE7F64B839.title: "前往市场街 (Market Street) 逛逛吧"
	quest.256C6CD713B6BF8B.quest_desc: [
		"铁厂的红石链接需要铁锭，木厂的红石链接需要木头，..."
		"嗯，这个工厂该用什么物品来设置红石链接频率呢？"
		"试试这个。在空中右键以设置字母或特殊符号图标。"
	]
	quest.256C6CD713B6BF8B.title: "制作符号"
	quest.28816C3EC548A0C7.quest_desc: ["与其他玩家或服务器商店买卖一件小物品。食物、装饰品和铁路材料都是不错的选择。"]
	quest.28816C3EC548A0C7.title: "首次交易"
	quest.2A94763C580C3F97.quest_desc: ["在中央村庄、市场街和未来车站等共享区域走动，感受服务器的氛围。"]
	quest.2A94763C580C3F97.title: "第一次漫步小镇"
	quest.2C7AAC7F5DD010DC.quest_desc: ["选择一个你喜欢的地方，比如河边、山丘上，或者规划好的铁路附近，并在那里留下一个小标记。"]
	quest.2C7AAC7F5DD010DC.title: "选择一个家园地点"
	quest.2CF255D82C3D0978.quest_desc: ["在共享存储中分享少量多余的种子、木材、石头、食物或其他低压物资。"]
	quest.2CF255D82C3D0978.title: "首次共享存储捐赠任务"
	quest.2D82F029C414444B.quest_desc: ["此任务书并非强制进度。仅为服务器生活建议路线，只做你感兴趣的部分即可。"]
	quest.2D82F029C414444B.title: "任务书只是一张路线图而已"
	quest.2EE80A0E96C9F22D.quest_desc: ["连接传动轴和齿轮，然后观察旋转动力是如何流动的。"]
	quest.2EE80A0E96C9F22D.title: "齿轮与传动轴"
	quest.2FADC1632E89FE6A.quest_desc: ["旋转速度和剩余应力一目了然！"]
	quest.302943D82A47F0F7.title: "建造一个木材加工厂"
	quest.36CBC87EF7B5D4A7.quest_desc: ["建造一个小农场，既能提供食物又能美化村庄。自动化可以等以后再弄。"]
	quest.36CBC87EF7B5D4A7.title: "小型农田"
	quest.3A351D162F3BF6E2.quest_desc: ["绘制一张城镇周边的地图，或在共享地图上添加实用信息。对于容易迷路的人来说，这是完美的礼物。"]
	quest.3A351D162F3BF6E2.title: "一张单独的地图"
	quest.3E6A900F2D83BCBC.quest_desc: [
		"你旅行的时候会随身携带床吗？"
		"不如试试带上睡袋吧。"
		"你睡一觉后，它就会自动回到你身边。"
		"还能防止你的出生点被搞乱。"
		"不过，睡袋和床不同，无法设置你的重生点。"
	]
	quest.3E6A900F2D83BCBC.title: "制作一个睡袋 (Sleeping Bag)"
	quest.3FCBA3A66424D8F6.quest_desc: ["想象一条连接农场、矿井、工坊和商店的小型货运路线。如果能亲自运营就更好了。"]
	quest.3FCBA3A66424D8F6.title: "小型货运车厢"
	quest.43E76A72DF7AFC67.quest_desc: ["展示你从旅行中带回来的东西，比如稀有花朵、树苗、装饰方块、唱片或地图碎片。"]
	quest.43E76A72DF7AFC67.title: "旅行纪念品"
	quest.451F7FE7E2D54ED1.quest_desc: ["建筑服务器总是需要木材。贡献原木、木板、栅栏、楼梯，或者其他有用的东西。"]
	quest.451F7FE7E2D54ED1.title: "木材运送任务"
	quest.480BB91ECCD8E8E8.quest_desc: ["制作并佩戴护目镜。它能显示关于创造组件的额外信息。"]
	quest.4E8E1C22454D296E.quest_desc: ["向共享工坊或铁路项目贡献安山合金、传动轴和齿轮等基本创造部件。"]
	quest.4E8E1C22454D296E.title: "基础创造材料交付任务"
	quest.54795F0341FD6AC9.quest_desc: ["为铁路扩建贡献物资，例如铁轨、枕木式方块或车站装饰材料。"]
	quest.54795F0341FD6AC9.title: "铁路补给品"
	quest.55B6C7DE9C158127.quest_desc: ["添加一个可供人们经过的共享广场细节，例如长椅、水井、公告板或小花园。"]
	quest.55B6C7DE9C158127.title: "中央广场"
	quest.57E31749DE3C0E7A.quest_desc: ["规划或建造一条通往另一个家、城镇边缘、探索前哨或风景点的铁路线。"]
	quest.57E31749DE3C0E7A.title: "前往下一站"
	quest.58B517AA73C37C72.quest_desc: ["选择一个火车名称、目的地、方向标志或时刻表。铁路一旦有了信息，就会显得生机勃勃。"]
	quest.58B517AA73C37C72.title: "时刻表和目的地"
	quest.5CF713ED40D61E7E.quest_desc: ["自己铺设一些轨道，哪怕很短。城镇里的迷你轨道、工坊连接或测试铁路都算数。"]
	quest.5CF713ED40D61E7E.title: "第一轨道"
	quest.5D010440508DE579.quest_desc: ["找到一个显著的结构，如村庄、矿井、遗迹或地牢，然后留下坐标或方向。"]
	quest.5D010440508DE579.title: "结构访问日志"
	quest.5DF7D742569FF7A0.quest_desc: ["这是一个将面包、小麦、土豆或胡萝卜等基本食物存入共享存储或商店的示例交付任务。"]
	quest.5DF7D742569FF7A0.title: "面包和食物配送任务书"
	quest.5E9BDFE9287C2A6F.quest_desc: ["用标签、排序、容器、装饰或其他任何能简化操作的东西来改善共享存储。"]
	quest.5E9BDFE9287C2A6F.title: "改进共享存储系统"
	quest.5EA32CC3DBB8F168.quest_desc: ["在房子周围或村庄小径上添加灯笼、火把、栅栏或其他安全设施。"]
	quest.5EA32CC3DBB8F168.title: "点亮夜间的道路"
	quest.5F0AEBCF79718A87.quest_desc: ["多人服务器的和平始于一张床。在出生点附近或你自己的家中，设置一个可以睡觉的地方。"]
	quest.5F0AEBCF79718A87.title: "第一张床 First Bed"
	quest.60E51B6B2A459216.quest_desc: ["建造能为村庄增添故事性的建筑，例如磨坊、铁匠铺、咖啡馆、钓鱼点或小温室。"]
	quest.60E51B6B2A459216.title: "一个主题建筑"
	quest.6365DA31713A48D1.quest_desc: ["在完工的社区建筑上留下名字、日期或简短的笔记。服务器的历史就是这样积累起来的。"]
	quest.6365DA31713A48D1.title: "纪念性标记"
	quest.66FADED6F96CF300.quest_desc: ["改善房屋的一个部分，如屋顶、窗户、烟囱或入口，使其与村庄自然融合。"]
	quest.66FADED6F96CF300.title: "为您的房屋增添一些特色"
	quest.673023461E0B9AA5.quest_desc: ["了解基本的 Create: Numismatics 物品和货币流通。本服务器的货币仅用于方便交易的小点缀。"]
	quest.673023461E0B9AA5.title: "货币指南"
	quest.6C9B85749DA96779.quest_desc: ["完成一个小型的创造工坊，包含动力、加工机器、存储和制作区。"]
	quest.6C9B85749DA96779.title: "完成一个小型工作室"
	quest.6E92A0A647424DD2.quest_desc: ["用传送带移动物品，你很快就会明白为什么创造很有趣。从小处着手，保持整洁。"]
	quest.6E92A0A647424DD2.title: "一条腰带线"
	quest.6EA2701ED8885776.quest_desc: ["在房子前或村庄小巷里添加路径、围栏或路灯。小细节能营造服务器的氛围。"]
	quest.6EA2701ED8885776.title: "道路和路灯"
	quest.6F8437ACFA1D888D.quest_desc: ["哪怕只有几格宽的站台也算数。加上告示牌和照明，已经有车站的感觉了。"]
	quest.6F8437ACFA1D888D.title: "小型平台"
	quest.70B5A39CED0E44D4.quest_desc: ["领取少量货币作为欢迎礼物。金钱并非目的，只是为了让商店和交易更顺畅。"]
	quest.70B5A39CED0E44D4.title: "小型定居点补助金"
	quest.72FD7788D20A21C5.quest_desc: ["去一个你还没见过的生物群系，并记录任何你喜欢的自然材料或截图地点。"]
	quest.72FD7788D20A21C5.title: "陌生的生物群系"
	quest.799BB64CFA30EE68.quest_desc: ["决定你想卖什么，价格，如何补货，以及商店的外观。不必是一个巨大的自动化商店。"]
	quest.799BB64CFA30EE68.title: "准备我的商店"
	quest.7B38CC0443795C65.quest_desc: ["为这台压印机供水，每次只压制一套。"]
	quest.7E45914A6803EF41.quest_desc: ["用一台压碎机和一台储存箱制作第一条处理线。"]
	quest.7E45914A6803EF41.title: "按压和存放物品"
	quest.7E7F4EA2F0C75880.quest_desc: ["让下界传送门周围更安全，或在共享下界路线上添加告示牌和照明。"]
	quest.7E7F4EA2F0C75880.title: "下界通道"
	quest.7E8F4B886AA841F6.quest_desc: ["在公告板上留下下一个共建项目的想法：港口、市场、观光铁路、公园、温泉、瞭望台等等。"]
	quest.7E8F4B886AA841F6.title: "Suggest the Next Project"
