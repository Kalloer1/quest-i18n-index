		}
		{
			dependencies: ["31B7D924845F50DE"]
			description: [
				"Un serpent géant rapide qui charge en brisant les blocs sur son passage. À chaque coup reçu, il perd des segments et devient plus rapide."
				""
				"Utilisez des armes à distance ou de mêlée pour l'attaquer en esquivant ses charges."
				"越小就越快，所以保持移动状态很重要！"
			]
			id: "34795F1FA667C798"
			tasks: [{
				id: "05673C6D49568CA1"
				item: "twilightforest:naga_trophy"
				type: "item"
			}]
			x: -1.5d
			y: -2.0d
		}
		{
			dependencies: ["34795F1FA667C798"]
			description: [
				"Un nécromancien invoquant des clones et lançant des projectiles magiques. Il est protégé par des boucliers au début du combat."
				""
				"Renvoie ses projectiles avec ton épée pour briser ses boucliers."
				"Une fois vulnérable, attaque-le en mêlée et élimine ses clones."
			]
			id: "752096CCB84E8889"
			tasks: [{
				id: "1B75C9319442D3F2"
				item: "twilightforest:lich_trophy"
				type: "item"
			}]
			x: 0.0d
			y: -2.0d
		}
		{
			dependencies: ["752096CCB84E8889"]
			description: [
				"一种混合突变牛，会用斧头攻击并猛烈冲撞。它存在于地下迷宫中。"
				""
				"躲避它的冲撞，并在两次攻击之间对它进行打击。"
				"Utilisez des armes puissantes et des armures solides pour encaisser ses coups."
			]
			id: "7CFDD57D5E733BC3"
			tasks: [{
				id: "0215F94B10217439"
				item: "twilightforest:minoshroom_trophy"
				type: "item"
			}]
			x: 2.0d
			y: -2.0d
		}
		{
			dependencies: ["7CFDD57D5E733BC3"]
			description: [
				"Un dragon à plusieurs têtes qui crache du feu et des explosions. Si une tête est coupée trop tôt, deux repoussent à sa place !"
				""
				"等待有人开口说话再发起攻击。"
				"使用强大的武器来快速造成伤害。"
				"保持移动，躲避它的火焰和爆炸。"
			]
			id: "65C7AAEC5E1FCD04"
