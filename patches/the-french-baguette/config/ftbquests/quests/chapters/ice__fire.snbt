	quest_links: [ ]
	quests: [
		{
			description: ["Le Dragon Foudre est le dragon le plus récent (vous pouvez probablement remarquer que le mod se limite à glace et feu). Il est nocturne, il sera actif la nuit pour chasser et dormira pendant la journée. Il dort debout, ce qui peut dérouter ceux qui n'ont pas lu les quêtes."]
			id: "7B845E005103666D"
			tasks: [{
				id: "76788D4333492E52"
				title: "龙之闪电"
				type: "checkmark"
			}]
			x: 2.0d
			y: -6.0d
		}
		{
			description: ["冰龙也是最初的两条龙之一。可能是最难对付的一条。它们的冰冻吐息会把你定住。"]
			id: "7F097BBC5A73DE2E"
			tasks: [{
				id: "676EC1B972578AFB"
				title: "冰霜巨龙"
				type: "checkmark"
			}]
			x: 4.0d
			y: -4.0d
		}
		{
			description: ["独眼巨人住在像派大星家一样的岩石里。你会发现巨大的岩石，里面装满了绵羊、骨头和金堆。独眼巨人就在那里。"]
			id: "464A75578FB0D567"
			tasks: [{
				id: "7E42D4E29F99C98A"
				title: "独眼巨人"
				type: "checkmark"
			}]
			x: -3.0d
			y: 1.0d
		}
		{
			description: ["Vous ne trouverez pas les fantômes, ce sont eux qui vous trouveront ! En traversant les vallées de sable des âmes, vous serez hanté, et croyez-moi, vous le remarquerez quand vous serez hanté."]
			id: "6662574F06722053"
			tasks: [{
				id: "314E0A19F3648F3D"
				title: "幽灵"
				type: "checkmark"
			}]
			x: -3.0d
			y: 3.0d
		}
		{
			description: ["Les Myrmex sont des insectes semblables à des fourmis qui vivent dans l'Autre. Ils ont différents rôles : ouvrier, soldat, sentinelle, jusqu'à la Reine."]
			id: "5A3D89D2DF6894A6"
			tasks: [{
				id: "595E2F2C54215209"
				title: "Myrmex"
				type: "checkmark"
			}]
			x: -4.0d
			y: 2.0d
		}
		{
			description: ["九头蛇栖息在山地边缘生物群系的小草丘上。它们因大量藤蔓而容易辨认。通常含有成堆的铁和骷髅头骨。"]
			id: "4ED6200BB9B9A664"
			rewards: [{
				id: "108DAB966D880E75"
				item: {
					Count: 1
					id: "minecraft:flint_and_steel"
					tag: {
						Damage: 0
					}
				}
				type: "item"
			}]
			tasks: [{
				id: "77EDF47E0F4DCB0E"
				title: "九头蛇"
				type: "checkmark"
			}]
			x: -2.0d
			y: 2.0d
		}
		{
			description: ["龙有5个不同的阶段（年龄）。这会改变它们的生命值、攻击方式和掉落物。"]
			id: "637D2D362CDBC76D"
			rewards: [{
				id: "6109A82312099B65"
				type: "xp_levels"
				xp_levels: 5
			}]
			tasks: [{
				id: "027AE80F1C8B7FCF"
				type: "checkmark"
			}]
			title: "龙的各个阶段步骤"
			x: -4.5d
			y: -2.5d
		}
		{
			dependencies: ["637D2D362CDBC76D"]
			description: ["第3阶段汇集了地表最强大的龙。它们的生命值要高得多，大约在5000到7000颗心之间。体型比史蒂夫大，它们能施展的攻击也比前几阶段的龙要多得多。"]
			id: "65CA22A959F4104C"
			tasks: [{
				id: "4A0A34BBB7131C48"
				title: "第三阶段"
				type: "checkmark"
			}]
			x: -4.5d
			y: -3.5d
		}
		{
			dependencies: ["637D2D362CDBC76D"]
			description: ["第2阶段是幼龙的初级阶段。它们体型略大，巢穴也更宏伟。生命值更高，从3k到5k颗心。它们的防御力也比第1阶段好得多。"]
			id: "41C55D4F75CC41C5"
			tasks: [{
				id: "13EAEAB777FB9D83"
				title: "第二阶段"
				type: "checkmark"
			}]
			x: -5.5d
			y: -3.5d
		}
		{
			dependencies: ["637D2D362CDBC76D"]
			description: ["一阶段的龙只是幼崽。它们的生命值最低，大约1000颗心。它们体型更小，掉落物也更少。它们的巢穴也会更小。"]
			id: "7E85C3D69176A356"
			tasks: [{
				id: "724DD3C04EDB011C"
				title: "第一阶段"
				type: "checkmark"
			}]
			x: -6.5d
			y: -3.5d
		}
		{
			dependencies: ["637D2D362CDBC76D"]
			description: ["四阶龙可以说是成年龙。它们生活在地下深处（Y 30左右）的洞穴里。四阶龙还会掉落孵化自己幼龙的龙蛋。它们的生命值要高得多，从10k到20k颗心不等。"]
			id: "5875F1DBB79066B9"
			tasks: [{
				id: "14F1224359DDE3B2"
				title: "第四阶段"
				type: "checkmark"
			}]
			x: -3.5d
			y: -3.5d
		}
		{
			dependencies: ["637D2D362CDBC76D"]
			description: ["第5阶段的龙是游戏中最强大的。它们也是最大的，生命值超过20000颗心。体型更大意味着更多的洞穴，因此也意味着更多的战利品。"]
			id: "718984A93343009D"
