	quest.76F14C2B866B4EAD.title: "前往另一个世界 (The Otherside)"
	quest.77814DAB91725098.quest_desc: ["Minecraft 的海洋纪念碑是深海生物群系中巨大的水下结构，可通过制图师村民的深海探索者地图找到。"]
	quest.77814DAB91725098.title: "找到一个 &bMonument&r"
	quest.7796359B0F6A6606.quest_desc: ["基础&6背包&r有27个储物格，可容纳1个升级"]
	quest.7796359B0F6A6606.quest_subtitle: "随时随地存放物品的便捷方式"
	quest.779BDC14D8FF6F70.quest_subtitle: "混沌君主掉落物品"
	quest.77D27EBADB5E4458.quest_subtitle: "在末地的深处被发现"
	quest.77EADA3D4C8F5EF1.quest_desc: ["猪灵统治着绯红森林，守护着下界的宝藏。它们的贪婪与凶猛成正比。不要心慈手软。"]
	quest.77EADA3D4C8F5EF1.quest_subtitle: "贪婪的掠夺者"
	quest.77F958F43649A746.quest_desc: ["要塞是含有末地传送门的地下结构，通过追踪投掷到空中的末影之眼，当它们向下飞行时，就表示你应该向下挖掘。"]
	quest.77F958F43649A746.quest_subtitle: "你需要一双眼睛才能看见前方的路"
	quest.77F958F43649A746.title: "找到要塞 (Locate the Stronghold)"
	quest.77FB064296CB5CE8.quest_subtitle: "在决定废弃什么以及如何废弃时，要更果断一些"
	quest.78BCED8699ADEDF4.quest_desc: ["将灵魂粉尘与玻璃相结合。"]
	quest.78BCED8699ADEDF4.quest_subtitle: "它能像羊毛一样减弱声音。"
	quest.78D47E13F77F3239.quest_desc: [
		"末地是一个黑暗、类似太空的维度，由虚空中的独立岛屿组成，岛屿由末地石构成。这里居住着末影人和潜行者。"
		""
		"末影龙也会在玩家初次抵达时生成。"
		""
		"末影龙是一种巨大的飞行敌对首领生物，首次进入末地时会出现。"
		""
		"{@pagebreak}"
		""
		"她是游戏中自然生成的体型最大的生物。"
		""
		"除了返回主世界的出口传送门和进入《我的世界》片尾字幕的入口外，她还守卫着通往外围末地岛屿的末地传送门。"
		""
		"因此，她被大多数人称为游戏中的“最终首领”。"
		""
		"她的攻击包括冲向玩家和独特的龙酸攻击。"
	]
	quest.78D47E13F77F3239.title: "进入&e末地&r"
	quest.79859846C0DCFF9A.quest_desc: ["强力胶水可将机械结构粘合在一起。右键单击一个区域以开始选择。潜行点击或滚动以取消胶水，从而取消选择。右键单击通过其他方块连接的第二个方块以完成选择。"]
	quest.79859846C0DCFF9A.title: "合成 &2强力胶水"
	quest.798F238545BE13C3.title: "战士的秘制药水"
	quest.79EB51ACC5624106.quest_desc: ["在绯红森林中击杀枯萎恶魔可获得"]
	quest.7A39A5B9E3CAC840.quest_desc: ["要从&6bottle o' enchanting&r中获取液体经验，你需要物品排水器，它在吸干经验后会返还瓶子给你"]
	quest.7A39A5B9E3CAC840.quest_subtitle: "偷走珍贵的经验值液体"
	quest.7A7D2F284E6CC276.quest_desc: ["凋零被击败后，下一个挑战就在虚空之中：末影龙。"]
	quest.7A7D2F284E6CC276.quest_subtitle: "下界之外"
	quest.7A909673AC28A50F.title: "你回来了！"
