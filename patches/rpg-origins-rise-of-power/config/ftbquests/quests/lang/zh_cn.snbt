	quest.27D1011D260DE6D7.quest_subtitle: "背包重新装满时要更挑剔一些"
	quest.27E206948965351D.quest_desc: [
		""
		""
		"Create 是一款提供多种用于建筑、装饰和美学自动化工具和方块儿的模组。"
		""
		"新增的科技元素旨在为玩家提供尽可能多的设计选择。在 Create 中，游戏并非在一大堆UI中进行，而是挑战你用各种可能的组合，搭建由动态组件协同工作的装置。"
	]
	quest.27E206948965351D.quest_subtitle: "&6&l欢迎来到创造模式！"
	quest.27E68E31EC21675B.quest_subtitle: "&aGantry Carriages&r 会沿着 &aGantry Shafts&r 移动，并且会同时移动任何附着在其上的方块或结构。"
	quest.27F072FB6AEEC496.quest_desc: [
		"信标是一种向上投射光线的方块，放置在由铁、金、钻石、绿宝石或下界合金方块构成的实心金字塔底座上时，能为周围一定范围内的玩家提供有益的状态效果。"
		""
		"信标需要无遮挡的天空视野。"
		""
		"{@pagebreak}"
		""
		"透明方块（玻璃、水、半砖等）和基岩（下界天花板）是允许的。"
		""
		"信标建在一个由铁块、金块、绿宝石块、钻石块和/或下界合金块构成的金字塔顶部。"
		""
		"金字塔是激活信标的必要结构。金字塔有四种可能的高度。金字塔层级越高，在更广泛的区域内能使用的力量就越多。"
	]
	quest.27F072FB6AEEC496.quest_subtitle: "使用它来获得强大的效果"
	quest.27FE80664E75A40D.quest_desc: ["在火车系统中有一个&6红色座位&r会很有用，尤其是在火车控制台旁边，这样你就可以把一个生物放到火车上，然后这个生物就能控制火车的移动了"]
	quest.27FE80664E75A40D.quest_subtitle: "火车上可以坐的座位"
	quest.27FE80664E75A40D.title: "座位"
	quest.28894A6E8BD319CD.quest_subtitle: "可用于排空或填充任何大面积的液体。若用于足够大的岩浆池，会将其视为无限岩浆源。很方便！"
