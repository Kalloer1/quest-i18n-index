	quest.4C7FC001B0BE6404.quest_desc: [
		"时候到了。直面烈焰暴君，终结他对下界的火焰统治。"
		""
		"他不住在堡垒或神殿中：烈焰暴君会自由地出现在下界的燃烧天空中。"
		""
		"他是一个巨型的大规模毁灭型Boss变种，比普通烈焰人高大得多，被火焰风暴包围，并带有发光的名称牌和Boss生命条。"
		""
		"在堡垒和熔岩海洋附近的下界天空中搜寻，直到他的火焰点燃地平线。只有拥有火焰抗性和钻石武器的最强冒险者才能承受他的怒火。"
	]
	quest.4C7FC001B0BE6404.quest_subtitle: "烈焰暴君"
	quest.4CA1341730713881.quest_desc: ["当靴子穿戴时，会缓慢恢复佩戴者的饥饿值。在进食的地方，植物也会随之生长。"]
	quest.4CA5A79AAB5F1717.quest_subtitle: "石匠工作台（The stone workers table）"
