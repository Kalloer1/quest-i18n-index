	quests: [
		{
			title: "Mekanism"
			x: 3.5d
			y: -3.5d
			shape: "gear"
			description: [
				"Mekanism 是一款科幻主题的极限科技模组，专注于提高效率，无论是矿石产量、先进核聚变反应堆，还是为您的基地供电。"
				""
				"该系统力求在保持一定真实性的同时，做出妥协以提升游戏体验。在模组中，玩家需要掌握电力生成、管理热量和辐射，同时寻找最高效的路线。"
				""
				"除了这些任务，游戏内没有关于Mekanism的指南。不过，你可以在这里找到非常详尽的官方维基："
				""
				"https://wiki.aidancbrady.com"
				""
				"&e~哑巴的魅魔（MuteTiefling）"
			]
			id: "00000000000006A1"
			tasks: [{
				id: "00000000000006A2"
				type: "checkmark"
				icon: "mekanism:teleportation_core"
			}]
			rewards: [{
				id: "0000000000000CAE"
				type: "xp"
				xp: 100
			}]
		}
		{
			title: "材料加工"
			icon: "mekanism:alloy_infused"
			x: 1.5d
			y: -1.5d
			description: [
				"如前所述，Mekanism 始终注重效率。随着机器的升级和更多系统的加入，它们会变得更高效、更高产，运营成本也更低。"
				""
				"从一开始就注重效率，最终会在长远来看有所回报。"
			]
			dependencies: ["00000000000006A1"]
			id: "00000000000006A5"
			tasks: [{
				id: "00000000000006A6"
				type: "checkmark"
			}]
