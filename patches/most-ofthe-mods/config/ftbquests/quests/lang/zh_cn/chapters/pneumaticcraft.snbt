	quest.7395B41685F4BC1A.title: "来自力量的压力"
	quest.74015945716FD10A.quest_desc: ["这个&3全向漏斗&r可以从任意一侧输入物品，而且还能升级得比普通漏斗快得多！在不需要管道的时候用着很方便。"]
	quest.74015945716FD10A.quest_subtitle: "一个可配置的漏斗式收集器"
