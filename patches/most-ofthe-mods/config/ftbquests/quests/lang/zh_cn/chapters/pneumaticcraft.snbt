	quest.65E2AF881709C896.title: "加固石"
	quest.6674270897997BF7.quest_desc: ["能让你跳得比平时更高，更有弹性，从而加快旅行速度。\\n\\n腿部护甲上同一时间只能有一个等级的此类升级。"]
	quest.6674270897997BF7.quest_subtitle: "最大值：1"
	quest.681A3F31FB242555.quest_desc: ["乙醇&3可以用来制作生物柴油&r。"]
	quest.681A3F31FB242555.title: "乙醇"
	quest.68F92455A9483AD6.quest_desc: ["只有使用过喷射靴时才会看到这个任务。\\n\\n使用喷射靴时无法避免受到伤害，不要尝试了..."]
	quest.68F92455A9483AD6.quest_subtitle: "你以为用鞘翅很难吗？"
