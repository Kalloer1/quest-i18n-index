# AI 初翻，未人工校对
{
	quest.08B60D8A25008CCC.quest_desc: ["此任务由 &6AllTheMods Staff&r 或 &2社区贡献者&r 为 AllTheMods 整合包创作。 \\n\\n由于所有 &6AllTheMods&r 整合包均受 &eAll Rights Reserved&r 许可，未经明确许可，不得将此任务用于非 &6AllTheMods Team&r 发布的任何公共整合包中。 \\n\\n此任务被有意隐藏，若你看到此信息，则表示你处于编辑模式。"]
	quest.08D1CC753F6B4283.quest_desc: ["在 Warden 之前，远古守卫者被认为是 Minecraft 的第三个 Boss，但我认为他是个迷你 Boss。 \\n\\n远古守卫者会生成在海洋纪念碑中。那里会生成三只，它们会给附近的任何人施加挖掘疲劳。 \\n\\n如果你想得到海洋纪念碑的宝藏，就需要找到并杀死它们！(提示：我通常在顶层房间、最左侧和最右侧各找到一个！) \\n\\n它们有 80 点生命值，攻击方式和普通守卫者一样，激光和尖刺！ \\n\\n死亡时会掉落：海绵、海晶灯，还有它们的午餐……"]
	quest.08D1CC753F6B4283.title: "击杀一只远古守卫者"
	quest.09C82CDDA800D8C9.quest_desc: ["凋零是第二个Minecraft Boss，这个更具选择性。 \\n\\n你需要建造凋零来召唤他。用4个灵魂沙摆成T形，并在顶部放置3个凋零骷髅头即可召唤！ \\n\\n他有300点生命，会四处飞行并向玩家或生物发射凋零骷髅头。 \\n\\n当生命值减半时，他会获得一个抵御投射物的护盾，需要用剑或斧头才能击败他。 \\n\\n击败他后，他会掉落：下界之星、可能掉落凋零灵魂，以及大量珊瑚物品。"]
	quest.09C82CDDA800D8C9.title: "击杀凋零（The Wither）"
	quest.0E20A9B79D1C6637.quest_desc: ["卫道士是1.20版本新增的boss。\\n\\n当3个自然生成的潜声尖叫者连续触发，或在首个卫道士生成后任何尖叫者触发，它就会出现。\\n\\n它是Minecraft中最强大的生物，拥有500点生命值，攻击可造成超过20点伤害。\\n\\n它的攻击包括近战和针对远处目标的声纳冲击波。\\n\\n它唯一的弱点是盲目，但就像冒险家一样，这反而让它其他感官变得更强！靠近时它能闻到你的气味，小心发出噪音！\\n\\n如果你成功击败它，它会掉落：潜声催化剂、卫道士甲壳和深海之心。"]
	quest.0E20A9B79D1C6637.title: "击杀卫道士 (The Warden)"
	quest.0F55D0B4D5094EDB.quest_desc: ["在制作 ATM7 的许多任务线时，商人村民觉得在任务界面里不停地推来推去会很有趣。\\n\\n“干掉他们。全部干掉。”\\n\\n- AlfredGG \\n\\n“我附议！” \\n\\n- Toshiba"]
	quest.0F55D0B4D5094EDB.quest_subtitle: "“这是私事” - AlfredGG"
	quest.0F55D0B4D5094EDB.title: "杀死商人村民和他烦人的羊驼们"
	quest.13BB75A7E1973488.quest_desc: ["月之怪物是永恒星光中添加的第一个Boss。 \\n\\n他住在诅咒花园的中央，祝你好运能找到并击败他！"]
	quest.13BB75A7E1973488.title: "击杀月球上的怪物（Kill The Lunar Monstrosity）"
	quest.17F3AC15ADCFB175.title: "&l&9末地悬赏：&r&e末影人"
	quest.199932BF623A6785.quest_desc: ["被遗忘的守护者（The Forgotten Guardian）是地下花园（Undergarden）的领主。 \\n\\n他安息在墓穴结构（Catacomb Structure）中。"]
	quest.199932BF623A6785.title: "击杀被遗忘的守护者 (Kill The Forgotten Guardian)"
	quest.1F18B64C84C8809D.title: "&l&9主世界悬赏：&r&e 蜘蛛"
	quest.1F31EBF49079F9D3.quest_desc: ["Overhauled Creepers 为我们带来了适合不同生物群系的多种苦力怕变种。 \\n\\n每种都有不同的掉落物，甚至有些还很友好！ \\n\\n不过它们都怕猫……"]
	quest.1F31EBF49079F9D3.title: "全面重制的苦力怕模组"
	quest.2001998045ABC04C.quest_desc: ["Tangled Hatred 是 Eternal Starlight 中的一个迷你首领。 \\n\\n它会和 Lunar Monstrosity 一同出现在 Cursed Gardens 中。"]
	quest.2001998045ABC04C.title: "杀死一个纠缠的憎恶生物"
	quest.2B05A29C62676EB2.title: "&l&9主世界悬赏：&r&e 僵尸"
	quest.2BD077EFE77B8EBB.quest_desc: ["僵尸有不同的变种，会生成在其他生物群系中。 \\n\\nHusks- 生成于沙漠。 \\nDrowned- 生成于水下。 \\nGelid- 生成于寒冷生物群系。 \\nThickets- 生成于丛林。"]
	quest.2BD077EFE77B8EBB.title: "僵尸变种生物"
	quest.2CA9394459C24012.quest_desc: ["腐化生物是遍布整个地下花园的小头目。"]
	quest.2CA9394459C24012.title: "杀死一只腐化生物"
	quest.3371F9248D403664.title: "&l&c下界悬赏：&r&e凋零骷髅"
	quest.3813F5C1760C3A79.quest_desc: ["猪灵暴徒出现在这里可能会引起争议，但我把它们看作迷你Boss。 \\n\\n它们和普通的猪灵一起生成在堡垒中，但它们是敌对的，而非中立的。我个人讨厌这一点，尤其是如果你攻击它们，所有猪灵都会对你产生敌意。 \\n\\n它们有50点生命值和一把用来攻击你的金斧头。通常金斧头几乎不造成任何伤害，但当它们使用时，不知为何威力惊人！ \\n\\n它们不掉落任何东西，更像是堡垒中的一个障碍物！"]
	quest.3813F5C1760C3A79.title: "杀死一个猪灵壮汉"
	quest.41C0948CD9D50322.quest_desc: ["在这里你可以找到所有通过击败敌人获得的奖励。"]
	quest.41C0948CD9D50322.quest_subtitle: "杀死所有生物（Killing All The Things）"
	quest.41C0948CD9D50322.title: "悬赏公告板"
	quest.42822B1E8A53D051.title: "&l&9主世界悬赏：&r&e骷髅"
	quest.56DA46DC82F6665D.quest_desc: ["Wilden Chimera 是由 Ars Nouveau 添加的 Boss，是推进该整合包所必需的。 \\n\\n你需要通过仪式召唤它，然后与它战斗！"]
	quest.56DA46DC82F6665D.title: "击杀野性奇美拉 (Kill The Wilden Chimera)"
	quest.570223A03231DF8C.quest_desc: ["Overhauled Endermen 是一个与 Overhauled Creepers 类似的模组！当然，主角是末影人！\\n\\n你可以在各种生物群系中找到这些末影人，而且每个都独一无二！有的攻击方式不同，有的掉落不同的珍珠，而且它们的外形也各不相同！"]
	quest.570223A03231DF8C.title: "全面重制的末影人模组"
	quest.5AC497F76A086A5C.title: "&l&9主世界悬赏：&r&e 女巫"
	quest.6141DE779232C8AA.title: "&l&c下界悬赏：&r&e烈焰人"
	quest.6827836C8E675A94.quest_desc: ["骷髅有不同的变种，就像僵尸一样！ \\n\\n流浪者- 生成于寒冷生物群系。 \\n沼泽骷髅- 生成于沼泽和试炼密室。 \\n泥沼骷髅- 生成于珊瑚礁的水下。 \\n丛林骷髅- 生成于丛林。"]
	quest.6827836C8E675A94.title: "骷髅变种 (Skeleton Variants)"
	quest.6DCDD55786025911.quest_desc: ["星光傀儡是永恒星光中的第二个Boss。 \\n\\n他正在傀儡锻造炉中蓄力，等待玩家前来挑战！"]
	quest.6DCDD55786025911.title: "击杀星光傀儡 (Kill The Starlight Golem)"
	quest.728BE1816DA23DC0.quest_desc: ["末影龙是守护末地的首领。 \\n\\n进入末地传送门后，你会到达末地岛屿，那里就是她的刷新点。 \\n\\n她有200点生命值，会用火球或冲撞来攻击你。 \\n\\n你必须打破柱子上能治愈她的末地水晶，才能将她击败！ \\n\\n击败她后，她会掉落：来自两个不同模组的奥术精华、史诗着色器袋、龙皮、龙鳞，以及大量经验值！ \\n\\n传送门会随之开启，让你返回主世界，或者你可以寻找末地传送门以探索外围岛屿。你还会在传送门旁找到一个末影人蛋。"]
	quest.728BE1816DA23DC0.title: "击杀末影龙"
	quest.734411D931A8CDBF.quest_desc: ["劫掠兽是一种仅在更困难的劫掠中出现的迷你首领。\\n\\n如果你不知道劫掠是什么，或者不理解更新后的方式，完全没关系，这就是任务存在的意义！\\n\\n通过杀死劫掠者首领（手持旗帜的那种），你可以获得不祥药水，饮用后会获得不祥之兆效果。然后，你可以走到村庄附近，开始一场劫掠。\\n\\n劫掠会生成劫掠者、卫道士、唤魔者、女巫和劫掠兽供你战斗！"]
	quest.734411D931A8CDBF.title: "杀死一只劫掠兽"
	quest.77FC692AC94D2EEF.title: "&l&9主世界悬赏：&r&e苦力怕"
	task.00CBF98DE4E9CC90.title: "AllRightsReserved"
	task.171FD27057746E80.title: "击杀 1 个凋零"
	task.1809F1F9A3043683.title: "击杀 1 只末影龙"
	task.1D136D138EF82DA9.title: "杀死2只商人羊驼"
	task.2F28B803C75DA3B2.title: "杀死1个远古守卫者"
	task.452B65E139D9E12D.title: "杀死1只野生奇美拉生物"
	task.596ABB45C0612AAF.title: "杀死1个流浪商人"
	task.65E53C9C5AE98B69.title: "AllRightsReserved"
	task.69678CAC075C8EA5.title: "杀死 1 个 Warden"
}
