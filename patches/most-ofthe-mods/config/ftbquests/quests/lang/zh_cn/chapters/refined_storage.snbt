	quest.5EAD916C4F15335F.title: "&4大型进口机"
	quest.60244F26B9ABED49.title: "&a1024B 流体存储组件"
	quest.6092490EC9008A05.quest_desc: ["&4Destructor&r 是一个接口，会自动破坏它所附着的方块。\\n\\n你也可以将其设置为白名单模式，这对于自动化某些流程很有用，比如在 &6Create 中制作外壳。&r"]
	quest.6092490EC9008A05.quest_subtitle: "破坏方块！"
	quest.616B6046EF5DDF21.quest_desc: ["精英进口商有18个过滤槽，速度是普通版的两倍。"]
	quest.616B6046EF5DDF21.quest_subtitle: ""
	quest.616B6046EF5DDF21.title: ""
	quest.64D6C395B6304F40.title: "&e65536B 流体存储组件"
	quest.64E85274D24FE394.quest_desc: ["连接到您的系统后，&9Storage Monitor&r将显示您当前网络中某物品的数量。"]
	quest.65C8A43FEDBA3835.quest_desc: ["&3图案网格&r允许你将配方印刻到网络的图案上。\\n\\n为图案创建配方的最简单方法是在JEI中查找物品，然后点击配方右下角的“+”按钮。这样配方就会被放入网格中。\\n\\n在右侧，顶部槽位用于存放空白图案。放入空白图案后，你应该可以点击下方的箭头，将配方印刻到图案上。\\n\\n然后，你需要将图案放入一个&3自动合成器&r中！"]
	quest.65C8A43FEDBA3835.quest_subtitle: ""
	quest.65C8A43FEDBA3835.title: "&3图案网格"
	quest.66D85424EC74EDCC.quest_desc: ["&9便携式网格&r是一个未连接到网络的便携式存储系统。\\n\\n它允许你在未连接到网络的情况下与&9存储磁盘&r进行交互。"]
	quest.6904EC449FBEE387.quest_desc: ["&9线缆&r用于将方块和物品连接到你的系统。\\\\n\\\\n早期，你可以通过将方块相邻放置来连接它们，但线缆能让你扩展得更远！这是任何大型RS网络的基础。"]
	quest.6904EC449FBEE387.quest_subtitle: "正在连接系统"
	quest.6904EC449FBEE387.title: "电缆"
	quest.6973A5923AF7BF05.quest_desc: ["精英出口商有18个过滤槽，速度是普通版的两倍。"]
	quest.6973A5923AF7BF05.quest_subtitle: ""
	quest.6973A5923AF7BF05.title: ""
	quest.6B04FC81351CD1AB.quest_desc: ["如果你想无线访问 RS 网络，首先需要创建一个 &3无线发射器&r。\\n\\n你可以将其安装在系统的任何位置。这是使用 &9无线网格&r 所必需的。"]
	quest.6B04FC81351CD1AB.quest_subtitle: "21世纪"
	quest.6B04FC81351CD1AB.title: "&5无线接入点"
	quest.6D81DF90E9C2C049.quest_desc: ["精英破坏者有18个过滤槽，速度是普通版的2倍。"]
	quest.6D81DF90E9C2C049.quest_subtitle: ""
	quest.6D81DF90E9C2C049.title: ""
