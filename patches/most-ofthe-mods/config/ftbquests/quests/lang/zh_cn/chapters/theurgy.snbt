# AI 初翻，未人工校对
{
	quest.02593CD4B4AE814C.quest_desc: [
		"&b盐&r对于孵化&e炼金硫磺&r很重要！ \\n\\n要获得&b盐&r，我们需要烹饪一些物品。不同的物品会产出不同的&b盐&r。这些&b盐&r有不同的等级，越稀有等级越高。 \\n\\n要烹饪出&b盐&r，我们需要将物品放入烤箱，并用热源进行加热。然后从烤箱中取出&b盐&r！"
		"{image:atm:textures/questpics/theurgy/theurgy_oven.png width:100 height:100 align:center}"
	]
	quest.02593CD4B4AE814C.title: "海水淡化厂"
	quest.0460DDEEFDEB0AAF.quest_desc: ["占卜杖是我们用来联系灵体以寻找特定物品的工具。\\n\\n首先，你需要通过用杖子右键单击物品，或用杖子和其&e炼金硫磺&r合成，来选择方块或物品！\\n\\n手持杖子并按住右键，杖子会开始寻找选定的物品。它会发出声响，并且杖子会亮起，亮度表示方块或物品的远近。\\n\\n如果足够近，可能会出现一个光球，为你指引物品的方向。"]
	quest.0460DDEEFDEB0AAF.title: "占卜之杖 (Divination Rods)"
	quest.0542FE108089A0A2.quest_desc: ["&l&6Theurgy&r 就是用魔法进行炼金术的艺术！或者在我们这里，就是用机器和物品来制造更多或不同的物品！ \\n\\n制造 &l&6Theurgy&r 所需的许多机器都需要铜，所以先从铜开始吧！"]
	quest.0542FE108089A0A2.title: "&l&6Theurgy"
	quest.06AD25DB96F3A1CC.quest_desc: [
		"像温度计一样，这些容器里装着&c汞&r！\\n\\n无论是&c汞晶&r还是&c碎片&r，里面都装着&c汞&r。"
		"{image:atm:textures/questpics/theurgy/theurgy_vessel_1.png width:100 height:125 align:center}"
	]
	quest.06AD25DB96F3A1CC.title: "&c水星&r容器"
	quest.0830195863384CF0.quest_desc: ["&bStrata&r 是最基础的第一种，由石头、沙子或黑曜石等普通方块制成。 \\n\\n你可以用 5 个 &bStrata Salt&r 来制作 &bMineral Salt&r。"]
	quest.0830195863384CF0.title: "&bStrata Salt"
	quest.0854AD352218E1C3.quest_desc: ["拥有强大力量却没有供暖，是不是很烦？\\n\\n现在，Caloric Flux Emitter 能解决这个问题！右键Shift绑定机器，然后放置并为其供电即可输送热量。\\n\\n无法同时绑定多台机器！"]
	quest.0854AD352218E1C3.quest_subtitle: "怎么做？"
	quest.0854AD352218E1C3.title: "无线热能"
	quest.0EADCEA9AB001FC7.quest_desc: [
		"非常简单的热源。放置在机器下方，并用熔炉燃料喂食：煤炭、原木、干海带块。"
		"{image:atm:textures/questpics/theurgy/theurgy_brazier.png width:100 height:100 align:center}"
	]
	quest.0EADCEA9AB001FC7.title: "熔炉般的炎热 Heat"
	quest.0F7BB4ECCA5C082C.quest_desc: [
		"将&e炼金硫磺&r放入此处。 \\n\\n&e炼金硫磺&r中的物品将被孵育回原物品！"
		"{image:atm:textures/questpics/theurgy/theurgy_vessel_3.png width:100 height:125 align:center}"
	]
	quest.0F7BB4ECCA5C082C.title: "&e硫磺&r容器"
	quest.161E7D934A21F849.quest_desc: [
		"改革会将一种&e炼金硫磺&r变为另一种，或用&3炼金硝石&r来制造更多！ \\n\\n第一步是使用源基座，将你想要转化的&e硫磺&r放置其上。"
		"{image:atm:textures/questpics/theurgy/theurgy_reform_1.png width:100 height:100 align:center}"
	]
	quest.161E7D934A21F849.title: "步骤 1：源基座 (Source Pedestal)"
	quest.16B88F46021E956D.quest_desc: ["&l&6Theurgy&r 有机器，当然也需要物流系统！\\n\\n（查看基础物流页面了解更多物流信息。）\\n\\n使用 &cMercury&r，你可以用 &cMercury Wires&r 和其他物品将物品和流体从一个地方移动到另一个地方！电线才是真正移动物品的东西。"]
	quest.16B88F46021E956D.title: "使用 &cMercury&r 进行物流管理"
	quest.19A2016B54C6FA34.quest_desc: ["&l&6Theurgy&r 中的一些机器需要热量才能启动！不过 &l&6Theurgy&r 对自己的机器获取热量方式非常挑剔，你只能使用这两种机器作为热源。 \\n\\n（使用热量的机器有：液化坩埚、煅烧炉、&c汞&r 蒸馏器和孵化器。）"]
	quest.19A2016B54C6FA34.quest_subtitle: "天哪，你太帅了！"
	quest.19A2016B54C6FA34.title: "天哪，你太帅了！"
	quest.1A46A97A00A31C03.quest_desc: [
		"第二步是目标基座。将你想要制作成第一个物品的&e硫磺&r放在这里。\\n\\n或者将&3炼金硝石&r放在这里。"
		"{image:atm:textures/questpics/theurgy/theurgy_reform_2.png width:100 height:100 align:center}"
	]
	quest.1A46A97A00A31C03.title: "步骤2：目标基座（Target Pedestal）"
	quest.1C829609915E0012.quest_desc: [
		"放入 &cMercury&r，\\n取出能量。 \\n\\nMF 代表 &cMercury&r Flux，不是 Metal Face 也不是骂人的话！"
		"{image:atm:textures/questpics/theurgy/theurgy_mercuryflux.png width:100 height:100 align:center}"
	]
	quest.1C829609915E0012.title: "用&c汞创造能量"
	quest.20C3AADEE2D4800D.quest_desc: [
		"你也可以用 &c汞&r 将流体从一个储罐转移到另一个储罐。 \\n\\n将流体提取器连接到你想取走流体的地方，比如水槽。然后将流体插入器放到你想送流体去的地方，比如 &d氯化铵&r 收集器。用导线将两者连接起来，流体就应该开始流动了！"
		"{image:atm:textures/questpics/theurgy/theurgy_fluid.png width:200 height:75 align:center}"
	]
	quest.20C3AADEE2D4800D.title: "流体移动模组"
	quest.26B462F2F41A77C7.quest_desc: ["大自然的所有馈赠...都可以在熔炉里无情地烧成只剩下&b盐&r！ \\n\\n原木、树叶和作物可以被烤成&b植物盐&r。"]
	quest.26B462F2F41A77C7.title: "&b种植盐块"
	quest.285B3FB38B12F8CA.quest_desc: [
		"我们需要这两种方块来制作&d硝石&r（感觉叫多方块结构不太合适，但两个方块也算吧）。底部是一个&d硝石&r储罐，顶部是一个&d硝石蓄积器&r。\\n\\n&d硝石蓄积器&r用于存放&9水&r和&d晶体&r；它能容纳10,000mb的&9水&r或10个桶，以及一叠&d硝石晶体&r。储罐则用于存放生成的&d硝石&r，容量为2,000mb或2个桶。"
		"{image:atm:textures/questpics/theurgy/theurgy_sal_front.png width:100 height:200 align:center}"
	]
	quest.285B3FB38B12F8CA.title: "制作&d氯化铵"
	quest.2B29E9AB9447E1C6.quest_desc: [
		"这是一个多区块机器！\\n\\n要从&e炼金硫黄&r中取回物品，我们需要进行孵化。这需要孵化器及其相邻的三个容器。顺序不重要，只要它们接触到底部即可。\\n\\n一旦所有物品都放入容器中并加热，孵化器就会开始孵化你的物品！当有烟雾粒子冒出时，就说明孵化成功了。"
		"{image:atm:textures/questpics/theurgy/theurgy_incubator.png width:200 height:200 align:center}"
	]
	quest.2F0D6267569F740B.quest_desc: ["常见材料比丰富材料更稀有、更高级。它们大多是锭和更稀有的生物掉落物，如末影珍珠或兔皮。 \\n\\n同样，你可以在标签中查看完整列表。"]
	quest.36926B5EBFF6E55A.quest_desc: [
		"&c汞&r是&l&6神学&r最重要的材料之一！\\n\\n要获得它，我们需要用&c汞&r蒸馏器来蒸馏。把物品放入蒸馏器，然后给它加热！\\n\\n有些物品能产出更多&c汞&r，比如钻石，1个钻石能产出10个&c汞&r，而石头则需要10个石头才能产出1个&c汞&r。"
		"{image:atm:textures/questpics/theurgy/theurgy_distiller.png width:100 height:150 align:center}"
	]
	quest.36926B5EBFF6E55A.title: "制作 &c汞"
	quest.393DA9C9D808A851.quest_desc: ["&l&6Theurgy's&r Wrench 就是 &cMercurial&r Wand。你可以 Shift 加滚动来切换模式。 \\n\\n你可以启用/禁用，基本可以阻止导线传输。 \\n\\n你可以更改物品提取或插入的一侧。 \\n\\n你还可以更改频率频道！"]
	quest.393DA9C9D808A851.quest_subtitle: "我还以为这是个魔法模组呢……"
	quest.393DA9C9D808A851.title: "当然，这里有一个扳手（Wrench）了"
	quest.3B6F723B03C4BF55.quest_desc: ["消化（一种非常粗略的处理方式）是我们将&3炼金硝石&r转化为不同形态的方法。 \\n\\n首先需要纯化金，将金、&b炼金盐&r和&9水&r放入消化桶中，然后像发酵桶一样按住 Shift 右键关闭。 \\n\\n接着，我们可以将4个同一种类的&3炼金硝石&r与纯化金和&d氯化铵&r结合以获得更高等级，或者反过来获得更低等级。"]
	quest.3B6F723B03C4BF55.title: "消化槽 Digestion Vat"
	quest.3C5734448FEC128B.quest_desc: ["最便宜的占卜杖，玻璃占卜杖。 \\n\\n它能找到石镐能挖掘的所有矿石。也就是铜、煤炭和铁。更高级的矿石不行。"]
	quest.3EB63AF53E70C931.quest_desc: [
		"改革需要用到汞通量！你需要用硫酸通量发射器右击并按住 Shift 键来设置所有 3 个基座。然后放置发射器并为其供电。\\n\\n之后，它就应该准备好进行改革了！"
		"{image:atm:textures/questpics/theurgy/theurgy_reform_setup.png width:200 height:50 align:center}"
	]
	quest.3EB63AF53E70C931.title: "步骤4：为其提供动力"
	quest.41ABC09C798CA8BE.quest_desc: ["此任务由 &6AllTheMods Staff&r 或 &2社区贡献者&r 为 AllTheMods 整合包创作。 \\n\\n由于所有 &6AllTheMods&r 整合包均受 &eAll Rights Reserved&r 许可，未经明确许可，不得将此任务用于非 &6AllTheMods Team&r 发布的任何公共整合包中。 \\n\\n此任务被有意隐藏，若你看到此信息，则表示你处于编辑模式。"]
	quest.457CAE66B0FA4CCF.quest_desc: ["所有&2原版&r矿石都可以通过钻石占卜杖找到。还能找到下界合金！"]
	quest.45996B848792379E.quest_desc: ["You can Mine &dSal Ammoniac Crystals&r in the &2Overworld&r but it isn't that easy. We'll still need &9Water&r and the Machines to make &dSal Ammoniac&r to make &eAlchemical Sulfur&r. \\n\\nThe &dCrystals&r are optional but help a ton; with just Water 1000mb will be turned into 100mb of &dSal Ammoniac&r. With 1000mb of &9Water&r and a &dSal Ammoniac Crystal&r we'll instead get 1000mb of &dSal Ammoniac&r. \\n\\n10 times the production with only a single Item more!"]
	quest.45996B848792379E.quest_subtitle: "既然可以直接挖掘，我们还需要机器吗？"
	quest.45996B848792379E.title: "为什么要用机器？"
	quest.48EE6C807C1668D4.quest_desc: ["如果需要让电线走得更远或连接到更多地方，你可能需要一个连接器节点。 \\n\\n就是这么简单！"]
	quest.48EE6C807C1668D4.title: "电线接这里，电线接那里"
	quest.49D1B01E07ABA471.quest_desc: [
		"你可以使用 &cMercury&r 来传输物品。 \\n将物品提取器连接到物品的来源处。然后将物品插入器连接到物品的目的地。用 &cMercury Wires&r 将两者连接起来，物品就会开始流动！ \\n\\n这可以与 &l&6Theurgy&r 机器配合使用以实现自动化！"
		"{image:atm:textures/questpics/theurgy/theurgy_item.png width:200 height:75 align:center}"
	]
	quest.49D1B01E07ABA471.title: "物品移动"
	quest.4EE482B9D61B5933.quest_desc: ["当然，&2原版&r并非我们的极限，模组中还有更多更稀有的内容！"]
	quest.54F0C5C48CFC94D0.quest_desc: ["物流需要过滤。有两种过滤器：列表和属性。\\n列表过滤器可以添加物品，并设置白名单/黑名单，以及是否尊重NBT数据。\\n\\n属性过滤器会参考一个物品，然后根据选定的属性进行过滤。这包括标签，以及能否用作熔炉燃料或能否被铺路等特性！"]
	quest.55E321EFBE8956DE.quest_desc: ["如果你想用便宜的配方进行发酵，那么发酵启动剂非常适合你。 \\n\\n发酵配方中其他物品的超值替代品。"]
	quest.55E321EFBE8956DE.title: "更简单的发酵过程"
	quest.5844DD2BEE5EC3DC.quest_desc: ["不要吃它！ \\n\\n&c汞&r可用于三种不同用途：孵化、能量创造和后勤！"]
	quest.5844DD2BEE5EC3DC.quest_subtitle: "金星……不，是&c水星&r！"
	quest.5844DD2BEE5EC3DC.title: "水星"
	quest.616364E6AE05C341.quest_desc: ["&b矿物盐&r是用……矿物制成的。 \\n\\n所有以矿石形式开采的东西都可以制成&b盐&r。原矿石、锭、宝石，都会变成&b矿物盐&r！ \\n\\n就连Unobtainium也能做成&b盐&r！求你了，别这么做，有太多更好的替代品了。"]
	quest.616364E6AE05C341.title: "&b矿物盐"
	quest.61DA3D61D7103647.quest_desc: ["&e炼金硫磺&r几乎可以由任何东西制成，也可以制成任何东西！ \\n\\n在&e炼金硫磺&r中有几组不同的物品，这可能在另一个任务中解释得更清楚。 \\n\\n处理&e炼金硫磺&r有3条不同的路径。1. 发酵和消化以制作硝石。2. 孵化以再次制作那些物品。3. 通过重塑来改变物品。"]
	quest.61DA3D61D7103647.title: "&e炼金硫磺块"
	quest.6A8E748B642DD16F.quest_desc: [
		"This is where the &bSalt&r will be held. \\n\\nThe type of &bSalt&r does matter for what you will try and Incubate. If you want to make Unobtainium you'll need &bMineral Salt&r, if you want Wheat you'll need &bPlant Salt&r, and so on."
		"{image:atm:textures/questpics/theurgy/theurgy_vessel_2.png width:100 height:125 align:center}"
	]
	quest.6A8E748B642DD16F.title: "&b盐&r 容器"
	quest.6C6F4EB5CBE2FBC2.quest_desc: ["铁制占卜杖的探测范围稍大，能探测到铁镐能挖掘的矿石！比如钻石、红石和金矿。"]
	quest.6CAD27627A3F8FD7.quest_desc: [
		"现在我们终于要进入本模组的精髓了，&e炼金硫磺&r！\\n\\n要制作它们，我们需要一个液化坩埚、一个物品，&d氯化铵&r，还有一个加热器。\\n\\n加热在另一个任务中已有说明，但你需要在坩埚下方放置火焰祭坛或热量通量发射器来加热它。\\n\\n然后将液态的&d氯化铵&r倒入其中。\\n\\n最后放入你想要被转化为&e炼金硫磺&r的物品。\\n\\n当坩埚开始冒泡时，就说明成功了。"
		"{image:atm:textures/questpics/theurgy/theurgy_lique.png width:100 height:100 align:center}"
	]
	quest.6CAD27627A3F8FD7.title: "制作 &e炼金硫磺"
	quest.7119F8C352D057BC.quest_desc: ["现在来点好玩的！稀有物品甚至包括鞘翅！嗯，我觉得比稀有更好，但这个分类不是我做的。"]
	quest.7198ED7E97A256A4.quest_desc: ["第一根特殊制作的占卜杖是丰饶材料杖！\\n\\n当你用物品的&e炼金硫磺&r制作该杖时，杖就会与该物品产生共鸣。\\n\\n你可以在标签中查看丰饶材料的列表，它太长了，我无法在任务中全部念出。"]
	quest.72FADEAEE2DA03AF.quest_desc: [
		"第三步是将新变化的 &e硫磺&r 放入结果基座。一旦重组完成，它就会来到这里。"
		"{image:atm:textures/questpics/theurgy/theurgy_reform_3.png width:100 height:100 align:center}"
	]
	quest.72FADEAEE2DA03AF.title: "步骤3：结果基座 Result Pedestal"
	quest.730F2D3329C4FF88.quest_desc: ["&n发酵&r：葡萄糖等分子在无氧条件下被分解的化学反应。 \\n\\n也就是所谓的&9水和时间&r的作用！ \\n\\n要使用发酵桶，将物品和流体放入桶中，然后 Shift + 右键关闭。 \\n\\n过一会儿就会发酵！这就是我们将&e炼金硫磺&r转化为&3炼金硝石&r的方法，而硝石又可以制成更多物品！"]
	quest.730F2D3329C4FF88.title: "发酵桶"
	quest.76F675A898EAB4E8.quest_desc: ["&d氯化铵&r是制作和复制物品所需的&e炼金硫磺&r的关键部分。 \\n\\n要获得&d氯化铵&r，我们需要一些&9水&r。"]
	quest.76F675A898EAB4E8.title: "&d氯化铵（Sal Ammoniac）"
	quest.7878F190BC8ADC82.quest_desc: ["最棒中的最棒。从钻石，到下界之星，再到Allthemodium。这根法杖只寻找最棒的物品！"]
	quest.7A1C117CA8FB7C31.quest_desc: ["这个很特别！\\n\\n它会找到正在生长的紫水晶块，而不是矿石！\\n\\n再也不用费力寻找晶洞了，我的朋友！"]
	quest.7A271F425C3934CE.quest_desc: ["目前只能通过烹饪 2 个 &b植物盐&r 来制作 1 个 &b生物盐&r。 \\n\\n希望在未来的更新中，我们能通过杀死更多生物来获取 &b盐&r！"]
	quest.7A271F425C3934CE.title: "&b生物盐块"
	task.339A5D32CC00D60C.title: "AllRightsReserved"
	task.3489080F5FDE8B1B.title: "热量"
	task.6D9221A533926A7B.title: "AllRightsReserved"
	task.76F6BC2EC054BD3C.title: "炼金术用硫磺"
}
