	quest.366431661CC43A6E.title: ""
	quest.36DAFC3FECC67406.quest_desc: ["最佳能量电池 DE 将会给予。"]
	quest.36DAFC3FECC67406.title: "混沌电容器"
	quest.36F123B2A6B52A01.quest_desc: ["这些能传输更多能量，链接数也更多。最高等级的能量晶体放进去。"]
	quest.36F123B2A6B52A01.title: "龙之能量中继水晶"
	quest.3765485408041FC6.quest_desc: ["查看模组，了解更多关于如何使用和升级 DE 物品的信息！镐子可作为正常的 Tier 6 镐子使用。它们可以挖掘从石头到 Unobtainium 的所有层级方块。挖掘的物品将自动存入你的物品栏。"]
	quest.3765485408041FC6.title: "Wyvern Pickaxe"
	quest.376D154F27A00BCD.quest_desc: ["物理和De是怎么回事？重力会让箭在飞行过程中下落。重力补偿能让我们不必为此担忧。"]
	quest.376D154F27A00BCD.title: "Wyvern Projectile Gravity Compensation Module"
	quest.37CC51B689CB8A40.quest_desc: ["胸甲的运作方式与Meka-Suit类似。任何本应对你造成的伤害都会被抵消，并从你的盾牌中扣除。盾牌容量代表你能持有的护盾量，充能速率代表其填充速度，而OP将在充能时使用。"]
	quest.37CC51B689CB8A40.title: "Wyvern 盾牌容量模块"
	quest.389655CD41C7A691.quest_desc: [
		"Tier 1 只需要制作核心和 4 个稳定器。"
		"{image:atm:textures/questpics/draconic/draconic_core_1off.png width:100 height:100 align:1}"
		"{image:atm:textures/questpics/draconic/draconic_core_1on.png width:100 height:100 align:1}"
	]
	quest.389655CD41C7A691.quest_subtitle: "存储量：45,500,000 RF"
	quest.389655CD41C7A691.title: "第一阶"
	quest.38AD547C36BDF4C4.title: "龙之投射物精准度模块"
	quest.39865681B03CABAA.quest_desc: ["水有点黏，或者说比空气密度大。所以水下挖矿更慢。你可以用 Aqua Affinity 附魔，也可以用这个模组。随你选！"]
	quest.39865681B03CABAA.title: "水适应模块"
	quest.39AF9B1A996DA949.quest_desc: ["就像下界合金剑，但更好、更酷！"]
	quest.39AF9B1A996DA949.title: "混沌之剑"
	quest.3B4CEE8A8CE0D6CB.quest_desc: [
		"快到了！第7级。210个龙晶锭和328个红石块！"
		"{image:atm:textures/questpics/draconic/draconic_core_7off.png width:100 height:100 align:1}"
		"{image:atm:textures/questpics/draconic/draconic_core_7on.png width:100 height:100 align:1}"
	]
	quest.3B4CEE8A8CE0D6CB.quest_subtitle: "存储量：2,140,000,000,000 RF"
	quest.3B4CEE8A8CE0D6CB.title: "第7级"
	quest.3BE3B54B4A681668.quest_desc: ["归根结底，你喜欢像卡车一样，但慢得多地伤害敌人吗？还是更愿意当一个用剑的正常人？"]
	quest.3BE3B54B4A681668.title: "混沌之斧"
	quest.3CB8F5F1D33C8F9F.quest_desc: ["和上一个任务一样，只是更多，多得多。"]
	quest.3CB8F5F1D33C8F9F.title: "大型翼龙盾牌容量模块"
	quest.3DF794EBCAA7AE1A.title: "龙之树收割机"
	quest.3FD19A001899D8C6.quest_desc: ["好，这个能同时获得滑翔和飞行能力，确切说是创造模式飞行。"]
	quest.3FD19A001899D8C6.title: "龙之飞行模块"
	quest.40F34EBE09DA7752.quest_desc: ["饥饿时，自动喂食器会自动喂你背包里的任何食物。但它有最大食物点数存储限制，每格饱食度为2点。所以基础版最多只能存8块牛排的量。"]
	quest.40F34EBE09DA7752.title: "基础自动喂食模块"
	quest.41BD497108CA109F.quest_desc: ["Awakened Draconium 可通过融合合成方块获得。这些方块可分解为 9 个锭。它们是 Draconic Evolution 中第二重要的锭，对于 Wyvern 和 Draconic 阶段至关重要。"]
	quest.41BD497108CA109F.title: "觉醒的德拉科尼乌姆"
	quest.421954D7D46FAAD6.quest_desc: ["能量核心稳定器...稳定？核心。前4个等级的核心，你只需要在周围放置4个稳定器。你可以通过稳定器访问核心的GUI。如果放置得离核心太近或位置不对，系统会提示错误。"]
	quest.421954D7D46FAAD6.title: "能量核心稳定器"
	quest.43C2B07AB25C708E.quest_desc: ["维文弓的升级版。"]
	quest.43C2B07AB25C708E.title: "龙之弓 (Draconic Bow)"
	quest.45EE60207C466D6C.quest_desc: ["要进入 Draconic Evolution，你需要混沌碎片。混沌碎片位于末地的混沌岛屿中，由混沌守卫看守。前往 X/Z 坐标为 10k 的倍数处。例如 10k, 10k / 10k, 20k / 20k, 20k 等。"]
	quest.45EE60207C466D6C.quest_subtitle: "寻找混沌岛屿 (Finding Chaos Island)"
	quest.45EE60207C466D6C.title: "他在哪里？"
	quest.4638F21544D6D337.title: "混沌纠缠量子能量隧道"
	quest.46C816844C513D5D.quest_desc: ["升级版的 Wyvern 铲子。"]
	quest.46C816844C513D5D.title: "龙之铲"
	quest.4903BDC389C73082.title: "Draconic Projectile Damage Module"
	quest.4A3A5684302C8627.title: "混沌护盾容量模块"
	quest.4AAADEC52D16461A.quest_desc: ["基本上就是开启了自动跳跃。我个人挺喜欢的，但用不用就看你啦！"]
	quest.4AAADEC52D16461A.title: "丘陵阶梯模块"
	quest.4AB564420C48579B.quest_desc: ["Draconic Evolution 认为，既然有自带盾牌的胸甲，就没必要用一堆垃圾盔甲覆盖全身。等等，盾牌不是自带的，需要模块……抱歉。"]
	quest.4AB564420C48579B.title: "Wyvern 胸甲"
	quest.4ABEF61DADBD0640.quest_desc: ["大多数弓都是半自动的。你得拉弦、松弦、再装一支箭，周而复始。现在跳过所有步骤，弓会在拉满时自动射击。只需按住右键，静静欣赏！"]
	quest.4ABEF61DADBD0640.title: "自动开火模块"
	quest.4B7840F1A8CF1378.quest_desc: ["融合合成是制作大多数（至少是有趣的物品）的方式。要开始，你需要一个融合合成核心，将其放置在地面以上约一个方块处。配方可以通过JEI自动放置到核心中，中间的物品会放入核心，成品也会储存在核心里。你需要将注入器放置在距离核心几格远的地方，朝向核心，并分布在核心的两侧。查看下一个任务了解更多相关信息。注入器还需要能量，这将在晶体绑定任务中进一步说明。"]
	quest.4B7840F1A8CF1378.title: "融合合成"
	quest.4B9FF9E972B0E530.quest_desc: ["能量链接或隧道越好，传输能力越强，但你可能注意到能量链接有个缺陷：它无法在不同维度间工作！幸运的是，更高级的链接可以，只要确保另一端已加载区块即可。"]
	quest.4B9FF9E972B0E530.title: "量子能量隧道"
	quest.4CD2ADD3601B8191.quest_desc: ["想让盾牌在你没濒死前就回来吗？那就需要恢复模块了。模块越多，恢复越快。"]
	quest.4CD2ADD3601B8191.title: "Wyvern 盾牌恢复模块"
	quest.4E27182763DA83DC.quest_desc: ["升级版的 Wyvern 胸甲。"]
	quest.4E27182763DA83DC.title: "龙之胸甲"
	quest.4EFFE300EC781C3E.quest_desc: ["模块对我们的 DE 物品非常重要。没有它们，物品根本用不了！大多数模块都由模块核心或之前的模块制成。按住物品，按 Shift 和 C 打开模块菜单。你会看到一些插槽和按钮！插槽是模块放置的位置，而网格决定了可以放置的模块数量。如果一个模块显示 1x1，它只会占用 1 个插槽，而显示 2x2 的则会占用 4 个。右下角的按钮会显示可以应用于你持有的物品的模块。其余按钮仅更改界面外观。"]
	quest.4EFFE300EC781C3E.title: "模组！Modules!"
	quest.4F6A9F1AEFD535F5.title: "巨龙大型盾牌容量模块"
	quest.50013DD7370F8EDB.title: "混沌跳跃模块"
	quest.5021D159A5EC2315.title: "龙之能量模块"
	quest.51CF09EC333DB1A3.quest_desc: ["在龙之进化融合锻造中升级，配方所需的注入器等级必须至少与目标等级相同或更高。例如，制作威龙斧需要至少6个威龙注入器，每侧3个。别担心，锻造核心保持不变！"]
	quest.51CF09EC333DB1A3.title: "Wyvern 等级"
	quest.529123A789D790E3.title: "Wyvern 跳跃模块"
	quest.52C301DF1776E0D8.title: "混沌弹道伤害模组"
	quest.52C3F61D678B00F5.quest_desc: ["一把混沌锄头，我以前和其中一个约会过。"]
	quest.52C3F61D678B00F5.title: "混沌锄头"
	quest.52EA9793A7100E75.title: "混沌不死模组 (Chaotic Undying Module)"
	quest.542AD6FD1927C3E6.title: "Draconic Undying 模组"
	quest.5443E15E226DFC86.quest_desc: ["Pylons 是用于将 OP 进出 Energy Core 的装置。将它们放置在 Core 附近，至少放置 2 个，1 个用于输入，1 个用于输出（也可以使用更多）。然后在它们上面放置 Glass，它们会自动组装并锁定最近的 Energy Core。右键点击 Pylons 上方新形成的球体，可以将其更改为输入或输出（可以通过箭头和设计来区分）。之后，你就可以将 Crystals 连接到它们上，以移动 OP 了！"]
	quest.5443E15E226DFC86.title: "能量通过这些来来去去，变幻莫测"
	quest.54F78C9A945CF0E7.title: "混沌能量模块"
	quest.574E5806D1A98FE5.quest_desc: ["能量模块是最重要的模块，是使用DE物品所必需的。模块中的能量决定了物品能储存和吸收多少OP，想了解充能更多信息，请查看能量注入器。能量模块的等级越高，物品能储存和使用的OP就越多。这一点很重要，因为物品升级后，每次使用会消耗更多的OP。"]
	quest.574E5806D1A98FE5.title: "基础能量模块"
	quest.5895B7FA5497BD68.quest_desc: ["威龙斧的升级版。"]
	quest.5895B7FA5497BD68.title: "龙之斧 (Draconic Axe)"
	quest.594BBD31461F212D.title: "龙之盾恢复模块"
	quest.5ADFC45B03BAB852.quest_desc: ["这就是龙之核心（Draconic Cores）的用途。"]
	quest.5ADFC45B03BAB852.title: "Draconic Tier"
	quest.5BC6CC3C09F512A7.quest_desc: [
		"反应堆核心是反应堆最重要的部分，也就是核心！把它放在注入器和稳定器5格以上的位置，右键即可打开它的GUI。在这里你会看到几个条、一个球、按钮和槽位。从左到右分别是：热量、约束场、能量饱和度和燃料转化率。约束场和能量你已了解，燃料将在下一个任务中学习。所以热量非常重要，升温时会先升到2000°C，之后才能激活。注意不要让热量过高，否则……熔毁！球体是你的核心图像，目前我有个bug，核心没有纹理，所以无法详细说明。按钮可以改变GUI外观、激活或关闭反应堆，以及为其充能。"
		"{image:atm:textures/questpics/draconic/draconic_reactor_off_down.png width:200 height:100 align:1}"
		"{image:atm:textures/questpics/draconic/draconic_reactor_off_up.png width:150 height:150 align:1}"
	]
	quest.5BC6CC3C09F512A7.quest_subtitle: "无限的力量"
	quest.5BC6CC3C09F512A7.title: "建造反应堆"
	quest.5C2CF51D28F84CBE.quest_desc: [
		"真正的战斗现在开始，他有两个生命条，都必须降到0才能获得混沌碎片。别靠得太近，否则他会用一连串的火球攻击你！{顺便一提，在旧版本中，混沌守卫甚至能在创造模式下杀死玩家！幸运的是，现在不行了)"
		"{image:atm:textures/questpics/draconic/draconic_guardian.png width:150 height:100 align:1}"
	]
	quest.5C2CF51D28F84CBE.title: "击杀混沌守护者 (Chaos Guardian)"
	quest.5D87088E8D71DB9B.quest_desc: ["IO晶体可以相互连接并传递能量。要链接它们，用晶体绑定器Shift+右键设置一个，然后右键点击要连接的任意晶体。查看晶体时，会显示“从方块输入”或“向方块输出”。输入端是你要接收OP的，输出端是你要发送OP的。"]
	quest.5D87088E8D71DB9B.title: "正在移动 OP"
	quest.5E0D78B7B2CF1729.quest_desc: ["我知道这是 Wyvern 阶，但为什么会有 Draconic 物品？要到达 Draconic 阶，你需要 Draconic 注射器。而要获得 Draconic 注射器，你需要 Draconic 核心。现在明白为什么它们会出现在这里了吧？"]
	quest.5E0D78B7B2CF1729.title: "Draconic Core"
	quest.5E671F1F370DDE43.title: "Draconic 自动喂食模块"
	quest.5E8D527DE9D7DD46.quest_desc: ["穿上胸甲就能滑翔！就像用鞘翅一样（但没有护甲损耗）。我不喜欢叫它飞行，更愿意称之为“花式坠落”。"]
	quest.5E8D527DE9D7DD46.title: "Wyvern 飞行模块"
	quest.607337D8AA20FA18.quest_desc: ["所有附着在被砍伐树木上的东西都会一同掉落。"]
	quest.607337D8AA20FA18.title: "Wyvern 树木收割机"
	quest.60C27206F1414DD6.quest_desc: ["牛顿告诉我们，每个作用力都有大小相等、方向相反的反作用力。简单来说，当箭射中生物时，生物的反作用力会减缓箭的速度。除非你有这个模组。它不会把生物当纸，而是无视所有生物。箭穿透目标后不会减速。"]
	quest.60C27206F1414DD6.title: "Projectile Immunity Cancellation Module"
	quest.61419D230687CBB5.quest_desc: ["Velocity 是指物品在特定方向上的速度。我们的箭并非来自《银河护卫队》，所以这基本上就是指箭的速度。每次升级后，箭从弓到目标的飞行时间都会缩短，但代价是准确性会略微下降。"]
	quest.61419D230687CBB5.title: "Wyvern 投射物速度模块"
	quest.655BE42CD5BB9D82.title: "龙之范围伤害模块"
	quest.6601ACCDDF6CA5FF.quest_desc: ["反应堆最多只能储存10亿OP，虽然听起来很多，但很快就会用完。当能量饱和达到100%时，热量会急剧上升，可能导致熔毁。激活需要5亿OP，通量门有助于限制OP的流入和流出。（顺便一提，1RF=1OP）它们需要红石激活，既可用于输入OP，也可用于输出OP。为避免熔毁，你需要输出能量，试试接入能量核心吧！"]
	quest.6601ACCDDF6CA5FF.title: "一个良好的开端总是好的"
	quest.6616A62426ED4D15.quest_desc: ["注入器必须在所有稳定器的另一侧，并且与核心共享同一轴。OP 将从这里被泵入！要激活并使 OP 生效，需要将能量饱和度提高一点。能量饱和度是已储存和即将产生的能量。"]
	quest.6616A62426ED4D15.title: "反应堆能量注入器"
	quest.69396F87A09FBD85.quest_desc: ["所有镐的挖掘等级相同，升级只是为了提升速度和获取法杖。"]
	quest.69396F87A09FBD85.title: "混沌之镐"
	quest.69986817D58AC8BE.quest_desc: ["稳定器构成了收容场（反应堆核心周围的力场护盾）。当反应堆开启且收容护盾降至0时，熔毁就会开始。所有4个稳定器都必须与核心相距数格（5格或以上），并且与核心处于同一轴线上才能正常工作。你还需要将反应堆的OP通过它们导出，但注意不要导出太多！"]
	quest.69986817D58AC8BE.title: "反应堆稳定器"
	quest.6B0CD6732BE0E819.quest_desc: ["合法的，只是跳跃助推。"]
	quest.6B0CD6732BE0E819.title: "基础跳跃模块"
	quest.6B8F2E05429C185F.quest_desc: [
		"击败他后，他会掉落经验、一颗龙之心脏，最重要的是会释放出混沌碎片。看向闪电会劈落的位置，然后在下方挖掘。在那里你会找到混沌碎片。开采它即可获得5个混沌碎片，可以进一步合成更小的碎片！"
		"{image:atm:textures/questpics/draconic/draconic_shard.png width:150 height:100 align:1}"
	]
	quest.6B8F2E05429C185F.title: "混沌碎片{s}"
	quest.6DBD81BA83B1D0A5.quest_desc: ["操作潜力进一步提升了！"]
	quest.6DBD81BA83B1D0A5.title: "龙之电容器"
	quest.7081E9BF44EFBCB0.title: "混沌大型盾牌容量模块"
	quest.710C7FEFAA6C0979.quest_desc: ["维文之剑的升级版。"]
	quest.710C7FEFAA6C0979.title: "龙之剑 (Draconic Sword)"
	quest.713D3B3954E58C4A.quest_desc: [
		"Tier 3 需要 26 个 Draconium Ingot 方块围绕核心，将其完全包裹起来才能制作。"
		"{image:atm:textures/questpics/draconic/draconic_core_3off.png width:100 height:100 align:1}"
		"{image:atm:textures/questpics/draconic/draconic_core_3on.png width:100 height:100 align:1}"
	]
	quest.713D3B3954E58C4A.quest_subtitle: "存储量：1,640,000,000 RF"
	quest.713D3B3954E58C4A.title: "第三阶段"
	quest.7143CE930D08F160.quest_desc: ["Area of Effect 是大多数玩家都熟悉的术语。简单来说，它能扩大工具的生效范围。带有 3x3 AOE 的镐子能挖掘 3x3 范围内的方块。带有 3x3 AOE 的剑能杀死该范围内击中的所有生物。升级越好，范围越大。不，这个效果不能叠加！"]
	quest.7143CE930D08F160.title: "基础范围伤害模块"
	quest.715F9F7107374299.quest_desc: ["Wyvern (能量中继) 水晶。与基础水晶完全相同，只是能量和链接更多。"]
	quest.715F9F7107374299.title: "Wyvern 能量中继水晶"
	quest.731A70C25C2C7281.quest_desc: ["使用该工具获得的物品将存入你的末影箱。原版末影箱，非模组添加的。"]
	quest.731A70C25C2C7281.title: "末影收集模块"
	quest.7496B2380A23FDC6.title: "混沌树木收割机"
	quest.74C715F8F24B8BAE.quest_desc: ["同样的操作，但增加了筛选选项。"]
	quest.74C715F8F24B8BAE.title: "可过滤的末影收集模块"
	quest.75F0405FFAB9C080.quest_desc: ["最后一个等级，混沌等级，需要用到这个。希望你已经完成了说明如何获得混沌碎片的那条任务分支！"]
	quest.75F0405FFAB9C080.title: "混沌核心"
	quest.76064465104B1C28.title: "龙之盾容量模块"
	quest.763EB5C911D7E78C.quest_desc: ["Crafting Infusions, Chaotic Tier 的终点。到了这里，一切都能被创造出来。不仅是工具，还有反应堆所需的一切。"]
	quest.763EB5C911D7E78C.title: "混沌等级"
	quest.78FBB0C88182040E.quest_desc: ["如果你自1.13版本后就没玩过Minecraft，可能会感到困惑，但你肯定知道弩和穿刺。它们有一个附魔，能让箭矢穿透多个目标并持续造成伤害。本模组正是实现了这一点！"]
	quest.78FBB0C88182040E.title: "Wyvern 投射物穿透模块"
	quest.79886D63280DBBF3.quest_desc: ["过滤还不够吗？！你还想把物品销毁？！你这个怪物！"]
	quest.79886D63280DBBF3.title: "选择性焚烧模块"
	quest.79FC674836B6340E.title: "龙之跳跃模块"
	quest.7A4ABFCD12202A91.quest_desc: ["操作潜能是龙之进化的能源。移动OP的主要方式（非唯一方式）是使用IO中继晶体。要将OP真正存入物品中，你需要一个能量传输器。"]
	quest.7A4ABFCD12202A91.title: "能量，或者我们称之为 OP 的东西，究竟是什么？"
	quest.7B9F5EEC76FDD0D4.title: "Draconic 伤害模组"
	quest.7C54581562D2EA75.quest_desc: ["速度模块很有趣，几乎适用于所有物品，能让它们变快！剑挥得更快，镐挖得更快，斧头砍得更快，弓射得更快，胸甲也能让你跑得更快。速度模块越好，速度就越快！(顺便一提，大多数属性可以叠加。两个基础速度模块能让速度提升20%%！)"]
	quest.7C54581562D2EA75.title: "基础速度模块"
	quest.7D159D333B2AC57E.quest_desc: [
		"5亿OP？有。燃料？有。2000°C的高温？有。只需点击激活按钮，祈祷它不要熔毁！"
		"{image:atm:textures/questpics/draconic/draconic_reactor_on_down.png width:200 height:100 align:1}"
		"{image:atm:textures/questpics/draconic/draconic_reactor_on_up.png width:150 height:150 align:1}"
	]
	quest.7D159D333B2AC57E.quest_subtitle: "现在我们祈祷并祈祷着……希望……"
	quest.7D159D333B2AC57E.title: "正在激活反应堆"
	quest.7D7E4C31DFE59E29.quest_desc: ["与之前的不同，这些模组仅适用于 DE 弓。投射物伤害模组会提高弓发射的箭矢的伤害。有些模组与之结合会产生负面效果，例如会略微降低弓的准确性。所有这些效果都可以叠加！"]
	quest.7D7E4C31DFE59E29.title: "Wyvern 投射物伤害模组"
	quest.7EB1C1AE52A0027F.title: "混沌弹道重力补偿模块"
	quest.7EB97C0DDE60DED4.quest_desc: ["来自Draconic Evolution的最佳弓，还有更多的模块插槽！"]
	quest.7EB97C0DDE60DED4.title: "混沌之弓"
	quest.7F757CD6F8C57733.quest_desc: ["能量核心是Minecraft中最大、最强大的能量银行之一。一切始于核心。这是能量核心多方块结构的中心和心脏（确保其略微高于地面）。放置后，你会看到包含建造指南、降低等级、提升等级和组装核心的GUI。等级决定了核心的大小和强度。建造指南会展示如何组装该等级的核心。如果你备齐了所有必要的方块，就可以按下“组装核心”，系统将自动完成建造！"]
	quest.7F757CD6F8C57733.quest_subtitle: "龙之力量储存器"
	quest.7F757CD6F8C57733.title: "能量核心多联块"
	task.1EFD3D7C04F9682A.title: "AllTheMods 制作的任务包"
	task.2AE8A0F6A6C2D453.title: "AllTheMods 制作的任务包"
	task.61CCAD2018478894.title: "激活"
	task.664130FB28E419EF.title: ""
	task.6EAC5BBFAA0184BC.title: "准备工作"
}
