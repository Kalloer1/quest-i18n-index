	quests: [
		{
			description: [
				"要想开始制作基础工具，你需要做的事情和原版游戏有所不同。"
				""
				"熟悉这类事情的人可能知道接下来会发生什么！"
				""
				"没错！&6燧石工具！"
				""
				"不知道的人请阅读以下任务说明。"
			]
			id: "665750A306746006"
			rewards: [
				{
					id: "1EDBC879C3FB0290"
					item: "refurbished_furniture:cheese_sandwich"
					type: "item"
				}
				{
