			}]
			x: 7.5d
			y: 3.0d
		}
		{
			dependencies: ["25AC12570B00C64E"]
			description: [
				"使用新获得的燧石碎片，在背包的合成台里与木棍组合。"
				""
				"你可以从树叶或地上的小树枝中获得木棍。"
			]
