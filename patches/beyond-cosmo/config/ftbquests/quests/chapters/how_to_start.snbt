				title: "如何获得基础工具"
				type: "checkmark"
			}]
			x: 4.0d
			y: 8.0d
		}
		{
			dependencies: ["665750A306746006"]
			description: ["要开始，你需要一个燧石。可以制作获得"]
			id: "5B7073B79A21D99A"
			subtitle: "很简单，对吧？"
			tasks: [{
				id: "0C38ADB98FD48CDE"
