				type: "item"
			}]
			x: 7.5d
			y: 8.0d
		}
		{
			dependencies: ["5B7073B79A21D99A"]
			description: ["用燧石砸向石块（潜行+右键）以获得燧石碎片。"]
			id: "25AC12570B00C64E"
