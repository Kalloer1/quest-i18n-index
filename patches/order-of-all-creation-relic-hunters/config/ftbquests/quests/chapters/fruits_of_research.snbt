# AI 初翻，未人工校对
{
	id: "2B4F284B838AE367"
	group: ""
	order_index: 8
	filename: "fruits_of_research"
	title: "研究成果的果实"
	icon: {
		id: "enigmaticlegacy:withered_tome"
		Count: 1b
		tag: { }
	}
	disable_toast: true
	default_quest_shape: ""
	default_hide_dependency_lines: true
	quests: [
		{
			title: "知识带来的益处"
			icon: {
				id: "enigmaticlegacy:corrupted_tome"
				Count: 1b
				tag: { }
			}
			x: 0.0d
			y: 0.0d
			shape: "square"
			subtitle: "开发新技术中，进度：百分之五十。预计完成时间：百分之五十。"
			description: [
				"&e&o\"We've only been orbiting here for a few weeks, but we already know quite a bit about what works and what doesn't down there! Although a lot of our technology and magic brought from home seems to disappear without a trace when it enters the world's reality. So we've been examining samples of the worlds resources and how magical sources work from reports contractors or scouts have been sending in to piece together what is going on. This way we can learn what we need to do differently and it might just shed some light on more of the workings of the Void and how not just this but all worlds work!\" "
				""
				"&e&o“当你找到探险得来的遗迹并上交后，研究人员会寄给你一本笔记和其他思考。如果你与其他承包商组队，你可以分享笔记，共同分担工作。知识足够后，我们就能为你提供有趣的装备、工具，或是我们自己创造的遗迹！”&r"
				"---------"
				"&6Order Research Notes&r are based after &6\"Corrupted Tomes\"&r from enigmatic Legacy. &aAs such they can be read to gain a large chunk of experience, but so can other players also read research tomes you've been holding onto in your chests. Once you've gotten the experience out of them this section of quests allows you to trade back in the research notes as a form of resource points currency along with other resources to unlock items!&r "
				""
				"&a这些物品通常带有EMC值，可以通过炼金术复制，但一般没有配方。所以一定要在弄丢它们之前学会配方！&r 多人游戏时，也请务必告知他人你解锁了哪些物品，以免重复浪费资源！"
			]
			min_width: 350
			id: "3058169616107DB4"
			tasks: [{
				id: "014B8961DCEEC895"
				type: "checkmark"
				title: "研究书籍的新战利品和奖励在此！"
			}]
		}
