	quest.5ED8D976AC5D2BF0.quest_subtitle: "永久夜视能力"
	quest.5F69382770C89635.quest_desc: [
		"&9魔法实验 🔮 &r"
		""
		"&o神秘的能量在你周围涌动。在理解它们之前，你敢驾驭这股力量吗？&r"
	]
	quest.5F69382770C89635.title: "&9魔法实验 🔮 &r"
	quest.6111AA439C1ED08F.quest_desc: [
		"&d寻求知识 📖 &r"
		""
		"&o奇怪的书籍和古老的卷轴暗示着被遗忘的魔法。也许这个世界远比表面看起来的更加复杂……&r"
	]
	quest.6111AA439C1ED08F.title: "&d寻求知识 📖 &r"
	quest.6FDD75FC45B24DAF.quest_desc: [
		"&l&a收集资源 🌿 &r"
		""
		"&o先砍树、收集食物，制作生存必需品。再强大的巫师都是从零开始的！&r"
	]
	quest.6FDD75FC45B24DAF.title: "&l&a收集资源 🌿 &r"
	quest.6FE4DA28B23E3B48.quest_desc: [
		"&l&d你醒来，发现自己身处一个陌生的世界，空气中弥漫着微弱的魔法光芒。 &r"
		""
		"&o眼前的土地充满了无限可能——神秘的森林、残破的遗迹，以及充满神秘能量的巍峨山脉。这个地方总感觉……与众不同。魔法在你脚下低语，等待着你去理解。&r"
		""
		"&o&c你必须决定如何开启你的旅程。&r"
		""
		""
	]
	quest.6FE4DA28B23E3B48.title: "&4开端&r"
	quest.7DB8B261555C451B.quest_desc: [
		"&l&4嗨，我是 Rogue_Light，&r"
		""
		"&dThaumic Horizon 的创造者！&r"
		""
		"&o我一直热爱魔改Minecraft，尤其是魔法与科技的结合。这个整合包是我实现这一愿景的方式——用新机制和新冒险来拓展Thaumcraft风格的进阶内容。 &r"
		""
		"&o无论你是来掌握神秘魔法，还是实现自动化奇迹，希望你的旅程能像我创造它时一样充满乐趣！&r"
	]
	quest.7DB8B261555C451B.quest_subtitle: "认识开发者！"
	quest.7DB8B261555C451B.title: "Rogue_Light"
