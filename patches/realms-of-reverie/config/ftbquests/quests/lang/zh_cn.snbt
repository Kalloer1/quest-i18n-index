# AI 初翻，未人工校对
{
	chapter.02D996697E10DBB5.title: "暮色森林（The Twilight Forest）"
	chapter.0E21FB2EFB41A583.title: "MineColonies"
	chapter.1F47E8AD92C5B670.title: "Iron's Spells \& 魔咒书"
	chapter.33B91EA0F96ED47D.title: "梦境的诸界 (The Realms of Reverie)"
	quest.00A3AD4BD4EE0FC7.quest_desc: [
		"瞭望塔将雇佣并安置一名守卫来保护你的殖民地。公民们会感激一个守卫严密的殖民地。通常每三名公民需要配备两名守卫。"
		""
		"守卫在守卫塔中睡觉，腾出他们之前在住宅或酒馆中占用的床铺，让你可以招募新的定居者。"
		""
		"提示：建造并升级瞭望塔可以扩大你的殖民地边界。"
	]
	quest.00A3AD4BD4EE0FC7.quest_subtitle: "建造一座瞭望塔并雇佣一名守卫"
	quest.012381ED2409FF16.quest_desc: [
		"在深邃的黑暗中，找到并踏入一座远古城市。"
		""
		"§e+1 采矿技能点"
	]
	quest.012381ED2409FF16.title: "潜行者的都市"
	quest.03AC1C56F20BB662.quest_desc: ["一旦你有了些&d奥术精华&r，就可以制作几个法术书来升级了！"]
	quest.03AC1C56F20BB662.title: "&a法术书升级包"
	quest.085F473094778DCD.quest_desc: [
		"资源卷轴是告诉建筑师需求的好方法。潜行+右键建筑师小屋，即可将卷轴分配给建筑师。"
		""
		"现在，手持资源卷轴右键点击，你就能看到建造小屋所需的所有材料。"
	]
	quest.085F473094778DCD.quest_subtitle: "最精细的微观管理，莫过于此"
	quest.08766B8721B4E541.quest_desc: [
		"在末地，你可能会遇到一个&c远古战场&r。"
		""
		"在战场上，你可能会看到&c成堆的盔甲残骸&r。开采这些残骸看似诱人，但却可能惊扰到曾穿戴这些盔甲的&d古代骑士&r。"
		""
		"击败其中一个才能继续前进，因为它们会掉落&c灰烬精华&r。"
		""
		"另外值得注意的是，绯红森林的&eHoglins&r会掉落名为&cHogskin&r的物品，这是某些改进版法术书配方所需的材料。"
	]
	quest.08766B8721B4E541.title: "&f来自&c下界的魔法"
	quest.0B009391E3F76D6E.quest_desc: [
		"渔夫是早期为村民提供食物的绝佳来源。希望你有足够的线资源。运气好的话，渔夫还能获得一些额外的战利品。"
		""
		"如果你的殖民地没有海洋或河流等天然水源，可以用一个 6x6x1 的水域代替。"
	]
	quest.0C15F81A6ED62029.title: "这片土地的传说"
	quest.0CA75E81F6824B22.quest_desc: [
		"如果你喜欢魔法和探索，不妨试试 &eIron's Spells 'n Spellbooks&r。这是一个超棒的魔法模组，为你添加了海量可供玩耍的咒语。"
		""
		"你可以在探索中获得&a魔法书&r，或者先制作一本&a铜制魔法书&r来存放几个法术。我们甚至会提供一个入门用的&d魔法卷轴&r！"
		""
		"这些可以作为一次性物品投掷，或放入你的&a法术书&r中，用法力随时施放。"
	]
	quest.0CA75E81F6824B22.title: "&eIron's Spells 'n Spellbooks"
	quest.0D6E099A1A242153.quest_desc: [
		"&b建造工具&r是模组里最重要的工具之一。从现在开始，你将用它来放置所有建筑。右键点击任何实体方块即可打开建造预览界面。右侧是移动、旋转、升高和降低建筑的控件。"
		""
		"放置你的&b市政厅&r方块并注册殖民地。然而，首个要建造的建筑是建造小屋。在没有完成建造小屋之前，你的市政厅无法建造。"
		""
		""
		"{image:minecolonies:textures/quests/hc_build_tool.png width:190 height:100 align:1}"
	]
	quest.0EBB4E5195610A82.quest_desc: [
		"锯木厂是木匠制作至少含75%木材物品的地方。此时，殖民地才真正开始自行运转。请务必设置好建造者常用物品的重要配方。锯木厂初始仅有10个配方，但每提升一级建筑等级，可教授的配方数量就会翻倍。"
		""
		"提示：请务必给你的木匠一个&e建造工具&r，因为某些配方需要它。"
	]
	quest.0EBB4E5195610A82.quest_subtitle: "建造一个锯木厂"
	quest.0EE0A8941A69703E.quest_desc: [
		"收集到一本&2法术卷轴&r后，我们就可以用&a铭文台&r将其刻录到我们的法术书里了。"
		""
		"在桌子的界面中，你可以插入想要刻写卷轴的咒语书。然后将咒语卷轴添加到书下方左侧的空槽中，再点击其上方的图标即可刻写咒语。"
		""
		"每本法术书能容纳的法术数量不同，我们的入门法术书只能装5或6本。最好早点升级！"
		"{@pagebreak}"
		"你也可以在界面中选择咒语，然后点击右侧的咒语卷轴将其移除。"
		""
		"将&a法术书&r装备在奇物栏中即可施放法术。"
		""
		"装备后，默认情况下按 &bR&r 键可打开卷轴轮。按 &bV&r 即可施放选中的法术。"
		""
		"这些都可以在你的按键绑定中更改。尝试搜索 &acategory:\"Iron's Spells 'n Spellbooks - General\"&r。"
		""
		"还有快速施放选项可供选择！"
	]
	quest.0EE0A8941A69703E.title: "&a刻录法术铭文"
	quest.107C26E8BF309BC1.quest_desc: [
		"在冒险中，你会遇到许多&d神秘&r战利品。"
		""
		"最常见的物品是&d秘法精华&r。可用于制作&d秘法布&r、酿造&b法力药水&r等！"
		"{@pagebreak}"
		"你还会发现&a空白符文石&r，可用于制作&2符文石&r，打造出模组中最强大的装备。杀死巫师后，也能找到&a非空白符文石&r。"
		""
		"&b秘银&r是一种传奇金属——在更深层的地下城和魔法战利品中留意它吧。"
	]
	quest.107C26E8BF309BC1.title: "&f神秘学发现 (Arcane Discoveries)"
	quest.120152510AD4B59A.quest_desc: ["虽然你可能觉得建筑师有时需要眼镜，但这副护目镜帮不了他们。建筑师护目镜是为你准备的。戴上它或放在奇物头饰栏位，你就能预览建筑在5级时的效果，这在相邻建筑搭配时很有帮助。"]
	quest.120152510AD4B59A.quest_subtitle: "是一只三头怪！"
	quest.130E8FC7479E4271.quest_desc: [
		"牧羊人小屋是牧羊人用来繁殖和屠宰绵羊以获取食物和羊毛的地方。你必须捕捉两只绵羊并带到牧羊人小屋，因为牧羊人自己不会捕捉和带回任何绵羊。"
		""
		"牧羊人每个小屋等级只会保留两只羊，所以在5级时，他们的围栏里会有十只羊。"
	]
	quest.132AF80A62FFF98D.quest_desc: [
		"撇开老生常谈，酒馆在游戏初期是优先建造的建筑，原因有几个。酒馆可以容纳四名定居者。正好是你创建村庄时生成的数量。"
		""
		"酒馆建成后，访客会前来闲逛，希望能被招募到你的殖民地。你可以通过给予他们所需物品来招募这些访客。"
		""
		"招募访客前最好先查看他们的属性，毕竟没人想花大价钱买个垃圾定居者。"
		""
		"&o&8专业提示：从靴子就能看出潜在招募者的实力。靴子越华丽，属性越好。&r&r"
	]
	quest.132AF80A62FFF98D.title: "你们在一家酒馆里相遇了……"
	quest.15B51FB56A64C303.quest_desc: [
		"许多新建筑和升级都受大学研究限制，因此应尽快建造大学。研究员会研究各种殖民地升级，每级解锁一名研究员，最多5名。每位研究员可独立进行研究，但研究员数量不会缩短单个研究所需的时间。"
		""
		"注意：研究时间是指游戏内消耗的现实时间。但3级后，研究员有时会利用离线时间来研究。"
	]
	quest.15F03A5E7E14C022.quest_desc: ["石匠是殖民地中另一个关键职业。他们制作建造者常用的物品。石匠会制作完全由鹅卵石、石头、安山岩、闪长岩、花岗岩、石英、紫晶、下界砖、海晶灯、砂岩、黑石和玄武岩制成的3x3配方。完成研究后，他们还能用鹅卵石和末影珍珠制作末地石。"]
	quest.15F03A5E7E14C022.quest_subtitle: "建造一个石匠小屋"
	quest.19D03831EB5EED02.quest_desc: ["铁匠是一个3x3的合成台，可以制作任何原版工具、盔甲、剑和盾牌（不包括弓和红石物品）。你需要教铁匠你想要他制作的物品的配方。"]
	quest.19D03831EB5EED02.quest_subtitle: "建造一个铁匠小屋"
	quest.1A4D7B2E5F8C9036.quest_desc: [
		"冰川的彼端，&b&n极光宫殿&r&r散发着冰冷的光芒。 &b雪女王&r用冷酷的蔑视指挥着她的冰傀儡。"
		""
		"快攻！近距离下她会碎裂开来。"
	]
	quest.1A4D7B2E5F8C9036.title: "&b极光宫殿"
	quest.1BB571557F74D3A1.quest_desc: ["在探索中，你可能遇到过废弃的殖民地。如果你喜欢，可以接管并修复它们，这能很好地帮助你快速起步。不过，若想体验完整的殖民地生活，建议找个好地方，用传统方式从零开始。血、汗和泪水。"]
	quest.1C16AEE8E29FB5A0.quest_desc: [
		"使用集结旗帜可将卫兵召唤至你身边。它在突袭中尤其有用，因为卫兵不会自动知道突袭者的位置。你必须按住 Shift + 右键点击卫兵塔或兵营塔上的旗帜，才能将该塔中的卫兵分配给集结旗帜。"
		""
		"注意：守卫不会跟随你离开殖民地边界。要将守卫带出边界，请在其塔GUI的第二页将其设置为跟随你。"
	]
	quest.1CFD4CE2704F2ADE.quest_desc: [
		"一旦你获得了 &b墨&r，就可以用这个在 &a法术锻造台&r 上制作新的法术卷轴。"
		""
		"每张卷轴都需要一些&b墨水&r、纸张，以及决定你要制作的&b法术学派&r的特定物品。你可以用&eJEI&r查看所有学派的物品！"
		"{@pagebreak}"
		"使用的&b墨&r的等级决定了你能制作的法术等级。某些法术只能用更高等级的墨来制作。"
		""
		"提示：与猪灵交易是获取&d哭泣的黑曜石&r的简单方法，但也还有其他方法！"
	]
	quest.1CFD4CE2704F2ADE.title: "&a合成&d法术"
	quest.1E7C4A9B3D5F2086.quest_desc: [
		"在末地的深处，邪教正等待着一位神。砍下&4真正的阿撒泻勒&r，维系着他的信仰便会随之瓦解。"
		""
		"他守护的是一扇门——门另一边的虚空不再只是一个传言。"
		""
		"&6完成此任务可解锁末地。&r"
	]
	quest.1E7C4A9B3D5F2086.title: "&5背信之门 The Faithless Gate"
	quest.201BB935C9972574.quest_desc: [
		"低级法术位改进可以通过大量&c猪皮&r和一些&b奥术布&r来制作。"
		""
		"它们可以通过&a秘法砧&r反复应用于任何&a法术书&r，最多可添加12个法术位，即使是铜制法术书也不例外！"
	]
	quest.201BB935C9972574.title: "&f法术槽改进模组"
	quest.201CB898A399F1D5.quest_desc: [
		"猪倌小屋是猪倌用来繁殖和屠宰猪来获取食物的地方。你必须捕捉并带两头猪到猪倌小屋，因为猪倌自己不会捕捉和带猪回来。"
		""
		"猪倌在每个小屋等级上只会保留两头猪，所以在第5级时，他们的围栏里会有十头猪。"
	]
	quest.206159A3C7A78447.quest_subtitle: "建造一个神秘之地 (Mystical Site)"
	quest.22F4C38E79DEFF1E.quest_desc: ["建造任何建筑（包括补给营地或船只）时，你都可以更改殖民地风格。点击“切换包”按钮，即可打开包含多种风格的菜单。在建造前想了解各种风格，可以去 YouTube 搜索“&eMineColonies Build Styles&r”。注意：此包包含视频中未展示的多种额外风格。"]
	quest.22F4C38E79DEFF1E.quest_subtitle: "待办：改进语言描述"
	quest.23012F6C4C522CEB.quest_desc: ["护林员是殖民地的重要工作者。他们会砍伐树木，并在原处种下树苗。护林员会砍伐附近的所有树木。不过，可以使用小屋方块中的&e区域规划工具&r来限制这一范围。"]
	quest.252DDDBC5923DE1E.quest_desc: [
		"&4黑暗塔&r矗立在黑暗森林中，那里是&c远古恶魂&r的巢穴——所有恶魂的愤怒母体。"
		""
		"带上你的热泪：她有很多要流。"
	]
	quest.252DDDBC5923DE1E.title: "&4黑暗之塔"
	quest.2B01B964638DFBD1.quest_desc: ["破碎机小屋是破碎机将物品粉碎成其他方块的地方。最典型的是：鹅卵石 = 砾石，砾石 = 沙子，沙子 = 黏土。需要注意的一个重要因素是，破碎机每日有基于小屋等级的限制。1级每日上限为16，2级为64。到了5级，每日上限为999。"]
	quest.2B01B964638DFBD1.quest_subtitle: "建造一个破碎机小屋"
	quest.2B5C8E1F4A7D6093.quest_desc: [
		"&d暮光巫妖&r正在塔顶等你，有僵尸和旋转的护盾守卫着他。"
		""
		"带上充满能量的盔甲和结实的弓。他的魔法地图焦点将开启下一阶段的探索。"
	]
	quest.2B5C8E1F4A7D6093.title: "&d暮色亡灵法师"
	quest.32C6E1FD67863F50.quest_desc: [
		"&d炼金术士的坩埚&r是你普通酿造台的升级版。"
		""
		"这个炼药锅可用于酿造药水，也可用于分解&b法术卷轴&r，有机会回收制作时使用的&b墨水&r。"
		""
		"这也是定期获得&c血瓶&r的主要方法。只需在炼药炉里放一个身体即可！"
	]
	quest.32C6E1FD67863F50.title: "&f&d炼金术士的坩埚</c2></c1>"
	quest.33058894ACD9CB06.quest_desc: ["墓园是守墓人埋葬已故市民的地方。当市民死亡时，死亡地点会生成一座坟墓。守墓人会在坟墓消失前尝试回收。成功的话，守墓人会回到墓园并尝试复活该市民。若无法复活，守墓人会将市民埋葬在墓园中，并在墓旁放置刻有市民名字的墓碑。"]
	quest.33058894ACD9CB06.quest_subtitle: "建造一个墓地 Graveyard"
	quest.3351C62102C45895.title: "找到一个魔法地图焦点"
	quest.342A1EF584823D2C.quest_desc: ["好吧，这个成就有点名不副实。它更像是“授人以渔”。不管怎样，重点在于，如果你教会你的建造者制作能放入2x2合成网格的简单物品（比如火把），他们就能自己制作，而不是求助于你。"]
	quest.342A1EF584823D2C.title: "永不合成 (Never Craft Again)"
	quest.37E43341FA234E84.quest_desc: [
		"花店是花匠在提供堆肥和斧头后，为殖民地种植花朵的地方。"
		""
		"需要注意的一个重要因素是，花店的每日花卉限额取决于小屋等级。1级每日上限为4，2级为8。5级时每日上限为20。"
	]
	quest.37E43341FA234E84.quest_subtitle: "建造一家花店"
	quest.3B40A769EDB26EA2.quest_desc: [
		"看上某个新成员需要些干草捆？在酒馆外放置邮箱，即可向仓库请求物品，信使会将其送到邮箱。"
		""
		"同样，如果你想把物品运送到仓库，就放在储物箱里，快递员很快就会来取走。"
	]
	quest.3B40A769EDB26EA2.title: "邮箱和储物箱"
	quest.3B91163DE3DA885C.quest_desc: [
		"这可能是最危险的工作之一，尤其是在早期。下界矿工会前往下界开采资源。矿工穿过传送门时，有死亡的风险。因此，请谨慎选择你的工人。"
		""
		"下界矿井中的传送门会将玩家传送到下界。然而，下界矿工并不会真正进入下界，也并不会在下界挖掘任何方块。"
	]
	quest.3B91163DE3DA885C.quest_subtitle: "建造一个下界矿井"
	quest.3C7A1E4B8D2F5036.quest_desc: [
		"森林各处隐藏着&eHollow Hills&r——装满宝藏与危险的大小不一的小山丘。"
		""
		"从外部挖掘空心山很危险。地牢居民并不喜欢被打扰。"
	]
	quest.3C7A1E4B8D2F5036.title: "&e空心山丘"
	quest.3ECCE23E4C41C322.quest_desc: [
		"上交 320 颗钻石。 §c完成即消耗。§r"
		""
		"§e+1 采矿技能点"
	]
	quest.3ECCE23E4C41C322.title: "钻石的贡品"
	quest.3FBEC849D51264A3.quest_desc: [
		"三颗头颅坠落，其中的火焰将由你来承载。"
		""
		"&c炽热的血液&r足够滚烫，能记住它的来处。携带它，前方的道路便会为你敞开。"
		""
		"&6完成此任务可解锁下界。&r"
	]
	quest.3FBEC849D51264A3.title: "&6通往地下的道路"
	quest.430475E11D259B74.quest_desc: [
		"石质熔炉是熔炉将鹅卵石熔成石头、石砖熔成裂纹石砖、陶土球熔成砖块、陶土块熔成赤陶、赤陶熔成上釉赤陶、所有类型的石头熔成所有类型的平滑石头，以及将原木熔成木炭的地方。它们还能爆出紫颂果！"
		""
		"请务必教导殖民地所需的熔炉配方。同时，别忘了设置燃料类型。"
	]
	quest.430475E11D259B74.quest_subtitle: "建造一个石头熔炉"
	quest.48AC8545D66B71B7.quest_desc: ["恭喜！升级建造者是重要的一步。建造者只能将其他小屋升级到自身小屋的水平。因此，要让建造者升级任何建筑，必须先升级建造者小屋。之后，建造者就能升级其他任何建筑了。"]
	quest.48AC8545D66B71B7.quest_subtitle: "升级一个建造小屋的等级"
	quest.490628CE108A833A.quest_desc: [
		"信使往返于仓库和殖民地所有工人小屋之间，为工人运送材料并将成品放入仓库。信使小屋的等级决定了信使能携带的物品数量和同时跟踪的请求数量。"
		""
		"信使不能自己工作。你必须建造一个仓库，并将信使分配到仓库工作。"
		""
		"注意：如果你有多个仓库，快递员只会看到他们被分配到的仓库里的物品。这在后期处理请求时会很有帮助。"
	]
	quest.490628CE108A833A.quest_subtitle: "建造信使小屋"
	quest.493B9FC17C3CF3CA.quest_desc: [
		"兔笼是兔牧人用来饲养和屠宰兔子的地方。你必须捕捉两只兔子并带到兔笼里，因为兔牧人自己不会捕捉兔子。"
		""
		"兔群管理者每个小屋等级只会保留两只兔子，所以在5级时，它们将拥有十只兔子在围栏里。"
	]
	quest.49793060345FB28C.quest_desc: [
		"牛仔小屋是牛仔挤奶、繁殖和屠宰奶牛以获取皮革的地方。每个小屋等级最多只能保留两头活奶牛，因此在5级时，他们将有十头奶牛在围栏中用于繁殖和屠宰。"
		""
		"注意：&e你必须自己带牛来围栏里。&r"
	]
	quest.4B7E2D5A8C1F6093.quest_desc: [
		"隐藏在黑暗森林的要塞中，&5幻影骑士&r永世驰骋。"
		""
		"每种掉落物都会掉落一件幻影盔甲——集齐一套才能获得真正的骑士之力。"
	]
	quest.4B7E2D5A8C1F6093.title: "&5骑士幻影骑士团 (Knight Phantoms)</c1>"
	quest.4B85F5D00BCEF668.quest_desc: [
		"&a任务羊驼&r生活在彩虹色彩守护的草地上。"
		""
		"带上每种颜色的羊毛各十六块，你将获得丰厚的奖励。"
	]
	quest.4B85F5D00BCEF668.title: "&a任务羊驼 (The Quest Ram)</c1>"
	quest.4D55D9FBE06DAA46.quest_desc: [
		"如果你想让你的武器、盔甲和法术书拥有更强的力量，最好的方法之一就是制作一些&3升级球&r。"
		""
		"这些球体是通过将 &a空白升级球体&r 与 8 个 &3符文&r 结合而成的。"
		""
		"要将升级球添加到你的装备上，请使用&d秘法砧&r。每件装备最多可添加3个球。"
	]
	quest.4D55D9FBE06DAA46.title: "&d升级球体"
	quest.4D9DC4973FD340E5.quest_desc: [
		"战斗学院是训练骑士成为正式骑士的地方。在这里，他们可以安全升级，而不用担心被怪物杀死。"
		"见习骑士需要剑和盾来练习。他们会攻击靶子，即一个放在干草垛上的南瓜。"
		""
		"提示：建议将招募模式设为自动，这样新招募的村民或长大的孩子，若未在学校就读，将自动开始训练"
	]
	quest.4D9DC4973FD340E5.quest_subtitle: "建造一座战斗学院"
	quest.4DD7E2BD8508A117.quest_subtitle: "建造每种牧民小屋各一个。"
	quest.55E6778A7E080BB5.title: "制作并使用制图师的焦点 (Cartographer's Focus)"
	quest.57C889EC980D33D9.quest_desc: ["我终于可以不再（那么）沉迷泥土，把农活交给别人了。我应该让农夫先种胡萝卜，因为它们也不用烹饪……"]
	quest.583A7AA84FEC027F.quest_desc: [
		"在建造任何东西之前，你需要一个建造者。建造者必须先建造自己的建造小屋，才能建造其他小屋，并且不能建造或升级小屋至高于自己小屋等级的水平。"
		""
		"建造者可以说是你殖民地最勤劳的居民（仅次于你）。你并不局限于只有一个建造者。随着殖民地的发展，你可能需要添加更多建造者才能跟得上进度。"
	]
	quest.583A7AA84FEC027F.quest_subtitle: "快把这句话念十遍试试！"
	quest.583A7AA84FEC027F.title: "建造建造者建筑 (Build the Builder Building)"
	quest.5A11A2FC20E5CE2A.quest_desc: [
		"兵营是保护殖民地的终极防御。兵营塔（与普通守卫塔不同）每建造一层就会雇佣并安置一名守卫，每座兵营塔总共可容纳5名守卫！"
		""
		"在游戏后期，你可能需要两个营房，里面塞满了&m可消耗&r的勇士。"
		""
		"提示：3级时，你可以花5金币雇佣间谍，他们会外出探索，发现野蛮人后会精确报告位置。"
	]
	quest.5A11A2FC20E5CE2A.quest_subtitle: "建造一座兵营 Barracks"
	quest.5ADD13AD705E213E.quest_subtitle: "你现在可以查看地图并创建路点了。"
	quest.5ADD13AD705E213E.title: "寻路者指南针"
	quest.5D1A4F8B2E7C9036.quest_desc: [
		"&eHighborn&r的宝座矗立在最终城堡的中心，被层层力场和哥布林所封印。"
		""
		"去发现它。去生存它。森林会铭记一切。"
	]
	quest.5D1A4F8B2E7C9036.title: "&e最后的城堡</c1>"
	quest.5E3A4A3F00FDDEC0.quest_desc: [
		"使用此模组时，&a神秘砧&r会很快成为你的最佳伙伴。"
		""
		"这把铁砧可用于&b升级法术、装备，&r甚至&b将法术附魔到你的装备上！&r"
		""
		"有喜欢的法术但觉得太弱？使用更高级的墨水，通过&a秘法砧&r来升级它！"
	]
	quest.5E3A4A3F00FDDEC0.title: "&f升级&b法术&r &f\& &a装备"
	quest.5E9A2D6F1C4B8307.quest_desc: [
		"沼泽深处隐藏着&e迷宫&r，&c牛蘑菇&r的家园——一种由牛头怪和蘑菇组成的巨型混合生物。"
		""
		"Mazebreaker 是奖品：唯一能干净利落地破坏腐化迷宫石块的武器。"
	]
	quest.5E9A2D6F1C4B8307.title: "&c牛头蘑菇人（Minoshroom）"
	quest.5FC01763770A062E.quest_desc: [
		"市政厅是殖民地中央建筑。它能提供许多关于殖民地的重要信息，例如市民统计数据、开放工作订单、市民满意度、盟友等。"
		""
		"对于新殖民者来说，设置选项卡应是首选，其中包含雇佣模式、住房分配模式和允许生育儿童的选项。此外，你还可以在此处自定义殖民地旗帜。旗帜将出现在瞭望塔和守卫盾牌上。"
	]
	quest.5FC01763770A062E.title: "市政厅"
	quest.647F95EED59927B7.quest_desc: [
		"饥饿的殖民者几乎什么都吃，包括生肉和腐肉。真恶心！"
		""
		"当市民饥饿时，他们会来餐厅，厨师会给他们食物。（前提是你有食物可给）考虑建造渔夫小屋或牛仔小屋。"
		""
		"注意：请为你的厨师选择一种燃料。常用的有木炭、木棍和木板，但任何有燃烧时间的物品都可以。"
	]
	quest.65D23E7683812E26.quest_desc: [
		"你算什么领袖！你的子民都饿得在吃腐肉了！&e你也在吃腐肉吗？&r能给殖民地分点面包或苹果吗？"
		""
		"强烈建议你建造一家餐厅和任意5个牧人小屋或渔人小屋。如果已有这些建筑，请检查它们是否拥有正常运作所需的资源。"
	]
	quest.664F7957756D84FF.quest_desc: [
		"无论你选择使用哪种魔法学派，都有一套专属于你的盔甲。"
		""
		"要制作这些，你首先需要制作&d秘法布&r。将几块布和&a符文&r组合，你就能制作出最强大的法师盔甲之一！"
	]
	quest.664F7957756D84FF.title: "&f秘法护甲"
	quest.67E8B8DCFC93F832.quest_desc: ["仓库已经建好了。可能看起来不起眼，但没有存放物品的地方，就无法建立庞大的贸易帝国。"]
	quest.68FC81E133443E76.quest_desc: [
		"图书馆能让你提升成年公民的智力技能，这会影响他们就业后的技能增长。只要公民被分配到图书馆，他们的智力就会随机提升。纸张和书籍能帮助图书馆学生更快地提升技能。"
		""
		"图书馆学生是一份全职工作，一名学生不能同时在任何其他小屋任职。"
		""
		"提示：建议将招募模式设为自动，这样新兵或长大的孩子会自动入学。"
	]
	quest.68FC81E133443E76.quest_subtitle: "建造一座图书馆"
	quest.69EAF1072D492F1A.quest_desc: [
		"远古卷轴是一本发光书籍，由掠夺者在袭击期间掉落。如果你的背包里有远古卷轴，当晚即将发生袭击时，它会发出光芒。"
		""
		"在游戏后期，附魔师可以将远古卷轴转换为附魔书。"
	]
	quest.69EAF1072D492F1A.quest_subtitle: "在快捷栏里留一个备用"
	quest.6A1D2E4F8B9C3471.quest_desc: [
		"暮色森林是一个永恒的黄昏世界，由远古首领统治。按顺序击败他们，即可解锁更深层的生物群和更稀有的宝藏。"
		""
		"你的首个敌人是盘踞在苔藓覆盖的庭院里的&aNaga&r。"
	]
	quest.6A1D2E4F8B9C3471.title: "&a纳迦的庭院"
	quest.6A60B76053393288.quest_desc: ["熔炉室是熔炉将矿石熔炼成锭的地方。熔炉室的等级越高，熔炉能使用的熔炉就越多。更高的等级也意味着每块矿石产出的锭有更高的概率翻倍甚至翻三倍。"]
	quest.6A60B76053393288.quest_subtitle: "建造一个熔炉匠台"
	quest.6AC7F38FAD40AF31.quest_desc: [
		"击败潜行者的守卫，深暗之地的盲目守护者。"
		""
		"§e+1 采矿技能点"
	]
	quest.6AC7F38FAD40AF31.title: "击杀卫道士 (Slay the Warden)"
	quest.6B0CE8AD86991E28.quest_desc: [
		"堆肥小屋是堆肥机将有机物转化为堆肥的地方，农夫或花匠可以用它来为作物或花卉施肥。"
		""
		"注意：在堆肥器开始工作前，你必须先为小屋配置好要堆肥的物品。 &7&o这听起来像绕口令一样。&r"
	]
	quest.6B0CE8AD86991E28.quest_subtitle: "建造一个堆肥小屋"
	quest.6BB0C51EE8CA5966.quest_desc: [
		"在矿井中，矿工会挖掘矿石和材料。一旦雇佣，矿工会先向下挖掘一条竖井，深度取决于矿井的层级。主竖井完成后，矿工会开始分支挖掘。挖掘过程中，矿工有时会运气好，挖到矿石块而不是普通的石块。&7&o(魔法！)&r&r"
		""
		"提示：矿工会用填充方块填补孔洞和缝隙，默认是鹅卵石。不过，你可以在矿工小屋的设置中更改填充方块。如果你有林业匠和大量木材，可以考虑使用木板。或者，现在你终于有地方用掉那些深板岩了。"
	]
	quest.6BB0C51EE8CA5966.quest_subtitle: "建造一座矿井"
	quest.6C2F5A8D1E4B7093.quest_desc: [
		"在寒冷的北方，睡着的是&b阿尔法雪怪&r。避开他的横扫——但要向他投掷雪球。"
		""
		"它的皮毛能制成王国里最保暖的盔甲。"
	]
	quest.6C2F5A8D1E4B7093.title: "&b阿尔法雪怪"
	quest.6D56AD1BEC644A10.quest_desc: [
		"弓箭训练场是训练弓箭手学徒成为弓箭手的地方。这样他们也能在没有被怪物杀死的风险下升级。"
		""
		"训练中的弓箭手需要一把弓来练习。他们会向靶子射击，靶子是一个靶子方块"
		""
		"提示：建议将招募模式设为自动，这样新招募的村民或长大的孩子，若未在学校就读，将自动开始训练。"
	]
	quest.6D56AD1BEC644A10.quest_subtitle: "建造一个射箭场 Archery"
	quest.6EEA012FA11C7C08.quest_desc: ["选定殖民地位置后，你大概会想建造补给营地或补给船。只能选其一，不能两者兼得。两者都能提供一些基础物资，助你开局。 &o&7(床、食物、基础工具和盔甲、初始资源等)&r&r 最好将补给营地或船建在殖民地附近，因为前期会频繁往返。 &e要近，但不能太近。&r"]
	quest.71FCF06A98CC66D7.quest_desc: [
		"这么多殖民者为大局努力工作，很难知道谁需要什么。剪贴板能让你轻松查看所有工人的请求。"
		""
		"&e潜行 + 右键&r城镇大厅方块以注册剪贴板。"
	]
	quest.72C749AD9F1C634E.quest_desc: [
		"居民会在夜间前往指定的住所睡觉。住所也是为殖民地获取更多居民的方式。每个住所等级都会增加一张床。更多的床意味着更高的居民容量。"
		""
		"值得考虑居民的住所和他们工作的地点。工人长途跋涉去上班时会变得很暴躁。尽量把居民搬到离工作地点近的房子去。"
	]
	quest.72C749AD9F1C634E.quest_subtitle: "建造一座住宅 Residence"
	quest.73144C13D76F25BC.quest_desc: [
		"上交12个下界合金、12个秘银和12个奥术锭。 §c完成即消耗。§r"
		""
		"§e+1 采矿技能点"
	]
	quest.73144C13D76F25BC.title: "异域金属"
	quest.74C114D0C0D4D374.quest_desc: ["还记得一开始大家好像都得了流感，你得不停地喂胡萝卜和土豆吗？医院建成后，他们就能去看医生，由治疗师治愈。你或殖民地仍需提供材料。"]
	quest.74C114D0C0D4D374.quest_subtitle: "建造一家医院"
	quest.75599A9909C7A8C8.quest_desc: ["市民需要吃东西才能工作。在拥有餐厅和稳定的食物供应之前，你需要在他们的物品栏里放些食物。他们饿了就会吃。"]
	quest.75599A9909C7A8C8.title: "又一个需要喂养的嘴巴"
	quest.7870800C28A7E199.quest_desc: [
		"养鸡人的小屋是养鸡人饲养鸡、收集鸡蛋和宰杀鸡获取食物的地方。你必须捕捉并带回两只鸡到养鸡人的小屋，因为养鸡人自己不会捕捉和带回任何鸡。"
		""
		"养鸡人每个小屋等级只会保留两只鸡，所以在5级时他们将有十只鸡。"
	]
	quest.7A2E5D8C1F4B6093.quest_desc: [
		"&c九头蛇&r栖息于由远古石材雕刻而成的巢穴中。三个头颅同时喷吐着火焰、砂浆和酸液。"
		""
		"有了九头蛇肉块，你将再也不会感到饥饿。"
	]
	quest.7A2E5D8C1F4B6093.title: "&c九头蛇怪"
	quest.7B5E2CD676A1A1C4.quest_desc: ["面包师会制作面包面团、饼干面团、蛋糕面团和生南瓜派，然后用熔炉烘焙成面包、饼干、蛋糕和南瓜派。他们只有在收到厨师、邮箱的请求，或仓库最低库存不足时才会进行制作。"]
	quest.7B5E2CD676A1A1C4.quest_subtitle: "建造一个面包店"
	quest.7F3C4A8E2D5B6190.quest_desc: [
		"一颗钻石闪耀着来自深渊的光芒。"
		""
		"将其中一个带到上方的世界，森林便会认出你。"
	]
	quest.7F3C4A8E2D5B6190.title: "深海的火花"
	quest.7F40CD616B65C8B1.quest_desc: [
		"上交 640 个铁。 §c完成即消耗。§r"
		""
		"§e+1 采矿技能点"
	]
	quest.7F40CD616B65C8B1.title: "铁的贡品"
	quest.57276A4A24A812A8.quest_desc: [
		"一个房子大小的护手在黑色石质的竞技场中漂浮，空无一物地环绕着虚空。曾经佩戴下界护手的那只手早已消失，手套却从未察觉。"
		""
		"打破它，取走它原本用手拿着的东西。"
		""
		"§eSoul Space 2级"
	]
	quest.57276A4A24A812A8.quest_subtitle: "击败下界手套（Slay the Nether Gauntlet）"
	quest.57276A4A24A812A8.title: "空无一物的手"
	quest.C0C8C9EA7FA462C8.quest_desc: [
		"在万物尽头的岛屿上，矗立着一根从未活过、却长久以来充满怒火的石柱。Obsidilith将某物折叠藏在石中，并会耗尽所有符文来守护它。"
		""
		"把柱子放下来。这已经是心跳间隙所能打开的最宽宽度了。"
		""
		"§eSoul Space 3级"
	]
	quest.C0C8C9EA7FA462C8.quest_subtitle: "击败奥布西迪利斯（Obsidilith）"
	quest.C0C8C9EA7FA462C8.title: "方尖碑所守护之物"
	quest.D634132F3F9990F0.quest_desc: [
		"在世界的某个塔里，夜巫会向靠近的任何东西投掷自己的碎片——灵魂星、彗星、自己双手的复制品。它早已放弃拥有身体，却未失去任何珍视之物。"
		""
		"取出它，掌握技巧。第二次配置在两次心跳的间隙中等待，并在死亡后跟随你的灵魂——蓄力以开启该能力，或在瞬息之间用它交换物品栏和护甲。"
		""
		"§eUnlocks the Soul Space ability at level 1"
	]
	quest.D634132F3F9990F0.quest_subtitle: "击败夜之巫妖（Night Lich）"
	quest.D634132F3F9990F0.title: "心跳之间的空隙 The Space Between Heartbeats"
	task.0D31FB2D2AF9C5F2.title: "殖民地风格"
	task.12135B574D6B6BBA.title: "你们在一家酒馆里相遇了……"
	task.3FBA4E3581607D80.title: "你对世界的理解更深了一层。"
	task.44CB12F671435930.title: "餐厅"
	task.692B36BF8DA19273.title: "找到暮色森林 (Twilight Forest)"
	task.69C59B97E310195D.title: "获取补给品"
	task.7BE92C777F0CDFCE.title: "废弃的村庄"
	chapter.67E6AD5E6C563789.title: "L_Ender's Cataclysm"
	quest.8FB749D5E10843C6.quest_desc: ["§4§l主要BOSS§r — 在诅咒金字塔中使用§e沙漠项链§r。死亡后会掉落另一条，因此可以重打。"]
	quest.8FB749D5E10843C6.quest_subtitle: "四千年以来屏住呼吸的等待"
	quest.8FB749D5E10843C6.title: "远古遗迹"
	quest.29451A41BB3DA328.quest_desc: ["§4§l主要BOSS§r — 在Frosted Prison中找到§eCursed Tombstone§r。它能开启§bcursium§r的传送门。"]
	quest.29451A41BB3DA328.quest_subtitle: "这句话比罪行存在的时间更长"
	quest.29451A41BB3DA328.title: "Maledictus"
	quest.F051835F8CE39D7B.quest_desc: ["§4§l主要BOSS§r — 制作一个§e深渊祭品§r，并在沉没城市的深渊祭坛上献上。这是模组中最昂贵的召唤仪式。"]
	quest.F051835F8CE39D7B.quest_subtitle: "深海会吞噬一切，并将其藏匿"
	quest.F051835F8CE39D7B.title: "利维坦（The Leviathan）"
	quest.1AB4319B3B386243.quest_desc: ["§4§l主要BOSS§r — 将§e燃烧灰烬§r带到燃烧竞技场的火祭坛。它会开启§6引火石§r的传送门。"]
	quest.1AB4319B3B386243.quest_subtitle: "一个学会了行走的锻造炉"
	quest.1AB4319B3B386243.title: "Ignis"
	quest.A34CB09DDD0C4D3E.quest_desc: ["§4§l主要BOSS§r — 携带一把§e奇异钥匙§r进入远古工厂。这是系列中的最后一战，能开启§8凋零矿石§r的入口。"]
	quest.A34CB09DDD0C4D3E.quest_subtitle: "为终结而生，且富有耐心"
	quest.A34CB09DDD0C4D3E.title: "先遣者 (The Harbinger)"
	quest.C78A61EBDC31AA53.quest_desc: ["§6首领§r — 守护着沙漠神殿。你第一次品尝到§e古代金属§r。"]
	quest.C78A61EBDC31AA53.quest_subtitle: "仍然盘绕在黄金之上"
	quest.C78A61EBDC31AA53.title: "瓦吉特（Wadjet）"
	quest.18F3B96180529DD7.quest_desc: ["§6首领§r — 游荡于卫城。掉落 §e珊瑚块§r。"]
	quest.18F3B96180529DD7.quest_subtitle: "珊瑚礁学会了站立"
	quest.18F3B96180529DD7.title: "珊瑚群岛"
	quest.2A9A9ED880264C93.quest_desc: ["§6首领§r — 在卫城生成。掉落§e泪晶§r和§e风暴精华§r。"]
	quest.2A9A9ED880264C93.quest_subtitle: "风暴藏起獠牙的地方"
	quest.2A9A9ED880264C93.title: "斯库拉"
	quest.20BB88576EBAA57F.quest_desc: ["§6首领§r — 击杀 §e末地傀儡§r 以开启废墟堡垒中的虚空祭坛 — 模组中唯一的双阶段传送门。"]
	quest.20BB88576EBAA57F.quest_subtitle: "这座堡垒里仍然有一位守护者"
	quest.20BB88576EBAA57F.title: "末地守卫"
	quest.84F4BF6536C7FCA4.quest_desc: ["§6首领§r — 在灵魂黑匠中生成。它有重生器，所以可以刷取。"]
	quest.84F4BF6536C7FCA4.quest_subtitle: "铁匠们从未完成的东西之一"
	quest.84F4BF6536C7FCA4.title: "下界合金怪物"
	quest.2B4782C5B70DE777.title: "&6伟大的工程"
	quest.2B4782C5B70DE777.quest_desc: [
		"&6Athanor&r 是一种炼金术士的熔炉。将&dElixir&r瓶装满&dEssence Stones&r、&bTinctures&r和&cCatalysts&r，饮用即可获得活性石的效果。"
		""
		"烧瓶本身才是难点。每位炼金术士都必须先收集&eTria Prima&r，即万物的三大原则：&fSalt&r、&cSulfur&r和&bMercury&r。"
	]
	quest.6CA4D2FD19A0FB98.title: "&f萨尔：身体部位"
	quest.6CA4D2FD19A0FB98.quest_desc: [
		"盐是身体：固定、属地的原则。"
		""
		"在盐洞中挖掘&dPink Salt&r，在地下深处的水晶峡谷中获取一个&dAllurite&r和&eLumiere&r碎片，从埋藏宝藏中挖出&bHeart of the Sea&r，并从海洋纪念碑中的&3Elder Guardian&r身上取一个&3Elder Eye&r。"
	]
	quest.3DB4B28A548BBCF2.title: "&f哲人石之盐"
	quest.3DB4B28A548BBCF2.quest_desc: [
		"将粉红盐、Allurite和Lumiere碎片与海洋之心和远古之眼相结合。"
	]
	quest.2AF2E20040855D7E.title: "&c硫磺：灵魂所在之处"
	quest.2AF2E20040855D7E.quest_desc: [
		"硫磺是灵魂：燃烧、可燃的本质。它在&c下界&r中能找到。"
		""
		"在堡垒中猎杀&8凋零骷髅&r，直到有一只掉落头颅，并收集&6烈焰棒&r和&6岩浆膏&r。"
	]
	quest.2E69D95BCFAF5344.title: "&c哲人石硫磺"
	quest.2E69D95BCFAF5344.quest_desc: [
		"将骷髅与两根烈焰棒和两个岩浆膏组合。"
	]
	quest.62BA8F77B3503219.title: "&b水星：精神体"
	quest.62BA8F77B3503219.quest_desc: [
		"水星是精神：将身体与灵魂结合在一起的易变原则。它存在于&2暮色森林&r中。"
		""
		"击败&2Naga&r获取鳞片，击败&5Twilight Lich&r获取&5Exanimate Essence&r，并从地下根部采摘&eTorchberries&r。"
	]
	quest.60EB8C4B29AD3523.title: "&b哲人汞"
	quest.60EB8C4B29AD3523.quest_desc: [
		"将两条纳迦鳞片、一具无生命精华和四颗火炬浆果组合起来。"
	]
	quest.010AF61EABD8CE01.title: "&d灵药（The Elixir）"
	quest.010AF61EABD8CE01.quest_desc: [
		"在中心放置一个玻璃瓶，并用 &eTria Prima&r 和五种宝石环绕： &5Amethyst&r、 &bDiamond&r、 &aEmerald&r、 &9Lapis&r，以及来自深暗的 &3Echo Shard&r。"
		""
		"把它带到阿塔诺尔。先加入精粹石，然后是酊剂，再是任何催化剂。注意效力上限，并记住：越强化药剂，再次饮用前等待的时间就越长。"
	]
	chapter.370198D2877502BA.title: "&d炼金术"
