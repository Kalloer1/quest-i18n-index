	file.0000000000000001.title: "AE2 对阵 RS neoforged"
	quest.0000000010A00000.quest_desc: [
		"你已经把所有东西都自动化了。"
		"你拥有无限多的资源。"
		"现在是时候成为神明的时刻了。"
		"本章需要海量的材料。希望你的生产线已经准备好了。"
	]
	quest.0000000010A00000.quest_subtitle: "终结的开端"
	quest.0000000010A00000.title: "&5游戏结束阶段"
	quest.0000000010A00010.quest_desc: [
		"在深暗或采矿维度中均可找到。"
		"它会发出金色的光芒。"
		"传送垫到达“其他”维度所必需的物品。"
	]
	quest.0000000010A00010.title: "&6Allthemodium"
	quest.0000000010A00011.quest_desc: [
		"在末地（扭曲森林/绯红森林）中可找到。"
		"中阶 Avaritia 和 Alloy 工具所需。"
	]
	quest.0000000010A00011.title: "&2振金"
	quest.0000000010A00012.quest_desc: ["在末地或战利品袋中可找到。"]
	quest.0000000010A00012.title: "&d不可获取锭"
	quest.0000000010A00013.quest_desc: [
		"混合着那些不可能混合的金属。"
		"用于Infinity之前的最高等级装备。"
	]
	quest.0000000010A00013.title: "&5终极合金 The Ultimate Alloy"
	quest.0000000010A00020.quest_desc: [
		"随着时间的推移生成成堆的中子星物质。"
		"速度很慢。慢得令人痛苦。"
		"你需要几百个这种东西。"
		"是时候扩大规模了。"
	]
	quest.0000000010A00020.title: "&8Neutronium Collector"
	quest.0000000010A00021.quest_desc: [
		"致密物质。"
		"所有 Infinity 合成所需的基础组件。"
	]
	quest.0000000010A00021.title: "&8中子星锭"
	quest.0000000010A00022.quest_desc: [
		"一个 9x9 的合成台。"
		"Singularity 配方和 Infinity Gear 所需。"
		"&c我正在寻找自动化的方法，抱歉，但目前你必须手动输入物品。"
	]
	quest.0000000010A00022.title: "&c极限合成（Extreme Crafting）"
	quest.0000000010A00023.quest_desc: [
		"使用中子星压缩机将数千个方块压缩成一个点。"
		"你需要所有类型的奇点来制作催化剂。"
		"连接好你的采石场和数字存储。你需要数百万的物品。"
	]
	quest.0000000010A00023.title: "&5奇点 (Singularities)"
	quest.0000000010A00024.quest_desc: [
		"游戏中最昂贵的物品。"
		"结合了万物的精髓。"
		"迈向神明的第一步。"
		"&cFor crafting the Cosmic Meatball, you have to find some truffle. For find the first one, go in a forest whit a pig (you can use the Mob Inprisonment Tool) and feed the pig with a golden carrot. The pig start to search truffle. When it found the truffle, a particle effect will spawn.&r"
		"&a要获得猪/疣猪火腿，需要用刀杀死它们（可以用点击机来批量获取）。猪有50%的掉落率，疣猪有100%的掉落率。"
	]
	quest.0000000010A00024.title: "&d&lInfinity Catalyst"
	quest.0000000010A00025.quest_desc: [
		"由催化剂和中子星物质锻造而成。"
		"用于制作无限盔甲和工具。"
	]
	quest.0000000010A00025.title: "&d&l无限锭"
	quest.0000000010A00026.quest_desc: [
		"你无法死亡。"
		"你无法受到伤害。"
		"你可以飞行。"
		"你处于生存模式的创造模式之中。"
	]
	quest.0000000010A00026.title: "&d&lInfinity Armor"
	quest.0000000010A00027.quest_desc: [
		"&b宇宙之剑：&r一击秒杀任何生物。即使是创造模式的玩家。"
		"&b世界破坏者：&r挖掘基岩。瞬间挖掘方块簇。可变为物质锤。"
	]
	quest.0000000010A00027.title: "&d&l宇宙的工具"
	quest.0000000010A00030.quest_desc: [
		"炼金术的钥匙。"
		"按 'C'（默认）键打开合成网格。"
		"允许对世界中的方块进行转换，并制作转换台。"
	]
	quest.0000000010A00030.title: "&e贤者之石"
	quest.0000000010A00031.quest_desc: [
		"燃烧物品以学习它们并储存其 EMC。"
		"使用 EMC 将物品取出。"
		"能量、物质、共价键是绝对的。"
	]
	quest.0000000010A00031.title: "&e转换桌台"
	quest.0000000010A00032.quest_desc: ["开始收集 EMC 能量。"]
	quest.0000000010A00032.title: "&eEMC收集器"
	quest.0000000010A00033.quest_desc: [
		"高EMC材料。"
		"用于制作高级工具和护甲（宝石护甲）。"
	]
	quest.0000000010A00033.title: "&e暗物质与红物质"
	quest.0000000010A00034.quest_desc: [
		"将你的 EMC 存储连接到数字系统 (AE2/RS/QIO) 中。"
		"输入物品以燃烧它们换取 EMC。"
		"设置一个输出物品，使用已存储的 EMC 来生成它。"
		"自动化奇点所必需的物品。"
	]
	quest.0000000010A00034.title: "&eEMC 链接"
	quest.0000000010A00035.quest_desc: [
		"可存储无限量的 EMC 能量。"
		"炼金术士的终极电池。"
	]
	quest.0000000010A00035.title: "&e最后的星辰"
	quest.0000000010A00040.quest_desc: [
		"无限FE/RF。"
		"通常使用 Avaritia/Extended 合成台或大量 Antimatter 来制作。"
		"再也不用担心电力问题了。"
	]
	quest.0000000010A00040.title: "&d创意能量方块"
	quest.0000000010A00041.quest_desc: [
		"无限水、岩浆、硫酸、反物质气体、钋元素..."
		"如果你有它的一桶/量杯，就可以无限克隆它。"
	]
	quest.0000000010A00041.title: "&d创意流体模组"
	quest.0000000010A00042.quest_desc: [
		"用于 Refined Storage 或 AE2 的创意控制器。"
		"为您的网络提供无限电力。"
		"通常与无限物品容量的创意存储磁盘搭配使用。"
	]
	quest.0000000010A00042.title: "&d创意数字存储系统"
	quest.0000000011A00000.quest_desc: [
		"厌倦了携带20本不同的指南书吗？"
		"将它们全部组合成阿卡夏魔典。"
		"&e用法：&r用一本书合成魔典。右键选择一本书。左键点击空气可将其变回魔典。"
	]
	quest.0000000011A00000.quest_subtitle: "额外部分 1"
	quest.0000000011A00000.title: "&d阿卡夏之书"
	quest.0000000011A00010.quest_desc: [
		"建筑工人的最佳伙伴。"
		"此方块可放置于空中，无需支撑方块。"
		"非常适合建造空中基地或在高天花板处放置光源。"
		"用任何工具（或手）立即破坏，它就会返回背包。"
	]
	quest.0000000011A00010.title: "&b天使方块"
	quest.0000000011A00020.quest_desc: [
		"由敌对生物掉落。"
		"提升生命值的第一个步骤。"
		"吃掉它们来恢复生命值，或者将它们制作成罐子。"
	]
	quest.0000000011A00020.title: "&c红心方块"
	quest.0000000011A00021.quest_desc: [
		"将红心合成到罐子中。"
		"装备在饰品/奇物栏位可获得永久额外生命值。"
		"最多10个容器。"
	]
	quest.0000000011A00021.title: "&c红色容器"
	quest.0000000011A00022.quest_desc: [
		"黄色之心由Boss（如凋零等）掉落。"
		"将你的红色容器升级为黄色，以获得更多生命值。"
	]
	quest.0000000011A00022.title: "&e黄色容器"
	quest.0000000011A00023.quest_desc: [
		"末影龙会掉落绿心。"
		"下一级的生命提升效果。"
	]
	quest.0000000011A00023.title: "&a绿色容器"
	quest.0000000011A00024.quest_desc: [
		"Evoker会掉落蓝色心脏。"
		"心之容器的最终层级。"
	]
	quest.0000000011A00024.title: "&9蓝色容器"
	quest.0000000011A00030.quest_desc: [
		"隐藏你丑陋的电线吧。"
		"将Facade与任意方块结合，使其外观与该方块一致。"
		"适用于几乎所有支持 Facade API 的模组中的线缆/管道。"
	]
	quest.0000000011A00030.title: "&7电缆外立面"
	quest.0000000011A00040.quest_desc: [
		"比 Octadic 要好多了。"
		"将你的 EnderIO 机器更进一步。"
	]
	quest.0000000011A00040.title: "&2Allthemodium电容器"
	quest.0000000011A00041.quest_desc: [
		"适用于 EnderIO 机器的终极电容器。"
		"极快的速度和巨大的能量容量。"
	]
	quest.0000000011A00041.title: "&5不可得电容 (Unobtainium Capacitor)"
	quest.0000000011A00050.quest_desc: [
		"测试你的伤害。"
		"放置假人并攻击它。"
		"显示 DPS（每秒伤害）和单次伤害。"
		"可以穿上盔甲来测试穿透效果。"
	]
	quest.0000000011A00050.title: "&e目标假人"
	quest.0000000011A00060.quest_desc: [
		"色彩缤纷的世界。"
		"此模组添加了数十种新的中间色（如Aquamarine、Peal、Cherine等）。"
		"所有彩色方块（羊毛、混凝土、陶瓦、玻璃）都有这些新颜色的变种。"
	]
	quest.0000000011A00060.title: "&dDyenamics"
	quest.0000000011A00070.quest_desc: [
		"在末地通过挖掘末地石矿石可以找到。"
		"最强虚空防护装备的原材料。"
	]
	quest.0000000011A00070.title: "&5末地石废料"
	quest.0000000011A00071.quest_desc: [
		"将废料组合以制作锭。"
		"用于锻造升级。"
	]
	quest.0000000011A00071.title: "&5末地合金锭"
	quest.0000000011A00072.quest_desc: [
		"使用锻造台升级你的下界合金盔甲。"
		"提供击退抗性与虚空抗性（落入虚空时会漂浮）。"
	]
	quest.0000000011A00072.title: "&5末地石盔甲"
	quest.0000000011A00073.quest_desc: [
		"比下界合金更快、更耐用。"
		"同时防火和防虚空伤害。"
	]
	quest.0000000011A00073.title: "&5末地石工具"
	quest.0000000011A00080.quest_desc: [
		"你的生物农场太吵了吗？"
		"放置此方块可静音特定区域内的特定声音。"
		"你也可以在物品栏中使用“消音按钮”来在任何地方关闭客户端的声音。"
	]
	quest.0000000011A00080.title: "&8消音器"
	quest.0000000011A00090.quest_desc: [
		"被动资源生成。"
		"1. 放置水闸。"
		"2. 将流体泵入背面（泥土/沙子/砾石用水，其他用岩浆）。"
		"3. 插入一个网格。"
		"4. 水闸会消耗其前方的方块并产生资源。"
	]
	quest.0000000011A00090.title: "&6橡木水闸"
	quest.0000000011A00091.quest_desc: ["处理速度更快了。"]
	quest.0000000011A00091.title: "&6铁质滑槽"
	quest.0000000011A00092.quest_desc: ["处理速度非常快。"]
	quest.0000000011A00092.title: "&6钻石冲砂机"
	quest.0000000011A00093.quest_desc: [
		"最快的滑道。"
		"自动化地向其中投入方块（如砾石）以获取无限矿石。"
	]
	quest.0000000011A00093.title: "&6下界合金滑槽"
	quest.0000000011A00094.quest_desc: [
		"网格决定了你能获得哪些掉落物。"
		"布 -> 铁 -> 金 -> 钻石 -> 下界合金。"
		"更高级别的网格会产出更稀有的资源。"
	]
	quest.0000000011A00094.title: "&6网格模型"
	quest.0000000012A00000.quest_desc: [
		"本章涵盖高级生物养殖工具和其他实用工具。"
		"Mob Grinding Utils 提供了一切自动化怪物掉落和经验的工具。"
	]
	quest.0000000012A00000.quest_subtitle: "额外部分 2"
	quest.0000000012A00000.title: "&2Mob Grinding Utils"
	quest.0000000012A00010.quest_desc: [
		"经典的生物击杀方块。"
		"生物在接触它们时会受到伤害。"
		"不会掉落经验值（除非是玩家被杀死）。"
	]
	quest.0000000012A00010.title: "&2尖刺陷阱"
	quest.0000000012A00011.quest_desc: [
		"终极的自动化杀戮机器。"
		"需要红石信号才能激活。"
		"内部有用于升级的库存空间。"
		"升级后可掉落仅限玩家使用的物品和经验值。"
	]
	quest.0000000012A00011.title: "&2Mob Masher"
	quest.0000000012A00012.quest_desc: [
		"右键 Mob Masher 以插入升级组件。"
		"&b锋利度：&r 造成更多伤害。"
		"&b战利品：&r掉落物更多。"
		"&b斩首：&r 掉落生物头颅的几率。"
	]
	quest.0000000012A00012.title: "&2捣碎机升级包"
	quest.0000000012A00013.quest_desc: [
		"将生物推向其面对的方向。"
		"将生物推入尖刺/捣碎机而不使用水的关键。"
		"可升级以增加范围（宽度/高度/距离）。"
	]
	quest.0000000012A00013.title: "&2Mob Fan（生物爱好者）</c1>"
	quest.0000000012A00014.quest_desc: [
		"用于吸取物品和经验的吸尘器。"
		"在可配置区域内吸起所有物品（偏移设置在GUI中）。"
		"将物品输出到物品栏（箱子）中，将流体/经验值输出到储罐中。"
	]
	quest.0000000012A00014.title: "&2吸收漏斗"
	quest.0000000012A00015.quest_desc: [
		"可储存液体经验值（及其他流体）。"
		"在侧面放置一个 XP Tap，将液态 XP 倒入球体中，以便你修复装备。"
	]
	quest.0000000012A00015.title: "&2奇点储罐和龙头</c1>"
	quest.0000000012A00016.quest_desc: [
		"用于制作生物蛋的旧版配方。"
		"右键点击生物并使用刷子收集DNA。"
		"2. 合成 Swab + 种子 + 一桶 XP = GM 鸡饲料。"
	]
	quest.0000000012A00016.title: "&2Mob Swab"
	quest.0000000012A00017.quest_desc: [
		"把这个喂给一只鸡吃。"
		"鸡会爆炸（别担心，这是为了科学）。"
		"它会掉落你刷怪所用生物的刷怪蛋。"
		"使用鸡蛋来更改刷怪器类型。"
	]
	quest.0000000012A00017.title: "&2GM 鸡饲料"
	quest.0000000012A00020.quest_desc: [
		"JAMD：又一个挖矿维度。"
		"一个专门用于采矿的维度。"
		"通常是平坦的，永远是白天，没有生物（可配置）。"
		"非常适合用于采石场和测试建筑。"
	]
	quest.0000000012A00020.title: "&7采矿维度 Mining Dimension"
	quest.0000000012A00040.quest_desc: [
		"轻松测量距离。"
		"右键单击起点，右键单击终点。"
		"会告诉你X、Y、Z的距离和总方块数。"
	]
	quest.0000000012A00040.title: "&e卷尺 Tape Measure"
	quest.0000000012A00050.quest_desc: [
		"容量超过1桶的桶子。"
		"铜、金、钻石、黑曜石等。"
		"无需管道即可手动移动流体，十分实用。"
	]
	quest.0000000012A00050.title: "&b更多水桶模组"
	quest.0000000012A00060.quest_desc: [
		"全能扳手（The Omni-Wrench）。"
		"将所有模组扳手（Crescent Hammer、Smart Wrench、Yeta Wrench 等）合并成这一件物品。"
		"当你看向某个模组的方块时，它会自动变成正确的扳手。"
	]
	quest.0000000012A00060.title: "&9Morph-o-Tool"
	quest.0000000012A00070.quest_desc: [
		"移动箱子时不会清空里面的物品。"
		"用纸张和胶带右键点击一个箱子。"
		"打破箱子。它会保留NBT数据。"
		"放置后右键单击以进行拆解。"
	]
	quest.0000000012A00070.title: "&e包装胶带"
	quest.0000000013A00000.quest_desc: [
		"实用工具的最终篇章。"
		"这里涵盖了时间操控、种族转换和物品栏管理。"
		"这些工具能让游戏运行得更加流畅。"
	]
	quest.0000000013A00000.quest_subtitle: "额外部分 3"
	quest.0000000013A00000.title: "&d生活质量和魔法增强模组包"
	quest.0000000013A00010.quest_desc: [
		"这可能是整合包里最强大的物品。"
		"1. 游戏时请将其保持在物品栏中。"
		"2. 它会被动地收集“时间”（1秒 = 1秒）。"
		"3. 右键点击机器、作物或方块实体以消耗时间并加速它们。"
		"4. 多次点击可提升速度：2倍、4倍、8倍、16倍、32倍。"
		"&c警告：&r请勿随意加速多区块结构，否则可能导致不同步。"
	]
	quest.0000000013A00010.title: "&e瓶中时光"
	quest.0000000013A00020.quest_desc: [
		"一个专注于配饰和种族转化的魔法模组。"
		"首先制作发光锭。"
		"用于酿造竞速药水与制作强力戒指。"
	]
	quest.0000000013A00020.title: "&5小饰品与珠宝盒"
	quest.0000000013A00021.quest_desc: [
		"你可以更改你的种族！"
		"喝一瓶速度药水（或使用特定的种族物品）来变身。"
		"有关各种族的具体信息，请参见周围的支线任务。"
	]
	quest.0000000013A00021.title: "&5种族转化 (Racial Transformation)"
	quest.0000000013A00022.quest_desc: [
		"&a优点：&r飞行（创造模式风格）、火焰吐息（按键绑定）。"
		"&c缺点：&r 使用法力（经验条）飞行。需要进食来恢复法力。"
		"&e饮食：&r肉类。"
	]
	quest.0000000013A00022.title: "&5种族：龙 (Dragon)</c1>"
	quest.0000000013A00023.quest_desc: [
		"&a优点：&r 创造模式飞行（低法力消耗）、体型小巧（高1格）、可攀爬。"
		"&c缺点：&r 生命值极低（最多3-4颗心），攻击力较弱。"
		"&e饮食：&r甜食（糖、饼干、发光甜瓜）。</c2>"
	]
	quest.0000000013A00023.title: "&5种族：猫薄荷（Catnip）"
	quest.0000000013A00024.quest_desc: [
		"&a优点：&r移动更快，台阶辅助（可走上方块），跳跃更高。"
		"&c缺点：&r无法穿戴重型盔甲（铁/钻石会降低速度）。"
		"&e饮食：&r蔬菜和水果。"
	]
	quest.0000000013A00024.title: "&5种族：精灵"
	quest.0000000013A00025.quest_desc: [
		"&a优点：&r体型巨大，生命值更高，攻击力更强。"
		"&c缺点：&r体型巨大，移动缓慢，需要更多食物。"
	]
	quest.0000000013A00025.title: "&5种族：泰坦 (Titan)</c1>"
	quest.0000000013A00030.quest_desc: [
		"完全抵消坠落造成的伤害。"
		"作为龙/仙女玩家，在空中耗尽法力时必备。"
	]
	quest.0000000013A00030.title: "&5惯性消除石 (Stone of Inertia Null)"
	quest.0000000013A00031.quest_desc: [
		"赋予水下呼吸和快速游泳速度。"
		"基本上能让你在水中变成人鱼形态。"
	]
	quest.0000000013A00031.title: "&5海之石"
	quest.0000000013A00032.quest_desc: [
		"永久夜视能力。"
		"以后不要再放置火把了。"
	]
	quest.0000000013A00032.title: "&5附魔之眼戒指"
	quest.0000000013A00033.quest_desc: [
		"终极磁铁。"
		"开启它可以从远处吸引物品。"
		"Shift+右键可配置设置（即时拾取、范围）。"
	]
	quest.0000000013A00033.title: "&5偏振石"
	quest.0000000013A00050.quest_desc: [
		"别再手动整理箱子了。"
		"在物品栏或箱子内&e中键&r点击即可立即整理。"
		"你可以在设置中配置排序模式。"
	]
	quest.0000000013A00050.title: "&6Inventory Essentials: Sorting"
	quest.0000000013A00051.quest_desc: [
		"学会这些能节省数小时："
		"&eShift + 点击：&r 移动物品堆。"
		"&eCtrl + 左键：&r 移动该类型的所有物品。"
		"&e空格 + 点击：&r将背包中的所有物品移至箱子（或反之）。"
	]
	quest.0000000013A00051.title: "&6Inventory Essentials: Shortcuts"
	quest.000000005A000000.quest_desc: [
		"基地周围散落着随机宝箱的日子一去不复返了。"
		"本章涵盖了从升级后的箱子和抽屉到大型数字存储网络的一切内容。"
		"选择你的道路：实体版还是数字版（或者两者都有！）。"
	]
	quest.000000005A000000.quest_subtitle: "整理混乱的局面"
	quest.000000005A000000.title: "&b储物解决方案"
	quest.000000005A000001.quest_desc: [
		"抽屉非常适合存放大量单一物品（如鹅卵石、泥土或农作物）。"
		"它们可以通过存储升级和虚空升级进行提升。"
	]
	quest.000000005A000001.title: "&6储物抽屉"
	quest.000000005A000002.quest_desc: [
		"控制器会连接所有相邻的抽屉。"
		"双击控制器上的物品，可将背包中所有匹配的物品存入连接的抽屉中。"
	]
	quest.000000005A000002.title: "&6抽屉控制器"
	quest.000000005A000003.quest_desc: [
		"存储可压缩的物品（例如，原矿 <-> 锭 <-> 方块）。"
		"允许你自动插入锭并提取方块或原矿。"
	]
	quest.000000005A000003.title: "&6压缩抽屉 (Compacting Drawer)"
	quest.000000005A000004.quest_desc: [
		"与Storage Drawers类似，但美学和升级系统有所不同。"
		"新增武器柜，用于大量存储无法堆叠的物品。"
	]
	quest.000000005A000004.title: "&6功能性存储系统 Functional Storage"
	quest.000000005A000005.quest_desc: ["一个专为无法堆叠的物品（如剑、弓和盔甲）设计的巨型储物单元。"]
	quest.000000005A000005.title: "&6武器柜"
	quest.000000005A000006.quest_desc: [
		"有时候你只需要一个特别大的箱子。"
		"建造一个由箱子墙壁组成的空心立方体。"
		"你需要一个 Colossal Chest Core 和至少一个 Interface。"
		"&e结构：&r 空心立方体（例如 3x3x3）。"
	]
	quest.000000005A000006.title: "&6巨型宝箱模组"
	quest.000000005A000007.quest_desc: [
		"可接受升级的箱子和桶。"
		"你可以添加拾取升级、冶炼升级、压缩升级等更多内容。"
	]
	quest.000000005A000007.title: "&6Sophisticated Storage"
	quest.000000005A000008.quest_desc: [
		"通过颜色链接的全局存储。"
		"将染料用于箱子顶部的三个羊毛垫上，以改变其频率。"
		"颜色组合相同的箱子在世界任何地方都共享物品栏。"
	]
	quest.000000005A000008.title: "&6末地存储系统"
	quest.000000005A000009.quest_desc: [
		"和末地箱子一样，不过是针对流体而言的。"
		"将下界岩浆或泵油转移所必需的物品。"
	]
	quest.000000005A000009.title: "&6末影坦克"
	quest.000000005A00000A.quest_desc: [
		"便携式储物单元（PSU）可以帮你存放物品。"
		"更高级别的箱子能容纳更多物品和类型。"
	]
	quest.000000005A00000A.title: "&6口袋储物箱"
	quest.000000005A00000B.quest_desc: [
		"Refined Storage 将物品转换为数字数据。"
		"你需要一个由 FE（Forge Energy）供电的控制器才能开始。"
		"用线缆将所有东西连接起来。"
	]
	quest.000000005A00000B.title: "&bRefined Storage"
	quest.000000005A00000C.quest_desc: [
		"The Grid 可以让你查看并与系统中的物品进行交互。"
		"升级到合成网格，直接从储物箱中合成物品。"
	]
	quest.000000005A00000C.title: "&b网格系统 The Grid"
	quest.000000005A00000D.quest_desc: [
		"磁盘驱动器用于存放你的存储磁盘。"
		"没有磁盘，你的系统就没有内存。"
	]
	quest.000000005A00000D.title: "&b磁盘驱动器"
	quest.000000005A00000E.quest_desc: [
		"制作你的第一个存储磁盘。"
		"1k 磁盘很小，但算是一个开始。"
		"你可以将手中的磁盘右键+Shift来取回存储部分，以便日后升级。"
	]
	quest.000000005A00000E.title: "&b存储磁盘"
	quest.000000005A00000F.quest_desc: [
		"Refined Storage 的容量上限为 64k。"
		"ExtraStorage 和 ExtraDisks 添加了更大的选项，最高可达无限大。"
	]
	quest.000000005A00000F.title: "&b额外储物空间"
	quest.000000005A000010.quest_desc: [
		"再也不会因为空间不足而烦恼了。"
		"无限存储磁盘可容纳无限数量的任何物品。"
	]
	quest.000000005A000010.title: "&b无限存储模组"
	quest.000000005A000011.quest_desc: [
		"要远程访问你的系统，需要连接到网络的无线发射器。"
		"默认情况下，它的范围有限。"
		"你还需要一个连接到控制器的无线网格。"
	]
	quest.000000005A000011.title: "&b无线访问权限已授予。"
	quest.000000005A000012.quest_desc: [
		"基本的射程升级还不够用。"
		"无线传输卡（用于发射器）可让您从同一维度的任何地方访问。"
		"维度卡允许在不同维度之间通行。"
	]
	quest.000000005A000012.title: "&b无限射程"
	quest.000000005A000013.quest_desc: [
		"为什么要携带多个物品和流体网格？"
		"通用网格将它们结合成一个便捷的设备。"
	]
	quest.000000005A000013.title: "&b通用网格 (Universal Grid)"
	quest.000000005A000014.quest_desc: [
		"标准的导入和导出器可能比较慢。"
		"使用电缆等级来制作精英、巨型和超巨型版本。"
		"这些物品堆栈每刻移动，极大地加快了自动化速度。"
	]
	quest.000000005A000014.title: "&b电缆等级系统 (Cable Tiers)"
	quest.000000005A000015.quest_desc: [
		"AE2 是一个复杂的、基于通道的存储系统。"
		"你需要先找到 Certus Quartz 并进行充能。"
		"控制器是一个多方块结构，可为你的设备提供通道。"
		"&c试试AE2的附加包！在Jei中搜索："
		"&c- appiedE"
		"&c- extendedAE&r"
		"&c- advancedAE&r"
		"&c- applied mekanistics&r"
		"&c- applied flux（用于接收、发送和储存能量，兼容flux network）"
		"&c- ae2 无线终端&r"
		"&c- ae2 universal press&r"
		"&c- ae2 导入和导出卡&r"
		"&c- 请求者&r"
		"&e其他可用功能："
		"&e- 项目：扩展高级自动化工程"
		"&e- ae2 制作树"
	]
	quest.000000005A000015.title: "&dApplied Energistics 2"
	quest.000000005A000016.quest_desc: [
		"你需要在陨石中找到 Presses（如果配方允许的话，也可以制作它们）。"
		"使用刻印机来压制几乎每个AE2合成配方中使用的电路和处理器。"
	]
	quest.000000005A000016.title: "&d处理器"
	quest.000000005A000017.quest_desc: [
		"ME 驱动器用于存放你的存储单元。"
		"与 RS 不同，AE2 的单元对物品*类型*有限制（每单元 63 种），所以整理是关键。"
	]
	quest.000000005A000017.title: "&dME 驱动器"
	quest.000000005A000018.quest_desc: [
		"标准单元的范围是 1k 到 64k。"
		"Shift+右键点击单元格，将组件与外壳分离。"
	]
	quest.000000005A000018.title: "&d存储单元"
	quest.000000005A000019.quest_desc: [
		"MegaCells 添加了远超 64k 的区块。"
		"1M、4M，最高256M。"
		"需要Sky Steel，在刻印器中合成。"
	]
	quest.000000005A000019.title: "&d巨型细胞块"
	quest.000000005A00001A.quest_desc: [
		"AE Additions 带来更多存储选项。"
		"为游戏后期提供替代的高级细胞。"
	]
	quest.000000005A00001A.title: "&dAE 附加内容模组"
	quest.000000005A00001B.quest_desc: [
		"将您的无线终端与安防终端中的系统连接。"
		"需要一个连接到网络的无线接入点。"
	]
	quest.000000005A00001B.title: "&d无线AE2"
	quest.000000005A00001C.quest_desc: [
		"将 Infinity Card 插入你的 Wireless Access Point 以移除范围和维度限制。"
		"需要消耗大量能量！"
	]
	quest.000000005A00001C.title: "&dInfinite AE2 Range"
	quest.000000005A00001D.quest_desc: [
		"P2P 隧道允许你通过单个电缆连接来传输通道、物品、流体或能量。"
		"大型基地中密集电缆的32通道限制管理必备。"
	]
	quest.000000005A00001D.title: "&dP2P 隧道系统"
	quest.000000005A00001E.quest_desc: [
		"Cable Tiers 也兼容 AE2！"
		"使用精英、巨型和超巨型总线将物品即时传输到您的ME系统中。"
	]
	quest.000000005A00001E.title: "&d电缆等级 (AE2)"
	quest.000000008A000000.quest_desc: [
		"为什么要挖矿，不能直接种地吗？"
		"神秘农业让你可以种植游戏中几乎所有的资源。"
		"从 Inferium 和 Prosperity Shards 开始。"
	]
	quest.000000008A000000.quest_subtitle: "&a资源生长系统"
	quest.000000008A000000.title: "&5神秘农业 (Mystical Agriculture)"
	quest.000000008A000001.quest_desc: [
		"要制作种子，你需要一个被8个灌注基座环绕的灌注祭坛。"
		"将目标种子/物品放在中心，配料放在基座上。"
		"施加红石信号以开始制作。"
	]
	quest.000000008A000001.title: "&5灌注祭坛"
	quest.000000008A000002.quest_desc: [
		"最为基础的精髓所在。"
		"通过击杀生物或收割 Inferium 作物获得。"
	]
	quest.000000008A000002.title: "&5Inferium Essence"
	quest.000000008A000003.quest_desc: ["使用 Inferium 和 Infusion Crystal 合成。"]
	quest.000000008A000003.title: "&5审慎精华 (Prudentium Essence)"
	quest.000000008A000004.quest_desc: ["正在变得越来越强大。"]
	quest.000000008A000004.title: "&5三合精粹"
	quest.000000008A000005.quest_desc: ["高级种子所必需的物品。"]
	quest.000000008A000005.title: "&5帝国精髓"
	quest.000000008A000006.quest_desc: [
		"基础模组中的最高等级。"
		"用于制作终极盔甲和工具。"
	]
	quest.000000008A000006.title: "&5Supremium Essence"
	quest.000000008A000007.quest_desc: [
		"由 Mystical Agradditions 添加。"
		"这就是资源生成的最高境界了。"
		"用于创造模式般的飞行和物品。"
	]
	quest.000000008A000007.title: "&5Insanium Essence"
	quest.000000008A000008.quest_desc: [
		"制作一件超优质盔甲。"
		"你需要这个来安装增强组件。"
	]
	quest.000000008A000008.title: "&5Supremium 盔甲"
	quest.000000008A000009.quest_desc: [
		"使用 Tinkering Table 将这件增强件安装到你的 Supremium Chestplate 上。"
		"允许在创造模式下飞行。"
	]
	quest.000000008A000009.title: "&5增强：飞行能力"
	quest.000000008A00000A.quest_desc: [
		"大幅地提高了你的移动速度。"
		"非常适合制作护腿或靴子。"
	]
	quest.000000008A00000A.title: "&5增幅：速度"
	quest.000000008A00000B.quest_desc: ["显著增加你的最大生命值。"]
	quest.000000008A00000B.title: "&5增强：生命值"
	quest.000000008A00000C.quest_desc: [
		"如果你有太多种子，不要把它们扔掉。"
		"再处理器可将种子转换回各自的精华。"
	]
	quest.000000008A00000C.title: "&5种子再处理器"
	quest.000000008A00000D.quest_desc: [
		"一个专注于农场、刷怪和材料加工的大型科技模组。"
		"几乎所有东西都需要 &f塑料&r。"
	]
	quest.000000008A00000D.title: "&fIndustrial Foregoing"
	quest.000000008A00000E.quest_desc: [
		"将流体提取器朝向一个原木放置。"
		"它会缓慢地分解原木并产生液态乳胶。"
		"金合欢和深色橡木能更快地产生乳胶。"
	]
	quest.000000008A00000E.title: "&f流体提取器"
	quest.000000008A00000F.quest_desc: [
		"将液态乳胶和水泵入这台机器中。"
		"它使用能量来生产微型干橡胶。"
	]
	quest.000000008A00000F.title: "&f乳胶加工"
	quest.000000008A000010.quest_desc: [
		"将9个微型干橡胶合成1个干橡胶。"
		"在熔炉中冶炼干橡胶以获得塑料。"
		"你需要一堆这样的物品。"
	]
	quest.000000008A000010.title: "&f塑料"
	quest.000000008A000011.quest_desc: ["使用流体（通常是粉红史莱姆或乳胶）和物品来制作高级机器框架和升级。"]
	quest.000000008A000011.title: "&f溶解室"
	quest.000000008A000012.quest_desc: [
		"可立即杀死生物。不会掉落物品或经验值。"
		"相反，它会产生液态肉和粉色史莱姆。"
		"粉红史莱姆是高级合成的必需品。"
	]
	quest.000000008A000012.title: "&f生物屠杀工厂"
	quest.000000008A000013.quest_desc: ["使用 Mob Essence（来自 Mob Crusher）和 Mob Imprisonment Tool 来生成实体的精确副本。"]
	quest.000000008A000013.title: "&f生物复制器"
	quest.000000008A000014.quest_desc: ["一种高级农业方块，需要水、能量和以太气体才能以最高效率运行。"]
	quest.000000008A000014.title: "&f水培床"
	quest.000000008A000015.quest_desc: [
		"激光钻基地消耗巨大能量，将虚空（或流体）转化为矿石。"
		"你必须将激光钻头连接到基座上。"
		"使用彩色透镜来定位特定矿石（例如，黄色代表黄金）。"
	]
	quest.000000008A000015.title: "&f激光采矿"
	quest.000000008A000016.quest_desc: [
		"一个用于提取灵魂的附加机器。"
		"集中攻击蓝色守卫以获得特殊灵魂资源。"
	]
	quest.000000008A000016.title: "&f灵魂提取术"
	quest.000000008A000017.quest_desc: [
		"多亏了 MIFA，你可以为你的 Industrial Foregoing 机器制作更高级别的升级。"
		"效率、速度和处理升级最高可达8级！"
	]
	quest.000000008A000017.title: "&f高级附加组件"
	quest.000000008A000019.quest_desc: [
		"建造熔炉结构。"
		"你需要："
		"- 1 铸造控制器 Foundry Controller"
		"- 熔炉储罐（用于熔岩/燃料）"
		"- 熔炉玻璃或结构方块"
		"- 输入/输出表格或水槽"
	]
	quest.000000008A000019.title: "&8高效金属工艺模组"
	quest.000000008A00001A.quest_desc: [
		"使用铸造台铸造锭（需要模具），使用铸造盆铸造方块。"
		"熔化的金属从熔炉中倒入这些方块中。"
	]
	quest.000000008A00001A.title: "&8铸造中"
	quest.000000009A000000.quest_desc: [
		"欢迎来到力量时代。"
		"运行机器需要Forge能量（FE）。"
	]
	quest.000000009A000000.quest_subtitle: "为世界注入动力"
	quest.000000009A000000.title: "&c能量生成"
	quest.000000009A000001.quest_desc: [
		"适合游戏前期的基础太阳能电池板。"
		"查看 @solargeneration、@energizedpower 和 @powah 以寻找其他太阳能电池板。"
	]
	quest.000000009A000001.title: "&cSolar Flux"
	quest.000000009A000002.quest_desc: [
		"中盘游戏用的中间太阳能电池板。"
		"查看 @solargeneration、@energizedpower 和 @powah 以寻找其他太阳能电池板。"
	]
	quest.000000009A000002.title: "&c中阶太阳能板"
	quest.000000009A000003.quest_desc: [
		"用于游戏后期的先进太阳能电池板。"
		"查看 @solargeneration、@energizedpower 和 @powah 以寻找其他太阳能电池板。"
	]
	quest.000000009A000003.title: "&c高级太阳能系统"
	quest.000000009A000004.quest_desc: ["中后期超好用的模组！介电浆是所有方块的基础，铀矿是反应堆燃料。"]
	quest.000000009A000004.title: "&c太棒了！"
	quest.000000009A000005.quest_desc: ["通过燃烧物品来产生能量。"]
	quest.000000009A000005.title: "&cFurnator熔炉器"
	quest.000000009A000006.quest_desc: [
		"用岩浆来产生能量。"
		"提示：你可以使用熔岩发电机升级（功能性存储）或流体泵。"
	]
	quest.000000009A000006.title: "&c岩浆怪"
	quest.000000009A000007.quest_desc: ["在这个方块下方放置一个熔岩块，它就能产生能量。"]
	quest.000000009A000007.title: "&c热能发电机"
	quest.000000009A000008.title: "&c能量球体"
	quest.000000009A000009.title: "&c能量化钢锭"
	quest.000000009A00000A.title: "&c烈焰水晶"
	quest.000000009A00000B.title: "&cNiotic Crystal"
	quest.000000009A00000C.title: "&c灵性水晶"
	quest.000000009A00000D.title: "&c氮化镓晶体"
	quest.000000009A00000E.quest_desc: [
		"放置36个方块即可建造反应堆（只需放置一个方块，结构将自动建造）。"
		"升级等级时，必须将储能棒通过模组的能量管道直接连接到反应堆。此棒必须朝向储能球体，"
		"按住 G 键查看指南。"
	]
	quest.000000009A00000E.title: "&c反应堆"
	quest.000000009A00000F.title: "&c玩家发射器"
	quest.000000009A000010.quest_desc: [
		"Immersive Engineering 是一款注重真实电力系统与工业机械的科技模组。它摒弃了发光的方块，转而采用大型多方块结构、架空电线，以及 Revolver 和 Chemical Thrower 等实用工具。该模组强调沉浸感与视觉细节，让复杂的自动化系统宛如真实的重工业操作。"
		"使用手册来建造多方块结构。"
	]
	quest.000000009A000010.quest_subtitle: "https://ftbwiki.org/Immersive_Engineering"
	quest.000000009A000010.title: "&c沉浸式工程学"
	quest.000000009A000011.quest_desc: ["水轮放置在流动的水旁时会产生旋转力，从而在游戏早期提供可再生能源。通过将水轮连接到动能发电机，可将这种动能转化为IF（沉浸式通量），而动能发电机是机械运动与电网之间必不可少的接口。"]
	quest.000000009A000011.title: "&c动能之力"
	quest.000000009A000012.quest_desc: ["电线和连接器通过可见的架空线路实现配电，摒弃了其他模组中常见的“隐藏电缆”。你必须将连接器安装在机器上，并使用继电器进行长距离传输，手动在它们之间串起线圈，以创建一个逼真的工业电网。"]
	quest.000000009A000012.title: "&c电线和连接器"
	quest.000000009A000013.quest_desc: ["无线传输能量的不可思议方法！"]
	quest.000000009A000013.title: "&cFlux Networks"
	quest.000000009A000014.quest_desc: ["使用插头将能量发送到流控制器。在机器上使用流点以从控制器接收能量。"]
	quest.000000009A000014.title: "&c网络组件"
	quest.000000009A000015.quest_subtitle: "一个电池，"
	quest.000000009A000015.title: "&cFlux Storage"
	quest.000000009A000016.quest_desc: ["创造能量的另一种方法而已。"]
	quest.000000009A000016.quest_subtitle: "https://ftb.fandom.com/wiki/Deep_Resonance"
	quest.000000009A000016.title: "&c深层共振"
	quest.000000009A000017.quest_desc: ["查看维基以了解多方块结构的建造方法。"]
	quest.000000009A000017.quest_subtitle: "https://ftb.fandom.com/wiki/Deep_Resonance"
	quest.000000009A000017.title: "&c水晶发电机"
	quest.000000009A000018.quest_desc: [
		"又一个太阳能电池板模组（以及更多内容）。"
		"更多信息请查看维基页面。"
	]
	quest.000000009A000018.title: "&c充满活力的能量"
	quest.000000009A000019.quest_desc: ["一个简单的机器，可以为工具提供充能。"]
	quest.000000009A000019.title: "&c充电站"
	quest.000000009A000020.quest_desc: ["Industrial Foregoing 是一个大型工业自动化模组，提供多种用于农业、资源加工和辅助的机器。能源方面，主要通过垂体发电机（使用恶魂之泪）或菌丝发电机，消耗作物、炸药或附魔物品等多样资源来产生大量 RF/FE。"]
	quest.000000009A000020.quest_subtitle: "https://ftb.fandom.com/wiki/Industrial_Foregoing"
	quest.000000009A000020.title: "&c工业先行电力模组"
	quest.000000009A000021.quest_desc: ["Industrial Foregoing 的生物燃料是一种在生物反应器中通过处理种子、树苗和作物等有机物生产的液体燃料。其主要用途是为生物燃料发电机提供动力以实现高效发电，同时也是制造粉色史莱姆和高级塑料组件所必需的。"]
	quest.000000009A000021.title: "&c生物燃料发电"
	quest.000000009A000022.quest_desc: ["菌丝反应堆是一种高级多方块结构，可同时运行所有16种不同类型的菌丝发电机，产生巨量的FE。它作为中央枢纽，消耗这些发电机产生的综合“精华”，以提供持续不断的终局游戏级别电力输出。"]
	quest.000000009A000022.title: "&c菌丝反应堆"
	quest.000000009A000023.quest_subtitle: "还有更多的附加包。请查看 JEI。"
	quest.000000009A000023.title: "&cMIFA 附加组件"
	quest.00000000AA000000.quest_desc: [
		"本章适用于我自制模组：&6NeoGundam&r，将引导你了解 NeoGundam 添加的专属物品、强力齿轮和装饰品。"
		"做好准备，因为其中一些物品将彻底改变你的游戏体验。"
	]
	quest.00000000AA000000.quest_subtitle: "从这里开始"
	quest.00000000AA000000.title: "&e欢迎！"
	quest.00000000AA000001.quest_desc: [
		"NeoGundam 中最重要的资源。"
		"这团尘埃散发着巨大的能量。"
		"&e获取方法：&r必须在高炉中熔炼&bBEDROCK&r。"
		"用于制作游戏后期的物品。"
	]
	quest.00000000AA000001.title: "&6Gundamite"
	quest.00000000AA000002.quest_desc: [
		"由高达合金锻造而成的传奇武器。"
		"打击感很强，但真正的力量在于它的魔法。"
		"&e特殊能力：&r按住并按下&b'K'&r，即可在敌人身上召唤闪电。"
		"成为风暴本身。"
	]
	quest.00000000AA000002.title: "&cJuki's Sword"
	quest.00000000AA000003.quest_desc: [
		"Tier 3（终极）合金。"
		"将强化合金与精炼黑曜石粉尘融合而成。"
	]
	quest.00000000AA000003.title: "&3原子合金"
	quest.00000000AA000004.quest_desc: [
		"Tier 4 合金（额外内容）。"
		"事情变得越来越严重了。"
	]
	quest.00000000AA000004.title: "&d光辉合金"
	quest.00000000AA000005.quest_desc: ["Tier 5 合金（额外内容）。"]
	quest.00000000AA000005.title: "&d热核合金"
	quest.00000000AA000006.quest_desc: [
		"Tier 6 合金（额外内容）。"
		"由宇宙的力量驱动。"
	]
	quest.00000000AA000006.title: "&d闪耀合金"
	quest.00000000AA000007.quest_desc: [
		"最终的合金。"
		"用于创造模式物品和无限能力。"
	]
	quest.00000000AA000007.title: "&d光谱合金"
	quest.00000000AA000008.quest_desc: [
		"基础机器的核心大脑。"
		"将锇锭与红石融合而成。"
	]
	quest.00000000AA000008.title: "&3基础控制电路"
	quest.00000000AA000009.quest_desc: [
		"用于精英工厂和高级科技。"
		"将基础电路与强化合金融合而成。"
	]
	quest.00000000AA000009.title: "&3高级控制电路"
	quest.00000000AA00000A.quest_desc: [
		"用于高级机械的制造材料。"
		"将高级电路与强化合金融合而成。"
	]
	quest.00000000AA00000A.title: "&3精英控制电路"
	quest.00000000AA00000B.quest_desc: [
		"最高等级的基础电路。"
		"用于聚变反应堆、SPS 和 QIO 驱动器。"
	]
	quest.00000000AA00000B.title: "&3终极控制电路"
	quest.00000000AA00000C.quest_desc: ["Extras Tier 4 Circuit."]
	quest.00000000AA00000C.title: "&d绝对控制电路"
	quest.00000000AA00000D.quest_desc: ["Extras Tier 5 Circuit."]
	quest.00000000AA00000D.title: "&d至高控制电路"
	quest.00000000AA00000E.quest_desc: ["Extras Tier 6 Circuit."]
	quest.00000000AA00000E.title: "&d宇宙控制电路"
	quest.00000000AA00000F.quest_desc: [
		"最终的电路。"
		"无限的处理能力。"
	]
	quest.00000000AA00000F.title: "&d无限控制电路"
	quest.00000000AA000010.quest_desc: [
		"终极装备。"
		"这套盔甲无法通过常规方式制作。"
		"&eSource:&r You can find these pieces in Loot Chests (Dungeons, End Cities, etc.), whit &crarity&r 0.03% chance and in Loot Reward whit &crarity&r 0.05% in High Tier Loot Reward, 0.03% in Industrial Loot Reward and 0.01% in Misc and Resource Loot Reward"
	]
	quest.00000000AA000010.title: "&5仙女座盔甲套装"
	quest.00000000AA000011.quest_desc: [
		"群星之冠，指引航向的星盔。"
		"提供以下永久效果："
		"- &b水下呼吸：&r无需恐惧，探索深海。"
		"- &b饱食度：&r你将永远不再需要进食。"
		"- &b夜视：&r 能看清一切事物。"
	]
	quest.00000000AA000011.title: "&5仙女座头盔"
	quest.00000000AA000012.quest_desc: [
		"套装的核心部件。"
		"提供以下永久效果："
		"- &b健康提升：&r大幅提升你的最大生命值。"
		"- &b加速：&r 瞬间挖掘方块。"
		"- &b抗性：&r无视伤害，如履平地。"
	]
	quest.00000000AA000012.title: "&5仙女座胸甲"
	quest.00000000AA000013.quest_desc: [
		"在虚空之中锻造的护腿。"
		"提供以下永久效果："
		"- &b跳跃增强：&r越过墙壁跳跃。"
		"- &b火焰抗性：&r安全地在岩浆中游泳。"
	]
	quest.00000000AA000013.title: "&5仙女座腿甲 (Andromeda Leggings)"
	quest.00000000AA000014.quest_desc: [
		"无限运动的靴子。"
		"提供以下永久效果："
		"- &b速度：&r在陆地上移动得更快。"
		"- &b海豚的恩赐：&r在水下移动速度极快。"
	]
	quest.00000000AA000014.title: "&5仙女座靴子"
	quest.00000000AA000015.quest_desc: [
		"移动至 HEAT 处。"
		"用于将热量从电阻加热器传输到热蒸发装置，或从裂变反应堆传输到锅炉。"
	]
	quest.00000000AA000015.title: "&3热力学导体"
	quest.00000000AA000016.quest_desc: [
		"最快的基础物品运输管道。"
		"升级管道可以增加吞吐量和泵送速度。"
	]
	quest.00000000AA000016.title: "&3终极运输机模组"
	quest.00000000AA000017.quest_desc: [
		"Mekanism 附加内容等级。"
		"物品可即时移动。"
	]
	quest.00000000AA000017.title: "&dInfinite Transporter"
	quest.00000000AA000018.quest_desc: [
		"&b配置器：&r 扳手。Shift+右键管道末端可更改推/拉模式。Shift+滚轮可更改模式（气体/流体/物品/能量）。右键管道中心可更改颜色代码。"
		"&bGauge Dropper:&r 清除机器内部储罐中液体/气体的必备品。右键机器可抓取内容物，Shift+右键空气可倾倒。"
		"&b词典：&r显示物品标签和OreDict条目。"
	]
	quest.00000000AA000018.title: "&3工程师工具包"
	quest.00000000AA00001A.quest_desc: ["无限流体传输。"]
	quest.00000000AA00001A.title: "&d无限机械管道 (Infinite Mechanical Pipe)"
	quest.00000000AA00001B.quest_desc: ["无限气体传输。"]
	quest.00000000AA00001B.title: "&d无限加压管道"
	quest.00000000AA00001C.quest_desc: ["无限能量传输。"]
	quest.00000000AA00001C.title: "&d无限通用线缆"
	quest.00000000AA00001D.quest_desc: ["无限热量传输。"]
	quest.00000000AA00001D.title: "&d无限热传导器"
	quest.00000000AA000020.quest_desc: [
		"多人游戏必备物品。"
		"现在是晚上吗？幻影在困扰你吗？"
		"使用Sleeper可立即将时间设置为白天。"
		"&#FF8F8A注意：此方块每晚会将世界总天数设为0，若想要连续的时间线，请勿使用此方块。&r"
		"如果你在多人服务器中，请使用命令 /gamerule playersSleepingPercentage 1。"
		"无需所有玩家都睡在床上，它也能正常运行。"
	]
	quest.00000000AA000020.title: "&e沉睡者"
	quest.00000000AA000021.quest_desc: [
		"终极的洞穴探险工具。"
		"&e用法：&r 将其握在非主手。"
		"如果光照等级降至0（完全黑暗），它会自动在你的脚下放置一个火把。"
		"&e机制：&r 它不会消耗你背包里的火把。相反，高温火把本身会受损并最终破碎。"
	]
	quest.00000000AA000021.title: "&6火把棒"
	quest.00000000AA000022.quest_desc: [
		"安全第一。"
		"佩戴此头盔时，可获得&b缓慢降落&r效果。"
		"再也不会因为掉进峡谷或深洞而死亡了。"
		"在找到 Andromeda 装备前，早期探索必备。"
	]
	quest.00000000AA000022.title: "&6矿工帽"
	quest.00000000AA000023.quest_desc: [
		"凋零者这个boss很危险，因为它会造成凋零效果。"
		"此定制药水可完全免疫凋零的伤害。"
		"战斗前把它喝掉！"
	]
	quest.00000000AA000023.title: "&8凋零抗性（Wither Resistance）"
	quest.00000000AA000024.quest_desc: [
		"一个多区块塔。"
		"加热流体以使其浓缩。"
		"水 -> 盐水。"
		"盐水 -> 液态锂。"
		"4x/5x 处理和融合的关键材料。"
		"甚至可用于核裂变反应堆的原料。"
	]
	quest.00000000AA000024.title: "&3热蒸发工艺（Thermal Evaporation）"
	quest.00000000AA000025.quest_desc: [
		"将你的矿石数量增加五倍。"
		"1. &b溶解室：&r 使用硫酸将矿石溶解成浆料。"
		"2. &bWasher:&r 用水清洗泥浆混合物。"
		"3. &b结晶器：&r将干净的浆料转化为晶体。"
	]
	quest.00000000AA000025.title: "&3溶解与结晶（五重化）"
	quest.00000000AA000026.quest_desc: [
		"5倍加工所需的化学链配方。"
		"硫磺 -> 二氧化硫 -> 三氧化硫 -> 硫酸。"
		"需要氧气和水蒸气。"
	]
	quest.00000000AA000026.title: "&3硫酸链任务书"
	quest.00000000AA000030.quest_desc: [
		"NeoGundam 添加了所有 16 种 Minecraft 颜色的石砖！"
		"你不再局限于灰色的城堡了。"
		"每种颜色都有一整套：砖块、楼梯、半砖、墙壁、栅栏、栅栏门、活板门和门。"
	]
	quest.00000000AA000030.title: "&b建造万花筒世界"
	quest.00000000AA000031.quest_desc: [
		"合成一些红石砖。"
		"在 JEI 中查看配方。"
	]
	quest.00000000AA000031.title: "&c红石砖块"
	quest.00000000AA000032.quest_desc: [
		"合成一些蓝色石头砖块。"
		""
	]
	quest.00000000AA000032.title: "&c蓝色石砖台阶"
	quest.00000000AA000033.quest_desc: [
		"合成一些黄色石头砖台阶。"
		""
	]
	quest.00000000AA000033.title: "&e黄色石头砖台阶"
	quest.00000000AA000034.quest_desc: [
		"不仅仅是一道普通的栅栏。"
		"这种特殊栅栏只在夜间发出光亮。"
		"用它来时尚地照亮你的道路，而无需大量放置火把。"
	]
	quest.00000000AA000034.title: "&6红石围栏"
	quest.00000000AA000035.quest_desc: [
		"最终材料（UU物质等价物）。"
		"用于创造模式物品、重力操控和违背物理定律。"
	]
	quest.00000000AA000035.title: "&d反物质"
	quest.00000000AA000040.quest_desc: [
		"Mekanism 的数字化存储系统。"
		"超大容量，跨维度无线访问。"
		"需要波洛尼ウム才能制作。"
	]
	quest.00000000AA000040.title: "&3QIO 存储系统"
	quest.00000000AA000041.quest_desc: ["每个驱动器可存储 160 亿个物品。"]
	quest.00000000AA000041.title: "&3超大容量QIO驱动器"
	quest.00000000AA000050.quest_desc: [
		"终极模块化动力盔甲。"
		"只要有能量，就能保护你免受辐射和虚空伤害等一切伤害。"
		"使用Modification Station安装模组。"
	]
	quest.00000000AA000050.title: "&3MekaSuit"
	quest.00000000AA000051.quest_desc: [
		"一款通用的多功能工具。"
		"挖矿速度极快，快到离谱。"
		"右键模式：脉矿挖掘、快速、缓慢、关闭。"
	]
	quest.00000000AA000051.title: "&3原子分解器"
	quest.00000000AA000052.quest_desc: [
		"原子分解器之后的下一步骤。"
		"完全模块化：可添加丝绸之触、时运、传送、农场单位等。"
	]
	quest.00000000AA000052.title: "&3Meka-Tool"
	quest.00000000AA000060.quest_desc: [
		"用于将机器升级为工厂。"
		"基础：3 个槽位。"
		"高级：5 个插槽。"
		"精英：7 个物品栏。"
		"终极：9 个物品栏。"
		"Shift-右键点击机器以应用。"
	]
	quest.00000000AA000060.title: "&3工厂安装器"
	quest.00000000AA000061.quest_desc: ["Extras Tier 5 工厂。"]
	quest.00000000AA000061.title: "&d绝对安装器"
	quest.00000000AA000062.quest_desc: ["Extras Tier 6 工厂。"]
	quest.00000000AA000062.title: "&d至尊安装器"
	quest.00000000AA000063.quest_desc: ["Extras Tier 7 工厂。"]
	quest.00000000AA000063.title: "&d宇宙安装器"
	quest.00000000AA000064.quest_desc: ["工厂的最终升级。"]
	quest.00000000AA000064.title: "&d无限安装器"
	quest.00000000BA000000.quest_desc: [
		"我们正在迈向更复杂的管道系统。"
		"本章介绍了复杂逻辑、多区块管理和空间压缩。"
		"掌握这些工具后，你将能自动化一切事情。"
	]
	quest.00000000BA000000.quest_subtitle: "高级逻辑与线路规划"
	quest.00000000BA000000.title: "&d高级自动化系统 (Advanced Automation)"
	quest.00000000BA000010.quest_desc: [
		"XNet 是一个极其强大的物品、流体、能量和气体传输系统。"
		"&b控制器&r是核心。它需要FE能量。"
		"与其他管道不同，XNet 在控制器 GUI 中编程前不会执行任何操作。"
		"你可以在单根线缆上处理复杂的逻辑。"
	]
	quest.00000000BA000010.title: "&bXNet 控制器"
	quest.00000000BA000011.quest_desc: [
		"电缆将控制器连接到您的机器上。"
		"它们有 4 种颜色（蓝色、红色、绿色、黄色）。"
		"&e注意：&r不同颜色的线缆无法相互连接，除非使用连接器。"
		"这样你就可以在同一个方块空间里运行并行网络了。"
	]
	quest.00000000BA000011.title: "&b网络电缆"
	quest.00000000BA000012.quest_desc: [
		"在你想交互的机器上放置一个连接器。"
		"在控制器中，你可以为这个连接器命名（例如，“熔炉输入”），以方便编程。"
		"一个连接器可以同时处理物品、流体、能量和逻辑信号。"
	]
	quest.00000000BA000012.title: "&b连接器"
	quest.00000000BA000013.quest_desc: [
		"标准连接器速度很慢。"
		"右键点击连接器并使用此升级，使其速度更快。"
		"高吞吐量系统的必备组件。"
	]
	quest.00000000BA000013.title: "&b连接器升级"
	quest.00000000BA000014.quest_desc: [
		"把你的 XNet 线缆藏起来。"
		"模仿其被涂绘的方块的外观。"
	]
	quest.00000000BA000014.title: "&b建筑外立面"
	quest.00000000BA000015.quest_desc: [
		"允许你远程将多个 XNet 控制器连接在一起。"
		"无需拉长长的线缆，即可在基地的不同区域之间共享数据或物品。"
	]
	quest.00000000BA000015.title: "&b网络路由器"
	quest.00000000BA000020.quest_desc: [
		"这个方块可以让你远程与另一个方块进行交互。"
		"它会创建一个“量子纠缠”效果。"
		"将物品导入此方块，它们会进入连接的方块，无论该方块位于何处。"
		"非常适合隐藏杂乱的线缆，或者从多个侧面访问机器。"
	]
	quest.00000000BA000020.title: "&d纠缠方块 (Entangled Block)"
	quest.00000000BA000021.quest_desc: [
		"用于链接纠缠方块。"
		"1. 用绑定器右键点击目标方块（例如，熔炉）。"
		"2. 用绑定器右键点击纠缠方块。"
		"3. 完成！两者现已关联成功。"
	]
	quest.00000000BA000021.title: "&d纠缠的装订本"
	quest.00000000BA000030.quest_desc: [
		"即使你不在，也能保持一小片区域加载。"
		"自动化农场和机器的必备品。"
		"右键点击以显示已加载的区域。"
	]
	quest.00000000BA000030.title: "&a基础区块加载器"
	quest.00000000BA000031.quest_desc: [
		"加载一个更大的区域。"
		"可配置的半径范围。"
	]
	quest.00000000BA000031.title: "&a高级区块加载器"
	quest.00000000BA000032.quest_desc: [
		"最大区块加载大小。"
		"适用于你的工厂真正庞大的时候。"
	]
	quest.00000000BA000032.title: "&a终极区块加载器"
	quest.00000000BA000040.quest_desc: [
		"进入 Compact Machines 的钥匙。"
		"右键点击 Compact Machine 方块，即可传送至内部。"
		"在内部任意位置右键即可传送回外部。"
		"同时也作为手册使用。"
	]
	quest.00000000BA000040.title: "&6个人缩小装置"
	quest.00000000BA000041.quest_desc: [
		"单个方块内部的一个3x3x3房间。"
		"小巧实用，适合简单的自动化操作。"
	]
	quest.00000000BA000041.title: "&6微型机器"
	quest.00000000BA000042.quest_desc: ["一个5x5x5的房间。"]
	quest.00000000BA000042.title: "&6小型机器"
	quest.00000000BA000043.quest_desc: [
		"一个 7x7x7 的房间。"
		"大多数配置的标准尺寸。"
	]
	quest.00000000BA000043.title: "&6普通机器"
	quest.00000000BA000044.quest_desc: ["一个9x9x9的房间。"]
	quest.00000000BA000044.title: "&6大型机器"
	quest.00000000BA000045.quest_desc: ["一个11x11x11的房间。"]
	quest.00000000BA000045.title: "&6巨型机器"
	quest.00000000BA000046.quest_desc: [
		"一个13x13x13的房间。"
		"可用的最大空间。"
	]
	quest.00000000BA000046.title: "&6最大机器"
	quest.00000000BA000047.quest_desc: [
		"所有紧凑型机器的制作材料。"
		"用镐子可以破坏机器内部的物品。"
	]
	quest.00000000BA000047.title: "&6机械墙壁"
	quest.00000000BA000050.quest_desc: [
		"欢迎来到 Ender IO。"
		"要开始，你需要无限之粒。"
		"在基岩上点燃火焰，等待它熄灭（或者将其扑灭）。"
	]
	quest.00000000BA000050.title: "&2末地IO：开端"
	quest.00000000BA000051.quest_desc: ["所有简易机械的基础方块。"]
	quest.00000000BA000051.title: "&2机器底盘"
	quest.00000000BA000053.quest_desc: [
		"动力版本。"
		"速度快得多，并且运行于FE。"
		"有3个用于高级合金的输入槽位。"
	]
	quest.00000000BA000053.title: "&2合金熔炉"
	quest.00000000BA000054.quest_desc: [
		"研磨矿石和物品。"
		"产生粉尘和额外产出。"
		"使用研磨球（暗钢、燧石等）来提高效率和产量。"
	]
	quest.00000000BA000054.title: "&2球磨机"
	quest.00000000BA000055.quest_desc: [
		"使用固体燃料来产生电力。"
		"可用电容器升级以产生更多RF/t。"
	]
	quest.00000000BA000055.title: "&2斯特林发电机"
	quest.00000000BA000056.quest_desc: [
		"用于制作机器头和复杂组件。"
		"机器内需要剪刀和斧头才能正常工作。"
	]
	quest.00000000BA000056.title: "&2切片与拼接"
	quest.00000000BA000057.quest_desc: [
		"使用经验值（液态经验）将灵魂瓶绑定到物品上。"
		"用于生成器和升级暗钢工具所必需。"
	]
	quest.00000000BA000057.title: "&2灵魂绑定器"
	quest.00000000BA000058.quest_desc: [
		"使用电力来生成生物。"
		"需要用锻造台或灵魂绑定器与破损刷怪笼结合，以设置生物类型。"
	]
	quest.00000000BA000058.title: "&2动力刷怪器"
	quest.00000000BA000060.quest_desc: [
		"现存最通用的管道类型。"
		"你可以在同一个方块中放置物品、流体、能量和红石导管。"
		"使用 Yeta Wrench 配置输入/输出。"
		"使用过滤器来控制物品的流动。"
	]
	quest.00000000BA000060.title: "&2Ender IO 导管"
	quest.00000000BA000071.quest_desc: [
		"一把能阻止末影人传送的剑。"
		"伤害高，可升级。"
	]
	quest.00000000BA000071.title: "&2末影人（The Ender）"
	quest.00000000BA000072.quest_desc: [
		"允许在锚点之间进行传送。"
		"站在一个方块上，看向另一个方块即可跳跃。"
		"手持旅行法杖，可从远处跳跃至任意锚点。"
	]
	quest.00000000BA000072.title: "&2旅行锚点"
	quest.00000000BA000073.quest_desc: [
		"可存储无限量的液态经验值。"
		"非常适合修理工具或保存进度。"
	]
	quest.00000000BA000073.title: "&2经验方尖碑"
	quest.00000000BA000074.quest_desc: [
		"没有这些，机器运转会很慢。"
		"基础 -> 双层 -> 八重结构。"
		"每个等级都会大幅提升速度和能量缓冲量。"
	]
	quest.00000000BA000074.title: "&2电容器"
	quest.00000000CA000000.quest_desc: [
		"RFTools 是一个包含强大工具、实用程序和创建完整维度功能的模组集合。"
		"智能扳手是你配置机器和选择模式的主要工具。"
		"Shift+右键空气可切换模式。"
	]
	quest.00000000CA000000.quest_subtitle: "科技与方块世界"
	quest.00000000CA000000.title: "&9RFTools 套件"
	quest.00000000CA000001.quest_desc: [
		"RFTools机器的核心材料。"
		"在RFTools Dimensions中，或在生成时偶尔出现在主世界/下界/末地。"
		"你也可以制作机器，用这些碎片“注入”其他机器，以提高它们的速度和效率。"
	]
	quest.00000000CA000001.title: "&9维度碎片 (Dimensional Shards)"
	quest.00000000CA000002.quest_desc: [
		"几乎所有 RFTools 机器的基础组件。"
		"习惯制作这些东西吧。"
	]
	quest.00000000CA000002.title: "&9机器框架"
	quest.00000000CA000010.quest_desc: [
		"创造世界的第一步。"
		"这台机器能让你将某个维度的DNA'写入'一个空维度标签中。"
		"你插入“Dimlets”（如群系、材质、天空颜色等）来定义世界。"
	]
	quest.00000000CA000010.title: "&d维度刻录器"
	quest.00000000CA000011.quest_desc: [
		"一张空白的画布。"
		"将此放入刻录器以开始书写你的维度。"
		"如果单独放置而没有 Dimlets，它将创建一个随机世界。"
	]
	quest.00000000CA000011.title: "&d空维度标签页"
	quest.00000000CA000012.quest_desc: [
		"在 Enscriber 中点击“存储”后，你就会得到这个。"
		"其中包含你新维度（dimension）的 ID 和数据。"
		"但是等等！你还不能进去。它没有电力供应。"
	]
	quest.00000000CA000012.title: "&d已实现的维度标签页"
	quest.00000000CA000013.quest_desc: [
		"将 Realized Dimension Tab 放置于此。"
		"建造者需要RF/FE能量来“维持”维度。"
		"复杂的维度消耗更多能量。"
		"如果你在内部时电力耗尽，你就会死亡（除非你有 Phased Field Generator）。"
	]
	quest.00000000CA000013.title: "&d维度建造者"
	quest.00000000CA000014.quest_desc: [
		"&c关键物品！&r"
		"能让你在没有能量的维度中存活下来。"
		"它会消耗你背包里的能量（请先充能！）。"
		"在进入第一个维度之前先制作这个，以防万一。"
	]
	quest.00000000CA000014.title: "&d相位场发生器"
	quest.00000000CA000015.quest_desc: [
		"用于将Dimlet分解为其组件或合成新的Dimlet。"
		"在末地城市或维度地牢中寻找未知次元碎片，研究它们，并使用此处的部件。"
	]
	quest.00000000CA000015.title: "&dDimlet 工作台"
	quest.00000000CA000016.quest_desc: [
		"解码在战利品箱中找到的“未知维度碎片”。"
		"还会创建工作台所需的知识。"
	]
	quest.00000000CA000016.title: "&d研究员"
	quest.00000000CA000017.quest_desc: [
		"允许你提取方块、生物群系或流体的“精华”。"
		"关于允许你创建新维度的特定dimlet，请查看wiki。"
	]
	quest.00000000CA000017.quest_subtitle: "https://ftbwiki.org/RFTools_Dimension_Manual"
	quest.00000000CA000017.title: "&dDimlet"
	quest.00000000CA000030.quest_desc: [
		"一台用途极其广泛的机器。"
		"它可以建造、复制、交换、泵送和采石。"
		"其功能由你放入其中的形状卡所定义。"
		"&e用法：&r点击GUI中的卡片以配置区域（维度、偏移、大小）。"
	]
	quest.00000000CA000030.title: "&9建筑师 (The Builder)</c1>"
	quest.00000000CA000031.quest_desc: [
		"将建造者转变为采石场。"
		"它会挖掘指定区域，并将物品输出到建造者上方或下方的物品栏中。"
		"&e提示：&r使用“丝绸之触”或“时运”的采石场卡牌变体可获得更好的掉落物。"
		"默认将挖掘的方块替换为泥土（防止卡顿/难看）。"
	]
	quest.00000000CA000031.title: "&9塑形卡：采石场"
	quest.00000000CA000032.quest_desc: [
		"和 Quarry 类似，但它会完全挖空方块，留下空气。"
		"非常适合挖掘巨大的洞穴。"
	]
	quest.00000000CA000032.title: "&9塑形卡：清理采石场"
	quest.00000000CA000033.quest_desc: [
		"从指定区域抽取液体。"
		"将储罐放置在建造者上方或下方以收集流体。"
	]
	quest.00000000CA000033.title: "&9塑形卡：泵"
	quest.00000000CA000034.quest_desc: [
		"摧毁该区域内的方块。"
		"没有掉落物。只有破坏。"
	]
	quest.00000000CA000034.title: "&9塑形卡：虚空"
	quest.00000000CA000035.quest_desc: [
		"用于定义建造者复制或移动的区域（3D）。"
		"1. 将控制器放置在一个角落。"
		"2. 在其他角放置太空舱方块（立方体共7个方块）。"
		"3. 用扳手右键控制器以“构建”密室。"
		"4. 右键点击控制器，并使用太空舱卡进行绑定。"
	]
	quest.00000000CA000035.title: "&9太空舱室"
	quest.00000000CA000050.quest_desc: [
		"传送器的“出发”端部分。"
		"站在上面就会被传送走。"
		"需要消耗能量。"
		"必须通过拨号设备与接收器相连。"
	]
	quest.00000000CA000050.title: "&9物质传输器"
	quest.00000000CA000051.quest_desc: [
		"传送器的“目标”部分。"
		"需要能量才能安全接收物质。"
		"你必须将其中一个放置在你新创建的维度中才能返回！"
	]
	quest.00000000CA000051.title: "&9物质接收器"
	quest.00000000CA000052.quest_desc: [
		"用于传送的控制器。"
		"放置在发射器附近。"
		"它会扫描世界中（或其他维度中）的所有接收器。"
		"用它来在本地发射器和远程接收器之间“拨号”建立连接。"
	]
	quest.00000000CA000052.title: "&9拨号装置 Dialing Device"
	quest.00000000CA000053.quest_desc: [
		"手持式传送器。"
		"Shift-右键点击接收器以进行链接。"
		"右键点击可传送回家。"
		"高级版可以存储多个目的地。"
	]
	quest.00000000CA000053.title: "&9Charged Porter"
	quest.00000000CA000054.quest_desc: [
		"穷人的AE2。"
		"扫描指定半径内所有物品栏（箱子、桶等）。"
		"让你可以通过单个界面访问所有物品。"
		"可与平板电脑结合以实现远程访问。"
	]
	quest.00000000CA000054.title: "&9存储扫描仪"
	quest.00000000CA000055.quest_desc: [
		"远程访问你的存储扫描仪。"
		"制作一个平板电脑和一个存储控制模块。"
		"将模块与扫描仪链接（右键单击）。"
		"将模块放入平板电脑中。"
		"享受无线合成带来的乐趣。"
	]
	quest.00000000CA000055.title: "&9存储平板电脑"
	quest.00000000CA000056.quest_desc: [
		"一个装有存储模块的箱子。"
		"第一级：100 组物品。"
		"Tier 2: 200 堆叠。"
		"Tier 3: 300 堆叠。"
		"兼容 Storage Scanner 模组。"
	]
	quest.00000000CA000056.title: "&9模块化存储模组"
	quest.00000000CA000057.quest_desc: [
		"一款速度极快且小巧的自动合成器。"
		"可一次性存放最多 8 个配方（3 级）。"
		"输入和输出可以根据配方进行配置。"
		"支持“快速模式”，可即时合成物品。"
	]
	quest.00000000CA000057.title: "&9工匠大师 (The Crafter)</c1>"
	quest.00000000CA000058.quest_desc: [
		"在世界中显示信息。"
		"插入模块以显示能量、流体、物品、时间、文本等。"
		"模块必须先与目标方块进行连接。"
	]
	quest.00000000CA000058.title: "&9屏幕界面"
	quest.00000000CA000070.quest_desc: [
		"简单的早期游戏强力道具。"
		"用煤炭/木炭产生RF。"
	]
	quest.00000000CA000070.title: "&9煤炭发电机"
	quest.00000000CA000071.quest_desc: [
		"高功率发电。"
		"旁边需要一个烈焰搅拌机。"
		"燃烧烈焰棒。Agitator 能提高效率，但会消耗能量。"
	]
	quest.00000000CA000071.title: "&9烈焰人发电机"
	quest.00000000CA000072.quest_desc: [
		"通过引爆末影珍珠来产生巨大能量。"
		"需要精准的时机把控。"
		"你需要至少两个发电机、两个注射器和一个复杂的红石定时电路（或末影监视器）。"
		"不适合胆小的人参与的任务。"
	]
	quest.00000000CA000072.title: "&9末地生物发电机"
	quest.00000000CA000073.quest_desc: [
		"多区块能量存储装置。"
		"所有通过链接卡关联的、ID相同的能量单元会无线共享同一个能量缓冲区。"
		"可用维度细胞升级，实现跨维度提取。"
	]
	quest.00000000CA000073.title: "&9动力单元"
	quest.00000000DA000000.quest_desc: [
		"这个世界广阔无垠，垂直延伸，危机四伏。"
		"本章致力于帮助你移动得更快，飞得更高，携带得更多，并承受更猛烈的攻击。"
		"从传送石到喷气背包，这就是提升你生活质量的升级。"
	]
	quest.00000000DA000000.quest_subtitle: "冒险在等待着你"
	quest.00000000DA000000.title: "&6探索与装备 Exploration and Equipment"
	quest.00000000DA000010.quest_desc: [
		"传送锚点。"
		"放置一个并为其命名。"
		"你可以在传送石之间传送，消耗少量经验（或免费，取决于配置）。"
		"连接基地和寻找村庄的必备工具。"
	]
	quest.00000000DA000010.title: "&5传送石 (Waystones)"
	quest.00000000DA000011.quest_desc: [
		"便携式传送功能。"
		"允许你从世界任何地方传送到已发现的任意路标石。"
		"有冷却时间。"
	]
	quest.00000000DA000011.title: "&5传送石"
	quest.00000000DA000012.quest_desc: [
		"一次性使用的传送物品。"
		"&b绑定卷轴：&r可传送到你绑定的特定传送石。"
		"&b返回卷轴：&r 传送到最后一个激活的传送石。"
		"非常适合快速逃离洞穴时使用。"
	]
	quest.00000000DA000012.title: "&5Scrolls"
	quest.00000000DA000013.quest_desc: [
		"实体化的传送平台。"
		"放置两个，并用碎片/粉尘将它们连接起来。"
		"踩上其中一个即可瞬间传送到另一个，无需打开GUI。"
		"非常适合用于电梯或在基地与矿井之间旅行。"
	]
	quest.00000000DA000013.title: "&5传送板"
	quest.00000000DA000015.quest_desc: [
		"简单的垂直移动方式。"
		"将两个相同颜色的电梯放置在相同的X和Z坐标上。"
		"跳跃向上，蹲下向下。"
		"最大范围通常可配置，但基本能覆盖大多数情况。"
	]
	quest.00000000DA000015.title: "&f电梯系统"
	quest.00000000DA000020.quest_desc: [
		"厌倦了背包空间总是爆满吗？"
		"PackedUp 提供分等级的背包。"
		"基础版很小，但总比没有好。"
	]
	quest.00000000DA000020.title: "&6基础背包"
	quest.00000000DA000021.quest_desc: [
		"更多物品栏位。"
		"升级你的基础背包。"
	]
	quest.00000000DA000021.title: "&6铁质背包"
	quest.00000000DA000022.quest_desc: [
		"更多物品栏格子。"
		"闪闪发光，宽敞明亮。"
	]
	quest.00000000DA000022.title: "&6黄金背包"
	quest.00000000DA000023.quest_desc: [
		"超大容量。"
		"将整个矿井装进口袋随身携带。"
	]
	quest.00000000DA000023.title: "&6钻石背包"
	quest.00000000DA000024.quest_desc: [
		"终极便携式储物空间。"
		"坚固无比，能抵抗爆炸冲击。"
	]
	quest.00000000DA000024.title: "&6黑曜石背包"
	quest.00000000DA000025.quest_desc: [
		"就像末影箱一样，但更棒。"
		"通常每个槽位或通道的存储能力都更强。"
		"在不同维度间存取你的物品。"
	]
	quest.00000000DA000025.title: "&c下界宝箱"
	quest.00000000DA000030.quest_desc: [
		"所有喷气背包的基础组件。"
		"光靠这个无法飞行，但没有它也无法飞行。"
	]
	quest.00000000DA000030.title: "&b喷气背包背带"
	quest.00000000DA000031.quest_desc: [
		"它会飞……勉强算是会飞吧。"
		"燃料过低，速度极慢。"
		"不要摔下来。"
	]
	quest.00000000DA000031.title: "&b木制喷气背包"
	quest.00000000DA000032.quest_desc: [
		"沉重，但坚固耐用。"
		"比木头稍微好一点而已。"
	]
	quest.00000000DA000032.title: "&b石质喷气背包"
	quest.00000000DA000033.quest_desc: [
		"这才像话嘛。"
		"不错的飞行速度和燃料容量。"
		"标准的工业飞行方式。"
	]
	quest.00000000DA000033.title: "&b铁质喷气背包"
	quest.00000000DA000034.quest_desc: [
		"速度快，但消耗能量也快。"
		"黄金导电性好，可以实现高速冲刺。"
	]
	quest.00000000DA000034.title: "&b黄金喷气背包"
	quest.00000000DA000035.quest_desc: [
		"高耐用度（燃料箱）和出色的速度。"
		"专为富有的探险者打造的奢华物品。"
	]
	quest.00000000DA000035.title: "&b钻石喷气背包"
	quest.00000000DA000036.quest_desc: [
		"顶级宝石喷气背包。"
		"出色的操控性和大容量。"
	]
	quest.00000000DA000036.title: "&bEmerald Jetpack"
	quest.00000000DA000037.quest_desc: [
		"&5无限飞行。"
		"&5无限能源。"
		"&5无限潮流。"
		"垂直发展的终极目标。"
	]
	quest.00000000DA000037.title: "&d&l创意喷气背包"
	quest.00000000DA000040.quest_desc: [
		"原版盔甲太无聊了。"
		"Immersive Armors 添加了多个具有独特效果的新套装。"
		"有的能抵御魔法，有的能让你变快，有的则只是很肉。"
		"探索配方吧！"
	]
	quest.00000000DA000040.title: "&c沉浸式盔甲模组 (Immersive Armors)"
	quest.00000000DA000041.quest_desc: [
		"由凋零的骸骨锻造而成。"
		"提供对凋零效果的防护和高耐用度。"
	]
	quest.00000000DA000041.title: "&c凋零盔甲"
	quest.00000000DA000042.quest_desc: [
		"散发着强大的力量。"
		"出色的保护效果。"
	]
	quest.00000000DA000042.title: "&c神圣盔甲"
	quest.00000000DA000050.quest_desc: [
		"下界合金并非终点。"
		"你可以将下界合金与其他材料熔合，以创造特殊的重型护甲。"
		"首先将下界合金与铁混合在一起。"
	]
	quest.00000000DA000050.title: "&4高级下界合金装备"
	quest.00000000DA000051.quest_desc: [
		"下一个等级。"
		"更好的附魔效率和耐久度。"
		"用于升级下界合金铁质装备。"
	]
	quest.00000000DA000051.title: "&4下界合金黄金"
	quest.00000000DA000052.quest_desc: [
		"注入了祖母绿的强大力量。"
		"极高的耐用性。"
	]
	quest.00000000DA000052.title: "&4下界合金绿宝石"
	quest.00000000DA000053.quest_desc: [
		"高级下界合金的巅峰之作。"
		"无与伦比的防御力和坚韧度。"
	]
	quest.00000000DA000053.title: "&4下界合金钻石"
	quest.00000000DA000060.quest_desc: [
		"你只是为了属性才穿着难看混搭的盔甲吗？"
		"你可以穿戴第二套盔甲，纯粹为了美观，同时隐藏你真正的盔甲！"
	]
	quest.00000000DA000060.title: "&d装饰性盔甲"
	quest.00000000EA000000.quest_desc: [
		"忘掉金胡萝卜吧。"
		"是时候烹饪真正的食物了。"
		"更好的食物会赋予你&bNourished&r效果，可以防止饥饿值下降并被动地为你恢复生命值。"
		"本章涵盖高级农业和建造一个功能齐全的厨房。"
	]
	quest.00000000EA000000.quest_subtitle: "烹饪艺术"
	quest.00000000EA000000.title: "&6种植与烹饪</c1>"
	quest.00000000EA000001.quest_desc: [
		"任何厨师都必不可少的工具。"
		"1. 用它来切砧板上的物品。"
		"2. 用它收割草来获取 &eStraw&r。"
		"3. 用它来收割蛋糕切片。"
		"4. 它还能作为一种威力较弱的武器使用。"
	]
	quest.00000000EA000001.title: "&6小刀</c1>"
	quest.00000000EA000002.quest_desc: [
		"放置此物品以处理材料。"
		"右键物品放置，再右键刀具切割。"
		"示例："
		"- 生鱼 -> 三文鱼片 + 骨粉"
		"- 原木 -> 去皮原木 + 树皮"
		"- 马鞍 -> 皮革"
	]
	quest.00000000EA000002.title: "&6砧板 Cutting Board"
	quest.00000000EA000003.quest_desc: [
		"用刀割草可以获得此物品。"
		"制作画布、绳子和堆肥所必需的物品。"
	]
	quest.00000000EA000003.title: "&6稻草人"
	quest.00000000EA000004.quest_desc: [
		"使用泥土、稻草、骨粉和腐坏材料（腐肉、食物等）合成。"
		"把它放置在世界里。"
		"随着时间的推移（阳光和水会加速这一过程），它会变成&b富饶的土壤&r。"
		"在附近使用激活器可以加快进程。"
	]
	quest.00000000EA000004.title: "&6有机堆肥堆肥器"
	quest.00000000EA000005.quest_desc: [
		"最适合耕种的泥土。"
		"富饶土壤上种植的作物生长更快，且不会被践踏。"
		"可以将其耕作成为富饶土壤农田。"
	]
	quest.00000000EA000005.title: "&6肥沃的土壤"
	quest.00000000EA000010.quest_desc: [
		"&e位置：&r 可在沙地生物群系、海滩和偶尔的平原中找到。"
		"破坏野生作物以获得种子。"
		"可用于沙拉和炖菜。"
	]
	quest.00000000EA000010.title: "&a野生卷心菜"
	quest.00000000EA000011.quest_desc: [
		"&e位置：&r 在炎热或干旱的生物群系（如稀树草原、恶地）中生成。"
		"番茄是攀爬作物（像藤蔓一样），使用绳子或木棍。"
		"制作意大利面和披萨的必需品。"
	]
	quest.00000000EA000011.title: "&a野生番茄"
	quest.00000000EA000012.quest_desc: [
		"&e位置：&r 常见于温带生物群系（森林、平原）。"
		"为许多菜肴增添风味的必备食材。"
	]
	quest.00000000EA000012.title: "&a野生洋葱"
	quest.00000000EA000013.quest_desc: [
		"&e位置：&r 可在湿润生物群系（沼泽、丛林、河岸）中找到。"
		"必须种植在深度为1的水中（像海带一样，但在水面上）。"
		"用于制作熟米饭和肉桂卷。"
	]
	quest.00000000EA000013.title: "&a野生稻米"
	quest.00000000EA000020.quest_desc: [
		"一个升级后的篝火。"
		"一次可以烹饪6种物品。"
		"为烹饪锅和煎锅提供热量。"
		"放置在热源（岩浆块、熔岩等）上时不需要燃料！"
	]
	quest.00000000EA000020.title: "&6炉灶 The Stove"
	quest.00000000EA000021.quest_desc: [
		"主要的烹饪工作站。"
		"放置在炉子（或火）的正上方。"
		"放入材料（最多6种）+ 容器（碗/瓶子）。"
		"结果：炖菜、意大利面和汤等复杂的餐点。"
		"可用漏斗/管道自动化（侧面：原料，底部：产物）。"
	]
	quest.00000000EA000021.title: "&6烹饪锅"
	quest.00000000EA000022.quest_desc: [
		"放置在炉灶上可快速烹饪物品。"
		"按住 Shift 键可将物品放置其上。"
		"也可用作武器（砰！），击退力很高。"
	]
	quest.00000000EA000022.title: "&6煎锅（Skillet）"
	quest.00000000EA000030.quest_desc: [
		"此模组将你的所有食物存储连接到一个多区块厨房中。"
		"食谱书会显示你当前在背包/厨房中拥有的物品可以烹饪出哪些东西。"
	]
	quest.00000000EA000030.title: "&bCooking for Blockheads 烹饪大师模组包任务书"
	quest.00000000EA000031.quest_desc: [
		"厨房的大脑。"
		"放置此物品，并将其他厨房方块（冰箱、水槽、橱柜）与其相邻放置。"
		"右键点击桌子，即可查看所有使用所有已连接方块中的材料制作的配方。"
		"一键合成。"
	]
	quest.00000000EA000031.title: "&b烹饪台"
	quest.00000000EA000032.quest_desc: [
		"将食物熔炼成可食用的状态。"
		"连接到烹饪台后，你可以直接订购烹饪好的物品。"
		"可用“加热单元”升级，改用RF而非煤炭运行。"
	]
	quest.00000000EA000032.title: "&b烤箱 (The Oven)</c1>"
	quest.00000000EA000033.quest_desc: [
		"提供无限量的水。"
		"需要水桶或水瓶的配方所必需的物品。"
		"也适用于其他模组的管道，可作为无限水源。"
	]
	quest.00000000EA000033.title: "&b水槽 The Sink"
	quest.00000000EA000034.quest_desc: [
		"用于存放食物类物品。"
		"如果你有“保鲜室”升级，食物就不会腐烂（如果游玩了食物腐烂模组）。"
		"若用「冰单位」升级，可制作冰块。"
	]
	quest.00000000EA000034.title: "&b冰箱（The Fridge）"
	quest.00000000EA000035.quest_desc: [
		"无限牛奶源。"
		"合成方法：在世界中放置一个牛奶罐。在罐子正上方的牛身上放置一个砧锤。"
		"那头牛会……刚好装得下。"
		"抱歉了，牛牛。"
	]
	quest.00000000EA000035.title: "&b瓶子里的牛"
	quest.00000000EA000036.quest_desc: [
		"用于存放原料的墙面储物柜。"
		"连接到烹饪台网络。"
	]
	quest.00000000EA000036.title: "&b香料架"
	quest.00000000EA000037.quest_desc: [
		"将面包变成烤面包。"
		"需要RF能量（或根据配置的红石信号）。"
		"吐司很好吃。"
	]
	quest.00000000EA000037.title: "&b烤面包机"
	quest.00000000EA000040.quest_desc: [
		"找不到特定的种子或树苗吗？"
		"市场出售游戏中几乎所有的种子、树苗和花朵。"
		"货币：绿宝石。"
	]
	quest.00000000EA000040.title: "&2市场</c1>"
	quest.00000000EA000041.quest_desc: [
		"用于自动繁殖动物的机器。"
		"1. 用动物饲料（胡萝卜、小麦、种子）填满它。"
		"2. 附近的动物会来吃东西，并进入“爱心模式”。"
		"3. 用它来自动保持你的动物数量处于高水平。"
	]
	quest.00000000EA000041.title: "&2喂食槽"
	quest.00000000EA000042.quest_desc: [
		"加速作物生长。"
		"红色：生长速度。"
		"绿色：产量增加。"
		"黄色：防止踩踏（若未使用肥沃土壤）。"
	]
	quest.00000000EA000042.title: "&2肥料类物品"
	quest.00000000FA000000.quest_desc: [
		"Minecraft 是一款关于建造的游戏。"
		"本章将为你提供终极工具，助你更快建造、复制结构，并用成千上万种变化来丰富你的基地。"
		"从科技小工具到客厅椅子，应有尽有。"
	]
	quest.00000000FA000000.quest_subtitle: "至尊设计师"
	quest.00000000FA000000.title: "&e建造与设计</c1>"
	quest.00000000FA000010.quest_desc: [
		"远程放置你背包里的方块。"
		"模式：为我建造、垂直墙壁、地板、楼梯、网格。"
		"按下“设置菜单”按钮（控制键位绑定）以配置范围和模式。"
	]
	quest.00000000FA000010.title: "&9建筑小工具"
	quest.00000000FA000011.quest_desc: [
		"将世界中的方块与背包中的方块进行交换。"
		"非常适合在不先破坏一切的情况下更换地板或墙壁。"
	]
	quest.00000000FA000011.title: "&9交换小工具中"
	quest.00000000FA000012.quest_desc: [
		"选择一个区域，复制它，然后粘贴到其他地方。"
		"从你的物品栏中消耗所需的方块。"
		"也可以复制箱子里的物品（如果配置了的话）。"
	]
	quest.00000000FA000012.title: "&9复制粘贴小工具"
	quest.00000000FA000013.quest_desc: [
		"允许你将你的建筑保存到“Paper”或文件中。"
		"复制建造代码与朋友分享，或粘贴从网上下载的建造代码。"
	]
	quest.00000000FA000013.title: "&9模板管理器"
	quest.00000000FA000014.quest_desc: [
		"将结构体从A点移动到B点。"
		"移除原有的方块。"
		"小心别在结构体还在内存里的时候弄丢了小工具！"
	]
	quest.00000000FA000014.title: "&9剪切粘贴小工具"
	quest.00000000FA000015.quest_desc: [
		"&c警告：&r 将方块破坏成空。"
		"会立即移除大片区域的方块。不会掉落任何物品。"
		"非常适合用来清理出一片区域建造基地。"
	]
	quest.00000000FA000015.title: "&9破坏装置"
	quest.00000000FA000020.quest_desc: [
		"扩展你的建筑范围。"
		"点击方块的面，可将背包中相同的方块朝该方向放置。"
		"按住 Shift + 滚动可切换模式（水平、垂直、无限）。"
	]
	quest.00000000FA000020.title: "&a建造木棍"
	quest.00000000FA000021.quest_desc: [
		"速度更快，更耐用。"
		"你可以使用“核心”来添加额外功能（例如在空中放置方块）。"
	]
	quest.00000000FA000021.title: "&a钻石棒"
	quest.00000000FA000022.quest_desc: [
		"外观与原版一致的功能性和装饰性方块。"
		"&b口袋背包：&r便携式可部署的背包。"
		"&b保险箱：&r一个私密且难以破坏的箱子。"
		"还有许多其他东西（地球仪、龙头、路标）。"
	]
	quest.00000000FA000022.title: "&6补充物品"
	quest.00000000FA000023.quest_desc: [
		"改进了现有的原版方块。"
		"它让你能以新方式在墙上放置灯笼，改进告示牌，并让水与更多方块互动。"
	]
	quest.00000000FA000023.title: "&6Amendments"
	quest.00000000FA000030.quest_desc: [
		"经典的工具。"
		"按住它并右键单击。"
		"放置一个方块（例如，Cobblestone）即可将其变为数十种装饰性变体。"
		"仅在物品栏中有效。"
	]
	quest.00000000FA000030.title: "&b凿子 (The Chisel)</c1>"
	quest.00000000FA000031.quest_desc: [
		"Chipped 添加了成千上万个方块。"
		"你必须为该材料创建特定的表格："
		"- &b植物学家：&r花朵与植物。"
		"- &b玻璃吹制匠：&r 玻璃。"
		"- &b木匠：&r木材。"
		"- &b石匠：&r石头。"
		"- &b织布机：&r羊毛。"
		"- &b炼金术：&r 黑曜石/萤石。"
		"- &bTinker:&r 红石/金属。"
	]
	quest.00000000FA000031.title: "&bChipped Workbenches 工作台模组"
	quest.00000000FA000032.quest_desc: [
		"一套工业方块组合。"
		"风扇、装饰性管道、金属格栅、生锈的金属板。"
		"非常适合建造逼真的工厂。"
	]
	quest.00000000FA000032.title: "&b工厂方块"
	quest.00000000FA000033.quest_desc: [
		"为世界增添更多色彩！"
		"为羊毛、陶瓦、混凝土等添加了中间色变体（如珍珠色、浅绿色等）。"
	]
	quest.00000000FA000033.title: "&bDyenamics"
	quest.00000000FA000040.quest_desc: [
		"原版风格的家具。"
		"椅子、凳子、桌子、沙发。"
		"你可以坐在椅子和沙发上。"
	]
	quest.00000000FA000040.title: "&d又一件家具物品"
	quest.00000000FA000041.quest_desc: [
		"修改家具所必需的物品。"
		"右键点击桌子或椅子，可以更改桌腿、扶手或靠背的类型。"
		"用于将多个桌子拼接成一个大型结构。"
	]
	quest.00000000FA000041.title: "&d家具锤"
	quest.00000000FA000042.quest_desc: [
		"巨型门、滑动门、谷仓门。"
		"适合各种建筑风格的丰富选择。"
	]
	quest.00000000FA000042.title: "&dMacaw's Doors"
	quest.00000000FA000043.quest_desc: [
		"像门一样，不过是活板门。"
		"非常适合细节、窗户或秘密通道。"
	]
	quest.00000000FA000043.title: "&d鹦鹉螺的活板门"
	quest.00000000FA000044.quest_desc: ["不要错过数十种门和其他装饰方块哦！"]
	quest.00000000FA000044.title: "&d其他门类物品"
	quest.00000000FA000045.quest_desc: [
		"打破这个方格！"
		"允许你放置视觉上相互连接的斜向栅栏。"
		"非常适合建造更自然的动物围栏。"
	]
	quest.00000000FA000045.title: "&d对角围栏"
	quest.011F6A81EFF2F28C.quest_desc: [
		"为什么要用煤炭？电的速度快两倍，所以煤炭可以拿来干点别的……"
		"电动钻头和任何管道/导管/能量电缆兼容，可用于输入（能量）和输出（挖掘材料）。"
		"环保友好！"
		""
		"&4重要提示：你可以在一个区块里无限次地使用钻头，这会加快矿石的提取速度，但只会更快地清空该区块，并不会让你有无限的矿石哦 ;)&r"
	]
	quest.011F6A81EFF2F28C.title: "&b电动钻床"
	quest.01A89E3B5F7E2AB3.title: "坚固紧凑型机器墙壁"
	quest.01CCBDECC9B7AF30.quest_desc: ["一种隐秘的掠食者。保持警惕。"]
