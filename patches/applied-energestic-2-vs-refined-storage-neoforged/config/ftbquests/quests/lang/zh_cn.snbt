	quest.2CB07F761D83FDAD.title: "&a锻造中"
	quest.2CC73ABC3148A6BC.quest_desc: [
		"世界生成系统已经全面重做了。"
		"你会发现数十种新的生物群系、树木和花朵。"
		"花点时间探索，为你的基地找个完美的位置吧。"
	]
	quest.2D5CDD5227D86496.quest_desc: ["嗯……铁和煤能炼成钢？从什么时候开始的？"]
