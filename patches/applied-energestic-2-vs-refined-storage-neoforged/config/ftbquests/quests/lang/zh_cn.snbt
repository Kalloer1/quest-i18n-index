	quest.7E78ECDBDD477DE5.quest_subtitle: "有许多实用的升级道具！"
	quest.7EAAA70179CAA9E8.quest_desc: ["注满水，右键作物或树苗以加速其生长。"]
	quest.7EAAA70179CAA9E8.quest_subtitle: "加速生长"
	quest.7EAAA70179CAA9E8.title: "&a浇水壶"
	quest.7EE9C224C005724F.quest_subtitle: "来试试其他的方块吧！"
	quest.7F6414A0A3CA2394.quest_desc: ["这种蠕虫会对声音和振动做出反应。"]
	quest.7F6414A0A3CA2394.quest_subtitle: "吵闹的敌人"
	quest.7F6414A0A3CA2394.title: "&6猎人：尖叫蠕虫"
	quest.7FBF7D8EC2E72F2A.quest_desc: [
		"将树苗或有机物放入桶中即可创造泥土。"
		"或者让它装满雨水（或用桶装水）来储存液体。"
	]
	quest.7FBF7D8EC2E72F2A.quest_subtitle: "堆肥和流体系统 (Composting and Fluids)"
	quest.7FBF7D8EC2E72F2A.title: "&a木桶"
	reward.1000000000000003.quest_desc: [
		"你最好的导航伙伴。"
		""
		"&e按键绑定：&r"
		"- 按 &6[J]&r 打开全屏地图。"
		"- 按 &6[B]&r 可在当前位置创建一个路点。"
		"- 检查选项以配置屏幕角落的小地图和按键映射。"
	]
	reward.1000000000000003.title: "&6JourneyMap"
	reward.1000000000000005.quest_desc: [
		"在寻找特定生物群系吗？自然罗盘可以帮你找到它。"
		"右键点击以打开生物群系选择GUI。"
		"它会显示到最近该类型生物群系的坐标和距离。"
	]
	reward.2000000000000005.quest_desc: [
		"在某些生物群系中，你可以找到玫瑰石英矿床。"
		"这些水晶不仅仅是装饰品，它们可用于建造和合成。"
	]
	reward.2000000000000005.quest_subtitle: "水晶采矿"
	reward.4000000000000004.title: "&a简易磁铁"
	reward.4000000000000006.quest_desc: [
		"异世界充满了各种奇特的新方块。"
		"收集一些阴郁的潜声，它们存在于这个黑暗维度中。"
	]
	reward.4000000000000008.quest_desc: [
		"在晶洞或古花瓶中寻找结晶琥珀。"
		"用于制作强大的装备。"
	]
	reward.4000000000000010.quest_desc: [
		"使用在 Otherside 和 Echo Shards 中找到的材料，制作 Warden Helmet。"
		"它能提供强大的保护，并能减弱振动。"
	]
	reward.4000000000000012.quest_desc: [
		"合成守卫之剑。"
		"由深邃黑暗之精华锻造而成的武器。"
	]
	reward.4000000000000050.quest_desc: [
		"探索异界的遗迹，找到古代花瓶。"
		"打破它们以获得珍贵的战利品。"
	]
	reward.4000000000000052.quest_desc: ["找到并采集这个维度的奇特植物。"]
	reward.4000000000000060.quest_desc: [
		"找到并击败在异次元游荡的强大实体“The Shattered”。"
		"准备好迎接一场艰难的战斗吧。"
	]
	reward.4000000000000060.title: "&6猎人：破碎者 (Hunter: The Shattered)</c1>"
