	quest.1C086D8D21757CA8.quest_desc: [
		"异世界充满了各种奇特的新方块。"
		"收集一些阴郁的潜声，它们存在于这个黑暗维度中。"
	]
	quest.1C086D8D21757CA8.quest_subtitle: "阴森的海底泥土"
	quest.1C086D8D21757CA8.title: "&6新增资源"
	quest.1E2FF0758307F29E.quest_desc: ["用钩爪右键树叶，有更高几率掉落树苗，最重要的是，还有Silkworms。"]
