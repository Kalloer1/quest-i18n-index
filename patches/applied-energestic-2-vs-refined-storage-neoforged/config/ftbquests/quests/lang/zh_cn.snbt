	quest.09F9BFFE08FA51F1.quest_subtitle: "用于唤醒和创造增幅的祭坛。"
	quest.0B0DFF847ADE023E.quest_desc: [
		"制作一个未烧制的坩埚，然后用熔炉将其烧制。"
		"将熔炉置于热源（火把、岩浆、火焰）上，并投入鹅卵石将其熔化为岩浆。"
	]
	quest.0B0DFF847ADE023E.quest_subtitle: "制作岩浆"
	quest.0B0DFF847ADE023E.title: "&a坩埚 (Crucible)"
	quest.0BC84179409D28D5.quest_desc: [
		"Tier 2 合金。"
		"将 Infused Alloy 与 Diamond Dust 融合而成。"
	]
	quest.0BC84179409D28D5.title: "&3强化合金"
	quest.0C15752BB53EE2E1.quest_desc: [
		"是时候不再用手工做一切事情了。"
		"在本章中，我们将实现资源采集、农业和物流的自动化。"
		"我们还将引入第一批动力机械。"
	]
	quest.0C15752BB53EE2E1.quest_subtitle: "机器正在接管一切"
	quest.0C15752BB53EE2E1.title: "&e基础自动化系统"
	quest.0D77A78F73C2D0F6.quest_desc: [
		"将你的矿石数量增加四倍。"
		"使用 &b氯化氢&r 将矿石加工成碎片。"
		"需要一台热蒸发装置将水转化为卤水，再转化为锂/氯。"
	]
	quest.0D77A78F73C2D0F6.title: "&3注射室（四倍化）"
	quest.0F0B11B076054855.quest_subtitle: "精炼存储的线缆。用1根线缆就能连接所有精炼过的方块！"
	quest.1000000000000003.quest_desc: [
		"你最好的导航伙伴。"
		""
		"&e按键绑定：&r"
		"- 按 &6[J]&r 打开全屏地图。"
		"- 按 &6[B]&r 可在当前位置创建一个路点。"
		"- 检查选项以配置屏幕角落的小地图和按键映射。"
	]
	quest.1000000000000003.quest_subtitle: "永远不要迷失方向"
	quest.1000000000000003.title: "&6JourneyMap"
	quest.1000000000000005.quest_desc: [
		"在寻找特定生物群系吗？自然罗盘可以帮你找到它。"
		"右键点击以打开生物群系选择GUI。"
		"它会显示到最近该类型生物群系的坐标和距离。"
	]
	quest.1000000000000005.quest_subtitle: "寻找生物群系"
	quest.1000000000000005.title: "&6自然指南针"
	quest.103D40E05D84D966.quest_subtitle: "盔甲、剑、弓……终极的颠覆。"
	quest.1292F506A36F7EA6.quest_desc: ["最后一个等级。有 176 个物品栏格子。"]
	quest.1292F506A36F7EA6.title: "&6探险家伙伴"
	quest.139A980C250B66E3.quest_desc: [
		"将你的矿石数量翻倍。"
		"输入：原矿 -> 输出：2x 粉尘。"
		"也用于富集钻石、红石和碳等材料，以实现更高效的注入。"
	]
	quest.139A980C250B66E3.title: "&3富集室（复制）"
	quest.13CEDBFF33F5F376.quest_desc: [
		"世界广阔而充满危险……和宝藏。"
		"在本章中，我们将了解导航工具、待探索的新生物群，以及地表之下等待着的黑暗维度。"
	]
	quest.13CEDBFF33F5F376.quest_subtitle: "探索未知领域"
	quest.13CEDBFF33F5F376.title: "&6与世界互动"
	quest.14651663414BAC09.quest_desc: [
		"本章的后期探索部分由此拉开序幕。"
		"你必须深入深暗，找到一座远古城市。"
		"&c坚守者很危险，但可以刷怪。&r"
	]
	quest.14651663414BAC09.quest_subtitle: "做好准备迎接挑战吧"
	quest.14651663414BAC09.title: "&6深邃黑暗"
	quest.1480F5F6243CA161.quest_desc: [
		"在 Refined Storage 和其他系统之间架起桥梁。"
		"&b请求器&r方块能让你通过自动向RS系统请求物品，来保持特定数量的物品在物品栏（如箱子或机器输入口）中。"
		"像合成卡一样，但用于外部方块。"
	]
	quest.149BF7064A23FF61.quest_desc: ["中间的背包有 72 个物品栏格子。"]
	quest.149BF7064A23FF61.title: "&6冒险背包"
	quest.14A8552D81D4DF9A.quest_desc: ["送给你。"]
	quest.1518FEB1F0EB6605.quest_subtitle: "就是这样... 无限物品！感谢游玩！"
	quest.1518FEB1F0EB6605.title: "&c我的整合包结束了"
	quest.153E843FD446AD42.quest_subtitle: "有许多升级选项可供选择。"
	quest.16AD5BA3B2CF2E57.quest_subtitle: "再也没有空间不足的问题了！"
	quest.16DF96E076EA0189.quest_desc: [
		"这台机器会发射激光，将投掷在它前方的物品进行转换。"
		"需要晶体通量 (CF/RF) 能量。"
		"用它可以将红石转换为 Restonia，青金石转换为 Palis，等等。"
	]
	quest.16DF96E076EA0189.quest_subtitle: "&3转换机 The Transmuter"
	quest.16DF96E076EA0189.title: "&2原子重组器"
	quest.18CF092496594303.quest_desc: [
