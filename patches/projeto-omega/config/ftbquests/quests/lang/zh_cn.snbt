	]
	quest.1700000000000040.title: "合成单元 Crafting Unit"
	quest.1700000000000041.quest_desc: [
		"允许并行处理更多工作，从而加快自动合成速度。"
		"此组件属于AE2数字基础设施，用于准备下一台机器或网络资源。 §bJEI:§r批量合成前请在此构建中查看确切配方。"
	]
	quest.1700000000000041.title: "合成协处理器 (Crafting Co-Processor)"
	quest.1700000000000042.quest_desc: [
		"建造一个 Crafting CPU，创建一个 Processing Pattern，并从终端请求一个物品。"
		"AE2 应仅通过配方提供者分发材料。制造过程在网络外部，即你的 Create 生产线中进行，产物必须返回存储以完成工作。"
	]
	quest.1700000000000042.title: "首次按需生产任务书文本"
	quest.1700000000000043.quest_desc: [
		"创建一个使用机器而非即时合成的配方处理模式。"
		"这是一个实践目标：只有在测试了世界中的设置并确认其发挥预期功能后，才能完成。"
	]
	quest.1700000000000043.title: "正在处理模式文件"
	quest.1700000000000044.quest_desc: [
		"配置AE2，通过模式提供器将材料发送到Create工厂。"
		"这是一个实践目标：只有在测试了世界中的设置并确认其按预期工作后，才能完成。"
	]
	quest.1700000000000044.title: "网络下达了命令"
	quest.1700000000000045.quest_desc: ["完成循环：工厂处理原料，并将成品返还至网络。"]
	quest.1700000000000045.title: "工厂正在响应"
	quest.1700000000000046.quest_desc: ["在终端请求一个创造组件——例如精密机制——然后看着网络协调生产。"]
	quest.1700000000000046.title: "按需生产"
	quest.1700000000000047.quest_desc: [
		"高级里程碑：你的AE2网络现在能自动管理Create的生产线了。"
		"这是一个实践目标：只有在世界内测试设置并确认其发挥预期功能后，才能完成。"
	]
	quest.1700000000000047.title: "完整创造 + 自动化引擎2整合包"
	quest.1700000000000048.quest_desc: [
		"根据ME网络中存储的物品数量发出红石信号。"
		"此组件属于AE2数字基础设施，用于准备下一台机器或网络资源。 §bJEI:§r批量合成前请在此构建中查看确切配方。"
	]
	quest.1700000000000048.title: "等级发射器"
	quest.1700000000000049.quest_desc: [
		"将 Level Emitter 设置为在库存低于选定阈值时激活。"
		"这是一个实践目标：只有在测试了世界中的设置并确认其按预期工作后，才能完成。"
	]
	quest.1700000000000049.title: "配置一个库存限制"
	quest.170000000000004A.quest_desc: [
		"使用 Level Emitter 来控制 Create 生产线，并保持理想的库存水平。"
		"这是一个实践目标：只有在测试了世界中的设置并确认其能按预期工作后，才能完成。"
	]
	quest.170000000000004A.title: "自动启动和停止工厂"
	quest.170000000000004B.quest_desc: [
		"加速 Certus Quartz 晶体的生长，需要消耗能量。"
		"此组件属于AE2数字基础设施，用于准备下一台机器或网络资源。 §bJEI:§r批量合成前请在此构建中查看确切配方。"
	]
	quest.170000000000004B.title: "生长加速器"
	quest.170000000000004C.quest_desc: ["在Budding Certus周围建造一组Growth Accelerator，并确认晶体生长速度加快。"]
	quest.170000000000004C.title: "加速的 Certus 生产"
	quest.170000000000004D.quest_desc: [
		"提供对ME网络的无线访问权限。"
		"此组件属于AE2数字基础设施，用于准备下一台机器或网络资源。 §bJEI:§r批量合成前请在此构建中查看确切配方。"
	]
	quest.170000000000004D.title: "无线接入点"
	quest.170000000000004E.quest_desc: [
		"用于远程访问ME网络的便携式终端。"
		"此组件属于AE2数字基础设施，用于准备下一台机器或网络资源。 §bJEI:§r批量合成前请在此构建中查看确切配方。"
	]
	quest.170000000000004E.title: "无线终端"
	quest.170000000000004F.quest_desc: [
		"一个集成了合成功能的无线终端。"
		"此组件属于AE2数字基础设施，用于准备下一台机器或网络资源。 §bJEI:§r批量合成前请在此构建中查看确切配方。"
	]
	quest.170000000000004F.title: "无线合成终端"
	quest.1700000000000050.quest_desc: [
		"远离接入点使用无线终端来管理已存储的物品。"
		"这是一个实践目标：只有在测试了世界中的设置并确认其能按预期工作后，才能完成。"
	]
	quest.1700000000000050.title: "远程访问网络"
	quest.1700000000000051.quest_desc: [
		"用于管理网络信道的核心组件。"
		"此组件属于AE2数字基础设施，用于准备下一台机器或网络资源。 §bJEI:§r批量合成前请在此构建中查看确切配方。"
	]
	quest.1700000000000051.title: "ME控制器"
	quest.1700000000000052.quest_desc: [
		"一种能直观监控频道使用情况的智能线缆。"
		"此组件属于AE2数字基础设施，用于准备下一台机器或网络资源。 §bJEI:§r批量合成前请在此构建中查看确切配方。"
	]
	quest.1700000000000052.title: "智能电缆"
	quest.1700000000000053.quest_desc: [
		"比普通电缆能承载更多频道的智能高密度电缆。"
		"此组件属于AE2数字基础设施，用于准备下一台机器或网络资源。 §bJEI:§r批量合成前请在此构建中查看确切配方。"
	]
	quest.1700000000000053.title: "高密度智能电缆"
	quest.1700000000000054.quest_desc: [
		"使用 ME 控制器和密集智能电缆将网络扩展到八个频道以上。"
		"这是一个实践目标：只有在测试了世界中的设置并确认其能按预期工作后，才能完成。"
	]
	quest.1700000000000054.title: "通过通道进行扩展 (Expanding with Channels)"
	quest.1700000000000055.quest_desc: [
		"在遥远地点之间运输渠道和其他资源。"
		"此组件属于AE2数字基础设施，用于准备下一台机器或网络资源。 §bJEI:§r批量合成前请在此构建中查看确切配方。"
	]
	quest.1700000000000055.title: "P2P 隧道"
	quest.1700000000000056.quest_desc: [
		"在网络中的两个点之间建立点对点连接。"
		"这是一个实践目标：只有在测试了世界中的设置并确认其能按预期工作后，才能完成。"
	]
	quest.1700000000000056.title: "配置 P2P"
	quest.1700000000000057.quest_desc: [
		"创建一个子网以隔离网络的一部分。这是一个可选的高级步骤。"
		"这是一个实践目标：只有在测试了世界中的设置并确认其按预期工作后，才能完成。"
	]
	quest.1700000000000057.title: "简易子网络"
	quest.1700000000000058.quest_desc: [
		"量子网络桥的一部分所使用的方块。"
		"此组件属于AE2数字基础设施，用于准备下一台机器或网络资源。 §bJEI:§r批量合成前请在此构建中查看确切配方。"
	]
	quest.1700000000000058.title: "量子链接室"
	quest.1700000000000059.quest_desc: [
		"用于建立量子网络桥梁所需的一项物品。"
		"此组件属于AE2数字基础设施，用于准备下一台机器或网络资源。 §bJEI:§r批量合成前请在此构建中查看确切配方。"
	]
	quest.1700000000000059.title: "量子纠缠奇点"
	quest.170000000000005A.quest_desc: ["量子环构成了量子桥的外层结构。在获得链接室和量子纠缠奇点后，使用这些组件在遥远的网络之间组装一条完整的连接。"]
	quest.170000000000005A.title: "量子戒指"
	quest.170000000000005B.quest_desc: [
		"在两个独立的ME网络之间建立一个量子桥。"
		"这是一个实践目标：只有在测试了世界中的设置并确认其按预期工作后，才能完成。"
	]
	quest.170000000000005B.title: "连接遥远的网络"
	quest.170000000000005C.quest_desc: [
		"一个能够存储世界某片区域的单元格。"
		"此组件属于AE2数字基础设施，用于准备下一台机器或网络资源。 §bJEI:§r批量合成前请在此构建中查看确切配方。"
	]
	quest.170000000000005C.title: "空间存储单元"
	quest.170000000000005D.quest_desc: [
		"用于与 Spatial Storage 交互的端口。"
		"此组件属于AE2数字基础设施，用于准备下一台机器或网络资源。 §bJEI:§r批量合成前请在此构建中查看确切配方。"
	]
	quest.170000000000005D.title: "空间输入输出端口"
	quest.170000000000005E.quest_desc: [
		"捕获一片世界区域，并通过空间存储将其再次具象化。"
		"这是一个实践目标：只有在测试了世界中的设置并确认其按预期工作后，才能完成。"
	]
	quest.170000000000005E.title: "使用空间存储 (Spatial Storage)"
	quest.170000000000005F.quest_desc: ["模式提供器提供模式，分子组装器执行。当流程需要物理机械时，将AE2数字自动化与外部Create线路相结合。"]
	quest.170000000000005F.title: "分子组装器"
	quest.1700000000000060.quest_desc: ["增加用于较重自动合成任务的可用内存。"]
	quest.1700000000000060.title: "16k 合成存储"
	quest.1700000000000061.quest_desc: ["数字工厂在扩张：更多步骤、更多原料和更大的计算空间。"]
	quest.1700000000000061.title: "64k 合成存储"
	quest.1700000000000062.quest_desc: ["逻辑核心需要此等级。AE2 必须证明其工业规模，而不仅仅是存储能力。"]
	quest.1700000000000062.title: "256k 合成存储"
	quest.1700000000000063.quest_desc: ["自动化单元格与网络之间的内容移动，实现大规模存储维护。"]
	quest.1700000000000063.title: "输入/输出端口"
	quest.1700000000000064.quest_desc: ["你已完成数字时代证明：AE2负责请求、分配和计算；Create负责物理制造；产品返回网络。此里程碑将解锁逻辑核心路径。"]
	quest.1700000000000064.title: "大规模工业化自动合成"
	quest.1700000000000065.quest_desc: ["通过网络管理一整个模式提供器墙。制造现在使用机械合成，保持此AE2终端为Create工业建造的技术。"]
	quest.1700000000000065.title: "模式访问终端"
	quest.1700000000000066.quest_desc: ["扩大空间输入输出。组件和单元都通过 Create 工艺制造，而非保留平行的原版配方。"]
	quest.1700000000000066.title: "16³ 空间单元"
	quest.1700000000000067.quest_desc: ["最大的空间单元需要更重的工业生产线，以证明你已完全掌握空间输入输出系统。"]
	quest.1700000000000067.title: "128³ 空间单元"
	quest.1700000000000068.quest_desc: ["随身携带大容量ME存储。便携式电池仍是原AE2设备，仅其制造配方转移到了Create中。"]
	quest.1700000000000068.title: "256k 便携式电池"
	quest.1700000000000069.quest_desc: ["网络连接与工厂的接口现已整合：Cable Pattern Provider、Cable Interface、Storage/Conversion Monitor 和 Energy Level Emitter 均为 Create 制造的一部分。"]
	quest.1700000000000069.title: "AE2 — 工业接口"
	quest.170000000000006A.quest_desc: ["从ME P2P隧道开始，专精红石、物品、流体、FE和光。网络将成为基础设施，而不仅仅是存储。"]
	quest.170000000000006A.title: "AE2 — 专用点对点传输器"
	quest.170000000000006B.quest_desc: ["Spatial Anchor、Matrix Frame、Vibration Chamber 和 Crystal Resonance Generator 填补了工业化 AE2 路线的最后功能空白。"]
	quest.170000000000006B.title: "AE2 — 高级网络基础设施"
	quest.1800000000000010.quest_desc: [
		"创造仍然是你工厂的支柱，但现在电气技术将需要 FE（Forge 能量）。"
		"Mekanism Generators 引入了生产与储存能量的新方法，同时不会取代你已熟悉的机械自动化。"
		"在本章中，你将学习如何利用多种能源发电，并将其储存在能量立方体中，以确保你的电器能够稳定运行。"
	]
	quest.1800000000000010.title: "Mekanism — 规模化的力量"
	quest.1800000000000011.quest_desc: [
		"利用热量（如熔岩或燃烧的固体燃料）来发电。"
		"优点：不依赖风力或阳光，几乎可以在任何环境下工作。"
		"限制：需要持续的热量来源来维持生产。"
		"创建整合：此发电机通过你的机械基础设施组装——JEI会显示确切顺序。"
	]
	quest.1800000000000011.title: "热能发电机"
	quest.1800000000000012.quest_desc: [
		"将风力转化为电能。"
		"优点：被动且可再生，无需消耗燃料即可生成。"
		"限制：输出取决于发电机周围的高度和开放空间。"
		"创建整合包：由工业生产线中加工过的组件制成。"
	]
	quest.1800000000000012.title: "风力发电机"
	quest.1800000000000013.quest_desc: [
		"利用日光来产生能量。"
		"优势：白天无需燃料维护，即可免费获取能量。"
		"限制：它不会在夜间或黑暗的地方生成。"
		"创建集成：由工厂生产的板材和机械组件组装而成。"
	]
	quest.1800000000000013.title: "太阳能发电机"
	quest.1800000000000014.quest_desc: [
		"燃烧生物质以产生电力。"
		"优势：可以利用自动化产生的有机和农业副产品。"
		"限制：需要持续供应可燃材料。"
		"创建整合：其制造链涉及部署和机械合成等流程。"
	]
	quest.1800000000000014.title: "生物发电机"
	quest.1800000000000015.quest_desc: [
		"效率与输出更高的升级版太阳能发电机。"
		"它保留了太阳能的优势，同时每块产生的能量更多。"
		"创建整合包：需要更高级的组件，例如精密机械装置。"
	]
	quest.1800000000000015.title: "高级太阳能发电机"
	quest.1800000000000016.quest_desc: [
		"在高处安装风力发电机，并将其连接到消耗FE的机器上。"
		"确认电力已输送，机器可以持续运行。"
	]
	quest.1800000000000016.title: "风力发电，即刻见效"
	quest.1800000000000017.quest_desc: [
		"设置一个生物发电机，并用种子或植物废料等生物质为其供能。"
		"验证其发电量是否足以供应基本负载。"
	]
	quest.1800000000000017.title: "生物质转化为能源"
	quest.1800000000000018.quest_desc: [
		"你不需要建造所有发电机，但至少需要有一个FE源在运行。"
		"激活发电是稳定电网的第一步。"
	]
	quest.1800000000000018.title: "正在运行的发电机"
	quest.1800000000000019.quest_desc: [
		"能量立方体储存FE，而发电机则负责产生FE。"
		"储能装置能让你积累电力、吸收用电高峰，并在发电量波动时保持机器运行。"
		"建造四个单元，以便将能源分配到不同的工厂区域。"
		"创建整合：当前配方将旧版 Mekanism 工业链替换为你工厂中的直接组装路线。"
	]
	quest.1800000000000019.title: "基础能量立方体 (×4)"
	quest.180000000000001A.quest_desc: [
		"比普通能量立方体具有更高的容量和传输速率。"
		"在电力需求开始增长的任何地方使用它。"
	]
	quest.180000000000001A.title: "高级能量立方体"
	quest.180000000000001B.quest_desc: [
		"高容量存储，用于更强大的电气网络。"
		"适合同时为多台机器提供动力。"
	]
	quest.180000000000001B.title: "精英能量立方体"
	quest.180000000000001C.quest_desc: [
		"Mekanism 能量立方系列的最顶层。"
		"它能承受高负荷，为您的整个技术基础设施提供稳定的电力。"
	]
	quest.180000000000001C.title: "终极能量立方体"
	quest.180000000000001D.quest_desc: [
		"建造完整的电气基础设施：至少一台产生FE的发电机，一个储存FE的能源立方体，以及一台连接的消耗机器。"
		"系统应能持续运行，无需人工干预。"
		"掌握了生成和存储，你的创造工厂就准备好为更先进的科技提供动力了。"
	]
	quest.180000000000001D.title: "工厂不能停止运转"
	quest.1800000000000020.quest_desc: ["使用Mekanism基础设施移动FE。原版配方已被Create制造取代。"]
	quest.1800000000000020.title: "通用电缆 (Universal Cable)"
	quest.1800000000000021.quest_desc: ["流体获得了更先进的科技选项，同时保留了Create的视觉运输和Pipez的简洁性。"]
	quest.1800000000000021.title: "机械管道"
	quest.1800000000000022.quest_desc: ["Mekanism 物品物流回归整合包，但始于机械合成以保留工业特色。"]
	quest.1800000000000022.title: "物流运输机 (Logistical Transporter)"
	quest.1800000000000023.quest_desc: ["为真正需要的系统准备气体和化学基础设施，而不会自动解锁整个机器树。"]
	quest.1800000000000023.title: "Pressurized Tube"
	quest.1800000000000024.quest_desc: ["第五根运输支柱完善了该套装：热能现在有了自己的高级基础设施路线。"]
	quest.1800000000000024.title: "热力学导体"
	quest.1800000000000025.quest_desc: ["将五个家族全部提升至终极。每次升级都需要使用通过Create制造并经逐步高温处理的Mekanism合金。"]
	quest.1800000000000025.title: "终极基础设施整合包任务书"
	quest.1800000000000026.quest_desc: ["能量、物品、流体、化学品和热量现已构成完整的技术基础设施。这一里程碑为 Omega 能源核心提供动力。"]
	quest.1800000000000026.title: "完成科技网络 (Complete Tech Network)"
	quest.1800000000000030.quest_desc: ["青铜、锇和钢制工具仍是实用装备，但制造需通过 Create 机械合成。Mekanism 提供材料，Create 构建技术。"]
	quest.1800000000000030.title: "Mekanism 工业工具"
	quest.1800000000000031.quest_desc: ["精制萤石和精制黑曜石构成了先进的Mekanism工具层。它们的原始配方已被更昂贵的Create制造方法所取代。"]
	quest.1800000000000031.title: "高科技像素块 (High-Tech Paxels)"
	quest.1800000000000032.quest_desc: ["原版Mekanism工具回来了，但不是免费的。它的5×5组装需要原子合金、能量锭、坚固板、下界合金和工业机制。"]
	quest.1800000000000032.title: "原子分解器"
	quest.1800000000000033.quest_desc: ["将Mekanism物流提升至量子级。Entangloporter现已成为融合Atomic Alloy、Ultimate Circuits、能量及Create工业机制的5×5里程碑。"]
	quest.1800000000000033.title: "量子纠缠传送器"
	quest.1800000000000034.quest_desc: ["可选路线。QIO 驱动阵列存放 QIO 驱动并集中数字存储，而 QIO 仪表盘则是访问该网络的接口。Mekanism 提供技术支持，Create 负责建造结构。"]
	quest.1800000000000034.title: "QIO 基础设施"
	quest.1800000000000035.quest_desc: ["通过你的工厂生产出终极感应单元和供应器。极端能源需要真正的基建，而不仅仅是一张工作台。"]
	quest.1800000000000035.title: "终极感应矩阵"
	quest.1800000000000036.quest_desc: ["核合成器代表了Mekanism顶尖的科学处理能力，现已由SPS外壳、超充线圈、终极电路和Create工业组件建造而成。"]
	quest.1800000000000036.title: "反质子核合成器"
	quest.1800000000000037.quest_desc: ["可选的自动化采矿路线。昂贵的工业制造下仍有数字矿工，但它并非通关必需，也不会取代神秘蜜蜂/生产蜜蜂作为主要可再生资源路线。"]
	quest.1800000000000037.title: "工业数字矿工"
	quest.190000000000000C.quest_desc: [
		"Menril 树木是 Integrated Dynamics 的基础。你可以在沼泽、森林或淡水环境中找到它们，例如沼泽、森林和河流生物群系。"
		"打破树叶收集Menril浆果，并用斧头采集原木。此任务仅为探索的起点标记。"
	]
	quest.190000000000000C.title: "找到一棵门里尔树 (Menril Tree)"
	quest.190000000000000D.quest_desc: [
		"Menril 木材耐用且用途广泛。用八根原木，你就有足够的材料来开始生产逻辑网络所需的晶体和结构了。"
		"多余的留着，因为扩建电缆和组件会消耗大量木材。"
	]
	quest.190000000000000D.title: "Menril 日志"
	quest.190000000000000E.quest_desc: [
		"Menril浆果长在Menril叶子上。紧急时可以食用，但主要用途是提取树脂。"
		"收集八个，这样你下阶段就有足够的原材料了。"
	]
	quest.190000000000000E.title: "门里尔浆果"
	quest.190000000000000F.quest_desc: [
		"手持原木和浆果，你可以提取宝贵的 Menril 树脂并存入桶中。树脂是制作方块、晶体和逻辑组件的核心材料。"
		"你现在已正式准备好进入智能自动化的时代。"
	]
	quest.190000000000000F.title: "一桶 Menril 树脂"
	quest.1900000000000050.quest_desc: [
		"Menril树脂可以固化为自身的方块。这有助于保持材料整洁，并为存储网络组件的结晶化提供中间步骤。"
		"合成树脂块，继续前往结晶化的Menril。"
	]
	quest.1900000000000050.title: "Menril树脂块"
	quest.1900000000000051.quest_desc: [
		"将树脂块结晶化可生成坚硬且导电的材料。它是可变变压器和其他核心集成动力学组件的必需品。"
		"制作此方块以解锁后续的所有内容。"
	]
	quest.1900000000000051.title: "结晶化曼里尔方块"
	quest.1900000000000052.quest_desc: [
		"Menril Glass 兼具耐用性与透明度。除装饰外，它还用于逻辑网络中的光面板和其他视觉组件。"
		"制作一块 Menril 玻璃以继续。"
	]
	quest.1900000000000052.title: "Menril 玻璃"
	quest.1900000000000053.quest_desc: [
		"输入变量转换器允许逻辑网络读取世界数据。它用于读取器和传感器，使你的工厂能够观察机器和物品栏的状态。"
		"作为存储系统的一部分，制作一个。"
	]
	quest.1900000000000053.title: "输入变量变压器"
	quest.1900000000000054.quest_desc: [
		"输出变量变压器是输入版本的对应物：它允许逻辑网络通过控制机器和设备来作用于世界。"
		"有了这两种变压器，你就有了构建系统主干的基本模块。"
	]
	quest.1900000000000054.title: "输出变量变压器"
	quest.1900000000000055.quest_desc: [
		"光面板是一个可通过逻辑网络控制的简单视觉组件，同时也是显示面板的基础。"
		"制作一个光板，开始使用视觉输出功能。"
	]
	quest.1900000000000055.title: "照明面板"
	quest.1900000000000056.quest_desc: [
		"显示屏会显示逻辑网络的信息，包括数字、文本和状态。这是无需打开终端即可查看数据的第一步。"
		"制作一个以解锁存储终端。"
	]
	quest.1900000000000056.title: "显示面板"
	quest.1900000000000057.quest_desc: [
		"存储终端是系统的核心接口。它能让你访问和管理逻辑网络中连接的所有物品，将工厂变成一个统一的库存。"
		"建造它，开启你的智能存储系统。"
	]
	quest.1900000000000057.title: "存储终端"
	quest.1900000000000058.quest_desc: [
		"逻辑线缆连接集成动力组件，允许变量和信息在它们之间传输。"
		"没有线缆，终端就无法与物品接口通信。"
	]
	quest.1900000000000058.title: "逻辑线缆"
	quest.1900000000000059.quest_desc: [
		"物品接口将逻辑网络连接到箱子、桶等物理物品栏。它使存储终端能够查看和访问这些物品栏内的物品。"
		"用逻辑线缆将其连接到终端，即可开始使用该系统。"
	]
	quest.1900000000000059.title: "物品界面"
	quest.190000000000005A.quest_desc: [
		"便携式存储终端将存储终端的强大功能带入您的手中，让您在连接器范围内任何地方都能访问网络。"
		"要使其正常工作，网络中需要一个单向连接器。"
	]
	quest.190000000000005A.title: "便携式存储终端"
	quest.190000000000005B.quest_desc: [
		"单向连接器是便携式终端与逻辑网络之间无线通信的基础。"
		"把它安装在你的存储系统附近。"
	]
	quest.190000000000005B.title: "单向连接器"
	quest.190000000000005C.quest_desc: [
		"全向连接器是单向连接器的升级版，可接受所有方向的连接，从而扩展便携式终端设置的灵活性。"
		"有了它，你的存储网络将更容易扩展和连接。"
	]
	quest.190000000000005C.title: "全向连接器 (Omni-Directional Connector)"
	quest.1900000000000060.quest_desc: [
		"除了 Menril Resin，Integrated Dynamics 也使用 Chorus Resin 制作高级组件。"
		"获取紫颂树脂，以便你能制作出对应的方块。"
	]
	quest.1900000000000060.title: "紫颂树脂"
	quest.1900000000000061.quest_desc: [
		"和门里树脂一样，紫颂树脂也可以被压缩成实心方块。"
		"合成该方块以继续向结晶化方向推进。"
	]
	quest.1900000000000061.title: "合唱树脂块 (Block of Chorus Resin)"
	quest.1900000000000062.quest_desc: [
		"将紫颂树脂块结晶化可生成高纯度结晶块，用于逻辑控制器。"
		"制作一个以解锁导演。"
	]
	quest.1900000000000062.title: "结晶化合唱块"
	quest.1900000000000063.quest_desc: [
		"逻辑控制器是一种高级组件，用于引导和组织变量在网络中的流动。"
		"需要建造全向连接器（Omni-Directional Connector）。"
	]
	quest.1900000000000063.title: "逻辑导演"
	quest.1A00000000000001.quest_desc: [
		"创建主旋转，但现在我们将把它连接到FE力量的世界。"
		"Crafts & Additions 提供电机、发电机、电线和储能装置。"
		"本章将教你如何把旋转转化为电能，再把电能转化为旋转。"
	]
	quest.1A00000000000001.title: "超越运动 (Beyond Motion)"
	quest.1A00000000000002.quest_desc: [
		"电气和机械组件的基础材料。"
		"制作锌板以开始制造流程。"
	]
	quest.1A00000000000002.title: "锌板"
	quest.1A00000000000003.quest_desc: [
		"用于制作电线和连接器的导电棒。"
		"这对 Crafts & Additions 电气网络至关重要。"
	]
	quest.1A00000000000003.title: "铜制长杆"
	quest.1A00000000000004.quest_desc: [
		"用于建筑和组件的基础机械材料。"
		"它还可以被加工成铁线（Iron Wire）。"
	]
	quest.1A00000000000004.title: "铁质长杆"
	quest.1A00000000000005.quest_desc: [
		"一种将锭和板转化为棒和线的机器。"
		"§6思考：§r使用可视化功能，看看如何用传送带和漏斗实现自动化。"
	]
	quest.1A00000000000005.title: "Rolling Mill"
	quest.1A00000000000006.quest_desc: [
		"用于小型连接器的低电流导体。"
		"用轧机生产，并为最初的电路连接准备好几块。"
	]
	quest.1A00000000000006.title: "铜线"
	quest.1A00000000000007.quest_desc: [
		"可存储铜线，并允许你连接两个兼容的连接器。"
		"连接完成后，空卷轴会被返还，以便重复使用。"
	]
	quest.1A00000000000007.title: "铜质线轴"
	quest.1A00000000000008.quest_desc: [
		"一种基础的低压导电导线。"
		"它是特定配方中铜的替代品，能扩展你的电气元件库存。"
	]
	quest.1A00000000000008.title: "铁质电线"
	quest.1A00000000000009.quest_desc: [
		"一种用于较大连接器的导电性高导线。"
		"它能承受比铜更多的电力，并为更重的负载做好准备。"
	]
	quest.1A00000000000009.title: "金线"
	quest.1A0000000000000A.quest_desc: [
		"金和银的合金，导电性极佳。"
		"它是高级高电流电线和电子元件的基础。"
	]
	quest.1A0000000000000A.title: "Electrum Ingot"
	quest.1A0000000000000B.quest_desc: [
		"容量更高的超大电流导体。"
		"使用大型连接器及需要更强电力背板的机器。"
	]
	quest.1A0000000000000B.title: "Electrum Wire"
	quest.1A0000000000000C.quest_desc: [
		"将FE兼容方块连接到低电流导线。"
		"使用铜线卷在连接器之间建立链接，并开始构建你的电气网络。"
	]
	quest.1A0000000000000C.title: "小型连接器"
	quest.1A0000000000000D.quest_desc: [
		"专为金和电金导线设计的大电流连接器。"
		"当工厂开始在机器间传输大量能量时，这一点就变得重要了。"
	]
	quest.1A0000000000000D.title: "大型连接器"
	quest.1A0000000000000E.quest_desc: [
		"一种可临时储存电荷的组件。"
		"它被用作电机、发电机和其他机电设备的构建模块。"
	]
	quest.1A0000000000000E.title: "电容器"
	quest.1A0000000000000F.quest_desc: [
		"将FE能量转换为Create旋转。"
		"无需铺设长长的竖井网络即可为机械线路供电。通过后面板调整 RPM，并为所选速度提供足够的能量。"
	]
	quest.1A0000000000000F.title: "电动机"
	quest.1A00000000000010.quest_desc: [
		"将Create的旋转转化为FE能量。"
		"运行需要至少32 RPM，发电量随转速升高而增加。"
	]
	quest.1A00000000000010.title: "Alternator"
	quest.1A00000000000011.quest_desc: [
		"建造一个将旋转转化为电能，再将电能转化为旋转的系统。"
		"确认Alternator和Electric Motor能作为一个集成系统协同工作。"
	]
	quest.1A00000000000011.title: "机电电路 (Electromechanical Circuit)"
	quest.1A00000000000012.quest_desc: [
		"一个用于存储大量FE能量的多方块结构。"
		"配置输入和输出连接器，以便安全地充放电和分配储存的电力。"
	]
	quest.1A00000000000012.title: "蓄电器"
	quest.1A00000000000013.quest_desc: [
		"在移动装置和固定工厂之间传输FE能量。"
		"将两个接口对齐，以便移动设备可以充电或放电，而无需将装置永久连接到基地。"
	]
	quest.1A00000000000013.title: "便携式能源接口"
	quest.1A00000000000014.quest_desc: [
		"通过红石信号控制FE能量的流动。"
		"当您需要工厂的电气部分根据机器状态或控制逻辑自动响应时，请使用它。"
	]
	quest.1A00000000000014.title: "红石中继器"
	quest.1A00000000000015.quest_desc: [
		"由种子产生的易燃液体。"
		"它可以用作液体燃料，开启了 Crafts & Additions 的可再生燃料分支。"
	]
	quest.1A00000000000015.title: "种子油"
	quest.1A00000000000016.quest_desc: [
		"一种由种子油提炼的更高效液体燃料。"
		"在兼容的、接受易燃液体的燃烧器和机器中使用；具体处理流程请查看 JEI。"
	]
	quest.1A00000000000016.title: "生物燃料"
	quest.1A00000000000017.quest_desc: [
		"用作固体燃料的压缩有机物。"
		"它为工厂废料赋予了实用价值，并支持可再生能源分支。"
	]
	quest.1A00000000000017.title: "生物质"
	quest.1A00000000000018.quest_desc: [
		"允许烈焰熔炉接受易燃液体。"
		"§6思考：§r使用可视化功能查看预期布局，然后用整合包支持的桶或管道为其填充。"
	]
	quest.1A00000000000018.title: "Strawed Blaze Burner"
	quest.1A00000000000019.quest_desc: [
		"为放置在其下方的FE供电物品充能。"
		"用红石激活后，它还能伤害附近的生物，既适合当充电器，也适合用于自动化装置。"
	]
	quest.1A00000000000019.title: "特斯拉线圈"
	quest.1A0000000000001A.quest_desc: [
		"你已掌握 Create 旋转与 FE 能量之间的转换。"
		"你的工厂现在可以将电机、发电机、存储和自动化整合为一个电气机械基础设施。"
	]
	quest.1A0000000000001A.title: "机电式桥梁"
	quest.1B00000000000001.quest_desc: ["蜜蜂笼是捕捉和运输产卵蜜蜂的基本工具。制作一个，你就可以开始建造蜂场，而无需把每只蜜蜂都引到世界各地。"]
	quest.1B00000000000001.title: "蜜蜂笼"
	quest.1B00000000000002.quest_desc: ["蜂蜜点心可用于喂养和繁殖蜜蜂等多种互动。请准备一些，因为随着蜂场扩建，它们会持续消耗。"]
	quest.1B00000000000002.title: "蜂蜜小点心"
	quest.1B00000000000003.quest_desc: ["用蜂笼捕捉合适的蜜蜂并带回基地。此步骤标志着生产性蜜蜂的正式开始；具体种类和条件可在JEI中查看。"]
	quest.1B00000000000003.title: "你的第一只蜜蜂"
	quest.1B00000000000004.quest_desc: ["先从一个简单的蜂巢开始，了解庇护所、蜜蜂进出等基本循环。这是通往高级蜂巢的桥梁，在那里产量会开始成倍增长。"]
	quest.1B00000000000004.title: "你的第一个蜂巢"
	quest.1B00000000000005.quest_desc: ["高级蜂巢是高效蜜蜂产出的核心。它能接受升级，让你把小蜂场变成持续产资源的建筑。"]
	quest.1B00000000000005.title: "高级蜂巢"
	quest.1B00000000000006.quest_desc: ["扩展箱可增加高级蜂巢的容量，并为更高效的操作做好准备。在升级生产前，请先将其与蜂巢一同安装。"]
	quest.1B00000000000006.title: "扩展箱 Expansion Box"
	quest.1B00000000000007.quest_desc: ["放置高级蜂巢，连接扩展箱，并将蜜蜂置于适宜工作的环境中。设置完成后，确认此步骤即可开始生产蜂巢。"]
	quest.1B00000000000007.title: "建造你的第一个蜂箱区"
	quest.1B00000000000008.quest_desc: ["从正常运作的蜂巢中获得你的第一个蜂巢。蜂巢是加工成蜂蜜和工业资源的原材料。"]
	quest.1B00000000000008.title: "你的第一个蜂巢蜜块"
	quest.1B00000000000009.quest_desc: ["离心机可将梳子转化为实用产品。制作机器并查看 JEI，了解每种梳子的可能产出，再规划你的生产线。"]
	quest.1B00000000000009.title: "离心机"
	quest.1B0000000000000A.quest_desc: ["在离心机中处理蜂巢，并确认你理解基本流程：蜂巢生产蜂巢，离心分离产品，结果进入存储或工厂使用。"]
	quest.1B0000000000000A.title: "初次加工"
	quest.1B0000000000000B.quest_desc: ["部分物种可通过繁殖获得。使用JEI显示的组合，并观察每只蜜蜂的需求，无需仅靠探索即可扩展你的图鉴。"]
	quest.1B0000000000000B.title: "蜜蜂繁殖"
	quest.1B0000000000000C.quest_desc: ["某些蜜蜂可通过在特定物种上使用特定物品或方块进行转换生成。 §bJEI:§r 请查看已安装的配方以了解具体条件，并利用此机制解锁新的资源线。"]
	quest.1B0000000000000C.title: "蜜蜂转化器"
	quest.1B00000000000010.quest_desc: ["制作与煤炭相关的梳子。这是证明养蜂场能将养蜂业转化为可持续原材料来源的最初证据之一。"]
	quest.1B00000000000010.title: "煤炭火把"
	quest.1B00000000000011.quest_desc: ["制作一个铁梳并在需要时处理。目标是在蜂箱内开始用可再生发电替代部分手动采矿。"]
	quest.1B00000000000011.title: "铁制梳子"
	quest.1B00000000000012.quest_desc: ["制作一个铜梳。铜在许多模组包技术中都有出现，所以可再生来源对未来的工厂很有价值。"]
	quest.1B00000000000012.title: "铜制梳子"
	quest.1B00000000000013.quest_desc: ["制作一个红石梳。红石被控制、逻辑和技术组件消耗，因此该物种特别适合连续生产。"]
	quest.1B00000000000013.title: "红石梳子"
	quest.1B00000000000014.quest_desc: ["制作一个金梳。此分支的目标是在转向更高级材料前，先丰富蜂箱的资源种类。"]
	quest.1B00000000000014.title: "黄金梳子"
	quest.1B00000000000015.quest_desc: ["制作一个青金石梳，并在你的蜂箱中保持该物种可用。这便完成了本阶段的首批可再生资源。"]
	quest.1B00000000000015.title: "青金石梳子"
	quest.1B00000000000016.quest_desc: ["你已在蜂场建立了主要的基础资源线。从现在开始，新蜜蜂需要更多的准备、繁殖或转换。"]
	quest.1B00000000000016.title: "基础目录已完成"
	quest.1B00000000000017.quest_desc: ["制作钻石梳。此材料标志着进入更高价值的资源层级，稳定的生产比仅获取一件更为重要。"]
	quest.1B00000000000017.title: "钻石梳子"
	quest.1B00000000000018.quest_desc: ["制作一个绿宝石梳，并在你的目录中确认新物种。 §bJEI:§r 使用配方查看器来验证如何获得蜜蜂以及离心可以产生什么。"]
	quest.1B00000000000018.title: "Emerald Comb"
	quest.1B00000000000019.quest_desc: ["制作用于此任务的玫瑰石英梳。名称与任务实际检测到的物品一致，以避免与下界石英混淆。"]
	quest.1B00000000000019.title: "玫瑰石英梳子"
	quest.1B0000000000001A.quest_desc: ["制作一个与烈焰相关的梳子。这一行开始涵盖通常需要探索或战斗的资源，使蜂箱在自动化方面变得越来越有价值。"]
	quest.1B0000000000001A.title: "烈焰人燃烧棒"
	quest.1B0000000000001B.quest_desc: ["本阶段的进阶物种现已受你控制。重点已从多样性转向蜂巢本身的技术材料与升级。"]
	quest.1B0000000000001B.title: "高级目录已完成"
	quest.1B0000000000001C.quest_desc: ["制作黄铜梳。黄铜对创造基础设施很重要，因此该物种将生产性蜜蜂直接连接到你的主工厂。"]
	quest.1B0000000000001C.title: "黄铜梳子"
	quest.1B0000000000001D.quest_desc: ["制作青铜梳并保持物种可用。可再生的技术合金有助于蜂箱支持整合包中的其他发展树。"]
	quest.1B0000000000001D.title: "青铜梳子"
	quest.1B0000000000001E.quest_desc: ["制作一个末影梳。该资源可解锁更高级的材料线，并减少对危险维度中手动采集的依赖。"]
	quest.1B0000000000001E.title: "末影梳"
	quest.1B00000000000020.quest_desc: ["你已完成本“生产蜜蜂”阶段规划的技术资源集。下一步是提高蜂箱效率，并自动化蜂巢到存储的运输路线。"]
	quest.1B00000000000020.title: "技术目录已完整解锁"
	quest.1B00000000000021.quest_desc: ["生产力升级可提升产量。逐步安装升级，并使用JEI和蜂巢信息来观察已安装版本中的效果和限制。"]
	quest.1B00000000000021.title: "生产力升级模组"
	quest.1B00000000000022.quest_desc: ["时间升级会缩短生产周期。当基础设施运行良好，且物品生成速度成为瓶颈时，它便会发挥作用。"]
	quest.1B00000000000022.title: "速度升级"
	quest.1B00000000000023.quest_desc: ["模拟升级能让蜂巢以更受控的模式运行，非常适合工业设施。它将是我们下一条连续生产线的基础。"]
	quest.1B00000000000023.title: "模拟升级"
	quest.1B00000000000024.quest_desc: ["配置一个带有模拟升级的高级蜂巢，并确认其在正确条件下能正常生产。此处使用对勾，因为FTB任务无法验证蜂巢的完整内部配置。"]
	quest.1B00000000000024.title: "模拟生产"
	quest.1B00000000000025.quest_desc: ["自动化蜂巢的蜂蜡提取，使其自动移至加工或存储，无需手动收集。使用最适合当前模组包阶段的运输系统。"]
	quest.1B00000000000025.title: "自动煤炭运输机"
	quest.1B00000000000026.quest_desc: ["同时自动化离心机的输出。理想情况下，梳子被接收、处理，每种产物都被送往下一目的地，无需玩家清空机器。"]
	quest.1B00000000000026.title: "自动离心机输出接口"
	quest.1B00000000000027.quest_desc: ["保留四台离心机以提高处理能力。此任务将离心过程转变为工厂规模的阶段，可同时处理多个蜂巢。"]
	quest.1B00000000000027.title: "并行处理"
	quest.1B00000000000028.quest_desc: ["建造一个包含高级蜂巢、升级、蜂巢运输和自动处理的蜂场。当该结构能作为工厂的一个集成区域运行时，请确认。"]
	quest.1B00000000000028.title: "工业养蜂场"
	quest.1B00000000000029.quest_desc: ["你将养蜂变成了自动化的资源来源。此里程碑结束了当前的“生产性蜜蜂”阶段，使系统为未来物种和整合包集成做好准备。"]
	quest.1B00000000000029.title: "工业蜂群 (The Industrial Swarm)"
	quest.1C00000000000001.quest_desc: [
		"你已经了解了可再生资源的来源：神秘农业和蜜蜂养殖。"
		"现在我们将把它们改造成全自动的 Create 工厂。"
		"本章将教你如何无需手动干预地采集、收集、运输和处理资源。"
	]
	quest.1C00000000000001.title: "农业综合发展模组整合包"
	quest.1C00000000000010.quest_desc: [
		"从铁种子开始，这是一种基础且丰富的资源来源。"
		"它们将成为我们自动化神秘农业农场的基石。"
	]
	quest.1C00000000000010.title: "铁质种子"
	quest.1C00000000000011.quest_desc: ["获得一个铁质精华，以确认作物正在正常生长。"]
	quest.1C00000000000011.title: "铁质精华"
	quest.1C00000000000012.quest_desc: [
		"自动收割作物的核心组件之一。"
		"可以安装在装置或固定结构上，以清扫不断扩大的区域。"
	]
	quest.1C00000000000012.title: "机械收割机"
	quest.1C00000000000013.quest_desc: [
		"建造旋转和移动装置的基础设施。"
		"用它来移动收割机和犁，穿越田野。"
	]
	quest.1C00000000000013.title: "机械轴承"
	quest.1C00000000000014.quest_desc: [
		"用于在旋转装置上支撑收割机的结构性组件。"
		"使用径向底盘来覆盖轴周围的圆形生长区域。"
	]
	quest.1C00000000000014.title: "径向底盘"
	quest.1C00000000000015.quest_desc: ["在装置上附一个箱子，这样在移动时收集的物品就能累积起来。"]
	quest.1C00000000000015.title: "机械装置物品栏"
	quest.1C00000000000016.quest_desc: [
		"将物品从移动装置转移到工厂中。"
		"对齐后，一对接口可以传输整个物品栏，因此对于旋转式收割机至关重要。"
	]
	quest.1C00000000000016.title: "便携式存储接口"
	quest.1C00000000000017.quest_desc: ["大容量接收缓冲器，非常适合收集农场的产出。"]
	quest.1C00000000000017.title: "物品宝库"
	quest.1C00000000000018.quest_desc: [
		"控制物品在物品栏和运输线之间的输入和输出。"
		"用它来拉取农场产品并送往加工厂进行处理。"
	]
	quest.1C00000000000018.title: "安山岩漏斗"
	quest.1C00000000000019.quest_desc: [
		"连接传送带以创建运输系统。"
		"这条物流主干线将采集的资源运往存储和加工处。"
	]
	quest.1C00000000000019.title: "传送带连接器"
	quest.1C0000000000001A.quest_desc: [
		"在铁作物上方建造一个带有机械收割机的旋转装置。"
		"加入一个箱子，以便在操作期间存储采集到的物品。"
	]
	quest.1C0000000000001A.title: "建造自动化农场装置"
	quest.1C0000000000001B.quest_desc: ["使用便携式存储接口将装置卸载到物品宝库中，无需手动干预。"]
	quest.1C0000000000001B.title: "自动卸载已收获的作物（Harvest Automatically）"
	quest.1C0000000000001C.quest_desc: [
		"证明你的神秘农业农场已经实现规模化生产。"
		"仅使用自动化手段积累 64 个铁质精华。"
	]
	quest.1C0000000000001C.title: "64 铁质精华"
	quest.1C0000000000001D.quest_desc: [
		"一个通过 Create 生产线自动执行合成配方的方块。"
		"它将用于将铁质精华转化为铁锭。"
	]
	quest.1C0000000000001D.title: "机械合成台"
	quest.1C0000000000001E.quest_desc: [
		"配置机械工匠，自动将铁精加工成铁锭。"
		"使用漏斗和传送带来投入原料并移除成品。"
	]
	quest.1C0000000000001E.title: "自动化精华 → 资源"
	quest.1C0000000000001F.quest_desc: [
		"证明你的神秘生产线能将精粹炼成锭。"
		"从自动化农场中收集 64 个铁锭。"
	]
	quest.1C0000000000001F.title: "64 个铁锭 (Mystical)"
	quest.1C00000000000020.quest_desc: [
		"加快神秘农业作物的生长速度。"
		"安装在作物附近以提高农场产量。"
	]
	quest.1C00000000000020.title: "生长加速器"
	quest.1C00000000000021.quest_desc: ["将生长加速器整合到你的农场中，并确认收获率有所提高。"]
	quest.1C00000000000021.title: "加速作物生长"
	quest.1C00000000000030.quest_desc: [
		"支持升级和大规模生产的先进蜂巢。"
		"这是我们生物产业的基础所在。"
	]
	quest.1C00000000000030.title: "高级蜂巢"
	quest.1C00000000000031.quest_desc: ["扩展了高级蜂巢的容量，可以容纳更多蜜蜂和升级。"]
	quest.1C00000000000031.title: "扩展箱 Expansion Box"
	quest.1C00000000000032.quest_desc: [
		"由铁蜜蜂产出的梳子。"
		"这是将被收集和处理的原材料。"
	]
	quest.1C00000000000032.title: "铁制梳子"
	quest.1C00000000000033.quest_desc: ["使用安山岩漏斗，从高级蜂巢中自动提取梳子。"]
	quest.1C00000000000033.title: "提取漏斗 Extraction Funnel"
	quest.1C00000000000034.quest_desc: ["将提取的梳子运送到缓冲区。"]
	quest.1C00000000000034.title: "传送带连接器"
	quest.1C00000000000035.quest_desc: ["用于在加工前积累梳子的中间缓冲区。"]
	quest.1C00000000000035.title: "物品宝库"
	quest.1C00000000000036.quest_desc: ["确认梳子能持续从高级蜂巢中移除，无需手动干预。"]
	quest.1C00000000000036.title: "自动化梳子提取器"
	quest.1C00000000000037.quest_desc: [
		"一种将梳子加工成有用资源的机器。"
		"创造者不会取代其作用，但可以负责周围的运输和分配。"
	]
	quest.1C00000000000037.title: "离心机"
	quest.1C00000000000038.quest_desc: [
		"建造四台离心机以实现并行处理。"
		"这样可以提高生产线的容量。"
	]
	quest.1C00000000000038.title: "4 台离心机"
	quest.1C00000000000039.quest_desc: ["将物品分配到多个输出中，适用于将梳子分配到离心机之间。"]
	quest.1C00000000000039.title: "黄铜隧道"
	quest.1C0000000000003A.quest_desc: [
		"一个可以在多个目的地之间精确输送物品的机械臂。"
		"有助于将梳子分配到各个加工机器中。"
	]
	quest.1C0000000000003A.title: "机械臂"
	quest.1C0000000000003B.quest_desc: [
		"使用黄铜管道或机械臂，将Comb分配到全部四个离心机中。"
		"确认流程保持连续和平衡的状态。"
	]
	quest.1C0000000000003B.title: "自动分发梳子"
	quest.1C0000000000003C.quest_desc: [
		"证明你的蜂箱可以工业化生产蜂巢。"
		"收集 64 个铁梳。"
	]
	quest.1C0000000000003C.title: "64 个铁梳子"
	quest.1C0000000000003D.quest_desc: ["自动收集离心机中的产物并将其运输到存储中。"]
	quest.1C0000000000003D.title: "自动化输出提取器"
	quest.1C0000000000003E.quest_desc: ["证明Comb处理可以生成足量的铁锭。"]
	quest.1C0000000000003E.title: "64 个铁锭 (蜜蜂)"
	quest.1C0000000000003F.quest_desc: [
		"无需自由活动的蜜蜂即可实现持续的工业生产。"
		"它将蜂箱变成一个稳定的生产设施。"
	]
	quest.1C0000000000003F.title: "模拟升级"
	quest.1C00000000000040.quest_desc: ["使用模拟升级配置高级蜂巢，并确认生产不间断地进行。"]
	quest.1C00000000000040.title: "连续生产养蜂场"
	quest.1C00000000000050.quest_desc: [
		"选择你的可持续路线：神秘农业 OR 高效蜜蜂。无需完成两者即可继续。"
		"完成任一分支，然后用你偏好的路线囤积 256 个铁锭。另一个分支完全可选，可以稍后探索。"
	]
	quest.1C00000000000050.title: "选择你的资源路线"
	quest.1C00000000000051.quest_desc: [
		"你已通过至少一种可再生途径证明了资源自给自足。"
		"神秘蜜蜂和高效蜜蜂是两种不同的进阶路线，而非两项要求。选择适合你工厂的那一种，或者两者都探索。"
	]
	quest.1C00000000000051.title: "资源独立性（Resource Independence）"
	quest.1D00000000000001.quest_desc: [
		"直到现在，你的工厂都是以旋转来传输能量的。"
		"创造：新纪元引入了一种新的能源形式：电力。"
		"有了它，你就可以远距离传输电力，并且无需无尽管道来运行机器。"
	]
	quest.1D00000000000001.title: "电力的发现"
	quest.1D00000000000002.quest_desc: [
		"核燃料中使用的放射性物质——钍的主要来源。"
		"它属于 Create: New Age 的机电链，用于准备发电、输电或用电的下一阶段。 §bJEI:§r批量制作前请在此存档中查看确切配方。"
	]
	quest.1D00000000000002.title: "钍矿石"
	quest.1D00000000000003.quest_desc: [
		"核燃料的基础材料。为后期阶段保留储备。"
		"它属于 Create: New Age 的机电链，用于准备发电、输电或用电的下一阶段。 §bJEI:§r批量制作前请在此存档中查看确切配方。"
	]
	quest.1D00000000000003.title: "钍元素（Thorium）"
	quest.1D00000000000004.quest_desc: [
		"用于高级核燃料的经过处理和未稳定的钍。"
		"它属于 Create: New Age 的机电连锁，用于准备发电、输电或用电的下一阶段。 §bJEI:§r批量制作前请在此存档中查看确切配方。"
	]
	quest.1D00000000000004.title: "放射性钍元素"
	quest.1D00000000000005.quest_desc: [
		"用于电力传输和电路制作的初级导体。"
		"它属于 Create: New Age 的机电连锁，用于准备发电、输电或用电的下一阶段。 §bJEI:§r批量制作前请在此存档中查看确切配方。"
	]
	quest.1D00000000000005.title: "铜线"
	quest.1D00000000000006.quest_desc: [
		"更复杂电子电路的基础组件。"
		"它属于 Create: New Age 的机电链，用于准备发电、输电或用电的下一阶段。 §bJEI:§r批量制作前请在此存档中查看确切配方。"
	]
	quest.1D00000000000006.title: "空白电路"
	quest.1D00000000000007.quest_desc: [
		"用于电机和能量增强器的简单电路。"
		"它属于 Create: New Age 的机电连锁，用于准备发电、输电或用电的下一阶段。 §bJEI:§r批量制作前请在此存档中查看确切配方。"
	]
	quest.1D00000000000007.title: "铜质电路"
	quest.1D00000000000008.quest_desc: [
		"发电机和电动机中使用的电气接触组件。"
		"它属于 Create: New Age 的机电链，用于准备发电、输电或用电的下一阶段。 §bJEI:§r批量制作前请在此存档中查看确切配方。"
	]
	quest.1D00000000000008.title: "碳刷工具"
	quest.1D00000000000009.quest_desc: [
		"发电机组装所需的强力磁铁。"
		"它属于 Create: New Age 的机电链，用于准备发电、输电或用电的下一阶段。 §bJEI:§r批量制作前请在此存档中查看确切配方。"
	]
	quest.1D00000000000009.title: "分层磁铁"
	quest.1D0000000000000A.quest_desc: [
		"用于在发电机中感应电流的导电线圈。"
		"它属于 Create: New Age 的机电链，用于准备发电、输电或用电的下一阶段。 §bJEI:§r批量制作前请在此存档中查看确切配方。"
	]
	quest.1D0000000000000A.title: "发电机线圈"
	quest.1D0000000000000B.quest_desc: [
		"用于通过电线传输电能的连接点。"
		"它属于 Create: New Age 的机电链，用于准备发电、输电或用电的下一阶段。 §bJEI:§r批量制作前请在此存档中查看确切配方。"
	]
	quest.1D0000000000000B.title: "电气连接器"
	quest.1D0000000000000C.quest_desc: [
		"储存电能以备后用。"
		"它属于 Create: New Age 的机电链，用于准备发电、输电或用电的下一阶段。 §bJEI:§r批量制作前请在此存档中查看确切配方。"
	]
	quest.1D0000000000000C.title: "电池"
	quest.1D0000000000000D.quest_desc: [
		"使用线圈、磁铁、碳刷和电气连接器组装发电机结构。"
		"确认结构已准备好接收创造旋转指令。"
	]
	quest.1D0000000000000D.title: "组装发电机"
	quest.1D0000000000000E.quest_desc: [
		"为发电机提供旋转动力，并确认其正在发电。"
		"使用连接到发电机旋转部分的创造传动轴。"
	]
	quest.1D0000000000000E.title: "生成电力"
	quest.1D0000000000000F.quest_desc: [
		"使用电线和电气连接器将发电机连接到消费者。"
		"确认电力已输送至目的地。"
	]
	quest.1D0000000000000F.title: "传输电力"
	quest.1D00000000000010.quest_desc: [
		"基本马达可将电能转化为旋转运动。"
		"它完成了循环：运动 → 电力 → 运动。"
	]
	quest.1D00000000000010.title: "基础马达"
	quest.1D00000000000011.quest_desc: [
		"一个允许额外传动轴连接到基础马达的扩展组件。"
		"它属于 Create: New Age 的机电链，用于准备发电、输电或用电的下一阶段。 §bJEI:§r批量制作前请在此存档中查看确切配方。"
	]
	quest.1D00000000000011.title: "基础电机扩展模组"
	quest.1D00000000000012.quest_desc: ["使用马达产生旋转并为 Create 机器供电，无需依赖长长的传动轴。"]
	quest.1D00000000000012.title: "为创造机器提供动力"
	quest.1D00000000000013.quest_desc: [
		"一种利用电力为材料充能的机器。"
		"它会解锁过度充能材料的发展线。"
	]
	quest.1D00000000000013.title: "基础能量增强器"
	quest.1D00000000000014.quest_desc: [
		"建造并运行基础能量器以处理材料。"
		"这是一个实践目标：只有在测试了世界中的设置并确认其按预期工作后，才能完成。"
	]
	quest.1D00000000000014.title: "能量装置正在运行中"
	quest.1D00000000000015.quest_desc: [
		"用于高级电机和核组件的活化铁。"
		"它属于 Create: New Age 的机电链，用于准备发电、输电或用电的下一阶段。 §bJEI:§r批量制作前请在此存档中查看确切配方。"
	]
	quest.1D00000000000015.title: "过度充能的铁"
	quest.1D00000000000016.quest_desc: [
		"充满活力的黄金，高电流应用的绝佳导体。"
		"它属于 Create: New Age 的机电链，用于准备发电、输电或用电的下一阶段。 §bJEI:§r批量制作前请在此存档中查看确切配方。"
	]
	quest.1D00000000000016.title: "过度充能的黄金"
	quest.1D00000000000017.quest_desc: [
		"将过充铁制成薄片，用于高级配方。"
		"它属于 Create: New Age 的机电链，用于准备发电、输电或用电的下一阶段。 §bJEI:§r批量制作前请在此存档中查看确切配方。"
	]
	quest.1D00000000000017.title: "过载铁板"
	quest.1D00000000000018.quest_desc: [
		"专为高压输电设计的能量化铁线。"
		"它属于 Create: New Age 的机电链，用于准备发电、输电或用电的下一阶段。 §bJEI:§r批量制作前请在此存档中查看确切配方。"
	]
	quest.1D00000000000018.title: "过载铁线 (Overcharged Iron Wire)"
