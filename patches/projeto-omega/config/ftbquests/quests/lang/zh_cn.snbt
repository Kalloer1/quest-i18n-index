	quest.1F0000000000002B.title: "神秘自动化"
	quest.1F0000000000002C.quest_desc: ["生产 64 个铁精，证明可再生生产已规模化运作。"]
	quest.1F0000000000002C.title: "按比例缩放的本质"
	quest.1F0000000000002D.quest_desc: ["你已经掌握了所有预设种子及其背后的自动化。你的工厂现在有了可再生的资源来源。"]
	quest.1F0000000000002D.title: "神秘农业大师"
	quest.4000000000000001.quest_desc: [
		"Create: Connected 扩展了工厂，加入了先进的传动、应力管理和红石组件。"
		"本章重点在于控制复杂的动力网络，防止过载并构建更精密的自动化系统。"
	]
	quest.4000000000000001.title: "控制工程 (Control Engineering)"
	quest.4000000000000002.quest_desc: [
		"一个齿轮箱，其四个水平的输出方向可以用扳手单独配置。"
		"当紧凑的交汇处需要精确控制每个连接竖井的旋转方向时使用。"
	]
	quest.4000000000000002.title: "黄铜齿轮箱"
	quest.4000000000000003.quest_desc: [
		"六个面都有轴连接的齿轮箱。"
		"顶部和底部的输出速度减半，混合垂直和水平传输时请注意比例。"
	]
	quest.4000000000000003.title: "六向齿轮箱"
	quest.4000000000000004.quest_desc: [
		"一种齿轮箱，可在特定转向时保持旋转方向，而直通连接则表现不同。"
		"当普通齿轮箱会导致不希望的反转时使用它。"
	]
	quest.4000000000000004.title: "平行齿轮箱"
	quest.4000000000000005.quest_desc: [
		"一个将两条独立旋转路径通过同一方块空间传递的动能中继器。"
		"在穿过竖井网络时，无需合并其运动，十分实用。"
	]
	quest.4000000000000005.title: "交叉连接器"
	quest.4000000000000006.quest_desc: [
		"带有一个额外齿轮连接的封闭式链传动组件。"
		"有助于沿紧凑线路传递旋转，同时保持相连的传动轴同步。"
	]
	quest.4000000000000006.title: "封闭式链条齿轮"
	quest.4000000000000007.quest_desc: [
		"仅在输入达到可配置的 RPM 阈值后才会接合的离合器。"
		"当速度足够时，用它来使工厂的部分自动投入运行。"
	]
	quest.4000000000000007.title: "离心离合器"
	quest.4000000000000008.quest_desc: [
		"仅在输入朝允许方向旋转时才啮合的离合器。"
		"它像一个单向机械连接，适用于反向旋转不能传播的系统。"
	]
	quest.4000000000000008.title: "自由轮离合器"
	quest.4000000000000009.quest_desc: [
		"一个反向红石行为的离合器：默认处于断开状态，通电时传递旋转。"
		"当控制逻辑更适合用有效信号表示时使用。"
	]
	quest.4000000000000009.title: "反向离合器"
	quest.400000000000000A.quest_desc: [
		"一个红石行为会反转常规传动逻辑的换挡器。"
		"它为你在自动化机械内部提供了另一种紧凑的旋转方向改变方式。"
	]
	quest.400000000000000A.title: "倒置齿轮换挡器"
	quest.400000000000000B.quest_desc: [
		"一种保护性耦合器，在网络过载时，经过可配置延迟后会断开连接。"
		"过载原因修复后，用扳手或红石脉冲重置它。"
	]
	quest.400000000000000B.title: "过度紧张离合器"
	quest.400000000000000C.quest_desc: [
		"一种一次性机械连接器，在网络过载时会断开。"
		"把它看作机械保险丝：在重要部件损坏前，先安全失效的廉价保护。"
	]
	quest.400000000000000C.title: "剪切销 Shear Pin"
	quest.400000000000000D.quest_desc: [
		"使用 Overstress Clutch 或 Shear Pin 建造一个保护系统。"
		"故意制造受控过载，确认保护机制能隔离问题，而非让整个网络瘫痪。"
	]
	quest.400000000000000D.title: "网络保护"
	quest.400000000000000E.quest_desc: [
		"一种在通电时故意施加巨大压力的装置，迫使连接的动能网络停止。"
		"在需要硬性机械制动时，将其用作紧急或工艺制动器。"
	]
	quest.400000000000000E.title: "刹车"
	quest.400000000000000F.quest_desc: [
		"储存压力容量以备后用。"
		"通过旋转充电，在另一个网络需要支持时放电。 §6思考：§r在将其集成到大型系统中之前，使用可视化来理解其存储和释放行为。"
	]
	quest.400000000000000F.title: "动能电池"
	quest.4000000000000010.quest_desc: [
		"将动能电池充至预定水平，然后按需将其放电到网络中。"
		"确认存储的动能容量能否在正常能源减少或中断时，为连接的机械提供动力。"
	]
	quest.4000000000000010.title: "为动能电池充电中"
	quest.4000000000000011.quest_desc: [
		"在两个原本独立的动能网络之间转移受控的压力容量。"
		"当系统需要共享可用电力，但又不能成为一个连续的竖井网络时使用。"
	]
	quest.4000000000000011.title: "动能桥梁"
	quest.4000000000000012.quest_desc: [
		"在两个独立的网络之间配置一座动能桥。"
		"验证在应力作用下桥梁的承载能力，同时网络之间保持机械隔离。"
	]
	quest.4000000000000012.title: "连接两个网络"
	quest.4000000000000013.quest_desc: [
		"Create: Connected 中用于高级红石装置的电子风格组件。"
		"它是本章后续可编程脉冲和无线控制设备的通用构建模块。"
	]
	quest.4000000000000013.title: "控制芯片"
	quest.4000000000000014.quest_desc: [
		"根据编程指令序列输出红石信号。"
		"当机器需要定时步骤而非单一恒定信号时使用。"
	]
	quest.4000000000000014.title: "序列脉冲发生器"
	quest.4000000000000015.quest_desc: [
		"编写一个有用的脉冲序列，用它来控制机器或生产步骤。"
		"在依赖电路自动运行前，请确认指令按预期顺序和时间执行。"
	]
	quest.4000000000000015.title: "自动化序列化工坊"
	quest.4000000000000016.quest_desc: [
		"在兼容的端点之间无线发送红石信号。"
		"通过放置在不同槽位中的物品来配置其频率，这样只有匹配的设备才会响应。"
	]
	quest.4000000000000016.title: "连锁发射器"
	quest.4000000000000017.quest_desc: [
		"使用匹配的 Linked Transmitter 配置将两个设备连接起来。"
		"确认源处的红石信号能直接到达远程端，无需实体红石线路。"
	]
	quest.4000000000000017.title: "无线红石电路"
	quest.4000000000000018.quest_desc: [
		"一种空白催化剂，可用于特定的 Encased Fan 批量处理模式。"
		"它是紧凑型专用风扇处理站的基础物品。"
	]
	quest.4000000000000018.title: "空白的风扇催化剂"
	quest.4000000000000019.quest_desc: [
		"用于批量清洗的专用催化剂。"
		"与 Encased Fan 配合使用，可创建一个紧凑的清洗站，无需每次都重建周围环境。"
	]
	quest.4000000000000019.title: "风扇溅射催化剂"
	quest.400000000000001A.quest_desc: [
		"一个用于批量熏制的催化剂。"
		"它为通常需要风扇吹过相应热源才能完成的配方提供了一种紧凑的替代方案。"
	]
	quest.400000000000001A.title: "风扇催化燃烧器"
	quest.400000000000001B.quest_desc: [
		"用于批量爆破的专用催化剂。"
		"当您需要保持风扇处理装置紧凑时，请使用它来处理矿石和其他可爆破材料。"
	]
	quest.400000000000001B.title: "风扇爆破催化剂"
	quest.400000000000001C.quest_desc: [
		"一个用于批量附魔的催化剂。"
		"它为自动化生产线提供了可重复使用的专用组件，用于灵魂火风格的加工。"
	]
	quest.400000000000001C.title: "Fan Haunting Catalyst"
	quest.400000000000001D.quest_desc: [
		"将物品栏的访问权限扩展到一个更方便的位置。"
		"它不会增加存储空间；相反，相连的组件可以像访问原始物品栏一样与端口交互。"
	]
	quest.400000000000001D.title: "物品栏访问端口"
	quest.400000000000001E.quest_desc: [
		"通过一个界面提供对两个库存的受控访问。"
		"使用过滤器来决定哪些物品与哪一侧互动，并保持紧凑的物流系统清晰易读。"
	]
	quest.400000000000001E.title: "物品栏桥梁"
	quest.400000000000001F.quest_desc: [
		"用物品栏桥连接两个物品栏，并配置有用的过滤器。"
		"确认物品被定向到指定的物品栏，而不是仅仅移动到有空格的地方。"
	]
	quest.400000000000001F.title: "物品物流系统 Inventory Logistics"
	quest.4000000000000020.quest_desc: [
		"一种可以模仿另一个完整方块外观的装饰性方块。"
		"应用具有常规交互的材质，以匹配周围建筑，同时不改变其背后的功能性结构。"
	]
	quest.4000000000000020.title: "Copycat 方块（可选）"
	quest.4000000000000021.quest_desc: [
		"一种复制了其他方块外观的装饰性石板。"
		"灵活的放置方式，包括在支持的情况下垂直使用，使其适用于工业装饰和紧凑的细节处理。"
	]
	quest.4000000000000021.title: "复制者石板 (可选)"
	quest.4000000000000022.quest_desc: [
		"一种复制其他材质外观的装饰性横梁。"
		"可用于机器周围的框架、支撑和视觉修饰，而不会给进度系统增加额外的功能性依赖。"
	]
	quest.4000000000000022.title: "Copycat Beam (可选)"
	quest.4000000000000023.quest_desc: [
		"你已掌握高级传输、过载保护、动能存储、可编程红石和物品物流。"
		"你的工厂现在像一个受控的自动化系统，而不是一堆独立的机器。"
	]
	quest.4000000000000023.title: "连锁精通 (Connected Mastery)"
	quest.6C20000000000001.quest_desc: ["Apotheosis 既未被移除，也未失去方向。通过附魔、镶嵌、拆解、重铸和增强来取得进展，最终与附魔工厂汇合。"]
	quest.6C20000000000001.title: "神秘锻造炉"
	quest.6C20000000000002.quest_desc: ["使用宝石切割台来升级宝石，了解宝石粉尘和稀有度材料。"]
	quest.6C20000000000002.title: "宝石与切割"
	quest.6C20000000000003.quest_desc: ["不再需要的装备可分解为材料。拆解能终结掉落物循环，而非将其变为垃圾。"]
	quest.6C20000000000003.title: "回收物资"
	quest.6C20000000000004.quest_desc: ["从简易重铸台开始，学习控制属性进阶。"]
	quest.6C20000000000004.title: "第一次重铸"
	quest.6C20000000000005.quest_desc: ["重铸台扩展了稀有度和前缀控制。包上限依然有效：高威力，而非财富XXVI。"]
	quest.6C20000000000005.title: "高级重铸（Advanced Reforging）"
	quest.6C20000000000006.quest_desc: ["使用增强台来单独处理各个词缀，将普通装备变为专用装备。"]
	quest.6C20000000000006.title: "正在增强中"
	quest.6C20000000000007.quest_desc: ["获得终局重铸材料，证明你已超越普通的前期战利品。"]
	quest.6C20000000000007.title: "神锻造珍珠"
	quest.6C20000000000008.quest_desc: ["在规定的限制内，精通燃料增强，并准备好神话级装备。"]
	quest.6C20000000000008.title: "强化符文 Sigil of Enhancement"
	quest.6C20000000000009.quest_desc: ["将 Apotheosis 与 Create Enchantment Industry 结合。经验、重铸、增强和附魔印刷将直接为 Omega Arcane Core 提供能量。"]
	quest.6C20000000000009.title: "神秘能量汇聚"
	quest.6C2000000000000A.quest_desc: ["重铸前，先了解 Apotheosis 的掉落：附加属性和稀有度决定了装备可携带的额外属性。这些信息仅用于说明，因为附加属性的生物仍是正常的实体类型，而非 FTB 任务可以安全追踪的独立 ID。"]
	quest.6C2000000000000A.title: "前缀与稀有度"
	quest.6C2000000000000B.quest_desc: ["将 Apotheosis 附魔进阶系统与 Create Enchantment Industry 连接。Eterna、Quanta 和 Arcana 管理附魔潜力，而经验和印刷工厂则保留在工业路线中。"]
	quest.6C2000000000000B.title: "Apothic Enchanting"
	quest.6C2000000000000C.quest_desc: ["在整合包的保护罩内合成宝石、重铸、附魔和高级附魔。财富VIII、锋利IX和防护VIII代表终局强度；超过这些上限的夸张数值不属于正常进度。"]
	quest.6C2000000000000C.title: "神话装备"
	quest.6C2000000000000D.quest_desc: ["为泰坦时代做好准备，直面强化的敌人和装备。目标是掌握 Apotheosis 的机制，而不是把每个敌人都变成巨大的血包。"]
	quest.6C2000000000000D.title: "Apothic Bosses"
	quest.6D20000000000001.quest_desc: ["工业时代开启了终局。从这里，工厂离开工作室：直面来自Minecraft、Twilight Forest、Mowzie's Mobs、Bosses of Mass Destruction和Cataclysm的主要首领。", "Boss 的生命值会随 Omega 缩放，原有战斗机制保持不变。Cataclysm 仍位于战役顶部，而新的探索路线则成为真正的进度要求。"]
	quest.6D20000000000001.title: "泰坦的时代"
	quest.6D20000000000002.quest_desc: ["击败末影龙。末影龙蛋将变为 Omega Star 配方所需的工业遗迹。"]
	quest.6D20000000000002.title: "末影龙"
	quest.6D20000000000003.quest_desc: ["下界之星仍然是核心的终局材料。在返回工厂前，通过战斗来获取它。"]
	quest.6D20000000000003.title: "凋零者"
	quest.6D20000000000004.quest_desc: ["直面守卫者，将深暗科技带入最终纪元。回响碎片也将进入欧米茄之星。"]
	quest.6D20000000000004.title: "The Warden"
	quest.6D20000000000005.quest_desc: ["第一位的灾变泰坦。末地守卫开启了欧米茄级首领阶梯，其守护手套也成为了泰坦矩阵使用的遗物之一。"]
	quest.6D20000000000005.title: "末地守卫"
	quest.6D20000000000006.quest_desc: ["下界合金巨兽开启了下界路线。它的巨兽之角不再只是孤立的奖杯，而是成为了 Omega 工业的燃料。"]
	quest.6D20000000000006.title: "下界合金怪物"
	quest.6D20000000000007.quest_desc: ["收集8瓶龙之息。这种龙之精华将作为核心材料返回工厂，用于制造龙之矩阵。"]
	quest.6D20000000000007.title: "龙之证明 (Draconic Proof)"
	quest.6D20000000000008.quest_desc: ["远古遗迹代表沙漠路线。战胜后，收集远古金属以工业合成泰坦遗物。"]
	quest.6D20000000000008.title: "远古遗迹"
	quest.6D20000000000009.quest_desc: ["Scylla 结束了这个时代的主要 Cataclysm 升级。它瞄准约 50,000 的生命值，其 Essence of the Storm 会直接进入 Titan Matrix。"]
	quest.6D20000000000009.title: "斯库拉"
	quest.6D2000000000000A.quest_desc: ["你掌握了重生链，从每个泰坦中回收了遗迹，并将战斗转化为工业生产。泰坦矩阵和龙裔矩阵现在直接为欧米茄之星供能。"]
	quest.6D2000000000000A.title: "泰坦的掌控 (Mastery of the Titans)"
	quest.6D2000000000000B.quest_desc: ["将龙之息、引火石、诅咒石和工业机制带到5×5机械合成台。龙之矩阵将探索和战斗变为Omega Star的强制性工业组件。"]
	quest.6D2000000000000B.title: "龙之精炼（Draconic Refining）"
	quest.6D2000000000000C.quest_desc: ["泰坦矩阵的 7×7 配方核心现在需要征服矩阵。这直接将暮色森林、毁灭领主和 Mowzie's Mobs 与八件大灾变遗物联系起来。", "击杀本身还不够：首领奖杯和奖励会返回工厂，被中间矩阵消耗掉。"]
	quest.6D2000000000000C.title: "泰坦矩阵"
	quest.6D2000000000000D.quest_desc: ["机械大灾变路线升级。Harbinger有特殊攻击和再生能力，并提供工业遗迹合成所需的Witherite路线。"]
	quest.6D2000000000000D.title: "先遣者 (The Harbinger)"
	quest.6D2000000000000E.quest_desc: ["Ignis 是第二分支的火焰试炼。它具有生命窃取和自身阶段；其 Ignitium 锭现在也参与 Omega 链。"]
	quest.6D2000000000000E.title: "Ignis"
	quest.6D2000000000000F.quest_desc: ["将泰坦时代带入深海。利维坦使用百分比伤害，其潮汐之爪成为泰坦矩阵的必备遗物。"]
	quest.6D2000000000000F.title: "利维坦（The Leviathan）"
	quest.6D20000000000010.quest_desc: ["两个Cataclysm分支在此交汇。Maledictus要求掌握机动性和生存能力；Cursium则成为最终泰坦精炼的一部分。"]
	quest.6D20000000000010.title: "Maledictus"
	quest.6D20000000000011.quest_desc: [
		"我们不会为Cataclysm能复活的Boss制作人工生成蛋。当选项启用时，Ender Guardian、Netherite Monstrosity、Harbinger、Ancient Remnant和Scylla会留下Boss重生器。"
		"将对应的眼睛带到重生器：虚空之眼、怪物之眼、机械之眼、沙漠之眼或风暴之眼。这样既能让 boss 材料再生，又不会改变模组本身的特性。"
	]
	quest.6D20000000000011.title: "Respawn 协议"
	quest.6D20000000000012.quest_desc: [
		"在矩阵之前，证明你对整个灾变战役的掌握。收集守护者手套、怪物之角、凋零石、燃素、潮汐之爪、远古金属、诅咒石和风暴精华。"
		"这些材料并不会结束冒险：它们会被组成泰坦矩阵的 7×7 Create 工业生产线所消耗。"
	]
	quest.6D20000000000012.title: "泰坦的遗迹 Relics of the Titans"
	quest.7101000000000001.quest_desc: [
		"Create 已经包含了一个完整的铁路系统。"
		"现在你将学习建造火车、规划路线，以及在工厂之间运输物品和流体。"
		"本章将把你的装置变成一个长途物流网络。"
	]
	quest.7101000000000001.title: "铁路的时代"
	quest.7101000000000002.quest_desc: [
		"用于建造铁路组件的结构外壳。"
		"它是轨道、车站和列车设备的基石。"
	]
	quest.7101000000000002.title: "铁路外壳"
	quest.7101000000000003.quest_desc: [
		"火车在铁路上移动时使用的轨道。"
		"先从一个简短的路段开始，测试你的第一辆机车。"
	]
	quest.7101000000000003.title: "铁路轨道"
	quest.7101000000000004.quest_desc: [
		"火车的出发点和到达点。"
		"这里也是组装和拆卸火车编组的地点。"
		"§6思考：§r使用可视化功能，看看车站如何与铁路融合。"
	]
	quest.7101000000000004.title: "火车站"
	quest.7101000000000005.quest_desc: [
		"一种可以手动控制火车头的物品。"
		"将其放置在座位上或合适的结构上以驾驶火车。"
	]
	quest.7101000000000005.title: "火车控制系统"
	quest.7101000000000006.quest_desc: [
		"定义了火车自动运行的目的地和条件。"
		"这对可重复的路线和自动化物流至关重要。"
	]
	quest.7101000000000006.title: "列车时刻表"
	quest.7101000000000007.quest_desc: [
		"将铁路划分为多个路段并组织交通。"
		"使用信号来防止碰撞和控制优先级。"
	]
	quest.7101000000000007.title: "轨道信号机"
	quest.7101000000000008.quest_desc: [
		"可检测通过的火车并发出红石信号。"
		"适用于由到达的列车编组触发的自动化操作。"
	]
	quest.7101000000000008.title: "轨道观察者 (Track Observer)"
	quest.7101000000000009.quest_desc: [
		"建造一辆小型机车，让它沿着你的轨道行驶。"
		"§6思考：§r使用可视化来构想正确的组装方式。"
		"这是所有铁路运输的基础设施。"
	]
	quest.7101000000000009.title: "你的第一台机车"
	quest.710100000000000A.quest_desc: [
		"安装一个物品仓库来运输大量物品。"
		"你的火车现在有了观光之外的新用途。"
	]
	quest.710100000000000A.title: "货运车厢"
	quest.710100000000000B.quest_desc: [
		"安装流体储罐，用于运输原油或柴油等液体。"
		"这能直接连接到你的工业基础设施。"
	]
	quest.710100000000000B.title: "流体储罐车"
	quest.710100000000000C.quest_desc: [
		"将物品装上火车，在两点之间运输，然后卸载它们。"
		"确认物流系统无需人工干预即可正常运行。"
	]
	quest.710100000000000C.title: "物品运输"
	quest.710100000000000D.quest_desc: [
		"用你的火车在储罐之间运输液体。"
		"将路线与泵站结合，实现流体流动的自动化。"
	]
	quest.710100000000000D.title: "流体运输系统"
	quest.710100000000000E.quest_desc: [
		"配置铁路信号，证明你的线路组织井然有序。"
		"拥有多列火车的网络需要交通控制。"
	]
	quest.710100000000000E.title: "功能性信号系统"
	quest.710100000000000F.quest_desc: [
		"编写一个程序，让火车在车站之间自动运行。"
		"使用时间表和站点来创建自动化物流系统。"
	]
	quest.710100000000000F.title: "自动路线 (Automatic Routes)"
	quest.7101000000000010.quest_desc: [
		"你已建造了一条完整的铁路：轨道、车站、机车、货运车厢、信号系统和自动路线。"
		"你的工厂现在可以通过远程物流网络进行连接。"
	]
	quest.7101000000000010.title: "工业铁路网络"
	quest.7102000000000001.quest_desc: [
		"Enchantment Industry 将经验和附魔转化为工业流程。"
		"将经验值液化、储存，并用于自动化附魔的机器。目标是将手动操作转变为可重复的生产线。"
	]
	quest.7102000000000001.title: "欢迎来到附魔工业 Enchantment Industry"
	quest.7102000000000002.quest_desc: [
		"直接从玩家身上存储经验值。"
		"在将经验引导至系统其余部分之前，先将其用作受控的液体经验缓冲器。"
	]
	quest.7102000000000002.title: "经验孵化箱"
	quest.7102000000000003.quest_desc: [
		"处理含有经验的物品，并将其经验值转化为液态XP。"
		"使用 Create 的 Item Drain，让当前系统能收集并引导产生的流体流经工厂。"
	]
	quest.7102000000000003.title: "机械砂轮 (Mechanical Grindstone)"
	quest.7102000000000004.quest_desc: [
		"当前的设置使用 Create 的 Item Drain 来进行液体收集和输送。"
		"将其与机械砂轮结合，并将输出连接到你的流体网络中。"
	]
	quest.7102000000000004.title: "物品抽取 — XP收集器"
	quest.7102000000000005.quest_desc: [
		"组装完整的砂轮装置，将携带经验的物品转化为液态经验值。"
		"在继续之前，请确认流体已被生成并且可以收集。"
	]
	quest.7102000000000005.title: "液化经验值"
	quest.7102000000000006.quest_desc: [
		"便携式液体经验值桶。"
		"在永久流体网络仍在建造期间，用它来手动移动经验值。"
	]
	quest.7102000000000006.title: "经验值桶 (Experience Bucket)"
	quest.7102000000000007.quest_desc: [
		"收集附近玩家和XP球体中的经验值并储存起来。"
		"外观会反映存储量，是附魔行中实用的可视化缓冲器。"
	]
	quest.7102000000000007.title: "经验灯笼"
	quest.7102000000000008.quest_desc: [
		"在经验灯笼周围建造一个实用的经验存储装置。"
		"在连接更复杂的机器前，请确保能稳定地存入、持有和取出经验值。"
	]
	quest.7102000000000008.title: "经验值存储装置"
	quest.7102000000000009.quest_desc: [
		"由液态经验驱动的工业附魔台。"
		"§6思考：§r在围绕它构建自动化之前，先利用可视化了解其层级和工作模式是如何配置的。"
	]
	quest.7102000000000009.title: "烈焰人附魔师"
	quest.710200000000000A.quest_desc: [
		"记录附魔信息以便在装备上重复使用。"
		"它将成为锻造和自动化附魔流程的参考物品。"
	]
	quest.710200000000000A.title: "附魔模板 Enchanting Template"
	quest.710200000000000B.quest_desc: [
		"使用烈焰附魔台自动为物品附魔。"
		"确认液体经验被消耗，并且输出获得了预期的附魔。"
	]
	quest.710200000000000B.title: "首个工业附魔物品"
	quest.710200000000000C.quest_desc: [
		"一种用于施加、提取和组合附魔的高级机器。"
		"它像一个工业砧，但没有常规修理成本的负担。 §6思考：§r使用可视化来理解每种工作模式。"
	]
	quest.710200000000000C.title: "烈焰锻造台"
	quest.710200000000000D.quest_desc: [
		"使用烈焰锻造台将已存储的模板应用到物品上。"
		"也试试提取模式，这样你就能明白附魔是如何在生产线上移动的。"
	]
	quest.710200000000000D.title: "附魔锻造台"
	quest.7102000000000011.quest_desc: [
		"复制附魔书、列车时刻表，重命名物品，并支持其他多种打印任务。"
		"§bJEI:§r 使用配方查看器，查看整合包已安装版本中可用的具体打印配方。"
	]
	quest.7102000000000011.title: "打印机"
	quest.7102000000000012.quest_desc: [
		"配置打印机，并制作一本附魔书或其他支持物品的有效副本。"
		"确认机器接收到所需的流体并正确完成操作。"
	]
	quest.7102000000000012.title: "工业印刷机"
	quest.7102000000000013.quest_desc: [
		"用于为烈焰人开启超级附魔模式的特殊物品。"
		"无法通过普通管道插入，因此请手动或使用机械臂进行供给。"
	]
	quest.7102000000000013.title: "附魔蛋糕"
	quest.7102000000000014.quest_desc: [
		"用于高级附魔操作的模板。"
		"当所需配置可用时，它能让系统在原版附魔的常规限制之外运行。"
	]
	quest.7102000000000014.title: "超级附魔模板"
	quest.7102000000000015.quest_desc: [
		"将烈焰人附魔师或烈焰人锻造师置于超级模式并完成高级操作。"
		"过程中可能会发生闪电，因此请安全设计区域，并考虑使用避雷针。"
	]
	quest.7102000000000015.title: "超级附魔（Super Enchanting）"
	quest.7102000000000016.quest_desc: [
		"你已经将经验和附魔都工业化了。"
		"工厂现在可以大规模地生产、存储和应用附魔，而无需手动处理每件物品。"
	]
	quest.7102000000000016.title: "附魔工厂"
	quest.7103000000000001.quest_desc: [
		"Create Big Cannons 将铸造和火炮引入了工业时代。"
		"你将熔炼金属、钻孔炮管、组装强大武器。从熔炼到开火，每个阶段都是生产链的一环。"
	]
	quest.7103000000000001.title: "火炮时代"
	quest.7103000000000002.quest_desc: [
		"将盆地变为炮台合金铸造流程的一部分。"
		"提供所需的温度，并在 JEI 中查看此整合包中可用的确切合金配方。"
	]
	quest.7103000000000002.title: "Basin Foundry Lid"
	quest.7103000000000003.quest_desc: [
		"用于制作大炮模具的基本材料。"
		"在钻孔和组装之前，必须先对铸造部件进行塑形。"
	]
	quest.7103000000000003.title: "铸造沙子"
	quest.7103000000000004.quest_desc: [
		"通过铸造工艺生产的用于制造基础大炮的合金。"
		"支持早期火炮组件，并引入了大型火炮的材料进阶系统。"
	]
	quest.7103000000000004.title: "铸铁锭"
	quest.7103000000000005.quest_desc: [
		"用于多种火炮部件的铜锡合金，比普通铸铁更坚固。"
		"开启了中级材料等级和自动炮分支。"
	]
	quest.7103000000000005.title: "青铜锭"
	quest.7103000000000006.quest_desc: [
		"一种更坚固的铁基合金，用于制造高性能的炮管组件。"
		"保持一定的储备，因为后面的桶和炮闩需要更坚固的材料。"
	]
	quest.7103000000000006.title: "钢锭"
	quest.7103000000000007.quest_desc: [
		"一种源自下界的超耐用合金，用于制造最坚固的炮台部件。"
		"此材料标志着本章结构进阶的最高水平。"
	]
	quest.7103000000000007.title: "下界钢锭"
	quest.7103000000000008.quest_desc: [
		"用于铸造小型火炮组件的模具。"
		"用铸造沙准备，并使用熔炉系统将熔融金属塑造成所需形状。"
	]
	quest.7103000000000008.title: "小型火炮模具"
	quest.7103000000000009.quest_desc: [
		"适用于中型火炮组件的模具。"
		"当下一部分太大而无法放入小模具时使用；JEI会显示哪些铸模属于哪种尺寸。"
	]
	quest.7103000000000009.title: "中型火炮模具"
	quest.710300000000000A.quest_desc: [
		"大型火炮组件的模具。"
		"它将相同的铸造过程扩展到更重的桶、腔室及相关部件。"
	]
	quest.710300000000000A.title: "大型火炮模具"
	quest.710300000000000B.quest_desc: [
		"用于制造最大火炮组件的进阶模具。"
		"它属于晚期铸造台，专为要求最高的火炮而设计。"
	]
	quest.710300000000000B.title: "超大型火炮模具"
	quest.710300000000000C.quest_desc: [
		"一个接收熔融金属并形成火炮组件的铸造结构。"
		"选择合适的模具，填充铸型，等材料凝固后再进行机械加工。"
	]
	quest.710300000000000C.title: "铸造大炮"
	quest.710300000000000D.quest_desc: [
		"金属完全凝固后进行铸造的炮管。"
		"塑形部件现已准备好，可被钻孔制成可用的火炮组件。"
	]
	quest.710300000000000D.title: "大炮铸造已完成"
	quest.710300000000000E.quest_desc: [
		"钻孔机完成铸造，以制造功能性火炮炮管和关联部件。"
		"需要动能和特定的冷却或工艺条件；具体配置请使用 Ponder 和 JEI 查看。"
	]
	quest.710300000000000E.title: "Cannon Drill"
	quest.710300000000000F.quest_desc: [
		"由大炮钻头使用的切割组件。"
		"在开始长时间加工前，请确保钻孔设置和速度符合配方要求。"
	]
	quest.710300000000000F.title: "大炮钻头"
	quest.7103000000000010.quest_desc: [
		"由铸铁制成的基础桶身部分。"
		"在学习炮管各部分如何连接以及材料强度如何影响建造时，使用它进行早期的火炮组装。"
	]
	quest.7103000000000010.title: "铸铁大炮管"
	quest.7103000000000011.quest_desc: [
		"一个存放推进剂装药的舱室部分。"
		"将其连接到兼容的桶状部件上，这样大炮就能有一个用于发射压力的加固区域。"
	]
	quest.7103000000000011.title: "铸铁大炮炮膛"
	quest.7103000000000012.quest_desc: [
		"铸铁大炮的后部闭合组件。"
		"在没有专用后装装置时，可完成简易桶组件的后半部分。"
	]
	quest.7103000000000012.title: "铸铁大炮的末地传送门"
	quest.7103000000000013.quest_desc: [
		"允许从后方装填大炮。"
		"这让重新加载更方便，但其机械设计牺牲了部分结构强度以换取速度和便利性。"
	]
	quest.7103000000000013.title: "铸铁滑动式后膛"
	quest.7103000000000014.quest_desc: [
		"比普通铁桶更坚固的钢桶部件。"
		"当设计需要承受更大的推进剂负荷和更严苛的弹药要求时使用。"
	]
	quest.7103000000000014.title: "钢铁大炮炮管"
	quest.7103000000000015.quest_desc: [
		"一种坚固的螺旋式后膛，没有滑动式设计那样的强度惩罚。"
		"在加载循环中提供旋转指令以打开和关闭它。"
	]
	quest.7103000000000015.title: "钢制螺丝弹仓"
	quest.7103000000000016.quest_desc: [
		"用于大口径火炮的超强炮管部件。"
		"它属于晚期材料层级，支持最重型的火炮设计。"
	]
	quest.7103000000000016.title: "下界钢制炮管"
	quest.7103000000000017.quest_desc: [
		"专为最重型火炮组件设计的超高强度炮闩。"
		"当最大耐久度重要时，与兼容的 Nethersteel 部分结合使用。"
	]
	quest.7103000000000017.title: "下界钢螺丝式弹仓"
	quest.7103000000000018.quest_desc: [
		"一种用于组装、瞄准和操作大型火炮的动力坐骑。"
		"整合红石和动能控制，使武器能够可靠地定位和开火。"
	]
	quest.7103000000000018.title: "大炮底座"
	quest.7103000000000019.quest_desc: [
		"扩展了大炮架的控制界面。"
		"当建造需要红石、旋转或自动化接口等额外可接触面时使用。"
	]
	quest.7103000000000019.title: "大炮底座扩展组件"
	quest.710300000000001A.quest_desc: [
		"无需动力瞄准的炮台的更简单的固定安装选项。"
		"适用于发射方向已预先确定且手动调整就足够的安装场景。"
	]
	quest.710300000000001A.title: "固定式火炮支架"
	quest.710300000000001B.quest_desc: [
		"一种用于大炮的移动式安装平台。"
		"它比固定装置更容易重新定位，但自动化程度不如动力炮台。"
	]
	quest.710300000000001B.title: "大炮马车"
	quest.710300000000001C.quest_desc: [
		"大型火炮的标准推进剂装药。"
		"请使用正确数量的大炮材料和弹药；过量装填可能很危险。"
	]
	quest.710300000000001C.title: "粉末装填物"
	quest.710300000000001D.quest_desc: [
		"专为直接撞击而设计的高穿透性投射物。"
		"它不使用引信，因此在不需要爆炸效果时，是一个直接的选择。"
	]
	quest.710300000000001D.title: "实心射击"
	quest.710300000000001E.quest_desc: [
		"一种高爆炸性的炮弹。"
		"搭配兼容的引信，让投射物在你选择的条件下引爆。"
	]
	quest.710300000000001E.title: "HE 弹壳"
	quest.710300000000001F.quest_desc: [
		"一种可穿透方块后再爆炸的穿甲弹头。"
		"当受保护或加固的目标使表面爆炸效果不佳时使用。"
	]
	quest.710300000000001F.title: "AP 外壳"
	quest.7103000000000020.quest_desc: [
		"包含能对软目标和轻型结构造成大范围伤害的碎片。"
		"当大范围冲击比深度穿透更重要时，它很有用。"
	]
	quest.7103000000000020.title: "破片弹壳"
	quest.7103000000000021.quest_desc: [
		"一种紧凑可重复使用的推进剂弹匣。"
		"简化了加载过程，适合需要更快、更标准化的弹药流程时使用。"
	]
	quest.7103000000000021.title: "大型弹药包"
	quest.7103000000000022.quest_desc: [
		"击中目标时会触发一个兼容的弹壳。"
		"浅角度撞击可能不可靠，因此选择射击方案时要考虑引信的行为。"
	]
	quest.7103000000000022.title: "冲击引信"
	quest.7103000000000023.quest_desc: [
		"在设定的延迟后引爆兼容的炮弹。"
		"适用于空爆式射击，或在需要已知飞行时间后发生爆炸时使用。"
	]
	quest.7103000000000023.title: "定时引信 (Timed Fuze)"
	quest.7103000000000024.quest_desc: [
		"当投射物接近有效目标或满足方块条件时引爆。"
		"它对移动目标或难以直接命中的射击很有用。"
	]
	quest.7103000000000024.title: "近程引信 Proximity Fuze"
	quest.7103000000000025.quest_desc: [
		"自动火炮的青铜桶组件。"
		"这开启了射速更快的自动炮分支，其弹药流程与大炮不同。"
	]
	quest.7103000000000025.title: "青铜自动炮管"
	quest.7103000000000026.quest_desc: [
		"接收自动炮弹药并处理废弃弹壳的弹仓部分。"
		"将其与合适的弹箱和弹药系统结合，以建造一台能正常工作的自动炮。"
	]
	quest.7103000000000026.title: "青铜自动炮炮闩"
	quest.7103000000000027.quest_desc: [
		"可储存自动炮弹药，并能自动将其送入武器。"
		"通过接口配置容器，或使用设计支持的情况下使用部署器。"
	]
	quest.7103000000000027.title: "自动炮弹药容器"
	quest.7103000000000028.quest_desc: [
		"自动炮使用的基本弹药外壳。"
		"可以使用不同的投射物来准备，请在JEI中查看已安装版本中可用的弹药选项。"
	]
	quest.7103000000000028.title: "自动加农炮炮弹"
	quest.7103000000000029.quest_desc: [
		"自动加载和卸载大型大炮。"
		"它像一个特殊的伸缩装置，搭配合适的头部即可推进或抽出弹药。"
	]
	quest.7103000000000029.title: "大炮装载机"
	quest.710300000000002A.quest_desc: [
		"大炮装载机用来将弹药推入大炮的装填头。"
		"建造足够的空间，以便装载机能够完全通过整个装载路径。"
	]
	quest.710300000000002A.title: "羊驼头（Ram Head）"
	quest.710300000000002B.quest_desc: [
		"大炮装载机用来将弹药拉回的外壳。"
		"用于卸载、清空腔室或撤销需要反向的加载序列。"
	]
	quest.710300000000002B.title: "蠕虫头颅"
	quest.710300000000002C.quest_desc: [
		"组装一个带有兼容的炮管、弹膛或炮闩部分的完整火炮，并将其放置在合适的支架上。"
		"装入推进剂和弹头，安全瞄准并完成一次受控的测试射击。"
	]
	quest.710300000000002C.title: "第一门功能性火炮"
	quest.710300000000002D.quest_desc: [
		"配置一个炮台装载机，以便弹药可以无需手动操作地装卸。"
		"根据需要放置 Ram 和 Worm Heads，并确保在装置暴露时加载序列无法启动。"
	]
	quest.710300000000002D.title: "自动化火炮系统"
	quest.710300000000002E.quest_desc: [
		"你已经建造了高口径火炮、专用弹药和自动化装填流程。"
		"你的工厂现在可以制造和操作工业火炮，而不再将每种武器视为一次性制作。"
	]
	quest.710300000000002E.title: "弹道工程学 (Ballistic Engineering)"
	quest.7104000000000001.quest_desc: [
		"你的工厂已经掌握了机械运动和电力技术。"
		"现在你将学习如何生产液体燃料，并通过引擎将其转化为旋转动力。"
		"本章将教你如何建立一个完整的燃料工业：生产、开采、精炼和消耗。"
	]
	quest.7104000000000001.title: "燃料时代"
	quest.7104000000000002.quest_desc: [
		"一台用于处理大量有机物的机器。"
		"它是生产乙醇和其他发酵产品的基础。"
	]
	quest.7104000000000002.title: "批量发酵器"
	quest.7104000000000003.quest_desc: [
		"将盆地变成一个流体处理站。"
		"用它来生产植物油和其他液体产品。"
	]
	quest.7104000000000003.title: "Basin Lid"
	quest.7104000000000004.quest_desc: [
		"建造你的第一个发酵系统，并生产一种有用的材料。"
		"确认机器使用正确的材料进行运作。"
	]
	quest.7104000000000004.title: "功能性发酵（Functional Fermentation）"
	quest.7104000000000005.quest_desc: [
		"一种通过发酵产生的可再生燃料。"
		"可以为柴油发动机提供动力，并用作生物柴油的原料。"
	]
	quest.7104000000000005.title: "乙醇"
	quest.7104000000000006.quest_desc: [
		"从植物中提取的油，提供了另一种可再生燃料途径。"
		"与乙醇结合，可以转化为生物柴油。"
	]
	quest.7104000000000006.title: "植物油"
	quest.7104000000000007.quest_desc: [
		"一种由植物油和乙醇制成的先进可再生燃料。"
		"这代表着本章农业燃料路线的顶峰。"
	]
	quest.7104000000000007.title: "生物柴油"
	quest.7104000000000008.quest_desc: [
		"组装柴油发动机所必需的机械组件。"
		"没有它，引擎就无法将燃烧转化为动力。"
	]
	quest.7104000000000008.title: "引擎活塞"
	quest.7104000000000009.quest_desc: [
		"一种通过燃烧液体燃料来产生转动的紧凑型引擎。"
		"§6思考：§r使用可视化来了解其组装和供应方式。"
	]
	quest.7104000000000009.title: "柴油发动机"
	quest.710400000000000A.quest_desc: [
		"用乙醇或其他可用燃料为柴油发动机加油。"
		"确认它能产生旋转并为 Create 机器提供动力。"
	]
	quest.710400000000000A.title: "首次点燃"
	quest.710400000000000B.quest_desc: [
		"用于定位地下原油矿床的工具。"
		"右键单击以查看区块中有多少石油。"
	]
	quest.710400000000000B.title: "石油扫描仪"
	quest.710400000000000C.quest_desc: [
		"抽油机结构的一个中心部分。"
		"它用作泵送运动的铰链装置。"
		"此物品是当前进阶步骤的中间环节，用于准备后续组件或机器。 §bJEI:§r批量合成前请在此存档中查看确切配方。"
	]
	quest.710400000000000C.title: "Pumpjack 轴承"
	quest.710400000000000D.quest_desc: [
		"将Create的旋转运动转换为Pumpjack的往复运动。"
		"此物品是当前进阶步骤的中间环节，用于准备后续组件或机器。 §bJEI:§r批量合成前请在此存档中查看确切配方。"
	]
	quest.710400000000000D.title: "Pumpjack Crank"
	quest.710400000000000E.quest_desc: [
		"负责抽吸动作的抽油机上部组件。"
		"此物品是当前进阶步骤的中间环节，用于准备后续组件或机器。 §bJEI:§r批量合成前请在此存档中查看确切配方。"
	]
	quest.710400000000000E.title: "Pumpjack 头颅"
	quest.710400000000000F.quest_desc: [
		"将垂直管道连接到基岩，以便提取石油。"
		"此物品是当前进阶步骤的中间环节，用于准备后续组件或机器。 §bJEI:§r批量合成前请在此存档中查看确切配方。"
	]
	quest.710400000000000F.title: "Pumpjack 水井"
	quest.7104000000000010.quest_desc: [
		"组装完整的抽油机结构，并将其向下延伸至基岩。"
		"§6思考：§r使用可视化来构想正确的建造方式。"
	]
	quest.7104000000000010.title: "你的第一口井"
	quest.7104000000000011.quest_desc: [
		"从地下开采的原始石油。"
		"在高级引擎能将其用作燃料之前，必须先进行精炼。"
	]
	quest.7104000000000011.title: "原油"
	quest.7104000000000012.quest_desc: [
		"应用于储罐以创建一个蒸馏塔。"
		"该结构必须至少有三格高才能运作。"
	]
	quest.7104000000000012.title: "蒸馏控制器"
	quest.7104000000000014.quest_desc: [
		"提供蒸馏所需的必要热量。"
		"可以为其提供易燃液体作为燃料。"
		"此物品是当前进阶步骤的中间环节，用于准备后续组件或机器。 §bJEI:§r批量合成前请在此存档中查看确切配方。"
	]
	quest.7104000000000014.title: "燃烧器"
	quest.7104000000000015.quest_desc: [
		"建造蒸馏塔，并供应加热的原油。"
		"确认系统开始分离石油产品。"
	]
	quest.7104000000000015.title: "蒸馏塔 Distillation Tower"
	quest.7104000000000016.quest_desc: [
		"一种从原油中提取的提炼燃料。"
		"它为柴油和模块化引擎提供动力。"
		"此物品是当前进阶步骤的中间环节，用于准备后续组件或机器。 §bJEI:§r批量合成前请在此存档中查看确切配方。"
	]
	quest.7104000000000016.title: "柴油发动机"
	quest.7104000000000017.quest_desc: [
		"另一种与柴油性质不同的精炼石油馏分。"
		"它是兼容引擎的一种替代燃料。"
	]
	quest.7104000000000017.title: "汽油"
	quest.7104000000000018.quest_desc: [
		"容器被拾起时，液体内容物不会流失。"
		"非常适合在机器之间转移燃料。"
	]
	quest.7104000000000018.title: "燃料罐"
	quest.7104000000000019.quest_desc: [
		"用于储存大量流体的工业储罐。"
		"可以水平或垂直放置。"
	]
	quest.7104000000000019.title: "油桶"
	quest.710400000000001A.quest_desc: [
		"也被称为模块化柴油发动机，它以更大的规模产生旋转。"
		"模块可以堆叠以增加压力承受能力。"
	]
	quest.710400000000001A.title: "模块化引擎"
	quest.710400000000001C.quest_desc: [
		"本章中最大的引擎，能够产生巨大的旋转动力。"
		"§6思考：§r使用可视化来了解其组装和燃料需求。"
	]
	quest.710400000000001C.title: "巨型柴油发动机"
	quest.710400000000001D.quest_desc: [
		"提取石油，提炼燃料，自动储存并为引擎供能。"
		"目标是在无需人工干预的情况下，保持整个系统持续运行。"
	]
	quest.710400000000001D.title: "自动化燃料链 (Automate the Fuel Chain)"
	quest.710400000000001E.quest_desc: [
		"你已经建立了一个完整的燃料工业：生产、开采、精炼和消耗。"
		"Create 将旋转转化为工业；Diesel Generators 将燃料转化为旋转。"
	]
	quest.710400000000001E.title: "燃料时代"
	quest.7B20000000000001.quest_desc: ["创造者的最终证明。工业机械、精密机械和黄铜现在都用于制造真正的终局产品。"]
	quest.7B20000000000001.title: "Omega Mechanical Core"
	quest.7B20000000000002.quest_desc: ["此核心现已证明先进的Mekanism基础设施：终极能量立方和终极通用电缆加入了工业电力和机制。"]
	quest.7B20000000000002.title: "欧米茄能量核心"
	quest.7B20000000000003.quest_desc: ["Project Omega 的大脑需要大规模 AE2：模式提供器、分子组装器、256k 合成存储、处理器和量子技术。"]
	quest.7B20000000000003.title: "Omega Logic Core"
	quest.7B20000000000004.quest_desc: ["此核心明确要求4个Insanium方块，外加龙蛋和下界之星种子。你的可再生资源产量必须已达到工业规模。"]
	quest.7B20000000000004.title: "Omega Nature Core"
	quest.7B20000000000005.quest_desc: ["将蜂场变为基础设施：高级蜂巢、离心机和生产升级可维持生物核心。"]
	quest.7B20000000000005.title: "欧米茄生物核心"
	quest.7B20000000000006.quest_desc: ["Apotheosis 与 Create Enchantment Industry 融合：重铸、增强、神造珍珠、液态经验值和附魔印刷构成了神秘核心。"]
	quest.7B20000000000006.title: "奥米茄神秘核心"
	quest.7B20000000000007.quest_desc: ["重型火炮、压力、工程学和外部电源在此核心交汇，代表着对 Create 的补充工业系统的精通。"]
	quest.7B20000000000007.title: "Omega Engineering Core"
	quest.7B20000000000008.quest_desc: ["移动结构、推进和传输接口构成了飞升所需的最后一个支柱。"]
	quest.7B20000000000008.title: "欧米茄推进核心"
	quest.7B20000000000009.quest_desc: ["Omega Star 是工业巅峰，而非解锁装备的钥匙。先锻造 Omega Arsenal，达到 Omega State 并主宰 Age of Titans；然后将此 9×9 合成表中的八个 Core、Matrix 和最终材料转换。"]
	quest.7B20000000000009.title: "Omega Star"
	quest.7B2000000000000A.quest_desc: ["欧米茄镐在欧米茄星锻造之前就已铸成。它在7×7的Create结构中融合了觉醒超贵金属、精炼黑曜石、原子分解器、MekaTool和Jackhammer。其力量是物品固有的。"]
	quest.7B2000000000000A.title: "欧米茄镐"
	quest.7B2000000000000B.quest_desc: ["Omega Blade 融合了包里最强的战斗路线：Awakened Supremium、Refined Obsidian、MekaTool 和 Cataclysm 武器。它是中后期的征服装备，而非通关奖励。"]
	quest.7B2000000000000B.title: "欧米茄之刃"
	quest.7B2000000000000C.quest_desc: ["Omega头盔融合了Awakened Supremium、Refined Obsidian、Pneumatic Armor、MekaSuit、Ignitium和Cursium。装备后，即使通过创造模式或/give获得，其能力也能生效。"]
	quest.7B2000000000000C.title: "欧米茄头盔"
	quest.7B2000000000000D.quest_desc: ["Omega 胸甲结合了六种盔甲技术。它本身提供抗性、火焰保护和套装提供的额外最大生命值。"]
	quest.7B2000000000000D.title: "Omega 胸甲"
	quest.7B2000000000000E.quest_desc: ["Omega Leggings 结合了相同的六个终局系统，穿戴时会自动提供再生和移动能力。"]
	quest.7B2000000000000E.title: "欧米茄护腿 (Omega Leggings)"
	quest.7B2000000000000F.quest_desc: ["Omega靴完成工业融合，并以速度和跳跃增强机动性。全套解锁飞行和Omega状态；缓慢降落并非最终套装的一部分。"]
	quest.7B2000000000000F.title: "欧米茄靴子"
	quest.7B20000000000010.quest_desc: [
		"手持镐、刀刃和全套盔甲，确认 Omega 军械库已为游戏后期做好准备。"
		"Project Omega 之心不再是任务奖励：必须通过消耗一颗 Omega 星，在 7×7 机械合成中合法制作。"
	]
	quest.7B20000000000010.title: "Omega Ascension"
	quest.7B20000000000011.quest_desc: ["增益效果是固有的，不依赖配方或附魔。每件装备都有自己的能力，所有装备都能提升最大生命值；4件齐备后：飞行、抗性III、再生III、速度III、力量III和吸收VI。彩色之心将多余的生命值压缩成彩色层。"]
	quest.7B20000000000011.title: "OMEGA 状态"
	quest.7B20000000000020.quest_desc: ["星辰并非始于机械工匠：它始于规模化生产。用压缩资源、Insanium、黄铜和熔岩制作一整批32个Omega合金板。"]
	quest.7B20000000000020.title: "按比例缩放的欧米茄合金"
	quest.7B20000000000021.quest_desc: ["将 Omega Alloy 变成一个可重复、自动化的结构。你的工厂应该能无需重复手动合成地制作 Frame。"]
	quest.7B20000000000021.title: "Omega 结构框架"
	quest.7B20000000000022.quest_desc: ["让Create、AE2、Mekanism和Mystical在同一个模组包中运行。Convergence Mechanism使用Sequenced Assembly，是迈向星辰前的工业证明。"]
	quest.7B20000000000022.title: "Omega 收敛机制"
	quest.7C20000000000001.quest_desc: ["此选项卡并非强制性进度路线。它是一个目录和清单。普通盔甲套装不会相互解锁；探索模组并选择你的路线。"]
	quest.7C20000000000001.title: "如何使用此武器库 (Arsenal)"
	quest.7C20000000000002.quest_desc: ["原版武器库参考。下界合金在比较和作为多种工业路线的组件时仍然很有用。"]
	quest.7C20000000000002.title: "下界合金"
	quest.7C20000000000003.quest_desc: ["Inferium 盔甲开启了神秘农业装备路线，展示了高级阶段前精华进阶的过程。"]
	quest.7C20000000000003.title: "Inferium"
	quest.7C20000000000004.quest_desc: ["Prudentium 是第二级神秘盔甲。请将此标签页用作目录，而非强制性线性路线。"]
	quest.7C20000000000004.title: "审慎（Prudentium）"
	quest.7C20000000000005.quest_desc: ["Tertium延续了神秘护甲的升级，并为种植路线的力量增长提供了视觉参考。"]
	quest.7C20000000000005.title: "Tertium"
	quest.7C20000000000006.quest_desc: ["Imperium 将神秘路线带入终局。将其属性与成本同包内科技路线进行比较。"]
	quest.7C20000000000006.title: "帝国"
	quest.7C20000000000007.quest_desc: ["Supremium 是 Mystical Agriculture 的标准高阶材料，并参与多种高级 Project Omega 合成。"]
	quest.7C20000000000007.title: "Supremium"
	quest.7C20000000000008.quest_desc: ["觉醒的超贵金属是欧米茄齿轮的基本材料。在尝试制造最终武器库之前，请先自动化其生产。"]
	quest.7C20000000000008.title: "觉醒的超贵金属（Awakened Supremium）"
	quest.7C20000000000009.quest_desc: ["Mekanism 青铜装备提供了一条中等强度的装备路线。它是一种选择，而非其他盔甲套装的先决条件。"]
	quest.7C20000000000009.title: "Mekanism — 青铜"
	quest.7C2000000000000A.quest_desc: ["Mekanism 工具的 Lapis 等级是目录中的一个替代齿轮路线，如果其他建造方案更适合，可以跳过。"]
	quest.7C2000000000000A.title: "Mekanism — 青金石"
	quest.7C2000000000000B.quest_desc: ["锇标志着机械动力工具的早期技术特征，并作为可选的装备步骤。"]
	quest.7C2000000000000B.title: "Mekanism — 锇（Osmium）"
	quest.7C2000000000000C.quest_desc: ["在精炼合金之前，钢是一种耐用的替代品。将其与 Mystical、PneumaticCraft 和 Cataclysm 的装备进行比较。"]
	quest.7C2000000000000C.title: "Mekanism — 钢制物品"
	quest.7C2000000000000D.quest_desc: ["精炼萤石将Mekanism工具引入高级装备，并与精炼黑曜石进行比较。"]
	quest.7C2000000000000D.title: "Mekanism — 精炼萤石"
	quest.7C2000000000000E.quest_desc: ["精炼黑曜石会被欧米茄装备消耗。在1.0.0中，它可以通过超高温创造混合机或精炼黑曜石精华生产；Mekanism Tools齿轮使用此方法，不依赖已禁用的化学机器。"]
	quest.7C2000000000000E.title: "Mekanism — 精炼黑曜石"
	quest.7C2000000000000F.quest_desc: ["压缩铁开启了PneumaticCraft的武器库，并准备了最终能打造出Pneumatic Armor的基础设施。"]
	quest.7C2000000000000F.title: "PneumaticCraft — 压缩铁"
	quest.7C20000000000010.quest_desc: ["Pneumatic Armor 有其自身的升级和实用功能，也参与 Omega Armor 使用的融合。"]
	quest.7C20000000000010.title: "气动盔甲"
	quest.7C20000000000011.quest_desc: ["Ignitium 代表 Cataclysm 装备和 boss 材料。部分力量被整合进了 Omega 武器库中。"]
	quest.7C20000000000011.title: "Cataclysm — 燃素"
	quest.7C20000000000012.quest_desc: ["Cursium 是另一条 Cataclysm 装备路线，它将 boss 战斗直接连接到整合包的最终合成。"]
	quest.7C20000000000012.title: "Cataclysm — Cursium"
	quest.7C20000000000013.quest_desc: ["外骨骼和喷气背包代表了创造移动性。它们与其他结构共存，并有助于准备推进核心。"]
	quest.7C20000000000013.title: "创造 — 外骨骼 \& 喷气背包"
	quest.7C20000000000014.quest_desc: ["MekaSuit 通过自身的 Create 制造路线返回军械库。它不必是最终盔甲：现在已成为 Omega Armor 合成所消耗的技术之一。"]
	quest.7C20000000000014.title: "MekaSuit"
	quest.7C20000000000015.quest_desc: ["比较整合包的主要采矿工具。它们仍是独立的装备选择；Omega Pickaxe 是将它们融合为一台机器工具的最终物品。"]
	quest.7C20000000000015.title: "终局采矿工具包"
	quest.7C20000000000016.quest_desc: ["本整合包融合了多种成长路线的武器。精炼黑曜石剑有其专属的机械合成配方，而欧米茄之刃则整合了这些武器，创造出超越单一路线的强大装备。"]
	quest.7C20000000000016.title: "终局武器"
	quest.7C20000000000017.quest_desc: ["目录哲学的例外：Omega 装备通过机械合成整合多个模组制成，在 Omega 星出现前即可获得。"]
	quest.7C20000000000017.title: "Omega Arsenal"
	quest.7D20000000000001.quest_desc: [
		"在 7×7 机械合成台合成核心。消耗一个 Omega Star 并复用最后一个工厂，但不会重复 Titan 或 Draconic Matrix。"
		"在服务器上，心脏是完成 Omega 进度的永久证明。创意物品不再有合成配方，将从官方商店获取；Omega 星将成为游戏后期的主要消耗品。"
	]
	quest.7D20000000000001.title: "Project Omega 之心"
	quest.7D20000000000002.quest_desc: ["无合成配方。通关后在 Omega 阶段，仅能从官方服务器商店获取创意引擎。"]
	quest.7D20000000000002.title: "创意引擎"
	quest.7D20000000000003.quest_desc: ["无合成配方。创造模式流体储罐现已在官方服务器商店独家出售。"]
	quest.7D20000000000003.title: "创意流体储罐 — 创造模式"
	quest.7D20000000000004.quest_desc: ["无合成配方。创意宝箱只能通过官方服务器商店获取。"]
	quest.7D20000000000004.title: "创意宝箱"
	quest.7D20000000000005.quest_desc: ["无合成配方。Mekanism 创意能量立方体是后期游戏物品，由官方服务器商店出售。"]
	quest.7D20000000000005.title: "创意能量立方体"
	quest.7D20000000000006.quest_desc: ["无合成配方。Mekanism 创意流体储罐只能通过官方服务器商店获取。"]
	quest.7D20000000000006.title: "创意流体储罐 — Mekanism"
	quest.7D20000000000007.quest_desc: ["无合成配方。Mekanism 创意化学储罐只能通过官方服务器商店获取。"]
	quest.7D20000000000007.title: "创意化学储罐"
	quest.7D20000000000008.quest_desc: ["无合成配方。AE2 创意能量单元现已在官方服务器商店独家出售。"]
	quest.7D20000000000008.title: "创意能源电池 — AE2"
	quest.7D20000000000009.quest_desc: ["收集通过官方商店获得的后期科技。此步骤代表对服务器的经济与科技掌握，而非直接合成创造模式物品。"]
	quest.7D20000000000009.title: "创意大师"
	quest.7D2000000000000A.quest_desc: ["这是 Project Omega 中唯一官方的 Chunk Loader。它没有合成配方，只能通过官方服务器商店获取。为了保护服务器性能，FTB 强制加载和旧版 Power Loader 仍处于禁用状态。"]
	quest.7D2000000000000A.title: "Omega 区块加载器"
	quest.7E20000000000001.quest_desc: ["本行始于 Precision Mechanisms。目标是用 Create 搭建可复现、可控的 mob 农场基础设施。"]
	quest.7E20000000000001.title: "从工厂到生物群系"
	quest.7E20000000000002.quest_desc: ["风扇和实体传送带将生物沿处理线移动。该技术直接基于Create的通风和传送带系统。"]
	quest.7E20000000000002.title: "实体移动"
	quest.7E20000000000003.quest_desc: ["Mob Masher负责击杀，Absorption Hopper收集物品和XP。在生成实体前，自动化输入、击杀和收集。"]
	quest.7E20000000000003.title: "击杀与收集"
	quest.7E20000000000004.quest_desc: ["将经验储存在储罐中，并通过 XP 阀门控制输出。线路应连接到包内的流体和附魔基础设施。"]
	quest.7E20000000000004.title: "经验值网络"
	quest.7E20000000000005.quest_desc: ["将捕获的经验转化为实体资源。此步骤需要 Create Enchantment Industry Experience Lantern，并证明了两个系统之间的整合。"]
	quest.7E20000000000005.title: "经验值固化器"
	quest.7E20000000000006.quest_desc: ["实体生成器能闭合线路，但不能凭空创造进展：它的配方需要一个真实的生成器、充足的经验和所有前期的工业基础设施。"]
	quest.7E20000000000006.title: "实体生成器"
	quest.6D20000000000101.title: "Naga — 暮色森林"
	quest.6D20000000000101.quest_desc: ["击败娜迦，开启暮色森林战役。该维度的首领路线现已正式成为 Age of Titans 的一部分。"]
	quest.6D20000000000102.title: "暮色巫妖"
	quest.6D20000000000102.quest_desc: ["爬上塔楼，击败巫妖。Omega遵循了暮色森林的自然发展顺序。"]
	quest.6D20000000000103.title: "Minoshroom"
	quest.6D20000000000103.quest_desc: ["穿过迷宫，击败 Minoshroom 以继续暮色森林的战役。"]
	quest.6D20000000000104.title: "九头蛇"
	quest.6D20000000000104.quest_desc: ["在火焰沼泽中面对九头蛇。它的生命值有所增加，但原有的暮色森林机制仍然至关重要。"]
	quest.6D20000000000105.title: "骑士幻影 (Knight Phantoms)"
	quest.6D20000000000105.quest_desc: ["赢得完整的骑士幻影遭遇战。此任务需要击杀六次，以代表整个堡垒阵型。"]
	quest.6D20000000000106.title: "远古幻象"
	quest.6D20000000000106.quest_desc: ["抵达黑暗塔顶，击败远古恶魂。善用竞技场陷阱和机关；高血量不等于有策略。"]
	quest.6D20000000000107.title: "阿尔法雪怪"
	quest.6D20000000000107.quest_desc: ["击败阿尔法雪怪，征服这片冰冻的土地。"]
	quest.6D20000000000108.title: "冰雪女王"
	quest.6D20000000000108.quest_desc: ["击败雪女王，完成当前的暮色森林主线战役。"]
	quest.6D20000000000111.title: "夜之巫妖 — BOMD"
	quest.6D20000000000111.quest_desc: ["找到夜巫塔，并击败四大毁灭威胁首领之一。"]
	quest.6D20000000000112.title: "下界手套 — BOMD"
	quest.6D20000000000112.quest_desc: ["找到它的下界结构并击败 Gauntlet。Omega 的战役需要所有四个 BOMD 首领。"]
	quest.6D20000000000113.title: "虚空之花 — BOMD"
	quest.6D20000000000113.quest_desc: ["潜入深处，在地下竞技场直面虚空之花。"]
	quest.6D20000000000114.title: "Obsidilith — BOMD"
	quest.6D20000000000114.quest_desc: ["在末地击败Obsidilith，完成Bosses of Mass Destruction套装。"]
	quest.6D20000000000121.title: "Ferrous Wroughtnaut"
	quest.6D20000000000121.quest_desc: ["找到 Wroughtnaut 的地下密室，了解其弱点窗口。HP 增加了，但战斗仍以机制为主，而非纯粹的 DPS 测试。"]
	quest.6D20000000000122.title: "Frostmaw"
	quest.6D20000000000122.quest_desc: ["醒来并击败霜喙。它的攻击和冰冻机制仍然是战斗的核心。"]
	quest.6D20000000000123.title: "Umvuthi"
	quest.6D20000000000123.quest_desc: ["击败Umvuthi并完成Omega使用的三个主要Mowzie's Mobs遭遇战。"]
	quest.6D20000000000140.title: "暮色征服矩阵"
	quest.6D20000000000140.quest_desc: ["带着暮色森林八大首领的奖杯返回工厂：Naga、Lich、Minoshroom、Hydra、Knight Phantoms、Ur-Ghast、Alpha Yeti 和 Snow Queen。", "机械合成将整个维度战役压缩成一个矩阵，将首领遗物转化为终局材料，而非简单的击杀验证。"]
	quest.6D20000000000141.title: "毁灭矩阵"
	quest.6D20000000000141.quest_desc: ["收集远古灵魂、炽热之眼、虚空荆棘和观察者之心，这四种来自《毁灭领主》的BOSS材料。", "用Create机制处理它们，以形成毁灭矩阵。"]
	quest.6D20000000000142.title: "野生遗迹矩阵"
	quest.6D20000000000142.quest_desc: ["千金属之斧、冰晶与索尔之貌代表了泰坦时代所选的三大 Mowzie's Mobs 遭遇。", "这些奖励现在会用于推进 Project Omega 的工业化进程，而不再是可选的奖杯或装备。"]
	quest.6D20000000000130.title: "征服矩阵"
	quest.6D20000000000130.quest_desc: ["将暮色征服矩阵、毁灭矩阵和狂野遗迹矩阵与龙之矩阵及创造组件相结合。", "该矩阵证明了探索战役的完成与工业化。请在泰坦矩阵中心消耗它。"]

}
