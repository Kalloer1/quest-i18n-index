	chapter.561CB01B35476D75.title: "第一步：基础操作指南"
	chapter.5A10000000000001.chapter_subtitle: ["从第一个蜂巢到工业化养蜂场：捕捉、繁殖蜜蜂，将其加工成可再生的工厂资源。"]
	chapter.5A10000000000001.title: "勤劳的蜜蜂模组 (Productive Bees)"
	chapter.5B00000000000001.chapter_subtitle: ["工业飞行进阶：创造、Mekanism 氢气和后期 Mystical 飞行。"]
	chapter.5B00000000000001.title: "推进与飞行 Propulsion \& Flight"
	chapter.5B10000000000001.chapter_subtitle: ["将农业自动化整合到创造基础设施中。"]
	chapter.5B10000000000001.title: "创建综合农场系统 (Create Integrated Farming)"
	chapter.5C00000000000001.chapter_subtitle: ["Create 工厂开启了数字时代，将 AE2 处理器转化为工业产品。"]
	chapter.5C00000000000001.title: "Applied Energistics 2 — 处理器"
	chapter.5D00000000000001.chapter_subtitle: ["主线使用 Mekanism 提供动力，并通过 Create 制造基础设施。工具、QIO、Digital Miner 和其他先进技术是可选的支线，而非 Project Omega 的要求。"]
	chapter.5D00000000000001.title: "Mekanism — 电气时代第一波"
	chapter.5E00000000000001.chapter_subtitle: ["传感器、执行器和隧道开始将物品栏和机器转化为可控制的信息。"]
	chapter.5E00000000000001.title: "Integrated Dynamics — 工业逻辑"
	chapter.5F00000000000001.chapter_subtitle: ["用神秘的种子和精华来种植资源。"]
	chapter.5F00000000000001.title: "神秘农业 (Mystical Agriculture)"
	chapter.6A00000000000001.chapter_subtitle: ["Create 和 FE 之间的桥梁：电机、发电机、电线和储能装置将电能与旋转连接起来。"]
	chapter.6A00000000000001.title: "创造工艺与附加的机电工程 (Create Crafts & Additions Electromechanics)"
	chapter.6C10000000000001.chapter_subtitle: ["在受控的进度下，添加前缀、镶嵌宝石、拆解、重铸和附魔。高战力是目标，但不应超出整合包设定的极限。"]
	chapter.6C10000000000001.title: "Apotheosis — 神秘锻造台"
	chapter.6D10000000000001.chapter_subtitle: ["工业开启了探索与战斗的道路。击败威胁，将遗迹带回工厂，并为Omega Age准备所需材料。"]
	chapter.6D10000000000001.title: "泰坦纪元 Age of Titans"
	chapter.7721BF8F8A0D1F5C.chapter_subtitle: ["从安山合金到第一条自动化压制线，学习旋转、传动、控制和运输。"]
	chapter.7721BF8F8A0D1F5C.title: "创造 I — 最初的行动"
	chapter.775A728C8474C51E.chapter_subtitle: ["从轨道到物流：建造火车、车站、信号系统和工业铁路路线。"]
	chapter.775A728C8474C51E.title: "创造：蒸汽与铁路 — 铁路系统"
	chapter.79B941FCF6DEA109.chapter_subtitle: ["燃料、引擎和石化：将原材料转化为创造旋转。"]
	chapter.79B941FCF6DEA109.title: "创造：柴油发电机"
	chapter.7B10000000000001.chapter_subtitle: ["在工业和泰坦之后，Omega Age 开始：八个核心汇聚成 Omega Star 工厂；从中诞生永久的核心和创造时代。"]
	chapter.7B10000000000001.title: "Project Omega — 飞升"
	chapter.7C10000000000001.chapter_subtitle: ["展示了所有可用的主要盔甲套装、工具和武器。任务独立：使用适合你构筑的装备。只有 Omega 装备使用特殊的跨模组合成。"]
	chapter.7C10000000000001.title: "Modpack 武器库"
	chapter.7D10000000000001.chapter_subtitle: ["服务器游戏后期：Omega Star 成为交易代币，Omega Heart 证明最终进度完成。创意物品仅限官方商店出售。"]
	chapter.7D10000000000001.title: "创意时代"
	chapter.7E10000000000001.chapter_subtitle: ["将生物、掉落物和经验值转化为自动化的创造模式生产线，而无需将刷怪器变成免费捷径。"]
	chapter.7E10000000000001.title: "工业生物农场 & 经验值"
	chapter_group.2D6B2D85F4B6B079.title: "欢迎"
	chapter_group.5A00000000000001.title: "创建 — 高级工程学"
	chapter_group.5A00000000000002.title: "TECHNOLOGY"
	chapter_group.5A00000000000003.title: "资源"
	chapter_group.66D3BBBABB5BFD56.title: "主线进度"
	chapter_group.6D00000000000001.title: "泰坦纪元"
	chapter_group.7B00000000000001.title: "PROJECT OMEGA"
	chapter_group.7C00000000000001.title: "武器库 \& 装备"
	quest.1000000000000001.quest_desc: [
		"感谢您安装并游玩此整合包。创造是进阶的基石：您将从简单的机制开始，逐步将资源、运输和生产转化为完全自动化的系统。"
		"这本任务书是互动课程，不是清单。阅读描述，完成建议的测试，把食物奖励当作小礼物——没有重要技术会白白送给你。"
	]
	quest.1000000000000001.title: "欢迎——也谢谢你！"
	quest.1000000000000002.quest_desc: [
		"JEI 是你的主要配方参考。搜索物品时，使用界面显示的按键和按钮，查看其合成方式及可用工艺。"
		"此整合包中，配方可能因模组整合或未来平衡性调整而改变。本书解释流程和机器作用，具体配方和数量请查阅JEI。完成此步骤前，请先在JEI中打开配方。"
	]
	quest.1000000000000002.title: "JEI：你的配方工作台"
	quest.1000000000000003.quest_desc: [
		"Ponder 是 Create 的可视化文档。在兼容组件上，使用游戏显示的关键打开动画演示，展示组装、移动方向和操作。"
		"它对机器、动能传动、流体、火车和较难理解的过程尤其有用。现在就打开至少一个演示；以后遇到任何机器不明白时，都回到Ponder。"
	]
	quest.1000000000000003.title: "沉思：通过观察来学习"
	quest.1000000000000004.quest_desc: [
		"任务之间的连线代表真实依赖：只有在学习或获得所需条件后，下一步才会出现。主路径推动技术升级，而可选分支则在不阻碍进展的情况下教授升级和工具。"
		"当 FTB Quests 检测到所需资源时，物品任务即视为完成。勾选标记则用于必须在世界中执行的操作，例如测试机器、建造生产线或确认你理解某个系统。"
	]
	quest.1000000000000004.title: "阅读任务树"
	quest.1000000000000005.quest_desc: [
		"为工作室选择一个光线充足的地方，并在制作和存储区周围留出空间。机器需要空间放置Shafts、Cogwheels、Belts、旋转源以及未来的输入和输出线路。"
		"你的工厂不必追求美观，只需避免将所有东西都挤在角落。当有足够空间扩建而无需拆除之前的一切时，确认此任务以开始建造地基。"
	]
	quest.1000000000000005.title: "成长的空间"
	quest.1100000000000001.quest_desc: [
		"木材仍然是手工阶段的基础：它能提供木板、工具和许多在机器出现后依然有用的组件。"
		"收集任务所需的原木。本书并非完整的原版教程，目标仅是确保能顺利进入创造模式，而不会中断进度。"
	]
	quest.1100000000000001.title: "你的第一块木头"
	quest.1100000000000002.quest_desc: [
		"在工作台获得机械加工功能之前，合成台将是你的首个配方中心。用你刚收集的木材来制作一个吧。"
		"即使机器和自动合成出现，工作台对于简单组件仍很有用。目前，它能为你开启石制工具和基地建造的途径。"
	]
	quest.1100000000000002.title: "你的合成台"
	quest.1100000000000003.quest_desc: [
		"鹅卵石能提供最耐用的工具和用于冶炼金属的熔炉。现在就收集一些备用，这样每个配方都无需中断流程。"
		"下一步是石镐，足以获取基础矿石来启动工坊的初步建设。"
	]
	quest.1100000000000003.title: "一个石头地基"
	quest.1100000000000004.quest_desc: [
		"石镐是早期采集与金属加工之间的桥梁。有了它，你就可以开始收集铁和铜等重要资源，这些资源几乎会出现在整个技术发展的过程中。"
		"用刚收集的资源制作工具，开始探索地下。暂时不必囤积大量物资，这些工作大多会在后期自动化。"
	]
	quest.1100000000000004.title: "石制镐子"
	quest.1100000000000005.quest_desc: [
		"熔炉引入了你的第一种加工方式：将原始资源转化为可用材料。在创造机器开始接管部分工作之前，它仍然是最简单的解决方案。"
		"用你收集的鹅卵石制作一个。燃料和特定配方请查看 JEI，因为它会显示此整合包中实际可用的选项。"
	]
	quest.1100000000000005.title: "矿石的加热过程需要热量"
	quest.1100000000000006.quest_desc: [
		"铁是本阶段最重要的资源之一。它用于制作工具、红石元件，以及建造第一台创造机器所需的许多部件。"
		"获取并处理铁，直到获得所需的锭。多余的可以留着：很快，其中一部分会变成金块、工具和机械组件。"
	]
	quest.1100000000000006.title: "你的第一块铁锭"
	quest.1100000000000007.quest_desc: [
		"有了铁镐，你的采集就不再局限于最基础的材料。它还能让你获得红石，这之后会用来控制旋转网络。"
		"用前一步的铁来制作。在工坊缺少钻头、锯子和其他自动化设备时，它会成为你的主要工具。"
	]
	quest.1100000000000007.title: "铁质镐"
	quest.1100000000000008.quest_desc: [
		"红石不仅用于原版电路。在创造模式中，它还能控制机械传动系统中停止或反转部分的组件。"
		"用你的铁镐收集所需数量。稍后，Clutch和Gearshift将展示工厂不仅需要移动，还需要控制的原因。"
	]
	quest.1100000000000008.title: "一个控制信号"
	quest.1100000000000009.quest_desc: [
		"铁粒是金属的一种较小形态，用于向安山合金发展的早期阶段。由于你已经处理了铁，这一步只是以 Create 所需的形式准备好材料。"
		"转换所需数量，并多留几块。合成合金时查看 JEI，因为确切配方可能会被整合包更改。"
	]
	quest.1100000000000009.title: "更小形态的铁元素"
	quest.110000000000000A.quest_desc: [
		"铜对于金属板、流体、机器和后期技术都很重要。现在开始储备，可以避免每次新生产线需要这种金属时都返回矿井。"
		"用现阶段可用的方法获取并处理铜。先别考虑量产，目标只是为你进入创造模式做好准备。"
	]
	quest.110000000000000A.title: "一份铜储备清单"
	quest.110000000000000B.quest_desc: [
		"箱子是工坊的第一个缓冲区。将原材料、半成品和成品分开存放，可以避免物品散乱一地，阻碍进度。"
		"制作一个，放置在工作区附近。之后，物品栏将不再只是简单的存储，而是自动化生产线的重要组成部分。"
	]
	quest.110000000000000B.title: "万物各得其所的归属地"
	quest.110000000000000C.quest_desc: [
		"进入创造模式前，请在光线充足的地方整理好工作台、熔炉和储物空间。将铁、铜、红石和建筑材料分开存放，为第一个旋转网络留出空位。"
		"这是一个建造任务，所以用对勾标记。基地准备好接收机器后确认即可，无需为每个新任务重新整理一切。"
	]
	quest.110000000000000C.title: "一个井然有序的基地"
	quest.1200000000000001.quest_desc: [
		"安山岩是开启第一代 Create 组件的矿物资源。使用整合包提供的方法在世界上找到它，并收集少量储备。"
		"上一个阶段已经以可用的形式准备了铁。现在两条路径交汇：安山岩将被制成安山岩合金，即下一阶段任务的核心材料。"
	]
	quest.1200000000000001.title: "开启一切的那块石头"
	quest.1200000000000002.quest_desc: [
		"安山合金是创造模组的基础材料之一。它出现在竖井、外壳以及构成你首个工厂机械基础的许多组件中。"
		"你已经准备好了安山岩和金属资源。 §bJEI:§r 查看整合包当前配方中已安装的配方，多制作几个单位，因为你在后续阶段会频繁使用这种合金。"
	]
	quest.1200000000000002.title: "驱动万物的合金 The Alloy That Moves Everything"
	quest.1200000000000003.quest_desc: [
		"安山岩外壳是创造模式早期许多机器和组件使用的结构外壳。它将简单材料转变为更复杂机制的合适底座。"
		"在创造模式中，外壳通常指将材料应用到合适的基座上；由于配方和交互可能有所不同，请查阅JEI和Ponder以了解本整合包中的方法。请记住这个概念：之后你会遇到用于更高级技术的其他外壳类型。"
	]
	quest.1200000000000003.title: "安山岩外壳"
	quest.1200000000000004.quest_desc: [
		"现在你有了安山合金，就可以开始传输动力了。传动轴就像一个机械车轴：它将旋转从源头传递到齿轮、机器和工厂的其他部分。"
		"制作所需的传动轴，并保留配方中多余的部件。从现在开始，当机器需要远程旋转时，先考虑传动轴如何到达它。"
	]
	quest.1200000000000004.title: "你的第一根竖井"
	quest.1200000000000005.quest_desc: [
		"齿轮连接并重定向动能网络。它们的齿将旋转传递到附近的轴上，并在布局需要时改变运动方向。"
		"你已经有了Shafts来沿直线传递旋转；现在Cogwheel开始构建传动系统。 §6思考：§r在建造更复杂的网络前，先用可视化功能构想可能的连接方式。"
	]
	quest.1200000000000005.title: "牙齿在运动中"
	quest.1200000000000006.quest_desc: [
		"大齿轮的作用不仅仅是占地方：当它与较小的齿轮结合使用时，可以改变传动装置各部分之间的速度比。"
		"你还不需记住数字。制作一个，打开 Ponder，观察不同大小齿轮的连接方式；在下一个活动中，你将在世界中测试这种关系。"
	]
	quest.1200000000000006.title: "一个更大的齿轮"
	quest.1200000000000007.quest_desc: [
		"手摇柄是一种手动旋转装置。它非常适合用作测试台，因为你可以用它短暂地转动机器，而无需建造永久性的动力源。"
		"将曲柄连接到你已经知道如何制作的轴上。它不足以驱动整个工厂，但足以让你感受到动能网络的响应。"
	]
	quest.1200000000000007.title: "由手提供动力"
	quest.1200000000000008.quest_desc: [
		"设置一个连接到至少一个转轴的手摇柄，然后转动它。注意旋转方向和运动在连接部件中的传递方式。"
		"此任务使用对勾，因为拥有部件并不能证明你已测试系统。只有在启动首个动能网络后，才予以确认。"
	]
	quest.1200000000000008.title: "你的第一次旋转"
	quest.1200000000000009.quest_desc: [
		"将齿轮与大型齿轮组装，并移动该装置。直观比较两根轴的转速，然后尝试改变输入动力的方向。"
		"当需要适配动力源与机器需求时，就会出现这个传动比原理。如果齿轮未按预期连接，Ponder 能展示出有用的排列方式。"
	]
	quest.1200000000000009.title: "用速度换取扭矩"
	quest.120000000000000A.quest_desc: [
		"水轮将流动的水转化为持续的旋转动力。这是迈向未来的第一步：你的工坊不再需要依靠手摇曲柄来运作。"
		"使用JEI中显示的当前配方制作轮子。安装前，使用Ponder了解水流和方向如何影响产生的运动。"
	]
	quest.120000000000000A.title: "水力发电 Power from Water"
	quest.120000000000000B.quest_desc: [
		"将水轮安装在合适的水流旁，并将其旋转输出连接到传动轴上。网络应能持续转动，无需你手持曲柄。"
		"仅在源设备稳定运行后确认任务。此后，后续机器可共享真实的动能基础设施。"
	]
	quest.120000000000000B.title: "旋转不停止 Rotation Without Stopping"
	quest.120000000000000C.quest_desc: [
		"齿轮箱是一种传动组件。它让你从一个紧凑的点，将相同的旋转传递到多个轴上，而无需为每个方向建造一列令人困惑的齿轮序列。"
		"你已经了解了Shafts、Cogwheels和连续源；现在用Gearbox来组织网络。 §bJEI:§r 查看已安装的配方以获取配方，并通过Ponder来理解其传动面。"
	]
	quest.120000000000000C.title: "分发旋转指令（Distribute the Rotation）"
	quest.120000000000000D.quest_desc: [
		"Clutch 为您的工厂增添了一项重要功能：它可以通过红石信号中断某一区域的旋转传动。这样您无需关闭整个电源即可停止机器。"
		"地基章节准备的红石终于进入了动力网络。在合适的地方安装离合器以控制一个区域，如果想观察有信号和无信号时的行为，请使用沉思。"
	]
	quest.120000000000000D.title: "在不破坏网络的情况下停止运行"
	quest.120000000000000E.quest_desc: [
		"齿轮箱也响应红石，但它的作用是将旋转方向反转，而不仅仅是停止。当机制需要交替方向而无需重建传动系统时，这非常有用。"
		"你已经知道如何分发和停止运动了，现在给系统加上倒转功能。在 Ponder 中查看控制示例，然后在网络的某个安全区域进行测试。"
	]
	quest.120000000000000E.title: "将方向反转"
	quest.120000000000000F.quest_desc: [
		"至今为止，你都是通过观察部件旋转来评估网络的。指南针作为将运动转化为可读信息的仪器组件，加入了这一进程。"
		"你已从基础章节获得了铁和红石。合成所需的指南针，并在 JEI 中查看其在下一个配方中的用途。"
	]
	quest.120000000000000F.title: "用于测量的指南针 Compass for Measurement"
	quest.1200000000000010.quest_desc: [
		"速度计测量网络的转速。这让你无需仅凭视觉印象就能比较传输，并有助于解释为何连接到同一系统的两台机器行为可能不同。"
		"使用 JEI 中显示的配方制作它，并将其安装在网络的活跃部分。回想一下齿轮比测试：现在你有了一个客观的方法来观察结果。"
	]
	quest.1200000000000010.title: "测量速度"
	quest.1200000000000011.quest_desc: [
		"应力计显示了可用动能与连接组件所消耗应力之间的关系。网络在缺乏足够扩展容量时仍可能保持运转。"
		"使用仪器监控负载，再一次性添加多台机器。速度和压力是两个不同的概念；学会读懂两者，能避免未来生产线因看似神秘的原因而停机。"
	]
	quest.1200000000000011.title: "了解极限所在"
	quest.1200000000000012.quest_desc: [
		"干海带是皮带连接器系列的一部分，该物品能将旋转转化为材料运输线。使用此阶段可用的加工方式，准备好所需数量。"
		"查看 JEI 确认当前连接器配方。从现在开始，你的工坊将开始传输机械动力和物品。"
	]
	quest.1200000000000012.title: "海带已准备好用于腰带制作"
	quest.1200000000000013.quest_desc: [
		"皮带连接器用于在正确对齐的轴之间创建皮带。皮带在传递动力的同时，也为物品在工厂内的移动提供了表面。"
		"制作连接器并使用 Ponder 来可视化对齐、距离和组装。下一个任务不是要你仅仅拥有物品——而是要你建造一个可用的腰带。"
	]
	quest.1200000000000013.title: "传送带连接器"
	quest.1200000000000014.quest_desc: [
		"放置两个兼容的Shafts，用Belt Connector组成皮带，并为装置提供旋转动力。将物品放在Belt上，观察其是否沿线路移动。"
		"运输生效后请确认任务。这是核心自动化概念：从此机器可自动收发货，无需手动搬运。"
	]
	quest.1200000000000014.title: "你的第一条腰带"
	quest.1200000000000015.quest_desc: [
		"Depot 是一个稳定的表面，物品可以在上面等待 Create 操作。它像一个小型处理站，特别适合一次处理一件物品。"
		"你已经知道如何用传送带移动物品了，现在来学习如何创建固定工作站。下一台机器，机械压机，可以安装在储料站上，也可以是移动生产线的一部分。"
	]
	quest.1200000000000015.title: "一个工作站"
	quest.1200000000000016.quest_desc: [
		"下一台机器需要更重的框架，所以这一步会用你已经知道如何获取的铁来制作一个铁块。这标志着从轻型组件过渡到能够施加机械压力的机器。"
		"合成所需的方块，并在JEI中查看其在当前机械压机配方中的用法。不要假设JEI未显示的该版本之外的材料。"
	]
	quest.1200000000000016.title: "用于框架的铁锭"
	quest.1200000000000017.quest_desc: [
		"机械压机将旋转力转化为机械压力。用于压制材料、制作板材，并参与其他多种Create配方。"
		"要正常工作，压床必须连接到旋转网络，并放置在合适的工作区上方，例如根据工艺选择的车库或传送带。你已经理解这两个概念：机械动力和物品运输。"
		"在机械压机上使用 Ponder 查看演示，并在 JEI 中查找可用配方。在下一个任务中，你将制作第一张铁板。"
	]
	quest.1200000000000017.title: "是时候压制了"
	quest.1200000000000018.quest_desc: [
		"铁板是通过机械处理而非普通合成生产的早期部件之一。将JEI显示的物品放在机械压机下方，让机器完成压制循环。"
		"记下几张配方：它们会出现在后续工作坊的多个组件中。理解流程比死记硬背配方更重要——放置物品、提供旋转，再由压机执行操作。"
	]
	quest.1200000000000018.title: "你的第一张纸页"
	quest.1200000000000019.quest_desc: [
		"同样的机械压机也能处理其他金属。使用当前的JEI配方制作铜板，练习复用你刚建造的制作用台。"
		"此分支为可选，不影响章节进度，但在涉及流体和其他机器时，压制铜将变得重要。一个好的工厂会重复利用基础设施，而不是为每种材料建造一台机器。"
	]
	quest.1200000000000019.title: "铜质薄片"
	quest.120000000000001A.quest_desc: [
		"金箔是机械压机的另一种应用，能解锁实用的Create组件。由于现阶段黄金可能较少，此任务为可选任务。"
		"查看 JEI 的配方，方便时处理一个单位，并保持压机可访问。主要经验是同一压榨线可用于多种材料。"
	]
	quest.120000000000001A.title: "黄金薄片"
	quest.120000000000001B.quest_desc: [
		"护目镜是Create模组的信息工具。装备后，在检查各种组件时能显示额外数据，让机械网络的诊断变得容易得多。"
		"此升级可选，属于黄金分支。 §bJEI:§r 查看当前配方中已安装的配方，装备后检查几个工坊组件，看看会出现哪些额外信息。"
	]
	quest.120000000000001B.title: "工程师护目镜"
	quest.120000000000001C.quest_desc: [
		"你已经知道如何用机械压机制作铁板了。现在是时候把这个过程变成一个小型自动化生产线了。"
		"建造一个能接收输入材料、将其运送到压制区，并能移除成品板材的系统，无需手动放置每个物品。没有唯一正确的解决方案：使用传送带、存储箱和你已经会建造的旋转装置。"
	]
	quest.120000000000001C.title: "不再需要手动操作了 (No More Doing It by Hand)"
	quest.120000000000001D.quest_desc: [
		"你的工坊已经有了持续的动力源，但一个好的工厂还必须易于观察和控制。在网络上安装速度和压力计，并在测试区使用离合器和换挡器。"
		"用红石触发控制器，确认能有意地测量、停止和反转运动。这项活动为后续机器做好准备，防止它们变成一个无法诊断的网络。"
	]
	quest.120000000000001D.title: "一个受控的网络"
	quest.120000000000001E.quest_desc: [
		"你已从基础资源发展到能生成、传输、测量和控制旋转、移动物品并自动生产板材的工作台。这套系统是后续一切的基础。"
		"保留一个小型工作装置，包含水轮、通过传动轴或齿轮箱、皮带和机械压机的传动系统，以及至少一个测量或控制点。当工坊真正可用时确认里程碑——下一章将扩展你的加工工具集。"
	]
	quest.120000000000001E.title: "你的第一间机械工坊"
	quest.1300000000000001.quest_desc: [
		"Basin 是 Create 的批量处理工作区。它接收原料，并作为机械搅拌机（Mechanical Mixer）等机器的操作空间；后续配方也会在更高级的流程中使用它。"
		"你已经拥有一个可用的压制工坊，现在我们将扩展它能执行的各种转换。 §bJEI:§r 查看当前盆的配方，并使用 Ponder 来了解它与上方机器的互动方式。"
	]
	quest.1300000000000001.title: "用于加工的盆子 Basin for Processing"
	quest.1300000000000002.quest_desc: [
		"搅拌棒是机械搅拌机使用的搅拌工具。它本身无法工作，但它是让下一台机器在盆中处理配方的组件。"
		"你已经知道如何制作薄片和机械组件了；现在用 JEI 查看此整合包版本制作 Whisk 所需的材料。"
	]
	quest.1300000000000002.title: "工作室的搅拌棒"
	quest.1300000000000003.quest_desc: [
		"机械搅拌机将旋转转化为机械混合。放置在盆上方并连接到动能网络，它能执行你之前在工作台无法完成的混合配方。"
		"某些工艺还需要高温条件，这我们稍后会学到。查看 JEI 了解哪些配方使用 Mixer，并用 Ponder 观察正确的设置后再启动机器。"
	]
	quest.1300000000000003.title: "与旋转力混合制作物品时，物品会旋转。"
	quest.1300000000000004.quest_desc: [
		"将机械搅拌机设置在盆上方，并用你已经知道如何产生的旋转来为机器供能。在JEI中选择一个此阶段可用的混合配方，并观察一个完整的循环。"
		"此处的目标并非制作特定物品，而是理解流程：原料进入 Basin，机器开始旋转，配方条件满足后，结果便会显现。"
	]
	quest.1300000000000004.title: "让混合反应发生吧"
	quest.1300000000000005.quest_desc: [
		"螺旋桨是用于在创造机器中移动空气的转子。它将你通过机械压机学到的关于板材的知识，与工坊的下一个加工系统连接起来。"
		"使用 JEI 中显示的配方制作一个。请记住简单部件和大型机器之间的联系：许多 Create 机制都是由你已经制作的组件组装而成的。"
	]
	quest.1300000000000005.title: "气流推进器 (The Airflow Propeller)"
	quest.1300000000000006.quest_desc: [
		"Encased Fan 利用旋转来创造气流。根据风扇和物品之间放置的介质，该气流可以执行多种类型的批量处理。"
		"旋转方向很重要，因为它决定了空气被推往何处。 §bJEI:§r 查看已安装的配方以了解整合包中可用的处理类别，并使用 Ponder 研究 Encased Fan 来理解距离、方向和组装方式。"
	]
	quest.1300000000000006.title: "空气也能发挥作用"
	quest.1300000000000007.quest_desc: [
		"现在将气流变成一个清洗站。让封闭式风扇吹过水，朝向物品，并从JEI中选择一个属于清洗类别的配方。"
		"自动化前请先观察结果：部分配方可能有多种产物或不同概率。JEI 是本整合包版本中实际数值的参考。"
	]
	quest.1300000000000007.title: "使用气流进行清洗"
	quest.1300000000000008.quest_desc: [
		"当气流穿过合适的介质时，密封风扇也能参与批量热处理。这样你无需将物品单独放入熔炉，即可一次性处理大量物品。"
		"在JEI中打开整合包提供的批量烟熏或批量爆破配方，并按照图示摆放。此步骤为可选，不影响主线进度。"
	]
	quest.1300000000000008.title: "空气传导的热量"
	quest.1300000000000009.quest_desc: [
		"机械锯是工坊的切割工具。它能处理方块和移动物品，在开始建造移动机器时也会派上用场。"
		"切割配方会因已安装的材质和附加组件而异，请在JEI中查看此整合包中锯子能处理的内容。Ponder对于理解朝向和安全使用也很有用。"
	]
	quest.1300000000000009.title: "机械切割"
	quest.130000000000000A.quest_desc: [
		"机械钻头通过旋转力来破坏前方的方块。在固定装置中，它可作为自动工具使用；在机械装置中，它则是挖掘机械的一部分。"
		"你已经理解了旋转传动，现在还要注意方向和破碎方块的收集。 §6思考：§r 在将钻头集成到更大的结构中之前，先用可视化功能看看示例。"
	]
	quest.130000000000000A.title: "机械钻孔"
	quest.130000000000000B.quest_desc: [
		"滑道是利用重力垂直移动物品的简单方法。它与从上方接收材料或向较低层级输送产出的机器配合得很好。"
		"既然学会了清洗，就该开始整理工艺输入输出了。 §bJEI:§r 查看当前配方，并在工坊的两层之间测试一个滑槽。"
	]
	quest.130000000000000B.title: "一条垂直的道路"
	quest.130000000000000C.quest_desc: [
		"安山岩漏斗是Create的基础物流方块之一。它在物品栏和运输线之间移动物品，无需玩家干预即可创建清晰的输入和输出点。"
		"上一章建造的腰带现在迎来了一位重要伙伴。 §6思考：§r使用可视化来观察插入和提取模式，并在JEI中查看已安装的配方。"
	]
	quest.130000000000000C.title: "受控输入与输出 (Controlled Input and Output)"
	quest.130000000000000D.quest_desc: [
		"机械收割机旨在安装在合适的装置上以收割作物。它引入了一个日后至关重要的理念：农业资源也可以成为工厂自动化逻辑的一部分。"
		"此任务目前为可选。制作Harvester，观看其Ponder演示，并在实现工业化农业和移动农场时再使用。"
	]
	quest.130000000000000D.title: "不再需要手动采集作物了"
	quest.130000000000000E.quest_desc: [
		"锌是创造模组自带的金属之一，也是进入黄铜阶段的关键。在世界上找到它的来源，并按照 JEI 中的步骤将其冶炼成锭。"
		"自工坊奠基以来，你就拥有了铜。将这两种金属在高温下结合，将解锁更先进的物流组件和机器。"
	]
	quest.130000000000000E.title: "缺失的金属 (The Missing Metal)"
	quest.130000000000000F.quest_desc: [
		"捕获烈焰人前，先准备好一个空的烈焰人燃烧器。它是将热量转化为可控工坊组件的容器，但自身无法加热盆。"
		"你已经知道如何制作铁板，并且需要热量才能继续推进了。 §bJEI:§r 查看当前空烈焰熔炉的配方并制作一个；下一个任务会教你如何激活它。"
	]
	quest.130000000000000F.title: "准备容器"
	quest.1300000000000010.quest_desc: [
		"空白的烈焰燃烧器目前不提供热量。要将其变为可用的烈焰燃烧器，你需要捕获留在其内部的熱源。"
		"在标准 Create 中，这需要使用空烈焰熔炉来熔炼烈焰或其他兼容源；在尝试捕捉前，请先检查你的安装中的 Ponder 和 JEI。烈焰熔炉准备就绪后，盆即可处理需要加热的配方混合。"
	]
	quest.1300000000000010.title: "捕获热量"
	quest.1300000000000011.quest_desc: [
		"黄铜标志着向Create更复杂机制的过渡。此时，需要在具备适当加热条件和所需金属的盆上方使用机械搅拌机。"
		"不要依赖记忆中的数量：在JEI中打开黄铜锭配方，确认当前整合包版本所需的材料、比例和加热等级。制作少量储备，因为接下来的几个任务都依赖于此。"
	]
	quest.1300000000000011.title: "进入黄铜时代"
	quest.1300000000000012.quest_desc: [
		"黄铜外壳是安山岩外壳在创造模式更高级阶段的结构性进化。它出现在物流系统、接口和机械合成中。"
		"你从早期的 Create 就理解了外壳的概念。现在查看 JEI，看看当前版本如何将你的黄铜材料转化为这种新外壳，并至少准备一个单位。"
	]
	quest.1300000000000012.title: "黄铜外壳"
	quest.1300000000000013.quest_desc: [
		"黄铜漏斗将安山漏斗的概念引入物流，实现了更精细的控制。当工厂需要更精确地决定输入、输出及数量时，它就派上了用场。"
		"既然你已经用安山岩漏斗测试了基本流程，并且现在能生产黄铜了，那么这个升级来得正是时候。 §6思考：§r 使用可视化功能来比较它们的行为，并在 JEI 中确认配方。"
	]
	quest.1300000000000013.title: "更精确的物流系统 (More Precise Logistics)"
	quest.1300000000000014.quest_desc: [
		"电子管是Create中更复杂机制的控制组件。它将工坊的机械部分与需要更高精度的部件（如部署器、机械合成器和物流系统）连接起来。"
		"其制作链可能涉及尚未直接出现在任务中的材料。 §bJEI:§r 使用配方查看器逐步跟随当前配方，并多备几份备用材料。"
	]
	quest.1300000000000014.title: "机械电子学 (Mechanical Electronics)"
	quest.1300000000000015.quest_desc: [
		"黄铜手是将黄铜转化为可操控物品的执行器的组件。它直接为部署器（Deployer）的建造做准备，而部署器是该整合包后期进展最重要的机器之一。"
		"你已经有了机械压机，也知道如何制作板材。查看 JEI 了解该知识在当前黄铜手配方中的应用。"
	]
	quest.1300000000000015.title: "一个黄铜手工艺品"
	quest.1300000000000016.quest_desc: [
		"Deployer 就像一个机械手：它能执行交互，并将持有的物品应用到前方的目标上。这样，重复的玩家操作就变成自动化流程中的一环。"
		"之后，这个概念对于序列组装、自定义组件和整合包的神秘农业资源种子至关重要。 §6思考：§r 使用可视化来理解方向、范围和物品投入，并在 JEI 中查看确切配方。"
	]
	quest.1300000000000016.title: "施加机器 The Machine That Applies"
	quest.1300000000000017.quest_desc: [
		"将部署器连接到旋转网络，并给它一个能通过 JEI 或 Ponder 显示的合法交互使用的物品。观察机械臂伸出、执行动作，然后返回。"
		"只有在看到实际应用后才确认。目标是理解机制，因为从此刻起，Deployer将不再只是一台机器，而会成为更庞大流程中的一环。"
	]
	quest.1300000000000017.title: "让部署器开始工作吧"
	quest.1300000000000018.quest_desc: [
		"便携式存储接口在两个接口对齐时，会在装置和固定工厂之间创建一个临时的物品传输点。这使得移动机器无需拆解即可卸载或接收材料。"
		"这项知识与钻头机和收割机尤其相配。 §6思考：§r 使用可视化功能观察接口连接，并在 JEI 中查看当前配方。"
	]
	quest.1300000000000018.title: "通往移动机械的桥梁"
	quest.1300000000000019.quest_desc: [
		"机械合成器将合成配方转化为实体结构。每个合成器代表网格中的一个格位，多个方块可以连接成更大的或特殊的图案。"
		"此任务会检测一个单元来引入组件，但大型配方可能需要多个以 JEI 所示形状排列的制造机。它非常适合大型和特殊配方，但并非未来所有自动化制造的唯一方案。 §6思考：§r利用可视化来了解方向、连接和输出行为。"
	]
	quest.1300000000000019.title: "合成变成了一台机器"
	quest.130000000000001A.quest_desc: [
		"Crushing Wheels 成对工作。当两个轮子相互旋转时，夹在它们之间的材料会被粉碎，并可能产生新的加工产物。"
		"此步骤需要两个单位，因为功能设置依赖于这对装置。使用刚学到的机械合成台，在JEI中查看当前配方，并在驱动轮子前观察Ponder，以理解旋转方向和输入方向。"
	]
	quest.130000000000001A.title: "两轮，一台破碎机"
	quest.130000000000001B.quest_desc: [
		"是时候将流程串联起来了。在 JEI 中选择兼容的矿石或资源，构建一条从破碎开始，在配方需要时将材料送入清洗，最后进行冶炼或其他处理的流水线。"
		"没有通用的产量：产出、副产品和概率取决于已安装的配方。此任务的目标是学会如何在 JEI 中读取处理链，并将孤立的机器整合成一个连贯的工业流程。"
	]
	quest.130000000000001B.title: "从矿石到产品"
	quest.130000000000001C.quest_desc: [
		"机械臂在配置好的输入和输出点之间移动物品，为仓库、传送带、库存和其他兼容站点创建可见的物流。当多台机器需要共享材料而没有直接运输线时，它尤其有用。"
		"仔细配置点数，并在依赖其进行重要生产前测试物品路线。Ponder 会显示如何选择输入和输出；JEI 会确认当前配方。"
	]
	quest.130000000000001C.title: "用于后勤的手臂组件"
	quest.130000000000001D.quest_desc: [
		"你的工作台不再只是一个压机。现在你有了混合、通风、切割、钻孔、物流、自动涂覆和材料处理——足以开始考虑用完整的生产线而非孤立的机器来思考。"
		"建造一个小型功能齐全的工作坊，整合至少三种工艺，并有组织化的输入和输出。当一切以清晰、可重复的方式运行时，确认此里程碑：下一阶段是将工作坊转变为工厂。"
	]
	quest.130000000000001D.title: "工坊是活的，它会呼吸，会生长，会变化。"
	quest.1400000000000001.quest_desc: [
		"到目前为止，你的工厂主要处理物品和旋转。流体管道开启了自动化的新层面：在机器、储罐和处理点之间运输液体。"
		"制作几个管道，并用 Ponder 查看它们的连接方式。 §bJEI:§r 查看当前版本中该配方在已安装配方中的具体步骤；从现在开始，它们将构成你工厂的基础流体网络。"
	]
	quest.1400000000000001.title: "工厂的管道系统"
	quest.1400000000000002.quest_desc: [
		"单独的管道无法决定流体的流向。机械泵利用旋转来强制流体在管道中流动，将你的网络变成一个真正可控的系统。"
		"将泵连接到旋转源并观察指示方向。Ponder 在此尤其有用，因为反转旋转也会反转泵送方向。"
	]
	quest.1400000000000002.title: "流体运动增强模组（Motion for Fluids Too）"
	quest.1400000000000003.quest_desc: [
		"流体储罐用于储存液体，并在生产和消耗之间起到缓冲作用。这可以防止一台机器依赖于在另一个流程需要流体时，恰好接收到精确数量的流体。"
		"建造几个储罐模块，尝试将它们连接到管道上。使用 JEI 查看当前配方，使用 Ponder 来可视化更大的储罐结构。"
	]
	quest.1400000000000003.title: "一个工业水库"
	quest.1400000000000004.quest_desc: [
		"软管滑轮可以与下方的大量流体互动。当工厂需要填充或排放天然水源，而不必在每个循环中手动搬运水桶时，它非常有用。"
		"用泵和管道将其连接到网络。源被视为无限的规则可能因整合包配置而异，因此请使用 Ponder 并在此构建中测试实际行为。"
	]
	quest.1400000000000004.title: "从大型来源中汲取能量"
	quest.1400000000000005.quest_desc: [
		"物品抽取器可从兼容物品中提取流体并送入流体网络。它是出流器的天然对应物：一个清空容器，另一个则填充容器。"
		"将兼容的物品放在排水口上，然后观看过程。JEI会显示当前整合包版本中可用的清空操作。"
	]
	quest.1400000000000005.title: "正在吸取物品属性"
	quest.1400000000000006.quest_desc: [
		"Spout 会将流体施加到从其下方经过的物品上，并执行填充配方。它将你的流体网络从一个单纯的液体存储系统转变为生产线的一部分。"
		"用管道或储罐喂养 Spout，并在其下方留出放置 Belt 或 Depot 的空间。 §6思考：§r使用可视化功能查看运行中的装置，或使用 JEI 检查可填充的物品。"
	]
	quest.1400000000000006.title: "将流体放在正确的位置"
	quest.1400000000000007.quest_desc: [
		"当流体成为成品时，出料口就不再是单纯的机器。通过填充制作蜂蜜瓶，并让物品从出料口下方通过，以完成此步骤并获得可检测的结果。"
		"Create 包含此流程的标准配方，但如果整合包更改配方，你的 JEI 仍然是最终依据。之后你会将此测试转为连续生产线，并生产少量库存。"
	]
	quest.1400000000000007.title: "你的首个填充产品"
	quest.1400000000000008.quest_desc: [
		"此分支为可选。使用物品抽取器从兼容容器或物品中移除流体，并将其输送至储罐或管道网络中。"
		"不确定哪些物品支持清空功能时，请查看 JEI。在确认世界内流程正常后，再勾选此项。"
	]
	quest.1400000000000008.title: "实践中的清空操作"
	quest.1400000000000009.quest_desc: [
		"将 Hose Pulley 或其他水源、机械泵、流体管道、流体储罐和出水口整合成一个功能性网络。该系统必须将流体从水源输送到使用点，无需手动用桶运输。"
		"这是工厂的第一个真正流体基础设施。留出空间以便扩展，因为序列组装和未来配方可能依赖于填充。"
	]
	quest.1400000000000009.title: "一个真实的流体网络"
	quest.140000000000000A.quest_desc: [
		"物品存储库专为工业生产线设计，可与传送带、漏斗和滑槽配合使用。它们作为生产缓冲，在两个处理阶段之间储存物品。"
		"建造几个模块，观察它们如何连接。之后我们会用库存控制来防止机器在缓冲区已满时继续生产。"
	]
	quest.140000000000000A.title: "大规模存储系统"
	quest.140000000000000B.quest_desc: [
		"黄铜管道可以直接连接到传送带上，帮助更精确地分割、合并和分配物品流。它们能补充你已知的黄铜漏斗的用法。"
		"§6思考：§r使用可视化来观察分配模式，并测试至少一种线路分割。现在的目标是整理内部路线，而不仅仅是将所有东西沿一条传送带移动。"
	]
	quest.140000000000000B.title: "流动分裂与合并 (Split and Merge Flows)"
	quest.140000000000000C.quest_desc: [
		"Smart Chute 为垂直运输添加了过滤控制。当缓冲区接收多种物品类型，但只有一类需要继续输送到特定机器或输出时，它非常有用。"
		"将其行为与你已知的简易滑道进行比较。使用 JEI 查看当前配方，并在继续前配置过滤器。"
	]
	quest.140000000000000C.title: "过滤垂直下落"
	quest.140000000000000D.quest_desc: [
		"建造物流单元前，先准备一套黄铜漏斗。它们控制物品的输入和输出，并能通过过滤器决定哪些物品可以进入或离开传送带和物品栏。"
		"生产四个单位并保留用于后续设置。JEI会显示当前配方；很快你将用机械臂、隧道、滑道和缓冲器来组合这些组件。"
	]
	quest.140000000000000D.title: "待分发的硬件设备"
	quest.140000000000000E.quest_desc: [
		"上一章你已经见过机械臂了。现在生产两台，这样你就能把它当作工厂组件，而不是一个一次性演示品了。"
		"此分支的下一步，你将配置多个目的地，将这些手臂变为真正的分配器。若想查看输入输出点如何选择，请使用 Ponder。"
	]
	quest.140000000000000E.title: "用于细胞的机械臂"
	quest.140000000000000F.quest_desc: [
		"单个机械工匠可以教导机械师，但大型配方需要矩阵。收集八个机械工匠，在自动化配方输入前建立一个具体的装配基地。"
		"§bJEI:§r 检查合成台的配方，不要多做。之后，当你的工厂能负担得起时，该分支会要求更大的矩阵。"
	]
	quest.140000000000000F.title: "合成矩阵 (Crafter Matrix)"
	quest.1400000000000010.quest_desc: [
		"序列组装从一个基础物品开始，将其转变为不完整状态。在当前的标准精密机制配方中，金箔充当此角色；收集四张进行首次测试。"
		"建造前请检查 JEI，因为整合包配方可能会变。重要的经验是，在遵循中间物品前，先识别输入序列。"
	]
	quest.1400000000000010.title: "序列输入装置"
	quest.1400000000000011.quest_desc: [
		"部署者需要接收序列组装每次循环所消耗的材料。收集一些齿轮来供应生产线，并使用 JEI 确认当前配方所需的所有输入。"
		"在建造循环前准备好材料有助于你思考连续生产：每个部署器都需要自己的供应，而不是依赖玩家手持零件。"
	]
	quest.1400000000000011.title: "用于序列的齿轮序列的齿轮"
	quest.1400000000000012.quest_desc: [
		"部署器可以在序列组装中应用组件。这台机器从简单的玩家交互复制器，变成了可重复的制造链的一环。"
		"使用已正确配置的部署器，建造或模拟 JEI 所示的步骤。注意，不完整的物品会延续到下一个操作，而不会立即终止配方。"
	]
	quest.1400000000000012.title: "部署器在序列中"
	quest.1400000000000013.quest_desc: [
		"按下按钮也可用作序列组装步骤，但并非所有配方都需要，包括当前的精密机制配方。此分支为概念性且可选的。"
		"在 JEI 中查找整合包中是否包含 Pressing 的序列。如果此版本中没有，请检查 Ponder/JEI 的集成，并在理解机械压机的适用位置后确认。"
	]
	quest.1400000000000013.title: "正在按下序列中的按键"
	quest.1400000000000014.quest_desc: [
		"使用 Spout 填充也可以参与顺序组装。这很重要，因为自定义整合包配方可能将物品应用、压力和流体结合在同一生产链中。"
		"在 JEI 中查找使用 Filling 的当前序列。如果没有，请使用 Ponder 和 Sequenced Assembly 类别来理解步骤，再确认此可选分支。"
	]
	quest.1400000000000014.title: "填充序列中"
	quest.1400000000000015.quest_desc: [
		"一个序列可能需要不同部署器中的不同组件。收集大型齿轮来为另一个阶段提供补给，并在 JEI 中观察未完成物品如何通过应用器。"
		"不要记住固定的重复次数：此任务的重点是为循环准备足够的输入，以便无需在每次循环中都停止生产线。"
	]
	quest.1400000000000015.title: "为齿轮组增添更大的齿轮"
	quest.1400000000000016.quest_desc: [
		"推进序列组装，直到出现不完整精密机制。暂时移除一个单元以便任务检测，然后将其放回流程中。"
		"该物品清楚地展示了序列组装与普通配方有何不同：相同的中间产物会不断循环并接收操作，直到成为最终结果。"
	]
	quest.1400000000000016.title: "未完成物品 The Incomplete Item"
	quest.1400000000000017.quest_desc: [
		"精密机制是创造模式中的一个技术里程碑。它代表了你第一个真正序列化的生产流程，也是许多更高级机器和系统所必需的。"
		"使用 JEI 显示的序列组装来制作一个。不要锁定配方中的材料或循环次数：模组包配方是最终标准，而 Ponder 仅用于辅助可视化。"
	]
	quest.1400000000000017.title: "机械精密"
	quest.1400000000000018.quest_desc: [
		"制作一个精密机制证明了该序列有效。现在将其变为可重复的流水线：初始物品必须进入，接受所需操作，并按照配方要求多次返回起点，无需手动重新放置。"
		"规划部署器供应、不完整物品的返还、缓冲区和最终输出。JEI仍是配方和循环次数的来源；你的任务是让流程自我维持。"
	]
	quest.1400000000000018.title: "自动化精密机械装置"
	quest.1400000000000019.quest_desc: [
		"你已在创造1中自动化了铁板。现在，享受基础设施带来的好处：保持生产线运转，直到完成该任务所需的库存量。"
		"目标不是手动研磨64张，而是验证铁输入、运输、压制和输出能否维持足够的产量来供应未来配方。"
	]
	quest.1400000000000019.title: "批量放置的方块"
	quest.140000000000001A.quest_desc: [
		"在安山合金自动化分支中，你准备了一个可重复的流程。现在用这条生产线来建造工厂库存，而不是在材料耗尽时每次都返回逐个制作。"
		"任务只衡量最终产量。使用JEI显示的此建造流程进行生产，并注意哪个环节效率低下：喂食、混合/合成、运输或存储。"
	]
	quest.140000000000001A.title: "工厂规模下的合金锭产量"
	quest.140000000000001B.quest_desc: [
		"你的序列装配线应该已经可以无需持续干预地生产了。让它运行，直到你收集到所需的小库存，然后用这批库存来评估部署器、缓冲器和未完全物品返回机制是否能跟上。"
		"如果生产自行停止，不要将其视为失败：找出瓶颈，修复它，然后再扩大规模。当精密机制为更先进的技术提供动力时，这种做法将至关重要。"
	]
	quest.140000000000001B.title: "小批量中的精准操作"
	quest.140000000000001C.quest_desc: [
		"Threshold Switch（历史内部ID为stockpile_switch）会监控物品栏水平，并根据设定的阈值输出红石信号。当缓冲区满时，工厂会停止；当库存下降时，工厂会恢复运行。"
		"建造一个并使用 Ponder 来了解上下限。之后，我们将用它来控制真正的生产线，而不是让机器不必要的空转。"
	]
	quest.140000000000001C.title: "仅在需要时进行生产"
	quest.140000000000001D.quest_desc: [
		"智能观察者使用内部ID content_observer，用于在物流点检测物品或条件。当特定内容通过传送带、滑槽或物品栏时，可用于触发信号。"
		"此分支为可选。尝试一个简单的过滤器，并将其与阈值开关进行比较：一个观察内容或事件，另一个则关注库存水平。"
	]
	quest.140000000000001D.title: "查看内容物 Watch the Contents"
	quest.140000000000001E.quest_desc: [
		"使用阈值开关，根据缓冲区的存量来控制工厂的一部分。当达到你设定的限制时，生产线应停止或阻塞进料，当空间再次可用时恢复。"
		"你可以将红石与 Clutch、漏斗、智能滑道或其他合适的组件结合。重要的是，生产应响应存储器的状态。"
	]
	quest.140000000000001E.title: "库存控制"
	quest.140000000000001F.quest_desc: [
		"将至少两种处理形式整合到一条链中——压制、填充、部署、破碎/清洗，或其他当前配方支持的组合。明确定义原材料的入口、缓冲区的存放位置以及最终产品的出口。"
		"目标是消除各阶段之间的手动运输。还要注意一台机器是否比下一台生产得更快；这种不平衡正是缓冲区和流量控制存在的原因。"
	]
	quest.140000000000001F.title: "两个阶段，一条路线"
	quest.1400000000000020.quest_desc: [
		"你已超越机器集合，开始运营工厂。流体有专属网络，资源持续流动粉碎处理，机械臂分发材料，合成器接收原料，序列组装确保精密生产。"
		"确认前，先运行主线路几个周期，观察缓冲区、输入和输出是否能吸收速度差异。Create III 仅在工厂能重复生产时才算完成，而非所有方块都放置在地板上。"
	]
	quest.1400000000000020.title: "The Factory Is Producing"
	quest.1400000000000021.quest_desc: [
		"第一次填充操作证明了 Spout 有效。现在将流程改为一条小型连续线：物品应自动到达应用点，并在填充后继续流向输出。"
		"用储罐和泵为出料口供水，并用传送带、料仓、漏斗或其他合适的运输方式运送物品。目标是不手动补充流体或重新放置物品，完成多个循环。"
	]
	quest.1400000000000021.title: "持续填充"
	quest.1400000000000022.quest_desc: [
		"你已经了解 Crushing Wheels 并搭建了矿石处理链。现在移除玩家，让车轮自动进料，并将产物输送到 Washing 或 JEI 显示的下一个工序。"
		"包含清晰的输入、阶段间的运输和输出或缓冲。不要假设固定的产量；输出和概率属于整合包当前的配方。"
	]
	quest.1400000000000022.title: "未经干预的碾压 Crushing Without Intervention"
	quest.1400000000000023.quest_desc: [
		"自动化产线必须证明其能积累产品。让你的破碎产线运行，直到收集到 32 个 Crushed Raw Iron。"
		"这个量足以暴露瓶颈，又不会让任务变得枯燥。如果流程提前停止，请检查 Crushing Wheel 的输入、输出运输和可用缓冲空间。"
	]
	quest.1400000000000023.title: "Crushed Material 库存量"
	quest.1400000000000024.quest_desc: [
		"现在让机械臂作为分配器工作，而不仅仅是两点之间的运输器。配置一个输入和多个兼容的目的地，然后观察物品是如何被送达的。"
		"尝试不同的优先级和目的地已满的情况。目标是理解物流不仅意味着移动资源，还包括决定资源应去往何处。"
	]
	quest.1400000000000024.title: "一臂多用途，各显神通"
	quest.1400000000000025.quest_desc: [
		"建造一个小隔间，让缓冲器接收材料，再由机械臂将这些物品分配到两个或多个工作站或物品栏中。"
		"即使一个出口变慢，单元格也应保持有序。必要时使用 Vaults、Depots、Belts、Funnels 或库存作为缓冲区；在这个规模上，Arm 开始取代复杂的传送带系统。"
	]
	quest.1400000000000025.title: "一个物流单元 Logistics Cell"
	quest.1400000000000026.quest_desc: [
		"你已经用机械合成台制作了一个大型配方。现在自动化该矩阵的投料，并组织结果提取，这样相同的配方就能重复进行，无需手动添加每种材料。"
		"选择一个能真正体现Crafters价值的配方，并在JEI中查看所需材料。机械合成台仍是一种专用工具，不要试图将其用作通用自动合成解决方案。"
	]
	quest.1400000000000026.title: "系列合成任务书"
	quest.1400000000000027.quest_desc: [
		"安山合金仍然是许多创造组件的原材料。利用当前版本可用的流程，建立一个可重复的生产方法，而不是手动制作每一批。"
		"设计生产线前请先查看 JEI，因为配方可能随整合包更新而变化。整理好原料输入、工艺执行和成品提取流程，下一个库存任务将验证此自动化能否持续生产。"
	]
	quest.1400000000000027.title: "自动化安山合金工艺"
	quest.1400000000000028.quest_desc: [
		"你的产线已证明能持续产出精密机械。现在将库存提升至32单位，使该组件成为真正的工业资源，为更先进技术提供支持。"
		"目标不是手工合成三十二个。如果生产线仍需持续干预，请先修复喂食、不完整物品返回和Deployer的补货问题，再追求产量。"
	]
	quest.1400000000000028.title: "精密工程学 (Precision Engineering)"
	quest.1400000000000029.quest_desc: [
		"当工业生产线有三个清晰区域时，理解起来会更容易：原材料输入、吸收速度差异的缓冲区，以及产品输出。"
		"选择你现有的线路之一，围绕此原则进行重组。缓冲区不必很大，只需防止快速阶段因下一阶段仍在忙碌而立即停滞即可。"
	]
	quest.1400000000000029.title: "输入、缓冲和输出"
	quest.140000000000002A.quest_desc: [
		"当单个机器成为瓶颈时，提高整个网络的速度并非总是最佳方案。将一条流程拆分为两条等效的线路，再合并或存储其输出。"
		"使用隧道、漏斗、机械臂或其他你已知的物流方法。目标是体验并行处理，看看两台较慢的机器是否能比一台超负荷的机器更好地满足需求。"
	]
	quest.140000000000002A.title: "并行处理"
	quest.140000000000002B.quest_desc: [
		"现在将工厂视为一个完整系统。至少保持一条填充线、一条矿物处理线和一条生产/物流单元在数个周期内持续运行，无需频繁干预。"
		"调整缓冲、分配和输送，直到没有任何阶段因前一个阶段过快或输出无处可去而停止。此任务不要求最高速度，而是要求稳定、可理解的生产流程。"
	]
	quest.140000000000002B.title: "流畅运行，毫无瓶颈"
	quest.140000000000002C.quest_desc: [
		"自动化只有在能持续产出时才有价值。在手动放置 Spout 下方的每个物品之前，先让生产线持续运行，直到收集到 16 个蜂蜜瓶。"
		"使用储罐、泵和管道来保持流体可用，并组织输出，防止产品堵塞工作站。验证成功后，可以扩展更多缓冲区和填充点。"
	]
	quest.140000000000002C.title: "补充库存中"
	quest.140000000000002D.quest_desc: [
		"流体储罐是缓冲器：它们将流体供应速度与消耗速度解耦。在建造好首个功能性网络后，保留八个储罐以扩展存储或创建中间水库。"
		"并非所有系统都有唯一正确的规模。需要检查连接时，请使用 JEI 和 Ponder；重要的是要开始思考流程产能，而不仅仅是单个机器的运作。"
	]
	quest.140000000000002D.title: "流体缓冲器"
	quest.140000000000002E.quest_desc: [
		"一个出水管能教你流程；多个出水管能让你分离配方、建造并行生产线，或将某个工作站专门用于特定流体。制作四个出水管，让填充从演示变为工业产能。"
		"具体配方仍由JEI负责。此任务衡量的是可扩展的基础设施；一旦定义了标准链，具体的填充物配方便可关联到实际整合包配方。"
	]
	quest.140000000000002E.title: "更多填充点 (More Filling Points)"
	quest.140000000000002F.quest_desc: [
		"你已经证明了自动化粉碎可以积累材料。现在让生产线持续运行，直到收集到64个粉碎原铁，期间不要返回手动处理。"
		"这个规模足以验证喂食、输出和缓冲能否维持持续生产，但又不至于变得枯燥。之后，用 JEI 决定当前配置下哪个后续流程能带来最佳结果。"
	]
	quest.140000000000002F.title: "按比例进行碾压 Crushing at Scale"
	quest.1400000000000030.quest_desc: [
		"支撑铁板的压制逻辑也能用于其他生产线。生产一批32个铜板，让压模机成为材料处理站，而不仅仅是用于单一配方的机器。"
		"喂食前请检查 JEI，尤其是当整合包更改配方时。重点是复用自动化压制基础设施，并为未来组件保留有用的库存。"
	]
	quest.1400000000000030.title: "大量铜板（Copper Sheets in Bulk）"
	quest.1400000000000031.quest_desc: [
		"金箔会出现在更精密的组件和工艺中。使用你已掌握的压制基础设施生产16个单位。"
		"不必为黄金建造一整座工厂。带可选输入的产线或小批量自动化产线，就足以证明同一区域能按需制造不同材料。"
	]
	quest.1400000000000031.title: "批量获取金质薄片"
	quest.1400000000000032.quest_desc: [
		"首个精密机制验证了配方，上一批验证了自动化。现在收集16个单位，将此组件视为真正的工业库存。"
		"若达到16需要持续手动修正，请检查Deployer的喂食、不完整物品返回和缓冲区。可靠的Sequenced Assembly应能在你处理工厂其他部分时持续生产。"
	]
	quest.1400000000000032.title: "精密枪托"
	quest.1400000000000033.quest_desc: [
		"整理好输入、缓冲和输出后，保持物品仓库模块为新行做好准备。八个单元让你无需将每次扩展都变成新的合成过程，即可创建中间存储。"
		"缓冲器不仅能存储物品，还能吸收各阶段之间的速度差异。当一个机器批量生产而下一个工序较慢时，请使用此库存。"
	]
	quest.1400000000000033.title: "工厂缓冲器"
	quest.1400000000000034.quest_desc: [
		"你的物流单元已经证明了分发物品与单纯运输的不同。生产八个黄铜隧道，以便为 Belts 上的新分配器、平衡器和汇聚点准备足够的零件。"
		"需要回顾分配模式时，请使用 Ponder。此任务中的数量是建造库存，并非要求立即安装所有隧道。"
	]
	quest.1400000000000034.title: "大规模分发 (Distribution at Scale)"
	quest.1400000000000035.quest_desc: [
		"当多种材料共用缓冲区或垂直列，但每种输出只能接受特定集合时，智能滑槽会很有用。生产八个单位，使过滤后的垂直路线成为未来线路的常规部分。"
		"本模组不替代 Belts、Funnels 或 Mechanical Arms。Smart Chute 是一种紧凑型工具，适用于重力与过滤即可简化基础设施需求的情况。"
	]
	quest.1400000000000035.title: "批量过滤式垂直物流系统"
	quest.1400000000000036.quest_desc: [
		"配置多个目的地后，机械臂就不再是新奇玩意，而是成了分配工具。制作四个单元，这样你就不用拆解已工作的单元，也能建造独立的单元格。"
		"无需立即全部安装。现有库存可供未来线路在优先级、多目的地或更高效的物流需要时选用。"
	]
	quest.1400000000000036.title: "用于扩展的机械臂"
	quest.1400000000000037.quest_desc: [
		"自动化大型配方需要一个与配方模式大小匹配的机械合成器矩阵。收集16个合成器，这样你就不用拆解第一次的实验，也能自由建造更大的配方。"
		"先别做成通用自动合成。JEI显示大型或特殊配方时用机械合成器；其他技术会处理通用合成。"
	]
	quest.1400000000000037.title: "工业合成矩阵"
	quest.1400000000000038.quest_desc: [
		"并行处理只有在机器足够多、能分担负载时才有意义。收集四个 Crushing Wheels——足够组成两对——这样你将有硬件来测试两条生产线或复制一个真正的瓶颈。"
		"§bJEI:§r 查看当前齿轮的已安装配方。其理念是将并行处理的概念与具体的设备数量相结合，而无需强迫你复制整个工厂。"
	]
	quest.1400000000000038.title: "平行线的车轮 (Wheels for Parallel Lines)"
	quest.1400000000000039.quest_desc: [
		"你已经配置了阈值开关，可以根据库存停止和恢复生产。生产四个单位，以便将这一理念应用到多个工厂区。"
		"可重复的自动控制更有价值。在需要响应缓冲水平的地方使用开关，不必立即安装所有开关。"
	]
	quest.1400000000000039.title: "可重复的控制台命令"
	quest.140000000000003A.quest_desc: [
		"上一个里程碑证实了你的系统可以协同工作。现在要证明它们能带来成果：用你建造的线路，维持或补充 64 个铁板和 32 个精密机械的库存。"
		"这是一个生产目标，而非手动合成目标。如果你使用了组件导致库存下降，这是预料之中的；重要的是工厂能在不把你变回主机器的情况下重建它。"
	]
	quest.140000000000003A.title: "工厂送货上门"
	quest.1500000000000001.quest_desc: [
		"精密机制曾是Create的精密组件，现在它已成为本整合包独有组件——工业机制的原材料。"
		"此配方通过序列组装制作，始于精密机制，依次经过部署器、填充和压制步骤。 §bJEI:§r 查看已安装的配方以获取确切步骤，并使用 Ponder 来回顾机器。"
		"该组件将成为你的创造工厂与后续时代出现的多种技术之间的桥梁。"
	]
	quest.1500000000000001.title: "工业机械模组 (Industrial Mechanism)"
	quest.1500000000000002.quest_desc: [
		"生产一个单位可验证配方；工厂必须重复此过程。建造一条无需手动操作每一步即可制造工业机械的流水线。"
		"确保部署器供应、填充和压制流体，以及不完整物品的正确返回。无需追求最高速度：目标是使流程可重复。"
	]
	quest.1500000000000002.title: "工业机械生产流水线"
	quest.1500000000000003.quest_desc: [
		"保留八个工业机械。这少量的储备证明了产线的可持续性，并为引入其他模组的机器做好准备。"
		"数量刻意保持适中：我们希望证明工业能力，而不是让这一阶段变成枯燥的重复劳动。"
	]
	quest.1500000000000003.title: "为下一个时代预留的储备"
	quest.1500000000000004.quest_desc: [
		"红石链接使用物品配置的频率在两点间传输信号。制作一对，这样你既有发射器也有接收器。"
		"当红石线路需要穿过整个工厂，或多个区域需要共享同一命令时，它们会很有用。"
	]
	quest.1500000000000004.title: "无线红石电路"
	quest.1500000000000005.quest_desc: [
		"将两个红石链接配置为相同频率，并用其中一个远程触发装置。"
		"这是一个配置目标，所以仍然是一个勾选框。重点在于学习如何创建一个可重用的控制频道。"
	]
	quest.1500000000000005.title: "遥控器"
	quest.1500000000000006.quest_desc: [
		"打包机将一批物品转化为包裹，使其能够通过Create的现代物流系统进行运输。"
		"此整合包中，Packager 的配方已更改为使用工业时代的组件，包括 Precision Mechanism。 §bJEI:§r 使用配方查看器验证确切的当前配方材料。"
		"从现在开始，运输不再仅仅指在传送带上移动散装物品。"
	]
	quest.1500000000000006.title: "包装生产流程"
	quest.1500000000000007.quest_desc: [
		"Stock Link将物品栏连接到Create的物流网络。它是让其他方块能看到其中存储内容的组件。"
		"从小处着手：在工厂各处铺开之前，先建一个连接良好的存储区就足以了解系统了。"
	]
	quest.1500000000000007.title: "链接库存"
	quest.1500000000000008.quest_desc: [
		"将 Stock Link 连接到真实存储容器，并确认网络可以查询可用物品。"
		"此任务为勾选项，因 FTB Quests 无法检测网络配置。重要的是物品变为信息，而非仅满一箱。"
	]
	quest.1500000000000008.title: "一个能看到库存的网络"
	quest.1500000000000009.quest_desc: [
		"Stock Ticker 提供了一个用于查看和向物流网络请求物品的界面。"
		"它将多个相连的背包整合成一个更有序的供应系统，同时保持完全物理化和模块化。"
	]
	quest.1500000000000009.title: "库存面板"
	quest.150000000000000A.quest_desc: [
		"红石请求器可以通过红石信号和条件来触发物品请求。"
		"这使得工厂更接近真正的按需生产和供应：一个区域只有在真正需要时才能请求资源。"
	]
	quest.150000000000000A.title: "红石请求"
	quest.150000000000000B.quest_desc: [
		"配置一个红石请求器，从一个可用的库存网络中请求至少一种物品。"
		"放置方块还不够：必须请求物品离开存储并到达目的地。此行为无法自动检测，因此需要手动确认。"
	]
	quest.150000000000000B.title: "按需重新补给物品"
	quest.150000000000000C.quest_desc: [
		"重包装器会重组包裹，使物流流程与目的地和请求保持兼容。"
		"一旦工厂开始将包裹视为运输单元而非简单的物品堆栈，它就变得尤其有用。"
	]
	quest.150000000000000C.title: "重新整理后的数据包"
	quest.150000000000000D.quest_desc: [
		"包裹蛙港是专门用于收发包裹的站点。它能将请求网络与常规物品移动区分开来。"
		"可以把它看作一个物流码头：源头负责准备包裹，目的地则知道在哪里接收。"
	]
	quest.150000000000000D.title: "用于包裹的港口"
	quest.150000000000000E.quest_desc: [
		"工厂仪表可以显示物流相关的状态，有助于让大型系统更易于阅读。"
		"此分支为可选项，因为视觉监控能改善操作和诊断，但不是解锁下一时代的必需条件。"
	]
	quest.150000000000000E.title: "工厂指示器"
	quest.150000000000000F.quest_desc: [
		"传送带解决局部运输；轨道则打通各区域、建筑和遥远工厂间的运输。生产第一批铁轨。"
		"我们还没要建一条横跨大陆的铁路。三十二条轨道足以让你试验弯道、车站和第一条可运行的路段。"
	]
	quest.150000000000000F.title: "成长的轨道 (Tracks for Growth)"
	quest.1500000000000010.quest_desc: [
		"火车站是组装、控制和将火车整合到路线中的地点。"
		"组装火车前请先使用 Ponder：它能比单独的配方更清晰地解释轨道、转向架、粘合结构和车站之间的关系。"
	]
	quest.1500000000000010.title: "你的第一座车站"
	quest.1500000000000011.quest_desc: [
		"轨道信号机将铁路划分为多个区段，并在多列火车共享同一网络时组织交通。"
		"即使第一条路线只有一个火车，现在学习信号系统也能避免日后扩建时重建整个系统。"
	]
	quest.1500000000000011.title: "铁路信号系统"
	quest.1500000000000012.quest_desc: [
		"火车观察者能检测经过轨道某点的火车，并将铁路运行转化为红石信号。"
		"现阶段可选，但对车站、信号和到货货物触发的自动化很有用。"
	]
	quest.1500000000000012.title: "观看火车经过的景色，享受悠闲时光。"
	quest.1500000000000013.quest_desc: [
		"时刻表定义了列车自动运行的目的地和条件。它将手动驾驶的列车转变为可重复的路线。"
		"使用 Ponder 和日程表界面本身来了解目的地和条件。JEI 仍然是物品配方的参考。"
	]
	quest.1500000000000013.title: "日程与路线"
	quest.1500000000000014.quest_desc: [
		"建造一条功能性货运路线，结束这个时代：库存系统必须准备或请求资源，铁路路线必须在两点之间运输货物。"
		"没有唯一正确的建造方式。目标是要证明你的工厂能将本地供应和长途运输视为同一流程的一部分。"
		"基础设施就绪后，Create 工程与技术部分便可开始，无需放弃 Create：后续模组将建立在此工业基础之上。"
	]
	quest.1500000000000014.title: "工厂之间的物流运输 Logistics Between Factories"
	quest.1600000000000001.quest_desc: ["航空学已离开奥米茄。飞行进度现已直接平衡：早期可制作喷气背包，中后期可获得机械动力氢推进器和飞行增强器。"]
	quest.1600000000000001.title: "推进器时代"
	quest.1600000000000002.quest_desc: ["首个创造飞行阶段。机动性实用，但仍有限制。"]
	quest.1600000000000002.title: "铜制喷气背包"
	quest.1600000000000003.quest_desc: ["在接触到更强大的工业模型之前，先提升一个等级。"]
	quest.1600000000000003.title: "安山岩喷气背包"
	quest.1600000000000004.quest_desc: ["黄铜标志着高级创造移动性的开端。"]
	quest.1600000000000004.title: "黄铜喷气背包"
	quest.1600000000000005.quest_desc: ["最高级的创造喷射背包。它也是欧米茄推进核心配方的一部分。"]
	quest.1600000000000005.title: "下界合金喷气背包"
	quest.1600000000000006.quest_desc: ["Mekanism Power Only 的一个特例：该机器现在有基于 Create 的配方，可将水转化为喷气背包所需的氢气。"]
	quest.1600000000000006.title: "电解分离机"
	quest.1600000000000007.quest_desc: ["用水和能量为电解分离器供电。其氢气输出可以直接为Mekanism喷气背包加油。"]
	quest.1600000000000007.title: "氢气生产"
	quest.1600000000000008.quest_desc: ["Mekanism路线使用氢燃料，提供技术性飞行，而非永久性的创造模式飞行。"]
	quest.1600000000000008.title: "Mekanism 喷气背包"
	quest.1600000000000009.quest_desc: ["加固的喷气背包，是奥米茄推进系统进阶的重要部件。"]
	quest.1600000000000009.title: "装甲喷气背包"
	quest.160000000000000A.quest_desc: ["与末地探索和未来的欧米茄工程相关的高科技移动性。"]
	quest.160000000000000A.title: "HDPE 鞘翅"
	quest.160000000000000E.quest_desc: ["Mystical Agriculture 的飞行增强模块已重制。现在需要机械合成、觉醒超贵金属、下界之星、工业机制和 Mekanism 喷气背包。"]
	quest.160000000000000E.title: "创意飞行 — 现已加入终局内容"
	quest.1600000000000010.quest_desc: ["可选的Mekanism地面移动。Free Runners将返回，并提供基于Create的机械合成配方，使用钢、能量和工业机制。此任务不影响飞行进度。"]
	quest.1600000000000010.title: "自由奔跑者 — 可选的移动性模组"
	quest.1600000000000011.quest_desc: ["装甲自由跑者是为那些希望兼具机动性与防护，又不想将装备设为强制进阶条件的玩家提供的可选升级。"]
	quest.1600000000000011.title: "装甲自由奔跑者"
	quest.1600000000000014.quest_desc: ["你已掌握工业飞行线：制造喷气背包、生产氢气、制作Mekanism喷气背包和终局飞行增强器。自由跑者仍是可选的移动设备。"]
	quest.1600000000000014.title: "综合飞行线路"
	quest.1600000000000015.quest_desc: ["完成新的飞行进阶，解锁奥米茄计划的下一阶段和奥米茄推进核心。"]
	quest.1600000000000015.title: "天空的掌控者"
quest.1700000000000010.quest_desc: [
		"基础的AE2晶体。从中可以获得带电的切尔图斯石英、流质和硅。"
		"在野外收集一些吧。"
	]
	quest.1700000000000010.title: "Certus Quartz"
	quest.1700000000000011.quest_desc: [
