# AI 初翻，未人工校对
{
	chapter.42D8D6D8F074836C.title: "四季更迭 Through the Seasons"
	quest.045A84938748AB0E.quest_desc: ["除了种植作物，你还可以把花朵变成种子，开始一个大花园！记得种植当季的花朵，否则它们会长不好。"]
	quest.045A84938748AB0E.quest_subtitle: "你可以种植花朵了！"
	quest.045A84938748AB0E.title: "种植花朵"
	quest.04CD458783662E2C.quest_subtitle: "捕获 250 条鱼。"
	quest.04CD458783662E2C.title: "钓鱼大师"
	quest.053C629AAD01E2E8.quest_desc: ["酿造一瓶抗寒药水，以更好地抵御严寒。"]
	quest.053C629AAD01E2E8.quest_subtitle: "反正寒冷从来就没困扰过我。"
	quest.0A22FA9491142381.quest_desc: ["击杀末影龙。干得漂亮！"]
	quest.0A22FA9491142381.quest_subtitle: "祝你好运"
	quest.0A22FA9491142381.title: "解放末地"
	quest.0C5F2ACA4A524929.quest_desc: ["宝箱是钓鱼时可能遇到的稀有宝藏。里面会是什么呢？"]
	quest.0C5F2ACA4A524929.quest_subtitle: "钓鱼时钓上一个木箱。"
	quest.0C5F2ACA4A524929.title: "那不是鱼！"
	quest.0D900F0AED4AFBC7.quest_desc: ["在锻造台里将下界合金靴、龙之息和龙鱼组合起来，即可制作出龙鳍靴。"]
	quest.0D900F0AED4AFBC7.quest_subtitle: "二段跳！Double jumping!"
	quest.133F08D095876EE8.quest_desc: ["收集所有农作物。"]
	quest.133F08D095876EE8.quest_subtitle: "优秀的农民会种植各种各样的作物。"
	quest.133F08D095876EE8.title: "农场主大师"
	quest.169DCFF5304B1264.quest_desc: ["找到一个下界堡垒。"]
	quest.169DCFF5304B1264.quest_subtitle: "很危险！"
	quest.169DCFF5304B1264.title: "一座可怕的堡垒"
	quest.18D7A8528F8022CF.quest_desc: ["寻找并获取灵魂树苗。食用后可暂时缓解寒冷。"]
	quest.18D7A8528F8022CF.quest_subtitle: "随时随地，冷静下来！"
	quest.197EF939BA5FF9EC.quest_desc: ["获得一根钓鱼竿。当植物或动物等其他食物来源不可用时，钓鱼是获取可靠食物的好方法。"]
	quest.197EF939BA5FF9EC.quest_subtitle: "是时候去钓鱼了！"
	quest.197EF939BA5FF9EC.title: "钓鱼入门教程"
	quest.2A9D5BD70C537562.quest_desc: ["前往下界，这是通关游戏的关键一步。"]
	quest.2A9D5BD70C537562.quest_subtitle: "这里是不是太热了？"
	quest.2A9D5BD70C537562.title: "下界"
	quest.31772D9004A9A0FB.quest_desc: ["冰箱可用于冰冻放入其中的填充水袋。若在其上放置烟囱，它将冷却房间。"]
	quest.31772D9004A9A0FB.quest_subtitle: "炎炎夏日必备良品！"
	quest.319962C11CC4833F.quest_desc: ["制作一个热石，它能检测周围温度并根据温度高低输出信号。可用于自动化家居温控或制作其他基于热量的装置。"]
	quest.319962C11CC4833F.quest_subtitle: "带温度的红石！"
	quest.32D210C3C3AB6010.quest_desc: ["虽然可以为已制作的盔甲添加保暖层，但你也可以制作山羊皮盔甲来保持温暖。"]
	quest.32D210C3C3AB6010.quest_subtitle: "合成山羊皮盔甲！"
	quest.32D210C3C3AB6010.title: "山羊皮盔甲"
	quest.358D67F16D81DC44.quest_desc: ["制作一个水壶。装满水并使用后，能迅速调节玩家的体温。"]
	quest.358D67F16D81DC44.quest_subtitle: "就像水气球一样！"
	quest.35F95C9A540C078B.quest_subtitle: "捕获50条鱼。"
	quest.35F95C9A540C078B.title: "学徒垂钓者"
	quest.37243934BF65E2D8.quest_desc: ["钓鱼台可用于为鱼竿添加不同的鱼钩和鱼线，每种都有不同的用途。"]
	quest.37243934BF65E2D8.quest_subtitle: "给你的鱼竿补充能量吧！"
	quest.394E5493868E70AC.quest_desc: ["获取一个篝火，可以在寒冷地区用来为玩家取暖。篝火是前期调节温度的最便宜工具。虽然相当原始，但它能让你活下去。"]
	quest.394E5493868E70AC.quest_subtitle: "这是一个能帮助你度过冬天的基础工具。"
	quest.394E5493868E70AC.title: "寒冷退散！"
	quest.3BA8055A132C215C.quest_desc: ["获取一个壁炉。壁炉可以用煤炭和冰块等物品来点燃。用红石激活后，它能调节你家里的温度。"]
	quest.3BA8055A132C215C.quest_subtitle: "保证能缓解高温带来的不适！"
	quest.414869FEF4C49F0C.quest_desc: ["前往末地，这片最后的疆域。小心，这个维度非常寒冷。"]
	quest.414869FEF4C49F0C.quest_subtitle: "还是说，这是一个全新的开始？"
	quest.414869FEF4C49F0C.title: "The End"
	quest.43FD02195E8A9164.quest_desc: ["这本任务书会教你如何使用各个模组提供的各种功能。别把它当成玩整合包的步步教程，那很无聊。相反，把它当作一个在你卡住时能救你命的工具。祝玩得开心！"]
	quest.43FD02195E8A9164.quest_subtitle: "是时候开始行动了！"
	quest.43FD02195E8A9164.title: "四季更迭 Through the Seasons"
	quest.44C1F6BA6DBA8DEC.quest_desc: ["放下烹饪锅，开始准备美食吧！"]
	quest.44C1F6BA6DBA8DEC.quest_subtitle: "真美味！"
	quest.44C1F6BA6DBA8DEC.title: "晚餐准备好了！"
	quest.46979CFF9DC96A13.quest_desc: ["升级鱼竿是捕捉更优质鱼类和独特区域物品的必要步骤。"]
	quest.46979CFF9DC96A13.quest_subtitle: "一次巨大的升级！"
	quest.46979CFF9DC96A13.title: "钻石钓鱼竿"
	quest.4A265FC21FE6A97A.quest_desc: ["收集所有可种植的鲜花和花种！你真是园艺高手！"]
	quest.4A265FC21FE6A97A.quest_subtitle: "好多颜色！"
	quest.4A265FC21FE6A97A.title: "植物学家"
	quest.4AE39442C6823712.quest_desc: ["锅炉可以用来加热放入其中的装满水的皮囊。如果在上面安装烟囱，它还能温暖整个房间。"]
	quest.4AE39442C6823712.quest_subtitle: "别把手伸到里面去。"
	quest.4C38E8C7A18C2F78.quest_desc: ["除了给已制作的盔甲加附魔，你还可以制作变色龙鳞甲。这套盔甲会缓慢适应周围环境，根据居住地提供中等程度的保暖或保冷效果。在夏热冬寒的温带地区尤其实用。"]
	quest.4C38E8C7A18C2F78.quest_subtitle: "制作变色龙鳞片盔甲！"
	quest.4C38E8C7A18C2F78.title: "变色龙鳞片盔甲"
	quest.4CA883C1E63944CC.quest_subtitle: "捕获1000条鱼。"
	quest.4CA883C1E63944CC.title: "经验丰富的垂钓者"
	quest.5E61F83A67C41168.quest_desc: ["狩猎和采集无法全年持续。越早开始种田，生存就越容易！"]
	quest.5E61F83A67C41168.quest_subtitle: "总有一天，这里会是一片美丽的田野！"
	quest.5E61F83A67C41168.title: "一个肮脏的地方"
	quest.65E6820883C76D7F.quest_subtitle: "捕获 5000 条鱼。"
	quest.65E6820883C76D7F.title: "钓鱼大师"
	quest.661F180BC98267E5.quest_desc: ["获取一盏灵魂泉灯。在末地维度手持时，它会冷却周围区域。使用灵魂芽来为灯补充燃料。灵魂泉灯是在末地无需携带水瓶即可降温的便捷工具。"]
	quest.661F180BC98267E5.quest_subtitle: "在末地的灼热中生存下来。"
	quest.67C06A96DDA7C569.quest_desc: ["制作缝纫台，可用于为盔甲提供隔热层，并提高你对极端温度的抗性。你可以使用山羊毛、羊毛、皮革、猪灵皮和变色龙蜕皮来为盔甲隔热。"]
	quest.67C06A96DDA7C569.quest_subtitle: "在许多气候中，良好的隔热是生存所必需的。"
	quest.7194C26C2EAE8CDB.quest_desc: ["收集所有主世界树苗各一个。你可以在遍布各地的特殊宝箱中找到许多树苗。"]
	quest.7194C26C2EAE8CDB.quest_subtitle: "我代表树木们说话。"
	quest.7194C26C2EAE8CDB.title: "树木采集者"
	quest.76752A1205DC98B7.quest_desc: ["灵魂篝火是在炎热气候中让自己降温的原始方法。只需放置它，然后站在旁边即可！"]
	quest.76752A1205DC98B7.quest_subtitle: "避免过热，拯救自己！"
	quest.76752A1205DC98B7.title: "退散吧，炎热！"
	quest.767EAF428B073347.quest_desc: ["煎锅让你随时随地烹饪。靠近热源，然后用另一只手拿着食物！"]
	quest.767EAF428B073347.quest_subtitle: "随时随地烹饪美食！"
	quest.767EAF428B073347.title: "便携式烹饪 (Portable Cooking)"
	quest.7B71E794B1D275D5.quest_desc: ["成功熬过整整一年。"]
	quest.7B71E794B1D275D5.quest_subtitle: "其实也没那么糟糕嘛。"
	quest.7E3827A6D9B903A5.quest_subtitle: "捕获10条鱼。"
	quest.7E3827A6D9B903A5.title: "新手垂钓者"
