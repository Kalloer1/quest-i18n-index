			title: "迷失灵魂之城"
			x: -8.5d
			y: 3.5d
		}
		{
			dependencies: ["3D92CE26C8626116"]
			description: ["你真的能击败这个由潜声、灵魂和骨头构成的恐怖构造体吗？潜声守卫的心跳声在你脑海中回响，引诱你前往更深处、更黑暗的地方。你会接受它的召唤，夺取它的心脏吗？"]
			id: "6B8B2F8141026CBB"
			rewards: [
				{
					id: "658449A043848801"
					item: "deeperdarker:warden_carapace"
					type: "item"
				}
				{
					id: "004A98AC295F6CE2"
					item: "deeperdarker:warden_upgrade_smithing_template"
					type: "item"
				}
			]
			subtitle: "击杀一个坚守者。强烈建议穿戴下界合金装备。"
			tasks: [{
				advancement: "deeperdarker:main/kill_warden"
				criterion: ""
				id: "5C3C7673D31AB78F"
				title: "杀死一个坚守者并取走它的心脏"
				type: "advancement"
			}]
			title: "然而，它仍然奏效"
			x: -6.5d
			y: 3.5d
		}
		{
			dependencies: ["6B8B2F8141026CBB"]
			description: ["这场腐化带来的黑暗会令你迷失方向，陷入慌乱。若要深入异世界，最好是将敌人的力量为己所用。为此，你需要用从卫道士和幻象者处获得的材料、远古城市中的升级板和回响碎片，以及在锻造台用下界合金装备升级。"]
			id: "1ED480B2111FC572"
