	quest.45300F814DAE65A3.quest_subtitle: "使用砧板，将生鲑鱼切成生鲑鱼片！"
	quest.458F77D5647A05A9.quest_subtitle: "[\"\",\"可在\",{\"text\":\"末地\",\"color\":\"dark_purple\",\"clickEvent\":{\"action\":\"change_page\",\"value\":\"45D9C9CD7B2568A0\"},\"hoverEvent\":{\"action\":\"show_text\",\"contents\":[]}},\"中找到。\"]"
