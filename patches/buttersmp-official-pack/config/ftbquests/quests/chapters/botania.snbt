			}]
			x: 3.0d
			y: -2.0d
		}
		{
			dependencies: [
				"7DA61E5DA0904B92"
				"16131B1A63B856ED"
			]
			description: ["喝下米米尔之井的水并击败盖亚守护者，获得芬布尔特尔的符文石板后，你就可以进行符文仪式了。符文仪式用于制作一些终局物品。要进行仪式，先放置一个中央符文支架。接着，将符文支架放置在相应位置。然后，放置中心物品和所有符文。最后，投入仪式所需的物品，并用森林魔杖右键点击。仪式将消耗你身上的法力值来驱动。"]
			icon: "mythicbotany:fimbultyr_tablet"
			id: "2C18A5C565FED9B0"
			subtitle: "高级科技 (Advanced Technology)"
