		{
			dependencies: ["6F72C006752E8604"]
			description: ["远古工厂是Cataclysm模组中出现在主世界的地下城。里面住着机械Boss“先兆者”，战斗中会发射致命的激光和导弹。"]
			entity_vis_size: 1.0f
