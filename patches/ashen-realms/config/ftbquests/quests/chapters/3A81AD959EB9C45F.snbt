	quests: [
		{
			description: ["Cataclysm 是一款受《Minecraft Dungeons》启发的模组，在原版世界、下界和末地维度中引入了危险的地下城。每个结构都有独特的首领、敌对生物和珍贵战利品，为玩家提供强大的武器、盔甲和装备，提升游戏体验。"]
			entity_vis_size: 1.0f
			id: "6F72C006752E8604"
