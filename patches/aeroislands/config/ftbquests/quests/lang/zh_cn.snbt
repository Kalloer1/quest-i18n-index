# AI 初翻，未人工校对
{
	chapter.303ACF8AA44AF63B.title: "简单的开端"
	chapter.4C76DF4D9DC0515B.title: "简单的开端"
	chapter.6B9E1F65B277E82A.title: "¡Un comienzo sencillo!"
	chapter_group.6D2CEB7AF096474F.title: "教程 [ENG]"
	quest.01BDED4A85334CCB.quest_subtitle: "Busca un árbol cerca de ti, pero ten cuidado, ahora estos se caen al romper uno de sus troncos"
	quest.01BDED4A85334CCB.title: "木柴，用于度过夜晚"
	quest.069F5AC761AB2818.quest_desc: ["建造一个机械合成台，让机器帮你合成物品。你正式把Minecraft唯一要求你的工作外包出去了。"]
	quest.069F5AC761AB2818.title: "自动化合成，因为为什么不呢"
	quest.0A9B0C2ED3A270C1.quest_desc: ["将安山岩与铁或锌粒混合，可获得安山岩合金。这是用复杂机器完成简单任务的入门级操作。"]
	quest.0A9B0C2ED3A270C1.title: "欢迎来到创造模式"
	quest.13F9A339371A40C2.quest_desc: ["使用 Create Aeronautics 建造你的第一辆车。它不必能飞，不必能直线行驶，也不必结构坚固。它只需要动起来，最好是远离你即将引发的爆炸。"]
	quest.13F9A339371A40C2.title: "一个全新的世界正在等待着你去探索"
	quest.15B753C546686A01.quest_desc: ["找找附近的树，但要小心，打掉其中一个树干后，整棵树都会倒下。"]
	quest.15B753C546686A01.title: "今夜的事件日志记录如下："
	quest.15F9DCCAA1D3E99A.quest_desc: ["用钻石升级你的背包，显然普通的储物空间还不够炫酷。更多格子，更多升级，更多令人质疑的财务决策。"]
	quest.15F9DCCAA1D3E99A.title: "镶有钻石的储藏室"
	quest.1F6C138670BD2355.quest_desc: ["用钻石升级你的储物空间。它还是个箱子，但现在你可以在派对上炫耀了，前提是你的派对里有箱子。"]
	quest.1F6C138670BD2355.title: "一个值得炫耀的箱子"
	quest.223BF604EC2BEA6F.quest_desc: ["用书柜围绕附魔台，就像某种邪教仪式，就能解锁附魔的秘密。有趣的是，不需要蜡烛。"]
	quest.223BF604EC2BEA6F.title: "一点小小的魔法气息"
	quest.24169AB09A056D5A.quest_desc: ["给东西附个魔，祈祷随机数之神大发慈悲。有时你会得到锋利V，有时你的剑会被诅咒上丝绸之触。祝你好运。"]
	quest.24169AB09A056D5A.title: "赌博，但合法"
	quest.26D5BFCFCCCE1391.quest_desc: ["把水倒在岩浆上（或者反过来，我们不介意），然后挖点黑曜石。它闪闪发光，呈紫黑色，而且马上就要毁掉你镐子的耐久度。"]
	quest.26D5BFCFCCCE1391.title: "玻璃质且充满不祥之兆"
	quest.2B490E906C38EA87.quest_desc: ["你出生在一个完全由方块构成的世界，而不知为何，这已经变得正常了。点击对勾以确认你接受这一点。"]
	quest.2B490E906C38EA87.title: "简单的开端"
	quest.34402A9787C6FD58.quest_desc: ["将安山岩合金放在去皮的原木上，即可制作安山岩外壳。你的机器现在看起来更规整，而不是裸露的电线。"]
	quest.34402A9787C6FD58.title: "给你的机器穿上衣服"
	quest.3B82FEF5A4FAFC76.quest_desc: ["去“地下”找些铁矿石。它看起来像长了皮肤病的普通石头，但相信我，它很值钱。"]
	quest.3B82FEF5A4FAFC76.title: "挖掘闪闪发亮的矿石"
	quest.3C48AB2B68D40C94.quest_desc: ["喜欢平庸的话，普通剑就挺好。不如锻造一把铁质长剑，开始以更帅气的姿势挥舞吧。"]
	quest.3C48AB2B68D40C94.title: "升级后的穿刺棒，已升级"
	quest.46735403694056F3.quest_desc: ["你穿越了原木、岩浆、劫掠，还有至少一个存疑的工程决策。从这里开始，一切就是你的问题了。"]
	quest.46735403694056F3.title: "教程完成，祝你在外面好运"
	quest.478DB2BF3E398A82.quest_desc: ["用你闪亮的新熔炉熔炼铁矿石。烧点煤，尴尬地等待，假装自己懂冶金学。"]
	quest.478DB2BF3E398A82.title: "炽热的岩石"
	quest.49A16738AE270A77.quest_desc: ["铁坚固耐用，现实中只有一点放射性。给自己造把好镐子，别再给祖先丢脸了。"]
	quest.49A16738AE270A77.title: "重金属摇滚"
	quest.4AA00D0DDEC5184E.quest_desc: ["制作一些书架。你永远不会翻开其中一本书，但附魔台需要它们来营造 ✨ 氛围 ✨。"]
	quest.4AA00D0DDEC5184E.title: "没人会读的书籍系列，永远不会有人阅读"
	quest.5760284AD5F4EABE.quest_desc: ["从地牢宝箱或击败的 boss 处获取一件 Relic。没有合成配方，尽情享受探索带来的赌博般刺激。"]
	quest.5760284AD5F4EABE.title: "哥布林战利品成就已解锁"
	quest.595D8683F3CE7182.quest_desc: ["你的口袋是谎言，背包里全是永远用不到的原石。制作一个背包，开始负责任的囤货吧。"]
	quest.595D8683F3CE7182.title: "囤积者新手包"
	quest.5CD773CD738853F9.quest_desc: ["厌倦了像迷途游客一样漫无目的地游荡？将指南针、原木和四棵树苗组合起来，制作一个能为你寻找群系的工具，因为显然自己探索太费力气了。"]
	quest.5CD773CD738853F9.title: "GPS，但更糟糕的是"
	quest.5D7297B7D43BA1AD.quest_desc: ["在加热盆中混合铜和锌以获得黄铜。恭喜你，你的工厂刚刚获得了一次未经请求的晋升。"]
	quest.5D7297B7D43BA1AD.title: "高级调酒术 (Advanced Mixology)"
	quest.616CA60749D29DDD.quest_desc: ["挖点青金石。虽然现在没什么用，但等附魔台出现时，未来的你会感谢现在的你。"]
	quest.616CA60749D29DDD.title: "蓝色岩石，待会再用"
	quest.624F4E23A5EC0E6E.quest_desc: ["建造一台机械压机。它的作用是将锭子压成板，主要是为了让你能反复按同一个按钮，从而获得一种掌控感。"]
	quest.624F4E23A5EC0E6E.title: "专业地碾压各种东西"
	quest.6389B61AC44D3E98.quest_desc: ["击败半首领，例如唤魔者。它本质上只是一个自命不凡的普通生物，但如果你不小心，它还是会毁掉你的一天。"]
	quest.6389B61AC44D3E98.title: "用带有标题的物品来击打某物"
	quest.641C788613F72AC1.quest_desc: ["用8块原石摆成一个环形，你就发明了熔炉。恭喜你，现在你基本上就是个铁匠了。"]
	quest.641C788613F72AC1.title: "火箱 (Box of fire)"
	quest.648E7DD273EC645E.quest_desc: ["先合成木制镐来挖鹅卵石，再升级到石镐，别再假装木棍是挖矿工具了。"]
	quest.648E7DD273EC645E.title: "岩石底部"
	quest.676DA8B939D4FD71.quest_desc: ["用铁升级普通箱子，解锁更多格子和升级兼容性。它还是个箱子，但现在是个豪华箱子。"]
	quest.676DA8B939D4FD71.title: "一个更加努力工作的箱子"
	quest.68543F139D64C9F0.quest_desc: ["去探索一个建筑，找到一个遗迹。小心伪物，它们在吃掉你之前都长得像宝箱。"]
	quest.68543F139D64C9F0.title: "寻宝，但很糟糕地失败了"
	quest.6A3C2019F915AC3E.quest_desc: ["用铁锭包围你的背包，看着它的口袋比劣质工装裤还多。更多格子，更多升级，更多囤积。"]
	quest.6A3C2019F915AC3E.title: "稍微不那么尴尬的储物空间"
	quest.73CA105C8B31B298.quest_desc: ["锻造一把钻石太刀，解锁每次击中鸡时都想华丽旋转攻击的冲动。"]
	quest.73CA105C8B31B298.title: "动漫刀剑篇（Anime sword arc）"
	quest.75C761C8065DF64E.quest_desc: ["找些安山岩。它是游戏中最无聊的石头，却即将成为整个工业帝国的支柱。"]
	quest.75C761C8065DF64E.title: "灰色的岩石，伟大的梦想"
	quest.786CB375E90F4C6F.quest_desc: ["制作钻石镐，终于可以开采那些曾嘲笑你铁制工具的家伙了。黑曜石、远古残骸、敌人的自信——无一幸免。"]
	quest.786CB375E90F4C6F.title: "镐的挖掘性能达到顶峰"
	quest.78884E27A28D488F.quest_desc: ["深挖下去，躲开岩浆，找到一颗钻石。它不过是高压下的碳，却不知为何能驱动整个经济。"]
	quest.78884E27A28D488F.title: "闪闪发光的资本主义之石"
	task.001DB4B4CCAFE471.title: "寻找一件远古残骸"
	task.28100A2986631FF6.title: "教程已完成！"
	task.34168CB212474745.title: "击败一个半首领怪物"
	task.5221258C490DBBE0.title: "ENG"
	task.615E94B2CB57201E.title: "ESP"
	task.6E8C58A26131EA7F.title: "获得一件遗迹物品"
}
