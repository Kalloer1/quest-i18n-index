		tag: {
			Icon: "hostilenetworks:item/deep_learner"
		}
	}
	id: "177B62549E3C9F42"
	order_index: 4
	quest_links: [ ]
	quests: [
		{
			description: ["Hostile Neural Networks 是一款基于 Deep Mob Learning 的模组。它能让你训练数据模型和运行模拟，生成生物预测，从而获得生物掉落物。"]
			icon: "draconicevolution:mob_soul"
			id: "693A9414F2EE95D8"
			min_width: 310
			shape: "square"
			size: 1.0d
			tasks: [{
				id: "628355E3176079D8"
				type: "checkmark"
			}]
			title: "敌对神经网络 (Hostile Neural Networks)"
			x: 0.5d
			y: -5.0d
		}
		{
			dependencies: ["693A9414F2EE95D8"]
			description: [
				"本模组的基本单位是数据模型，一种包含实体信息的物品，可用于生成它们的掉落物。"
				""
				"要获得数据模型，你必须先制作数据模型框架，并将其用于目标实体以构建模型。模型创建后，你还需要对其进行训练。"
			]
			id: "74E8D7CBD9E3157D"
			min_width: 400
			tasks: [{
				id: "500FB14B57F4CF30"
				item: "hostilenetworks:deep_learner"
				type: "item"
			}]
			x: 0.5d
			y: -3.5d
		}
		{
			dependencies: ["131904442C9523F4"]
			description: [
				"模型达到基础或以上后，即可使用模拟舱运行模型模拟。模拟将始终生成通用预测，并可能根据模型准确性生成生物预测。"
				""
				"模型等级越高，精度越高，自我意识模式下可达99.5%。"
				""
				"运行模拟需要能量（取决于模型类型）和催化剂物品，通常是预测矩阵。"
			]
			id: "31D603B530071AB9"
			min_width: 320
			size: 1.0d
			tasks: [{
				id: "4D1E537791C85D7E"
				item: "hostilenetworks:loot_fabricator"
				type: "item"
			}]
			x: 0.5d
			y: 0.5d
		}
		{
			dependencies: ["74E8D7CBD9E3157D"]
			description: [
				"数据模型的训练可以通过两种方式完成，使用深度学习器或使用模拟室。"
				""
				"深度学习者允许你在其中存储几个数据模型，你收到的击杀将开始训练模型。"
				""
				"所有模型最初都处于故障状态，必须在深度学习中训练至基础水平。"
			]
			id: "131904442C9523F4"
			min_width: 320
			shape: "hexagon"
			size: 1.5d
			tasks: [{
				id: "6CCDD3914F8D99A4"
				item: "hostilenetworks:sim_chamber"
				type: "item"
			}]
			x: 0.5d
