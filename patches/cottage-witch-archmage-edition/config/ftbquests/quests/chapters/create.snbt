			]
		}
		{
			title: "获取竖井入口 (Getting the Shaft)"
			x: 0.5d
			y: -4.0d
			description: ["&bShafts&r 可用于传递 &arotational force&r，而 &bCogs&r 既能 &6convey and manipulate&r 该力。许多机器内置齿轮，需要外部 &bCog&r 来驱动。其他机器可连接到 &bShaft&r 或 &bCog&r 的侧面。"]
			dependencies: ["283B3A75443BDA35"]
			id: "1EB53FD55A3973BF"
			tasks: [{
				id: "1B282B1BFCD33D40"
