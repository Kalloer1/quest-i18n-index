# AI 初翻，未人工校对
{
	default_hide_dependency_lines: false
	default_quest_shape: ""
	filename: "create"
	group: "22A3BF16475BD44E"
	id: "3A242C3317043514"
	order_index: 0
	quest_links: [ ]
	quests: [
		{
			description: [
				"安山合金是你在机械创新之旅中的首个关键资源。由原始安山岩和铁粒或锌粒锻造而成，这种坚固的合金构成了创造模组中几乎所有机器和组件的骨架。其多功能性和耐用性使其成为转轴、齿轮和外壳的必备材料。"
				""
				"无论是驱动一个简单的磨石，还是建造一个复杂的自动化工厂，一切都要从这里开始。多备点吧——你需要比想象中更多的材料！"
				""
				"合成提示：配方无需特定形状——将2个安山岩与2个铁粒或2个锌粒组合。"
				""
				"用途：转轴、齿轮、部署器、机械皮带等。"
				""
				"提示：尽早用搅拌机自动化此配方，以节省大规模建造的时间。"
			]
			id: "607350A02BD95586"
			rewards: [
				{
					count: 4
					id: "718F18ACFF80EA83"
					item: "create:andesite_alloy"
					type: "item"
				}
				{
					count: 8
					id: "085D1DC0D01FD29C"
					item: "minecraft:iron_nugget"
					type: "item"
				}
				{
					id: "0E28E7A7825F7E22"
					item: "create:experience_nugget"
					type: "item"
				}
			]
			shape: "gear"
			size: 2.0d
			subtitle: "合成安山合金 (Crafting the Andesite Alloy)"
			tasks: [{
				consume_items: false
				id: "60D1CA5F901B704C"
				item: "create:andesite_alloy"
				type: "item"
			}]
			title: "创意的基础 (Foundation of Ingenuity)"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["4E4E9A2452B87ECA"]
			description: [
				"你已经准备好产生动能了——水车就是你获取被动能源的入口。它利用流动的水，为你的机器提供稳定且早期的旋转动力。"
				""
				"运作方式："
				"将水车放置在与竖井相邻的位置。然后用流动的水（非水源方块！）垂直于水车的桨叶方向包围它。每个水车都顺着水流方向旋转，并产生少量的旋转力。"
				""
				"合成方法："
				"使用以下材料在 3x3 合成网格中进行配方合成："
				"- 8x 木板"
				"- 1x 竖井"
				"用木板围住竖井以制作1x水车"
				""
				"提示：将水轮水平或垂直堆叠，共享转轴，即可用单一水流倍增发电量——非常适合紧凑型发电农场。"
			]
			id: "4F9A8BB0BECB36F5"
			rewards: [{
				count: 3
				id: "1C270A52FF62018A"
				item: "create:experience_nugget"
				type: "item"
			}]
			subtitle: "建造一台水车"
			tasks: [{
				consume_items: false
				id: "11F3E212F11A3C07"
				item: "create:water_wheel"
				type: "item"
			}]
			title: "扭转局势"
			x: 2.5d
			y: 1.0d
		}
		{
			dependencies: ["74D537C96D6F780D"]
			description: [
				"机械压机是塑造金属的强大工具——可将锭子压成板，或将物品压缩成更高效的形态。这台机器是制作电子管、黄铜片等组件的必备品。"
				""
				"它不是传统合成的。而是在游戏世界中建造的："
				""
				"组装方法："
				"1. 放置一个齿轮箱。"
				"2. 用 Press Head 右键点击它，将其安装在顶部。"
				"这样就能立即创建机械压机——无需扳手。"
				""
				"旋转提供动力后，当物品被放置在 Depot、Basin 或 Belt 下方时，压板会自动上下移动。"
				""
				"提示：机械压机消耗中等量的SU——确保你的电源能应付负荷，否则机器会停滞。"
			]
			id: "3D6F36C0D760E389"
			rewards: [{
				id: "7CD3C11881ED150D"
				item: "create:depot"
				type: "item"
			}]
			shape: "diamond"
			subtitle: "组装机械压力机"
			tasks: [{
