	quest.01CD67203B65B0ED.title: "钻头"
	quest.024338359C75CD80.title: "Latex"
	quest.032AC795543DE0AC.quest_desc: ["突袭期间，突变体内讧频繁……附带损伤也同样频繁。祈祷你不在交叉火力中"]
	quest.032AC795543DE0AC.quest_subtitle: "每过10天，突变体部队就会变得更强大。保持警惕"
	quest.142F9A56AA9733DD.quest_desc: [
		"无人知晓这一切的开端。有人归咎于一场失败的实验，也有人说是远古力量的苏醒。但可以肯定的是，世界已经破碎了。"
		""
		"烈日灼烧。酸雨腐蚀。狂风肆虐。而当风停息，致命的严寒随之而来。"
		""
		"人类靠着残垣断壁和科技苟活。但在这个破碎的世界里，隐藏着恢复平衡的关键——修复协议。"
		""
		"完成它，阻止元素的愤怒。"
		""
		"你的旅程现在开始。完成修复协议。修复世界！"
	]
	quest.142F9A56AA9733DD.title: "欢迎 - 破碎的天空模组包"
	quest.14B5D4A1521A62FE.quest_desc: ["磁铁总是很有用。选择适合你需求的磁铁，就看你自己的了"]
	quest.184375F02F6E1387.quest_desc: ["一个可以存放工具的实用腰带"]
	quest.184375F02F6E1387.quest_subtitle: "请检查你的按键绑定设置"
	quest.190D1C0437C4C8E7.quest_subtitle: "将冬日带回和平，将严寒带回平衡"
	quest.1D6539126D759B1F.quest_subtitle: "将骷髅从虚空中带回来的小瓶"
	quest.1E91D619AB39DC4C.quest_subtitle: "如果你需要更多强制加载的区块"
	quest.2375BA737D50B84F.quest_subtitle: "40 RF/t"
	quest.2728517166B6E3A3.title: "财富庇护所"
	quest.28F004172D1B5012.quest_subtitle: "享受你的10分钟自由时间吧"
	quest.2EEB5D5BF8BA2590.quest_desc: ["经稀有物质强化的精炼泥浆。可提供近乎完全的隐形效果，仅有轻微副作用"]
	quest.2FBABF029DCD1784.quest_desc: ["一系列小工具，让建造大型结构变得更容易！"]
	quest.344F7D7E7D781EC2.quest_subtitle: "80 RF/t"
	quest.361AD3B2063DF8F9.quest_desc: [
		"气候变得致命了。四种极端天气威胁正危及你："
		""
		"&o灼热的太阳、酸雨、狂风暴雨、&r还有&o刺骨的寒风&r——每种天气都会以不同的方式伤害你。"
		""
		"头盔能阻挡直接伤害，但会消耗耐久度而非你的生命值。"
		"没有防护，元素会迅速将你摧毁。"
		""
		"保持装备。保持生存。"
	]
	quest.361AD3B2063DF8F9.title: "恶劣天气系统 (Hostile Weather System)"
	quest.39467BCC0364F3ED.quest_subtitle: "唤醒苦力怕的爆炸精神"
	quest.3ACEF03C820697F8.title: "第一口呼吸"
	quest.3C018F69792DA825.title: "末影细胞"
	quest.41744E513D437FA6.quest_desc: [
		"气候的混乱扭曲了生命本身，创造出在废墟中繁衍的突变生物。只有你掌握着治愈的关键——恢复平衡的最后机会。"
		""
		"最好在你和外界之间留些材料；2/3可能不够，别忘了认领你的区块！"
		"&l相信我&r"
	]
	quest.436866B89343CCDF.quest_desc: ["一层特殊的泥浆覆盖着你，让你长时间对敌人近乎隐形……唯一的副作用是轻微的恶心感"]
	quest.50B0F6DC4D1D9E7F.quest_subtitle: "请求下一个外壳的配方"
	quest.515460E3759AFA39.quest_subtitle: "一瓶能洗净毒液、带来真雨的药水"
	quest.54DBBC18146EC2D2.quest_desc: [
