	quest.7E9E03274A88347D.title: "{atm9.quest.storage.stack1}"
	quest.7EEEEDD5FF31ACD3.quest_desc: ["&n&5智能滑道&r与滑道相同，但具有堆叠大小和过滤器等额外功能。"]
