	quest.58514FDE153FD971.quest_subtitle: "{atm9.quest.storage.subt.iron}"
	quest.58514FDE153FD971.title: "{atm9.quest.storage.iron}"
	quest.58D5BD3106BFD94A.quest_desc: ["{atm9.quest.farm.desc.cookbook}"]
	quest.58D5BD3106BFD94A.quest_subtitle: "{atm9.quest.farm.subt.cookbook}"
	quest.58D5BD3106BFD94A.title: "{atm9.quest.farm.cookbook}"
	quest.59A3081002F16C28.quest_desc: [
		"“啊啊，你好你好！你偶然发现了我的实用方块部分！”"
		"方块！没错，方块——非常有用。非常……方块化。你懂的。"
		""
		"反正呢，继续说正事："
		"今天我为你准备了这些东西，请查收："
		""
		"治疗师——唰！你的队伍焕然一新。"
		""
		"一台电脑——将珍贵的生物存储在数字虚空里。还算安全。"
		""
		"一些化石类的东西——骨头、岩石、古老的奥秘。非常科学。"
		""
		"与吉米古尔相关的怪奇物——嘎吱作响、阴森、略带诅咒。"
		""
		"……还有一座坟墓。"
		"我们不说关于坟墓的事。认真的。"
		"别碰它。别问。总之...别碰。"
		""
		"那么！想不想来点既好用又有点诡异的方块呢？"
	]
	quest.59A3081002F16C28.title: "有用的旧方块"
	quest.5A51E26D66D1273B.quest_desc: ["{atm9.quest.farm.desc.flax}"]
	quest.5A51E26D66D1273B.quest_subtitle: "{atm9.quest.farm.subt.flax}"
	quest.5A51E26D66D1273B.title: "{atm9.quest.farm.flax}"
	quest.5A94A2664BFDD7B9.quest_desc: ["{atm9.quest.storage.desc.basic}"]
	quest.5A94A2664BFDD7B9.title: "{atm9.quest.storage.basic}"
	quest.5AB8651FCB1E2F72.title: "{atm9.quest.SG.elytra}"
	quest.5B36DE3826F26963.quest_desc: ["&n&5Shafts&r 可以在不改变齿轮转速的情况下传递旋转动力。"]
	quest.5DC892BA79EB52EC.quest_desc: ["可以将&n&5Mixer&r与Basin结合使用来进行合成。"]
	quest.5DED4197DB2EEBBC.quest_desc: [
		"“啊啊，种子和……别的东西！”"
		"每种一个——只有一个。为什么？因为它们太稀有、太珍贵、太传奇了。我还有几个红色的——而那些？那可是最稀有的稀有品。"
		"相信我说的话。"
		"或者……相信告诉我的那个人。不管怎样，这都是非常私密的物品。"
		""
		"现在这边，我拿到了这些种子——这辈子都没种过东西。卷心菜和小麦，看样子。从来没听说过。"
		"我本人只吃生菜和水，这样灵魂才能保持轻盈。"
		""
		"不过，这确实很自然。完全环保，没毛病。"
		"我基本上就是在拯救地球。不客气。"
	]
	quest.5DED4197DB2EEBBC.title: "种子和其他东西"
	quest.5E4BC0F59C90433A.quest_desc: ["{atm9.quest.storage.desc.chest}"]
	quest.5E4BC0F59C90433A.quest_subtitle: "{atm9.quest.storage.subt.chest}"
	quest.5E4BC0F59C90433A.title: "{atm9.quest.storage.chest}"
	quest.5E4FE420B6D2C97F.quest_subtitle: "{atm9.quest.storage.subt.Acompacting}"
	quest.5E4FE420B6D2C97F.title: "{atm9.quest.storage.Acompacting}"
	quest.5EB36B3477BC9C64.quest_desc: [
		"啊，是的……这些沾满灰尘的小骨头——\""
		"呃，我的意思是……前朝的考古杰作！是啊，是啊，非常稀有，很有历史价值。在地下深处发现的——也可能就在我地毯底下，谁知道呢？"
		""
		"总之……想要一个吗？很便宜的。简直白送一样。"
		"（不过别问太多问题比较好。）"
	]
	quest.5EB36B3477BC9C64.title: "我想是布满灰尘的岩石……"
	quest.5EBCFDDB3D74F000.quest_desc: ["&c目前该物品没有任何用途。"]
	quest.5EE53C2C83F73244.quest_desc: [
		"要制作&n&5暗影钢&r，只需将一种或多种&n&5色相化合物&r投入虚空即可。"
		""
		"它会被转换并悬浮回升。强烈建议使用磁铁！"
	]
