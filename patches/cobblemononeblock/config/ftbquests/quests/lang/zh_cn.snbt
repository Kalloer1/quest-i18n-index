	quest.508A8366219175FE.quest_desc: ["{atm9.quest.storage.desc.configurator}"]
	quest.508A8366219175FE.title: "{atm9.quest.storage.configurator}"
	quest.51EA6B1452883AB2.quest_desc: ["&n&5线性底盘&r的用法与&n&5强力胶水&r类似。它无需胶水即可将方块连接成一条直线。"]
	quest.52672B7FFFD51D16.quest_subtitle: "{atm9.quest.storage.subt.stonecutting}"
	quest.52672B7FFFD51D16.title: "{atm9.quest.storage.stonecutting}"
	quest.5291C74CE21F2622.quest_desc: ["这个任务系列将带你了解烹饪的基础知识，并开始制作你的第一颗稀有糖果！"]
	quest.5291C74CE21F2622.title: "烹饪书籍"
	quest.529341319CA7AF2F.quest_desc: ["铁匠铺方块内包含一个完整的铁匠铺。它每四分钟产出一个铁傀儡，平均每分钟约一个铁锭。"]
	quest.52CDB46F6CBF007B.title: "{atm9.quest.SG.shovel}"
	quest.52D8D124CCC5EE39.quest_desc: ["要制作&n&5Chromatic Compound&r，将所有配方投入&n&5Basin&r，并用&n&5Blaze Cake&r为&n&5Super-Heat&r的&n&5Blaze Burner&r提供燃料。"]
	quest.52EB902E76829EBB.quest_subtitle: "{atm9.quest.SG.subt.SG}"
	quest.52EB902E76829EBB.title: "{atm9.quest.SG.SG}"
	quest.53F861876B991C36.quest_subtitle: "{atm9.quest.storage.subt.jukebox}"
	quest.53F861876B991C36.title: "{atm9.quest.storage.jukebox}"
	quest.54288F6026AB4C34.quest_desc: [
		"“哦？这是什么……？”"
		"快看这些闪闪发光的石头！是不是很壮观？闪闪发光。每一块都是。每一块都闪闪发光。"
		"……总之，别看得太仔细。保持距离欣赏最好，明白吗？"
	]
	quest.54288F6026AB4C34.title: "稀有闪亮矿石"
	quest.54EA80F374440D7C.quest_desc: ["{atm9.quest.storage.desc.scanner}"]
	quest.54EA80F374440D7C.quest_subtitle: "{atm9.quest.storage.subt.scanner}"
	quest.54EA80F374440D7C.title: "{atm9.quest.storage.scanner}"
	quest.54EC1C7FC1DA9107.quest_desc: [
		"当没有红石信号时，&n&5可调链传动&r的工作原理与普通的链传动相似。"
		""
		"当红石信号作用于接收旋转力的方块时，它将使相连的链式传动速度加倍。"
		""
		"当红石信号施加在非旋转力接收方块上时，相连的连锁传动速度将减半。"
	]
	quest.550BC38EA1D44C2B.quest_desc: [
		"“啊啊，你好呀，旅行者……”"
		"大多数人叫我商人——但我个人更喜欢用企业家这个词。听起来更顺耳，不是吗？"
		""
		"好了，言归正传。我有个小癖好……遗物硬币。辉煌、闪亮、古老！我超爱，也超需要。幸运的是，我这儿有货。奇怪的货，稀有的货。魔法的？也许。被诅咒的？谁知道呢。"
		""
		"你可以在这里花费宝贵的遗迹硬币。但友情提示："
		"你并不一定能得到你想要的东西。"
		"你可能会得到完全不同的东西。"
		"你可能会一无所获，完全得不到任何东西。"
		""
		"概不退款。禁止抱怨。不许反悔。"
		"自己想办法解决吧。"
		""
		"那么……想试试运气吗？"
	]
	quest.550BC38EA1D44C2B.title: "这到底是谁……"
	quest.5611C20E8B58448B.quest_desc: ["{atm9.quest.storage.desc.filter}"]
	quest.5611C20E8B58448B.title: "{atm9.quest.storage.rf_filter}"
	quest.561833E63459CDFC.quest_desc: ["你可以用锤子将方块粉碎成其他材料——例如，将鹅卵石粉碎成砾石，将砾石粉碎成沙子，将沙子粉碎成沙粉。锤子越好，使用寿命越长。"]
	quest.56194F5EEDAE9181.quest_desc: ["转换器会将村民转化为僵尸村民，然后再治愈他们，让放置该方块的玩家能从治愈后的村民那里获得更好的交易。此过程需要金苹果、任意类型的虚弱药水以及待转化的村民，大约需要五分钟。"]
	quest.563CFA1EF74E52E9.quest_desc: ["{atm9.quest.storage.desc.sophisticated}"]
	quest.563CFA1EF74E52E9.quest_subtitle: "{atm9.quest.storage.subt.sophisticated}"
	quest.563CFA1EF74E52E9.title: "{atm9.quest.storage.sophisticated}"
	quest.56B80A7EBFE21428.title: "{atm9.quest.storage.APU}"
	quest.57A7A5C79389A96A.quest_desc: [
		"&5&l欢迎来到创造模式！"
		""
		"Create 是一款沉浸式科技模组，将真实感提升到了全新的维度！"
		""
		"如果对任何方块或物品有疑问，按住 W 键思考，就能看到超棒的 3D 游戏内维基！"
	]
	quest.57CF8C6C867B9BDA.title: "{atm9.quest.storage.Afilter}"
	quest.58495CFBF4F20CE9.quest_desc: ["{atm9.quest.farm.desc.cabinet}"]
	quest.58495CFBF4F20CE9.quest_subtitle: "{atm9.quest.farm.subt.cabinet}"
	quest.58495CFBF4F20CE9.title: "{atm9.quest.farm.cabinet}"
