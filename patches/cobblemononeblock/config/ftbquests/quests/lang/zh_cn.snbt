	quest.09936F8FCEA72C5C.quest_desc: [
		"&n&5轨道组装器&r可以放置在轨道上。如果在组装器上建造了东西，当组装器接收到红石信号时，矿车就会将其拾取。"
		""
		"方块必须粘合在一起，需要旋转力的方块将自动开始工作。"
		""
		"要“卸载”矿车上的方块，只需关闭红石信号，让矿车驶过即可。"
	]
	quest.0A1C2A7A8617D3E4.quest_subtitle: "{atm9.quest.farm.subt.wheat}"
	quest.0A1C2A7A8617D3E4.title: "{atm9.quest.farm.wheat}"
	quest.0AB80C0705795BE0.title: "史诗级"
	quest.0AC803ACD9A7FF2A.quest_desc: ["“蚕会寄生在叶子上，一旦寄生蔓延，用你的曲柄镰刀打破叶子就能获得线。线是推进进度所必需的，所以不要跳过这一步。幸运的是，这些小虫子干活很快，你不用等太久。”"]
	quest.0CF69DBA9573A7B3.quest_desc: [
		"蓝图工作台会将结构读取到/写入你的蓝图中。"
		""
		"你可以用它来复制建筑，或者与他人分享建筑！"
	]
