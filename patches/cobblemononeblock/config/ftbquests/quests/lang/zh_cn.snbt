	quest.481CF947907E8B60.quest_desc: [
		"手持空手，Shift + 右键点击地面即可挖掘鹅卵石。"
		""
		"泥土或草地上，你可以找到以下鹅卵石："
		""
		"安山岩"
		""
		"方解石"
		""
		"深层板岩"
		""
		"Diorite"
		""
		"滴水石锥"
		""
		"花岗岩"
		""
		"石头"
		""
		"Tuff"
		""
		"从下界岩中，你可以找到以下鹅卵石："
		""
		"下界岩"
		""
		"玄武岩"
		""
		"黑石"
	]
