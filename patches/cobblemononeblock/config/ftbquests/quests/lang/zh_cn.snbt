	quest.2BB3DB19D5EFC7E2.quest_desc: ["如果施加红石信号，&n&5Clutch&r将停止任何旋转。"]
	quest.2BE905EFBD5E7D7F.quest_desc: [
		"在这个整合包里，泥土非常重要。"
		"不过，获取泥土的过程可能相当繁琐。为此，将泥土和两块原石结合，可以返还4块泥土。这意味着现在有一种理论上可再生的获取泥土的方法——当然，前提是你有足够的原石。"
	]
	quest.2BF119DD5D977409.title: "{atm9.quest.SG.tier2SGC}"
	quest.2D41B04C75FA02BC.quest_desc: ["&n&5Press&r 可用于制作金属板或金属块。"]
	quest.2E9C035EEE7E5C34.quest_desc: ["{atm9.quest.farm.desc.animals}"]
