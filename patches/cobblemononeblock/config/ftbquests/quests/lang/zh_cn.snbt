	quest.71AF2ECEAA04FF10.quest_desc: [
		"这个指南针现在能帮你找到生物群系了。"
		"这有什么用？嗯，即使在这个单方块世界，生物群系仍然存在——只是没有 Cobblmon 可以刷出的天然方块。这部分要靠你了。但至少有了这个指南针，你就知道该去哪儿了。"
	]
	quest.71B1B53A03A16296.quest_desc: [
		"&n&5便携式接口&r需要成对使用。一个放置在世界中，另一个则放在矿车等移动实体上。"
		""
		"当两个接口相对时，它们会连接起来并在彼此之间传输液体。"
	]
	quest.72717D1135486D7F.quest_desc: ["{atm9.quest.farm.desc.grass}"]
	quest.72717D1135486D7F.quest_subtitle: "{atm9.quest.farm.subt.grass}"
	quest.72717D1135486D7F.title: "{atm9.quest.farm.grass}"
	quest.72DCE154E1714890.quest_desc: ["&n&5锯木机&r会收割前方的树木。它也可以用作锯木厂。如果它有相连的储物箱，物品会储存在里面。"]
	quest.734D36B8B34B9D8C.title: "Thermal \"烹饪\""
	quest.73B8A70240E6070E.quest_desc: ["{atm9.quest.farm.desc.milk}"]
	quest.73B8A70240E6070E.quest_subtitle: "{atm9.quest.farm.subt.milk}"
	quest.73B8A70240E6070E.title: "{atm9.quest.farm.milk}"
	quest.74FA25B2E087BEC4.title: "{atm9.quest.SG.ring}"
	quest.75B14A09FE39EDDA.quest_desc: ["&n&5Gantry Carriage&r可以安装在Gantry Shafts上，当Shaft旋转时，它会沿着Shaft移动。"]
	quest.75CBB5BD8C1DFEA1.quest_desc: ["&n&5Basin&r 用于配方，主要包括 &n&5Mechanical Press&r 和 &n&5Mechanical Mixer&r。"]
	quest.7649D648A3688D4A.quest_desc: ["{atm9.quest.storage.desc.puller}"]
	quest.7649D648A3688D4A.title: "{atm9.quest.storage.puller}"
	quest.766C80E5D7B7A916.title: "{atm9.quest.SG.pick}"
	quest.76A1B686E2D5E1CA.quest_desc: [
		"这个模组能让你把那些笨重的cobble gens压缩成一个方块。"
		"最有效率的设置是使用漏斗将鹅卵石提取到某种存储方块中。"
	]
	quest.76CBFA38D021AC95.quest_desc: ["与 &n&5Radial Chassis&r 结合，可创建一个应力承受能力极强的强力风车。"]
	quest.77382D4114E901CB.quest_desc: ["&n&5Hose Pulley&r 是一种可以抽取或放置液体到世界中的泵。"]
	quest.77F241BEE9902751.quest_desc: ["{atm9.quest.storage.desc.netherite}"]
	quest.77F241BEE9902751.quest_subtitle: "{atm9.quest.storage.subt.netherite}"
	quest.77F241BEE9902751.title: "{atm9.quest.storage.netherite}"
	quest.7840C2F15874622B.quest_desc: ["{atm9.quest.storage.desc.module4}"]
	quest.7840C2F15874622B.title: "{atm9.quest.storage.module4}"
	quest.785951190FFDAA21.title: "{atm9.quest.storage.stack2}"
	quest.7860FD3D3273351F.quest_subtitle: "{atm9.quest.SG.subt.book}"
	quest.7860FD3D3273351F.title: "{atm9.quest.SG.book}"
	quest.78656C89EEE80DB5.quest_desc: ["&n&5隧道&r可以放置在传送带上，它们会过滤通过的物品。将多个隧道并排放置即可相互连接。"]
	quest.78C112170E17FBF4.title: "{atm9.quest.SG.shield}"
	quest.78E51D22C16C4686.quest_desc: ["{atm9.quest.storage.desc.storage_tool}"]
	quest.78E51D22C16C4686.title: "{atm9.quest.storage.storage_tool}"
	quest.7937585519D9159F.quest_desc: ["你可以吃掉它们，但是……（buttt.....）"]
	quest.7AE3C8134F5ED726.title: "{atm9.quest.storage.stack4}"
	quest.7AF5DECAEC4C8324.quest_desc: ["这可以用来制作熔岩土。首先，你需要一个火源——比如篝火、火把，甚至是岩浆。将鹅卵石放入火源中，等待岩浆形成。准备好后，你可以用任何类型的桶来收集它。"]
	quest.7B25AFFD8C770A6C.quest_desc: ["自动交易机的工作方式与交易台完全相同，只是它能自动为你进行交易。你也可以用漏斗自动放入和取出物品。"]
	quest.7B690431CF1B87D0.title: "{atm9.quest.SG.template}"
	quest.7C07D6A33F7ADB02.quest_desc: [
		"所以我们得到了一个背包升级，可以把你的背包放进你的背包里。"
		""
		"这样当你的背包需要出现在背包里时，你的背包就能出现在背包里。"
	]
	quest.7C07D6A33F7ADB02.quest_subtitle: "{atm9.quest.storage.subt.inception}"
	quest.7C07D6A33F7ADB02.title: "{atm9.quest.storage.inception}"
	quest.7C3D763CF22D167A.quest_desc: ["{atm9.quest.SG.desc.starlight_charger}"]
	quest.7C3D763CF22D167A.quest_subtitle: "{atm9.quest.SG.subt.starlight_charger}"
	quest.7C3D763CF22D167A.title: "{atm9.quest.SG.starlight_charger}"
	quest.7C8CDD259495A31A.quest_desc: ["&n&5隧道&r可以放置在传送带上，它们会过滤通过的物品。将多个隧道并排放置即可相互连接。"]
	quest.7D67058592EE5958.quest_desc: ["大炮将根据蓝图建造结构，从附近的箱子里取材，并使用火药作为燃料。"]
	quest.7D690A7D0FF6E328.title: "{atm9.quest.SG.tier3GC}"
	quest.7DCFD0A363C2A834.quest_desc: ["若在该方块两侧放置水和岩浆，它便会从顶部向有效物品栏中吐出原石。方块等级越高，原石生成速度越快。"]
	quest.7E13007340A818C5.quest_desc: ["{atm9.quest.SG.desc.tier1SGCPC}"]
	quest.7E13007340A818C5.title: "{atm9.quest.SG.tier1SGCPC}"
