	quest.43021923E220CF68.title: "{atm9.quest.farm.farming}"
	quest.43CA08A75364B9F9.title: "不常见"
	quest.448D53BFFEEFF4F4.quest_desc: ["用钩爪从树叶上收集蚕。记得用Ultimine配合使用，能节省不少时间和精力"]
	quest.45268A619787288F.title: "{atm9.quest.storage.diamondBP}"
	quest.459BA85E48B343AE.quest_desc: ["&n&5径向底盘&r的用法与&n&5强力胶水&r类似。它可以将方块沿直线或侧面连接，无需胶水。"]
	quest.45EC31812FB9934D.quest_desc: ["&n&5机械活塞&r与活塞类似，可以推动方块，但你可以添加任意数量的延长杆。"]
