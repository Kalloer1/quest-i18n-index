	quest.122FBF5110E4CFF2.quest_desc: ["{atm9.quest.storage.desc.downgrade}"]
	quest.122FBF5110E4CFF2.title: "{atm9.quest.storage.downgrade}"
	quest.12417572054691BE.quest_desc: [
		"闪光物品——我们都爱它们！"
		""
		"闪光宝可梦很受欢迎，但它们极难找到。因此，在本整合包中，我决定加入一个有趣的改动：每个“生物环星期一”，闪光率将提升至正常值的两倍！"
		""
		"基础闪光概率也从原来的 1/8192 调整为 1/4096，整体更合理。这项改动旨在让闪光狩猎更有趣，同时不消除挑战性。"
		""
		"为什么要改？旧概率太高了，我个人更喜欢稍微慷慨一点的系统。祝狩猎愉快，愿你的周一格外闪亮！"
	]
	quest.12E5930AE01189AE.quest_desc: ["在熔炉中烹饪它才能使用"]
	quest.1310C1E14C259807.quest_desc: ["{atm9.quest.storage.desc.framed}"]
	quest.1310C1E14C259807.title: "{atm9.quest.storage.framed}"
	quest.134BC365E77C6DB8.quest_desc: [
		"&n&5便携式接口&r需要成对使用。一个放置在世界中，另一个则放在矿车等移动实体上。"
		""
		"当两个接口相对时，它们会连接起来并在彼此之间传输物品。"
	]
	quest.139BBD408DFF5E8C.title: "厨房"
	quest.13AEBC331F29BC3D.quest_desc: [
		"&n&5传送带&r可以放置在两个&n&5转轴&r之间，用于传输生物/物品，或将旋转能量从一个点传递到另一个点。"
		""
		"&n&5Shafts&r 必须相互呈 45、90 或 180 度的夹角。"
	]
