	quest.1E9B2D814F50A265.quest_desc: [
		"&n&5Encased Fan&r有多种用途。如果将其放置在熔岩等热源上方，可以产生少量的旋转能量。"
		""
		"旋转它还可以用来推拉物品和实体。箭头会显示朝向，旋转方向决定是推还是拉。"
	]
	quest.1F114EB0AAB86DB4.quest_desc: ["{atm9.quest.farm.desc.market}"]
	quest.1F114EB0AAB86DB4.quest_subtitle: "{atm9.quest.farm.subt.market}"
	quest.1F114EB0AAB86DB4.title: "{atm9.quest.farm.market}"
	quest.1F58AA51814C7568.quest_desc: ["&n&5强力胶水&r可用于将方块相互粘合，以便用活塞或其他方法移动它们。"]
	quest.1FE052F643401232.quest_desc: ["{atm9.quest.storage.desc.upgrade_base}"]
	quest.1FE052F643401232.quest_subtitle: "{atm9.quest.storage.subt.upgrade_base}"
	quest.1FE052F643401232.title: "{atm9.quest.storage.upgrade_base}"
	quest.1FE17B1C7C639F88.quest_desc: ["{atm9.quest.storage.desc.s_controller}"]
	quest.1FE17B1C7C639F88.title: "{atm9.quest.storage.s_controller}"
	quest.1FE5EC7B77697E1F.quest_desc: [
		"“好的，好的——手持物品！我想应该是这么叫的。”"
		"我的意思是，仔细想想……宝可梦能装下任何东西，对吧？但这不是重点。"
		""
		"重点在于——我这儿有最顶尖的货色。嗯……虽然不是全部，但大部分是。可能吧。反正都是好货，真不错。"
		"这些宝贝能让宝可梦在战斗中产生特殊效果——真正的战术道具。可能改变游戏规则。绝对神秘莫测。"
		""
		"带上这副怪模怪样的眼镜——不知道有啥用，但看起来超酷的。"
		"这把黑伞？很不祥。很能保护人。可能和下雨有关。"
		"还有我找到的这怪墨水？我的意思是……咳咳……能改变字体的墨水，嗯。绝对是真的。非常实验性的。超级稀有。"
		""
		"那么——你想要力量？格调？还是一点小小的困惑？"
		"抓到你了。"
	]
	quest.1FE5EC7B77697E1F.title: "需要持有的物品"
	quest.2098D8BFADB55D2A.title: "{atm9.quest.SG.lining}"
	quest.21234BB40DB05C78.title: "{atm9.quest.SG.bracelet}"
	quest.21CF93BDCE7BA2F9.quest_desc: [
		"要制作&n&5Refined Radiance&r，只需将一种或多种&n&5Chromatic Compound&r投入激活的&n&5Beacon&r光束中即可。"
		""
		"它将被转换并开始悬浮。强烈建议使用磁铁！"
	]
	quest.220EA0B486F33931.quest_desc: ["这是一个超结实的钩子——差不多就是这样。它和普通钩子一样，但更耐用，能帮你更高效地收集物品。"]
	quest.22A0A9C81A5C85A1.quest_subtitle: "{atm9.quest.SG.subt.binding}"
