	quest.087F9C40B4545AE5.quest_desc: ["这用于制作网格，其中字符串网格是第一个可用的。我推荐从3x3的筛子开始，但也可以更大或更小——完全取决于你"]
	quest.0893EFCAC7031FEA.quest_desc: ["{atm9.quest.farm.desc.cake}"]
