	file.0000000000000001.title: "Prism Drift 1.21.1"
	quest.00075A5F9AC120ED.quest_desc: ["这会将物品从你的输入箱中取出。"]
	quest.00075A5F9AC120ED.quest_subtitle: "Always Required"
	quest.000C1ECD781F3F81.quest_desc: ["&2&l自然&r利用地球的优势，通过&2下毒&r和&2削弱&r敌人！就像大公司对待地球一样！ \\n&2&l自然的&r专注材料是&2毒马铃薯&r。 \\n\\n&2卷轴&r是&a浅绿色&r的，文字是&2深绿色&r的。"]
	quest.000C1ECD781F3F81.title: "&2&l自然"
	quest.000F7897FF9ED7DC.quest_desc: ["生长过程有 &a4 个阶段&f，就像 &bCertus Quartz Clusters&f 一样。在 &a前三个阶段&f中，你会得到 &bEntro Dust&f，但在 &a第四个阶段&f中，你可以获得 &bEntroized Crystals&f。"]
	quest.0012EC5DDAEB7D5B.quest_desc: ["这个多方块结构可能无法像其他多方块结构那样大量使用，但它会证明自己的价值，我保证！"]
	quest.0012EC5DDAEB7D5B.quest_subtitle: "这能酿造啤酒吗？"
	quest.00133F24F615C219.quest_desc: ["繁殖一只铁蜜蜂和一只蓝带蜜蜂。"]
	quest.00133F24F615C219.quest_subtitle: "蜜蜂繁殖"
	quest.001C4388146BD377.title: "结构和地下城 (Structures and Dungeons)"
	quest.001DE8028CAF0A08.quest_subtitle: "嘘嘘嘘……太吵了……"
	quest.002163B909070CF8.quest_desc: [
		"让你能透过墙壁看到特定方块/流体的详细信息。\\n"
		"{image:atm:textures/questpics/pneumaticcraft/block_tracker.png width:150 height:150 align:center}"
	]
	quest.002163B909070CF8.quest_subtitle: "最大值：1"
	quest.00237AB9C48C8A9B.quest_desc: ["The &bMatter Condencer &fwill allow you to &6make &bMatter Balls&f for the &bPaint Gun&f, and &6make&b Singularities &fat the cost of &aitem entities&f."]
	quest.002410CF49E1E14E.quest_desc: ["使用&bFE Storage Components&f来存储&4能量&f。"]
	quest.002B8F2DE2CB4D2C.quest_desc: ["副手拿着盾牌，主手拿着&7强化卷轴&r，然后按住右键。"]
	quest.002B8F2DE2CB4D2C.title: "强力盾牌"
	quest.002D65E4D7E8F62B.title: "Tier 2 Grader Catalyst"
	quest.0035439F73199781.quest_desc: ["我以为&b钢&f是&b铁和碳&f，而这玩意儿只是充了能，连锻造都算不上。"]
	quest.0035439F73199781.quest_subtitle: "他们管这叫“钢”？真是笑话"
	quest.0035439F73199781.title: "&e能量化钢锭"
	quest.003C38C78609709B.quest_desc: ["在&bInscriber&f中制作，&bAccumulation Press&f与&bSky Stone Ingots&f结合使用，可生产&bAccumulation Circuits&f。"]
	quest.0043B98F72CCB995.quest_desc: ["By &6throwing &bOtherwood &finto the &bSpiritfire &fyou can get &bOtherworld Ashes"]
	quest.00453FF528AA0B1C.quest_desc: ["Lonestar Skeletons 是可以在任何地方生成的敌对生物。 \\n\\n它们有 10 点生命值，会用剑向你发起攻击。 \\n\\n死亡时，它们会掉落 Bones、Swamp Silver Nuggets、Shattered Swords，以及 Corail 为 Undead Mobs 添加的掉落物。"]
	quest.00453FF528AA0B1C.title: "Lonestar 骷髅"
	quest.004D61425172324F.quest_desc: ["&8锁链甲&r比铁甲稍差。它在&l&2Minecraft&r中的主要用途在于其稀有性，只能通过交易和生物掉落获得。 \\n\\n当然，这是经过模组修改的，所以现在我们可以制作它了！这也让它失去了原有的意义……"]
	quest.004D61425172324F.quest_subtitle: "12"
	quest.004D61425172324F.title: "&8锁链甲盔甲"
	quest.0052E5592A6BBEC1.quest_desc: [
		"这是&2&lMinecraft&r，我无法告诉你如何建造……"
		"{@pagebreak}"
		"不过我可以给你一些提示来帮助你！"
	]
	quest.0052E5592A6BBEC1.title: "&l建筑技巧！&r"
	quest.005CC8A3325FE2BD.quest_desc: ["&bFroststeel&r、&7Cloggrum&r 和 &eRegalium&r 可以通过采矿获取。 \\n&cUtheric&r 和 &aForgotten&r 则需要通过击杀获取。 \\n\\n还有其他问题吗？"]
	quest.005CC8A3325FE2BD.title: "&2&lUndergarden&r 金属"
	quest.00611844AFD5C31E.quest_desc: ["Inscriber 和 Charger 原生支持 RF/FE，但大多数 ME 网络使用名为 AE 的专用电力系统。\\n\\nRF/FE 可以通过 ME 控制器直接转换，或通过 &bEnergy Acceptor&f 以 2:1 的比例转换为原生 AE，后者可连接到网络的任意部分。"]
	quest.00611844AFD5C31E.quest_subtitle: "插入电源"
	quest.0072C4F028C327CB.quest_subtitle: "Magmatic + Nomad"
	quest.0072C4F028C327CB.title: "BlazBee"
	quest.00764A738DA6451C.quest_desc: ["杀死4个&d末影幼虫&r。 \\n\\n我们现在不是在杀光一切吗？"]
	quest.007A11C49E06F15F.quest_desc: ["这些可以制作。 \\n\\n&9制作组件蓝图&r是最重要的&9蓝图&r之一。 \\n\\n它能帮助&6工程师工作台&r以比合成台更低的价格制造小型机械组件。 \\n\\n它还能用来制作灯泡和电路等独特物品！"]
	quest.007A11C49E06F15F.title: "&9合成组件蓝图</c1>"
	quest.008723B0DB9AACC9.quest_desc: ["&5&l深渊之卵&r&r可以放置下来孵化出你自己的&5&l幼年利维坦&r&r。它会像妈妈一样攻击其他海洋生物……你杀了它的妈妈，你这个残忍的怪物 >:("]
	quest.008723B0DB9AACC9.quest_subtitle: "&5孵化深渊之卵"
	quest.008723B0DB9AACC9.title: "&5&l深渊之卵"
	quest.008D186B4E0ED14F.quest_desc: [
		"蒸汽烤箱是另一种利用蒸汽完成有用工作的机器。 \\n\\n将蒸汽输入蒸汽烤箱，它就能像熔炉一样熔炼其中的物品，将矿石制成锭，也能烹饪食物。 \\n\\n它由2x2x2的蒸汽烤箱方块组成。"
		"{image:atm:textures/questpics/railcraft/rail_oven.png width:100 height:100 align:center}"
	]
	quest.008D186B4E0ED14F.title: "蒸汽烤箱"
	quest.008DBEF8893F1B63.quest_desc: ["在所有元素中，氦气最为稳定，不会燃烧或与任何其他元素发生反应。氦气的熔点和沸点都最低。它以气体形式存在，但在极端条件下可以转变为物质的第四种状态——等离子体。"]
	quest.008DBEF8893F1B63.quest_subtitle: "巨型多方块结构"
	quest.009041EBAD28D526.quest_subtitle: "现在我们到了4倍速度的地方"
	quest.00989B14B024EF72.quest_subtitle: "这种龙能将附近的敌对生物点燃，并为自己和主人提供火焰抗性。在沙漠金字塔中有8.5%的几率找到&4火焰龙蛋&r。"
	quest.00989B14B024EF72.title: "获得一枚 &4火龙之卵"
	quest.009EC4156DE356FD.quest_subtitle: "可在&l任意&r两地之间轻松移动。长途移动会消耗&a经验值&r。"
	quest.009EC4156DE356FD.title: "获取一块 &6Waystone"
	quest.00A17728A387B426.quest_desc: ["木巢可用于吸引木匠蜂和蓝带蜜蜂。\\n\\n深色橡木巢可吸引3种不同的蜜蜂。\\n\\n这些巢穴可以放置在任何主世界生物群系中。"]
	quest.00A17728A387B426.quest_subtitle: "可在任何主世界生物群系中使用"
	quest.00A17728A387B426.title: "木制鸟巢"
	quest.00A91BD731486644.quest_subtitle: "锡兰乌木 + 酸樱桃"
	quest.00AC7CC291A3E590.quest_desc: ["你可能（肯定）见过世界各地有类似信标突出的结构。它们由鹅卵石建成，有四条腿支撑，高高地悬在空中！ \\n\\n希望你已经知道，它们叫&8黑暗神庙&r，里面有一个我们需要的&a环境蓄能器&r。 \\n\\n你必须等到雷暴天气来填充你的天气容器。然后，你就可以制作你的&3闪电炸弹&r了！"]
	quest.00AC7CC291A3E590.title: "&3闪电炸弹"
	quest.00B1AE0AB854AB40.title: "硫酸 (Sulfuric Acid)"
	quest.00B7DD3AFC94B037.quest_subtitle: "山毛榉 + 白蜡木"
	quest.00B9671338E0E8A4.quest_desc: [
		"&c&lSophisticated Backpacks&r&r 有&l海量&r实用且功能多样的升级组件，可混搭以满足不同需求。"
		"每次升级都需要在配方中使用一个 &c&l升级底座&r&r。"
	]
	quest.00B9671338E0E8A4.title: "&l是时候升级一下了？"
	quest.00BF4E98A328801D.quest_desc: [
		"用&b盐酸&r在&e化学浴&r中浸泡这种粉尘，以制成此物"
		""
		"然后你需要对它进行&e电解&r以提取其中的&d钨&r"
	]
	quest.00C24A7DFEAEE956.quest_subtitle: "增加范围效果强度"
	quest.00C79D7593BD9909.quest_desc: ["&6&l烹饪台&r&r是&6厨师&r为市民制作食物的地方。食物会在需要时被烹饪，将此与&6&l餐厅&r&r结合使用，可自动保持餐厅&6备有&r食物。"]
	quest.00C79D7593BD9909.quest_subtitle: "&6烹饪术"
	quest.00C79D7593BD9909.title: "&6&l不是你选择了铲子人生，而是铲子人生选择了你！"
	quest.00CB8D60E7831A57.quest_desc: ["地下墓穴是由深度岩砖构成的巨大地下结构。你可能会在地面上发现其突出的一部分。\\n\\n在这片巨大的迷宫中，隐藏着&7被遗忘者&r、隐藏的宝箱，以及最终Boss：&a被遗忘的守护者&r。\\n\\n希望你能做好准备！"]
	quest.00CB8D60E7831A57.title: "地下墓穴"
	quest.00D738AD58B0E84A.quest_desc: ["并非所有蜜蜂都生而平等……因此……并非所有蜜蜂的工作效率都相同。以下是一些专为特定任务培育的“特种”蜜蜂，而不仅仅是产蜜。"]
	quest.00D738AD58B0E84A.quest_subtitle: "工蜂们"
	quest.00D7BCC68D971A53.quest_desc: ["附近的生物会被自动追踪，即使隔着墙壁。如果是敌对生物，当它锁定你时会发出警告。"]
	quest.00D7BCC68D971A53.quest_subtitle: "最大值：1"
	quest.00DB5495C3A44999.quest_desc: ["Shift-右键点击物品栏以清空。"]
	quest.00DEFA26F2B896D6.quest_subtitle: "银色石灰 + 橡木/桦木"
	quest.00E1F1279F97557B.quest_desc: ["与 Extruder MK1 类似，但更先进！可与 Patterns 配合使用，放置方块时会按照该图案排列！"]
	quest.00E32809B273084F.quest_desc: ["速度升级会缩短蜜蜂每次往返后在蜂巢中停留的时间，放置在离心机或其他方块中会缩短操作时间。"]
	quest.00E32809B273084F.quest_subtitle: "想体验速度的激情吗？"
	quest.00EC37E07591FFC4.quest_desc: ["显然，制作复制品还需要另一个卷轴：死亡之眼卷轴。它能让你通过观察怪物死亡来收集灵魂。每次死亡只能获得少量灵魂，所以需要见证大量死亡。收集到100个灵魂后，你就可以制作复制品了。"]
	quest.00EC37E07591FFC4.title: "灵魂（Souls）"
	quest.00EFC7B327E79076.quest_desc: ["在 SPS 中消耗了数万亿能量后，我们终于可以制造 &d反物质颗粒&r了。\\n\\n将 SPS 获得的反物质气体输入化学结晶器，每生产 1000mb 就能得到 1 个反物质颗粒。"]
	quest.00F00B0B66059996.quest_desc: [
		"好，又一个大型结构！需要的端口比任何海军基地都多！\\n\\n我们需要源输入、流体输入和输出，以及物品输入和输出。\\n\\n现在要遵循一长串步骤，请仔细听好！\\n\\n首先，我们需要未精炼液态灵魂，这需要用流体提取器（来自&lIF&r）处理灵魂树获得。\\n\\n然后，我们可以用&b&l符文熔炉&r将灵魂、未精炼液态灵魂和&d源&r结合，得到液态灵魂！\\n\\n接着，用液态灵魂、更多的&d源&r和一些来自&l&5Mekanism&r的物品，最终合成&5黑曜钢&r。"
		"{@pagebreak}"
		"{image:atm:textures/questpics/chap3/creative_crucible1.png width:100 height:100 align:center}"
		"&l&bRunic Crucible&r的第一层中间有一个&6Gilded Chiseled Polished Darkstone&r，周围是&9Polished Darkstone&r。然后，两侧将放置倒置的&9Polished Darkstone Stairs&r，角落上放置Rune Blocks。"
		"{image:atm:textures/questpics/chap3/creative_crucible2.png width:100 height:100 align:center}"
		"正中间放一个&b秘法水晶&r，周围用&9抛光暗石台阶&r。两侧是&6秘法抛光暗石柱&r、&9抛光暗石&r（会被替换为活板门）和&6秘法抛光暗石&r。"
		"{image:atm:textures/questpics/chap3/creative_crucible3.png width:100 height:100 align:center}"
		"在每个角上放置&b秘法水晶块&r，大功告成！"
		"{image:atm:textures/questpics/chap3/creative_crucible4.png width:100 height:100 align:center}"
		"最后，留出空间，将 &7量子注入器&r 放置在中间的 &b神秘水晶块&r 上方。"
		"{image:atm:textures/questpics/chap3/creative_crucible5.png width:150 height:100 align:center}"
		"中间层的&9Polished Darkstone blocks&r就是我们放置Hatches的地方！"
	]
	quest.00F00B0B66059996.title: "&b&l符文熔炉"
	quest.00F4E708E30057CA.quest_desc: ["击败&l&3Maledictus&r&r的奖励。可用于制作武器或升级盔甲。"]
	quest.00F4E708E30057CA.title: "&3&l铒锭 (Cursium Ingots)"
	quest.00FD36C207845895.quest_desc: ["在末地放置一个黑曜石巢穴来引诱这只蜜蜂。"]
	quest.00FD36C207845895.quest_subtitle: "&9需要黑曜石巢穴"
	quest.00FD36C207845895.title: "Draconic Bee"
	quest.00FF2CA7BA326007.quest_subtitle: "Mandarin + 野生樱桃"
	quest.01046CFBD7411AA6.quest_subtitle: "等级：&54"
	quest.0104C2E2E30B966B.quest_desc: [
		"&cBlood Chest&r 的速度不够快？需要修复的物品太多？你可以制作一个 &cColossal Blood Chest&r 来解决这些问题。\\n\\n要建造一个，你需要制作 25 个 &9Reinforced Undead Planks&r。用它们建造一个 3x3x3 的空心立方体，然后放置一个 &cColossal Blood Chest&r 方块来封闭这个多方块结构。如果操作正确，你将拥有一个巨大的、可以使用的 &cBlood Chest&r。有人甚至可能称之为巨型。\\n\\n这也允许你使用 &6Promises&r 来对它进行升级。"
		"{image:atm:textures/questpics/evilcraft/bloodchest.png width:250 height:200 align:1}"
	]
	quest.0104C2E2E30B966B.quest_subtitle: "血液宝箱 Sr"
	quest.0104C2E2E30B966B.title: "&a巨型修复工程"
	quest.010607466D565B53.quest_desc: ["亲近大自然，伙计。 \\n\\n穿上&a扎根靴子&r，大自然就是你的好伙伴！站在草地上会恢复生命值。在草地上吃东西时，效果等同于使用骨粉催熟。"]
	quest.010607466D565B53.quest_subtitle: "脚部"
	quest.010607466D565B53.title: "&a扎根靴子"
	quest.0107D516E038E0DB.quest_desc: ["&eLich Tower&r 是 &eLich&r 的巢穴！战斗分为 3 个阶段：\\n\\n阶段 1：&eLich&r 会给自己套上护盾，并用像 Ghast 火球一样的 &5Ender Pearls&r 攻击你。将它们反射回 &eLich&r 来打破护盾！护盾破碎时，他会派出分身来分散你的注意力。\\n\\n阶段 2：&eLich&r 会更换权杖，召唤僵尸来助战。他的防御被破后，你就可以近身攻击他了！\\n\\n阶段 3：一旦权杖的充能全部耗尽，他会换成 &eGolden Sword&r 并进入狂暴状态。快把他干掉！"]
	quest.0107D516E038E0DB.title: "&e将你的死者带出来"
	quest.0108F3EFDFD6DFD0.quest_desc: ["Storage Link 可以让你连接多个未连接到 Storage Controller 或其相连方块上的存储设备。\\n\\n也就是说，这是一种无需右键点击每个存储设备，就能无线连接“多方块”存储的方式。\\n\\n14 格的距离限制仍然适用。"]
	quest.01119871B1D5C576.quest_desc: [
		"几乎每个&6村庄&r里都可以有&6&l牧师&r。这包括模组村庄&6&r。 \\n\\n通常他们会待在&6村庄&r的中心，比如市场附近。并非每个&6村庄&r都会有牧师。"
		"{image:atm:textures/questpics/iron_spells/spells_village.png width:200 height:100 align:center}"
	]
	quest.01119871B1D5C576.title: "&6村庄"
	quest.0115271C840CD387.quest_desc: ["也许是时候升级一下那个锅炉了？"]
	quest.0115271C840CD387.quest_subtitle: "蒸汽真多，多得惊人"
	quest.0119F518ACD8568D.quest_subtitle: "+红石控制 Redstone Control"
	quest.011E9553CDCAE218.quest_desc: ["存储容量要扩大四倍，是这个意思吗？"]
	quest.011E9553CDCAE218.title: "4k 存储组件"
	quest.011F787E620DE9E8.quest_desc: ["要设置生物过滤器，只需点击你不想再看到的生物即可。 \\n\\n每个过滤器只能容纳1种生物，所以如果你想让僵尸、骷髅、蜘蛛、苦力怕和末影人不再生成，就需要5个生物过滤器。 \\n\\n你可以通过点击另一种生物来更换过滤器里的生物。"]
	quest.011F787E620DE9E8.quest_subtitle: "他是不请自来的客人！"
	quest.012366E4E4095FC4.quest_desc: [
		"过滤外壳是过滤空气中有害颗粒物并使房间保持&e清洁&r所必需的"
		""
		"建造洁净室时，请使用&a扳手&r来破坏这些方块，否则它们被破坏时不会掉落物品"
		""
		"天花板全部都需要是过滤外壳，减去1个用于放置洁净室控制器方块的位置"
	]
	quest.012912FDAFCD1C66.quest_desc: ["&e&lCaliburn&r will start off not much better than a &bDiamond Sword&r but once upgraded; the &bDiamond Sword&r looks more like a normal Stick than &e&lCaliburn&r! \\nBoth &4&lMorgan&r and &e&lCaliburn&r have their actual Damage and their Innate Cap. \\n\\nInnate Cap is max Damage it can be increased to. To increase the Innate Cap of &e&lCaliburn&r, enchant it with &5Smite&r then toss it in the &3Lake&r with Nether Stars. \\n\\nTo get the Max Cap you need 60 Nether Stars. Once upgraded it can't be upgraded anymore so make sure you toss in all 60 at once! \\n\\nTo increase the normal Damage you'll need to enchant it with &5Smite&r then back in the &3Lake&r it goes! You'll need more damage in order to..."]
	quest.012912FDAFCD1C66.title: "升级 &l&eCaliburn"
	quest.012B064DED21DCD3.quest_desc: [
		"&b终极灌注工厂&r可同时处理多达&a9&r个灌注过程，并包含相同的“&6自动分类&r”功能。"
		""
		"The &bUltimate Infusing Factory&r can also hold up to &18,960 mb&r of infusing material."
	]
	quest.0145727E40D7F674.quest_subtitle: "Cempedack + 面包果"
	quest.0145A878C472548C.title: "仪式：召唤福里奥特伐木工"
	quest.01516BC726013B7C.quest_desc: ["此任务由 &6AllTheMods Staff&r 或 &2社区贡献者&r 为 AllTheMods 整合包创作。\\n\\n所有 &6AllTheMods&r 整合包均受 &eAll Rights Reserved&r 许可，未经明确许可，不得将此任务用于非 &6AllTheMods Team&r 发布的任何公共整合包中。\\n\\n此任务被有意隐藏，若你看到此内容，则表示你处于编辑模式。"]
	quest.0152938EE5651409.quest_desc: ["此任务由 &6AllTheMods Staff&r 或 &2社区贡献者&r 为 AllTheMods 整合包创作。\\n\\n所有 &6AllTheMods&r 整合包均受 &eAll Rights Reserved&r 许可，未经明确许可，不得在 &6AllTheMods Team&r 未发布的任何公共整合包中使用此任务。\\n\\n此任务被有意隐藏，若你看到此信息，则表示你处于编辑模式。"]
	quest.0152C49AB74B9D32.quest_desc: [
		"你可能听说过，&cFusion Reactor&r 是这个整合包里最好的电源。他们可能说得对\\n\\n一旦激活，在正确配置下，反应堆能输出高达 80MRF/t 的功率。它还能用水冷却产生蒸汽，蒸汽可以进入 &9Industrial Turbine&r 产生更多电力。\\n\\n要建造 Fusion Reactor，我们需要遵循一个简单的模式。每个面都如下所示："
		"{image:atm:textures/questpics/mek/fusion_pattern.png width:175 height:175 align:1}"
		"{@pagebreak}"
		"顶部，我们需要将中间的方块替换为 Fusion Reactor Controller。\\n\\n端口方面，你可以替换侧面的任意 Reactor Glass。此设置需要两个端口来输入 &cDeuterium&r 和 &eTritium&r，然后一个端口来输出电力。"
		"{image:atm:textures/questpics/mek/completed_fusion_reactor.png width:175 height:150 align:1}"
	]
	quest.0152C49AB74B9D32.quest_subtitle: "整合包里最好的电源"
	quest.0152C49AB74B9D32.title: "The &cFusion Reactor"
	quest.0155DD9149A294EF.quest_desc: ["在&7砾石&r或&7石头&r巢穴上使用蜂蜜点心，即可生成挖掘蜂。"]
	quest.0155DD9149A294EF.quest_subtitle: "砾石或石头"
	quest.017194E29D6745E8.quest_desc: ["此任务由 &6AllTheMods Staff&r 或 &2社区贡献者&r 为 AllTheMods 整合包创作。\\n\\n所有 &6AllTheMods&r 整合包均受 &eAll Rights Reserved&r 许可，未经明确许可，不得将此任务用于非 &6AllTheMods Team&r 发布的任何公共整合包中。\\n\\n此任务被有意隐藏，若你看到此内容，则表示你处于编辑模式。"]
	quest.0172BB881A7259C8.title: "制作一个&d木制长凳"
	quest.01748C2CD9C97523.quest_desc: ["&cReappearing Blocks&r 就像超酷的传送门。右键点击后，它们会短暂消失。\\n\\n&cVanishing Blocks&r 右键点击后会消失，但它们不会回来。"]
	quest.01748C2CD9C97523.title: "&c重新出现和消失的方块"
	quest.0184227CE952621D.quest_desc: ["用一块下界合金喂饱一只钻石蜜蜂。"]
	quest.0184227CE952621D.quest_subtitle: "蜜蜂转化器"
	quest.018EE4529FFD04AB.quest_desc: [
		"- 按 &6左 Shift&r 和 &6右击&r 可在 &b时运&r 和 &b丝绸之触&r 之间切换。"
		""
		"- 使用 &6Alt&r 和 &6鼠标滚轮&r 来更改挖掘速度。"
	]
	quest.019CA0E35F888222.quest_subtitle: "更多过滤选项"
	quest.019CA0E35F888222.title: "&e高级补给升级模组"
	quest.01B13BBB41BBB460.quest_desc: ["&cUtherium Armor&r 的属性和 Netherite Armor 一样！ \\n\\n不需要锻造模板！"]
	quest.01B13BBB41BBB460.title: "&cUtherium&r 盔甲"
	quest.01B2DDD81065B4EF.quest_subtitle: "丛林 + 樱花林"
	quest.01C5D8357D8B0D62.quest_desc: ["如果你知道侦测轨道的运作方式，那么这个模块对你来说就很容易理解。 \\n\\n基本上，如果路由器中装有特定物品，它就会从路由器发出红石信号。 \\n\\n在该模块中，你可以设置物品、信号来源以及信号的强度。"]
	quest.01CF1A9D9F29AFF7.quest_subtitle: "Pomelo + Orange"
	quest.01D0C8DB2646FFC9.title: "制作一个 &d碗柜 (Cupboard)"
	quest.01D895369791881A.quest_desc: ["现在每个配方能产出2个ZPM处理器！这真是个伟大的突破，能让我们更容易地扩大机器占地面积！"]
	quest.01D895369791881A.quest_subtitle: "把它们堆叠起来"
	quest.01E1A7BCDAE8EB9F.title: "红色代表速度"
	quest.01EE2526B43B6502.quest_subtitle: "等级：&b3"
	quest.01F18150EC923482.quest_subtitle: "入门指南"
	quest.01F322AEFCC6109E.quest_desc: ["纠缠的头骨可以掉落自……嗯，纠缠的头骨本身。 \\n\\n它们可以像凋零头颅一样，被凋零投掷出去。 \\n\\n不过，这样做会消耗掉它们。"]
	quest.01F3F0C25BA72BDA.quest_desc: [
		"除了存储物品和流体外，AE2 还提供了一种原生的方法，可将整个 &e结构&f 存储在存储单元中，这与 Compact Machines 模组非常相似。"
		""
		"&bSpatial IO Port&f 允许将位于 &bSpatial Containment Structure&f 内的结构捕获到特制存储单元中，并通过红石信号激活。"
		""
		"如果生物或玩家在SCS被捕获时身处其中，他们也会被传送到该空间的专属维度。如果被捕获的是你，请确保有办法进出。"
	]
	quest.01F3F0C25BA72BDA.title: "Spatial IO"
	quest.01F51EBFEC660549.quest_subtitle: "银色石灰 + 欧洲落叶松"
	quest.01F7F3589EBD8872.quest_subtitle: "用棕色蘑菇喂食一只蜜蜂女王"
	quest.01F7F3589EBD8872.title: "棕色蜜蜂（Brown Shroombee）"
	quest.02056C28AB828C96.quest_desc: ["&e&l三箭弓&r&r是雪女王被击败后掉落的两种弓之一。射击时，它会同时射出三支垂直排列的箭，类似于弩的“多重射击”附魔，但它只消耗一支箭，耐久度减少一点。如果所有箭都命中，这把弓对付单个目标和多个目标都非常有效。"]
	quest.02057E81D8139BAE.quest_desc: [
		"如果你打算去太空，那你最好相信你需要一套全新的装备来开启这段旅程。"
		""
		"第一次去&b月球&r，你需要先制作一套完整的&a太空服&r。月球上又冷又没有氧气，没有太空服可活不了多久。:)"
	]
	quest.02057E81D8139BAE.title: "&a穿戴装备中"
	quest.02089D95AA679502.quest_subtitle: "来自蛛王战利品袋的掉落物"
	quest.020E6AF37A0421C8.quest_desc: [
		"水箱就像在外面放了一个桶，只不过这个桶要大得多。它能收集水，并为蒸汽机车储水。 \\n\\n其储水量取决于生物群系和天空的可见度。 \\n\\n它由一个3x3x3的水箱方块组成，中间是空的。"
		"{image:atm:textures/questpics/railcraft/rail_tank.png width:100 height:100 align:center}"
	]
	quest.020E6AF37A0421C8.title: "水箱"
	quest.02190383FEE793ED.quest_desc: ["剩下的就是用&e化学反应&r把氯从铱上分离出来！"]
	quest.02272D430F08B1DC.quest_desc: [
		"  Now you can make a large tank! This is a tank multi-block that can store 64,000mb &oper&r block within the total volume the tank takes up, air blocks and solid."
		""
		"放置大型储罐后，打开其GUI，查看左上角。你可以选择想要的大小。"
		""
		"选定后，拿出你信赖的扳手，全息投影会显示放置方块的位置。"
		""
		"也可以使用大型储罐舱口。它和其他舱口一样，只是储罐的入口。它会通过你安装的任意舱口进行输入和输出。"
	]
	quest.022C38096F79EF07.quest_desc: ["&6&lForbidden Arcanus&r 的核心就是用秘术和锻造台做仪式来变强！ \\n\\n或者更为人所知的 Eternal Stella。这个模组可不止这些哦！"]
	quest.022C38096F79EF07.title: "&6&l禁忌秘典 (Forbidden Arcanus)</c2></c1>"
	quest.023A420F24C515EB.quest_desc: ["这是&b基础压力管&r的&8加固&r版，可以&2伪装&r，并能添加&b管道模块&r以提供&e额外功能&r。"]
	quest.0251FD45582C3164.quest_subtitle: "不要闻这个东西的味道"
	quest.0253D241383EC848.quest_desc: ["雷电是《真人快打》中的一个虚构角色……哦等等……上面写的是拉顿，不是雷电……"]
	quest.0253D241383EC848.quest_subtitle: "雷电将军"
	quest.02593CD4B4AE814C.quest_desc: [
		"&b盐&r对于孵化&e炼金硫磺&r很重要！ \\n\\n要获得&b盐&r，我们需要烹饪一些物品。不同的物品会产出不同的&b盐&r。这些&b盐&r有不同的等级，越稀有等级越高。 \\n\\n要烹饪出&b盐&r，我们需要将物品放入烤箱，并用热源进行加热。然后从烤箱中取出&b盐&r！"
		"{image:atm:textures/questpics/theurgy/theurgy_oven.png width:100 height:100 align:center}"
	]
	quest.02593CD4B4AE814C.title: "海水淡化厂"
	quest.0262E0D49A12F817.quest_subtitle: "升级！"
	quest.02643BAD1AE747C6.quest_desc: ["&3高级液体压缩机&r的工作原理和液体压缩机一样，只是更出色！"]
	quest.026A71F98A52E3A5.quest_desc: ["村庄里有一些&o有趣的&r村民，他们恰好是&d狼人&r。\\n\\n击杀这些野兽会掉落&d狼人肉&r。"]
	quest.026C63594F813BCC.quest_desc: [
		"&l能力类型：&r主动型"
		""
		"&l能力功能：&r"
		""
		"激活后移除玩家的所有负面效果，有冷却时间。"
	]
	quest.027084AE2DF5EBA6.quest_desc: ["Thermal Evaporation Plant 的多方块结构会根据内部温度产生盐水。\\n\\n有多种方法可以提高工厂的温度，包括在沙漠中建造！\\n\\n&aFuelwood Heater&r 会燃烧一桶桶岩浆，可以通过导热管道输送岩浆。\\n\\n&aResistive Heater&r 使用 RF/FE 产生热量，并且可以设置使用任意数量的 RF/FE。"]
	quest.027084AE2DF5EBA6.quest_subtitle: "热盐水在此。在此获取你的热盐水。"
	quest.027084AE2DF5EBA6.title: "提高我们的盐水生产效率"
	quest.0272E58516A0C284.quest_desc: [
		"有效升级："
		"- 矿石矿工 Ore Miner"
		"- 矿石扫描仪 &4&l已禁用&r&f"
		"- 割草机"
		"- 天空清扫者"
		"- 伐木机"
		"- 树叶破坏者"
		"- 自动熔炉"
		"- 锤子"
		"- 掉落物品：Teleporter"
	]
	quest.027E6E294D9E1375.quest_desc: ["记笔记吧，&lCorail&r！这才是过节的样子！(我敢说这100%会受欢迎，我们爱你，&lCorail&r！) \\n\\n这个新增内容加入了大量圣诞节和万圣节的装饰品。 \\n\\n从圣诞树、礼物和彩灯，到万圣节的南瓜、蜘蛛和女巫帽。"]
	quest.027E6E294D9E1375.title: "&b&l金刚鹦鹉的假期&r"
	quest.027EF5C8A74B1596.quest_desc: [
		"&6B&8e&6e&8's&r 主要武器是他们的毒刺。 \\n\\n那为什么不用它来制作我们自己的武器呢！你可以制作、寻找或用交易获得毒刺长矛，它的用法和三叉戟一样。 \\n\\n只是要弱得多，并且会对生物造成中毒效果！"
		"{image:atm:textures/questpics/bumblezone/bumble_spear.png width:100 height:150 align:center}"
	]
	quest.027FD9135DEC4949.quest_subtitle: "放置在末地并喂食恶魂之泪时会吸引幽灵蜜蜂"
	quest.0298A17C2AAC5765.quest_desc: ["将背包中的堆叠大小增加 8。"]
	quest.0298A17C2AAC5765.title: "&b堆叠升级 第3级"
	quest.0299E59D23F16ACB.quest_desc: [
		"你知道该怎么做，&aOre Process&r 一些钨酸盐或白钨矿成粉末状"
		""
		"原矿位于&d采矿维度&r的&e末地层&r，Y坐标-63到0之间，与锂混合在一起。甚至还有可能发现钨矿的表面指示物！"
	]
	quest.029AA03790F055E8.quest_subtitle: "Crystalline + Mason"
	quest.029AA03790F055E8.title: "黄金蜜蜂"
	quest.02AE5771A57BC6BE.quest_subtitle: "完成该章节的任务。"
	quest.02AE5771A57BC6BE.title: "&3Applied Energistics"
	quest.02AFB98510478664.quest_desc: [
		"我们之前在捣鼓砷，觉得奇怪的是，竟然没有镓的身影。"
		""
		"不过别担心，我们找到了镓（Gallium）！"
	]
	quest.02AFB98510478664.quest_subtitle: "找到了！"
	quest.02B0CCD5607FF3B5.quest_desc: ["玩家配件就像一个箱子，可以连接到玩家的物品栏。通过GUI，玩家可以配置配件的侧面，使其与玩家的物品栏、副手或盔甲槽位进行交互。"]
	quest.02B574B09AB45D09.quest_desc: [
		"Freezes 的工作方式和 Blazes 类似，它们会飞上来并向你投掷球体。 \\n\\nFreezes 只会投掷 1 个球体，并且会让你感到寒冷而不是温暖。 \\n\\n它们有 16 点生命值，死亡时会掉落 Frozen Tubes。"
		"{image:atm:textures/questpics/eternal/starlight_freeze.png width:150 height:100 align:center}"
	]
	quest.02B574B09AB45D09.title: "冻结"
	quest.02B8F50721F12CFF.quest_desc: [
		"&l能力类型：&r被动"
		""
		"&l能力功能："
		""
		"防止玩家受到坠落伤害。"
	]
	quest.02C96AE982806447.quest_desc: ["&b建筑小工具&f需要&4电力&f来运行。默认情况下，&6按下&b\"H\" &f会打开设置菜单，您可以在其中选择大小和其他选项。"]
	quest.02C96AE982806447.title: "&b建筑小工具"
	quest.02CC3E13B8905603.quest_desc: [
		"将三钛合金固化，现在我们便拥有了能多种方式使用的资源。"
		""
		"相信我，我们即将制作的许多组件都需要用到钛。"
	]
	quest.02CC3E13B8905603.quest_subtitle: "坚固的斯特龙克"
	quest.02D3AFC713077502.quest_desc: ["使发酵过程更&6高效&r。 &a你可能需要自动化这个过程&r。"]
	quest.02D45E3FB37ED0AD.quest_subtitle: "等级：&63"
	quest.02F2DF9D9DA7833A.quest_desc: ["为了获得我们的&9腐化灵魂&r，我们需要进行一些&5附魔&r！\\n\\n我们正在寻找&5灵魂掠夺附魔&r。它可以附在武器上，每次你杀死一个生物时，它都有几率生成一个&9腐化灵魂&r。\\n\\n杀死它们就可以将它们作为物品获取。要尽量快，因为它们喜欢逃跑。\\n\\n也许它们知道你想杀它们？"]
	quest.02F2DF9D9DA7833A.title: "&5Soul Looting Enchantment（灵魂掠夺附魔）</c1>"
	quest.02F3133A9006BC1E.quest_subtitle: "铁 + 煤炭"
	quest.02F3133A9006BC1E.title: "钢铁蜜蜂"
	quest.02F4C3BEBD8427AD.quest_desc: [
		"相信我，你看到就知道了。\\n\\n蜂巢屋顶上悬挂着数十座花园。里面种满了数百种不同的花和树，甚至还有来自 Eternal Starlight 或 Regions Unexplored 等模组里的植物！"
		"{image:atm:textures/questpics/bumblezone/bumble_garden.png width:200 height:100 align:center}"
	]
	quest.02F4C3BEBD8427AD.title: "空中花园"
	quest.0301633594309CC6.quest_desc: [
		"&bSilent Gear&r 帮助你创建自定义工具和盔甲！它还能将多个锭合成强力合金，这对于制作星辰至关重要。"
		""
		"{\"clickEvent\": {\"action\": \"change_page\", \"value\": \"1D42B373285DEF81\"}, \"text\": \"Click here to start the questline!\", \"color\": \"#55FF55\", \"underlined\": \"true\"}"
	]
	quest.030AC1AF8F735550.quest_desc: ["要将液体倒入储罐，你需要某种管道。\\n\\n水泵可以自动以较慢的速度向其中注水，而且完全免费！"]
	quest.030AC1AF8F735550.title: "管道"
	quest.030E566682A89105.quest_desc: [
		"&b燃料罐&r可以储存大量燃料。"
		""
		"可以放置在通常接受燃料的任何槽位中。"
		""
		"最棒的是... &o当没有东西可以&r&6冶炼&r、&6冒烟&r、&6燃烧&r或&6产生能量&r时，它就不会消耗内部储存的能量了。"
		""
		"这有助于延长燃料的持续时间。"
		""
		"{image:justdirethings:item/fuel_canister_full width:100 height:100 align:center fit:true}"
	]
	quest.030E566682A89105.quest_subtitle: "燃料节省器"
	quest.03103A57191715D1.title: "皮革背包"
	quest.031BF5A5DDEA7DDF.quest_desc: [
		"穿过荆棘之地后，玩家将遇到位于&e最终高原&r的&l&e最终城堡&r&r。它主要由不同样式的白色城堡砖块构成，部分砖块刻有彩色符文并覆盖着力场。"
		""
		"目前，最终城堡仍在建设中，没有活跃的成就，内部也没有生物生成。"
	]
	quest.031BF5A5DDEA7DDF.title: "&2&l最终城堡"
	quest.03271CEB2EBD0979.quest_desc: [
		"  &6Transmits&r &cenergy&r from attached &bsource&r, to any power &bconsumer&r within an offset AOE."
		""
		"{image:ftblibrary:icons/up width:32 height:32 align:center}"
		"{image:ftbquests:tasks/fe_full width:64 height:64 align:center}"
	]
	quest.03271CEB2EBD0979.quest_subtitle: "一个范围伤害充电器"
	quest.032B654201E71618.quest_desc: ["这些&c轨道套件&r用于将实体与你的&7矿车&r结合使用（实体即生物）。 \\n\\n&c登车套件&r会将附近的任何生物拾起并放入&7矿车&r中。 \\n&c下车套件&r会将生物从&7矿车&r中卸下。 \\n&c倾倒套件&r会将矿车中的生物倾倒在&7矿车&r下方的&6轨道&r上。"]
	quest.032B654201E71618.title: "&c实体移动用的轨道套件&r"
	quest.03308BA3DDCC5932.quest_desc: [
		"使用单元工作台，可以过滤单元以仅接受特定物品，类似于ME存储总线可以过滤的方式。"
		""
		"即使你没有该物品，也可以将物品从 &aJEI&r 拖入槽位中。"
	]
	quest.03308BA3DDCC5932.quest_subtitle: "过滤和分区存储单元中的物品"
	quest.033BF8D12E32A5E5.quest_desc: ["拿起那些钌粉，开始混合吧！"]
	quest.033BF8D12E32A5E5.quest_subtitle: "一团糟 All Mixed Up"
	quest.0342248394E40B6A.quest_desc: ["此任务由 &6AllTheMods Staff&r 或 &2社区贡献者&r 为 AllTheMods 整合包创作。\\n\\n所有 &6AllTheMods&r 整合包均受 &eAll Rights Reserved&r 许可，未经明确许可，不得将此任务用于非 &6AllTheMods Team&r 发布的任何公共整合包中。\\n\\n此任务被有意隐藏，若你看到此内容，则表示你处于编辑模式。"]
	quest.03471D7D8B0068F0.quest_desc: [""]
	quest.03471D7D8B0068F0.title: "铁质背包"
	quest.0348661A4898AAAD.quest_desc: ["使用ME Chest或ME drive，可以手动插入单元并与内容互动。终端将使这一切变得更容易，为存储介质提供专用的访问点。"]
	quest.0348661A4898AAAD.quest_subtitle: "细胞放在这里"
	quest.0348661A4898AAAD.title: "ME 储物箱和驱动器"
	quest.034A9FBCA6D79BB6.quest_desc: ["收割者金字塔需要一把锄头才能工作。\\n\\n（无法损坏的锄头可以永久使用，可损坏的锄头需要更换）。"]
	quest.034DB3C64F24C7B7.quest_desc: ["&6&lAllTheOres&r 是一个内置模组，旨在统一各种矿石。\\n\\n同时还带来了大量非常实用的装饰方块！\\n\\n&dFluorite&r 和 &9Sapphire&r 看起来都非常酷！"]
	quest.034DB3C64F24C7B7.title: "&l&6AllTheOres&r 方块"
	quest.034F2CDF0830254B.quest_desc: [
		"和物品导入器一样，将&e流体导入器&r放在装有液体的储罐上。然后将&e流体接口&r放在想要的位置并用逻辑线缆连接。最后像之前一样使用变量卡！ \\n\\n也可以在整数限制下抽取液体。 \\n\\n它不会在世界中放置或移除流体源，只会将流体从一个储罐移动到另一个储罐。"
		"{image:atm:textures/questpics/logistics/id_fluid.png width:200 height:50 align:center}"
	]
	quest.034F2CDF0830254B.title: "&e流体导入功能"
	quest.034FBE8B8E8651BC.quest_desc: ["The &6&lGraveyard&r&r &9requires research&r at the &6University&r to be built, and is where the &6&lUndertaker&r&r will bury your deceased citizens. "]
	quest.034FBE8B8E8651BC.quest_subtitle: "&6墓园"
	quest.034FBE8B8E8651BC.title: "&6&l我只是来这“安静地”休息的！"
	quest.034FC4BCCCD7D154.quest_desc: ["注意：虽然可以将多个基础升级放入机器中，但只有最高等级生效。"]
	quest.034FC4BCCCD7D154.quest_subtitle: "Tier 3 基础升级"
	quest.03564837ECB5CC79.quest_desc: ["当然又是一个仪式，这次是&2Ihagan's Enthrallment&r。（顺便一提，要献祭马匹，需要在仪式进行时让马匹在附近） \\n\\n完成后，你会得到一个&2Dragon Familiar&r的生成蛋。你可以用它来合成&6&lATM Star&r，或者直接生成&2Familiar&r。 \\n\\n它会跟随着你，可以通过Shift+右键来抚摸它。"]
	quest.03564837ECB5CC79.title: "&2龙之伙伴&r 生物蛋"
	quest.035C52EF63AD23A7.quest_desc: ["因此模组名为 &lRailCraft&r，核心内容 &5火车&r、&6轨道&r 非常重要。 \\n\\n原版 &2Vanilla&r 的轨道能用，但大家都知道它们很烂。升级轨道需要更特殊的配方材料！快去制作吧！（可能需要用机器来制作材料，记得查看任务说明！）"]
	quest.035C52EF63AD23A7.title: "&6&l轨道&r！"
	quest.035E5B628D21FA20.quest_desc: ["Zombees 会在任何放置于过暗区域的进阶蜂巢中生成并占据空间。"]
	quest.035E5B628D21FA20.quest_subtitle: "保持蜂巢的火焰不灭，否则这些家伙会占领一切！"
	quest.0373198D54FA6B93.quest_subtitle: "翻倍行动"
	quest.037415D5B965E214.quest_desc: ["此升级可使背包无法被摧毁。"]
	quest.037488EF1F3581CE.quest_desc: ["默认情况下，没有ME控制器时，ME网络自身的内部缓冲区只有800AE，而控制器每块可增加8kAE。对于足够大的网络，这可能不够，并可能导致网络在尝试为任何已连接设备回收能量时间歇性断电。\\n\\n&b能量单元&f允许ME网络存储更多的能量，每个普通能量单元可增加200kAE，每个&b致密&f能量单元可增加1.6MAE。这些单元也可以放置在网络的任何位置以提供增大的能量缓冲区。"]
	quest.037BB7C486D2D360.quest_subtitle: "确实如此"
	quest.037BB7C486D2D360.title: "纳夸达矿脉"
	quest.037E0DAA5ECC5AB8.quest_desc: ["用&ePollen Puffs&r击中24种不同的生物。 \\n&6B&8e&6e&8s&r用它们来打最有趣！"]
	quest.037E566ACC83FE07.quest_desc: ["提示：你可以用&9容量&r来附魔它们，增加存储量！"]
	quest.037E566ACC83FE07.title: "储存能量"
	quest.038773FFAF3C8817.quest_desc: [
		"请将本章内容视为一张流程图来阅读。"
		""
		"每个等级都从一个矿石块开始的指令开始。"
		""
		"&6输入&r &b矿石块&r： &6最终&r &b锭&r，每个等级："
		""
		"Tier 1 -> 1:1"
		"Tier 2 -> 1:2"
		"Tier 3 -> 1:3"
		"Tier 4 -> 1:4"
		"Tier 5 -> 1:5"
	]
	quest.038773FFAF3C8817.title: "使用Mekanism进行矿物加工"
	quest.038812A14456236C.quest_desc: ["将一些处理器、一个能量单元和任意密实电缆组合，我们就能得到ME量子环。 \\n\\n通常我们会用它来连接跨维度的ME系统，但我们只关心&6&lATM Star&r！"]
	quest.038B71E71E3C8213.quest_subtitle: "&e女武神&r是&e中立生物&r，通过战斗证明自己。除非被挑衅，否则不会攻击，且只出现在&8白银地牢&r中"
	quest.039DBFD0172076AB.quest_desc: [
		"这个问题以前就问过，但现在要再问一次了……"
		""
		"这玩意儿能酿点啤酒吗？"
	]
	quest.039DBFD0172076AB.quest_subtitle: "你说的是酿酒厂吗？"
	quest.03B40AB768FC0161.quest_desc: [
		"Shimmer Rivers 是友善的河流。它们不会特意来伤害你。 \\n\\n它们有时会连接起大海，并穿过森林。 \\n\\n显然它们含有水，而水中蕴藏着丰富的宝藏！"
		"{image:atm:textures/questpics/eternal/starlight_river.png width:200 height:100 align:center}"
	]
	quest.03B40AB768FC0161.title: "闪烁的河流"
	quest.03B5D467E76C5B8A.quest_desc: [
		"希望你一直在收集和处理矿石哦！"
		""
		"你可以通过几种方法获得&d金红石粉尘&r："
		"&e电解&r 15 铝土矿粉尘"
		"[ \"\", { \"text\": \"EBF \", \"color\": \"green\", \"hoverEvent\": { \"action\": \"show_text\", \"contents\": { \"text\": \"电动高炉\" } } }, { \"text\": \"10 钛铁矿和 4 碳放在一起\" }]"
		"&6矿石处理&r 钛铁矿或铝土矿，随机产出"
		"&e化学浴&r将铝放入&3过硫酸钠&r中以提高产出几率"
		""
		"&c请记住：&r 随机产出会随着机器的等级而提高"
	]
	quest.03B5D467E76C5B8A.quest_subtitle: "更像是毫无用处的尘埃罢了"
	quest.03B842E4A2A6B2C9.quest_subtitle: "锰的好材料"
	quest.03B842E4A2A6B2C9.title: "石榴石矿脉 (Grossular Vein)"
	quest.03C40D6A5D722543.quest_desc: ["可变的卡片是开启互动（如导入物品）所必需的。将它们放入导入器中的一个槽位即可添加。 \\n\\n之后，你可以通过加号按钮编辑所有内容。你可以更改导入的数量、物品槽位、频道，几乎所有东西都可以通过这张卡片完成。 \\n\\n如果你和我一样只想移动物品，没什么花哨的，直接放进去，或许可以更改移动数量的限制。"]
	quest.03C475ABEFF04DEF.quest_desc: ["此透镜会将任何与之碰撞的魔力扩散器或实体，重新定向至发射该脉冲的方块或实体方向。"]
	quest.03C54B07106091DD.quest_desc: ["&cSmelter Prism&r 可能是这些仪式中最常用的物品，就像制作 &6&lATM Star&r 需要它一样！ \\n\\n你需要 4 个 &cBlaze Powder&r、2 个 &8Coal&r 和一块 &bArcane Crystal&r 来制作。别忘了还有 &3Elementarium&r Relic！ \\n显然，你大概率想要 &cSmelter Prism&r 是为了制作 &6&lATM Star&r。它还能配合工具熔炼物品：原矿成锭、原木成木炭、沙子成玻璃。 \\n\\n你也可以用它当熔炉燃料，但效果一般。这名字误导性太强了！"]
	quest.03C54B07106091DD.title: "&c熔炉棱镜"
	quest.03C756EB123CA953.quest_desc: [
		"我们将用它将中功率集成电路（&aMPIC&r）晶圆升级为高功率（&6HPIC&r）版本，从而支持更大的能量舱门！"
		""
		"要将此物品放入你的 &bCleanroom&r 中才能运行配方"
	]
	quest.03C78165C5CBD9E1.quest_desc: ["16k 存储磁盘可以存放 16000 个物品。"]
	quest.03C78165C5CBD9E1.title: "&a16k 存储组件"
	quest.03CF6D6277D93A4A.quest_desc: [
		"&bGauge Dropper&r 是一款实用的工具，可一次性将最多 &a16&r 桶的 &7流体&r 直接从 &9物品栏&r 中 &6移动&r。"
		""
		"这将帮助你在未来正确地&6配置&r机器。"
		""
		"&6右键&r放置&7流体&r，&6左键&r拾取。"
	]
	quest.03CF6D6277D93A4A.title: "Gauge Dropper"
	quest.03DCDFB32CD4BD85.quest_desc: ["&e&lCaliburn&r需要几样东西，有些已在任务中说明，有些则没有。 \\n首先，你需要一个&3Mahou Lake&r和5000个&4Mahou&r。 \\n\\n然后，你需要一把附魔的&bDiamond Sword&r，带有&5Smite&r（等级越高越好）。 \\n\\n最后，将&bSword&r投入&3Lake&r，你就能在湖底找到&e&lCaliburn&r！"]
	quest.03DCDFB32CD4BD85.title: "&e&l卡利班"
	quest.03E05018D64DDEE1.quest_desc: ["&eTier 5&r 基本上只是为了 Allthemodium 矿石，没有其他太多东西。"]
	quest.03E05018D64DDEE1.title: "&e收获等级 5"
	quest.03E0ADE2191CC3FB.quest_desc: ["添加到矩阵的每个&b高级感应单元&r会增加&e25.6 GFE&r的储能。"]
	quest.03E0ADE2191CC3FB.title: "高级感应线圈"
	quest.03E6FA4DCB71162E.quest_desc: ["&bColor Applicator&f是一种可充能的工具，用于在游戏内为线缆上色。它大致相当于一个特殊的&estorage cell&f，可以装入原版染料或特定颜色的&epaint balls&f，也可以用&esnowballs&f来洗去颜色，将线缆恢复为Fluix形态。\\n\\n为线缆上色会消耗其内部电池100AE的能量，单次充电总共可处理3400个线缆段。"]
	quest.03E6FA4DCB71162E.title: "颜色涂抹器"
	quest.03E7D73433AB6B7C.quest_desc: [
		"使用我们的奥术水晶粉尘，需要将其与其他粉尘和粉末结合，以创造&dMundabiter粉尘&r。"
		""
		"这种粉尘可用于多种配方，也可用于激活赫菲斯托斯锻造炉。"
	]
	quest.03E7D73433AB6B7C.quest_subtitle: "让尘埃们融合在一起"
	quest.03E7D73433AB6B7C.title: "Mundabitur 尘埃"
	quest.03ED9B0DFE8B4574.quest_desc: [
		"有效升级："
		"- 思维迷雾"
		"- 使敌人陷入混乱状态（Stupefy）"
		""
		"内在能力："
		"- 熔岩修复"
	]
	quest.03EE3F38F8606509.quest_desc: ["与红石和打印硅结合，你将制作出一个累积处理器。"]
	quest.03F624101CDF5291.quest_desc: [
		"&b简易&r:"
		"• &b方块&r被&6放置&r了"
		"• &e速度&r和&e方向&r控制"
		"• 可选的 &4红石&r 灵敏度"
		""
		"&b高级&r:"
		"• 添加了&6过滤&r和&3偏移AOE&r"
		"• 需要 &c能量&r"
		""
		"{image:justdirethings:block/blockplacert2_side width:100 height:100 align:center}"
	]
	quest.03F624101CDF5291.quest_subtitle: "（名词 动词，而非动词 名词）"
	quest.0416C489903BCFFF.title: "终极电压时代"
	quest.041D16DA96BC4253.quest_desc: [
		"&e&l授粉柱&r连接着&e&l授粉田&r和&6&l蜂巢壁&r。\\n两者兼具！巨大的陡峭的&6蜂蜜&r墙，同时覆盖着&e花粉&r！\\n"
		"{image:atm:textures/questpics/bumblezone/bumble_pollenpillar.png width:200 height:100 align:center}"
	]
	quest.041D16DA96BC4253.title: "&e&l授粉柱石 (Pollinated Pillars)</c2></c1>"
	quest.041ED280691BB05D.quest_desc: ["&9Froststeel&r 是 &2&lUndergarden&r 寒冷生物群系中常见的矿石。"]
	quest.041ED280691BB05D.quest_subtitle: "18"
	quest.041ED280691BB05D.title: "&9霜钢盔甲"
	quest.04291652780AEE72.quest_desc: [
		"大型腐化塔将非常重要，因为随着我们进入新资源层级，矿物加工的重要性会持续增加。"
		""
		"因此，拥有一个能并行处理流程的Maceration塔将优化仍需进行的矿石处理。"
	]
	quest.04291652780AEE72.quest_subtitle: "腐化塔！"
	quest.04362E2A5C541EC5.quest_desc: ["16x 锰磷化物线 - 数量 8"]
	quest.04362E2A5C541EC5.quest_subtitle: "LV 超导体"
	quest.0436DF3308681913.quest_desc: [
		"王座上躺着一位逝去&4&l国王&r的遗骸。但一旦你靠近并触碰，便会看到他复活；&4&l国王&r已不再死亡！但唯有杀戮才能让他保持存活……而你正是最接近的活物。 \\n\\n&4&l亡者之王&r是最难对付的Boss，他有400个&c心脏&r，也是唯一一个拥有真实Boss条（和专属音乐）的Boss。他能使用各类&3法术&r，从任何职业中施放，如&2自然&r的&2毒箭&r、&6神圣&r的&6诅咒&r，甚至&a召唤&r的&a獠牙&r！他还能传送、召唤亡者，并用&4血之法杖&r攻击你。 \\n\\n若能击败他，他会掉落各种&3卷轴&r、&7空白符文&r，并可能掉落&4血之法杖&r和《亡灵之书》。"
		"{image:atm:textures/questpics/iron_spells/spells_king.png width:100 height:200 align:center}"
	]
	quest.0436DF3308681913.title: "&4&l死去的国王"
	quest.043A424FDDA71692.quest_desc: ["ME流体输入！为多联块中的工艺提供流体，甚至在舱门内就储存有库存！"]
	quest.043A424FDDA71692.quest_subtitle: "ME流体输入接口"
	quest.04440BB2EFFD6DD9.quest_desc: ["在迷宫沼泽的深处有一只巨大的&c牛蘑菇&r。\\n\\n击败后，它会掉落&e米夫斯特罗加诺夫&r。要解锁下一个区域，你必须吃掉它。"]
	quest.04440BB2EFFD6DD9.title: "&c强力米夫斯特罗加诺夫炖肉"
	quest.0447551EF7FB171B.quest_desc: ["不需要再处理了，这不是&4血液&r测试，只是燃料！ \\n\\n把&4基座&r接到&c&l锻造炉&r上，看着&4血液&r流进去！"]
	quest.0447551EF7FB171B.title: "&4血液"
	quest.045942C709C63044.quest_desc: [
		"很简单。"
		""
		"&6产生&r电力。"
		""
		"由&b煤炭&r和其他&n固体&r&b燃料&r制成。"
		""
		"{image:justdirethings:block/generatort1_top width:100 height:100 align:center}"
	]
	quest.045942C709C63044.quest_subtitle: "名副其实，名不虚传，名副其实，名不虚传"
	quest.045D5406A58CA1A9.quest_subtitle: "恭喜你！你已完成 MI！"
	quest.0460DDEEFDEB0AAF.quest_desc: ["占卜杖是我们用来联系灵体以寻找特定物品的工具。\\n\\n首先，你需要通过用杖子右键单击物品，或用杖子和其&e炼金硫磺&r合成，来选择方块或物品！\\n\\n手持杖子并按住右键，杖子会开始寻找选定的物品。它会发出声响，并且杖子会亮起，亮度表示方块或物品的远近。\\n\\n如果足够近，可能会出现一个光球，为你指引物品的方向。"]
	quest.0460DDEEFDEB0AAF.title: "占卜之杖 (Divination Rods)"
	quest.04636DE704AD7B0B.quest_desc: ["觉得高压釜还不够用吗？那么，这个多区块结构将填补你的空缺！这个大型结构是单方块高压釜的直接替代品！"]
	quest.04636DE704AD7B0B.quest_subtitle: "来制作一些水晶吧！LCC"
	quest.04665EFC3A37250E.quest_desc: ["杀死 8 只 &7银鱼&r。"]
	quest.046C417B2ADF3AA7.quest_desc: ["卡牌有其极限。物品提取每操作只能提取8个物品。流体提取也只有5桶。化学能和能量就更别提了。 \\n\\n这是经过模组修改的 &2&lMinecraft&r，这些限制远远不够，我们需要超频它们。 \\n\\n在卡牌的右上角放入一些超频器，就能提升它们的传输上限！"]
	quest.046C417B2ADF3AA7.quest_subtitle: "最大值：4"
	quest.0478F6ADEF7ACEB9.quest_desc: ["&l&b镇压权杖&r&r会阻止生物在64格半径内自然生成。"]
	quest.0478F6ADEF7ACEB9.title: "&l镇压权杖 Staff of Suppression"
	quest.0480DF316ACF12DA.quest_subtitle: "西部冷杉 + 丛林"
	quest.048328EEBEEC9C94.quest_desc: [
		"&b防护服&r将保护你免受意外的&2辐射泄漏&r。"
		""
		"你需要&o全套&r装备。"
	]
	quest.048328EEBEEC9C94.title: "Hazmat"
	quest.0484051446480B54.quest_desc: ["伤害巨高，还能砍树！还需要别的吗？"]
	quest.0484051446480B54.title: "&6Allthemodium &5合金 &3斧头"
	quest.048BD38532A1DDCF.quest_subtitle: "最多可持有 100 万 LP"
	quest.048F2942436D3C46.title: "&6天空之主"
	quest.0496E8E786262464.quest_desc: ["我真的需要向你解释什么是&2主世界&r吗？"]
	quest.0496E8E786262464.title: "&2主世界&r: 3位首领的土地"
	quest.0498A578D0EC3254.quest_desc: ["在冶金注入器中用红石注入锇，就能制作出其中一个。"]
	quest.0498A578D0EC3254.quest_subtitle: "基础控制电路"
	quest.04A1D582003A0D9A.quest_desc: [
		"有效升级："
		"- 奔跑速度"
		"- 行走速度"
	]
	quest.04A2A00D41A94FEB.quest_desc: ["&b终极热传导体&r的&4热容&r为&a1.0&r，导热系数为&e5.0&r，但隔热系数为&c100000.0&r。"]
	quest.04A2A00D41A94FEB.title: "终极热力学导体"
	quest.04A371896B1E0CEC.quest_desc: [
		"再精炼一次电线，我们就能得到ZPM Field Generator所需的精细电线了。"
		""
		"不幸的是，我们需要相当多的精细导线，所以继续加工吧！"
	]
	quest.04A371896B1E0CEC.quest_subtitle: "增强"
	quest.04A69DE982F47E64.quest_desc: [
		"又到了大升级的时间！现在你可以用新的&bHV蒸汽涡轮机&r制造出&6最高512 EU/t&r的电力！除了发电量再次提升四倍外，它的运作方式与LV和&bMV蒸汽涡轮机&r完全相同。"
		""
		"现在你需要使用一套新的高压电缆。你需要使用&b铝&r或&b康铜&r电缆才能传输这个新的高压等级电力。"
	]
	quest.04A69DE982F47E64.title: "高压蒸汽涡轮机"
	quest.04A7AA70C23830FF.quest_desc: ["镰刀工具，可用于清理大量有机物。镰刀会破坏你挖掘的方块周围一定范围内的方块。"]
	quest.04B31A600004F7CB.quest_desc: ["此任务由 &6AllTheMods Staff&r 或 &2社区贡献者&r 为 AllTheMods 整合包创作。 \\n\\n由于所有 &6AllTheMods&r 整合包均受 &eAll Rights Reserved&r 许可，未经明确许可，不得将此任务用于非 &6AllTheMods Team&r 发布的任何公共整合包中。 \\n\\n此任务被有意隐藏，若你看到此信息，则表示你处于编辑模式。"]
	quest.04B40BB107F14330.quest_desc: ["肉绞机是一种用下界合金制作的近战武器。它有两种攻击方式：左键单击和按住左键。单击左键时，它会像斧头一样使用肉绞机，从较远的距离一次性击中敌人。而按住左键时，它会用锯片反复绞碎敌人，在近距离造成更快的伤害。"]
	quest.04B40BB107F14330.quest_subtitle: "直接来自《辐射3》DLC《匹兹堡》"
	quest.04B40BB107F14330.title: "肉末搅拌机"
	quest.04B6E31120663EB2.quest_subtitle: "等级：&a2"
	quest.04BCA6A8AE60D817.quest_desc: [
		"在炮台旁边的存储方块上放置一个&b物品展示框&r。然后将你想要的&b物品&r放入其中。"
		"&8炮塔现在只会放置该物品（抽屉也适用）"
	]
	quest.04BCA6A8AE60D817.quest_subtitle: "炮塔自动化帮助文档"
	quest.04BCA6A8AE60D817.title: "放置所选物品"
	quest.04BE9F63E6003475.quest_desc: ["&3LPG&r 可用于制作熔融塑料。"]
	quest.04BE9F63E6003475.quest_subtitle: "我们需要的就是这一件了"
	quest.04BE9F63E6003475.title: "LPG"
	quest.04C01A5FF3DAC326.quest_desc: [
		"这个特殊的附魔师使用碎片进行附魔。它会使用你的等级和碎片。"
		"你可以决定要施加的附魔，并且可以提升它们的等级。"
		"如果无法再使用，可能表示“已完成”，可以考虑与 Apotheosis 附魔结合使用以获得夸张的附魔效果。"
	]
	quest.04C01A5FF3DAC326.quest_subtitle: "请将此视为通往 Apotheosis 的入口"
	quest.04C21F7B2F034772.quest_desc: [
		"将&b超充线圈&r放置在每个朝向中心的面内中心位置。"
		""
		"这将把能量&6集中在一个&r&7加压源&r的&a钋气&r上，撕裂重原子并将其转化为&d反物质气体&r。"
	]
	quest.04C21F7B2F034772.title: "超充能线圈"
	quest.04D0543FE2820F64.quest_desc: ["亚麻线可用于替代普通线。"]
	quest.04D0543FE2820F64.quest_subtitle: "反正谁需要蜘蛛这种东西呢？"
	quest.04D0543FE2820F64.title: "亚麻纤维 线"
	quest.04D9F6587EF8D9B7.quest_desc: ["&9Potion Jar&r 最多可存放 100 瓶药水。使用空瓶或药水瓶作用于瓶身即可移除药水。 \\n\\nWixies 会在自动酿造药水时使用这些瓶子。"]
	quest.04D9F6587EF8D9B7.quest_subtitle: "储存药水 (Storing Potions)"
	quest.04DD3F761C210822.quest_desc: [
		"&c&l粗制高炉&r是我们生产&8钢&r的非常简单（且粗糙）的方法。 \\n\\n你需要投入一个&7铁锭&r和&0木炭&r或&0焦炭&r。 \\n\\n每个&8钢锭&r需要60秒来冶炼。 &0木炭&r能节省15秒，而&0焦炭&r能节省全部60秒。这些也可以用它们的方块形式来叠加。 \\n\\n我们还会得到炉渣……这东西没什么用。"
		"{@pagebreak}"
		"这个又是一个 3x3x3 的，只不过这次用的是 &cBlast Bricks&r。"
		"{image:atm:textures/questpics/immersive/immersive_crude1.png width:100 height:100 align:center}"
		"{image:atm:textures/questpics/immersive/immersive_crude2.png width:100 height:100 align:center}"
		"{image:atm:textures/questpics/immersive/immersive_crude3.png width:100 height:100 align:center}"
		"又到了用我们可靠的&6锤子&r右键点击前方中间方块的时候了！"
		"{image:atm:textures/questpics/immersive/immersive_crude.png width:100 height:100 align:center}"
	]
	quest.04DD3F761C210822.title: "&l&c原始高炉"
	quest.04DEC6E210F06D65.quest_subtitle: "巴尔萨木 + 科科波罗木"
	quest.04E2D539E33B7B0F.quest_desc: ["这台机器能将两种气体结合，生成一种新气体。\\n\\n你需要用它将氯气和氢气结合，生成氯化氢，然后用于我们的化学注射室。"]
	quest.04E2D539E33B7B0F.quest_subtitle: "化学合成器 (The Chemical Combiner)"
	quest.04E6DF90BA2FCACB.quest_desc: [
		"该装置可将&6压缩空气&r转换为&7Forge Energy&r（&b兼容RF及许多其他模组的能量&r）（&9）（&r）。"
		""
		"它的&3基础效率&r为&a40%&r，即&7100 mL空气&r可产生&b40 FE&r。"
		""
		"&b速度升级&r会略微&c降低&r这种&a效率&r。"
		""
		"&bDynamo&r 还会&6产生&r &4热量&r，需要加以管理，以免&c效率&r &a下降&r。"
	]
	quest.04E9253AB8F17A07.title: "移除附魔效果（Removing Echantments）"
	quest.04F5846E2468E807.quest_desc: ["&b&lMacaw's Doors&r 添加了各种不同类型的门和门的变种。 \\n想要桦木风格但用云杉木？没问题！ \\n\\n甚至还有医院门！"]
	quest.04F5846E2468E807.title: "&b&l鹦鹉螺之门 (Macaw's Doors)</c2></c1>"
	quest.0501F76E80B4BC31.quest_subtitle: "带上你的镐子一起来吧！"
	quest.0501F76E80B4BC31.title: "小型地下迷宫"
	quest.050AAD831C0AE375.title: "重焕活力的血肉"
	quest.050CCE5D1DD6B21E.quest_desc: [
		"最重要的多联方块之一，主要是因为我们需要它来制作 Modularium。 \\n\\n你需要流体输入口（每个输入口只能容纳一种流体，所以需要多个）、能量输入口，以及物品输入和输出口。 \\n\\n使用这些接口，我们可以输入所有物品、流体和能量，它就会像其他多联控制器一样，为我们合成物品！ \\n\\n或者合成我们需要的 &6星部件&r！你需要大量的血液、奥瑞尔、灵魂和能量来制作它们！"
		"{@pagebreak}"
		"{image:atm:textures/questpics/chap3/creative_forge1.png width:100 height:100 align:center}"
		"第一层最复杂。中间由各种&c机器外壳&r和&c零件&r围成圆形。角落放置符文方块和&b神秘水晶&r。其余部分用&9抛光暗石&r、&9台阶&r和&6神秘抛光&r方块。"
		"{image:atm:textures/questpics/chap3/creative_forge2.png width:100 height:100 align:center}"
		"仍在第一层，我们需要将一些&c机器外壳&r替换为舱门！"
		"{image:atm:textures/questpics/chap3/creative_forge3.png width:100 height:100 align:center}"
		"在之前的&c机器零件&r圆圈上方，我们将添加&6镀金凿刻抛光暗石&r和&6凿刻神秘抛光暗石&r。然后用&9抛光暗石&r、&9台阶&r和&9石板&r填充其余部分。别忘了在&b神秘水晶块&r上方放置4个&b神秘水晶方尖碑&r！"
		"{image:atm:textures/questpics/chap3/creative_forge4.png width:100 height:100 align:center}"
		"现在，在我们的&6Gilded Chiseled Polished Darkstone&r上方，可以放置&6Pedestals&r和Forge。还有最后4个&bArcane Crystal Obelisks&r。"
		"{image:atm:textures/questpics/chap3/creative_forge5.png width:200 height:100 align:center}"
		"最后是再放几个活板门！我们需要它们！"
	]
	quest.050CCE5D1DD6B21E.title: "&c&l自动赫菲斯托斯锻造炉"
	quest.050CD33E92601651.quest_desc: [
		"&c&lTier 1&r还不够用？那就需要升级了！ \\n\\n将一块Edelwood Plank放入&6&lForge&r的中心槽位，并在基座上放置4个&bArcane Crystals&r和4个Spawner Scrap。 \\n\\n用Gavel敲击它，你的&c&lTier 1&r就会升级为&3&lTier 2 &6Forge&r！ \\n\\n现在，新的Rituals将可用，&6&lForge&r能容纳更多Essences，你还可以使用第二个Relic！"
		"{image:atm:textures/questpics/forbidden/forbidden_tier1.png width:100 height:100 align:center}"
	]
	quest.050CD33E92601651.title: "&l&3第2级 &6锻造台"
	quest.050D8480EE9D8E62.quest_desc: [
		"Wigglewood 森林与其他森林并无不同。 \\n\\n只是这里的树木喜欢随心所欲地移动。"
		"{image:atm:textures/questpics/undergarden/undergarden_wiggle.png width:200 height:100 align:center}"
	]
	quest.050D8480EE9D8E62.title: "扭扭木森林"
	quest.0515422E36E4E9A3.quest_desc: ["潜行时获得隐身效果。"]
	quest.0518551637F76C50.quest_desc: ["有点贵，但&9Echoing Deep Shelf&r比&bSeashelf&r好多了。顺便一提，要提升附魔等级得杀不少warden...早知道该提醒你。另外，最大&aEterna&r提升至&a75&r。"]
	quest.0518551637F76C50.title: "&9回响的深海书架"
	quest.051E0C85E7B71CE0.quest_desc: ["我猜你一直在挖矿，对吧？毕竟这是 MINEcraft 嘛。\\n\\n你会发现一堆可能让你困惑的新矿石，不过先用原版材料也能玩得转！\\n\\n铜储量丰富，用途广泛，比如制作 &aOre Hammers&r 或 &eDrawer Upgrades&r，所以一定要多收集一些！\\n\\n铁可能是你遇到时最想收集的重要矿石之一。模组化的 MC 世界几乎都靠铁来运转。"]
	quest.051E0C85E7B71CE0.title: "&9金属&r时代"
	quest.052980924E1F11B4.quest_subtitle: "这些稀有生物能承受任何高度的坠落，但仍需妥善照料。"
	quest.052BE1D845794702.quest_subtitle: "柚木 + 金合欢木"
	quest.053483E3349B2F8A.quest_desc: [
		"这个结构看起来和悬空花园很像，但只有一个巨大的花园。你可以通过&bLuminescent Ancient Wax&r上的&b蓝色&r来辨认出它就是&bBlue Sempiternal Sanctum&r。 \\n\\n进入结构，一路向下走到最底层的房间（小心Sentry Watchers），在那里你会找到&bBlue Essence&r。 \\n\\n走进去，准备好屏住呼吸。你需要在水下对抗成群的Drowneds、Guardians和Elder Guardians。全部消灭后，你将获得……"
		"{image:atm:textures/questpics/bumblezone/bumble_blue1.png width:200 height:100 align:center}"
		"{image:atm:textures/questpics/bumblezone/bumble_blue2.png width:200 height:100 align:center}"
	]
	quest.053483E3349B2F8A.title: "&b蓝色永恒圣所"
	quest.0539AF15A10B2859.quest_desc: ["Hyperboxes 和 Compact Machines 很像！\\n\\n放置并命名 Hyperbox 后，你可以进入其中。这将把你带到 Hyperbox 维度。\\n\\n在这里，你会身处自己刚制作和命名的 Hyperbox 中，它是一个 13x13x13 的立方体。在生存模式下，你不能破坏 Hyperbox 的墙壁，但可以右键点击 Aperture Blocks 来离开。"]
	quest.0542FE108089A0A2.quest_desc: ["&l&6Theurgy&r 就是用魔法进行炼金术的艺术！或者在我们这里，就是用机器和物品来制造更多或不同的物品！ \\n\\n制造 &l&6Theurgy&r 所需的许多机器都需要铜，所以先从铜开始吧！"]
	quest.0542FE108089A0A2.title: "&l&6Theurgy"
	quest.0547229FF5334CF5.quest_desc: ["&b接口&f就像箱子一样，你可以将物品或流体&a放入&f&b接口&f中，它会自动从网络中&5拉取该物品&f来保持库存。"]
	quest.054D2D3C20C2D32F.quest_desc: [
		"你做到了！"
		""
		"就是这个！你能制作的最高阶处理器！"
		""
		"但你还没完事……这可能是最后一个处理器了，但后面还有更多内容。从这里开始，事情会变得更加有趣！"
	]
	quest.054D2D3C20C2D32F.quest_subtitle: "太棒了，成功完成！！！"
	quest.054DC93067884DA6.quest_desc: ["&c岩浆&r蜜蜂的家园。"]
	quest.054DC93067884DA6.quest_subtitle: "铁剑 + 下界砖块"
	quest.054F3A0499F8A0D8.quest_subtitle: "甜栗 + 卡波阿苏果"
	quest.055CCAE237DF3EEF.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_ironwood.png width:100 height:150 align:center}"]
	quest.055CCAE237DF3EEF.title: "&8Ironwood"
	quest.056000388DAD3E1B.quest_subtitle: "用于将网络根连接到存储方块，如箱子和桶。连接双箱时，请确保只有一个电缆连接到双箱，而不是每个单箱各一个电缆。"
	quest.056000388DAD3E1B.title: "制作一根 &d链接线缆"
	quest.05607C56B0320CD7.quest_desc: ["IO Port 可以让你快速地将存储单元中的数据填充到或从网络存储中清空。"]
	quest.05607C56B0320CD7.quest_subtitle: "输入/输出"
	quest.05618FE80F2E0372.quest_desc: [
		"&9Infusion Crystal&r 用于升级到更高级别的 &dEssences&r。"
		""
		"首先，你需要用 &2Inferium&r 制作第一阶水晶。用 4 个 Inferium 和水晶结合，可以制作出 &ePrudentium&r。这将用于制作下一阶水晶，进而制作下一阶的精华。"
		""
		"最终，你将能制作出适用于所有等级且不会损坏的融合水晶！"
	]
	quest.05618FE80F2E0372.title: "&9灌注水晶 (The Infusion Crystal)</c1>"
	quest.056E1E3B1ED14917.quest_subtitle: "柚木 + 深色橡木"
	quest.0573B6F1BE5110FD.quest_desc: ["&2&lMinecraft&r Bees are adorable but the limited things Honey gives us isn't enough to justify the work to get it. \\n\\nWell unless you can get just about anything from the Bees, then that'd be different!"]
	quest.0573B6F1BE5110FD.title: "&e&l勤劳的蜜蜂&r"
	quest.05747711CC03281C.quest_desc: [
		"The &6&lEnchanter's Tower&r&r is where the &6&lEnchanter&r&r will create enchanted books, as long as they have &9&lAncient Tomes&r&r. The &6Enchanter&r will observe other workers throughout their daily routines in order to &9collect experience&r to create enchanted books. The higher their &lM&9ana&r&r level, the &9more XP&r they will collect per trip. They will &cnot&r apply the enchanted books to tools and armor, you must do that yourself. Enchanters do &cnot&r take XP from workers, they simply gain it by &nobserving&r."
		""
		"&l&6Enchanter's Tower&r&r 的等级越高，&6Enchanter&r 生产的附魔书等级就越高"
	]
	quest.05747711CC03281C.quest_subtitle: "&6附魔师的塔楼"
	quest.05747711CC03281C.title: "&6&l如果不能才华横溢地惊艳他们，就用神秘莫测让他们困惑！"
	quest.0576C32B0FB360B0.quest_desc: [
		"月之巨兽有200点生命，除非使用火焰，否则每次攻击只能造成1点伤害。 \\n\\n它会使用地面尖刺、投射物和爆炸纠缠头颅等攻击！ \\n\\n击败它会掉落箭矢、锭、纠缠头骨、坚韧花瓣、被困灵魂，并有几率掉落稀有武器！"
		"{image:atm:textures/questpics/eternal/starlight_lunar.png width:100 height:125 align:center}"
	]
	quest.0576C32B0FB360B0.title: "月球上的怪物"
	quest.0578945AE9664476.quest_subtitle: "在试炼与觉醒的传送门内掉落。"
	quest.0583862ED0114442.quest_subtitle: "&f4 &c攻击伤害"
	quest.05839D9537FA2FDD.quest_desc: [
		"步骤4：酒馆"
		""
		"你的殖民者需要睡觉的地方和住所，所以建议接下来建造一家酒馆。酒馆还能让访客来到你的殖民地，你可以招募他们成为公民。"
	]
	quest.0584073A7383E0EA.quest_desc: [
		"Some of the &5Queen Bee&r Quests might seem annoying because there isn't many places to farm &dEndermites&r and &7Silverfish&r. \\n\\nWell there wasn't until recent updates! Welcome to the Mite Fortress! \\n\\nIn the massive spiky &7Stone&r structures you'll find &7Silverfish&r galore (plus loot especially within the &5Obsidian&r). \\n\\nIn the middle of the structure, with everything &5Purple&r colored, will be &dEndermites&r. \\n\\nBTW did you know that &8B&6e&8e&6s&r will attack &dEndermites&r and &7Silverfish&r! Charge into battle with them to win the heart of their &5Queen&r!"
		"{image:atm:textures/questpics/bumblezone/bumble_mite.png width:200 height:100 align:center}"
	]
	quest.0584073A7383E0EA.title: "螨虫堡垒"
	quest.05850541675B2493.quest_desc: ["是的。\\n\\n你创造了 &6&lATM Star&r，这意味着你已经通关了该整合包！\\n\\n那么，接下来呢？"]
	quest.05850541675B2493.quest_subtitle: "这是否意味着你赢得了比赛？"
	quest.05850541675B2493.title: "&6&lATM Star"
	quest.0589911EB4D30FAD.quest_desc: ["&l&cRegions Unexplored&r 还增加了将木板涂成羊毛或玻璃的效果！"]
	quest.0589911EB4D30FAD.title: "彩绘木板"
	quest.0591CAFD665CE151.quest_subtitle: "等级：&b4"
	quest.0596F6C70758EEC0.quest_desc: ["虽然最贵，但它们也是最漂亮的！ \\n\\n而这正是建筑所看重的！"]
	quest.05A0AC380BB141A0.quest_desc: ["&b限制运输机&r是一种&b物流运输机&r，它几乎就像一个“&6溢出&r”管道。一旦&3物品&r无处可去，它们就会&6通过&r&b限制运输机&r进行运输。"]
	quest.05A0AC380BB141A0.title: "限制性运输机"
	quest.05A4496705B6C6AF.quest_desc: [
		"Beehemoth 是一种独特的 &6B&8e&6e&8s&r，更像是野生的飞行马。 \\n\\n可以通过喂食瓶装或桶装的液态 &6Honey&r 来驯服它们。 \\n\\n它们有一个友谊度，决定了你是否驯服了它们，以及它们的移动速度和生命值！喂食会提高友谊度，而受到伤害则会降低友谊度。 \\n\\n一旦友谊度达到最高，它们就会变成 &5Queen Beehemoth&r！ \\n\\n它们会像牛追小麦一样，跟着 &6Honey Buckets&r 走，（也可以试试用 Royal Jelly 喂它们）。"
		"{image:atm:textures/questpics/bumblezone/bumble_beehemoth.png width:100 height:100 align:center}"
	]
	quest.05A4496705B6C6AF.title: "Beehemoth"
	quest.05A845C811A9A4A0.quest_desc: [
		"虽然 &bManaweave Robes&r 的整体防护性不是最强的，但套装加成相当给力！"
		""
		"穿戴全部四件后，使用法力工具和法杖时的法力消耗将有所折扣。该套装还能使用背包中的法力来自我修复。"
	]
	quest.05A845C811A9A4A0.title: "Manaweave Robes"
	quest.05B0A7D0B991050F.title: "反应堆（硬化版）"
	quest.05B2AA73EAEDCCF4.quest_desc: [
		"这些 &b出口总线&r 的功能比普通 &b出口总线&r 更强大。"
		""
		"&bTag Export Bus&r 用于导出过滤标签中的物品。"
		""
		"&bMod Export Bus&r 导出已过滤模组中的物品。"
		""
		"&bPrecise Export Bus&r 会精确导出你设定的物品数量，不多也不少。"
		""
		"&bThreshold Export Bus&r会在物品数量高于/低于设定阈值时导出物品。"
	]
	quest.05B2AA73EAEDCCF4.title: "高级导出总线 (Advanced Export Buses)"
	quest.05B51A9CB2D9EE54.quest_desc: ["用铜蜜蜂和锌蜜蜂杂交繁殖。"]
	quest.05B51A9CB2D9EE54.quest_subtitle: "蜜蜂繁殖"
	quest.05B5E640F1B68A28.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_golem.png width:100 height:150 align:center}"]
	quest.05B5E640F1B68A28.title: "&3Golem Steel&r"
	quest.05B6DB75AEC01187.quest_desc: [
		"RFToolsPower 有 &9Powercells&r 来储存电力，这是一种可定制和升级的多方块储能单元。"
		""
		"你需要一把扳手来确定能量的输入和输出。"
	]
	quest.05B6DB75AEC01187.quest_subtitle: "RFTools"
	quest.05B6DB75AEC01187.title: "RFTools 的能源电池"
	quest.05B8C64EB012F6EA.quest_desc: ["另一个方法是使用Chronal exchange；先获得12小时的mahou，再花12小时消耗。当第一个开始消耗时，制作第二个Chronal exchange circle，就会形成一个循环。"]
	quest.05B8C64EB012F6EA.title: "Chronal Exchange"
	quest.05B977269171EB06.quest_desc: [
		"火箭需要一个发射平台，所以我们需要制作一个&a发射台&r。"
		""
		"使用时，将其放置在视野开阔、能看向天空的任何地方。有了火箭后，可以将其放置在发射台的中央。"
	]
	quest.05B977269171EB06.title: "&e冲向太空的发射"
	quest.05CC534A0DE3868A.quest_desc: [
		"要建造&6&l下界矿井&r&r，需要在&9&r大学&6&r进行研究，&6&l下界矿工&r&r也在此工作。下界矿工&6&r会前往&c&r下界开采资源。小屋的等级决定了&6&r下界矿工带回的物品。"
		""
		"&c&l注意：&r&r下界矿井中的传送门会将玩家传送到下界。但是，&6下界矿工&r &c并不会&r真正进入下界，也并不会在下界挖掘任何方块。"
	]
	quest.05CC534A0DE3868A.quest_subtitle: "&6下界矿井"
	quest.05CC534A0DE3868A.title: "&6&l这个地方简直是“地狱”般的矿井！"
	quest.05D20B506213A449.quest_desc: [
		"将&9涡轮转子&r放置在涡轮的中央。每个涡轮转子需要2个&a涡轮叶片&r。本涡轮将使用3个转子。"
		""
		"看向转子，用&a涡轮叶片&r右键即可直接将其放置在转子上。转子越高，叶片越长。本建筑共使用6片叶片。如果你打算建造更大的涡轮机，则需要根据计划使用的叶片数量来增加涡轮机的宽度。"
		""
		"&9旋转复合体&r必须放置在涡轮转子的顶部。然后用&e压力分散器&r将其包围。"
		""
		"分散器必须填满旋转复合体所在的那一整层。"
	]
	quest.05D20B506213A449.title: "&a转子叶片"
	quest.05D6CE1B501F59B5.quest_subtitle: "用于星星组件的星星组件的一颗星星"
	quest.05D8C6EF8FCD6250.quest_desc: [
		"Primogel Goo 是 JDT 添加的第一级凝胶，需要基本主世界材料来制作。"
		""
		"已解锁的配方："
		"- Ferricore"
		"- 原始煤炭"
		""
		"Goo Spread 示例："
		""
		"{image:atm:textures/questpics/justdirethings/goo_spread_ferricore.png width:200 height:200 align:center}"
	]
	quest.05DBDD86FCFF3BA8.title: "&5闪电&r升级球体"
	quest.05E2E87CF3F9A5FB.quest_desc: ["由 &4红石&r 和 &c柴油&r 制成，用于 &b速度升级&r。"]
	quest.05E2E87CF3F9A5FB.title: "&6润滑剂"
	quest.05E668CE6687AC64.quest_desc: ["&b欢乐代币&r是你应该制作的第一个代币，代币是&a自然光环&r中物品的重要合成材料。"]
	quest.05E668CE6687AC64.title: "&b喜悦的代币"
	quest.05E7C7E41BA79426.quest_subtitle: "四重充电"
	quest.05F0FCBBEADA8489.quest_desc: ["你可以在&a程序1&r上使用&e流体加热器&r或&e蒸馏器&r，将&3溶解的乙酸钙&r转化为&c丙酮&r"]
	quest.05F186C95510BD4B.quest_desc: [
		"放置后，&9Mega Torch&r 会在 64 格半径内阻止所有敌对生物自然生成。"
		""
		"非常适合阻止敌对生物在基地黑暗区域的生成"
	]
	quest.05F186C95510BD4B.title: "防止生物生成 (Preventing Mob Spawns)"
	quest.05F428C34DD00B61.quest_subtitle: "蓝色远方 + 摇曳的柳树"
	quest.060233F903FAE63B.quest_desc: ["这些板子对于制造更多&dLuV&r级别的机器很重要。"]
	quest.060233F903FAE63B.quest_subtitle: "这是我的&dLuV&r语言！"
	quest.060233F903FAE63B.title: "LuV Machine Casing"
	quest.06044B4452A6B720.quest_desc: ["放置在沙漠生物群系中，沙巢会吸引巧克力或灰采矿蜜蜂。"]
	quest.06044B4452A6B720.quest_subtitle: "在沙漠生物群系中吸引蜜蜂"
	quest.06094615950AC062.title: "其他传送带升级组件"
	quest.060D9F59EB26C7BD.title: "氯化氢"
	quest.061244C38F05CBFE.quest_subtitle: "史诗级"
	quest.061244C38F05CBFE.title: "&5秘法种子&r"
	quest.061C09A44A80D7D8.quest_desc: [
		"获取&bWixie's Enchanting Apparatus&r"
		""
		"&l1. 它到底有什么了不起的？&r"
		"将 &1x 个物品&r 放入 &bx 个基座&r 中，"
		"为什么不把所有&1材料&r放在一个&b箱子&r里，把&c产物&r放在一个&b基座&r里？"
		""
		"&l2. 如何获取？&r"
		"&6Right click&r the &bEnchanting Apparatus&r with a &bWixie Charm &r"
		"将其转换为&bWixie's Enchanting Apparatus&r"
		""
		"&l3. 运作方式？&r"
		"和&5Wixie Charm&r的概念一样。去看看那个任务吧 :)"
		""
		""
		"&8(提示：基座可以高一格/低一格)&r"
		"&4注意&r：范围将与&bWixie 炼药锅&r相同"
	]
	quest.061C09A44A80D7D8.quest_subtitle: "自动建造时间到了吗？"
	quest.061C09A44A80D7D8.title: "更好的附魔装置？(Better Enchanting Apparatus?)"
	quest.06242EEB80032F27.quest_desc: [
		"为我们的武器库再添一个洁净室！不过这个不仅能保证房间干净，还能对环境进行消毒。"
		""
		"我们可以在洁净室中使用有机材料，再也不用担心污染物了！"
	]
	quest.06242EEB80032F27.quest_subtitle: "2号洁净室"
	quest.06294216A755E2F2.quest_desc: ["烈焰棒用于制作火焰卷轴。"]
	quest.062AA943A1629A86.quest_desc: ["你把&cR&6a&ei&2n&3b&9o&5w&r &cF&6u&er&2n&3a&9c&5e&r炸了?!?! 就在旁边点了TNT？你疯了吗？那可是花了好多熔炉和资源，你就把它炸了！！！好歹也弄到什么好东西没？&cR&6a&ei&2n&3b&9o&5w&r &cC&eo&3a&5l&r？能永远用的煤炭？那其实还挺值的。"]
	quest.062AA943A1629A86.title: "&cR&6a&ei&2n&3b&9o&5w &cC&eo&3a&5l"
	quest.0631F054A9B97A40.title: "正在创建符文（Creating Runes）"
	quest.063241B72BB3403E.quest_desc: ["&0&l重型板甲盾&r的用法和普通盾牌一样，放在副手用来保护自己。 \\n&0&l重型板甲盾&r的耐久度更高，能抵挡的伤害也更多。 \\n\\n对了，它还能升级！可以使用&6工程师工作台&r来添加这些升级。 \\n\\n盾牌最多可以安装2个升级。"]
	quest.063241B72BB3403E.title: "&8&l重型板甲盾牌"
	quest.0633D2B1E1DB778B.quest_desc: ["通过&6冶炼&bCertus Quartz Dust&f获得，&bSilicon&f将用于三种不同的处理器，你需要继续推进。"]
	quest.0633D2B1E1DB778B.title: "硅晶圆"
	quest.06387AA1DCEA9FB3.quest_desc: ["As you go deeper into &l&eThe Cursed Pyramid&r&r, you start to see &esuspicious sand&r here and there. If you &ebrush&r the suspicious sand, you have a chance to get a &l&edesert necklace&r&r. &e&lThe Necklace of the Desert&r&r is required to awaken &l&eThe Ancient Remnant&r&r."]
	quest.06387AA1DCEA9FB3.title: "&e&l沙漠项链 (Necklace of the Desert)</c2></c1>"
	quest.063F5023D56CA6B1.quest_desc: ["聚乙烯设置好后，你可以在装配器里改用制作机器外壳以节省材料"]
	quest.064BBCC379A69748.quest_desc: ["这个炉子比原版的好上两倍，效率也更高！虽然比不上其他炉子模组，但对于纯MI玩法来说，这个炉子非常强大！"]
	quest.0650996C7818ADB5.quest_desc: ["热能发电机有2种发电模式：\\n\\n&9被动模式：&r用岩浆源或流动岩浆块包围发电机，通过产生热量来发电。在顶部放置一个岩浆源块，并让它从侧面流下。务必先连接管道！\\n\\n&9主动模式：&r将煤炭或木材等可燃物放入发电机，燃烧燃料来发电。"]
	quest.0650996C7818ADB5.quest_subtitle: "基础电力生成器"
	quest.0653401A7B3A8EDC.quest_subtitle: "存储系统的基础。请求表必须与网络根相连，所有存储方块都需通过线缆连接到根。每个系统只能使用一个根。"
	quest.0653401A7B3A8EDC.title: "制作一个 &cStorage Network Root"
	quest.0661E9669E639621.quest_desc: [
		"有些树苗无法被授粉。这些树苗有随机几率长成另一种树。"
		""
		"例如，如果你想获得一棵&7红花紫薇树苗&r，就先种一棵紫花紫薇树苗。这样你就有机会得到一棵&7红花紫薇&r树！"
	]
	quest.0661E9669E639621.quest_subtitle: "还有更多的随机数生成器内容"
	quest.066438B01655D866.quest_desc: ["它们的&d精粹&r很有用，但我们也可以捕捉这些灵魂以备后用。听起来很邪恶，不是吗？\\n\\n要成为灵魂猎人，你首先需要制作&d复仇焦点&r。用它来&a冻结灵魂&r，然后在灵魂附近放置一个&9永恒闭合之箱&r。这样就能将灵魂吸入其中，供日后使用。"]
	quest.066438B01655D866.title: "捕捉&d灵魂"
	quest.066B8A75B299AED8.quest_desc: [
		"&9&lSqueezer&r 是一种简单的机器，可将 &e物品&r 挤压成其他 &e物品&r 或 &b流体&r。 \\n\\n我们可以使用背面的 2 个端口来 &9输入 &e物品&r。然后需要使用桶右侧的端口来将 &e物品&r &6取出&r。该端口下方的端口会 &6输出 &b流体&r。 \\n\\n这主要用于将小麦种子或大麻种子等作物种子挤压成植物油！ \\n\\n有些种子能产出更多油，查看 &6指南&r 了解每种种子的产出。 \\n\\n我们还需要使用 &9&lSqueezer&r 来从 8 个 &0焦炭粉&r 中获得 &0HOP 石墨粉&r。"
		"{@pagebreak}"
		"和&2&lFermenter&r的开头完全一样。"
		"{image:atm:textures/questpics/immersive/immersive_squeezer1.png width:100 height:100 align:center}"
		"就像&2&l发酵器&r一样，只是用木桶代替炼药锅！"
		"{image:atm:textures/questpics/immersive/immersive_squeezer2.png width:100 height:100 align:center}"
		"在&e轻型工程方块&r和&4红石工程方块&r之间的桶上方放置活塞。在其他3个桶的顶部放置&8钢制围栏&r！"
		"{image:atm:textures/questpics/immersive/immersive_squeezer3.png width:100 height:100 align:center}"
		"非常简单，用&6锤子&r右键活塞下方的桶。"
		"{image:atm:textures/questpics/immersive/immersive_squeezer.png width:100 height:100 align:center}"
	]
	quest.066B8A75B299AED8.title: "&9&l榨汁机"
	quest.066F78936C8F943B.quest_desc: ["此任务由 &6AllTheMods Staff&r 或 &2社区贡献者&r 为 AllTheMods 整合包创作。 \\n\\n由于所有 &6AllTheMods&r 整合包均受 &eAll Rights Reserved&r 许可，未经明确许可，不得将此任务用于非 &6AllTheMods Team&r 发布的任何公共整合包中。 \\n\\n此任务被有意隐藏，若你看到此信息，则表示你处于编辑模式。"]
	quest.0672462DA3599484.quest_subtitle: "512,000mb"
	quest.06767BA0AFE8C1EE.quest_desc: ["1... 2... 还有个4在某个地方。 \\n\\n要设置数字，先放入物品，然后左或右键更改数量。按住Shift再操作可一次增减10。设置好数字后，将其放入卡片！ \\n\\n之后它会等待直到有指定数量的物品才开始收集。同时也会将剩余的物品留在第一个物品栏中。"]
	quest.067AB3E4C4492F0D.quest_desc: [
		"不想挖一堆矿石？不妨让路由器代劳吧！\\n\\n你可以用放置器放置矿石，再用附魔破坏器来挖掘。破坏器需要先用制作它的镐子进行附魔，模块本身无法被附魔。\\n\\n你可能还需要另一个路由器来拾取掉落的矿石。"
		"{image:atm:textures/questpics/router/router_break.png width:150 height:80 align:center}"
	]
	quest.067AB3E4C4492F0D.title: "用于采矿的路由器"
	quest.068294A7C21DE550.quest_desc: ["&c轨道套件&r可用于与&6铁轨&r合成特殊的&6轨道&r。\\n\\n这些&6轨道&r在一切与&5火车&r相关的事情上都会很有帮助，例如：让&5火车&r停下、移动&5火车&r以及发出红石信号。"]
	quest.068294A7C21DE550.title: "&c&l轨道&r！"
	quest.0682DC1F2417DAEB.quest_desc: ["Functional Storage 是一款存储模组，添加了各种实用物品，有助于存储和存放同种物品的堆叠。\\n\\n这对像 Cobblestone、Dirt 等物品非常有用。"]
	quest.0682DC1F2417DAEB.quest_subtitle: "储物抽屉的远方亲戚"
	quest.0682DC1F2417DAEB.title: "功能性存储系统"
	quest.068728DE3B9B13C3.quest_desc: [
		"&d超临界相移器&r（简称 SPS）是另一种多方块结构，用于向钋注入大量能量以生成可结晶成颗粒的&d反物质&r气体。"
		""
		"建造SPS需要总共72个&9SPS外壳&r（建造用60个，端口用12个）、3个&9SPS端口&r、122个反应堆玻璃，以及我们将在下一个任务中提到的另一物品。先收集材料吧！"
	]
	quest.068728DE3B9B13C3.title: "&d超临界相移器"
	quest.069382B7A2FC7D35.quest_desc: [
		"未使用&b蒸馏水&r时，效率会随时间&6降低&r、&c下降&r至最低&e33%&r。"
		""
		"使用&b斧&r敲击&b锅炉&r会重置其钙化状态。"
	]
	quest.069382B7A2FC7D35.quest_subtitle: "使用太阳能代替化石燃料。"
	quest.0696635896D223CA.quest_desc: ["灰胡子法杖正如其名，会赐予你灰胡子……开个玩笑，这根法杖能帮你恢复法力，还能增强卷轴威力。这是最容易制作的法杖之一。"]
	quest.0696B725E840B996.quest_desc: [
		"要将物品进出裂变反应堆，我们需要&a裂变反应堆端口&r。使用&9配置器&r可将它们设为输入或输出。\\n\\n每个裂变反应堆&a至少需要4个端口&r：\\n\\n - 1个冷却剂输入\\n - 1个冷却剂输出\\n - 1个裂变燃料输入\\n - 1个废料输出\\n\\n对于这个初始建造，让我们在每侧都放置一个端口，如下图所示。确保配置与输入输出列表一致！"
		"{image:atm:textures/questpics/mek/port_example.png width:200 height:200 align:1}"
	]
	quest.0696B725E840B996.title: "与裂变反应堆进行交互"
	quest.06A7A3FC8634D2DA.quest_subtitle: "等级：&c5"
	quest.06AD25DB96F3A1CC.quest_desc: [
		"像温度计一样，这些容器里装着&c汞&r！\\n\\n无论是&c汞晶&r还是&c碎片&r，里面都装着&c汞&r。"
		"{image:atm:textures/questpics/theurgy/theurgy_vessel_1.png width:100 height:125 align:center}"
	]
	quest.06AD25DB96F3A1CC.title: "&c水星&r容器"
	quest.06B12750EF857686.quest_desc: [
		"&e&l渡鸦羽毛&r&r是渡鸦掉落的一种物品，每只渡鸦最多可掉落2个。"
		""
		"&e&lTorchberries&r&r 是一种通过收割 Torchberry Plants 或击败 Skeleton Druids 获得的物品。"
	]
	quest.06B12750EF857686.title: "渡鸦羽毛和火炬浆果"
	quest.06B85804163DD18B.quest_desc: ["Soaryn 盒子（Soaryn 是 XyCraft 的作者）是 XyCraft 的箱子。\\n\\n它不会在方块被破坏时掉落物品！真想知道上面那些方块有什么用？"]
	quest.06BBD7B736C564C1.quest_desc: ["有了这个硅片，我们就能制作晶体管了！一种新的电子元件，太棒了！"]
	quest.06C4D99A90DF7711.quest_desc: ["The &bUltimate Injecting Factory&r allows you to process &a9&r injection recipes at once."]
	quest.06C4D99A90DF7711.title: "终极注入工厂"
	quest.06CD5693FF52270F.quest_desc: [
		"镧是一种柔软、延展性好的银白色金属，在空气中会缓慢氧化。"
		""
		"这里我们将使用它的液态形式，这样聚变反应堆就能为我们生成副产品。"
	]
	quest.06CD5693FF52270F.quest_subtitle: "液态镧系元素"
	quest.06D13E319C26C949.quest_desc: [
		"血蘑菇沼泽是巨型血蘑菇的家园。\\n\\n血让我感到不安，所以我想我还是把这段描述写短点。"
		"{image:atm:textures/questpics/undergarden/undergarden_blood.png width:200 height:100 align:center}"
	]
	quest.06D13E319C26C949.title: "血蘑菇沼泽"
	quest.06D66E791A9939DD.quest_desc: ["建造一个&b充电器&r，并用&b振动室&r或其他模组的发电机为其供电。"]
	quest.06D66E791A9939DD.quest_subtitle: "提供了一种通过ME网络为支持的工具充能的方法"
	quest.06D66E791A9939DD.title: "充电器"
	quest.06EA86F9F6C9DECF.quest_subtitle: "李子 + 桃子"
	quest.06EAA74E0A10CBB6.quest_subtitle: "范围：&b36&r 格"
	quest.06EAA74E0A10CBB6.title: "&9帝国生长加速器"
	quest.06F1E4885CE3C0C9.quest_desc: ["&b空白羊皮纸&r可以在&b抄写台&r上用来将&d法术&r施放到&6羊皮纸&r上。"]
	quest.06F2C42E6408149E.quest_desc: [
		"希望你没从&c&lPyromancer&r那里偷这个，他可是个好脾气的家伙！"
		"{image:atm:textures/questpics/iron_spells/spells_outfit_pyromancer.png width:50 height:100 align:center}"
	]
	quest.06F2C42E6408149E.title: "&c火魔法师套装"
	quest.06F55064A36274D2.quest_desc: [
		"现在，把我们制作的铪钡铜氧化物螺栓和晶体SOC组合起来，就能得到最便宜的IV级处理器了！！"
		""
		"请记住，我们机器的大部分“大型”多方块控制器在制作时需要使用 IV 处理器。"
	]
	quest.06F55064A36274D2.quest_subtitle: "便宜得不能再便宜了"
	quest.06F8EDF7513F8611.title: "史诗&d墨水&r"
	quest.06FF1116AFABE2FE.quest_desc: [
		"黑光灯发出的光属于紫外线光谱。紫外线恰好能有效杀菌，清除细菌和其他污染物。"
		""
		"我们的洁净室必须一尘不染，不能有任何灰尘。但如果需要一个更干净、更无菌的环境呢？"
	]
	quest.06FF1116AFABE2FE.quest_subtitle: "派对时间到！"
	quest.06FFBB12CFA87815.quest_desc: ["来自不同&2原版&r群系的&2原版&lMinecraft&r日志！ \\n\\n我不用再解释更多了吧！"]
	quest.06FFBB12CFA87815.title: "&2原版&r原木"
	quest.070CAEAD49B8DBA3.quest_desc: ["用8组&7压缩铁块&r和1个&6&lATM之星&r，你就能获得&5创意&7压缩铁块&r！ \\n\\n你可以将其设置为任何你想要的温度，然后用于你的机器中。 \\n\\n8组&7压缩铁块&r等于4,608个&7压缩铁锭&r……祝你好运！"]
	quest.070CAEAD49B8DBA3.title: "&5&l创造模式 &7压缩铁块"
	quest.07182C63528D9BF0.quest_desc: ["&4&lThe Prowler&r&r 是远古工厂的迷你首领。它是一个身体笨重的生物，下半身像坦克，右臂是集成了 &4meat shredder&r 的武器臂，左臂则被替换成了 &4missile battery&r。通常，它会保持静止以节省能量，但当玩家靠近时，它的身体会亮起并开始启动。"]
	quest.07182C63528D9BF0.title: "&4&l杀死潜行者 (Kill The Prowler)</c2></c1>"
	quest.0718FA338E8BA792.quest_desc: [
		"给电线包橡胶的更便宜方法！"
		""
		"这台机器能将更高级别的电线涂覆橡胶，从而制作电缆"
		""
		"等我们拿到MV的聚乙烯后，你可能想用这个来制造机器外壳"
	]
	quest.0729CB454B970201.quest_desc: [
		"这是&b青铜钻头&r。它会为你提供进一步扩张所需的主要矿石。"
		""
		"检查 &6EMI&r 的输出，并确保你了解钻头有损坏的可能，所以不要只制作一个。"
	]
	quest.0729CB454B970201.title: "青铜钻头"
	quest.072FA02152FBC5B1.title: "主世界层矿石"
	quest.072FBEB0F6F1BC48.quest_desc: ["用于将抽屉连接到控制器，以及连接末地抽屉。\\n\\n要将抽屉连接到控制器，右键点击控制器方块以开始配置。右键点击抽屉即可将其添加到网络中。\\n\\n手持工具会显示哪些抽屉已连接到控制器。"]
	quest.0737D64B0CCAE334.quest_desc: ["掌握一种能节省时间的优化合成方法，对你今后的发展大有裨益。"]
	quest.0737D64B0CCAE334.quest_subtitle: "融合外壳……又来了"
	quest.073BA8470EA37A00.quest_desc: [
		"又一个海洋，只是这个要冷得多。"
		"{image:atm:textures/questpics/undergarden/undergarden_icey.png width:200 height:100 align:center}"
	]
	quest.073BA8470EA37A00.title: "冰冻的海洋"
	quest.074EC1E636CD6605.quest_desc: ["&c下界合金盔甲&r是&l&2原版&r能得到的最好的。它的护甲值和&b钻石&r相同，但护甲韧性更高。 \\n\\n大概是因为制作它需要&b钻石&r吧！"]
	quest.074EC1E636CD6605.quest_subtitle: "20"
	quest.074EC1E636CD6605.title: "&c下界合金盔甲"
	quest.0752E680F9DE4039.quest_desc: [
		"存放物品大概是前期最让人头疼的部分了。"
		""
		"在这个整合包里，有超多方法能让游戏更轻松！想了解更多关于存储的内容吗？快来看看&a基础存储&r系列任务吧！"
	]
	quest.0752E680F9DE4039.title: "&a存储系统"
	quest.07564DBB023EE2A6.quest_subtitle: "等级：&b4"
	quest.0759CA52EECF3B49.quest_desc: ["&n&5犁&r会破坏任何非实体方块，将泥土变为农田，并推动实体而不造成伤害。如果它有相连的背包，物品会储存在里面。"]
	quest.07655CA904354E9E.quest_desc: [
		"&l能力类型：&r主动型"
		""
		"&l能力功能："
		""
		"激活时会破坏附近的草和花朵。"
	]
	quest.076A648E3E3245C9.quest_desc: ["燃料转能量的速度非常快，因此效率极高。唯一的问题是它无法再升级了。仍然使用普通熔炉燃料。"]
	quest.076A648E3E3245C9.title: "&aEmerald Furnace"
	quest.076DFB0B39A4259F.quest_desc: [
		"{atm9.quest.enchant.desc.infused_seashelf}"
		"{image:atm:textures/questpics/apotheosis/enchant_sea.png width:100 height:100 align:1}"
	]
	quest.076DFB0B39A4259F.title: "{atm9.quest.enchant.infused_seashelf}"
	quest.07753C5D94312A50.quest_desc: [
		"&3Augment&r: 发电机与&3Augment&r: 工厂相反，它不是消耗能量来冶炼，而是通过冶炼产生能量。你不再需要用它冶炼物品，所有使用的燃料都会转化为能量！"
		""
		"（用发电机和工厂熔炉连接，比只用一个燃料源好一些吗）"
	]
	quest.07753C5D94312A50.title: "&3增强&r：发电机"
	quest.077658D04D0D4AB3.quest_desc: [
		"&b硝石储罐&r必须&6放置在&r&b硝石收集器&r的下方。这两个装置协同工作，将&9水&r转化为&d硝石溶剂&r。"
		""
		"若想&a加快&r溶剂的生成，可以&6向&r蓄能器&b加入&r硝石晶体&r以大幅加速进程。"
	]
	quest.077658D04D0D4AB3.quest_subtitle: "这个东西有毒吗？Is it poisonous?"
	quest.077658D04D0D4AB3.title: "氯化铵蓄积器"
	quest.077A214422FEFF02.quest_subtitle: "&f6.5 &c攻击伤害"
	quest.077B2D62FA7650FB.quest_subtitle: "范围：&627&r 格"
	quest.077B2D62FA7650FB.title: "&cTertium 生长加速器"
	quest.0790D3BB481162A6.quest_desc: [
		"需要一个便携的合成台吗？便携的锻造台怎么样？"
		""
		"&l&8Crafting On A Stick&r 添加了部分你喜爱的合成台的便携版！早期游戏必备模组。"
	]
	quest.0790D3BB481162A6.quest_subtitle: "减少放置，增加合成"
	quest.0790D3BB481162A6.title: "正在合成... 用木棍合成！"
	quest.079383355D14FBC9.quest_desc: ["你需要21个砖块，以及每种各一个（物品输入口、物品输出口、流体输入口、流体输出口）来建造你的首个多方块结构——焦炭炉。用这台机器可以把煤炭变成焦炭和焦油。焦油比煤炭或木炭是更高效燃料，焦炭的效率更高。不过你最好把焦炭留着炼钢，所有燃烧燃料的需求都用焦油。用MI扳手查看多方块结构的搭建方法。"]
	quest.079383355D14FBC9.title: "焦炭炉 Coke Oven"
	quest.079A415488A32076.quest_desc: ["Blaze Ember 是 JDT 添加的一种新材料。使用二级或以上凝胶对原始煤炭块进行 Goo Spread 即可获得。Blaze Ember 矿石受 Fortune 效果影响。"]
	quest.07A1ABE59F38F2BD.quest_desc: ["要建造&6&l玻璃匠小屋&r&r，需要在&6大学&r中&9进行研究&r。在这里，&6&l玻璃匠&r&r会将沙子熔成玻璃，并用玻璃块制作玻璃板。为了让&6玻璃匠&r工作，他们必须&9收到另一名工人的&r请求，并且拥有&9必要的&r材料，包括用于熔砂的&c燃料&r。此外，还必须向&6玻璃匠小屋&r传授玻璃板的合成配方。"]
	quest.07A1ABE59F38F2BD.quest_subtitle: "&6玻璃匠小屋"
	quest.07A1ABE59F38F2BD.title: "&6&l我可不是普通的吹玻璃匠，我可是玻璃界的“行家”！"
	quest.07AD45DCF9EE3C2E.quest_desc: ["此物品可将基础机器升级为初级工厂机器。"]
	quest.07AD45DCF9EE3C2E.quest_subtitle: "升级为自动化工厂"
	quest.07BEB974DF1E5AD3.quest_desc: ["产电速度与&aEmerald Generator&r相同，但传输速率高得多。而且可能更便宜，因为它需要的物品更少，但这种物品也是&5Netherite&r，所以……"]
	quest.07BEB974DF1E5AD3.title: "&5下界合金发电机"
	quest.07BEE6FEC14765DC.quest_desc: ["Pretty simple recipe needing Clay, Iron, Slimeballs, and more... \\n\\nLodestones are best to loot for, Mods add these in Loot Pools all over &c&lThe Nether&r so don't craft one just find one! \\n\\nWax is a new Item added by &6&lForbidden \\& Arcanus&r which is a mix of Bottle of Honey and Slimeballs! \\n\\nYou can use it on a &6Darkstone Pedestal&r to get &7Magnetized Pedestals&r which work in hand with Hoppers (and Hopper like Items like Pipes). \\n\\nYou can also use it with Boots to increase how close Items can be to get dragged into your Inventory!"]
	quest.07CC809B6482AB09.quest_subtitle: "等级：&a2"
	quest.07D88A0ABF82A39A.quest_desc: ["使用&b刀&f从&6动物&f身上采集。"]
	quest.07E750F8184C4362.quest_desc: [
		"&e化学反应器&r 将氢与氟气反应以制造此物"
		""
		"之后你还可以用氢气在 &aEBF&r 中回收 &5Titanium Trifluoride&r，从而获得一些氢氟酸"
	]
	quest.07ECC87DFF2D3991.quest_desc: ["建造完第一个&9Energized Induction Matrix&r后，你会看到结构周围出现红色粒子，表示建造完成。\\n\\n别怕，可以用更高级的Cells和Providers来升级！需要更多空间吗？Induction Matrix的最大尺寸是18x18x18。"]
	quest.07ECC87DFF2D3991.title: "&a完成&9矩阵矩阵"
	quest.07F1FA5EF3E6A7F3.quest_desc: [
		"这种&3物质&r可以在&b热气动加工厂&r中&6加工&r以&6生产&r &b煤油&r，或者通过添加&4红石和润滑剂&r来生产。"
		""
		"它可以用作&a合理的&r &7液体燃料&r，也可以&6放置&r在&8熔炉&r中。"
	]
	quest.07F1FA5EF3E6A7F3.title: "&c柴油发动机"
	quest.07FC106AFE76E766.quest_desc: ["你需要使用 &5EV电解器&r 从钨酸中提取钨粉"]
	quest.07FDA46D83F8360D.quest_desc: ["用4个&6Allthemodium Nuggets&r和1个末影珍珠，你就能得到一个传送垫。 \\n\\n把它放在Minecraft的某个维度里，就能传送到另一个维度。 \\n\\n要传送，你必须用主手和副手都空着的状态，按住Shift右键！这点很重要，看清楚！ \\n\\n两手都必须空着！"]
	quest.07FDA46D83F8360D.title: "传送平台"
	quest.07FE9074247583EE.quest_desc: [
		"你可能注意到，我提到与控制器交互时用了“通常”这个词。这意味着物品和&6流体无法从控制器输入或输出&r，但信息可以，即统计数据。查看控制器，你会看到几个项目：形状有效性、状态、进度、配方基础和配方当前。"
		""
		"形状验证会告诉你&6多方块结构是否正确建造&r。但它不会指出你缺少或多余的舱口，这需要你自己判断。请记住，多方块结构&o可能&r会共享方块，只要这些重叠的方块不包含舱口即可。"
		""
		"状态会告诉你多区块的当前状态。无论是空闲还是激活状态。"
		""
		"进度会显示你的进度，百分比会缓慢地增长到100%。根据进程速度，百分比上升得会更快。"
		""
		"配方基础显示了&6基础配方能量/蒸汽消耗&r。根据制作内容，它会使用最低限度的能量/蒸汽，但可以消耗更多来加快进程。蒸汽机不会出现这种情况，所以现在就不深入探讨了。"
		""
		"Recipe Current 是&6当前实际消耗的能量/蒸汽量&r。"
	]
	quest.07FE9074247583EE.title: "多区块控制器 (Multiblock Controllers)"
	quest.07FED65149F877AA.quest_desc: [
		"&6&lGuard Tower&r&r 会雇佣并安置一名 &6&lGuard&r&r 来保护你的殖民地。新的 &6Guard&r 需要 &9在房子里的床上&r 才能生成。不过，一旦他们在 &6Guard Tower&r 被雇佣，那里就会成为他们的 &9新住所&r，房子里的床就会空出来给另一位新居民。殖民者喜欢安全感，所以在他们工作和住所附近建造 &6Guard Towers&r 可以提高他们的 &9happiness&r。此外，如果你在殖民地边界附近放置并升级 &6Guard Towers&r，你的边界就会 &9expand&r。"
		""
		"&l&6守卫&r&r会围绕其塔巡逻一段距离，该距离取决于其&n塔的等级&r。"
	]
	quest.07FED65149F877AA.quest_subtitle: "&6守卫塔"
	quest.07FED65149F877AA.title: "&6&l守卫最喜欢的音乐类型是什么？重金属——因为一切都关乎安全！"
	quest.0811E7EF963242D8.quest_desc: [
		"&6&lPrism Drift&r&r Modpack 的版权为 &eAll Rights Reserved&r。"
		""
		"Meaning all content within the modpack, including &l&eQuests&r&r, is protected. As such, this content may &n&l&cNOT&r&r&r be reused or redistributed in any public modpacks not released by &l&6Cubic Nexus&r&r without explicit permission from the creators."
	]
	quest.0811E7EF963242D8.title: "&6&lCubic Nexus 为 Prism Drift Modpack 制作的任务包"
	quest.0813CEDCC201216A.quest_subtitle: "Kapok + Old Fustic"
	quest.08143AD0D63FFD1F.quest_subtitle: "最多可持有 25k 经验值"
	quest.08245411AFDB63DB.quest_desc: ["此任务由 &6AllTheMods Staff&r 或 &2社区贡献者&r 为 AllTheMods 整合包创作。\\n\\n所有 &6AllTheMods&r 整合包均受 &eAll Rights Reserved&r 许可，未经明确许可，不得将此任务用于非 &6AllTheMods Team&r 发布的任何公共整合包中。\\n\\n此任务被有意隐藏，若你看到此内容，则表示你处于编辑模式。"]
	quest.0830195863384CF0.quest_desc: ["&bStrata&r 是最基础的第一种，由石头、沙子或黑曜石等普通方块合成。 \\n\\n你可以用 5 个 &bStrata Salt&r 来合成 &bMineral Salt&r。"]
	quest.0830195863384CF0.title: "&bStrata Salt"
	quest.0837E35C9C6881B4.quest_subtitle: "提高RF容量和传输速率"
	quest.0837E35C9C6881B4.title: "扩展RF线圈"
	quest.083ABBA1C45FF960.quest_subtitle: "只是一台割草机而已"
	quest.083D458032F0325C.quest_desc: ["&bME 出口总线&f会定期将白名单中的物品输出到总线所连接的外部存储中。与进口总线不同，出口总线必须经过过滤才能工作。"]
	quest.083D458032F0325C.quest_subtitle: "The O"
	quest.08457BEED799E600.quest_desc: ["这些新的&7矿车&r主要用于铺设&6轨道&r。\\n\\n&7轨道铺设器&r可以放置&6轨道&r，而&7轨道移除器&r可以移除&6轨道&r。\\n\\n&7轨道替换器&r会用不同的轨道替换现有的&6轨道&r，而&7轨道下切器&r则会替换&6轨道&r下方的方块。"]
	quest.08457BEED799E600.title: "&7矿车&r和&6轨道"
	quest.0848056FDD3F9BDA.quest_desc: ["&9奇点&r是一个理论上的终极密度点。科学家认为我们所处的宇宙曾是一个&9奇点&r。我们宇宙中的每一个分子，都存在于一个比沙粒还小的单一点中。\\n\\n当然，与理论科学相关的&l&bAE2&r也有他们自己的&9奇点&r。\\n\\n有两种方法可以制作它，但每种方法都需要将大量物品压缩成一个点！"]
	quest.0848056FDD3F9BDA.title: "&9奇点 (Singularity)"
	quest.084BFF7D3DD9BB24.quest_desc: ["召唤者会用电闪、能量攻击和他的哥布林守卫作战。注意身后，这些哥布林若不加以防范，会迅速将你淹没。击败他即可进入自然地下城。"]
	quest.084BFF7D3DD9BB24.quest_subtitle: "使用钥匙传送到&5召唤者地牢&r。位于致盲地牢的顶部。"
	quest.084BFF7D3DD9BB24.title: "击败&5召唤者"
	quest.0854AD352218E1C3.quest_desc: ["拥有强大力量却没有供暖，是不是很烦？\\n\\n现在，Caloric Flux Emitter 能解决这个问题！右键Shift绑定机器，然后放置并为其供电即可输送热量。\\n\\n无法同时绑定多台机器！"]
	quest.0854AD352218E1C3.quest_subtitle: "怎么做？"
	quest.0854AD352218E1C3.title: "无线加热"
	quest.087056D7E6E82FB3.quest_desc: ["繁殖一只铁蜜蜂和一只煤炭蜜蜂。"]
	quest.087056D7E6E82FB3.quest_subtitle: "蜜蜂繁殖"
	quest.087726194EED4BDF.quest_desc: ["副手拿着盾牌，主手拿着强化卷轴，然后右键点击。"]
	quest.087726194EED4BDF.title: "强力盾牌"
	quest.088D685775ED92EE.quest_desc: [
		"每次想去其他星球旅行，都需要6桶&a燃料&r，这很快就会累积起来。"
		""
		"使用我们收集到的&3Ostrum&r，可以制作出&dCyro Freezer&r。当这台机器获得能量后，会将像&bIce、Packed Ice、Blue Ice 或 Ice Shards&r这类冷物品转化为&dCryo Fuel&r。"
		""
		"每次发射只需 1 个 &dCryo Fuel&r，而不是 3 个桶。往返只需 2 个！"
		""
		"注意：放置时还会冻结周围的冰块，为你提供无限的冰源！"
	]
	quest.088D685775ED92EE.title: "&a高效燃料"
	quest.088D80D8790DBD90.quest_desc: [
		"&aPneumaticCraft&r 的核心就是压力！"
		""
		"要开始，你需要制作一些&3压缩铁锭&r！最简单的方法是在地上挖个洞，扔些铁锭（或铁块）进去，然后用TNT把它炸掉！"
		""
		"有些可能会在爆炸中迷失，但这我们必须冒的风险！"
	]
	quest.088D80D8790DBD90.title: "&dPneumaticCraft"
	quest.088FCB5267CB7A89.quest_desc: ["此腰带会提供随机的正面药水效果，持续时间较短。效果强度会有所不同。"]
	quest.08903890F577D43A.quest_desc: ["要获得更多有趣的魔法使武器，你需要一张强化卷轴。要获得它，先放置一张魔法布，然后在上面进行强化仪式，再捡起这块布。"]
	quest.08903890F577D43A.title: "卷轴：力量增强卷轴"
	quest.0893EFCAC7031FEA.quest_desc: ["准备好牛奶和鸡蛋，是时候烤蛋糕了。"]
	quest.0893EFCAC7031FEA.quest_subtitle: "既想吃蛋糕，又能吃到蛋糕"
	quest.0895EF6E5296A1E8.quest_desc: ["动力离心机使用 &cRF&r 来以 &6更高的速度&r 处理材料。"]
	quest.0895EF6E5296A1E8.quest_subtitle: "更快更出色"
	quest.0897CCAC72E82C5B.quest_desc: [
		"&oPowah! 的核心在于生成、储存和传输电力"
		"&8*但现代工业化模组除外"
	]
	quest.0897CCAC72E82C5B.quest_subtitle: "需要更强大的力量！，是这样吗？"
	quest.0897CCAC72E82C5B.title: "&4欢迎来到 Powah!!!"
	quest.0897F7A3203E45AF.quest_desc: [
		"可将特定方块转化为液体。"
		""
		"这有助于用鹅卵石、下界岩等生成岩浆。"
	]
	quest.089B1B9837AF4938.title: "&5不可获取锭工具"
	quest.089D22E6B361EBA4.quest_desc: ["正在为微型宇宙钻探船准备组件。"]
	quest.089D22E6B361EBA4.quest_subtitle: "推进器全开！"
	quest.08A2F489A73BE55B.quest_desc: ["&b终极富集工厂&r可同时处理多达&a9&r个配方，并包含相同的“&e自动分类&r”功能。"]
	quest.08A2F489A73BE55B.title: "终极富集工厂"
	quest.08AC2D81A1004984.title: "&6Allthemodium &5合金 &3三叉戟"
	quest.08B17C05B2111477.quest_desc: [
		"恭喜你！"
		""
		"你现在已&6解锁&r了&o第四&r个&o也是&r最后一个&lJDT&r &b物品&r和&b方块&r。"
		""
		"&b工具&r &6能立即生效&r，&b盔甲&r赋予你像&o超人&r一样的&6力量，&r而&b魔杖&r可以&6撕裂出临时的洞穴&r。"
		""
		"穿上顶级&lJDT&r装备的你会让所有人知道你已完成一切……&2主世界、&r &4下界、&r &3末地、&r以及&9深暗之域&r。"
		""
		"{image:justdirethings:item/eclipsealloy_ingot width:100 height:100 align:center fit:true}"
	]
	quest.08B17C05B2111477.quest_subtitle: "第4级：已解锁"
	quest.08B1A64B01A8A604.quest_desc: [
		"虽然有其他方法可以移动恶魔，但你也可以创建一个&d空灵魂宝石&r来捕捉恶魔并将其放置在其他地方。"
		""
		"要制作这个，我们需要进行一个更高级的仪式，名为&aStrigeor's Higher Binding&r。为此，你需要&a8个Sacrificial Bowls&r，以及完成此任务所需的物品。"
		""
		"请记住，你可以通过在&bDictionary of Spirits&r中找到五芒星来预览多方块结构，以帮助你建造。"
	]
	quest.08B1A64B01A8A604.title: "&b捕捉&d恶魔"
	quest.08B34DE812C3235B.quest_desc: ["即使跨越不同的维度也没有问题！"]
	quest.08B34DE812C3235B.quest_subtitle: "无限射程 (Unlimited Range)"
	quest.08B60D8A25008CCC.quest_desc: ["此任务由 &6AllTheMods Staff&r 或 &2社区贡献者&r 为 AllTheMods 整合包创作。 \\n\\n由于所有 &6AllTheMods&r 整合包均受 &eAll Rights Reserved&r 许可，未经明确许可，不得将此任务用于非 &6AllTheMods Team&r 发布的任何公共整合包中。 \\n\\n此任务被有意隐藏，若你看到此信息，则表示你处于编辑模式。"]
	quest.08BE35FB8E58C4B5.quest_desc: [
		"&b基础锯木厂&r可同时处理多达&a3&r个锯木流程。"
		""
		"左侧有一个名为“&e自动分类&r”的按钮，可让机器在 &a3&r 个输入槽之间自动分配输入物。"
	]
	quest.08BE35FB8E58C4B5.title: "基础锯木厂"
	quest.08C3213E848BFD0C.quest_desc: [
		"&bOverdrive Module&f会&6阻止&f&b电器&f的效率下降，但会&6强制&f电器&c始终使用&f最大功率&6，即使它没有&f处理<c13>任何东西。"
		""
		"如果机器正在&6&f处理的配方发生变化，效率&o&r将会重置。"
	]
	quest.08C66BCA3AAE765B.quest_desc: ["这个添加了非&2&lMinecraft&r方块，所以我不想讨论它。"]
	quest.08C66BCA3AAE765B.title: "&b&l鹦鹉螺屋顶"
	quest.08C6B7D2DAE87222.quest_subtitle: "橡木 + 桦木"
	quest.08CE14FFED813992.quest_subtitle: "13 块湿的深粉色方块"
	quest.08D1CC753F6B4283.quest_desc: ["在 Warden 之前，远古守卫者被认为是 Minecraft 的第三个 Boss，但我认为他是个迷你 Boss。 \\n\\n远古守卫者会生成在海洋纪念碑中。那里会生成三只，它们会给附近的任何人施加挖掘疲劳。 \\n\\n如果你想得到海洋纪念碑的宝藏，就需要找到并杀死它们！（提示：我通常在顶层房间、最左侧和最右侧各找到一个！） \\n\\n它们有 80 点生命值，攻击方式和普通守卫者一样，激光和尖刺！ \\n\\n死亡时会掉落：海绵、海晶灯，还有它们的午餐……"]
	quest.08D1CC753F6B4283.title: "击杀一只远古守卫者"
	quest.08D48D7C2C6EEF54.quest_desc: ["普通的钨有什么用？既然你问了，它是许多 IV 机器的核心组件，主要以钨缆的形式存在"]
	quest.08D9C809CF4062E8.quest_desc: ["生吃、烤熟，或者插在木棍上。 \\n\\nUnderbeans 的用途可多着呢！"]
	quest.08DA36DAD1422B0A.quest_desc: ["中毒时造成的伤害增加。"]
	quest.08DA36DAD1422B0A.quest_subtitle: "来自蛛王战利品袋的掉落物"
	quest.08DB91D079C5B715.quest_subtitle: "红枫 + 桃花心木"
	quest.08DDE018A804BFE7.quest_desc: ["这台机器像Macerator或Pulverizer一样，能将矿石分解成粉尘。\\n\\n它将3种原矿分解成4种粉尘。\\n\\n这是你矿石工厂的起点。它还可以升级为工厂机器，增加使用槽位。"]
	quest.08DDE018A804BFE7.quest_subtitle: "将原始矿石破碎成粉尘"
	quest.08E47A27EFFB7C6B.quest_subtitle: "5 干燥的粉色方块"
	quest.08E484DD3E751697.quest_subtitle: "罗伊·格·比夫中的 B 字母"
	quest.08E484DD3E751697.title: "&b蓝色Xychorium宝石"
	quest.08F28A9E4DEA7CD0.quest_desc: ["此符文会增加从非玩家实体身上吸取血液所获得的LP量。每枚符文可叠加提供10%的额外加成。"]
	quest.0910C28A609ECBC1.quest_desc: ["&6蜂蜜罗盘&r是&6&lBumblezone&r添加的非常有用的工具。 \\n\\n你可以制作一个或用交易获得。 \\n\\n你可以 Shift 右击&e蜂巢&r来追踪该&e蜂巢&r（包括&l生产型蜂巢&r），或右击空气来定位蜂巢迷宫。"]
	quest.0910C28A609ECBC1.title: "&6蜂蜜指南针"
	quest.0910D85DD68AFD64.quest_desc: [
		"物品和药水运输方式。"
		"源浆果收割机。"
		""
		"- 召唤：在方块上&6右键&r点击。"
		""
		"- 使用 Starbuncle：使用 &bDominion Wand&r 设置 Starbuncle 的源和目的地"
		""
		"可用&bDominion Wand&r在&bMagebloom Bed&r上休息。"
		""
		"- 需要来源：否。"
	]
	quest.0910D85DD68AFD64.quest_subtitle: "物品/药水 交通工具"
	quest.0911814AFFFCF885.quest_desc: ["在 &eMixer&r 中混合 4 镍粉和 1 铬粉，就能得到镍铬合金！"]
	quest.091C2772ED417247.quest_desc: [
		"既然你现在已经在&6中压等级&r生产能源了，就需要确保你的机器能接受这股新获得的电力。"
		""
		"通常，&6线缆如果不属于同一等级，甚至无法连接到机器&r。但是，将&b高级机器外壳&r（或更高等级）放置在机器右上角的插槽中，你就能将机器升级到与该外壳关联的功率等级。"
		""
		"默认情况下，电动机器已经是&b基础机器外壳&r等级，无需将&b基础机器外壳&r放入槽位。我会告诉你哪些外壳对应哪个功率等级。"
		""
		"&6务必确认哪些机器&o真正&r&6需要升级&r，以免在不需要额外提升的机器上浪费资源。"
	]
	quest.091C2772ED417247.title: "船体升级"
	quest.091C9CEBC8F9DDAC.quest_desc: ["作为科技整合包的核心，研磨机能将矿石中的杂质粉碎，为你提供原矿或矿石粉，再以更高的比例制成锭。如果使用蒸汽采矿钻获取原矿块，可以按1:3的比例研磨，然后再进一步转化，每块原矿的回报率约为1:4.5！价值飙升！"]
	quest.09223F02621781BF.quest_subtitle: "铁匠 + 石匠"
	quest.09223F02621781BF.title: "银色蜜蜂"
	quest.0923C941A9696122.quest_desc: ["万一你需要带上2.56亿个物品去冒险呢！"]
	quest.09282E3864752CEE.quest_subtitle: "等级：&63"
	quest.092A23FDA5D50812.quest_subtitle: "等级：&a2"
	quest.092BB595F75D5536.quest_desc: ["欢迎来到&6&l禁忌与神秘&r！ \\n\\n要启动这个模组，我们需要开始地下采矿……深入地底。 \\n\\n比如Y轴1层及以下。"]
	quest.092BB595F75D5536.title: "&6&l禁忌 \& 奥术"
	quest.093039CD2C51183B.quest_desc: ["要建造&6&l铁匠小屋&r&r，需要在&9&6大学&r中&r进行研究，它是一个&c3x3&r的合成台，可以制作任何原版工具、盔甲、剑和盾牌（&9不包括弓和红石物品&r）。当&6铁匠小屋&r从其他工人那里&9收到任何这些物品的&r请求时，就会开始工作。"]
	quest.093039CD2C51183B.quest_subtitle: "&6铁匠小屋"
	quest.093039CD2C51183B.title: "&6&l铁匠最喜欢的游戏是什么？“Forge”-nite！"
	quest.09336DBAFB15EF52.quest_desc: ["&b高级机械管道&r的每根管道容量为&98,000mb&r，每次\"&a抽取&r\"的流量为&91,000mb/t&r。"]
	quest.09336DBAFB15EF52.title: "高级机械管道"
	quest.09408C6DCAC90318.quest_desc: ["此方块可储存能量，也可用于为物品充电。"]
	quest.09408C6DCAC90318.quest_subtitle: "储存能量"
	quest.0947B4ED95B0267E.quest_desc: ["给物品和工具镀层。\\n\\n下界合金是很好的镀层材料。"]
	quest.0947B4ED95B0267E.quest_subtitle: "完全不是为了下界合金才做的这件事"
	quest.09485B63483B7A15.quest_desc: [
		"&l能力类型：&r主动型"
		""
		"&l能力功能："
		""
		"暂时使附近的敌对生物不再攻击玩家，有冷却时间。"
	]
	quest.094D28B7A0170039.quest_desc: [
		"会捡起物品并将其带回巢穴。"
		""
		"不如贪婪蜜蜂好用。"
	]
	quest.094D28B7A0170039.quest_subtitle: "用漏斗喂食一只原版蜜蜂"
	quest.094D28B7A0170039.title: "收藏家蜜蜂"
	quest.09625551CD317B28.quest_desc: ["用一块磷灰石喂养钻石蜜蜂。"]
	quest.09625551CD317B28.quest_subtitle: "蜜蜂转化器"
	quest.09733948CBCB3FB9.quest_desc: ["&dTier 6&r 是最高等级，任何可破坏物都可以用它挖掘，包括 Vibranium 和 Unobtainium。"]
	quest.09733948CBCB3FB9.title: "&d收获等级 6"
	quest.097735604CB11E83.quest_desc: [
		"这才像话嘛！"
		""
		"我们的聚变反应堆现在开始制造好东西了！"
	]
	quest.097735604CB11E83.quest_subtitle: "液态钠克德里亚"
	quest.097ACA8114CD8DA8.quest_desc: ["&b精英粉碎工厂&r可同时处理多达&a7&r个粉碎流程，并包含相同的“&e自动分拣&r”功能。"]
	quest.097ACA8114CD8DA8.title: "精英粉碎工厂"
	quest.097DE7038A746847.quest_subtitle: "从芦苇巢中孵化而出"
	quest.0980661B2F7FBC10.quest_desc: [
		"跳上蜡烛，越过它们到达顶部！ \\n\\n上去后，你就能找到一些蜂蜜茧。 \\n\\n小心脚下被烧着。"
		"{image:atm:textures/questpics/bumblezone/bumble_candle.png width:200 height:100 align:center}"
	]
	quest.0980661B2F7FBC10.title: "蜡烛跑酷"
	quest.098C3858B4FFCE78.quest_desc: ["使用&bthermo generator&f时，若在其下方放置&bblazing block&f，其效率将提升至&b280%。"]
	quest.098C3858B4FFCE78.quest_subtitle: "280% 更强的力量"
	quest.0990D6CEE042F44E.quest_desc: ["这张地图是&9Twilight Forest&r的必备品。\\n\\n使用&e空白魔法地图&r会生成一张显示附近首领和建筑图标的地图。"]
	quest.0990D6CEE042F44E.title: "&e魔法地图"
	quest.09919A0C03840EA7.quest_subtitle: "可装备在手腕槽位，以在屏幕上始终显示当前世界时间。"
	quest.09919A0C03840EA7.title: "制作一个 &6时钟"
	quest.09936F8FCEA72C5C.quest_desc: [
		"&n&5轨道组装器&r可以放置在轨道上。如果在组装器上建造了东西，当组装器接收到红石信号时，矿车就会将其拾取。"
		""
		"方块必须粘合在一起，需要旋转力的方块将自动开始工作。"
		""
		"要“卸载”矿车上的方块，只需关闭红石信号，让矿车驶过即可。"
	]
	quest.09955CF85F579E0F.quest_desc: ["你迟早会拿到这个，它可以说是<Minecraft>&2&l里最丰富的方块&r。"]
	quest.09955CF85F579E0F.title: "石头方块"
	quest.09B10C121C7E9023.quest_desc: ["用于制作&bME 储能组件&f和其他配件。"]
	quest.09BA45CBBFB4AE26.quest_desc: ["此模组的下一阶段需要你搭建&3装配线&r。一个&3装配线&r的主要组件是&3装配控制器&r。\\n\\n压力将由此进入。"]
	quest.09BA45CBBFB4AE26.quest_subtitle: "Always Required"
	quest.09C7343DCCD5157E.title: "零点模块的年龄"
	quest.09C82CDDA800D8C9.quest_desc: ["凋零是第二个Minecraft Boss，这个更具选择性。 \\n\\n你需要建造凋零来召唤他。用4个灵魂沙摆成T形，并在顶部放置3个凋零骷髅头即可召唤！ \\n\\n他有300点生命值，会四处飞行并向玩家或生物发射凋零骷髅头。 \\n\\n当生命值减半时，他会获得一个抵御投射物的护盾，需要用剑或斧头才能击败他。 \\n\\n击败他后，他会掉落：下界之星、可能掉落凋零灵魂，以及大量珊瑚物品。"]
	quest.09C82CDDA800D8C9.title: "击杀凋零（The Wither）"
	quest.09CCC797BF15ADFC.quest_desc: [
		"神秘匕首用于将龙头分解为龙鳞。"
		""
		"用于击杀生物时，会将&a试管&r填充为&c血液&r。"
	]
	quest.09D18512037386C1.quest_desc: ["要将药水效果放入过滤器中，你需要先装满一个药水过滤器。\\n\\n方法如下：先获得一个药水效果，然后用药水过滤器右键自己，将效果从自己身上移除并添加到过滤器中，重复此操作直到过滤器装满并激活。\\n\\n此方法也适用于模组药水效果，或是无法通过普通药水获得的效果，如加速或抗性。"]
	quest.09D2137B4F42006E.quest_desc: ["Eclipse Ember 是 JDT 添加的一种新材料。使用四阶的 Goo 对 Voidflame Coal Blocks 进行 Goo Spread 即可获得。Eclipse Ember Ore 受 Fortune 效果影响。"]
	quest.09D76E9B8CABC31E.quest_desc: ["要获得 &5&l创意精华&r，你需要 4 个 &5Insanium 精华块&r。每个块需要 9 个 &5精华&r，让我算算…… \\n\\n你只需要这些块，就需要 9,216 个 &aInferium 精华&r。"]
	quest.09D76E9B8CABC31E.title: "4 &5Insanium 方块"
	quest.09E25B1CD6CABD5A.quest_desc: ["此升级使路由器类似于带框方块。 \\n\\n潜行右键点击方块，可将路由器的外观更改为该方块。 \\n\\n只是别把它弄丢了！"]
	quest.09EF804D70C856FB.quest_desc: [
		"我们需要用模组 &aImmersive Engineering&r 里的 &dRail Gun&r 来制造 &6Star&r！"
		""
		"要开始，先制作你的第一把工程师之锤。"
		""
		"此任务还会提供该模组的完整指南。若迷失方向，请务必查阅。"
	]
	quest.09EF804D70C856FB.title: "&dImmersive Engineering"
	quest.09F49ED309152E24.quest_desc: ["&l&cChisel Reborn&r 是另一个基于 &lChiseled&r 的模组。 \\n\\n该模组的精髓是使用凿子工具来改变某些方块的设计。 \\n\\n你可以右键点击凿子打开其GUI，在那里你可以放入最多一组的方块，然后选择你想要的设计，再将其取出。或者你也可以一直保留在凿子里，不过我想不到为什么要这么做。 \\n\\n你也可以用凿子左键点击方块，无需打开凿子GUI即可更改其设计！ \\n\\n别担心，这个工具没有耐久度。"]
	quest.09F49ED309152E24.title: "&l&cChisel Reborn"
	quest.09FD0BBC59643076.quest_desc: ["&e&lTransformation Powder&r&r 是一种亮蓝色的魔法物品，可在 Hollow Hills 的宝箱中找到。它能将 Twilight 物品变为维度物品，或将异界生物变为 Twilight Forest 生物，反之亦然。此粉末可以改变环境，或通过将危险生物变为无害生物来帮助你逃脱。"]
	quest.09FD3D0B9BCAEB5A.quest_desc: [
		"Gravel Nest 会在河流或沙滩生物群系中吸引蜜蜂。"
		""
		"它会吸引灰采矿蜂、巧克力采矿蜂和挖掘蜂。"
	]
	quest.09FD3D0B9BCAEB5A.quest_subtitle: "在河流和沙滩群系中吸引蜜蜂"
	quest.0A02DBE226C3F44E.quest_desc: [
		"有效升级："
		"- 思维迷雾"
		"- 使敌人陷入混乱状态（Stupefy）"
		"- 夜视能力"
		"- 负面效果移除器"
		"- 心智湮灭"
	]
	quest.0A0A991BAC99092C.quest_desc: [
		"靛蓝蘑菇沼泽比血蘑菇沼泽要沼泽得多。 \\n\\n当然，这里不仅有靛蓝蘑菇，还有迷你烟雾茎树和剧毒混合液池。真想知道它能干什么……"
		"{image:atm:textures/questpics/undergarden/undergarden_indigo.png width:200 height:100 align:center}"
	]
	quest.0A0A991BAC99092C.title: "靛蓝蘑菇沼泽"
	quest.0A11725B41AB45F6.quest_desc: ["此任务由 &6AllTheMods Staff&r 或 &2社区贡献者&r 为 AllTheMods 整合包创作。 \\n\\n由于所有 &6AllTheMods&r 整合包均受 &eAll Rights Reserved&r 许可，未经明确许可，不得将此任务用于非 &6AllTheMods Team&r 发布的任何公共整合包中。 \\n\\n此任务被有意隐藏，若你看到此信息，则表示你处于编辑模式。"]
	quest.0A1ABE9CF7740AAA.quest_desc: ["折扣戒指可提供少量最大法力值和法力再生值的加成。它还能降低施放法术的总消耗。"]
	quest.0A1ABE9CF7740AAA.title: "折扣戒指系列任务书"
	quest.0A1BACA070EB5264.quest_desc: [
		"这才像话嘛！"
		""
		"是的，我们暂时不会直接使用它。但现在设置好制作和收集流程会很有帮助，能帮你节省大量时间！"
	]
	quest.0A1BACA070EB5264.quest_subtitle: "星尘物质"
	quest.0A1C2A7A8617D3E4.quest_subtitle: "竞速玩家超爱这些东西"
	quest.0A1C2A7A8617D3E4.title: "小麦"
	quest.0A1D4228271DECA3.quest_desc: ["你去哪儿了？\\n\\n哦，你只是缩小到之前的一半大小。足够小可以钻进一个方块宽的缝隙里。"]
	quest.0A1D4228271DECA3.quest_subtitle: "项链"
	quest.0A1D4228271DECA3.title: "&5缩小护身符&r"
	quest.0A1D6E233C0ECC8E.quest_desc: [
		"&dNargoyles&r 是地下生成的恶心好斗的怪物。 \\n\\n它们有 7.5 颗心，会无情地试图杀死你。 \\n\\n它们不掉落任何东西，只是给那些想和平采矿的人制造障碍。"
		"{image:atm:textures/questpics/undergarden/undergarden_nargoyle.png width:100 height:100 align:center}"
	]
	quest.0A1D6E233C0ECC8E.title: "&dNargoyle&r"
	quest.0A1FBDA0C1314DE1.quest_desc: ["调谐的&b钻石&r/&a绿宝石&r是&4Mahou&r电池，你需要很多&4Mahou&r来获取&4&lMorgan&r。\\n\\n调谐的&b钻石&r可储存2000&4Mahou&r，调谐的&a绿宝石&r可储存1000。\\n\\n仪式需要5000&4Mahou&r，所以你可能需要几个！"]
	quest.0A1FBDA0C1314DE1.title: "Enough &4Mahou&r? Probably!"
	quest.0A207A437AF153AA.quest_desc: ["&2幻影盔甲&r有几率在&2骑士幻影&r的箱子里找到。"]
	quest.0A207A437AF153AA.title: "&2幻影盔甲"
	quest.0A21773B773F34F8.quest_desc: ["色彩是让建筑更生动的重要组成部分之一！\\n\\n它能赋予建筑生命、个性和色彩！\\n\\n先从染料开始吧！"]
	quest.0A21773B773F34F8.title: "彩色方块"
	quest.0A2675CF16B6443B.quest_desc: [
		"Extruders 使用 extruder mold 将锭料挤压成各种形状"
		""
		"通常，用挤出机制作转子等组件会更便宜"
	]
	quest.0A3C464EF7CDD5F6.quest_desc: ["&4Hellshelves&r 是你接触 &cQuanta&r 的入门，能给你 &c3% Quanta&r 和 &a3 Eterna&r。比普通书架好多了，对吧？下一步你至少需要 10 个。"]
	quest.0A3C464EF7CDD5F6.title: "&4地狱书架"
	quest.0A3F4D7A15E61B43.quest_subtitle: "忒修斯之船船体"
	quest.0A43FD0B5C76C1C5.quest_desc: [
		"&l&7RailCraft&r 为我们添加了高炉多方块结构，可将铁转化为钢！ \\n\\n建造它需要 34 个高炉砖。它将宽 3 格、长 3 格、高 4 格。正中心的两个方块需要是空心的。当它完全组装完成并允许你访问其 GUI 时，就表示建造完毕。 \\n\\n在那里，你可以放入任何形式的铁，来获得钢和砂砾。"
		"{image:atm:textures/questpics/railcraft/rail_furnace.png width:100 height:100 align:center}"
	]
	quest.0A43FD0B5C76C1C5.title: "Blast (Steel) Furnace"
	quest.0A45F1E7BEC33CBE.quest_desc: ["&c&l灵魂锻造炉&r&r结构位于下界，是&l&c下界合金巨兽&r&r的家园。结构内散落着大量远古残骸，但没有其他生物。"]
	quest.0A45F1E7BEC33CBE.quest_subtitle: "&c与下界合金巨兽的会面"
	quest.0A45F1E7BEC33CBE.title: "&c&l灵魂锻造炉"
	quest.0A467A0CFFCF1490.quest_subtitle: "山毛榉 + 幸运"
	quest.0A6378C7455E45B1.quest_desc: ["想要迷你（末地）出口传送门，你需要一些龙之部件和一个龙裔灌注的传送核心。为此，你需要用最大&aEterna&r、&c45%%-50%% Quanta&r和最大&5Arcana&r来灌注一个传送核心。一个可用于核心灌注的示例是&17个回响的潜影架&r和&d3个龙裔末地架&r。然后带上你的龙裔传送核心、一个龙之蛋（希望你有备用的）、3个末地水晶和4个末地石火坑。然后，BOOM，迷你（末地）出口传送门就做好了。"]
	quest.0A6378C7455E45B1.title: "微型出口传送门"
	quest.0A64D0937A5F7513.title: "黄金钓鱼竿"
	quest.0A70CC1A0F4F1CD1.quest_subtitle: "不常见"
	quest.0A70CC1A0F4F1CD1.title: "&2Timeworn Fabric&r"
	quest.0A7B0D0B81E138DE.quest_desc: ["The &e&lEngineer's Toolbox&r works as a segregated Shulker. \\n\\nIt has sections: Food, which you can only put Food in. Tools, which can hold &8&lIE&r Tools or other Tools just not &bBuckets&r. &cWiring&r, which can have &cWires&r, &cConnectors&r, or &cRelays&r. And Anything, which doesn't discriminate. Try to be more like the Anything section! \\n\\nSome Items can't be held within it though, like &bBuckets full of Fluids&r or Accumulator Backpacks. \\n\\nYou can Shift Right Click to place down the &e&lToolbox&r to make it act like a Chest, then you can do the same to pick it up."]
	quest.0A7B0D0B81E138DE.title: "&e&l工程师工具箱"
	quest.0A848E0B9F485B2C.quest_desc: ["在您的 &e电动高炉&r 上放置 16 个，您就可以烹饪高达 &c4500 开尔文&r 的配方！相当于 4227 摄氏度或 7640 华氏度！"]
	quest.0A8698ACCD58FADA.quest_desc: [
		"UV机械臂作为机器的盖子时，能移动的物品数量非常有限。"
		""
		"如果你的机器上用了 Robotic Arms 做遮挡，不妨试试这个版本。绝对不会让你失望！"
	]
	quest.0A8698ACCD58FADA.quest_subtitle: "正在将所有物品转移过去！"
	quest.0A8F44B9B3C8FC0F.quest_subtitle: "等级：&63"
	quest.0A912B2E2BE34920.quest_desc: [
		"虽然你可以在地表找到原油，但钻井是获取大量石油的好方法。先用&3地震传感器&r找到地下石油，然后用装满钻管的&3气举&r钻井。 (这需要压力才能工作)。\\n"
		"{image:pneumaticcraft:textures/patchouli/oil_pumping.png width:200 height:200 align:right fit:true}"
	]
	quest.0A912B2E2BE34920.quest_subtitle: "石油钻探任务书文本"
	quest.0A99C7852725BFC2.quest_subtitle: "&eBronze Dungeons&r have entrances that are located on the sides of normal islands. Bronze dungeons can have a varying number of rooms. Non-boss rooms contain &c&lsentries&r&r which attack the player, and sometimes have chests on 4x4 tables. Some of these chests are &cMimics&r, however. The &9boss&r of this dungeon can't be attacked with a sword. He can, however, take damage from any tool (&apickaxe&r, &ashovel&r, etc.). &c9 blocks&r on the floor of each antechamber aren't minable at all. The &cboss room's&r walls are only minable once the &cboss&r is dead."
	quest.0A9D5C5D2F4CDCC3.title: "&5不可获取之鎏金战锤"
	quest.0AAB33FA2609AD2F.quest_desc: ["Caliburn需要几样东西，有些在任务中已说明，有些则没有。首先，你需要Mahou Lake和5000 Mahou。然后，你需要一把附魔了Smite的钻石剑。（等级越高越好）。把剑扔进湖里，你就能在湖底找到Caliburn。"]
	quest.0AAB33FA2609AD2F.title: "Caliburn"
	quest.0ABB2264CBB82470.quest_desc: ["&d&lArs&r 盔甲的铁质盔甲。"]
	quest.0ABB2264CBB82470.quest_subtitle: "15"
	quest.0ABB2264CBB82470.title: "&5秘术师套装"
	quest.0AC5BE6934118778.quest_subtitle: "在水下你的视野可能会更清晰一些"
	quest.0AC6B223857CAE94.quest_desc: [
		"唯一需要高压电路才能制作的MV机器"
		""
		"这台机器能让你开始着手制作下一等级的电路，即&6微处理器！&r"
	]
	quest.0AC7D844C55119E1.quest_desc: [
		"这可不是&b猴子扳手&r，但最好祈祷你以后能像它一样灵活。"
		""
		"使用&b扳手&r，你可以通过&6右键单击&6来&6旋转&r &o几乎&r &b所有机器&r，并且可以&r拾取&r&o几乎&r所有&b管道&r、&b流体&r或&b非流体&r。"
		""
		"你可以&6右击+shift&o一个&b机器&r来&6配置&r&b输出面&r。当你&6手持&r&b扳手&r时，可以&6悬停&r在&b机器&r的任何一面，会看到一个类似&b网格&r的东西。在&6中间方块&o上&b右击+shift&r，会将&b输出面&r设为该&b网格&r所在的面。对矩形操作会将&6输出&r置于与所选角点相对、呈&690&r度的面，以便在难以触及的空间进行&6配置&r。最后，每个角的&b小方块&r会将输出设为网格的&b相对&r面。"
		""
		"记住，不能用&b扳手&r&6破坏&r机器，这会&6摧毁&r它，而且你&6再也&r拿不回来了。改用你可靠的&b稿子&r吧。"
	]
	quest.0AC7D844C55119E1.title: "扳手"
	quest.0AC8FE3B59D1B09D.quest_desc: ["量子捕手是移动生物非常实用的工具。 \\n\\n只需右键点击生物即可“捕捉”它们，再右键点击即可释放。 \\n\\n不过，你需要携带一定数量的&bAureal&r才能使用，具体取决于生物的生命值。生命越高，需要的&bAureal&r越多！释放生物不消耗任何资源，完全免费。 \\n\\n哦，对了，我应该告诉你如何制作它！你需要一个&7量子核心&r，它由&7符文&r、&cMundabitur粉尘&r和&8燧石&r制作而成！ \\n\\n刷怪器残骸是未经丝绸之触挖掘刷怪器时掉落的物品，因此会破坏刷怪器。"]
	quest.0ACC0092A8F722C6.quest_desc: ["大多数&8&lIE&r机器都需要&c能量&r才能工作，而&c电线&r就是传输能量的方式！ \\n\\n&c电线&r的接法是用&c线圈&r右键点击一个端点，再用同一个&c线圈&r右键点击另一端点。连接路径不能被阻挡，否则无法连接。 \\n\\n要拆除&c电线&r，可以破坏它们所连接的设备，或使用我们可靠的&6电线钳&r！ \\n\\n不同等级的&c电线&r传输量不同，&5HV&r传输量最大。"]
	quest.0ACC0092A8F722C6.title: "&c线圈绕组"
	quest.0AD2B11565B484E7.quest_desc: ["在获得&5下界合金&r之前，你需要所有这些熔炉。是的，全部都要，包括&6铜&r！还有&7银&r！甚至&3水晶&r！"]
	quest.0AD2B11565B484E7.title: "&cR&6a&ei&2n&3b&9o&5w &cP&6l&ea&2t&3i&9n&5g"
	quest.0AD392F5527093C2.quest_desc: ["用作存放MEGA Storage Component的容器，用于流体存储。"]
	quest.0ADBE90B33ACC9FB.quest_desc: ["当使用&3Augment&r: Generator时，&cR&6a&ei&2n&3b&9o&5w&r &cG&6e&en&2e&3r&9a&5t&ce&6r&r会提升&cR&6a&ei&2n&3b&9o&5w&r &cF&6u&er&2n&3a&9c&5e&r。如果所有其他8个熔炉（不包括&5Netherite Furnace&r）都围绕着&cR&6a&ei&2n&3b&9o&5w&r &cF&6u&er&2n&3a&9c&5e&r，并且拥有&3Augment&r: Generator，且正在积极产生能量（已加燃料但未满），它们会为一个拥有&3Augment&r: Generator且正在工作的&cR&6a&ei&2n&3b&9o&5w&r &cF&6u&er&2n&3a&9c&5e&r提供增益。它将使该熔炉每刻多产生50kFE！"]
	quest.0ADBE90B33ACC9FB.title: "&cR&6a&ei&2n&3b&9o&5w &cG&6e&en&2e&3r&9a&5t&ce&6r"
	quest.0AE28C998A3BF136.quest_subtitle: "531,441 下界岩"
	quest.0AE6AD813928DE4F.quest_desc: ["外部加热器可用于熔炉，如&2&l原版&r熔炉，而非&c&l粗制高炉&r！ \\n\\n它从底部吸收&c能量&r并用于加热。 \\n\\n热量从其其他侧面输出，传递给相邻方块。 \\n\\n技术上，它用于制作&4&l改进型高炉&r的预热炉，但这不算在内！"]
	quest.0AEAEA976ED0C470.quest_desc: ["&3充电站&r用于利用压力为 &aPneumaticCraft&r 中的各种工具和装置充电。"]
	quest.0AEAEA976ED0C470.quest_subtitle: "绳子在哪里？"
	quest.0AEC181F5E21A299.quest_desc: [
		"如果你听说过“Melon Power”，那就是这个了。Mekanism的&9Gas-Burning Generator&r可以通过泵入由Melon Slices制成的&9Ethylene&r来产生大量电力。"
		""
		"要生产 &d乙烯&r，先用 &e破碎机&r 粉碎有机物来制造 &6生物燃料&r。通常用西瓜片！然后将燃料泵入 &d加压反应室&r（简称 PRC）。"
		""
		"PRC需要水、生物燃料和氢气来制造乙烯。氢气可以通过在&9电解分离器&r中分离水获得。"
		""
		"开始生产乙烯后，将其泵入燃气燃烧发电机以开始发电！"
	]
	quest.0AEC181F5E21A299.quest_subtitle: "甜瓜的力量"
	quest.0AEC181F5E21A299.title: "&eMekanism的&r &d燃气燃烧发电机&r"
	quest.0AF5FB1B5AA5AA11.quest_subtitle: "等级：&b4"
	quest.0AF777F2B7D0443A.quest_desc: [
		"&6&lPrism Drift&r&r Modpack 的版权为 &eAll Rights Reserved&r。"
		""
		"Meaning all content within the modpack, including &l&eQuests&r&r, is protected. As such, this content may &n&l&cNOT&r&r&r be reused or redistributed in any public modpacks not released by &l&6Cubic Nexus&r&r without explicit permission from the creators."
	]
	quest.0AF777F2B7D0443A.title: "&6&lCubic Nexus 为 Prism Drift 整合包制作的任务包"
	quest.0AFC5B1AF055811A.quest_desc: [
		"&2Edelwood Bucket&r可以储存多桶液体，也可以用来捕捉鸡或鱿鱼等小动物。"
		""
		"你需要使用永冻附魔才能用它来携带岩浆。"
	]
	quest.0B0BDC37185AF9EC.quest_desc: [
		"远古圆环是由远古蜡制成的塔楼。 \\n\\n顶部可能有圆环，里面有流动的风。 \\n\\n你还能在那里找到蛹！ \\n\\n看起来是使用鞘翅的好地方！"
		"{image:atm:textures/questpics/bumblezone/bumble_hoops.png width:200 height:100 align:center}"
	]
	quest.0B0BDC37185AF9EC.title: "远古的环形竞技场"
	quest.0B1DF8A040826D87.quest_desc: ["现在你有了 &cRossinite&r，可以将其与 &aBenitoite&r 混合，创造出 &dInsanite&r 锭。\\n\\n&aBenitoite Ore&r 可以在下界中找到。"]
	quest.0B1DF8A040826D87.title: "Insanite"
	quest.0B218DD73FE8D985.quest_desc: ["如果上一个任务完成正确，你应该已将奇点转化为一对&b量子纠缠奇点&f。这些新的奇点用于连接一个名为&e量子网络桥&f的环形装置。\\n\\n当使用量子纠缠奇点将两个独立的环连接起来，并用一些AE能量（如能量单元）启动后，ME网络就可以通过桥梁的另一端进行无线扩展，跨越遥远距离甚至不同维度。"]
	quest.0B218DD73FE8D985.title: "量子网络桥接器"
	quest.0B25F1EAC3D97093.quest_desc: ["击败&l&e远古残骸&r&r的奖励。可用于制作盔甲和武器。"]
	quest.0B2B8247DA280E90.quest_desc: ["此符文使祭坛的总容量在每拥有一个容量符文的情况下增加20%。"]
	quest.0B2FF8169FD3812D.quest_desc: [
		"&b钢制舱门&r的容量是&6青铜舱门的两倍&r，将一格物品栏增至2格，并将多区块的最大蒸汽消耗率从2 EU/t提升至4 EU/t。只要有一个钢制流体输入舱门接收蒸汽，你的整个多区块就会被升级到“钢制等级”。</p>"
		""
		"允许多区块使用 4 EU/t 的意思就是你所想的那样，它将处理速度提高了一倍。"
		""
		"&b钢制锅炉&r产生的蒸汽是青铜锅炉的两倍。这意味着其最大值将为 &o16 EU/t&r，而非 8。 &b钢制水泵&r产生的 &b水&r 量也为其青铜对应物的两倍，因此每个相邻水源最多可产生 250mb 的 &b水&r，每 5 秒最多可产生 2000mb 的 &b水&r。"
	]
	quest.0B2FF8169FD3812D.quest_subtitle: "正在等待什么东西孵化吗？"
	quest.0B2FF8169FD3812D.title: "钢制活板门"
	quest.0B37355262121DD5.quest_desc: ["&aInfusion Altar&r 是用来制作所有种子的地方。先放置祭坛，它会显示接下来要放置基座的位子。\\n\\n要开始充能，祭坛需要一个 &4红石信号&r。"]
	quest.0B37355262121DD5.quest_subtitle: "创建种子文件（Creating Seeds）"
	quest.0B3EA604C5172D98.quest_desc: ["要指定召唤的&c&m恶魔&r &9友人&r，我们需要制作一本特定的&b束缚之书&r。\\n\\n为此，你需要在&d灵魂之火&r中净化一些黑色染料以获得净化墨水。用这个，我们将制作第一本束缚之书，用来召唤一个&a福里奥&r恶魔。"]
	quest.0B3EA604C5172D98.title: "&b书籍：&d装订术"
	quest.0B485DB737A036E9.quest_desc: ["机器设置复制器允许玩家在机器之间复制设置。"]
	quest.0B4D059EDFD90B5B.quest_desc: [
		"将&b蚀刻槽&r装满&2蚀刻酸&r，并放入在&eUV光箱&r中曝光过的&7空PCB&r。"
		""
		"Optionally, you can &cheat&r the tank to above &c50&r degrees Celsius to &espeed&r up the etching process, though this will cause the &2Etching Acid&r to be consumed more rapidly. "
		""
		"从侧面提取&b未组装的PCB&r，并从储罐顶部或底部提取&c失败的PCB&r。"
	]
	quest.0B51F404F1E84C17.quest_desc: [
		"步骤3：建筑师"
		""
		"在建造任何东西之前，你需要一个建造者。建造者必须先建造自己的建造小屋，才能建造其他小屋，并且不能建造或升级小屋至高于自己小屋等级的水平。"
		""
		"提示：尽可能多地收集材料，在建筑师开始建造时交给他们。根据你选择的建筑风格，他们会在每次建造或升级时向你索要各种材料。大多数风格所需的材料主要是木材、鹅卵石和用于低层级的火把。更进一步的升级则需要更复杂的材料。"
		""
		"提示：尽快将建造者小屋升级到2级，以便建造者能升级其他建筑。"
		""
		"提示：将小屋升级到最高等级（酒馆除外，均为5级）以获得成就（并加快工人升级速度）。"
	]
	quest.0B6772E52FE97284.quest_subtitle: "&f11&r &4伤害&r"
	quest.0B6D35F5B3A11FD2.quest_desc: ["&9Aura Cache&r 可用于存储 &aAura&r！"]
	quest.0B6D35F5B3A11FD2.quest_subtitle: "正在缓存中！"
	quest.0B6D35F5B3A11FD2.title: "&9光环缓存器"
	quest.0B70D40FA951E13B.quest_subtitle: "橡木 + 桦木"
	quest.0B7B4C27767760A1.quest_desc: [
		"标准蜂巢和高级蜂巢的主要区别？&e物品栏及其GUI&r。"
		""
		"高级蜂巢拥有内部物品栏，可以储存用于填充的瓶子，并且能够自动生产蜂巢（前提是物品栏有足够空间）。"
		""
		"是的，&3管道&r可以用来将物品放入/取出蜂巢！"
	]
	quest.0B7B4C27767760A1.quest_subtitle: "好多了"
	quest.0B7B4C27767760A1.title: "自动蜂巢系统"
	quest.0B7F2B63D867D221.quest_desc: ["下到&e诅咒金字塔&r底部后，你可能会发现&e远古残骸&r不怎么动。这是因为你需要沙漠项链来复活它。要找到它，你得刷掉&e诅咒金字塔&r里的沙子。（希望你在下去前读了这个说明）。"]
	quest.0B7F2B63D867D221.quest_subtitle: "复活远古遗迹生物（Ancient Remnant）"
	quest.0B7F2B63D867D221.title: "沙漠的项链 (Necklace of the desert)"
	quest.0B87874066386C35.quest_desc: ["如果找不到幽灵蜜蜂，可以用一个恶魂之泪在&6灵魂沙巢&r中召唤一只。"]
	quest.0B87874066386C35.quest_subtitle: "这个才叫“有趣”呢"
	quest.0B94435972292812.quest_desc: [
		"&bSpatial IO Port &f是&bSpatial Digitizing系统&f的核心。它被放置在所有3个&bpylon边缘&f交汇的顶点。你可以在这里放置&bSpatial Drive &f并让它&6捕获一个建造物或释放它&f。在给系统充电时，也需要为这个方块供电。"
		""
		"You can also interact with the &bSpatial IO Port with hoppers&f or other piping methods to automate the process if you so desire. A &6redstone signal&f is all the &bSpatial IO Port&f needs to activate. Be careful!"
	]
	quest.0B94435972292812.title: "空间输入输出端口"
	quest.0B97B0BC5EE74D19.quest_desc: [
		"获取一个再生蜜蜂的刷怪蛋，并使用地狱火锻造炉锻造一个地狱火蜜蜂的刷怪蛋。"
		""
		"（JEI 在这个任务上会帮大忙。）"
	]
	quest.0B97B0BC5EE74D19.quest_subtitle: "地狱熔炉锻造台"
	quest.0B98E8AC5CFB0FC2.quest_desc: ["当你的&b Entroized Clusters &a生长&f到&amax stage&f时获得。"]
	quest.0B9BBE2A764631BF.quest_desc: ["简易交换器可以将物品、方块、生物或玩家传送到与其相连的另一个简易交换器。使用Ferricore扳手来连接交换器。"]
	quest.0B9CBAC5D036021A.quest_subtitle: "探索一种全新的远程伤害输出方式"
	quest.0B9F2B443813F43C.quest_desc: ["你曾想用铲子攻击东西并造成伤害吗？我本会问为什么，但这是 EvilCraft。\\n\\n那么，无需再寻觅！它既是武器，也是破坏软质物品的工具！"]
	quest.0BA2EB1462A10A39.quest_desc: ["基础的&6蜜蜂笼&r可用于捕捉和储存任何蜜蜂。它们看似有限，但在某些特定情况下，一次性笼子会比坚固型更合适。此外，只有它们可以制作，而坚固型可重复使用的笼子只能通过&e战利品&r获得。"]
	quest.0BA2EB1462A10A39.quest_subtitle: "使用笼子1次，消耗时间"
	quest.0BA5A0DDD4A5363C.quest_subtitle: "钴矿石应该在这里"
	quest.0BA5A0DDD4A5363C.title: "加尼埃石脉"
	quest.0BAD21557994331D.quest_desc: [
		"盐酸和铁粉会&e发生化学反应&r，生成氯化铁(III)"
		""
		"而且你还能拿回一些氢气！"
		""
		"别忘了你的&a程序设置&r，这个应该设为1"
		""
		"建议为此设置一个&b请求者&r"
	]
	quest.0BB0DF36B079558F.quest_desc: ["将&6Entangled Chalice&r放置在世界中，它就能抽取血液。在物品栏中激活后，它会尝试填充使用&cBlood&r作为资源的物品。\\n\\n如果想用同一网络制作更多圣杯，只需使用以圣杯代替金锭的合成配方即可。"]
	quest.0BB0DF36B079558F.title: "&6纠缠的圣杯"
	quest.0BB367839D28607D.quest_desc: [
		"RFTools 煤炭发电机是最容易制作的燃煤发电机之一。"
		""
		"它非常简单易用，能根据输入的易燃材料产生可观的电力，并且会自动将电力输送给相邻的方块。"
	]
	quest.0BB367839D28607D.title: "煤炭发电机"
	quest.0BB562FB44B0AAA7.quest_desc: ["卡牌并非唯一有上限的，所以它们也不是唯一有超频器的！ \\n\\n这些超频器放在右下角的 &c节点&r 上，可以提升其运算速度。"]
	quest.0BB562FB44B0AAA7.quest_subtitle: "最大值：8"
	quest.0BB8D556305EB307.quest_desc: [
		"以太河流，你看到它的时候就会知道。 \\n\\n它很亮，非常亮，地图上可能显示为红色，那是个bug，忽略即可。"
		"{image:atm:textures/questpics/eternal/starlight_ether.png width:200 height:100 align:center}"
	]
	quest.0BB8D556305EB307.title: "以太河流"
	quest.0BC106B34AD386E5.quest_desc: ["&l&cRegions Unexplored&r 是另一个生物群系模组，首次加入 &l&6AllTheMods!&r \\n\\n当然，生物群系也带来了更多树木！"]
	quest.0BC106B34AD386E5.title: "&l&c未探索区域&r日志"
	quest.0BC727E0B269BE1B.quest_desc: ["&b&l焚化炉&r&r是最酷的武器之一！这把超大型Ignitium剑，用2个Ignitium锭、4个烈焰棒和一把下界合金剑合成，击败Ignis即可获得。它也是Ignis使用的武器。按住右键3秒后松开，即可使用Ignis在第三阶段作为特殊技使用的&b&l火焰爆发&r&r技能。"]
	quest.0BC727E0B269BE1B.title: "&b&l焚化炉 The Incinerator"
	quest.0BCA00285412FC60.quest_desc: ["如果没有找到蜜蜂，可以用蜂蜜点心在&7石头&r或&a芦苇&r巢上生成蜜蜂。"]
	quest.0BCA00285412FC60.quest_subtitle: "石头或芦苇巢穴"
	quest.0BCC79C1D002F532.quest_desc: ["要将 &bArcane Crystal Dust&r 变成 &bLiquid Aureal&r，我们需要液体！确切地说，需要的是 &9Water&r！ \\n\\n只需将 &9Water&r 从 &9Sink&r 接入管道即可，它是无限的。"]
	quest.0BCC79C1D002F532.title: "无限量的 &9水&r！！！"
	quest.0BCCDE24D378F260.quest_subtitle: "等级：&d3"
	quest.0BCCDE24D378F260.title: "&d高级机械框架"
	quest.0BD908937BC6E97B.quest_subtitle: "Kapok + Rosewood"
	quest.0BDF41399223A10A.quest_desc: ["使用卷轴锻造台和末影珍珠来制作末影卷轴。"]
	quest.0BE2E7C9454058C3.quest_desc: [
		"美丽的&d&l花田&r中，有一棵比其他树木更古老、更庞大的&d樱花树&r。 \\n\\n&6蜂&8群&6和&8蜂&r似乎很喜欢这些&d树&r，并在它们旁边建起了装满幼崽的迷你&e蜂巢&r！"
		"{image:atm:textures/questpics/bumblezone/bumble_cherry.png width:200 height:100 align:center}"
	]
	quest.0BE2E7C9454058C3.title: "&d樱花老兵树"
	quest.0BE6CE2C264140AD.quest_subtitle: "等级：&a2"
	quest.0BF40B5B6ED8203F.quest_subtitle: "用skyroot为自己打造一个全新的开始"
	quest.0BF40B5B6ED8203F.title: "新木材！"
	quest.0BFAF1499415DD68.quest_subtitle: "银色石灰 + 樱桃"
	quest.0BFD8ED8A0E3AE60.quest_subtitle: "生成时确保手臂下方没有雪或草等障碍物。"
	quest.0BFD8ED8A0E3AE60.title: "击败&8&l凋零王（The Wither）"
	quest.0C096EE635645E43.quest_desc: ["水晶十字弓的配方和机械十字弓一样，只是用晶体代替了木棍。 \\n\\n它能射出箭矢，伤害与普通十字弓相同，但会施加晶体感染。晶体感染每秒造成1点伤害，并且会生成晶体！没错，这足以杀死生物。"]
	quest.0C0DF9103213979A.quest_desc: ["The &4&lLaser Gatling Gun&r&r can be used to decimate enemies’ health quickly. &4&lGatling Guns&r&r act as fully &nautomatic rifles&r and can even set blocks on fire that the bullets touch. You can fire a lot of shots before they need to be reloaded, which will cost &41 Redstone Dust&r."]
	quest.0C0DF9103213979A.title: "&l&4激光加特林枪"
	quest.0C1C61B4554B38E5.quest_desc: [
		"The &bCombiner&r allows you to &6combine items&r together like a &dgem&r and &7stone&r to receive &8ore&r, &ewax&r and &ccopper&r to protect it from the elements, mixing dyes, and more. "
		""
		"查看你的 &dEMI&r，看看还能用它做些什么。"
	]
	quest.0C1C61B4554B38E5.title: "组合器"
	quest.0C1D55AA9CC902BD.quest_desc: [
		"有效升级："
		"- 割草机"
		"- 天空清扫者"
		"- 自动熔炉"
		"- 锤子"
		"- 掉落物品：Teleporter"
	]
	quest.0C1EC499EB16C604.quest_desc: ["这可以在 &cNether&r 的 &dBastions&r 中，通过 &2brushing&r &aSuspicious Soul Sand&r 找到。"]
	quest.0C1EC499EB16C604.title: "&b振金升级&r"
	quest.0C25F73C0E0FB22A.quest_desc: ["我们的&c&l自动锻造炉&r还需要另一种精华，那就是&a经验&r！确切地说是来自&3&lJust Dire Things&r的&a流体经验&r。 \\n\\n要获得&a经验流体&r，我们需要一个&a经验收集器&r，可以通过“收集经验”选项设置在特定区域内收集&a经验&r。 \\n\\n别担心，被&7尖刺板&r击杀的生物仍然会掉落&a经验&r，所以把它们放在农场旁边吧！ \\n\\n你也可以将其他形式的&a流体经验&r，甚至是自己的&a经验&r等级存入其中！"]
	quest.0C25F73C0E0FB22A.title: "自动获取&a经验值"
	quest.0C2DFB4A8DF29B1D.quest_desc: [
		"&l1. 信息&r"
		"- 用物品&5Augment&r仪式，它会返还一个&bWayfinder&r（像指南针一样）"
		"&8+ 它会指向结构，并显示你离它还有多远"
		"&8+ 它会定位到距离&b仪式地点&r最近的&6&8结构"
		""
		"&l2. 一些著名建筑&r"
		"- &b原版结构&r"
		"&8+ 下界堡垒"
		"&8+ 堡垒遗迹"
		"&8+ 海洋纪念碑"
		"&8+ 远古城市"
		"&8+ 末地城市"
		""
		"- &bArs Structures&r"
		"&8+ 野人巢穴"
		"&8+ 神秘图书馆"
	]
	quest.0C2DFB4A8DF29B1D.quest_subtitle: "结构指南针"
	quest.0C2EC56133D3CC6C.quest_desc: [
		"&l能力类型：&r主动型"
		""
		"&l能力功能：&r"
		""
		"激活后使玩家暂时免疫伤害，有冷却时间。"
	]
	quest.0C37E9D8A7823264.quest_desc: ["Artificer's Cane 能帮助所有老家伙走路——开玩笑的。这根法杖能降低冷却和施法时间，并提升你的法术强度。虽然比 Graybeard staff 贵点，但施放大型法术时很值（让这些法杖自成一体）。"]
	quest.0C38F40FD6AA01E6.quest_desc: ["Caliburn 初始属性略优于钻石剑，但升级后钻石剑反而更像根普通木棍。Morgan 和 Caliburn 都有各自的实际伤害和内在上限。内在上限是其可提升的最大伤害值。要提高 Caliburn 的内在上限，先附魔“亡灵克星”，再将其投入湖中并使用“末地升级”。要达到最大上限，需要 26 个“末地升级”。升级后便无法再升级，请务必一次性投入全部 26 个。要提高普通伤害，则需要先附魔“亡灵克星”，然后再投入湖中！你需要更高的伤害才能..."]
	quest.0C38F40FD6AA01E6.title: "升级Caliburn以升级Morgan"
	quest.0C3B3D7F82A6DB3D.quest_desc: [
		"我们已经用掉了这么多融合反应堆！"
		""
		"但我说过这是一个重要建筑。如果你还没做，堆叠环形聚变反应堆会很有帮助。"
	]
	quest.0C3B3D7F82A6DB3D.quest_subtitle: "使用聚变反应堆的方法如下："
	quest.0C4065E442FF26E2.quest_desc: ["Alpha 升级将使每只蜜蜂每次飞行产出的蜂巢数量增加 %120。"]
	quest.0C4065E442FF26E2.quest_subtitle: "现在才叫真正的生产环节。"
	quest.0C557A9494F58400.quest_desc: ["使法力爆发在命中的方块上产生火焰。此火焰提供光照，仅为装饰。可用另一个法力爆发将其扑灭。"]
	quest.0C596CB7C7C24615.quest_desc: ["{atm9.quest.enchant.desc.Soul_deep}"]
	quest.0C596CB7C7C24615.title: "{atm9.quest.enchant.Soul_deep}"
	quest.0C6719D81DE5A614.quest_desc: [
		""
		"锻造台需要4种不同的物品来提供能量：Aureal、Souls、Blood和Experience。"
		""
		"想了解更多信息，请完成角落里的任务！"
	]
	quest.0C6D0B1C1AF75292.quest_desc: [
		"温斯顿？你他妈的说的没错，当然有关系。"
		""
		"&b化学反应器&r是一种封闭式机器，可以利用此世界中物质之间的&6化学反应&r来制造新物品。"
		""
		"&b化学反应器&r会促进这些反应，并保持其隔离，这样你就不会被释放的烟雾、液体或固体所伤害或致病。"
		""
		"那么，你愿意吗？我们开始烹饪吧。"
	]
	quest.0C6D0B1C1AF75292.quest_subtitle: "说出我的名字！"
	quest.0C6D0B1C1AF75292.title: "化学反应器"
	quest.0C7491BA5857AA00.quest_subtitle: "柚木 + 丛林"
	quest.0C78FB6EB275960B.title: "谢尔顿石脉"
	quest.0C7D96DB3573EF9C.quest_desc: [""]
	quest.0C7D96DB3573EF9C.quest_subtitle: "&o创造生命的能力。"
	quest.0C7D96DB3573EF9C.title: "&5&l创造精华"
	quest.0C8180524757B238.quest_desc: [
		"&7Floaters&r在Minecraft文件中不算结构，但通俗来说算。 \\n\\n它们可能出现在任何生物群系，但在&7&lHowling Constructs&r中尤其常见！ \\n\\n它们是漂浮的圆盘状结构，由Ancient Wax制成。若未使用Essence of Bees，接触Ancient Wax会获得虚弱、减速和挖掘疲劳。上面还有&6Honey Cocoons&r或&5Crystals&r！"
		"{image:atm:textures/questpics/bumblezone/bumble_floaters.png width:200 height:100 align:center}"
	]
	quest.0C8180524757B238.title: "&7漂浮生物"
	quest.0C82CE3AFBD48C1E.quest_desc: ["&l&aSushi Go Crafting&r 增加的方块不多，但我强烈建议用新增的方块来装饰你的厨房！ \\n\\n尤其是电饭煲，再也不用微波炉煮饭了。"]
	quest.0C82CE3AFBD48C1E.title: "&l&a寿司制作法&r"
	quest.0C856BBB1679A7DD.quest_desc: ["在这一页，你会找到一些有助于你旅途的实用物品和信息！"]
	quest.0C856BBB1679A7DD.quest_subtitle: "以及其他实用物品！"
	quest.0C93D7A607AB8B83.quest_desc: ["要认领区块，使用 &6M&r 打开地图，然后点击左上角的 &aClaim Map&r 图标。\\n\\n要认领区块，左键单击并拖动以认领。\\n\\n要强制加载区块，按住 Shift 键左键单击该区块。操作正确的话，你会看到区块上出现线条。"]
	quest.0C98503A2F20484D.quest_desc: [
		"在霜冻原附近，你可能会找到霜冻雾霾森林。 \\n\\n它们就像霜冻原一样，只是长满了雾霾茎树！"
		"{image:atm:textures/questpics/undergarden/undergarden_frostytrees.png width:200 height:100 align:center}"
	]
	quest.0C98503A2F20484D.title: "霜冻烟雾茎森林"
	quest.0C9C5639D76FDF65.quest_desc: ["将12只&6蜜蜂&8、&6蜜蜂&8、&r蜜蜂&6、&8蜜蜂&6、&8蜜蜂&r的毒针重新装上即可救活它们。\\n\\n当&6蜜蜂&8、&6蜜蜂&8、&r蜜蜂被生物或玩家击中时，它们会失去毒针并受到致命毒液的伤害。\\n\\n用毒针右键它们，就可以重新装上毒针，从而拯救它们！"]
	quest.0C9DD8E53A1B92C0.quest_desc: [
		"有效升级："
		"- 矿石矿工 Ore Miner"
		"- 自动熔炉"
		"- 锤子"
		"- 掉落物品：Teleporter"
		"- X-Ray"
		"- 即时破坏"
	]
	quest.0CBF5A49066468DD.quest_desc: [
		"是的，制作UV级电路合成器可能看起来很奇怪，因为主机用的是装配线，但这将带来巨大的好处。"
		""
		"UV电路合成器能让你一次合成4个LuV湿件处理器！节省巨大，回报翻倍！"
	]
	quest.0CBF5A49066468DD.quest_subtitle: "我们需要这个吗？"
	quest.0CBFE2CE53DCACD5.quest_desc: [
		"&l能力类型：&r被动"
		""
		"&l能力功能：&r"
		""
		"增加玩家的跳跃高度。"
	]
	quest.0CC0632E8276C787.quest_desc: ["将传送垫放置在&l&c下界&r，即可前往&b&l另一个世界&r。"]
	quest.0CC0632E8276C787.title: "&c&l下界（The Nether）"
	quest.0CC48C2AA553A314.quest_desc: ["&3钻头&r可用于气动冲击钻。"]
	quest.0CCA0F3A3226B20F.quest_desc: ["隐藏在最底层，这个类哥斯拉的 boss 会在你靠近房间中央的祭坛时生成。在损失部分生命值后，&d&l末地守卫&r&r会击碎地板，揭示出一个大型 boss 竞技场。死亡后，它会掉落&l&d守护者手套&r&r，并有几率掉落音乐唱片《堡垒的最后一战》。"]
	quest.0CCA0F3A3226B20F.quest_subtitle: "&d每个守护者的内心都蕴藏着无畏的勇气，无论付出何种代价"
	quest.0CCA0F3A3226B20F.title: "&d&l击杀末地守卫者"
	quest.0CD04A00529FE1C9.quest_desc: ["铜质宝箱可以制作，但不是制作铁质宝箱所必需的，不过如果你想节省一些铁，也可以使用它。"]
	quest.0CD04A00529FE1C9.title: "&6铜质宝箱"
	quest.0CDBF9C116B9F573.quest_desc: [
		"&e&l迷宫&r&r是暮色沼泽中一座不起眼的小山，里面通向一个地下迷宫。深处有一个围栏围住的房间，里面是牛蘑菇的Boss生成器。"
		""
		"&e&lMinoshroom&r&r 是一种潜伏在迷宫底部牢笼中的迷你首领，外形酷似蘑菇牛和牛头怪的怪异结合体。"
	]
	quest.0CDBF9C116B9F573.title: "&2&l击杀牛蘑菇怪 (Slay The Minoshroom)</c2></c1>"
	quest.0CDDB924182973FF.quest_desc: ["&b幽灵&r蜜蜂的家园。"]
	quest.0CDDB924182973FF.quest_subtitle: "木制剑 + 灵魂沙"
	quest.0CE0D164B29B447F.quest_desc: ["&l&5黑曜石之心&r&r是一种特殊掉落物，可用于制作3种实用物品。"]
	quest.0CE0D164B29B447F.title: "&5&l黑曜石之心"
	quest.0CE1F6DE5FD6A6D9.title: "&aEvocation&r 升级球体"
	quest.0CE236731DF15DFF.quest_desc: ["为什么要等？通常，Minecraft 中掉落的物品需要一秒钟才能被拾起。 \\n\\n但为什么要等呢？\\n\\n此升级让真空模块无需等待，可立即拾起物品。 \\n\\n能有效减少延迟！"]
	quest.0CE52E0611E65906.quest_desc: ["&e&l远古遗骸&r&r是一具带有&e法老头饰&r的大型恐龙骨架，必须用&l&e沙漠项链&r&r来唤醒。死亡后，它会掉落&e&l瓶中沙尘暴&r&r、&e&l远古金属块&r&r、&e&l遗骸的头骨&r&r，并有几率掉落《支配的沙》音乐唱片。"]
	quest.0CE52E0611E65906.quest_subtitle: "&e在遗忘的历史灰烬中，我永存——一个超越记忆时代的残影"
	quest.0CE7E899D54A6AE8.quest_subtitle: "恭喜你！你已完成 AE2！"
	quest.0CE7E899D54A6AE8.title: "&bApplied Energistics &d100%"
	quest.0CF69DBA9573A7B3.quest_desc: [
		"蓝图工作台会将结构读取到/写入你的蓝图中。"
		""
		"你可以用它来复制建筑，或者与他人分享建筑！"
	]
	quest.0CF6D11016BAF3D0.quest_desc: ["现在我们正在生产一些复杂的钠达。就像我们正在开发的所有其他复杂资源一样，这种资源也为工厂带来了显著的好处。"]
	quest.0CF6D11016BAF3D0.quest_subtitle: "复杂的纳夸达合金"
	quest.0D01524F249E25D7.quest_subtitle: "是谁把灯关掉了？"
	quest.0D01524F249E25D7.title: "&8暗色奇晶宝石"
	quest.0D19FB62C2C1D9F7.quest_desc: ["至少有 200 个 &4Mahou&r 后，你可能想制作一个生命汲取边界。 \\n\\n在该边界内，每死亡一个生物，你就能获得 10 个 &4Mahou&r 返还，但这过程非常缓慢。"]
	quest.0D19FB62C2C1D9F7.title: "生命汲取的边界"
	quest.0D1A6B32FEB51FAD.quest_desc: [
		"用这个小技巧把方块变成盘子！"
		""
		"制作硅晶圆和晶圆芯片也很有用，我们稍后会讲到"
	]
	quest.0D1A6B32FEB51FAD.quest_subtitle: "尖端科技"
	quest.0D1AFCAD90FAA4F9.quest_desc: ["这根魔杖已预先调谐，用于寻找&a普通&r材料。"]
	quest.0D20644407244A60.quest_desc: ["每3个区块你都会发现另一个矿脉！"]
	quest.0D20644407244A60.title: "下界层矿石"
	quest.0D212038C0A45E0B.quest_desc: ["Casull Cartridges 是默认子弹。它们造成 5 点伤害，仅此而已！ \\n\\nArmor Piercing Cartridges 有更高的几率无视护甲值。非常适合对付像 Bulwark 这样的生物。 \\n\\nBuckshot Shells 会发射多枚弹丸，而不是 1 枚。近距离使用效果最佳！ \\n\\nSilver Cartridges 的作用与 Casull Cartridges 相同，但对 Undead Mobs：Zombies 和 Skeletons 的伤害更高！"]
	quest.0D212038C0A45E0B.title: "常见投射物模组整合包任务书文本"
	quest.0D259B9B93B39FAE.quest_desc: ["建造这个组件很昂贵。但随着我们继续前进，会需要几个。有几个不同的多区块结构都依赖 ZPM 场发生器。"]
	quest.0D259B9B93B39FAE.quest_subtitle: "昂贵，但物有所值"
	quest.0D26E5EF6CFCFDBF.quest_desc: ["耐久度高于匕首，但伤害和速度较低。"]
	quest.0D26E5EF6CFCFDBF.quest_subtitle: "Stabby"
	quest.0D2C935F99D1A1FE.quest_desc: [
		"在我们的&a工程师手册&r中，你可以在&e重型机械&r类别下找到&a榨汁机&r。"
		""
		"这是一个多方块结构，我们将用它将&3焦炭粉&r挤压成&3HOP石墨粉&r。将其熔炼以创造锭！"
	]
	quest.0D2C935F99D1A1FE.title: "榨汁机"
	quest.0D2D1F99945BA209.quest_desc: ["理论上，双击 S 键会装备你的 &8&l重型板甲盾牌&r... 强调是理论上。 \\n\\n提醒一下，&8&lIE&r 仍在测试版中！模组开发需要大量时间和精力，请尊重开发者的劳动！"]
	quest.0D2F5CC96269F9E3.quest_desc: ["制作PCB的下一步是使用蚀刻酸在&3蚀刻槽&r中进行操作。需要热量才能运行。"]
	quest.0D2F5CC96269F9E3.quest_subtitle: "是时候进行蚀刻了！"
	quest.0D31CD79BE6CC8D2.quest_desc: ["为什么普通的面包不需要酵母呢？"]
	quest.0D31CD79BE6CC8D2.quest_subtitle: "你问题的根源所在"
	quest.0D31CD79BE6CC8D2.title: "酵母"
	quest.0D330FAD6C993DBC.quest_desc: ["这是对你魔法书的下一个升级！ \\n\\n这将增加你的总法力值和法力再生速度，并允许你创建和使用二级符文。"]
	quest.0D3DF9C8F742AE0D.quest_desc: [
		"橡胶树的各个部分都可以被提取成生橡胶浆"
		""
		"还有史莱姆球！"
	]
	quest.0D44F37BE787CA30.quest_desc: ["这种&3物质&r可以在&6热气动加工工厂&r中&b加工&r，生产出&eLPG&r，这是一种与&3Thermal Expansion&r的&7精炼燃料&r质量相当的&a优质&r&7液体燃料&r。"]
	quest.0D44F37BE787CA30.title: "&6汽油"
	quest.0D47F491C27BBD5E.title: "矿物砂矿脉"
	quest.0D4A85FBCE0015E1.quest_desc: [
		"这把&a锤子&r是用来将锭制成&a板&r的！虽然一开始用它很方便，但最终你还是需要制作一个&a压缩机&r来代替你完成这项工作。这需要能量！"
		""
		"你需要大量的&a铁锭&r和&a钢板&r来制作大量前往太空所需的物品，所以一定要实现自动化！"
	]
	quest.0D4A85FBCE0015E1.title: "制作&a盘子&r"
	quest.0D4C64DD58567758.quest_desc: ["在背包中添加了一个储罐。"]
	quest.0D4FE97640F2CA60.quest_desc: ["有36个过滤槽，速度是原来的6倍。"]
	quest.0D4FE97640F2CA60.title: "终极破坏者"
	quest.0D5015B8FF482D0A.quest_desc: [
		"我们需要用&3阿马德龙石板&r向&3阿马德龙&r订购一些东西才能继续。使用时，右键单击一个箱子或流体储罐，将货币（如绿宝石）放入相连的容器中，然后下达订单。你会看到一个阿马德龙机器人来收取款项，另一个则来交付订单。"
		""
		"{image:atm:textures/questpics/pneumaticcraft/amadron_drone.png width:300 height:150 align:center}"
	]
	quest.0D5015B8FF482D0A.quest_subtitle: "不知道他们能不能做到一日送达呢？"
	quest.0D5015B8FF482D0A.title: "阿马德龙"
	quest.0D50BDEFA0319EA1.quest_desc: ["成品将被放入你的输出箱子中。"]
	quest.0D50BDEFA0319EA1.quest_subtitle: "Always Required"
	quest.0D5691403AEC25A8.quest_desc: [
		"路由器也可以用来自动化农场！\\n\\n首先从一个简单的农场开始。然后需要一个激活模块，并将其对准作物。接着，在路由器中放置一个真空模块来收集作物。最后，将所有组件放入路由器，用红石供电，让它开始自动化吧！"
		"{image:atm:textures/questpics/router/router_farm.png width:60 height:150 align:center}"
	]
	quest.0D5691403AEC25A8.title: "用于耕种的自动路由器"
	quest.0D56A15EC335C11A.quest_subtitle: "这种冰与石头本身融合，创造了一种具有独特用途的新方块类型"
	quest.0D56A15EC335C11A.title: "压缩冰"
	quest.0D573979B25FAC48.quest_desc: [
		"请注意，每个能量舱口可以接受 2 安培的电力"
		""
		"许多机器都接受两个（或多个）能量舱，这意味着你可以输入4安，从而解锁更高电压等级的处理！"
	]
	quest.0D59094D0C23C44F.quest_desc: [
		"如果64个并行进程还不够，那256个呢？这正是这个方块的作用。它能让你运行256个并行任务！"
		""
		"这是最高等级的平行控制舱口！"
	]
	quest.0D59094D0C23C44F.quest_subtitle: "还不够吗？"
	quest.0D5D76B3551CD5A7.quest_desc: ["是的，它叫铝蜜蜂（Aluminium Bee）。"]
	quest.0D5D76B3551CD5A7.quest_subtitle: "结晶化 + 灰烬化采矿"
	quest.0D5D76B3551CD5A7.title: "铝蜜蜂"
	quest.0D632F9A1EAFDA57.quest_subtitle: "恭喜你！你已完成PNC！"
	quest.0D632F9A1EAFDA57.title: "&6PneumaticCraft &c100%"
	quest.0D68FA968FD2BEF4.quest_desc: [
		"如果你已经制作了&a大型化学反应器&r，就可以批量制作这些东西了！"
		""
		"否则，你将不得不使用&e化学反应釜&r，并准备&6一小堆铜粉&r、&9氢气&r和&2硝基氯苯&r"
	]
	quest.0D6D45DBA64E612D.quest_desc: ["最大生成延迟是指生成生物所需的最长时间。与最小值一样，它可以低至20，高至32,767。每个时钟将生成器的速度修改10。速度以游戏内计时单位表示，20单位等于1秒。因此，最快的生成延迟是每只生物间隔1秒。"]
	quest.0D6D45DBA64E612D.title: "最大生成延迟"
	quest.0D888A4C5EF0073E.quest_subtitle: "桃花心木 + 木棉木"
	quest.0D8988AF02D890EA.quest_subtitle: "找到一个远古战场（Ancient Battleground）"
	quest.0D8988AF02D890EA.title: "行尸走肉"
	quest.0D8AC4FB1F61B07A.title: "&d星辰大海，征途在望！&r"
	quest.0D8D493B7118A9BA.quest_subtitle: "点击&4龙&r将其与哨子绑定。使用哨子时，它会把你&4龙&r传送到你身边，即使跨越维度！你也可以按&bG&r，用背包里的哨子召唤你的&4龙&r。"
	quest.0D8D493B7118A9BA.title: "制作一个&9龙之哨子"
	quest.0D91A6B36BD2F526.quest_desc: ["升级你的&7Cloggrum Battleaxe&r，打造出最强大的武器，&2&lUndergarden&r所能给予的！"]
	quest.0D91A6B36BD2F526.title: "终极武器！"
	quest.0D9354ABA2AE2A11.quest_desc: ["&2香薰棒&r可以在植物酿酒厂中用酿造物进行充能。使用打火石和钢锭点燃&9香薰板&r上的香薰棒，其效果持续时间将是液体形式的60倍，范围覆盖香薰板周围30格半径的区域。"]
	quest.0D9560C8E247F9E7.quest_desc: ["右键点击任意位置，你就能规划返回路线。如果离得够近且有直达路线，就会出现一条路径。"]
	quest.0D9560C8E247F9E7.quest_subtitle: "最大值：1"
	quest.0D97CDE92F3B1A83.quest_subtitle: "铅 + 钻石/铂金"
	quest.0D97CDE92F3B1A83.title: "末地蜜蜂"
	quest.0D99638C96AB2EEA.quest_subtitle: "你需要用到它"
	quest.0D99638C96AB2EEA.title: "被动氧气线 (Passive Oxygen Line)"
	quest.0D9D1462C676C050.quest_subtitle: "时间"
	quest.0DA354D54D288D20.quest_desc: [
		"&b基础热传导器&r用于将&4热量&r从一个地方传导到另一个地方。"
		""
		"添加到&c热力学网络&r的每个导体都会使总&4热容&r增加&a1.0&r，但整个网络将保持&e5.0&r的导热性和&c10.0&r的绝缘性"
		""
		"&bThermodynamic Conductors&r的隔热能力取决于&2biome&r。"
		""
		"如果你在&c温暖/炎热&r的生物群系中，传输效率会&a更高&r；如果你在&b寒冷/冰冻&r的生物群系中，传输效率会&c更低&r。"
	]
	quest.0DA354D54D288D20.title: "基础热力学导体"
	quest.0DA5BC8BA056B975.quest_desc: [
		"研磨机是矿石加工的第一步，但我们稍后再谈这个"
		""
		"目前我们需要木屑，所以把一些木头扔进去磨碎它们"
	]
	quest.0DA5BC8BA056B975.quest_subtitle: "粉碎和研磨中，请耐心等待。"
	quest.0DB1A5763EDD6A7F.quest_subtitle: "毒地牢的领主"
	quest.0DB4226BA23A5C09.quest_desc: ["将&b高级电路组装器&r移到你的&e洁净室&r，欢迎来到&5EV&r时代！"]
	quest.0DB4226BA23A5C09.quest_subtitle: "这台超级计算机能下赢国际象棋吗？"
	quest.0DB92C70D04725BE.quest_subtitle: "Duracell，给我一边去！"
	quest.0DBCB8228E7CF7E1.quest_subtitle: "具有防止不死生物攻击的特殊效果。有15%的几率在废弃矿井中找到。"
	quest.0DBCB8228E7CF7E1.title: "获得一枚 &f幽灵龙蛋"
	quest.0DC0E236C8213050.quest_desc: ["将500mB的未精炼液态灵魂与单个灵魂结合，就能创造出500mB的液态灵魂！ \\n\\n这需要比&b液态奥瑞尔&r多一倍的&d源&r，即2000个&d源&r。"]
	quest.0DC0E236C8213050.title: "液态灵魂"
	quest.0DC83D9B8B09C093.quest_desc: [
		"&bAlteration Table&r 可用于 &6升级&r &b盔甲&r。"
		""
		"&l1. 安装线轴：&r"
		"把你的&b盔甲部件&r放在桌子上。"
		"在纸张部分&6右键&r点击符文。"
		"将盔甲部件取出来。"
		""
		"&l2. 取出线头：&r"
		"把你的&b盔甲部件&r放在桌子上。"
		"&6右键&r点击纸张部分。"
		"将盔甲部件取出来。"
	]
	quest.0DC8B68CDF945348.quest_desc: ["路由器予取予求。 \\n\\n此模组对建筑师或矿工都很有用！它可以设置将物品从缓冲区发送到你的背包，或将物品从背包取入缓冲区。 \\n\\n非常适合剥离采矿，让它从背包中取出所有原石和深板岩，并放入垃圾桶。"]
	quest.0DD389A24F5F8CDD.quest_desc: ["&l&6王水&r&r是浓硝酸和盐酸的混合物，通常比例为1:3。炼金术士因其能溶解&l&e黄金&r&r而将其命名为“皇家之水”。"]
	quest.0DD389A24F5F8CDD.quest_subtitle: "我是一个芭比女孩，在一个芭比的世界里……如果你懂，就懂。"
	quest.0DDC127F1CB70026.quest_desc: ["繁殖一只克里比和一只铁蜜蜂。"]
	quest.0DDC127F1CB70026.quest_subtitle: "蜜蜂繁殖"
	quest.0DDE4F5B0FE265B0.quest_desc: [
		"&b压力管&r用于在&b压缩机&r和&b机器&r之间传输&7空气&r，并且可以&2伪装&r以融入周围的&a环境&r。"
		""
		"此外，&b管模块&r可以&6附加&r到这些&b管道&r上，以提供&a额外功能&r或&e特性&r。"
	]
	quest.0DF4B01CC5B49E4E.quest_desc: ["用这张蓝图，你就能制作基础剑了！伤害可靠，速度可靠。"]
	quest.0DF4B01CC5B49E4E.quest_subtitle: "老当益壮，值得信赖的伙伴"
	quest.0DF9014435C8F4D2.quest_desc: [
		"你可能想知道我为什么非要给你镍锌铁氧体锭，而这配方就是原因！"
		""
		"使用镍锌铁氧体和退火铜最划算，这两种材料你都可以制作！"
		""
		"制作NZF戒指和细丝时，你有多重选择。使用&eExtruder&r能从一个锭中获得最多的戒指，而&eWiremill&r能将锭变成丝，再将丝变成细丝。"
	]
	quest.0E02CE4469FCA4C9.quest_desc: ["红石激活能为你的生成器提供一个开/关开关。没有红石能量，它将不会生成。"]
	quest.0E02CE4469FCA4C9.title: "红石激活"
	quest.0E03F5EAE4963ECB.quest_subtitle: "8 干燥的绿色方块"
	quest.0E057B7F76401421.quest_subtitle: "第一次升级"
	quest.0E057B7F76401421.title: "&6铜质背包"
	quest.0E0CAA31480EC0A1.quest_desc: ["允许背包拾取物品。"]
	quest.0E0CAA31480EC0A1.quest_subtitle: "允许背包拾取物品。"
	quest.0E15E3DEA2EF1D63.quest_desc: [
		"&e&l魔法地图&r&r对于暮色森林的探险者至关重要，因为它们与维度相连，能揭示周围区域的重要信息。"
		""
		"虽然与主世界地图相似，魔法地图仅在暮色森林中有效，首次使用时会揭示四倍大的区域。但它们无法超出初始视野，因此大范围探索需要多张地图。"
		""
		"魔法地图不显示地形，而是用不同颜色显示暮色森林的生物群系和边界，帮助用户快速定位自己和附近区域，包括受魔法保护的区域。"
		""
		"地图的魔法焦点能探测主要地标，并用独特图标标记，方便探险者在暮色森林中导航和规划路线。"
	]
	quest.0E20A9B79D1C6637.quest_desc: ["卫道士是1.20版本新增的boss。\\n\\n当3个自然生成的潜声尖叫者连续触发，或在首个卫道士生成后任何尖叫者触发，它就会出现。\\n\\n它是Minecraft中最强大的生物，拥有500点生命值，攻击可造成超过20点伤害。\\n\\n它的攻击包括近战和针对远处目标的声纳冲击波。\\n\\n它唯一的弱点是盲目，但就像冒险家一样，这反而让它其他感官变得更强！靠近时它能闻到你的气味，小心发出噪音！\\n\\n如果你成功击败它，它会掉落：潜声催化剂、卫道士甲壳和深海之心。"]
	quest.0E20A9B79D1C6637.title: "击杀卫道士 (The Warden)"
	quest.0E2515424291BB59.quest_desc: ["&bDiamond&r version of &d&lArs&r Armors!"]
	quest.0E2515424291BB59.quest_subtitle: "20"
	quest.0E2515424291BB59.title: "&5战斗法师套装"
	quest.0E25CDB09FE88A63.title: "硝石种子"
	quest.0E2AD156E5EF263A.quest_desc: ["过去用于在抄写台（Scribe's Table）上刻写法术。"]
	quest.0E30CFA6C5B58BEA.quest_desc: ["这个&b炼金炉&r可以让你将&b炼金硝石&r从一阶转化为另一阶。"]
	quest.0E30CFA6C5B58BEA.quest_subtitle: "升级？"
	quest.0E32DB6B8E023764.quest_desc: ["&6&lProductive Bees&r？你在这里做什么？ \\n\\n有时在&6&lHive Walls&r或&6&lPillars&r上，你可能会发现来自&l&6Productive Bees&r的蜂巢沉积物！ \\n\\n有点像在&2Overworld&r里挖矿一样。"]
	quest.0E32DB6B8E023764.title: "跨界联动？"
	quest.0E349CAEF1D249B6.quest_subtitle: "&bSliders&r 是一种在 &eBronze Dungeons&r 中找到的首领。"
	quest.0E352E2B17084DAE.quest_desc: ["&b高级锯木厂&r可同时处理多达&a5&r个锯木流程，并包含相同的“&e自动分类&r”功能。"]
	quest.0E352E2B17084DAE.title: "高级锯木厂"
	quest.0E3A8954B2AAF9F7.quest_desc: [
		"使用&bRitual Brazier&r召唤&4Wilden Chimera&r，然后击败它。"
		""
		"此物品可让你制作最高阶的&bSpell Book&r。"
		""
		"为了庆祝你的胜利，送你一份免费的&bWilden Tribute&r ;)"
	]
	quest.0E3B4EFE149E0C72.quest_desc: ["需要一个Crux（下一个任务）"]
	quest.0E3B4EFE149E0C72.title: "&3振金种子&r"
	quest.0E3FDD8BB6D17A30.quest_desc: [
		"&l能力类型：&r主动型"
		""
		"&l能力功能：&r"
		""
		"激活后会破坏附近的树叶。"
	]
	quest.0E4C711E77497984.quest_desc: [
		"更多的齿轮就是好的齿轮！"
		""
		"继续处理吧，随着我们推进各个阶段，会需要相当多的这些装配线！"
	]
	quest.0E4C711E77497984.quest_subtitle: "当然，是齿轮模组了。"
	quest.0E4DA8EE961D443F.quest_subtitle: "悬铃木 + 糖槭"
	quest.0E50E568DFA078D5.quest_desc: [
		"&oJust Dire Things&r 的进度与四种 &o&l&bgoo&r 相关联。"
		""
		"制作每种&bgoo&r都需要前往不同的区域。"
		""
		"• &b&lPrimogel Goo&r—&6Overworld&r"
		""
		"• &b&lBlazebloom Goo&r—&6The Nether&r"
		""
		"• &b&l虚空闪烁凝胶&r—&6末地&r"
		""
		"• &b&l暗影脉冲凝胶&r—&6深层黑暗&r"
		""
		""
