	quest.73DF4B8186890BFE.title: "更多源中继器 (More Source Relays)"
	quest.73E2A53A088AD29A.quest_subtitle: "11 湿粉色方块"
	quest.73EA326304C01C3B.quest_desc: [
		"可以将其更改为在整数限制（超过20亿）时导入物品。"
		"{image:atm:textures/questpics/logistics/id_item.png width:200 height:50 align:center}"
