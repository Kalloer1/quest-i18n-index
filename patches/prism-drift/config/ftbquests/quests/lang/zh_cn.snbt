	quest.21693C4DE6531D73.quest_desc: [
		"破碎机正如其名所示。它能粉碎方块来获取制作材料，例如用砖楼梯制作砖块，或用锭制作粉尘。 \\n\\n但它需要能量才能工作！ \\n\\n建造一个需要3x2x2的破碎机方块。"
		"{image:atm:textures/questpics/railcraft/rail_crusher.png width:100 height:100 align:center}"
	]
	quest.21693C4DE6531D73.title: "破碎机"
	quest.216C2D79B2481DA3.quest_desc: ["&b高级通用电缆&r可在网络中承载 &e51.2 kFE/cable&r，每根附加电缆可为总网络传输速率增加 &e51.2 kFE/t&r。"]
	quest.216C2D79B2481DA3.title: "高级通用电缆"
	quest.216DA9782EBDFF34.quest_desc: ["我觉得这个模组不现实。我不管你有多少书或物品，恶魔不会听从你的每一个命令，也不会像奴隶一样为你工作。 \\n\\n尽管如此，你仍然可以按照任务来做。"]
	quest.216DA9782EBDFF34.title: "&b&lOccultism"
	quest.2171DC0B13C4BD43.quest_desc: ["&a&lRoots Classic&r在JEI里可能看起来很小，但我向你保证，它内容丰富！ \\n\\nRoots的核心是利用大自然的馈赠来制作仪式。\\n\\n相信我，你到处都能找到这些物品！"]
	quest.2171DC0B13C4BD43.title: "&a&lRoots Classic"
	quest.21770049843DD275.quest_subtitle: "第 2 部分，共 2 部分"
	quest.217DB12EA32E1724.quest_desc: ["要“升级”种子，需要用到&bInfusion Crystal&r。例如，将水晶与4个Inferium Essence结合，就能得到1个Prudentium Essence。\\n\\n之后你还能制作出不会损坏的Infusion Crystal。"]
	quest.217DB12EA32E1724.title: "&b灌注水晶"
	quest.217DF3B66A07A8DE.quest_desc: [""]
	quest.217DF3B66A07A8DE.quest_subtitle: "&o只需一个种子，即可拥有伊甸园。"
	quest.217DF3B66A07A8DE.title: "&3&l维度种子&2</c2></c1>"
	quest.2182492BCC1B33D8.quest_desc: ["安装在蜂巢中，每次交付蜂蜜时有5%的几率生成一只新的小蜜蜂。\\n\\n放置在捕虫器中，捕虫器将只捕捉小蜜蜂。\\n\\n你可以堆叠这些物品以获得更高的几率。"]
	quest.2182492BCC1B33D8.quest_subtitle: "制作宝宝"
	quest.218803812A9C332B.quest_desc: ["要获得更高的最大附魔和等级，你需要灌注地狱书架。为此你需要 &a22.5 Eterna&r 和 &c30%% Quanta&r。最好的方法是使用 15 个普通书架和 &45 个地狱书架&r。"]
	quest.218803812A9C332B.title: "&4Infused Hellshelf&r"
	quest.2188C52C1F384DE4.quest_desc: [""]
	quest.2188C52C1F384DE4.quest_subtitle: "&o永不熄灭的燃料（其实不然）。"
	quest.2188C52C1F384DE4.title: "&c&l哲人石燃料"
	quest.2190034B6F3E2768.quest_desc: ["这些是&b输入和输出设备&f的主要组成部分。"]
