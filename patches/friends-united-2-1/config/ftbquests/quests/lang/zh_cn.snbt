	quest.2D94FC9CC023FEC6.quest_desc: ["这种香料树苗可以在利罗思维度的香料沙漠中找到。你也可以在表世界种植它。"]
	quest.2D94FC9CC023FEC6.quest_subtitle: "收集一棵香料树苗。"
	quest.2DAB7AB569574644.quest_desc: ["浆果派：它们就像蛋糕，只不过是派！是不是很疯狂？如果这还不够说服你，由于派更胜一筹，你可以轻松地将它们切成片，或者在不小心掉到地上后捡起来。不过，吃完后再捡起来时要小心，因为它很可能会散成你之前留下的那片数。"]
	quest.2DAB7AB569574644.quest_subtitle: "制作一个黑莓派。"
	quest.2DB7B095937D5FC5.quest_desc: ["Tier 2 符文 - 在抄写台处制作。详情请参阅磨损的笔记本。"]
	quest.2DB7B095937D5FC5.quest_subtitle: "合成一个交换符文。"
	quest.2DBA0E5760B9995B.quest_desc: ["奖励：x15 经验等级"]
	quest.2DBA0E5760B9995B.quest_subtitle: "你征服了星光破碎机，恭喜你！"
	quest.2DC5D33DEA8ADEA1.quest_desc: [
		"拿起你遗忘的页面：[ancient manuscripts]，它们被撕自遗失在时光中的神秘典籍。这些页面散落在各地的箱子里，可以粘合起来制作附魔书。"
		"奖励：x2 书籍"
	]
	quest.2DC5D33DEA8ADEA1.quest_subtitle: "制作一张橡木绑定工作台。"
	quest.2DCBAC49ED03B162.quest_desc: [
		"提高植物生长速度。详情请参考 MA 指南。"
		"奖励：x1 至尊生长加速器"
	]
	quest.2DCBAC49ED03B162.quest_subtitle: "制作一个至尊生长加速器。"
