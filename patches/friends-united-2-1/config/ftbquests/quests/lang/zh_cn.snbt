	quest.1C8451F36BF31C75.quest_desc: ["用于在 Powah 模组中制作其他物品的材料。更多详情请参阅 Powah 手册。"]
	quest.1C8451F36BF31C75.quest_subtitle: "制作氮化镓晶体。"
	quest.1C8D4CC6EF722230.quest_desc: ["这样你就可以种植任何魔法植物，并且当它被放置在村民旁边时，会提供一个新的职业。"]
	quest.1C8D4CC6EF722230.quest_subtitle: "获取一个混合土壤花盆方块。"
	quest.1CBE7D41F36121E9.quest_desc: [
		"巫师很难对付。他会不断逃跑，停下来时会施放恶毒的魔法。他能召唤紫色火焰，虽然不会蔓延，但伤害极高，要小心！在后期浪潮中他会加入村庄袭击，也会出现在那个秘密地下结构中……"
		"奖励：x2 战利品包裹碎片"
	]
	quest.1CBE7D41F36121E9.quest_subtitle: "击杀一名巫师。"
	quest.1CC5172EB53A83C5.quest_desc: [
		"提高整流效率。"
		"奖励：x2 经验等级，x2 战利品包裹碎片"
	]
	quest.1CC5172EB53A83C5.quest_subtitle: "制作一个地狱束缚的矫正书架。"
	quest.1CCFBD335FB26CFA.quest_desc: ["存储网络也可以连接。为此，你需要一个物品线缆连接器或一个带过滤器的物品线缆连接器。它们能让你将存储网络与海外存储网络位置连接起来。"]
	quest.1CCFBD335FB26CFA.quest_subtitle: "制作一个带框架的库存电缆。"
