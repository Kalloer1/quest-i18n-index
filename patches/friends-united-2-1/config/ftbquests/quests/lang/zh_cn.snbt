	]
	quest.18D0DECF37C0ADC4.quest_subtitle: "酿造蓝莓果酱。"
	quest.1907691169EA1A8A.quest_desc: ["Exaustum Allium 是一种在沙漠中发现的花，它会慢慢枯萎，因此会试图吸取任何接触它们的生物的能量，使受害者虚弱和疲惫。"]
	quest.1907691169EA1A8A.quest_subtitle: "获得一个 exhaustum allium。"
