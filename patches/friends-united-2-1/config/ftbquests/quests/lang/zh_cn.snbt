	quest.666855A02B7B4823.quest_subtitle: "制作一把钻石刀（Diamethyst Knife）。"
	quest.66784B5E6CF56843.quest_desc: ["存储网络也可以连接。为此，你需要一个物品线缆连接器或一个带过滤器的物品线缆连接器。它们能让你将存储网络与海外存储网络位置连接起来。"]
	quest.66784B5E6CF56843.quest_subtitle: "制作一个带框架的库存电缆。"
	quest.667CBAC6050ED80B.quest_desc: [
		"泰坦是末地傀儡的体型更大、力量更强的版本。"
