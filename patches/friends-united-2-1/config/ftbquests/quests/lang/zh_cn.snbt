	quest.0F89BE8694B6FE28.quest_desc: [
		"一种装饰性的火把。"
		"奖励：x1 真菌火把"
	]
	quest.0F89BE8694B6FE28.quest_subtitle: "制作一个真菌火把。"
	quest.0F8DE3B18B2F0973.quest_desc: [
		"在青铜地牢中击败滑块后，可从其中的宝箱中获得。"
		""
		"凤凰弓可在青铜地牢宝箱中找到。它会射出火焰箭（文字为绿色），与原版Minecraft的弓不同，此弓无法合成。射箭时不会损坏弓。如果箭矢击中地面，地面将被点燃。"
	]
	quest.0F8DE3B18B2F0973.quest_subtitle: "获得一把凤凰弓。"
	quest.0F8E94CA26BFA508.quest_desc: ["药水瓶最多可储存100瓶药水，放置在炼金源链接附近可用作源。更多详情请参阅旧笔记本。"]
	quest.0F8E94CA26BFA508.quest_subtitle: "酿造一个药水瓶。"
	quest.0F9C5D39DEECCE8D.quest_desc: [
		"血玫瑰生长在雪地生物群系。过去人们认为血玫瑰会收集经过的生物的血液，但后来发现这是错误的。这个名字既源于这一误解，也源于花瓣的鲜红色。"
		""
		"血玫瑰用于制作再生戒指。"
		""
		"一位著名的炼金术士发现，血玫瑰收集的并非实体的血液，而只是它们能量的一份样本。"
	]
	quest.0F9C5D39DEECCE8D.quest_subtitle: "获得一朵血玫瑰。"
	quest.0FA1CF00DCF298C6.quest_desc: [
		"图案网格与普通网格相同，但也能创建图案。更多信息请参阅 RS Wiki。"
		"奖励：x1 高级处理器"
	]
	quest.0FA1CF00DCF298C6.quest_subtitle: "制作一个模式方块。"
