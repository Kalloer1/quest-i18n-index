	quest.609FE56D52C58371.quest_subtitle: "制作一个未加工的改进处理器。"
	quest.60A7C9814C94164D.quest_desc: [
		"用于在 Cooking for Blockheads 的多方块厨房中储存配方所需的果实。"
		"奖励：x3 苹果"
	]
	quest.60A7C9814C94164D.quest_subtitle: "制作一个水果篮。"
	quest.60AAE887C99C2238.quest_desc: [
		"神秘末影仆从是一种特殊的末影仆从。驯服它需要使用苹果。神秘末影仆从与普通末影仆从的区别在于，它会发射火球而不是用剑，并且可以交易物品。"
		"奖励：x1 战利品包裹碎片"
	]
	quest.60AAE887C99C2238.quest_subtitle: "击杀一个神秘末影仆从。"
	quest.60AD2CEEDA1A8256.quest_desc: [
		"装饰性地毯……"
		"奖励：x1 mogmoss 地毯"
	]
	quest.60AD2CEEDA1A8256.quest_subtitle: "合成一块莫格苔藓地毯。"
	quest.60B013BB3D96E5E7.quest_desc: ["具体功效请查看 JEI 百科。"]
	quest.60B013BB3D96E5E7.quest_subtitle: "酿造克拉克葡萄酒。"
