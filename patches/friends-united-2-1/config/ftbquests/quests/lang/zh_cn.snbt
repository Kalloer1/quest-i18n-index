	quest.60393FA54053DCD8.quest_subtitle: "获得一个鸵鸟羽毛梳子。"
	quest.6044BAC4597533FE.quest_desc: ["地牢有4个地下楼层，最后一层是宝藏室。要到达宝藏室并不容易……你需要找到穿过小隧道的方法，因为地牢是侏儒为侏儒建造的。里面还有一些陷阱和秘密，请务必做好准备。"]
	quest.6044BAC4597533FE.quest_subtitle: "解锁侏儒国王巢穴。"
	quest.6047076621BC666C.quest_desc: [
		"放置在可以下雪的地方时，会变为积雪状态的方块。"
		"奖励：x1 雪景球"
	]
	quest.6047076621BC666C.quest_subtitle: "制作一个雪景球。"
	quest.605807838CE155F5.quest_desc: [
		"这用于制作马赛克瓷砖。"
		""
