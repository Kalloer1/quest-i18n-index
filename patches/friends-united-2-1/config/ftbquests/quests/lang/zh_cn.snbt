	]
	quest.605807838CE155F5.quest_subtitle: "制作一个 Tessellation 工作台。"
	quest.605BBBBD290F3350.quest_desc: [
		"存储磁盘是一种用于存储存储网络中物品的物品。必须将其放入磁盘驱动器中。存储磁盘在掉落时不会消失。更多信息请参阅 RS Wiki。"
		"奖励：x2 石英富集铁"
	]
	quest.605BBBBD290F3350.quest_subtitle: "制作一个4k存储磁盘。"
	quest.606CDC3A43763460.quest_desc: [
		"&4本部分任务的描述借鉴自：https://minecraftstorage.com/mods/toms-simple-storage"
		""
		"请访问此网站或继续在线搜索，以获取更多关于此模组的详细信息。&r"
	]
	quest.606CDC3A43763460.quest_subtitle: "Tom's Simple Storage"
	quest.607942F3DFF9B638.quest_desc: [
		"肥美的蜗牛能提供更高的饱食度，并恢复更多的饥饿值。"
		""
		"更多详情请参考《客栈主人实用手册》。"
	]
	quest.607942F3DFF9B638.quest_subtitle: "获得一只肥美的蜗牛。"
	quest.608CEF964DC52322.quest_desc: ["奖励：x1 黄水晶梳子"]
	quest.608CEF964DC52322.quest_subtitle: "获得一个黄水晶梳子。"
	quest.6092C12ECEDA397F.quest_desc: [
		"Ember Weed 是一种入侵性草类，原产于下界。它的草茎有一个有趣的特性：它们会像火焰一样烧毁任何东西。"
		""
		"Ember Weed 用于制作 Fire Resistance Ring。"
	]
	quest.6092C12ECEDA397F.quest_subtitle: "采集余烬杂草。"
	quest.609CABC3A57E7440.quest_desc: [
		"这可以为物品供电，也可以储存能量。详情请参考 Astrodux。"
		"奖励：x4 奥斯特鲁姆锭"
	]
	quest.609CABC3A57E7440.quest_subtitle: "制作一个能量增强器。"
	quest.609FE56D52C58371.quest_desc: [
		"原始改进处理器用于制作改进处理器。"
