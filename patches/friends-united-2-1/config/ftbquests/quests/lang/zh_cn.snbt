	quest.0E623421DA2E1C99.quest_subtitle: "制作一根基础能量棒。"
	quest.0E8747E1BB7502F6.quest_desc: [
		"在Bumblezone维度中右键空气，它会指向最近的Cell Maze结构。在Cell Maze结构中，偶尔会找到特殊罗盘（概率1/70，盔甲架房间内为1/20），它只会指向最近的、有蜂后居住的Throne Pillar结构。这种特殊罗盘的名字是“蜂蜜罗盘 - 王座柱！”"
		"奖励：蜂蜜桶 x1"
	]
	quest.0E8747E1BB7502F6.quest_subtitle: "制作一个蜂蜜指南针。"
	quest.0E88354991FDE8FD.quest_desc: [
		"这些可以吃，也可以用来制作下界豆棒。"
		"奖励：x1 地下豆（underbeans）"
	]
	quest.0E88354991FDE8FD.quest_subtitle: "获取下界豆。"
	quest.0E9BDBF2502A6658.quest_desc: ["毛绒玩具可在村庄的箱子里找到，玩家的毛绒玩具则在世界各地的宝箱和沉船里。这些方块本身没什么用，但试试右键它们吧。隐藏的彩蛋定能让你会心一笑 :)"]
	quest.0E9BDBF2502A6658.quest_subtitle: "收集一个海豹毛绒玩具。"
	quest.0EAC533E1A00225C.quest_desc: [
