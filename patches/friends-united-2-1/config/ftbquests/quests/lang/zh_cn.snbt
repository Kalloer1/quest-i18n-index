	]
	quest.0D37CB7F485A7242.quest_subtitle: "制作一个水槽。"
	quest.0D4BDD2CDB14EFEA.quest_desc: ["通过向其发射卡路里流来远程加热设备。更多信息请参阅《赫尔墨斯秘学》。"]
	quest.0D4BDD2CDB14EFEA.quest_subtitle: "制作一个卡路里通量发射器。"
