	]
	quest.1B9A6636687E4023.quest_subtitle: "获得一把经过铂金强化的手斧。"
	quest.1B9F5E98336250A3.quest_desc: ["将高温方块/流体放置在发电机顶部以产生能量。更多详情请参阅 Powah 手册。"]
