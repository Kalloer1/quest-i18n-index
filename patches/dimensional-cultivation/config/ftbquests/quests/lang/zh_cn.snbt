# AI 初翻，未人工校对
{
	chapter.5EC0925000000001.title: "教派与四大守护者"
	chapter.5EC0927A00000001.title: "种植试炼与可选挑战"
	chapter.5EC1A70000000101.title: "第一章 - 武术家"
	chapter.5EC1A70000000102.title: "第二章 - 武学大师"
	chapter.5EC1A70000000103.title: "第三章 - 伟大的武学大师"
	chapter.5EC1A70000000104.title: "第四章 - 武学宗师"
	chapter.5EC1A70000000105.title: "第五章 - 武学之王"
	chapter.5EC1A70000000106.title: "第六章 - 武学宗师"
	chapter.5EC1A70000000107.title: "第七章 - 武学皇帝"
	chapter.5EC1A70000000108.title: "第八章 - 武学至尊"
	chapter.5EC1A70000000109.title: "第九章 - 武学至尊"
	chapter.5EC1A7000000010A.title: "第十章 - 武神"
	chapter.5ECD100400000001.title: "生命与发现的章节与探索"
	chapter.5ECFA92400000001.title: "常见问题与帮助"
	chapter_group.5EC1A70000000001.title: "维度种植法（Dimensional Cultivation）"
	quest.016A977DBDA26048.quest_desc: [
		"收集162个主权血壳，用于制作天地血炉。使用其结构预览进行放置。"
		""
		"允许控制器和蓝图配方使用额外材料。"
	]
	quest.016A977DBDA26048.title: "主权者血液弹壳"
	quest.01A0911225DC79B6.quest_desc: [
		"按照Primordial Tribulation Forge的JEI分层预览操作。两种流体输入都在后墙：每种使用Celestial或Divine输入，分别持有64,000 mB Liquid Ki和64,000 mB Ancestral Dragon Blood。"
		""
		"在后方能量端口安装至少一个神圣能量输入口，并为Primordial Dao Heart配方提供20,000,000 FE/t。将Draconic Reactor Core保持在JEI所示的内部位置；它不需要燃料或激活。"
		""
		"请使用大型物品输入总线或更高级的总线：普通总线无法一次性容纳所有材料。"
	]
	quest.01A0911225DC79B6.title: "建造Primordial Tribulation Forge"
	quest.021217CAED75B6B3.quest_desc: [
		"在 Law Loom 中用 Liquid Ki、Ancestral Dragon Blood 和所列物品制作四个 Heavenforged Law Alloy Ingot。"
		""
		"将这些用于天命和律法分支的集会。它们与混沌经脉合金不同。"
	]
	quest.021217CAED75B6B3.title: "镌刻天堂锻造法则合金"
	quest.034381E1F9D0CE71.quest_desc: [
		"在Spirit Loom中制作Spirit Silk。用Meridian Binding Resin和红石块为其充能，可产出两条Scarlet Meridian Threads，消耗500,000 FE。"
		""
		"在单独的任务注册前，将丝绸和线都留在物品栏中。"
	]
	quest.034381E1F9D0CE71.title: "旋转绯红子午线纱线"
	quest.03D6E707341AF94E.quest_desc: [
		"使用 JEI 结构建造编码的祖先重构器。投入开采的遗骸、其他配方材料、液态 Ki 和 FE 以生产复活的遗骸。"
		""
		"需要更多外壳的原始残骸？将1个祖先残骸、16个骨头、4个死亡灵魂丝线和2桶液态元气输入此机器，可制作8个祖先残骸。每批耗时30秒，消耗180万FE。保留一个残骸以开始下一批。"
		""
		"该任务会检查控制器和处理后的输出两者。"
	]
	quest.03D6E707341AF94E.title: "祖先重构器"
	quest.04B1290095A06DAF.quest_desc: [
		"准备好净化祭坛和所需的圣水。吸血鬼指南中说明了祭坛；在JEI中查看金银花接受的瓶子等级。"
		""
		"你不需要变成吸血鬼。保留三瓶用于检测任务，然后使用配方所需的数量。"
	]
	quest.0511D062E8779737.quest_desc: [
		"使用 JEI 中所示的配方表制作 97 个 Mortum Resonance Casings。建造前请让任务检测它们。"
		""
		"制作控制器配方所需的额外外壳；建造库存和合成材料是单独的成本。"
	]
	quest.0511D062E8779737.title: "Mortum 共振外壳"
	quest.052C60E660F9D3B0.quest_desc: [
		"在 JEI 显示的大型合成网格中组装 Apotheosis Keystone。将其用于 Tenfold Apotheosis Altar。"
		""
		"在拆解任何生产线之前，请检查最终药丸的剩余材料，包括创世道。"
	]
	quest.052C60E660F9D3B0.title: "封印 Apotheosis 基石"
	quest.05EDE50E31EC7448.quest_desc: [
		"从 Farming for Blockheads 的市场购买你的第一株 Mugwort。每株 Mugwort 需要 4 个 Wildwood Fragments；这是市场交易，不是物品栏的货币商店。"
		"将多余的艾草制成艾草种子，种植在农田上以实现可持续供应。保留一些植物或种子，不要全部熔炼。"
		"完成首个任务需收集19株艾草，再将其他植物熔炼成19份艾草灰。灰烬是炼制灵魂淬炼盐的必需材料。"
	]
	quest.06E5403F52F37A26.quest_desc: [
		"根据JEI预览建造编码的Primordial Blood Refinery。在中心放置一个Multiversal Fluid Tank，上部内部保持空置。两个流体输入口位于后方，中间用玻璃块隔开。"
		"通过单独的输入口输入活血和龙脉精华，通过物品输入口输入祖先记忆印记，通过能量接口输入FE。中央储罐是一个结构方块，不是配方输入。"
		"配方需要 6,000,000 FE/t。接入两个 Celestial 能量输入，或使用 Divine 输入，并提供能维持该消耗量的线缆和发电量。"
		""
		"收集一桶祖传龙血，然后批量储存用于再生器和未来的多区块结构。"
	]
	quest.06E5403F52F37A26.title: "Primordial Blood Refinery"
	quest.080C5BB2F252992B.quest_desc: ["制作一个精英工作台，用于放置 7×7 的网格。这是用于制作绯红砧的桌子，请遵循 JEI 的完整配方和材料变体。"]
	quest.081C8BE6CC7432AE.quest_desc: [
		"使用以龙之心脏为催化剂的德拉科尼安级融合锻造。将德拉科尼姆核心、天气水晶、永恒星辰和淬炼灵魂钢板各两个放入注入器。"
		""
		"每次操作消耗 24,000,000 FE，并生成一个 Tribulation Dragonheart Core。运行四批，并保留所有四个核心用于最终药丸。"
	]
	quest.081C8BE6CC7432AE.title: "四颗苦难之心"
	quest.08AEACAB6E11E6D5.quest_desc: [
		"根据结构预览建造编码的龙之脉操纵器。处理所列的固体材料以获得大量龙之脉精华。"
		""
		"安装一个容量足够的流体输出口，并将其排入血液精炼厂的精华储罐。此部分需与活血分开。"
	]
	quest.08AEACAB6E11E6D5.title: "龙之脉络操纵器"
	quest.09C9F53C31AB6AC2.quest_desc: [
		"按照JEI的配方，用毒灵花、剧毒灵玉、精炼萤石和圣水制作金银花。"
		""
		"建造并为小奇晶提供奇晶培育器。任务会分别检查忍冬、培育器和晶体。"
	]
	quest.09F10CD4B5EAFD0B.quest_desc: [
		"Meridian Ki Reservoir 用于储存 Machine Ki，而非生成。建造 Liquid Ki Dynamo，并用 Liquefier 向其输送 Liquid Ki 以产生第一批供应。"
		""
		"通过水晶接口将发电机、水库和消耗器连接到可访问的频道。在启动锻造炉前，请确认水库的Ki条已充满。机器Ki与FE和个人Ki是分开的。"
	]
	quest.0A98969399E6180C.quest_desc: [
		"在 Clibano 中使用普通火焰和 Artisan Relic，将 Eternal Ember 与 Spirit Silk 结合成 Forgeheart Core。"
		""
		"然后使用矩阵配方中的灵魂之火条件和绯红经线。在消耗前检测这两种产物；第五章锻造台提供了后续的批量生产路线。"
	]
	quest.0A98969399E6180C.title: "完成绯红锻造台矩阵"
	quest.0D13CE5447DEB030.quest_desc: [
		"在JEI的指定合成台里，用Mortum材料和高级合金组装Mortum Evolved Core。"
		""
		"在合金器中使用它来制作虚空淬炼丹田。它与觉醒的合成丹田核心是不同的组件。"
	]
	quest.0D13CE5447DEB030.title: "Mortum Evolved Core"
	quest.0D2B13331B33C900.quest_desc: [
		"使用 Forbidden 和 Arcanus 指南建造完整的 Clibano 多方块结构，并安装 Artisan Relic。"
		""
		"检查每个配方所需的火焰类型：永恒余烬和绯红砧矩阵需要灵魂火焰；锻造之心核心使用普通火焰。"
	]
	quest.0D67A3D7AA133B44.quest_desc: [
		"在轮回轮中运行十二批因果线。每批生成八条线，消耗相应物品及16000mB液态元气。"
		""
		"96线程任务是初始储备；继续生产以制造后续组件。"
	]
	quest.0D67A3D7AA133B44.title: "旋转因果之线 (Spin Causality Threads)"
	quest.0EBB3187FD474E41.quest_desc: ["通过永恒星光（Eternal Starlight）的资源进度获取星光钻石（Starlit Diamonds）。为星界子午锭（Astral Meridian Ingots）和装备留一些。"]
	quest.0ECE7A960A742CF1.quest_desc: [
		"制作一把灵魂染钢镰，用它收割 Malum's Spirit Altar 配方所需的灵魂。"
		""
		"收集不同种类的 Arcane、Sacred、Aerial、Aqueous 和 Eldritch 灵魂。在 JEI 中查看对应生物的掉落；普通生物掉落和 XP 无法替代灵魂。"
	]
	quest.1201438C7596BA7D.quest_desc: [
		"在 Powah's Orb 中为 Ender IO 的 End Steel 充能。每个 Charged End Steel Ingot 需要 750,000 FE。"
		""
		"在 Spirit Steel plate 配方中使用 charged ingots，并在更改 Orb 配方前移除成品批次。"
	]
	quest.12A5A1DCE5DA1F2A.quest_desc: [
		"使用JEI的配方将永恒星光Boss材料合成星铸Boss精华。"
		""
		"在消耗武器物品前完成武器收集任务，并保留想使用的武器的备用件。"
	]
	quest.13AA4F4C5ED5FFB2.quest_desc: [
		"使用 Draconic Fusion Crafting 和 JEI 的催化剂、注射器材料以及注射器等级来制作混沌经线合金。"
		""
		"收集八个锭来完成此任务，并为前方的结构和组件多做一些备用。"
	]
	quest.13AA4F4C5ED5FFB2.title: "锻造混沌经线合金"
	quest.14DCE886B290462B.quest_desc: [
		"合成编码的天劫熔炉控制器，并组装其完整的JEI结构。它将唤醒你闲置的备用核心。"
		""
		"检查能量舱容量和配方消耗，并保持灵脉精华的供应。"
	]
	quest.14DCE886B290462B.title: "天劫熔炉"
	quest.1543862BD2DC4BBB.quest_desc: [
		"为锇压缩机提供FE、锇输入和要处理的物品。用它来制作用于灵魂炼金术的精致萤石。"
		""
		"如果配方卡住，请检查锇储罐、输入槽和侧面配置中是否有残留或不兼容的内容。"
	]
	quest.171D4EEF9427CD49.quest_desc: [
		"在织布机中进行十次法律碎片操作。每次可获得一个十重法律碎片，并消耗相应物品及8000mB液态元气。"
		""
		"收集十个相同的碎片；不需要十种不同的类型。"
	]
	quest.171D4EEF9427CD49.title: "镌刻十诫普世法则"
	quest.172692C9689122D0.quest_desc: ["在 Iceika 的宝箱中找到 Poison Spirit Bloom。留着和 Venom-Charged Spirit Jade、Refined Glowstone 和 Holy Water 一起做 Honeysuckle 配方。"]
	quest.18142BABE42E9BFF.quest_desc: [
		"用冰和火建造火焰、冰雪和闪电锻造炉。每个都需要对应元素的活龙向其输入端吐息。"
		""
		"在JEI中使用Draconic Evolution的三种元素配方，用Dragon Hearts制作Infernal、Glacial和Tempest Dragonheart Ingot。这将为你后续的Regenerator路线提供启动资金。"
	]
	quest.18142BABE42E9BFF.title: "龙之熔炉三件套"
	quest.1AF296DC8337C41F.quest_desc: [
		"Ki Infuser 可制作含 Ki 的金属。加入配方物品，连接可用的 Machine Ki 供应，并确认其 Ki 条和进度会增加。"
		""
		"这是单块的 Ki Infuser，不是多块的 Scarlet Meridian Forge。"
	]
	quest.1AF5985A23D8FF52.quest_desc: ["在终极工作台组装神圣身体胚胎。将其保留以便在永生身体熔炉中处理。"]
	quest.1AF5985A23D8FF52.title: "组装神圣身躯胚胎"
	quest.1BE6329C7A9A0C27.title: "Primordial Regenerator"
	quest.1D4B22295D89CB3D.quest_desc: [
		"击败 Densos 和 Reyvor。每个都有独立的击杀任务。"
		""
		"收集掉落物以获取Mortum组件，并为即将到来的战斗做好防御准备。"
	]
	quest.1D4B22295D89CB3D.title: "击败双生君主"
	quest.22D4A82A0BEED0DA.quest_desc: [
		"在深度学习者中携带数据模型，同时击杀其对应的生物，直到模型准备好进行模拟。将其和预测矩阵放入一个已充能的模拟室中。"
		""
		"检查模型的 FE/t 需求，并为两个预测输出留出空间。维度模型可能需要比主世界模型多得多的能量。Loot Fabricator 在 Eternal Embers 之后。"
	]
	quest.22D4A82A0BEED0DA.title: "模拟真实世界生态系统模组"
	quest.251C2CC2EA84E6B0.quest_desc: [
		"在血之熔炉中，使用所列组件制作天地血核，包括复制的祖先基因组和32,000 mB的祖先龙血。"
		""
		"为药丸预留核心，并补充你的血液储备。"
	]
	quest.251C2CC2EA84E6B0.title: "凝聚天地血核 (Condense the Heaven-Earth Blood Core)"
	quest.256B36315567A568.quest_desc: ["用紫吹雪、灵魂火石和火药合成一个休眠余烬。在克里巴诺用灵魂火和工匠遗物唤醒它。"]
	quest.257AE7DE38CDCC5D.quest_desc: [
		"使用JEI预览建造六道轮回轮。其两个流体输入和两个能量输入位于后墙，流体输入之间是经络玻璃。至少安装一个神圣能量输入口，为消耗高达16,000,000 FE/t的配方供能。"
		""
		"使用两个真空流体输入口：Immortal Meridian Bones需要32,000 mB Liquid Ki和16,000 mB Ancestral Dragon Blood，分储于不同储罐。Causality Threads仅使用Liquid Ki。"
	]
	quest.257AE7DE38CDCC5D.title: "升起六道轮回之轮 (Raise the Six Paths Samsara Wheel)"
	quest.27008F05812BC629.quest_desc: [
		"在 Fivefold Soul Refinery 中，用其他列出的输入物处理 Unrefined Spirit Prisms。每批产出两个 Purified Spirits，所以需要四批才能凑齐本任务所需的八个。"
		""
		"在整个配方过程中维持FE和流体供应，并保持输出总线畅通。"
	]
	quest.27A0D0775AE22BA4.quest_desc: [
		"如JEI所示，建造一个内部含有一个Multiversal Fluid Tank的Primordial Regenerator。后墙在两个能量输入之间有一个流体输入。最多可输入32,000 mB Ancestral Dragon Blood，请使用Vacuum流体输入或更大的输入，并使用至少一个Divine Energy Input Hatch，用于消耗高达10,000,000 FE/t的配方。"
		""
		"配方包含 dragonheart 材料和 Awakened Dragon Marrow。在加入自动化前，请先逐一测试配方。"
	]
	quest.27A0D0775AE22BA4.title: "Primordial Regenerator"
	quest.27A15CAEE748CFC5.quest_desc: [
		"进入 Mortum，这个进阶系列的最后一个 DivineRPG 领域。收集碎片和宝石，为 Densos 和 Reyvor 做好准备。"
		""
		"探索前请先建立安全返回点，并在挑战任何首领前，用普通敌人测试你的防御。"
	]
	quest.27A15CAEE748CFC5.title: "进入莫塔姆（Mortum）"
	quest.28588DAC5FB28ABA.quest_desc: [
		"收集118个Primordial Tribulation Casings用于锻造炉结构。使用分层的JEI预览进行放置。"
		""
		"制作控制器、后续配方和 Apotheosis 祭坛的额外外壳。"
	]
	quest.28588DAC5FB28ABA.title: "Primordial Tribulation Casings"
	quest.2B74FE3CFCDEF7DD.quest_desc: [
		"在轮回轮中运行二十四批不朽经脉骨。每批产出四块骨头，消耗16,000 mB祖传龙血和32,000 mB液态元气。"
		""
		"保持两种流体分离，并确保有充足的储备量。"
	]
	quest.2B74FE3CFCDEF7DD.title: "重建不朽的经络骨骼"
	quest.2E9C5E1C7FE4DE20.quest_desc: [
		"使用蜂巢块周围的三种领域预测来制作梅里迪亚恩绑定树脂。每次制作可获得三种树脂，三次制作即可满足此任务所需的九种树脂。"
		""
		"保持模拟运行，因为多台机器和组件都使用这种粘合剂。"
	]
	quest.2EF46B7008DE02C3.quest_desc: ["使用JEI中显示的配方制作钢制外壳。多个模组配方都需要它们，包括原子重构器和AE2机器，所以请留一些备用。"]
	quest.3014558A26F0EF42.quest_desc: [
		"可选的第四章批量处理升级。先通过 Clibano 制作 Eternal Embers、Forgeheart Cores 和 Scarlet Anvil Matrix，然后在 Elite Crafting Table 中制作 Fivefold Soul Casings 和控制器。"
		""
		"使用天地元气凝聚器提供液态元气。提供所选配方的材料和FE，并导出其产品。熔炉无法自行制造初始建造组件。"
		""
		"根据控制器的JEI预览进行建造。保持两个能量输入、物品输入/输出总线以及液体Ki输入口可供自动化访问。"
	]
	quest.3014558A26F0EF42.title: "绯红子午线锻造炉"
	quest.312FDA0EF5E13BDC.quest_desc: [
		"收集任务中显示的五个永恒星光武器。查看它们的配方和战利品页面，规划所需的遭遇。"
		""
		"破碎之剑：在永恒星光中击败携带此剑的孤星骷髅。被玩家击杀后，其装备掉落的基础概率为20%；抢夺每提升一级可增加1个百分点（抢夺III时为23%）。掉落的剑可能已受损，但其剑刃可被修复。守门人不会掉落此剑。请在JEI中查看其实体掉落页面。"
		""
		"让每个任务在 Starforged Boss Essence 中使用武器前都先检测武器。想保留的武器可以制作备用件。"
	]
	quest.3552EA4ED63547B1.quest_desc: [
		"放置 Draconic Evolution 的融合锻造核心和配方所需等级的融合锻造注射器。为注射器提供能量。"
		""
		"将催化剂放入核心，并将周围的材料放在注射器上，如JEI所示。Extended Crafting中同名的Crafting Core是不同的系统。"
	]
	quest.3658EF26BF9270FE.quest_desc: [
		"建造 Age-er 并制作灰色衰老催化剂。右键打开，将草药和催化剂放入对应槽位，并用液态 Ki 填充其储罐。JEI 会显示各催化剂等级的成本和所需时间。"
		""
		"Time in a Bottle 在本整合包中有一个 Wildwood 锁定的配方。请在 JEI 中查看其组件。"
	]
	quest.3711E4AF05675221.quest_desc: [
		"返回阿帕拉契亚，击败永恒弓箭手以获取不朽之肉。完成击杀和物品收集两项任务。"
		""
		"保留多余的肉块用于重建和觉醒的龙之骨髓。"
	]
	quest.3711E4AF05675221.title: "不朽之肉 Immortal Flesh"
	quest.372D343A29611C71.quest_desc: [
		"在 7×7 精英工作台制作五重灵魂外壳。每批产 32 个，任务需要 98 个，控制器还需要更多外壳。"
		""
		"使用精炼炉的结构预览获取完整建造清单，并保留备用外壳。"
	]
	quest.3860D9A452D3B0CF.quest_desc: [
		"收集Mortum碎片，合成Mortum宝石，用于制作共振外壳和进化核心。"
		""
		"训练好的Mortum数据模型可提供可再生碎片：用能量和矩阵运行模拟，然后从成功预测中制造所需的掉落物。"
	]
	quest.3860D9A452D3B0CF.title: "死亡领域的纷争"
	quest.38AC3D90523A8416.quest_desc: [
		"使用 Wyvern-tier Fusion Crafting Injectors，并以 Adamant Ki Alloy 为催化剂，加入所列的 Twilight 材料。"
		""
		"24,000,000 FE 操作可制作四个暮光之魂锭。它们将加入你大型组件中的星界经度分支。"
	]
	quest.38AC3D90523A8416.title: "绑定暮色经线（Twilight Meridians）"
	quest.39068ED81F53990B.quest_desc: [
		"用来自Aether的Skyroot Water Bucket制作Farmer's Delight的Cooking Pot，然后将其置于热源上。"
		""
		"Its Spirit Ginseng Root 配方能为你提供第一颗突破丹。"
	]
	quest.3AC9B68E1E94AB01.quest_desc: [
		"收集86个九重天法织外壳，用于九重天法织机。请遵循JEI结构页面的指引，获取玻璃、内部方块和端口。"
		""
		"所有配方完成后，你可以在最终祭坛中重复使用部分外壳。拆解前请清空物品栏和储罐。"
	]
	quest.3AC9B68E1E94AB01.title: "法律编织的容器"
	quest.3B7C2402B10582CA.quest_desc: [
		"运行与主世界、下界和末地相关的模型以收集其领域预测。这些是基础模拟输出，与特定生物的成功预测无关。"
		""
		"收集所需数量的 Meridian Binding Resin；这些产出无需 Loot Fabricator。"
	]
	quest.3D6E01753B5475A9.quest_desc: [
		"运行祖先重构器的记忆印记配方。一批可产出四个印记，消耗8000mB液态元气及其物品输入。"
		""
		"保留此行为血液精炼和后续祖先配方所用。"
	]
	quest.3D6E01753B5475A9.title: "找回四份祖先的记忆印记"
	quest.3E5F8835182EF490.quest_desc: [
		"右键点击破碎子午线中的这幅画，定位50格内的龙之脉。跟随末地棒粒子，收集龙之脉石。"
		""
		"这是一个手持定位物品，并非从技巧菜单中部署的作战阵型之一。"
	]
	quest.3E5F8835182EF490.title: "龙之脉络形成术 Art"
	quest.3EC54D95AEECAAD1.quest_desc: [
		"在 Tribulation Forge 中使用已完成组件、各 64,000 mB 的 Liquid Ki 和 Ancestral Dragon Blood 来制作 Primordial Dao Heart。"
		""
		"收集心脏，并为最后的祭坛预留起来。"
	]
	quest.3EC54D95AEECAAD1.title: "凝聚原始道心 (Primordial Dao Heart)"
	quest.3F95C77E8BC5F16A.quest_desc: [
		"在破碎子午线中寻找祖先遗骸矿石和石化活血。JEI会显示它们的矿石高度。"
		""
		"用钻石级或更高级的丝绸之触镐收集16个矿石块。没有丝绸之触，祖传遗迹矿石会掉落遗迹而非方块；时运可增加产量。祖传重构器可以用你的首个样本培育出更多遗迹。"
		""
		"用钻石级或以上镐收集8个Petrified Living Blood方块；无需Silk Touch。预留方块用于流体提取。"
	]
	quest.3F95C77E8BC5F16A.title: "祖先的沉积层"
	quest.3FB38D36270EF8F3.quest_desc: [
		"使用净化灵魂、天界合金块和其他JEI配方材料，在7×7精英工作台里制作终极工作台。"
		""
		"其9×9的网格用于机械丹田和后续的大型组件。"
	]
	quest.41AEBA7EFCBB962C.quest_desc: [
		"在AE2刻印器中，将未精炼的灵体棱镜置于阴影锭和充能末地钢之上。收集十三块淬炼灵体钢板用于较大的合成配方。"
		""
		"这里用未精炼的棱镜，而不是第五章的净化之魂。"
	]
	quest.41B9CB84B0334C0B.quest_desc: [
		"遵循 Heaven-Earth Blood Crucible 的 JEI 结构。将 Draconic Reactor Core 留在内部，并使用两个 Multiversal Fluid Tanks。后墙有一个能量输入和一个流体输入；侧面端口用于物品。内部储罐是结构方块，不是配方输入口。"
		""
		"使用 Divine Energy Input Hatch 可获得高达 14,000,000 FE/t 的能量，使用 Celestial 或 Divine Fluid Input Hatch 可获得高达 64,000 mB 的 Ancestral Dragon Blood。该机器无需燃料或激活。"
	]
	quest.41B9CB84B0334C0B.title: "升起天地血之熔炉 (Raise the Heaven-Earth Blood Crucible)"
	quest.450005CE3D4701F0.quest_desc: [
		"使用 Malum Spirit Infusion：精制灵魂石为核心物品，辅以灵魂淬炼盐、子午线粘合树脂、紫水晶以及 JEI 中列出的灵魂。"
		""
		"你的第一个棱镜必须使用此祭坛路线。第5章的五重灵魂精炼器在建成后可提供批量生产和净化灵魂。"
	]
	quest.450005CE3D4701F0.title: "绑定一个未精炼的棱镜之魂"
	quest.4889B1D8AE77F4FF.quest_desc: [
		"在 JEI 所示的表格中，使用精炼的祖先和龙心材料来制作 Dragon Vein Prism。"
		""
		"为觉醒的龙之骨髓生产保留额外的棱镜。"
	]
	quest.4889B1D8AE77F4FF.title: "聚焦于龙之脉络棱镜"
	quest.4889BE9807F3CCBF.quest_desc: [
		"在主世界将时间设为1400，准备一个冷冻时钟。在伊甸，将伊甸之心投入神圣火焰，然后用该时钟作用于转化后的火焰，以开启野木裂隙。"
		""
		"抵达后放置并激活一块 Waystone。永久传送门需使用至少十个 Wildwood Block 构成下界传送门形状的框架，并在底部用相同的时钟激活。"
		""
		"&c野木敌人拥有5倍的生命值和伤害。&r做好准备，然后找到一个Termasect巢穴，击败其首领以获得野木之心。"
	]
	quest.4889BE9807F3CCBF.title: "开启野木裂隙 (Opening the Wildwood Rift)"
	quest.4F830DDE828F3C68.title: "天地经脉封印"
	quest.50C3151F1E6326FC.quest_desc: [
		"在 Oritech 加速器中运行自定义的 Primordial Godspark 碰撞配方，并在粒子收集器中收集产物。"
		""
		"收集四十个，再分给法律和身体分支。若生产停滞，检查环形结构、电机功率和收集器空间。"
	]
	quest.50C3151F1E6326FC.title: "与四十个神火花发生碰撞"
	quest.52AA1773856D2195.quest_desc: [
		"将晶体接口连接到你的发电机、存储器和消耗器上，然后在每个设备上选择相同的频道。你必须拥有该频道或使用权限，且接口必须在相应等级的范围内。"
		""
		"接口传输Ki但不储存。发电机提供，水库或Ki宝库缓冲。任何机器侧都可以接受接口。"
	]
	quest.53ECB922C67FF771.quest_desc: [
		"使用整合包的传送门路线进入暮色森林。带上食物、地图和返回方法。"
		""
		"遵循维度的进度来推进首领。受保护区域和环境惩罚可能意味着仍需击败较早的首领。"
	]
	quest.551AAE0CDCB2459F.quest_desc: [
		"根据JEI结构页面建造Tenfold Apotheosis祭坛。后墙中间有两个流体输入口和一个神圣能量输入口。物品输入和输出仍在两侧。"
		"向神圣流体输入口注入 128,000 mB 液态气，向另一个天界或神圣流体输入口注入 64,000 mB 祖传龙血。两个天界输入口不够：液态气需要自己独立的 128 桶储罐。"
		""
		"将电源连接到后方的神圣能量输入舱。最终配方消耗 24,000,000 FE/t，持续 6,000 次游戏循环；你的发电机或储能装置及线缆必须能维持该速率。"
	]
	quest.551AAE0CDCB2459F.title: "建造十重神化祭坛"
	quest.592F4E7835758D57.quest_desc: ["使用JEI中显示的BOSS奖杯和材料来制作暮光主权徽章。将完成的徽章用于子午线组装。"]
	quest.5975D8CF33CDEB58.quest_desc: [
		"使用Ki Forge将蕴含Ki的金属组合成更坚固的合金。按照JEI的配方链制作Celestial Ki Alloy，同时保留低阶金属。"
		""
		"通过接口网络为供应机提供能量，并确保输出畅通。已连接的通道需要在其后方连接发电机或已充能的存储装置。"
	]
	quest.5BACB8AE62822C1A.quest_desc: [
		"请保留一份实体版《灵集咒语手册》以获取灵织机的配方。学习该方法并不会提供配方所需的物品。"
		""
		"如果你想学习它，就再拿一个副本吧。"
	]
	quest.5E9FBB02B697730E.quest_desc: ["在JEI显示的大桌子上组装君主血印。为血之熔炉的进阶预留它。"]
	quest.5E9FBB02B697730E.title: "写下主权者血印符文"
	quest.5EC0925000000101.quest_desc: [
		"在失落的城市中找到正教或邪教的 Azure Cloud Academy 或 Crimson Eclipse Academy。在那里使用探险家指南针，并按名称选择学院。"
		""
		"Azure Cloud 有浅色石头、灰色屋顶和樱花花园。Crimson Eclipse 有深色屋顶和深红木材。沿着主庭院走到后面的教学大厅，就能找到祭坛和大师。"
		""
		"在祭坛上选择你的道路，并与你的教派大师交谈。两条道路都提供相同的守护者进阶，始于武学至尊。"
	]
	quest.5EC0925000000101.title: "寻找你的教派学院"
	quest.5EC0925000000102.quest_desc: [
		"在 Martial Supreme，与你的门派大师交谈并接受 Jadeflame 狩猎，再开始战斗。此任务的勾选标记仅为指南。"
		""
		"制作并使用破碎的经线封印，然后用探险家指南针在该维度找到玉焰泉。在生存模式下靠近会唤醒其麒麟；和平模式则会阻止其生成。"
		""
		"要获得狩猎积分，请按照合作狩猎指南中的说明，提供栽培伤害或联盟阵型支援。"
	]
	quest.5EC0925000000102.title: "接受玉焰契约 (Jadeflame Covenant)"
	quest.5EC0925000000103.quest_desc: [
		"击败守护Jadeflame Spring的Qilin。使用栽培技巧，普通攻击无效。它的护盾会阻止飞行、骑乘和战斗中的逃脱传送。"
		""
		"合格的猎人会收到一个专属的Jadeflame Heart。请空出一个背包栏位，否则将延迟送达。普通召唤的Qilin不计入主人的狩猎任务。"
		""
		"守卫的死亡还会解封25桶Primordial Jade Essence。带上水桶或水泵来收集这有限的资源。"
	]
	quest.5EC0925000000103.title: "击败守护者（Guardian）"
	quest.5EC0925000000104.quest_desc: [
		"获得狩猎积分后，将玉焰之心交还给你的派系首领。首次完成可获得四个天兽印记和500经验。提交前请腾出背包空间。"
		""
		"这将解锁凤凰契约。多余的心可以兑换为四份替换印记，无需重复任务经验。"
		""
		"保留用于 Cinder Heaven Seal 和 Four Guardians Seal 的样本。复制印记并不能完成守护者契约。"
		"{@pagebreak}"
		"&6复制守卫印记&r"
		""
		"将一枚印记放入已激活的鉴定舱的样本槽，将一枚记忆芯片放入芯片槽。等待扫描完成100%后，将芯片移至芯片存储，并向复制终端请求副本。"
		""
		"每个 Celestial Beast Imprint 需要 4,096 量子、8,192 生命和 4,096 珍贵物质：总计 16,384。后续的守卫印记使用相同的扫描方法，但成本不同。"
		""
		"使用记忆芯片进行扫描，而不是空白物质蓝图。妥善保管其余原始样本。"
	]
	quest.5EC0925000000104.title: "接收野兽印记（Beast Imprints）"
	quest.5EC0925000000105.quest_desc: [
		"麒麟守卫死后，其封印盆地会变为25桶源质源。用桶或泵收集；封印的源质在战斗前无法提取。"
		""
		"水池不会重新填满。保存一个种子桶用于可选的溶解室更新配方，然后用你的封印返回。"
	]
	quest.5EC0925000000105.title: "采集翡翠之泉"
	quest.5EC0925000000106.quest_desc: [
		"在 Rotary Condensentrator 中以 1:1 的比例将 Primordial Jade Essence 转化为蒸汽。向 Antiprotonic Nucleosynthesizer 输入 1,000 mB 蒸汽和一个固体 Antimatter Pellet，以制造 16 个 Primordial Matter Crystals。"
		""
		"将量子、珍贵、生命、末地和金属物质分解。可选的原始物质：你的复制农场任务会说明更新循环、时间和存储要求。"
	]
	quest.5EC0925000000106.title: "凝聚原始物质 (Condense Primordial Matter)"
	quest.5EC0926000000110.quest_desc: [
		"完成麒麟契约并达到武学至尊。打开门派主事的凤凰标签，在战斗前点击接受狩猎。"
		""
		"制作 Cinder Heaven Seal 并在 Cinder Heaven 找到 Cinderwing Aerie。生存模式玩家靠近会唤醒守卫者；和平模式可防止其生成。"
		""
		"准备可用的栽培攻击和Ki恢复。标记此任务完成并不代表接受主人的契约。"
	]
	quest.5EC0926000000110.title: "接受灰烬翼凤凰的狩猎任务"
	quest.5EC0926000000111.quest_desc: [
		"避开凤凰的发光冲刺路线，并在它着陆恢复时攻击。躲避火焰扇和标记的余烬圆圈。"
		""
		"生命值低于45%时可重生一次，恢复最大生命值的18%。从扩张的圆环中撤退。"
		""
		"击败一只带有有效契约和合格参与的真正Aerie守护者，即可获得你的个人Phoenix Heartfeather。若背包已满，物品将等待有空位时送达。"
	]
	quest.5EC0926000000111.title: "狩猎：灰烬翼凤凰"
	quest.5EC0926000000112.quest_desc: [
		"获得狩猎积分后，将凤凰心羽归还给自己的派系首领。首次完成可获得四个凤凰道印和650经验，解锁武尊处的龙之契约。"
		""
		"按照“接收野兽印记”的描述，用记忆芯片扫描印记。每份副本需要8,192量子、生命和珍贵物质：总计24,576。"
		""
		"为四守护者封印和蔚蓝广袤封印各预留一个印记。多余的奖杯可兑换替换印记，不重复任务经验。"
	]
	quest.5EC0926000000112.title: "调和凤凰道印记 (Attune the Phoenix Dao Imprint)"
	quest.5EC0926000000120.quest_desc: [
		"提交凤凰契约并达到武宗境界。打开你门派主的龙标签页，然后点击接受狩猎。"
		""
		"制作蔚蓝疆域印章，进入其领域并找到潮汐龙之庭。接近守护者前，准备好远程栽培攻击和Ki恢复。"
	]
	quest.5EC0926000000120.title: "接受潮汐蔚蓝巨龙狩猎任务"
	quest.5EC0926000000121.quest_desc: [
		"巨龙会远程攻击。躲避它的潮汐咆哮，并避开三道水枪的标记路径。五个间歇泉会锁定你之前位置周围的固定圆形区域；在它们喷发前离开。"
		""
		"实心方块能挡住这些法术。利用干燥的竞技场地面保持移动，并在警告间隙施放法术。"
		""
		"完成一次狩猎并成功参与击杀真正的宫廷守卫，即可获得你的个人潮汐龙珠。"
	]
	quest.5EC0926000000121.title: "狩猎：潮汐蔚蓝巨龙"
	quest.5EC0926000000122.quest_desc: [
		"获得狩猎积分后，将潮汐龙珠归还给自己的派系首领。首次完成可获得四个潮汐道印和800经验，并解锁玄武的契约。"
		""
		"复制一个扫描印记需要 8,192 量子、生命、珍贵和末影物质：总计 32,768。"
		""
		"保留黑石之域封印和四守护者封印的印记。额外的奖杯可提供替换印记，而不会重复任务经验值。"
	]
	quest.5EC0926000000122.title: "调谐潮汐道印记 (Attune the Tidal Dao Imprint)"
	quest.5EC0926000000130.quest_desc: [
		"在 Martial Sovereign 提交 Dragon covenant。打开你的 sect master 的 Xuanwu 标签页，然后点击 Accept hunt。"
		""
		"合成黑石之封，在其领域中寻找黑石圣所。玄武守护着最终要素：稳定。靠近前准备好攻击和治愈。"
	]
	quest.5EC0926000000130.title: "接受黑石玄武狩猎任务"
	quest.5EC0926000000131.quest_desc: [
		"玄武的吞噬漩涡会从18格外吸人。在11格的爆炸前会释放你一秒：跑到发光边界外或寻找坚固掩体。爆炸不会破坏地形。"
		""
		"低空跳跃躲避冲击波，避开咬击和贝壳突进。冲刺恢复会在护甲前提供30%的伤害窗口；缩壳防御则会将所受伤害降至25%。"
		""
		"完成一次狩猎并成功参与击杀真正的庇护所守护者，即可获得个人玄武壳碎片。"
	]
	quest.5EC0926000000131.title: "狩猎：黑石玄武 (Blackstone Xuanwu)"
	quest.5EC0926000000132.quest_desc: [
		"获得狩猎积分后，将玄武壳碎片归还给本派掌门。首次完成可获得四个玄武道印记和950经验，并完成四项誓约。"
		""
		"复制一个扫描印记需要消耗 8,192 量子、生命、珍贵、末地和金属物质，总计 40,960。"
		""
		"留一个用于四守护者封印。额外的奖杯可提供替换印记，而不会重复任务经验值。"
	]
	quest.5EC0926000000132.title: "调谐玄武道印记 (Attune the Xuanwu Dao Imprint)"
	quest.5EC0926000000140.quest_desc: [
		"将 Celestial Beast、Phoenix、Tidal 和 Xuanwu 印记以任意顺序排列在普通合成网格中。它们将共同组成一个 Four Guardians Seal。"
		""
		"在终极9×9表格的创世道蓝图中心使用封印。该封印无法扫描，需复制其四个组件的印记。"
	]
	quest.5EC0926000000140.title: "团结四大守护者"
	quest.5EC0926000000150.quest_desc: [
		"碎裂将天体经度分为四象：麒麟之生、凤凰之新、龙之流与玄武之定。通过你的宗主按此顺序恢复它们。"
		""
		"接受狩猎，击败守护者，然后上交实体战利品以解锁下一个契约。任务勾选或复制印记无法推进主人的使命。"
		""
		"麒麟和凤凰需要武学至尊。神龙和玄武需要武学至尊。它们的四枚印记可组合成第十章创世道蓝图所用的封印。"
		"{@pagebreak}"
		"&6旅行与狩猎规则&r"
		""
		"每个守护者都有自己的领域和可重复使用的入口封印。旅行前请接受其契约。保留封印以便返程；抵达地点在地表，但离开着陆区可能需要方块或船只。"
		""
		"只有耕种攻击会伤害守卫。它们的28格保护范围会阻止飞行、骑乘和逃跑的传送，直到守卫死亡。死亡或退出游戏会解除你的个人锁定。与朋友战斗前，请在试炼分支中阅读《合作守卫狩猎指南》。"
		""
		"已完成的圣所不会刷新守护者。如需更多奖杯，请寻找另一个未访问的圣所。奖杯无法复制或分解。在JEI中按R查看奖杯掉落页面，或按U查看大师奖励。"
	]
	quest.5EC0926000000150.title: "破碎的经线：四重誓约"
	quest.5EC0926000000151.quest_desc: [
		"接受凤凰狩猎后，使用你的灰烬天堂印章。余烬的天空覆盖着玄武岩峰和熔岩海；小心脚下，并保留印章以便返回。"
		""
		"使用探险家罗盘在此领域内寻找灰烬翼巢穴。凤凰的火焰能让子午线重焕新生。"
	]
	quest.5EC0926000000151.title: "进入灰烬天堂 (Cinder Heaven)"
	quest.5EC0926000000152.quest_desc: [
		"提交凤凰奖杯并接受巨龙狩猎后，使用你的蔚蓝疆域印章。"
		""
		"带上船只和建筑材料，用于岛屿间的海域。在此维度用探险家指南针找到潮汐龙之庭，其竞技场有干燥的战斗地面。巨龙会恢复子午线的流动。"
	]
	quest.5EC0926000000152.title: "进入蔚蓝的广袤之地"
	quest.5EC0926000000153.quest_desc: [
		"接受玄武的狩猎后，使用你的黑石之渊印章。为黑暗水域和苔藓深板岩高地带去光明。"
		""
		"用探险家指南针在这个维度里找到一个黑石圣所。玄武提供了维系其他三个方面所需的稳定性。"
	]
	quest.5EC0926000000153.title: "进入黑石群岛 (Blackstone Reaches)"
	quest.5EC0926000000160.quest_desc: [
		"麒麟契约后，在精英7×7工作台制作灰烬天堂印。需要天界兽印记、地狱龙心锭、火焰精华、至高元晶、虚空曼陀罗和龙脉棱镜。"
		""
		"在使用封印前，先接受凤凰的狩猎。该封印可重复使用：用它进入灰烬天堂，再在内部使用以返回。JEI会显示完整配方。"
	]
	quest.5EC0926000000160.title: "合成 Cinder Heaven 封印"
	quest.5EC0926000000161.quest_desc: [
		"在第十章早期，用终极9×9工作台制作蔚蓝疆域印章。材料包括凤凰道印、冰川龙心锭、霜之精华、天界元气合金、主权法令和混沌经脉合金。"
		""
		"旅行前完成凤凰契约并在武尊处接受巨龙狩猎。该封印可重复使用，不消耗你的灰烬天堂封印。"
	]
	quest.5EC0926000000161.title: "合成蔚蓝疆域印章"
	quest.5EC0926000000162.quest_desc: [
		"在研发第10章的法与骨线路后，于终极9×9工作台合成黑石触及封印。所需材料为潮汐道印、焦灼经脉石、天铸法合金、主权法令、因果丝与不朽经脉骨。"
		""
		"提交龙之奖杯并接受玄武的狩猎，然后再旅行。可重复使用的封印不需要玄武奖杯或创世道。"
	]
	quest.5EC0926000000162.title: "合成黑石触须印章 (Blackstone Reaches Seal)"
	quest.5EC0926A00000101.quest_desc: [
		"从被击败的麒麟之泉中收集一个种子桶。在工业前驱溶解室中，将1000mB的原始玉精华与一个阴阳突破催化剂结合。"
		""
		"升级前 30 秒（600 次游戏循环）后，你将获得 2000 mB 精华和一个紫水晶碎片。催化剂将被消耗。请保持物品输出畅通。"
		""
		"将1000 mB从输出返回输入，其余1000 mB存入存储。使用缓冲区以保持循环的种子供应。继续提供催化剂和FE；此配方无法生产首个样本。"
	]
	quest.5EC0926A00000101.title: "更新远古之泉 (Renew the Primordial Spring)"
	quest.5EC0926A00000102.quest_desc: [
		"可选的高产量子、珍贵、生命、末影和金属物质农场。其他物质类型的农场请放在列表之外。"
		""
		"用溶解室循环更新翡翠精华。在减压浓缩模式下，用旋转浓缩器以1:1的比例将其制成原始翡翠蒸汽。"
		""
		"向反质子核合成器输入1000mB蒸汽和一个固体反物质颗粒。一批需要800个游戏刻——升级前为40秒——可产出16个原始物质晶体。蒸汽量指每批所需，而非每刻所需。"
		"{@pagebreak}"
		"&6将水晶转化为物质&r"
		""
		"分解水晶。每个水晶提供所列五种类型的各8,192，总计每个水晶40,960，每批十六个总计655,360。连接并排空所有输出；满罐会停止机器。"
		""
		"持续提供FE、催化剂和固态反物质。晶体无法被扫描和复制。逆转旋转转换将以1:1的比例返还液体，不会增加其总量。"
		""
		"该农场支持后期复制成本，但对守护者故事来说并非必需。"
	]
	quest.5EC0926A00000102.title: "Primordial Matter：你的复制农场"
	quest.5EC0926A00000103.quest_desc: [
		"可选的运输原版末影龙的方案。在5×5的高级工作台里合成巨龙捕获器；JEI会显示其第6章配方。"
		""
		"右键点击活龙的躯干、头部、翅膀或尾部即可捕捉。完整的容器会闪烁，并保留龙的体力、名称和已保存的属性。无法捕捉濒死的龙或载有乘客的龙。"
		""
		"&c被释放的龙会保持敌对状态，可能破坏地形。请在远离基地的地方准备一个竞技场。&r"
		"{@pagebreak}"
		"&6释放并重复使用容器&r"
		""
		"在上方19格宽、12格高、19格深的空旷干燥区域，潜行右键点击方块。放置方块可将龙安全困住。空容器可重复使用。"
		""
		"捕获活跃的末地龙会打开其出口传送门，而不会生成替代者。捕获不提供击杀经验、掉落物或成就进度。"
		""
		"该容器无法复制，且仅接受原版末影龙，不接受驯养者。"
	]
	quest.5EC0926A00000103.title: "将末影龙收容起来"
	quest.5EC0926B00000101.quest_desc: [
		"输入 /cultivation_help 获取当前键位设置的简短教程。打开 Cultivation，点击 Meditate 并在安全处保持静止。准备好移动时点击 Stop。"
		""
		"观察种植进度和Ki的增长。进度提升你的阶段；Ki强化能力。坐垫有助于后续，但并非开始所必需。"
		""
		"试着冥想，然后完成这个任务。第一章将引导你获得第一颗突破药丸。"
	]
	quest.5EC0926B00000101.title: "第一步：你的第一口呼吸"
	quest.5EC0926B00000102.quest_desc: [
		"在盔甲架上方放置一个干草块来制作靶子。任务会检测它，但不会消耗它。"
		""
		"把它放在远离宠物、蜜蜂和其他玩家的宽阔明亮平台上。在这里测试设备，然后带着第一个可用的栽培术回来。"
	]
	quest.5EC0926B00000102.title: "第一步：安全的练习目标"
	quest.5EC0926B00000103.quest_desc: [
		"第三章介绍了失落城市中的教派大厅和学院。选择你的道路，获取合适的手册，并在满足要求后右键点击它。"
		""
		"打开 F8 > 技巧，装备一个主动法术并停止冥想。瞄准你的假人，并使用 /cultivation_help 中显示的按键施放。武器法术需要主手持有匹配的武器。"
		""
		"注意Ki消耗和冷却时间，然后冥想恢复。成功施放后勾选此项。"
	]
	quest.5EC0926B00000103.title: "第一步：装备与施放魔法"
	quest.5EC0926B00000104.quest_desc: [
		"达到第9阶段并填满其培育条，然后用药丸进入下一个领域。每个编号章节都提供通往该药丸的路线。"
		""
		"在 Cultivation 中确认你的领域，然后回到 Techniques 和你的门派查看符合条件的技艺。首次突破后勾选此项；勾选本身不会授予任何奖励。"
	]
	quest.5EC0926B00000104.title: "第一步：你的下一个突破点"
	quest.5EC0927A00000101.quest_desc: [
		"此分支包含三项活动：解锁特定领域的试炼、传授失传技艺的可选记忆法庭，以及武神之后的可选飞升之战。"
		""
		"记忆庭院是四个守护者维度中的训练庭院。每个庭院都有一个名为石碑的中心地板方块。完成所有四种不同的练习，即可学会四重禁食经文，一个能永久保持饥饿和饱食度满值的被动效果。"
		""
		"你可以完成十个章节、守护者契约和飞升，而无需访问记忆法庭。法庭任务会解释每项练习；继承任务会说明它们的共同奖励。"
		"{@pagebreak}"
		"&6开始一项试炼&r"
		""
		"达到第9阶段并完成全部培养，使用下一个领域的丹药。武宗、武皇和武神将开始试炼；其他领域的丹药会直接提升你。"
		""
		"准备一个宽25格、上方有3格空位的平坦干燥地面。从中心附近开始，准备好治疗和所需的战斗技巧。同时进行的个人试炼之间留出50格距离。"
		""
		"&c试炼开始时消耗一颗丹药。失败、死亡、取消和登出均不退还。你的领域和修为将保留。&r无效的地面或未满足要求将导致无法进入，且丹药不会被消耗。"
		""
		"青绿色屏障会阻止飞行和逃跑，尝试这些操作不会失败。使用 /cultivation_trial cancel 来认输。失败或取消后需等待 20 秒才能重试。"
	]
	quest.5EC0927A00000101.title: "从这里开始：这些试炼是什么？"
	quest.5EC0927A00000102.quest_desc: [
		"&6正教&r攻击消耗的气减少15%。自动护盾触发时，修炼攻击在3秒内获得20%的伤害加成。防护阵法获得5%的伤害减免。格挡后进行反击。"
		""
		"&4Demonic&r cultivators build Fervor by alternating attack categories within six seconds. Each stack adds 6% cultivation damage and 5% damage taken, up to three stacks. Repeating a category restarts at one."
		""
		"狂热生效期间，直接种植对敌造成的伤害会回复5%的伤害值，上限为每秒最大生命值的1%。倒影、盟友和内心恶魔不提供治疗。"
		""
		"你选择的教派决定加成。创意模式下对两条路径的访问并不会合并加成。"
	]
	quest.5EC0927A00000102.title: "你所在教团的战斗加成"
	quest.5EC0927A00000103.quest_desc: [
		"&6武学宗师：天雷&r"
		""
		"&c试炼会在开始时消耗其药丸，即使失败也是如此。使用前做好准备。&r"
		""
		"在完全修成的“大武师”阶段9，使用“主丹”。存活六次雷击。每个橙色圆圈标记了闪电落下前约两秒的位置。完全移动到圆圈外，然后准备下一个标记。"
		""
		"闪电会造成高额伤害。带上治疗药水并保持移动，无需任何攻击技巧或阵型。"
		"{@pagebreak}"
		"&6武学帝：经脉淬炼&r"
		""
		"在武学宗师九阶满修状态下，使用帝皇丹。在每秒受到一次内息伤害的持续30秒中存活，包含最后一秒。"
		""
		"开始时，快捷栏里有金苹果、再生药水和治疗药水。尽早吃喝恢复。吸收、抗性、已学习的防御都能派上用场。"
		""
		"移动无法规避伤害。注意倒计时并在最后脉冲中存活。无需攻击、阵型或消耗Ki。"
		"{@pagebreak}"
		"&6武神：天地劫难&r"
		""
		"在武尊九阶满修状态下使用神丹。击败三个心魔，每轮两分钟。第一轮增加闪电，第二轮增加可跳跃的黄金地面波，第三轮两者结合。"
		""
		"只有栽培攻击才能伤害它们。装备几个可用的法术，并携带匹配的武器，以便在冷却期间轮换攻击。不需要任何阵型。"
		""
		"恶魔可以复制你已学习的被动防御。复制的盾牌可减少一次伤害的25%，所有复制的盾牌共享10秒的冷却时间。盾牌效果并不意味着你的攻击被完全格挡。"
	]
	quest.5EC0927A00000103.title: "如何赢得每一次突破 (How to Win Each Breakthrough)"
	quest.5EC0927A00000104.quest_desc: [
		"每位猎手都必须在战斗前接受自己教派首领的契约。守护者狩猎可以共享，而试炼则是个人任务。"
		""
		"要获得奖杯，需通过栽培攻击造成守护者单独最大生命值的至少1%伤害，或提供十秒的友军阵型支援。你必须存活，在64格范围内，并在最后30秒内做出贡献。"
		""
		"合格的猎人将获得个人奖杯。若背包已满，奖杯将等待有空位时送达。将奖杯归还给主人以领取契约奖励。"
		"{@pagebreak}"
		"&6并肩作战，重寻坟墓&r"
		""
		"每增加一名斗士，最大生命值提升45%，最多六名。注意橙色攻击提示和恢复音效：这表示有30%的伤害窗口。"
		""
		"死亡后，你有90秒的时间取回坟墓，期间守卫者不会攻击或设陷阱。对其使用耕作攻击会结束此宽限期。其他敌人和环境危害仍可能伤害你。"
	]
	quest.5EC0927A00000104.title: "合作守卫狩猎的运作方式"
	quest.5EC0927A00000105.quest_desc: [
		"最后的朝圣者分发了最后的口粮，看到麒麟从贫瘠的土地中汲取生命。通过练习躲避闪电来恢复这段记忆。"
		""
		"在破碎子午线，用探险家罗盘找到玉记忆庭院。空手右键中央石碑获取说明，或潜行右键开始。无需药、艺术或Ki。"
		""
		"在闪电到来前（约两秒后）移出每个橙色圆圈。在两分钟内存活所有六个标记。三次练习打击会结束尝试，且不会扣除你的生命值。"
		""
		"首次通关会恢复 The Last Ration 并获得四个 Jade Memory Lantern。使用 /cultivation_memory 追踪你的四个个人记忆。"
	]
	quest.5EC0927A00000105.title: "记忆 I：最后的口粮"
	quest.5EC0927A00000106.quest_desc: [
		"朝圣者学会了在不消耗周围世界的情况下照料内心的余烬。在与自己的分身进行的一场实战中，找回这段记忆。"
		""
		"在灰烬天堂找到灰烬记忆庭院。在 F8 > 技巧中装备可用的战斗技巧，补充 Ki 并带上合适的武器。空手右键中央石碑即可开始。"
		""
		"在2分钟内使用栽培攻击击败双生。它会复制你所有已学习的可用战斗技巧，包括未装备的，并可能复制被动防御。躲避橙色警告并轮换你的攻击。"
		"{@pagebreak}"
		"&6练习规则与奖励&r"
		""
		"三次标记命中将结束练习，而非扣除你的生命值。你自己的攻击仍会消耗正常的Ki和冷却时间。护盾会阻挡飞行和逃跑；外部生物和环境危害仍然危险。"
		""
		"首次通关会恢复体内的余烬，并奖励四盏余烬记忆灯笼。这是记忆法庭的试炼；武皇丹则使用单独的30秒生存考验。"
	]
	quest.5EC0927A00000106.title: "记忆 II：内心的余烬"
	quest.5EC0927A00000107.quest_desc: [
		"在交界的海岸，朝圣者通过闭合循环学习返还消耗的气。为四个充能站充能，找回这段记忆。"
		""
		"在蔚蓝旷野中找到潮汐记忆庭。装备可用的主动法术，并携带至少四次施法所需的Ki，必要时带上匹配的武器。空手右键中央石碑即可开始。"
		""
		"走进金圈并施放已装备的艺术。默认键：Z为拳，X为掌，C为武器。成功施放会点亮下一站；请在两分钟内充能全部四站。无需命中任何目标。"
		""
		"冷却时间和Ki消耗仍然有效。若车站未充电，请检查你的位置、装备的艺术品、Ki、冷却时间和持有的武器。首次通关会恢复The Returning Tide，并奖励四个Tidal Memory Lanterns。"
	]
	quest.5EC0927A00000107.title: "记忆 III：回归的潮水"
	quest.5EC0927A00000108.quest_desc: [
		"在玄武脚下，朝圣者学会了将其他课程融会贯通。这项练习结合了主动阵型、四次施法和闪电闪避。"
		""
		"在黑石海域找到黑石记忆庭院。学习一个符合条件的攻击和一个可部署的阵法：正统派可选三符咒聚阵或八卦灵阵，而魔派可选棱镜逆转盾。"
		""
		"为其和阵法装备攻击并补充Ki。空手右键中央的石碑即可开始。不消耗任何药丸。"
		"{@pagebreak}"
		"&6将容器粘合在一起&r"
		""
		"在 F8 > 技巧 > 阵型中装备一个已学习的领域。关闭菜单，站在中央石碑上并按 V 施放。将其锚定在庭院中心。六边形气盾等自动护盾不计入在内。"
		""
		"激活场地后，走进每个金圈并施放已装备的攻击。在2分钟内充能全部四个。若场地失效，返回中心并在冷却后重新部署。"
		""
		"在橙色闪电圈落下前离开。三次练习打击可结束练习且无损生命值。首次成功将恢复 The Unbroken Vessel 并获得四个 Blackstone Memory Lanterns。"
	]
	quest.5EC0927A00000108.title: "记忆 IV：未破碎的容器"
	quest.5EC0927A00000109.quest_desc: [
		"达到武神境界，并完成所有四个守护者的契约，归还他们的奖杯并领取主人的奖励。"
		""
		"使用一个创世道、一个四守护封印、四个原始物质晶体和三个石英块制作一个升天祭坛。JEI会显示配方。"
		""
		"将其放置在平坦、干燥、宽25格的地板上，上方需有三格空隙。准备好生命值、Ki和战斗技巧，然后潜行右键开始。此祭坛可重复使用，无需药丸、阵型或记忆法庭的完成。"
	]
	quest.5EC0927A00000109.title: "准备可选的飞升之战"
	quest.5EC0927A0000010A.quest_desc: [
		"升天祭坛挑战你，将守护者的四个方面合为一体，对抗内心的恶魔。赢得三轮比赛，每轮限时两分钟。"
		""
		"第1轮增加橙色闪电标记。第2轮增加可跳跃的扩展金波。第3轮两者结合。用修炼攻击击败每个恶魔以推进。"
		""
		"&c此战斗会造成真实伤害，可能致你死亡。护盾会阻止飞行和逃跑。/cultivation_trial cancel concedes; no pill or ingredients are spent to enter.&r"
		"{@pagebreak}"
		"&6战斗与奖励&r"
		""
		"恶魔会复制你已学习的可用战斗技巧，包括未装备的。复制的防御可减少25%的伤害，并共享10秒的恢复时间。带上多个已装备的攻击、匹配的武器和足够的Ki来应对冷却时间。"
		""
		"首次胜利会授予你一枚升天徽章、四盟约纪念碑、一个外观称号和金色光环。使用徽章可切换光环；潜行使用可切换称号。这些奖励不提供任何战斗属性。"
	]
	quest.5EC0927A0000010A.title: "可选：赢得升天之战 (Win the Ascension Battle)"
	quest.5EC0927A0000010B.quest_desc: [
		"获得“飞升者”地位后，再次右键单击花盘，与更强大的恶魔和更快的闪电预警进行再战。"
		""
		"在时限内击败所有三轮。取消或失败不会移除“上升者”状态。重复胜利不会获得额外物品、经验值或战斗力。"
	]
	quest.5EC0927A0000010B.title: "可选：更艰难的再战一场"
	quest.5EC0927A0000010C.quest_desc: [
		"四段记忆揭示了末朝朝圣者被遗忘的艺术：从世界中汲取生命，更新其温暖，循环往复，毫无浪费，并封印承载它的容器。"
		""
		"自行完成四个不同的记忆庭院，顺序不限。第四个记忆会自动传授四重禁食经。在 F8 > 技巧 > 身体 下查找，无需手册或装备栏位。"
		""
		"无需食物或Ki即可永久保持饥饿和饱食度。各派系及中立修士均可学习。"
		"{@pagebreak}"
		"&6继承的作用——和不作用的地方&r"
		""
		"启用后，正常的食物恢复机制仍然有效，金苹果的效果也保持不变。该艺术不会使你无敌，也不会替代吸血鬼之血等资源。"
		""
		"记忆与艺术会随死亡、重登和维度旅行而留存。使用 /cultivation_memory 查看你的发现。重复一个庭院、领取灯笼或与团队共享任务完成进度，都无法替代你个人的四次通关。"
		""
		"灯笼是首次通关的装饰性奖励。庭院不使用突破药丸；其守卫可防止飞行和逃跑。外部危险仍会对你造成伤害。使用 /cultivation_trial cancel 投降，或在失败或取消后等待 20 秒再重试。"
	]
	quest.5EC0927A0000010C.title: "空碗，无尽的气息"
	quest.5EC1013000000101.quest_desc: [
		"制作 Farming for Blockheads 的 Market，方便获取种子、树苗和其他农业用品。"
		"放置时要留出空间给商人。打开以浏览商品，并带上所需的付款。JEI会显示市场配方和可用交易。"
	]
	quest.5EC1013000000101.title: "农场集市"
	quest.5EC1013000000102.quest_desc: [
		"按 E 打开物品栏，然后点击左上角的商店按钮。"
		"在这里花费任务赚到的金币。悬停在选项上可查看价格。该商店与Farming for Blockheads市场分开。"
	]
	quest.5EC1013000000102.title: "商店在哪里？"
	quest.5EC1013000000103.quest_desc: [
		"来自《通往永恒的门户》的传送珍珠可以在你建好永久刷怪塔前召唤出怪物潮。在JEI中搜索传送珍珠，查看各个传送门及其配方。"
		"在远离基地的大型、开阔、封闭的竞技场中，将珍珠用于一个方块上。在开启敌对传送门前，准备好装备和空间；浪潮有时间限制，如果怪物逃脱或无法生成，浪潮会失败。"
		"从适合你当前进度的传送门开始。无尽传送门不适合新手。每个珍珠对应特定的传送门，不可互换。"
	]
	quest.5EC1013000000103.title: "带门珍珠的早期生物"
	quest.5EC1013000000104.quest_desc: [
		"用 Dark Utilities 制作睡眠护身符，并将其放在常规玩家物品栏中，以抵御失眠及其幻影生物。"
		"存放在储物箱里的护身符无法保护你。现有的幻影和正在攻击其他玩家的幻影不会立即消失；每个玩家都应携带自己的护身符。"
	]
	quest.5EC1013000000104.title: "睡眠符咒：告别失眠症"
	quest.5EC1013000000105.quest_desc: [
		"制作栽培图书馆以存档备用技巧手册。学习手册的效果是永久性的；存储副本不会获得额外的效果。"
		"右键手册可存入，或空手打开图书馆。按名称或物品ID搜索。点击书籍可取出，Shift+点击可在图书馆和背包间移动书籍。"
		"六个面都支持物品的存取。漏斗和物品管道可以传输手册；连接一个AE2存储总线，将其暴露给您的ME网络。导入/导出总线也通过正常的物品传输工作。使用过滤器来避免移动您想保留的书。"
		"共有512个存储格，每个最多可存放4096个相同物品。物品数据独立保存，多余物品将被拒绝，绝不会消失。打破并移动图书馆，可将其存档书籍保留在方块内。"
	]
	quest.5EC1013000000105.title: "你的种植图书馆 (Your Cultivation Library)"
	quest.5EC1013000000106.quest_desc: [
		"冥想会温和地在你周围生长出一个5x5的花园。"
		"草地旁的普通泥土会变成草方块；当上方方块为空且亮度足够时，草地会生长出短草和花朵。在坐垫上冥想时此效果同样有效。"
		"它不会替换作物、农田、机器或其他被占用的方块，也不会加载附近的区块，并且尊重玩家的放置保护。此效果与蹲下生长作物分开处理。"
	]
	quest.5EC1013000000106.title: "冥想花园"
	quest.5EC1013000000110.quest_desc: [
		"在第二章期间，制作Ki Crystal Cultivator所需的Tyrian Steel之前，去一趟The End。按照JEI的Tyrian Steel配方链操作，无需等到后续章节才能前往。"
		"用JEI里的配方，用TelePastries合成End Cake，安全放置，然后空手使用即可传送。维度蛋糕是建造传送门的替代方案；请选择TelePastries蛋糕，而非被禁用的Ex Deorum版本。"
		"进入前准备好盔甲、方块和可靠的返回方法。如有可用入口，普通的末地传送门也行。在击败末影龙之前，末影龙的出口传送门是无效的。"
		"准备好后，标记此指南为已完成，然后返回 Honeysuckle and Ki Crystal Cultivator 分支。"
	]
	quest.5EC1013000000110.title: "末地与基岩晶体之前"
	quest.5EC1A70000001101.quest_desc: [
		"在Eidolon工作台制作Martial Warrior药丸，填满主格和所有四个试剂槽。Niotic Crystals来自Powah充能，Spirit Ginseng Root来自烹饪锅。"
		""
		"在凡人阶段9，填满最后一个修炼条并服用丹药即可成为武修者。检测任务所需物品并不会触发突破。"
	]
	quest.5EC1A70000001101.title: "首个工作台突破任务"
	quest.5EC1A70000001102.quest_desc: [
		"在已完成的伊甸源祭坛中，用物品配方和源供应制作武学大师药丸。"
		""
		"达到武僧9阶，填满最后一个修炼条，然后服用丹药。保留祭坛和源农场，用于后续配方。"
	]
	quest.5EC1A70000001102.title: "突破伊甸园子午线 (Break Through the Eden Meridian)"
	quest.5EC1A70000001103.quest_desc: [
		"使用刻印器，顶部放置雪莲，中间放置空间丹田核心，底部放置含有100,000源能的1k源能存储单元。"
		""
		"达到武学大师9阶，填满最后一个修炼条，然后服用武学宗师丹。之后返回宗门领取合适的秘籍。"
	]
	quest.5EC1A70000001103.title: "唤醒空间丹田 (Awaken the Spatial Dantian)"
	quest.5EC1A70000001104.quest_desc: [
		"&c&l警告：此药丸将开始天雷试炼。试炼开始时消耗一颗，若失败、死亡、取消或退出，该药丸将丢失。&r"
		""
		"使用绯红砧配方，在 7×7 精英工作台里制作武学领主药丸。使用未精炼的灵体棱镜，而非精炼的灵体。"
		""
		"在完全修炼的大武师阶段9，将药丸用于一个宽度至少为25格、上方有3个清晰方块的空旷地面。"
		"{@pagebreak}"
		"&6天堂闪电&r"
		""
		"承受六次闪电袭击。每个橙色圆圈标记闪电落点前约两秒的位置；完全移出圆圈并保持随时可以治疗的状态。"
		""
		"青绿色的屏障会阻止飞行，将你困在内部。试图飞行或穿越屏障本身并不会导致试炼失败。失败后你的领域和修为会完好无损，但药丸不会返还。"
	]
	quest.5EC1A70000001104.title: "锻造绯红砧之药丸 (Forge the Scarlet Anvil Pill)"
	quest.5EC1A70000001105.quest_desc: [
		"使用 Draconic-tier 融合锻造，催化剂为天-地经脉印，并使用 JEI 中显示的十二种注入材料，包括双域经脉核心、机械丹田和四颗劫难龙心核心。提供 96,000,000 FE。"
		""
		"在武宗九阶满修状态下，服用炼制完成的武王丹。"
	]
	quest.5EC1A70000001105.title: "突破：武学之王"
	quest.5EC1A70000001106.quest_desc: [
		"向 IFEU Infuser 提供两个 Yin-Yang Breakthrough Catalyst 和 4,000 mB Liquid Dragon Breath，并为其供电。"
		""
		"在武王九阶满修状态下，服用武宗丹。保留梳子、流体和灌注线路，以备后续配方使用。"
	]
	quest.5EC1A70000001106.title: "武学宗师突破成就"
	quest.5EC1A70000001107.quest_desc: [
		"&c&l警告：此药丸会开始一项挑战。挑战开始时消耗一颗药丸，若失败、死亡、取消或退出，药丸将丢失。&r"
		""
		"在反质子核合成器中用反物质处理天升核心。收集药丸，然后达到武学宗师九阶并完成全部修炼。"
		""
		"准备一个至少25格宽、上方有3格空地的平坦干燥地面。在中心附近使用药丸，以满血状态开始经脉淬炼：承受30秒的内部真气伤害并存活。"
		"{@pagebreak}"
		"&6梅里迪亚恩淬火生存&r"
		""
		"将金苹果、再生药水等治疗物品放入快捷栏。伤害每秒脉冲一次，尽早食用恢复。吸收、抗性或已学习的防御技能会有所帮助。无需任何攻击技巧、阵型或Ki消耗。"
		""
		"伤害会追踪你。移动、跳跃或蹲下都无法躲避，红金色的脉冲也不是安全区标志。青色的护盾会阻止飞行和逃跑。"
		""
		"存活于最终脉冲，成为武皇。失败将保留你的领域和修为，但会失去丹药。若地板或突破要求无效，试炼不会开始，且无任何消耗。"
	]
	quest.5EC1A70000001107.title: "武学帝境突破"
	quest.5EC1A70000001108.quest_desc: [
		"使用复制的虚空曼陀罗和其他所列材料，在进化机械合金器中制作武学至尊丹。"
		""
		"在武皇九阶满修状态下消耗。保留备用进化经脉格和用于第九章的Mortum生产线。"
	]
	quest.5EC1A70000001108.title: "武学至尊突破"
	quest.5EC1A70000001109.quest_desc: [
		"在天地血炉中完成武尊丹。提供复制的君主令、觉醒的龙髓以及剩余的JEI材料、流体和FE。"
		""
		"在武学至尊九阶满修状态下服用丹药。"
	]
	quest.5EC1A70000001109.title: "武学至尊突破"
	quest.5EC1A7000000110A.quest_desc: [
		"&c&l警告：此药丸会开始一项挑战。挑战开始时消耗一颗药丸，若失败、死亡、取消或退出，药丸将丢失。&r"
		""
		"在十重登天祭坛中，使用基石、道心、四枚创世道及剩余配方材料制作武神丹。"
		""
		"将修为提升至武尊境9阶。在平坦、干燥、宽25格的地板上，上方留出三格空间，使用丹药开始天地劫。击败三个心魔，每轮限时两分钟。"
		"{@pagebreak}"
		"&6为最终决战做准备&r"
		""
		"使用栽培攻击，普通挥砍无法伤害恶魔。通过 F8 > 技巧装备可用法术，并为剑、刀、枪法术携带合适的武器。无需结成阵型。"
		""
		"恶魔可以复制你已学习的被动防御。复制的盾牌可减少25%的伤害；所有复制的盾牌共享10秒的冷却时间。在较长的冷却恢复期间，交替使用攻击。"
		""
		"第1轮增加闪电，第2轮增加可跳跃的黄金地面波，第3轮两者结合。结界会阻止飞行和逃跑。获胜可获得武神；失败则保留你的领域和修为，但会失去丹药。"
	]
	quest.5EC1A7000000110A.title: "武神的突破"
	quest.5EC1A70000001201.quest_desc: ["在类泥土的地面上，空出主手，蹲下并长按右键以收集鹅卵石。收集石质鹅卵石可获得鹅卵石；你无需挖掘岛屿。"]
	quest.5EC1A70000001201.title: "搜寻地面"
	quest.5EC1A70000001202.quest_desc: [
		"你的下一个突破是武学大师。探索伊甸园，然后是艾西卡，并用它们的材料在源能驱动的伊甸源祭坛中使用。"
		""
		"从 DivineRPG 的 Overworld 金属和 Ancient Entity 开始。保持你的 Imbuement Chamber、基座、Source Jar 和作物农场运行；它们提供精炼金属和祭坛。"
		""
		"神圣年鉴可在“Farming for Blockheads Market”用一枚绿宝石购买。开启临时裂隙时请携带传送石，或在探索前准备好王国的永久返回传送门。"
	]
	quest.5EC1A70000001202.title: "首个神圣领域"
	quest.5EC1A70000001203.quest_desc: [
		"本章将AE2和Mekanism自动化与失落之城及异界的探索相结合。两条路线都为空间丹田核心和你的武学大师丹药提供能量。"
		""
		"先建立一个可用的ME存储网络，然后添加自动合成。在失落的城市中，你还可以拜访教派并选择一条战斗路线。"
	]
	quest.5EC1A70000001203.title: "超越物质的丹田 (A Dantian Beyond Matter)"
	quest.5EC1A70000001204.quest_desc: [
		"前往野木林获取下一个领域的材料。回家后，使用Malum灵魂、敌对神经网络预测、Clibano和灵魂织机来制作武圣丹。"
		""
		"最后的绯红砧配方需要一个7×7的精英工作台。绯红子午熔炉和天地元气凝聚器现在可以自动化重复批次了，但第一批组件仍需手动制作。"
	]
	quest.5EC1A70000001204.title: "绯红砧之路"
	quest.5EC1A70000001205.quest_desc: [
		"探索永恒星光与暮色森林，同时在家中建造机械能量网络和五重灵魂精炼炉。它们的领主材料、合金和净化灵魂将融合成武王药丸。"
		""
		"&c两个维度的敌人生命值和伤害都增加了3倍。&r出发前请检查你的装备和已学习的防御技能。"
	]
	quest.5EC1A70000001205.title: "双界之劫难（The Twin-Realm Tribulation）"
	quest.5EC1A70000001206.quest_desc: [
		"建造两条配套生产线：阴阳蜜蜂制作蜂巢，量子压缩机将蜂巢变为奇点，流体提取器从奇点方块中提取精华。将两种流体固化并结合阿巴拉契亚双性灵药，即可制成武学宗师丸。"
		""
		"&c阿帕拉契亚的敌人拥有10倍的生命值和伤害。&r在挑战永恒射手前做好准备。"
		""
		"复制材料：Meridian Seeds 用于容器和外壳。你的 Ki Liquefier 提供初始的 Liquid Ki；Heaven-Earth Ki Condenser 是可选的批量升级。"
	]
	quest.5EC1A70000001206.title: "第六条道路：完美的二元性"
	quest.5EC1A70000001207.quest_desc: [
		"Skythern 探索、化学处理、数据流与复制在 Celestial Meridian Weaver 交汇。设置可再生 Echo Shards、化学品和足够的能量，以支持其定制能量舱门。"
		""
		"建造两个休眠的合成丹田核心：一个用于本章，一个用于第8章。"
		""
		"&cSkythern 敌人拥有 15 倍的生命值和伤害。Martial Emperor 药丸会开启生存试炼，使用前请阅读其任务说明。&r"
	]
	quest.5EC1A70000001207.title: "天堂之上的天空"
	quest.5EC1A70000001208.quest_desc: [
		"带上第7章的备用休眠合成丹田核心。Mortum材料、进化Mekanism合金和天劫熔炉将唤醒它，助你突破武学至尊。"
		""
		"在探索的同时发展合金和灵魂丝线，然后制作虚空曼陀罗和虚空淬炼丹田。"
		""
		"&cMortum 敌人拥有 25 倍的生命值和伤害。准备好防御和可靠的返回路线。&r"
	]
	quest.5EC1A70000001208.title: "The Realm of Mortum"
	quest.5EC1A70000001209.quest_desc: [
		"右键破碎的经线封印以进入其领域；在内部使用以返回。探索前请随身携带封印并设立路标石。"
		""
		"采集祖先材料，提取活血和龙脉精华，然后为你的主权者药丸建造重建和炼血生产线。在本章节的同时，完成教派与四守护者中的麒麟和凤凰契约。"
		""
		"&c此世界有危险的敌人，包括强化后的龙。旅行前做好准备；自定义守卫需要驯服攻击。&r"
	]
	quest.5EC1A70000001209.title: "进入破碎的经度 (Enter the Shattered Meridian)"
	quest.5EC1A7000000120A.quest_desc: [
		"在麒麟和凤凰之后完成龙和玄武的契约。它们的联合印记会解锁创世道蓝图。"
		""
		"在家中建造两个分支：法度织机通往天命，而炼体炉则用于制作原始神体。轮回轮为两者提供材料。"
		""
		"在苦难熔炉中结合材料，然后在十重升华祭坛中完成药丸。保持之前的流体和动力线路运行。&c最后的突破是一场三轮战斗试炼。&r"
	]
	quest.5EC1A7000000120A.title: "凡人最后的脚步"
	quest.5EC1A70000001301.quest_desc: [
		"用四个石砾合成鹅卵石。留一些做工具和熔炉。"
		""
		"Ex Deorum 锤能将鹅卵石打成砾石，再打成沙子，最后是尘土。每种材料有不同的筛子掉落物，所以先查JEI确认所需资源，再批量粉碎。"
		""
		"锤子和压缩锤在耐久度为1时会停止工作，而不是直接损坏。使用它们自身的材料（木板、圆石、铁、金、钻石或下界合金）在合成台或铁砧上修复。每种材料可恢复25%的耐久度。"
	]
	quest.5EC1A70000001301.title: "你的第一块鹅卵石"
	quest.5EC1A70000001401.quest_desc: [
		"将树叶或其他可堆肥的植物放入 Ex Deorum 桶中可制作泥土。木制坩埚可将树叶转化为水。"
		""
		"这些是加工方块，不是原版储物桶。用JEI查看可接受的输入。熔岩需要后期任务的Porcelain Crucible。"
	]
	quest.5EC1A70000001401.title: "木桶和坩埚"
	quest.5EC1A70000001501.quest_desc: [
		"用筛子右键点击它来安装弦网。添加一个有效方块，然后继续右键直到筛分完成。"
		""
		"在 JEI 的筛分标签页中查看输入方块和所需筛网。砾石、沙子、粉尘和泥土有不同的掉落物，有些需要多次尝试才能获得。"
	]
	quest.5EC1A70000001501.title: "筛网和基本网格"
	quest.5EC1A70000001601.quest_desc: [
		"按照要求升级网格，在下一个合成前将其放入背包中。"
		""
		"在确认掉落物前，请保留旧版网格：高级配方不一定包含所有低级配方。制作压缩筛时，请使用其JEI配方中显示的压缩输入和网格。"
	]
	quest.5EC1A70000001601.title: "掌握所有网格模型 (Master Every Mesh)"
	quest.5EC1A70000001701.quest_desc: [
		"在 Porcelain Crucible 中制造岩浆，然后制作你的第一个 Cobblestone Generator。放置储物箱收集其产物，并检查是否正在填充。"
		""
		"这样你就不用拆除岛屿，也能持续获得锤子和筛子。"
	]
	quest.5EC1A70000001701.title: "鹅卵石生成器"
	quest.5EC1A70000001801.quest_desc: [
		"制作每个发电机等级，并在升级前将其放入背包。使用功能性储物抽屉来存放原石。"
		""
		"随着锤击和筛分线的扩展，产量也会增加；当输出存储已满时，更快的发电机也无济于事。"
	]
	quest.5EC1A70000001801.title: "掌握所有发电机"
	quest.5EC1A70000001901.quest_desc: [
		"在熔炉中烧制未烧制的瓷质坩埚，将完成的坩埚置于有效热源上，并加入鹅卵石。当岩浆装满桶后即可收集。"
		""
		"JEI 列出了热源及其速度。将易燃方块远离热源，并为你的 Cobblestone Generator 制作足够的岩浆。"
	]
	quest.5EC1A70000001901.title: "一桶火焰（A Bucket of Fire）"
	quest.5EC1A70000001A01.quest_desc: [
		"建造并点燃一个黑曜石传送门，然后进入下界。带上食物、方块和备用点火工具，并标记好你的返回传送门。"
		""
		"下界资源和结构战利品为多种早期魔法配方提供材料。此任务会检查维度访问情况。"
	]
	quest.5EC1A70000001A01.title: "进入下界"
	quest.5EC1A70000001B01.quest_desc: [
		"将Eidolon's Crucible置于热源上，加入水，并按照Ars Ecclesia中的锡配方操作。这与Ex Deorum Crucible是不同的方块。"
		""
		"按照配方分阶段添加材料，等待每次反应完成再继续。锡会生成秘金和工作台。"
	]
	quest.5EC1A70000001B01.title: "锡炼金术"
	quest.5EC1A70000001C01.quest_desc: [
		"制作 Arcane Gold 和 Eidolon 工作台。配方会用到主网格和独立的试剂槽；请严格按照 JEI 所示填写两者。"
		""
		"本章末尾的武僧药丸配方需要用到工作台。"
	]
	quest.5EC1A70000001C01.title: "魔法工作台 (The Magic Worktable)"
	quest.5EC1A70000001D01.quest_desc: [
		"可选的 Budding GeOre 收集品。露出它的各个面以便芽体生长，然后在不破坏芽体方块的情况下收获成熟的簇。"
		""
		"先收集基地所需的材料，之后再补充收集品。"
	]
	quest.5EC1A70000001D01.title: "每个正在生长的地质矿石"
	quest.5EC1A70000001E01.quest_desc: [
		"在 Origins of Darkness 和 JEI 中，按照 Dark Power Gem 的连锁来建造 Blood Infuser。它使用血液而非 FE 来加工物品。"
		""
		"继续收集血液：腐化之泪，用于Aether的成本超过一个完整提取器的容量。"
	]
	quest.5EC1A70000001E01.title: "血液的灌注 (Infusion of Blood)"
	quest.5EC1A70000001F01.quest_desc: [
		"在血液注入器中，将10,000 mB血液注入一个恶魂之泪。此配方不需要高级承诺。"
		""
		"保留腐化之泪以激活你的萤石传送门。水和普通的恶魂之泪无法在此整合包中打开以太传送门。"
	]
	quest.5EC1A70000001F01.title: "一把被腐化的钥匙"
	quest.5EC1A70000003101.quest_desc: [
		"建造一个荧光石传送门框架，并用腐化之泪激活入口。带上食物和建筑材料进入以太，并确保你的着陆点安全。"
		""
		"带一个Skyroot桶回家。装满水后，它是烹饪锅食谱的配料。"
	]
	quest.5EC1A70000003101.title: "通往以太的旅程"
	quest.5EC1A70000003201.quest_desc: [
		"在农夫的欣喜烹饪锅中，将甜菜根、两份地狱灵和大地精华混合，制作出灵参根。"
		""
		"Grim Harvest 说明了如何用 Crude Scythe 收割灵魂。将完成的根茎用于 Martial Warrior 药丸，无需在野外寻找。"
	]
	quest.5EC1A70000003201.title: "灵参根 (Spirit Ginseng Root)"
	quest.5EC1A70000003301.quest_desc: [
		"将源宝石放入灌注室，并将土之精粹配方的三种辅助材料分别放置在附近的奥数基座上。"
		""
		"农业源链接通过作物生长收集源。将源罐放在源链接和容器附近，种植作物即可为其充能。"
	]
	quest.5EC1A70000003301.title: "大地之精粹"
	quest.5EC1A70000003401.quest_desc: ["合成认知合金，用于制作认知经验存储设备。JEI 中有配方，为下一任务的喷泉、方尖碑和调谐杖制作足够的量。"]
	quest.5EC1A70000003401.title: "认知合金"
	quest.5EC1A70000003501.quest_desc: [
		"经验方尖碑用于存储Minecraft经验值。在旁边建造喷泉和调谐杖，按照提示连接装置，并测试少量存取操作。"
		""
		"存储的 XP 与 Ki 和修炼进度分开。它不会提升你的境界。"
	]
	quest.5EC1A70000003501.title: "储存你的经验值"
	quest.5EC1A70000003601.quest_desc: [
		"用所需的内核和墙壁方块建造一个中空的 3×3×3 巨型箱子，中间留空。将其物品栏连接到 Tom 的网络和一个合成终端。"
		""
		"使用 Crafting Terminal，而非 Storage Terminal。任务中的物品数量并非完整的清单。在移动存储前，先确认终端能识别到箱子里的物品。"
	]
	quest.5EC1A70000003601.title: "合成终端和巨型箱子"
	quest.5EC1A70000003701.quest_desc: [
		"为 RFTools Builder 供电，插入已配置好的 Fortune Quarry Shape Card，并为挖掘的方块提供存储。开始前请先预览一小块测试区域。"
		""
		"在远离基地的矿区使用。此任务需要 Fortune Quarry 卡片，而非普通的 Shape Card 或其他采石场变种。"
	]
	quest.5EC1A70000003701.title: "财富采石场"
	quest.5EC1A70000003801.quest_desc: [
		"先让你的岛屿可持续：备足树苗，收集木材和鹅卵石，把树叶变成水和堆肥。接触熔岩前，先建个安全平台。"
		""
		"在服务器上，使用 /skyblock create <name> 创建你的岛屿。领取下方的 Silent Gear 蓝图；/hqs shop 可打开商店。"
		""
		"第一章以武僧丹结束。要使用它，需达到凡人九阶并填满最后一个修炼条。Ki是你的能量储备，而非修炼进度。"
		"{@pagebreak}"
		"&6在任务书中四处走动&r"
		""
		"默认设置：K 打开任务，F8 打开种植，F6 缩放。输入 /cultivation_help 获取简短指南。常见问题与帮助涵盖 /home、恢复和按键冲突。"
		""
		"材料处理期间，尽早冥想。任务线显示前置条件；对勾表示已确认说明，物品任务则检查你的物品栏。从任务窗口领取已完成任务的奖励。"
	]
	quest.5EC1A70000003801.title: "创建你的岛屿并开始冒险"
	quest.5EC1A70000003901.quest_desc: [
		"Aether 提供 1.5 倍种植速度加成。在那里建造安全避难所，冥想等待基地处理材料。"
		""
		"Aether地牢和Nether结构可提供早期手册，最高可达Martial Warrior等级。学习前请阅读手册中的领域和路径要求。"
	]
	quest.5EC1A70000003901.title: "以太种植法"
	quest.5EC7202609150001.quest_desc: [
		"第三章，在失落的城市中拜访正统与恶魔教派，比较手册后选择道路。右键所选教派的祭坛以宣誓效忠，之后即可为其祭坛在你的岛屿上制作蓝图。"
		""
		"&c在生存模式中，你的誓言是永久性的。你不能使用对立路径的艺术。&r任一路径都能完成整合包，两者在达到武学大师境界时都能提供飞行和被动Ki恢复。"
		""
		"祭坛每章提供两次一次性补给任务。上交所需物品以获取功勋，然后用功勋购买手册。更高级的艺术还需要达到指定的领域和任务进度。"
	]
	quest.5EC7202609150001.title: "正统派还是恶魔派？"
	quest.5EC7202609160801.quest_desc: [
		"在失落的城市中找到蔚蓝云厅或蔚蓝云学院。探险家指南针可以定位它们。正统祭坛和大师位于后方中央大厅或宝塔中。"
		""
		"右键蓝色祭坛并确认正统誓言。这将解锁相应的祭坛配方、任务提交和手册。"
		""
		"&c誓言在生存模式中永久有效，并能阻止恶魔之术。&r 此可选任务会记录你的承诺，无需完成恶魔分支。"
	]
	quest.5EC7202609160801.title: "正统之路"
	quest.5EC7202609160811.quest_desc: [
		"用探险家指南针在失落的城市中找到绯红日食大厅或绯红日食学院。在主教学楼里寻找红色的祭坛。"
		""
		"右键祭坛并确认恶魔誓言，即可解锁对应的祭坛配方、任务提交和手册。"
		""
		"&c誓言在生存模式中永久有效，并会阻止正统技艺。&r 此可选任务会记录你的承诺，无需完成正统分支。"
	]
	quest.5EC7202609160811.title: "恶魔之路"
	quest.5EC7202609160901.quest_desc: [
		"收集一个壁炉、两个石手和一个坏死焦点。使用 Ars Ecclesia 进行仪式布局、准备材料并激活；石手用于放置祭品。"
		""
		"灵魂碎片可通过结晶仪式，将附近的亡灵献祭。僵尸猪人（pigmen）也可用于献祭。"
		""
		"此处的四个额外石手能扩展你的仪式装置。为后期的爱德隆材料保持可访问性。"
	]
	quest.5EC7202609160901.title: "致命交易"
	quest.5EC7202609160911.quest_desc: [
		"携带血液提取器击杀生物，直到其储存 5,000 mB 血液。检查其工具提示中的数量；空的提取器不计入在内。"
		""
		"你保留已填充的提取器，奖励会再提供一个。将血液用于黑暗力量宝石和血液注入器系列。"
	]
	quest.5EC7202609160911.title: "第一滴血"
	quest.5EC7202609250101.quest_desc: [
		"Malum spirits come from kills made with a soul-reaping weapon. Craft a Crude Scythe: smelt Raw Soulstone into Refined Soulstone, then combine it with three Iron Ingots and two Sticks. JEI shows the pattern; Nether Soulstone Ore provides an early source."
		""
		"在末地，用镰刀给予烈焰或岩浆怪致命一击，收集它们的炼狱之魂。普通剑无法收集。"
		""
		"任务需要一个灵魂，但每个灵魂高丽参根需要两个。在返回烹饪锅前收集几个。镰刀和灵魂任务不会消耗你的物品。"
	]
	quest.5EC7202609250101.title: "Grim Harvest"
	quest.5ECD100400000101.quest_desc: [
		"与外门弟子、内门弟子、导师、炼金术士、长老或尊者交谈以打开教派服务菜单。教派领袖还提供守护者契约。"
		""
		"先加入教团的祭坛。训练奖励20功勋，炼金委托奖励12功勋，与手册商店使用相同的功勋。每项服务均有独立的五分钟游戏内奖励冷却时间。"
		""
		"从菜单开始对练或阵法练习，即可自动进入庭院。无需移动弟子。开始前请阅读每项练习。"
		""
		"本章的任务会指定一个动作，例如赢得比武或解开神社谜题。成功完成后任务会自动完成，其图标并非需要上交的物品。"
	]
	quest.5ECD100400000101.title: "探险之间的生活"
	quest.5ECD100400000102.quest_desc: [
		"右键点击居民，选择“对练”，然后在庭院中开始。你将被带到训练场；不要试图清理NPC周围的空间。"
		""
		"装备可用的栽培攻击，必要时带上武器，并补充你的Ki。用栽培技巧击败倒影。它会复制你已学习的攻击和防御。"
		""
		"正统派：在2分钟内完成，最多允许1次标记命中即可获得奖励。恶魔派：在90秒内完成，最多允许2次标记命中。3次标记命中将结束任一训练。"
		""
		"练习标记不会造成伤害，但外部危险会。不消耗任何药丸。护盾可防止飞行和离开环形区域。使用 /cultivation_trial cancel 认输。成功可获得20点功勋。"
	]
	quest.5ECD100400000102.title: "格斗训练导师"
	quest.5ECD100400000103.quest_desc: [
		"与教团成员交谈，打开 Formation 并开始练习。菜单会自动带你到庭院。"
		""
		"学习可部署阵法：正统派三符聚集阵或八卦灵阵；魔派派棱镜逆转盾。自动防御盾不计入。"
		""
		"在 F8 > 技巧 > 阵型 中装备阵型。关闭菜单，按中间的 V 键施放。走到四个金圈处，施放已装备的格斗术。躲避橙色闪电标记；带上足够的 Ki 以维持场地和四次施放。"
		""
		"正统派：最多两分钟，最多一次命中计为功绩。恶魔派：90秒，最多两次命中。三次命中则结束训练。不消耗任何药丸；成功奖励20功绩。"
	]
	quest.5ECD100400000103.title: "保持队形，不要散开！"
	quest.5ECD100400000104.quest_desc: [
		"右键点击教团居民并选择炼金术。账本上列出了两种栽培材料和具体数量。在主背包中收集它们，然后点击提交材料。"
		""
		"订单使用灵根、草药、芦苇和花朵，而非普通药水材料。早期订单共需48种草药或根茎。从武宗开始，账本会要求更稀有的材料，如月露花、霜莲瓣和赤阳参。请在JEI中查找它们的来源。"
		""
		"完整交付会消耗两种材料并奖励12点功勋。不完整交付则不消耗任何材料。每个路径的每个等级都有三个轮换订单。五分钟奖励冷却时间适用于所有书桌和居民。"
	]
	quest.5ECD100400000104.title: "炼金术委托任务"
	quest.5ECD100400000105.quest_desc: [
		"在蔚蓝旷野中寻找一个玻璃顶的沉没神殿。其封闭的阶梯会通入水下的一间干燥密室。这是一个小型的可选地标，并非蔚蓝巨龙竞技场或潮汐记忆庭院。"
		"阅读中央的铃铛。右键周围的阀门，将压力从0变为3；发光的条会显示设置。按照铭文上的方向指示，然后回到铃铛处验证你的答案。"
		"首个谜题奖励16个溺亡者钟马赛克和16个金胡萝卜。所有玩家均可独立解谜。若背包已满，物资会等待；腾出空间后可重新探索已清理的遗迹。"
	]
	quest.5ECD100400000105.title: "溺亡者之钟"
	quest.5ECD100400000106.quest_desc: [
		"余烬中继台是灰烬天堂中一个低矮的铜质镶嵌平台。其火焰被封闭，因此谜题本身不会灼伤你。但周围的维度可能仍然很危险。"
		"阅读中继器，然后用空手右键旋转其四个导管。它们的铜出口会显示方向。按照铭文将余烬沿环向内转动，然后返回中继器。"
		"你的第一个方案会奖励16个Ember Relay Mosaics和8个Fire Charges。这些是补给和装饰，不是另一个合成台。"
	]
	quest.5ECD100400000106.title: "传递余烬（Pass the Ember）"
	quest.5ECD100400000107.quest_desc: [
		"在黑石群岛寻找一个封闭的阶梯入口。封印编年史位于地表之下，远离玄武的竞技场。其四道符文铭记着每位守护者所修复之物。"
		"阅读中央编年史以开始，然后按所述顺序触摸符文。每个符文都会告诉你它的名字。错误选择会重置序列，不消耗任何东西。阅读中心会重新开始；其他玩家的阅读不会影响你的阅读。"
		"首次完整阅读可获得16个封印编年马赛克和8个附魔瓶。找到更多副本不会重复奖励。"
	]
	quest.5ECD100400000107.title: "石下编年史"
	quest.5ECD100400000108.quest_desc: [
		"第9章中，保留祖先遗骸、石化活血、不朽之肉和焦黑经脉石各一个。祖先重构器建成后，JEI会显示所有四种物品的种子配方。每个配方都会消耗种子，但会产出更多同种资源。"
		"预留一个输出位用于下一批。其余产8个；石化活血产8个；不朽之肉产4个；子午石产32个。石化方块仍可供给活血流体提取器。"
		"第一批样本和重构器仍需正常获取。为不同的输入源设置过滤器；将所有种子类型放入一个总线中，机器会自行选择匹配的配方。普通建筑石也可以批量开采和冶炼。"
	]
	quest.5ECD100400000108.title: "保留一份种子样本"
	quest.5ECD100400000109.quest_desc: [
		"在开始制作外壳前，先规划好整个机器。JEI的结构预览会列出所有方块；控制器配方会额外增加成本。当列出的FE/t超过普通阀门时，请使用自定义能源阀门，并为每种不同流体配备独立的输入储罐。"
		"Primordial Regenerator 有更大的配方：1 个 Ancestral Remains 可产 64 个，或 1 个 Immortal Flesh 产 16 个。每批需 30 秒，消耗 8,000,000 FE/t，并需要其他 JEI 配方材料。这样既扩大了产量，又不会跳过最终建造链的材料。"
		"{@pagebreak}"
		"保持早期农场运行：Spirit Geode Nursery 会生长一个保留的 Ki Crystal 种子，Hostile Neural Networks 提供支持的生物资源，你现有的 Replication 蓝图会覆盖其解锁的材料。不要在已有系统提供物品的地方建造新的手动收集循环。"
		"使用一个输入项和输出项均有足够槽位的物品总线。新的资源配方最多使用八桶任意流体；任何自定义机器配方都不得要求单次操作超过128桶单一流体。"
	]
	quest.5ECD100400000109.title: "最终机器的生产准备阶段"
	quest.5ECFA92400000101.quest_desc: [
		"使用“第一步”行进行实践，或打开下方的任意答案。这些对勾仅表示已阅读信息，不会解锁领域或接受任务。"
		""
		"输入 /cultivation_help 获取实时按键标签和可选的控制预设（含预览和恢复）。单个按键绑定在 选项 > 控制 中。"
		""
		"以下命令描述了整合包的默认设置。服务器可以更改权限、限制和冷却时间；聊天自动补全会显示可用命令。"
	]
	quest.5ECFA92400000101.title: "从这里开始：如何使用本常见问题解答"
	quest.5ECFA92400000102.quest_desc: [
		"打开 Cultivation 并点击 Meditate。在安全的地方保持静止；旅行或使用法术前点击 Stop。Cultivation 进度会提升你的阶段，而 Ki 则用于支付能力费用。"
		""
		"默认按键：F8 打开种植，K 打开任务，V 施放已装备的阵型，F6 缩放。你的个人绑定将被保留；/cultivation_help 会显示当前分配的按键。"
		""
		"学习栽培方法手册以了解其加成效果。检查每种方法所需的领域和路径。"
	]
	quest.5ECFA92400000102.title: "如何进行种植？How Do I Cultivate?"
	quest.5ECFA92400000103.quest_desc: [
		"达到第9阶段并填满最后一个培育条，然后服用药丸以进入下一个境界。后续的药丸无法跳过境界，完成一个任务也不会触发突破。"
		""
		"&c领主、皇帝和神药会发起挑战，即使失败也会被消耗。使用前请阅读药丸的 quest。&r"
		""
		"如果进度或Ki表现异常，请检查栽培界面和已学习的方法。并非所有方法都提供移动时的被动Ki恢复。"
	]
	quest.5ECFA92400000103.title: "为什么我无法突破障碍？"
	quest.5ECFA92400000104.quest_desc: [
		"在失落的城市中找到正教派的正云殿或学院，或是魔教派的赤月殿或学院。使用其派系祭坛来选择你的阵营。"
		""
		"你的路径决定了你能使用哪些手册和艺术。相反的艺术会被封印而非删除。选择前请阅读誓言。"
		""
		"部落贡品会消耗指定的物品，并一次性授予功勋。手册也可能要求特定的领域和已完成的任务。"
		"{@pagebreak}"
		"&6创意与测试访问权限&r"
		""
		"创意栽培之书会解锁两条路径，并教授栽培方法和武术。它没有配方或掉落来源。"
		""
		"不会改变你的领域、教派誓言或任务进度。激活要求仍然有效。这是一个管理员/测试物品，不属于生存进度的一部分。"
	]
	quest.5ECFA92400000104.title: "我该如何选择一个教派？"
	quest.5ECFA92400000105.quest_desc: [
		"学习手册，然后在 Cultivation > Techniques 中装备其主动技艺。默认：Z 施展拳法，X 施展掌法，C 施展手持武器的技艺。剑、刀、枪的技艺需要对应武器。"
		""
		"你必须有足够的Ki、冷却完毕且处于所需领域，并停止冥想。施放前瞄准。"
		""
		"在 F8 > 技巧 > 阵型中装备一个已学习的领域。关闭菜单，然后按 V 部署；再次按 V 可取消该领域。装备免费，施放消耗 Ki。阅读其半径、持续时间和消耗。自动护盾和其他被动技艺无需部署。"
	]
	quest.5ECFA92400000105.title: "如何使用武术和阵法？How Do I Use Martial Arts and Formations?"
	quest.5ECFA92400000106.quest_desc: [
		"在安全地点使用 /sethome base 设置家，然后用 /home base 返回。将 base 替换为你选择的名称。"
		""
		"使用 /back 返回之前的传送或死亡地点，/tpa <player> 请求拜访，/tpaccept 接受，或使用已启用的 /spawn。返回的目的地可能仍然很危险。"
		""
		"服务器控制家园限制和冷却时间。在 Skyblock 主世界和末地中禁用 /rtp，请使用岛屿命令。"
	]
	quest.5ECFA92400000106.title: "如何设置家园或传送回去？"
	quest.5ECFA92400000107.quest_desc: [
		"该整合包围绕一个空岛展开。在服务器上，/skyblock create <name> 可创建你的空岛；你只需操作一次。共享时请遵循服务器的空岛管理规则。"
		""
		"FTB 任务团队、岛屿成员资格和 Ki 通道访问权限是独立的系统。加入其中一个并不会自动获得其他权限。"
		""
		"单人模式普通地形，创建世界时选择普通/默认世界类型。不要修改现有存档的生成器来转换。更新前请备份存档。"
	]
	quest.5ECFA92400000107.title: "岛屿、团队和世界类型"
	quest.5ECFA92400000108.quest_desc: [
		"使用 /back 返回死亡地点（如可用）。整理背包，潜行到自己的坟墓旁；无需破坏坟墓。"
		""
		"保护方块能抵御破坏性攻击和自动化操作，同时允许合法恢复。服务器所有权权限可能仍然适用。"
		""
		"若恢复失败，请记录坐标和维度并联系工作人员。避免使用爆炸物或破坏性机器；丢失的物品可能需要备份。"
	]
	quest.5ECFA92400000108.title: "如何找回我的坟墓？"
	quest.5ECFA92400000109.quest_desc: [
		"Vethea 有其自身的物品栏规则和受保护的地下城。在初次造访前，请将贵重配饰留在家中。"
		""
		"如果在保护区死亡，请潜行到坟墓旁，而不是破坏它。"
		""
		"离开地牢后若建筑仍被阻塞，请检查领地和团队权限。向管理员报告位置和出口路线；请勿删除玩家数据或反复死亡试图修复。"
	]
	quest.5ECFA92400000109.title: "Vethea：物品栏与建造限制"
	quest.5ECFA9240000010A.quest_desc: [
		"在 JEI 中，悬停物品并按 R 查看配方，U 查看用途，或 A 将其加入书签。请使用此整合包的配方；其他整合包可能会更改它们。"
		""
		"将鼠标悬停在受支持物品上并按住 G 键以打开指南。提示框会显示可用页面。部分指南需要其书籍或已解锁的条目，并非所有模组都提供。"
		""
		"机器配方需核对资源类型、数量、方向、能量和输出位。化学输入不同于物品或流体输入。"
	]
	quest.5ECFA9240000010A.title: "配方与Hold-G指南快捷键"
	quest.5ECFA9240000010B.quest_desc: [
		"检查每个任务和数量，包括进度和勾选标记。将所需物品从机器或网络中取出并放入背包。已填充的容器、已编码的蓝图和命名变体必须与任务匹配。"
		""
		"对于已锁定的任务，请遵循其依赖关系并完成前置任务。奖励需单独领取。"
		""
		"使用 /hqs shop 打开任务商店。如果正确物品仍未注册，请报告任务标题、提示文本和整合包版本，而不是重置进度。"
	]
	quest.5ECFA9240000010B.title: "为什么我的任务无法完成？"
	quest.5ECFA9240000010C.quest_desc: [
		"通过同一可访问频道上的晶体接口，连接机器Ki发电机、存储器和消耗器。接口传输Ki；水库和Ki宝库用于存储。"
		""
		"检查频道所有权、权限、等级范围和可用 Ki。接口可以连接到兼容机器的任意一侧。"
		""
		"将鼠标悬停在机器的Ki条上可查看其存储量和容量。Vault没有升级槽，请使用更高级别或vault-bank多方块结构。机器Ki、个人Ki、液体Ki和FE是独立的资源。"
	]
	quest.5ECFA9240000010C.title: "Ki 接口、通道和宝库"
	quest.5ECFA9240000010D.quest_desc: [
		"对于自定义的多方块结构，使用其编码控制器的JEI结构页面，并比较每一层、内部方块和端口。读取控制器的状态消息。"
		""
		"已组装的机器还需要输入、输出空间和合适的电源。检查舱口容量和FE/t：后期机器需要Celestial或Divine Energy输入舱口。"
		""
		"为避免预览相关的崩溃，Compact Machines 的房间预览已禁用。房间和正常访问仍然可用。"
		""
		"寻求帮助时，请附上控制器名称、状态文本和清除层截图。拆解前请清空物品栏和储罐。"
	]
	quest.5ECFA9240000010D.title: "多区块和紧凑型机器"
	quest.5ECFA9240000010E.quest_desc: [
		"自定义章节组件使用经过编码的蓝图。检测蓝图，将其传输至芯片存储，并向复制终端请求物品。它们不需要原始样本。"
		""
		"守护者印记则使用扫描：将其放入装有记忆芯片的充能身份识别室，等待100%后，将芯片移至芯片存储。两种路线都需要正确的物质类型。"
		""
		"敌对神经网络，请查看模型、模拟舱和战利品制造机的配方。自定义筛子配方有对应的压缩版本；使用JEI所需的输入和筛网。"
	]
	quest.5ECFA9240000010E.title: "复制、数据模型与自动化农场"
	quest.5ECFA9240000010F.quest_desc: [
		"尝试降低渲染和模拟距离、减少粒子效果和禁用着色器。为 Windows 和后台应用保留 RAM，而不是将全部内存分配给 Minecraft。"
		""
		"堆内存的波动是正常的垃圾回收。JEI配方注册的日志仅用于参考，单独无法证明崩溃或内存泄漏。"
		"{@pagebreak}"
		"&6报告一个有用的漏洞&r"
		""
		"包含整合包版本、单人或服务器、具体步骤、受影响的物品或方块，并附上截图。同时附上对应的崩溃报告和日志/latest.log。公开分享前请隐去令牌或个人地址。"
		""
		"性能问题请说明总内存和Minecraft分配量。客户端和服务器包版本需一致。更新前备份世界，移除旧版自定义JAR，不要保留重复版本。"
	]
	quest.5ECFA9240000010F.title: "加载、性能与错误报告"
	quest.5ECFA92400000110.quest_desc: [
		"&6创建一个世界&r"
		""
		"e4mc 让朋友通过互联网加入你的单人世界。你无需设置路由器端口转发。"
		""
		"1. 加载世界，按 Esc，选择“局域网联机”，然后点击“开始局域网世界”。除非需要，否则保持作弊关闭。"
		""
		"2. 等待 e4mc 在聊天中显示地址。复制完整地址并私信给你的朋友。使用那个地址，而不仅仅是本地 LAN 端口号。"
		""
		"3. 你的朋友选择多人游戏 > 直接连接，将地址粘贴到服务器地址中，然后点击加入服务器。"
		""
		"一起玩的时候保持世界开放。返回标题画面或关闭 Minecraft 会结束所有人的会话。"
		"{@pagebreak}"
		"&6在朋友加入之前&r"
		""
		"所有人都需要相同版本的 Dimensional Cultivation 和配套的游戏模式模组。e4mc 提供连接，并不会将你的模组发送给其他玩家。"
		""
		"&c只将地址分享给信任的人。这样他们就能连接到你的世界了。&r"
		""
		"没有地址，或是 e4mc 错误？检查网络连接，返回标题界面，重新打开世界，再使用“开放局域网”。分享最新地址；地址在不同会话之间可能会变化。"
		""
		"你的电脑为所有人运行着世界。如果运行吃力，请降低模拟距离，并避免同时探索相距过远的区域。"
		""
		"若要在主机离线时保持世界在线，请使用配套的专用服务器包。此勾选仅表示指南已读；多人模式为可选。"
	]
	quest.5ECFA92400000110.title: "与朋友一起玩 (e4mc)"
	quest.5F239340F51B8CC5.quest_desc: [
		"建造 Evolved Mekanism Alloyer，并在 JEI 中按照其合金链制作到 Singular 和 Exoversal 合金。"
		""
		"进化组件和最终药丸都需要两种类型。它们是独立的材料，不能互相替代。"
	]
	quest.5F239340F51B8CC5.title: "进化后的机械动力模组"
	quest.60B252E76050E423.quest_desc: [
		"获得一个预言之球，并按照永恒星光条目的说明前往星光。该任务会同时检查物品和您的访问情况。"
		""
		"标记一个返回点，并保留其首领掉落物以换取星铸首领精华。"
	]
	quest.62B5C312D65D9D30.quest_desc: [
		"遵循九重天织布机（Nine Heavens Law Loom）的JEI结构页面。两种流体输入和两种能量输入都在后墙上，流体输入之间是Meridian Glass。保持两种流体在单独的行上；真空输入或更大的容器足以容纳。"
		""
		"至少安装一个 Divine Energy Input Hatch，其余能量输入位用兼容的舱门。Law Fragments 消耗 12,000,000 FE/t；Heavenforged Law Alloy 消耗 16,000,000 FE/t 且需要 Ancestral Dragon Blood。制作时需持续提供该能量。"
	]
	quest.62B5C312D65D9D30.title: "九重天织布机"
	quest.63928A0647466C36.quest_desc: [
		"运行六批 Mortum Soul Resonator 以生产 48 个 Soul Filaments。每次操作会产出八个，并消耗相应的物品和 Liquid Ki。"
		""
		"保持输出清晰，并为虚空曼陀罗蓝图制作额外的细丝。"
	]
	quest.63928A0647466C36.title: "Mortum 灵魂纤维"
	quest.639E7082194D24AE.quest_desc: [
		"在主世界，将时钟在冰火中冻结至时间 18000。将其与路石一同带到 Skythern。"
		""
		"将 Skythern Heart 投入那里的 Divine Flame，然后用 Frozen Clock 作用于火焰以打开 Mortum rift。抵达后激活你的返回点。"
	]
	quest.639E7082194D24AE.title: "打开莫塔姆裂隙 - 时间 18000"
	quest.645FA6A841C024A0.quest_desc: [
		"在Primordial Regenerator中制作Ancestral Dragon Catalyst。它用于祖先生产与蓝图制作。"
		""
		"查看 JEI 中的用途，以便规划批量大小和 Sovereign 药丸的组件。"
	]
	quest.645FA6A841C024A0.title: "祖传龙之催化剂"
	quest.6465FAC1FB663DB3.quest_desc: [
		"在终极9×9合成台里组装机械丹田。在摆放配方前，准备好足量的合金、板片和净化灵魂。"
		""
		"用于高级机械和武王丹。它是一种合成材料，不可直接用于突破。"
	]
	quest.67DBEBBAD49E4187.quest_desc: [
		"在指定的合成台里，用律法分支材料合成天意授权。"
		""
		"请使用完全相同的物品：这不是第九章的复制版主权令。"
	]
	quest.67DBEBBAD49E4187.title: "书写天意诏令"
	quest.682BB4A347E5417D.quest_desc: [
		"为 Spirit Distillation Lens 充能，并制作编码的 Fivefold Soul Refinery 控制器。按照 JEI 预览中的每一层来建造，包括内部的 Spirit Altars、信标和端口。"
		""
		"通过输入总线提供物品，通过流体输入口提供液态Ki，通过能量接口提供FE。内部祭坛是结构的一部分，而非配方输入界面。"
	]
	quest.68D1136899EDDA2E.quest_desc: ["用暗影宝石、腐肉、僵尸头和艾德隆的僵尸之心合成怨恨的灵魂碎片。为伊甸源祭坛留着。"]
	quest.68DA4A2EDD0B3462.quest_desc: [
		"将流体提取器分别朝向石化活血和龙脉石。将活血和龙脉精华分别导入储罐。"
		""
		"收集每种各一桶进行检测。两种源方块都会随时间消耗，请替换它们以保持生产。"
	]
	quest.68DA4A2EDD0B3462.title: "提取活体脉络 (Living Veins)"
	quest.693803B29AF15F04.quest_desc: [
		"使用所列材料、32,000 mB 液态元气和 16,000 mB 祖龙血在永生之体熔炉中处理神圣身体胚胎。"
		""
		"将Primordial Godbody保留用于最后的合成链。"
	]
	quest.693803B29AF15F04.title: "重构原始神体 (Reconstruct the Primordial Godbody)"
	quest.6A9C8A864A834786.quest_desc: [
		"使用 Wyvern-tier 融合锻造注射器，以 Celestial Ki Alloy 为中心催化剂，周围放置所列的 Starlight 材料。"
		""
		"20,000,000 FE 操作可制造四块 Astral Meridian 锭。此生产路线适用于第 6 章的飞船和 Ki 处理。"
	]
	quest.6A9C8A864A834786.title: "调和星界经脉 (Temper the Astral Meridians)"
	quest.6B09586BCAE4C824.quest_desc: [
		"收集 68 个 Samsara Woven Casings，并在建造 Six Paths Samsara Wheel 前让任务检测到它们。"
		""
		"为控制器配方保留额外的组件。"
	]
	quest.6B09586BCAE4C824.title: "轮回编织外壳"
	quest.6C9E3826575E55C7.quest_desc: [
		"将备用的休眠合成丹田核心及其他所列材料放入天劫熔炉中，并用16,000 mB的经脉精华进行处理。"
		""
		"核心已被消耗。将觉醒后的产物用于虚空淬炼丹田链。"
	]
	quest.6C9E3826575E55C7.title: "唤醒合成丹田（Awaken the Synthetic Dantian）"
	quest.6D9C2FBCBC27DF5F.quest_desc: [
		"用实体的 Spirit Gathering Mantra Manual 制作 Spirit Loom。右键打开，放入蜘蛛丝，并用管道或桶将液体元气注入其储罐中。"
		""
		"升级前，1个蜘蛛丝消耗250 mB液态奇，耗时5秒。将灵魂丝留给锻造之心核心和绯红经线。"
	]
	quest.6DF307CAC62762CB.quest_desc: [
		"使用所需的 Aging Catalyst 和 Liquid Ki 在 Age-er 中处理 Thunderheart Ginseng。在花费之前收集三种 Thousand-Year Ginseng Essence。"
		""
		"仙草根是另一种草药。把“增龄剂”留着做后面的批次。"
	]
	quest.6EC2A70000001001.quest_desc: [
		"在Ars Nouveau Imbuement Chamber中精炼Raw Realmite、Raw Arlemite和Raw Rupee，而不是熔炉。将原矿放入其中，并将辅助材料放在附近的基座上，同时确保有充能的Source Jar在范围内。"
		""
		"按顺序制作：Realmite 需要 Iron、Earth Essence 和 Source Gem；Arlemite 需要 Realmite、Earth Essence 和 Amethyst；Rupee 需要 Arlemite、Earth Essence 和 Diamond。每种锭都留一些用于下一个配方。"
	]
	quest.6EC2A70000001001.title: "凡人世界的金属 (Metals of the Mortal Realm)"
	quest.6EC2A70000001002.quest_desc: [
		"用时钟、腐化石和地狱岩锭制作神秘时钟。在做好准备后，于开阔地使用它以召唤远古实体。"
		""
		"Torridite Ore 生成于 Y 8-120。为其配置一个可扫描方块模块，将其插入已充能的扫描仪中，然后扫描附近的岩石。"
		""
		"要获得可再生的腐化碎片，使用2,500源能量，将紫水晶碎片与地狱岩、火焰精华、灵魂沙和发酵蜘蛛眼相结合。"
	]
	quest.6EC2A70000001002.title: "献给远古的时钟"
	quest.6EC2A70000001003.quest_desc: [
		"击败远古实体，收集它的沙鳞和神圣碎片。你需要九个碎片来制作伊甸传送门链所需的圣石。"
		""
		"让任务在合成前检测掉落物。如果碎片不足，再次召唤首领。"
	]
	quest.6EC2A70000001003.title: "击败远古实体 Ancient Entity"
	quest.6EC2A70000001004.quest_desc: [
		"用至少十个雪块建造一个下界传送门形状的框架。在其底部将冰石投入火中创造冰火，然后用雪球砸向该火焰。冰石需要九个冰碎片，使用后消耗。"
		""
		"在岛屿上放置雪块，需将水桶在Aether Freezer中冰冻。用冰块制作冰种子，种植后，用十字形合成法制作四个冰精华，即可得到十二个雪块。传送门框架使用雪块，而非压实冰。"
	]
	quest.6EC2A70000001004.title: "打开艾西卡传送门"
	quest.6EC2A70000001005.quest_desc: [
		"将神圣石投入普通火焰中可创造神圣火焰。用正午的冷冻时钟右键火焰本身，即可打开临时的伊甸裂缝。"
		""
		"整合包的 Clock-and-four-Ice-Shards 配方能制作出正确的 time-6000 变种。进入伊甸园，然后激活 Waystone 或用伊甸园方块建造永久传送门，以便安全返回。"
	]
	quest.6EC2A70000001005.title: "进入伊甸园"
	quest.6EC2A70000001006.quest_desc: [
		"收集十二个伊甸碎片、四个伊甸火花和一个伊甸灵魂。将它们留在背包中，直到任务被注册。"
		""
		"这些会消耗伊甸装备和章节的炼金术。在把全部物资都花在宝石上之前，先查看它们在JEI中的用途。"
	]
	quest.6EC2A70000001006.title: "采集伊甸园的精华"
	quest.6EC2A70000001007.quest_desc: [
		"将三个伊甸碎片合成一个伊甸宝石，再将三个伊甸宝石合成一个伊甸区块。将这两种物品都放入背包以完成该任务。"
		""
		"为镐、盾牌和祭坛组件预留一些材料。"
	]
	quest.6EC2A70000001007.title: "凝缩伊甸园"
	quest.6EC2A70000001008.quest_desc: ["在挑战 Sunstorm 之前，先锻造一把 Eden Pickaxe 和一面 Eden Aegis。将两者都放入背包以注册任务，然后准备好护甲、治疗和返回路线。"]
	quest.6EC2A70000001008.title: "黄金王国的臂膀"
	quest.6EC2A70000001009.quest_desc: [
		"找到Sunstorm的竞技场，准备好战斗，并击败首领。收集并保留其Eden Heart，用于制作Martial Master药丸。"
		""
		"你之后还需要另一个用于狂野林地裂缝的心脏，所以标记好竞技场以便日后返回。"
	]
	quest.6EC2A70000001009.title: "伊甸园的冠军"
	quest.6EC3A70000001001.quest_desc: [
		"制作并放置一个失落之城蛋糕，然后用它来旅行。带上食物、方块和返回方法：失落之城是永久黑暗的。"
		""
		"搜寻探索材料、蔚蓝云团或绯红日食教派。他们的誓约任务是替代选项，只能选择一个阵营。"
	]
	quest.6EC3A70000001001.title: "失落的城市探险之旅"
	quest.6EC3A70000001002.quest_desc: [
		"在Aether地牢的箱子里找Jadeleaf Herb，在Lost Cities被首领守护的玻璃球建筑里找Ironbone Root。两种草药都留着用来合成。"
		""
		"&c失落之城有永夜，敌人生命值和伤害是5倍。&r进入受保护的建筑物前，准备好逃生路线。此任务也需要你亲自访问该维度。"
	]
	quest.6EC3A70000001002.title: "一个失落世界的遗迹"
	quest.6EC3A70000001003.quest_desc: [
		"在AE2陨石中找到Certus Quartz和四个Inscriber压机，使用陨石罗盘进行搜索。JEI也列出了该整合包的其他Certus Quartz来源。"
		""
		"保留所有四个压模：它们是处理器生产时可重复使用的工具。"
	]
	quest.6EC3A70000001003.title: "思想的水晶 (Crystals of Thought)"
	quest.6EC3A70000001004.quest_desc: [
		"为充电器供电以制造带电的 Certus 石英。为刻印机供电并使用其压印机来印刷电路和硅片。"
		""
		"遵循 JEI 的顶部、中部和底部槽位。自动化时，检查每个输入侧向哪个槽位供料。"
	]
	quest.6EC3A70000001004.title: "最初的思维机器 (The First Thought-Machines)"
	quest.6EC3A70000001005.quest_desc: [
		"制作 Charged Certus Quartz 和 Fluix Crystals。为每个处理器，分别打印其电路和硅片，然后用红石在刻印机中组合它们。"
		""
		"逻辑、计算和工程处理器使用不同的压机和材料。为ME网络储备好这三种材料。"
	]
	quest.6EC3A70000001005.title: "三处理器子午线"
	quest.6EC3A70000001006.quest_desc: [
		"将ME控制器连接到电源和线缆，并添加ME能量单元作为缓冲。在扩展网络前，请确保网络保持在线。"
		""
		"能量单元储存的是电力，而非物品。若设备断电或信号中断，请沿电缆追溯至控制器。"
	]
	quest.6EC3A70000001006.title: "网络之心 (Heart of the Network)"
	quest.6EC3A70000001007.quest_desc: [
		"将4k物品存储单元插入已供电的ME驱动器，并连接终端。测试物品的存取操作。"
		""
		"驱动器需要单元来存放物品。在网络运行前请保留旧箱子，移动已填充的驱动器时要小心。"
	]
	quest.6EC3A70000001007.title: "没有箱子的记忆"
	quest.6EC3A70000001008.quest_desc: [
		"将终端连接到你的ME网络。合成终端使用已存储的物品添加合成网格；自动化合成需要完成下一个任务的设置。"
		""
		"使用存储总线或导入系统连接旧箱子时，测试一下小范围传输。"
	]
	quest.6EC3A70000001008.title: "触摸数字丹田 (Touch the Digital Dantian)"
	quest.6EC3A70000001009.quest_desc: [
		"使用模式编码终端来编码一个合成配方。将模式放入分子组装器旁的模式提供器中，并添加带有合成存储的合成CPU。从终端请求结果。"
		""
		"机器配方则编码处理模式，将机器输出返回ME网络。分子组装器处理合成台配方。"
	]
	quest.6EC3A70000001009.title: "自动化精炼系统"
	quest.6EC3A7000000100B.quest_desc: [
		"在物质凝聚器中安装所需的ME存储组件，并选择奇点输出。投入消耗品或流体直到物质足够；JEI会显示所需组件。"
		""
		"&c冷凝器输入物将被销毁。&r 使用可再生的大宗物资，避免使用稀有材料。将奇点用于空间丹田核心。"
	]
	quest.6EC3A7000000100B.title: "凝聚一个奇点 (Condense a Singularity)"
	quest.6EC3A7000000100C.quest_desc: [
		"为冶金注入器和富集室提供动力。注入器可将物品与注入材料结合；富集室可制造更高效的注入材料。"
		""
		"分别配置物品、注入和输出侧。切换配方前清空不兼容的注入材料。"
	]
	quest.6EC3A7000000100C.title: "机械子午线 (Mechanical Meridians)"
	quest.6EC3A7000000100D.quest_desc: [
		"按顺序制作浸渍、强化和原子合金，每个等级更换浸渍材料。富集原料能更有效地利用浸渍器的储备。"
		""
		"同时制作基础控制电路，并为你的空间丹田核心预留这些组件。"
	]
	quest.6EC3A7000000100D.title: "三层灌注工艺 (Three Layers of Infusion)"
	quest.6EC3A7000000100E.quest_desc: [
		"将源接收器和ME源罐连接到你的已供电ME网络和附近的Ars源生产处。检查源是否正在被存储。"
		""
		"这些装置会传输源能；FE不会变成源能。保持作物和源能链接的供应，以完成下一个任务的充能。"
	]
	quest.6EC3A7000000100E.title: "来源在网络上"
	quest.6EC3A7000000100F.quest_desc: [
		"将1k ME源存储单元完全填满：必须包含100,000源。将其从网络中移除并检查工具提示。"
		""
		"任务和最终的药丸配方都需要完整的单元格。在放入刻印器前，先让任务检测它。"
	]
	quest.6EC3A7000000100F.title: "一个完整的灵性储备库"
	quest.6EC3A70000001010.quest_desc: [
		"按照JEI的指引，将Singularity、Mekanism组件、Greater Ki Crystal和探索草药组合成Spatial Dantian Core。"
		""
		"核心是一种合成材料。用雪莲和填充源细胞来制作你的药丸。"
	]
	quest.6EC3A70000001010.title: "空间丹田核心"
	quest.6EC5A70000001001.quest_desc: ["暮色森林的生物和首领比普通生物更强。"]
	quest.6EC5A70000001001.title: "第一王座：永恒的黄昏"
	quest.6EC5A70000001002.quest_desc: ["远古幻翼总会掉落《山体庇护手册》。"]
	quest.6EC5A70000001002.title: "燃烧的泪水的苦难 (Tribulation of Burning Tears)"
	quest.6EC5A70000001003.quest_desc: ["在极光宫殿中找到雪后女王。"]
	quest.6EC5A70000001003.title: "冰冻王冠的苦难 (Tribulation of the Frozen Crown)"
	quest.6EC5A70000001008.quest_desc: ["击败守门人并使用预言之球，抵达永恒星光。"]
	quest.6EC5A70000001008.title: "第三维度：永恒星光"
	quest.6EC5A70000001009.title: "三恒星周期的种子"
	quest.6EC5A7000000100A.quest_desc: ["星光哥布林会掉落《不灭金身》手册。"]
	quest.6EC5A7000000100A.title: "三大星光守护者"
	quest.6EC5A7000000100B.quest_desc: ["在高级宝箱中寻找雷鸣之心高丽参。"]
	quest.6EC5A7000000100B.title: "一件蓝色宝藏"
	quest.6EC5A7000000100C.title: "终极配方合成台"
	quest.6EC5A7000000100D.title: "三大领域的交汇之处"
	quest.6EC6101600001001.quest_desc: [
		"量子压缩机的可选批量替代方案（第6章）。合成控制器，然后在JEI中打开其5x5x4结构的页面。"
		"三个 Ludicrous Input Bus 可容纳 3 x 32 x 64 = 6,144 个物品。向它们提供 5,000 个匹配的物品：2,048 + 2,048 + 904 是一种有效分配。将自动化连接到所有三个总线。"
		"一批可产生一个奇点，产率为 200,000 FE/t，持续 600 次游戏循环。终极催化剂用于制作控制器，每批不消耗。"
		"皇冠可替换中心屋顶外壳，以获得2x/4x/8x的速度，FE/t不变。旧的压缩机配方仍然可用，包括更便宜的512晶体的Living Meridian配方。"
	]
	quest.6EC6101600001001.title: "奇点压缩室"
	quest.6EC6A70000001002.quest_desc: [
		"在高级蜂箱中，使用 Yin 蜜蜂获取 Frost Comb，使用 Yang 蜜蜂获取 Flame Comb。Yin 蜜蜂为 Frost Lily 授粉；Yang 蜜蜂为 Fire Lily 授粉。"
		""
		"霜百合：两个蓝冰、两个水精华和一个更高级的元气水晶。"
		""
		"火莲：两根烈焰棒、两份火精和一颗大元晶。"
		""
		"JEI 会显示 3×3 的图案。"
		""
		"保持种植的百合可被访问，或将百合物品放入喂食板。模拟升级使用喂食板的正常位置作为蜂巢。百合可重复使用。"
		"{@pagebreak}"
		"&6批量生产计划&r"
		""
		"64齿梳的目标只是第一批。每个阴阳奇点需要5000个匹配的梳子。在制作全套之前，先建立好两个农场。"
		""
		"JEI 的开花页面会显示每种蜜蜂对应的正确百合。源宝石块不是它们的授粉目标。"
	]
	quest.6EC6A70000001002.title: "霜与火焰的梳子"
	quest.6EC6A70000001003.quest_desc: [
		"为量子压缩机提供FE、配方催化剂和正确的梳子。它会累积奇点配方所需的输入数量。"
		""
		"在JEI中使用Yin Frost和Yang Flame页面。保持它们的批次分开，以免错误输入导致机器停滞。可选的Singularity Compression Chamber通过三个Ludicrous Input Bus处理完整的5000物品批次；参见其附近的任务。"
	]
	quest.6EC6A70000001003.title: "量子压缩"
	quest.6EC6A70000001004.quest_desc: [
		"制作九个 Yin Frost 和九个 Yang Flame Singularities。每个需要 5,000 个梳子，共需 45,000 个 Frost Combs 和 45,000 个 Flame Combs。"
		""
		"奇点共享物品ID，但存储类型不同。查看工具提示，并在合成方块前让两个任务都检测到它们。"
	]
	quest.6EC6A70000001004.title: "十八个奇点"
	quest.6EC6A70000001005.quest_desc: [
		"合成九个匹配的奇点，制成一个 Yin Frost Singularity Block，然后对 Yang Flame 重复此操作。将独立的流体提取器朝向每个方块放置。"
		""
		"提取会逐渐消耗方块。继续制作梳子和奇点以进行替换。"
	]
	quest.6EC6A70000001005.title: "双奇点方块"
	quest.6EC6A70000001006.quest_desc: [
		"将每个流体提取器朝向对应的奇点方块，并将精华导入单独的储罐。在自动化替换方块前，请先测试方向。"
		""
		"将阴阳流体保持在不同的行上，并在它们耗尽时替换方块。"
	]
	quest.6EC6A70000001006.title: "吸取两种精华（Siphon the Two Essences）"
	quest.6EC6A70000001008.quest_desc: [
		"使用Industrial Foregoing的Dissolution Chamber处理Ki Essence。提供FE，将原始精粹导入其流体储罐，并添加配方所需的固体材料。"
		""
		"从霜变为焰前，清空不兼容的流体。这些配方使用原始阴阳精华，而非物品栏中的液态元气或桶。"
	]
	quest.6EC6A70000001008.title: "Ki Essence Processing Unit"
	quest.6EC6A70000001009.quest_desc: [
		"运行溶解室的两个配方：阴液生成固化霜精；阳液生成固化火精。"
		""
		"每种收集八个。另外留一些用于调和的灵魂颗粒和平衡配方。"
	]
	quest.6EC6A70000001009.title: "凝结霜火，铸就永恒"
	quest.6EC6A7000000100A.quest_desc: [
		"在主世界制作一个时间为 12000 的冷冻时钟。在野木林，将野木之心投入领域火焰，并用该时钟激活以抵达阿帕拉契亚。"
		""
		"建立返回路线，收集阿帕拉契亚宝石的碎片。训练好的阿帕拉契亚数据模型可以提供可重复的碎片供应。"
	]
	quest.6EC6A7000000100A.title: "阿巴拉契亚裂谷"
	quest.6EC6A7000000100B.quest_desc: [
		"在阿帕拉契亚找到并击败永恒射手。收集其永恒射手雕像和阿帕拉契亚双性灵药；两者均为独立任务目标。"
		""
		"该药水会在击败首领后，与常规战利品和 Azure Aging Catalyst 一同掉落。请保存它以平衡阴阳。"
	]
	quest.6EC6A7000000100B.title: "击败永恒弓箭手（Eternal Archer）"
	quest.6EC6A7000000100C.quest_desc: [
		"将两种精粹分支与阿巴拉契亚首领材料结合，制作平衡阴阳精粹，请参照JEI。"
		""
		"在花费额外资源购买可选冷凝器之前，先存够突破所需的资源。"
	]
	quest.6EC6A7000000100C.title: "平衡阴阳 (Balance Yin and Yang)"
	quest.6EC6A7000000100D.quest_desc: [
		"用你平衡的材料和药瓶外壳制作两个阴阳突破催化剂。两者都保留用于检测。"
		""
		"最终的IFEU Infuser配方需要同时消耗两者；催化剂本身无法被吃掉以实现突破。"
	]
	quest.6EC6A7000000100D.title: "封印突破催化剂（Seal the Breakthrough Catalysts）"
	quest.6EC6A7000000100E.quest_desc: [
		"在末地用工业前序的流体激光底座和龙之激光透镜收集液态龙之息。将其管道连接到IFEU注入器。"
		""
		"所请求的机器是 Industrial Foregoing: Extra Upgrades 的 Infuser。Bottled Dragon's Breath 无法替代液体。"
	]
	quest.6EC6A7000000100E.title: "采集龙之气息（Dragon Breath）"
	quest.6EC6A70000001109.quest_desc: [
		"这些可选的 Tier III 速度和效率升级需要使用你的双性材料。将它们安装在兼容机器的升级槽中，然后检查其 Ki 需求。"
		""
		"Ki Vaults 没有升级槽位；请通过更高等级或 vault bank 来增加存储容量。"
	]
	quest.6EC6A70000001109.title: "Duality-Tuned Tier III 升级组件"
	quest.6EC6B70000001001.quest_desc: [
		"用复制种子、星界经锭、灵魂丝绸和紫水晶制作至少四个中空的经线容器。"
		""
		"这些是可消耗物品组件，不是流体容器。IFEU Infuser 会用液态 Ki 将其饱和。"
		""
		"每种船现在都需要一个来自 Woot 生产链的 Unobtainium Ingot。"
	]
	quest.6EC6B70000001001.title: "用于承载生命之气的容器"
	quest.6EC6B70000001002.quest_desc: [
		"在 IFEU Infuser 中，将每个 Hollow Meridian Vessel 与 1,000 mB Liquid Ki 结合。在花费之前收集四个 Ki-Saturated Vessels。"
		""
		"使用你之前制作的 Ki Liquefier 来获取第一批物资。可选的 Heaven-Earth Ki Condenser 并非必需。"
	]
	quest.6EC6B70000001002.title: "使子午线容器饱和"
	quest.6EC6B70000001003.quest_desc: [
		"用饱和的Ki容器和两种固化精粹合成调和的灵魂颗粒。每次合成可得两颗，共需收集八颗。"
		""
		"下一步是在 IFEU Infuser 中制作 Dragon-Tempered Pill Shells。多余的颗粒可以为冷凝器后续的高产量配方提供燃料。"
	]
	quest.6EC6B70000001003.title: "和谐于一粒药丸之中"
	quest.6EC6B70000001004.quest_desc: [
		"你可以在第4章建造这台机器。在扩展基础合成台制作外壳，然后用合成核心和八个基座组装其编码控制器。按照控制器上的JEI结构来操作。"
		""
		"从一个低级气晶、一桶水和2000FE/t开始：五秒可产生四桶液态气。晶体将被消耗。安装两个加固或更高级的能量输入、一个物品输入、一个流体输入和所需的真空流体输出舱门。"
		""
		"将输出排入储罐，供给你的绯红子午熔炉。旧液化器在建造期间仍有用。高级/至尊晶体和调和颗粒的配方仍是更高功率的升级项；切换前请检查其FE/t。"
	]
	quest.6EC6B70000001004.title: "天地元气凝聚器"
	quest.6EC6B70000001005.quest_desc: [
		"在IFEU Infuser中，将每个Harmonized Spirit Pellet与500 mB Liquid Dragon Breath融合。八个外壳需要八个颗粒和4,000 mB液体。"
		""
		"更改配方前，先排空剩余的液态Ki。外壳可用作催化剂，请勿用瓶装龙之息代替。"
	]
	quest.6EC6B70000001005.title: "龙之淬炼药瓶外壳"
	quest.6EC6D70000001001.quest_desc: [
		"合成空白物质蓝图，然后使用 Meridian Seed 编码配方。它会生成一个完全编码的蓝图，而不是种子。在转移前，让任务检测到它。"
		""
		"将芯片存储、物质储罐、复制器和复制终端连接到同一个工作网络。用编码蓝图右键单击芯片存储，然后从终端请求实体化的梅里迪亚姆种子。无需扫描种子。"
		""
		"&6每种子：1,920 物质&r"
		""
		"量子 384 · 珍贵 768 · 生命 512 · 末影 256。"
	]
	quest.6EC6D70000001001.title: "复制一个梅里迪亚恩种子"
	quest.6F66841AFB6D806E.quest_desc: ["在终极9×9工作台里制作四个未写道的种子。它们是加速器粒子碰撞配方所需的材料，并非作物。"]
	quest.6F66841AFB6D806E.title: "准备未写就的道（Unwritten Dao）"
	quest.70AF4B78394B217B.quest_desc: [
		"在所需的大型合成网格中制作两个 Evolved Meridian Lattices，并让任务检测到两者。"
		""
		"一个用于虚空淬炼丹田，另一个为后续进阶预留。"
	]
	quest.70AF4B78394B217B.title: "组装两个进化后的子午线晶格"
	quest.71483431FCDD4A30.quest_desc: ["使用JEI的大配方表制作三个Samsara Seals。在后续组件中使用前，让任务检测到全部三个。"]
	quest.71483431FCDD4A30.title: "关闭三度轮回封印 (Close the Three Samsara Seals)"
	quest.715BDCF5A629D5A5.quest_desc: [
		"遵循 Immortal Body Crucible 的 JEI 结构。两种流体输入和两种能量输入位于后墙。使用单独的真空流体输入口或更大的输入口用于 Liquid Ki 和 Ancestral Dragon Blood。至少安装一个 Divine Energy Input Hatch 以提供 18,000,000 FE/t。"
		""
		"使用神圣身体胚胎和辅助材料运行神体配方。"
	]
	quest.715BDCF5A629D5A5.title: "不朽之躯的熔炉 Immortal Body Crucible"
	quest.718671B2E5A114D5.quest_desc: ["用 Powah's Orb 为 1 个 String 注入 25,000 FE 以制作 1 个蜘蛛丝。Spirit Loom 将其转化为 Spirit Silk 用于锻造链。"]
	quest.73CEA5EF16C34B87.quest_desc: [
		"通过龙之融合工艺制作八个天劫符文。在JEI中匹配所需的注入器等级和材料。"
		""
		"在将其投入 Dao Heart 链之前，先收集好这一批。"
	]
	quest.73CEA5EF16C34B87.title: "封印八重天劫（Seal Eight Celestial Tribulations）"
	quest.7624CE6C62E668EF.quest_desc: [
		"收集88个不朽骨壳以制作不朽之躯熔炉。并为控制器预留额外材料。"
		""
		"完成所有需要的配方后，清空机器，并根据需要回收外壳用于最后的祭坛。"
	]
	quest.7624CE6C62E668EF.title: "不朽的骨制外壳"
	quest.78934EFD0E2EBFFD.quest_desc: [
		"安装 Artisan Relic 后，在灵魂之火 Clibano 中唤醒九个 Eternal Embers。然后制作一个 Loot Fabricator。"
		""
		"给 Fabricator 一个成功的预测和 FE，并选择一个兼容的战利品输出。预测来自 Simulation Chamber；Fabricator 将其转换为战利品。"
	]
	quest.78934EFD0E2EBFFD.title: "唤醒九颗永恒的余烬"
	quest.79216222DFFF1F89.quest_desc: [
		"使用 Oritech's Oracle Index 指南，组装一个带动力马达和粒子收集器的环形粒子加速器。任务方块仅是完整布局的一部分。"
		""
		"在加载你的 Unwritten Dao Seeds 之前，请确认戒指已形成并能正常工作。"
	]
	quest.79216222DFFF1F89.title: "建造环形粒子加速器"
	quest.7B61CF18D0962BE2.quest_desc: [
		"按照维度进度顺序，收集下面展示的八种不同的暮色森林奖杯。"
		""
		"在任务登记前保留它们，然后为暮光主权者徽章预留所需的奖杯。"
	]
	quest.7C64CAAC40C3E127.quest_desc: [
		"设置 Malum Spirit Altar 及其用于棱镜链的配料容器。"
		""
		"用艾草灰、炼金钙、纯盐和奥术晶尘合成灵魂淬炼盐。每次合成可得四份盐；为棱镜和后续精炼保留储备。"
	]
	quest.7C64CAAC40C3E127.title: "调和灵魂之盐（Temper the Soul Salts）"
	quest.7D828CD8BCC10919.quest_desc: [
		"制作编码的 Mortum Soul Resonator 控制器，并按照 JEI 中的完整结构放置，包括内部方块和舱门。"
		""
		"通过输入总线提供物品，通过流体舱口提供液态Ki，通过能量舱口提供FE。将舱口容量和电源与所选配方匹配。"
	]
	quest.7D828CD8BCC10919.title: "建造莫塔姆灵魂共振器"
	quest.7E9856524E1B288C.quest_desc: [
		"在充能的 Energizing Orb 中，将两个 Jadeleaf Herbs、一个 Poisonous Vine 和两个 Nether Quartz 组合。提供 500,000 FE 可制作一个 Venom-Charged Spirit Jade。"
		""
		"一次处理一批，把玉留给金银花。"
	]
	quest.7EC1A70000001011.quest_desc: [
		"用 Ex Deorum Crook 敲碎树叶找 Silkworm。用 Silkworm 感染树叶，等蔓延后，再用 Crook 收割感染过的树叶获取 String。"
		""
		"保留一些未受感染的树木来获取木材和树苗。用线来制作你的第一个筛网。"
		""
		"Crooks、Ex Deorum 锤子、压缩锤子和 Construction Sticks 在耐久度为1时会停止工作而非损坏。使用其对应材料在合成台或砧板上修复，每种材料可恢复25%的耐久度。木制 Crooks 接受木棍或木板，骨制 Crooks 使用骨头，木制锤子使用木板。名称和附魔会保留。"
	]
	quest.7EC1A70000001011.title: "Silkworms and String"
	quest.7EC1A70000001012.quest_desc: [
		"用树叶填满橡木坩埚，等待一桶水。重复此操作，填满2×2洞穴的两个对角，即可得到无限水池。"
		""
		"为黏土、瓷质坩埚以及你的作物节约用水。"
	]
	quest.7EC1A70000001012.title: "来自树叶的水"
	quest.7EC1A70000001013.quest_desc: [
		"在热发电机下方放置有效的热源，供应水，并将能量电缆连接到机器上。检查是否正在产生FE。"
		""
		"有液态奇时，它是更强的热源，但你也可以从更简单的热源开始。"
	]
	quest.7EC1A70000001013.title: "利用地热能源发电"
	quest.7EC1A70000001014.quest_desc: [
		"将能量棒放置在能量球附近，并为能量棒提供FE。将一份配方所需的材料放入能量球中。"
		""
		"等配方完成并移除产物后再加入下一批。更多能量棒或更好的棒能更快地为球体充能。"
	]
	quest.7EC1A70000001014.title: "能量激光束"
	quest.7EC1A70000001015.quest_desc: [
		"在 Powah's Orb 中为 Niotic Crystal 配方充能。动力棒必须提供 JEI 中显示的完整 FE 成本；进度缓慢通常意味着需要更多电力。"
		""
		"为 Martial Warrior 药丸保存两个 Niotic Crystals。"
	]
	quest.7EC1A70000001015.title: "Niotic Crystals"
	quest.7EC1A70000001016.quest_desc: [
		"右键坐垫坐下，然后从“修行”菜单开始冥想。潜行可起身。"
		""
		"坐姿耕作进度加快15%，可与Aether加成叠加。将坐垫放在安全处，仅站在旁边并无加成。"
	]
	quest.7EC1A70000001016.title: "种植坐垫 Cultivation Cushion"
	quest.7EC2A7000000100B.quest_desc: [
		"探索完伊甸园后，进入艾西卡。在搜寻其定居点、作坊和地下墓穴前，标记好到达点并确保返回路线。"
		""
		"注意搜寻雪片和自定义的毒魂花，两者都是本章必需品。"
	]
	quest.7EC2A7000000100B.title: "进入艾西卡（Iceika）"
	quest.7EC2A7000000100C.quest_desc: [
		"收集九个冰碎片和来自Iceika的一片雪花，并熔炼一个氧化铜锭用于制作冰冻时钟链。"
		""
		"你也可以用3000点源力，将紫水晶碎片与水精华、空气精华、压实冰和雪块结合，制作出三个冰碎片。三组材料可产出一块冰石。"
	]
	quest.7EC2A7000000100C.title: "冰冻王国的宝藏"
	quest.7EC2A7000000100D.quest_desc: [
		"冰冻时钟会记录它被制作时的时间。要制作一个，请在正确的时间将普通时钟投入主世界的冰火中。旅行前请阅读其工具提示。"
		""
		"伊甸需要6000时间。此整合包还有正午时钟的合成配方：一个时钟和四个冰碎片。在末地将其用于神圣火焰上。"
		""
		"裂隙是临时的。在探索前，请携带并激活一块路石，或建立一个永久领域传送门。"
		"{@pagebreak}"
		"&6后期王国的时钟&r"
		""
		"在主世界制作每个时钟，然后在之前的维度中使用。将该维度的核心投入神圣火焰中进行转化，然后再使用时钟。"
		""
		"Wildwood: 时间 9000; 伊甸之心在伊甸。"
		""
		"阿帕拉契亚：时间 12000；野木之心在野木中。"
		""
		"Skythern: 时间 15000; 阿帕拉契亚之心位于阿帕拉契亚。"
		""
		"Mortum: 时间 18000; Skythern 之心在 Skythern 中。"
		""
		"这些后来的旅程属于后面的章节。随机的冷冻时钟不会开启每个裂隙。"
	]
	quest.7EC2A7000000100D.title: "冰封时钟与神圣RPG裂隙之路"
	quest.7EC2A7000000100E.quest_desc: [
		"制作编码的伊甸源祭坛控制器，然后按照 JEI 中的逐层结构预览来放置。将列出的物品总线和阿斯源输入口放在标记的位置上。"
		""
		"完整的四层祭坛需要24个Meridian Glass和39个Eden Planks，外加各一个控制器、魔法工作台、物品输入总线、物品输出总线和一个源输入舱门。中间两层各有12个玻璃块。"
		""
		"将物品通过输入总线送入，源通过源舱口送入；FE线缆无法提供源。保持输出总线畅通，让你的源农场持续运行。"
		""
		"收集任务涵盖整个建造过程。组装完成后勾选复选框，控制器会提示结构已建成。"
	]
	quest.7EC2A7000000100E.title: "建造伊甸之源祭坛"
	quest.7EC2A7000000100F.quest_desc: [
		"制作编码的 Ki Liquefier 控制器，并按照其 JEI 结构预览来放置输入、输出和能量接口。空白控制器不计入有效。"
		""
		"通过物品输入提供晶体配方，并从流体输出中收集液态Ki。这是一种机器流体，与你的个人Ki条分开。"
	]
	quest.7EC2A7000000100F.title: "液化结晶化元气 (Liquefy Crystallized Ki)"
	quest.7EC3A70000001011.quest_desc: [
		"击败潜卫，获取深海之心。在主世界，用加固深板岩建造一个4×5的垂直框架，中间留出2×3的空洞。用深海之心右键框架内侧边缘即可激活，使用后深海之心将被消耗。"
		""
		"在失落城市下方的深暗之地探索一座远古都市。如果你想要自己建造框架，整合包还在JEI中提供了加固深板岩的配方。"
	]
	quest.7EC3A70000001011.title: "让潜行者安静下来，锻造传送门"
	quest.7EC3A70000001012.quest_desc: ["通过已激活的传送门进入异世界，并标记返回路线。寻找冰百合和百合花以获取雪莲配方。"]
	quest.7EC3A70000001012.title: "深入幽暗黑暗"
	quest.7EC3A70000001013.quest_desc: [
		"用JEI中显示的异界之花合成雪莲，并留一个用于最终的刻印师配方。"
		""
		"食用可恢复100点Ki，但会消耗花朵并造成一分钟的霜冻。如需用于恢复，请制作一个备用。"
	]
	quest.7EC3A70000001013.title: "雪莲花"
	quest.7EC5A70000001501.title: "锻造机器子午线（Forge the Machine Meridian）"
	quest.7EC5A70000001502.title: "让液态奇能转动齿轮"
	quest.7EC5A70000001503.quest_desc: ["水晶接口既可以填充也可以排空水库。"]
	quest.7EC5A70000001503.title: "子午线水库"
	quest.7EC5A70000001504.quest_desc: ["使用同一频道：Ki源旁的INPUT，接收机器旁的OUTPUT。至尊接口可跨维度工作。"]
	quest.7EC5A70000001504.title: "用晶体代替线缆 (Crystals Instead of Cables)"
	quest.7EC5A70000001505.quest_desc: ["无需燃料即可运行；在其他维度中，尤其是永恒星光中，产出会提高。"]
	quest.7EC5A70000001505.title: "饮用天堂之水"
	quest.7EC5A70000001506.quest_desc: ["在GUI的右侧插槽中安装升级。仅生效最强的速度加成。"]
	quest.7EC5A70000001506.title: "精炼阵型"
	quest.7EC6101600001001.quest_desc: [
		"第七章后期奢侈品：在达到 Skythern Ascension Core 后，用 9x9 终极工作台制作 Infinite Data Cell。"
		"组合四个 256M 数据存储组件、24 个 Skythern 星钢块、四个反物质药丸、四个九重丹田框架、20 个光辉合金、16 个天体经脉矩阵、四个复制星格、四个 Skythern 升天核心和一个数据流组件外壳。"
		"使用存储组件，而非填充单元格。先建立有限的数据流；在拥有此单元格前，所有材料都可在第8章前制作完成。"
		"合成的单元可提供无限的数据流、数据和回响，并已预先稳定，可防止初次获取时的过载。这是一个可选分支，并非突破要求。"
	]
	quest.7EC6101600001001.title: "无限的数据，有限的准备"
	quest.7EC7A70000001001.quest_desc: [
		"在主世界，于15000时将一个时钟投入冰火。检查其存储的时间，然后带上它和一块路石前往阿帕拉契亚。"
		""
		"将阿帕拉契亚之心投入那里的火焰以创造天空之火。用冰冻时钟右键点击该火焰以打开临时的斯凯瑟恩裂隙。"
	]
	quest.7EC7A70000001001.title: "打开 Skythern 裂隙 - 时间 15000"
	quest.7EC7A70000001002.quest_desc: [
		"进入 Skythern 并设立返回点。收集 Starsteel 的碎片，并为在 Ascension Core 中使用的灵魂准备与 Samek 的战斗。"
		""
		"保持对早期领域的访问权限；它们的材料仍然是本章配方的原料。"
	]
	quest.7EC7A70000001002.title: "进入 Skythern 的世界"
	quest.7EC7A70000001003.quest_desc: [
		"收集 Skythern 碎片并合成 Skythern 宝石。在将它们用于材料链之前，请先让这两个任务都检测到。"
		""
		"如需可持续供应，请训练一个 Skythern Archer 数据模型，在模拟室中运行，然后在战利品制造器中使用其成功预测。每次制造可获得 16 个 Skythern 碎片。"
	]
	quest.7EC7A70000001003.title: "天空王国的材料"
	quest.7EC7A70000001004.quest_desc: [
		"击败 Samek 并收集 Skythern 灵魂。击杀和物品任务都必须完成，仅借用灵魂是不够的。"
		""
		"将灵魂用于 Skythern 飞升核心。"
	]
	quest.7EC7A70000001004.title: "击败 Samek"
	quest.7EC7A70000001005.quest_desc: [
		"建造并启动反质子核合成器。通过Mekanism的SPS生产链，向其化学输入端供应反物质。"
		""
		"插入升天核心前，请先检查配方所需的能量。请遵循Mekanism的指南进行反应堆冷却和放射性废物处理。"
	]
	quest.7EC7A70000001005.title: "反物质核合成 (Antimatter Nucleosynthesis)"
	quest.7EC7A70000001006.quest_desc: [
		"将1个休眠合成丹田核心与Skythern材料在所需的扩展合成台中进行组合。"
		""
		"将生成的升天核心放入反质子核合成器以制作药丸。将第二个休眠核心留在储存处。"
	]
	quest.7EC7A70000001006.title: "Skythern 飞升核心"
	quest.7EC7A70000001010.quest_desc: [
		"建造化学溶解室、化学洗涤器、化学结晶器和加压反应室。前三种处理共振浆料；PRC使成品晶体活化。"
		""
		"使用化学运输管输送浆料和气体，流体管道输送水，电力电缆输送FE。配置每一侧并为每种副产品提供输出空间。"
	]
	quest.7EC7A70000001010.title: "建造共振线路"
	quest.7EC7A70000001011.quest_desc: [
		"用硫酸溶解回响碎片，制成原始共振浆液。用水清洗，然后将纯净共振浆液结晶化为子午线晶体。"
		""
		"保持原浆和清洁浆液分离。只有清洗过的浆液才能放入结晶器。"
	]
	quest.7EC7A70000001011.title: "将人工子午线结晶化"
	quest.7EC7A70000001012.quest_desc: [
		"将 Meridian Crystal、Water 和 Ethene 放入 Pressurized Reaction Chamber。它会产出 Living Meridian Crystal 和 Oxygen；为这两种产物提供去处。"
		""
		"将活晶氧化为气态蒸汽，在化学注入器中与钋结合，然后在旋转冷凝器中凝结稳定的气态蒸汽。"
		""
		"Polonium 通过化学输入，而非物品栏。最终的单向转换比例为 1:1，并输出流体。"
	]
	quest.7EC7A70000001012.title: "教会水晶生命的力量"
	quest.7EC7A70000001014.quest_desc: [
		"制作 Osmium Dantian、Refined Obsidian Dantian 和 Living Meridian 奇点。第 6 章奇点压缩室每个奇点需要 5,000 个匹配物品。原版量子压缩器配方仍可用；其 Living Meridian 配方更便宜，仅需 512 个晶体。在 JEI 中匹配命名变体。"
		""
		"在尝试那个奇点之前，先自动化生产活体子午线水晶；演示批次仅仅是个开始。"
	]
	quest.7EC7A70000001014.title: "三个工业奇点 (Three Industrial Singularities)"
	quest.7EC7A70000001015.quest_desc: [
		"在 JEI 所示的表格中，使用工业奇点和框架合成两个休眠合成丹田核心。让任务检测到两者。"
		""
		"一个用于 Skythern 飞升核心，另一个留给第八章。"
	]
	quest.7EC7A70000001015.title: "双生休眠丹田 (Twin Dormant Dantians)"
	quest.7EC7A70000001020.quest_desc: [
		"制作编码的天体经线编织器控制器，并按照 JEI 结构中的每一层进行搭建。匹配其物品总线、流体舱门、能量输入和内部方块。"
		""
		"&e使用 Celestial 或 Divine Energy Input Hatch。标准等级，包括 Ultimate，无法提供这些配方。&r填满两个能量输入位置，并将电源连接到自定义舱门。"
		""
		"配方消耗 2,000,000–3,000,000 FE/秒。请检查所选配方与你的熔炉、线缆及可用能量是否匹配。物品和流体通过各自的端口进入，而非控制器。"
	]
	quest.7EC7A70000001020.title: "天体子午线编织者"
	quest.7EC7A70000001021.quest_desc: [
		"在 Celestial Meridian Weaver 中使用物品和 Spirit Meridian Essence 运行 Starsteel 配方。每批产出两个锭，因此需要四批来完成此任务。"
		""
		"为大型配方所需的星钢块多做一些。每个方块需要九个锭。"
	]
	quest.7EC7A70000001021.title: "编织天空织者星钢"
	quest.7EC7A70000001022.quest_desc: [
		"使用Liquid Ki及其所列物品的织工线配方。四批可生产出所需的十六条天织经脉线。"
		""
		"此配方使用液态奇，而非制作星钢所用的精神经脉精华。"
	]
	quest.7EC7A70000001022.title: "天堂编织的经线 (Heavenwoven Meridians)"
	quest.7EC7A70000001023.quest_desc: [
		"在天界经络编织器中生产两个九重丹田框架。使用复制和重组生产线制造的星界晶格和天界经络矩阵。"
		""
		"每个框架都属于一个休眠的合成丹田核心。"
	]
	quest.7EC7A70000001023.title: "九重丹田框架"
	quest.7EC7B70000001001.quest_desc: [
		"使用 IFEU Infuser 将 Ki-Saturated Vessel 与 1,000 mB Spirit Meridian Essence 结合。重复四次以完成此任务。"
		""
		"Living Spirit Reservoirs 是合成组件，不是存储方块。请使用浓缩精粹流体，而非稳定化气化学物质。"
	]
	quest.7EC7B70000001001.title: "唤醒灵魂水库 (Awaken the Spirit Reservoir)"
	quest.7EC7D70000001001.quest_desc: [
		"在高级5×5工作台里制作编码的天体晶格蓝图，等待任务检测到它。用蓝图右键单击芯片存储，然后从复制终端请求四个实体晶格。"
		""
		"每个晶格需要 15,360 物质：3,072 量子、6,144 珍贵、4,096 生命和 2,048 末影。为此任务准备四倍的量。无需扫描样本。"
	]
	quest.7EC7D70000001001.title: "复制星界晶格 (Replicate the Astral Lattice)"
	quest.7EC7DF0000001001.quest_desc: [
		"将带电的数据提取器、数据流存储单元和数据重组器连接到同一个在线ME网络。向提取器提供其JEI配方类别中的材料以生成数据流。"
		""
		"使用重组器前请检查存储量。数据流是独立资源，普通物品存储字节、FE和液态Ki无法替代。"
	]
	quest.7EC7DF0000001001.title: "流动的生命数据之流"
	quest.7EC7DF0000001002.quest_desc: [
		"在数据重组器中，使用所列物品和来自ME网络的数据流制作四个天体子午线矩阵。将它们预留用于九重丹田框架。"
		""
		"将此编码为 Reassembler 的加工配方，而非 Molecular Assembler 的合成配方。"
	]
	quest.7EC7DF0000001002.title: "天体子午线矩阵"
	quest.7EC8D70000001001.quest_desc: [
		"在精英 7×7 工作台里制作编码的虚空曼陀罗蓝图。等任务检测到它，将其转移到芯片存储，然后从复制终端请求曼陀罗。"
		""
		"一个曼陀罗需要 61,440 物质：12,288 量子、24,576 珍贵、16,384 生命和 8,192 末影。每种物质都必须可用，其他类型的多余物质不能替代。"
	]
	quest.7EC8D70000001001.title: "复制虚空曼陀罗图案"
	quest.7EC9D70000001001.quest_desc: [
		"在精英7×7工作台里，用虚空曼陀罗和龙心材料合成编码的祖先基因组蓝图。检测后，将其转移到芯片存储中并复制四个基因组。"
		""
		"每种需要 245,760 物质：49,152 量子、98,304 珍贵、65,536 生命和 32,768 末影。完整任务需乘以四。"
	]
	quest.7EC9D70000001001.title: "重构祖先基因组 (Reconstruct the Ancestral Genome)"
	quest.7EC9D71100001001.quest_desc: [
		"在所需的大型工作台里制作编码的 Sovereign Mandate 蓝图。检测后，将其转移到 Chip Storage 并请求实体的 Mandate。"
		""
		"需要 983,040 物质：196,608 量子、393,216 珍贵、262,144 生命和 131,072 末影。为每种物质连接足够的存储到同一个复制网络。"
	]
	quest.7EC9D71100001001.title: "复制主权者的旨意"
	quest.7EC9D71100001002.quest_desc: [
		"使用其祖先材料、32,000 mB 祖先龙血，运行 Primordial Regenerator's Awakened Dragon Marrow 配方。"
		""
		"一次操作可获得两种骨髓。两者都留给武尊丹。"
	]
	quest.7EC9D71100001002.title: "唤醒龙之骨髓 (Awaken the Dragon Marrow)"
	quest.7ECAD70000001001.quest_desc: [
		"与你的教派大师完成四项守护者契约。将天兽、凤凰、潮汐和玄武印记合成为创世道蓝图中心的四守护者封印。狩猎最多需要武尊。"
		""
		"在终极9×9工作台合成编码蓝图，等待任务检测到它，然后将其转移到芯片存储。复制四个创世道，用于制作最终药丸。"
		""
		"每种需要 7,864,320 物质：量子、珍贵、生命、末地和金属各需 1,572,864。储备四倍的量，并确保有足够的相连储罐容量。"
	]
	quest.7ECAD70000001001.title: "复制创造法则 (Replicate the Laws of Creation)"
	quest.7ED69205B4576644.quest_desc: [
		"在 Evolved Mekanism Alloyer 中组合 Mortum Evolved Core、Evolved Meridian Lattice 和 Exoversal Alloy。并提供所需的 FE。"
		""
		"将虚空淬炼丹田用于武尊丹，它本身并非突破物品。"
	]
	quest.7ED69205B4576644.title: "在虚空之中淬炼丹田 (Temper the Dantian in the Void)"
	quest.8C08100000000001.quest_desc: [
		"Energizing Orb 现在无需寻找矿石即可制作 Allthemodium。用 250,000 FE 为两个金锭、一个下界合金锭、Hallowed Gold、一个 Greater Ki Crystal 和一个 Eden Fragment 充能。你将得到两个锭。"
		""
		"在基础工作台使用一个锭制作16个天地冷凝器外壳。三批材料可制作结构所需的38个外壳，控制器配方需要4个。"
		""
		"后面的方块式 Orb 配方能一次性产出 18 个锭。节省的是操作时间，不是金或下界合金。"
	]
	quest.8C08100000000001.title: "第一条黄金子午线"
	quest.8C08100000000002.quest_desc: [
		"在末地制造台里用 Allthemodium、末地锭、星光钻石和至尊 Ki 水晶制作振金。在制造台周围放置末地转换器以加速制作。"
		""
		"配方可制作两个锭。在 Draconic Fusion Crafting 中，每批 Astral Meridian Ingots 需保留一对。你之前发现的 boss 仍然有效。"
	]
	quest.8C08100000000002.title: "一个连接世界之间的维度"
	quest.8C08100000000003.quest_desc: [
		"将振金锭和Woot下界合金碎片放入Woot物品注入器。用四桶附魔流体和1,000,000 FE将其制成一个Unobtainium锭。两种材料均被消耗。"
		""
		"Woot 工厂提供碎片；其附魔液化器用附魔书提供流体。最后一步用物品注入器，不是工厂之心。"
		""
		"Unobtainium 现已成为每个 Hollow Meridian Vessel 的锚点。在将其制成容器前，先合成并收集一个锭。"
	]
	quest.8C08100000000003.title: "在工厂中经受考验的锻造者"
	quest.8C08100000000004.quest_desc: [
		"训练一个具有自我意识的敌对神经网络数据模型。该模型是可重用的选择器：它会保留在输入总线中，保持其训练和名称。每次只能使用一个模型。"
		""
		"每批十秒消耗一个预测矩阵、250 mB液态奇和4,096 FE/t来制造四个Malum灵魂。低阶模型和预测无效。"
		""
		"僵尸：邪恶。骷髅：神秘。史莱姆：土著。守卫者：水生。烈焰人：地狱。恶魂：空中。牛：神圣。末影人：远古。"
		""
		"在Flux Crafter中制作两个Soul Imprint Focus，用FE为附近的Flux Alternator供电。然后用Crafting Core和八个基座制作控制器。"
		""
		"根据JEI预览建造对称的5x5四层腔室。它有一个物品输入、一个物品输出、一个液体Ki输入和两个加固或更高级的能量输入。"
		""
		"第一批灵魂和未精炼的灵魂棱镜仍来自正常的 Malum 玩法。此机器可自动化持续供应，不会取代你的首次发现。"
	]
	quest.8C08100000000004.title: "灵魂印记室"
	quest.8C08100000000005.quest_desc: [
		"Occultism矿工现在可以找到深板岩复制矿石。将绑定矿工放入维度矿井；普通矿石矿工和远古邪灵矿工都有概率带回该矿石。"
		""
		"这是一个不常见的结果，并非每个循环都保证掉落。使用JEI中显示的配方处理矿石，为你的复制机和Meridian Seed蓝图提供材料。"
	]
	quest.8C08100000000005.title: "世界之外的矿石 Ore Beyond the World"
	quest.8C08200000000001.quest_desc: [
		"使用基础工作台将灵魂丝绸编织成神圣金框架。一个配方可制作四个子午线格栅。"
		""
		"每个晶格可在同一张桌子上将八个染色玻璃变成十六个梅里安玻璃。其余的用于地质种子矩阵和生长核心。普通玻璃的配方仍然可用。"
	]
	quest.8C08200000000001.title: "编织一条子午线晶格 Weaving a Meridian Lattice"
	quest.8C08200000000002.quest_desc: [
		"在末地合成台里，将紫水晶、末地锭、两个梅里迪亚恩晶格和一个低级气晶结合。你会得到两个晶洞种子矩阵。"
		""
		"将末地转换器放置在合成台附近以加快其速度。此步骤消耗时间，而非FE。小水晶在此消耗；放置在成品育婴室中的水晶则不会消耗。"
	]
	quest.8C08200000000002.title: "稳定种子（Stabilizing the Seed）"
	quest.8C08200000000003.quest_desc: [
		"将两个种子矩阵、两个晶格、四个红石块和一个更高级的奇晶合成为两个共振生长核心。通过附近的通量转换器提供250,000 FE。"
		""
		"为育婴控制器使用双核心。更多核心能让纹纹合成器每批用4个灵魂丝绸和4个纹纹树脂，消耗2,000,000 FE，产出8个绯红纹纹线。"
		""
		"第5章早期，核心还能在组合合成中启用双透镜配方。仍需Fluix Pearls、Greater Ki Crystals、Astral Weave和Unrefined Spirit Prisms；总能量为8,000,000 FE。原有的Energizing Orb配方依然可用。"
	]
	quest.8C08200000000003.title: "为生长核心进行充能"
	quest.8EC2A70000001011.quest_desc: [
		"在冰原的未开启地牢、小屋、格罗格林村和格鲁兹洛格村中搜寻宝箱。"
		"每个箱子都有独立的6%概率包含一个毒魂花。"
	]
	quest.8EC2A70000001011.title: "毒灵花 (Poison Spirit Bloom)"
	quest.8EC2A70000001012.quest_desc: ["在Aether地牢的宝箱中找到Jadeleaf Herb。"]
	quest.8EC2A70000001012.title: "毒附魔的灵玉"
	quest.8EC2A70000001013.quest_desc: ["任何非投掷型的神圣之水等级均可接受。"]
	quest.8EC2A70000001013.title: "金银花子午线"
	quest.8EC2A70000001014.title: "钢制中子管外壳"
	quest.8EC2A70000001015.title: "高压下的锇元素"
	quest.8EC2A70000001016.quest_desc: ["在净化祭坛上持纯净盐水约16秒。任何派系都能制作普通圣水；强化圣水需要猎人技能。"]
	quest.8EC2A70000001016.title: "净化祭坛 (Altar of Cleansing)"
	quest.8EC4A70000001001.quest_desc: [
		"Wildwood 是 Eden 之后的 DivineRPG 领域。将 Eden Heart 投入 Divine Flame，然后用设置为下午早些时候的 Frozen Clock 右键点击该火焰。这与用于 Eden 的正午时钟校准方式不同。"
		"击败 Sunstorm 并保留其 Wildwood Heart。这样 Artisan Relic 就能在此路径的后续阶段获得了。"
	]
	quest.8EC4A70000001001.title: "第二暮色森林：野木林"
	quest.8EC4A70000001002.quest_desc: ["使用Malum灵魂收割武器给予致命一击以收集灵魂。普通武器无效。"]
	quest.8EC4A70000001002.title: "收割灵魂的武器"
	quest.8EC4A70000001003.title: "灵魂聚集咒语"
	quest.8EC4A70000001004.title: "准备灵魂祭坛"
	quest.8EC4A70000001005.quest_desc: ["净化之魂在第5章的五重灵魂精炼器中解锁。"]
	quest.8EC4A70000001005.title: "净化十四位平衡的灵魂"
	quest.8EC4A70000001006.quest_desc: ["在战斗中训练数据模型。Loot Fabricator 在 Eternal Embers 之后解锁。"]
	quest.8EC4A70000001006.title: "模拟真实世界生态系统模组"
	quest.8EC4A70000001007.title: "三种预测套装"
	quest.8EC4A70000001008.title: "梅里迪安束缚树脂"
	quest.8EC4A70000001009.title: "禁忌的基石"
	quest.8EC4A7000000100A.quest_desc: ["将 Artisan Relic 安装在 Clibano 的增强器插槽中，以开启此进度分支。"]
	quest.8EC4A7000000100A.title: "天堂压缩锻造炉"
	quest.8EC4A7000000100B.title: "建造沉睡的余烬 (Dormant Ember)"
	quest.8EC4A7000000100C.quest_desc: ["需要灵魂之火和已安装的工匠遗物。"]
	quest.8EC4A7000000100C.title: "唤醒九颗永恒的余烬"
	quest.8EC4A7000000100D.title: "将能量线转化为蜘蛛丝"
	quest.8EC4A7000000100E.title: "建造灵魂织布机 (Construct the Spirit Loom)"
	quest.8EC4A7000000100F.quest_desc: ["Spirit Silk 并非 Malum's Soulwoven Silk。"]
	quest.8EC4A7000000100F.title: "编织灵魂丝绸"
	quest.8EC4A70000001010.title: "Forgeheart Core"
	quest.8EC4A70000001011.title: "为末地钢充能"
	quest.8EC4A70000001012.title: "十三种灵钢锭的锻造配方"
	quest.8EC4A70000001013.quest_desc: ["将海之奇丹留在催化剂槽中；它可重复使用。"]
	quest.8EC4A70000001013.title: "建造 Age-er 机器"
	quest.8EC4A70000001014.quest_desc: ["将海之奇丹保持在催化剂槽中；它不会被消耗。"]
	quest.8EC4A70000001014.title: "三年参的三种精华"
	quest.8EC4A70000001015.quest_desc: ["从市场购买艾草以获得可持续的供应。"]
	quest.8EC4A70000001015.title: "艾草化为灰烬"
	quest.8EC4A70000001016.title: "精英部队生成台"
	quest.8EC4A70000001017.title: "古老的怨恨碎片 (The Old Resentful Shard)"
	quest.8EC4A70000001018.title: "绯红砧形成物"
	quest.8EC5A70000001001.quest_desc: ["使用预言之球进入永恒星光。所有生物和首领的生命值和伤害都变为3倍。"]
	quest.8EC5A70000001001.title: "穿过预言之门 (Prophecy Gate)"
	quest.8EC5A70000001002.quest_desc: ["所列的每个首领都保证会掉落一件遗物。"]
	quest.8EC5A70000001002.title: "星光五领主"
	quest.8EC5A70000001003.quest_desc: ["保留首领遗物用于进度配方。"]
	quest.8EC5A70000001003.title: "永恒天空下的遗迹 Relics Beneath an Eternal Sky"
	quest.8EC5A70000001004.quest_desc: ["用星光钻石而不是普通钻石激活暮色森林传送门。"]
	quest.8EC5A70000001004.title: "星光钻石钥匙"
	quest.8EC5A70000001005.quest_desc: ["所有暮色森林的生物和首领的生命值和伤害都增加了3倍。"]
	quest.8EC5A70000001005.title: "进入暮色森林 (Twilight Forest)"
	quest.8EC5A70000001006.title: "八位暮色君主"
	quest.8EC5A70000001007.quest_desc: ["站在Ki水晶培育器上，将你的个人Ki转化为水晶。"]
	quest.8EC5A70000001007.title: "凝聚个人元气 (Condense Personal Ki)"
	quest.8EC5A70000001008.title: "液态奇丹发电机"
	quest.8EC5A70000001009.title: "机械丹田 (A Mechanical Dantian)"
	quest.8EC5A7000000100A.quest_desc: ["至尊水晶接口连接了跨维度的命名频道。"]
	quest.8EC5A7000000100A.title: "水晶子午线网络"
	quest.8EC5A7000000100B.title: "Ki 注入"
	quest.8EC5A7000000100C.title: "锻造更高等级的合金"
	quest.8EC5A7000000100D.title: "天体合金地基"
	quest.8EC5A7000000100E.title: "终极配方合成台"
	quest.8EC5A7000000100F.title: "量子形成记忆"
	quest.8EC8A70000001010.title: "天劫熔炉"
	quest.8EC8A70000001011.quest_desc: ["缓冲物资，确保处理过程中电力不间断。"]
	quest.8EC8A70000001011.title: "储存苦难祭品 (Store the Tribulation Offering)"
	quest.8EC8A70000001012.quest_desc: ["使用第7章中保存的备用休眠合成丹田核心。"]
	quest.8EC8A70000001012.title: "唤醒合成丹田（Awaken the Synthetic Dantian）"
	quest.A2C2A70000001017.title: "怨恨的灵魂碎片"
	quest.A45005E700001001.title: "提升五重灵魂外壳的等级"
	quest.A45005E700001002.title: "组装五重灵魂精炼炉"
	quest.A45005E700001003.quest_desc: ["用Malum灌注制作第一个未精炼的棱镜，以便建造精炼厂。"]
	quest.A45005E700001003.title: "净化灵魂 (Purify the Spirit)"
	quest.A45005E700001004.title: "打开终极阵法 (Ultimate Formation)"
	quest.A45005E700001005.title: "建造一个机械化的丹田"
	quest.A45005E700001006.quest_desc: ["可选的后期紧凑机械分支。先建立全规模的Mekanism生产线。"]
	quest.A45005E700001006.title: "压缩一个工业领域 (Industrial Realm)"
