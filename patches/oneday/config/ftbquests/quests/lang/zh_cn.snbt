	quest.1A4221CF47D0E978.quest_desc: ["一头远古海怪统治着沉没之城。水肺呼吸是必备技能。"]
	quest.1A4221CF47D0E978.title: "利维坦（The Leviathan）"
	quest.1A4CF1F49230DF79.quest_desc: ["将粒子粉碎融合，创造奇异物质。"]
	quest.1A4CF1F49230DF79.title: "粒子加速器"
	quest.1A50D05C6E782DF0.quest_desc: [
		"完成 &eActually Additions&r 中的所有任务，以获得称号 &bAdditions Engineer&r。"
		""
		"头衔会自动提供。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.1A50D05C6E782DF0.quest_subtitle: "实际上附加的模组 (Actually Additions)"
	quest.1A50D05C6E782DF0.title: "附加工程师"
	quest.1A59D35015E0BB3F.quest_desc: ["&7你会如何选择？会后悔自己的选择吗？"]
	quest.1A59D35015E0BB3F.quest_subtitle: "沉睡的力量潜伏在地下……"
	quest.1A8752421E4A205E.quest_desc: ["盛宴以方块形式放置，并用碗盛装——足够整个团队享用。"]
	quest.1A8752421E4A205E.title: "一场盛宴！"
	quest.1A931EE53037648D.quest_desc: ["右键点击可给作物浇水，使其生长得更快。"]
	quest.1A931EE53037648D.title: "浇水壶"
	quest.1A98B02EDA838AA4.quest_desc: ["抽屉可以存放大量同一种物品。"]
	quest.1AB1D1AAF364CFAE.quest_desc: [
		"完成&eBiomes&r中的所有任务，即可获得&bBiome Explorer&r称号。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.1AB1D1AAF364CFAE.quest_subtitle: "生物群系"
	quest.1AB1D1AAF364CFAE.title: "生物群系探索者"
	quest.1ACA01458705876B.quest_desc: ["将其置于火源（火焰、篝火或炉灶）上，即可烹饪汤类和炖菜。"]
	quest.1AFAC8D975420E0B.quest_desc: [
		"弹奏音符方块500次。"
		""
		"你的队友想和你谈谈。"
	]
	quest.1AFAC8D975420E0B.title: "烦人的邻居"
	quest.1B0AAB5228013FA5.quest_desc: [
		"用黄金分散猪灵的注意力。"
		""
		"对你的一些朋友也有效哦。"
	]
	quest.1B0AAB5228013FA5.title: "哦，闪闪发光的东西"
	quest.1B1E0A7CF736BD7F.title: "黄玉锭"
	quest.1B4DEDF05634434D.quest_desc: ["船体、船帆和引擎：你的第一架飞机。速度慢，但它能飞！"]
	quest.1B9DC6CF4187AC98.quest_desc: ["Prosperity Ore 和铁藏在同一个地方。每种种子都需要碎片。"]
	quest.1B9DC6CF4187AC98.title: "Prosperity"
	quest.1BA470767958D731.quest_desc: ["Inferium 种子会生长出更多的 Inferium 精华。等它们完全成熟后再收获。"]
	quest.1BA470767958D731.title: "你的第一批种子"
	quest.1BBA27AFC14A76BF.quest_desc: ["资源种子在融合祭坛上制作：将种子基底放在祭坛上，将材料放在周围的8个基座上，然后用红石激活。"]
	quest.1BBA27AFC14A76BF.title: "灌注祭坛 (The Infusion Altar)"
	quest.1BE3C1A617B591E3.quest_desc: ["自动化觉醒祭坛的功能。"]
	quest.1BE3C1A617B591E3.title: "唤醒的交替器 (Awakening Altarnator)"
	quest.1BF1CC9B89C995AB.quest_desc: ["完成Mekanism章节了吗？这些模组添加了远高于Ultimate的等级。"]
	quest.1BF1CC9B89C995AB.title: "超越极限 (Beyond Ultimate)"
	quest.1C1F3BF4BB45C071.quest_desc: ["制作这个之眼，像末影之眼一样投掷它——它会飞向&6远古工厂&r。"]
	quest.1C1F3BF4BB45C071.title: "找到远古工厂 Ancient Factory"
	quest.1C219C8669A164E0.quest_desc: [
		"欢迎来到 &6Create&r！这里的一切都依靠旋转动力——转轴、齿轮和皮带让机器运转起来。"
		""
		"一切始于&e安山合金&r：安山岩加铁（或锌）粒。"
		""
		"[\"\",{\"text\":\"按住 \"},{\"keybind\":\"key.ponder.ponder\",\"color\":\"gold\"},{\"text\":\" 并将鼠标悬停在任意 Create 物品上，即可观看展示其工作原理的沉思场景。\"}}]"
	]
	quest.1C219C8669A164E0.quest_subtitle: "一切装置都始于此处"
	quest.1C219C8669A164E0.title: "安山岩合金"
	quest.1C33DCFADBD4B13F.quest_desc: ["&7我们的心是怪物。所以我们的肋骨是囚笼。"]
	quest.1C33DCFADBD4B13F.quest_subtitle: "永远不要为让你成为战士的疯狂而道歉。"
	quest.1C375606107C117F.quest_subtitle: "找到凯拉堡 Keep Kayra"
	quest.1C4CC17CED87CDD4.quest_desc: [
		"OneDay 有自己的宝藏：&6Solarium&r，一块太阳的碎片，和 &bLunarium&r，一块月亮的碎片。"
		""
		"锻造在一起，它们便成为&d日蚀&r——一种随时间变化而改变威力的齿轮。"
		""
		"&6☀ 太阳&r = 白天在开阔的天空下。"
		"&b☾ 月亮&r = 夜晚、雷暴、下界、末地和其他黑暗的地方。"
	]
	quest.1C4CC17CED87CDD4.quest_subtitle: "一天分为两个半天"
	quest.1C4CC17CED87CDD4.title: "太阳与月亮"
	quest.1C5E5C596D8B2A61.quest_desc: ["四份Supremium Essence围绕Infusion Crystal可合成一份&5Insanium Essence&r——来自&bMystical Agradditions&r的第六个也是最后一个等级。"]
	quest.1C5E5C596D8B2A61.title: "Insanium"
	quest.1C6075524C120092.quest_desc: ["&7挥舞这把武器时，你能感受到死亡的气息。无论是生是死，没有生物愿意靠近你。你能感觉到这把武器在渴求着什么。它在渴望苏醒。"]
	quest.1C6075524C120092.quest_subtitle: "一种名为死亡的特殊感觉。"
	quest.1C72A3790353AF97.quest_desc: [
		"日蚀锭周围的不可得锭、炽热锭、附魔引力锭和热量锭。"
		""
		"标题：&d探险家传奇"
	]
	quest.1C72A3790353AF97.title: "探险者核心"
	quest.1C7CD73C371364CA.quest_desc: ["在OneDay中，主世界更加危险。猎杀每种新怪物一次以填满你的百兽谱。"]
	quest.1C7CD73C371364CA.title: "生物图鉴"
	quest.1CAFB7A7896A57E6.quest_desc: ["复制一个区域并将其粘贴到其他地方。"]
	quest.1CBB07C9191383D1.quest_desc: [
		"三种终局金属：深暗之地的&6Allthemodium&r、下界的&dVibranium&r和末地高地的&5Unobtainium&r。"
		""
		"你需要一把下界合金镐（或更好的镐）来挖掘它们。"
	]
	quest.1CBB07C9191383D1.title: "Allthemodium"
	quest.1CCA31D9352C60E6.quest_desc: ["围绕着一株高耸的中央“祖母”蘑菇，这些村庄从远处看显得古朴。然而，其中的村民比旧世界的同类更具攻击性，色彩鲜艳的菌盖下隐藏着狡黠的凶猛。请谨慎靠近，因为村庄可能欢迎不怀戒备者，只为设下陷阱。"]
	quest.1CCA31D9352C60E6.quest_subtitle: "找到一个蘑菇村庄"
	quest.1CEF2A38948010A2.quest_desc: ["在公海上，&6恼鬼&r们占据了浪潮，驾驶着巨大的战舰和快速的私掠船。它们的船帆投下长长的影子，大炮怒吼着。只有最勇敢的人才敢登船，因为机遇总是眷顾敢于抓住它的人。"]
	quest.1CEF2A38948010A2.quest_subtitle: "找到一个劫掠者海盗船或劫掠者战船"
	quest.1D22AA64DC073F04.quest_desc: ["法师护甲能提高你的最大法力值和法术强度。像火系、冰系或电系这样的学派套装能进一步提升单一学派的力量。"]
	quest.1D22AA64DC073F04.title: "巫师衣柜 (Wizard's Wardrobe)"
	quest.1D2599CA3F1C822B.quest_desc: ["用读取器读取世界中的值，在逻辑编程器中组合它们，然后用写入器进行操作。"]
	quest.1D2599CA3F1C822B.title: "逻辑网络"
	quest.1D6E9A8F3B71A1B9.quest_desc: ["火车、蒸汽、机械臂和巨型合成器——你已经掌握了创造。现在，建造点疯狂的东西吧！"]
	quest.1D6E9A8F3B71A1B9.title: "首席工程师"
	quest.1D9245F81C0581A8.quest_desc: ["马鞍和肉可以制作成可骑的动物自行车。几乎每种生物都有对应的自行车！"]
	quest.1D9245F81C0581A8.title: "车轮上的猪"
	quest.1D933192E8487DB1.title: "锯子 The Saw"
	quest.1D9672B0A8C34A9D.title: "Aquamarine"
	quest.1D9AA6EA5FC60C84.quest_desc: [
		"&6Ad Astra&r 添加了火箭和整个太阳系：&7月球&r、&c火星&r、&6金星&r、&e水星&r 和冰冻行星 &bGlacio&r。"
		""
		"每个火箭层级都能飞得更远。在一个世界找到的金属，能造出通往下一个世界的火箭。"
	]
	quest.1D9AA6EA5FC60C84.title: "群星之间"
	quest.1DA91EDDFF464BB2.quest_desc: [
		"完成&eTown NPCs&r中的所有任务，以获得&bTown Mayor&r称号。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.1DA91EDDFF464BB2.quest_subtitle: "城镇NPC"
	quest.1DA91EDDFF464BB2.title: "城镇镇长"
	quest.1DC7E421FC37767E.quest_desc: ["在深邃的下界中。"]
	quest.1DC7E421FC37767E.title: "地下世界竞技场"
	quest.1DF27FDF080455AC.quest_desc: ["从高处滑翔。滑翔会消耗耐力。"]
	quest.1DF27FDF080455AC.title: "滑翔伞"
	quest.1E0686645B73CFBE.quest_desc: [
		"骑着一头真正的猪走1公里。"
		""
		"需要胡萝卜钓竿。耐心则更为重要。"
	]
	quest.1E0686645B73CFBE.title: "当猪会飞……而且是慢慢地飞"
	quest.1E1F30AA23256133.quest_desc: [
		"每个冒险家都会成长——本整合包拥有完整的技能系统："
		""
		"[\"\",{\"text\":\"• 按下 \"},{\"keybind\":\"key.puffish_skills.open\",\"color\":\"gold\"},{\"text\":\" 以打开你的技能树。\"}]}]"
		"通过战斗、挖矿和探索赚取技能点，然后将其用于永久增益。"
		"• &6职业技能&r树让你能专精为巫师、圣骑士、盗贼、弓箭手等。"
		""
		"[\"\",{\"text\":\"提示：\",\"color\":\"yellow\"},{\"text\":\"Apotheosis 添加了世界层级——层级越高，敌人越强，战利品越好。使用以下按键更改层级：\",\"keybind\":\"key.apotheosis.open_world_tier_select\",\"color\":\"gold\"},{\"text\":\"。\"}]}]"
	]
	quest.1E1F30AA23256133.title: "变得更强大！"
	quest.1E20C53F8A899108.title: "北海巨妖"
	quest.1E21538FFDD8E669.quest_desc: ["每种多方块结构都在这有说明。"]
	quest.1E3046EB37F29BD6.quest_desc: ["秘银矿石深藏地下。它是顶级魔法书和装备的必需材料。"]
	quest.1E3046EB37F29BD6.title: "秘银（Mithril）"
	quest.1E38ABA8FE3A09FB.quest_desc: ["进入&6原始洞穴&r——恐龙还生活在这里面。"]
	quest.1E38ABA8FE3A09FB.title: "史前时代：恐龙的故事"
	quest.1E43CA1D1052238D.quest_desc: ["&7火焰的高度取决于燃料的多少。"]
	quest.1E43CA1D1052238D.quest_subtitle: "为了理解一切，他毁掉了自己。"
	quest.1E4A521988AEE7E7.title: "扩展合成器 (Extended Assembler)"
	quest.1E50DCCAFCBC436E.title: "红木灌木丛"
	quest.1E58FE80AE0FCA72.title: "Aquamarine Ingot"
	quest.1E65DAC37F8D34F9.quest_desc: ["&7看看你现在的正义感。要是他们能看到你该多好。"]
	quest.1E65DAC37F8D34F9.quest_subtitle: "全能的！"
	quest.1E92741C10D47A6A.quest_desc: [
		"完成&eBosses of the World&r中的所有任务，即可获得&bBoss Slayer&r称号。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.1E92741C10D47A6A.quest_subtitle: "世界上的首领们"
	quest.1E92741C10D47A6A.title: "Boss Slayer"
	quest.1ED0B8E68A69E40D.quest_desc: [
		"完成&eFarmer's Delight&r中的所有任务，以获得&bMaster Chef&r称号。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.1ED0B8E68A69E40D.quest_subtitle: "农夫的欢乐时光"
	quest.1ED0B8E68A69E40D.title: "顶级厨师"
	quest.1EE26CA611722F29.title: "Under and Beyond"
	quest.1F10BC33D22328BD.quest_desc: ["时间侵蚀了这片昔日神圣的土地，使其殿堂龟裂荒芜。如今，幽灵般的骸骨和诡计多端的幻术师盘踞其中，守护着昔日荣耀的残影。尽管危险重重，但坚固的墙壁使其成为在这个险恶世界中寻求立足之地的诱人庇护所。"]
	quest.1F10BC33D22328BD.quest_subtitle: "找到一个废弃的寺庙"
	quest.1F122AAD99D2A3D2.quest_desc: ["铺设轨道，建造车站，围绕火车控制器组装火车并为其设定时刻表。火车是长途运输货物和自身的最优方式。"]
	quest.1F122AAD99D2A3D2.quest_subtitle: "创建火车"
	quest.1F122AAD99D2A3D2.title: "全体登船！"
	quest.1F1234567890BCDE.quest_desc: ["制作一个药水过滤器，并将其与原版药水结合，输入到你的灌注金字塔中，以获得持久的区块范围效果增强。"]
	quest.1F1234567890BCDE.title: "药水过滤器"
	quest.1F1E9322EFDF2987.quest_desc: ["月之金属。你需要它来制造二级火箭。"]
	quest.1F1E9322EFDF2987.title: "Desh"
	quest.1F3107CA85323111.title: "钢板"
	quest.1F32FF7BFF9562A0.quest_desc: [
		"完成&e工具和武器&r中的所有任务，即可获得&b工具匠&r称号。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.1F32FF7BFF9562A0.quest_subtitle: "工具和武器"
	quest.1F32FF7BFF9562A0.title: "工具匠 (Toolsmith)"
	quest.1F48F405C4C70D3C.quest_desc: ["用背包里的方块延伸你注视的方向——快速建造。"]
	quest.1F8F18087EA99B02.quest_desc: [
		"死亡一次。"
		""
		"别担心，最优秀的人也会犯错。你也不例外。"
	]
	quest.1F8F18087EA99B02.title: "众多任务中的第一个"
	quest.1F914EAF1C4B4C9E.title: "洞穴苦力怕"
	quest.1FB3A6C4C6AFF557.quest_desc: ["将蒸汽机放置在流体储罐上，用烈焰燃烧器加热储罐并泵入水。大型锅炉能产生巨大的应力容量。"]
	quest.1FB3A6C4C6AFF557.title: "蒸汽动力"
	quest.1FE0A0287CAFBB7D.quest_desc: ["掌控风暴的雅典卫城女王。"]
	quest.1FE0A0287CAFBB7D.title: "斯库拉"
	quest.1FE9AB988B724596.title: "振金锭"
	quest.1FEDCA8B2494A1DC.quest_desc: [
		"你已经学会了基础知识——现在世界是你的了！左侧的章节列表分为七个路径："
		""
		"&6⭐ OneDay&r – 日月矿石、日食装备、悬赏、OneDay之星和传说称号"
		"&e🏡 生活与生存&r – 原版里程碑、烹饪、农业、存储和一点运气"
		"&2🌍 维度&r – 暮色森林、以太、亚历克斯的洞穴、下界、末地、太空等等"
		"&d✦ 魔法&r – Ars Nouveau, Iron's Spells, Occultism 和 Malum"
		"&c⚔ 战斗&r – 首领、地牢、RPG职业和Apotheosis"
		"&6⚙ 科技&r – Create、Mekanism、AE2、Immersive Engineering、Oritech、Ender IO 等"
		"&a🌳 Terraria&r – 在另一个维度 Otherworld 中开启属于你的 Confluence 之旅（使用你的 Terrarium 吧！）"
		""
		"没有唯一正确的顺序。哪个看起来有趣就跟着哪个走！"
	]
	quest.1FEDCA8B2494A1DC.title: "你的道路通向何方？"
	quest.1FF94EC1526D52CD.quest_desc: [
		"用闪电击中一名村民。"
		""
		"用三叉戟引导雷暴。他活该。大概吧。"
	]
	quest.1FF94EC1526D52CD.title: "非常非常恐怖的事情要发生了"
	quest.20078D0C6307CA00.quest_desc: [
		"在日晷祭坛中找到模板，或用钻石、Solarium、Lunarium和日食锭合成一个。"
		""
		"锻造台：&d模板 + 钻石装备 + 日蚀锭&r。用钻石和月石块复制模板。"
	]
	quest.20078D0C6307CA00.title: "日食升级包"
	quest.2047A1E40BB31AF7.quest_desc: ["烹饪煤炭会产生煤炭焦炭和焦油油。"]
	quest.20948E5613D180F0.quest_desc: ["一本更坚固、附魔槽更多的书。"]
	quest.20948E5613D180F0.title: "铁质封面的典籍"
	quest.20CB04DF18E5B32F.quest_desc: ["两个相互转动的压轮可以处理它们之间掉落的项目——比磨石快得多。"]
	quest.20CB04DF18E5B32F.title: "压碎车轮"
	quest.20D02705D867CD6F.quest_desc: ["在特定区域内恢复类地球重力。"]
	quest.20D02705D867CD6F.title: "重力正常化器"
	quest.20EBCEF58B72B488.quest_desc: [
		"设法弄到一个末地传送门框架。"
		""
		"请勿煎炸。放置它并等待——它会孵化成可骑的龙！"
		""
		"&7鸡蛋藏在寺庙、堡垒、要塞、地牢、雪屋和埋藏宝藏中。"
	]
	quest.20EBCEF58B72B488.title: "这是一个煎蛋卷吗？"
	quest.210925D2D66577EB.title: "四叶草（Four-Leaf Clover）"
	quest.21426F5EEC922866.quest_desc: ["半沉于海洋的，是一具巨兽的石化遗骸，其骨架绵延至视野尽头。它是远古被冲上陆地的深海生物，还是从天穹坠落？无人知晓，唯有刻于石上的疑问。"]
	quest.21426F5EEC922866.quest_subtitle: "找到一个泰丰（Typhon）"
	quest.216793A7F9E4FCE6.quest_desc: ["黄金地牢之上，天界暴君正在燃烧。击败他，掌控太阳祭坛——乃至时间本身。"]
	quest.216793A7F9E4FCE6.quest_subtitle: "黄金地牢"
	quest.216793A7F9E4FCE6.title: "太阳之灵"
	quest.216F8398629BDB24.quest_desc: [
		"用望远镜观察一只鹦鹉。"
		""
