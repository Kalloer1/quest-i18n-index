	]
	quest.70EDEA90B42F1D78.quest_subtitle: "深地之下"
	quest.70EDEA90B42F1D78.title: "深渊行者"
	quest.70F91669E7AA8244.quest_desc: [
		"完成&eStorage and Utilities&r中的所有任务，即可获得&bMaster Hoarder&r称号。"
		""
		"头衔会自动提供。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.70F91669E7AA8244.quest_subtitle: "存储与实用工具"
	quest.70F91669E7AA8244.title: "收藏家大师"
	quest.712537B423FD98D2.quest_desc: [
		"打开一个带陷阱的箱子。"
		""
		"恭喜你，你中了最老套的骗局。"
	]
	quest.712537B423FD98D2.title: "这是一个陷阱！"
	quest.7125609BAAB1FC32.title: "真正的骑士 (A True Knight)"
	quest.71317E1BC881852F.quest_desc: ["自动化了精华附魔机。"]
	quest.71317E1BC881852F.title: "Enchanternator"
	quest.713CB07EDD27915F.quest_desc: ["Occultism 魔法存储系统的核心组件。"]
	quest.713D81FCECD1A537.quest_subtitle: "介电棒是制造另一台机器部件的主要组成部分之一。"
	quest.713D81FCECD1A537.title: "初始部件"
	quest.714332285355C808.quest_desc: ["在此翻译洞穴石碑以获得洞穴法典。"]
	quest.714332285355C808.title: "Spelunkery 工作台"
	quest.7222AE8D6258DD0A.quest_desc: [
		"按照书中的金粉图案绘制，将材料放在周围的木制支架上，并在中间种下正确的树苗。"
		""
		"树苗长大后——骨粉会起作用——仪式便开始了。你的第一次会将橡木树苗变成远古树苗。"
	]
	quest.7222AE8D6258DD0A.title: "森林的仪式"
	quest.722BD5202E361333.quest_desc: ["深海中的顶级掠食者。"]
	quest.722BD5202E361333.title: "船体破坏者"
	quest.725AB6C405E8F5D4.quest_desc: ["来自原始洞穴——恐龙皮制成的长袍。"]
	quest.725AB6C405E8F5D4.title: "Primordial Mage"
	quest.7272D65052D97F66.quest_desc: ["&7Is your Ache known to the Gods?"]
