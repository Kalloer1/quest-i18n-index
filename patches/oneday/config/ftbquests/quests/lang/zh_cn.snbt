	quest.475A162CAAA293D1.quest_subtitle: "以太维度"
	quest.475A162CAAA293D1.title: "Aether 传说"
	quest.4765707B6FEBF24E.title: "大脑，已养殖成功"
	quest.4769648278D6D491.quest_desc: ["重构器会产出六种晶体：Restonia、Palis、Diamatine、Void、Emeradic 和 Enori。"]
	quest.4769648278D6D491.title: "能量水晶 (Empowered Crystals)"
