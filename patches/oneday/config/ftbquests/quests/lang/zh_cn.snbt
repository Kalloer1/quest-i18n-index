	quest.501B670CACF1CD84.quest_subtitle: "介电外壳是所有机器运行所需的材料，每个配方和升级都包含一个。"
	quest.501B670CACF1CD84.title: "机器之心"
	quest.502AC69F40F645CA.quest_desc: ["在自然祭坛上注入一个金锭。"]
	quest.503753E6E4E33AD6.quest_desc: [
		"右键点击存钱罐，用金币或绿宝石存钱。打破存钱罐时，里面的钱会保留。"
		""
		"潜行+空手可以再次倒出所有东西——已经按最大硬币分类好了。"
	]
	quest.503753E6E4E33AD6.title: "哼哼！"
	quest.503BDDD3F75B761E.quest_desc: ["鸡蛋藏在神殿、堡垒、要塞、地牢、雪屋和埋藏宝藏的箱子里。野生龙也遍布世界。"]
	quest.503BDDD3F75B761E.title: "一颗龙之蛋"
	quest.508A68D4C7383920.quest_desc: ["&7你真的想度过一个夜晚，却没有任何证据证明你并不孤单吗？行。随你便吧。"]
	quest.508A68D4C7383920.quest_subtitle: "为了杀死那些星辰。"
	quest.5092A4CFE00F712B.quest_desc: [
		"死亡100次。"
		""
		"到了这一步，你基本上就是个有业余爱好的鬼魂了。"
	]
	quest.5092A4CFE00F712B.title: "死亡只是一个建议"
	quest.50959AAA8316BD39.quest_desc: ["海洋遗迹的守护者。带上水肺和牛奶。"]
	quest.50959AAA8316BD39.title: "远古守卫者"
	quest.509E9CA83FBC780E.quest_subtitle: "找到一个钓鱼小屋"
	quest.50F463BAC456114B.quest_desc: ["一个巨大的、被熔岩覆盖的泰坦。带上火焰抗性，还有满满的勇气。"]
	quest.50F463BAC456114B.title: "Luxtructosaurus"
	quest.5100CFAD43E7D67A.quest_desc: ["这座宏伟的堡垒如同征服的纪念碑，是掠夺者势力的堡垒。多个层级都有劫掠者和咒术师巡逻，旗帜上宣称着对土地的统治。大厅内是财富的密室，由唤魔者守卫，他们的魔法和凝视一样致命。"]
	quest.5100CFAD43E7D67A.quest_subtitle: "找到一个掠夺者堡垒"
	quest.515210305D347C36.quest_desc: ["捕获一个生物的灵魂。"]
	quest.518BCF32EB0AC4E9.quest_desc: [
		"这个世界充满了首领。本章追踪的是其他维度章节之外的主要首领。"
		""
		"Bosses 会随着 Apotheosis 世界等级提升而变强——带上朋友、药水和你最好的装备。"
	]
	quest.518BCF32EB0AC4E9.title: "猎人的誓言"
	quest.518F878DE52A0567.quest_desc: [
		"跳跃 50,000 次。"
		""
		"到了这一步，走路对你来说只是个传说。"
	]
	quest.518F878DE52A0567.title: "人形袋鼠"
	quest.51A53B4AD00DEFC7.title: "矿脉哥布林"
	quest.51DFCE293287D77A.quest_desc: ["从你的口袋中打开一个末影箱频率。"]
	quest.51E1B2B885F03F65.quest_desc: ["更快的熔炉、更紧凑的村民方块和其他便利功能。"]
	quest.51E1B2B885F03F65.title: "助手们"
	quest.5209EC117C51D5D5.quest_desc: ["&7不断学习。不停研究。它们所知道的一切都是被教导的。它们唯一的本能就是学习。"]
	quest.5209EC117C51D5D5.quest_subtitle: "&7它们数量不多。但它们的眼却很多。"
	quest.52A14B3BFC213EE7.quest_desc: [
		"用桶抓住一只墨西哥钝口螈。"
		""
		"它在狩猎时会微笑。既可爱又可怕。"
	]
	quest.52A14B3BFC213EE7.title: "最可爱的掠食者"
	quest.52B365E69F91757C.quest_desc: ["在锻造台将钻石装备升级为下界合金装备。"]
	quest.52B365E69F91757C.title: "下界合金战士"
	quest.5346F22DCB47099E.title: "Crag Gardens"
	quest.5380B43AFD30C6C2.quest_desc: ["Dimension Expansion 添加了额外的挖矿维度。它们都始于一个空白传送器：雕纹深板岩、校准的潜声传感器、潜声催化剂、潜声尖叫器和一把下界合金镐。"]
	quest.53AF2B722A69DCDC.quest_desc: ["隐藏在草丛中，这座孤零零的房子破败不堪，木梁因岁月侵蚀而吱吱作响。它极易被忽视，除了那些曾称之为家的人的回忆外，别无他物。然而，再小的庇护所也能承载一段故事。"]
	quest.53AF2B722A69DCDC.quest_subtitle: "找到一个小型草原小屋"
	quest.53B32DDC23F390C6.quest_desc: [
		"跳跃 10,000 次。"
		""
		"你的膝盖已经提出了抗议。"
	]
	quest.53B32DDC23F390C6.title: "弹簧高跷"
	quest.541BBC35DA4F0B73.quest_desc: ["矿工们从成片的巨型真菌中掘出生计，将生存之道镌刻于地表世界。他们凶猛好斗，誓死捍卫领地。巨型蘑菇究竟是遮阳之用，还是另有阴谋，无人知晓。但有一点是确定的：这片矿脉蕴藏着丰富的矿石，等待着胆识过人者去开采。"]
	quest.541BBC35DA4F0B73.quest_subtitle: "找到一个蘑菇矿洞"
	quest.542AD63BDCE75C48.quest_desc: ["漂浮在海洋上的一艘被诅咒的船。"]
	quest.542AD63BDCE75C48.title: "Kraken 船"
	quest.54742CC8D5AFB79C.quest_desc: ["帽子袋里装着随机的装饰性帽子。时尚也是一种生存之道。"]
	quest.5476839FBC0F0BB3.quest_desc: ["洞穴群系的百科全书。每阅读一本洞穴法典，都会增加新的页面。"]
	quest.5476839FBC0F0BB3.title: "洞穴百科全书"
	quest.547DCAE28B3968ED.quest_desc: [
		"&7墙壁有耳朵。"
		"&7门上有眼睛。"
		"&7树木是有声音的。"
		"&7野兽会说谎。"
		"&7小心下雨。"
		"&7小心积雪。"
		"&7小心那个人。"
		"&7你以为自己已经了解一切了。"
	]
	quest.547DCAE28B3968ED.quest_subtitle: "负罪感会从内部吞噬你。"
	quest.54A18E7973F870B7.quest_desc: ["&7你更畏惧哪一个，回响还是答案。发出你那忧郁的疑问吧。"]
	quest.54A18E7973F870B7.quest_subtitle: "哦，伟大的存在，请告诉我一切"
	quest.54DDD41865E22FC3.quest_desc: ["每种生物都会释放出不同类型的灵魂。"]
	quest.54DDD41865E22FC3.title: "灵魂"
	quest.54EDC59229EEEAC9.quest_desc: [
		"Oney 是 OneDay 的吉祥物：一半太阳，一半月亮，充满爱意。"
		""
		"抚摸它会发出吱吱声——或在空中右键以&e将其作为帽子佩戴&r！"
	]
	quest.54EDC59229EEEAC9.title: "向奥尼打个招呼吧！"
	quest.5517CAD006FC35F7.quest_desc: ["制作这个之眼，像末影之眼一样投掷它——它会飞向&6被诅咒的金字塔&r。"]
	quest.5517CAD006FC35F7.title: "找到被诅咒的金字塔"
	quest.556AA138630CFF71.quest_desc: [
		"制作这个之眼，像末影之眼一样投掷它——它会飞向&6废弃堡垒&r。"
		"它存在于末地中。"
	]
	quest.556AA138630CFF71.title: "找到被毁的堡垒 (Find the Ruined Citadel)"
	quest.556C78463DB00269.quest_desc: ["&7这把武器被前一位持有者施加了加密。你能辨认出前两个字母，是“Br-”。握柄处仍散发着一种如此冰冷的武器所不该有的热量。握着它时，你感觉仿佛有人开了一个开了几百遍的冷笑话。"]
	quest.556C78463DB00269.quest_subtitle: "有些事情，一次说明就足够了。"
	quest.55ED54B1E7CE395A.quest_desc: ["在锻造台为物品添加一个插槽。"]
	quest.55F6BA6CDE92815A.title: "红宝石戒指"
	quest.56165119F5F61BA6.quest_desc: ["将矿石加倍转化为粉尘。"]
	quest.56165119F5F61BA6.title: "破碎机"
	quest.56246F75390FA413.quest_desc: ["精准的远程射击——以及用于近战的长矛。"]
	quest.56246F75390FA413.title: "弓箭手"
	quest.56587141383612EF.quest_desc: ["远古城市的盲目恐怖。杀死它并非必须，但生存下来才是。"]
	quest.56587141383612EF.title: "The Warden"
	quest.566A74C179C5FBF1.title: "Allthemodium 锭"
	quest.566AF1014C71F49E.quest_desc: [
		"&6Mekanism&r 是一个大型科技模组：矿石加工可将矿石最多提升5倍，还有强大的机器、喷气背包、数字矿工，以及最终的核裂变和核聚变反应堆。"
		""
		"一切始于 &b锇&r。在地下找到一些锇矿石并将其开采。"
	]
	quest.566AF1014C71F49E.quest_subtitle: "机器、化学和核能"
	quest.566AF1014C71F49E.title: "欢迎来到机械动力模组的世界"
	quest.568FFFCB09BC501B.quest_desc: ["一种栖息在沿海悬崖上的飞行海蛇。"]
	quest.568FFFCB09BC501B.title: "Naga"
	quest.5693BC4E9BB3E889.quest_desc: ["一个由坚固石头构成的世界，可供挖掘穿行。"]
	quest.5693BC4E9BB3E889.title: "实心石头"
	quest.569A5F59A2F4806E.title: "扩展接口 (Extended Interface)"
	quest.56CB8A0314031460.quest_desc: [
		"完成&eAlex's Caves&r中的所有任务，以获得&bCave Legend&r称号。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.56CB8A0314031460.quest_subtitle: "Alex's Caves"
	quest.56CB8A0314031460.title: "洞穴传说"
	quest.56D4107853E10AF2.quest_desc: ["为物品充能——并电击任何靠得太近的东西。"]
	quest.56D4107853E10AF2.title: "特斯拉线圈"
	quest.56D8267953307598.quest_desc: ["研磨矿石、花朵等。矿石有几率产出额外的 Crushed Ore。"]
	quest.56D8267953307598.title: "磨坊石"
	quest.570DB5EF22240511.quest_desc: ["一种在地下深处发现的稀有金属。"]
	quest.570DB5EF22240511.title: "Necoium"
	quest.573C22EAB7D03F10.title: "装配生产线"
	quest.5749A372620979B7.title: "Exoversal 合金"
	quest.575B074A8CC38A77.quest_desc: [
		"&6传送石&r散布在世界各地——你经常能在村庄里找到它们。"
		""
		"• 右键点击 Waystone 以激活它。"
		"• 激活后，你可以在任何时候在所有传送石之间自由穿梭。"
		"• 传送卷轴和传送石能让你从任何地方回到传送石处。"
		""
		"这里有两张传送卷轴，可以帮助你开始冒险。"
	]
	quest.575B074A8CC38A77.title: "快速旅行网络"
	quest.576793919D8BC5BA.quest_desc: ["无人机可以挖掘、建造、耕种、战斗和携带物品——只要你能编程让它们做到。"]
	quest.576793919D8BC5BA.title: "你的第一架无人机"
	quest.57757A30E93E01F8.quest_desc: [
		"你知道路了——现在把异世界变成你的。泰拉瑞亚章节推荐顺序："
		""
		"&a🌱 新的开始&r – 制作台与最初的 boss"
		"&a🏠 城镇NPC&r – 吸引新邻居"
		"&a🗺 群系&r – 探索每一个角落"
		"&a⛏ 工具和武器&r、&a🛡 盔甲套装&r、&a💍 配饰&r – 整装待发"
		"&a🧪 药水&r – 酿造一切物品"
		"&a💀 困难模式&r 和 &a✨ 闪耀&r – 游戏的最终阶段"
	]
	quest.57757A30E93E01F8.title: "旅程的开始"
	quest.578CE55CB78C44AD.quest_desc: ["以惊人的力量压缩材料。"]
	quest.57B16891F6022F12.quest_desc: ["被冰冻束缚的诅咒战士。"]
	quest.57B16891F6022F12.title: "Maledictus"
	quest.57C61B4B8C1A071B.quest_desc: ["被黑暗魔法扭曲成终极怪物的夜莺。"]
	quest.57C61B4B8C1A071B.title: "被遗弃者 (The Forsaken)"
	quest.57D3EA9B66B5C418.title: "Alternator"
	quest.583E898E0855159B.quest_desc: [
		"将其投掷在祭坛旁以召唤众神。"
		""
		"需要瓶装阳光和瓶装鬼魂。"
	]
	quest.584C9EE5E7AA1A91.quest_desc: ["一种能远程挖掘方块并为机器充能的激光。"]
	quest.5884A8CF77A77AFC.quest_desc: ["锻造台：末影宝石 + 空白传送器 + 钻石矿石。"]
	quest.58863CD36841B0B1.quest_desc: [
		"完成&eNature's Aura&r中的所有任务，即可获得&bAura Legend&r称号。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.58863CD36841B0B1.quest_subtitle: "自然的气息 (Nature's Aura)"
	quest.58863CD36841B0B1.title: "光环传说"
	quest.58C460A297158B7D.quest_desc: [
		"源链接从周围的世界中创造源："
		""
		"&6农艺学&r – 种植植物"
		"&6火山&r – 燃烧的燃料"
		"&6菌丝体&r – 食物"
		"&6Vitalic&r – 动物和生物"
		"&6炼金术&r – 药水"
	]
	quest.58C460A297158B7D.title: "正在生成源文件"
	quest.591ADA11628B1564.quest_desc: ["从 Amadron 商店订购物品——由无人机送达。"]
	quest.591ADA11628B1564.title: "在线购物"
	quest.5925583BAE1454AF.quest_desc: ["一种以柴油为燃料的强大采矿工具。"]
	quest.595714C78D8821C1.title: "双手剑（Zweihänder）"
	quest.59575E7725598396.title: "不死者 The Immortal"
	quest.596103BEDC507D72.title: "量子处理器"
	quest.5996D2ED8745D5F6.quest_desc: ["在&6加热&r的盆中混合铜和锌以制作黄铜——中后期 Create 的核心。"]
	quest.5996D2ED8745D5F6.quest_subtitle: "进步之金属"
	quest.5996D2ED8745D5F6.title: "黄铜"
	quest.599AAF65990CAFD0.quest_desc: [
		"吃掉50片蛋糕。"
		""
		"在其他游戏里，这可能只是个谎言。但在这里，它真实存在，而且美味可口。"
	]
	quest.599AAF65990CAFD0.title: "蛋糕并非谎言"
	quest.59B60A798631D7AE.title: "被霜冻侵袭的"
	quest.59CC9FF3A8AB5F1B.quest_desc: [
		"右键点击农田并使用精华，即可将其转化为对应等级的精华农田。"
		""
		"在 OneDay 资源作物中，&c作物只会生长在&r与其同级的农田上！"
	]
	quest.59CC9FF3A8AB5F1B.title: "高效的农田 (Effective Farmland)"
	quest.59F4E4A9A9F511F4.quest_desc: ["喝咖啡能给你药水效果。没开玩笑！"]
	quest.59F4E4A9A9F511F4.title: "咖啡时间到了，休息一下喝杯咖啡吧！"
	quest.5A167806CBF28D9F.quest_desc: ["召唤一个能为你砍树的Foliot。"]
	quest.5A25A92FF0474D5A.quest_desc: [
		"完成&eBosses' Rise&r中的所有任务，以获得&bDragon Slayer&r称号。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.5A25A92FF0474D5A.quest_subtitle: "Bosses' Rise"
	quest.5A25A92FF0474D5A.title: "屠龙者"
	quest.5A3AAF71A540058D.quest_desc: ["改变主意了？这个球体可以重置你的技能点。"]
	quest.5A8C3A60C0361E16.title: "Jade"
	quest.5A9BAB15C4C8791F.quest_desc: ["一个具有巨大存储和多个并行任务的组合方块CPU。"]
	quest.5A9BAB15C4C8791F.title: "量子计算机"
	quest.5AA2A1E358A18B4E.quest_desc: [
		"&c&lEmpowered Remnants&r &7是通过熔炼独特武器来制作的。"
		""
		"&7它们用于制作&9&l符文融合宝石&r、&7以及&6&l下界融合宝石&r。"
	]
	quest.5AA2A1E358A18B4E.quest_subtitle: "制作起来真痛苦……"
	quest.5AC50DF4F52A548F.quest_desc: ["&7记录保存完好，但这些武器的特性使其会随时间腐朽。无人知晓它们的来源或制作者，我们所知的是，当看到有人挥舞它们时，此人多半会走向失败。"]
	quest.5AC50DF4F52A548F.quest_subtitle: "&7它们从我们甚至无法感知的天空中飞了过来。"
	quest.5B0595FA1A96061C.title: "亚原子合金"
	quest.5B0EC9A80C44CF6F.quest_desc: ["由抛光玫瑰石英和铁板制成。许多高级机器都需要它们。"]
	quest.5B0EC9A80C44CF6F.title: "电子管"
	quest.5B267B7674F91DE8.quest_desc: ["&7如磁铁般吸引灵魂。喜欢将它们缝合在一起，仿佛它们是布料一般。"]
	quest.5B267B7674F91DE8.quest_subtitle: "&7灵魂聚合体（An agglomeration of Souls）"
	quest.5B385756792DF818.quest_desc: [
		"骑着史莱克在末地世界的熔岩湖上长途旅行。"
		""
		"旅游，但要让它充满激情。"
	]
	quest.5B385756792DF818.title: "感觉像家一样"
	quest.5B3FAB0E6063E784.title: "不死矿工"
	quest.5B72BBC553D0B2FF.quest_desc: ["制作这个之眼，像末影之眼一样投掷它——它会飞向&6霜冻监狱&r。"]
	quest.5B72BBC553D0B2FF.title: "找到冰冻监狱 (Frosted Prison)"
	quest.5B8501629AEE9254.quest_desc: ["组装复杂的部件，例如处理单元。"]
	quest.5B8F694F41090641.quest_desc: ["&7禁忌之物有一种魅力，让人欲罢不能，难以言喻。"]
	quest.5B8F694F41090641.quest_subtitle: "光是拿着它，就感觉刺痛。真想知道那把刀刃会怎么样。"
	quest.5B978E6C5FE55BEB.quest_subtitle: "用于制作玩家发射器的独家材料。"
	quest.5BDF827CD85D6D18.title: "沼泽地"
	quest.5C12F4CC1F6F6C32.quest_desc: ["这艘巨大的飞艇在云层中若隐若现，布满防御工事和敌对船员。幻影骑士在空中盘旋，骑猪灵的鱼人袭击者在甲板上游荡。登船绝非易事。成功者将在敢于挑战天空的少数人中立下赫赫战功。"]
	quest.5C12F4CC1F6F6C32.quest_subtitle: "寻找一位天界挑战者"
	quest.5C498C29711B93B9.quest_desc: [
		"&6Ars Nouveau&r 让你用符文构建自己的法术：&e形式&r（施放方式）、&e效果&r（作用）和&e增幅&r（强度）。"
		""
		"合成旧笔记本（书 + 青金石）——这是完整的游戏内指南。"
	]
	quest.5C498C29711B93B9.title: "磨损的笔记本"
	quest.5C6755620140F16B.quest_desc: ["&7使用这把武器的人，都活不久。面对自己，你又能撑多久？这把刀刃既锋利又恶心。刀刃上的铭文记载，瘟疫领主之名，被赐予了接受它的可怜灵魂。"]
	quest.5C6755620140F16B.quest_subtitle: "你觉得自己病了吗？(Do you feel Diseased?)"
	quest.5C76D4569C11F1ED.title: "冰学家"
	quest.5C78BBC3403DFB6F.quest_subtitle: "这张绑定卡可以实现跨维度无线充电，但必须用绑定卡绑定末影人才能使用。"
	quest.5C78BBC3403DFB6F.title: "穿越维度：有界版"
	quest.5C84B23A30184926.quest_desc: ["燃烧固体燃料以产生电力。"]
	quest.5C8B7182A48F5825.quest_desc: ["将同一阶的4个精华与水晶结合，可获得1个更高阶的精华。"]
	quest.5C8B7182A48F5825.title: "灌注水晶"
	quest.5CA50A078D1A5E39.quest_desc: ["玻璃瓶和任意木板。用于直接从空气中收集灵气。"]
	quest.5CE1F4027F094B5E.quest_desc: [
		"完成&eEpic Knights&r中的所有任务，即可获得&bKnight Errant&r称号。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.5CE1F4027F094B5E.quest_subtitle: "史诗骑士团"
	quest.5CE1F4027F094B5E.title: "骑士游侠"
	quest.5CEB4D920E2DCACB.quest_desc: [
		"在生存模式中使用瓶塞和软木塞右键空气。"
		""
		"在末地，你可以获得&c瓶装鬼魂&r，在末地要塞，可以获得&5瓶装黑暗&r。装有瓶子和软木的分配器会帮你收集它们。"
	]
	quest.5CEB4D920E2DCACB.title: "瓶装阳光"
	quest.5CF1C9D38D56C0AD.quest_desc: ["Malum 是关于生物死后留下的灵魂。它的百科全书里解释了一切。"]
	quest.5D24AF01CE6F6405.quest_desc: ["一个能双倍产出的大型多方块结构。手册中展示了布局。"]
	quest.5D24AF01CE6F6405.title: "破碎机"
	quest.5D24E3F0D7BAC45F.title: "震荡苦力怕"
	quest.5D419B241DD31D4F.quest_desc: [
		"敲响铃铛 50 次。"
		""
		"整个村庄都喜欢你。毫无疑问。绝对如此。"
	]
	quest.5D419B241DD31D4F.title: "叮咚，快离开这里"
	quest.5D95CD051238DEC7.quest_desc: [
		"向导和商人等泰拉瑞亚NPC只有在有合适的房子时才会搬进来。"
		""
		"建造一间带墙壁、门、光源、桌子和椅子的小房子。章节&6🏠城镇NPC&r会显示谁能搬进来。"
	]
	quest.5D95CD051238DEC7.quest_subtitle: "为你的第一批NPC建造一个住所"
	quest.5D95CD051238DEC7.title: "温馨的小家，我可爱的家"
	quest.5D96130485D58077.quest_desc: ["进入&d糖果空洞&r。这里的一切都可以吃……大概吧。"]
	quest.5D96130485D58077.title: "甜食爱好者 (Sweet Tooth)"
	quest.5D97C508FA8F1F26.quest_desc: ["适合各自生物群系的僵尸：沙漠、雪地、沼泽、海滩、下界和深层洞穴。"]
	quest.5D97C508FA8F1F26.title: "腐坏的生物"
	quest.5DB18EB2857AD937.quest_desc: ["将装置放置在奥数核心上，并用奥数基座环绕。这是Ars Nouveau的高级合成祭坛。"]
	quest.5DB18EB2857AD937.title: "附魔装置 Enchanting Apparatus"
	quest.5DCDDAD3CB75D25D.quest_desc: [
		"获取一辆牛自行车。"
		""
		"正以不可思议的速度移动中。"
	]
	quest.5DCDDAD3CB75D25D.title: "天哪，它有轮子，还能滚动！"
	quest.5E310F7F168CBA8C.quest_desc: ["制作一件任意学派专属的盔甲。此处展示的是火球学派，但任何学派都算作你旅途的进展。"]
	quest.5E310F7F168CBA8C.title: "选择一个学校"
	quest.5E418A209B285E18.quest_desc: [
		"完成&eIron's Spells 'n Spellbooks&r中的所有任务，即可获得&bSpellbook Legend&r称号。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.5E418A209B285E18.quest_subtitle: "Iron's Spells 'n Spellbooks"
	quest.5E418A209B285E18.title: "咒语书传奇"
	quest.5E6A65E69445CD8A.quest_desc: ["Applied Flux 让你的 ME 网络可以存储和传输 FE 能量。"]
	quest.5E6A65E69445CD8A.title: "Flux Accessor"
	quest.5E6E94730281753A.quest_desc: ["戴上它们，看向一个方块，就能看到它的速度、应力影响和内部物品。"]
	quest.5E6E94730281753A.title: "工程师护目镜"
	quest.5E7F13B7290F4ED7.quest_desc: ["向众神献上附魔铁——或用受污染的黄金换取双倍数量的锭。"]
	quest.5E7F13B7290F4ED7.title: "Ingot of the Skies"
	quest.5E9275EB030938FF.quest_desc: ["我的下界之乐将烹饪带入下界。子弹辣椒是其标志性的辛辣作物。"]
	quest.5E9275EB030938FF.title: "辛辣的下界烹饪"
	quest.5EAA83E38BF56386.quest_desc: [
		"&6Solarium Ore&r 在 Y 坐标 80 以上的高山深处闪耀着金色的光芒。"
		""
		"你需要至少一把&b钻石镐&r才能开采它。"
	]
	quest.5EAA83E38BF56386.title: "太阳的一块碎片"
	quest.5EB66A7DB7CB07EC.quest_desc: ["将不祥之谷的重核与微风之杖结合。下落越远，撞击越猛烈！"]
	quest.5EC27B5F85CEC39A.quest_desc: ["火箭在这里由鼻锥、尾翼、引擎、燃料箱和板件组装而成。"]
	quest.5EC27B5F85CEC39A.title: "NASA 工作台"
	quest.5F2FE270863AE26F.title: "柴油动力"
	quest.5F48146949BF9109.quest_desc: ["可储存大量单一类型的灵魂。"]
	quest.5F59BA8F398834C6.quest_desc: [
		"用黑曜石建造一个下界传送门框架，并用打火石和钢点燃它。"
		""
		"&cBeds explode here – do not try to sleep!"
	]
	quest.5F59BA8F398834C6.title: "进入下界"
	quest.5F6748754377DB53.quest_desc: ["更快的熔炉——一路升级到彩虹熔炉。"]
	quest.5F9A38A199997671.quest_desc: ["将你的出生点设置在末地。用萤石为其充能。"]
	quest.5FCA6B80D0208B6B.quest_desc: ["Civilian Aviation 在 Immersive Aircraft 的基础上增加了真实的小型飞机和直升机。"]
	quest.5FCA6B80D0208B6B.title: "已获准起飞"
	quest.5FCF3FDBA64B3DD3.quest_desc: ["可升级的采矿钻头：速度、3×3、5×5、真丝采集、时运和放置方块。"]
	quest.5FCF3FDBA64B3DD3.title: "钻头"
	quest.60144FFDA8D00E33.quest_desc: ["幼崽被驯服后就会成为你的忠实伙伴。好好照顾它——成年并配有鞍的龙可以带你翱翔天际。"]
	quest.60144FFDA8D00E33.title: "驯龙者"
	quest.6029C34D55EC0F1E.quest_desc: [
		"完成一整章后，&6传奇大厅&r会授予你诸如&b机械动力传奇&r或&b烹饪大师&r之类的称号。"
		""
		"头衔会显示在你的名字下方，供所有人查看。在 OneDay 菜单中选择要佩戴的。"
		""
		"完成&e所有&r任务，锻造OneDay Star，成为&6✦ OneDay Legend ✦&r。"
	]
	quest.6029C34D55EC0F1E.title: "头衔与传奇"
	quest.607D367050727C90.title: "樱花林"
	quest.60DCA31515BC6061.title: "Bloom Stone Staff"
	quest.60F51208FA5117A6.quest_desc: ["&6源&r是Ars Nouveau的魔法能量。源罐可为你的机器储存能量。"]
	quest.60F51208FA5117A6.title: "源 Jar 文件"
	quest.6142D6FA161487F6.quest_desc: ["三级作物。8个铁精华可制作3个铁锭。"]
	quest.6142D6FA161487F6.title: "铁长在树上？不，长在庄稼上！"
	quest.614EC37BEA185F5F.title: "附魔的魔法书 Enchanted Spell Book"
	quest.619A727FF6FB268A.quest_desc: ["将火箭放置在发射台上，加注燃料，然后进入并点火发射！"]
	quest.619A727FF6FB268A.title: "Tier 1 火箭"
	quest.61C06732A8C67FAA.quest_desc: [
		"击败一个末影人矿工。"
		""
		"小末影人，大脾气。不要直视它的眼睛。"
	]
	quest.61C06732A8C67FAA.title: "小巧而恐怖"
	quest.61C55A13F3DBBD22.quest_desc: [
		"&6Bounty Board&r 每日提供新悬赏：狩猎生物或运送物品，赢取金币、经验和幸运方块。"
		""
		"一旦你访问了下界、末地并击败了末影龙，悬赏就会变得更难（报酬也更高）。"
		""
		"&7击杀悬赏会自行计数。交付悬赏时，按下“交付”会从你的物品栏中取出物品。"
	]
	quest.61C55A13F3DBBD22.title: "赏金猎人"
	quest.61C74003316C78C3.title: "橄榄石"
	quest.61DB013AF9D2D6F4.quest_desc: ["随身携带光环。将其放置在自然祭坛上即可充满。"]
	quest.61DCD40D5F0F6DED.quest_desc: ["威力大得多的爆炸效果。"]
	quest.61DCD40D5F0F6DED.title: "黑曜石TNT"
	quest.61DE2AE3CEDCA4C0.quest_desc: ["磁铁、建筑魔杖、小工具和锤子。"]
	quest.61DE2AE3CEDCA4C0.title: "工具"
	quest.622B0A56F7FD7083.quest_desc: [
		"OneDay 添加了专属传送门：&2Rotten Horde&r、&5Night of the Ender Zoo&r、&aCreeper Carnival&r、&7Illager Siege&r 和 &dEndless Eclipse&r。"
		""
		"制作一个门珍珠，投掷它，在浪潮中生存下来——并收集奖励。无尽日食永不停息！"
	]
	quest.622B0A56F7FD7083.title: "破门而入者"
	quest.62589D0D45F0D98A.quest_desc: [
		"Let's Do 模组添加了一片乡村：面包店、奶牛场、葡萄园和酿酒厂。"
		""
		"它们的许多配方，比如面团，都是在合成碗中混合的。"
	]
	quest.62589D0D45F0D98A.title: "合成碗 (The Crafting Bowl)"
	quest.6264E830D735CEF9.title: "耐力容器"
	quest.62B47D18AB28B8AD.title: "存储控制器"
	quest.62EA93B01221C9B3.quest_desc: ["程序化无人机，使用拼图块指令。"]
	quest.62EA93B01221C9B3.title: "程序员"
	quest.62FEA01FAA032475.quest_desc: ["唤魔者会掉落不死图腾——在林地府邸和袭击中查找。手持它可躲避一次死亡。"]
	quest.63116691C92FD576.quest_desc: ["山丘间藏着一处静谧的泉眼，泉水在深不见底的井中神秘地旋转。旅人说，靠近它的人能获得微妙的祝福，甚至有人在旅途中感到速度有所提升。无论是魔法还是传言，这口井都为探险者带来了奇特的优势。"]
	quest.63116691C92FD576.quest_subtitle: "找到一个许愿井"
	quest.639EDAE9BA5D6519.quest_desc: ["箭袋会在自己的格子里存放额外的箭。"]
	quest.63ADC29FABC60424.quest_desc: [
		"完成&eArmor Sets&r中的所有任务，即可获得&bArmorsmith&r称号。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.63ADC29FABC60424.quest_subtitle: "盔甲套装"
	quest.63ADC29FABC60424.title: "盔甲匠 (Armorsmith)"
	quest.63BB3DE54E986797.quest_desc: ["在金星上发现。用于最终火箭层级。"]
	quest.63BB3DE54E986797.title: "Calorite"
	quest.63CB3B7253534C40.title: "末影人矿洞"
	quest.63D302D27F692952.quest_desc: ["垂直堆叠电梯：跳跃上升，潜行下降。"]
	quest.63D55699D4BB8848.quest_subtitle: "充能雪球携带的能量足以在击中生物或地面时引发闪电。"
	quest.63DE5FD17A9BBDE6.quest_desc: [
		"将你的法术书装备到对应栏位，然后："
		""
		"[\"\",{\"text\":\"• \"},{\"keybind\":\"key.irons_spellbooks.spellbook_cast\",\"color\":\"gold\"},{\"text\":\" 会施放所选的咒语。\"}]}]"
		"[\"\",{\"text\":\"• 按住 \"},{\"keybind\":\"key.irons_spellbooks.spell_wheel\",\"color\":\"gold\"},{\"text\":\" 以打开法术轮盘。\"}]}]"
		"[\"\",{\"text\":\"• 按住 \"},{\"keybind\":\"key.irons_spellbooks.spell_bar_modifier\",\"color\":\"gold\"},{\"text\":\" 并滚动以快速切换法术。\"}]}]"
	]
	quest.63DE5FD17A9BBDE6.title: "被遗弃的船员！"
	quest.644730C35064F209.title: "自动收获"
	quest.6447492FAA873F93.quest_desc: ["悬浮于空中，这座蒸汽朋克浮空城闪烁着橙绿光芒。奇特的齿轮驱动居民在平台上游荡，每个都有一只巨大的独眼或单片镜。小心进入，这个机械蜂巢既聪慧又威严，其秘密受到严密守护。"]
	quest.6447492FAA873F93.quest_subtitle: "找到一个机械巢穴"
	quest.646542E5F62C51AE.title: "学徒的魔法书 (Apprentice's Spell Book)"
	quest.64A3CD943835233D.quest_desc: ["在火星上开采——通往 Tier 3 火箭的钥匙。"]
	quest.64A3CD943835233D.title: "奥斯特伦"
	quest.65495B51321BB86A.quest_desc: ["神圣战士：治愈盟友，惩戒敌人，用盾牌坚守阵地。"]
	quest.65495B51321BB86A.title: "圣骑士与牧师"
	quest.65A0C655347698B9.quest_desc: ["守护青铜地牢的活石方块。只有&6稿子&r才能对它造成伤害！"]
	quest.65A0C655347698B9.quest_subtitle: "青铜地牢"
	quest.65A0C655347698B9.title: "滑块装置"
	quest.65B818D879FA7E4F.quest_subtitle: "第6级电容器用于升级到最终级别的氮气机械。"
	quest.65D5AD0EC9A0F57E.quest_desc: [
		"在沙漠神殿附近击败一只木乃伊。"
		""
		"真该有人告诉它绷带是用来治伤的，不是用来当装饰的。"
	]
	quest.65D5AD0EC9A0F57E.title: "未展开的包裹物（Unwrapped）"
	quest.6601243A1553F79E.title: "Oh The Biomes We've Gone"
	quest.66450530A1BF2864.quest_desc: ["墨水的稀有度决定了锻造法术的等级。"]
	quest.66450530A1BF2864.title: "墨水"
	quest.666D6FFBD5FD2306.quest_desc: ["&7存在太多，灵魂太少。"]
	quest.666D6FFBD5FD2306.quest_subtitle: "&7如果它被偷了，那它一开始就是你的吗？"
	quest.667E880C28AB9FA6.quest_desc: ["容量扩大三倍的灵气缓存。"]
	quest.66A4960217E0791D.quest_desc: ["将苹果——或者葡萄——榨成汁。"]
	quest.66A541EE636B0274.quest_desc: ["武器和盔甲会掉落带有随机词缀的装备，从普通到神话。更稀有的物品可能有宝石插槽。"]
	quest.66A541EE636B0274.title: "附加战利品"
	quest.66C28F69B9114D36.quest_desc: ["终极通用型魔法书。"]
	quest.66C28F69B9114D36.title: "古代卷轴 (Ancient Codex)"
	quest.66D2D430C6E96A5E.title: "马克西米利安盔甲"
	quest.66F0BF461623535F.title: "雪地苦力怕"
	quest.67030CEFEC1CEF37.quest_desc: ["被逐出村庄的坚韧商人们，如今在野外游荡，在简易的青蓝色和棕色帐篷下寻求庇护。尽管流离失所，他们仍向敢于寻找他们的旅人提供贸易和庇护。在这个危险四伏的世界里，这样的营地是难得的信任港湾。"]
	quest.67030CEFEC1CEF37.quest_subtitle: "找到一个商人营地"
	quest.6743AA5BF9C095A2.quest_desc: [
		"跳跃 1,000 次。"
		""
		"是的，狂按空格键也算。我们不会评判的。太多。"
	]
	quest.6743AA5BF9C095A2.title: "兔子跳"
	quest.675E8D7245B66C21.quest_desc: ["第二个祭坛催化剂。能将腐肉变成皮革，木炭变成煤炭，沙子变成灵魂沙等。"]
	quest.67F408052A984C0E.quest_desc: ["将铁锭放在爆炸物（TNT或苦力怕）旁边进行压缩。总会有一些丢失！"]
	quest.67F408052A984C0E.title: "压缩铁块 (Compressed Iron)"
	quest.67FFA119A3BFC695.quest_desc: ["每个仪式的中心所在之处。"]
	quest.6810972065857B71.quest_desc: ["更快、更运动——还带螺旋桨。"]
	quest.681FA798D563880A.title: "堕落的骑士"
	quest.6837A0498F747EB3.quest_desc: [
		"异世界用&7银币&r支付，主世界用&a绿宝石&r。一个&a绿宝石&r价值&715银币&r。"
		""
		"将&a绿宝石&r放入&6切石机&r可获得&715枚银币&r。若想用15枚银币换回&a绿宝石&r，请使用&a兑换台&r。"
		""
		"&7提示：100铜 = 1银，100银 = 1金，100金 = 1铂。将硬币放入合成网格中即可分解。"
	]
	quest.6837A0498F747EB3.quest_subtitle: "两个世界共享一个经济系统"
	quest.6837A0498F747EB3.title: "兑换率"
	quest.6858E25E510AE0FA.quest_desc: ["这艘异界飞空艇如巨鱿般翱翔天际，防御森严。幻影骑的怪物环绕船体，骑猪灵的鱼人战士守卫甲板。直面征服者，即是与空中军团作战。唯有最强者方能取胜。"]
	quest.6858E25E510AE0FA.quest_subtitle: "寻找一位天界征服者"
	quest.6865FDB53B237C3C.quest_desc: ["用书架包围它，解锁更强的附魔。Apotheosis将附魔变成了一个完整的系统——参见💎 Apotheosis章节。"]
	quest.688FF2C2F77D267C.title: "电路板"
	quest.68B5CE508BDF7904.quest_desc: ["拾取范围内的物品并放置在任何位置。放置前请选择输入和输出。"]
	quest.68B5CE508BDF7904.title: "机械臂"
	quest.68C274BC3FDBF7B1.title: "精炼红石"
	quest.68CC10EDAD3CF2AB.title: "沙漠魔法书"
	quest.68D9B7CBEB346B19.quest_desc: ["奇美拉的奖杯——用于制作大法师法术书。"]
	quest.68D9B7CBEB346B19.title: "狂野的贡品"
	quest.68EDC5289C44F9B9.title: "红宝石锭"
	quest.68FDDCA1C9D4BCC8.quest_desc: [
		"上船，和山羊一起漂浮在水面上。"
		""
		"推荐使用尖叫山羊。"
	]
	quest.68FDDCA1C9D4BCC8.title: "随你高兴，山羊说了算"
	quest.691AB171C0A0B4A5.quest_desc: ["收集10个首领奖杯。"]
	quest.691AB171C0A0B4A5.title: "奖杯室"
	quest.69C9EC0631A59171.quest_desc: ["溺尸有时会携带并掉落三叉戟。"]
	quest.69D7086959402D69.quest_desc: ["每个末地船船首上的奖杯。"]
	quest.69EA7C9FE6676533.quest_desc: ["[\"\",{\"text\":\"手套、戒指、吊坠和斗篷会放入你的配饰栏。使用 \"},{\"keybind\":\"key.aether.open_accessories.desc\",\"color\":\"gold\"},{\"text\":\"打开它们。\"}]}]"]
	quest.69EA7C9FE6676533.title: "Aether Accessories"
	quest.69EF462347C191C6.quest_desc: ["一条由口香糖制成的巨型蠕虫在糖果中穿行。"]
	quest.69EF462347C191C6.title: "Gum Worm"
	quest.6A0237FADC519965.quest_desc: ["远处望去，一片祥和。金色的麦田在骄傲的风车旁摇曳。但别被迷惑了：掠夺者并不种植作物用于交易。在这质朴的外表下，藏着一个邪恶的巢穴，他们的刀刃和他们携带的镰刀一样锋利。"]
	quest.6A0237FADC519965.quest_subtitle: "找到一个掠夺者风车"
	quest.6A1234567890BCDE.quest_desc: ["欢迎来到 Pylons 模组！Pylons 可以在整个区块甚至维度中提供实用功能，而不会造成延迟。"]
	quest.6A1234567890BCDE.title: "Pylons 简介"
	quest.6A3EDD423D9E141E.quest_desc: [
		"4 个 Solarium 和 4 个 Lunarium 锭围绕 1 个 Netherite Scrap 可制作 &d2 个 Eclipse 锭&r。"
		""
		"锭本身会显示现在是白天还是黑夜！"
	]
	quest.6A3EDD423D9E141E.title: "日食与月食（Eclipse）"
	quest.6A4C5697B8AEF9CE.quest_desc: ["来自亚历克斯洞穴的失落幽谷。"]
	quest.6A4C5697B8AEF9CE.title: "恐惧长袍"
	quest.6A4F0E662C367303.title: "冰川猎人"
	quest.6A8665FBC017A00F.quest_desc: ["&7永恒是一个危险的词。凡人怎能献上永恒？"]
	quest.6A8665FBC017A00F.quest_subtitle: "有些事情并不会以死亡为终结。"
	quest.6A8FBA84DD1283E8.quest_desc: ["用镰刀杀死生物，将它们的灵魂震碎成精魄。"]
	quest.6AA46157C76B3EFB.quest_desc: ["可分阶段升级的桶和箱子，支持自动熔炼和压缩等升级功能。"]
	quest.6AA46157C76B3EFB.title: "Sophisticated Storage"
	quest.6AC872BD641706D4.quest_desc: ["特殊书架在附魔台旁提升 Eterna、Quanta 和 Arcana 的效果——附魔更强力。"]
	quest.6AC872BD641706D4.title: "更好的书架模组 (Better Bookshelves)"
	quest.6AED85374A4ACD23.title: "黄水晶锭"
	quest.6AEDC93B21A4779E.quest_desc: ["召唤你的龙。口哨有多种染料颜色——为本次任务制作一个&c红色&r的。"]
	quest.6AEDC93B21A4779E.title: "龙之哨笛"
	quest.6B35F27EE277F880.quest_desc: ["&7人人为狼，狼人为人"]
	quest.6B35F27EE277F880.quest_subtitle: "要杀死一条龙，你需要完成以下任务："
	quest.6B68DF4F5A754117.quest_desc: [
		"完成&eMekanism Expansions&r中的所有任务，即可获得&bEvolved Engineer&r称号。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.6B68DF4F5A754117.quest_subtitle: "Mekanism 扩展模组"
	quest.6B68DF4F5A754117.title: "进化工程师"
	quest.6B74CFB003AF03C6.title: "下界合金-钻石"
	quest.6BCEC1A3B697DABE.quest_desc: [
		"完成&eWhen Dungeons Arise&r中的所有任务，即可获得&bDungeon Legend&r称号。"
		""
		"头衔会自动提供。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.6BCEC1A3B697DABE.quest_subtitle: "当地下城崛起之时"
	quest.6BCEC1A3B697DABE.title: "地牢传说"
	quest.6BEBFBFD51FE589A.quest_desc: ["向雕像祈祷，用灵魂球换取更多生命值或耐力。"]
	quest.6BEBFBFD51FE589A.title: "带角的雕像"
	quest.6BED9D42446EC716.quest_desc: ["用于存放附魔书，并允许你提取任何已解锁等级的附魔。"]
	quest.6BFE5D35265080E6.quest_desc: ["巨大的地下堡垒，焦灼矿井从中央穹顶向四个方向延伸。隧道里充满热量与阴影，处处暗藏危险。勇敢冒险者若能穿越错综复杂的路径，或许能发现宝藏，前提是能活过其中的重重险阻。"]
	quest.6BFE5D35265080E6.quest_subtitle: "找到焦灼矿井 (Scorched Mines)"
	quest.6C457F6B4DCC7DB8.quest_desc: ["击败她的瓦尔基里以赢得胜利奖章——只有这样，女王才会接受你的挑战。"]
	quest.6C457F6B4DCC7DB8.quest_subtitle: "银色地牢"
	quest.6C457F6B4DCC7DB8.title: "瓦尔基里女王"
	quest.6C6ADBA003AEA8FD.title: "高级压缩机"
	quest.6C7E53A4792B2249.quest_desc: ["两款附加包为 Iron's Spells 'n Spellbooks 添加了学校、法术和法师护甲——由 Cataclysm 的 boss 和 Alex's Caves 的生物群生成。"]
	quest.6C7E53A4792B2249.title: "更多法术 (More Spells)"
	quest.6C8EF8F603BE09B6.quest_desc: ["进入&a有毒洞穴&r。没有防护请勿久留！"]
	quest.6C8EF8F603BE09B6.title: "辐射区"
	quest.6CA3F93FF5E2BD22.title: "幻术师"
	quest.6CAF6F9F3FACE781.quest_desc: ["会自动从背包中为你提供食物。"]
	quest.6CB5ACBAAED66871.quest_desc: ["由巨型菌菇的菌柄和菌盖塑形而成，这座别致的住所为险恶的世界增添了一抹独特的魅力。守卫松散，易于占领，蘑菇屋是一个绝佳的庇护所，适合任何梦想着将蘑菇称为家的冒险者。"]
	quest.6CB5ACBAAED66871.quest_subtitle: "找到一个蘑菇屋"
	quest.6CBF0E8BFDF02291.quest_desc: ["Oritech 是一个包含动画机器、激光甚至粒子加速器的现代科技模组。电机是第一个关键部件。"]
	quest.6D3856516544C296.quest_desc: ["选择任意生物群系，罗盘会指向最近的生物群系。"]
	quest.6D3856516544C296.title: "自然指南针"
	quest.6D3B7F9D1AB765E4.quest_desc: ["将每种代币献给神明，以获得其更强的版本：Euphoria、Terror、Rage 和 Grief。"]
	quest.6D3B7F9D1AB765E4.title: "众神赐予的礼物"
	quest.6D7F4962B4200281.quest_desc: [
		"制作一个滑翔伞。"
		""
		"从高处跳下并按住使用键。会发生什么意外呢？"
	]
	quest.6D7F4962B4200281.title: "我相信我能飞翔"
	quest.6DEE76E4D23A69D0.quest_desc: [
		"OneDay的每条路径都以一个&d核心&r结尾：科技、神秘、泰拉瑞亚、战士、探险家和生命。"
		""
		"将六个物品放在&5星祭坛&r上，并使用&f下界之星&r来启动仪式。仪式产物是&6一日之星&r。"
		""
		"第一次持有核心时，系统会提示你接受其称号——&aaccept&r 以佩戴在名字下方，或留待以后使用。"
	]
	quest.6DEE76E4D23A69D0.quest_subtitle: "一切的一切都指向这里"
	quest.6DEE76E4D23A69D0.title: "最终目标"
	quest.6DFB02BE2BBCD53E.title: "龙之塔"
	quest.6E2FB124C12A35BC.quest_desc: [
		"Artifacts、Relics、Nameless Trinkets 和 Jewelry 为配饰栏添加了装备。大多数都可在地牢宝箱中找到。"
		""
		"&7与泰拉瑞亚配饰效果相同的项目已被移除，因此每种效果仅存在一次。"
	]
	quest.6E2FB124C12A35BC.title: "宝藏猎人"
	quest.6E321AF25C05CCB8.quest_desc: [
		"完成&eAutomation Extras&r中的所有任务，即可获得&bAutomation Legend&r称号。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.6E321AF25C05CCB8.quest_subtitle: "自动化扩展模组"
	quest.6E321AF25C05CCB8.title: "自动化传奇"
	quest.6E5327D2F443DA95.quest_desc: [
		"模组的核心。在森林仪式中制作它，并按照书中的指示在其周围建造多方块结构。"
		""
		"祭坛会从其周围吸收灵气，并用灵气来灌注物品。"
	]
	quest.6E5327D2F443DA95.title: "自然祭坛"
	quest.6E86008C7CEFAE74.quest_desc: ["背包、更大的箱子、抽屉和连锁储物。"]
	quest.6E86008C7CEFAE74.title: "储物空间"
	quest.6E94B9B7AEF70C13.quest_desc: [
		"与村民交易以获取绿宝石。"
		""
		"使用简易村民，你可以抱起村民（潜行+右键），将他们放入紧凑型交易和耕种方块中。"
	]
	quest.6E94B9B7AEF70C13.title: "来做一笔交易吧"
	quest.6EAA252360104223.quest_desc: [
		"在地下深处击败一个不死矿工。"
		""
		"他没有认真听采矿安全说明会。"
	]
	quest.6EAA252360104223.title: "Diggy Diggy Hole"
	quest.6EBA6557671FA8BB.quest_desc: ["与安山岩外壳类似，但使用黄铜锭代替去皮木材。"]
	quest.6EBA6557671FA8BB.title: "黄铜外壳"
	quest.6EF83C670D585029.title: "托帕斯锭"
	quest.6F149777AD4BDAA4.quest_desc: ["踏入漆黑的&8Forlorn Hollows&r。有什么东西在注视着你。"]
	quest.6F149777AD4BDAA4.title: "Forlorn Hollows"
	quest.6F47AE101E338200.quest_desc: ["创造与附加：用Alternator将FE转化为旋转，再将旋转转化为FE。"]
	quest.6F47AE101E338200.title: "电动机"
	quest.6F73B9370E06D190.quest_desc: ["建造一个：一个铜块，上面放一个避雷针，再放一个雕刻过的南瓜……或者顺序反了？"]
	quest.6F73B9370E06D190.title: "铜质哥布林"
	quest.6F8928169EEE5D2E.quest_desc: ["主世界、下界和末地的所有强大首领都败在了你手下。鲜有人能与之匹敌。"]
	quest.6F8928169EEE5D2E.title: "世界传说 (Legend of the World)"
	quest.6F8F92B91DE4F273.quest_desc: ["锌矿石藏在地下。你之后制作黄铜时会需要它。"]
	quest.6F8F92B91DE4F273.title: "锌"
	quest.6F9166B196185FD6.quest_desc: ["将墨水、纸张和一件学校专注物品组合，锻造出你所需法术的卷轴。"]
	quest.6F9166B196185FD6.title: "卷轴锻造台"
	quest.6FD2FD1F7F98537C.quest_desc: ["在末影人或末影幼虫上使用光敏玻璃板。"]
	quest.6FD2FD1F7F98537C.quest_subtitle: "末影透镜能让太阳能电池板看穿方块，使其在方块下也能吸收阳光。"
	quest.6FFB45B92B717ACB.title: "Exo Armor"
	quest.701A1B975557266B.quest_desc: [
		"Ignitium、Dragon Bones、Cursium 和一颗 Nether Star 围绕着一个 Eclipse Ingot。"
		""
		"标题：&d战士传奇"
	]
	quest.701A1B975557266B.title: "战士核心"
	quest.70327C3AC547B354.quest_desc: ["这座神庙以其深色的海晶灯和黄色陶瓦屋顶为标志，却早已堕落腐化。内部，成群的蜘蛛状生物在走廊中爬行，用毒液和凶猛发起攻击。踏入其中，便是走进一个每个影子都在蠕动的巢穴。"]
	quest.70327C3AC547B354.quest_subtitle: "找到一个被感染的寺庙"
	quest.703E63863A7F764B.quest_desc: [
		"完成&eExtreme Reactors&r中的所有任务，即可获得&bReactor Operator&r称号。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.703E63863A7F764B.quest_subtitle: "极端反应堆模组 (Extreme Reactors)"
	quest.703E63863A7F764B.title: "反应堆操作员"
	quest.7052C9A5A804E866.quest_desc: ["一片色彩从荒野中升起，标记着狡猾掠夺者团伙的领地。他们的家园明亮诱人，但请自行承担风险。这些守卫者出手迅速而频繁。胜利者将在鲜活的建筑外观中，发现隐藏的宝藏与秘密。"]
	quest.7052C9A5A804E866.quest_subtitle: "找到一个强盗村庄"
	quest.705B6D09488D0827.quest_desc: ["包装工将物品装入纸板箱，蛙港和链式传送带负责运输，而股票行情显示器则让你能从连接的储物箱中订购任何物品。"]
	quest.705B6D09488D0827.title: "物流整合包"
	quest.7082AEBD823830D3.quest_desc: [
		"与村民交谈100次。"
		""
		"“嗯……” – “嗯！” – “嗯……？” 一场引人入胜的对话。"
	]
	quest.7082AEBD823830D3.title: "闲聊时间"
	quest.70C4870310CE7668.title: "液态经验值"
	quest.70E70DCF0E8FC204.quest_desc: ["伫立于高耸的石塔之巅。战胜它的考验，即可获得大地崩裂手套。"]
	quest.70E70DCF0E8FC204.title: "雕塑家"
	quest.70EDEA90B42F1D78.quest_desc: [
