	quest.492B94F2CC054864.quest_desc: ["将升级球与一个学派材料融合，然后在奥数砧上应用，以增强你装备上该学派的威力。"]
	quest.492B94F2CC054864.title: "升级球体"
	quest.497FB5F5849F7912.quest_desc: [
