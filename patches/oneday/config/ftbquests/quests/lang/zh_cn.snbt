	quest.48FB131DF1CF284A.quest_desc: [
		"本整合包有&6大量&r快捷键。它们已排序，确保重要快捷键不重叠。下方的按键始终显示&o你&r当前的绑定。"
		""
		"&6&l通用任务"
		"[\"\",{\"text\":\"• 打开背包： \"},{\"keybind\":\"key.sophisticatedbackpacks.open_backpack\",\"color\":\"gold\"},{\"text\":\"\"}]"
		"[\"\",{\"text\":\"• Curios (配饰栏位): \"},{\"keybind\":\"key.curios.open.desc\",\"color\":\"gold\"},{\"text\":\"\"}]"
		"[\"\",{\"text\":\"• 饰品栏位 (RPG 装备): \"},{\"keybind\":\"accessories.key.open_accessories_screen\",\"color\":\"gold\"},{\"text\":\"\"}]"
		"[\"\",{\"text\":\"• 技能树： \"},{\"keybind\":\"key.puffish_skills.open\",\"color\":\"gold\"},{\"text\":\"\"}]"
		"[\"\",{\"text\":\"• Ultimine (按住): \"},{\"keybind\":\"key.ftbultimine\",\"color\":\"gold\"},{\"text\":\"\"}]"
		"[\"\",{\"text\":\"• 切换磁铁： \"},{\"keybind\":\"simplemagnets.keys.toggle\",\"color\":\"gold\"},{\"text\":\"\"}]"
		"{@pagebreak}"
		"&d&l魔法"
		"[\"\",{\"text\":\"• 铸铁的咒语： \"},{\"keybind\":\"key.irons_spellbooks.spellbook_cast\",\"color\":\"gold\"},{\"text\":\"\"}]"
		"[\"\",{\"text\":\"• 铁魔法轮（按住）： \"},{\"keybind\":\"key.irons_spellbooks.spell_wheel\",\"color\":\"gold\"},{\"text\":\"\"}]"
		"[\"\",{\"text\":\"• 打开 Ars Nouveau 魔法书： \"},{\"keybind\":\"key.ars_nouveau.open_book\",\"color\":\"gold\"},{\"text\":\"\"}]"
		"[\"\",{\"text\":\"• Ars Nouveau 法术选择： \"},{\"keybind\":\"key.ars_nouveau.selection_hud\",\"color\":\"gold\"},{\"text\":\"\"}]"
		"[\"\",{\"text\":\"• 遗物能力（按住）： \"},{\"keybind\":\"key.relics.active_abilities_list\",\"color\":\"gold\"},{\"text\":\"\"}]"
		""
		"&a&l泰拉瑞亚 (Confluence)"
		"[\"\",{\"text\":\"• 投掷钩爪： \"},{\"keybind\":\"key.confluence.hook\",\"color\":\"gold\"},{\"text\":\"\"}]"
		"[\"\",{\"text\":\"• 快速治疗： \"},{\"keybind\":\"key.confluence.healing\",\"color\":\"gold\"},{\"text\":\"\"}]"
		"[\"\",{\"text\":\"• 快速法力： \"},{\"keybind\":\"key.confluence.mana\",\"color\":\"gold\"},{\"text\":\"\"}]"
		"[\"\",{\"text\":\"• 召唤坐骑： \"},{\"keybind\":\"key.terra_entity.ride\",\"color\":\"gold\"},{\"text\":\"\"}]"
		"{@pagebreak}"
		"&b&l盔甲与小工具"
		"盔甲能力位于方向键上方的六键区块上："
		"[\"\",{\"text\":\"• 头盔能力： \"},{\"keybind\":\"key.mekanism.head_mode\",\"color\":\"gold\"},{\"text\":\"\"}]"
		"[\"\",{\"text\":\"• 胸甲 / 喷气背包： \"},{\"keybind\":\"key.mekanism.chest_mode\",\"color\":\"gold\"},{\"text\":\"\"}]"
		"[\"\",{\"text\":\"• 护腿： \"},{\"keybind\":\"key.mekanism.legs_mode\",\"color\":\"gold\"},{\"text\":\"\"}]"
		"[\"\",{\"text\":\"• 靴子： \"},{\"keybind\":\"key.mekanism.feet_mode\",\"color\":\"gold\"},{\"text\":\"\"}]"
		"[\"\",{\"text\":\"• 喷气背包悬停/盔甲菜单： \"},{\"keybind\":\"keybind.ironjetpacks.hover\",\"color\":\"gold\"},{\"text\":\"\"}]"
		"[\"\",{\"text\":\"• 灾变武器能力： \"},{\"keybind\":\"key.cataclysm.ability\",\"color\":\"gold\"},{\"text\":\"\"}]"
		""
		"&7一切都可以在 选项 → 控制 → 按键绑定 中更改（有搜索栏！）。"
	]
	quest.48FB131DF1CF284A.quest_subtitle: "本整合包快捷键的速查表"
