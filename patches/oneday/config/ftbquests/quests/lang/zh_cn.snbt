	quest.738488F09895F017.quest_subtitle: "Industrial Foregoing"
	quest.738488F09895F017.title: "工业传奇"
	quest.73ACDE3764FEC57D.quest_desc: ["凋零有时会掉落&8凋零之魂&r。用三个合成凋零骷髅头——用于下一个凋零。"]
	quest.73ACDE3764FEC57D.title: "凋零的灵魂"
	quest.73D5EE5238C37982.quest_desc: ["荒野中，一具伟大生物的骸骨静卧着。它的骨架如苍白骨骼的枝桠般伸向天际。无论是被遗忘神话的遗迹，还是曾被猎至灭绝的野兽，无人知晓。它无声的躯骸，是献给那些早已逝去的生物的纪念碑。"]
	quest.73D5EE5238C37982.quest_subtitle: "找到一只基里尼亚鹿（Ceryneian Hind）"
	quest.741BFBD38C8EF8B4.quest_desc: [
		"在合成网格中粉碎金叶子。"
		""
		"将金粉放置在地面上，以绘制森林仪式的图案。"
	]
	quest.74281B45B88EC96C.quest_desc: ["将多余的种子变回精华。"]
	quest.74281B45B88EC96C.title: "种子再处理器"
	quest.742C90C16A61E36A.quest_desc: ["将龙之息收集在玻璃瓶中，以酿造滞留药水。"]
	quest.7439A83EED6A9A7A.quest_desc: ["一种在维度矿井中开采另一个维度矿石的灵体。"]
	quest.744B14EA1C1AA63F.quest_desc: ["一次性放置整排方块、墙壁和地板，由能量驱动。"]
	quest.747523A8C5DCF62D.quest_desc: ["钻石深藏于地下，越接近世界底部就越常见。"]
	quest.747523A8C5DCF62D.title: "钻石！"
	quest.75245F21D946DC53.quest_desc: ["远古残骸隐藏在末地深处，并且免疫岩浆。"]
	quest.7547721B08FA48DB.title: "秋日枫树林"
	quest.7553E9755A3649D4.title: "蘑菇苦力怕"
	quest.7584747C52E6CA67.quest_desc: ["仪式熔炉会激活仪式石板——从改变天气到召唤怪物。"]
	quest.7584747C52E6CA67.title: "仪式"
	quest.75E11761F6BF6378.quest_desc: [
		"祭坛上六个核心，手中一颗下界之星——全服务器都会知道你做了什么。"
