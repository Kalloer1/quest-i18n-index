	]
	quest.2B25EFDEE54738C0.quest_subtitle: "Oritech"
	quest.2B25EFDEE54738C0.title: "奥里泰克传奇"
	quest.2B345D5D30682204.quest_desc: ["Malum 齿轮的主要金属材质。"]
	quest.2B34FBDC49D1BD27.quest_desc: ["在末地飞船上发现。用烟花火箭助推飞行！"]
	quest.2B4EB97207C17BF1.title: "末影之手"
	quest.2B4FA5AF9CA29917.quest_desc: ["将一块紫水晶碎片放入其中。使用附近罐子中的源，它会变成源宝石。"]
	quest.2B4FA5AF9CA29917.title: "附魔室 (Imbuement Chamber)"
	quest.2B70445E6CD99EDB.quest_desc: [
		"奇怪的建筑物开始从地面升起。神秘的地下城、堡垒和直插云霄的塔楼。无人知晓它们的来历，只知道里面充满了敌对生物、被遗忘的宝藏和强大的秘密。"
		""
		"你的任务是勇往直前，揭开这些古老之地的奥秘。每个地牢都隐藏着新的危险，但也握有生存的关键：武器、遗物，以及能助你在未来试炼中一臂之力的知识。"
		""
		"做好准备，冒险家。在这片土地本身都会反抗你的世界里，唯有&6探索&r和勇气才能让你生存下去。"
	]
	quest.2B73F6E783CCE120.quest_desc: [
		"完成&e职业与技能&r中的所有任务，即可获得&b职业传奇&r称号。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.2B73F6E783CCE120.quest_subtitle: "职业与技能"
	quest.2B73F6E783CCE120.title: "传奇职业类别"
	quest.2B7C41AC2EDAFEE8.title: "Allthemodium 镐"
	quest.2BAF3EC18F560BA8.title: "Tier 4 火箭"
	quest.2BE947578C4376E3.quest_desc: [
		"繁殖100只动物。"
		""
		"空气中弥漫着爱意。还有那独特的香气。"
	]
	quest.2BE947578C4376E3.title: "Matchmaker"
	quest.2BF17F038002421F.title: "夜视仪（Night Vision Goggles）"
	quest.2BF586D9CF3DB78A.quest_desc: ["主动冷却的核反应堆产生蒸汽而非电力。涡轮机将蒸汽转化为更强大的电力。"]
	quest.2BF586D9CF3DB78A.title: "蒸汽涡轮机"
	quest.2BFCEB78FC617833.quest_desc: ["看来传言是真的。"]
	quest.2BFCEB78FC617833.title: "由奶酪制成"
	quest.2C0442E2897E8966.quest_subtitle: "扳手是一种用于旋转powah机械、配置能量电缆，甚至将某些电杆连接到储能球上的工具。"
	quest.2C0442E2897E8966.title: "电工的得力助手"
	quest.2C1D61FDEA4E0727.quest_desc: ["将物品冻结成它们的冰质变体。"]
	quest.2C1D61FDEA4E0727.title: "冷冻柜"
	quest.2C464165A8B72138.quest_desc: [
		"一个带有独特生物群系、矿石、NPC、事件和首领的泰拉瑞亚风格世界。"
		""
		"《&a🌳 泰拉瑞亚&r》的每个章节都发生在这里：腐化之地、猩红之地、丛林、地牢、地下世界——最后是专家模式。"
	]
	quest.2C464165A8B72138.title: "欢迎来到另一个世界 (Welcome to the Otherworld)"
	quest.2C52EBD853EB5B57.title: "The Beyond"
	quest.2C6935998A72954C.quest_desc: ["把它放在农田下面。堆叠更多可以加快速度——在OneDay里，它们每30秒就会更新一次。"]
	quest.2C6935998A72954C.title: "生长加速器"
	quest.2C711EB3A5D39E46.quest_desc: ["齿轮轴将旋转沿直线传递，齿轮则将其横向传递。相邻的大小齿轮会改变速度。"]
	quest.2C711EB3A5D39E46.title: "齿轮与传动轴"
	quest.2C772659389D3ACF.quest_desc: [
		"完成&eImmersive Engineering&r中的所有任务，以获得&b工程师传奇&r称号。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.2C772659389D3ACF.quest_subtitle: "Immersive Engineering"
	quest.2C772659389D3ACF.title: "工程师传奇"
	quest.2C933B5925987707.quest_desc: ["一个能对方块使用物品的机械手。它是序列组装的关键部分。"]
	quest.2C933B5925987707.title: "部署器"
	quest.2CAD065982384694.quest_desc: ["高大的紫色塔楼，由潜行兽守卫。有些塔楼附有船只。"]
	quest.2CAD065982384694.title: "末地城市"
	quest.2CCB8556A20763D6.quest_desc: [
		"完成&eThe Shimmer&r中的所有任务，即可获得&bShimmer Legend&r称号。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.2CCB8556A20763D6.quest_subtitle: "The Shimmer"
	quest.2CCB8556A20763D6.title: "闪耀传说"
	quest.2CD9A5B2BF9AD745.title: "深渊符文"
	quest.2CE2E7816C6866AF.quest_desc: ["这本书会在必要时帮助你理解该模组。"]
	quest.2CE2E7816C6866AF.quest_subtitle: "欢迎来到 Powah！这是一个用于为几乎所有可用科技机械提供动力的发电机模组。学会如何使用它们，将赋予你无需燃料即可运行机械的能力。"
	quest.2CE2E7816C6866AF.title: "电工的第一份工作"
	quest.2CE8A079E93C065D.title: "能量电池"
	quest.2CF0AA866AF956C4.quest_desc: ["更大的箱子。使用箱子升级物品原地升级。"]
	quest.2CF342153B5560A6.quest_desc: ["Gravitite 矿石位于高空的稀有岛屿上。在祭坛上为其附魔。"]
	quest.2CF342153B5560A6.title: "Gravitite"
	quest.2D2784BC6AE02D19.title: "黑金"
	quest.2D341EEAB901B55C.quest_desc: ["四个下界合金碎片和四个金锭可以合成一个下界合金锭。"]
	quest.2D57C764F6A68BEF.title: "木乃伊"
	quest.2D682C9032C61CBA.quest_desc: ["将其放置在光环发生器正下方，这样即使区域已满，它也能持续产生光环。"]
	quest.2D894DA57337C966.quest_desc: ["&7由伟大冰冷生物的残骸锻造而成，每一次挥舞都能感受到它最后的战斗余温。"]
	quest.2D894DA57337C966.quest_subtitle: "凝视深渊之人..."
	quest.2D951D3E552190C2.quest_desc: [
		"Xaero's Minimap and World Map 会为你追踪一切："
		""
		"[\"\",{\"text\":\"• \"},{\"keybind\":\"gui.xaero_open_map\",\"color\":\"gold\"},{\"text\":\" 打开完整的世界地图。\"}]}]"
		"[\"\",{\"text\":\"• \"},{\"keybind\":\"gui.xaero_new_waypoint\",\"color\":\"gold\"},{\"text\":\" 会在你的位置创建一个新的 Waypoint。\"}]}]"
		"[\"\",{\"text\":\"• \"},{\"keybind\":\"gui.xaero_waypoints_key\",\"color\":\"gold\"},{\"text\":\" 列出你所有的 Waypoint。\"}]]"
		"[\"\",{\"text\":\"• \"},{\"keybind\":\"gui.xaero_minimap_settings\",\"color\":\"gold\"},{\"text\":\" 打开小地图设置。\"}]}]"
		""
		"&e在出发进行长途探险前，务必先在你的基地设置一个路标！"
	]
	quest.2D951D3E552190C2.title: "迷路已经是昨天的新闻了"
	quest.2D968C2FFD552BE7.quest_desc: ["在灵火中燃烧不纯的白垩以净化它。用它画出五芒星。"]
	quest.2DA474B78CB0DD5A.title: "恶意法典 (Codex of Malice)"
	quest.2DB4F395EA26DF4B.quest_subtitle: "找到一个竞技场 (Coliseum)"
	quest.2DBBAC5AFE741ACE.quest_desc: ["熔炼或爆破原始月石。Mekanism 和 Immersive Engineering 可让你的矿石翻倍。"]
	quest.2DBBAC5AFE741ACE.title: "Lunarium Ingot"
	quest.2DD033ED1CCAA89F.quest_desc: [
		"完成&eMystical Agriculture&r中的所有任务，以获得&bMystical Farmer&r称号。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.2DD033ED1CCAA89F.quest_subtitle: "神秘农业（Mystical Agriculture）"
	quest.2DD033ED1CCAA89F.title: "神秘农夫"
	quest.2DF6E44D44DCB238.quest_desc: ["Skyroot 工具可从许多 Aether 方块中获得双倍掉落物。"]
	quest.2DF6E44D44DCB238.title: "Skyroot 工具"
	quest.2DF94FB433DD8C60.quest_desc: [
		"完成&eEnder IO&r中的所有任务，即可获得&bEnder IO Legend&r称号。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.2DF94FB433DD8C60.quest_subtitle: "Ender IO"
	quest.2DF94FB433DD8C60.title: "Ender IO 传奇"
	quest.2E0B0A2023A49822.title: "Peridot Ingot"
	quest.2E766ACF5DD9BB41.title: "Ethereal Wings"
	quest.2E7F0DA00B3D3815.quest_desc: ["制作一张洞穴群系地图。它会指向最近的同类型洞穴群系。"]
	quest.2E7F0DA00B3D3815.title: "旅程的开始"
	quest.2E8EDA4D13F40A9B.quest_desc: ["在锻造台处，将下界合金装备 + 蓝宝石升级锻造模板 + 蓝宝石锭组合。"]
	quest.2E8EDA4D13F40A9B.title: "蓝宝石升级"
	quest.2E99B6AFD62C74AF.title: "加热器护盾"
	quest.2EC1379445B2FCA5.quest_desc: ["巫师精通奥术、火焰和冰霜魔法。"]
	quest.2EC1379445B2FCA5.title: "巫师"
	quest.2EE472F7CA58DF74.quest_desc: ["烈焰棒可为酿造台提供燃料，也是制作末影之眼所需的材料。"]
	quest.2EEB8FB014A2D6B3.quest_desc: ["在堡垒的箱子里可以找到。用钻石和下界岩复制它。"]
	quest.2EFC5DBD8122A0AE.quest_desc: ["地表深处，扭曲的密室网络中，空气弥漫着疾病与阴影。这里曾是疗伤之所，如今却宛如被遗忘君王的坟场，回廊中回荡着逝者低语。唯有勇者（或绝望者）敢于踏入这鬼魅的走廊。"]
	quest.2EFC5DBD8122A0AE.quest_subtitle: "找到一个瘟疫收容所"
	quest.2F1A99A6CAF8BCAF.quest_desc: ["将Unobtainium和Vibranium熔合在一起，铸造出最强的合金。"]
	quest.2F1A99A6CAF8BCAF.title: "终极合金 The Ultimate Alloy"
	quest.2F6A9D49B2D0622F.quest_desc: [
		"将锭压制成薄片。将其放置在 Depot 或 Belt 上方并为其供电。"
		""
		"铁、金、铜和黄铜板可以解锁后续的大部分内容。"
	]
	quest.2F6A9D49B2D0622F.title: "机械压榨机"
	quest.2F70713C7F498671.quest_desc: ["用Wilden Tribute、Nether Star、Totem of Undying、Ender Pearls和Emeralds升级你的学徒之书。Tier 3的符文正在等待。"]
	quest.2F70713C7F498671.title: "大法师"
	quest.2F9E5B65C3ACE3BD.title: "蓝宝石"
	quest.2FA4CDF41B9C4731.quest_desc: ["一个漆黑一片、充满矿石和危险的洞穴世界。带上光源：黑暗本身会伤人。"]
	quest.2FA4CDF41B9C4731.title: "深地之下"
	quest.2FE74D0698201078.quest_desc: ["&7给它喂食。"]
	quest.2FE74D0698201078.quest_subtitle: "它想要你的某样东西。一样像它自己一样炽热的东西。一样既多又少的东西。"
	quest.2FEF1EF991E64653.quest_desc: ["在锻造台使用下界合金装备 + 玉升级锻造模板 + 玉锭。"]
	quest.2FEF1EF991E64653.title: "玉髓升级"
	quest.3000000000000001.quest_desc: [
		"Industrial Foregoing 专注于自动化：农场、生物刷怪和强大的激光钻头。"
		""
		"制作手册 (&7书 + 红石 + 泥土&r)，里面详细说明了每台机器。"
	]
	quest.3000000000000001.title: "欢迎来到工业向前模组（Industrial Foregoing）"
	quest.3000000000000002.quest_desc: ["将此机器朝向原木方块（如金合欢或深色橡木）放置，即可缓慢提取原始液态乳胶。"]
	quest.3000000000000002.title: "流体提取器"
	quest.3000000000000003.quest_desc: ["用流体提取器收集一桶完整的原始液态乳胶，为加工做好准备。"]
	quest.3000000000000003.title: "乳胶桶"
	quest.3000000000000004.quest_desc: ["Industrial Foregoing 的核心制造机。它将流体与物品结合，以制造高级部件——包括简易机器框架。"]
	quest.3000000000000004.title: "溶解室"
	quest.3000000000000005.quest_desc: ["用原木、铁和红石块制作怜悯机器框架。它是早期工业机械的底盘。"]
	quest.3000000000000005.title: "Pity Machine Frame"
	quest.3000000000000006.quest_desc: ["将乳胶和水输入&6乳胶处理器&r以获得微型干橡胶，然后将其合成干橡胶。"]
	quest.3000000000000006.title: "干橡胶"
	quest.3000000000000007.quest_desc: ["在熔炉中熔炼干橡胶以获得塑料——你需要很多塑料。"]
	quest.3000000000000007.title: "塑料薄片"
	quest.3000000000000008.quest_desc: ["在溶解室中注入铁、塑料板和金块，并加入乳胶，即可解锁一级机器组装能力。"]
	quest.3000000000000008.title: "简易机械框架"
	quest.3000000000000009.quest_desc: ["自动化你的作物种植。此方块会扫描上方区域，并整齐地重新种植种子、树苗或块茎。"]
	quest.3000000000000009.title: "种植播种机"
	quest.3000000000000010.quest_desc: ["完成农场循环。在运行半径内自动剪羊毛、破坏方块和收割成熟作物或木材。"]
	quest.3000000000000010.title: "植物采集者"
	quest.3000000000000011.quest_desc: ["通过自动将工业肥料成分直接注入生长作物中，提高耕作效率。"]
	quest.3000000000000011.title: "种植肥料 (Plant Fertilizer)"
	quest.3000000000000012.quest_desc: ["将此装置放置在成年农场动物下方，可持续吸走生物废料。"]
	quest.3000000000000012.title: "下水道排污系统"
	quest.3000000000000013.quest_desc: ["提取由你的牲畜废料收集循环产生的原始污水桶。"]
	quest.3000000000000013.title: "污水桶"
	quest.3000000000000014.quest_desc: ["将输入的液态污水压缩/干燥成富含养分的高等级实体工业肥料物品。"]
	quest.3000000000000014.title: "污水堆肥机"
	quest.3000000000000015.quest_desc: ["在溶解室中结合钻石矩阵、粉色史莱姆组件和金块，以建造二级加工结构。"]
	quest.3000000000000015.title: "高级机械框架"
	quest.3000000000000016.quest_desc: ["一种具有攻击性的收割机变种。它不会掉落物品，而是将目标生物直接溶解成液态肉和粉色史莱姆。"]
	quest.3000000000000016.title: "生物屠杀工厂"
	quest.3000000000000017.quest_desc: ["在屠宰框架内处理生物以分离出整桶粉红色的史莱姆副产品。"]
	quest.3000000000000017.title: "粉色史莱姆桶"
	quest.3000000000000018.quest_desc: ["将液态粉色史莱姆倒在地上，等待其生成史莱姆生物，将其击杀以获得实体粉色史莱姆宝石，并将其熔炼成锭。"]
	quest.3000000000000018.title: "粉色史莱姆锭"
	quest.3000000000000019.quest_desc: ["终极自动化执行单元。可瞬间击杀生物，收集其常规物品掉落物，并生成流体精华。"]
	quest.3000000000000019.title: "生物破碎机"
	quest.3000000000000020.quest_desc: ["获取一桶由自动化生物农场基础设施生成的浓缩流体精华（液态经验）。"]
	quest.3000000000000020.title: "精粹桶"
	quest.3000000000000021.quest_desc: ["在溶解室中熔炼下界合金废料、钻石齿轮块和塑料基座，以解锁Tier 3科技。"]
	quest.3000000000000021.title: "至尊机械框架"
	quest.3000000000000022.quest_desc: ["后期采矿循环的锚定组件。将结构激光场向下指向，以收集油和气体蒸汽。"]
	quest.3000000000000022.title: "流体激光基地"
	quest.3000000000000023.quest_desc: ["将多个激光钻头朝向流体或矿石激光底座放置。为其提供巨大能量以激活钻头光束。"]
	quest.3000000000000023.title: "激光钻头"
	quest.3000000000000024.quest_desc: ["直接从基岩空洞中吸取高级原始矿物，不会生成任何物理采石场孔洞。"]
	quest.3000000000000024.title: "矿石激光基地"
	quest.3000000000000025.quest_desc: ["终极模块化采矿工具。吸收大量生物电能，解锁巨型采矿半径区域。"]
	quest.3000000000000025.title: "无尽钻头"
	quest.300A44956434AC01.quest_desc: ["在锻造台使用下界合金装备 + 黄水晶升级锻造模板 + 黄水晶锭。"]
	quest.300A44956434AC01.title: "黄水晶升级"
	quest.300E001A9EB2F898.title: "凋零女巫"
	quest.30223DD04737A044.title: "海洋苦力怕"
	quest.303186C0892295E7.quest_desc: [
		"模组与否——Minecraft 自身的里程碑是每场冒险的支柱。"
		""
		"本章涵盖经典的 Overworld 发展流程。Nether 和 End 在 🌍 Dimensions 中有各自的章节。"
	]
	quest.303186C0892295E7.title: "原版生存之旅"
	quest.3038898771DD0C37.quest_desc: [
		"在草地上用唱片机播放一张音乐唱片。"
		""
		"山丘上生机勃勃。但它们有点困惑。"
	]
	quest.3038898771DD0C37.title: "音乐之声 (Sound of Music)"
	quest.306AAF14EBD13866.quest_desc: ["&7有人说灵魂是最重要的部分。有人说你不过是一团荷尔蒙和冲动的混合物。那如果两者都不是，又或是两者兼而有之呢？"]
	quest.306AAF14EBD13866.quest_subtitle: "是眼睛。永远都是眼睛惹的祸。"
	quest.306FD68533ABC4B4.quest_desc: ["有机堆肥会随着时间的推移慢慢变成肥沃的土壤。"]
	quest.30D5C690FF678141.title: "深渊术士"
	quest.30DC0540DDFFF5E3.quest_desc: ["友好的青蛙人生活在沼泽的村庄里。"]
	quest.30DC0540DDFFF5E3.title: "呱！"
	quest.3134599DABE1F2C1.quest_desc: [
		"首个击败每个首领的玩家将被永久载入服务器的&6名人堂&r。"
		""
		"输入 &e/oneday halloffame&r 可查看首个完成者。"
	]
	quest.3134599DABE1F2C1.title: "名人堂"
	quest.3140D81F441A94B4.quest_desc: [
		"完成&eUnique Weaponry&r中的所有任务，即可获得&bWeapon Master&r称号。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.3140D81F441A94B4.quest_subtitle: "独特武器系列"
	quest.3140D81F441A94B4.title: "武器大师"
	quest.315BE66F5DF44912.quest_subtitle: "用于制作绑定卡（Binding Cards）。"
	quest.3179F8CEEC5C2B27.quest_desc: ["最重要的新艺术运动材料。保持稳定的供应！"]
	quest.3179F8CEEC5C2B27.title: "源宝石"
	quest.3180BE9B5A2ADCBD.quest_desc: ["Ars Nouveau 盔甲分为 Sorcerer、Arcanist 和 Battlemage 套装。每件装备都有插槽可添加 Threads 以获得增益。"]
	quest.3180BE9B5A2ADCBD.title: "法师护甲"
	quest.31D04F84C8AE3ABB.title: "绝对工厂"
	quest.31DF407FAF33B128.quest_desc: ["来自埋藏宝藏的海之心，外加八个鹦鹉螺壳。可在附近获得水下呼吸和水下视觉。"]
	quest.3288C0C0CCD8C0B4.quest_desc: ["镐、斧和铲子三合一：Paxel。用你最喜欢的精华等级制作一个。"]
	quest.3288C0C0CCD8C0B4.title: "一把工具，搞定一切"
	quest.32994250A3C2ABB2.quest_desc: ["钓鱼是星露谷风格的迷你游戏：将绿色条保持在鱼上直到钓上鱼！"]
	quest.32994250A3C2ABB2.title: "去钓鱼了"
	quest.329D035B8D47D44D.quest_desc: ["大麦、燕麦、玉米、生菜和草莓在野外生长。开辟你自己的田地吧！"]
	quest.329D035B8D47D44D.title: "国家作物"
	quest.329E75277717E967.quest_desc: ["将宝石与宝石粉尘结合以升级宝石。"]
	quest.32C591A42D8C3C2E.quest_desc: ["&7你所见的任何背叛，都微不足道。用此物杀人之者，只为取乐或私利。曾是正直之刃，此武器如今却模仿着创造者扭曲的内心。"]
	quest.32C591A42D8C3C2E.quest_subtitle: "他露出一抹得意的笑容，刺向了他们认为他珍视的东西。"
	quest.32E7908C334674EC.quest_desc: ["用网捕捉生物，把它们带回家。"]
	quest.3313E43399CDA352.quest_desc: ["工程师的副武器——可在工作台处自定义。"]
	quest.3327E05B030ECEE0.quest_desc: [
		"完成&e所有章节的每个任务&r，并持有&6OneDay Star&r。"
		""
		"奖励：你的名字下会带上金色头衔 &6✦ OneDay Legend ✦&r，全服务器都会知道。"
		""
		"&7Optional quests do not count. Chapters of the Hall of Legends itself do not count either."
	]
	quest.3327E05B030ECEE0.quest_subtitle: "每个任务。每个章节。每条道路。"
	quest.3327E05B030ECEE0.title: "✦ 一日传奇 ✦"
	quest.33307AAA01BE9444.title: "沙地蠕虫"
	quest.3343B7550C09C341.quest_desc: ["&7邪恶从不认为自己邪恶。没有人选择邪恶，因为它邪恶，人们只是将其误认为善所追求之物。"]
	quest.3343B7550C09C341.quest_subtitle: "这把武器会像磁铁一样吸引愤怒。"
	quest.3352BD329214EB89.quest_desc: ["尽情挖掘，无需担心破坏你的主世界。"]
	quest.3352BD329214EB89.title: "采矿世界"
	quest.3355ED19D9F64532.quest_desc: ["隐藏在沙漠中。"]
	quest.3355ED19D9F64532.title: "Sandworm Nest"
	quest.337850CC7D7299F1.quest_desc: [
		"离开游戏50次。"
		""
		"关闭游戏算数。扔键盘不算数。"
	]
	quest.337850CC7D7299F1.title: "愤怒地退出游戏"
	quest.338C0436E3C5B61A.quest_desc: ["在容器之间搬运物品的自动运输机。"]
	quest.338FA84926455BFB.title: "雪怪（Yeti）"
	quest.33A637CCABFE3478.quest_desc: ["金星和水星灼热难耐。下界合金太空服能保护你免受高温侵袭。"]
	quest.33A637CCABFE3478.title: "感受炎热"
	quest.33C09B1CC6BCC9C4.quest_desc: ["在天然祭坛上注入石头。"]
	quest.33C1AF22808BBEFE.quest_desc: [
		"掉落 1,000 个物品。"
		""
		"你的物品栏更多只是一种建议而已。"
	]
	quest.33C1AF22808BBEFE.title: "黄油手指（Butterfingers）"
	quest.33C510D18355173E.quest_desc: ["用玻璃瓶从末影龙那里收集。你需要它来制作其他品种的蛋。"]
	quest.33C510D18355173E.title: "龙之息 (Dragon's Breath)"
	quest.33D7C5FA0D8D0DBA.quest_desc: [
		"完成&eThe Nether&r中的所有任务，以获得&bNether Legend&r称号。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.33D7C5FA0D8D0DBA.quest_subtitle: "下界"
	quest.33D7C5FA0D8D0DBA.title: "下界传奇"
	quest.33DBE8E47A2000EC.quest_subtitle: "能量漏斗可用于为箱子里的物品充能，无需使用能量球。"
	quest.342746FC5598B958.quest_desc: [
		"在床上睡觉 50 次。"
		""
		"再五分钟就好了……"
	]
	quest.342746FC5598B958.title: "专业瞌睡虫"
	quest.3447CA9EF02F3EAB.quest_desc: ["木制祭坛用于放置仪式的祭品。右键点击祭坛即可放置物品。"]
	quest.34825ED731B1F088.quest_desc: ["储存压缩空气，用于铜制潜水装备并为Extendo Grip等工具提供动力。"]
	quest.34825ED731B1F088.title: "铜制背囊"
	quest.348316BB2ECD45E2.quest_desc: ["氧气分配器能将封闭房间充满可供呼吸的空气。"]
	quest.348316BB2ECD45E2.title: "太空中的基地"
	quest.34B32CB987E86B55.quest_desc: ["金箔在传送带上经过部署器和压机多次加工。EMI 会显示每一步骤。"]
	quest.34B32CB987E86B55.quest_subtitle: "你的首个序列组装任务"
	quest.34B32CB987E86B55.title: "精密机械装置"
	quest.34BACF93066559BD.quest_desc: ["&7看来，你不是唯一对这把武器感兴趣的人。你不该惹恼蜂巢，或者至少，该让它们有别的理由可怒。"]
	quest.34BACF93066559BD.quest_subtitle: "你可以听到武器本身发出的嗡嗡声。"
	quest.34F9620E5D4A864C.quest_desc: ["制作一个空烈焰炉并用右键点击烈焰。将其置于水槽下方并添加燃料，即可提供&6热量&r。"]
	quest.34F9620E5D4A864C.title: "烈焰人燃烧器"
	quest.3534158821AF3154.quest_desc: ["每个生物群系都有自己的苦力怕。"]
	quest.3534158821AF3154.title: "Creeper Overhaul"
	quest.3538DE5BD564E72B.title: "第一之力"
	quest.356C54D4D638AE2F.quest_desc: [
		"在群山之中，矗立着一些小巧的圆形祭坛——半圆如日，半圆如月，中央立着一座日晷。"
		""
		"他们的箱子里通常装有&d日食升级锻造模板&r、日食锭，有时还有奥尼本人。"
	]
	quest.356C54D4D638AE2F.title: "日晷神龛"
	quest.357835CF18BA26E5.quest_desc: ["最高等级的精粹。"]
	quest.357835CF18BA26E5.title: "Supremium"
	quest.357DE55C2AE76AD4.quest_desc: [
		"植物学家的工具会利用灵气缓存中的灵气自我修复——保持不动并潜行。"
		""
		"用镐右键点击方块，将其变为苔藓版本。远古木棒来自成年远古树苗的木板。"
	]
	quest.3585BCA265F583FF.title: "黄水晶"
	quest.358C6CB7AB15450F.quest_desc: ["一个永远不会破碎的灌注水晶。"]
	quest.358C6CB7AB15450F.title: "大师级灌注水晶"
	quest.358D742BF236AFA7.quest_subtitle: "能量电池本质上是一种大容量电池，可以在机器生产能量较慢时，储存并向其他连接的机器传输能量。"
	quest.35BCDD94DB46EDC4.quest_desc: ["在地下挖掘 Inferium 矿石，或杀死生物——它们有时会掉落 Inferium 精华。"]
	quest.35BCDD94DB46EDC4.title: "Inferium 精华"
	quest.35C83E0771128C01.title: "发光蘑菇森林"
	quest.3606BECBA8D9D929.title: "Cursium 魔法师"
	quest.36276B9C85E01C2E.quest_desc: [
		"自己建造一个：一个被20个铜块包围的&bEnigmatic Engine&r（由Hullbreaker掉落），正面有6个Depth Glass。"
		""
		"或在深渊遗迹附近找到旧残骸，用铜锭修复。然后带上它去兜风！"
	]
	quest.36276B9C85E01C2E.title: "黄色潜水艇"
	quest.363DBB83D5A12D52.quest_desc: ["右键点击带有Gravitite工具的物品，使其向上漂浮！"]
	quest.363DBB83D5A12D52.title: "挑战地心引力"
	quest.36557DFA1DBA0E96.quest_desc: ["燃料提炼器可将石油提炼成燃料。所有获取石油的方法请查看EMI。"]
	quest.36557DFA1DBA0E96.title: "火箭燃料"
	quest.366EA20E32AA0729.quest_desc: ["乏燃料会变成青金石。它可以被再加工成血石。"]
	quest.366EA20E32AA0729.title: "物尽其用"
	quest.36C18805A70396A8.quest_desc: ["用灌注水晶将低级精华转化为高级精华——再也不用手动制作了。"]
	quest.36C18805A70396A8.title: "The Infuser"
	quest.36FB624E14ACC22C.title: "1M 组件"
	quest.36FCD662B4DB4E3D.quest_desc: ["通往三个额外世界的入口：&7采矿维度&r（主世界）、&c另一个世界&r（下界）和&5彼岸世界&r（末地）。站在对应维度的平台上，然后潜行。"]
	quest.36FCD662B4DB4E3D.title: "传送平台"
	quest.372B6EB1F66455B8.quest_desc: ["&7违背已知即为创造。但那回报会足够丰厚吗？"]
	quest.372B6EB1F66455B8.quest_subtitle: "异端邪说。"
	quest.3730DF78DFBAF0B7.quest_desc: ["直接从基岩中获取资源。"]
	quest.3730DF78DFBAF0B7.title: "基岩提取器"
	quest.378D1F288923842B.quest_desc: [
		"从世界顶部（建造高度限制）自由落体到世界底部并存活。"
		""
		"用水桶会很有帮助。祈祷也一样。"
	]
	quest.378D1F288923842B.title: "洞穴与山崖更新"
	quest.37B04BB6D9E8FBFD.title: "审慎（Prudentium）"
	quest.37CD6EBB40276EE2.quest_subtitle: "用于升级到烈焰机械的三阶电容器。"
	quest.37CF3A5652C8ACB6.title: "水星"
	quest.384E5189E0273AE7.quest_subtitle: "干冰用于冷却反应堆，是用水作为冷却剂的另一种替代方案。"
	quest.3879E0B671BFC250.title: "猎人腰带"
	quest.38B7B906C3682FF9.quest_desc: [
		"自然光环是关于&a光环&r——世界生命能量的故事。"
		""
		"用2个纸、皮革和任意树苗合成这本书。它解释了该模组的每个仪式和多方块结构。"
	]
	quest.38B7B906C3682FF9.title: "自然光环之书 (Book of Natural Aura)"
	quest.38BFCEECF99D81F5.quest_desc: [
		"放置鸡蛋并等待。繁殖结果取决于周围的方块——请使用栖息地检查器查看。"
		""
		"提示：用龙之息（OneDay 配方）制作另一种品种的蛋。"
	]
	quest.38BFCEECF99D81F5.title: "孵化中"
	quest.38C9A1B7439A7A1A.title: "采矿维度"
	quest.397D5E0DF0F51FDE.title: "干杯！"
	quest.39C169FC7DA4F87B.title: "下界骑士 The Underworld Knight"
	quest.39C67965E649E388.quest_desc: ["将发酵苹果汁酿成你的第一瓶葡萄酒。世界各地的葡萄还能酿出更多。"]
	quest.39C67965E649E388.title: "苹果酒"
	quest.39CC5E41A968D44D.quest_desc: ["富饶的土壤能促进植物生长，还能长出蘑菇群。"]
	quest.39E2E87B3D95BB79.title: "薰衣草花田"
	quest.3A2805EB2E39441B.quest_desc: ["刀可以收割草和作物的秸秆，并从动物身上获得更多掉落物，如火腿。"]
	quest.3A2805EB2E39441B.title: "锋利的开端"
	quest.3A333A884ED801AE.quest_desc: ["&7曾由伟大的奥术法师所赐。这把刀刃见过的远比大多数事物要多。"]
	quest.3A333A884ED801AE.quest_subtitle: "&7你不可能输，你已被选中。"
	quest.3A6590ECCFCFACA8.quest_desc: ["厨房储物柜，看起来就很有范儿。"]
	quest.3A778689A728B430.quest_desc: ["将物品一次性放入一整面墙的抽屉中。"]
	quest.3A8503F457566959.quest_desc: ["恐惧代币需要来自下界的瓶装鬼魂，悲伤代币需要瓶装阳光和恶魂之泪。"]
	quest.3A8503F457566959.title: "恐惧与悲伤"
	quest.3AB4D9F8483D0E46.title: "生物菌菇洞穴"
	quest.3AC1586D9FDB0382.title: "彩虹海滩"
	quest.3AC6475CF65969EC.title: "永恒牛肉 (Everlasting Beef)"
	quest.3ADBA2BF57A23E05.quest_desc: ["&7要成为更强大的存在，是所有成就中最孤独的一个。"]
	quest.3ADBA2BF57A23E05.quest_subtitle: "由锋利的火焰锻造而成的刀刃。"
	quest.3B1D7C24AC35261C.quest_desc: ["&7两场风暴，被一个把手锁链相连。你能感受到它的不稳定性。"]
	quest.3B1D7C24AC35261C.quest_subtitle: "风暴没有良心可言"
	quest.3B253027B3A56099.quest_desc: ["&7他已离去。我便是残存者。"]
	quest.3B253027B3A56099.quest_subtitle: "死亡在等待着你。"
	quest.3B28B46F411E584C.quest_desc: ["在深处之下，是末地传送门。用你的末影之眼填满它的框架。"]
	quest.3B28B46F411E584C.title: "要塞 (The Stronghold)"
	quest.3B2C0A65FEB535D9.quest_desc: [
		"厌倦了手动挖掘每一块方块？&6FTB Ultimine&r来帮你！"
		""
		"[\"\",{\"text\":\"• 破坏方块时按住 \"},{\"keybind\":\"key.ftbultimine\",\"color\":\"gold\"},{\"text\":\"（ESC 键下方的按键）\"}]]"
		"• 所有相连的同类型方块会同时破碎——非常适合矿脉和树木。"
		"• 锄头、斧头和铲子也可以使用。"
		""
		"&c注意：&r终极挖掘会消耗饥饿值和工具耐久度。"
	]
	quest.3B2C0A65FEB535D9.title: "以创纪录的速度挖掘方块"
	quest.3B493891D57C1D39.quest_desc: ["一个方块大小的紧凑型铁傀儡农场。"]
	quest.3B50D775CE678833.quest_desc: ["&7有光之处，必有黑暗。你确定能接受这个挑战吗？"]
	quest.3B50D775CE678833.quest_subtitle: "纯粹之光。"
	quest.3B7D37B660B16EFC.quest_desc: ["一次性挖掘 3x3 的区域。"]
	quest.3B7E1D3592DCCBD0.quest_desc: ["组合附魔、修理装备和重命名物品。"]
	quest.3B84B5EDD76E42CE.quest_desc: [
		"氮晶、精密机械、反物质和围绕日蚀锭的AE2奇点。"
		""
		"标题：&d科技传奇"
	]
	quest.3B84B5EDD76E42CE.title: "科技核心"
	quest.3B87676D899F9B6C.quest_desc: [
		"死亡 25 次。"
		""
		"重生界面现在知道你的名字了。"
	]
	quest.3B87676D899F9B6C.title: "专业重生器"
	quest.3B9DF96ED1DE3BA5.quest_desc: ["菜籽油可以提炼成用于油发电机的强力燃料。"]
	quest.3B9DF96ED1DE3BA5.title: "菜籽的力量"
	quest.3B9EE0E642B7E0D7.title: "完毕，收到请回复"
	quest.3BA1D7B63CB3CA6D.quest_desc: ["将金属组合成合金。"]
	quest.3BCBD6888B1EEF2B.title: "钻头核心"
	quest.3BD42621F23745E4.quest_desc: ["建造一个3x3x3的可乐砖立方体，然后用工程师之锤敲击其中一个面的中间方块。"]
	quest.3BD42621F23745E4.title: "焦炭炉 Coke Oven"
	quest.3BFBF2C34C80AB5B.quest_desc: [
		"在地下深处找到一个哥布林商人，并查看它。"
		""
		"哥布林喜欢好交易——带上绿宝石！下界也有矿脉哥布林。"
	]
	quest.3BFBF2C34C80AB5B.title: "哥布林模式"
	quest.3C0CFCE9A2700117.quest_desc: [
		"完成&eAd Astra&r中的所有任务，以获得&b太空传奇&r称号。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.3C0CFCE9A2700117.quest_subtitle: "Ad Astra"
	quest.3C0CFCE9A2700117.title: "太空传奇"
	quest.3C25BC0FE5230469.quest_desc: ["全套防护服可以保护你免受辐射伤害。"]
	quest.3C25BC0FE5230469.title: "穿戴装备"
	quest.3C2BDFF5A0241141.quest_desc: ["Harvester Pylon 会自动收割指定区块范围内的成熟作物，并将掉落物放入附带的箱子中。"]
	quest.3C2BDFF5A0241141.title: "收割者金字塔"
	quest.3C8BB7C2D6234870.quest_desc: [
		"想和另一支队伍的玩家一起打 boss？那就先让他们成为你的盟友吧："
		""
		"&e/oneday ally invite <player> [minutes]&r – 聊天框中会出现一个[接受]按钮。"
		""
		"友军将在友军误伤中计为队友，直到时间耗尽。结束前5分钟和1分钟会收到警告。"
		""
		"&7/oneday ally list – 显示你的盟友 /oneday ally leave – 提前结束联盟"
	]
	quest.3C8BB7C2D6234870.title: "临时盟友"
	quest.3CB351272478C435.quest_desc: ["将锭轧成棒材和线材。"]
	quest.3CB351272478C435.title: "Rolling Mill"
	quest.3CE95E50C6CC689A.quest_desc: ["在棕榈酒吧调制鸡尾酒——椰子、冰块和蜂蜜可以制作椰子鸡尾酒。"]
	quest.3CE95E50C6CC689A.title: "沙滩派对"
	quest.3CFAA0BF10CBEAFD.quest_desc: ["&7这把刀刃散发着背叛的恶臭，它永远改变了这把武器。那场背叛令人心碎，以至于不知情的人也无法将其遗忘。这把武器中的灵魂都浸透着内疚。"]
	quest.3CFAA0BF10CBEAFD.quest_subtitle: "&7卢修斯会喜欢的剑刃。"
	quest.3D1C0F80B74B27D5.quest_subtitle: "抵达一座灯塔"
	quest.3D90929CDE45D3D0.quest_subtitle: "岩浆怪用岩浆来发电。等级越高，消耗岩浆的功率和效率就越高。"
	quest.3DBCF334DAD80C9D.title: "Necoium Ingot"
	quest.3DC3752F77FD5CFF.quest_desc: ["太空很危险。你需要一套充满氧气的完整太空服。"]
	quest.3DC3752F77FD5CFF.title: "太空服"
	quest.3DEEF330074DD80C.quest_subtitle: "用于升级到硬化机械的二级电容器。"
	quest.3DF63B780E8E53D9.quest_desc: ["使用异世界的生态箱返回主世界。两个世界中的基地都会保留在你离开时的原样。"]
	quest.3DF63B780E8E53D9.title: "有去无回与归来之路"
	quest.3DF6E4D42850A8C2.title: "尚未探索的区域 (Regions Unexplored)"
	quest.3E0B33F83CD2E975.quest_desc: ["寻找任何结构——地牢、神庙、首领巢穴。"]
	quest.3E0B33F83CD2E975.title: "探险家指南针"
	quest.3E25B816816EFDEB.quest_desc: ["用锤子打造的3x3x3立方体爆裂砖。铁加焦煤焦可制成钢。"]
	quest.3E25B816816EFDEB.title: "简易高炉 (Crude Blast Furnace)"
	quest.3E3BE04155331A0A.quest_desc: ["将宝石从物品中取出，而不会将其破坏。"]
	quest.3E41284512370454.quest_desc: ["斧、铲子和锄头在白天挖掘速度加快 25%。"]
	quest.3E41284512370454.title: "完整的工具箱"
	quest.3E5207641E8653DC.quest_desc: [
		"&7To make it, combine a &bRunic Tablet&r &7with a &cEmpowered Remnant&r &7in a Smithing Table."
		""
		"&7点击以确认你抽到的能力是什么。"
	]
	quest.3E5207641E8653DC.quest_subtitle: "使用 &klol&r 制作"
	quest.3E8FF745496AF636.quest_desc: [
		"Apotheosis 添加了世界层级：更高的层级意味着更强大的敌人和更好的战利品。"
		""
		"[\"\",{\"text\":\"使用以下按键打开等级菜单：\"},{\"keybind\":\"key.apotheosis.open_world_tier_select\",\"color\":\"gold\"},{\"text\":\".\"}]]"
	]
	quest.3E8FF745496AF636.title: "世界层级 (World Tiers)"
	quest.3ECA226F08D5195F.quest_desc: ["隐藏在群山与山谷之间，这座修道院是危险世界中一处宁静的庇护所。村民们在此过着祈祷与劳作的生活，不受掠夺者侵扰。尽管殿堂中并无多少宝藏，但其坚固的墙壁与宁静的氛围，使其成为疲惫冒险者的理想避难所。"]
	quest.3ECA226F08D5195F.quest_subtitle: "找到一个修道院"
	quest.3ECF359C95BA8004.title: "热带海岸"
	quest.3EDA30B9D0544FFC.quest_desc: ["发射激光，将前方的方块和物品进行转换。所有转换类型请查阅手册。"]
	quest.3EDA30B9D0544FFC.title: "原子重组器"
	quest.3EF10B97D9FD1A2E.quest_desc: ["在此处制作新的符文，以扩展你法术的功能。"]
	quest.3EF10B97D9FD1A2E.title: "抄写员工作台"
	quest.3EF9F9717B1E19E8.quest_desc: ["并非所有事情都必须严肃。以下是本整合包中有趣、幸运和可爱的部分。"]
	quest.3EF9F9717B1E19E8.title: "纯粹为了好玩而已"
	quest.3F2C69919286C5E8.quest_desc: [
		"在冰冻之地击败一只 Frostbitten。"
		""
		"停下。合作，然后……快跑。"
	]
	quest.3F2C69919286C5E8.title: "冰上芭蕾"
	quest.3F3674745C46FED9.quest_desc: ["收集 16 个幸运方块。会发生什么坏事呢？"]
	quest.3F3674745C46FED9.title: "赌博成瘾症 (Gambling Addiction)"
	quest.3F565CA0DC4FE3A3.quest_desc: ["使用Ambrosium修复工具和附魔Aether材料。"]
	quest.3F565CA0DC4FE3A3.title: "附魔祭坛"
	quest.3F57A3A4E6B5DA2B.quest_desc: [
		"总共潜行一小时。"
		""
		"没有人看到你。所有人都看到了你。"
	]
	quest.3F57A3A4E6B5DA2B.title: "Sneaky Beaky"
	quest.3F60AB4FE7151613.title: "榨汁机"
	quest.3FA1F4E2C5A0E4C5.quest_desc: [
		"将水轮置于流动水中以产生旋转。带风帆和手摇柄的风车轴承也行。"
		""
		"稍后戴上工程师护目镜，看看你的网络能承受多少&6压力&r。"
	]
	quest.3FA1F4E2C5A0E4C5.quest_subtitle: "水车或风车"
	quest.3FA1F4E2C5A0E4C5.title: "第一之力"
	quest.3FD3D58312A98486.quest_desc: ["拾取范围内的物品，并将其放入下方的容器中。"]
	quest.3FED602264D3E938.quest_desc: [
		"完成&eSpellbook Addons&r中的所有任务，即可获得&bSpell Scholar&r称号。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.3FED602264D3E938.quest_subtitle: "Spellbook 附加组件"
	quest.3FED602264D3E938.title: "咒语学者"
	quest.3FF80A1FEE8CFD30.title: "地狱熔炉"
	quest.40150F69FF9873D7.quest_desc: ["传奇火术师的回响仍在世界某处燃烧。带上火焰抗性。"]
	quest.40150F69FF9873D7.quest_subtitle: "第一任火焰携带者"
	quest.40150F69FF9873D7.title: "泰罗斯的回声"
	quest.402B32F26CAE2A1E.title: "金星"
	quest.40358CDA0038D4BA.quest_desc: ["狂战士挥舞着重斧，凭借蛮力冲锋陷阵。"]
	quest.40358CDA0038D4BA.title: "战士"
	quest.404B537CF7E22BEF.quest_desc: ["制作这个之眼，像末影之眼一样投掷它——它会飞向&6Acropolis&r。"]
	quest.404B537CF7E22BEF.title: "找到卫城 (Acropolis)"
	quest.40A8D7121622CD60.quest_desc: ["皮革条和羊毛织物是软甲的基础。"]
	quest.40A8D7121622CD60.title: "材料"
	quest.40B3339A8D3D3278.quest_desc: ["把拾起的村民放进去，就能在一个方块里和它交易了。"]
	quest.40BF896ABF5FA668.quest_desc: ["让自动化更轻松、更有趣的迷你模组。"]
	quest.40BF896ABF5FA668.title: "自动化一切 (Automate Everything)"
	quest.40C5CFC3031DD7AD.quest_desc: [
		"让告示牌的文本发光。"
		""
		"因为霓虹灯下的“禁止入内”更吓人。"
	]
	quest.40C5CFC3031DD7AD.title: "闪耀与惊叹！"
	quest.40CCEB6B8EBA9ED2.quest_desc: [
		"&bLunarium Ore&r 深埋于深板岩中，位于 Y 0 以下。它在黑暗中会发出微弱的蓝光。"
		""
		"你需要至少一把&b钻石镐&r才能开采它。"
	]
	quest.40CCEB6B8EBA9ED2.title: "月亮的一块碎片"
	quest.40D041CF404F1C06.quest_desc: [
		"OneDay 中唯一的高级作物：可生长出 Powah's Nitro Crystals。"
		""
		"每个配方仍然需要 &eNether Star&r，所以凋灵仍然重要。此整合包中关闭了 Nether Star 和 Dragon Egg 的作物。"
	]
	quest.40D041CF404F1C06.title: "氮气作物"
	quest.41127E411F9967A7.quest_desc: [
		"蜂蜜蜜汁火腿盛宴、幸运方块、一个下界合金背包和一个围绕日蚀锭的龙之蛋。"
		""
		"标题：&d生命传奇"
	]
	quest.41127E411F9967A7.title: "生命核心"
	quest.4118927D9D079DC8.quest_desc: ["这些巨大的塔楼如尖刺般从地面升起，由缠绕着致命玫瑰的骷髅守卫。每一层都戒备森严，空中还有玫瑰守卫巡逻。只有登上顶峰的人，才能获得其中隐藏的宝藏和秘密。"]
	quest.4118927D9D079DC8.quest_subtitle: "前往荆棘之塔 (Thornborn Towers)"
	quest.416979EA4C74AF88.quest_desc: ["将钻头连接到机械轴承、活塞或矿车装置上，以建造隧道钻头和采石场。使用强力胶水将所有部件粘合在一起。"]
	quest.416979EA4C74AF88.title: "移动机械装置"
	quest.416D6B447B3DF038.quest_desc: ["遗物在使用时会升级——按 shift 键查看其能力。"]
	quest.416D6B447B3DF038.title: "堡垒之环"
	quest.41E2D38A68AC069F.title: "无限火腿包"
	quest.4234921C3DF2EBFE.quest_desc: ["在末地收集一些&c鬼魂&r，然后在森林仪式中制作愤怒代币。"]
	quest.42690A79E3CE85F3.title: "女神雕像"
	quest.427A9A0A4B4BB9AA.quest_desc: ["末影龙在主岛上等着你。与它的战斗是 💀 Bosses of the World 的一部分。"]
	quest.427A9A0A4B4BB9AA.title: "末地？"
	quest.42A67F5C0DA13C75.quest_desc: ["重掷物品的附加属性。"]
	quest.436231715C11E3BA.quest_desc: ["零星分布在野外，小股的掠夺者在其独特的紫色帐篷下扎营。尽管他们的补给微薄，战利品稀少，但他们的存在是一个警告，掠夺者的势力范围随着每个前哨站的建立而扩大。"]
	quest.436231715C11E3BA.quest_subtitle: "找到一个掠夺者营地"
	quest.4370B71D22B07358.quest_desc: [
		"Everything from &aConfluence&r – the Terraria part of this pack – lives in its own dimension: the &2Otherworld&r. Your Overworld stays a normal Minecraft world, so both never get in each other's way."
		""
		"加入时你收到了一个 &6Terrarium&r。用它来往返于主世界和异世界之间。"
		""
		"&7弄丢了？用玻璃板、树苗和木板合成一个新的吧。"
	]
	quest.4370B71D22B07358.quest_subtitle: "生态箱（The Terrarium）"
	quest.4370B71D22B07358.title: "通往异世界的门票，请收好"
	quest.43B614D2004AFB7E.quest_desc: ["一个带有配方记忆的自动合成台。"]
	quest.43B614D2004AFB7E.title: "RFTools Crafter"
	quest.43E154758356ECF0.quest_desc: ["巫师袍能提升法术强度。请选择奥术、火焰或霜冻。"]
	quest.4417AD6C1BD1A80A.quest_desc: ["哥布林在洞穴中游荡，用绿宝石换取稀有物品。脉管哥布林生活在下界。"]
	quest.4417AD6C1BD1A80A.title: "哥布林商人"
	quest.441CA314726CA8AB.quest_desc: [
		"&a兑换台&r可兑换&a绿宝石&r和&7银币&r——&a1 绿宝石&r = &715 银币&r，双向互通。主世界与另一个世界共享同一经济体系。"
		""
		"&7石匠也能将一颗绿宝石兑换成15枚银币，但只有兑换柜台能将银币换回绿宝石。"
	]
	quest.441CA314726CA8AB.title: "金钱至上"
	quest.44266A4B1118A31E.quest_subtitle: "用于升级到灵性机械的第五级电容器。"
	quest.446A7A2517450540.quest_desc: ["用于制作精粹配方的自动合成台。投入精粹，即可获得铁、钻石等物品。"]
	quest.446A7A2517450540.title: "The Crafter"
	quest.44A43AAFB17810E4.quest_desc: ["珠宝模组添加了宝石戒指、项链以及一些独特的特殊饰品。"]
	quest.44A43AAFB17810E4.title: "珠宝匠"
	quest.44BEFB55D357FD43.quest_desc: ["用巨型桶轮在地下深处挖掘整片矿脉。用岩心钻探机寻找矿脉。"]
	quest.44BEFB55D357FD43.title: "挖掘机"
	quest.44D115281B0BFB75.quest_desc: ["传言中，有一艘&9飞行船&r悬浮于世界之上，闪烁着奇异的光芒。鲜有人敢靠近，因为归来者都讲述了诡异的光、扭曲的走廊，以及不属于这个世界的守护者。如果你胆敢，就去寻找它，揭开藏在其金属外壳下的秘密。"]
	quest.44D115281B0BFB75.quest_subtitle: "找到一个巨型蘑菇"
	quest.44D87F68EC65B4AF.quest_desc: [
		"用花朵包围它，把想供奉的物品放入碗中，然后在旁边投下一个召唤之灵。"
		""
		"若众神应允，他们的馈赠便会从天而降。"
	]
	quest.44DF2808880BD984.quest_desc: ["被祖母绿方块包围的末地水晶。它在锻造台处校准传送器。"]
	quest.44E6A59C0FD32C69.quest_desc: ["在锻造台处，将下界合金装备 + 红宝石升级锻造模板 + 红宝石锭组合。"]
	quest.44E6A59C0FD32C69.title: "红宝石升级"
	quest.44EE18F81A61FCEE.quest_subtitle: "电容器是用于制造各种电气设备的下一个部件，你可以将两个电容器组合成一个大的，或者将一个电容器切割成两个小的。"
	quest.44EE18F81A61FCEE.title: "次要部件"
	quest.45156481B6D4B044.quest_desc: ["把它召唤到你所有珍爱的东西都远离的地方。"]
	quest.45156481B6D4B044.title: "凋零者"
	quest.45163F8A6463C455.quest_desc: ["&7猜到了吗？挥舞着刺比空挥要深一点。希望棍子别断。真丢人。"]
	quest.45163F8A6463C455.quest_subtitle: "这玩意儿说白了就是一根棍子上的剑。"
	quest.451C77FC19903965.quest_desc: ["灵魂仪式会在图腾底座周围创造区域效果。"]
	quest.4538F9B15C286DB5.quest_desc: ["Aether 的燃料——适用于祭坛、冷冻器、孵化器和火把。"]
	quest.4538F9B15C286DB5.title: "安布罗修姆（Ambrosium）"
	quest.453A6B33F5912461.quest_desc: [
		"跳进蜂蜜块里缓冲你的下落。"
		""
		"尝起来就像生存游戏一样。"
	]
	quest.453A6B33F5912461.title: "棘手的情况"
	quest.455328140F74C57D.quest_desc: ["果汁在发酵桶中会变成葡萄酒。"]
	quest.455378FC65B48C2F.quest_desc: ["建造一个酿造站，用啤酒花、干谷物和酵母酿造啤酒。"]
	quest.4574358CD870AE65.quest_desc: ["堡垒里到处都是猪灵和宝藏。穿上至少一件金盔甲，这样猪灵们才会保持平静。"]
	quest.4574358CD870AE65.title: "堡垒遗迹 (Bastion Remnant)"
	quest.45B6D09D25D07F7D.quest_desc: ["欢迎来到月球。低重力，无空气——还有奶酪？"]
	quest.45B6D09D25D07F7D.title: "一小步，一大步"
	quest.45CACD789D7D92DD.quest_desc: ["制作这个之眼，像末影之眼一样投掷它——它会飞向&6沉没之城&r。"]
	quest.45CACD789D7D92DD.title: "找到沉没的城市 (Find the Sunken City)"
	quest.4602FD0E33DD4D5E.quest_desc: [
		"&7铭文上写着，用生锈的血色颜料写着：</c1>"
		"&4今夜，我将自己束缚于你，&r"
		"&4无论刀如何移动，&r"
		"&4鲜血与骨骼铸就，&r"
		"&4血肉与心脏，&r"
		"&4死亡或许会降临，&r"
		"&4但我们不会就此分离。&r"
	]
	quest.4602FD0E33DD4D5E.quest_subtitle: "死亡誓言"
	quest.461E65850546FC41.quest_desc: ["在野外找到卷心菜、番茄、洋葱和大米，并把它们种在家里。"]
	quest.461E65850546FC41.title: "野生作物"
	quest.4636BDC0E4B33561.quest_desc: ["&7伤害掌控者者，必十倍偿还。"]
	quest.4636BDC0E4B33561.quest_subtitle: "这把刀刃上的火焰，如同汽油般，由仇恨所点燃。"
	quest.46554095B939F28C.quest_desc: ["&7不要畏惧你所见的背叛，而要畏惧你所看不见的背叛。"]
	quest.46554095B939F28C.quest_subtitle: "穿过心脏"
	quest.46786C23CB829A31.quest_desc: [
		"代币是承载情感的木制小雕像。它们在森林仪式中制作而成。"
		""
		"欢乐代币需要瓶装阳光。"
	]
	quest.469F2AAFF4D151AA.quest_desc: ["工程师工作台——蓝图化为工具和零件的地方。"]
	quest.469FFC7C9C4CD3F0.quest_desc: [
		"完成 &e创造&r 中的所有任务，即可获得称号 &b创造传奇&r。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.469FFC7C9C4CD3F0.quest_subtitle: "创建"
	quest.469FFC7C9C4CD3F0.title: "创造传奇"
	quest.46D9CF4217CC912A.quest_desc: ["在温暖的海洋遗迹中，可以用刷子从可疑的沙子里刷出嗅探者蛋。孵化它，获得一位远古的朋友！"]
	quest.46EE656C1F9E5CD5.quest_desc: ["&7这把武器见证了深暗的崛起。当它看到自己的家园时，会散发出喜悦的脉冲。"]
	quest.46EE656C1F9E5CD5.quest_subtitle: "一把传授了数百种技巧的刀刃。"
	quest.47092F2C0B394F1E.quest_desc: ["OneDay's 群系模组添加了超过一百个新群系。以下是一些最美的群系——自然指南针会帮上大忙！"]
	quest.47092F2C0B394F1E.title: "环球之旅"
	quest.474A7DE6B17761A6.quest_desc: ["击败凋零以获得下界之星，然后在信标下方建造一个矿物方块金字塔。"]
	quest.4754486316451C73.title: "装甲巨龙"
