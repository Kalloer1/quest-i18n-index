	]
	quest.196C853F7E0FED56.quest_subtitle: "神话升级模组"
	quest.196C853F7E0FED56.title: "神话锻造匠"
	quest.197A7103717EA0E8.title: "升级模板"
	quest.198DBBCABC09D91A.quest_desc: ["随身携带一个你熟悉的灵魂。"]
	quest.19E649DA0EBF40E8.quest_desc: ["红石块周围的8颗钻石。打破它，祈祷好运——可能是宝藏、陷阱，甚至是首领……"]
	quest.19E649DA0EBF40E8.title: "觉得自己幸运吗？"
	quest.1A227FC9A1BD5E8B.quest_desc: ["创造：Enchantment Industry将经验转化为流体。Blaze Enchanter会自动施加附魔。"]
	quest.1A227FC9A1BD5E8B.title: "附魔工业 Enchantment Industry"
	quest.1A232E4BB3990CB3.title: "被感染的僵尸 (Infested Zombie)"
	quest.1A255711B9233932.quest_desc: ["安装在移动装置上的收割机和犁可以为你耕种整片田地。"]
	quest.1A255711B9233932.title: "自动化农场"
	quest.1A29FC5A73FDE328.quest_subtitle: "太阳能电池板在白天产生能量，等级越高，白天产生的电力越多。"
	quest.1A30EADD94693184.quest_desc: [
		"在建筑高度限制处与村民进行交易。"
		""
		"村民是怎么上去的？别问了。你知道你干了什么。"
	]
	quest.1A30EADD94693184.title: "星际商人"
	quest.1A379A420E5561A4.quest_desc: [
