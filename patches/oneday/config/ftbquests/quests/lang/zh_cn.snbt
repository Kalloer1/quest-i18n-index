	quest.730BC7042CFC5627.quest_desc: ["&7一个从未被问出的问题，将永远得不到答案。"]
	quest.730BC7042CFC5627.quest_subtitle: "知识就是力量。"
	quest.73480E5B07274BC6.quest_desc: ["强化水晶比普通水晶要强得多。"]
	quest.73480E5B07274BC6.title: "Empowerer"
	quest.7382229DCB3637EE.quest_desc: [
		"将其放在快捷栏中，即可查看周围的灵气量。"
		""
		"半格是正常的量。过度抽取一个区域的能量会产生不良后果！"
	]
