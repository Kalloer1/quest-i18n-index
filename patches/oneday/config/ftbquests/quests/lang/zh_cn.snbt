	]
	quest.18FFA8B90EF76642.quest_subtitle: "太阳与月亮"
	quest.18FFA8B90EF76642.title: "日食传奇"
	quest.192F93084F71AF6D.quest_desc: ["OneDay Star 的 Explorer Core 所需物品。"]
	quest.192F93084F71AF6D.title: "Unobtainium Ingot"
	quest.1940D28279DD2044.quest_desc: [
		"日蚀锭、末地水晶、信标和哭泣的黑曜石。"
		""
		"用核心右键放置，空手潜行左键可取回一个。"
	]
	quest.1940D28279DD2044.title: "星辰祭坛"
	quest.196376F8C5EB5FCD.quest_desc: ["历史盔甲套装、长矛、战斧、链枷和盾牌。大部分部件需要钢铁——来自沉浸式工程、机械动力或史诗骑士模组本身。"]
	quest.196376F8C5EB5FCD.title: "史诗骑士团"
	quest.196C853F7E0FED56.quest_desc: [
