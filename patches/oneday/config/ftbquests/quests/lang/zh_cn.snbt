	quest.0000000000000033.title: "锇剑"
	quest.0000000000000034.quest_desc: ["Mekanism 工具：耐用性优于标准铁镐的替代采矿镐。"]
	quest.0000000000000034.title: "锇镐"
	quest.0000000000000035.quest_desc: ["Mekanism 工具：使用蓝色青金石打造的附魔适配型防御盔甲。"]
	quest.0000000000000035.title: "青金石盔甲套装"
	quest.0000000000000036.quest_desc: ["将斧头、镐头和铲子结合成一把紧凑的高阶工具。"]
	quest.0000000000000036.title: "精炼发光石帕克塞尔"
	quest.0000000000000037.quest_desc: ["提供爆炸防御抗性的超重型战术盔甲套装。"]
	quest.0000000000000037.title: "精炼黑曜石盔甲"
	quest.0000000000000038.quest_desc: ["自动化传送矿工，可安全地从地下过滤并剥离特定矿石。"]
	quest.0000000000000038.title: "数字矿工"
	quest.0000000000000039.quest_desc: ["使用这些坚固的阀门，建造自定义尺寸的多方块流体储罐。"]
	quest.0000000000000039.title: "动态储罐阀门"
	quest.000000000000003A.quest_desc: ["用于构建大型动态储罐结构的结构性面板。"]
	quest.000000000000003A.title: "动态储罐外壳"
	quest.000000000000003B.quest_desc: ["即时链接位置，实现无限次、高能耗的维度旅行。"]
	quest.000000000000003B.title: "传送器"
	quest.000000000000003C.quest_desc: ["为舒适的踏入点扭曲设定了物理阈值区域。"]
	quest.000000000000003C.title: "传送器传送门"
	quest.000000000000003D.quest_desc: ["控制能量涡轮机内部的高压蒸汽喷射路径。"]
	quest.000000000000003D.title: "工业涡轮阀门"
	quest.000000000000003E.quest_desc: ["需要外部保护外壳面板来封装工业涡轮机。"]
	quest.000000000000003E.title: "涡轮外壳"
	quest.000000000000003F.quest_desc: ["中央旋转轴杆，用于接住冲来的蒸汽货物。"]
	quest.000000000000003F.title: "涡轮转子"
	quest.0000000000000040.quest_desc: ["直接安装在转子组件上，将动能转化为原始动力。"]
	quest.0000000000000040.title: "涡轮叶片"
	quest.0000000000000041.quest_desc: ["将水迅速煮沸，产生高产量、高纯度、干燥的蒸汽。"]
	quest.0000000000000041.title: "过热元件 (Superheating Element)"
	quest.0000000000000042.quest_desc: ["处理放射性核心内部的冷却剂输入和蒸汽管排气口。"]
	quest.0000000000000042.title: "裂变反应堆端口"
	quest.0000000000000043.quest_desc: ["包含高级核材料裂变链的致密屏蔽层。"]
	quest.0000000000000043.title: "裂变反应堆外壳"
	quest.0000000000000044.quest_desc: ["内部垂直燃料棒，用于储存经过处理的放射性裂变燃料电荷。"]
	quest.0000000000000044.title: "裂变燃料组件"
	quest.0000000000000045.quest_desc: ["调节反应堆结构内部的热水平，以防止立即熔毁的情况发生。"]
	quest.0000000000000045.title: "控制杆组件装配"
	quest.0000000000000046.quest_desc: ["将六氟化铀分离为裂变燃料，并将核废料转化为钚——通往钋和Mekanism终局内容的大门。"]
	quest.0000000000000046.title: "同位素离心机 Isotopic Centrifuge"
	quest.0000000000000047.quest_desc: ["巅峰能量矩阵装置。管理类星体等离子核心聚变约束。"]
	quest.0000000000000047.title: "聚变反应堆控制器"
	quest.0000000000000048.quest_desc: ["高强度住房节点，用于绑定巨大的热核等离子体约束环。"]
	quest.0000000000000048.title: "聚变反应堆框架"
	quest.0000000000000049.quest_desc: ["向前发射高度集中的光能束，以安全点燃聚变核心。"]
	quest.0000000000000049.title: "激光"
	quest.000000000000004A.quest_desc: ["收集并集中多个小型激光束，形成单一的巨大能量脉冲。"]
	quest.000000000000004A.title: "激光放大器"
	quest.000000000000004B.quest_desc: ["终极神甲的完整部件。完全激活后可解锁绝对无敌特性。"]
	quest.000000000000004B.title: "MekaSuit 头盔"
	quest.02D16E97B12EEA41.quest_desc: ["&7你永远无法逃离自己的内心。所以，最好还是听听它想说的话。"]
	quest.02D16E97B12EEA41.quest_subtitle: "被火烧伤的孩子热爱火焰。"
	quest.0331AC0315EBB66D.quest_desc: ["这家热闹的酒馆藏在树林里，通常是村民放松身心的好去处。但当啤酒喝得太多，最平和的顾客也会变得好斗，用惊人的凶猛捍卫他们的酒馆。小心进入，否则你可能会卷入一场醉酒斗殴。"]
	quest.0331AC0315EBB66D.quest_subtitle: "找到一个绿木酒馆 Greenwood Pub"
	quest.0395861176F7F402.quest_desc: ["&7刀刃向你低语着感激。它将显化出某物，迟早会&4对你大有裨益&r&7。愿它们的苦难绵长。愿它们的痛苦充满喜悦。"]
	quest.0395861176F7F402.quest_subtitle: "发挥全部潜力"
	quest.03E7D9E3CD29B32F.quest_desc: ["&7违背承诺，如刀刺心。违背保证，如刀刺脑。心碎，如刀刺魂。"]
	quest.03E7D9E3CD29B32F.quest_subtitle: "不被遗忘，即不被宽恕。"
	quest.041A1C64A8468087.quest_desc: ["悬浮高空，这艘箭头形的飞艇由巨大的尾桨驱动。登船虽险，成功者将目睹其奇特而可怕的居民骑着野猪般的生物，无眼的面孔被不祥的笼子遮蔽。危险与神秘随他们穿越云层。"]
	quest.041A1C64A8468087.quest_subtitle: "寻找一位天界骑手 Heavenly Rider"
	quest.042EE2F5E9F5CFBF.quest_subtitle: "铀矿用于建造反应堆，反应堆同样使用铀矿来发电。你需要36个方块才能建造一个能用的反应堆，等级越高，铀矿产生的电力就越多。"
	quest.06B4703BD757BD7B.quest_desc: [
		"物品栏右侧的物品列表是 &6EMI&r——你的配方百科全书："
		""
		"• 将鼠标悬停在任何物品上并按 &6R&r 查看其合成方式，或按 &6U&r 查看其用途。"
		"在搜索栏中输入 &6@modname&r 以筛选模组，例如 &7@mekanism&r。"
		"• 将光标悬停在物品上并按 &6A&r，即可将其固定到左侧的收藏夹中。"
		""
		"[\"\",{\"text\":\"给你一个背包，路上用得上。在任何地方打开它，只需按下 \"},{\"keybind\":\"key.sophisticatedbackpacks.open_backpack\",\"color\":\"gold\"},{\"text\":\"。在物品栏内中键点击即可整理物品。\"}}]"
	]
	quest.06B4703BD757BD7B.title: "EMI 和库存助手"
	quest.07DAFC04179A4DA0.quest_desc: ["&7拿得越多，拥有的越少。你将被黄金包围，最终饿死。"]
	quest.07DAFC04179A4DA0.quest_subtitle: "贪婪——真是永无止境……"
	quest.08AEEA46BD870294.quest_desc: ["&7让我的风暴震撼大地！"]
	quest.08AEEA46BD870294.quest_subtitle: "第一条河流，是一条血之河流。"
	quest.0B89EB36AC565461.quest_desc: ["在这座地下城市的深处，熔岩的热浪与工业的轰鸣充斥着空气。下界的影响无处不在，为熔炉提供燃料，并驱动着巡逻每条走廊的锻造哨兵。唯有准备好迎接火焰与钢铁者，方能存活并夺取其中锻造的宝藏。"]
	quest.0B89EB36AC565461.quest_subtitle: "找到一个铸造厂 (Foundry)"
	quest.0C2D472551252C55.quest_desc: ["&7一对精致的眼睛，镶嵌于这把刀刃之上，将永远审判你用它所犯下的杀戮。你凭什么决定生死？"]
	quest.0C2D472551252C55.quest_subtitle: "&7它们会永远不停地评判你的行为。"
	quest.0CE50A7F4F1A0E4D.quest_desc: ["梯子直冲云霄，消失在云层之中。顶端漂浮着一艘奇怪的浮空船。上面隐藏着怎样的秘密或危险，无人知晓……但可以肯定的是，光是这景色就足以让最勇敢的冒险者都感到胃里翻江倒海。"]
	quest.0CE50A7F4F1A0E4D.quest_subtitle: "找到一个小型飞艇"
	quest.0D8A8981385BAF73.quest_desc: ["&7这把刀刃上流动的岩浆让你着迷。它让你想起了什么……"]
	quest.0D8A8981385BAF73.quest_subtitle: "王子殿下"
	quest.0D9DFC48E3D2F434.quest_subtitle: "能量放电器会从带电机器中抽取能量，储存在内部存储袋中，并可通过电缆将电力重定向至另一台机器。"
	quest.0E1234567890BCDE.quest_desc: ["Interdiction Pylon 可通过可配置的物品过滤器，阻止特定生物在基地周边生成或进入。"]
	quest.0E1234567890BCDE.title: "禁制金字塔"
	quest.0E959953F768C259.quest_desc: ["&7被诅咒又被祝福，行走于两个世界，只能可怜这些不幸的灵魂。"]
	quest.0E959953F768C259.quest_subtitle: "&7介于两个世界之间，却无处为家。"
	quest.0F426527B63F854D.quest_desc: [
		"&6&lSimply Swords&r &7为玩家提供了超过&a&l15&r种&7武器类型可供选择。"
		""
		"&7It also has the unique featureset of &b&n&lRunic Powers&r, &7which can be given to weapons via &n&bsockets&r!"
	]
	quest.0F426527B63F854D.quest_subtitle: "众多插槽中的一个！"
	quest.1000000000000001.quest_desc: ["制作一个陨石罗盘，找到你的第一块陨石。"]
	quest.1000000000000001.title: "搜寻已经开始"
