	quest.497FB5F5849F7912.title: "幸运传说"
	quest.499506BBA2F2BF14.quest_subtitle: "热能发电机利用下方的热源发电，并用冷却水降温。等级越高，产生的热能电力越多。"
	quest.49B859D0E181F2D3.quest_desc: ["完全没用。完全必要。"]
	quest.49B859D0E181F2D3.title: "太棒了！"
	quest.49FF660487B0E255.quest_desc: ["在锻造台处，将下界合金装备 + 托帕斯升级锻造模板 + 托帕斯锭组合。"]
	quest.49FF660487B0E255.title: "托帕斯升级"
	quest.4A308BBCC4A2528E.quest_desc: ["咒语绑定台可将法术绑定到你的法术书和武器上。"]
	quest.4A421F4B3B629AAE.quest_desc: ["一个行走的锻造炉，由下界合金和熔岩构成。"]
	quest.4A421F4B3B629AAE.title: "下界合金怪物"
	quest.4A584686E5294BBD.quest_desc: ["[\"\",{\"text\":\"传送到视线方向及旅行锚点之间。快捷键： \"},{\"keybind\":\"key.enderio.travel_staff\",\"color\":\"gold\"},{\"text\":\"\"}]"]
	quest.4A6AC0953235E6C3.quest_desc: ["大型整合包意味着海量内容。本章涵盖储物、实用工具及能节省时间的辅助模组。"]
	quest.4A6AC0953235E6C3.title: "整理一下！"
	quest.4A7A34FC9C13C202.quest_desc: ["将风车或水车的旋转转化为动力。"]
	quest.4AED92362B20A166.quest_desc: ["挖掘时，Holystone 工具有时会掉落 Ambrosium Shards。"]
	quest.4AED92362B20A166.title: "Holystone 工具"
	quest.4AF5EC021DF2AFCB.quest_desc: ["用至少一个阀门的墙壁建造一个空心立方体（3×3×3 到 5×5×5）。内部物品在压力下制作。"]
	quest.4AF5EC021DF2AFCB.title: "压力舱室"
	quest.4B0FFCB41884054E.quest_desc: [
		"&6☀ 太阳：&r矿石掉落时已熔炼，挖掘速度提升25%。"
		"&b☾ 月亮：&r 每种矿石有30%的几率额外掉落物品。"
		""
		"&7丝绸之触会关闭两种力量。"
	]
	quest.4B0FFCB41884054E.title: "Sunforged Pickaxe"
	quest.4B47AE5288854692.quest_desc: [
		"你的队友无法伤害你——没有剑击、箭矢、法术、爆炸或宠物。"
		""
		"想切磋吗？在 OneDay 菜单中开启&c友军伤害&r，或使用&e/oneday friendlyfire on&r。这样你的队友和盟友就能攻击你了。"
		""
		"&7每5分钟才能切换一次，这样没人能在战斗中通过切换来躲避战斗。队伍是FTB Teams队伍。"
	]
	quest.4B47AE5288854692.title: "友军伤害"
	quest.4B5561CDC7383557.quest_desc: ["在热源上烹饪食物——或者把它当作意外好用的武器来挥舞！"]
	quest.4BA02609B12588A4.quest_desc: ["烹饪的食物能恢复大量饥饿值，并提供营养或慰藉。"]
	quest.4BA02609B12588A4.title: "厨师菜单"
	quest.4BCE38717F3BD099.quest_desc: ["Mob Grinding Utils：用于怪物农场的风扇、锯子、经验收集器和吸收漏斗。"]
	quest.4BCE38717F3BD099.title: "生物爱好者"
	quest.4BD5472344A7B262.quest_desc: [
		"将其放置在自然祭坛的催化位点之一上以粉碎物品。"
		""
		"金叶子变金粉，鹅卵石变沙子，骨头变额外的骨粉等等。"
	]
	quest.4BE44AF9519BB39E.quest_desc: ["野外的 Runewood 树木会自然生长。"]
	quest.4C982E8EF38BB712.quest_desc: ["Yellorite 矿石生成于主世界的深层。将其熔炼成 Yellorium 锭——反应堆燃料。"]
	quest.4C982E8EF38BB712.title: "Yellorium"
	quest.4D1FE64444475355.quest_desc: ["由一个被遗忘的文明建造的凋零驱动战争机器。"]
	quest.4D1FE64444475355.title: "先遣者 (The Harbinger)"
	quest.4D2A89CAC18D3CC4.title: "沼泽地"
	quest.4D38C6F3D135FA88.quest_desc: [
		"完成&eA World of Biomes&r中的所有任务，即可获得&b世界旅行者&r称号。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.4D38C6F3D135FA88.quest_subtitle: "一个生物群系的世界"
	quest.4D38C6F3D135FA88.title: "世界旅行者"
	quest.4D3E9F88C7B10794.quest_desc: ["Mekanism Extras 添加了四个新等级：绝对、至高、宇宙和无限。"]
	quest.4D3E9F88C7B10794.title: "绝对电路"
	quest.4D792CB7F1B76B0F.quest_desc: [
		"在森林里发现一只猫头鹰。"
		""
		"它在注视你。它在评判你。它在咕咕叫。"
	]
	quest.4D792CB7F1B76B0F.title: "呼~呼~呼~"
	quest.4DA7674300531BAB.quest_desc: ["给 Strider 装上鞍，骑着它穿越熔岩湖。"]
	quest.4DA7674300531BAB.title: "岩浆冲浪"
	quest.4DD812D8096B5BB7.quest_desc: ["&7唯一会永远跟随你的，只有你的影子。"]
	quest.4DD812D8096B5BB7.quest_subtitle: "&7就像一只由光的缺席构成的蜜蜂。"
	quest.4DDDE27405E9693C.quest_desc: [
		"完成&ePotions&r中的所有任务，以获得&b炼金术士&r称号。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.4DDDE27405E9693C.quest_subtitle: "药水（Potions）"
	quest.4DDDE27405E9693C.title: "炼金术士"
	quest.4E0F2BFF1BF61BBC.quest_subtitle: "热板是制造和升级发电机所必需的组件。"
	quest.4E2FDDD93B94FAE6.quest_desc: ["在末地中生成。"]
	quest.4E4052F7EAD4FDD6.quest_desc: ["鲜亮的旗帜和彩绘的墙壁吸引着旅人，但这些高耸的堡垒内却一片混乱。每一层都充满了强盗和陷阱，敌人的笑声伴随着源源不断的怪物潮涌而出。征服塔楼，它们的财富和声名都将属于你。"]
	quest.4E4052F7EAD4FDD6.quest_subtitle: "找到强盗塔 (Find the Bandit Towers)"
	quest.4E7045A51F33FDBF.quest_desc: ["Tier 6 作物只能在 Insanium 农田上生长，并且农田正下方还需要放置它们的 &dCrux&r 方块。"]
	quest.4E7045A51F33FDBF.title: "Insanium 农田"
	quest.4EA5D6DD0FC96209.quest_desc: ["游戏中的指南。读一读——仪式需要精确无误。"]
	quest.4EDDBC0A68DDD41A.quest_desc: ["一位被沙子束缚的法老在诅咒金字塔中苏醒。"]
	quest.4EDDBC0A68DDD41A.title: "远古遗迹"
	quest.4F047FBEFD53BA67.quest_desc: ["两个潜贝壳和一个箱子：一个打破后内容物会保留的盒子。"]
	quest.4F16800557328AE3.title: "红色星球"
	quest.4F55B39063BFE262.quest_desc: ["能让你飞行的、由能量驱动的套装。"]
	quest.4F55B39063BFE262.title: "喷气背包"
	quest.4F5AB4F25EDF8C39.quest_desc: ["[\"\",{\"text\":\"研究并安装赛博格增强模块。增强菜单： \"},{\"keybind\":\"key.oritech.augment_screen\",\"color\":\"gold\"},{\"text\":\"\"}]"]
	quest.4F6B35E986BD5104.quest_desc: [
		"使用Wilden角、尖刺和翅膀来增强&6召唤Wilden&r仪式，以召唤Wilden奇美拉。"
		""
		"&c警告：&r仪式会摧毁火盆周围的方块。请在远离基地的地方进行！"
	]
	quest.4F6B35E986BD5104.title: "野性奇美拉 (The Wilden Chimera)"
	quest.4F7470FB16524177.quest_desc: [
		"五个首领在各自的建筑中等候。带上朋友——别忘了，附近的所有人都会获得奖杯。"
		""
		"[\"\",{\"text\":\"翻滚闪避： \"},{\"keybind\":\"key.block_factorys_bosses.dodge_roll\",\"color\":\"gold\"},{\"text\":\" – 你有2次充能，短时间内会恢复。\"}]}]"
	]
	quest.4F7470FB16524177.title: "Bosses' Rise"
	quest.4F94D8D6B7517754.title: "单一合金"
	quest.4F995829046A68BB.quest_desc: [
		"环境之眼显示的灵气范围是普通眼睛的两倍，并能显示你所在位置的所有灵气效果。"
		""
		"你已经掌握了自然光环！"
	]
	quest.4F995829046A68BB.quest_subtitle: "环境观测器 (Environmental Ocular)"
	quest.4F995829046A68BB.title: "与自然合为一体"
	quest.4F9BFD9E70F5EF17.quest_desc: ["锻造台：末影宝石 + 空白传送器 + 祖母绿矿石。"]
	quest.4FA8A74408D31C49.quest_desc: [
		"保护村民免受意外电击，但不能引发火灾。"
		""
		"避雷针可以修复你在上一个任务中破坏的东西。"
	]
	quest.4FA8A74408D31C49.title: "浪涌保护器"
	quest.4FAD34583B107D77.quest_desc: ["大型多块反应堆和涡轮机。尺寸和燃料棒布局决定了你能获得的电力。"]
	quest.4FAD34583B107D77.title: "极端反应堆模组 (Extreme Reactors)"
	quest.4FC0AEE825F06123.quest_desc: [
