	quest.1014455789A6FCDD.quest_desc: ["Moog's End Structures 在外围岛屿上布满了废墟、塔楼、神社和巨大的残骸。至少找到一个吧！"]
	quest.1014455789A6FCDD.title: "虚空探索者"
	quest.102A464C6C32993B.quest_desc: ["高级下界合金用铁、金、绿宝石和钻石来改进下界合金——每个等级都比上一个更优。"]
	quest.102A464C6C32993B.title: "高级下界合金（Advanced Netherite）"
	quest.10710081934A30C6.quest_desc: ["&7你被派去摧毁他们，不是加入他们！"]
	quest.10710081934A30C6.quest_subtitle: "被污染和扭曲的。Tainted and Twisted."
	quest.109DA73D0390ED37.quest_desc: [
		"穿戴全套四件以获得套装加成："
		""
		"&6☀ 太阳：&r再生与速度"
		"&b☾ 月亮：&r夜视与力量"
		""
		"盔甲的外观会随时间变化——白天是金色的，夜晚是星空蓝的。"
	]
	quest.109DA73D0390ED37.title: "身披日月之光，闪耀着光芒"
	quest.10B753CFD971CB80.quest_subtitle: "末影单元是一种无线的能量传输装置，可通过相同频道将能量传输给另一个末影单元。每个末影单元都必须包含一个能量单元才能运行和储存能量。"
	quest.1109BFF473EEAE0F.title: "99 个气球"
	quest.112ECF849360ADD2.quest_desc: ["写下最弱灵体——Foliot的名字，将其束缚。"]
	quest.112ECF849360ADD2.title: "束缚之书 (Book of Binding)"
	quest.114D6A6698F7E792.quest_desc: ["潜行+右键开启：这样就能一次性挖掘整个矿脉。"]
	quest.11694880AD276E3D.quest_desc: ["在孵化器中孵化莫阿蛋，获得你自己的飞行坐骑。"]
	quest.11694880AD276E3D.title: "Moa牧场"
	quest.11795BAAF294BDDA.quest_desc: ["在物品栏中有灵魂瓶的情况下，用索利乌姆匕首击杀生物来填充瓶子。填充后的瓶子可用于生成生物种子。"]
	quest.11795BAAF294BDDA.title: "生物的灵魂 (Mob Souls)"
	quest.118162F2F3CEFD45.title: "附魔的纠缠物 Enchanted Tangle"
	quest.120D362256EB5522.quest_desc: [
		"很高兴你来了！&6OneDay 2.0&r将科技、魔法、泰拉瑞亚风格的冒险、新维度与残酷的Boss融合到一个庞大的世界中。"
		""
		"这本任务书是你的向导。它不会事事包办——探索本就是乐趣的一半——但它总会指引你前往值得去的地方。"
		""
		"&e提示：&r完成一个任务会解锁下一个任务。你也可以不按顺序完成任务——只要满足前置条件，任务就会立即完成。"
	]
	quest.120D362256EB5522.quest_subtitle: "从这里开始"
	quest.120D362256EB5522.title: "欢迎来到 OneDay 2.0！"
	quest.12524F7E1BC7446E.quest_desc: ["Candlelight 添加了精致餐饮：煎锅、炉灶、水槽和晚餐铃。"]
	quest.12719CF6C9BB78C4.quest_desc: ["适用于AE2网络的addons：超大存储单元、更优配方提供者、量子合成和能量存储。"]
	quest.12719CF6C9BB78C4.title: "更大的网络 (Bigger Networks)"
	quest.128AE3D974FBFCF4.quest_desc: ["将材料放入盆中，并在其上方放置机械搅拌机以进行混合配方。"]
	quest.128AE3D974FBFCF4.title: "搅拌机和盆子"
	quest.1299DA76794F4557.quest_desc: ["&7所有力量都需要牺牲和痛苦。"]
	quest.1299DA76794F4557.quest_subtitle: "&7我将撕裂血肉，直至我成为不洁之神。"
	quest.12BEB26CC7B99297.quest_desc: ["苦力怕有时会掉落毛绒盒子。打开一个，获得随机毛绒玩具！"]
	quest.12C3D1BD623E5663.quest_desc: [
		"Luminite 和 Hallowed Bar、一个 Life Fruit 和一个 Soul of Might 围绕着一个 Eclipse Ingot。"
		""
		"标题：&d泰拉利亚传奇"
	]
	quest.12C3D1BD623E5663.title: "泰拉瑞亚核心模组"
	quest.12F9B25AFE36EF08.quest_desc: [
		"连续存活5个小时的游戏时间。"
		""
		"死亡一次计时器会重置。别紧张。"
	]
	quest.12F9B25AFE36EF08.title: "地块盔甲"
	quest.1325F54BBE6F99C5.quest_desc: ["按住右键可以格挡。本整合包里的许多敌人都攻击力很高！"]
	quest.13397125C6E2241D.quest_desc: ["在锻造台使用下界合金装备 + 绿宝石升级锻造模板 + 绿宝石锭。"]
	quest.13397125C6E2241D.title: "Aquamarine 升级"
	quest.1350CE31C1143F54.quest_desc: [
		"完成&eDeeper and Darker&r中的所有任务，即可获得&bDeep Dark Legend&r称号。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.1350CE31C1143F54.quest_subtitle: "更深更暗 Deeper and Darker"
	quest.1350CE31C1143F54.title: "深邃黑暗传说"
	quest.138F5BC616B4A97C.quest_desc: [
		"你的第一个光环发生器：它会吃掉旁边的花朵，并把它们变成光环。"
		""
		"给它喂不同的花——一直喂同一种花就没用了。"
	]
	quest.13941733056B337D.title: "Allthemodium 盔甲"
	quest.13B2D9F7CE1957DC.quest_desc: ["包含所有基座的完整灌注祭坛，集成于一台机器中。"]
	quest.13B2D9F7CE1957DC.title: "Infusion Altarnator"
	quest.13B5E4EF97D6308F.quest_subtitle: "介电浆是用于粘合和制作机器电气部件的原料，计划升级的话，你应该多准备一些。"
	quest.13B5E4EF97D6308F.title: "电动胶水"
	quest.13BC44B8329E422D.title: "死胡子（Dead Beard）"
	quest.13BD9628ED76D994.quest_desc: [
		"完成&e探索工具&r中的所有任务，即可获得&b寻路者&r称号。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.13BD9628ED76D994.quest_subtitle: "探索工具"
	quest.13BD9628ED76D994.title: "Pathfinder"
	quest.13EE77249477FF2E.quest_desc: [
		"在自然祭坛上注入一个铁锭。"
		""
		"消耗大量灵气——在祭坛周围种植植物和树木。"
	]
	quest.1429BB036F101F06.quest_desc: ["九个日食锭。也可以用作信标底座。"]
	quest.1429BB036F101F06.title: "展示中的日食与月食"
	quest.1462F62C1D093E6B.title: "更好的太阳能 (Better Solar)"
	quest.14857DBF1DCBF100.quest_desc: ["如往昔之影般乘风破浪，这艘被诅咒的船只上载着难以击倒的骷髅船员。每个甲板都暗藏危险，每个船舱都低语着失落的宝藏，而你挥出的每一击都可能转瞬即逝。只有勇敢者（或鲁莽者）才敢于直面其无情的亡灵船员。"]
	quest.14857DBF1DCBF100.quest_subtitle: "寻找一艘亡灵海盗船"
	quest.1497D0EE5FC769D9.title: "玉髓锭"
	quest.149F59892DA42648.title: "心之容器"
	quest.14A05156775B1E05.title: "黄玉矿石"
	quest.14B651BC47025356.quest_desc: [
		"每个首领在你首次协助击败它时都会掉落一个&6奖杯&r——首领的迷你雕像，可以放在你的架子上。"
		""
		"64格范围内的每个人都会获得一个，所以带上你的朋友吧！"
	]
	quest.14B651BC47025356.title: "奖杯猎人"
	quest.14E5FA8D4CC56B10.quest_desc: [
		"一个空壳箱（侧面允许用玻璃）、一个控制器、从下到上依次是燃料棒，每个燃料棒顶部有一个控制棒，还有一个电源接口。"
		""
		"将 Yellorium 放入访问端口或控制器中。"
	]
	quest.14E5FA8D4CC56B10.title: "你的第一座反应堆"
	quest.1526F87B624D73B7.quest_desc: [
		"Dragon Mounts: Remastered 让你孵化和骑乘龙。共有11种类型——火、冰、森林、水、末地、下界、以太、幽灵、潜声、繁茂和紫水晶。"
		""
		"[\"\",{\"text\":\"召唤你的龙： \"},{\"keybind\":\"dmr.keybind.summon_dragon\",\"color\":\"gold\"},{\"text\":\"\"}]"
		"[\"\",{\"text\":\"骑乘时的吐息攻击： \"},{\"keybind\":\"dmr.keybind.attack\",\"color\":\"gold\"},{\"text\":\"\"}]"
	]
	quest.1526F87B624D73B7.title: "前方有龙"
	quest.1533AF90DDBBE2B5.quest_desc: [
		"在单个方块内生长一种种子，并将精华推出——非常适合管道。"
		""
		"需要种子、合适的农田和燃料。在 OneDay 中，它和普通农田一样快，只是更省空间和劳动力。"
	]
	quest.1533AF90DDBBE2B5.title: "农夫"
	quest.15402034CBA50BE6.quest_desc: ["古老的地下墓穴深处，是亡者之王的安息之所。唤醒他——如果你敢的话。"]
	quest.15402034CBA50BE6.title: "死去的国王"
	quest.155B7C795F7E734C.quest_desc: [
		"由一本书和一套铁制工具合成而成。"
		""
		"[\"\",{\"text\":\"使用 \"},{\"keybind\":\"key.ars_nouveau.open_book\",\"color\":\"gold\"},{\"text\":\"打开，并用 Projectile + Harm 尝试你的首个攻击法术。\"}]}]"
		"[\"\",{\"text\":\"使用 \"},{\"keybind\":\"key.ars_nouveau.selection_hud\",\"color\":\"gold\"},{\"text\":\"在已保存的咒语之间切换。\"}]}]"
	]
	quest.155B7C795F7E734C.title: "新手魔法书"
	quest.1562FA62AD06CB8D.quest_desc: ["骑马冲锋时，长矛能造成巨额伤害。"]
	quest.1562FA62AD06CB8D.title: "骑士决斗！"
	quest.15730B999806675C.quest_desc: ["将机械合成器排列成网格，自动化处理最复杂的配方。"]
	quest.15730B999806675C.title: "机械工匠 (Mechanical Crafters)"
	quest.159B92CB8A05264B.quest_desc: [
		"&6Alex's Caves&r 在地下深处隐藏着稀有的洞穴群系——每个群系都有独特的生物、材料和首领。"
		""
		"洞穴石碑会指引方向。你可以在普通洞穴的&6地下小屋&r中找到它们，也可以在丛林神庙、女巫小屋、水下遗迹、林地府邸、堡垒和可疑沙砾中作为战利品获得。"
	]
	quest.159B92CB8A05264B.title: "这东西应该放在博物馆里"
	quest.15A88EE622C1F407.quest_subtitle: "能量棒是一种机器，可以为能量球中的物品充能并将其转化。"
	quest.15B727B8696B2393.title: "地狱烈焰巨龙"
	quest.15C792151E9226A1.quest_desc: ["威克西在威克西大锅中制作物品和酿造药水。"]
	quest.15C792151E9226A1.title: "Wixie"
	quest.15EF6F6E4B670A54.quest_desc: [
		"&6Iron's Spells 'n Spellbooks&r 的核心是收集法术，并通过法术书施放它们。"
		""
		"你的第一本书很简单：铜、纸和线。"
	]
	quest.15EF6F6E4B670A54.title: "脆弱的日志本"
	quest.15F101A3E9237DBE.quest_desc: ["所有背包升级的基础组件。"]
	quest.15F15105C7FF30A8.quest_desc: [
		"种植能长出铁、煤炭、石英等物品的种子。"
		""
		"&6OneDay 规则&r（为了公平起见）："
		"• 作物永远不会掉落第二个种子——所有种子都必须通过合成获得。"
		"• 资源作物只生长在其对应等级的农田上。"
		"• 收获的资源约为正常的一半。"
		"• 下界合金、凋零骷髅头、AE2 压机、火焰锭或骑士金属没有对应的作物。"
		""
		"&7所有祭坛和灌注配方都可以在EMI中查找（在物品上按R或U）。"
	]
	quest.15F15105C7FF30A8.quest_subtitle: "种田，不过是钻石的田"
	quest.15F15105C7FF30A8.title: "神秘农业（Mystical Agriculture）"
	quest.16098E969CB95DF8.title: "被烧焦了"
	quest.161B9D65D5A1C911.quest_desc: ["通过颜色代码相互关联的箱子——即使跨越不同维度。"]
	quest.161C85F603FA6A6A.quest_desc: [
		"欢迎来到整个任务书里最没用的章节！"
		""
		"这里没有能让你变强的东西。有些会让你看起来很蠢。但这一切都值得。"
		""
		"&7大多数任务都会追踪你的统计数据——在你游戏时它们会自动完成。"
	]
	quest.161C85F603FA6A6A.quest_subtitle: "正事要紧。开玩笑的啦。"
	quest.161C85F603FA6A6A.title: "仅供娱乐之用"
	quest.163883D874FD5FD2.title: "反向卡牌"
	quest.1647461BC7220064.quest_desc: [
		"完成&eMonsters of the World&r中的所有任务，即可获得&bMonster Hunter&r称号。"
		""
		"头衔会自动授予。选择&a[接受]&r即可佩戴在名字下方，或&c[拒绝]&r将其收藏以备后用。"
	]
	quest.1647461BC7220064.quest_subtitle: "世界怪物大合集"
	quest.1647461BC7220064.title: "怪物猎人"
	quest.16A865F4E9A0B9E7.quest_desc: ["在这里酿造更好的墨水，并将不需要的卷轴分解成有用的材料。"]
	quest.16A865F4E9A0B9E7.title: "炼金术士的坩埚"
	quest.16F14229B133E35C.title: "压力管道"
	quest.16F23967840B04A7.quest_desc: ["熔炼或爆破原始太阳能矿石。Mekanism和Immersive Engineering可让你的矿石翻倍。"]
	quest.16F23967840B04A7.title: "太阳能锭 Solarium Ingot"
	quest.1709924A9B5594CD.quest_desc: ["Zanite 工具磨损得越厉害，速度就越快。"]
	quest.1709924A9B5594CD.title: "Zanite"
	quest.170AA1F64096297F.quest_desc: ["阿弗利特仪式所需物品。"]
	quest.17349BCDB45CA495.quest_desc: ["火焰骑士守护着燃烧竞技场。击败他，获取引火石。"]
	quest.17349BCDB45CA495.title: "Ignis"
	quest.1756C4878E9FD78F.title: "Tier 3 火箭"
	quest.1777D7389714FA04.quest_desc: ["将方块和生物连接起来——例如，告诉星灵该去哪里拾取和放下物品。"]
	quest.1777D7389714FA04.title: "Dominion Wand"
	quest.177CE07DA601DF07.quest_desc: ["&7再平静的心，也蕴藏着风暴。但何时释放，则由心决定。"]
	quest.177CE07DA601DF07.quest_subtitle: "&7暴风雨来临前，总会有一阵短暂的宁静。"
	quest.17AF8ADFC1218B90.quest_desc: ["一个可爱的小物品快递员。使用Dominion Wand来指定它取货和送货的地点。"]
	quest.17AF8ADFC1218B90.title: "星之纽带（Starbuncle）"
	quest.17B5281769381237.quest_desc: ["&7杀死你所珍视的。杀死所见之物。你是否在自身的行为中看到了自己的倒影？"]
	quest.17B5281769381237.quest_subtitle: "眼睛，天哪，不要是眼睛，不要是眼睛！"
	quest.17BA9D67A60AC3F4.quest_desc: ["进阶魔典——马卢姆的深层秘密。"]
	quest.17FA5AE32F7A22DD.quest_desc: ["&7智慧的标志，是意识到自己的无知。"]
	quest.17FA5AE32F7A22DD.quest_subtitle: "有罪者感受不到的痛苦。"
	quest.180107AB50FED2A3.quest_desc: ["用安山合金右键点击去皮的原木或去皮木材。外壳是大多数早期机器的框架。"]
	quest.180107AB50FED2A3.title: "安山岩外壳"
	quest.1805522FD3CDD838.quest_desc: ["进入位于海洋底部的&9深渊裂谷&r。"]
	quest.1805522FD3CDD838.title: "坠入深渊"
	quest.18410956C2D6956A.quest_desc: ["将铁矿石熔炼成锭，制作铁镐——它能挖掘钻石。"]
	quest.18410956C2D6956A.title: "铁器时代"
	quest.18435254F79DB63B.quest_desc: ["试炼密室隐藏在地下。击败试炼生成器的浪潮，赢取试炼钥匙，开启宝库。"]
	quest.18435254F79DB63B.title: "反复试验与错误修正"
	quest.18724D965654056F.quest_subtitle: "单独使用它没有用，但在僵尸或焦夫身上使用后，它会升级为玩家空中珍珠。"
	quest.188AAB5B74C6EAAE.quest_subtitle: "发现一张被感染的寺庙探险家地图"
	quest.18A087DCCED26705.quest_desc: ["蛋糕站是组装蛋糕和纸杯蛋糕的地方。"]
	quest.18AC409C98B4B5D8.quest_desc: ["每张卷轴都包含一个法术。在战利品中查找，或稍后自己锻造。"]
	quest.18AC409C98B4B5D8.title: "法术卷轴"
	quest.18BFEC67E61DC759.title: "量子盔甲"
	quest.18C4F3367A04B882.quest_desc: ["&7你将复仇视为铠甲，但它会从内部腐蚀你。你终将成为自己毁灭之物。"]
	quest.18C4F3367A04B882.quest_subtitle: "愤怒是一种从内部腐蚀人的罪过。"
	quest.18CCA8C4CDE6F453.quest_desc: ["击败末影龙后，末地传送门就会出现。将末影珍珠投入其中一个，即可抵达外岛。"]
	quest.18CCA8C4CDE6F453.title: "超越传送门"
	quest.18ED1941D66ADE61.quest_desc: ["珠宝添加了带有属性加成的戒指和项链。宝石来自地下的宝石矿脉。"]
	quest.18FFA8B90EF76642.quest_desc: [
		"完成&eSun and Moon&r中的所有任务，即可获得&bEclipse Legend&r称号。"
		""
