			}]
			subtitle: "Building Gadgets te da herramientas avanzadas para construir, intercambiar, copiar y destruir bloques rápidamente. Perfecto para construir en grande sin esfuerzo."
			tasks: [{
				id: "6BE58083321F4DF5"
