	quest.00017D40227B1EAF.title: "采矿"
	quest.000FF4CA00CDBBF1.quest_desc: ["Questo componente posiziona automaticamente gli oggetti dal sistema nell'area di fronte ad esso. È utilizzato per automatizzare il posizionamento di oggetti nel mondo di gioco."]
	quest.004D5B518B8C6C72.quest_desc: ["和上一个一样，但容量更大！"]
	quest.007748EBF39E5D24.quest_desc: [
		"&2&lLe nostre prove sul campo indicano che la creazione di 1 milione di forni richiede meno di 2 minuti, con un Quantum Computer e un Assembler Matrix al massimo! WOW!&r&r"
		""
		"Questa è una struttura multiblocco di dimensione compresa tra 3x3x3 e 7x7x7 (&lesternamente!&r). &lOccuperà nel tuo network solamente un canale!&r"
		""
		"外部结构必须由量子计算机结构组成。"
		""
		"&l你非量子计算机核心不可！&r"
		""
		"&6&l内部必须完全填满，否则结构将无法组装！&r&r"
	]
	quest.007748EBF39E5D24.quest_subtitle: "Ora puoi assemblare il tuo Quantum Computer!"
	quest.007748EBF39E5D24.title: "量子计算机"
	quest.0096459C6CC35353.quest_desc: [
