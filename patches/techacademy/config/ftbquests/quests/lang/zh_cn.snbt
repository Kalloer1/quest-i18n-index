	quest.027E19AECA119701.quest_desc: ["Versione migliorata della Grid che permette anche di craftare direttamente gli oggetti senza alcun bisogno di una Crafting Table!"]
	quest.0298731DF3A0556A.quest_desc: ["Consente di importare ed esportare oggetti in stack, &l64 oggetti o 1000 mb di un fluido o gas&r!"]
	quest.029EB5F711B23DAF.quest_desc: [""]
	quest.0301BA2BF08820F0.quest_desc: [
		"成本高昂但功能强大的多区块熔炉！"
		""
		"Permette di cuocere più oggetti contemporaneamente, e in alcuni casi permette di ottenere più materiali rispetto a una semplice fornace!"
		""
		"Oltre alla cottura, permette di creare le leghe sostituendo il primitivo Klin."
		""
		"&lAttenzione, funzionare al massimo richiederà molta energia, quindi assicurati di avere importanti generatori di energia!&r"
	]
	quest.0301BA2BF08820F0.title: "电弧熔炉"
