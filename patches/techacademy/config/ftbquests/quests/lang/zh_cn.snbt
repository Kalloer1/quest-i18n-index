	quest.026404C1E714F6D2.title: "实用工具"
	quest.026C148FD7874738.quest_desc: ["Usata sulle macchine di Mekanism, ti permette di trasformarle in Factory con più slot"]
	quest.0277EA11A4261E6E.quest_desc: ["Segui le istruzioni del Coke Oven per questa struttura multiblocco. Non puoi prendere o mettere oggetti automaticamente, dovrai creare la Blast avanzata!"]
	quest.0277EA11A4261E6E.quest_subtitle: "SUGGERIMENTO: non è l'unico modo per creare l'acciaio"
