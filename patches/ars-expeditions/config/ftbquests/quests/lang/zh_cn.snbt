	quest.39DC47F7EA13C920.quest_desc: ["Battlemage 盔甲拥有 Ars 盔甲中最强的防御力，但用于添加盔甲附魔的 Thread 插槽最差。"]
	quest.39DC47F7EA13C920.title: "宝宝的初战法师长袍"
	quest.3A120B5758A8BE62.title: "水魔法学徒"
	quest.3A24639AB82742ED.quest_desc: ["Ars Energistique 的源转换器可将源能量导入 AE2 系统以提供电力。"]
	quest.3A24639AB82742ED.title: "它甚至能产生电力吗？"
	quest.3A8F3BD448FAE971.quest_desc: ["制作《多彩世界》指南，并完成其中的成就，以解锁通往这个多彩领域的道路。"]
	quest.3A8F3BD448FAE971.title: "色彩本身 (The Color Itself)"
	quest.3AD6E55072B89EDF.quest_desc: ["大魔导师的魔法书可以施放包含最高3级符文的法术。"]
	quest.3B50442514205688.quest_desc: [
		"精神系的Tentabuncles是由Ars Fauna添加的一种稀有但危险的生物。"
		""
		"这些生物只生成在地下深处，能对远程目标造成高额伤害。"
	]
	quest.3B50442514205688.title: "绝对不是思维窃取者（Definitely Not a Mind Flayer）"
