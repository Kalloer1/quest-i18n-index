	]
	quest.1CC6DB9ED1C30E01.title: "一位坚如磐石的伙伴"
	quest.1CF1833C303A84E6.quest_desc: ["Cat's Jewelry Tweaks 将 Ars 材料添加到可用于制作 Iron's Gems 'n Jewelry 的材料列表中。"]
	quest.1D24033D4ADD7973.quest_desc: ["掌握这些魔法模组，找到通往这些维度的道路。"]
	quest.1D24033D4ADD7973.title: "我的口袋里有个洞，钱都漏光了"
	quest.1D5C55E56A96BC0C.quest_desc: ["Faebuncle 是一种被动生物，可以在繁花盛开的生物群系中飞舞。"]
	quest.1D5C55E56A96BC0C.title: "找到一个 Faebuncle"
	quest.1DED473CB44BBF31.quest_desc: ["用深板岩围成一个圈，中间放上萤石，然后用放射性火焰点燃，即可进入这个放射性领域。"]
	quest.1DED473CB44BBF31.title: "别在意那发光的东西"
	quest.1E5577E1A483EF79.quest_desc: ["Repository Catalog 为所有已连接的仓库提供单一访问点。尤其适用于将大量仓库连接到 Storage Lectern。"]
	quest.1E5577E1A483EF79.title: "杜威十进制分类法"
	quest.1E59263D982213F4.quest_desc: ["你已经制作了所有来自 Ars Nouveau 的仪式石板！"]
	quest.1E7E77B447F1857F.quest_desc: ["高级法术棱镜能让你更好地控制法术投射物，并通过安装透镜来以各种方式改变它们。有关每种透镜的详细信息，请参阅破旧的卷轴。"]
	quest.1EDF73B1A4A93B5A.quest_desc: ["三阶盔甲的附魔槽比低阶盔甲有进一步的改进。"]
	quest.1EDF73B1A4A93B5A.title: "梅林骑士团"
	quest.1F1620969A62A0F6.title: "将羽毛笔置于羊皮纸上"
	quest.1F42BD9922ED1AC6.quest_desc: ["Iron's Spells 魔改指南，该魔改允许施放传统魔法咒语。"]
	quest.1F851C0C61345743.quest_desc: ["要进入 Ars Monde 维度，需要一个特殊的调谐器。"]
	quest.1F851C0C61345743.title: "魔法森林"
	quest.1FA902C56752286F.quest_desc: ["睡眠汤能让你进入梦乡的世界。"]
	quest.1FA902C56752286F.title: "美梦由此而来"
	quest.204B41C1B051BBC7.quest_desc: ["Enigmatic Legacy 模组的指南，该模组为游戏增添了强大的魔法装备。"]
	quest.204C8781465033AA.quest_desc: ["向农民和石匠村民询问进入此维度所需的材料。"]
	quest.204C8781465033AA.title: "这个房间里的所有东西都是可以吃的..."
	quest.205F618202353639.quest_desc: ["来自 Ars Elemental 的 Infused Turrets 会像装备了相关 Spell Focus 一样施放法术。如果法术包含相应元素的符文，法术成本也会降低。"]
	quest.2062E5671DC30AA7.quest_desc: [
		"找到一个爬行城堡，进入这个充满爬爬怪的维度。"
		""
		""
		"&4蜘蛛恐惧症患者请注意。&r"
	]
	quest.2062E5671DC30AA7.title: "蜘蛛恐惧症"
	quest.2089FF4B1AB11186.quest_desc: ["药水瓶最多可容纳100剂药水。你可以用玻璃瓶从瓶子里收集药水。"]
	quest.2089FF4B1AB11186.title: "我并没有酗酒的问题，绝对不是这样！"
	quest.2092E11C903FE4E4.quest_desc: ["Ars Affinity 让你能赚取技能点，用于施放 Ars Nouveau 法术来增强能力。使用各学派的神符，能让你在该学派的天赋树上获得提升。"]
	quest.2092E11C903FE4E4.title: "Ars Affinity"
	quest.209B1D23A14BEE66.quest_desc: [
		"星团宠物可以提高玩家的速度。"
		""
		"给星团一个金块，会使其短暂获得金矿的占卜能力。"
	]
	quest.209B1D23A14BEE66.title: "小松鼠！"
	quest.20B2B3F8D6A22504.quest_desc: [
		"仅在深暗之地发现的 Ars Fauna's Sculkbuncles 会在任何玩家靠近时发出尖叫声，从而触发该区域内的所有潜声传感器。"
		""
		"注意：找到名为 Xacris 的 Sculkbuncle 不计入此任务进度"
	]
	quest.20B2B3F8D6A22504.title: "找到一个潜行洞穴蜘蛛幼体"
	quest.20BDF3BE037CC67A.quest_desc: ["用基石方块建造一个传送门框架并点燃它，以进入这个晶体维度。"]
	quest.20BDF3BE037CC67A.title: "哦，亮闪闪的！"
	quest.20E7C87EB69F9658.quest_desc: ["Alakarkinos 可以在主世界的海滩上找到，它们会用代币换取 Sherd。"]
	quest.20E7C87EB69F9658.title: "找到一个阿拉克基诺斯"
	quest.2125BFC16290C828.quest_desc: ["来自 Ars Fauna 的这些生物大多出现在海洋和河流生物群系中，它们喜欢收集贝壳。"]
	quest.2125BFC16290C828.title: "找到一个海生生物（Seabuncle）"
	quest.21B47324FDC48549.quest_desc: ["探索如何在远古城市激活传送门，以抵达更深的黑暗。"]
	quest.21B47324FDC48549.title: "必须。继续。深入。"
	quest.228ACDF6CA06793E.quest_desc: [
		"Wixie 伙伴能延长玩家使用的药水持续时间，并在战斗中向附近的敌人投掷有害药水进行攻击。"
		""
		"给 Wixie 一个基础药水试剂，玩家就能获得该药水的效果。"
	]
	quest.228ACDF6CA06793E.title: "你见过的最可爱的女巫，没有之一"
	quest.22C305A10772CACC.quest_desc: ["灌注室用于将各种物品注入魔法——最重要的是，将原始紫水晶或青金石转化为源宝石，再将源宝石转化为精华。灌注配方不会消耗用于灌注的材料，除了被转化的物品本身。"]
	quest.22C305A10772CACC.title: "魔法灌注 (Magical Infusion)"
	quest.23756932E5D0CD5F.quest_desc: ["Chococraft 模组的指南，让你可以找到并驯服奇可鸟。"]
	quest.239325C09E0DDE68.quest_desc: ["用碗对瓶中的蘑菇怪使用物品会生成蘑菇浓汤。"]
	quest.239325C09E0DDE68.title: "蘑菇人（Mooshroom）"
	quest.23E6D57FD27D8B62.quest_desc: ["Ars Elemancy的Elemancer Bangle将4个元素手镯的优点集于一身。"]
	quest.23E6D57FD27D8B62.title: "终极闪耀"
	quest.23FA58602E8039AD.quest_desc: ["源宝石是 Ars Nouveau 的关键资源，可直接或在转化为精华后用于多种配方。"]
	quest.23FA58602E8039AD.title: "坚固魔法"
	quest.24BB5F5FD750F2DB.quest_desc: ["Ars Technica的Arcane Wrench扩展了Create Wrench的功能。"]
	quest.24FA87BBFFB3EB9B.quest_desc: ["激活下界的传送垫会带你来到这个维度。"]
	quest.24FA87BBFFB3EB9B.title: "那么，现在来点完全不一样的东西吧……"
	quest.252E4304FC9C445B.title: "添加一个顺时针搅拌器..."
	quest.25755E88D2892371.quest_desc: ["关于可让你寻找并驯服仓鼠的 Adorable Hamster Pets 模组的指南。"]
	quest.25B2DA7E4E384617.quest_desc: [
		"Ars Technica 为 Create 添加了可由源直接供电的机械。"
		""
		"源动力装置可将源能转化为旋转能量，为创造机械提供动力。"
	]
	quest.25B2DA7E4E384617.title: "Technomancy"
	quest.264E5858DA4A61E4.title: "掌握元素的力量"
	quest.26A7BBA0781BFEE8.quest_desc: ["Sorceror 盔甲是 Ars 盔甲中防御最弱的，但拥有最多的 Thread 插槽，可以为盔甲添加增益效果。"]
	quest.26A7BBA0781BFEE8.title: "宝宝的初号巫师袍"
	quest.26C3666A9AA252F6.quest_desc: ["Allthemodium 模组的指南。"]
	quest.26CA0AF53492E847.quest_desc: ["来自 Ars Musique 的 Bard's Bandeau 能让你播放音乐唱片，为自己或附近的人提供魔法效果。详情请参阅游戏内文档。"]
	quest.26CA0AF53492E847.title: "歌曲的魔法"
	quest.2896E24ABD765A97.title: "烈焰森林"
	quest.28B8238A636AB88A.quest_desc: ["法师的魔法书可以施放包含1级和2级符文的法术。"]
	quest.2904176137E0B7EA.title: "大家伙都放松点，别紧张！"
	quest.293D7C605EC32568.quest_desc: ["源容器会自动将接收到的源存入范围内的任何源罐中。"]
	quest.296568D67A04A432.quest_desc: ["升级 Ars 火炮炮塔将提高其效率和/或射程。"]
	quest.296568D67A04A432.title: "拿出重武器来干一场吧"
	quest.29B61CECD1B5034D.quest_desc: ["关于Croptopia模组的指南，该模组为整合包添加了大量作物和果树。"]
	quest.2A18F1D12D472650.quest_desc: ["Evilcraft 模组的指南。"]
	quest.2AB56347A2A3F63C.quest_desc: ["你必须用无底洞中找到的材料建造传送门框架和催化剂才能进入此维度。"]
	quest.2AB56347A2A3F63C.title: "未来一片光明，所以我得戴上墨镜"
	quest.2B988F0799EE6671.quest_desc: [
		"传送卷轴可以转化为稳定传送卷轴，使其在不同维度间也能使用。"
		""
		"此外，稳定化传送卷轴在使用时不会被消耗，也不会将你直接传送到目的地，而是会打开一个通往目标地点的临时单向传送门，可供多个实体使用。"
		""
		"与标准传送卷轴一样，稳定传送卷轴可用于建造传送门。"
	]
	quest.2B988F0799EE6671.title: "万物，无处不在，一切同时发生"
	quest.2BC53799F84AE519.quest_desc: ["你必须使用 Enchantless 中找到的材料建造传送门框架和催化剂才能进入此维度。"]
	quest.2BC53799F84AE519.title: "一个没有……焦糖的世界？"
	quest.2BDE3DB7C86A0E58.quest_desc: ["用发光黑曜石制作一个传送门框架，并用GLINT和钢点燃它，以进入此维度。"]
	quest.2BDE3DB7C86A0E58.title: "现在我们准备出发了"
	quest.2BF800A5B1E15BAD.title: "瓶中城市"
	quest.2C5AD3378D5882DD.quest_desc: ["许多 Ars Nouveau 的配方都需要精粹。基础模组包含 7 种精粹类型，而 Ars Elemental 则添加了 Anima Essence。"]
	quest.2C5AD3378D5882DD.title: "魔法的本质 (The Essence of Magic)"
	quest.2C8B7F7681E6EA65.quest_desc: ["被动的末地小生物只能在末地找到，受到威胁时会传送离开。"]
	quest.2C8B7F7681E6EA65.title: "找到一个末地核心（Enderbucle）"
	quest.2CC460C18D97FBF1.quest_desc: [
		"Ars Elemental 添加了法术反射附魔，使盾牌有一定几率反射法术投射物。"
		""
		"附魔等级越高，成功几率就越大。"
	]
	quest.2CC460C18D97FBF1.title: "法术反射"
	quest.2D24F65BACFCC3BB.quest_desc: ["Vibranium Spell Book 增加了更多属性加成，并将法术的符文限制提升至 15。"]
	quest.2D24F65BACFCC3BB.title: "倒数第二铸造工具"
	quest.2DF7A617C2BA8134.quest_desc: ["Ars Structurize 在世界上添加了多个简单的 Ars 主题建筑，其中包含来自 Ars Nouveau 的方块、生物和战利品。"]
	quest.2DF7A617C2BA8134.title: "闪闪发光的家园"
	quest.2E28B9FDA7E5CED6.quest_desc: [
		"云团是中立生物，可以在高山山顶上找到它们。"
		""
		"靠得太近可能会被电击！小心点！"
	]
	quest.2E28B9FDA7E5CED6.title: "找到一个云团（Cloudbuncle）"
