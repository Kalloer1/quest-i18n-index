	quest.3299E0316702AC6D.quest_desc: ["GeOre Nouveau 添加了多种哥布林类型，它们的工作原理与紫水晶哥布林相同，只是使用的方块类型不同。"]
	quest.3299E0316702AC6D.title: "晶化资源"
	quest.32CED3E7B10FB247.quest_desc: [
		"Iron's Gems and Jewelry 模组指南，为整合包添加了可自定义制作的珠宝。"
		""
		"&oCat's Jewelry Tweaks 添加了此模组与 Ars Nouveau 内容的兼容性。&r"
	]
	quest.330E1CDB29E5C355.quest_desc: ["Cosmetic Armors 模组指南，为整合包添加了各种外观物品。"]
	quest.33531C3F47FE5B08.quest_desc: [
		"砍伐原木会冒着召唤出森林守护者之一的风险。"
		""
		"反过来给他们一棵树苗，就能满足他们的复仇欲，让他们变成普通的 Whirlisprig。"
	]
	quest.33531C3F47FE5B08.title: "找到一个荆棘小枝 (Thornsprig)"
	quest.344D7C41F80CFB49.quest_desc: ["Vexbuncles 是 Ars Fauna 模组中一种只在黑暗森林里出现的幽灵飞行生物。"]
	quest.344D7C41F80CFB49.title: "你要叫谁来帮忙呢？"
	quest.348D0D1AC8D72F21.quest_desc: [
		"来自 Ars Additions 的 Advanced Dominion Wand 和来自 Ars Controle 的 Remote 是 Dominion Wand 的进阶版本，提供了更多使用选项，让用户能更好地掌控。"
		""
		"注意：高级支配魔杖目前存在bug"
	]
	quest.349F05DD16AD4C0E.quest_desc: ["《魔法使い》模组指南，让你能运用 leyline 和内在力量施展魔法。"]
	quest.34CF22BD9E633E4F.title: "元素掌控者"
	quest.3623CD77EBF0871F.quest_desc: ["将钻石投入被花朵环绕的池塘，即可进入暮色森林"]
	quest.3623CD77EBF0871F.title: "宁静的森林"
	quest.366C6251217F177C.quest_desc: ["炼金源链接通过消耗附近药水罐中的药水来生成源。"]
	quest.366C6251217F177C.title: "来源：Potions 中的物品"
	quest.37BDDFBD67E5F90F.quest_desc: ["来自 Ars Energistique 的源存储单元允许将源存储在 AE2 系统中。"]
	quest.37BDDFBD67E5F90F.title: "数字存储选项"
	quest.38091C2CF32583FD.quest_desc: ["空白线是制作各种盔甲和书籍线的主要材料，可用于增强你的 Ars 装备。"]
	quest.38091C2CF32583FD.title: "魔法刺绣"
	quest.38349F659EF9F1EA.quest_desc: [
		"传送卷轴是一次性物品，可以设置一个位置，然后使用它来立即传回该位置。"
		""
		"如果副手拿着卷轴并使用瞬移法术，目标将被传送到该位置，而卷轴不会被消耗。"
		""
		"最后，可以使用一张传送卷轴来建造一个永久传送门。请参阅残破卷轴中的说明。"
	]
	quest.38349F659EF9F1EA.title: "跃迁5，进入交战状态"
	quest.3845DDA15DD71304.quest_desc: [
		"Hexerei 魔改指南，让你能用巫术的力量施展魔法。"
		""
		"&oArs Hex 增加了 Ars Nouveau 与该模组许多功能的兼容性。&r"
	]
	quest.3855E025A47C05F4.quest_desc: ["瓶中的村民会保留原有的职业，并且可以正常与其交易。"]
