	quest.2E4730B6242DBEE5.title: "Allay"
	quest.2E607C1633F85752.quest_desc: [
		"洞穴小生物是可以在地下找到的中立生物。"
		""
		"若被挑衅，会用有毒的咬伤进行攻击。"
	]
	quest.2E607C1633F85752.title: "找到一个洞穴小精灵（Cavebuncle）"
	quest.2E6F4FB9E1E33D9F.quest_desc: ["Alteration Table 允许使用线来修改 Ars 盔甲（以及一些其他物品），以添加新的特性。"]
	quest.2E6F4FB9E1E33D9F.title: "魔法裁缝术"
	quest.2F679D77E19A23EE.quest_desc: ["你已经学会了 Ars Nouveau 及其所有附加组件中的每一个符文！"]
	quest.2FC1CDCCC7C1F7AF.quest_desc: ["Cat's Jewelry Tweaks 将 Ars 材料添加到可用于制作 Iron's Gems 'n Jewelry 的材料列表中。"]
	quest.3053C130ED312AF3.quest_desc: ["附魔法术炮台的施法成本是基础法术炮台的一半。"]
	quest.31750F80E93A032D.quest_desc: ["Ars Elemental 添加了灵魂绑定附魔，可防止死亡时掉落附魔物品。"]
