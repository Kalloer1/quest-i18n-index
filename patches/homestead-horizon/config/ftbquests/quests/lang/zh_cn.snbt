	quest.30B098A6B283181B.quest_desc: [
		"这里有一份实用命令的列表，供你使用！"
		"------------------"
		"/back - 传送到上一个位置。可以多次使用"
		"------------------"
		"/spawn - 将你传送到出生点"
		"------------------"
		"/rtp - 将你传送到世界中的随机位置，会尽量寻找非海洋的安全着陆点"
		"------------------"
		"/sethome <name> - 设置家园"
		"------------------"
		"/home [name] - 传送到一个家"
		"------------------"
		"/delhome <name> - 删除一个家园"
		"------------------"
		"/tpa <player> - 请求传送到该玩家处"
		"------------------"
		"/tpahere <player> - 请求玩家向你传送"
		"------------------"
		"/tpaccept <id> - 接受请求（屏幕上会出现一个按钮）"
		"------------------"
		"/tpadeny <id> - 拒绝请求（屏幕上会显示一个按钮）"
	]
	quest.30B098A6B283181B.quest_subtitle: "FTB Essentials 核心命令"
	quest.30B098A6B283181B.title: "常用命令列表"
