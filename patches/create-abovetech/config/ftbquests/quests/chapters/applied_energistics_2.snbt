	quests: [
		{
			dependencies: ["27C977F6D0F2FD26"]
			description: [
				"&l欢迎来到&bApplied Energistics 2&f！\\\\n \\\\n Applied Energistics 2（简称&oAE2&r）是一款功能极其强大的&b数字存储&f模组，它能提供高效的存储和各类自动化能力，极大地丰富你的模组化游戏体验，从早期到终局阶段皆然。\\\\n \\\\n 要开始使用AE2，你需要开采该模组的重要资源——&bCertus Quartz&f。与紫水晶类似，你可以开采Certus Quartz晶体来获取Certus Quartz &eDust&f和&eCrystals&f。\\\\n \\\\n 关于AE2的更多信息，请参阅此章节之外的维基页面："
				"&o&bappliedenergistics.github.io&f&r."
				"{@pagebreak}"
			]
			icon: "ae2:certus_quartz_crystal"
			id: "2893F483C10293E6"
			rewards: [
				{
					count: 8
					id: "3B8F9C922DCD426E"
					item: "ae2:certus_quartz_dust"
					type: "item"
				}
				{
					id: "04731B877AA067A3"
					type: "xp"
					xp: 10
				}
			]
			shape: "hexagon"
			size: 1.5d
			subtitle: "虚拟存储系统"
			tasks: [{
				icon: "ae2:sky_stone_block"
				id: "04FF05491D937AAD"
				structure: "ae2:meteorite"
				type: "structure"
			}]
			title: "Applied Energistics 2"
			x: 0.0d
			y: 0.5d
		}
		{
			dependencies: ["51236544BFEF487B"]
			description: ["在 AE2 中，你最需要最先获得的两种物品是 &b充电器&f和&b刻印机&f。\\\\n \\\\n 当&b充电器&f有电力供应时，它会消耗&e切尔图斯石英晶体&r并进行充电。这些&e已充电的切尔图斯晶体&r可用于生产&e流质&f，这是该模组中另一种重要资源。它还可以用来为任何储存能量的物品充电。\\\\n \\\\n &b刻印机&f可以将 AE2 中的各种石英晶体转化为粉尘，但更重要的是，它能用来制造特殊的&e印刷电路&f和&e处理器&f，这一点在下一个任务中会更清楚。"]
			id: "68B0B3DAF1145191"
			rewards: [{
				id: "230CB9AC06A29B7A"
				type: "xp"
				xp: 10
			}]
			subtitle: "一些基础机器"
			tasks: [
				{
					id: "29C4195E8366DBDD"
					item: "ae2:charger"
					type: "item"
				}
				{
					id: "1F40760C2108BA36"
					item: "ae2:inscriber"
					type: "item"
				}
			]
			title: "首先要做的事情就是先做第一件事"
			x: 4.0d
			y: 0.5d
		}
		{
			dependencies: ["2893F483C10293E6"]
			description: ["是时候寻找含有&b天空石&f的&e陨石&f了。它们可能在地表或地下，中心都有一颗&b神秘立方体&f。\\\\n \\\\n 这个立方体包含了制作者在Inscriber中制作AE2特殊组件所需的所有不同&e压模&f。\\\\n \\\\n 寻找陨石最简单的方法是使用&e陨石罗盘&r，将指南针放入充电器中即可制作。"]
			icon: "ae2:calculation_processor_press"
			id: "51236544BFEF487B"
			rewards: [
				{
					count: 4
					id: "1745CCFAC5C46D28"
					item: "ae2:sky_stone_block"
					type: "item"
				}
				{
					id: "53D03CFF7586058B"
					type: "xp"
					xp: 100
				}
			]
			subtitle: "外星科技？"
			tasks: [{
				advancement: "ae2:main/presses"
				criterion: ""
				id: "4D25BF3C4F05025D"
				type: "advancement"
			}]
			title: "陨石狩猎"
			x: 2.0d
			y: 0.5d
		}
		{
			dependencies: ["68B0B3DAF1145191"]
			description: ["Inscriber 和 Charger 原生支持 RF/FE，但大多数 ME 网络使用名为 AE 的专用电力系统。\\\\n \\\\n RF/FE 可以通过 ME 控制器直接转换，也可以通过 &bEnergy Acceptor&f 转换，后者可以连接到网络的任何部分，转换比例为 2:1 RF:AE。"]
			id: "00611844AFD5C31E"
			rewards: [{
				id: "241ED08CDD530739"
				type: "xp"
				xp: 10
			}]
			tasks: [{
				id: "5B4DDF66C36AF356"
				item: "ae2:energy_acceptor"
				type: "item"
			}]
			x: 3.0d
			y: -0.5d
		}
		{
			dependencies: ["00611844AFD5C31E"]
			description: ["默认情况下，没有ME控制器时，ME网络自身的内部缓冲区只有800AE，而控制器每块可增加8kAE。对于足够大的网络，这可能不够，并可能导致网络在尝试为任何连接的设备回收能量时间歇性断电。\\\\n \\\\n &b能量单元&f允许ME网络存储更多的能量，每个普通能量单元可增加200kAE，每个&b致密&f能量单元可增加1.6MAE。这些单元也可以放置在网络的任何位置以提供增大的能量缓冲区。"]
			id: "037488EF1F3581CE"
			rewards: [{
				id: "20DA7014A7644F65"
				type: "xp"
				xp: 100
			}]
			tasks: [
