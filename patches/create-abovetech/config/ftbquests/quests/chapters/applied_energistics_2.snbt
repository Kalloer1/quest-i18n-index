		{
			dependencies: ["51DE3157DE3E57B8"]
			description: ["当&bME Level Emitter&f被配置为响应特定物品和数量时，它会根据网络中该物品的存储量是否低于、高于或等于给定数量来发出红石信号。\\\\n \\\\n 例如，这可用于在某种资源低于给定最低量时，自动用红石启动特定机器以自动合成该资源。"]
			id: "3DDB0DDA7571B2C1"
			rewards: [{
				id: "2465F9C03BFFB3B8"
