# AI 初翻，未人工校对
{
	id: "0F590B3A1FD5D993"
	group: "7EB62FEAA06A0E7A"
	order_index: 0
	filename: "meet_your_fight"
	title: "迎接你的战斗！"
	icon: "meetyourfight:haunted_bell"
	default_quest_shape: ""
	default_hide_dependency_lines: false
	quests: [
		{
			x: -3.5d
			y: 3.0d
			shape: "hexagon"
			description: [
				"铃铛怪是《Meet Your Fight》模组添加的boss。使用闹鬼的铃铛可以召唤它。杀死后，它会掉落1个幻象质和3-4个金锭。"
				""
				"铃铛怪漂浮在地面上，能穿过墙壁，类似于Vex。当锁定玩家时，它会试图始终保持在目标前方和上方几格的位置。"
				""
				"所有攻击都是在短暂延迟后，发射沿直线移动的投射物波。每个投射物接触时造成 8 点伤害，并能穿透墙壁。战斗中，Bellringer 会在以下两种攻击中随机切换："
				""
				"低于50%后，它会鸣钟，使附近所有实体减速II 15秒，然后迅速向地面发射20条弹道，指向当前目标。此攻击结束后，Bellringer会恢复常规攻击，但战斗中剩余时间内每次将发射4波而非3波弹道。"
			]
			size: 1.5d
			id: "01586496C0B6EB67"
			tasks: [{
				id: "0263104BCAE479EB"
				type: "item"
				item: "meetyourfight:haunted_bell"
			}]
			rewards: [
				{
					id: "79BE5AFDD57D39F4"
					type: "item"
					item: {
						id: "lootbagmod:lootbag"
