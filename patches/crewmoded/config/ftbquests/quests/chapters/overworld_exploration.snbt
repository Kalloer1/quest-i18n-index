	quests: [
		{
			icon: "minecraft:potato"
			x: 4.0d
			y: 0.5d
			description: [
				"均衡摄入各种营养能让你更强壮、更敏捷。忽视营养平衡会让你变慢、变弱。"
				"将鼠标悬停在食物上，即可查看其提供的营养素及总营养单位（NU）数量。"
				""
				"要查看营养平衡，请按 'n' 键（可配置）或在物品栏中点击营养按钮。"
				"- 蓝色区域显示你当前每种营养素的水平。"
				"- 绿色线条显示了“目标”区域的边界。"
				"- 左侧的红线显示了“营养不良”的边界。"
				"- 右侧的红线显示了“充盈”的边界。"
				""
				"在目标区域获取所有营养素，实现均衡饮食并获得一些增益效果。"
				""
				"不要让营养水平越过红色边界，否则会受到一些负面效果。"
				""
			]
			dependencies: ["45367EFC307FBA67"]
			id: "006F7F9BE37E4FA7"
			tasks: [{
				id: "43036004E3C8DE83"
				type: "checkmark"
				title: "食物种类与加成效果"
			}]
			rewards: [
				{
					id: "641ECEA7D9EE94CE"
					type: "random"
					exclude_from_claim_all: true
					table_id: 2965759346199736654L
