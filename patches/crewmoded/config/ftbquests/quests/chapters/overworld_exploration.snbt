				{
					id: "7D9A512669F8C3A2"
					type: "xp"
					xp: 500
				}
			]
		}
		{
			icon: {
				id: "ars_nouveau:dull_trinket"
				Count: 1b
				ForgeCaps: {
					"dungeons_libraries:built_in_enchantments": {
						BuiltInEnchantments: [ ]
					}
				}
			}
			x: 7.0d
			y: 2.5d
			description: [
				"Lost Trinkets 添加了 70 多个可解锁的饰品，具有不同的能力和稀有度。"
				""
				"饰品会在你进行战斗、交易、挖矿、砍树和种田等活动时随机解锁。每种活动的解锁稀有度不同，例如：击杀首领比普通敌人有更高的几率。"
				""
				"按下键盘上的 R 键即可打开饰品 GUI。"
				"========================"
				"还有无数种奇物（baubles），它们在物品栏中有自己的专属格子。每种都具有独特的能力或属性。"
			]
