	file.0000000000000001.title: "&n&6Enigmatica 10&r"
	quest.00066BB06F509677.quest_desc: ["LaserIO 的物品卡允许激光节点运输物品。"]
	quest.000E41CCCDD048C3.quest_desc: [
		"不想手动放置原木吗？"
		""
		"用一堆原木装满放置器，让它为你完成工作！"
	]
	quest.0071209841FB1C23.quest_desc: [
		"结合了存储和远程电力传输功能。"
		""
		"末影单元是网络的核心，用于储存能量，而传送门可以远程安装，用于进出网络。"
		""
		"默认情况下，末影单元没有实际存储容量。必须插入电池或能量单元来扩展其容量。"
		""
		"&a🛈 提示：左键Shift点击电池或"
		"&a    将能量单元添加到GUI中以添加"
		"&a    容量！"
	]
	quest.00DE313EE5B9954D.quest_desc: ["一个简单的卷尺，用来测量距离。任何专业的建筑师都应该随身携带。"]
	quest.01266355AAB13C39.quest_desc: [
		"凿子提供了多种多样的方块变体，让你的建筑更生动。拿起凿子和一些方块，开始工作吧！"
		""
		"&a🛈 提示：在 EMI 中搜索 &3@chisel&r &a以"
		"&a    探索更多未知。"
	]
	quest.015857940250CE8D.quest_desc: [
		"流体模块允许路由器双向传输流体。它们也可以用于在世界中放置流体。"
		""
		"路由器需要某种缓冲储罐才能工作。一个桶就足够了，但其他模组的大型流体储罐是理想选择。"
	]
	quest.01C6F096606E3638.quest_desc: [
		"欢迎来到工业向前！"
		""
		"该模组涵盖了作物种植、畜牧和怪物操控等多样化需求。它甚至可以处理矿石并为你的基地提供动力。"
	]
	quest.01C6F096606E3638.title: "Industrial Foregoing"
	quest.01D2F67E2543155E.quest_desc: [
		"这些材料可以通过向哭泣之井投入祭品来获得。"
		""
		"探索百科全书的这一新篇章，发现所有为你开启的新可能性。"
		""
		"请务必记下这个位置，因为你需要它来获取高级合成所需的强大组件。"
	]
	quest.01E9BF979ED779AE.quest_desc: [
		"欢迎来到 Iron's Spells and Spellbooks！"
		""
		"本模组添加了众多可供探索的结构和生物，助你踏上史诗般的魔法探索之旅！"
		""
		"以下任务将帮助你尽快熟悉环境并开始施放法术。"
		""
		"【务必查看他们的在线 】{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://iron.wiki/spellbooks/\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"Wiki\",\"underlined\":true}，这是一个绝佳的知识来源。】"
	]
	quest.01E9BF979ED779AE.title: "铁匠的魔法书系列"
	quest.0200E313AEB3A08A.quest_desc: [
		"作为最强大的灵体之一，马利德可能相当难以束缚。"
		""
		"和阿弗利特一样，我们需要用它们的精华特殊浸染过的粉笔。"
		"&n                                                  &r"
		""
		"设置 Tibira's Attraction 以召唤 Unbound Marid，然后在战斗中击败它以获取其精华。"
		""
		"&6⚠ 注意：此仪式需要你完成以下操作"
		"&6    使用或投掷三叉戟之后，再使用"
		"&6    触发仪式。"
		""
		"&a🛈 提示：新制作的粉笔不会损坏！"
	]
	quest.0200E313AEB3A08A.title: "马里德束缚粉"
	quest.0227D9EC391788D6.quest_desc: [
		"厌倦了到处都能看到裸露的电线吗？"
		""
		"外壳可以用大多数实心方块制作，能很好地遮盖线缆和线缆组件，让你的AE系统看起来像是基地的有机组成部分。"
	]
	quest.0227D9EC391788D6.title: "电缆外立面"
	quest.0230942DF53BB9E5.quest_desc: ["以下是可用于为基于能量的物品和装备充能的方块。"]
	quest.0230942DF53BB9E5.title: "能量充电器"
	quest.0233E4C65745EEB0.quest_desc: [
		"稳定模块可将投影仪有效转换为建筑指南。"
		""
		"在投影仪旁边放置一个箱子，并用方块填满它。"
		""
		"方块将放置在原本会生成力场方块的任何位置，而不是形成力场。"
	]
	quest.0233E4C65745EEB0.title: "建造中"
	quest.0267B2A5D784EF45.quest_desc: [
		"溶解室会将多种材料与某种流体相结合。"
		""
		"机器一次只能容纳足够制作一件物品的材料，所以锁定特定配方并导入物品会很有用。"
		""
		"这样你可以在做其他事情时，让它运行更大的批次。"
		""
		"&6⚠ 注意：输入的物品可以是任何"
		"&6    命令！"
	]
	quest.03405336161EF1B5.quest_desc: [
		"在大多数 OriTech 机器上，你会发现一个像插座一样带两个垂直插槽的蓝色方块。这些是连接各种可附加到机器上的 Machine Addon 的连接点。"
		""
		"在这些位置添加机器扩展器可以让你连接更多附加组件，但这需要质量越来越高的机器核心。这样做会增加一个附加组件可以串联的扩展器数量，并且仍然有效。"
		""
		"例如，在机器质量4下，一个附加组件和机器之间最多可以有4个Extender。但这并不是Extender的总数，所以可以分叉连接以添加更多。"
	]
	quest.03405336161EF1B5.title: "机器附加组件"
	quest.036036EA25034BE8.quest_desc: [
		"灌注仪式通常用于将灵魂封印在物品中，从而赋予该物品特殊能力。"
		""
		"所有这些仪式都需要紫粉笔作为基础材料。"
		""
		"&a🛈 提示：新制作的粉笔不会损坏！"
	]
	quest.036036EA25034BE8.title: "灌注仪式：紫色粉笔"
	quest.03DFAA759B4E653E.quest_desc: [
		"觉醒石板能将无生命物体注入源能，赋予它们某种程度的生命。"
		""
		"这有多种用途，但在制作护身符时，我们主要关注两种：紫水晶哥布林和书虫。这两种生物的创造方法都详细说明在石碑的提示框中。"
	]
	quest.04107677B244E672.title: "阿布拉的开放咒术"
	quest.04217403B704949B.quest_desc: [
		"厌倦了手动绘制大型五芒星？仪式包能让这个过程轻松许多。"
		""
		"这些分为两个等级，都存放着与仪式相关的物品，如蜡烛、碗、水晶和粉笔。"
		""
		"查看《灵之书》中的五芒星预览时，可以使用小袋快速放置所需物品。"
		""
		"在第一层级中，你可以右键点击鬼魂方块上的便携箱，从便携箱的库存中放置该方块。这意味着你可以轻松自动拾取和放置正确颜色的粉笔，再也不会意外放置错误物品。"
		""
		"使用 Artisanal Satchel，点击预览中的任意方块即可一次性放置整个五芒星。同样，再次右键 Golden Bowl 即可清理仪式，将所有物品整齐收纳回 Satchel 中。"
	]
	quest.042650AE25DAC4CA.quest_desc: [
		"涡轮机升级后，你可能还需要升级蒸汽产量。"
		""
		"幸运的是，你的锅炉也有类似的升级选项。"
		""
		"高压大型蒸汽锅炉需要对现有的锅炉多方块进行小幅扩建，但除此之外，升级过程应是无缝的。"
	]
	quest.0465E4A27C7D4D75.quest_desc: [
		"矿石激光基地能让你稳定地获取矿物，从此告别挖矿。"
		""
		"和流体激光基地一样，这需要附近有激光钻头。"
		""
		"&a🛈 提示：你可以使用超过四个的方块"
		"&a激光基地上的激光钻头！"
	]
	quest.04CE3E8B1DF8B441.quest_desc: ["以下是 Enigmatica 10 中可用的各种流体传输方式。"]
	quest.04CE3E8B1DF8B441.title: "流体"
	quest.0545305EBB98A0BA.quest_desc: [
		"高级交换器必须绑定到另一个高级交换器上，就像简易交换器一样。"
		""
		"此版本运行需要能量，但能在更大区域工作，更适合农场使用。"
		""
		"&a🛈 提示：使用渲染区域按钮来"
		"&a    轻松配置工作区域。"
	]
	quest.0554264AE11578D2.quest_desc: [
		"压力舱是一个使用压缩空气来操作的多方块合成界面。"
		""
		"建造结构起初可能有点令人望而生畏，但指南手册详细说明了所需条件。"
		""
		"建议先建造一个 3x3x3 的结构，因为较大的结构现阶段可能需要很长时间才能填满。"
		""
		"这需要两个接口方块、一个阀门和大量压力舱壁；压力舱玻璃可选，但建议用来观察内部情况。"
	]
	quest.0554264AE11578D2.title: "压力舱室"
	quest.0557460C1A1C6525.title: "阿布拉的开放附魔台"
	quest.062BB5F675CF9F45.quest_desc: [
		"欢迎来到 Just Dire Things！"
		""
		"本模组包含多个实用小方块，可简化生活，如与实体互动、农作物种植等。"
		""
		"本章将帮助你熟悉其使用的新合成机制，并描述一些较值得注意的方块。"
		""
		"作者还在 YouTube 上发布了许多有用的视频指南。如果需要额外帮助，可以去看看。\"]"
	]
	quest.062BB5F675CF9F45.title: "只有恐怖的事情会发生"
	quest.064F6355185A51D4.quest_desc: [
		"这些可爱的、热爱黄金的小家伙们，在保持你家整洁方面能帮上大忙。"
		""
		"若绑定到箱子上，它们会迅速收集地上的所有物品并放入该箱子中。"
		""
		"它们还能从一个箱子转移到另一个箱子，并且可以采集源浆果而不会被刺伤！"
		""
		"&a🛈 提示：可以用以下方式筛选 Starbuncles"
		"&a    允许/禁止卷轴！"
	]
	quest.0672655E6A6E5502.title: "阿布拉的开放命令召唤术"
	quest.06F1A8F15128C1D9.quest_desc: [
		"虽然不是 EvilCraft 的一部分，但值得一提，刷怪器可以用丝绸之触移动，甚至可以升级！"
		""
		"查看 EMI 中生物生成器的用途，了解哪些物品会添加哪些增强。"
	]
	quest.0751B009795D7889.quest_desc: [
		"灵魂熔炉是一个大型多方块结构，用于从存放在永恒闭合箱中的灵魂里无限提取战利品。"
		""
		"结构本身至少应为暗血砖构成的空心3x3x3长方体。灵魂熔炉可安装在任意一面墙上。"
		""
		"体型较大的生物需要更大的结构，就像生物本身就在结构内部一样。所以，一个 Ghast 需要的空间会比一只 Pig 大得多！"
		""
		"&a🛈 Tip: The Spirit Furnace built as large"
		"&a    作为一个 9x9x9 的长方体。"
	]
	quest.07684F58521A4D34.quest_desc: [
		"和朋友一起玩吗？"
		""
		"你可以用注释法典互相分享符印知识。右键记录，好友右键学习。"
	]
	quest.07EC9F9B878ABF01.title: "法特玛的激励吸引力"
	quest.0842BA3FA770788D.quest_desc: [
		"受够了不断建造更多 Crafting CPU 来处理日益庞大的基地吗？改用量子计算机吧！"
		""
		"量子计算机核心会为新制作的物品生成新的虚拟CPU，每个CPU拥有256M字节存储和8个协处理器。"
		""
		"如果这还不够，核心还可以集成到更大的多方块结构中，以获得更多的存储和协同处理能力。"
	]
	quest.089E7173573C5A8E.quest_desc: [
		"起初你会发现，在再次用金属块砸东西之前，你无法长时间施放法术。提升最大法力值能让你在法力耗尽前拥有更充足的储备。"
		""
		"制作一套流浪魔导的盔甲来增加你的法力值。"
	]
	quest.089E7173573C5A8E.title: "巫师时尚衣橱"
	quest.08D496EFE575AD1E.quest_desc: [
		"运气好的话，你应该已经收到了带有所需特性的基因改造细胞。如果没有，下次再试试吧。"
		""
		"如果成功了，就把GM细胞带回DNA提取器，像处理普通细胞一样继续操作。流程结束后，你就会得到一个带有新升级特性的血液样本。"
	]
	quest.08E99B65ABE19047.quest_desc: [
		"在神秘艺术中，咒语至关重要。在 Ars Nouveau 中更是如此，咒语既可以直接从咒语书中使用，也可以注入咒语炮台自动发射，甚至可以附魔到装备上，在特定条件下触发。"
		""
		"先制作一本新手魔法书。里面附带几个可以组合的符文，但很快你就会想探索更多符文，施展更厉害的魔法。"
		""
		"&6&n实用按键绑定&r"
		""
		"[\"• 打开书 (\",{\"color\":\"gold\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"打开书\"}]},\"keybind\":\"key.ars_nouveau.open_book\"},\")\"]"
		"[\"• 选择HUD (\",{\"color\":\"gold\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"选择HUD\"}]},\"keybind\":\"key.ars_nouveau.selection_hud\"},\")\"]"
		"[\"• 下一个槽位 (\",{\"color\":\"gold\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"下一个槽位\"}]},\"keybind\":\"key.ars_nouveau.next_slot\"},\")\"]"
		"[\"• 上一个物品栏 (\",{\"color\":\"gold\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"上一个物品栏\"}]},\"keybind\":\"key.ars_nouveau.previous_slot\"},\")\"]"
		""
		"如果你对附魔魔法感到有些畏惧，那很正常。这是一个庞大而强大的系统。不过，我们会在任务中尽量指出一些实用的法术。"
		""
		"指南书中还有一部分说明了规则，例如在&aEffect&r前放置&5Form&r，或者&6Augments&r的允许位置。"
		""
		"[\"最后，社区驱动的 \",{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://ars.guide/spells/introduction/compendium/\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"Ars.Guide\",\"underlined\":true},\" 拥有一个实用法术库。欢迎探索并提交你自己的作品！\"]"
		""
		"&6&n示例法术&r"
		""
		"&7多功能工具&r"
		"&5触摸&r > &a破坏&r"
		""
		"&7魔法飞弹&r"
		"&5投射物&r > &a伤害&r"
		""
		"&a🛈 提示：参考指南了解更多信息。"
		""
		"&6⚠ 注意：法术最多可包含三十个符文。"
	]
	quest.0988DC06DD5A6935.quest_desc: [
		"想从工具上移除诅咒吗？把它和血液一起扔进净化器，就能清除诅咒了。"
		""
		"净化器还可以用来将附魔从一个物品转移到另一个物品上。"
		""
		"只需将物品和Blook放入净化器，它就会将随机附魔转移到Blook上，之后可以在铁砧上将其重新应用到另一件工具上。"
	]
	quest.09B6773CDA5A7565.quest_desc: [
		"附魔台很可能是你接下来想搭建的设备，因为它可用于更高级的制造、装备升级和附魔！"
		""
		"该装置为自由形式的多方块结构。附魔装置必须置于奥术核心之上，但基座可放置在核心3格内的任意位置。"
		""
		"基座中的物品将被这些配方消耗掉。"
	]
	quest.09C3C5173499DF7C.quest_desc: [
		"要制作精华，你需要在浸染室旁放置一些基座，并在每个基座中放入关键物品。"
		""
		"这些关键物品&n不会被消耗&r，仅用于设置配方。"
		""
		"有效放置区域是以浸染室为中心的 3x3x3 范围。"
		""
		"&a🛈 提示：来源是可选的！"
	]
	quest.09C3C5173499DF7C.title: "精粹（Essences）"
	quest.09E7D266A7724F09.quest_desc: [
		"兼具有限存储功能的流体管道，每个方块空间都存有缓冲流体。"
		""
		"网络中的数量越多，每刻能传输的流体就越多。"
		""
		"更多信息请参阅其维基上的\",{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://wiki.aidancbrady.com/wiki/Mechanical_Pipe\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"机械管道\",\"underlined\":true},\"文章。\"]"
	]
	quest.09EE2DE8B55928C2.quest_desc: [
		"新技术往往意味着更高的效率。青铜压缩机可将锭与板的比例从原来的2:1变为1:1。"
		""
		"不过，先别扔掉锻造锤。青铜压缩机在某些方面确实更胜一筹，但像金属棒这样的组件，还需要另一台机器。"
		""
		"&a🛈 提示：右键点击许多青铜级物品"
		"&a    machines with Gunpowder will briefly"
		"&a    加快它们的速度。"
	]
	quest.09F2EA329EF3650F.quest_desc: [
		"汞催化剂和硫酸通量发射器在阵列中承担多种功能。"
		""
		"首先，最重要的，硫磺通量发射器将所有前一个方块连接起来，并为它们提供能量。"
		""
		"汞催化剂会像一块能量电池一样工作。需要持续不断地为其提供汞碎片。"
		"&n                                                  &r"
		""
		"将催化剂放置在工作区，并用汞碎片为其供能。"
		""
		"手持硫酸流处理器，右键点击阵列的每个基座。它们会被高亮显示，表示已被选中。"
		""
		"将硫酸流处理器放置在催化剂上。阵列现在应该已完全形成并启动。"
		""
		"如果你已经放入硫磺，过程应立即开始，发光效果将从发射器流经每个基座。"
	]
	quest.09F3415422E4A274.quest_desc: [
		"更高级别的五芒星需要更强大的结构来辅助收容和控制被召唤的灵体。"
		""
		"不过别担心，这些增强并不会妨碍五芒星执行低阶仪式。"
		""
		"每次升级都会增加新功能，而不会移除任何功能。"
	]
	quest.09F3415422E4A274.title: "赋能仪式 (Empowering Rituals)"
	quest.0A0D539C1285F40F.quest_desc: [
		"要开始使用自然光环，需要用一些亮晶纤维涂抹在树叶上。"
		""
		"只需右键点击这些纤维到树叶上并等待。随着时间的推移，它们会慢慢转化并扩散，将树叶变成鲜艳的金色。"
		""
		"这些金叶在破坏时会掉落金叶，但只要相邻有叶子，它们就会无限蔓延。"
		""
		"所以，考虑留下几个未破坏的，这样它们就能蔓延到新的叶子上。"
	]
	quest.0A0D539C1285F40F.title: "金叶子"
	quest.0A170AE8092145FA.quest_desc: [
		"一种基础的电力来源，水车需要流动的水来推动，从而使其旋转。"
		""
		"最多三个水轮可以连接到同一个动能发电机上。"
	]
	quest.0AEF5FB6530F4D65.quest_desc: ["佩戴光谱眼镜后，非敌对的灵体将完全无视你的存在，前提是你保持礼貌。"]
	quest.0B04BC5F88746182.quest_desc: ["以下是一整套存储系统，可存放多种物品，并通过单一、易于浏览和搜索的界面呈现。"]
	quest.0B04BC5F88746182.title: "存储系统"
	quest.0B05FA716D7335D2.quest_desc: [
		"该模组包含多个等级的流体燃料，用于补充其发电功能。通常通过放置流体、投入物品，然后收集产物来制作。"
		""
		"简易投掷器是自动化此类配方的好工具。"
	]
	quest.0B27453EDEC089EB.quest_desc: [
		"颜料提取器、颜料混合器和绘画机协同工作，能更高效地生产染料。"
		""
		"染色方块，如彩色羊毛，可在颜料提取器中还原为化学颜料。"
		""
		"颜料可以直接用绘画机涂在材料上，也可以注入染料基底来制作标准的Minecraft染料。"
		""
		"最后，颜料混合器可以轻松混合出粉色等颜色，无需直接采集这些颜料。"
		""
		"&a🛈 提示：考虑建造一个绵羊农场，使用"
		"&a    所有染色剂颜色，轻松又简单"
		"&a    可再生的染料来源！"
	]
	quest.0B27453EDEC089EB.title: "颜料（Pigments）"
	quest.0B9350ECD4D5EA14.quest_desc: [
		"Iesnium Anvil 基本取代了标准砧块。"
		""
		"它不可破坏，并能降低物品维修或组合的成本。"
		""
		"还可以将附魔等级提升至比正常高一级的附魔，让你能制作出幸运 IV 或保护 V 的附魔书！"
	]
	quest.0BA9F73FFBAAB6E7.quest_desc: [
		"和之前的阶段一样，我们的努力带来了新技术，这次是先进的计算机组件。"
		""
		"一旦能稳定制作这些组件，你就准备好进阶到EV Tier了。"
	]
	quest.0BA9F73FFBAAB6E7.title: "高级计算模块 (Advanced Computing)"
	quest.0BF882C463675433.quest_desc: [
		"既然我们已经有了DNA，就需要知道它能做些什么。"
		""
		"所有生物都会掉落基础基因，但其他生物也有几率掉落更专业的基因，而这些才是我们的最终目标。"
		""
		"例如，如果你用羊开始这个过程，就有机会获得“食草基因”，能让你右键点击草地来吃掉它。"
		""
		"&a🛈 提示：查看任何给定物品的配方"
		"&a    在EMI中查看有哪些生物会生成"
		"&a    的来源！"
	]
	quest.0BFD22A98E0F4ACF.title: "Xovrenth Adjure"
	quest.0C1DCD8850E6857C.quest_desc: ["血之宝箱是每个家都必备的绝佳工具。用血液填充它，将磨损的工具浸泡其中，即可缓慢修复至原始状态。"]
	quest.0C1DCD8850E6857C.title: "修复物品损坏"
	quest.0CBCE3A0D149AED0.quest_desc: [
		"前几个阶段主要侧重于技术起步，而EV阶段将进入核科学领域，涵盖材料加工和电力生产。"
		"&n                                                  &r"
		""
		"运行核反应堆比大多数机器需要更多努力。不仅需要燃料和冷却，而且这些材料进入哪个舱口都会改变反应堆的运行方式。"
		""
		"[\"以下网站提供了一个反应堆规划器来帮助你，还有一些示例建造供你参考：\",{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://github.com/warbaque/MI-Reactor-Planner/blob/main/README.md\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"MI 反应堆规划器\",\"underlined\":true}]"
		""
		"从小型反应堆开始可能很诱人，但它会很慢且效率低下。如果你有材料，请直接升级到巨型尺寸。"
		""
		"&a🛈 Tip: Place the controller block, then "
		"&a    手持扳手或撬棍即可查看"
		"&a    结构或有效位置用于"
		"&a    孵化口。"
		""
		"&6⚠ 注意：反应堆不会熔毁"
		"&6    并且不要爆炸。&r"
	]
	quest.0CBF7D8E39F0B25A.quest_desc: ["可配置储罐是一个多储罐，最多可容纳九种不同的流体。"]
	quest.0CCE0467AF123EAB.quest_desc: [
		"Just Dire Things 引入了多种具有特殊能力的工具，从范围破坏到物品传送，再到连锁背包。"
		""
		"更高级别的工具也使用FE而不是耐久度！"
		""
		"&a🛈 提示：右键潜行使用这些工具可以"
		"&a    打开他们的选项菜单。"
	]
	quest.0CD74FE194111D3E.quest_desc: [
		"核反应堆是一个巨大的自由形式多方块结构，用于利用铀或钚来发电。"
		""
		"该结构本身由一个中空的长方体反应堆墙壁组成，任意一边最长可达64个方块。"
		""
		"各种端口将安装在这个外壳中，并配有控制面板，内部将填充燃料棒和冷却结构。内部允许有空隙，不会对结构产生负面影响。"
		""
		"控制反应堆并保持其冷却至关重要。如果过热，它将长时间关闭。可以使用反应堆红石端口来监控内部温度，并在过热时禁用反应堆。将其保持在信号值9以下，应能使反应堆处于安全区。"
		""
		"【这里有很多活动部件，请务必查看他们的维基上关于核反应堆的介绍页面，该页面非常出色地描述了此系统的运作方式。】"
		""
		""
		"&6⚠ 注意：熔毁已被禁用！"
	]
	quest.0CD74FE194111D3E.title: "核反应堆 Nuclear Reactor"
	quest.0D236C298CFF8365.quest_desc: [
		"传送器是穿越世界，甚至是穿越基地的绝佳方式。"
		""
		"没有框架的传送器只能用作目的地，无论是从便携式传送器还是带框架的完整传送器出发。"
		""
		"安装了框架后，其他实体（如村民甚至矿车）也能通过！"
		""
		"&a🛈 提示：目的地必须已加载。"
		"&a    安装一张锚定卡，以便将"
		"&a    传送器始终可用！"
	]
	quest.0D32F25CCBC9B192.quest_desc: [
		"用于传输现代工业化EU电能的简易电源线。"
		""
		"它们可以为使用FE的方块供电，但只能接受Modern Industrialization发电机的电力。"
	]
	quest.0D65061DFD04B301.quest_desc: [
		"模块化路由器的物品模块允许路由器向物品栏发送或拉取物品。"
		""
		"第一层级 MK1 只能直线传输，而 MK2 可与范围内的任何链接物品栏互动。MK3 发送器特殊之处在于它们没有距离限制，且可在不同维度间工作。"
		""
		"分配器模块每个最多可连接8个物品栏，非常适合分布式合成或从多台机器收集物品。"
	]
	quest.0D65061DFD04B301.title: "物品模组 (Item Modules)"
	quest.0D7299047145F61C.quest_desc: [
		"早期，你生产的Creosote Oil大部分都会用于制作Treated Wood，因为它会用到许多配方中。"
		""
		"手动合成会很麻烦，所以一定要研究自动化合成来减轻负担！"
	]
	quest.0D7B7B9CF7362FD8.quest_desc: [
		"有不想要的特性吗？可以通过制作抗质粒来移除它们。"
		""
		"用该类型的Plasmid一起合成，将其与你要移除的性状绑定。然后像普通Plasmid一样，将其注入血样中。"
	]
	quest.0D80520D08A5C287.quest_desc: [
		"MV蒸汽涡轮机发电量更大，但蒸汽消耗也更快。尽早升级到高级大型蒸汽锅炉会让生活更轻松。"
		""
		"和之前的锅炉一样，这个多区块结构也可以使用固体燃料，例如褐煤粉。"
		""
		"&a🛈 提示：先放置控制器方块，然后"
		"&a    手持扳手或撬棍即可查看"
		"&a    结构或有效位置用于"
		"&a    孵化口。"
	]
	quest.0DA6F0172E06CCB1.quest_desc: [
		"在工具升级系统的基础上，Just Dire Things 还为各防御等级引入了一系列能力。"
		""
		"和工具一样，这些护甲需要通过锻造台来附魔。不过，其中许多是主动能力，而非常驻效果。"
		"其中一些能力，例如奔跑速度，会随着护甲等级提升而增强。"
		"&n                                                  &r"
		""
		"要配置盔甲能力并将其绑定到按键上，你需要手持 Just Dire Things 工具并同时穿戴该盔甲。"
		""
		"潜行右击工具打开菜单，然后点击护甲槽菜单中显示的护甲部件。"
		""
		"以下页面将介绍各项能力的具体作用。"
		""
		"&a🛈 提示：要查看某个部件有哪些能力"
		"&a    拥有，悬停时按住 Shift 键"
		"&a    it in EMI. "
		"{@pagebreak}"
		"&7&n头盔能力"
		""
		"• &aMind Fog&r: 降低生物追踪性"
		"将距离缩短一半。"
		"• &aStupefy&r: 使生物短暂地陷入眩晕"
		"激活时会忘记你。forget you on activation."
		" • &aNight Vision&r: Provides Night Vision "
		"持续不断地。"
		"• &aDebuff Remover&r: 移除负面效果"
		"在激活时触发。"
		"• &aMental Obliteration&r: 禁用生物体的"
		"激活后开启AI。"
		"{@pagebreak}"
		"&7&n胸甲能力"
		""
		"• &aInvulnerability&r: 获得完全"
		"短时间内获得无敌状态"
		"在激活时触发。"
		"• &a熄灭&r: 自动"
		"当你在被火焰灼烧时，它会熄灭火焰"
		"正在燃烧。"
		"• &aElytra&r: 授予鞘翅飞行能力。"
		"• &a死亡保护&r: 防止死亡"
		"冷却期间内只能使用一次。"
		"• &a飞行&r: 获得创造模式飞行能力。"
		"• &aLava Immunity&r: 完成火焰免疫。"
		"{@pagebreak}"
		"&7&n腿部能力加成"
		""
		"• &a奔跑速度&r: 可调节的奔跑速度"
		"奖励。"
		"• &a行走速度&r: 可调节的行走速度"
		"奖励。"
		"• &a游泳速度&r: 可调节的游泳速度"
		"奖励。"
		"• &aDecoy&r: 召唤替身以分散注意力"
		"生物群系中的生物。"
		"• &a相位&r: 允许你穿过物体"
		"方块。无法赋予玩家以下能力："
		"在方块中可见。下落会穿过方块"
		"穿过地面。"
		"{@pagebreak}"
		"&7&n靴子能力"
		""
		"• &aStep Assist&r: 跨过半砖方块。"
		"• &a跳跃增强&r: 可调节的跳跃高度"
		"奖励。"
		"• &aNegate Fall Damage&r: 轻柔着陆。"
		"• &a地面践踏&r: 击退附近的敌人"
		"激活时生成生物。"
		"• &a地震&r: 使目标减速"
		"激活时会吸引附近的生物。"
	]
	quest.0DA6F0172E06CCB1.title: "仅仅是 Dire 盔甲而已"
	quest.0E1258E2B2C7FFD5.quest_desc: ["适用于Modular Routers的模组，允许路由器为每个模块内的最多8个方块无线供电。"]
	quest.0EEEA27699137B6C.quest_desc: [
		"用汞蒸馏器，我们将提炼常见材料，提取出它们的精粹——汞。"
		""
		"水星本身是神学（Theurgy）中大多数过程的能量来源，对这一过程至关重要。"
		"&n                                                  &r"
		""
		"将汞蒸馏器置于火焰祭坛之上。物品可右键放入蒸馏器，或通过任何物品物流系统送入。"
		""
		"Pyromantic Brazier 主要燃烧熔炉燃料，提供方式也相同。"
	]
	quest.0EEFC631A67266B1.quest_desc: [
		"欢迎来到 OriTech，一个专注于机器动画的新科技模组！"
		""
		"在完成这个任务部分的同时，别忘了查看他们的 \",{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://moddedmc.org/en/project/oritech/docs\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"Wiki\",\"underlined\":true},\" 哦！\"]"
	]
	quest.0EEFC631A67266B1.title: "OriTech"
	quest.0EF0F6D0012FB59E.quest_desc: [
		"急需岩浆？滴水石锥不给力？试试岩浆工厂吧！"
		""
		"这个简单的多方块结构能将能量直接转化为美味的熔岩。"
		""
		"建造方法：将控制器放置在地面上，并在其上方放置一个辅助方块，例如鹅卵石。接着，将外壳放置在辅助方块两侧。最后，移除辅助方块并提供电源。"
		""
		"辅助方块所在的空间会定期生成岩浆。用你喜欢的流体泵把它舀起来，大功告成！"
	]
	quest.0EF0F6D0012FB59E.title: "熔岩工厂"
	quest.0F04956D59A78393.quest_desc: [""]
	quest.0F04956D59A78393.title: "多元宇宙"
	quest.0F185E80D0EFF772.quest_desc: [
		"每种电线层级在工程师手册中都有其优缺点。简而言之，HV最适合长距离传输，但在多数情况下，连接到机器前最好先降压至MV或LV。"
		""
		"为此，可以使用变压器将高压干线电压降至更安全、更合适的水平，然后再连接到一组机器上。"
	]
	quest.0F97525097FA4573.quest_desc: [
		"想找个有趣的方法把物品从远处运回来吗？比如从遥远的基岩采集器运回矿石？"
		""
		"无人机港口就是你的不二之选。"
		""
		"两端各需要一个，并且必须用 Target Designator 连接起来。连接后，它们会定期单向运输物品，从源点到目的地。"
	]
	quest.0FCC51B49080984E.quest_desc: ["以下是各种形式的流体存储，从单方块储罐到巨大的多方块结构。"]
	quest.0FCC51B49080984E.title: "批量流体存储装置"
	quest.0FE11A739BA3623E.quest_desc: [
		"改革阵列本身是一个自由形式的多方块结构。各部分的具体位置并不重要，只要它们大致相邻即可。"
		""
		"这个配方不需要很大的数组，所以 5x5 的区域对于多方块结构来说绰绰有余。"
		""
		"我们要放置的第一个部件是 Reformation Target Pedestal。这个基座会告诉阵列我们想要合成什么，也就是更多的 Quartz Sulfur。"
		"&n                                                  &r"
		""
		"将目标基座放置在工作区，并用石英硫磺右键点击它。"
		""
		"&a🛈 提示：可以通过右键再次提取硫磺。"
	]
	quest.10021117D89C531F.quest_desc: [
		"发酵器是任何工厂的重要组成部分，可将糖转化为生物柴油和杜罗塑料生产中使用的乙醇。"
		"&n"
		""
		"建造此结构的指南可在工程师手册中找到。"
		""
		"或者，查看来自 Create 的 Schematic Table 或 \",{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://blockprints.io/user/MuteTiefling\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"BlockPrints\",\"underlined\":true},\" 以获取更好的建造指南。\"]"
		""
		"&a🛈 提示：工程师手册高亮显示"
		"&a    在&c红色&r&a中的形成方块。"
	]
	quest.10131A9E07C7CE9E.quest_desc: [
		"Ever wished you could perform rituals instantly?"
		""
		"将邪典圣杯安装在祭品碗的位置，现在你就可以做到了！"
	]
	quest.105622B089F794C8.title: "罗纳扎的联系方式"
	quest.10762E4BB7F187BE.quest_desc: [
		"等待奇可博生长可能会有点耗时。谁也不想这样，对吧？"
		""
		"喂它们吃Gysahl蛋糕，让它们立刻成长为成年体！"
	]
	quest.11EDFB60C787114D.quest_desc: [
		"Goo 用于转化其他材料，从而获得本模组中所有分阶的配方材料。"
		""
		"我们先制作一些 Ferricore 和 Primal Coal。为此，放置 Primogel Goo，然后在六个面中的任意一个放置 Coal Blocks 或 Iron Blocks。可以同时使用全部六个面。"
		""
		"当煤炭和铁被黏液完全包裹时，它们将被替换为晶体，可以将其打破以获得转化后的材料"
		""
		"&6⚠ 注意：Goo 很饿，需要被喂食"
		"&6    开始工作！"
		""
		"&6    右键点击物品以激活它。"
		"&6    要找出哪些物品有效，请搜索"
		"&3    #goo_revive_tier_1&r&6 在EMI中！"
	]
	quest.11FE0DE653577AFB.quest_desc: ["一个简陋但便宜的充电站。可以为插入其中的任何基于FE的设备充电。"]
	quest.1272A1D0BD9934AE.quest_desc: [
		"想不想找些高档的新木材来盖房子？"
		""
		"Productive Trees 几乎能满足你的所有要求。"
		""
		"使用此模组很简单，但请务必查阅指南，了解有关异花授粉的详细说明。"
	]
	quest.1272A1D0BD9934AE.title: "高效树木模组 (Productive Trees)"
	quest.128449F277949E31.quest_desc: [
		"在活跃的 Spirit Crucible 附近放置 Repair Pylon，可以保持 Impetus 处于最佳维修和运行状态。"
		""
		"当然，修复金字塔需要合适的材料，详细信息在EMI中。它同样可用于修复许多原本需要在砧上修复的物品。"
		""
		"对于这类物品，你需要将它们放置在附近的物品架或物品底座上。"
		""
		"&6⚠ 注意：只有灵魂会被消耗掉"
		"&6    by this process."
	]
	quest.128669F9F6431E0A.quest_desc: [
		"生物反应器是一种更先进的发电机，产生的FE取决于其燃烧的物品种类数量。"
		""
		"总的来说，它能接受种子、树苗和农作物。"
		""
		"填入单一物品只能产生微弱的 4 FE/t，但放入八种不同物品，就能产出高达 256 FE/t 的惊人效率。"
	]
	quest.12903CD319AE35B9.quest_desc: [
		"有了蒸汽冲天炉，就可以开始生产钢了。"
		""
		"这种重要材料未来会大量使用。因此，建立稳固的生产线将至关重要。"
		""
		"&a🛈 提示：先放置控制器方块，然后"
		"&a    手持扳手或撬棍即可查看"
		"&a    结构或有效位置用于"
		"&a    孵化口。"
	]
	quest.12AF74656C5F124A.quest_desc: [
		"SAG Mill 可用于研磨和粉碎矿石到植物等各种材料。"
		""
		"研磨球是可选的，但使用它们会提高多种材料的产量。"
		""
		"它们会随时间消耗，所以需要判断是否值得额外花费。"
		""
		"&6⚠ 注意：机器需要电容器 Capacitor"
		"&6    储存能量并运行。"
	]
	quest.12B89E4EF7282B86.quest_desc: [
		"Mekanism 机器可以通过多种方式进行升级。"
		""
		"第一个，可能也是影响最大的，是 Tier Installer。大多数机器都支持安装，可以通过潜行右键点击机器来安装。"
		""
		"如果机器有“工厂”版本，它将接受一个等级安装器。同样，储罐、箱子和能量立方体都可以使用等级安装器进行原地升级。"
		""
		"每个等级都能让机器并行工作，所以装有基础等级安装器的熔炉一次能冶炼三件物品！"
	]
	quest.12B89E4EF7282B86.title: "Tier 安装器"
	quest.130C6FC212F64474.quest_desc: [
		"流体激光将是下一个收集特殊怪物液体的站点。这次，你需要通过钻探凋零来获取以太气体。"
		""
		"要使其运作，激光基地必须直接放置在凋灵的正上方。最简单的方法是在建造凋灵时，将钻头放在中间的头骨上。一旦其他头骨放置完毕，凋灵形成，激光就会完全对准。"
		""
		"至少一个激光钻头也必须朝向基地放置。具体位置不重要，只要基地在钻头的工作区域内即可。"
		""
		"这个装置会伤害正在钻探的怪物，所以保持它的治疗很重要。"
		""
		"静止舱既能治疗怪物，又能将其收容，施加减速效果并禁用其AI。"
		""
		"&a🛈 提示：你可以使用超过四个的方块"
		"&a激光基地上的激光钻头！"
	]
	quest.134D69D38C983AE2.quest_desc: [
		"柴油发电机是一种强大的电源，应该能够满足沉浸式工程的大部分能源消耗。"
		""
		"它会快速消耗燃料，因此保持生产速度将是操作该装置最重要的方面。"
		""
		"有效燃料列表请参阅工程师手册。"
		"&n"
		""
		"建造此结构的指南可在工程师手册中找到。"
		""
		"或者，查看来自 Create 的 Schematic Table 或 \",{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://blockprints.io/user/MuteTiefling\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"BlockPrints\",\"underlined\":true},\" 以获取更好的建造指南。\"]"
		""
		"&a🛈 Tip: The Engineer’s Manual highlights "
		"&a    在&c红色&r&a中的形成方块。"
	]
	quest.1386A595D84FE6FC.quest_desc: [
		"离心机将解锁多种新材料，例如更便宜的钢所需的碳粉，以及用于先进技术的各种矿物。"
		""
		"考虑设置几个来持续处理熔岩、红石和粗铁等材料，以获得一些非常有用的副产品。"
	]
	quest.13B5382C24CB79B3.quest_desc: [
		"仍在制作中。"
		""
		"内容即将推出™！"
	]
	quest.13B5382C24CB79B3.title: "红石电路"
	quest.13D810A6AB4FACC0.quest_desc: [
		"下一个重要的材料进步是不锈钢，在真空冷冻机中制作。这台机器对后续几种材料也至关重要。"
		""
		"&a🛈 Tip: Place the controller block, then "
		"&a    手持扳手或撬棍即可查看"
		"&a    结构或有效位置用于"
		"&a    孵化口。"
	]
	quest.1447C4568B9A1606.quest_desc: ["[\"从那里，硫磺需要被 \",{ \"text\": \"孵化\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"59A56F3053A30126\" },\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]} },\" 回炉成锭。\"]"]
	quest.1447C4568B9A1606.title: "孵化"
	quest.14555CEDF53F68FC.quest_desc: [
		"纠缠圣杯允许血液或其他流体共享，每对圣杯共享同一个物品栏。"
		""
		"圣杯总是成对制作。但若想向网络中添加另一个圣杯，请使用该网络中的圣杯放置在制作界面的中心。"
		""
		"&a🛈 提示：背包里的圣杯可以"
		"&a    可用于自动填充其他容器"
		"在你的物品栏中！&a"
	]
	quest.14688BF9C4B5766C.quest_desc: [
		"玩家发射器可为背包中基于FE的物品和装备无线充电。"
		""
		"把它插在你的基地里，就可以随时随地享受远程充电了。"
		""
		"&a🛈 Tip: Install a Dimensional Binding Card"
		"&a    在任何维度中为充电。"
	]
	quest.14CC5EDC04D6BAC7.quest_desc: [
		"解锁三级符文需要与野性奇美拉战斗。"
		""
		"击败它获得的贡品不仅能用来升级你的法术书，还能用来将 Ars Nouveau 的护甲升级到更高等级。"
		""
		"这场战斗并不容易。做好准备再来。"
		"&n                                                 &r"
		""
		"要召唤奇美拉，你需要先放置仪式火盆，然后用召唤野人石板右键点击它。"
		""
		"接下来，将野性尖刺、野性角和野性翼投掷到火盆上以增强它。"
		""
		"最后，再次右键单击壁炉，然后退后。"
		""
		"&a🛈 提示：如果你缺少一个或多个"
		"&a    这些野人碎片，只要用这个"
		"&a    未强化的召唤平板电脑"
		"&a    普通的 Wilden。"
		""
		"&c⚠ 警告：奇美拉会破坏方块。"
	]
	quest.14CC5EDC04D6BAC7.title: "召唤野人（Wilden）的仪式"
	quest.14D5764532C5EEB0.quest_desc: [
		"QIO 系统是一个基于量子纠缠传送器技术建造的巨型存储和路由系统。本质上，它就是一个超大的箱子。"
		""
		"可以通过 QIO 控制面板远程访问该系统，用于手动合成或访问材料。随身携带一个，并在需要访问网络时放置下来。"
		""
		"在专门的章节中阅读有关此系统的更多信息：\",{\"clickEvent\":{ \"action\": \"change_page\", \"value\": \"4D1E38918B64CD4E\" },\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\": \"Mekanism\",\"underlined\":true},\"。\"]"
	]
	quest.14DEE45EA9666015.quest_desc: [
		"更喜欢在家里放一个环境蓄能器吗？或者，你或许想收集特定群落的精华？"
		""
		"破坏黑暗神庙中的环境蓄积器不会给你方块，但会给你一个物品，可用于制作这个以血为燃料的替代品。"
		""
		"该装置需要消耗大量血液才能正常工作，血液必须通过环绕装置呈环形放置的8个储罐来供应。"
		""
		"放置好蓄能器后，寻找会高亮显示暗箱预期放置位置的烟雾粒子。"
	]
	quest.156DEEC0CB40D7DB.quest_desc: [
		"允许多个力场投影仪协同工作以覆盖更大区域，同时允许在它们之间自由通行。"
		""
		"例如，可以设置几个穹顶并允许它们相交。在相交处，两个力场将不会被创建，从而留出开放空间。"
	]
	quest.157A20804F9E8F83.quest_desc: [
		"有了所有这些世界生成内容，物品收集器无疑会派上用场。"
		""
		"此物品收集器会将物品放置到所附的背包中，并可通过多种方式过滤。"
		""
		"&a🛈 提示：使用渲染区域按钮来"
		"&a    轻松配置工作区域。"
	]
	quest.15829059DE275E47.quest_desc: [
		"这些模组会改变原野的外观。"
		""
		"• &7Glow Modules&r 设置力场"
		"方块来发出光亮。"
		""
		"• 使用&7Silence Modules&r制作投影仪"
		"以及其他机器停止生产，所以"
		"发出很大的噪音。"
		""
		"• &7伪装模块&r允许部队"
		"将方块设为不可见，或者将其拾取"
		"在另一个方块的外观上。放置"
		"在另一个升级中获得所需的方块"
		"选择外观的插槽。"
	]
	quest.15829059DE275E47.title: "外观升级模组 (Aesthetic Upgrades)"
	quest.159F7020B1DE875D.quest_desc: [
		"想带上你的新朋友一起来吗？"
		""
		"将它们带到束缚仪式附近，你就能获得一份束缚卷轴，在空中右键即可学习。"
		""
		"学会后，你的附魔书“伙伴”标签页下会出现一个新条目。你可以从那里立即召唤一个伙伴来为你提供增益。"
		""
		"这些好处包括法术伤害和掉落率提高，以及速度和物品收集能力的增强。"
		""
		"查看每个绑定脚本的工具提示，了解它能为你提供什么！"
	]
	quest.15CECF38FB6CEADE.quest_desc: [
		"想要更强大的工具？采矿小工具是一个多功能模块化工具系统。"
		""
		"将工具放入修改台以插入所需的模块。你可以找到涵盖丝绸之触和时运等标准附魔的模块，而其他模块则能延长电池续航、增加范围和挖掘区域。"
		""
		"别担心，不同模型之间没有区别，选你最喜欢的就好。"
		""
		"&a🛈 提示：在 EMI 中搜索 &3@mininggadgets&r &a以查找"
		"&a    探索更多未知。"
	]
	quest.15CECF38FB6CEADE.title: "采矿小工具"
	quest.16A5D60F0825B318.quest_desc: [
		"量子纠缠传送器是跨维度传输材料和能量的枢纽。"
		""
		"除了放射性材料外，几乎可以运输任何东西。"
		""
		"&a🛈 提示：设置多个频道以保持"
		"&a    整理好，避免交叉感染"
		"&a    污染！"
	]
	quest.16A8BFECD924477D.quest_desc: [
		"现阶段有几种压缩空气的方法可供选择。"
		""
		"液体压缩机使用液体燃料运行，可以作为空气压缩机的好替代品。"
		""
		"PNC 提供的液体燃料仍需一定的发展，但在早期游戏中非常实用，生物柴油是一种易于再生的能源。"
		""
		"其他模组也有液体燃料，可以与PNC配合使用。所以，如果你玩过Just Dire Things或Modern Industrialization，可能会找到一些有用的燃料来帮助你起步。"
		""
		"如果你讨厌乐趣，手动压缩机会让你瞬间怀疑自己人生的选择。"
	]
	quest.16A8BFECD924477D.title: "替代基础压缩机（Alternative Basic Compressors）"
	quest.16BFB19411FE195F.quest_desc: [
		"LaserIO 是一款功能强大的综合物流模组。"
		""
		"查看指南，了解更多信息，掌握如何利用它来占据优势！"
	]
	quest.16BFB19411FE195F.title: "LaserIO"
	quest.16C7D5478BF3D449.quest_desc: [
		"学习模组章节旨在帮助你上手大型内容模组。这些章节分为科技和魔法部分，会大致说明如何推进模组进度，并提供使用不同功能的小技巧。"
		""
		"这些章节涵盖的内容很多，但并不全面。所以，请务必查阅那些有说明文档的模组的文档。"
	]
	quest.16C7D5478BF3D449.title: "学习模组 (Learning Mods)"
	quest.16E6C8143533F2C5.quest_desc: [
		"驯服的奇可偶尔会掉落羽毛。羽毛可用于制作马鞍和一些非常可爱的盔甲。"
		""
		"看到的时候一定要把它们拿起来！"
	]
	quest.16F69571092CAB9A.quest_desc: [
		"被附身的生物除了末地石之外，还能用来获取其他材料。"
		""
		"可以召唤各种被附身的生物，轻松获取诸如恶魂之泪、末影珍珠、潜贝壳等物品。"
		""
		"你可以在 EMI 中查找它们的配方，以找到相应的仪式。"
		""
		"&6⚠ 注意：这些仪式通常需要"
		"&6    献祭。触发仪式，如"
		"&6    如常，然后杀死指定的生物"
		"&6    五芒星附近。"
	]
	quest.16F69571092CAB9A.title: "不常见的材料"
	quest.176DAF596793D4FF.quest_desc: [
		"核废料可以储存在废料桶中并安全处置，但最好将其再加工成钋或钚。"
		""
		"这些材料可用于制作高级科技物品。"
		""
		"或者，可以将废料再加工成裂变燃料并送回反应堆，从而大大提高系统的燃料效率。"
		""
		"&a🛈 提示：只存放已消耗的核废料"
		"&a    在废料桶中，因为它没有其他去处"
		"&a    使用。"
	]
	quest.176DAF596793D4FF.title: "废物管理"
	quest.180610F8982DB0C3.quest_desc: [
		"想让你的矿石更耐用一点吗？试试用破碎机处理你的原矿石吧。"
		""
		"不过，请注意不要放入无法处理的物品，否则它很可能会将其销毁。"
		"&n"
		""
		"建造此结构的指南可在工程师手册中找到。"
		""
		"或者，查看来自 Create 的 Schematic Table 或 \",{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://blockprints.io/user/MuteTiefling\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"BlockPrints\",\"underlined\":true},\" 以获取更好的建造指南。\"]"
		""
		"&a🛈 提示：工程师手册高亮显示"
		"&a    在&c红色&r&a中的形成方块。"
	]
	quest.1824109EF4F096A1.quest_desc: [
		"此阶段电力需求将迅速增加。提前设置一些额外的锅炉会省去你后续的麻烦。"
		""
		"当然，传输所有这些额外电力，需要比MV电缆更好的东西。"
		""
		"转换为HV能让您在主干线上输送更多电力，然后可以在一个独立的机器集群处将其转换回MV。"
		""
		"可以考虑多种类似这样的设置："
		""
		"&e高级锅炉"
		"&e╰┈➤ &3MV涡轮集群"
		"&3╰┈➤ &aMV to HV Transformer"
		"&a╰┈➤ &b铝制电缆"
		"&b╰┈➤ &a高压至中压变压器"
		"&a╰┈➤ &3机器集群"
		""
		"&6⚠ 注意：保留你的MV子网络"
		"&6    分开放置，这样它们就不会被限制了"
		"&6    最大传输速率。"
	]
	quest.1957E93789E69D3E.title: "Uphyxes 倒置塔"
	quest.195BD5456B6E674D.quest_desc: [
		"Iron’s Spellbooks 为游戏世界添加了数个结构，无疑会非常实用。"
		""
		"不过，要找到它们可能有些困难。幸运的是，有工具可以帮忙。"
		""
		"最重要的或许是&7地下墓穴&r，亡灵的居所，可用罗盘定位。此地极其危险，切勿贸然前往。"
		""
		"除此之外，定位结构之碑可用于定位下界的&7远古战场&r，以及以下主世界的结构："
		"• &7山塔&r"
		"• &7红树林小屋&r"
		"• &7火魔法师塔&r"
		"• &7Evoker 堡垒&r"
		"• &7牧师小屋&r"
		"• &7被刺穿的破冰者&r"
		""
		"最后，&7试炼密室&r也能提供许多有用的物品，非常适合用来囤货，因为试炼可以重复进行！"
	]
	quest.195BD5456B6E674D.title: "实用建筑"
	quest.1A0A7309D9B2F4FF.quest_desc: [
		"采矿已经厌倦了？不用再找了。"
		""
		"现代工业化的设计理念是尽量减少人工劳动，包括采矿。有时需要手动操作才能推进，但请放心，自动化方法很快就会跟上。"
		""
		"有了蒸汽采石场，铁、铜、锡、煤炭等基本材料就可以自动收集了。操作结果取决于安装的钻头，目前只有铜和青铜钻头可用。"
		""
		"钻头会随时间损坏，所以建立生产线会很重要。"
		""
		"&a🛈 提示：先放置控制器方块，然后"
		"&a    手持扳手或撬棍即可查看"
		"&a    结构或有效位置用于"
		"&a    孵化口。"
		""
		"&c⚠ 警告：如果以下情况发生，产出将被作废"
		"&c    孵化槽数量不足"
		"&c    可以接收物品了！"
	]
	quest.1A1C34B6C1A7B5E8.quest_desc: ["充电器和放电器相辅相成，充电器用于为电池等兼容FE的物品充电，而放电器则用于消耗它们的电力。"]
	quest.1A4123560ACEE02C.quest_desc: [
		"终于有时间了！"
		""
		"随身携带瓶中时光，储存下你用来做其他事情的时间。当你对机器的运行感到不耐烦时，只需右键点击它几次，用瓶子消耗一些时间来加速它。"
		""
		"&a🛈 提示：你只能拥有一个"
		"&a    瓶中时光，一次一瓶。"
	]
	quest.1A650F4235F6204A.quest_desc: [
		"又到了升级的时间了！"
		""
		"和往常一样，更换等级时最好先回顾一下你的机器。升级到LV电力等级会加快许多进程，也可能启用低等级机器完全无法处理的配方。"
		""
		"由于锡缆可以和流体管道占据同一空间，所以这个升级过程应该不会太难。只需沿着蒸汽流体管道铺设一些锡缆，一旦能制作机器，就可以开始替换了。"
		""
		"&a🛈 提示：潜行状态下右键点击管道或电缆"
		"&a    对抗机器以轻松创建物品"
		"&a    一个连接。"
	]
	quest.1A650F4235F6204A.title: "升级电力装置"
	quest.1AB4455F15DF1F84.quest_desc: [
		"自然祭坛很可能是你第一个会使用的消耗奥拉的装置。"
		""
		"《自然光环之书》更详细地描述了这种神秘的力量。不过，简单来说，可以把它想象成氧气和二氧化碳。呼吸时，你消耗氧气并呼出二氧化碳。如果氧气得不到补充，呼吸次数过多就会导致死亡。"
		""
		"光环就是你的氧气。"
		""
		"有灵气发生器可以补充，但它是一种需要维护的有限资源。不过，如果使用过度，可怕的事情就会开始发生。"
		""
		"幸运的是，如果灵气过低，这个自然祭坛会停止工作。但其他装置可能会将其完全耗尽。"
		""
		"&n                                                              &r"
		""
		"该装置需要多方块结构才能正常工作。"
		""
		"请参阅自然光环之书，查看方块放置的预览。"
	]
	quest.1AD06ADB17D92C6E.quest_desc: [
		"不想睡过整个夜晚？或者你更希望有一个更长的夜晚来狩猎怪物？"
		""
		"无论哪种情况，Shifting Sundial 都是你的理想设备。将 Hand of Time 放入 Item Frame 并旋转它，即可设置要跳转到的时间。"
		"向上指向代表午夜，向下指向代表正午。"
		""
		"要激活它，只需在旁边放下一个时钟即可。"
	]
	quest.1BAEB780F38B1C56.quest_desc: [
		"将接入点连接到您的网络，然后在其中放置无线终端以将它们链接起来，从而获得对整个网络的无线访问权限。"
		""
		"更远的射程会消耗更多能量！"
	]
	quest.1C83B47F599B117A.quest_desc: [
		"到目前为止，我们已经初步了解了灵魂魔法。要更深入地研究，我们需要直视虚空本身。"
		"&n"
		""
		"在地下深处找到一个哭泣之井，将你的《神秘百科全书》投入其中以获得所需的知识。"
		""
		"当然，说起来容易做起来难，但你可以使用 Wayfinder 来帮助你找到这个结构。"
		""
		"将百科全书转换后，你会发现其中新增了一个章节：&d虚空编年史&r"
	]
	quest.1C87FB78BA245285.title: "海德里恩的诱饵"
	quest.1CEDA28FD4CB759E.quest_desc: [
		"Transfer Labels 可在方块间传递，无需管道即可实现方块间的传输。"
		""
		"潜行+右键可将标签安装在方块侧面。安装后，可通过右键点击另一个标签或使用标签访问器来配置标签。"
		""
		"在配置界面中，您可以添加更多标签来控制传输的数量和速度，以及设置过滤器。"
		""
		"可以用另一个标签或标签访问器左键点击来移除标签。"
	]
	quest.1CF0D1E63C34AE6E.quest_desc: [
		"灵魂催化剂有助于加快灵魂熔炉的速度。只需将其放置在附近，并用你选择的熔炉燃料填满即可。"
		""
		"以这种方式加快熔炉的速度，也会使动力受损更快，但这种权衡是值得的。"
	]
	quest.1D2BB7149630A9E2.quest_desc: [
		"勘探工具用于定位矿物矿床，这是一种特殊资源节点，能让你用挖掘机提取大量不同材料。"
		""
		"矿物矿床大致呈圆形区域生成，可能宽达数个区块，甚至可能相互重叠。"
		""
		"该区域的资源可在任何地方开采，但中心区域最为密集。因此，找到中心并在那里建造挖掘机，以实现更快的开采是值得的。"
		"&n"
		""
		"使用勘测工具开始搜寻。使用时，将其握在手中并指向草或石头等方块。按住右键直到动画结束。如果附近有矿物沉积，屏幕底部会显示通知。"
		""
		"一旦靠近中心几格，使用核心样本钻可以精确定位饱和度为100%的地点。"
		""
		"这里就是你需要设置挖掘机的地方了。"
	]
	quest.1D3ECD980E15451B.quest_desc: [
		"兼具有限存储功能的燃气管道，每个方块空间都会缓冲气体。网络中管道越多，每刻能传输的气体就越多。"
		""
		"更多信息请参阅其维基中的\",{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://wiki.aidancbrady.com/wiki/Pressurized_Tube\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"Pressurized Tube\",\"underlined\":true},\"文章。\"]"
	]
	quest.1D4634BB3AF725EC.quest_desc: ["一种用于处理矿石和其他材料的多功能破碎机。用它来生产生物燃料，是利用农作物获取能源的好方法。"]
	quest.1D5616DFA428D46F.quest_desc: [
		"建筑小工具提供多种FE供电工具，可用于辅助建筑，包括放置方块、替换方块、复制粘贴，甚至可以直接删除大片区域。"
		""
		"如果你想建造一个巨大的基地，Building Gadgets 很可能有工具可以帮忙。"
		""
		"&a🛈 提示：在 EMI 中搜索 &3@buildinggadgets&r &a"
		"&a    去发现更多秘密。"
	]
	quest.1D5616DFA428D46F.title: "建筑小工具"
	quest.1D5E773A3A547A2C.quest_desc: [
		"如果你喜欢田园风，或者只是想装点架子，Handcrafted 是你的不二之选。里面堆满了舒适的椅子和室内装饰品。"
		""
		"&a🛈 提示：在 EMI 中搜索 &3@handcrafted&r &a以查找"
		"&a    探索更多未知。"
	]
	quest.1D5E773A3A547A2C.title: "手工制作的物品需要特定的配方和材料才能合成。"
	quest.1DA29F3B45DEFB4B.quest_desc: [
		"魔法师的职业总是很孤独。大家总问“你会什么？”，却从不问“你过得怎么样？”。"
		""
		"虽然让炮台为你施放法术很有用，但它们冰冷……毫无生气。"
		""
		"但如果能自己创造朋友呢？可爱、讨人喜欢、能拥抱的朋友，仅仅是存在就能带来欢乐？"
	]
	quest.1DA29F3B45DEFB4B.title: "魔法的朋友们"
	quest.1E0B03155C2CAEE7.quest_desc: [
		"精神凝聚是一种炼金术，将催化剂物品（或称引子）注入精神以生成新材料。"
		"&n"
		""
		"首先，制作一个炼金催化剂并将其放入坩埚。根据与催化剂一同放入的灵体，你将开始生成新材料：如红石对应的奥术、萤石对应的地狱等。"
		""
		"在此过程中，Impetus 会受到损坏并最终破裂，但可以通过修复来使此过程无限期地持续下去。"
	]
	quest.1E0B03155C2CAEE7.title: "精神集中 (Spirit Focusing)"
	quest.1E2327FB6801D209.quest_desc: [
		"早期，电解分离器和加压反应室可用于生产乙烯。这个过程设置起来相当简单，并且能从生物燃料中产生比直接燃烧多得多的能量。"
		""
		"之后，这两种机器都将在更先进的流程中得到应用，包括更先进的矿石处理和核能！"
	]
	quest.1E2327FB6801D209.title: "埃索斯大陆"
	quest.1E2BA13C53664E50.quest_desc: [
		"改革阵列是神学资源复制的基础。"
		""
		"从外部来看，这个过程相当简单明了。"
		"  "
		"1. 获取你想要的颜色的硫磺（Sulfur）"
		"用作钥匙的材料。"
		"此物品不会被消耗掉。"
		"2. 获得一个合适的硫磺（Sulfur of）"
		"另一种可以转变成它的材料是"
		"所需材料。"
		"3. 将所有材料混合在"
		"改革阵列！Reformation Array!"
		""
		"不过最后一步很重要，所以让我们更详细地了解一下整个过程。"
		"&n                                                  &r"
		""
		"目前，使用液化配方来获得石英硫磺和一些青金石硫磺。"
		""
		"我们将以 1:1 的比例将青金石转换为石英。"
	]
	quest.1E2BA13C53664E50.title: "宗教改革"
	quest.1E78584388808899.quest_desc: [
		"终于有一个多区块结构可以取代你一直在用的那些单个涡轮机了。"
		""
		"大型蒸汽涡轮机目前会有一定限制，因为我们能做的最好的只是一个高压能源舱，但随着你的基地发展，它也能随之成长。"
	]
	quest.1E8C6CE5E863EC0F.quest_desc: [
		""
		"没有咒语的咒语书，还能称之为咒语书吗？"
		""
		"你会发现你得到的这本书目前是空的。让我们来改变这一点！"
		"&n                                                  &r"
		""
		"制作一个铭文台，并从任务奖励中选择一个法术作为起点。"
		""
		"要将卷轴放入书中，请将两者都放在铭文桌上，然后点击小书记员按钮。卷轴就会出现在中间的窗口中。"
		""
		"在铭文表中选中法术，然后点击右下角生成的卷轴，即可随时取回卷轴。"
		""
		"&c⚠ 警告：右键点击卷轴"
		"&c    将永远消耗地进行施放。"
	]
	quest.1EBAABF6E93CFCDF.quest_desc: [
		"在UV Light Box中正确准备后，需要在etching tank中蚀刻Empty PCBs。"
		""
		"你还需要在储罐中加入一些蚀刻酸。通常这不会消耗，但如果对储罐加热，会加快进程并缓慢消耗酸。"
	]
	quest.1ED9BF551B4E2420.title: "马里德破碎机"
	quest.1F228F2C10A89232.title: "海德里恩的诱饵"
	quest.1FC45862126DC511.quest_desc: ["将铁匠卷轴添加到女巫中，或以其他方式使研究碎片在从 Ars 和 Iron's 处获取法术时有用"]
	quest.1FC58B7D325A1AC7.quest_desc: ["在蜂巢迷宫的深处，你会发现一个特殊的蜂蜜罗盘，它能指引你前往王座之柱。拿起它并跟随罗盘，它将直接带你找到蜂后本人！"]
	quest.1FC58B7D325A1AC7.title: "寻找女王 (Finding the Queen)"
	quest.1FDA97FE562A2C4D.quest_desc: [
		"大多数机器都可以安装附加组件，以加快速度并提高运行效率。"
		""
		"不要错过这个机会！"
	]
	quest.20454EB2C6E93573.quest_desc: [
		"Player Accessor 能让任何物流系统像对待箱子一样与你的物品栏互动。"
		""
		"这可用于自动储备大型项目的建筑材料，或在采矿时自动提取鹅卵石和其他材料等。"
		""
		"可能性简直无穷无尽！"
	]
	quest.204FC8B3C340DF4F.quest_desc: ["将 Iesnium Ritual Bowl 安装在你的 Pentacles 中，仪式将加速进行。请务必尽快升级它们！"]
	quest.205B821B10C6AC75.quest_desc: [
		"强制转换器用于将FE或EU转换为Modular Forcefields使用的能量——福尔顿。"
		""
		"因此，要启动它，你需要为其提供电力。转换过程很慢，但可以通过向机器投入青金石来加速。安装速度模块也会有所帮助。"
		""
		"你还需要选择一个频率，用于无线连接所有 MFFS 机器。处于相同频率和范围内的机器将自动连接并共享电力。"
		""
		"&6⚠ 注意：MFFS机器已关闭，原因是"
		"&6    默认。要么提供一个红石"
		"&6    信号或点击火把按钮在"
		"&6    界面。"
	]
	quest.20877ECE7619845D.quest_desc: [
		"完全转换为MV可能比从Steam转换为LV要长一些。"
		""
		"不过，最好先建造电力基础设施。可以考虑建造一些中压涡轮机，并用变压器将电力从中压降至低压。"
		"&n                                                  &r"
		""
		"随着你扩展MV电网，现有的LV机器可以轻松升级为使用MV供电。"
		""
		"高级机械外壳可以右键点击机器进行升级，或者打开机器GUI并在插槽中安装。"
		""
		"&6⚠ 注意：机器在以下情况下根本无法运行"
		"&6    使用了错误的等级能量。"
	]
	quest.2098F9F6E49956A5.quest_desc: [
		"在煅烧步骤中，相关材料会被提炼成炼金盐。"
		""
		"为了净化矿石，我们需要矿物类型的炼金盐。这可以通过多种材料获得。"
		"&n                                                  &r"
		""
		"将煅烧炉放置在火焰祭坛上。物品可右键放入熔炉，或通过任何物品物流系统送入。"
		""
		"Pyromantic Brazier 主要燃烧熔炉燃料，提供方式也相同。"
	]
	quest.20A3EA274A706343.quest_desc: ["一款能燃烧多种燃料的简易液体燃料燃烧发电机！手头有什么就用什么吧！"]
	quest.20C038E5D70CDB52.quest_desc: [
		"Wixie 大锅允许 Wixie 使用源材料来酿造药水或使用 3x3 配方进行合成。"
		""
		"她会从连接的储物箱中自动取用物品进行合成，将物品放置在相邻的 Arcane Pedestal 上即可指示她合成内容。"
	]
	quest.20C038E5D70CDB52.title: "Wixie 炼药锅"
	quest.20EBCCCAA99AC19A.quest_desc: [
		"花园钟罩可用于自动化某些作物（如大麻）的生长，这些作物在模组中广泛使用。"
		""
		"可以考虑用多余的矿渣或骨粉施肥来加速生长，直到能制作出更好的肥料为止。"
	]
	quest.212EB5AFECD2A6E8.quest_desc: [
		"工业始于锻造；强健的体魄与敏锐的头脑同等重要。"
		""
		"首先制作锻造锤。该工具与切石机类似，可手动重塑材料，例如将锭制成板。它也可用于初步矿石加工，将原矿和矿石转化为粉尘。"
		""
		"使用锻造锤工具，例如钢锤，也可以让这个过程更高效！"
	]
	quest.213B163D0ED28802.quest_desc: ["奇可宝哨子可用于命令奇可宝“待命”、“跟随”或“漫游”。只需在驯服的奇可宝上右键点击，即可在三种选项间切换。"]
	quest.2150EE8D0B1474CE.quest_desc: [
		"物流部分涵盖了用于自动化物品移动的模组物品。"
		""
		"从物品和流体到能量和气体，这里展示的模组都能帮你实现传输。"
	]
	quest.2150EE8D0B1474CE.title: "物流系统"
	quest.21A7F863BCFB2177.quest_desc: [
		"量子盔甲是一套强大的盔甲，可集成到您的AE系统中，提供从系统中自动喂食和自动请求所选方块配方等便利功能。"
		""
		"当然，好处不止于此，穿上这套装你几乎不死，能跳得更高、跑得更快、游得更久，甚至装上合适的升级件还能飞行。"
	]
	quest.21A7F863BCFB2177.title: "量子盔甲"
	quest.21C1CAA38D040AC8.quest_desc: [
		"Functional Storage 是一种可扩展的存储解决方案，可以容纳你所有的物品和液体。"
		""
		"每个抽屉可以存放一到四种物品，但容量大得惊人。"
		""
		"抽屉也可以连接到抽屉控制器，将所有抽屉链接到一个网络中。这样，物品管道和其他物流系统就可以连接到控制器，并访问所有已连接的抽屉。"
		""
		"无法手动访问 Storage Controller，所以你最好搭配其他能访问物品的模组。Ad Hoc AE2 网络、Pretty Pipes 或 Ars nouveau Storage Lectern 都是绝佳选择。"
	]
	quest.21C1CAA38D040AC8.title: "功能性抽屉模组 (Functional Drawers)"
	quest.21FA8A625A79BE61.quest_desc: ["用于将流体从一个地方输送到另一个地方的简易流体管道。"]
	quest.223BE2F1F8A5C87C.quest_desc: [
		"复制终端用于向存储于记忆芯片上的模式请求合成。"
		""
		"它还能让你概览网络上存储的每种物质的总量，并管理任何正在进行中的请求。"
	]
	quest.225A626E79D7165F.quest_desc: ["能量漏斗能将任何物品栏变成快速充电站。它们会为指向的物品栏中存放的任何基于FE的设备充电。"]
	quest.2285070A43A12190.quest_desc: [
		"将卷轴放入法术书后，你几乎就可以开始施法了。你还需要将法术书装备在相应的奇物栏中。"
		""
		"[\"现在装备了魔法书，你可以按下 (\",{\"color\":\"gold\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"施放所选法术键\"}]},\"keybind\":\"key.irons_spellbooks.spellbook_cast\"},\") 来施放所选的法术。\"]"
		""
		"找到更多卷轴后，按 (\",{\"color\":\"gold\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"打开法术轮盘键\"}]},\"keybind\":\"key.irons_spellbooks.spell_wheel\"},\") 打开法术轮盘，再按 (\",{\"color\":\"gold\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"法术栏卷轴修饰键\"}]},\"keybind\":\"key.irons_spellbooks.spell_bar_modifier\"},\") 并用鼠标滚轮选择。\"]"
		""
		"选中法术也可以通过手持法杖右键快速施放。快来试试吧！"
	]
	quest.2285070A43A12190.title: "咒语施放：101"
	quest.22ABFC3024E54FEA.quest_desc: [
		"Mercurial Item 运输系统是一个简单的物流网络，用于移动物品。"
		""
		"放置器与提取器可以放置在机器或其他物品栏旁，然后用水星铜线连接起来。"
		""
		"水银连接节点允许多条导线汇聚成更广泛的网络，并延长单根导线的覆盖范围。"
	]
	quest.22ABFC3024E54FEA.title: "水银物品节点"
	quest.22FBFA5E2F891021.quest_desc: [
		"想从树木中获得更多价值吗？试试用 Sawmill 把它们切成木板，提高产量吧！"
		"&n"
		""
		"建造此结构的指南可在工程师手册中找到。"
		""
		"或者，查看来自 Create 的 Schematic Table 或 \",{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://blockprints.io/user/MuteTiefling\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"BlockPrints\",\"underlined\":true},\" 以获取更好的建造指南。\"]"
		""
		"&a🛈 Tip: The Engineer’s Manual highlights "
		"&a    在&c红色&r&a中的形成方块。"
	]
	quest.235AA993029F7277.quest_desc: [
		"橡胶是电子元件的重要绝缘材料，下一步就是制作这些元件，所以现在正是设置橡胶生产线的好时机。"
		""
		"这又是另一种会大量使用的材料，因此设置专门的产线会是个不错的选择。特别是，建议使用新的蒸汽高炉来制造合成油。"
	]
	quest.235D7EF41916E480.quest_desc: ["以下是 Enigmatica 10 中可用的各种能量传输方式。"]
	quest.235D7EF41916E480.title: "力量"
	quest.23703A535469A7F3.quest_desc: [
		"欢迎来到 Ender IO。"
		""
		"此模组尚处于早期阿尔法阶段，内容变化很快！"
		""
		"任务系统目前也还在开发完善中。"
	]
	quest.23703A535469A7F3.title: "Ender IO"
	quest.23BC0F0C51F64721.quest_desc: [
		"最初，冶金熔炼器用于制作重要组件，如基础控制电路、熔炼合金和钢粉。"
		""
		"同一台机器将用于制造更多分级的材料，用于升级现有机器或解锁更高级的机器。例如，用Infused Alloy，我们就能制造出更好的发电机。"
		""
		"&a🛈 提示：通常最简单的办法是专门分配一个"
		"&a    将材料放入融合器中进行融合。"
	]
	quest.23C86F86A1A4B1E9.quest_desc: [
		"巨型血箱是血箱的改进版。它不仅默认运行速度更快，还可以接受承诺作为升级。"
		""
		"要建造巨型血箱多方块结构，你需要用加固不死木板搭建一个3x3x3的空心立方体，并在任意一面墙上安装巨型血箱。"
	]
	quest.23DDFBC0DB19F6A4.quest_desc: [
		"当放置在任意使用方块的灵气下方时，灵气失衡护符将防止该装置将灵气消耗至危险区域。"
		""
		"建议尽快在大多数使用光环的设备下方放置一个。其中一些消耗光环的速度惊人！"
	]
	quest.23FF0CA316B2CB5D.quest_desc: [
		"大型储罐是一个现代工业化多方块结构，能够储存大量流体。"
		""
		"&a🛈 提示：先放置控制器方块，然后"
		"&a    手持扳手或撬棍即可查看"
		"&a    结构或有效位置"
		"&a    用于活板门。"
	]
	quest.247C63F94533E40D.title: "Djinni Crusher"
	quest.24A4BA42A83A20D0.quest_desc: [
		"制作好最初几块暗钢锭后，合金熔炉似乎是合乎逻辑的下一步。"
		""
		"不过，要继续下去，你需要一些能量才行。"
		""
		"Ender IO 和其他许多科技模组一样使用 FE，但它被重新命名为 Micro Infinity 或 µI。它们可以完全互换使用。"
		""
		"Ender IO 的选项可以考虑制作斯特林发电机，它使用煤炭运行。"
		""
		"威力不算太强，但现在足以完成工作了。"
		""
		"&6⚠ 注意：机器需要电容器 Capacitor"
		"&6    储存能量并运行。"
	]
	quest.24C8B386C675F3E1.quest_desc: [
		"建造工厂并非易事，需要极其庞大的材料数量。"
		""
		"有好工具，工作就轻松多了！"
		"&n"
		""
		"蒸汽采矿钻是一种不可破坏、用煤炭驱动、3x3、带丝绸之触的采矿机。"
		""
		"燃料（如煤炭或褐煤）可通过拾起燃料并在钻机上右键来添加。它还需要水，可通过将钻机右键至流动的水中注水。"
		""
		"考虑用最初的那几颗钻石买这个钻头，让生活更简单！"
		""
		"&a🛈 提示：钻头永远不会干涸，只要有一个"
		"&a    你的物品栏里有水桶！"
	]
	quest.25770E9DCA5B4B1F.quest_desc: [
		"欢迎来到 Actually Additions 模组！"
		""
		"本模组集合了各种实用功能，旨在简化生活，提供自动化农场机器、新的药水酿造机制、采矿工具等。"
	]
	quest.25770E9DCA5B4B1F.title: "实际上附加的模组 (Actually Additions)"
	quest.25B779319401405B.quest_desc: [
		"欢迎来到 Malum，这是一款围绕操控灵魂以施展强大仪式的魔法模组。"
		""
		"本任务部分涵盖模组的基础用法。如需更深入的说明，请参阅《神秘百科全书》。"
	]
	quest.25B779319401405B.title: "Malum"
	quest.25D327DB56E51DA5.quest_desc: [
		"作为能源生产的巅峰，聚变反应堆利用氘和氚产生惊人的电力。部分电力可直接从反应堆获取，但更多电力可通过利用反应堆为涡轮机产生蒸汽来获得。"
		"&n                                                 &r"
		""
		"聚变反应堆本身是一个巨大的自由形态多方块结构。"
		""
		"【放置规则和最大尺寸限制，请访问他们的维基页面了解更多信息：】{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://wiki.aidancbrady.com/wiki/Fusion_Reactor\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"Fusion Reactor\",\"underlined\":true}]"
		""
		"&a🛈 提示：E10 包含一个 Mekanism 多用途"
		"&a    EMI 中的区块规划器！"
	]
	quest.25D327DB56E51DA5.title: "聚变反应堆"
	quest.26027E2E7418D35C.quest_desc: [
		"Nature’s Aura 引入了多种效果粉末，其中丰饶核心粉末或许是最强大的之一。"
		""
		"放置后，区域内所有石头或下界岩将缓慢转化为随机矿石，消耗气场。"
		""
		"这需要极高的灵气才能开始运作，并且有持续消耗。你至少需要一个创世催化剂，很可能还需要一个强大的灵气发生器，比如射击标记，来支付运营成本。"
	]
	quest.26115C1BB363EF58.quest_desc: [
		"这些材料可以通过用灵魂碎裂武器杀死相应的生物来获得："
		""
		"• 微风 - 风之核心"
		"• 末影人 - 扭曲流"
		"• 骷髅 - 阴森滑石粉"
		"• 幻影 - 星界编织"
		"• 僵尸 - 腐化精华"
	]
	quest.264783EF292A494B.quest_desc: [
		"简易点击器可以自动化多种交互，例如剪羊毛或杀死经过它面前的生物。"
		""
		"需要工具，所以别忘了带上用于羊场的剪刀，或是用于击杀怪物的锋利剑。"
	]
	quest.267FEB0BB5D9B4D9.quest_desc: [
		"装配台是一种能进行更高级合成的多方块机器。"
		""
		"特别是，它可以简化制作更多PCB的过程，完全跳过UV和蚀刻步骤。"
		""
		"每个部件都有有效放置的要求，具体规则请参阅 PNC:R 手册。"
		""
		"可以在 2x3 的空间内设置一个简单的布局，不过："
		"&a    IO单元   控制器     IO单元"
		"&a    钻头      平台        激光"
		""
		"&6⚠ 注意：钻头与激光程序"
		"&6    允许装配台进行合成"
		"&6    使用钻头或任何其他工具的配方"
		"&6激光，或两者兼有。"
	]
	quest.267FEB0BB5D9B4D9.title: "装配台"
	quest.26B8DEFFA75B3944.quest_desc: [
		"鉴定室用于扫描并将模式存储到内存芯片中。此过程具有破坏性，因此你的输入物品将被丢失。但这没关系，对吧？很快你就能拥有想要的所有物品。"
		""
		"每个记忆芯片最多可存储16种不同模式，安装到芯片存储后，即可在终端中请求这些物品。"
		""
		"&a🛈 提示：物品可以被管道输送到"
		"&a    通过身份识别室前往"
		"&a    底部。"
	]
	quest.27B747DE574CF261.quest_desc: [
		"Immersive Engineering 使用的第二大重要资源当然是钢。IE 广泛使用钢，它几乎出现在所有机器中。鉴于这种材料的重要性，你最好尽快开始冶炼。"
		"&n"
		""
		"这个结构非常简单，由一个 3x3x3 的爆破砖立方体组成。"
		""
		"IE 的多重方块总是通过右键点击结构方块并使用工程师之锤来建造的。"
		""
		"此时，右键点击结构任意一侧的中心方块即可。"
		""
		"&a🛈 提示：工程师手册高亮显示"
		"&a    在&c红色&r&a中的形成方块。"
	]
	quest.2850FCAFEEF5004C.quest_desc: [
		"某些特性，如效率，可以通过名为突变的过程进行升级。"
		""
		"此过程的结果并无保证，但或许能提高你的成功率。"
		""
		"首先，制作一些突变药水和一个高级孵化器。然后从提供基础特性的生物身上获取细胞样本。在本例中，是银鱼。"
		""
		"用突变药水酿造细胞样本，以获得将该生物设为实体的突变药水。"
	]
	quest.289433DE16324150.quest_desc: [
		"氯化铵是一种强大的炼金溶剂。它可以在地下以结晶形式找到，或者直接从水中提取。"
		"&n                                                  &r"
		""
		"将硝石铵蓄能器放置在储罐顶部。"
		""
		"水可以右键点击或管道输送到蓄积器中，生成的氯化铵也可以从储罐中类似地提取出来。"
		""
		"&a🛈 提示：向其中添加硝石晶体以"
		"&a    蓄能器将极大地"
		"&a    加快一点速度。"
	]
	quest.289A1CE4C4092687.quest_desc: [
		"接口本质上是一个集成的导入/导出总线。"
		""
		"例如，一个接口可用于为发电机储存煤炭，而附近的自动化小麦农场则可通过同一接口将所有小麦送回来。"
		""
		"它们的结合特性意味着单个频道就能完成更多事情。"
		""
		"&a🛈 提示：电缆组件无法被"
		"&a    放置在密集电缆上。"
	]
	quest.289DEC367A80D718.quest_desc: [
		"高级机器的工作方式与简易机器类似，但增加了一些新功能。"
		""
		"首先，它们都需要消耗能量才能运行。"
		""
		"它们还内置了强大的过滤系统，因此不再需要外部传感器来控制。"
		""
		"最后，它们可以在更大的区域内运作。"
		""
		"&a🛈 提示：使用渲染区域按钮来"
		"&a    轻松配置工作区域。"
	]
	quest.28EAC6C33A575A42.quest_desc: [
		"转换是将一种物品转化为另一种物品的过程。在之前的章节中，我们使用常见的宝石青金石来制造另一种常见宝石石英。"
		""
		"但是，如果你想把那些宝石变成金属，该怎么办呢？"
		""
		"这就是Transmutation派上用场的地方。让我们来看看它的工作原理。"
		"&n                                                  &r"
		""
		"为此，我们将把石英硫磺转化为铁硫磺。使用液化配方收集每种材料各几个。"
	]
	quest.28EAC6C33A575A42.title: "物质转化（Transmutation）"
	quest.28F4519591D71F80.quest_desc: [
		"物品激光中继器与物品接口配对，可将多个小型物品栏整合成一个更大的存储网络。"
		""
		"将激光中继器放置在一排箱子旁，另一个放在物品接口旁。用激光扳手将它们全部连接起来，这样推入接口的物品就会被存储在箱子里。"
		""
		"同样，物品可以从接口中拉出，这意味着它可以很好地与AE2或Ars Nouveau Storage Lectern搭配使用。"
	]
	quest.2961B707783AC925.quest_desc: [
		"在制作这个之前，你需要先击败末影龙，除非你能找到另一个龙息来源。"
		""
		"本阶的煤炭需要用前一阶的煤炭块获得，而 Celestigems 则由钻石块转化而来。"
		""
		"&a🛈 提示：更高等级的Goos可以制作所有低等级Goos的配方。"
		""
		"&6⚠ 注意：Goo 很饿，需要被喂食"
		"&6    开始工作！"
		""
		"&6    右键点击物品以激活它。"
		"&6    要找出哪些物品有效，请搜索"
		"&3    #goo_revive_tier_3&r&6 在EMI中！"
	]
	quest.296C31D4425DE534.quest_desc: [
		"花形头饰也能防止蜂巢之怒，让你能更安全地穿越蜂巢迷宫。"
		""
		"染上颜色，展示你的独特风格！"
	]
	quest.29D1FB4380460203.quest_desc: [
		"顾名思义，PneumaticCraft 拥有自己的电力系统，模仿现实世界的气动学，即空气动力。制造空气需要某种压缩机。"
		""
		"刚开始，你应该先制作一个空气压缩机，因为它便宜，而且能用普通熔炉的燃料。"
		"&n                                                  &r"
		""
		"机器和管道在压力过大时会爆炸！请在压缩机快满时将其关闭以避免这种情况。"
		""
		"[\"请参阅我们的维基上关于 \",{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://wiki.enigmatica.net/enigmatica6/gameplay/how-to.../pneumaticcraft-safe-compressor-usage#compressing-air-and-basic-control\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"安全压缩机使用法\",\"underlined\":true},\" 的文章以了解更多信息。\"]"
	]
	quest.2A1AD751A9C6BF2B.quest_desc: [
		"这些材料在配方中经常需要，但有时却很难弄到手。"
		""
		"幸好我们在另一边有朋友帮忙。"
		""
		"&6⚠ 注意：这些仪式通常需要"
		"&6    献祭。触发仪式，如"
		"&6    如常，然后杀死指定的生物"
		"&6    五芒星附近。"
	]
	quest.2A1AD751A9C6BF2B.title: "稀有材料"
	quest.2A2D51206676A83C.quest_desc: [
		"我们看到你在那里，正看着那个蜂巢，好奇里面到底发生了什么。"
		""
		"快去吧，偷偷看一眼。我们不会告诉别人的！"
		"&n                                                 &r"
		""
		"向蜂巢或巢穴投掷末影珍珠，或用活塞将头推入方块，即可进入Bumblezone。"
		""
		"【蜂群区没有游戏内手册，但它有非常实用且信息丰富的成就（\",{\"color\":\"gold\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"成就键\"}]},\"keybind\":\"key.advancements\"},）来引导你完成模组的各个方面。】"
		""
		"别忘了查看他们的在线 \",{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://github.com/TelepathicGrunt/Bumblezone/wiki\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"Wiki\",\"underlined\":true},\"，这是一个绝佳的知识来源。\"]"
		""
		"&a🛈 提示：你可以离开 Bumblezone 的方式是"
		"&a    随时可以通过打破以下方块进入"
		"&a    维度空间的屋顶或地板。"
	]
	quest.2A2D51206676A83C.title: "嗡嗡虫地带"
	quest.2A7455D9EE649BA4.quest_desc: [
		"图腾魔法能让勇敢的巫师在特定区域创造效果，并能产生一些相当独特的效果。"
		""
		"例如，汲取仪式能让滴水石锥更快生成，而海洋仪式则能增强在该区域内钓鱼的能力。"
		"&n"
		""
		"设置图腾是一项简单的任务。只需放置一个符文木图腾底座，然后在上面按列放置若干符文木原木。所需原木的数量取决于具体的仪式。"
		""
		"编码符文需要用相应的灵魂右键点击原木。"
		""
		"汲取仪式需要四根原木。从上到下，用&9Aqueous&r、&9Aqueous&r、&dArcane&r和&5Eldritch&r右键点击每根原木。"
		""
		"最后，右键单击基地以激活仪式。"
		""
		"这些仪式一旦激活，便无需维护或保养。"
		""
		"在《神秘学百科全书》中查看每个仪式的详细描述和编码所需的符文列表。"
		""
		"设置 Wicked Rites 是获得更多 Spirits 的绝佳方法。"
		""
		"&a🛈 提示：图腾杖会显示图腾的"
		"&a    手持时的工作区域。"
	]
	quest.2A7455D9EE649BA4.title: "图腾魔法"
	quest.2A83BC699BE18F3A.quest_desc: [
		"欢迎来到现代工业化！Welcome to Modern Industrialization!"
		""
		"在本章中，我们将探索这个庞大科技模组的奥秘。从一个经营蒸汽锅炉的普通矿工，到能随意转化能量与物质的核科学家。"
	]
	quest.2A83BC699BE18F3A.title: "现代工业化"
	quest.2AA352D00D86DCC3.quest_desc: [
		"使用空中接口，你可以远程访问自己的物品栏。"
		""
		"可用于为气动设备充能、自动存储或提取物品，甚至可以自动为你喂食和管理经验值。一切皆有可能！"
	]
	quest.2ADF5DBA3B09712B.title: "奥索林的无拘束召唤"
	quest.2AF1CE73E140D685.quest_desc: [
		"虽然Certus Quartz只在陨石中自然生成，但一旦获得，它就相当容易量产。"
		""
		"给一些 Certus Quartz 充能，然后用它来制作一个有瑕疵的 Budding Certus Quartz 方块。"
		""
		"将方块放置在世界中，等待花蕾生长。当它们从花蕾变为簇时，就可以采集了。使用时运附魔可以获得更多产出！"
		""
		"这个过程一开始会很慢，你肯定希望它能自动化。"
		""
		"&a🛈 提示：AE指南书中有一个关于...的绝佳章节"
		"&a    自动化 Certus Quartz："
		"&a     ╰┈➤ &3示例配置 > 简易 Certus 农场"
		""
		"&6⚠ 注意：Budding Certus 方块会随时间降解，并且"
		"&6    除非你成功移动一个物品，否则必须修复"
		"&6    无瑕的 Budding Certus Quartz。"
	]
	quest.2AF1CE73E140D685.title: "种植 Certus 作物"
	quest.2B0DDF8003305DB6.quest_desc: [
		"Transfer Labels 可在方块间传递，无需管道即可实现方块间的传输。"
		""
		"潜行+右键可将标签安装在方块侧面。安装后，可通过右键点击另一个标签或使用标签访问器来配置标签。"
		""
		"在配置界面中，您可以添加更多标签来控制传输的数量和速度，以及设置过滤器。"
		""
		"可以用另一个标签或标签访问器左键点击来移除标签。"
	]
	quest.2BE4C2280C195282.quest_desc: ["还有精神共鸣宝石（Plus Spirit Attuned Gems）"]
	quest.2BE4C2280C195282.title: "阿布拉的魔法卷轴"
	quest.2BF4F678812848FC.quest_desc: ["[\"要开始，我们需要将\", { \"text\": \"发酵\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"2C7267F92822D2C1\" },\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]} },\"我们的铁硫磺变成普通金属硝石。\"]"]
	quest.2BF4F678812848FC.title: "发酵过程"
	quest.2C1538BE243F0CB4.quest_desc: [
		"所以你找到了一个想拥有的特性？你需要把它注入到一个质粒中。"
		""
		"只需一个螺旋体即可设定质粒的类型。之后，你可以用更多同类型螺旋体填充，也可以用基础基因。两者均可，但用基础基因需要更多。"
		""
		"&a🛈 提示：使用基础基因来制作空基因"
		"&a    Plasmids rather than wasting useful "
		"&a    它们身上有基因。"
	]
	quest.2C7267F92822D2C1.quest_desc: [
		"第一步，我们需要将石英硫磺发酵成普通宝石硝石。"
		""
		"将石英硫磺、一些水和一些发酵剂放入桶中，然后用潜行右键将其封好。"
		""
		"发酵桶一次最多可以处理一叠材料。"
		""
		"&a🛈 提示：比较器读取的是输出端"
		"&a    桶的槽位，表示该物品被放置在桶中"
		"&a部分或全部材料已经"
		"&a    已处理。"
	]
	quest.2C7977E4AE6B627B.quest_desc: [
		"在开始杀戮之前，你最好先制作一些工具。"
		""
		"首先，你需要一个永恒闭合之箱。它会成为你释放的灵体的陷阱，使其能在特定机械中被使用。"
		""
		"接下来，你需要一个复仇焦点。这个工具用于将灵魂引导至永恒闭合箱中，从而将其困住。"
		""
		"要使用焦点，只需长按右键。你会看到一串粒子流，需要将其对准灵体。按住足够久，灵体就会被盒子吸收。"
	]
	quest.2C84374CBB186FE2.quest_desc: [
		"Creosote 带来了制作 Lubricant 的能力，而 Lubricant 能让你运行 Cutting Machine 来制作 Rods 和 Bolts。是的，现在你可以彻底告别 Forge Hammer 了！"
		""
		"&a🛈 提示：右键点击许多青铜级物品"
		"&a    使用火药的机器会短暂地"
		"&a    加快它们的速度。"
	]
	quest.2CA1A8A7B84FAD71.quest_desc: [
		"Modular Routers 是一款功能强大的综合物流模组。"
		""
		"查看指南，了解更多信息，掌握如何利用它来占据优势！"
	]
	quest.2D4B890D1BE63327.quest_desc: [
		"考虑到粗制高炉无法以任何方式自动化，你最好用第一批炼制的钢锭将其升级为改良高炉。"
		"&n"
		""
		"这个结构非常简单，由一个 3x3x3 的加固爆破砖立方体和顶部的一个漏斗组成。"
		""
		"IE 的多重方块总是通过右键点击结构方块并使用工程师之锤来建造的。"
		""
		"此时，右键点击结构任意一侧的中心方块即可。"
		""
		"&a🛈 Tip: The Engineer’s Manual highlights "
		"&a    在&c红色&r&a的成型方块中。"
	]
	quest.2D5820091B6B2315.quest_desc: [
		"Latex 和 Rubber 是 Industrial Foregoing 中除石头、金属和木材等基本资源外，最基础的两种资源。"
		""
		"获取乳胶将从流体提取器开始。在机器前放置金合欢原木，它会慢慢提取乳胶，并随时间分解原木。"
		""
		"这台机器运行不需要电力，但提供电力会大大加快速度！"
	]
	quest.2D689820562A9B9A.quest_desc: [
		"想制作自己的法术卷轴吗？制作一个卷轴锻造台吧！"
		""
		"提供纸张、墨水和“钥匙”物品，你就可以制作任何你想要的卷轴。只需放入所需材料，并选择你想要的法术即可。"
		""
		"部分卷轴只有在更高等级的墨水下才能获得！"
	]
	quest.2DFAEB81548A578A.quest_desc: [
		"热电发电机是一种低功耗的固态发电机。要使其工作，需要在相对的两面各放置一个高温和低温方块。"
		""
		"例如，一侧是蓝冰，另一侧是铀，将产生最大功率。"
		""
		"完整兼容方块列表请参阅工程师手册。"
	]
	quest.2EF8D2BD30779E56.title: "伊哈甘的魅惑 (Ihagan's Enthrallment)"
	quest.2F28FE62872496C8.quest_desc: ["太阳能板是发电的基础，白天能被动地产生能量。不过，要尽量储存足够的电力来度过夜晚！"]
	quest.2F797BC2E447F9BF.quest_desc: [
		"铝不像钢那么容易获得，要提取足量用于制作的铝会非常耗时。获得铝的第一步是搭建一个电炉，简称EBF。"
		""
		"&a🛈 提示：先放置控制器方块，然后"
		"&a    手持扳手或撬棍即可查看"
		"&a    结构或有效位置用于"
		"&a    孵化口。"
	]
	quest.2F835F759B26FD4E.quest_desc: [
		"UV Light Box 是制造用于高级科技和物流的 PCB 的关键步骤。"
		""
		"该设备用于将空电路板准备好进行蚀刻。空电路板在紫外光箱中放置的时间越长，成功蚀刻的几率就越高。暂时将阈值设为100%，以确保空电路板能在下一步成功蚀刻。"
		""
		"更简单的方法很快就会可用。目前，批量制作大量空白 PCB 就足够了。"
	]
	quest.2F898C0C2DF380AE.quest_desc: ["The following are bulk energy storage units."]
	quest.2F898C0C2DF380AE.title: "批量储能装置"
	quest.2FB39BF76836FA47.quest_desc: [
		"这么多僵尸和骷髅到处走动，亡灵蔓延到植物上，真的还意外吗？"
		""
		"在血液注入器中制作不死树苗并培育它，以获得不死木。这种特殊木材是其他工艺的重要资源。"
	]
	quest.300AE428F98F97AF.title: "阿夫里特破碎机"
	quest.307FEC610F0B542F.quest_desc: [
		"复制机本身基本上有两种操作模式。"
		""
		"在任一模式下，它都会自动从连接到网络的储罐中抽取所需材料。"
		""
		""
		"&7&n无限模式&r"
		""
		"要使用此模式，只需将物品放入无限模式槽位。复制器将尝试使用网络中的材料来持续克隆此物品。"
		""
		"这通常最适合需要稳定供应的物品。"
		""
		""
		"&7&n按需模式&r"
		""
		"网络中未处于无限模式的任何复制器均可用于按需请求。此类请求在终端发出，并将自动在可用复制器之间分配。"
		""
		"提出此请求还需要将模式存储在内存芯片上。"
		""
		"&6⚠ 注意：带有额外数据的物品，例如"
		"&6    电池或物品栏，将会被"
		"&6    已克隆为空。"
	]
	quest.309083107758B10C.quest_desc: [
		"既然你已经得到了第一本魔法书，那就来添加一些额外的符文来增添乐趣吧。"
		""
		"要制作新符文，只需右键点击文士台即可。这将显示所有已知和未知的符文，并按等级分类。你还可以搜索，所以找到想要的符文应该不难。"
		""
		"先来做点简单的东西吧：敏感元件。"
		""
		"这样你就可以改变法术的目标，例如击中水而不是下方的方块，或者连接到草和树苗。"
		""
		"它还增强了诸如“粉碎”之类的效果，使其能作用于物品而非方块。"
		""
		"&6&n示例法术&r"
		""
		"&7粉碎物品&r"
		"    &5Projectile&r > &aCrush&r > &6Sensitive&r"
		""
		"&7树苗生长&r"
		"&5投射物&r > &6敏感&r > &a生长&r"
		""
		"&a🛈 提示：抄写台将从中获取物品"
		"&a附近的物品栏会自动更新！"
		""
		"&6⚠ 注意：已知的符文存储在"
		"&6    你的玩家数据。丢失一本书"
		"&6    只是意味着失去法术连招而已"
		"&6    你制作的，而不是全部Glyph"
		"&6    知识。"
	]
	quest.31129C8D75EFD8E9.quest_desc: ["燃气发电机可以燃烧乙烯来产生更多能量。几个这样的发电机搭配自动化农场，应该能满足很长一段时间内的电力需求。"]
	quest.31B6AE7706264320.quest_desc: [
		"亡灵并不特别强大，但如果直接接触，它们会造成少量伤害。"
		""
		"燃烧的宝石可以吸收伤害，但会消耗你的饥饿值。"
	]
	quest.31CACA407D4ADCA5.quest_desc: [
		"FE 存储单元能将你的 AE 系统变成变电站，不仅为机器提供配方组件，还提供运行所需的电力。"
		""
		"你需要在ME驱动器中安装至少一个FE存储单元，并安装带有感应卡的接口，才能从发电机接收能量。"
		""
		"储存的能量可以通过Flux Accessor访问以驱动机器。Pattern Provider也可以安装Induction Card，为所连接的机器提供电力！"
	]
	quest.3202466CAE3744A9.quest_desc: [
		"操控灵魂是邪恶的重要组成部分。不过，你需要一些工具来与它们互动。"
		""
		"要开始，你需要制作一个复仇戒指。潜行+右键激活它，可以获得多种强力增益，并能看到你击杀的生物的灵魂。"
	]
	quest.3202466CAE3744A9.title: "灵魂"
	quest.3263757C9A240C70.quest_desc: [
		"Chipped 提供了多种方块变体，满足你的所有装饰需求。工作台本身也同样精美，能轻松点缀你的室内装饰。"
		""
		"如果你想边走边做，该模组还提供多种手持工具，其功能与放置在工作台上一模一样。"
		""
		"工作站的不同款式仅影响外观。它们都能制作任何 Chipped 方块，所以选你最喜欢的吧！"
		""
		"&a🛈 提示：在 EMI 中搜索 &3@chipped&r &a以查找"
		"&a    探索更多未知。"
	]
	quest.3263757C9A240C70.title: "Chipped"
	quest.33014A99A399B607.quest_desc: [
		"虽然获得不易，但 Tier 4 维度存储稳定器绝对值得你付出努力。"
		""
		"准备好探索一番才能获得全套装备吧！不过，我们会先给你一个额外的专属物品作为开端。"
	]
	quest.342FED2B0AC5F1B2.quest_desc: [
		"许多Mekanism机器都需要某种化学物质来执行配方，例如用化学形式的红石来创造浸渍合金。"
		""
		"虽然可以用物品形式提供，例如富集红石，但也可以用化学形式提供，以简化与机器的交互。"
		""
		"毕竟，物品需要放在黄色额外栏位，而化学形态可以和其余材料放在同一侧。"
		""
		"&a🛈 提示：富矿红石和其他物品"
		"&a    物品可以转化为化学物质"
		"&a    在化学氧化器中形成。"
	]
	quest.3456EED039818662.quest_desc: [
		"量子桥是一种用于跨维度扩展网络的组合方块。它由八个量子环和位于中心的量子连接室组成。"
		""
		"大多数情况下，两端都需要一个，每个都配有一对纠缠奇点。不过，还有一种非常实用的量子桥卡，可以安装在无线终端中，使其也能连接到量子桥上。"
		""
		"这意味着你可以在指尖上无限地访问跨维度的家庭网络！"
		""
		"&a🛈 提示：给你的 Entangled 命名"
		"&a    帮助你记忆的奇异点"
		"&a    哪些该放在哪里。"
	]
	quest.3456EED039818662.title: "量子桥梁"
	quest.349B97172AB3E56E.quest_desc: ["电解器像离心机一样，能帮我们分解材料，比如从青金石和绿宝石粉尘中回收铝。很快它还会用于各种流体转换。"]
	quest.34E95009CEB72776.quest_desc: [
		"魔法灯为精灵们提供了一个舒适的世界接口。通过将精灵绑定到灯上，可以设定它们在一段时间内进行采矿工作。"
		""
		"将灯放置在维度矿井中。它会随着时间的推移缓慢产生材料。"
		""
		"这些灯可以破坏，但在破坏前，维度矿井会尝试将其移至输出槽，方便提取和修复。但如果所有输出槽都满了，灯就可能会丢失！"
		""
		"&a🛈 提示：物品可以从以下位置提取"
		"&a    矿井的底部。"
	]
	quest.34F48A8F71A7C937.quest_desc: [
		"末地箱子是末地箱的升级版。它们不仅可以通过自动化和物流系统存取，还可以根据名称分成多个通道。"
		""
		"要设置频道，将木箱与末影之眼一同放置于砧上，然后设置名称。该名称即为频道，任何其他同名木箱都将共享同一物品栏。"
		""
		"此外，可以使用末影之眼来远程访问末影箱。将其重命名为与箱子相同的名称以设置频道。"
	]
	quest.34FFE863EB846035.quest_desc: [
		"森林仪式是你首次真正踏入自然光环魔法的探索，需要使用一个大型的多方块结构。"
		""
		"开始前，你需要 8 个木制支架和 16 个金粉。将它们按同心圆排列，并将合成材料以任意顺序放置在木制支架上。"
		""
		"请参阅自然光环之书，查看它们的放置预览。"
		""
		"将所有物品和粉末放置好后，将指定的树苗种在中央并使其生长。树苗长大后，仪式便会开始。"
		""
		"&6⚠ 注意：会消耗黄金粉末"
		"&6    制作过程中！"
		""
		"&a🛈 提示：环境之眼将允许你"
		"&a    让你看到本地的灵气水平！"
	]
	quest.34FFE863EB846035.title: "森林的仪式"
	quest.356670417C9A6BB8.title: "Foliot 破碎机"
	quest.35700C5AA357B012.quest_desc: ["量子计算代表了计算机技术的巅峰。借助这些惊人处理器带来的计算能力，你将能驾驭太阳的力量，建造属于自己的个人聚变反应堆。"]
	quest.358A62846D6B0004.quest_desc: [
		"热气动加工厂，简称TPP，对于提高石油精炼的产出非常有用。"
		""
		"较无用的产品可转化为更有价值的材料，例如用柴油制作润滑油。"
		""
		"TPP 也用于制造熔融塑料，这是我们的主要目标。取一桶这种物质，倒在地上冷却成可用的板材。"
		""
		"&a🛈 提示：塑料也可以用以下物品冷却："
		"&a    加热框架，提升产量！"
	]
	quest.358A62846D6B0004.title: "塑料"
	quest.359562022532BAE1.quest_desc: [
		"灵魂灌注可用于增强物品和材料，赋予它们更强的效力。"
		"&n                                                   &r"
		"首先，让我们来制作一些灵魂污染钢。"
		""
		"在EMI中查看Spirit Altar配方时，应将中间的物品和左侧显示的Spirit放置到祭坛上。"
		""
		"右侧显示的任何物品都必须放入附近的物品基座或物品支架中。"
		""
		"物品可以连接到这些方块，或者在手工合成时右键放置。"
		""
		"&6⚠ 注意：物品支架和基座"
		"&6    必须在四格方块范围内"
		"&6    祭坛。"
	]
	quest.35A8CEA408114638.quest_desc: [
		"如前所述，Aura 是一种需要维持的有限资源。幸运的是，有多种发电机可供使用。"
		""
		"每种都有其优缺点，并且使用独特的输入来运行。通常来说，输入越容易获得，产生的气场就越少。"
		""
		"想要高输出的话，可以试试 &2Shooting Mark&r、&2Firecracker Gaze&r 或者 &2Lingering Absorber&r。"
		""
		"如果只是需要一点灵气来驱动小装置，那么&2食草吸收器&r或&2沼泽伙伴&r就足够了。"
		""
		"所有这些都详细记载在《自然灵气之书》中，请务必查阅相关条目以获取具体的设置信息。"
	]
	quest.35FB0C624C95D506.quest_desc: [
		"祭坛是按需召唤更多生物的一个绝佳方式。"
		""
		"这算不上一个完整的刷怪塔，但可以很好地用来获取一些稀有生物，供你选择的另一个农场使用。"
		""
		"用这个任务的奖励召唤几只兔子试试吧！"
	]
	quest.35FD905A4A4EB1F5.quest_desc: [
		"Pretty Pipes: Fluids 是 Pretty Pipes 的扩展，使网络除了物品外还能传输流体。同一网络可同时传输两者，让一切通过单个方块空间流动。"
		""
		"因此，流体管道仅在管道连接到流体储罐的末端需要。"
		""
		"与 Pretty Pipes 类似，此附加包包含用于将流体进出储罐的提取和回收模块。它还提供了一套过滤器，并与 Pretty Pipes 的优先级系统兼容。"
	]
	quest.368DC26C96A32AB7.quest_desc: [
		"与热交换器结合使用时，大型蒸汽锅炉将显著提升您的发电能力。"
		""
		"&a🛈 提示：先放置控制器方块，然后"
		"&a    手持扳手或撬棍即可查看"
		"&a    结构或有效位置用于"
		"&a    孵化口。"
	]
	quest.369D0F2CC8D028D2.quest_desc: [
		"最多可放置四个增幅器和一个核心增幅器，以进一步增强灵晶熔炉。"
		""
		"同一个增强可以多次使用，但最好混合搭配不同的增强以获得最佳效果。"
		""
		"手持音叉会显示所有已安装增幅器的总效果。"
		""
		"用音叉右键熔炉，还可以选择修饰符以获得更强的增幅。"
		""
		"多尝试几种，看看哪种最适合你！"
	]
	quest.37D7B78BDD5F420B.title: "Xovrenth Adjure"
	quest.380D0C6385B6325C.quest_desc: [
		"黑石英是 Actually Additions 中使用的基础资源，也是开始游戏所必需的。"
		""
		"通常在 &6Y 45&r 和 &6Y -25&r 之间挖矿可以找到。"
	]
	quest.384024534B512211.quest_desc: [
		"与其他大多数科技模组一样，Immersive Engineering 兼容 FE。你可以选择使用该模组自身的电源选项，也可以使用其他模组的电源。"
		""
		"大多数机器，只需将任意电源线接到能源端口即可。不过，像发光灯这样的方块，只能用IE电线供电。"
		""
		"要使用IE的线路，两端都需要连接器，中继器用于延长线路的覆盖范围。"
		""
		"中继器可以连接多条导线，而连接器只允许一个连接。用导线线圈从一个方块右键点击另一个方块即可建立连接。"
		""
		"Connections may be snipped with Wire Cutters."
		""
		"&a🛈 提示：只有开始和结束"
		"&a    连接器需要加载，所以"
		"&a    可以穿过电线进行布线"
		"&a    未加载的区块！"
		""
		"&c⚠ 警告：未绝缘的线路是致命的！"
	]
	quest.3895E1D9DE518B3F.quest_desc: [
		"施放所有这些法术都会消耗你的法力值，尤其是当你把法术书当作主要采矿工具使用时"
		""
		"要更快地补充法力，可以考虑制作一个虚空瓶。这些实用装置会吃掉你拾起的物品，并将其直接转化为法力。"
		""
		"要设置可食用的物品，请将该物品放在副手，并用罐子右键点击。"
		""
		"可以考虑加入像 Cobble 和其他石头之类的东西。"
		""
		"&a🛈 提示：罐子可以随时切换的"
		"&a    时间通过潜行 + 右键点击来消耗。"
	]
	quest.391AE516AF1C26D6.quest_desc: [
		"获取灵魂木需要进行一次无定向仪式。"
		""
		"在 Runewood 底座上建造一个顶部有五个 Runewood 原木的图腾，然后在每个原木上创建一个 Arcane 符文。"
		""
		"激活后，周围的土地将被污染，灵魂木树苗将会出现。"
		""
		"&6⚠ 注意：建议远离此地进行操作"
		"&6    从你的家出发。"
	]
	quest.3954AC8D791145CE.quest_desc: ["流浪商人老来你家捣乱？不如让他来打个招呼吧！"]
	quest.397D4765002935F2.quest_desc: [
		"最重要的是，Mekanism 需要能量。因此，要开始使用此模组，你需要某种形式的 FE 发电机。"
		""
		"用岩浆包围热能发电机即可使其被动工作，覆盖的面越多，发电量越大。也可以通过管道输入岩浆或熔炉燃料来更快地发电。"
		""
		"&a🛈 提示：在以下模组中生成额外电力："
		"&a    下界。"
	]
	quest.39BCDF29A792B723.quest_desc: [
		"光环缓存可作为个人电池，为使用工具和盔甲消耗的光环进行充能。"
		""
		"这包括附魔了自然修复的所有物品，以及自然光环的所有盔甲和工具。要修理这些装备，只需手持工具或穿着盔甲时潜行即可。"
		""
		"缓存可在自然祭坛中填充，或在特定区域灵气异常高涨时，穿戴状态下被动填充。"
	]
	quest.3A078285904792A2.quest_desc: [
		"用于移动物品的简易物品管道。"
		""
		"它们可以被过滤，并接受马达作为升级来加速。"
	]
	quest.3A0F43654CE474DA.quest_desc: [
		"爱树的林地精，涡旋小精灵，如果你能表达爱意并在附近种一棵树，它们会很高兴加入你的动物园。"
		""
		"作为回报，Whirlisprig 会帮助你种植和收获植物。"
		"&n                                                  &r"
		""
		"右键点击任意花朵并使用她的魅力来为它们建造家园。在它们的家园中放置更多种类繁多的植物，会让它们更开心、更高效。"
	]
	quest.3A347A9576A5D514.quest_desc: [
		"量子升级能释放机器的最大潜力，单次升级即可使其达到最高性能。"
		""
		"务必将它们与量子机器外壳结合，因为它们运行需要巨大的能量。这将使它们能直接接收超导电力。"
	]
	quest.3A7AD25302240A1B.quest_desc: [
		"Ad-Hoc 网络是 Applied Energistic 中最简单的网络形式，由一段 Fluix 电缆和一些连接的设备（如 Storage Bus 和 Terminal）组成。"
		""
		"系统也需要一些电力。这可以通过晶体共振发电机被动提供，或者通过能量接收器主动提供，该接收器接受 EU 或 FE。"
		"&n"
		""
		"使用你收集的物品和本次任务的奖励，搭建一个简单的 Ad-Hoc 网络。"
		""
		"在每个桶旁边放置一个存储总线，然后"
		"用Fluix电缆将它们全部连接起来。"
		""
		"2. 将合成终端放置在工作台的任意位置"
		"Fluix 电缆。"
		""
		"3. 最后，附上你偏好的来源："
		"能量。"
		""
		"操作正确的话，你现在应该能访问所有六个箱子的内容，并能在终端中进行合成。"
		""
		"&6⚠ 注意：一个 Ad-Hoc 网络最多可包含八个"
		"&6    总共有个连接。"
	]
	quest.3A7AD25302240A1B.title: "Ad-Hoc 网络"
	quest.3AA1319E962A47C0.quest_desc: [
		"开采Iesnium需要附魔了Spirit的工具。大多数足够硬可以开采的材料也无法容纳Spirit。"
		""
		"Spirit Attuned Gems 勉强符合我们的标准，但最终制成的工具会非常脆弱。"
		"&n                                                  &r"
		""
		"制作一把附魔镐，为前往下界采矿做好准备。"
		""
		"找到 Iesnium 需要一些耐心，因为它相当稀有。不过，占卜杖会极大地帮助你。"
		""
		"&a🛈 提示：潜行状态下右键占卜"
		"&a    将木棍放在下界岩上以校准它"
		"&a    伊森尼姆矿石。"
	]
	quest.3AB9D7E7D4205334.quest_desc: [
		"ChocoCraft 是一款简单的模组，适合任何想要用有趣又华丽的坐骑来时尚地探索世界的人。"
		""
		"本章将帮助你发现这些可爱的鸟儿、它们最喜欢的食物，以及如何获取每种鸟类。"
	]
	quest.3AB9D7E7D4205334.title: "ChocoCraft"
	quest.3AD70D3BEF01A693.quest_desc: [
		"焦炭炉将是众多多区块机器中的第一台。"
		""
		"Modern Industrialization 中的每个多方块结构都需要与其配方相对应的输入和输出口。"
		""
		"在这种情况下，焦炭炉需要物品和流体的输入和输出。输入蒸汽和煤炭，输出焦炭和焦油。"
		""
		"建造任何结构所需的其他方块，也可以在EMI中查看控制器方块（如 Coke Oven 方块）的用途来找到。请注意，部分列出的方块将被 Hatches 所取代。"
		""
		"&a🛈 提示：先放置控制器方块，然后"
		"&a    手持扳手或撬棍即可查看"
		"&a    结构或有效位置用于"
		"&a    孵化口。"
	]
	quest.3B77FB0A8CFAAB97.quest_desc: [
		"末地激光可能相当危险，会摧毁路径上的几乎所有方块。但有些方块反而会因此获得力量。"
		""
		"使用目标指示器将末地激光对准正在生长的紫水晶。方块不会被破坏，反而其生长速度会大幅提升。"
		""
		"当紫晶簇出现时，激光会将其收割为纹石，这是一种可持续生产该宝贵资源的绝佳方式。"
		"&n                                                 &r"
		""
		"要锁定方块，先潜行+右键点击方块，再用目标指示器，然后潜行+右键点击激光。"
	]
	quest.3BC8ED2BD4E5EEC6.quest_desc: [
		"它们可能很小，但威力惊人。"
		""
		"&a🛈 提示：微型导弹可能会被恢复"
		"&a    用 TNT 和铁砧组合！"
	]
	quest.3BF1CB7CDDA99856.quest_desc: [
		"与灵体打交道，无论身心都是一种麻烦事。"
		""
		"你需要合适的材料才能掌握这种魔法，而这一切都始于灵魂石。"
		"&n"
		""
		"我们稍后会学习进一步精炼此物的方法。"
		""
		"现在开始挖掘，找到一些灵魂石原矿。你需要将其熔炼以获得精炼灵魂石。"
	]
	quest.3C169A2002B47DC5.quest_desc: [
		"用原油蒸馏器已经走得很远了，但该前进了。建造蒸馏塔能让我们从原油中获得更多的副产品。"
		""
		"最终你需要五个。但目前建议先制作四个，因为第五个需要更珍贵的材料才能运行。"
		""
		"&a🛈 提示：先放置控制器方块，然后"
		"&a    手持扳手或撬棍即可查看"
		"&a    结构或有效位置用于"
		"&a    孵化口。"
	]
	quest.3C4305830D6978C5.quest_desc: [
		"想让你的挖矿体验更上一层楼吗？"
		""
		"气动冲击钻是一种多功能采矿工具，可以轻松挖掘大面积区域。"
		""
		"它甚至可以通过在物品栏中放入财富或丝绸之触的附魔书来热替换附魔。"
		""
		"&a🛈 提示：空气罐阵列可用作"
		"&a    便携式空气电池，保持"
		"&a    你的工具续航更久了！"
	]
	quest.3C50D5FE5FA787A9.quest_desc: ["当你需要一把巨大的钻机枪来告诉怪物群谁是老大时。"]
	quest.3CA4472228D0F866.quest_desc: [
		"将ME控制器添加到网络中，我们就能访问到更多的频道，每侧多达32个。"
		""
		"然而，这并非全部。多个ME控制器可以组合在一起，形成一个更大的多方块结构。"
		""
		"建造这样一个多方块结构必须遵循以下规则："
		""
		"1. 所有控制器方块在一个"
		"网络必须已连接"
		""
		"2. 总大小不能超过"
		"7x7x7"
		""
		"3. 控制器可以有两个"
		"最多沿一个轴相邻的方块"
		""
		"AE指南为感兴趣的人提供了更详细的技术细节和有用的图片！"
		""
		"&a🛈 提示：使用 ME 网络分析仪来"
		"&a    调试你网络上的频道！"
	]
	quest.3CA4472228D0F866.title: "ME 网络"
	quest.3CABB289A26506BE.quest_desc: ["电子元件需要高质量的电线，手工难以轻松制作。不过，电线厂非常适合这项任务。"]
	quest.3D307863E39B9EFE.quest_desc: [
		"驯服的奇可波可以通过喂食可爱的吉萨尔蔬菜轻松繁殖，但这很少能产生新的颜色变种。"
		""
		"想要更可靠的突变，请使用黄金吉萨尔代替。"
		""
		"&a🛈 提示：这些 Gysahl 品种是"
		"&a    在农场中偶尔获得"
		"&a    普通的吉萨尔。"
		"&n                                                  &r"
		""
		"可能的突变："
		"• &e黄色&r + &e黄色&r = &2绿色&r 或 &9蓝色&r"
		"• &2绿色&r + &9蓝色&r = &7白色&r"
		"• &e黄色&r + &7白色&r = &8黑色&r"
		"• &8黑色&r + &7白色&r = &6金色&r"
		"&6⚠ 注意：&o需要黄金吉斯哈尔"
		"&n                                                  &r"
		""
		"&6⚠ 注意：以下页面包含"
		"&6    关于能力的更多信息，请访问"
		"&6    这些品种中的每一种。"
		""
		""
		"{@pagebreak}"
		"• &e黄色乔克波&r是普通品种"
		"种类繁多。和所有奇可宝一样，它们"
		"拥有缓慢下落的能力，可以让我"
		"让他们从很高的地方摔下来，伴随着"
		"伤害很小。"
		""
		"• &2绿色乔克波&r拥有以下能力："
		"攀爬，让它们可以向上爬升方块"
		"相对轻松地完成这些任务会容易得多。"
		""
		"• &9蓝色奇可波&r擅长游泳"
		"并且比他们的&2绿色&r移动得更快"
		"陆地上的表亲们。"
		"{@pagebreak}"
		"• &7白色奇可波&r会攀爬"
		"以及它们的&2绿色&r游泳能力"
		"还有 &9蓝色&r 的表亲，除此之外还有"
		"在陆地上移动速度更快。"
		""
		"• &8黑色奇可波&r非常出色"
		"跳跃者，并且全部拥有相同的特性"
		"能力为&7白色奇可波&r，同时"
		"在陆地上移动速度也更快。"
		""
		"• &6黄金的奇可宝&r是最快的"
		"种类繁多，并且拥有飞行能力"
		"而不是像他们那样只是简单地滑翔而过"
		"表兄弟/表姐妹们。"
		"{@pagebreak}"
		"• &4红色乔克波&r是通过以下方式创造的"
		"将红吉斯艾尔喂给一只&6黄金"
		"&6奇可宝&r。它保留了所有原有的特性"
		"此变身后的各种能力。"
		""
		"• &d粉色奇可波&r是通过以下方式创造的"
		"将粉红吉萨尔喂给一只&6黄金"
		"&6奇可宝&r。它保留了所有原有的特性"
		"此形态转变后的各种能力。"
		"{@pagebreak}"
		"• &c火焰奇可波&r只能在以下地方找到"
		"在末地。当它们被一起繁殖时"
		"或者用&6黄金鸡&r它们可能会"
		"产下&c火焰&r后代。它们是"
		"免疫火焰，可以在岩浆中游泳，并且"
		"它们都是会飞的生物。"
		""
		"• &5紫色鸡鸡&r只能在以下地方找到"
		"在末地。当它们被一起繁殖时"
		"或者用&6黄金鸡&r它们可能会"
		"产下 &5紫色&r 的后代。它们是"
		"免疫火焰，可以在岩浆中游泳，并且"
		"它们都是会飞的生物。"
	]
	quest.3D307863E39B9EFE.title: "繁殖与变异"
	quest.3D334F8BDD0E4046.quest_desc: [
		"制造钛合金后，压力机应该是第一站。"
		""
		"它将用于升级我们的发电系统，并提供新材料。特别是液态空气，经离心分离可得到氩气和氮气，两者都用于实现更先进的电子设备。"
		""
		"&a🛈 提示：先放置控制器方块，然后"
		"&a    手持扳手或撬棍即可查看"
		"&a    结构或有效放置位置"
		"&a    孵化口。"
	]
	quest.3D4F8ED65C176071.quest_desc: [
		"蒸汽涡轮开启了电力与生产力新时代。"
		""
		"LV Tier机器运行速度比Steel Tier快，并引入了效率机制，使其能随时间推移而加速；不间断运行同一配方越久，处理速度就越快。"
		""
		"随着你不断进阶，为特定配方配备专用机器将变得越来越重要，设计新生产线时请记住这一点。"
	]
	quest.3D59639F51E89CF9.quest_desc: [
		"高级点击器在简易版的基础上进行了区域升级，使其能互动更大范围内的物品。"
		""
		"&a🛈 提示：使用渲染区域按钮来"
		"&a    轻松配置工作区域。"
	]
	quest.3D76C219EB7EEC03.quest_desc: [
		"一种在特定区域放置方块的小型装置。它会从上方的箱子中取出物品，并将其放置在指定方块的正上方。"
		""
		"将要放置的方块放入附在建造者上的物品展示框中。"
		""
		"例如，你可以用它在石砖环上放置金粉，来持续补充你的森林仪式！"
	]
	quest.3D91A9DBE0B091AE.quest_desc: ["防护和耐久度较低，但萌度爆表，Chocodisguise 是一套能让你感觉自己融入羊群的盔甲。"]
	quest.3D91A9DBE0B091AE.title: "巧克力伪装术"
	quest.3D9527EAA5944C17.quest_desc: [
		"欢迎来到模块化力场！Welcome to Modular Force Fields!"
		""
		"这些任务将帮助你探索这个模组，它主要围绕基地防御展开，但也提供了一些建筑辅助工具。"
	]
	quest.3D9527EAA5944C17.title: "模块化力场模组 (Modular Force Fields)"
	quest.3DFBC78C0646A5B5.title: "Djinni Crusher"
	quest.3E622F93756E9BFA.quest_desc: [
		"建造一台能存储、制作和传输所有你梦寐以求的零碎物品的巨型超级计算机，第一步要从一块水晶开始。"
		""
		"Certus Quartz，一种形成于深空的奇幻材料，只能在地表坠落的陨石中找到。"
		""
		"准备好踏上旅程，跟随陨石罗盘前往其中一个地点。在那里，你将挖掘陨石坚硬的外层，发现 Certus Quartz 和开始加工所需的工具。"
		""
		"在陨石内部，你还会找到一个神秘立方体。打破它即可获得全部四个电路压机。"
	]
	quest.3E622F93756E9BFA.title: "陨石狩猎"
	quest.3E7A4470BD04F2A1.quest_desc: [
		"简易传感器是一种通用型方块和实体传感器，会根据其设置发出信号。"
		""
		"例如，这可以成为控制简易方块破坏器的绝佳方法。"
		""
		"将物品或方块从EMI拖到中间的过滤槽。右键点击过滤器中的方块以配置水浸等状态。"
		""
		"过滤实体时使用该生物的刷怪蛋，过滤流体时使用一桶该流体。"
	]
	quest.3EA53BBEBC32F813.quest_desc: [
		"欢迎来到 Genetics: Resequenced!"
		""
		"这个模组主要让你自己和别的生物获得特殊能力。"
		""
		"想不想把猪的肉剃下来？给鸡挤奶？像羊一样吃草？或者直接用光合作用的力量来养活自己？"
		""
		"现在你可以做到了！"
		""
		"这些任务将引导你了解模组的基础用法。之后，如何使用它，就看你自己了。"
		""
		"请务必查看他们的在线 Wiki，这是一个获取补充信息的绝佳来源。]"
	]
	quest.3EA53BBEBC32F813.title: "基因学：基因序列已重排"
	quest.3ED6754FC6B0A36D.quest_desc: [
		"Just Dire Things 添加的工具具有多种有趣的属性，可以为其附加；只需在锻造台将工具和升级材料一同合成即可。"
		""
		"安装后，可通过手持工具潜行右键来启用、禁用或以其他方式配置每个功能。"
		""
		"启用后，大多数功能会自动运行。但像割草机这样的功能，则需要右键激活。"
		""
		"以下页面将介绍各项能力的具体作用。"
		""
		"&a🛈 Tip: To see which abilities a tool has,"
		"&a    悬停在它上面时按住 Shift 键"
		"在EMI中，&a"
		"{@pagebreak}"
		"&7&n武器能力"
		""
		"可在 Swords and Paxels 上获取。"
		""
		"• &aMob Scanner&r: 定位附近的生物"
		"敌对生物。"
		"• &a自动烤炉&r: 烹饪掉落物。"
		"• &a灼伤伤口&r：在...时自我治愈"
		"耐久度/能量的消耗成本。"
		"• &aMob X-Ray&r: 高亮显示附近的生物。"
		""
		"&7&n杂项能力Miscellaneous Abilities"
		""
		"多种工具类型上均可使用。"
		""
		"• &aDrops Teleporter&r: 将掉落物传送走"
		"到一个已绑定的物品栏中。"
		"• &aLava Repair&r: 掉落时进行修复"
		"在岩浆中，将岩浆转化为"
		"黑曜石。"
		"• &aHammer&r: 3x3 范围挖掘，从中心点开始。"
		"随等级提升而增加。"
		"• &a自动熔炉&r: 熔炼采集的方块。"
		"• &a即时破坏&r：没错。"
		"{@pagebreak}"
		"&7&n镐的能力"
		""
		"镐和Paxel上均可使用。"
		""
		"• &aOre Miner&r: 挖掘所有相连的矿石。"
		"• &aOre Scanner&r: 定位附近的矿石。"
		"• &aX-Ray&r: 高亮显示附近的矿石。"
		""
		"&7&n铲子能力"
		""
		"铲子和帕塞尔上均可使用。"
		""
		"• &a割草机&r: 立即破坏附近的"
		"草地和花朵。"
		"• &aSkysweeper&r: 破坏沙子和"
		"目标方块上方的砾石。"
		""
		"&7&n斧头能力"
		""
		"斧头和帕塞尔上均可使用。"
		""
		"• &aTree Feller&r: 破坏一片区域内的原木。"
		"• &aLeaf Breaker&r: 可立即破坏"
		"一片区域内的树叶。"
		"{@pagebreak}"
		"&7&n锄头能力"
		""
		"锄头的特殊能力是创造新的农田类型，因此与其他工具的行为略有不同。"
		""
		"这些农田都具有以下能力："
		""
		"• 免疫践踏伤害。"
		"• 加速作物生长。"
		"• 自动收获和重新种植。"
		""
		"对于具有掉落物传送器能力的锄头，自动收集的物品将进入锄头耕作时绑定的物品栏。"
	]
	quest.3ED6754FC6B0A36D.title: "仅仅是 Dire 工具而已"
	quest.3F021EBB71F4BC70.quest_desc: [
		"智能线缆与其普通版本完全相同，只是多了一个小功能：它们会直接在表面显示通过的频道数量。"
		""
		"这些能帮你清楚地追踪正在使用的频道数量，因为你可以直观地追溯它们的来源。"
	]
	quest.3F11C37840644254.quest_desc: [
		"用塑料做的第一件事，很可能是制作阿马德龙平板电脑，它能让你获得一些别处找不到的优质交易。"
		""
		"这里值得购买的是 PCB 蓝图和钻孔与激光组装程序。把这两个都拿到并保存好。"
		""
		"&a🛈 提示：Amadron 允许玩家"
		"&a    创建自定义商店进行交易"
		"&a    相互之间！"
	]
	quest.3F2E1099BB66AFEB.title: "阿布拉的加固附魔物品"
	quest.3F30CC32709BE5DD.quest_desc: ["仅次于偏振器，制造一台装配器将大幅降低制作电子元件的成本。"]
	quest.3F815BF9AC5DD212.quest_desc: [
		"流体填充器是填充区域流体的绝佳方式。只需接入流体和电源，就能快速制造出任何你想要的湖泊！"
		""
		"相反，电动水泵是机器制水的简单有效方法。将其置于标准无限水源（2x2 或 1x3 水域）上方并提供电力。"
		""
		"&a🛈 提示：在过滤器升级中使用一个"
		"&a    用于生产的电动泵"
		"&a    重水。"
	]
	quest.3FA7963385E35E27.quest_desc: [
		"要开始玩 EvilCraft，就得去挖矿；这可能是最邪恶的活动了。"
		""
		"在地球深处，就在红石附近的地方，你会发现暗矿石。"
		"破坏它会掉落暗宝石，但你还需要暗宝石碎块，这只能通过使用时运附魔挖掘才能获得。"
		""
		"&a🛈 提示：使用时运挖掘会掉落两者"
		"&a    暗黑宝石和暗黑宝石碎末！"
	]
	quest.3FF6566453299DC1.quest_desc: [
		"Applied Energistics 是终极的存储和物流解决方案。它不仅能存储物品和流体，还能通过自动合成系统充当外部机器的控制器。"
		""
		"在专门的章节中阅读更多关于此系统的信息：\",{\"clickEvent\":{ \"action\": \"change_page\", \"value\": \"7D82585D50D7207A\" },\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\": \"Applied Energistics\",\"underlined\":true},\"。\"]"
	]
	quest.3FF8D40CD4CB33BB.quest_desc: [
		"想要一把简单又坚固的工具吗？这些工具能满足你的需求。"
		""
		"当然需要能量，但它们接受的附魔让它们成为早期替代斧头、铲子和镐的绝佳选择。"
	]
	quest.3FF8D40CD4CB33BB.title: "电动工具"
	quest.3FFF6EF85443852C.quest_desc: [
		"你需要一点能量来运行你的机器！"
		""
		"OriTech 使用许多科技模组的标准 FE 能量，所以你可以在任何地方建造你的发电装置。或者使用模组本身提供的精美动画选项！"
	]
	quest.3FFF6EF85443852C.title: "电力生成"
	quest.4068ABB6B3C24FEC.quest_desc: [
		"能量激光中继器是一种无线输电装置。只需将它们放置在需要供电的机器旁，并在发电机上放置一个，然后用激光扳手将所有中继器连接起来即可。"
		""
		"它们的射程相对较短，但可以非常有效地连续使用！"
	]
	quest.407079BCE93817AC.quest_desc: [
		"女王的心愿是一系列可重复的进阶任务，用于从女王蜂处获得特殊恩赐。"
		""
		"[\"这些内容在进阶（\",{\"color\":\"gold\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"进阶键\"}]},\"keybind\":\"key.advancements\"},\") 屏幕中均有详细说明，但为了方便查阅，任务列表也在此列出。\"]"
		""
		"完成所有成就后，可以用空手右键点击女王蜂来重置成就，从而再次获得所有奖励。"
		"&n                                                  &r"
		""
		"• 制作6个蜂巢或蜂箱"
		""
		"• 击杀32只蜘蛛，获取它们的"
		"恶心的东西（洞穴蜘蛛不算在内）。"
		""
		"• 一口气喝下8瓶蜂蜜！"
		""
		"• 用花粉投掷并击中 24 个实体"
		"呼。其他玩家也算在内！"
		"{@pagebreak}"
		"• 杀死8只正在爬行的扭动的Silverfish"
		"到处挖掘和四处打洞的怪物们。"
		""
		"• 用弓射下32个蜜蜂的毒针，或者"
		"十字弓。"
		""
		"• 繁殖6个蜂蜜史莱姆（它们真的"
		"喜欢糖！）。"
		""
		"• 屠夫 16 洞穴蜘蛛 来自"
		"深处。"
		""
		"• 从死亡边缘拯救 12 只蜜蜂，方法是"
		"把他们的毒针重新装回去。"
		""
		"• 通过授粉生成 8 朵花"
		"用花粉粉获得的花朵。"
		"{@pagebreak}"
		"• 不知怎地用以下方式击败了末影人："
		"毒针长矛..."
		""
		"• 通过以下方式满足蜜蜂的饥饿感"
		"用糖水或蜂蜜来喂养它们-"
		"像这样重复48次！(可以是同一只蜜蜂)"
		"或者不同的蜜蜂)。"
		""
		"• 繁殖蜜蜂，直到总共获得 8 只幼虫"
		"蜜蜂出生了。"
		""
		"• 杀死 4 个末影螨以获取它们的"
		"存在的逾越。"
		""
		"• 通过击败传奇生物，成为传奇"
		"穿戴全套蜜蜂盔甲的末影龙。"
		""
		"• 与蜜蜂女王交易 128 次。"
		"不一定要是附赠的交易。"
		"任何交易都可以！"
	]
	quest.407079BCE93817AC.title: "女王的心愿"
	quest.40948DF54E7594A7.quest_desc: [
		"实际上，实际上附加模组使用了许多你熟悉材料的变体。青金石变成了帕利斯水晶，铁变成了埃诺里水晶，以此类推。"
		""
		"这些转换是使用原子重构器完成的。"
		""
		"这台机器在通电后，会周期性地发射出一道能量束。路径上的任何合适物品或方块都将被转换。"
		""
		"&a🛈 提示：右键点击机器并使用一个"
		"&a    用红石火把来将其更改为"
		"&a    脉冲红石模式。"
		""
		"&6⚠ 注意：方块可能会被双向转换"
		"&6    物品形式和放置的方块形式"
		"&6    游戏内。"
	]
	quest.40EECBD3D00B9575.quest_desc: [
		"流体储罐有多种尺寸，可用于储存任何类型的流体。"
		""
		"&a🛈 提示：潜行状态下右键点击带有"
		"&a    用于设置储罐的配置文件"
		"&a    从底部自动输出物品。"
	]
	quest.410225ED927857D4.quest_desc: [
		"这三种机器可以组合起来，自动刷取被动生物。"
		""
		"首先，动物喂食器会保持你的动物饱腹、开心并繁殖。当工作区内的动物过多时，此功能将自动停止工作。"
		""
		"动物牧场可以在同一区域使用，用于收集绵羊的羊毛和奶牛的牛奶。"
		""
		"动物幼崽分离器可用于将幼崽送入饲养区等待长大。该方块还有反向模式，可将长大的动物从饲养区分离并送入最终目的地——屠宰工厂。"
		""
		"&a🛈 提示：安装配套的 Range Addons 模组"
		"&a    在每个中覆盖相应的部分"
		"&a    区域。"
	]
	quest.410225ED927857D4.title: "动物养殖系统"
	quest.413A165C27E8E5A6.quest_desc: [
		"一种更强大的粉碎形式，碎片锻造炉将基本取代研磨机，同时提高许多产品的产量。"
		""
		"附加机器产率增强器也会增加该机器产生的次要产物数量。"
	]
	quest.415D9A877B172BBC.quest_desc: [
		"通过高级AE模组，可以使用一种更高级的图案提供器。这种图案提供器提供了两个主要功能。"
		""
		"1. 可以配置为插入物品"
		"到机器的特定一侧。"
		"一个物品可以放在一边，而另一个物品可以放在另一边"
		"资源可能会从顶部进入，"
		"例如。这是通过以下方式实现的"
		"使用高级模式编码器 (Advanced Pattern Encoder)"
		"以设置每个物品的方向。"
		""
		"2. 它能容纳更多图案，多达 36 个"
		"要精确，但请注意，警告如下："
		"将所有模式整合到一个文件中"
		"单个机器并不总是有用的。"
		"通常最好是将配方分散开来"
		"在多台机器之间进行传输的"
		"并行处理的缘故，请谅解。"
	]
	quest.41614A924E5556EE.quest_desc: [
		"欢迎来到 Ars Nouveau！"
		""
		"这个激动人心的模组将满足你所有的魔法幻想，从施放法术到酿造药水。"
		""
		"召唤魔法生物，制作魔法小工具，自动完成家中几乎所有任务！"
		""
		"Ars Nouveau 还有许多附加模组，带来了诸多新机制和功能。"
		""
		"这些任务无法涵盖所有内容，但指南书应该能解决这里未涉及的问题。"
		""
		"&a🛈 提示：源浆果可以种植"
		"&a    在草地上！"
	]
	quest.41614A924E5556EE.title: "Ars Nouveau"
	quest.416D6EA79B73A4B9.quest_desc: [
		"生物复制器是刷取特定生物的好方法，如果你需要大量该生物产出的掉落物。"
		""
		"只需将生物用生物囚禁工具捕获，然后放入机器中即可。"
		""
		"它还需要大量精粹才能运行，因此你需要保持机械泥土和生物破碎机运转以生产所需的精粹。"
	]
	quest.4229112D97BB45E6.quest_desc: [
		"兼具有限存储功能的电源线，每个方块空间都储存着缓冲电力。"
		""
		"网络中的节点越多，每刻能传输的功率就越大。"
		""
		"更多信息请参阅他们的维基中的\",{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://wiki.aidancbrady.com/wiki/Universal_Cable\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"通用电缆\",\"underlined\":true},\"文章。\"]"
	]
	quest.422F7BABAAEE92E0.quest_desc: [
		"努力是值得的，柴油喷气背包的用法和鞘翅很像，用空格键来控制。"
		""
		"• 在地面上按住空格键即可成为"
		"被直接向上推进。"
		""
		"• 按空格键开始滑翔。"
		""
		"• 滑翔时，按住 Space 键可提供一"
		"朝你面朝的方向获得速度加成"
		"正在寻找。"
		""
		"&c⚠ 警告：请勿在室内使用。"
	]
	quest.425A0A28D31DC15F.quest_desc: [
		"远程收集器非常适合在游戏中的合成，它是一个可过滤的大范围物品吸尘器。"
		""
		"非常适合用于自动化原子重构器。"
	]
	quest.426730088C72437A.quest_desc: [
		"也许吃掉它并不是最好的方法。要把它抽了吗？"
		"&n                                                  &r"
		""
		"将恶魔之梦果实扔在地上，然后用打火石和钢点燃它。"
		""
		"&a🛈 提示：在灵魂沙上燃烧以产生火焰"
		"&a    永远不会熄灭的灯！"
	]
	quest.426730088C72437A.title: "灵魂之火"
	quest.42F410023D62E6CB.quest_desc: [
		"天然油可以生产出许多合成油无法获得的副产品。"
		""
		"搭建一两个石油钻井平台将为我们开启获取这些材料的大门，从而能继续向更先进的科技迈进。"
		""
		"与采石场类似，石油钻井平台消耗钻头来生产其产物。"
		""
		"&a🛈 提示：先放置控制器方块，然后"
		"&a    手持扳手或撬棍即可查看"
		"&a    结构或有效位置用于"
		"&a    孵化口。"
		""
		"&c⚠ 警告：如果以下情况发生，产出将被作废"
		"&c    孵化槽数量不足"
		"&c    可以接收物品了！"
	]
	quest.4333255C930D2BE0.quest_desc: [
		"化学储罐有多种尺寸，用于储存Mekanism的气体和其他化学物质。"
		""
		"它们具备自动输入输出的能力，并能清除多余的部分。"
	]
	quest.433DD2ED590790F8.quest_desc: [
		"用于混合混凝土、药水和其他材料，搅拌机是任何工厂的重要组成部分。"
		"&n"
		""
		"建造此结构的指南可在工程师手册中找到。"
		""
		"或者，查看来自 Create 的 Schematic Table 或 \",{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://blockprints.io/user/MuteTiefling\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"BlockPrints\",\"underlined\":true},\" 以获取更好的建造指南。\"]"
		""
		"&a🛈 提示：工程师手册高亮显示"
		"&a    在&c红色&r&a中的形成方块。"
	]
	quest.434D90BB00EE7F7C.quest_desc: [
		"Tier Installer之后，Upgrade Card是增强机器的最佳方式。可以通过潜行右键将它们安装到机器上。或者，打开GUI，直接在Upgrade窗口中插入它们。"
		""
		"• 能量升级会提高"
		"机器可以储存的能量的数量"
		"按住并降低操作频率，同时减少消耗"
		"成本，使机器效率更高。"
		""
		"• 速度升级能让机器运行得更快"
		"以便更快地运作。它们还"
		"增加能量消耗。"
		""
		"• 消音升级会减少音量"
		"机器发出的噪音，以防你万一需要"
		"对他们来说可能有点刺耳了。"
		""
		"其他升级也存在，但仅用于少数机器。它们会在涉及这些机器的任务中被提及。"
		""
		"&6⚠ 注意：带有速度升级的机器"
		"&6    但没有能源升级可能无法"
		"&6    完全无法运作！"
	]
	quest.434D90BB00EE7F7C.title: "升级卡牌"
	quest.4355BA27014040F6.quest_desc: [
		"占卜杖可用于定位特定矿石。某些材料，如远古残骸，可能需要更高级的占卜杖。"
		""
		"例如，潜行右击玻璃占卜棒到铁矿石块上，即可将其调谐至铁矿石。使用此棒将有助于定位更多矿石块。"
		""
		"右键并长按以定位新方块。这会消耗一些耐久度。"
		""
		"快速右键即可免费重新指向之前找到的方块。"
		""
		"&a🛈 提示：鱼竿可以重新调谐到一个"
		"&a    随时可以添加新材料。"
	]
	quest.441562EC913D1043.quest_desc: [
		"冲击模块会使接触该区域的生物受到伤害。"
		""
		"用这个来包裹生物生成器以杀死所有生成的生物，或者简单地做一个能伤害站在上面的任何东西的地板。"
	]
	quest.441562EC913D1043.title: "生物群系刷怪塔"
	quest.4421EB35235888DF.quest_desc: [
		"欢迎来到自然光环！Welcome to Nature's Aura!"
		""
		"免费书籍送给你！此部分内容仍在建设中！"
	]
	quest.4421EB35235888DF.title: "自然的气息"
	quest.4457D6BB7AE28073.quest_desc: [
		"该模组不提供任何形式的能量导管，但它提供了次优方案：无线能量传输。"
		""
		"能量传输器可用于为小范围内的所有方块供电。使用渲染区域按钮，将工作区对齐以覆盖你的机器。"
	]
	quest.44BD4C393C59F1CB.quest_desc: [
		"探索系列任务旨在展示整合包中有哪些可用内容。"
		""
		"如果你是模组Minecraft的新手，或者需要一些灵感，这些章节是很好的起点。"
	]
	quest.44BD4C393C59F1CB.title: "发现 Enigmatica 整合包"
	quest.45035128A978E189.quest_desc: ["还有精神共鸣宝石（Plus Spirit Attuned Gems）"]
	quest.45035128A978E189.title: "塞维拉的永久监禁"
	quest.4510A825D259CA86.title: "阿布拉的开放命令召唤术"
	quest.45121907B7F8DFD1.quest_desc: ["简单的电源线，用于将能量从一个地方传输到另一个地方。"]
	quest.4537806144939A6B.quest_desc: [
		"会动的紫水晶块，这些哥布林会自动生成、生长和收获出芽的方块。"
		""
		"将它们绑定到一个物品栏，以设置其工作区域。附近的方块将被转换为萌芽方块。当它们长出芽时，会将其打破并收集掉落物，存储到绑定的物品栏中。"
		""
		"&a🛈 提示：紫水晶傀儡可与以下模组兼容："
		"&a   还有 Certus Quartz 呢！"
	]
	quest.45754B11F5C290D5.quest_desc: [
		"外出时，要留意一些非常特别的材料，例如 &7Inks&r、&7Arcane Essence&r、&7Runes&r，甚至还有新的 &7Spell Scrolls&r！"
		""
		"这些也可能从某些生物身上获得，所以如果你想建造一个生物农场，可能需要想办法加入亡灵法师、邪教徒等模组中的生物。"
	]
	quest.45754B11F5C290D5.title: "基本资源"
	quest.45896B61EC465279.quest_desc: [
		"虽然花粉对季节性过敏者来说是个麻烦，但它很有用。把它用在大小花朵上，附近就会生成更多同种花朵。"
		""
		"如果蘑菇生长条件良好，它还会强制附近的蘑菇菌块长出更多蘑菇。建议在蘑菇菌块或腐殖土上尝试。"
		""
		"此互动适用于多种生物，快来实验看看还能发现什么吧！"
		"&n                                                  &r"
		""
		"需要更多这种金色的绒毛吗？"
		""
		"右键点击被授粉的蜜蜂，并使用水桶、水瓶或湿海绵，即可获取其背上的花粉。或许可以考虑用 Just Dire Things 建造一个小农场，完全自动化这个过程！"
	]
	quest.45B1C10885F542A7.quest_desc: [
		"物品存储单元可以存放任何类型的物品。你可能需要不少这样的单元来存放所有东西。"
		""
		"从小处着手，你总能升级到更大的单元格！"
	]
	quest.45D91E57A507473D.title: "阿布拉的指令召唤术"
	quest.4613FE560EAC7695.quest_desc: [
		"将净化血液与填充的质粒在质粒注射器中结合，以在血液样本中设置该特性。"
		""
		"如果你喜欢，可以将多个特性注入到同一个样本中。"
		""
		"对你的强化血样满意后，就该把它注射到生物体内了。"
		""
		"[\"生物可能有很多特性，但并非全部。如有疑问，请参阅 \",{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://github.com/aaronhowser1/Genetics-Resequenced/wiki/3.-Gene-List\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"Wiki\",\"underlined\":true},\"。\"]"
		""
		"&6⚠ 注意：某些特性有前置条件"
		"&6    如果不满足，将导致任务的"
		"&6    注入失败。请参阅 EMI。"
	]
	quest.46195E73798357D2.quest_desc: [
		"黑暗储罐具有极高的存储密度潜力。"
		""
		"每次合成两个，总容量会合并在一起。"
	]
	quest.465D195EA5630857.quest_desc: [
		"使用 Ars Nouveau 的 Storage Lectern，你可以轻松地将多个物品栏连接起来，拥有一个集中的存储和合成界面。"
		""
		"请务必查看《磨损的笔记本》以了解有关此系统的更多信息！"
	]
	quest.4660608EBEE31784.quest_desc: [
		"从女王处获得的特殊交易，Windy Air 可用于创造上升气流，将你托起。将它们堆叠起来，可以制成绝佳的电梯。"
		""
		"Windy Air 仅在手持物品时可见。否则，只有微弱的粒子效果能标示出放置位置。"
		""
		"&a🛈 提示：Windy Air 也可以用于"
		"&a    横向移动！"
	]
	quest.4685E3B748A76726.quest_desc: [
		"和压缩机类似，青铜搅拌机也能提高效率，让你每次制作获得的青铜粉尘比手动操作更多。考虑到这里到处都需要青铜，这可是一项很实用的提升。"
		""
		"&a🛈 提示：右键点击许多青铜级物品"
		"&a    使用火药的机器会短暂地"
		"&a    加快它们的速度。"
	]
	quest.4689338CF3688902.quest_desc: [
		"找到资源节点后，你需要在现场建造一台挖掘机来开采矿石。"
		""
		"资源节点在 &6Enigmatica 10&r 中得到了增强。因此，每个节点都能为你提供相当长的使用周期。"
		"&n"
		""
		"建造此结构的指南可在工程师手册中找到。"
		""
		"或者，查看来自 Create 的 Schematic Table 或 \",{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://blockprints.io/user/MuteTiefling\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"BlockPrints\",\"underlined\":true},\" 以获取更好的建造指南。\"]"
		""
		"&a🛈 Tip: The Engineer’s Manual highlights "
		"&a    在&c红色&r&a中的形成方块。"
		""
		"&6⚠ 注意：该结构将接受"
		"&6    任意钢制方块。"
	]
	quest.471571E3E382B404.quest_desc: [
		"窗帘是装饰家园的绝佳方式，但它们的功能性也不容小觑！"
		""
		"作为门放置时，它们会阻止蜜蜂穿过。"
		""
		"试着把它们用作蜂箱的入口，方便进出。"
		""
		"&a🛈 提示：右键点击窗帘，使用"
		"&a    向下延伸的字符串。"
	]
	quest.471735A69C5C3339.quest_desc: [
		"Refinery 是一种用于混合和精炼流体的先进机器，可用于制作燃料和高级材料。"
		""
		"注意，本机器使用的物品输入物是催化剂，不会被消耗。它们只能手动放入或取出，因此你可能需要多个精炼器。"
		"&n"
		""
		"建造此结构的指南可在工程师手册中找到。"
		""
		"或者，查看来自 Create 的 Schematic Table 或 \",{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://blockprints.io/user/MuteTiefling\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"BlockPrints\",\"underlined\":true},\" 以获取更好的建造指南。\"]"
		""
		"&a🛈 提示：工程师手册高亮显示"
		"&a    在&c红色&r&a中的形成方块。"
	]
	quest.472936F50BC28EBF.quest_desc: [
		"Sophisticated Storage 提供多种符合需求的物品栏，所有物品栏都可通过 Storage Controller 连接，实现网络内所有物品的集中访问。"
		""
		"Storage Tool 用于选择 Controller，然后将不同的物品栏与其绑定。这样可以在有限范围内实现无线连接。"
		""
		"无法手动访问 Storage Controller，所以你最好搭配其他能访问物品的模组。Ad Hoc AE2 网络、Pretty Pipes 或 Ars nouveau Storage Lectern 都是绝佳选择。"
	]
	quest.472936F50BC28EBF.title: "Sophisticated Storage"
	quest.47C5F9198615E0D5.quest_desc: [
		"风车是沉浸式工程中最早期的动力形式。"
		""
		"只需将动能发电机放置在开阔处，并在正面安装风车，即可开始产生基础电力。"
	]
	quest.4800EBB1FB34B26C.quest_desc: [
		"没有蒸汽的工厂，那还能叫工厂吗？"
		""
		"用锻造锤合成很快就会让人厌倦，所以让我们专注于搭建一些机器来简化操作。"
		"&n"
		""
		"在模组早期阶段，蒸汽动力将被广泛使用，我们将从一个简陋的青铜锅炉开始，很快就能升级到更强大、更优质的选项。"
		""
		"将青铜水泵放置在水源方块旁，越多越好。然后将青铜锅炉放在旁边。用管道连接两者，以保持锅炉有水供应。"
		""
		"&a🛈 提示：锅炉会自动推动物品"
		"&a    蒸汽会扩散到相邻的方块上。"
	]
	quest.4800EBB1FB34B26C.title: "蒸汽动力"
	quest.48198EAAB356C92C.quest_desc: [
		"热蒸发厂对于生成卤水和锂至关重要，这两种物质都用于高级材料加工。"
		""
		"该结构需要热量才能运行。可以在顶部角落放置高级太阳能发电机以实现被动运行。热量也可以通过管道从其他来源（如电阻加热器）输送至阀门。"
		"&n                                                 &r"
		""
		"塔本身是一个巨大的自由形态的多方块结构。"
		""
		"【放置规则和最大尺寸限制，请访问他们的维基页面了解更多信息：】{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://wiki.aidancbrady.com/wiki/Thermal_Evaporation_Plant\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"Thermal Evaporation Plant\",\"underlined\":true}]"
		""
		"&a🛈 提示：E10 包含一个 Mekanism 多用途"
		"&a    EMI 中的区块规划器！"
		""
		"&c⚠ 警告：裂变反应堆将"
		"&c    冷却不当就会爆炸！"
	]
	quest.48271478CA0D3F6B.quest_desc: [
		"我们提到了血，对吧？嗯，你需要大量的血才行。"
		""
		"目前需要手动收集，不过之后会有自动化方法可用。"
		""
		"方法很简单：制作一个血液提取器，并在杀戮过程中将其保持在物品栏中。每次击杀都会让它慢慢充满血液。"
		""
		"&a🛈 Tip: The capacity of the Blood "
		"&a    提取器可以增加至"
		"&a    用另一个提取器来制作它"
		"&a    或者一辆暗色坦克。"
	]
	quest.48271478CA0D3F6B.title: "血液"
	quest.4840F7361DF70516.quest_desc: [
		"QIO 系统是一个基于量子纠缠传送器技术建造的巨型存储和路由系统。本质上，它就是一个超大的箱子。"
		""
		"可以通过 QIO 控制面板远程访问该系统，以手动合成或仅访问材料。"
		""
		"QIO进出口商可以与相同的存储接口交互，充当无线管道，将材料送去加工或进口成品。"
		""
		"搭配 QIO 红石适配器，可用于储存各种产品。"
	]
	quest.4840F7361DF70516.title: "QIO 系统"
	quest.486FDAA44AED23C4.quest_desc: [
		"精炼炉由控制器和最多四个堆叠在其上的输出端口组成，是生产塑料、润滑剂和液体燃料的核心。"
		""
		"精炼炉使用热量而非空气，不过你可能需要涡流管来制造热量以使其运行，因为它需要非常高的温度。"
		""
		"你也可以在沙漠或下界等炎热生物群系中设置，以利用环境热量，这样会更方便。"
		""
		"&a🛈 提示：查看热管用途，见"
		"&a    热源列表的EMI。"
	]
	quest.486FDAA44AED23C4.title: "精炼厂"
	quest.487C1E9850772F38.quest_desc: [
		"此时，你可能感到有些炎热，注意到你的锅炉跟不上了。建造更多是一个选择，但从长远来看，定期升级基础设施会更高效。"
		""
		"为每个青铜机器制作升级套件，并通过潜行右键安装；无需拾起机器即可升级！"
		""
		"舱门也应升级为钢制。在多方块结构中安装至少一个钢制舱门，即可将其等级提升至钢制。升级舱门时必须将其拾起。"
		""
		"&a🛈 提示：钢制机器运行速度更快"
		"&a    比它们的青铜对应物更强大。"
	]
	quest.487C1E9850772F38.title: "钢铁升级模组"
	quest.48B6E6CDBFFD77A7.quest_desc: [
		"符文可以被赋予强大的效果，穿戴时会激活。但装备它们需要合适的容器。"
		"&n"
		""
		"先制作一个符文胸针。装备后，你就可以装备两个自己选择的符文了。"
		""
		"符文本身是在符文工作台制作的。只需将中央配方物品拖到工作台上，再放上所需的灵魂即可。"
	]
	quest.48B6E6CDBFFD77A7.title: "符文锻造术（Runeworking）"
	quest.48F3D3784D8CE545.quest_desc: [
		"植物采集机和植物播种机是两款相辅相成的机器。"
		"默认情况下，植物收集器收割作物时会将其破坏，留下一个空地块。因此，播种机需要配合使用，以重新种植这些地块并保持整个系统的运行。"
		""
		"你需要把采集者放在田地的边缘，而播种者则放在田地中心的地底。"
		""
		"请务必在它们的GUI中勾选“显示工作区”按钮，以了解它们将在何处运行。"
		""
		"有了+4范围附加组件，这些机器就能在一个标准的9x9农田上工作了。"
		""
		"&a🛈 提示：给采集者提供以太气体"
		"&a    将允许它无需任何辅助即可进行收割"
		"&a    破坏农作物。"
	]
	quest.48F3D3784D8CE545.title: "作物种植"
	quest.48F901DB80482CAA.quest_desc: [
		"最基本的炼金术操作涉及材料的提纯。在熔炉中单纯冶炼矿石时，部分材料无法被回收，因为它们被熔炉无法分解的矿物所包裹。"
		""
		"炼金术士们通过一个三步流程解决了这个问题："
		"• 液化现象"
		"• 蒸馏"
		"• 煅烧"
		""
		"每个步骤以及它们如何结合，都将在接下来的任务中讨论。"
	]
	quest.48F901DB80482CAA.title: "矿石加工"
	quest.4914692B607F8BE0.quest_desc: [
		"末地源容器非常适合跨维度源物质运输。"
		""
		"所以，如果你在末地设置了疯狂的生物生成器，或许可以考虑用这个和 Vitalic Sourcelink 把所有美味的 Source 带回来。"
	]
	quest.492DA63DEC9663F2.quest_desc: [
		"结合你的黑暗力量，你终于能制作出血液注入器了。"
		""
		"这样之前的流程会干净一点，而且便宜得多。"
	]
	quest.49878D1219A63A4E.quest_desc: [
		"又一个太阳能电池板。它在白天产生电力，搭配能量立方或其他储能设备效果最佳。"
		""
		"&a🛈 提示：需要清晰的天空视野。"
	]
	quest.49958725A4710861.quest_desc: [
		"机械泥土是开始刷怪的好方法。在黑暗区域提供液态肉和能量，它就会快速生成适合当前生物群系的敌对生物。"
		""
		"与 Mob Slaughter Factory 结合使用时，它能轻松生产出足够的 Liquid Meat 来维持自身运转，甚至还有富余来驱动 Mob Crusher 的 Mechanical Dirt，从而让你能非常有效地刷怪掉落物。"
		""
		"该机器会组成一个粗略的多方块结构，并自动与相邻的任何机械泥土方块共享能量和液态肉。"
		""
		"&a🛈 提示：抑制方尖碑会阻止任何"
		"&a    生成在容器内的末影人"
		"&a    你的农场。"
	]
	quest.49958725A4710861.title: "怪物养殖系统"
	quest.4A020E61A5551F51.quest_desc: ["LV 机械的入门首选，制作偏振器应是你的下一个优先事项，这样能降低电机的制作成本。"]
	quest.4A05A84FBF5CCD21.quest_desc: [
		"欢迎来到机械动力模组！"
		""
		"在这里，我们将探索如何从最初的机器到聚变反应堆，一步步推进Mekanism的进程。"
		""
		"【Mekanism 没有内置手册，但它有非常实用且信息丰富的成就（\",{\"color\":\"gold\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"成就键\"}]},\"keybind\":\"key.advancements\"},）可以帮助你上手。】"
		""
		"记得查看他们的在线 Wiki，这是一个绝佳的知识来源，特别是关于他们的多方块结构。\"]"
	]
	quest.4A05A84FBF5CCD21.title: "Mekanism"
	quest.4A60707DB5548805.title: "奥菲克斯的召唤"
	quest.4A80ADB324E4A6CA.quest_desc: [
		"有了金属压模，制作金属棒、板、线和齿轮会简单得多，所以尽快设置一个来辅助你的制作吧。"
		""
		"最好为每种工艺都设置一个，因为 Press Mold 只能手动更换。"
		"&n"
		""
		"建造此结构的指南可在工程师手册中找到。"
		""
		"或者，查看来自 Create 的 Schematic Table 或 \",{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://blockprints.io/user/MuteTiefling\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"BlockPrints\",\"underlined\":true},\" 以获取更好的建造指南。\"]"
		""
		"&a🛈 Tip: The Engineer’s Manual highlights "
		"&a    在&c红色&r&a中的形成方块。"
	]
	quest.4A8EF3D657CEAED5.quest_desc: [
		"这么多电池看起来挺贵的。没有蒸汽采石场的铅和锑，你可能又得手动挖矿了，对吧？"
		""
		"电动采石场正是解决这个问题的答案。"
		""
		"借助它，铅、锑、铝土矿和各种宝石等更高级的材料都可以被自动收集。与蒸汽采石场一样，操作结果取决于安装的钻头。电动采石场除了其他钻头外，也可以使用蒸汽采石场的青铜和铜钻头，尤其是金和钢钻头。"
		""
		"升级到电力模式，只需更换控制器方块，并将蒸汽舱换成LV舱即可。"
		""
		"&a🛈 Tip: Place the controller block, then "
		"&a    手持扳手或撬棍即可查看"
		"&a    结构或有效位置用于"
		"&a    孵化口。"
		""
		"&c⚠ 警告：如果以下情况发生，产出将被作废"
		"&c    孵化槽数量不足"
		"&c    可以接收物品了！"
	]
	quest.4AA912FDACFC1654.quest_desc: [
		"接下来，我们需要消化材料。升级到更高等级时，还需要加入纯化金。配方请参见EMI。"
		""
		"消化槽的工作方式与发酵槽完全相同，同样可以用红石进行自动化。请参考指南手册中的示例。"
		""
		"我们此处的最终目标是稀有金属硝石。"
	]
	quest.4ACCED64D436209E.quest_desc: [
		"目前，获取暗宝石的过程非常混乱和血腥。"
		""
		"在地上倒出五桶血，然后扔进一颗暗宝石。"
		""
		"这个过程需要快一点，因为血液会慢慢凝固成硬化血液。别担心，如果发生了，只需一拳就能把它重新打回液体状态。"
		""
		"&a🛈 Tip: Right-Click a Blood Extractor on "
		"&a    将桶倒空到地面上。"
	]
	quest.4B0E34ADA419D750.quest_desc: ["借助发酵桶可以获得精炼菜籽油。这能极大地提升油的品质，使其产生更多的能量。"]
	quest.4B35B8DACEE56913.quest_desc: [
		"生物识别器与身份卡配合使用，以特定频率授予玩家权限。这可以让他们穿过力场，或不受拦截矩阵的影响。"
		""
		"&6⚠ 注意：MFFS机器已关闭，原因是"
		"&6    默认。要么提供一个红石"
		"&6    信号或点击火把按钮在"
		"&6    界面。"
	]
	quest.4B66ECA9D6797B80.quest_desc: [
		"存储部分涵盖了有助于存放各种物品的物品或模组。"
		""
		"从流体、物品到集中式存储系统，你都能在这里找到！"
	]
	quest.4B66ECA9D6797B80.title: "储物空间"
	quest.4C2A04C8A81DE383.quest_desc: [
		"电池主要用于个人储能，以增加你所使用的任何基于FE的设备的有效容量。"
		""
		"它们也可以被放入末影单元中以增加其容量。"
	]
	quest.4C46DBD26BE50BCD.quest_desc: [
		"Aura Field Creators 是一对强大的破块器，能破坏它们之间的所有方块。"
		""
		"将工具放置在其中一个创作者的物品框架上，即可为其附加该工具的丝绸之触、时运或其他特殊挖掘属性。"
	]
	quest.4C5D3AE08ACA9836.quest_desc: [
		"去下界溜达一圈，就能拿到升级魔法书所需的一切了。"
		""
		"这将为你解锁 Tier 2 的符文，并为法术开启一些狂野的可能性。"
		""
		"&6&n示例法术&r"
		""
		"&7霜冻&r"
		"&5触摸&r > &a冻结&r > &a急速冷冻 x2&r > &6增幅&r"
		"> &a延迟&r > &a严寒&r > &6增幅&r"
		"     "
		""
		"&6⚠ Note: Any spells you’ve crafted will be "
		"&6    升级时会向前转移。"
	]
	quest.4C745779C30B48A6.quest_desc: [
		"用液化坩埚，我们将用溶剂氯化铵将矿石溶解成纯化的硫磺。"
		"&n                                                  &r"
		""
		"将液化坩埚置于火焰祭坛之上。物品可右键放入坩埚，或通过任何物品物流系统送入。"
		""
		"Pyromantic Brazier 主要燃烧熔炉燃料，提供方式也相同。"
	]
	quest.4C7D7FC6EEB07515.quest_desc: [
		"木桶只能存放一种物品，但可以存放巨量的物品。"
		""
		"这些非常适合在 Modern Industrialization 中缓冲机器间的物品，或者连接到 Applied Energistics 来存放你囤积的所有铜锭。"
	]
	quest.4C7D7FC6EEB07515.title: "木桶"
	quest.4CB21D6351486281.quest_desc: [
		"催化剂可以安装在自然祭坛上，以修改其可处理的配方。"
		""
		"将它们放置在祭坛的短石柱上即可使用。"
		""
		"&6⚠ 注意：带有催化剂的祭坛可以"
		"&6    如果它们存在，仍然处理基础配方"
		"&6    不要冲突。"
	]
	quest.4CB37C07E76303A6.quest_desc: [
		"制作Implosion Compressor需要一种新合金，Blastproof Alloy。机器建成后，可以简化流程。但现在，你还需要用笨办法。"
		""
		"钛和不锈钢现在应该不成问题，但钨会是个问题。"
		""
		"目前，获取它最好的方法是通过原矿：将Tiny Tungsten Dust放入Electric Compressor中压缩，可获得Tungsten Nuggets。然后用它们合成你需要的Ingot。"
		""
		"&a🛈 提示：先放置控制器方块，然后"
		"&a    手持扳手或撬棍即可查看"
		"&a    结构或有效位置用于"
		"&a    孵化口。"
	]
	quest.4CE65730937AB775.quest_desc: [
		"仪式祭坛开启了无数可能，例如永久区域效果、形态转换、时间调整等。"
		""
		"在这些平板电脑中，你几乎肯定能找到有用的东西，但这里有几个亮点："
		""
		"• 创意飞行广阔区域"
		"• 定位特定结构"
		"• 作物生长速度加快"
		"• 自动作物收割"
		"• 天气塑造"
		"• 时间操控"
		""
		"&a🛈 提示：查看平板电脑的提示以获取"
		"&a    更多信息！"
	]
	quest.4CE65730937AB775.title: "仪式魔法"
	quest.4CE66DC7BB1AC84B.quest_desc: [
		"等离子涡轮机用于将聚变反应堆产生的氦等离子体转化为有用的EU。"
		""
		"&a🛈 提示：先放置控制器方块，然后"
		"&a    手持扳手或撬棍即可查看"
		"&a    结构或有效放置位置"
		"&a    孵化口。"
	]
	quest.4D1EE65F80F50090.quest_desc: [
		"改革源基座用于放置我们的输入材料，目前是硫磺青金石。"
		""
		"请仔细查看 EMI 中的配方。某些配方可能需要多达八个源基座。"
		""
		"对于这个，我们只需要一个就够了。"
		"&n                                                  &r"
		""
		"将源基座放置在工作区，并用蓝石硫磺右键点击它。"
		""
		"&a🛈 提示：可以投入更多的硫磺，这样会产出更多物品。"
		"&a    provided through any form of "
		"&a    物流，例如 Mercurial"
		"&a    物品节点！"
	]
	quest.4DA846036F3B01C3.title: "斯特吉奥的更高束缚"
	quest.4DE1B1045507C72C.quest_desc: [
		"除了是实用的合成材料外，暗棒还能指引玩家前往一种特殊建筑——暗庙。"
		""
		"在地上扔一根木棍，观察白色末端指向的方向。沿着那个方向走，直到找到一个顶部有信标亮着的平台。"
		""
		"找到结构后，爬到顶部，找到环境蓄能器。该装置能让你利用当地天气和群系模式为物品充能。"
	]
	quest.4DE1B1045507C72C.title: "黑暗神殿"
	quest.4E175A06927C3A75.quest_desc: [
		"充电站是为气动工具和装备补充空气的便捷方式。"
		""
		"你还可以修改装备，例如安装速度和音量升级组件。"
		""
		"最后，也是可能最重要的，充电站是压力机制的工作台。"
		""
		"这些村民能卖很多实用的东西，包括能大幅加快你模组之旅的成品PCB。"
		""
		"&a🛈 提示：分配器升级可以让"
		"&a    用于为实体充能的充电站"
		"&a    站在它的上面。这可以是"
		"&a    用于为无人机充电或用于"
		"&a    一次性为所有装备充能！"
	]
	quest.4E2C382FC583C03F.quest_desc: [
		"离心机可以生产一些独特的材料，这些材料在未来会非常重要！"
		""
		"该机器可选地与流体配合使用。为此，您需要附加一个 Machine Fluid Addon。"
	]
	quest.4E7DA28C54FB8766.quest_desc: [
		"单独探索的话，找到这些材料通常需要花费大量时间。"
		""
		"在灵魂朋友的帮助下，它们可以直接被带到我们身边！"
		""
		"&6⚠ 注意：这些仪式通常需要"
		"&6    献祭。触发仪式，作为"
		"&6    如常，然后杀死指定的生物"
		"&6    五芒星附近。"
	]
	quest.4E7DA28C54FB8766.title: "史诗材料"
	quest.4E84D317021F7881.quest_desc: [
		"厌倦了下雨吗？Cloudshifter 可以快速驱散云层。"
		""
		"或者，如果你真的很需要下雨或雷暴，在给定合适物品的情况下，它也能做到。"
		""
		"更多信息请参阅自然光环之书。"
	]
	quest.4EAB5A6CCD5CFEFB.quest_desc: [
		"你肯定想自动化工程师工作台里那些重复的配方。有了自动化工作台，你就能做到这一点。"
		""
		"这台机器可以编程来执行工程师工作台上的任何配方。每台机器一次只能执行一个配方，因此你需要多台机器来覆盖所有你想制作的配方。"
		"&n"
		""
		"建造此结构的指南可在工程师手册中找到。"
		""
		"或者，查看来自 Create 的 Schematic Table 或 \",{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://blockprints.io/user/MuteTiefling\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"BlockPrints\",\"underlined\":true},\" 以获取更好的建造指南。\"]"
		""
		"&a🛈 提示：工程师手册高亮显示"
		"&a    在&c红色&r&a中的形成方块。"
	]
	quest.4EB2FB91070CD11F.quest_desc: [
		"电弧炉比合金熔炉能更轻松地制作合金，支持自动化输入输出。"
		""
		"该装置需要石墨电极才能运行，且必须手动插入，但一套电极可支持数万次制作。"
		"&n"
		""
		"建造此结构的指南可在工程师手册中找到。"
		""
		"或者，查看来自 Create 的 Schematic Table 或 \",{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://blockprints.io/user/MuteTiefling\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"BlockPrints\",\"underlined\":true},\" 以获取更好的建造指南。\"]"
		""
		"&a🛈 提示：工程师手册高亮显示"
		"&a    在&c红色&r&a中的形成方块。"
		""
		"&6⚠ 注意：该结构将接受"
		"&6    任意钢制方块。"
	]
	quest.4EC7DD1B35F0B6B5.quest_desc: ["化学反应釜为我们开启了化学工程和全新的高级加工世界的大门，让我们为高压电力和材料科学做好准备。"]
	quest.4F127FD7A683F3BE.quest_desc: ["添加蜂蜜交易，从女王那里获取一些物品"]
	quest.4F19A0AECC129216.quest_desc: [
		"原子熔炉是一种使用末地激光运行的先进合成装置。"
		""
		"在附近设置一些激光，并用目标指示器将它们连接到锻造炉。"
	]
	quest.4F480CF26AB0F3CD.quest_desc: [
		"正如“坚韧的承诺”能开启更强大的功能一样，这些承诺也能以独特的方式增强机器。"
		""
		"Tier 1 时，你只能选择其一。考虑到血液采集仍是手动操作，生产力模组目前看起来相当不错！"
		""
		"• &7Velocity&r – 加快合成速度。"
		"• &7生产力&r – 降低血液消耗的几率。"
	]
	quest.4F480CF26AB0F3CD.title: "机器升级"
	quest.4F5E591110C0A372.quest_desc: ["LaserIO 的化学卡允许激光节点传输 Mekanism 气体和化学品。"]
	quest.4FDF4919248BFC3A.quest_desc: [
		"欢迎来到 Replication，一款科幻风格的科技模组，可将物品分解为组件，再重组为更实用的材料。"
		""
		"以下任务将帮助你理解所有组件如何协同工作。"
	]
	quest.4FDF4919248BFC3A.title: "复制品制作指南"
	quest.4FEA49AD05720ED7.quest_desc: [
		"啊，在户外用粉笔玩耍的简单乐趣。"
		""
		"Arts and Crafts 让你可以制作画笔，快速重涂羊毛、陶瓦或模组添加的众多方块的颜色。"
		""
		"&a🛈 提示：在 EMI 中搜索 &3@arts&r &a以查找"
		"&a    探索更多未知。"
	]
	quest.4FEA49AD05720ED7.title: "艺术与手工艺"
	quest.4FF50048D23DC1A3.quest_desc: [
		"禁制矩阵用于对其影响范围内的任何事物施加限制。"
		""
		"这包括保护方块不被放置、破坏或访问，以及直接杀死不受欢迎的入侵者或阻止生物生成。"
		""
		"&6⚠ 注意：MFFS机器已关闭，原因是"
		"&6    默认。要么提供一个红石"
		"&6    信号或点击火把按钮在"
		"&6    界面。"
	]
	quest.5009BB4B0D1B459E.quest_desc: [
		"漏斗增强器放置在漏斗顶部，使其能拾取最远七个方块内的物品。"
		""
		"与 Adept Hopper 配合使用时，可以筛选特定物品。"
	]
	quest.503E9805EC687D70.title: "Eziveus的幽魂强迫症"
	quest.5047A6F1EF472407.quest_desc: ["以下都是可以存放比普通箱子更多内容的大型储物单元。"]
	quest.5047A6F1EF472407.title: "批量物品存储系统"
	quest.5078D0CBD8AB602E.quest_desc: [
		"你已正式抵达现代工业化之旅的终点。恭喜你！"
		""
		"有了复制器，你现在可以随心所欲地复制几乎所有你想要的东西。"
		""
		"然而，运行它并非易事，因为它所依赖的 UU 物质极其昂贵。"
	]
	quest.5089FD9AEDB1D3D0.quest_desc: [
		"找不到陨石而感到困扰吗？"
		""
		"Fluix研究员村民也可以为你提供开始使用Applied Energistics所需的一切。他们使用充电器作为工作站。"
		""
		"专家等级下他们只会卖两种随机的 Press，所以要做好交易准备才能全部拿到。"
	]
	quest.5089FD9AEDB1D3D0.title: "Fluix研究人员"
	quest.50BCEB07C736B906.quest_desc: [
		"力场投影仪，顾名思义，能做的远不止于此，具体取决于所安装的模组。最简单的用法是筑起一堵墙来阻止通行。但它也能用来伤害生物、清除方块和流体，或者放置方块。"
		""
		"&6⚠ 注意：MFFS机器已关闭，原因是"
		"&6    默认。要么提供一个红石"
		"&6    信号或点击火把按钮在"
		"&6    界面。"
	]
	quest.51233852CD921F79.quest_desc: [
		"驱动器是一种紧凑型存储设备，可容纳数万个物品。"
		""
		"单个驱动器最多可包含 10 个存储单元，每个单元都有自己的容量和限制。"
		""
		"也可以在细胞工作台过滤细胞，从而精确指定要存储在该细胞上的材料。"
	]
	quest.516EF5AA0B699CBF.quest_desc: [
		"Fortron电容器有两个用途：储存和传输能量。"
		""
		"• 缩放模块允许电容器进行"
		"发送到更远的机器中。"
		""
		"• 容量模块会提升它们的"
		"存储容量。"
		""
		"• 速度模块会提升它们的"
		"传输速率。"
		""
		""
		"&6⚠ 注意：MFFS机器已关闭，原因是"
		"&6    默认。要么提供一个红石"
		"&6    信号或点击火把按钮在"
		"&6    界面。"
	]
	quest.51AF97CE4E91A2D9.quest_desc: [
		"开始使用沉浸式工程需要几台关键机器和资源，其中最重要的或许是焦炭炉。"
		""
		"用这台机器生产的焦煤焦油和焦油沥青对后续事业至关重要。"
		"&n"
		""
		"这个结构非常简单，由一个 3x3x3 的焦炭砖立方体组成。"
		""
		"IE 的多重方块总是通过右键点击结构方块并使用工程师之锤来建造的。"
		""
		"此时，右键点击结构任意一侧的中心方块即可。"
		""
		"&a🛈 Tip: The Engineer’s Manual highlights "
		"&a    在&c红色&r&a中的形成方块。"
	]
	quest.51F25D35F62B37BA.quest_desc: [
		"Mercurial Logistics 系统是一个用于移动物品和流体的简单网络。"
		""
		"放置器与提取器可以放置在机器或其他物品栏旁，然后用水星铜线连接起来。"
		""
		"水银连接节点允许多条导线汇聚成更广泛的网络，并延长单根导线的覆盖范围。"
	]
	quest.51F25D35F62B37BA.title: "Mercurial Logistics"
	quest.5203EDBBACDBA86A.quest_desc: [
		"部分工具和方块需要能量才能运行。虽然它们支持任何Forge能量，但该模组也包含一些发电机来满足此需求。"
		""
		"煤炭发电机可以燃烧任何熔炉燃料，但使用模组中的煤炭效果最佳，因为它们能量密度很高。更高级别的煤炭不仅能量价值更高，每秒产生的能量也更多。"
		""
		"同样，燃料发电机燃烧模组自身的燃料，通常比燃烧其制成的煤炭更高效，能产生更多能量，速度也更快。"
		""
		""
		"&a🛈 提示：发电机可自动为相邻方块供电。"
	]
	quest.526BF0840C65855F.quest_desc: [
		"想提高采矿产量吗？试试用液态肉清洗你的原矿，然后发酵吧！"
		""
		"不，我是认真的！"
		""
		"流程始于清洗工厂，它需要电力、原矿石和液态肉作为输入。"
		""
		"结果会发送到发酵站，并可选地使用催化剂进行处理。加入粉红史莱姆，矿石产量可提升4倍。使用以太气体，产量可提升至5倍。"
		""
		"最后，发酵完成后，必须将液体倒入筛分机，并通过沙子过滤，为你生产出干净的金属粉尘！"
		""
		"真美味！"
	]
	quest.526BF0840C65855F.title: "矿石加工"
	quest.526FB82B8D47EAA4.quest_desc: [
		"Mekanism 的箱子是一种廉价高效的批量存储方块。它们只能存放一种物品，但容量巨大！"
		""
		"右键单击可放置物品。"
		"左键点击可提取单个物品。"
		"潜行右键可提取一整个堆叠。"
		""
		"&a🛈 提示：潜行可以锁定箱子"
		"&a    空手右键点击！"
	]
	quest.529329FE6CB3D29E.quest_desc: ["细胞可在DNA提取器中分解，以获得多汁的DNA螺旋。"]
	quest.52E79B2EB7400D13.quest_desc: [
		"终端能让你查看网络内容，并能手动与其中的物品互动。"
		""
		"合成终端也自带合成网格，所以大多数时候都是更好的选择。"
		""
		"&a🛈 提示：电缆组件无法被"
		"&a    放置在密集电缆上。"
	]
	quest.5312467FB51C5B36.quest_desc: [
		"合金熔炉是一种需要手动操作的初级机器。它能帮你制作一些必要的合金，但你应该尽快考虑更换它。"
		""
		"对于许多合金，你只需将组成金属磨成粉末并混合，即可制成可熔炼成合金的混合物。"
		"&n"
		""
		"这个结构非常简单，由一个 2x2x2 的熔炉砖立方体组成。"
		""
		"IE 的多重方块总是通过右键点击结构方块并使用工程师之锤来建造的。"
		""
		"此时，右键点击结构任意一侧的右上角方块即可。"
		""
		"&a🛈 Tip: The Engineer’s Manual highlights "
		"&a    在&c红色&r&a中的形成方块。"
	]
	quest.5362D855D207F79A.quest_desc: [
		"酿酒厂建成后，应该可以通过运行柴油发电机来抵消部分能源成本。"
		""
		"不过先别拆除你的锅炉，因为柴油生产需要蒸汽！"
	]
	quest.5386C6E2FDA6BA50.quest_desc: [
		"通用电缆、机械管道、增压管、物流运输器和热力学导管都可以通过右键点击并用相应等级的合金来原地升级。每种合金最多可升级8个相连的管道。"
		""
		"这是升级管道网络的好方法，无需担心重新配置连接或过滤器。管道内的内容也会一并保留。"
		""
		"&a🛈 提示：在...中反复右键单击"
		"&a    同一位置将升级管道"
		"&a    网络更深处！"
	]
	quest.5386C6E2FDA6BA50.title: "物流系统升级"
	quest.538CE12C982D950E.title: "斯特吉奥的更高束缚"
	quest.55065F1D9C6716C1.quest_desc: [
		"高级传感器在简易传感器的基础上进行了区域升级，使其能够与更大范围内的物体进行交互。"
		""
		"&a🛈 提示：使用渲染区域按钮来"
		"&a    轻松配置工作区域。"
	]
	quest.5521F91C980C5007.quest_desc: [
		"热交换器将很快取代真空冷冻机，用于许多需要冷却的配方。但它在我们现有发电能力的扩展中起着关键作用。"
		""
		"首先，使用增压器获取一些高压水。这个过程很慢，但高压水会在此过程中被回收。"
		""
		"接下来，HP水将被输入高压大型蒸汽锅炉；普通水无法使用。这将产生高压蒸汽。"
		""
		"现在可以将高压蒸汽和普通水输入热交换器。这将产生高压水和大量普通蒸汽来驱动涡轮机。"
		""
		"最后，生成的HP水可以循环回HP大型蒸汽锅炉。整个循环应该是无损的，所以增压器只需要在启动时使用。"
		""
		"&a🛈 Tip: Place the controller block, then "
		"&a    手持扳手或撬棍即可查看"
		"&a    结构或有效位置用于"
		"&a    孵化口。"
	]
	quest.5572D4A6842BAAFA.quest_desc: [
		"乳胶处理单元会将液态乳胶转化为橡胶。"
		""
		"运行此装置除了乳胶外，还需要水和动力。"
		""
		"获得橡胶后，你需要在熔炉中将其熔炼成塑料。"
		""
		"不过，请务必储备一些液态乳胶，因为它会直接用于许多合成配方中。"
	]
	quest.55785C260809F141.title: "Foliot 破碎机"
	quest.55AFB2B88341FAB5.quest_desc: [
		"钢在Mekanism中是一种非常重要的资源，高级机器通常使用钢制外壳。"
		""
		"记得多备点货！"
	]
	quest.5678189CDBAF373C.quest_desc: [
		"用于移动物品的基础物品管道。"
		""
		"它们有一套简单的颜色编码路由系统，可以用来确定物品的去向。"
		""
		"Mekanism机器可以原生地对物品进行颜色编码，或使用Logistical Sorter从任何物品栏中拉取物品并进行适当的颜色编码。"
		""
		"有关如何配置这些的更多信息，请参阅其维基上的以下文章："
		"[\"• \",{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://wiki.aidancbrady.com/wiki/Logistical_Transporter\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"Logistical Transporter\",\"underlined\":true}]"
		"[\"• \",{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://wiki.aidancbrady.com/wiki/Logistical_Sorter\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"Logistical Sorter\",\"underlined\":true}]"
	]
	quest.56D8B0E6FD8CF048.quest_desc: [
		"能量电池主要用于就地储能。它们最适合与不稳定的电源（如太阳能）或负载不重的慢速发电机搭配使用。"
		""
		"它们也可以被放入末影单元中以增加其容量。"
	]
	quest.56D926386FC532B2.title: "伊哈甘的魅惑 (Ihagan's Enthrallment)"
	quest.56DDD2327724F715.quest_desc: [
		"电缆有多种尺寸和颜色可供选择，以满足您的需求。"
		""
		"不同颜色的线缆无法相互连接，这意味着它们可以安全地并排铺设。而Fluix线缆则可以连接到任何其他线缆。"
		""
		"玻璃和屏蔽电缆最多支持八个通道，而密集电缆可承载全部32个通道。"
		""
		"通常，这些会从ME控制器运行，并在需要时分支出较小的电缆。"
		""
		"&a🛈 提示：电缆锚点可用于"
		"&a    防止以下方块之间的连接："
		"&a    电缆。"
	]
	quest.56DDD2327724F715.title: "电缆"
	quest.56EDBF31457D8112.quest_desc: [
		"可以用比较器读取气场探测器，以确定该区域的气场强度。"
		""
		"这通常在与发电机配合使用时最有用，让你可以根据需要开启或关闭它。"
	]
	quest.5711C54FA99AF486.title: "罗纳扎的联络人"
	quest.574555F24035E48A.quest_desc: [
		"这组方块基本上能完成名字所暗示的功能：放置和拾取方块或流体。"
		""
		"它们无法被过滤，但可以通过红石进行控制。"
		""
		"它们各自只有一个物品栏槽位，但行为略有不同。"
		""
		"方块破坏者会使用此栏位中的物品作为工具进行破坏，因此可用于自动采集富矿等。"
		""
		"放置器只会放置该物品栏槽位中的方块。"
		""
		"与此同时，流体方块在这些槽位中接受储罐，用于储存它们将要放置/收集的流体。"
	]
	quest.577377C909FF0001.quest_desc: [
		"酿酒厂将是我们进入石油精炼的入口。这台机器能为任何输入产生多种输出，必须指定要生产哪一种。"
		""
		"最简单的方法就是放置机器并打开GUI。在这里找到你想在EMI中运行的配方，然后点击+按钮来设置输入和输出过滤器。"
	]
	quest.578401B6C9DA2747.quest_desc: [
		"PCB和塑料都搞定了，接下来可以研究高压机械了。为此，我们需要建造一台高性能压缩机。"
		" "
		"所有这些压缩机都能产生20巴的压力，不过每种都有其需要克服的操作难题。"
		"&n                                                                          &r"
		""
		"[\"高级空气压缩机和高级液体压缩机都使用你一直使用的燃料，但它们需要冷却。有关冷却的逐步指南，请参阅我们的 \",{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://wiki.enigmatica.net/enigmatica6/gameplay/how-to.../pneumaticcraft-heating-and-cooling#advanced-compressors-1\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"Wiki\",\"underlined\":true},\".\"]"
		""
		"同样，Flux Compressor 会消耗你为 Mekanism 或 Modern Industrialization 等模组产生的能量。和前两者一样，它也需要冷却。"
		""
		"静电压缩机是一个很好的“设置即忘”选项，因为它无需冷却即可被动运行。它在暴风雨天气下运行最佳，但在晴朗天气下仍能输出一些空气。"
		""
		"&a🛈 提示：在 EMI 中搜索 &3#electrostatic&r &a以发现有效配方"
		"&a用于静电网格的方块。"
		""
		"最后，太阳能压缩机是被动运行的，但需要密切监控。它必须升温才能工作，但过热会导致损坏。因此，它需要比其他压缩机更先进的热管理系统。"
	]
	quest.578401B6C9DA2747.title: "高级压缩机 (Advanced Compressors)"
	quest.579C07CD07599438.quest_desc: [
		"要自动合成任何东西，AE都需要一个CPU来管理。这些是由最多三种组件组成的多区块结构。"
		""
		"多区块结构本身必须包含至少一个存储单元，且必须是一个长方体。"
		""
		"每个同时进行的合成请求都需要一个 CPU。"
		""
		"• 合成存储：用于存储所有"
		"合成所需的物品。"
		"可以使用多种不同的物品。"
		""
		"• 合成协处理器：可选。"
		"允许CPU发送批量请求"
		"更频繁地出现。"
		""
		"• 合成单位：可选。廉价的填充物"
		"符合形状的方块数量"
		"要求事项。"
		""
		"• 合成监视器：可选。显示"
		"请求的 CPU 当前正在处理中"
		"处理。"
	]
	quest.579C07CD07599438.title: "制作中央处理器（CPUs）"
	quest.57DA648FF73A769A.quest_desc: [
		"比其它压缩机略贵，热压缩机利用温差产生高达10巴的压缩空气。"
		""
		"这能为你工具补充一点额外的空气，大多数工具都能承受这么大的压力。"
		""
		"使用岩浆、熔岩甚至铀等方块加热一侧，而对面的散热器足以产生所需的温差。"
		""
		"热源会随着时间推移而逐渐损坏。"
		""
		"&a🛈 提示：查看热管用途，见"
		"&a    热源列表的EMI。"
	]
	quest.57E6258A93E53F95.quest_desc: [
		"你首先要做的是找到一个细胞迷宫。在这里，你会发现一些非常重要的物品来指引你的冒险。"
		""
		"制作一个蜂蜜罗盘，以便轻松找到该结构。"
		""
		"不过要小心！在没有“蜂巢庇护”增益的情况下踏入蜂巢迷宫，会引来附近的蜜蜂围攻你。"
		""
		"此增益可通过右键获得，右键目标方块会消耗一个物品。"
		"用食物点击蜜蜂，或对蜂房方块做同样的事情。"
		""
		"迷宫里应该有很多这些，能帮你维持增益效果，方便你探索。"
	]
	quest.5859B0217F1C837A.quest_desc: ["使用气场牵引车，可将气场从中央发电机抽出，并分散到整个区域，为那些因距离太远而无法直接受益于发电机的机器提供动力。"]
	quest.586D65D7CC2B8FCF.quest_desc: [
		"随着你深入了解灵魂召唤的复杂性，你可能会想自动化其中一些仪式。由于书籍上的名称是随机的，这可能会与AE2产生轻微的不兼容。"
		""
		"用铁砧重命名《灵之书》，所有用其装订的书都会采用新名字，解决了这个小问题。这样AE2制作装订书就不会有问题了。"
		""
		"&6⚠ 注意：在此召唤的职业之魂"
		"&6    路径将归 AE2 所有"
		"&6    系统的虚拟玩家，使他们成为"
		"&6    uncontrollable. 最好用于这种情况"
		"&6    用于制作物品。"
	]
	quest.58A275DB77CDF7F8.quest_desc: [
		"Malum 添加了多个特殊掉落，这些掉落只能通过合适的武器从生物身上获得。"
		""
		"通常，你应该先制作一把原始镰刀，但如果你已经通过其他模组有所进展，可能已经拥有能采集这些材料的武器了。"
		""
		"&a🛈 提示：灵魂编织袋会"
		"&a    自动收集这些掉落物，并保留"
		"&a    你的背包清理干净了！"
	]
	quest.59293885E5C9E8A3.quest_desc: [
		"一种用于粉碎矿石和其他材料的简单机器。"
		""
		"可能比较慢，但这是前期提高采矿产量的廉价方法！"
	]
	quest.5937576BD1069FC4.quest_desc: [
		"幻影面孔有多种类型，可无线处理常见的物流问题。"
		""
		"绑定到方块后，它们允许远程进行某些交互。例如，一个幻影能量面可以连接到机器，从而通过幻影面为机器提供能量。"
		""
		"范围限制为16格，但可通过在幻影面放置范围增强器将范围延伸至128格。"
		""
		"要绑定方块，请用幻影连接器潜行+右键点击它，然后再点击幻影面。"
	]
	quest.5937576BD1069FC4.title: "幻影面孔"
	quest.598473588831F46D.quest_desc: [
		"流体激光中继器可用作无线流体管道。只需将其放置在需要液体的机器和储罐旁，然后用激光扳手将所有中继器连接起来即可。"
		""
		"它们的射程相对较短，但可以非常有效地连续使用！"
		""
		"&a🛈 提示：使用指南针来切换模式"
		"&a    从源储罐中抽取！"
	]
	quest.59A56F3053A30126.quest_desc: [
		"最后，用孵化器，我们能将三种材料结合，将基础硫磺还原为纯品。对于矿石，每投入一种原材料，就能产出三个锭。"
		"&n                                                  &r"
		""
		"孵化器是一个简单的多方块结构，孵化器本身置于中心，三个容器则紧邻其旁，呈T字形排列。"
		""
		"Pyromantic Brazier 必须直接放置在 Incubator 的正下方。"
		""
		"与之前的步骤一样，物品可以右键点击放入各自的容器中，或使用管道等物流系统放入。"
	]
	quest.5A2C9E1F74B7EC97.quest_desc: ["完成的PCB将解锁PneumaticCraft中最强大的选项，从盔甲、武器到堪比钢铁侠的装备，再到可编程无人机和高级物流系统。"]
	quest.5A355C35CB5B24D8.quest_desc: [
		"有一种名为 Iesnium 的神奇材料，是束缚灵体的理想物质，因为它能增强灵体并赋予其更强大的力量。"
		""
		"这种材料只存在于下界，而且相当罕见。只有灵魂才能看到它。"
		"&n                                                  &r"
		""
		"制作一副 Otherworld Goggles。它能赋予你 Spirit 视力，让你能看到 Iesnium Ore。"
	]
	quest.5A74D7EFD6AD1EAC.quest_desc: [
		"用灵魂碎裂武器击杀生物通常会掉落精神方面。这对 Malum 的许多合成很有用，所以注意不同生物会掉落哪些精神方面。"
		""
		"许多生物都与不同的精神属性相关。例如，僵尸是获取土之灵和邪之灵的好来源。"
		""
		"要找到适合你所需特性的生物，需要进行一些尝试。"
		""
		"&a🛈 提示：灵魂罐可以容纳一个"
		"&a    数量庞大的灵魂！"
	]
	quest.5AD1A273F3714FAF.quest_desc: [
		"是时候开始考虑一下能源问题了，不是吗？"
		""
		"许多 Ars Nouveau 的装置要么需要源能量才能运行，例如某些附魔装置配方，要么在提供源能量后能得到显著提升，例如灌注室。"
		""
		"那么，选个方法，生成一些源材料吧！"
		"&n                                                              &r"
		""
		"每个 Sourcelink 都使用不同的“燃料”来生成 Source，并将其存入附近的 Source Jar 中。"
		""
		"• &7Agronomic&r – 从自然中生成源"
		"作物生长。放置在田地中央"
		"以获得最佳效果。"
		""
		"• &7Volcanic&r – 消耗煤炭等熔炉燃料。"
		"可以将其丢弃在附近，或者放入以下物品中"
		"一个相邻的 Arcane Pedestal。"
		""
		"• &7Alchemical&r – 消耗来自一个的药水"
		"相邻的药水瓶。最好搭配 Wixie 使用"
		"被指定用于将药水酿造到罐子中。"
		""
		"• &7Vitalic&r – 将生物死亡转化为源，一个"
		"任何刷怪塔的优秀补充。"
		""
		"• &7Mycelial&r – 消耗食物。可以掉落此物品"
		"附近或插入到相邻的方块中"
		"神秘祭坛 (Arcane Pedestal)"
		""
		"&a🛈 提示：源容器可容纳 10,000 源。"
	]
	quest.5AFA08920E94A02B.quest_desc: [
		"灵火将暂时作为你与异界的主要交互界面。"
		""
		"投入一些安山岩，它们就会给你所需的Otherstone。"
		""
		"同样，你也可以用橡木树苗换取不稳定的异界树苗。"
		""
		"这棵树苗可以正常生长，但你需要在 Demon's Dream 的效果下才能收获它。"
		""
		"&a🛈 提示：从 Otherworld 购买树苗"
		"&a    使用市场来加快此步骤。"
	]
	quest.5B39C22D132CB376.quest_desc: ["再加上凋零骷髅头颅"]
	quest.5B39C22D132CB376.title: "阿布拉的加固附魔物品"
	quest.5BD04F0109CB6704.quest_desc: [
		"用些粉笔和其他杂物，我们就能更直接地联系到另一个世界，并把帮手带到我们的世界来。"
		""
		"我们将从召唤一个 Foliot Crusher 开始。"
		"&n                                                  &r"
		""
		"在《灵界词典》中找到 Aviar 的圆圈，然后点击预览中的 👁 以在现实中查看。"
		""
		"&a🛈 提示：单个粉笔的形状"
		"&a    标记是随机的，并且不会"
		"&a    影响仪式！"
		""
		"祭品碗可以放置在黄金祭品碗周围半径约八格内的任何空位，甚至可以放在五芒星之外。"
		""
		"接下来，将材料放入祭品碗中，如 EMI 所示；它们的位置顺序无关紧要，可以放入任何碗中。"
		""
		"黄金仪式碗中物品会最后放入，并触发仪式。"
		""
		"&a🛈 提示：物品可以管道输送至"
		"还有碗！&a"
		""
		"&6⚠ 注意：所使用的铜块（Copper Blocks）"
		"&6    五芒星可以被替换为"
		"&6    上蜡或腐蚀的变种"
		"&6    而不会影响五芒星本身。"
	]
	quest.5BD04F0109CB6704.title: "召唤：Foliot 破碎机"
	quest.5C9FD202A4E641D1.quest_desc: ["物品拾取器是一个简单的反拾取装置。范围内的物品，除非玩家潜行，否则无法被拾取。"]
	quest.5CC1D814819E3044.quest_desc: [
		"数字矿工是一种定向采矿设备，可从世界中挖掘方块。通过设置过滤器，你可以精准获取所需物品，是补充钻石或远古残骸的绝佳方式。"
		""
		"矿工不会使用时运，所以珍贵材料最好用精准采集，然后手动分解。"
		""
		"&a🛈 提示：使用石料生成器升级"
		"&a    以自动替换开采的矿物"
		"&a    带有石头的方块！"
	]
	quest.5D10C31B8F29FE5E.quest_desc: ["这种强大的玻璃可以放置在植物上方，以显著提高生长速度。"]
	quest.5D52341DC77AFE8D.quest_desc: [
		"进步永无止境。随着更多机器上线和升级，电力消耗将持续增长。"
		""
		"与MV Tier一样，建议用EV干线为独立HV子网络供电。"
		""
		"可以考虑多种类似这样的设置："
		""
		"&e高级锅炉"
		"&e╰┈➤ &3HV涡轮集群"
		"&3╰┈➤ &aHV to EV Transformer"
		"&a╰┈➤ &b退火铜缆"
		"&b╰┈➤ &a低压至高压变压器"
		"&a╰┈➤ &3机器集群"
		""
		"&6⚠ 注意：保持你的 HV 子网络"
		"&6    分开，这样它们就不会被限制了"
		"&6    最大传输速率。"
	]
	quest.5DB469A00A023DCF.quest_desc: [
		"裂变反应堆本身并不产生电力；这项工作由工业涡轮机完成，它将反应堆的蒸汽转化为水和能量。"
		""
		"要有效运行反应堆，你需要以这种方式回收水。"
		"&n                                                 &r"
		""
		"涡轮本身是一个巨大的自由形态的多方块结构。"
		""
		"【放置规则和最大尺寸限制，请访问他们的维基页面了解更多信息：】，{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://wiki.aidancbrady.com/wiki/Industrial_Turbine\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"工业涡轮机\",\"underlined\":true}]"
		""
		"&a🛈 提示：E10 包含一个 Mekanism 多用途"
		"&a    EMI 中的区块规划器！"
	]
	quest.5DB469A00A023DCF.title: "工业涡轮机"
	quest.5DD76DB5C6220F40.quest_desc: ["有了研磨机，你就能从开采的矿石中获得更高的产量了！"]
	quest.5DE688C9457D18DF.quest_desc: [
		"一个简单的风力涡轮机。放置得越高，产生的电力越多。"
		""
		"当然，然后你需要把电力从那里引下来！"
		""
		"&a🛈 提示：需要清晰的天空视野。"
	]
	quest.5DF0502B194247F9.quest_desc: [
		"Ever wanted to transfer Source around your base through your AE system? Perhaps you’d like more Source storage than Source Jars can easily accommodate?"
		""
		"源存储单元才是正解所在。"
		""
		"将这些与ME Source Jar结合，你可以在任何需要时导入和导出源，同时存储大量源以供将来使用。"
		""
		"&a🛈 提示：在附近放置一个 ME Source Jar"
		"&a    需要来源的地方，那么就是"
		"&a    用中继器把它运送到一个"
		"&a    可供使用的普通源存档文件。"
	]
	quest.5DF2A3E977D4C11B.quest_desc: [
		"欢迎来到 Occultism，一个通过仪式五芒星召唤灵魂以获取个人利益的模组。"
		""
		"在这里，我们将带你了解 Occultism 的基本流程，从首次接触灵体到维度存储等！"
		""
		"Occultism 有一个出色的游戏内指南，信息量远超于此，请务必查阅以获得更深入的解释。"
	]
	quest.5DF2A3E977D4C11B.title: "Occultism"
	quest.5E32D9117B3994E0.quest_desc: ["永恒之泉会消耗灵气来生成水，这些水可以通过任何流体物流系统导出。"]
	quest.5E54A325CBBFCF54.title: "Aviar's Circle"
	quest.5E84329A59955F29.quest_desc: [
		"AA 兼容任何 FE 来源，但它也提供了几种自身产生能量的方法。"
		""
		"石油发电机可以燃烧菜籽油以及模组中包含的各种其他油。"
		""
		"获取菜籽油需要先消耗少量电力来运行菜籽压榨机。因此，请先建造煤炭发电机，或通过其他模组获取电力。"
	]
	quest.5EB38424DEF4E8E9.title: "马里德破碎机"
	quest.5F0523F799DA720C.quest_desc: [
		"在环境蓄积器上使用，天气容器将填充当地天气的样本。"
		""
		"然后可以投掷瓶子，在你喜欢的任何地方释放该天气，即时改变天气。"
	]
	quest.5F50024F403D28D0.quest_desc: [
		"和之前的结晶油一样，赋能油是通过将赋能油菜籽投入结晶油中获得的。"
		""
		"和之前一样，这代表了燃烧时间和每刻产量都获得了显著提升。"
	]
	quest.5F50024F403D28D0.title: "强化石油生产系统已启动"
	quest.5FBC1038ACB861CE.quest_desc: [
		"Assembler 是一种强大的自动合成机器，可以处理任何合成台配方，包括需要液体的配方。"
		""
		"这可以是自动化生成处理木材的绝佳方法！"
	]
	quest.5FD8F4BE050D55B2.quest_desc: [
		"Pretty Pipes 是一个功能强大的简易物品物流和分拣系统。"
		""
		"最吸引人的地方或许是，它们能显示内部流动的东西，带来更沉浸的体验。"
		""
		"除此之外，它们还提供推和拉两种功能：提取模块可将相邻物品栏的物品吸入并分散到网络各处，而检索模块则可将网络中任意物品栏的物品吸入并推入相邻物品栏。"
		""
		"有多种过滤器和优先级模块，可确保物品被正确放置。"
	]
	quest.600770CC14587E1B.title: "奥菲克斯的召唤"
	quest.6026FB490B591788.quest_desc: [
		"使用奥术锻造台，你可以开始升级装备和法术卷轴了。"
		""
		"卷轴可以用越来越高级的墨水反复升级，直到达到上限。上限通常是10级，但有些卷轴的等级上限较低。"
		""
		"此外，升级球可用于你的装备，让你能进一步按喜好定制装备。任何一件装备最多可应用三个球。"
		""
		"附魔在装备上的卷轴相当于给你一个额外的法术位，让你无需在法术书中就能施放该法术"
		"&n                                                  &r"
		""
		"应用了不再需要的升级或附魔？它们可以用Shriving Stone移除。"
		""
		"以这种方式移除时，升级不会被丢失。"
	]
	quest.602E1E149A49D056.quest_desc: [
		"奇美拉已死，大法师咒语书所需的其余材料应该唾手可得了。"
		""
		"召唤凋灵和原版一样，但你可以用加固深板岩制作收容室来简化战斗。"
		""
		"寻找不死图腾的唤魔者可能更具挑战性，但你可以用挑战之板强制引发掠夺者袭击。或者用神秘学召唤被附身的唤魔者。"
	]
	quest.60EECBF540C75C09.quest_desc: ["现代工业化提供多种尺寸的储罐，以满足您的需求。"]
	quest.60EECBF540C75C09.title: "坦克"
	quest.61090C5F8E435E7A.quest_desc: [
		"粉笔块"
		""
		"白色"
		"黄色"
		"紫色"
		"红色"
		""
		"周边物品与杂物"
		""
		"无"
	]
	quest.61090C5F8E435E7A.title: "奥索林的无拘束召唤"
	quest.6118F241A056954F.quest_desc: [
		"海绵模块非常适合大范围清除流体，无论是清除下界的岩浆，还是清除海洋纪念碑的水。"
		""
		"&c⚠ 警告：该区域内所有流体将在"
		"&c    力场已被摧毁。"
	]
	quest.6118F241A056954F.title: "流体移除"
	quest.6133CA58FE668DA6.quest_desc: [
		"模拟电路将很快让我们能跃升至运行LV电力的下一层级机器。现在制作组件成本略高，但一旦能造出装配器，制作效率将大幅提升。"
		""
		"先小批量制作，以后再自动化吧。"
	]
	quest.6133CA58FE668DA6.title: "模拟电路模组 (Analog Circuitry)"
	quest.61F55FC24EA0CD1C.quest_desc: [
		"开始前，我们需要一些有机物样本。使用刮刀刮取不同生物就能获得它们。"
		""
		"将它们投入细胞分析仪以获得细胞。"
		""
		"&a🛈 提示：附魔了“刮刮器”的"
		"&a    轻柔触摸，不会造成伤害。"
	]
	quest.621BA38E3E50B91E.quest_desc: [
		"坚韧的承诺（Promises of Tenacity）是一种机器等级系统。它们不仅能安装升级，还能解锁机器的新功能。"
		""
		"例如，某些配方需要 Tier 2 的坚韧承诺才能生效。"
		""
		"&a🛈 提示：更高级别的承诺适用于"
		"&a    低阶配方！"
	]
	quest.62249C31ADCB3914.quest_desc: [
		"加入了矿工透镜后，原子重构器能将石头转化为随机矿石。"
		""
		"这消耗的能量不少，但可以作为一种有趣的方式来创造小型无限材料源！"
		""
		"&6⚠ 注意：要使其生效，该方块"
		"&6    必须放置在路径的某个位置"
		"&6    光束，它对物品无效。"
	]
	quest.6242CD0203DCBDC7.quest_desc: [
		"Wixie 附魔装置允许 Wixie 使用源材料制作任何附魔装置的配方。"
		""
		"她会从连接的储物空间中自动取用物品进行合成，将物品放置在相邻的 Arcane Pedestal 上即可指示她合成内容。"
		""
		"与普通附魔台不同，神秘基座仅用于指定配方。她不需要它们作为材料。"
	]
	quest.6242CD0203DCBDC7.title: "Wixie 附魔装置"
	quest.626E31B97CA1F815.quest_desc: [
		"裂变反应堆虽然能产生巨大能量，但在Mekanism中，其主要魅力在于将铀加工成更实用的材料，如钚和钋。"
		"&n                                                 &r"
		""
		"反应堆本身是一个巨大的自由形态的多方块结构。"
		""
		"【放置规则和最大尺寸限制，请访问他们的维基页面了解更多信息：】{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://wiki.aidancbrady.com/wiki/Fission_Reactor\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"裂变反应堆\",\"underlined\":true}]"
		""
		"&a🛈 提示：E10 包含一个 Mekanism 多用途"
		"&a    EMI 中的区块规划器！"
		""
		"&6⚠ 注意：熔毁与辐射"
		"&6    已被禁用！"
	]
	quest.62BDFBDD13019EFB.quest_desc: ["可配置箱子在技术上与普通箱子大小相同，其特点是每个槽位都可以过滤以容纳特定数量的物品。"]
	quest.62CD365A54A0DE47.quest_desc: [
		"欢迎来到沉浸式工程！"
		""
		"具有浓厚特斯拉朋克风格的科技模组，沉浸式工程能为未来的工程师带来丰富内容。"
		""
		"该模组非常注重大型多方块机器。因此，你可以在 Create 的 Schematicannon 中找到所有 IE 多方块结构的蓝图，只需打开 Schematic Table 即可选择。"
		""
		"[\"它们也可以在 \",{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://blockprints.io/user/MuteTiefling\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"BlockPrints\",\"underlined\":true},\" 上获取，并且可以轻松导入！\"]}"
		""
		"[\"按下 (\",{\"color\":\"gold\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"菜单键\"}]},\"keybind\":\"key.blockprints.open_menu\"},\") 以打开 BlockPrints 菜单。\"]"
	]
	quest.62CD365A54A0DE47.title: "Immersive Engineering"
	quest.62E2DEBF71698376.quest_desc: [
		"导入、导出和存储总线是网络的主要接口。"
		""
		"导入和导出总线的作用如预期般，将物品拉入或推出网络。"
		""
		"另一方面，存储总线实际上将所附的库存视为网络的一部分；网络可以访问其中的任何物品，也可以用它来存储进入网络的任何物品。"
		""
		"&a🛈 提示：电缆组件无法被"
		"&a    放置在密集电缆上。"
	]
	quest.6303A7113DE954DD.quest_desc: [
		"你那根刺人的手臂可能已经有点累了，你肯定在想办法自动获取血液。"
		""
		"带刺的板和血腥的底座就是答案。"
		""
		"将尖刺板放置在基座上，并在旁边放置一个暗色储罐。任何踩到尖刺板的生物都会受到伤害，其血液会自动转移到储罐中。"
		""
		"当然，你还需要建造某种生物农场……或许某种诅咒会很有帮助？"
		""
		"&a🛈 Tip: Sneak + Right-Click a Wither Rose"
		"&a    在泥土上放置以制作诅咒之地。"
	]
	quest.6303A7113DE954DD.title: "血液自动化系统"
	quest.631AA5AAA6EF687C.quest_desc: [
		"模式提供者是网络与合成机器交互的接口。"
		""
		"对于合成台等基本合成配方，提供者需要放置在分子合成器旁边。"
		""
		"用于机器合成或处理配方时，应将提供者朝向该机器放置。它也可以向任何物品栏供料，你可以通过管道将物品从那里输送出去。例如，一组熔炉可以由一个向箱子输入的提供者供料。管道随后会将物品输送并分配到各个熔炉中。"
	]
	quest.631AA5AAA6EF687C.title: "自动合成"
	quest.6379BB1E5393B34B.quest_desc: [
		"阿弗利特是闻名诸界的杰出工匠，以其精湛的技艺而闻名。因此，修复大多数工具和盔甲对他们来说易如反掌。"
		""
		"不过，它们能使用和修复矿灯的能力尤其值得关注。在它们坏掉前，记得带上珍贵的矿工灯去找它们！"
	]
	quest.6379BB1E5393B34B.title: "仪式：修复工具、盔甲和矿工装备"
	quest.6384F08466CA9FB9.quest_desc: [
		"红石氛围蒸发器，简单来说，就是一个时钟。"
		""
		"放入瓶装气场以设置不同间隔。每瓶阳光代表一秒，鬼魂代表几分钟，黑暗代表几小时。"
	]
	quest.63B019541F72C712.quest_desc: [
		"想找个好用的隐形围栏来圈养怪物吗？这个方块正适合你。"
		""
		"在完整的红石信号下，这将发出一个15x15x15范围的隐形墙，阻止生物进出。"
		""
		"这使得它成为保护牲畜免受侵害的绝佳方式，而无需使用简单的围栏。"
	]
	quest.63DDC1FFF52DC39F.quest_desc: [
		"现代工业化包含了一套强大的管道系统，用于输送物品、流体和电力。"
		""
		"这些管道可以共享一个方块空间，最多允许三种不同类型的管道穿过一个方块。可以是每种类型各一个，也可以是同类型但不同颜色的多个管道。"
		""
		"它们还拥有一个大型内置过滤器和优先级系统，有助于将物品路由到所需位置。空手右键点击连接即可访问这些选项。"
		""
		"扳手可用于快速切换连接模式，或直接移除连接。潜行状态下右键点击管道即可立即移除该管道部分。"
		""
		"&a🛈 提示：潜行状态下右键点击管道或电缆"
		"&a    对抗机器以轻松创建物品"
		"&a    一个连接。"
	]
	quest.63DDC1FFF52DC39F.title: "管道"
	quest.642CDBB28337670C.quest_desc: [
		"这些美丽的双足鸟类遍布世界各地，以小家庭为单位活动。"
		""
		"它们喜欢吃吉萨尔蔬菜，用这种美味来喂养它们，就能轻松驯服。"
		"&n                                                  &r"
		""
		"快出去看看，能不能找到几个带回家。"
		""
		"一定要抓一对配偶！雄性和雌性可以通过尾羽区分，雄性羽毛比雌性更鲜艳。"
	]
	quest.642CDBB28337670C.title: "寻找与驯服"
	quest.6442A8E130C09FA2.quest_desc: [
		"生物反应器用于生产生物燃料，这是一种强大的液体燃料，可以轻松取代你那可怜的发电机。"
		""
		"该装置需要电力、水源和作物等生物材料才能运行。"
		""
		"每提供一个独特物品，它都会产出额外的生物燃料。也就是说，用九种不同的作物来喂养，远比用同一种作物填满所有槽位要高效得多。"
	]
	quest.64B786FE65505D75.quest_desc: [
		"在环境收集器上使用，生物群系提取瓶将装满当地生物群系的样本。"
		""
		"然后可以投掷瓶子，将那个生物群系永久地释放到你喜欢的任何地方。"
	]
	quest.64E6D41378108B92.quest_desc: ["这杯咖啡不仅能让你精神一振，还能提供一些有限的药水效果！"]
	quest.6538BD86D9419DD4.quest_desc: [
		"欢迎来到神学世界！Welcome to Theurgy!"
		""
		"这款激动人心的模组深入探讨了炼金术，让你能将铅变成金，或者几乎任何其他材料。"
		""
		"请务必参考模组指南《The Hermetica》，里面有很多出色的自动化示例和建议！"
	]
	quest.6538BD86D9419DD4.title: "神学魔法模组 Theurgy"
	quest.653E696688BBBB12.quest_desc: [
		"找到第一块陨石和 Certus Quartz 时，你很可能已经挖了不少 Sky Stone。但这些储备不会永远够用。"
		""
		"幸运的是，获得更多非常简单，甚至不需要离开家。只需抬头望向天空即可。"
		"&n                                                  &r"
		""
		"将湮灭平原朝上放置在建筑高度限制处 (&aY=319&r)，它就会慢慢产出更多这种珍贵的材料！"
	]
	quest.653E696688BBBB12.title: "采集天空之石（Sky Stone）"
	quest.65996A36FB1B58B0.quest_desc: [
		"富集室主要用于让附魔材料发挥更大的作用。"
		""
		"先给红石和煤炭充能，再放进冶金注入器，大幅提升效率！"
	]
	quest.65FDD18E441E2E6E.quest_desc: [
		"活化的书籍，Bookwyrms 是 Ars Nouveau 内置的完整存储系统的一部分。"
		""
		"指南中提供了完整的设置说明，但简要概述如下：将 Bookwyrm Charm 用于 Storage Lectern，即可将该 Lectern 与物品栏链接。"
		""
		"&a🛈 提示：添加更多 Bookwyrms 可以允许"
		"&a    更多连接！"
	]
	quest.66A24B8817411BBC.quest_desc: [
		"Enigmatica 10 中包含的五芒星均为定制内容，旨在提升 Occultism 的玩家体验。"
		""
		"具体来说，所需粉笔的数量已从十六种减少到五种：&f白色&r、&e黄色&r、&5紫色&r、&c红色&r和&9蓝色&r。不过，无色粉笔的杂质形式仍会出现在某些配方中，其他颜色在需要时仍可合成。"
		""
		"许多配方也做了相应改动，以简化模组内的进度流程。"
		""
		"因此，《灵界词典》中的一些条目可能不正确。这些任务将引导你完成五芒星进阶。"
		"&n                                                  &r"
		""
		"制作一些不纯的白垩，然后投入灵魂之火中净化以便使用。"
		""
		"We’ll need it for summoning a friend or two."
		""
		"&a🛈 提示：新制作的粉笔不会损坏！"
	]
	quest.66A24B8817411BBC.title: "基础五芒星"
	quest.66AE19141D8F5604.quest_desc: [
		"与裂变相比，聚变的操作简直是小菜一碟。毕竟，这就是我们制造出世界上最强大计算机的原因。"
		""
		"融合需要消耗能量和流体，并会生成氦等离子体及其他副产品。"
		""
		"&a🛈 提示：先放置控制器方块，然后"
		"&a    手持扳手或撬棍即可查看"
		"&a    结构或有效位置用于"
		"&a    孵化口。"
		""
		"&6⚠ 注意：反应堆不会熔毁"
		"&6    并且不要爆炸。&r"
	]
	quest.66B189D0C0CFE055.quest_desc: [
		"要接触灵界，也就是所谓的异世界，可能需要一种……改变了的意识状态，这么说行吗？"
		"&n                                                  &r"
		""
		"吃一些恶魔之梦果实吧。"
		"应该不会那么糟糕，对吧？<c1><c2>"
		""
		"&a🛈 提示：恶魔之梦果实可以治愈伤口"
		"&a    灵魂们！"
	]
	quest.66BC8A8EB33B0677.quest_desc: [
		"穿刺复仇焦点是你普通焦点的更强力形式。但它不是将灵魂困在盒子里，而是将其完全湮灭。"
		""
		"用这种方式杀死一个灵魂，你将获得一些复仇精华。"
	]
	quest.66BC8A8EB33B0677.title: "复仇精华"
	quest.66C2FBA12D91F642.quest_desc: [
		"Exo Suit 是一套不可破坏的动力盔甲，可提供中等防护、夜视能力和速度加成。"
		""
		"升级版的胸甲也支持添加鞘翅或喷气背包飞行！"
	]
	quest.66DAC6EC4232C44A.quest_desc: [
		"热爱生活的深海居民，塞壬生活在温暖的海洋中，如果你给它们海葵，它们会很高兴地加入你的动物园。"
		""
		"作为回报，海妖将帮助你自动获取钓鱼战利品。"
		"&n                                                  &r"
		""
		"右键点击海晶灯块并带上她的魅力，即可为她建造家园。在家园中放置更多水生植物和动物，会让她更开心、更高效。"
	]
	quest.672B88E9A3FA1FCE.quest_desc: ["当“冬日的呼唤”生效时，该区域将逐渐积雪，水会结冰。雪傀儡也可能出现，进一步传播雪地的乐趣！"]
	quest.673C6861CC3A781C.quest_desc: [
		"[\"获得了我们想要的稀有金属硝石后，我们就可以\",{ \"text\": \"重塑\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"1E2BA13C53664E50\" },\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]} },\"将其变成我们想要的任何稀有金属硫磺，例如金硫磺。\"]]"
		""
		"[\"从那里，硫磺需要被 \",{ \"text\": \"孵化\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"59A56F3053A30126\" },\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]} },\" 回炉成锭。\"]"
	]
	quest.673C6861CC3A781C.title: "改革与孵化"
	quest.67782CB855950CD6.quest_desc: ["另一种里程碑材料，如钢和HDPE，由乙烯生产，用于制造许多高级机器以及Meka-Suit的升级部件。"]
	quest.67782CB855950CD6.title: "HDPE"
	quest.67835A69ECDC692D.quest_desc: [
		"红粉笔蕴含着阿弗利特的精粹，拥有足够的力量来束缚阿弗利特及更弱小的灵魂。"
		"&n                                                  &r"
		""
		"设置 Kandar’s Open Conjure 以召唤 Unbound Afrit，然后在战斗中击败它以获取其精华。"
		""
		"&6⚠ 注意：此仪式需要一个"
		"&6    献祭。触发仪式，如"
		"&6    通常做法，然后杀死指定的生物"
		"&6    五芒星附近。"
		""
		"&a🛈 提示：新制作的粉笔不会损坏！"
	]
	quest.67835A69ECDC692D.title: "阿夫里特束缚粉"
	quest.679DACB985517C55.quest_desc: [
		"高级投掷器可以投掷更远距离的物品，并且投掷数量更可控。"
		""
		"&a🛈 提示：使用渲染区域按钮来"
		"&a    轻松配置工作区域。"
	]
	quest.68079D29B91FC30A.quest_desc: [
		"现代工业化有自己的村民，能在前期极大地帮助你，出售钢锤、模拟电路等物品，助你快速度过初始阶段。"
		""
		"他们的工作台是一个锻造锤。快来试试，看看能得到什么吧！"
	]
	quest.68079D29B91FC30A.title: "工业家模组 (Industrialists)"
	quest.684A0E52D7BAC37C.quest_desc: [
		"一个集成了合成台的物品存储解决方案，让所有物品触手可及，方便合成。"
		""
		"稳定的虫洞提供远程访问，以便物品能从远程农场通过管道输送进来。"
		""
		"存储访问器可让您随时随地访问个人存储空间。"
		""
		"在专门的章节中阅读更多关于此系统的信息：\",{\"clickEvent\":{ \"action\": \"change_page\", \"value\": \"0095002B3E34FD9A\" },\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\": \"Occultism\",\"underlined\":true},\"。\"]"
		""
		"&a🛈 提示：潜行状态下右键点击稳定化"
		"&a    虫洞或存取器接口"
		"&a    在Actuator上以将它们连接起来。"
	]
	quest.685AA2A5C0C2C796.quest_desc: ["Assembler 是一种高级合成机器，可用于更便宜地生产某些组件。"]
	quest.68A0052D169BB6E4.quest_desc: [
		"怪物屠宰场是液态怪物产品的来源，包括液态肉和粉色史莱姆。真美味。"
		""
		"虽然这可以与任何形式的生物农场配合使用，但 Industrial Foregoing 提供了多种生产所需生物的方法。"
		""
		"&a🛈 提示：被动生物产出更多"
		"&a    粉红史莱姆比敌对生物更友好。"
	]
	quest.68A0052D169BB6E4.title: "肉类养殖"
	quest.690FB1A43ED247CF.quest_desc: [
		"谁能想到把物体加速到接近相对论速度再撞在一起会这么赚钱？"
		""
		"粒子加速器由一个大型自由形式的多方块结构组成。加速器本身用于将物品注入束流，而导向环则用于引导束流沿安全路径行进。"
		""
		"通常，你需要将这条路径设计成环形，以获得各种工艺所需的冲量。"
		""
		"加速粒子需要一台或多台线性马达。单个效果不大，但可以串联多个来更快地提升速度。"
		"&n                                                                          &r"
		""
		"【这里有很多活动部件，请务必查看他们的维基上的“粒子加速器”页面，该页面非常出色地描述了此系统的运作方式。】"
		""
		"不过，为了让你了解范围，参考需要碰撞能量 &61000J&r 的 Echo Shard 配方。在保持粒子被约束的同时达到这些速度，转弯之间至少需要 11 格的距离。顺便一提，当你的传感器达到 &cRedstone Signal of 10&r 时，你就准备好注入第二个物品来引发碰撞了。"
		""
		"同样，需要碰撞的 &615000J&r 的下界之星配方，需要更长的轨道，转弯间的最小距离约为34格。在 &c红石信号为14&r 时能达到合适的速度。"
	]
	quest.69295042E8C3A609.quest_desc: [
		"源中继器用于将源从一个地方运输到另一个地方。这样你就可以有一个集中的源生成区，为家周围的多个设备或法术炮塔供电。"
		""
		"这些有多种类型，但目前最相关的可能是 Splitter。它不仅比基础 Relay 传输 Source 更快，还能用于向多个目标提取或存入物品。"
		""
		"使用Dominion Wand将中继器连接到其他中继器或源罐。先右键单击源，再右键单击目标。"
		""
		"&a🛈 提示：你可以改变发射的光束颜色"
		"&a    使用 Wololo 符文通过中继器！"
	]
	quest.692EDEAEC3F4A2AD.quest_desc: [
		"交换器是一种强大的传送装置，能将前方的方块或实体与已连接的伙伴进行交换。"
		""
		"这是探索基地、长距离传送、将幼崽移出农场等的好方法。"
		""
		"它们必须以成对的形式设置，并使用 Ferricore Wrench 将它们绑定在一起。"
		""
		"只需将两者放置，然后用扳手右键其中一个。最后用扳手右键另一个即可。"
	]
	quest.692EDEAEC3F4A2AD.title: "简易交换器"
	quest.6968F7CB58754783.quest_desc: [
		"Ender IO 有许多重要的合金，这使得合金熔炉成为最重要的基础机器之一。"
		""
		"这台机器也同时可以作为普通的熔炉使用。"
		""
		"&6⚠ 注意：机器需要电容器 Capacitor"
		"&6    储存能量并运行。"
	]
	quest.69799346F7BF246C.quest_desc: [
		"晶花可用于获取附魔书。具体来说，你可以精确选择要获得的书籍，从而消除过程中的随机性。"
		""
		"它们可能遍布Bumblezone的多个结构中。尤其要留意天花板上的悬挂花园。这些花园不仅是其他稀有花朵的绝佳来源，中心还会有这些晶花。"
		""
		"要获得运行所需的经验值，可以喂食它们各种物品。在EMI中搜索&3#when_consumed&r，即可发现哪些物品有效。"
		""
		"它们还会吸收与之接触的XP球，或者可以直接用你的XP为其充能。"
		""
		"&a🛈 提示：晶花可能位于"
		"&a    移动了，但必须放置在一個"
		"&a    像 Glistering Honey 一样的晶体"
		"&a    或者紫水晶"
	]
	quest.69A9A6E9B7CB34B4.quest_desc: [
		"要开始使用 Ars Nouveau，第一件事就是找到一些 Archwood 树。"
		""
		"现在用哪种颜色都可以，但最终你需要收集每种树苗的幼苗。"
	]
	quest.69AAE7C502629B3E.quest_desc: [
		"与从LV升级到MV一样，升级到HV可能需要一些时间。优先升级你的电力生产是关键。"
		""
		"不过，如果你已经开始使用变压器来分离你的电网，那么这项任务应该相当简单。"
		"&n                                                  &r"
		""
		"随着你扩展高压电网，现有的中压机器可以轻松升级为高压运行。"
		""
		"涡轮机械外壳可以右键点击机器进行升级，或者打开机器GUI并在插槽中安装。"
		""
		"&6⚠ 注意：机器在以下情况下根本无法运行"
		"&6    使用了错误的等级能量。"
	]
	quest.69CCA30AB383ACCD.quest_desc: [
		"能够储存极其庞大的能量，感应矩阵通常用于已达到裂变或聚变成就的玩家。不过，即使是小型的，其容量也远超能量立方。"
		""
		"感应矩阵本身是一个巨大的自由形式多方块结构。不过，关于放置规则和最大尺寸限制，可以通过访问他们维基上的感应矩阵页面来了解："
		""
		"{ \"text\": \"Mekanism Wiki: Induction Matrix\", \"color\":\"green\", \"underlined\": true, \"clickEvent\": { \"action\": \"open_url\", \"value\": \"https://wiki.aidancbrady.com/wiki/Induction_Matrix\" } }"
		""
		"&a🛈 提示：E10 包含一个 Mekanism 多用途"
		"&a    EMI 中的区块规划器！"
	]
	quest.69D23BB3D7670DFC.quest_desc: [
		"在力场投影仪中使用这些升级，可以调整力场的形状和大小。"
		""
		"• &7Scale Modules&r 扩展该领域的范围"
		"指定的方向。"
		""
		"• &7翻译模块&r 将中心移开"
		"在给定方向上移动田地中的方块，距离为"
		"每个模组一个方块"
		""
		"• &7旋转模块&r使田地发生旋转"
		"以每秒2度的速度给定方向 by 2 degrees per"
		"模块。"
	]
	quest.69D23BB3D7670DFC.title: "形状修改"
	quest.6A3F652A680598E6.quest_desc: [
		"Exaltation 是将材料在不同品质之间转换的过程。"
		""
		"举个例子，我们将把铁硫磺转化为金硫磺，所以每种都收集一些。这个过程并非1:1，有些转化比其他的更耗费资源。"
		""
		"这个过程可以双向进行，也就是说，稀有材料可以转化为大量低质量的物品。"
	]
	quest.6A3F652A680598E6.title: "Exaltation"
	quest.6A94923547B93B51.quest_desc: ["LaserIO 的流体卡允许激光节点传输流体。"]
	quest.6AD8B4B3A08CF1D3.quest_desc: [
		"有了庇护之灯，你终于可以放松了。它能阻止所有生物在周围大片区域内生成。"
		""
		"可以通过向其施加不同强度的红石信号来配置区域，其中15为最大区域。"
	]
	quest.6AFB99D4F0107184.quest_desc: [
		"不锈钢可能还太珍贵，不适合用来做钻头，但这确实是一个选项。"
		""
		"用它在采石场开采的矿石对本阶段生产至关重要，所以应优先处理。"
		""
		"它们还能让我们获得页岩油，用于第五座炼油厂，但这不会带来任何新内容，只是多了一种氦气的替代来源。"
	]
	quest.6AFCA9F187AE6EB2.quest_desc: [
		"建筑部分涵盖了帮助你建造或拆除的模组和工具。"
		""
		"从采矿和装饰，到破坏和更多，这里展示的模组将帮助你完成一切。"
	]
	quest.6AFCA9F187AE6EB2.title: "建造中"
	quest.6B0673A379D483A5.quest_desc: [
		"除了用原子重构器制作的基础材料外，AA 中的许多配方还需要更高级的材料。"
		"这些材料是使用 Empowerer 制作的。"
		""
		"这是一个由中央的 Empowerer 和四个 Display Stand 组成的多方块结构。每个 Display Stand 必须放置在 Empowerer 的四个基本方向上，且相距三格。"
		""
		"合成时，配方中的中心物品放在 Empowerer 上，其余四个方块按任意顺序放置在周围的 Display Stand 上。"
		""
		"四个展示架都需要提供能量才行。"
		""
		"&6⚠ 注意：所有配方材料均被消耗"
		"&6    在制作过程中。"
	]
	quest.6B0AC626ED56983E.quest_desc: [
		"正如名字所示，这个可怜的发电机并不怎么样。"
		""
		"它燃烧熔炉燃料来输出少量能量。这能让你起步；不过 Industrial Foregoing 使用标准的 FE 能量，因此可以接受任何兼容发电机的能量。"
	]
	quest.6B6898F3520BA8F7.quest_desc: [
		"有了原油和加工机器，基础升级应该就能实现了。高级升级需要大量铝，这个阶段的所有东西都需要。所以，用任何方法加快铝的生产都至关重要。"
		""
		"&a🛈 提示：升级仅在以下情况有效："
		"&a    持续运行的机器。"
		"&a    批量处理以制作物品"
		"&a    它们中的大多数。"
	]
	quest.6B966E04149C5962.quest_desc: [
		"想要一点创意自由？彩虹粉笔可以替换五芒星中的任何其他粉笔标记，让你随心所欲地设置颜色。"
		""
		"默认情况下，粉笔标记会循环所有颜色。用灵魂共鸣宝石右键点击可使其停止。然后用你选择的染料再次右键点击，即可设置所需颜色。"
		""
		"升级到虚空粉笔可以跳过循环步骤，但其他功能保持不变。"
		""
		"&6⚠ 注意：此仪式需要一个"
		"&6    献祭。触发仪式，如"
		"&6    如常，然后杀死所需的生物"
		"&6    五芒星附近。"
		""
		"&a🛈 提示：新制作的粉笔不会损坏！"
	]
	quest.6BDA1C1BE04D541A.quest_desc: [
		"制作维度存储系统是一个涉及多个仪式的多步骤过程，但这绝对值得付出努力。"
		""
		"执行器本身可容纳大量物品，并集成了合成台，让操作更便捷。"
		""
		"也可以通过稳定的虫洞远程访问，这意味着远程农场可以将物品直接输送回你的仓库，无需铺设长长的管道。"
		""
		"此外，最多可向其添加六个稳定器，以增加其可容纳的物品数量。"
		""
		"&a🛈 提示：将指向稳定器对准水晶"
		"&a    悬浮在Actuator的上方。"
	]
	quest.6BDA1C1BE04D541A.title: "维度存储（Dimensional Storage）"
	quest.6C662D615D3A1911.title: "法特玛的激励吸引力"
	quest.6CC9CDCCDE1426AC.quest_desc: [
		"这些模块用于拦截矩阵，以防止特定生物或行为。"
		""
		"• &7警告模组&r会在特定情况下通知玩家"
		"它们正在进入一个田地。"
		""
		"• &7Block Access Modules&r 会阻止"
		"阻止玩家挖掘诸如以下方块的行为："
		"机器或物品栏。"
		""
		"• &7Block Alter Module&r 会阻止破坏方块"
		"或者放置新的方块。"
		""
		"• &7非友好&r、&7非敌对&r，以及"
		"&7反人员模块&r 立即生效"
		"杀死它们所对应的生物类型；"
		"中立生物、敌对生物和玩家"
		"分别对应。"
		""
		"• &7反生成模块&r可阻止所有生物生成"
		"在该区域内生成生物。"
		""
		"• &7没收模块&r会偷走所有"
		"入侵玩家的物品中的"
		"物品栏。"
	]
	quest.6D68D3A5BD549EA3.quest_desc: [
		"[\"从这里开始，剩下的就很简单了；普通宝石硝石可以\",{ \"text\": \"重制\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"1E2BA13C53664E50\" },\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]} },\"用来生产硫磺铁，或者其他任何普通金属的硫磺。\"]"
		""
		"将这些硫磺孵化，从中生产出有用的锭。\"]"
	]
	quest.6D68D3A5BD549EA3.title: "改革与孵化"
	quest.6D9008779F35E755.quest_desc: [
		"安装了分解与收集模块后，场域投影仪本质上就变成了一座采石场。它会挖掘被场域覆盖的所有方块，并将它们储存在相邻的箱子里。"
		""
		"&a🛈 提示：使用反向模块来获取"
		"&a    农田区域内的方块！"
	]
	quest.6D9008779F35E755.title: "采石场"
	quest.6DAC9B8001A6D528.quest_desc: [
		"菌丝反应堆是一种特殊的发电形式，能产生巨大的能量。"
		""
		"要使其运行，你必须同时运行所有十六种类型的菌丝体发电机。"
		""
		"这可能会相当具有挑战性，因为你需要提供非常奇特的材料来运行它们，从下界之星和龙之息到药水与烟花。"
	]
	quest.6DE4258F18A7A321.quest_desc: [
		"欢迎来到 &6Enigmatica 10&r！希望您在这里玩得开心！:D"
		""
		"独自行动很危险。带上这些，开始你的冒险吧！"
		""
		"如果弄丢了变形工具或阿卡夏卷轴，别担心；新制作的会自带填充内容。"
		"&n                                                  &r"
		""
		"任务分为两种类型："
		""
		"{ \"text\": \"Discovering Enigmatica\", \"color\":\"green\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"44BD4C393C59F1CB\" },\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"Click Here\"}]} }"
		""
		"{ \"text\": \"Learning Mods\", \"color\":\"green\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"16C7D5478BF3D449\" },\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"Click Here\"}]} }"
	]
	quest.6DE4258F18A7A321.title: "欢迎！"
	quest.6E4554D07901967C.quest_desc: [
		"这可能是你此生所需的最后一套盔甲了。"
		""
		"自我修复、飞行、高跳，还有更多功能。"
		""
		"末影人将无视你，猪灵会崇拜你，而掠夺者则会憎恨你。"
		""
		"&a🛈 提示：将盔甲放入充电器中充电"
		"&a    查看所有升级的站点"
		"&a    每个物品都可以接受。"
	]
	quest.6E4554D07901967C.title: "气动盔甲"
	quest.6E4A0A33DB3C2B24.quest_desc: [
		"需要给常用的FE工具充能吗？只需站在Chargepad上。只要站在上面，背包里所有FE装备都会自动充能。"
		""
		"Mekanism 的能量电池和感应矩阵也能给物品充能，但不如 Chargepad 方便。"
	]
	quest.6E86B32C7ADE873D.quest_desc: ["一个简单的工作站，能让你更高效地制作某些组件。在某些情况下，比如电子元件，这是制作组件的唯一方法。"]
	quest.6E9C0B091D9F258A.quest_desc: [
		"材料成本太高？现在正是设置简易矿石处理流程的好时机。两次粉碎，一次熔炼。"
		""
		"特别是，粉碎煤炭和褐煤会产生大量燃料，用于运行你的蒸汽采矿钻头和锅炉。"
		""
		"&a🛈 提示：右键点击许多青铜级物品"
		"&a    使用火药的机器会短暂地"
		"&a    加快它们的速度。"
	]
	quest.6EB6E8DEEBB32911.quest_desc: [
		"要获得一个特性，必须将其注入血样中。所以我们首先需要弄一个血样。"
		""
		"你可以用空注射器获取自己的血液；只需按住右键，直到视野变黑。"
		""
		"要获得另一种生物的血液，你需要一个空的金属注射器。"
		""
		"样本获取后，用血液净化器处理，为改造做好准备。"
		""
		"&a🛈 提示：你需要站在非常靠近的地方"
		"&a    用来提取血液的生物。"
	]
	quest.6F1A7E1B49FCC4C0.quest_desc: [
		"复制始于将材料分解为其基本组成部分。"
		""
		"总共有八种，每种材料可能包含多种物品。建议先寻找容易获取的材料，转换成你需要的物质类型。"
		""
		"例如，生物群系农场是活体物质的绝佳可再生来源，而作物农场则能提供你所需的所有有机物。"
		"&n                                                  &r"
		""
		"放置分解器，然后将提供的物质管道和物质储罐连接到它上。"
		""
		"Matter Tanks 只能通过顶部和底部与管道连接。储罐可以堆叠，但仍能与网络相连。"
		""
		"复制也需要消耗大量能量，当连接到FE源时，可以使用物质管道来传输能量。"
		""
		"所有连接完成后，将物品投入分解器。物质会自动流出机器并储存在物质储罐中。此时，其他机器即可使用这些物质。"
		""
		"&a🛈 提示：将鼠标悬停在不同物品上并按住 Shift"
		"&a    看看它们是由什么物质构成的。"
	]
	quest.6F354A767B138CA3.quest_desc: [
		"想给你的奇可波建个漂亮的马厩吗？记得用稻草铺地，并在旁边放一个装满水的炼药锅。"
		""
		"这将计为“チョコボ小屋”，并缓慢治愈区域内受伤的チョコボ。"
	]
	quest.6F354A767B138CA3.title: "奇可宝围栏"
	quest.6F7A76841E49C6BD.quest_desc: [
		"无尽之粒是 Ender IO 整个进阶流程中都能找到的基础可再生资源。"
		""
		"手动制作并不困难，但可能有点繁琐。因此，建议找到一种自动化此过程的方法。"
		""
		"简而言之，你需要找到一种自动点燃火焰的方法。"
		"&n                                                  &r"
		""
		"在深板岩或基岩上点燃火焰并稍作等待。火焰会熄灭，并生成一些谷物。"
		""
		"&a🛈 提示：在执行配方时，在"
		"&a    深层板岩，任何能产出的方块"
		"&a    一粒谷物将转化为鹅卵石。"
	]
	quest.6F8C048404EAF9FF.quest_desc: [
		"自动合成是应用能源的核心部分，能完成所需物品的所有子合成步骤。"
		"当然，在处理其他模组中更复杂的配方时，这会变得非常有用。"
		""
		"模式终端用于在应用能源系统中设置自动合成。"
		""
		"要自动合成任何物品，系统必须先学会配方。这些配方在配方编码终端中配置。"
		""
		"这些模式必须放入模式提供器中。可以直接在提供器处操作，但模式访问终端也能让你在一个地方轻松管理所有模式。"
		"&n                                                  &r"
		""
		"我们不会在任务中详细讲解自动合成，AE指南中已有详尽说明。不过，我们会提及几个要点。"
		""
		"&a🛈 提示：电缆组件无法被"
		"&a    放置在密集电缆上。"
	]
	quest.70122FCB0A26D96B.quest_desc: [
		"在某些生物群系中，你可能见过一些看起来很可疑的深板岩巨石。它们看似是获取早期资源的捷径，但巨石下却藏着一大笔宝藏。"
		""
		"在它们下方直挖到基岩，你会发现一个装满燃料或油的小空腔。在这些液体下方，嵌入基岩中的就是资源节点。"
		""
		"在这些特殊节点上方放置一个基岩提取器，即可无限开采。机器会覆盖3x3的区域，所以尽量让尽可能多的资源节点位于一台机器下方。"
		""
		"要驱动这台机器，你需要将 Enderic 激光连接到它。其他方式无法为其供电。"
		""
		"物品只能通过管道或其他物流系统存取。正面有一个圆形插槽用于此目的。"
	]
	quest.702F469E14D94B63.title: "Uphyxes 倒置塔"
	quest.705C37F9694E6FEA.quest_desc: [
		"Fluid Modules for Modular Routers 允许路由器双向传输化学物质。"
		""
		"路由器需要某种缓冲储罐才能工作，例如化学储罐。"
	]
	quest.70C8E621A4B76BD6.quest_desc: [
		"使用EV能源舱，只需更换舱门即可轻松升级大型蒸汽涡轮机。这将使其发挥全部潜力，并在蒸汽充足的情况下立即将输出功率翻倍。"
		"&n                                                  &r"
		""
		"随着EV电网的扩展，现有的HV机器可以轻松升级为使用EV运行。"
		""
		"高度先进的机器外壳可以右键点击机器进行升级，或者打开机器GUI并在插槽中安装。"
		""
		"&6⚠ 注意：机器在以下情况下根本无法运行"
		"&6    使用了错误的等级能量。"
	]
	quest.710D7615763E9945.quest_desc: [
		"誓言和承诺拥有力量，但它们也是有代价的。"
		""
		"灵魂绑定熔炉用于签订此类契约，具体细节可在《神秘学百科全书》中查阅。"
		""
		"请谨慎选择，因为违背契约并非易事。"
		"&n"
		""
		"要开始仪式，将中心物品放入火盆，再按配方顺序放置周围的所有物品。操作正确后，所有物品会从环绕火盆变为环绕火盆上方。"
		""
		"物品准备好后，右键点击并用以太点燃火盆。最后，再右键点击火盆，等待动画完成。"
	]
	quest.710D7615763E9945.title: "Geasa"
	quest.7163E7EBDB861D72.quest_desc: [
		"物品收集器没有高级版本，相反，这一等级的工具都具有将物品传送到绑定方块的能力。"
		""
		"运行刷怪塔？使用绑定到存储系统的 Celestigem 剑，所有掉落物都会自动存入。"
		""
		"要搭建树木农场吗？使用 Celestigem 斧将原木传送到储物箱。"
		""
		"用 Celestigem 锄头翻耕过的农田会自动收获，并将掉落物传送到绑定存储中。真方便！"
	]
	quest.7163E7EBDB861D72.title: "高级物品收集器？Advanced Item Collector?"
	quest.717CCCD239144E0B.quest_desc: [
		"欢迎来到 EvilCraft！"
		""
		"在这里，你将为纯粹的邪恶而去做邪恶的事情。"
		""
		"哦，还有好多血。血多得要命。"
		""
		"不，说真的，这里的血腥程度可比电影《闪灵》里的那一幕夸张多了。"
		""
		"【模组自带一本说明书，但你也可以在他们的\",{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://evilcraft.rubensworks.net/book/\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"Wiki\",\"underlined\":true},\".\"]"
	]
	quest.717CCCD239144E0B.title: "EvilCraft"
	quest.7220A9770C3E1C6F.quest_desc: [
		"刻印机是你用来制作合成组件的主要机器；各种处理器在应用能源学中广泛使用。"
		""
		"你可能希望某天能自动化它们，毕竟这就是Applied Energistics的意义所在。"
		""
		"不过，目前用刻印机批量合成还是很简单的。物品可以通过管道或漏斗输入，机器本身也可以设置为向相邻的容器自动输出。"
		""
		"&a🛈 提示：刻印机可以直接供电"
		"&a    来自任何FE或EU来源。"
	]
	quest.72591AAEA1E6DE38.quest_desc: [
		"粒子加速器有一些隐藏的交互，玩起来会很有趣。"
		""
		"例如，若将两个火药撞击产生的能量超过 &65000J&r，你将创造一个 &cHellish Incursion&r 和通往下界的传送门。"
		""
		"同样，碰撞两个超过 &610000J&r 的末影珍珠会生成一个 &a末影突袭&r 和通往末地的传送门。"
		""
		"最后，如果向这些传送门中投掷能量大于 &615000J&r 的物品，就会生成一个黑洞，它会迅速吞噬周围的方块，并持续喷射出中微子流。"
		""
		"在附近设置塔基翁吸收器，这些高能粒子或许能被吸收并转化为可用能源。"
	]
	quest.72591AAEA1E6DE38.title: "黑洞之力"
	quest.7259D617AAFEF85B.title: "Eziveus的幽魂强迫症"
	quest.72BD11ED57B26EA2.quest_desc: [
		"使用各种野性召唤，可以获得一些非常特殊的材料，包括陶器碎片、锻造模板以及上面显示的所有物品。"
		""
		"需要凋零头颅或凋零玫瑰吗？召唤野性狩猎吧！"
		""
		"不死图腾？召唤一场迷你掠夺者围攻！"
		""
		"在寻找稀有的海龟或嗅探者蛋吗？或许想要一把三叉戟？召唤一群野生的溺尸吧！"
		""
		"无论如何，准备好战斗吧，因为这些召唤生物不会单独出现。"
		""
		"&6⚠ 注意：这些仪式通常需要"
		"&6    献祭。触发仪式，如"
		"&6    如常，然后杀死指定的生物"
		"&6    五芒星附近。"
	]
	quest.72BD11ED57B26EA2.title: "野生材料"
	quest.72C1A824063BAFA3.quest_desc: [
		"自然空间的守护者，Drygmies 会游荡各地照料动物以维持平衡。如果你给他们一个 Wilden Horn，表明你维护秩序的意愿，他们就会自愿加入你的动物园。"
		""
		"作为回报，Drygmy 将帮助你收集动物和怪物掉落的各种物品。"
		"&n                                                  &r"
		""
		"右键点击附有它们的护身符的苔石，即可创建它们的家园。将多种不同的生物安置在它们的家园中，会让它们更开心、更高效。"
		""
		"&a🛈 提示：Drygmies 会与 mob 互动"
		"&a    在收容罐中！"
	]
	quest.730D1F506B88FEEF.quest_desc: [
		"采石场运行，蒸汽可能再次短缺，而运行涡轮机发电后，短缺会更严重。现在升级到大型蒸汽锅炉能省去未来的麻烦。"
		""
		"和小型锅炉一样，这个多区块结构也能用固体燃料，比如现在肯定很充足的褐煤粉。它没什么别的用途，不如拿来当燃料吧。"
		""
		"&a🛈 提示：先放置控制器方块，然后"
		"&a    手持扳手或撬棍即可查看"
		"&a    结构或有效位置用于"
		"&a    孵化口。"
	]
	quest.7327D905FE8B38FC.quest_desc: [
		"物品终端将 Pretty Pipes 网络变成了一个完整的物品管理系统，让你可以在一个中心位置访问整个网络中的物品。"
		""
		"甚至可以升级为带有集成合成网格的合成终端。"
		""
		"安装并启动管道增压器会大大提高物品的取回速度，但建议保持存储网络管道较短，以确保在请求时物品能迅速送达。"
		"&n                                                  &r"
		""
		"最后，通过使用制作模块，这些终端可以按需请求制作物品。"
		""
		"只需将Crafting Module编程到机器旁的管道段中，它会在需要时插入材料。"
		""
		"终端需要另一个未配置的管道段来取回物品。"
	]
	quest.7327D905FE8B38FC.title: "精美管道模组"
	quest.73430E6390B7D125.title: "塞维拉的永久监禁"
	quest.73A71BBB9D9168B0.quest_desc: [
		"与Apothic Spawners完美搭配，Spirit Reanimator可用于生成各种生物的刷怪蛋。"
		""
		"首先，用永恒闭合箱捕捉这个生物的魂魄。"
		""
		"接下来，用鸡蛋在 Reanimator 中插入它。"
		""
		"最后，提供血液并等待即可。"
		""
		"获得刷怪蛋后，右键点击刷怪器即可设置刷怪类型。"
	]
	quest.73D70F80C3AE999C.quest_desc: [
		"有谁不爱把东西狠狠地扔向空中呢？"
		""
		"空气大炮正如其名，可将物品发射到世界地面，或直接送入物品栏中。"
		""
		"经过适当升级，它们还可以用来发射附近的实体，或者充当远程投掷器。想玩TNT大炮吗？"
	]
	quest.73F9A5F65B350A09.quest_desc: [
		"用白粉笔，我们只能练习最基础的召唤术。"
		""
		"获取一些萤石并制作黄金粉笔，将开启附身和最终的灌注仪式，从而将灵魂分别束缚到其他实体或物品中。"
		"&n                                                  &r"
		""
		"主世界周围可能有一些萤石，不过最简单的办法还是去下界取一小块。"
		""
		"&a🛈 提示：新制作的粉笔不会损坏！"
	]
	quest.73F9A5F65B350A09.title: "附身仪式：黄金粉笔"
	quest.7431B398FFDF3DCA.quest_desc: [
		"将突变药水设置为正确的生物类型后，你就可以进行下一步了。"
		""
		"这瓶药水将再次与一个关键物品在高级孵化器中结合。查看你的突变药水的使用说明，了解所需物品。我们的突变药水需要一把下界合金镐。"
		""
		"这个过程很慢，任何试图加速的尝试都会导致成功率降低。"
		"将紫颂果添加到高级孵化器的右侧槽位会增加你的成功率。"
		""
		"&a🛈 提示：在寻找这些配方时，"
		"&a    检查药水的使用次数，使用次数为"
		"&a    突变。"
		""
		"&c⚠ 警告：Overclockers 和 Time in a Box 模组存在冲突，可能导致崩溃。请禁用其中一个模组。"
		"&c    瓶子将极大地提高两者的效率"
		"&c    失败率。"
		"&c    耐心点，小蚱蜢！"
	]
	quest.7431B398FFDF3DCA.title: "变异（Mutation）"
	quest.74463B3FC2D297AC.quest_desc: [
		"欢迎来到 PneumaticCraft，一个围绕压缩空气和热量来执行各种任务的强大物流与自动化模组。"
		""
		"该模组附带一本详尽的指南，涵盖了模组的方方面面。因此，任务将重点介绍亮点，引导你完成基础进阶。"
		""
		"&a🛈 提示：记得经常查看工具提示"
		"&a    快速了解物品用法的小提示"
		"&a    或者方块都可以使用。"
	]
	quest.74463B3FC2D297AC.title: "PneumaticCraft"
	quest.747635545752310E.quest_desc: ["将结晶化油菜籽投入精炼油菜油中可生成结晶化油，这是一种更高效、燃烧时间更长、每刻能量更高的燃料。"]
	quest.747635545752310E.title: "结晶油的生产流程如下："
	quest.748B07D863BF549A.quest_desc: [
		"生物发电机能高效燃烧生物燃料，产生大量电力。"
		""
		"随着机器开始消耗更多电力，这可以作为从被动发电向主动发电过渡的不错中间步骤。"
	]
	quest.748E8D2D5F7E2D5D.quest_desc: [
		"主要用于制造生物柴油，流体混合器是可再生能源产品的核心部分。"
		""
		"考虑建立一条完整的生产线，使用生物柴油生产塑料和润滑油，以及一种良好且可再生的燃料来源。"
	]
	quest.748E8D2D5F7E2D5D.title: "生物柴油"
	quest.7501455F3C24E4E9.quest_desc: [
		"动态储罐是一个简单的多区块储罐，可以储存任何流体，包括Mekanism的气体。"
		""
		"坦克本身是一个巨大的自由形态的多方块结构。不过，关于放置规则和最大尺寸限制，可以在他们的维基动态坦克页面找到相关信息："
		""
		"{ \"text\": \"Mekanism Wiki: Dynamic Tank\", \"color\":\"green\", \"underlined\": true, \"clickEvent\": { \"action\": \"open_url\", \"value\": \"https://wiki.aidancbrady.com/wiki/Dynamic_Tank\" } }"
		""
		"&a🛈 提示：E10 包含一个 Mekanism 多用途"
		"&a    EMI 中的区块规划器！"
	]
	quest.750FEAA1A27892FF.quest_desc: [
		"接下来，借助 Hedyrin 的诱饵，我们也可以开始召唤伙伴了。"
		""
		"这些有益的生物是灵体与我们世界生物融合的结果，能提供多种非常实用的能力。"
		""
		"接下来的页面将介绍这些能力的一些亮点。"
		""
		"有关这些及其他附灵的完整详情，请参阅附灵仪式下的灵体词典。"
		""
		"&6⚠ 注意：这些仪式通常需要"
		"&6    献祭。触发仪式，如"
		"&6    如常，然后杀死指定的生物"
		"&6    五芒星附近。"
		""
		"{@pagebreak}"
		"战斗"
		"• 木乃伊：与你并肩作战，通过"
		"把东西一拳打没，让它们彻底完蛋"
		""
		"• Beholder: 用以下方式瓦解敌人"
		"魔法激光束"
		"{@pagebreak}"
		"实用工具"
		"• 守卫：相当于一个会移动的图腾之"
		"Undying，失去肢体而不是生命，而不是"
		"你正在失去生命，生命值在下降"
		""
		"• 贪婪：像磁铁一样收集物品"
		""
		"• Beaver: 使你能够破坏木头"
		"更快"
		""
		"• 铁匠：修理装备和"
		"为伙伴生物应用升级效果"
		"{@pagebreak}"
		"增益效果"
		"• Drikwing: 多重跳跃"
		"跳跃增强"
		"缓慢下落"
		""
		"• 龙：增加了经验值获取量"
		""
		"• 蝙蝠：夜视能力"
		""
		"• 克苏鲁：水下呼吸"
		""
		"• 鹿：跳跃高度"
		""
		"• 恶魔：火焰抗性"
	]
	quest.750FEAA1A27892FF.title: "伙伴生物"
	quest.752888EAF2861EB4.quest_desc: ["以下是 Enigmatica 10 中提供的各种物品传输方式。"]
	quest.752888EAF2861EB4.title: "物品"
	quest.752DB3D467FFB259.quest_desc: [
		"瓶装气场主要用于自然之气的制作配方中，不过它也有一些其他用途。"
		""
		"获取方法很简单，用瓶塞右键即可将其装满本地的灵气。"
		""
		"&6⚠ 注意：不同维度都有各自的"
		"&6    它们各自拥有独特的光环类型。"
	]
	quest.752DB3D467FFB259.title: "瓶装气场 (Bottled Aura)"
	quest.75765D97E7ACC6FC.quest_desc: [
		"入门部分，你首先需要制作熔炉。有了它，你就能制造出后续更强大机器所需的各类合金。"
		"&n                                                  &r"
		""
		"和大多数 OriTech 机器一样，这是一个多区块机器。"
		""
		"放置熔炉方块，然后右键点击它以查看机器核心必须放置的位置。"
		""
		"放置完所有所需的 Cores 后，再次右键 Foundry 即可完成结构。"
		""
		"&a🛈 Tip: Right-Click the machine with the "
		"&a    自动放置的核心方块"
		"&a为你收集它们！"
	]
	quest.760910BF48876D8E.quest_desc: ["以下是 Enigmatica 10 中可用的各种化学传输方式。"]
	quest.760910BF48876D8E.title: "化学品和气体"
	quest.760BD47C6B67D645.quest_desc: [
		"进步永无止境。随着工厂的发展，电力消耗将持续增长。"
		""
		"与高压等级一样，建议使用超导主干线为独立的EV子网络供电。"
		""
		"可以考虑多种类似这样的设置："
		""
		"&e蒸汽生产"
		"&e╰┈➤ &3高级涡轮机"
		"&3╰┈➤ &aEV 至超导变压器"
		"&a╰┈➤ &b超导电缆"
		"&b╰┈➤ &a超导体至EV变压器"
		"&a╰┈➤ &3机器集群"
		""
		"&6⚠ 注意：保留你的EV子网络"
		"&6    分开放置，这样它们就不会被限制了"
		"&6    最大传输速率。"
	]
	quest.76467C03A27E54BD.quest_desc: [
		"在AA中配置多台机器，可以用红石火把或指南针右键点击它们。"
		""
		"使用模组时最好将这些放在手边，以便随时快速配置机器。"
	]
	quest.76467C03A27E54BD.title: "机器配置"
	quest.76695BF2B0E70087.quest_desc: [
		"快速进入下界一趟后，你就能把你的 Goo 升级为 Blazebloom Goo。"
		""
		"本阶的煤炭需要用前一阶的煤炭块获取，而烈焰金锭则由金块转化而来。"
		""
		"&a🛈 提示：更高等级的Goos会完成所有"
		"&a    更快地制作低阶配方。"
		""
		"&6⚠ 注意：Goo 很饿，需要被喂食"
		"&6    开始工作！"
		""
		"&6    Right-Click with items to activate it."
		"&6    要找出哪些物品有效，请搜索"
		"&3    #goo_revive_tier_2&r&6 在EMI中！"
	]
	quest.770EE92EA4CF973C.quest_desc: [
		"升级到Iesnium镐能让我们比Infused镐更轻松地获得更多Iesnium，因为它更耐用，还能开采下界的隐藏矿石。"
		""
		"毕竟，要设置一个维度矿井，我们还需要更多材料。"
		""
		"挖掘 Iesnium 时，获得的矿石方块可以用任意镐放置和再次破坏，以获得原始 Iesnium。此过程会受 Fortune 效果影响。"
	]
	quest.773105FB99015746.quest_desc: [
		"结果基座是我们产出物生成的地方。"
		"&n                                                  &r"
		""
		"将结果基座放置在你的工作区域内。"
		""
		"你可以连接任何 Logistics 来提取结果，随你喜欢。"
	]
	quest.7750C6E87B1EBF43.quest_desc: [
		"朴素的浸染室或许是新艺术中最重要的一件装置。"
		""
		"有了它，你就能生成未来所有合成所需的源宝石和源质了。"
		""
		"目前，我们需要先将一些青金石转换成源宝石。"
		""
		"&a🛈 提示：来源可选！"
	]
	quest.77965E43351C263C.quest_desc: [
		"无论是饲养动物还是种植作物，AA 都有几个方块可以提供帮助。"
		""
		"自动喂食器会喂食自身周围四格半径内的动物，当动物数量过多时会停止。"
		""
		"同样，农夫会自动在其前方9x9的区域里翻土并播种。"
	]
	quest.77965E43351C263C.title: "简易农场"
	quest.779AE777BBC999AD.quest_desc: [
		"执行向众神献祭仪式将解锁用于更强大装置的新材料。"
		""
		"要使用祭坛，需要在周围放置两圈同心圆的花朵。"
		""
		"请参阅自然光环之书，查看它们的放置预览。"
		""
		"结构搭建好后，将材料放入碗中，再向地面投掷一个召唤之灵。片刻后，闪电会劈下，合成的产物便会从天而降。"
		""
		"&6⚠ 注意：请在有...的区域进行此操作"
		"&6    完全开放天空视野！"
		""
		"&a🛈 提示：单个 Spirit of Calling 可以"
		"&a    最多可转换 16 个物品！"
	]
	quest.779AE777BBC999AD.title: "向众神献上祭品"
	quest.77A66ADAB0845804.quest_desc: [
		"Macaw’s Mods 是一套装饰性模组合集，几乎适用于任何建筑。Enigmatica 10 目前包含："
		""
		"• 鹦鹉螺的桥 (Macaw’s Bridges)"
		"• 鹦鹉螺门 (Macaw’s Doors)"
		"• Macaw’s Fences and Walls"
		"• Macaw’s Lights and Lamps"
		"• 鹦鹉螺之路与铺路石模组"
		"• 鹦鹉螺的活板门"
		""
		"&a🛈 提示：在 EMI 中搜索 &3@mcw&r &a以"
		"&a    探索更多未知。"
	]
	quest.77A66ADAB0845804.title: "Macaw's Mods"
	quest.77B7679AFE090140.quest_desc: [
		"硬化血块来自放置时间过长的血液。"
		""
		"在世界中放置一桶血液并等待其凝固。凝固后，手持燧石和钢可以将其打破，获得一些血液碎片。"
		""
		"&a🛈 提示：使用丝绸之触来采集方块"
		"&a    然后熔炼以获得更高的产量！"
	]
	quest.78B1BC9540590D17.quest_desc: [
		"需要一个地方来储存你辛苦赚来的经验吗？"
		""
		"试试体验持有者吧。"
		""
		"这个便捷的设备能帮你维持特定的经验值，还能储存海量经验。任何附魔区都少不了它。"
	]
	quest.78D83E33F82D6015.quest_desc: [
		"所有电动机器都有一个效率评级，运行时间越长，评级越高。这使它们能根据输入速率自我平衡。"
		""
		"不过，有些机器启动很慢，你可能不想为了启动一个流程而等待。用装有润滑剂的桶或储罐右键机器，即可立即提升其效率！"
		""
		"只要机器不停运转，效率提升就会持续。因此，最适合用于像采石场或生产线这类需要不间断运行的设施。"
	]
	quest.7973D06875662CFE.quest_desc: [
		"你可能注意到，当光环强度过高时，许多光环发生器会停止工作。阈值因设备而异，但确实存在。"
		""
		"The Creational Catalyst removes this limit. "
		""
		"只需将其放置在发电机方块下方，即可解锁其全部潜力。"
	]
	quest.7992122E44D163DB.quest_desc: [
		"最终，核废料将完全转化为反物质，不会留下任何放射性残留物。该过程在超临界相移器（简称 SPS）中进行。"
		""
		"一颗粒子反物质需要一万个铀锭，所以这个过程绝非易事。你至少需要稳定的铀和萤石来源才能制造出一颗粒子。"
		""
		"反物质本身可用于制作机甲服的最强升级，以及在反质子核合成器中转换材料。"
		"&n                                                 &r"
		""
		"超临界相移器本身是一个巨大的自由形态多方块结构。"
		""
		"【放置规则和最大尺寸限制，请访问他们的维基页面了解更多信息：】{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://wiki.aidancbrady.com/wiki/Supercritical_Phase_Shifter\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"Supercritical Phase Shifter\",\"underlined\":true}]"
		""
		"&a🛈 提示：E10 包含一个 Mekanism 多用途"
		"&a    EMI 中的区块规划器！"
	]
	quest.7992122E44D163DB.title: "超临界相移器"
	quest.79951647661D4B52.quest_desc: [
		"深入地下，勇闯远古城市的黑暗环境，获取本阶段所需的黏液材料。"
		""
		"本阶的煤炭需用前一阶的煤炭块获取，而日蚀合金锭则由下界合金块转化而成。"
		""
		"&a🛈 提示：更高等级的Goos会完成所有"
		"&a    更快地制作低阶配方。"
		""
		"&6⚠ 注意：Goo 很饿，需要被喂食"
		"&6    开始工作！"
		""
		"&6    右键点击物品以激活它。"
		"&6    要找出哪些物品有效，请搜索"
		"&3    #goo_revive_tier_4&r&6 在EMI中！"
	]
	quest.79A6EED9C2D433F1.quest_desc: [
		"Djinni Crushers 比它们的 Foliot 表亲要强大得多。"
		""
		"因此，它们能更快更高效地工作，粉碎矿石的产量比Foliot更高。"
		""
		"在研究 Occultism 的更高级别时，请务必将你的 Crusher Spirit 升级到最高级别，以发挥其最大功效！"
	]
	quest.79FA7B5854C9606F.quest_desc: [
		"反重力球和方块都能抑制特定基因，即物品吸引和经验值吸引特性。"
		""
		"将方块放置在你不希望被随机吸走物品的区域。或者随身携带该球体，随时启用或禁用此特性。右键单击即可切换功能。"
	]
	quest.7AA55D33A2BD1E6E.quest_desc: [
		"工业榨汁机主要用于获取植物油，也是高级合成中所需的HOP石墨的唯一来源。"
		"&n"
		""
		"建造此结构的指南可在工程师手册中找到。"
		""
		"或者，查看来自 Create 的 Schematic Table 或 \",{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://blockprints.io/user/MuteTiefling\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"BlockPrints\",\"underlined\":true},\" 以获取更好的建造指南。\"]"
		""
		"&a🛈 提示：工程师手册高亮显示"
		"&a    在&c红色&r&a中的形成方块。"
	]
	quest.7ADBC282C9692EDE.quest_desc: ["电缆外罩是一种通用外罩，几乎可以覆盖任何管道！"]
	quest.7ADBC282C9692EDE.title: "电缆外立面"
	quest.7B5EB5D6F749520F.quest_desc: [
		"用水冷却裂变反应堆有其局限性，无法像钠等更好的冷却剂那样让反应堆以最佳速度安全运行。"
		""
		"不过，使用钠冷却需要热电锅炉来产生蒸汽。它将加热钠产生的热量转化为蒸汽，使冷却后的钠被送回反应堆。蒸汽随后经过涡轮机回收为水，再循环回锅炉。"
		"&n                                                 &r"
		""
		"锅炉本身是一个巨大的自由形态的多方块结构。"
		""
		"【放置规则和最大尺寸限制，请访问他们的维基页面了解更多信息：】{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://wiki.aidancbrady.com/wiki/Thermoelectric_Boiler\"},\"color\":\"green\",\"hoverEvent\":{\"action\":\"show_text\",\"value\":[{\"text\":\"点击此处\"}]},\"text\":\"Thermoelectric Boiler\",\"underlined\":true}]"
		""
		"&a🛈 提示：E10 包含一个 Mekanism 多用途"
		"&a    EMI 中的区块规划器！"
	]
	quest.7B5EB5D6F749520F.title: "热电锅炉"
	quest.7B6267C141FE9B83.quest_desc: [
		"这些时髦的海洋小生物擅长从沙子里挖出失落的宝藏。"
		""
		"为他们建个小家，并确保提供充足的沙子或砾石，他们就会整天在里面筛选稀有的文物。"
	]
	quest.7BEC7AF0176EA162.quest_desc: [
		"流体存储单元最好在单元工作台锁定其类型，并为每种要存储的流体分配一个单元。"
		""
		"对于可能无限生成的流体，如岩浆或水，溢流销毁卡可以防止接口堵塞，任何多余的流体都将被直接清除。"
	]
	quest.7BEE7FAD21AFEB68.quest_desc: [
		"有了EBF的硅和铝，电子电路和MV电子元件就向我们敞开了大门。"
		""
		"与模拟电路一样，这里的组件手动制作成本较高，不过很快就会有升级选项可用。"
	]
	quest.7BEE7FAD21AFEB68.title: "电子线路系统 (Electronic Circuitry)"
	quest.7BF8A53EADB35F49.title: "阿布拉的魔法卷轴"
	quest.7C0E7547D266C45D.quest_desc: ["Plus Spirit Attuned Gems"]
	quest.7C0E7547D266C45D.title: "阿布拉的指令召唤术"
	quest.7C174D5E3A7084B6.quest_desc: ["移动到阿弗里特破碎机"]
	quest.7C27093E25633B9F.quest_desc: [
		"水银流体运输系统是一个用于运输流体的简单物流网络。"
		""
		"放置器与提取器可以放置在机器或其他物品栏旁，然后用水星铜线连接起来。"
		""
		"水银连接节点允许多条导线汇聚成更广泛的网络，并延长单根导线的覆盖范围。"
	]
	quest.7C27093E25633B9F.title: "水银流体节点"
	quest.7C3C0E6AC71F621B.quest_desc: ["物品分配器会从上方物品栏中取物，并均匀分配到两侧的每个物品栏中。"]
	quest.7C71090829F8748A.quest_desc: ["LaserIO 的能源卡允许激光节点传输 FE。"]
	quest.7D4E0F2BF07D3223.quest_desc: [
		"制作紫色粉笔需要一些更奇特的材料。不过，不必为了末地石就跑到末地去。"
		""
		"借助 Hedyrin 的诱饵，我们能够召唤出 Foliot 来附身一只末影螨。杀死这只末影螨后，它总会掉落我们所需的末地石。"
		"&n                                                  &r"
		""
		"在《灵界词典》中找到 Hedyrin 的诱饵，然后点击预览中的 👁 以在现实中查看。"
		""
		"&a🛈 提示：单个粉笔的形状"
		"&a    标记是随机的，并且不会"
		"&a    影响仪式！"
		""
		"&6⚠ 注意：此仪式还需要你完成以下事项"
		"&6    使用或投掷鸡蛋后，再使用"
		"&6    触发仪式。"
	]
	quest.7D4E0F2BF07D3223.title: "附身生物：末影螨"
	quest.7D82585D50D7207A.quest_desc: [
		"欢迎来到Applied Energistics，一个功能强大的物流与存储模组，拥有完全集成的自动化合成系统，可与任何其他模组兼容。"
		""
		"下一章将指导你如何开始使用此模组以及一些基本概念。"
		""
		"我们还建议你查看模组自带的指南中内置的指南和教程。"
	]
	quest.7D82585D50D7207A.title: "Applied Energistics"
	quest.7F237202A5D7EFBD.quest_desc: [
		"Vanilla Plus Tools 添加的锤子和铲子能在 3x3 区域内破坏方块，是早期挖矿的绝佳选择。"
		""
		"&a🛈 提示：在 EMI 中搜索 &3@vanillaplus&r &a以"
		"&a    探索更多未知。"
	]
	quest.7F237202A5D7EFBD.title: "原版增强工具包"
	quest.7F2F9BE0C99BCFB7.quest_desc: [
		"生物燃料发电机能高效燃烧生物燃料，产生可观的电力。"
		""
		"其中几样应该能让你的机器正常运行，不会有问题。"
	]
	quest.7F445C22C528AC1F.quest_desc: [
		"Runewood Obelisks 用于加速 Spirit Altar，所以优先制作几个会很有帮助。"
		""
		"最多可放置四座方尖碑来加快合成速度，每座方尖碑都会缩短总合成时间。"
	]
	quest.7F829A1BFED304D0.quest_desc: [
		"没有魔法驱动的实用装置，魔法还有什么意义呢？"
		""
		"以下将重点介绍 Nature's Aura 中一些更有趣的装置。何时何地适合将它们用于你的基地，就由你自己来决定！"
		""
		"有关如何使用这些设备的完整说明，请记得查阅《自然灵气之书》！"
	]
	quest.7F829A1BFED304D0.title: "自然装置"
	quest.7F8B4427A8FFC0B7.quest_desc: [
		"刀枪不入、随时待战的 Iesnium Golem 与铁傀儡如出一辙。"
		""
		"它们能快速消灭任何生成的生物，是任何生物繁殖器的绝佳补充。或者，在基地周围放置几个，赶走误闯入的任何生物。"
	]
	quest.7FAC3A637F82BFED.quest_desc: [
		"这些漂浮的小女巫朋友可以负责自动化标准的3x3合成台、酿造台，甚至是附魔台。"
		""
		"要获得用于制作护身符的 Wixie 代币，需要一点咒语技巧；基本上，你必须驱散一个生命值低于一半的女巫。"
		""
		"&6&n示例法术&r"
		""
		"&7村民转威克西&r"
		"&5投射物&r > &a滞留&r > &a闪电&r > &a驱散&r"
