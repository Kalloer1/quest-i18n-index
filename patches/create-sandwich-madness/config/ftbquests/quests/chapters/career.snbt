	quests: [
		{
			description: [
				"{image:kubejs:textures/quests/mad_sandwich_empire.png width:64 height:64 align:center}"
				"尊敬的申请人："
				""
				"恭喜你。在仔细审阅了你的申请并与你进行了面试之后，我们决定向你提供 Mad Sandwich Empire 的工作机会。"
				""
				"你将加入我们的团队，与敬业勤奋的员工一起，以最大利润为目标批量生产三明治。努力工作，你将获得晋升，解锁先进的机密技术，加速三明治的生产。"
				""
				"接受此提议后，你将发现自己位于分配给你的土地中央。你需要利用土地内的资源，实现三明治的最大化生产以获得最大利润。幸运的是，你的土地相当大（36亿平方公里）。我们期待看到你工作的成果。"
				""
				"此致，敬礼，"
				""
				"{image:kubejs:textures/quests/signature.png width:300 height:100 align:center}"
				""
				"Snakemasterepic"
			]
			id: "0A6F031B45B5E57E"
			tasks: [{
				id: "00DC9393C40A0055"
				title: "新手引导"
				type: "checkmark"
			}]
			x: -0.5d
			y: 0.5d
		}
		{
