	quest.031183625E446959.quest_desc: [
		"英雄奖章会为你储存经验值。",
		"",
		"右键点击可回收层级。",
		"",
		"Shift + 右键可切换自动吸收模式。"
	],
	quest.038888DA99DA0045.quest_desc: [
		"绯红木林是普通绯红森林的更密集版本。",
		"",
		"墙壁苔藓和疣覆盖了地板和墙壁表面。"
	],
	quest.03FAF745AF18EBC7.quest_desc: [
		"Arcane Lanterns 添加了具有特殊能力和效果的魔法灯笼！",
		"",
		"要开始，先制作一个灯笼制造机，右键点击以放置正确的催化剂。",
		"",
		"所有催化剂都准备好后，在灯笼制造机顶部放置一个灯笼！"
	],
	quest.040A122866A75B6E.quest_desc: [
		"蛇杖能让周围的生物减速，使其忽略你，还能投掷能毒伤敌人的史莱姆球。",
		"",
		"它还可以从被击中的敌人身上吸取生命。"
	],
	quest.042E8502901FA625.quest_desc: [
		"地狱爪会吸收火焰伤害，但会消耗饥饿值。",
		"",
		"这不适用于岩浆。"
	],
	quest.043F16B5E5DDE024.quest_desc: [
		"下界丛林是众多新植物的家园。",
		"",
		"在这种情况下，地板是毒药，而不是岩浆。",
		"",
		"这里可以找到2套全新的完整木材套装。"
	],
	quest.05003E4DE713D28D.quest_desc: ["一个开放式的顶棚结构。"],
	quest.0513D028F1FCCF67.title: "悬崖峭壁",
	quest.069356452F5C793A.quest_desc: [
		"蠕虫、小鲶鱼和蚂蝗都可以用作鱼饵。",
		"",
		"鱼饵会增加钓到鱼的几率。"
	],
	quest.069356452F5C793A.title: "诱饵",
	quest.06B7DD78CCFB602E.quest_desc: [
		"末影法杖能让你用末影珍珠作为燃料，以各种方式传送。",
		"",
		"Shift + 右键可将法杖设为自动吸收末影珍珠。Shift + 鼠标滚轮可切换模式。",
		"",
		"珍珠模式会像往常一样投掷末影珍珠。",
		"",
		"眼模式会沿直线投掷末影珍珠，不受坠落影响。",
		"",
		"幻影模式允许你传送到一个节点。"
	],
	quest.06E5D2DC90CDF14E.quest_desc: ["抽屉的基础存储值的2倍。"],
	quest.0850840BBAE4FDC0.quest_desc: [
		"通过汉堡模组，你可以制作各种各样的汉堡和配菜！",
		"",
		"这些是用牛肉制作而成的物品。"
	],
	quest.0850840BBAE4FDC0.title: "牛肉汉堡包",
	quest.085A3D92D054294C.quest_desc: ["将编织皮革放在已填充的冰盆上右键即可制作出闪耀织物。"],
	quest.08BF7BFEE44BFCEB.quest_desc: [
		"找到一个试炼密室，与各种生物一较高下！",
		"",
		"使用钥匙解锁宝库，获取特殊奖励。",
		"",
		"想要更具挑战性、回报更丰厚的内容吗？",
		"",
		"携带不祥之兆效果进入，迎接不祥的试炼。"
	],
	quest.09074A0668C0A629.quest_desc: ["性别骨可用于更改你幼犬的性别。"],
	quest.09925DD2236E7CE5.quest_desc: [
		"Bliss 着色器已包含在 Sublime 中。",
		"",
		"如果可能的话，强烈建议开启着色器进行游玩。"
	],
	quest.09B65F1B9C13F0C4.quest_desc: ["禁制火炬是一种光源，能强行将所有生物从其区域驱逐出去。"],
	quest.0AD56074644EC3D0.quest_desc: ["抽屉的256倍基础存储值。"],
	quest.0AF1580B30A50EA5.quest_desc: [
		"在Sublime中，你可以接任务来获得奖励和增益效果！",
		"",
		"按 J 键打开选择菜单。",
		"",
		"你可以免费开始 2 个工作。",
		"",
		"掌握职业将解锁可供使用的特殊物品。"
	],
	quest.0BA65D0C8332AB8C.quest_desc: [
		"末地石熔炉可用于爆破矿石，获得更高的产出！",
		"",
		"它也被用来制造不同的金属合金！"
	],
	quest.0C02D9B6E4872336.quest_desc: [
		"发光草原上遍布着各种植物，包括Lumecorn。",
		"",
		"Lumecorn 可用于制作装饰性照明。"
	],
	quest.0C649F18D0221ABA.quest_desc: ["我这就去拿海龟汤，动作要快。"],
	quest.0CCCA200AF3D4FDD.quest_desc: [
		"永恒锭是在末地石熔炉中，将泰拉纳锭和下界合金锭结合制成的合金。",
		"",
		"Terminite Armor 可以在锻造台用 Aeternium Ingot 和锻造模板进行升级。"
	],
	quest.0CED719FD568A4ED.quest_desc: [
		"塔罗牌可以在所有维度的战利品箱中找到。",
		"",
		"塔罗牌组会将你找到的所有塔罗牌存储到一个奇物栏中。",
		"",
		"你可以按住塔罗牌并右键点击来启用或禁用它。"
	],
	quest.0CED719FD568A4ED.title: "塔罗牌（Tarot Cards）",
	quest.0D55B74F6CD0E720.title: "远",
	quest.0D717A9B6B59721E.quest_desc: [
		"合成终端可以让你查看、添加和移除所有与物品连接器相连的物品。",
		"",
		"它还包含一个合成网格。"
	],
	quest.0DC2CCC3FDDB95E6.quest_desc: [
		"鞘翅可以升级为附魔的鞘翅。",
		"",
		"使用锻造台组合一个鞘翅、一个永恒锭和一个永恒锻造模板。"
	],
	quest.0E1D03129CEC7DB6.quest_desc: ["与其他绯红生物群系相比，绯红发光森林非常明亮和金黄。"],
	quest.0FA7B6336EF4FB25.quest_desc: ["库存电缆用于将库存连接到远处的库存连接器。"],
	quest.0FB38D6CD15EFAC5.quest_desc: [
		"经典玩法的便携版。",
		"",
		"口袋唱片机可以播放你背包里的唱片和专辑！"
	],
	quest.100C6710EFE77F53.quest_desc: ["带门的封闭式帐篷。"],
	quest.10CAB4D384CF3306.quest_desc: [
		"要制作Aeternium工具和盔甲，需要一个Aeternium砧板！",
		"",
		"砧的功能相同，但需要 Aeternium 锻造模板。",
		"",
		"永恒锭的数值比下界合金更强。"
	],
	quest.1123329C32D898E8.quest_desc: [
		"Infernal Tear 可将物品转化为经验值。",
		"",
		"Shift + 右键点击，眼泪会吸收你最多的物品并将其转化为经验。",
		"",
		"JEI 可以显示转换率。"
	],
	quest.11367DD1E8C921E7.quest_subtitle: "更好的末地模组 (Better End)",
	quest.11367DD1E8C921E7.title: "Eo Dracona",
	quest.11FFF7EB44E7A593.quest_desc: [
		"传送板用于传送到另一个特定的传送板。",
		"",
		"放置后，Warp Plate 会生成一个 Attuned Shard。",
		"",
		"交换2个调谐碎片之间的传送板以实现双向旅行。",
		"",
		"传送板可以在不同维度之间使用。",
		"",
		"它们还会将生物传送走。"
	],
	quest.12BC9DD3638FE800.quest_desc: [
		"使用 Lyssa 之杖时，会收集区域内所有物品。",
		"",
		"收线后，它会把你钓到的所有物品都拉到你身边。",
		"",
		"你也可以在施放时按住 Shift 来解除敌人的武装。"
	],
	quest.13684D2080C422B4.quest_desc: ["下界蘑菇森林覆盖着新型温和的菌类和蘑菇。"],
	quest.149640D86AB45960.quest_desc: [
		"水晶山脉是一个令人惊叹的生物群，覆盖着水晶苔和巨大的水晶节点。",
		"",
		"采集晶矿节点可获得极光水晶碎片，用途广泛。"
	],
	quest.14C2D13EE4F19190.quest_desc: [
		"物品栏配置器可让你配置箱子与物品栏连接器之间的交互方式。",
		"",
		"它还会向你展示涂色方块。"
	],
	quest.1593BF21FC8238EF.quest_desc: [
		"特殊圣物组件，击杀史莱姆时有小概率掉落。",
		"",
		"它们也有很小的几率出现在战利品箱中。"
	],
	quest.15D7BD4FB11AB610.quest_desc: [
		"杀死冰学家（Iceologer）。",
		"",
		"他藏在雪域群系深处的一间小屋里。"
	],
	quest.160FB7205F8D517A.quest_desc: ["你可以自由地斜着放置栅栏、墙壁和窗户！"],
	quest.16307C5EC56614E2.quest_desc: [
		"加固滑翔翼能让你在空中缓慢漂浮。",
		"",
		"它的耐久度几乎是基础滑翔翼的三倍。"
	],
	quest.16437E2307E01EAE.quest_desc: [
		"啊，那些美好的旧时光！",
		"",
		"残暴者、猪灵和疣猪兽都在等待你的到来。",
		"",
		"总之，别碰任何东西。它们讨厌那样。"
	],
	quest.171E27287A928D42.quest_desc: [
		"当祭坛获得3个红石粉时，会生长出一个萤石块。",
		"",
		"虽然发光石块的生长需要很长时间，但这是一种无需前往下界就能获得发光石的方法。"
	],
	quest.1791C1060D2914EF.quest_subtitle: "更好的末地",
	quest.1791C1060D2914EF.title: "伸手摘星",
	quest.187098F9501AFBAF.title: "13",
	quest.18F244E3A6AFF803.quest_desc: [
		"干灌木丛的地板覆盖着植物和小型的卢西尼亚树。",
		"",
		"Lucernia 有一套完整的木制物品。"
	],
	quest.19030FEE06A43388.quest_desc: [
		"经典之作。",
		"",
		"播放音乐唱片和专辑。"
	],
	quest.1935F033F028AE2E.quest_desc: [
		"哨子可用于向你的幼犬下达不同指令。",
		"",
		"Shift + 右键点击将打开菜单并列出命令。"
	],
	quest.1A0AD3B7EB78D5E4.quest_desc: [
		"Floral Enchantment 为 Minecraft 中的每种花添加了花丛和花藤。",
		"",
		"它还添加了不同的罐子、篮子，甚至还有花冠。"
	],
	quest.1AC3CB471DA943D1.quest_desc: [
		"灯笼森林覆盖着红褐色的植被和苔藓。",
		"",
		"大型卢西尼亚树会生长出菲拉卢克斯，可以制成灯笼方块。"
	],
	quest.1B824FFEF93E8F90.quest_desc: [
		"高级磁铁会在半径11格内吸引物品和经验值。",
		"",
		"它也可以使用过滤器来筛选物品。"
	],
	quest.1B85AE4FB1684062.quest_desc: ["Terminite 锭是在末地石熔炉中用铁锭和末影尘合成的合金。"],
	quest.1C06D1D7513EA844.quest_desc: [
		"驯养信息请咨询Wildex。",
		"",
		"草原犬鼠会吠叫来提醒玩家注意威胁。",
		"",
		"它们还能从地里挖出随机的物品。"
	],
	quest.1C09EA37B3B2FAAC.title: "守卫者",
	quest.1C35323503A73652.quest_desc: [
		"Gowling Water 会对不死生物造成伤害。",
		"",
		"它的投掷方式与溅射药水相同。"
	],
	quest.1C3BE04B7C93195A.quest_desc: [
		"岩浆之地地面覆盖着岩浆块、红沙和熔岩。",
		"",
		"岩浆花和蓝色黑曜石也生成于此。"
	],
	quest.1C52130D7B3D7555.quest_desc: ["滑翔翼能让你在空中缓慢地漂浮。"],
	quest.1D7EB5D696221946.quest_desc: [
		"Energizer Stick 能为你的小狗提供以下物品：",
		"",
		"- 发光 (5秒)",
		"- 速度VII (10秒)",
		"- 再生 III (5秒)"
	],
	quest.1DF7AE2AB8DBDBFA.quest_desc: [
		"阿佛洛狄忒的药剂能让动物繁殖。",
		"",
		"它的投掷方式与溅射药水相同。"
	],
	quest.1F37C54A978CAF54.quest_desc: [
		"通过汉堡模组，你可以制作各种各样的汉堡和配菜！",
		"",
		"这些是用鳕鱼制作的物品。"
	],
	quest.1F37C54A978CAF54.title: "鳕鱼汉堡包",
	quest.2008101F77ACB001.quest_desc: [
		"去琥珀之地感受金色的光辉吧！",
		"",
		"螺旋树可以在这里找到，有一套完整的木材。",
		"",
		"你也可以在这里开采琥珀矿石。"
	],
	quest.200C285AFB47F915.quest_desc: [
		"要制作泰拉尼亚工具和盔甲，需要一个泰拉尼亚砧！",
		"",
		"锻造台的功能相同，但需要 Terminite 锻造模板。",
		"",
		"Terminite 的属性与钻石相似。"
	],
	quest.201AC918FE9DBE5C.quest_desc: [
		"无拘卷轴可用于传送到特定的传送石。",
		"",
		"右键点击传送石并持有卷轴即可绑定。",
		"",
		"卷轴在使用时会消耗掉。"
	],
	quest.209DAD58F8DBEBDE.quest_desc: [
		"使用驯养训练零食来训练一只被驯服的狼。",
		"",
		"这让你的狗几乎变得永生不死。",
		"",
		"Shift + 右键点击你的狗会打开它们的菜单！"
	],
	quest.210066B0C63574A8.quest_desc: [
		"MrCrayfish's Furniture mod 添加了超过 440 个功能性及装饰性方块。",
		"",
		"甚至还为灯和电灯开关提供了电力系统。",
		"",
		"在 JEI 中搜索 @refurbished。"
	],
	quest.213BEBA055430004.quest_desc: [
		"特殊圣物组件，击杀女巫时有小概率掉落。",
		"",
		"它们也有很小的几率出现在战利品箱中。"
	],
	quest.221372BE0147CB37.quest_desc: ["基础款，开放式帐篷。"],
	quest.228D1BB2CFB8A243.title: "熔岩鸡",
	quest.228DFD0E06B98C05.quest_desc: [
		"压缩抽屉是一种可以存储并将物品转换为压缩或非压缩形式的抽屉。",
		"",
		"例如，存储铁锭也会显示有多少铁块和铁粒可用。"
	],
	quest.228FB60B785CFB8C.quest_desc: [
		"&bShimmersteel Pickaxe&r:",
		"挖掘宝石和粉尘时有 Fortune III 效果。",
		"",
		"&bShimmersteel Axe&r:",
		"右键铜块以强制氧化。",
		"",
		"&bShimmersteel Shovel&r:",
		"与生俱来的丝绸之触",
		"",
		"&bShimmersteel Hoe&r:"
	],
	quest.228FB60B785CFB8C.title: "Shimmersteel 工具",
	quest.22B6DCD8B228CF3E.quest_desc: [
		"唱片盒最多可存放 8 张音乐唱片，方便存储！",
		"",
		"你也可以在唱片机上播放专辑，它会像播放列表一样工作！",
		"",
		"相册可以被染成任何颜色。"
	],
	quest.22F4EEDEB17FC12C.quest_desc: [
		"驯养信息请咨询Wildex。",
		"",
		"Vicuna 可以剪出黄色、橙色、白色或棕色的羊毛。"
	],
	quest.230DA0C79442F300.quest_desc: [
		"驯养信息请咨询野性指数。",
		"",
		"春兔可以挖出随机物品。",
		"",
		"它们还能在小范围内阻止搜索行为。",
		"",
		"它们会发出尖锐的叫声，提醒你附近有稀有方块（如绿宝石、钻石、紫水晶等）。"
	],
	quest.2385042AE3090C27.quest_desc: ["放置在水上时，生育睡莲会使附近的所有植物被动生长得更快。"],
	quest.23BB79B3EEFC0999.quest_desc: [
		"疣体森林覆盖着下界疣。",
		"",
		"可以在这里找到一个全新的完整木材套装。"
	],
	quest.2445ED77E1F5828C.quest_desc: ["按 M 键打开世界地图。"],
	quest.245F653701C5B2B3.quest_desc: ["只是在办公室里不要用微波炉加热它。"],
	quest.24E2F25D08AD3F8D.quest_desc: [
		"灵魂平原是一种覆盖着灵魂沙和一种新方块——灵魂沙岩的生物群系。",
		"",
		"灵魂沙岩是一种可以制成砖块和墙壁的装饰性方块。"
	],
	quest.2583F43DEAF66CF5.quest_desc: [
		"Beautify 添加了可为你的建筑增添功能的定制装饰方块。",
		"",
		"新灯、格栅、花盆、百叶窗，还有更多内容！"
	],
	quest.25E19B8AC325B505.quest_desc: [
		"旧真菌林生物群系覆盖着更多的真菌。",
		"",
		"整个地形中都有巨大的棕色和红色蘑菇。"
	],
	quest.26636F409E53D141.quest_desc: ["铜制工具和装备现已成为石器时代和铁器时代之间的过渡桥梁！"],
	quest.26636F409E53D141.title: "铜制装备",
	quest.26D980900603132D.quest_desc: [
		"召唤并击杀凋零（The Wither）。",
		"",
		"这场战斗没有任何变化。"
	],
	quest.2778DB8D15D69999.quest_desc: [
		"克苏鲁之壳会吸收溺水伤害，但会消耗饥饿值。",
		"",
		"在水下时还能提供黑暗视觉。"
	],
	quest.27E617CC6214737F.quest_desc: [
		"末影触须种子可以在战利品箱中找到。",
		"",
		"将它们种在发光浆果等方块下方。花朵每4个方块出现一次。",
		"",
		"它们会慢慢长出末影珍珠。破坏触须总会掉落种子。"
	],
	quest.27F0C530CCE0C0B8.quest_desc: [
		"Sublime's Overworld 充满了可供探索的建筑和野生动物！",
		"",
		"此处的任务旨在提醒玩家主世界中可体验的原版或模组内容。"
	],
	quest.285483919920EE89.quest_desc: ["隐藏物品标签钥匙将显示或隐藏物品标签。"],
	quest.289CD6318234FAB1.quest_desc: [
		"硫磺泉的生成方式与繁茂洞穴类似，利用水和硫磺石生成。",
		"",
		"这里还会生成巨型间歇泉。",
		"",
		"硫磺岩生成于间歇泉下方。"
	],
	quest.295A5B023AE63978.quest_desc: [
		"前往下界金字塔，收集一些额外的战利品！",
		"",
		"小心脚下，注意居民动向即可。"
	],
	quest.2A30A771FFC0FC04.quest_desc: [
		"冰魔杖会投掷作为远程投射物的雪球，造成伤害。",
		"",
		"使用雪球作为弹药，可以按住 Shift + 右键自动吸收背包中的雪球。"
	],
	quest.2A62C56791191F8D.quest_desc: [
		"冰星域由呈星形的巨大祖母绿冰块组成。",
		"",
		"小心，那里非常非常冷。"
	],
	quest.2A8EC3F913BD3846.quest_desc: ["传送石可以消耗经验值，传送到其他已激活的传送石。"],
	quest.2AC77376AF5A09B9.quest_desc: [
		"龙之墓地里有许多长满苔藓的大型黑曜石坐骑。",
		"",
		"这片黑曜石上覆盖着各种各样的菌类。"
	],
	quest.2B524E575A1439B8.quest_desc: [
		"如果适合你的游戏风格，可以使用这些旅行指令。",
		"",
		"使用 \"/sethome name\" 来设置一个家园位置。",
		"",
		"使用 \"/home name\" 可传送到你的家位置。",
		"",
		"/back 可传送到你的上一个位置/死亡点。"
	],
	quest.2B524E575A1439B8.title: "回家与返回",
	quest.2B806DDD73424DBD.title: "猫",
	quest.2CA80D650AFF7BA9.quest_desc: [
		"虚空之泪可以容纳近乎无限的单一物品。",
		"",
		"右键点击会使泪珠吸收你携带最多的物品。",
		"",
		"Shift + 右键点击可让泪滴从此自动吸收该物品。"
	],
	quest.2E0FF203A269929C.quest_desc: [
		"驯养信息请咨询Wildex。",
		"",
		"驯服后，海豹将协助你进行战斗。",
		"",
		"如果受伤了，它也会捕猎鱼类。"
	],
	quest.2EC457AC7DEE864D.quest_desc: [
		"小狗可以和投骨、投棒或飞盘一起玩捡球游戏！",
		"",
		"此外，还有超过40种化妆品和服装，可以装扮你的狗狗！"
	],
	quest.2EDE2C3FD8472F87.quest_desc: [
		"特殊圣物组件，击杀骷髅时有小概率掉落。",
		"",
		"它们也有很小的几率出现在战利品箱中。"
	],
	quest.309711EB2CE65A83.quest_desc: [
		"生育药水能让植物生长得更快。",
		"",
		"它的使用方式与溅射药水相同。"
	],
	quest.3118E23398DFC641.quest_desc: [
		"驯养信息请咨询Wildex。",
		"",
		"强光会显示怪物能够生成的足够黑暗的区域。"
	],
	quest.311FA31EE45D96B2.quest_desc: [
		"要制作极光雪莉特，先制作一个雪傀儡，然后用极光碎片右键点击。",
		"",
		"雪莉特是一种迷你伙伴，它会跟随你，并且可以用雪球来治疗。"
	],
	quest.311FA31EE45D96B2.title: "极光雪莉特",
	quest.314F04CCB6DC52AA.quest_desc: [
		"如果你想用更美观的方式使用物品栏线缆，可以制作可上色的线缆！",
		"",
		"油漆工具包可以让你选择一个方块，然后将库存电缆涂成与该方块相同的外观。"
	],
	quest.315BFB4A8817FF57.quest_desc: [
		"厌倦了船，但仍想探索海洋吗？",
		"",
		"想建造水下基地，却不想担心空气这类琐事吗？",
		"",
		"找到并骑上一只鹦鹉螺吧！",
		"",
		"穿上盔甲，确保自身安全也很重要。"
	],
	quest.315BFB4A8817FF57.title: "鹦鹉螺（Nautilus）",
	quest.31C63F22D9B7AD7E.quest_desc: [
		"幸运硬币能像磁铁一样吸引物品和经验。",
		"",
		"Shift + 右键点击可激活和停用硬币。"
	],
	quest.32172A0A8C247FAC.quest_desc: ["适度提高你马匹的速度和跳跃高度。"],
	quest.3259DE69A7FF2C87.quest_desc: [
		"Shears of Winter 用于收割特定区域内树上的叶子。",
		"",
		"它还会用AOE方式剪羊毛！"
	],
	quest.325C71628E18BAA4.quest_desc: [
		"幻影节点是末影法杖在幻影模式下会传送到的目标。",
		"",
		"必须使用处于幽灵模式的末影法杖右键点击以进行绑定。"
	],
	quest.3264C0C4279CCE06.quest_desc: [
		"特殊圣物组件，击杀烈焰时有小概率掉落。",
		"",
		"它们也有很小的几率出现在战利品箱中。"
	],
	quest.334FFA752960F035.quest_desc: [
		"特殊圣物组件，击杀苦力怕时有小概率掉落。",
		"",
		"它们也有很小的几率出现在战利品箱中。"
	],
	quest.338A3FBC93A3F898.quest_desc: ["Night Lights 为您的世界添加了各种新的仙女灯和夜灯！"],
	quest.34D38B56415D20AB.quest_desc: ["提高你坐骑马的速度和跳跃高度。"],
	quest.35101A28BF65D6CB.quest_desc: ["凋零玫瑰可以保护你免受凋零效果的影响。"],
	quest.352AC044A81FF56F.quest_desc: [
		"Storage Drawers 提供了抽屉，帮助你存储和整理大量物品！",
		"",
		"抽屉有所有原版木材类型，以及 1x1、1x2 和 2x2 的变体。",
		"",
		"右键抽屉可将物品存入其中。",
		"",
		"右键点击 x2 会将你背包中的所有物品存入其中。",
		"",
		"左键点击可移除抽屉中的一个物品。",
		"",
		"Shift + 左键可移除抽屉中最多一组的物品。"
	],
	quest.352AC044A81FF56F.title: "储物抽屉",
	quest.35CD4A38E7C19003.quest_desc: ["探险家指南针将帮助你定位任何结构。"],
	quest.35F814751CF4F6F3.quest_desc: ["彩绘山脉由末地石、紫晶和弗拉沃石层构成。"],
	quest.361B31F88FFDADA3.quest_desc: [
		"成熟的极光花会掉落冰冻花瓣！",
		"",
		"极光之花在极光事件期间发芽，并在整个夜晚生长。",
		"",
		"它们会在日出时消失，所以尽可能多地收集吧。"
	],
	quest.3641AECCAE951D53.quest_desc: [
		"霓虹绿洲由斑驳的植被和末石粉组成。",
		"",
		"这里也是霓虹仙人掌的家园。"
	],
	quest.36564B85103C9905.quest_desc: [
		"神圣手榴弹是一种投掷物品，能对附近的一切造成巨大伤害。",
		"",
		"不过，它不会破坏方块或对玩家造成伤害。"
	],
	quest.36F5DDEB5798D572.quest_desc: [
		"暮色斗篷会在足够黑暗的环境中使你隐身。",
		"",
		"Shift + 右键可开启和关闭斗篷。"
	],
	quest.36FBB5E4910E3C28.quest_desc: [
		"神明的馈赠会在你的宠物达到60级后提供额外的等级。",
		"",
		"最高等级为30级。"
	],
	quest.37665C4B7ECCB637.quest_desc: ["有许多物品和骨头可以帮助你照顾你的小狗！"],
	quest.3803C92DCD542BA2.quest_desc: [
		"驯养信息请咨询野性指数。",
		"",
		"被驯服后，老鼠将协助战斗。",
		"",
		"它偶尔会向你要食物吃。",
		"",
		"若提供腐肉，其攻击可施加中毒效果。"
	],
	quest.38BD5AD570A100B9.quest_desc: ["这些空荡荡的废弃村庄既美丽又适合被洗劫一空！"],
	quest.394C78DC2E6E2489.quest_desc: [
		"驯养信息请咨询Wildex。",
		"",
		"被驯服后，耳廓狐会叼着物品。",
		"",
		"如果物品是食物并且受伤了，它会吃东西来治愈自己。",
		"",
		"还会捕猎兔子和鸡。"
	],
	quest.3A2452FC54179994.quest_desc: [
		"在灵魂沙谷中找到一个干涸的恶魂！",
		"",
		"给这个可爱的恶魂版本补水，能带你飞向新的高度！"
	],
	quest.3ADD438AD10047D6.quest_desc: [
		"带上你心仪的美丽翅膀，翱翔天际吧！",
		"",
		"制作并饮用其中一种药水，就能长出相应的翅膀。",
		"",
		"使用 ` 来激活和取消飞行模式",
		"",
		"如果你决定不再需要翅膀，只需装瓶一些蝙蝠血，然后一饮而下！",
		"",
		"注意：当一个翅膀任务完成时，所有翅膀任务都会完成。这不是一个错误。"
	],
	quest.3B1FC9C28D49CCEB.quest_desc: [
		"末地被彻底重做，新增了生物群系、结构等等！",
		"",
		"此处的任务旨在提醒玩家，末地中有哪些原版或模组化的体验。"
	],
	quest.3B78D17A40B87EFE.quest_desc: [
		"Auroral 是一款以寒冷生物群系中的极光事件为核心的美丽魔法模组！",
		"",
		"还附带了这份详细说明模组一切的实用手册！"
	],
	quest.3BF04BA1F37CFE03.quest_desc: [
		"你的物品栏里有一个 Wildex。",
		"",
		"它能让你记录你世界里的每一个生物。",
		"",
		"要记录生物，可以用提供的望远镜观察，或者将其杀死。",
		"",
		"Wildex 将更新所有关于该生物的细节，包括生成、繁殖、驯养、生命值等！"
	],
	quest.3C087C346242A4ED.quest_desc: ["超级零食可以将你的宠物升到40级。"],
	quest.3C81F8BFA79E1C1E.quest_desc: ["The Cross of Mercy 是一种能对不死生物造成额外伤害的武器。"],
	quest.3CE80D982716B5BC.quest_desc: [
		"魔法克星是一把越附魔越强的武器。",
		"",
		"击败敌人时，获得特定 Reliquary 生物掉落物的几率也会提高。"
	],
	quest.3D4CED91F3AD2640.quest_desc: [
		"天使之心瓶能像不死图腾一样，让你免于一次死亡。",
		"",
		"必须放在背包里才能激活。"
	],
	quest.3D6652CBD187811F.quest_desc: [
		"Cincinnasite 由 Cincinnasite 矿石掉落。",
		"",
		"可用于制作精美的装饰品和实用的装备。"
	],
	quest.3E34731600A90D3F.quest_desc: [
		"发光面包能完全恢复你的饥饿值和饱食度。",
		"",
		"而且吃起来速度也非常快。"
	],
	quest.3E6E71489FEEE53E.quest_desc: [
		"如果你的狗狗不小心掉进虚空，狗窝会让他重生。",
		"",
		"空手状态下 Shift + 右键，当幼犬靠近时，会将其指定给床。",
		"",
		"每只幼犬一张床。",
		"",
		"如果你有多个幼犬，也可以使用哨子来帮忙。"
	],
	quest.3ED1C1C1BD94E295.quest_desc: ["汉堡模组提供的额外食物物品。"],
	quest.3F01D82ADE3CF563.quest_desc: [
		"无线终端让你可以从最远16格外的位置访问物品连接器存储中的终端！",
		"",
		"你必须能看到终端才能访问它。"
	],
	quest.3F3264917A0B771D.quest_desc: ["大幅提升马匹的速度和跳跃高度。"],
	quest.3FD550D1B6F0ACE9.quest_desc: [
		"火蜥蜴之眼会阻挡烈焰弹，反射恶魂火球，并扑灭你周围的火焰。",
		"",
		"可以放在非主手物品栏中。"
	],
	quest.40333FADB8E2D5B1.quest_desc: [
		"特殊圣物组件，击杀守卫时有小概率掉落。",
		"",
		"它们也有很小的几率出现在战利品箱中。"
	],
	quest.403F9C1B027BD598.quest_desc: [
		"绽放的尖塔充满活力，色彩缤纷！",
		"",
		"Tenanea 树可以在这里找到，有一套完整的木材。"
	],
	quest.414455D11E27634A.quest_desc: ["乌姆布拉谷由名为帕利德的白色真菌覆盖的乌姆布拉石构成。"],
	quest.419C24C774B3AA16.quest_desc: [
		"驯养信息请咨询Wildex。",
		"",
		"红河猪有时会吃草寻找种子，并把它们留在身后。",
		"",
		"它们也可以通过打喷嚏吐出史莱姆球。"
	],
	quest.41DDBD6415E0A61C.quest_desc: [
		"驯养信息请咨询野性指数。",
		"",
		"猫头鹰也喜欢开派对，就像鹦鹉一样。"
	],
	quest.41ED2E6B7C59E5A0.quest_desc: [
		"驯养信息请咨询Wildex。",
		"",
		"鹅会在战斗中协助你，并且可以给它装备武器。",
		"",
		"鹅也可以被给予一件武器。"
	],
	quest.428A71B511455EC9.quest_desc: [
		"凤凰羽毛能防止你死亡一次，恢复全部生命值和饱食度，并变回天使羽毛。",
		"",
		"它还能提供跳跃助推，并防止坠落伤害，但会消耗饥饿值。"
	],
	quest.42957CDB5AAB0931.quest_desc: [
		"下界被彻底重做，新增了生物群系、结构等等！",
		"",
		"此处的任务旨在提醒玩家，下界中有哪些原版或模组化的体验。"
	],
	quest.430751272866E77D.quest_desc: [
		"制作永恒锭工具和盔甲需要永恒锭锤子。",
		"",
		"皮革包裹的木棍、永恒锭锻造模板和永恒锭锤头可以制作出永恒锭锤。"
	],
	quest.433E7C918C8EF92D.quest_desc: [
		"下界沼泽地的地面由熔岩池、灵魂土和下界芦苇构成。",
		"",
		"这里经常能找到巨大的柳树。"
	],
	quest.43E55EB06E05F9CD.quest_desc: ["Inventory Cable Connectors 放置在将使用 Inventory Cables 连接到 Inventory Connector 的存物箱上。"],
	quest.4469426FD6CBD8A5.quest_desc: [
		"驯养信息请咨询Wildex。",
		"",
		"鸭子会下蛋并掉落羽毛。",
		"",
		"它们喜欢水和音乐。"
	],
	quest.44B0B7741271EEC5.quest_desc: [
		"灌注仪式可以将抛光弗拉沃石转化为符文弗拉沃石。",
		"",
		"此方块可用于修复末地中找到的废弃传送门。",
		"",
		"请务必准备充足的数量！",
		"",
		"带上6个永恒水晶，放置在基座上以激活传送门！"
	],
	quest.453CA53A7C66D646.quest_desc: [
		"驯养信息请咨询野性指数。",
		"",
		"被驯服后，红熊猫的生命值会从8增加到25。",
		"",
		"它也可以在战斗中提供帮助。"
	],
	quest.45979CA611D2D62D.quest_desc: ["自然指南针将帮助你定位任何生物群系。"],
	quest.45B49190237E0A8B.quest_desc: [
		"使用鱼和鱼刀来制作生鱼排。",
		"",
		"鱼片的数量取决于鱼的种类！"
	],
	quest.45BD02835A6198DB.quest_desc: [
		"驯养信息请咨询Wildex。",
		"",
		"袭击者会被尖刺扎到。",
		"",
		"它的护甲值增加了。"
	],
	quest.4633FAA6B3EBB561.quest_desc: [
		"通过汉堡模组，你可以制作各种各样的汉堡和配菜！",
		"",
		"这些是用鸡肉制作而成的物品。"
	],
	quest.4633FAA6B3EBB561.title: "鸡肉汉堡包",
	quest.468A69D2E733AAB5.quest_desc: [
		"返回卷轴会将你传送到最近已激活的传送石。",
		"",
		"卷轴在使用时会被消耗掉。"
	],
	quest.472A9A50A6836271.quest_desc: [
		"紫颂林生物群系有一种阴暗的氛围。",
		"",
		"在那里可以找到拥有完整木材套装的 Pythadendron 树。"
	],
	quest.4763EA8BE971B63B.quest_desc: [
		"物品栏连接器是整合所有连接物品栏的主枢纽。",
		"",
		"与其接触的任何箱子，与其接触的箱子的接触箱子，或通过其他方式与之相连的箱子，都会被添加到主枢纽中。",
		"",
		"注意：将装饰性箱子放置到任意合成网格中即可将其转换为原版箱子。之后物品栏连接器就能识别这些箱子了。"
	],
	quest.4763EA8BE971B63B.title: "Tom's Simple Storage",
	quest.47B0E7DFDEE58F08.quest_desc: [
		"被淹没的三角洲，嗯……被熔岩淹没了。",
		"",
		"它们包含黑石钟乳和黑釉陶瓦。"
	],
	quest.47FEB8748AC6B358.quest_desc: [
		"通过汉堡模组，你可以制作各种各样的汉堡和配菜！",
		"",
		"这些是用鲑鱼制作的物品。"
	],
	quest.47FEB8748AC6B358.title: "三文鱼汉堡包",
	quest.4844AD258884B6F3.quest_desc: ["Shimmering Ice 是一种永不融化的发光冰块，能为作物持续补水。"],
	quest.48465828DEBF2E1E.quest_desc: [
		"Macaw's Suite 包含大量装饰和建筑选项的合集。",
		"",
		"以下是所包含的模组列表：",
		"",
		"- 鹦鹉螺的桥 (Macaw's Bridges)",
		"- Macaw's Doors",
		"- Macaw's Fences and Walls",
		"- Macaw's Furniture",
		"- Macaw's Lights and Lamps",
		"- 鹦鹉螺之路与铺路石模组",
		"- 鹦鹉螺的屋顶 (Macaw's Roofs)",
		"- 鹦鹉螺楼梯 (Macaw's Stairs)",
		"- 鹦鹉螺的活板门",
		"- 鹦鹉螺的窗户 (Macaw's Windows)"
	],
	quest.48651C9DBF1DBD9A.quest_desc: [
		"手持空手状态下，Shift + 右键大多数生物和方块即可拾起并携带。",
		"",
		"这包括箱子！"
	],
	quest.48E75BDBE0622423.quest_desc: [
		"抽屉控制器将简单的抽屉变成了一个存储系统。",
		"",
		"控制器接触抽屉后，右键两次即可将背包中的所有物品存入抽屉。",
		"",
		"抽屉可以连接到其他抽屉，最终连接到控制器。",
		"",
		"基本上，你可以将一排储物抽屉连接到控制器上。"
	],
	quest.48FC06A01A5D6DD1.quest_desc: [
		"驯养信息请咨询Wildex。",
		"",
		"雪豹会捕猎其他生物。",
		"",
		"它们会在战斗中协助你。"
	],
	quest.49591E314CEAA227.quest_desc: [
		"需要帮忙整理你的储物空间吗？",
		"",
		"制作一个铜傀儡或12个！",
		"",
		"铜傀儡会从铜箱中取出物品，并执行以下两种操作之一：",
		"",
		"将物品放入附近的空木箱中",
		"将物品放入附近装有该物品的木制箱子中",
		"",
		"别忘了把它们清理干净或者打上蜡！"
	],
	quest.49591E314CEAA227.title: "铜质哥布林",
	quest.49BD54A17F0F156E.quest_desc: ["与原版相比，旧扭曲森林的植被更大，也更稀疏。"],
	quest.49EAA8784F938A77.quest_desc: [
		"挑战末影龙吧。",
		"",
		"别忘了带上瓶子和火把！"
	],
	quest.4AEAA5AD783DBCCC.quest_desc: ["抽屉的基础存储值的4倍。"],
	quest.4B28C8E734C9BB7C.quest_desc: ["Waystones 是一款允许在 Waystones 之间进行各种类型旅行的模组。"],
	quest.4B45B68A9ABE1499.quest_desc: [
		"骨珊瑚礁是一个装饰着蘑菇草和骨骼结构的优美生物群系。",
		"",
		"这里生长着羽状蕨和下界芦苇等植物。"
	],
	quest.4B9A991F344ED5E3.quest_desc: ["汉堡模组中多种不同食谱的一种配料。"],
	quest.4CA5514700E8931C.quest_desc: [
		"撕裂风暴利用羽毛的力量来执行各种功能。",
		"",
		"推挤模式会将敌人推开。",
		"",
		"牵引模式会将敌人拉向你所在的位置。",
		"",
		"飞行模式可以让你飞行。",
		"",
		"在雷暴天气中，你也可以召唤闪电。",
		"",
		"Shift + 右键可开启自动吸收。"
	],
	quest.4CF3FD22DBDD726A.quest_desc: [
		"通过汉堡模组，你可以制作各种各样的汉堡和配菜！",
		"",
		"这些是用羊肉制作而成的物品。"
	],
	quest.4CF3FD22DBDD726A.title: "羊肉汉堡包",
	quest.4D9FD0AB63AF370C.title: "眼泪",
	quest.4DB7AC263B57E455.quest_desc: [
		"找到一个远古城市，获取大量战利品和经验！",
		"",
		"务必保持安静。坚守者听力很好。"
	],
	quest.4E8239D370E38B23.quest_desc: [
		"特殊圣物组件，击杀蜘蛛时有小概率掉落。",
		"",
		"它们也有很小的几率出现在战利品箱中。"
	],
	quest.4EAFEE1748EB9E07.quest_desc: ["训练零食可以将你的幼犬升级到20级。"],
	quest.4F8DB21E1E9CE58C.quest_desc: [
		"毁灭催化剂使用火药作为弹药，通过右键点击来摧毁方块，类似于TNT。",
		"",
		"Shift + 右键可切换自动吸收模式。"
	],
	quest.5029953350870FD0.title: "strad",
	quest.50BA04FDA6FB7C86.quest_desc: [
		"将高级无线终端对准已连接到物品连接器上的终端，按 Shift + 右键。",
		"",
		"这样你就可以在最多 64 格远的地方访问该物品栏了。"
	],
	quest.5116FC5AEE09B426.quest_desc: ["所有储物抽屉升级所需的合成组件。"],
	quest.525E2DE4F48D1D3C.quest_desc: [
		"地狱圣杯可以储存岩浆，并保护你免受岩浆伤害。",
		"",
		"Shift + 右键可切换水桶模式和排水模式。",
		"",
		"岩浆保护是以饥饿为代价获得的。"
	],
	quest.528844750FEA3005.quest_desc: [
		"请杀死唤魔者。拜托了。",
		"",
		"这种恼人的生物通常出现在林地府邸中。"
	],
	quest.52B0FFB1EAEA3DD1.quest_desc: [
		"用刷子刷那些看起来有点“可疑”的沙子和砾石，就能找到有趣的战利品！",
		"",
		"如果你在温暖的海洋遗迹中，甚至可能找到一个嗅探者蛋！"
	],
	quest.52B0FFB1EAEA3DD1.title: "考古学",
	quest.53121695B5B0D0AB.quest_desc: [
		"Hearthwood Log 是一个能燃烧 7 个现实日子的篝火。",
		"",
		"它还会使附近的实体获得抗冻伤免疫效果。",
		"",
		"它作为极光事件的催化剂发挥作用。",
		"",
		"它们可以合成，也可以自然生成。"
	],
	quest.5340153433F33090.quest_desc: [
		"Additional Lights 模组为 6 种石头添加了 200 多种灯光变化。",
		"",
		"它还提供了光、火或灵魂火等选项。"
	],
	quest.53520B89FB26DC43.title: "商店",
	quest.53AB72150F144859.quest_desc: [
		"驯养信息请咨询Wildex。",
		"",
		"被驯服后，猫鼬将协助战斗。",
		"",
		"而且它还非常可爱。"
	],
	quest.5452374A56964E84.quest_desc: [
		"当幼犬的营养过低时，食物碗会自动喂食。",
		"",
		"右键点击碗以打开GUI。",
		"",
		"幼犬不吃碗里的生食物。需要烹饪。"
	],
	quest.548275588334FCF7.quest_desc: ["显示抽屉相对于容量的填充程度。"],
	quest.56167219BA458CD9.quest_desc: ["繁殖骨头是驯养犬的唯一繁殖方式。"],
	quest.56247FCFE8AA3698.quest_desc: [
		"Sojourner's Staff 让你可以远程放置火把。",
		"",
		"它以火把为燃料，放置距离越远消耗的火把越多。",
		"",
		"Shift + 右键点击可开启自动吸收。"
	],
	quest.5704AD6ABB862834.quest_desc: [
		"暗影森林是一个阴森黑暗的群系，其中的植物需要你小心脚下。",
		"",
		"这里还有附带完整木材套装的龙之树。"
	],
	quest.574C9C4F8F3E7600.quest_desc: ["还有铁、金、钻石和Neptunian Fillet刀具！"],
	quest.57EAEDE442FDC6D8.quest_desc: [
		"Shift + 右键点击你的驯养犬会打开它们的菜单。",
		"",
		"菜单包含的内容有：",
		"",
		"- 模式：温顺、游荡、攻击性等",
		"- Nourishment: 让你的宠物保持饱腹！",
		"- Talents: 给你的宠物升级！",
		"- 繁殖和改名。",
		"- 还有更多内容！",
		"",
		"菜单里有很多东西可以探索！"
	],
	quest.57EAEDE442FDC6D8.title: "狗狗菜单",
	quest.584A8E5CC0F2C4CF.quest_desc: ["正面开放的棚式帐篷。"],
	quest.58CA9AA24EE88D41.quest_desc: ["抽屉的基础存储值为 64x。"],
	quest.595A8101A13F95B7.quest_desc: ["照亮抽屉标签，使其在黑暗中可见。"],
	quest.597970B9BA29A294.quest_desc: [
		"大师级饲料可以将你的幼犬升级到60级。",
		"",
		"这是最高的正常等级。"
	],
	quest.5A450FC5DDAC4925.quest_subtitle: "狗狗天赋 (Doggy Talents)",
	quest.5A450FC5DDAC4925.title: "小狗的华尔兹",
	quest.5A925A8EFA6DDF24.quest_desc: [
		"皇帝的圣杯是一个便携的无限水源。",
		"",
		"Shift + 右键可激活放置/吸收功能。",
		"",
		"不要喝这个。"
	],
	quest.5AFBDB32BE2FD73D.quest_desc: [
		"雨伞丛林是巨型雨伞树的家园！",
		"",
		"伞树有可装瓶的薄膜、弹跳物理和完整的木材套装。",
		"",
		"此外，这里还会生成果冻蘑菇，它们也有自己的一套完整的木材。"
	],
	quest.5B1B9E15207E39FE.quest_desc: ["将未精炼的闪烁钢放在填充的冰盆上右键即可制作出闪烁钢锭。"],
	quest.5B3024C7DA8A0463.title: "创作者（音乐盒）",
	quest.5B7FCC8F48924929.quest_desc: [
		"瓶装蝙蝠血可用于移除你已经长出的翅膀。",
		"",
		"你可以用另一种药水来长出新的翅膀。"
	],
	quest.5BD43C10600A678A.quest_desc: [
		"失忆之骨可以让你更改所有权、取消幼犬训练，或取消天赋训练。",
		"",
		"右键点击你狗狗身上的遗忘之骨以打开菜单。"
	],
	quest.5C00A74A05E883C6.quest_desc: [
		"Megalake Grove 会生成带有莲花植物的大型湖泊。",
		"",
		"可以收割莲花植物来制作末地莲花原木，它有一套完整的木材。",
		"",
		"巨湖林中还含有拉库格罗夫树，它们也有一套完整的木材！"
	],
	quest.5C042D99FB475B1F.quest_desc: [
		"特殊圣物组件，击杀僵尸时有小概率掉落。",
		"",
		"它们也有很小的几率出现在战利品箱中。"
	],
	quest.5C7B181FD3C8759A.quest_desc: [
		"鱼线是你的钓鱼竿的一个外观装饰。",
		"",
		"用任意颜色的染料在合成网格中放置它即可染色。"
	],
	quest.5D44AD68D5205FC9.quest_desc: [
		"灌注仪式使用基座来魔法合成组件和魔法物品！",
		"",
		"你可以合成强大的附魔，升级你的鞘翅，甚至将末地盔甲升级为水晶盔甲！",
		"",
		"使用 JEI 查看所有可用的仪式配方。"
	],
	quest.5D5B96C17976192E.quest_desc: [
		"特殊圣物组件，击杀鱿鱼时有小概率掉落。",
		"",
		"它们也有很小的几率出现在战利品箱中。"
	],
	quest.5E032322CC3BBDAD.title: "猪人音乐盒",
	quest.5EA3A4A9AD7825F2.quest_subtitle: "更多附加内容 (Additional Additions)",
	quest.5EA3A4A9AD7825F2.title: "0308",
	quest.5EBE4E085702C98E.quest_desc: [
		"磁石会在5格半径内吸引物品和经验值。",
		"",
		"Shift + 右键点击以切换激活状态。"
	],
	quest.5EFA881B7DD0F9EE.quest_desc: [
		"极光事件是极光和进步的关键。",
		"",
		"这本书详细记录了极光事件期间可能发生的一切。",
		"",
		"这里有几件重要的事情需要注意：",
		"",
		"冰川盆地会收集液态灵气。",
		"极光之花会生长在雪地上。",
		"- 闪耀钢装备会缓慢修复。"
	],
	quest.5EFA881B7DD0F9EE.title: "极光事件",
	quest.5F80CA5715BD6FD6.quest_desc: [
		"驯养信息请咨询野性指数。",
		"",
		"驯服后，独角鲸将协助战斗。",
		"",
		"如果它的主人被锁定为目标，它会发出警告声。",
		"",
		"它不会将玩家传送过去。"
	],
	quest.607A50C793DE0085.quest_desc: ["城市矗立在虚空之中，于空旷之地巍然耸立。"],
	quest.60B0A7F93930B61D.quest_desc: ["汉堡模组提供的额外食物物品。"],
	quest.60BAE0D2D28AD44C.quest_desc: ["极大地提高了马的速度和跳跃高度。"],
	quest.60C22D704F80C024.quest_desc: [
		"在末地要塞中找到其中的野火。",
		"",
		"强烈建议购买火焰抗性，以便有时间击破野火护盾。"
	],
	quest.6122BD6946408F60.quest_desc: ["和 Inventory Cables 一样，Inventory Cable Connectors 也可以被框架和上色！"],
	quest.61246F8B73D76E09.quest_desc: [
		"此锻造模板可用于制作闪耀钢工具和闪耀编织盔甲！",
		"",
		"可以通过合成或在寒冷生物群系的宝箱中获取。"
	],
	quest.612DB8B5F9F83CD6.quest_desc: [
		"砾石沙漠是一个相当平淡的生物群，其中包含一些新的植物。",
		"",
		"这是一个非常棘手的生物群落，难以穿越。"
	],
	quest.61EBC4F566278CF4.quest_desc: [
		"在极光事件期间，极光鹦鹉螺有几率生成。",
		"",
		"用极光碎片把它们吸引到你身边，然后用碎片驯服它们。",
		"",
		"它们不需要鞍。Shift + 右键可以切换它们的模式为坐下或跟随。",
		"",
		"是的，它们会飞行。"
	],
	quest.621E6F7D067C2423.quest_desc: [
		"在幼崽菜单底部选择“天赋”选项卡，即可访问天赋树。",
		"",
		"你的小狗初始有15点，还可以通过零食升级！",
		"",
		"你的小狗可以学习很多非常酷又实用的天赋！"
	],
	quest.621F732902031F8B.quest_desc: [
		"想找个既时尚又不影响质量的工具和装备选择吗？",
		"",
		"玫瑰金提供的保护等级介于铁和钻石之间，而且外观也很好看。"
	],
	quest.621F732902031F8B.title: "玫瑰金装备",
	quest.627686F4C58E8A24.quest_desc: [
		"使用Smith Hammer和Thallasium Ingot在Thallasium Anvil上可以制作工具头和盔甲！",
		"",
		"将工具头、木棍和塔拉西乌姆锻造模板放在同一砧板上以制作工具。",
		"",
		"护甲片可以在普通工作台中使用。"
	],
	quest.627686F4C58E8A24.title: "塔拉西乌姆铁砧",
	quest.6288B61A68DA6626.quest_desc: [
		"除非你打算住在雪地群系里，否则出发前最好先制作好这些物品。",
		"",
		"蓝冰用于制作冰川盆地。",
		"",
		"未精炼的闪耀钢用于在冰川盆地中制造闪耀钢锭。",
		"",
		"编织皮革用于在冰川盆地中制作闪光织物。"
	],
	quest.6288B61A68DA6626.title: "准备工作",
	quest.62F189DD40EAF414.quest_desc: [
		"Simply Tents 提供了各种帐篷，可以创建小型（约3x3）的便携式地点。",
		"",
		"放置帐篷前，请确保该区域已清理干净。",
		"",
		"如果你想移动帐篷，只需 Shift + 右键点击即可。",
		"",
		"右键点击染料以更改颜色。",
		"",
		"右键点击日志/木板以更改框架。",
		"",
		"画布墙壁可以用来扩建帐篷。"
	],
	quest.6315A5B4699A77F9.quest_desc: [
		"绳索为垂直地形提供了一种便捷的穿越方式。",
		"",
		"它的运作方式与脚手架相反！",
		"",
		"点击顶部方块，绳索会向下垂得更低。"
	],
	quest.63CF2C81E15BE62D.quest_desc: [
		"马匹有许多优质的生活化改进，包括：",
		"",
		"- 装备牵引绳。右键围栏以拴住",
		"- 铜角用于绑定/召唤",
		"- 游泳",
		"- 划船",
		"- 减少碰撞检测的方块",
		"- 挖掘速度",
		"- 跳跃高度",
		"- 有限的游荡生物生成"
	],
	quest.63CF2C81E15BE62D.title: "马匹",
	quest.63D6AA602B315095.quest_desc: [
		"探索美丽的下界都市吧！",
		"",
		"里面装满了战利品、秘密，还有一些皇家卫兵。"
	],
	quest.64285A59259F4212.quest_desc: [
		"电梯会将你传送到你上方或下方的其他电梯。",
		"",
		"它们可以被染色和伪装起来。"
	],
	quest.64285A59259F4212.title: "电梯",
	quest.64BB6EE0C6493408.quest_desc: [
		"Rechiseled 添加了在 Minecraft 中自定义大量方块图案的功能。",
		"",
		"用凿子右键，将你的方块放置进去！"
	],
	quest.651A42F243652FAD.quest_subtitle: "更多附加内容 (Additional Additions)",
	quest.651A42F243652FAD.title: "1507",
	quest.660CFBC12F05348D.quest_desc: [
		"丰收之杖使用骨粉作为能量，根据模式的不同来执行各种功能。",
		"",
		"Shift + 右键点击，收获之杖将自动吸收背包中的骨粉。",
		"",
		"模式 1 的功能是锄头。",
		"",
		"模式 2 会种植种子。",
		"",
		"模式3：用骨粉催熟作物。"
	],
	quest.66150463668FB2F8.quest_desc: [
		"Reliquary 为游戏世界增添了强大的魔法饰品、武器和物品。",
		"",
		"所有物品都可以合成，但部分物品也可以在战利品箱中找到。"
	],
	quest.666E72988C6CD9B3.quest_desc: ["完成突袭，拯救村民于必死之灾！"],
	quest.668296237892EFCE.title: "创作者",
	quest.66FA189CE08FCF7A.quest_desc: [
		"下界堡垒正等待着下一位冒险者的到来！",
		"",
		"向前一步，领取其中的财富吧。"
	],
	quest.679E2C026AEBDF1E.quest_desc: [
		"舒适模组添加了睡袋和吊床！",
		"",
		"这样你就不用设置重生点也能睡觉了。"
	],
	quest.686077406EFB153B.quest_desc: [
		"Fantasy's Furniture 提供精美、主题鲜明的家具套装和装饰品。",
		"",
		"主题套装包括：",
		"",
		"- 骨头",
		"- 装饰品",
		"- 杜纳默人",
		"- 亡灵领主",
		"- 北欧风格",
		"- 皇家",
		"- Venthyr",
		"",
		"这个家具站用于制作模组中的所有物品。",
		"",
		"只需要羊毛/木板方块和黏土球即可。"
	],
	quest.68B40899C8C18BC7.quest_desc: [
		"天使羽毛能减少坠落伤害，但会消耗饥饿值。",
		"",
		"还能增加你的跳跃高度。"
	],
	quest.68CA2263277A7D6F.quest_desc: [
		"The Lantern of Paranoia will place torches around you where it is dark.",
		"",
		"Shift + 右键点击可激活灯笼。",
		"",
		"灯笼要正常工作，你必须得有火把。"
	],
	quest.68CD017E53AF1860.quest_desc: [
		"找到并杀死幻术师。",
		"",
		"他住在针叶林群系里的一座小屋中。"
	],
	quest.696282BC23E6932A.quest_desc: [
		"特殊圣物组件，击杀末影人时有小概率掉落。",
		"",
		"它们也有很小的几率出现在战利品箱中。"
	],
	quest.69D3095BF4137675.title: "11",
	quest.6B5CE65C9B8DFA16.quest_desc: [
		"下界草原栖息着大量新的植被。",
		"",
		"例如，墨囊灌木可以种植和烹饪以获取黑色染料。"
	],
	quest.6BFFCA2D549C99CB.title: "等待中",
	quest.6C5C54CB7C71F092.quest_desc: [
		"颠倒森林这个名字名副其实。",
		"",
		"该生物群系中的所有植物都从天花板向下生长。",
		"",
		"这里有带有完整木材套装的新树木。"
	],
	quest.6C6190EB887103FB.quest_subtitle: "朋友与敌人",
	quest.6C6190EB887103FB.title: "转角之处",
	quest.6CA1ACD6D25CE33E.quest_desc: ["多种不同汉堡模组食谱中的一种配料。"],
	quest.6CFBDDD480EC100F.quest_desc: [
		"&bShimmersteel Sword&r:",
		"施加缓慢效果并处决低血量生物",
		"",
		"&bShimmersteel Bow&r:",
		"使用雪球作为弹药来发射星弹。"
	],
	quest.6D99045B25A10F26.quest_subtitle: "更好的末地",
	quest.6D99045B25A10F26.title: "陌生而异星生物",
	quest.6E9E8089D9FDE011.quest_desc: [
		"你的鱼竿上可以添加 9 种不同的鱼钩。",
		"",
		"鱼钩可以减少耐久度损耗，提升运气，甚至可以一次钓多鱼！"
	],
	quest.6E9E8089D9FDE011.title: "钩子",
	quest.6EF0BA2EC5702B2B.quest_desc: [
		"物品过滤器用于指定哪些物品可以进入或离开与物品连接器相连的特定箱子。",
		"",
		"物品过滤器有 3 种类型。"
	],
	quest.6F1E89CE22DD743D.quest_desc: [
		"密达斯的试金石将使用萤石作为能量来修复金色装备。",
		"",
		"Shift + 右键点击将启用自动吸收。"
	],
	quest.6F2AC6DFB286D2D1.quest_desc: ["抽屉的 2048x 基础存储值。"],
	quest.6F9B123AB99FA3B6.title: "Relic",
	quest.6FCCF5F63B84433D.quest_desc: ["量化键将显示或隐藏抽屉中物品的数量。"],
	quest.70CFF67582E10820.quest_desc: ["驯服一只原版 Minecraft 狼是创造你的训练犬的第一步！"],
	quest.719E70E61AD775E7.quest_desc: [
		"长矛是一种分等级的武器，可以执行缓慢的突刺攻击。",
		"",
		"不过，骑乘生物时用它进行蓄力攻击，效果会非常好。",
		"",
		"这与马匹可用的马掌配合得很好。"
	],
	quest.719E70E61AD775E7.title: "长矛",
	quest.71A6169AA16C9E5F.quest_desc: ["将冰冻花瓣右键点击填满的冰川盆地即可合成极光碎片。"],
	quest.71AB3635167C5E56.quest_desc: [
		"雾蘑菇之地是巨型苔藓发光蘑菇的家园。",
		"",
		"这些巨大的发光蘑菇自带一套完整的木材。"
	],
	quest.71C971BCA8AAA368.quest_desc: [
		"Warp Scroll 会列出你已激活的所有 Waystone，让你可以选择一个进行传送。",
		"",
		"卷轴在使用时会被消耗掉。"
	],
	quest.72A25DDD1B018054.quest_desc: [
		"挑战栖息在海洋纪念碑中的远古守卫者！",
		"",
		"不知道带长矛的鹦鹉螺在这场战斗中会不会有用？"
	],
	quest.737D54A425278A9C.quest_desc: [
		"尘埃荒原是一个孤独而空旷的生物群系。",
		"",
		"里面只含有末石粉尘。"
	],
	quest.739CA8433FBB8704.title: "另一边",
	quest.73D2FA92D3D6D291.quest_desc: [
		"Aquaculture 为你的世界增添了新的鱼类、烹饪方法和钓鱼工具。",
		"",
		"它还添加了新的钓鱼宝藏战利品，包括海王星盔甲和工具。"
	],
	quest.73D2FA92D3D6D291.title: "Aquaculture",
	quest.740D04F3053B1C09.quest_desc: [
		"渔具箱能让你用鱼饵、鱼钩、浮漂和鱼线来定制你的钓鱼竿。",
		"",
		"它还有一个小小的储物空间。"
	],
	quest.74145C55415B2787.quest_desc: [
		"距离存储终端8格内的Minecraft信标会根据等级扩展无线和高级无线终端的范围。",
		"",
		"第1级：相同维度访问权限",
		"第4级：可访问任意维度"
	],
	quest.7540B1CD8CE6A76D.quest_desc: [
		"末影矿石挖掘时会掉落末影碎片。",
		"",
		"它们用于铁砧中创造末影尘。"
	],
	quest.75D7356AF2977DBB.quest_desc: [
		"火魔法师之杖可以点燃火焰，发射烈焰弹和恶魂火球。",
		"",
		"它还具有“萨拉曼德之眼”效果，可以通过按住 Shift 并右键来禁用。",
		"",
		"它使用烈焰粉和火焰弹作为燃料，具体取决于你想发射哪种火焰。"
	],
	quest.761832FDD9D0F962.quest_desc: [
		"一个废弃的传送门？",
		"",
		"在末地吗？",
		"",
		"有趣……"
	],
	quest.76621AA3FEAEA212.quest_desc: [
		"浮漂是你的钓鱼竿的一个外观装饰。",
		"",
		"用任意颜色的染料在合成网格中放置它即可染色。"
	],
	quest.77523D9C173C5A55.quest_desc: [
		"驯养信息请咨询Wildex。",
		"",
		"狮子可以咆哮，使附近的所有生物都逃跑。",
		"",
		"它会吃掉地上的肉来恢复生命值。"
	],
	quest.7792DD1F04E52034.quest_desc: ["Inventory Trim 是一种可用于连接彼此之间有空隙的背包的方块。"],
	quest.78A1EE2113B8BF9A.title: "mellohi",
	quest.7924C0BA5BF2DA14.quest_desc: [
		"Backpacked 提供独特且可定制的背包体验。",
		"",
		"用经验值解锁储物格、增强格和佩戴更多背包的插槽，而不是用资源升级背包！",
		"",
		"此外，完成世界内的不同目标还能解锁背包样式！",
		"",
		"所有目标都列在背包本身当中。"
	],
	quest.7924C0BA5BF2DA14.title: "背包已背上身",
	quest.79360F35BD93F7F7.title: "5",
	quest.7953F751DFB201F8.quest_desc: [
		"驯养信息请咨询Wildex。",
		"",
		"海獭在陆地上比在水里的移动速度要慢。",
		"",
		"它们会在战斗中协助你。"
	],
	quest.79D2D3E7FA79D89E.quest_desc: ["多种不同汉堡模组食谱中的一种配料。"],
	quest.7A33EA2983C87487.quest_desc: [
		"当极光灯笼握在主手或副手时，可提供黑暗负面效果的免疫。",
		"",
		"在深暗之域里相当实用。"
	],
	quest.7A7F8BC6CD6855A8.quest_desc: [
		"抽屉钥匙可以锁定和解锁抽屉。",
		"",
		"这样即使最后一个抽屉被用完了，物品也会被锁定在抽屉里。"
	],
	quest.7AA3D8DF938596EF.quest_desc: [
		"虫巢的用法和堆肥机一样。",
		"",
		"填满后，蠕虫农场会生成蠕虫，你可以用作鱼饵。"
	],
	quest.7AB694A7FA8F327D.quest_desc: [
		"下界红宝石可通过挖掘相应矿石获得。",
		"",
		"用于制作强大的装备。"
	],
	quest.7AD9555B7B668BAE.quest_desc: ["找到神秘的苍白花园，与嘎吱怪相遇！"],
	quest.7AE3C306893D95C1.quest_desc: ["汉堡模组提供的额外食物物品。"],
	quest.7BB70E51F0B988E0.quest_desc: [
		"魅力腰带可以储存你制作的任何生物魅力。",
		"",
		"护身符是一种可以制作的物品，能防止特定生物注意到你。",
		"",
		"例如，当你装备了僵尸护身符时，僵尸会忽略你。"
	],
	quest.7C303A0D9279B7AF.quest_subtitle: "更好的末地",
	quest.7C303A0D9279B7AF.title: "末地追寻者",
	quest.7C4949FDF78CEEB0.quest_desc: ["零食袋可以用来远距离喂养你的小狗！"],
	quest.7C94C068C2708887.quest_desc: ["抽屉的16倍基础存储值。"],
	quest.7CE329532B63BFE1.quest_desc: [
		"特殊圣物组件，击杀雪傀儡时有小概率掉落。",
		"",
		"它们也有很小的几率出现在战利品箱中。"
	],
	quest.7D72F38F8F6B9354.quest_desc: [
		"Thallasium 是一种从 Thallasium 矿石中开采的实用资源！",
		"",
		"不过，要使用它需要几个步骤。",
		"",
		"Thallasium 的属性与铁类似。"
	],
	quest.7DBA420E68B972AB.quest_desc: [
		"&bShimmerweave Goggles&r:",
		"使附近的敌对生物发光。",
		"",
		"&bShimmerweave Tunic&r:",
		"自动熄灭火焰。",
		"",
		"&bShimmerweave Leggings&r:",
		"在雪和灵魂沙上获得速度加成。",
		"",
		"&bShimmerweave Skates&r:",
		"滑冰、冰霜行者、熔岩变黑曜石、冰上免疫坠落伤害。"
	],
	quest.7DBA420E68B972AB.title: "Shimmerweave 盔甲套装",
	quest.7E283931DF2DB2DB.quest_desc: ["销毁抽屉中多余的物品。"],
	quest.7E4D2A82CB8FA9A6.quest_desc: [
		"驯养信息请咨询野性指数。",
		"",
		"被驯服后，乌鸦将协助战斗。",
		"",
		"它还会捡起地上的物品并带给你。"
	],
	quest.7E607483486D0100.quest_desc: [
		"合成1个灌注基座和8个你选择的普通基座。",
		"",
		"将8个基座围绕注入基座呈圆形放置。",
		"",
		"Infusion Pedestal 和每个正方向上的 Pedestal 之间应留出 2 格的空间。"
	],
	quest.7E607483486D0100.title: "灌注基座 (Infusion Pedestals)",
	quest.7EB72850C77D1F4F.quest_desc: [
		"驯养信息请咨询野性指数。",
		"",
		"如果你被生物锁定，糖滑翔鼠会尖叫。"
	],
	quest.7ECE56C45F39A318.quest_desc: [
		"特殊圣物组件，击杀蝙蝠时有小概率掉落。",
		"",
		"它们也有很小的几率出现在战利品箱中。"
	],
	quest.7F24014BB805B6C8.title: "方块",
	quest.7F65BCE896221499.quest_desc: ["抽屉的基础存储值的8倍。"],
	quest.7F7FDCC70AAC0E12.quest_subtitle: "更多附加内容 (Additional Additions)",
	quest.7F7FDCC70AAC0E12.title: "1007",
	quest.7FCA4141749799C8.quest_desc: ["荧光棒是一种可投掷的光源，在水下也能使用！"],
	quest.7FD459CAD0996DB6.quest_desc: [
		"通过汉堡模组，你可以制作各种各样的汉堡和配菜！",
		"",
		"这些是用猪肉制作而成的物品。"
	],
	quest.7FD459CAD0996DB6.title: "猪肉汉堡包",
	quest.7FE1599B2BB5F9C3.quest_desc: [
		"Sublime 是一款专注于世界之美并带有一丝魔力的整合包！",
		"",
		"这包括动物、建筑、动画等等更多内容。",
		"",
		"虽然世界上的东西并非都友好，但大多数敌对遭遇都发生在你招惹它们的时候。",
		"",
		"尽情享受吧！"
	],
	reward_table.1CB6963CC843A89F.title: "狗狗天赋 (Doggy Talents)",
	reward_table.3C430B21B641A16A.title: "毛绒玩具",
	reward_table.5ADCEC55F1298E1D.title: "钓鱼",
	reward_table.72B258DDB42CD3D6.title: "Aeliquary",
	task.000C668ED26C57E5.title: "前往岩浆之地 (Magma Land)",
	task.00E1EAAF5A49E10A.title: "前往紫颂森林 (Chorus Forest)",
	task.03B5249A4391DAC6.title: "对角放置方块",
	task.04B0155C30B8BCC6.title: "找到一个试炼密室",
	task.04EAA6C5264CE6D1.title: "前往发光草原探险",
	task.05679FC38B24F7AA.title: "传送石",
	task.058DDE8DAD762C24.title: "草原犬鼠",
	task.06E99B62594AFD43.title: "下界红宝石",
	task.06FA84062C5B2793.title: "极光鹦鹉螺",
	task.08B201AD2F17A541.title: "前往水晶山脉 (Crystal Mountains)",
	task.08EBB92CEDA6A163.title: "前往远古扭曲森林探险",
	task.0A336B203770981F.title: "前往被淹没的三角洲 (Flooded Deltas)",
	task.0B344DB0516157C8.title: "被毁的永恒传送门",
	task.0BA65048D7CAE4B7.title: "前往尘埃荒原 (Dust Wastelands)",
	task.0D3239914D73A6BD.title: "继续前进",
	task.0D4981B52F08A0F9.title: "Vicuna",
	task.0E6B38F542EDF2DC.title: "附加光源",
	task.0EC5D2FBAE2B34AA.title: "着色器（Shaders）",
	task.0F514AF8A796FD7E.title: "击杀远古守卫者",
	task.1015A00E079E8646.title: "击杀凋零（Wither）",
	task.107519D29E28DD80.title: "极光事件",
	task.10C172AD1B22E7A3.title: "海豹皮竖琴",
	task.123C82E4300CBFDE.title: "前往砾石沙漠 (Gravel Desert)",
	task.14F8CB7427283BF6.title: "花卉附魔 (Floral Enchantment)",
	task.154CC0EA44C5B802.title: "前往彩绘山脉 (Painted Mountains) 探险",
	task.176EA0B0FC18A33B.title: "击杀末影龙",
