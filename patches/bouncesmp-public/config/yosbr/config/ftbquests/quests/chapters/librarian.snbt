		{
			icon: "minecraft:writable_book"
			x: 0.0d
			y: 1.5d
			shape: "hexagon"
			description: [
				"欢迎来到图书管理员的工作。图书管理员是附魔书的书写大师。无论是用刻印低语者说服商人出售所需的附魔书，还是用灌注台剥离装备的附魔。为这片土地的公民提供丰富的附魔吧！"
				"把这本书当作你的指南吧！"
			]
			dependencies: ["7C4AC8A34100E312"]
			hide: true
			size: 3.0d
