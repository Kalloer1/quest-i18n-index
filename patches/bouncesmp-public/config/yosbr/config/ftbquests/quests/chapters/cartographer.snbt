		{
			title: "欢迎来到怪物驯养世界"
			icon: "mob_catcher:mob_catcher"
			x: 0.0d
			y: 1.0d
			shape: "hexagon"
			description: ["你是所有野生生物的主宰。用捕兽器捕捉生物，为它们建造栖息地。寻找并捕捉其他玩家想要的生物。击败生物，将它们的灵魂封存在灵魂水晶中，创造生物生成器！"]
			dependencies: ["56C8113D02DB4452"]
