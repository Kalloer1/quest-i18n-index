		{
			title: "农夫"
			x: 9.5d
			y: -0.5d
			shape: "rsquare"
			description: ["农夫是种植作物和收割牲畜的专家。你可以轻松地从他们那里以不错的价钱买到作物和肉类。他们还能制作镰刀、屠刀和喂食槽！试着从农夫那里买个喂食槽吧！"]
			hide_dependency_lines: true
