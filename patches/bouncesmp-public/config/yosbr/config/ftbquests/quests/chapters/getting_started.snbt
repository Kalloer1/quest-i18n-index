	quests: [
		{
			title: "欢迎来到 BounceSMP！"
			icon: "minecraft:player_head"
			x: 1.0d
			y: -3.0d
			shape: "hexagon"
			description: [
				"欢迎来到 BounceSMP 整合包！这是一个充满乐趣、专为 SMP 服务器与好友同乐而精心打造的整合包。"
				""
				"有建筑、土地可供探索，有生物可供发现，还有世界可供建造。"
				""
				"找到最适合你的种族、职业和动机，在服务器上找到自己的角色。也许你想成为照料田地的史莱姆农夫，或是嗜血屠戮强大野兽的恶魔驯兽师。建造你的王国或圣地。规划你自己的道路！"
				""
				"使用强大的工具，将自定义方块、外观、表情和其他内容带入你的世界！(教程请查看 CurseForge 页面)"
				""
				"BounceSMP 为每个人准备了惊喜。希望你能尽情享受其中的乐趣！"
			]
			size: 2.0d
			id: "2937E4FB43B9EEC0"
