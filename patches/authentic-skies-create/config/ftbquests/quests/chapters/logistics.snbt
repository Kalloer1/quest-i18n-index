					type: "item"
				}
			]
			tasks: [{
				count: 8L
				id: "2EB1B00CDC4619C7"
				item: "ae2:molecular_assembler"
				type: "item"
			}]
			title: "过度华丽的自动合成台模组"
			x: 10.0d
			y: 7.5d
		}
		{
			dependencies: ["0FD14316E20825E3"]
			description: ["分子组装器通常作为ME系统自动合成的一部分与模式提供程序配合使用，但它本身也可以作为一个自动合成台。它需要一个模式（下文会介绍）并消耗ME能量。它可以安装多达5张加速卡。此时，它的速度将超越Create合成器，同时体积、延迟和功耗更低。"]
			icon: "ae2:molecular_assembler"
