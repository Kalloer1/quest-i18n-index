	file.0000000000000001.title: "Mystic Sky 1.21.1"
	quest.04D10293F98DF124.quest_desc: ["要制作亚麻粉，请遵循以下步骤：首先，建造结构。第一层是 &#FFA826allthecompressed:obsidian_1x&r 第二层：无（放置 &#FFA826minecraft:redstone&r ）第三层 &#FFA826minecraft:obsidian&r"]
	quest.063A67DC00D7727E.quest_desc: ["欢迎来到这个新的整合包"]
	quest.066C35DF5930A139.quest_desc: ["别忘了带上你需要的备用物品！"]
	quest.0C21742AA3C5F211.quest_desc: ["要获得这些石头，按住空格键和加号键，然后右键点击泥土或草方块"]
	quest.1040530307783251.quest_desc: ["&3一种由红石信号激活的装置，通过向进入范围内的生物释放电击来保护一个13×13×13的区域。装置本身消耗256 RF/刻，每次电击消耗512 RF/刻。线圈必须由红石信号激活，可以通过手持工程师之锤右键点击线圈来设置。被线圈击杀的动物肉会被烤熟，但线圈不会给苦力怕充能。此外，线圈的冲击会造成眩晕效果，阻止末影人传送。线圈有两种模式，可以通过手持工程师之锤并按住⇧ Shift + 右键点击线圈来切换。默认情况下，线圈处于高压模式，与低压模式相反。在低压模式下，线圈消耗的能量减半，但影响的区域也缩小一半。此外，在低压模式下，身穿法拉第盔甲的玩家不会受到伤害，而在高压模式下会受到伤害。"]
	quest.12C3824C945926F6.quest_desc: [
		"/spawn-传送到出生点"
		"/rtp-传送至另一个位置"
		"/home [name]-传送回家"
		"/sethome <name>-创建一个家园点"
		"/delhome <name>-删除家园点"
		"/tpa-传送到玩家身边"
		"/tpahere-将玩家传送到你身边"
		"/tpaccept-接受传送，可以点击接受"
		"/tpadeny-通过鼠标点击取消传送"
	]
	quest.13C1585FDC6DC8CD.quest_desc: ["将巨龙等级提升至混沌等级"]
	quest.1887FF5A055CECC1.quest_desc: ["制作12个基础注射器和1个聚变核心"]
	quest.1A01281D2FD88BB1.quest_desc: ["&3可以移动放置在其上的物品。"]
	quest.1ABF3FA3C230821D.quest_desc: ["&3它利用温差来产生能量。一侧必须是水或冰块，另一侧则是岩浆或铀块。"]
	quest.259367A75F7BB9B5.quest_desc: ["&3Chain connections are used when the distance between two connectors is too great to connect them directly."]
	quest.28EE226C0BE2D669.quest_desc: ["&3用于为机器提取和供应能量。"]
	quest.2AA4904CB10119B5.quest_desc: ["在这里你可以买到任何物品！"]
	quest.2B8E3046F174BC3F.quest_desc: ["你可以在这里出售任何物品！"]
	quest.34BA521241B06151.quest_desc: [
		"商店现已开放——你可以用硬币兑换特定物品！"
		"你也可以用物品来换取金币！"
		"你也可以通过杀死某些生物来获得硬币！"
	]
	quest.359FC0AEA82898DF.quest_desc: ["将你的翼龙等级提升至巨龙等级"]
	quest.3A6B91EDF4B0A2DB.quest_desc: ["一座燃煤基负荷发电厂"]
	quest.3FD54D3EA96924DE.quest_desc: [
		"&3一个高3格的装置。放置在区块顶部的高亮橙色实心方块上（通常是泥土或石头）。它能从地面采集岩样，显示该区块内矿物（铁、金等）或石油的存在及预估储量，以便后续用挖掘机和/或来自Immersive Petroleum的抽油机进行开采。玩家手持岩样时，无论是否站在该区块上，该区块都会以线条高亮显示。岩样上还会显示区块坐标。采集的岩样可以作为方块放置，数据也会显示在上面。"
		"钻头需要RF能量才能运行。"
	]
	quest.470B75BD9D843EE3.quest_desc: ["&3一种专门的多方块装置，用于生产焦炭煤，并产生焦油作为副产品。"]
	quest.5A8F0329B18DA5DC.quest_desc: ["要进入这个维度，你需要支付1枚硬币！"]
	quest.6606388A146E597A.quest_desc: ["&3可以通过破坏普通草来获得。它们用于种植工业大麻，而工业大麻又可用于收获工业大麻纤维。"]
	quest.6C07BF5C7827C66A.quest_desc: ["&3单个水车可以产生 18 RF/刻。"]
	quest.70A24A876C9B070C.quest_desc: [
		"在这里，你可以通过杀死特定生物来赚取金币！"
		""
		"要开始赚钱，请完成此任务。祝你好运！"
	]
	quest.71EC1F9512C6D0C7.quest_desc: ["&3一种特殊的多方块结构，用于生产钢铁，并产生炉渣作为副产品。"]
	quest.745F14EFD537548B.quest_desc: ["&3它连接到结构化布线连接器，不传输电力，仅用于装饰目的。"]
	quest.7480C5682F351E9E.quest_desc: ["将你的基础等级提升至威龙等级"]
	quest.76F2283F90212C3C.quest_desc: ["{image:ftb_quests:textures/questpics/thavma/infusion.png width:100 height:100 align:center}"]
	quest.7A4104F6CF9C14D1.quest_desc: ["&3它由工业大麻的种子制成。"]
