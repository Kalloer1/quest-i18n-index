	quest.54C41D8A0ABB613D.quest_desc: [
		"整理物品栏的更快捷方式"
		""
		"默认情况下，点击你的中间鼠标按钮（滚轮）将自动整理你的物品栏。"
		""
		"你也可以按住 Shift 并右键点击物品，将其从箱子移动到背包，或从背包移动到箱子。"
		""
		"如果您喜欢不同的按键，可以在 ESC 菜单的 &acontrols&r 按钮中进行更改。"
	]
	quest.5901C7ED4319F72C.quest_desc: [
