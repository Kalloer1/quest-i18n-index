	quest.16F4D256FD10768E.quest_desc: [
		"无需创建完整服务器，即可与好友畅玩"
		""
		"如何开始 E4MC："
		"按 ESC，点击“Open To Lan”，点击“start LAN World”，把&a绿色的IP&r给你的朋友。"
		""
		"如何通过E4MC加入服务器："
		"打开与朋友匹配的整合包和版本，进入“&2多人游戏&r”，点击“&2直接连接&r”，将朋友提供的IP地址输入框中，加入。"
		""
		"&b额外提示&r：如果你想启用命令，可以在创建世界后使用 E4MC 来启用它们。"
	]
	quest.16F4D256FD10768E.quest_subtitle: "与朋友自由玩耍的方法有很多"
	quest.19D4FBB94290AA6C.quest_desc: [
		"欢迎来到 Chipped Mod！"
		""
		"此模组允许你为方块添加不同的纹理。"
		""
		"使用方法："
		"►放置于地面，右键打开"
		"►点击背包中你想要修改的物品。"
		"►左侧显示了不同角度和配置下的外观。"
		"►右侧可以让你选择喜欢的选项。"
	]
	quest.2341EADD0DFA61DA.quest_desc: [
		"愉快的邮件时间到！"
		""
		"邮箱可以让你给自己或朋友发送物品堆栈。"
		""
		"每个邮箱都可以有自己的名字，你可以在整个世界、和朋友一起，或者在你建造的各个基地和农场里使用它们。"
		""
		"来自 clutter 的邮箱无法与 Mail Time 配合使用，但它有一些小容量存储。"
		""
		"使用邮箱将邮件发送到世界中的其他邮箱。"
	]
	quest.2341EADD0DFA61DA.quest_subtitle: "不仅仅是为了社交而存在的场所"
