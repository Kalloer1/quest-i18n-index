	file.0000000000000001.title: "Matrix of Materia"
	quest.00C810110A80E336.quest_desc: ["一种水晶碎片。用于制作&l品红色魔导石&r。"]
	quest.018B5C01A9EF402F.quest_desc: ["将&l结晶菜籽种子&r投入&l精炼菜籽油&r中，即可制作出&l结晶油&r。"]
	quest.018B5C01A9EF402F.title: "结晶化油料"
	quest.01EEA8827D1501B6.quest_desc: [
		"要制造机器，你需要其他类型的&lMateria&r。"
		""
		"其中最基础的是&l红色和灰色魔石&r。"
		"用&lCubic Materia&r粉碎&lWhite Materia&r即可制作。"
	]
	quest.01EEA8827D1501B6.title: "挤压 制作 平坦的"
	quest.03F23C3D5790E3A8.quest_desc: [
		"红石可以通过粉碎&l红物质料&r来制作。"
		"大多数基本组件都已可用。"
	]
	quest.05E1D8327A656ED2.quest_desc: ["趣闻：本章最初计划包含本整合包的第二大内容模组，Theurgy。"]
	quest.05E1D8327A656ED2.title: "生命线 4"
	quest.071C4A4B77385AC2.title: "Materia Lamps"
	quest.0864D4909E4FF02B.quest_desc: ["由&l白色材料 \& 灰色材料&r组合而成。"]
	quest.0C280E4860A4787B.quest_desc: [
		"&lBlack Materia/Crude&r 加工生产线是一条非常复杂的自动化生产线。"
		"以下是一些可能有所帮助的实用技巧："
		""
		"- 离心分离 &lLiquid Black Materia&r 会产生 &lLiquid White Materia&r 和 &lCrude&r。在这一点上，&lCrude&r 的用途与 &lLiquid Black Materia&r 相同。"
		""
		"建议将每条主线路由上至下建造。或者至少在处理&l重污泥&r之前，先设置好&l燃料气体&r的处理流程。"
		""
		"- &l观察者&r可以检测到你的&l材料沉积物&r重置。"
	]
	quest.0C280E4860A4787B.title: "完全不是石油管道"
	quest.0DC921DEFD3F2137.quest_desc: [
		"&l橙色材料&r是现阶段大多数流体物流所必需的。"
		"目前必须手动创建，但可以很容易地自动化。"
	]
	quest.0EBFE26A96750FA6.title: "带框架的物品抽屉"
	quest.104ABEDEF8D44350.title: "合成网格"
	quest.10CB85B48E507C0D.quest_desc: [
		"&l物品&r和&l能量管道&r在自动化中非常有用。"
		""
		"请注意，所有机器都能输入和输出能量，因此可以“串联”机器。"
	]
	quest.10CB85B48E507C0D.title: "基础管道模组 (Basic Pipes)"
	quest.10D5A5C0BCB86502.quest_desc: ["有了所有自动化工具，自动化两种最基本的&lMateria&r（除了&lWhite Materia&r）应该不难。"]
	quest.10D5A5C0BCB86502.title: "大规模自动化"
	quest.16DF770E9D1B6337.quest_desc: ["&l智能导管&r不仅能高效传输电力，还能传输信息。"]
	quest.16FB4ACC34CE3937.quest_desc: [
		"&l浅蓝色魔导石&r是一种与&l橙色魔导石&r性质相似的魔导石。"
		""
		"不过，它的灵活性使得改进型流体管道的创造成为可能。"
	]
	quest.18A0679FB9AA1915.title: "Refined Storage 控制器"
	quest.18B9447CE25E4840.quest_desc: ["为了处理&lBlack Materia&r，你需要更好的机器，而这些机器需要更好的组件。"]
	quest.18B9447CE25E4840.title: "蓝色机械装置"
	quest.1ACBFC7F088CE32C.quest_desc: ["某些反应堆组件需要&l冷却剂&r。"]
	quest.1ACBFC7F088CE32C.title: "冷却剂"
	quest.1B6DD54613D1C579.quest_desc: [
		"&l欢迎来到矩阵材料&r"
		"一个专注于自动化挑战的 1.21.1 自动化整合包。"
		"本整合包的主要限制在于所给空间有限。每章结束时，你都会获得一个额外的房间（在初始房间之外）。"
		""
		"要开始，请通过捶打房间中央的&lMateria Deposit&r来收集一些&lWhite Materia&r。"
		""
		"任务书的“信息”类别会向你展示可用的各种物流选项、装饰物和实用物品。"
	]
	quest.1B6DD54613D1C579.title: "体力劳动"
	quest.1BBA8687A01F5B26.quest_desc: ["第一章的主要材料生产在整个整合包中保持不变，但升级你的材料粉碎装置绝对是值得的。"]
	quest.1BBA8687A01F5B26.title: "第一章 优化配置"
	quest.1CF37EFF2BCF0CAB.quest_desc: ["完美版的 &lCentrifuge&r 和 &lMixer&r 将有助于优化生产线。"]
	quest.1CF37EFF2BCF0CAB.title: "完美的混合与分离工艺已掌握"
	quest.1DAB71F17AE7F056.quest_desc: ["&l完美温室&r可能不是最实用的完美机器，但它对大规模生产油菜很有帮助。"]
	quest.1DADA3A8146A3BD7.quest_desc: ["一种可以自动化的碎片水晶。这种是绿色的。"]
	quest.1E22C27CC397ECA1.quest_desc: [
		"&l裂变反应堆&r是目前最复杂的机器。"
		"运行需要两种组件，&l热交换器&r和&l反应堆核心&r。"
		"这些组件有耐久度，必须更换才能维持反应堆的正常运行。"
		""
		"要运行，&l裂变反应堆&r周围3x3x3的立方体内任何位置都需要20个&l防辐射外壳&r。"
	]
	quest.1EB7939C31D9D61F.quest_desc: ["&lMateria Burner&r可以将&lWhite Materia&r转化为能量。"]
	quest.1F03A63CA9BCFD94.quest_desc: ["&l蓝色聚合物块&r与&l黄色聚合物块&r类似，但其用途与&l橙色魔导石&r相似。"]
	quest.217A4A4C7F23E64C.quest_desc: ["适用于创建能够处理更复杂化学过程的机器。"]
	quest.26B37CE45636BC64.quest_desc: [
		"&l重污泥&r的加工与&l燃料气体&r密切相关，因为其两种产物可用于将&l轻质燃料&r和&l重质燃料&r（来自&l燃料气体&r）转化为更优质的能源。"
		""
		"&l残留物&r是四种产物中最有趣的。它可以被再加工以回收少量&l重污泥&r，但离心机的产物中会留下一些&l残留物&r。"
	]
	quest.26B37CE45636BC64.title: "重污泥处理工艺"
	quest.28EFB4FA1B7D13C6.quest_desc: [
		"不知为何，只有&lCanola&r能在这里生长。"
		""
		"可以利用这一点，在任意房间的屏障天花板正下方放置一个&lGreenhouse&r来无限繁殖。"
	]
	quest.28EFB4FA1B7D13C6.title: "绿化我的房子"
	quest.2A026945869DD9D0.quest_desc: [
		"&l硫酸浆&r是三种流体中处理流程最复杂的，但最终能产出两种类型的材料。"
		""
		"或许可以试着改进上一章的&lPure Water&r配方，因为这里用到了。"
	]
	quest.2A026945869DD9D0.title: "硫酸泥处理工艺"
	quest.2B0C83C83D4F2ACB.quest_desc: [
		"所有&l聚变反应堆&r配方都需要&l反物质&r。"
		""
		"可以通过结合所有无限可再生基础材料（&l白色材料&r、&l黑色材料&r、&l油菜籽&r和&l水&r）来制造。"
	]
	quest.2B0C83C83D4F2ACB.title: "反物质材料"
	quest.2B25338B87A36F30.title: "Materia Windows"
	quest.2BF1AF0F9CA931C1.quest_desc: [
		"&lLime Materia&r 是一种放射性极强的玛蒂尔达。"
		""
		"由于杂质相对较少，因此适合用于制造高级材料。"
	]
	quest.2BFAF8A0EC1DE905.quest_desc: ["如果你没有大量使用&l化学反应釜&r和框架方块，应该储备好这些。"]
	quest.2BFAF8A0EC1DE905.title: "生命线 2"
	quest.2C2C2555EB5DCDA6.quest_desc: ["完美机器允许通过&l晶化浆料&r而非&l晶化器&r来制造&l红色&r、&l蓝色&r和&l绿色晶化碎片&r。"]
	quest.2C2C2555EB5DCDA6.title: "第四章 优化配置"
	quest.2D06FC7782CF333F.quest_desc: ["使用自动化的&l蓝色和棕色材料&r，你可以进行下一步处理。"]
	quest.2D06FC7782CF333F.title: "流体掌控"
	quest.2DC40690A3FB4686.title: "Materia 木板"
	quest.2EA1D47FE7608486.quest_desc: ["一种水晶碎片。用于制作&l粉红魔导书&r。"]
	quest.302AB9D81CC5EF4B.quest_desc: ["由&l白色材料 \& 红色材料&r结合而成。"]
	quest.303C5E7B09936986.quest_desc: [
		"&l黑魔导书&r是一种非常独特的魔导书形式。"
		"与其他类型的魔导石不同，它不能由&l白色魔导石&r加工而成，而必须从其自身的矿床中开采。"
		""
		"&l黑魔晶石矿床&r可以通过原子重构一个&l魔晶石矿床&r来创建。"
		"创建完 &lBlack Materia Deposit&r 后，你需要更强大的钻头，普通的钻头已经不够用了。"
		"{@pagebreak}"
		"需要一台&lLiquid-State Materia Driller&r来钻探&lBlack Materia&r，注意它会产出&lLiquid Materia&r而不是&lSolid Materia&r，正如其名称所示。"
		""
		"&l&4警告：&r钻探&l黑之贤者之石&r不仅需要所在区块的全部方块都是&l黑之贤者之石矿床&r，而且偶尔会将矿床恢复原状。"
	]
	quest.303C5E7B09936986.quest_subtitle: "美国将在7天后抵达"
	quest.303C5E7B09936986.title: "绝对不是抽水泵（Definitely Not A Pumpjack）"
	quest.30F60E640CD9DDFB.quest_desc: [
		"&lManufactory&r 是最基础的可用加工机器。"
		"可以将两种输入物品转换为一种输出物品。"
	]
	quest.313E68FFA16B245D.quest_desc: [
		"&lLiquid Burner&r 可将 &lFuel Gas&r 产线的产物转化为电力。"
		""
		"这应该能覆盖本章和下一章的电力需求了。"
	]
	quest.313EC78D2E746F94.quest_desc: [
		"&l紫色魔导器&r是你将要获得的下一形态的魔导器。"
		""
		"可以通过将一些水晶碎片与&l液态白色材料&r发生化学反应来制造。"
	]
	quest.316DCF2B1617ECE7.quest_desc: ["第一章的自动化应该会产生大量多余的这些东西。"]
	quest.316DCF2B1617ECE7.title: "生命线 1"
	quest.3293015EC935D39D.quest_desc: ["&l完美餐盘&r是餐盘的终极版本。它们兼具&l化学惰性餐盘&r和&l防辐射餐盘&r的功能"]
	quest.33BFA1C020326F69.quest_desc: ["一旦你自动化了水晶碎片，自动化这两种类型的魔导石应该就很简单了。"]
	quest.33BFA1C020326F69.title: "炼金术的精湛技艺"
	quest.36C4A8910BF25AC4.quest_desc: ["&l完美同位素&r是最终组件等级——完美组件的基础。"]
	quest.36CD51CB4CEDE44A.quest_desc: ["&l灰色材料&r是一种用于制造机器的金属材质。"]
	quest.3986721B6A1B96ED.quest_desc: ["本章提供了一些替代方法来完成第三章的部分加工任务。"]
	quest.3986721B6A1B96ED.title: "更好的石油加工（完全不是）整合包"
	quest.3A5ABB9202D1BD35.title: "流体抽屉"
	quest.3DAF32129769A4FC.quest_desc: [
		"这些电路能够高效地处理大量数据。"
		""
		"注意：不自动生成这些也没关系，但建议生成，因为它们会用于未来大量的机器配方中。"
	]
	quest.3E391D09CF7BA860.quest_desc: [
		"历经这么久，你终于获得了梦寐以求的自动化产物，&lRainbow Materia&r。"
		""
		"感谢你游玩 &lMatrix of Materia&r。制作这个整合包的过程非常有趣，希望游玩的过程对你来说也同样充满乐趣。"
	]
	quest.3E391D09CF7BA860.title: "最伟大的作品 (The Magnum Opus)"
	quest.400E2AA55648508D.quest_desc: [
		"&l青色魔导石&r是一种密度极高且抗辐射的魔导石形态。"
		""
		"可以通过引爆&l白色材料&r来制造。"
	]
	quest.400E2AA55648508D.title: "青色魔导石 (Cyan Materia)"
	quest.405A4BAE47226EA8.quest_desc: ["第二章的主要优化不仅是可以用&l化学反应釜&r制造&l结晶菜籽油&r，而且现在还能将&l水&r离心分离成&l氢&r和&l氧&r。"]
	quest.405A4BAE47226EA8.title: "第二章 优化配置"
	quest.407836134DAFB281.quest_desc: [
		"速度更快的&lMateria Driller&r，能产出固体和液体Materia。"
		""
		"配方中使用的管道不会被消耗掉。"
	]
	quest.40C7BC5F47AE64E6.quest_desc: [
		"&l白色魔导石&r是大多数魔导石生产线的基础。"
		""
		"一张空白画布，可以根据各种过程随心所欲地改变其属性。"
	]
	quest.43C29937A40AD71A.quest_desc: ["第五章的主要优化是&l配方燃料&r。如果设置得当，它能加快&l绿色&r和&l石灰材料&r的生产。"]
	quest.43C29937A40AD71A.title: "第五章 优化配置"
	quest.452749D5D12656C0.quest_desc: [
		"&l黑魔导书&r是白魔导书的对立面。"
		""
		"与可以通过各种工艺改变属性的空白画布不同，黑物质是由各种碎片拼凑而成，可以通过化学工艺将其提炼。"
	]
	quest.47B405EAA62A400A.quest_desc: [
		"&lMelter&r和&lReformer&r是许多生产线中使用的机器。"
		"完美变体的吞吐量提高，减少了这些机器造成的瓶颈数量。"
	]
	quest.47B405EAA62A400A.title: "完美物质操控术（Perfected Matter Manipulation）"
	quest.48070E14B4BFED52.quest_desc: [
		"&l青色魔导石&r对辐射有极强的抵抗力。"
		""
		"可用于建造反应堆及其运行所需的组件。"
	]
	quest.48358E6736BDE237.quest_desc: ["&l棕色材料&r主要用于装饰，让你的工厂看起来更美观。"]
	quest.48AC42FA7F653192.quest_desc: ["当您需要更强处理能力时，Precision Manufactory 的增强版。"]
	quest.4A0A80CC5265BA4F.quest_desc: ["&lPrecision Manufactory&r 是 &lManufactory&r 的改进版本。"]
	quest.4AC7452BE64C462F.quest_desc: ["为此你可能需要禁用你的聚合物生产功能。"]
	quest.4AC7452BE64C462F.title: "生命线 3"
	quest.4B972891759DD16A.quest_desc: [
		"一旦你种植了 &lCanola&r，就需要对它进行加工。"
		"这可以通过一些简单的机器来完成，例如 &lCanola Press&r 和 &lFermenting Barrel&r。"
	]
	quest.4D8B421A3CF1CC6B.quest_desc: [
		"&l紫色魔导石&r是一种具有奇特性质的魔导石，可以通过炼金术的方法制造出来。"
		""
		"虽然它大多能抵抗炼金术，是保护机器零件的好材料，但通过合适的工艺，可以将其转化为其他形式的物质。"
	]
	quest.4F138B479A1B2553.quest_desc: [
		"&lCrucible&r 能够进行一定量的炼金术加工，包括自动化处理 &lMutating Salt&r。"
		""
		"此外，&lCrucible&r 还能创造另一种盐，即 &lReturning Salt&r。这种盐能将晶体恢复到之前或相似的形式。"
	]
	quest.4F1B44ECE26FADCE.quest_desc: ["&lPaxel&r和&lWrench&r在整个整合包中都会是非常有用的工具。"]
	quest.4F1B44ECE26FADCE.title: "贸易的工具 (Tools of the Trade)"
	quest.4F5C79018B874D45.quest_desc: [
		"&l粉红材料&r是&l紫色材料&r的衍生品。"
		""
		"虽然失去了炼金抗性，但它更适合用于高级组件中。"
	]
	quest.5115571D05597E84.title: "带框流体桶"
	quest.54526E4ADD5A456D.quest_desc: ["尝试突变 &l红色水晶碎片&r。"]
	quest.54CDB687909E9D67.quest_desc: [
		"完全自动化了三种最基本的&lMateria&r之后，就该着眼于更广阔的天地了。"
		""
		"完成此任务可获得一把&l房间钥匙&r，将其用于房间一侧的锁上，即可创建一个额外的房间。"
		""
		"尽量减少所用房间的数量，这会是一个有趣的挑战。"
		""
		"更新：2026年5月15日，roidrole成功完成了单人房间挑战。"
	]
	quest.54CDB687909E9D67.title: "扩建你的工厂"
	quest.55FE0DD13A97A810.quest_desc: ["突变盐&lMutating Salt&r会导致晶簇在生成时发生突变，从而改变其颜色。"]
	quest.565614259DD6671B.quest_desc: [
		"&l酿酒厂&r是用于加工&l黑物质&r的主要机器之一。"
		""
		"&l注意：&r 它需要在其上方放置一个 &l化学惰性外壳&r，用于当前配方中的每个输出。"
	]
	quest.59D0E6C82403EDA1.quest_desc: ["损坏的核反应堆组件可以回收成废料和一些更难自动化的组件。"]
	quest.59D0E6C82403EDA1.title: "组件回收"
	quest.59DC237F396768E4.quest_desc: [
		"&l绿色魔晶石&r是一种放射性的魔晶石。"
		""
		"它与&lLime Materia&r有相似的特性，但其更不纯的结构使其在生产中有不同的用途。"
	]
	quest.5B5D3A140BC15C0C.quest_desc: ["完美的&l同位素生产&r可能会使你的储备量变得相当低。"]
	quest.5B5D3A140BC15C0C.title: "生命线 5"
	quest.5D5BD177C14633A0.quest_desc: ["&l红色材料&r导电性极佳。"]
	quest.5D79FA1B17BD4865.quest_desc: [
		"&l电路&r是最基础、最重要的机器组件之一。"
		"它们可以用两个 &lWires&r 和一个 &lPlate&r 来制作。"
	]
	quest.5DD96C53235DF37E.quest_desc: [
		"自动化本章的三种魔导石后，你就可以进入下一章了。"
		"这会是一个有趣的任务呢。"
	]
	quest.5DD96C53235DF37E.title: "我跟你说过那不是油，你偏不信"
	quest.5F707E16B03D0F02.quest_desc: [
		"现在有了你的 &l裂变反应堆&r 和反应堆组件，你就可以开始制造 &l绿色&r 和 &l青柠色材料&r 了。"
		""
		"由于&l裂变反应堆&r的EMI部分极其混乱，所以这里列出了各种配方："
		""
		"液态青色 + 液态紫色 = 液态绿色 \& 液态黑色"
		""
		"液态黑色 + 液态橙色 = 液态绿色 \& 液态青色"
		""
		"液态紫色 + 液态橙色 = 液态绿色 \& 液态青柠"
		""
		"液态绿 + 残留物 = 液态石灰 & 未精炼聚合物"
		""
		"液态绿 + 蓝色母质污泥 = 液态石灰 & 液态蓝"
		""
		"液态黑 + 原浆 = 硫酸浆液 \& 残留物"
		""
		"液态绿 + 液态石灰 = 完美浆料 \& 液态白"
	]
	quest.5F707E16B03D0F02.title: "核科学 (Nuclear Science)"
	quest.62627471041708C9.quest_desc: ["&l橙色材料&r对流体物流很有用。"]
	quest.62CC08DC76B16AD5.quest_desc: ["&l完美导线&r能够无损地传输能量和信息。"]
	quest.62E1F2BA89E07546.quest_desc: [
		"有了这些新机器，你应该就有自动化生产&l蓝色材料&r（以及&l棕色材料&r）所需的所有工具了。"
		""
		"注意，这可能需要第二个 Cubic Materia 设置，因为 &lRed \& Gray Materia&r 可用于处理线。"
		"也建议在这里将&l橙色材料&r自动化。"
	]
	quest.62E1F2BA89E07546.title: "化学基础知识 Basics of Chemistry"
	quest.639C3993D400167E.quest_desc: ["&l燃料气体&r是三种流体中最简单的，只需蒸馏&l燃料气体&r，并将结果与&l重污泥&r产线的材料混合即可。"]
	quest.639C3993D400167E.title: "燃料气体处理"
	quest.658947C9DFEC0ADA.quest_desc: ["&lMelter&r 和 &lReformer&r 能够改变你的物质所处的物态。"]
	quest.658947C9DFEC0ADA.title: "物质的操控 Manipulation of Matter"
	quest.65CEA274944E314A.quest_desc: [
		"&l聚变反应堆&r是唯一能制造&l彩虹材料&r的机器。"
		""
		"结构与&l裂变反应堆&r类似，但使用&l完美外壳&r。"
	]
	quest.65D4E9D2B510DFA2.title: "物品抽屉"
	quest.669007C792637EC8.quest_desc: ["一种可以自动化的碎片水晶。这种是浅蓝色的。"]
	quest.66CC9C8237A82FC0.quest_desc: ["&l完美电路&r是最先进的电路类型，能够以高速处理海量信息。"]
	quest.66CFEB21DDED0B33.quest_desc: ["&l红晶簇&r可以通过用盐结晶化&l红石粉&r或&l红晶碎片&r来制作。"]
	quest.68A6D46D941C98D9.quest_desc: ["&lMixer&r 和 &lCentrifuge&r 是最基础的化学品处理方法。"]
	quest.68A6D46D941C98D9.title: "混合与分离"
	quest.68D67B77A76FC144.quest_desc: ["复合聚合物锭&lComposite Polymer Bars&r将广泛用于各种机器和组件的配方中。"]
	quest.6AFE3E3B8B3CE6D2.quest_desc: [
		"要建造一个&l裂变反应堆&r，你需要一个放置它的容器。"
		"这需要 &lRadiation Proof Casings&r。"
		""
		"在配方中使用时，&l青色材料&r有时会留下&l青色废料&r，可以重新加工成&l青色材料&r。"
	]
	quest.6AFE3E3B8B3CE6D2.title: "防辐射外壳"
	quest.6B16A025FC90519B.quest_desc: ["&l黄色聚合物块&r可用于建造&l弯曲物品管道&r，以及高级机器和组件。"]
	quest.6C6E687A105AA010.quest_desc: [
		"&l化学反应器&r是一种机器，由于其在自动化中的广泛应用，从现在开始将被大量使用。"
		""
		"&lNote:&r The &lChemical Reactor&r requires &lChemically Inert Casings&r directly above and bellow it in order to opperate."
	]
	quest.6E34D1424AB37475.quest_desc: ["由于不像之前的章节，几乎不可能在一个房间里完成本章（除非你叫 Roidrole），你将获得五个 &lLifelines&r，每个都能提供一个额外的钥匙。"]
	quest.6E34D1424AB37475.title: "生命线"
	quest.6EFAE9B21D5F7659.quest_desc: [
		"&l黄色魔石&r是制作高级物品管道的良好材料。"
		""
		"其灵活性和相对较高的抗性使其在生产中用途广泛。"
	]
	quest.705FDEEEFF15D4EF.quest_desc: ["第三章没有太多特定的自动化，但有了Curvy Pipes和一些新配方，可以让线路更整洁。"]
	quest.705FDEEEFF15D4EF.title: "Chapter 3 Optimization"
	quest.70C1318EB406E082.quest_desc: ["考虑到你一路走来经历了这么多，自动化&l绿色&r和&l青柠色材料&r应该不会太难。"]
	quest.70C1318EB406E082.title: "这又不是什么火箭科学"
	quest.71B7A0836C61CBF0.title: "Matercrete"
	quest.726F7D55639148A8.quest_desc: [
		"&lCrystallizer&r 是一种有趣的机器。"
		""
		"需要正上方有空气才能正常工作。"
		""
		"它可以消耗一个水晶碎片（或红石粉，因其结构与&l红水晶碎片&r相似）和一些盐来生长一个水晶簇。"
		""
		"注意，配方产物在 EMI 中未显示，且部分配方有多种产物，建议使用本任务提供的书和羽毛笔来记录配方产物。"
	]
	quest.72E2BB9F26BFBD8D.quest_desc: [
		"&l品红材料&r是&l紫色材料&r的衍生品。"
		""
		"可以用来远距离发送信号。"
	]
	quest.74EB7A3313EB1606.quest_desc: ["将&l基础魔导石钻头&r放置在&l魔导石矿床&r上并提供动力，即可自动生产&l白色魔导石&r。"]
	quest.758DF9ED26770083.quest_desc: [
		"完美机器是机器的最终等级。"
		""
		"除&lFusion Reactor&r外，所有完美机器都能运行其普通变体的配方，并且能同时运行两种配方。"
	]
	quest.758DF9ED26770083.title: "完美机器"
	quest.75B815E9319784C3.quest_desc: [
		"&l彩虹魔导器&r是魔导器的终极形态。"
		""
		"它将所有先前形态的Materia的特性融合在一起，形成了终极的Omni-Material™。"
	]
	quest.798ADAC7F97C2FBE.quest_desc: ["&l幻影谐振器&r是一种能将信号传输到远处的实用组件。"]
	quest.79941ED9754E3C6A.title: "Materia Bricks"
	quest.79CEAD9651434570.quest_desc: [
		"第三章机器的完美变种非常有用，尤其是它们解锁的额外配方。"
		""
		"注意：完美酿酒坊对于&l反物质任务&r是可选的。"
	]
	quest.79CEAD9651434570.title: "完美化学（Perfected Chemistry）"
	quest.7B08FD94B73358C4.quest_desc: ["&l原子重构器&r可以重构原子。（这到底是谁写的？）"]
	quest.7C245A55E69FE2EC.quest_desc: ["这些方块可用于自动化处理 &lCubic Materia&r。"]
	quest.7C245A55E69FE2EC.title: "与世界互动"
	quest.7CA88CDB2BA74716.quest_desc: ["虽然&l纯净水&r是有限的（或者说，用Materia制成的东西都有限），但普通的&l水&r可以在世界中创造无限水源。"]
	quest.7DCB3A34EE08750B.quest_desc: ["&l浅灰色材料&r是一种非常稳定的材料，可以加工成有用的塑料。"]
	quest.7EB235939DBB3FC8.quest_desc: ["&lCurvy Energy Pipes&r 几乎是某些 &lChemical Reactor&r 配方所必需的。"]
	quest.7FD1E26751147B23.quest_desc: ["&l完美外壳&r是现存最好的外壳类型。"]
	task.04A5A0B4C1484C5A.title: "任意数量的Materia砖块"
	task.053CF673BA7B846E.title: "幻影物品面或液体物品面"
	task.05E8E06E334B3CC8.title: "任意的材料灯（Materia Lamp）"
	task.094BC331042B0222.title: "任意的热交换器"
	task.1281E70E90579E0C.title: "任意控制器"
	task.18831E504D3F643B.title: "任意反应堆核心"
	task.1928C264FFD9FE90.title: "任意的材料窗口"
	task.211613DDC51A0902.title: "任意无线发射器"
	task.3858291BE2FB8807.title: "任意数量的Materia木板"
	task.3F9C150184B4173A.title: "任何混凝土块"
	task.4028D630BA617391.title: "原子重构一个材料沉积物"
	task.4540B8B4793568E9.title: "任意流体抽屉"
	task.456C18BD055D8F0A.title: "任意物品抽屉"
	task.46A804E80C9EAC9D.title: "任意一个带框架的流体抽屉"
	task.556132E0A1D63076.title: "任意一个带框架的物品抽屉"
	task.703EDF45BB8F4191.title: "任意AA世界交互方块"
	task.757AF7E08DA8F774.title: "任意合成台"
}
