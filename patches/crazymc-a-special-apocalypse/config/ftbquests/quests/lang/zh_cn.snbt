{
	chapter.04756ADCAD0B66D7.title: "&a&l禁忌秘典 (Forbidden Arcanus)</c2></c1>"
	chapter.05FA1E70C1243D83.title: "&a&l亡灵重制版模组 (The Undead Revamped)</c2></c1>"
	chapter.38A34E1F883BFD67.title: "&a&l大灾难"
	chapter.5C99715F6042482A.title: "&a&lA.V.A"
	chapter.5E76F6232D62B202.title: "&a&l生于混沌之中"
	chapter.616A43D765D1EFD2.title: "&a&lMowzie's mobs"
	chapter.6AEDA2F9BEB57759.title: "&a&l新艺术运动风格"
	chapter.6B6638BB63A994C2.title: "&a&l龙之进化模组（Draconic Evolution）"
	file.0000000000000001.title: "&r&lCrazyMC"
	quest.010BAD02A17734C1.quest_desc: ["&f在灼热的沙漠&a&f深处，埋藏着古老的&a诅咒金字塔，&f一座被诅咒、亡灵和宝藏吞噬的遗忘古墓。要找到它，冒险者必须制作&a沙漠之眼，&f一件能指引持有者前往遗迹的宝物。探索金字塔时，建议携带&a刷子，&f因为许多珍贵遗物仍隐藏在遍布结构的可疑沙土中。"]
	quest.010BAD02A17734C1.quest_subtitle: "&7追随沙漠之眼 (Follow the Eye of the Desert)"
	quest.010BAD02A17734C1.title: "&5&l任务：&r&e无尽沙丘之下"
	quest.015D5AFC64751C49.quest_desc: [
		"&f&o使用千金属斧，执行以下操作："
		"&f&o水平弧线（右键）和垂直冲击波（潜行+右键）。"
		"&f&o无法破坏，但要掌握时机。"
	]
	quest.015D5AFC64751C49.quest_subtitle: "&7横扫和冲击波"
	quest.015D5AFC64751C49.title: "&f&l千金属之斧：技巧篇"
	quest.01FAA6B9770AC7BA.quest_desc: ["&f一个怪异的&c&l僵尸&r&f手持&6&l钓鱼竿&r&f，背上驮着装有渔获的&6&l木桶&r&f，似乎在寻找新的钓鱼点。你必须终结这个&c&l不死渔夫&r&f，并夺取它的渔获。"]
	quest.01FAA6B9770AC7BA.quest_subtitle: "&l一位寻求新渔场的亡灵渔夫"
	quest.01FAA6B9770AC7BA.title: "&8&l僵尸渔夫"
	quest.025542D2AA761BCA.quest_desc: ["&f在&a龙裔工程&f最先进的交通系统中，最强大的当属&a位移器容器&f，它能创建稳定的传送门，供玩家、生物甚至物品使用。要建造一个可用的传送门，冒险者必须先用&a龙裔浸透黑曜石&f建造任意大小的框架，并在其中集成一个&a位移器容器&f。完成后，只需使用已绑定的&a位移器&f右键容器，传送门便会激活，将所有经过的实体瞬间传送到存储的目的地坐标。"]
	quest.025542D2AA761BCA.quest_subtitle: "&7Craft the Dislocator Receptacle"
	quest.025542D2AA761BCA.title: "&5&l任务：&r&e穿越维度的传送门"
	quest.0454DF25D2B8BCE2.quest_desc: [
		""
		"生命值：&2&l30&f&r"
		"生成地点：&6&l主世界的任何地方&f&r"
		"攻击：&2&l4&f&r"
		"速度：&6&l非常快&f&r"
		""
		"特殊能力："
		"- Can &e&lspot enemies&f&r from &6&lvery far away&f&r, then rushes in with terrifying speed."
		"- 在生物上使用&d&lArapholia香水瓶&f&r，会使月亮花&c&l锁定该生物&f&r，而不是你。"
		"- &d&lArapholia flowers&f&r，由该生物掉落或自然生成，会随机给生物施加&d&lscent&f&r，使 The Moonflower &6&lhunt them down&f&r。"
		"- 气味不会&8&l影响不死生物&f&r，除非来自&d&l香水瓶&f&r。"
		"- 阿拉弗利亚花也可以&2&l酿造&f&r以获得&d&l相同的效果&f&r。"
		""
		"弱点："
		"在空中&6&l飞行&f&r时被击中，有几率&e&l眩晕&f&r。"
		""
		"注意："
		"- 有极低概率掉落&0&l黑色花瓣块&f&r。此方块可用于&d&l对生物施加气味&f&r，具体取决于中间槽位放置的物品："
		"- &b&lDiamond&f&r = &2&lPlayer&f&r"
		"- &8&lRotten Flesh&f&r = &2&lUndeads&f&r"
		"- &f&lBones&f&r = &2&lPets&f&r"
		"- &c&l苹果&f&r = &2&l任何生物&f&r"
		"- &f&lString&f&r = &2&l怪物&f&r (不包括 Moonflowers)"
		"- &d&lArapholia&f&r = &2&lMoonflowers&f&r"
	]
	quest.0454DF25D2B8BCE2.quest_subtitle: "&l击杀月亮花（恶魔不死生物）"
	quest.0454DF25D2B8BCE2.title: "&8&l杀死月亮花 (Kill The Moonflower)</c2></c1>"
	quest.051C19AEA346A5BA.quest_desc: ["&f威龙装备可通过使用专门的&a模块进行定制和大幅增强。 &f这些升级能带来多种效果，如提升伤害、挖掘速度、防护、移动能力及其他改进，具体取决于所安装的模块。此外，工具和盔甲可装备&a能量模块，&f使其能内部储存能量，从而保证所有已安装的模块正常运作。若没有足够的储存能量，许多高级模块能力将无法激活。"]
	quest.051C19AEA346A5BA.quest_subtitle: "&7用模块强化你的装备"
	quest.051C19AEA346A5BA.title: "&5&l任务：&r&e模块化龙族科技"
	quest.05FFDD0E20E133CA.quest_desc: ["&f季节性恐怖来袭！&c&l南瓜头爵士&r&f，一位强大的迷你首领，会在万圣节期间出现巡逻。准备好迎接一场&c&l艰难的战斗&r&f，他会分阶段攻击你，使用他的&c&l马&r&f、&c&l爆炸南瓜&r&f，甚至他的&c&l分离的头颅&r&f。只有最技艺高超的冒险者才能击败他。"]
	quest.05FFDD0E20E133CA.quest_subtitle: "&l季节性恐怖的小头目"
	quest.05FFDD0E20E133CA.title: "&8&l南瓜头爵士"
	quest.08FA3BFDB80F2090.quest_desc: ["&f自远古地穴与荒芜废土深处，&c&lBonescaller&r&f现身。这具骸骨怪物身披骨甲，是令人胆寒的强敌。传闻其利爪能轻易撕裂盔甲。你必须深入黑暗，终结这具骸骨恐怖。"]
	quest.08FA3BFDB80F2090.quest_subtitle: "&l从被遗忘的坟墓中崛起的骷髅恐怖生物"
	quest.08FA3BFDB80F2090.title: "&8&l骸骨召唤者（The Bonescaller）"
	quest.0927221C089B601F.quest_desc: ["&fBeyond traditional relay systems lies the advanced &aWireless Energy Crystal, &fa draconic device capable of transmitting energy directly into compatible machines and components without requiring dedicated input or output crystals. This allows for cleaner and more flexible energy networks across your infrastructure. However, this convenience comes with a slight drawback, as wireless transmission operates somewhat slower compared to direct crystal connections."]
	quest.0927221C089B601F.quest_subtitle: "&7Craft the Wireless Energy Crystal"
	quest.0927221C089B601F.title: "&5&l任务：&r&e无线龙之传输"
	quest.09DBE1AA9A3F8A6C.quest_desc: ["&f一个新的威胁已经崛起，据说有一具强大的骷髅掌握着毁灭的本质。名为&c&lSkeleton Demoman&r&f的骨火生物正在肆虐这片土地。它的存在让世界陷入诡异的寂静，仿佛在等待合适的时机发动攻击。必须由你来直面这个敌人，终结它的恐怖统治。"]
	quest.09DBE1AA9A3F8A6C.quest_subtitle: "&l从被遗忘的坟墓中崛起的恐怖之物"
	quest.09DBE1AA9A3F8A6C.title: "&8&l低语的骸骨 (The Whispering Bones)</c2></c1>"
	quest.09F04E68AF8F4EF5.quest_desc: ["&f潜伏在&a霜冻监狱&f冰冷黑暗中的，是可怕的&aAptrgangr，&f这些巨大的受诅咒刽子手能对毫无防备的冒险者造成毁灭性伤害。它们残酷的攻击和压倒性的存在感，使其成为守卫最终通道的最致命敌人之一。在挑战这座冰冻监狱的统治者之前，强烈建议至少击败&a两只&f此类怪物。"]
	quest.09F04E68AF8F4EF5.quest_subtitle: "&7击败 Aptrgangr"
	quest.09F04E68AF8F4EF5.title: "&5&l任务：&r&e冰冻深渊的屠夫们"
	quest.0A19C4C36C2F9887.quest_desc: ["&f村里的炼金术士急需&c&l怪物皮&r&f来酿造一种新的强力药水。这些独特的材料只能从世界最黑暗角落游荡的各种怪物身上获得。你必须冒险外出，击败这些可怕的生物来收集所需材料。"]
	quest.0A19C4C36C2F9887.quest_subtitle: "&l收集混乱与恐怖的材料"
	quest.0A19C4C36C2F9887.title: "&8&l怪物狩猎之旅"
	quest.0B07238399715DE8.quest_desc: [
		"&f&o在雪地群系追踪一只沉睡的Frostmaw。"
		"&f&o偷走或获取它的冰晶——从它的手中捡起或在战斗中赢得它。"
	]
	quest.0B07238399715DE8.quest_subtitle: "&7来自冰冻荒野的雪人怪"
	quest.0B07238399715DE8.title: "&f&l征服霜之巨口"
	quest.0BC826033C2E1FEB.quest_desc: ["&fUsing the power of the &aMechanical Fusion Anvil &fand a rare &aVoid Core, &fthe devastating &aWither Assault Shoulder Weapon &fcan be transformed into the far more dangerous &aVoid Assault Shoulder Weapon. &fThis enhanced version launches heavier void-infused rockets with increased gravity, making accurate shots more difficult to land. However, upon impact with the ground, the explosions unleash catastrophic &aarea damage &fcapable of destroying entire groups of enemies at once. Though immensely powerful, the weapon can also become a threat to its own wielder if used carelessly."]
	quest.0BC826033C2E1FEB.quest_subtitle: "&7升级肩部武器（Upgrade the Shoulder Weapon）"
	quest.0BC826033C2E1FEB.title: "&5&l任务：&r&e虚空之火火炮"
	quest.0BD340B467B7420F.quest_desc: ["&f&a霜冻监狱&f的走廊里游荡着危险的&a精英德拉格，&f比普通战士强大得多的被诅咒的亡灵战士。它们的耐久度和战斗能力使其在探索期间构成严重威胁。击败至少&a三个&f此类敌人将有助于削弱保护监狱内室的重重阻力。"]
	quest.0BD340B467B7420F.quest_subtitle: "&7击败精英德拉格（Elite Draugr）"
	quest.0BD340B467B7420F.title: "&5&l任务：&r&e冰冻亡灵的冠军们"
	quest.0C05A7D911E79D30.quest_desc: ["&fAmong the specialized chemical resources used within &aAlliance of Valiant Arms, &fthe valuable &aAcetone Solution &fstands out as one of the most important for weapon customization. This industrial chemical is required for applying colors, finishes and visual modifications to firearms through the &aA.V.A Colouring Table. &fWithout a stable supply of Acetone Solution, advanced weapon personalization and cosmetic modifications become impossible."]
	quest.0C05A7D911E79D30.quest_subtitle: "&7生产丙酮溶液"
	quest.0C05A7D911E79D30.title: "&5&l任务：&r&e化学武器收尾工作"
	quest.0CD264A330EA4D82.quest_desc: [
		"&f空气变得寒冷，幽灵南瓜的诡异光芒笼罩着黑夜。一个&c&l南瓜之灵&r&f，一个依附于枯萎的&c&l杰克灯&r&f的不安灵魂，正在这片土地上徘徊。它在黑暗中滑行，恶毒的笑声在树林间回荡，向活人寻求复仇。你必须直面这个&c&l复仇的幻影&r&f，让它的灵魂安息。"
		""
		"{image:kubejs:textures/borninchaos/pumpkinspawn.png width:100 height:100 align:center}"
	]
	quest.0CD264A330EA4D82.quest_subtitle: "&l秋日黑暗中的幽灵守护者"
	quest.0CD264A330EA4D82.title: "&8&l南瓜之灵"
	quest.0D053DE72F12831E.quest_desc: ["&f一位昔日高贵的骑士如今在世间游荡，盔甲被黑暗混沌的能量所腐蚀。它的双眼闪烁着恶意的光芒，行动难以预测且迅如疾风。你必须直面这位&c&l堕落冠军&r&f，终结它备受折磨的存在。"]
	quest.0D053DE72F12831E.quest_subtitle: "&l被黑暗力量所腐化的高贵战士"
	quest.0D053DE72F12831E.title: "&8&l堕落混沌骑士"
	quest.0D2AD999EBAE1339.quest_desc: ["&f传奇铁匠交给你一个艰巨的任务：用强大的&c&l暗金属&r&f打造一套完整的盔甲。这不仅需要大量材料，还需要直面守护它的混沌势力的勇气与技巧。"]
	quest.0D2AD999EBAE1339.quest_subtitle: "&l混沌中锻造，黑暗中淬火"
	quest.0D2AD999EBAE1339.title: "&8&l混沌锻造盔甲"
	quest.0D54FFF22B58B991.quest_desc: ["&f在一切龙族科技的巅峰，存在着传奇的&a混沌能量核心，&f一种用于最强大融合配方的高级四阶能量组件。这种由磅礴的龙族与混沌能量锻造而成的材料，是制作终局神器、传说装备以及某些最强大科技造物所必需的，&a唯有完全掌握高级融合系统的强者，方能驾驭此等力量。"]
	quest.0D54FFF22B58B991.quest_subtitle: "&7Craft the Chaotic Energy Core"
	quest.0D54FFF22B58B991.title: "&5&l任务：&r&e混沌工程之心"
	quest.0D8997562D85EC13.quest_desc: ["&f在&a霜冻监狱&f的中央，可怕的&aMaledictus&f正等着你，它是旅途的最终也是最危险的Boss。这位被诅咒的战士拥有压倒性的力量、致命的速度和毁灭性的能力，能瞬间摧毁装备精良的冒险者。如果反应慢了一秒，它的许多攻击会立即扭转战局。击败Maledictus会奖励珍贵的诅咒材料，可用于锻造传奇武器，如&a诅咒之弓、湮灭者&f以及其他曾被Boss本人使用的强大遗物。"]
	quest.0D8997562D85EC13.quest_subtitle: "&7击败 Maledictus"
	quest.0D8997562D85EC13.title: "&5&l任务：&r&e所有诅咒的终结"
	quest.0DAE5BCCCA2F12FE.quest_desc: ["&fDeep within the scorching &aNether &flies the ancient &aSoul Black Smith, &fa forgotten forge consumed by fire and souls. To locate this dangerous structure, you must first craft the &aEye of Monsters, &fa mystical eye capable of guiding adventurers toward its hidden location. Beware, for inside rests a terrifying &anetherite monster &fwhose strength can easily overwhelm those who enter without powerful gear and preparation."]
	quest.0DAE5BCCCA2F12FE.quest_subtitle: "&7追随怪物之眼 (Follow the Eye of Monsters)"
	quest.0DAE5BCCCA2F12FE.title: "&5&l任务：&r&e灵魂锻造匠"
	quest.0ED90CC5E44D8ADA.quest_desc: ["&fBy compressing refined &aDraconium Ingots, &fit becomes possible to create the powerful &aDraconium Block, &fa dense storage form infused with concentrated draconic energy. Beyond simple storage, this block serves as an essential material for many advanced recipes and future fusion processes. As your mastery of draconic technology grows, these blocks will become increasingly important for crafting stronger components and legendary equipment."]
	quest.0ED90CC5E44D8ADA.quest_subtitle: "&7合成一个龙晶块"
	quest.0ED90CC5E44D8ADA.title: "&5&l任务：&r&e压缩的龙之能量"
	quest.10C2F8C29D2D5EC1.quest_desc: ["Agronomic Sourcelink 是一种机器，能在 15 格范围内通过作物和树木的生长来生成“源”。魔法植物，如 Mageblooms、Source Berry Bushes 和 Archwood Saplings，会提供额外的源。生成的源会从 Sourcelink 输出到 5 格范围内的邻近罐子中。"]
	quest.10C2F8C29D2D5EC1.quest_subtitle: "农业源链接生成器。"
	quest.10E179940477D829.quest_desc: [
		""
		"生命值：&2&l25&f&r"
		"生成地点：&6&l主世界的任何地方&f&r"
		"攻击：&2&l3&f&r"
		"速度：&6&l正常&f&r"
		""
		"特殊能力："
		"- 呼出&d&l粉色烟雾&f&r，会&8&l遮挡你的视野&f&r并&8&l削弱你的力量&f&r。"
		"吸入烟雾的亡灵生物会获得&2&l正面效果&f&r。"
		"- 可以用&7&l盾牌&f&r来&6&l阻挡&f&r烟雾。"
		""
		"弱点："
		"- &4&l火&f&r能立即杀死它们。"
		"- 多次攻击可以&6&l斩首&f&r它们，这样就能&c&l禁用&f&r它们的烟雾攻击。"
		""
		"木材变种："
		"- 造成&4&l巨额伤害&f&r。"
		"- 拥有&6&l更快的行走速度&f&r。"
		"无法被&6&l斩首&f&r。"
	]
	quest.10E179940477D829.quest_subtitle: "&l击杀虚弱的家伙（掠夺者构造体）"
	quest.10E179940477D829.title: "&8&l杀死气喘怪 (Kill The Wheezer)</c2></c1>"
	quest.11D7B306709F8DF4.quest_desc: ["每个符文都需要一组物品和经验值来解锁。点击菜单并按选择键来选择一个符文。将物品像上面那样扔到桌子上，桌子就会写下该法术。"]
	quest.11D7B306709F8DF4.quest_subtitle: "在这张表里你可以看到所有的符文。"
	quest.11D7B306709F8DF4.title: "用于创建和放置符文的表格"
	quest.136CA5950A22C66C.quest_desc: ["&f在&a龙之工程&f的绝对巅峰，矗立着传奇的&a混沌融合制造注射器，&f这是融合技术的第四级，也是最终级。有了这个注射器，冒险者就能获得模组内最强的装备、物品和科技造物。要制造这样一个组件，需要在已有的高级融合装置中献祭一个&a龙之融合制造注射器，&f同时还要用到像&a大型混沌碎片&f和甚至&a龙之卵&f这样极其珍贵的材料。只有征服了混沌之力本身的人，才有希望锻造出这台终极融合装置。"]
	quest.136CA5950A22C66C.quest_subtitle: "&7Craft the Chaotic Fusion Injector"
	quest.136CA5950A22C66C.title: "&5&l任务：&r&e通往混沌融合的门户"
	quest.14DF06C3C3609504.quest_subtitle: "&7制作威龙斧头"
	quest.14DF06C3C3609504.title: "&5&l任务：&r&e龙之锻造的怒火"
	quest.14F4945338F8A24E.quest_desc: ["&f随着&aDraconic Engineering&f向更复杂的系统扩展，配方和融合组合可能难以记忆。强烈建议使用&aJEI (Just Enough Items)&f来轻松查看每个龙裔组件和遗物的合成配方、融合需求、模块升级和进阶路径。掌握JEI将极大地简化你探索高级龙裔技术的旅程。"]
	quest.14F4945338F8A24E.quest_subtitle: "&7使用JEI来查找配方"
	quest.14F4945338F8A24E.title: "&5&l任务：&r&e通过JEI获取知识"
	quest.1506BE7B585B6265.quest_desc: [
		""
		"生命值：&2&l30&f&r"
		"攻击：&2&l3&f&r"
		""
		"属性：&6&l抗击退&f&r，并且&6&l速度很快&f&r。"
		""
		"特殊能力：爆炸并在受害者脸上溅上 &4&l黏液&f&r，使其变得 &4&l脆弱&f&r 且恐惧。"
		""
		"注意：爆炸前通常会跳&e&l2次&f&r。如果目标不够近，计时器会&c&l重置&f&r。在爆炸前一刻击中它，会使其&4&l立即爆发&f&r。粘液可以用&9&l水&f&r洗掉，被其覆盖的任何生物都会受到额外的&c&l火焰伤害&f&r。"
	]
	quest.1506BE7B585B6265.quest_subtitle: "&l击杀炸弹手（真僵尸）"
	quest.1506BE7B585B6265.title: "&8&l消灭炸弹手"
	quest.15A0A593215FBF56.quest_desc: ["&f深藏于地下和危险维度中的神秘矿物&a德拉科尼姆矿石，&f蕴含着强大的龙之能量。这种资源是你龙之进阶过程中几乎所有机器、武器、护甲和高级系统的基础。乍看之下看似普通，但德拉科尼姆是解锁远超凡人理解的技术和力量的关键材料。"]
	quest.15A0A593215FBF56.quest_subtitle: "&7获取龙脉矿石 (Draconium Ore)"
	quest.15A0A593215FBF56.title: "&5&l任务：&r&e地底回响"
	quest.15C2813460334745.quest_desc: ["&f受折磨的灵魂的低语从世界遗忘的角落回响。这个&c&l被黑暗诅咒和活物所附身的&r&f灵魂，其悲伤与愤怒使其成为靠近其领域者的巨大威胁。你必须通过摧毁其&c&l幽灵形态&r&f，让这&c&l不安的灵魂安息&r&f。"]
	quest.15C2813460334745.quest_subtitle: "&l一个未被死亡所束缚的灵魂"
	quest.15C2813460334745.title: "&8&l一个不安的灵魂"
	quest.16D13E23A676081F.quest_desc: ["&fSomewhere beneath the suspicious sands of the &aCursed Pyramid &flies the mysterious &aNecklace of the Desert, &fan ancient relic required to awaken the sleeping &aAncient Remnant. &fThis artifact cannot be obtained through combat alone, forcing adventurers to carefully search the buried remains and suspicious sand scattered throughout the structure. Bringing a &abrush &fwill greatly aid in uncovering the hidden treasure buried beneath the dunes."]
	quest.16D13E23A676081F.quest_subtitle: "&7找到沙漠项链 (Necklace of the Desert)"
	quest.16D13E23A676081F.title: "&5&l任务：&r&e隐藏在沙中的遗迹"
	quest.1754D157344F024C.quest_desc: ["&f安全处理爆炸物需要专门的战术装备。 &aC4控制器 &f是一种便携式设备，专为在引爆前禁用已放置的 &aC4炸药 &f而设计。通过瞄准活跃的爆炸物并按住右键，冒险者可以开始解除程序，在倒计时结束前安全地使炸药失效。在危险的战斗情况下，掌握炸弹控制可能和知道如何部署爆炸物一样重要。"]
	quest.1754D157344F024C.quest_subtitle: "&7使用 C4 控制器"
	quest.1754D157344F024C.title: "&5&l任务：&r&e远程炸弹解除系统"
	quest.178450F2B8618AB7.quest_desc: ["砍下树木，获取木材用于新的制作。"]
	quest.178450F2B8618AB7.quest_subtitle: "你可以在主世界中找到它。"
	quest.178450F2B8618AB7.title: "魔法的树木"
	quest.18C556E8139D18D8.quest_desc: ["使用新手魔法书学习施放魔法的基础知识。"]
	quest.18C556E8139D18D8.quest_subtitle: "使用初级魔法书施放一个基础法术。"
	quest.18C556E8139D18D8.title: "释放你的第一个法术"
	quest.1B38E9D9E99B5F02.quest_subtitle: "&7Craft the Chaotic Bow"
	quest.1B38E9D9E99B5F02.title: "&5&l任务：&r&e全面毁灭之弓"
	quest.1C91EE2BBB874BBF.quest_desc: ["&f世界最深处，有微光若隐若现。据说那是&c&l灵魂向导&r&f的形态，它能指引迷途的灵魂。无数人探寻过它的智慧，却鲜有人成功。你的任务是找到这个神秘存在，学习它所传授的一切。"]
	quest.1C91EE2BBB874BBF.quest_subtitle: "&l指引迷途者的神秘存在"
	quest.1C91EE2BBB874BBF.title: "&8&l灵魂向导"
	quest.1D1396AFD4FCFB59.quest_desc: ["&fRecovered from the remains of &aThe Harbinger, &fthe legendary &aMechanical Fusion Anvil &fis one of the most important crafting stations for advanced progression. This ancient machine-forge allows adventurers to enhance powerful weapons and armor using rare materials such as &aVoid Cores &fand other legendary resources. Many of the strongest tools required for future boss fights can only reach their true potential through this mysterious anvil."]
	quest.1D1396AFD4FCFB59.quest_subtitle: "&7获得机械融合砧板 (Mechanical Fusion Anvil)"
	quest.1D1396AFD4FCFB59.title: "&5&l任务：&r&e机械飞升的熔炉"
	quest.1D8EB0A0A29E4C76.quest_desc: ["&f另一个强大的守护者沉睡在&a诅咒金字塔&f中，他就是可怕的&aKobolediator，&f一位守护着&a古代残骸&a周围房间的残暴不死战士。强烈建议在主要战斗前击败这名副首领，否则未做好准备的玩家可能会不堪重负。击败后，它会掉落宝贵的合成材料，如&fKobolediator头骨&a和&fKoboleton骨骼&a，这两种材料都需要与&f古代金属锭<c13>一起用于锻造强大的高级盔甲。"]
	quest.1D8EB0A0A29E4C76.quest_subtitle: "&7击败科博莱迪亚托尔 (Kobolediator)"
	quest.1D8EB0A0A29E4C76.title: "&5&l任务：&r&e被遗忘竞技场之冠军"
	quest.1DC1876AEE66BBD3.quest_desc: [
		""
		"生命值：&2&l50&f&r"
		"生成：主世界 Y≥78 处&6&l 或雪地生物群系中&f&r&6&l&f&r"
		"攻击力：&2&l10-13&f&r"
		""
		"特殊能力："
		"- 有 &2&l2 种主要攻击&f&r，分别是 &4&l重击&f&r 或 &4&l突刺&f&r，只要留意他的动作，这两种都 &6&l很容易躲避&f&r。"
		"- 他的攻击也可以被&6&l招架&f&r，将他的力量反作用于他自身。"
	]
	quest.1DC1876AEE66BBD3.quest_subtitle: "&l击杀熊人（维京人）"
	quest.1DC1876AEE66BBD3.title: "&8&l击杀棕熊 Bruin"
	quest.1FA43B9874D19737.quest_desc: ["&f一个穿着破旧彩衣的怪人，带着凝固的恐怖笑容，在世间游荡。这个不死的小丑走到哪里都散发着&c&l令人不安的气息&r&f，怪异的笑声在夜空中回荡。你必须&c&l永远终结它扭曲的欢闹&r&f。"]
	quest.1FA43B9874D19737.quest_subtitle: "&l一个给世界带来噩梦的扭曲小丑"
	quest.1FA43B9874D19737.title: "&8&l被诅咒的小丑"
	quest.2028E869D8866584.quest_desc: [
		""
		"生命值：&2&l5-7&f&r"
		"Spawns: &6&lIn rivers when raining&f&r or when summoned by &6&lThe Possessive&f&r"
		"近战：&2&l3&f&r + &2&l12% 几率&f&r 施加 &4&l狂犬病&f&r"
		"速度：&6&l\"快\"&f&r"
		""
		"特殊能力："
		"- 当目标超出射程时，可&6&l自行发射&f&r，且&2&l无冷却时间&f&r。"
		"- 在&9&l陆地&f&r和&9&l水上&f&r都能完全&6&l移动&f&r。"
		"- 可施加&4&l狂犬病&f&r，若目标在患病期间待在&9&l水中&f&r，将遭受&c&l可怕的后果&f&r。"
		""
		"提示："
		"- &e&l阳光&f&r或&4&l火焰&f&r对其效果极佳。"
		""
		"注意："
		"- 被&2&lgooed&f&r的怪物会受到额外的&c&l火焰伤害&f&r，所以可以利用这一点来&6&l取得优势&f&r。"
	]
	quest.2028E869D8866584.quest_subtitle: "&l杀死狂犬（恶魔不死生物）"
	quest.2028E869D8866584.title: "&8&l杀死狂犬病感染者 (Kill The Rabidus)</c2></c1>"
	quest.20D52DFF02402D76.quest_desc: ["&f使用精炼的&a德拉科尼乌姆锭，&f冒险者可以制作至关重要的&a德拉科尼乌姆核心，&f这是整个德拉科尼乌姆工程学中最关键的组件之一。这个神秘的核心是制作装备升级模块、融合制造系统、高级工具和无数科技结构所必需的。此外，它还是许多未来融合配方中的关键材料，因此在你整个进阶过程中都不可或缺。"]
	quest.20D52DFF02402D76.quest_subtitle: "&7制作一个龙晶核心"
	quest.20D52DFF02402D76.title: "&5&l任务：&r&e龙之工程的精髓"
	quest.20FBA6FEFD649F3C.quest_desc: [
		"&f&o使用冰晶释放持续的寒冰吐息。"
		"&f&o将光束长时间锁定在目标上，即可冻结敌人。"
	]
	quest.20FBA6FEFD649F3C.quest_subtitle: "&7像霜牙一样呼吸冬日的空气"
	quest.20FBA6FEFD649F3C.title: "&f&l掌握冰晶的力量"
	quest.2133A9B0C1E18F23.quest_subtitle: "&7Craft the Draconic Chestpiece"
	quest.2133A9B0C1E18F23.title: "&5&l任务：&r&e龙之飞升胸甲"
	quest.2174B95D56F8B60A.quest_desc: ["&fHidden among the cursed treasures of &aMaledictus &flies the rare &aCursium Upgrade, &fa powerful smithing template capable of transforming ordinary &aNetherite Armor &finto the legendary &aCursium Armor. &fThis forbidden enhancement grants several powerful effects to its wearer, including the ability to &arevive after death &fwith a small amount of remaining health. Such power makes this upgrade one of the most valuable rewards obtainable from the final stages of progression."]
	quest.2174B95D56F8B60A.quest_subtitle: "&7Craft the Cursium Upgrade"
	quest.2174B95D56F8B60A.title: "&5&l任务：&r&e禁忌复活的秘密"
	quest.229E869D17893FE6.quest_desc: ["&f在&a诅咒金字塔&f的走廊里游荡着不死生物的群体——&aKoboleton，&f这种小型骷髅生物单独出现时可能并不显得特别危险。然而，击败至少&a五只&f这类怪物至关重要，因为它们的遗骸能提供宝贵的合成材料，用于锻造强大的盔甲套装。当面对金字塔深处更危险的领主时，这些资源将变得极为有用。"]
	quest.229E869D17893FE6.quest_subtitle: "&7击败科博莱顿们"
	quest.229E869D17893FE6.title: "&5&l任务：&r&e沙土下的骸骨"
	quest.23A0DAC60FF5C4D0.quest_subtitle: "&7制作威龙弓 (Craft the Wyvern Bow)"
	quest.23A0DAC60FF5C4D0.title: "&5&l任务：&r&e龙之精准弓"
	quest.23FA13D08B5AC5AD.quest_desc: ["&f&a霜冻监狱&f最强大的守卫者之一是可怕的&a皇家德拉克&f，这些古老的诅咒战士能以强大的攻击和不懈的凶猛压倒轻率的冒险者。要缓慢地确保通往冰冻堡垒深处的危险路径，必须击败至少&a三个&f这样的精英不死士兵。"]
	quest.23FA13D08B5AC5AD.quest_subtitle: "&7击败皇家龙骑士（Royal Draugr）"
	quest.23FA13D08B5AC5AD.title: "&5&l任务：&r&e冰封诅咒的骑士团"
	quest.2473E03FC857E774.quest_desc: ["通过附近的生物死亡和动物繁殖生成源。此外，它还通过幼崽生成被动源并加速其成长。"]
	quest.2473E03FC857E774.quest_subtitle: "来源：动物生活（Animal Life）。"
	quest.2480A3EEE69E9027.quest_desc: [
		"&fModern firearms often rely on advanced optics to improve targeting efficiency and battlefield precision. Through the creation of specialized &aLenses, &fadventurers gain access to the crafting of various scoped weapons and firearms equipped with optical sights. These components become important materials for many advanced weapons focused on long-range accuracy and tactical combat performance."
		"{image:kubejs:textures/images/lens.png width:100 height:55 align:center}"
	]
	quest.2480A3EEE69E9027.quest_subtitle: "&7制作武器透镜 (Craft Weapon Lenses)"
	quest.2480A3EEE69E9027.title: "&5&l任务：&r&e精准战斗光学系统"
	quest.24D4C1542F268F97.quest_desc: ["&f每个先进融合系统的中心都有一颗强大的&a融合锻造核心，&f它是负责控制和执行整个融合过程的主要结构。这台机器包含用于管理融合配方的一级接口，让冒险者可以放置将通过龙之力转化的主物品。通过这个接口，还可以监控周围的融合材料，并控制日益复杂的锻造流程的进展。"]
	quest.24D4C1542F268F97.quest_subtitle: "&7Craft the Fusion Crafting Core"
	quest.24D4C1542F268F97.title: "&5&l任务：&r&e融合工程核心"
	quest.24D6C9B1DF37F28B.quest_desc: ["&f开采&a龙晶矿石&f不会直接产出可用金属，而是会产生不稳定的&a龙晶粉尘，&f一种蕴含着巨龙能量的原材料。通过熔炼这种粉尘，冒险者才能最终获得精炼的&a龙晶锭，&f这是&a龙晶工程学中几乎所有前期机器、组件和神器的基础。尽管与后期的创造相比这看似简单，但无数未来技术都始于这种精炼材料。"]
	quest.24D6C9B1DF37F28B.quest_subtitle: "&7熔炼龙晶锭"
	quest.24D6C9B1DF37F28B.title: "&5&l任务：&r&e精炼的龙之力量"
	quest.251717379192A981.quest_desc: [
		""
		""
		"生命值：&2&l100&f&r"
		"生成地点：&6&l主世界的任何地方&f&r"
		""
		"近战伤害：&2&l7&f&r + &4&l击退&f&r"
		"呕吐伤害：&2&l4&f&r + &2&l中毒&f&r"
		"抱摔伤害： &2&l15&f&r"
		""
		"特殊能力："
		"- 总是生成时身边有 &2&l4 只僵尸&f&r。"
		"- Can &6&lcontrol the minds&f&r of spiders, zombies, skeletons and more to fight against you.  "
		"- 生成 &2&l“Biddies”&f&r 从远处追逐目标。"
		"- 死亡时，她会进行一次&4&l抱摔&f&r，造成&4&l范围伤害&f&r。"
		"- 呕吐物会&6&l眩晕&f&r目标，经常误伤自己的仆从。"
		""
		"弱点：被&4&l点燃&f&r时，会受到更高的&c&l物理伤害&f&r。"
	]
	quest.251717379192A981.quest_subtitle: "&l杀死怀有身孕的（真僵尸）"
	quest.251717379192A981.title: "&8&l杀死怀有身孕的母体生物"
	quest.25D14E25D9A8A99A.quest_desc: ["&f在&aDraconic Engineering&f中，首屈一指的必要机器便是强大的&aGenerator，&f一种使用&aDraconium Core&f制造的装置，能够产生维持你不断增长的技术基础设施所需的能量。这台机器为高级系统、融合制造装置、能量晶体和无数龙裔物品提供动力，变得不可或缺。没有稳定的能源，龙裔技术的真正潜力就无法释放。"]
	quest.25D14E25D9A8A99A.quest_subtitle: "&7Craft the Generator"
	quest.25D14E25D9A8A99A.title: "&5&l任务：&r&e龙之能量的诞生"
	quest.25E579FB18D667BC.quest_desc: ["火山源链接通过消耗可燃烧物品（如远古木原木）来生成源。它能产生热量、生成熔岩百合，并将石头转化为熔岩。附近的烈焰远古木也会燃烧以换取源。源链接将输出到附近的罐子中。"]
	quest.25E579FB18D667BC.quest_subtitle: "源与热量生成系统。"
	quest.25F0E1F344B5D502.quest_desc: ["&fAt the final stage of draconic progression stands the legendary &aChaotic Staff of Power, &fthe ultimate fusion of destructive force, utility and chaotic energy. This artifact can be forged either by combining powerful chaotic-tier tools with a &aChaotic Core, &for by upgrading the previous &aDraconic Staff of Power &fthrough advanced fusion using materials such as the &aChaotic Core, Chaotic Energy Core &fand &aDraconic Core. &fThe result is one of the strongest and most versatile artifacts obtainable within all of &aDraconic Engineering."]
	quest.25F0E1F344B5D502.quest_subtitle: "&7Craft the Chaotic Staff of Power"
	quest.25F0E1F344B5D502.title: "&5&l任务：&r&e无限支配之杖"
	quest.26047EE50FCD2373.quest_desc: ["&f随着巨龙科技进入最后阶段，更强大的能源系统变得不可或缺。 &a巨龙能量核心&f是合成高级三级物品和多种强力四级物品所必需的组件。此外，该控制器也是传奇级&a混沌能量核心&f的必需材料，后者是最高级别巨龙融合技术所使用的终极能源组件。"]
	quest.26047EE50FCD2373.quest_subtitle: "&7Craft the Draconic Energy Core"
	quest.26047EE50FCD2373.title: "&5&l任务：&r&e高级龙之能量的掌控者"
	quest.2631074B7F2E134F.quest_desc: ["&f在高级龙裔工程的巅峰，存在着传奇的&a龙裔力量法杖，&f它将多种强大工具融合为一件能力惊人的单一物品。要锻造这件杰作，冒险者必须将&a龙裔之剑、龙裔之镐、龙裔之铲&f和&a龙裔能量核心&f，围绕着一个&a龙裔核心进行高级融合锻造。 &f这根传奇法杖兼具巨大的破坏力与无与伦比的实用性，成为整个&a龙裔工程中最具标志性的创造之一。"]
	quest.2631074B7F2E134F.quest_subtitle: "&7Craft the Draconic Staff of Power"
	quest.2631074B7F2E134F.title: "&5&l任务：&r&e终极力量工具"
	quest.26577F9373D4B48D.quest_desc: [
		"&fAmong all the industrial resources used within &aAlliance of Valiant Arms, &fthe most essential is undoubtedly the powerful &aWork Hardened Iron. &fForged using a combination of &aIron &fand &aCopper, &fthis reinforced alloy serves as the backbone for nearly every weapon, workstation, ammunition type and tactical component found throughout the mod. Because of its constant use in military manufacturing, maintaining large quantities of this material will become absolutely necessary for long-term progression and equipment production."
		"{image:kubejs:textures/images/iron.png width:100 height:55 align:center}"
	]
	quest.26577F9373D4B48D.quest_subtitle: "&7合成硬化铁锭 (Craft Worked Iron Ingot)"
	quest.26577F9373D4B48D.title: "&5&l任务：&r&e工业合金基础工程"
	quest.272D846085C898B6.quest_desc: ["&f&aDraconic Fusion Crafting Injector &f代表了第三阶段的融合技术，能让你接触到更高级的配方、强大的物品和顶级的龙系装备。制作此注射器需要多种极其珍贵的组件，包括&aDraconic Energy Core、Awakened Draconium Ingots &f和先进的&aWyvern Core。 &f有了这一新阶段的融合，&aDraconic Engineering &f的真正力量才开始完全展现。"]
	quest.272D846085C898B6.quest_subtitle: "&7Craft the Draconic Fusion Injector"
	quest.272D846085C898B6.title: "&5&l任务：&r&e高级融合精通"
	quest.27A098F29EA23FDC.quest_desc: ["&f在&a沉没之城&f被淹没的废墟中，隐藏着制造神秘&a深渊祭品&f所需的残骸和材料，这是唤醒深渊下沉睡的远古恐怖所需的仪式物品。要获得其组件，冒险者必须击败守护建筑深处的几种危险&a生物&f。该物品本身可通过&a两种不同的配方&f制作，让你在面对海洋深处未知危险前，能选择最适合自身资源和准备的路线。"]
	quest.27A098F29EA23FDC.quest_subtitle: "&7准备禁忌的祭品"
	quest.27A098F29EA23FDC.title: "&5&l任务：&r&e深渊仪式"
	quest.27FD3E9814B940AC.quest_desc: ["&fAn ancient &c&lknight&r&f, fused with a &e&lheavy door&r&f, stands vigilant before a forgotten chamber. Its &c&lrusted armor&r&f clanks with every step, a menacing warning to all who dare approach its post. You must &c&ldefeat this formidable foe&r&f to pass."]
	quest.27FD3E9814B940AC.quest_subtitle: "&l被职责与腐朽束缚在岗位上的守护者"
	quest.27FD3E9814B940AC.title: "&8&l铁质守卫者"
	quest.28BD631828620D19.quest_subtitle: "&7Craft the Draconic Hoe"
	quest.28BD631828620D19.title: "&5&l任务：&r&e龙之生命的培育者"
	quest.2954B17F713A0C47.quest_desc: ["&f要获得终极力量，你必须打造出&c&l一套完整的噩梦盔甲&r&f。这件传奇装备能让穿戴者获得非凡的能力和无与伦比的强度。收集所有必需材料，锻造这套黑暗盔甲，以证明你已征服了该模组最严峻的挑战。"]
	quest.2954B17F713A0C47.quest_subtitle: "&l与恐惧和黑暗本身合为一体"
	quest.2954B17F713A0C47.title: "&8&l噩梦的拥抱"
	quest.2A00505117DAF97E.quest_desc: ["&f隐藏在深处的&aSoul Black Smith&f中，可怕的&aNetherite Monstrosity&f苏醒，这是一头由远古下界合金与无尽火焰锻造而成的巨兽。战斗中，它会利用周围的&a岩浆&f，将竞技场变成一片致命的火海，让毫无准备的冒险者陷入绝境。请带上强大的装备和某种&a耐热或岩浆防护&f来应对它压倒性的攻击。它的掉落物对未来&a战斗&f和进度至关重要，切勿遗失。"]
	quest.2A00505117DAF97E.quest_subtitle: "&7在炽热的熔岩中生存下来"
	quest.2A00505117DAF97E.title: "&5&l任务：&r&e锻造之心"
	quest.2A7DE7313AE9661A.quest_desc: [
		"&fNot every upgrade is focused purely on combat performance. The &aA.V.A Colouring Table &fallows adventurers to customize the appearance of their firearms with unique colors, finishes and visual styles. To apply weapon customization, players will require various crafting resources such as minerals, dyes and most importantly the valuable &aAcetone Solution, &falongside several additional materials depending on the desired design. Through this system, every weapon can gain its own distinct identity on the battlefield."
		"{image:kubejs:textures/images/colouringtable.png width:100 height:55 align:center}"
	]
	quest.2A7DE7313AE9661A.quest_subtitle: "&7Craft the A.V.A Colouring Table"
	quest.2A7DE7313AE9661A.title: "&5&l任务：&r&e战场之色"
	quest.2C31EA5F04956544.quest_desc: ["源石是一种储存魔力的魔法方块，也是许多法术和法术合成的核心组件。"]
	quest.2C31EA5F04956544.quest_subtitle: "你可以在 Ars 的一些结构中找到它。"
	quest.2C31EA5F04956544.title: "找到源石（Sourcestone）"
	quest.2E1F6AA5B4677249.quest_desc: ["&fAmong the most devastating weapons obtainable from the remains of &aMaledictus &frests the terrifying &aThe Annihilator, &fa colossal weapon built purely for destruction. Its overwhelming power allows skilled adventurers to crush enemies with catastrophic force, turning it into one of the strongest melee weapons available during the final stages of progression."]
	quest.2E1F6AA5B4677249.quest_subtitle: "&7合成湮灭者 (Craft The Annihilator)"
	quest.2E1F6AA5B4677249.title: "&5&l任务：&r&e绝对毁灭之锤"
	quest.2E35FB2A62D51EEC.quest_desc: [
		"&f&o戴上Umvuthana面具，与太阳鸟Umvuthi交易7个金块。"
		"&f&o激活祝福以施放太阳打击或太阳射线。"
	]
	quest.2E35FB2A62D51EEC.quest_subtitle: "&7Trade with Umvuthi, the Sunbird"
	quest.2E35FB2A62D51EEC.title: "&f&l获得太阳的祝福"
	quest.2E9BDD2F6ADBA565.quest_desc: [
		"&f现代武器的真正精通始于&aA.V.A 精通工作台，&f一个专为冒险者设计的特殊站点，可在此为枪械分配永久精通路径。一旦选定精通，便无法更改，因此每个决定都至关重要。每种精通都提供独特的战斗目标和进阶挑战，完成后可提升武器等级，解锁强大的战斗效果，从而增强性能并在战斗中提供更多优势。"
		"{image:kubejs:textures/images/masterytable.png width:100 height:55 align:center}"
	]
	quest.2E9BDD2F6ADBA565.quest_subtitle: "&7Craft the A.V.A Mastery Workbench"
	quest.2E9BDD2F6ADBA565.title: "&5&l任务：&r&e武器精通之路"
	quest.2EBDE8F52179F9BC.quest_desc: ["&fDeep within the blazing lands of the &aNether &flies the feared &aBurning Arena, &fa cursed battleground consumed by endless fire and ancient warriors. To uncover this dangerous place, adventurers must first craft the &aEye of Flame, &fan artifact capable of guiding its bearer toward the arena. Though few enemies roam this structure, each one possesses overwhelming strength capable of turning every encounter into a deadly battle surrounded by fire and destruction."]
	quest.2EBDE8F52179F9BC.quest_subtitle: "&7追随火焰之眼 (Follow the Eye of Flame)"
	quest.2EBDE8F52179F9BC.title: "&5&l任务：&r&e永恒火焰竞技场"
	quest.2EDF4F1D7C44B272.quest_desc: ["这本磨损的笔记本将指导你了解新艺术风格的方方面面。"]
	quest.2EDF4F1D7C44B272.quest_subtitle: "使用一本书和青金石来制作磨损的笔记本。"
	quest.2EDF4F1D7C44B272.title: "&l&c合成磨损的笔记本"
	quest.2EEC11C932E8D6C1.quest_desc: ["&f可怕的诅咒降临了村庄，长老们认为是&c&lNightmare Stalker&r&f所为。这种神秘而可怕的生物栖息在最深邃、最黑暗的洞穴中，以恐惧为食，使大地陷入永恒的黑暗。"]
	quest.2EEC11C932E8D6C1.quest_subtitle: "&l诞生于黑暗与绝望之中的生物"
	quest.2EEC11C932E8D6C1.title: "&8&l深渊的阴影"
	quest.311549BA2132E1E0.quest_desc: ["&fBeyond weapons, armor and fusion systems lies the branch known as &aDraconic Engineering, &ffocused on advanced mechanisms, teleportation technology, energy infrastructure and powerful utility devices. Within this stage, adventurers will gain access to highly sophisticated draconic creations capable of manipulating space, energy and transportation itself. One of the first major utility artifacts available is the &aDislocator, &fa draconic sphere capable of storing a fixed coordinate and instantly teleporting its user back to that location from almost anywhere simply by right-clicking while holding it. To save a destination, sneak and right-click with the artifact in hand. Once the coordinates are recorded, they become permanently bound to the Dislocator and cannot be changed. While incredibly useful for exploration and travel, the artifact possesses limited uses, making each teleport an important decision."]
	quest.311549BA2132E1E0.quest_subtitle: "&7掌握先进的龙族科技"
	quest.311549BA2132E1E0.title: "&5&l任务：&r&e龙之工程学"
	quest.312CBE7A125E7E0E.quest_desc: [
		"&f现代战争需要适应性，而&aA.V.A Modifying Table &f正好提供了这一点。这个专用工作站允许冒险者使用各种战术配件和附件来定制和升级枪械。通过武器改装，玩家可以提升精准度、后坐力控制、稳定性、射速和整体战斗性能等重要指标，使每把武器都能适应不同的战斗情境和个人战斗风格。"
		"{image:kubejs:textures/images/modifytable.png width:100 height:55 align:center}"
	]
	quest.312CBE7A125E7E0E.quest_subtitle: "&7Craft the A.V.A Modifying Table"
	quest.312CBE7A125E7E0E.title: "&5&l任务：&r&e高级武器定制"
	quest.313CF888989232D4.quest_desc: ["&f一具可怕的僵尸拖着背上绑着的&e&l桶&r&f在世间游荡。桶里装着什么不得而知，但它据说是一个&e&l移动的宝库&r&f，正等着勇敢的人来&c&l砸开它&r&f。"]
	quest.313CF888989232D4.quest_subtitle: "&l一座等待开启的移动宝库"
	quest.313CF888989232D4.title: "&8&l桶装僵尸"
	quest.314F7DEACF949649.quest_subtitle: "&7制作龙之斧 (Draconic Axe)"
	quest.314F7DEACF949649.title: "&5&l任务：&r&e灾难之力斧头"
	quest.314FF06E51C01CB8.quest_desc: ["&f无尽海洋的深处，沉睡着重达万钧的&a利维坦，&f一种连&a沉没之城&f的恐怖生物都畏惧的远古巨兽。要唤醒它，你必须使用&a深渊祭品&f完成仪式，在水下展开一场致命之战。利维坦在海洋之外近乎&a无敌，&f因此战斗必须在水下进行，才能发挥其全部威力。准备好呼吸和生存的方法，否则可能在战斗结束前就溺亡。击败这个可怕的Boss，你将获得一件极其珍贵的&a工具，&f在未来的无数次遭遇中都会派上用场。"]
	quest.314FF06E51C01CB8.quest_subtitle: "&7直面沉没深渊的统治者"
	quest.314FF06E51C01CB8.title: "&5&l任务：&r&e深渊之下的恐怖"
	quest.320B80BBB79963B4.quest_desc: ["&fHidden deep within the burning lands of the &aNether &fstands the mysterious &aRuined Citadel, &fa dark fortress corrupted by void energy and forgotten power. To uncover its location, adventurers must craft the &aEye of the Void, &fan artifact capable of guiding its bearer toward the ancient structure. Though the citadel is not filled with endless enemies, the creatures dwelling within are far more &adangerous and valuable. &fPrepare carefully before entering, for the treasures and powers hidden inside will become essential for future progression."]
	quest.320B80BBB79963B4.quest_subtitle: "&7追随虚空之眼 (Follow the Eye of the Void)"
	quest.320B80BBB79963B4.title: "&5&l任务：&r&e空寂火焰的堡垒"
	quest.3215A17FC2256104.quest_desc: ["&fBy combining the resilience of &aObsidian &fwith concentrated draconic energy, adventurers can obtain the powerful &aDraconium Infused Obsidian. &fThis reinforced material becomes essential for crafting advanced draconic devices, high-tier technological structures and several important artifacts required during the later stages of &aDraconic Engineering."]
	quest.3215A17FC2256104.quest_subtitle: "&7获取龙脉浸透黑曜石"
	quest.3215A17FC2256104.title: "&5&l任务：&r&e注入龙火的黑曜石"
	quest.32675C9DDC85047E.quest_desc: ["&f&c&l精神威胁&r&f出现了，一个强大的&b&l迷你首领&r&f，在第十天后生成。小心他召唤&c&lEvocation Fangs&r&f的魔法投射物，以及召唤不死盟友的能力。他还能用强力一击使你眩晕，做好准备闪避！你的目标是&c&l击败这个狂信徒&r&f，阻止他的十字军东征。"]
	quest.32675C9DDC85047E.quest_subtitle: "&l来自彼岸的强大精神威胁"
	quest.32675C9DDC85047E.title: "&8&l传教士的任务书"
	quest.32916E1AE400AFA2.quest_desc: [
		"&f&o找到一个漂浮的灯笼并将其击败。"
		"&f&o收集发光水母以获得暂时的夜视能力。"
	]
	quest.32916E1AE400AFA2.quest_subtitle: "&7采集发光水母"
	quest.32916E1AE400AFA2.title: "&f&l灯笼狩猎"
	quest.32F4D1719C5EAD72.quest_subtitle: "&7制作威龙镐头"
	quest.32F4D1719C5EAD72.title: "&5&l任务：&r&e深地之牙"
	quest.338C7716D39BE2EC.quest_desc: ["&fTo begin mastering advanced equipment customization, adventurers must first craft the essential &aModule Core, &fa component required for creating nearly every module within &aDraconic Engineering. &fModules are powerful upgrades that can be installed into draconic artifacts, tools and armor to provide a wide variety of abilities and enhancements. Some modules increase &aprotection, damage, speed, power, jump height &for even grant utilities such as &anight vision &fand automatic feeding among many others. Modules exist in several progression tiers, beginning with the standard early-game variants crafted using &aDraconium Ingots, Draconium Cores &fand &aModule Cores. &fBeyond these lie the more advanced &aWyvern, Draconic &fand finally &aChaos-tier &fmodules. In most cases, crafting higher-tier modules requires combining and upgrading modules from previous tiers."]
	quest.338C7716D39BE2EC.quest_subtitle: "&7Craft the Module Core"
	quest.338C7716D39BE2EC.title: "&5&l任务：&r&e模块化电源的基础知识"
	quest.33D2016466FA6F09.quest_subtitle: "&7Craft the Chaotic Chestpiece"
	quest.33D2016466FA6F09.title: "&5&l任务：&r&e混沌之子的铠甲"
	quest.342F879E25BB59AD.quest_desc: [
		""
		"生成：主世界 Y≥78 处&6&l 或雪地生物群系中&f&r&6&l&f&r"
		"近战: &2&l7&f&r"
		""
		"特殊能力："
		"- 生成时会带着一群&6&l猎人&f&r，他们&2&l为他效力&f&r并保护他。"
		"- 没有猎人的他，基本上就是个&7&l换了皮的外壳&f&r，所以你可以&6&l毫无怜悯地欺负他&f&r。"
		"- 有一定几率掉落&d&lBrisk Attacker&f&r，一件&6&l传奇武器&f&r。"
		"- 他&4&l憎恶掠夺者&f&r，一见到他们就会&6&l与他们为敌&f&r。"
		""
		"敏捷攻击者："
		"- 右击&e&l会召唤出一个&f&r&c&l极其强大的球体&f&r，它能&6&l推开路径上的一切&f&r。"
		"- 缺点：你还会被这个球体&c&l击退&f&r。"
		""
		"注意事项："
		"- 他可以掉落&2&l大量矿石&f&r，甚至还能掉落&d&l不死图腾&f&r。"
		""
		"提示："
		"- 尽管他几乎&8&l免疫物理伤害&f&r，但你可以通过&6&l元素伤害&f&r来&3&l无视他的护甲&f&r。"
	]
	quest.342F879E25BB59AD.quest_subtitle: "&l击杀皇家（维京人）"
	quest.342F879E25BB59AD.title: "&8&l击杀王者生物"
	quest.3449545667B6492F.quest_desc: ["&f守护着&a卫城&f最坚固区域的，是强大的&a爪兽，&f一种身披重甲、近战能造成毁灭性伤害的海洋生物。虽然只有少数几只游荡在建筑中，击败至少&a两只&f爪兽极具价值，因为它们稀有的掉落物可用于制作独特的&a武器&f，对某些战斗风格和策略大有裨益。"]
	quest.3449545667B6492F.quest_subtitle: "&7击败爪迪安人 (Clawdians)"
	quest.3449545667B6492F.title: "&5&l任务：&r&e风暴之爪"
	quest.34554509579CB0C3.quest_subtitle: "&7Craft the Chaotic Shovel"
	quest.34554509579CB0C3.title: "&5&l任务：&r&e混沌挖掘机"
	quest.34D22214AAA28CB7.quest_desc: [
		"&fEvery explosive device requires a reliable ignition system, and the &aFuse &fserves exactly that purpose within &aAlliance of Valiant Arms. &fThis important component is used in the crafting of grenades, tactical explosives and various other destructive devices. Though small and simple in appearance, fuses are essential for controlling detonation systems and enabling safe explosive deployment during combat situations."
		"{image:kubejs:textures/images/fuse.png width:100 height:55 align:center}"
	]
	quest.34D22214AAA28CB7.quest_subtitle: "&7制作引信"
	quest.34D22214AAA28CB7.title: "&5&l任务：&r&e点火装置"
	quest.36519ED7641B7719.quest_desc: ["&f军事后勤的巅峰，当属强大的&a弹药包供应商，&f一种可部署的弹药站，能为附近的枪械自动提供兼容的弹匣。放置后，冒险者只需手持武器靠近供应商，即可立即获得相应的弹药弹匣。但该装置为永久性战术部署，破坏供应商将导致整个站点永久消失。"]
	quest.36519ED7641B7719.quest_subtitle: "&7Place the Ammo Kit Supplier"
	quest.36519ED7641B7719.title: "&5&l任务：&r&e自动化农田补给"
	quest.36CE4B74EB26DA0B.quest_desc: ["&f利用从&a诅咒金字塔中隐藏的危机里收集到的残骸，&f冒险者可以锻造出强大的&a骨爬行动物盔甲，&f一套由远古骨骼和遗忘金属制成的耐用装备。制作此装备需要来自&a哥布林、哥布林终结者&f及其他守墓者等生物获得的珍贵材料，包括稀有的&a古代金属锭。&f这套盔甲能抵御未来Boss的强力攻击，是迈向生存日益危险遭遇的重要一步。"]
	quest.36CE4B74EB26DA0B.quest_subtitle: "&7合成骨制爬行动物盔甲"
	quest.36CE4B74EB26DA0B.title: "&5&l任务：&r&e用远古骨骼锻造的盔甲"
	quest.373F39B5728EABF5.quest_desc: [
		"&f&o面对拥有独特AI和战利品的新首领与生物。"
		"&f&o这只是用于开启任务链的勾选框。"
	]
	quest.373F39B5728EABF5.quest_subtitle: "&7勾选框以开始冒险"
	quest.373F39B5728EABF5.title: "&c&l欢迎来到 Mowzie’s Mobs 模组世界"
	quest.37462DD4D6BE9E9B.quest_desc: [
		""
		"生命值：&2&l15&f&r"
		"生成位置：地面以上 &6&l78+ 格&f&r"
		"攻击：&2&l5&f&r"
		""
		"特殊能力："
		"它们看起来又弱又软，但它们能&c&l飞快地杀死你&f&r，方法是&6&l向你猛冲而来&f&r，一旦它们冲过来，你就无法&8&l将其击退&f&r了。"
		""
		"有小概率会有一只 &2&lBidy/幼年僵尸&f&r 骑在它们身上。"
		""
		"掉落物："
		"&2&lMembranes&f&r that can be cooked to gain &2&lregeneration&f&r."
		""
		"提示："
		"如果被咬住或锁定了，试着走回&6&l低处&f&r，因为它们冲刺时无法控制自己的&6&l俯冲角度&f&r。"
		""
		"如果能听到它们的&e&l声音&f&r却看不到它们，试试&6&l抬头看看&f&r。"
	]
	quest.37462DD4D6BE9E9B.quest_subtitle: "&l杀死傻瓜（恶魔不死生物）"
	quest.37462DD4D6BE9E9B.title: "&8&l杀死那个傻瓜"
	quest.38BE797210F6A20D.quest_desc: ["&f在被打败的&a下界合金巨兽&f的残骸中，诞生了传奇的&a地狱熔炉，&f一件蕴含着毁灭力量的巨型武器。使用&a右键&f敲击实心方块时，这把锤子会释放出毁灭性的&a范围攻击，&f能够以爆炸之力粉碎附近的敌人。除了战斗，这件武器也是一把强大的&a稿子，&f能让使用者轻松击破岩石和矿石。很少有工具能像这件地狱遗物一样，将破坏与实用结合得如此完美。"]
	quest.38BE797210F6A20D.quest_subtitle: "&7挥舞远古熔炉的力量"
	quest.38BE797210F6A20D.title: "&5&l任务：&r&e在炼狱烈焰中锻造"
	quest.38FB256A5BCE58E8.quest_desc: ["&f在最高级的龙族融合中，存在着传奇的&a混沌核心，&f这是一种通过不稳定能量锻造而成的强大组件，需要&a大型混沌碎片、龙族核心&f和&a觉醒的龙晶锭。 &f该材料是高级混沌级制造最重要的资源之一，能解锁所有&a龙族工程学中最强大的物品和科技造物。"]
	quest.38FB256A5BCE58E8.quest_subtitle: "&7Craft the Chaotic Core"
	quest.38FB256A5BCE58E8.title: "&5&l任务：&r&e由绝对混沌锻造的核心"
	quest.3915E159155F8F9E.quest_desc: ["&f迅捷而无情，&c&l绯红追猎者&r&f在阴影中穷追不舍。它的猩红双眼燃烧着恶意，一举一动都彰显着唯一的目的：折磨与毁灭。你必须直面这个&c&l无情存在&r&f，终结它的&c&l恐怖统治&r&f。"]
	quest.3915E159155F8F9E.quest_subtitle: "&l被永恒的恶意所束缚的无情猎人"
	quest.3915E159155F8F9E.title: "&8&l绯红迫害者"
	quest.39CD51F00CC01388.quest_desc: ["&f一种新的恐怖生物从扭曲森林和末地的深处出现。经典的生物——&c&l幻影苦力怕&r&f，是一种幽灵般的变种，出没于扭曲的菌类和藤蔓，以及末地岛屿之间的虚空，并以&c&l无声的速度&r&f发起攻击。它的&c&l变异身体&r&f使其难以被发现，而它的&c&l爆炸威力&r&f甚至比主世界的同类更惊人。你必须找到并消灭这个幽灵般的威胁。"]
	quest.39CD51F00CC01388.quest_subtitle: "&l来自维度之外的恐怖幽灵"
	quest.39CD51F00CC01388.title: "&8&l幻影苦力怕"
	quest.39EE5334A546BF3A.quest_desc: [
		"&fThis mod adds a lot of aggressive mobs, with their unique properties that can diversify and complicate your survival. Also adds new structures, equipment, blocks and achievements."
		""
		"{image:kubejs:block/borninchaosimage width:100 height:100 align:center}"
	]
	quest.39EE5334A546BF3A.quest_subtitle: "&l一个充满混乱和危险生物的模组"
	quest.39EE5334A546BF3A.title: "&l&6欢迎来到混沌初生 (Born in Chaos)</c2></c1>"
	quest.3B268BEA794FAF4D.quest_desc: ["&fFor advanced demolition and tactical destruction, adventurers gain access to the powerful &aC4 Explosive Charge. &fThis device can be planted on nearly any surface by holding left click, after which an active countdown sequence will begin before detonation. Once the timer reaches zero, the explosive will detonate with devastating force, making it highly effective for breaching structures, clearing hostile zones and setting battlefield traps. However, active charges can still be safely neutralized using a compatible &aC4 Controller &fbefore detonation occurs."]
	quest.3B268BEA794FAF4D.quest_subtitle: "&7部署C4炸药包"
	quest.3B268BEA794FAF4D.title: "&5&l任务：&r&e受控爆破炸药包"
	quest.3B59B352CA5AD92A.quest_desc: ["&f在&a废墟堡垒&f的殿堂中，矗立着两个古老的&a末影傀儡，&f它们是注入了不稳定虚空能量的巨大守护者。击败这些强大的构造体，冒险者将获得稀有的&a虚空核心，&f一种神秘的材质，可用于强化模组中一些最强大的武器。然而，这些升级无法立即进行，必须先获得特殊的&a铁砧，&f才能释放它们的真正潜力。"]
	quest.3B59B352CA5AD92A.quest_subtitle: "&7击败末影傀儡 (Ender Golems)"
	quest.3B59B352CA5AD92A.title: "&5&l任务：&r&e被遗忘的虚空核心"
	quest.3B7814A126F44463.quest_desc: ["&f在&aBurning Arena &f中隐藏的众多宝藏里，有稀有的&aIgnitium Upgrade，&f一种能将普通&aNetherite Armor &f变为更强大的&aIgnitium Armor的强大锻造模板。 &f此升级被视为生存的关键，尤其是对抗世界最强首领的最终决战。"]
	quest.3B7814A126F44463.quest_subtitle: "&7Craft the Ignitium Upgrade"
	quest.3B7814A126F44463.title: "&5&l任务：&r&e燃烧的熔炉的秘密"
	quest.3BE83E1EC9568033.quest_desc: [
		"&fTo perform a successful &aFusion Crafting &fprocess, all required materials must be placed directly onto the front face of the surrounding &aCrafting Injectors &fusing right click. Materials can also be removed at any time if mistakes are made during setup. The position or order of the ingredients does not matter, as long as every required component for the recipe is correctly placed within the fusion structure."
		"{image:kubejs:textures/images/ingredientes.png width:120 height:80 align:center}"
	]
	quest.3BE83E1EC9568033.quest_subtitle: "&7了解注射器系统的工作原理"
	quest.3BE83E1EC9568033.title: "&5&l任务：&r&e融合放置规则"
	quest.3BEFFAAE5A155074.quest_desc: ["&fUsing the forbidden power of the &aCursium Upgrade &fand materials obtained from the frozen horrors of the &aFrosted Prison, &fadventurers can forge the legendary &aCursium Armor. &fThis powerful cursed set grants exceptional protection alongside unique abilities that greatly improve survivability during the deadliest encounters. Among its greatest powers lies the ability to cheat death itself, making the armor invaluable against catastrophic battles."]
	quest.3BEFFAAE5A155074.quest_subtitle: "&7制作诅咒之甲 (Cursium Armor)"
	quest.3BEFFAAE5A155074.title: "&5&l任务：&r&e永恒诅咒的盔甲"
	quest.3D62686038D6707B.quest_desc: ["&fHidden within the frozen lands of the snowy &abiomes &flies the terrifying &aFrosted Prison, &fan ancient cursed fortress consumed by ice, death and forgotten souls. To locate this final structure, adventurers must first craft the &aEye of Curse, &fan artifact capable of guiding its bearer toward the frozen ruins. The prison is heavily guarded by countless &aDraugr, &fturning every corridor into a brutal battle for survival as you approach the final horror waiting deep within the structure."]
	quest.3D62686038D6707B.quest_subtitle: "&7追随诅咒之眼 (Follow the Eye of Curse)"
	quest.3D62686038D6707B.title: "&5&l任务：&r&e无尽寒冬下的囚笼"
	quest.3D855F9C60245E7C.quest_desc: ["在动荡的&a混沌群岛&f中心，可怕的&a混沌守护者&f正等待着冒险者，&f这是一头力量远超传奇末影龙的灾难性巨龙。没有充分准备就与它对抗近乎自杀，其攻击能瞬间摧毁疏忽的冒险者。这场战斗与末影龙有相似之处，但保护它的&a混沌水晶&f无法被普通手段摧毁。要打破它们，冒险者必须使用特殊的&a混沌神器&f，或将巨龙引诱至水晶上。击败后，混沌守护者会奖励珍贵的&a龙之心脏&f，而在竞技场深处，地面涌出暴力能量束的地方，可以找到大量传奇的&a混沌碎片&f。"]
	quest.3D855F9C60245E7C.quest_subtitle: "&7击败混沌守护者"
	quest.3D855F9C60245E7C.title: "&5&l任务：&r&e毁灭之外的巨龙"
	quest.3E4D2D643ABB8E16.quest_subtitle: "&7制作龙之镐 (Draconic Pickaxe)"
	quest.3E4D2D643ABB8E16.title: "&5&l任务：&r&e无尽深渊的收割者"
	quest.3E664991DE02A516.quest_desc: ["&f一具高大的骷髅，骨骼由暗铁加固，迈着令人畏惧的步伐在世间游荡。它挥舞着一把巨大的双手斧，每一次挥舞都展现出令人胆寒的原始力量。你必须直面这位&c&l不死生物的无情守护者&r&f，终结它的肆虐。"]
	quest.3E664991DE02A516.quest_subtitle: "&l由骨骼与铁铸成的巍峨守护者"
	quest.3E664991DE02A516.title: "&8&l骷髅粉碎者"
	quest.3F761784850950C0.quest_subtitle: "&7Craft the Chaotic Axe"
	quest.3F761784850950C0.title: "&5&l任务：&r&e灾难性毁灭之斧"
	quest.3FE077679A9A936F.quest_desc: ["&f通过将&a龙之心脏&f的磅礴力量进行高级融合，普通的&a龙之合金块&f可被转化为传奇的&a觉醒龙之合金块。 &f这种材料蕴含着更强大的龙之能量，是高级进阶的重要资源。冒险者可从这些方块中获得&a觉醒龙之合金锭，&f这是制造强大二、三级科技（包括高级&a龙之核心）所必需的材料。"]
	quest.3FE077679A9A936F.quest_subtitle: "&7Craft the Awakened Draconium Block"
	quest.3FE077679A9A936F.title: "&5&l任务：&r&e在龙焰中觉醒"
	quest.3FF81E18D15F148A.quest_subtitle: "&7Craft the Enchanter's Wand."
	quest.3FF81E18D15F148A.title: "&f&l附魔师的魔杖"
	quest.40742F1DF886A605.quest_desc: ["&f随着&a龙之能量核心&f的诞生，通往禁忌领域&a混沌&f的道路终于开启。遥远的末地岛屿之外，是不稳定的混沌维度，充满了压倒性的龙之能量和难以想象的毁灭。从今以后，只有装备了先进龙之技术的最强冒险者，才有希望在混沌岛屿中幸存下来。"]
	quest.40742F1DF886A605.quest_subtitle: "&7进入龙之力量的最终阶段"
	quest.40742F1DF886A605.title: "&5&l任务：&r&e混沌苏醒"
	quest.409EA38BB8434B63.quest_desc: ["&f在&a燃烧竞技场&f的中心，传奇的&a伊格尼斯&f正等着你。他是一位被无可阻挡的火焰和压倒性的力量所赋予的毁灭性战士。在这场战斗中保持静止是致命的错误，因为伊格尼斯会无情地用能迅速终结战斗的残酷攻击来压迫冒险者。虽然他的一些掉落物乍看之下可能并不出众，但从这个首领处获得的稀有&a伊格尼修姆锭&f对于制作高级装备极为珍贵。如果你想收集足够的材料来制作未来的传奇装备，可能需要多次击败伊格尼斯。"]
	quest.409EA38BB8434B63.quest_subtitle: "&7击败伊格尼斯 (Ignis)"
	quest.409EA38BB8434B63.title: "&5&l任务：&r&e永不熄灭的火焰"
	quest.413135F6D3B6B6DC.quest_desc: ["&fDeep within the heart of the &aCursed Pyramid &fsleeps the terrifying &aAncient Remnant, &fan ancient ruler awakened through the power of the &aNecklace of the Desert. &fFrom this point onward, the challenges ahead become far more dangerous, as bosses begin using increasingly complex &amechanics &fthat can drastically change the flow of battle. Careless adventurers may quickly find themselves overwhelmed by the creature's devastating attacks. Those capable of defeating the Ancient Remnant may earn a rare reward: a unique &apet &fthat can later be domesticated using bones gathered from creatures within the dungeon."]
	quest.413135F6D3B6B6DC.quest_subtitle: "&7击败远古残骸（Ancient Remnant）"
	quest.413135F6D3B6B6DC.title: "&5&l任务：&r&e沙丘下的国王"
	quest.42409AB6DFD5573B.quest_desc: ["&f在诅咒的密室中，与&a远古遗骸&f的安息之所相邻，危险的&a瓦杰特&f正沉睡于此。若放任其存活，这位强大的守护者能将一场本就致命的战斗彻底引向混乱。强烈建议在唤醒金字塔的真正统治者前击败这位副首领。它的掉落物对于锻造更强大的盔甲也极为珍贵，尤其是像&a远古金属锭&f这样用于高级装备的材料。"]
	quest.42409AB6DFD5573B.quest_subtitle: "&7击败瓦杰特 (Wadjet)"
	quest.42409AB6DFD5573B.title: "&5&l任务：&r&e沉睡古墓的守护者"
	quest.42B39EA1DCB20B63.quest_desc: ["&f&a远古工厂&f的各处走廊都散布着名为&a观察者&f的危险监视构造体。虽然它们并非结构内最强的敌人，但其持续不断的攻击和压倒性优势使其在探索期间构成持续威胁。击败至少&a五个&f这种机械生物，有助于在直面工厂深处恐怖之物前，确保周边区域的安全。"]
	quest.42B39EA1DCB20B63.quest_subtitle: "&7击败守望者 (Defeat The Watchers)"
	quest.42B39EA1DCB20B63.title: "&5&l任务：&r&e机械之眼</c4></c3></c2>"
	quest.433F4124E447AC67.quest_desc: ["&f利用蕴含在&a觉醒的德拉科尼ウム中的巨大能量锻造而成，&f传奇的&a德拉科尼核心&f代表了在真正终局科技前能获得的最高阶德拉科尼组件之一。这个强大的核心是制作高级高价值模块、强力装备升级以及建造第三和第四阶融合制造系统所必需的。随着进程进入最后阶段，德拉科尼核心成为&a德拉科尼工程学中几乎所有终局创造物不可或缺的材料。"]
	quest.433F4124E447AC67.quest_subtitle: "&7合成龙之核心 (Draconic Core)"
	quest.433F4124E447AC67.title: "&5&l任务：&r&e绝对龙之力的核心"
	quest.442BD0BB5FB07B88.quest_desc: ["&f在被打败的&a末地守卫&f留下的奖励中，有强大的&a守护者手套，&f一种融合了虚空与重力之力的武器。激活后，手套能将附近的&a生物&f拉向你，扰乱敌人行动，在战斗中创造绝佳机会。尽管乍看之下可能并不具有压倒性的破坏力，但技艺高超的冒险者可以将这件神器用作高度&a战术性的工具，&f以控制危险的遭遇，并操纵战场为己方谋利。"]
	quest.442BD0BB5FB07B88.quest_subtitle: "&7夺取重力的力量吧"
	quest.442BD0BB5FB07B88.title: "&5&l任务：&r&e坍缩虚空之手"
	quest.447E235880BD83C8.quest_desc: ["&fCreated from the &aBasic Energy Relay Crystal, &fthe &aBasic Energy I/O Crystals &fserve as essential components for building stable draconic energy networks. These crystals allow energy to flow between generators, relay systems and machines requiring power. Depending on their configuration, they can function either as &aOutput &fcrystals, absorbing energy from generators, or as &aInput &fcrystals, transferring stored energy into connected components and devices."]
	quest.447E235880BD83C8.quest_subtitle: "&7Craft the Basic Energy I/O Crystals"
	quest.447E235880BD83C8.title: "&5&l任务：&r&e可控能量的流动"
	quest.45E5235FCCF252AF.quest_desc: ["&f随着龙裔科技的不断发展，更先进的融合工艺应运而生。 &a威龙融合合成注射器 &f是二阶融合合成的核心组件，能让你获得更强大的工具、机器和技术部件。合成该注射器需要强大的 &a威龙核心 &f和多种高级材料，这标志着你在 &a龙裔工程学 中迈出了重要的一步。"]
	quest.45E5235FCCF252AF.quest_subtitle: "&7Craft the Wyvern Fusion Injector"
	quest.45E5235FCCF252AF.title: "&5&l任务：&r&e超越基础融合的升华"
	quest.46F41C128CB48E1A.quest_desc: [
		"&f&o在繁茂生物群系中找到一只Foliaath并将其击败。"
		"&f&o尝试从其掉落物中获得一粒 Foliaath 种子。"
	]
	quest.46F41C128CB48E1A.quest_subtitle: "&7丛林中的食肉植物"
	quest.46F41C128CB48E1A.title: "&f&l狩猎福利亚斯（Foliaath）"
	quest.472F00A70A716246.quest_subtitle: "&7制作混沌镐 (Craft the Chaotic Pickaxe)"
	quest.472F00A70A716246.title: "&5&l任务：&r&e世界的破坏者"
	quest.4752E98FA4F001CB.quest_desc: ["&f由被击败的&aHarbinger的残骸锻造而成，&f&aWither Assault Shoulder Weapon&f是一种极具破坏力的远程武器，能从远处向敌人发射爆炸性火箭弹。每次射击在撞击时都会剧烈爆炸，使其对成群敌人和危险首领都极为有效。尽管威力强大，但其爆炸力也要求玩家在战斗中谨慎瞄准和定位，以避免不必要的危险。"]
	quest.4752E98FA4F001CB.quest_subtitle: "&7获得凋零突击肩甲武器"
	quest.4752E98FA4F001CB.title: "&5&l任务：&r&e肩扛式毁灭炮"
	quest.4763E0B584C7E7E7.quest_desc: ["&f在击败&a利维坦&f后获得的宝藏中，有强大的&a潮汐之爪，&f一种能大幅提升战斗和探索机动性的独特工具。这些神秘的爪子可用作&a钩爪，&f根据使用方式，可将你拉向远处的表面或弹离危险。其效果取决于距离和恰当的时机，因此了解它们的&a射程&f是掌握它们的关键。在战斗中，潮汐之爪提供了惊人的敏捷性，让技艺高超的冒险者能够躲避那些本应致命的毁灭性攻击。"]
	quest.4763E0B584C7E7E7.quest_subtitle: "&7掌握深渊中的移动技巧"
	quest.4763E0B584C7E7E7.title: "&5&l任务：&r&e潮汐之爪"
	quest.47C1F842E9339F31.quest_desc: [
		"&f&o在Y=25以下找到一个四处爬行的Grottol并将其捕获。"
		"&f&o使用丝绸之触挖掘以获得被捕获的格罗托尔。"
	]
	quest.47C1F842E9339F31.quest_subtitle: "&7深埋地下的活矿石"
	quest.47C1F842E9339F31.title: "&f&l抓住格罗托尔 (Grottol)"
	quest.48A79DA634AF47C7.quest_desc: [
		""
		"生命值：&2&l25&f&r"
		"生成地点：&6&l深海区域&f&r"
		"近战：&6&l召唤狂犬&f&r"
		"速度：&8&l久坐型&f&r"
		""
		"特殊能力："
		"- 在目标头上召唤一只&7&l被囚禁的 Rabidus&f&r，将其变为&c&l宿主&f&r。"
		"- 被攻击或攻击后，它会&6&l合上棺材&f&r以&2&l恢复力量&f&r。"
		"- 它的 &7&l棺材&f&r 能抵御任何 &8&l物理攻击&f&r。"
		""
		"提示："
		"- 生物 &c&l无法攻击&f&r，当它的棺材是 &7&l关闭的&f&r。"
		"- 制作一个&7&l笼子&f&r并让它掉在生物头上会&4&l立即杀死它&f&r。"
	]
	quest.48A79DA634AF47C7.quest_subtitle: "&l杀死占有欲（掠夺者构造体）"
	quest.48A79DA634AF47C7.title: "&8&l杀死占有欲强的生物"
	quest.48F46166A6AE8A29.quest_desc: ["&f在&a废弃堡垒&f的中心，可怕的&a末地守卫&f正等待着你，它是被虚空之力赋予力量的远古守护者。虽然它的攻击看似缓慢，但这种生物拥有毁灭性的力量，能在几秒钟内困住并压倒不谨慎的冒险者。如果没有合适的&a工具和准备就面对这个首领&f，很快就会招致灾难。要想在战斗中幸存，就要保持移动，保持警惕，避免被它的碾压攻击所困住。"]
	quest.48F46166A6AE8A29.quest_subtitle: "&7击败末地守卫者（Ender Guardian）"
	quest.48F46166A6AE8A29.title: "&5&l任务：&r&e废墟王座的守望者"
	quest.49355A7EC257C5CB.quest_desc: ["从附近的食物中生成源，源浆果食物提供的源更多。菌丝源连接器能将草或泥土转化为菌丝，并在空间为空时生长蘑菇。它还能从附近的基座上吸取物品。"]
	quest.49355A7EC257C5CB.quest_subtitle: "来源：食物与生长（Food and Growth）。"
	quest.4971F28E56F801A8.quest_desc: [
		"&f融合合成需要消耗大量&a能量&f才能正常工作。要开始融合过程，&a融合合成核心&f和连接的注入器必须通过发电机、能量晶体和相连的龙能量网络获得足够的电力。没有适当的能量管理，最简单的融合配方也无法生效。请参考示例图片了解一个供电充足的融合装置。"
		"{image:kubejs:textures/images/fusionenergy.png width:120 height:80 align:center}"
	]
	quest.4971F28E56F801A8.quest_subtitle: "&7为聚变系统提供能量"
	quest.4971F28E56F801A8.title: "&5&l任务：&r&e为融合核心提供能量"
	quest.4BDF46CB9D09270A.quest_desc: ["&f由&aMaledictus的诅咒残骸锻造而成，&f传奇的&aCursed Bow &f是一种可怕的远程武器，能对远处的敌人发动毁灭性攻击。注入了黑暗能量和巨大破坏力的这把武器，反映了&aFrosted Prison &f统治者本人曾使用的致命战斗风格。"]
	quest.4BDF46CB9D09270A.quest_subtitle: "&7制作被诅咒的弓"
	quest.4BDF46CB9D09270A.title: "&5&l任务：&r&e被诅咒之王的弓"
	quest.4BF8EDE4DD0A5725.quest_desc: ["&f借助&aDraconium Core中的力量，&f冒险者可以制作出先进的&aWyvern Energy Core，&f这是中阶龙族科技中至关重要的组件。这种强大的能量控制器是二阶融合制作、高级能量晶体和未来高级能量系统的必需部件。此外，它还为后期制作更强大的控制器奠定了基础。"]
	quest.4BF8EDE4DD0A5725.quest_subtitle: "&7Craft the Wyvern Energy Core"
	quest.4BF8EDE4DD0A5725.title: "&5&l任务：&r&e流动能量的掌控者"
	quest.4CAB68CAF6E2D445.quest_desc: ["&f你听说过下界的一些生物会掉落一种特殊的尘埃。它会发出微光，象征着它与那里燃烧的火焰之间的联系。要获得这种&c&l发光尘埃&r&f，你必须深入这个火焰维度，击败这些火焰生物。"]
	quest.4CAB68CAF6E2D445.quest_subtitle: "&l来自火焰领域的缥缈馈赠"
	quest.4CAB68CAF6E2D445.title: "&8&l火焰之光"
	quest.4E7891406F9E319F.quest_subtitle: "&7Craft the Wyvern Chestpiece"
	quest.4E7891406F9E319F.title: "&5&l任务：&r&e威龙的护心者"
	quest.50EB2B74D14391F4.quest_desc: [
		""
		"生命值：&2&l80&f&r"
		"生成地点：&6&l洞穴中&f&r"
		"特殊：地下生成的&6&l大型变种&f&r，拥有更高的&2&l生命值&f&r和更好的&2&l掉落物&f&r。"
		""
		"注意："
		"它们通常以&6&l巨大群居的形式&f&r出现，伴随着&c&l震耳欲聋的拍打声&f&r。"
		"在大多数情况下，&e&l回避&f&r是更优的选择。"
	]
	quest.50EB2B74D14391F4.quest_subtitle: "&l杀死更大的混蛋 (Kill The Bigger Suck)</c1>"
	quest.50EB2B74D14391F4.title: "&8&l杀死更大的混蛋 (Kill The Bigger Suck)</c2></c1>"
	quest.5157AD63A444E1A5.quest_desc: ["此模组添加了凶猛的亡灵生物，让Minecraft充满挑战。新敌人相当可怕，有时逃跑比战斗更明智，但每种僵尸都有隐藏的&2&l弱点&f&r，可以利用它们轻松击败。"]
	quest.5157AD63A444E1A5.quest_subtitle: "&l欢迎来到 The Undead Revamped Mod 模组"
	quest.5157AD63A444E1A5.title: "&c&l欢迎来到 The Undead Revamped 模组世界"
	quest.529F6326ACDBCBC5.quest_desc: ["&f世界各地散落着被遗忘的&a建筑、&f古代遗迹和致命地牢，隐藏着难以想象的&a力量。 &f其中沉睡的巨型首领足以摧毁毫无准备的冒险者。 &f要揭开这些地方，必须先制作特殊的&a眼睛，&f每只眼睛都会引导持有者前往特定的地牢或古代领域。 &f请仔细准备装备，因为前方的挑战标志着一场真正的&a大灾难的开始。"]
	quest.529F6326ACDBCBC5.quest_subtitle: "&7直面世界的远古恐怖生物"
	quest.529F6326ACDBCBC5.title: "&5&l任务：&r&e大灾变崛起"
	quest.5367ED72A1BF23F3.quest_desc: ["&f在&a卫城&f的淹没小径中，潜伏着好斗的&aUrchinkins，&f这种小型生物成群结队时会危及疏忽大意的冒险者。尽管单个很弱，击败至少&a五只&f将有助于在深入风暴废墟前，确保建筑外围的安全。"]
	quest.5367ED72A1BF23F3.quest_subtitle: "&7击败乌奇金人 (Urchinkins)"
	quest.5367ED72A1BF23F3.title: "&5&l任务：&r&e浪下尖刺"
	quest.53C837D4FD70CD4B.quest_desc: [
		"&f&o找到一个锻造密室，唤醒铁质锻造者。"
		"&f&o击败它，即可获得千金属之斧和锻造头盔。"
	]
	quest.53C837D4FD70CD4B.quest_subtitle: "&7唤醒密室中的钢铁巨像"
	quest.53C837D4FD70CD4B.title: "&f&l挑战锻铁航海家 (Ferrous Wroughtnaut)"
	quest.5433D5692AEEAA44.quest_subtitle: "&7Craft the Chaotic Hoe"
	quest.5433D5692AEEAA44.title: "&5&l任务：&r&e废墟的耕耘者"
	quest.54467A18A3F1038F.quest_desc: ["&f一位大师级铁匠正在寻找传说中的&c&l暗金属&r&f，这是一种仅在世界上最深邃、最腐化的地方才能找到的强大材料。据说它是混沌的本质，你必须勇敢面对黑暗，为他获取它。"]
	quest.54467A18A3F1038F.quest_subtitle: "&l在黑暗中锻造的传奇材料"
	quest.54467A18A3F1038F.title: "&8&l暗影锻造炉"
	quest.548BA76AC8601444.quest_desc: ["这是一个壁炉，可用于装饰或在上面举行仪式，请仔细观察法术的颜色。"]
	quest.548BA76AC8601444.quest_subtitle: "是用来装饰的还是用于仪式的？."
	quest.54C5D5FB6DB6C751.quest_desc: ["&f战场态势感知往往能在第一枪打响前就决定战斗的胜负。 &a双筒望远镜 &f能让冒险者观察到远处区域，识别出远超正常视觉范围的威胁、建筑或动向。除了侦察，这种战术光学仪器还能用来&a标记远处目标，&f使其在协调作战和远程战场感知中极具价值，尤其是在 &aAlliance of Valiant Arms 中。"]
	quest.54C5D5FB6DB6C751.quest_subtitle: "&7制作双筒望远镜"
	quest.54C5D5FB6DB6C751.title: "&5&l任务：&r&e战场上的瞭望者"
	quest.55165252DF9D37CD.quest_desc: [
		"&f许多先进的军事设备和枪械组件都需要可靠的机械系统才能正常工作。 &a弹簧 &f是 &aAlliance of Valiant Arms 中使用的最基本工业部件之一， &f是制造更复杂材料（如 &a引信 &f和 &a机械组件）的核心原料。 &f尽管外观简单，但这种小部件对于生产更先进的武器和战术装备至关重要。"
		"{image:kubejs:textures/images/spring.png width:100 height:55 align:center}"
	]
	quest.55165252DF9D37CD.quest_subtitle: "&7制作弹簧 (Craft Springs)</c1>"
	quest.55165252DF9D37CD.title: "&5&l任务：&r&e机械压缩系统"
	quest.5581CDC05059982F.quest_desc: ["&fWandering the burning halls of the &aBurning Arena &fare the dangerous &aIgnited Revenants, &fcursed warriors consumed by eternal flames. Defeating at least &atwo &fof these creatures is essential, as they drop the valuable &aBurning Ashes &frequired to awaken the ruler of the arena itself. Gathering multiple ashes is highly recommended, since additional summons may later be necessary to obtain more materials and rewards from future battles against the dungeon's terrifying boss."]
	quest.5581CDC05059982F.quest_subtitle: "&7击败被点燃的亡灵生物"
	quest.5581CDC05059982F.title: "&5&l任务：&r&e陨落火焰的灰烬"
	quest.568165BED3FA682A.quest_desc: ["&fPatrolling the submerged areas of the &aAcropolis &fare the swift and dangerous &aHippocamtus, &fcreatures capable of rapidly closing distance against careless explorers. Their speed and constant movement make them difficult targets during combat. Defeating at least &afive &fof these enemies is recommended before challenging the greater threats hidden within the ruins."]
	quest.568165BED3FA682A.quest_subtitle: "&7击败海马怪 Hippocamtus"
	quest.568165BED3FA682A.title: "&5&l任务：&r&e溺亡之流的骑手们"
	quest.57159EA0FB597208.quest_desc: ["&f通过将&aInfernal Forge &f的毁灭力量与&aMechanical Fusion Anvil的先进虚空技术相结合，&f冒险者可以打造出传奇的&aVoid Forge。 &f这件可怕的武器既保留了原有形态的毁灭性范围攻击，又通过不稳定的虚空能量进一步放大了其原始破坏力。作为武器和采矿工具，Void Forge是此阶段能获得的最强大的造物之一。"]
	quest.57159EA0FB597208.quest_subtitle: "&7升级炼狱熔炉 Infernal Forge"
	quest.57159EA0FB597208.title: "&5&l任务：&r&e坍缩虚空之锤"
	quest.574EA08AEAD8D669.quest_desc: [
		"&fTo begin progressing through the world of &aAlliance of Valiant Arms, &fadventurers must first construct the essential &aA.V.A Crafting Table. &fThis advanced military workstation serves as the primary station for crafting modern weaponry, tactical equipment, ammunition, explosives and combat utilities. Nearly every firearm, grenade and combat-related item within the mod will require this table at some stage, making it the true foundation of all future military progression."
		"{image:kubejs:textures/images/craftingtable.png width:100 height:55 align:center}"
	]
	quest.574EA08AEAD8D669.quest_subtitle: "&7Craft the A.V.A Crafting Table"
	quest.574EA08AEAD8D669.title: "&5&l任务：&r&e现代战争的基石"
	quest.579F554FA3B1C32D.quest_desc: ["&f在&aDraconic Engineering&f中，首屈一指的先进实用设备当属令人印象深刻的&aDraconium Chest，&f这是一种能比普通容器存储多得多的物品的巨型存储装置。除了巨大的存储容量外，该箱子还集成了&a合成界面&f和内部&a冶炼系统&f，可以直接在箱子内处理材料。冶炼功能需要储存的能量来运行，因此发电机和能源系统对于维持其功能至关重要。此外，该箱子还可以使用能量&a电容器&f进行升级，从而储存更多的便携式能量以延长运行时间。"]
	quest.579F554FA3B1C32D.quest_subtitle: "&7Craft the Draconium Chest"
	quest.579F554FA3B1C32D.title: "&5&l任务：&r&e龙之宝库"
	quest.57E8DBB24BB2D2E1.quest_desc: [
		"&fAmong the valuable remains left behind by the &aNetherite Monstrosity &fare mysterious &aLava Power Cells, &fstrange energy cores capable of bringing dormant creatures to life. Deep inside the treasure chamber of the &aSoul Black Smith &frest small inactive &aMinistrosities, &fwaiting to be activated. Once awakened, these companions can carry and store your &aitems, &fmaking them valuable allies during exploration. They will not naturally follow you, but they can be transported safely inside a &abucket &fand commanded to sit or stand through interaction."
		"{image:kubejs:textures/images/minimonstrosity.png width:120 height:80 align:center}"
	]
	quest.57E8DBB24BB2D2E1.quest_subtitle: "&7唤醒忠诚的迷你怪物巨兽"
	quest.57E8DBB24BB2D2E1.title: "&5&l任务：&r&e赋予火焰生命"
	quest.58C845255A8D3BE3.quest_desc: [
		"&f管理龙之能量网络需要正确控制能量在晶体和机器之间的传输。 &a晶体绑定器 &f是用于连接和引导能量连接的基本工具。要使用它，请先潜行并右键点击要输出能量的晶体。选定后，该晶体将显示一个 &a绿色立方体 &f表示其为活动源。之后，只需右键点击接收晶体或兼容组件即可建立能量连接并开始传输电力。"
		"{image:kubejs:textures/images/2026-05-16_12.13.49.png width:120 height:80 align:center}"
	]
	quest.58C845255A8D3BE3.quest_subtitle: "&7学习使用水晶绑定器"
	quest.58C845255A8D3BE3.title: "&5&l任务：&r&e引导能量的流动"
	quest.5A50E6E0D11BDE41.quest_desc: ["&f使用击败&a斯库拉获得的材料锻造而成，&f传奇的&a凯劳努斯&f是一把蕴含着风暴与闪电毁灭力量的强大武器。其巨大的攻击力使其在艰难战斗中极为有效，奖励那些能掌握其毁灭性潜力的激进冒险者。"]
	quest.5A50E6E0D11BDE41.quest_subtitle: "&7合成 Ceraunus"
	quest.5A50E6E0D11BDE41.title: "&5&l任务：&r&e怒海惊雷"
	quest.5BBD8DE769B24618.quest_desc: ["&fDeep within the drowned chambers of the &aSunken City &fwanders the dangerous &aDeepling Priest, &fa twisted servant of abyssal rituals and forgotten gods. Defeating this creature grants the rare &aAthame, &fa ceremonial blade infused with dark power that is required for crafting the &aAbyssal Sacrifice. &fWithout it, the ritual to awaken the ancient creature beneath the ocean cannot be completed."]
	quest.5BBD8DE769B24618.quest_subtitle: "&7击败深海祭司（Deepling Priest）"
	quest.5BBD8DE769B24618.title: "&5&l任务：&r&e诅咒之刃的守护者"
	quest.5C64C15F14A7B18E.quest_desc: ["&f新首领登场！&c&l南瓜头领主&r&f，南瓜头爵士的加强版，是后期极具挑战性的对手。你可以在&c&l地狱恶南瓜&r&f上使用&c&l转化药剂&r&f来召唤他。准备好迎接多阶段的高难度战斗，他拥有诸如&c&l灵魂分层&r&f、&c&l地狱烈焰&r&f和&c&l活体炸弹诅咒&r&f等强力新招式。"]
	quest.5C64C15F14A7B18E.quest_subtitle: "&lThe ultimate pumpkin entity has risen"
	quest.5C64C15F14A7B18E.title: "&8&l南瓜头领主"
	quest.5CCA6E636D4D80A6.quest_desc: ["&f南瓜灵的灰烬中诞生了一个更恐怖的存在。当它的鬼魂被火焰吞噬时，便会召唤出&c&l焦灼之灵&r&f。它以无尽的愤怒燃烧，所过之处皆留下火焰肆虐的痕迹。你必须&c&l扑灭它的不祥之火&r&f，终结它的&c&l毁灭之路&r&f。"]
	quest.5CCA6E636D4D80A6.quest_subtitle: "&l生于灰烬，以不洁之火为燃料"
	quest.5CCA6E636D4D80A6.title: "&8&l被灼烧的灵魂"
	quest.5D1A701DB64F348B.quest_desc: ["&f在不稳定的&a混沌群岛&f下，隐藏着传说中的&a混沌碎片，&f这是一种蕴含着强大混沌能量的珍贵材料。这些碎片是所有第四级&a混沌融合&f配方所必需的，也将在游戏后期成为最稀有、最重要的资源之一。由于混沌碎片数量稀少，冒险者可能需要寻找更多的混沌矿脉，并与多个&a混沌守卫&f对抗，以收集足够的材料进行未来创造。较大的碎片也可以分解为较小的残片，用于各种高级合成配方中。"]
	quest.5D1A701DB64F348B.quest_subtitle: "&7获得混沌碎片 (Chaos Shards)</c1>"
	quest.5D1A701DB64F348B.title: "&5&l任务：&r&e纯粹混沌的碎片"
	quest.5DF99D29556D2F3A.quest_desc: ["&fCountless ordinary &aDraugr &fwander throughout the frozen corridors of the &aFrosted Prison, &fcreating constant pressure for adventurers attempting to survive within the cursed structure. Though weaker than their elite counterparts, their numbers alone make them dangerous during prolonged fights. Defeating at least &afive &fof these undead warriors is necessary to clear the road toward the prison's deepest chambers."]
	quest.5DF99D29556D2F3A.quest_subtitle: "&7击败德拉克（Draugr）"
	quest.5DF99D29556D2F3A.title: "&5&l任务：&r&e不安亡灵的进军"
	quest.5EFF187EE39FB4AE.quest_desc: ["在&fAcropolis&a的中心，可怕的&aScylla&f正等待着你，&f这位风暴与海洋破坏的怪物统治者。冒险者若长时间静止不动，将面临极大危险，因为它会不断用快速攻击和致命能力压迫敌人。要战胜这个最危险的海洋恐怖生物，持续移动、保持警惕和正确站位至关重要。"]
	quest.5EFF187EE39FB4AE.quest_subtitle: "&7击败斯库拉 (Scylla)"
	quest.5EFF187EE39FB4AE.title: "&5&l任务：&r&e永不停歇的暴风雨"
	quest.5F5A8307645E76C5.quest_desc: [
		""
		"生命值：&2&l30&f&r"
		"生成地点：&6&l主世界的任何地方&f&r"
		"速度：&6&l蹦蹦跳跳&f&r"
		""
		"特殊能力："
		"- 冲向&c&l目标&f&r，将巨大的&e&l避雷针&f&r砸向猎物。此攻击可被&6&l格挡&f&r。"
		"- 它们在空中时，你可以用远程武器如&2&l弩&f&r或&2&l弓&f&r来&6&l击退&f&r或&6&l格挡&f&r它们。"
		"你也可以通过将他们击退来&6&l阻止他们的攻击&f&r。"
		""
		"弱点："
		"- 暴露在&9&l雷鸣天气&f&r中会立即死亡。"
		"- 被&e&l闪电&f&r击杀时，会掉落&7&l一堆灰烬&f&r，右键可获取&8&l火药&f&r和&a&l经验值&f&r。"
	]
	quest.5F5A8307645E76C5.quest_subtitle: "&l击杀罗德（掠夺者构造体）"
	quest.5F5A8307645E76C5.title: "&8&l杀死罗德 (Kill The Rod)</c2></c1>"
	quest.601CBA1445E7D6F1.quest_desc: [
		"&fLightweight but highly versatile, &aFibre &fserves as an important manufacturing material throughout &aAlliance of Valiant Arms. &fThis reinforced synthetic resource is commonly used in the production of weapon lenses, ammunition components and various types of tactical equipment. Due to its flexibility and durability, fibre becomes a recurring requirement for both combat gear and advanced firearm construction."
		"{image:kubejs:textures/images/fibre.png width:100 height:55 align:center}"
	]
	quest.601CBA1445E7D6F1.quest_subtitle: "&7生产纤维"
	quest.601CBA1445E7D6F1.title: "&5&l任务：&r&e加固合成纤维"
	quest.6030DECFC9976C15.quest_desc: ["&fForged using the rare &aIgnitium Ingots &fobtained from the defeated &aIgnis, &fthe legendary &aThe Incinerator &fis one of the most destructive greatswords obtainable during this stage of progression. Infused with immense fire power, this massive blade is capable of unleashing devastating attacks against enemies unfortunate enough to stand before it. Crafting this weapon often requires defeating Ignis several times to gather enough materials for its creation."]
	quest.6030DECFC9976C15.quest_subtitle: "&7制作焚化炉"
	quest.6030DECFC9976C15.title: "&5&l任务：&r&e源自地狱的利刃"
	quest.610C5E12937D85BB.quest_desc: [
		"&fBeyond transportation, &aPoint-to-Point Dislocator Portals &fcan also be used for advanced draconic energy transmission across any distance or dimension. To achieve this, a powered setup must first be connected using a &aBasic Energy I/O Crystal &fdirected toward the &aDislocator Receptacle &fon one side of the portal. On the opposite portal, a &aBasic Wireless Energy Crystal &fcan then receive the transmitted energy and distribute it directly into nearby machines or energy storage systems. Through this method, entire draconic infrastructures can share energy instantly across massive distances."
		"{image:kubejs:textures/images/energyportal.png width:150 height:100 align:center}"
	]
	quest.610C5E12937D85BB.quest_subtitle: "&7Transmit power using Point-to-Point portals"
	quest.610C5E12937D85BB.title: "&5&l任务：&r&e穿越维度之门获取能量"
	quest.610E7FA62E30B5A4.quest_desc: ["&fAmong the greatest treasures obtainable from the &aAcropolis &frests the mighty &aAstrape, &fa legendary weapon empowered by violent storm energy. Built for powerful and relentless combat, this weapon channels the fury of thunder itself against enemies. In the hands of a skilled warrior, Astrape becomes a devastating tool capable of dominating even the most dangerous encounters ahead."]
	quest.610E7FA62E30B5A4.quest_subtitle: "&7合成阿斯特拉佩（Astrape）"
	quest.610E7FA62E30B5A4.title: "&5&l任务：&r&e活风暴之矛"
	quest.612A0A2B5501BC58.quest_subtitle: "&7制作龙之剑 (Draconic Sword)"
	quest.612A0A2B5501BC58.title: "&5&l任务：&r&e屠龙之刃"
	quest.6227DD514BCA30FA.quest_desc: ["&f旅途的终极边界正等待着你。一个漂浮岛屿与神秘生物的世界，鲜有人敢于涉足。你必须找到&c&l传送门&r&f，直面其中的&c&l守护者&r&f，踏入&c&l深渊&r&f，以证明你的勇气。"]
	quest.6227DD514BCA30FA.quest_subtitle: "&lThe ultimate test of strength awaits"
	quest.6227DD514BCA30FA.title: "&8&l通往末地的旅程"
	quest.6317443877E37660.quest_subtitle: "&7Craft the Chaotic Sword"
	quest.6317443877E37660.title: "&5&l任务：&r&e绝对混沌之刃"
	quest.635CA51A84946ABE.quest_desc: ["该装置通过字体和物品添加新附魔，并增强现有附魔。要使其生效，只需添加所选法术的物品即可。"]
	quest.635CA51A84946ABE.quest_subtitle: "别担心，我会教你如何完成这件事的。"
	quest.635CA51A84946ABE.title: "如何进行附魔？"
	quest.63B0C37189B38E92.quest_desc: [
		"&fAs military technology advances, traditional materials alone become insufficient for modern equipment manufacturing. By processing and smelting &aLeather, &fadventurers can obtain &aPlastic, &fa versatile synthetic material used extensively throughout &aAlliance of Valiant Arms. &fPlastic becomes an important component for crafting firearms, tactical equipment and chemical resources such as the valuable &aAcetone Solution, &fmaking it a resource that will remain useful throughout all stages of progression."
		"{image:kubejs:textures/images/plastic.png width:100 height:60 align:center}"
	]
	quest.63B0C37189B38E92.quest_subtitle: "&7生产塑料</c1>"
	quest.63B0C37189B38E92.title: "&5&l任务：&r&e合成战斗材料"
	quest.6623D1FCDD0A1964.quest_desc: [
		"&fNot every firearm component relies purely on metal and industrial alloys. Through specialized compression processes, adventurers can create &aCompressed Wood, &fa reinforced material used in the manufacturing of various firearms and tactical equipment within &aAlliance of Valiant Arms. &fIts durability and lightweight structure make it especially useful for weapon frames, grips and other military constructions."
		"{image:kubejs:textures/images/wood.png width:100 height:55 align:center}"
	]
	quest.6623D1FCDD0A1964.quest_subtitle: "&7合成压缩木材"
	quest.6623D1FCDD0A1964.title: "&5&l任务：&r&e压缩战术材料"
	quest.66F71F7D4CCE9DC9.quest_desc: ["喷泉可用于为仪式、灌注室和附魔装置提供动力，为此你需要用以下发电机生成大量喷泉。"]
	quest.66F71F7D4CCE9DC9.quest_subtitle: "用于存储来源信息的物品。"
	quest.66FCAED7729A06E0.quest_desc: [
		"Imbuement Chamber 是 Ars Nouveau 中用于为物品附加附魔和魔法属性的魔法装置。"
		"源宝石是 Ars Nouveau 中用于制作法术和魔法物品的关键材料，是一种魔法水晶。"
	]
	quest.66FCAED7729A06E0.quest_subtitle: "你需要学会如何制作和自动化宝石，你会需要用到很多。"
	quest.66FCAED7729A06E0.title: "创造你的第一颗源宝石"
	quest.675E886D54AF9D8B.quest_desc: [
		""
		"生命值：&2&l50&f&r"
		"生成：主世界 Y≥78 处&6&l 或雪地生物群系中&f&r&6&l&f&r"
		"攻击： &2&l2-5&f&r"
		""
		"特殊能力："
		"- &4&lOverhead swing&f&r (2 damage): if the player is too close, it starts &6&lspamming its axe&f&r and may chain into a &4&lside swing&f&r."
		"- &4&l侧向横扫&f&r (4点伤害)：向左或向右的宽阔横扫，可能&6&l让你措手不及&f&r。"
		"- &3&l风魔法&f&r (2点伤害)：召唤一个&3&l风刃&f&r，它会&6&l跟随你&f&r，并且可以被&2&l格挡&f&r或&4&l摧毁&f&r。"
		""
		"注意事项："
		"- Both &6&lWolf&f&r and &6&lBruin&f&r drop &b&lBostrox&f&r, which crafts into &2&lvery strong armor&f&r and grants a &2&lstrength buff&f&r."
		"缺点：你&8&l走路会变慢&f&r，并且&c&l会受到额外伤害&f&r，如果你在&6&l奔跑&f&r。"
		"- &b&lBostrox 矿石&f&r也可以在&2&l繁茂洞穴中自然生成"
	]
	quest.675E886D54AF9D8B.quest_subtitle: "&l杀死狼（维京人）"
	quest.675E886D54AF9D8B.title: "&8&l杀死狼崽"
	quest.67B620144D289E0C.quest_desc: ["&f&aAcropolis &f的深处遍布着危险的&aSymbioctos，&f它们是经由诡异海洋腐化融合而成的非自然生物。其不可预测的攻击和机动性，使其成为探索遗迹的冒险者危险的对手。击败至少&a五只&f此类怪物，将大大削弱通往地牢真正统治者之路的威胁。"]
	quest.67B620144D289E0C.quest_subtitle: "&7击败共生体 Symbioctos"
	quest.67B620144D289E0C.title: "&5&l任务：&r&e共生恐怖生物"
	quest.6827840C0258F44C.quest_desc: [
		""
		"生命值：&2&l200&f&r"
		"生成地点：&6&l主世界的任何地方&f&r"
		"速度：&6&l快&f&r"
		""
		"攻击与伤害"
		"- 击碎：&2&l6&f&r + 会把你&c&l击飞&f&r。"
		"- CounterPunch: &2&l5&f&r + &4&l击退&f&r。"
		"- 投石： &2&l8&f&r + &4&l火焰&f&r + &4&l范围伤害&f&r。"
		"- 碎石打击：&2&l8&f&r + 击退 + &c&l不可格挡&f&r。"
		"- 碎石猛击：&2&l8&f&r + 击退 + &4&l火焰&f&r + &8&l迟缓诅咒&f&r + &c&l不可阻挡&f&r。"
		"- 咆哮：&2&l0&f&r + &c&l锁定玩家一秒&f&r + 召唤 &6&l10个火焰噼啪&f&r + 将附近的实体（非玩家）击飞。"
		""
		"特殊能力"
		"- 重型单位可以&6&l格挡&f&r你的攻击，并接上&4&l反击拳&f&r。"
		"- 在他格挡时靠得太&c&l近&f&r，你试图攻击时会被击退。"
		"- 如果你滥用他的格挡帧，他会开始使用&4&l咆哮攻击&f&r。"
		"- 捡起&7&l巨石&f&r后，在破碎前可被击打&2&l3次&f&r，造成&4&l火焰区域伤害&f&r；投掷的巨石会立即破碎。"
		"- 咆哮时，他&8&l不会受到伤害&f&r。"
		"- 尽管会放火，他&2&l并非免疫&f&r于&4&l火焰&f&r。"
		""
		"注意事项"
		"- &4&l火焰攻击强化&f&r适用于所有类型的伤害，包括&6&l投射物&f&r或完整的剑挥砍，能对多个敌人造成&4&l灼烧&f&r效果。"
		"- 你可以&6&l砍断他的手臂&f&r来削弱他的方块和反击。在他反击后立即攻击，但要准备好承受&c&l后果&f&r。"
	]
	quest.6827840C0258F44C.quest_subtitle: "&l击杀重型僵尸/缠斗者（真僵尸+火尘）"
	quest.6827840C0258F44C.title: "&8&l击杀重型单位/缠斗者"
	quest.68D3EA83F0C70401.quest_desc: ["&f为确保战场行动的一致性，冒险者可以制作多功能的&a弹药包，&f这是一种通用弹药补给包，最多可容纳&a200发子弹，&f适用于&a《Alliance of Valiant Arms》中的几乎所有枪械。&f其灵活性使其成为长期战斗和探索任务中最实用的弹药资源之一。"]
	quest.68D3EA83F0C70401.quest_subtitle: "&7Craft the Ammo Kit"
	quest.68D3EA83F0C70401.title: "&5&l任务：&r&e通用战斗补给品"
	quest.69B02D7DDE6F2B34.quest_desc: ["通过消耗附近药水罐中的药水来生成源。源的数量取决于药水的复杂程度。更复杂、更长的药水会提供额外的源。建议使用 Wixies 和 Potion Melder 来酿造复杂的药水。"]
	quest.69B02D7DDE6F2B34.quest_subtitle: "基于药水的世界生成系统。"
	quest.69B2409254A5682F.quest_desc: ["&f潜伏在&a远古工厂&f黑暗走廊中的是可怕的&a潜行者，&f一台专为破坏而生的腐化机器。其残酷的攻击和机械韧性使其比工厂中其他构造体更为危险。尽管被视为次要目标，但击败此生物以消除通往工厂真正主脑途中的危险，仍是强烈建议之举。"]
	quest.69B2409254A5682F.quest_subtitle: "&7击败潜行者 (Defeat The Prowler)</c1>"
	quest.69B2409254A5682F.title: "&5&l任务：&r&e破碎钢铁的猎人"
	quest.69DB8C20E037983E.quest_desc: [
		"&fAs weapon manufacturing becomes increasingly advanced, specialized synthetic materials become essential for modern firearm construction. &aSilicon &fserves as an important industrial component used throughout &aAlliance of Valiant Arms &ffor crafting various weapons and technological firearm parts. Its refined properties make it valuable for producing reliable and efficient military equipment capable of handling demanding combat conditions."
		"{image:kubejs:textures/images/silicon.png width:100 height:55 align:center}"
	]
	quest.69DB8C20E037983E.quest_subtitle: "&7生产硅晶圆 (Produce Silicon)"
	quest.69DB8C20E037983E.title: "&5&l任务：&r&e高级合成组件"
	quest.6A8720FF22F80482.quest_desc: ["&fAs draconic technology continues to evolve, efficient energy transportation becomes increasingly important. The &aBasic Energy Relay Crystal &fserves as a wireless intermediary capable of receiving energy from generators and redirecting it across connected draconic crystal networks. These crystals act as the central links between power sources and other energy components, allowing stable distribution throughout your growing infrastructure. By combining relay crystals with &aInput &fand &aOutput Crystals, adventurers can create complex energy systems capable of powering machines, fusion crafting setups and advanced draconic devices."]
	quest.6A8720FF22F80482.quest_subtitle: "&7Craft the Basic Energy Relay Crystal"
	quest.6A8720FF22F80482.title: "&5&l任务：&r&e能量传输水晶"
	quest.6A94CF1827C3F16E.quest_desc: ["&f水域中潜伏着新的危险。 &c&lThornshell Crab&r&f是一种坚硬的外壳生物，其身体被厚厚的尖刺外壳所保护，难以造成伤害。你必须找到并击败它，以证明你的实力并保护当地的水道。"]
	quest.6A94CF1827C3F16E.quest_subtitle: "&l危险的甲壳类生物潜伏在波涛之下"
	quest.6A94CF1827C3F16E.title: "&8&l毛骨悚然的问题"
	quest.6ABA3CEF4FF389CB.quest_desc: ["&f结合&a龙晶核心、龙晶锭&f和&a下界之星的磅礴力量，&f冒险者便能打造出先进的&a威龙核心。 &f这一强大组件标志着龙族科技的巨大飞跃，开启了更强力装备、高级机械和更复杂的融合配方。与基础的龙晶核心相比，威龙核心蕴含着更强大的龙族能量，是中期进阶的基础。"]
	quest.6ABA3CEF4FF389CB.quest_subtitle: "&7制作一个 Wyvern Core"
	quest.6ABA3CEF4FF389CB.title: "&5&l任务：&r&e由下界之星赋能的核心"
	quest.6ACF2F7B2DB3E480.quest_desc: ["&f诅咒的遗物，&c&lBone Heart&r&f，的低语传入你的耳中。这件传说中被强大的骷髅巫师遗留的远古神器，能为你提供一次抵御致命伤害的庇护。"]
	quest.6ACF2F7B2DB3E480.quest_subtitle: "&l骸骨魔法的遗迹正在等待着你"
	quest.6ACF2F7B2DB3E480.title: "&8&l骨之心 The Bone Heart"
	quest.6CCF30F85E57ADC0.quest_desc: ["&f曾被诅咒的统治者&aMaledictus&f使用的传奇武器&aSoul Render&f，是一把注入了禁忌能量与无尽力量的黑暗武器。专为激进战斗而设计的这把恐怖之刃，体现了最终Boss本身的残暴，也是整个旅程中最强大的武器之一。"]
	quest.6CCF30F85E57ADC0.quest_subtitle: "&7合成灵魂渲染器"
	quest.6CCF30F85E57ADC0.title: "&5&l任务：&r&e吞噬灵魂的刀刃"
	quest.6DACAD03D5FB4C10.quest_desc: [
		""
		""
		"生命值：&2&l8&f&r"
		"攻击： &2&l4-30&f&r"
		"速度：&6&l快速&f&r"
		""
		"特殊能力：&2&l无目标时下潜&f&r，随后弹出并从远处吐出&2&l酸液&f&r。"
		""
		"注意：它们的视力比大多数僵尸都差，所以在被发现前用&6&l弓&f&r效果很好。吐痰者有两种&7&l纹理变体&f&r，衣服和嘴巴都被烧焦了。"
		""
		"掉落：它们很少会掉落一个&2&l酸袋&f&r，你可以投掷它来在撞击时扩散&2&l酸液&f&r。酸袋可以与&a&l史莱姆&f&r结合制作成&4&l凝固汽油袋&f&r，或制成碗来获得来自鸡蛋或雪的&6&l负面效果抗性&f&r。将碗右键点击&9&l水&f&r会给你一杯&a&l清爽的茶&f&r。"
	]
	quest.6DACAD03D5FB4C10.quest_subtitle: "&l杀死吐痰者（真僵尸）"
	quest.6DACAD03D5FB4C10.title: "&8&l杀死喷吐者 (Kill The Spitter)</c2></c1>"
	quest.6E03B37B2E44969F.quest_desc: ["&fFar below the surface of the endless &aocean &flie the ruins of the forgotten &aSunken City, &fa drowned kingdom filled with ancient horrors and dark secrets. To uncover its location, adventurers must first craft the &aEye of the Abyss, &fa mysterious artifact capable of guiding its bearer toward the lost city. Within its flooded halls roam dangerous &amonsters &fguarding materials and rare drops essential for future progression. Their remains will later allow you to craft the item required to summon the terrible boss sleeping beneath the abyss, so prepare yourself carefully before descending into the depths."]
	quest.6E03B37B2E44969F.quest_subtitle: "&7追随深渊之眼 (Follow the Eye of the Abyss)"
	quest.6E03B37B2E44969F.title: "&5&l任务：&r&e溺亡者深渊之下"
	quest.6E8E89BC40583526.quest_desc: [
		"&fSurvival in dangerous combat zones requires more than just powerful weapons. With the &aA.V.A Builder's Table, &fadventurers gain access to a wide variety of military construction blocks and structural components used for creating barricades, defensive positions, fortified bases and tactical battle environments. These structures can provide protection during monster encounters and help establish safer combat zones in hostile territory."
		"{image:kubejs:textures/images/buildertable.png width:100 height:55 align:center}"
	]
	quest.6E8E89BC40583526.quest_subtitle: "&7Craft the A.V.A Builder's Table"
	quest.6E8E89BC40583526.title: "&5&l任务：&r&e战场工程学"
	quest.6EEC1F68BA3BDE55.quest_desc: ["升级你的魔法书，解锁更强大的法术。"]
	quest.6EEC1F68BA3BDE55.quest_subtitle: "将你的新手法术书升级到2阶和3阶。"
	quest.6EEC1F68BA3BDE55.title: "升级你的魔法书"
	quest.6FDF02B000437A2D.quest_desc: [
		"&fModern combat equipment often relies on durable composite materials capable of resisting extreme impacts and battlefield conditions. Through industrial processing, adventurers can obtain &aCeramic Materials, &fa valuable resource used for crafting various types of protective equipment and tactical gear within &aAlliance of Valiant Arms. &fIts resilience makes it an important component for advanced military manufacturing and defensive technologies."
		"{image:kubejs:textures/images/ceramic.png width:100 height:55 align:center}"
	]
	quest.6FDF02B000437A2D.quest_subtitle: "&7生产陶瓷材料"
	quest.6FDF02B000437A2D.title: "&5&l任务：&r&e防护性陶瓷复合材料"
	quest.704F7EF022499376.quest_desc: ["&f扭曲的造物，&c&l暹罗骷髅&r&f，已被释放到这片土地上。这两个悲惨的灵魂，以生命为耻地融合在一起，在平原上游荡，其结合的力量不容小觑。你必须切断它们&c&l被诅咒的纽带&r&f，将它们送回它们所来自的深渊。"]
	quest.704F7EF022499376.quest_subtitle: "&l被命运与恶意束缚的两个诅咒灵魂"
	quest.704F7EF022499376.title: "&8&l西恩的最后防线"
	quest.70770F496FFFD59D.quest_desc: ["&f在&a主世界&f的某个角落，隐藏着废弃的&a远古工厂，&f一座充满腐化机器、被遗忘的实验和不稳定技术的巨大机械结构。要找到这个危险的设施，冒险者必须先制作出&a机械之眼，&f一件能引导持有者前往远古复合体的神器。尽管许多系统早已崩溃，强大的机械守卫仍在巡逻，守护着工厂深处隐藏的秘密。"]
	quest.70770F496FFFD59D.quest_subtitle: "&7跟随机械之眼前进"
	quest.70770F496FFFD59D.title: "&5&l任务：&r&e远古机器的回响"
	quest.71611A6906B633DB.quest_desc: ["&f在淹水的废墟中，隐藏着令人畏惧的&a深渊术士，&f一位精通深渊魔法的大师，能以黑暗攻击压倒疏忽的冒险者。它的存在守护着&a沉没之城&f的秘密，是你与唤醒海底沉睡恐怖仪式之间的众多威胁之一。"]
	quest.71611A6906B633DB.quest_subtitle: "&7击败深渊术士（Deepling Warlock）"
	quest.71611A6906B633DB.title: "&5&l任务：&r&e深渊的低语"
	quest.718730F4A53DE3B3.quest_desc: ["&fGuarding the ancient ruins beneath the sea stands the massive &aCoralssus, &fa colossal creature formed from hardened coral and abyssal energy. Though slow, its immense strength makes it a dangerous opponent for unprepared explorers. Upon defeat, the beast drops the valuable &aCoral Chunk, &fa rare material required for crafting the &aAbyssal Sacrifice. &fThis resource cannot be obtained through any other means."]
	quest.718730F4A53DE3B3.quest_subtitle: "&7击败珊瑚巨兽（Coralssus）"
	quest.718730F4A53DE3B3.title: "&5&l任务：&r&e活珊瑚之心"
	quest.71A074A15F72C62C.quest_desc: ["&f通往终极力量的道路在凡人世界之外。你必须建造并激活一个&c&l下界传送门&r&f，以开启通往深渊的入口，那是一个充满黑暗魔法和未知危险的维度。收集必要的材料并执行仪式，以开启这个&c&l维度之门&r&f。"]
	quest.71A074A15F72C62C.quest_subtitle: "&l进入无尽黑暗与折磨的领域"
	quest.71A074A15F72C62C.title: "&8&l通往深渊的入口"
	quest.726D1E0C02328964.quest_desc: ["&f想要更先进的传送系统，冒险者可以制作&a无界位移器（点对点），&f这是一种特殊的龙裔神器，使用&a2个位移器&f和&a一个龙晶核心制造而成。 &f手持该装置右键点击后，它会分裂成两个外观独特、不同于普通版本的连锁位移器。这对神器专为连接&a位移器传送门&f和&a基座而设计，&f从而能在遥远距离和维度间构建稳定的双向传送网络。"]
	quest.726D1E0C02328964.quest_subtitle: "&7Craft the Un-Bound Dislocator (Point-to-Point)"
	quest.726D1E0C02328964.title: "&5&l任务：&r&e跨越空间的链接"
	quest.726E98DE050EDBB2.quest_desc: [
		""
		"HP: &2&l95&f&r (存活) / &2&l120&f&r (尸体)"
		"速度：&6&l蹦蹦跳跳&f&r"
		""
		"攻击与伤害："
		"- 身体撞击：&2&l8&f&r + 使你&c&l飞&f&r（范围伤害）。"
		"- 身体发射：&2&l12&f&r + &4&l击退&f&r + 有小概率&4&l爆炸&f&r。"
		"- &4&lSWALLOW&f&r: &2&l12&f&r + blockable + &c&lLOCK IN&f&r + &2&lGOO&f&r."
		"- &4&l咆哮&f&r (在 &2&l50 点生命值&f&r)：提升其 &4&l力量&f&r和&8&l抗性&f&r。"
		""
		"特殊能力："
		"- 它们&8&l不会重生或消失&f&r，所以你必须走得更远才能找到更多。"
		"- 它们生活在&6&l地下深处&f&r，&c&l伏击猎物&f&r。"
		"- 死亡时会留下一个&7&l尸体&f&r，吸引半径&2&l20格&f&r内的僵尸来摧毁它（&2&l120 HP&f&r）。"
		"- 有时战斗中会停止追逐，然后挖走，若被忽视会&8&l消失&f&r，迫使你靠近（它们对投射物有&8&l抗性&f&r）。"
		"- 尸体被摧毁后，会掉落&2&l巨型骨头&f&r、&4&l肉块&f&r、&a&l史莱姆&f&r等物品，还会引发造成黏液效果的&2&l黏液爆炸&f&r。"
		""
		"提示："
		"- 需要&2&l两个铁傀儡&f&r才能杀死它。"
		"- 在没有其他&c&l怪物&f&r的&6&l开阔地带&f&r战斗会容易得多。"
	]
	quest.726E98DE050EDBB2.quest_subtitle: "&l击杀堵塞者/猪人（恶魔不死生物）"
	quest.726E98DE050EDBB2.title: "&8&l击杀堵塞者/小猪佩奇"
	quest.727A2CB75C74C9FF.quest_subtitle: "&7Craft the Draconic Shovel"
	quest.727A2CB75C74C9FF.title: "&5&l任务：&r&e远古的破土者"
	quest.73D2E3304B67066F.quest_desc: ["&f借助&a机械融合砧的力量，&f&a守护者手套&f可以进化为可怕的&a漩涡手套。 &f这件强化的虚空武器极大地增强了其引力能力，使佩戴者能以更强的力量和效率操控附近的敌人。在技艺高超的冒险者手中，手套将成为一种极其危险的战术武器，即使在最艰难的遭遇战中也能掌控战场。"]
	quest.73D2E3304B67066F.quest_subtitle: "&7升级守护者护手 (Gauntlet of Guard)"
	quest.73D2E3304B67066F.title: "&5&l任务：&r&e无尽风暴的掌控"
	quest.73EAEBE3D66052DF.quest_desc: ["&f掌握高级&a融合锻造&f的第一步，是制作&a德拉科尼乌姆融合锻造注射器。 &f这个核心组件构成了一级融合锻造系统的基础，能将龙之能量导入复杂的配方和科技造物中。通过这一级的融合，冒险者可以获得诸如&a德拉科尼乌姆箱子&f和更先进的&a威文融合锻造注射器&f等实用构造，标志着更强大龙之工程的开端。"]
	quest.73EAEBE3D66052DF.quest_subtitle: "&7Craft the Draconium Fusion Injector"
	quest.73EAEBE3D66052DF.title: "&5&l任务：&r&e融合工艺的基础知识"
	quest.742E3BE1E29A174E.quest_subtitle: "&7Craft the Wyvern Hoe"
	quest.742E3BE1E29A174E.title: "&5&l任务：&r&e龙之能量的丰收"
	quest.744018852485D0F6.quest_desc: ["&fRising above the coral reefs of the endless &aocean &fstands the mysterious &aAcropolis, &fan ancient structure consumed by storms and guarded by countless sea creatures. To uncover this dangerous location, adventurers must craft the &aEye of Storm, &fan artifact capable of guiding its bearer toward the floating ruins. Unlike many previous dungeons, the Acropolis is heavily populated with hostile enemies, making every corridor and platform a dangerous battlefield for unprepared explorers."]
	quest.744018852485D0F6.quest_subtitle: "&7追随风暴之眼"
	quest.744018852485D0F6.title: "&5&l任务：&r&e风暴之上的堡垒"
	quest.751CE709736FE6AB.quest_desc: [
		""
		"生命值：&2&l16&f&r"
		"生成位置：地面以上78+格&6&l或地下&f&r"
		"攻击：&2&l4&f&r"
		"速度：&6&l快&f&r"
		""
		"特殊能力："
		"- 造成伤害后会完全&2&l恢复自身&f&r（除非攻击被&7&l格挡&f&r）。"
		"- &6&l飞行&f&r，用来迷惑目标或躲避攻击。"
		"- 造成伤害后，它会&6&l移动/飞走&f&r一秒，然后再回来攻击。"
		"- 可以&4&l破坏围栏&f&r和&4&l门&f&r。"
		""
		"弱点："
		"- 飞行时&c&l很脆弱&f&r，所以试试&2&l在空中包抄它&f&r。"
		"- 它无法&6&l在空中停止&f&r。如果在被追逐时将其引向&8&l悬崖&f&r或&9&l深河&f&r，它可能会意外&c&l坠落&f&r。"
		""
		"\"&6&l它们喜欢杀戮&f&r和&4&l吃掉动物&f&r，所以要保护它们&2&l&f&r。\""
	]
	quest.751CE709736FE6AB.quest_subtitle: "&l击杀猎人（恶魔不死生物）"
	quest.751CE709736FE6AB.title: "&8&l击杀猎人"
	quest.755427FAABBB8A56.quest_desc: [
		"&fTo sustain large-scale firearm combat and explosive warfare, ordinary gunpowder must be refined into a more stable and concentrated form. The resulting &aPacked Gunpowder &fserves as a critical explosive material used in the production of ammunition, grenades and various military explosives throughout &aAlliance of Valiant Arms. &fAs combat intensifies and weapon usage increases, maintaining a steady supply of this resource will become essential for continued military operations."
		"{image:kubejs:textures/images/gunpowder.png width:100 height:55 align:center}"
	]
	quest.755427FAABBB8A56.quest_subtitle: "&7合成压缩火药包"
	quest.755427FAABBB8A56.title: "&5&l任务：&r&e压缩爆炸化合物"
	quest.75AF1215667FE365.quest_desc: [
		""
		"生命值：&2&l10-12&f&r"
		"生成地点：&6&l主世界的任何地方&f&r"
		"近战伤害：&2&l10&f&r + &4&l爆炸&f&r"
		""
		"特殊能力："
		"- 它们会&6&l遁入地下&f&r，只有在接近&c&l目标&f&r时才会出现。"
		"- 如果有屋顶，它们有时会从&7&l屋顶&f&r而不是地面出现。"
		"- 它们会&4&l接触即爆炸&f&r（但可以&2&l被阻挡&f&r）。"
		""
		"死亡后，它们会开始&6&l膨胀&f&r，然后&4&l爆炸&f&r；你可以用任何&2&l工具&f&r将它们扔开，但这种冲击波&c&l无法被阻挡&f&r。"
		""
		"提示：它们出现或地下移动时会发出&e&l声音&f&r。"
		""
		"注意：Goo 可以用 &9&l水&f&r 洗掉，任何被 &2&lGoo 覆盖&f&r 的生物都会受到额外的 &c&l火焰伤害&f&r。"
	]
	quest.75AF1215667FE365.quest_subtitle: "&l杀死比迪（真僵尸）"
	quest.75AF1215667FE365.title: "&8&l杀死比迪 (Kill The Bidy)</c2></c1>"
	quest.761AF8D3829FB12F.quest_subtitle: "&7Craft the Wyvern Shovel"
	quest.761AF8D3829FB12F.title: "&5&l任务：&r&e龙之发掘"
	quest.7627BA1A46CE337E.quest_desc: ["&fWith stable energy generation and crystal transmission systems now established, the path toward true &aFusion Crafting &fcan finally begin. From this point onward, draconic technology advances far beyond simple machines and components, unlocking access to powerful fusion systems, advanced equipment and increasingly complex creations. Proper energy management and the use of connected &aEnergy Crystals &fwill become essential for sustaining the immense power required by future draconic engineering."]
	quest.7627BA1A46CE337E.quest_subtitle: "&7驾驭超越凡人极限的能量"
	quest.7627BA1A46CE337E.title: "&5&l任务：&r&e融合时代开启"
	quest.7761635EF7DDD4CD.quest_desc: ["制作盔甲来保护自己免受魔法威胁。"]
	quest.7761635EF7DDD4CD.quest_subtitle: "使用魔法材料来制作盔甲。"
	quest.7761635EF7DDD4CD.title: "制作魔法盔甲"
	quest.77C05A9D3FE10987.quest_desc: ["&f借助&aIgnitium 升级&f和从&aIgnis 收集的稀有材料，&f冒险者可以锻造出传奇的&aIgnitium 盔甲，&f一套蕴含着强大火焰抗性和无与伦比耐久度的强力装备。这套盔甲是最强的防御装备之一，对于在旅程末期遭遇的灾难性战斗至关重要。"]
	quest.77C05A9D3FE10987.quest_subtitle: "&7制作Ignitium盔甲"
	quest.77C05A9D3FE10987.title: "&5&l任务：&r&e经灾难淬炼的盔甲"
	quest.783B19283A6AC2B3.quest_desc: ["&fTo advance further into the secrets of &aDraconic Engineering, &fadventurers must challenge and defeat the legendary &aEnder Dragon. &fThis battle is essential for obtaining unique draconic materials such as the &aDragon Egg, Dragon Heart &fand valuable &aDraconium Dust, &fresources required for advanced fusion crafting and the creation of powerful technological artifacts. Without these rare materials, many of the strongest draconic systems and upgrades will remain forever out of reach."]
	quest.783B19283A6AC2B3.quest_subtitle: "&7击败末影龙"
	quest.783B19283A6AC2B3.title: "&5&l任务：&r&e远古巨龙之心"
	quest.7873AAFE06BB2DE0.quest_desc: ["这是一种从魔花植物中采集的魔法材料，用于制作施法长袍和新的合成物品。"]
	quest.7873AAFE06BB2DE0.quest_subtitle: "这种纤维可以制作强大的装备。"
	quest.7873AAFE06BB2DE0.title: "魔法纤维"
	quest.7950B051625DAFC8.quest_desc: ["&f在&a远古工厂&f的核心中，沉睡着一个名为&a先兆者&f的灾难性实体，这是一种与传奇的凋零相似的巨型机械恐怖。要唤醒这个生物，冒险者必须献上&a下界之星&f，从而再次激活这台远古机器。先兆者是一个极其危险的对手，能释放出毁灭性的爆炸和压倒性的攻击，但击败它能获得此阶段最重要的奖励之一。其珍贵战利品包括传奇的&a机械融合砧&f和破坏性的&a凋零突击肩炮。"]
	quest.7950B051625DAFC8.quest_subtitle: "&7击败先兆者 (Defeat The Harbinger)"
	quest.7950B051625DAFC8.title: "&5&l任务：&r&e吞噬世界的机器"
	quest.79A251120A9917CD.quest_subtitle: "&7合成威龙剑 (Craft the Wyvern Sword)"
	quest.79A251120A9917CD.title: "&5&l任务：&r&e威龙的利刃"
	quest.7B18DEA473B16CCA.quest_desc: [
		"&f&o探索巡逻的蒙面战士所在的巴拉科阿村庄。"
		"&f&o戴上巴拉科阿面具，才能安全接近他们的首领并进行交易。"
	]
	quest.7B18DEA473B16CCA.quest_subtitle: "&7Masks, blowguns, and a sun throne"
	quest.7B18DEA473B16CCA.title: "&f&l突袭巴拉科阿村庄"
	quest.7CA737C76D0E1867.quest_desc: ["&f墓地陷入死寂，预示着潜伏其中的恐怖。一只&c&lDecrepit Skeleton&r&f，远古邪物，已在此扎根，用其恶意诅咒着这片土地。它的骸骨低语着被遗忘的苦难，你必须永远终结它们的低语。"]
	quest.7CA737C76D0E1867.quest_subtitle: "&l源自古墓的诅咒回响在耳畔"
	quest.7CA737C76D0E1867.title: "&8&l低语的骸骨 (The Whispering Bones)</c2></c1>"
	quest.7DEE0DB11E4B2555.quest_desc: ["这个魔法种子用于种植魔法花，它能产出魔法纤维，是制作魔法装备和物品的重要资源。"]
	quest.7DEE0DB11E4B2555.quest_subtitle: "你应该像种植其他植物一样种植这颗种子。"
	quest.7DEE0DB11E4B2555.title: "获取 Magebloom 种子"
	quest.7E17072B4ABA2026.quest_desc: ["&f在长期军事行动和大规模战斗中，升级后的&a弹药包 I &f可提供多达&a1000发的巨大弹药储备。 &f这个高级补给包大大减少了持续制作弹药的需求，在长途探险、围攻和危险战斗中尤为宝贵。"]
	quest.7E17072B4ABA2026.quest_subtitle: "&7制作弹药包 I"
	quest.7E17072B4ABA2026.title: "&5&l任务：&r&e大规模弹药储备"
	quest.7E44D8FB0AAA854C.quest_desc: ["&f为了扩展龙之交通网络的可能性，冒险者可以制作强大的&aDislocator Pedestal。&f该装置几乎可放置于任何地方，允许将绑定的&aDislocator&f直接插入基座。安装后，玩家只需右键基座即可传送到已存储的目的地，而不会消耗Dislocator的任何有限次数。通过该系统，可以在遥远地点和维度之间创建完整的传送网络和快速旅行基础设施。"]
	quest.7E44D8FB0AAA854C.quest_subtitle: "&7Craft the Dislocator Pedestal"
	quest.7E44D8FB0AAA854C.title: "&5&l任务：&r&e即时旅行的锚点"
	quest.7E7F612F76FED684.quest_desc: ["Wixies可以自动化合成任务，为你节省时间和精力。"]
	quest.7E7F612F76FED684.quest_subtitle: "使用 Wixie 来自动化合成。"
	quest.7E7F612F76FED684.title: "自动化一个任务"
	quest.7F0C0A792F62F67C.quest_desc: ["&f新的恐怖在夜间徘徊。名为&c&lDread Hound&r&f的恐怖生物，一种可怕的骷髅生物，已被目击在荒凉的土地上游荡。它有着发光的红眼睛和骨瘦如柴的身躯，带着凶猛的饥饿感进行捕猎。它那令人毛骨悚然的嚎叫会让任何听到的人心生恐惧。你必须追踪并杀死这个怪物，以恢复这片土地的和平。"]
	quest.7F0C0A792F62F67C.quest_subtitle: "&l在荒凉的土地上盘旋的恐怖幻影"
	quest.7F0C0A792F62F67C.title: "&8&l一只可怕的猎犬"
	quest.7FA10C025B1F8C24.quest_subtitle: "&7制作龙之弓 (Draconic Bow)"
	quest.7FA10C025B1F8C24.title: "&5&l任务：&r&e无尽湮灭之弓"
	quest.7FE6353456027898.quest_desc: ["&f随着你对龙族能量的理解不断加深，普通的合成方法已不足以处理日益强大的材料和物品。通过使用&a融合合成，&f冒险者可以将巨大的能量引导至先进的科技转化中，从而打造出传奇装备、强大的核心和顶级的龙族机械。从今以后，掌握融合系统、注入器等级和稳定的能量分配，将是你深入研究&a龙族工程学所必需的技能。"]
	quest.7FE6353456027898.quest_subtitle: "&7解锁高级龙系制作的途径"
	quest.7FE6353456027898.title: "&5&l任务：&r&e融合工程"
	reward_table.062FA69193AFE668.title: "弹药"
	reward_table.18776C052629EC78.title: "c4"
	reward_table.5DBEBDDB876C86E0.title: "材料"
	reward_table.795378223AF5350E.title: "rope1"
	task.06495392050259A5.title: "&f&l击杀炸弹手"
	task.10ABA761CD1433A1.title: "&e&l欢迎来到 Mowzie’s Mobs 模组世界"
	task.23719D42EE947D0A.title: "&f&o击杀噩梦追踪者。"
	task.2D1A4CE5A09AD750.title: "&f&l欢迎来到 The Undead Revamped 模组世界"
	task.3C04130D06DA3697.title: "&f&l&o通往深渊的入口"
	task.57C61BEE2C895441.title: "Wixie"
	task.6EA6D71F0DE00ACF.title: "混沌中诞生"
	task.7356070B956D12DF.title: "&f&o收集火光粉尘。"
}
