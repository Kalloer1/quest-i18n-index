				table_id: 7222457053193351074L
			}]
		}
		{
			x: 12.0d
			y: -1.0d
			subtitle: "在旧冠军墓中出现的Boss，这具骷髅被另一个存在——狂乱之影所附身。他的攻击取决于是否手持盾牌，会在防御姿态和攻击姿态之间切换。防御状态下，他移动较慢，但能减免所有来源的伤害。此外，他还有其他好坏参半的被动效果。"
			id: "4955EAA4F01502A8"
			tasks: [{
				id: "38742BA86EB4558E"
				type: "kill"
				icon: {
					id: "soulsweapons:draugr"
					Count: 1b
