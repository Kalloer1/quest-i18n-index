			x: 0.793d
			y: -1.642d
		}
		{
			dependencies: ["937F654D74EFD65F"]
			description: ["介电浆是Powah基础设施常用的绝缘材料。尽早自动化其配方，因为每个等级都会持续消耗它。"]
			id: "155DD300661B86B2"
			shape: "circle"
			tasks: [{
				id: "198A5CE5EA84334A"
				item: "powah:dielectric_paste"
