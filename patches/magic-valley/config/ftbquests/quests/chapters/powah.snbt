			title: "介电质浆料"
			x: 0.165d
			y: -0.739d
		}
		{
			dependencies: ["155DD300661B86B2"]
			description: ["将介电棒作为浆料和机器外壳之间的结构步骤。保持缓冲库存，以免在重建电源时升级中断。"]
			id: "2735CCA3B8D74383"
