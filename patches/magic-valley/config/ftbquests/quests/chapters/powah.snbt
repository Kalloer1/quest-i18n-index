	quests: [
		{
			description: ["Powah 是一个七层级的能源生态系统。横向推进，依次经过 Starter、Basic、Hardened、Blazing、Niotic、Spirited 和 Nitro，同时纵向比较发电机。仅在测量到的需求、传输能力和存储储备足以证明材料成本时进行升级。"]
			id: "937F654D74EFD65F"
			rewards: [{
				id: "1AAB633037529C05"
				type: "xp"
				xp: 10
			}]
			shape: "rsquare"
			tasks: [{
				id: "E00275E584651C89"
				title: "确认：一个分级的电力系统"
				type: "checkmark"
			}]
			title: "分级供电系统"
			x: -0.913d
			y: -0.954d
		}
		{
			dependencies: ["937F654D74EFD65F"]
			description: ["请保留 Powah 手册以了解精确的生成率、环境加成、反应堆输入和每级的传输限制。任务会解释进度决策，而手册和 JEI 仍然是整合包配方的权威来源。"]
			id: "A30FC2B67E15AA99"
			shape: "circle"
			tasks: [{
				id: "0102BE5C5BF0B39D"
				item: "powah:book"
