			title: "Powah 手册"
			x: -0.559d
			y: 0.087d
		}
		{
			dependencies: ["937F654D74EFD65F"]
			description: ["在投入反应堆前，先建立可再生或储量充足的铀矿石供应。普通、一般和致密矿石的产量不同，能量球能将原材料转化为可用的铀矿石。"]
			id: "0DAB9192A0251F62"
			shape: "circle"
			tasks: [{
				id: "7A67B211D9EA22D7"
