			}]
			subtitle: "我们正在采用荣誉制度来管理这件事"
			tasks: [{
				id: "68262475C586C249"
				title: "工业挑战系列任务书"
				type: "checkmark"
			}]
			x: -1.5d
			y: -1.0d
		}
		{
			description: ["众所周知，这个世界充满了各种新僵尸，但它们并非唯一存在的生物！这些任务的核心就是杀死所有会动的东西"]
			icon: {
