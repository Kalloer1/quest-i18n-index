	quests: [
		{
			description: [
				"&7嗨，你好……"
				""
				"&7你可能搞不清楚自己在哪里，你是谁，还有我是谁……对吧？"
				""
				"&7你此刻所站立的地方，正是在众神为满足自身好奇心而创造的&6&lValiant&r&e世界之中。"
			]
			icon: "forbidden_arcanus:divine_pact"
			id: "155D1FE01880FBF2"
			shape: "none"
			subtitle: "&8[点击阅读更多]"
			tasks: [{
				id: "494446A9CE3A127C"
				title: "继续"
				type: "checkmark"
			}]
			title: "&f\"初次接触\" &b(1/4)"
			x: 0.5d
			y: 0.5d
		}
		{
			dependencies: ["155D1FE01880FBF2"]
			description: [
				"&7你被召唤至此，&3开启一场充满史诗冒险与战斗的旅程。"
				""
				"&7至于我，我……曾是这个世界里上一位“英雄”。不幸的是，在完成使命前，我就已经丧命了……"
			]
			icon: "eidolon:research_notes"
			id: "6391B0304C895840"
			shape: "none"
			subtitle: "&8[点击阅读更多]"
			tasks: [{
				id: "4525DC40C4F27EA6"
				title: "继续"
				type: "checkmark"
			}]
			title: "&f\"一个漫长的故事\" &b(2/4)"
			x: 3.0d
			y: 0.5d
		}
		{
			dependencies: ["6391B0304C895840"]
			description: [
				"&7我死后，我听到一个声音……他们对我说……"
				""
				"&9\"你希望就此结束旅程，永不见天日……还是希望获得新生？\""
				""
				"&9\"你展现了非凡的勇气，而且非常善良，乐于助人。\""
				""
				"&9\"其他人...来自不同世界...他们将经历与你一模一样的故事。他们也需要指引来照亮自己的道路。\""
			]
			icon: "forbidden_arcanus:enchanted_soul"
			id: "38E26029FBA1913F"
			shape: "none"
			subtitle: "&8[点击阅读更多]"
			tasks: [{
				id: "5941932A35A36E8E"
				title: "继续"
				type: "checkmark"
			}]
			title: "&f\"不灭的命运\" &b(3/4)"
			x: 5.5d
			y: 0.5d
		}
		{
			dependencies: ["38E26029FBA1913F"]
			description: [
				"&7所以，经过深思熟虑之后……我决定选择后者……"
				""
				"&7因此，我重生在了你的世界，获得了复活、永生和关于这个世界的知识。不幸的是，重生时我原世界的身体无法修复，所以我现在以无形的灵体形态存在。"
				""
				"&7我把自己使命定为，确保像你这样的人...完成他们的旅程。"
				""
				"&e那么...祝你好运，朋友...愿你的命运比千颗星辰更加璀璨。"
			]
			icon: {
				Count: 1
