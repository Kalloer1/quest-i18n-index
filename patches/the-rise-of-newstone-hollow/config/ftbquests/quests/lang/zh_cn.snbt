# AI 初翻，未人工校对
{
	chapter.1BA63B3D442634F3.title: "Foregone Industry"
	chapter.42E5151EE62182CC.title: "... 万物各就其位"
	chapter.434B390999A6EA0E.title: "正在合成资源"
	chapter.43D354AD3B952ABF.title: "Dire Times, 20 只狼"
	chapter.4B1229F34CDBAF10.title: "万物各归其位，井然有序……"
	chapter.4FD7E205ED15677C.title: "奠定基础"
	chapter.5E041E7746FAF97D.title: "生物盒子，一个你无法拒绝的提议"
	chapter.6205698F2556C84F.title: "动态整合模组 (Dynamically Integrated Mod)"
	chapter.68264299A2F01768.title: "毕竟，最终还是有目标的存在的"
	chapter.6DD5238D54AAB5B3.title: "我们所知的IO的终结"
	chapter.7FA6E94DC1AFAD57.title: "波动赋能（Fluxuating Empowahment）"
	quest.00FC75F7F3FD5DE0.quest_desc: [
		"我们正在路上！一会儿见！"
		""
		"非常感谢你提供的所有帮助！"
	]
	quest.01BC305C929B90AF.quest_desc: [
		"这是你的 &bBackpack&r 的升级底座。"
		""
		"稍加研究，你会发现 &bBackpack&r 和储物升级可以互换使用。"
	]
	quest.030C5514F23CF444.quest_desc: [
		"好了，现在拿你制作的&b花岗岩&r和你收集的&b蜂蜜瓶&r，用其中一个右键点击另一个。"
		""
		"不行？试试用另一个右键点击另一个。"
		""
		"Boom - &b铜矿石&r！把它敲碎，获取一些&b原铜&r！"
	]
	quest.03422F73507E8C92.quest_desc: [
		"储物空间很重要，因为你会捡到好多东西！"
		""
		"那何不顺其自然，整一个&bStorage Bank&r呢！没错，是银行。这个小宝贝能装下多达9种不同的物品，每种物品还能放4个堆叠。快去制作吧！"
		""
		"对于脑洞大开的你，还有一个叫&bThe Tank&r的流体版银行。如果你想完成这个任务，不妨试着建造一个！"
	]
	quest.03DB23461BB43688.quest_desc: [
		"更高级的机器需要更高级的&b机器框架&r。制作这个时，你应该已经自动化了一些流程，这很好，因为制作这些机器需要不少步骤。"
		""
		"但是，如果你想获得&b虚空闪烁凝胶&r（我们很快就会讲到），就需要用到这个。"
	]
	quest.042E7A8E38C63058.quest_desc: ["这些家伙在链接到你的存储控制器后，将允许你通过管道或漏斗直接与你的存储系统进行传输。"]
	quest.0476B88E0F9C0491.quest_desc: [
		"有&b木炭&r吗？好。如果可以的话，最好继续烧，因为没有&b煤炭&r，你肯定会需要它的。"
		""
		"来测试一下你的&b熔炉&r是否正常。往里面扔些&b鹅卵石&r，把它烧成&b石头&r。建议你现在多做一些，后面会用到。"
	]
	quest.054D49D72F346E1F.quest_desc: [
		"&b磁盘驱动器&r里存放着所有你制作的&b磁盘&r，让你的AE2系统保持高效运转。"
		""
		"制作一个这个，你就可以出发了！"
	]
	quest.05A6989623B53C03.quest_desc: [
		"如果你想让这东西运行得更快，或者强化特定怪物掉落的物品，就制作一个（最多四个）这样的升级模块，添加到你的生物农场里。它们会帮你获得更好的材料，其中一些还针对特定生物定制。"
		""
		"剩下的就看你自己了！"
	]
	quest.05E8B94B9E6E5AB6.quest_desc: [
		"需要搬运物品吗？来制作一些这些吧！"
		""
		"对此有升级，可以过滤物品、加快提取速度等。"
		""
		"另外，和所有 Ender IO 导管一样，你可以在同一个方块空间里放置多个这种导管！"
	]
	quest.0602AF31A0AD48FB.quest_desc: [
		"将 &bStorage Terminal&r 连接到任意一根 &bLogic Cable&r 上，如果一切顺利，你应该就能访问整个系统了。如果不顺利，说明你操作有误，或者我的描述有问题。"
		""
		"不管怎样，检查所有连接是否正常，点击左上角的合成台标签，砰的一声，谁是人类？是你！除非你不是人类，那样的话，我前来是和平的。"
	]
	quest.06609BBE91DC666F.quest_desc: ["模式编码终端用于制作自动合成配方。如果你想深入研究自动化，就需要这台机器。"]
	quest.07BD5E553FBC124A.quest_desc: [
		"好了，这个东西很重要，所以请务必仔细听清楚。"
		""
		"之前我让你做了一些&b平滑石头&r。希望你做了很多！你还需要一些&b玻璃&r，所以去弄点，然后做一个&b石头块生成器&r。最好多做几个，它们很快就会派上用场的！"
		""
		"我们可以编程，让它自动吐出你能想到的几乎所有类型的石头，直接吐到你放在它上面的任何容器里。我脑子里想的计划需要很多不同类型的石头！"
		""
		"另外，四处看看村庄。你应该能找到 &6Newstone Hollow&r 昔日的遗迹。或许能在某处找到些旧 &bIron&r 工具，用你的回收器做成桶。说不定还能直接找到一个桶，完全不需要回收任何东西！"
	]
	quest.08133F18BA06E605.quest_desc: [
		"燃烧吧 &b基岩&r 燃烧吧，末影人！"
		""
		"用火焰点燃一些&bBedrock&r，等它发出爆裂声，然后捡起一些&bGrains of Infinity&r！任何营养早餐的基石。"
		""
		"我的意思是，Ender IO 的机器。嗯，这才是我想说的。"
	]
	quest.08322DB2E353F4B3.quest_desc: ["你知道吗？Sophisticated Storage 也能做便携储物！没错！用皮革和其他材料，制作一个可完全升级的 &b背包&r，保证你会怀念没有它的日子！"]
	quest.0A551CB99A98E744.quest_desc: [
		"使用你的 &b虚空底盘&r 制作一个 &b合金熔炉&r。用哪个都可以。"
		""
		"给这东西加个好点的&b电容器&r，它煮东西的速度会比你眨眼还快。再也不用等那些慢吞吞的旧原版&b熔炉&r了。你还可以用它来制作合金，把某些材料混合成别的材料。这将开启一个全新的可能性世界！"
		""
		"别忘了，Ender IO 有许多实用的机器可以辅助你的旅程。不必只局限于这一台！"
	]
	quest.0E215DA535D4D9C1.quest_desc: [
		"现在，魔法将从这里开始显现！"
		""
		"你的&b石头生成器&r现在应该能产石头了。如果不能，请返回上一个任务或在JEI中检查是否已正确设置一切。"
		""
		"将你的新&b石头方块&r放在地上，手里拿着一些&b燧石&r。现在，用&b燧石&r右键点击&b石头&r，如果我的计算正确，它应该会变成&b煤炭矿石&r！把它敲碎，获取你辛辛苦苦制作的&b煤炭&r！"
	]
	quest.103199D75DBDC7A5.quest_desc: [
		"回到那个传说中的“下界”吧。我还没找到证据证明它存在，但里面肯定有很多&b玄武岩&r！"
		""
		"弄一堆这个，还有你一直在做的 &b金&r 子。"
	]
	quest.10C98E73946CC03C.quest_desc: [
		"想无线给自己供电吗？要是真有就好了！不过，制作一个这个，你的无线网络就准备好了。这可是整个装置的核心。请小心使用！"
		""
		"正确配置并确保其持续供电，这样你就能获得所需的无线电力！"
	]
	quest.11B985E986E67894.quest_desc: [
		"数字存储！这可是孩子们最流行的东西。把它想象成不用别人电脑的云存储吧！就是这么简单！"
		""
		"制作一个&bME控制器&r来启动你的数字存储。传说中存在一个更先进的存储系统，可惜已随岁月流逝而失传。"
	]
	quest.1479E9BED62FB3E1.quest_desc: [
		"&b暗影脉冲凝胶&r可能更难获得，因为你需要找到一个叫“坚守者”的大怒汉。他住在深暗生物群系里。还没找到？用自然罗盘找找方向吧！"
		""
		"其实，如果你足够安静，&o可以&r避开这家伙。下面你要找的是&bEcho Shards&r、&bSculk Shriekers&r和&bSculk&r。大部分都可以用带&bHoe&r的丝绸之触来挖掘。"
		""
		"顺便一提，把物品和&b书&r（或几本书）放在&b黑曜石方块&r上，再放个&b铁砧&r就能移除附魔。轻松获得丝绸之触附魔！"
	]
	quest.15989664A4077372.quest_desc: ["存储组件会组成磁盘。更大的磁盘能装更多内容。最顶部的驱动器相当于无限存储！但这需要你努力。你需要这么多东西，不如现在就动手制作吧。"]
	quest.163AAB1DF68BFE25.quest_desc: ["用&b红色染料&r和&b红色砂岩&r就能合成&b红石矿石&r，最红的石头！快去合成，收集奖励吧！"]
	quest.199215FE1642F634.quest_desc: [
		"是时候认真谈谈你为我制作的这些东西，我们该何去何从了。"
		""
		"如果能集齐合适的资源，我们就能造一台机器，希望能带我们回去！为此，你至少需要一个 &bSupreme Machine Frames&r，因为我们需要它来制作 &bShadowpulse Goo&r（这个我们稍后会讲到）。"
	]
	quest.1A8F81227016ADA9.quest_desc: [
		"&b能量线缆&r，跟着我，用来传输能量。如果你想把Powah从一个地方传到另一个地方，而且还没找到无线传输的方法，这就是你需要的东西。"
		""
		"这个等级每秒传输 2,000 RF，最高等级每秒传输 1,000,000 RF！太疯狂了！"
	]
	quest.1A962341CEC446A3.quest_desc: ["做好了自己的&bMob Farm&r？是时候设置好用来生成资源的生物了。每种生物都有自己的生物群系，所以如果你想建一个牛农场，就需要建一个&bAnimal Plains Farm&r。如果是建烈焰农场，就需要一个&bNether Fortress Farm&r。你懂的，快去制作吧！这些都可以。"]
	quest.1B2F342369133229.quest_desc: [
		"我们的机器需要大量电力，所以我们要制作几个无限电量的电池！穆阿哈哈！"
		""
		"总之，做两个出来，就当我没说过这话。快往那边看！"
	]
	quest.1BCD4C3F66AAB0F1.quest_desc: ["现在有了激动人心的方块转换！比油漆干的速度快 83.662%！"]
	quest.1BE114B2C9F2E02F.quest_desc: [
		"小时候我读过很多科幻小说。这给了我一个绝妙的主意！如果能无线地将 Powah 直接发送给一个人，让他们随身携带的任何设备都能保持满电状态，那该多好。手机、&bBlock Exchangers&r、&bWirless Terminals&r 之类的。你懂的，常规物品。造一个这个，就再也不用担心手动充电了。"
		""
		"当然，除非你的能量（powah）耗尽了。"
	]
	quest.1CAB038ED8EA610D.quest_desc: [
		"成功了？！太棒了！我们进展顺利！"
		""
		"拿些&b石头&r，再把它放进&b熔炉&r里烧一次。这样就能做出另一种&b石头&r，即&b平滑石头&r，我们就能用它来进一步推进了！"
	]
	quest.1E432C3C539EC925.quest_desc: [
		"&b简易机械框架&r是&b怜悯机械框架&r的升级版。想造更高级的机器就造一个吧。多造几个又何妨？"
		""
		"如果你想进入&bBlazegloom Goo&r，还需要一个这个，不过我们稍后会再提到。快动手吧！"
	]
	quest.1EA1A74253B238F5.quest_desc: ["放在&b方解石&r上的略带放射性的&b发酵&b蜘蛛眼&r会生成&b铀矿&r！"]
	quest.205DA6AFAC557E2A.quest_desc: [
		"Dire 物品最高等级中的最高级，&b日食合金&r。"
		""
		"用这些东西能做出的装备绝对是顶级的，加上合适的升级，你甚至可以让自己免疫伤害、火焰、坠落，还能获得飞行能力！"
	]
	quest.209226F8CFD2FF7C.quest_desc: ["既然你在这个“下界”里，顺便多拿点&b下界岩&r吧。听说那里还有很多&b骨块&r，也拿点回来！"]
	quest.21ACA8FD46271508.quest_desc: [
		"别灰心，要想获得更高级的机器框架，你需要建造一个&b溶解室&r。为此，你首先需要制作一些&b塑料&r，可以用你刚拿到的&b乳胶&r来制作。这很合理，不是吗！"
		""
		"我保证！"
	]
	quest.2285F83709105747.quest_desc: ["还记得几分钟前制作的&b物品接口&r吗？现在需要把它连接到某些东西上。而这些东西就是线缆！确切地说是&b逻辑线缆&r。多做一些吧，你可能需要用到它们。"]
	quest.232935DF902AC0AA.quest_desc: [
		"你肯定想在某个时候升级装备，而用什么比用&b铁&r更好呢？"
		""
		"那么，富含&b铁&r的来源是什么呢？我来告诉你。是&b红肉&r！没错，可爱的&b牛&r又一次拯救了我们。谢谢你，可爱的&b牛&r。"
		""
		"你还需要一些&b岩质砖块&r，就在你脚下的地面上就能找到！"
	]
	quest.241F24892D422EC9.quest_desc: ["&b钻石&r！是的，用一些&b钻石&r给自己充能，制作&b尼奥晶体&r。这将让你达到更高阶的 Powah 生产水平。更高阶 = 更多 Powah！"]
	quest.254D1BEB5F60C273.quest_desc: ["好，跟上我。还记得前两个抽屉能放2048个物品吗？这个也一样！不过这次最多能存4种不同的物品，每种512个。"]
	quest.25FC9DFDDE9D9A8C.quest_desc: [
		"该找点&b红色染料&r了。幸运的是，有好几种方法可以获得——&b罂粟&r、&b甜菜根&r、&b玫瑰丛&r。我建议你最好还是弄个农场来种植。"
		""
		"你还需要大量的&b红砂岩&r。可以在最近的&b恶地生物群系&r中找到&b红砂岩&r，或者用你选择的&b挤压器&r或&b磨坊&r来粉碎&b陶瓦&r。运气好的话，你甚至能在世界里的&b红沙&r下找到藏着的&b红砂岩&r！"
		""
		"收集够了之后，回来找我吧。我会在这里等你的！"
	]
	quest.2BBE4F9E4A61B988.quest_desc: [
		"你知道那些又高又浅蓝色的树吗？它们可有用啦！其实，你能为它们做各种奇妙的事情。比如建造一个储物系统！就像我们现在要做的这样！现场直播！还有彩色画面！"
		""
		"在继续之前，你需要先制作一些东西。这些东西很重要，所以请务必集中注意力。没错，就是你！"
	]
	quest.2C6EB5919C65157A.quest_desc: [
		"你可能得为这个任务做点准备，因为接下来要打一些 boss 了。"
		""
		"需要&b下界之星&r、&b烈焰块&r和&b红石块&r。还需要大量的RF！"
		""
		"哦，但你将会看到的回报！这一切都值得，我保证！"
	]
	quest.2CF98E41BF91E172.quest_desc: ["如果看不到里面的东西，AE2 系统还有什么用？"]
	quest.2D0190B5AFB7EF1F.quest_desc: ["想让你的抽屉永不爆满吗？来做一个这个！一旦抽屉达到上限，这张卡就会确保多余的物品被丢弃。非常适合当你拥有的东西多到永远都用不完的时候。"]
	quest.2EE1D64AFC7ACCE5.quest_desc: [
		"我们的意思是，需要把东西运送到别的维度。为此，我们需要一个&b次元箱子&r。但你还需要一个&b次元储罐&r。那是用来跨维度运输液体的，众所周知，人体大约70%都是液体！"
		""
		"别想太多，直接制作一个 &b次元储罐&r 和 &b次元箱子&r 就行了！"
	]
	quest.306BBC2715EEF07A.quest_desc: [
		"&b虚空闪耀凝胶&r需要一点功夫。你得去末地，击败那里的巨型巨龙，并在战斗中收集它的&b龙息&r，用来制作下一级的凝胶。"
		""
		"继续前进！只剩下最后一个了！"
	]
	quest.3074E32F11066B3A.quest_desc: [
		"眼前这个小家伙可大有用处。它就是&bSophisticated Storage Controller&r。你可以把任意数量的&bSophisticated Chests&r、&bBarrels&r、&bShulker Boxes&r和&bBackapcks&r连接到这个宝贝上，它们会自动链接到你的存储系统（当然前提是它们之间相互连接）。"
		""
		"你需要用&bStorage Tool&r来完成上述的链接操作，它能让你锁定存储容器、开关显示屏，以及，惊喜，将存储容器与控制器进行链接/取消链接。"
	]
	quest.312BDD942CB50EAA.quest_desc: [
		"还跟得上吗？太棒了！"
		""
		"右键点击 &b安山岩&r，并使用 &bMenril 碎片&r 来制作一个 &b青金石块&r，然后破坏这个 &b青金石块&r 就能收获丰厚的回报了。"
	]
	quest.319040C0145ADE7C.quest_desc: [
		"已经拿到 &b鹅卵石&r 了吗？真快。"
		""
		"我建议你现在做些新工具，用石头做的。这将带你进入下一阶段，届时一切都会真正加速！"
	]
	quest.33D6DFE0C629D53F.quest_desc: ["You know how in the olden days, you used to have to jump on this thing to make it work? Well, we can enlist something else to do the jumping for us! Pop one of these guys on top of the &bSqueezer&r, then use a &bButton&r or &bLever&r to get it up in the air. While it's in the air, shift right click the other &bArmor Stand&r onto the &bSqueezer&r and  then with some clever &bRedstone&r (a clock or an observer will do nicely) you can auto reset the &bSqueezer&r and fling the &bArmor Stands&r into the air on a loop!"]
	quest.34DC4EABAE6102A6.quest_desc: [
		"好吧，所以&b虚空底盘&r才是Ender IO机器的基石。我刚才说错了。"
		""
		"制作一些这些来制造一些酷炫的机器吧！"
	]
	quest.353080FB3F7DF27F.quest_desc: ["这个抽屉和上一个一样。它能装2048个物品，但你可以把两种不同的东西存在里面！太酷了！"]
	quest.35AFC02F66924F27.quest_desc: ["所有&b功能性抽屉&r都有升级。有许多等级，每个等级的容量基本上是前一级的两倍。从这里开始，使用&b铜制升级&r将基础存储量翻倍，如果想继续升级，尽管尝试！"]
	quest.363CC56EDAF6419B.quest_desc: [
		"我们正在建造的这台机器需要大量的电力。非常多。所以我们需要两个电源作为冗余备份。"
		""
		"其中一个来自 Powah，另一个（这个）来自 Applied Energistics。把两者都运行起来，我们就再也不用担心电力不足了！"
	]
	quest.363FAF8F0220A5CC.quest_desc: ["制作一个&b熔炉&r能帮你后期获得更好的材料，但目前也能用来烹饪食物。随着进度，我们会有更快更好的选择，但这个基础的熔炉足以让我们起步了。"]
	quest.393D7A5EB9814B7B.quest_desc: [
		"之前，你需要制作一些 &b变量卡&r。将其中一张带到 &b逻辑编程器&r，然后在左侧选择“配方”。"
		""
		"在出现的合成框中，顶部和右侧各放三个 &bGravels&r，中间放一个 &bFlint&r。然后，将你的 &bVariable Card&r 放入右下角的绿色对勾处。"
		""
		"恭喜你，做出了第一个自动合成配方！把它放进你之前制作的&b合成界面&r里，然后检查你的存储系统，你应该就能自动制作出&b燧石&r了！"
		""
		"以后想自动制作什么，就重复这个过程就行了！"
	]
	quest.3A0954BAC3FCC9AE.quest_desc: [
		"&b以太气体&r。这个需要花点心思来规划。"
		""
		"世界上有个叫凋零的 boss。如果能困住一个，然后在它头顶放个&b钻头&r，你就能收割它来获取一些&b以太气体&r。建议用抗凋零材料建个密室，你肯定还需要一个&b停滞室&r和大量能量来困住它。收集气体来制作&b至尊机械框架&r！"
	]
	quest.3A4D33EDC5BDB457.quest_desc: [
		"&bMagmator&r 使用 &bLava&r 来产生 RF。如果你有办法获得大量 &bLava&r（比如某种储罐），那么这可能是一个不错的选择。"
		""
		"这台机器的顶层每刻能输出40,000RF。相当好用！"
	]
	quest.3AD84B704C9E0FA7.quest_desc: [
		"经过数千年压缩的&b钻石&r，不过是&b煤炭&r罢了？"
		""
		"好吧，我们没有上千年，但我们有无数的 &b煤炭&r。制作一个 &b压缩煤炭块&r，然后用一堆 &b深板岩&r 来换取下一批矿石！"
	]
	quest.3B4BE2A8B59E0181.quest_desc: [
		"啊，&bFerricore&r。这东西真不错，是铁的好东西。"
		""
		"将一些&b铁块&r放在你刚制作的&bPrimogel Goo&r方块上，它就会转化为&bFerricore Ore&r。然后你可以在任何&b熔炉&r中将其熔炼成锭！"
		""
		"如果开启了着色器，在生效前会看起来像什么都没发生。关闭着色器，就能看到整个过程！"
	]
	quest.3BADDEDCA6125511.quest_desc: [
		"你也可以将&b合成界面&r指向一个&b箱子&r，将所需物品送入箱子，再由其他机器（如Xnet）处理。如果你有能将成品物品回收的&b导入器&r，系统会识别出合成完成。"
		""
		"你还可以使用&b变量存储&r和其他一些技巧，来设置特定物品在背包中保持一定数量。多尝试一下，用你&b阿卡夏典籍&r里的&a《论整合动力学》&r来深入了解这个模组！"
	]
	quest.3C0332E742535895.quest_desc: ["木材，现在有树莓口味了！"]
	quest.3C936149A45663B0.quest_desc: [
		"&bCelestigems&r 可用于制作更高级的机器、盔甲和武器，但请注意，它们并不便宜。"
		""
		"也许你在旅途中见过一些地牢，并在下层找到了许多&b钻石&r装备？我建议用一部分装备去你的&b废料回收机&r（还记得那玩意儿吗？）里回收里面的&b钻石&r，这样会轻松一点。否则，我希望你已经自动化了&b煤炭&r的生产，并且产量巨大。"
	]
	quest.3D09913257A3B16D.quest_desc: ["魔法发生的地方。或者至少是魔法最终出现的地方。谜题的最后一片拼图，机器的输出槽！"]
	quest.3DAD9766E1582662.quest_desc: ["眼前这个小家伙，可能是便携存储史上迄今为止最方便的升级了。"]
	quest.3DB0765B4AA72713.quest_desc: [
		"把你产生的所有电力储存起来是个好主意。这家伙就是干这个的。"
		""
		"基础款可存储 4,000 RF，最高级可存储 2,000,000 RF。用它作为发电装置和机器之间的缓冲，如果发电机因故耗尽 Powah，能量单元能维持机器继续运行一段时间。"
	]
	quest.3DDD642331291AE3.quest_desc: [
		"如果你看到这些物品散落一地，就捡起来。多捡几个！"
		""
		"用这些工具之一敲击&b钻石原矿块&r，它就会变成所有方块中最珍贵的……&b绿宝石&r！"
	]
	quest.3E05B407B9296A54.quest_desc: [
		"你之前做过其中一个吗？太棒了！再做一个吧！"
		""
		"这是粘合我们最终的多方块机器两半部分的胶水！请制作一个。"
	]
	quest.3F7FD3F5FE967616.quest_desc: [
		"现在，把那个 &b金&r 砸到 &b玄武岩&r 上，制作你的第一块 &b远古残骸&r！"
		""
		"恭喜你！你已经掌握了矿石生成！"
	]
	quest.3FBA40690AE6D713.quest_desc: [
		"现在你应该已经基本掌握了这个过程。但以防万一，我们再重复一遍。"
		""
		"这次，你需要一些&bMenril Chunks&r——可以从遍布各地的蓝色树木上获得。现在，去弄一堆&bAndesite&r，制作一个&bStone Generator&r来无限获取&bAndesite&r方块。"
	]
	quest.3FCCA87A14EF1A85.quest_desc: ["这个&b太阳能电池板&r能被动地从太阳获取能量！当然缺点是，它在夜间无法发电。同样，顶层的电池板每刻最多只能产生2000RF，但可以组合在一起组成大型Powah阵列。"]
	quest.40AB1EB0FC3F32E4.quest_desc: [
		"看到周围有散落的&b绿宝石&r吗？也给它们充能吧！但这需要大量的能量！"
		""
		"这将让你比以往任何时候都更快地获得更多 Powah！"
	]
	quest.45452869BA09634F.quest_desc: ["&bModular Routers&r 可用于自动化许多事情。这次，我们需要两个来建造我们奇妙的机器。"]
	quest.463D2805F0CBA322.quest_desc: [
		"这个小东西可以把其他小东西升级成更好或更大的小东西。你需要用它来升级 Powah 套装里的一些物品。快去制作吧！"
		""
		"顺便一提，你也可以通过给物品在方块形态下充能来加快进度！"
	]
	quest.467E30E27BCD16F1.quest_desc: ["如果你在地下挖了很深的洞，看到了叫“基岩”的条纹方块，可以在上面放些&b红石&r，再放一个&b黑曜石方块&r在上方，左键点击它，就能制作出&b通量粉尘&r！"]
	quest.47EB85DD0031881C.quest_desc: [
		"需要传输能量吗？制作一些这些吧！"
		""
		"这是基础层级，更高层级可更快地传输更多能量。"
		""
		"而且你可以在同一个方块空间里放置好几个这样的东西！"
	]
	quest.4854E1161D03BC88.quest_desc: [
		"想自动合成东西吗？可以！某种程度上。不，完全可以。某种程度上。"
		""
		"总之，你需要将其中一个连接到&b逻辑线缆&r上，指向一个&b工作台&r（或储物箱），以便使用你的Integrated Dynamics Storage System (TM)自动合成物品"
	]
	quest.48F9B8BD9358A743.quest_desc: ["我知道这看起来很好吃，但相信我，不要把它吃掉。"]
	quest.4B96DC802C8FDF82.quest_desc: [
		"好了，我们开始吧。这个过程会有点长，所以我会慢慢来。"
		""
		"首先，你需要一些&b原木&r。任何&b原木&r都可以。用手撸一个就行，工具的事我们稍后再解决。"
	]
	quest.4BB4152EEB3DE69E.quest_desc: [
		"就像用&bFerricore&r能造一堆酷炫玩意儿一样，用&bBlazegold&r能造更酷的！制作过程和&bFerricore&r一样，只是用&b金块&r代替，然后看看用途！你需要这些来制作&b高级机械框架&r，而你需要那些来制作下一级的Goo。"
		""
		"祝你好运！"
	]
	quest.4C8C312A667C43C8.quest_desc: [
		"我们正在飞行！离把大家带回家的目标又近了一步！"
		""
		"继续收集那些&b至尊机械框架&r，你很快就会需要它们的！"
	]
	quest.4EFAC50CC365FB5C.quest_desc: [
		"&bConduit Binder Composite&r 是 Ender IO 导管的基础。无论你打算制作哪种导管，都需要一些这个。"
		""
		"Ender IO 有各种各样的导管可以用，所以先做些东西，然后用 &bFurnace&r（或者你的 &bAlloy Smelter&r）把它炼成 &bConduit Binder&r。"
	]
	quest.4F4E68A3EBA3CA21.quest_desc: [
		"就是它了！最终的机器！我们一直以来为之努力的目标！"
		""
		"制作一个&b控制器&r（点击上方的控制器查看配方），我就会把它换成&b村民召唤器&r！"
		""
		"没错，打倒这个坏家伙，用&bBlueprint&r砸它，然后组装起来。一切就绪后，村民们就会开始回来了！"
		""
		"每30秒，我们当中一人就会被传送回原来的家！"
	]
	quest.4FA0172B9B390474.quest_desc: [
		"储物？用箱子？你把我当什么土包子了？！"
		""
		"不过，你得先做一个&bInscriber&r。有了它，你的AE2系统才能真正大放异彩！"
	]
	quest.502A773FAC56BB2D.quest_desc: [
		"啊，朴实的&b箱子&r。矿工和工匠所有储物设施的中流砥柱！"
		""
		"从现在开始，你有多种选择来整理你的储物空间，但一切都要从这里开始！"
	]
	quest.5204B29825161326.quest_desc: [
		"我听说过一个叫“下界”的地方。听起来像是编的。"
		""
		"反正去那儿一趟，拿点&bGlowstone&r和一堆&bBlackstone&r，我待会儿在这儿等你。"
		""
		"准备好了吗？开始挖掘！"
	]
	quest.538A09875DB3E71D.quest_desc: ["Flux Network 还是 Powah？"]
	quest.538A09875DB3E71D.title: "为自己注入力量"
	quest.539CDBE232559A4F.quest_desc: ["好，要制作这台机器，你需要一些这些东西。不过要小心，为了制作它，你会遇到一个相当愤怒的家伙。"]
	quest.53F18385D78EB035.quest_desc: [
		"总有一天，你需要为自己制造一些 Powah。我们将用巧思——以及干掉一堆蜘蛛来完成！"
		""
		"弄个&b蜘蛛眼&r，发酵一下，再加点&b方解石&r。它在野外，我保证。"
	]
	quest.55783B00E36A4AAE.quest_desc: [
		"你应该已经注意到，到处都没有&b煤炭&r了——都被机器人拿走了。目前你唯一的燃料来源是木头，就像你之前拿的那些&b原木&r一样。"
		""
		"幸运的是，那些&b原木&r不仅仅是廉价易再生的燃料：你还可以燃烧它们来制作&b木炭&r，而&b木炭&r比单独的&b原木&r要好得多！"
	]
	quest.55C2222EF7EF00B8.quest_desc: [
		"跟上我的思路，因为这听起来可能很疯狂。箱子里的怪物。惊不惊喜？"
		""
		"制作其中一个箱子，把之前得到的卡片放进去，它就会开始产出能帮助你继续前进的物品！"
		""
		"我建议你尽快找到一张&b牛&r卡，但还有几张卡会在你的旅途中提供帮助。把它们都收集起来吧！(tm)"
	]
	quest.576BBC8B603DD337.quest_desc: [
		"生物农场在本教材的其他部分已有介绍。如需更多信息，请查阅相关内容。"
		""
		"我们的最终机器需要几个这个。希望你已经知道怎么制作&b下界合金&r了！"
	]
	quest.57E8A98DD1DD57FD.quest_desc: [
		"你可以用&bMob Slaughter Factory&r来生成&bPink Slime&r。它可以替代普通的绿色史莱姆，但为什么要这么做呢？简直是疯了！"
		""
		"弄一桶这个，倒在地上就能得到一只&b粉红史莱姆&r。在它跑掉前抓住它！或者准备好水桶，在&b溶解室&r里用它制作一个&b高级机械框架&r。"
	]
	quest.58B07F8EFFFFD0BF.quest_desc: ["要制作本模组的一些物品，你需要一个&bSqueezer&r。就是用来挤压的。制作一个这个和一个&bDrying Basin&r，准备好下一步了就来告诉我！"]
	quest.5A5EF50C159DDB3E.quest_desc: ["这台机器利用不同热源来产生 Powah。往里面注水，并在下方放置一些 &bLava&r，它就能被动地产生 Powah。不过，它在高级阶段的表现不如其他机器，最高等级时每刻仅能产生 2,000 RF。"]
	quest.5B2FD1962F1354E8.quest_desc: [
		"我会用 Powah 教你基础生成方法。所有这些机器都可以升级到更高级别以获得更好的产出。相信你能用 JEI 弄清楚怎么做。"
		""
		"这家伙通过燃烧&b煤炭&r来制造Powah。你可能已经设置了自动&b煤炭&r装置，所以这台机器应该很简单。基础机器只能产生少量Powah，但最高级的机器每刻能产生40,000 RF！"
	]
	quest.5D62DE4375A3FEBB.quest_desc: ["升级你的&b银行&r，就能存更多东西！更多堆叠的东西！太棒了！"]
	quest.5D78A9540D4FDB2C.quest_desc: [
		"升级继续滚滚来。这次是&b铁&r，带来更多物品和更多堆叠！"
		""
		"你还可以给&b银行&r添加更多升级。别管我，尽管把它建得又大又壮。"
	]
	quest.5E08463F2739AEDD.quest_desc: ["不给系统配方，就无法自动合成任何东西。配方存储在&bPatterns&r中。你肯定要做很多自动化，所以需要几个&bPatterns&r，那就来做十几个吧。减去两个。这叫“Newstone dozen”！(Pattern Pending - 喜欢/不喜欢这个笑话就跟Bevarin说吧)"]
	quest.5E921DEE8BFD75A5.quest_desc: [
		"需要运输流体吗？制作一些这些吧！"
		""
		"请注意，你可能不想用这根管道运输&b岩浆&r。有更高级的管道可供选择。"
	]
	quest.60334DDB85D5662D.quest_desc: [
		"真可怜，这个机器框架！"
		""
		"抱歉。我也不知道自己是怎么了，突然就那样了。"
		""
		"总之，要想使用 Industrial Foregoing（以及其他几个模组），你需要先制作一些 &bMachine Frames&r。我们先从 &bPity Machine Frame&r 开始。你需要它来生产 &bLatex&r，用于制造 &bRubber&r 和 &bPlastic&r，而如果你想自动化某些流程——比如 mob farm——就需要用到 &bPlastic&r。"
	]
	quest.60845C1479A6E29D.quest_desc: ["底层的&bReactor&r每秒可输出1,000 RF，而顶层的每秒可输出500,000 RF。这显然是最佳选择，但建造和维持运行成本也最高。"]
	quest.627D8762F9AD4E98.quest_desc: [
		"将&bMenril原木&r放入&bSqueezer&r（自动或非自动）中，对准&bSqueezer&r和&bDrying Basin&r中间的管道，即可生成一块&bCrystalized Menril&r。"
		""
		"等它晾干，然后去拿点 &b晶化曼里尔&r！"
	]
	quest.63778C604341452A.quest_desc: ["你可能会注意到，在野外与机器人战斗时，它们有时会掉落这种卡片。如果掉了，不要丢弃。把它收好，将来可能会派上用场！"]
	quest.640D84A511D8C4AA.quest_desc: [
		"如果对 Integrated Dynamics 存储系统不满意，可以改用更强大的 AE2 系统。闲逛时看到陨石了吗？去陨石群中央，让你的 AE2 系统真正运转起来。"
		""
		"最终，你会想用AE2自动合成物品。为此你需要这些。请完成此任务。"
	]
	quest.64ACF192810361FC.quest_desc: ["现在用你的&b压缩&b煤炭&r块&r砸向&b深层岩&r，就能跳过数千年直接制造&b钻石&r！"]
	quest.66792995242B2112.quest_desc: ["你之前制作的&bBlock Generators&r也是我们最终机器所需的组件。制作两个并添加到这个列表中。"]
	quest.67EAD9CE78F79319.quest_desc: [
		"拿上你之前找到的&b含铁牛肉&r，对着一些&b凝结核&r右键。你应该会得到一些不错的、可爱的&b铁矿石&r。"
		""
		"把它打碎，拿到 &bRaw &bIron&r，这样我们就万事俱备了！"
	]
	quest.6805031225D109E4.quest_desc: [
		"这些主要是作为装饰放在最后的机器里的。但它们看起来真不错！"
		""
		"你需要6个，它们会从结构上把整台机器固定住。所以终究还是功能性部件，而非装饰。"
	]
	quest.686AD58469D60BE2.quest_desc: ["&b萤石&r和&b黑石&r能合成&b金矿石&r！你已经知道流程了！"]
	quest.69C10526FDC82FF1.quest_desc: [
		"有足够多的&b原木&r吗？太棒了！来把它们分解成木板，做一个&b工作台&r吧。这东西会是接下来一段时间你最好的伙伴，所以习惯一下吧！"
		""
		"做好之后，你需要一些基础工具。先从一把&b镐&r开始吧。木制镐就能让你顺利起步。用它能去弄点&b鹅卵石&r！"
	]
	quest.6A33F299EA6E9F57.quest_desc: [
		"如果你找到了这本书，说明我们的时间到了。世界已被机器占领，我们的殖民地别无选择，只能离开。你所处的定居点，曾是我们引以为傲的家园——&6Newstone Hollow&r。"
		""
		"{@pagebreak}"
		"这里的土地曾一度肥沃，洞穴里也满是珍贵的矿石。但后来，一支机器大军席卷而来，几乎掠夺了所有资源。它们吞噬了我们的庄稼，拆解了我们的装备，还挖走了我们脚下的金属。最后，它们只给我们留下了尘埃和废墟。"
		""
		"但是……我有个计划。重建所有失去之物的蓝图。一个比从前更宏大、更美好的新&6Newstone Hollow&r的愿景。在实现这个梦想之前，我们必须离开，但我留下了这本书，留给任何可能发现这片文明遗迹的人。"
		""
		"{@pagebreak}"
		"若你找到此记录，便以此为指导。锻造新机器，收复土地，让这个破碎的世界再次繁荣。用你的双手，让第二个&6Newstone Hollow&r的种子生根发芽。"
	]
	quest.6A33F299EA6E9F57.quest_subtitle: "我们伟大之处的幽灵"
	quest.6ACDFA92314B29BF.quest_desc: [
		"这个有点牵强，请跟上我的思路：&b花岗岩&r和&b蜂蜜瓶&r。"
		""
		"我们需要这两种材料各一些，所以重复制作石头的步骤，但将 &bTriple Compressed Stone&r 替换为 &bTriple Compressed &bGranite&r。其他步骤都相同！"
	]
	quest.6B0C0F3BF7F62D14.quest_desc: ["&b下界岩&r和&b骨块&r能合成&b石英&r！这个很重要。如果可以的话，尽量保持这个配方吧。"]
	quest.6C19D96CD0EC20B2.quest_desc: ["&bFlux Cores&r are made using &bFlux Dust&r and some other bits and pieces. You'll need them to make the Flux Networks work. If you send some of your Powah into this baby, you'll be able to bypass those cables you made earlier and have true wireless power for your machines."]
	quest.6EE96F930ABAB866.quest_desc: ["想解锁更高级的 Powah 机器，就得开始制作这些东西了。回到“下界”去弄点 &b烈焰棒&r。这个任务需要它们！"]
	quest.6EEC8470B772ADE0.quest_desc: [
		"Sophisticated Storage。原版存储的更优雅版本。如果你能掌握这个模组，你会惊讶自己以前为什么还用别的！"
		""
		"先制作一个&bSophisticated Chest&r。随便一个&bChest&r就行。可以用&bChest&r和&bRedstone Torch&r组合，或者在普通&bChest&r的配方中间放一个来跳过步骤。"
	]
	quest.6EEC8470B772ADE0.title: "基础复杂化模组 (Basic Sophistication)"
	quest.6FC9C4EA03935AEF.quest_desc: [
		"&b纸&r还是&b塑料&r？希望是&b塑料&r，因为我们的方向就是那里。"
		""
		"用你刚做的&bPity Machine Frame&r制作一个&bFluid Extractor&r，把它放在原木旁边。它会抽出&bLatex&r，最终你会得到一桶。快去拿！"
	]
	quest.703DBA1F787C4AE7.quest_desc: [
		"还记得我之前说你会有很多用不完的&b石头&r吗？原因如下：&b石头生成器&r几乎能凭空造出石头！当然，需要一点&b岩浆&r和&b水&r，还有一个&b三倍压缩的石头块&r。为什么要三倍压缩？用更少的可不行！"
		""
		"把压缩块放在发电机下面，一边放一桶水，另一边放一桶岩浆。搞定，免费石头！"
		""
		"然后，你需要一些&b燧石&r。你可以通过挖掘一些&b沙砾&r（如果运气好的话）或者在&b工作台&r里用三个&b沙砾&r合成。还记得那个东西吗！？"
	]
	quest.70A1FBB484C19C8A.quest_desc: [
		"升级的第一步，是将一些 &b金&r和&b铁&r投入你的&b能量球&r，将其转化为&b能量钢&r。"
		""
		"然后你就可以用那个 &bEnergized Steel&r 在 Powah 系列里制作其他东西了。拼写是这么拼的吧？凑合用吧。"
	]
	quest.72D31DDB8ED2D8EB.quest_desc: [
		"想找个地方存放你收集的所有好东西吗？给自己建个&b银行码头&r吧，伙计！"
		""
		"这个小宝贝可以直接从你的&b银行&r自动导入物品，并帮你存入存储系统！"
	]
	quest.74DA7CC368174109.quest_desc: ["&bFunctional Storage Controller&r 和 &bSophisticated Controller&r 的工作原理差不多。给这东西装上存储连接器，再用链接工具把一些 &bDrawers&r 连起来，你就能访问里面的所有东西了。真棒！"]
	quest.75EC43EFD883A9E3.quest_desc: ["想在哪里合成，就在哪里合成！"]
	quest.7CAE333CB8721853.quest_desc: ["你可以在这里设置自动合成器所需的配方，让它自动合成。逻辑上说得通！"]
	quest.7D708C05F94D4748.quest_desc: ["Functional Storage 让功能性存储充满乐趣。还记得过去能制作抽屉来存放物品的日子吗？现在依然可以！没错，这个小家伙在默认配置下最多能存放 2048 个物品。快给自己做一个吧。最好多做几个，你一定会用得上的！"]
	quest.7E6CA7E720B81BA6.quest_desc: [
		"为了制造更多的 Powah，你需要几个这样的坏家伙。为什么从来没人提到好家伙呢？"
		""
		"算了，我们还是专心手头的事，做些介电外壳，好继续过我们的日子。"
	]
	quest.7EAEB150A6816327.quest_desc: ["需要储存大量流体并方便取用吗？制作一个这个吧。甚至还有能生成无限特定流体的升级组件。非常方便！"]
	quest.7ECE99AD03E6A6B6.quest_desc: [
		"这个小家伙可以连接到你的存储系统。你可以用笨办法，把其中一个放在每个 &bChest&r 或 &bBarrel&r 上，或者如果你有 &bSophisticated Storage Controller&r 或 &bFunctional Storage Controller&r，可以把其中一个连接到控制器上，这样它就会链接到所有连接到该控制器的物品！"
		""
		"简单！"
	]
	task.273B2F9BDD1049AF.title: "任何 #minecraft:&bLogs&r"
	task.28F8EA0265591C00.title: "为自己注入力量"
	task.3FCD8876E933AFFD.title: "始于末地"
