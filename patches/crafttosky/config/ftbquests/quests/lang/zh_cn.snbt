	quest.0171E1AA341A00AC.title: "开端"
	quest.06D5D142DC696A57.quest_desc: ["希望你找到了一个好的堡垒遗迹。"]
	quest.06D5D142DC696A57.title: "用残骸将我覆盖起来"
	quest.0B3DED5FDBE76C4B.quest_desc: ["在虚空之中，会生成各种具有特定生物群系材料的岛屿。制作探险家指南针是找到这些岛屿的关键。"]
	quest.0B3DED5FDBE76C4B.title: "我这是要去哪儿？"
	quest.0D5065CB5C055108.quest_desc: ["运气太差？把最后一棵树苗献给虚空神了？别担心！在右侧边栏，每5分钟就能领取一棵应急树苗！"]
	quest.0F9B56B65C035B64.quest_desc: [
		"获得额外岩浆源的方法有好几种。最简单的是使用尖顶滴水石笋（获取方法请参见相关任务线）。"
		""
		"如果你还没有钻石，可以用岩浆铸造来建造传送门！"
	]
	quest.0F9B56B65C035B64.title: "下界"
	quest.1273A09C29AE7986.quest_desc: ["欢迎来到 CraftToMuck 天空方块体验第三季！我们非常期待你尝试我们为你准备的内容。这本任务书将作为各种天空方块机制的指南。"]
	quest.1273A09C29AE7986.title: "欢迎！"
	quest.1558D906A4284256.quest_desc: ["你的第一个灵魂沙来源将在这里。"]
	quest.1558D906A4284256.title: "灵魂沙山谷"
	quest.1C17A3CB68C919C7.quest_desc: [
		"我们添加了天空虚空内容，用于获取一些更稀有的材料。更多信息请查看下方的数据包页面！"
		""
		"https://modrinth.com/datapack/sky-void-additions"
	]
	quest.1C8A38A07D3E3E13.quest_desc: ["砰！典型的创造模式机器。"]
	quest.1FEF23633C064C17.quest_desc: ["和往常一样，僵尸偶尔会掉落铁锭。"]
	quest.21E1657382282299.quest_desc: ["古代城市里有许多宝藏箱，对你的空岛之旅很有帮助。"]
	quest.21E1657382282299.title: "远古城市"
	quest.28D5F0AB1D9B2563.quest_desc: ["厌倦了杀僵尸？可以洗洗砾石，有小几率获得铁粒。"]
	quest.2A2B5DC3AF37B5B8.quest_desc: ["要开始冒险，运行 &n/skyblock create&r 来创建岛屿。你也可以用 &n/skyblock invite&r 邀请玩家加入你的 Skyblock 团队。这些操作也可以通过 Sky GUI 完成（查看你的按键绑定）。"]
	quest.2A2B5DC3AF37B5B8.title: "欢迎回家"
	quest.2A971B159B5151CB.quest_desc: ["灵魂沙。"]
	quest.2C96ADBD0F8A1E72.quest_desc: ["在天空方块世界中，生物会神秘地掉落所需资源。建造生物农场对推进进度至关重要。"]
	quest.2D07CA89E6E804BA.quest_desc: ["石匠也会出售尖刺滴水石，作为二级交易物品。"]
	quest.2D07CA89E6E804BA.title: "石匠 (Stone Mason)"
	quest.2E767C538E3839A6.quest_desc: ["击杀残骸有几率掉落锌锭。"]
	quest.37EB900A0C18452E.quest_desc: ["有了安山岩、铁和锌的基础，你现在可以在创造模式里继续前进了！"]
	quest.37EB900A0C18452E.title: "创造！"
	quest.38DBB313EF1C215E.quest_desc: ["开启你的创造生涯的关键材料。不知为何，僵尸也会掉落这些。"]
	quest.3E97F395936BB733.quest_desc: ["等植物长大太累了？快速蹲在它们旁边，它们就会神秘地长得更快。"]
	quest.43841C24019B0F59.quest_desc: ["前期刷怪。这台机器将是你早期获取砾石和沙子的方法。"]
	quest.49EE67A409438F33.quest_desc: ["清洗沙子有小概率获得黏土。"]
	quest.4F0B8D2935EF7C7E.quest_desc: [
		"希望你还保留着岩浆源。可以用尖石笋来获取额外的岩浆源方块。"
		""
		"尖顶滴水石笋可以在滴水石笋洞穴岛屿中找到。"
	]
