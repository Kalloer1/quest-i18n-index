	quests: [
		{
			dependencies: ["670D513724E5AA6D"]
			description: ["Калейдит — особый минерал, он является составной частью разных нитей эпотари с различных миров и способный разрывать ткань пространства, создавая новые разломы."]
			hide_dependency_lines: false
			id: "50282FE6A8ADE6DE"
			rewards: [
				{
					id: "6AA0D00D44262A34"
					item: "multiverse:kaleidite_core"
					type: "item"
				}
				{
					id: "784174DE8E4274CB"
					type: "xp"
					xp: 100
				}
			]
			subtitle: "Найдите 10 осколков калейдоскопа"
			tasks: [{
				count: 10L
				id: "53ED2019AB85E31F"
				item: "multiverse:kaleidite_shard"
				type: "item"
			}]
			title: "闪闪发光的东西！"
			x: 2.5d
			y: -2.0d
		}
		{
			description: ["Разломы — уникальная особенность этого мира. Они появились из-за «Столкновения Эпох». Вселенная состоит из тончайших нитей эпотари, которые были проводниками энергии и жизненных сил, но «Столкновение Эпох» нарушило целостность этих нитей, словно смяв тканевый лоскут, из-за чего все нити соприкоснулись, вызвав разломы, позволяющие попасть в любую часть этого лоскута."]
			hide_dependency_lines: false
			hide_dependent_lines: true
			icon: "multiverse:kaleidite_cluster"
			id: "670D513724E5AA6D"
			rewards: [{
				id: "02686DA23F9E6AB4"
				type: "xp"
				xp: 100
			}]
			shape: "diamond"
			size: 1.35d
			subtitle: "Посетите свой первый разлом (первый разлом)"
			tasks: [{
				advancement: "multiverse:multiverse"
				criterion: ""
				id: "3E0259A7B44F5ECF"
				type: "advancement"
			}]
			title: "В разлом!"
			x: 0.0d
			y: -1.0d
		}
		{
			dependencies: ["670D513724E5AA6D"]
			description: ["Травлер — путешественник по измерениям, ищущий своих двойников. Его движет лишь тотальный контроль над разломами, поэтому он создал призму, которая помогала ему в этом, и именно поэтому он не любит, когда кто-то еще заходит или ошивается возле разломов. Кто знает, встретите ли вы его лично... или очередного его двойника?"]
			hide_dependency_lines: false
