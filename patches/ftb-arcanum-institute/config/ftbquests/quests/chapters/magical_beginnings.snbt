	quests: [
		{
			title: "欢迎来到阿卡努姆研究所"
			x: 0.0d
			y: -7.9910714285714235d
			shape: "pentagon"
			subtitle: "魔法与知识的领域在此交织融合！"
			description: [
				"亲爱的新生们，"
				""
				"我们深感荣幸地邀请您加入这支精英学生团体，他们因卓越的潜力和对神秘学的不懈热情而被选中。您是少数被赋予踏上非凡魔法之旅机会的人之一。"
				""
				"古老的城墙之外，是一片庇护所，古老的技艺与魔法的精髓正等待着你。在这里，现实与想象交织，为你提供画布，以编织你魔法的宏图，探索神秘知识的奥义。"
				""
				"加入阿卡努姆学院，一场非凡的冒险就此开启。与同伴们集结——一群像你一样，拥有独特火花、注定照亮伟大之路的精英。"
				""
				"准备好踏入一个充满惊奇与魔法的世界吧。"
				""
				"期待着即将到来的魔法之旅，心潮澎湃；"
				""
				"校长塔兹 (Headmaster Tazz)"
			]
			size: 1.5d
			min_width: 300
			id: "68F3DB988DCED32C"
			tasks: [{
