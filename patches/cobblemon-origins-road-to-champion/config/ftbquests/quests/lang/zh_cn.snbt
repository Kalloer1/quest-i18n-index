	quest.446A36EA3288178F.quest_desc: [
		"寻找&e雷石矿石&r：它生成于高地和丘陵，较少生成于丛林和平原。"
		"看深板岩层上方的普通石头变种。"
		""
		"&a宝可梦提示：&r这种石头能让皮卡丘、电磁兽和伊布等宝可梦进化。"
	]
	quest.446A36EA3288178F.title: "雷石矿石"
	quest.446BCC92D233AD28.quest_desc: [
		"&6价格：&r &e3,000 CobbleDollars&r 一个。"
		""
		"没有任何效果"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.446BCC92D233AD28.quest_subtitle: "3,000 冷却时间"
	quest.446BCC92D233AD28.title: "净化标签"
	quest.446E86D41DD7D4BF.quest_desc: [
		"赢得任意难度的 &e5&r 次突袭。"
		""
		"只有造成足够伤害以获得奖励的胜利才算数。"
	]
	quest.446E86D41DD7D4BF.quest_subtitle: "5次击败掠夺者营地"
	quest.446E86D41DD7D4BF.title: "突袭新手"
	quest.4471C53FDF18466A.quest_desc: [
		"一个 Cobblemon &ePC&r 和 &e7 块铁锭&r 环绕着一个 &e升级台&r。"
		""
		"添加了&e便携式电脑&r标签页：随时随地交换队伍中的宝可梦，无需返回基地。"
	]
	quest.4471C53FDF18466A.title: "PC 升级"
	quest.447B22D1EC0ABDEE.quest_desc: [
		"每个精灵球都由围绕一个&6核心&r制作的 Apricorns 制成，核心决定了等级：&e铜&r、&e铁&r、&e金&r，然后是&e钻石&r。大多数配方可制作4个球。"
		""
		"特殊球在特定情况下会发光。制作每个球，然后用它捕捉宝可梦。"
		""
		"&a每个球的提示框都列出了其捕获乘数。&r"
	]
	quest.447B22D1EC0ABDEE.quest_subtitle: "阿普里康加一个核心"
	quest.447B22D1EC0ABDEE.title: "&l精灵球工坊"
	quest.447F90FFEFE267D9.quest_desc: [
		"在战斗中击败25只野生&5幽灵&r属性的宝可梦。"
		""
		"&6弱点：&r 黑暗、幽灵"
		"&c抗性：&r 昆虫、中毒"
		"&c免疫于：&r 战斗、普通攻击"
	]
	quest.447F90FFEFE267D9.title: "熄灯派对"
	quest.448A1FE17A9A9C9A.quest_desc: [
		"&eArcher 和 Ariana&r 联手进行一场 &e双人战斗&r：双方各两只宝可梦，所以至少带上两只你自己的。"
		""
		"它们会出现在&e恶地&r、&e稀树草原&r和&c下界&r，与焚焰蚣、哥特小姐、玛丽鲁、盔甲鸟、咬咬龟和天蝎王一同出现。"
	]
	quest.448A1FE17A9A9C9A.quest_subtitle: "火箭管理员弓箭手与阿丽安娜"
	quest.448A1FE17A9A9C9A.title: "双重麻烦"
	quest.448BFA1EE0586EAD.quest_desc: [
		"洋葱圈&eOnion Ring&r也是一种零食。吃一个吧。"
		""
		"&c吃掉它便是单程票：留一个备用的以防万一。&r"
	]
	quest.448BFA1EE0586EAD.title: "冒险家吃货"
	quest.44BF6CD2BA1A6097.quest_desc: [
		"使用&e钻石&r、&e2个金锭&r和&e3个红石&r来升级&e喂食升级&r。"
		""
		"可以控制喂食的时间和内容。"
	]
	quest.44BF6CD2BA1A6097.title: "高级喂食升级模组"
	quest.44CB7371D9648469.quest_desc: [
		"酿造一瓶&b水肺药水&r：粗制药水 + &e河豚&r。"
		""
		"&aQwilfish和Overqwil会掉落Pufferfish。&r"
	]
	quest.44CB7371D9648469.title: "屏住呼吸，保持专注，不要分心。"
	quest.44EE96790577D8DF.quest_desc: [
		"&5末影龙&r会靠岛上塔楼上的&e末地水晶&r回血。先射爆或破坏它们。"
		""
		"当她栖息在中央传送门上时，用你最锋利的剑攻击。她的死亡会开启回家的出口传送门，并生成一个 &eEnd Gateway&r。"
	]
	quest.44EE96790577D8DF.title: "&5屠龙行动"
	quest.450CFE1567457360.quest_desc: [
		"捕捉10只&d超能力&r属性的宝可梦。双属性宝可梦两种属性都算数。"
		""
		"&6强项：&r 战斗、中毒抗性"
	]
	quest.450CFE1567457360.title: "心灵感应者"
	quest.453E8B96C32FBBEA.quest_desc: [
		"在战斗中击败25只野生&e电&r属性宝可梦。"
		""
		"&6弱点：&r地面攻击"
		"&c抗性：&r 电、飞行、钢"
	]
	quest.453E8B96C32FBBEA.title: "短路 (Short Circuit)"
	quest.4549C2EDCE2A9283.quest_desc: [
		"&6价格：&r &e8,000 CobbleDollars&r，共10个。"
		""
		"完全治愈宝可梦的任何状态异常问题"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.4549C2EDCE2A9283.quest_subtitle: "8,000 CD"
	quest.4549C2EDCE2A9283.title: "完全治愈 x10"
	quest.455D3CD5A24555C1.quest_desc: [
		"捕捉任何丰缘地区的御三家宝可梦。"
		""
		"丛林里的&bTreecko&r、平原上的&bTorchic&r、沼泽里的&bMudkip&r以及许多其他地方。"
	]
	quest.455D3CD5A24555C1.title: "小树苗阵容"
	quest.456DCF1FE55D7AEB.quest_desc: ["在温暖的海洋遗迹中刷出一个&eAngler Pottery Sherd&r。Shelter和Snort也藏在那里。"]
	quest.456DCF1FE55D7AEB.title: "钓鱼人陶片"
	quest.4574BFA1970E63F0.quest_desc: ["用贝壳头盔与另一名玩家的卡洛奇（反之亦然）进行交换。交易完成的那一刻，两者都会进化。"]
	quest.4574BFA1970E63F0.title: "公平交换"
	quest.458736D329CE1045.quest_desc: ["在遗迹中刷出一个&e寻路者盔甲饰边&r模板。宿主、提升者和塑形者也来自那里。"]
	quest.458736D329CE1045.title: "寻路者饰边"
	quest.458971EDBD12E541.quest_desc: ["合成&e智慧眼镜&r：三个铁锭和两个玻璃。它们能增强特殊招式，是选择眼镜的核心。"]
	quest.458971EDBD12E541.title: "规格吸引力"
	quest.458A35E3DD54E05D.quest_desc: [
		"杀死 10 个 &e末影人&r。"
		""
		"末影人只有在你对着它们看或攻击它们时才会攻击。在低于两格高的地方战斗，或戴上雕刻南瓜。它们的&e末影珍珠&r会指引你前往末地。"
	]
	quest.458A35E3DD54E05D.title: "高大、深邃、泛着珍珠光泽"
	quest.459042E96D737DF9.quest_desc: [
		"&b卢加神殿&r位于深海。将涡旋石放在祭坛上，然后捕捉&d卢加&r。"
		""
		"&c底座只能使用一次；重试需要一枚Medallion of Renewal。带上Ultra Balls和会使用False Swipe的生物。&r"
		"&a&eSilver Wing&a（大师企业家）持有时，可使 Lugia 的特攻和特防提升 50%。&r"
	]
	quest.459042E96D737DF9.title: "深海守护者"
	quest.45BBC343892EC514.quest_desc: [
		"看一个&e蜂巢&r。它们挂在橡树、桦树和樱花树上。"
		""
		"蜜蜂在花朵和蜂巢之间飞来飞去，蜂巢会随着时间的推移充满蜂蜜。"
	]
	quest.45BBC343892EC514.title: "有什么东西在嗡嗡作响"
	quest.45BDBE29AF12A0E2.quest_desc: [
		"在 &e数据监视器&r 上使用 &e升级&r 或 &e可疑唱片&r。"
		""
		"&o你才不会下载多边兽呢。&r"
	]
	quest.45BDBE29AF12A0E2.title: "技术故障"
	quest.45C0BC6CC4C447BF.quest_desc: [
		"捕捉任何&d传说宝可梦&r，无论是被召唤的还是野生的。野生传说宝可梦是超稀有的个体，通常等级在40到70之间，且大多至少有两个完美的个体值。"
		""
		"&aCobblemon 会通知你附近的传说生物出没，请留意聊天框。&r"
	]
	quest.45C0BC6CC4C447BF.title: "一位传奇人物登场了"
	quest.45DF0C66568D32D7.quest_desc: ["在扭曲世界挖掘&e扭曲起源矿石&r以获取&e原始起源&r，并将其熔炼成&e起源锭&r。回返洞穴的宝库中也有一些。"]
	quest.45DF0C66568D32D7.title: "红色金属"
	quest.45E36386BB463A44.quest_desc: [
		"用 &e8 颗绿宝石&r 环绕一个 &e钻石熔炉&r。"
		""
		"烹饪时间：每件物品&e40 ticks&r。"
		"&a缺少绿宝石？村民用绿宝石来支付作物、羊毛和其他日常用品的费用。&r"
	]
	quest.45E36386BB463A44.title: "Emerald Furnace"
	quest.46115C57BC98239D.quest_desc: [
		"&e4个石头&r、&e2个木板&r、一个&e中继器&r、一个&e金锭&r和一个基础的&e复杂箱子&r或&e桶&r。"
		""
		"属于存储组的一部分：管道可以推入和拉出。单独制作可切换输入/输出（I/O）版本。"
	]
	quest.46115C57BC98239D.title: "存储输入/输出"
	quest.462324CDFBA8DC3D.quest_desc: [
		"合成一个&e重复球&r：用2个红色杏、1个黄色杏和1个黑色杏围绕一个&e金锭&r。"
		""
		"&6捕获率：&r 在宝可梦图鉴中已登记的宝可梦为 3.5 倍。"
	]
	quest.462324CDFBA8DC3D.title: "重复球 (Repeat Ball)"
	quest.462DE4427F1E6270.quest_desc: [
		"用&eSail Fossil&r复活一只&eAmaura&r（岩石/冰）。"
		""
		"在侵蚀柱、冰冻池塘和尖刺、粉末沉积物和埋藏的云杉树下寻找它。"
	]
	quest.462DE4427F1E6270.title: "阿玛乌拉"
	quest.462E9F0014CB49AC.quest_desc: [
		"&6价格：&r &e4,000 CobbleDollars&r 一个。"
		""
		"&a点击对勾购买。可重复购买，仅在你能负担得起时收费。&r"
	]
	quest.462E9F0014CB49AC.quest_subtitle: "4,000 CD"
	quest.462E9F0014CB49AC.title: "发光苔藓"
	quest.4633CAD6CEE015F7.quest_desc: [
		"砍一棵阿普柯恩树，并将其原木制成&e阿普柯恩木板&r。"
		""
		"全套木制物品如下：楼梯、半砖、栅栏、门、活板门、告示牌和船。"
	]
	quest.4633CAD6CEE015F7.title: "Apricorn木工坊"
	quest.463FA1B41C66C255.quest_desc: ["在白天将伊布的友好度提升至160或以上，使其进化。"]
	quest.463FA1B41C66C255.title: "Espeon"
	quest.46615D210C597C09.quest_desc: [
		"&eVivichoke 种子&r 可在史前遗址的可疑方块中挖掘。种植它们，收获 &eVivichoke&r。"
		""
		"它会分解为 Max Revives、Max Potions、Poké Snacks 和 Vivichoke Dip，再合成回种子。"
	]
	quest.46615D210C597C09.title: "远古洋蓟"
	quest.466C93F5A3B8F5C9.quest_desc: [
		"你的装备里没有盔甲。制作一套完整的铁制装备：共24个铁锭。"
		""
		"&a宝可梦提示：&r&e铁头盔&r也是&e经验共享&r的合成配方之一。"
	]
	quest.466C93F5A3B8F5C9.title: "铁质盔甲套装"
	quest.4674214FA703227D.quest_desc: [
		"在篝火锅中烹饪甜点（草莓甜点需要红色染料、蜂蜜瓶和糖），让 Milcery 拿着它并升级。"
		""
		"一天中的不同时段各有风味：白天、夜晚和黄昏，味道各不相同。"
	]
	quest.4674214FA703227D.title: "做个好梦"
	quest.4676F8CC12747563.quest_desc: [
		"手持巨石徽章，&e火箭管理员弓箭手&r将向你发起挑战。他在&e荒地&r、&e草原&r和洞穴中出没。"
		""
		"击败他的Impidimp、Houndour和Mightyena，向火箭队宣示你的存在。"
	]
	quest.4676F8CC12747563.quest_subtitle: "火箭管理员弓箭手"
	quest.4676F8CC12747563.title: "可疑的交易"
	quest.4682BFD13629289B.quest_desc: [
		"在堡垒中打开一个箱子。多亏了 Lootr，每个玩家都能从每个箱子中获得自己的战利品。"
		""
		"堡垒的箱子里可能有远古残骸、下界合金碎片、猪鼻盔甲修饰甚至一块罗盘。"
	]
	quest.4682BFD13629289B.title: "突袭宝库"
	quest.46B022A3EE10A78C.quest_desc: ["用3个花盆、2个木板、2根木棍和1个工作台合成一个&e植物学家工作台&r。"]
	quest.46B022A3EE10A78C.title: "植物学家的工作台"
	quest.46B30FC9217DB3CF.quest_desc: [
		"制作一个&e信标&r：中间放&e下界之星&r，上面5个玻璃，下面3个黑曜石。"
		""
		"星星会从凋灵身上掉落。那场战斗请参见&e怪物猎人&r。"
	]
	quest.46B30FC9217DB3CF.title: "星光之力"
	quest.46BD4A661279DDD8.quest_desc: [
		"杀死 10 只 &e骷髅&r。"
		""
		"骷髅会远程射击。使用掩体或盾牌。它们会掉落&e骨头&r（磨成骨粉用于作物）和&e箭&r。"
	]
	quest.46BD4A661279DDD8.title: "骨头收集者"
	quest.46CDEFE495FA0E9D.quest_desc: [
		"用9个雷石合成一个&e雷石方块&r。"
		""
		"每种进化石都有方块形态：一种展示方块，一种存放备用的紧凑型方块。"
	]
	quest.46CDEFE495FA0E9D.title: "坚如磐石"
	quest.46DCDD9911DF8D61.quest_desc: [
		"用4个铁锭、3个金锭、一个&e末地水晶&r和任意图鉴合成&e电弧手机&r。末地水晶需要末影之眼和恶魂之泪，所以你得先去下界。"
		""
		"当你携带某个遗迹的关键物品（如热钢洞穴的岩浆块）时，它的&e传奇追踪&r应用会指向该遗迹，并告诉你想要哪个物品。"
	]
	quest.46DCDD9911DF8D61.title: "传奇之人的电话"
	quest.46E13A683FAF0A35.quest_desc: [
		"末影珍珠投掷时不会被消耗（而是消耗饥饿值），并且不会造成任何伤害。"
		""
		"&6查找地点：&r远古城市宝箱、末地城市宝箱、村庄神庙、刷沙漠水井。"
	]
	quest.46E13A683FAF0A35.title: "曲速引擎"
	quest.46FDA2475C9C1403.quest_desc: [
		"药用饮品 + 一个 &e柑橘浆果&r = &e活力药水&r (120 HP)。"
		""
		"Sitrus 会在 Figy、Wiki、Mago、Aguav 或 Iapapa 树旁的 Lum 树上变异生成。"
	]
	quest.46FDA2475C9C1403.title: "Hyperactive"
	quest.47022D8534AA9225.quest_desc: [
		"Cobblemon Origins 的世界很大。本章将介绍穿越世界的方法：&e传送石&r、&e传送板&r和卷轴、可携带的床，以及可供骑乘的宝可梦。"
		""
		"你的免费基础指令仍然有效：&e/home&r、&e/back&r 和 &e/rtp&r。"
		""
		"&a点击对勾以完成该任务。&r"
	]
	quest.47022D8534AA9225.quest_subtitle: "每条路都始于第一步"
	quest.47022D8534AA9225.title: "&l有靴子，就能旅行"
	quest.473E259ACD9F7144.quest_desc: [
		"用 Max Mushroom 和四个 Exp. Candy S（或四个 Exp. Candy XS）合成 &eDynamax Candy&r。"
		""
		"喂给宝可梦可以提升它的&e极巨化等级&r，使其极巨化形态更强。"
	]
	quest.473E259ACD9F7144.title: "甜蜜的成长"
	quest.4749306568907ED9.quest_desc: [
		"用&e羽化石&r复活一只&e始祖鸟&r（岩石/飞行）。"
		""
		"在埋藏的桦树或云杉、苔藓池塘、树根坑和可疑土堆中寻找它。"
	]
	quest.4749306568907ED9.title: "Archen"
	quest.47547F7D0CAC860B.quest_desc: [
		"不用鱼竿抓鱼：用&e水桶&r对准游动的鱼。"
		""
		"一桶鱼可以倒进家里的鱼缸里。"
	]
	quest.47547F7D0CAC860B.title: "战术钓鱼"
	quest.475A8632A472E131.quest_desc: [
		"找到一个Explorify&e沙漠神殿&r，即沙漠中的小型神殿。"
		""
		"&cOne of its chests is trapped.&r"
	]
	quest.475A8632A472E131.title: "沙之祭坛"
	quest.475EBADCDE36E90C.quest_desc: [
		"用&eSport Ball&r捕捉一只宝可梦。"
		""
		"&a1.5x 任意平坦地：优雅的大球替代品。&r"
	]
	quest.475EBADCDE36E90C.title: "运动健将"
	quest.4760204A5109591B.quest_desc: [
		"击败 &e5&r 只野生宝可梦，它们的等级为 &e50 或以上&r。"
		""
		"高等级的野生宝可梦伤害很高。好的努力值、个体值和携带物比单纯的高等级容易得多。"
	]
	quest.4760204A5109591B.title: "巨人杀手"
	quest.476533140E6C9B98.quest_desc: [
		"任意木材的四个木板可以制作一个&e工作台&r。"
		""
		"它的3x3网格能解锁工具、箱子和包里的几乎所有配方，包括精灵球。"
	]
	quest.476533140E6C9B98.title: "一个标准的工作台"
	quest.4765CE7D075529F5.quest_desc: [
		"铜矿石生成于 y=-16 至 y=112 之间，在 y=48 附近最为丰富。滴水洞中蕴藏着巨大的矿脉。"
		""
		"填满一个&e原铜块&r（9个原铜）。每个基础精灵球都需要一个铜锭，所以多备点。"
	]
	quest.4765CE7D075529F5.title: "铜矿脉"
	quest.476E8DC7D10B11F6.quest_desc: ["&b南方岛屿&r从深海升起。在其底座献上合适的贡品，即可召唤出&d拉帝亚斯&r或&d拉帝欧斯&r。"]
	quest.476E8DC7D10B11F6.title: "南方岛屿"
	quest.4785C1E43D1B9404.quest_desc: [
		"&6价格：&r &e8,000 CobbleDollars&r 一个。"
		""
		"防止持有者的能力被更改或抑制"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.4785C1E43D1B9404.quest_subtitle: "8,000 CD"
	quest.4785C1E43D1B9404.title: "能力护盾"
	quest.478FDF1EC607E896.quest_desc: [
		"一个原版&e箱子&r加一个&e红石火把&r，或者&e8个木板&r围着一个火把。使用的木板决定了木材外观。"
		""
		"最初有&e27个格子&r和&e1个升级槽&r，之后会不断变大。"
	]
	quest.478FDF1EC607E896.title: "Sophisticated Chest"
	quest.47A2F13060657F99.quest_desc: ["&d科巴利昂&r、&d泰拉基昂&r和&d维里宗&r的足迹遍布主世界。你找到的每一个都算作它们主人的贡献。"]
	quest.47A2F13060657F99.title: "草地上的轨道 Tracks in the Grass"
	quest.47B99370C3887506.quest_desc: [
		"用你的宝可梦图鉴扫描 &e50&r 只宝可梦。"
		""
		"扫描仪能探测到最远 &e10&r 格内的宝可梦，并能识别你尚未遇到的物种。"
	]
	quest.47B99370C3887506.title: "野外研究员"
	quest.47CA5A9689DAFBB0.quest_desc: [
		"木板、鹅卵石、一个&e铜锭&r和红石。一个带电的&e转盘&r会旋转它所朝向的方块。"
		""
		"放置在红石电路方块上的物品会随其一同旋转。"
	]
	quest.47CA5A9689DAFBB0.title: "旋转周期"
	quest.47CACB40232A5AC7.quest_desc: [
		"使用 Tinkering Table 和红石粉制作一个 &eMultimeter&r。"
		""
		"使用它可以在任何地方打开 Tinkering Table 菜单。"
	]
	quest.47CACB40232A5AC7.title: "万用表"
	quest.47D6CCC3095DEB0D.quest_desc: [
		"&e突袭碎片&r是&e5阶&r突袭袋中的稀有奖品。"
		""
		"请将其留在背包中：每次清除劫掠都会为其补充劫掠能量（2级为1，5级最高可达10）。"
	]
	quest.47D6CCC3095DEB0D.title: "力量碎片"
	quest.47DEC7895E6AA07E.quest_desc: [
		"在丛林群系中捕捉 &e5&r 只宝可梦（Terralith 变种也算）。"
		""
		"&b苹苹&r、&b甜角&r、&b圆滚滚&r和&b喇叭花&r藏在藤蔓中。"
	]
	quest.47DEC7895E6AA07E.title: "丛林热症"
	quest.47E3415706C3BC8D.quest_desc: [
		"用草色毛线在 Plush-O-Matic 中赢得一个 &e妙蛙玩偶&r（普通款）。"
		""
		"概率：大约每25次抽取1次，每次抽取消耗毛线，所以先储备好类型宝石。"
	]
	quest.47E3415706C3BC8D.title: "毛绒妙蛙草"
	quest.47F4916BC1971A56.quest_desc: [
		"&6价格：&r &e5,000 CobbleDollars&r 一个。"
		""
		"提升持有者地面系技能的威力"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.47F4916BC1971A56.quest_subtitle: "5,000 CD"
	quest.47F4916BC1971A56.title: "松软沙土"
	quest.480559911568EB31.quest_desc: [
		"在夜间（游戏时间 13000 至 23000）捕捉 &e10&r 只宝可梦。"
		""
		"有些物种只有在天黑之后才会出来。"
		"&a提示：&r&e暮光球&r在亮度1到7时为3倍，完全黑暗时为3.5倍。"
	]
	quest.480559911568EB31.title: "夜猫子（Night Owl）"
	quest.48189D60F0AFD524.quest_desc: [
		"3 用一列&e白色羊毛&r制作一个&e睡袋&r。染成你喜欢的任何颜色。"
		""
		"随处安睡：睡袋永远不会改变你的出生点，也永远不会磨损。"
	]
	quest.48189D60F0AFD524.title: "在星空下安眠"
	quest.481970E3236E8A1B.quest_desc: [
		"&6价格：&r &e2000 CobbleDollars&r 一个。"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.481970E3236E8A1B.quest_subtitle: "2000 冷却时间"
	quest.481970E3236E8A1B.title: "幽灵宝石"
	quest.481DAF5AEF192434.quest_desc: [
		"&eCobbleDollars&r 是 Cobblemon Origins 的货币。"
		""
		"击败野生宝可梦、战胜NPC训练家并完成任务即可获得。你可以在本书的&3Poké Mart&r页面或&eCobble Merchants&r处花费它们，从遗迹中挖掘的宝藏也能变成现金或扭蛋奖品。"
		""
		"&a点击对勾即可开始。&r"
	]
	quest.481DAF5AEF192434.title: "把钱都交出来，让我看看"
	quest.4845E194168DE6C0.quest_desc: [
		"一个&e泵升级&r，需要&e2个钻石&r、一个&e分配器&r、&e2个金锭&r和&e3个红石&r。"
		""
		"还可通过流体过滤器，处理手持的桶和世界中的流体方块。"
	]
	quest.4845E194168DE6C0.title: "高级水泵升级组件"
	quest.486C5E7D32B1B56C.quest_desc: [
		"使用蓝色染料制作宝可梦扭蛋机，即可获得&e蔚蓝&r版本。"
		""
		"黄色是 Citrine，绿色是 Verdant，粉色是 Roseate，黑色是 Slate，白色是 Premier。奖品不变，外观更新。"
	]
	quest.486C5E7D32B1B56C.title: "新鲜的油漆"
	quest.486D90656653DB2A.quest_desc: [
		"跟随一张沉船宝藏地图，挖掘出&e埋藏的宝藏&r。"
		""
		"站在箱子坑里即可完成。一颗海之心和一些 Cobblemon 物品正在等着你。"
	]
	quest.486D90656653DB2A.title: "X 标记着地点"
	quest.4871D69A2110E15E.quest_desc: [
		"用嗅探者挖出的种子种出一朵&e火炬花&r。"
		""
		"种子也是用来繁殖和喂养嗅探者的东西。"
	]
	quest.4871D69A2110E15E.title: "远古绽放"
	quest.48852BA599985D52.quest_desc: [
		"用你自己的&e十字弩&r杀死一个掠夺者。"
		""
		"用3根木棍、2根线、1个铁锭和1个绊线钩合成，或从哨所宝箱中获取。"
	]
	quest.48852BA599985D52.title: "逆转审判"
	quest.4891C95A48D108C6.quest_desc: [
		"&6价格：&r &e3,000 CobbleDollars&r 一个。"
		""
		"使某些宝可梦进化"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.4891C95A48D108C6.quest_subtitle: "3,000 CD"
	quest.4891C95A48D108C6.title: "冰原石"
	quest.489D7F90325ACF69.quest_desc: [
		"用暮色石对Murkrow、Misdreavus、Lampent或Doublade使用，或用朝露石对雄性Kirlia（Gallade）或雌性Snorunt（Froslass）使用。"
		""
		"拿着石头，然后对宝可梦使用它。"
	]
	quest.489D7F90325ACF69.title: "从黄昏到黎明"
	quest.48A4A07259789BCB.quest_desc: [
		"赢得一场针对&e幽灵型&r首领的突袭。大多数都在第4和5层级。"
		""
		"巢穴晶体的颜色暗示着它的类型。带上一个强大的黑暗系攻击手。"
	]
	quest.48A4A07259789BCB.title: "捉鬼行动"
	quest.48A6FBA156CD41C1.quest_desc: [
		"建造完整的四层金字塔：9x9、7x7、5x5 和 3x3 层，共 164 个方块。"
		""
		"2级增加抗性跳跃提升，3级增加力量，4级可添加再生作为第二个效果。"
	]
	quest.48A6FBA156CD41C1.title: "全功率模式"
	quest.48AA3788D45F1D97.quest_desc: [
		"三粒小麦排成一行可以做成一个&e面包&r。"
		""
		"虽然不华丽，但能让你在捕捉宝可梦时填饱肚子。"
	]
	quest.48AA3788D45F1D97.title: "每日面包"
	quest.48AF1B07662D7764.quest_desc: [
		"三桶牛奶、两份糖、一个鸡蛋和三个小麦可以烤出一个&e蛋糕&r。"
		""
		"&a宝可梦联动：&r三瓶&eMoomoo Milk&r可以代替牛奶桶。"
	]
	quest.48AF1B07662D7764.title: "让他们吃蛋糕吧"
	quest.48B1AAC532DB058A.quest_desc: [
		"&6价格：&r &e400 CobbleDollars&r 一个。"
		""
		"1×，飞行距离更远"
		""
		"&a点击对勾购买。可重复购买，仅在你能负担得起时收费。&r"
	]
	quest.48B1AAC532DB058A.quest_subtitle: "400 CD"
	quest.48B1AAC532DB058A.title: "远古羽毛球"
	quest.48B771351F1175B3.quest_desc: [
		"野生的&e南瓜&r遍布世界各地；&e西瓜&r则野生生长于丛林中。"
		""
		"在每个茎的旁边放置一个空方块来播种：果实会生长在旁边。"
	]
	quest.48B771351F1175B3.title: "葫芦园艺"
	quest.48DBC907DD4DE7FF.quest_desc: [
		"探索一片&6地下丛林&r。"
		""
		"Woobat 和 Ferroseed 在黑暗中很常见。"
		"&o神话中的扎鲁德在这里极为罕见。&r"
	]
	quest.48DBC907DD4DE7FF.title: "丛林之下"
	quest.48EBA01514259761.quest_desc: [
		"&6Iron Furnaces&r 添加了更快捷的熔炉系列，从铜制熔炉一直到彩虹奖杯。"
		""
		"原版熔炉每个物品需要 &e200 次游戏循环&r。本章的每个等级都会缩短这个时间，并且每个熔炉都是用前一个熔炉制作的。"
		""
		"带上一个 &e熔炉&r 和 &e8 个铁锭&r：也就是正好一个 &e铁质熔炉&r。"
	]
	quest.48EBA01514259761.title: "&l比原版更热辣"
	quest.48EF884BE4DCEDBE.quest_desc: [
		"找到一个&eShiny Stone&r。"
		""
		"&6矿石：&r花林、草地、樱花林、魔法森林和天空群岛，岛屿和山峰上较为罕见。"
		"&6进化为：&rTogetic、Roselia、Minccino 和 Floette。"
	]
	quest.48EF884BE4DCEDBE.title: "闪耀光芒"
	quest.49034F211CA57481.quest_desc: [
		"用1个微风棒合成4个&e风弹&r。"
		""
		"投掷一个可将生物击退、远程触发开关，或将自己弹向空中。"
	]
	quest.49034F211CA57481.title: "瓶中的微风"
	quest.49061734E31184B1.quest_desc: [
		"骨粉、腐肉、泥土和纸可以合成三种&e覆盖物&r。"
		""
		"再混入一种材料制成特殊覆盖物，然后用于浆果树上。覆盖物会随时间失效。"
	]
	quest.49061734E31184B1.title: "肥沃的土壤"
	quest.4908603E4B7E87EF.quest_desc: [
		"用 4 个 Tumblestone 合成一个 &eBlock of Tumblestone&r。"
		""
		"放入切石机可获得抛光、砖块、雕凿、石板、台阶和墙壁等各种变体。每种颜色都有独立的一套。"
	]
	quest.4908603E4B7E87EF.title: "Tumblestone Masonry"
	quest.4916C4210CCA285C.quest_desc: [
		"一根线缆、&e石英&r、&e2个木板&r、一个&e箱子&r、一颗&e末影珍珠&r和一颗&e钻石&r。"
		""
		"将远处的物品栏连接到电缆线上。"
	]
	quest.4916C4210CCA285C.title: "物品栏电缆连接器"
	quest.4933E49C40C8C11A.quest_desc: [
		"合成一件&e选择围巾&r：三羊毛、三钻石和一件&e丝绸围巾&r。佩戴者速度变快，但会被锁定在一个动作上。"
		""
		"&a丝巾：羊毛、线和普通宝石。硬石加上奇兰浆果可以制作普通宝石。&r"
	]
	quest.4933E49C40C8C11A.title: "快速包装完成"
	quest.494BBFFBE7E0CE82.quest_desc: ["用铁斧、铁锭、5个木板和一个工作台制作一个&e木工台&r。"]
	quest.494BBFFBE7E0CE82.title: "木工台 (Carpenter's Table)"
	quest.4967B8D0497D41FD.quest_desc: ["钓上一条&e德拉尼&r。它们在地下Y-31至32之间的暗水域中较为罕见，Y-32以下较为常见，在黑暗森林等魔法生物群系中则极为罕见。"]
	quest.4967B8D0497D41FD.title: "深海中的巨龙"
	quest.497BD53D0B0BDF5F.quest_desc: [
		"&6价格：&r &e1,000 CobbleDollars&r 一个。"
		""
		"&a点击对勾购买。可重复购买，仅在你能负担得起时收费。&r"
	]
	quest.497BD53D0B0BDF5F.quest_subtitle: "1,000 CD"
	quest.497BD53D0B0BDF5F.title: "波美果浆果"
	quest.4991FCC1C934D4A7.quest_desc: [
		"&6价格：&r &e300 CobbleDollars&r 一个。"
		""
		"如果持有者感到困惑，那么它就被治愈了"
		""
		"&a点击对勾购买。可重复购买，仅在你能负担得起时收费。&r"
	]
	quest.4991FCC1C934D4A7.quest_subtitle: "300 冷却时间"
	quest.4991FCC1C934D4A7.title: "柿子浆果"
	quest.4999F4BAF3D8DA1E.quest_desc: [
		"用Aprijuice将一只宝可梦的五个骑行属性（速度、加速、技巧、跳跃和耐力）全部升到最高。"
		""
		"每种颜色也会消耗一点其他属性。 &e白色&r果汁会降低所有属性2点。"
	]
	quest.4999F4BAF3D8DA1E.title: "星际运动员"
	quest.49BBC7A3023011C8.quest_desc: [
		"&6价格：&r &e3,000 CobbleDollars&r 一个。"
		""
		"使未进化的百变怪的速度翻倍"
		""
		"&a点击对勾购买。可重复购买，仅在你能负担得起时收费。&r"
	]
	quest.49BBC7A3023011C8.quest_subtitle: "3,000 CD"
	quest.49BBC7A3023011C8.title: "快速粉末"
	quest.49BE29B238EA1C71.quest_desc: [
		"&6价格：&r &e1,000 CobbleDollars&r 一个。"
		""
		"2倍，飞行距离更远"
		""
		"&a点击对勾购买。可重复购买，仅在你能负担得起时收费。&r"
	]
	quest.49BE29B238EA1C71.quest_subtitle: "1,000 CD"
	quest.49BE29B238EA1C71.title: "远古喷射球 Ancient Jet Ball"
	quest.49C2C129BF6F8B27.quest_desc: ["&e各地美食&r是源自宝可梦各地区的菜肴，共十种。大多数都始于&e丰盛的谷物&r、&e小麦&r、&e牛奶&r或&e糖&r。"]
	quest.49C2C129BF6F8B27.title: "世界厨房"
	quest.49C699CA6F63D100.quest_desc: [
		"你的近战攻击会点燃敌人。"
		""
		"&6寻找地点：&r堡垒宝藏室、废弃传送门、大型海洋废墟、大型海洋废墟边缘；极少被凋零骷髅穿戴。"
	]
	quest.49C699CA6F63D100.title: "火焰手套"
	quest.49CA832C4284C1F6.quest_desc: [
		"&eYUNG's Better Desert Temples&r 替换了原版金字塔。每个神殿都会使你受到挖掘疲劳，直到被清除。"
		""
		"在深处找到陵墓，并击败&e法老&r以解除诅咒。"
	]
	quest.49CA832C4284C1F6.title: "法老的诅咒"
	quest.49CF0F3FAF564162.quest_desc: [
		"八个&e铜锭&r围绕一个&e红石块&r。齿轮方块会将红石能量传递给它接触到的其他齿轮方块。"
		""
		"将它们串联起来，无需红石粉即可将信号沿墙壁和角落传递。"
	]
	quest.49CF0F3FAF564162.title: "工业齿轮模组 (Gears of Industry)"
	quest.49DE28B09F3A39B2.quest_desc: [
		"合成一个&e国王岩&r：在三个原金和三个砂岩的上面放置一个雕纹砂岩。"
		""
		"部分进化仅在宝可梦持有特定道具时有效。"
	]
	quest.49DE28B09F3A39B2.title: "王者风范，无可挑剔"
	quest.49EE7EBB47D4D1D1.quest_desc: ["在宝可梦上使用 &e50 个恒星泰拉碎片&r，赋予其稀有的 &6恒星&r 泰拉属性。"]
	quest.49EE7EBB47D4D1D1.title: "被星辰吸引的探险家"
	quest.49F342BD50FCFD8B.quest_desc: [
		"手持一个&e不死图腾&r。每个唤魔者都会掉落一个。"
		""
		"手持或副手持有可救你一命，并立即为你恢复生命值。"
	]
	quest.49F342BD50FCFD8B.title: "第二次生命"
	quest.49F3A0A6118941DC.quest_desc: [
		"捕捉 &e50&r 只宝可梦。"
		""
		"&a提示：&r&e超球&r的捕获率是普通精灵球的两倍。"
	]
	quest.49F3A0A6118941DC.title: "箱子填充器"
	quest.4A01B0E54C0E7074.quest_desc: [
		"寻找&e火石矿石&r：它生成于沙漠、火山或温泉生物群系，较少见于其他沙质生物群系。下界变种则隐藏在基岩中。"
		"看深板岩层上方的普通石头变种。"
		""
		"&a宝可梦提示：&r这块石头能让Vulpix、Growlithe和Eevee等宝可梦进化。"
	]
	quest.4A01B0E54C0E7074.title: "火石矿石"
	quest.4A171767EB4BC141.quest_desc: [
		"&6价格：&r &e1,500 CobbleDollars&r 一个。"
		""
		"战斗中使用时，临时将目标的特攻提升一级"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.4A171767EB4BC141.quest_subtitle: "1,500 CD"
	quest.4A171767EB4BC141.title: "X 特攻"
	quest.4A18B490E7E5CDF3.quest_desc: ["用四个石英、两个青金石和两个红石将肌肉带升级为&e选择带&r。大幅提升攻击力，但持有者会被锁定在一个招式上。"]
	quest.4A18B490E7E5CDF3.title: "选择头带"
	quest.4A287EE8172CB96D.quest_desc: [
		"&6价格：&r &e5,000 CobbleDollars&r 一个。"
		""
		"提升持有者幽灵系技能的威力"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.4A287EE8172CB96D.quest_subtitle: "5,000 CD"
	quest.4A287EE8172CB96D.title: "法术标签"
	quest.4A4D27C5E6DDE715.quest_desc: [
		"夜间击败的野生宝可梦有时会掉落&e梦之线&r。九根可以制作一个&e捕梦网&r；学徒企业家也出售一个。"
		""
		"把它放在床附近：它能为附近的玩家赋予&e清醒梦&r。"
	]
	quest.4A4D27C5E6DDE715.title: "捕捉一个梦"
	quest.4A60AE64F923DCD3.quest_desc: ["九个碎片合成一块完整的石头：制作&e光石&r和&e暗石&r。"]
	quest.4A60AE64F923DCD3.title: "光明与黑暗"
	quest.4A6DF5A3C5836F3D.quest_desc: ["合成一个&e金属合金&r（四个铁锭围绕一个雷石），然后对杜拉鲁顿使用以进化成阿奇鲁顿。"]
	quest.4A6DF5A3C5836F3D.title: "合金雄心"
	quest.4A6E46F5966B59E9.quest_desc: [
		"前往&6蘑菇地&r，通常是一个远离海岸的海岛。"
		""
		"加拉尔的呆壳兽在水边闲逛，而毒刺水母则在菌毯上漫步。"
		"&a提示：&rCTOV 蘑菇村庄也可能生成在这里。"
	]
	quest.4A6E46F5966B59E9.title: "Fungus Among Us"
	quest.4A7D3FFB0D0DDC9F.quest_desc: [
		"&b霜冻洞穴&r形成于最寒冷的雪地：头顶有冰锥，脚下有冰，还有发光的&e附魔冰&r。"
		""
		"&c坠落的冰锥会伤人。&r"
	]
	quest.4A7D3FFB0D0DDC9F.title: "冰冻洞穴"
	quest.4A868C7CEC6DC5DA.quest_desc: [
		"每种堡垒的箱子都可以存放一个&e下界合金升级锻造模板&r，能将钻石装备变为下界合金的道具。"
		""
		"使用前复制：七个钻石、一个模板和一个下界岩块可以制作两个模板。"
	]
	quest.4A868C7CEC6DC5DA.title: "下界合金的蓝图配方"
	quest.4A9D21B20D1DC220.quest_desc: ["合成一个&eHP银色头盔&r：四个铁锭、两颗钻石和三个&e白色薄荷叶&r。它将HP IV超频训练至31。"]
	quest.4A9D21B20D1DC220.title: "HP 银色头盔"
	quest.4AA9BB72A8486D39.quest_desc: [
		"捕捉10只&9水&r系宝可梦。双属性宝可梦两种属性都算数。"
		""
		"&6强项：&r火焰、地面、岩石"
	]
	quest.4AA9BB72A8486D39.title: "掀起一阵水花"
	quest.4AACCEEF563DFBAE.quest_desc: [
		"两个潜贝壳和一个箱子可以合成一个&e潜贝箱&r。"
		""
		"打破它，里面的所有物品都会保留，这样一整个箱子就能放进背包的一个格子里。"
	]
	quest.4AACCEEF563DFBAE.title: "盒中盒"
	quest.4ADF08F82F2EF0BB.quest_desc: [
		"&e远古守卫者&r生活在海洋神殿中，会给附近的玩家施加挖掘疲劳诅咒。"
		""
		"击败一个。它会掉落一个&e湿海绵&r，还有可能掉落&e潮汐&r盔甲修饰模板。"
	]
	quest.4ADF08F82F2EF0BB.title: "深海的长者"
	quest.4AFBC1A96BB6154F.quest_desc: [
		"&6价格：&r &e1,000 CobbleDollars&r 一个。"
		""
		"1.5× 战斗外"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.4AFBC1A96BB6154F.quest_subtitle: "1,000 CD"
	quest.4AFBC1A96BB6154F.title: "Safari Ball"
	quest.4B07018B02686937.quest_desc: [
		"&6价格：&r &e6,000 CobbleDollars&r 一个。"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.4B07018B02686937.quest_subtitle: "冷却时间 6000 秒"
	quest.4B07018B02686937.title: "力量草"
	quest.4B21BADD7B4E06DD.quest_desc: ["击败 &e1,000&r 只野生宝可梦。这需要经历无数场战斗。你的队伍已经历了千锤百炼。"]
	quest.4B21BADD7B4E06DD.title: "千场胜利"
	quest.4B384FD3C325AB35.quest_desc: ["用2个铁锭、玻璃、4块砖、一个高炉和一个工作台来制作一个&eGlassblower&r。"]
	quest.4B384FD3C325AB35.title: "玻璃吹制匠"
	quest.4B5344DA3EDAA41D.quest_desc: [
		"&6价格：&r &e2,500 CobbleDollars&r 一个。"
		""
		"持有者被克制招式击中后恢复最大生命值的1/4"
		""
		"&a点击对勾即可购买。可重复购买，仅在您负担得起时收费。&r"
	]
	quest.4B5344DA3EDAA41D.quest_subtitle: "2,500 CD"
	quest.4B5344DA3EDAA41D.title: "Enigma Berry"
	quest.4B58952D70C35072.quest_desc: [
		"著名的训练家们总是带着他们的钥匙石配饰。收集全部十四件钥匙石配饰："
		"七枚手镯外加 Mega Ring、May's Bracelet、Brendan's Mega Cuff、Lysandre's Ring、Korrina's Gloves、Maxie's Glasses 和 Archie's Anchor。"
		""
		"每个都需要一个基石。REI会显示每个配方。"
	]
	quest.4B58952D70C35072.title: "著名的手腕 (Famous Wrists)"
	quest.4B6664D7086E8F39.quest_desc: [
		"&6四种较新的药水&r，每种都来自一瓶粗制药水："
		"&eBreeze Rod&r: Wind Charged，目标死亡时会释放一阵强风。"
		"&e蜘蛛网&r：编织，当目标死亡时，蜘蛛网会蔓延开来。"
		"&e史莱姆方块&r: 流动着，当目标死亡时会弹出史莱姆。"
		"&e石头&r: 被侵扰的，当目标受到伤害时，可能有银鱼爬出。"
		"&a微风棒来自试炼密室（试炼与考古）。&r"
	]
	quest.4B6664D7086E8F39.title: "试炼时代的酿造配方"
	quest.4B7A09962F98169E.quest_desc: [
		"用2个铁块、1个红石块、3个超球、2个铁靴和1个分配器合成&eRocket Prize Master&r。"
		""
		"只需要科班币，并且总会奖励一个火箭球。"
	]
	quest.4B7A09962F98169E.title: "火箭奖品大师"
	quest.4B8513459C50C1DB.quest_desc: [
		"木屑加上泥土、粗土、泥、苔藓块或沙子可制成&e腐殖土&r、&e粗土&r、&e湿土&r、&e泥炭&r或&e沙质木屑&r。"
		""
		"每种浆果都有自己喜欢的覆盖物，代表其偏好的生物群系：Oran喜欢Peat和Loamy，Cheri喜欢Loamy，Aspear喜欢Coarse，Pecha喜欢Humid，Rawst喜欢Sandy。"
	]
	quest.4B8513459C50C1DB.title: "主场优势"
	quest.4B911CEA7A55B808.quest_desc: [
		"制作一个&e岩石头盔&r：一个金头盔、三个&e硬石&r、两个龟甲和两个金锭。任何与佩戴者接触的宝可梦都会受到伤害。"
		""
		"&a硬石：在岩石宝石周围放置八个石头、深板岩、黑石或浮石，或者爆破鹅卵石。&r"
	]
	quest.4B911CEA7A55B808.title: "安全帽"
	quest.4B92C66AF72CA3A0.quest_desc: [
		"两个铜锭上面放一个紫水晶碎片，可以制作一个&e潜望镜&r。"
		""
		"放大以从远处侦察野生宝可梦，然后再靠近它们。"
	]
	quest.4B92C66AF72CA3A0.title: "鹰眼 (Eagle Eye)"
	quest.4B98C57E56E02AB6.quest_desc: [
		"将&eGlobe&r与&eAntique Ink&r结合，即可得到&eSepia Globe&r，仿佛出自一位老探险家的书房。"
		""
		"改变主意了？&e肥皂&r可以把它洗回正常的地球仪。"
	]
	quest.4B98C57E56E02AB6.title: "前方有龙"
	quest.4BB7ED16C4187A05.quest_desc: [
		"击杀 50 只 &e烈焰人&r。"
		""
		"在生成器旁建墙，这样它们一次只能靠近一个，烈焰棒也会堆积起来。"
	]
	quest.4BB7ED16C4187A05.title: "刷怪者伏击者"
	quest.4BB9B9C6FCD9BBBF.quest_desc: [
		"在本整合包中，圈养的宝可梦也会&e产出战利品&r：每只宝可梦每分钟有15%的几率掉落其常规掉落表中的物品。"
		""
		"肉、骨头、皮革、腐肉、蜂蜜和其他掉落物除外。晕厥的宝可梦不产出。"
	]
	quest.4BB9B9C6FCD9BBBF.title: "牧场分红"
	quest.4BC566D30984D8CD.quest_desc: [
		"找到一个&6月光林&r。"
		""
		"Hatenna 及其进化型生活在这里，而 Impidimp 会在夜间出来玩耍。"
		"&o超稀有的露娜拉曾在此出现过。&r"
	]
	quest.4BC566D30984D8CD.title: "月光之下"
	quest.4BCCFBB273BA927F.quest_desc: [
		"&e胡萝卜&r和&e土豆&r没有种子：直接种植蔬菜本身。"
		""
		"在村庄农场里找到它们，或者作为僵尸的稀有掉落。猪会跟随并与两者之一杂交。"
	]
	quest.4BCCFBB273BA927F.title: "根茎类蔬菜"
	quest.4BD6672D3971C1AB.quest_desc: [
		"捕捉任何一只合众地区的初始宝可梦。"
		""
		"丛林中的&bSnivy&r，平原上的&bTepig&r，海滩和海岸边的&bOshawott&r。"
	]
	quest.4BD6672D3971C1AB.title: "努维玛新来者"
	quest.4BE4A0CAA9548041.quest_desc: [
		"&e精英四强洛雷lei&r正在&e关都联盟&r等候，该联盟位于&5末地&r的外围岛屿（末地高地和中部）的一座宏伟大厅中。用指南针寻找它吧。"
		""
		"联盟队伍：多边兽、多边兽2型、巨沼怪、龙王、原始海洋和鱼龙。"
		""
		"她也会游荡在寒冷的群系中，有时是和不同的队伍。无论哪个队伍都算数，四天王可以按任意顺序挑战。"
	]
	quest.4BE4A0CAA9548041.quest_subtitle: "精英四强洛雷莱 (Elite Four Lorelei)"
	quest.4BE4A0CAA9548041.title: "冰雪女王"
	quest.4C056E0965C33381.quest_desc: [
		"每个任务都完成，每个僵尸都治愈，存款也增加了，还击退了掠夺者：村庄欠你一个人情。"
		""
		"注意安全。繁荣的村庄是主世界最好的贸易站。"
	]
	quest.4C056E0965C33381.title: "社区的支柱 (Pillar of the Community)"
	quest.4C065FDC50FD6972.quest_desc: [
		"沙漠、绿洲、条纹荒地以及干燥的稀树草原。"
		""
		"地面和岩石类型的生物在炎热中茁壮成长，沙漠里隐藏着值得探索的神庙和遗迹。"
		"&a提示：&r沙漠神殿和 Cobblemon 遗迹藏在沙子里；参见 &eStructure Hunter&r。"
	]
	quest.4C065FDC50FD6972.title: "Sun-Baked Sands"
	quest.4C0A590AD5286E8D.quest_desc: [
		"捕捉10只&5幽灵&r属性的宝可梦。双属性宝可梦两种属性都算数。"
		""
		"&6强效对抗：&r超能力、幽灵"
	]
	quest.4C0A590AD5286E8D.title: "那些会发出声响的东西"
	quest.4C1CC980E1DD7B20.quest_desc: [
		"&6价格：&r &e2000 CobbleDollars&r 一个。"
		""
		"用花朵甜点将Milcery进化成Alcremie"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.4C1CC980E1DD7B20.quest_subtitle: "2000 冷却时间"
	quest.4C1CC980E1DD7B20.title: "花之甜心"
	quest.4C21152ACC03DA6B.quest_desc: [
		"花费 5,000 购买一个 &eCherish Ball&r。"
		""
		"没有人能制作这些：宝可梦商店、商人和最稀有的扭蛋胶囊是唯一来源。"
	]
	quest.4C21152ACC03DA6B.title: "特殊快递"
	quest.4C28824392496AF7.quest_desc: [
		"&6价格：&r &e2000 CobbleDollars&r 一个。"
		""
		"将宝可梦的特防努力值提高4点"
		""
		"&a点击对勾即可购买。可重复购买，仅在您负担得起时收费。&r"
	]
	quest.4C28824392496AF7.quest_subtitle: "2000 冷却时间"
	quest.4C28824392496AF7.title: "聪明的麻薯 (Clever Mochi)"
	quest.4C2A1B4F76A13371.quest_desc: [
		"九个地区的初学者都加入了你的队伍。从关都到帕迪亚的教授们都很 impressed。"
		""
		"完成全部九个区域任务后即可解锁。"
	]
	quest.4C2A1B4F76A13371.title: "新手收集者"
	quest.4C407DD60EC449DF.quest_desc: [
		"在&eSophisticated Chest&r的上下方放置一个&eShulker Shell&r。外壳来自末地城市的潜贝。"
		""
		"一个能像家族其他成员一样升级和进阶的潜影盒。"
	]
	quest.4C407DD60EC449DF.title: "复杂化的潜影方块箱子"
	quest.4C472204B7B87330.quest_desc: [
		"攀登&6火山之巅&r。"
		""
		"Meditite 冥想，Numel 在灰烬中跋涉；超稀有的 Beldum 或许会飘过。"
	]
	quest.4C472204B7B87330.title: "山火事"
	quest.4C698144FC345B08.quest_desc: [
		"用&eDive Ball&r捕捉一只宝可梦。"
		""
		"&a潜入水中，向水下游泳的宝可梦投掷它。&r"
	]
	quest.4C698144FC345B08.title: "深度探索"
	quest.4C6E25B32E5F157E.quest_desc: [
		"&6价格：&r &e5,000 CobbleDollars&r 一个。"
		""
		"提升持有者冰系技能的威力"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.4C6E25B32E5F157E.quest_subtitle: "5,000 CD"
	quest.4C6E25B32E5F157E.title: "永不融化的冰 (Never-Melt Ice)"
	quest.4C7A91471FC513EE.quest_desc: [
		"Serene Seasons 也包含 Cobblemon 植物。非季节期间它们生长缓慢。"
		"全年： &e杏角&r、&e薄荷&r、&e活力草&r、奥兰和柿子。冬季除外： &e复苏草药&r和糖苷树苗。"
		"春和秋：&e韭葱&r。夏和秋：&e粗粮&r。仅限秋季：&e加拉里卡坚果&r。"
		"其他浆果各不相同：悬停查看其丰饶季节。"
	]
	quest.4C7A91471FC513EE.title: "季节性嫩芽"
	quest.4C7C85CCFC75CC22.quest_desc: [
		"捕捉10只&c火&r属性的宝可梦。双属性宝可梦两种属性都算数。"
		""
		"&6强项：&r 草、冰、虫、钢"
	]
	quest.4C7C85CCFC75CC22.title: "与火焰共舞"
	quest.4CAE89F927348C3D.quest_desc: [
		"寻找&e月亮石矿石&r：它生成在针叶林、蘑菇田和滴水洞窟下，较少地生成在诡异和魔法生物群系下。滴水洞窟还隐藏着滴水石变种。"
		"看深板岩层上方的普通石头变种。"
		""
		"&a宝可梦提示：&r这块石头能让像 Clefairy、Jigglypuff 和 Skitty 这样的宝可梦进化。"
	]
	quest.4CAE89F927348C3D.title: "月亮石矿石"
	quest.4CB1F9CCDB1E21EC.quest_desc: [
		"在战斗中击败25只野生&6岩石&r属性的宝可梦。"
		""
		"&6弱点：&r格斗、草、地面、钢、水"
		"&c抗性：&r火焰、飞行、普通、中毒"
	]
	quest.4CB1F9CCDB1E21EC.title: "岩石底部"
	quest.4CBB5B7671E77500.quest_desc: [
		"本章是你的 Cobblemon 教程：选择伙伴、战斗、捕捉、制作精灵球、恢复健康并组建队伍。"
		""
		"你的起点分出三条路：顶部是&6制作&r，中间是&6捕捉&r，底部是&6对战&r。其他所有宝可梦章节都由此开启。"
		""
		"&a点击对勾即可开始。&r"
	]
	quest.4CBB5B7671E77500.quest_subtitle: "每一段旅程都始于一只宝可梦"
	quest.4CBB5B7671E77500.title: "&l成为一名训练家"
	quest.4CBF820426116135.quest_desc: [
		"&6价格：&r &e2000 CobbleDollars&r 一个。"
		""
		"用 Love Sweet 将 Milcery 进化成 Alcremie"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.4CBF820426116135.quest_subtitle: "2000 冷却时间"
	quest.4CBF820426116135.title: "喜爱甜蜜"
	quest.4CD9CFDC8C0BC562.quest_desc: [
		"将&e60&r种来自&e丰源&r地区的宝可梦（第三世代）标记为已捕获。"
		""
		"地区形态计入其所属地区（阿罗拉形态计入阿罗拉）。洗翠形态计入伽勒尔。"
	]
	quest.4CD9CFDC8C0BC562.title: "丰源地区野外笔记"
	quest.4CEE41891DE71674.quest_desc: ["木屑加骨粉可制作&e生长木屑&r：覆盖的浆果树生长速度更快。"]
	quest.4CEE41891DE71674.title: "生长激增"
	quest.4D13806724D15F7F.quest_desc: [
		"三个湖泊，三项试炼：&bVerity湖&r（向日葵平原）、&bValor湖&r（暗森林）和&bAcuity湖&r（雪松针叶林）。"
		""
		"赢得湖泊的宝可梦试炼，即可获得其&e征服的证明&r。右键点击证明即可召唤&d美梦特&r、&d自信子&r或&d贤坐&r，并获得一件遗物：美梦特的羽毛、自信子的獠牙或贤坐的爪。"
	]
	quest.4D13806724D15F7F.title: "湖泊试炼"
	quest.4D1F10A4A406C800.quest_desc: [
		"将三个M糖果烹饪成&e经验糖果L&r（10,000经验）。"
		""
		"L 糖果也是 IV 糖果在属性分支的基础。"
	]
	quest.4D1F10A4A406C800.title: "大型订单"
	quest.4D4E9AD46E66250E.quest_desc: ["在沙漠水井中刷出一个&eBrewer Pottery Sherd&r。另一个碎片是Arms Up。"]
	quest.4D4E9AD46E66250E.title: "酿酒者陶罐"
	quest.4D611B5DC9A7225F.quest_desc: [
		"&eTier 1&r with &e8 Blocks of Gold&r."
		""
		"每个槽位可容纳 &e4x&r 倍的物品堆叠。一个背包最多可容纳 &e3&r 个堆叠升级。"
	]
	quest.4D611B5DC9A7225F.title: "堆叠升级 第2级"
	quest.4D62DE999115E434.quest_desc: [
		"一个 &eHopper&r、&e2 Iron Ingots&r 和 &e3 Redstone&r 环绕着一个 &eStorage Upgrade Base&r。"
		""
		"从上方方块中吸取物品，并推入下方方块。不再需要漏斗塔。"
	]
	quest.4D62DE999115E434.title: "漏斗升级包"
	quest.4D797A9EFCE3790B.quest_desc: [
		"给多边兽一个升级道具，然后交换或使用连接电缆。"
		""
		"Porygon2 在手持 &eDubious Disc&r（两个 Tinted Glass、一个 Sea Lantern、两个 Sculk 和一个 Blank TM）的情况下，以同样的方式进化成 Porygon-Z。"
	]
	quest.4D797A9EFCE3790B.title: "版本 2.0"
	quest.4D7982854D75D083.quest_desc: [
		"一个&e滑轮方块&r（木板、木板台阶和一个铁锭）可以固定绳索并将其收放。"
		""
		"转动与之相连的&e曲柄&r来绞动绳索，将末端悬挂的物品（最多8格）向上或向下拖动。建造一个矿井电梯！"
	]
	quest.4D7982854D75D083.quest_subtitle: "电梯不包含在内"
	quest.4D7982854D75D083.title: "向上攀登"
	quest.4D82777D1D00E60E.quest_desc: [
		"捕捉一只同时是&2虫&r和&7钢&r属性的宝可梦。"
		""
		"钢几乎能覆盖所有虫系的弱点：只有火系有效，而且伤害是四倍。"
		"中毒完全没有任何效果。"
	]
	quest.4D82777D1D00E60E.title: "装甲昆虫 (Armored Insects)"
	quest.4D88F9E6C07D5B97.quest_desc: [
		"&6价格：&r &e800 CobbleDollars&r 一个。"
		""
		"在战斗中使用时会清除目标宝可梦的所有状态变化"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.4D88F9E6C07D5B97.quest_subtitle: "800 CD"
	quest.4D88F9E6C07D5B97.title: "Moomoo牛奶"
	quest.4D8BE593EADCBAC5.quest_desc: [
		"将三个 L 糖果烹饪成 &eExp. Candy XL&r（30,000 EXP）。"
		""
		"&a需要改变大小？任何大于XS的糖果都可以在合成台分解成下一级大小。&r"
	]
	quest.4D8BE593EADCBAC5.title: "糖块山"
	quest.4DB0B478D0CC0891.quest_desc: [
		"&6价格：&r &e1,500 CobbleDollars&r 一个。"
		""
		"在战斗中使用时，临时将目标的准确性提升一个阶段"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.4DB0B478D0CC0891.quest_subtitle: "1,500 CD"
	quest.4DB0B478D0CC0891.title: "X 准确性"
	quest.4DC26938EC88E58C.quest_desc: [
		"在沙漠或恶地生物群系中捕捉 &e5&r 只宝可梦（Terralith 变种也算）。"
		""
		"&b沙奈朵&r、&b球球蛹&r、&b仙人掌&r、&b煤炭龟&r和&b大舌舔&r都喜欢炎热的环境。"
	]
	quest.4DC26938EC88E58C.title: "Sun-Baked"
	quest.4DE0607D30A0EF18.quest_desc: [
		"将四个 &eSoul Sand&r（或 Soul Soil）摆成 T 形，顶部放上三个 &eWither Skeleton Skulls&r。远离家再做：凋灵会破坏方块并传播凋零。"
		""
		"它的&e下界之星&r可以制作&e信标&r，并用于Cobblemon的&e大师球&r和&e能力补丁&r配方中。"
	]
	quest.4DE0607D30A0EF18.title: "&8凋零者 (The Wither)"
	quest.4DEB4FB9D465376B.quest_desc: [
		"挖掘一块&e附魔冰&r。"
		""
		"只有用丝绸之触挖掘时才会掉落自身。"
	]
	quest.4DEB4FB9D465376B.title: "冷光（Cold Glow）"
	quest.4DF32C6FC46C35E9.quest_desc: [
		"非季节作物也能生长，但速度较慢。悬停作物可查看其&e适宜生长季节&r。"
		"&e小麦&r 夏季和秋季；&e胡萝卜&r 春季和秋季；&e马铃薯&r 春季；&e甜菜根&r 和 &e南瓜&r 秋季；&e甜瓜&r、&e甘蔗&r 和 &e可可&r 夏季；&e甜浆果&r 春季和冬季。"
		"&a提示：&r玻璃屋顶下或地下深处 Y 48 以下的作物不受季节影响。"
		"&a宝可梦联动：&r伊布在此有季节性形态：在合适的季节进化，会变成春季的日蚀仙子、夏季的冰仙子、秋季的仙子伊布或冬季的雷伊布。"
	]
	quest.4DF32C6FC46C35E9.title: "不合时宜的季节"
	quest.4DFE6181573DCB1D.quest_desc: [
		"用火焰石对Growlithe、Vulpix、Pansear或Capsakid，或用水之石对Shellder、Staryu、Poliwhirl、Lombre或Panpour。"
		""
		"拿着石头，然后对宝可梦使用它。"
	]
	quest.4DFE6181573DCB1D.title: "火与水"
	quest.4E033C2181AE6F00.quest_desc: [
		"握住它可缓慢下落，也可像盾牌一样举起。"
		""
		"&6寻找地点：&r埋藏宝藏、村庄鞣革厂、刷沙漠水井。"
	]
	quest.4E033C2181AE6F00.title: "雨伞"
	quest.4E0462B6EE526C7A.quest_desc: [
		"&6价格：&r &e1,000,000 CobbleDollars&r 一个。"
		""
		"保证捕获成功"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.4E0462B6EE526C7A.quest_subtitle: "1,000,000 CD"
	quest.4E0462B6EE526C7A.title: "大师球"
	quest.4E1B8D054C0DF1D1.quest_desc: ["持续战斗，直到你的忍蛙进化成&e灰忍蛙&r。"]
	quest.4E1B8D054C0DF1D1.title: "邦德现象"
	quest.4E25AB01D977DC70.quest_desc: [
		"捕捉10只&2虫&r属性的宝可梦。双属性宝可梦两种属性都算数。"
		""
		"&6强于：&r 草、超能力、黑暗"
	]
	quest.4E25AB01D977DC70.title: "Bug Collector"
	quest.4E271C552C46CA67.quest_desc: [
		"沿着一条 &6砾石海滩&r 行走。"
		""
		"Slowpoke 在潮水边打盹，而 Wiglett 和 Crabrawler 在石头上闲逛。"
	]
	quest.4E271C552C46CA67.title: "卵石滩"
	quest.4E2E5853343C9B7E.quest_desc: [
		"在战斗中击败25只野生&1龙&r属性宝可梦。"
		""
		"&6弱点：&r 龙、妖精、冰"
		"&c抗性：&r 电、火、草、水"
	]
	quest.4E2E5853343C9B7E.title: "屠龙者"
	quest.4E46F22C7BE9B5BD.quest_desc: [
		"在拥有会游泳的宝可梦之前，&e船&r能让你横渡湖泊和沿海航行。"
		""
		"游戏中的任何木材都行；此任务会检查是否有 &e橡木船&r。 &e箱子船&r 也能运输货物。"
	]
	quest.4E46F22C7BE9B5BD.title: "划船，划船，划船去"
	quest.4E72633F37DE89B4.quest_desc: [
		"2 个 &eWarp Dust&r 和 1 个 &eFlint&r 可以合成 1 个 &eDormant Shard&r。"
		""
		"每个Warp Plate配方都需要一个，制作每个链接还需要多一个。"
	]
	quest.4E72633F37DE89B4.title: "沉睡的碎片"
	quest.4E75D39D4B5CFEB4.quest_desc: [
		"将上一个治疗升级方块用&e4个铁块&r围起来。"
		""
		"缩短充能时间 &e20%&r：治疗间隔约为 &e120 秒&r。"
	]
	quest.4E75D39D4B5CFEB4.title: "治疗升级 第1级"
	quest.4E8231D9E8ED01A1.quest_desc: [
		"Tom's 将一面普通箱子组成的墙变成一个可通过单个屏幕搜索的库存。"
		""
		"此分支的大多数方块配方中都有一个&e箱子&r，所以先准备八个。"
	]
	quest.4E8231D9E8ED01A1.title: "Tom's Simple Storage"
	quest.4E8539DD28F0363F.quest_desc: [
		"发现一座&e更棒的沙漠神殿&r。"
		""
		"Baltoy、Yamask 和 Cofagrigus 会出没于其中，夜间还会出现稀有的 Spiritomb。"
		"&c神庙会诅咒入侵者，使其患上挖掘疲劳。它的主人正在&e怪物猎人&r章节中等待着你。&r"
	]
	quest.4E8539DD28F0363F.title: "一座古老的坟墓"
	quest.4E8C4DEA11FB761D.quest_desc: [
		"将水倒在静止的岩浆源上，将其变为&e黑曜石&r，然后用&e钻石镐&r开采。"
		""
		"下界传送门和附魔台都由它建造而成。"
		"&a宝可梦提示：&r黑曜石还能制作重型靴子和 Cobblemon Utility+ 的黑曜石瓶盖。"
	]
	quest.4E8C4DEA11FB761D.title: "在水中锻造而成"
	quest.4EA1901A8A45F7BD.quest_desc: [
		"在 &eStorage Terminal&r 周围放置 &e4 Crafting Tables&r 和 &e4 Diamonds&r。"
		""
		"一个内置了合成台的终端，让你能用网络里的所有东西进行合成。"
	]
	quest.4EA1901A8A45F7BD.title: "合成终端"
	quest.4EA7E420A571541B.quest_desc: ["用3羊毛、2木棍、3原木和1个工作台制作一个&eLoom Table&r。"]
	quest.4EA7E420A571541B.title: "织布机工作台"
	quest.4EAC39923887DF0E.quest_desc: [
		"获得一本&e附魔书&r：用普通书附魔、与&e图书管理员&r村民交易，或在宝箱中找到。"
		""
		"一本书的附魔效果，直到你用&e铁砧&r将其附在装备上才会消失。"
	]
	quest.4EAC39923887DF0E.title: "Spellbound Pages"
	quest.4EC305F52FE93F1C.quest_desc: [
		"关键物品：&eSmoker&r。"
		""
		"只允许使用烟熏配方："
		"非常适合用作专门的烹饪熔炉。"
	]
	quest.4EC305F52FE93F1C.title: "增强：吸烟（Smoking）"
	quest.4ECC52CCA2045800.quest_desc: [
		"&e3 原木&r、&e4 木板&r和一个&e存储升级底座&r。"
		""
		"用其他材质和颜色重制你的储物箱。它还定义了世界中的储物箱方块能被&ePaintbrush&r涂成什么样。"
	]
	quest.4ECC52CCA2045800.title: "装饰物工作台"
	quest.4F03EEF41A2041C4.quest_desc: [
		"三个&eHearty Grains&r和一个&eDried Kelp&r可以制作3个&ePonigiri&r。"
		""
		"加入鱼、肉、鸡蛋或蔬菜等营养调味料，即可成为馅料。"
	]
	quest.4F03EEF41A2041C4.title: "Rice Ball Run"
	quest.4F0E48F92722C8CE.quest_desc: [
		"铁、一个&e史莱姆方块&r、一个&e粘性活塞&r和火药可以制作一个&e弹簧发射器&r。"
		""
		"为其供电后它会弹出，将上面的物品抛向空中。从5格以上的高度落下会自动触发。"
	]
	quest.4F0E48F92722C8CE.title: "嘭！"
	quest.4F4974AA9981DD50.quest_desc: [
		"&6价格：&r &e1,500 CobbleDollars&r 一个。"
		""
		"在战斗中使用时，暂时提高宝可梦的暴击率"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.4F4974AA9981DD50.quest_subtitle: "1,500 CD"
	quest.4F4974AA9981DD50.title: "致命一击"
	quest.4F5C2B65261022FF.quest_desc: [
		"捕捉一只 &eCrabrawler&r。"
		""
		"常见于&6白色悬崖&r和砾石海滩上。"
	]
	quest.4F5C2B65261022FF.title: "螃蟹拳击手"
	quest.4F8540D2BCA3BCE0.quest_desc: [
		"登记了 &e500&r 个物种为 &e已发现&r（已捕获物种数也计入）。"
		""
		"扫描你遇到的所有东西。已发现的条目会告诉你某个物种存在于此处，甚至在你捕捉到它之前。"
	]
	quest.4F8540D2BCA3BCE0.title: "无处不在的眼睛"
	quest.4F94564E4F406615.quest_desc: [
		"成熟的杏核有时会掉落&e杏核幼苗&r，矿道宝箱里也会出现幼苗。"
		""
		"每种颜色都种一棵树苗，就再也不用狩猎精灵球材料了。阿普里康在所有季节都会生长。"
	]
	quest.4F94564E4F406615.title: "Reapriforestation"
	quest.4FAFBF2CDE84B946.quest_desc: [
		"捕捉任意种类的3只宝可梦。"
		""
		"不同物种各司其职：混合类型，避免单一弱点横扫全队。"
	]
	quest.4FAFBF2CDE84B946.title: "不断壮大的团队"
	quest.4FE25365A25C5A54.quest_desc: [
		"&6价格：&r &e2,500 CobbleDollars&r 一个。"
		""
		"若持有者受到物理攻击，攻击者将损失其最大生命值的1/8"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.4FE25365A25C5A54.quest_subtitle: "2,500 CD"
	quest.4FE25365A25C5A54.title: "Jaboca浆果"
	quest.4FE67D1128DDD13E.quest_desc: [
		"捕捉 &e10&r 只等级为 &e10&r 或以下的宝可梦。"
		""
		"&a提示：&r&eNest Ball&r的目标层级越低，效果越强，最高可达4倍。"
	]
	quest.4FE67D1128DDD13E.title: "小不点鱼块"
	quest.4FE89625ABBA4883.quest_desc: [
		"用&e颌骨化石&r复活一只&e蒂拉特&r（岩石/龙）。"
		""
		"在侵蚀柱、繁茂巢穴、泥坑和焦土巢穴中寻找它。"
	]
	quest.4FE89625ABBA4883.title: "Tyrunt"
	quest.4FEA698908D79C11.quest_desc: [
		"用&e快速球&r捕捉一只宝可梦。"
		""
		"&a速度快是其专长：在 REI 中查看基础属性。&r"
	]
	quest.4FEA698908D79C11.title: "必须得加快速度了"
	quest.4FF93F649A747905.quest_desc: [
		"捕捉一只&6闪光传说宝可梦&r。"
		""
		"闪光宝可梦出现的概率是 1/4096，传说宝可梦本来就很稀有。很少有训练家能亲眼见到。"
	]
	quest.4FF93F649A747905.title: "一个闪耀的传说"
	quest.500154447D91B9C1.quest_desc: ["在清醒梦游中安然入睡。一个美梦可能会在你的枕头上留下一根&e月光羽毛&r。"]
	quest.500154447D91B9C1.title: "做个好梦"
	quest.5012AA488CBDB0E9.quest_desc: [
		"对准大约10格内的宝可梦，按住&ePokédex&r的使用键即可扫描。轻点使用键以浏览条目。"
		""
		"扫描3只宝可梦。接下来的内容将由&c宝可梦图鉴研究&r章节完成。"
	]
	quest.5012AA488CBDB0E9.title: "野外笔记"
	quest.501716F6CE7E8E56.quest_desc: [
		"&aCarbink&r 会出现在钻石矿石旁边的黑暗洞穴中。"
		""
		"抓住一个，然后检查它周围的墙壁。"
	]
	quest.501716F6CE7E8E56.title: "未经雕琢的钻石"
	quest.50189BC3B8CCBF7D.quest_desc: [
		"世界上最高、最热的地方。"
		""
		"山脉隐藏着&e龙&r和&e格斗&r系宝可梦；火山则带来了&e火&r和某些最稀有的传说。"
		"&a提示：&r部分生物需要一定高度，例如加拉尔 Articuno 需要在 Y 110 以上。"
	]
	quest.50189BC3B8CCBF7D.title: "山峰与火山"
	quest.501AB151EAEA508A.quest_desc: [
		"野生&e薄荷&r植物生长在高于 Y 70 的高地，越往上爬越常见。"
		""
		"叶子颜色：&c红色&r攻击，&9蓝色&r防御，&b青色&r特攻，&d粉色&r特防，&a绿色&r速度，&f白色&r中立。"
		""
		"&a提示：&r完全成熟的白薄荷可以掉落其他颜色的种子。"
	]
	quest.501AB151EAEA508A.title: "薄荷清新"
	quest.5046AE6C6629325C.quest_desc: [
		"&6价格：&r &e2000 CobbleDollars&r 一个。"
		""
		"用草莓甜卷将奶油怪进化成奶油怪（奶油卷）"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.5046AE6C6629325C.quest_subtitle: "2000 冷却时间"
	quest.5046AE6C6629325C.title: "草莓甜心"
	quest.50648334925944BE.quest_desc: [
		"在&e金背包&r周围放置&e8个钻石&r。"
		""
		"&e108个物品栏&r和&e5个升级槽&r：足以容纳完整的升级配置。"
	]
	quest.50648334925944BE.title: "钻石背包"
	quest.5065779843ED5D32.quest_desc: [
		"&o多人模式。&r 通过该玩家的交互菜单与另一名训练家交换宝可梦。"
		""
		"某些物种只有在交易时才会进化；请参阅&c进化&r章节。"
	]
	quest.5065779843ED5D32.title: "请好好照顾它们！"
	quest.5073E05EF6519E61.quest_desc: ["&eKelpsy Berry&r + Hearty Grains + 蜂蜜。每块Mochi提升4点&e攻击力&r努力值。"]
	quest.5073E05EF6519E61.title: "肌肉麻薯"
	quest.5082BC355C933C5F.quest_desc: [
		"使用月亮石作用于Clefairy、Jigglypuff、Nidorina、Nidorino、Skitty或Munna，或使用闪光石作用于Togetic、Roselia、Minccino或Floette。"
		""
		"拿着石头，然后对宝可梦使用它。"
	]
	quest.5082BC355C933C5F.title: "月光与闪闪星光"
	quest.5093EDED6276E219.quest_desc: [
		"&6价格：&r &e6,000 CobbleDollars&r 一个。"
		""
		"将巨钳螳螂进化为钳螳螂"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.5093EDED6276E219.quest_subtitle: "6,000 CD"
	quest.5093EDED6276E219.title: "黑色奥古里特矿石"
	quest.50A94D6FED81A27C.quest_desc: [
		"&6价格：&r &e500 CobbleDollars&r 一个。"
		""
		"在最大HP的1/4或更少时恢复1/3最大HP；若为-特防性格则会混乱"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.50A94D6FED81A27C.quest_subtitle: "500 CD"
	quest.50A94D6FED81A27C.title: "阿瓜夫浆果"
	quest.50B02D3A86EBD2A2.quest_desc: [
		"&e烈焰人&r在末地要塞的生成器附近漂浮，并会发射火球。雪球能伤害它们。"
		""
		"击杀 10 次。火焰抗性会让战斗偏向于你。"
	]
	quest.50B02D3A86EBD2A2.title: "消防员"
	quest.50B969BB75EBB617.quest_desc: [
		"《宝可梦传说：Z-A》中的新mega宝可梦之一。"
		"让&e巨沼怪&r进行超级进化。"
		""
		"配方：原始巨石、一颗钻石、一颗&e剃刀牙&r和两颗&e青金石&r。"
	]
	quest.50B969BB75EBB617.title: "Feraligite"
	quest.50BC2C0594FB41D2.quest_desc: [
		"一个&e下界合金箱子&r、一个连锁的&e存储控制器&r网络、一个&e合成终端&r和一个&e高级无线终端&r：你的存储系统现在能为你自动工作了。"
		""
		"完成全部四项后领取。某处的宝可梦中心护士会点头赞许。"
	]
	quest.50BC2C0594FB41D2.title: "&l万物各得其所之地"
	quest.50D1DB6855D17583.quest_desc: [
		"在合成网格中将 &e箭&r 和 &e绳子&r 组合，可装载 &e绳索箭&r（最多32根绳子）。"
		""
		"朝墙壁或悬崖发射，它就会在落点铺出一条绳索：即时的攀爬绳。"
	]
	quest.50D1DB6855D17583.title: "钩锁射击器"
	quest.50F255D5FF4DD232.quest_desc: [
		"找到一个&e蘑菇村庄&r。"
		""
		"CTOV 只在稀有的 &6蘑菇田&r建造这些，通常远离海岸。"
	]
	quest.50F255D5FF4DD232.title: "欢乐伙伴"
	quest.50F31143DB180DF7.quest_desc: [
		"&eTNT&r wrapped in four &eIron Ingots&r with a &eString&r fuse. Throw a &eBomb&r for a small blast that only breaks weak blocks."
		""
		"&a提示：&r在地下城、矿井和要塞的箱子里寻找更强的&9蓝色炸弹&r。"
	]
	quest.50F31143DB180DF7.title: "小心处理，轻拿轻放"
	quest.513DDB16B634F6C4.quest_desc: [
		"合成一个&eMegaroid Compass&r：一个由四个铁锭、两个紫水晶碎片和两个红石组成的罗盘。"
		""
		"右键搜索最近的&6Megaroid&r，Shift+右键可重置。仅在主世界有效。"
	]
	quest.513DDB16B634F6C4.title: "陨石探测器"
	quest.513EF000CA24D7FA.quest_desc: [
		"&e史莱姆&r在夜间沼泽和地下深处的特殊史莱姆块中生成。大史莱姆会分裂成小史莱姆。"
		""
		"击杀10个史莱姆。史莱姆球可以制作牵引绳、粘性活塞和岩浆膏。"
	]
	quest.513EF000CA24D7FA.title: "会弹跳的黏液块"
	quest.5140F76A2B5B6C0F.quest_desc: [
		"&e远古残骸&r是下界中最稀有的矿石。较大的矿脉位于&eY 8和Y 24&r之间，且从不与空气接触生成。"
		""
		"需要一把钻石镐，免疫爆炸和岩浆。许多矿工用TNT或床来爆破隧道，因为床在下界会爆炸。"
	]
	quest.5140F76A2B5B6C0F.title: "被埋藏的宝藏"
	quest.5159B95A842A2E57.quest_desc: [
		"Cobblemon 添加了 &e下界火石矿石&r，遍布所有下界生物群系的下界岩中。找到一个即可完成此任务。"
		""
		"挖掘会掉落&e火石&r（时运附魔有效）。火石会进化成&e九尾&r、&e卡蒂狗&r、&e伊布&r（进化为炎狮）、&e暖暖猪&r和&e火球鼠&r。"
	]
	quest.5159B95A842A2E57.title: "岩石中的余烬"
	quest.5159DED5D6BC6AA9.quest_desc: [
		"&6价格：&r &e5,000 CobbleDollars&r 一个。"
		""
		"&a点击对勾即可购买。可重复购买，仅在您负担得起时收费。&r"
	]
	quest.5159DED5D6BC6AA9.quest_subtitle: "5,000 CD"
	quest.5159DED5D6BC6AA9.title: "白色草药"
	quest.515BA4C3E8A4233E.quest_desc: [
		"&e凋零骷髅&r手持能造成凋零效果的石剑，在末地要塞中徘徊。"
		""
		"击杀10只。每只都有极小概率掉落&e凋零骷髅头颅&r，而凋零需要三个。"
	]
	quest.515BA4C3E8A4233E.title: "骨骸干燥"
	quest.516861D21DA9278D.quest_desc: [
		"将附近的物品拉向你。"
		""
		"&6查找地点：&r废弃传送门、沉船宝藏、沙漠水井旁；猪灵偶尔会佩戴。"
	]
	quest.516861D21DA9278D.title: "通用引力装置"
	quest.516DAD86B826AD93.quest_desc: ["捕捉5只神话宝可梦。"]
	quest.516DAD86B826AD93.title: "神话猎人"
	quest.518D4D07F91429CD.quest_desc: [
		"集齐八个徽章后，&e宿敌特里&r想要再打一仗。在平原或末地城市附近找到他。"
		""
		"Staraptor、Electivire、Darmanitan、Hatterene、Kartana 和 Blastoise。"
	]
	quest.518D4D07F91429CD.quest_subtitle: "竞争对手 泰瑞"
	quest.518D4D07F91429CD.title: "最后一次机会吗？"
	quest.51919E22EBAF70E9.quest_desc: ["在夜间将伊布升级到160或以上亲密度。"]
	quest.51919E22EBAF70E9.title: "Umbreon"
	quest.5195327D336D9E44.quest_desc: [
		"&6价格：&r &e2000 CobbleDollars&r 一个。"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.5195327D336D9E44.quest_subtitle: "2000 冷却时间"
	quest.5195327D336D9E44.title: "龙之宝石"
	quest.51AFE76526DAB814.quest_desc: ["在末地找到&bHeatran洞穴&r（携带岩浆石和追踪的Arc Phone），并将石头放在底座上以召唤&dHeatran&r。"]
	quest.51AFE76526DAB814.title: "岩浆潜伏者"
	quest.51EB369583C940F3.quest_desc: [
		"六个&e白色羊毛&r和一个木棍可以制作一面&e旗帜&r（染色羊毛可制作彩色旗帜）。"
		""
		"放置木棍建造旗杆并悬挂旗帜；右键或左键点击旗杆可升降旗帜。"
	]
	quest.51EB369583C940F3.title: "插上你的旗帜"
	quest.51F0F67792F3E445.quest_desc: [
		"用&e网球&r捕捉一只宝可梦。"
		""
		"&a在属性和虫属性的宝可梦上试试吧。&r"
	]
	quest.51F0F67792F3E445.title: "除了网络一无所有"
	quest.51F4B1D44D5BAD33.quest_desc: [
		"&6价格：&r &e8,000 CobbleDollars&r 一个。"
		""
		"使宝可梦的经验值增加30000经验值"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
