	quest.5AD52DB17D912CAA.title: "Chesto Berry"
	quest.5AF299425C006177.quest_desc: [
		"使用工具对宝可梦进行操作以收集产物。几个例子："
		"用桶在&eMiltank&r上获取牛奶，用玻璃瓶在&eVespiquen&r上获取蜂蜜，用刷子刷鸟类宝可梦获取羽毛，用桶在&eNumel&r或&eSlugma&r上获取岩浆。"
	]
	quest.5AF299425C006177.title: "乡村小屋的温馨时光"
	quest.5AFC3CA6E00A3CD5.quest_desc: [
		"在 &eStorage Upgrade Base&r 周围放置 &e2 Iron Ingots&r、&e2 Pistons&r 和 &e2 Redstone&r。"
		""
		"仅限存储：物品进出时会自动压缩和解压。"
	]
	quest.5AFC3CA6E00A3CD5.title: "压缩升级 (Compression Upgrade)"
	quest.5B169F2185E4867E.quest_desc: [
		"在丛林中找到 Explorify 的 &e遗迹&r。"
		""
		"纪念碑周围的废墟，里面有宝藏和需要处理的生成器。"
	]
	quest.5B169F2185E4867E.title: "失落的城市"
	quest.5B2C056E4F7528B3.quest_desc: [
		"酿造一瓶&c治疗药水&r：粗制药水 + &e发光甜瓜片&r。"
		""
