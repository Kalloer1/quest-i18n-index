	quest.5AA8ABCBCA431195.quest_desc: [
		"合成一个&eTera Orb&r：四个紫宝石碎片、一个末影珍珠、两个萤石粉、一颗钻石和烈焰粉。"
		""
		"佩戴在 &eTera Wear&r 栏位。每只宝可梦都有自己的 Tera 类型。"
	]
	quest.5AA8ABCBCA431195.title: "水晶球"
	quest.5AAC2434DF3444BE.quest_desc: [
		"与任意村民完成一次交易。"
		""
		"右键点击有职业的村民可查看其交易内容。交易可以提升等级，解锁更好的交易。"
		"&a绿宝石是货币，许多村民会用绿宝石来换取农作物、纸张或煤炭等日常用品。&r"
	]
	quest.5AAC2434DF3444BE.title: "开业大吉"
	quest.5AB6A448F26216C7.quest_desc: [
		"五个&e铁粒&r和一个&e铁锭&r可以制作一个&e高脚杯&r。"
		""
		"放置它并倒入饮品。适合你餐厅的精致餐具。"
	]
	quest.5AB6A448F26216C7.title: "王者风范，无可挑剔"
	quest.5AB7A4107D125843.quest_desc: ["在伊布上使用一个&e冰石&r。"]
