		""
		"Dhelmise 在残骸间游荡，地图箱里藏着一张埋藏宝藏的地图。"
	]
	quest.75E161AF4D601C24.title: "弃船逃生"
	quest.75E5A99FCEAFCA0E.quest_desc: [
