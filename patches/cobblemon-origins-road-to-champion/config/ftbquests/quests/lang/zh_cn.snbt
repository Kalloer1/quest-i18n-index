	quest.0BF50212DD5006AD.quest_subtitle: "冷却时间 10,000 次"
	quest.0BF50212DD5006AD.title: "黑色污泥"
	quest.0BFA85E913FFAC53.quest_desc: [
		"击杀 50 只 &e苦力怕&r。"
		""
		"每个梯子的上层都关乎耐力。一把好剑、一套好盔甲和一个光线充足的基地会有所帮助。"
	]
	quest.0BFA85E913FFAC53.title: "爆破专家"
	quest.0C01F5717316EEAD.quest_desc: [
		"用5个铁锭、2个玻璃、1个精灵球和1个分配器制作一个&ePoké Gacha Machine&r。"
		""
		"喂食 Relic Coins 后，每次拉动会掉落一个胶囊：普通 51%、优秀 24%、超极 15%、大师 7%、珍藏 3%。"
	]
	quest.0C01F5717316EEAD.title: "投入硬币"
	quest.0C401CA266E7C0EC.quest_desc: [
		"由 &ePickup Upgrade&r、&eEnder Pearls&r、&eIron&r、&eRedstone&r 和 &eLapis&r 合成。"
		""
		"将附近 &e3 格&r 内的物品吸入背包。非常适合掉落物散落的宝可梦战斗。"
	]
	quest.0C401CA266E7C0EC.title: "磁石升级"
	quest.0C6D377FE4BC2F95.quest_desc: [
		"一块&e铭文&r：6个&e金锭&r、2个&e紫水晶碎片&r和&e深板岩&r。"
		""
		"死亡时若背包中有物品，附近会出现一个&eFleeting Memorial&r，即一个可传送回去的界碑。你的坟墓和物品都已在其中等候。"
	]
	quest.0C6D377FE4BC2F95.title: "最后的话语"
	quest.0C8D5AF488BF4460.quest_desc: [
		"找到一个&e流浪商人&r。他偶尔会带着两只羊驼出现在玩家附近。"
		""
		"他的提议和普通村民不同，所以快看看他带来了什么。"
	]
	quest.0C8D5AF488BF4460.title: "只是路过而已"
	quest.0CE4B257FA45AF96.quest_desc: [
		"《宝可梦传说：Z-A》中的新mega宝可梦之一。"
		"让&eZygarde&r以完全形态进行超级进化。"
		""
		"配方：原始巨石、一颗钻石、一颗&e下界之星&r和两个&e下界合金锭&r。"
	]
	quest.0CE4B257FA45AF96.title: "Zygardite"
	quest.0CF08F5BA4593DB2.quest_desc: [
		"合成一个 &eFishingNav&r：需要 4 个 &ePrismarine Shards&r、&ePrismarine Crystals&r、&eRedstone&r、一个 &eElectirizer&r、一个 &eWater Gem&r 和一个 &eUpgrade&r。"
		""
		"钓鱼时，潜行并右键点击以查看能咬住鱼的东西。水宝石由硬石和帕索浆果合成。"
	]
	quest.0CF08F5BA4593DB2.title: "鱼类探测器"
	quest.0D0B4DFC2FF13757.quest_desc: [
		"合成一个&e友谊球&r：在&e铁锭&r周围放置2个绿色杏、1个红色杏和1个黄色杏。"
		""
		"&6捕获率：&r 1倍，宝可梦初始友好度为150。"
	]
	quest.0D0B4DFC2FF13757.title: "友谊球"
	quest.0D0B58AD23DF327E.quest_desc: [
		"&e烟熏尾咖喱&r需要一根&e美味尾巴&r：剪一只Slowpoke的尾巴即可获得。尾巴大约20分钟后会重新长出来。"
		""
		"配方：Hearty Grains、Tasty Tail、一个&e胡萝卜&r和&eGalarica坚果&r。"
	]
	quest.0D0B58AD23DF327E.title: "双城记的尾巴"
	quest.0D29F8D56EA1B8BA.quest_desc: [
		"青金石矿石最常见于 y=0 附近，每个矿石会掉落 4 到 9 个。"
		""
		"&a宝可梦提示：&r青金石可以放入&e经验共享&r。附魔台也需要用到它。"
	]
	quest.0D29F8D56EA1B8BA.title: "深邃的蓝色"
	quest.0D4385308673175E.quest_desc: [
		"找到一个&e渔船&r。它们停泊在沙滩上，或者温暖深海的海底。"
		""
		"检查船上的箱子：这是钓竿锻造模板可能出现的地方之一。"
	]
	quest.0D4385308673175E.title: "扬起船锚，启航出发"
	quest.0D53C6045ABEDB77.quest_desc: [
		"驯服每种变体的狼各一只。"
		""
		"每种变种都生活在不同的生物群系中，所以这个会带你走遍世界各地。"
	]
	quest.0D53C6045ABEDB77.title: "整个整合包"
	quest.0D572093C9100BF2.quest_desc: [
		"让&e巨沼怪&r进行超级进化。"
		""
		"配方：原始巨岩、两个铁锭、一颗钻石和 &e神秘之水&r。"
	]
	quest.0D572093C9100BF2.title: "Blastoisinite"
	quest.0D5782263EFC9EDB.quest_desc: [
		"近战攻击会恢复你造成伤害的五分之一，每次最多3颗心。"
		""
		"&6查找地点：&r矿井宝箱、村庄盔甲匠、温暖的海洋废墟；偶尔由残骸穿戴。"
	]
	quest.0D5782263EFC9EDB.title: "吸血鬼手套"
	quest.0D64BAC773A4230C.quest_desc: ["击败 &e500&r 只野生宝可梦。你的队伍需要更多提升：通过努力值、个体值和携带物来培养它们。"]
	quest.0D64BAC773A4230C.title: "久经沙场，百战百胜"
	quest.0D69930AD0BA1D0D.quest_desc: ["打开一个 Lootr &e矿车&r。矿井中的箱子矿车已被转换，这样每个玩家都能乘坐。"]
	quest.0D69930AD0BA1D0D.title: "Mine Cart, Your Cart"
	quest.0D6C593C13161348.quest_desc: [
		"&6价格：&r &e5,000 CobbleDollars&r 一个。"
		""
		"将宝可梦的能力值改为内敛性格的数值"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.0D6C593C13161348.quest_subtitle: "5,000 CD"
	quest.0D6C593C13161348.title: "Modest Mint"
	quest.0D86F3982C380ED5.quest_desc: [
		"在 &e营火锅&r 中烹饪 &eMax Soup&r：三个 Max 蘑菇加一个碗。"
		""
		"将其喂给拥有巨化形态的宝可梦以解锁该形态。加入Max Honey制作Sweet Max Soup，部分宝可梦更喜欢这个。"
	]
	quest.0D86F3982C380ED5.title: "巨人的汤 (Soup of the Giants)"
	quest.0D8D3A87C89A5C6C.quest_desc: [
		"&6价格：&r &e400 CobbleDollars&r 一个。"
		""
		"1× 捕获率"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.0D8D3A87C89A5C6C.quest_subtitle: "400 CD"
	quest.0D8D3A87C89A5C6C.title: "远古蔚蓝球体"
	quest.0DA3B38CE9BE2035.quest_desc: [
		"收集全部七个巨型手环：白色、红色、黄色、粉色、绿色、蓝色和黑色。"
		""
		"每个都使用对应的 Apricorn 颜色，并且每个都需要自己的 Keystone。"
	]
	quest.0DA3B38CE9BE2035.title: "每种颜色的力量都各不相同"
	quest.0DA8C7228684C726.quest_desc: [
		"在&e锻造台&r上，将&e下界合金升级锻造模板&r、你的&e钻石背包&r和&e下界合金锭&r组合起来。"
		""
		"包里最大的背包：&e120格&r和&e7个升级槽&r。用本章所学的一切填满它们。"
	]
	quest.0DA8C7228684C726.title: "&l下界合金包（The Netherite Pack）"
	quest.0DB9471ABC96A94A.quest_desc: [
		"使用&e4块铁锭&r进行&e入门&r升级。"
		""
		"每个槽位可容纳 &e2x&r 倍的物品堆叠。一个背包最多可安装 &e3&r 个堆叠升级。"
	]
	quest.0DB9471ABC96A94A.title: "堆叠升级 第1级"
	quest.0DC83AB5FE095CDE.quest_desc: ["&ePomeg Berry&r + Hearty Grains + 蜂蜜。每块Mochi提升4点&eHP&r努力值。"]
	quest.0DC83AB5FE095CDE.title: "健康麻薯"
	quest.0DC9D6B7245706D8.quest_desc: [
		"完整的图书馆、铁砧、滞留型药水，还有你自己的信标：原版魔法再无秘密可言。"
		""
		"领取奖励，然后带上几瓶火抗和恢复药水，为接下来的旅途做好准备。"
	]
	quest.0DC9D6B7245706D8.title: "神秘魔法大师"
	quest.0DD285C74E4A1FAB.quest_desc: [
		"烹饪所有十种地区美食。其余八种："
		"&e愤怒棒棒糖&r：小麦、牛奶、糖、可可豆。"
		"&e岩浆饼干&r: 2 颗饱腹谷物、干海带、岩浆奶油。"
		"&e欢乐麦芬&r: 2 颗饱腹谷物、蜂蜜、甜浆果。"
		"&e旧式蛋糕&r: 马铃薯、甜菜根、蜂蜜、糖。"
		"&e卡斯蒂利亚锥&r：小麦、牛奶、雪球、糖。"
		"&e卢米奥斯薄饼&r：小麦、牛奶、糖、发光浆果。"
		"&e大马拉萨达&r：小麦、牛奶、糖、一个甜瓜块。"
		"&e开放式三明治&r：面包、鸡蛋、生肉和蔬菜。"
	]
	quest.0DD285C74E4A1FAB.title: "环球美食之旅"
	quest.0DD844145CF2F943.quest_desc: [
		"金矿位于 y=32 以下，大部分在 y=-16 左右。恶地是金矿宝库：那里的金矿从 y=32 一直延伸到 y=256。"
		""
		"收集足够的原始黄金以制作一个&e原始金块&r。"
	]
	quest.0DD844145CF2F943.title: "黄金热"
	quest.0DF0DDD2B8060214.quest_desc: [
		"完成&6战斗前线&r：训练与对战、冠军之路、超级进化、Z招式、太晶化与极巨化，以及突袭巢穴。"
		""
		"击败所有训练家，掌握所有技巧，击倒所有首领。"
		""
		"&a所列章节的每个最终章完成后解锁；然后勾选复选框。&r"
	]
	quest.0DF0DDD2B8060214.title: "战斗传奇"
	quest.0DF2473E44F2E4D8.quest_desc: [
		"木板、一个&ePC&r、一个漏斗和两个小麦可以合成一个&ePasture Block&r。"
		""
		"在基地建造一个，你就拥有了牧场的核心：紧邻农田的宝可梦家园。"
	]
	quest.0DF2473E44F2E4D8.title: "牧场建造者"
	quest.0DF947AD3D9BF966.quest_desc: [
		"&6价格：&r &e8,000 CobbleDollars&r 一个。"
		""
		"偶尔允许持有者先发制人地发起攻击"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.0DF947AD3D9BF966.quest_subtitle: "8,000 CD"
	quest.0DF947AD3D9BF966.title: "快速爪击"
	quest.0E000BD998466204.quest_desc: [
		"将Tumblestone放置在&eLava&r或&eMagma Block&r旁边。"
		""
		"高温能让它从芽期长成簇。打破簇可获得更多 Tumblestone，从此不再短缺。"
	]
	quest.0E000BD998466204.title: "翻滚坠落"
	quest.0E22F0F8E6E7C785.quest_desc: [
		"找到一个&e黎明石&r。"
		""
		"&6矿石：&r山峰和天空之地，在花卉生物群系、冰川生物群系和丘陵中较为罕见。"
		"&6进化自：&r雄性可尔尼和雌性雪拉比。"
	]
	quest.0E22F0F8E6E7C785.title: "破晓之光"
	quest.0E23C54E652E475F.quest_desc: [
		"挖掘 &e煤炭原矿&r。它常见于 y=0 到山顶的整个区域。"
		""
		"&a宝可梦提示：&r 煤炭龟喜欢出生在煤炭矿石旁边。"
	]
	quest.0E23C54E652E475F.title: "黑金"
	quest.0E3F469F11B82E58.quest_desc: [
		"&6价格：&r &e15,000 CobbleDollars&r 一个。"
		""
		"如果持有者尚未完全进化，则提升其防御力和特防力"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.0E3F469F11B82E58.quest_subtitle: "冷却时间 15,000"
	quest.0E3F469F11B82E58.title: "Eviolite"
	quest.0E4B8D2BC2FB69CE.quest_desc: [
		"钓上10只宝可梦。"
		""
		"河流、海洋、温暖、寒冷和冰冻水域各有自己的钓鱼列表。四处走动吧。"
	]
	quest.0E4B8D2BC2FB69CE.title: "码头上的常客"
	quest.0E50EA4DD6061F2E.quest_desc: ["&dPalkia&r的底座也立在Spear Pillar。用Red Chain召唤它，并保留它留下的&eSpace Globe&r。"]
	quest.0E50EA4DD6061F2E.title: "太空之主"
	quest.0E64012465A4A10B.quest_desc: [
		"&e共享石&r能将你传送到任何其他&e同色&r的共享石。"
		""
		"配方：3个&e石砖&r、2个染料、1个&e传送石&r和3个&e黑曜石&r。所有颜色都有效；此任务需要一对&5紫色&r的。"
	]
	quest.0E64012465A4A10B.title: "派对热线"
	quest.0E6E557FD1A32FCF.quest_desc: [
		"孵化鸡蛋，并用鸡蛋任务中的&eTorchflower Seeds&r喂养小嗅嗅。"
		""
		"长大后，成年嗅探者会从草地和泥土中挖掘出更多远古种子。"
	]
	quest.0E6E557FD1A32FCF.title: "Little Sniffer"
	quest.0E6FCB084277CE7B.quest_desc: [
		"七块玻璃、一个末影之眼和一个&e恶魂之泪&r可以合成一个&e末地水晶&r。"
		""
		"将其中四个放置在出口传送门上会再次召唤出龙。让它们远离你：被击中时会爆炸。"
	]
	quest.0E6FCB084277CE7B.title: "水晶般清澈"
	quest.0E7876E0A4F2C100.quest_desc: [
		"杀死 50 只 &e蜘蛛&r。"
		""
		"每个梯子的上层都关乎耐力。一把好剑、一套好盔甲和一个光线充足的基地会有所帮助。"
	]
	quest.0E7876E0A4F2C100.title: "蜘蛛恐惧症已治愈"
	quest.0E8A91AC283B9625.quest_desc: [
		"将 &e蜂蜜瓶&r 涂抹在 &e甜木原木&r 上。"
		""
		"糖枫树生长在桦林、花田、魔法和泰加生物群系中。树干上的蜂蜜会吸引宝可梦前来，每只被吸引的宝可梦都有 &e1/100&r 的几率成为 &e阿尔法&r。"
	]
	quest.0E8A91AC283B9625.title: "只是一条小鲭鱼而已"
	quest.0E8BB09AEAC7042A.quest_desc: [
		"大多数宝可梦在满足特定条件后会进化成更强的形态：通常是等级，有时是石头、交易、友谊或其他更奇特的条件。"
		""
		"本章将介绍整合包中所有类型的进化。"
		"&a提示：&r携带&eEverstone&r的宝可梦不会进化。"
	]
	quest.0E8BB09AEAC7042A.title: "&l进化"
	quest.0E940A30192C2458.quest_desc: [
		"&6价格：&r &e6,000 CobbleDollars&r 一个。"
		""
		"将Duraludon进化为Archaludon"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.0E940A30192C2458.quest_subtitle: "6,000 CD"
	quest.0E940A30192C2458.title: "金属合金"
	quest.0EA1A1F05BF16539.quest_desc: [
		"收集全部九种变体硬币。每种都是一种 Poké Gacha Coin 加一种额外材料："
		""
		"Erratic (紫色染料), Blueberry (青色染料), Tera (钻石), Citrine (黄色染料), Verdant (绿色染料), Azure (蓝色染料), Roseate (粉色染料), Slate (黑色染料), Premier (白色染料)."
	]
	quest.0EA1A1F05BF16539.title: "钱币收藏家"
	quest.0EBB810681945C57.quest_desc: [
		"&6价格：&r &e3,000 CobbleDollars&r 一个。"
		""
		"将 Applin 进化为 Dipplin"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.0EBB810681945C57.quest_subtitle: "3,000 冷却时间"
	quest.0EBB810681945C57.title: "糖浆苹果"
	quest.0EBE17BC0E81E23D.quest_desc: [
		"你的新手包里的&e铁镐&r算数。弄丢了？用三个铁锭和两根木棍就能再造一个。"
		""
		"它能挖掘金、红石、绿宝石和钻石矿石，以及所有 Cobblemon &e进化石矿石&r。从这里开始的是 &eInto the Depths&r 章节。"
	]
	quest.0EBE17BC0E81E23D.quest_subtitle: "工具包的那个算数"
	quest.0EBE17BC0E81E23D.title: "可靠的镐子"
	quest.0ED7A4A3D913A8F6.quest_desc: [
		"&eOmni Ring&r 是一款支持全部四种机制的配件：Mega进化、Z招式、Terastallization和Dynamax。"
		""
		"配方：一个Dynamax Band、任意Key Stone配件、任意Z-Ring、一个Netherite Ingot和一个Tera Orb。"
		"原始配方改用一颗许愿星、一颗基石、一颗闪亮石、一块下界合金锭和一个泰拉球。"
	]
	quest.0ED7A4A3D913A8F6.title: "&6全能戒指 (The Omni Ring)</c1>"
	quest.0F2D9E49387B71A1.quest_desc: [
		"在针叶林中找到一个 Explorify &e营地&r。"
		""
		"被遗弃的帐篷，里面留有一些补给品。"
	]
	quest.0F2D9E49387B71A1.title: "画布之下"
	quest.0F3D5929F1710427.quest_desc: [
		"用&e月亮球&r捕捉一只宝可梦。"
		""
		"&a满月之下最为适宜。&r"
	]
	quest.0F3D5929F1710427.title: "Moonstruck"
	quest.0F60DA4FFDD3EB84.quest_desc: ["合成一个&e特攻银色帽子&r：四个铁锭、两颗钻石和三个&e青色薄荷叶&r。它能将特攻个体值提升至31。"]
	quest.0F60DA4FFDD3EB84.title: "特攻 银色帽子"
	quest.0F63B2D612EC39E3.quest_desc: [
		"&6价格：&r &e2,500 CobbleDollars&r 一个。"
		""
		"完全恢复宝可梦的生命值"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.0F63B2D612EC39E3.quest_subtitle: "2,500 CD"
	quest.0F63B2D612EC39E3.title: "最大药水效果持续时间"
	quest.0F6EF0C8794C541A.quest_desc: [
		"在巨型遗址中用钻石镐（非丝绸之触）打破&e巨型水晶&r，可获得原矿&e巨型石头&r。"
		""
		"&a快捷方式：在&e高炉&r中熔炼多余的基石，即可将其变为原始巨石。&r"
		""
		"原矿石是每种物种的巨石的基石。"
	]
	quest.0F6EF0C8794C541A.title: "Rough Around the Edges"
	quest.0F89F5B3AC06C710.quest_desc: [
		"你的新手包里有一个&ePC&r：把它放在你的基地里。有了完整的队伍，新捕获的宝可梦会直接存入其中，它能容纳60个盒子，用于交换宝可梦。"
		""
		"&aWant one at an outpost too? Craft another from 4 Iron Ingots, 2 Copper Ingots, Glass and 2 Smooth Stone.&r"
	]
	quest.0F89F5B3AC06C710.title: "存储系统"
	quest.0F8AEF5222A0A0B5.quest_desc: [
		"用两个铜锭、两个下界石英和一个末影珍珠合成一个&e链接线缆&r。"
		""
		"将其用于通过交换进化的宝可梦，即可当场进化，无需搭档。该线缆将被消耗。"
	]
	quest.0F8AEF5222A0A0B5.title: "链接起来"
	quest.0F93159FA1D2A107.quest_desc: ["从一个不祥宝库中赢得一个&e重型核心&r。可能需要几次尝试，这是一个稀有的掉落。"]
	quest.0F93159FA1D2A107.title: "沉重的负担"
	quest.0FA724DB582E591A.quest_desc: [
		"&eLeppa&r and &eLum&r trees side by side can mutate a &eHopo Berry&r."
		""
		"两者均恢复10PP：Leppa在招式用尽时，Hopo在喂给宝可梦时。"
	]
	quest.0FA724DB582E591A.title: "能量点数"
	quest.0FE67ACFCA0882ED.quest_desc: [
		"火药、烈焰粉和煤炭或木炭可以制作成三个&e火药电荷&r。"
		""
		"每个都会点燃一个传送门或篝火一次，分配器会将它们作为火球发射。"
	]
	quest.0FE67ACFCA0882ED.title: "口袋火球"
	quest.0FEFC3D74586319F.quest_desc: [
		"&eSerene Seasons&r 在现实世界运行一个日历：春、夏、秋、冬，各24天（分为三个8天的子季节）。世界始于初春。"
		""
		"作物在反季节生长缓慢（提示框会列出适宜季节），但在 Y 48 以下全年生长。冬季带来雪和冰，雨水则随季节变化。"
		""
		"&aCraft a Calendar to check the date (Farm and Husbandry).&r"
	]
	quest.0FEFC3D74586319F.title: "季节更替"
	quest.1023878DA7E6457D.quest_desc: ["钓起150只宝可梦。水域的秘密对你而言已无所遁形。"]
	quest.1023878DA7E6457D.title: "老盐（Old Salt）"
	quest.106230ACC5858C8C.quest_desc: [
		"&eShipwreck Coves&r 是隐藏在冰冷海洋之下的洞穴。"
		""
		"被淹没的海湾有其专属的钓鱼列表（Chinchou、Horsea、Clamperl、Relicanth等），镀金宝箱里则藏着稀有宝藏。"
	]
	quest.106230ACC5858C8C.title: "沉没的秘密"
	quest.1073B8DD88F6C912.quest_desc: [
		"&6价格：&r &e6,000 CobbleDollars&r 一个。"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.1073B8DD88F6C912.quest_subtitle: "6,000 CD"
	quest.1073B8DD88F6C912.title: "弹出背包"
	quest.107DF032000832E1.quest_desc: [
		"将四件护甲全部升级到&e下界合金&r。需要四个模板和四个锭，所以尽早开始复制模板。"
		""
		"下界合金盔甲除了提供游戏中最强的保护外，还增加了击退抗性。"
	]
	quest.107DF032000832E1.title: "身披残骸的盔甲，抵御着末日的侵袭。"
	quest.1088405C363E6B27.quest_desc: [
		"用石匠台和铁锭制作一个&e凿子&r。"
		""
		"使用它可以在任何地方打开 Mason Table 菜单。"
	]
	quest.1088405C363E6B27.title: "凿子（Chisel）"
	quest.10A2C14E1B4FBBD3.quest_desc: [
		"历史铸就的陶罐、活生生的嗅探者、修剪过的盔甲和手中的战锤：过去已经吐露了它的秘密。"
		""
		"给你一个备用重型核心。多两把战镐总没坏处。"
	]
	quest.10A2C14E1B4FBBD3.title: "过去的守护者"
	quest.10A55F6CA8F1EFAA.quest_desc: [
		"&e甜菜种子&r会出现在村庄农场、矿井和地牢的箱子里。种植出 &e6 个甜菜&r。"
		""
		"六个甜菜根和一个碗可以做成甜菜根汤，猪也很喜欢。"
	]
	quest.10A55F6CA8F1EFAA.title: "Can't Beet It"
	quest.10A97587DE1D102A.quest_desc: [
		"用&e螺旋化石&r复活一只&e化石龙头龟&r（岩石/水）。"
		""
		"在滴水石绿洲、含水玛瑙袋、侵蚀柱、保存的骸骨和沙地巢穴中寻找它。"
	]
	quest.10A97587DE1D102A.title: "Omanyte"
	quest.10B8981C4F364AD3.quest_desc: [
		"找到一个&eTumblestone&r。"
		""
		"刷取 Cobblemon 遗迹的可疑沙子和砾石：Tumblestones 是它们的稀有战利品之一。"
		""
		"Tumblestones 是 &eAncient Poké Balls&r（Poké Ball Workshop 章节）的核心。Sky 和 Black Tumblestones 可以合成其他 Tumblestones。"
	]
	quest.10B8981C4F364AD3.title: "滚动的石头"
	quest.10D03DB2C2C14A31.quest_desc: [
		"&eCatch Indicator&r 会为你读取宝可梦图鉴。"
		""
		"野生宝可梦名称牌上的精灵球图标表示你已捕捉该物种。闪光和Alpha标记也会出现，而未注册过的物种会显示为&e???&r。"
	]
	quest.10D03DB2C2C14A31.title: "命名牌"
	quest.10E7A519F2121B05.quest_desc: [
		"制作一个&e天文台罗盘&r：一个由四个铁锭、两个紫水晶碎片和两个青金石环绕的罗盘。"
		""
		"右键点击以追踪最近的&6天文台&r。"
	]
	quest.10E7A519F2121B05.title: "Stargazer's Compass"
	quest.1113CA8776F6691F.quest_desc: [
		"捕捉10只&4格斗&r属性的宝可梦。双属性宝可梦两种属性都算数。"
		""
		"&6强效对抗：&r普通、冰、岩石、黑暗、钢铁"
	]
	quest.1113CA8776F6691F.title: "战斗精神"
	quest.11311C9AEFC823B2.quest_desc: [
		"&6价格：&r &e2000 CobbleDollars&r 一个。"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.11311C9AEFC823B2.quest_subtitle: "2000 冷却时间"
	quest.11311C9AEFC823B2.title: "火焰宝石"
	quest.116B6EAA3F645D11.quest_desc: [
		"找到一个&e大型&rCTOV村庄。"
		""
		"村庄有小型、中型和大型之分；大型村庄是三者中最稀有的。"
	]
	quest.116B6EAA3F645D11.title: "大城市灯光"
	quest.117E225EF388390C.quest_desc: [
		"解锁全部四个升级应用：PC、图鉴、治疗和末地箱。"
		""
		"&aA Pokédex, a PC, a healer and your Ender Chest in one pocket. Field trips just got easier.&r"
	]
	quest.117E225EF388390C.title: "完全加载的整合包"
	quest.117ED19A5366DE18.quest_desc: [
		"&e领袖米斯蒂&r管理着水边的&e蔚蓝道馆&r：&e海滩&r、&e石岸&r、&e白色悬崖&r、&e沼泽&r、&e温暖河流&r和&e温暖海洋&r。"
		""
		"只有在击败宿敌特里后，她才接受你的挑战。Frogadier、Floatzel、Starmie和Lanturn都对草系招式无效。"
	]
	quest.117ED19A5366DE18.quest_subtitle: "领袖：Misty，蔚蓝市道馆"
	quest.117ED19A5366DE18.title: "瀑布徽章"
	quest.118724F55A8A6FA8.quest_desc: [
		"繁殖游戏中的所有生物，从犰狳、墨西哥钝口螈到嗅探者。"
		""
		"穿越众多群系的漫长狩猎；一根牵引绳能让移动稀有生物变得容易得多。"
	]
	quest.118724F55A8A6FA8.title: "成双成对"
	quest.11B651F09BEB848A.quest_desc: [
		"将任意宝可梦培育到&e25级&r。"
		""
		"战斗是主要的经验来源，本整合包使所有战斗经验翻倍。 &e经验糖果&r（如下）可跳过繁琐的刷怪过程。"
	]
	quest.11B651F09BEB848A.title: "成长的烦恼"
	quest.11C18AC4F8315BEE.quest_desc: [
		"&e2 木板&r、一根 &e物品传输线缆&r 和一个 &e漏斗&r。"
		""
		"用于网络物品的导入或导出。右键点击物品以设置其过滤器。"
	]
	quest.11C18AC4F8315BEE.title: "基础库存漏斗"
	quest.11C300F90DBFA160.quest_desc: ["在末地城市的宝箱中找到一个&e尖塔&r盔甲修饰模板。"]
	quest.11C300F90DBFA160.title: "尖塔修剪"
	quest.11E0C4A5B0C39EAB.quest_desc: ["蓝色小浆果基地：&e+2 技能，-1 跳跃&r。"]
	quest.11E0C4A5B0C39EAB.title: "蓝色阿普里果汁"
	quest.1216B650DA0FBABB.quest_desc: [
		"&eBreezes&r会生成在试炼密室中，四处跳跃并发射风弹。"
		""
		"杀死5个。它们的&eBreeze Rods&r会变成风弹和军锤的柄。"
	]
	quest.1216B650DA0FBABB.title: "抓住风的力量"
	quest.12214CD237689906.quest_desc: [
		"骑乘的坐骑移动速度更快。"
		""
		"&6查找地点：&r废弃传送门、堡垒猪灵厩；僵尸偶尔会佩戴。"
	]
	quest.12214CD237689906.title: "牛仔帽"
	quest.122460D39712A984.quest_desc: ["用&eTamato Berry&r酿造PP Up，制作&eCarbos&r。每个可增加10点速度努力值。"]
	quest.122460D39712A984.title: "碳基生物"
	quest.1227E86E1D3E65EF.quest_desc: [
		"&6价格：&r &e6,000 CobbleDollars&r 一个。"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.1227E86E1D3E65EF.quest_subtitle: "6,000 CD"
	quest.1227E86E1D3E65EF.title: "深海之牙"
	quest.1237C8D064D97E4E.quest_desc: [
		"一个 &e压缩升级&r，需要 &e钻石&r、&e2个金锭&r和 &e3个红石&r。"
		""
		"添加了3x3配方：九个锭输入，一个方块输出。采矿储藏室的绝佳搭档。"
	]
	quest.1237C8D064D97E4E.title: "高级压缩升级组件"
	quest.124FA7E19876DE37.quest_desc: ["与你的羁绊忍蛙战斗，直到其&e羁绊之力&r能力激活。"]
	quest.124FA7E19876DE37.title: "正在同步中"
	quest.1266CEDFBFB338F7.quest_desc: [
		"在水面上快速奔跑。"
		""
		"&6查找地点：&r矿井宝箱、远古城市宝箱、埋藏宝藏、刷出遗迹。"
	]
	quest.1266CEDFBFB338F7.title: "水之疾驰者"
	quest.12691B351A0D46D9.quest_desc: [
		"找到一个&e稀有糖果&r：能让宝可梦的等级提升一级。"
		""
		"无法合成。在遗迹中寻找&eGilded Chests&r，或击败等级为66或更高的野生Alpha。"
	]
	quest.12691B351A0D46D9.title: "甜蜜的稀有物品"
	quest.128C19C423D5BF9D.quest_desc: [
		"&6价格：&r &e1,500 CobbleDollars&r 一个。"
		""
		"减半来自超有效的火系招式所受到的伤害"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.128C19C423D5BF9D.quest_subtitle: "1,500 CD"
	quest.128C19C423D5BF9D.title: "奥卡浆果"
	quest.128E080F7B9FE52F.quest_desc: ["&d固拉多&r极少出现在恶地或火山群系中。带上超球、状态技能和耐心。"]
	quest.128E080F7B9FE52F.title: "土地之主"
	quest.12A346F4C4758BF8.quest_desc: [
		"&6价格：&r &e1,000 CobbleDollars&r 一个。"
		""
		"1.5× 捕获率"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.12A346F4C4758BF8.quest_subtitle: "1,000 CD"
	quest.12A346F4C4758BF8.title: "运动球 (Sport Ball)"
	quest.12B3CB910C6CBA2E.quest_desc: [
		"捕获一只 &e阿尔法鲸鱼&r。"
		""
		"它们的卵在深海潜游，由&bWailmer&r和其他&bWailord&r护送。"
		"&a提示：&r&e潜水球&r在水下对战时威力提升3.5倍。"
	]
	quest.12B3CB910C6CBA2E.title: "叫我以实马利"
	quest.12B603FE44545EDF.quest_desc: [
		"&eCatch Rate Display&r HUD 会显示你面前宝可梦的真实捕捉率，并包含球、状态和HP的加成。"
		""
		"&e、&r可切换HUD，&eG&r可比较球。每个球的提示框都列出了其乘数。"
	]
	quest.12B603FE44545EDF.title: "阅读概率 (Reading the Odds)"
	quest.12D6B3D973B33508.quest_desc: [
		"&6价格：&r &e1,200 CobbleDollars&r 一个。"
		""
		"1× 至 4×，目标等级低于30时增幅越大"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.12D6B3D973B33508.quest_subtitle: "冷却时间：1200秒"
	quest.12D6B3D973B33508.title: "鸟巢球"
	quest.12DAC3DD1E044E16.quest_desc: [
		"&e精英四强布鲁诺&r正在&e关都联盟&r等候，该联盟位于&5末地&r的外围岛屿（末地高地和中部）的一座宏伟大厅中。用指南针寻找它吧。"
		""
		"联盟队伍：突袭乌尔修夫、巨钳螳螂、路卡利欧、铠甲勇士、冠冕藏马然特和路卡利欧。"
		""
		"他也会在洞穴和山脉中徘徊，有时是和不同的队伍。无论哪个队伍都算数，四天王可以按任意顺序挑战。"
	]
	quest.12DAC3DD1E044E16.quest_subtitle: "精英四强 布鲁诺"
	quest.12DAC3DD1E044E16.title: "石拳 (Fists of Stone)"
	quest.12DAD8928A0EA5EC.quest_desc: [
		"瞄准野生宝可梦并按下 &eR&r 让你的宝可梦出战。玩家无法伤害宝可梦，所以由你的队伍来战斗。"
		""
		"无经验值。只有参与战斗的宝可梦和持有&e经验共享&r（50%）的宝可梦才能获得经验值。所有经验值翻倍，等级上限为100。"
		""
		"捕获率显示手持球的捕获概率（&eG&r可比较球）。闪光宝可梦概率为1/4096，聊天会提示闪光和传说宝可梦的生成。"
	]
	quest.12DAD8928A0EA5EC.title: "战斗入门 101"
	quest.13004EA4DBAE18AE.quest_desc: [
		"合成一个&e月亮球&r：在&e铁锭&r周围放置2个黄色杏、1个蓝色杏和1个黑色杏。"
		""
		"&6捕获率：&r夜间为1至4倍，月亮越接近满月，捕获率越高。"
	]
	quest.13004EA4DBAE18AE.title: "月亮球"
	quest.1317DE8BEBCFE48F.quest_desc: [
		"&6价格：&r &e150 CobbleDollars&r 一个。"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.1317DE8BEBCFE48F.quest_subtitle: "150 冷却时间"
	quest.1317DE8BEBCFE48F.title: "黑色甜杏果 (Black Apricorn)"
	quest.131EDA59E89165C1.quest_desc: [
		"&6商店出售的物品&r"
		""
		"&ePoké Balls&r: Poké Ball 400, Great Ball 750, Ultra Ball 1,000, most specialty balls 600 to 2,500."
		"&e古代球&r、&e药品&r（Potion 600、Revive 3,000）、&e经验&r（EXP Candy S 400、Rare Candy 5,000、Exp. Share 15,000）。"
		"&eVitamins&r（各5,000）、&eEvolution&r道具（石头3,000）和&eHeld Items&r（Leftovers、Life Orb和Choice道具各15,000）。"
		""
		"&aClick the checkmark once you have browsed.&r"
	]
	quest.131EDA59E89165C1.title: "橱窗购物"
	quest.1329F66A570F77FB.quest_desc: [
