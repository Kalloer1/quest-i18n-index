	quest.51F4B1D44D5BAD33.quest_subtitle: "8,000 CD"
	quest.51F4B1D44D5BAD33.title: "经验糖果XL"
	quest.520A9BF9E2B90860.quest_desc: [
		"受到火焰伤害会获得30秒的火焰抗性（每分钟一次）。"
		""
		"&6查找地点：&r矿井宝箱、废弃传送门、沉船宝藏；猪灵偶尔会佩戴。"
	]
	quest.520A9BF9E2B90860.title: "黑曜石骷髅头"
	quest.520C670A824FDBC4.quest_desc: ["寻找&e光石碎片&r或&e暗石碎片&r。它们会出现在纪念碑的宝箱中（钟楼、洛奇亚神殿、自由岛、皇冠神殿、塔利克金字塔），由&c坚守者&r和&c凋零&r掉落，专家商人也会出售。"]
	quest.520C670A824FDBC4.title: "真理与理想的碎片 (Shards of Truth and Ideals)"
	quest.5228B3EAC3723CD8.quest_desc: [
		"酿造一瓶&7隐身药水&r：将一瓶&e夜视药水&r与发酵蜘蛛眼混合。"
		""
		"&c盔甲和手持物品仍然可见。&r"
	]
	quest.5228B3EAC3723CD8.title: "Now You See Me"
	quest.526D78C90C2F6FCF.quest_desc: [
		"一道简单的开胃菜：&e苹果&r、&e糖&r和&e木棍&r可以制作出&e糖衣苹果&r。"
		""
		"用3个浆果替换苹果，你就能得到&e糖渍浆果&r。"
	]
	quest.526D78C90C2F6FCF.title: "公平的食物"
	quest.5273D545770EF90E.quest_desc: [
		"&e凋零骷髅&r会巡逻堡垒，只有在被玩家杀死时才会掉落头骨：概率为2.5%，抢夺I为3.5%，每提升一级抢夺再增加1%。"
		""
		"三个头颅和四个灵魂沙可以召唤&c凋零&r。那场战斗在&e怪物猎人&r章节中。"
	]
	quest.5273D545770EF90E.title: "骷髅收集者"
	quest.5287C0C6B3B196BE.quest_desc: [
		"从铜矿脉到深暗，你已经绘制了地下世界的地图。"
		""
		"黑曜石开启了通往&c下界&r和&d附魔与酿造&r的道路。"
	]
	quest.5287C0C6B3B196BE.title: "地下世界的统治者"
	quest.52890FE1ABEE9855.quest_desc: [
		"一把木制&e剑&r、&e镐&r、&e斧&r和&e铲&r，周围环绕着&e铁&r和&e红石&r，以及一个&e升级台&r。"
		""
		"左键点击方块或生物时，背包中的右工具会替换到你手中。"
	]
	quest.52890FE1ABEE9855.title: "工具交换器升级"
	quest.529EE04446CB0275.quest_desc: [
		"&6价格：&r &e2,500 CobbleDollars&r 一个。"
		""
		"当生命值低于或等于最大值1/4时，随机提升一项属性2点"
		""
		"&a点击对勾即可购买。可重复购买，仅在您负担得起时收费。&r"
	]
	quest.529EE04446CB0275.quest_subtitle: "2,500 CD"
	quest.529EE04446CB0275.title: "星莓果 (Starf Berry)"
	quest.52B6C41F501BD210.quest_desc: [
		"在宝可梦图鉴中登记 &e25&r 种宝可梦为&e已捕获&r。"
		""
		"&a提示：&r&e重复球&r对已登记为捕获的物种有3.5倍效果，所以留着抓重复的。"
	]
	quest.52B6C41F501BD210.title: "数据库正在增长中"
	quest.52CB4B0973763912.quest_desc: [
		"有些宝可梦足够大可以载你。派一只出来，悄悄靠近并与之互动，然后选择&e骑乘&r。"
		""
		"游泳者、飞行者和奔跑者，骑乘方式各不相同：不妨都试试。"
	]
	quest.52CB4B0973763912.title: "宝可梦骑乘者！"
	quest.52EF5E8ECC0243E9.quest_desc: [
		"用羽毛、蓝色染料、木棍、2个煤炭、一个分配器和2个铁锭以及一个箱子制作一个&eCram-O-Matic&r。"
		""
		"喂食任意&eApricorn&r可获得随机精灵球、手持物或糖果。多余的Apricorn的好归宿。"
	]
	quest.52EF5E8ECC0243E9.title: "Cram-O-Matic"
	quest.530C9863B68C5A5F.quest_desc: [
		"&6价格：&r &e8,000 CobbleDollars&r 一个。"
		""
		"提升持有者的暴击率"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
