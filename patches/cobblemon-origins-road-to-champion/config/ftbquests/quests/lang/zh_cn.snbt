	quest.3835FD6CF0E4B9BF.title: "钙元素"
	quest.383E2B5A73199C75.quest_desc: [
		"&e锻造台&r、&e铁&r和一个围绕在&e升级基座&r旁的&e箱子&r。"
		""
		"升级台里的锻造台：离家远点，整理和升级下下界合金。"
	]
	quest.383E2B5A73199C75.title: "锻造台升级配方"
	quest.3846BDD4D0B8CA76.quest_desc: [
		"&6价格：&r &e600 CobbleDollars&r 一个。"
		""
		"当最大生命值低于或等于一半时，恢复最大生命值的1/4"
		""
		"&a点击对勾即可购买。可重复购买，仅在您负担得起时收费。&r"
	]
	quest.3846BDD4D0B8CA76.quest_subtitle: "600 CD"
	quest.3846BDD4D0B8CA76.title: "Sitrus 浆果"
	quest.385C266B6F28BC88.quest_desc: [
		"&eHearty Grains&r 生长在平原和沼泽的海平面浅水区。夏季和秋季生长。"
		""
		"九个合成一个Hearty Grain Bale，四个合成Tatami，三个放进每个&ePoké Snack&r里。"
	]
	quest.385C266B6F28BC88.title: "营养谷物"
	quest.385CC9077F2BC67B.quest_desc: [
		"站在&6冰冻悬崖&r上。"
		""
		"Cubchoo 和 Beartic 会在这里游荡，尤其是在下雪的时候。Seel 和 Spheal 会在冰岸上闲逛。"
	]
	quest.385CC9077F2BC67B.title: "冷肩肉（Cold Shoulder）"
	quest.3863C66FAB8B4101.quest_desc: ["合成一个&e宇宙催化剂&r：4个黑曜石、1个心灵宝石、2个紫水晶碎片、1个星糖和1个超球。"]
	quest.3863C66FAB8B4101.title: "星尘收集器"
	quest.389AB265956A5DE6.quest_desc: [
		"一个 &e水桶&r、四个 &e灰烬&r 和一块 &e生猪肉排&r 可以熬制成 &e肥皂&r。"
		""
		"右键点击染色方块可洗去颜色，或使用它来擦拭 Sepia Globe。"
	]
	quest.389AB265956A5DE6.title: "一尘不染"
	quest.38B469583B5865D8.quest_desc: [
		"&6价格：&r &e400 CobbleDollars&r 一个。"
		""
		"治愈宝可梦的中毒状态"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
