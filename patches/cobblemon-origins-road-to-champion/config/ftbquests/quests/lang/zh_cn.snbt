	quest.09BF94A3ACB39210.title: "萨拉克浆果"
	quest.09E494585D72170F.quest_desc: [
		"&6许愿林地&r生长在黑暗森林等诡异生物群系中。"
		""
		"中心有一颗&e许愿星&r水晶，旁边有可疑的砾石和一个镀金箱子。"
	]
	quest.09E494585D72170F.title: "深入幽暗密林"
	quest.09EACF0380CF67E4.quest_desc: [
		"将&e下界合金锭&r放入&e切石机&r中，可切割出两个&e空白-Z&r晶体。"
		""
