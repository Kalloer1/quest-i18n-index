	quest.72F6FC8CD75B167E.title: "草的种子"
	quest.7333C33BF8363039.quest_desc: [
		"吹响满月哨子来召唤&d克雷色利亚&r。哨子只能使用一次，请把握好时机。"
		""
		"&cCresselia 在当前的 Cobblemon 版本中还没有模型，因此暂时无法捕捉。&r"
	]
	quest.7333C33BF8363039.title: "月光摇篮曲"
	quest.73353F36B1B9F3CE.quest_desc: [
