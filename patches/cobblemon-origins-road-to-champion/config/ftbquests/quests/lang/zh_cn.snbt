	]
	quest.1F97DAE1CB76608D.title: "拼凑在一起"
	quest.1F9DF1D5051BB1D2.quest_desc: ["&e极光精华&r会漂浮在靠近&b生命之树&r的森林群系中。用16个罐子收集它，并将其献给极光X日志，直到木材苏醒，&d哲尔尼亚斯&r出现。"]
	quest.1F9DF1D5051BB1D2.title: "生命之树"
	quest.1FAE1816AADA1651.quest_desc: [
		"&6价格：&r &e6,000 CobbleDollars&r 一个。"
		""
		"&a点击对勾即可购买。可重复购买，仅在您负担得起时收费。&r"
	]
	quest.1FAE1816AADA1651.quest_subtitle: "6,000 CD"
	quest.1FAE1816AADA1651.title: "大根茎"
	quest.1FC2A611AD0BD1C5.quest_desc: [
		"将宝可梦培养到本整合包的最高等级，即&e100级&r。"
		""
		"从现在开始，能力值的增长取决于个体值、努力值和性格，而非等级。"
	]
	quest.1FC2A611AD0BD1C5.title: "已完全升级"
	quest.1FD74F96A6B1A047.quest_desc: [
		"木屑加上一个&e发光甜瓜片&r可以制作&e惊喜木屑&r：它能提高浆果变异的机会。"
		""
		"它对复兴草药也同样有效，效果惊人。"
	]
	quest.1FD74F96A6B1A047.title: "惊喜！"
	quest.1FF1954716715EC1.quest_desc: [
		"治愈一个&2僵尸村民&r：用&e虚弱药水（Splash Potion of Weakness）&r砸它，然后用&e金苹果&r（苹果周围环绕着8个金锭）喂它。它会很快恢复正常。"
		""
		"被治愈的村民会记得他们的医生，给出的价格也更好。"
		"&c转化期间避免阳光直射：在被治愈前它仍会燃烧。&r"
	]
	quest.1FF1954716715EC1.title: "医生的命令"
	quest.20045312852A449A.quest_desc: [
		"&6价格：&r &e600 CobbleDollars&r 一个。"
		""
		"将宝可梦的速度努力值提高1点"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.20045312852A449A.quest_subtitle: "600 CD"
	quest.20045312852A449A.title: "Swift Feather"
	quest.2015C602D8FA71C4.quest_desc: [
		"右键点击结着果实的&ePrickly Peach Cactus&r来采摘&ePrickly Peach&r，然后吃掉它。"
		""
		"戳一下光秃秃的仙人掌，它就会告诉你对此有何感受。"
	]
	quest.2015C602D8FA71C4.title: "零食袭击"
	quest.2015ED4B863C6A61.quest_desc: ["合成一个&e速度银帽&r：四个铁锭、两颗钻石和三个&e绿薄荷叶&r。它将速度 IV 超频至 31。"]
	quest.2015ED4B863C6A61.title: "速度银色帽子"
	quest.201A54EA1380E223.quest_desc: [
		"探索一片&6森林&r。"
		""
		"Sewaddle 在咀嚼树叶，Seedot 和 Pachirisu 坐在树梢上，Flabébé 漂浮在和自己颜色相同的花朵附近。"
		"&o据说超稀有的Celebi会光顾古老的森林。&r"
	]
	quest.201A54EA1380E223.title: "走进森林深处"
	quest.202B7E97652545B1.quest_desc: ["用&eVivichoke&r、&e牛奶&r、&e碗&r和&e面包&r可以制作奶油味的&eVivichoke蘸酱&r。"]
	quest.202B7E97652545B1.title: "把它浸进去"
	quest.203315E849ADF986.quest_desc: [
		"一个&e钻石箱子&r和一个&e下界合金锭&r，无需特定形状。"
		""
		"顶层：有 &e132 个物品栏&r 和 &e5 个升级槽&r。"
	]
	quest.203315E849ADF986.title: "下界合金宝箱"
	quest.203EBB23B325A0F5.quest_desc: [
		"《宝可梦传说：Z-A》中的新mega宝可梦之一。"
		"让&eHeatran&r进行超级进化。"
		""
		"配方：原始巨岩、一颗钻石、一个 &eMagmarizer&r 和两个 &eNetherite Ingots&r。"
	]
	quest.203EBB23B325A0F5.title: "Heatranite"
	quest.2061011630D35145.quest_desc: [
		"一个&e末影珍珠&r和一个&e紫水晶碎片&r可以合成4个&e扭曲尘埃&r。"
		""
		"Warp Dust 并非 Waystone 的一部分：它为 &eWarp Plates&r 提供动力，即你自己建造的成对传送垫。"
	]
	quest.2061011630D35145.title: "闪烁粉尘"
	quest.2066DEAD8DF7D147.quest_desc: [
		"捕捉10只&a草&r属性的宝可梦。双属性宝可梦两种属性都算数。"
		""
		"&6强项：&r水、地面、岩石"
	]
	quest.2066DEAD8DF7D147.title: "触摸草地"
	quest.2092D051D65F422F.quest_desc: [
		"一百个宝藏洞窟开启，挖掘点清理干净，一个镀金宝箱被找到，一个拟态怪被击败。"
		""
		"下方的文物收集任务，你可以按照自己的节奏完成。"
	]
	quest.2092D051D65F422F.title: "宝藏猎人"
	quest.209468F303811770.quest_desc: ["给百变怪或呆呆兽一个王者之石，然后交换或使用交换机。"]
	quest.209468F303811770.title: "国王万岁"
	quest.20ABC3B3A8DA45F8.quest_desc: [
		"下界中行走一格等于主世界的&e8格&r。"
		""
		"在主世界坐标除以8的位置建造第二个传送门，你就能得到一条高速公路。利用下界来覆盖7000个主世界方块以完成此任务。"
	]
	quest.20ABC3B3A8DA45F8.title: "穿越地狱的捷径"
	quest.20B42EF02AB77C13.quest_desc: ["将&e音符方块&r直接放置在唱片架上方，即可建造一个音频序列器。"]
	quest.20B42EF02AB77C13.title: "科学的力量"
	quest.20BB632ABF609AAB.quest_desc: [
		"找到一个节日气氛浓厚的 CTOV &e圣诞村庄&r。"
		""
		"它与雪屋风格的雪村共享雪地生物群系。"
	]
	quest.20BB632ABF609AAB.title: "节日快乐，万事如意！"
	quest.20BB7FF19F86D467.quest_desc: [
		"&e4 平滑石&r、&e3 箱子&r和&e2 铁锭&r。"
		""
		"存储同一物品的多种变体，如附魔书或损坏工具。"
	]
	quest.20BB7FF19F86D467.title: "文件柜"
	quest.20BBD3B896DA4599.quest_desc: ["将韭葱熔炼成&e烤韭葱&r，然后加入烤土豆和碗，制作一份营养丰富的浓汤。"]
	quest.20BBD3B896DA4599.title: "韭葱土豆炖菜"
	quest.20BE3241C636DBC1.quest_desc: [
		"用&e重球&r捕捉一只宝可梦。"
		""
		"&a留给那些又大又重的宝可梦吧。&r"
	]
	quest.20BE3241C636DBC1.title: "重量级拳击赛"
	quest.20D0AFCB3E3C674E.quest_desc: [
		"&6价格：&r &e8,000 CobbleDollars&r 一个。"
		""
		"多段攻击招式总能击中至少四次"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.20D0AFCB3E3C674E.quest_subtitle: "8,000 CD"
	quest.20D0AFCB3E3C674E.title: "加载了骰子模组 Loaded Dice"
