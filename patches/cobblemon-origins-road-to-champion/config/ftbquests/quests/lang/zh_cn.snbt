	quest.6328D496B658C11F.title: "金属涂层"
	quest.632AAC0B423CD6A1.quest_desc: ["在沙漠神殿的宝箱或 Terralith 沙漠前哨中，找到一个 &eDune&r 盔甲修饰模板。"]
	quest.632AAC0B423CD6A1.title: "沙丘修剪工具"
	quest.63310861BB130A73.quest_desc: [
