	]
	quest.540A8AC3B885D917.quest_subtitle: "30次掠夺胜利"
	quest.540A8AC3B885D917.title: "突袭队长"
	quest.541E4FB59447FAED.quest_desc: [
		"在战斗中击败25只野生&b冰&r系宝可梦。"
		""
		"&6弱点：&r格斗、火、岩石、钢系"
		"&c抗性：&r 冰霜"
	]
	quest.541E4FB59447FAED.title: "打破坚冰"
	quest.542A20B268643B10.quest_desc: ["你已经培育了全部八种伊布进化形态。每种培育完成后即可领取奖励。"]
	quest.542A20B268643B10.title: "伊布进化专家"
	quest.542B52ECF884127B.quest_desc: [
		"挖掘一个&e深层板岩晶核&r。"
		""
