	quest.3B00E8D4C415D065.title: "Charti 浆果"
	quest.3B15515D6777952A.quest_desc: [
		"&e4 木板&r、一个&e比较器&r、&e潜望镜&r、&e萤石粉&r、&e玻璃&r和一颗&e末影珍珠&r。"
		""
		"将你的操作范围延伸至 &e存储终端&r：可打开最远 &e16 格&r 内的终端。"
	]
	quest.3B15515D6777952A.title: "无线终端"
	quest.3B184D17EF09056E.quest_desc: [
		"捕捉一只&c火&r、一只&9水&r和一只&a草&r属性的宝可梦。"
		""
		"水能灭火，火能烧草，草能吸水。"
		"每种都克制下一种，但会被最后一种克制。"
	]
	quest.3B184D17EF09056E.title: "新手三角套装"
	quest.3B21FF4D82A17234.quest_desc: [
		"将&e4根木棍&r围绕着一个&e红石火把&r放置。"
		""
		"将其用于已放置的普通箱子、木桶或潜影盒上，即可在不清空内容的情况下将其变为精致版。"
	]
	quest.3B21FF4D82A17234.title: "迈向精致化 (Go Sophisticated)"
	quest.3B3156DF030D3A77.quest_desc: [
		"用 5 个 &e铜锭&r、1 个 &e玻璃&r块和 2 个 &e甜杏&r制作一个 &e营火锅&r；甜杏的颜色决定了锅的颜色。将其放置在点燃的 &e营火&r上。"
		""
		"打开它可获得配方网格和&e调味料&r栏位：调味料可为菜肴增添风味或效果。"
		""
		"&a锅里的食谱书列出了你现在可以烹饪的所有东西。&r"
	]
	quest.3B3156DF030D3A77.title: "炉灶上的锅具"
	quest.3B3AF459F317F880.quest_desc: [
		"三颗钻石和两根木棍可以制作一把&e钻石镐&r。"
		""
		"只有钻石镐或更好的工具才能挖掘&e黑曜石&r，这是通往下界的门票。"
	]
	quest.3B3AF459F317F880.title: "最好的镐子 The Best Pick"
	quest.3B3F2AE08D4EA117.quest_desc: [
		"火箭队的管理员们从未放弃。在 Brendan 的最后一支队伍中，&eArcher&r 带来了 Latias 和 Heatran，而 &eAriana&r 带来了 Victini 和 Xerneas。"
		""
		"它们在末地城市、恶地和平原上游荡。击败两者。可选。"
	]
	quest.3B3F2AE08D4EA117.quest_subtitle: "弓箭手和阿里安娜，最终队伍"
