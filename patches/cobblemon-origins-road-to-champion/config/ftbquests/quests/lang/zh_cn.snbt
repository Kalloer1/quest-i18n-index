	quest.020A848FB27B533C.quest_desc: [
		"在战斗中击败25只野生&f普通&r属性的宝可梦。"
		""
		"&6弱点：&r 格斗类武器"
		"&c免疫于：&r 鬼魂"
	]
	quest.020A848FB27B533C.title: "一帆风顺的航行"
	quest.021CA27CCA867E91.quest_desc: [
		"合成一个&e巨型手镯&r：五个铁锭、一颗钻石、两个白色杏核和一枚你的基石。"
		""
		"其他颜色的阿普里克恩可以制作彩色手链，任何钥匙石配饰都算数。"
		""
		"在配件界面的&eMega Slot&r中佩戴它(&eH&r)。"
	]
	quest.021CA27CCA867E91.title: "手腕升级组件"
	quest.02683F342DF851FA.quest_desc: [
		"捕捉一只&e伊布&r。它能进化成八种不同的宝可梦，比其他任何宝可梦都多。"
		""
		"五个需要石头，三个需要高友谊度。你需要好几只伊布！"
	]
	quest.02683F342DF851FA.title: "八种成长方式"
	quest.029AF040D375896E.quest_desc: [
		"&6价格：&r &e6,000 CobbleDollars&r 一个。"
		""
		"提升持有者拳击动作的威力，并防止与目标发生接触"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.029AF040D375896E.quest_subtitle: "6,000 CD"
	quest.029AF040D375896E.title: "拳击手套 Punching Glove"
	quest.02AFE4FBFA8BF5A0.quest_desc: ["制作任意一种 Rotom 电器：风扇、冰箱、割草机、烤箱或洗衣机。每种在 REI 中都有自己的配方。"]
	quest.02AFE4FBFA8BF5A0.title: "即插即用"
	quest.02B570A0385B7DF7.quest_desc: [
		"钓上一条&e费巴斯&r。它们只在&e史莱姆块&r中咬钩，任何远离海洋和海岸的末地世界区域，用诱饵钓竿更容易钓到。"
		""
		"手持&e棱镜鳞片&r进行交易，它会进化成美纳斯。"
	]
	quest.02B570A0385B7DF7.title: "丑小鸭"
	quest.02C2190D72CFD775.quest_desc: [
		"收集 &e15 个书架&r。"
		""
		"在桌子周围每隔一个方块放置一个（间隔一个方块），高度与桌子齐平或高一格。上限为十五个，可解锁30级任务。"
		"&c保持间隙畅通：书架和桌子之间的实心方块会切断电源。&r"
	]
	quest.02C2190D72CFD775.title: "完整的图书馆"
	quest.02C7E244B2B04958.quest_desc: [
		"&6价格：&r &e5,000 CobbleDollars&r 一个。"
		""
		"在迷雾地形中提升持有者的特防"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.02C7E244B2B04958.quest_subtitle: "5,000 CD"
	quest.02C7E244B2B04958.title: "迷雾种子"
	quest.02D213534266CCCE.quest_desc: [
		"&e药用韭葱&r漂浮在河流和湖泊的淡水里（不在冰冻、沿海或海洋生物群系中）。"
		""
		"韭葱是药用汤剂的基底，携带韭葱的Farfetch'd或Sirfetch'd能打出更多暴击。在春季和秋季生长。"
	]
	quest.02D213534266CCCE.title: "药用韭葱"
	quest.02E2CA29838664E7.quest_desc: [
		"击败一只&c劫掠兽&r。这些冲锋的野兽会首次出现在袭击的第三波中。"
		""
		"每只劫掠兽都会掉落一个&e鞍&r。"
	]
	quest.02E2CA29838664E7.title: "驮兽的负担"
	quest.02E5C70D04C91A70.quest_desc: [
		"在战斗中击败25只野生&8黑暗&r属性的宝可梦。"
		""
		"&6弱点：&r虫、妖精、格斗"
		"&c抗性：&r黑暗、幽灵"
		"&c免疫于：&r 精神伤害"
	]
	quest.02E5C70D04C91A70.title: "黎明巡逻队"
	quest.02F1A64980F52960.quest_desc: [
		"在 &eStorage Upgrade Base&r 周围放置 &e8 Logs&r。"
		""
		"每个槽位可存放 &e2x&r 数量的物品堆。箱子、桶和潜影盒最多可升级 &e2&r 次。铜制 &eTier 1+&r (3x) 位于 Tier 1 和 2 之间。"
	]
	quest.02F1A64980F52960.title: "堆叠升级 第1级"
	quest.0308F2DAB031D685.quest_desc: [
		"小地图是 &eXaero's Minimap&r：&eF6&r 打开设置，&eU&r 列出路径点，&eInsert&r 创建新路径点。"
		""
		"按 &eM&r 打开 &eXaero's World Map&r：附近的宝可梦会以其专属图标显示在地图上，你的领地标记也是如此。使用物品栏中的 &eFTB Chunks: Claim Manager&r 按钮来标记领地：最多可标记 500 个区块和 25 个强制加载区块。在已标记的区块内，只有你和你的盟友可以破坏或使用方块，且爆炸已被禁用。"
	]
	quest.0308F2DAB031D685.title: "地图与路径点"
	quest.0318B63484197A57.quest_desc: ["在深暗之地的远古城市宝箱中找到一个&eWard&r盔甲修饰模板。"]
	quest.0318B63484197A57.title: "护身符装饰物"
	quest.031DBAA6060511FC.quest_desc: [
		"五个&e铁锭&r、两块木板、&e红石&r和您的&e弹弓&r可以合成一门&e大炮&r（发射器和额外木板可替代弹弓和红石）。"
		""
		"用&e火药&r当燃料，装上可发射物（几乎什么都行），坐进去瞄准，然后开火。加到船上就能做成炮船。"
	]
	quest.031DBAA6060511FC.title: "火药桶爆炸倒计时"
	quest.03300D108F3A8EC4.quest_desc: [
		"骑上&eStrider&r，用你的Warped Fungus on a Stick来驾驶它。"
		""
		"史特莱德能穿越熔岩海洋，让下界最危险的渡河也变得轻松。"
	]
	quest.03300D108F3A8EC4.title: "熔岩出租车"
	quest.034FD776505BB394.quest_desc: [
		"一个&e红石火把&r、&e2个木板&r、一根&e物品栏线缆&r和一个&e比较器&r。"
		""
		"当网络中物品的数量超过（或少于）你设定的数量时，会发出红石信号。"
	]
	quest.034FD776505BB394.title: "等级发射器"
	quest.03714B42A773715D.quest_desc: [
		"捕捉 &e25&r 只宝可梦。"
		""
		"你的队伍只能携带六个。其他人去 &ePC&r，那里有 60 个箱子的空间。"
	]
	quest.03714B42A773715D.title: "成长名单 Growing Roster"
	quest.0388C46D75871413.quest_desc: ["制作一个&e泥炭块&r（泥土、土块、苔藓块和黏土），并在满月之夜的夜间对Ursaring使用它。"]
	quest.0388C46D75871413.title: "满月升起"
	quest.0389EAFF60BB2712.quest_desc: [
		"用V形排列的三个铁锭可以制作一个&e桶&r。"
		""
