	quest.5CD2BB61A4ECE7A0.title: "玛戈浆果"
	quest.5CF6937DEE8E517A.quest_desc: [
		"烈焰棒和烤熟的紫颂果可以合成四根&e末地之杖&r。"
		""
		"它们是明亮、纤薄的定向光源，可以向任何方向发光。"
	]
	quest.5CF6937DEE8E517A.title: "光之杖"
	quest.5CFFF2869978803B.quest_desc: [
		"击败一只&eBreeze&r可获得一根&eBreeze Rod&r。Breeze只会从试炼生成器中生成。"
		""
		"用风车制作风荷，修理战锤，并酿造风荷药水。"
	]
	quest.5CFFF2869978803B.title: "风之杖 (Rod of the Wind)"
	quest.5D0AF547A7CE8CD9.quest_desc: [
		"合成一个&e发酵蜘蛛眼&r：一个蜘蛛眼、一个褐色蘑菇和糖。"
		""
		"它会腐化药水：将夜视变为隐身，将治疗和中毒变为伤害，将速度和跳跃变为缓慢。"
	]
	quest.5D0AF547A7CE8CD9.title: "腐肉（Spoiled Rotten）"
	quest.5D203857EAFB862E.quest_desc: [
		"捕捉任意一只伽勒尔地区的初始宝可梦。"
		""
		"丛林中的&bGrookey&r、草原上的&bScorbunny&r、森林和沼泽中的&bSobble&r。"
	]
	quest.5D203857EAFB862E.title: "Postwick 合作伙伴"
	quest.5D225317E263461B.quest_desc: [
		"以主办方或参与者身份参加 &e10&r 次突袭。"
		""
		"每个巢穴在变暗前可以被清除&e3次&r。大约两小时后，它会重置为新的首领和等级。失败的突袭可以重试。"
	]
	quest.5D225317E263461B.title: "常规突袭者"
	quest.5D4461103D090E80.quest_desc: [
		"&e潜行者&r子弹能让你漂浮。用它升到50格高。"
		""
		"&c警告：&r下落的过程很危险。请喝牛奶、携带水桶或使用缓慢下落。"
	]
	quest.5D4461103D090E80.title: "向上，再向上，飞向远方"
	quest.5D4E60E1ABCC10B1.quest_desc: [
		"杀死 10 只 &e苦力怕&r。"
		""
		"苦力怕在爆炸前会嘶嘶作响。攻击它们并后退。它们会掉落&eGunpowder&r，用于制作TNT和烟花火箭。"
	]
	quest.5D4E60E1ABCC10B1.title: "这真是一座漂亮的房子"
	quest.5D55980CF9560A04.quest_desc: [
		"在昏迷的宝可梦上使用 Revive、Max Revive 或生的 &eRevival Herb&r。"
		""
		"生草只能恢复四分之一的HP并降低友好度：能烹饪时再烹饪。"
	]
	quest.5D55980CF9560A04.title: "为再战一日而活 (Live to Fight Another Day)"
	quest.5D79CDAB13621526.quest_desc: [
		"&6价格：&r &e6,000 CobbleDollars&r 一个。"
		""
		"提升持有者的准确度"
		""
		"&a点击对勾即可购买。可重复购买，仅在您负担得起时收费。&r"
	]
	quest.5D79CDAB13621526.quest_subtitle: "6,000 CD"
	quest.5D79CDAB13621526.title: "变焦镜头"
	quest.5DB1B2BD248A6B4D.quest_desc: [
		"&6价格：&r &e500 CobbleDollars&r 一个。"
		""
		"HP低于1/4时恢复最大HP的1/3；若为减特攻性格则会混乱"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.5DB1B2BD248A6B4D.quest_subtitle: "500 CD"
	quest.5DB1B2BD248A6B4D.title: "Wiki Berry"
	quest.5DB4490CFA591C64.quest_desc: [
		"浆果不仅仅是零食。用&e篝火锅&r可以做成食物、鱼饵和诱饵，用&e酿造台&r可以做成药水。"
		""
		"线上：&6食物&r、甜点、麻薯、地方菜肴和Aprijuice。线下：&6药品&r，从药水到完全恢复。"
		""
		"&a材料生长在浆果和杏核章节中。点击对勾开始。&r"
	]
	quest.5DB4490CFA591C64.quest_subtitle: "什么东西闻起来香喷喷的"
	quest.5DB4490CFA591C64.title: "&l训练师的厨房</c1>"
	quest.5DB7EAB460BFCC95.quest_desc: [
		"烹饪全部七种&e甜点&r：每种各一个&e染料&r、一个&e蜂蜜瓶&r和&e糖&r。"
		"红色：草莓。粉色：爱心。蓝色：浆果。绿色：三叶草。"
		"橙色：花朵。黄色：星星。紫色：缎带。"
		"每种都会将 &eMilcery&r 进化成不同的 Alcremie。"
	]
	quest.5DB7EAB460BFCC95.title: "糖果店"
	quest.5DE3D624ADFB6A7C.quest_desc: [
		"彩虹徽章引出了火箭队的头目。 &e乔伊博士&r漫步于&e荒地&r和&e草原&r。"
		""
		"尼多王、乌鸦头头、火焰猴、袋熊和冰冻旋螺站在你和下一个道馆之间。"
	]
	quest.5DE3D624ADFB6A7C.quest_subtitle: "首领：乔瓦尼 (Giovanni)"
	quest.5DE3D624ADFB6A7C.title: "幕后花絮"
	quest.5DF49EA1BA0AF853.quest_desc: [
		"使用&eTart Apple&r (Flapple)、&eSweet Apple&r (Appletun) 或 &eSyrupy Apple&r (Dipplin) 作用于 Applin。这三种物品都产自 Saccharine Leaves。"
		""
		"&a提示：&r知道龙之欢呼的迪普林在升级时会再次进化为海德拉普。"
	]
	quest.5DF49EA1BA0AF853.title: "我眼中的挚爱 (Apple of My Eye)"
	quest.5E01173F271FBA1D.quest_desc: [
		"用织布机和木棍制作一套&e针&r。"
		""
		"使用它可以在任何地方打开织布台菜单。"
	]
	quest.5E01173F271FBA1D.title: "针头（Needles）"
	quest.5E2C57C4AF22CBB7.quest_desc: [
		"用&e爱心球&r捕捉一只宝可梦。"
		""
		"&aBattle with a Pokémon of the same species and opposite gender for the 8x bonus.&r"
	]
	quest.5E2C57C4AF22CBB7.title: "一见钟情，始于投掷"
	quest.5E36194256C8E2CC.quest_desc: [
		"制作一个&e雕凿书架&r（6个木板和3个木半砖），将一本书放入其中，并用&e红石比较器&r来阅读。"
		""
		"比较器信号会随着你触碰的槽位而变化，这使其成为秘密之门的绝佳触发器。"
	]
	quest.5E36194256C8E2CC.title: "隐藏信号"
	quest.5E3B2A3DB2884FDE.quest_desc: [
		"崎岖的玄武岩和黑石里充满了&e岩浆怪&r。小心绕过岩浆池。"
		""
		"&6宝可梦：&r 煤炭龟、煤炭龟、煤炭龟、煤炭龟、煤炭龟、煤炭龟和煤炭龟。"
		"王牌训练师和战斗少女在三角洲中战斗，就像在整个下界一样。"
	]
	quest.5E3B2A3DB2884FDE.title: "玄武岩三角洲"
	quest.5E53269FB90BF646.quest_desc: [
		"此模组的熔炉可接受&eAugments&r：按住一个并右键以插入。"
		""
		"所有六个增幅器都共用一个配方：角上是&e石头&r，上下是&e红石&r，两侧是&e纸&r，中间是关键物品。大多数会交换一个属性来换取另一个，所以选择适合任务的那个。"
	]
	quest.5E53269FB90BF646.title: "增幅槽位"
	quest.5E7540FEDED035EC.quest_desc: [
		"赢得任意等级的 &e15&r 次突袭。"
		""
		"只有造成足够伤害以获得奖励的胜利才算数。"
	]
	quest.5E7540FEDED035EC.quest_subtitle: "15 次掠夺胜利"
	quest.5E7540FEDED035EC.title: "突袭小队"
	quest.5E7A67CD74C94031.quest_desc: [
		"制作一批&eBeast Balls&r：用1个&eDiamond&r核心和4个&eEcho Shards&r及4个&eGold Ingots&r可制作8个。收集全部8个。"
		""
		"&c仅限究极异兽：&r掉落率5倍，其他为0.1倍。回声碎片来自远古城市的宝箱。"
	]
	quest.5E7A67CD74C94031.title: "虫洞的另一边"
	quest.5E968A2A70FEB0E3.quest_desc: [
		"用你的宝可梦图鉴扫描 &e100&r 只宝可梦。"
		""
		"扫描仪能探测到最远 &e10&r 格内的宝可梦，并能识别你尚未遇到的物种。"
	]
	quest.5E968A2A70FEB0E3.title: "高级研究员"
	quest.5EAE34129F85BA3B.quest_desc: [
		"手持一个&ePoké Ball&r，向野生宝可梦投掷。先削弱它在战斗中的力量，这样成功率会更高。"
		""
		"未接的球会掉落并可再次拾取；宝可梦破出的球则会丢失。"
		""
		"&a战斗中捕捉也能让你的对战宝可梦获得一些经验值。&r"
	]
	quest.5EAE34129F85BA3B.title: "一位新朋友！"
	quest.5ECB2AF2B2089679.quest_desc: [
		"在出口传送门的边缘放置四个 &e末地水晶&r，再次召唤末影龙，迎接另一场战斗和另一波经验值。"
		""
		"注意：此整合包中第二条龙不会掉落蛋。"
	]
	quest.5ECB2AF2B2089679.title: "Encore"
	quest.5F158357454A6419.quest_desc: ["在伊布上使用一个&e雷之石&r。"]
	quest.5F158357454A6419.title: "Jolteon"
	quest.5F2901E5F78FFBB1.quest_desc: [
		"&6价格：&r &e5,000 CobbleDollars&r 一个。"
		""
		"提升持有者超能力系技能的威力"
		""
		"&a点击对勾即可购买。可重复购买，仅在您负担得起时才会收费。&r"
	]
	quest.5F2901E5F78FFBB1.quest_subtitle: "5,000 CD"
	quest.5F2901E5F78FFBB1.title: "扭曲的勺子"
	quest.5F2D1212A3C84940.quest_desc: [
		"在&6温暖海洋&r中游泳。"
		""
		"Luvdisc和Bruxish在珊瑚中游来游去，Wiglett从海底探出头来。"
		"&o究极稀有的盖欧卡，可能出现在海洋的水下。&r"
	]
	quest.5F2D1212A3C84940.title: "珊瑚礁"
	quest.5F3BE53D9D0406B8.quest_desc: [
		"用八个 &e金锭&r 围住一个胡萝卜，就能得到一个 &e金胡萝卜&r，马和兔子都爱吃的零食。"
		""
		"&a宝可梦联动：&r金胡萝卜是&e隐形斗篷&r的附魔配方之一。"
	]
	quest.5F3BE53D9D0406B8.title: "物有所值"
	quest.5F4E0ED03DF4E35A.quest_desc: [
		"扫描一只&6闪光&r宝可梦。"
		""
		"聊天框会提示你所在维度中闪光宝可梦的出现。快拿出你的宝可梦图鉴去吧。"
	]
	quest.5F4E0ED03DF4E35A.title: "闪光探测器"
	quest.5F52E53FC9E8C188.quest_desc: [
		"用&e钻石镐&r或以上工具挖掘&e基石矿石&r，以获得&e基石&r。"
		"&c丝绸之触只会返还矿石方块给你。&r"
		""
		"&a附近没有巨神吗？基石也可以用四个恒星泰拉碎片、一颗钻石、一个铁球、青金石、一颗紫水晶碎片和一颗祖母绿来制作。恒星碎片来自Z招式、太晶化和极巨化章节。&r"
	]
	quest.5F52E53FC9E8C188.title: "Set in Stone"
	quest.5F534B0309BBB5F1.quest_desc: [
		"&e潜行兽&r会藏在末地城市的墙壁里，并发射能让你漂浮的追踪子弹。"
		""
		"击杀10只。趁它们外壳张开时攻击。外壳会生成Shulker Boxes和Cobblemon's Master Ball。"
	]
	quest.5F534B0309BBB5F1.title: "箱龟（Box Turtles）"
	quest.5F545A95C629A85E.quest_desc: [
		"制作一个&e能力补丁&r：一个能力胶囊、四个钻石、三个金锭和一张纸。它能将宝可梦切换到其&o隐藏&r能力。"
		""
		"另一种配方则需要下界之星、钻石和铁。"
	]
	quest.5F545A95C629A85E.title: "隐藏的天赋"
	quest.5F856E21F6CFA65F.quest_desc: [
		"&e4 木板&r、&e2 箱子&r、一个&e比较器&r、一颗&e钻石&r和一颗&e末影珍珠&r。"
		""
		"网络的核心：它将所有接触到的物品栏合并为一个。 &eInventory Trims&r 填补了箱子之间的空隙。"
	]
	quest.5F856E21F6CFA65F.title: "物品栏连接器"
	quest.5FB98E47D3D8FCB9.quest_desc: ["将一只宝可梦提升至本整合包的上限，即&e极限进化等级10&r。"]
	quest.5FB98E47D3D8FCB9.title: "已完全升级"
	quest.5FC70753E0A8E984.quest_desc: [
		"&6价格：&r &e400 CobbleDollars&r 一个。"
		""
		"1× 捕获率"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.5FC70753E0A8E984.quest_subtitle: "400 CD"
	quest.5FC70753E0A8E984.title: "远古繁茂球体"
	quest.5FE2F6D3BFB01064.quest_desc: [
		"中间放一个基础版&eSophisticated Chest&r或&eBarrel&r，旁边放&e4 Stone&r、&e2 Comparators&r、&e2 Planks&r。"
		""
		"将其与你的 Sophisticated storage 接触：所有相连的部分将合并为一个可存取物品和传输物品的方块。"
	]
	quest.5FE2F6D3BFB01064.title: "存储控制器"
	quest.5FF3D9ED45A9D4FC.quest_desc: [
		"一个 &e磁石升级&r，需要 &e钻石&r、&e2个金锭&r和 &e3个红石&r。"
		""
		"范围扩大到 &e5 格&r，过滤器从 9 扩大到 16 个槽位。大多数基础升级都有用相同方式制作的进阶版本。"
	]
	quest.5FF3D9ED45A9D4FC.title: "高级磁石升级组件"
	quest.5FFC7BA106DAF293.quest_desc: [
		"在&ePiglin&r附近放下一个&e金锭&r。它会检查黄金，然后抛出一个随机的交易。"
		""
		"以物易物可以获得末影珍珠、火焰抗性药水、线、石英、黑曜石、&e哭泣的黑曜石&r、灵魂沙、皮革等物品。"
		"&c先脱下所有金质盔甲。只有在分散敌对猪灵注意力时才有效。&r"
		"之后日常交易时，再把你的金子带上吧。"
	]
	quest.5FFC7BA106DAF293.title: "以物易物，黄金换货"
	quest.6009BCD1E5D0A239.quest_desc: [
		"捕捉10只&6岩石&r属性的宝可梦。双属性宝可梦两种属性都算数。"
		""
		"&6克制：&r火焰、冰、飞行、虫类生物"
	]
	quest.6009BCD1E5D0A239.title: "岩石收集任务"
	quest.600A74873292E790.quest_desc: [
		"&6价格：&r &e4,000 CobbleDollars&r，共10个。"
		""
		"使宝可梦的经验值增加800经验值"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.600A74873292E790.quest_subtitle: "4,000 CD"
	quest.600A74873292E790.title: "经验糖果 S x10"
	quest.6013D055BF15409D.quest_desc: [
		"用五个皮革和一个烈焰粉制作一个&eTera Pouch&r，将所有Tera Shards存放在一个地方。"
		""
		"在顶部加个染料，就能得到彩色袋子。"
	]
	quest.6013D055BF15409D.title: "碎片袋 (Shard Purse)"
	quest.6057B76932961C88.quest_desc: [
		"&6价格：&r &e600 CobbleDollars&r 一个。"
		""
		"将持有者第一个招式恢复至0PP所需的10PP"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.6057B76932961C88.quest_subtitle: "600 CD"
	quest.6057B76932961C88.title: "Leppa Berry"
	quest.608629E2240E2387.quest_desc: ["获取一个&eTide&r盔甲修饰模板：海洋神殿的领主，远古守卫者会掉落。"]
	quest.608629E2240E2387.title: "潮汐修剪"
	quest.609BF0ADDF50D1F4.quest_desc: [
		"用&e黄昏球&r捕捉一只宝可梦。"
		""
		"&aCaves and dark nights are its home turf.&r"
	]
	quest.609BF0ADDF50D1F4.title: "夜之生物"
	quest.60B902343FD077AD.quest_desc: [
		"《宝可梦传说：Z-A》中的新mega宝可梦之一。"
		"让&eTatsugiri&r超级进化吧。"
		""
		"配方：原始巨石、一颗钻石、一颗&e水宝石&r和两颗&e龙鳞&r。"
	]
	quest.60B902343FD077AD.title: "Tatsugirinite"
	quest.60C8EF75F92A005F.quest_desc: [
		"凝视着 &6冰川裂谷&r 的深处。"
		""
		"这里常见Bergmite，下雪时会刷出Cetoddle。"
		"&o超稀有的基格尔德喜欢这种寒冷的地方。&r"
	]
	quest.60C8EF75F92A005F.title: "注意间隙"
	quest.60CEB9452D8281DA.quest_desc: [
		"用&e根化石&r复活一只&e莉莉欧&r（岩石/草）。"
		""
		"在热液喷口、树根坑、沙地巢穴、水下撞击坑和水下裂缝中寻找它。"
	]
	quest.60CEB9452D8281DA.title: "Lileep"
	quest.60DB7C5F3756C997.quest_desc: [
		"&6价格：&r &e1,000 CobbleDollars&r 一个。"
		""
		"1× 到 4×，夜间根据月亮接近满月的程度而增加"
		""
		"&a点击对勾即可购买。可重复购买，仅在您负担得起时收费。&r"
	]
	quest.60DB7C5F3756C997.quest_subtitle: "1,000 CD"
	quest.60DB7C5F3756C997.title: "月亮球"
	quest.60E0723569ACBA39.quest_desc: [
		"放置箱子，并向其中投入金属锭，直到其金属价值达到50。此时，&dMeltan&r会弹出。"
		""
		"&a盒子会凝聚出&eMeltan Candy&a。给你的Meltan 64个糖果，让它进化成Melmetal。&r"
	]
	quest.60E0723569ACBA39.title: "六角螺母运输任务"
	quest.60F5EFCB040D8468.quest_desc: [
		"手持一种类型的&e50个泰拉碎片&r，并对宝可梦使用，将其泰拉类型更改为该类型。"
		""
		"击败宝可梦会掉落碎片，石匠能将一个类型宝石转化为五个该类型的碎片。"
	]
	quest.60F5EFCB040D8468.title: "改变心意 (Change of Heart)"
	quest.60F712A6F7079F3E.quest_desc: [
		"悬停任意物品并按 &eR&r 查看配方，或按 &eU&r 在配方查看器 (REI) 中查看用途。"
		""
		"在 REI 中搜索宝可梦以打开其 &eCobbledex REI&r 页面：生成群系、进化、掉落、招式和基础属性。"
		""
		"选择初始宝可梦还会送你一本&eCobblepedia&r，即游戏中的宝可梦指南。弄丢了？用任意一个浆果和一本书就能再造一本。"
	]
	quest.60F712A6F7079F3E.title: "查阅一下信息吧"
	quest.610ED626040535AA.quest_desc: [
		"每种类型都有一个浆果，可以减半该类型的一次超有效伤害。从初始三角形开始："
		"&e奥卡&r（火）、&e帕什&r（水）和&e林多&r（草）。"
		""
		"奥卡喜欢炎热、沙质或火山地带，帕什喜欢海岸和淡水，林多喜欢丛林和茂密的洞穴。"
	]
	quest.610ED626040535AA.title: "新手保险 Starter Insurance"
	quest.611F2FD2505E5167.quest_desc: [
		"&6价格：&r &e1,000,000 CobbleDollars&r 一个。"
		""
		"保证捕获成功"
		""
		"&a点击对勾即可购买。可重复购买，仅在您负担得起时收费。&r"
	]
	quest.611F2FD2505E5167.quest_subtitle: "1,000,000 CD"
	quest.611F2FD2505E5167.title: "远古起源球 Ancient Origin Ball"
	quest.6122B2D8480C70DC.quest_desc: [
		"&eCobblemon Loot Plus&r 为结构物宝箱添加了宝可梦内容：普通宝箱中会出现精灵球、药品、经验糖果、浆果和遗物硬币。"
		""
		"宝藏房间可能会掉落手持物品、薄荷、超级石和Z水晶。检查每个宝箱。"
	]
	quest.6122B2D8480C70DC.title: "储物柜里的宝可梦"
	quest.613142AA8306467F.quest_desc: [
		"在一张&e纸&r周围放置八个木板。将&e附魔书&r或&e地图&r钉在&e告示板&r上，内容会显示在正面。"
		""
		"发布你城镇的规则或最佳闪光宝可梦狩猎地点的地图。"
	]
	quest.613142AA8306467F.title: "公告板"
	quest.61423E19C0E2ED17.quest_desc: [
		"&6工作站点&r"
		"没有工作的村民会认领附近的免费&e工作方块&r，并从事该职业。"
		"交换方块可以更改职业，但必须在与该村民交易前完成：一次交易即锁定职业。"
		""
		"该网格覆盖了全部十三个工作区。已链接的单元格指向已教授该方块的那一章。"
	]
	quest.61423E19C0E2ED17.title: "每个人都需要一份工作"
	quest.6155787658DCC941.quest_desc: [
		"&6价格：&r &e50,000 CobbleDollars&r 一个。"
		""
		"将宝可梦的当前能力更改为其隐藏的替代能力"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.6155787658DCC941.quest_subtitle: "50,000 CD"
	quest.6155787658DCC941.title: "能力补丁 (Ability Patch)"
	quest.616A045EFB38EFF1.quest_desc: [
		"寻找&e太阳石矿石&r：它生成于恶地、草原和滴水洞窟，较少生成于沙漠和热带岛屿。在恶地中，它可以替代陶瓦。"
		"看深板岩层上方的普通石头变种。"
		""
		"&a宝可梦提示：&r这种石头能让大舌舔、向日种子和棉棉怪等宝可梦进化。"
	]
	quest.616A045EFB38EFF1.title: "Sun Stone Ore"
	quest.6173FD5E683632A1.quest_desc: [
		"四个&e下界合金废料&r和四个&e金锭&r可以合成一个&e下界合金锭&r，这是游戏中最坚固的金属。"
		""
		"Cobblemon的&e大师球&r配方需要两个下界合金锭、一颗下界之星和两个潜贝壳。"
	]
	quest.6173FD5E683632A1.title: "下界合金！"
	quest.61782A3EFB79CE17.quest_desc: [
		"探索位于 Y -55 和 Y 30 之间的&eYUNG's Better Mineshafts&r之一。"
		""
		"它们有多种样式，与上方的生物群系相匹配：橡木、云杉、沙漠、冰、丛林、繁茂、台地、蘑菇等。"
	]
	quest.61782A3EFB79CE17.title: "沿着竖井向下"
	quest.617FB373609CD12F.quest_desc: [
		"&6价格：&r &e6,000 CobbleDollars&r 一个。"
		""
		"增加绑定状态造成的伤害量"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.617FB373609CD12F.quest_subtitle: "6,000 CD"
	quest.617FB373609CD12F.title: "绑定带 (Binding Band)"
	quest.618020CFE0DB6118.quest_desc: ["用蜂蜜块制作一个&e蜡烛&r。给它染色，最多四个一组放在一个方块上，然后点燃它们。"]
	quest.618020CFE0DB6118.title: "燃烧午夜油灯，夜以继日地工作"
	quest.61977759E0943F8F.quest_desc: [
		"&6价格：&r &e5,000 CobbleDollars&r 一个。"
		""
		"将宝可梦的防御努力值提高10点"
		""
		"&a点击对勾购买。可重复购买，仅在你能负担得起时收费。&r"
	]
	quest.61977759E0943F8F.quest_subtitle: "5,000 CD"
	quest.61977759E0943F8F.title: "铁"
	quest.61AF8E3FA2C50BE5.quest_desc: [
		"&eLarvesta&r 在 &eCrimson Forests&r 中属于罕见发现。"
		""
		"请耐心等待：Larvesta 要到 59 级才会进化成炽热的 &eVolcarona&r。"
	]
	quest.61AF8E3FA2C50BE5.title: "正在形成的太阳"
	quest.61B4211CA96AA357.quest_desc: [
		"在&e升级台&r周围放置&e4个下界之星&r和&e4个末地水晶&r。价格不菲！"
		""
		"背包变为不可破坏：它既不会消失，也不会落入虚空。"
	]
	quest.61B4211CA96AA357.title: "永恒升级 (Everlasting Upgrade)"
	quest.61B7A95425836946.quest_desc: [
		"复活所有化石宝可梦：化石盔、化石蜻蜓、化石翼龙、圆陆鲨、镰刀盔、盾甲龙、龟化石、始祖龟、始祖鸟、始祖龟和雪童子。"
		""
		"完成全部十一项后，点击对勾即可。"
	]
	quest.61B7A95425836946.title: "活体博物馆"
	quest.61C1925BC7C0F4D7.quest_desc: [
		"踏入一片&6黑暗森林&r。"
		""
		"Sinistea 和 Polteageist 出没于阴暗处，Foongus 藏在黑暗的角落，稀有的 Mimikyu 可能潜伏在附近。"
		"&a提示：&r林地府邸就建在这些森林里（参见&e结构猎人&r）。"
	]
	quest.61C1925BC7C0F4D7.title: "林冠之下"
	quest.61C68494765BC1A4.quest_desc: ["用铁锭和铁粒制作一个&e唱片架&r。"]
	quest.61C68494765BC1A4.title: "唱片架"
	quest.61C7AE77BBC8A621.quest_desc: [
		"新手包已有铁制工具和食物，跳过木制时代：建造基地，点燃熔炉，然后挖掘铁、金和钻石。"
		""
		"每一步都会为你的宝可梦之旅提供养分。 &e铜&r、&e铁&r和&e金&r会进入精灵球、恢复机和电脑中。"
		""
		"&a任务可以按任意顺序完成。不确定时，请遵循提示。&r"
	]
	quest.61C7AE77BBC8A621.quest_subtitle: "生存、定居、深入挖掘"
	quest.61C7AE77BBC8A621.title: "&l最初的几天&r"
	quest.61CD980C63487BAE.quest_desc: ["探索所有四种更好的地牢：怪物房间、地下墓穴、蜘蛛洞穴和亡灵堡垒。"]
	quest.61CD980C63487BAE.title: "专业地下城探险家"
	quest.61CE1040C560736F.quest_desc: [
		"远古城市遍布于深暗之中。它们的箱子里装有&e回响碎片&r、唱片碎片、潜声传感器和偶尔出现的附魔金苹果。"
		""
		"&c悄无声息地移动，照亮前方的路。&r"
	]
	quest.61CE1040C560736F.title: "回响之城"
	quest.61CE1ADFF8E049DD.quest_desc: [
		"在篝火锅中烹饪&ePoké Bait&r（蜂蜜瓶、任意蘑菇、小麦；每批4个）。用浆果或金果调味，即可继承它们的诱饵效果。"
		""
		"把它装在鱼竿和渔网上，用它钓一只宝可梦。"
	]
	quest.61CE1ADFF8E049DD.title: "鱼钩、鱼线和零食"
	quest.61E0791B291C7B18.quest_desc: [
		"在开阔水域，钓竿可以钓起自己的宝藏：&e棱镜鳞片&r、&e龙之鳞片&r、&e王者之石&r、&e深海之牙&r和&e深海鳞片&r，这些都是用于进化的道具。"
		""
		"钓鱼，直到钓到棱镜鳞片为止。"
	]
	quest.61E0791B291C7B18.title: "美丽的天平 (Scale of Beauty)"
	quest.620E955DE4719F5D.quest_desc: [
		"&6价格：&r &e15,000 CobbleDollars&r 一个。"
		""
		"提升持有者的特攻，但会锁定其只能使用一个招式"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.620E955DE4719F5D.quest_subtitle: "冷却时间 15,000"
	quest.620E955DE4719F5D.title: "选择特性眼镜"
	quest.6216464F6ADACF5B.quest_desc: [
		"&6价格：&r &e600 CobbleDollars&r 一个。"
		""
		"恢复宝可梦60点HP，同时略微降低友好度"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.6216464F6ADACF5B.quest_subtitle: "600 CD"
	quest.6216464F6ADACF5B.title: "优质疗法"
	quest.621CDB7C45214327.quest_desc: [
		"&6价格：&r &e3,000 CobbleDollars&r 一个。"
		""
		"将 Applin 进化为 Appletun"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.621CDB7C45214327.quest_subtitle: "3,000 冷却时间"
	quest.621CDB7C45214327.title: "香甜的苹果"
	quest.62224AE426B6F409.quest_desc: [
		"&eCocoa Beans&r grow on jungle trees. Two Wheat around one Cocoa Bean bakes &e8 Cookies&r."
		""
		"野外长途旅行的廉价小零食。"
	]
	quest.62224AE426B6F409.title: "Cookie Jar"
	quest.6238D503A2609850.quest_desc: [
		"加勒尔化石分为两半。将&eFossilized Bird&r或&eFossilized Fish&r与&eFossilized Drake&r或&eFossilized Dino&r一同放入分析仪中。"
		""
		"鸟类 + 龙 = 德拉科佐尔特，鸟类 + 恐龙 = 阿尔特佐尔特，鱼类 + 龙 = 德拉科维奇，鱼类 + 恐龙 = 阿尔特维奇。"
	]
	quest.6238D503A2609850.title: "没停下来思考一下吗"
	quest.62440B5A95AC2D0F.quest_desc: [
		"让任何宝可梦进化。当它准备好时，你会看到“&o它似乎准备好进化了！&r”"
		""
		"打开你的队伍，选择宝可梦并按下&e进化&r。确认后才进化，所以你可以先等等。"
	]
	quest.62440B5A95AC2D0F.title: "出大事了！Something Is Happening!"
	quest.62441736D6763627.quest_desc: ["在沉船宝箱中找到一个 &eCoast&r 盔甲修饰模板。"]
	quest.62441736D6763627.title: "海岸修饰带"
	quest.6250D4F4EBF5F0CA.quest_desc: [
		"捕捉10只&8黑暗&r属性的宝可梦。双属性宝可梦两种属性都算数。"
		""
		"&6强效对抗：&r超能力、幽灵"
	]
	quest.6250D4F4EBF5F0CA.title: "深入黑暗"
	quest.62603DC4406F71AC.quest_desc: [
		"合成一个&ePoké Treat&r：用四张纸包裹任意EXP糖果或稀有糖果。"
		""
		"喂给宝可梦一个可以提升亲密度，而许多进化都需要亲密度。"
		"&a提示：&r携带&e安抚之铃&r的宝可梦（训练与对战篇）能更快地提升亲密度。"
	]
	quest.62603DC4406F71AC.title: "犒劳一下自己"
	quest.62652BB040946A15.quest_desc: [
		"&6价格：&r &e5,000 CobbleDollars&r 一个。"
		""
		"延长 Harsh Sunlight 的持续时间"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.62652BB040946A15.quest_subtitle: "5,000 CD"
	quest.62652BB040946A15.title: "加热岩石"
	quest.627686DD49648DB7.quest_desc: [
		"制作一个&e附魔台&r：一本放在上面的书、2个钻石和4个黑曜石。"
		""
		"放入物品和一些&e青金石&r，它会显示三个随机的附魔选项，每个都附有等级和青金石消耗。"
		"&aThe offers stay weak until Bookshelves surround the table.&r"
	]
	quest.627686DD49648DB7.title: "附魔台 (The Enchanting Table)"
	quest.6281EF084CAE82C1.quest_desc: [
		"在雪地里找到一个&e雪屋&r。"
		""
		"雪下着的时候，雪拉比和冰伊布都围在它周围。"
		"&a提示：&r 部分雪屋的地板下隐藏着地下室。"
	]
	quest.6281EF084CAE82C1.title: "被雪困住"
	quest.628CD3A0F46608D3.quest_desc: [
		"选择初始宝可梦时，你收到了&ePoképedia&r指南书。"
		""
		"介绍了生成、精灵球、战斗和 Cobblemon 的宝可梦形态。弄丢了？用任意 Apricorn 和一本书合成一个新的。"
	]
	quest.628CD3A0F46608D3.title: "阅读手册"
	quest.628F36089A5CCBFD.quest_desc: [
		"经典的下界岩平原，有&e僵尸猪人&r、猪人和恶魂。"
		""
		"&6宝可梦：&r暖暖猪、小火马、煤炭龟、焰马、黏美龙和巨钳螳螂。"
		"Gastly、Charcadet 和 Honedge 可能出现在任何下界生物群系中。"
		"火箭队小兵和老兵遍布所有下界生物群系，丹砂道馆也可能在废土中生成。"
	]
	quest.628F36089A5CCBFD.title: "下界废土"
	quest.62A680DDB0BFD6CD.quest_desc: [
		"将&e40&r种来自&e帕迪亚&r地区的宝可梦（第九世代）标记为已捕获。"
		""
		"地区形态计入其所属地区（阿罗拉形态计入阿罗拉）。洗翠形态计入伽勒尔。"
	]
	quest.62A680DDB0BFD6CD.title: "帕迪亚田野笔记"
	quest.62F1658B6EBDC4FE.quest_desc: [
		"&6价格：&r &e3,000 CobbleDollars&r 一个。"
		""
		"使某些宝可梦进化"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.62F1658B6EBDC4FE.quest_subtitle: "3,000 冷却时间"
	quest.62F1658B6EBDC4FE.title: "叶之石"
	quest.62F818FD06CF620A.quest_desc: ["在平原中能找到&b骑士英雄的王座室&r。在剑之小径的尽头领取&e英雄之剑&r，然后将它与图腾放在配套的基座上。&d萨卡恩&r会现身，并赐予你一把生锈的剑。"]
	quest.62F818FD06CF620A.title: "英雄之剑"
	quest.6322EA4FC163BD79.quest_desc: [
		"&6价格：&r &e1,500 CobbleDollars&r 一个。"
		""
		"减半飞行系超有效攻击造成的伤害"
		""
