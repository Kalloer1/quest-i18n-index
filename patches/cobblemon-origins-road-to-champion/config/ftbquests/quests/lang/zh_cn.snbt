	quest.39564FB3754AE384.title: "祥瑞护甲"
	quest.396D8693AE456300.quest_desc: [
		"佩戴Z-Ring并手持Z-Crystal，在战斗中释放&eZ-Move&r：对应招式的单次超强力版本。"
		""
		"每场战斗只能使用一次Z招式，所以请在关键时刻再使用。"
	]
