	quest.39F87EA3239A8EA2.quest_desc: [
		"完成&9存储与实用&r：Sophisticated Backpacks、Storage Solutions、Iron Furnaces 和 Supplementaries。"
		""
		"一个能自动运行的基地和一个能装下万物的背包。"
		""
		"&a所列章节的每个最终章完成后解锁；然后勾选复选框。&r"
	]
	quest.39F87EA3239A8EA2.title: "建筑大师"
	quest.39FBCCFC1D10FB26.quest_desc: [
		"&e烈焰人&r会从堡垒内的刷怪笼中生成，并掉落最多一根&e烈焰棒&r（抢夺可增加掉落）。堡垒的箱子里也可能有烈焰棒。"
		""
		"Blaze Rods are the key to the &eBrewing Stand&r and, as Blaze Powder, to the Eyes of Ender that open &eThe End&r."
	]
	quest.39FBCCFC1D10FB26.title: "火焰之杖"
	quest.3A0CDA8BC642D716.quest_desc: [
		"&eMax Mushrooms&r 持有 Dynamax 能量。"
		""
		"它们在 Y 值 60 以下的世界自然生成；成年个体会掉落三个。你也可以用红蘑菇、下界疣和烈焰粉合成两个，或在宝箱中找到它们。"
	]
	quest.3A0CDA8BC642D716.title: "有趣的家伙"
	quest.3A0DE5EF9C708D24.quest_desc: [
