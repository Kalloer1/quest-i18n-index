	quest.289749F27B462857.title: "经验泵升级"
	quest.28B8805DB3022115.quest_desc: [
		"在 Arc Phone 上打开 &eSystem Upgrades&r 并购买一个应用。每个应用的价格为 Cobblemon &eUpgrade&r 加一个匹配的物品，两者在购买时都会被消耗："
		"&ePC&r app: 一台电脑。 &ePokédex&r app: 一本图鉴。 &eHeal&r app: 一台治愈机。 &eEnder Chest&r app: 一个末影箱。"
	]
	quest.28B8805DB3022115.title: "未包含工厂重置功能"
	quest.28C9545D46C9B0F6.quest_desc: [
		"在沼泽中找到一个&eBetter Witch Hut&r。"
		""
		"先敲门。女巫不喜欢访客。"
	]
	quest.28C9545D46C9B0F6.title: "Something Wicked"
	quest.28CD8FCB459DBFD7.quest_desc: [
