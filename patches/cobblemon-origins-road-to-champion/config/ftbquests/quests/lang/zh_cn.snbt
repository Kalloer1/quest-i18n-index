	quest.530C9863B68C5A5F.quest_subtitle: "8,000 CD"
	quest.530C9863B68C5A5F.title: "瞄准镜镜头"
	quest.53393FB22E36883E.quest_desc: [
		"&6价格：&r &e6,000 CobbleDollars&r 一个。"
		""
		"保护持有者免受目标接触效果的影响"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.53393FB22E36883E.quest_subtitle: "6,000 CD"
	quest.53393FB22E36883E.title: "防护垫"
	quest.5342283E8833069C.quest_desc: [
		"在Sinistea上使用&eCracked Pot&r（三个Clay Ball、三个Gold Ingot和一个Gold Nugget），或在Poltchageist上使用&eUnremarkable Teacup&r（三个Clay Ball和两个Nether Quartz）。"
		""
		"&a提示：&r稀有的古董奇奇菇需要破损陶罐，而工匠波利奇吉则需要大师级茶杯。"
	]
	quest.5342283E8833069C.title: "茶歇时间"
	quest.53446115EE13CC89.quest_desc: [
		"用2个铁链、3个铁锭和白色染料制作一个&e白色告示牌&r。"
		""
		"告示牌可以贴在地板、墙壁和天花板上，有全部16种染料颜色。用染料合成告示牌即可重新上色。"
	]
	quest.53446115EE13CC89.title: "名人堂纪念牌匾"
	quest.53605BD62A9398DA.quest_desc: [
		"有50%的几率反伤给攻击者。"
		""
		"&6寻找地点：&r废弃传送门、遗迹边缘；偶尔被残骸穿戴。"
