	quest.3AA4382C941CA415.title: "钙元素"
	quest.3AC83E3F5CD50F23.quest_desc: [
		"&e堡垒遗迹&r是猪灵的黑石堡垒，里面充满了黄金和宝藏。"
		""
		"&c警告：&r &e猪灵暴徒&r会守卫它们，无视你的金盔甲。逐个击败它们。"
	]
	quest.3AC83E3F5CD50F23.title: "荣耀的残骸"
	quest.3AED0C26B0DE38C4.quest_desc: [
		"&e野生亚麻&r遍布主世界的水源旁，成片生长。破坏可获得&e亚麻种子&r（用剪刀可保留植物）。"
		""
		"种子也会出现在地牢和矿井的箱子里，还有流浪商人会出售它们。"
	]
	quest.3AED0C26B0DE38C4.title: "河畔杂草"
	quest.3B00E8D4C415D065.quest_desc: [
		"&6价格：&r &e1,500 CobbleDollars&r 一个。"
		""
		"减半来自超有效的岩石类型攻击所受到的伤害"
		""
