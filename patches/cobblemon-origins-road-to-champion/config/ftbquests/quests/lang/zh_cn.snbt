	quest.3BEE5C7D2E32571D.quest_desc: [
		"获取一些&eLeftovers&r：该物品在战斗中会缓慢恢复生命值。"
		""
		"无法合成。它们可能由&e大舌舔&r、&e圆陆鲨&r、&e乐色怪&r和&e垃圾鼬&r掉落，食用苹果有极小（2.5%）的几率会留下一些。"
	]
	quest.3BEE5C7D2E32571D.title: "物尽其用"
	quest.3BEEC322F3FBFE0B.quest_desc: [
		"雪原、冰川和冰冻海岸：&e冰&r系生物的家园。"
		""
		"&a提示：&r一些寒冷气候的生成物，如单独的 Cubchoo 或 Cetoddle，只会在下雪时出现。"
