	quest.20D693E57ADEF06E.title: "心灵宝石"
	quest.20EDD46C8895862C.quest_desc: [
		"用&e治愈球&r捕捉一只宝可梦。"
		""
		"&a非常适合想立即使用的宝可梦。&r"
	]
	quest.20EDD46C8895862C.title: "重新开始"
	quest.20F410EC08A2D0BC.quest_desc: [
		"每个地区的初始宝可梦也生活在野外，但它们只会以&e超稀有&r的形态出现。"
		""
		"以下每个任务都需要一个地区的任意一个初始伙伴。你开始时选择的伙伴即代表其所属地区。"
	]
	quest.20F410EC08A2D0BC.title: "新手搜寻任务"
