	quest.0969EBB3F9012B08.quest_subtitle: "5,000 CD"
	quest.0969EBB3F9012B08.title: "珍惜球 (Cherish Ball)"
	quest.098CBD3BC00AA833.quest_desc: [
		"捕捉10只&1龙&r属性宝可梦。双属性宝可梦两种属性都算数。"
		""
		"&6强效对抗：&r 龙"
	]
	quest.098CBD3BC00AA833.title: "前方有龙"
	quest.099ACEF58006A47E.quest_desc: [
		"七项荣誉尽归你。训练师、斗士、游侠、探险家和建造者：你做到了这一切。"
		""
		"欢迎来到名人堂，&6起源的冠军&r。你的奖励包括一个&e大师球&r：把它留给真正值得的宝可梦。"
	]
	quest.099ACEF58006A47E.quest_subtitle: "王冠是你的了"
	quest.099ACEF58006A47E.title: "起源的冠军"
	quest.09BB78A2A91DA455.quest_desc: [
		"Craft &eSoul Torches&r from Coal or Charcoal, a Stick and &eSoul Sand&r or &eSoul Soil&r."
		""
		"&a提示：&r猪灵会被灵魂火排斥：灵魂火把、灵魂灯笼和灵魂篝火能将其远离你的基地。"
	]
	quest.09BB78A2A91DA455.title: "蓝色火焰"
	quest.09BE9633C7672E13.quest_desc: [
		"找到一个&6竹林&r。"
		""
		"Pancham 和 Stufful 生活在茎秆之间。"
		"&o超稀有的Kubfu在这里训练。&r"
	]
	quest.09BE9633C7672E13.title: "被迷惑了 (Bamboozled)"
	quest.09BF94A3ACB39210.quest_desc: [
