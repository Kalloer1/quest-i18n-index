	file.0000000000000001.title: "Cobblemon Origins"
	quest.0003337DF16A4D1D.quest_desc: [
		"&6价格：&r &e2,500 CobbleDollars&r 一个。"
		""
		"当持有者生命值低于或等于最大值1/4时，防御力提升1级"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.0003337DF16A4D1D.quest_subtitle: "2,500 CD"
	quest.0003337DF16A4D1D.title: "甘洛浆果"
	quest.00102E83242BB5D9.quest_desc: [
		"合成一个&ePokéNav&r：4个铜锭、1个铁锭、1颗钻石、红石、一个Electirizer和一个&e升级组件&r。"
		""
		"它会列出你周围可能出现的每只宝可梦，并按稀有度和概率排序。查找器会按完美个体值、隐藏特性、遗传招式和闪光度对附近的宝可梦进行排名，然后用箭头追踪你选择的那只。"
	]
	quest.00102E83242BB5D9.title: "PokéNav"
	quest.00125AADF6937610.quest_desc: [
		"红色真菌树、&eHoglins&r和&ePiglins&r。Hoglins会避开&eWarped Fungus&r、下界传送门和重生锚。"
		""
		"&6宝可梦：&r 幼虫、小勒、寄生、波克、幼虫和，夜间还有，莫鲁鲁。"
		"领袖布莱恩的辰砂道馆可以在两种菌菇森林中生成。"
	]
	quest.00125AADF6937610.title: "绯红森林"
	quest.00750B7CB9637F0E.quest_desc: [
		"&6效果绝佳&r的招式造成双倍伤害，&6效果不佳&r的招式造成一半，而&6免疫&r的宝可梦则不会受到伤害。"
		""
		"面对双属性宝可梦，乘数会叠加：两种弱点意味着四倍伤害，而一种弱点和一种抗性会相互抵消。"
		"&a提示：&r六个三合任务分别教授类型表的一个角落。"
	]
	quest.00750B7CB9637F0E.title: "效果显著！"
	quest.009307E351246C99.quest_desc: [
		"使用情书，&dEnamorus&r就会出现。"
		""
		"&a非书写者使用的信件有更高的闪光率。和朋友交换信件吧！&r"
	]
	quest.009307E351246C99.title: "空气中弥漫着爱意"
	quest.0095C7375756D6D8.quest_desc: [
		"&6获胜有回报：&r每击败一位训练师都会支付 &e原矿美元&r 并掉落奖品。"
		""
		"&6各胜一场：&r你击败过的训练师将不再与你战斗。游荡的训练师会来来去去，遇到时就去挑战他们吧。"
		""
		"&6故事顺序：&r道馆馆主、劲敌和火箭队只有在击败他们之前的训练家后才会接受挑战。如果他们拒绝，会告诉你原因。"
	]
	quest.0095C7375756D6D8.title: "训练师礼仪"
	quest.00A60E45C926FBC2.quest_desc: [
		"在&e升级底座&r周围放置&e8个玻璃&r。"
		""
		"用部分物品栏空间换取流体存储。下方的泵升级需要它。"
	]
	quest.00A60E45C926FBC2.title: "坦克升级"
	quest.00AB0DE01EB9F33D.quest_desc: ["所有宝可梦的总等级达到 &e500&r。它们获得的任何等级都会计入总数。"]
	quest.00AB0DE01EB9F33D.title: "等级研磨机"
