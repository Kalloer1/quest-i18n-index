	quest.5BC40602930DD665.title: "Bug Gem"
	quest.5BF603C94D0B8232.quest_desc: [
		"在&e升级台&r周围放置&e末影珍珠&r、&e铁&r、&e红石&r和&e箱子&r。"
		""
		"背包中会保持背包中已选物品的存量：火把、食物、精灵球。"
	]
	quest.5BF603C94D0B8232.title: "重新填充升级"
	quest.5C1876465104EA01.quest_desc: [
		"深暗之地的&eSculk Sensors&r能听见每一步，而Sculk Shriekers在几次警告后会召唤出Warden。"
		""
		"悄悄溜过潜声传感器或坚守者，不要发出任何声响。潜行是生存于远古城市的秘诀。"
	]
	quest.5C1876465104EA01.title: "静若处子，动若脱兔"
	quest.5C27BC61215FA1FB.quest_desc: [
		"每次使用红链时，它都会磨损，并最终断裂成一条&e碎裂的红链&r。"
		""
		"&aCombine it with &eOrigin Ingots&a in an Anvil to restore it.&r"
	]
	quest.5C27BC61215FA1FB.title: "拍到了！"
	quest.5C4F763B8252DE03.quest_desc: [
		"同时拥有所有药水效果：速度、缓慢、力量、跳跃提升、再生、火焰抗性、水下呼吸、隐身、夜视、虚弱、中毒、缓慢掉落、抗性以及四个试炼时代的特效。"
		""
		"&aBrew extended versions with Redstone and drink the short ones last.&r"
	]
	quest.5C4F763B8252DE03.title: "一杯愤怒的鸡尾酒"
	quest.5C633B9FD67AE82B.quest_desc: [
		"&6价格：&r &e6,000 CobbleDollars&r 一个。"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.5C633B9FD67AE82B.quest_subtitle: "6,000 CD"
	quest.5C633B9FD67AE82B.title: "镜像草"
	quest.5C67E6771EEFA1E3.quest_desc: [
		"在&e熔炉&r周围放置&e8个铜锭&r。"
		""
		"At &e180 ticks&r per item it is only a small step up from vanilla, but it is cheap, and the Rainbow Plating recipe needs one. A Copper Furnace can also go straight into an Iron Furnace recipe with &e6 Iron Ingots&r and &e2 Glass&r."
	]
	quest.5C67E6771EEFA1E3.title: "铜质熔炉"
	quest.5C6BC1C00A854167.quest_desc: [
		"战胜任意类型的训练家，赢得 &e100&r 场战斗。"
		""
		"故事训练师很重要，路上遇到的每个年轻人、徒步者和普通人都很重要。"
	]
	quest.5C6BC1C00A854167.quest_subtitle: "训练师获胜100次"
	quest.5C6BC1C00A854167.title: "百战百胜的资深战士"
	quest.5C78AECE99506753.quest_desc: ["制作一个&e能力胶囊&r：用龙之息酿造药用饮品，或用发光墨囊、紫水晶碎片、一瓶附魔和烈焰粉合成。它能将宝可梦切换为另一个标准能力。"]
	quest.5C78AECE99506753.title: "新的人才 (New Talent)"
	quest.5C7E6C3425E44EAA.quest_desc: [
		"还有两个箱子，还有两个配方。都需要 Payapa、Haban 和 Wepear 浆果；"
		"&e拉帝亚斯饲料&r添加了阿匹可浆果，&e拉帝奥斯饲料&r添加了帕塔亚浆果。"
		"&aApicot 和 Petaya 只能通过浆果突变获得（参见浆果章节）。&r"
	]
	quest.5C7E6C3425E44EAA.title: "双人份的甜点"
	quest.5C86241CAB7F1DFD.quest_desc: [
		"&6酿造入门&r"
		"瓶子放在底部3个槽位，一个原料放顶部，&e烈焰粉&r燃料放左边。"
		"水瓶 + &e下界疣&r = &e粗制药水&r，几乎所有药水的基础。"
		""
		"&6修饰器&r"
		"&e红石&r：持续时间更长。 &e萤石粉&r：效果更强。 &e发酵蜘蛛眼&r：使效果变质。"
		"&e火药&r：溅射型。 &e龙之息&r：滞留型。"
	]
	quest.5C86241CAB7F1DFD.title: "酿造原理介绍"
	quest.5C8B9DDD1992B276.quest_desc: [
		"这里有两种类型的冒险在等待着大家。"
		""
		"&6考古学&r: 刷可疑的沙子和砾石以获取陶器碎片、嗅探者蛋和盔甲修饰模板。"
		"&6试炼密室&r：地下铜质宝库，遍布试炼刷怪器、微风和&e战锤&r的部件。"
		"&a宝可梦提示：&r Cobblemon的化石挖掘点会将化石藏在可疑的砾石中。参见&e化石与地质学&r。"
	]
	quest.5C8B9DDD1992B276.quest_subtitle: "历史、修剪和一把非常重的锤子"
	quest.5C8B9DDD1992B276.title: "&l试炼与考古学&r"
	quest.5C992FC16EE9C384.quest_desc: [
		"一个用&e木棍&r制作的&e物品栏饰边&r。"
		""
		"配置每个物品栏与连接器之间的交互方式：包含或跳过方块，设置过滤器和优先级。物品、标签和多态物品过滤器可提供更精细的控制。"
	]
	quest.5C992FC16EE9C384.title: "物品栏配置器"
	quest.5C9F033BC95863C6.quest_desc: [
		"将 Necrozma 与 Solgaleo 或 Lunala 融合，在战斗中给予它 Ultranecrozium-Z 和 &eUltra Burst&r，使其变为 Ultra Necrozma。"
		""
		"&aCatching these legends is covered in the Legends and Myths chapter.&r"
	]
	quest.5C9F033BC95863C6.title: "刺眼的光芒"
	quest.5CA1012B9F12DB49.quest_desc: [
		"&6价格：&r &e1,500 CobbleDollars&r 一个。"
		""
		"减半来自超有效的毒属性攻击所受到的伤害"
