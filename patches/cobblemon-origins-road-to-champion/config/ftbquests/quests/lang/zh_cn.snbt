		""
		"&bSnorunt&r、&bSwinub&r、&bSnom&r、&bCetoddle&r和&bBergmite&r不畏严寒。"
	]
	quest.71A151478B71A44B.title: "下雪天"
	quest.71A25022F448B72E.quest_desc: [
