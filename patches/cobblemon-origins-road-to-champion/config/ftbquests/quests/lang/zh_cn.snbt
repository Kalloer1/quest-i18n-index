	quest.74C55823FBC909F6.quest_subtitle: "400 CD"
	quest.74C55823FBC909F6.title: "古代黄水晶球"
	quest.74C79616318399C6.quest_desc: [
		"捕捉一只同时具有&9水&r和&6地面&r属性的宝可梦。"
		""
		"地面完全抵消了水对电的弱点，但草系造成的伤害现在是四倍。"
	]
	quest.74C79616318399C6.title: "泥浆浴"
	quest.74DF27915DD78005.quest_desc: [
		"你的新手包里有一个&e治疗机器&r。放置它，让它充电（大约五分钟），然后使用它来恢复你整个队伍的生命值。"
		""
		"村庄的&e宝可梦中心&r也有一个。晕厥的宝可梦在恢复或治愈前无法战斗。"
	]
	quest.74DF27915DD78005.title: "治愈之力"
	quest.7508D4623A92BEAF.quest_desc: [
		"在 Figy、Wiki、Mago、Aguav 或 Iapapa 旁边种植一颗 &eLum Berry&r，即可变异出一颗 &eSitrus Berry&r。"
		""
		"持有者血量低于一半时，Sitrus会恢复四分之一最大血量：一个必备的持有物。"
	]
	quest.7508D4623A92BEAF.title: "Sitrus Squeeze"
	quest.751274B5453F4351.quest_desc: [
		"捕捉（或进化）一种能让你在水中移动的宝可梦。"
		""
		"&e拉普拉斯&r像船一样载你，&e美纳斯&r和&e沙皮狗&r像海豚一样跃起，而&e吼鲸王&r或&e巨鲸王&r则会像潜艇一样带你潜入水下。"
	]
	quest.751274B5453F4351.title: "冲浪开始了"
	quest.7519D6E9D90B5CD0.quest_desc: [
		"&6价格：&r &e400 CobbleDollars&r 一个。"
		""
		"治愈宝可梦的所有异常状态，同时略微降低亲密度"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.7519D6E9D90B5CD0.quest_subtitle: "400 CD"
	quest.7519D6E9D90B5CD0.title: "治疗粉末"
	quest.751A10F2CD4DFEF0.quest_desc: [
		"在&e铜质箱子&r周围放置&e4个铁锭&r（普通箱子则需要8个）。"
