		""
		"饮用茶料会附加效果：&e罂粟&r提供夜视，&e提神花&r提供力量。"
	]
	quest.760B9F44EE40D474.title: "下午茶时间"
	quest.760CF86BC4EC423A.quest_desc: [
		"找到一个&eBetter Jungle Temple&r。"
		""
		"Bronzor和Meditite生活在里面，Hawlucha在周围巡逻。"
	]
	quest.760CF86BC4EC423A.title: "丛林神庙"
	quest.763DFC5DEF1776C8.quest_desc: [
