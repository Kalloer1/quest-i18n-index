	quest.766F3D343AAA814C.quest_subtitle: "1,500 CD"
	quest.766F3D343AAA814C.title: "林多浆果"
	quest.767B16BA31044600.quest_desc: [
		"糖果和甜点：大多数都需要 &e糖&r、&e蜂蜜瓶&r 或 &e牛奶&r。"
		""
		"有几个是进化道具：用于&eMilcery&r的糖果、用于&eSwirlix&r的Whipped Dream，以及用于Poltchageist的茶杯。第&cEvolution&r章会介绍这些进化。"
	]
	quest.767B16BA31044600.title: "甜点手推车"
	quest.767B3B806E7B47F6.quest_desc: [
		"捕捉一只 &eBagon&r。"
		""
		"在&6Stony Spires&r黑暗隐蔽的角落搜寻，那里是它稀有的刷新点。"
		"&o总有一天它会长出翅膀。&r"
	]
	quest.767B3B806E7B47F6.title: "飞翔的梦想"
	quest.76848121DE062928.quest_desc: [
		"&6FTB Ultimine&r"
		"挖掘方块时按住 &e`&r`（坟场）可一次性挖掘最多 64 个相连方块。按住该键并潜行可打开形状菜单。"
		"&c消耗饥饿值很快。&r清完一整个矿脉前记得吃东西。"
		""
		"手持钥匙时，用斧头可以剥树皮，用锄头可以耕地，右键可以收割作物。"
	]
	quest.76848121DE062928.title: "一击多块，横扫千方"
	quest.76A369F094E2BA24.quest_desc: [
		"在&e升级台&r周围放置&e红石&r和&e线&r。"
		""
		"控制漏斗和管道可以推入或拉出的背包中的物品。"
	]
	quest.76A369F094E2BA24.title: "过滤器升级"
	quest.76AD346BED0EE978.quest_desc: [
		"海滩、悬崖和开阔水域。"
		""
		"许多海洋宝可梦会在水下或鱼竿上生成，所以带上&e钓竿&r（参见&e钓鱼&r章节）。"
		"&a提示：&r钓鱼的生成物也会随生物群系而变化，所以去每个海洋都抛竿试试吧。"
	]
	quest.76AD346BED0EE978.title: "海岸与海洋"
	quest.76BC329EAD79EAFD.quest_desc: ["右键点击正义咖喱以引诱 &dKeldeo&r。该咖喱只能使用一次。"]
	quest.76BC329EAD79EAFD.title: "年轻的剑士 (The Young Sword)"
	quest.76CE70E558C1CDDC.quest_desc: [
		"在稀树草原中找到一个 &eLuna Henge&r，即一个石圈。"
		""
		"Lunatone 会在夜间聚集于此。"
	]
	quest.76CE70E558C1CDDC.title: "月亮之环"
	quest.76E70E95113BF23B.quest_desc: [
		"每种熔炉各持一个，从铜到黑曜石：&e铜、铁、金、钻石、绿宝石、水晶&r和&e黑曜石&r。"
		""
		"&c七种材料都会被下一个配方消耗掉&r，所以如果还在用，就多做点备用。"
	]
	quest.76E70E95113BF23B.title: "每种各一个"
	quest.76E9E8EC7769A4BC.quest_desc: [
		"捕捉你的第一只&6闪光&r宝可梦。"
		""
		"基础闪光率为 &e1/4096&r。连续击败同一种宝可梦会提高概率，聊天框会播报每只闪光宝可梦的诞生。"
	]
	quest.76E9E8EC7769A4BC.title: "幸运的颜色"
	quest.76EBDEC90E55E9B6.quest_desc: [
		"&6价格：&r &e5,000 CobbleDollars&r 一个。"
		""
		"将宝可梦的HP努力值提高10点"
		""
		"&a点击对勾即可购买。可重复购买，仅在您负担得起时收费。&r"
	]
	quest.76EBDEC90E55E9B6.quest_subtitle: "5,000 CD"
	quest.76EBDEC90E55E9B6.title: "HP 提升"
	quest.76EC360890BC7EDC.quest_desc: [
		"从宝箱中赢取一个&eBolt Armor Trim&r模板。"
		""
		"用7个钻石和1个铜块来复制它。"
	]
	quest.76EC360890BC7EDC.title: "螺栓饰边"
	quest.76F4B5FF7D78EA6B.quest_desc: [
		"完全成熟的复兴草在收获时还会掉落一到两朵&e活力花&r。"
		""
		"它们是完全治愈的配料，所以多留几个。"
	]
	quest.76F4B5FF7D78EA6B.title: "步伐轻快，充满活力"
	quest.7701EE1687C88FA8.quest_desc: [
		"下降到 &6火山口&r 中。"
		""
		"Numel、Camerupt和Sizzlipede很常见，而Turtonator则较少见。"
		"&o盖欧卡、炎帝和热钢都可能在这里以极低概率生成。&r"
	]
	quest.7701EE1687C88FA8.title: "进入陨石坑"
	quest.77041193E1693389.quest_desc: [
		"本章充满捕获的快感：捕获量惊人、深夜行动、遥远之地、稀有初始宝可梦、闪光宝可梦和巨大的阿尔法宝可梦。"
		""
		"捕捉 &e5&r 只宝可梦即可开始。你选择的初始宝可梦也算作捕捉，战斗中捕捉的宝可梦仍能获得经验和努力值。"
	]
	quest.77041193E1693389.title: "&l必须全部捕捉它们"
	quest.7721A102E17E167D.quest_desc: [
		"探索一片&6针叶林&r。"
		""
		"松果虫挂在云杉树上，涅鲁和九尾在针叶间游荡，卡蒂狗在森林里漫步。"
		"&o超稀有的Zacian，在露天环境下被发现了。&r"
	]
	quest.7721A102E17E167D.title: "松林国度"
	quest.772386D8A54B7473.quest_desc: [
		"打开 50 个 Lootr 容器。"
		""
		"如果你检查每个角落，矿井、村庄和遗迹会很快被发现。"
	]
	quest.772386D8A54B7473.title: "经验丰富的拾荒者"
	quest.7734254BB83B4B9F.quest_desc: [
		"石头、友谊、交易和一百种进化：你见过的一切。"
		""
		"完成进化阶梯、伊布进化、交换进化与友情进化后，即可领取奖励。"
	]
	quest.7734254BB83B4B9F.title: "&l变化之主"
	quest.7735CC2E8A9D20A3.quest_desc: [
		"&eLootr&r 会给每个玩家提供每个结构容器的副本。朋友先搜刮了？你的战利品仍在里面。"
		""
		"未开启的 Lootr 容器会发光。打开你的第一个 Lootr 宝箱。"
	]
	quest.7735CC2E8A9D20A3.title: "仅属于你，独一无二"
	quest.7737537169230ED6.quest_desc: [
		"受到攻击后，你的无敌状态会持续得更久一点。"
		""
		"&6寻找地点：&r堡垒宝藏室、掠夺者前哨、大型海洋废墟、村庄神庙。"
	]
	quest.7737537169230ED6.title: "十字架项链 (Cross Necklace)"
	quest.7773278A8D0B2991.quest_desc: [
		"&6价格：&r &e15,000 CobbleDollars&r 一个。"
		""
		"提升持有者的攻击力，但会锁定其只能使用一个招式"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.7773278A8D0B2991.quest_subtitle: "冷却时间 15,000"
	quest.7773278A8D0B2991.title: "选择头带"
	quest.7774910A8D6E38DD.quest_desc: [
		"合成一个&e等级球&r：在&e铁锭&r周围放置2个粉色杏核、1个红色杏核和1个黑色杏核。"
		""
		"&6捕获率：&r1倍至4倍，宝可梦等级越高，捕获率越高。"
	]
	quest.7774910A8D6E38DD.title: "等级球 Level Ball"
	quest.7775FD03DE5CE526.quest_desc: [
		"&6价格：&r &e5,000 CobbleDollars&r 一个。"
		""
		"提升持有者与生物的友谊度增长速度"
		""
		"&a点击对勾即可购买。可重复购买，仅在您负担得起时收费。&r"
	]
	quest.7775FD03DE5CE526.quest_subtitle: "5,000 CD"
	quest.7775FD03DE5CE526.title: "安抚铃铛"
	quest.777787252F5E7696.quest_desc: [
		"用&e豪华球&r捕捉一只宝可梦。"
		""
		"&aCatch a future friendship evolver in one.&r"
	]
	quest.777787252F5E7696.title: "生活在奢华之中"
	quest.77B5D8C4AF5C7D4D.quest_desc: [
		"寻找&e黎明石矿石&r：它生成于山峰和天空生物群系下，较少生成于花卉、冰川和丘陵生物群系下。"
		"看深板岩层上方的普通石头变种。"
		""
		"&a宝可梦提示：&r这块石头能让像基拉蒂纳和雪拉比这样的宝可梦进化。"
	]
	quest.77B5D8C4AF5C7D4D.title: "黎明石矿石"
	quest.77C2566BF6CA2E74.quest_desc: [
		"将&eLum Berry&r酿成&eMax Potion&r：&eFull Restore&r可治愈所有HP和状态异常。"
		""
		"Lum Berries 由种植在 Cheri、Chesto、Pecha、Rawst 或 Aspear 树旁的 Oran 树变异而来。"
	]
	quest.77C2566BF6CA2E74.title: "全方位服务"
	quest.77C50E9F82787BA2.quest_desc: ["四瓶蜂蜜可以合成一个&e蜂蜜块&r：粘性高，行走缓慢，在红石装置中很有用。"]
	quest.77C50E9F82787BA2.title: "棘手的情况"
	quest.77CFFDC0D313DC09.quest_desc: [
		"用 3 羊毛、3 线和 1 水宝石合成 &e湿漉漉的毛线&r。"
		""
		"在 Plush-O-Matic 中，它会生成 Squirtle 系列、Shellder、Cloyster、Wooper、Quagsire、Wailmer、Wailord、Luvdisc 和 Kyogre 的玩偶。"
		""
		"&a宝石类型来自遗迹、宝石簇（化石与地质学章节）或硬石加对应抗性浆果（查看配方）。&r"
	]
	quest.77CFFDC0D313DC09.title: "湿漉漉的毛线团"
	quest.77DB9FA199B2DCCC.quest_desc: [
		"钓上10只水属性的宝可梦。"
		""
		"淡水、海洋和淹水的洞穴都含有不同类型的 Water。"
	]
	quest.77DB9FA199B2DCCC.title: "掀起波澜"
	quest.77FD0AEE75737683.quest_desc: [
		"&6价格：&r &e1,000 CobbleDollars&r 一个。"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.77FD0AEE75737683.quest_subtitle: "1,000 CD"
	quest.77FD0AEE75737683.title: "格雷帕浆果"
	quest.7831B3E28CA22E65.quest_desc: [
		"训练家遍布世界：路线上的年轻人、山中的徒步者、恶地里的火箭队，以及更远处的更强对手。"
		""
		"走到训练家面前，&e右键&r他们以发起挑战。赢得一次即可踏上旅途。"
		""
		"&a本章遵循训练家们的要求，按顺序讲述关都的故事：八个徽章、四天王，然后是冠军。&r"
	]
	quest.7831B3E28CA22E65.quest_subtitle: "你的第一场训练师对战"
	quest.7831B3E28CA22E65.title: "&6冠军之路"
	quest.784964656551F975.quest_desc: [
		"&e黄色染料&r、&e红色染料&r、&e纸&r和&e熔炉&r可以制作&e熔炉包装纸&r。"
		""
		"右键熔炉可将其作为礼物包装；潜行并右键可拆开包装。 &o但包装纸不会着火吗？&r"
	]
	quest.784964656551F975.title: "用爱包裹的礼物"
	quest.7853B72D3EA8EECB.quest_desc: [
		"《宝可梦传说：Z-A》中的新mega宝可梦之一。"
		"让&e达克莱伊&r超级进化。"
		""
		"配方：原始巨石、一颗钻石、一个&e末影之眼&r和两个&e下界合金锭&r。"
	]
	quest.7853B72D3EA8EECB.title: "暗岩矿石"
	quest.78B7F3560055AEF5.quest_desc: [
		"攻击速度更快了。"
		""
		"&6寻找地点：&r埋藏宝藏、沉船宝藏、村庄武器匠、清理遗迹。"
	]
	quest.78B7F3560055AEF5.title: "野性利爪"
	quest.78E77EA34E0EE2CC.quest_desc: [
		"&6Sophisticated Backpacks&r 是可穿戴的箱子，能随你成长：更大的等级，以及能拾取、整理、烹饪甚至治愈宝可梦的升级功能。"
		""
		"每个背包和每个升级都始于 &e皮革&r和&e线&r。五个皮革和八个线可以制作你的第一个背包和第一个升级底座。"
		"&a按下&eB&a可打开你正在穿戴的背包。&r"
	]
	quest.78E77EA34E0EE2CC.title: "&l驮运动物"
	quest.78F687192DCCB4AE.quest_desc: [
		"&6末地&r是最后一个维度：一个漂浮的岛屿，由&5末影龙&r统治，其外还有末地城、潜影者和鞘翅。"
		""
		"前往那里的路始于末影之眼的两半：&e末影珍珠&r（末影人掉落，猪灵用黄金交换）和由烈焰棒研磨而成的&e烈焰粉&r。"
	]
	quest.78F687192DCCB4AE.title: "&5将目光投向末地"
	quest.79267805EB28B31C.quest_desc: ["在丛林神庙、自由岛或塔利克的宝箱中找到&e旧海图&r。将其带到&b最终岛屿&r的妙蛙座像上；&d妙蛙&r会出现并留下一根&e妙蛙的羽毛&r。"]
	quest.79267805EB28B31C.title: "最终岛屿上的绒毛"
	quest.792B88231A7A8C87.quest_desc: [
		"&6价格：&r &e5,000 CobbleDollars&r 一个。"
		""
		"将宝可梦的能力值改为冷静性格的数值"
		""
		"&a点击对勾即可购买。可重复购买，仅在您负担得起时收费。&r"
	]
	quest.792B88231A7A8C87.quest_subtitle: "5,000 CD"
	quest.792B88231A7A8C87.title: "宁静的薄荷"
	quest.7941E4A0F86906C7.quest_desc: [
		"将钓竿投入水中并等待。浮漂下沉时，再次使用钓竿即可将钓到的宝可梦从水中拉出，作为野生宝可梦进行战斗和捕捉。"
		""
		"并非所有捕获物都是宝可梦，你也会钓到其他物品。"
	]
	quest.7941E4A0F86906C7.title: "捕鱼模式开启！"
	quest.795E653B778376AE.quest_desc: [
		"合成一个&eNest Ball&r：在&eIron Ingot&r周围放置2个黄色杏核和2个绿色杏核。"
		""
		"&6捕获率：&r1倍至4倍，目标等级低于30级时越高。"
	]
	quest.795E653B778376AE.title: "鸟巢球"
	quest.796387D862FCE6B1.quest_desc: [
		"你的图鉴有两个列表：&e已遇见&r和&e已捕捉&r。扫描新物种会将其登记；拥有该物种会标记为已捕捉。"
		""
		"本章奖励你填满两个列表，研究所有区域，并建造能帮你找到缺失物品的工具。"
	]
	quest.796387D862FCE6B1.title: "&l宝可梦图鉴研究"
	quest.7992FF5F5D49D340.quest_desc: [
		"用 Arc Phone 追踪并进入 &bTurnback Cave&r。试炼室和宝箱里有 &eGriseous Keys&r，能打开洞穴的宝库。"
		""
		"它的传送门房间内有一个&e扭曲传送门&r。"
	]
	quest.7992FF5F5D49D340.title: "回头的洞穴"
	quest.79A64EB236AF2750.quest_desc: [
		"击败奶牛会掉落&e皮革&r。繁殖的牛群意味着你永远不会短缺。"
		""
		"宝可梦联动：&a皮革可用于制作&r&e专注围巾&r、&e专注带&r和&e肌肉带&r；&e突击背心&r和&e重型靴子&r则通过皮革盔甲使用皮革。"
	]
	quest.79A64EB236AF2750.title: "鞣制皮革"
	quest.79BF5FD98F92C742.quest_desc: [
		"击败一名&c突袭队长&r：佩戴条纹掠夺者旗帜的袭击者。队长领导掠夺者巡逻队。"
		""
		"掠夺者队长总是会掉落一个&eOminous Bottle&r。"
	]
	quest.79BF5FD98F92C742.title: "把旗帜拿掉，一了百了！"
	quest.79C6DB899495A6EA.quest_desc: [
		"补充物可以用&e砂轮&r剥离&e附魔金苹果&r的魔法，使其变为普通金苹果。"
		""
		"&c这会毁掉游戏中最稀有的食物之一。&r仅限真正热爱此道的玩家。两颗普通苹果作为安慰奖。"
	]
	quest.79C6DB899495A6EA.title: "你为什么要这么做？！"
	quest.79DF832B6EB73034.quest_desc: [
		"&6价格：&r &e1,500 CobbleDollars&r 一个。"
		""
		"减半来自超有效的电系招式所受到的伤害"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.79DF832B6EB73034.quest_subtitle: "1,500 CD"
	quest.79DF832B6EB73034.title: "瓦坎浆果"
	quest.7A01B78A6B09068B.quest_desc: ["Registeel、Regirock、Regice、Regieleki 和 Regidrago 石板组成了 &eTitan Key&r，可以开启 Regigigas 的房间。"]
	quest.7A01B78A6B09068B.title: "巨人的钥匙 (Key of the Colossus)"
	quest.7A1051714293B038.quest_desc: [
		"&6价格：&r &e2000 CobbleDollars&r 一个。"
		""
		"将宝可梦的攻击努力值提高4点"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.7A1051714293B038.quest_subtitle: "2000 冷却时间"
	quest.7A1051714293B038.title: "肌肉麻薯"
	quest.7A20328AB98EC06E.quest_desc: [
		"将&e火药&r加入虚弱药水以酿造&e溅射虚弱药水&r。"
		""
		"投掷的溅射药水会击中附近的一切，无论是敌是友。这个药水会在治愈僵尸村民前削弱它。"
		"&a顽皮蛋和电击兽会掉落火药。&r"
	]
	quest.7A20328AB98EC06E.title: "制造水花 Splash"
	quest.7A35579139F97A30.quest_desc: [
		"用3个玻璃、2个平滑石板和1个羊毛方块制作一个&e展示柜&r。"
		""
		"放入物品来展示它：你的第一个精灵球、一块稀有的化石、一个你因害怕而不敢使用的大师球。"
	]
	quest.7A35579139F97A30.title: "展示与分享"
	quest.7A36BD537CB2C372.quest_desc: [
		"&6价格：&r &e400 CobbleDollars&r 一个。"
		""
		"1× 捕获率"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.7A36BD537CB2C372.quest_subtitle: "400 CD"
	quest.7A36BD537CB2C372.title: "远古象牙球"
	quest.7A36DB9C6963E3C2.quest_desc: [
		"用&e大师球&r合成一个捕虫网。浪费吗？也许是吧。"
		""
		"但只有大师钓竿才能钓到稀有的&eWhiscash&r变种。"
	]
	quest.7A36DB9C6963E3C2.title: "过度捕捞的垂钓者"
	quest.7A59F7010546C084.quest_desc: [
		"&eMagma Cubes&r drop &eMagma Cream&r, or craft it from Blaze Powder and a Slimeball."
		""
		"四个可合成一个&e岩浆块&r，即 Cobblemon 的&eMagmarizer&r核心：用持有岩浆块的 Magmar 交易，它会进化成&eMagmortar&r。岩浆奶油在篝火锅中还能烤出&e熔岩饼干&r。"
	]
	quest.7A59F7010546C084.title: "熔融黏液"
	quest.7A66F2F2C835CE10.quest_desc: [
		"蓝色火焰、骨头柱子、&e恶魂&r和&e骷髅&r。灵魂沙会让你减速。"
		""
		"&6宝可梦：&r天黑后的胆小鬼和引火灯火，还有古拉、黏美龙和槲寄生。"
		"&a提示：&r在末地升到28级的卡布高会进化成&e阿罗拉圆陆鲨&r。"
	]
	quest.7A66F2F2C835CE10.title: "灵魂沙山谷"
	quest.7A6B7012338014B4.quest_desc: [
		"Mega Evolve 了 &e50&r 次，Mega Charizard、Lucario、Gengar 和 Garchomp 都已记录在案。"
		""
		"陨石、钥匙石、一堆超级石，以及一支比以往更闪耀的团队：你已经掌握了超级进化。"
	]
	quest.7A6B7012338014B4.title: "&6超级大师"
	quest.7A74DD6A6DCC6D67.quest_desc: [
		"登记了 &e200&r 个物种为 &e已发现&r（已捕获物种数也计入）。"
		""
		"扫描你遇到的所有东西。已发现的条目会告诉你某个物种存在于此处，甚至在你捕捉到它之前。"
	]
	quest.7A74DD6A6DCC6D67.title: "敏锐观察者 Keen Observer"
	quest.7A85ED37192BD686.quest_desc: [
		"使用电器将 &eRotom&r 吸入其中，并改变其形态。"
		""
		"一个&e罗托姆图鉴&r让它能进出各种装置。"
	]
	quest.7A85ED37192BD686.title: "机器中的幽灵"
	quest.7A9E6D0C0601A3AE.quest_desc: [
		"每击杀一条龙，都会在中心岛屿边缘开启一个 &e末地传送门&r。"
		""
		"向里面投掷一个&e末影珍珠&r，就能传送到末地城市所在的外围岛屿。"
	]
	quest.7A9E6D0C0601A3AE.title: "超越传送门"
	quest.7AC70ACF5BD874EF.quest_desc: ["五个&e噩梦精华&r可以制作&e新月哨子&r。"]
	quest.7AC70ACF5BD874EF.title: "午夜旋律"
	quest.7AD02A45E654D7CD.quest_desc: [
		"喂食吉米古尔 &eRelic Coins&r 以填满其硬币储备：1枚硬币计1，1个袋子计9，1个大袋子计81。"
		""
		"在拥有999枚硬币后，升级它，它就会进化成Gholdengo。"
	]
	quest.7AD02A45E654D7CD.title: "硬币收集者"
	quest.7AD6412DF9596DFD.quest_desc: [
		"&6价格：&r &e4,000 CobbleDollars&r 一个。"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.7AD6412DF9596DFD.quest_subtitle: "4,000 CD"
	quest.7AD6412DF9596DFD.title: "吸收灯泡"
	quest.7ADBB74A806DA513.quest_desc: [
		"在宝可梦图鉴中登记 &e50&r 种宝可梦为&e已捕获&r。"
		""
		"每种生物只需捕捉一次。之后，就去寻找新的目标吧。"
	]
	quest.7ADBB74A806DA513.title: "五十之数"
	quest.7ADD0B7695BEC789.quest_desc: [
		"合成一个&eDusk Ball&r：将2个Green Apricorns和2个Black Apricorns围绕一个&eGold Ingot&r放置。"
		""
		"&6捕获率：&r亮度0时为3.5倍，亮度1至7时为3倍。"
	]
	quest.7ADD0B7695BEC789.title: "黄昏球"
	quest.7ADEC75046DAD7C3.quest_desc: [
		"&6个体值 (IVs)&r 是宝可梦的天赋：各项能力值中从0到31的数字，显示在摘要的&e能力值&r页面上。"
		""
		"个体值不能像努力值一样训练，但可以覆盖：&e个体值糖果&r可将一项能力值提升1点，而 Cobblemon Utility+ 的 &e瓶盖&r 和 &o超训&r 可将一项能力值提升至31。"
	]
	quest.7ADEC75046DAD7C3.title: "个体数值"
	quest.7AF13EB33DB88ECA.quest_desc: [
		"&6价格：&r &e3,000 CobbleDollars&r 一个。"
		""
		"使某些宝可梦进化"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.7AF13EB33DB88ECA.quest_subtitle: "3,000 冷却时间"
	quest.7AF13EB33DB88ECA.title: "闪亮石头"
	quest.7AF2D912AC864A7D.quest_desc: ["用纪念碑宝箱中找到的9个碎片修复&e第一首歌的唱片&r，并收集四张音乐唱片：&ePigstep&r、&e5&r、&eCreator&r和&eRelic&r。"]
	quest.7AF2D912AC864A7D.title: "圆形剧场中的歌曲"
	quest.7AF8B353D88E1C9C.quest_desc: [
		"&e深层板岩&r和&e燧石&r可以合成&e深层板岩碎片&r。"
		""
		"将其放入传送板中即可&e锁定&r该传送板。"
	]
	quest.7AF8B353D88E1C9C.title: "锁与钥匙"
	quest.7B0B10F543859ABF.quest_desc: [
		"&e训练家梅&r在&e平原&r和&e森林&r中旅行，并向持有灵魂徽章的人发起挑战。"
		""
		"Solrock、Breloom、Manectric、Relicanth、Flygon 和 Blaziken。"
	]
	quest.7B0B10F543859ABF.quest_subtitle: "训练师 梅 (Trainer May)"
	quest.7B0B10F543859ABF.title: "一条不同的道路"
	quest.7B0D8B5385A9696F.quest_desc: [
		"&6价格：&r &e6,000 CobbleDollars&r 一个。"
		""
		"将 Counterfeit Poltchageist 进化为 Unremarkable Sinistcha"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.7B0D8B5385A9696F.quest_subtitle: "6,000 CD"
	quest.7B0D8B5385A9696F.title: "平平无奇的茶杯"
	quest.7B0F5F6EFE346A95.quest_desc: [
		"YUNG's &eLost Caves&r 位于最炎热、最干旱的土地之下，例如沙漠。"
		""
		"古老的砂岩、带刺的藤蔓和仙人掌遍布其中。 &c藤蔓会伤人。&r"
	]
	quest.7B0F5F6EFE346A95.title: "失落洞穴"
	quest.7B37A41BD66279E3.quest_desc: [
		"四根线和一团史莱姆球可以制作成两个&e牵引绳&r。"
		""
		"用绳子把动物牵回家圈起来，或者把它们拴在围栏柱子上。"
	]
	quest.7B37A41BD66279E3.title: "引领羊群"
	quest.7B556E6EC675A6A5.quest_desc: [
		"&6价格：&r &e8,000 CobbleDollars&r 一个。"
		""
		"持有者有几率在受到可能导致KO的攻击后幸存，并保留1点生命值"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.7B556E6EC675A6A5.quest_subtitle: "8,000 CD"
	quest.7B556E6EC675A6A5.title: "专注手环"
	quest.7B61B28BD83C3EFA.quest_desc: [
		"你自己的传送石、连锁的传送板、应急卷轴、背包里的床和身下的翅膀。"
		""
		"这个区域的每个角落都离得很近了，再也没有偏远之处了。"
	]
	quest.7B61B28BD83C3EFA.title: "经验丰富的旅行者"
	quest.7B6F4C945AB710CD.quest_desc: [
		"&e恶魂&r漂浮在开阔的岩浆上，并射出会爆炸的火焰球。"
		""
		"击杀5只。弓箭会很有帮助，而鹅卵石盾牌墙的效果更佳。它们会掉落&eGhast Tears&r和火药。"
	]
	quest.7B6F4C945AB710CD.title: "爱哭鬼们"
	quest.7B707CB3D8E55AC3.quest_desc: [
		"&eCave Spiders&r only come from spawners. Trial Chambers have them in their small-mob spawners. They are small, fast and poisonous."
		""
		"杀死10个。牛奶可以治愈中毒。"
	]
	quest.7B707CB3D8E55AC3.title: "洞穴爬行生物"
	quest.7B726A44FF764EA5.quest_desc: [
		"在深板岩中挖掘&e远古残骸&r（Y -64至0），将其熔炼成&e哥布林废料&r；回头洞的箱子里也有一些。"
		""
		"四个哥斯拉废料和一种宝石可以制作成4个哥斯拉锭：岩石、冰、钢、电或龙宝石，用于制作对应的锭。"
	]
	quest.7B726A44FF764EA5.title: "泰坦金属"
	quest.7B927463452241B8.quest_desc: ["花15,000买一个&eBeast Ball&r，这是商人会卖的仅次于Master Ball的最贵的球。"]
	quest.7B927463452241B8.title: "大事件"
	quest.7B9D0AE26AB77A63.quest_desc: [
		"用鱼竿和&e扭曲菌&r合成&e扭曲菌串烧&r。"
		""
		"史特莱德会像猪追胡萝卜一样跟着它。去拿下一个步骤的鞍子奖励。"
	]
	quest.7B9D0AE26AB77A63.title: "胡萝卜钓竿，下界版"
	quest.7BE524583C2C32D8.quest_desc: [
		"用四根线、一颗幽灵宝石、一颗冰宝石和一块青金石合成&e团结缰绳&r。"
		""
		"它们将卡利雷克斯与格拉斯特rier或斯佩克特rier结合。有关宝可梦，请参阅传说与神话章节。"
	]
	quest.7BE524583C2C32D8.title: "国王与坐骑"
	quest.7C08BFCD8B2DD547.quest_desc: [
		"&6价格：&r &e4,000 CobbleDollars&r 一个。"
		""
		"持有者的重量减半"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.7C08BFCD8B2DD547.quest_subtitle: "4,000 CD"
	quest.7C08BFCD8B2DD547.title: "浮空石"
	quest.7C0D97630124F74B.quest_desc: [
		"薄荷由一个要提升的属性的三片叶子和一片要降低的属性的叶子组成。"
		""
		"&eAdamant&r（红3、青1）、&eModest&r（青3、红1）、&eJolly&r（绿3、青1）和&eTimid&r（绿3、红1）是经典搭配。"
	]
	quest.7C0D97630124F74B.title: "自然课堂"
	quest.7C50EFCABD5F2E48.quest_desc: [
		"你击败了五星级首领，掌握了欢呼，并建立了自己的巢穴。"
		""
		"完成工作：总共赢得 &e50&r 次突袭。"
	]
	quest.7C50EFCABD5F2E48.quest_subtitle: "50次突袭胜利"
	quest.7C50EFCABD5F2E48.title: "&6突袭冠军"
	quest.7C54F9DCD8498B5B.quest_desc: [
		"用9个Relic Coins合成一个&eRelic Coin Pouch&r。"
		""
		"&a银行用袋子支付475，但用九枚散币只支付450。&r放置的袋子会自己掉落，所以作为装饰很安全。"
	]
	quest.7C54F9DCD8498B5B.title: "硬币钱包"
	quest.7C563CB9805641D9.quest_desc: [
		"获得一个&e巨型小火龙宝可梦玩偶&r。"
		""
		"用4个缠绕在羊毛方块上的Charmander Pokédoll合成，或者试试运气：大约每4次拉动Fiery Yarn，就会有一次直接掉落。"
	]
	quest.7C563CB9805641D9.title: "超大号尺寸"
	quest.7C823CD4B18C404E.quest_desc: [
		"一个&e史莱姆球&r和&e纸&r可以制作一卷&e包装胶带&r。"
		""
		"将其用于Sophisticated箱子或桶中进行打包，这样破坏时它会连同内部物品一起作为一个物品掉落。每次滚动都有使用次数限制。"
	]
	quest.7C823CD4B18C404E.title: "搬家日"
	quest.7C87DA4C472CA654.quest_desc: [
		"&6价格：&r &e5,000 CobbleDollars&r 一个。"
		""
		"将宝可梦的能力值改为勇敢性格的数值"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.7C87DA4C472CA654.quest_subtitle: "5,000 CD"
	quest.7C87DA4C472CA654.title: "勇敢的薄荷（Brave Mint）"
	quest.7CC88341742CFF57.quest_desc: [
		"复活一只&e闪光&r的化石宝可梦。"
		""
		"机器自带闪亮几率：这里是1/100，远高于野外的1/4096。"
	]
	quest.7CC88341742CFF57.title: "抛光骨骼"
	quest.7CDD72ED7360CB34.quest_desc: [
		"&6价格：&r &e2,500 CobbleDollars&r 一个。"
		""
		"持有者在生命值低于或等于最大值1/4时会获得专注能量效果"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.7CDD72ED7360CB34.quest_subtitle: "2,500 CD"
	quest.7CDD72ED7360CB34.title: "Lansat Berry"
	quest.7CE1CBE74BB8E62C.quest_desc: [
		"致命一击会将你传送到安全地点，而不是杀死你。使用后消耗。"
		""
		"&6查找地点：&r末地城市宝箱，林地府邸。"
	]
	quest.7CE1CBE74BB8E62C.title: "紫颂木图腾"
	quest.7CF9A29DCC290496.quest_desc: [
		"在完整的蜂巢或蜂箱上使用玻璃瓶可获得一瓶&e蜂蜜瓶&r。"
		""
		"&a宝可梦联动：&r将蜂蜜涂在&eSaccharine&r原木上可以吸引宝可梦，可用于制作&ePoké Snacks&r、Mochi和Sweets，也可以直接从&eVespiquen&r身上采集。"
	]
	quest.7CF9A29DCC290496.title: "甜如蜂蜜一般美好"
	quest.7CFD62390ECADFCB.quest_desc: [
		"三块木板可以制作成两个&e物品架&r。将其中一个挂在墙上，右键点击并用物品放置即可展示。"
		""
		"一排架子可以做成很棒的精灵球收藏墙。"
	]
	quest.7CFD62390ECADFCB.title: "正在展示中"
	quest.7D277F3B15B92CAA.quest_desc: [
		"&6价格：&r &e8,000 CobbleDollars&r 一个。"
		""
		"每回合治疗持有者所受伤害的一部分"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.7D277F3B15B92CAA.quest_subtitle: "8,000 CD"
	quest.7D277F3B15B92CAA.title: "贝壳铃铛"
	quest.7D312E965713A113.quest_desc: [
		"踏上&6Mirage Isles&r的土地。"
		""
		"Foongus和Amoonguss很常见，但真正的宝藏是超稀有的：所有四只Tapu，Koko、Lele、Bulu和Fini，都可能在这里生成。"
	]
	quest.7D312E965713A113.title: "是海市蜃楼吗？"
	quest.7D38F46A942E4910.quest_desc: [
		"在沙滩、海岸或海洋生物群系中捕捉 &e5&r 只宝可梦（Terralith 变种也算）。"
		""
		"&bShellos&r、&bSandygast&r和&bWiglett&r在沙滩上挖掘；&bKrabby&r、&bStaryu&r和&bBinacle&r紧贴海岸线。"
	]
	quest.7D38F46A942E4910.title: "海滩拾贝者"
	quest.7D41A4A281476730.quest_desc: [
		"从喵喵那里获得一枚&e哥班硬币&r，或在建筑宝箱中找到一枚。"
		""
		"只有一台机器能接受它们。"
	]
	quest.7D41A4A281476730.title: "Koban 硬币"
	quest.7D48D4271F2E2630.quest_desc: [
		"&6价格：&r &e600 CobbleDollars&r 一个。"
		""
		"将宝可梦的防御努力值提高1点"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.7D48D4271F2E2630.quest_subtitle: "600 CD"
	quest.7D48D4271F2E2630.title: "抵抗羽毛"
	quest.7D49C78A9908AFF6.quest_desc: [
		"合成任意物种的&e巨型石头&r。"
		""
		"最经典的石头配方是中间放一个生Mega Stone，两侧各放两个铁锭，下面放一个钻石，上面放一个主题相关的物品。"
		""
		"每种石头都只适用于一个物种。将鼠标悬停在石头上，即可看到它所属的宝可梦。"
	]
	quest.7D49C78A9908AFF6.title: "石之冷酷力量"
	quest.7D5CA9C366C2BA66.quest_desc: [
		"&6价格：&r &e3,000 CobbleDollars&r 一个。"
		""
		"没有任何效果"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.7D5CA9C366C2BA66.quest_subtitle: "3,000 冷却时间"
	quest.7D5CA9C366C2BA66.title: "烟雾球"
	quest.7D780E4B36E1F544.quest_desc: ["合成 &e黄金瓶盖&r：六个银瓶盖、两个金块和一片白薄荷叶可合成一对。一个瓶盖能让所有 IV 一次性提升至 31。"]
	quest.7D780E4B36E1F544.title: "黄金标准"
	quest.7D849E1B446851A6.quest_desc: [
		"捕捉一只&4格斗&r、一只&d超能力&r和一只&8黑暗&r属性的宝可梦。"
		""
		"超能力克制格斗，黑暗免疫超能力，格斗克制黑暗。"
	]
	quest.7D849E1B446851A6.title: "心理游戏"
	quest.7D8ACF8D3AA2C8F3.quest_desc: [
		"&6价格：&r &e5,000 CobbleDollars&r 一个。"
		""
		"延长沙尘暴的持续时间"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.7D8ACF8D3AA2C8F3.quest_subtitle: "5,000 CD"
	quest.7D8ACF8D3AA2C8F3.title: "光滑的岩石"
	quest.7DA4B7A2AE27D85E.quest_desc: [
		"让&e不死图腾&r来拯救你的生命。"
		""
		"只有在手持时有效，所以在冒险战斗前，先把它换到副手吧。"
	]
	quest.7DA4B7A2AE27D85E.title: "今天不行，改天再说"
	quest.7DB61CE6E0F1C4FF.quest_desc: [
		"&6价格：&r &e1,200 CobbleDollars&r 一个。"
		""
		"使宝可梦的经验值增加3000经验值"
		""
		"&a点击对勾即可购买。可重复购买，仅在您负担得起时才会收费。&r"
	]
	quest.7DB61CE6E0F1C4FF.quest_subtitle: "冷却时间：1200秒"
	quest.7DB61CE6E0F1C4FF.title: "经验糖果 M"
	quest.7DBC39421EF86B3B.quest_desc: [
		"&6度过第一个夜晚&r"
		"在山坡或墙壁上挖个洞把自己困住，然后点燃每个角落。"
		""
		"野生宝可梦有自己的作息时间：咕咕和鬼斯只在夜间出没。"
		"打开背包中的 &eFTB Chunks: Claim Manager&r 按钮，以认领你的基地所在的区块。"
	]
	quest.7DBC39421EF86B3B.title: "温馨的小窝，甜蜜的家园"
	quest.7DEDB07DE7C53A44.quest_desc: [
		"&6价格：&r &e15,000 CobbleDollars&r 一个。"
		""
		"提升持有者的速度，但会锁定其只能使用一种移动方式"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.7DEDB07DE7C53A44.quest_subtitle: "冷却时间 15,000"
	quest.7DEDB07DE7C53A44.title: "选择围巾 (Choice Scarf)"
	quest.7DF0213FFB8EE627.quest_desc: [
		"&e传送卷轴&r会打开一个到你所选路石的&e传送门&r。需要足够的空间来放置传送门。"
		""
		"配方：4个&e紫宝石碎片&r、1个&e墨囊&r、1个&e末影珍珠&r和3张&e纸&r可制作3个。"
	]
	quest.7DF0213FFB8EE627.title: "现在你开始用传送门思考了"
	quest.7E0654FC6AF59263.quest_desc: [
		"用 3 羊毛、3 线和一颗普通宝石合成 &e普通毛线&r。"
		""
		"在 Plush-O-Matic 中，它会生成伊布、暖暖猪、肥嘟嘟左卫门、幸福蛋、大舌舔、懒人熊和卡比兽的玩偶。"
		""
		"&a宝石类型来自遗迹、宝石簇（化石与地质学章节）或硬石加对应抗性浆果（查看配方）。&r"
	]
	quest.7E0654FC6AF59263.title: "普通毛线"
	quest.7E15E0CF6DB3DA3D.quest_desc: [
		"在战斗中击败25只野生&2虫&r属性宝可梦。"
		""
		"&6弱点：&r火焰、飞行、岩石"
		"&c抗性：&r 战斗、草地、地面"
	]
	quest.7E15E0CF6DB3DA3D.title: "害虫防治"
	quest.7E3E180AB13329D9.quest_desc: [
		"放置一个由4个类型宝石合成的&e类型宝石方块&r，使其与深板岩晶核接触。"
		""
		"随着时间的推移，核心上的能量会生成对应类型的宝石簇。将其打破即可获得相应宝石。"
	]
	quest.7E3E180AB13329D9.title: "它们是矿物！"
	quest.7E4F5637B29A360E.quest_desc: [
		"NPC训练师是个好练习，但真正的考验是另一位玩家。"
		""
		"向朋友发起挑战并&e获胜&r。只有击败其他玩家才算数。"
	]
	quest.7E4F5637B29A360E.quest_subtitle: "玩家对战玩家"
	quest.7E4F5637B29A360E.title: "宿敌对决"
	quest.7E7856D7A1CA755C.quest_desc: [
		"&6价格：&r &e300 CobbleDollars&r 一个。"
		""
		"如果烧制，载体就会被治愈"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.7E7856D7A1CA755C.quest_subtitle: "300 冷却时间"
	quest.7E7856D7A1CA755C.title: "原始浆果"
	quest.7E7F00F6E6DB7D56.quest_desc: [
		"一个&e铁锭&r和四个&e铁粒&r可以制作一个&e泡泡吹风机&r。"
		""
		"在合成台里把它和 &e肥皂&r 组合起来填充（一格能用很久），然后按住使用键吹出泡泡流。"
	]
	quest.7E7F00F6E6DB7D56.title: "泡泡麻烦"
	quest.7E8B5F7C2E25D2D0.quest_desc: [
		"捕捉10只&d妖精&r属性的宝可梦。双属性宝可梦两种属性都算数。"
		""
		"&6擅长对抗：&r 战斗、龙、黑暗生物"
	]
	quest.7E8B5F7C2E25D2D0.title: "童话故事"
	quest.7E8EABE431E06B6D.quest_desc: [
		"&6价格：&r &e6,000 CobbleDollars&r 一个。"
		""
		"在交易时手持 Magmar 可使其进化为 Magmortar"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.7E8EABE431E06B6D.quest_subtitle: "6,000 CD"
	quest.7E8EABE431E06B6D.title: "Magmarizer"
	quest.7E99CBF10F69EC33.quest_desc: [
		"木板、半砖，还有一个不同形状的&e红石火把&r。"
		""
		"Limited Barrels I to IV 只能存放一至四种物品，但每个槽位都有巨大的堆叠倍率。非常适合批量存放 Cobblestone、Apricorns 或 Berries。"
	]
	quest.7E99CBF10F69EC33.title: "限定桶"
	quest.7EA909ACE8ADC427.quest_desc: [
		"佩戴 Tera Orb 并在战斗中选择 &eTerastallize&r。"
		""
		"你的宝可梦在战斗中会保持其Tera类型，该类型的招式威力更高。每场战斗只能Tera化一次。"
	]
	quest.7EA909ACE8ADC427.title: "皇冠珠宝"
	quest.7EE9FCA87E0873FA.quest_desc: [
		"&6价格：&r &e6,000 CobbleDollars&r 一个。"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.7EE9FCA87E0873FA.quest_subtitle: "6,000 CD"
	quest.7EE9FCA87E0873FA.title: "深海鳞片"
	quest.7EF64500377F8F94.quest_desc: [
		"捕捉任意一只帕迪亚地区的初始宝可梦。"
		""
		"在花丛繁茂的魔法生物群系里有&bSprigatito&r，在贫瘠之地有&bFuecoco&r，在河流附近有&bQuaxly&r。"
	]
	quest.7EF64500377F8F94.title: "帕尔迪亚野餐"
	quest.7EF6529F47821B45.quest_desc: [
		"&6价格：&r &e6,000 CobbleDollars&r 一个。"
		""
		"将Charcadet进化为Ceruledge"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.7EF6529F47821B45.quest_subtitle: "6,000 CD"
	quest.7EF6529F47821B45.title: "恶意盔甲 (Malicious Armor)"
	quest.7EF7C74795D10B10.quest_desc: [
		"&6价格：&r &e750 CobbleDollars&r 一个。"
		""
		"1.5倍，飞行距离更远"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.7EF7C74795D10B10.quest_subtitle: "750 CD"
	quest.7EF7C74795D10B10.title: "远古之翼球"
	quest.7F17C1F1A3D2EB4A.quest_desc: [
		"继乔瓦尼之后，&e劲敌特里&r带着更强的队伍回到了&e平原&r：星耀、电击兽、达摩狒狒、毽子草和巨沼怪。"
		""
		"再次击败他。"
	]
	quest.7F17C1F1A3D2EB4A.quest_subtitle: "竞争对手 泰瑞"
	quest.7F17C1F1A3D2EB4A.title: "好条款？"
	quest.7F1BC07AEC41BAA6.quest_desc: [
		"制作一个&e远古起源球&r：将4个起源锭围绕红链放置。"
		""
		"&c合成会消耗红链，所以先召唤帝牙卢卡和帕尔基亚。&r"
	]
	quest.7F1BC07AEC41BAA6.title: "大师球出现之前"
	quest.7F2C42CFDFB28A42.quest_desc: ["获得一个&e不死图腾&r。唤魔者会掉落，钟楼宝箱中也可能有一个。"]
	quest.7F2C42CFDFB28A42.title: "陨落的英雄们"
	quest.7F35FD897E768DFC.quest_desc: [
		"形状告诉你任务内容：&6齿轮&r开启章节，大的&6八角形&r是终章，&6六边形&r标记里程碑和地点，&6心形&r是稀有物品，而&6方形&r则是像这样便签。"
		""
		"在书中，滚动可缩放，拖动可移动视角。固定任务可使其进度在屏幕上显示，方便你一边游戏一边查看。"
		""
		"&a领取所有跳过奖励箱（随机抽取和选一）：请逐个打开它们。&r"
	]
	quest.7F35FD897E768DFC.title: "阅读书籍"
	quest.7F4BE54D44FC2E71.quest_desc: [
		"捕捉任意一只阿罗拉地区的初始宝可梦。"
		""
		"森林里和针叶林里有&bRowlet&r，丛林里有&bLitten&r，海岸边有&bPopplio&r。"
	]
	quest.7F4BE54D44FC2E71.title: "岛屿挑战者"
	quest.7F4EBD118F60914F.quest_desc: [
		"喝水和吃东西的速度都加快了一点。"
		""
		"&6查找地点：&r 沙漠水井、矿井宝箱、埋藏宝藏中；骷髅偶尔会佩戴。"
	]
	quest.7F4EBD118F60914F.title: "塑料吸管帽"
	quest.7F657AFA028C8DAB.quest_desc: [
		"收集 Cobblemon 中的所有浆果各一个。"
		""
		"完成以上任务的突变组合，并继续种植。真正的植物学家荣誉徽章。"
	]
	quest.7F657AFA028C8DAB.title: "糟糕，全是浆果！"
	quest.7F6B1F85B6B377C6.quest_desc: [
		"炎热、潮湿、拥挤：丛林和沼泽里充满了生物。"
		""
		"预计会遇到&e草&r、&e虫&r和&e水&r属性的宝可梦，还有出乎意料多的竹子系战斗者。"
		"&a提示：&r 部分沼泽宝可梦，如蚊香蝌蚪，会在水面上生成。"
	]
	quest.7F6B1F85B6B377C6.title: "丛林与沼泽"
	quest.7F752C4B6F17873E.quest_desc: [
		"捕捉 &e10&r 只宝可梦。"
		""
		"先削弱野生宝可梦：低HP和异常状态都能提高成功率。"
	]
	quest.7F752C4B6F17873E.title: "口袋妖怪（Pocket Monsters）"
	quest.7F9A9B6B853B1565.quest_desc: [
		"&6价格：&r &e4,000 CobbleDollars&r 一个。"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.7F9A9B6B853B1565.quest_subtitle: "4,000 CD"
	quest.7F9A9B6B853B1565.title: "电池单元"
	quest.7FC8C52902D44B31.quest_desc: [
		"用你的宝可梦图鉴扫描 &e250&r 只宝可梦。"
		""
		"扫描仪能探测到最远 &e10&r 格内的宝可梦，并能识别你尚未遇到的物种。"
	]
	quest.7FC8C52902D44B31.title: "数据收藏家"
	quest.7FDCD326BE4A3DBD.quest_desc: [
		"赢得一场&c突袭&r：存活每一波掠夺者、卫道士、女巫、劫掠兽和唤魔者。"
		""
		"胜利会授予你&e村庄英雄&r：村民会降价，有些人还会送你礼物。"
		"&a敲响村庄的钟声以揭示落单者，让你的铁傀儡冲在最前线。&r"
	]
	quest.7FDCD326BE4A3DBD.title: "村庄的英雄"
	quest.7FE05C599975F982.quest_desc: [
		"&6价格：&r &e600 CobbleDollars&r 一个。"
		""
		"捕捉时完全恢复HP、PP和状态异常"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.7FE05C599975F982.quest_subtitle: "600 CD"
	quest.7FE05C599975F982.title: "治疗球"
	quest.7FF4BDC279E16C01.quest_desc: [
		"&bDyna Plains&r的dojo村庄里有一个&bGrand Dojo&r（携带Black Belt，Arc Phone会追踪到）。在那里击败&dMustard&r，他会把&dKubfu&r交给你。"
		""
		"&a黑暗与水之塔的领主会奖励将Kubfu进化为Urshifu的卷轴。&r"
	]
	quest.7FF4BDC279E16C01.title: "道场学徒"
