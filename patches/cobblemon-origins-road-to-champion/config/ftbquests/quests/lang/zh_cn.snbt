	quest.71AA4FF7118E8146.quest_subtitle: "8,000 CD"
	quest.71AA4FF7118E8146.title: "地形扩展器 (Terrain Extender)"
	quest.71AB2791CF385BCD.quest_desc: ["召唤全部三种野兽，然后将&e红色&r、&e黄色&r和&e蓝色羽毛&r组合成&e彩虹羽毛&r。"]
	quest.71AB2791CF385BCD.title: "所有颜色一次性呈现"
	quest.71BE1F377BD36C80.quest_desc: [
		"用四个雷石包围一个&eElectrium-Z&r来制作&ePikanium-Z&r。"
		""
