	quest.3A0DE5EF9C708D24.title: "The Colossal One"
	quest.3A168607CE99B37C.quest_desc: [
		"&e训练家布伦丹&r想在你拿到沼泽徽章后重赛。去&e平原&r和洞穴里找找。"
		""
