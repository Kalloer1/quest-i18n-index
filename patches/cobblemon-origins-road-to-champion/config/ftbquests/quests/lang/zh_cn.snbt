	quest.2733B89601C95A15.title: "Dex Devotee"
	quest.273EC730541B9A53.quest_desc: ["反复右键点击你的&eGlobe&r，直到它以惊人的速度旋转起来。"]
	quest.273EC730541B9A53.title: "You Spin Me Right Round"
	quest.275EA8D438B8DE54.quest_desc: [
		"凋零、坚守者、远古守卫者和法老都败在了你的手下。"
		""
		"带上这个&e附魔金苹果&r：吃掉一个能让你在下一场大战中获得强大的再生、吸收、抗性和火焰抗性。"
	]
	quest.275EA8D438B8DE54.title: "&c怪物猎人大师</c1>"
	quest.2790ED1A33745FD3.quest_desc: ["用嗅探器发现的另一个东西，&e捕虫囊&r，来种植一株&e猪笼草&r。"]
	quest.2790ED1A33745FD3.title: "投球完美无瑕"
	quest.2798D3A19AC6B7E0.quest_desc: [
