	quest.728EBBB0B3416C7C.title: "幸运蛋"
	quest.7296930D38A2B25A.quest_desc: ["从Lootr的&e物品展示框&r中取走物品。带展示框的战利品结构会被转换，末地船上的鞘翅也是如此：每个人都会得到自己的。"]
	quest.7296930D38A2B25A.title: "被框住了！"
	quest.729F0725DEC219FF.quest_desc: ["&d基格尔德&r极少在深海游泳。带上超球、状态技能和耐心。"]
	quest.729F0725DEC219FF.title: "海洋之主"
	quest.72B90FFF8214DB11.quest_desc: [
