	quest.29942D21BD84B535.quest_subtitle: "1,000 CD"
	quest.29942D21BD84B535.title: "远古巨吨球 (Ancient Gigaton Ball)"
	quest.299DB592F578772C.quest_desc: [
		"&e石匠台&r、&e铁&r和&e红石&r围绕着一个&e升级台&r。"
		""
