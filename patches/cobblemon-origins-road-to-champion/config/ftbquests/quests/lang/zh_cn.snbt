	quest.2129B5F078C5E86E.quest_subtitle: "1,000 冷却时间"
	quest.2129B5F078C5E86E.title: "爱心球"
	quest.214E035F07C9B911.quest_desc: [
		"你可以捕捉、对战、治疗和储存宝可梦：基础操作已完成。"
		""
		"完成图鉴、PC、经验共享、五次野生胜利和一次治愈机器访问后即可解锁。挑选一块进化石作为离别礼物。"
		""
		"&6下一步：&r 超级进化、对战机制、突袭巢穴和传说宝可梦都将从这里开启。"
	]
	quest.214E035F07C9B911.title: "准备好迎接冒险了吗"
	quest.215BE8E819AC5AA3.quest_desc: [
		"&6价格：&r &e15,000 CobbleDollars&r 一个。"
		""
		"将Kubfu进化为单击风格的Urshifu"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.215BE8E819AC5AA3.quest_subtitle: "冷却时间 15,000"
	quest.215BE8E819AC5AA3.title: "黑暗卷轴 (Scroll of Darkness)"
	quest.2164C5A176E22997.quest_desc: [
		"找到或打印一个 &eTM&r。用 &e空白TM&r（两个玻璃和两个紫晶碎片可制作两个）加上技能的配方材料，主要是类型宝石：火焰喷射器需要9个火焰宝石和1个木炭棒。"
		""
		"&c招式机在教授时会消耗掉。&r找到的招式机会出现在沉船补给箱和遗迹的镀金宝箱中。"
	]
	quest.2164C5A176E22997.title: "新鲜出炉的消息"
	quest.21B6AC7AE4AC831F.quest_desc: [
		"在&e蘑菇田&r岛屿上捕捉&e3&r只宝可梦。"
		""
		"稀有的海洋岛屿，有&bSlowpoke&r、&bMiltank&r、&bShroomish&r和&bFoongus&r出没，还有&bVivillon&r穿着群岛图案。"
	]
	quest.21B6AC7AE4AC831F.title: "Fungus Among Us"
	quest.21D9AB4AC95165EC.quest_desc: [
		"将&e末地箱&r与&e下界合金锭&r结合，锻造出一个&e安全箱&r。"
		""
		"保险箱归放置者所有，可用&e钥匙&r上锁。和潜影盒一样，打破时会保留内部物品。"
	]
	quest.21D9AB4AC95165EC.title: "福特诺克斯堡垒"
	quest.21EC1A4A60E2CB74.quest_desc: [
		"&6价格：&r &e2000 CobbleDollars&r 一个。"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.21EC1A4A60E2CB74.quest_subtitle: "2000 冷却时间"
	quest.21EC1A4A60E2CB74.title: "冰之宝石"
	quest.21FADD4E06C7690F.quest_desc: [
		"&e下界石英矿石&r遍布下界岩，掉落经验和&e石英&r。"
		""
		"石英是&e比较器&r、&e侦测器&r、&e日光传感器&r和宁静季节&e季节传感器&r的重要组成部分。"
	]
	quest.21FADD4E06C7690F.title: "闪闪发光的下界岩"
	quest.21FE47FF5C0ABA8F.quest_desc: [
		"&e镀金黑石&r仅在堡垒及其宝箱中才能找到。"
		""
		"猪灵喜欢它，开采它还能掉落&e金粒&r。"
	]
	quest.21FE47FF5C0ABA8F.title: "All That Glitters"
	quest.21FF94FB8B56D0C3.quest_desc: [
		"用末影之眼填满传送门的每个空框架，然后跳进去。"
		""
		"YUNG's Better End Island 重塑了中央岛屿及其塔楼。带上食物、大量方块和一把弓。"
	]
	quest.21FF94FB8B56D0C3.title: "世界的边缘"
	quest.220AE5FF5384536D.quest_desc: [
		"一个&e牧场方块&r（木板、一个&ePC&r、一个&e漏斗&r和小麦）可以让最多16只宝可梦在周围自由活动。"
		""
		"圈养的宝可梦会随时间掉落物品。第&a浆果和果核&r章介绍了它们的产出。"
	]
	quest.220AE5FF5384536D.title: "自由漫游：已启用"
	quest.2211042E41DCDF53.quest_desc: [
		"一个 &e金锭&r 和两个 &e金粒&r 可以制作一把 &e钥匙&r。"
		""
		"钥匙可以锁定&e保险箱&r和&e锁定方块&r：一旦物品与钥匙绑定，只有匹配的钥匙才能打开。"
	]
	quest.2211042E41DCDF53.title: "锁与钥匙"
	quest.22213B19B7ABFAE1.quest_desc: ["打开一个 Lootr &e陷阱箱&r。YUNG 神庙、堡垒和要塞喜欢把战利品藏在里面，所以小心红石。"]
	quest.22213B19B7ABFAE1.title: "里面有惊喜等着你哦"
	quest.224692CBB768E5EB.quest_desc: [
		"合成一个&e超球&r：在&e金锭&r周围放置2个&e黄色&r和2个&e黑色杏果&r。"
		""
		"2倍捕获率：可量产的最佳通用球。黄金核心还能制作黄昏球、爱心球、豪华球、快速球、重复球和计时球；钻石核心能制作梦幻球。"
	]
	quest.224692CBB768E5EB.title: "超完备准备包"
	quest.225BE4782837CE98.quest_desc: [
		"在冰冻洞穴中采摘一朵&e霜百合&r，并将其酿制成&e冰冻药水&r。"
		""
		"霜冻会减速目标并造成持续伤害。"
	]
	quest.225BE4782837CE98.title: "冰冻饮品"
	quest.228BB8A8E3AD1E7D.quest_desc: [
		"&e驯服&r一种动物：狼、猫、鹦鹉或马。"
		""
		"猫喜欢生的&e鳕鱼&r和&e三文鱼&r，所以你今天的渔获也能当猫粮。"
	]
	quest.228BB8A8E3AD1E7D.title: "永远的好朋友 (Best Friends Forever)"
	quest.22AF4206D217E2A2.quest_desc: [
		"&dCalyrex&r 失去了它的坐骑。种植 &eIceroot Carrots&r（种子在雪屋箱中，种植于雪地群系的农田）或 &eShaderoot Carrots&r（种子在 Thalic 箱中，种植于 Thalic 农田）。"
		""
		"在苔原的&b皇冠神殿&r的骏马祭坛献上胡萝卜：Iceroot呼唤&dGlastrier&r，Shaderoot呼唤&dSpectrier&r。带上种子，Arc Phone会追踪神殿。"
	]
	quest.22AF4206D217E2A2.title: "皇家胡萝卜"
	quest.22CE0A34A0527388.quest_desc: [
		"获得一个&eLucky Egg&r：持有者在战斗中能获得更多经验。"
		""
		"无法合成。击败&eChansey&r、&eBlissey&r和&eTogepi&r家族有时能掉落一个。"
	]
	quest.22CE0A34A0527388.title: "额外的经验值（Eggstra Experience）"
	quest.22D8C6702353CA95.quest_desc: ["&eQualot Berry&r + Hearty Grains + Honey. Raises &eDefense&r EVs by 4 per Mochi."]
	quest.22D8C6702353CA95.title: "抵抗麻薯 (Resist Mochi)"
	quest.22E2E964F76AE143.quest_desc: ["&bFirescourge Shrine&r隐藏在Nether Wastes中。用8根匹配的木桩就能释放出&dChi-Yu&r。"]
	quest.22E2E964F76AE143.title: "废墟的余烬"
	quest.230C1B67B2D4C58D.quest_desc: [
		"&e训练家布伦丹&r是联盟前的最后一项考验。他在平原、开阔地带和洞穴中等候着你。"
		""
		"击败Deoxys、Jirachi、Landorus、Galarian Zapdos、Huntail和Sceptile。战胜他，精英四强就会接见你。"
	]
	quest.230C1B67B2D4C58D.quest_subtitle: "训练家 Brendan，最终队伍"
	quest.230C1B67B2D4C58D.title: "你准备好了吗？"
	quest.2314B4745D80CC48.quest_desc: [
		"由 &e8 颗钻石&r 环绕的 &e基础至黄金&r 升级。"
		""
		"将放置的基础箱子或桶直接升级到此等级，内容物保留。"
	]
	quest.2314B4745D80CC48.title: "基础至钻石等级升级指南"
	quest.231FC85C72C656AA.quest_desc: [
		"&6价格：&r &e6,000 CobbleDollars&r 一个。"
		""
		"将假装的Sinistea进化为Polteageist"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.231FC85C72C656AA.quest_subtitle: "6,000 CD"
	quest.231FC85C72C656AA.title: "Cracked Pot"
	quest.23538B82370B1565.quest_desc: [
		"&6价格：&r &e300 CobbleDollars&r 一个。"
		""
		"如果持有者被麻痹，它会自我治愈"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.23538B82370B1565.quest_subtitle: "300 冷却时间"
	quest.23538B82370B1565.title: "Cheri Berry"
	quest.2381558C2B6A57A4.quest_desc: [
		"在 y=16 以下用铁镐挖掘 &e红石原矿&r。 &e治疗机器&r需要红石。"
		""
		"&a宝可梦提示：&r稀有的Rotom喜欢出现在红石装置、红石矿石、电脑和治愈机器附近。"
	]
	quest.2381558C2B6A57A4.title: "红色尘埃"
	quest.2396985200DB7AB2.quest_desc: [
		"在&e铁质背包&r周围放置&e8个金锭&r。"
		""
		"&e81 个物品栏&r和 &e3 个升级槽&r。"
	]
	quest.2396985200DB7AB2.title: "黄金背包"
	quest.239944B1E17A0EFB.quest_desc: [
		"&e精英四强兰斯&r正在&e关都联盟&r等候，该联盟位于&5末地&r的外围岛屿（末地高地和中部）的一座宏伟大厅中。用指南针寻找它吧。"
		""
		"联盟队伍：化石翼龙、鱼龙、熔蚁兽、快龙、帝牙卢卡和烈咬陆鲨。"
		""
		"他也会在山脉和高峰上游荡，有时是和不同的队伍。无论哪个队伍都算数，四天王可以按任意顺序挑战。"
	]
	quest.239944B1E17A0EFB.quest_subtitle: "精英四强兰斯"
	quest.239944B1E17A0EFB.title: "龙之大师"
	quest.23AC25E6680452AA.quest_desc: [
		"&eRaid Dens&r 是会向天空发射光线的发光晶体。光线越亮，等级越高。"
		""
		"它们遍布主世界，也出现在下界和末地。右键单击&e激活的巢穴&r以发起袭击，或请求加入正在进行的袭击。"
		""
		"加入任意一次袭击即可开始。"
	]
	quest.23AC25E6680452AA.quest_subtitle: "加入你的第一次突袭"
	quest.23AC25E6680452AA.title: "&6水晶召唤"
	quest.23C578BCA0335390.quest_desc: [
		"捕捉一只 &bVivillon&r。"
		""
		"翅膀图案取决于生成地点：沙漠的&e沙尘暴&r、冰冻海洋的&e极地&r、蘑菇岛的&e群岛&r、樱花林的&e华丽&r，以及几乎任何地方的&e现代&r。"
	]
	quest.23C578BCA0335390.title: "世界之翼 Wings of the World"
	quest.23C5C33ECF095CB4.quest_desc: [
		"从一个可疑的方块中刷出一个陶器碎片。"
		""
		"沙漠水井、海洋遗迹、小径遗迹、Terralith的沙漠前哨和遗迹都隐藏着可疑的方块。"
	]
	quest.23C5C33ECF095CB4.title: "焕然一新"
	quest.23D0BA1CA404EC1F.quest_desc: [
		"捕捉（或进化）一种可以在陆地上骑乘的宝可梦。"
		""
		"推荐的初始坐骑：&e角龙&r、&e小陨星&r、&e牛头怪&r、&e泥巴怪&r、&e风速犬&r 或 &e圆陆鲨&r。"
	]
	quest.23D0BA1CA404EC1F.title: "可靠的坐骑"
	quest.23F5C282669B2392.quest_desc: [
		"在&e升级基座&r周围放置&e金苹果&r、&e金胡萝卜&r、&e闪亮西瓜片&r和&e末影珍珠&r。"
		""
		"饥饿时会从背包中取食物。再也不用在寻找闪光宝可梦时挨饿了。"
	]
	quest.23F5C282669B2392.title: "喂食升级"
	quest.23FF05101B96A9A2.quest_desc: [
		"收割 &e16 小麦&r。完全成熟的小麦会变成金黄色，并掉落额外的种子。"
		""
		"&a宝可梦联动：&r一个&ePasture Block&r需要两个小麦，牛、羊和山羊都会跟随并繁殖于此。"
	]
	quest.23FF05101B96A9A2.title: "琥珀色的波浪"
	quest.240D367845CD97D6.quest_desc: [
		"将上一个治疗升级方块用&e4个金块&r围起来。"
		""
		"缩短充能时间 &e40%&r：治疗间隔约为 &e90 秒&r。"
	]
	quest.240D367845CD97D6.title: "治疗升级 第2级"
	quest.242205A05DAD6782.quest_desc: [
		"主世界由 &eTerralith&r 群系、&eCTOV&r 村庄、&eYUNG's&r 地牢、神殿和堡垒、&eExplorify&r 结构等重建。"
		""
		"注意四处游荡的&e训练师&r、八个&e关都道馆&r、&e传说纪念碑&r祭坛和&e超级对决&r场地。结构箱里装有Cobblemon物品，而有了&eLootr&r，每位玩家都能获得自己的战利品。"
		""
		"&a探索章节追踪生物群系、结构和宝藏。&r"
	]
	quest.242205A05DAD6782.title: "一个值得探索的世界"
	quest.246A557069F7D0F6.quest_desc: [
		"在宝可梦图鉴中登记 &e100&r 种宝可梦为&e已捕获&r。"
		""
		"一百个物种。该想想剩下的都藏在哪里了。"
	]
	quest.246A557069F7D0F6.title: "物种的世纪"
	quest.24970A9A65A77492.quest_desc: [
		"一个&e玻璃瓶&r和一个野莓，在锅中或酿造台上，可分别治愈一种状态效果："
		"&ePecha&r: 解毒剂。 &eChesto&r: 觉醒。 &eRawst&r: 烧伤治愈。"
		"&eAspear&r: 冰疗。 &eCheri&r: 麻痹治疗。"
	]
	quest.24970A9A65A77492.title: "上门服务"
	quest.24978B60893E76E4.quest_desc: [
		"每只宝可梦都可以携带一个物品。用 &eR&r 把它派出去，然后潜行并右键点击它，打开交互轮盘，选择 &eChange held item&r。"
		""
		"&a战斗中消耗掉的只有浆果、草药和类型宝石；其他持有的物品都会返还。&r"
	]
	quest.24978B60893E76E4.title: "就保持在这个位置不动了，别动！"
	quest.24A1564B7A5D3916.quest_desc: ["在Terralith沙漠前哨中刷出一个&ePrize Pottery Sherd&r，那里还有Archer、Miner和Skull。"]
	quest.24A1564B7A5D3916.title: "奖品碎片"
	quest.24B1C8A577EBA1A3.quest_desc: [
		"&eGalarica Nut&r 灌木在沙地和泥土上野生生长，且仅在秋季结果。"
		""
		"&a宝可梦联动：&r用坚果制作&e加拉尔手环&r和&e加拉尔花环&r，可进化加勒尔呆壳兽。"
	]
	quest.24B1C8A577EBA1A3.title: "加拉里卡采集活动"
	quest.24C29F7157895802.quest_desc: [
		"使用植物学家工作台和水桶制作一个&e洒水壶&r。"
		""
		"使用它可以在任何地方打开植物学家的工作台菜单。"
	]
	quest.24C29F7157895802.title: "浇水壶"
	quest.24D8768FCD86D99A.quest_desc: [
		"铁矿石在y=72以下随处可见，在y=16附近最密集，并形成巨大的矿脉。"
		""
		"将9个粗铁锭合成一个&e粗铁块&r。"
	]
	quest.24D8768FCD86D99A.title: "Iron Haul"
	quest.24E819148DAB3A90.quest_desc: [
		"&ePoké Cake&r 是 Poké Snack 的含糖版：3 个 &eMilk&r、2 个 &eSugar&r、1 个 &eVivichoke&r 和 3 个 &eHearty Grains&r。"
		""
		"可放置的蛋糕：用浆果调味来为它上色。"
	]
	quest.24E819148DAB3A90.title: "让他们吃蛋糕吧"
	quest.24FCF127EDA6A93E.quest_desc: [
		"Cobblemon 为每种进化石添加了矿石。每种矿石只在特定生物群系中生成，从地下深处到山丘都有。"
		""
		"用&e铁镐&r挖掘可获得石头本身（时运附魔可增加产量）。使用丝绸之触可获得矿石方块，熔炼后即可得到石头。"
		""
		"查看每种矿石的&e普通石头变种&r以完成其任务：深板岩、滴水石和陶瓦版本不计入。进化章节会介绍每种石头的用途。"
	]
	quest.24FCF127EDA6A93E.title: "进化石矿石 (Evolution Stone Ores)"
	quest.252357DB6D466512.quest_desc: [
		"&6价格：&r &e100 CobbleDollars&r 一个。"
		""
		"使宝可梦的经验值增加100点经验值"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.252357DB6D466512.quest_subtitle: "100秒冷却"
	quest.252357DB6D466512.title: "经验糖果（小）"
	quest.2539EBA6BCDEF7FE.quest_desc: [
		"速度之王：角落放&e4个下界合金锭&r，顶部和边缘放&e3个岩浆膏&r，底部中间放&e灵魂沙&r或&e灵魂土&r，中心放你的&e黑曜石熔炉&r。"
		""
		"烹饪时间：每件物品&e5个游戏刻&r。本整合包中没有任何物品熔炼得更快。"
	]
	quest.2539EBA6BCDEF7FE.title: "下界合金熔炉"
	quest.254FA3519FEEA12E.quest_desc: [
		"完成&a训练家生活&r：浆果与杏果、烹饪与制药、钓鱼、化石与地质、圆石美元与扭蛋机，以及神奇宝贝方块与装饰。"
		""
		"农夫、厨师、垂钓者、化石猎人和收藏家：驯兽师的生活不止是战斗。"
		""
		"&a所列章节的每个最终章完成后解锁；然后勾选复选框。&r"
	]
	quest.254FA3519FEEA12E.title: "游侠的一生"
	quest.256028AFD741AE51.quest_desc: [
		"将紫颂果熔炼成&e烤紫颂果&r。"
		""
		"这是 &e紫晶&r块和 &e末地柱&r 的基础。"
	]
	quest.256028AFD741AE51.title: "虚空爆米花"
	quest.2571CA0E265BB7F7.quest_desc: [
		"用普通毛线在 Plush-O-Matic 中赢得一个 &e伊布宝可梦玩偶&r（普通款）。"
		""
		"概率：大约每13次抽取1次，每次抽取消耗毛线，所以先储备好类型宝石。"
	]
	quest.2571CA0E265BB7F7.title: "毛绒伊布"
	quest.2576324432A57B62.quest_desc: [
		"&6价格：&r &e150 CobbleDollars&r 一个。"
		""
		"&a点击对勾即可购买。可重复购买，仅在您负担得起时收费。&r"
	]
	quest.2576324432A57B62.quest_subtitle: "150 冷却时间"
	quest.2576324432A57B62.title: "黄色玉米芯"
	quest.2583307B67911321.quest_desc: ["吹响新月哨声，&d达克莱伊&r便会回应。它只会回应一次，准备好战斗吧。"]
	quest.2583307B67911321.title: "漆黑一片"
	quest.258ECAF42D10C5C0.quest_desc: [
		"四个爆裂的紫颂果可以合成四个&e紫颂岩块&r，末地城市就是用它们建造的。"
		""
		"紫晶也提供柱、楼梯和半砖的形式。"
	]
	quest.258ECAF42D10C5C0.title: "紫色宫殿"
	quest.259326A5F933988A.quest_desc: [
		"一个烈焰棒可以研磨成两个&e烈焰粉&r。"
		""
		"它能酿造酿造台所需的物品，如&e末影之眼&r、岩浆膏和火焰弹。Cobblemon 用它制作&e专注带&r、&e专家腰带&r、&e火焰球&r和&e富饶堆肥&r。"
	]
	quest.259326A5F933988A.title: "下界之香料"
	quest.25A9005B2C8A8524.quest_desc: [
		"&6价格：&r &e400 CobbleDollars&r 一个。"
		""
		"1× 捕获率"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.25A9005B2C8A8524.quest_subtitle: "400 CD"
	quest.25A9005B2C8A8524.title: "古代宝可梦球"
	quest.25C8C2F2C3981750.quest_desc: ["搜刮一个 Lootr &edecorated pot&r。村庄和遗迹的罐子可以为每个玩家存放一份奖品。"]
	quest.25C8C2F2C3981750.title: "碰运气"
	quest.25F88A56CB89D747.quest_desc: [
		"找到一个 Explorify &ebadlands pyramid&r。"
		""
		"&c其中一些箱子里有陷阱。&r"
	]
	quest.25F88A56CB89D747.title: "红色岩石金字塔"
	quest.25FBF87750E003B7.quest_desc: [
		"&6价格：&r &e4,000 CobbleDollars&r 一个。"
		""
		"&a点击对勾购买。可重复购买：只有在你负担得起时才会收费。&r"
	]
	quest.25FBF87750E003B7.quest_subtitle: "4,000 CD"
	quest.25FBF87750E003B7.title: "行动迟缓的尾巴"
	quest.2617A439090602B1.quest_desc: [
		"你征服了堡垒、据点和熔岩海，并身穿下界合金以证明这一切。"
		""
		"下一步：烈焰粉和末影珍珠可以制作末影之眼。 &e末地&r 正在等待。"
	]
	quest.2617A439090602B1.title: "&c下界之主</c1>"
	quest.261D2E9483E90EA4.quest_desc: [
		"写一封&e情书&r：纸加三种精华。"
		"&e爱的精髓&r：有时在繁殖动物时。 &e友谊的精髓&r：宝可梦的友好度提升时。 &e利他的精髓&r：治愈僵尸村民时。"
	]
	quest.261D2E9483E90EA4.title: "签署、密封、交付完毕"
	quest.2621EC3831690B36.quest_desc: [
		"能提升属性的 Pinch 浆果位于突变树的深处：&eLiechi&r (Kelpsy + Pamtre)、&eGanlon&r (Qualot + Watmel)、&eSalac&r (Spelon + Tamato)、&ePetaya&r (Durin + Hondew)、&eApicot&r (Belue + Grepa)。"
		""
		"连锁反应始于你的风味融合浆果：Wiki + Bluk 得到 Cornn，接着 Cornn + Rindo 得到 Kelpsy。"
		""
		"持有者生命值降至四分之一时，各项属性提升一个阶段。"
	]
	quest.2621EC3831690B36.title: "代打者（ピンチヒッター）たち"
	quest.262B006CF523F9D8.quest_desc: [
		"红石矿石位于y=16以下，越往世界底部越常见。"
		""
		"&a宝可梦提示：&r Klink 会聚集在黑暗洞穴的红石原矿周围。"
	]
	quest.262B006CF523F9D8.title: "深红色"
	quest.263DF7F72D2039F5.quest_desc: [
		"战斗中收集：在巨龙喷吐的紫色云团中手持&e玻璃瓶&r，即可收集&e龙之息&r。"
		""
		"它将药水变为滞留药水，并在酿造台中将&eMedicinal Brew&r酿造为宝可梦可用的&eAbility Capsule&r。"
	]
	quest.263DF7F72D2039F5.title: "瓶装怒火"
	quest.265AEEE7E0DCB554.quest_desc: [
		"&e溺尸&r潜伏在海洋和河流中。有些会携带三叉戟，只有它们才会掉落三叉戟。"
		""
		"击杀10个。击杀它们时，它们也可能掉落&e铜锭&r。"
	]
	quest.265AEEE7E0DCB554.title: "水里的什么东西出了问题"
	quest.26B559F947ABB44D.quest_desc: [
		"铁锭、&e铁栏杆&r和木板。一个&e笼子&r可以像罐子一样捕捉动物，但体型更大：兔子、鸡、狐狸、鹦鹉等等。可驯服的动物必须先被驯服。"
		""
		"&a注意：&r笼子适用于普通动物。你的宝可梦应该装在精灵球里。"
	]
	quest.26B559F947ABB44D.title: "动物运输机"
	quest.26D8BB257BC50AF7.quest_desc: [
		"&6价格：&r &e150 CobbleDollars&r 一个。"
		""
		"&a点击对勾即可购买。可重复购买，仅在您负担得起时收费。&r"
	]
	quest.26D8BB257BC50AF7.quest_subtitle: "150 冷却时间"
	quest.26D8BB257BC50AF7.title: "粉色角核果"
	quest.26FF0C4DD894E24E.quest_desc: ["用5个阿普里克恩木板制作一个&e阿普里克恩船&r。"]
	quest.26FF0C4DD894E24E.title: "扬起风帆启航"
	quest.270372F132CFA0EF.quest_desc: [
		"&6价格：&r &e4,000 CobbleDollars&r，共10个。"
		""
