	quest.0AE918340484212A.quest_desc: [
		"在战斗中击败25只野生&6地面&r属性的宝可梦。"
		""
		"&6弱点：&r 草、冰、水"
		"&c抗性：&r 中毒、岩石"
		"&c免疫于：&r 闪电"
	]
	quest.0AE918340484212A.title: "地面控制中心"
	quest.0AEEE5DB6E0A8353.quest_desc: [
		"在沼泽群系中捕捉 &e5&r 只宝可梦（Terralith 变种也算）。"
		""
		"&b莲叶龙&r、&b卡璞鸣鸣&r、&b黏美龙&r、&b卡璞鸣鸣&r和&b乌鸦&r潜伏在浑浊的水中。"
	]
	quest.0AEEE5DB6E0A8353.title: "沼泽生物"
	quest.0AFED46B5DB72507.quest_desc: [
		"野外战斗能让你的队伍成长。本章涵盖&e等级&r、&e努力值&r、&e个体值&r、&e性格&r、&e携带物&r、&e技术机器&r和&e特性&r。"
		""
		"&6经验值运作方式&r"
		"&e经验值全关&r：只有战斗或使用&e经验分享&r（半个）的宝可梦才能获得经验。晕厥的宝可梦无法获得经验，请在它们倒下前换下。"
		""
		"&a战斗中捕捉宝可梦还能让你的对战者获得经验和努力值。&r"
	]
	quest.0AFED46B5DB72507.quest_subtitle: "战斗是宝可梦成长的舞台"
	quest.0AFED46B5DB72507.title: "&6&l努力训练，更猛战斗"
	quest.0B1971DED69EDA5D.quest_desc: ["用破损工作台或其工具将橡木木板制成&e篮编橡木木板&r，然后放置并欣赏它。"]
	quest.0B1971DED69EDA5D.title: "用橡木木板编织的篮子"
	quest.0B1E5E8301151E54.quest_desc: ["红色山杏底座：&e+2 加速，-1 耐力&r。"]
	quest.0B1E5E8301151E54.title: "红色阿普里果汁"
	quest.0B25902B2CC2ACEA.quest_desc: [
		"&e捕虫护身符&r有时会作为额外战利品出现在突袭袋中。"
		""
		"驯服首领怪时，将物品放在&e副手&r可提高捕获率。 &a看向玉时，会显示巢穴的捕获率。&r"
	]
	quest.0B25902B2CC2ACEA.title: "幸运护身符"
	quest.0B2DCBC7BE0F8A1F.quest_desc: [
		"用三块玻璃、两块石英、一个日历和三个原石台阶可以建造一个&e季节传感器&r。"
		""
		"它会发出随季节变化的红石信号，准备好驱动你的农场机械了。"
	]
	quest.0B2DCBC7BE0F8A1F.title: "季节传感器"
	quest.0B2F009335775CC1.quest_desc: [
