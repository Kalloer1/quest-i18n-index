	quest.2978DBCC2E268275.title: "黎明之石"
	quest.298665F54F62A2EB.quest_desc: [
		"酿造一瓶&7虚弱药水&r：一个水瓶加一个发酵蜘蛛眼。不需要地狱疣。"
