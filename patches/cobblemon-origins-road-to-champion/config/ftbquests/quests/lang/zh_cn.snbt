	quest.75E5D0DBC53EC592.title: "瓶装闪电"
	quest.75E6A318D7D3A827.quest_desc: ["用你的&e扳手&r敲击任意方块即可获得成就。"]
	quest.75E6A318D7D3A827.title: "工程师游戏工作室"
	quest.75F87A00387CB7AB.quest_desc: [
		"用叶之石进化Gloom、Weepinbell、Exeggcute、Nuzleaf或Pansage，或用日之石进化Gloom、Sunkern、Cottonee或Petilil。Gloom两种都可以！"
		""
		"拿着石头，然后对宝可梦使用它。"
	]
	quest.75F87A00387CB7AB.title: "繁花盛开之时"
	quest.760B9F44EE40D474.quest_desc: [
