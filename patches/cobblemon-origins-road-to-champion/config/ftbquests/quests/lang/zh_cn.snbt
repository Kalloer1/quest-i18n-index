	]
	quest.394B3E1CB7AEB29A.title: "卡洛斯田野笔记"
	quest.39564FB3754AE384.quest_desc: [
		"&6价格：&r &e6,000 CobbleDollars&r 一个。"
		""
		"将Charcadet进化为Armarouge"
