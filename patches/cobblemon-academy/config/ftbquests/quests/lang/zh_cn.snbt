	quest.4F3439AB86E4ECA3.title: "研磨工具"
	quest.4F845B4F916E5226.quest_desc: [
		"&6卷尺&r可以测量两个方块之间的距离。"
		""
		"右键点击一个方块以将其设为第一个位置，然后右键点击另一个方块以将其设为第二个位置。卷尺会在其工具提示中读出两者之间的距离。Shift+右键点击将重置你的位置。"
	]
	quest.500649FD8291AB06.quest_desc: [
