	quest.4D2E63379A1F472B.quest_desc: ["&6抓钩&r是一件功能强大且趣味十足的工具，可以钩住最远 100 格之外的物体！"]
	quest.4D584D835CC0F55F.quest_desc: [
		"&6极巨化手环&r能让一只 Cobblemon 在战斗中极巨化，但前提是它必须位于能量点附近。"
		""
		"&8&o由于此物品效果强大，学院已将其合成配方移除，并规定只能从商店购买。"
	]
	quest.4DE83D38D9C4D9BB.quest_desc: [
