	]
	quest.40C5C355B6DA1893.quest_desc: ["口袋发电机是一款手持式发电机，它使用可燃烧物品为玩家的物品栏中的物品和工具充能。口袋发电机与燃料罐兼容。"]
	quest.41E8C93A44559E48.quest_desc: ["&7悖论机器&r可以花费大量的能量和&a时间流体&r，对指定区域内的方块（主要是矿石）和实体进行快照采集，然后将其复制。\n\n执行此操作会在&7悖论机器&r中积累&5悖论能量&r，一旦能量充满，就会引发一次&5悖论&r。它会吞噬附近的方块、物品和实体，并不断壮大。将一个&a时间水晶&r投入&5悖论&r中即可将其关闭。\n\n许多方块和实体已被配置文件列入黑名单，因此无法复制蜜蜂！"]
	quest.433117EEA55B6A54.quest_desc: ["只是一个简单的流体放置器。"]
	quest.441F37A95AB66E6B.quest_desc: ["本任务由&6AllTheMods 工作人员&r或&2社区贡献者&r编写，供 AllTheMods 整合包使用。\n\n由于所有&6AllTheMods&r整合包均采用&e保留所有权利&r许可协议，未经&6AllTheMods 团队&r明确许可，本任务不得用于任何非其发布的公开整合包。\n\n本任务被刻意隐藏，如果你能看到此内容，说明你正处于编辑模式。"]
	quest.4458F8829800A950.quest_desc: ["多态流体是 JDT 中所有流体/燃料的基础。将多态催化剂投入水中即可合成多态流体。"]
	quest.446A37C7FCDACF84.quest_desc: ["虚空烈焰煤是 JDT 添加的一种新材料。虚空烈焰煤可通过使用三级或更高级的凝胶对烈焰余烬方块进行凝胶涂抹来获得。虚空烈焰煤矿石会受到时运效果的影响。"]
	quest.454662617304E299.quest_desc: [
		"&l能力类型：&r 被动"
		""
		"&l能力功能：&r"
		""
		"当附魔于护腿时，允许玩家穿过方块。有一个方块标签可用于将某些方块加入黑名单，使其无法被穿模。"
		"当附魔于弓时，允许箭矢穿墙而过。"
	]
	quest.454CA1F8CC198D9D.quest_desc: [
		"可用升级："
		"- 踏步辅助"
		"- 跳跃提升"
	]
	quest.45A25221F54A1DEC.quest_desc: ["铁芯扳手允许玩家旋转机器，但它也用于连接交换器。"]
	quest.45D683D7F1A32B04.quest_desc: [
		"&l能力类型：&r 被动"
		""
		"&l能力功能：&r"
		""
		"允许该工具即时挖掘方块。"
	]
	quest.46E6B1600AA8A61E.quest_desc: [
		"可用升级："
		"- 生物扫描仪"
		"- 自动熏烤器"
		"- 灼烧伤口"
		""
		"固有能力："
		"- 熔岩修复"
	]
	quest.46EE2F9818F8D1D9.quest_desc: [
		"&l能力类型：&r 被动"
		""
		"&l能力功能：&r"
		""
		"自动清除被挖掘方块正上方任何受重力影响的方块。"
	]
	quest.4773421DC70009AB.quest_desc: [
		"固有能力："
		"- 无踩踏"
		"- 作物加速生长 I"
	]
	quest.48E4D75FD3145AD6.quest_desc: ["时间流体被悖论机器和时间魔杖使用。它通过将时间水晶投入多形流体中获得。\n\n对于一块这么难获得的水晶，我很高兴他们终于给了我们一种简单的流体。"]
	quest.49636B3C6E6D0C2A.quest_desc: ["没有任何用途，不过看起来很酷。"]
	quest.4987759CF379C1EB.quest_desc: [
		"&l能力类型:&r 被动"
		""
		"&l能力功能:&r"
		""
		"当你的物品栏中有时间水晶时，可防止自身获得缓慢和加速效果。"
	]
	quest.49EF8A4346AEF582.quest_desc: ["将日蚀余烬投入虚空烈焰燃料中，可生成未精炼的日蚀余烬燃料。使用四阶胶进行胶涂操作，可将未精炼的日蚀余烬燃料转化为日蚀余烬燃料。"]
	quest.4A5937F6E5D06BE1.quest_desc: ["一个简单的液体燃料发电机，可由 JDT 添加的液体燃料驱动。"]
	quest.4ACB72F3A23A5A19.quest_desc: [
		"&l能力类型:&r 被动"
		""
		"&l能力功能:&r"
		""
		"提高游泳速度。"
	]
	quest.4B1E4FC4599DB916.quest_desc: [
		"可用升级："
		"- 无敌"
		"- 灭火"
		"- 鞘翅"
	]
	quest.4B3F20E5C7E3BCFB.quest_desc: ["原始煤炭是 JDT 添加的一种新材料。原始煤炭可通过使用一级或更高级的胶对煤炭块进行胶涂操作获得。原始煤炭矿会受到时运效果的影响。"]
	quest.4C54BD57CAB8A54B.quest_desc: [
		"烈焰花胶是 JDT 添加的第二阶胶，需要下界材料才能合成。"
		""
		"已解锁的合成配方："
		"- 烈焰金"
		"- 烈焰余烬"
	]
	quest.4D98D2123BD5BFB3.quest_desc: [
		"&l能力类型:&r 被动"
		""
		"&l能力功能:&r"
		""
		"一次性挖掘相邻的所有原木，但请注意，挖掘多个原木时会增加挖掘所需的时间。"
	]
	quest.4E03AE15BEF86178.quest_desc: [
		"可用升级："
		"- 生物扫描仪"
		"- 自动烟熏炉"
		"- 烧灼伤口"
		"- 掉落传送器"
	]
	quest.4E9B35DCA018FD42.title: "工具升级"
	quest.4F9932477EDDCB8E.quest_desc: ["高级传送门枪是传送门枪的升级版，需要同时使用电源和传送门流体才能运行。与传送门枪不同，高级传送门枪允许玩家在已编码的位置之间传送。使用“V”（默认按键绑定）可打开用于编码和选择传送目的地的菜单。"]
	quest.5054977BD5354561.quest_desc: [
		"可用升级："
		"- 伐木者"
		"- 碎叶者"
	]
	quest.515C0527226BA50C.quest_desc: [
		"&l能力类型：&r 被动"
		""
		"&l能力功能：&r"
		""
		"赋予玩家创造模式飞行能力。"
	]
	quest.517F0135926B15EE.quest_desc: ["所有简单机器都带有红石控制功能，部分还带有过滤功能。"]
	quest.52EC86E03EB50525.quest_desc: [
		"固有能力："
		"- 熔岩修复"
		"- 无踩踏"
		"- 自动收获"
		"- 作物加速生长 II"
	]
	quest.53F9E5CE7EE6F852.quest_desc: ["生物捕捉器可用于运输生物。可通过实体标签将生物加入黑名单。"]
	quest.567005978482235F.quest_desc: [
		"可用升级："
		"- 药水箭"
		"- 溅射"
		""
		"固有能力："
		"- 熔岩修复"
	]
	quest.5961C1ED32522BEF.quest_desc: [
		"&l能力类型：&r 主动"
		""
		"&l能力功能：&r "
		""
		"生成一个玩家的诱饵，吸引仇恨远离玩家，有冷却时间。"
	]
	quest.5A1AB1AD7DEFDD9A.quest_desc: [
		"可用升级："
		"- 无敌"
		"- 灭火"
		"- 鞘翅"
		"- 死亡保护"
		"- 飞行"
		"- 熔岩免疫"
		"- 时间保护"
	]
	quest.5A38E9F68570F7F3.quest_desc: [
		"可用升级："
		"- 奔跑速度"
		"- 行走速度"
		"- 游泳速度"
		""
		"内在能力："
		"- 熔岩能力"
	]
	quest.5A9436B100FC1E67.quest_desc: [
		"有效升级："
		"- 药水箭"
	]
	quest.5B02719C13B1FFE2.quest_desc: [
		"能力："
		"- 气爆：进一步提升了发射距离。"
		"- 虚空转移：提升了传送距离。"
		"- 日蚀之门：在 3x3 区域内创建一个可移动的传送门，方向取决于目标方块的朝向。所创建传送门的距离可配置。注意，日蚀之门无法作用于方块实体。"
	]
	quest.5B910F1389C0B915.quest_desc: [
		"能力："
		"- 气爆：提升了发射距离并消耗 FE。"
		"- 虚空转移：将玩家传送到其面朝的方向，此过程会消耗 FE。"
	]
	quest.5BBE8B30ED7518B8.quest_desc: [
		"有效升级："
		"- 矿石矿工"
		"- 矿石扫描仪 &4&l已禁用&r&f"
	]
	quest.5BD5737703F3F077.quest_desc: ["铁核是 JDT 添加的一种新材料。铁核可通过使用一级或更高级的粘液对铁块进行粘液涂抹来获得。铁核矿石受时运效果影响。"]
	quest.5BD5737703F3F077.title: "铁核"
	quest.5C6709350BEF4050.quest_desc: [
		"虚空微光粘液是 JDT 添加的第三级粘液，需要末地材料才能合成。"
		""
		"已解锁的合成配方："
		"- 天体宝石"
		"- 虚空火焰"
	]
	quest.5D4E51471F3939E0.quest_desc: [
		"能力："
		"- 气爆：将玩家朝其面朝的方向发射，此过程会消耗耐久度，更高级的法杖能将玩家发射得更远。注意，只要玩家手持法杖，就不会受到坠落伤害。"
	]
	quest.5EE7D5DE07A83C7D.quest_desc: ["&l能力类型:&r 主动\n\n&l能力功能:&r\n\n激活后，会用绿色粒子高亮附近的矿石。\n\n&4&l注意：此能力已被禁用。&r&f"]
	quest.5F5120451BA5B2FE.quest_desc: ["高级机器与简易版本拥有相同的功能，但增加了可配置的工作区域、更多的过滤槽，并且需要消耗能量。"]
	quest.60A4994078500F63.quest_desc: ["Celestigem 是 JDT 添加的一种新材料。使用三级或更高级的 Goo 对钻石块执行 Goo Spread 即可获得 Celestigem。Celestigem 矿石会受到时运效果的影响。"]
	quest.61213012615619C5.quest_desc: [
		"&l能力类型:&r 被动"
		""
		"&l能力功能:&r"
		""
		"自动将击杀掉落的物品熏制。"
	]
	quest.636854555AD75DC3.quest_desc: [
		"&l能力类型:&r 被动"
		""
		"&l能力功能:&r"
		""
		"自动将物品掉落物传送到与该工具绑定的物品栏中。按住 Shift 键并右键点击工具即可将其绑定到某个物品栏。注意：当使用 JDT 锄头时，由虚空闪烁/暗影脉冲农田的自动收获能力所掉落的物品也会被传送到绑定的物品栏中。此外，如果工具的绑定物品栏已更改，右键点击虚空闪烁/暗影脉冲农田可以重新绑定。"
	]
	quest.6690AEE064DC2A7C.quest_desc: [
		"&l能力类型:&r 被动"
		""
		"&l能力功能:"
		""
		"增加一次性挖掘的面积。安装在更高等级的工具上时，最大挖掘面积会增加。可在菜单中配置挖掘面积。"
	]
	quest.6720F863B907A5F1.quest_desc: [
		"&l能力类型:&r 被动"
		""
		"&l能力功能:&r"
		""
		"使弓箭射出的药水箭具有滞留效果，随时间对一片区域施加效果。"
	]
	quest.6737CB17D562B134.quest_desc: ["一个简单的点击器，会用交给它的物品进行点击。"]
	quest.67B87570C340C243.title: "护甲升级"
	quest.6889EFC6CC291463.quest_desc: [
		"&l能力类型:&r 主动"
		""
		"&l能力功能:&r"
		""
		"激活时击退附近的生物，有冷却时间。"
	]
	quest.6A4D31194C4CE156.quest_desc: [
		"有效升级："
		"- 矿石挖掘器"
		"- 割草机"
		"- 天空清扫者"
		"- 伐木机"
		"- 树叶破碎器"
		"- 自动熔炼炉"
		"- 锤子"
		"- 掉落传送器"
		"- X光透视"
		"- 即时破坏"
	]
	quest.6ADE6F9E004055F7.quest_desc: [
		"时间晶体是 JDT 添加的一种新材料。它们生长在萌芽时间晶体块上，而萌芽时间晶体块则是通过在萌芽紫水晶或时间晶体块上使用粘液来制作的。\n\n但是，萌芽时间晶体块必须从 &9主世界&r、&6下界&r和 &a末地&r收集时间，才能生长出时间晶体簇。你绝对不可以破坏或使用精准采集来采集萌芽时间晶体块。你必须使用交换器、纸箱或剪切粘贴工具来移动它们。\n\n一段时间后，萌芽时间晶体块会 &2耗尽能量&r，必须再次前往 &9主世界&r、&6下界&r和 &a末地&r。"
		"{@pagebreak}"
		"如果上一页的 &2颜&9色&6编&a码&r还不够，我还添加了一张图片，帮助你分辨哪个是哪个阶段的萌芽时间晶体块。"
		""
		"{image:atm:textures/questpics/justdirethings/budding_time_crystal_reference.png width:250 height:125 align:center}"
	]
	quest.6ADE6F9E004055F7.quest_subtitle: "时间悖论"
	quest.6ADE6F9E004055F7.title: "时间晶体"
	quest.6D9CFCD81A23BB3B.quest_desc: [
		"&l能力类型：&r 被动"
		""
		"&l能力功能：&r"
		""
		"使玩家免疫于岩浆。"
	]
	quest.6F709652A2B88C78.quest_desc: ["能量发射器可为其工作范围内的方块提供能量，但它只能从底部接收能量。"]
	quest.6FD4C60B547F4131.quest_desc: [
		"有效升级："
		"- 矿石矿工"
		"- 矿石扫描仪 &4&l已禁用&r&f"
		"- 自动熔炼炉"
		"- 锤子"
		"- 传送装置（掉落）"
	]
	quest.703BDCDC88DD813C.quest_desc: [
		"有效升级："
		"- 割草机"
		"- 天空清扫机"
		"- 自动熔炼炉"
		"- 锤子"
		"- 传送装置（掉落）"
		"- 即时破坏"
	]
	quest.70AD088336748892.quest_desc: ["只是一个简单的煤炭发电机。"]
	quest.70BF85E2D235BAD5.quest_desc: ["将虚空烈焰煤炭投入烈焰余烬燃料中，会生成未精炼的虚空烈焰燃料。使用三阶或更高级的粘液进行涂抹，会将未精炼的虚空烈焰燃料转化为虚空烈焰燃料。"]
	quest.70C404E5685E4E91.quest_desc: ["只是一个简单的方块放置器。"]
	quest.71128E508D810DDF.quest_desc: [
		"有效升级："
		"- 药水箭"
		"- 溅射"
		"- 滞留"
		"- 追踪箭"
		"- 相位"
		"- 永杜箭"
	]
	quest.71441DFA05FD73E5.quest_desc: [
		"有效升级："
		"- 心灵迷雾"
		"- 昏迷"
		"- 夜视"
	]
	quest.7305EE0F7D73C231.quest_desc: ["空白升级是所有能力的基础。能力分为两种类型：被动和主动。\n\n被动能力无需玩家主动操作即可生效，而主动能力只有在玩家通过配置菜单设置的按键触发时才能生效，并且主动能力在使用时会消耗耐久度/能量。当安装在更高级的盔甲上时，主动能力的冷却时间会缩短，被动能力的效果会增强。\n\n锻造台用于将升级应用到 JDT 工具和盔甲上。将鼠标悬停在 JDT 工具或盔甲上时按住 Shift 键，可以查看哪些升级是有效的。"]
	quest.73552A4BA0687962.quest_desc: ["这些升级可以应用于工具或盔甲。"]
	quest.7464CA1290B3474B.quest_desc: [
		"有效升级："
		"- 无敌"
	]
	quest.76B1C5AFC5D6B7CF.quest_desc: ["时间法杖可用于加速方块，效果类似于瓶中时光，最高可达 x128 倍速。与瓶中时光不同，它使用 FE 和时间流体而非存储的时间作为燃料，因此补充起来要容易得多。\n\n不过，它已被列入假玩家黑名单。我们可不想让你用这个来搞自动化。"]
	quest.76B1C5AFC5D6B7CF.quest_subtitle: "瓶中时光的表亲"
	quest.78840993C7832E89.quest_desc: [
		"可用升级："
		"- 伐木者"
		"- 碎叶者"
		"- 自动熔炼炉"
		"- 掉落物传送器"
		"- 即时破坏"
	]
	quest.79BBCC1BEE90DBBB.quest_desc: [
		"&l能力类型：&r 被动"
		""
		"&l能力功能：&r"
		""
		"允许玩家规避死亡，但冷却时间非常长。因此，它相当于一个冷却时间不会被消耗的不死图腾。"
	]
	quest.7AEFF81E7C8CF300.quest_desc: ["手持 JDT 工具或法杖时，按住 Shift 并右键点击将打开配置菜单，玩家可以在其中配置和切换能力。"]
	quest.7B9486981786AC47.quest_desc: [
		"&l能力类型：&r 主动"
		""
		"&l能力功能：&r"
		""
		"永久移除附近小怪的 AI。由于能量消耗较高，每次激活最多只能影响五个小怪，且冷却时间非常长。"
	]
	quest.7D1D2A4E07E98709.quest_desc: ["一种简单的方块破坏器，需要工具才能破坏方块。"]
	quest.7F0B2D58361FB00E.quest_desc: ["《Just Dire Things》是一款功能多样的模组。它新增了一种名为“粘液涂抹”的合成机制，并加入了辅助实现“粘液涂抹”自动化及其他用途的机器。"]
	quest.7F0B2D58361FB00E.title: "Just Dire Things"
	task.00B0A3B14DEB34B9.title: "混合升级"
	task.03982D782B426ABB.title: "AllRightsReserved"
	task.19931057AAC1A03A.title: "AllRightsReserved"
