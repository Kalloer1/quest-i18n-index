# AI 初翻，未人工校对
{
	quest.0591F84BFDE50BC2.quest_desc: ["本任务由 &6AllTheMods 工作人员&r 或 &2社区贡献者&r 编写，用于 AllTheMods 整合包。\n\n由于所有 &6AllTheMods&r 整合包均遵循 &e保留所有权利&r 许可协议，未经 &6AllTheMods 团队&r 明确许可，本任务不得用于任何非其发布的公开整合包。\n\n本任务被刻意隐藏，如果你能看到此内容，说明你正处于编辑模式。"]
	quest.1E6F000000001199.quest_desc: ["&5究极虫洞&r 会在 &8异次元&r 毫无征兆地撕裂开来，它们是通往究极异兽故乡——外星维度的传送门。\n\n大约每小时会形成一个虫洞，一只究极异兽会作为强化版的高等级头目从中现身。先将其血量耗尽，然后在裂隙关闭前捕捉它。这里没有祭坛，也没有召唤道具——你只需在天空裂开时赶到现场即可。使用 &d异兽球&r 能给你带来最佳捕捉机会。"]
	quest.1E6F000000001199.title: "&5究极虫洞"
	quest.1E6F00000000119C.quest_desc: ["&f虚无奈戈&r 是一种如水母般漂游的究极异兽，据推测它是一种寄生生物，会附着在宿主身上，并用毒液扭曲其心智。\n\n留意它在异次元的究极虫洞附近出现，并在它现身时将其击败。"]
	quest.1E6F00000000119C.quest_subtitle: "阿罗拉"
	quest.1E6F00000000119C.title: "虚无奈戈"
	quest.1E6F0000000011A0.quest_desc: ["&cBuzzwole&r是肿胀宝可梦，一种拥有夸张肌肉的究极异兽，它会摆出突然震裂地面的姿势，炫耀自己隆起的身体。\n\n在它强行突破究极虫洞时捕捉它吧。"]
	quest.1E6F0000000011A0.quest_subtitle: "阿罗拉"
	quest.1E6F0000000011A0.title: "Buzzwole"
	quest.1E6F0000000011A4.quest_desc: ["&fPheromosa&r是纤巧宝可梦，一种拥有惊人速度与优雅身姿的究极异兽，绝不允许任何污物沾染自身。\n\n在它溜走前，于究极虫洞处将其追上。"]
	quest.1E6F0000000011A4.quest_subtitle: "阿罗拉"
	quest.1E6F0000000011A4.title: "Pheromosa"
	quest.1E6F0000000011A8.quest_desc: ["&eXurkitree&r是发光宝可梦，一种宛如活体电缆乱团的究极异兽，会抽干整个电网来为自身的电气身体供能。\n\n在它从究极虫洞中涌出时捕捉它吧。"]
	quest.1E6F0000000011A8.quest_subtitle: "阿罗拉"
	quest.1E6F0000000011A8.title: "Xurkitree"
	quest.1E6F0000000011AC.quest_desc: ["&aCelesteela&r是发射宝可梦，一种外形如火箭般的巨型究极异兽，据说在起飞时会烧焦周围的森林。\n\n在“另一侧”的究极虫洞处将它击落。"]
	quest.1E6F0000000011AC.quest_subtitle: "阿罗拉"
	quest.1E6F0000000011AC.title: "Celesteela"
	quest.1E6F0000000011B0.quest_desc: ["&2Kartana&r是拔刀宝可梦，一种如折纸般折叠而成的究极异兽，其锋利程度足以一刀斩断钢铁高塔。\n\n在它切开究极虫洞突围而出时捕捉它吧。"]
	quest.1E6F0000000011B0.quest_subtitle: "阿罗拉"
	quest.1E6F0000000011B0.title: "Kartana"
	quest.1E6F0000000011B4.quest_desc: ["&8古兹玛&r是“垃圾吞噬”宝可梦，一种吞噬万物的巨型究极异兽——无论是建筑、山脉还是海洋，它都能吞下肚，而且似乎永远也吃不饱。\n\n在究极之洞前直面这只饕餮之兽并将其捕获吧。"]
	quest.1E6F0000000011B4.quest_subtitle: "阿罗拉"
	quest.1E6F0000000011B4.title: "古兹玛"
	quest.1E6F0000000011B8.quest_desc: ["&7垒磊星&r是“壁垒”宝可梦，一种看起来像由无数生物层层堆叠而成的巨型城墙，一旦动起来便势不可挡。\n\n在究极之洞前将其击倒，并把它加入你的队伍吧。"]
	quest.1E6F0000000011B8.quest_subtitle: "阿罗拉"
	quest.1E6F0000000011B8.title: "垒磊星"
	quest.1E6F0000000011BC.quest_desc: ["&d爆焰龟兽&r是“烟花”宝可梦，一种先用绚丽夺目的表演吸引人们靠近，再引爆自己的头颅将人炸飞的究极异兽。\n\n当它从究极之洞中现身时将其捕获吧。"]
	quest.1E6F0000000011BC.quest_subtitle: "阿罗拉"
	quest.1E6F0000000011BC.title: "爆焰龟兽"
	quest.1E6F0000000011C0.quest_desc: ["&5毒贝比&r是“毒刺”宝可梦，一种稀有且出人意料的亲昵究极异兽，兴奋时会发射带毒的尖刺。\n\n在究极之洞前捕获它——只要培养足够的亲密度，它就会进化成极具威慑力的&5毒贝比进化体&r。"]
	quest.1E6F0000000011C0.quest_subtitle: "阿罗拉"
	quest.1E6F0000000011C0.title: "毒贝比"
