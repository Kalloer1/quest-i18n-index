	quest.082DEC8CBA6D23E5.quest_subtitle: "&7由铁、煤炭和黑曜石锻造而成"
	quest.082DEC8CBA6D23E5.title: "&7&l暗钢锭"
	quest.0C220E9B2A780082.quest_desc: [
