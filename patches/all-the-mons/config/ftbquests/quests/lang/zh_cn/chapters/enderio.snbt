		"它非常适合与无线充电器搭配使用，可以在我们做其他事情时让工具持续充电。"
	]
	quest.448CCD89539AEBAC.quest_subtitle: "&7直接为我们的装备插电"
	quest.448CCD89539AEBAC.title: "&9&l有线充电器"
	quest.4557E63F1A6971DA.quest_desc: [
