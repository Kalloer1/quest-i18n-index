		"我们应该持续为其提供合适的原料并保持耐心，因为发酵并非一蹴而就。"
	]
	quest.6B37B24E3D25BF5C.quest_subtitle: "&7通过发酵获取虚空之露"
	quest.6B37B24E3D25BF5C.title: "&2&l发酵罐"
	quest.720A9D781C5B9B2D.quest_desc: [
