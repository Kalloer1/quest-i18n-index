# AI 初翻，未人工校对
{
	quest.00CB8D60E7831A57.quest_desc: ["地下墓穴是由深度岩砖建成的巨大地下结构。有时你可能会发现有一部分从地面伸出来。\n\n在这巨大的迷宫中，藏着&7遗忘者&r、隐藏宝箱以及首领：&a遗忘守卫&r。\n\n希望你能做好准备！"]
	quest.00CB8D60E7831A57.title: "地下墓穴"
	quest.01B13BBB41BBB460.quest_desc: ["&c乌瑟里姆护甲&r的属性和下界合金护甲一样！\n\n而且不需要锻造模板！"]
	quest.01B13BBB41BBB460.title: "&c乌瑟里姆&r护甲"
	quest.050D8480EE9D8E62.quest_desc: [
		"Wigglewood 森林和其他森林没什么两样。\n\n只是这些树喜欢随心所欲地移动。"
		"{image:atm:textures/questpics/undergarden/undergarden_wiggle.png width:200 height:100 align:center}"
	]
	quest.050D8480EE9D8E62.title: "晃晃木森林"
	quest.06D13E319C26C949.quest_desc: [
		"血蘑菇沼泽是巨型血蘑菇的家园。\n\n血液总让我感到不安，所以这个描述我就简短点吧。"
		"{image:atm:textures/questpics/undergarden/undergarden_blood.png width:200 height:100 align:center}"
	]
	quest.06D13E319C26C949.title: "血蘑菇沼泽"
	quest.073BA8470EA37A00.quest_desc: [
		"另一片海，只是这片要冷得多。"
		"{image:atm:textures/questpics/undergarden/undergarden_icy.png width:200 height:100 align:center}"
	]
	quest.073BA8470EA37A00.title: "冰海"
	quest.08D9C809CF4062E8.quest_desc: ["生吃、烤着吃，或者串在木棍上。\n\n用下界豆可真是想怎么玩就怎么玩！"]
	quest.0A0A991BAC99092C.quest_desc: [
		"靛蓝蘑菇沼泽比血蘑菇沼泽要“满”得多。\n\n当然这里有靛蓝蘑菇，还有迷你烟茎树和成池的剧毒混合物。真想知道这玩意儿有什么作用……"
		"{image:atm:textures/questpics/undergarden/undergarden_indigo.png width:200 height:100 align:center}"
	]
	quest.0A0A991BAC99092C.title: "靛蓝蘑菇沼泽"
	quest.0A1D6E233C0ECC8E.quest_desc: [
		"&d纳戈尔&r是栖息于地下的敌对生物，十分凶恶。 \n\n它们拥有 7.5 颗心，会不停地试图将你击杀。 \n\n它们什么也不会掉落，只会成为那些想要和平挖矿的玩家面前的障碍。 "
		"{image:atm:textures/questpics/undergarden/undergarden_nargoyle.png width:100 height:100 align:center}"
	]
	quest.0A1D6E233C0ECC8E.title: "&d纳戈尔&r"
	quest.0C98503A2F20484D.quest_desc: [
		"在冰原附近，你可能会发现冰雾茎森林。 \n\n这里的景象与冰原相似，只是遍布着雾茎树！"
		"{image:atm:textures/questpics/undergarden/undergarden_frostytrees.png width:200 height:100 align:center}"
	]
	quest.0C98503A2F20484D.title: "冰雾茎森林"
	quest.0D91A6B36BD2F526.quest_desc: ["升级你的&7克洛格鲁姆战斧&r，打造出&2&l地下花园&r所能提供的最强武器！"]
	quest.0D91A6B36BD2F526.title: "终极武器！"
	quest.0FA77C28A57E06F1.quest_desc: ["面纱蘑菇只存在于它们的沼泽中。 \n\n它们长着棕色的菌盖，如果菌盖下方是空气，就会生成蘑菇面纱。名字也因此而来！"]
	quest.1054168AFD8520D4.quest_desc: [
		"&a遗忘守卫&r是由&a遗忘锭&r构成的巨型魔像。 \n\n它会锁定玩家，并会不惜一切代价将其击杀。 \n\n它拥有 80 颗心，如果你能成功将其击败，它会掉落&a遗忘金块&r。"
		"{image:atm:textures/questpics/undergarden/undergarden_guardian.png width:100 height:200 align:center}"
	]
	quest.1054168AFD8520D4.title: "&a遗忘守卫&r"
	quest.1190BB433EFA3945.quest_desc: ["弹弓是 &2&lUndergarden&r 添加的一种非常有趣的武器。它有 4 种可以发射的弹药：\n\n闪亮粘液可以被发射出去，当它击中一个生物时，会给它们施加粘液效果。\n\n深岩只是普通的投射物。\n\n腐烂的水疱浆果会在撞击时爆炸。\n\n而 &eGronglets&r 不会造成任何伤害，它们只会发出噪音并被射出去！"]
	quest.119242549BD21764.quest_desc: [
		"&e蛮兽&r 会生成于几个生物群系中，并且是中立生物。\n\n如果其中一只受到攻击，该区域内的所有蛮兽都会攻击你。这一点与狼或僵尸化的猪灵类似。\n\n死亡时，它们可能会掉落獠牙，这可以作为骨头的替代品！"
		"{image:atm:textures/questpics/undergarden/undergarden_brute.png width:100 height:100 align:center}"
	]
	quest.119242549BD21764.title: "&e蛮兽&r"
	quest.130577AD1A1A8222.quest_desc: ["&7克洛格鲁姆&r 护甲的属性比铁质护甲稍差一些，但它几乎长在树上，所以我觉得这样还算公平。\n\n它的靴子还有助于穿过闪亮粘液！"]
	quest.130577AD1A1A8222.title: "&7克洛格鲁姆&r 护甲"
	quest.141681FE9E524FB0.quest_desc: [
		"&7遗忘者&r 是会在墓穴结构中生成的战士。\n\n它们身穿远古护甲，手持克洛格鲁姆工具，这些物品在死亡后都有可能掉落。\n\n它们还会锁定并击杀 &c腐化生物&r。"
		"{image:atm:textures/questpics/undergarden/undergarden_forgotten.png width:100 height:200 align:center}"
	]
	quest.141681FE9E524FB0.title: "&7遗忘者&r"
	quest.15A8F04BC10E619E.quest_desc: [
		"有些人讨厌探索各种各样的生物群系来获取所有不同的树苗。 \n\n显然 &2&lUndergarden&r 的开发者就是这么想的，所以他把它们大部分都放在了密林里！"
		"{image:atm:textures/questpics/undergarden/undergarden_dense.png width:200 height:100 align:center}"
	]
	quest.15A8F04BC10E619E.title: "密林"
	quest.16A04B2FC3F0D902.quest_desc: ["&7Cloggrum&r 工具的使用方式和铁工具完全一样，只是看起来更像泥而不是铁！ \n\n不过，它的剑比铁剑造成的伤害更高。"]
	quest.16A04B2FC3F0D902.title: "&7Cloggrum&r 工具"
	quest.17C2C8F64B4AE6EE.quest_desc: [
		"&2Dweller&r 是 &2&lUndergarden&r 里的“牛”。 \n\n它们是被动生物，死亡后会掉落皮革和 Dweller 肉。 \n\n谢天谢地它们不能被挤奶，我可不想喝这些 &2Dweller&r 产的奶。"
		"{image:atm:textures/questpics/undergarden/undergarden_dweller.png width:100 height:100 align:center}"
	]
	quest.17C2C8F64B4AE6EE.title: "&2Dweller&r"
	quest.19862DBCE9305DE3.quest_desc: ["&3长矛&r，是 &7Denizen&r 的首选武器……当然还有木斧。 \n\n你需要 2 根木棍和 &3Rogdorium&r 才能合成它。 \n\n它的伤害和 &b钻石剑&r 一样，而且攻击距离更远！ \n\n它还可以像三叉戟一样投掷。"]
	quest.19862DBCE9305DE3.title: "&3长矛"
	quest.1A23BBF444D17A63.quest_desc: [
		"&2高阶居住者&r生成于 Y 轴 0 层以下。你需要一把 &a遗忘之镐&r或 &6所有金属之镐&r才能开采挡路的地狱岩。\n\n&2高阶居住者&r的进化方向与它们那些低等同类不同。地下深处危机四伏，它们必须变得更大、更强！\n\n它们现在体型更大，拥有 100 颗心。而且它们不再是被动型生物，而是中立型。就像僵尸猪灵一样，只要有一个受到攻击，所有高阶居住者都会发起进攻。"
		"{image:atm:textures/questpics/undergarden/undergarden_greater.png width:100 height:100 align:center}"
	]
	quest.1A23BBF444D17A63.title: "&2高阶居住者"
	quest.1BAE1519E44E40CE.quest_desc: [
		"想象一片远古之海。现在，把里面的所有海带以及所有 &b吉布&r和 &b吉布林&r都移除掉。\n\n这就是死海！"
		"{image:atm:textures/questpics/undergarden/undergarden_dead.png width:200 height:100 align:center}"
	]
	quest.1BAE1519E44E40CE.title: "死海"
	quest.1C232674CD04024D.quest_desc: ["&2&l地下花园&r维度充满了各式各样、令人作呕的生物群系，那里有大量的植物、生物——既有友好的，也有不友好的——当然还有矿石和物品。\n\n希望你已准备好迎接战斗！"]
	quest.1C232674CD04024D.title: "欢迎来到 &2&l地下花园&r！"
	quest.1D2C70F1750E84D0.quest_desc: [
		"新的&c腐&r化生物？\n\n&c腐吐者&r拥有 17.5 颗心和 4 点护甲值。\n\n如果它们在你附近，就会朝你挥舞手臂。如果你离得稍远一些，它们就会朝你吐口水。\n\n如果它们的口水那么恶心，那可得漱漱口了。"
		"{image:atm:textures/questpics/undergarden/undergarden_rotbelcher.png width:100 height:200 align:center}"
	]
	quest.1D2C70F1750E84D0.title: "&c腐吐者"
	quest.1E13D7CE5A9EFF74.quest_desc: [
		"霜原是&2&l地下花园&r中的寒冷生物群系之一。从巨大的冰柱、粉雪和冰冻深草中，你就能看出这里有多冷！\n\n此外，这里没有常见的深岩地下层，取而代之的是颤石。\n\n颤石的特性更像冰，而不是真正的石头。好吧，至少当你站在上面的时候是这样！"
		"{image:atm:textures/questpics/undergarden/undergarden_frosty.png width:200 height:100 align:center}"
	]
	quest.1E13D7CE5A9EFF74.title: "霜原"
	quest.1E81B903137BB62A.quest_desc: ["普通的工具可不够用，尤其是在对付&2&l地下花园&r中危险的生物时。\n\n我们可以制作&7木塞盾&r，它的作用和普通盾牌一样。\n\n但我们需要从&7遗忘者&r那里获得作为稀有掉落的&7战斧&r。"]
	quest.1E81B903137BB62A.title: "&7木塞&r武器"
	quest.1FCF946B7BE3C0BD.quest_desc: ["&c乌瑟里姆&r工具与钻石工具类似，但其武器对&c腐化生物&r更为有效！\n\n你可以使用它们制作的工具对这些生物造成更多伤害！我本可以借此玩上十几个流行文化梗，但此刻却一个也想不出来……"]
	quest.1FCF946B7BE3C0BD.title: "&c乌瑟里姆&r工具"
	quest.22739522F0D33D7B.quest_desc: ["幽暗南瓜的生成与种植方式与南瓜相同。 \n\n它们也和南瓜一样，可以制作成派，甚至是杰克灯！ \n\n但与南瓜不同的是，它们还可以被制成爆炸物……"]
	quest.24D38DA8E86DD897.quest_desc: [
		"&c腐化生物&r中最小、最弱的一种。\n\n它们拥有 5 颗心。\n\n与所有&c腐化生物&r一样，它们会攻击&2石生者&r和&7遗忘者&r，并且会掉落&c乌瑟里姆碎片&r。"
		"{image:atm:textures/questpics/undergarden/undergarden_rotling.png width:100 height:100 align:center}"
	]
	quest.24D38DA8E86DD897.title: "&c腐化幼体&r"
	quest.257893DD23BF5017.quest_desc: ["要获得&3罗格多里姆&r，我们需要前往 Y 轴 0 层以下的深处。为此，你需要一把&a遗忘稿&r或&6万物合金稿&r。\n\n你还需要同样品级的稿子才能开采&3罗格多里姆矿石&r。这种矿石会在深处的任何地方生成。\n\n你也可以使用&a遗忘斧&r或&6万物合金斧&r来开采&3罗格多里姆远古根&r。它们更为常见，但与&3矿石&r相比，只会掉落一个&3罗格多里姆金块&r。"]
	quest.257893DD23BF5017.title: "&3Rogdorium"
	quest.278D34BBC13356DF.quest_desc: [
		"一片紫色沼泽！\n\n这里到处都是墨菇和剧毒混合物！"
		"{image:atm:textures/questpics/undergarden/undergarden_ink.png width:200 height:100 align:center}"
	]
	quest.278D34BBC13356DF.title: "墨菇沼泽"
	quest.2A2041098C069772.quest_desc: [
		"&7居民&r会生成在深度层，也就是 Y 值 0 以下的位置。你需要一把&a遗忘之镐&r或同等阶的工具才能在那里挖掘。\n\n&7居民&r看起来奇形怪状又恶心，他们戴着神秘面具，手持长矛或木斧。\n\n&7居民&r有矮胖和瘦高两种体型。但他们都有 10 颗心。\n\n除了可能掉落的武器外，他们不会掉落任何东西。"
		"{image:atm:textures/questpics/undergarden/undergarden_denizens.png width:100 height:200 align:center}"
	]
	quest.2A2041098C069772.title: "&7居民"
	quest.2C5A7E4CD8B57E08.quest_desc: ["格龙格尔树是一种高大的丛林类树木，只会在格龙格尔生长群系中生成！\n\n&e格龙格尔幼崽&r也会在这些树上生成。"]
	quest.2E596B5A4EA2ABF4.quest_desc: [
		"那个斯莫格通风口在动吗？不，等等，那只是一个&3斯莫格&r！它是&2莫格&r的近亲！\n\n它们的行为和&2莫格&r完全一样，只是它们可能会掉落蓝色莫格苔藓。"
		"{image:atm:textures/questpics/undergarden/undergarden_smog.png width:100 height:100 align:center}"
	]
	quest.2E596B5A4EA2ABF4.title: "&3斯莫格&r"
	quest.30582B5FBED35FD1.quest_desc: ["&c乌瑟里克簇&r和&c碎片&r可由多种不同的生物掉落，尤其是&c腐化&r怪物。\n\n9 &c碎片&r可合成 1 &c簇&r。\n\n然后我们需要使用注入器，将&3罗格多rium&r和&c乌瑟里克簇&r组合起来，以合成&c乌瑟里克水晶&r。"]
	quest.30582B5FBED35FD1.title: "&c乌瑟里克&r"
	quest.30D6924003C6E273.quest_desc: ["&7居民&r营地可以在地底深处找到。你需要在恐惧岩下方、Y 轴 0 层以下进行挖掘。\n\n挖掘恐惧岩需要一把&a遗忘之镐&r。它的等级与&6万物钠镐&r相同。\n\n这里会刷新一大群&7居民&r，还有神秘的图腾和箱子！箱子偶尔会刷出一个神秘面具，和&7居民&r戴的是同一种。\n\n在&7居民&r附近佩戴神秘面具，就像在猪灵面前穿戴&e金锭&r一样。除非有人受到攻击（或做了激怒它们的事），否则它们会保持中立。"]
	quest.30ED5FF9DF7B34CF.quest_desc: ["通过搜刮居民营地或合成，我们就能使用神秘图腾了！\n\n呃……该怎么用它呢？\n\n只需将它放置下来，它每隔几秒就会为你施加 10 秒的&b纯净&r效果。\n\n&b纯净&r效果可以净化你身上的&c腐化&r。"]
	quest.353AEEC116A5DEEF.quest_desc: [
		"&2&l地下花园&r中的远古之海是一片广阔的海洋。\n\n不知为何，即便污染物如此之多，这里的水依然可以安全饮用。\n\n水中还有&bGwibs&r和&bGwiblings&r。当然，别忘了还有亮晶晶海藻！"
		"{image:atm:textures/questpics/undergarden/undergarden_ancient.png width:200 height:100 align:center}"
	]
	quest.353AEEC116A5DEEF.title: "远古之海"
	quest.36389696767EFB4E.quest_desc: [
		"荒芜深渊正如其名，一片荒芜……这里除了敌对生物和鹅卵石之外，别无他物。\n\n就我个人而言，我宁愿在别的地方找鹅卵石……"
		"{image:atm:textures/questpics/undergarden/undergarden_barren.png width:200 height:100 align:center}"
	]
	quest.36389696767EFB4E.title: "荒芜深渊"
	quest.380D3212D1CBA593.quest_desc: [
		"中等体型的&c腐化生物&r——&c腐化行者&r。\n\n它们拥有20颗心。\n\n与所有&c腐化生物&r一样，它们会攻击&2石造人&r和&7遗忘者&r，并且会掉落&c乌瑟瑞克碎片&r。"
		"{image:atm:textures/questpics/undergarden/undergarden_rotwalker.png width:100 height:200 align:center}"
	]
	quest.380D3212D1CBA593.title: "&c腐化行者&r"
	quest.3AF7446592D19FA6.quest_desc: ["&e皇家玉&r是&2&l地下花园&r中绿宝石的对应物。\n\n它无法制成盔甲或工具，但可以用来和&2石造人&r交换其他物品。"]
	quest.3AF7446592D19FA6.title: "&e皇家玉&r"
	quest.4141EF8B8C316118.quest_desc: ["&7克洛格拉姆&r是&2&l地下花园&r之铁。\n\n它随处可见，可用于数十种不同的配方。\n\n甚至有些生物也会掉落它！"]
	quest.4141EF8B8C316118.title: "&7克洛格拉姆&r"
	quest.43A1BC20BB054A14.quest_desc: ["亮片海带生长在远古之海与冰海之中。\n\n它们没什么特别的作用，只会发光，而且可以合成派！"]
	quest.43FD4AEBB9548E57.quest_desc: [
		"烟茎森林是靛蓝蘑菇沼泽相邻的生物群系。\n\n当然，它也是蓝色的，里面还有靛蓝蘑菇！只是有更大的烟茎树！"
		"{image:atm:textures/questpics/undergarden/undergarden_smogstem.png width:200 height:100 align:center}"
	]
	quest.43FD4AEBB9548E57.title: "烟茎森林"
	quest.4568C2F465EDB960.quest_desc: ["垂坠果几乎可以在任何生物群系中生成，只要抬头看看就行！\n\n它们会生成在大多数生物群系的顶部，生长方式与发光浆果类似。"]
	quest.46DCB235D3FEDA61.quest_desc: ["这些工具与铁制工具类似，只是所有工具都会让被击中的目标减速。\n\n锄头除外，不过你真的会在意一把普通的锄头吗？"]
	quest.46DCB235D3FEDA61.title: "&b寒钢&r工具"
	quest.4985F82E0D300C6D.quest_desc: ["如果你想返回&2&l主世界&r，却找不到原来的传送门，别担心，还有别的办法！\n\n用4块深岩、4个&7克洛格拉姆锭&r和一个&a遗忘金锭&r，你就能合成崩解催化剂。\n\n崩解催化剂的作用方式与普通催化剂一样，都能激活传送门。"]
	quest.49EB9FB2133E3219.quest_desc: ["远古盔甲是&7遗忘者&r所穿戴的装备，你可以在这里找到它。\n\n不过并没有远古靴子，据说&7遗忘者&r没有脚。"]
	quest.49EB9FB2133E3219.title: "远古盔甲"
	quest.4C5CFA45D9B4F6D3.quest_desc: ["靛蓝蘑菇和烟茎似乎是好朋友，它们主要会一起生成！"]
	quest.4C7E006502E30C20.quest_desc: ["本任务由&6AllTheMods 工作人员&r或&2社区贡献者&r编写，供 AllTheMods 整合包使用。\n\n由于所有&6AllTheMods&r整合包均遵循&e保留所有权利&r许可协议，未经&6AllTheMods 团队&r明确许可，本任务不得用于任何非其发布的公开整合包。\n\n本任务被刻意隐藏，如果你能看到这段文字，说明你正处于编辑模式。"]
	quest.4D836B9D9E3B898F.quest_desc: [
		"&a石生者&r是村民和铁傀儡的完美结合体。\n\n你可以通过右键点击它们来交易。\n\n它们还会攻击敌对生物（或攻击它们的玩家）。"
		"{image:atm:textures/questpics/undergarden/undergarden_stoneborn.png width:100 height:150 align:center}"
	]
	quest.4D836B9D9E3B898F.title: "&a石生者&r"
	quest.4E3D548E5D8D7D26.quest_desc: [
		"遗忘原野是&2&l地下花园&r的平原。\n\n这里没有树木，但有大量的岩石、花朵和生物！\n\n不过这里不会生成&7遗忘者&r，嗯，很抱歉浇灭你的热情。"
		"{image:atm:textures/questpics/undergarden/undergarden_field.png width:200 height:100 align:center}"
	]
	quest.4E3D548E5D8D7D26.title: "被遗忘的田野"
	quest.4F3B4990BE6C2A4A.quest_desc: [
		"&7荧光虫&r是随处可见的无辜小鼻涕虫，它们遍布整个&2&l地下花园&r。\n\n它们的行为举止像雪傀儡一样，所到之处都会留下一条痕迹。只不过这种的痕迹更加黏糊糊……\n\n它们死后会掉落荧光虫粘液，但你直接从它们的痕迹上采集就行，何必非要杀掉它们呢！"
		"{image:atm:textures/questpics/undergarden/undergarden_scintling.png width:150 height:100 align:center}"
	]
	quest.4F3B4990BE6C2A4A.title: "&7荧光虫&r"
	quest.4F5A2E2A5C7F4837.quest_desc: ["&a遗忘锭&r需要通过地下墓穴来获取；无论是从宝箱中搜刮，还是击杀&a遗忘守卫&r都可以。\n\n你还需要一个锻造模板，它可以在地下墓穴的宝箱中找到。"]
	quest.4F5A2E2A5C7F4837.title: "&a遗忘&r"
	quest.511144EF336BFAF5.quest_desc: [
		"烟雾尖塔……没错，你猜对了！所有的烟雾都源自于此！好吧，也不全是，我们可不能忽略了&2莫格&r和&3史莫格&r。\n\n在这里你会找到水泡浆果、粗糙的深土以及烟雾喷口。不过我可不建议你靠近它们……"
		"{image:atm:textures/questpics/undergarden/undergarden_smogspires.png width:200 height:100 align:center}"
	]
	quest.511144EF336BFAF5.title: "烟雾尖塔"
	quest.51C59FDF0BD11FDF.quest_desc: ["我很确定，关于“扭木树”的定义，唯一能确定的就是它有扭木原木和扭木树叶。它们似乎能以任何方向、尺寸和形状生长。\n\n你可以在扭木森林和密林中找到它们。\n\n它们有漂亮的粉色树叶和类似云杉的棕色原木！"]
	quest.51E2728C5E35A152.quest_desc: ["寒钢会生成在冰冻群系中：霜原、霜雾森林，可能还有冰海。\n\n它会生成在这些群系中替代深岩的“颤石”里。颤石的作用和冰类似，会很滑，并且会让你稍微减速。\n\n你或许还能在“吞噬者”的肚子里找到一些矿锭！"]
	quest.51E2728C5E35A152.title: "&b寒钢&r"
	quest.53FDC6C536E50A1A.quest_desc: ["&b咕噜鱼&r是海里的一种友好鱼类。\n\n它们比&b咕比&r小，行为举止就像&2&l原版&r鱼一样！"]
	quest.53FDC6C536E50A1A.title: "&b咕噜鱼&r"
	quest.57545837046F552B.quest_desc: [
		"等等，那可不是一个普通的罐子！\n\n&2神秘罐子&r是伪装成罐子的生物。\n\n它们有 4 颗心，被击中后会逃跑。如果它们觉得安全了，就会变回伪装的样子。\n\n死亡时，它们可能会掉落&7克洛格伦&r、&b寒钢矿锭&r和&c乌瑟碎片&r。\n\nL7={image:atm:textures/questpics/undergarden/undergarden_pot.png width:100 height:120 align:center}"
		"{image:atm:textures/questpics/undergarden/undergarden_pot.png width:100 height:120 align:center}"
	]
	quest.57545837046F552B.title: "&2神秘罐子"
	quest.5AF0E903DB670D65.quest_desc: ["借助一些恐惧岩、&3罗格多瑞姆&r和一个&c乌瑟瑞克集群&r，我们就能制作出灌注器！\n\n这是一个可以用来制作和灌注特定物品的方块。目前配方还不多，但我相信之后会看到更多！\n\n它的主要用途是制作&c乌瑟瑞克水晶&r，以及用&3罗格多瑞姆&r灌注护甲。\n\n如果护甲被&3罗格多瑞姆&r灌注，它将能保护你免受&c腐烂&r疾病的影响。"]
	quest.5B4B5C148D63ACA1.quest_desc: [
		"&a遗忘仆从&r不像普通生物那样自然生成，它们需要被创造出来。将一个雕纹幽南瓜放在&a遗忘锭块&r上即可创造它们。\n\n它们的行为类似于雪傀儡，永远不会攻击你，而是会射击敌对生物。\n\n它们有 10 颗心，死亡时不会掉落任何东西……但话说回来，你为什么要杀它们呢？"
		"{image:atm:textures/questpics/undergarden/undergarden_minion.png width:125 height:100 align:center}"
	]
	quest.5B4B5C148D63ACA1.title: "&a遗忘仆从&r"
	quest.5D229FA3A5F92954.quest_desc: [
		"&4吞噬者&r与&2&l地底花园&r中的其他敌对生物类似，但它掉落的东西让它更有用！\n\n吞噬者死亡时会掉落&7克洛格伦&r和&b寒钢锭&r。"
		"{image:atm:textures/questpics/undergarden/undergarden_muncher.png width:100 height:100 align:center}"
	]
	quest.5D229FA3A5F92954.title: "&4吞噬者&r"
	quest.5E63C78CDC44FF95.quest_desc: ["腐烂的水泡莓无法投掷，但制成水泡炸弹后就可以投掷了！\n\n你甚至可以更进一步，制作出爆炸瓜，它会像TNT一样将水泡莓抛洒到各处。"]
	quest.5E63C78CDC44FF95.title: "爆炸物！！！"
	quest.5FCA6F5FE97780B7.quest_desc: [
		"&e格隆格&r在技术上属于方块，而非生物。但我实在太喜欢它们了，不能不把它们加进来！\n\n它们会生成在格隆格树上，并能发出噪音和亮光！绝对非常适合用来装饰。"
		"{image:atm:textures/questpics/undergarden/undergarden_gronglet.png width:100 height:100 align:center}"
	]
	quest.5FCA6F5FE97780B7.title: "&e格隆格&r"
	quest.6124C0E9E419694B.quest_desc: ["使用&a遗忘锭&r和锻造模板来升级&7克洛格鲁姆&r工具。\n\n这些是你所能获得的最强工具，它们自带效率附魔，专门用于挖掘&2&l地下花园&r方块。\n\n而且剑和斧头会对所有&2&l地下花园&r生物造成更多伤害，但&c腐兽&r和&a遗忘守卫&r除外！"]
	quest.6124C0E9E419694B.title: "&a遗忘&r工具"
	quest.647A87E800C703C3.quest_desc: [
		"这是我最喜欢的生物群系！\n\n一片巨大的绿色丛林，里面长着硕大的格隆格生长树。\n\n你可以在那些树上找到&e格隆格&r！"
		"{image:atm:textures/questpics/undergarden/undergarden_grongle.png width:200 height:100 align:center}"
	]
	quest.647A87E800C703C3.title: "格隆格生长树"
	quest.6751F2651063B3A5.quest_desc: ["血蘑菇可以在它们的沼泽中找到。\n\n它们的形状像深色橡树，大部分是白色的，只有少数方块上带有血点！"]
	quest.67A2347534269528.quest_desc: [
		"&9斯普洛吉&r很少会生成，但一旦出现，它们注定会让你感到恼火。\n\n它们会朝你吐口水（并发出恶心的吸吮声），但如果你攻击它们，它们就会逃跑；有点像幼年猪灵。\n\n它们死亡时只会掉落深岩卵石。"
		"{image:atm:textures/questpics/undergarden/undergarden_sploogie.png width:125 height:100 align:center}"
	]
	quest.67A2347534269528.title: "&9斯普洛吉&r"
	quest.6C4B93FE64BD418D.quest_desc: ["前往&2&l地下花园&r的方式与前往&c&l下界&r类似。你需要制作一个传送门。\n\n它的形状和大小与下界传送门相同，但你需要使用一种特殊版的石砖来代替黑曜石。这些石砖可以是普通石砖、苔藓石砖或深板岩砖。\n\n一旦建成，你可以使用触媒来激活它。"]
	quest.6C4B93FE64BD418D.quest_subtitle: "制作传送门"
	quest.6C4B93FE64BD418D.title: "地下花园"
	quest.6D4FB6291CA8D1A6.quest_desc: ["烟雾茎树的底部要粗壮得多，有点像现实生活中的猴面包树！\n\n它们长着蓝色的叶子和灰色的树干。\n你可以在多种生物群系中找到它们：烟雾茎森林、密林，甚至靛蓝蘑菇沼泽！"]
	quest.6E7C8537D8A28833.quest_desc: [
		"Y 层级 0 以下有两个生物群系，而“地底深处”是其中之一。\n\n要想到达 Y 层级 0 以下，你需要开采恐惧岩。开采恐惧岩需要一把遗忘稿或全金属镐。\n\n在这里，大型居住者、居民和腐化怪物会生成。"
		"{image:atm:textures/questpics/undergarden/undergarden_depths.png width:200 height:100 align:center}"
	]
	quest.6E7C8537D8A28833.title: "地底深处"
	quest.6F416275B6F6D8F0.quest_desc: [" blisterberries 生长在烟雾尖塔中。\n\n由于它们生长在如此恶心的区域，有些会自带腐坏状态。\n\n我不建议吃掉这些，也许它们能在别的地方派上用场！"]
	quest.6F483B77D64F4EE2.quest_desc: [
		"Y 层级 0 以下有两个生物群系，而“罗格多里乌姆林地”是其中之一。\n\n要想到达 Y 层级 0 以下，你需要开采恐惧岩。开采恐惧岩需要一把遗忘稿或全金属镐。\n\n与“地底深处”相比，这是一个友好得多的生物群系。怪物少得多，植物生命却丰富得多！现在还有烟雾茎树和各种各样的花朵。"
		"{image:atm:textures/questpics/undergarden/undergarden_rogdorium.png width:200 height:100 align:center}"
	]
	quest.6F483B77D64F4EE2.title: "罗格多里乌姆林地"
	quest.70FD8856BFCD9AEE.quest_desc: [
		"体型最大、最危险的 &c腐化生物&r。\n\n它们拥有 80 颗心，我认为这足以称得上是头目。\n\n与所有 &c腐化生物&r 一样，它们会攻击 &2石生生物&r 和 &7遗忘者&r，并且会掉落 &c乌瑟碎片&r。"
		"{image:atm:textures/questpics/undergarden/undergarden_rotbeast.png width:100 height:100 align:center}"
	]
	quest.70FD8856BFCD9AEE.title: "&c腐化巨兽&r"
	quest.71E1454990DEC451.quest_desc: [
		"&b格威布&r 是 &b格威林&r 的放大版，而且更加愤怒。\n\n它们既不会掉落任何东西，也无法被装入桶中。它们能带来的只有痛苦！"
		"{image:atm:textures/questpics/undergarden/undergarden_gwib.png width:100 height:100 align:center}"
	]
	quest.71E1454990DEC451.title: "&b格威布&r"
	quest.739601B0C43B239B.quest_desc: ["是的，它们可以制作黑色染料！"]
	quest.744DBE831C120B2F.quest_desc: [
		"那块石头在动吗？哦等等，那不是石头，而是一只 &a莫格&r！\n\n&a莫格&r 可以用深岩卵石进行繁殖，死亡时可能会掉落更多卵石或莫格苔藓！\n\n莫格苔藓可用于多种不同的配方！"
		"{image:atm:textures/questpics/undergarden/undergarden_mog.png width:100 height:100 align:center}"
	]
	quest.744DBE831C120B2F.title: "&a莫格&r"
	quest.75A66B81C1181F59.quest_desc: ["被遗忘的遗迹是深岩砖的微小废墟，它们存在于&2&l地下花园&r中。\n\n这里有大量装满战利品的罐子！\n\n直接打破它们就行！"]
	quest.75A66B81C1181F59.title: "遗忘遗骸"
	quest.7617737FC179EA1A.quest_desc: ["&b霜钢&r护甲比钻石护甲稍差，但它能提供大量的击退抗性。\n\n不过它也会施加速度减益效果，看来我们移动不了多少了！"]
	quest.7617737FC179EA1A.title: "&b霜钢&r护甲"
	quest.76CDC18D7A208512.quest_desc: ["在&2&l地下花园&r中，&c腐化生物&r（&c腐化幼体&f、&c腐化行者&f、&c腐化喷吐者&f以及&c腐化巨兽&r）会感染你，使你获得&c乌瑟里姆&r。\n\n如果你被感染，你的饱食度条上方会出现红色条。当红色条累积到4格满时，你的屏幕上会出现红线。当达到8格时，这些条会开始晃动，提醒你情况正在恶化。当达到10格时，所有红线都会发光，这时你开始受到伤害。\n\n除非&c腐化&r效果已满，否则它会自行缓慢消失。你也可以从神秘图腾中获得纯净效果，或食用&3罗格多里姆&r来清除它。\n\n这两种物品都来自地底深处，它们生成在Y轴0层以下。你需要一把&a遗忘之镐&r，或另一把同等级的镐（例如&6万物金属&r镐）才能到达那里。\n\n防止&c腐化&r效果的唯一方法是，使用灌注机将&3罗格多里姆&r灌注到你的护甲上。"]
	quest.76CDC18D7A208512.title: "警告"
	quest.79C652E3FCB88550.quest_desc: [
		"&5幽暗蠕虫&r在技术上属于被动生物，但它们有针对你的防御机制，所以我认为它们是中立生物！\n\n受到攻击时，它们会掉落一种类似滞留药水的效果。\n\n死亡时，它们会掉落它们的腿（非常美味），并有可能掉落皮革。\n\n它们还可以与幽暗南瓜进行繁殖！"
		"{image:atm:textures/questpics/undergarden/undergarden_gloomper.png width:100 height:100 align:center}"
	]
	quest.79C652E3FCB88550.title: "&5幽暗蠕虫&r"
	quest.7E3DA4168D352B42.quest_desc: [
		"我保证这绝对是最后一个蘑菇沼泽！\n这些蘑菇看起来相当普通，但它们的特别之处在于它们会生成东西！\n\n那就是帷幕！绝对是一种很有用的装饰方块。"
		"{image:atm:textures/questpics/undergarden/undergarden_veil.png width:200 height:100 align:center}"
	]
	quest.7E3DA4168D352B42.title: "帷幕蘑菇沼泽"
	task.39194D9CDF673768.title: "保留所有权利"
	task.4AA225E5056787B8.title: "保留所有权利"
}
