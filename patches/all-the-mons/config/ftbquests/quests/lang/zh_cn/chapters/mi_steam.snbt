	quest.357DDE894EB512F7.quest_desc: ["&#65C2A6绕线机&r能够施加恰到好处的力，为我们制造出&#53E67B电线&r。太惊人了！！我知道……"]
	quest.3AA4D1B60E4E71A5.quest_desc: ["所有&c多方块结构&r都由其中放置的&e舱口&r决定。升级&c多方块结构&r中的这些&e舱口&r，即可升级整个机器。"]
	quest.41877F44CD3D1EDB.quest_desc: ["&#E3BC19青铜熔炉&r的功能和普通熔炉一样，主要区别在于它使用蒸汽驱动，速度是普通熔炉的两倍。"]
	quest.458BFDB636F8B495.quest_desc: ["将焦炭粉与铁结合，可以得到未炼制的钢粉。在蒸汽高炉中将其冶炼，就能得到后续发展所需的钢锭。"]
	quest.478C1AF86610A8B7.quest_desc: ["&#EDD653&n压缩机&r用于制造&#53EDAA钢板&r、&#53EDAAC弧形钢板&r和&#53EDAAR圆环&r。"]
	quest.48F77A0BE1F33B29.quest_desc: ["利用新建造的&#65C2A6绕线机&r，我们现在可以制造&#53E67B电线&r和&#53E67B细电线&r，从而迈入电气时代。"]
	quest.48F77A0BE1F33B29.title: "危险电线"
	quest.4E69C6ABFE467C25.quest_desc: ["&#65C2A6合金熔炉&r出自&#3187C4扩展工业化&r模组。它将&#4C4BDEMixer&r和&#954BDEFurnace&r的功能合二为一，从而让工作不再那么繁琐。"]
	quest.55C6BBC996B51838.quest_desc: [
		"&#ED9553青铜锅炉&r可将&9水&r转化为蒸汽。蒸汽将作为燃料，驱动您的机器在&7&n蒸汽时代&r中运行。"
		""
