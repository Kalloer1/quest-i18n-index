{
	quest.088CA7B6D4899846.quest_desc: ["&#65C2A6打包机&r可用于制作&#53E67B双锭&r、&#53E67B刀片&r和&#53E67B线缆&r。此外，这台机器还有许多其他用途，但这些将是您主要会用到的功能。"]
	quest.0DAF5D42694EA8C9.quest_desc: [
		"&#6E6D6D&n锻造锤&r是您旅程的起点。它的用途广泛，比如从矿石中获得&#B53A3A更好的产出&r，或为未来的合成制作&#DBD25A组件&r。"
		""
		"您制作的 &7锤子&r 并非配方所必需，但它能让您制作的 &#DBD25A组件&r 产出更优。"
	]
	quest.0DAF5D42694EA8C9.title: "&#949494锻造锤"
	quest.1036837C9AD3F301.quest_desc: ["&#6E6D6D锻造锤&r 能让您轻松将 &#FFAC3BCopper&r 锭或矿石压制成粉尘。"]
