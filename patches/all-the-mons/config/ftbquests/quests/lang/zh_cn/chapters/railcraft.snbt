# AI 初翻，未人工校对
{
	image.0327A7CE94F83020.title: "电力机车"
	image.0FB64A4C4AF4664E.title: "带能量块的矿车"
	image.12757CDE8B1A35DF.title: "废弃铁轨"
	image.18972B0749E2EA01.title: "锅炉"
	image.1BDCD98C1C2F17BF.title: "电力铁轨"
	image.2226E8B229B86DCC.title: "加固铁轨"
	image.239A0727CB2C8C1B.title: "破碎机"
	image.24BD06A9BD07674C.title: "蒸汽机车"
	image.24D81B190D816E71.title: "蒸汽轮机"
	image.2A9B7D4AE71AE1E2.title: "矿车分配器"
	image.2D263FA3DA029DE1.title: "强化铁轨"
	image.30A3450CC96A010B.title: "流体装载"
	image.409067B98EFFFC3F.title: "焦炭炉"
	image.445FA61A0F24E9A2.title: "高炉"
	image.494A55C2CBE4E55C.title: "水箱"
	image.4CF7DDB74BF6E8CA.title: "物品装载"
	image.513AD8A7842AC3C3.title: "火车分配器"
	image.5BDD8EE796DE026E.title: "物品卸载"
	image.64F5D33A1B0154A9.title: "蒸汽炉"
	image.723C2B19439D99F1.title: "铁轨：拆除器、中继器和铺设器"
	image.73CE36293444E751.title: "带储罐的矿车"
	quest.008D186B4E0ED14F.quest_desc: [
		"蒸汽炉是另一种将蒸汽用于实际用途的机器。\n\n将蒸汽注入蒸汽炉后，它会像熔炉一样处理其中的任何物品，将矿石炼成锭，并烹饪食物。\n\n它是一个由 2x2x2 个蒸汽炉方块组成的机器。"
		"{image:atm:textures/questpics/railcraft/rail_oven.png width:100 height:100 align:center}"
	]
	quest.008D186B4E0ED14F.title: "蒸汽熔炉"
	quest.020E6AF37A0421C8.quest_desc: [
		"蓄水箱就像在外面放一个桶。只是这个桶要大得多。它能收集水，并为蒸汽机车储水。\n\n它能产生的水量取决于生物群系，并且需要能看见天空。\n\n它由 3x3x3 的蓄水箱方块构成，中心是空的。"
		"{image:atm:textures/questpics/railcraft/rail_tank.png width:100 height:100 align:center}"
	]
	quest.020E6AF37A0421C8.title: "蓄水箱"
	quest.032B654201E71618.quest_desc: ["这些 &c轨道套件&r 用于让你的 &7矿车&r 搭载实体（实体即生物）。\n\n&c上客套件&r 会拾取附近的所有生物，并将它们放入 &7矿车&r 中。\n&c下客套件&r 会从 &7矿车&r 中卸下生物。\n&c倾倒套件&r 会将 &7矿车&r 中的生物掉落在其所在的 &6轨道&r 下方。"]
	quest.032B654201E71618.title: "用于移动实体的 &c轨道套件&r"
	quest.035C52EF63AD23A7.quest_desc: ["因此，这个模组的名称 &lRailCraft&r 以及其核心内容 &5火车&r、&6铁轨&r 都相当重要。\n\n&2原版&r铁轨对很多用途都够用，但说真的，我们都知道它们很垃圾。升级版的铁轨则需要一些更特殊的物品来合成！快去合成吧！（它们可能需要使用机器来制作物品，所以记得看看任务书的相关部分！）"]
	quest.035C52EF63AD23A7.title: "&6&l铁轨&r！"
	quest.068294A7C21DE550.quest_desc: ["&c轨道套件&r用于与 &6铁轨&r 合成，以制作特殊的 &6铁轨&r。\n\n这些 &6铁轨&r 将对所有与 &5火车&r 相关的事情都很有帮助，例如：让 &5火车&r 停止、移动 &5火车&r 以及发射红石信号。"]
	quest.068294A7C21DE550.title: "&c&l轨道&r！"
	quest.08457BEED799E600.quest_desc: ["这些新的 &7矿车&r主要用于铺设 &6轨道&r。\n\n&7轨道铺设器&r 可以铺设 &6轨道&r，而 &7轨道拆除器&r 则可以拆除 &6轨道&r。\n\n&7轨道重铺器&r 会用不同类型的轨道替换 &6轨道&r，而 &7轨道下挖机&r 则会替换 &6轨道&r 下方的方块。"]
	quest.08457BEED799E600.title: "&7矿车&r 和 &6轨道"
	quest.0A43FD0B5C76C1C5.quest_desc: [
		"&l&7RailCraft&r 为我们添加了一个高炉多方块结构，可将铁转化为钢！\n\n要建造它，你需要 34 块高炉砖。它的尺寸为 3 格宽、3 格长、4 格高。正中心的两个方块需要是空的。当它整体成型并允许你访问其 GUI 时，就说明建造完成了。\n\n在那里，你可以放入任何形态的铁，以获得钢和粒化砂。"
		"{image:atm:textures/questpics/railcraft/rail_furnace.png width:100 height:100 align:center}"
	]
	quest.0A43FD0B5C76C1C5.title: "高炉（钢）"
	quest.104049993CC62E7F.quest_desc: ["高级物品加载器具备普通物品加载器的所有功能，但可以在 &6铁轨&r 附近的任何位置使用，无论是旁边、上方还是另一侧的旁边。使用 &4撬棍&r 可以改变它的方向。"]
	quest.104049993CC62E7F.title: "高级物品加载器"
	quest.1698565EBB68DC85.quest_desc: [
		"&6道岔轨道&r 是使用尖头锤制作的第二种轨道。它能将两条 &6铁轨&r 汇成一条。如果有一条 &6铁轨&r 与另一条铁轨相交，&6道岔&r 会将第一条 &6铁轨&r 上的 &7矿车&r 移动到与之相交的铁轨上。"
		"{image:atm:textures/questpics/railcraft/rail_wye.png width:100 height:100 align:center}"
	]
	quest.1698565EBB68DC85.title: "&6道岔轨道"
	quest.170118E3C3C072E5.quest_desc: [
		"&6道岔&r是尖刺锤制作的最后一种&6铁轨&r。它对于&6铁轨&7来说就像一个普通的交叉口。&r矿车&6会继续沿着原来的方向前进，但现在&r铁轨&7可以交叉了。如果2辆&r矿车&e在道岔上相撞会怎么样？它们会爆炸！！！我开玩笑的，但&r电力机车<c14>真的会爆炸。"
		"{image:atm:textures/questpics/railcraft/rail_junction.png width:100 height:100 align:center}"
	]
	quest.170118E3C3C072E5.title: "&6道岔铁轨"
	quest.175D943160C10646.quest_desc: [
		"&l&7铁路工艺&r使用了许多用于不同用途的机器，但主要用于资源生产。"
		""
		"它们都需要从铁锭开始制作！"
	]
	quest.175D943160C10646.title: "&l&7机器"
	quest.17F7964611D893BE.quest_desc: ["流体装载器将有助于让您的&3蒸汽机车&r保持运行。它必须放置在&6铁轨&r上方几格的位置，然后会将流体装载到&5机车&r或&7矿车&r中。"]
	quest.17F7964611D893BE.title: "流体装载器"
	quest.184F98BE0F6710E2.quest_desc: ["这两种&c铁轨套件&r用于配合&7矿车&r和红石。\n\n&c激活套件&r会激活从它上方经过的任何&7矿车&r。\n&c侦测套件&r则会在&7矿车&r经过时激活红石信号。\n\n这两种套件的功能都类似于它们在普通&6铁轨&r上的&2原版&r对应物。"]
	quest.184F98BE0F6710E2.title: "用于红石的&c铁轨套件&r"
	quest.21693C4DE6531D73.quest_desc: [
		"L1=破碎机正如其名。它可以破碎方块来获取制作材料，例如从砖楼梯获取砖块，或从锭获取粉尘。\n\n不过它需要动力才能工作！\n\n要建造一个破碎机，需要使用 3x2x2 个破碎机方块。"
		"{image:atm:textures/questpics/railcraft/rail_crusher.png width:100 height:100 align:center}"
	]
	quest.21693C4DE6531D73.title: "破碎机"
	quest.249E5C6893387E15.quest_desc: ["这些 &c轨道&r 是用来让 &5机车&r 和 &7矿车&r 停下的。\n\n&c锁定套件&r 可以让 &7矿车&r 停止，只有在接收到红石信号后才会启动。\n&c缓冲套件&r 用于铺设在 &6轨道&r 的末端，可以让矿车停下且不会再次启动。\n&c栅栏门套件&r 则会部署一个与 &6轨道&r 相连的栅栏门。"]
	quest.249E5C6893387E15.title: "&c轨道套件&r，用于让 &7矿车&r 停下"
	quest.283AB56F81EF03A5.quest_desc: ["为了给你的 &6电力铁轨&r 和 &e电力机车&r 提供动力，你需要使用 &e框架。框架&r 需要通电，并将动力传递给每个与之相连的 &e框架&r。"]
	quest.283AB56F81EF03A5.title: "&e框架"
	quest.2869AB982799CF0C.quest_desc: ["&c单向轨道套件&r 的原理很简单。&7矿车&r 只能朝着箭头所指的方向行驶。"]
	quest.2869AB982799CF0C.title: "&c轨道套件&r 单向"
	quest.2A30595DC6DDBFF7.quest_desc: [
		"&6电力铁轨&r 用于 &e电力机车&r。它们需要由 &e框架&r 提供动力，而且如果你触摸它，是会受伤的。"
		"{image:atm:textures/questpics/railcraft/rail_electric_rail.png width:150 height:100 align:center}"
	]
	quest.2A30595DC6DDBFF7.title: "&6电力轨道"
	quest.2AB0FA084739827A.quest_desc: ["要实际使用 &9隧道掘进机&r，你需要一个 &9隧道掘进机钻头&r。\n\n钻头共有 4 种不同样式，其挖掘能力取决于 &9钻头&r 的类型。\n\n它可以附魔，并且有耐久度，所以你最好给它附魔！"]
	quest.2AB0FA084739827A.title: "&9隧道掘进机、钻头"
	quest.2D00F85379A4D591.quest_desc: ["物品装载器是 RailCraft 中最基础的投掷装置。它必须放置在 &6轨道&r 的上方，并且可以配置为将你想要的物品装载到下方的 &7矿车&r 中。"]
	quest.2D00F85379A4D591.title: "物品装载器"
	quest.31094CC16E710040.quest_desc: ["&4撬棍&r 是 RailCraft 的主要工具。\n\n当对 &5机车&r 使用时，它会改变机车的朝向。\n\n当按住 Shift 键并点击时，你可以连接 &5机车&r 和 &7矿车&r。\n\n当仅对 &7矿车&r 使用时，它会轻轻推动矿车。\n\n而当对特殊轨道使用时，它会改变轨道的模式。\n\n不同的 &4撬棍&r 只是外观和伤害值不同。"]
	quest.31094CC16E710040.quest_subtitle: "\"什么，你想抢劫我吗？\""
	quest.365D4B1DC953D406.quest_desc: ["&7矿车&r 投掷器正如其名。它可以将任意 &7矿车&r 投掷到前方的 &6轨道&r 上。需要红石信号才能投掷。"]
	quest.365D4B1DC953D406.title: "&7矿车&r 投掷器"
	quest.38451B61E3FC075B.quest_desc: [
		"等等，我们又有了钢，那是不是意味着我们的（煤）焦炭也能回来了？是的！\n要获得（煤）焦炭，你需要一个焦炭窑。要制作一个，你需要 26 个焦炭窑砖，并将它们以 3x3x3 的方式摆放，中心留空一个方块。当你能够访问 GUI 并且它呈现出统一的纹理时，就说明制作完成了。\n\n放入煤炭或煤炭块即可获得（煤）焦炭和液态煤焦油！你也可以随时放入任意原木来获取木炭和煤焦油。"
		"{image:atm:textures/questpics/railcraft/rail_coke.png width:100 height:100 align:center}"
	]
	quest.38451B61E3FC075B.title: "焦炭窑"
	quest.3E75AFE3482834C5.quest_desc: ["&lRailCraft&r 是一个完全基于&5火车&r的模组！\n\n从&7矿车&r到&e电力机车&r，再到&9隧道掘进机&r！它在&5火车&r配件方面也应有尽有！交通信号灯、为&5火车&r提供动力的蒸汽锅炉，以及实现这一切的自动化系统。\n\n这是专为&5火车&r模型爱好者打造的模组！"]
	quest.3E75AFE3482834C5.title: "&7&lRailCraft"
	quest.3E8C2E7769DFBF35.quest_desc: [
		"与&3蒸汽机车&r不同，你无需向&e电力机车&r中添加任何东西。\n\n它通过&e电力机车轨道&6下方的&r框架&e获取电力。\n\n是的，它只能由&6电力机车轨道&r驱动。"
		"{image:atm:textures/questpics/railcraft/rail_electric.png width:100 height:100 align:center}"
	]
	quest.3E8C2E7769DFBF35.title: "&e电力机车"
	quest.4071BBBE12CACD2D.quest_desc: ["&5火车&r分配器是&7矿车&r分配器的升级版。它可以分配整个&5机车&r以及更多物品！为你想要部署的物品设置一个模式，然后给它一个红石信号。"]
	quest.4071BBBE12CACD2D.title: "火车分配器"
	quest.425E375A9EC127EB.quest_desc: [
		"&6加固铁轨&r是普通&6铁轨&r的升级版本！它们速度稍快，而且不会爆炸。"
		"{@pagebreak}"
		"1"
		"{image:atm:textures/questpics/railcraft/rail_reinforced1.png width:150 height:100 align:center}"
		"{@pagebreak}"
		"2"
		"{image:atm:textures/questpics/railcraft/rail_reinforced2.png width:150 height:100 align:center}"
		"{@pagebreak}"
		"3"
		"{image:atm:textures/questpics/railcraft/rail_reinforced3.png width:150 height:100 align:center}"
		"{@pagebreak}"
		"4"
		"{image:atm:textures/questpics/railcraft/rail_reinforced4.png width:150 height:100 align:center}"
	]
	quest.425E375A9EC127EB.title: "&6加固铁轨"
	quest.475E307844E3AF7F.quest_desc: [
		"烧水机是 &l&7RailCraft&r 中最有用的机器之一。它们需要一个燃料火箱和顶部的某种锅炉。燃料火箱可以是 1x1、2x2 或 3x3 的尺寸。火箱的大小决定了顶部锅炉的尺寸。对于 1x1 的火箱，只能搭配 1x1 的锅炉。对于 2x2 的火箱，可以搭配 2x2x3 的锅炉。对于 3x3 的火箱，可以搭配 3x3x4 的锅炉。液体燃料需要使用杂酚油来加热。对于固体燃料火箱，则可以使用熔炉能使用的任何燃料。"
		"{image:atm:textures/questpics/railcraft/rail_big_boiler.png width:100 height:100 align:center}"
	]
	quest.475E307844E3AF7F.title: "锅炉"
	quest.4A44623D8A307473.quest_desc: [
		"&6高速电气轨道&r 就像 &6电气轨道&r 一样，但速度更快！它们既需要普通 &6高速轨道&r 所需的组件，也需要 &6电气轨道&r 所需的组件。还需要 &c速度增幅器&r 和 &e框架&r 来为其供能。现在，你在经过弯道和接触轨道时必须小心！"
		"{image:atm:textures/questpics/railcraft/rail_electric_speed.png width:150 height:100 align:center}"
	]
	quest.4A44623D8A307473.title: "&6高速电气轨道"
	quest.50A286C268F38E09.quest_desc: ["我做这个任务页时，花了很多时间给文字上色，想帮助玩家你理解我在引用什么。但后来我发现这可能会让人更困惑，所以这里有一份图例！\n\n&5紫色&r代表任何火车或机车，包括电力机车、蒸汽机车以及它们连接的车厢。\n&6金色&r代表任何轨道和铁轨，包括特殊铁轨，但不包括轨道套件。\n&c浅红色&r代表任何轨道套件。\n&4深红色&r代表撬棍。\n&3青色&r仅代表蒸汽机车。\n&e黄色&r仅代表电力机车。\n&9蓝色&r代表隧道掘进机。\n&7灰色&r代表矿车和特殊车厢。"]
	quest.50A286C268F38E09.title: "颜色图例"
	quest.5128B119DFFF0C4C.quest_desc: [
		"&3蒸汽机车&r是最基础的&5机车&r。给它加水、添加熔炉燃料并等待，它就能获得动力。它需要持续加水才能保持运行。\n\n别担心，这仅仅意味着从它顶部冒出的烟是水蒸气，对环境是安全的。好吧，煤炭部分对环境可就不友好了……唉，这是&2《我的世界》&r，我们管那么多干嘛！"
		"{image:atm:textures/questpics/railcraft/rail_steam_locomotive.png width:100 height:100 align:center}"
	]
	quest.5128B119DFFF0C4C.title: "&3蒸汽机车"
	quest.5180CDD196518F64.quest_desc: [
		"&6铁带轨道&r和&6废弃轨道&r一样，都是为省钱达人量身打造的。它们比其他&6轨道&r慢得多，但完全不用担心脱轨！"
		"{image:atm:textures/questpics/railcraft/rail_strap.png width:150 height:100 align:center}"
	]
	quest.5180CDD196518F64.title: "&6铁带轨道"
	quest.53594EBA9F7BA840.quest_desc: ["高级物品卸载器和普通版本一样，但可以从任意方向使用。除了方向之外，别无二致。"]
	quest.53594EBA9F7BA840.title: "高级物品卸载器"
	quest.541D270451DA4320.quest_desc: ["切换轨道用于在不同特殊&6轨道&r之间切换车道。轨道上的箭头指明了各条路径的走向。"]
	quest.54F2CB52D3A7BA87.quest_desc: ["物品卸载器与物品装载器相反。它会将物品从&7矿车&r中取出。这个装置也必须放置在&6轨道&r的上方。"]
	quest.54F2CB52D3A7BA87.title: "物品卸载器"
	quest.55D7CD0FA8F1AE48.quest_desc: ["我们齐聚于此的原因，&5火车&r。这个模组就叫&l&7RailCraft&r，可别一副惊讶的样子。\n\n这里有 2 种不同的主&5火车&r，以及 1 种特殊的采矿&5火车&r。\n\n这些&5火车&r自己跑可能会有点无聊，所以为什么不给他们挂上&7矿车&r呢！将&7矿车&r与&7矿车&r以及&5火车&r连接起来的操作叫做“挂钩”，而将它们分离的操作则叫做“脱钩”。要连接&5火车&r和&7矿车&r，请使用&4撬棍&r，或使用带有挂钩&c轨道套件&r的&6轨道&r。"]
	quest.55D7CD0FA8F1AE48.title: "&7&l矿车&r 'N' &5&l火车&r！"
	quest.5820EDEF71340A1A.quest_desc: [
		"&6废弃轨道&r对吝啬鬼和追求美观的玩家来说很不错。它们可以在没有支撑的情况下横跨几个方块。但它们只能与同向方块相距 2 个方块，或与反向方块相距 1 个方块。不过，这存在脱轨的风险，基本上你的 &7矿车&r 会被甩出 &6铁轨&r。"
		"{image:atm:textures/questpics/railcraft/rail_abandoned.png width:150 height:100 align:center}"
	]
	quest.5820EDEF71340A1A.title: "&6废弃轨道"
	quest.5E750DB2244A67A1.quest_desc: [
		"&6道岔轨道&r是第一种通过用尖刺锤敲击 &6轨道&r获得的轨道。它可以让矿车朝两个方向行驶：向前或向侧面。可以通过轨道旁的切换器来切换方向。"
		"{image:atm:textures/questpics/railcraft/rail_turnout.png width:100 height:100 align:center}"
	]
	quest.5E750DB2244A67A1.title: "&6道岔轨道"
	quest.5F458D79D43D8842.quest_desc: ["本任务由 &6AllTheMods 工作人员&r或 &2社区贡献者&r编写，供 AllTheMods 整合包使用。\n\n由于所有 &6AllTheMods&r 整合包均遵循 &e保留所有权利&r许可协议，未经 &6AllTheMods 团队&r明确许可，本任务不得用于任何非其发布的公开整合包。\n\n本任务被刻意隐藏，如果你能看到此内容，说明你正处于编辑模式。"]
	quest.609CA1ACFA981BD5.quest_desc: ["&c轨道套件&r与过路车票配合使用。"]
	quest.609CA1ACFA981BD5.title: "&c轨道套件&r 轨道铺设"
	quest.61C93ABE07742DCD.quest_desc: [
		"蒸汽涡轮机利用蒸汽来生产 FE 和 EU 能量。\n\n它是由 3x2x2 个蒸汽涡轮机外壳组成的建筑，内部需要一个涡轮机马达，并且需要接入蒸汽管道。"
		"{image:atm:textures/questpics/railcraft/rail_turbine.png width:100 height:100 align:center}"
	]
	quest.61C93ABE07742DCD.title: "蒸汽涡轮机"
	quest.64C105E1E2F97900.quest_desc: ["道岔锤用于在普通 &6铁轨&r 上切换其模式。对于尝试建造交叉口非常有帮助！"]
	quest.64C105E1E2F97900.title: "'切换它们吧'"
	quest.677C5D35DADA4A42.quest_desc: ["&c连接器&r用于连接或分离 &7矿车&r。连接是指将 &7矿车&r 接在一起。\n\n它可以用 &4撬棍&r 进行配置，以实现连接、分离或自动连接。需要红石才能工作。"]
	quest.677C5D35DADA4A42.title: "&c轨道套件&r 连接器"
	quest.6C14D1B60124C2B2.quest_desc: [
		"&9隧道掘进机&r非常适合自动铺设 &6铁轨&r，尤其是在山脉或丘陵下方。\n\n它需要 3 样东西才能开始工作：&9掘进头&r、煤炭等燃料，以及 &6铁轨&r。一旦集齐这 3 样东西，就可以让它开始工作了！\n\n记得留意放入其中的物品！"
		"{image:atm:textures/questpics/railcraft/rail_tunnel.png width:100 height:100 align:center}"
	]
	quest.6C14D1B60124C2B2.title: "&9隧道掘进机"
	quest.6C163E005351FF6D.quest_desc: ["当 &c汽笛套件&r 被红石激活时，会使 &5机车&r 吹响汽笛。"]
	quest.6C163E005351FF6D.title: "&c轨道套件&r 哨子"
	quest.6DB65926EE6D6C2E.quest_desc: ["这些 &c轨道套件&r 用于通过 &7矿车&r 改变动量。\n\n&c过渡套件&r 可以改变经过的 &5机车&r 的速度，需要红石充能。\n&c加速套件&r 在充能时会加快 &7矿车&r 的速度，未充能时则会减慢 &7矿车&r 的速度。\n&c控制套件&r 会给 &7矿车&r 一个小小的推力，充能后会改变其推力的方向。\n&c节流套件&r 会将经过的 &5机车&r 的速度更改为预设值，需要红石充能。\n&c发射套件&r 会字面意义上地将你的 &7矿车&r 抛射出去！"]
	quest.6DB65926EE6D6C2E.title: "&c轨道套件&r 用于移动 &7矿车&r"
	quest.6E7C4228CD2B6BB9.quest_desc: ["这把 &4撬棍&r 有几种不同的模式，每种模式都会改变 &5机车&r 的外观。默认模式在将物品悬停在背包中时会进行描述；“无”模式会变为 &7灰色&r；&6H&r&5a&r&6l&r&5l&r&6o&r&5w&r&6e&r&5e&r&6n&r 模式会让它变得阴森恐怖；而 &cC&r&2h&r&cr&r&2i&r&cs&r&2t&r&cm&r&2a&r&cs&r 模式则会让它充满节日气氛！"]
	quest.75DD345164EE5CD9.quest_desc: [
		"&6高速轨道&r 类似于 &6加固轨道&r，但显然速度更快。不过它们需要 &c轨道套件&r 来帮助提升速度！过弯时也要小心。"
		"{image:atm:textures/questpics/railcraft/rail_speed.png width:150 height:100 align:center}"
	]
	quest.75DD345164EE5CD9.title: "&6高速轨道"
	quest.78D8F40AA9568511.quest_desc: ["动力滚压机是手动滚压机的升级版。\n\n你无需一直盯着机器来制作物品，它会自动将所有物品都制作完成。\n\n唯一的问题是它需要动力！"]
	quest.7D40B80DBBC4E160.quest_desc: ["手动滚压机将成为你制作 Railcraft 各种材料的小工具！\n\n当你放入配方且它能制作多个物品时，它会在你注视期间自动制作。如果你在制作过程中离开滚压机，制作就会中断，并将物品放入你的物品栏中。\n\n你必须手动完成最后一个配方的制作！"]
	quest.7F187E291C3D5BA7.quest_desc: ["流体卸载器与流体装载器正好相反。它不是位于&6轨道&r上方，而是在下方。它不是给&3蒸汽机车&r加水，而是抽取它们的水。我不知道你为什么想要这么做，但你可以试试！"]
	quest.7F187E291C3D5BA7.title: "流体卸载器"
	quest.7F4B734CFB0F0306.quest_desc: ["这些新的&7矿车&r与特殊的&2原版&r&7矿车&r类似。&7带罐体的矿车&r可以容纳并运输其中的任何液体。而&7带能量电池的矿车&r则可以容纳并运输能量！"]
	quest.7F4B734CFB0F0306.title: "新矿车"
