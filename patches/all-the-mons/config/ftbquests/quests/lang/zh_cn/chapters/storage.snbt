	quest.46D756F4DC6CC894.title: "&d下界合金背包"
	quest.485D5664A17E16DF.quest_subtitle: "x8 储物升级"
	quest.485D5664A17E16DF.title: "&6铜质升级"
	quest.4A854CD5EC70733E.quest_desc: ["为背包添加一个合成台 GUI。"]
	quest.4B62AF0405F68041.quest_desc: ["添加一个过滤器，让你可以告诉背包需要常备哪些物品。按住 Shift 右键点击物品栏即可为其补充物品。"]
	quest.4B62AF0405F68041.quest_subtitle: "全部备齐"
	quest.4C0BDD483CCB40C4.title: "&b钻石箱子"
	quest.4C0EAB9F795686D0.quest_subtitle: "更多过滤选项"
	quest.4C0EAB9F795686D0.title: "&e高级存入升级"
	quest.4C2A60FC1F1E0328.quest_desc: ["为背包添加一个电池。"]
	quest.4E4C8BCD45766F03.quest_desc: ["这个抽屉会自动将放入其中的物品转换为压缩形态。"]
	quest.4E4C8BCD45766F03.quest_subtitle: "自动压缩/解压"
	quest.508A8366219175FE.quest_desc: ["配置工具用于锁定抽屉，使其记住内部的物品。\n\n当你设置一个从抽屉存取物品的系统时，这会很有用。被锁定的抽屉不会替换掉已锁定的物品！"]
	quest.52672B7FFFD51D16.quest_desc: ["为背包添加一个切石机 GUI。"]
	quest.53F861876B991C36.quest_desc: ["为背包添加一个唱片机 GUI。"]
	quest.53F861876B991C36.quest_subtitle: "这下嗨起来了"
	quest.544791880F315D5A.quest_desc: ["带箱子的船就是船上带有箱子的船。你可以在船里打开箱子，也可以右键点击它。一次只能有一个人乘坐这艘船。"]
	quest.56B80A7EBFE21428.quest_subtitle: "更多过滤选项"
	quest.56B80A7EBFE21428.title: "&e高级泵升级"
	quest.57CF8C6C867B9BDA.quest_subtitle: "更多过滤选项"
	quest.57CF8C6C867B9BDA.title: "&e高级过滤器升级"
	quest.58514FDE153FD971.quest_subtitle: "铁箱？"
	quest.58514FDE153FD971.title: "&f铁箱"
	quest.5A94A2664BFDD7B9.quest_desc: ["欢迎来到基础存储章节！\n\n你将在这里找到所有无需能源即可存储物品的基础方法，以及满足你存储需求的实用物品！"]
	quest.5A94A2664BFDD7B9.title: "基础存储"
	quest.5E4BC0F59C90433A.quest_desc: ["精致存储允许你用金属升级箱子和木桶，以增加它们的存储容量！你还可以添加升级来提升它们的功能性。\n\n这些箱子就像原版游戏中的箱子或木桶一样，但它们有一个用于存储升级的插槽！"]
	quest.5E4BC0F59C90433A.quest_subtitle: "\"原版箱子\""
	quest.5E4BC0F59C90433A.title: "精致存储"
	quest.5E4FE420B6D2C97F.quest_desc: ["将背包中的物品按照其 3x3 合成配方进行压缩。"]
	quest.5E4FE420B6D2C97F.quest_subtitle: "更多过滤选项"
	quest.5E4FE420B6D2C97F.title: "&e高级压缩升级"
	quest.5FA9BC0D8476D322.quest_desc: ["自动从背包中取出食物喂给你。"]
	quest.615B9062FE8CCD36.quest_desc: ["自动切换到最适用于你当前所看方块的工具。"]
	quest.61A22707DBC83818.quest_desc: ["当与存储控制器连接时，存储访问点会充当存储控制器，可以从中推入或从中拉出物品。它基本上是抽屉的一个入口点。"]
	quest.668C313FF46B6005.quest_desc: ["为背包添加一个熔炉 GUI。"]
	quest.67704F7341EDCC49.title: "&b钻石背包"
	quest.696E063016CAD1B9.quest_desc: ["为你的背包添加“碎化工作台”的合成界面。"]
	quest.6A2B2C5E2ADCE366.quest_desc: ["“精致背包”提供了可升级的背包，它们可以使用过滤器来添加实用功能！\n\n背包可以放入你的“奇物”背包槽中，并且可以被染色。"]
	quest.6A2B2C5E2ADCE366.quest_subtitle: "物品栏太小了"
	quest.6A2B2C5E2ADCE366.title: "精致背包"
	quest.6E3D53D1C4569A89.quest_desc: ["允许你在你和背包之间传输经验值。"]
	quest.6E3D53D1C4569A89.quest_subtitle: "存储经验值"
	quest.6E3D53D1C4569A89.title: "&a经验值传输升级"
	quest.6E9041744C592573.quest_desc: ["添加从“储罐升级”中传输液体的功能。"]
	quest.6FBAE89EE782DABA.quest_desc: ["当使用&a链接工具&r放置并连接到其他抽屉时，控制器会充当一个“枢纽”。\n\n如果你右键双击它，你物品栏中所有与抽屉网络有插槽的物品都会被拉取过来。\n\n当你空手时，通过潜行并右键点击控制器，可以打开升级选项卡，向这些插槽中添加普通的存储升级，以增加控制器的范围。最大范围为所有方向各40个方块，或一个80x80x80的立方体。"]
	quest.6FBAE89EE782DABA.quest_subtitle: "抽屉的大脑"
	quest.70902EF96F060672.quest_desc: ["此升级将使抽屉在所有方向上输出红石信号，信号强度表示其填充/空置程度。\n\n对于多插槽抽屉，此升级可以配置为监控哪个插槽。\n\n0 - 表示为空。\n15 - 表示为满。"]
	quest.7649D648A3688D4A.quest_desc: ["“拉取器升级”允许抽屉从任意一侧拉取物品。"]
	quest.77F241BEE9902751.quest_desc: ["“精致存储”模组中最大的箱子"]
	quest.77F241BEE9902751.quest_subtitle: "空间巨大，可供开展各种活动！"
	quest.77F241BEE9902751.title: "&d下界合金箱"
	quest.785951190FFDAA21.quest_desc: ["将背包中的堆叠数量增加 4。"]
	quest.785951190FFDAA21.title: "&e堆叠升级 2 级"
	quest.78E51D22C16C4686.quest_desc: ["存储控制器也能通过无线方式连接其他存储设备。使用存储工具即可实现：只需右键单击存储控制器进行绑定，再右键单击其他存储设备即可将它们关联起来。\n\n无线连接的传输距离与普通连接相同，均为 14 格。"]
	quest.7AE3C8134F5ED726.quest_desc: ["将背包中的堆叠数量增加 16。"]
	quest.7AE3C8134F5ED726.title: "&d堆叠升级 4 级"
	quest.7C07D6A33F7ADB02.quest_desc: [
		"这是一项背包升级，因此你可以把背包放进自己的背包里。"
		""
		"这样你就可以把背包放进背包里，以便在需要时将背包放入背包。"
	]
	quest.7C07D6A33F7ADB02.quest_subtitle: "背包里还能放背包？"
	quest.7C0F7A1B3AB9A1A1.quest_subtitle: "更多过滤选项"
	quest.7C0F7A1B3AB9A1A1.title: "&e高级填充升级"
	quest.7E9E03274A88347D.quest_desc: ["将背包中的堆叠数量增加 2。"]
	quest.7E9E03274A88347D.title: "&f堆叠升级 1 级"
	quest.7EF57BBEAA4B6B08.quest_desc: ["想要使用 &9Applied Energistics 2&r 这样的模组来创建虚拟存储吗？\n\n这些都是升级存储的好方法，但讨论一下 &eNBT 物品&r以及如何最好地存储它们也很重要。\n\nNBT 物品是带有额外标签的物品，例如附魔物品、有耐久度的物品等等。这些就是带有 NBT 标签的物品。因此，它们通常无法堆叠。\n\n当您将大量这类物品存入像 AE2 这样的存储系统时，您的存档或服务器就可能出现各种问题。\n\n因此，最好将它们存放在箱子或背包中！"]
	quest.7EFBFF5D0DA018E7.quest_desc: ["为背包中想要自动删除的物品添加一个过滤器。"]
	quest.7EFBFF5D0DA018E7.quest_subtitle: "为背包中想要自动删除的物品添加一个过滤器。"
	quest.7F990FBC1A691020.quest_desc: ["陷阱箱与普通箱子相同，只是打开时会发出红石信号，而且它们无法合并成一个。"]
	quest.7F990FBC1A691020.quest_subtitle: "\"我 wonder 这里面有什么？\""
