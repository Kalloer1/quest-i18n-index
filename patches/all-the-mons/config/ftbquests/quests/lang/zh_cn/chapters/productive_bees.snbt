	quest.177199FED92C3B5B.title: "维度蜂"
	quest.17989643018D00C1.quest_desc: ["蜂箱的滴落效果是否让你感到烦恼？如果是，那你可算走运了，因为有一个简单的解决办法。\n\n你可以在高级蜂箱的瓶子插槽中放置一块 &e海绵&r，以阻止其滴落。"]
	quest.17989643018D00C1.quest_subtitle: "你不再滴落了"
	quest.17989643018D00C1.title: "停止滴落"
