# AI 初翻，未人工校对
{
	id: "0F590B3A1FD5D993"
	group: "43BC660E3145AAE1"
	order_index: 4
	filename: "meet_your_fight"
	title: "迎接你的战斗！"
	icon: "meetyourfight:haunted_bell"
	default_quest_shape: ""
	default_hide_dependency_lines: false
	quests: [
		{
			x: -3.5d
			y: 3.0d
			shape: "hexagon"
			description: [
				"铃铛怪是《Meet Your Fight》模组添加的Boss。使用闹鬼的铃铛可以召唤它。杀死后，它会掉落1个幻象质和3-4个金锭。"
				""
				"铃铛怪漂浮在地面上，能穿过墙壁，类似于Vex。当锁定玩家时，它会试图始终保持在目标前方和上方几格的位置。"
				""
				"所有攻击都是在短暂延迟后，发射沿直线移动的投射物波。每个投射物接触时造成 8 点伤害，并能穿透墙壁。战斗中，Bellringer 会在以下两种攻击之间随机切换："
				""
				"低于50%后，它会鸣钟，使附近所有实体减速II 15秒，然后迅速向地面发射20条弹道，指向当前目标。此攻击结束后，Bellringer会恢复常规攻击，但战斗中剩余时间内每次将发射4波而非3波弹道。"
			]
			size: 1.5d
			id: "01586496C0B6EB67"
			tasks: [{
				id: "0263104BCAE479EB"
				type: "item"
				item: "meetyourfight:haunted_bell"
			}]
			rewards: [
				{
					id: "030091FB19C36FEF"
					type: "item"
					item: "randomite:randomite_ore"
				}
				{
					id: "792365B00559EB46"
					type: "xp_levels"
					xp_levels: 5
				}
				{
					id: "548AC002868995F4"
					type: "ftbmoney:money"
					ftb_money: 50L
				}
			]
		}
		{
			x: 0.0d
			y: 2.25d
			shape: "hexagon"
			description: [
				"Swampjaw 是 Meet Your Fight 添加的 boss。使用 Fossil Bait 可以召唤它。被击败后，它会掉落 1 个 Mossy Tooth、3-6 个 Bones、2-4 个 Vines 和 1-3 个 Dirt。"
				""
				"沼泽巨口通常会飞到当前目标上空，并以幻影般的速度移动，但它能看穿墙壁并从中穿过。攻击时，它会按以下顺序重复相同的模式："
				"在目标上方和周围轨道上运行几秒钟。"
				"快速移动到目标上方投下3枚地雷，这些地雷接触地面时会以TNT一半的威力爆炸，且不会破坏方块或伤害Swampjaw。"
				"俯冲以锁定目标，接触时造成 7 点伤害。过早伤害沼泽颌会取消此攻击。"
			]
			size: 1.5d
			id: "6A51E5206B5F75D4"
			tasks: [{
				id: "750587A9AF516FFB"
				type: "item"
				item: "meetyourfight:fossil_bait"
