	]
	quest.00F0052F05CF8EBE.quest_subtitle: "&8魔法建筑&r"
	quest.00F0052F05CF8EBE.title: "创建结构：放置方块&6的&r&b符文&r"
	quest.019311E9D5E55BCB.quest_desc: [
