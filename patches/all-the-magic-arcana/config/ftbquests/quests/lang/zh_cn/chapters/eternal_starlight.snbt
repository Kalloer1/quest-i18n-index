# AI 初翻，未人工校对
{
	quest.00453FF528AA0B1C.quest_desc: ["&7Lonestar Skeletons&r 是可以在任何地方生成的敌对生物。 \\n\\n它们有 10 个 &4Hearts&r，并且会向你投掷剑来攻击你。 \\n\\n死亡时，它们可以掉落 Bones、&7Deepsilver Nuggets&r 和 &7Shattered Swords&r。"]
	quest.00453FF528AA0B1C.title: "&7独行侠骷髅"
	quest.00FDBA93722ACECE.title: "&4阿玛兰伯锄头"
	quest.011FCC180FF3BD83.title: "&9马拉里特之剑"
	quest.01F322AEFCC6109E.quest_desc: ["纠缠的头骨可以掉落自……嗯，纠缠的头骨本身。 \\n\\n它们可以像凋零头颅一样，被凋零投掷出去。 \\n\\n不过，这样做会消耗掉它们。"]
	quest.02414CBEF2CD5A9D.title: "&7深海银剑"
	quest.028472D7F51D439A.title: "&aFlowglaze 镰刀"
	quest.02B574B09AB45D09.quest_desc: [
		"&bFreezes&r 的工作方式与 &cBlazes&r 类似，它们会飞上来并向你投掷球。 \\n\\n不同的是，&bFreezes&r 只会投掷1个球，并且会让你感到寒冷而不是温暖。 \\n\\n它们有 16 颗 &4Hearts&r，死亡后会掉落 &bFrozen Tubes&r。"
		"{image:atm:textures/questpics/eternal/starlight_freeze.png width:150 height:100 align:center}"
	]
	quest.02B574B09AB45D09.title: "&b冻结"
	quest.0342248394E40B6A.quest_desc: ["此任务由 &6AllTheMods Staff&r 或 &2社区贡献者&r 为 AllTheMods 整合包创作。\\n\\n所有 &6AllTheMods&r 整合包均受 &eAll Rights Reserved&r 许可，未经明确许可，不得将此任务用于非 &6AllTheMods Team&r 发布的任何公共整合包中。\\n\\n此任务被有意隐藏，若你看到此信息，则表示你处于编辑模式。"]
	quest.03B40AB768FC0161.quest_desc: [
		"&3Shimmer Rivers&r 是友善的河流。它们不会特意来杀你。 \\n\\n它们有时会连接起不同的 &bSeas&r，并穿过 Forests。 \\n\\n显然它们有 &9Water&r，而在 &9Water&r 中蕴藏着丰富的宝藏！"
		"{image:atm:textures/questpics/eternal/starlight_river.png width:200 height:100 align:center}"
	]
	quest.03B40AB768FC0161.title: "&3闪烁之河"
	quest.0576C32B0FB360B0.quest_desc: [
		"&l&9月之巨兽&r有200&4生命值&r，除非使用火焰，否则每次攻击只能造成1点伤害。 \\n\\n它会使用地面尖刺、投射物和爆炸纠缠头颅等攻击！ \\n\\n杀死它后，会掉落箭矢、锭、纠缠头骨、&9坚韧花瓣&r、&5坚韧藤蔓&r、&9灵魂露珠&r，并有几率掉落稀有武器！"
		"{image:atm:textures/questpics/eternal/starlight_lunar.png width:100 height:125 align:center}"
	]
	quest.0576C32B0FB360B0.title: "&9&l月之怪物"
	quest.061C4A9E439CE09B.title: "&9马拉里特铲子"
	quest.0688CE330DAF8714.title: "&c星火锄头"
	quest.06D3EC025557855F.title: "&7深海银斧"
	quest.0720474D384F4774.quest_desc: ["&eMarimold&r 是一种生长在水下的蘑菇。 \\n\\n你可以找到大号和小型的版本。 \\n\\n这些方块看起来像是 &6Honey&r 和 &eShroomlights&r 的混合物。"]
	quest.0720474D384F4774.title: "&eMarimold"
	quest.0854589F28AAA8D0.title: "&d星光钻石锄头"
	quest.09981C89C585002E.title: "&b冰川头盔"
	quest.09C3C0F0278C842F.title: "&4Amaramber 胸甲"
	quest.0BB8D556305EB307.quest_desc: [
		"以太河流，你看到它的时候就会知道。 \\n\\n它很亮，非常亮，地图上可能显示为红色，那是个bug，忽略即可。"
		"{image:atm:textures/questpics/eternal/starlight_ether.png width:200 height:100 align:center}"
	]
	quest.0BB8D556305EB307.title: "以太河流"
	quest.0C096EE635645E43.quest_desc: ["&d水晶&b弩&r的制造方式与&7机械&3弩&r相同，只是用&b水晶&r代替了木棍。 \\n\\n它能发射箭矢，伤害与普通弩相同，但会施加水晶感染。水晶感染每秒造成1点伤害，并且会杀死被感染的生物！"]
	quest.0C096EE635645E43.title: "&d水晶&b十字弓"
	quest.0CFAAF6F13EB6C2C.title: "&c星火之锤"
	quest.0D1C143B2C788204.quest_desc: ["&5Seekers&r 是一种敌对生物，会出现在任何有 &9&l星光&r 的地方。 \\n\\n它们有 12.5 个 &4心&r，并且会四处飞行。 \\n\\n它们会飞到近处，用舌头攻击你。 \\n\\n&5Seekers&r 也是刷取 &5Seeking Eyes&r 的好方法！"]
	quest.0D1C143B2C788204.title: "&5寻踪者"
	quest.0D427BD581ADC3A6.title: "&aFlowglaze 镐"
	quest.0E1C2DA415D5742D.title: "&b冰川之剑"
	quest.0F0D41F29386333A.quest_desc: ["&d绯红木树&r的大小和形状各不相同，有时甚至会倒下！ \\n\\n但它们都有&d粉红色的叶子&r！包括地上的那些。"]
	quest.0F0D41F29386333A.title: "&d绯红树木"
	quest.0F4783FA019C4567.quest_desc: ["&4Amaramber&r 可通过剥取 &cTorreya Logs&r 稀有地获得。 \\n\\n它可以被制成锭来制作盔甲和工具，或用于其他配方，例如篝火，它会让你恢复生命！"]
	quest.0F4783FA019C4567.title: "&4阿玛兰伯"
	quest.0F812AE4F247FF1C.title: "&b冰川胸甲"
	quest.0F8955B74DBDF5F9.title: "&c星火镰刀"
	quest.0FE15701F2EDC3E9.quest_desc: ["将&5Aethersent Block&r和&5Lunaris Cactus Fruit&r堆叠起来，就能制作出&5Aethersent Golem&r！\\n\\n这个猛男只有一个任务，那就是阻止&5Creteor&r在&5Meteor Showers&r中生成。\\n\\n如果出现&5Meteor Shower&r，他会在它们生成前就将其击落！"]
	quest.0FE15701F2EDC3E9.title: "&5以太感应哥布林"
	quest.10AB188AC6FB24D3.quest_desc: [
		"&b&l星光哥布林&r拥有220个&4生命&r和2种模式。 \\n\\n第一种是攻击模式，此时他无法被伤害，你必须等待他的攻击结束后才能攻击。他会用火球、重击或毁灭性的激光束来攻击！ \\n\\n第二种是充能模式，此时他会开始从能量方块中吸取能量，必须关闭这些方块才能对他造成伤害。 \\n\\n死亡后，他会掉落大量锭和箭、&b哥布林钢&r、锻造盔甲饰件，甚至还有可能掉落能量之剑！"
		"{image:atm:textures/questpics/eternal/starlight_golem.png width:150 height:100 align:center}"
	]
	quest.10AB188AC6FB24D3.title: "&b&l星光傀儡"
	quest.10D78DC368E16987.title: "&aFlowglaze 斧头"
	quest.11783E5EF07481C3.title: "&aFlowglaze 弓"
	quest.127D085D6C9DB690.quest_desc: ["&e硝石&r可以在任何地下地方找到，但在&d暖岸&r生物群系中尤为常见。 \\n\\n挖掘它需要一把石质镐，挖掘后会掉落一些&e硝石粉&r。是的，时运附魔对它有效！ \\n\\n&e硝石粉&r可以替代其他含氮物品使用。"]
	quest.127D085D6C9DB690.title: "&e硝石粉"
	quest.144ECED643031A9A.quest_desc: ["发光蘑菇是你在绯红森林里能找到的巨型蘑菇植物！\\n\\n它们的功能和普通棕色或红色蘑菇一样，只是亮度要高得多！\\n\\n（你可能不知道，棕色和红色蘑菇其实会发出亮度为1的光源）"]
	quest.15195F456D8AD4C8.quest_desc: ["当以太接触到&9水&r时，会形成&a硫石英&r。这可以通过自然生成随机出现，或者你也可以人为制造！ \\n\\n不过，这并不是我们获取碎片的方法，碎片来自&a硫石英的结晶&r！"]
	quest.15195F456D8AD4C8.title: "&a硫石英"
	quest.1533D98B3B2A758E.quest_desc: ["&7破碎之剑&r可以来自&7独行骷髅&r掉落，或使用掉落的&7剑刃&r合成。\\n\\n&7破碎之剑&r更像三叉戟而非普通剑，你可以通过投掷来攻击。右键可以像忠诚三叉戟一样召回&7剑刃&r，再次右键可重新装填。"]
	quest.1533D98B3B2A758E.title: "&7破碎之剑"
	quest.17A8E4151DE37015.quest_desc: ["要制作 &cStarfire&r 工具和武器，你首先需要 &6Thermal Springstone&r 工具来升级。然后是 &cUpgrade Template&r。 \\n\\n&cStarfire Upgrade Template&r 可以在 Boss 建筑中找到：&9Cursed Garden&r 和 &bGolem Forge&r。"]
	quest.17A8E4151DE37015.title: "&c星火模板"
	quest.17D82EEA20D02EC8.quest_desc: ["海底铺着 &bSea&r 底的 &5Dusted Gravel&r。 \\n\\n它可以替代普通的 &7Gravel&r，偶尔会掉落 &5Dusted Shards&r，用来制作其他方块！"]
	quest.17D82EEA20D02EC8.title: "&5蒙尘的砾石"
	quest.17EC65B33AC5F0B4.quest_desc: [
		"&8口渴行者&r是中立生物，会生成在&5结晶沙漠&r的表面。 \\n\\n被激怒时，它们会攻击你并使你产生饥饿。 \\n\\n它们有20个&4心脏&r，死亡时会掉落&8饥饿之牙&r。"
		"{image:atm:textures/questpics/eternal/starlight_thirst.png width:100 height:125 align:center}"
	]
	quest.17EC65B33AC5F0B4.title: "&8口渴的行者"
	quest.1815A439BA9879B7.quest_desc: [
		"&d暖岸&r是一个相当无聊的生物群，主要用于连接&b星光之海&r和陆地。\\n\\n这里有下方的石头和&d暮光沙&r。我还比平时更多地找到了&e硝石&r。"
		"{image:atm:textures/questpics/eternal/starlight_shore.png width:200 height:100 align:center}"
	]
	quest.1815A439BA9879B7.title: "&d温暖的海岸"
	quest.18AA0B2E9C3B912A.quest_desc: ["这是一只&9蜗牛&r。 \\n\\n它会掉落外壳和肉。"]
	quest.18AA0B2E9C3B912A.title: "&9暗影蜗牛"
	quest.19B8871B701F11F4.title: "&d星光钻石镐"
	quest.19F7BAD1150A2107.quest_desc: ["&c星火&r！ \\n\\n不，不是像《少年泰坦》里的那种。这是一种可以用来制作工具和武器的材料，或者……"]
	quest.19F7BAD1150A2107.title: "&c星之火"
	quest.1A95BFE57029F9C4.quest_desc: ["没拿到Tuff Golem很失望？别担心，我们有&7Grimstone Golem&r！\\n\\n它能做完全相同的事，就是站在那里拿着一个方块或物品。\\n\\n只需将&5Lunaris Cactus Fruit&r放在&7Grimstone Bricks&r上，你就能得到它。"]
	quest.1A95BFE57029F9C4.title: "&7格雷夫斯石像鬼"
	quest.1AAFC306507DFCF8.title: "&b冰川石镰刀"
	quest.1AB17923F87AE264.quest_desc: [
		"雪人这个名字会让所有探索寒冷之地的人感到恐惧！这是一种生活在最严酷寒冷气候中的毛茸茸的怪物，会吃掉任何胆敢闯入的家伙！ \\n\\n不过这些雪人除外，它们很可爱也很友好！它们宁愿打滚也不愿吃掉你。 \\n\\n它们甚至不会还手，生命值也只有 10 &4心&r。 \\n\\n死亡时会掉落它们的皮毛和线，皮毛可以作为羊毛的替代品使用。"
		"{image:atm:textures/questpics/eternal/starlight_yeti.png width:100 height:100 align:center}"
	]
	quest.1AB17923F87AE264.title: "雪怪 Yetis"
	quest.1AFCA421A6A50DA4.quest_desc: ["&aFlowglaze 升级模板&r也生成于首领结构：&9诅咒花园&r和&bGolem 锻造炉&r。 \\n\\n你需要将&aFlowglaze&f和&a升级模板&f应用到&bGlacite &f上，以制作&aFlowglaze 武器&r。"]
	quest.1AFCA421A6A50DA4.title: "&aFlowglaze 模板"
	quest.1C863B4BC6EAD1CD.title: "&9马拉里特镰刀"
	quest.1E7B5CDF0D5F833F.title: "&7深海银镐"
	quest.1EA98CFE85035939.title: "&5Aethersent Bottoms"
	quest.1ECD4331DDFBBB52.quest_desc: ["&cTorreya Trees&r 是巨大的紫/粉色树木，高度约为40格。 \\n\\n树叶会向各个方向生长，而 &eTorreya Vines&r 则从上面垂下。"]
	quest.1ECD4331DDFBBB52.title: "&c托雷亚树 (Torreya Trees)"
	quest.20D705C99BD11F18.title: "&c星火斧头"
	quest.252AD9C886DE45C8.quest_desc: [
		"&9Twilight Gaze&r 是一种中立鱼类，栖息在 &5The Abyss&r 中。 \\n\\n如果你攻击了一只，所有同类都会攻击你，就像狼或僵尸猪人一样。如果你离 &5The Abyss&r 太远，它们会停止跟随你并游回深处。 \\n\\n它们死亡后不会掉落任何东西，所以最好还是不要攻击它们……"
		"{image:atm:textures/questpics/eternal/starlight_gaze.png width:150 height:100 align:center}"
	]
	quest.252AD9C886DE45C8.title: "&9暮色凝望"
	quest.2583E4890619044E.title: "&6温泉石剑"
	quest.25B45E8FBC9705B3.title: "&d星光钻石斧"
	quest.25E782DB4309A1B8.quest_desc: ["&3极光鹿角&r是&3极光鹿&r死亡时掉落。 \\n\\n它可以用作剑或锄头。"]
	quest.25E782DB4309A1B8.title: "&3极光鹿角装饰品"
	quest.271A112ABDD923A6.quest_desc: ["和普通的海枣一样，但这些并不难看。"]
	quest.271A112ABDD923A6.title: "&9百因树 (Banyin Trees)</c1>"
	quest.27D8E62556F7CE8D.title: "&6温泉石锄头"
	quest.282AEEC832FFC8D7.title: "&4阿玛兰伯斧头"
	quest.2872C4229702B077.title: "&b冰川镐"
	quest.29283BF1B6ED3634.quest_desc: ["The &7Mechanical &3Crossbow&r is made like a normal Crossbow just with &bGolem Steel&r. \\n\\nIt works like a normal Crossbow just much stronger! And can be enchanted to do even more!"]
	quest.29283BF1B6ED3634.title: "&7机械&3弩"
	quest.298963543B99734E.quest_desc: ["&bStarlit Seas&r 会生成它们自己的珊瑚版本！ \\n\\n可别像我一样，忘了用丝绸之触来采集它们……"]
	quest.298963543B99734E.title: "珊瑚方块"
	quest.29A1E1FF02BD9219.quest_desc: [
		"一片如海洋般蔚蓝的&3森林&r。\\n\\n&3星光森林&r是&9&l星光世界&r中最常见的生物群系。\\n\\n数十棵&3月亮树&r遍布其中，树下栖息着大量中立和敌对的生物。"
		"{image:atm:textures/questpics/eternal/starlight_forest.png width:200 height:100 align:center}"
	]
	quest.29A1E1FF02BD9219.title: "&3星光森林"
	quest.29EC143D7E0347DE.quest_desc: ["&8饥饿匕首&r是用&8饥饿之牙&r制作的。不，我可不是说牙齿。 \\n\\n&8匕首&r有一个饥饿值。攻击生物时会上升，不活动时则会下降。达到100%时会获得增益，而降到0%时则会开始伤害你。 \\n\\n攻击生物（或玩家）时，它还会施加饥饿效果。 \\n\\n我可不怪它，我饿的时候也会生气。"]
	quest.29EC143D7E0347DE.title: "&8饥饿匕首 (Dagger of Hunger)"
	quest.2A14A47E40A97329.title: "&a炼金术士面具"
	quest.2D457E53BB6D63C7.quest_desc: [
		"海拔最高的&9&l星光&r之地是位于山脉之上的永久冻原森林。 \\n\\n地处高海拔，这里异常寒冷，覆盖着厚厚的冰雪！ \\n\\n不过，友善的生物们似乎很喜欢这种寒冷！"
		"{image:atm:textures/questpics/eternal/starlight_permafrost.png width:200 height:100 align:center}"
	]
	quest.2D457E53BB6D63C7.title: "永久冻原森林"
	quest.2DA8CE213AC3869B.quest_desc: ["&b星光&d水晶&r遍布各处，甚至在&5结晶沙漠&r下也能找到。 \\n\\n它们和&5紫水晶&r的作用相似，听起来也像！"]
	quest.2DA8CE213AC3869B.title: "&b星光 &d水晶"
	quest.2E29DC243E8AD61E.quest_desc: [
		"&9Shimmer Lacewings&r 不会做任何事，也不会掉落任何东西，它们只是增添氛围。 \\n\\n它们还长得像我唯一能容忍的昆虫！"
		"{image:atm:textures/questpics/eternal/starlight_shimmer.png width:150 height:100 align:center}"
	]
	quest.2E29DC243E8AD61E.title: "&9Shimmer Lacewing"
	quest.2E9D3DA2DF3E3AC9.quest_desc: ["&5Petal &bScythe&r 会对其击中的所有目标施加中毒效果。 \\n\\nJEI 显示它能制作农田，但在游戏中却不行... \\n\\n击中 &9Water&r 时会冒出大量粒子。 \\n\\n我觉得这个物品还没完成。"]
	quest.2E9D3DA2DF3E3AC9.title: "&5花瓣 &b镰刀"
	quest.2F3E7233129F2B89.quest_desc: [
		"和发光鱼完全一样，只是头上长了一个角！"
		"{image:atm:textures/questpics/eternal/starlight_fish2.png width:100 height:100 align:center}"
	]
	quest.2F3E7233129F2B89.title: "Luminaris"
	quest.306A5B38B52F65F3.title: "&4Amaramber 镐"
	quest.3124D945A54938C2.quest_desc: ["沼泽银以前会生成在&9沼泽&r里，但现在被提升（还是降级我不知道）到随处生成，现在会在&9沼泽马拉赖特&r里生成。"]
	quest.3124D945A54938C2.title: "&9马拉里特"
	quest.315F1CB8158DFB92.title: "&5以太感应兜帽"
	quest.31DDEA54B6E81EEE.title: "&7深海银头盔"
	quest.337D376BE2653F0F.title: "&b冰川靴子"
	quest.34119FC1728B75B9.title: "&4阿玛兰伯头盔"
	quest.342EEB042DEC2B8C.quest_desc: ["岩浆和间歇泉都生成在&5深渊&r的底部。 \\n\\n岩浆能帮你下到深处，还能帮你保持呼吸。 \\n\\n间歇泉看起来就很酷！"]
	quest.342EEB042DEC2B8C.title: "岩浆与间歇泉"
	quest.34D7CA6F99B29C87.title: "&2空气囊面具"
	quest.362F4CFD1B8B12B1.quest_desc: ["所有生物在以太中都会像掉进岩浆一样死亡。有趣的是，你居然可以用桶把它装起来！\\n\\n唯一获得它的方法是在以太河中寻找。\\n\\n当水接触到以太时，会形成&a硫石英方块&r！"]
	quest.36BCCF7395658A5C.quest_desc: ["&9&l星光&r中的首领们生活在各自的建筑里。幸运的是，它们并不常见，所以你可能需要帮手，也就是“寻踪之眼”。\\n\\n“寻踪之眼”的用法和&a末影之眼&r类似，右键使用即可投掷，跟随它们就能找到建筑。\\n\\n要定位建筑，你需要在副手拿着特定物品，例如……"]
	quest.36BCCF7395658A5C.title: "寻找首领们"
	quest.37355F60E45777FE.quest_desc: ["&3预言之球&r可以通过击败&7&l守门人&r来制作或获取！ \\n\\n它的主要用途是激活传送门，但它还会有更多用途！"]
	quest.37355F60E45777FE.title: "&3预言之球 (Orb of Prophecy)"
	quest.373CA701008A9584.quest_desc: ["要制作&4枯萎的弩&r，需要击杀&9&l月之怪物&r和&b&l星光傀儡&r。\\n\\n&4枯萎的弩&r和普通弩一样，只是每支箭都会造成凋零和迟缓效果。"]
	quest.373CA701008A9584.title: "&4枯萎的十字弓"
	quest.375F0A098589CF29.quest_desc: [
		"使用Seeking Eyes时，你可能会困惑它们为何突然遁入地下。这可能是因为&bGolem Forge&r位于地下深处，比如在负Y坐标层级。 \\n\\n有许多蜿蜒的房间，每个都充满了战利品、&cLava&f和&bFreezes&r！我们正在寻找的房间里有&b&lStarlight Golem&r！"
		"{image:atm:textures/questpics/eternal/starlight_golemforge.png width:200 height:100 align:center}"
	]
	quest.375F0A098589CF29.title: "&bGolem Forge"
	quest.378A7484CF999F03.quest_desc: ["这些非常适合用来做迷你水下娃娃屋！\\n\\n历史上但凡有哪怕一个人也想到过这个主意……"]
	quest.378A7484CF999F03.title: "&d螺旋海带"
	quest.37E49A1A6BA0E28D.title: "&5以太感应斗篷"
	quest.38CF9E6E7490BD50.title: "&6温泉石锤"
	quest.39796595B42BB41E.quest_desc: ["&7能量&b回旋镖&r是一种由&8哥布林钢&r制成的独特武器。 \\n\\n要使用它，只需右键单击即可投掷。 \\n\\n和其他回旋镖一样，除了我投掷的那些，它会返回到你身边。大约投掷10格或击中方块后，它就会返回。 \\n\\n如果击中生物，会造成伤害并将其点燃。"]
	quest.39796595B42BB41E.title: "&7能量&b回旋镖"
	quest.3991EEEFDD263A91.quest_desc: [
		"&9Nightfall Spiders&r 和 &7Lonestar Skeletons&r 一样，是敌对的，会随处生成。 \\n\\n它们有 5 个 &4Hearts&r，通过撞击来攻击你。撞击后，它们会给你几秒钟的 Glowing 效果。 \\n\\n死亡时会掉落线和它们的眼睛！"
		"{image:atm:textures/questpics/eternal/starlight_spider.png width:100 height:100 align:center}"
	]
	quest.3991EEEFDD263A91.title: "&9夜幕降临的蜘蛛们"
	quest.3A33514BD62CD7D9.title: "&b冰川斧"
	quest.3A6C912577A615EE.title: "&d星光钻石剑"
	quest.3AFEE53B4276F8CA.quest_desc: ["终于，一把工具！ \\n\\n&3Underminer&r 是一种镐。它的特殊之处在于，Y坐标越低，挖掘速度就越快。 \\n\\n但它怎么知道自己有多低呢？"]
	quest.3AFEE53B4276F8CA.title: "&3Underminer"
	quest.3BAF4078F5776809.title: "&6温泉石胸甲"
	quest.3C37018123D3653C.title: "&2空气囊靴子"
	quest.3C74DAE7EC844A98.quest_desc: ["&3Lunar Berries&r是很好的食物来源，而且非常容易获取！ \\n\\n它们生长在&3Lunar Tree Leaves&r上，你可以像摘&eGlow Berries&r一样，从藤上摘下&3Berries&r。 \\n它们能提供更多食物值和饱腹度！"]
	quest.3C74DAE7EC844A98.title: "&3月夜浆果"
	quest.3CAD0701EC16C2D8.quest_desc: [
		"&9黑暗沼泽&r遍布于&9&l星光&r世界。 \\n\\n在这里你可以找到许多植物、动物，当然还有泥土。"
		"{image:atm:textures/questpics/eternal/starlight_swamp.png width:200 height:100 align:center}"
	]
	quest.3CAD0701EC16C2D8.title: "&9黑暗沼泽"
	quest.3D26E7BFE0AA964A.quest_desc: [
		"Luminofish 是一种生活在 &5The Abyss&r 的发光鱼。\\n\\n它们的行为和普通鱼一样。你可以钓它们，用桶装它们，甚至可以烹饪它们！"
		"{image:atm:textures/questpics/eternal/starlight_fish1.png width:100 height:100 align:center}"
	]
	quest.3D26E7BFE0AA964A.title: "发光鱼"
	quest.3D4032E7119AF8B7.quest_desc: ["&5声呐炸弹&r由&9颤动凝胶&r制成，而凝胶由&d结晶化飞蛾&r掉落。 \\n\\n可以投掷来对大片区域内的任何生物（和玩家）造成伤害！还会让玩家的屏幕晃动并播放响亮的音效。 \\n\\n这很让人迷失方向，所以只对朋友使用吧！"]
	quest.3D4032E7119AF8B7.title: "&5声呐炸弹"
	quest.3D7CEED6B974ED8C.title: "&5以太感应靴子"
	quest.40786B63E2901D11.quest_desc: [
		"让我想想怎么描述这个&9被诅咒的花园&r……这是一个巨大的迷宫！\\n\\n每边都有一个入口，你必须找到通往中央的道路，那里有&9&l月之怪物&r！\\n\\n迷宫各处都藏着装满战利品和&9纠缠物&r的箱子！"
		"{image:atm:textures/questpics/eternal/starlight_maze.png width:150 height:150 align:center}"
	]
	quest.40786B63E2901D11.title: "&9被诅咒的花园"
	quest.40C776497D68367F.quest_desc: ["Vines, &dRed &fand &bBlue Crystal Moss Carpets&r, &3Lunar Berries&r, Cave Moss, and &dRed &fand &bBlue Crystal Roots&r. \\n\\nThese can be used in your Offhand with the Seeking Eye to find the &9Cursed Garden&r."]
	quest.40C776497D68367F.title: "&9&l怪诞生物&r 物品"
	quest.41197BEBED4A9B69.title: "&7深海银锄头"
	quest.4147D247E4D754D0.quest_desc: [
		"&7Gleeches&r 是一种会出现在 &5Crystallized Desert&r 的小型生物。 \\n\\n它们会不顾一切地想要你的血，甚至会使用暴力手段。幸运的是，它们只有 4 个 &4Hearts&r！ \\n\\n死亡时，它们可能会掉落 &7Eggs&r，这些蛋可以作为投掷物使用。"
		"{image:atm:textures/questpics/eternal/starlight_gleech.png width:100 height:100 align:center}"
	]
	quest.4147D247E4D754D0.title: "&7Gleech"
	quest.41C70F0873E14307.quest_desc: ["沙漠里有树！ \\n\\n不，等等，那里曾经有树……"]
	quest.41C70F0873E14307.title: "&8死去的月亮日志"
	quest.429785E8F64929CE.quest_desc: ["要前往&9&l星光维度&r，你需要在&2&l主世界&r中找到&7传送门遗迹&r。\\n\\n在那里你会遇到&7&l守门人&r，右键与他们对话并发起决斗！小心，他们很强。 \\n\\n如果你击败了末影龙，守门人也会认可你，并允许你跳过决斗。 \\n\\n赢得决斗后，你会获得几件物品，其中之一是&3预言之球&r。用&3预言之球&r右键&7传送门&r以激活它！然后，走进去即可到达..."]
	quest.429785E8F64929CE.title: "守门人与那扇大门"
	quest.45AA690C89BF6845.title: "&6温泉石护腿 (Thermal Springstone Leggings)"
	quest.45B0442B80A7C7FB.title: "&9马拉里特斧头"
	quest.45D73CA0A7BE4666.quest_desc: [
		"&e繁茂浅海&r名副其实，植物繁多，而且并不深！ \\n\\n深度只有20格左右。"
		"{image:atm:textures/questpics/eternal/starlight_shallow.png width:200 height:100 align:center}"
	]
	quest.45D73CA0A7BE4666.title: "&e葱郁的浅海"
	quest.46E32356964E56A0.title: "&7深海银护腿"
	quest.470EA6870DBBB352.title: "&7深海银胸甲"
	quest.474C8AF9D536D4E7.title: "&6温泉石铲子"
	quest.47CB136D7764B86D.quest_desc: ["&eTorreya Vines&r 会挂在 &cTorreya Trees&r 上。 \\n\\n它们之所以挂着，是因为无法用其他方式放置... \\n\\n它们底部的球体可以发出光！"]
	quest.47CB136D7764B86D.title: "&e托雷亚藤蔓"
	quest.47DF2314B10146E9.title: "&6温泉石镐"
	quest.484ABFF266C8791E.quest_desc: ["&eOrbflora&r 是从&b海&r底生长的植物。 \\n\\n它们可以随时被采集，但如果你想得到&eOrbflora 灯&r，就需要等待！ \\n\\n当它们长到海平面时会开花。开花后，它们会生长出&e光&r！"]
	quest.484ABFF266C8791E.title: "&eOrbflora"
	quest.49D1EA8E812A12F6.quest_desc: ["这只是个很棒的植物。 \\n\\n你需要一把镰刀才能收集它！ \\n\\n我不知道为什么，我从来不在乎植物，但芦苇对我来说很酷。也许是因为它们长在&9水&r边，或者是因为蒲苇看起来像玉米狗。我不知道，但我喜欢它们。"]
	quest.49DC0BD7DC1B893C.quest_desc: ["&5深渊&r是位于&b星光之海&r中的深邃沟壑。它们最深可达-50！ \\n\\n沟壑内有多层不同颜色的石头，并包含许多不同的方块、苔藓和鱼类！"]
	quest.49DC0BD7DC1B893C.title: "&5深渊 (The Abyss)</c1>"
	quest.4A54288FD22C903D.quest_desc: ["&2Velvetumoss&r 会生成在 &5The Abyss&r 中。 \\n\\n你可以挖掘 &2绿色&r 的来获取 &2Velvetumoss Balls&r，既可以吃掉，也可以制作成 &aSlimeball&r！ \\n\\n而 &4红色&r 的则会生成漂亮的植物！"]
	quest.4A54288FD22C903D.title: "&2天鹅绒苔藓 &f和 &4红色 &f版本"
	quest.4A5EA948F5DCEB73.quest_desc: ["&7Deepsilver&r 以前叫 Swamp Silver，只在 &9Dark Swamps&r 生成。 \\n\\n现在地下到处都能找到……这大概就是改名原因吧！"]
	quest.4A5EA948F5DCEB73.title: "&7深海银"
	quest.4B097031A3EE930B.title: "&b冰川石锄头"
	quest.4B13835110F1FE82.title: "&7深海银镰刀"
	quest.4C23D7E3DC8327C2.quest_desc: ["要杀死&9&lLunar Monstrosity&r，你需要把它点燃！ \\n\\n你可以用燧石和钢，也可以用&eSaltpeter Matchbox&r。 \\n\\n我个人觉得&eMatchbox&r更合适！"]
	quest.4C23D7E3DC8327C2.title: "把它烧掉！"
	quest.4C72D2BB6785CC78.title: "&c星火铲子"
	quest.4D0B50731FED3CEE.quest_desc: ["要获得新月长矛，你要么用月之怪物和纠缠仇恨掉落的物品来合成，要么直接让它掉落。（反正你都得杀了它）。 \\n\\n你可以像三叉戟一样挥舞长矛攻击生物，也可以按住右键向前冲刺。如果用第二种攻击命中生物，附近的生物也会受到伤害。"]
	quest.4D0B50731FED3CEE.title: "&b三日月&5长矛"
	quest.4D4DE266A2A325B0.quest_desc: ["&4红石&r、&b哥布林钢&r和&8氧化哥布林钢&r是用来寻找&b哥布林锻造炉&r的物品。\\n\\n手持其中一个（很可能是&4红石&r，它会生成在&9&l星光&r地下）并使用寻踪之眼来找到&b哥布林锻造炉&r，顺便一提，它在地下！"]
	quest.4D4DE266A2A325B0.title: "&l&bGolem&r 物品"
	quest.4D53D9BBD8279282.quest_desc: ["&3Lunar Trees&r 可以是巨大的参天&3Trees&r，也可以是小小的树苗。它们会适应环境，占据尽可能多的空间！(这就能解释&3Dense Forests&r了)。\\n\\n它们的种植方式和普通树苗一样，并且叶子中可能会生成&3Lunar Berries&r！"]
	quest.4D53D9BBD8279282.title: "&3月亮之树"
	quest.4D8C9960BB675221.quest_desc: ["名字听起来很有趣的样子！"]
	quest.4DBC3B4D38CC6152.quest_desc: [
		"&d结晶化飞蛾&r会生成在&5结晶化沙漠&r的深处。 \\n\\n它们是中立生物，建议不要攻击它们，因为它们伤害极高！ \\n\\n它们还有10个&4心&r，死亡时会掉落&b星光&d&r水晶&9或&r颤动凝胶&r。 \\n\\n用肉喂它们就能驯服这些漂亮的家伙！之后它们就会为你而战。"
		"{image:atm:textures/questpics/eternal/starlight_moth.png width:125 height:100 align:center}"
	]
	quest.4DBC3B4D38CC6152.title: "&d结晶化的飞蛾"
	quest.5003365C2A7B4B53.title: "&c星火之剑"
	quest.50674FE3C6BE9990.quest_desc: [
		"就像普通的&3星光森林&r一样，只是树木之间的间距小得多！"
		"{image:atm:textures/questpics/eternal/starlight_dense.png width:200 height:100 align:center}"
	]
	quest.50674FE3C6BE9990.title: "&3致密星光森林"
	quest.50EC8F8CD04D9598.title: "&5星辰之怒"
	quest.516AC1F0E0BCAE55.quest_desc: ["&b冷冻管&r会从&b冻结&r中掉落，位于&b哥布林锻造炉&r。 \\n\\n它们可以像药水一样投掷，对命中的目标造成伤害。"]
	quest.516AC1F0E0BCAE55.title: "&b冷冻管道"
	quest.51B1AF28328FFBAD.quest_desc: [
		"对于木材爱好者来说，&c螺旋海带林&r是一个非常令人失望的生物群。 \\n\\n这根本不是一个森林，而是一个海洋！甚至不是带树的海洋生物群，那种叫&e繁茂浅海&r。 \\n\\n我很抱歉。"
		"{image:atm:textures/questpics/eternal/starlight_spiral.png width:200 height:100 align:center}"
	]
	quest.51B1AF28328FFBAD.title: "&c螺旋海带森林"
	quest.51B6D203E28D92BE.quest_desc: ["讨厌等&5流星雨&r？不如自己来一场！ \\n\\n&5Aetherstrike火箭&r会像普通烟花一样。飞向空中，绽放绚丽火花，同时还会召唤一场&5流星雨&r。 \\n\\n没错，它会在发射点引发一场&5流星雨&r。 \\n\\n不过，它确实有冷却时间。"]
	quest.51B6D203E28D92BE.title: "&5以太冲击火箭"
	quest.5244B2D6B5FA0487.quest_desc: [
		"&5结晶沙漠&r看起来像普通的沙漠，但色调是&5紫色&r的。 \\n\\n还添加了巨型水晶，普通的沙漠里应该没有这些……"
		"{image:atm:textures/questpics/eternal/starlight_desert.png width:200 height:100 align:center}"
	]
	quest.5244B2D6B5FA0487.title: "&5结晶化的沙漠"
	quest.5282190D0C0C2AA9.quest_desc: ["&d星光钻石&r会生成在遍布各地的地下深处，在&9&l星光&r中。 \\n\\n你将在虚空石附近找到它。 \\n从名字里的钻石就能看出，它对制作工具和武器非常有用。"]
	quest.5282190D0C0C2AA9.title: "&d星光钻石"
	quest.53149C516E544FE9.quest_desc: ["&5Creteors&r 和 &5Mini Creteors&r 会来自 &5Meteor Showers&r。 \\n\\n&5Creteors&r 是中立的，你需要先攻击它们。它们有 8 个 &4Hearts&r。 \\n\\n被攻击后，它们会朝你滚动并闪烁。它们会对你造成少量伤害，但同时也会爆炸！爆炸需要一点时间，所以你还有逃跑的机会，但当它们爆炸时，会生成... \\n\\n&5Mini Creteors&r！这些小家伙比它们的大个子同伴要友善得多。 \\n\\n&5Mini Creteors&r 会朝你飞来并爆炸。它们只有 2.5 个 &4Hearts&r。 \\n\\n被杀死时（非爆炸），两者都会掉落 &5Aethersent&r 和 &5Creteor Hide&r。"]
	quest.53149C516E544FE9.quest_subtitle: "来自外太空的生物？外星人？"
	quest.53149C516E544FE9.title: "&5创造者模组"
	quest.5424A0E1292B13EE.quest_desc: ["在 &9&l星光&r 周围，你可能会发现温泉。 \\n\\n（这些不属于生物群系或结构，所以需要四处寻找！） \\n\\n在温泉中，你可以找到 &6地热春石&r。"]
	quest.5424A0E1292B13EE.title: "&6温泉石 (Thermal Springstone)"
	quest.5466CB622A637DCD.quest_desc: ["深渊果理论上可以在任何&9水&r中生成，但它唯一能生长在&3闪烁河流&r中。\\n\\n它像&2海带&r一样从底部向上生长，但也像&e发光浆果&r一样，果实会生长出来并可以被采集。"]
	quest.54DE8AAAE2181F18.quest_desc: ["&dMoonring Greatsword&r不再需要两位首领的掉落物，现在只需你击杀&9&lLunar Monstrosity&r即可。\\n\\n它的用法和1.9版本前的普通剑一样。可以像盾牌一样格挡攻击，但不能连续使用以造成全额伤害。"]
	quest.54DE8AAAE2181F18.title: "&d月亮环大剑"
	quest.562B280928897E0D.title: "&d星光钻石靴子"
	quest.564F0343B1704CE8.title: "&c星火十字弓"
	quest.5671D301C5264C7F.title: "&c星火镐"
	quest.59613CCE59689263.quest_desc: ["&2Rookfish&r 是可爱的棋子形鱿鱼，在 &9&l星光&r 中游泳。 \\n它们有 5 个 &4心&r，死亡时会掉落自己和它们的浮囊。"]
	quest.59613CCE59689263.title: "&2罗克鱼"
	quest.5B737000D540ED48.title: "&4阿玛兰伯镰刀"
	quest.5C11E99FF201C3F9.quest_desc: ["&8Golem Steel Greatsword&r 是一把很有趣的武器。 \\n\\n首先，它可以格挡。只需右键即可格挡。 \\n\\n其次，还有&bLIGHTNING BALLS&r！每次左键点击，3个&bLightning Balls&r会从&8Sword&r中射出。 &bLightning&r会在三者之间连接，并对接触到的任何东西造成伤害。它们还会在方块上反弹。 \\n\\n而且，无论如何，它都是一把很棒的&8Sword&r！"]
	quest.5C11E99FF201C3F9.title: "&8Golem Steel Greatsword"
	quest.5D8E715CCB7ACCAC.title: "&d星光钻石护腿"
	quest.5DFE3CB5B0130A7A.quest_desc: ["在&3Shimmer River&r的上方有许多植物，有些还可以踩上去！"]
	quest.5DFE3CB5B0130A7A.title: "河流生活"
	quest.5E8A1D47CF3C7ACF.title: "&aFlowglaze 铲子"
	quest.60FDCA2FDFE74056.quest_desc: [
		"是&d粉色&r的！ \\n\\n在这里你会发现&d绯红树木&r，它们的叶子都堆在树下。你还能在这里找到发光蘑菇！"
		"{image:atm:textures/questpics/eternal/starlight_scarlet.png width:200 height:100 align:center}"
	]
	quest.60FDCA2FDFE74056.title: "&d绯红森林"
	quest.61E11E4C358898D6.title: "&d星光钻石头盔"
	quest.62A11EEC976DA5C5.title: "&a炼金术士长袍"
	quest.62B44B688D09C939.quest_desc: ["&aFlowglaze&r！\\n\\n手持&cStarfire&r右键即可投掷。它能对生物造成&cStarfire&r效果，若击中沙子，则会将其变为&aRaw Flowglaze&r。\\n\\n只需熔炼&aFlowglaze&r，再用升级模板就能制作武器和工具。"]
	quest.62B44B688D09C939.title: "&aFlowglaze"
	quest.62DA302CF53B7C39.title: "&6温泉石靴子"
	quest.62F33BBE7BDFE404.quest_desc: ["&5&b传送杖&r是&9月之怪物&r的另一个掉落物，仅此而已！ \\n\\n你可以右键持杖启动，松开后就会传送到你上次注视的方块！ \\n\\n有距离限制，但很远。使用后还有冷却时间！"]
	quest.62F33BBE7BDFE404.title: "&5&7传送法杖"
	quest.6314B892B569A0A5.quest_desc: ["&9&l星光世界&r！ \\n\\n这是一个永远处于&9黄昏&r的维度，而且你无法改变这一点。 \\n\\n这里有数十种生物群系、生物、首领，甚至还有各种方块等你发现！你能把它们全部找出来吗？"]
	quest.6314B892B569A0A5.title: "&9&l永恒星光"
	quest.63362CC33B39C627.quest_desc: [
		"星光之海是位于温暖海岸与陆地之间的一大片水域。 \\n\\n里面有许多奇观和正在生长的生物！ \\n\\n希望你带了护目镜！"
		"{image:atm:textures/questpics/eternal/starlight_starlitsea.png width:200 height:100 align:center}"
	]
	quest.63362CC33B39C627.title: "&b星光之海"
	quest.636848ED1115A0B3.quest_desc: [
		"&8鼠灵&r是可以在地表生成的和平生物。 \\n\\n死亡时会掉落鼠肉、皮革和洞穴苔藓。 \\n\\n后者可用于让它们繁殖！"
		"{image:atm:textures/questpics/eternal/starlight_rat.png width:100 height:100 align:center}"
	]
	quest.636848ED1115A0B3.title: "&8拉特林斯"
	quest.641C74BFA03BC01F.title: "&b冰川石盾"
	quest.645380EA38544D3B.title: "&b冰川铲子"
	quest.64B6E1ABD471CF29.title: "&7深海银靴子"
	quest.66536AAF9E98C3A6.title: "&9马拉里特锄头"
	quest.66DE7EF4AFCE4F7A.title: "&7深海银铲子"
	quest.687C51D915339086.title: "&aFlowglaze 盾牌"
	quest.68B2D3B985FC1378.quest_desc: [
		"一片明亮美丽的森林，充满了&cTorreya Trees&r和&eVines&r。"
		"{image:atm:textures/questpics/eternal/starlight_torreya.png width:200 height:100 align:center}"
	]
	quest.68B2D3B985FC1378.title: "&c托雷亚森林"
	quest.699C6DDE6B2D51C1.quest_desc: ["&2Jinglestem Trees&r生长在水下……现实中有这样的树吗？ \\n\\n它们有&2Algaeleaves&r，而不是普通的树叶。"]
	quest.699C6DDE6B2D51C1.title: "&2Jinglestem Trees&f?"
	quest.6B00D5DBB3552F15.quest_desc: [
		"&9Tangled&r 是在 &9Cursed Garden&r 中生成的敌人。 \\n\\n它们有 10 个 &4Hearts&r，会拍打你进行攻击。如果被击中，你会受到少量中毒效果。 \\n\\n死亡时会掉落 Vines 和 Bones，还会生成一个 Tangled Skull！ \\n\\nTangled Skulls 的行为与 Vexes 类似，会穿过方块飞行并攻击你。它们只有 5 个 &4Hearts&r，死亡后会作为物品掉落。"
		"{image:atm:textures/questpics/eternal/starlight_tangled.png width:150 height:100 align:center}"
	]
	quest.6B00D5DBB3552F15.title: "&9缠结的藤蔓"
	quest.6DCC11671A2BAA1C.quest_desc: ["在&9&l星光&r森林里，你偶尔会遇到&c小鸟&r。 \\n如果在鸟巢附近喂2只&c小鸟&r一些种子，它们会从&c小鸟&r变成恩爱鸟。 \\n\\n其实不然，但它们会依偎在鸟巢里。之后它们会留下一份礼物。有时这份礼物会是……"]
	quest.6DCC11671A2BAA1C.title: "鸟儿和……鸟儿？"
	quest.6E970CF05B96EB20.quest_desc: ["要伤害&b&lGolem&r，你需要切断它的电源！ \\n\\n为此，当能量方块变蓝时，右键点击它们即可。 \\n\\n通常你可以在boss房间的角落和它上方各找到2个！"]
	quest.6E970CF05B96EB20.title: "正在关闭电源"
	quest.6EC289857CDC4969.quest_desc: [
		"&bEnts&r 是另一种在 &9&l星光&r 地表生成的和平生物。它们在森林里生成！ \\n\\n这些小树死亡后会掉落木棍、&3月浆果&r和 &3月叶&r。 \\n\\n你可以用 &3月浆果&r 来繁殖它们！"
		"{image:atm:textures/questpics/eternal/starlight_ent.png width:100 height:100 align:center}"
	]
	quest.6EC289857CDC4969.title: "&b树人族"
	quest.6ECDD55D55D4D44E.title: "&5星落长弓"
	quest.6F5F6BAB09CB4F5E.title: "&9马拉里特长矛"
	quest.70A82A5D17D558FB.quest_desc: ["&b能量剑&r只能由&b&l星光傀儡&r掉落。 \\n\\n它和普通剑一样，但右键可以像《守望先锋》里的源氏一样，挥舞着冲向敌人！"]
	quest.70A82A5D17D558FB.title: "&b能量之剑"
	quest.70F8A8D6C442F2B6.title: "&aFlowglaze 锄头"
	quest.713548E540B18E07.quest_desc: ["&9月环弓&r只能由&9&l月之巨兽&r掉落。 \\n\\n它能像普通弓一样射出箭，但地面尖刺会沿着箭射出的方向生成！"]
	quest.713548E540B18E07.title: "&9月亮环弓"
	quest.713EF442D59501BA.quest_desc: ["&5灵魂&9链&r可由&9&l月之怪物&r的掉落物合成。\\n\\n这是一个钩爪！轻点右键投掷，命中物体后它会开始将你拉回。之后，需再次右键以脱离。"]
	quest.713EF442D59501BA.title: "&5灵魂&9之链"
	quest.71C58666D4BC2508.quest_desc: ["和打火石与钢一样好用！"]
	quest.71C58666D4BC2508.title: "&e硝石火柴盒"
	quest.7322332BB6CF5CF7.title: "&7深海银刷子"
	quest.7618153D6613790E.title: "&6温泉石镰刀"
	quest.76BFC5815FC6565C.quest_desc: ["在&9&l星光&r中，偶尔会出现&5流星雨&r。 \\n\\n现实中，陨石从天而降，近在咫尺，固然恐怖，但在&2&l我的世界&r中，这却很有用！ \\n\\n当流星雨发生时，名为&5Aethersent&r的材料会生成在陨石撞击的地面上。此外，一些生物也可能从陨石中生成！"]
	quest.76BFC5815FC6565C.title: "&5流星雨事件"
	quest.770C0975CA61CE46.quest_desc: ["&bGlacite&r 可以在永久冻原森林的地下深处找到。 \\n\\n它可以用来制作能抵御冰冻伤害的盔甲和工具！"]
	quest.770C0975CA61CE46.title: "&bGlacite"
	quest.7798BC7C5112D6FB.title: "&b冰川石护腿"
	quest.78D26411B482CD5A.title: "&d星光钻石铲子"
	quest.79B03F769746784A.title: "&9马拉里特镐"
	quest.79B33E4691E6CB45.title: "&aFlowglaze 剑"
	quest.7A16D2EB63359294.quest_desc: [
		"&3极光鹿&r是生活在寒冷地区的友好有蹄动物。 \\n\\n这些&3鹿&r不会伤害你，但如果你在奔跑时挡了它们的道，可能会被它们的&3鹿角&r顶到。 \\n\\n&3鹿角&r它们死亡时也会掉落，既可以用作武器，也可以用作锄头！ \\n\\n它们还可能掉落皮革或极光鹿排。"
		"{image:atm:textures/questpics/eternal/starlight_deer.png width:200 height:100 align:center}"
	]
	quest.7A16D2EB63359294.title: "&3极光鹿"
	quest.7AF8567CF8C543F7.title: "&6温泉石斧"
	quest.7B5D34650BBD97D9.quest_desc: ["&5Aethersent&r 会从 &5Creteors&r 和 &5Meteor Showers&r 中掉落。 \\n\\n大多数 &5Meteor Showers&r 都会掉落大量物品，所以别担心！"]
	quest.7B5D34650BBD97D9.title: "&5Aethersent"
	quest.7B937E68FEFBBA98.title: "&d星光钻石胸甲"
	quest.7C53F52992EA2064.title: "&4阿玛兰伯铲子"
	quest.7D68FD0637351E02.title: "&6温泉石头盔"
	quest.7D7BD1458CF12021.quest_desc: ["当然，沙漠里有&5仙人掌&r！ \\n\\n完全生长的&5仙人掌&r顶部会结出果实！"]
	quest.7D7BD1458CF12021.title: "&5月神仙人掌"
	quest.7E90138B0A2C3210.quest_desc: ["北境之树是生长在永久冻土森林里的大而结实的树木。 \\n\\n它们看起来像云杉，但要轻得多！也许是白化云杉吧。 \\n\\n它们的树苗必须放在泥土上，而不是草地上，并且要呈2x2的排列。"]
	quest.7FBB431AC055FE93.quest_desc: ["&7Soulit Spectator&r 需要用 &9Soul Dew&r 和 &9Nightfal Spider Eye&r 制作。 \\n\\n它的工作原理类似于《汤姆·克兰西的细胞分裂》中的粘性摄像头。右键可以派遣 &7Spectator&r，稍后你就能通过它观察四周。甚至还能看到自己！ \\n\\n无法提前终止，使用时需谨慎。它还有耐久度和冷却时间。"]
	quest.7FBB431AC055FE93.title: "&7Soulit Spectator 观察者模组"
	quest.7FBD51663C1A711A.title: "&4阿玛兰伯之剑"
	quest.7FF77463F2A0E210.quest_desc: ["暮色泥巴只能在&9黑暗沼泽&r中找到。 \\n\\n你可以用它制作出更多的方块！"]
	task.0AD8AC7ECCD8002A.title: "AllRightsReserved"
	task.2510A7EE5D886B63.title: "AllRightsReserved"
	task.452736994864F623.title: "访问一条闪烁的河流"
	task.67690077D4273A36.title: "前往星光璀璨之地 (Starlight)"
}
