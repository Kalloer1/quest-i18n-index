			]
			title: "野牛"
			x: 11.0d
			y: 5.5d
		}
		{
			dependencies: ["767D768BEE5484A6"]
			description: [
				"可以用剪刀从野牛身上剪下一些野牛毛皮，有一定的用途。被剪掉毛的野牛需要食用大量的草才能恢复毛皮。"
				""
				"用望远镜观察野牛即可完成挑战&e【平原上的美景】&r。"
			]
			id: "4FF63C846511501E"
