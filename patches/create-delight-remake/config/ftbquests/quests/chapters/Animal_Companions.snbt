			}]
			x: 5.0d
			y: -8.5d
		}
		{
			dependencies: ["46EAAF318C57196E"]
			description: ["工蚁负责采集树叶，蚁后只有在踩到切叶蚁丘时才会出现。这时，会获得进度&e【蚂蚁终结者】&r。"]
			id: "495DDB24D781F836"
			subtitle: "“当时有个人一脚踩进了蚂蚁窝里，导致整个队伍遭到了大群蚂蚁的围攻。”"
			tasks: [{
				advancement: "alexsmobs:alexsmobs/stomp_leafcutter_anthill"
