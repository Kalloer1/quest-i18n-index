				timer: 0L
				title: "獠牙兽"
				to_observe: "alexsmobs:tusklin"
				type: "observation"
			}]
			x: -9.5d
			y: -8.5d
		}
		{
			dependencies: ["5DABC6DD0D628556"]
			description: ["与猪灵以物易物可获得远古疣猪靴子。这种由古老工艺制成的靴子能提升獠牙兽的骑乘性能。手持远古疣猪靴子，对獠牙兽右键即可为其装备。装备了远古疣猪靴子的獠牙兽可连续骑乘约8秒，并能大幅减少被甩出时的垂直和水平距离。"]
			id: "6559835E41B08DE7"
