	file.0000000000000001.title: "&f我们的故事：地球 1.21"
	quest.00000000000002D6.quest_desc: ["杀害动物是残忍的。美味多汁的残忍。"]
	quest.00000000000002D6.title: "美食连连看"
	quest.00000000000002E0.quest_desc: ["下界充满了危险的怪物。在被它们摧毁之前，先摧毁它们。"]
	quest.00000000000002E0.title: "下界危险"
	quest.00000000000002E8.quest_desc: ["夜晚黑暗又可怕。怪物会在夜间出没。挥舞你的剑，瞄准并消灭你的宿敌。"]
	quest.00000000000002E8.title: "致命危险"
	quest.00000000000002F6.quest_desc: ["前往末地，击败末地巨龙。"]
	quest.00000000000002F6.title: "前方有龙"
	quest.00000000000002FB.quest_desc: ["将末地水晶放置在末地喷泉每侧中心方块上，末地龙就会重生。再次击败它以获取另一个蛋。"]
	quest.00000000000002FB.title: "重生"
	quest.0DEBC61F8E0B71C2.quest_desc: [
		"要将你的任务分享给朋友，你需要创建一个团队。"
		""
		"为此，请输入命令：\"/ftbteams party create\" 或使用左上角的菜单。"
		""
		"在这里，你可以点击设置来配置你的团队（名称、颜色、描述等）。"
		""
		"现在你可以在同一个界面中添加好友，一起开启共享冒险。"
	]
	quest.0DEBC61F8E0B71C2.quest_subtitle: "请阅读我的描述！"
	quest.0DEBC61F8E0B71C2.title: "&eFTB 团队"
	quest.2AA9784F0526D00D.quest_desc: ["凋零是一种凶猛的敌人。召唤并击败它，即可获得能赋予头骨和沙子生命力的强大下界之星核心。"]
	quest.2AA9784F0526D00D.title: "呼啸山庄（Withering Heights）"
	quest.2B04C39F8061A391.quest_desc: [
		"欢迎来到我们的故事世界。"
		""
		"你喜欢探索新大陆吗？也喜欢制作自动化机器来获取无限资源吗？这个整合包里有适合你的内容。"
		""
		"借助未来设置的诸多任务，你可以通过探索、科技、魔法及众多模组来书写自己的故事。"
		""
		"祝您游戏愉快！"
	]
	quest.2B04C39F8061A391.title: "欢迎"
	quest.3269DBDB2904B394.quest_desc: [
		"使用任务书非常简单。屏幕左侧被称为标签页。每个标签页都包含任务树，你可以在每个标签页中看到它们。"
		"点击并拖动页面边缘可以移动页面。点击任务即可打开。任务列表在左侧，会自动从你的物品栏或与世界的交互中检测任务。"
		"完成任务的奖励在右侧，所有任务完成后即可解锁。"
		"任务顶部的左箭头会显示解锁该任务所需的任务。右箭头会显示完成该任务后能解锁的内容。"
		"使用滚轮可以缩放界面。"
		"最后，任务线和单个任务会隐藏起来，直到你解锁了前置任务。随着你在整合包中推进，它们会解锁并展开。"
	]
	quest.366705735F06E60E.quest_desc: [
		"在物品栏底部，你可能已经注意到一个搜索栏。"
		""
		"这是&dJust Enough Items&r，即&dJEI&r的搜索栏。"
		""
		"例如，输入“Wood”后，屏幕右侧的&dJEI &r物品列表会显示所有名称中包含“Wood”的物品。"
		""
		"在搜索查询前加上 @ 可以显示特定模组的物品，例如 @Chipped"
		""
	]
	quest.366705735F06E60E.quest_subtitle: "请阅读我的描述！"
	quest.3D5841B8216C4182.quest_desc: [
		"要将你的任务分享给朋友，你需要创建一个团队。"
		""
		"为此，请输入以下命令："
		"/ftbteams party create."
		""
		"现在去你的物品栏菜单，然后点击左上角的按钮“我的团队”。"
		"在那里，你可以点击设置来配置你的团队（名称、颜色、描述等...）"
		""
		"你只需要用这个命令邀请你的朋友："
		"/ftbteams party invite NAME"
		""
		"你的朋友只需接受，你们现在就在一个队伍里了。"
		""
		"如果你想加入一个已有的团队，只需输入以下命令："
		"/ftbteams party join TEAM NAME"
	]
	quest.4120AB56E16B718C.quest_desc: [
		"屏幕左上角的图标是 &aFTB 团队 &r菜单。你可以用它将其他玩家添加到你的团队中。"
		""
		"在 &aFTB Teams &r图标的右侧是 &6Quest Book &r图标，可以让你随时访问 &6Quest Book &r。"
		""
		"任务旨在激发你的冒险，引导你完成整合包，并在途中为你赢得奖励。"
	]
	quest.4120AB56E16B718C.quest_subtitle: "请阅读我的描述！"
	quest.4120AB56E16B718C.title: "&a物品栏"
	quest.69124AEEB537FDBD.quest_desc: [
