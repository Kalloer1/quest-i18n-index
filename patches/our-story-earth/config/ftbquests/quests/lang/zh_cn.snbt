	quest.70476C63C90B6D05.quest_desc: [
		"本教程将带你了解一些基本功能。放心，不会花太长时间！"
		""
		"要开始，请点击“任务”下方的对勾，然后领取你的任务奖励。新的任务将开始出现！"
		""
		"如果没有新任务出现，请尝试重启世界。在教程结束前，不要移除蘑菇。"
		"{@pagebreak}"
	]
	quest.70476C63C90B6D05.quest_subtitle: "要开始教程，请点击此任务并阅读描述。"
	quest.7749B63BFF6F3CDF.quest_desc: ["几天没睡觉就会出现幻象。它们很烦人。在被它们杀死前，先干掉它们。"]
