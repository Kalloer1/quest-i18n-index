	quest.00000000000001AA.quest_desc: ["基础流体储罐最多可容纳 14000mB 的流体。将其模式切换为桶模式，即可用作桶。"]
	quest.00000000000001AA.quest_subtitle: "Craft a Basic Fluid Tank"
	quest.00000000000001AC.quest_desc: ["高级流体储罐最多可容纳 28000mB 的流体，是基础流体储罐的两倍。将其模式切换到桶模式，它还可以充当水桶使用。"]
	quest.00000000000001AC.quest_subtitle: "制作一个高级流体储罐"
	quest.00000000000001AE.quest_desc: [
		"精英流体储罐是高级流体储罐的升级版，可容纳 56000 mB 的液体。手持储罐时，按 Shift+右键可切换桶模式。"
		" "
		"桶模式开启时，它能像桶一样收集水和岩浆。关闭时，可像方块一样放置，以便连接机械管道。"
	]
	quest.00000000000001AE.quest_subtitle: "制作一个精英流体储罐"
	quest.00000000000001B0.quest_desc: [
		"终极流体储罐是精英流体储罐的升级版，可容纳 112000 mB 的液体。手持储罐时，按 Shift+右键可切换桶模式。"
		" "
		"桶模式开启时，它能像桶一样收集水和岩浆。关闭时，可像方块一样放置，以便连接机械管道。"
	]
	quest.00000000000001B0.quest_subtitle: "制作一个终极流体储罐"
