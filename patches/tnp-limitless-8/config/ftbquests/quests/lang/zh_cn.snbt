	quest.00000000000005BA.quest_subtitle: "LV电容器是一种可以储存能量（FE）的方块。最多可储存100,000 FE。"
	quest.00000000000005BC.quest_subtitle: "MV电容器是一种可以储存能量（FE）的方块。最多可储存1,000,000 FE。"
	quest.00000000000005BE.quest_subtitle: "高压电容器是一种可以储存能量（FE）的方块。最多可储存 4,000,000 FE。"
	quest.00000000000005C0.quest_subtitle: "万用表可用于测量电容器中储存的能量（FE）量。还能读取红石信号强度！"
	quest.00000000000005C2.quest_desc: ["能量 (FE) 传输速率为 4000 FE/秒"]
	quest.00000000000005C2.quest_subtitle: "充电站是一种可用于为需要能量（FE）才能工作的不同物品充能的方块。"
