	quest.0000000000000523.quest_desc: ["&o可熔炼 192 个物品。"]
	quest.0000000000000523.quest_subtitle: "合成超优质煤炭"
	quest.0000000000000531.quest_subtitle: "制作一个 Inferium 浇水壶"
	quest.0000000000000533.quest_subtitle: "制作一个审慎之水浇灌壶"
	quest.0000000000000535.quest_subtitle: "制作一个 Tertium 浇水壶"
	quest.0000000000000537.quest_subtitle: "制作一个 Imperium 浇水壶"
	quest.0000000000000548.quest_subtitle: "制作一个超优质浇水壶"
	quest.000000000000054A.quest_subtitle: "制作一些神秘肥料 (Mystical Fertilizer)"
	quest.000000000000054C.quest_desc: ["用 2 个灵魂锭 \& 2 个灵魂粉尘，外加一把金剑，合成灵魂匕首。"]
	quest.000000000000054C.quest_subtitle: "从和平生物处获得额外的灵魂。"
	quest.000000000000054E.quest_subtitle: "工程师螺丝刀是工具箱里的常见物品，用于对某些机械部件进行精确配置。"
	quest.0000000000000550.quest_desc: [
		"焦炭炉的冶炼速度较慢，因此建议在前期至少建造2到3个焦炭炉，以便储备足够的煤炭焦炭。"
		" "
		"1 块煤炭能产出 500mb 的 Creosote Oil，而 1 根原木只能产出 250mb。"
	]
	quest.0000000000000550.quest_subtitle: "需要27个焦炭砖来建造焦炭炉。只需将砖块摆成一个3x3x3的立方体，然后用工程师之锤右键点击该立方体。"
	quest.0000000000000550.title: "焦炭炉 Coke Oven"
	quest.0000000000000552.quest_desc: [
		"高炉也会产生炉渣作为副产品。"
		" "
		"矿渣可以在破碎机中用来获取沙子。或者用来制作混凝土和一些其他建筑材料。"
	]
	quest.0000000000000552.quest_subtitle: "需要27个爆裂砖来建造高炉。只需将砖块摆成一个3x3x3的立方体，然后用工程师之锤右键点击该立方体。"
	quest.0000000000000552.title: "高炉 Blast Furnace"
	quest.0000000000000554.quest_desc: ["工程师之锤是你最重要的工具。它将用于建造焦炉和炼铁炉等多方块结构。"]
	quest.0000000000000554.quest_subtitle: "合成工程师之锤。"
	quest.0000000000000556.quest_desc: [
		"工业大麻种子可以通过破坏高草丛来获得。"
		" "
		"在合成台中使用3个工业大麻纤维，可以将其转换为1根线。"
		" "
		"或者，可以在合成台或使用物品栏合成界面中使用 x4 DruidCraft 'Hemp Seeds' 来获得这些种子。(2x2) - Druidcraft 的 Hemp Seeds 是通过破坏高草或矮草获得的。"
	]
	quest.0000000000000556.quest_subtitle: "工业大麻可用于制造生物柴油，其纤维也可用于制造坚韧织物。"
	quest.0000000000000559.quest_subtitle: "坚韧织物用于制作改良型风车叶片和绝缘电缆。"
	quest.000000000000055B.quest_desc: ["&7或者其他模组的其他方法获得。"]
	quest.000000000000055B.quest_subtitle: "将铁锭放入高炉，并使用木炭/焦煤作为燃料即可生产钢。"
	quest.000000000000055B.title: "钢锭"
	quest.000000000000055D.quest_desc: ["要将风车升到最高级，总共需要 x8 个风车帆。"]
	quest.000000000000055D.quest_subtitle: "手持物品右键点击风车，即可将物品 Windmill Sail 用于风车上。"
	quest.000000000000055F.quest_subtitle: "获取一桶 Creosote Oil（克里索特油）"
	quest.0000000000000561.quest_subtitle: "Acquire Treated Wood Planks"
	quest.0000000000000561.title: "经过处理的木板"
	quest.0000000000000565.quest_subtitle: "风车叶片用于制作风车。每个风车需要 x8 个叶片。"
	quest.0000000000000567.quest_desc: [
		"在风车上使用风车帆可以增加发电量。"
		" "
		"需要 x8 风车帆才能获得最大功率。"
	]
	quest.0000000000000567.quest_subtitle: "风车可以产生相当可观的FE。产生的FE量取决于风车所处的高度以及是否下雨。"
	quest.0000000000000569.quest_subtitle: "水轮分段用于制作水轮。每个水轮需要4个水轮分段。"
	quest.000000000000056B.quest_desc: ["要从轮子中提取FE，需要用到动能发电机。"]
	quest.000000000000056B.quest_subtitle: "水轮可以产生大量FE，最多可并列放置3个水轮。"
	quest.000000000000056F.quest_subtitle: "工程师的线剪是一种用于断开相应线圈的工具。它在不同配方中也有其他用途。"
	quest.0000000000000579.quest_desc: ["工程师的线剪可以通过右键来断开电线。"]
	quest.0000000000000579.quest_subtitle: "导线连接器用于向导线线圈输入和输出能量（FE）。"
	quest.0000000000000579.title: "电线连接器"
	quest.000000000000057D.quest_desc: ["工程师的线剪可以通过右键来断开电线。"]
	quest.000000000000057D.quest_subtitle: "电线中继器用于中继（连接）电线线圈。"
	quest.0000000000000581.quest_desc: ["动能发电机根据水车/风车的转速产生更多的FE。"]
	quest.0000000000000581.quest_subtitle: "动能发电机使用风车、水轮或改良风车来产生能量（FE）。"
	quest.0000000000000583.quest_desc: [
		"（提示：不要走进这些电线。它们可能带电。）"
		" "
		"建议将这些电线换成绝缘电线，以免在附近行走时被电击。"
		" "
		"（此线圈最多只能处理 2048 FE/t；如需更高，则需要 MV 线圈。）"
	]
	quest.0000000000000583.quest_subtitle: "线圈需要与连接器配合使用，为不同方块提供电力。"
	quest.0000000000000585.quest_desc: [
		"（提示：不要试图走进这些电线。它们可能带电。）"
		" "
		"建议将这些电线换成绝缘电线，以免在附近行走时被电击。"
		" "
		"（此线圈最多只能处理 8192 FE/t；如需更高，则需要 HV 线圈。）"
	]
	quest.0000000000000585.quest_subtitle: "线圈需要与连接器配合使用，为不同方块提供电力。"
	quest.0000000000000587.quest_desc: [
		"（提示：不要试图走进这些电线。它们可能带电。）"
		" "
		"（该线圈最多可处理 32768 FE/秒）"
	]
	quest.0000000000000587.quest_subtitle: "线圈需要与连接器配合使用，为不同方块提供电力。"
	quest.0000000000000589.quest_subtitle: "制作一个铜线圈方块"
	quest.000000000000058D.quest_desc: ["用于制造种子再加工机。"]
	quest.000000000000058D.quest_subtitle: "制作机器框架 (Craft the Machine Frame)"
	quest.000000000000058F.quest_subtitle: "灵魂锭粉尘可通过在下界挖掘灵魂矿石，然后在合适的熔炉中冶炼获得。"
	quest.000000000000058F.title: "灵魂锭粉尘"
	quest.0000000000000591.quest_subtitle: "LV Wire Coil 的安全版本。这个 Wire Coil 即使靠得太近也不会电到你。"
	quest.0000000000000593.quest_desc: ["最高等级的绝缘电缆，因为没有高压绝缘电缆。)"]
	quest.0000000000000593.quest_subtitle: "MV Wire Coil 的安全版本。这个 Wire Coil 即使靠得太近也不会电到你。"
	quest.0000000000000595.quest_desc: ["点击任务窗口中的图标，在 JEI 中查看配方。"]
	quest.0000000000000595.quest_subtitle: "Soulium Ingot 是通过使用 2 个 Soulium Dust + 1 个"
	quest.0000000000000597.quest_subtitle: "制作一个工程师工作台"
	quest.00000000000005A7.quest_subtitle: "合成工程师蓝图（金属压制模具）。"
