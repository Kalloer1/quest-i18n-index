	quest.00000000000002E8.quest_desc: [
		"在玄武岩和基岩之间放置红石即可获得。"
		""
		"顶部是黑曜石，底部是基岩——在它们之间放置红石，然后点击黑曜石。"
		""
		"&o*巨大的噪音*- 是Flux！"
		""
		"每次使用的红石粉数量没有限制。"
	]
	quest.00000000000002E8.quest_subtitle: "获取一些Flux能量"
	quest.00000000000002EC.quest_desc: [
		"无线充电选项卡中可以配置物品栏充电。"
		" "
		"同一时间只能有一个控制器连接到网络。"
		""
		"控制器的“输出”指的是通过无线充电从网络输出的能量。"
		" "
		"&lNetwork's do not require a Flux &lController to operate"
	]
	quest.00000000000002EC.quest_subtitle: "激活跨维度物品栏充能所必需。"
	quest.00000000000002EE.quest_desc: ["在维基上阅读更多关于Flux Networks的信息：https://github.com/SonarSonic/Flux-Networks/wiki"]
