	quest.0000000000000C96.quest_subtitle: "建造一个16k的ME存储单元"
	quest.0000000000000C98.quest_desc: [
		"普通AE2中第二高的存储单元，可存储65,536字节。"
		" "
		"65,536字节的存储可容纳8,128个单一物品的堆叠，或4,160个堆叠，同时存放63种不同物品。"
	]
	quest.0000000000000C98.quest_subtitle: "建造一个64k的ME存储单元"
	quest.0000000000000CA9.quest_desc: [
		"用于制造不同类型的处理器。"
		" "
		"刻印者也可以通过用铁块复制现有压印机来“创造”压印机。"
	]
	quest.0000000000000CA9.quest_subtitle: "建造一台刻印机 (Construct an Inscriber)"
	quest.0000000000000CAB.quest_desc: ["用于各种AE2配方中。"]
	quest.0000000000000CAB.quest_subtitle: "Create a Logic Processor"
	quest.0000000000000CAD.quest_desc: ["用于各种AE2配方中。"]
	quest.0000000000000CAD.quest_subtitle: "创建一个计算处理器 (Create a Calculation Processor)"
	quest.0000000000000CAF.quest_desc: ["用于各种AE2配方中。"]
	quest.0000000000000CAF.quest_subtitle: "创建一个工程处理器 (Engineering Processor)"
	quest.0000000000000CB1.quest_desc: ["用于在刻印器中将电路连接在一起。"]
	quest.0000000000000CB1.quest_subtitle: "制作印刷硅片 (Create Printed Silicon)"
	quest.0000000000000CB8.quest_desc: [
		"能量单元最多可储存 200,000 AE。"
		""
		"它们不直接接受能量，而是用于为现有的ME网络增加额外的能量存储。"
	]
	quest.0000000000000CB8.quest_subtitle: "制作一个能量电池"
	quest.0000000000000CBA.quest_subtitle: "制作几个湮灭与形成的核心。"
	quest.0000000000000CBA.title: "两个核心 (The two Cores)"
	quest.0000000000000CC1.quest_desc: ["能量接收器用于将其他模组（如红石流（RF））的能量转换为AE，以驱动ME网络。"]
	quest.0000000000000CC1.quest_subtitle: "建造一个能量接收器 (Construct an Energy Acceptor)"
	quest.0000000000000CC7.quest_desc: ["用于创建ME存储单元"]
	quest.0000000000000CC7.quest_subtitle: "建造一个1k的ME存储组件"
	quest.0000000000000CC9.quest_desc: ["用于创建ME存储单元"]
	quest.0000000000000CC9.quest_subtitle: "建造一个4k的ME存储组件"
	quest.0000000000000CCB.quest_desc: ["用于创建ME存储单元"]
	quest.0000000000000CCB.quest_subtitle: "建造一个16k的ME存储组件"
	quest.0000000000000CCD.quest_desc: ["用于创建ME存储单元"]
	quest.0000000000000CCD.quest_subtitle: "建造一个64k的ME存储组件"
	quest.0000000000000CDA.quest_desc: [
		"将恶魔之梦果实扔在地上，并用打火石和钢点燃，即可生成灵魂之火。"
		""
		"在普通方块上会暂时燃烧，但在原木、煤炭块或下界岩上会永久燃烧。"
		"{image:occultism:textures/gui/book/spiritfire_instructions.png width:100 height:100 align:1}"
	]
	quest.0000000000000CDA.quest_subtitle: "释放你内心的纵火狂本能"
	quest.0000000000000CDA.title: "看，妈妈，它不会燃烧！"
	quest.0000000000000CDE.quest_subtitle: "消灭一个潜行方块生物"
	quest.0000000000000CDE.title: "漂浮？再也不要了！"
	quest.0000000000000CF7.quest_desc: [
		"Foliot Crusher Spirit 将是你第一个可以召唤的灵体。"
		""
		"如果你没有其他方法可以粉碎矿石，这个灵魂在紧急情况下会很有用。"
		""
		"不过，如果你继续推进，更强大的粉碎之灵能产出更多，这样是值得的。"
	]
	quest.0000000000000CF7.quest_subtitle: "让我来告诉你我最好的朋友是谁"
	quest.0000000000000CF7.title: "粉碎一切"
	quest.0000000000000D92.quest_desc: [
		"要制作仪式所需的蜡烛，你需要通过杀死动物来获取动物脂肪。"
		""
		"使用屠夫刀可以屠宰动物，并获得用于制作蜡烛的牛油。"
		""
		"注意：所有蜡烛都需要不少动物脂肪，但也可以用其他蜡烛代替，如果那些更容易制作的话。"
	]
	quest.0000000000000D92.quest_subtitle: "天哪，太恐怖了……"
	quest.0000000000000D92.title: "屠宰场工厂"
	quest.0000000000000D96.quest_desc: [
		"净化墨水是通过将黑色染料投入灵魂之火制成的"
		""
		"所有用于神秘学的《束缚之书》都需要净化墨水，幸运的是，你的任务之神已经给了你一些作为起步。"
	]
	quest.0000000000000D96.title: "净化你的墨水（Cleanse your Ink）"
	quest.0000000000000D98.quest_desc: [
		"粉笔是绘制即将到来的仪式五芒星所需符文的重要工具。"
		""
		"你制作的第一个粉笔是白粉笔，需要将其投入恶魔之火才能使用。"
	]
	quest.0000000000000D9A.quest_desc: ["啊，这样多好，干干净净的粉笔，现在可以用来画你的仪式了。"]
	quest.0000000000000D9A.title: "白色粉笔"
	quest.0000000000000D9C.quest_desc: [
		"黄金粉笔是用于更高级仪式的下一等级粉笔。"
		""
		"这需要一些金子和萤石，但你知道吗？通过腐化发光地衣或发光浆果，你可以在不去下界的情况下获得萤石。如果你已经玩了 Botania，也可以轻松从里面获取；所有选项都可以在 JEI 中查看。"
	]
	quest.0000000000000D9C.quest_subtitle: "噢噢噢噢噢，闪闪发光的东西！！"
	quest.0000000000000D9C.title: "黄金粉笔"
	quest.0000000000000D9E.quest_desc: ["紫色粉笔是神秘学者武器库中的另一种粉笔颜色。它能让你束缚更强大的灵魂，例如精灵。"]
	quest.0000000000000D9E.quest_subtitle: "快给我画紫色的东西了，现在开始！！！"
	quest.0000000000000DA0.quest_desc: [
		"你将制作的最后一块粉笔是红粉笔，用于召唤马利德等高级仪式中最复杂的配方。"
		""
		"如果你没去过下界或找到烈焰人，还是有办法获得烈焰粉。"
		"你可以在主世界和海洋各处找到岩浆块，将其炼成岩浆膏，再炼成烈焰粉。"
		""
		"什么，你还没有研磨机？快去弄一个，超有用的！"
	]
	quest.0000000000000DA4.quest_desc: [
		"维度存储执行器是你在异世界存储物品的入口！"
		""
		"初始规模较小，但可通过添加最多 6 个 Stabilizer（每侧一个）指向 actuator 来扩展存储。"
	]
	quest.0000000000000DA8.quest_desc: [
		"维度存储稳定器可稳定执行器与异界的连接。"
		""
		"你的连接越稳定，能存储的东西就越多！"
		""
		"单个执行器最多可添加6个稳定器。每个等级都会提高稳定性，让你能在异世界存储越来越多的物品。"
		""
		"它们需要朝向执行器的矩阵部分放置，最多可相距5个方块。每个方向（基本方向以及执行器的上下）均可放置一个稳定器。"
		"{image:occultism:textures/gui/book/storage_stabilizer.png width:100 height:100 align:1}"
	]
	quest.0000000000000DAA.quest_desc: ["我们需要更多！MOAR！"]
	quest.0000000000000DAC.quest_desc: ["我说了还要更多！！"]
	quest.0000000000000DAE.quest_desc: [
		"我这就把能用的全交给你，船长！"
		""
		"想象一下6个这样的坏小子拿着全世界的战利品！"
	]
	quest.0000000000000DB2.quest_desc: ["Storage Accessor 是一款可以让你远程访问存储的平板电脑，无论多远，跨越所有维度都可以！！！"]
	quest.0000000000000DBA.quest_desc: [
		"稳定虫洞是一个可放置的物体，能让你访问任何维度的储物空间，还能将物品输送进出储物空间。"
		""
		"虫洞与其他存储模组（如 Refined Storage 或 AE2）结合使用时，效果非常强大。"
		""
		"很常见的配置是在稳定的虫洞上使用外部存储总线，这样你就有了超大的存储容量。"
	]
	quest.0000000000000DBC.quest_desc: [
		"灵魂宝石能让你拾起世界上除最强大的生物之外的任何生物。"
		""
		"将祭品运送到仪式现场时非常实用！"
		""
		"将灵魂宝石握在手中，右键点击任何生物，该生物将被储存在灵魂宝石中，随时可以通过再次右键将其放回世界！"
	]
	quest.0000000000000DBC.quest_subtitle: "口袋里的是生物吗，还是你只是高兴见到我？"
	quest.0000000000000DBC.title: "灵魂宝石"
	quest.0000000000000DBE.quest_desc: [
		"Otherworld Goggles 能让你看到异界材料，提供永久“第三眼”效果，无需食用 Demon's Dream Fruit。"
		""
		"注意：护目镜是在下界中唯一能看见并挖掘 iesnium 矿石的方法。"
		""
		"护目镜也可以放在奇物栏里，这样你就能随时佩戴它们了。"
	]
	quest.0000000000000DBE.quest_subtitle: "我晚上会戴上我的异界护目镜"
	quest.0000000000000DC2.quest_desc: ["Iesnium 镐的属性和普通钻石镐相同，但它能额外挖掘 Iesnium 矿石。"]
	quest.0000000000000DC4.quest_desc: [
		"还没去过末地吗？获得末地石的方法之一是召唤末影幼虫。"
		""
		"仪式会召唤出末影幼虫，杀死后必定掉落1-2个末地石。"
		""
		"现在你可以制作紫色粉笔了。"
	]
	quest.0000000000000DC6.quest_desc: ["仪式需要骷髅吗？ 这能确保你获得骷髅掉落物"]
	quest.0000000000000DCA.quest_desc: [
		"维度矿井会开启一个通往无人居住的维度的传送门，那里充满了各种等待开采的矿石。"
		""
		"唯一的问题是，传送门太小，普通人类无法通过。"
		""
		"不过这对灵魂来说不是问题，你需要召唤一个采矿灵魂来为你获取矿石。"
	]
	quest.0000000000000DCC.quest_desc: [
		"将Foliot采矿之灵放入维度矿道，它会返还矿石和各种石块。"
		""
		"不过，作为一种较弱的灵魂，它行动缓慢，而且很快就会耗尽能量。"
	]
	quest.0000000000000DCE.quest_desc: [
		"Djinni采矿之灵比Foliot采矿之灵要强得多。这个更强大的精灵往返于采矿维度所需的时间要短得多，而且每次都能带回更多的矿石！"
		""
		"此矿工在本整合包中的耐久度得到了提升，直到它在矿井中损失第一点耐久度时，你才会看到这一变化。"
	]
	quest.0000000000000DD0.quest_desc: [
		"通常，像 Iesnium 这样的异界矿石只能用异界材料制成的工具来挖掘。"
		""
		"然而，神秘学者能将工具注入灵魂，从而挖掘这些矿石。注入过程会严重削弱工具，大幅降低其耐久度。"
	]
	quest.0000000000000DD2.quest_desc: ["Spirit Attuned Crystals 用于一些仪式图案和仪式配方中的物品。"]
	quest.0000000000000DD6.quest_desc: [
		"献祭碗将用于仪式中放置物品以执行仪式。"
		""
		"它们可以出现在中心金碗周围8格内的任何位置。"
	]
	quest.0000000000000DD8.quest_desc: [
		"金色的祭品碗要放在每个仪式的中心位置。"
		""
		"每个仪式都需要一个。"
	]
	quest.0000000000000DDA.quest_desc: ["用粉笔犯错了吗？你可以把粉笔敲碎，但这需要很长时间，用刷子右键可以立即清除。"]
	quest.0000000000000DDA.quest_subtitle: "犯错是人之常情"
	quest.0000000000000DDA.title: "扫除一切邪恶之物，净化这片土地"
	quest.0000000000000DE0.quest_desc: [
		"为了召唤更强大的灵魂，你需要阿弗利特精华。"
		""
		"此精华只能通过将 Unbound Afrit Spirit 召唤至凡间并将其击败才能获得。"
		""
		"然而，这并非易事，因为阿弗里特很强，会召唤多个仆从与它一同作战。"
		""
		"击败阿弗利特，夺取它的精华。"
	]
	quest.0000000000000DE4.quest_desc: [
		"有时候弄到凋零骷髅头会是一件麻烦事。"
		""
		"对于那些不想直面地狱般世界的玩家，我们准备了荒野狩猎仪式。"
		""
		"狂野狩猎仪式会召唤多个被附身的凋零骷髅及其被附身的骷髅仆从。每个被附身的凋零骷髅都保证至少掉落一个凋零骷髅头。"
		""
		"这些凋零骷髅还有几率掉落一些额外的战利品！！！"
	]
	quest.0000000000000DE4.title: "召唤野性狩猎团 (Summon The Wild Hunt)"
	quest.0000000000000DE6.quest_desc: [
		"Iesnium 是一种在 Nether 中发现的异界矿石。使用 Divination Rod 应该能让你很快找到它。"
		""
		"Otherworld Goggles 或 Demon's Dream Fruit 或许能帮你看到这种材料，但挖掘它并不需要 Third Eye 效果。不过你需要一把 Infused Pickaxe 或 Iesnium Pickaxe。"
	]
	quest.0000000000000DE6.quest_subtitle: "占卜 2：神秘学摇摆舞"
	quest.0000000000000E00.quest_desc: [
		"厌倦了吃恶魔之梦果？还没做出异界护目镜？我有个好提议！"
		""
		"召唤异界树苗商人，他会将你的不稳定树苗转化为稳定版本，这样你就能正常查看和收获树木了。"
	]
	quest.0000000000000E04.quest_desc: [
		"Foliot 伐木工之灵可以收割那些不断生长的讨厌树木。"
		""
		"伐木工之灵的覆盖范围可高达 64x64"
	]
	quest.0000000000000E0A.quest_desc: [
		"Foliot Transporter 是另一个你可以召唤并带上冒险的伙伴。"
		""
		"Foliot Transporter 可以在两个物品栏之间一次传输一个物品堆栈。"
	]
	quest.0000000000000E0A.title: "召唤福里奥特运输之灵"
	quest.0000000000000F36.quest_subtitle: "制作一个觉醒的超优质方块"
	quest.0000000000000F3C.quest_subtitle: "制作觉醒的超优质工具和武器。"
