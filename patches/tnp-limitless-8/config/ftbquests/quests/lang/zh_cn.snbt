	quest.000000000000004E.quest_desc: ["&7> 最好做好准备！"]
	quest.000000000000004E.quest_subtitle: "召唤末影人首领（Wither Boss）。"
	quest.0000000000000050.quest_subtitle: "在酿造台或类似物品中酿造任意药水。"
	quest.0000000000000052.quest_subtitle: "建造并放置一个信标。"
	quest.000000000000006B.quest_subtitle: "用黄金分散猪灵的注意力"
	quest.000000000000006D.quest_subtitle: "从至少30米外击中靶块的中心点"
	quest.00000000000000B0.quest_subtitle: "成功与村民进行交易。"
	quest.00000000000000B2.quest_subtitle: "杀死任何敌对生物"
	quest.00000000000000B4.quest_subtitle: "杀死一名突袭队长。"
	quest.00000000000000B6.quest_subtitle: "成功抵御一次掠夺者袭击，保卫村庄。"
	quest.00000000000000B8.quest_subtitle: "用箭射中某个东西。"
	quest.00000000000000BA.quest_subtitle: "击杀每种原版敌对怪物各一只。"
	quest.00000000000000BC.quest_subtitle: "杀死一只距离你当前位置水平方向50格以上的骷髅类生物。（非垂直方向）"
	quest.00000000000000BE.quest_subtitle: "注意：扔掉你唯一的武器并不是一个好主意。"
	quest.00000000000000C0.quest_subtitle: "用闪电击中一个村民。"
	quest.00000000000000C2.quest_subtitle: "召唤一个铁傀儡来帮忙保卫村庄。"
	quest.00000000000000C4.quest_subtitle: "使用不死图腾来欺骗死亡。"
	quest.00000000000000C6.quest_subtitle: "跳进蜂蜜块里缓冲一下你的下落。"
	quest.00000000000000C8.quest_subtitle: "用穿透箭杀死两只幻影。"
	quest.00000000000000CA.quest_subtitle: "用十字弓射击一次。"
	quest.00000000000000CC.quest_subtitle: "让掠夺者尝尝自己的苦头！"
	quest.00000000000000CE.quest_subtitle: "用一箭十字弩杀死五种不同的生物。"
	quest.00000000000000D0.quest_subtitle: "睡在床上，改变你的重生点。"
	quest.00000000000000D2.quest_subtitle: "探索每一个生物群系。"
	quest.00000000000000D7.quest_subtitle: "驯服一只动物。"
	quest.00000000000000D9.quest_subtitle: "玩小游戏 \& 抓一条鱼！"
	quest.00000000000000DB.quest_subtitle: "使用丝绸之触移动一个巢内有3只蜜蜂的蜂巢。"
	quest.00000000000000DD.quest_subtitle: "将两种动物杂交在一起。"
	quest.00000000000000DF.quest_subtitle: "使用篝火，用瓶子从蜂箱中收集蜂蜜，不要激怒蜜蜂。"
	quest.00000000000000E1.quest_subtitle: "种下一颗种子，看着它成长。"
	quest.00000000000000E3.quest_subtitle: "把所有能吃的东西都吃掉，哪怕对你没好处……"
	quest.00000000000000E5.quest_subtitle: "用下界合金锭升级一把锄头，然后重新评估你的人生选择"
	quest.00000000000000E7.quest_subtitle: "用没有鱼竿的方法钓一条鱼！"
	quest.00000000000000E9.quest_subtitle: "驯服所有品种的猫！"
	quest.00000000000000EB.quest_subtitle: "把动物们都繁殖一遍！"
	quest.00000000000000F0.quest_subtitle: "击杀宏伟的末影巨龙。"
	quest.00000000000000F2.quest_subtitle: "逃离主岛屿"
	quest.00000000000000F6.quest_subtitle: "用玻璃瓶收集龙之息，右键点击龙创造的紫色粒子。"
	quest.00000000000000F8.quest_desc: ["&e[!] &7需要不止一个末地龙蛋？让末地龙重生，在末地喷泉处再拿一个！"]
	quest.00000000000000F8.quest_subtitle: "手持龙蛋（Hold the Dragon Egg）"
	quest.00000000000000FA.quest_desc: ["&7(找到一个末地城市。)</c1>"]
	quest.00000000000000FA.quest_subtitle: "快进去吧，能出什么事呢？"
	quest.00000000000000FC.quest_subtitle: "找到一个鞘翅……飞向无限与远方！"
	quest.00000000000000FE.quest_subtitle: "被潜行者攻击时向上漂浮50格"
	quest.000000000000010F.quest_subtitle: "杀死一个铁傀儡，然后偷走它的玫瑰和铁锭。"
	quest.000000000000013C.quest_subtitle: "杀死一个僵尸化猪灵。"
	quest.0000000000000192.quest_desc: ["大多数Mekanism机器和发电机使用的最基本物品。在冶金注入器中，用铁锭和红石、红石块或压缩红石注入合成。"]
	quest.0000000000000192.quest_subtitle: "制作富集合金 Enriched Alloy"
	quest.0000000000000194.quest_desc: ["富化合金的升级版，部分Mekanism机器和物品会用到它。在冶金注入器中，用钻石粉尘或压缩钻石注入富化合金即可合成。"]
	quest.0000000000000194.quest_subtitle: "制作强化合金 Reinforced Alloy"
	quest.0000000000000196.quest_desc: ["强化合金的升级版，部分Mekanism机器和物品会用到。在冶金注入器中，用精炼黑曜石粉尘或压缩黑曜石注入强化合金即可合成。"]
	quest.0000000000000196.quest_subtitle: "制作原子合金"
	quest.0000000000000198.quest_desc: ["基础控制电路是用于制造多种低阶机器的一个合成组件。"]
	quest.0000000000000198.quest_subtitle: "创建一个基础控制电路"
