	quest.00000000000001E6.title: "终极通用线缆"
	quest.00000000000001E8.quest_desc: ["Mekanism 机器升级，可让它们更快地处理物品。每台 Mekanism 机器最多可存储 8 个此类升级。"]
	quest.00000000000001E8.quest_subtitle: "制作一个速度升级组件"
	quest.00000000000001EA.quest_desc: ["能量升级可以让你提升带有升级槽的Mekanism机器的储能容量，并降低其功耗。"]
	quest.00000000000001EA.quest_subtitle: "制作一个能量升级组件"
	quest.00000000000001EE.quest_desc: ["Mekanism 机器升级，让它们运行得更安静。安装全部 4 个升级，完全消除机器噪音。"]
	quest.00000000000001EE.quest_subtitle: "制作一个消音升级组件"
	quest.00000000000001F0.quest_desc: ["气体升级可以让你提高Mekanism机器的气体使用效率，从而使其能够运行。"]
	quest.00000000000001F0.quest_subtitle: "制作一个气体升级组件"
	quest.00000000000001F2.quest_desc: ["锚定升级是一种机器升级，可保持所应用机器的区块持续加载。这对于数字矿机和传送门等必须处于加载区块中才能正常工作的机器很有帮助。"]
	quest.00000000000001F2.quest_subtitle: "制作一个锚点升级组件"
