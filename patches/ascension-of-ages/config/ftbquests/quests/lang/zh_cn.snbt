	quest.5350010000020028.quest_desc: [
		"&aAtomic&r 需要九个证明。反应堆线在 &bNuclear Dawn&r 中使用 &6Uranium Rod&r，在 &bChain Reaction&r 中使用 &6Reactor Support Systems&r，在 &aMachine Soul&r 中使用 &6Large Loot Fabricator&r，以及在 &4Threshold of War&r 中使用 &6Threshold Crossed&r。"
		"&6Critical Assembly&r 来自 &bAtomic Convergence&r。最后四个是 &5Chaos Convergence&r 的 boss：&6Baal&r、&6Geburah&r、&6Tremorzilla&r 和 &6Apex of the Covenant&r。"
		"[ \"打开 \", { \"text\": \"the Otherworldly gate\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"4358010000010003\" } }, \" 以查看。\" ]"
	]
