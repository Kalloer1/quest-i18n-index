	quest.53F8923B85A8A9CC.quest_desc: [
		"八十名卫兵。如此庞大的驻军足以抵御最恶劣的袭击，这正是堡垒城镇的标志。"
		"维持它需要城墙内大量食物和装备的生产。"
	]
	quest.53F8923B85A8A9CC.quest_subtitle: "一个堡垒殖民地。"
