	quest.2BABD82714AFB35D.quest_desc: ["风弹是用于制作风系法术的组件。"]
	quest.2CBE6472FA4E8DFF.quest_desc: [
		"这座车站并非用来隔绝外物，而是用来阻止内部的东西逃逸。"
		"{entity:legendary_monsters:the_obliterator ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.2CBE6472FA4E8DFF.quest_subtitle: "在传送机中使用眼晶，击败湮灭者，并获得传送门碎片以推进进度"
	quest.2CBE6472FA4E8DFF.title: "湮灭者 (The Obliterator)"
	quest.2CED61E01BBA8781.title: "Ouranwood 森林"
	quest.2EB67B2DF5D9A7F4.quest_desc: [
		"潜行者承载着由深海与潜声之力塑造的远古力量。"
		""
		"击败第三章的卫道士，夺取其精华。只有这样，你才能开始掌握爱尔德里奇魔法。"
		"{entity:darkermagic:summoned_warden ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.2EB67B2DF5D9A7F4.title: "沃登的力量"
	quest.2EE2B7B0FE4FBC8B.title: "黄金模具"
	quest.309B18B07B1ED866.title: "潜行者 (The Stalker)"
	quest.317543881F75CCC1.title: "神秘莫测的礼物 (Mythic Mysterious Gift)"
	quest.31B79B20460353FD.quest_desc: ["深海中发现的金属不仅仅是奖杯。在巧手之下，它能成为大师级垂钓者配用的装备。"]
	quest.31B79B20460353FD.quest_subtitle: "制作一根海王星钓鱼竿。"
	quest.31B79B20460353FD.title: "海神波塞冬的祝福"
	quest.31F3247BEEBCBDB4.quest_desc: ["用于制作护甲的符文"]
	quest.31FDB554265193AD.title: "废墟中的光明"
	quest.3225DDC58CC1FC6A.quest_desc: ["水中的生物并非都来自同一个图鉴。新物种栖息在河流和湖泊中，等待着愿意拓宽视野的垂钓者。"]
	quest.3225DDC58CC1FC6A.quest_subtitle: "捕捉5种不同的Aquaculture鱼类。这些鱼类属于Aquaculture的淡水类别。在河流、湖泊和其他淡水环境中搜寻。可获得的鱼类可能因生物群系而异。"
	quest.3225DDC58CC1FC6A.title: "水产养殖专家"
	quest.326953B2141F1028.title: "来自另一个时代的金属"
	quest.32AAF1F431EEFC88.quest_desc: ["水下并非所有生物都有鳞片。在丢失的渔钩和旧残骸中，可能有有价值的东西咬住你的鱼线。"]
	quest.32AAF1F431EEFC88.quest_subtitle: "使用 Starcatcher 钓鱼时至少找到 1 件宝藏。"
	quest.32AAF1F431EEFC88.title: "宝藏猎人"
	quest.32B2ACE564FA12D9.quest_desc: ["你已掌握普通世界中的水果。但生长于星辰之外的植物，或许能产出主世界酿酒师无法想象的滋味。"]
	quest.32B2ACE564FA12D9.quest_subtitle: "酿造紫颂葡萄酒。"
	quest.32B2ACE564FA12D9.title: "来自另一个世界的葡萄酒"
	quest.33777148494F71AA.title: "城堡竞技场"
	quest.33A5BD7038C27909.title: "捕星之竿"
	quest.33AE5C74E5ABBE46.title: "神秘宝石"
	quest.33D35D9E03AF416A.title: "Cloggrum 矿石"
	quest.35F35D378CB7F037.quest_desc: ["用于制作护甲的符文"]
	quest.360B8324E743756D.title: "虚空矿石"
	quest.360C4BCCC3E3C4DC.title: "氧气罐"
	quest.36176E243BDEFD49.title: "紫颂竞技场"
	quest.362065DA9E77FDE9.quest_desc: [
		"利维坦承载着深海的黑暗力量，指挥着难以理解的深渊之力。"
		""
		"击败第4章的利维坦，夺取其精华。只有这样，你才能开始掌握深渊魔法。"
		"{entity:cataclysm:the_leviathan ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.362065DA9E77FDE9.title: "深渊之力"
	quest.3668E5546424054F.title: "木制工具"
	quest.368E396279787C32.quest_desc: [
		"击败 Eldorath 以获得钻石并解锁下界传送门！"
		"{entity:armageddon_mod:eldoraththe_ancient_builder ent_size:0.7 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.368E396279787C32.title: "最后的封印"
	quest.37268E79E335E7F0.quest_desc: ["经过多次捕捞，你终于找到了一个不常出现的生物。它那蓝色的光芒揭示了一个更难发现的物种。"]
	quest.37268E79E335E7F0.quest_subtitle: "捕获一条稀有度为“稀有”的蓝色晶鳍鱼。"
	quest.37268E79E335E7F0.title: "一个罕见的标本"
	quest.3733CB2EA18B1D32.quest_desc: [
		"末地守卫掌控着扭曲的虚空之力与重力。"
		""
		"击败第4章的末地守护者，夺取其精华。只有这样，你才能开始掌握末地魔法。"
		"{entity:cataclysm:ender_guardian ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.3733CB2EA18B1D32.title: "末影的力量"
	quest.37D74A6989DBE7D5.title: "末影人图腾"
	quest.3880A3D3C985A9C2.title: "三大灾厄"
	quest.392C6D44E681BE80.quest_desc: ["使用神秘砧升级你的法术，提高它们的威力，使其效果更佳。"]
	quest.392C6D44E681BE80.title: "升级法术（Upgrading Spells）"
	quest.3A3B6EFEA9AEBD37.title: "首个困难模式挑战"
	quest.3ADFE611F3F817D7.quest_desc: ["血瓶是用于酿造血魔法的组件。"]
	quest.3AFDB88E3DEA15E4.title: "云端竞技场"
	quest.3B3C6C81BC94015B.quest_desc: ["用于制作护甲的符文"]
	quest.3B8FB873EECDB91D.quest_desc: ["击败奥格法师时有几率掉落物品"]
	quest.3BFD20AD08D71735.title: "石质竞技场"
	quest.3C03E249B643EBE4.title: "开启深海探险之旅"
	quest.3CA467A4FD94D513.quest_desc: [
		"这片土地的寒冷并非仅来自冰雪。神庙中沉睡的远古之物，冻结着一切靠近者。"
		"{entity:legendary_monsters:frostbitten_golem ent_size:0.6 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.3CA467A4FD94D513.quest_subtitle: "找到 Frostbitten Temple，击败 Frostbitten Golem，并获得 Frozen Rune。"
	quest.3CA467A4FD94D513.title: "冰冻之心"
	quest.3E109F085B32D56C.title: "云之铠甲"
	quest.3E8FFCA47BC24177.quest_desc: ["直面迷宫之母。她出现在水下，极为罕见：有0.5%的几率与深海鳕一同出现"]
	quest.3EB4BEF45DEDF96E.title: "修道院庭院"
	quest.3F8C7D04146DD201.quest_desc: [
		"制作你的第一本魔法书，开启你的魔法师之旅！"
		""
		"要了解有关魔法书的更多信息，请点击此任务下方的“信息”图标。"
	]
	quest.3F8C7D04146DD201.title: "第一本魔法书"
	quest.3FDE4C3960124DC3.quest_desc: ["用于召唤湮灭者（Obliterator）"]
	quest.400DF2BD3FE407E9.quest_desc: [
		"在本章中，你将学习魔法的基础知识，以及如何成为一名真正的魔法师。"
		""
		"你将发现魔咒书，学习如何制作和升级魔咒，使用墨水、法杖、升级球，以及奥术精华和灰烬精华等重要资源。"
		""
		"你还将学会如何使用铭文台、卷轴锻造台、奥数砧和炼金术坩埚等基本结构。"
		""
		"掌握这些工具和资源，以增强你的魔法并继续你的旅程。"
	]
	quest.400DF2BD3FE407E9.title: "魔法入门指南"
	quest.401FF8BAD9D8453C.quest_desc: ["装备法杖可为你的法术提供加成，提升其威力或赋予特定学派独有的益处。"]
	quest.401FF8BAD9D8453C.title: "法杖类物品"
	quest.4070559CD1A958E4.quest_desc: ["钓鱼很简单。但要完美操控鱼线，不出任何差错，则需要精准、耐心和控制力。"]
	quest.4070559CD1A958E4.quest_subtitle: "在 Starcatcher 钓鱼小游戏里完成至少 1 次完美捕获。"
	quest.4070559CD1A958E4.title: "完美捕获"
	quest.40BA76D1AB6EE399.quest_desc: ["{entity:armageddon_mod:zoranththe_forgotten_one ent_size:0.8 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"]
	quest.40BA76D1AB6EE399.title: "被遗忘的那一位"
	quest.418E0A74661A800E.title: "战斗前的准备工作"
	quest.42FCAB00C0BB4540.quest_desc: ["烈焰棒是用于制作火焰法术的组件。"]
	quest.4368D42986D8E4EA.title: "三螺栓盔甲"
	quest.43C835E8482D302E.title: "埃利西亚的天堂 (The Paradise of Elythia)"
	quest.4491CBDB6C707635.quest_desc: [
		"这个指南针能轻松找到生物群系。制作一个吧，旅途中会经常用到。"
		"{image:kubejs:textures/quests/chapters/naturecompass.png width:100 height:50 align:center click_action:none:}"
	]
	quest.4491CBDB6C707635.title: "查找生物群系"
	quest.449B09F71ED6F917.quest_desc: ["好的鱼竿只是开始。鱼钩、浮漂和鱼饵能完全改变你在水中能钓到什么。"]
	quest.449B09F71ED6F917.quest_subtitle: "获取你的第一个鱼钩、浮漂和鱼饵来准备钓鱼装备。"
	quest.449B09F71ED6F917.title: "贸易的工具"
	quest.449E6B86AF1A9833.quest_desc: [
		"群山之上，云层中藏着一位远古之神。雷鸣并非宣告它的到来，而是它发出的声音。"
		"{entity:legendary_monsters:cloud_golem ent_size:0.7 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.449E6B86AF1A9833.quest_subtitle: "找到多云神庙，击败云傀儡Cumulonimbus。它有不同的阶段，会奖励空气符文和大气靴。"
	quest.449E6B86AF1A9833.title: "风暴之主"
	quest.452257A7EE8324FD.title: "凋零镰刀"
	quest.45C47D956FBF921B.title: "过去的碎片"
	quest.45EBD32CDA61BF2F.title: "建筑者护身符"
	quest.467D36502B911D48.title: "丛林竞技场"
	quest.46A80FACE8E0B76D.quest_desc: [
		"击败第2章的食人魔之王后，你在他的遗物中发现了一个古老的王室符号，它与一位本应已死数百年的国王有关。"
		""
		"他的坠落似乎唤醒了深水中的某种东西。"
		""
		"找到地下墓穴，在他远古的统治回归前击败死国王。"
	]
	quest.46A80FACE8E0B76D.title: "死去的国王"
	quest.46E0A0A3E949910D.title: "遗忘的帷幕 (The Veil of Oblivion)"
	quest.46F9D13F99E3A668.title: "加固回响"
	quest.47056FB9433771BE.quest_desc: ["击败3位主世界的守护者后，还剩最后一位守护者。找到并击败它。"]
	quest.47056FB9433771BE.quest_subtitle: "击败被遗忘的守护者。（可选任务）"
	quest.47056FB9433771BE.title: "被遗忘的守护者 (The Forgotten Guardian)"
	quest.47267E01F6F2320D.quest_desc: ["回响碎片是用于制作邪典法术的组件。"]
	quest.4739457096DFD045.quest_desc: ["以下是一些关于生物和食物获取方式的任务"]
	quest.4739457096DFD045.title: "生物与食物"
	quest.47F52549B95BB882.quest_desc: ["使用铭文台向法术书添加新法术，扩展你的魔法武器库。"]
	quest.47F52549B95BB882.title: "添加法术（Adding Spells）"
	quest.4814504E9592378E.title: "佐兰斯的头盔"
	quest.484996BDBE43E4A2.quest_desc: ["这个降落伞会让你探索以太世界更轻松。祝你好运！"]
	quest.484996BDBE43E4A2.title: "降落伞"
	quest.48B01D7E2DCDA2EB.quest_desc: [
		"击败哥布林以获得黄金的访问权限！"
		"{entity:armageddon_mod:the_gobelin_lord ent_size:0.7 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.48B01D7E2DCDA2EB.title: "一枚奇怪的硬币"
	quest.490CDCFAF21D7B71.quest_desc: [
		"咒语书对任何法师都至关重要。它们能让你存储和使用咒语，是冒险途中施展魔法的主要方式。"
		""
		"更好的书籍拥有更多的法术位，并可能提供额外的魔法加成。"
		""
		"下方列出了可用的不同魔咒书，并介绍了它们的特点。"
	]
	quest.490CDCFAF21D7B71.title: "魔法书系列任务书"
	quest.4945E3C27D8DAE94.title: "Amulet of Convergence"
	quest.497AF824AB0510F3.quest_desc: [
		"被诅咒的骑士 Maledictus 拥有能将诅咒转化为魔法的黑暗力量。"
		""
		"击败第4章的Maledictus并夺取他的精华。只有这样，你才能开始掌握Maledictus的魔法。"
		"{entity:cataclysm:maledictus ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.497AF824AB0510F3.title: "Maledictus的诅咒"
	quest.4A17DF10D2C770CE.quest_desc: ["在世界地图 (M) 上标记你的传送门位置，因为返回主世界的唯一途径就是通过你来的那个传送门。"]
	quest.4A17DF10D2C770CE.title: "The Other Side"
	quest.4A6D94627BF0C167.title: "超稀有硬币"
	quest.4ACFC4970DAD0C41.quest_desc: [
		"在 Aetherbound RPG 中，一些主要按键绑定如下："
		""
		"查看你的起源：O"
		"主要和次要起源能力：G / H / J"
		"掷骰子：Alt"
		"锁定摄像头：按下鼠标中键（滚轮）"
		"召唤坐骑：X"
		"选择铁元素的法术：R"
		"施放法术：V"
		"打开背包：B"
		"地图：M"
		"技能树：K"
		""
		"建议在开始冒险前，先检查游戏的操作设置菜单。"
	]
	quest.4ACFC4970DAD0C41.title: "按键绑定"
	quest.4B2203DFD23F3366.quest_desc: ["使用卷轴锻造台来创造新法术，扩展你的魔法武器库。"]
	quest.4B2203DFD23F3366.title: "创造法术"
	quest.4B832440C71D0CA5.quest_desc: ["三个远古守护者已在被遗忘的土地苏醒：一个守护着失落的遗迹，一个被自然本身所吞噬，最后一个仍被封冻在冰中。你必须直面这三位，证明自己已准备好迎接更伟大的危险。"]
	quest.4B832440C71D0CA5.quest_subtitle: "击败3位主世界的守护者。（可选任务）"
	quest.4B832440C71D0CA5.title: "主世界的守护者 (The Guardians of the Overworld)"
	quest.4B958C39EEADD203.title: "精灵之心 (Heart of Elvenite)"
	quest.4BBF5A83F754432D.title: "Gravitite"
	quest.4BF8930546CE4BBC.quest_desc: ["制作一个连接器，并将其放置在桶/箱子上方"]
	quest.4C325CB55AD93CA6.quest_desc: [
		"沙漠中隐藏的不仅仅是被遗忘的遗迹。"
		"灼热的沙地之下，古老的生物正注视着地表的一举一动。旅人曾提及剧烈的震动、毒液之池，以及一种猎物尚未察觉便已发动袭击的生物。"
		"找到被埋藏的遗迹，终结沙之蠕虫 Sirok。"
		"{entity:block_factorys_bosses:sandworm ent_size:0.03 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.4C325CB55AD93CA6.quest_subtitle: "找到被埋藏的遗迹，终结西罗克。 (可选任务)"
	quest.4C325CB55AD93CA6.title: "灼热的沙地之下"
	quest.4CA67D848385C729.quest_desc: ["用于制作护甲的符文"]
	quest.4CB5870711862DAB.title: "战斗前的准备工作"
	quest.4CB83B2B72E74CF2.quest_desc: ["使用升级来增加魔导书的法术容量"]
	quest.4CB83B2B72E74CF2.title: "法术槽位升级"
	quest.4CE47AC0E92C42A7.title: "阿尔法螳螂"
	quest.4CFFB7081027FD2F.quest_desc: ["用这个指南针来定位结构物"]
	quest.4D2D811D8848A318.title: "超神秘礼物"
	quest.4D5B535A8CC80ECC.title: "进入星光领域 (Entering the Starlight Realm)"
	quest.4E1497FEDE833D92.title: "战斗前的准备工作"
	quest.4E62042C34197F7C.title: "战斗前的准备工作"
	quest.4F3FDC09C91F3AB2.quest_desc: ["用于制作护甲的符文"]
	quest.4F4FACC9874B92ED.title: "三大灾厄"
	quest.4FAA0CD2DD59F750.quest_desc: ["巨魔国王的军队由不同的战士组成。击败一只巨魔步兵和一只巨魔弓箭手，了解守护王国的部队。"]
	quest.4FAA0CD2DD59F750.title: "国王的士兵们"
	quest.4FE5662580CBC2B2.title: "被感染的维度 (The Infested Dimension)"
	quest.503088E4804DEFE6.title: "埃尔多拉斯的斧头"
	quest.5054CE63C3729CD5.quest_desc: ["每个垂钓者都始于第一杆。也许水域中有什么特别的在等着你。"]
	quest.5054CE63C3729CD5.quest_subtitle: "用普通鱼竿钓到任何东西。第一次钓到后，你的手中可能会出现新东西。"
	quest.5054CE63C3729CD5.title: "首次捕获"
	quest.515A02258E548206.quest_desc: [
		"带上宠物踏上旅途。要驯服更多仓鼠，先找到一个并用黄瓜片喂食。"
		"{entity:adorablehamsterpets:hamster ent_size:0.5 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.515A02258E548206.title: "旅途中的伙伴，与你同行"
	quest.517DCCE8A924B3EE.quest_desc: ["一群食人魔控制了这片土地的一部分。探索世界，寻找它们的踪迹。在进入它们的领地前做好准备，因为食人魔会互相保护，并且不会轻易忘记挑衅者。"]
	quest.517DCCE8A924B3EE.title: "食人魔领地"
	quest.518DF209FB8F53C1.title: "太阳霉菌"
	quest.521946BBFE710117.title: "被遗忘的深渊之主"
	quest.528357402133E1AF.quest_desc: ["{entity:antarchy:kraken ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"]
	quest.52D3D9A42D5421E5.quest_desc: [
		"在火海之下，存在着一种学会了在不应有生物的地方生存的生物。"
		"{entity:legendary_monsters:lava_eater ent_size:0.6 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.52D3D9A42D5421E5.quest_subtitle: "找到熔岩吞噬者巢穴，击败熔岩吞噬者，并收集它的皮。三张就足以开始制作防火装备了。"
	quest.52D3D9A42D5421E5.title: "熔岩巨兽"
	quest.5304EE5FEB32D630.quest_desc: ["水域因地点而异——其中的生物也是如此。想要掌握钓鱼技巧的人，必须了解每种生物的栖息地。"]
	quest.5304EE5FEB32D630.quest_subtitle: "捕捉三种来自不同环境的生物。"
	quest.5304EE5FEB32D630.title: "万水之鱼"
	quest.53120D2739D1A871.title: "前哨基地领袖"
	quest.5315F30948376707.quest_desc: ["你的日志里还有空白。与其等新物种偶然发现你的钩子，不如让鱼饵自己为你指明方向。"]
	quest.5315F30948376707.quest_subtitle: "钓鱼时使用Seeking Worm，帮助你发现尚未发现的物种。"
	quest.5315F30948376707.title: "探寻未知领域 (In Search of the Unknown)"
	quest.53B7A3003BC06F25.title: "秘密掉落物"
	quest.54115BCC04549A0F.quest_desc: [
		"龙的死亡开辟了通往未被触及岛屿的道路。其中，某物被合唱消耗，直至失去原形。"
		"{entity:legendary_monsters:endersent ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.54115BCC04549A0F.quest_subtitle: "在外围岛屿上找到远古塔遗迹，并击败末影人/紫颂人。它掉落的紫颂水晶会解锁与此进度相关的装备。"
	quest.54115BCC04549A0F.title: "紫颂感染事件"
	quest.5424845E7F0C40F6.quest_desc: ["用于制作护甲的符文"]
	quest.54981AAFD283186D.title: "佐兰之手"
	quest.54D45420A42EFA33.quest_desc: ["在你继续旅程时，木桶悄无声息地运作着。现在，是时候打开你的第一瓶了。"]
	quest.54D45420A42EFA33.quest_subtitle: "酿造你的第一瓶葡萄酒。"
	quest.54D45420A42EFA33.title: "第一瓶药水"
	quest.5531D08CE1B574EC.title: "骨头竞技场"
	quest.5540045E5A9A6F78.title: "灵魂竞技场"
	quest.55D03438D126C1AF.quest_desc: ["绿宝石是用于酿造附魔药水的一种材料。"]
	quest.55DA2D526DC4835F.quest_desc: ["有些洞穴里藏着能自己发光的果实。或许这种光芒在发酵过程中也能存活下来。"]
	quest.55DA2D526DC4835F.quest_subtitle: "酿造出阳光亲吻的葡萄酒。"
	quest.55DA2D526DC4835F.title: "瓶子里的光明"
	quest.56800FDFA9ED70CD.quest_desc: ["来自寒冷土地的葡萄有着普通藤蔓无法复制的特性。或许只需一点雪，就能将冬天本身装进瓶子里。"]
	quest.56800FDFA9ED70CD.quest_subtitle: "酿造艾斯葡萄酒。"
	quest.56800FDFA9ED70CD.title: "冰冻之地的葡萄酒"
	quest.56A885BCF529BE88.title: "常见的神秘礼物"
	quest.5708CD7FC80C92AD.title: "深海中的生活"
	quest.577E6DFF2DD2497C.quest_desc: [
		"制作探险家指南针；你将在旅途中经常使用它"
		"{image:kubejs:textures/quests/chapters/explorercompass.png width:100 height:50 align:center click_action:none:}"
	]
	quest.577E6DFF2DD2497C.title: "寻找结构物"
	quest.57C2A720695D14DF.quest_desc: ["对一些人来说，下雨是收竿避雨的理由。而对另一些人来说，这正是开始钓鱼的好时机。"]
	quest.57C2A720695D14DF.quest_subtitle: "利用暴风雨抓住一只雨鳍鱼。"
	quest.57C2A720695D14DF.title: "无论晴雨，风雨无阻"
	quest.57D79CAC51EE6627.quest_desc: ["购买一个哥布林来帮助你战斗"]
	quest.57D79CAC51EE6627.title: "购买一个哥布林（Golem）"
	quest.57F905E39AC866E0.title: "以太煤炭 (The Aether Coal)"
	quest.58CE386ED93B2984.quest_desc: [
		"在遗忘的废墟中，一个石制生物静止不动了数个世纪。据说，其锚的重量足以压垮任何试图穿越堡垒的人。"
		"{entity:legendary_monsters:ancient_guardian ent_size:0.6 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.58CE386ED93B2984.quest_subtitle: "找到远古堡垒，击败远古守卫者，并获得船锚手柄。"
	quest.58CE386ED93B2984.title: "远古守护者 (The Ancient Guardian)"
	quest.5924A580099FFA9A.quest_desc: ["该结构位于地下，有一条冰隧道将地表与避难所连接起来"]
	quest.5936F649F2FB6764.quest_desc: ["建议查看仓鼠指南，了解关于它们的一切信息"]
	quest.5936F649F2FB6764.title: "仓鼠指南"
	quest.5953E646AD2E4781.quest_desc: [
		"一座被火焰灼烧了数个世纪的塔楼，在地平线上拔地而起。"
		"大厅里满是比你先试图登顶之人的骸骨，但真正的统治者正等待在顶峰。火焰是它的武器，高塔是它的王座，就连你脚下的土地也可能无法在战斗中幸存。"
		"攀登巨龙塔，击败炎魔领主，那头地狱巨龙。"
		"{entity:block_factorys_bosses:infernal_dragon ent_size:0.7 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.5953E646AD2E4781.quest_subtitle: "攀登巨龙塔，击败炎魔领主，那头地狱巨龙。"
	quest.5953E646AD2E4781.title: "地狱皇冠 (The Infernal Crown)"
	quest.598FAFB74B677C82.quest_desc: ["随着奥格王的战败，他对矿石的控制权也消失了。找到沼泽铁矿，开采原始沼泽铁，并将其炼制成沼泽铁。"]
	quest.598FAFB74B677C82.title: "沼泽矿石 (The Bog Ore)"
	quest.5A11325AA2B7D452.title: "来自另一个时代的盔甲"
	quest.5A239C4C8FA37A22.quest_subtitle: "击败被斩首的骑士和复活的骑士"
	quest.5A2AEB6CEF698D35.title: "战斗前的准备工作"
	quest.5AA173774CED29EC.quest_desc: ["将沼泽铁矿石锻造成锭"]
	quest.5AA173774CED29EC.title: "沼泽铁"
	quest.5AA3B6C87521B87F.title: "The Bell"
	quest.5AAA618B781F4301.quest_desc: ["水面下的秘密，你已不再一无所知。或许，是时候将鱼线抛向光线罕至的深处了。"]
	quest.5AAA618B781F4301.quest_subtitle: "潜入世界深处，捕获一条海蓝宝石梭子鱼。"
	quest.5AAA618B781F4301.title: "最深处的投掷"
	quest.5AD830EAAFF8FD99.title: "战斗前的准备工作"
	quest.5B4D4D8299CAEF70.quest_desc: ["{image:kubejs:textures/quests/chapters/strangecoin.png width:100 height:50 align:center click_action:none:}"]
	quest.5B4D4D8299CAEF70.title: "战斗前的准备工作"
	quest.5B8CE9E1CE17BAAA.quest_desc: ["水面下出现金色的光芒。这不仅仅是另一个稀有物种——它是一种少数垂钓者才能有幸捕获的鱼。"]
	quest.5B8CE9E1CE17BAAA.quest_subtitle: "捕捉你的第一条星捕手金鱼。"
	quest.5B8CE9E1CE17BAAA.title: "黄金捕捞"
	quest.5B9579C5B05C6ED3.quest_desc: ["并非每次钓鱼都需要水。在末地的遥远之处，就连虚空也可能隐藏着等待鱼线抛入未知的生物。"]
	quest.5B9579C5B05C6ED3.quest_subtitle: "前往末地的外围岛屿，在空中钓鱼捕捉一只合唱鳟鱼。"
	quest.5B9579C5B05C6ED3.title: "异界垂钓者"
	quest.5BBB1538B5B5920D.quest_desc: ["用于制作护甲的符文"]
	quest.5C02F8153DA0369A.title: "来自深渊的呼唤"
	quest.5C2D3BA6631F0965.quest_desc: ["{image:kubejs:textures/quests/chapters/fierywither.png width:100 height:50 align:center click_action:none:}"]
	quest.5C2D3BA6631F0965.title: "战斗前的准备工作"
	quest.5C3F590774DF77E5.quest_desc: [
		"使用 Boss Summoner 并击败 Captain Cornelia。"
		"{entity:aquamirae:captain_cornelia ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.5C7CD0096605602E.title: "战斗前的准备工作"
	quest.5CDE9AD1BAD0712A.title: "Legends of the Overworld"
	quest.5D1A98F8485BDCDF.title: "你的第一张床"
	quest.5E6E6346692250D8.title: "虚空之花 (The Void Blossom)"
	quest.5EBB91B382544DC0.title: "血液盔甲"
	quest.5EC40A7CE5D13E91.quest_desc: [
		"此整合包由一人创作，耗费了大量心血；如果您愿意支持开发，可以点击下方链接："
		""
		"ko-fi.com/kyuu_"
		""
		"感谢您的关注以及任何形式的捐赠。"
	]
	quest.5EC40A7CE5D13E91.title: "请给我买杯咖啡 (Buy Me a Coffee)"
	quest.5EF90FB49A6004D3.quest_desc: [
		"🌟 感谢游玩！"
		""
		"如果你能读到这里，非常感谢你玩我的整合包！❤"
		""
		"这个项目完全由我一人完成，从创建进度、组织任务和章节，到冒险的每一个细节。为了达到我想要的效果，我付出了大量的心血和时间。"
		""
		"希望你玩得开心，探索了所有维度，击败了首领，并像我享受创造过程一样享受这段旅程。"
		""
		"如果你喜欢这个整合包，并希望支持项目继续运行，任何通过 Ko-fi 的捐赠都将不胜感激！☕❤"
		""
		"捐赠有助于支持开发，并为整合包的未来更新、新内容、改进和修复提供可能。"
		""
		"感谢您的支持和游玩！非常感谢！"
		""
		"下次冒险再见。 ⚔"
	]
	quest.5EF90FB49A6004D3.title: "以太束缚之王"
	quest.5F9FA0432B7ECA81.quest_desc: ["音符方块是用于制作音乐咒语的组件。"]
	quest.5FD185025CC423A8.quest_desc: ["始于几串野葡萄，终成一门艺术。从主世界的藤蔓到域外之果，你的酒窖里珍藏着旅途中的所有回忆。"]
	quest.5FD185025CC423A8.quest_subtitle: "成为一名酿酒大师。"
	quest.5FD185025CC423A8.title: "酿酒大师"
	quest.6057DE1171DEA45B.title: "资源"
	quest.60616D59B9FB05E3.title: "崭新的地平线"
	quest.60A422FC709713E9.title: "太空竞技场"
	quest.60D4967678A6512E.title: "深渊的制图师 (Cartographer of the Abyss)"
	quest.610B78585D49D389.title: "开启旅程"
	quest.6111C6A96EFE1CD7.quest_desc: [
		"收下模组作者这份礼物。与你的羽毛朋友一同踏上旅程。按 X 键呼唤它。"
		"{entity:minecraft:horse ent_size:0.5 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.6111C6A96EFE1CD7.title: "A Mount for Your Journey"
	quest.6115C10A8AA82B70.quest_desc: [
		"是时候终结部落的统治了。在堡垒中心找到巨魔之王并将其击败。战斗有多阶段，请做好迎接真正首领战的准备。"
		"{entity:kingsandmonsters:ogre_lord ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:USE_GLOBAL width:100 height:100 align:center}"
	]
	quest.6115C10A8AA82B70.title: "巨魔之王"
	quest.6189945F00D4163B.quest_desc: ["国王不会在你入侵他的堡垒时坐以待毙。克服皇家防御，击败阻挡王座之路的精英守卫。"]
	quest.6189945F00D4163B.title: "国王的防御"
	quest.620B3C75FD8328BF.title: "深渊的制图师 (Cartographer of the Abyss)"
	quest.6236BF4105CFE821.quest_desc: ["击败奥格弓箭手时有几率掉落物品"]
	quest.62609EBEC6F9855D.title: "被遗忘的归来"
	quest.63077C20BE340FE4.quest_desc: ["果汁可以解渴。时间、耐心和发酵可以将其变成完全不同的东西。"]
	quest.63077C20BE340FE4.quest_subtitle: "建造一个发酵桶。"
	quest.63077C20BE340FE4.title: "发酵的艺术"
	quest.631329F8DD049D63.title: "通用硬币"
	quest.6332C7553A62E032.title: "被遗忘的城市"
	quest.638B1E71897A1D9D.title: "翡翠之剑"
	quest.64866AD89BC491CC.quest_desc: ["在深处，连最细微的声音都可能唤醒可怕的事物，一种奇特的生物潜伏在潜声之中。或许，再冒险投掷一次是值得的。"]
	quest.64866AD89BC491CC.quest_subtitle: "探索深暗的深处，捕捉一条史诗稀有度的潜行鱼。"
	quest.64866AD89BC491CC.title: "史诗般的捕获"
	quest.6509CAD3333A1BBD.quest_desc: ["运气可能是一个因素。多种不同物种的收集，才是一个真正的收藏的开始。"]
	quest.6509CAD3333A1BBD.quest_subtitle: "发现不同种类的星捕者，扩展你的钓鱼日志。"
	quest.6509CAD3333A1BBD.title: "收藏家"
	quest.653A54438966436B.quest_desc: ["用于制作护甲的符文"]
	quest.6553ABC67A66A3DB.title: "降临于地下花园 (Undergarden)"
	quest.66030CBE136901E4.quest_desc: ["用于制作护甲的符文"]
	quest.668872E31E432776.title: "开启天空的奥秘"
	quest.66C911A45FBB62D8.quest_desc: ["用于制作护甲的符文"]
	quest.66DF7016A2E9BEB3.title: "泰坦矿石"
	quest.66E7928D2A646E5E.quest_desc: ["酿造一瓶酒只是个演示。不同的配料和葡萄品种可以酿出完全不同的饮品。"]
	quest.66E7928D2A646E5E.quest_subtitle: "酿造出两种不同的葡萄酒。"
	quest.66E7928D2A646E5E.title: "藤蔓的两副面孔"
	quest.6735FA2CF258371D.quest_desc: [
		"世界被古老的封印所束缚。"
		""
		"长久以来，守卫者一直将最强大的力量封印。铁、金、钻石，乃至远超它们的势力，都束缚在那些必须被击败的生物之上，唯有击败它们，力量才能被释放。"
		""
		"你的旅程始于微小，但很快便超越了已知世界的边界。冰封的海洋、被遗忘的深海、天界与未知维度，隐藏着比你更早存在的生物与文明。"
		""
		"每击败一个敌人，新的力量便会释放——但取而代之的，是某种更强大的存在苏醒。"
		""
		"末影龙的死亡打破了最后的平衡，开启了新的纪元。巨兽、灾难和沉睡的实体开始显现，而你所在世界之外的世界也变得可访问。"
		""
		"到最后，只有一个问题会留存在你的心中："
		""
		"你将成为又一个冒险者... 还是会成为 Aetherbound 之王？"
	]
	quest.6735FA2CF258371D.title: "物品描述"
	quest.6749D6E03CC0B2F2.title: "通往卡瓦林的大门"
	quest.67540C80200695AA.quest_desc: ["找到巨魔堡垒并攻破城墙。带上充足的食物、药水和设备：这将是一场漫长的入侵。"]
	quest.67540C80200695AA.title: "巨魔堡垒"
	quest.682F24BC7537FB9E.title: "传送门守护者"
	quest.69E5FFE3BA8C6253.quest_desc: ["将面板放置在连接器的前方"]
	quest.6A725A1654C89B42.quest_desc: [
		"一位战士在生死之间徘徊了太久。他残存的荣誉，如今与某种更黑暗的东西共存于同一副躯体之中。"
		"{entity:legendary_monsters:posessed_paladin ent_size:0.7 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.6A725A1654C89B42.quest_subtitle: "找到废弃的墓穴并击败被附身的圣骑士。第二阶段，他会变成奥里昂，破碎的预兆。击败后可获得腐化之魂和灵魂巨剑。"
	quest.6A725A1654C89B42.title: "圣骑士的灵魂"
	quest.6A79F7ADB4583853.title: "至尊盔甲"
	quest.6AA30C4B8C6A7A9D.quest_desc: ["末影珍珠是用于制作末影法术的组件。"]
	quest.6B1C89636C5A15AA.title: "雪地上的足迹"
	quest.6B1EA0A4E997D028.title: "深渊的守护者"
	quest.6B3A1E2586FEE6F6.title: "一个被遗忘的地方"
	quest.6BC56D683346BF17.quest_desc: ["据说水中隐藏着海神亲自赐予的宝藏。很少有垂钓者见过它——更少有人能将其打捞上岸。"]
	quest.6BC56D683346BF17.quest_subtitle: "通过水产养殖钓鱼获得一份海神宝藏。"
	quest.6BC56D683346BF17.title: "海神的宝藏"
	quest.6BDC672084788368.quest_desc: ["找到 Boss Summoner，但先不要使用它。"]
	quest.6D475E6F9A96ADD7.title: "已获得的权限"
	quest.6D68660D2CEFB064.title: "遗失的宝剑"
	quest.6DF9495A1206DC56.title: "进化"
	quest.6E5978CEF9AAD7D8.quest_desc: ["本章结束。从现在开始，你将进入困难模式。龙的死亡撼动了世界的基础。沉睡已久的力量现在开始苏醒。世界已经进入了一个新时代。"]
	quest.6E5978CEF9AAD7D8.title: "群星之主"
	quest.6E95452F5D512EA9.quest_desc: [
		"下界保存了一只本应死亡数千年的生物的残骸。它的骨骼仍然饥饿。"
		"{entity:legendary_monsters:skeletosaurus ent_size:0.6 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.6E95452F5D512EA9.quest_subtitle: "在灵魂沙谷中寻找骷髅龙巢并击败骷髅龙。它的恐龙骨骼可用于制作武器和盾牌。"
	quest.6E95452F5D512EA9.title: "仍在行走的骸骨"
	quest.6EE6E62ADE9725F5.title: "准备好迎接冒险了吗"
	quest.6F2410B072873A07.title: "乌姆武塔纳小树林"
	quest.6F3672EB184F4456.title: "降临于地下花园 (Undergarden)"
	quest.6F3BFCAD194AE1D9.title: "毁灭的先驱者"
	quest.6F63A30ECA06752E.title: "巨像 (The Colossus)"
	quest.705F8EC3DDECA6B4.quest_desc: ["了解水域与了解如何抛竿同样重要。某些物种只在特定的地点、时间和条件下出现。"]
	quest.705F8EC3DDECA6B4.quest_subtitle: "获取《星捕者指南》，查看世界各地可发现的鱼类信息。"
	quest.7108066E664EB0AA.title: "泰坦之锤（The Hammer of the Titans）"
	quest.7131BA8E95B7F1CA.title: "冰冻竞技场"
	quest.7141365593916C91.quest_desc: [
		"有什么东西在车站的走廊里四处游荡，从未停歇。自你进入以来，它就清楚地知道你所在的位置。"
		"{entity:legendary_monsters:annihilation_pursuer ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.7141365593916C91.quest_subtitle: "击杀湮灭追踪者 (Annihilation Pursuer)"
	quest.7141365593916C91.title: "虚空中的追逐"
	quest.71571F0D987D986A.title: "反向重力"
	quest.716215A5E83F6A72.title: "阿瑞翁之心"
	quest.71BA6BF2BD021957.quest_desc: [
		"在末地的深处，一位古老的战士仍在守护着一座被遗忘的大厅。"
		"Helvar 并非受饥饿或本能驱使的野兽。他观察对手，抓住每个破绽，惩罚每一次轻率的攻击。无数战士曾踏入他的竞技场，以为仅凭力量便足以取胜。"
		"进入下界，向他们证明自己的想法是正确的。"
		"{entity:block_factorys_bosses:underworld_knight ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:FORCE_ON width:100 height:100 align:center}"
	]
	quest.71BA6BF2BD021957.quest_subtitle: "下降到下界堡垒，向 Helvar 发起挑战。"
	quest.71BA6BF2BD021957.title: "世界之下的骑士 (The Knight Beneath the World)"
	quest.71D92FFCC6D2AD26.quest_desc: ["用于制作护甲的符文"]
	quest.72214E08328973A3.quest_desc: ["这可不是一根普通的鱼竿。有了它，水中会出现你用旧装备永远也找不到的鱼类。"]
	quest.72214E08328973A3.quest_subtitle: "使用你的新鱼竿，在现实世界的水域中捕获一条漂流鳍。"
	quest.72214E08328973A3.title: "一种全新的钓鱼方式"
	quest.7339D51241310813.title: "石头和煤炭"
	quest.7375858C84100327.title: "盔甲"
	quest.73826580A38C8E37.quest_desc: ["这是自动存储指南。首先在地上放置10个桶"]
	quest.73826580A38C8E37.title: "自动存储系统"
	quest.73B9E8D2C1F86096.quest_desc: ["墨水用于卷轴锻造台来创造法术。墨水的稀有度决定了所创造法术的稀有度。"]
	quest.73B9E8D2C1F86096.title: "墨水"
	quest.755191A49F166FAB.title: "葡萄酒窖"
	quest.75B6260E92D81DD0.title: "地下墓穴"
	quest.75EA10BEA47F4E71.quest_desc: ["田野和森林中生长着乍看之下平平无奇的水果。但对于深知其价值的人来说，每一串都可能开启一项新的传统。"]
	quest.75EA10BEA47F4E71.quest_subtitle: "找到你的第一批葡萄品种。"
	quest.75EA10BEA47F4E71.title: "最初的藤蔓 (The First Vines)"
	quest.763088EB7127212F.title: "资源 +"
	quest.766A4290391E0463.title: "三大灾厄"
	quest.766D6688DD5CD8CE.title: "催化剂 (The Catalyst)"
	quest.76750343D9292A62.quest_desc: ["起源能力：G"]
	quest.767EDA6A5C66805C.title: "在陨落战士的足迹上前行"
	quest.76A9470675FEC4EF.quest_desc: ["欢迎来到钓鱼指南！在这里你将成为一名真正的垂钓者"]
	quest.76A9470675FEC4EF.title: "渔夫指南"
	quest.76D8D4F7CD644BA4.quest_desc: ["Aetherbound RPG 中有多种武器可供选择。选择最适合你的武器，然后制作一把吧！"]
	quest.76D8D4F7CD644BA4.title: "多项选择"
	quest.770D5F42CC2FE19A.title: "毁灭的力量"
	quest.771E03A821C3A109.title: "一份欢迎礼物"
	quest.773A38883BD816A0.title: "鱼"
	quest.77775ABCCB931FFC.quest_desc: ["当太阳消失时，水面并不会空无一物。有些生物只是在等待黑暗降临才开始行动。"]
	quest.77775ABCCB931FFC.quest_subtitle: "在夜间钓鱼时捕获一条漂流鲷鱼。"
	quest.77775ABCCB931FFC.title: "夜间垂钓"
	quest.777A61F14019CC59.quest_desc: ["击败奥格守卫时有几率掉落物品"]
	quest.77AC53614997C602.title: "出血图腾"
	quest.77F967F9575340A2.quest_desc: ["有毒土豆是用于制作自然法术的组件。"]
	quest.78609208820DC858.quest_desc: ["使用此石头可传送到传送石处"]
	quest.786863127D8EFFEA.title: "神秘鱼饵"
	quest.7880C958EE1E8753.title: "Moa驯养师"
	quest.78A8A4197649B0DE.title: "黄金餐盘"
	quest.78D0F342BE94BE5E.quest_desc: ["后悔旅途开始时选择的起源/职业吗？带上这2个球体来改变你的起源/职业。注意，使用2次后将无法再次更改。"]
	quest.78D0F342BE94BE5E.title: "更改职业"
	quest.7907F8359B4A2EFC.quest_desc: ["用于制作护甲的符文"]
	quest.790CB124F9105E07.quest_desc: ["击败奥格暴徒时有几率掉落物品"]
	quest.790E30B23C1D9E60.title: "由潜声锻造而成"
	quest.799304D183D1D3A0.title: "密封瓶 (Sealed Flask)"
	quest.79AFCF1A801CC5F2.quest_desc: ["在末地的深处，两具腐化生物在废墟中苏醒：诞生于扭曲的合唱之根的合唱体，以及以粗心旅者为食的活陷阱——拟态潜行贝。你必须击败两者，证明自己已准备好直面末地的真正恐怖。"]
	quest.79AFCF1A801CC5F2.quest_subtitle: "击败末地的2位守护者。（可选任务）"
	quest.79AFCF1A801CC5F2.title: "末地的守护者 (The Guardians of the End)"
	quest.79EB16CA73D5484C.title: "终末即将来临"
	quest.7A2AB7C520022C1A.title: "迷宫之母"
	quest.7A51031ED4697CB0.quest_desc: ["{image:kubejs:textures/quests/chapters/emeraldtotem.png width:100 height:50 align:center click_action:none:}"]
	quest.7A51031ED4697CB0.title: "战斗前的准备工作"
	quest.7C0A36DE2BBE7B7C.quest_desc: ["至尊法杖在装备时可为你的法术提供加成，提升其威力或赋予特定学派独有的益处。"]
	quest.7C0A36DE2BBE7B7C.title: "至尊法杖系列"
	quest.7C3298CDA5195155.title: "潜水装备"
	quest.7C613DBA934ECC40.title: "不要发出任何声音……"
	quest.7C77662F8461D9E2.title: "Aquaculture 鱼竿"
	quest.7CB93FA200CDEC8F.title: "太阳之眼 (The Eye of the Sun)"
	quest.7CE442AC50F5624A.title: "日食锭（Eclipse Ingot）"
	quest.7CE78C921F327ED3.quest_desc: ["Cinder Essence 用于制作升级球，对于强化你的魔法装备至关重要。"]
	quest.7D093A501C312186.title: "以太石 (The Aether Stone)"
	quest.7D2FD0B0D96DDCA6.title: "Zenithian 头骨"
	quest.7D34F132CBF31623.title: "一个被遗忘的地方"
	quest.7DF29134059E1F8B.quest_desc: ["平静的湖泊和开阔的海洋看似只是一片水域，但它们的水下却栖息着截然不同的生物。"]
	quest.7DF29134059E1F8B.quest_subtitle: "在湖泊中捕获一条 Driftfin，在海洋中捕获一条 Sea Bass。"
	quest.7DF29134059E1F8B.title: "了解你的水域"
	quest.7E306489B915B4DC.quest_desc: [
		"Arcane Essence 是 Iron's Spells 'n Spellbooks 的主要资源之一。可用于制作魔法材料和装备，包括 Arcane Cloth 和 Arcane Ingots。"
		""
		"你可以在探索建筑和击败魔法生物时找到它。找到后务必收集并保存——它在你的整个旅程中都会非常重要。"
	]
	quest.7E4504183939E194.quest_desc: ["在 Aetherbound 中，你可以建造空中交通工具来方便探索，这非常简单。附近会有一些任务，教你如何制作第一架飞行器。要了解该模组的更多信息，请在 JEI 中输入 @aircraft。"]
	quest.7E4504183939E194.title: "空中运输"
	quest.7F427B0AE18E0685.quest_desc: ["在远古神殿中找到秘密区域/战利品"]
	quest.7F427B0AE18E0685.title: "神庙的秘密"
	quest.7FC3044C723F95FC.title: "通往索拉克斯的传送门"
