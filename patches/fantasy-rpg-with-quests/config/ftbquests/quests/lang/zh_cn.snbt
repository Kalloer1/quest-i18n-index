# AI 初翻，未人工校对
{
	chapter.0C77713C9E0486E8.title: " &a&l第 2 章"
	chapter.49001691E87B5D90.title: " &a&l第 1 章"
	file.0000000000000001.title: " &f&l奇幻角色扮演游戏"
	quest.006FA8D32BD64B60.quest_desc: ["&f&a死城弩炮 &f是一种威力惊人的巨型远程&a武器 &f。&f它无法被制造，只能在危险的建筑中找到，或由首领掉落。&f它的射击能轻易摧毁敌人。&f这是一件足以载入传奇的武器。"]
	quest.006FA8D32BD64B60.quest_subtitle: "&7释放攻城级别的毁灭力量"
	quest.006FA8D32BD64B60.title: "&5&l任务： &r&e死城弩炮"
	quest.007E858026484EFC.quest_desc: ["&f在一头陨落巨龙的遗骸中，隐藏着一股强大的&a力量。&f通过取出&a冰龙之心 &f，你将获得用于高级锻造的关键组件。&f这件稀有物品是制造冰附魔&a龙锻核心 &f所必需的。&f只有能抵御严寒的人，才能夺得这件强大的神器。"]
	quest.007E858026484EFC.quest_subtitle: "&7夺取冰龙的精华"
	quest.007E858026484EFC.title: "&5&l任务： &r&e冰封核心的心脏"
	quest.02694EAE2D26B2C2.quest_subtitle: "&7找到末地船"
	quest.02694EAE2D26B2C2.title: "&5&l任务： &r&e末地船"
	quest.029137AD5A2BE2BF.quest_desc: ["&f&a水之套装 &f是一套主要由&a海带 &f锻造而成的魔法盔甲，能引导水那平静而又源源不断的力&f量。穿戴它时，你的&a水系力量 &f将提升 &a25%，&f使其成为追随潮汐的法师们的绝佳选择。&f与基础元素套装不同，这套盔甲可以&a使用 &f&a下界合金 &f和特殊的锻造模板进行&f升级。<c17>只有将其精炼到超越原始形态的人，才能展现它的真正实力。"]
	quest.029137AD5A2BE2BF.quest_subtitle: "&7打造注入水之力量的盔甲"
	quest.029137AD5A2BE2BF.title: "&5&l任务： &r&e水之套装"
	quest.034243CD7B4F44DC.quest_desc: ["&f在无尽的黑暗中，致命的&a夜行者 &f正在狩猎，这是一种由黑夜赋予力量的生物。&f它的速度和难以捉摸的特性使其成为一种危险的&a威胁。&f请保持&a警惕，&f不要让阴影吞噬你。&f只有做好准备的人才能在它的狩猎中幸存。"]
	quest.034243CD7B4F44DC.quest_subtitle: "&7击败黑夜的阴影"
	quest.034243CD7B4F44DC.title: "&5&l任务： &r&e夜行者"
	quest.04F49A7F4A58EA2B.quest_desc: ["&f由稀有资源打造的武器蕴含着纯粹的&a力量。&f&a夜幕 &f的锻造需要 &a冰晶 &f和一颗灵魂。&f其黑暗能量能增强你的战斗潜力。&f只有拥抱阴影的人才能驾驭它。"]
	quest.04F49A7F4A58EA2B.quest_subtitle: "&7打造一件黑暗武器"
	quest.04F49A7F4A58EA2B.title: "&5&l任务： &r&e夜幕"
	quest.054225F80316E273.quest_desc: ["&f源自最黑暗之处的 &a暗影刺客镰刀，&f是一件致命而稀有的 &a武器。&f它无法被锻造，只能通过探索发现或从首领处获得。&f它的攻击迅疾而致命。&f对于潜行于无形之中的勇士而言，它堪称完美利器。"]
	quest.054225F80316E273.quest_subtitle: "&7夺取这柄无声死神的武器"
	quest.054225F80316E273.title: "&5&l任务：&r&e暗影刺客镰刀"
	quest.05460276F04B2ACA.quest_desc: ["&f强大的 &a混沌君主 &f已然现身，成为一股危险的威胁，它掌控着混沌魔法与黑暗 &a力量。&f这位亡灵术士能在战斗中召唤致命的 &a仆从 &f来压垮你。&f请保持 &a警惕 &f，在战局失控前掌控战况。&f击败它将证明你足以对抗混沌本身。"]
	quest.05460276F04B2ACA.quest_subtitle: "&7击败混沌的亡灵术士"
	quest.05460276F04B2ACA.title: "&5&l任务：&r&e混沌君主"
	quest.057C250E40DA00FD.quest_desc: ["&f与普通遗物不同，&a水之球 &f不会直接提升属性。&f相反，它可能在战斗中触发临时的 &a战斗效果 &f，在关键时刻发挥出决定性作用。&f它是一种稀有遗物，只能从 &a战利品宝箱 &f中获得，或是在击败危险的 &a首领后掉落。"]
	quest.057C250E40DA00FD.quest_subtitle: "&7获取一件拥有强大战斗效果的遗物"
	quest.057C250E40DA00FD.title: "&5&l任务：&r&e水之球"
	quest.057E6C48BA6A16CA.quest_desc: ["&f借助火焰之力，这件工具赋予了无与伦比的&a力量。&f&a火龙钢稿&f能够极其&a高效地开采最坚硬的物质。&f没有任何东西能够抵挡它炽热的力量。&f它将辛劳化为轻松。"]
	quest.057E6C48BA6A16CA.quest_subtitle: "&7制作一把火龙钢稿"
	quest.057E6C48BA6A16CA.title: "&5&l任务：&r&e火龙钢稿"
	quest.058B503F8EC03093.quest_desc: ["&f与普通遗物不同，&a鹰眼&f并不提供简单的属性加成。&f它的力量在于能在关键时刻触发的临时&a战斗效果&f，从而在战斗中为你带来重要的优势。&f它只能在&a战利品箱&f中或击败强大的&a首领后获得。"]
	quest.058B503F8EC03093.quest_subtitle: "&7获得一件具有强大战斗效果的遗物"
	quest.058B503F8EC03093.title: "&5&l任务：&r&e鹰眼"
	quest.05974470BFFABD60.quest_desc: ["&f&a滴水石项链&f是一种较为常见的魔法饰品，能提供虽不显著却很有用的加成。&f它能提升你的&a最大生命值&f并增强你的&a反射攻击，&f是提升生存能力和反击能力的可靠选择。"]
	quest.05974470BFFABD60.quest_subtitle: "&7制作一件具有防御能力的简易项链"
	quest.05974470BFFABD60.title: "&5&l任务：&r&e滴水石项链"
	quest.0631DED46464FF7D.quest_subtitle: "&7找到强盗塔"
	quest.0631DED46464FF7D.title: "&5&l任务：&r&e强盗塔"
	quest.06BE56E7F4F434C1.quest_subtitle: "&7找到更坚固的堡垒"
	quest.06BE56E7F4F434C1.title: "&5&l任务：&r&e更坚固的堡垒"
	quest.06F4E47FE20759A3.quest_subtitle: "&7获得腐化之眼"
	quest.06F4E47FE20759A3.title: "&5&l任务：&r&e腐化之眼"
	quest.088FB81B8E9EA695.quest_desc: ["&f要面对这个世界的危险，你需要适当的&a防护。&f铁矿可以在&a山脉 &f或地表深处的洞穴中找到。&f只要有足够的铁矿，你就能打造一套完整的&a铁质盔甲 &f，从而大大提高你的生存几率。&f装备精良的冒险者要难对付得多。"]
	quest.088FB81B8E9EA695.quest_subtitle: "&7为接下来的战斗积蓄力量"
	quest.088FB81B8E9EA695.title: "&5&l任务： &r&e铁中锻造"
	quest.08A5846B61398655.quest_desc: ["&f在危险的地方隐藏着&a灾变之刃， &f这是一把蕴含纯粹&a力量的武器。&f它只能通过探索或击败强大的敌人来获得。&f它的破坏力无与伦比。&f很少有人有资格挥舞它。"]
	quest.08A5846B61398655.quest_subtitle: "&7获得一把毁灭性武器"
	quest.08A5846B61398655.title: "&5&l任务： &r&e灾变之刃"
	quest.0917C53E63C92D1F.quest_subtitle: "&7从各种魔法矿石中开采一颗宝石"
	quest.0917C53E63C92D1F.title: "&5&l任务： &r&e蓝宝石"
	quest.091FC3DD9FE241D3.quest_subtitle: "&7用空气与下界合金打造一根强化法杖"
	quest.091FC3DD9FE241D3.title: "&5&l任务： &r&e下界合金风之杖"
	quest.094F662AE0616188.quest_desc: ["&f有了&a蓝宝石， &f你就能打造出坚固的戒指和项链，提升你的&a最大生命值。&f这些饰品能为必须直面前方危险的冒险者提供更强的生存能力。"]
	quest.094F662AE0616188.quest_subtitle: "&7打造能提升最大生命值的戒指和项链"
	quest.094F662AE0616188.title: "&5&l任务： &r&e蓝宝石饰品"
	quest.0A3BCCC02B9FC2F9.quest_desc: ["&f超越钢铁与力量，这片广袤的世界充满了等待被发现的古老 &a魔法 &f。&f你将探索神秘之地，面对强大的 &a首领 &f，并揭开隐藏的秘密。&f沿途，你将获得附魔 &a装备 &f，其能力与不同元素相关联。&f掌握这些力量的人，将能施展超乎想象的神力。"]
	quest.0A3BCCC02B9FC2F9.quest_subtitle: "&7发现世界中的魔法"
	quest.0A3BCCC02B9FC2F9.title: "&5&l任务：&r&e奥术觉醒"
	quest.0AFD63767C5BB8B1.quest_subtitle: "&7找到地下墓穴"
	quest.0AFD63767C5BB8B1.title: "&5&l任务：&r&e地下墓穴"
	quest.0BC03E0589949994.quest_desc: ["&f&a下界合金水之套装 &f可以使用 &a高级护甲 &f锻造模板和稀有的 &a监守者失落水晶 &f重铸为其最终的 &a飞升形态。&f这种强大的水晶可以在战利品箱中找到，也可以通过击败强大的敌人（如 &a监守者 &f或 &a末影龙）获得。&f升级后，该套装将获得额外的 &a5% &f水之力，使其总加成从 &a30% 提升至 35%。&f对于掌握潮汐之力的人来说，这才是护甲的真正巅峰。"]
	quest.0BC03E0589949994.quest_subtitle: "&7锻造水之护甲的最终形态"
	quest.0BC03E0589949994.title: "&5&l任务：&r&e飞升水之套装"
	quest.0C6A70C1719A8075.quest_desc: ["&f&a下界合金泰拉套装 &f可以使用 &a高级护甲 &f锻造模板和稀有的 &a监守者失落水晶 &f重铸成最终的 &a飞升形态。&f这种强大的水晶可以在战利品箱中找到，也可以通过击败强大的敌人（如 &a监守者 &f或 &a末影龙）来获得。&f升级后，该套装将获得额外的 &a5% &f大地之力，使其总加成从 &a30% 提升至 35%。&f意志如磐石般坚定之人，终将发掘出其中隐藏的终极力量。"]
	quest.0C6A70C1719A8075.quest_subtitle: "&7锻造终极大地护甲"
	quest.0C6A70C1719A8075.title: "&5&l任务： &r&e飞升泰拉套装"
	quest.0C757ED3FA6A4992.quest_desc: ["&f将精炼下界合金与铁融合，即可解锁全新层次的 &a力量。&f&a下界合金铁锭 &f能让你将装备进一步升级。&f用它强化的护甲可提供更高的 &a抗性 &f以及针对幻翼的独特能力。&f就连天空也无法再对你构成威胁。"]
	quest.0C757ED3FA6A4992.quest_subtitle: "&7结合力量与韧性"
	quest.0C757ED3FA6A4992.title: "&5&l任务： &r&e下界合金铁锭"
	quest.0D7C8B4F7DDAAFEA.quest_subtitle: "&7找到废弃神庙"
	quest.0D7C8B4F7DDAAFEA.title: "&5&l任务： &r&e废弃神庙"
	quest.0D8A93494D61C1A5.quest_subtitle: "&7获取盗贼之眼"
	quest.0D8A93494D61C1A5.title: "&5&l任务： &r&e盗贼之眼"
	quest.0DF6B45977ABBC29.quest_desc: ["&f通过这项融合，你的装备达到了全新的&a力量水平。&f使用&a下界合金翡翠锭 &f升级你的护甲，提升其&a抗性。&f这套护甲能让你无所畏惧地直面末影人。&f就连他们的凝视也无法对你构成威胁。"]
	quest.0DF6B45977ABBC29.quest_subtitle: "&7使用翡翠融合升级你的护甲"
	quest.0DF6B45977ABBC29.title: "&5&l任务： &r&e下界合金翡翠护甲"
	quest.0E534C747F5DE1F2.quest_desc: ["&f借助火焰的能量，就连农作也能获得新的&a力量。&f&a火龙钢锄 &f能以无与伦比的&a效率整备土地。&f它能确保你的资源像你的力量一样稳步增长。&f掌控之力已超越战场本身。"]
	quest.0E534C747F5DE1F2.quest_subtitle: "&7制作一把火龙钢锄"
	quest.0E534C747F5DE1F2.title: "&5&l任务： &r&e火龙钢锄"
	quest.0EF1224480AE5C14.quest_desc: ["&f在冠军墓穴深处，沉睡着令人畏惧的&a尸鬼，&f一位与不死之身紧密相连的远古战士。&f虽然它没有强大的&a生命值，&f但它挥舞的利刃会根据一天中的不同时间而变得更强。&f保持&a警惕，&f明智地选择出手时机。&f击败它将证明你战胜资深强者的实力。"]
	quest.0EF1224480AE5C14.quest_subtitle: "&7击败堕落的尸鬼战士"
	quest.0EF1224480AE5C14.title: "&5&l任务： &r&e远古冠军"
	quest.0F387AF5DBF5F171.quest_subtitle: "&7制作一根注入了大地之力的魔杖"
	quest.0F387AF5DBF5F171.title: "&5&l任务： &r&e大地魔杖"
	quest.0F72DD9205AE4757.quest_desc: ["&f这件工具由冰之精华赋能，蕴含着强大的&a力量。&f&a冰龙钢斧&f能以受控的&a力量发动强力打击。&f它在战斗和采集方面都表现出色。&f其冰冷的刃口切割精准利落。"]
	quest.0F72DD9205AE4757.quest_subtitle: "&7锻造一把冰龙钢斧"
	quest.0F72DD9205AE4757.title: "&5&l任务：&r&e冰龙钢斧"
	quest.106870ECE1AF1459.quest_subtitle: "&7找到骸骨地牢"
	quest.106870ECE1AF1459.title: "&5&l任务：&r&e骸骨地牢"
	quest.1082FFD35DF5ED60.quest_desc: ["&f将&a风之套装 &f与 &a下界合金 &f及特殊的锻造模板重新锻造，即可解锁其更强大的 &a下界合金形态。&f这套升级后的护甲在保留其与天空联系的同时，也放大了其元素力量。&f其风力加成从 &a25% 提升至 30%，&f相比基础套装额外获得 &a5% &f的加成。&f唯有顺应气流之人，方能真正唤醒其全部潜力。"]
	quest.1082FFD35DF5ED60.quest_subtitle: "&7用下界合金升级你的风之护甲"
	quest.1082FFD35DF5ED60.title: "&5&l任务：&r&e下界合金风之套装"
	quest.108990BC7FDF2D43.quest_desc: ["&f世界各地散落着独特的 &a遗物 &f，其形态灵感源自远古生物。&f这些物品能为魔法和物理能力提供强大的 &a加成 &f。&f若你选择魔法之路，则必须根据自身的元素特性，慎重决定要提升哪些 &a属性 &f。&f真正的精通源于对自身力量的理解。"]
	quest.108990BC7FDF2D43.quest_subtitle: "&7驾驭神秘器物的力量"
	quest.108990BC7FDF2D43.title: "&5&l任务： &r&e古代遗物"
	quest.110FE8E77484E7CB.quest_desc: ["&f在隐秘洞穴的深处，栖息着可怕的 &a火龙，这是一种拥有巨大力量和毁灭能力的生物。 &f它的 &a火焰 &f能在数秒内将最强大的战士化为灰烬。 &f要直面它，你必须做好充分 &a准备 &f，为残酷的战斗做好准备。 &f击败这头巨兽将证明你的实力，并标志着你的传奇就此开始。"]
	quest.110FE8E77484E7CB.quest_subtitle: "&7击败火龙"
	quest.110FE8E77484E7CB.title: "&5&l任务： &r&e火焰征服者"
	quest.1187CC93697EDA75.quest_desc: ["&f在直面黑夜的危险之前，你必须做好妥善 &a准备。 &f利用铁，你可以打造一把可靠的 &a武器 &f来对抗敌对生物。 &f一把 &a铁剑 &f将极大地提升你在战斗中的胜算。 &f每位战士都需要一把利刃来开启自己的旅程。"]
	quest.1187CC93697EDA75.quest_subtitle: "&7打造你的第一把铁剑"
	quest.1187CC93697EDA75.title: "&5&l任务： &r&e生存之刃"
	quest.118F0E846E2979F1.quest_desc: ["&f这件工具注入了炽热的能量，蕴含着巨大的 &a力量。 &f这把 &a火龙钢斧 &f能以强大的力量和巨大的 &a威力进行打击。 &f无论是在战斗中还是采集时，它都能出色地完成每一项任务。 &f它的火焰会让任何东西都难以久存。"]
	quest.118F0E846E2979F1.quest_subtitle: "&7打造一把火龙钢斧"
	quest.118F0E846E2979F1.title: "&5&l任务： &r&e火龙钢斧"
	quest.11BA1BF6F62B947C.quest_subtitle: "&7找到闪电龙洞穴"
	quest.11BA1BF6F62B947C.title: "&5&l任务： &r&e闪电龙洞穴"
	quest.1271A813F44C2E77.quest_subtitle: "&7获取一种从多种魔法矿石中开采出的宝石"
	quest.1271A813F44C2E77.title: "&5&l任务： &r&e红宝石"
	quest.12A05CD6CD93149A.quest_desc: ["&f在灼热的光线下，可怕的&a昼行者&f四处游荡，&a它是一个拥有强大&a力量的无情存在。&f它的出现以压倒性的力量主宰着战场。&f你必须保持&a警惕，&f并承受它连绵不绝的攻击。&f击败它便证明了你即使在光线下也能占据主导。"]
	quest.12A05CD6CD93149A.quest_subtitle: "&7击败白昼的猎手"
	quest.12A05CD6CD93149A.title: "&5&l任务： &r&e昼行者"
	quest.12EA3B6EB90BB838.quest_desc: ["&f下界合金与祖母绿的融合，形成了一种独特的&a力量来源。&f&a下界合金-祖母绿锭&f能将你的装备强化到极限之外。&f用它升级的护甲能提供高&a抗性，&f还能让你直视末影人而不激怒它们。&f就连末地也会因你的存在而屈服。"]
	quest.12EA3B6EB90BB838.quest_subtitle: "&7直面末地的凝视"
	quest.12EA3B6EB90BB838.title: "&5&l任务： &r&e下界合金-祖母绿锭"
	quest.12F20AEAB62CC89A.quest_desc: ["&f在这个世界上，&a巨龙&f是最强大的生物之一，&a它们拥有无与伦比的&a力量与威势。&f它们可以被饲养和培育，让你获得宝贵的&a鳞片，&f这些鳞片可与它们的精华一同使用。&f它们是锻造龙钢装备所必需的。&f掌握它们标志着你迈入了力量的新阶段。"]
	quest.12F20AEAB62CC89A.quest_subtitle: "&7火焰、冰霜与风暴的宏伟生物"
	quest.12F20AEAB62CC89A.title: "&5&l任务： &r&e力量巨龙"
	quest.13407EFF82852D86.quest_desc: ["&f夜幕降临时，最常见的威胁也开始出现。&f那些缓慢但 relentless 的 &a僵尸 &f将考验你的生存能力。&f击败至少 10 只僵尸，证明你在战斗中日益增长的 &a力量 &f。&f每场战斗都让你离掌握这个世界更近一步。"]
	quest.13407EFF82852D86.quest_subtitle: "&7击败 10 只僵尸"
	quest.13407EFF82852D86.title: "&5&l任务： &r&e初尝血腥"
	quest.135FB1F74ABD49F6.quest_desc: ["&f并非所有敌人都会近身战斗。&f致命的 &a骷髅 &f会从远处用精准的箭矢发动攻击。&f击败 10 只骷髅，提升你的 &a反应速度 &f和战斗意识。&f学会拉近距离是生存的关键。"]
	quest.135FB1F74ABD49F6.quest_subtitle: "&7击败 10 只骷髅"
	quest.135FB1F74ABD49F6.title: "&5&l任务： &r&e碎骨成尘"
	quest.136593EE0835DFF7.quest_desc: ["&f从深处，巨大的 &a黑石傀儡 &f拔地而起，&a它是一个拥有强大 &a力量的生物。&f它坚硬的身躯对大多数攻击都具有极高的 &a抗性 &f。&f它的每一步都会撼动脚下的大地。&f只有最强者才能击倒这位远古守护者。"]
	quest.136593EE0835DFF7.quest_subtitle: "&7击败远古石质守护者"
	quest.136593EE0835DFF7.title: "&5&l任务： &r&e黑石傀儡"
	quest.1377085EF11DE06C.quest_subtitle: "&7找到中世纪下界穹顶"
	quest.1377085EF11DE06C.title: "&5&l任务： &r&e下界穹顶"
	quest.13C148CEB016F289.quest_desc: ["&f在与世隔绝的洞穴深处，栖息着可怕的&a冰龙，它是冰霜与掌控的大师。&f它那冰封的吐息能让任何毫无准备的冒险者动作迟缓、力量削弱。&f只有真正&a做好准备的人 &f才能在这场遭遇中幸存下来。&f击败这个生物，就能战胜冰的力量。"]
	quest.13C148CEB016F289.quest_subtitle: "&7击败冰龙"
	quest.13C148CEB016F289.title: "&5&l任务： &r&e冰封暴君"
	quest.13C441D6C39F2A85.quest_desc: ["&f有些武器无法锻造，只能&a被发现。&f&a冠军巨剑 &f可以在远古建筑中找到，或从强大的敌人身上掉落。&f它承载着过往战斗中积攒的无穷&a力量 &f。&f只有真正的探险者才能拥有这样一件武器。"]
	quest.13C441D6C39F2A85.quest_subtitle: "&7找到一位陨落英雄的利刃"
	quest.13C441D6C39F2A85.title: "&5&l任务： &r&e冠军巨剑"
	quest.13D94D233C5758CE.quest_subtitle: "&7锻造一根能引导四种原始元素的法杖"
	quest.13D94D233C5758CE.title: "&5&l任务： &r&e元素法杖"
	quest.142267F6259A23DD.quest_subtitle: "&7找到巫妖塔"
	quest.142267F6259A23DD.title: "&5&l任务： &r&e巫妖塔"
	quest.1680B36E09F7CEC7.quest_desc: ["&f在一处下界竞技场中，盘踞着可怕的&a加兰特，&f这是一个拥有压倒性&a力量的生物。&f如果你靠得太&a近，它那爆炸性的力量和远程攻击会迅速将你击败。&f要对其造成伤害，你必须找到并摧毁它藏于中央的&a弱点 &f。&f只有那时，真正的战斗才会开始。"]
	quest.1680B36E09F7CEC7.quest_subtitle: "&7击败这个爆炸性巨擘"
	quest.1680B36E09F7CEC7.title: "&5&l任务： &r&e加兰特"
	quest.16E835D6D0202CFB.quest_subtitle: "&7获得一根注满水之力的魔法杖"
	quest.16E835D6D0202CFB.title: "&5&l任务：&r&e水之杖"
	quest.1A30DEC773ACC378.quest_desc: ["&f这件工具注入了风暴之力，蕴含着强大的&a力量。&f&a闪电龙钢斧&f能以巨大的&a力量发动迅捷而有力的打击。&f它在战斗和采集任务中都表现出色。&f其速度使其真正致命。"]
	quest.1A30DEC773ACC378.quest_subtitle: "&7锻造一把闪电龙钢斧"
	quest.1A30DEC773ACC378.title: "&5&l任务：&r&e闪电龙钢斧"
	quest.1BBDD61F838504C8.quest_desc: ["&f击败一位强大的统治者后，你获得了一件纯粹的&a力量圣物。&f&a混沌斗篷&f能让你免疫&a凋零，&f并能将凋零能量扩散至附近的敌人。&f它的存在会让所有靠得太近的人都变得虚弱。&f只有征服了混沌的人，才能真正驾驭它。"]
	quest.1BBDD61F838504C8.quest_subtitle: "&7披上混沌君主的披风"
	quest.1BBDD61F838504C8.title: "&5&l任务：&r&e混沌斗篷"
	quest.1C4420ABC41A44D3.quest_desc: ["&f除了实体武器，这个世界还提供了强大的&a魔法&f工具，例如法杖和魔杖。&f许多工具可以使用自然或采矿&a资源制作，&f而另一些则需要从战利品或首领处获得的稀有武器。&f每一件都能在战斗中引导一种独特的元素&a力量，&f在战斗中发挥作用。&f选择合适的武器，决定了你作为法师的道路。"]
	quest.1C4420ABC41A44D3.quest_subtitle: "&7精通法杖与元素之力"
	quest.1C4420ABC41A44D3.title: "&5&l任务：&r&e奥术武器"
	quest.1C8432EFE6BE62AD.quest_subtitle: "&7找到城堡"
	quest.1C8432EFE6BE62AD.title: "&5&l任务：&r&e城堡"
	quest.1CB944AF5C182C55.quest_subtitle: "&7获得邪眼"
	quest.1CB944AF5C182C55.title: "&5&l任务： &r&e邪恶之眼"
	quest.1E5AF41F805FB326.quest_desc: ["&f在击败普通敌人后，你需要更强的&a防护 &f才能在接下来的挑战中存活下来。&f打造一套完整的&a钻石盔甲 &f将极大提升你在危险遭遇中的胜算。&f更强大的&a生物 &f通常藏身于各种建筑和地牢之中，很少出现在地表。&f只有准备充分的冒险者才能直面这些威胁。"]
	quest.1E5AF41F805FB326.quest_subtitle: "&7为更强大的威胁做好准备"
	quest.1E5AF41F805FB326.title: "&5&l任务： &r&e钻石防护"
	quest.1E8BBE86DD78EAFE.quest_desc: ["&f与普通遗物不同，&a李安德里的折磨 &f提供的并非简单的属性加成。&f相反，它能触发强大的临时&a战斗效果 &f，从而扭转战局。&f这些稀有遗物只存在于&a战利品宝箱 &f中，或是在击败强大的&a首领后获得。"]
	quest.1E8BBE86DD78EAFE.quest_subtitle: "&7获取一件具有强大战斗效果的遗物"
	quest.1E8BBE86DD78EAFE.title: "&5&l任务： &r&e李安德里的折磨"
	quest.1EA122C765D18EF9.quest_desc: ["&f这件工具注入了风暴之力，蕴含着巨大的&a能量。&f&a闪电龙钢斧 &f能以强大的&a力量发动迅猛而有力的打击。&f它无论是在战斗中还是采集任务中都表现卓越。&f其迅捷的速度使其真正致命。"]
	quest.1EA122C765D18EF9.quest_subtitle: "&7打造一把闪电龙钢斧"
	quest.1EA122C765D18EF9.title: "&5&l任务： &r&e闪电龙钢斧"
	quest.1EAF64D5AC3942D1.quest_desc: ["&f&a灵魂收割者 &f是一种以他人精华为食的黑暗实体。&f它的攻击蕴含着危险的&a力量 &f，能够削弱你的防御。&f你必须保持&a警惕 &f，避免长时间战斗。&f击败它将能解放它已夺取的灵魂。"]
	quest.1EAF64D5AC3942D1.quest_subtitle: "&7击败灵魂收割者"
	quest.1EAF64D5AC3942D1.title: "&5&l任务：&r&e灵魂收割者"
	quest.1EB21423DDA5CE47.quest_desc: ["&f&a下界合金之风套装 &f可使用&a高级护甲 &f锻造模板和稀有的&a监守者失落水晶 &a重铸为其最终的&a飞升形态 &f。&f这种强大的水晶可以在战利品箱中找到，也可以通过击败强大的敌人（如&a监守者 &f或&a末影龙 &a）获得。&f升级后，该套装将获得额外的&a5% &f空中力量，使其总加成从&a30%提升至35%。&f只有真正掌控天空的人，才能解锁它的终极潜力。"]
	quest.1EB21423DDA5CE47.quest_subtitle: "&7锻造空中护甲的最终形态"
	quest.1EB21423DDA5CE47.title: "&5&l任务：&r&e飞升之风套装"
	quest.1F81E2CAD0E789C2.quest_subtitle: "&7找到冰龙洞穴"
	quest.1F81E2CAD0E789C2.title: "&5&l任务：&r&e冰龙洞穴"
	quest.1FAF617A2FB51609.quest_desc: ["&f虚空能量的源头，是危险的&a虚空之花。&f这种生物无法被&a远程攻击&f（如弓箭）伤害，因此你必须与其进行近战。&f靠近时一定要万分&a小心&f，因为它在近身时同样致命。&f唯有真正勇敢之人才能摧毁这个存在。"]
	quest.1FAF617A2FB51609.quest_subtitle: "&7击败虚空之花"
	quest.1FAF617A2FB51609.title: "&5&l任务：&r&e虚空之花"
	quest.1FB4F6D1A6B64CB7.quest_subtitle: "&7制作一根注入了水之力的法杖"
	quest.1FB4F6D1A6B64CB7.title: "&5&l任务：&r&e水之法杖"
	quest.1FE13C2526457B5D.quest_subtitle: "&7找到圆形竞技场"
	quest.1FE13C2526457B5D.title: "&5&l任务：&r&e圆形竞技场"
	quest.208D1A09FDB78090.quest_subtitle: "&7制作一根注入了水之精粹的魔杖"
	quest.208D1A09FDB78090.title: "&5&l任务：&r&e海草魔杖"
	quest.20F8853D790DC762.quest_desc: ["&f与普通遗物不同，&a守护天使&f并不专注于提供永久属性加成。&f它的价值在于独特的临时&a战斗效果&f，在关乎存亡时往往能起到决定性作用。&f这是一种稀有宝物，仅在&a战利品宝箱&f中或击败强大的&a首领后获得。"]
	quest.20F8853D790DC762.quest_subtitle: "&7获取一件具有强大战斗效果的遗物"
	quest.20F8853D790DC762.title: "&5&l任务：&r&e守护天使"
	quest.227631E14AED5DBB.quest_desc: ["&f当你击败敌人时，有些敌人可能会掉落神秘的&a灵魂之星&f，其中蕴含着它们本质的碎片。&f这些物品会指引你找到隐藏的高塔，那里有更强的挑战在等着你。&f将它们放置在&a召唤石&f上，你就能召唤出强大的首领。&f保护好它们，它们的&a力量&f是迎接更艰难战斗的关键。"]
	quest.227631E14AED5DBB.quest_subtitle: "&7收集陨落敌人的本质"
	quest.227631E14AED5DBB.title: "&5&l任务：&r&e灵魂之星"
	quest.233C1A14B2AB44A7.quest_desc: ["&f有了全新的合金锭，你就能用更强的&a力量来强化装备。&f使用&a下界合金-铁锭&f升级你的下界合金护甲，提升它的&a抗性。&f这套护甲能让你在面对幻翼时获得独特的优势。&f天空将不再追捕你。"]
	quest.233C1A14B2AB44A7.quest_subtitle: "&7用铁融合升级你的护甲"
	quest.233C1A14B2AB44A7.title: "&5&l任务：&r&e下界合金-铁护甲"
	quest.247A895AE1BC5F20.quest_subtitle: "&7获取魔法之眼"
	quest.247A895AE1BC5F20.title: "&5&l任务：&r&e魔法之眼"
	quest.24A0C41727F6C469.quest_subtitle: "&7打造一根由大地与下界合金赋能的升级版法杖"
	quest.24A0C41727F6C469.title: "&5&l任务：&r&e下界合金泰拉法杖"
	quest.252F15FFDCD05BFB.quest_desc: ["&f要掌控风暴的怒火，你必须建造合适的&a结构。&f建造熔炉，并将&a龙熔炉核心&f嵌入其中心。&f附近的一条&a闪电龙&f会引导它的能量为熔炉供能。&f只有那时，你才能解锁锻造龙钢锭的能力。"]
	quest.252F15FFDCD05BFB.quest_subtitle: "&7激活闪电龙熔炉核心"
	quest.252F15FFDCD05BFB.title: "&5&l任务： &r&e风暴熔炉"
	quest.255FE43001933473.quest_subtitle: "&7打造一根由大地与下界合金强化的升级魔杖"
	quest.255FE43001933473.title: "&5&l任务： &r&e下界合金大地魔杖"
	quest.2570722C8252DD1F.quest_subtitle: "&7找到提丰"
	quest.2570722C8252DD1F.title: "&5&l任务： &r&e提丰"
	quest.25A6230187C32032.quest_desc: ["&f主世界之外是危险的下界，这片土地充满了 &a危险 &f与稀有资源。 &f通过探索下界，你可以找到 &a远古残骸 &f，用黄金精炼后可制成下界合金锭。 &f这种材料能提供强大的 &a抗性 &f与耐久度。 &f它是打造最强装备所必需的。"]
	quest.25A6230187C32032.quest_subtitle: "&7从下界深处锻造力量"
	quest.25A6230187C32032.title: "&5&l任务： &r&e下界合金锭"
	quest.25FC701CDEAB4A1B.quest_desc: ["&f一股未知的存在化身为 &a“之眼”， &f一个充满非自然 &a力量的神秘实体。 &f仅凭它的凝视，就能让经验最丰富的战士也感到不安。 &f请保持 &a警惕 &f，因为它的攻击难以预测且十分诡异。 &f直面它，意味着要对抗某种超乎理解的存在。"]
	quest.25FC701CDEAB4A1B.quest_subtitle: "&7直面现实之外的守望者"
	quest.25FC701CDEAB4A1B.title: "&5&l任务： &r&e之眼"
	quest.267E78DBC994F074.quest_subtitle: "&7从多种魔法矿石中开采一颗宝石"
	quest.267E78DBC994F074.title: "&5&l任务： &r&e海蓝宝石"
	quest.273B9D4F8D3163EB.quest_desc: ["&f驾驭冰的力量不仅需要实力，更需要正确的&a结构。&f组装好熔炉，并将&a龙熔炉核心&f放入其中。&f附近的一条&a冰龙&f必须引导其冰冻气息来激活熔炉。&f借助它，你就能打造出强力的龙钢锭。"]
	quest.273B9D4F8D3163EB.quest_subtitle: "&7激活冰龙熔炉核心"
	quest.273B9D4F8D3163EB.title: "&5&l任务：&r&e霜冻熔炉"
	quest.27DF43C6040CFA80.quest_subtitle: "&7找到掠夺者堡垒"
	quest.27DF43C6040CFA80.title: "&5&l任务：&r&e掠夺者堡垒"
	quest.2854C49966AA0C9B.quest_desc: ["&f在世界深处隐藏着&a冠军之墓，&f那是一个充满远古&a力量的地方。&f伟大的&a远古冠军&f长眠于此，等待着有勇气面对他的人。&f你必须四处探索并保持&a警惕&f才能找到它的位置。&f只有这样，你才能向这位陨落的勇士发起挑战。"]
	quest.2854C49966AA0C9B.quest_subtitle: "&7找到一位陨落勇士的安息之地"
	quest.2854C49966AA0C9B.title: "&5&l任务：&r&e冠军之墓"
	quest.28801CEE374D7900.quest_desc: ["&f从虚无的深渊中，&a虚空阴影&f现身了，它是一个由纯粹&a力量构成的存在。&f它的移动毫无规律，攻击更是势不可挡。&f你必须保持&a警惕&f才能从它连绵不绝的攻击中存活下来。&f击败它，便证明你已掌控了这个世界最黑暗的力量。"]
	quest.28801CEE374D7900.quest_subtitle: "&7击败虚空的化身"
	quest.28801CEE374D7900.title: "&5&l任务：&r&e虚空阴影"
	quest.291104A2B8752B12.quest_desc: ["&f从最黑暗的角落中，&a夜影 &f现身了——它是一种无视物理障碍的幽灵实体。&f它能穿过 &a墙壁 &f，在你最意想不到的时候发动攻击。&f保持 &a警惕 &f，依靠时机来对抗这个难以捉摸的敌人。&f击败它，便证明你能战胜那些无法触及之物。"]
	quest.291104A2B8752B12.quest_subtitle: "&7击败游荡的幽灵"
	quest.291104A2B8752B12.title: "&5&l任务： &r&e夜影"
	quest.29BC3F924F668D49.quest_subtitle: "&7找到繁茂矿井"
	quest.29BC3F924F668D49.title: "&5&l任务： &r&e繁茂矿井"
	quest.2B276B6A77F698EA.quest_desc: ["&f&a维京符文戒指 &f是一件结实的饰品，能同时增强你的 &a怒气值 &f和 &a攻击伤害。&f尽管它由较为常见的材料制成，但对于偏爱正面作战的激进型战士来说，它仍不失为一个宝贵的选择。"]
	quest.2B276B6A77F698EA.quest_subtitle: "&7打造一枚能增强怒气和攻击的戒指"
	quest.2B276B6A77F698EA.title: "&5&l任务： &r&e维京符文戒指"
	quest.2B31B827ADDFAD99.quest_desc: ["&f将下界合金与黄金结合，便能创造出一种蕴含精纯 &a力量的材料。&f&a下界合金金锭 &f能让你的装备获得强大的升级。&f用它锻造的护甲能提供强大的 &a抗性 &f，还能让你在不被猪灵注意的情况下穿行其间。&f有时，力量也伴随着影响力。"]
	quest.2B31B827ADDFAD99.quest_subtitle: "&7获得猪灵的青睐"
	quest.2B31B827ADDFAD99.title: "&5&l任务： &r&e下界合金金锭"
	quest.2BA4641CC8C93C22.quest_desc: ["&f与普通遗物不同，&a米凯尔的赐福 &f依靠特殊的临时&a效果 &f而非直接提升属性。&f这些稀有的力量可以在战斗最艰难的时刻提供关键支援。&f它只能从&a战利品宝箱 &f中获得，或击败危险的&a首领后获取。"]
	quest.2BA4641CC8C93C22.quest_subtitle: "&7获得一件具有强大战斗效果的遗物"
	quest.2BA4641CC8C93C22.title: "&5&l任务：&r&e米凯尔的赐福"
	quest.2BB3274032552981.quest_subtitle: "&7获得一颗从各种魔法矿石中开采出的宝石"
	quest.2BB3274032552981.title: "&5&l任务：&r&e托帕石"
	quest.2BBE4CFC2982897F.quest_desc: ["&f远古巨兽冰冷的遗骸中，蕴藏着鲜有人能驾驭的力量。&f传说中的&a冰龙钢铠甲 &f能赋予无与伦比的&a防御力 &f与抵御最严酷威胁的韧性。&f穿上它，便证明你已战胜&a冰龙 &f的怒火，并在最伟大的猎手之中赢得了一席之地。"]
	quest.2BBE4CFC2982897F.quest_subtitle: "&7由冰霜与征服锻造而成的力量"
	quest.2BBE4CFC2982897F.title: "&5&l任务：&r&e冰封统治"
	quest.2BC61E872AC3391C.quest_desc: ["&f这把武器由黑暗精华锻造而成，能赋予使用者强大的&a力量。&f&a暗裔之刃 &f能在每次攻击时禁用敌人的&a护盾 &f并窃取其生命。&f当你跃起并重重砸向目标附近的地面时，它还会释放一次毁灭性的&a冲击 &f。&f它需要以&a嗜血者 &f为基础进行锻造，从而将其进化为一种更为致命的武器。"]
	quest.2BC61E872AC3391C.quest_subtitle: "&7锻造一把拥有压倒性力量的武器"
	quest.2BC61E872AC3391C.title: "&5&l任务： &r&e暗裔之刃"
	quest.2EA410C222994E3E.quest_desc: ["&f只有那些曾直面并击败过强大巨龙的人，才能驾驭如此 &a力量。&f由火龙精华锻造而成的传奇 &a龙钢盔甲 &f能提供无与伦比的 &a抗性 &f与力量。&f锻造它证明你已不再是一名普通的幸存者，而是一位令人畏惧的 &a猎龙者 &f，你的名字将在这片大地上回响。"]
	quest.2EA410C222994E3E.quest_subtitle: "&7真正猎龙者的证明"
	quest.2EA410C222994E3E.title: "&5&l任务： &r&e龙钢进阶"
	quest.2F1574B643B77BD9.quest_desc: ["&f手握下界合金，你现在可以打造拥有强大 &a力量的装备。&f制作一套完整的 &a下界合金盔甲 &f以获得卓越的 &a抗性 &f与耐久度。&f这套盔甲标志着你的旅程已步入后期阶段。&f如今，已很少有威胁能与你抗衡。"]
	quest.2F1574B643B77BD9.quest_subtitle: "&7锻造最强的标准盔甲"
	quest.2F1574B643B77BD9.title: "&5&l任务： &r&e下界合金盔甲"
	quest.2F6B17FFF0F7B87B.quest_subtitle: "&7获取一颗从多种魔法矿石中开采出的宝石"
	quest.2F6B17FFF0F7B87B.title: "&5&l任务： &r&e孔雀石"
	quest.2FC0DD9001BF49D4.quest_desc: ["&f将 &a水之套装 &f与 &a下界合金 &f以及特殊的锻造模板重新锻造，即可解锁其更强大的 &a下界合金形态。 &f这套升级后的盔甲保留了它与水的联系，同时将其魔法潜力提升至超越原始设计的水平。 &f它的水之力加成从 &a25% 提升至 30%， &f相比基础套装额外获得了 &a5% &f的加成。 &f掌握潮汐之人，将在这套精炼形态中发现更强的力量。"]
	quest.2FC0DD9001BF49D4.quest_subtitle: "&7用下界合金升级你的水之盔甲"
	quest.2FC0DD9001BF49D4.title: "&5&l任务： &r&e下界合金水之套装"
	quest.2FFB3AD118E7EF89.quest_desc: ["&f这件武器以黑暗精华锻造而成，能赋予使用者强大的 &a力量。 &f&a嗜血之刃 &f能让你在每次攻击时从敌人身上窃取 &a生命。 &f在持久战中，这一效果能让你在面对强敌时存活下来。 &f但请记住，如此强大的力量往往伴随着代价。"]
	quest.2FFB3AD118E7EF89.quest_subtitle: "&7打造一把以生命为食的利刃"
	quest.2FFB3AD118E7EF89.title: "&5&l任务： &r&e嗜血之刃"
	quest.302CBB6326DEB6AA.quest_subtitle: "&7找到火龙洞穴"
	quest.302CBB6326DEB6AA.title: "&5&l任务： &r&e火龙洞穴"
	quest.32010EE9944EE079.quest_subtitle: "&7获取一颗从多种魔法矿石中开采出的宝石"
	quest.32010EE9944EE079.title: "&5&l任务： &r&e坦桑石"
	quest.32084B1B5D5F4DE1.quest_desc: ["&f在下界游荡的 &a猪灵巨兽 &f是一种凶猛的生物，拥有强大的 &a力量。&f其好斗的天性和猛烈的攻击使其成为一个严重的 &a威胁。&f请保持 &a警惕 &f，切勿低估它的实力。&f只有技艺高超的战士才能将其击败。"]
	quest.32084B1B5D5F4DE1.quest_subtitle: "&7击败下界的蛮兽"
	quest.32084B1B5D5F4DE1.title: "&5&l任务：&r&e猪灵巨兽"
	quest.320976F0B2DE2437.quest_desc: ["&f悄无声息又危险重重，&a苦力怕 &f以其爆炸特性而闻名。&f稍有不慎，一个错误就可能让你失去一切，因此务必 &a小心。&f在躲避它们爆炸的同时击败 10 只苦力怕。&f精准与时机将是你的最佳盟友。"]
	quest.320976F0B2DE2437.quest_subtitle: "&7击败 10 只苦力怕"
	quest.320976F0B2DE2437.title: "&5&l任务：&r&e不稳定的威胁"
	quest.324F4E6D64BAEFCE.quest_desc: ["&f潜伏于黑暗中的敏捷 &a蜘蛛 &f能够攀爬并从意想不到的角度发动攻击。&a击败 10 只蜘蛛以提升你的 &a警觉性 &f和反应速度。&f阴影中隐藏着诸多危险，但你正在学习如何克服它们。"]
	quest.324F4E6D64BAEFCE.quest_subtitle: "&7击败 10 只蜘蛛"
	quest.324F4E6D64BAEFCE.title: "&5&l任务：&r&e潜行阴影"
	quest.3280D1D090C4014B.quest_subtitle: "&7获取守卫之眼"
	quest.3280D1D090C4014B.title: "&5&l任务：&r&e守卫之眼"
	quest.33359EEDCEB83799.quest_desc: ["&f与普通遗物不同，&a马德罗姆菇 &f不提供直接的属性加成。 &f相反，它在战斗中有一定几率激活独特的临时&a效果 &f，从而极大地改变战局。 &f它只出现在&a战利品宝箱 &f中，或是作为强大&a首领的奖励。"]
	quest.33359EEDCEB83799.quest_subtitle: "&7获取一件具有强大战斗效果的遗物"
	quest.33359EEDCEB83799.title: "&5&l任务： &r&e马德罗姆菇"
	quest.3385325B621AEBF3.quest_desc: ["&f&a托帕斯狐狸雕像 &f是一件充满不稳定魔法能量的狡黠遗物。 &f它为&a奥术 &f和 &a火焰力量提供加成， &f使其成为驾驭毁灭性且不可预测力量的法师们的完美选择。"]
	quest.3385325B621AEBF3.quest_subtitle: "&7制作一件兼具奥术与火焰力量的遗物"
	quest.3385325B621AEBF3.title: "&5&l任务： &r&e托帕斯狐狸雕像"
	quest.3405D83DD5F466A9.quest_desc: ["&f并非所有敌人都像你之前遇到的那样弱小。 &f&a枯萎恶魔 &f拥有更高的&a生命值 &f，并在战斗中造成可观的伤害。 &f只要配备合适的护甲并做好充分准备，它们就能被击败。 &f这些生物可能会掉落珍贵的&a恶魔之心 &f，可用于黑暗力量。"]
	quest.3405D83DD5F466A9.quest_subtitle: "&7击败这些被腐化的生物"
	quest.3405D83DD5F466A9.title: "&5&l任务： &r&e枯萎恶魔"
	quest.34B943D2D0C93EC8.quest_desc: ["&f要开始锻造你的魔法护甲，你首先必须制造出&a元素精华，&f这是一种注入了自然&a力量的关键材料。&f它使用从世界中收集的资源制作而成，将原始的自然能量结合成一种可以被塑形的形态。&f这种精华是打造与元素力量相关联的神秘护甲套装的&a基础，&f也是关键。&f掌握它的制造方法是成为真正奥术力量驾驭者的第一步。"]
	quest.34B943D2D0C93EC8.quest_subtitle: "&7打造魔法护甲的基础"
	quest.34B943D2D0C93EC8.title: "&5&l任务：&r&e元素精华"
	quest.34BA26247A7CAA4E.quest_desc: ["&f一个由纯粹腐化构成的存在，&a这位被诅咒的领主&f掌握着巨大的&a力量。&f他的攻击毁灭性极强，仅其存在本身就能激起恐惧。&f你必须做好充分&a准备，&f才能直面如此黑暗的存在。&f击败他，你便将成为诅咒力量的征服者。"]
	quest.34BA26247A7CAA4E.quest_subtitle: "&7击败被诅咒者的统治者"
	quest.34BA26247A7CAA4E.title: "&5&l任务：&r&e被诅咒的领主"
	quest.35F915DFB3702475.quest_desc: ["&f这把稀有的&a武器&f以其在战斗中永不停歇的特性而闻名。&f这把&a连击弩&f只能通过探索或击败强大的敌人来获得。&f它的攻击蕴含着无与伦比的&a力量。&f很少有人能抵挡住它的连番猛攻。"]
	quest.35F915DFB3702475.quest_subtitle: "&7找到这把无尽攻势的武器"
	quest.35F915DFB3702475.title: "&5&l任务：&r&e连击弩"
	quest.39041C5B33C65D56.quest_desc: ["&f&a坦桑石蝙蝠雕像 &f是一件注入了古老魔法的黑暗神秘遗物。&f它能为&a冰 &f和 &a灵魂力量提供加成，&f非常适合那些掌控寒冷、死亡与遗忘能量的人。"]
	quest.39041C5B33C65D56.quest_subtitle: "&7制作一件具备冰与灵魂力量的遗物"
	quest.39041C5B33C65D56.title: "&5&l任务：&r&e坦桑石蝙蝠雕像"
	quest.39193A0865895BC5.quest_desc: ["&f在荒蛮之地，巍峨的&a霜巨人&f现身，&a这是一位拥有强大&f力量的存在。&a它的冰霜能力能将你定在原地，并随着时间推移吸取你的&f力量。&f你必须做好充分&a准备，&f才能抵御严寒及其毁灭性的攻击。&f唯有最强者才能击败这位冰封的泰坦。"]
	quest.39193A0865895BC5.quest_subtitle: "&7击败冰封的巨像"
	quest.39193A0865895BC5.title: "&5&l任务：&r&e霜巨人"
	quest.39467EC3658E9529.quest_desc: ["&f&a下界合金维京符文戒指 &f是维京符文戒指的强化进化版。&f它能为&a狂怒力量 &f和 &a攻击伤害提供更高的加成，&f是那些追求更强攻击力的玩家的更优选择。"]
	quest.39467EC3658E9529.quest_subtitle: "&7制作一枚具备更强狂怒力量的升级戒指"
	quest.39467EC3658E9529.title: "&5&l任务：&r&e下界合金维京符文戒指"
	quest.39585ED1C7BFEDF9.quest_desc: ["&f&a下界合金维京符文项链 &f是维京符文项链的强化形态。&f它为&a怒气值 &f和 &a攻击伤害提供了更强的加成，&f为投身于持续战斗的勇士们带来了更大的优势。"]
	quest.39585ED1C7BFEDF9.quest_subtitle: "&7打造一条怒气值更强的升级项链"
	quest.39585ED1C7BFEDF9.title: "&5&l任务： &r&e下界合金维京符文项链"
	quest.39B0ACDD8BC77EFF.quest_desc: ["&f随着战斗愈发艰难，你将需要更强的&a防御力。&f&a钻石菱形盾 &f拥有极高的耐久度和强大的&a招架潜力。&f装备在副手时，它能提升你的&a护甲值 &f和生存能力。&f是应对危险遭遇的真正伙伴。"]
	quest.39B0ACDD8BC77EFF.quest_subtitle: "&7为激烈战斗提供强力防护"
	quest.39B0ACDD8BC77EFF.title: "&5&l任务： &r&e钻石菱形盾"
	quest.3A1031A6BCEB368F.quest_desc: ["&f在激烈的战斗中，良好的防御与&a攻击同样重要。&f&a铁质菱形盾 &f能提供稳固的保护，并让你能在恰当的时机进行&a招架 &f。 &f将其装备在副手可额外获得&a护甲值 &f，从而提升你的生存能力。&f是任何冒险者都可信赖的工具。"]
	quest.3A1031A6BCEB368F.quest_subtitle: "&7为早期战斗提供可靠的防御"
	quest.3A1031A6BCEB368F.title: "&5&l任务： &r&e铁质菱形盾"
	quest.3B9D025A5F85B890.quest_subtitle: "&7找到沙之遗迹"
	quest.3B9D025A5F85B890.title: "&5&l任务： &r&e沙之遗迹"
	quest.3BC417C3DC08B6C3.quest_desc: ["&f与普通遗物不同，&a金身沙漏 &f并不仅仅是提升你的属性。&f它的强大之处在于特殊的临时&a战斗效果 &f，能在最危急的时刻救你一命。&f这类遗物只能通过&a战利品宝箱 &f或击败可怕的&a首领才能获得。"]
	quest.3BC417C3DC08B6C3.quest_subtitle: "&7获取一件具有强大战斗效果的遗物"
	quest.3BC417C3DC08B6C3.title: "&5&l任务：&r&e金身沙漏"
	quest.3C104C829238FFC5.quest_desc: ["&f有些装备无法锻造，只能&a发现。&f&a女武神壁垒 &f藏在世界各地的隐秘建筑中。&f它能提供卓越的&a防御力 &f和强大的招架能力。&f只有真正的探险者才能找到这面传奇盾牌。"]
	quest.3C104C829238FFC5.quest_subtitle: "&7一面遗失于世间的传奇盾牌"
	quest.3C104C829238FFC5.title: "&5&l任务：&r&e女武神壁垒"
	quest.3C5CB85ADC81812E.quest_desc: ["&f这把武器在极寒条件下锻造而成，蕴含着强大的&a力量。&f&a冰龙钢剑 &f能以刺骨的威力攻击任何敌人。&f其冰封的剑刃能增强你在战斗中的&a力量 &f。&f很少有人能抵挡住它的冰冷锋芒。"]
	quest.3C5CB85ADC81812E.quest_subtitle: "&7锻造一把冰龙钢剑"
	quest.3C5CB85ADC81812E.title: "&5&l任务：&r&e冰龙钢刃"
	quest.3ED25FF2A92E459B.quest_subtitle: "&7锻造一把由水和下界合金强化的升级版魔杖"
	quest.3ED25FF2A92E459B.title: "&5&l任务：&r&e下界合金水之魔杖"
	quest.3FB30581D261AC71.quest_desc: ["&f这位&a复活的骑士&f并非寻常对手，因为它不会像其他敌人那样倒下。&f在一股未知&a力量的驱使下，&f它即便被击败也会重返战场。&f你必须保持&a警惕，&f彻底结束这场战斗。&f只有这样，你才能向那无尽的意志证明自己的力量。"]
	quest.3FB30581D261AC71.quest_subtitle: "&7击败那位再度崛起的战士"
	quest.3FB30581D261AC71.title: "&5&l任务：&r&e复活的骑士"
	quest.3FC76C05C4AE61A6.quest_desc: ["&f借助&a元素精华的力量，&f你现在可以锻造&a元素套装，&f这是一套与&a水、火、土&f以及&a风这四种原始力量相绑定的魔法护甲。&f穿戴它时，你在所有四种元素上的元素力量都会提升&a20%，&f使其成为任何有志成为法师的冒险者的百搭之选。&f然而，该套装无法被&a升级，&f因此其强度固定不变。&f对于希望走上元素掌控之路的人来说，这是一个均衡的起点。"]
	quest.3FC76C05C4AE61A6.quest_subtitle: "&7打造与四种原始元素相契合的护甲"
	quest.3FC76C05C4AE61A6.title: "&5&l任务：&r&e元素套装"
	quest.400DE2D959ABF7FF.quest_subtitle: "&7获取一颗从多种魔法矿石中开采出的宝石"
	quest.400DE2D959ABF7FF.title: "&5&l任务：&r&e黄水晶"
	quest.404ADC4BFA035F60.quest_desc: ["&f就连大地也会屈服于火焰的力量。&f&a火龙钢铲 &f能让你以惊人的&a效率采集材料。&f其烧热的铲刃能毫不费力地切开地形。&f没有任何障碍能减缓你的步伐。"]
	quest.404ADC4BFA035F60.quest_subtitle: "&7制作一把火龙钢铲"
	quest.404ADC4BFA035F60.title: "&5&l任务：&r&e火龙钢铲"
	quest.408E27085B089B4F.quest_desc: ["&f你发现自己身处一个&a中世纪 &f与 &a魔法 &f交织的世界，这里遍布着被遗忘的土地和未竟的故事。&f在广袤的大地上，散落着等待被发现的&a地下城 &f，其中隐藏着危险，也埋藏着宝藏。&f小心那些在这片土地上徘徊的众多&a怪物 &f，它们守护着价值连城的宝物。&f从令人叹为观止的景色到不为人知的秘密，这个世界任你探索……只要你做好准备。"]
	quest.408E27085B089B4F.quest_subtitle: "&7一片充满神秘与自由的土地"
	quest.408E27085B089B4F.title: "&5&l任务：&r&e未被书写的世界"
	quest.424CCEA5C211E705.quest_desc: ["&f与普通遗物不同，&a舒瑞亚的战歌 &f提供的不是简单的属性提升，而是独特的临时&a战斗效果 &f。&f激活后，这些效果能为克服致命遭遇提供所需的契机。&f它只能在&a战利品宝箱 &f中找到，或是在击败强大的&a首领后获得。"]
	quest.424CCEA5C211E705.quest_subtitle: "&7获取一件具有强大战斗效果的遗物"
	quest.424CCEA5C211E705.title: "&5&l任务：&r&e舒瑞亚的战歌"
	quest.42A845A769C241AC.quest_subtitle: "&7获取下界之眼"
	quest.42A845A769C241AC.title: "&5&l任务： &r&e下界之眼"
	quest.44F58F4BFA9718B0.quest_desc: ["&f这件由天界之力触及的武器——&a星刃 &f蕴藏着不可思议的 &a力量。&f它无法被锻造，只能在稀有地点寻得，或由首领掉落。&f其起源未知，但它的强大毋庸置疑。&f一件真正的宇宙遗物。"]
	quest.44F58F4BFA9718B0.quest_subtitle: "&7驾驭群星之力"
	quest.44F58F4BFA9718B0.title: "&5&l任务： &r&e星刃"
	quest.45079188E318EDEA.quest_desc: ["&f&a孔雀石蜜獾 &f是一件以凶猛野生动物为原型打造的魔法遗物。&f与其他孔雀石造物一样，它能提供 &a大地 &f与 &a自然力量的加成，&f使其成为那些从自然界汲取力量的强者的绝佳选择。"]
	quest.45079188E318EDEA.quest_subtitle: "&7打造一件蕴含大地与自然力量的遗物"
	quest.45079188E318EDEA.title: "&5&l任务： &r&e孔雀石蜜獾"
	quest.4568E9B62DF93174.quest_subtitle: "&7找到中世纪下界城堡"
	quest.4568E9B62DF93174.title: "&5&l任务： &r&e下界城堡"
	quest.45A7CD1FBAA4BE00.quest_desc: ["&f与普通遗物不同，&a冰封之心 &f并不会仅仅提升你的属性。&f相反，它能激活临时的 &a战斗效果 &f，从而极大地影响战局。&f这是一种稀有遗物，仅在 &a战利品宝箱 &f中或在击败强大的 &a首领后获得。"]
	quest.45A7CD1FBAA4BE00.quest_subtitle: "&7获取一件具有强大战斗效果的遗物"
	quest.45A7CD1FBAA4BE00.title: "&5&l任务： &r&e冰封之心"
	quest.462343F7F192DC30.quest_desc: ["&f与常见的遗物不同，&a日炎斗篷 &f依靠独特的激活效果，而非永久提升属性。&f其临时的&a战斗加成 &f能在战况陷入绝境时提供关键优势。&f它只能从&a战利品宝箱 &f中获得，或击败强大的&a首领后获取。"]
	quest.462343F7F192DC30.quest_subtitle: "&7获取一件具有强大战斗效果的遗物"
	quest.462343F7F192DC30.title: "&5&l任务：&r&e日炎斗篷"
	quest.4625249140E8D920.quest_subtitle: "&7锻造一根注入了风之力量的魔杖"
	quest.4625249140E8D920.title: "&5&l任务：&r&e风之魔杖"
	quest.46C1D46B66E3F0B7.quest_desc: ["&f&a金属狼雕像 &f由&a红宝石 &f锻造而成，是一件体现攻击性与力量的遗物。&f与其他红宝石制品一样，它能提升你的&a攻击力，&f是战士和进攻型战斗法师的理想伙伴。"]
	quest.46C1D46B66E3F0B7.quest_subtitle: "&7锻造一件能提升攻击力的遗物"
	quest.46C1D46B66E3F0B7.title: "&5&l任务：&r&e金属狼雕像"
	quest.471AE7F1EADFAE98.quest_desc: ["&f通过一个复杂的过程，&a熔化的恶魔之心 &f可以被塑造成&a恶魔锭块 &f，然后再熔炼成一块强大的锭。&f&a深红锭 &f蕴含着巨大的&a力量，&f可用于锻造黑暗武器和护甲。&f这些装备能提供强大的&a抗性，&f抵御危险的生物。&f只有精通黑暗之人才能驾驭它。"]
	quest.471AE7F1EADFAE98.quest_subtitle: "&7提纯黑暗力量的精华"
	quest.471AE7F1EADFAE98.title: "&5&l任务：&r&e深红锭"
	quest.474126736E2361AE.quest_desc: ["&f并非所有威胁都依赖蛮&a力。&f&a戈耳工&f拥有一种能将敌人石化的致命凝视。&f你必须保持&a警惕&f，在战斗中避免与其进行直接的眼神交流。&f哪怕一瞬间的分心，也可能决定你的命运。"]
	quest.474126736E2361AE.quest_subtitle: "&7击败石化的生物"
	quest.474126736E2361AE.title: "&5&l任务：&r&e戈耳工"
	quest.4824D1083EDF1153.quest_desc: ["&f&a黄水晶猫雕像&f是一件与温暖及恢复相关的璀璨圣物。&f它能增强&a光系&f和&a治疗力量，&f因此对治疗者、守护者和辅助施法者而言尤其珍贵。"]
	quest.4824D1083EDF1153.quest_subtitle: "&7制作一件具备光系与治疗力量的圣物"
	quest.4824D1083EDF1153.title: "&5&l任务：&r&e黄水晶猫雕像"
	quest.48BD253D590E0C00.quest_desc: ["&f使用&a翡翠，&f你可以制作出能提升你&a远程伤害的魔法戒指和项链。&f这些饰品对猎人、弓箭手以及从远处发动攻击的玩家尤其有用。"]
	quest.48BD253D590E0C00.quest_subtitle: "&7制作能提升远程伤害的戒指和项链"
	quest.48BD253D590E0C00.title: "&5&l任务：&r&e翡翠饰品"
	quest.49518C79FAA4A5E5.quest_desc: ["&f通过古老的方法，你可以为现有的遗物注入更强大的&a力量 &f。&f在锻造台中使用一个&a灵魂 &f和一个模板来升级&a圣心 &f，它就会变成一件更强大的物品。&f经过注入的版本能提供很高的&a抗性 &f，并能免疫某些负面效果。&f对于那些历经苦战的人来说，这真是一项祝福。"]
	quest.49518C79FAA4A5E5.quest_subtitle: "&7用神圣之力强化遗物"
	quest.49518C79FAA4A5E5.title: "&5&l任务： &r&e注入圣心"
	quest.4A2A0828E3539A9E.quest_subtitle: "&7打造一根由水和下界合金赋能的升级版法杖"
	quest.4A2A0828E3539A9E.title: "&5&l任务： &r&e下界合金水之法杖"
	quest.4AEDE2E56F86C72B.quest_desc: ["&f即使在死后，龙的身体仍保留着难以置信的&a力量 &f。使用一个瓶子，你就可以从龙的遗骸中收集到宝贵的&a龙血 &f。&f锻造高级龙钢需要&a闪电龙 &f的血液。&f它脉动着能量，仿佛风暴依然存于其中。"]
	quest.4AEDE2E56F86C72B.quest_subtitle: "&7提取闪电龙的血液"
	quest.4AEDE2E56F86C72B.title: "&5&l任务： &r&e风暴之粹"
	quest.4AF2BE5CFDA1FFA1.quest_desc: ["&f陨落的巨龙遗骸仍蕴含着巨大的&a力量 &f。用一个简单的瓶子，你就能从它的尸体上收集到稀有的&a龙血 &f。&f制作强力的龙钢，必须使用&a冰龙 &f的血液。&f其冰冷的精粹蕴含着鲜有人能抵挡的力量。"]
	quest.4AF2BE5CFDA1FFA1.quest_subtitle: "&7提取冰龙的血液"
	quest.4AF2BE5CFDA1FFA1.title: "&5&l任务： &r&e霜冻精华"
	quest.4D8978ECD90EF9FA.quest_desc: ["&f在一条被击败的巨龙遗骸中，藏着一颗蕴含强大 &a力量的核心。 &f通过提取 &a闪电龙心 &f，你将获得用于高级锻造的关键材料。 &f这件稀有物品是锻造 &a龙铸核心 &f所必需的，它能注入闪电能量。 &f其能量仍在其中噼啪作响，等待被释放。"]
	quest.4D8978ECD90EF9FA.quest_subtitle: "&7获取闪电龙的精华"
	quest.4D8978ECD90EF9FA.title: "&5&l任务： &r&e风暴之心"
	quest.4EB0C35C39A96C78.quest_desc: ["&f这件工具由风暴能量赋能，能赋予使用者惊人的 &a力量。 &f&a闪电龙钢镐 &f能以无与伦比的 &a效率击碎方块。 &f每一次挥击，能量都会随之涌动。 &f没有什么能长久地阻挡它的锋芒。"]
	quest.4EB0C35C39A96C78.quest_subtitle: "&7锻造一把闪电龙钢镐"
	quest.4EB0C35C39A96C78.title: "&5&l任务： &r&e闪电龙钢镐"
	quest.4F1B85F60B664841.quest_desc: ["&f在一条陨落的巨龙遗骸中，藏着一处蕴含强大 &a力量的源泉。 &f使用合适的工具小心提取 &a火龙之心 &f，你就能获得用于高级锻造的关键材料。 &f这件稀有物品是锻造 &a龙铸核心 &f所必需的，它能用于承载火焰能量。 &f只有真正的猎手才能从巨龙的灰烬中夺得如此战利品。"]
	quest.4F1B85F60B664841.quest_subtitle: "&7获取火龙的核心"
	quest.4F1B85F60B664841.title: "&5&l任务： &r&e地狱之心"
	quest.4F42A18E7820B10A.quest_desc: ["&f从强大敌人的遗骸中，你能夺取真正的&a力量。&f使用&a混沌君主的王冠、&f一个下界合金头盔和一个&a模板，&f你就能锻造出混沌头盔。&f这件装备能赋予强大的&a增益效果，&f并提供强大的伤害抗性。&f唯有征服混沌之人方能佩戴。"]
	quest.4F42A18E7820B10A.quest_subtitle: "&7锻造混沌王冠"
	quest.4F42A18E7820B10A.title: "&5&l任务：&r&e混沌头盔"
	quest.4FE322FF4275ADBF.quest_desc: ["&f使用&a海蓝宝石，&f你可以制作出能增强&a水&f与&a空气力量的神秘戒指和项链。&f这些饰品青睐那些能驾驭流动且多变元素的敏捷施法者。"]
	quest.4FE322FF4275ADBF.quest_subtitle: "&7制作蕴含水与空气力量的戒指和项链"
	quest.4FE322FF4275ADBF.title: "&5&l任务：&r&e海蓝宝石饰品"
	quest.502E770CE254A637.quest_desc: ["&f这便是装备&a力量的巅峰。&f使用&a下界合金钻石锭，&f你就能将护甲升级至最高形态。&f它能提供无与伦比的&a抗性，&f并将所有特殊能力集于一套之中。&f你已变得几乎不可阻挡。"]
	quest.502E770CE254A637.quest_subtitle: "&7获得终极护甲套装"
	quest.502E770CE254A637.title: "&5&l任务：&r&e下界合金钻石护甲"
	quest.51720365D24038F6.quest_subtitle: "&7找到角斗场"
	quest.51720365D24038F6.title: "&5&l任务：&r&e角斗场"
	quest.5239CEE1A959744C.quest_subtitle: "&7获取女巫之眼"
	quest.5239CEE1A959744C.title: "&5&l任务：&r&e女巫之眼"
	quest.52D21F8CE9580AB5.quest_subtitle: "&7找到许愿井"
	quest.52D21F8CE9580AB5.title: "&5&l任务：&r&e许愿井"
	quest.53A0D1C3658C8311.quest_desc: ["&f在罕见而危险的洞穴深处，潜藏着强大的&a闪电龙，这是一种以风暴能量为食的生物。&f它那毁灭性的攻击甚至能击溃最坚固的防御。&f你必须做好万全&a准备 &f，随时准备好承受它的怒火。&f击败它将证明你对风暴之力的掌控。"]
	quest.53A0D1C3658C8311.quest_subtitle: "&7击败闪电龙"
	quest.53A0D1C3658C8311.title: "&5&l任务： &r&e风暴破坏者"
	quest.54FD2D9E0412BFEF.quest_desc: ["&f使用&a托帕石，&f你可以制作附魔戒指和项链，为&a奥术 &f和 &a火焰魔法提供增益。&f这些饰品非常适合那些驾驭着毁灭性且不稳定力量的法师。"]
	quest.54FD2D9E0412BFEF.quest_subtitle: "&7制作具有奥术与火焰力量的戒指和项链"
	quest.54FD2D9E0412BFEF.title: "&5&l任务： &r&e托帕石饰品"
	quest.55C947C290797168.quest_desc: ["&f&a蓝宝石乌龟雕像 &f是一件坚固的遗物，象征着坚韧与守护。&f它能提升你的&a最大生命值，&f为那些必须在战斗中抵御危险的冒险家提供更高的生存能力。"]
	quest.55C947C290797168.quest_subtitle: "&7制作一件可提升最大生命值的遗物"
	quest.55C947C290797168.title: "&5&l任务： &r&e蓝宝石乌龟雕像"
	quest.563CA31B0E757EE7.quest_desc: ["&f在末地的深处，神秘的 &a黑曜石巨兽 &f正等待着，&a那是一个拥有强大力量的生物。&f它坚硬的身躯赋予了它强大的 &a防御力 &f，难以被轻易攻破。&f你必须找出它的 &a弱点 &f并加以利用才能造成伤害。&f只有了解其本质的勇士，才能将其击败。"]
	quest.563CA31B0E757EE7.quest_subtitle: "&7击败末地的黑曜石实体"
	quest.563CA31B0E757EE7.title: "&5&l任务： &r&e黑曜石巨兽"
	quest.572D13E9035E58C3.quest_desc: ["&f有了 &a红宝石，&f你就能打造出强力的戒指和项链，提升你的 &a攻击力。&f这些饰品非常适合依赖纯粹攻击力的战士和战斗法师。"]
	quest.572D13E9035E58C3.quest_subtitle: "&7打造能提升攻击力的戒指和项链"
	quest.572D13E9035E58C3.title: "&5&l任务： &r&e红宝石饰品"
	quest.5756A8188D44CEF2.quest_desc: ["&f龙的力量可以被塑造，但必须通过正确的 &a结构。&f使用所需的方块建造熔炉，并将 &a龙铸核心 &f置于其中心。&f附近的一头 &a烈焰龙 &f必须用它的火焰为熔炉供能，才能使其激活。&f只有这样，你才能打造出传说中的龙钢锭。"]
	quest.5756A8188D44CEF2.quest_subtitle: "&7激活烈焰龙铸核心"
	quest.5756A8188D44CEF2.title: "&5&l任务： &r&e熔焰之炉"
	quest.575DDB7EC69AAEFD.quest_subtitle: "&7获得一根注入了大地之力的魔法法杖"
	quest.575DDB7EC69AAEFD.title: "&5&l任务： &r&e大地法杖"
	quest.5775E9EE864A56FF.quest_desc: ["&f&a仙人掌戒指 &f是一件由常见材料制成的简易魔法饰品。&f与滴水石项链一样，它能提升你的&a最大生命值 &f并增强你的&a反射攻击，&f为战斗提供可靠的防护。"]
	quest.5775E9EE864A56FF.quest_subtitle: "&7制作一枚具有防御能力的简易戒指"
	quest.5775E9EE864A56FF.title: "&5&l任务：&r&e仙人掌戒指"
	quest.58057B81D0B34EDA.quest_desc: ["&f要想抵达末地，你必须收集一套散落在世界各地的独特&a眼睛。&f有些可以合成，而另一些则需要从&a首领 &f处获得或在隐藏的宝藏中找到。&f这些遗物蕴含着古老的&a力量，&f是激活传送门的必备品。&f只有集齐所有眼睛的人，才能踏入未知之地。"]
	quest.58057B81D0B34EDA.quest_subtitle: "&7收集通往另一个维度的钥匙"
	quest.58057B81D0B34EDA.title: "&5&l任务：&r&e末影之眼"
	quest.58082B7F30B1E8B2.quest_desc: ["&f即便是冰封的土地，也会向这股&a力量屈服。&f&a冰龙钢铲 &f能让你以流畅的&a效率采集材料。&f它的铲刃能轻松地滑过各种地形。&f没有任何地表能抵抗它的触碰。"]
	quest.58082B7F30B1E8B2.quest_subtitle: "&7制作一把冰龙钢铲"
	quest.58082B7F30B1E8B2.title: "&5&l任务：&r&e冰龙钢铲"
	quest.58594C42A7BA0C99.quest_desc: ["&f与普通遗物不同，&a梅贾的窃魂卷 &f不会提供简单的属性加成。&f相反，它能触发强大的临时&a战斗效果 &f，在艰难的对决中可能成为决定胜负的关键。&f这些稀有遗物仅存在于&a战利品宝箱 &f中，或是在击败强大的&a头目后获得。"]
	quest.58594C42A7BA0C99.quest_subtitle: "&7获取一件具有强大战斗效果的遗物"
	quest.58594C42A7BA0C99.title: "&5&l任务：&r&e梅贾的窃魂卷"
	quest.58745A37B0FCBF9C.quest_subtitle: "&7获取一颗从多种魔法矿石中开采出的宝石"
	quest.58745A37B0FCBF9C.title: "&5&l任务：&r&e翡翠"
	quest.5913CBDF971DA3AF.quest_desc: ["&f借助稀有材料，你能锻造出威力巨大的武器。&a&f&a疾风之刃 &f需要&a霜冻精华 &f和一颗灵魂才能打造。&f这件武器体现了战斗中的速度与精准。&f只有精通身法的人才能有效使用它。"]
	quest.5913CBDF971DA3AF.quest_subtitle: "&7锻造一件风与速度的武器"
	quest.5913CBDF971DA3AF.title: "&5&l任务：&r&e疾风之刃"
	quest.596C6DD71B1273DC.quest_subtitle: "&7获取一根注入了风之力的魔法法杖"
	quest.596C6DD71B1273DC.title: "&5&l任务：&r&e风之杖"
	quest.59DF477034F980C5.quest_desc: ["&f夜幕降临时，世界会变得更为&a危险 &f且残酷无情。&f敌对生物会从阴影中现身，让毫无准备的冒险者更难生存。&f制作一张&a床 &f可以让你跳过黑夜，在更安全的条件下面对世界。&f片刻的&a休息 &f可能就是生与死的区别。"]
	quest.59DF477034F980C5.quest_subtitle: "&7躲避夜间的危险"
	quest.59DF477034F980C5.title: "&5&l任务： &r&e为旅程休整"
	quest.5A9D4360688BBC9C.quest_desc: ["&f材料的终极融合造就了无与伦比的 &a力量。 &f&a下界合金钻石锭 &f融合了此前所有变体的优势。 &f用它强化的护甲可提供最高的 &a抗性 &f与防护，抵御多重威胁。 &f如今，你已立于几乎所有危险之上。"]
	quest.5A9D4360688BBC9C.quest_subtitle: "&7将所有力量合而为一"
	quest.5A9D4360688BBC9C.title: "&5&l任务： &r&e下界合金钻石锭"
	quest.5B6B7191047CE7A6.quest_desc: ["&f击败恶龙后，它的躯体中仍蕴含着强大的 &a力量。 &f使用瓶子，你就能从它的遗骸中提取出珍贵的 &a龙血 &f。 &f&a火龙 &f的血液是锻造传奇龙钢的关键材料。 &f务必小心处理，因为它蕴含着纯粹毁灭的精髓。"]
	quest.5B6B7191047CE7A6.quest_subtitle: "&7提取火龙的血液"
	quest.5B6B7191047CE7A6.title: "&5&l任务： &r&e火焰精华"
	quest.5BB399A6E44864FF.quest_desc: ["&f将 &a大地套装 &f与 &a下界合金 &f及特殊锻造模板重新锻造，即可解锁其更强大的 &a下界合金形态。 &f这套升级后的护甲能加深与大地的联结，提供更强的韧性与魔法力量。 &f它的大地力量加成从 &a25% 提升至 30%， &f相比基础套装额外提升 &a5% &f。 &f唯有如磐石般坚定之人，方能发掘其中隐藏的真正力量。"]
	quest.5BB399A6E44864FF.quest_subtitle: "&7用下界合金升级你的大地护甲"
	quest.5BB399A6E44864FF.title: "&5&l任务： &r&e下界合金大地套装"
	quest.5C3039C93C56B3DC.quest_desc: ["&f这件工具注入了冰霜之力，能赋予使用者强大的 &a力量。 &f&a冰龙钢镐 &f能够以惊人的 &a效率击碎各种材料。 &f即便是最坚硬的方块，也会在它的冰寒之刃下屈服。 &f这是一件兼具精准与耐用的工具。"]
	quest.5C3039C93C56B3DC.quest_subtitle: "&7制作一把冰龙钢镐"
	quest.5C3039C93C56B3DC.title: "&5&l任务： &r&e冰龙钢镐"
	quest.5CD8BBEF84EE998B.quest_desc: ["&f要想达到防御的巅峰，你就必须用 &a力量强化你的装备。 &f使用 &a模板，将你的 &a钻石菱形盾 &f与下界合金结合进行升级。 &f升级后的盾牌将拥有更出色的耐久度、更强的 &a招架 &f能力以及更高的 &a护甲值。 &f这面盾牌专为最激烈的战斗而生。"]
	quest.5CD8BBEF84EE998B.quest_subtitle: "&7将你的盾牌升级为终极防御形态"
	quest.5CD8BBEF84EE998B.title: "&5&l任务： &r&e下界合金菱形盾"
	quest.5D28F2DD31942A14.quest_desc: ["&f体型庞大的 &a独眼巨人 &f依靠纯粹的 &a力量 &f来碾压敌人。 &f其巨大的体型和力量使其成为危险的对手。 &f不过，它的视野有限，只要保持 &a谨慎，你就有机会取胜。 &f善用它唯一的弱点来击败它吧。"]
	quest.5D28F2DD31942A14.quest_subtitle: "&7击败独眼巨人"
	quest.5D28F2DD31942A14.title: "&5&l任务： &r&e独眼巨人"
	quest.5DD09E8FED928044.quest_subtitle: "&7获取失落的眼睛"
	quest.5DD09E8FED928044.title: "&5&l任务： &r&e失落的眼睛"
	quest.5E38D8BE93C2A2A3.quest_desc: ["&f&a红宝石蛇形雕像 &f是一件注入了红宝石凶猛能量的魔法遗物。&f它能增强你的&a攻击力，&f为那些偏爱直接致命战斗的玩家提供可靠的攻击加成。"]
	quest.5E38D8BE93C2A2A3.quest_subtitle: "&7制作一件能增强攻击力的遗物"
	quest.5E38D8BE93C2A2A3.title: "&5&l任务：&r&e红宝石蛇形雕像"
	quest.5F86DC70784BDD56.quest_desc: ["&f在最为稀有的宝藏中，有&a高级遗物，&f这些神器能提供卓越的&a增益效果，&f用于战斗。&f这些强大的物品无法制作，只能作为&a战利品&f在地下城、建筑中或击败首领后获得。&f它们的力量能极大地提升你的能力。&f只有最坚定的人才能获得它们。"]
	quest.5F86DC70784BDD56.quest_subtitle: "&7发现拥有超凡力量的神器"
	quest.5F86DC70784BDD56.title: "&5&l任务：&r&e高级遗物"
	quest.5F927A286E6F1EC8.quest_subtitle: "&7获得黑之眼"
	quest.5F927A286E6F1EC8.title: "&5&l任务：&r&e黑之眼"
	quest.6034DA770A936A5E.quest_desc: ["&f击败远古&a尸鬼后，&f你就可以夺取它那把传奇的&a剑。&f&a尸鬼之刃&f会根据一天中的不同时间变得更强，使其成为一件独特的&a武器&f。&f要掌握它的力量，就需要留意周围的环境。&f只有真正的勇士才能有效地使用它。"]
	quest.6034DA770A936A5E.quest_subtitle: "&7夺取那位陨落冠军的武器"
	quest.6034DA770A936A5E.title: "&5&l任务：&r&e尸鬼之刃"
	quest.60E5AE278DEA6407.quest_desc: ["&f&a海蓝宝石锦鲤摆件 &f是一件灵感源自流水与疾风之优雅的神秘遗物。&f它能为&a水 &f和 &a风元素力量提供加成，&f尤其适合依赖多变且流畅元素魔法的施法者。"]
	quest.60E5AE278DEA6407.quest_subtitle: "&7用水与风元素力量打造一件遗物"
	quest.60E5AE278DEA6407.title: "&5&l任务：&r&e海蓝宝石锦鲤摆件"
	quest.6129CA3656FDB61A.quest_desc: ["&f从强大敌人的遗骸中，你或许能获得一颗充满黑暗能量的&a恶魔之心。&f此物品可用于打造致命的&a嗜血 &f武器，赋予你独特的战斗能力。&f它还可以被熔炼成&a熔融核心 &f以供后续使用。&f请小心处理，它的&a力量 &f并非没有风险。"]
	quest.6129CA3656FDB61A.quest_subtitle: "&7驾驭陨落恶魔的力量"
	quest.6129CA3656FDB61A.title: "&5&l任务：&r&e恶魔之心"
	quest.619853CA47493C29.quest_desc: ["&f这把武器在噼啪作响的能量中锻造而成，蕴含着强大的&a力量。&f&a闪电龙钢剑 &f能以令人目眩的速度和力量发动攻击。&f其蓄能之刃能增强你在战斗中的&a力量 &f。&f很少有人能反应得足够快来躲过它的斩击。"]
	quest.619853CA47493C29.quest_subtitle: "&7打造一把闪电龙钢剑"
	quest.619853CA47493C29.title: "&5&l任务：&r&e闪电龙钢之刃"
	quest.61A31F2DE255E080.quest_desc: ["&f以精炼的&a力量赋能您的装备。&f使用&a下界合金金锭 &f可将您的下界合金护甲升级，从而获得更高的&a抗性。&f穿戴此套装可让您在猪灵中穿行而不会引发冲突。&f并非所有战斗都必须正面交锋。"]
	quest.61A31F2DE255E080.quest_subtitle: "&7用黄金融合升级您的护甲"
	quest.61A31F2DE255E080.title: "&5&l任务：&r&e下界合金金护甲"
	quest.626BCAEBA9E3C71E.quest_subtitle: "&7找到焦灼矿洞"
	quest.626BCAEBA9E3C71E.title: "&5&l任务：&r&e焦灼矿洞"
	quest.631AE9C90DF3E686.quest_subtitle: "&7找到黄金地下城"
	quest.631AE9C90DF3E686.title: "&5&l任务：&r&e黄金地下城"
	quest.63C7172A3056E87F.quest_desc: ["&f&a大地套装 &f主要由&a尖刺滴水石锻造而成，&f这是一种由地球恒久力量塑造的材料。&f穿戴它时，您的&a大地之力 &f将提升 &a25%，&f使其成为掌控岩石与土壤之人的完美护甲。&f与其他元素套装一样，它可以通过使用&a升级 &f并配合 &a下界合金 &f与特殊的锻造模板来解锁更强的韧性。&f它的力量体现了大地本身坚不可摧的意志。"]
	quest.63C7172A3056E87F.quest_subtitle: "&7打造植根于大地力量的护甲"
	quest.63C7172A3056E87F.title: "&5&l任务：&r&e大地套装"
	quest.63DB0533F92179A6.quest_desc: ["&f此武器在炽烈火焰的核心锻造而成，蕴含着强大的&a力量。&f&a火龙钢剑 &f能对敌人发动毁灭性的攻击。&f其燃烧的精髓能增强您在战斗中的&a力量 &f。&f鲜有人能抵挡住它的灼热。"]
	quest.63DB0533F92179A6.quest_subtitle: "&7锻造一把火钢龙剑"
	quest.63DB0533F92179A6.title: "&5&l任务： &r&e火钢龙刃"
	quest.64D883B4FD2B4F64.quest_subtitle: "&7获得一根注入了星辰之力的魔法法杖"
	quest.64D883B4FD2B4F64.title: "&5&l任务： &r&e以太法杖"
	quest.65A98C0D6A3613E0.quest_desc: ["&f&a维京符文项链 &f赋予其戒指版本同等的武学力量，同时提升 &a狂怒之力 &f与 &a攻击伤害。 &f对于希望在战斗中打出更高伤害的战士来说，这是一款实用的饰品。"]
	quest.65A98C0D6A3613E0.quest_subtitle: "&7锻造一条能强化狂怒与攻击的项链"
	quest.65A98C0D6A3613E0.title: "&5&l任务： &r&e维京符文项链"
	quest.662D8F569B6BD694.quest_desc: ["&f击败强大的 &a末影龙后， &f它会留下一件稀有的 &a战利品。 &f&a龙蛋 &f是你胜利与强大 &a力量的证明。 &f很少有冒险者能获得如此殊荣。 &f它象征着对末地的掌控。"]
	quest.662D8F569B6BD694.quest_subtitle: "&7夺取终极战利品"
	quest.662D8F569B6BD694.title: "&5&l任务： &r&e龙蛋"
	quest.663384D3143F528F.quest_desc: ["&a黄水晶 &f能用于制作闪耀的戒指与项链，增强 &a光明 &f与 &a治愈的力量。 &f对于在战斗中保护、恢复与支援他人的玩家来说，这些饰品极为珍贵。"]
	quest.663384D3143F528F.quest_subtitle: "&7制作具有光明与治愈力量的戒指与项链"
	quest.663384D3143F528F.title: "&5&l任务： &r&e黄水晶饰品"
	quest.66FDB49E583647DB.quest_desc: ["&f凭借霜冻的沉稳之力，就连农耕也获得了新的&a力量。&f&a冰龙钢锄&f能以稳定的&a效率准备土地。&f它能为你的资源带来平衡与控制。&f真正的精通体现在每一项任务之中。"]
	quest.66FDB49E583647DB.quest_subtitle: "&7打造一把冰龙钢锄"
	quest.66FDB49E583647DB.title: "&5&l任务：&r&e冰龙钢锄"
	quest.673BE7938F2A4D12.quest_desc: ["&f在月能指引下，&a月骑士&f是一位纪律严明且致命的&a战士。&f其精准的攻击与对战局的掌控使其成为一位强大的对手。&f保持&a警惕&f并适应其战斗风格。&f战胜它便证明了你在战斗中的真正精通。"]
	quest.673BE7938F2A4D12.quest_subtitle: "&7击败月之战士"
	quest.673BE7938F2A4D12.title: "&5&l任务：&r&e月骑士"
	quest.6791A45F45BD53A0.quest_desc: ["&f此武器由强力材料锻造而成，蕴含着强大的&a力量。&f&a利维坦战斧&f需要&a霜晶&f与一个灵魂才能打造。&f其每一次劈砍都蕴含着压倒性的力量与冰霜之威。&f这是属于战场主宰者的真正武器。"]
	quest.6791A45F45BD53A0.quest_subtitle: "&7打造一件冰封力量的武器"
	quest.6791A45F45BD53A0.title: "&5&l任务：&r&e利维坦战斧"
	quest.67E6BCE0683B1A00.quest_desc: ["&f一尊强大的 &a巫妖 &f已然崛起，它将世界扭曲成无尽的黑夜，直到被击败为止。&f这名亡灵法师狡猾而危险，总能在 &a你最意想不到的时刻出现在你身后 &f。&f请保持 &a警惕 &f，在战斗中切勿放松戒备。&f只有击败它，黑夜才会真正终结。"]
	quest.67E6BCE0683B1A00.quest_subtitle: "&7击败亡灵术士"
	quest.67E6BCE0683B1A00.title: "&5&l任务：&r&e巫妖王"
	quest.68208905F4C81EF4.quest_desc: ["&f在最为稀有的武器之中，有一把 &a凤凰重型弩。&f这把强大的远程 &a武器 &f只能通过探索或击败首领来获得。&f它承载着重生与毁灭的精髓。&f对任何冒险者而言，这都是一件真正的至宝。"]
	quest.68208905F4C81EF4.quest_subtitle: "&7夺取重生的力量"
	quest.68208905F4C81EF4.title: "&5&l任务：&r&e凤凰重型弩"
	quest.685C19B56E3432F8.quest_desc: ["&f为持续不断的战斗而锻造的 &a双刃屠刀 &f是一件稀有而致命的 &a武器。&f它无法被制造，必须在建筑中找到或从首领处获得。&f其速度与残暴足以压倒敌人。&f只有技艺高超的战士才能驾驭它。"]
	quest.685C19B56E3432F8.quest_subtitle: "&7找到屠杀双刃"
	quest.685C19B56E3432F8.title: "&5&l任务：&r&e双刃屠刀"
	quest.68E6EB8CEF2B2CB1.quest_desc: ["&f一种名为 &a魂体 &f的恐怖生物携着压倒性的 &a力量现身。 &f这个四臂怪物在近战中既强大又毫不留情。 &f如果你靠得太近，它的存在会 &a减缓你的速度， &f让你难以逃脱。 &f保持 &a警惕， &f明智地选择距离才能击败它。"]
	quest.68E6EB8CEF2B2CB1.quest_subtitle: "&7击败四臂憎恶"
	quest.68E6EB8CEF2B2CB1.title: "&5&l任务： &r&e魂体"
	quest.695DBA9F0C58311A.quest_subtitle: "&7获取旧之眼"
	quest.695DBA9F0C58311A.title: "&5&l任务： &r&e旧之眼"
	quest.6AD99CDBE8E857BE.quest_subtitle: "&7获取诅咒之眼"
	quest.6AD99CDBE8E857BE.title: "&5&l任务： &r&e诅咒之眼"
	quest.6B3897CAFB486097.quest_desc: ["&f在这世界的众多秘密之中，藏着一朵与未知力量相连的奇特 &a花朵。 &f&f&a虚空百合 &f可以被制作并放置，以揭示隐藏的道路。 &f当它被种下时，会释放出微妙的 &a粒子， &f引导你走向一个更强大的源头。 &f追随它们的踪迹，因为它们通向的，是更为强大的存在。"]
	quest.6B3897CAFB486097.quest_subtitle: "&7制作一朵来历不明的花朵"
	quest.6B3897CAFB486097.title: "&5&l任务： &r&e虚空百合"
	quest.6BB5834419D494BF.quest_subtitle: "&7制作一根由大地之力铸就的法杖"
	quest.6BB5834419D494BF.title: "&5&l任务： &r&e黏土法杖"
	quest.6C29AE4F5ADE6F8A.quest_subtitle: "&7获取寒之眼"
	quest.6C29AE4F5ADE6F8A.title: "&5&l任务： &r&e寒之眼"
	quest.6CB6856B4884FCA0.quest_subtitle: "&7找到黑曜石竞技场"
	quest.6CB6856B4884FCA0.title: "&5&l任务： &r&e黑曜石竞技场"
	quest.6CBABE53D83486CB.quest_desc: ["&f这套盔甲诞生于天际的怒火之中，代表着鲜有人能驾驭的力量。&f强大的&a龙钢闪电盔甲&f能赋予穿戴者惊人的&a速度&f与毁灭性潜力。&f只有击败过&a闪电龙&f的勇士才能锻造它，以此证明自己是真正掌控风暴的宗师。"]
	quest.6CBABE53D83486CB.quest_subtitle: "&7驾驭闪电之力"
	quest.6CBABE53D83486CB.title: "&5&l任务：&r&e风暴锻造的传说"
	quest.6D94ADEA402B250C.quest_desc: ["&f即便是大地，也会在风暴的力量面前屈服。&f&a龙钢闪电铲&f能让你以惊人的&a效率&f采集材料。&f它的能量流淌于每一次挥动之中。&f没有任何地形能减缓你的步伐。"]
	quest.6D94ADEA402B250C.quest_subtitle: "&7打造一把龙钢闪电铲"
	quest.6D94ADEA402B250C.title: "&5&l任务：&r&e龙钢闪电铲"
	quest.6ECE0C714B30442C.quest_desc: ["&f在所有已知土地之外，存在着&a终界，&f那是一个充满神秘与远古&a力量的维度。&f其广袤的虚空隐藏着未知的危险与黑暗的秘密。&f其中栖息着一头&a远古巨龙&f，它守护着这片领域。&f进入之前请做好准备，因为此地绝无仅有。"]
	quest.6ECE0C714B30442C.quest_subtitle: "&7进入超越世界的领域"
	quest.6ECE0C714B30442C.title: "&5&l任务：&r&e终界"
	quest.6EDA90976CD1E7DF.quest_desc: ["&f在末地的中心，强大的&a末影龙&f正等待着，它是这个维度中最具威势的生物。&f孤身直面它，是对&a力量&f与准备工作的真正考验。&f你必须做好充分&a准备&f，才能抵御它的攻击并摧毁它的晶体。&f击败它是任何冒险者最伟大的成就之一。"]
	quest.6EDA90976CD1E7DF.quest_subtitle: "&7击败末地的统治者"
	quest.6EDA90976CD1E7DF.title: "&5&l任务：&r&e末影龙"
	quest.6EE1849408F08A26.quest_desc: ["&f有了&a孔雀石，&f你就能打造出能增强&a大地&f与&a自然力量的魔法戒指和项链。&f这些饰品非常适合那些追求与自然世界和谐共处、坚韧不拔的人。"]
	quest.6EE1849408F08A26.quest_subtitle: "&7打造蕴含大地与自然力量的戒指和项链"
	quest.6EE1849408F08A26.title: "&5&l任务：&r&e孔雀石饰品"
	quest.6EF0311CD7A6DE45.quest_desc: ["&f在末地深处，坐落着&a一座腐朽的王国，&f一个被远古&a力量吞噬的地方。&f残垣与衰败遍布大地，&a腐朽之王&f在此统治。&f你必须小心探索并保持&a警惕&f，才能在这片危险之地幸存。&f只有找到它的人，才有资格挑战这里的统治者。"]
	quest.6EF0311CD7A6DE45.quest_subtitle: "&7在末地中找到这片废墟王国"
	quest.6EF0311CD7A6DE45.title: "&5&l任务：&r&e腐朽王国"
	quest.7007EC1CDCCA7274.quest_desc: ["&f一股寒意凝成形体，化身为&a霜冻幽魂，&f一个由纯粹冰霜构成的灵体。&f尽管它的&a生命值很低，&f但只要待在附近，就能冻结周围的一切。&f务必&a小心，&f在严寒将你吞没前迅速出击。&f哪怕只是靠近这个实体，都足以致命。"]
	quest.7007EC1CDCCA7274.quest_subtitle: "&7击败霜冻灵体"
	quest.7007EC1CDCCA7274.title: "&5&l任务：&r&e霜冻幽魂"
	quest.712417A7A491DED1.quest_desc: ["&f在世界某处藏着一座&a复活大教堂，&f那里充满了远古的&a力量。&f教堂之内，沉睡着召唤&a归返骑士的方法。&f你必须四处探索并保持&a警惕，&f才能找到它的位置。&f唯有找到此地者，方能挑战那拒绝长眠的存在。"]
	quest.712417A7A491DED1.quest_subtitle: "&7找到永恒归返之地"
	quest.712417A7A491DED1.title: "&5&l任务：&r&e复活大教堂"
	quest.71A48004F6F463EB.quest_desc: ["&f&a风之套装&f由&a风之充能的力量打造而成，&f赋予穿戴者天空般的迅捷与自由。&f装备此套装时，你的&a空中力量将&f提升&a25%，&f使其成为风系魔法修行者的理想之选。&f此套装还可使用&a下界合金&f和特殊的锻造模板进行&a升级，&f从而解锁更强大的潜力。&f唯有掌控气流之人，方能真正驾驭其力量。"]
	quest.71A48004F6F463EB.quest_subtitle: "&7打造一件受风之力祝福的护甲"
	quest.71A48004F6F463EB.title: "&5&l任务： &r&e风之套装"
	quest.72703CE840B2866A.quest_subtitle: "&7获取一根元素掌控传奇法杖"
	quest.72703CE840B2866A.title: "&5&l任务： &r&e化身法杖"
	quest.731F2947C1705A64.quest_subtitle: "&7打造一根蕴含风之迅捷的法杖"
	quest.731F2947C1705A64.title: "&5&l任务： &r&e羽毛法杖"
	quest.736F4A1D4C505C5E.quest_subtitle: "&7获取凋零之眼"
	quest.736F4A1D4C505C5E.title: "&5&l任务： &r&e凋零之眼"
	quest.73EC15B40A21CFAF.quest_desc: ["&f&a翡翠猎鹰雕像 &f是一件锋利而优雅的遗物，擅长远程精准打击。 &f与其他翡翠制品一样，它能提升你的 &a远程伤害， &f使其成为弓箭手、猎手和远程战士的理想选择。"]
	quest.73EC15B40A21CFAF.quest_subtitle: "&7打造一件能提升远程伤害的遗物"
	quest.73EC15B40A21CFAF.title: "&5&l任务： &r&e翡翠猎鹰雕像"
	quest.742B1C2106C43CE2.quest_subtitle: "&7找到冰矿竖井"
	quest.742B1C2106C43CE2.title: "&5&l任务： &r&e冰矿竖井"
	quest.74DCDA12B9CC526D.quest_desc: ["&f使用 &a坦桑石， &f你可以打造出能增强 &a冰 &f与 &a灵魂魔法的神秘戒指和项链。 &f这些饰品适合那些驾驭寒冷、死亡与遗忘能量的使用者。"]
	quest.74DCDA12B9CC526D.quest_subtitle: "&7打造蕴含冰与灵魂力量的戒指和项链"
	quest.74DCDA12B9CC526D.title: "&5&l任务： &r&e坦桑石饰品"
	quest.760D6AE03E71EA3D.quest_desc: ["&f并非所有盾牌都千篇一律，有些将防护与 &a格调融为一体。 &f&a金色风筝盾 &f能提供不错的防御，同时还能让你精准 &a招架。 &f当它被握在副手时，还会为你提供额外的 &a护甲 &f来保护自身。 &f对于不断成长的战士而言，这是一次值得的升级。"]
	quest.760D6AE03E71EA3D.quest_subtitle: "&7设计优雅，防御精湛"
	quest.760D6AE03E71EA3D.title: "&5&l任务： &r&e金色风筝盾"
	quest.7BA715471BCF42F9.quest_subtitle: "&7找到银色地牢"
	quest.7BA715471BCF42F9.title: "&5&l任务： &r&e银色地牢"
	quest.7CE41ADC6A599824.quest_desc: ["&f传说中的&a风暴之怒 &f是一件注入了风暴&a力量的武器。&f它只能在隐藏结构中寻得，或从强大的敌人身上获得。&f它的攻击迅疾而毁灭性十足。&f只有掌控风暴之人方能驾驭它。"]
	quest.7CE41ADC6A599824.quest_subtitle: "&7驾驭风暴的怒火"
	quest.7CE41ADC6A599824.title: "&5&l任务： &r&e风暴之怒"
	quest.7D0BB431CF405750.quest_subtitle: "&7找到红色沙漠矿井"
	quest.7D0BB431CF405750.title: "&5&l任务： &r&e红色沙漠矿井"
	quest.7DD8DEF4178568FC.quest_subtitle: "&7打造一根由空气与下界合金赋能的升级魔杖"
	quest.7DD8DEF4178568FC.title: "&5&l任务： &r&e下界合金风之魔杖"
