	chapter_group.6398AB49C115030C.title: "创建"
	quest.0000000080010000.quest_desc: ["制作一个**金合欢木柜**（或任何木材）作为农场或厨房的专用食物存储方块。"]
	quest.0000000080010000.title: "食物储存器"
	quest.0000000080010003.quest_desc: ["制作像**卷心菜卷**或**牛肉炖菜**这样的碗装食物。这些完整餐点饱腹感高，非常适合探索。"]
	quest.0000000080010003.title: "基本生存物资"
	quest.0000000080010007.quest_desc: ["用你的新**煎锅**准备一个**煎蛋**或烹饪一些**培根**。煎锅食谱是快速烹饪小餐的好方法。"]
	quest.0000000080010007.title: "快速煎炸"
	quest.000000008001000B.quest_desc: ["准备像**填馅南瓜**或**烤鸡块**这样的装饰性食物。它们能提供丰厚的加成，并且可以喂饱多人。"]
	quest.000000008001000B.title: "盛宴方块"
	quest.0000000080010023.quest_desc: ["切片机提供了一种机械切割方式，加快了大批量食材的准备速度"]
	quest.0000000080010023.title: "机械切片（切片与切块）"
	quest.0000000080010026.quest_desc: ["洒水器可自动为作物浇水"]
	quest.0000000080010026.title: "高效种植（切片与切块）"
	quest.000000008001002A.quest_desc: ["开始种植**甜椒**、**棉花**和**咖啡豆**，以解锁**乡村美味**提供的独特配方。"]
	quest.000000008001002A.title: "新奇的作物（乡村风情）"
	quest.000000008001002F.quest_desc: ["酿造**糖浆**，用作咖啡、薄饼和饼干的主要甜味剂。它是乡村厨房里的液体黄金。"]
	quest.000000008001002F.title: "液态黄金（糖浆）"
	quest.0000000080010032.quest_desc: ["烤一叠**薄饼**！用**糖浆**或水果做配料，制作一份高饱度的早餐。"]
	quest.0000000080010032.title: "完美的堆叠（煎饼）"
	quest.0000000080010035.quest_desc: ["烘焙你的**咖啡豆**，制作简单的**咖啡**。这能暂时提升速度和专注度。"]
	quest.0000000080010035.title: "清晨的咖啡 (咖啡)"
	quest.0000000080010038.quest_desc: ["将咖啡与牛奶、糖浆或巧克力混合，可以制作出**糖浆咖啡**或**巧克力咖啡**等高级饮品。"]
	quest.0000000080010038.title: "咖啡师的最佳选择"
	quest.000000008001003C.quest_desc: ["**鱿鱼墨意面**是一道高级特色菜肴，使用鱿鱼制作出独特美味的餐点。"]
	quest.000000008001003C.title: "海洋丰收"
	quest.00925514C4C0BBCE.quest_desc: ["**Extractor** 会连接到 **Drilling Machine** 上来提取矿石。使用简单的物品运输方式（如传送带或漏斗）来收集资源。"]
	quest.00925514C4C0BBCE.title: "收集物资"
	quest.00A3AD4BD4EE0FC7.quest_desc: ["**守卫塔**是你的第一道防线，为守卫提供安全的高地，以便在殖民地边界内巡逻和攻击敌对生物（或玩家）。"]
	quest.00A3AD4BD4EE0FC7.title: "建造守卫塔"
	quest.00C8C2FAC2459375.quest_desc: ["**永恒升级** 确保即使你死亡，背包及其内容物仍会留在你的物品栏中。"]
	quest.00C8C2FAC2459375.quest_subtitle: "永久保留物品栏中的物品。"
	quest.00C8C2FAC2459375.title: "永恒升级 (Everlasting Upgrade)"
	quest.011207A61DF23A64.quest_desc: ["**Drilling Machine** 是挖掘的核心方块。将其放置在已发现的矿脉中心（或你认为矿脉所在之处）的正上方，并安装一个 **Drill Head** 即可开始挖掘。"]
	quest.011207A61DF23A64.title: "挖掘机的设置方法"
	quest.0146F1A6865A373B.quest_desc: ["**Treatise Scrolls** 可通过与村民交易获得，能提升材料锻造质量或降低组件制作的资源消耗。"]
	quest.0146F1A6865A373B.title: "协同方法（论著）"
	quest.0213C3F63A653227.quest_desc: ["一个结绳的坚固位置"]
	quest.02C39AF9B0CDB5A4.quest_desc: ["随机化方块放置位置"]
	quest.030E3962451BB4BD.quest_desc: ["**Storage Controller** 将所有*物理连接*的 Sophisticated 存储方块链接为一个自动化网络。而 **Storage Tool** 则能让你无线查看、配置和链接 **Storage Links** 到网络中。"]
	quest.030E3962451BB4BD.quest_subtitle: "你存储网络的关键所在。"
	quest.030E3962451BB4BD.title: "存储控制器和网络工具"
	quest.03A6C339A6F203C6.quest_desc: ["提升你的幸运值！"]
	quest.03D3695417CE2B82.quest_desc: ["带曲柄的大型齿轮轮盘"]
	quest.03DB76C4A4A1386B.quest_desc: ["**漏斗升级** 是一个强大的集成漏斗，用于自动化输入或输出。而**高级**版本则支持过滤和其他复杂的分拣逻辑。"]
	quest.03DB76C4A4A1386B.title: "漏斗升级包"
	quest.03F9939977753992.title: "铁质背包"
	quest.043D87F52A55D8F9.quest_desc: ["与岩石切割轮完美配合使用"]
	quest.04AC241FE350DD86.quest_desc: ["处理海难残骸的好帮手"]
	quest.051E5008AF90F86B.quest_desc: ["一个有更多侧面的齿轮箱"]
	quest.05E72D0E7AC4B29A.quest_desc: ["**煎锅**用于需要煎炸或翻炒食材的配方，通常能做出美味的肉饼和蔬菜杂烩。"]
	quest.05E72D0E7AC4B29A.title: "正在煎制晚餐"
	quest.0602CB99A77F9CB8.quest_desc: ["终极便携储物装备。下界合金背包防火，并提供最多的升级槽和储物空间。"]
	quest.0602CB99A77F9CB8.title: "下界合金背包"
	quest.06AFC3385C85BBD6.quest_desc: ["这有多长，多少个方块那么长？"]
	quest.074223593520B23E.quest_desc: ["本章将引导你了解 **Tetra** 模组的核心机制和功能，完成入门学习。"]
	quest.074223593520B23E.quest_subtitle: "欢迎来到Tetra"
	quest.074223593520B23E.title: "Tetra 简介"
	quest.076C39593E801A5E.quest_desc: ["用于产生推力的螺旋桨"]
	quest.085F473094778DCD.quest_desc: ["**资源卷轴**是一种实用的道具，可用于从仓库中即时召唤所需资源，或将所需物品存入仓库。"]
	quest.085F473094778DCD.title: "实用工具：资源卷轴"
	quest.08ACA2EAE7CB44AA.title: "爆破升级包"
	quest.08CEE78252594F5F.quest_desc: ["Sophisticated Storage 方块可通过 Tier Upgrades 即时升级到更高等级。从 **Basic to Copper** 开始，解锁中后期的容量。"]
	quest.08CEE78252594F5F.quest_subtitle: "右键点击你的存储方块以进行升级。"
	quest.08CEE78252594F5F.title: "存储层级升级"
	quest.0902520ECB26E099.quest_desc: ["用漏斗将燃料倒入你的反应堆中"]
	quest.0ABA0995CC4AB6CB.quest_desc: ["使用**过滤升级**来精确定义哪些物品可以放入（或移出）背包。**高级**版本会增加过滤槽位。"]
	quest.0ABA0995CC4AB6CB.quest_subtitle: "输入/输出物品控制器"
	quest.0ABA0995CC4AB6CB.title: "过滤器升级组件"
	quest.0AC85C39CEEE118C.quest_desc: [
		"从远处挖掘方块！"
		"（在天空岛屿上挖矿很有用）"
	]
	quest.0B009391E3F76D6E.quest_desc: ["**渔夫小屋**能为你提供稳定、无需管理的鱼类来源。将小屋放置在水上，并雇佣一名渔夫来保持你早期的食物储备。"]
	quest.0B009391E3F76D6E.title: "渔夫小屋"
	quest.0B12EBD18763F023.quest_desc: ["思考一下！"]
	quest.0BE6236A78C6894D.quest_desc: ["**压缩升级**会自动将物品转换为方块形式（例如，九个铁锭变成一个铁块），从而节省大量空间。"]
	quest.0BE6236A78C6894D.quest_subtitle: "最大化方块存储密度。"
	quest.0BE6236A78C6894D.title: "压缩升级组件"
	quest.0C2B7732BCF7BC81.quest_desc: ["获取**快速锁定**组件，可用于**工具腰带**或**弓**。体验这项快速使用技能的便利！"]
	quest.0C2B7732BCF7BC81.title: "快速部署机制"
	quest.0D6E099A1A242153.quest_desc: [
		"**市政厅** 是你的殖民地中心，它定义了殖民地边界，并容纳着殖民地控制方块。"
		"将市政厅方块放置在你用**补给部署器**设置的部署边界内。"
		"使用**金块权杖**选择市政厅方块，选择建造风格，并为其提供资源以通过建造者开始施工。"
	]
	quest.0D6E099A1A242153.title: "市政厅：殖民地的心脏"
	quest.0DCC41C7AEE63B32.quest_desc: ["用于产生热空气的红石动力燃烧器"]
	quest.0DF990C01E668B43.quest_desc: ["弓是一种强大的投射武器，而它的**Tetra**版本也不例外。尝试不同的弓组件来最大化你的攻击力。"]
	quest.0DF990C01E668B43.title: "大师弓箭手的武器"
	quest.0E000B8A071C1F4B.quest_desc: ["吸收经验值光球！"]
	quest.0E1056A87BB27BC9.quest_desc: ["用磁铁矿包围发电机线圈，即可获得&4FE能量！&r"]
	quest.0E3C466668EDC434.quest_desc: ["在剑上使用**Stonecutter**材料，可获得**横扫挖掘石头**等方块的特殊能力。"]
	quest.0E3C466668EDC434.title: "石匠雕刻刀（The Stone Carver Blade）"
	quest.0EBB4E5195610A82.quest_desc: ["**Sawmill** 是一种先进的木材生产建筑，可将原木制成木板，为建筑师制作所需物品，并最终能制作高级木块。"]
	quest.0EBB4E5195610A82.title: "高级木材：锯木厂"
	quest.0ED823E6406CCC36.quest_desc: ["这不是魔法，是科学！"]
	quest.0F409DACBEB7BBF8.quest_desc: ["**补给箱部署器**比营地提供更稳健的开局，初始箱子更大，建造市政厅的资源也更充足。"]
	quest.0F409DACBEB7BBF8.title: "选项：补给箱部署器"
	quest.0F6777CAB70D17AE.quest_desc: ["**矿脉探测器**会给出附近矿脉的初始方向。试试在矿脉地图上放置它，看看效果"]
	quest.0F6777CAB70D17AE.title: "高级勘探 (Atlas)"
	quest.10BC36D23A81AF11.quest_desc: ["**Limited Barrel** 系列牺牲了物品栏空间以换取巨大的堆叠容量，非常适合储存石头、木头或泥土等单一物品。"]
	quest.10BC36D23A81AF11.quest_subtitle: "高密度的大容量存储系统。"
	quest.10BC36D23A81AF11.title: "限定桶 (Limited Barrels)"
	quest.10DF3D58FD817EF2.quest_desc: [
		"将锤子升级为更强大的物品制造工具。"
		"你需要另一个锤子来进行升级。"
		"（所以我又给了你一个，在上面 XD）"
	]
	quest.10DF3D58FD817EF2.title: "新石器时代"
	quest.1157A9548EB3044A.quest_desc: ["高导电金属"]
	quest.120152510AD4B59A.quest_desc: ["**建造护目镜**能让你在建筑放置前就看到其轮廓，帮助你完美规划殖民地布局。"]
	quest.120152510AD4B59A.title: "实用工具：建造护目镜"
	quest.125C1B72258B20FE.quest_subtitle: "电动机将&cFE&r转化为动能。交流发电机将&9旋转力转化为电能。&r"
	quest.125C1B72258B20FE.title: "制作 &c电动机和交流发电机"
	quest.128D971AEC6AC230.quest_desc: ["**终极钻头**是本模组的最强装备，能以最高速度钻探任何矿脉，不受其成分限制。"]
	quest.128D971AEC6AC230.title: "顶峰发掘工程"
	quest.130E8FC7479E4271.quest_desc: ["**牧羊小屋**负责管理用于生产羊毛的羊群。它们需要剪刀才能运作。"]
	quest.130E8FC7479E4271.title: "牧羊人：牧羊人小屋"
	quest.1312B33261493897.quest_desc: ["更强的磁铁意味着更多的&4FE能量&r"]
	quest.132AF80A62FFF98D.quest_desc: ["**酒馆**是吸引新居民的枢纽。等级更高的酒馆能更快地吸引新居民。确保系统中有食物，以鼓励他们留下！"]
	quest.132AF80A62FFF98D.title: "建造酒馆：招募居民"
	quest.138C764D48EB4127.title: "欢迎来到农场世界，开始你的冒险之旅！"
	quest.14DA3DC7C0009A6A.quest_desc: ["殖民地人口达到顶峰！拥有**50**名公民是一项巨大的成就。维持这一人口需要强大的资源管理和高级建筑。"]
	quest.14DA3DC7C0009A6A.title: "人口里程碑：50名居民"
	quest.1501C5011A3702F2.quest_desc: ["来思考我一下吧！"]
	quest.154A2371225585E9.quest_desc: ["为此你需要一些&4FE能量&r和一个&b能量源&r！"]
	quest.15B51FB56A64C303.quest_desc: ["**大学**是训练公民担任专业角色的主要建筑，能解锁学者等高级职业，提升研究速度和公民素质。"]
	quest.15B51FB56A64C303.title: "大学：高级培训课程"
	quest.15F03A5E7E14C022.quest_desc: ["**石匠小屋** 专精于切割、塑形和制作高级建筑及特定蓝图所需的复杂石材装饰。"]
	quest.15F03A5E7E14C022.title: "高级石材：石匠（Stonemason）"
	quest.167C5A3841D3B89F.quest_desc: [
		"**灵魂捕手**用于捕捉生物的灵魂。"
		"要生效，目标生物必须处于**虚弱效果**中，通常用投掷药水施加。"
		"捕获生物所需的时间取决于其碰撞箱体积，较小的生物捕获速度更快。"
		"Bosses cannot be captured."
	]
	quest.167C5A3841D3B89F.quest_subtitle: "捕获生物的灵魂以进行生成"
	quest.167C5A3841D3B89F.title: "捕捉灵魂"
	quest.172938CA9D2EF823.quest_desc: ["垂直物品存储箱"]
	quest.1762E8D84A5D523D.quest_desc: ["**拾取**升级可将附近的掉落物吸入桶中。**磁铁**升级能吸引更远距离的物品。使用**高级**变种以实现过滤和更远的范围。"]
	quest.1762E8D84A5D523D.title: "拾取物品升级 (Pickup Upgrades)"
	quest.187073F9830ECE79.quest_desc: ["将此连接到你的 &2Reactor Rod&r 的一侧"]
	quest.18922D8834A0CF95.quest_desc: ["根据海拔高度输出红石信号。佩戴护目镜时还会显示气压和海拔信息"]
	quest.190D10907EC19AC1.quest_desc: ["用于反应堆的燃料"]
	quest.194E863F24FFF1AD.quest_desc: ["大多数标准工具都可以转换为**Tetra**版本，它们模块化、可升级，并且会随着时间的推移而变得更强大。只需将双头或单头工具放入工作台即可开始！"]
	quest.194E863F24FFF1AD.title: "锻造更高级的工具"
	quest.19D03831EB5EED02.quest_desc: ["**铁匠**负责锻造公民和军队所需的所有金属工具、武器和盔甲。"]
	quest.19D03831EB5EED02.title: "生产：铁匠小屋"
	quest.1A17EFA6931E49CC.quest_desc: ["只有在输入端朝正确方向旋转时才会连接"]
	quest.1B48D15EF425C8C9.quest_desc: ["一个小型轮胎"]
	quest.1BB571557F74D3A1.quest_desc: [
		"MineColonies 让你能建立一个繁荣的玩家自治文明。你可以招募NPC、分配工作，并管理所有成长所需的资源。"
		""
		"旅程始于获取一个 **Supply Camp** 或 **Supply Chest** 部署器。"
	]
	quest.1BB571557F74D3A1.title: "欢迎来到MineColonies"
	quest.1BFEBF8CC804D3AB.quest_desc: ["更出色的太阳能加热器！"]
	quest.1C16AEE8E29FB5A0.quest_desc: ["**集结旗帜**是一种军事实用方块，用于将所有守卫召集到特定地点进行防御或有计划的攻击。"]
	quest.1C16AEE8E29FB5A0.title: "军事：集结旗帜"
	quest.1C29150EA7A53EFC.quest_desc: ["到处都是水，再也不能这样下去了！"]
	quest.1C910B0F5B827E9B.quest_desc: [
		"建造你的第一把锤子来开始四重奏。"
		"另一个工作台可以制作成工作桌。"
	]
	quest.1C910B0F5B827E9B.title: "你的第一把锤子"
	quest.1CA1F6BC2F508536.quest_desc: ["一个倒着的换挡杆"]
	quest.1D267ADE18DD9817.quest_desc: [
		"将附魔书右键点击&6打印机&r，即可将所需附魔保存到新书上。"
		""
		"只要打印机有足够的液态经验值，它就会复制你交给它的这本书"
		""
		"You can also duplicate books you have written in by giving it the written book, then giving the &6printer&r liquid ink &a(made in the mixer)&r"
	]
	quest.1D267ADE18DD9817.quest_subtitle: "类似于附魔书复制的那种东西"
	quest.1E1870FAD295DEDE.quest_desc: ["**补给营地部署器**会搭建一个临时工地，内含用于建造初始市政厅的箱子。这是新殖民地简单的开端。"]
	quest.1E1870FAD295DEDE.title: "选项：补给营地部署器"
	quest.1E3B2C2A5B3F8891.quest_desc: ["**压缩升级**可自动将物品转换为方块，反之亦然。对于最大化金属和石材资源的存储密度至关重要。"]
	quest.1E3B2C2A5B3F8891.title: "压缩升级组件"
	quest.1E9890769102E276.quest_desc: ["喂食 &8煤炭&r 或 &4烈焰蛋糕&r 时会产生旋转力"]
	quest.1E99ACD96AD8A826.quest_desc: ["用弹簧连接两个方块！用扳手调整它的强度"]
	quest.1EEED0E88E2869EB.quest_desc: ["一个精准的红色石原力来源"]
	quest.1F6879A74DD18F0B.quest_desc: ["一个非常大的轮胎"]
	quest.1F879560512B92E5.quest_desc: ["**过滤升级** 可精细控制哪些物品可以放入或取出存储方块。"]
	quest.1F879560512B92E5.title: "过滤器升级组件"
	quest.1F8C7E4FF3FCF23B.quest_desc: ["再也抓不到我了吧！！"]
	quest.1F8C7E4FF3FCF23B.title: "谁是玛芬人！？"
	quest.1FC3C1EC91AD1443.quest_desc: ["**唱片机升级** 让你可以在存储方块中播放唱片。而**高级版**则增加了多个槽位和播放控制。"]
	quest.1FC3C1EC91AD1443.title: "唱片机升级模组"
	quest.201CB898A399F1D5.quest_desc: ["**Swineherder Hut** 负责管理猪群，用于生产猪肉和皮革。"]
	quest.201CB898A399F1D5.title: "牧人：猪倌小屋"
	quest.203A0C651EA25098.quest_desc: ["**磁吸升级**会持续吸引物品，类似于背包版本。可以搭配过滤器进行定向收集。"]
	quest.203A0C651EA25098.title: "磁石升级组件"
	quest.206159A3C7A78447.quest_desc: ["**神秘遗迹**开启了通往高级魔法生产和资源的门户。是高级殖民地一个绝佳的长期目标。"]
	quest.206159A3C7A78447.title: "生产：神秘遗址 (Mystical Site)"
	quest.20B6827D7EBF60D3.quest_desc: ["就像烈焰炉一样！只需加入一些&4热量&r"]
	quest.20D05EB3BBB0FAAB.quest_desc: ["一个大轮胎"]
	quest.21B2D54BEC60EEBA.quest_desc: ["&6物品抽取器&r能将容器中的液体抽出，并储存起来，直到通过管道输送到另一个容器中"]
	quest.21B2D54BEC60EEBA.quest_subtitle: "流体提取"
	quest.21F20E65F0CF4FB7.quest_desc: ["Sophisticated Storage 方块提供巨大的模块化容量。制作一个基础 Chest 或 Barrel。用 **Packing Tape** 右键点击即可将其满载拾起。"]
	quest.21F20E65F0CF4FB7.title: "Sophisticated Chests and Barrels"
	quest.22F4C38E79DEFF1E.quest_desc: ["必须在已宣称的领地内放置**市政厅方块**，以建立殖民地的官方中心。请选择一个安全的位置，因为该方块放置后无法移动！"]
	quest.22F4C38E79DEFF1E.title: "放置市政厅方块"
	quest.23012F6C4C522CEB.quest_desc: ["**伐木工小屋**是你主要的木材来源。招募一名伐木工，他们就会在指定工作区（用建造工具设置）砍伐树木。"]
	quest.23012F6C4C522CEB.title: "伐木工小屋"
	quest.2316FFE66B36924B.title: "Chipped Workbenches II"
	quest.2342ED0D00362854.quest_desc: ["用扳手右键点击即可安装滑索！用剪刀可以将其剪断。"]
	quest.238BD8E064D2D4CB.quest_desc: ["**海晶灯盔甲**（Prismarine）是一套重型盔甲，能永久赋予深度行者效果，让你在水下快速移动。其锋利的纹理会对攻击你的任何生物造成尖刺伤害。"]
	quest.238BD8E064D2D4CB.title: "Tier 3: 水生尖刺"
	quest.2421FAEB8BE21B1D.quest_desc: ["P O N D E R"]
	quest.25606F0A9C843721.quest_desc: ["尝试仅沿一个轴向上翻转方向"]
	quest.25AFA8426F16F7DE.quest_desc: ["这是一个抓钩！"]
	quest.25D87D5522FD4861.quest_desc: ["试着将苹果和紫色染料混合在一起"]
	quest.25D87D5522FD4861.title: "紫颂果？"
	quest.265DEDBF34CB37AF.quest_desc: ["像皮卡朗一样，不过是着火的皮卡朗"]
	quest.2694808D51042470.title: "黄金背包"
	quest.26D2235E1F464F42.quest_desc: ["**Inception 升级** 是一种独特的高级升级，允许你将一个背包*放入*另一个背包中。"]
	quest.26D2235E1F464F42.quest_subtitle: "背包中的背包。"
	quest.26D2235E1F464F42.title: "Inception 升级包"
	quest.2721013051EA0F4E.quest_desc: ["根据朝向输出红石信号"]
	quest.27BCC7C61D5BD336.quest_subtitle: "多区块电池可储存 9M FE"
	quest.27C37C8E3AB82D99.quest_desc: ["用于在模拟装置中切割岩石的装置"]
	quest.2859F1B560AC334B.quest_desc: ["可移动的篝火"]
	quest.28EE13DE7CBE9518.quest_desc: ["基础的**Storage Upgrade Base**（木材纹理）用于制作桶、箱子和潜影盒的升级组件。"]
	quest.28EE13DE7CBE9518.quest_subtitle: "适用于桶、箱子和潜影盒"
	quest.28EE13DE7CBE9518.title: "存储升级基础模块"
	quest.298B1994C646424F.quest_desc: ["**压缩升级**是压缩升级的复杂版本，提供灵活的方块-物品和物品-方块转换逻辑。"]
	quest.298B1994C646424F.title: "压缩升级 (Compression Upgrade)"
	quest.29D06B640C276146.quest_desc: ["丢弃能量以释放多余的能量"]
	quest.2A4D23849D9E75C0.quest_desc: ["还能盛放液体物品"]
	quest.2B01B964638DFBD1.quest_desc: ["**Crusher Hut** 是一种基础处理单元，可将石头、鹅卵石和其他方块分解为建造者可用的原始资源。"]
	quest.2B01B964638DFBD1.title: "生产：破碎机小屋 Crusher Hut"
	quest.2B49C95AEE86C994.quest_desc: [
		"去工坊体验 Areonautics 的一些超棒新功能吧。"
		""
		"机库里的那架飞机还没完全修好，看看你能不能让它飞起来！"
	]
	quest.2B49C95AEE86C994.title: "准备好起飞了吗！"
	quest.2D43DDEE8D229F42.quest_desc: ["将全套 **Chipped** 装饰工作台直接添加到静态存储方块中，方便制作时取用。"]
	quest.2D43DDEE8D229F42.title: "Chipped Workbenches"
	quest.2D821681720A5409.quest_desc: ["用于制造可产生推力的螺旋桨的轴承"]
	quest.2E17BF74F0DD6A58.quest_desc: ["直升机的稳定螺旋桨轴承。该轴承试图保持螺旋桨垂直"]
	quest.2E40755A354B1ACC.quest_desc: ["输出一个随时间变化的模拟信号，以匹配其输入信号。"]
	quest.2EB2DFABB2B48B1D.quest_desc: ["无人机控制器"]
	quest.2EC8420FC47F06F9.quest_desc: ["**储罐**用于储存液体。**泵**可实现自动化流体传输，**经验泵**则处理经验流体。**电池**用于为工具充电（如适用）。"]
	quest.2EC8420FC47F06F9.title: "坦克、泵、电池升级组件"
	quest.2F17C0820C336EB5.quest_desc: ["**堆叠升级**会扩大容器中物品的最大堆叠数，最高可达**欧米茄等级**，为单一物品类型提供近乎无限的存储空间。"]
	quest.2F17C0820C336EB5.title: "堆叠升级（T1至Omega）"
	quest.2F41C6CFFB43E38F.quest_desc: ["右键移动，按住SHIFT+右键来移动物品"]
	quest.2F5AD51B6A6C01A3.quest_desc: ["过度受压时会损坏"]
	quest.30151FE4EE927AA4.quest_desc: ["用红石供电会让机器过度劳累"]
	quest.308E1F5B53BFE9AB.quest_desc: ["提供精确且可调节的旋转输出"]
	quest.30FED0F5BD258790.quest_desc: ["获取**Planar Stabilizer**组件，可应用于**Tool Belt**或**Bow**。应用它以体验平衡效果！"]
	quest.30FED0F5BD258790.title: "实现平面均衡 (Achieving Planar Equilibrium)"
	quest.318415495188777C.quest_desc: ["**Earthpiercer** 组件适用于单头工具（如铲子）。它能让工具挖掘一条由五个石块组成的直线。使用轻型手柄还能让玩家投掷工具进行远程挖掘。"]
	quest.318415495188777C.title: "深层地心穿透器"
	quest.31A3C643745E1953.quest_desc: ["**Storage I/O** 是一个高性能的输入输出方块，用于将物品泵入或泵出所连接的网络。而 **Decoration Table** 则用于颜色和外观的自定义。"]
	quest.31A3C643745E1953.title: "输入/输出端口与装饰物"
	quest.31A7FF937593A5CC.quest_desc: ["使用**末影之眼**为你的**全息球**增强扫描模式。此模式对于定位升级锤子至下一个品质等级所需的遗迹结构至关重要。"]
	quest.31A7FF937593A5CC.title: "遗迹探测升级组件"
	quest.323398F25937EDBD.quest_desc: ["提供用于导航的红石信号。使用指南针将其与磁石链接"]
	quest.32C545450F2DBD65.quest_desc: ["把一切都扔掉，不要留任何东西"]
	quest.33058894ACD9CB06.quest_desc: ["**Graveyard** 负责管理公民的死亡。如果公民死亡，可以使用特定资源在此复活（查看建筑GUI）。它还雇佣了 **Undertaker**。"]
	quest.33058894ACD9CB06.title: "支持：墓园（Graveyard）"
	quest.339EED71152EF112.quest_desc: ["用&3反应堆玻璃&r包裹你的&2反应堆棒&r来保护自己免受辐射"]
	quest.33A0198E1D098A1D.quest_desc: [""]
	quest.33B7579B8C040E54.quest_desc: ["**蒸汽朋克盔甲** 是终极实用套装：头盔提供敌对生物雷达（潜行时），胸甲有钟表/指南针HUD，护腿则能实现紧急二段跳，防止所有坠落伤害。"]
	quest.33B7579B8C040E54.title: "Tier 3: 蒸汽朋克实用工具与技术"
	quest.33FC8F6543886276.quest_desc: ["&9物理组装器&r能将物理特性注入任何它所附着的物品。（你可能需要一些蜂蜜胶水）"]
	quest.340F5320DB6749AC.quest_desc: ["一个中等轮胎"]
	quest.342A1EF584823D2C.quest_desc: ["**锯木厂**和其他工坊能让工人给建造者制作物品。确保锯木厂有火把的配方，以在夜间保护殖民地安全。"]
	quest.342A1EF584823D2C.title: "火把制作"
	quest.34E39DE9EF4F080A.quest_desc: ["MAVRICS 工程师护目镜"]
	quest.34E6DA713B6DF25F.quest_desc: ["Macaw's 提供了大量用于建造的方块"]
	quest.34F3C116A5DDEA9D.quest_desc: ["密封风扇可以产生推力"]
	quest.359C4CAEFE608840.quest_desc: [
		"锻造你的四合工具的唯一方法。"
		"你需要右键点击工作台来建造它。"
		"许多原版工具都可以在工作台里升级或改变形态。"
		"你可以在任务标签页中看到 tetra 的信息。"
	]
	quest.359C4CAEFE608840.title: "更好的合成台"
	quest.35AE07F6A0F11A4D.quest_desc: [
		"**机械生成器**是一种动能方块，会生成放置在内部的灵魂捕手所指定的生物类型。"
		"需要**旋转力（动能）**和通过管道输送的**液体**（如液体药水）作为燃料。"
		"最低需要 **128 RPM** 的转速。"
		"其压力影响取决于所含生物的最大生命值，但默认为 **80 SU / RPM**。"
		"手持空手或扳手右键以配置生成区域。"
	]
	quest.35AE07F6A0F11A4D.quest_subtitle: "用于刷怪的动能方块"
	quest.35AE07F6A0F11A4D.title: "机械刷怪器"
	quest.35F368749ADA0A9A.quest_desc: ["将两个模拟装置粘合在一起"]
	quest.360E9E02A494217C.quest_desc: ["**Barracks Tower** 是哨塔的升级版，防御力更高。驻扎于此的守卫效率更高，视野也更广。"]
	quest.360E9E02A494217C.title: "军事：兵营塔楼"
	quest.36777FCDAA9ABDF7.quest_desc: ["**工具切换器**会在你破坏方块时，自动将当前工具切换到最适合的工具。非常适合快速采矿和伐木。"]
	quest.36777FCDAA9ABDF7.quest_subtitle: "务必使用正确的工具。"
	quest.36777FCDAA9ABDF7.title: "工具交换器升级包"
	quest.3681C21A44EBD0C0.quest_desc: ["发现**战争工具卷轴**可解锁**战争熔炉**功能，适用于非主要设计用于战斗的工具。"]
	quest.3681C21A44EBD0C0.title: "战争锻造卷轴"
	quest.369CB78ACDDB0A88.quest_desc: ["获得一块**火腿**！火腿是一种珍贵的肉类，可以在篝火上烹饪，或用于高级配方。试试烹饪**蜂蜜糖衣火腿块**吧！"]
	quest.369CB78ACDDB0A88.title: "美味的一刀切"
	quest.37BE190EE466D697.quest_desc: ["将**市政厅升级到5级**是原始市政厅结构的最后阶段，可授予最大影响力并解锁所有可用基地功能。"]
	quest.37BE190EE466D697.title: "市政厅等级 5 (MAX)"
	quest.37E43341FA234E84.quest_desc: ["**花店小屋**专注于种植和收集花朵与高草，以生产染料和其他装饰性资源。"]
	quest.37E43341FA234E84.title: "生产：花店小屋 Florist Hut"
	quest.3806D43A958A0751.quest_desc: ["检测阻挡激光笔的方块，可过滤特定方块"]
	quest.38E452884834812E.quest_desc: ["**Schematic Scrolls** 能为你的 **Tetra** 工具赋予特殊、独特的能力和模块。"]
	quest.38E452884834812E.title: "工匠的蓝图 Craftsman's Blueprints"
	quest.390F025F4B6316CA.quest_desc: ["Chipped 和 Rechiseled 方块都可以通过 create 自动化，或者在背包里制作！"]
	quest.3A6250944C41A0BF.quest_desc: ["**Earthpiercer** 组件适用于单头工具（如铲子）。它能让工具挖掘一条由五个石块组成的直线。使用轻型手柄还能让玩家投掷工具进行远程挖掘。"]
	quest.3A6250944C41A0BF.title: "深层地心穿透器"
	quest.3AE1C3290500638F.quest_desc: ["你的殖民地人口已达到 **10** 名公民！你需要建造更多住宅并确保稳定的食物供应才能继续发展。"]
	quest.3AE1C3290500638F.title: "人口里程碑：10名居民"
	quest.3B40A769EDB26EA2.quest_desc: ["**Postbox** 和 **Stash** 方块对于 **Deliveryman** 在殖民地内妥善管理和移动资源至关重要。"]
	quest.3B40A769EDB26EA2.title: "Craft Logistics 方块"
	quest.3B91163DE3DA885C.quest_desc: ["**下界工人小屋**是自动化收集下界专属资源（如下界岩和石英）的关键，能让你的殖民地发展到中后期。"]
	quest.3B91163DE3DA885C.title: "生产：下界工人小屋"
	quest.3DD65447EA2C0EEF.quest_desc: ["一个能产生大量热空气的蒸汽动力燃烧器"]
	quest.3E6032E2197B8FFB.quest_desc: ["需要蜂蜜！(相信我，值得的)"]
	quest.3F8DE97B1961FA95.quest_desc: ["持续升级你的工具腰带，以解锁最大的实用性和便利性。遵循材料进阶顺序：**羊毛** $\\rightarrow$ **皮革** $\\rightarrow$ **铁** $\\rightarrow$ **潜贝壳**。"]
	quest.3F8DE97B1961FA95.title: "终极工具支架"
	quest.3FBF1E57D4EDF26A.quest_desc: ["用钻石钻头升级你的钻头吧！"]
	quest.3FBF1E57D4EDF26A.title: "打破坚硬之物"
	quest.3FD5AC591D225E2A.quest_desc: ["把你的经验值存起来！简单易懂！"]
	quest.400175B13253B839.quest_desc: ["与附魔书一样，**Hone Scrolls** 也可以通过合成界面进行升级。组合卷轴以达到最高等级，解锁你 **Hone** 能力的全部潜力！"]
	quest.400175B13253B839.title: "将蜂蜜的作用发挥到极致"
	quest.401990422501F5A3.quest_desc: [
		"将你的 **Soul Catcher** 放入 **Mechanical Spawner**，提供所需的液体（配方请查看 JEI，例如液体再生药水），并为其提供至少 **128 RPM** 的转速。"
		"如果附近已有**6个或以上**该类型的生物，生成器将停止工作。"
	]
	quest.401990422501F5A3.title: "首次生成生物事件"
	quest.40727A633E80B537.quest_desc: ["无需改变出生点，随时随地都能睡觉！"]
	quest.40B057390DF9F54D.quest_desc: ["可携带热空气以升高海拔。可包裹竖井。"]
	quest.40CA6CEE85C276C9.quest_desc: ["通过为顶部供电来为侧面制动器供电以转向"]
	quest.41C06E8BE899C6B0.quest_desc: ["一个范围有限且可配置的红石链接"]
	quest.42ABFA348B764E04.quest_desc: ["**磁石**升级会持续将附近的物品吸到背包中。**高级磁石**增加了物品过滤器，让你只吸想要的物品，节省空间！"]
	quest.42ABFA348B764E04.quest_subtitle: "将物品吸引到你的背包中。"
	quest.42ABFA348B764E04.title: "磁石升级组件"
	quest.430475E11D259B74.quest_desc: ["**Stone Smeltery** 能高效地将鹅卵石等石材加工成平滑石和各种资源方块。"]
	quest.430475E11D259B74.title: "高级石材：熔岩熔炉"
	quest.44CA9AD9FFFFC90B.quest_desc: ["即使在天空中，找到双生矿也很有用！"]
	quest.44DBEF7E43052868.quest_desc: ["用于产生推力的螺旋桨"]
	quest.452652A47626C707.quest_desc: ["可移动的灵魂篝火"]
	quest.45B87D51EF224B8C.quest_desc: ["**样本钻头**是你的初始勘探工具。将其放置在方块上，用背罐供能，等待样本返回。这能告诉你地下有什么矿石。"]
	quest.45B87D51EF224B8C.title: "样本钻头"
	quest.461E28CA38F4FF8F.quest_desc: ["黑石是四阶材料，用于 tetra"]
	quest.461E28CA38F4FF8F.title: "比主世界更黑暗的世界模组任务书"
	quest.468F6E0151E77E71.title: "新工具：虚空灵魂捕手"
	quest.46ABE925335C066C.quest_desc: ["**Chipped** 升级将 Chipped 装饰工作台的全部功能添加到你的背包中。随时随地进行创意建造必备。"]
	quest.46ABE925335C066C.title: "Chipped Workbenches I"
	quest.48AC8545D66B71B7.quest_desc: ["升级**建造者小屋**能让建造者使用更复杂的蓝图（更大的建筑），并提升他们的最大技能等级。"]
	quest.48AC8545D66B71B7.title: "建筑师小屋升级"
	quest.48BF028309BD0A36.quest_desc: ["在寻找特定的结构吗？"]
	quest.490628CE108A833A.quest_desc: ["**送货员**是关键物流工人，负责在仓库和其他建筑（如建造者宝箱）之间运输货物。雇佣一个可以大大加快建筑项目！"]
	quest.490628CE108A833A.title: "快递员"
	quest.493B9FC17C3CF3CA.quest_desc: ["**兔笼**用于管理兔子，以获取兔肉和兔皮。"]
	quest.493B9FC17C3CF3CA.title: "牧羊人：兔子窝"
	quest.4976A618E0C72517.quest_desc: ["制作**砧板**。放置后，用**刀**右键可以快速切剁大量食材。"]
	quest.4976A618E0C72517.title: "尖端科技"
	quest.49793060345FB28C.quest_desc: ["**牛仔小屋**需要一群奶牛，用于生产牛奶、皮革和牛肉。"]
	quest.49793060345FB28C.title: "牧牛人：牛仔小屋"
	quest.4A2DBA7AF83A40AD.quest_desc: ["用一些粘土、石头和水制作&2Thorium&r就能得到&2更多的THORIUM&r"]
	quest.4AD661C0A10ABD3B.quest_desc: ["用管道将液体经验储罐连接到出料口，你可以通过将瓶子右键点击仓库，或将瓶子放在出料口下方的传送带上，将液体装回瓶子"]
	quest.4AD661C0A10ABD3B.quest_subtitle: "制作附魔之瓶 (Bottles o' Enchanting)"
	quest.4AEA30171CF1BFD7.quest_desc: [""]
	quest.4B2B22401FF12C27.quest_desc: ["**Smoking** 和 **Blasting** 升级会在背包中添加便携式 Smoker（用于食物）和 Blast Furnace（用于矿石），并提供自动版本。"]
	quest.4B2B22401FF12C27.quest_subtitle: "快餐和快矿石。"
	quest.4B2B22401FF12C27.title: "吸烟与爆破升级模组"
	quest.4B8FC4B924A93366.quest_desc: ["**Insulated Plate** (Vent Plate) 是制作盾牌的绝佳材料，能大幅提升耐久度和韧性。"]
	quest.4B8FC4B924A93366.title: "加固板状结构 Reinforced Platework"
	quest.4C476592AA64996B.quest_subtitle: "可为带电物品充能，也可用于对&c玩家&r和&c生物&r造成伤害。&r"
	quest.4C476592AA64996B.title: "合成 &c特斯拉线圈"
	quest.4CEA538689841610.quest_desc: ["Immersive Armors 添加了外观独特、功能强大的盔甲套装，超越了简单的材料进阶。每套盔甲都提供专属效果，如狂暴模式、抗击退、火焰抗性或二段跳。"]
	quest.4CEA538689841610.title: "沉浸式盔甲介绍"
	quest.4D34030504790509.quest_desc: ["一个齿轮箱，但平行的"]
	quest.4D61009737D94BDA.quest_desc: ["重大里程碑！你的殖民地现在有 **25** 名繁荣的公民。在这个规模下，后勤、食物和军事防御都变得至关重要。"]
	quest.4D61009737D94BDA.title: "人口里程碑：25名居民"
	quest.4D68C830E782A337.quest_desc: ["色彩缤纷的轮胎！"]
	quest.4D68E9ACA5E213AA.quest_desc: ["将柴油转化为旋转能量！"]
	quest.4D9DC4973FD340E5.quest_desc: ["**Combat Academy** 是守卫们练习和提升近战技巧的地方，能让他们更有效地抵御掠夺者和怪物。"]
	quest.4D9DC4973FD340E5.title: "军事：战斗学院"
	quest.4DD7E2BD8508A117.quest_desc: ["恭喜你，已经掌握了所有牧人职业！你的殖民地现在能管理所有动物，为你提供稳定的食物、皮革、羊毛等资源。"]
	quest.4DD7E2BD8508A117.title: "所有牧者均已建立成功"
	quest.4DF313A9F6B04C63.quest_desc: ["**凋零盔甲**是终极的末游套装。它能提供无与伦比的属性，抵抗凋零效果，最重要的是：骷髅会完全无视你。"]
	quest.4DF313A9F6B04C63.title: "第五阶段：末影人终局大师"
	quest.4DFFD56294AF6E0F.quest_desc: ["用任意颜色命名你的模拟装置吧！"]
	quest.4E5A011F861FCE5A.quest_desc: ["根据速度输出红石信号。佩戴护目镜时显示精确信息"]
	quest.4EAF4F9F7317CAE1.quest_desc: ["**拾取**升级可将附近的掉落物吸入背包。**磁铁**可从更大范围吸引物品。获取**高级**版本以获得更远的范围和过滤磁吸功能！"]
	quest.4EAF4F9F7317CAE1.quest_subtitle: "自动化物品收集。"
	quest.4EAF4F9F7317CAE1.title: "拾取物品升级 (Pickup Upgrades)"
	quest.4EE36F25A452F1FC.quest_desc: ["将你的固体经验转化为液体形态！"]
	quest.4EE7DC998B846A50.quest_desc: ["主要用于合成，但你也可以把这些喂给&6Blaze Forger&r"]
	quest.4F0DD18D7647A103.quest_desc: ["**Sophisticated** 模组系列为您的世界带来了分等级、模块化的存储系统。在探索便携式（背包）或静态式（桶/箱子）方案前，请先掌握核心概念。"]
	quest.4F0DD18D7647A103.title: "Sophisticated Systems 简介"
	quest.4F15D1EB5397C942.quest_desc: ["一个可以调节侧面的齿轮箱"]
	quest.4F1BAD0FF159CDF0.quest_desc: ["找到或种植你的第一株**Farmer's Delight**作物，如**Cabbage**或**Tomato**，开始丰富你的食物来源。"]
	quest.4F1BAD0FF159CDF0.title: "新的收获"
	quest.4F546AAC6F3D4963.quest_desc: ["篝火是你烹饪小食材和生肉最基本、最可靠的加热来源。"]
	quest.4F546AAC6F3D4963.title: "热源"
	quest.506BD7AA9AB36E8F.quest_desc: [
		"**战士盔甲**（铁/青金石）：释放狂怒模式，每缺少一个心就能造成更高的伤害。专为内心的维京人打造。"
		"**重型盔甲** (铁/韧性)：提供卓越的护甲、高韧性，并大幅减少击退效果，让你成为一辆不可阻挡的坦克。"
	]
	quest.506BD7AA9AB36E8F.title: "Tier 2: 战斗与防御能力"
	quest.52453550206EC770.quest_desc: ["**Dyer Hut** 可自动化生产各种染料，用于建筑的装饰、制服和特定配方。"]
	quest.52453550206EC770.title: "生产：染色匠小屋"
	quest.52B3B09AB5BA8C90.quest_desc: ["**堆叠降级**会降低单个物品栏的堆叠上限。这有助于调节自动化输入，或确保某些物品不会填满大型存储栏位。"]
	quest.52B3B09AB5BA8C90.title: "堆叠降级物品会降级物品品质"
	quest.52FFA3E691992828.title: "铜质背包"
	quest.53795E0502DAA36D.quest_desc: ["带曲柄的齿轮"]
	quest.537A8F99CC3F525D.quest_desc: ["此里程碑追踪您的武装部队达到 **8** 名守卫时的情况。这为日益壮大的殖民地提供了可观的防御。"]
	quest.537A8F99CC3F525D.title: "军事力量：8名守卫"
	quest.53BC23A56A1080A0.quest_desc: [
		"- &6小型连接器&r使用&d电线&r连接&b兼容Forge能源&r的方块以传输&9FE&r。"
		""
		"- &6铜线轴&r可以连接到&a低压连接器&r上。"
	]
	quest.53BC23A56A1080A0.quest_subtitle: "点击"
	quest.53BC23A56A1080A0.title: "合成 &c连接器"
	quest.53F8923B85A8A9CC.quest_desc: ["此里程碑追踪您的武装部队达到 **80** 名守卫时的情况。这被视为最大战力，可实现完整的殖民地防御和大规模攻击准备。"]
	quest.53F8923B85A8A9CC.title: "军事力量：80名守卫"
	quest.5411D7D6AD053E66.quest_desc: ["**Crafting** 和 **Stonecutter** 升级将便携版实用工作站直接添加到容器的 UI 中。"]
	quest.5411D7D6AD053E66.title: "合成升级配方：将物品放入合成台，即可升级配方。"
	quest.54A7C357AE0ADF65.title: "钻石背包"
	quest.54C81018CE13F6F1.quest_desc: ["用红石供电时会发出激光。可染色，黑色不可见"]
	quest.55768951471D44D8.quest_desc: [
		"**木制盔甲** (木材)：原始，但对投射物和爆炸有很好的抗性。"
		"**骨甲** (Bones)：轻便，提供额外机动性，受击时会用尖刺反击。"
	]
	quest.55768951471D44D8.title: "Tier 0: 原始与轻量级"
	quest.55AC6BFFB13267D9.quest_desc: ["施加红石能量即可转向。一侧向左转，另一侧向右转"]
	quest.55F7CB2455453231.quest_desc: ["当观察到激光笔的光线时，会输出红石信号"]
	quest.5640650E72BDAAEA.quest_desc: ["基础的**背包**提供便携存储和升级槽。后期制作更高等级背包时，所有物品和升级都会保留。"]
	quest.5640650E72BDAAEA.title: "基础背包 (The Basic Backpack)"
	quest.56EBCA0BA5637C8D.quest_desc: ["在主世界钻探中获得**原始下界合金废料**。该材料需要特殊的高温处理。"]
	quest.56EBCA0BA5637C8D.title: "收集残骸碎片"
	quest.57856383D9810957.quest_desc: ["像绳索滑轮一样，但有物理效果"]
	quest.57BDFFD832836310.quest_desc: [
		"使用此工具来定位石油矿床"
		""
		"区块也能用！试试 F3+G"
	]
	quest.57C889EC980D33D9.quest_desc: ["**农夫小屋**会自动在其边界内种植、照料和收割作物。它们需要一把锄头和种子/作物才能开始工作。"]
	quest.57C889EC980D33D9.title: "农夫小屋"
	quest.580771BE5663174D.quest_desc: ["把一切都烧个干净"]
	quest.583A7AA84FEC027F.quest_desc: [
		"**建造小屋**是最重要的建筑。雇佣一名建造者并放置蓝图，然后用所需材料填满建造者的箱子。"
		"建筑师会自动建造你放置的市政厅和其他建筑。"
	]
	quest.583A7AA84FEC027F.title: "建造建筑师小屋"
	quest.5890502EE26E95FB.quest_desc: ["**Crafting** 和 **Stonecutter** 升级将各自的合成台添加到背包UI中，使其完全便携。"]
	quest.5890502EE26E95FB.quest_subtitle: "便携式合成台。"
	quest.5890502EE26E95FB.title: "合成与石匠台"
	quest.58A16F3668D53950.quest_desc: ["**锻造螺栓**是工作台独有的材料，用于精细调整并定制工具的各项属性，以实现精准的性能。"]
	quest.58A16F3668D53950.title: "精密工具调校（螺栓）"
	quest.58F80E1BD05B026F.quest_desc: [
		"你可以拾起生物和箱子！"
		""
		"按住 SHIFT 并右键点击空手"
	]
	quest.593FC0DC7C3B85CC.quest_desc: ["**喂食升级**可以为存储方块周围一定范围内的玩家提供食物，并可选择性地为其疗伤。"]
	quest.593FC0DC7C3B85CC.title: "喂食升级组件"
	quest.5960CEAD282364D2.quest_desc: ["**锻造升级** 添加了便携式锻造台。**炼金升级** 添加了酿造台，非常适合随时随地制作药水。"]
	quest.5960CEAD282364D2.title: "锻造与炼金术升级模组"
	quest.59AA7879BD8A6AEB.quest_desc: ["烈焰人燃烧器可以喝岩浆"]
	quest.59DBB1D2EAEF1F34.quest_desc: ["睡上一整天，度过美好时光！"]
	quest.5A11A2FC20E5CE2A.quest_desc: ["**军营**是军事中心，让你可以训练、装备和管理守卫。建造它来完全掌控你的军队。"]
	quest.5A11A2FC20E5CE2A.title: "建造兵营 Barracks"
	quest.5A5068B2BA044F6D.quest_desc: ["**Restock** 升级会自动从背包中拉取物品，以补充用完的快捷栏物品。"]
	quest.5A5068B2BA044F6D.quest_subtitle: "始终将方块保持在你的手中。"
	quest.5A5068B2BA044F6D.title: "重新补给升级组件"
	quest.5ABFD8CA91AA15C8.quest_desc: ["包含模拟装置详细信息的可视化图表"]
	quest.5B05D32A01FABDC9.quest_desc: ["存储一个可随时间修改的模拟信号。"]
	quest.5B7ABBB515772407.quest_desc: ["螺旋桨运输物品。一种将物品向上移动的简单方法。"]
	quest.5BF638A250C7106E.title: "欢迎来到虚空矿井 (Welcome to the Void Mine)"
	quest.5C229CFEA7C5D2DD.quest_desc: ["**炼金术升级**允许直接在存储方块内用原料酿造药水，适合自动化药水生产。"]
	quest.5C229CFEA7C5D2DD.title: "炼金术升级模组"
	quest.5C6BCEE1C12D951A.quest_desc: ["反重力方块。保持飞船漂浮。不会增加高度"]
	quest.5E1D5B6D719FE708.quest_desc: ["**Pump Upgrade** 为容器添加了流体存储和传输功能。而 **XP Pump** 则负责处理经验值流体。"]
	quest.5E1D5B6D719FE708.title: "Pump 和 XP Pump"
	quest.5F1AD904545650BB.quest_desc: ["用磨石或压轮机把小麦碾碎吧！"]
	quest.5F5DB67F6A470C73.quest_desc: ["此里程碑追踪您的武装部队达到 **30** 名守卫时的情况，从而实现强大防御和潜在远征。"]
	quest.5F5DB67F6A470C73.title: "军事力量：30名守卫"
	quest.5F63D37E41C07B2E.quest_desc: ["像砧一样，但没有修理成本！"]
	quest.5F883CD530B2AE07.quest_desc: ["**Create: Ore Excavation Plus** 引入了多步骤处理。将原始钻石/绿宝石粉碎，然后**切割**或**清洗**原石以开始流程。"]
	quest.5F883CD530B2AE07.title: "处理链 (The Processing Chain)"
	quest.5FC01763770A062E.quest_desc: ["在将市政厅结构作为控制方块放置后，建造完成时此成就便会触发。这是一个重要的里程碑！"]
	quest.5FC01763770A062E.title: "市政厅已经建造完成"
	quest.6012A593D0FB81EC.quest_desc: ["**厨房小屋**是烹饪小屋的升级版，可以制作更复杂、更优质的餐食，从而提升村民的幸福度和健康值。"]
	quest.6012A593D0FB81EC.title: "高级食物：厨房小屋"
	quest.60777D98CE917817.quest_desc: ["**烹饪锅**对于制作高饱食度和有益效果的复杂菜肴，如炖菜和汤，至关重要。"]
	quest.60777D98CE917817.title: "基础酿造台（The Essential Pot）"
	quest.627AEB414599E31E.quest_desc: ["来思考我一下吧！"]
	quest.6289C9F19ED553A1.quest_desc: ["带视觉锥体的红石链接，只能看到前方的链接。"]
	quest.629658E9AB4D46F1.quest_desc: ["对称帆阻力更大，适合转向。用普通帆来获得升力"]
	quest.634B2E7FB2183363.quest_desc: ["**Tetra** 武器的能力超越了普通刀剑。锻造一把新剑，用更强的战斗力探索世界吧！"]
	quest.634B2E7FB2183363.title: "高级刀剑工艺模组"
	quest.638EB4E35F41405B.quest_desc: ["升级台是制作所有功能性升级的必要条件。这是**背包专用**版本（可通过**皮革**纹理区分）。"]
	quest.638EB4E35F41405B.quest_subtitle: "背包相关任务"
	quest.638EB4E35F41405B.title: "背包升级基础模块"
	quest.63FE80143DB276C3.quest_desc: ["丢弃流体物品"]
	quest.64407A1BC7A1761B.quest_desc: ["通过粉碎物品来获取经验值！比如矿石或生物。"]
	quest.64407A1BC7A1761B.quest_subtitle: "经验之旅的开始"
	quest.647F95EED59927B7.quest_desc: ["**Cook Hut** 将（农民、渔民等提供的）生食加工成可食用的、恢复健康的餐食，供市民享用。对人口增长至关重要。"]
	quest.647F95EED59927B7.title: "烹饪小屋"
	quest.653C032CF52802A0.quest_desc: ["**Chthonic Extractor** 是锤子的一种组件，可以升级其功能，特别是开启 **3x3 采矿区域** 的能力。"]
	quest.653C032CF52802A0.title: "提取性升级模组 The Extractive Upgrade"
	quest.65BE8DB8C5C357D5.quest_desc: ["在木头上也能正常工作！"]
	quest.65D23E7683812E26.quest_desc: ["居民不挑食。你把任何可食用物品放在储存箱里，他们都会吃掉，哪怕是**腐肉**！这在紧急情况下或自动化早期食物供应时很有用。"]
	quest.65D23E7683812E26.title: "村民们什么都吃！"
	quest.65EC649FCC1F3F4F.quest_desc: ["从FE POWER中获取应力单位"]
	quest.6615CE64DC0565EC.quest_desc: ["**Straw** 是用刀收割高草获得的，可用于制作 **Rope** 和装饰农场。"]
	quest.6615CE64DC0565EC.title: "一个简单的副产品"
	quest.667A91871415DF44.quest_desc: ["水平流体储罐"]
	quest.67E8B8DCFC93F832.quest_desc: ["**仓库** 对物流至关重要。它能储存所有生产的资源，并允许**快递员**将材料运送给建造者。你必须尽早建造它！"]
	quest.67E8B8DCFC93F832.title: "仓库：存储中心"
	quest.68500900087F92BC.quest_desc: ["**锯木厂**可以编程来制造殖民地所需的特定方块。此成就确认你已添加了门的配方，这是一种常见的建筑材料。"]
	quest.68500900087F92BC.title: "锯木厂生产：木门"
	quest.68BA5151F22C7CC5.quest_desc: ["制作这个高级腰带，可以方便地存放大量工具和物品，让它们在野外也易于取用。"]
	quest.68BA5151F22C7CC5.title: "增强型多功能腰带 (The Enhanced Utility Belt)"
	quest.68FC81E133443E76.quest_desc: ["**图书馆**是**学者**工作的地方，用于研究科技并提升所有工人的最大技能等级。对于高级殖民地的发展至关重要。"]
	quest.68FC81E133443E76.title: "高级研究：图书馆"
	quest.696BDC29ACCBBE29.quest_desc: ["**Undertaker Totem** 是墓地的一个强大后期升级，能提供更高效的复活和埋葬服务。"]
	quest.696BDC29ACCBBE29.title: "终局：Undertaker 图腾"
	quest.69EAF1072D492F1A.quest_desc: ["**Ancient Tome** 是一种稀有物品，可通过探索或偶尔交易获得。升级高级建筑时需要用到它。"]
	quest.69EAF1072D492F1A.title: "资源：远古卷轴 (Ancient Tome)"
	quest.69F9DB75244E6B3B.quest_desc: ["建筑魔杖！在空中按 CTRL+SHIFT+右键 打开菜单！"]
	quest.69F9DB75244E6B3B.title: "建筑魔杖！Construction Wands!"
	quest.6A46C70D8A7DBC04.quest_desc: ["里面没东西的话就没用了"]
	quest.6A60B76053393288.quest_desc: ["**熔炉小屋**将原矿石（如铁）冶炼成锭，供铁匠等其他生产线使用。"]
	quest.6A60B76053393288.title: "高级金属：熔炉小屋"
	quest.6A84CD0EE4833294.quest_desc: ["**Tetra** 允许修改盾牌，赋予它们更强的保护和新的攻击能力。试试在工作台定制一个盾牌吧！"]
	quest.6A84CD0EE4833294.title: "加固防御"
	quest.6B0CE8AD86991E28.quest_desc: ["**堆肥小屋**能将有机废料转化为**骨粉**，这对加快农场生长和其他相关生产建筑至关重要。"]
	quest.6B0CE8AD86991E28.title: "生产：堆肥小屋 (Composter Hut)"
	quest.6B26495A9E7D77FC.quest_desc: ["这是一个早期的人口目标！你需要至少 **5** 名公民才能开始执行基本工作，使殖民地自给自足。"]
	quest.6B26495A9E7D77FC.title: "人口里程碑：5名居民"
	quest.6B2D00B54B16464B.quest_desc: ["Storage 可以作为自动化处理站。Smelting、Smoking 和 Blasting 升级添加了熔炉三件套的便携版。"]
	quest.6B2D00B54B16464B.title: "熔炼与烟熏升级模组"
	quest.6B7759342D4AE496.quest_desc: ["**堆叠升级**能将背包中物品的最大堆叠数翻倍，让你能携带海量普通资源。**入门**级是绝佳的起点。"]
	quest.6B7759342D4AE496.quest_subtitle: "让你的物品堆叠数量翻倍！"
	quest.6B7759342D4AE496.title: "堆叠升级（入门至T4）"
	quest.6BB0C51EE8CA5966.quest_desc: ["**矿工小屋**会自动在深矿井中挖掘和收集资源（请设置边界）。矿工需要工具和火把才能安全工作。"]
	quest.6BB0C51EE8CA5966.title: "矿工小屋"
	quest.6CAD31E853C5AABD.quest_desc: ["**刀**是最基本的工具，用于采集、切割和准备食材。"]
	quest.6CAD31E853C5AABD.title: "厨师的精准度"
	quest.6CE7AC11D89F7998.quest_desc: ["再也没有到处都是的岩浆了"]
	quest.6D56AD1BEC644A10.quest_desc: ["**射箭**训练场能让守卫在远程战斗中得到训练，使他们能更高效地使用弓和弩进行防御塔作战。"]
	quest.6D56AD1BEC644A10.title: "军事：射箭训练场"
	quest.6DE2AA3A79F054DE.quest_desc: ["**虚空升级**会根据过滤器自动删除不需要的物品。而**高级版**可以指定特定槽位或物品进行销毁。"]
	quest.6DE2AA3A79F054DE.quest_subtitle: "移除垃圾战利品。"
	quest.6DE2AA3A79F054DE.title: "虚空升级模组"
	quest.6E47004B5BA60AAC.quest_desc: ["**虚空升级**会自动丢弃放置在存储方块中的物品，适用于溢出保护和垃圾清理。"]
	quest.6E47004B5BA60AAC.title: "虚空升级模组"
	quest.6E925E17FB4454E2.quest_desc: [
		"自动与村民进行交易！"
		""
		"注意：村民只在正常工作时间进行交易"
	]
	quest.6EA68A15ABAB2D7D.quest_desc: ["把你的烈焰人变成超级烈焰人，小心爆炸就好..."]
	quest.6EE28FF64778030F.quest_desc: ["收集各种宝箱中的所有**Tools of War Scrolls**，完成你的Warforge蓝图收藏！"]
	quest.6EE28FF64778030F.title: "完整的战争宝箱"
	quest.6EEA012FA11C7C08.quest_desc: ["你必须先占领殖民地要占用的土地。制作并使用**补给部署器**来放置临时补给箱并占领你的领地。小心怪物！"]
	quest.6EEA012FA11C7C08.title: "占领你的领地"
	quest.6EEDD37CBB070FCE.quest_desc: [
		"欢迎来到你的冒险之旅的起点！"
		"本整合包将 Create、Aeronautics 和 Minecolonies 融合成了一场统一的冒险。"
	]
	quest.6EEDD37CBB070FCE.title: "欢迎来到你的冒险之旅"
	quest.6F26C02744F415BE.quest_desc: ["收集各种宝箱中的所有**Tools of War Scrolls**，完成你的Warforge蓝图收藏！"]
	quest.6F26C02744F415BE.title: "完整的战争宝箱"
	quest.6F4069D2C20C472A.quest_desc: ["无人机初始化！"]
	quest.6FD5A1B2FC94F47A.quest_desc: ["OP 砂纸"]
	quest.70457BBE36DC7C91.quest_desc: ["将经验储存在储罐中后，你只需要一个泵和末端没有装置的管道，就能让经验球落回玩家手中，这样液体经验就会被抽下，球体也会发放出来供玩家拾取"]
	quest.70457BBE36DC7C91.quest_subtitle: "找回经验值（Getting back the xp）"
	quest.70457BBE36DC7C91.title: "向玩家发放经验值"
	quest.7068CA538D7F8D85.quest_desc: ["一个蛋巢，不过是倒着的"]
	quest.7078F6E8A179D88F.quest_desc: ["一个红石中继器，无需额外空间即可为按钮和杠杆添加无线红石！"]
	quest.70DC1CF6F284E511.quest_desc: ["通电时运行红石电路序列"]
	quest.714D87B91E1B61C6.quest_desc: ["通过采矿获取 Magnitite 矿物"]
	quest.71CAD1D9089778BC.quest_desc: ["合成**绳索**用途广泛，可用于装饰、建造或垂直移动物品。还可以合成**稻草块**用于存储/装饰。"]
	quest.71CAD1D9089778BC.title: "农场绳索工艺"
	quest.71D7D48518966ACD.quest_desc: [
		"使用 ponder 来帮助你制作 Pumpjack"
		""
		"（你可以从石头里抽石油）"
	]
	quest.71FCF06A98CC66D7.quest_desc: ["**Clipboard** 是一个实用工具，可以显示所选建造小屋中正在建造的建筑物及其当前所需的资源。"]
	quest.71FCF06A98CC66D7.title: "实用工具：剪贴板"
	quest.7207BECD0E0823BD.quest_desc: ["可盛放液体"]
	quest.721E56DA0C8D8E0B.quest_desc: ["用于模拟装置的机械轴承，可用红石信号使其松动"]
	quest.72B78E193A7D0D0E.quest_desc: ["竖井可以相互穿过彼此"]
	quest.72C749AD9F1C634E.quest_desc: ["招募到第一位公民后，**公民进阶**任务便会触发！通常在市政厅和住宅建筑建成后，该任务会自动触发。"]
	quest.72C749AD9F1C634E.title: "第一位公民已被招募"
	quest.73095092A407F1C5.quest_desc: ["卷轴在Tetra中至关重要，能解锁更高级的锻造选项、新模块和工具的独有能力。在地下堡垒中或在交易中寻找它们。"]
	quest.73095092A407F1C5.title: "解锁古代蓝图（Unlocking Ancient Schematics）"
	quest.730AE43A347E79B8.quest_desc: ["就像流体管道，不过是用于&4热量&r的管道"]
	quest.737A75B259638C31.quest_desc: ["**Insulated Plate** (Vent Plate) 是制作盾牌的绝佳材料，能大幅提升耐久度和韧性。"]
	quest.737A75B259638C31.title: "加固板状结构 Reinforced Platework"
	quest.73847BA3D73B8301.quest_desc: ["一台巨大的柴油发动机！"]
	quest.73B5FE87143963D3.quest_desc: ["使用&9LIGHTNING&r将经验转化为&6SUPER EXPERIANCE&r"]
	quest.743D7D9204915A13.quest_desc: ["当一名市民死亡时，会留下一座坟墓。另一位市民（守墓人）会前往坟墓哀悼并埋葬逝者。此成就在第一次下葬时触发。"]
	quest.743D7D9204915A13.title: "公民的葬礼"
	quest.74615FBE8C93952D.quest_desc: ["**熔炼升级** 会在背包中添加便携式熔炉。而**自动熔炼**等级可以自动消耗燃料并运行。"]
	quest.74615FBE8C93952D.quest_subtitle: "一个熔炉背在背上。"
	quest.74615FBE8C93952D.title: "熔炼与自动熔炼"
	quest.74C114D0C0D4D374.quest_desc: ["**医院**可以治愈生病或受伤的市民，防止死亡，并确保你的劳动力保持健康和高效。"]
	quest.74C114D0C0D4D374.title: "支援：医院"
	quest.74FE0EF7A62B7CF4.quest_desc: ["只有在输入速度高于阈值时才会连接的离合器"]
	quest.75165E16BE3CA30C.quest_desc: ["**喂食升级**会自动为你补充背包中的食物。而**高级**等级则能用消耗品为你恢复生命值。"]
	quest.75165E16BE3CA30C.quest_subtitle: "保持饥饿度处于满足状态。"
	quest.75165E16BE3CA30C.title: "喂食升级组件"
	quest.75599A9909C7A8C8.quest_desc: [
		"你的市民必须吃东西才能生存。在**市政厅**或**仓库**放置食物，尤其是面包、苹果或复杂的餐食，以供分发。"
		"此成就确认你的第一位公民已进食且心情愉悦。"
	]
	quest.75599A9909C7A8C8.title: "首次进食的餐食已被消耗"
	quest.75F673C50C17DFC6.quest_desc: ["将此连接到你的&2反应堆棒&r的另一端"]
	quest.7614FDF43E0AAD07.quest_desc: ["丢弃物品"]
	quest.76C8626BF50E7479.quest_desc: ["提供了一个可同时访问两个背包的接口！"]
	quest.775BB7E7E6C492A1.quest_desc: ["石油"]
	quest.77A2704F9551D0B5.quest_desc: ["**唱片盒升级** 让你能直接在背包里播放唱片。而**铁砧升级** 则提供了便携的修理和命名功能。"]
	quest.77A2704F9551D0B5.quest_subtitle: "娱乐与维护。"
	quest.77A2704F9551D0B5.title: "唱片机与铁砧的升级"
	quest.77C92B58EF226277.quest_desc: ["这些功能性盔甲种类丰富，是绝佳的收藏品。收集每种头盔各一个，装饰你的武器库吧！"]
	quest.77C92B58EF226277.title: "收藏家目标：所有头盔"
	quest.7870800C28A7E199.quest_desc: ["**养鸡小屋**负责管理鸡群，以获取鸡蛋、羽毛和鸡肉。"]
	quest.7870800C28A7E199.title: "牧羊人：小鸡牧羊小屋"
	quest.78A3A928F74E5A0A.quest_desc: ["这是一个用于整个键盘的联动控制器"]
	quest.78F716258C26AFC5.quest_desc: ["**Deposit** 升级（搭配 **Restock**）可让你快速将物品从背包倒入背包，加快采矿后的掉落速度。"]
	quest.78F716258C26AFC5.quest_subtitle: "快速倒出背包中的所有物品。"
	quest.78F716258C26AFC5.title: "存款升级组件"
	quest.799E18C17D0CACCF.title: "石匠台升级"
	quest.79A785FC05EF4F60.quest_desc: ["矿脉是按区块生成的，这意味着你可能得先移动一些方块才能挖矿！试试 F3+G 查看区块"]
	quest.7A068EFF6FB36B59.quest_desc: ["**神圣盔甲**是一套提供卓越保护的华丽装备。全套穿戴可获得独特能力：每分钟可完全抵消一次来袭攻击的伤害。"]
	quest.7A068EFF6FB36B59.title: "第4阶：神圣庇护"
	quest.7A130478B5F5D8E7.quest_desc: ["这个架子可以让你整齐地悬挂工具。将其放置在**工作台**旁边，就能方便地取用和锻造工具了。"]
	quest.7A130478B5F5D8E7.title: "便携式工具架"
	quest.7A1D999959471F11.quest_desc: ["一个封闭的齿轮轮，当用红石供电时，齿轮会减速，而传动轴会加速。"]
	quest.7A39A5B9E3CAC840.quest_desc: ["要从&6bottle o' enchanting&r中获取液体经验，你需要物品排水器，它在吸干经验后会返还瓶子给你"]
	quest.7A39A5B9E3CAC840.quest_subtitle: "偷走珍贵的经验值液体"
	quest.7B2EF52654BC3C22.quest_desc: ["**Refill** 升级会在你手持物品的存量低于设定值时，自动从背包中补充物品。"]
	quest.7B2EF52654BC3C22.quest_subtitle: "保持你当前物品栏的堆叠是满的。"
	quest.7B2EF52654BC3C22.title: "重新填充升级组件"
	quest.7B43A14AECC5C405.quest_desc: ["在剑上使用**Stonecutter**材料，可获得**横扫挖掘石头**等方块的特殊能力。"]
	quest.7B43A14AECC5C405.title: "石质雕刻刀刃"
	quest.7B5E2CD676A1A1C4.quest_desc: ["**Baker Hut** 是一种早期的食物处理器，能将小麦变成面包，是你不断增长的人口的好主食来源。"]
	quest.7B5E2CD676A1A1C4.title: "生产：烘焙小屋 (Baker Hut)"
	quest.7BB7CCADADDD0BA8.quest_desc: [
		"将你的锤子升级到第3级"
		"（你需要建造两个锤子来互相升级）"
	]
	quest.7BB7CCADADDD0BA8.title: "那是一个铁锤吗？"
	quest.7BE136ABD8DB4DAF.quest_desc: ["将旋转限制在可配置的角度内"]
	quest.7CEE50284584F2B3.quest_desc: ["在白天会被动地产生 &4热量&r"]
	quest.7D01E96D16F65302.quest_desc: ["你已经掌握了模组提供的每种独特盔甲套装的锻造方法。现在，将你最喜爱的部件组合起来，创造出兼具实用性与防御力的完美平衡！"]
	quest.7D01E96D16F65302.title: "最终组装"
	quest.7DCB91AD0050DDA9.quest_desc: ["将柴油转化为旋转能量！而且还有升级！"]
	quest.7E01576DB01D4C22.quest_desc: [
		"**长袍盔甲** (羊毛/烈焰人)：可染色、防火，击中攻击者时造成火焰伤害。非常适合早期探索下界。"
		"**史莱姆盔甲** (Slime): 提供高爆炸抗性，并使攻击者弹开。需要史莱姆球。"
	]
	quest.7E01576DB01D4C22.title: "第一阶：实用与元素防御"
	quest.7EB349B912AB9E1E.quest_desc: ["使用**金**升级的此**蜂蜜卷轴**，可增加工具的**魔法容量**，以实现更强大的强化。"]
	quest.7EB349B912AB9E1E.title: "猪灵的黄金洞见（磨砺）"
	quest.7EDFBC8BAEC5E525.quest_desc: ["用于制作所有类型的圆柱体"]
