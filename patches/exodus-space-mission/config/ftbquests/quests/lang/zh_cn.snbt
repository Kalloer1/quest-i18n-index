	quest.16F0C6A2E4495BEA.quest_subtitle: "&eDefeat 3 Alien Zombies on the Moon."
	quest.16F0C6A2E4495BEA.title: "&2&l月球任务：不死生物威胁"
	quest.1E09D59409A60C59.quest_desc: [
		"&f离开地球后的第一站是&f&l月球&f。"
		"&a准备好足够的燃料和氧气，让你的火箭能够生存下来&f。"
		"&b月球的重力较低，且有独特的资源，如&7Dash Ingots&b，这对高级技术至关重要。"
		"&d迈出在月球表面的第一步，开启真正的太空冒险！🌙🚀"
	]
	quest.1E09D59409A60C59.quest_subtitle: "&e发射你的火箭，登陆月球。"
	quest.1E09D59409A60C59.title: "&f&l前往月球旅行"
