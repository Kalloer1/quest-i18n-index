	quest.4BCBEC123BEB6227.quest_desc: [
		"&f在Pygro之中，存在着一个更强大、更可怕的敌人：&4Pygro Brute&f。"
		"&a这头野兽拥有更强的力量和耐久度，&f需要技巧和准备才能击败。"
		"&b只有最勇敢的探险家才能与之抗衡。"
		"&d击败 Pygro Brute，成为金星上的传奇！💥⚔️"
	]
	quest.4BCBEC123BEB6227.quest_subtitle: "&eDefeat 1 Pygro Brute on Venus."
	quest.4BCBEC123BEB6227.title: "&4&l金星任务：Pygro Brute 挑战"
	quest.4C03899BF95DCCBC.quest_desc: [
		"&f金星残酷的高温催生了致命的&6Moglers&f。"
		"&a比它们的汞族亲属更强，&f它们是严重的威胁。"
		"&b与它们战斗，证明你在这颗星球上的坚韧。"
		"&d消灭莫格勒，确保你的前路畅通！ 👹☄"
	]
	quest.4C03899BF95DCCBC.quest_subtitle: "&eDefeat 2 Moglers on Venus."
	quest.4C03899BF95DCCBC.title: "&6&l金星任务：莫格勒狩猎"
	quest.518D71CFF03E0A96.quest_desc: [
		"&f氧气分配器可以让你用氧气填充封闭的房间。"
		"&a将其放置于基地内并连接到氧气供应系统，&f即可在其他星球上创造安全的居住区。"
		"&b这台机器对于地球以外的长期殖民地至关重要。"
		"&d制作一个，为太空的虚空注入生命！"
	]
	quest.518D71CFF03E0A96.quest_subtitle: "&e建造氧气分配器，创造可呼吸的环境。"
	quest.518D71CFF03E0A96.title: "&3&l制作一个氧气分配器"
	quest.55AD5F4C1CDDCE35.quest_desc: [
		"&f一级充电宝能让你在发电机电量不足时储存额外的能量。"
		"&a将其连接到你的电力网络，&f以便在需要时为机器充电和供电。"
		"&b储存能量对于维持氧气和燃料系统的正常运行至关重要。"
		"&dCraft one to secure a stable power supply for your base!"
	]
	quest.55AD5F4C1CDDCE35.quest_subtitle: "&e建造一级充电宝，为机器储存能量。"
	quest.55AD5F4C1CDDCE35.title: "&9&l制作1级充电宝"
	quest.55F40DA5E87CBEF7.quest_desc: [
		"&f在火星地壳的深处，存在着强大的放射性资源——&5钚&f。"
		"&a小心挖掘——它是高级火箭升级和反应堆的必需品。&f"
		"&b收集钚元素，为星际旅行积蓄动力。"
		"&d红色星球的力量现在掌握在你手中！☢⛏"
	]
	quest.55F40DA5E87CBEF7.quest_subtitle: "&e从火星获取 x5 钚。"
	quest.55F40DA5E87CBEF7.title: "&5&l火星任务：钚矿工"
	quest.560AF08F81A2D904.quest_desc: [
