	quest.2B17A71A67B4BE5F.title: "&b&l制作一个水泵 (Water Pump)</c2></c1>"
	quest.3045C474847930EF.quest_desc: [
		"&f火星上的铁比地球上的更坚韧，是在外星条件下锻造的。"
		"&a开采它们来制作更强大的工具和机器，&f你的殖民地需要这些。"
		"&b火星铁将成为你在这个星球上技术的支柱。"
		"&d确保你的铁供应，加固你的火星基地！⛏🪐"
	]
	quest.3045C474847930EF.quest_subtitle: "&e收集 x10 火星铁。"
	quest.3045C474847930EF.title: "&7&l火星任务：铁供应"
	quest.3523A4FBB2BB999C.quest_desc: [
		"&f氧气罐是太空生存所必需的。"
		"&a用你的水分离器填充它，&f这样就能随身携带氧气了。"
		"&b无论是在月球、火星还是遥远星系探险，氧气瓶都能让你在无空气的地方生存下来。"
		"&dCraft one and prepare for your first steps beyond the Overworld!"
