	quest.5960A0A84D0D98B2.quest_desc: [
		"&f一旦离开主世界的庇护，氧气就至关重要了。"
		"&a使用你的水分离器来生产氧气，&f并将其转移到储罐中。"
		"&b装满的氧气罐能让你在没有呼吸空气的行星和卫星上存活。"
		"&d做好准备——没有氧气，太空会要你命！"
		""
		""
		"{image:kubejs:block/metiendo_tanque_oxigeno_water_separator width:100 height:100 align:center}"
	]
	quest.5960A0A84D0D98B2.quest_subtitle: "&e填充氧气罐，为太空生存做好准备。"
	quest.5960A0A84D0D98B2.title: "&b&l填充氧气罐"
	quest.59B708FFC4F036F5.quest_desc: [
		"&f用从金星开采的稀有&5Neptunium Pieces&f，你现在可以将其锻造成强大的锭。"
		"&aSmelt the pieces in a furnace or blast furnace &fto refine them into a single Neptunium Ingot."
		"&b这种材料是升级高级机器、盔甲和火箭的关键。"
		"&dCraft your first Neptunium Ingot and unlock the true power of Venus! ☢️⚒️"
	]
	quest.59B708FFC4F036F5.quest_subtitle: "&eCraft Neptunium Pieces into a Neptunium Ingot."
	quest.59B708FFC4F036F5.title: "&5&l金星任务：制作海王星锭"
	quest.5AAFDED22803AE85.quest_desc: [
		"&f&9Stellaris 石板&f是你的终极模组指南。"
		"&a它像一本手册，存储了你所需的所有知识，&f关于机器、火箭、行星和太空生存的知识。"
		"&bCrafting this item will give you constant access to tips and recipes wherever you go."
		"&dMake the Stellaris Tablet and keep the stars at your fingertips! 📱🌌"
		""
		"{image:kubejs:block/usando_tablet width:100 height:100 align:center}"
	]
	quest.5AAFDED22803AE85.quest_subtitle: "&e创建平板电脑以访问 Stellaris 模组指南。"
	quest.5AAFDED22803AE85.title: "&9&l制作星象仪石板"
	quest.5B99D103BD8A2507.quest_desc: [
		"&f要进入太空，你必须搭建一个 &a3x3 火箭发射台&f。"
		"&a将火箭放置其上，用精炼油为其加油，&f然后准备点火。"
		"&b倒计时即将开始——归零后，你将离开地球。"
		"&d准备好起飞，迈向宇宙的第一步！🌌"
		""
		"{image:kubejs:textures/imagenestellaris/launch_pad_suelo.png width:100 height:100 align:center}"
	]
	quest.5B99D103BD8A2507.quest_subtitle: "&e放置火箭发射台，并为火箭做好发射准备。"
	quest.5B99D103BD8A2507.title: "&6&l设置火箭发射台"
	quest.606B6908DB5C67C3.quest_desc: [
		"&f火星的表面由可怕的&4火星迅猛龙&f巡逻着。"
		"&a这些掠食者比地球上任何东西都更快、更致命。&f"
		"&b击败它们，证明你在红色星球上的生存技巧。"
		"&d直面火星迅猛龙，将火星据为己有！🦖🔥"
	]
	quest.606B6908DB5C67C3.quest_subtitle: "&eDefeat 2 Martian Raptors on Mars."
	quest.606B6908DB5C67C3.title: "&4&l火星任务：迅猛龙狩猎"
	quest.61E4661095098FC0.quest_desc: [
		"&f石油是制造火箭燃料所需的原始资源。"
		"&a用抽油机从地下矿床中提取石油，&f然后用桶收集起来。"
		"&b这是提炼火箭发射所需燃料的第一步。"
		"&d获取一个油桶，离开启太空之旅更近一步！"
	]
	quest.61E4661095098FC0.quest_subtitle: "&e获取1桶油用于燃料生产。"
	quest.61E4661095098FC0.title: "&6&l收集一个油桶"
	quest.637C95233A2AF9E2.quest_desc: [
		"&f重金属是通过熔炼&7铁锭&f制成的，也是你在Stellaris中最早需要的一种资源。"
		"&a用它来制作基础机器、工具和零件，为你学习高级太空技术做好准备。"
		"&d收集至少十个锭，迈出你迈向星辰的第一步！"
		""
		"{image:kubejs:block/quemando_iron_heavy_metal width:100 height:100 align:center}"
	]
	quest.637C95233A2AF9E2.quest_subtitle: "&e收集 x10 重金属锭，开始制作必要组件。"
	quest.637C95233A2AF9E2.title: "&8&l收集重金属锭"
	quest.6448E508EA3CF34E.quest_desc: [
		"&f太空盔甲是你在群星间的生命线。"
		"&a制作头盔、胸甲、护腿和靴子，&f以便在探索危险世界时保护自己并携带氧气。"
		"&b装备这套盔甲后，你就能在太空中呼吸，并抵御危险环境了。"
		"&d做好准备，探险家——你的宇宙之旅现在开始！"
		""
		"{image:kubejs:textures/imagenestellaris/armadura_espacial.png width:150 height:150 align:center}"
	]
	quest.6448E508EA3CF34E.quest_subtitle: "&e制作完整的太空盔甲套装，用于地球之外的生存。"
	quest.6448E508EA3CF34E.title: "&f&l制作太空盔甲"
	quest.6542D40B8D2AB367.quest_desc: [
		"&f你的下一个伟大目的地是&c红色星球&f——火星。"
		"&aPrepare with enough fuel, oxygen, and a sturdy space suit &fto survive its harsh and fiery surface."
		"&bOn Mars, you’ll encounter new resources, dangerous terrain, and hostile alien life."
		"&d踏上火星，继续你的星际之旅！🪐🔥"
	]
	quest.6542D40B8D2AB367.quest_subtitle: "&e发射你的火箭，登陆火星。"
	quest.6542D40B8D2AB367.title: "&c&l前往火星旅行"
	quest.6651E03FFED23AC8.quest_subtitle: "&e发射你的火箭，登陆水星。"
	quest.6651E03FFED23AC8.title: "&e&l前往水星旅行"
	quest.6657B2892F72C3EE.quest_desc: [
		"&f钢铁是你星际之旅的基石。"
		"&a挖掘&8钢矿石&a或冶炼&7重铁&a成钢锭。"
		"&bWith steel, you’ll be able to craft machines, pipes, cables, and even your very first rocket parts."
		"&d收集至少十个锭，才能继续向太空探索迈进！"
		""
		"{image:kubejs:block/minando_steel_ore width:100 height:100 align:center}"
	]
	quest.6657B2892F72C3EE.quest_subtitle: "&e收集10个钢锭，解锁Stellaris科技的第一步。"
	quest.6657B2892F72C3EE.title: "&8&l收集钢锭"
	quest.68DBCC34C70AEF1A.quest_desc: [
		"&f石油是生产火箭燃料的关键原料。"
		"&a有了石油探测器，你就可以扫描土地，&f探测出你世界中隐藏的石油储备。"
		"&b用它来在建造抽油机和炼油厂装置前，找到一个合适的地点。"
		"&dCraft the Oil Finder and take the first step toward fueling your journey to the stars!"
		""
		""
		"{image:kubejs:textures/imagenestellaris/oil_finder.png width:100 height:100 align:center}"
		"{image:kubejs:block/recolectando_petroleo width:100 height:100 align:center}"
	]
	quest.68DBCC34C70AEF1A.quest_subtitle: "&e制作一个石油探测器来定位地下石油矿床。"
	quest.68DBCC34C70AEF1A.title: "&6&l制作一个石油探测器"
	quest.6B802D9F4E0A8A73.quest_desc: [
		"&f当心&5星行者&f，潜伏在月球陨石坑中的危险生物。"
		"&b将它们全部消灭，以保护你的任务并统治月球。"
		"&d直面星爬者，证明你的勇气！✨🐛"
	]
	quest.6B802D9F4E0A8A73.quest_subtitle: "&eDefeat 2 Star Crawlers on the Moon."
	quest.6B802D9F4E0A8A73.title: "&5&l月球任务：星象爬虫狩猎"
	quest.6C4B5F02B8A6AFD0.quest_desc: [
		"&f燃料提炼厂是将原始&a石油&f转化为&6火箭燃料&f的关键设施。"
		"&a将其放置在油存储箱旁边或用管道连接&f以输送石油。"
		"&bMake sure the refinery is powered, and it will process the oil into fuel you can store in buckets or tanks."
		"&dCraft a Fuel Refinery and take the final step toward launching your first rocket!"
		""
		"{image:kubejs:textures/imagenestellaris/interfaz_fuel_refinery.png width:100 height:100 align:center}"
	]
	quest.6C4B5F02B8A6AFD0.quest_subtitle: "&e建造燃料精炼厂，将石油转化为可用的火箭燃料。"
	quest.6C4B5F02B8A6AFD0.title: "&c&l制作一个燃料精炼器"
	quest.7228C1E21A645EE9.quest_desc: [
		"&f金星上栖息着好战的&cPygros&f，这是一种会毫不犹豫地发起攻击的凶猛生物。"
		"&a将它们猎杀殆尽，&f以确保你的探索区安全。"
		"&b它们的存在标志着生存金星的第一项挑战。"
		"&d击败 Pygros，展示你的力量！⚔️🔥"
	]
	quest.7228C1E21A645EE9.quest_subtitle: "&eDefeat 3 Pygros on Venus."
	quest.7228C1E21A645EE9.title: "&c&l金星任务：Pygro 狩猎"
	quest.72E4DF206C33D50D.quest_desc: [
		"&f火箭站是建造第一枚火箭的核心建筑。"
		"&aCraft it and prepare the necessary materials for assembly."
		"&b本车站将指导你完成鳍、鼻锥、引擎和钢块的合成。"
		"&d从这里开始——通往星辰的道路始于火箭站！"
		""
		"{image:kubejs:textures/imagenestellaris/interfaz_rocket_station.png width:100 height:100 align:center}"
	]
	quest.72E4DF206C33D50D.quest_subtitle: "&e建造火箭空间站来组装你的航天器。"
	quest.72E4DF206C33D50D.title: "&b&l制作一个火箭空间站"
	quest.776DACB7E66AAE5A.quest_desc: [
		"&f没有&6火箭燃料&f，你的火箭无法起飞。"
		"&a使用炼油厂里的燃料桶，&f将其倒入火箭的燃料箱中。"
		"&b请务必将其完全装满——飞行途中耗尽燃料会让你迷失在群星之间。"
		"&d给火箭加满燃料，准备起飞！🚀"
		""
		"{image:kubejs:block/metiendo_cubo_vacio_fuel_refinery width:100 height:100 align:center}"
	]
	quest.776DACB7E66AAE5A.quest_subtitle: "&e为火箭加注燃料，准备发射。"
	quest.776DACB7E66AAE5A.title: "&6&l为火箭加油"
	quest.7789262E351217E5.quest_desc: [
		"&fDeep within Mercury’s crust lies &2Uranium&f, a powerful radioactive resource."
		"&a小心挖掘——这对高级能源系统和火箭升级至关重要。&f"
		"&b利用铀的能量，将你的科技推向更高峰。"
		"&d提取铀，夺取水银的隐藏力量！☢️⛏️"
	]
	quest.7789262E351217E5.quest_subtitle: "&eMine x5 Uranium on Mercury."
	quest.7789262E351217E5.title: "&2&l水星任务：铀提取"
	task.0B608346A977376A.title: "欢迎来到Stellaris"
	task.0DB34351A550119D.title: "&c&l发射火箭"
	task.4A5CE35F7928EFE4.title: "&e&l前往水星旅行"
	task.602A50E05B81072D.title: "&c&l前往火星旅行"
	task.6DF60BF83B936397.title: "&e找到火星钻石矿石。"
}
