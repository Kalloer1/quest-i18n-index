	quest.58F63AEBB7F5241A.quest_desc: [
		"&f水分离器是Stellaris中的一个关键机器。"
		"&a它将水分解成&b氧气和&a&c氢气，&f两者都是你旅途的必需品。"
		"&b氧气能让你在太空中生存，而氢气则能驱动先进的火箭和升级部件。"
		"&dCraft your first Water Separator and prepare for true space survival!"
		""
		"{image:kubejs:textures/imagenestellaris/interfaz_water_separator.png width:100 height:100 align:center}"
	]
