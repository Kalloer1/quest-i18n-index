	quest.16870D3095D49307.quest_subtitle: "&e找到金星钻石。"
	quest.16870D3095D49307.title: "&b&l金星任务：钻石发现之旅"
	quest.16F0C6A2E4495BEA.quest_desc: [
		"&fIn the darkness of the Moon roam &2Alien Zombies&f."
