	quests: [
		{
			description: [
				"Botania 是一款伪装成花儿的科技模组。另外，我实在懒得做这一章了，求求谁来替我做了吧。"
				""
				"阅读《Lexica》。任务会给出路线，但这本书记载着阻止神秘植物机变成神秘汤的方法。"
				""
				"大部分进度都靠法力。像个负责任的成年人一样把花园武器化，我个人就只种番茄。番茄？西红柿？都叫番茄。"
			]
			icon: "botania:lexicon"
			id: "4B2DF62D16ECDCEF"
			rewards: [{
				id: "3EE538A4B0FCF430"
				type: "xp"
				xp: 100
			}]
			shape: "gear"
			size: 1.5d
