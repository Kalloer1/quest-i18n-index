	file.0000000000000001.title: "Farbound"
	quest.004BEB8C8E5DB522.quest_desc: [
		"池塘和农场里充满了新品种的鸟类：水中有鸭、鹅和天鹅，院子里有火鸡、公鸡和珍珠鸡。其中几种会下蛋，适合烹饪。"
		""
		"找到一只鸭子、一只鹅和一只火鸡。"
	]
	quest.004BEB8C8E5DB522.quest_subtitle: "聚集在一起，像鸟群一样。"
	quest.004BEB8C8E5DB522.title: "物以类聚，人以群分"
	quest.0092F1BBD7126718.quest_desc: ["天花板上串着仙女灯，架子上放着水晶灯。瞬间充满魔力。"]
	quest.0092F1BBD7126718.quest_subtitle: "小星星。"
	quest.0092F1BBD7126718.title: "一闪一闪亮晶晶"
	quest.00ADB42DD7DABB50.quest_desc: ["水车能将流动的水转化为稳定的、免费的旋转。你的第一个真正发电机。建在河流附近，让它运转起来。"]
	quest.00ADB42DD7DABB50.subtitle: "免费电力，永无止境。"
	quest.00ADB42DD7DABB50.title: "车轮"
	quest.00C94663863AE972.quest_desc: ["每种木材都有木筏，有随波逐流的木箱，还有标记回家航道的浮标。小船适合小水域，让你夜间也能找到归途。"]
	quest.00C94663863AE972.quest_subtitle: "每种木材的浮力都各不相同。"
	quest.00C94663863AE972.title: "扬起风帆启航"
	quest.0129C7F42070410E.quest_desc: ["土豆大炮用背囊里的空气发射食物和其他物品。不同弹药，不同效果。胡萝卜快，南瓜威力大。"]
	quest.0129C7F42070410E.quest_subtitle: "土豆导弹已发射。"
	quest.0129C7F42070410E.title: "沙发土豆（Couch Potato）"
	quest.0168B345F852CF33.quest_desc: [
		"熔炉可以冶炼矿石、烹饪食物，还能把原木变成木炭。木炭加木棍能制作火把，火把能让夜晚保持文明。"
		""
		"建造一个，烹饪一些东西，点亮你的第一个房间。怪物们会心领神会的。"
	]
	quest.0168B345F852CF33.quest_subtitle: "有些人喜欢热的东西。"
	quest.0168B345F852CF33.title: "熊熊燃烧"
	quest.01C546B776D28862.quest_desc: [
		"原矿石放入磨石后会产出粉碎矿石，通常还会附带一点额外奖励。粉碎矿石和原矿石一样可以熔炼成锭，但它还能被洗出额外的金块，而这才是利润所在。"
		""
		"稍后，一对 Crushing Wheels 会完成得更快。现在，磨石将开启你的第一条矿石翻倍生产线。"
	]
	quest.01C546B776D28862.quest_subtitle: "矿石放进去，更多矿石就出来了。"
	quest.01C546B776D28862.title: "成功粉碎了它"
	quest.0230C35DC35C67F5.quest_desc: ["还有那无人款待客人的架子。一个会爆炸，一个会吓坏邻居，一个以某人的猫命名，尝起来像被关爱。一个能从草丛中掏出战利品，一个像太阳一样闪耀，还有一个像盔甲一样守护你。收集全部六个，别再提问了。"]
	quest.0230C35DC35C67F5.quest_subtitle: "饮用有风险，后果自负。"
	quest.0230C35DC35C67F5.title: "奇怪的架子"
	quest.025AB46ED7410B62.quest_desc: ["加权弹出器可将物品或玩家投掷至目标方块。右键设置目标，看着你的包裹飞越房间。"]
	quest.025AB46ED7410B62.quest_subtitle: "加权，校准，发射。"
	quest.025AB46ED7410B62.title: "把下面这段 Minecraft 整合包的任务书文本翻译成简体中文。"
	quest.02B2FEC58FA069F8.subtitle: "被翡翠所束缚。"
	quest.02C914A7F021D9F9.quest_desc: ["你了解茶叶，也找到了最喜欢的杯子。现在来揭示藏在茶里的秘密：将干黑茶、绿茶和乌龙茶混合成一杯。"]
	quest.02C914A7F021D9F9.quest_subtitle: "配方中的配方。"
	quest.02C914A7F021D9F9.title: "秘密配方大比拼"
	quest.02CEE5FF2AA2923A.quest_desc: ["举办茶会：茶、咖啡、蛋糕和朋友们围坐一桌。温馨才是重点。"]
	quest.02CEE5FF2AA2923A.quest_subtitle: "送给你！"
	quest.02CEE5FF2AA2923A.title: "非常愉快的非生日派对"
	quest.02DE0F7243914547.quest_desc: ["Sequenced Pulse Generator 可输出可编程的红石脉冲模式，而 Linked Transmitter 可无线发送模拟红石信号。任何自动化系统的完美搭档。"]
	quest.02DE0F7243914547.quest_subtitle: "保持节奏感。"
	quest.02DE0F7243914547.title: "节奏部分"
	quest.02FFC5C6DF759045.quest_desc: ["相框让你的照片上墙，玻璃款让它们闪闪发光，堆叠的照片像记忆牌一样在桌上流转。每个基地都该有一座画廊。"]
	quest.02FFC5C6DF759045.quest_subtitle: "结束这段旅程吧。"
	quest.02FFC5C6DF759045.title: "画廊墙壁"
	quest.036F30AFC3DE0398.quest_desc: ["相册将你的照片装订成册，可供翻阅、签名和赠送。一段旅程，一次装订。尽早填满它，未来的你会感谢你。"]
	quest.036F30AFC3DE0398.quest_subtitle: "一页页书写的人生篇章。"
	quest.036F30AFC3DE0398.title: "家庭相册"
	quest.03781276E45F5E59.quest_desc: ["砧板和刀具可用来准备食材，并将物品分解成部分。"]
	quest.03781276E45F5E59.title: "刀"
	quest.038CC7F0FC5A188C.quest_desc: ["你有了旋转、加工、装置和流体。这就是整个 Create 的基础。下一站：黄铜、精密和会思考的机器。"]
	quest.038CC7F0FC5A188C.quest_subtitle: "第一阶段已完成。"
	quest.038CC7F0FC5A188C.title: "安山岩的时代"
	quest.03BD53D549F95309.quest_desc: ["铜制酿造站酿造得更好、更快。适合不断发展的酿酒坊的升级。"]
	quest.03BD53D549F95309.quest_subtitle: "下一个酿造等级。"
	quest.03BD53D549F95309.title: "更进一步"
	quest.03BDA9B1D0296611.quest_desc: [
		"木头是任何幸存者的第一笔财富。原木变木板，木板变木棍，木棍则能制成你接下来一小时会用到的所有工具。"
		""
		"趁着天还亮，拿一叠吧。Farbound 的树砍树干时会倒下，所以站到旁边，让重力来收尾。"
	]
	quest.03BDA9B1D0296611.quest_subtitle: "每个起源故事都始于对一棵树的暴力。"
	quest.03BDA9B1D0296611.subtitle: "所有载具最初都是由木头制成的。"
	quest.03BDA9B1D0296611.title: "打树也是一种可行的职业选择"
	quest.03D53221F587C75C.quest_desc: ["齿轮能将旋转传递到角落并改变速度。搭配大小齿轮来加速或减速。"]
	quest.03D53221F587C75C.subtitle: "速度就是一切。"
	quest.03D53221F587C75C.title: "齿轮组件"
	quest.03F1BF7FFF6F5269.quest_desc: ["大麦麦芽是大多数啤酒的开端。这款也不例外。"]
	quest.03F1BF7FFF6F5269.quest_subtitle: "这是整个整合包的核心所在。"
	quest.03F1BF7FFF6F5269.title: "大麦"
	quest.03FDAAFB0050D03F.quest_desc: ["库存线缆将网络延伸至房间各处，线缆连接器可将远处的箱子接入网络。框架线缆可隐藏在墙壁内，而油漆工具包则能让它们与你的建筑风格相匹配。库存饰条能让储物墙看起来整洁，同时仍是网络的一部分。"]
	quest.03FDAAFB0050D03F.quest_subtitle: "电缆已连接。"
	quest.03FDAAFB0050D03F.title: "有线电视安装工"
	quest.04397FDA20A76907.quest_desc: ["由不安分的紫色果实雕刻而成，它会以它自己的方式移动你。"]
	quest.04397FDA20A76907.quest_subtitle: "你不得静止不动地站立。"
	quest.04397FDA20A76907.title: "紫色法杖"
	quest.0496B96BB41EBD85.quest_desc: ["下界岩里到处都是下界石英矿石。多挖点：它能做比较器、侦测器、Create的玫瑰石英和漂亮的白色方块。"]
	quest.0496B96BB41EBD85.quest_subtitle: "闪闪发光，洁白无瑕。"
	quest.0496B96BB41EBD85.title: "石英狂潮"
	quest.04B1054D060FF59F.quest_desc: ["女巫会投掷药水，也会喝自己的药水来治疗。保持距离，避免溅射范围，然后重击。"]
	quest.04B1054D060FF59F.quest_subtitle: "火焰燃烧，炼药锅冒泡。"
	quest.04B1054D060FF59F.title: "双倍，双倍，辛劳与麻烦"
	quest.051203A2623BF202.quest_desc: ["穿上至少一件金盔甲，猪灵就会放过你。用金锭和它们交换珍珠、药水和其他宝藏。"]
	quest.051203A2623BF202.quest_subtitle: "猪灵们很喜欢这个。"
	quest.051203A2623BF202.title: "闪闪发光"
	quest.051C274D038ABF1B.quest_desc: ["水獭在河流中游泳，仰面漂浮，小熊猫在竹林里打盹。看到它们，很难不露出笑容。"]
	quest.051C274D038ABF1B.quest_subtitle: "在他们睡觉的时候手牵手。"
	quest.051C274D038ABF1B.title: "重要的水獭 (Significant Otter)"
	quest.053F135FD5CEE11D.quest_desc: ["显示屏链接器可从机器、仪表和物品栏读取数据，并将其打印到显示屏或尼可夫管上。物品数量、速度、列车时刻：尽数显示。"]
	quest.053F135FD5CEE11D.quest_subtitle: "当前显示：你的工厂。"
	quest.053F135FD5CEE11D.title: "信息高速公路"
	quest.055D577C269C76E3.quest_desc: ["蜘蛛会爬墙，只在夜间发怒。它们的线可以制作弓和鱼竿。洞穴蜘蛛更小、更快，且有剧毒。"]
	quest.055D577C269C76E3.quest_subtitle: "爬上了喷泉的水柱。"
	quest.055D577C269C76E3.title: "小不点蜘蛛 (Itsy Bitsy Spider)"
	quest.0587F219C015DB2A.quest_desc: ["在海洋中，海兔附着在岩石上，大耳章鱼在深海游弋。蛤蜊藏着能做成漂亮项链的珍珠。"]
	quest.0587F219C015DB2A.quest_subtitle: "微小的海洋奇观。"
	quest.0587F219C015DB2A.title: "Something Fishy"
	quest.059A2FB88A438A84.quest_desc: ["猪灵肉排、猪灵香肠和猪灵肉丸能喂饱一大群人。史特莱德肉能做史特莱德面包和炖菜。烹饪一道下界美食。"]
	quest.059A2FB88A438A84.quest_subtitle: "烤架上的猪布林。"
	quest.059A2FB88A438A84.title: "猪肉排快线"
	quest.05A2D9AC85E4BF27.quest_desc: ["有些威士忌背后有故事。AK 则无需多言。"]
	quest.05A2D9AC85E4BF27.quest_subtitle: "可靠。不玩虚的。"
	quest.05A2D9AC85E4BF27.title: "AK"
	quest.05B7E30C46652911.quest_desc: ["葡萄不会在泥土中蔓延。放置一个两格高的葡萄藤茎，然后将种子点击到上半部分。丛林藤蔓则不同：它们需要墙上的棚架。两者都立起来，葡萄园才算真正建成。"]
	quest.05B7E30C46652911.quest_subtitle: "藤蔓需要某种东西来支撑自己。"
	quest.05B7E30C46652911.title: "Trellis and Lattice"
	quest.05DF0D0362255DF8.quest_desc: ["琥珀矿石藏在琥珀之地。琥珀宝石既漂亮又实用。去挖几个吧。"]
	quest.05DF0D0362255DF8.quest_subtitle: "未包含蚊子（Mosquito）模组。"
	quest.05DF0D0362255DF8.title: "侏罗纪琥珀"
	quest.05EDC2237E6F0538.quest_desc: ["采集鹅卵石，升级到石制工具。更坚固，速度更快。"]
	quest.05EDC2237E6F0538.subtitle: "更坚固，速度更快。"
	quest.05EDC2237E6F0538.title: "石头"
	quest.060F81859BBC4A08.quest_desc: [
		"每个草地下都有石头，而石头是最耐用的材料。先挖一堆鹅卵石，然后直接升级到石制工具。"
		""
		"石镐可以开采铁矿石。这一句话就是你人生的下一章。"
	]
	quest.060F81859BBC4A08.quest_subtitle: "我是不是听到了岩石和石头的声音？"
	quest.060F81859BBC4A08.title: "岩石与石头！"
	quest.0647E42C8299A7E2.quest_desc: [
		"附魔台能将经验转化为力量。在 Farbound 中，关闭附魔台时会保留你的青金石和物品，如果不喜欢提供的附魔，还可以重新掷骰。"
		""
		"建造一个，然后给任何东西附魔。第一个闪光点就是最好的。"
	]
	quest.0647E42C8299A7E2.quest_subtitle: "任何足够先进的科技都与魔法无异。"
	quest.0647E42C8299A7E2.subtitle: "知识本身拥有力量。"
	quest.0647E42C8299A7E2.title: "阿布拉卡达布拉"
	quest.06802EF6385B36C7.quest_desc: ["吸收火焰和熔岩的伤害，直到充能完全耗尽。"]
	quest.06802EF6385B36C7.quest_subtitle: "火焰附魔，吸收，重复。"
	quest.06802EF6385B36C7.title: "防火（Fireproof）"
	quest.072FB73FDF1E4354.quest_desc: ["小麦啤酒是地窖里最简单的东西。颜色淡而浑浊，比看上去更好喝。"]
	quest.072FB73FDF1E4354.quest_subtitle: "多云，柔软，真诚。"
	quest.072FB73FDF1E4354.title: "小麦"
	quest.075A56C751B2E717.quest_desc: ["炉子能让你开始，但大多数茶需要更多热量。将烈焰粉放入槽中，进一步加热水壶。"]
	quest.075A56C751B2E717.quest_subtitle: "热量越多，茶越好喝。"
	quest.075A56C751B2E717.title: "一杯更热的饮品"
	quest.078EAEF55ED34918.quest_desc: ["将谷物在筒仓中晾干，直到可以酿造。干燥的小麦、大麦、玉米和燕麦，是每一批酿造的基石。"]
	quest.078EAEF55ED34918.quest_subtitle: "倒酒之前，先要有耐心。"
	quest.078EAEF55ED34918.title: "烘干谷物"
	quest.07A7089FF12BF412.quest_desc: ["蓝色黑曜石和蓝色哭泣的黑曜石、黑曜石玻璃和哭泣的黑曜石：用于特殊建筑的稀有下界石头。"]
	quest.07A7089FF12BF412.quest_subtitle: "马格南。"
	quest.07A7089FF12BF412.title: "蓝色钢铁"
	quest.0807DFCBD7519F94.quest_desc: [
		"猪爱吃胡萝卜、土豆和甜菜根，它们能做美味的培根，或者用马鞍和胡萝卜钓竿驯成糟糕的马。"
		""
		"找到一只猪，直视它的眼睛。"
	]
	quest.0807DFCBD7519F94.quest_subtitle: "夏洛特把它写在了一个蛛网上。"
	quest.0807DFCBD7519F94.title: "某个猪人"
	quest.08433CBB1808BC97.quest_desc: ["在荒野深处，有一座被城墙环绕的城市：桥梁、塔楼、街道，都由曾视其为家的人们所建。找到它，漫步其中，探寻是什么让他们选择留下。"]
	quest.08433CBB1808BC97.quest_subtitle: "曾经有人住在这里。而且是有意为之。"
	quest.08433CBB1808BC97.title: "被遗忘的城市"
	quest.08ED1C5C2EFF06D7.quest_desc: ["盆上方的机械搅拌机可将原料组合成合金、食物和化合物。"]
	quest.08ED1C5C2EFF06D7.subtitle: "进步背后的化学反应。"
	quest.08ED1C5C2EFF06D7.title: "搅拌机"
	quest.08F6C2A3833D3E58.quest_desc: ["荨麻在冲泡中失去了刺痛感。剩下的则是辛辣、清新又出人意料。"]
	quest.08F6C2A3833D3E58.quest_subtitle: "针头扎进去，却拔不出来。"
	quest.08F6C2A3833D3E58.title: "荨麻（Nettle）"
	quest.09017C0072FBF9E3.quest_desc: ["在合适的人群面前，一个笑容价值千金。"]
	quest.09017C0072FBF9E3.quest_subtitle: "说“奶酪”。然后再说“黄金”。"
	quest.09017C0072FBF9E3.title: "牙齿所在之处，黄金显现"
	quest.092278C3CEF0B1D5.quest_desc: ["探险家指南针对结构也适用。快速追踪地牢或村庄。"]
	quest.092278C3CEF0B1D5.subtitle: "知道自己要去哪里很重要。"
	quest.092278C3CEF0B1D5.title: "搜寻者"
	quest.092F6C02269B0791.quest_desc: [
		"修补通常用经验球修复你的装备。而在这里，你可以通过潜行并右键手持的修补物品，将储存的经验直接注入其中。"
		""
		"找到一本修补书（图书管理员、钓鱼和宝箱是你的好帮手），并将其附魔到你最喜欢的工具上。尝试成功后，勾选此项。"
	]
	quest.092F6C02269B0791.quest_subtitle: "修复、重用、欢庆。"
	quest.092F6C02269B0791.title: "比新还新模组整合包任务书"
	quest.093020F70DBD4F4A.quest_desc: ["守卫者用激光束保卫海洋神殿，而三个远古守卫者则会用挖掘疲劳诅咒入侵者。击败远古守卫者即可占领神殿。"]
	quest.093020F70DBD4F4A.quest_subtitle: "激光眼，愤怒的鱼。"
	quest.093020F70DBD4F4A.title: "毁灭神庙"
	quest.0968935C52B69977.quest_desc: ["装满谷物的完整南瓜。装满其他东西的完整猪灵。不是补给，是一场事件。"]
	quest.0968935C52B69977.quest_subtitle: "有些餐食是特殊场合的庆祝。"
	quest.0968935C52B69977.title: "填饱肚子了"
	quest.098467CEB0EB0291.quest_desc: [
		"末影人会瞬移、偷窃方块，讨厌对视。它们有多种地域形态：海里的珊瑚末影人、地下的洞穴末影人、花田里开满花朵的末影人。"
		""
		"击败一个以获得末影珍珠。"
	]
	quest.098467CEB0EB0291.quest_subtitle: "认真的。不要这样做。不要。"
	quest.098467CEB0EB0291.title: "不要看着我 (Don't Look at Me)"
	quest.099676C3BFC00B73.quest_desc: ["掠夺者会从哨塔巡逻，并携带弩。击败几个掠夺者，夺取一面旗帜作为战利品，但要小心：携带旗帜进入村庄会引发袭击。"]
	quest.099676C3BFC00B73.quest_subtitle: "他们有弩，而且没礼貌。"
	quest.099676C3BFC00B73.title: "坚守阵地"
	quest.0A09D67ABF63BEC5.quest_desc: ["延长受击后的安全时间，防止下一次攻击冲撞你。"]
	quest.0A09D67ABF63BEC5.quest_subtitle: "无敌帧，但做成首饰的样子。"
	quest.0A09D67ABF63BEC5.title: "宽限期"
	quest.0A2D208160E82645.quest_desc: ["Sequenced Gearshift 为活塞、轴承和组装运行定时移动脚本。"]
	quest.0A2D208160E82645.subtitle: "与游戏帧同步计时。"
	quest.0A2D208160E82645.title: "序列"
	quest.0A40D020C93164B6.quest_desc: ["在要塞中填满传送门框架并跳入。末地是一个散布着岛屿的虚空，末影龙正在第一个岛屿上等着你。"]
	quest.0A40D020C93164B6.quest_subtitle: "这并不是终点。"
	quest.0A40D020C93164B6.subtitle: "奇怪的天空在等着你。"
	quest.0A40D020C93164B6.title: "The End?"
	quest.0A433A5E17D5A8A6.quest_desc: [
		"没有急事，也没有硬性要求。"
		"任务章节可以按任意顺序开启。选择听起来合适的路径，其余的稍后再做。Farbound不关心你建造第一辆车花了多长时间。"
	]
	quest.0A433A5E17D5A8A6.subtitle: "你的步伐，你的道路。"
	quest.0A433A5E17D5A8A6.title: "步伐"
	quest.0A7C826AE795681E.quest_desc: ["钻石是地表世界最好的工具。制作一套完整的钻石装备，感受每一次挥砍的不同。"]
	quest.0A7C826AE795681E.quest_subtitle: "主世界能提供的最精良的工具。"
	quest.0A7C826AE795681E.subtitle: "主世界能提供的最精良的工具。"
	quest.0A7C826AE795681E.title: "最优质的工具"
	quest.0A7E893BC9368979.quest_desc: ["工作台是载具诞生的地方，一次一块。待在长凳旁。动手创造。一百次之后，你的双手会知道该做什么。"]
	quest.0A7E893BC9368979.quest_subtitle: "一百次制作之后才能完成。"
	quest.0A7E893BC9368979.subtitle: "一百次制作之后才能完成。"
	quest.0A7E893BC9368979.title: "忙碌的双手"
	quest.0A7FC503DA11F14A.quest_desc: ["鸸鹋在丛林中踱步，海狸建造水坝，迷你绵羊四处奔跑，赤狐在旱地上穿梭。其中一些很友好。蝎子则不然。"]
	quest.0A7FC503DA11F14A.quest_subtitle: "既奇特又奇妙。"
	quest.0A7FC503DA11F14A.title: "可疑的嫌疑人"
	quest.0A99DE76CFCCE752.quest_desc: ["早晨用煎锅，晚上用炖锅。一直用，直到你不再想起它们为止。"]
	quest.0A99DE76CFCCE752.quest_subtitle: "每天两个花盆，缺一不可。"
	quest.0A99DE76CFCCE752.title: "在火焰上"
	quest.0ABD25320A2966EC.quest_desc: ["线性轴承能让装置沿直线平稳、精确地往复移动。线性外壳、磁端口和扭转锚能让你对移动结构拥有更强的控制力。"]
	quest.0ABD25320A2966EC.quest_subtitle: "操作行云流水，一气呵成。"
	quest.0ABD25320A2966EC.title: "滑动以解锁"
	quest.0B0EB4F0399377F4.quest_desc: ["在海岸上，你会遇到海鸟：偷你食物的海鸥、喙色鲜艳的北极熊、大嘴袋的鹈鹕，以及在公海上滑翔的信天翁。"]
	quest.0B0EB4F0399377F4.quest_subtitle: "正在寻找尼莫海鸥的能量。"
	quest.0B0EB4F0399377F4.title: "是我的！是我的！是我的！"
	quest.0B1786D0E83C0931.quest_desc: ["酵母是活的。善待它，它能把谷物变成更好的东西。催它，你什么也得不到。"]
	quest.0B1786D0E83C0931.quest_subtitle: "请耐心等待。"
	quest.0B1786D0E83C0931.title: "活着的成分 (The Living Ingredient)"
	quest.0B2C1B1E7A5DE844.subtitle: "重型防护，坚固耐用。"
	quest.0B3BF0F82B49B28C.quest_desc: ["每段旅程都始于树木。打碎一些原木，开始行动吧。"]
	quest.0B3BF0F82B49B28C.subtitle: "一切从这里开始。"
	quest.0B3BF0F82B49B28C.title: "木材"
	quest.0B4BA5F9C9D28264.quest_desc: ["巨龙倒下后，它的肉将成就英雄盛宴：烤龙排、龙蛋布丁、酱汁龙腿。这或许是一生中仅能烹饪一次的佳肴。"]
	quest.0B4BA5F9C9D28264.quest_subtitle: "适合屠龙者使用的装备。"
	quest.0B4BA5F9C9D28264.title: "龙之盛宴"
	quest.0B969E127F3F6328.subtitle: "变得更加强大了。"
	quest.0B9752BFF6531910.quest_desc: ["狐狸在夜间潜入泰加林，嘴里叼着物品，并扑向鸡。用甜浆果繁殖两只，幼崽就会信任你。"]
	quest.0B9752BFF6531910.quest_subtitle: "叮叮叮叮叮叮叮叮叮叮叮叮叮叮叮叮叮叮！"
	quest.0B9752BFF6531910.title: "狐狸会发出什么样的叫声呢？"
	quest.0B9E8FA4AA9E28FE.quest_desc: ["击败末影龙，然后探索重制的末地外围岛屿。"]
	quest.0B9E8FA4AA9E28FE.subtitle: "游戏的最终阶段开启了。"
	quest.0B9E8FA4AA9E28FE.title: "巨龙"
	quest.0BA7ABD33A6FEB5D.quest_desc: ["Schematic and Quill 可将选定区域保存为 schematics 文件。Schematic Table 可将 schematics 写入纸张，你可以在不同世界和好友之间共享文件。"]
	quest.0BA7ABD33A6FEB5D.quest_subtitle: "收到，正在处理中。"
	quest.0BA7ABD33A6FEB5D.title: "Ctrl+C, Ctrl+V"
	quest.0BE7A62073C5CAFB.quest_desc: ["夜空现在也有情绪了：矿工月照亮深处，和平月让世界平静，血月则恰恰相反，蓝月、丰收月和超级月亮也各有特色。计划夜晚前，先看看天空。"]
	quest.0BE7A62073C5CAFB.quest_subtitle: "睡觉前记得抬头看看天空。"
	quest.0BE7A62073C5CAFB.title: "许多月亮"
	quest.0C0F68CA69D3CB60.quest_desc: ["作物成熟了，该收获了。啤酒花、大麦、玉米和燕麦，都已准备好进入下一步。"]
	quest.0C0F68CA69D3CB60.quest_subtitle: "田野会给予回报。"
	quest.0C0F68CA69D3CB60.title: "收获的季节"
	quest.0C7BA99C88CD215A.quest_desc: ["家具、灯光和细节。Macaw's、Supplementaries 和朋友们都能满足你。"]
	quest.0C7BA99C88CD215A.subtitle: "细节决定成败，精益求精。"
	quest.0C7BA99C88CD215A.title: "布置家具"
	quest.0C941F468292D989.quest_desc: ["被物品基座环绕的灌注祭坛，在仪式中融合物品。来自永恒传送门的永恒水晶能解锁最强的灌注。"]
	quest.0C941F468292D989.quest_subtitle: "古老的魔法，崭新的力量。"
	quest.0C941F468292D989.title: "灌注仪式"
	quest.0C99E16499DA4E67.quest_desc: ["僵尸是夜晚的迎宾委员会。打败几只，它们就没那么可怕了。大部分时候。"]
	quest.0C99E16499DA4E67.quest_subtitle: "脑子……"
	quest.0C99E16499DA4E67.title: "活死人之夜"
	quest.0CB6BC7687E3AEF5.quest_desc: ["机械压机将锭子压成薄片，并将物品压缩到下方的容器中。铁片、铜片、金片：你都需要成堆的。"]
	quest.0CB6BC7687E3AEF5.quest_subtitle: "压在我身上，也压在你身上。"
	quest.0CB6BC7687E3AEF5.title: "在压力下"
	quest.0D0EDF9FC7A41DF6.quest_desc: ["燕麦能带来顺滑、奶油般的口感。播种一些来丰富你的储藏室吧。"]
	quest.0D0EDF9FC7A41DF6.quest_subtitle: "播种然后等待。"
	quest.0D0EDF9FC7A41DF6.title: "燕麦种子"
	quest.0D7ED0A9D55374FA.quest_desc: ["绳索滑轮可将装置沿绳索升降。电梯滑轮则将其变为带楼层传感器和呼叫按钮的真正电梯。"]
	quest.0D7ED0A9D55374FA.quest_subtitle: "背景音乐不包含在内。"
	quest.0D7ED0A9D55374FA.title: "向上攀登"
	quest.0DA986A19B3498D5.quest_desc: ["古董地图会随着你的旅行而自动填充。走过的每条路，渡过的每条河，每个新山谷——都被记录在案。久而久之，它会成为一幅描绘你所有足迹和所有未竟之地的画卷。"]
	quest.0DA986A19B3498D5.subtitle: "绘制每一条道路和每一条水道。"
	quest.0DA986A19B3498D5.title: "Atlas"
	quest.0DB8ECB04EE06DB9.quest_desc: ["当致命一击降临时，它会把你远远抛开，让你活命。"]
	quest.0DB8ECB04EE06DB9.quest_subtitle: "已收集 1-UP。"
	quest.0DB8ECB04EE06DB9.title: "第二次机会"
	quest.0E5E9A67ABB5BE9B.quest_desc: ["弹奏正确的音符，坐骑便会响应召唤。"]
	quest.0E5E9A67ABB5BE9B.quest_subtitle: "播放歌曲，召唤马匹。"
	quest.0E5E9A67ABB5BE9B.title: "一个哨子和一个坐骑"
	quest.0E990B0110732537.quest_desc: [
		"仔细看看草丛和树叶：瓢虫、叶虫、竹节虫、鹿角虫、球虫、蜗牛和橡实象鼻虫都在忙着自己的小事情。"
		""
		"找到其中的三个就可以了。"
	]
	quest.0E990B0110732537.quest_subtitle: "小世界，大冒险。"
	quest.0E990B0110732537.title: "虫虫的生活大冒险"
	quest.0EA2505D0DCDE946.quest_desc: ["酒窖里最顶级的单一麦芽。花时间酿造，回报自会随之而来。"]
	quest.0EA2505D0DCDE946.quest_subtitle: "经过时间的沉淀，终获认可。"
	quest.0EA2505D0DCDE946.title: "MaggoAllan"
	quest.0EBDAEAD33EEA0E6.quest_desc: [
		"Encased Fan 会吹出气流。对准火焰、水流或岩浆，可以熔炼、清洗或烟熏物品。"
		"建造重型机器前，先进行廉价处理。"
	]
	quest.0EBDAEAD33EEA0E6.subtitle: "空气作为一种机器。"
	quest.0EBDAEAD33EEA0E6.title: "风扇"
	quest.0EF206EA25D53CA5.quest_desc: ["水母形态各异，色彩缤纷，从微小的月亮水母到巨大的狮子鬃水母。它们大多会蜇人，但无一不美。"]
	quest.0EF206EA25D53CA5.quest_subtitle: "可以观看，但请勿触摸。"
	quest.0EF206EA25D53CA5.title: "果冻果酱"
	quest.0F3FB1B471066F2C.quest_desc: [
		"啤酒是用来喝的，威士忌是用来珍藏的。九种酒液出自大师蒸馏器，每一种都需要自己的酒桶和耐心：顺滑的爱尔兰三倍威士忌，陈酿已久的单一麦芽，带有泥煤风味、仿佛能尝到酿酒火焰的烈酒，以及默默无闻、尽职尽责的实干家。"
		""
		"把架子填满。然后退后欣赏它，因为世界上再没有别人拥有这样的架子了。"
	]
	quest.0F3FB1B471066F2C.quest_subtitle: "九个瓶子。一个架子。不着急。"
	quest.0F3FB1B471066F2C.title: "威士忌酒架"
	quest.0F6E511555D0DBE2.quest_desc: ["村庄里搬来了两种职业：一种制作奶酪并交易乳制品，另一种经营伐木场，出售松木、工具及山中出产的其他物品。设置好两种工作站并雇佣他们。"]
	quest.0F6E511555D0DBE2.quest_subtitle: "奶酪匠与隐士。"
	quest.0F6E511555D0DBE2.title: "两张新面孔"
	quest.0F73E79B121C7BB3.quest_desc: ["受惊的犰狳会蜷缩成球。轻柔地刷取鳞甲，这是制作狼盔甲的材料。"]
	quest.0F73E79B121C7BB3.quest_subtitle: "身披铠甲，萌态可掬。"
	quest.0F73E79B121C7BB3.title: "出列！"
	quest.0FAFE54D552CF13B.quest_desc: ["三种海葵、被岁月冲刷光滑的漂木，以及无人所有的白沙。好好建造水族箱，或者干脆把漂木带回家做成门。"]
	quest.0FAFE54D552CF13B.quest_subtitle: "颜色，在深度处。"
	quest.0FAFE54D552CF13B.title: "珊瑚礁"
	quest.0FB2C6040481EE36.quest_desc: ["别再浮在水面了——潜入海底，徒步穿越大洋。"]
	quest.0FB2C6040481EE36.quest_subtitle: "在海底。徒步前行。"
	quest.0FB2C6040481EE36.title: "直达底部"
	quest.0FC6B9385D1B66A3.quest_desc: ["当世界掷骰子时，将运气偏向于你。"]
	quest.0FC6B9385D1B66A3.quest_subtitle: "行不行啊，臭小子？（Well, do ya, punk?）"
	quest.0FC6B9385D1B66A3.title: "感觉幸运吗"
	quest.1009020FEA137A2F.quest_desc: ["第三人称视角下，摄像头会平滑跟随你的船体而非头部。飞行时切换视角，从船外欣赏沿途风景。"]
	quest.1009020FEA137A2F.quest_subtitle: "对着镜头笑一个吧。"
	quest.1009020FEA137A2F.title: "追逐摄像头"
	quest.100A3C479340716A.quest_desc: ["长矛专为骑乘战斗而生：全速冲锋，惯性会完成一切。有些夜晚，僵尸马会驮着亡灵骑手，骆驼也可以在沙漠中装备使用。"]
	quest.100A3C479340716A.quest_subtitle: "骑上马，准备战斗。"
	quest.100A3C479340716A.title: "混乱的坐骑模组 (Mounts of Mayhem)"
	quest.101B7EFF0539CAF5.quest_desc: ["铜制酿造站能酿造更大批次的饮品，在酿酒大厅里看起来也十分壮观。下界合金版则是酿酒师的终极骄傲。"]
	quest.101B7EFF0539CAF5.quest_subtitle: "闪闪发光，一本正经。"
	quest.101B7EFF0539CAF5.title: "铜制水壶"
	quest.101E982267085220.quest_desc: [
		"这是一台真正的电脑。放置它，右键打开终端，它会启动并等待你的指令。它运行的是 Lua 编程语言，所以从现在开始，所有事情都由你来告诉它怎么做。"
		""
		"输入 help 查看内置命令，输入 programs 查看预安装程序。"
	]
	quest.101E982267085220.quest_subtitle: "一台完整的电脑，却能放在一个架子上。"
	quest.101E982267085220.title: "启动系统"
	quest.102E8CE56D8BC8F7.subtitle: "第二次机会是值得为之努力的。"
	quest.10336294D2C6C77A.quest_desc: ["相框可将画作挂在墙上，玻璃框尽显格调，发光框则在夜间点亮画作。打造一面画廊墙吧。"]
	quest.10336294D2C6C77A.quest_subtitle: "把它挂在墙上吧。"
	quest.10336294D2C6C77A.title: "带框的"
	quest.10391638229B1BFD.quest_desc: ["红石磁铁会吸引或排斥其他红石磁铁。用它们来拉动货物、固定起落架，或轻柔地推开船只。"]
	quest.10391638229B1BFD.quest_subtitle: "推动和拉动。"
	quest.10391638229B1BFD.title: "异性相吸"
	quest.10441ED639D0B0E0.quest_desc: ["齿轮箱可将旋转传递至三维空间的各个角落。整理好你的电源线。"]
	quest.10441ED639D0B0E0.subtitle: "每个角落都充满了力量。"
	quest.10441ED639D0B0E0.title: "齿轮箱"
	quest.1068335470EE6D80.quest_desc: ["巧克力蛋糕、巧克力挞和一盒巧克力松露。一位巧克力匠的杰作。"]
	quest.1068335470EE6D80.quest_subtitle: "值得了。"
	quest.1068335470EE6D80.title: "巧克力致死法"
	quest.107D95810E24D2ED.quest_desc: ["铅坠是一种下落方块，冲击力极强：下落越远，伤害越高。是个绝佳的陷阱，但站在下面可不是好主意，而且每次使用后都会轻微破损。"]
	quest.107D95810E24D2ED.quest_subtitle: "小心脚下！"
	quest.107D95810E24D2ED.title: "重力永远获胜"
	quest.108BDD2DB8655EFE.quest_desc: ["甜椒有多种颜色，野生咖啡和棉花生长在温暖的地方。找到它们的野生植物并把种子带回家。"]
	quest.108BDD2DB8655EFE.quest_subtitle: "红色，黄色，绿色，开始。"
	quest.108BDD2DB8655EFE.title: "胡椒采摘工"
	quest.10976E9DDED99BE7.quest_desc: ["Chromatic Sheets 将三层黑白图像合成为一张全彩照片，就像最早的彩色摄影。在 Lightroom 中打印各层，并在其上方放置染色玻璃。"]
	quest.10976E9DDED99BE7.quest_subtitle: "红色，绿色，蓝色。"
	quest.10976E9DDED99BE7.title: "全光谱（Full Spectrum）"
	quest.109EEAFDAE4EFFEC.quest_desc: ["各种颜色的椅子、落地椅和坐垫，还有可折叠的壁挂桌。它们能完美适配火车、船只和飞艇，座椅也适用于移动装置。"]
	quest.109EEAFDAE4EFFEC.quest_subtitle: "从头到尾都是一流的体验。"
	quest.109EEAFDAE4EFFEC.title: "舒适的通勤之旅"
	quest.10F81EA834406CE7.quest_desc: ["祖父时钟、镜子、梳妆台、办公椅、百叶窗和衣柜，木材种类繁多，包括来自遥远生物群系的珍稀木材。烟囱和铜制鱼缸增添了特色。"]
	quest.10F81EA834406CE7.quest_subtitle: "滴答滴答，时钟戛然而止，再也不会走动。"
	quest.10F81EA834406CE7.title: "祖父时钟"
	quest.10FB352217FFD24A.quest_desc: ["哈夫林格和冰岛马这类小马体型虽小却很坚韧：它们能一步登上两格高，无视坠落伤害，能在粉雪上行走，并且能自我疗愈。"]
	quest.10FB352217FFD24A.quest_subtitle: "友谊就是魔法。"
	quest.10FB352217FFD24A.title: "小马宝莉"
	quest.10FEAB5B6B8CBC39.quest_desc: ["故意挨打，因为它的反击会比你的攻击更猛烈。"]
	quest.10FEAB5B6B8CBC39.quest_subtitle: "我一天到晚都能做这个。"
	quest.10FEAB5B6B8CBC39.title: "打我一下"
	quest.1119C6E879368F7A.quest_desc: ["新的地牢散布在世界各地。有些适合空中抵达，有些则适合乘船或陆路。用你喜欢的方式抵达，将其清空，并带走里面的东西。"]
	quest.1119C6E879368F7A.subtitle: "绕远路是值得的。"
	quest.1119C6E879368F7A.title: "地牢"
	quest.113D21FED81BA22A.quest_desc: ["Pearlescent Levitite 是晶体的精炼闪耀版本。用作船底龙骨十分美观，也表明你已掌握诀窍。"]
	quest.113D21FED81BA22A.quest_subtitle: "闪闪发光的升降台。"
	quest.113D21FED81BA22A.title: "天空的珍珠"
	quest.1148983FDCF78770.quest_desc: ["水稻、卷心菜、番茄、洋葱、土豆、胡萝卜、小麦、甜菜根、生菜。一次收获，应有尽有。从此厨房无所不能。"]
	quest.1148983FDCF78770.quest_subtitle: "储藏室就从这里开始建造。"
	quest.1148983FDCF78770.title: "从零开始建造家园"
	quest.115A0CF977B4E6BA.quest_desc: ["贸易站能让创造机器与村民交易。投入付款，产出货物，前提是村民在工作。注意：村民只在正常工作时间交易。"]
	quest.115A0CF977B4E6BA.quest_subtitle: "村民，自动化了。"
	quest.115A0CF977B4E6BA.title: "贸易路线"
	quest.11713783D12447FF.quest_desc: ["灵魂根索能将生物的灵魂束缚，让你可以携带并在别处释放，甚至远程操作。小心地将你的宠物带到世界的另一端。"]
	quest.11713783D12447FF.quest_subtitle: "一条为流浪灵魂准备的线。"
	quest.11713783D12447FF.title: "灵魂纽带"
	quest.117A6B881B8098BE.quest_desc: ["导航终端和导航配置文件存储着路线和航点。使用配置文件构建器构建配置文件，加载后，飞船将自动沿路线飞行。"]
	quest.117A6B881B8098BE.quest_subtitle: "向右第二颗星星，然后一直朝前直到天亮。"
	quest.117A6B881B8098BE.title: "指向即飞行"
	quest.11876D7B8522D888.quest_desc: ["滑道可将物品上下移动。与风扇搭配可实现垂直推动。"]
	quest.11876D7B8522D888.subtitle: "向上、向下，穿过墙壁。"
	quest.11876D7B8522D888.title: "滑道"
	quest.11B1AA0514D460A1.quest_desc: ["夜晚带来麻烦。屋顶、床和火把就足够了。旅途可以再等一晚。"]
	quest.11B1AA0514D460A1.subtitle: "地面层，暂时先这样。"
	quest.11B1AA0514D460A1.title: "庇护所"
	quest.11D17EC96A3D2003.quest_desc: ["飞得足够高，天空就会变黑。你已在太空。回头看看你来的世界，它非常非常小。"]
	quest.11D17EC96A3D2003.quest_subtitle: "巴斯·光年向你致敬。"
	quest.11D17EC96A3D2003.title: "飞向无限与更远的地方"
	quest.11DD0110AE38BCF8.quest_desc: ["Hypertubes 能将玩家高速射出玻璃管道。建造入口，铺设管道，添加加速器保持冲力，即可在数秒内往返于基地和机库。"]
	quest.11DD0110AE38BCF8.quest_subtitle: "互联网不是一辆大卡车。"
	quest.11DD0110AE38BCF8.title: "一連的管道"
	quest.11F9A1753293464D.quest_desc: ["女巫小屋比以前更大更漂亮了，有些还长在红树林里。如果女巫允许，就去拜访一下吧。"]
	quest.11F9A1753293464D.quest_subtitle: "不要吃姜饼人。"
	quest.11F9A1753293464D.title: "汉塞尔与格莱特"
	quest.120135457D018E6A.quest_desc: [
		"给容器装上足够的 Levitite 就能漂浮，无需燃烧器或燃料。但它不能让船自己爬升：升力和推力仍来自气球和螺旋桨。低速下它还能抵抗运动，这让船在靠岸时异常稳定。"
		""
		"收集一叠，让某物悬浮起来。"
	]
	quest.120135457D018E6A.quest_subtitle: "违背重力的水晶。"
	quest.120135457D018E6A.title: "向上，再向上，飞向远方"
	quest.121B165E51D6D412.quest_desc: [
		"纸板不仅能包装东西。还有纸板盔甲和纸板剑，非常适合预算有限的骑士，也适合把自己伪装成一个盒子。"
		""
		"路过而已，这里没什么好看的。"
	]
	quest.121B165E51D6D412.quest_subtitle: "如果你相信的话，一个盒子就是一座城堡。"
	quest.121B165E51D6D412.title: "纸板骑士"
	quest.1240D197C8D02D59.quest_desc: [
		"铁砧可以修理装备、合并附魔和重命名物品。在 Farbound 中，当你走开时它会保管你的物品，而且以前显示“太贵了！”的成本上限也变得友善多了。"
		""
		"三块铁块和四个铁锭。很重，但物有所值。"
	]
	quest.1240D197C8D02D59.quest_subtitle: "住手。是时候用锤子了。"
	quest.1240D197C8D02D59.title: "无法触碰此物"
	quest.124193821DF67850.quest_desc: ["烈焰银行家是一种为你处理交易的烈焰人，一个永不眠的火焰会计师。身份证和授权卡控制着谁可以使用你的账户。"]
	quest.124193821DF67850.quest_subtitle: "火热促销"
	quest.124193821DF67850.title: "火热促销"
	quest.124C5FC2EC8582E7.quest_desc: [
		"Levitite 最初由末石粉末、锌粒和水在加热搅拌机中混合而成。产物是 Levitite Blend，一种受热后会结晶成固体 Levitite 的液体。将其倒入模具，在附近点燃火焰，即可见证晶体在整个池子中蔓延。"
		""
		"末地石意味着要先去末地，所以这是后期奢侈品，不是入门部件。"
	]
	quest.124C5FC2EC8582E7.quest_subtitle: "想要漂浮起来的混合物。"
	quest.124C5FC2EC8582E7.title: "Liquid Sky"
	quest.1251EED4770359AA.quest_desc: ["雪貂好奇心强、速度快，还能被驯服。喂饱一只，它就会成为忠诚的小伙伴，跟随着你，并替你与兔子战斗。"]
	quest.1251EED4770359AA.quest_subtitle: "Pop goes the weasel."
	quest.1251EED4770359AA.title: "模棱两可的词汇"
	quest.12748F7D03EC2D70.quest_desc: ["野马、阿帕卢萨马和美国彩绘马等西部品种在道路、砾石、鹅卵石和砖块上速度更快。建造一条小径，骑着它们驰骋吧。"]
	quest.12748F7D03EC2D70.quest_subtitle: "直到最后都是法外之徒。"
	quest.12748F7D03EC2D70.title: "荒野大镖客：救赎"
	quest.12862C4966D168E4.quest_desc: ["蚕丝能制成优质线和格外柔软的铅。收集些蚕丝，看看它能做什么。"]
	quest.12862C4966D168E4.quest_subtitle: "由许多小短腿纺成的线。"
	quest.12862C4966D168E4.title: "丝绸之路"
	quest.128E43DA76AF66BC.quest_desc: ["出口传送门上有四个末地水晶，巨龙归来，更愤怒，也更精神。重建战斗，赢得两次，并刷取游戏中唯一可再生的首领。"]
	quest.128E43DA76AF66BC.quest_subtitle: "她会重生。你早就知道这一点，对吧？"
	quest.128E43DA76AF66BC.title: "终结... 又是... 终结..."
	quest.1293DA259DA92DD3.quest_desc: ["Spout 用于在传送带或存储箱上为物品填充流体。适用于瓶子、桶和配方输入。"]
	quest.1293DA259DA92DD3.subtitle: "把它填满，然后继续前进。"
	quest.1293DA259DA92DD3.title: "Spout"
	quest.1299B6906BD80EF1.quest_desc: ["蒲草、芦苇和苔藓生长在水边。蒲草甚至可以用来做屋顶的茅草。"]
	quest.1299B6906BD80EF1.quest_subtitle: "潮湿而狂野。"
	quest.1299B6906BD80EF1.title: "沼泽生物"
	quest.129CFAC7F4C0A825.quest_desc: ["Ever wanted to drink several potions at once? Now you can. With a brewing cauldron and a herbal infusion you carry your effects in a flask."]
	quest.129CFAC7F4C0A825.quest_subtitle: "伪装起来的药水。"
	quest.129CFAC7F4C0A825.title: "便携茶包"
	quest.12AA938758D8898A.quest_desc: [
		"保持饱食度。面包、肉，或者快速下地干活都行。"
		"Farbound 稍晚于 Farmer's Delight 加入，参见 Hearth 章节。"
	]
	quest.12AA938758D8898A.subtitle: "吃饱了才能走得更远。"
	quest.12AA938758D8898A.title: "食物"
	quest.12C1F2ECDDC8A662.quest_desc: ["连锁打字机将红石链接频率分配给按键，使整艘船的控制系统都能容纳于一张桌上。定向和调制连锁接收器可探测到其他链接的方向和距离。"]
	quest.12C1F2ECDDC8A662.quest_subtitle: "一个按键，一个指令。"
	quest.12C1F2ECDDC8A662.title: "王国钥匙 (Keys to the Kingdom)"
	quest.12CB86544BA5AF0B.quest_desc: ["月球表面是风化层、岩石和玄武岩，古老的裂谷里长着奇怪的苔藓。把样本带回来：你是第一个登陆另一个世界的地质学家。"]
	quest.12CB86544BA5AF0B.quest_subtitle: "来自轨道的纪念品。"
	quest.12CB86544BA5AF0B.title: "月球岩石"
	quest.12D1D591503865EC.quest_desc: ["堡垒深处藏着一个磨损的锻造模板。找到一个吧。没有它，下界合金装备就遥不可及。"]
	quest.12D1D591503865EC.quest_subtitle: "迷失在堡垒中，值得去寻找。"
	quest.12D1D591503865EC.subtitle: "迷失在堡垒中，值得去寻找。"
	quest.12D1D591503865EC.title: "一个褪色的图案"
	quest.12D573AFC40E4EB7.quest_desc: ["面团制成的意面，搭配肉丸、羊肉排或鱿鱼墨汁。农场里的意大利之夜。"]
	quest.12D573AFC40E4EB7.quest_subtitle: "我又一次开始了新的冒险。"
	quest.12D573AFC40E4EB7.title: "天哪，我的天哪"
	quest.12D86FC5CCA12F0B.quest_desc: [
		"机械臂能将物品从一个地方捡起，放到另一个地方，贯穿整个工坊。手持机械臂选择输入和输出，然后放置它。"
		""
		"它是 Create 中最灵活的物品搬运器。"
	]
	quest.12D86FC5CCA12F0B.quest_subtitle: "它能将物品移动到你所指定的位置。"
	quest.12D86FC5CCA12F0B.title: "帮帮我一把 (Give Me a Hand)"
	quest.12E65AD43D0DA3EF.quest_desc: ["各种大小的地下城遍布平原、沙漠和冰川：小、中、大型，一个比一个更深更危险。先清理一个小地下城吧。"]
	quest.12E65AD43D0DA3EF.quest_subtitle: "进行先攻权判定。"
	quest.12E65AD43D0DA3EF.title: "地牢探险家"
	quest.1345182ED89F7905.quest_desc: ["废料放进去，堆肥倒出来，富土随之而来。建造堆肥机，完成循环。"]
	quest.1345182ED89F7905.quest_subtitle: "没有任何东西会被浪费掉。"
	quest.1345182ED89F7905.title: "回归土壤"
	quest.13452B609E58F2F1.quest_desc: ["牛奶咖啡、蜂蜜咖啡、糖浆咖啡、巧克力咖啡、南瓜咖啡和樱花咖啡。选两种犒劳自己吧。"]
	quest.13452B609E58F2F1.quest_subtitle: "泡沫中漂浮的一颗心。"
	quest.13452B609E58F2F1.title: "拿铁艺术"
	quest.134C4B9E79951D4F.quest_desc: ["荧光棒在黑暗中会发出蓝、绿、红、黄光。将其磨成粉可获得发光染料。"]
	quest.134C4B9E79951D4F.quest_subtitle: "霓虹自然。"
	quest.134C4B9E79951D4F.title: "闪亮登场"
	quest.13533FFEC6256160.quest_desc: ["太空没有空气。太空头盔能让你在飞船外呼吸，铜锚靴能让你在作业时双脚固定在船体上。"]
	quest.13533FFEC6256160.quest_subtitle: "能听到我吗，汤姆少校？"
	quest.13533FFEC6256160.title: "太空奇事"
	quest.135CEB6A4DEE05A9.quest_desc: ["修道院、竞技场和鸟舍各自隐藏着独特的挑战。去拜访其中两处伟大的地标吧。"]
	quest.135CEB6A4DEE05A9.quest_subtitle: "沉默的誓言，钢铁的利剑。"
	quest.135CEB6A4DEE05A9.title: "寂静秩序"
	quest.136CDD1AAB415ECB.quest_desc: ["面包店的甜甜圈和华夫饼，奶油馅的羊角面包。犒劳一下自己，你值得拥有。"]
	quest.136CDD1AAB415ECB.quest_subtitle: "荷马批准了。"
	quest.136CDD1AAB415ECB.title: "嗯，甜甜圈的味道真不错"
	quest.13A4B03E97FD731D.quest_desc: ["变压器改变电压。高压传输距离远、损耗小，低压则安全用于设备。高低压断路器和开关能将其控制在范围内。"]
	quest.13A4B03E97FD731D.quest_subtitle: "汽车人，出发！"
	quest.13A4B03E97FD731D.title: "所见并非所得的全部"
	quest.13D3DC2C91D9E2A7.quest_desc: ["辰砂藏在更深的岩石中，用磨石将其磨成红石粉。收集一些原辰砂，把它变成驱动你装置的动力。"]
	quest.13D3DC2C91D9E2A7.quest_subtitle: "闪闪发光的东西并不都是金子。"
	quest.13D3DC2C91D9E2A7.title: "红色黄金"
	quest.13E8EF50A6D5529E.quest_desc: ["铁傀儡能保护村庄。用四个铁块和一个雕刻过的南瓜就能制作自己的。雪傀儡更便宜，会向任何敌对生物投掷雪球。"]
	quest.13E8EF50A6D5529E.quest_subtitle: "你是谁，取决于你自己的选择。"
	quest.13E8EF50A6D5529E.title: "钢铁巨人"
	quest.13FB30173DA56970.quest_desc: [
		"荧光棒是可投掷的光源。把它扔进竖井看看能多深，标记洞穴中的路径，或者让你的矿井看起来像节日庆典。"
		""
		"它们有多种颜色。制作几个吧。"
	]
	quest.13FB30173DA56970.quest_subtitle: "打开，打开，打开。"
	quest.13FB30173DA56970.title: "洞穴里的狂欢派对"
	quest.1409D178E1CE6F93.quest_desc: ["智能观察者能看到物品栏、传送带和管道内的物品，并在匹配过滤器时发出信号。"]
	quest.1409D178E1CE6F93.quest_subtitle: "里面到底有什么东西呢？"
	quest.1409D178E1CE6F93.title: "请持续关注此空间"
	quest.140BEB660AF11FA0.quest_desc: [
		"整合起来：起落架、推进器、方向舵和飞行员。建造一艘能起飞、飞行一圈并安全着陆而不会散架的飞行器。"
		""
		"不必追求美观。第一个从来都不是。它只需要能飞就行。"
	]
	quest.140BEB660AF11FA0.quest_subtitle: "1903年12月17日。基蒂霍克。"
	quest.140BEB660AF11FA0.title: "莱特兄弟"
	quest.14277A303F8D49BF.quest_desc: ["食品工厂生产各种披萨：奶酪、培根等等。切开、分享，或者当早餐冷着吃。"]
	quest.14277A303F8D49BF.quest_subtitle: "酷毙了，伙计。"
	quest.14277A303F8D49BF.title: "披萨时间到了"
	quest.143D860E501CAD07.quest_desc: ["咖啡和蛋糕天生一对。用咖啡搭配蛋糕或饼干，开启你自己的咖啡馆。"]
	quest.143D860E501CAD07.quest_subtitle: "我会一直陪在你身边的，放心吧。"
	quest.143D860E501CAD07.title: "中央咖啡馆"
	quest.143F6185CFEAC844.quest_desc: ["篮子可以接住掉落物品并储存收成。把它挂在作物农场下，或带到田里去。"]
	quest.143F6185CFEAC844.quest_subtitle: "一个绿色和黄色的篮子。"
	quest.143F6185CFEAC844.title: "一个篮子，一个篮子，里面装着任务清单"
	quest.144F5A150D7AA7E1.quest_desc: [
		"在基岩层附近，深埋地底，蓝白色的闪光终于出现。钻石能制作最坚固的原版工具，并开启附魔。"
		""
		"找几个带回家。深层岩采矿很慢，带上食物、火把和耐心。"
	]
	quest.144F5A150D7AA7E1.quest_subtitle: "钻石！……等等，那只是青金石碎片。"
	quest.144F5A150D7AA7E1.subtitle: "打磨直到它闪闪发光。"
	quest.144F5A150D7AA7E1.title: "像钻石一样闪闪发光"
	quest.1455ED89F86EF6BC.quest_desc: ["谷物需要地方来晾晒和存放。建造木制筒仓来储存你的收成。"]
	quest.1455ED89F86EF6BC.quest_subtitle: "让它安息吧。"
	quest.1455ED89F86EF6BC.title: "筒仓"
	quest.146553B3D9D393F1.quest_desc: ["气压随海拔升高而降低，影响一切：燃烧器、通风口和螺旋桨在高处都会失去动力。每艘船都有飞行上限。向上爬直到无法再升高，你就能找到自己的上限。"]
	quest.146553B3D9D393F1.quest_subtitle: "越往上走就越难了。"
	quest.146553B3D9D393F1.title: "稀薄空气"
	quest.1474DD34233BEE45.quest_desc: ["珊瑚礁和潮池里有许多新鱼：小丑鱼、海马、狮子鱼、鹦嘴鱼、海星等等。找到一只小丑鱼和海马。"]
	quest.1474DD34233BEE45.quest_subtitle: "继续游泳就好。"
	quest.1474DD34233BEE45.title: "寻找尼莫 (Finding Nemo)"
	quest.14802696DBCB1D44.quest_desc: ["新增了 Dean、Dusk、Pearl、Scarlet 和 Umber 等名称的砖块颜色，每种都有长、角、裂纹和苔藓变种。砖厂从未如此优雅。"]
	quest.14802696DBCB1D44.quest_subtitle: "我们不需要任何教育。We do not need no education."
	quest.14802696DBCB1D44.title: "墙上的又一块砖头"
	quest.14805D04661BCDF3.quest_desc: ["红石链接可在两个配对链接之间通过空气传输红石信号。用任意两种物品设置频率。链接控制器可将其变为遥控器。"]
	quest.14805D04661BCDF3.quest_subtitle: "没有电线，没有烦恼。"
	quest.14805D04661BCDF3.title: "无线传输"
	quest.14B5D510E1CE39F1.quest_desc: [
		"海龟是一种运行程序的小机器人。给它一把镐，它会挖矿；给它一把锄，它会耕地；给它一把剑，它会守卫。教它一个采石场程序，它就能在你睡觉时挖掘。"
		""
		"建造一只海龟，并为它装备工具。"
	]
	quest.14B5D510E1CE39F1.quest_subtitle: "酷毙了！Cowabunga！"
	quest.14B5D510E1CE39F1.title: "一路向下，直至龟底"
	quest.14D6BB7A299DF387.quest_desc: ["鼠标飞行控制器让你用鼠标操控方向。空气动力学尾迹生成器会在你的机翼末端画出尾迹。两者都乐趣无穷。"]
	quest.14D6BB7A299DF387.quest_subtitle: "就像电子游戏里，电子游戏里的一切。"
	quest.14D6BB7A299DF387.title: "指向即飞行"
	quest.14E5156E208A2D5D.quest_desc: ["戴上它，鱼儿们仿佛一直在等着你，迫不及待地咬钩。"]
	quest.14E5156E208A2D5D.quest_subtitle: "你需要一顶更大的帽子了。"
	quest.14E5156E208A2D5D.title: "去钓鱼了"
	quest.14E51D12D187C69D.quest_desc: ["锯木机将木屑压制成木片，这是一种外观质朴的廉价建筑材料。由安山岩制成的梁和支撑杆将所有结构固定在一起。"]
	quest.14E51D12D187C69D.quest_subtitle: "颗粒板时尚风。"
	quest.14E51D12D187C69D.title: "有其父必有其子，有其子必有其父"
	quest.14EBA9291A7C6DE4.quest_desc: ["每匹马都该有马厩。马厩地板、干草、食槽、水槽和充足的马饲料能让你的马群保持快乐。"]
	quest.14EBA9291A7C6DE4.quest_subtitle: "为你的牛群建造一个家。"
	quest.14EBA9291A7C6DE4.title: "马厩"
	quest.14EDCB2253F8CF5F.quest_desc: ["原磁铁矿会偏转罗盘的指针。制作一个磁性罗盘，除非附近有磁性物体将其偏离，否则它会指向磁北极。沿着它走足够远，你就会找到北极点。"]
	quest.14EDCB2253F8CF5F.quest_subtitle: "我才是世界之王！"
	quest.14EDCB2253F8CF5F.title: "真北方向"
	quest.15143FE29B818537.quest_desc: ["电路设计台能让你在电路图上绘制电路。将其刻在板上，让机械臂插入组件，你就得到了一块定制电路板。"]
	quest.15143FE29B818537.quest_subtitle: "先画出来，然后再建造它。"
	quest.15143FE29B818537.title: "设计工作室"
	quest.151E500E8BA45610.quest_desc: ["灯笼有专属配饰栏。佩戴一个，行走时即可照亮周围世界，轻轻一摆即可。无需火把，解放双手。洞穴、甲板和夜间飞行都变得更友好了。"]
	quest.151E500E8BA45610.quest_subtitle: "无需手持即可提供照明。"
	quest.151E500E8BA45610.title: "时尚之光 (Light on the Hip)"
	quest.152A137842DEF088.quest_desc: ["废弃的传送门遍布世界，存在于深板岩、滴水石、繁茂洞穴和开阔地带。它们的箱子里通常装有黄金和黑曜石。"]
	quest.152A137842DEF088.quest_subtitle: "需要一定的组装技巧才能完成。"
	quest.152A137842DEF088.title: "通往虚无的传送门"
	quest.152C40C89926B11D.quest_desc: ["赢得一次袭击以保卫村庄。村民会打折和送礼物来感谢你。带上朋友、哥布林和大量箭矢。"]
	quest.152C40C89926B11D.quest_subtitle: "并非所有英雄都披着斗篷。"
	quest.152C40C89926B11D.title: "村庄的英雄"
	quest.152D792CDA1448E1.quest_desc: ["新鲜的叶子需要晾干才能使用。将9片绿茶叶合成，放置方块并等待晾干。将其打破可获得干绿茶。用干绿茶重复此操作可获得红茶。混合4片干绿茶和4片干红茶可制作乌龙茶。"]
	quest.152D792CDA1448E1.quest_subtitle: "时间会证明一切。"
	quest.152D792CDA1448E1.title: "干燥的日子"
	quest.1531F63D7B93815F.quest_desc: ["远离出生点。在起点和终点之间拉开真正的距离。每走一里，地图就会填满。去探索外面的世界吧。"]
	quest.1531F63D7B93815F.subtitle: "距离就是关键所在。"
	quest.1531F63D7B93815F.title: "漫游者"
	quest.153BE58DC11BA10A.quest_desc: ["烧烤签、猪肋排、烤羊肉排。点燃飞艇甲板的烤架，邀请邻居们来聚会吧。"]
	quest.153BE58DC11BA10A.quest_subtitle: "点燃烧烤架，开始烹饪吧。"
	quest.153BE58DC11BA10A.title: "烧烤大师"
	quest.153E48A038C0EF4F.quest_desc: ["苹果酒和苹果葡萄酒来自果园，而非葡萄园。蜜酒是用蜂蜜酿造的。每个地窖都需要一些多样性。"]
	quest.153E48A038C0EF4F.quest_subtitle: "酥脆金黄，香气扑鼻。"
	quest.153E48A038C0EF4F.title: "苹果酒屋的规则"
	quest.154220DDCD9886ED.quest_desc: ["Terminite 是在熔炉中用末影尘与 Thallasium 合金制成的。更坚固、更闪亮，是高端末地装备的基础。"]
	quest.154220DDCD9886ED.quest_subtitle: "我还会回来的。"
	quest.154220DDCD9886ED.title: "终结者"
	quest.15455D78CBA1B846.quest_desc: [
		"加固纸能做出更坚固的滑翔机：铁、金、钻石，最后是下界合金。每个等级都更耐用，能承受更多冲击。"
		""
		"先升级到铁质滑翔翼吧。"
	]
	quest.15455D78CBA1B846.quest_subtitle: "通往无限与……更远的地方。"
	quest.15455D78CBA1B846.title: "更高、更远、更长久"
	quest.154790EDCB68CA75.quest_desc: ["一手扭结面包，一手姜饼。服装归你。找到这个食谱的房子是别人的事。"]
	quest.154790EDCB68CA75.quest_subtitle: "节日的气味就是这样的味道。"
	quest.154790EDCB68CA75.title: "跟随面包屑的指引"
	quest.155592F514539B19.quest_desc: [
		"水桶能灭火、熔炼矿石、治愈中毒，还能制造瀑布，让你安全地从悬崖上下来。"
		""
		"制作一个并用水装满。从此以后你出门再也不会不带它了。"
	]
	quest.155592F514539B19.quest_subtitle: "水、岩浆、牛奶：神圣的三位一体。"
	quest.155592F514539B19.title: "愿望清单 (Bucket List)"
	quest.156119AC7A65A6A8.quest_desc: ["骑乘马铃薯大炮是马铃薯大炮的方块版本。把它装到你的船上，打造一艘用蔬菜自卫的船只。"]
	quest.156119AC7A65A6A8.quest_subtitle: "骑乘生物，危险重重。"
	quest.156119AC7A65A6A8.title: "Spud 电池"
	quest.156966B3C44FEF51.quest_desc: ["汤和炖菜是温馨厨房的支柱。制作三种不同的汤：蔬菜汤、鸡汤、鱼汤，或者用你花园里能找到的任何东西。"]
	quest.156966B3C44FEF51.quest_subtitle: "没你的份儿，这汤不给你喝！"
	quest.156966B3C44FEF51.title: "今日特供汤品"
	quest.15A103A19EC3E19F.quest_desc: ["软管连接器将流体、物品和电力连接在单独的容器之间：连接到加油船的燃料管、连接到货船的物料软管、连接到停泊船只的电源线。链条连接器将它们固定在一起。"]
	quest.15A103A19EC3E19F.quest_subtitle: "在空中进行空中加油。"
	quest.15A103A19EC3E19F.title: "燃料管线"
	quest.15C1309C9B716EFF.quest_desc: ["推进器在红石供电和松节油供给时提供定向推力。没有螺旋桨，没有旋转，只有一个力喷。固体燃料推进器则从后部的舱口燃烧物品。"]
	quest.15C1309C9B716EFF.quest_subtitle: "直接、纯粹、简单。"
	quest.15C1309C9B716EFF.title: "点燃蜡烛"
	quest.15C477067FE0D195.quest_desc: ["流沙藏在沙漠和沼泽里，站着不动就会被吸下去。小心地找一些，带桶回家做个狠毒的陷阱。"]
	quest.15C477067FE0D195.quest_subtitle: "不要挣扎了。"
	quest.15C477067FE0D195.title: "逐渐下沉的感觉"
	quest.15CDA14FF6CBAFD1.quest_desc: ["铀棒提供燃料，石墨棒控制反应。两者都是运行反应堆核心的必需品。"]
	quest.15CDA14FF6CBAFD1.quest_subtitle: "请用钳子处理。"
	quest.15CDA14FF6CBAFD1.title: "燃料棒"
	quest.15CFF22A27F5DA4C.quest_desc: ["黑白胶片是经典。彩色胶片捕捉真实世界。高感度胶片适合低光环境。装填胶卷，开始拍摄。"]
	quest.15CFF22A27F5DA4C.quest_subtitle: "无需任何过滤条件。"
	quest.15CFF22A27F5DA4C.title: "模拟爱情"
	quest.15D4A9FE68D198A5.quest_desc: ["尖桩围栏、板条围栏、马围栏、带刺铁丝网、树篱和华丽的大门。用时尚的方式围起你的花园。"]
	quest.15D4A9FE68D198A5.quest_subtitle: "罗伯特·弗罗斯特知道这一点。"
	quest.15D4A9FE68D198A5.title: "好篱笆造就好邻居"
	quest.15D6D7A49B591B46.quest_desc: ["将下界疣酿入水瓶，制成粗制药水。单独使用毫无用处，却是几乎所有酿造的基础。"]
	quest.15D6D7A49B591B46.subtitle: "单独无用，却是万物必需。"
	quest.15D6D7A49B591B46.title: "可供建造的基地基础结构（A Base to Build On）"
	quest.15E13613F7CE9A39.quest_desc: ["瞭望塔矗立在森林之上。从塔顶可以远眺数英里。规划下一次旅行的理想地点。"]
	quest.15E13613F7CE9A39.quest_subtitle: "沿着瞭望塔一路走来。"
	quest.15E13613F7CE9A39.title: "瞭望塔"
	quest.15FB67DB02C075BB.quest_desc: ["黄铜漏斗和黄铜隧道可以过滤通过的物品。智能滑槽则垂直过滤。配合过滤器和属性过滤器，你的传送带就能自动分类了。"]
	quest.15FB67DB02C075BB.quest_subtitle: "过滤器是你的好朋友。"
	quest.15FB67DB02C075BB.title: "智能移动指令方块"
	quest.15FD243D886EF9E2.quest_desc: [
		"计算机可以读取物理容器的状态：位置、速度、旋转。机载计算机可以监控飞艇的高度、运行稳定器，或在显示器上显示实时飞行仪表盘。"
		""
		"将一台计算机放置在移动载具上并读取其数据。"
	]
	quest.15FD243D886EF9E2.quest_subtitle: "很抱歉，戴夫，恐怕我做不到那件事。"
	quest.15FD243D886EF9E2.title: "自动驾驶仪"
	quest.1639478B365808BE.title: "极地冰盖"
	quest.163BDBCD8F18A4C8.quest_desc: ["有些夜晚月亮会变红，怪物也会变得更凶猛、更繁多。在户外度过一次血月。"]
	quest.163BDBCD8F18A4C8.quest_subtitle: "一轮不祥的月亮正在升起。"
	quest.163BDBCD8F18A4C8.title: "Bad Moon Rising"
	quest.163C2234D79E1EA8.quest_desc: ["CRT显示器、模块化显示器和绘图仪以那种温暖闪烁的风格展示电路的运行情况。穿孔卡和读卡器则以老式方法存储数据。"]
	quest.163C2234D79E1EA8.quest_subtitle: "请稍候，正在处理中。"
	quest.163C2234D79E1EA8.title: "复古屏幕"
	quest.1646277A41707E29.quest_desc: ["戴上他们的脸，猪灵就会停止拔剑。"]
	quest.1646277A41707E29.quest_subtitle: "这只小猪待在家里。而你却没有。"
	quest.1646277A41707E29.title: "其中一头猪（Pigs）中的一个（One of the Pigs）"
	quest.164E2119278B4404.quest_desc: ["掠夺者营地、风车和掠夺者堡垒。掠夺者们比以往更忙碌了。突袭他们的营地之一。"]
	quest.164E2119278B4404.quest_subtitle: "可不是那种有趣的露营方式。"
	quest.164E2119278B4404.title: "地狱般的露营之旅"
	quest.166C9F0C27096D34.quest_desc: ["便携式结构容器将整辆车打包成一个物品。打包你的车，带到世界另一端，然后拆包。一次性容器用完即丢。"]
	quest.166C9F0C27096D34.quest_subtitle: "可以放进口袋里的大小。"
	quest.166C9F0C27096D34.title: "瓶中船"
	quest.166EE33A4C7BB157.quest_desc: ["在密封、未破损且富氧的舱内，重力发生器能让所有人正常活动和呼吸。建造一个像样的空间站，而不是一个铁罐头。"]
	quest.166EE33A4C7BB157.quest_subtitle: "星际穿越是对的。"
	quest.166EE33A4C7BB157.title: "人工重力"
	quest.1670024172C20904.quest_desc: ["任何攻击你的生物都会反受同等伤害。"]
	quest.1670024172C20904.quest_subtitle: "抱一抱它，就知道了答案。"
	quest.1670024172C20904.title: "最好不要去碰它，后果自负"
	quest.1673460AD5E2EF0E.quest_desc: ["烘焙师工作站是面团塑形之地：编织、擀开、填充和切割。擀面杖和面包刀是烘焙师的工具。"]
	quest.1673460AD5E2EF0E.quest_subtitle: "各就各位，准备，烘焙！"
	quest.1673460AD5E2EF0E.title: "英国烘焙大赛（The Great British Bake Off）"
	quest.16739B37823C2D2E.quest_desc: ["高岭土有多种颜色，可以烧制成高岭土砖。粉笔粉可以为其上色。"]
	quest.16739B37823C2D2E.quest_subtitle: "塑形，然后烧制。"
	quest.16739B37823C2D2E.title: "粘土的日子"
	quest.1679B06AFBFC0CAD.quest_desc: ["废墟堆标志着森林、沙漠、丛林和山脉中曾经存在过的地方。挖掘其中一个。"]
	quest.1679B06AFBFC0CAD.quest_subtitle: "这里到底发生了什么？"
	quest.1679B06AFBFC0CAD.title: "碎石破坏者"
	quest.1691336FF53C9BA3.quest_desc: ["红石中继器可在计算机的四周提供红石输入和输出，而无需将计算机本身放置在电路中央。"]
	quest.1691336FF53C9BA3.quest_subtitle: "信号，已处理完毕。"
	quest.1691336FF53C9BA3.title: "红石中继器"
	quest.16A033FFEB7B22D3.quest_desc: ["凯拉堡是一座山上的城堡，誓死捍卫到最后一块石头。攻陷城堡。"]
	quest.16A033FFEB7B22D3.quest_subtitle: "冬天就要来了。"
	quest.16A033FFEB7B22D3.title: "权力的游戏"
	quest.16B5FB94F443FA80.quest_desc: ["将苹果压成泥，然后发酵。左上角的苹果会自动变成果泥；中间的原料和瓶子能将果泥酿成烈酒。这里也是酿酒师的工作台。"]
	quest.16B5FB94F443FA80.quest_subtitle: "两项工作，一台机器。"
	quest.16B5FB94F443FA80.title: "苹果压榨机"
	quest.16B9B75C06BBCB2F.quest_desc: ["绳索梯子会自动向下展开，像脚手架一样，也可以从顶部卷回。非常适合用于峡谷、天坑和从深矿井返回时使用。"]
	quest.16B9B75C06BBCB2F.quest_subtitle: "或者至少得有个梯子才行。"
	quest.16B9B75C06BBCB2F.title: "长发公主，快放下你的长发"
	quest.16BA30C9C18B9219.quest_desc: ["流浪酿酒师会骑着骡子，带着稀有的瓶子从远方而来。去见他，看看他车上有什么吧。"]
	quest.16BA30C9C18B9219.quest_subtitle: "你试过这个吗？"
	quest.16BA30C9C18B9219.title: "旅行酿酒师"
	quest.170942EB9EEEC584.quest_desc: ["土豆箱、胡萝卜箱、卷心菜箱、番茄箱、洋葱箱、甜菜箱。把它们堆在地下室里。你一眼就能知道冬天的位置。"]
	quest.170942EB9EEEC584.quest_subtitle: "丰收的季节到了。"
	quest.170942EB9EEEC584.title: "一个完整的地下室"
	quest.17271D6127EA3DA0.quest_desc: [
		"一套完整的铁制盔甲能抵御僵尸，幸存于苦力怕的突袭，并让初次探索的深洞变得可控。"
		""
		"制作全部四件装备并穿戴上。时尚是其次，生存才是第一要务。"
	]
	quest.17271D6127EA3DA0.quest_subtitle: "每个英雄都需要一套战衣。"
	quest.17271D6127EA3DA0.subtitle: "再多一点自信就好了。"
	quest.17271D6127EA3DA0.title: "穿戴整齐"
	quest.173A85F5ED294C82.quest_desc: ["红石请求器在接收到红石信号时会发送固定订单。为您的厨房、燃料库或飞艇码头自动补货。"]
	quest.173A85F5ED294C82.quest_subtitle: "明天同一时间。"
	quest.173A85F5ED294C82.title: "Standing Order"
	quest.173EE74282F643E1.quest_desc: ["对接连接器成对创建刚性连接：将两艘飞船靠近，它们就会锁定。建造带有可分离穿梭机的母舰。"]
	quest.173EE74282F643E1.quest_subtitle: "保持平稳，继续前进。"
	quest.173EE74282F643E1.title: "对接程序"
	quest.174A4D5F8105B479.quest_desc: ["常见机器的电动版：电动风扇、电动泵和盆加热器，后者无需烈焰即可加热盆。加热线圈也能取暖。"]
	quest.174A4D5F8105B479.quest_subtitle: "不需要挖掘竖井。"
	quest.174A4D5F8105B479.title: "即插即用"
	quest.174B1B81EC9E9BF9.quest_desc: ["计数器、碗柜、烤箱和带管道的抽油烟机。将它们与 Prep Work 的烹饪台结合，你就能拥有一个值得炫耀的厨房。"]
	quest.174B1B81EC9E9BF9.quest_subtitle: "魔法发生的地方。"
	quest.174B1B81EC9E9BF9.title: "梦幻厨房"
	quest.1752CD88F176AE9F.quest_desc: ["烛光下不止有美食。玫瑰、情书、花环、首饰盒里的金戒指。浪漫也同样温馨。"]
	quest.1752CD88F176AE9F.quest_subtitle: "我环顾四周的每一个角落。"
	quest.1752CD88F176AE9F.title: "空气中弥漫着爱意"
	quest.175A914F337AEE07.quest_desc: ["水果树遍布Farbound：苹果、梨、桃子、无花果、柠檬、芒果、荔枝、柿子等等。找到一棵果树，取一棵树苗，种下你果园里的第一棵树。"]
	quest.175A914F337AEE07.quest_subtitle: "一天一个苹果，医生远离我。"
	quest.175A914F337AEE07.title: "我眼中的挚爱 (Apple of My Eye)"
	quest.1785593EA7C86B1D.quest_desc: ["探险家罗盘会搜寻你选择的任何结构，并指向最近的。选定目标，跟随指针。"]
	quest.1785593EA7C86B1D.quest_subtitle: "向右数第二颗星星的位置。"
	quest.1785593EA7C86B1D.title: "指引我正确的方向"
	quest.17A7AE5445205A27.quest_desc: ["CC:C Bridge 将计算机与 Create 连接。Source 和 Target 方块允许显示链接读写计算机，而 Scroller 方块则读取 Create 的值输入。"]
	quest.17A7AE5445205A27.quest_subtitle: "两个世界，一根线缆。"
	quest.17A7AE5445205A27.title: "桥梁建造师"
	quest.17A9D783916CB74E.quest_desc: ["征兆是带有温和祝福的护身符。绿色征兆有时会加倍作物掉落。智者吊坠、月向戒指和海沫护身符能保护佩戴者。"]
	quest.17A9D783916CB74E.quest_subtitle: "好兆头。"
	quest.17A9D783916CB74E.title: "阅读告示牌上的信息"
	quest.17C60D3492A45BBB.quest_desc: ["装满食物的储藏室意味着要穿越许多土地。 Rooibos 生长在稀树草原，yerba mate 在丛林，咖啡则在温暖湿润的地方。找到这些野生植物，把整排货架带回家。"]
	quest.17C60D3492A45BBB.quest_subtitle: "世界会提供所需的一切。"
	quest.17C60D3492A45BBB.title: "采集之旅"
	quest.17D480D6941668C1.quest_desc: ["火星有它自己的金属：desh、赤铁矿、siderite 和 tridymite。开采它们，熔炼成地球上从未有过的锭。"]
	quest.17D480D6941668C1.quest_subtitle: "用科学的方法彻底研究一下这个。"
	quest.17D480D6941668C1.title: "火星人"
	quest.17EF33C3F5909C8C.quest_desc: ["去参观三大奇观：天空岛屿、火山、大峡谷、黄石公园或月光林。世界很美好。别忘了偶尔抬起头看看机器以外的风景。"]
	quest.17EF33C3F5909C8C.quest_subtitle: "大自然界的奇妙之处。"
	quest.17EF33C3F5909C8C.title: "国家地理杂志"
	quest.17F024FF5B5F7D3C.quest_desc: ["在末地的某个地方，有一片从天花板生长的森林。仰起头，穿过这片倒立森林吧。"]
	quest.17F024FF5B5F7D3C.quest_subtitle: "欢迎来到颠倒的世界。"
	quest.17F024FF5B5F7D3C.title: "怪奇物语 (Stranger Things)"
	quest.18114E0B705A8E79.quest_desc: ["股票行情显示器会显示你网络中的所有物品，并允许你订购物品。将工人坐在旁边以运行计数器（燃烧器中的烈焰人是经典的收银员），你的包裹就会运送到你这里。"]
	quest.18114E0B705A8E79.quest_subtitle: "你的仓库，一键即达。"
	quest.18114E0B705A8E79.title: "订单已送达！"
	quest.1818A4896E689E13.quest_desc: ["小炖锅负责咸味菜肴：六种食材，一个热源，三十秒。要是队伍排得长，它还能出奇地灵活。"]
	quest.1818A4896E689E13.quest_subtitle: "而且它还能当武器来用。"
	quest.1818A4896E689E13.title: "今日特供汤品"
	quest.181E4E1204F910DC.quest_desc: ["设拉子宫殿在沙漠阳光下闪耀，满是黄金和守卫。"]
	quest.181E4E1204F910DC.quest_subtitle: "一个全新的世界。"
	quest.181E4E1204F910DC.title: "阿拉伯之夜"
	quest.182E2D298532DA48.quest_desc: ["一口就能填饱肚子，而且在你再次感到饥饿之前它就会重新长出来。"]
	quest.182E2D298532DA48.quest_subtitle: "我知道这块牛排不是真的。无知是福。"
	quest.182E2D298532DA48.title: "Steak Forever"
	quest.183835F07C30A911.quest_desc: ["泥土、沙子和砾石在你的手下瞬间分离。"]
	quest.183835F07C30A911.quest_subtitle: "挖洞，再挖深一点。"
	quest.183835F07C30A911.title: "挖掘速度提升模组（Dig Faster）"
	quest.18425F2E7756DD6E.quest_desc: [
		"宝石矿石在这里不会掉落纯净宝石。钻石、祖母绿和青金石矿石会产出需要打磨的原石和碎片。"
		""
		"开采任意宝石矿石并收集原宝石。接下来是抛光。"
	]
	quest.18425F2E7756DD6E.quest_subtitle: "打磨它，它就会闪闪发光。"
	quest.18425F2E7756DD6E.title: "未经雕琢的钻石"
	quest.1843D22CEB998030.quest_desc: ["农场的田地里种着大麦、燕麦、玉米、生菜、草莓等等。每种作物在世界的某个角落都有野生版本，等待着你去发现。"]
	quest.1843D22CEB998030.quest_subtitle: "为了这片广袤的天空。"
	quest.1843D22CEB998030.title: "琥珀色的麦浪"
	quest.1884C59C86658508.quest_desc: ["罐子可随身携带流体，也可用于装置中。油桶能时尚地储存燃料。非常适合在远离家乡的地方为车辆加油。"]
	quest.1884C59C86658508.quest_subtitle: "永远不要让自己陷入干涸的境地。"
	quest.1884C59C86658508.title: "便携式油桶"
	quest.1895B132086A71C9.quest_desc: [
		"漏斗将物品送入传送带并推入存储。安山岩按手过滤，黄铜按物品过滤。"
		"建造两个层级。"
	]
	quest.1895B132086A71C9.subtitle: "物品就在你需要的时候出现在你身边。"
	quest.1895B132086A71C9.title: "漏斗"
	quest.18980A1157007A79.quest_desc: ["多种图案的步道、铺路石和石板：人字形、鱼骨纹、蜂巢、菱形。从门口铺一条路到马路上。"]
	quest.18980A1157007A79.quest_subtitle: "跟着它走。"
	quest.18980A1157007A79.title: "黄色砖块路"
	quest.18AB0B031C3F2F03.subtitle: "最顶级的合金。"
	quest.18B8130627281799.quest_desc: ["有些建筑需要完整着陆。Dungeons Arise 将世界填满城堡、塔楼和足以让你迷失其中的废墟。找到一个，探索每一层。"]
	quest.18B8130627281799.subtitle: "值得为此而降落的理由。"
	quest.18B8130627281799.title: "地标建筑"
	quest.18CF8FAF407420BE.quest_desc: ["草莓、甜浆果、发光浆果、苹果和巧克力酱可在小烹饪锅中制作。可涂在面包上、卷成酥皮点心、或填入挞皮中。"]
	quest.18CF8FAF407420BE.quest_subtitle: "香甜可口，易于涂抹。"
	quest.18CF8FAF407420BE.title: "果酱已装瓶"
	quest.18D01207C062F728.quest_desc: ["每种木材都有传动轴和齿轮。桦木小屋配桦木传动系统，樱桃林里有樱桃磨坊：机器就该待在属于它的地方。"]
	quest.18D01207C062F728.quest_subtitle: "你快来看这个，太棒了。"
	quest.18D01207C062F728.title: "自然选择"
	quest.18D033CAE20A6451.quest_desc: ["转动摄像头，给自己拍张照片。在你最棒的建筑、飞船或朋友面前摆个姿势。"]
	quest.18D033CAE20A6451.quest_subtitle: "The Chainsmokers 表示赞同。"
	quest.18D033CAE20A6451.title: "不过在此之前，先让我自拍一张吧"
	quest.18D98EA3BAA70BCA.quest_desc: ["货运集装箱是外观逼真的巨型储物方块。把它们堆在港口、绑在飞艇上，或者装满一列火车。物流从未如此真实。"]
	quest.18D98EA3BAA70BCA.quest_subtitle: "二十英尺当量单位。"
	quest.18D98EA3BAA70BCA.title: "把它运走"
	quest.190F83E783CF0C94.quest_desc: [
		"体积显示会读取周围的地形并将其投影为全息影像。输入旋转越快，显示的细节越多。上方的透镜会放大投影，下方的透镜则会缩小投影。"
		""
		"飞艇驾驶台上的全息地图桌：告诉我，这绝对是你建过的最酷的东西。"
	]
	quest.190F83E783CF0C94.quest_subtitle: "你是我唯一的希望。"
	quest.190F83E783CF0C94.title: "救命，欧比旺·克诺比先生"
	quest.191A40FFF7807D32.quest_desc: ["全速奔跑，水面会像实地一样支撑住你的体重。"]
	quest.191A40FFF7807D32.quest_subtitle: "在水上行走，无需任何奇迹。"
	quest.191A40FFF7807D32.title: "水之奔跑者"
	quest.191DDE679590FD2F.quest_desc: ["床上的捕梦网赶走噩梦，香炉让房间充满甜烟，蜡烛骷髅照亮女巫巢穴。"]
	quest.191DDE679590FD2F.quest_subtitle: "抓住那些坏家伙们。"
	quest.191DDE679590FD2F.title: "做个好梦"
	quest.192FD63DB911FE33.quest_desc: ["肥料可将农田变为肥沃农田，加速生长。堆肥箱的堆肥可为其施肥。洒水器可保持整片田地湿润。"]
	quest.192FD63DB911FE33.quest_subtitle: "给土壤施肥。"
	quest.192FD63DB911FE33.title: "肥沃的土地"
	quest.193E0BF888B1219F.quest_desc: ["大地会记住一切。经常走同一条路，足迹便会自然地在草地上显现，无需铁锹。你的世界会慢慢记录下你真实的生活轨迹。"]
	quest.193E0BF888B1219F.quest_subtitle: "用你的脚步将它召唤出来。"
	quest.193E0BF888B1219F.title: "欲望小径 (Desire Paths)"
	quest.1940D5460D06A08A.quest_desc: ["农场菜单朴实又美味：匈牙利烩菜、洋葱汤、烤肉配土豆、酿鸡。烹饪两道农场经典菜肴。"]
	quest.1940D5460D06A08A.quest_subtitle: "就像奶奶以前做的那样一样。"
	quest.1940D5460D06A08A.title: "家常便饭烹饪法"
	quest.1952C8B14446474C.quest_desc: ["蜜蜂慷慨的日子，有苹果酒、苹果汁、樱桃酒和蜂蜜酒。果园对葡萄园的回答，从来没人抱怨过苹果汁太多。"]
	quest.1952C8B14446474C.quest_subtitle: "瓶子里的秋天。"
	quest.1952C8B14446474C.title: "苹果酒的季节"
	quest.19535C57A21FFE00.quest_desc: ["骑马长途跋涉：穿过森林，翻过山丘，渡过河流。有些旅程，策马奔腾比巡航飞行更胜一筹。"]
	quest.19535C57A21FFE00.quest_subtitle: "期待着我们再次相遇的那一天。"
	quest.19535C57A21FFE00.title: "一路顺风"
	quest.1970C33169F43875.quest_desc: ["电解器通过轴上的交流发电机将水分解为氧气。氧气扩散器则为舱内提供可呼吸的空气。没有它们，长潜就是短潜。"]
	quest.1970C33169F43875.quest_subtitle: "空气，清新的空气。"
	quest.1970C33169F43875.title: "深呼吸"
	quest.19818CCB7E80F20C.quest_desc: ["幽暗森林是一片昏暗的森林，里面有光雾和幽暗苔晶。带回一些幽暗木材。"]
	quest.19818CCB7E80F20C.quest_subtitle: "黑暗而诡异。"
	quest.19818CCB7E80F20C.title: "忧郁的星期日"
	quest.1981C0ECC6062D76.quest_desc: ["苹果压榨机可将葡萄和苹果压榨成汁。这是制作每一瓶饮料的第一步。"]
	quest.1981C0ECC6062D76.quest_subtitle: "跺脚，跺脚，跺脚。"
	quest.1981C0ECC6062D76.title: "压榨这一天"
	quest.198EE806F5B4D54D.quest_desc: ["将可可、糖和牛奶在搅拌机中融化，得到液态巧克力。将其灌入管道、装入瓶子，或浇在一切事物上。巧克力浆浆果和巧克力棒将从生产线产出。"]
	quest.198EE806F5B4D54D.quest_subtitle: "跟我来，你就会看到的。"
	quest.198EE806F5B4D54D.title: "威利·旺卡的巧克力工厂"
	quest.199FF7EFDAA0FD38.quest_desc: ["钢缆横跨船坞，船上的制停钩能让船只迅速停稳。滑轮和岩石切割轮则构成了重型造船厂的完整套件。"]
	quest.199FF7EFDAA0FD38.quest_subtitle: "被缆绳抓住了。"
	quest.199FF7EFDAA0FD38.title: "逮捕装备"
	quest.19C7E1DF74C0FA72.quest_desc: ["火山口和山峰冒着火山灰和玄武岩的烟。从一个安全的高度，去参观一个火山口。"]
	quest.19C7E1DF74C0FA72.quest_subtitle: "Johnny Cash 会来拜访你。"
	quest.19C7E1DF74C0FA72.title: "火焰戒指"
	quest.19C8424019F0605D.quest_desc: ["体积轴上的控制器可移动投影：偏航旋转，俯仰倾斜，平移X和Z则将采样区域在地图上滑动。长焦扩展、亮度增强和色彩滤镜可调节图像。"]
	quest.19C8424019F0605D.quest_subtitle: "平移、倾斜、旋转。"
	quest.19C8424019F0605D.title: "全景与扫描"
	quest.19CA6B5DBA1E3C79.quest_desc: ["高级计算机有彩色屏幕和鼠标支持，你的程序可以添加按钮和菜单。镀金设计，更讨人喜欢。"]
	quest.19CA6B5DBA1E3C79.quest_subtitle: "升级完成"
	quest.19CA6B5DBA1E3C79.title: "升级完成"
	quest.19E12F49CC7CEAC9.quest_desc: ["大炮是铸造的，而非合成的。铸铁是第一种大炮金属：将铁熔化并倒入模具。铸造沙塑造模具，用带熔炉盖的加热盆熔化金属。"]
	quest.19E12F49CC7CEAC9.quest_subtitle: "快跑到山丘上去避难。"
	quest.19E12F49CC7CEAC9.title: "钢铁处女座"
	quest.19F7C175BBC06E19.quest_desc: [
		"Farbound 有真实的货币。Spurs、Bevels、Sprockets、Cogs、Crowns 和 Suns，从小额零钱到巨额财富。货币可通过合约、交易和宝藏获得，并在其他玩家经营的商店中花费。"
		""
		"准备好你的第一枚硬币。"
	]
	quest.19F7C175BBC06E19.quest_subtitle: "杰瑞·麦奎尔会为此感到自豪。"
	quest.19F7C175BBC06E19.title: "快把金币交出来！"
	quest.1A081FAE343DD5FC.quest_desc: ["春卷香脆可口，轻便易分享。在飞艇甲板上为下一次派对做些春卷吧。"]
	quest.1A081FAE343DD5FC.quest_subtitle: "外表酥脆可口。"
	quest.1A081FAE343DD5FC.title: "春季嬉戏"
	quest.1A583415968E0DAE.quest_desc: ["在某个地方，有一张专为飞行而生的唱片。在云端滑过时，把它放到你的飞艇留声机上播放吧。"]
	quest.1A583415968E0DAE.quest_subtitle: "天空中的音乐。"
	quest.1A583415968E0DAE.title: "云端领航员"
	quest.1A60EC027A4189E7.quest_desc: ["葡萄藤需要支撑。将它们种在格子上或葡萄藤盆中，它们会随生长而攀爬。给予它们阳光和时间。"]
	quest.1A60EC027A4189E7.quest_subtitle: "快长大吧，小藤蔓。"
	quest.1A60EC027A4189E7.title: "Trellis 训练课程"
	quest.1A70CCD2FEDC8B80.quest_desc: ["骆驼能驮着两个骑手穿越沙漠，还能跨越缝隙。找一个吧，最好手里有鞍子。有些沙漠里还有它们阴森的亡灵同类。"]
	quest.1A70CCD2FEDC8B80.quest_subtitle: "两个驼峰，两个骑手。"
	quest.1A70CCD2FEDC8B80.title: "沙漠之舟"
	quest.1A7503ECD367410A.quest_desc: ["金属框架的窗户、网格围栏、铁栅栏和锁门。锁门只能用红石打开，非常适合用作保险库和秘密机库。"]
	quest.1A7503ECD367410A.quest_subtitle: "橱窗购物"
	quest.1A7503ECD367410A.title: "橱窗购物"
	quest.1A7AA0BB06750904.quest_desc: ["电阻器、二极管、晶体管、继电器和电位器是每个电路的基本组件。收集一个小零件盒。"]
	quest.1A7AA0BB06750904.quest_subtitle: "零零碎碎的物品"
	quest.1A7AA0BB06750904.title: "零零碎碎的物品"
	quest.1AA882A910C10B0B.quest_desc: ["跟随藏宝图找到埋藏的宝藏并将其挖掘。海之心是每位水手梦寐以求的奖品。"]
	quest.1AA882A910C10B0B.quest_subtitle: "海盗们！集合！"
	quest.1AA882A910C10B0B.title: "X 标记着地点"
	quest.1ABF67CD3F7183E8.quest_subtitle: "云层之上，有东西在等待着你。"
	quest.1ABF67CD3F7183E8.title: "通往天堂的阶梯"
	quest.1AC1C1FA3C5FBB3C.quest_desc: ["优雅而迅捷，坚固程度正如名字所暗示的那样。"]
	quest.1AC1C1FA3C5FBB3C.quest_subtitle: "如果靴子合适的话。"
	quest.1AC1C1FA3C5FBB3C.title: "一个玻璃靴子"
	quest.1AC783511A2497E0.quest_desc: [
		"Farbound 中的电力是真实的电路模拟：电压、电流、电阻，应有尽有。你无需工程学学位即可上手，但会在此过程中学到很多。"
		""
		"基本思路：发电机将旋转转化为电能，电线传输电能，设备使用电能。万用表能告诉你任意一点的状况。多用 Ponder 吧。"
	]
	quest.1AC783511A2497E0.quest_subtitle: "弗兰肯斯坦过得真容易。"
	quest.1AC783511A2497E0.title: "它还活着！"
	quest.1AC90E6FBCC3F152.quest_desc: ["流体管道输送液体，机械泵推动其流动。流体储罐用于大量储存。水、岩浆、蜂蜜、巧克力：任何液体都以相同方式流动。"]
	quest.1AC90E6FBCC3F152.quest_subtitle: "马里奥会感到宾至如归。"
	quest.1AC90E6FBCC3F152.title: "管道工程入门 101"
	quest.1ACC5EB9EACF202C.quest_desc: ["海洋纪念碑是充满守卫和海绵房间的广阔水下神殿。如果你敢，就把它排干吧。"]
	quest.1ACC5EB9EACF202C.quest_subtitle: "深海的守护者。"
	quest.1ACC5EB9EACF202C.title: "深渊在注视着你"
	quest.1AEA92B1CC6D553C.quest_desc: ["雪地里某个地方，藏着一张适合寒冷季节的音乐唱片。在篝火旁播放它吧。"]
	quest.1AEA92B1CC6D553C.quest_subtitle: "一首适合雪夜聆听的歌曲。"
	quest.1AEA92B1CC6D553C.title: "冬季魔法"
	quest.1AEF6403819903BB.quest_desc: ["{@pagebreak}"]
	quest.1AFBA4FB1DD3EA29.quest_desc: ["机械伺服和步进伺服能将红石转化为精确的角度。襟翼、舵和炮塔都能精确移动到你想要的距离。陀螺仪能始终辨别方向。"]
	quest.1AFBA4FB1DD3EA29.quest_subtitle: "精确到小数点后一位。"
	quest.1AFBA4FB1DD3EA29.title: "伺服电机"
	quest.1B03D666527935CA.quest_desc: ["Redrouter 让你能控制每个面的红石，而 Animatronic 是一个可编程的小人，能按指令摆姿势。建造一个会说话的店主吧。"]
	quest.1B03D666527935CA.quest_subtitle: "每一面都可以编程控制。"
	quest.1B03D666527935CA.title: "信号路由器"
	quest.1B10345723FC0789.quest_desc: ["鱼钩决定咬钩的对象。倒刺能留住即将溜走的目标，发光鱼钩能钓起深水区的生物，磁性鱼钩能将金属从海底吸起，而神秘鱼钩则会吸引一些你可能会后悔捕获的东西。合成这套装备吧。"]
	quest.1B10345723FC0789.quest_subtitle: "五个钩子，五个任务。"
	quest.1B10345723FC0789.title: "正确的钩子（The Right Hook）"
	quest.1B16DB5074E52891.quest_desc: ["酿造第一杯啤酒，用合适的杯子享用。小麦啤酒、大麦啤酒、啤酒花啤酒：每种谷物都有其独特的风味。"]
	quest.1B16DB5074E52891.quest_subtitle: "干杯，干杯，为了这愉快的时光！"
	quest.1B16DB5074E52891.title: "干杯！"
	quest.1B186B11D8DADD19.quest_desc: ["钛矿石深埋地下。粉碎它，冶炼它，你就能得到一种能承受发射高温的轻便坚固金属。"]
	quest.1B186B11D8DADD19.quest_subtitle: "我是钛金属。"
	quest.1B186B11D8DADD19.title: "钛合金"
	quest.1B2D0564896AF005.quest_desc: ["烤培根三明治、三文鱼三明治、蔬菜三明治和果酱三明治。新鲜出炉，现做现卖。"]
	quest.1B2D0564896AF005.quest_subtitle: "拿着蛋黄酱，别动。"
	quest.1B2D0564896AF005.title: "三明治店"
	quest.1B2E00BC3E83CC10.quest_desc: ["岩石海岸的贻贝，在火上烤熟。简单而咸香，就像大海一样。"]
	quest.1B2E00BC3E83CC10.quest_subtitle: "比利时海滩美食。"
	quest.1B2E00BC3E83CC10.title: "法式炸薯条配蛤蜊浓汤"
	quest.1B353CB43EBC8112.quest_desc: [
		"用漏斗、机械臂和部署器自动喂食烹饪锅或煎锅，你不在家时饭菜也能煮熟。烈焰燃烧器也能加热烹饪锅。"
		""
		"设置一条自动化烹饪生产线。"
	]
	quest.1B353CB43EBC8112.quest_subtitle: "任何人都可以烹饪。"
	quest.1B353CB43EBC8112.title: "Ratatouille"
	quest.1B3CC9A511735404.quest_desc: [
		"工程师护目镜能显示网络承受的压力和每台机器的使用情况。它们有独立的面部槽位，可以搭配任何帽子佩戴。"
		""
		"再也不要盲目建造了。"
	]
	quest.1B3CC9A511735404.quest_subtitle: "工程师能看到别人忽略的细节。"
	quest.1B3CC9A511735404.title: "保持整洁仪容仪表，注意个人形象"
	quest.1B595731399065A2.quest_desc: ["留些玉米种子来种植。玉米能为饮品增添一丝柔和的甜味。"]
	quest.1B595731399065A2.quest_subtitle: "香甜而金黄。"
	quest.1B595731399065A2.title: "黄金种子"
	quest.1B6B87BEF66C914A.quest_desc: ["岩浆太珍贵，不能只用一次。在尖滴石下放置炼药锅，岩浆会一滴一滴地将其再次填满。可持续的岩浆来源，再也不用去岩浆湖了。"]
	quest.1B6B87BEF66C914A.quest_subtitle: "可再生、可靠、无情。"
	quest.1B6B87BEF66C914A.subtitle: "可再生、可靠、无情。"
	quest.1B6B87BEF66C914A.title: "一滴熔岩"
	quest.1B877D6C5C3815AD.quest_desc: ["装饰台重制了箱子和桶：木材组合、染料、完全自定义外观，内容物不受影响。仓库终于可以融入建筑了。"]
	quest.1B877D6C5C3815AD.quest_subtitle: "储物空间，但请打造成你自己的风格。"
	quest.1B877D6C5C3815AD.title: "焕然一新的外套"
	quest.1B9427AE71DD06CB.quest_desc: ["深色橡木可以制作木板、横梁、地板、全套家具，甚至还有船。用它来建造你的酿酒厂吧。"]
	quest.1B9427AE71DD06CB.quest_subtitle: "丰富、深色的谷物纹理。"
	quest.1B9427AE71DD06CB.title: "深色橡木制品工坊"
	quest.1B9F4A24BDC928A0.quest_desc: ["太阳能电池板将日光转化为电流。太阳能电池板轴承可使其追踪天空中的太阳，以获得更高的发电量。干净、安静，放在屋顶上也很美观。"]
	quest.1B9F4A24BDC928A0.quest_subtitle: "而我认为这完全没问题，没有任何问题。"
	quest.1B9F4A24BDC928A0.title: "太阳出来了，快来看！"
	quest.1BABAB690F97B0BB.quest_desc: ["榴莲是世界上最让人争议的水果。它带刺的外壳甚至可以做成头盔。它的气味会招来敌人。"]
	quest.1BABAB690F97B0BB.quest_subtitle: "闻起来像天堂，或者恰恰相反。"
	quest.1BABAB690F97B0BB.title: "水果之王"
	quest.1BD6EC434322B986.quest_desc: ["在人类之前，有卫星。建造一颗斯普特尼克卫星并发射上去。它没什么用，但能在轨道上运行。"]
	quest.1BD6EC434322B986.quest_subtitle: "哔。哔。哔。"
	quest.1BD6EC434322B986.title: "斯普特尼克"
	quest.1BECD9CCB5D0ECBA.quest_desc: ["园艺师的房屋遍布各个气候区，里面种满了植物、种子和园艺工具。去参观一座，获取灵感吧。"]
	quest.1BECD9CCB5D0ECBA.quest_subtitle: "植物也是有感情的生物。"
	quest.1BECD9CCB5D0ECBA.title: "植物学家"
	quest.1BFC8D5D9749915F.quest_desc: ["铽板和高频镀层是未来机器的外壳。纯化的铽块用于最精密的部件。"]
	quest.1BFC8D5D9749915F.quest_subtitle: "经过完美调试的配方。"
	quest.1BFC8D5D9749915F.title: "高频振荡器"
	quest.1C0649CC98979C81.quest_desc: ["末影贝来自末地，能奏出你前所未闻的最低音。一种为奇曲而生的奇妙乐器。"]
	quest.1C0649CC98979C81.quest_subtitle: "没有三度音程的旋律。"
	quest.1C0649CC98979C81.title: "关于低音的一切 (All About That Bass)"
	quest.1C1779674107507F.quest_desc: ["Package Frogport 是一种能抓取传送带上包裹并放入下方物品栏，或将包裹抛上传送带的青蛙。没错，是青蛙。它是史上最好的物流方块，谁也说服不了我们。"]
	quest.1C1779674107507F.quest_subtitle: "青蛙手里拿着包裹。"
	quest.1C1779674107507F.title: "青蛙快线"
	quest.1C1CCC3A7B4237AD.quest_desc: ["潜行者在末地城市守卫，会射出漂浮的子弹。击败几只，获取它们的壳，也就是潜行箱的材料。"]
	quest.1C1CCC3A7B4237AD.quest_subtitle: "不由自主地漂浮起来。"
	quest.1C1CCC3A7B4237AD.subtitle: "轻装上阵，携带一切所需。"
	quest.1C1CCC3A7B4237AD.title: "贝壳冲击"
	quest.1C23810C5485E614.quest_desc: ["自然罗盘对生物群系也适用。想要樱花林、沙漠绿洲还是蘑菇岛？搜索、跟随、抵达。"]
	quest.1C23810C5485E614.quest_subtitle: "克里斯托弗·麦坎德利斯选择了最艰难的道路。"
	quest.1C23810C5485E614.title: "走进荒野"
	quest.1C322A8C07C22AC5.quest_desc: ["椒盐脆饼、香肠、猪肘、半只鸡、饺子和土豆沙拉。没有它们，啤酒馆就不完整。"]
	quest.1C322A8C07C22AC5.quest_subtitle: "一切都围绕着香肠展开。"
	quest.1C322A8C07C22AC5.title: "Wurst 案例情景模拟"
	quest.1C4324BFE681564D.quest_desc: ["美西螈生活在繁茂的洞穴中，能帮你在水下战斗。用一桶水把它们带回家吧，它们是出色的水族馆居民。"]
	quest.1C4324BFE681564D.quest_subtitle: "永远保持微笑。"
	quest.1C4324BFE681564D.title: "笑一笑，小家伙（Smile, Little Guy）"
	quest.1C4604D52F7F7411.quest_desc: ["皇冠可是大价钱。攒一个，你就能买得起其他玩家卖的几乎所有东西。"]
	quest.1C4604D52F7F7411.quest_subtitle: "头戴王冠的那位。"
	quest.1C4604D52F7F7411.title: "头重脚轻，行动不便"
	quest.1C4EAA61CA776E45.quest_desc: ["松露藏在旧森林的土壤下，合适的动物能嗅出它们。一小块松露能让任何菜肴都变得奢华。"]
	quest.1C4EAA61CA776E45.quest_subtitle: "嘿，你们好啊！"
	quest.1C4EAA61CA776E45.title: "松露大乱斗"
	quest.1C683B49C1B975CF.quest_desc: ["打火机可以点燃火焰和蜡烛，还有许多皮肤可供收集。化学喷雾器可以喷洒从水到火的各种液体，锤子和模具则有助于塑造金属板。"]
	quest.1C683B49C1B975CF.quest_subtitle: "点击，拨动，火焰。"
	quest.1C683B49C1B975CF.title: "有火把吗？"
	quest.1C7B392C00CF8393.quest_desc: ["带支架的木桶和木桶框架，还有灰烬砖、石板砖和砾石砖。一个温馨村庄的旧世界建筑材料。"]
	quest.1C7B392C00CF8393.quest_subtitle: "老派的建筑风格。"
	quest.1C7B392C00CF8393.title: "Wattle and Daub"
	quest.1C7F29034F877846.quest_desc: ["带框架、百叶窗、百叶帘、女儿墙和窗帘杆的窗户。窗户装好，房子才算完工。"]
	quest.1C7F29034F877846.quest_subtitle: "小心点，注意四周。"
	quest.1C7F29034F877846.title: "通往灵魂的窗口"
	quest.1C9182E46F3543D3.quest_desc: ["紫藤树上挂满了紫色、蓝色、粉色和白色的花朵。种下紫藤树苗，看着藤蔓生长吧。"]
	quest.1C9182E46F3543D3.quest_subtitle: "王子批准了。"
	quest.1C9182E46F3543D3.title: "紫色雨滴"
	quest.1C9C5ECE034FFB15.quest_desc: ["动能电池储存旋转动能，并在之后释放。白天用水轮为其充电，在机器需要爆发动力时使用。小型离网建筑和小型船只的必备品。"]
	quest.1C9C5ECE034FFB15.quest_subtitle: "存储的旋转，可随需释放。"
	quest.1C9C5ECE034FFB15.title: "转动它，让它转起来"
	quest.1C9D8695B71EE594.quest_desc: ["装满沙子的桶，建造一座沙堡。贝壳和海星装饰得十分漂亮。"]
	quest.1C9D8695B71EE594.quest_subtitle: "建造来被水流冲走的。"
	quest.1C9D8695B71EE594.title: "沙堡城堡 (Castles in the Sand)"
	quest.1CF327DF2DF8FB56.quest_desc: ["纯净偶像可以移除附魔物品的诅咒。地牢宝箱里的那件被诅咒的盔甲终于可以穿上了。"]
	quest.1CF327DF2DF8FB56.quest_subtitle: "纯粹的心意。"
	quest.1CF327DF2DF8FB56.title: "解除诅咒"
	quest.1D060C45E0FC2522.quest_desc: ["矿车和铁轨是最古老的陆地交通工具。铺上一小段动力铁轨，来一场旅行吧。它缓慢，它迷人，而这仅仅是个开始。"]
	quest.1D060C45E0FC2522.quest_subtitle: "整整一天，没完没了地忙碌着。"
	quest.1D060C45E0FC2522.title: "正在修建铁路中"
	quest.1D07F2E4203A4DEC.quest_desc: ["掠夺者学会了飞行。掠夺者飞船和气球在空中巡逻。勇敢的话，就来空中搭乘一艘吧。"]
	quest.1D07F2E4203A4DEC.quest_subtitle: "长了翅膀的掠夺者。太棒了。"
	quest.1D07F2E4203A4DEC.title: "天空海盗"
	quest.1D0FC5E7DB762FFB.quest_desc: ["炉灶可以烹饪放在上面的食物，并为上方的任何锅具加热。它是每个厨房的核心。建造一个并点燃它。"]
	quest.1D0FC5E7DB762FFB.quest_subtitle: "用燃气烹饪。好吧，用木头烹饪。"
	quest.1D0FC5E7DB762FFB.title: "滚烫的东西"
	quest.1D1A50101F8398C2.quest_desc: [
		"马是不需要齿轮的第一种交通工具。骑上它直到它停止挣扎，然后给它装上鞍子即可驯服。"
		""
		"这里的马有真实的品种，每种都有自己的优势。先找任何一匹马开始吧。"
	]
	quest.1D1A50101F8398C2.quest_subtitle: "在沙漠中，你可以记住你的名字。"
	quest.1D1A50101F8398C2.title: "一匹没有名字的马"
	quest.1D2923F0388F1116.quest_desc: ["牛、山羊、绵羊、水牛、谷物、扭曲菌，还有那个理论上不该用却能用起来的紫水晶。架子上有七个轮子，最后两个需要你下界一趟，外加一头非常困惑的牛。"]
	quest.1D2923F0388F1116.quest_subtitle: "每一滴牛奶，每一个车轮。"
	quest.1D2923F0388F1116.title: "七轮 (Seven Wheels)"
	quest.1D32635F18133CF6.quest_desc: ["悬挂履带和驱动轮为车辆提供履带。使用悬挂键调整悬挂。坦克、推土机和爬行车都适用。"]
	quest.1D32635F18133CF6.quest_subtitle: "雷声滚滚，电闪雷鸣。"
	quest.1D32635F18133CF6.title: "坦克履带"
	quest.1D35C22525B9CF39.quest_desc: ["恶魂会吐出火球，岩浆怪在玄武岩三角洲中弹跳，迅捷兽在熔岩上行走，猪灵则在绯红森林中冲锋。与它们一一相遇吧。"]
	quest.1D35C22525B9CF39.quest_subtitle: "热门公司。"
	quest.1D35C22525B9CF39.title: "无间道 Infernal Affairs"
	quest.1D528BB2753C8994.quest_desc: ["在某个地方，岛屿漂浮在陆地之上，瀑布从边缘倾泻而下。只有飞船（或大量脚手架）才能带你到达那里。"]
	quest.1D528BB2753C8994.quest_subtitle: "拉普达是真实存在的。"
	quest.1D528BB2753C8994.title: "天空中的城堡"
	quest.1D6CC908094BFC02.quest_desc: ["沙滩帽、太阳镜、泳裤或比基尼，还有洞洞鞋。是的，洞洞鞋。为阳光做好准备。"]
	quest.1D6CC908094BFC02.quest_subtitle: "黄色波点比基尼。"
	quest.1D6CC908094BFC02.title: "Itsy Bitsy Teenie Weenie"
	quest.1D6F2FEA47B56BA9.quest_desc: ["果园水果茶：芒果茶、山竹茶、黑莓茶和荔枝樱桃茶。夏日午后，清爽解渴。"]
	quest.1D6F2FEA47B56BA9.quest_subtitle: "甜美而明亮。"
	quest.1D6F2FEA47B56BA9.title: "水果酿造配方"
	quest.1D73C0451C97FB8F.quest_desc: ["吸盘发射器会发射一个吸盘，利用背罐的空气抓住模拟装置，让你可以移动它们。弹簧则用有弹性的连接件将两个方块连起来。"]
	quest.1D73C0451C97FB8F.quest_subtitle: "史莱姆！"
	quest.1D73C0451C97FB8F.title: "吸盘（Suction Cup）"
	quest.1D756939366E726B.quest_desc: ["建造一辆按时运输货物的火车：在矿井装载，在工厂卸载，无限循环。站台上的便携式存储接口可实现自动装载。"]
	quest.1D756939366E726B.quest_subtitle: "货运火车，货运火车，跑得真快。"
	quest.1D756939366E726B.title: "货运列车"
	quest.1D825BC1DA383D63.quest_desc: ["火箭推进器是将你推出天空的引擎。引擎喷嘴塑造火焰，引擎管道输送燃料，流体软管则将燃料从储罐中输送过来。"]
	quest.1D825BC1DA383D63.quest_subtitle: "哦，等等。还真是的。"
	quest.1D825BC1DA383D63.title: "这又不是什么火箭科学"
	quest.1D8D5C0CCC2B9556.quest_desc: ["椰子面包、椰子煎饼、芜菁塔吉锅和曼纳基什：来自世界温暖生物群系的美食。"]
	quest.1D8D5C0CCC2B9556.quest_subtitle: "把石灰放进椰子里。"
	quest.1D8D5C0CCC2B9556.title: "热带厨房"
	quest.1DA9B9ECC60DC3E3.quest_desc: ["采集者之桌与生物群系的野味：蓝莓、青苹果、丝兰果、奥德球茎和白蘑菇。收集一个采集者篮。"]
	quest.1DA9B9ECC60DC3E3.quest_subtitle: "大自然会给予我们所需的一切。"
	quest.1DA9B9ECC60DC3E3.title: "采集者（Forager）"
	quest.1DB04EDEDC1387C5.quest_desc: [
		"绳索是游戏中最被低估的方块。从悬崖向下放置，可以上下攀爬，或用滑轮拉动方块，还可以把船和动物系在围栏上。"
		""
		"你也可以射出绳索箭，让它们落地后垂下一条绳索。"
	]
	quest.1DB04EDEDC1387C5.quest_subtitle: "你可以爬这些。真的可以。"
	quest.1DB04EDEDC1387C5.title: "初学者的指南针校准指南"
	quest.1DB41F5D67BE8D53.quest_desc: ["每个酒庄都有自己的日常之选：能填满酒架、搭配晚餐、从不令人失望的佳酿。六个酒标，毫无花哨，皆是靠扎实的基本功赢得的。"]
	quest.1DB41F5D67BE8D53.quest_subtitle: "你实际出售的那些瓶子。"
	quest.1DB41F5D67BE8D53.title: "房屋选择 The House Selection"
	quest.1DBAF8AB4232B8B7.quest_desc: [
		"管风琴由一根根管组成。风箱为风管供风，键盘继电器连接琴键，而每排风管都有其独特的音色：大管、封闭音、主音、喇叭音、人声音等等。"
		""
		"建造一个风箱和第一批管道。"
	]
	quest.1DBAF8AB4232B8B7.quest_subtitle: "夜空的乐章。"
	quest.1DBAF8AB4232B8B7.title: "歌剧魅影 (Phantom of the Opera)"
	quest.1DD05BFFC9F8FFFF.quest_desc: ["带法兰齿轮、链条滑轮和飞轮轴承让你的传动系统更具重工业感。链条滑轮用链条提升重物，飞轮轴承则将大型飞轮变为特色组件。"]
	quest.1DD05BFFC9F8FFFF.quest_subtitle: "工业风潮，引领时尚。"
	quest.1DD05BFFC9F8FFFF.title: "法兰连接件升级包"
	quest.1DD86709DE667755.quest_desc: ["锡金矿石在基岩中发出金色光芒。用它制成的锭可以打造工具、盔甲、锻造炉、火盆、灯笼和锁链，让你的家充满下界风情。"]
	quest.1DD86709DE667755.quest_subtitle: "不是来自俄亥俄州的人。"
	quest.1DD86709DE667755.title: "辛辛纳砂岩"
	quest.1DDF614E0B1C79B2.quest_desc: ["烛光厨房设施齐全：石制、木制和砖制的炉灶、台面和洗碗槽，还有烹饪锅和炖锅，可制作精致菜肴。盘子和罩子用于盛放。"]
	quest.1DDF614E0B1C79B2.quest_subtitle: "烛光下的二人餐桌。"
	quest.1DDF614E0B1C79B2.title: "精致美食"
	quest.1DFD89B2B53E72C0.quest_desc: ["一张沙发，一张桌子，几把椅子和一些靠垫。客厅是一天结束的地方。建造一个吧。"]
	quest.1DFD89B2B53E72C0.quest_subtitle: "朋友们坐在沙发上。"
	quest.1DFD89B2B53E72C0.title: "客厅"
	quest.1DFEE82615E62C02.quest_desc: ["Shafts carry rotation in a straight line. The simplest way to move power."]
	quest.1DFEE82615E62C02.subtitle: "直线上的强大力量。"
	quest.1DFEE82615E62C02.title: "竖井"
	quest.1E06B76DA9DBBDE3.quest_desc: ["一座被自然缓慢吞噬的废弃小镇。仔细搜查房屋：一些老住户从未离开。"]
	quest.1E06B76DA9DBBDE3.quest_subtitle: "不包括翻滚的枯草（Tumbleweeds）在内。"
	quest.1E06B76DA9DBBDE3.title: "鬼城"
	quest.1E1A0963D4C9F72A.quest_desc: ["水稻生长在水中：种植在浅田中，深一块方块，它就会攀出水面。稻穗脱粒成米，可做成无数菜肴。"]
	quest.1E1A0963D4C9F72A.quest_subtitle: "冰爽宝贝，不过是淀粉味的。"
	quest.1E1A0963D4C9F72A.title: "稻米，小稻米宝宝"
	quest.1E28F9BC81BA7098.quest_desc: ["弗里斯兰马和安达卢西亚马这类战马从不惊跳，也从不后踢。安达卢西亚马甚至会为骑手挡下致命一击。忠诚的化身。"]
	quest.1E28F9BC81BA7098.quest_subtitle: "史蒂文·斯皮尔伯格为您呈现。"
	quest.1E28F9BC81BA7098.title: "战马（War Horse）"
	quest.1E2B0650DD4F62BA.quest_desc: ["用砂纸打磨的玫瑰石英，是逻辑电路和电子管的关键部件。"]
	quest.1E2B0650DD4F62BA.subtitle: "把它打磨得恰到好处。"
	quest.1E2B0650DD4F62BA.title: "石英"
	quest.1E2D6693C405B1C4.quest_desc: ["是的，你可以用土豆点亮灯泡。土豆电池是最小、最可爱的电源。建造一个，用导线连接到灯泡，然后看着它发光吧。"]
	quest.1E2D6693C405B1C4.quest_subtitle: "GLaDOS 批准了。"
	quest.1E2D6693C405B1C4.title: "土豆的力量"
	quest.1E5A691FECB0D68E.quest_desc: ["原油存在于特定区块的深层。油扫描仪会显示你脚下有多少油。四处走动，观察指针，找到富含原油的地方。"]
	quest.1E5A691FECB0D68E.quest_subtitle: "我喝掉你的奶昔！"
	quest.1E5A691FECB0D68E.title: "将有血光之灾"
	quest.1E63419C2A69D2BE.quest_desc: ["稀有葡萄酒是酿酒师的杰作：Noir、Solaris、Glowing Wine、Chorus Wine、Eiswein、Magnetic Wine 等等。每种都需要特殊材料。制作其中三种。"]
	quest.1E63419C2A69D2BE.quest_subtitle: "橡木与冒险的笔记。"
	quest.1E63419C2A69D2BE.title: "侍酒师"
	quest.1E711A262CAAA865.quest_desc: ["大麦麦芽是大多数啤酒的开端。这款也不例外。"]
	quest.1E711A262CAAA865.quest_subtitle: "中流砥柱。"
	quest.1E711A262CAAA865.title: "大麦"
	quest.1EA3A086E26FB191.quest_desc: [
		"盔甲并非唯一可修饰的物品。工具修饰能让你在锻造台上用模板，用任意修饰材料装饰稿子、剑和斧子。"
		""
		"在世界里的箱子里找到一个工具修饰模板，给你的最爱工具增添一点个性。"
	]
	quest.1EA3A086E26FB191.quest_subtitle: "Xzibit 批准了。"
	quest.1EA3A086E26FB191.title: "升级我的镐子模组任务书"
	quest.1EBCC1A591009604.quest_desc: ["市场中提供世界各地的取货点出售的商品。接受报价，飞往那里，并领取货物：用你的飞行器将整个集装箱拉出，打破它，或者手动清空。"]
	quest.1EBCC1A591009604.quest_subtitle: "华尔街之狼。"
	quest.1EBCC1A591009604.title: "低价买入，高价卖出"
	quest.1EBFBB9455491D67.quest_desc: [
		"这里的树有物理效果。砍断树干，整棵树就会连根带叶地倒下。最好离倒下的位置远点，不然你可能会收到一条很尴尬的重生提示。"
		"按住 Shift 可只砍倒单个原木。建造物附近要小心，相连的树木可能会把房子也带倒。"
	]
	quest.1EBFBB9455491D67.quest_subtitle: "如果一棵树在森林里倒下……"
	quest.1EBFBB9455491D67.subtitle: "一挥，一棵树。"
	quest.1EBFBB9455491D67.title: "伐木机启动！"
	quest.1EC791B322383CC2.quest_desc: [
		"本章所有内容都用于破坏。炮弹、自动炮、火箭、炸弹和地雷能摧毁方块、地形和整个建筑，且无法修复。"
		""
		"在共享世界中，只有在所有参与者事先同意的情况下，武器才算是公平竞赛。未经同意向他人的基地、船只或建筑开火，或为未参与战斗的玩家留下陷阱，都属于破坏行为。服务器规则在此处同样适用。"
		""
		"勾选框确认，然后点燃熔炉。"
	]
	quest.1EC791B322383CC2.quest_subtitle: "强大的火力伴随着巨大的责任而来。"
	quest.1EC791B322383CC2.title: "交战规则"
	quest.1ED9EAC07B594626.quest_desc: ["物品宝库是巨大的多方块储物箱，放置相邻时会合并。漏斗和手臂可以像普通箱子一样从中取物。"]
	quest.1ED9EAC07B594626.quest_subtitle: "又大又方，里面塞满了东西。"
	quest.1ED9EAC07B594626.title: "福特诺克斯堡垒"
	quest.1EDFB72FA78500EA.quest_desc: ["女巫植物在野外生长：曼德拉草、夜shade、鬼面纱、灵之花、梦蘑菇、太阳番茄等。收集三种不同的植物。"]
	quest.1EDFB72FA78500EA.quest_subtitle: "采集、晾干、使用。"
	quest.1EDFB72FA78500EA.title: "草本精粹"
	quest.1EE7B21911989963.quest_desc: ["几乎所有东西都有对应的箱子或袋子：苹果、浆果、鱼、种子、糖、火药、金胡萝卜。一面装满食物的墙壁，会让人感到温馨。"]
	quest.1EE7B21911989963.quest_subtitle: "整洁又美观。"
	quest.1EE7B21911989963.title: "食品储藏室目标"
	quest.1EF1B80DA93F70C9.quest_desc: ["Create 模组中所有物品的存储方块：压缩板、竖井、齿轮、矿石堆、面粉、面团和浆料。整洁的存储，整洁的思绪，而且其中一些在工业建筑中看起来很棒。"]
	quest.1EF1B80DA93F70C9.quest_subtitle: "把它打包得严严实实的。"
	quest.1EF1B80DA93F70C9.title: "挤压它"
	quest.1F13A6362028246D.quest_desc: ["铺好物品的桌布会变成股票行情机的商店柜台。顾客浏览、写下购物清单并在行情机付款。从你的仓库经营一个市场摊位。"]
	quest.1F13A6362028246D.quest_subtitle: "现在开始为顾客提供服务。"
	quest.1F13A6362028246D.title: "开业大吉"
	quest.1F17D3EFDAEB2DAF.quest_desc: ["有些菜肴值得点上蜡烛。千层面、惠灵顿牛排、菲力牛排、白葡萄酒三文鱼。烹饪些精致的菜肴，用真正的盘子盛上。"]
	quest.1F17D3EFDAEB2DAF.quest_subtitle: "《小姐与流浪汉》的意大利面场景。"
	quest.1F17D3EFDAEB2DAF.title: "烛光晚餐"
	quest.1F1825A8F5AAB5D2.quest_desc: ["茶树长出绿茶叶。晒干是红茶，半干是乌龙。一棵茶树，三种茶，享受不尽的午后时光。"]
	quest.1F1825A8F5AAB5D2.quest_subtitle: "哦，当然绝对是这样的了，毫无疑问。"
	quest.1F1825A8F5AAB5D2.title: "这不是我的菜 (Not My Cup of Tea)"
	quest.1F184DAFB181F81D.quest_desc: [
		"两个相互转动的粉碎轮，比磨石快得多，并且有更高的额外掉落率，能将落入其中的所有东西粉碎。从上方投入原矿，下方收集粉碎矿石、金块和经验。"
		""
		"这才是真正的矿石倍增器，它建造在机械合成器上。"
	]
	quest.1F184DAFB181F81D.quest_subtitle: "两个轮子，不留情面。"
	quest.1F184DAFB181F81D.title: "轻松搞定，毫无压力！"
	quest.1F1ED448CF7ACB3E.quest_desc: ["高感度胶片捕捉普通胶片错过的画面：洞穴、夜间飞行、下界内部。颗粒感更强，氛围更忧郁，有时这正是你想要的效果。"]
	quest.1F1ED448CF7ACB3E.quest_subtitle: "在黑暗中射击。"
	quest.1F1ED448CF7ACB3E.title: "高感度 ISO"
	quest.1F3FA2EE73B2E312.quest_desc: ["蜂蜜胶水能快速廉价地将方块附着到模拟装置上，是粘合船只的强力胶水友好替代品。两者结合可用于更复杂的建造。"]
	quest.1F3FA2EE73B2E312.quest_subtitle: "维尼·噗会赞同的。"
	quest.1F3FA2EE73B2E312.title: "棘手的情况"
	quest.1F562322EA5A48FA.quest_desc: ["采用老式游戏机与电脑风格拍摄的特殊影片：Game Boy、NES、CGA 和 C64。纯粹的像素怀旧风。"]
	quest.1F562322EA5A48FA.quest_subtitle: "按下开始键。"
	quest.1F562322EA5A48FA.title: "复古游戏玩家"
	quest.1F67DCA8BAF858C7.quest_desc: ["煎锅可以在篝火旁快速烹饪美食。"]
	quest.1F67DCA8BAF858C7.title: "煎锅（Skillet）"
	quest.1FA7740C28955A62.quest_desc: [
		"远行奖励好奇心。世界充满值得探索的地方：有酒馆的村庄、有故事的废墟、有首领的地牢、有宝藏的残骸，以及未能返航的飞空艇。"
		""
		"战利品是独立的：每个玩家都能在箱子里找到自己的战利品，这样就不会有人偷走先到者的宝藏了。带上食物、光源和床，出发吧。"
	]
	quest.1FA7740C28955A62.quest_subtitle: "托尔金知道。"
	quest.1FA7740C28955A62.title: "并非所有流浪者都迷失了方向"
	quest.1FB64E8A1B538FDA.quest_desc: ["升降台并非树上所生。它生长于现实边缘：末地石是万物飞翔的原材料。穿越过去，挖上一大堆，带回家。天空由末地的地板筑成。"]
	quest.1FB64E8A1B538FDA.quest_subtitle: "在世界的尽头开采所得。"
	quest.1FB64E8A1B538FDA.title: "苍白采石场"
	quest.1FB82CC1706471DC.quest_desc: ["奶酪需要凝乳酶来凝固牛奶。制作一些，然后将牛奶和凝乳酶放入奶酪模具中等待。"]
	quest.1FB82CC1706471DC.quest_subtitle: "凝乳和乳清。"
	quest.1FB82CC1706471DC.title: "秘密的配料 The Secret Ingredient"
	quest.1FBE1291208C707C.quest_desc: ["风笛、迪吉里杜、手碟和维埃拉带来了世界各地的声音。演奏其中两种。"]
	quest.1FBE1291208C707C.quest_subtitle: "来自地图的每一个角落。"
	quest.1FBE1291208C707C.title: "世界音乐"
	quest.1FC3875E88FB4FC0.quest_desc: [
		"泡泡机能让空气充满肥皂泡。毫无用处，却妙趣横生，而且还是个能气坏朋友的绝佳方法。"
		""
		"肥皂还能洗掉物品上的染料。真没想到。"
	]
	quest.1FC3875E88FB4FC0.quest_subtitle: "泡泡，泡泡，没烦恼。"
	quest.1FC3875E88FB4FC0.title: "Forever Blowing Bubbles"
	quest.1FD326CF856691EE.quest_desc: ["可配置齿轮箱可单独设置每个面：输入、输出、反转或关闭。输入停止时，自动离合器会自行接合。更少的方块，更多的控制。"]
	quest.1FD326CF856691EE.quest_subtitle: "每一面都可以，随你选择。"
	quest.1FD326CF856691EE.title: "配置模式"
	quest.1FE558ECEF108DFA.quest_desc: ["帝国只听命于直面过真正黑暗之人。击败下界的凋零和末地的末影龙，其余星系将臣服于你。"]
	quest.1FE558ECEF108DFA.quest_subtitle: "我们有饼干了。"
	quest.1FE558ECEF108DFA.title: "来加入黑暗一方吧"
	quest.1FEB54E6423B5FA8.quest_desc: ["机械工匠以网格排列，可自动合成任何形状的配方，包括精密机制。"]
	quest.1FEB54E6423B5FA8.subtitle: "无需动手，轻松合成。"
	quest.1FEB54E6423B5FA8.title: "工匠们"
	quest.200199F8CD45D3E1.quest_desc: ["飞行员们，火车头前端的犁头，由金属和抛光石制成。加上前灯和转向架台阶，你的火车就上路（轨道）就绪了。"]
	quest.200199F8CD45D3E1.quest_subtitle: "清理轨道上的障碍物。"
	quest.200199F8CD45D3E1.title: "牛群收集器"
	quest.2003B5E618C494E6.quest_desc: ["草莓、甜莓、发光莓、苹果、巧克力。果酱能完成蛋糕、填满糕点，还能在无人注意时涂在面包上。填满所有五个罐子。"]
	quest.2003B5E618C494E6.quest_subtitle: "五个罐子，五种颜色。"
	quest.2003B5E618C494E6.title: "Jam Session"
	quest.20100732E526305D.quest_desc: ["蘑菇只生长在稀有的蘑菇岛上。用碗挤奶，即可永久免费获得蘑菇浓汤。"]
	quest.20100732E526305D.quest_subtitle: "一头有蘑菇问题的牛。"
	quest.20100732E526305D.title: "有趣的家伙"
	quest.20100F918E76F803.quest_desc: ["每次挥舞都比以前多了一点送别的意味。"]
	quest.20100F918E76F803.quest_subtitle: "向着天空伸出手来，伙计。"
	quest.20100F918E76F803.title: "驾驾驾驾"
	quest.2013792FE4FC56B1.subtitle: "更锋利，更耐用。"
	quest.202DD15D1EF95F18.quest_desc: ["锦鲤、海兔、大耳八爪鱼。三种水生生物，最终都会出现在你书架的桶里。海兔甚至会留下可以装瓶的史莱姆。"]
	quest.202DD15D1EF95F18.quest_subtitle: "只要能装下，就能发货。"
	quest.202DD15D1EF95F18.title: "愿望清单 (Bucket List)"
	quest.2035E18BED74EEB8.quest_desc: ["沙滩球和沙滩球门能把任何海滩变成运动场。和朋友们来一场比赛吧。"]
	quest.2035E18BED74EEB8.quest_subtitle: "壮志凌云，排球比赛的那一幕。"
	quest.2035E18BED74EEB8.title: "沙滩排球"
	quest.204DC655070E1446.quest_desc: ["绿林酒馆是一家舒适的森林旅馆，浴场则是长途跋涉后泡澡的地方。找到其中一个即可。"]
	quest.204DC655070E1446.quest_subtitle: "在酒馆吃第二顿早餐。"
	quest.204DC655070E1446.title: "绿龙 The Green Dragon"
	quest.205D81BCC4636876.quest_desc: ["荨麻在冲泡中失去了刺痛感。剩下的则是辛辣、清新又出人意料。"]
	quest.205D81BCC4636876.quest_subtitle: "针头扎进去，却拔不出来。"
	quest.205D81BCC4636876.title: "荨麻（Nettle）"
	quest.2091BAA45DB5331C.quest_desc: ["扳手可以旋转方块，潜行点击机器即可立即拾取，并能配置模组的一半内容。它是工程师最常用的工具。"]
	quest.2091BAA45DB5331C.quest_subtitle: "所有东西都是可以调整的。"
	quest.2091BAA45DB5331C.title: "投掷一把扳手进去"
	quest.209A7214526C2E50.quest_desc: ["每个水手都从一艘简单的木船开始。在这里，船会在水面留下真实的航迹，划船时你可以自由环顾四周。去湖上试试，划一段相当长的距离。"]
	quest.209A7214526C2E50.quest_subtitle: "沿着溪流缓缓而下。"
	quest.209A7214526C2E50.title: "划船，划船，划你的船儿"
	quest.209C057CEDBF7071.quest_desc: [
		"Farbound 的地下比你记忆中更深、更奇特、更富饶。矿石会分解成粗糙宝石和原矿，洞穴拥有自己的生物群系，合适的工具能带来天壤之别。"
		""
		"带上火把、食物和镐，第一次前往 Y=0 以下。"
	]
	quest.209C057CEDBF7071.quest_subtitle: "儒勒·凡尔纳会为此感到自豪。"
	quest.209C057CEDBF7071.subtitle: "越往下走，情况越好。"
	quest.209C057CEDBF7071.title: "地心之旅"
	quest.20ED39192B7FE53B.quest_desc: ["船帆和对称船帆能在行驶的船上捕捉气流，可用作舵和稳定器。在陆地上，它们也是出色的风车。"]
	quest.20ED39192B7FE53B.quest_subtitle: "宝贝，和我一起扬帆起航吧。"
	quest.20ED39192B7FE53B.title: "扬帆远航"
	quest.212A24D8539123C3.quest_desc: [
		""
		"床能设置重生点，让你安然入睡。在Farbound，黑夜不会转瞬即逝：你睡着时时间会快进，一台打字机在每个新天亮起时报出日期。"
		""
		"三块羊毛和三板木板。在里面睡一觉，让世界知道家在哪里。"
	]
	quest.212A24D8539123C3.quest_subtitle: "睡觉是一种速通策略。"
	quest.212A24D8539123C3.title: "美梦由羊毛编织而成"
	quest.214B8F18DD3C1551.quest_desc: ["劫掠兽在袭击中冲锋陷阵，摧毁沿途的一切。击败一头，并在踩踏中幸存下来。"]
	quest.214B8F18DD3C1551.quest_subtitle: "来认识一下这个无法移动的物品。"
	quest.214B8F18DD3C1551.title: "势不可挡的力量"
	quest.216B7321FC0FF9D6.quest_desc: ["火车连接器可以连接和分离火车而无需拆卸。将其放置在选定轨道旁，用扳手设置间隙，选择连接、分离或两者，并用红石激活。前方的车站有助于对齐车厢。"]
	quest.216B7321FC0FF9D6.quest_subtitle: "有些火车，合在一起会更好。"
	quest.216B7321FC0FF9D6.title: "情侣治疗（Couples Therapy）"
	quest.217029D522F35EC7.quest_desc: ["工具交换器会为你击中的方块从背包中选择合适的工具。重新填充和补充升级能保持你的快捷栏始终满格。"]
	quest.217029D522F35EC7.quest_subtitle: "无需思考，直接交换。"
	quest.217029D522F35EC7.title: "合适的工具才能胜任工作"
	quest.2173545B2F26184C.quest_desc: ["高山牲畜对桶有意见：只有木头桶才够用。刻一套桶，然后去挤奶。每种动物都会装满自己种类的桶。"]
	quest.2173545B2F26184C.quest_subtitle: "金属的那个是不行的。"
	quest.2173545B2F26184C.title: "木制水桶"
	quest.21999E853F1A0800.quest_desc: ["柴油是让引擎轰鸣的燃料。用桶从炼油厂里装满柴油。"]
	quest.21999E853F1A0800.quest_subtitle: "轰隆隆。"
	quest.21999E853F1A0800.title: "柴油动力"
	quest.21A781D9A4BD7ADA.quest_desc: ["来自港口的鱼串和厚实的西班牙煎蛋饼，切成片。适合边走边吃的手抓食物。"]
	quest.21A781D9A4BD7ADA.quest_subtitle: "站着吃味道最好。"
	quest.21A781D9A4BD7ADA.title: "街头小吃"
	quest.21BF8D36CD025214.quest_desc: [
		"刀是整个章节的工具。它在砧板上切食材，收割稻草和树叶，并且能从燧石一直升级到下界合金。木制和石制刀作为起点就足够了。"
		""
		"制作任意一把刀并随身携带。"
	]
	quest.21BF8D36CD025214.quest_subtitle: "这是一把刀。"
	quest.21BF8D36CD025214.title: "那不是刀"
	quest.21C3BE7D90996919.quest_desc: ["长凳、桌子、吧台和花哨的地毯。建造一个啤酒馆，让你的朋友们在漫长的一天后能坐下来休息。"]
	quest.21C3BE7D90996919.quest_subtitle: "太棒了，终于完成了！"
	quest.21C3BE7D90996919.title: "啤酒节"
	quest.21DC9354808917AD.quest_desc: ["附魔森林会发出蓝绿色的光，它们的木头也会发光。带回其中一种的木头。"]
	quest.21DC9354808917AD.quest_subtitle: "踏入未知领域。"
	quest.21DC9354808917AD.title: "魔法森林"
	quest.21FB757F6AE640F3.quest_desc: ["凋零骷髅在堡垒中巡逻。它们的头骨很稀有，用三个头骨摆成T形放在灵魂沙上，就能召唤出可怕的东西。"]
	quest.21FB757F6AE640F3.quest_subtitle: "需要三个头颅。"
	quest.21FB757F6AE640F3.subtitle: "耐心终有回报。"
	quest.21FB757F6AE640F3.title: "猎头者 (Head Hunter)"
	quest.220918FD0840ED1C.quest_desc: ["掠夺者前哨遍布各地，风格各异。清理一处，解救其中的友好生物，并带一面旗帜回家。"]
	quest.220918FD0840ED1C.quest_subtitle: "注意弩手们的动向。"
	quest.220918FD0840ED1C.title: "前哨基地"
	quest.2221D2FAD423388F.quest_desc: ["苹果派、甜浆果芝士蛋糕、巧克力派、南瓜派。烤一个放在窗台上冷却。没人会偷的。大概吧。"]
	quest.2221D2FAD423388F.quest_subtitle: "再见了，美国派小姐。Bye bye, Miss American Pie."
	quest.2221D2FAD423388F.title: "美国派 (American Pie)"
	quest.225D58A4CAB57965.quest_desc: ["高级海龟拥有一个颜色终端。结合无线调制解调器，它能成为远程遥控的矿工，并向你汇报矿井情况。"]
	quest.225D58A4CAB57965.quest_subtitle: "英雄们在一个半壳中。"
	quest.225D58A4CAB57965.title: "忍者神龟"
	quest.225D7968A0DE5423.quest_desc: ["压榨红白葡萄汁和果园的苹果汁。果汁本身就很美味，但它还有更大的用途。"]
	quest.225D7968A0DE5423.quest_subtitle: "并非浓缩还原而成。"
	quest.225D7968A0DE5423.title: "新鲜榨取"
	quest.22600ABB160765B6.quest_desc: ["回声分叉能透过墙壁，在几秒内高亮显示范围内的所有生物。非常适合用来确认那个黑暗洞穴是否像看起来的那样空无一物。"]
	quest.22600ABB160765B6.quest_subtitle: "蝙蝠侠会批准的。"
	quest.22600ABB160765B6.title: "回声定位（Echolocation）"
	quest.226B286D4B1CBAA7.quest_desc: ["物品过滤器决定连接器将哪些物品送入哪个箱子。标签物品过滤器按标签分类，这样每种矿石都会进入矿石箱，每棵树苗都会进入花园箱，完全不需要漏斗。"]
	quest.226B286D4B1CBAA7.quest_subtitle: "最好还是……矿石宝箱吧！"
	quest.226B286D4B1CBAA7.title: "分院帽 Sorting Hat"
	quest.2275A179B40E9D48.quest_desc: ["卫道士挥舞着斧头，撞击力惊人。它们守卫着洋馆，并发起袭击。盾牌是你的朋友。"]
	quest.2275A179B40E9D48.quest_subtitle: "挥舞着斧头，怒气冲冲。"
	quest.2275A179B40E9D48.title: "约翰尼来了！"
	quest.227BEFC12AD710CC.quest_desc: ["附着在船只上的水下地雷会在生物或船只靠得太近时爆炸。是你潜艇基地的最后一道防线。"]
	quest.227BEFC12AD710CC.quest_subtitle: "不要撞到它身上。"
	quest.227BEFC12AD710CC.title: "深水炸弹"
	quest.228E320867DBABAD.quest_desc: ["苹果木呈温暖的玫瑰色，并提供全套组件：木板、横梁、瓦片、家具、一艘船，甚至还有烤苹果。"]
	quest.228E320867DBABAD.quest_subtitle: "甜美而粉嫩。"
	quest.228E320867DBABAD.title: "苹果木"
	quest.229A750E49923560.quest_desc: ["轨道转换开关会引导所有经过其标记的列车。选择一个轨道，在附近放置转换开关，然后使用它来向右切换，或潜行以向左切换。红石可以设置和锁定它，比较器可以读取其方向，而一箭射中也能使其翻转。"]
	quest.229A750E49923560.quest_subtitle: "向左、向右，或是直走都可以。"
	quest.229A750E49923560.title: "切换车道"
	quest.229C024768DA62B8.quest_desc: ["它能帮你喝药水，双手就能自由行动，随时准备惹事。"]
	quest.229C024768DA62B8.quest_subtitle: "原地不动的原因和解决方法。"
	quest.229C024768DA62B8.title: "免提操作"
	quest.22AFED0D9DEF21D5.quest_desc: ["蛤蜊躺在海底，里面藏着贵重物品。撬开一个，串起珍珠，戴上项链让别人都能看到。"]
	quest.22AFED0D9DEF21D5.quest_subtitle: "请小心地打开它。"
	quest.22AFED0D9DEF21D5.title: "潜水者之前的珍珠"
	quest.22D9E2F2232DE272.quest_desc: ["Interplanar Projector 会对照片做些很奇怪的事情。试试看就知道了。"]
	quest.22D9E2F2232DE272.quest_subtitle: "想象一下，在这个世界里的画面。"
	quest.22D9E2F2232DE272.title: "Interplanar Projector"
	quest.22EB606CE6384798.quest_desc: ["流体也可以通过包裹网络传输。Jar Packager 用铜罐从储罐中装填，Barrel Packager 处理更重的货物，两者都与其他包裹共用相同的链条和列车。"]
	quest.22EB606CE6384798.quest_subtitle: "箱子里的流体。"
	quest.22EB606CE6384798.title: "瓶装与运输"
	quest.22EBC6DC2FB3C83A.quest_desc: ["某些群系独有村庄：暗林的塞勒姆、高谷的斯凯里斯、红岩村，以及暖地的椰子和紫藤村。找到其中一个。"]
	quest.22EBC6DC2FB3C83A.quest_subtitle: "隐藏的社区。"
	quest.22EBC6DC2FB3C83A.title: "偏离常规路线的探索之旅"
	quest.2332D130E34789A7.quest_desc: ["花茶温和芬芳：木槿、薰衣草、路易波士和玛黛茶。找到野生植物，种植它们，并冲泡三种不同的草本茶。"]
	quest.2332D130E34789A7.quest_subtitle: "大自然母亲最清楚一切。"
	quest.2332D130E34789A7.title: "草药疗法"
	quest.23556955F0BC9511.quest_desc: ["用桨手动划船前进，无需引擎。简单、可靠，非常适合小船。"]
	quest.23556955F0BC9511.quest_subtitle: "快挥剑！快挥剑！"
	quest.23556955F0BC9511.title: "齐心协力"
	quest.2364E36C5FA390B0.quest_desc: ["草本瓶装有真实效果的药水：防护、力量、野性。在坩埚中酿造一瓶，带上你的下一次探险之旅。"]
	quest.2364E36C5FA390B0.quest_subtitle: "为了赶路用的东西。"
	quest.2364E36C5FA390B0.title: "便携酒壶"
	quest.2373AD1580DAED0E.quest_desc: ["为你的酒吧顶层货架收集三种不同的威士忌。"]
	quest.2373AD1580DAED0E.quest_subtitle: "只有好东西才能留下。"
	quest.2373AD1580DAED0E.title: "顶层货架"
	quest.239431E3EBC0B030.quest_desc: ["火车控制器让你可以驾驶。把它放在驾驶室里，坐下，然后按前进键。火车无需转向或燃料即可运行。火车中的烈焰燃烧器在加入燃料后，会为其提供速度加成。"]
	quest.239431E3EBC0B030.quest_subtitle: "我想我能行，我想我能行的。"
	quest.239431E3EBC0B030.title: "小火车头大能量"
	quest.23A169A5653C752B.quest_desc: ["在 Farbound 中，计算机由 Create 机器制造的集成电路构成。将青金石压成薄片，然后组装电路。EMI 会显示完整的装配线。"]
	quest.23A169A5653C752B.quest_subtitle: "快速移动，制作物品。"
	quest.23A169A5653C752B.title: "硅谷"
	quest.23A3C655571279A4.quest_desc: ["Sophisticated Chests and Barrels 比普通箱子容量更大，且支持背包的相同升级。使用铜、铁、金、钻石、下界合金等等级升级组件，可原地升级。"]
	quest.23A3C655571279A4.quest_subtitle: "永远不要跳过这个步骤。"
	quest.23A3C655571279A4.title: "宝箱日"
	quest.23B36D6DC170E32D.quest_desc: ["列车长由安山岩外壳和列车长帽组成，是位小助手。列车长会乘坐你的火车，携带工具箱，并为你按下按钮或拨动拉杆。列车长会共享帽子颜色：不同颜色的列车长会互相忽略。"]
	quest.23B36D6DC170E32D.quest_subtitle: "而她根本不在乎。"
	quest.23B36D6DC170E32D.title: "车票之旅"
	quest.23DFE88D659DE3A1.quest_desc: ["松树覆盖着高山斜坡。它们的木材可以制作全套乡村风格的家具：长凳、沙发、梳妆台、衣柜、百叶窗和奶酪架。"]
	quest.23DFE88D659DE3A1.quest_subtitle: "山间木材。"
	quest.23DFE88D659DE3A1.title: "为我而思（Pine for Me）"
	quest.23E7AECE5D479113.quest_desc: ["驾驶你自己的汽车从一个村庄到另一个村庄，如果你喜欢，可以铺设自己的道路。沥青能让旅途快得多。"]
	quest.23E7AECE5D479113.quest_subtitle: "我们快到了吗？"
	quest.23E7AECE5D479113.title: "公路旅行"
	quest.23FA67E8D4141CB1.quest_desc: ["毛皮靴、毛皮大衣、毛皮帽和毛皮长裤能让你在高海拔地区保持温暖，在山区徒步或寒冷飞行时看起来也十分棒。"]
	quest.23FA67E8D4141CB1.quest_subtitle: "穿上了适合寒冷的衣物。"
	quest.23FA67E8D4141CB1.title: "穿上了适合寒冷的衣物。"
	quest.243DD7D9A4757406.quest_desc: ["带工作台矿车让你边骑边造，带唱片机矿车则为你带来音乐。长途旅行的小小慰藉。"]
	quest.243DD7D9A4757406.quest_subtitle: "在轨道上进行合成。"
	quest.243DD7D9A4757406.title: "餐车车厢"
	quest.2455B04A437A86F4.quest_desc: ["建造祭坛，见证凋零在黑色风暴中崛起。远离家园击败它，夺取下界之星。"]
	quest.2455B04A437A86F4.quest_subtitle: "世界的毁灭者。"
	quest.2455B04A437A86F4.subtitle: "最伟大的战斗，最伟大的回报。"
	quest.2455B04A437A86F4.title: "凋零者"
	quest.247AE8953020098C.quest_desc: ["传感器将飞行数据转化为红石。高度传感器读取高度，速度传感器读取速度，陀螺传感器读取倾斜。将它们连接到燃烧器和螺旋桨，用红石制作自动驾驶仪。"]
	quest.247AE8953020098C.quest_subtitle: "一切按部就班地进行飞行。"
	quest.247AE8953020098C.title: "乐器飞行任务书文本"
	quest.2506D872D750A418.quest_desc: ["绿茶、红茶、乌龙、洛神、薰衣草、路易波士、马黛茶。然后是咖啡，黑咖啡和拿铁。九杯茶，一个架子，没借口。"]
	quest.2506D872D750A418.quest_subtitle: "书架上的每一片叶子。"
	quest.2506D872D750A418.title: "完整菜单"
	quest.250983E0DFB6940F.quest_desc: ["下界合金傀儡是你能建造的 toughest 傀儡。它会毫不留情地守卫你的基地。建造一个成本高昂，但物超所值。"]
	quest.250983E0DFB6940F.quest_subtitle: "它们之中最强大的一个。"
	quest.250983E0DFB6940F.title: "重型打击者"
	quest.254CE956BD7834B8.quest_desc: ["合成、石匠和锻造升级将工作站放入背包。冶炼升级让你边走边烹饪。"]
	quest.254CE956BD7834B8.quest_subtitle: "随时随地进行合成。"
	quest.254CE956BD7834B8.title: "背負在工作坊"
	quest.255259FCA67CC39F.quest_desc: ["钥匙锁定的门和锁块只能由持有匹配钥匙的人打开。在砧上命名钥匙使其独一无二。"]
	quest.255259FCA67CC39F.quest_subtitle: "说吧，朋友，然后进来吧。"
	quest.255259FCA67CC39F.title: "锁与钥匙"
	quest.25529FAF81A807EF.quest_desc: ["草药人的小屋坐落在森林和沼泽中。找一个吧：草药人知识渊博，花园里也满是种子。"]
	quest.25529FAF81A807EF.quest_subtitle: "森林中的智慧长者。"
	quest.25529FAF81A807EF.title: "草药学家"
	quest.25534FFECAB882D4.quest_desc: ["号角响亮而自豪。用嘹亮的号角声宣告你的飞艇到来。"]
	quest.25534FFECAB882D4.quest_subtitle: "吹嘘一下自己取得的成就吧。"
	quest.25534FFECAB882D4.title: "黄铜部件"
	quest.25C20F26FAA52B69.quest_desc: ["鸡会下蛋，掉落羽毛制作箭和羽毛笔，而且样子滑稽。不同地区的鸡会下不同颜色的蛋。"]
	quest.25C20F26FAA52B69.quest_subtitle: "为了前往另一个任务地点。"
	quest.25C20F26FAA52B69.title: "鸡为什么要过马路？Why Did the Chicken Cross the Road?"
	quest.25F7FEB8391A72BC.quest_desc: ["酿造你的第一瓶女巫药水。家园酿造带你回家，日光酿造点亮黑夜，史莱姆行走酿造让你弹跳，还有许多更多。"]
	quest.25F7FEB8391A72BC.quest_subtitle: "我需要你最强大的药水。"
	quest.25F7FEB8391A72BC.title: "药水商人"
	quest.261748CB90CA5194.quest_desc: ["雷暴期间，闪电有时会召唤出有骑手的骷髅马。击败骑手，马匹就归你驯服了。"]
	quest.261748CB90CA5194.quest_subtitle: "太棒了，万岁万岁。"
	quest.261748CB90CA5194.title: "天空中的幽灵骑士"
	quest.261B7BCD5D5DF20A.quest_desc: ["火箭弹、穿甲弹和集束弹药构成了完整的武器库。装填火箭舱，让齐射飞起来吧。"]
	quest.261B7BCD5D5DF20A.quest_subtitle: "一个人在这里点燃引线，等待着爆炸。"
	quest.261B7BCD5D5DF20A.title: "火箭人"
	quest.26558B2DF0AC4D3A.quest_desc: ["矿石直接从岩石中产出，并且已经熔炼成成品锭。"]
	quest.26558B2DF0AC4D3A.quest_subtitle: "现在你正在用火焰进行挖掘。"
	quest.26558B2DF0AC4D3A.title: "在上升途中进行冶炼"
	quest.26583C101943DDA5.quest_desc: ["发电机是一个多方块结构：发电机外壳、由旋转驱动的感应转子，以及收集电流的换向器。用水轮、风车或蒸汽机为其提供旋转动力，你的电网就能运转起来。"]
	quest.26583C101943DDA5.quest_subtitle: "发电站"
	quest.26583C101943DDA5.title: "发电站"
	quest.266C0F23624E9425.quest_desc: ["安山岩、黄铜、铜、铁和工业铁制成的猫道、楼梯和栏杆。铺在机器上，让你能走在工厂地板上而不会踩到传送带。"]
	quest.266C0F23624E9425.quest_subtitle: "我时刻紧盯着这颗属于我的心不放。"
	quest.266C0F23624E9425.title: "沿着线走"
	quest.266E1B28A82F8780.quest_desc: ["音符方块在通电时会发出音符，其下方的方块决定了乐器。用中继器将它们串联起来，就能演奏出完整的旋律。"]
	quest.266E1B28A82F8780.quest_subtitle: "哆来咪。"
	quest.266E1B28A82F8780.title: "逐条笔记记录"
	quest.2690BEBDF3031C15.quest_desc: ["集成电路可部署在兼容设备上，为它们提供有限次数的性能提升。小芯片，大升级。"]
	quest.2690BEBDF3031C15.quest_subtitle: "更强的力量。更强大的力量。"
	quest.2690BEBDF3031C15.title: "超频运行 (Overclocked)"
	quest.269213799029D251.quest_desc: ["Alternator将旋转转化为可存储和传输的能量。用电力机器连接Create模组。"]
	quest.269213799029D251.subtitle: "旋转转化为电能。"
	quest.269213799029D251.title: "生成"
	quest.269B48FEE9E38A2F.quest_desc: ["安山漏斗将物品从物品栏移至传送带上，再放回去。隧道将物品分配到平行的传送带上。滑槽将物品直接向上或向下移动。"]
	quest.269B48FEE9E38A2F.quest_subtitle: "物品放进去，物品就出来了。"
	quest.269B48FEE9E38A2F.title: "漏斗视野"
	quest.269FC2459CBA2306.quest_desc: ["饺子是装有肉和蔬菜的小面团。用锅煮一批，或在煎锅里煎得金黄酥脆。"]
	quest.269FC2459CBA2306.quest_subtitle: "捏一捏，折一折，烤一烤。"
	quest.269FC2459CBA2306.title: "饺子帮"
	quest.26EEAF3FD4487B41.quest_desc: ["甜点之前：每日的面包。可颂、法棍、吐司、小圆面包、脆皮面包、辫子面包，还有最初的那个普通面包。把整篮都烤了。"]
	quest.26EEAF3FD4487B41.quest_subtitle: "七个面包，一个烤箱。"
	quest.26EEAF3FD4487B41.title: "面包和黄油"
	quest.26F826F25480617A.quest_desc: [
		"打包机将物品栏内容装箱，并开箱送达的包裹。每个包裹都标有地址，系统据此判断归属。"
		""
		"这就是创造物流网络的开端：用箱子代替随处可见的传送带。"
	]
	quest.26F826F25480617A.quest_subtitle: "只要能装下，就能发货。"
	quest.26F826F25480617A.title: "需要一些组装才能完成"
	quest.270678BE30702E45.quest_desc: ["背包能装的东西比口袋多得多，而且可以在专属槽位穿戴。注意：死亡后背包会留在原地，但里面的物品会洒落在你倒下的地方。制作你的第一个背包。"]
	quest.270678BE30702E45.quest_subtitle: "还有，你以后都别再回来了，听见了吗。"
	quest.270678BE30702E45.title: "杰克，上路吧（Hit the Road, Jack）"
	quest.27413F0A7BF2E2D0.quest_desc: ["Storage Controller 将所有相连的复杂箱子和桶链接为一个库存。Storage Connector 可将网络延伸至整个房间。"]
	quest.27413F0A7BF2E2D0.quest_subtitle: "一个终端，统御所有终端。"
	quest.27413F0A7BF2E2D0.title: "中央指挥部"
	quest.27436E0ACA623049.quest_desc: ["麻袋是一种可携带或放置的便携储物箱。装得越多，移动越慢，所以把它当移动箱子，而不是背包。"]
	quest.27436E0ACA623049.quest_subtitle: "他列了清单，又检查了两遍。"
	quest.27436E0ACA623049.title: "圣诞老人要进城了"
	quest.275FA17103506F3A.quest_desc: ["抽油机由轴承、曲柄、抽油头和油藏上的孔洞组成。用旋转驱动它，就能源源不断地从地下抽出原油。"]
	quest.275FA17103506F3A.quest_subtitle: "点头的驴子，永远在点头。"
	quest.275FA17103506F3A.title: "Pump It Up"
	quest.2761FE2A796BAAE0.quest_desc: ["有了模板和锭，将你的钻石装备升级为下界合金。这是普通世界能提供的最坚固的一套装备。"]
	quest.2761FE2A796BAAE0.quest_subtitle: "主世界能给出的最坚固的一套装备。"
	quest.2761FE2A796BAAE0.subtitle: "主世界能给出的最坚固的一套装备。"
	quest.2761FE2A796BAAE0.title: "最强套装 The Strongest Set"
	quest.276D884C5D7EA79B.quest_desc: [
		"饥饿是无声的敌人。烹饪肉类、烘焙面包，或是从灌木丛中采摘浆果，只要你的肚子保持饱足就好。"
		""
		"后面的章节会把食物发展成一门独立的工艺。但现在，任何热的东西都算数。"
	]
	quest.276D884C5D7EA79B.quest_subtitle: "十一点茶点呢？午餐呢？下午茶呢？"
	quest.276D884C5D7EA79B.title: "第二顿早餐"
	quest.2786346814945350.quest_desc: ["吸烟站用不同木材熏制食物。每种木材都会增添不同的效果：更高的饱食度、额外的营养、治疗效果，甚至是药水效果。不妨试试橡木、樱桃木和世界各地的奇木材。"]
	quest.2786346814945350.quest_subtitle: "低空慢速飞行。"
	quest.2786346814945350.title: "烟雾信号"
	quest.2794BE55E68779F5.quest_desc: ["逐渐淡出这个世界，让打击毫无阻碍地穿过你。"]
	quest.2794BE55E68779F5.quest_subtitle: "你打算叫谁来帮忙呢？"
	quest.2794BE55E68779F5.title: "一半在这里"
	quest.27AC8088344B0AFC.quest_desc: ["发酵桶能将果汁变成葡萄酒。装满果汁和酒瓶，然后等待。好酒需要时间。"]
	quest.27AC8088344B0AFC.quest_subtitle: "耐心的泡泡。"
	quest.27AC8088344B0AFC.title: "发酵站"
	quest.27E23078A9CE8E39.subtitle: "石头根本没有任何胜算可言。"
	quest.27E9F7CB38535C5E.quest_desc: ["装饰性的桶、箱子和篮子，看起来装满了苹果、煤炭、鱼或钻石，而且真的能储物。有了它们，市场摊位和地窖都变得生动起来。"]
	quest.27E9F7CB38535C5E.quest_subtitle: "看看所有这些好东西。"
	quest.27E9F7CB38535C5E.title: "仓储战争"
	quest.27FE83CD10A9040A.quest_desc: ["大炮是铸造的，而非合成的。铸铁是第一种大炮金属：将铁熔化并倒入模具。铸造沙塑造模具，用带熔炉盖的加热盆熔化金属。"]
	quest.27FE83CD10A9040A.quest_subtitle: "快跑到山丘上去避难。"
	quest.27FE83CD10A9040A.title: "钢铁处女座"
	quest.2809368DD0340312.quest_desc: ["蒸汽口用锅炉的蒸汽而非热空气来填充气球。如果你的船已有蒸汽机，蒸汽口就能用同一动力提供升力。"]
	quest.2809368DD0340312.quest_subtitle: "黄铜、蒸汽与态度。"
	quest.2809368DD0340312.title: "蒸汽朋克"
	quest.282142E10FA0EFB5.quest_desc: ["将烈焰棒碾成粉末，先要三个。它能加热酿造台、坩埚和创造机器。"]
	quest.282142E10FA0EFB5.quest_subtitle: "一点即能产生巨大效果。"
	quest.282142E10FA0EFB5.subtitle: "一点即能产生巨大效果。"
	quest.282142E10FA0EFB5.title: "一撮的粉末"
	quest.2821E769AFF95694.quest_desc: ["发光鱿鱼生活在黑暗的水下洞穴中，会掉落能点亮告示牌和物品展示框的发光墨囊。"]
	quest.2821E769AFF95694.quest_subtitle: "闪闪发光，熠熠生辉。"
	quest.2821E769AFF95694.title: "发光鱿鱼游戏"
	quest.2875A1319A9BE8AE.quest_desc: ["手柄可以附着在任何方块上，让你能牢牢抓住。从此，攀爬移动船只的船舷再也不会那么危险了。"]
	quest.2875A1319A9BE8AE.quest_subtitle: "请把手保持在车辆内部。"
	quest.2875A1319A9BE8AE.title: "抓紧了，要稳住了"
	quest.287DFCB1C3BFA5E7.quest_desc: ["末影连接器能将两个储物空间在任何距离下绑定。你的飞艇货舱和家用仓库，从此相连。"]
	quest.287DFCB1C3BFA5E7.quest_subtitle: "诡异的隔空作用力。"
	quest.287DFCB1C3BFA5E7.title: "虫洞"
	quest.28837CC11B8AFFD3.quest_desc: ["部署器能自动使用工具和物品。自动化工作的得力助手。"]
	quest.28837CC11B8AFFD3.subtitle: "自动化的得力助手。"
	quest.28837CC11B8AFFD3.title: "部署器"
	quest.288FAB3AB656BD38.quest_desc: ["你的第一块奶酪。放置、切片、分享。切成片用于三明治和挞。"]
	quest.288FAB3AB656BD38.quest_subtitle: "把它展开来。"
	quest.288FAB3AB656BD38.title: "奶酪转盘"
	quest.2899CEFBC3633EA9.quest_desc: ["油漆有三十多种颜色，从纯黑到酒红、赭石和皇家蓝。用油漆杯携带，然后用油漆刷在原处就能重新上色你的机车。"]
	quest.2899CEFBC3633EA9.quest_subtitle: "再也没有颜色了。"
	quest.2899CEFBC3633EA9.title: "涂成黑色"
	quest.28D69D14D64516D5.quest_desc: ["你击中的任何东西都会由内而外地开始腐烂。"]
	quest.28D69D14D64516D5.quest_subtitle: "你触碰的一切都会化为尘埃。"
	quest.28D69D14D64516D5.title: "被诅咒的握柄"
	quest.28E4B0435BDF10A2.quest_desc: ["智能螺旋桨调整桨叶角度以尽量朝上，使直升机和无人机更容易保持水平。"]
	quest.28E4B0435BDF10A2.quest_subtitle: "它知道哪边是上边。"
	quest.28E4B0435BDF10A2.title: "智能螺旋桨"
	quest.28F185A64562AC45.quest_desc: [
		"铜线、绝缘线、铁线和金线用于在连接器之间传输电流。电线连接器可连接到方块上，而电线切割器可干净地移除电线。"
		""
		"制作一卷电线和几个连接器。"
	]
	quest.28F185A64562AC45.quest_subtitle: "将点与点连接起来。"
	quest.28F185A64562AC45.title: "有线的"
	quest.293449396B5586C2.quest_desc: ["船只各有船员，乘风破浪：海盗小艇、海盗船、胜利号护卫舰，还有传奇独角兽大帆船。登船夺取战利品。"]
	quest.293449396B5586C2.quest_subtitle: "为什么朗姆酒总是喝完了以后才想起来？"
	quest.293449396B5586C2.title: "加勒比海盗"
	quest.293FA90CC61449E8.quest_desc: ["缰绳能将动物固定在围栏准备好之前。牛、猪、鸡。把它们养在身边，食物就不会短缺。"]
	quest.293FA90CC61449E8.quest_subtitle: "动物是最好的农民。"
	quest.293FA90CC61449E8.title: "被拴绳牵引着，无法自由行动。"
	quest.296A4E7F7D616F3E.quest_desc: ["马铠有皮革、铜、铅、铁、金、钻石和下界合金之分。在骑马冒险前，先保护好你的好朋友。"]
	quest.296A4E7F7D616F3E.quest_subtitle: "冲啊！"
	quest.296A4E7F7D616F3E.title: "身披闪亮盔甲的骑士"
	quest.2974B4458460680F.quest_desc: ["成功的狩猎会为你赢得一面奖杯：鹿头、野牛头骨或灵狐。每个小屋都需要一个。"]
	quest.2974B4458460680F.quest_subtitle: "把它挂在墙上。"
	quest.2974B4458460680F.title: "奖杯猎人"
	quest.297A2127028BEDF7.quest_desc: ["酒精测试仪会告诉你现在是否应该驾驶那艘飞艇。答案通常是否定的。"]
	quest.297A2127028BEDF7.quest_subtitle: "请勿在飞行时饮用任何饮品。"
	quest.297A2127028BEDF7.title: "指定司机"
	quest.297AFF34164F76B4.quest_desc: [
		"箭袋可在一个栏位中存放多组不同类型的箭。滚动选择弓箭下一次发射的箭矢类型。"
		""
		"骷髅有时会掉落，部分宝箱也会。找到一个或制作一个，就能腾出半个背包的空间。"
	]
	quest.297AFF34164F76B4.quest_subtitle: "箭应该放在箭袋里，而不是口袋里。"
	quest.297AFF34164F76B4.title: "箭袋与木材的奇妙组合"
	quest.29808C4A381A68DB.quest_desc: ["机械钻头能破坏前方的方块。单独使用时是鹅卵石生成器，装在移动装置上就成了隧道钻探机。"]
	quest.29808C4A381A68DB.quest_subtitle: "我们深入地下探险吧。"
	quest.29808C4A381A68DB.title: "钻头宝贝钻头"
	quest.299C995BCCD1691D.quest_desc: ["将钢锭压成钢板。钢板可用于制作板甲、船体，并出现在后续工程章节的众多配方中。"]
	quest.299C995BCCD1691D.quest_subtitle: "平坦的世界也很美。"
	quest.299C995BCCD1691D.title: "金属薄片"
	quest.29EE6079878DE527.quest_desc: ["青铜大炮比铸铁更轻，能承受更强的火药装填。熔炼青铜，铸造零件，升级你的炮台。"]
	quest.29EE6079878DE527.quest_subtitle: "更轻便，更帅气。"
	quest.29EE6079878DE527.title: "青铜时代战争"
	quest.2A0AD206F3544481.quest_desc: ["建造一辆带有驾驶室、控制器和至少一节车厢的火车，并将其从一个车站开到另一个车站。"]
	quest.2A0AD206F3544481.quest_subtitle: "九又四分之三站台。"
	quest.2A0AD206F3544481.title: "霍格沃茨特快列车"
	quest.2A1B44EE08D39B48.quest_desc: ["曲柄轮是一个又大又过瘾的手摇柄，可以用整条胳膊来转。纯手动，超有魅力。"]
	quest.2A1B44EE08D39B48.quest_subtitle: "周而复始，循环往复。"
	quest.2A1B44EE08D39B48.title: "幸运大转盘"
	quest.2A1BBE014F497954.quest_desc: ["一锅好炖菜从不急躁。兔子、蘑菇、鱼、史特莱德、末影人。每一种都需要耐心，每一种都值得等待。"]
	quest.2A1BBE014F497954.quest_subtitle: "低温慢炖，久煮入味。"
	quest.2A1BBE014F497954.title: "久经熬煮的同类 (The Long Simmered Kind)"
	quest.2A518D996F6524CA.quest_desc: [
		"一旦开始寻找，铜无处不在，而且在 Farbound 中，它的价值远超避雷针。它能制作一套介于石制和铁制之间的工具与盔甲、一个箱子、灯笼、锁链，甚至还有帮你整理物品的迷你哥布林。"
		""
		"最重要的是，铜能为后续章节的机器提供动力。开采、冶炼，顺便制作一把铜镐吧。"
	]
	quest.2A518D996F6524CA.quest_subtitle: "今天闪亮，明天翠绿。"
	quest.2A518D996F6524CA.title: "铜器时代"
	quest.2A6C165195358280.quest_desc: ["驾驶你自己的物理船穿越海洋再返回。依靠星辰、风力和指南针来导航。"]
	quest.2A6C165195358280.quest_subtitle: "世界的背面。"
	quest.2A6C165195358280.title: "指挥官与统帅"
	quest.2A9F2ACCEB8A511B.quest_desc: ["平底锅适合在火上快速烹饪，炖锅适合长时间慢炖。两者各有用途。都建造起来吧。"]
	quest.2A9F2ACCEB8A511B.quest_subtitle: "快餐和慢餐的区别。"
	quest.2A9F2ACCEB8A511B.title: "两个陶罐"
	quest.2AA4EFE39931D12B.quest_desc: ["燕麦为啤酒提供了身躯。这一款能恰到好处地装满杯子。"]
	quest.2AA4EFE39931D12B.quest_subtitle: "光滑而沉重。"
	quest.2AA4EFE39931D12B.title: "燕麦"
	quest.2AA9BFD7D6C06BEC.quest_desc: ["Stove Tiles 建造一个带长凳的传统瓷砖壁炉。每个高山客厅的核心。"]
	quest.2AA9BFD7D6C06BEC.quest_subtitle: "屋里最温暖的位置，非你莫属。"
	quest.2AA9BFD7D6C06BEC.title: "铺砖壁炉"
	quest.2AC89A31E7EB0B8C.quest_desc: ["冲泡绿茶和红茶，每家茶馆的经典之选。"]
	quest.2AC89A31E7EB0B8C.quest_subtitle: "举起小指，干杯！"
	quest.2AC89A31E7EB0B8C.title: "茶歇时间"
	quest.2AD3D0D338AF5D14.quest_desc: ["导管笼将导管置于创造机器内。用风扇吹过物品，即可将其转化为新形态，实现全新的批量处理。它还能净化友方生物或灼烧附近的怪物。"]
	quest.2AD3D0D338AF5D14.quest_subtitle: "海洋，已被驯服。"
	quest.2AD3D0D338AF5D14.title: "Conduit Channeling"
	quest.2AE6D7976FF13C5B.quest_desc: ["在绿色中保持安静，它就会慢慢修复被撕裂的一切。"]
	quest.2AE6D7976FF13C5B.quest_subtitle: "我们是格鲁特。配饰系列。"
	quest.2AE6D7976FF13C5B.title: "树叶覆盖物"
	quest.2AFBBB3F77E60F70.quest_desc: [
		"按顺序将装配链、压机、部署器和喷嘴安装在传送带上以建造复杂部件。"
		"尝试从头到尾自动化一个精密机制。"
	]
	quest.2AFBBB3F77E60F70.subtitle: "自动化复杂事务，其余部分交给飞行。"
	quest.2AFBBB3F77E60F70.title: "组装任务书"
	quest.2B12C5920E085132.quest_desc: ["紫颂果派、紫颂曲奇、紫颂花茶和紫颂意面。烹饪两道紫颂菜肴。"]
	quest.2B12C5920E085132.quest_subtitle: "一种独特的感觉，仅此而已。"
	quest.2B12C5920E085132.title: "紫颂人列阵"
	quest.2B164CCACC614EED.quest_desc: ["纸盒能缓冲任何高度的坠落。每个飞艇机库的坠落点底部都应该放一个。"]
	quest.2B164CCACC614EED.quest_subtitle: "纸板箱来救场了。"
	quest.2B164CCACC614EED.title: "软着陆"
	quest.2B241ED8F289EE14.quest_desc: ["丰收之月，作物生长更快，夜晚也更温柔。蓝月亮带来好运。在这些特别的夜晚之一，到户外享受吧。"]
	quest.2B241ED8F289EE14.quest_subtitle: "在丰收的月亮下。"
	quest.2B241ED8F289EE14.title: "牧场物语：矿石镇的伙伴"
	quest.2B61429DFDE7F15A.quest_desc: [
		"你学到的一切都指向这里。在 Farbound 中，你建造的任何东西都可以成为真实的实体：它有重量，会倾斜，会在风中漂移，你甚至可以在它移动时行走其上。"
		""
		"飞艇、汽车、船只、潜艇和火箭的起步方式都相同。本章将教你飞行基础。在每个新方块上按住 W 键，即可观看其沉思场景。认真点。"
	]
	quest.2B61429DFDE7F15A.quest_subtitle: "我相信我能触摸到天空。"
	quest.2B61429DFDE7F15A.title: "我相信我能飞翔"
	quest.2B6368BEDC390B50.quest_desc: ["Infused Dirt 和 Infused Farmland 能让女巫植物生长得更快更好。潜行时，Rootshaper 会挖掘 3x3 的区域。"]
	quest.2B6368BEDC390B50.quest_subtitle: "可以种植任何东西。"
	quest.2B6368BEDC390B50.title: "魔法泥土"
	quest.2B87A2784305C5A8.quest_desc: ["Create 的包裹和库存系统可根据请求将物品送达基地各处。设置一个库存链接即可开始。"]
	quest.2B87A2784305C5A8.subtitle: "按需送达。"
	quest.2B87A2784305C5A8.title: "库存"
	quest.2B888874D64AFB0B.quest_desc: ["带冲撞头的装填器会自动将弹药推入大炮。钻孔器负责钻孔，建造器则组装大型炮层。"]
	quest.2B888874D64AFB0B.quest_subtitle: "加载它，塞满它，点燃它。"
	quest.2B888874D64AFB0B.title: "自动加载器"
	quest.2B8D32540C846181.quest_desc: ["面包、一片食物、一片卷心菜叶：朴素的三明治。汉堡也算，蜂蜜吐司也一样。制作两种不同的三明治。"]
	quest.2B8D32540C846181.quest_subtitle: "五美元一英尺的三明治。"
	quest.2B8D32540C846181.title: "三明治艺术家"
	quest.2B9029E4371A1F84.quest_desc: ["把摄像头转过来自拍，或者放在相机支架上拍稳当的集体照。在新船前拍张船员照，这都成传统了。"]
	quest.2B9029E4371A1F84.quest_subtitle: "这没什么可丢脸的。"
	quest.2B9029E4371A1F84.title: "摆个姿势吧"
	quest.2BA0696CF231D10A.quest_desc: ["每种木材和三种尺寸的酒架，用于小瓶子的酒盒，以及用于梯田的草和泥土板。建造一个配得上这收藏的地下室。"]
	quest.2BA0696CF231D10A.quest_subtitle: "瓶子需要一个家。"
	quest.2BA0696CF231D10A.title: "地窖的墙壁"
	quest.2BD4048C068BCA0A.quest_desc: [
		"流浪商人会带着羊驼和奇货出现。其他旅行商人也会四处游荡：面包师、园丁和酿酒师，带着他们贸易的货物。"
		""
		"与其中任意一个交易一次即可。"
	]
	quest.2BD4048C068BCA0A.quest_subtitle: "今日在此，明日即去。"
	quest.2BD4048C068BCA0A.title: "流浪商人"
	quest.2BD5F5F7ED06AEC6.quest_desc: ["冰冻葡萄酿造的Eiswein，黑暗中发光的葡萄酒，一种用chorus fruit酿造，另一种用kelp酿造。奇怪的架子总是有趣的架子，而这里的每一瓶酒都做着标签上未提及的事情。"]
	quest.2BD5F5F7ED06AEC6.quest_subtitle: "有些瓶子装着故事。"
	quest.2BD5F5F7ED06AEC6.title: "稀有佳酿"
	quest.2BED498D0A2AB885.quest_desc: ["竹子是木棍的梦想：一夜之间长成参天大树，能制成木棍、木板和木筏，还能堆成脚手架，让每个建筑都更安全。去丛林里拿些竹子，从此不再缺木头。"]
	quest.2BED498D0A2AB885.quest_subtitle: "木棍的雄心勃勃的兄弟。"
	quest.2BED498D0A2AB885.title: "基本上就是一根木棍而已"
	quest.2BFFC71D19A8BABC.quest_desc: ["世界已从地面重建。Terralith、Biomes O'Plenty 等模组为其增添了众多值得探索的地点。去寻找一个你从未见过的生物群系吧。"]
	quest.2BFFC71D19A8BABC.subtitle: "世界现在变得更加广阔了。"
	quest.2BFFC71D19A8BABC.title: "荒野"
	quest.2C156E1A6E954A39.quest_desc: ["压载水罐能让潜艇下沉和上浮：注水下沉，用压载阀排水上浮。掌控深度，就是掌控生命。"]
	quest.2C156E1A6E954A39.quest_subtitle: "把她干掉。"
	quest.2C156E1A6E954A39.title: "潜入，潜入，再潜入！"
	quest.2C1666B24C8DEC8A.quest_desc: ["酒馆矗立在古老的道路上，每座都用当地的木材建造。不妨停下脚步，歇歇脚，看看酒保有什么好喝的。"]
	quest.2C1666B24C8DEC8A.quest_subtitle: "史特莱德在角落里。"
	quest.2C1666B24C8DEC8A.title: "The Prancing Pony"
	quest.2C16B4CFC1450525.quest_desc: ["稀树草原有自己的巨兽：雄狮、雌狮、大象、长颈鹿，还有河里的河马。不要离狮子太近。也不要离河马太近。尤其是河马。"]
	quest.2C16B4CFC1450525.quest_subtitle: "无忧无虑，自由自在。"
	quest.2C16B4CFC1450525.title: "生命之环"
	quest.2C361FB6CAD7D0EE.quest_desc: ["Allays 是被囚禁在掠夺者前哨基地和林地府邸里的小蓝精灵。解救一个，给它一个物品，它就会收集所有能找到的该物品副本。"]
	quest.2C361FB6CAD7D0EE.quest_subtitle: "玩具总动员的感觉。"
	quest.2C361FB6CAD7D0EE.title: "我有个朋友在你身边 (You Have a Friend in Me)"
	quest.2C3F2701B17E1C5E.quest_desc: ["强化玻璃让你能从安全距离观察反应堆的发光。每个控制室都需要一扇窗户。"]
	quest.2C3F2701B17E1C5E.quest_subtitle: "安全玻璃。"
	quest.2C3F2701B17E1C5E.title: "只能看，不能碰"
	quest.2C5220420ECD9742.quest_desc: ["乌龙茶介于绿茶和红茶之间，半发酵，风味复杂而美妙。冲泡一壶吧。"]
	quest.2C5220420ECD9742.quest_subtitle: "半干半湿，美味十足。"
	quest.2C5220420ECD9742.title: "乌龙小故事（Oolong Story Short）"
	quest.2C5CC371DFD8D8C8.quest_desc: ["研钵和研杵将草药碾成糊状和粉末，是几乎所有配方的基础。草药罐用于储存你研磨好的草药。"]
	quest.2C5CC371DFD8D8C8.quest_subtitle: "粉碎，粉碎，粉碎。"
	quest.2C5CC371DFD8D8C8.title: "把它磨个粉碎"
	quest.2C60DBCC8EF30ED3.quest_desc: ["烹饪锅是制作真美食的地方。最多六种食材在炉子上熬成炖菜、汤、意面等。碗放在旁边用来盛装。"]
	quest.2C60DBCC8EF30ED3.quest_subtitle: "什么东西闻起来这么香，真美味。"
	quest.2C60DBCC8EF30ED3.title: "在烹饪什么呢？"
	quest.2C6AC9DE5923DA91.quest_desc: ["洒水器通过管道供水时能自动灌溉作物。换成液体肥料，你的田地会生长得更快。"]
	quest.2C6AC9DE5923DA91.quest_subtitle: "当然，当然是在浇水了，毫无疑问。"
	quest.2C6AC9DE5923DA91.title: "雨人 (Rain Man)"
	quest.2C77A662518EC52F.quest_desc: ["下界沼泽地冒着气泡和蒸汽。氢水母漂浮其上，纳迦潜伏其下。"]
	quest.2C77A662518EC52F.quest_subtitle: "阿塔克斯，不！"
	quest.2C77A662518EC52F.title: "悲伤的沼泽地"
	quest.2C8454EFCDB624A2.quest_desc: [
		"Chipped 的工作台能将方块变为变种：木匠桌用于木材，石匠桌用于石材，植物学家工作台用于植物，玻璃吹制台用于玻璃，织布机桌用于羊毛，炼金术工作台和手工台则用于其他所有物品。"
		""
		"建造两个这样的东西。"
	]
	quest.2C8454EFCDB624A2.quest_subtitle: "合适的工具，适合的工作。"
	quest.2C8454EFCDB624A2.title: "工作台收集包"
	quest.2CB6A6914B37D24E.quest_desc: ["咖啡芝士蛋糕、樱花芝士蛋糕、糖浆芝士蛋糕。浓郁、丝滑，但对腰围极不友好。管他呢。"]
	quest.2CB6A6914B37D24E.quest_subtitle: "至少有十种不同的种类。"
	quest.2CB6A6914B37D24E.title: "芝士蛋糕工厂"
	quest.2CDE80C58B643552.quest_desc: ["盛宴摆上桌，一片片切开，足够全队享用。烤鸡、牧羊人派、蜂蜜火腿、南瓜派：将一道菜摆上你的餐桌。"]
	quest.2CDE80C58B643552.quest_subtitle: "都围过来，听我吩咐。"
	quest.2CDE80C58B643552.title: "盛宴模式"
	quest.2CE858A921BF6442.quest_desc: ["大多数 Create 机器都有铜、黄铜、铁路和工业铁外壳：压模机、搅拌机、部署器、钻头、齿轮箱、仓库和蒸汽机。功能相同，外观新颖。"]
	quest.2CE858A921BF6442.quest_subtitle: "每台机器都换上了新外壳。"
	quest.2CE858A921BF6442.title: "在掩护下行动"
	quest.2CF78853D0E7D5D5.quest_desc: ["草莓、甜浆果和苹果纸杯蛋糕。把它们放在展示架上，看着它们消失吧。"]
	quest.2CF78853D0E7D5D5.quest_subtitle: "纸杯蛋糕大战"
	quest.2CF78853D0E7D5D5.title: "纸杯蛋糕大战"
	quest.2CF8B7E48CDD85E4.quest_desc: ["限定桶有1到4个大格，每个大格能批量存放一种物品，就像抽屉一样。用它们砌成的墙，是你建过的最整洁的储物室。"]
	quest.2CF8B7E48CDD85E4.quest_subtitle: "干净又整洁。"
	quest.2CF8B7E48CDD85E4.title: "抽屉系统"
	quest.2D0A00C99A269129.quest_desc: ["没有杯子，再好的饮品也不完整。制作一堆杯子，把它们整齐地摆放在架子上。"]
	quest.2D0A00C99A269129.quest_subtitle: "把它们排成一列。"
	quest.2D0A00C99A269129.title: "随时待命的马克杯"
	quest.2D1122ACC4845614.quest_desc: ["下界合金酿造台是所有中最顶级的。有了它，连威士忌都能轻松酿造。"]
	quest.2D1122ACC4845614.quest_subtitle: "最棒的那一个。"
	quest.2D1122ACC4845614.title: "大师的蒸馏器"
	quest.2D17F7AD6DD32218.quest_desc: ["画笔和装饰台可以给你的储物方块上色和重贴图，使其与你的建筑相匹配。打包胶带能让你拿起一整个箱子而不会弄洒里面的东西。"]
	quest.2D17F7AD6DD32218.quest_subtitle: "用颜色代码把它标出来。"
	quest.2D17F7AD6DD32218.title: "粉刷城镇"
	quest.2D1F487D0510E348.quest_desc: ["亡灵海盗船载着不愿死亡的船员航行。掠夺者桨帆船和海盗船也在海上搜寻。击败被诅咒的船员。"]
	quest.2D1F487D0510E348.quest_subtitle: "船员的一部分，也是船的一部分。"
	quest.2D1F487D0510E348.title: "飞翔的荷兰人号"
	quest.2D30503C8415B99D.quest_desc: [
		"建筑师在 Farbound 拥有的方块远超所需。仅 Chipped 模组就将一种石头变成了数十种变体：雕刻、铺砖、裂纹、华丽。Macaw's 模组则添加了各种风格的屋顶、门窗。"
		""
		"拿起你最喜欢的方块，开始建造你引以为傲的作品。"
	]
	quest.2D30503C8415B99D.quest_subtitle: "一切都很棒！"
	quest.2D30503C8415B99D.title: "建筑大师"
	quest.2D31632AFEEFBFBA.quest_desc: ["小鼓保持节奏，三角铁增添光彩。每个乐队都需要一个节奏组。"]
	quest.2D31632AFEEFBFBA.quest_subtitle: "砰 砰 砰 砰。"
	quest.2D31632AFEEFBFBA.title: "小鼓手男孩 (Little Drummer Boy)"
	quest.2D499ECC050CB161.quest_desc: ["烟囱会从火车顶部喷出真实的烟雾。煤炭燃烧器、木材燃烧器、油燃烧器、双层堆栈、流线型堆栈，甚至还有柴油外观的散热器风扇。按住 ALT 可在不同变体间切换。染料可为烟雾上色，灵魂沙则将其变为诡异的灵魂烟雾。"]
	quest.2D499ECC050CB161.quest_subtitle: "还有天空中的火焰。"
	quest.2D499ECC050CB161.title: "水上的硝烟"
	quest.2D64BA5CB292A0FE.quest_desc: ["没有胶片的相机就是一台很复杂的望远镜。制作黑白胶片，装上它，每次点击都会开始计数。"]
	quest.2D64BA5CB292A0FE.quest_subtitle: "每次投掷可获得三十六段回忆。"
	quest.2D64BA5CB292A0FE.title: "已加载"
	quest.2D72CDACA5C37AB5.quest_desc: ["松土、播种、浇水。一把锄头和一桶水就足够了。右键成熟的作物即可同时收获和重新种植。"]
	quest.2D72CDACA5C37AB5.quest_subtitle: "挥舞你的搭档，转圈圈转圈圈。"
	quest.2D72CDACA5C37AB5.title: "锄头倒下"
	quest.2D8B6E77FD96A2F2.quest_desc: ["电压表、电流表、功率表和能量计能精确显示流经电网的数值。将它们安装在控制面板上，仿佛经营着一座发电厂。因为，你确实在经营。"]
	quest.2D8B6E77FD96A2F2.quest_subtitle: "数字永远不会说谎。"
	quest.2D8B6E77FD96A2F2.title: "读取计量表"
	quest.2DAF18E319598B3F.quest_desc: ["雷达安全区标记器会划定一个区域，你的自动化武器将永远不会在此开火。把它放在你的家、港口，以及朋友停船的任何地方。"]
	quest.2DAF18E319598B3F.quest_subtitle: "一场设计好的停火协议。"
	quest.2DAF18E319598B3F.title: "我们时代的和平"
	quest.2DD28D452204993B.quest_desc: ["Armor Statues 解锁了盔甲架的全部潜力：从解锁手臂、旋转每个身体部位，到选择内置姿势、调整各种样式设置，再到使用强大工具来定位盔甲架，甚至可以用它来仅显示世界中的物品，使盔甲架本身不可见。"]
	quest.2DD28D452204993B.quest_subtitle: "了解你的镀层材料。"
	quest.2DEED4912A18548B.quest_desc: ["以大约平时两倍的速度划开水面。"]
	quest.2DEED4912A18548B.quest_subtitle: "叫我海王就好了。"
	quest.2DEED4912A18548B.title: "专为水而造"
	quest.2E259AD1CC9F22A0.quest_desc: ["它似乎能感知到你正在追踪的任何东西。"]
	quest.2E259AD1CC9F22A0.quest_subtitle: "只要会流血，你就能找到它。"
	quest.2E259AD1CC9F22A0.title: "猎人腰带 (The Hunter's Belt)"
	quest.2E3F03B9A28B8114.quest_desc: ["建造一辆真正的蒸汽机车：金属车身、锅炉、会冒烟的烟囱、两端的车钩，还有车上的列车员。然后让它按时刻表运行。"]
	quest.2E3F03B9A28B8114.quest_subtitle: "铁马与煤炭的硝烟。"
	quest.2E3F03B9A28B8114.title: "蒸汽时代"
	quest.2E4DB35D851BCF8F.quest_desc: ["潜艇螺旋桨在水下运行良好，但在陆地上完全无效。将四个朝同一方向放置成2x2的正方形，它们会合并成一个大型螺旋桨。水推进器是紧凑的替代方案。"]
	quest.2E4DB35D851BCF8F.quest_subtitle: "悄无声息地，深深地奔跑。"
	quest.2E4DB35D851BCF8F.title: "Silent Running"
	quest.2E5125191D1EB943.quest_desc: ["各种颜色的湿水泥都能像液体一样流动，并凝固成混凝土。直接从管道中浇筑地板、墙壁和地基。"]
	quest.2E5125191D1EB943.quest_subtitle: "具体的计划。"
	quest.2E5125191D1EB943.title: "Set in Stone"
	quest.2E6E2BC3B3F2107E.quest_desc: ["煎锅在热炉子上能煎任何你放进去的东西。它也是一件出奇有效的武器。把它拿在手里，然后去问问僵尸。"]
	quest.2E6E2BC3B3F2107E.quest_subtitle: "滋滋作响。"
	quest.2E6E2BC3B3F2107E.title: "煎锅升级"
	quest.2EA8C5F90F77ACD4.quest_desc: ["一个按键（默认 I）可切换沉浸式游泳：逼真的潜水、流畅的划水，水终于有了水的样子。试过一次后，旧版划水就显得很蠢了。"]
	quest.2EA8C5F90F77ACD4.quest_subtitle: "按下 I，成为一只海豚。"
	quest.2EA8C5F90F77ACD4.title: "Just Keep Swimming"
	quest.2EB159C526756123.quest_desc: ["下界丛林郁郁葱葱，绿意盎然，充满了奇怪的藤蔓、黑苹果和丛林骷髅。去拜访一下吧。"]
	quest.2EB159C526756123.quest_subtitle: "我们得到了乐趣和游戏。"
	quest.2EB159C526756123.title: "欢迎来到丛林世界"
	quest.2ED3D36823E8356F.quest_desc: [
		"狼可以用骨头驯服。驯服的狼会跟随你、为你而战，并且会根据你发现的生物群系呈现出各种不同的毛色。"
		""
		"驯服一只并给它取个名字。"
	]
	quest.2ED3D36823E8356F.quest_subtitle: "谁是乖孩子呢？"
	quest.2ED3D36823E8356F.title: "人类最好的朋友"
	quest.2F12B409C15BCCE8.quest_desc: ["金属可以在加热搅拌机中熔化并倒入液态。锭模和陶瓷锭模可盛放熔化的金属：用漏斗装满，然后用风扇通过水冷却，即可敲出新的锭。"]
	quest.2F12B409C15BCCE8.quest_subtitle: "倒出，冷却，重复。"
	quest.2F12B409C15BCCE8.title: "Mold Breaker"
	quest.2F28C660A8F6E36E.quest_desc: ["沥青能铺成让你跑得更快的好路。在城镇之间铺上它，你的汽车会感激不尽。"]
	quest.2F28C660A8F6E36E.quest_subtitle: "前方道路平坦，一路顺风。"
	quest.2F28C660A8F6E36E.title: "踏上旅途吧"
	quest.2F47220DC50AD163.quest_desc: ["通用关节可在两个独立部件间传递旋转，即使它们相对移动。液压杆和铰链可在结构间推拉。起落架、起重机、拖车。"]
	quest.2F47220DC50AD163.quest_subtitle: "连接，弯曲，传输。"
	quest.2F47220DC50AD163.title: "联合企业"
	quest.2F53C0CFB0B46701.quest_desc: ["蚕吐丝，丝制绳，绳子能固定住东西却不伤人。包里最温和的供应链。"]
	quest.2F53C0CFB0B46701.quest_subtitle: "总得有人来转动它才行。"
	quest.2F53C0CFB0B46701.title: "丝绸之路"
	quest.2F6550A9863E2C21.quest_desc: ["巨型齿轮和超巨型齿轮都大得惊人。它们做着普通齿轮做的事，只是更具戏剧性。围绕其中一个建造一座钟楼吧。"]
	quest.2F6550A9863E2C21.quest_subtitle: "大小很重要。"
	quest.2F6550A9863E2C21.title: "要么干大事，要么干脆回家去"
	quest.2F7EA2629DDA3131.quest_desc: ["猪肘、香肠、炸鸡、饺子、半只鸡。总是与一品脱啤酒相伴的食物。无需多言。"]
	quest.2F7EA2629DDA3131.quest_subtitle: "搭配冷饮享用更佳。"
	quest.2F7EA2629DDA3131.title: "酒馆菜单"
	quest.2F80FF1DC2EDC04D.quest_desc: ["这里的画作有更多图案。放置一幅画，循环切换设计，直到找到适合你房间的那一幅。"]
	quest.2F80FF1DC2EDC04D.quest_subtitle: "每一面墙上的艺术品。"
	quest.2F80FF1DC2EDC04D.title: "彩绘女士们"
	quest.2F85544681B88BA3.quest_desc: ["火车是穿越世界的另一种方式。可以搭配你的飞艇或船只，建立一个完善的物流网络，也可以完全忽略。随你选择。"]
	quest.2F85544681B88BA3.subtitle: "地面交通工具，可选。"
	quest.2F85544681B88BA3.title: "铁轨"
	quest.2FD68992108FF4A3.quest_desc: ["最古老的酿酒工作，也是最有趣的：将葡萄藤罐装满单一品种的葡萄，然后爬进去开始移动。跳跃、行走、重复。当发酵液准备好时，直接从罐中装瓶。"]
	quest.2FD68992108FF4A3.quest_subtitle: "请先脱掉你的靴子。"
	quest.2FD68992108FF4A3.title: "践踏的季节"
	quest.2FDA25680D9F598E.quest_desc: ["酿造站是酿制啤酒的地方：一口锅、一堆火和不停的搅拌。先用木制的，升级到铜制，最后用下界合金制做更大的批次。"]
	quest.2FDA25680D9F598E.quest_subtitle: "麦芽、水、啤酒花、魔法。"
	quest.2FDA25680D9F598E.title: "酿酒大师"
	quest.300CC8025D283930.quest_desc: ["带引信的C4能让你从安全距离引爆物品。警报器会先发出警告，这才是正确的做法。"]
	quest.300CC8025D283930.quest_subtitle: "按下那个大大的红色按钮。"
	quest.300CC8025D283930.title: "遥控器"
	quest.307D069FE116F92E.quest_desc: [
		"玉是一种储存经验的绿色石头。开采原始玉，然后雕刻它：每个雕刻玉块都储存着约七级经验的电荷。"
		""
		"找到一些，然后雕刻你的第一块方块。"
	]
	quest.307D069FE116F92E.quest_subtitle: "绿石，古老的魔法。"
	quest.307D069FE116F92E.title: "Jade Empire"
	quest.3080D0ADC499E663.quest_desc: ["试着在怪物附近睡觉，游戏会告诉你到底是谁在破坏你的夜晚。再也不用猜测咆哮声是从哪个方向传来的了。做个好梦。"]
	quest.3080D0ADC499E663.quest_subtitle: "嘿，它们一直都在那里。"
	quest.3080D0ADC499E663.title: "床底下的秘密"
	quest.30DF9AA5C19B9FB1.quest_desc: ["机械收割机在移动时收集作物，并让植物重新生长。机械犁可以翻土和推动物体。把它们放在移动装置上，你的田地就能自己耕种了。"]
	quest.30DF9AA5C19B9FB1.quest_subtitle: "小睡的同时，农场在运转。"
	quest.30DF9AA5C19B9FB1.title: "田间运动会"
	quest.310D9A9FED56790B.quest_desc: ["燃烧器将液体燃料转化为热量，为熔炉提供燃料驱动的替代方案。"]
	quest.310D9A9FED56790B.quest_subtitle: "液态的热量。"
	quest.310D9A9FED56790B.title: "为火焰添柴加薪"
	quest.3155A552D45A3943.quest_desc: ["简易砧模让砧锤不再麻烦。关闭界面后物品会保留，并直接显示在方块上。维修成本合理，工作惩罚减轻，重命名免费。一个小模组，让砧锤体验贯穿游戏始终的愉悦。"]
	quest.3155A552D45A3943.quest_subtitle: "修复，不留遗憾。"
	quest.3155A552D45A3943.subtitle: "修复，不留遗憾。"
	quest.3155A552D45A3943.title: "更友善的锻造台"
	quest.3185703BC253C1D7.quest_desc: ["草莓长得低矮又香甜。用篮子采摘，能做茶、蛋糕，还有包里最美味的早餐。"]
	quest.3185703BC253C1D7.quest_subtitle: "没有什么东西是真实的。"
	quest.3185703BC253C1D7.title: "草莓田永存"
	quest.318A466DFC12F2EC.quest_desc: ["方向盘能精确输出旋转，非常适合转动舵或螺旋桨。把它和能旋转所连接物体的万向轴承组合起来，你的船就能随心所欲地转向了。"]
	quest.318A466DFC12F2EC.quest_subtitle: "看着我。"
	quest.318A466DFC12F2EC.title: "我才是船长，现在轮到我了"
	quest.31AADC5C058F3848.quest_desc: ["有线调制解调器和网络电缆可将计算机和外围设备连接起来。一台计算机可以读取三间房外的显示器，或控制一整排机器。"]
	quest.31AADC5C058F3848.quest_subtitle: "可以互相通信的计算机。"
	quest.31AADC5C058F3848.title: "线路连接完成"
	quest.31AFEAD5922B8F96.quest_desc: ["哭泣的黑曜石哭泣着，却无法言明缘由。从废弃传送门撬下一些，或与猪灵交易。接下来的步骤需要用到它。"]
	quest.31AFEAD5922B8F96.quest_subtitle: "黑曜石会记住一切。"
	quest.31AFEAD5922B8F96.title: "是谁在切洋葱？"
	quest.31BE17E9FDE22C5B.quest_desc: ["弹弓可以发射你装入的任何方块或物品。远程放置方块、点燃远处的引信，或在安全距离外敲晕苦力怕。"]
	quest.31BE17E9FDE22C5B.quest_subtitle: "一块石头，一个巨人。"
	quest.31BE17E9FDE22C5B.title: "大卫与歌利亚"
	quest.31CF44F4BA37E63B.quest_desc: ["来自稀树草原、泰加林和丛林的葡萄能酿出别处无法酿造的美酒。种植至少一种区域性品种。"]
	quest.31CF44F4BA37E63B.quest_subtitle: "每一寸土壤都讲述着一个故事。"
	quest.31CF44F4BA37E63B.title: "Terroir"
	quest.326A0330033681A6.quest_desc: ["打印你的第一张照片。你可以命名、署名，然后把它交给朋友。"]
	quest.326A0330033681A6.quest_subtitle: "千言万语，尽在不言中。"
	quest.326A0330033681A6.title: "完美无瑕的照片"
	quest.3286C0D1B452946E.quest_desc: ["防辐射盔甲能让你在放射性材料和受辐射地区保持安全。它有各种颜色，因为安全也要好看。"]
	quest.3286C0D1B452946E.quest_subtitle: "世界末日的时尚潮流。"
	quest.3286C0D1B452946E.title: "Hazmat Chic"
	quest.328B79228D3FDCC4.quest_desc: ["盐藏在高山石中，每个正经厨房都靠它运转。开采矿脉，研磨成粉，从此以后烹饪的一切都尝出不同。"]
	quest.328B79228D3FDCC4.quest_subtitle: "能改变一切的唯一调味料。"
	quest.328B79228D3FDCC4.title: "世上的盐分"
	quest.329200A1FDBC8CB0.quest_desc: ["某个地方存在一个完整的女巫村庄。去拜访，谨慎交易，不要喝她们给你的任何东西。"]
	quest.329200A1FDBC8CB0.quest_subtitle: "冒泡，冒泡。"
	quest.329200A1FDBC8CB0.title: "被诅咒的村庄 (Village of the Damned)"
	quest.32956965F9864167.quest_desc: [
		"Moobloom 是覆盖着花朵的牛，有从黄耆到樱花等多种类型。它们会留下花朵的踪迹，让蜜蜂们很开心。"
		""
		"在富含花朵的生物群系中找到一个。"
	]
	quest.32956965F9864167.quest_subtitle: "洋甘菊和黄油。"
	quest.32956965F9864167.title: "在你扎根的地方绽放光彩"
	quest.32AD378A8983D321.quest_desc: ["在短短的一瞬间，时间仿佛为你而放慢了脚步。"]
	quest.32AD378A8983D321.quest_subtitle: "子弹时间，但更便宜。"
	quest.32AD378A8983D321.title: "片刻的闲暇时光"
	quest.32BC654090044F83.quest_desc: ["HUD投影器显示飞行数据，姿态显示器显示倾斜度，前进指示器显示航向。像战斗机飞行员一样飞行。"]
	quest.32BC654090044F83.quest_subtitle: "所有数据，绝无干扰。"
	quest.32BC654090044F83.title: "注意前方"
	quest.32D4718A02063CD3.quest_desc: ["同样的招数，更便宜的包装，适合你喝得又多又不在乎的时候。"]
	quest.32D4718A02063CD3.quest_subtitle: "妈妈说我们家里已经有一个了。"
	quest.32D4718A02063CD3.title: "预算版（The Budget Version）"
	quest.32FF2C6C3328B9B6.quest_desc: ["巨龙喷息，地面冒烟。在那片云中握住玻璃瓶，它便会装满别处无法获得的稀有物品。游戏中最稀有的合成材料之一。"]
	quest.32FF2C6C3328B9B6.quest_subtitle: "瓶装的闪电，来自野兽本身。"
	quest.32FF2C6C3328B9B6.title: "龙之息（Dragon's Breath）"
	quest.330EB6CD1B07CC69.quest_desc: ["远古城市深藏于幽暗深处，比以往更大、更诡异。悄悄潜入，谨慎搜刮，无论如何都别惊扰了坚守者。"]
	quest.330EB6CD1B07CC69.quest_subtitle: "嘘，安静点。"
	quest.330EB6CD1B07CC69.title: "寂静之城"
	quest.33430AA475548CF1.quest_desc: ["各种颜色的旗帜、彩带和遮阳篷，适合节日、市场和船只的桅杆。"]
	quest.33430AA475548CF1.quest_subtitle: "颜色鲜艳度很高。"
	quest.33430AA475548CF1.title: "挥舞旗帜，扬名立万"
	quest.335AB424077F9AED.quest_desc: ["一款泥煤味浓郁的威士忌，适合那些想品尝其诞生之火的人。坐下来，细细品味。"]
	quest.335AB424077F9AED.quest_subtitle: "有烟的地方，必有火源。"
	quest.335AB424077F9AED.title: "烟雾缭绕的梦境"
	quest.33864E2921D715B6.quest_desc: [
		"此处的马匹有多种步态：使用行走循环键可在行走、小跑、慢跑和全速奔跑之间切换。马匹指令轮盘可让您召唤、管理和与信任的朋友共享马匹。"
		""
		"尝试在马背上换挡一次。"
	]
	quest.33864E2921D715B6.quest_subtitle: "了解你的马匹。"
	quest.33864E2921D715B6.title: "稳定的天才"
	quest.338B2AA0EE433D79.quest_desc: [
		"建筑魔杖可一次性放置一整排或一面方块，使用背包中的方块来扩展表面。墙壁、地板和船体护板可秒速建成。"
		""
		"从石头或铁开始，升级到钻石，打造几乎不可破坏的法杖。"
		""
		"&l模式：&r Shift 和滚动可更改方向。"
		""
		"&l核心：&r升级魔杖，解锁新技巧，如空中建造或用撤销瞬间清除方块。"
		""
		"魔杖甚至会从你的潜影盒和副手物品栏中拉取方块。"
	]
	quest.338B2AA0EE433D79.quest_subtitle: "是 leviOsa，不是 levioSA。"
	quest.338B2AA0EE433D79.subtitle: "建造得更快，建造得更大。"
	quest.338B2AA0EE433D79.title: "Wingardium Leviosa"
	quest.339000DC81346AF1.quest_desc: ["斩骨刀是厨房的重型刀具，专为小刀无法胜任的重活而设计。每位专业厨师都会将其放在手边。"]
	quest.339000DC81346AF1.quest_subtitle: "重型准备工作。"
	quest.339000DC81346AF1.title: "大型伐木机"
	quest.33AE1E3CDE60A903.quest_desc: ["月光林地在夜晚散发着柔和的蓝光和银光。世界上最美丽的地方之一。请在夜间前往。"]
	quest.33AE1E3CDE60A903.quest_subtitle: "月光如银，清冷皎洁。"
	quest.33AE1E3CDE60A903.title: "月光林荫道"
	quest.33F4B13E4BEA21C3.quest_desc: ["Tuff Golem会持有你交给它的任何物品，并像活着的展示架一样守卫。Copper Golem会自己按下铜按钮，在新形态下还能在铜箱子之间整理物品。"]
	quest.33F4B13E4BEA21C3.quest_subtitle: "一直以来都拿着东西，仿佛永远如此。"
	quest.33F4B13E4BEA21C3.title: "自由女神像"
	quest.33FF7A7CFC12C792.quest_desc: ["强劲、醇厚，略带粗糙。越喝越喜欢。大多数东西都是这样。"]
	quest.33FF7A7CFC12C792.quest_subtitle: "需要慢慢适应的味道。"
	quest.33FF7A7CFC12C792.title: "Jojannik"
	quest.34167E254C4D8622.quest_desc: ["红石蓄电器存储随时间变化的信号，红石感应器使信号平滑趋近输入。平缓的加速曲线，平滑的转向，柔软的着陆。"]
	quest.34167E254C4D8622.quest_subtitle: "不要突然移动。"
	quest.34167E254C4D8622.title: "Smooth Operator"
	quest.342FF88784BA65A3.quest_desc: ["山坡上的高地牛，暗林中的乌姆布拉牛，河边的水牛，还有会顶你的山羊。把它们都找到。每只牛产的奶都不同，每种奶都能做成不同的奶酪。"]
	quest.342FF88784BA65A3.quest_subtitle: "每座山丘都有自己的牛群。"
	quest.342FF88784BA65A3.title: "牛群 The Herd"
	quest.3435B3428AAD4BE0.quest_desc: [
		"压缩爆破矿工，用 Mine-O-Mite 设置并用红石触发，能引爆几乎任何方块，甚至是基岩。"
		""
		"小心处理。保持距离。告诉你的朋友。"
	]
	quest.3435B3428AAD4BE0.quest_subtitle: "爆炸？是的，里科，爆炸了。"
	quest.3435B3428AAD4BE0.title: "洞里着火了！Fire in the Hole!"
	quest.3464E6698C52311E.quest_desc: ["船体方块和金属板看起来就像旧船和飞船的铆接钢板。支撑柱和楔形支撑物可以撑起阳台和屋顶。你的船只将看起来名副其实。"]
	quest.3464E6698C52311E.quest_subtitle: "铆接完毕，随时待命。"
	quest.3464E6698C52311E.title: "船体破裂"
	quest.34A74A45CE6919F5.quest_desc: ["相机是一台真正的机器：取景器、变焦、快门。制作一台，学习操作，然后通过镜头以应有的方式欣赏 Farbound 的世界。"]
	quest.34A74A45CE6919F5.quest_subtitle: "柯达时刻，匠心独造。"
	quest.34A74A45CE6919F5.title: "说声“茄子”"
	quest.34D17B850DC4623C.quest_desc: ["水壶看起来复杂，但了解槽位后很简单。左上角放一片路易波士叶，正下方放一个玻璃瓶。在右侧刻度条旁的槽位加入一桶水。设置正确后，进度箭头就会开始填充。"]
	quest.34D17B850DC4623C.quest_subtitle: "热水，冷落的树叶。"
	quest.34D17B850DC4623C.title: "铜与蒸汽"
	quest.34DF7C778925650A.quest_desc: ["船外机是一种紧凑的燃油推进装置。把它装在船尾，把船桨留在家里吧。"]
	quest.34DF7C778925650A.quest_subtitle: "噗通噗通噗通。"
	quest.34DF7C778925650A.title: "舷外发动机"
	quest.34E6654B7F3FE63B.quest_desc: ["三叉戟是海里最稀有的武器，在这里投掷后它会返回。从溺尸那里拿一个，然后用它来回报，翱翔于空中。"]
	quest.34E6654B7F3FE63B.quest_subtitle: "反正，现在它总是会回来的。不管怎样。"
	quest.34E6654B7F3FE63B.title: "一个无伤大雅的玩笑"
	quest.34ED904D6D72EEE2.quest_desc: ["蓝图台会将一个容器及其所有可移动子部件保存为蓝图。蓝图炮则用材料将其重建，就像飞行船的蓝图炮一样。"]
	quest.34ED904D6D72EEE2.quest_subtitle: "打印一支舰队。"
	quest.34ED904D6D72EEE2.title: "蓝图大炮"
	quest.3500239682C0434C.quest_desc: ["珍珠和黑珍珠躺在海底的贝壳里，偶尔会有漂流瓶经过，里面还装着某人的讯息。把两者都钓上来，读读大海都带来了些什么。"]
	quest.3500239682C0434C.quest_subtitle: "有人故意把这个东西扔到了船外。"
	quest.3500239682C0434C.title: "沉没的宝藏"
	quest.3508B70774DD58F1.quest_desc: ["稻草人能让鸟类和害虫远离你的作物，放在田边也很好看。给你的稻草人戴上一顶帽子吧。"]
	quest.3508B70774DD58F1.quest_subtitle: "绿野仙踪，野外版。"
	quest.3508B70774DD58F1.title: "要是我有个脑子就好了"
	quest.351D84555223AE53.quest_desc: ["鱼冰棍正如其名，有好几种水果口味。奇怪、冰冷，却又莫名美味。"]
	quest.351D84555223AE53.quest_subtitle: "冻在棍子上的鱼。也不错嘛。"
	quest.351D84555223AE53.title: "大脑冻结症 (Brain Freeze)"
	quest.35283DAB68B2405A.quest_desc: ["用创造机器加工的棱镜岩会变为棱镜合金，一种用于海洋工程的海洋绿金属。尖刺贝壳和钙粉也来自同一片水域。"]
	quest.35283DAB68B2405A.quest_subtitle: "诞生于海洋之中。"
	quest.35283DAB68B2405A.title: "海晶合金"
	quest.353154298CC8A392.quest_desc: ["每种木材和石材都有屋顶：普通、陡峭、低、高、阁楼和顶层。给你的房子盖上合适的屋顶，别再用地毯楼梯了。"]
	quest.353154298CC8A392.quest_subtitle: "把你的双手举向空中。"
	quest.353154298CC8A392.title: "抬高屋顶"
	quest.3539DB05730F7D5F.quest_desc: ["Pneumatic Tubes 用气流将物品沿管道输送，而 Brass Depot 是一个更坚固、更智能的货站。无需传送带即可整洁地运输物品。"]
	quest.3539DB05730F7D5F.quest_subtitle: "呼——的一声。"
	quest.3539DB05730F7D5F.title: "气动管道系统 (Pneumatic Tube System)"
	quest.35404C79E81FCDF5.quest_desc: ["火星平原之下，蕴藏着丰富的矿石和硫磺洞穴。探索另一颗星球的地下世界。"]
	quest.35404C79E81FCDF5.quest_subtitle: "红色沙砾之下隐藏着什么。"
	quest.35404C79E81FCDF5.title: "地下世界"
	quest.3562F106E8BC7A43.quest_desc: ["这里没有鞘翅。天空本不该用借来的翅膀去穿越。建造一艘船，装上螺旋桨，赢得你的高度。准备好后，前往航空章节。"]
	quest.3562F106E8BC7A43.quest_subtitle: "赢得属于你的海拔高度。"
	quest.3562F106E8BC7A43.title: "这里没有翅膀"
	quest.35C54F78C489ECE0.quest_desc: ["口袋电脑是一款便携式计算机。加上无线调制解调器，你就可以随时随地控制基地，或者在码头上查看你的飞艇状况。"]
	quest.35C54F78C489ECE0.quest_subtitle: "一部装在口袋里的电脑。"
	quest.35C54F78C489ECE0.title: "口袋火箭"
	quest.35D4E45E409DAEC1.quest_desc: ["两个可选的大型模组默认禁用，在选项中等待：Distant Horizons 渲染世界至地平线，像饥饿的烈焰人一样吞噬 RAM。Atmospherics 增添氛围但与着色器不兼容。根据你的设备性能选择。Farbound 无需两者也能正常运行。"]
	quest.35D4E45E409DAEC1.quest_subtitle: "美丽总是伴随着代价。"
	quest.35D4E45E409DAEC1.title: "你的钻机，你的规则"
	quest.35E2AF1835B5893F.quest_desc: ["相册的每页都附有配文的照片。完成后请签名，它就会成为纪念品。"]
	quest.35E2AF1835B5893F.quest_subtitle: "回忆，一页又一页地翻过。"
	quest.35E2AF1835B5893F.title: "剪贴簿"
	quest.35FF7C7675E97DCC.quest_desc: ["下界合金潜水装备能让你在熔岩中畅游，只要你的氧气瓶够用。疯狂吗？是的。实用吗？当然。"]
	quest.35FF7C7675E97DCC.quest_subtitle: "投入火焰之中。"
	quest.35FF7C7675E97DCC.title: "熔岩潜水者"
	quest.360197E38989A080.quest_desc: ["堡垒是铜甲掠夺者的据点。孤堡矗立在山丘上。征服其中一个堡垒。"]
	quest.360197E38989A080.quest_subtitle: "高墙耸立，风险更高。"
	quest.360197E38989A080.title: "城堡 (The Citadel)"
	quest.363113896FEF2386.quest_desc: ["笼子可以捕捉小型生物和幼年动物，方便你带回家。再也不用费力地把鸡舍搬到地图的另一边了。"]
	quest.363113896FEF2386.quest_subtitle: "轻一点，小心点，现在。"
	quest.363113896FEF2386.title: "捕获与释放"
	quest.363B2B8C33F15BF3.quest_desc: ["世界会奖励勇敢者。去那些严酷之地——冰封的山峰、灼热的平原、深邃的洞穴。在那里着陆，环顾四周。带点东西回家。"]
	quest.363B2B8C33F15BF3.subtitle: "最严酷的地方隐藏着最美的景色。"
	quest.363B2B8C33F15BF3.title: "极限挑战"
	quest.36967C11A5EEE501.quest_desc: ["龙门架和车厢通过旋转沿轨道移动装置。组合两个龙门架可制成XY起重机或建造墙壁的3D打印机。"]
	quest.36967C11A5EEE501.quest_subtitle: "沿着轨道滑行。"
	quest.36967C11A5EEE501.title: "龙门起重机"
	quest.369799915253D220.quest_desc: ["巧克力蛋糕、法式蛋糕、环形蛋糕、草莓、甜莓。每种蛋糕都有它自己的切片，而每一片都消失得比上一片更快。"]
	quest.369799915253D220.quest_subtitle: "砍掉它，到了晚上它就会消失。"
	quest.369799915253D220.title: "蛋糕板 The Cake Board"
	quest.3698C3A000886538.quest_desc: ["温馨的家也需要浴室：浴缸、盥洗盆、水槽和镜子。高山松能打造出迷人的乡村风格。"]
	quest.3698C3A000886538.quest_subtitle: "橡胶鸭不包含在内。"
	quest.3698C3A000886538.title: "洗澡时间到了"
	quest.369B29C4452DB2FD.quest_desc: ["你的攻击带有电击效果，能让被击中的目标陷入眩晕。"]
	quest.369B29C4452DB2FD.quest_subtitle: "无限的力量。"
	quest.369B29C4452DB2FD.title: "静电电荷"
	quest.36B2A35CA44D4335.quest_desc: ["Farbound 运送了数百种建筑材料，从粗糙的木材到抛光黄铜。建造一个配得上停在、停泊在或系在门外的载具的地方。"]
	quest.36B2A35CA44D4335.subtitle: "一个值得回归的家园港口。"
	quest.36B2A35CA44D4335.title: "主页"
	quest.36CF003C380837A7.quest_desc: ["你的第一艘飞艇已经起飞。现在要让它飞得更好。本章是造船厂：标准的驾驶舱、真正的推进器、飞行计算机、货运路线以及移动整艘船的工具。"]
	quest.36CF003C380837A7.quest_subtitle: "开始倒计时，引擎启动。"
	quest.36CF003C380837A7.title: "地面控制中心呼叫汤姆少校"
	quest.36F2726DEC214FFC.quest_desc: ["跳得更高，着陆更稳，像天生就该这样一样弹跳。"]
	quest.36F2726DEC214FFC.quest_subtitle: "蹦蹦跳跳是它们最擅长的事情。"
	quest.36F2726DEC214FFC.title: "Boing"
	quest.36F698A3688DD1E4.quest_desc: ["苍白花园的苍白橡木呈幽灵般的白色，吱吱作响的心脏树脂能制成温暖的橙色砖块。适合营造忧郁氛围的材料。"]
	quest.36F698A3688DD1E4.quest_subtitle: "幽灵般的木材。"
	quest.36F698A3688DD1E4.title: "苍白而有趣 (Pale and Interesting)"
	quest.3702FD2B71D795D3.quest_desc: [
		"大炮由一系列方块组成：后端的炮闩或末端、装火药的药室和用于增加射程的炮管部分。将其放置在炮架上并用扳手组装。通过炮口（或炮闩，如果你的大炮有）装入火药和炮弹，然后用红石发射。"
		""
		"你的第一门大炮很可能是铸铁的。但它不会是最后一门。"
	]
	quest.3702FD2B71D795D3.quest_subtitle: "洞里着火了！Fire in the hole!"
	quest.3702FD2B71D795D3.title: "瞄准，准备，开火！"
	quest.3736C314230BE7B0.quest_desc: ["传送门是一个围绕传送门终端建造并由传送驱动器供电的传送门方块环。传送放大器可将该环扩大至半径五十格的巨型规模。用扳手点击终端，即可看到传送门方块的确切位置。"]
	quest.3736C314230BE7B0.quest_subtitle: "七号星形螺栓，已锁定。"
	quest.3736C314230BE7B0.title: "星际之门"
	quest.3737E12E579523E6.quest_desc: ["下界堡垒已长成巨大的下界砖城堡，墙上站着烈焰人，大厅里则是凋零骷髅。"]
	quest.3737E12E579523E6.quest_subtitle: "下界砖，炽热难耐。"
	quest.3737E12E579523E6.subtitle: "在炎热之地的某个角落。"
	quest.3737E12E579523E6.title: "毁灭堡垒"
	quest.37493C42095E23AC.quest_desc: ["舵可以控制船只的航向。把它安装在船尾，连接到舵轮上，这样你的船就能按照你指引的方向前行了。"]
	quest.37493C42095E23AC.quest_subtitle: "右舷方向难以启动！"
	quest.37493C42095E23AC.title: "稳住船舵，保持方向"
	quest.374E26C67D1B38FC.quest_desc: ["煎的、炒的、烤在吐司上，或是夹在三明治里。鸡蛋是最简单的食材，也是最朴实的食物。"]
	quest.374E26C67D1B38FC.quest_subtitle: "美好的一天从这里开始。"
	quest.374E26C67D1B38FC.title: "清晨的巡视任务"
	quest.377DB44FFF3D23FE.quest_desc: ["钢制火炮由钻孔层制成：从小到大的层焊接成复合炮管和炮膛。它们能装载巨大弹药，将炮弹投向地平线。"]
	quest.377DB44FFF3D23FE.quest_subtitle: "坚固的钢材，绝不妥协。"
	quest.377DB44FFF3D23FE.title: "像坦克一样建造 (Built Like a Tank)"
	quest.379B6143B74D2FEA.quest_desc: ["法棍、辫子面包、脆皮面包、牛奶面包。一家好面包店会出售所有这些，而且都是现烤的。烤制三种不同的面包。"]
	quest.379B6143B74D2FEA.quest_subtitle: "把面包带回家。"
	quest.379B6143B74D2FEA.title: "面包赢家"
	quest.37A727C5DBF31B6B.quest_desc: ["安山岩外壳能装饰竖井和传送带，还能解锁许多配方。剥下树皮，加入安山岩合金。"]
	quest.37A727C5DBF31B6B.subtitle: "把整个作品都装饰起来吧。"
	quest.37A727C5DBF31B6B.title: "外壳"
	quest.37BDE241E2CBE254.quest_desc: ["野外现在栖息着更大型的游戏生物：森林里的鹿、平原上的野牛、林子里的野猪。它们很胆小，一发现你就会立刻逃跑。"]
	quest.37BDE241E2CBE254.quest_subtitle: "斑比，是你吗？"
	quest.37BDE241E2CBE254.title: "Oh Deer"
	quest.37C27A5C9A4821AA.quest_desc: ["声呐能在黑暗水域中看见：地形、生物和其他船只都会显示在屏幕上。在深海，它是你唯一能看见的眼睛。"]
	quest.37C27A5C9A4821AA.quest_subtitle: "只有一次机会，瓦西里。"
	quest.37C27A5C9A4821AA.title: "Ping"
	quest.37FCC770E8CF56BF.quest_desc: ["单只的弹力靴——半双，却不知为何是双倍乐趣。"]
	quest.37FCC770E8CF56BF.quest_subtitle: "这双靴子专为弹跳而生。"
	quest.37FCC770E8CF56BF.title: "一个弹簧靴子"
	quest.380C3928815211D5.quest_desc: ["这家店能做的每种面包、蛋糕、糕点和果酱，至少各做一次。把旗帜挂在顾客能看到的地方：只要旗帜挂着，附近的人都会变得更结实一点。"]
	quest.380C3928815211D5.quest_subtitle: "每一块面包。每一片面包。每一个罐子。"
	quest.380C3928815211D5.title: "整个烘焙坊"
	quest.381A77E69D0FE46D.quest_desc: [
		"从致命高度坠落时，降落伞会自动展开，也可在坠落时手动展开。使用后，按住潜行并使用即可折叠。"
		""
		"悬崖、峡谷和一架正在失高的飞艇：你之后会感谢自己的。"
	]
	quest.381A77E69D0FE46D.quest_subtitle: "汤姆·佩蒂知道这件事。"
	quest.381A77E69D0FE46D.title: "自由落体"
	quest.3826A8C9AAE71030.quest_desc: ["堡垒的楼梯上长着一种奇怪的红色作物。采集十六个下界疣。它是几乎所有药水的基础。"]
	quest.3826A8C9AAE71030.quest_subtitle: "所有药水的基础配方之一。"
	quest.3826A8C9AAE71030.subtitle: "所有药水的基础配方之一。"
	quest.3826A8C9AAE71030.title: "一种奇怪的作物"
	quest.388C542B652D7551.quest_desc: ["将导音哨对准骑火车的乘务员即可绑定。此后，在任何轨道或车站吹响哨子，即可召唤该火车。调度员可在车站吹响哨子，而向空中吹响哨子则会取消行程。"]
	quest.388C542B652D7551.quest_subtitle: "你的坐骑已经准备好了，快上来吧。"
	quest.388C542B652D7551.title: "鸣笛站"
	quest.388E3782923BD3A3.quest_desc: ["世界各地矗立着巨大的地牢，每个都是一场独立的 boss 之战：宫殿、堡垒、塔楼、熔炉和疯人院。它们很难，但值得。找到并征服你的第一个。"]
	quest.388E3782923BD3A3.quest_subtitle: "那些大的家伙们。"
	quest.388E3782923BD3A3.title: "Something Wicked This Way Comes"
	quest.3892D78AC8217D6C.quest_desc: ["你的冲刺获得了重大、永久性的升级。"]
	quest.3892D78AC8217D6C.quest_subtitle: "快跑，福雷斯特，快跑。"
	quest.3892D78AC8217D6C.title: "更快的脚步速度（Faster on Foot）"
	quest.38CAC89BD3826DE4.quest_desc: ["午餐篮自带食物，能为你充饥。长途旅行前带上一个，就不用担心飞行途中会饿了。"]
	quest.38CAC89BD3826DE4.quest_subtitle: "比一般的熊要聪明得多。"
	quest.38CAC89BD3826DE4.title: "野餐时间到了"
	quest.38CC1DEB6411AB58.quest_desc: ["栗、落叶松、沼泽柏、沼泽橡和扇形棕榈：温带荒野和湿地的树木。收集其中两种。"]
	quest.38CC1DEB6411AB58.quest_subtitle: "古老的树木。"
	quest.38CC1DEB6411AB58.title: "远古生长"
	quest.38F139BC1DF4EA7A.quest_desc: [
		"在 Farbound 中无法制作毛绒玩具。唯一获得方法就是遇到原型生物。找到动物、驯服它，或击败怪物，毛绒玩具就会出现在奖励袋中。"
		""
		"把它们摆上货架，填满你的飞艇客舱，或是建个毛绒娃娃祭坛。这一章是一个合集，每一篇都讲述着一个故事。"
	]
	quest.38F139BC1DF4EA7A.quest_subtitle: "毛绒玩具不是制作的，而是赢得的。"
	quest.38F139BC1DF4EA7A.title: "必须把它们全部捕捉回来"
	quest.38FF2D0912B9B8D6.quest_desc: ["显示器能为你的电脑提供真正的屏幕。将它们放置在电脑旁边，即可组合成大型墙壁。高级显示器则为仪表盘和控制面板增添了色彩和触控输入功能。"]
	quest.38FF2D0912B9B8D6.quest_subtitle: "一次显示多行内容。"
	quest.38FF2D0912B9B8D6.title: "屏幕上显示的内容如下："
	quest.39538E791C389473.quest_desc: [
		"Sequenced Assembly 在传送带上构建复杂部件：这里一个压机，那里一个放置器，再往下一个出料口。物品会反复经过各个工作站，直到建造完成。"
		""
		"第一个也是最重要的成果是精密机制。建造一条能制造它们的线路。"
	]
	quest.39538E791C389473.quest_subtitle: "第一步，第二步，第三步……"
	quest.39538E791C389473.title: "需要组装"
	quest.396CB8FFFC5B116F.quest_desc: ["带有雷达天线或雷达板的雷达罗盘会扫描天空，并在监视器上显示船只、生物和玩家。平面雷达则覆盖固定方向。把它安装在你的飞艇上，就再也不会被偷袭了。"]
	quest.396CB8FFFC5B116F.quest_subtitle: "我开了一整晚的车了。"
	quest.396CB8FFFC5B116F.title: "雷达之爱"
	quest.399FD62C7B8D7E42.quest_desc: ["青铜由铜和锡制成。它能制作出介于铁和钻石之间的工具和盔甲，青铜板也出现在多种机器中。"]
	quest.399FD62C7B8D7E42.quest_subtitle: "晚了三千年，却来得正是时候。"
	quest.399FD62C7B8D7E42.title: "青铜时代"
	quest.39C38A5877467F05.quest_desc: ["啤酒花赋予啤酒独特的风味。这款啤酒毫不掩饰其苦味。"]
	quest.39C38A5877467F05.quest_subtitle: "先咬一口，再慢慢品尝。"
	quest.39C38A5877467F05.title: "啤酒花"
	quest.39C5B8CD3CE3832F.quest_desc: ["面包箱能让面包保持新鲜，台面也整洁。面包箱能存放大批面包。"]
	quest.39C5B8CD3CE3832F.quest_subtitle: "比面包盒大吗？（Is it bigger than a breadbox?）"
	quest.39C5B8CD3CE3832F.title: "面包箱"
	quest.39D926DDCB4C3275.subtitle: "包裹在奈瑟铁中。"
	quest.39DF4C59A6CD9C6E.quest_desc: ["推进器支架固定引擎，软管锚和流体软管将燃料输送至各阶段。点燃蜡烛前，先规划好管道。"]
	quest.39DF4C59A6CD9C6E.quest_subtitle: "把它插进去。"
	quest.39DF4C59A6CD9C6E.title: "已骑乘并已加燃料"
	quest.3A042EE6EB1E5D48.quest_desc: ["锅炉上的蒸汽哨在供电时会吹响。堆叠它们以获得更深的音调，并在你的工厂里演奏乐曲。"]
	quest.3A042EE6EB1E5D48.quest_subtitle: "嘟嘟嘟。"
	quest.3A042EE6EB1E5D48.title: "吹响哨子"
	quest.3A0E1AA8FAFC42D5.quest_desc: ["Extendo Grip 让你能触碰到更远的方块。建造飞艇船体底部从未如此安全。"]
	quest.3A0E1AA8FAFC42D5.quest_subtitle: "神探加杰特伸手可及。"
	quest.3A0E1AA8FAFC42D5.title: "冲冲冲，机械臂出动！"
	quest.3A46269EEAC16752.quest_desc: ["压缩升级可将原矿块自动炼成锭，再将锭合成方块。虚空升级则会删除你不想再见的垃圾物品。"]
	quest.3A46269EEAC16752.quest_subtitle: "少即是多。"
	quest.3A46269EEAC16752.title: "紧凑型居住区"
	quest.3A4E5547333208FF.quest_desc: ["下界红宝石藏在深层的下界岩中。它们能制成锋利的工具和盔甲，以及能点燃敌人的火焰红宝石装备。"]
	quest.3A4E5547333208FF.quest_subtitle: "再见了，红宝石星期二。"
	quest.3A4E5547333208FF.title: "红宝石星期二"
	quest.3A58C5A8E026EE48.quest_desc: ["推进器使用松脂制成的松节油运行。砍伐树木，提炼树脂，然后装满桶。"]
	quest.3A58C5A8E026EE48.quest_subtitle: "闻起来有松树的味道。"
	quest.3A58C5A8E026EE48.title: "液态勇气"
	quest.3A754AF0A0129160.quest_desc: ["装上它后，你杀死的生物会掉落更多东西。"]
	quest.3A754AF0A0129160.quest_subtitle: "每次都要把盐撒在肩膀上，一次都不能少。"
	quest.3A754AF0A0129160.title: "敲响木头，祈求好运"
	quest.3A85D3C72AFD516F.subtitle: "一点光亮能吓退怪物。"
	quest.3A95F3E4A17239E0.quest_desc: ["好啤酒需要啤酒花来增添苦味和香气。收集一些来开始酿造吧。"]
	quest.3A95F3E4A17239E0.quest_subtitle: "第一批，第一课。"
	quest.3A95F3E4A17239E0.title: "一点苦涩的味道"
	quest.3AB61AEEB6E7A29A.quest_desc: ["齿轮箱让旋转转向，离合器用红石信号切断，而换挡器则使其反转。用这三者，你就能控制动力的流向。"]
	quest.3AB61AEEB6E7A29A.quest_subtitle: "进入超速模式，全速前进。"
	quest.3AB61AEEB6E7A29A.title: "更换齿轮"
	quest.3AB7AB122DEA62B7.quest_desc: ["在苍白的花园里，吱吱怪只在你不看的时候移动。无法直接伤害它。在苍白橡树的树干里找到隐藏的吱吱怪之心，并打破它以彻底消灭这个生物。"]
	quest.3AB7AB122DEA62B7.quest_subtitle: "别眨眼。眨了眼睛你就死定了。"
	quest.3AB7AB122DEA62B7.title: "不要眨眼"
	quest.3ADCE23F01E2B3A8.quest_desc: ["建造木制酿造台，你的首个正式设备。是时候把谷物酿成值得举杯庆祝的美酒了。"]
	quest.3ADCE23F01E2B3A8.quest_subtitle: "值得举杯庆祝一番的事情。"
	quest.3ADCE23F01E2B3A8.title: "一个谦逊的开端"
	quest.3AE8A099F40421C4.quest_desc: ["穿上它，厨房几乎就能自己运转了。"]
	quest.3AE8A099F40421C4.quest_subtitle: "任何人都可以烹饪。"
	quest.3AE8A099F40421C4.title: "好的，厨师先生"
	quest.3B1B13779A874FA2.quest_desc: ["用刀收割草和麦子可以得到稻草。稻草可以制作画布、绳子、安全网和草垛，还能用来堆肥。"]
	quest.3B1B13779A874FA2.quest_subtitle: "把它打包起来吧。"
	quest.3B1B13779A874FA2.title: "最后一根稻草"
	quest.3B1CBC933C96B2B2.quest_desc: ["水压会压垮脆弱的船体。增压器能让潜艇拥有耐压窗，工业警报器会在船体承受超过极限的压力时警告船员。查看气压计了解外部压力。"]
	quest.3B1CBC933C96B2B2.quest_subtitle: "弗雷迪和大卫都知道了这件事。"
	quest.3B1CBC933C96B2B2.title: "深海压力"
	quest.3B28C3088C156E31.quest_desc: ["林地府邸巨大、黑暗，充满掠夺者和秘密。在幽暗的森林深处找到一座，并在里面度过夜晚。"]
	quest.3B28C3088C156E31.quest_subtitle: "欢迎回家。"
	quest.3B28C3088C156E31.title: "末日宅邸"
	quest.3B2EB964227EF2B5.title: "印刷店"
	quest.3B641FB36E1342AC.quest_desc: ["烈焰人燃烧器用于加热高级混合用的盆。喂食烈焰人以保持其燃烧。"]
	quest.3B641FB36E1342AC.subtitle: "热量才能带来不同。"
	quest.3B641FB36E1342AC.title: "热量"
	quest.3B6CF5FCC57E0B91.quest_desc: ["茅草屋顶和棕榈木板是建造完美海滩小屋的绝佳搭配。天黑后用棕榈火把点亮小屋。"]
	quest.3B6CF5FCC57E0B91.quest_subtitle: "阿罗哈！"
	quest.3B6CF5FCC57E0B91.title: "Tiki小屋"
	quest.3B6D41772208422C.quest_desc: ["盾牌是游戏中最便宜的寿险：一个铁锭、一些木板，骷髅射箭就成背景噪音了。制作它，然后用它挡住攻击。活得更久。"]
	quest.3B6D41772208422C.quest_subtitle: "格挡是一种生活方式。"
	quest.3B6D41772208422C.title: "提高警惕，严阵以待"
	quest.3BC3FBADAF80ED22.quest_desc: ["驯鹿在冰冻的高地上游荡。看到一只，你或许就明白为什么故事里它们会拉雪橇了。"]
	quest.3BC3FBADAF80ED22.quest_subtitle: "你知道达舍和丹瑟这对兄弟吧..."
	quest.3BC3FBADAF80ED22.title: "鲁道夫的表亲们"
	quest.3BC9186CD1F9F6E4.quest_desc: ["展示你的杰作。全速前进的飞空艇、停泊的河船、穿越平原的履带式载具、或是足以配得上地平线的基地。无论是什么，它都当之无愧。"]
	quest.3BC9186CD1F9F6E4.subtitle: "经久耐用，历久弥新。"
	quest.3BC9186CD1F9F6E4.title: "展示案例"
	quest.3BFC6FB80DAAFD6A.quest_desc: ["Repackager 能将多个包裹合并为一个订单，或将订单拆分成多个包裹，使多件商品一同送达。Package Filters 能让漏斗和滑槽按地址对箱子进行分类。"]
	quest.3BFC6FB80DAAFD6A.quest_subtitle: "捆绑销售优惠。"
	quest.3BFC6FB80DAAFD6A.title: "重新包装并发货"
	quest.3BFEA714D00BD4DA.quest_desc: ["战斗圣所会向你发起挑战，敌人从一阶到五阶不等。征服一个即可获得奖励。"]
	quest.3BFEA714D00BD4DA.quest_subtitle: "证明你自己。"
	quest.3BFEA714D00BD4DA.title: "战斗试炼"
	quest.3C24D4F72DE7E955.quest_desc: ["水下遗迹、化石，甚至还有沉没的城市，都藏在温暖或寒冷的海洋中。带上潜水头盔去探索吧。"]
	quest.3C24D4F72DE7E955.quest_subtitle: "失落的城市。"
	quest.3C24D4F72DE7E955.title: "亚特兰蒂斯"
	quest.3C340FA2C86148EF.quest_desc: [
		"核心可升级锤子：冲击核心将挖掘范围扩大到5x5，强化核心可使其持续更久，而破坏核心则能更进一步。随着进度，将它们与更坚固的材料结合使用。"
		""
		"建造一把你选择的升级版锤子。"
	]
	quest.3C340FA2C86148EF.quest_subtitle: "当你唯一拥有的工具是一把锤子的时候..."
	quest.3C340FA2C86148EF.title: "更大的锤子"
	quest.3C531AB2BCCE583F.quest_desc: ["过滤升级决定何者能入，虚空升级则在潮起前摧毁原石。整理背包，每件物品都该有其位。"]
	quest.3C531AB2BCCE583F.quest_subtitle: "整洁的背包就是快捷的背包。"
	quest.3C531AB2BCCE583F.title: "点燃火花，传递喜悦"
	quest.3C542A1FD105F228.quest_desc: ["任何靠近你脸的东西都会被直接推回去。"]
	quest.3C542A1FD105F228.quest_subtitle: "休想过去。还有，退后一点。"
	quest.3C542A1FD105F228.title: "个人空间"
	quest.3CB682BCAA73E87A.quest_desc: ["Farbound 修改了一些原版规则，让旅途充满乐趣而非挫败感。本章收集了这些规则，以及一些让日常生活更轻松的小工具。这里没有任何强制要求，所有内容都很有用。勾选此项以开启本章。"]
	quest.3CB682BCAA73E87A.quest_subtitle: "没人会读条款和条件。把这些读了。"
	quest.3CB682BCAA73E87A.subtitle: "每个方向都值得去探索一番。"
	quest.3CB682BCAA73E87A.title: "阅读小字条款"
	quest.3CDC723C904522F7.quest_desc: ["给导体戴上护目镜，并绑定一个远程透镜。现在你可以在任何地方通过导体的眼睛观察，并且无论它看向何处，你都可以替它按下或拉动。"]
	quest.3CDC723C904522F7.quest_subtitle: "大指挥家正在注视着。"
	quest.3CDC723C904522F7.title: "透过他们的眼睛"
	quest.3CEDD203EF4BD450.quest_desc: ["无线终端能让你远程查看储物空间，站在熔炉旁就能清点库存。用锻造台升级成下界合金的进阶无线终端，覆盖范围更远。"]
	quest.3CEDD203EF4BD450.quest_subtitle: "你的储物空间正面临危险。"
	quest.3CEDD203EF4BD450.title: "长途电话"
	quest.3CF8B710E410A5ED.quest_desc: ["幻术师会创造分身来迷惑敌人。它们藏在棚屋和训练场里。击败本体可获得幻术图腾。"]
	quest.3CF8B710E410A5ED.quest_subtitle: "看得越近，看得越少。"
	quest.3CF8B710E410A5ED.title: "Now You See Me"
	quest.3CFA3800322BE03B.quest_desc: ["螺旋桨轴和螺旋桨齿轮将物品沿船体运输，并从收割机中取出。会飞的联合收割机，怎么样？"]
	quest.3CFA3800322BE03B.quest_subtitle: "占卜者、预言家，管他叫什么呢。"
	quest.3CFA3800322BE03B.title: "从天而降的收获"
	quest.3D02657F2D720F8D.quest_desc: ["将谷物在筒仓中晾干，直至可以酿造。干燥的小麦、大麦、玉米和燕麦，是每一批酿造的基石。"]
	quest.3D02657F2D720F8D.quest_subtitle: "倒酒之前，先要有耐心。"
	quest.3D02657F2D720F8D.title: "烘干谷物"
	quest.3D05FECEE538E6D6.quest_desc: ["谷仓门、小屋门、日式门、玻璃门、现代门和神秘门。还有配套的活板门。挑选完美的前门吧。"]
	quest.3D05FECEE538E6D6.quest_subtitle: "是谁在那里？"
	quest.3D05FECEE538E6D6.title: "砰砰，有人在敲门"
	quest.3D1AA974184CA55A.quest_desc: ["Tweaked Linked Controller 支持带摇杆和扳机的游戏手柄。使用真实手柄驾驶车辆，实现流畅转向和油门控制。"]
	quest.3D1AA974184CA55A.quest_subtitle: "插入控制器。"
	quest.3D1AA974184CA55A.title: "第二名玩家已进入游戏"
	quest.3D1D546A588891E0.quest_desc: ["精致潜影盒在破碎时会保留内容物，并且支持升级。你的便携式仓库。"]
	quest.3D1D546A588891E0.quest_subtitle: "把所有东西都带上你一起走。"
	quest.3D1D546A588891E0.title: "复杂化的潜行方块 (Sophisticated Shulker)"
	quest.3D311B2763EAE324.quest_desc: ["螺旋桨已安装。轴承已校准。船体已注入浮力。现在组装好，出发吧。从高处看，世界大不相同。"]
	quest.3D311B2763EAE324.subtitle: "把地面抛在身后，继续前进。"
	quest.3D311B2763EAE324.title: "飞行能力"
	quest.3D741BD207093EE2.quest_desc: ["锡矿石像铜一样藏在石头里。把它熔炼，或者更好，先粉碎以获得更高的产量。锡本身很软，但与铜混合后就会变成青铜。"]
	quest.3D741BD207093EE2.quest_subtitle: "要是我有一颗心就好了。"
	quest.3D741BD207093EE2.title: "铁皮人 (Tin Man)"
	quest.3D8C34B9AF84BB37.quest_desc: ["沙滩椅、躺椅、遮阳伞和沙滩巾。布置好你的地盘，然后什么也别做，待上一会儿。"]
	quest.3D8C34B9AF84BB37.quest_subtitle: "不在办公室。"
	quest.3D8C34B9AF84BB37.title: "假日模式"
	quest.3DDD95C5C9F9FCD9.quest_desc: [
		""
		"工作台能将你的小 2x2 口袋网格变成真正的 3x3 工坊。几乎所有东西都从这里开始，连飞艇也不例外。"
		""
		"把它放在一个你以后会回来的地方。你的第一个基地不需要很漂亮，只需要存在即可。"
	]
	quest.3DDD95C5C9F9FCD9.quest_subtitle: "第一件家具总是最重要的那件。"
	quest.3DDD95C5C9F9FCD9.title: "餐桌礼仪"
	quest.3DE15264055C7333.title: "你好，邻居"
	quest.3DF818F6A9318724.quest_desc: ["散弹枪是一种猎人武器：声音大、射程近，而且极具说服力。用燧石或钻石弹药来装填它。"]
	quest.3DF818F6A9318724.quest_subtitle: "精明购物，尽在 S-Mart。"
	quest.3DF818F6A9318724.title: "这是我的爆炸棒"
	quest.3E0F0374B47CA6E3.quest_desc: ["世界各地的掉落物中会出现旧照片：记录着无人记得的地点和人物。收集它们吧。每一张都是世界险些遗忘的故事。"]
	quest.3E0F0374B47CA6E3.quest_subtitle: "在你之前，曾有人来过这里。"
	quest.3E0F0374B47CA6E3.title: "Found Footage"
	quest.3E1CD7334DCA7046.quest_desc: ["末地的末影人也有自己的外观，而末地岛屿的末影人最为奇特。它们特殊的珍珠拥有特殊的力量。"]
	quest.3E1CD7334DCA7046.quest_subtitle: "高大、黝黑，来自岛屿的勇士。"
	quest.3E1CD7334DCA7046.title: "众多的末影人 (The Many Endermen)"
	quest.3E20B672B162565B.quest_desc: ["你遇到的生物奖杯：熊、狐狸、狼、烈焰人，甚至还有掠夺者。把它们挂在书房里，讲述你的故事。"]
	quest.3E20B672B162565B.quest_subtitle: "每一件事物都讲述着一个故事。"
	quest.3E20B672B162565B.title: "奖杯室"
	quest.3E25F6C860290C67.quest_desc: [
		"你已经有了叶子，现在需要工具。水壶是你的多功能酿造站。把它放在炉子或其他热源上，开始酿造吧。"
		""
		"&n&oCraft the Stove from HerbalBrews!&r&r"
	]
	quest.3E25F6C860290C67.quest_subtitle: "一个合适的杯子需要时间来制作。"
	quest.3E25F6C860290C67.title: "炉子旁边"
	quest.3E3324D3047B8BAC.quest_desc: ["藤壶会附着在水下墙壁上，抓住任何游得太近的生物。击败一个，并保留一颗牙齿作为证明。"]
	quest.3E3324D3047B8BAC.quest_subtitle: "有什么东西在深处注视着一切。"
	quest.3E3324D3047B8BAC.title: "释放克苏鲁神话中的怪物——克拉肯"
	quest.3E3F886028FBE24F.quest_desc: ["没有杯子，再好的饮品也不完整。制作一堆杯子，把它们整齐地摆放在架子上。"]
	quest.3E3F886028FBE24F.quest_subtitle: "把它们排成一列。"
	quest.3E3F886028FBE24F.title: "随时待命的马克杯"
	quest.3E41209419F21812.quest_desc: ["烟雾、泥炭和石楠。一种让你感觉附近有篝火在燃烧的酒。"]
	quest.3E41209419F21812.quest_subtitle: "装在玻璃瓶里的苏格兰。"
	quest.3E41209419F21812.title: "高地炉火 (Highland Hearth)"
	quest.3E57CA8E2387DE2C.quest_desc: ["沼泽怪是沼泽和试炼密室中的骷髅，会发射毒箭。微风怪是它们在试炼密室中的邻居，会偏转投射物并把你弹来弹去。"]
	quest.3E57CA8E2387DE2C.quest_subtitle: "苔藓覆盖，凶恶无比。"
	quest.3E57CA8E2387DE2C.title: "沼泽标准旗帜"
	quest.3E61666B52A2230F.quest_desc: ["The Slicer 是一种 Create 机器，它装有刀具，可以在传送带或存储箱上切割食材，就像砧板一样。Deployers 可以操作炉灶和烹饪锅。整个厨房通过旋转来协同工作。"]
	quest.3E61666B52A2230F.quest_subtitle: "Ginsu 刀具，机械化版。"
	quest.3E61666B52A2230F.title: "切片与切割"
	quest.3E7B2E12F38628D5.quest_desc: ["暴力能让你起飞。智能螺旋桨能高效地让你保持在空中。调整桨距以获得你想要的飞行方式。"]
	quest.3E7B2E12F38628D5.subtitle: "云端之上的精准操作。"
	quest.3E7B2E12F38628D5.title: "智能的"
	quest.3EEB3E03F386DBF5.quest_desc: ["Create Addition 添加了电力。电动机将储存的能量转化为旋转。"]
	quest.3EEB3E03F386DBF5.subtitle: "电力转化为旋转。"
	quest.3EEB3E03F386DBF5.title: "电动的"
	quest.3EF434B809B1452D.quest_desc: ["智能矢量推进器听从飞行计算机的指令并自行瞄准。无论是小型、大型还是离子推进器，计算机都会处理角度。"]
	quest.3EF434B809B1452D.quest_subtitle: "它这么认为，所以你不必这么认为。"
	quest.3EF434B809B1452D.title: "智能推进器"
	quest.3F4FC8BFB8D600F0.quest_desc: ["小麦啤酒是地窖里最简单的东西。颜色淡而浑浊，比看上去更好喝。"]
	quest.3F4FC8BFB8D600F0.quest_subtitle: "多云，柔软，真诚。"
	quest.3F4FC8BFB8D600F0.title: "小麦"
	quest.3F6DCBEB47D21620.quest_desc: ["粉末装药推动弹丸，更多装药意味着更远的射程。实心弹穿透墙壁，高爆弹会爆炸，霰弹会扩散，烟雾弹则掩护你的撤退。"]
	quest.3F6DCBEB47D21620.quest_subtitle: "先粉末，再球体。"
	quest.3F6DCBEB47D21620.title: "锁定与装载"
	quest.3F6F4E71D2B65E72.quest_desc: ["油门拉杆是一种紧凑、精准的红石电源。将其连接到燃烧器和引擎上，你就能拥有一个真正的驾驶舱控制器。"]
	quest.3F6F4E71D2B65E72.quest_subtitle: "给它一拳。"
	quest.3F6F4E71D2B65E72.title: "全速前进"
	quest.3F79C170E0D4BF9A.quest_desc: ["野番茄、洋葱、水稻和土豆散落在世界各地，无需农夫。再加上草地和村庄花园里的经典作物，小麦、甜菜根、胡萝卜、卷心菜，第一个围栏桩还没立好，种子袋就已经满了。"]
	quest.3F79C170E0D4BF9A.quest_subtitle: "未包含祖父的信件。"
	quest.3F79C170E0D4BF9A.title: "采集者的幸运 (Forager's Luck)"
	quest.3FB023FE1FCA4B6E.subtitle: "本整合包能提供的最佳体验。"
	quest.3FD04F0C91F263CF.quest_desc: ["最深的海沟里栖息着最奇特的生物：长着发光鱼饵的安康鱼、巨型鱿鱼、皱鳃鲨，还有头骨透明的灯笼鱼。带上光源和逃生计划。"]
	quest.3FD04F0C91F263CF.quest_subtitle: "下面潜伏着未知的危险。"
	quest.3FD04F0C91F263CF.title: "深渊凝视着你"
	quest.4007CCF192811668.quest_desc: ["每种金属都有装饰性硬币，可以堆叠成硬币堆。它们买不了任何东西，但宝藏室需要宝藏。"]
	quest.4007CCF192811668.quest_subtitle: "每一分钱都至关重要。"
	quest.4007CCF192811668.title: "天降的便士"
	quest.402D55682C006FDC.quest_desc: ["用信纸和羽毛笔写一封信，用印章封好，并在上面写下收件人的名字。信件可以随附几件小物品。"]
	quest.402D55682C006FDC.quest_subtitle: "手写总是比打印的好。"
	quest.402D55682C006FDC.title: "亲爱的日记本"
	quest.403945A2888C6E68.quest_desc: ["木制工具磨损快。制作一套完整的石制工具，让挖掘、砍伐和战斗都更轻松。"]
	quest.403945A2888C6E68.quest_subtitle: "石头能打败空手。"
	quest.403945A2888C6E68.subtitle: "石头能打败空手。"
	quest.403945A2888C6E68.title: "石制工具"
	quest.403BFDB155D1BD57.quest_desc: ["古董地图集以手绘古地图的风格描绘你的旅途。标记你的发现，再也不会找不到回那个可爱村庄的路。"]
	quest.403BFDB155D1BD57.quest_subtitle: "古老的地图早已知晓一切。"
	quest.403BFDB155D1BD57.title: "地图制作者"
	quest.4045180CEEDC6CD5.quest_desc: ["猴面包树孤零零地立在稀树草原上，它们的果实可以吃。找一个吧。"]
	quest.4045180CEEDC6CD5.quest_subtitle: "又是无忧无虑的一天，哈库那·玛塔塔。"
	quest.4045180CEEDC6CD5.title: "生命之树"
	quest.406F90F61CBB7A03.quest_desc: ["在空中第二次跳跃，正好在你即将开始下落的时候。"]
	quest.406F90F61CBB7A03.quest_subtitle: "二段跳已解锁。"
	quest.406F90F61CBB7A03.title: "九霄云外"
	quest.408C966DF3FCEE06.quest_desc: ["咖啡植物会产出咖啡豆，烘焙后可冲泡饮用。烘焙咖啡豆可制作咖啡、咖啡饼干和咖啡芝士蛋糕。棉花可产出用于制作帆布和线的纤维。"]
	quest.408C966DF3FCEE06.quest_subtitle: "主宰着清晨的那颗咖啡豆。"
	quest.408C966DF3FCEE06.title: "不过在开始之前，先喝杯咖啡"
	quest.409D2C89678B3DA7.quest_desc: ["每杯茶都始于单株嫩芽。用剪刀剪任何原版花朵，你都会找到一朵茶花。"]
	quest.409D2C89678B3DA7.quest_subtitle: "每一杯都始于此处。"
	quest.409D2C89678B3DA7.title: "第一株幼苗"
	quest.40A5DD600D0E3B11.quest_desc: ["举起它来击退弓箭，或在返回途中轻柔地飘落下来。"]
	quest.40A5DD600D0E3B11.quest_subtitle: "这感觉真是太棒了，令人振奋不已。"
	quest.40A5DD600D0E3B11.title: "雨中漫步，歌声飞扬"
	quest.40C0A21F28D792EA.quest_desc: ["手摇曲柄是你最初的旋转动力。亲手转动它，感受创造引擎的运作。总有一天蒸汽机将替你完成这项工作。但现在，该你了。"]
	quest.40C0A21F28D792EA.subtitle: "旋转从你的手开始。"
	quest.40C0A21F28D792EA.title: "曲柄"
	quest.40C27A6BDF9807CF.quest_desc: ["黄铜隧道可将物品分流并平衡分布在平行的传送带上。自动分拣器的核心。"]
	quest.40C27A6BDF9807CF.subtitle: "一个腰带，一件物品。"
	quest.40C27A6BDF9807CF.title: "分类整理中"
	quest.40C31BE50476283A.quest_desc: ["机械锯可以切割木头和石头，竖着放置时还能砍倒整棵树。"]
	quest.40C31BE50476283A.title: "锯子"
	quest.40CBB53006BC8EFA.quest_desc: ["花环、花圈、烛环、树上饰品、仙女灯和星星顶饰。装饰一棵树，让你的家在冬季闪闪发光。"]
	quest.40CBB53006BC8EFA.quest_subtitle: "年度最佳。"
	quest.40CBB53006BC8EFA.title: "最棒的时光莫过于此了"
	quest.40CE1DCD252567FB.quest_desc: ["曝光的底片只是一张承诺。Lightroom 会将其冲洗，并将你的照片一张张印在纸上。建造一台，调暗灯光，看着照片逐渐显现。"]
	quest.40CE1DCD252567FB.quest_subtitle: "在这里，回忆变得真实可触。"
	quest.40CE1DCD252567FB.title: "暗室 (The Darkroom)"
	quest.4101472CA58F794E.quest_desc: ["登上月球。重力很低，尘土是灰色的，在你之前从未有人来过。插上旗帜。"]
	quest.4101472CA58F794E.quest_subtitle: "这是人类的一大步。"
	quest.4101472CA58F794E.title: "一小步，一大步"
	quest.4109F4E2BB95D63B.quest_desc: ["你的首款佳酿。红酒、樱桃酒、苹果酒：打开一瓶庆祝一下吧。"]
	quest.4109F4E2BB95D63B.quest_subtitle: "酒中自有真情在。"
	quest.4109F4E2BB95D63B.title: "酒中见真意"
	quest.410F1CEAF1B13EEB.quest_desc: ["用高地产牛剪粗羊毛，用乌木牛剪斜纹布，其余手工毡化：副手拿材料，主手拿针，右键。然后用匹配的布料装饰整个小屋。"]
	quest.410F1CEAF1B13EEB.quest_subtitle: "七种布料，一根针。"
	quest.412CAE782DCD025D.quest_desc: ["Shima Enaga是一种生活在寒冷森林里、长得像棉花球一样的白色小鸟。而跳跃蜘蛛则在草丛中捕猎，近距离看竟然很可爱。"]
	quest.412CAE782DCD025D.quest_subtitle: "世界上最蓬松的鸟类。"
	quest.412CAE782DCD025D.title: "带翅膀的雪球"
	quest.4139CC2D22B70669.quest_desc: ["真正的安全标识：出口、灭火器、危险警告、防护装备、禁止吸烟。在反应堆上放辐射标志，蒸汽房里放护耳标志。专业精神。"]
	quest.4139CC2D22B70669.quest_subtitle: "如果我们想的话，可以一起跳舞。"
	quest.4139CC2D22B70669.title: "安全之舞"
	quest.415EFE96B6E77666.quest_desc: ["猪肘、香肠、炸鸡、饺子、半只鸡。总是与一品脱啤酒相伴的美食。"]
	quest.415EFE96B6E77666.quest_subtitle: "搭配冷饮享用更佳。"
	quest.415EFE96B6E77666.title: "酒馆菜单"
	quest.41700B337FC1078D.quest_desc: ["棕榈吧台和藤条屋顶下的吧凳，构成了海滩上最棒的酒吧。迷你冰箱能让饮料保持冰爽。"]
	quest.41700B337FC1078D.quest_subtitle: "又在慢慢消耗生命了。"
	quest.41700B337FC1078D.title: "玛格丽塔维尔"
	quest.418788C67FEAA907.quest_desc: ["冰学家从上方冻结你，幻术师让你怀疑自己的眼睛，野火则戴着不属于自己的王冠。击败这三人，夺取他们所携带之物。"]
	quest.418788C67FEAA907.quest_subtitle: "两个图腾和一个非常生气的帽子。"
	quest.418788C67FEAA907.title: "诅咒与王冠"
	quest.41AC64117E39C6A8.quest_desc: ["带箱子的船能载着战利品回家。储物船能载着可升级的完整储物方块。更有带炮的船，适合更具攻击性的水手。"]
	quest.41AC64117E39C6A8.quest_subtitle: "带上它，一起带走吧。"
	quest.41AC64117E39C6A8.title: "货物舱"
	quest.41D8658E5454B4CE.quest_desc: ["点燃传送门，踏入更丰富、更全面的下界。"]
	quest.41D8658E5454B4CE.subtitle: "炎热、严酷，而又必要。"
	quest.41D8658E5454B4CE.title: "下界"
	quest.4210A4DC353EBBB1.quest_desc: ["制导引信将炮弹引向雷达追踪的目标。雷达告警接收器会在有人锁定你时发出提示。"]
	quest.4210A4DC353EBBB1.quest_subtitle: "点击即可操作。"
	quest.4210A4DC353EBBB1.title: "智能弹药模组 (Smart Munitions)"
	quest.421ABBEDCBBFF8BB.quest_desc: ["墙边有个砖块计数器，能用水桶注水的洗手池，存放面粉的橱柜和抽屉，还有门前挂着名字的街牌。现在这里是一家面包店了。"]
	quest.421ABBEDCBBFF8BB.quest_subtitle: "计数器，水槽，告示牌。"
	quest.421ABBEDCBBFF8BB.title: "开业大吉"
	quest.42254F4D0CFD010A.quest_desc: ["陀螺螺旋桨轴承能让螺旋桨保持向上倾斜，从而稳定整个船体。若向下倾斜，甚至可以支撑起浮空岛屿。当你不需要时，用红石即可关闭向上倾斜功能。"]
	quest.42254F4D0CFD010A.quest_subtitle: "平衡才是最重要的。"
	quest.42254F4D0CFD010A.title: "Spinning Plates"
	quest.425E5F04E5B431AF.quest_desc: ["地球仪展示着你的世界的迷你旋转版。它的复古款则像老探险家的道具。两者放在书房或船长桌上都堪称绝配。"]
	quest.425E5F04E5B431AF.quest_subtitle: "接下来去哪儿，菲利斯先生？"
	quest.425E5F04E5B431AF.title: "转动地球仪"
	quest.4270824292824523.quest_desc: ["茂密的丛林神庙隐藏在绿意中。藤蔓、陷阱，还有黑暗中窥视的未知。"]
	quest.4270824292824523.quest_subtitle: "快跑！"
	quest.4270824292824523.title: "神庙逃亡"
	quest.4278945163685C63.quest_desc: ["蚕蛾在筑巢方块上产卵，蚕吐丝结茧，茧能产出丝绸纤维，用于制作最华丽的服饰。丝绸偶像由此编织而成。"]
	quest.4278945163685C63.quest_subtitle: "转起来吧，小家伙。"
	quest.4278945163685C63.title: "丝绸之虫"
	quest.427A92D4C4DF8DB1.quest_desc: ["机械臂可在多个输入和输出之间分拣物品。一个机械臂可取代一堆混乱的传送带。"]
	quest.427A92D4C4DF8DB1.subtitle: "一条手臂，十二份工作。"
	quest.427A92D4C4DF8DB1.title: "手臂"
	quest.427BD7413DC6AAFB.quest_desc: ["蜻蜓在池塘上空穿梭，可以被驯服甚至装上盔甲。它们的翅膀是绝佳的合成材料。"]
	quest.427BD7413DC6AAFB.quest_subtitle: "非常小的龙。"
	quest.427BD7413DC6AAFB.title: "如何驯服你的蜻蜓（How to Train Your Dragonfly）"
	quest.428F216C227078AB.quest_desc: ["棕榈树生长在热带海滩上。它们的木材非常适合建造沙滩小屋、泰姬吧和木板路，椰子也会从它们的树冠上掉下来。"]
	quest.428F216C227078AB.quest_subtitle: "找到了天堂般的乐园。"
	quest.428F216C227078AB.title: "棕榈树下"
	quest.42B87C3FD7062B74.quest_desc: [
		"承包商提供送货工作。从剪贴板上领取合同，装载所需货物，用飞艇、火车、船或马车将货物运送到指定区域。完成工作，获得马刺报酬。"
		""
		"这就是建造所有船舰的初衷所在。"
	]
	quest.42B87C3FD7062B74.quest_subtitle: "好消息，大家！"
	quest.42B87C3FD7062B74.title: "送货男孩"
	quest.42D739CA0E599A9D.quest_desc: ["巨型轮胎能翻越一切。粘性轮胎能抓住墙壁和斜坡。建造一辆能让高山都望而生畏的卡车。"]
	quest.42D739CA0E599A9D.quest_subtitle: "星期日！星期日！星期日！"
	quest.42D739CA0E599A9D.title: "怪物卡车拉力赛"
	quest.42F1675023F0446A.quest_desc: ["一个好的基地是集停机坪、船坞和车库于一体的地方。用箱子装货，用工作台修理，用熔炉冶炼。出发前先把基地设置好。"]
	quest.42F1675023F0446A.quest_subtitle: "机库、船坞和车库。"
	quest.42F1675023F0446A.subtitle: "机库、船坞和车库。"
	quest.42F1675023F0446A.title: "安顿下来"
	quest.4300FF78B8F98BC8.quest_desc: ["线性马达用磁力发射矿车，磁化锚点将其牵引。制动锚点使其减速。溅落舀斗在水上游乐设施末端激起浪花。"]
	quest.4300FF78B8F98BC8.quest_subtitle: "两秒内从零加速到六十。"
	quest.4300FF78B8F98BC8.title: "发射序列"
	quest.432246F94DFB8F7C.quest_desc: [
		"锤子一挥就能挖掘完整的3x3区域，让隧道和采石场从苦差事变成散步。用石头到下界合金的任何材料都能制作一个。"
		""
		"后续版本会加入冲击核心和加固头部，用于更大区域和更久寿命。从铁开始，看看走廊如何迅速变成大厅。"
	]
	quest.432246F94DFB8F7C.quest_subtitle: "我会在早上进行捶打操作。"
	quest.432246F94DFB8F7C.title: "如果我有一把锤子"
	quest.43247E42E5DCC206.quest_desc: [
		"蜜蜂为作物授粉，并用蜂蜜填满蜂巢。收割前在蜂巢下点燃篝火，否则成群的蜜蜂会跟你拼命。"
		""
		"收集一瓶蜂蜜和一块蜂巢。"
	]
	quest.43247E42E5DCC206.quest_subtitle: "根据所有已知的航空学定律来看……"
	quest.43247E42E5DCC206.title: "蜜蜂电影"
	quest.432F749F0D320B93.quest_desc: ["飞行员护目镜会在你的HUD上显示已放置的飞行组件信息。每位飞行员都戴着一副。优秀的飞行员都会仔细阅读这些信息。"]
	quest.432F749F0D320B93.quest_subtitle: "Top Gun 已批准。"
	quest.432F749F0D320B93.title: "飞行员护目镜"
	quest.4334314504F69DAF.quest_desc: ["速度表和压力表会读取你的网络。注意观察它们，以免过载你的电源。"]
	quest.4334314504F69DAF.subtitle: "在破坏它之前先观察一下。"
	quest.4334314504F69DAF.title: "仪表板"
	quest.43386F95B3E1A154.quest_desc: ["电池储存电力，以备夜间或用电高峰。电容器平滑突变。带储能设备的电网，永不闪烁。"]
	quest.43386F95B3E1A154.quest_subtitle: "现在购买，稍后使用。"
	quest.43386F95B3E1A154.title: "给它充上电"
	quest.433B94AD8C713533.quest_desc: ["水果在坩埚里熬成果酱和果冻。果酱涂面包是早餐。果冻盛在碗里是甜点。"]
	quest.433B94AD8C713533.quest_subtitle: "将爱传播出去。"
	quest.433B94AD8C713533.title: "Jam Session"
	quest.436CB36FE11C0337.quest_desc: ["电磁铁在通电时会吸引并固定物体。将其与机械装置搭配，你就能拥有一个能吊起铁制货物的起重机。"]
	quest.436CB36FE11C0337.quest_subtitle: "磁力的掌控者。"
	quest.436CB36FE11C0337.title: "万磁王"
	quest.439AD76A977635B0.quest_desc: ["吹响长笛，将驯养的宠物召回身边。右键点击特定动物即可将其绑定，从此在森林里再也不会弄丢你的狗了。"]
	quest.439AD76A977635B0.quest_subtitle: "来这儿，小家伙！"
	quest.439AD76A977635B0.title: "吹笛人 (The Pied Piper)"
	quest.439C8641C7A4EA31.quest_desc: ["钢是碳改进的铁，是重工业的支柱：引擎、大炮、火箭和反应堆都需要它。EMI 会显示所有获取途径；一旦有稳定的供应，本章其余内容便会解锁。"]
	quest.439C8641C7A4EA31.quest_subtitle: "比飞驰的子弹还要快。"
	quest.439C8641C7A4EA31.title: "钢铁侠"
	quest.43A609862D70162F.quest_desc: [
		"信封方块包围着一团空气。用热气填满这个空间，它就能产生升力，就像真正的热气球一样。包围的空间越大，升力就越大。"
		""
		"信封有多种颜色。建造一个你引以为傲的气球吧。"
	]
	quest.43A609862D70162F.quest_subtitle: "正在前往地平线的途中。"
	quest.43A609862D70162F.title: "99个气球"
	quest.43CC92DB7B43A9BF.quest_desc: ["一支同时携带七种不同麻烦的乐队。"]
	quest.43CC92DB7B43A9BF.quest_subtitle: "箱子里面是什么？全部七件都齐了。"
	quest.43CC92DB7B43A9BF.title: "一次性七个"
	quest.43EB1B0CCF66D1B2.quest_desc: ["黑沙、蓝沙、粉沙以及由它们制成的砂岩。有些海滩看起来就像被涂过颜料一样。"]
	quest.43EB1B0CCF66D1B2.quest_subtitle: "用所有颜色进行绘画。"
	quest.43EB1B0CCF66D1B2.title: "风之色彩"
	quest.43F0A3133397DA0F.quest_desc: [
		"铁是所有机械的支柱。在地下或裸露的悬崖上寻找带橙色斑点的矿石，将生铁熔炼，并开始囤积。"
		""
		"你需要比想象中更多的东西。你永远都需要比想象中更多的东西。"
	]
	quest.43F0A3133397DA0F.quest_subtitle: "趁热打铁，机不可失，失不再来。"
	quest.43F0A3133397DA0F.subtitle: "更好的东西在地下等着你。"
	quest.43F0A3133397DA0F.title: "钢铁意志"
	quest.44056FB92C785059.quest_desc: [
		"包裹能将一整组混合的小物品存放在单个栏位中。种子、花朵、染料、偶尔的孤独的小金块：把它们扔进去，保持背包整洁。"
		""
		"各种颜色的捆绑包，让你一眼就能分辨清楚。"
	]
	quest.44056FB92C785059.quest_subtitle: "你需要的一切，应有尽有，多余之物，分文不取。"
	quest.44056FB92C785059.title: "轻装上阵"
	quest.441C5594117EC507.quest_desc: ["专为开阔平坦、追求极致速度的地形而打造。"]
	quest.441C5594117EC507.quest_subtitle: "出发行动吧。"
	quest.441C5594117EC507.title: "正在滚动"
	quest.4450927ECA1EF201.quest_desc: ["用创造搅拌机冲泡的建造者茶，能为工程师提供能量爆发。是每个工厂的非官方燃料。"]
	quest.4450927ECA1EF201.quest_subtitle: "足够坚固，能立住一把勺子了。"
	quest.4450927ECA1EF201.title: "建筑师茶会"
	quest.4463088AB5D81E50.quest_desc: ["大型地牢是陷阱与怪物的迷宫。带上朋友，带上药水，带上出路。"]
	quest.4463088AB5D81E50.quest_subtitle: "向着更深处前进。"
	quest.4463088AB5D81E50.title: "越挖越深，越挖越深"
	quest.4466547CA5C9CF9A.quest_desc: ["遗迹得来不易：每一件都被守护、埋藏，或由不再需要它们的生物传承。你找到了所有。无论它们有何用途，使用代价几何，它们现在都属于你，而地图已无更多可予。"]
	quest.4466547CA5C9CF9A.quest_subtitle: "二十二件遗物。世界所有隐藏的能力。"
	quest.4466547CA5C9CF9A.title: "整个宝藏堆（The Whole Hoard）"
	quest.4497EC9656AA0CB3.quest_desc: ["包装器上的库存链接将其物品栏连接到物流网络。每个链接的物品栏都成为可搜索的大库存的一部分，无论其位置如何。"]
	quest.4497EC9656AA0CB3.quest_subtitle: "所有连接都已建立。"
	quest.4497EC9656AA0CB3.title: "蜂巢思维"
	quest.44A3B88BB2FD6AF1.quest_desc: ["砂轮可以去除装备的附魔并返还部分经验。非常适合用来清理那些附了无用附魔的鱼竿，或在给工具附上更好的附魔前进行清洁。"]
	quest.44A3B88BB2FD6AF1.quest_subtitle: "旧的不去，新的不来，经验值滚滚来。"
	quest.44A3B88BB2FD6AF1.title: "Clean Slate"
	quest.44BB40292E49D7A7.quest_desc: ["唱片机升级能让你在行走时播放背包里的音乐唱片。为每一次冒险谱写配乐。"]
	quest.44BB40292E49D7A7.quest_subtitle: "便携式音乐播放器。"
	quest.44BB40292E49D7A7.title: "Walkman"
	quest.44C3F7267952F3B6.quest_desc: ["物品宝库是一个大型可连接的批量存储。将多个合并成一个巨大的缓冲区。"]
	quest.44C3F7267952F3B6.subtitle: "可扩展的存储空间。"
	quest.44C3F7267952F3B6.title: "宝库"
	quest.44EAA7A683D80117.quest_desc: ["Seaglide 是一款手持式推进器，能带你在水中穿行。探索珊瑚礁和残骸将变成一种乐趣，而非单纯的游泳。"]
	quest.44EAA7A683D80117.quest_subtitle: "《Subnautica》既视感。"
	quest.44EAA7A683D80117.title: "Seaglide"
	quest.44ED0F73166170A6.quest_desc: ["斯特林发动机利用热能安静高效地产生旋转动力。用固体或液体燃烧器为其供能，即可驱动飞船系统，无需大型发动机的轰鸣。"]
	quest.44ED0F73166170A6.quest_subtitle: "热量输入，旋转输出。"
	quest.44ED0F73166170A6.title: "安静的力量"
	quest.45341C608B6D5AA9.quest_desc: ["黄铜外壳可解锁更智能、更快速的创造机器层级。"]
	quest.45341C608B6D5AA9.subtitle: "更智能的等级。"
	quest.45341C608B6D5AA9.title: "外壳"
	quest.4547F3CE1E3565F4.quest_desc: ["将面团缠绕在木棍上，在篝火上烤熟。盘中的烤驯鹿，是北方的冬日盛宴。"]
	quest.4547F3CE1E3565F4.quest_subtitle: "串在棍子上的面包，最古老的食谱。"
	quest.4547F3CE1E3565F4.title: "篝火旁的故事"
	quest.456710C3FBAB7130.quest_desc: ["脉冲中继器、脉冲扩展器和脉冲计时器能干净地处理红石计时。带电锁存器能记住信号。建造一个永不漂移的时钟。"]
	quest.456710C3FBAB7130.quest_subtitle: "滴答，滴答。"
	quest.456710C3FBAB7130.title: "时机就是一切"
	quest.45779B0094C572B8.quest_desc: ["野生的啤酒花会爬上树木和围栏。收割它们，种植你自己的啤酒花田。农场田地的大麦、燕麦和小麦可以填满谷仓。"]
	quest.45779B0094C572B8.quest_subtitle: "酿造啤酒的花朵，啤酒花。"
	quest.45779B0094C572B8.title: "干旱咒语"
	quest.459B612C6AE6EB39.quest_desc: [
		"整个食品工业都源于创造机器：披萨、汉堡、通心粉、纸杯蛋糕、冰淇淋、太妃糖以及数百种变体，都在流水线上混合、挤出、压制和烘焙。"
		""
		"用食品工厂里的东西制作点东西。"
	]
	quest.459B612C6AE6EB39.quest_subtitle: "威利·旺卡会批准的。"
	quest.459B612C6AE6EB39.title: "食品加工厂"
	quest.45AB7DD75DDF4A86.quest_desc: ["你的宠物值得更好的食物。宠物碗里的狗粮和猫粮能让你的伙伴保持健康与快乐。"]
	quest.45AB7DD75DDF4A86.quest_subtitle: "有谁肚子饿了吗？"
	quest.45AB7DD75DDF4A86.title: "喂养宠物"
	quest.45AEBC0B9FFE5D2B.quest_desc: ["部署器会像玩家一样，手持物品并对前方的物体进行操作。它能放置、点击、应用和组装。它是下一章所有序列组装配方中的关键。"]
	quest.45AEBC0B9FFE5D2B.quest_subtitle: "一个能模仿你动作的机械臂。"
	quest.45AEBC0B9FFE5D2B.title: "部署手！Deploy the Hand!"
	quest.45C0EA5070953C0B.quest_desc: ["果酱、花蜜和蜜饯都储存在彩色的罐子里。把它们像奖杯一样排列在食品储藏室的架子上。"]
	quest.45C0EA5070953C0B.quest_subtitle: "装满好东西的罐子。"
	quest.45C0EA5070953C0B.title: "把消息传出去，让更多人知道我们的故事。"
	quest.45D16FDC2EF75B4C.quest_desc: ["燕麦为啤酒提供了身躯。这一款能恰到好处地装满杯子。"]
	quest.45D16FDC2EF75B4C.quest_subtitle: "光滑而沉重。"
	quest.45D16FDC2EF75B4C.title: "燕麦"
	quest.45D37BD168E5E4E4.quest_desc: ["末影人箱可以直接在物品栏中右键打开，无需放置。到达末地后，它们将成为运输大量物品的最舒适方式。"]
	quest.45D37BD168E5E4E4.quest_subtitle: "嘿，伙计，听说你喜欢储物空间。"
	quest.45D37BD168E5E4E4.subtitle: "所需的一切，都远离了宝箱的束缚。"
	quest.45D37BD168E5E4E4.title: "盒中盒"
	quest.45DB4A5F87DE42B6.quest_desc: ["警报铃在通电时会响起。将其连接到传感器上，你就能知道反应堆过热、袭击开始或晚餐准备好了。"]
	quest.45DB4A5F87DE42B6.quest_subtitle: "快醒醒，瞌睡虫。"
	quest.45DB4A5F87DE42B6.title: "敲响警钟"
	quest.45F31DF41FE7A573.quest_desc: ["岩盐矿脉遍布洞穴。盐能调味食物，地上的盐线能阻挡不死生物。你也可以在熔炉中煮沸水桶来获取盐。"]
	quest.45F31DF41FE7A573.quest_subtitle: "物有所值，名副其实。"
	quest.45F31DF41FE7A573.title: "尘世之盐"
	quest.460E33BCB8B5E100.quest_desc: ["将任何金属熔化成一桶熔融金属。熔融的铁、铜、金、钢等都可以用管道输送，储存在储罐中，并在需要时铸造成锭。"]
	quest.460E33BCB8B5E100.quest_subtitle: "T-1000 批准了这项任务。"
	quest.460E33BCB8B5E100.title: "液态金属"
	quest.4615A8CF473FB93D.quest_desc: ["导航员会为你规划网络路线，并告知该搭乘的列车。高级显示屏会显示实时发车信息，而火车站时钟则确保所有人准时。"]
	quest.4615A8CF473FB93D.quest_subtitle: "注意那些门。"
	quest.4615A8CF473FB93D.title: "下一站目的地"
	quest.465CA012267A7456.quest_desc: ["过山车轨道和过山车车厢能建造出带物理效果的真实过山车。锚点将轨道固定在半空中。如果你敢的话，就建造一个环形轨道吧。"]
	quest.465CA012267A7456.quest_subtitle: "客人们想体验更刺激的东西了。"
	quest.465CA012267A7456.title: "过山车大亨 (Roller Coaster Tycoon)"
	quest.46617CB0D898A52C.quest_desc: ["找到一个堡垒，收集烈焰棒。你需要它们来酿造和创造热量。"]
	quest.46617CB0D898A52C.subtitle: "火也是有用的。"
	quest.46617CB0D898A52C.title: "烈焰人"
	quest.46745455BA3C651D.quest_desc: ["攻击敌人，有很大几率他们会浑身着火地逃走。"]
	quest.46745455BA3C651D.quest_subtitle: "这样就可以了。"
	quest.46745455BA3C651D.title: "触之温暖"
	quest.467FC258CB97F1CE.quest_desc: ["晶化盔甲由末地水晶锻造而成：轻盈、美丽，充满奇异的力量。"]
	quest.467FC258CB97F1CE.quest_subtitle: "闪闪发光的盔甲。"
	quest.467FC258CB97F1CE.title: "水晶般清澈"
	quest.469F782B36167595.quest_desc: ["速度计显示转轴转速，应力计显示网络是否濒临过载。每个大型建筑都装一个。"]
	quest.469F782B36167595.quest_subtitle: "数字是不会说谎的。"
	quest.469F782B36167595.title: "量两次，切一次"
	quest.46CB6CBA4353DE2E.quest_desc: ["墓地和阴森墓地下躺着不死生物的墓穴。死者在此无法安息。"]
	quest.46CB6CBA4353DE2E.quest_subtitle: "地下有东西在蠢蠢欲动。"
	quest.46CB6CBA4353DE2E.title: "来自地窖的故事 (Tales From the Crypt)"
	quest.46D76BBBEAA689DE.quest_desc: ["货币兑换：马刺换斜齿轮，斜齿轮换链轮，再换齿轮、皇冠和太阳。收集一个斜齿轮和一个链轮，感受日益增长的财富。"]
	quest.46D76BBBEAA689DE.quest_subtitle: "八个斜角，继续前进。"
	quest.46D76BBBEAA689DE.title: "攀登阶梯 (Climbing the Ladder)"
	quest.46DDB9B17753E5A1.quest_desc: ["矢量推进器转动喷嘴以控制火箭方向，RCS推进器则在太空中进行微调。磁力稳定器使整个堆栈保持稳定。"]
	quest.46DDB9B17753E5A1.quest_subtitle: "瞄准火焰，驾驶火箭。"
	quest.46DDB9B17753E5A1.title: "万向节锁定 (Gimbal Lock)"
	quest.46FEFD5323EE0DB8.quest_desc: ["荨麻茶、车前草茶和草莓茶，均由农场里的草药和浆果冲泡而成。"]
	quest.46FEFD5323EE0DB8.quest_subtitle: "荨麻的味道从未如此美味过。"
	quest.46FEFD5323EE0DB8.title: "除草剂"
	quest.47555AED06E07E20.quest_desc: ["时刻表告诉火车何时何地该做什么：在车站等待货物、在设定时间出发、无限循环。交给列车长，火车就会自行运行。"]
	quest.47555AED06E07E20.quest_subtitle: "就像钟表一样准时。"
	quest.47555AED06E07E20.title: "在时间的轨道上奔跑"
	quest.47933BB564630BBF.quest_desc: ["机枪弹和自动炮弹药箱能让快速武器持续开火。高爆弹在空中爆炸，非常适合对付其他飞行器。"]
	quest.47933BB564630BBF.quest_subtitle: "斯卡夫斯知道这件事。"
	quest.47933BB564630BBF.title: "向我的小可爱打个招呼吧"
	quest.47A6EA86E61359A7.quest_desc: ["铸造会留下炉渣。虽然不好看，但炉渣块是很好的工业地板，而且炉渣还能加工成更多的小金块。"]
	quest.47A6EA86E61359A7.quest_subtitle: "物尽其用，不要浪费。"
	quest.47A6EA86E61359A7.title: "矿渣堆"
	quest.47BC6CA48E72424A.quest_desc: ["工业铁是一种更暗、更粗糙的铁，适用于重型机械和硬核建筑。它有专属的锭、板、船体、猫道和梯子。"]
	quest.47BC6CA48E72424A.quest_subtitle: "经久耐用，历久弥新。"
	quest.47BC6CA48E72424A.title: "重工业"
	quest.47C201620F21999A.quest_desc: ["在人群中引爆，爆炸会将附近的所有人冲散。"]
	quest.47C201620F21999A.quest_subtitle: "最古老的玩笑，如今已被武器化。"
	quest.47C201620F21999A.title: "恶作剧坐垫（The Whoopee Cushion）"
	quest.480C7F15A5B921D8.quest_desc: ["物流终端从上方显示所有车站、路线和活跃载具。整支舰队一览无遗。高级应答器可协调多个驱动模块以控制复杂载具。"]
	quest.480C7F15A5B921D8.quest_subtitle: "可以起飞了，一切准备就绪。"
	quest.480C7F15A5B921D8.title: "空中交通管制"
	quest.4816210AC62FB48F.quest_desc: ["螃蟹在沙滩上爬行，挥舞着钳子向你打招呼。蟹钳能让你在建造时伸得更远。企鹅在附近的冰冻海岸上摇摇摆摆地走着。"]
	quest.4816210AC62FB48F.quest_subtitle: "人人都有蟹黄堡可以吃。"
	quest.4816210AC62FB48F.title: "蟹肉堡"
	quest.48189D174F8FA7EC.quest_desc: ["生命值掉的越多，你的脚就会越快把你带离那里。"]
	quest.48189D174F8FA7EC.quest_subtitle: "用大而友好的字体书写而成。"
	quest.48189D174F8FA7EC.title: "别慌，一切都会好起来的。"
	quest.48195C3D39895276.quest_desc: [
		"并非所有恶魂都脾气暴躁。在末地找到的干恶魂，放入水中会慢慢复原成小恶魂幼崽，长大后变成快乐恶魂。给它套上鞍子，就能变成可载四名玩家的温顺飞行坐骑。"
		""
		"你的第一架飞行载具是活的。"
	]
	quest.48195C3D39895276.quest_subtitle: "鲍勃·罗斯一定会喜欢这个的。"
	quest.48195C3D39895276.title: "快乐小云朵"
	quest.483ED5F6631D7840.quest_desc: ["高空的末地船上挂着一个龙头。把它带回村庄的墙上吧。纯粹的炫耀资本。"]
	quest.483ED5F6631D7840.quest_subtitle: "挂在船舵上方的装饰品。"
	quest.483ED5F6631D7840.subtitle: "挂在船舵上方的装饰品。"
	quest.483ED5F6631D7840.title: "一件精美的奖杯"
	quest.484C1AD971C4CFCE.quest_desc: ["冰酒由冰冻的葡萄制成，味道像冬日的阳光。唱片机酒来自末地，味道在地球上找不到任何相似之处。"]
	quest.484C1AD971C4CFCE.quest_subtitle: "原版冰会赞同的。"
	quest.484C1AD971C4CFCE.title: "冰上芭蕾"
	quest.486469284D5459AC.quest_desc: [
		"Farbound的世界广阔多样：高耸的红杉、樱花与樱桃林、秋色枫林、猴面包树稀树草原、发光的魔法森林，以及漂浮在云层之上的天空岛屿。每个生物群系都有独特的树木、花朵和石头。"
		""
		"从一棵你从未见过的树上收集一棵树苗。"
	]
	quest.486469284D5459AC.quest_subtitle: "松德海姆，但树木更多一些。"
	quest.486469284D5459AC.title: "走进森林深处"
	quest.488ACF01944E4F75.quest_desc: ["三极管、五极管、四极管和调节管：能放大、切换和调节的真空管电子元件。它们还闪闪发光，非常漂亮。"]
	quest.488ACF01944E4F75.quest_subtitle: "温暖、发光、模拟的。"
	quest.488ACF01944E4F75.title: "真空管 (Vacuum Tubes)"
	quest.489C72A59EC33206.quest_desc: ["电动机可在电网的任何位置将电能转化为旋转。恒速电机无论负载如何都能保持固定速度。用一根电缆为整张地图上的工厂供电。"]
	quest.489C72A59EC33206.quest_subtitle: "我们要去电动大道好好嗨一把。"
	quest.489C72A59EC33206.title: "电动大道"
	quest.48B15C17A619AA72.quest_desc: ["为那些绕远路的人命名。一路温暖而平稳。"]
	quest.48B15C17A619AA72.quest_subtitle: "每一口都铺就一条道路。"
	quest.48B15C17A619AA72.title: "Cristelwalker"
	quest.48CBCCA0CF66EA7F.quest_desc: ["阿撒莫斯镰刀收集树脂和莲花，荆棘镰刀干净地收割草药。"]
	quest.48CBCCA0CF66EA7F.quest_subtitle: "仪式之刃"
	quest.48CBCCA0CF66EA7F.title: "仪式之刃"
	quest.48F295B876208136.quest_desc: ["便携式引擎燃烧燃料产生旋转，小巧轻便，适用于任何船只。它是驱动螺旋桨最常见的方式。"]
	quest.48F295B876208136.quest_subtitle: "燃料输入，旋转输出。"
	quest.48F295B876208136.title: "便携式电源"
	quest.48FB46A343B35C48.quest_desc: ["悬崖用的登山绳，花园用的浇水壶，长夜里的柴火。这套高山工具包小巧实用，正是高原所需。"]
	quest.48FB46A343B35C48.quest_subtitle: "对于那些会反击的山体部分来说。"
	quest.48FB46A343B35C48.title: "山脉工具包"
	quest.490DC46CF9AC5925.quest_desc: ["蓝图工作台可将一个容器及其所有可移动子部件保存为蓝图。蓝图大炮则能用材料将其重建，就像飞行船只的配方大炮一样。"]
	quest.490DC46CF9AC5925.quest_subtitle: "打印一支舰队。"
	quest.490DC46CF9AC5925.title: "灯光、摄影机、投影装置"
	quest.492013C2F47AD0CD.quest_desc: ["木制瓦片和茅草能做出乡村风格的屋顶。风干的茅草会随时间变成陈年茅草，营造出小屋的沧桑感。"]
	quest.492013C2F47AD0CD.quest_subtitle: "一路叮叮当当地响个不停。"
	quest.492013C2F47AD0CD.title: "一路叮叮当当地响个不停。"
	quest.49752CFCA8383908.subtitle: "比上一个等级更坚固了。"
	quest.49768B112D59D6D6.quest_desc: ["建造一个黑曜石框架，点燃它，然后穿过。下界炎热、充满敌意和宝藏，在 Farbound 中，它比以往任何时候都更加多样化：丛林、沼泽、骨礁、昏暗的森林和蘑菇林，头顶是火焰天花板。带上火焰抗性、盾牌和金靴，点燃传送门。"]
	quest.49768B112D59D6D6.quest_subtitle: "AC/DC 知道这件事。"
	quest.49768B112D59D6D6.subtitle: "前方的道路穿过熊熊烈火。"
	quest.49768B112D59D6D6.title: "AC/DC 知道这件事。"
	quest.498901F90A60EEB3.quest_desc: ["矿车和铁轨是最古老的陆地交通工具。铺上一小段动力铁轨，来一场旅行吧。它缓慢，它迷人，而这仅仅是个开始。"]
	quest.498901F90A60EEB3.quest_subtitle: "整整一天，没完没了地忙碌着。"
	quest.498901F90A60EEB3.title: "铁路轨道"
	quest.49A2CC9C9BE1E8AB.quest_desc: ["地板上、桌子上和书架上堆满了书。书架检视器可以显示任意书架上的书籍。"]
	quest.49A2CC9C9BE1E8AB.quest_subtitle: "书太多，时间太少。"
	quest.49A2CC9C9BE1E8AB.title: "书虫学者"
	quest.49B5E80176B9CA30.quest_desc: ["烘焙冲泡的咖啡豆，适合工厂无法等待的早晨。若长夜漫漫，可加入牛奶。"]
	quest.49B5E80176B9CA30.quest_subtitle: "喝茶需要耐心。而这并不需要。"
	quest.49B5E80176B9CA30.title: "清晨的燃料补给"
	quest.49D84384EBA56EE5.quest_desc: ["无线调制解调器在空中传输消息。末地调制解调器能跨越维度，传遍任何距离。遥控器、传感器网络和能远程通信的袖珍电脑。"]
	quest.49D84384EBA56EE5.quest_subtitle: "没有线缆，不成问题。"
	quest.49D84384EBA56EE5.title: "空中传输 (Over the Air)"
	quest.4A119886FDBC01F4.quest_desc: [
		"你有田地，也有厨房。现在该烹饪了。Farbound 的丰盛餐食能让你饱腹更久，许多食物还能提供慰藉和营养，让你能更长时间地恢复和劳作。"
		""
		"在烹饪锅中烹饪你的第一顿像样的饭菜。"
	]
	quest.4A119886FDBC01F4.quest_subtitle: "朱莉娅·柴尔德向您致敬。"
	quest.4A119886FDBC01F4.title: "祝您好胃口"
	quest.4A177930C330FA9C.quest_desc: ["Roll Puncher 将歌曲录入音乐卷轴，Tracker Bar 则在你的管风琴上播放。为你的大教堂、车站或飞艇打造一台自动演奏的管风琴。"]
	quest.4A177930C330FA9C.quest_subtitle: "它会自己播放。"
	quest.4A177930C330FA9C.title: "自动演奏钢琴模组"
	quest.4A99F3D0E4383E25.quest_desc: ["深海海鲜：炸鱼薯条、蟹肉饼、龙虾浓汤、金枪鱼卷。海洋是最大的宝库。"]
	quest.4A99F3D0E4383E25.quest_subtitle: "塞巴斯蒂安，把眼睛移开。"
	quest.4A99F3D0E4383E25.title: "海底世界菜单"
	quest.4AA1098F59018786.quest_desc: ["酿酒节服装：帽子、连衣裙或裤子、靴子。在第一个桶被打开前穿上。没有人后悔戴过帽子。"]
	quest.4AA1098F59018786.quest_subtitle: "先戴帽子，再谈意见。"
	quest.4AA1098F59018786.title: "节日盛装打扮完毕"
	quest.4AE962E71CE70E1C.quest_desc: ["客厅、厨房、卧室、明亮的灯光和花园。你的家已经完工了，至少，一个家能完工的程度也就这样了。"]
	quest.4AE962E71CE70E1C.quest_subtitle: "再简陋的住所也无所谓。"
	quest.4AE962E71CE70E1C.title: "温馨的小家，我可爱的家"
	quest.4AEEB13F9356C2D2.quest_desc: [
		"欢迎来到 Farbound。"
		"这本书是指南针，不是清单。章节顺序不限，没有强制内容，也没有错误的玩法。本整合包由三部分组成：创造、值得探索的世界，以及带你抵达那里的载具。"
	]
	quest.4AEEB13F9356C2D2.subtitle: "指南针，不是清单。"
	quest.4AEEB13F9356C2D2.title: "欢迎"
	quest.4AEF02E1906B0D36.quest_desc: ["曲速引擎为曲速门提供能量。它是本章要求最高、回报也最丰厚的机器。"]
	quest.4AEF02E1906B0D36.quest_subtitle: "那就照你说的办好了，就这么办。"
	quest.4AEF02E1906B0D36.title: "交战！"
	quest.4AF2E66E41655D12.quest_desc: ["Spout 能将物品装满流体：瓶子、桶，以及许多需要注入某种东西才能完成的物品。Item Drain 则相反，将容器中的内容物排入储罐。"]
	quest.4AF2E66E41655D12.quest_subtitle: "一次一瓶，慢慢来。"
	quest.4AF2E66E41655D12.title: "把它填满"
	quest.4B00124F8AE71976.quest_desc: ["大小矿井、边界矿井和绊线线圈保卫着周边。水雷和鱼雷保护着你的港口。请明智地使用它们，并永远不要忘记放置的位置。"]
	quest.4B00124F8AE71976.quest_subtitle: "小心脚下，注意脚下。"
	quest.4B00124F8AE71976.title: "雷区"
	quest.4B0114B3A8860603.quest_desc: ["峡谷深深切入大地：布莱斯峡谷、沙漠峡谷、紫水晶峡谷。在其中一处飞行。"]
	quest.4B0114B3A8860603.quest_subtitle: "感觉自己好渺小。"
	quest.4B0114B3A8860603.title: "大峡谷"
	quest.4B1DCB40036D5A41.quest_desc: ["放置在包装器上的工厂仪表会读取库存并请求原料以保持生产。连接多个仪表，你就能拥有一个能自行规划供应链的工厂。"]
	quest.4B1DCB40036D5A41.quest_subtitle: "制作它，然后再制作一次。"
	quest.4B1DCB40036D5A41.title: "工厂车间"
	quest.4B52C4C417D87807.quest_desc: ["烈焰人守护着下界堡垒，掉落酿造台的燃料——烈焰棒，也是创造引擎的烈焰燃烧器和末影之眼的关键。"]
	quest.4B52C4C417D87807.quest_subtitle: "迪斯科地狱。"
	quest.4B52C4C417D87807.subtitle: "活儿好，钱给得也多。"
	quest.4B52C4C417D87807.title: "燃烧吧，宝贝，燃烧吧"
	quest.4B564041B861372A.quest_desc: ["螃蟹在海岸线上爬行，掉落有价值的钳子。找到一个，取下钳子，欣赏它坚持走错路的决心。"]
	quest.4B564041B861372A.quest_subtitle: "横向移动是一个有效的方向。"
	quest.4B564041B861372A.title: "螃蟹狂舞"
	quest.4B68F3A53F10C76E.quest_desc: ["指示牌是带有字母、数字、箭头和符号的小牌子。拼出车站名称，给机库编号，或者在门上放个笑脸。"]
	quest.4B68F3A53F10C76E.quest_subtitle: "完美无瑕的信件"
	quest.4B68F3A53F10C76E.title: "完美无瑕的信件"
	quest.4B86A10738538FB6.quest_desc: ["玫瑰石英是红石浸泡的末地石英，再用砂纸打磨而成。它能制作电子管，许多黄铜机器的核心组件。"]
	quest.4B86A10738538FB6.quest_subtitle: "粉色能让一切看起来更美好。"
	quest.4B86A10738538FB6.title: "玫瑰色眼镜 (Rose Tinted Glasses)"
	quest.4BB814E055C92F14.quest_desc: ["每家正经的酿酒厂都有自己的标签。这家也配得上拥有一个。"]
	quest.4BB814E055C92F14.quest_subtitle: "合适的标签才能配得上合适的瓶子。"
	quest.4BB814E055C92F14.title: "卡拉斯科标签"
	quest.4BC7C96255A97724.quest_desc: ["将屋顶、门、窗、木框架和小径融入同一建筑中。一座具有真实建筑风格的完整房屋。"]
	quest.4BC7C96255A97724.quest_subtitle: "弗兰克·劳埃德·赖特批准了。"
	quest.4BC7C96255A97724.title: "建筑师"
	quest.4BD0F3E91B9A7505.quest_desc: ["考古台能将发现物变为答案：鉴定未知遗迹，并利用残片。你挖到的东西，有些是废墟，有些则绝非废墟。"]
	quest.4BD0F3E91B9A7505.quest_subtitle: "可能是垃圾。也可能是历史。"
	quest.4BD0F3E91B9A7505.title: "鉴定任务 (The Appraisal)"
	quest.4BD5AAF27F55D35E.quest_desc: ["鲍勃沿着水面漂浮，缓缓下沉——有失体面，却永不沉没。"]
	quest.4BD5AAF27F55D35E.quest_subtitle: "泳池浮圈升向传奇的殿堂。"
	quest.4BD5AAF27F55D35E.title: "勉强不沉没"
	quest.4BDDC84FEBF47440.quest_desc: ["奶酪卷、奶酪挞、芝士蛋糕、奶酪三明治和烤水牛火腿。烹饪两道奶酪菜肴。"]
	quest.4BDDC84FEBF47440.quest_subtitle: "布雷尔，相信吧。"
	quest.4BDDC84FEBF47440.title: "奶酪爱好者"
	quest.4BEA2F877FBDDCD9.quest_desc: ["你的钱可以存在银行账户里，而不是口袋里。使用银行终端存取款，用银行卡支付无需携带硬币。《银行指南》会解释账户和权限的运作方式。"]
	quest.4BEA2F877FBDDCD9.quest_subtitle: "银行总是赢家。"
	quest.4BEA2F877FBDDCD9.title: "Too Big to Fail"
	quest.4C0FF0CF66538B5B.quest_desc: ["望远镜和全景镜头会改变你的视野：可以拉近看远处的山脉，也可以用广角镜头拍下整个山谷。"]
	quest.4C0FF0CF66538B5B.quest_subtitle: "每一个细节都考虑到了。"
	quest.4C0FF0CF66538B5B.title: "放大视图"
	quest.4C1D6F0F68850182.quest_desc: ["所有非武装攻击现在都明显更重了。"]
	quest.4C1D6F0F68850182.quest_subtitle: "我喜欢动力手套。它太糟糕了。"
	quest.4C1D6F0F68850182.title: "重型打击者"
	quest.4C1F1CA5213F6454.quest_desc: ["物品筒仓是一个用于存放大量物品的垂直容器，流体容器是一个侧放的流线型储罐，而物品栏桥梁则将两个物品栏连接起来，仿佛它们是一个整体。"]
	quest.4C1F1CA5213F6454.quest_subtitle: "为农民工程师设计的垂直储物空间。"
	quest.4C1F1CA5213F6454.title: "筒仓"
	quest.4C31283CE9852DFB.quest_desc: ["在某个深处，生长着一种奇怪的晶体矿石。没人确切知道它是什么。开采它，从原矿到粗品再到抛光，妥善保管。"]
	quest.4C31283CE9852DFB.quest_subtitle: "在无人注视时，它会发出嗡嗡声。"
	quest.4C31283CE9852DFB.title: "神秘水晶"
	quest.4C3610796EA365F7.quest_desc: ["蘑菇田坐落在遥远的海上：没有怪物，只有巨大的蘑菇和温顺的蘑菇怪。完美的秘密岛屿基地。"]
	quest.4C3610796EA365F7.quest_subtitle: "真菌的天堂。"
	quest.4C3610796EA365F7.title: "视野开阔的蘑菇地"
	quest.4C57F7D965240D51.quest_desc: ["组装眼睛，找到要塞，并开启通往末地的道路。"]
	quest.4C57F7D965240D51.subtitle: "在要塞的更深处。"
	quest.4C57F7D965240D51.title: "末地"
	quest.4C630ACC2A4F0039.quest_desc: ["写封信，盖上印章，交给信鸽。剩下的事就交给它，直到收件人的邮箱。比聊天慢，但更有格调。"]
	quest.4C630ACC2A4F0039.quest_subtitle: "发送一条消息！"
	quest.4C630ACC2A4F0039.title: "P-Mail"
	quest.4C6A2F280C58EF02.quest_desc: ["望远镜也有自己的快捷栏，按快捷键即可缩放，无需手持。非常适合侦察降落点，或确认地平线上的小点究竟是村庄还是掠夺者营地。"]
	quest.4C6A2F280C58EF02.quest_subtitle: "以 A 开头的东西。用于空中船。"
	quest.4C6A2F280C58EF02.subtitle: "降落前请先进行侦察。"
	quest.4C6A2F280C58EF02.title: "我发现了什么（I Spy）"
	quest.4C6DDA1BAFE89920.quest_desc: ["经验值可以通过 XP 泵升级储存在背包储罐中，并倒入桶里。保存好你的等级以备后用。"]
	quest.4C6DDA1BAFE89920.quest_subtitle: "将你的知识倾囊而出。"
	quest.4C6DDA1BAFE89920.title: "液态经验值"
	quest.4C7212D281502738.quest_desc: [
		"石质水道引导水流，而嵌入水道中的水闸格栅可将泥土物品冲刷成新发现。产出物取决于水闸的位置：河流、沙漠、海洋和下界都会产出不同的宝藏。"
		""
		"建造一个带水闸的小渠道，让水流完成淘金。"
	]
	quest.4C7212D281502738.quest_subtitle: "在那边的山丘里有黄金可以挖。"
	quest.4C7212D281502738.title: "黄金热"
	quest.4C8056C393F87B16.quest_desc: ["下界钢是融入了下界能量的钢。下界钢大炮是现存最强的火炮。"]
	quest.4C8056C393F87B16.quest_subtitle: "在末地锻造而成。"
	quest.4C8056C393F87B16.title: "地狱之火"
	quest.4C8AFA54F6DC13B8.quest_desc: ["奶酪架能放奶酪轮，牛奶罐能保鲜牛奶，只要附近有奶牛，它还能自己装满。建好牧场后，几乎能全自动运行。"]
	quest.4C8AFA54F6DC13B8.quest_subtitle: "车轮需要一个架子来支撑。"
	quest.4C8AFA54F6DC13B8.title: "奶酪地窖"
	quest.4C942F77219F25D4.quest_desc: ["投币器可以接受硬币或卡片支付并发出红石信号。用它来收费乘坐电梯、进入博物馆或参加飞空艇之旅。"]
	quest.4C942F77219F25D4.quest_subtitle: "投入硬币以继续。"
	quest.4C942F77219F25D4.title: "付费才能玩"
	quest.4C9FB30F648B19E2.quest_desc: [
		"第一个庇护所让你活了下来。家应该让你感到幸福。本章将围绕家具、灯光和那些让你每次归来都心驰神往的小细节展开。"
		""
		"这里没有任何要求。慢慢来，建造你喜欢的东西吧。"
	]
	quest.4C9FB30F648B19E2.quest_subtitle: "用你的后跟跺三下脚。"
	quest.4C9FB30F648B19E2.title: "没有地方比得上家"
	quest.4CB266D00C9D7BBB.quest_desc: ["在点燃的炉灶上，水壶里的水才真正变成了茶。准备好一切，让它加热，然后倒入第一杯正宗的茶。"]
	quest.4CB266D00C9D7BBB.quest_subtitle: "一个合适的杯子需要时间来制作。"
	quest.4CB266D00C9D7BBB.title: "炉子旁边"
	quest.4CBFF5A05E9F3B25.quest_desc: ["流浪猫生活在村庄里，可以用生鱼驯服。它们会吓走苦力怕和幻翼，偶尔会在早上给你带来礼物。"]
	quest.4CBFF5A05E9F3B25.quest_subtitle: "不是你选择了猫，而是猫选择了你。"
	quest.4CBFF5A05E9F3B25.title: "猫咪分发系统"
	quest.4CD08A600F026A19.quest_desc: ["绳索连接器与绞车可将船只相互或固定在地面上。右键绞车和连接器，并使用绳索耦合器进行连接。收拢绳索即可将船只拉下。"]
	quest.4CD08A600F026A19.quest_subtitle: "将你的船停靠在岸边。"
	quest.4CD08A600F026A19.title: "捆绑敌人"
	quest.4CFB54AFF14CFF6E.subtitle: "每一根木棍都至关重要。"
	quest.4D1787B913F40381.quest_desc: ["蒸汽机装在流体储罐上，由烈焰燃烧器加热并注水，产生巨大旋转力。燃烧器和储罐越大，锅炉等级越高。这才是真实工厂的动力来源。"]
	quest.4D1787B913F40381.quest_subtitle: "咻咻，锅炉发出了声响。"
	quest.4D1787B913F40381.title: "全速前进，蒸汽轰鸣"
	quest.4D264D850272A22B.quest_desc: ["将下界疣酿入水瓶，制成粗制药水。单独使用毫无用处，却是几乎所有酿造的基础。"]
	quest.4D264D850272A22B.quest_subtitle: "单独无用，却是万物必需。"
	quest.4D264D850272A22B.title: "可供建造的基地基础结构（A Base to Build On）"
	quest.4D2814E5F4971936.quest_desc: ["有些瓶子装的不是葡萄，而是名字：当年酿酒人特制的私房酒、以朋友命名的年份酒、为亡王而酿的酒，还有一瓶无人能解释的黑瓶。收集私人酒架。"]
	quest.4D2814E5F4971936.quest_subtitle: "这个上面写着某个人的名字。"
	quest.4D2814E5F4971936.title: "带标签的瓶子"
	quest.4D28BB068C9B6E9A.quest_desc: ["铸造厂和采矿系统是由铁与火构成的工业地牢。工程师会在这里如鱼得水。几乎如此。"]
	quest.4D28BB068C9B6E9A.quest_subtitle: "熔化的金属和愤怒的工人。"
	quest.4D28BB068C9B6E9A.title: "Iron Foundry"
	quest.4D3B93C02C029542.quest_desc: ["通过铜、铁、金和钻石升级到下界合金背包。每个等级都会增加更多格子和升级槽。升级会保留背包内的所有物品。"]
	quest.4D3B93C02C029542.quest_subtitle: "里面比外面大！"
	quest.4D3B93C02C029542.title: "内部比外部大 (Bigger on the Inside)"
	quest.4D47431811AB3272.quest_desc: ["在月球上建造基地：密封、有空气和重力、着陆平台和回家方式。风化砖块让它看起来浑然天成。"]
	quest.4D47431811AB3272.quest_subtitle: "Space 1999 呼叫。"
	quest.4D47431811AB3272.title: "月球基地阿尔法"
	quest.4D62CB4F3FAB27BE.quest_desc: [
		"许多模组都自带游戏内指南。Create 有 Ponder（悬停物品，按 W），而其他模组会添加指南书。"
		"当任务提到机器时，Ponder通常会向你展示如何建造它。"
	]
	quest.4D62CB4F3FAB27BE.subtitle: "机器知道自己在做什么。"
	quest.4D62CB4F3FAB27BE.title: "指南"
	quest.4D6B649552F307E1.quest_desc: ["剪贴板可保存清单，并在机器间复制设置：右键一个，再右键另一个。过滤器、显示配置、列车时刻表等都会复制过去。"]
	quest.4D6B649552F307E1.quest_subtitle: "献给那位健忘的工程师。"
	quest.4D6B649552F307E1.title: "做笔记"
	quest.4D6FEDD6FC3DB3C0.quest_desc: ["主岛之外的传送门通往外端的真正冒险之地。将末影珍珠投入传送门，探索未知世界。"]
	quest.4D6FEDD6FC3DB3C0.quest_subtitle: "在传送门的那一边。"
	quest.4D6FEDD6FC3DB3C0.title: "虚空之旅"
	quest.4D74536E02001F6A.quest_desc: ["建造木制酿造台，你的首个正式设备。是时候把谷物酿成值得举杯庆祝的美酒了。"]
	quest.4D74536E02001F6A.quest_subtitle: "值得举杯庆祝一番的事情。"
	quest.4D74536E02001F6A.title: "一个谦逊的开端"
	quest.4D96DE07D1D67C18.quest_desc: ["海里有新品种的鱼。从船上抛竿，看看有什么咬钩。有些鱼只能在特定水域找到。"]
	quest.4D96DE07D1D67C18.quest_subtitle: "钓鱼的坏日子比工作的好日子更胜一筹。"
	quest.4D96DE07D1D67C18.title: "去钓鱼了"
	quest.4DB41AA22DC51A75.quest_desc: ["农舍厨房有自己的炉灶、炊具和烤盘。不同的食谱，同样的温馨。烤盘下方需要热源，就像任何好锅一样。"]
	quest.4DB41AA22DC51A75.quest_subtitle: "爱才是那个秘密的配料。"
	quest.4DB41AA22DC51A75.title: "奶奶的厨房"
	quest.4DCFF7DAA69F2487.quest_desc: [
		"黑曜石只对钻石镐有反应。将水倒在静止的岩浆上，开采结果，两扇门同时开启：下界传送门和附魔台。"
		""
		"制作一把钻石镐，并收集一些黑曜石。"
	]
	quest.4DCFF7DAA69F2487.quest_subtitle: "耐心等十秒钟。"
	quest.4DCFF7DAA69F2487.title: "比钻石更坚硬"
	quest.4DDC14834735E7A7.quest_desc: ["漂浮船是水上休闲日用的充气筏。棕榈船则是它更坚固的木制同类。"]
	quest.4DDC14834735E7A7.quest_subtitle: "Modest Mouse 知道这件事。"
	quest.4DDC14834735E7A7.title: "漂浮起来"
	quest.4E08CE4019BFC6E1.quest_desc: ["高级火炮技术增加了重型和双联自动炮、制退器、消音器、排烟器和膛线炮管。火箭巢可以齐射无制导火箭。"]
	quest.4E08CE4019BFC6E1.quest_subtitle: "更大、更响、更重。"
	quest.4E08CE4019BFC6E1.title: "全金属外壳"
	quest.4E08E716DBDD8540.quest_desc: ["骨粉适用的植物比平时多得多：甘蔗、仙人掌、藤蔓、下界疣和许多模组作物都会对其产生反应。合成一堆，看看能长出什么来。"]
	quest.4E08E716DBDD8540.quest_subtitle: "骨粉：现在含有更多骨头了。"
	quest.4E08E716DBDD8540.subtitle: "大自然也会做出相应的回应。"
	quest.4E08E716DBDD8540.title: "成长吧，小宝贝，成长吧"
	quest.4E1EA7B914430328.quest_desc: ["对称魔杖能将你放置的每个方块镜像到某个平面或点周围。船体、翅膀和塔楼突然以两倍速度自行建造。"]
	quest.4E1EA7B914430328.quest_subtitle: "一切事物都应当如此这般。"
	quest.4E1EA7B914430328.title: "完美平衡的配方：每个配方都包含等量的红石、煤炭和铁锭。"
	quest.4E59355EA0A385BA.quest_desc: ["升级后的鞍解锁了全套装备系统：马蹄装备、医疗包、稳定器和马具挂钩。合格的骑手需要合格的马具。"]
	quest.4E59355EA0A385BA.quest_subtitle: "为骑手和马匹提供舒适感。"
	quest.4E59355EA0A385BA.title: "时尚骑行"
	quest.4E68F9F2BCADDA81.quest_desc: ["风车轴承和风帆直接从空气中获取动力。填充船帆的同样风力，也能让你的机器持续运转。更大的风帆，更强的动力。"]
	quest.4E68F9F2BCADDA81.subtitle: "来自开阔天空的力量。"
	quest.4E68F9F2BCADDA81.title: "风车"
	quest.4E79D7BE49DC1869.quest_desc: ["附近没有油？用种子和作物种植油，发酵乙醇和生物柴油也能让引擎运转。批量发酵器能将植物转化为乙醇。"]
	quest.4E79D7BE49DC1869.quest_subtitle: "绿色出行，快速前进。"
	quest.4E79D7BE49DC1869.title: "绿色机器"
	quest.4E9BF772EA3715E6.quest_desc: ["Golems come in many materials now. A hay golem tends farms, a honey golem keeps hives happy, a kelp golem swims, a candle golem lights rooms, a barrel golem carries things and a coal golem smelts. Build three different golems and watch them work."]
	quest.4E9BF772EA3715E6.quest_subtitle: "地球需要更多的哥布林。"
	quest.4E9BF772EA3715E6.title: "哥布林小队"
	quest.4EAC224C04EA6BE7.quest_desc: ["酵母是活的。善待它，它能把谷物变成更好的东西。催它，你什么也得不到。"]
	quest.4EAC224C04EA6BE7.quest_subtitle: "请耐心等待。"
	quest.4EAC224C04EA6BE7.title: "活着的成分 (The Living Ingredient)"
	quest.4EB22DBD4AD6DB57.quest_desc: ["末地不再空无一物：末地鱼在湖泊中畅游，丝绸蛾在巢穴周围飞舞，立方水母在水中漂流，蜻蜓则一闪而过。找到三种末地生物。"]
	quest.4EB22DBD4AD6DB57.quest_subtitle: "虚空中的生活。"
	quest.4EB22DBD4AD6DB57.title: "太空奇物"
	quest.4EB9D73227BAE84F.quest_desc: ["鸡舍用来饲养母鸡，鸡窝用来收集鸡蛋，鸡饲料能让它们持续下蛋。每天早上都有新鲜的鸡蛋。"]
	quest.4EB9D73227BAE84F.quest_subtitle: "伟大的逃脱行动。"
	quest.4EB9D73227BAE84F.title: "小鸡快跑"
	quest.4EEBDB6C7FDDE860.quest_desc: ["Farbound 的村民农民会重新种植收获的作物，并更好地照料村庄的田地。去村庄看看农民工作吧。"]
	quest.4EEBDB6C7FDDE860.quest_subtitle: "它们现在重新种植了。"
	quest.4EEBDB6C7FDDE860.title: "更聪明的农民模组 (Smarter Farmers)"
	quest.4EF2F5AD2E016F3A.quest_desc: ["林茨挞、巧克力挞、发光浆果挞、柠檬挞。用两种不同的水果制作两种不同的挞。"]
	quest.4EF2F5AD2E016F3A.quest_subtitle: "松脆、多汁、完美无瑕。"
	quest.4EF2F5AD2E016F3A.title: "物质的起源 (Tart of the Matter)"
	quest.4EF8C94DE9BB395D.quest_desc: ["末地树木：苔藓发光蘑菇、拉库格罗夫、皮塔德龙、卢西尼亚、泰纳尼亚、螺旋树、伞形树、龙树和巨型果冻蘑菇。收集两种不同的末地木材。"]
	quest.4EF8C94DE9BB395D.quest_subtitle: "你不是本地人吧。"
	quest.4EF8C94DE9BB395D.title: "异形树木"
	quest.4F0AEB98448739A1.quest_desc: ["黄铜外壳容纳着这个时代的智能机器。制作一叠吧。顺便一提，铜外壳是流体机器的家，两者在建筑上都非常亮眼。"]
	quest.4F0AEB98448739A1.quest_subtitle: "外表黄铜，内心天才。"
	quest.4F0AEB98448739A1.title: "把它封装起来"
	quest.4F19F1D72FECC43E.quest_desc: ["试炼密室已变成一个充满生成器、宝库和气流的神秘迷宫。收集试炼钥匙，打开宝库。"]
	quest.4F19F1D72FECC43E.quest_subtitle: "疯狂的密室，名副其实。"
	quest.4F19F1D72FECC43E.title: "反复试验与错误修正"
	quest.4F228AFCD68DACE6.quest_desc: ["每个地区都有自己的石头：高地有辉长岩和红岩，山丘有石灰华和粉砂岩，旧森林有板岩和泥灰岩。收集三种不同的天然石头。"]
	quest.4F228AFCD68DACE6.quest_subtitle: "地质学真酷。"
	quest.4F228AFCD68DACE6.title: "岩石收集任务"
	quest.4F3BBE1626A804A5.quest_desc: ["并非所有杯子都来自叶子。木槿带来红色，薰衣草带来宁静。关于薰衣草的警告：剪下花朵可泡茶，但被剪过的花朵永不再生。若想拥有自己的花田，请取整株植物。"]
	quest.4F3BBE1626A804A5.quest_subtitle: "大自然慷慨馈赠，双倍奉还。"
	quest.4F3BBE1626A804A5.title: "花坛 The Flower Bed"
	quest.4F43931B6EFAA124.quest_desc: ["磨石只需轻轻一转，就能研磨矿石和植物。一台出色的初级加工机器。"]
	quest.4F43931B6EFAA124.subtitle: "迈向自动化的第一步。"
	quest.4F43931B6EFAA124.title: "磨坊石"
	quest.4F59488F0D6AC3D8.quest_desc: ["阿罗拉松生长在高海拔的雪地森林中。其浅色木材可制作家具、烹饪台、盥洗盆、浴缸，甚至还有厕所。一种木材，成就完整的阿尔卑斯之家。"]
	quest.4F59488F0D6AC3D8.quest_subtitle: "闻起来像冬天的森林一样。"
	quest.4F59488F0D6AC3D8.title: "瑞士石松 (Swiss Stone Pine)"
	quest.4F631C160F3D92B5.quest_desc: ["甜甜圈、蜜糖苹果和著名的建造者茶：经典的工程师零食。"]
	quest.4F631C160F3D92B5.quest_subtitle: "这个世界配不上你这么好的东西。"
	quest.4F631C160F3D92B5.title: "肉桂卷能量包"
	quest.4F741C803735461F.quest_desc: ["恶魂面团能做出恶魂意面，这是下界独有的意面。搭配奶油享用。"]
	quest.4F741C803735461F.quest_subtitle: "诡异的意大利面。"
	quest.4F741C803735461F.title: "幽灵意面 (Ghost Pasta)"
	quest.4F9102F5C03CCE2C.quest_desc: ["助推器能帮你从发射台获得额外推力。当它们空了，分离器和分离电荷会将其吹走，火箭的其余部分就能更轻地飞行。真正的火箭是分阶段建造的，你的火箭也是如此。"]
	quest.4F9102F5C03CCE2C.quest_subtitle: "已确认进入待命状态。"
	quest.4F9102F5C03CCE2C.title: "助推器分离"
	quest.4F9420D64A1EBB17.quest_desc: ["纸板有各种颜色的方块和窗户，包裹甚至可以染色。把仓库变成波普艺术画廊。"]
	quest.4F9420D64A1EBB17.quest_subtitle: "跳出常规思维，另辟蹊径。"
	quest.4F9420D64A1EBB17.title: "票房办公室"
	quest.4FF020FEAAB3DB55.quest_desc: ["地铁外壳、面板、窗户和活板门将列车变为通勤线路。站台、台阶和扶手则完善了整个场景。"]
	quest.4FF020FEAAB3DB55.quest_subtitle: "注意火车和站台之间的空隙。"
	quest.4FF020FEAAB3DB55.title: "地铁站"
	quest.5025BBFFA937AC20.quest_desc: ["泳池面条、游泳翅膀、鸭子形状的橡胶圈、蝾螈和鹈鹕。建造一个泳池，开一场派对。"]
	quest.5025BBFFA937AC20.quest_subtitle: "炮弹发射！"
	quest.5025BBFFA937AC20.title: "泳池派对"
	quest.50671A3A0A446AFA.quest_desc: [
		"当尖啸者呼唤时，坚守者会从深暗之地升起。它看不见，却能听见每一步，闻到每一口气息。击败它是一项鲜有人尝试的壮举。逃跑才是明智之选。"
		""
		"如果你敢的话，就去击败它吧。"
	]
	quest.50671A3A0A446AFA.quest_subtitle: "盲目、狂暴，而且非常非常强壮。"
	quest.50671A3A0A446AFA.title: "沉默是金"
	quest.50887094339EE23A.quest_desc: ["水晶、水晶球、女巫祭坛、彩色南瓜和猫玩偶。为书架增添一点魔法。"]
	quest.50887094339EE23A.quest_subtitle: "女巫的季节。"
	quest.50887094339EE23A.title: "女巫氛围 (Witchy Vibes)"
	quest.50941F0EC8FEF716.quest_desc: ["双筒望远镜能让你远眺前方并标记目标。每个瞭望台都需要一副。"]
	quest.50941F0EC8FEF716.quest_subtitle: "陆地就在前方！"
	quest.50941F0EC8FEF716.title: "瞭望台"
	quest.50A8CE537E4E9E63.quest_desc: ["头灯、灯泡和黄铜灯可为机器和车辆提供照明。大型尼克斯管板和尼克斯板能以温暖的橙光显示文字。桁架和缆索则将一切连接起来。"]
	quest.50A8CE537E4E9E63.quest_subtitle: "工业照明系统。"
	quest.50A8CE537E4E9E63.title: "灯光、摄影机、开拍！"
	quest.50AD9504627FC772.quest_desc: ["果汁在发酵桶里，并且只在那里，会变成葡萄酒。放入原料，用瓶子作为容器，通过填充栏倒入果汁。然后走开。发酵桶知道自己在做什么。"]
	quest.50AD9504627FC772.quest_subtitle: "时间是最后的配料。"
	quest.50AD9504627FC772.title: "让它安息吧"
	quest.50B682F798652695.quest_desc: [
		"装置图显示了飞行器的详细信息：质量、质心、升力和推力。借助飞行前检查清单，它还会在起飞前提醒你缺少必需品、平衡不佳、部件堵塞和货物不稳等问题。"
		""
		"每次处女航前都阅读示意图。"
	]
	quest.50B682F798652695.quest_subtitle: "蓝图是不会说谎的。"
	quest.50B682F798652695.title: "了解你的船只"
	quest.50F205DA987D3CF2.quest_desc: ["邮箱就像火车的蛙港：停靠车站的火车会收取邮箱里的包裹，并卸下寄往此处的包裹。你的网络现在可以覆盖整张地图了。"]
	quest.50F205DA987D3CF2.quest_subtitle: "还记得 AOL 吗？我们也不记得了。"
	quest.50F205DA987D3CF2.title: "您有新邮件"
	quest.51125CE2C757E15C.quest_desc: ["雪地里矗立着舒适的雪屋，有些雪屋下还藏着秘密房间。大雪屋几乎可以当房子住。"]
	quest.51125CE2C757E15C.quest_subtitle: "你想堆一个雪人吗？"
	quest.51125CE2C757E15C.title: "被冰冻住了，无法动弹。"
	quest.5116DC0014B4241F.quest_desc: ["在末地烹饪需要更热的炉子。末地炉子又热又合适。戈登还是会大喊大叫。"]
	quest.5116DC0014B4241F.quest_subtitle: "是生的！"
	quest.5116DC0014B4241F.title: "地狱厨房"
	quest.512258244FB3CC3E.quest_desc: ["橄榄树生长在温暖干燥的山丘上。采摘橄榄用于厨房，采摘橄榄枝象征和平。"]
	quest.512258244FB3CC3E.quest_subtitle: "和平，还有优质的油。"
	quest.512258244FB3CC3E.title: "橄榄枝"
	quest.512A3E13564EC700.quest_desc: ["流体舱门可填充和排空你点击的流体容器，这样你的储罐就能用桶直接填充，无需管道。易碎流体储罐轻便廉价，适合小任务使用。"]
	quest.512A3E13564EC700.quest_subtitle: "从一个坦克到另一个坦克。"
	quest.512A3E13564EC700.title: "深入挖掘，释放潜能"
	quest.51515C057C676CF5.quest_desc: ["五种颜色的陶土覆盖的乱石、手工砖和雕纹砖，让墙壁呈现出手工质感。"]
	quest.51515C057C676CF5.quest_subtitle: "质朴、粗犷、真实。"
	quest.51515C057C676CF5.title: "Rough Around the Edges"
	quest.51566042FD5F101A.quest_desc: ["即时相机完全跳过了暗房：按下快门，照片便在你手中显影。装入黑白或彩色的即时幻灯片，即刻分发回忆。"]
	quest.51566042FD5F101A.quest_subtitle: "其实没什么用。但还是照做吧。"
	quest.51566042FD5F101A.title: "摇晃它"
	quest.5169BA7DC1B5DB11.quest_desc: ["从旅途中带回树苗和植物，在家中种植它们。"]
	quest.5169BA7DC1B5DB11.subtitle: "将世界带回家。"
	quest.5169BA7DC1B5DB11.title: "树苗"
	quest.516C677DC1927CEE.quest_desc: ["末影之眼是末影珍珠和烈焰粉的混合物。投掷一个，它会飞向最近的要塞。制作十几个，然后跟随着它们。"]
	quest.516C677DC1927CEE.quest_subtitle: "跟随眼睛的方向前进。"
	quest.516C677DC1927CEE.subtitle: "把它们指向天空方向。"
	quest.516C677DC1927CEE.title: "观察者之眼（Eye of the Beholder）"
	quest.5185D3AA37799125.quest_desc: ["仪式需要仪式祭坛，点燃并撒上盐，围绕仪式桌放置。献上祭品，用附魔透镜激活，然后就会发生一些事情。"]
	quest.5185D3AA37799125.quest_subtitle: "在火焰上撒盐。"
	quest.5185D3AA37799125.title: "点燃火盆"
	quest.518FCF366FE39EF5.quest_desc: ["全套钻石装备：头盔、胸甲、护腿、靴子。昂贵、闪亮，每一块矿石都物有所值。走进下一个地牢，你就是最靓的仔。"]
	quest.518FCF366FE39EF5.quest_subtitle: "穿戴上你的净资产价值吧。"
	quest.518FCF366FE39EF5.title: "钻石是永恒的"
	quest.51A80A04F2B57906.quest_desc: [
		"欢迎来到 Farbound。这个世界等待着被探索：穿越道路、河流、天空，总有一天还有火箭。此刻，你空手而来，迎接朝阳，而伟大的探险，总是始于此刻。"
		""
		"这本书是你的旅行日志。章节会随着你的旅程而解锁，烹饪、摄影和音乐等副章节从一开始就可用，这里没有任何一项需要争分夺秒。迈出第一步，剩下的自然会跟上。"
	]
	quest.51A80A04F2B57906.quest_subtitle: "独自行动是很危险的。"
	quest.51A80A04F2B57906.title: "远方的召唤 (Farbound Calling)"
	quest.51B05D3B0193C5C4.quest_desc: ["子弹辣椒生长于下界，辛辣到足以爆炸。将其磨成辣椒粉，制作出本整合包中最辛辣的菜肴。"]
	quest.51B05D3B0193C5C4.quest_subtitle: "感觉好热好热好热。"
	quest.51B05D3B0193C5C4.title: "热热热"
	quest.51BC8B9AFD5A0EA0.quest_desc: ["各种颜色的集装箱都是大型储物方块，也能用作港口场景的货物。"]
	quest.51BC8B9AFD5A0EA0.quest_subtitle: "把它们堆得高高的。"
	quest.51BC8B9AFD5A0EA0.title: "集装箱港口"
	quest.51C9CBF5DCF72296.quest_desc: [
		"在任何楼梯或台阶上按 X 即可坐下。长凳、门廊、飞艇甲板：只要看起来像座位，那它就是座位。"
		""
		"小物件，大温馨。快来试试吧。"
	]
	quest.51C9CBF5DCF72296.quest_subtitle: "坐下来，你为此付出了努力，值得拥有。"
	quest.51C9CBF5DCF72296.title: "找个座位坐下"
	quest.51FBD19FA66E49BE.quest_desc: ["炉子能让你开始，但大多数茶需要更多热量。将烈焰粉放入槽中，进一步加热水壶。热量会随时间减弱，所以注意并及时补充。"]
	quest.51FBD19FA66E49BE.quest_subtitle: "热量越多，茶越好喝。"
	quest.51FBD19FA66E49BE.title: "一杯更热的饮品"
	quest.5214600E4187796D.quest_desc: [
		"机械活塞会沿着其伸缩杆的极限，将粘连的方块沿直线移动。底盘和强力胶水决定了哪些方块会一同移动。"
		""
		"这是你的第一个装置：一组可以一起移动的方块。"
	]
	quest.5214600E4187796D.quest_subtitle: "真不错。"
	quest.5214600E4187796D.title: "推动它"
	quest.5233ABD3AEBAEC5F.quest_desc: [
		"钢铁盔甲和工具坚固耐用。Paxel将镐、斧头和铲子结合为一，同系列的Hammer则能破坏大片区域。"
		""
		"穿上钢制装备，或者锻造一把Paxel来腾出三个快捷栏位。"
	]
	quest.5233ABD3AEBAEC5F.quest_subtitle: "我是钢铁侠。"
	quest.5233ABD3AEBAEC5F.title: "钢铁侠"
	quest.5245D45ABC594E88.quest_desc: ["柴油发动机燃烧液体燃料，输出强劲稳定的旋转。它能适应蒸汽机无法企及的任何地方，包括各类车辆。"]
	quest.5245D45ABC594E88.quest_subtitle: "先生们，发动引擎，准备出发。"
	quest.5245D45ABC594E88.title: "启动引擎，准备出发"
	quest.524CB3944D6C0A21.quest_desc: ["荆棘弓射出荆棘丛生长的箭矢，海带编织之刃锋利如海。女巫从不赤手空拳。"]
	quest.524CB3944D6C0A21.quest_subtitle: "大自然正在反噬回来。"
	quest.524CB3944D6C0A21.title: "眼中钉，肉中刺"
	quest.52570791F85D9C3C.quest_desc: ["朝你面朝的方向短暂地向前闪烁一段距离。"]
	quest.52570791F85D9C3C.quest_subtitle: "投入战斗。"
	quest.52570791F85D9C3C.title: "短途跳跃"
	quest.52759ACC7706067D.quest_desc: ["大麦是大多数啤酒的核心。把种子种在土里，让它们生长吧。"]
	quest.52759ACC7706067D.quest_subtitle: "一切始于种子。"
	quest.52759ACC7706067D.title: "大麦种子"
	quest.5296E543DBD743CE.quest_desc: ["嗅探者早已灭绝，但它们的蛋仍会出现在温暖的海洋废墟中。孵化一只，它会挖出几个世纪以来无人种植过的远古种子。"]
	quest.5296E543DBD743CE.quest_subtitle: "生命，嗯，总能找到出路。"
	quest.5296E543DBD743CE.title: "侏罗纪公园"
	quest.529B3AC732ABC083.quest_desc: ["将生铁熔炼成锭。铁也是早期 Create 的支柱。"]
	quest.529B3AC732ABC083.subtitle: "一切事物的中流砥柱。"
	quest.529B3AC732ABC083.title: "铁"
	quest.529D1DECCF5AF5A8.quest_desc: ["磨石会把投入的东西磨成粉：小麦磨成面粉，花朵磨成染料，鹅卵石磨成砾石。过程缓慢而稳定，但完全自动化。"]
	quest.529D1DECCF5AF5A8.quest_subtitle: "小麦磨成粉，砾石变宝藏。"
	quest.529D1DECCF5AF5A8.title: "每日劳作"
	quest.52BCE85624178F78.quest_desc: ["二十六种标签，从最普通的红色到会爆炸的那种。地窖里的每款酒都至少酿造过一次，所有酒都同时放在架子上。没人要求你这么做。这正是这件事的意义所在。"]
	quest.52BCE85624178F78.quest_subtitle: "每个瓶子。一次完成。"
	quest.52BCE85624178F78.title: "完整的架子 The Full Rack"
	quest.52D80DB241CFBBDF.quest_desc: ["大桶以正宗酿酒风格储存你的佳酿。一排大桶沿地窖墙壁摆放，正是专业酿酒师的标志。"]
	quest.52D80DB241CFBBDF.quest_subtitle: "来一个桶滚翻滚！"
	quest.52D80DB241CFBBDF.title: "滚筒翻滚"
	quest.5304856DDB430FD3.quest_desc: ["安山合金是一切开端。铁与石熔合，铸就更坚固之物。所有早期机器都以此为基础建造。"]
	quest.5304856DDB430FD3.subtitle: "一切事物的基础所在。"
	quest.5304856DDB430FD3.title: "合金"
	quest.531492C4AF61D164.quest_desc: ["它能将你的辛苦所得的经验值转移到任何你指定的地方。"]
	quest.531492C4AF61D164.quest_subtitle: "分享即关爱，经验值版。"
	quest.531492C4AF61D164.title: "传播财富"
	quest.531C48A485770830.quest_desc: ["砧板能将一种材料变成多种：用刀切片，用斧去皮，用镐敲开。将物品放在上面，右键工具，完成。"]
	quest.531C48A485770830.quest_subtitle: "一切各就其位，井然有序。"
	quest.531C48A485770830.title: "准备工作就绪"
	quest.5335E05B5503842E.quest_desc: ["烘焙的咖啡豆能冲出一杯浓郁的黑咖啡，让你在最漫长的夜间飞行中保持清醒。冲一杯咖啡。"]
	quest.5335E05B5503842E.quest_subtitle: "先喝咖啡，再谈冒险。"
	quest.5335E05B5503842E.title: "起床与劳作"
	quest.5359B78ACAEFB9F8.quest_desc: [
		"JEI 会列出所有物品和配方。将鼠标悬停在物品上，按 R 查看合成方法，按 U 查看其用途。"
		"如果任务物品看起来很陌生，请先在这里查找。"
	]
	quest.5359B78ACAEFB9F8.subtitle: "每个答案都只需一次按键操作即可到达。"
	quest.5359B78ACAEFB9F8.title: "查找物品信息，并显示在物品栏中。查找的物品为：铁锭、金锭、钻石、红石、煤炭、羊毛、木板、泥土、沙子、砾石、雪、草方块、树叶、泥土、石头、砂岩、花岗岩、玄武岩、青金石、钻石原矿、铁原矿、金原矿、红石原矿、煤炭原矿、羊毛、木板、泥土、沙子、砾石、雪、草方块、树叶、泥土、石头、砂岩、花岗岩、玄武岩、青金石、钻石原矿、铁原矿、金原矿、红石原矿、煤炭原矿。"
	quest.538E7732F831F843.quest_desc: [
		"右键点击完全成熟的作物，即可一次性收获并重新种植。小麦、胡萝卜、土豆和大多数模组作物都适用。"
		""
		"你的田地保持整洁，你的背部保持挺直。"
	]
	quest.538E7732F831F843.quest_subtitle: "再也不用手动重新种植了。"
	quest.538E7732F831F843.title: "种瓜得瓜，种豆得豆"
	quest.53BB35063F0EABFF.quest_desc: ["安山岩无处不在：灰色、普通，而且容易被忽视。不管怎样都挖点吧。你将来会用到的每一台机器、每一辆车、每一次飞行，都建立在这块石头之上。"]
	quest.53BB35063F0EABFF.quest_subtitle: "一切始于一块灰色的岩石。"
	quest.53BB35063F0EABFF.title: "岩石底部"
	quest.53FD0D4D995D77EC.quest_desc: ["保险箱只能由所有者打开，破坏时内容物会保留。非常适合共享服务器上的贵重物品，或者只是为了安心。"]
	quest.53FD0D4D995D77EC.quest_subtitle: "我珍贵的宝贝。"
	quest.53FD0D4D995D77EC.title: "安全无恙"
	quest.542E2CF5988734AF.quest_desc: ["在Farbound中，村庄的建造方式有所不同。在附近安家，与当地人交易，为下一段旅程做好准备。"]
	quest.542E2CF5988734AF.subtitle: "每个港口都值得停靠片刻。"
	quest.542E2CF5988734AF.title: "村庄"
	quest.543BF10A509A2BC5.subtitle: "不必感到畏惧。"
	quest.54483DAD8E1696CF.quest_desc: ["要塞是围绕末地传送门建造的庞大图书馆和监狱。投掷末影之眼，跟随它们前往传送门。"]
	quest.54483DAD8E1696CF.quest_subtitle: "条条大路通末地。"
	quest.54483DAD8E1696CF.title: "风暴之眼"
	quest.5452E812ADFBF7FC.quest_desc: ["Joshua trees、palo verde、saxaul 和 ghaf 生长在寸草不生的地方。去沙漠或干旱地区，带回它们的原木之一。"]
	quest.5452E812ADFBF7FC.quest_subtitle: "生命总能找到出路。"
	quest.5452E812ADFBF7FC.title: "干热天气"
	quest.548B79F2053893B9.quest_desc: ["铁路信号将你的网络划分为多个区段，这样多列火车可以共享轨道而不会相撞。轨道观察者会在火车经过时做出反应。"]
	quest.548B79F2053893B9.quest_subtitle: "红色代表停止。"
	quest.548B79F2053893B9.title: "信号箱"
	quest.54B78440994CAED6.quest_desc: ["收集你的第一桶原油。它又稠又黑，价值远超外表。"]
	quest.54B78440994CAED6.quest_subtitle: "石油，也就是黑金。"
	quest.54B78440994CAED6.title: "德克萨斯茶"
	quest.54EF1A450204E18D.quest_desc: ["放置在封闭式风扇前方的催化剂会解锁新的处理类型：打磨、冷冻、沸腾、染色等。每种催化剂都填充了所需材料，例如冷冻所需的粉末雪。"]
	quest.54EF1A450204E18D.quest_subtitle: "新增的风车加工类型。"
	quest.54EF1A450204E18D.title: "催化剂转换器"
	quest.551DD7DCC73C692F.quest_desc: ["盆用于混合和压实物品与流体。它位于机器下方。"]
	quest.551DD7DCC73C692F.subtitle: "每台机器下方的碗状容器。"
	quest.551DD7DCC73C692F.title: "盆地"
	quest.552818680F25999B.quest_desc: ["花箱、种植盆、吊盆和棚架将花园带入家中。用旅途中的花朵填满它们。"]
	quest.552818680F25999B.quest_subtitle: "植物能让人变得快乐。"
	quest.552818680F25999B.title: "园艺大师"
	quest.554BF505934F6498.quest_desc: ["一张铁桌，几把铁椅，窗边还有一张长凳。供顾客在下一批出炉时落座。此外还有一个面包箱和一个巧克力盒，可以直接从地上捡起来吃。"]
	quest.554BF505934F6498.quest_subtitle: "两把椅子和一个承诺。"
	quest.554BF505934F6498.title: "堂食还是外带 (Eat In or Take Away)"
	quest.555588A2EFA3E4CC.title: "废弃营地"
	quest.556835407EECE62F.quest_desc: ["商队正沿路前行，他们带着你寻觅已久的稀有种子、稀有葡萄和稀有瓶子。每次来访，他们的货物都会变化。在他离开前，快买些东西吧。"]
	quest.556835407EECE62F.quest_subtitle: "他认识一个认识藤蔓的家伙。"
	quest.556835407EECE62F.title: "流浪的酿酒师"
	quest.556A2F47CF147176.quest_desc: ["黄铜和玫瑰石英也能制成盔甲。玫瑰石英盔甲散发着柔和的粉光，黄铜盔甲则闪耀着蒸汽朋克的梦幻光芒。纯粹的风格，真正的保护。"]
	quest.556A2F47CF147176.quest_subtitle: "闪闪发光的东西都是好东西。"
	quest.556A2F47CF147176.title: "黄金男孩"
	quest.557796F2E0701023.quest_desc: ["你携带的剑、斧头和工具会显示在背部和腰带上，让所有人都能看到你的装备。纯属装饰，纯属酷炫。"]
	quest.557796F2E0701023.quest_subtitle: "看看这个部分。"
	quest.557796F2E0701023.title: "武装完毕，随时待命"
	quest.559DDEB9C18BEAFF.quest_desc: [
		"铅框玻璃是由细铅框固定的玻璃。将玻璃板放置在其自身上，可循环切换框架图案：网格、菱形、晶格、对角线。为其染色，制作逼真的教堂窗户。"
		""
		"制作一些，给你的家增添点个性吧。"
	]
	quest.559DDEB9C18BEAFF.quest_subtitle: "要有（彩色的）光。"
	quest.559DDEB9C18BEAFF.title: "彩色玻璃窗 Stained Glass Windows"
	quest.55C07335BB525B1F.quest_desc: ["农夫的欢乐带来了真正的烹饪。建造一口烹饪锅来制作浓汤和丰盛的菜肴。"]
	quest.55C07335BB525B1F.title: "Pot"
	quest.55DFC05A9B3B82E4.quest_desc: ["没人确切知道它有什么用，但附近的人总是忍不住流泪。"]
	quest.55DFC05A9B3B82E4.quest_subtitle: "洋葱有层。戒指有洋葱。"
	quest.55DFC05A9B3B82E4.title: "一枚不佩戴的戒指"
	quest.55E690CB06DFFFAA.quest_desc: ["酿酒节服装：帽子、礼服、连衣裙、裤子和鞋子。自豪地穿上它们吧。"]
	quest.55E690CB06DFFFAA.quest_subtitle: "迪恩德尔连衣裙和莱德荷森裤。"
	quest.55E690CB06DFFFAA.title: "节日盛装打扮"
	quest.56136D740DF47B66.quest_desc: ["刷子迎来升级：铁、钻石、下界合金。更好的刷毛，更快的挖掘，更稀有的完整发现。业余爱好者与探险队的区别。"]
	quest.56136D740DF47B66.quest_subtitle: "一把铁锹是不够的。"
	quest.56136D740DF47B66.title: "专业级品质"
	quest.561648ADDDCEEC3C.quest_desc: ["烘焙站没有界面和配方列表。你把面团放上去，然后用刀、擀面杖、果酱来操作。产出完全取决于你的操作顺序。建造工作台，开始实验吧。"]
	quest.561648ADDDCEEC3C.quest_subtitle: "没有菜单。只有双手和工具。"
	quest.561648ADDDCEEC3C.title: "烘焙师的工作台"
	quest.5641928AE28FDCE4.quest_desc: ["浮标能让船体漂浮在水面上。在岸边建造船体，添加浮标，组装好后推入海中。这就是你的第一艘真船。"]
	quest.5641928AE28FDCE4.quest_subtitle: "著名的遗言，可惜来得太晚。"
	quest.5641928AE28FDCE4.title: "永不沉没的船只"
	quest.5678D080673CFE1C.quest_desc: ["锻造模板能让盔甲彰显个性：每种图案都有修饰，颜色取决于你投入的材料。找到模板，敲击锻造台，走出时就像个派系领袖。"]
	quest.5678D080673CFE1C.quest_subtitle: "盔甲，不过是时装界的盔甲。"
	quest.5678D080673CFE1C.title: "时尚宣言"
	quest.568655222616E35E.quest_desc: ["在水淹没你之前，能多争取几秒钟宝贵的时间。"]
	quest.568655222616E35E.quest_subtitle: "继续游下去，继续游下去，不要停下来。"
	quest.568655222616E35E.title: "Just Keep Swimming"
	quest.56D298DC943ECF7C.quest_desc: [
		"Punchy 让你的双手更有重量：流畅的第一人称动画和手持物理效果，挥砍、挖矿和持握装备都更有实感。按 P 打开配置，实时调整。不喜欢？也没关系。"
		""
		"按 P 打开配置。要禁用它，请打开 Punchy 配置菜单，转到兼容性并将“启用 Punchy”设为“关闭”。"
	]
	quest.56D298DC943ECF7C.quest_subtitle: "现在感觉好多了，有感情了。"
	quest.56D298DC943ECF7C.title: "动手实践"
	quest.56E09BBF89CEC7B7.quest_desc: ["从自己的葡萄藤上采摘红白葡萄。好年份始于好果实。"]
	quest.56E09BBF89CEC7B7.quest_subtitle: "葡萄成熟了，可以采摘了。"
	quest.56E09BBF89CEC7B7.title: "丰收时节"
	quest.56EEDB0B5C8D83FD.quest_desc: ["彩色胶片捕捉了 Farbound 的真实面貌：日落、信封，还有你肯定没有的蓝色物品。在 Lightroom 中打印彩色需要染料，但每一分都物有所值。"]
	quest.56EEDB0B5C8D83FD.quest_subtitle: "世界从来都不是灰色的。"
	quest.56EEDB0B5C8D83FD.title: "色彩缤纷的世界"
	quest.56F44502CE3FD6CE.quest_desc: ["并非每批都有名字。当蒸馏器运行太久而无人记录时，就会得到这杯黑暗酿造。"]
	quest.56F44502CE3FD6CE.quest_subtitle: "它就是从桶里直接拿出来的，就是这样。"
	quest.56F44502CE3FD6CE.title: "Something Darker"
	quest.571BF1D5C5012D71.quest_desc: ["Locometal 是制造标准机车所需的材料：铆接板、平板、支柱、烟箱、门、窗和梯子。用采石机将其从铁块中切割，再切割一次即可切换样式。用染料和搅拌机可将其染成任何你喜欢的颜色。"]
	quest.571BF1D5C5012D71.quest_subtitle: "被钉在了原地，动弹不得。"
	quest.571BF1D5C5012D71.title: "铁马（Iron Horse）"
	quest.574EC9505661DB10.quest_desc: ["卷心菜、番茄、洋葱和大米是农家厨房的基础。种植它们，培育它们，收获满满一篮子的每种作物。"]
	quest.574EC9505661DB10.quest_subtitle: "充满生机，忠诚可靠。"
	quest.574EC9505661DB10.title: "卷心菜娃娃（Cabbage Patch Kid）"
	quest.575A184B3D3DE16E.quest_desc: ["高地的石灰岩，山坡的松木，还有木匠来塑形。然后是瓷砖炉：点燃壁炉，所有相连的瓷砖都会升温、烹饪、熏制，还能让你坐在火旁。"]
	quest.575A184B3D3DE16E.quest_subtitle: "像山脉一样建造你的家园。"
	quest.575A184B3D3DE16E.title: "苍白石与松木"
	quest.575C960EE273D4EA.quest_desc: ["车轮支架能安装轮胎，将船变成汽车。轮胎有小型、标准、大型和巨型四种尺寸。在底盘上安装四个车轮，用引擎驱动，你就得到了一辆汽车。"]
	quest.575C960EE273D4EA.quest_subtitle: "圆形是个不错的形状。"
	quest.575C960EE273D4EA.title: "重造轮子（Reinventing the Wheel）"
	quest.577289E33AF7825D.quest_desc: ["建造一个带主风箱和许多排管的风琴，并在配得上这声音的大厅中演奏。"]
	quest.577289E33AF7825D.quest_subtitle: "巴赫回来了。"
	quest.577289E33AF7825D.title: "托卡塔与赋格曲"
	quest.5780F1365DA75079.quest_desc: ["炒饭能把昨天的米饭和鸡蛋变成一顿完整的饭。加上菠萝，就变成盘子里的小热带假日。"]
	quest.5780F1365DA75079.quest_subtitle: "油炸的，从未冷冻过。"
	quest.5780F1365DA75079.title: "很高兴认识你，稻米先生"
	quest.57869A354EC0C5E4.quest_desc: ["Locometal Boiler 是每台蒸汽机的圆形肚子。机械工匠用切好的 locometal、一个桶和一根 blaze rod 来建造它。用扳手拧动它的脸可以改变门的样式，放置时潜行可以将其抬高半个方块。"]
	quest.57869A354EC0C5E4.quest_subtitle: "火车头，火车头。"
	quest.57869A354EC0C5E4.title: "沸腾点"
	quest.5797A89948EB039C.quest_desc: [
		"有些声音令人厌烦。消音器能让你调低或静音任何噪音，让你的基地保持你想要的宁静。"
		""
		"&l运作方式：&r"
		""
		"- 从物品栏或使用快捷键打开GUI"
		""
		"- 点击以静音或调整任何声音的音量"
		""
		"- 静音前预览声音"
		""
		"&l锚点：&r"
		"最多可设置10个区域，在特定地点（如农场或工坊）屏蔽声音。可为每个区域自定义名称和范围。"
	]
	quest.5797A89948EB039C.quest_subtitle: "你的基地，你的规则。"
	quest.5797A89948EB039C.subtitle: "你的基地，你的规则。"
	quest.5797A89948EB039C.title: "宁静与祥和"
	quest.57C6464FCC1DF648.quest_desc: ["红杉树长得极高，消失在云层中。找到一片红杉林，站在巨人的脚下。Farbound 中的大树会长得巨大。"]
	quest.57C6464FCC1DF648.quest_subtitle: "大树参天，你却渺小如尘埃。"
	quest.57C6464FCC1DF648.title: "巨杉 (Giant Sequoia)"
	quest.57C9C2E0F03A652D.quest_desc: ["蒸汽机将热能转化为原始、可扩展的动力。好好喂养它们，它们会回报你一切。驱动整个工厂的，正是让气球升空的原理。"]
	quest.57C9C2E0F03A652D.subtitle: "游戏的终章在蒸汽中轰鸣。"
	quest.57C9C2E0F03A652D.title: "蒸汽"
	quest.58083E79CD3E478B.quest_desc: ["铁路外壳、火车门和火车活板门能让火车看起来更像火车。加上装饰章节的铃铛、驾驶室和车头灯，打造完整外观。"]
	quest.58083E79CD3E478B.quest_subtitle: "看起来挺像那么回事的。"
	quest.58083E79CD3E478B.title: "Rolling Stock"
	quest.580D4F09303CADE2.quest_desc: ["吊床适合白天使用：用绳子和钉子把它挂在两棵树之间，小睡到傍晚。非常适合直接跳过白天，进行夜间飞行或狩猎。"]
	quest.580D4F09303CADE2.quest_subtitle: "没有人能像吊床里的睡美人一样打盹。"
	quest.580D4F09303CADE2.title: "午睡时间到了"
	quest.582437241082C58F.quest_desc: ["船帆能捕捉风力，推动船只前进。风向标显示风的吹向，这样你就能顺着风航行，而不是逆风而行。"]
	quest.582437241082C58F.quest_subtitle: "去我一直有所耳闻的那个地方。"
	quest.582437241082C58F.title: "航行带我远去"
	quest.5840A4DD46D7FE2C.quest_desc: ["传言说，在世界外的旧酿酒帐篷里，有某种东西因啤酒和糟糕的决定而诞生。找到它，击败它。"]
	quest.5840A4DD46D7FE2C.quest_subtitle: "它有生命。而且它还是泡沫状的。"
	quest.5840A4DD46D7FE2C.title: "啤酒的灵魂"
	quest.584CB03B45B78EA7.quest_desc: ["比你想象的更需要各种齿轮箱：平行齿轮箱、六向齿轮箱、黄铜齿轮箱，以及能将旋转直接穿过接口的十字连接器。紧凑的传动系统，适合紧凑的建造。"]
	quest.584CB03B45B78EA7.quest_subtitle: "多种齿轮箱，多种可能性。"
	quest.584CB03B45B78EA7.title: "平行宇宙"
	quest.585FC5EE97311B3A.quest_desc: ["用烈焰棒搭建酿造台。这是酿造各类药水的第一步。"]
	quest.585FC5EE97311B3A.quest_subtitle: "泡泡，泡泡。"
	quest.585FC5EE97311B3A.subtitle: "迈向更优质药水的第一步。"
	quest.585FC5EE97311B3A.title: "第一杯酿造"
	quest.588EBF92E74C4584.quest_desc: ["摧毁黑曜石柱上的末地水晶，然后击败末影龙。它是游戏中最古老的 boss，至今仍值得尊重。"]
	quest.588EBF92E74C4584.quest_subtitle: "龙之呼吸！"
	quest.588EBF92E74C4584.subtitle: "伟大的巨兽倒下了。"
	quest.588EBF92E74C4584.title: "前方有龙"
	quest.5890C07F7D0A0D21.quest_desc: ["药膏能治愈伤口，保护你的皮肤。修补膏和荆棘守卫膏是每个旅行者的急救箱。"]
	quest.5890C07F7D0A0D21.quest_subtitle: "再把它揉进面团里吧。"
	quest.5890C07F7D0A0D21.title: "治愈之手"
	quest.5897DA377752D4E7.quest_desc: ["鬼笛是一支带有幽灵般嗓音的管子。把它加到鬼屋里的管风琴上，等待万圣节吧。"]
	quest.5897DA377752D4E7.quest_subtitle: "你打算叫谁来帮忙呢？"
	quest.5897DA377752D4E7.title: "闹鬼的房子"
	quest.58A8DF33F807DC9E.quest_desc: ["当鲸鱼死亡时，其骸骨会沉入海底，成为深海生物的盛宴。在海底寻找一具鲸鱼骸骨。"]
	quest.58A8DF33F807DC9E.quest_subtitle: "死亡后的新生。"
	quest.58A8DF33F807DC9E.title: "鲸鱼坠落"
	quest.58B2C19546028FB0.quest_desc: ["火车站是建造和停靠火车的地方。将其放置在轨道旁，用转向架在铁轨上建造火车，并从车站屏幕进行组装。"]
	quest.58B2C19546028FB0.quest_subtitle: "苍白公爵的回归。"
	quest.58B2C19546028FB0.title: "一站到另一站"
	quest.58D6EBFDEE80C805.quest_desc: ["放置的茶叶块会随时间变干。绿茶叶会变成干叶，然后是黑茶。制作干绿茶和黑茶。"]
	quest.58D6EBFDEE80C805.quest_subtitle: "把它们晾起来晒干吧"
	quest.58D6EBFDEE80C805.title: "把它们晾起来晒干吧"
	quest.58E40F3DBB4567FA.quest_desc: ["沙滩收音机播放着沙滩音乐唱片：加勒比海滩、草原、Vocalista 等等。找到唱片，点燃夏日。"]
	quest.58E40F3DBB4567FA.quest_subtitle: "不过，无线电还在这里，尽管是这样。"
	quest.58E40F3DBB4567FA.title: "岛屿广播台"
	quest.590637589F8DB0D5.quest_desc: ["两个轮子组成一辆马车载具，你的马可以拉着它，车上可以载人、放箱子或耕地。挽马甚至可以拉动大型载具。"]
	quest.590637589F8DB0D5.quest_subtitle: "爱情与婚姻。"
	quest.590637589F8DB0D5.title: "马匹与马车"
	quest.591F1755A23C5915.quest_desc: ["木制轨道价格便宜，可以在轨道末端放置以延伸至空中。它们很摇晃，不要拿生命开玩笑，但紧急时可以用来跨越峡谷。"]
	quest.591F1755A23C5915.quest_subtitle: "注意脚下的空隙。"
	quest.591F1755A23C5915.title: "摇摇欲坠的轨道"
	quest.5939611963AD7EA7.quest_desc: ["轨道有三种轨距。窄轨和宽轨列车与标准轨道列车一样，但每种轨距都需要为其建造的转向架。打开转向架菜单，浏览从单轴到六轴的每种样式，查看其适用的轨距。单轨轨道悬挂在桁架上，适合城市天际线。"]
	quest.5939611963AD7EA7.quest_subtitle: "窄型、标准型或宽型。"
	quest.5939611963AD7EA7.title: "注意间隙"
	quest.5947442D532D2CED.quest_desc: ["河豚受威胁时会膨胀，并毒害靠近的生物。用桶捕捉一只，可以制作水族箱或水肺药水。"]
	quest.5947442D532D2CED.quest_subtitle: "不要碰那个带刺的方块。"
	quest.5947442D532D2CED.title: "派大星（Puff Daddy）"
	quest.59675D8FAC09954A.quest_desc: ["Borehead Bearing 会在车辆前方旋转一个 Rockcutting Wheel，在行驶过程中啃食岩石。一台专属于你的隧道掘进机。"]
	quest.59675D8FAC09954A.quest_subtitle: "无聊公司都会嫉妒的。"
	quest.59675D8FAC09954A.title: "隧道视野"
	quest.5969AB816CDDF582.quest_desc: ["培根和鸡蛋，农民的早餐，糖浆煎饼。以正确的方式开启新的一天，你就能战胜任何挑战。"]
	quest.5969AB816CDDF582.quest_subtitle: "一天中最重要的一餐。"
	quest.5969AB816CDDF582.title: "冠军的早餐"
	quest.59A790AD73DC372B.quest_desc: ["铜制酿造站酿造得更好、更快。适合不断发展的酿酒坊的升级。"]
	quest.59A790AD73DC372B.quest_subtitle: "下一个酿造等级。"
	quest.59A790AD73DC372B.title: "更进一步"
	quest.59B199A2ECAF8221.quest_desc: ["战斗结束后，龙蛋会出现在传送门顶部。用活塞把它推下去，接住它，把它带回家作为终极战利品。"]
	quest.59B199A2ECAF8221.quest_subtitle: "丹妮莉丝会为此感到骄傲的。"
	quest.59B199A2ECAF8221.title: "龙之母"
	quest.59B21FD3DE4BDB39.quest_desc: ["偶像会改变你周围的世界：降雨偶像带来雨水，晴朗偶像让天空放晴，风暴偶像则召唤暴风雨。非常适合想要更好飞行天气的飞行员。"]
	quest.59B21FD3DE4BDB39.quest_subtitle: "天气预报：阴森恐怖。"
	quest.59B21FD3DE4BDB39.title: "天气女巫"
	quest.59C1E2EA81E61B6C.quest_desc: ["机械传送带在机器之间移动物品。右键点击两个传动轴并用传送带连接它们。"]
	quest.59C1E2EA81E61B6C.subtitle: "运动中物品。"
	quest.59C1E2EA81E61B6C.title: "腰带类物品"
	quest.59EF25B118AF7223.quest_desc: ["废弃矿井已成为拥有矿车、铁轨和旧设备的巨大建筑群。每个生物群系都有其独特的风格。"]
	quest.59EF25B118AF7223.quest_subtitle: "黑暗中的钻石。"
	quest.59EF25B118AF7223.title: "挖掘 挖掘 挖掘"
	quest.59FE4C37D3579F90.quest_desc: ["FE Inverter 将其他模组的 Forge Energy 转换为 Power Grid 电力，并带有用于调节输出的控制引脚。"]
	quest.59FE4C37D3579F90.quest_subtitle: "会说所有语言的方言。"
	quest.59FE4C37D3579F90.title: "迷失在翻译中"
	quest.5A1503C80CB13DE3.quest_desc: ["猪灵奖杯、猪灵堡垒奖杯，甚至还有金色的。把它挂在你的下界前哨基地大厅里。"]
	quest.5A1503C80CB13DE3.quest_subtitle: "骄傲地骑乘着它，威风凛凛。"
	quest.5A1503C80CB13DE3.title: "狩猎奖杯"
	quest.5A260288419F2E11.quest_desc: ["深度计显示你的当前海拔，能准确告诉你该找哪些矿石。钻石喜欢最底层，铁喜欢中间层，而煤炭则在顶层附近。"]
	quest.5A260288419F2E11.quest_subtitle: "Limbo 深板岩的冠军。"
	quest.5A260288419F2E11.title: "你能挖多深"
	quest.5A42F8BB7C04FDAF.quest_desc: ["Aeternium 是游戏中最稀有的金属：由 terminite 和 netherite 融合而成。它能打造出 Farbound 中最精良的工具。"]
	quest.5A42F8BB7C04FDAF.quest_subtitle: "永远，永远，直到世界尽头。"
	quest.5A42F8BB7C04FDAF.title: "永恒锭"
	quest.5A44EA31C9F99840.quest_desc: ["磁盘驱动器和软盘用于存储程序并在计算机之间传输。带有名为 startup 的程序的光盘可以直接引导任何计算机运行该程序。"]
	quest.5A44EA31C9F99840.quest_subtitle: "插入磁盘 2。"
	quest.5A44EA31C9F99840.title: "稍后再处理"
	quest.5A4EB98C1EE52EE7.quest_desc: [
		"能用的工厂固然好，但外观惊艳的工厂更好。本章将探讨工程学的装饰性一面：金属地板、窗户、灯具、告示牌以及各种形状的方块。"
		""
		"这里没有任何强制要求。这一切都是值得的。"
	]
	quest.5A4EB98C1EE52EE7.quest_subtitle: "路易斯·沙利文最早提出了这句话。"
	quest.5A4EB98C1EE52EE7.title: "形式追随功能"
	quest.5A56ABCFA7C6F16D.quest_desc: ["每次探险的终点：一座博物馆。化石陈列，战利品花瓶置于底座，腐木营造出逼真的沉船打捞感。为你的战利品建造一座大厅，赋予过去一个归属地。"]
	quest.5A56ABCFA7C6F16D.quest_subtitle: "琼斯博士会批准的。"
	quest.5A56ABCFA7C6F16D.title: "这东西就该放在博物馆里！"
	quest.5AA6836A35AABF72.quest_desc: ["当船体倾斜和俯仰时，普通轴承会失准。而陀螺轴承则会调整。无论船体指向何方，推力始终保持不变。"]
	quest.5AA6836A35AABF72.subtitle: "无论何时都保持稳定。"
	quest.5AA6836A35AABF72.title: "Gyro"
	quest.5AB77694F0F6CCB5.quest_desc: ["燃料已加载。正在爬升。这就是我们建造一切的目的。悬停、爬升，将弓对准地平线。"]
	quest.5AB77694F0F6CCB5.subtitle: "地平线才是最终的目的地。"
	quest.5AB77694F0F6CCB5.title: "悬停"
	quest.5AD2E7E6202AB98E.quest_desc: ["并非每次飞行都需要船体和船员。背上喷气背包，即刻出发。个人、快速、耗油。当飞船太大而步行又太少时，正是你的选择。"]
	quest.5AD2E7E6202AB98E.subtitle: "个人推进装置。"
	quest.5AD2E7E6202AB98E.title: "喷气背包"
	quest.5AEDDE7E975524D1.quest_desc: ["用女巫之书酿造三种不同的药水：蜘蛛恩典、尖刺皮肤、虹吸、空洞寂静、墓穴之花、嗜血。每种都有其专属的草药和礼物。"]
	quest.5AEDDE7E975524D1.quest_subtitle: "包治百病的良药。"
	quest.5AEDDE7E975524D1.title: "药剂师"
	quest.5B167EAF75C5558F.quest_desc: ["最棒的收获都来自远方。带点能证明你走得多远的东西回家。"]
	quest.5B167EAF75C5558F.subtitle: "距离的证明。"
	quest.5B167EAF75C5558F.title: "宝藏"
	quest.5B16EF0B767CAF40.quest_desc: [
		"苦力怕的形态因出生地而异：沙漠苦力怕、丛林苦力怕、雪地苦力怕、蘑菇苦力怕等等。有些甚至还有特殊技巧。但它们都会爆炸。"
		""
		""
	]
	quest.5B16EF0B767CAF40.quest_subtitle: "要是它出了什么事，那可就太可惜了。"
	quest.5B16EF0B767CAF40.title: "你那儿有个不错的基地呢，真不错"
	quest.5B31E96A2CECEC9C.quest_desc: ["用玻璃磨制透镜元件，制作1x到16x的透镜。将它们堆叠在带延长管的筒中，即可放大任何物体。可调望远镜使用它们，能比普通望远镜看得更远。"]
	quest.5B31E96A2CECEC9C.quest_subtitle: "CSI 说这玩意儿能用。"
	quest.5B31E96A2CECEC9C.title: "缩放与增强"
	quest.5B42C25FBBDB76AB.quest_desc: ["绵羊能提供羊毛，用来制作床、地毯和旗帜，吃点草就能再生。剪一次羊毛，你就再也不用睡地板了。"]
	quest.5B42C25FBBDB76AB.quest_subtitle: "一、二、三……zzz。"
	quest.5B42C25FBBDB76AB.title: "数绵羊（Counting Sheep）"
	quest.5B735E8EA33DDE23.quest_desc: ["没有任何东西能像单个方块那样把你击退得那么远。"]
	quest.5B735E8EA33DDE23.quest_subtitle: "那股不可阻挡的力量终于放弃了。"
	quest.5B735E8EA33DDE23.title: "无法移动的物品"
	quest.5B7662F7FABC975F.quest_desc: ["还是那顿无底晚餐，只是换了一种动物雕刻而成。"]
	quest.5B7662F7FABC975F.quest_subtitle: "牛肉在哪？就在这里。永远都在。"
	quest.5B7662F7FABC975F.title: "另一个无尽的盛宴 (The Other Endless Meal)"
	quest.5B99D6F8FAF86F58.quest_desc: ["骷髅会从黑暗中射出箭矢，掉落骨头和箭。盾牌和阳光都有用。"]
	quest.5B99D6F8FAF86F58.quest_subtitle: "坏-坏-坏-坏消息。"
	quest.5B99D6F8FAF86F58.title: "骨子里的坏蛋 (Bad to the Bone)"
	quest.5BA4BF9033EB8EF0.quest_desc: [
		"滑翔翼能让每个悬崖都变成捷径。把它装备在专属槽位，从高处跳下，就能完全掌控地缓缓滑翔而下。"
		""
		"这还不是飞行，但却是天空的第一缕气息，而天空正是 Farbound 的全部意义所在。"
	]
	quest.5BA4BF9033EB8EF0.quest_subtitle: "旷野之息在呼唤，想要回它的滑翔伞了。"
	quest.5BA4BF9033EB8EF0.title: "抓住风的力量"
	quest.5BAC88C62F68AC79.quest_desc: ["你的攻击接连不断，比应有的速度还要快。"]
	quest.5BAC88C62F68AC79.quest_subtitle: "斯尼克特。"
	quest.5BAC88C62F68AC79.title: "快手快脚"
	quest.5BBB60845A1029C9.quest_desc: ["草莓蛋糕、巧克力蛋糕、甜浆果蛋糕、环形蛋糕。将蛋糕放在蛋糕架上，切成片，然后分享。"]
	quest.5BBB60845A1029C9.quest_subtitle: "历史上从未有人这么说。不过还是烤一个吧。"
	quest.5BBB60845A1029C9.title: "让他们吃蛋糕吧"
	quest.5BC7392BCA9AE8CC.quest_desc: ["接地棒和保险丝座能保护你的电网免受故障影响。保险丝会先于昂贵设备熔断。每个负责任的电工都备有这两样。"]
	quest.5BC7392BCA9AE8CC.quest_subtitle: "注意安全。"
	quest.5BC7392BCA9AE8CC.title: "脚踏实地，寸步难行"
	quest.5BD01FFA69B134B9.quest_desc: ["下界之星可制成信标：一座能赋予你力量的光之塔。建造金字塔并点燃它。"]
	quest.5BD01FFA69B134B9.quest_subtitle: "天空中的光。"
	quest.5BD01FFA69B134B9.title: "希望的灯塔"
	quest.5BDAA59F23D338F6.quest_desc: ["熔炉锅能在寒冷的夜晚融化奶酪，供你蘸面包。高山炖锅能制作奶酪卷、奶酪挞和奶酪香肠。"]
	quest.5BDAA59F23D338F6.quest_subtitle: "蘸一蘸，转一转，吃掉它。"
	quest.5BDAA59F23D338F6.title: "熔岩之夜"
	quest.5BDBE023F2F487C6.quest_desc: ["这东西能把来袭的箭矢在击中你之前弹开。"]
	quest.5BDBE023F2F487C6.quest_subtitle: "我像橡皮，他们像胶水。"
	quest.5BDBE023F2F487C6.title: "反弹回来"
	quest.5BDCF3F93B503EED.quest_desc: ["彩虹桉树拥有各种颜色的树皮。一种独一无二的木材。"]
	quest.5BDCF3F93B503EED.quest_subtitle: "在遥远的天际之上。"
	quest.5BDCF3F93B503EED.title: "彩虹的另一端，某个地方"
	quest.5BEE38B1EEC0F42E.quest_desc: ["你从农场、高级餐厅、远东、大海和工厂都烹饪过。这真是一位主厨的履历。"]
	quest.5BEE38B1EEC0F42E.quest_subtitle: "这是我尝过最美味的菜肴了。"
	quest.5BEE38B1EEC0F42E.title: "顶级厨师"
	quest.5C23BD302EAAA66F.quest_desc: ["一把弓和一叠箭能在争吵升级前解决大多数问题。制作它们，然后击中某个东西。在结构部分开始前做好准备，有些居民不喜欢访客。"]
	quest.5C23BD302EAAA66F.quest_subtitle: "远距离的死亡。"
	quest.5C23BD302EAAA66F.title: "木棍与细线"
	quest.5C4CEC92595E95B2.quest_desc: ["桌上有壶，路上有瓶。用合适的容器倒出的茶味道更好，不，这并不科学。"]
	quest.5C4CEC92595E95B2.quest_subtitle: "请妥善地端上这道菜。"
	quest.5C4CEC92595E95B2.title: "杯子和水壶"
	quest.5C57D511F7F3C8C9.quest_desc: ["一款家庭自酿啤酒。清淡、简单，是你不假思索就能倒上一杯的那种。"]
	quest.5C57D511F7F3C8C9.quest_subtitle: "以值得此名之人命名。"
	quest.5C57D511F7F3C8C9.title: "海莉"
	quest.5C6017D7B4A0A651.quest_desc: ["手持右键并转动绞肉机即可绞肉。用搅拌棒在搅拌碗中混合食材，亲手搅拌。最富触觉的烹饪体验。"]
	quest.5C6017D7B4A0A651.quest_subtitle: "没有按钮，只有双手。"
	quest.5C6017D7B4A0A651.title: "把它拧紧一点"
	quest.5C9099E379E9F4A9.quest_desc: ["空艇向下方目标投下小型、中型和大型空爆弹。小型炸弹可一次性释放数枚。飞过去，打开舱门，让重力发挥作用。"]
	quest.5C9099E379E9F4A9.quest_subtitle: "斯特兰奇洛夫博士再度来袭。"
	quest.5C9099E379E9F4A9.title: "炸弹投下！"
	quest.5CB9C37BF75783CF.quest_desc: ["沙漠行尸在沙漠中蹒跚，不会被阳光灼伤。雪原游荡者会射出减速箭。溺尸潜伏在河流和海洋中，有时会携带三叉戟。"]
	quest.5CB9C37BF75783CF.quest_subtitle: "到处都是不该有的沙子。"
	quest.5CB9C37BF75783CF.title: "木乃伊归来"
	quest.5CDA28DCDA885412.quest_desc: ["村庄里可能有自己的厨师和主厨，他们会用美食和厨房用品进行交易。在村庄里找到厨师的房子，看看菜单上有什么吧。"]
	quest.5CDA28DCDA885412.quest_subtitle: "好的，厨师先生！"
	quest.5CDA28DCDA885412.title: "首席厨师"
	quest.5CE95766C7A8D529.quest_desc: ["名为Cacofeys的奇异小精灵在魔法森林中飞舞。若发现一只，请保持礼貌。"]
	quest.5CE95766C7A8D529.quest_subtitle: "永远不要向他们道谢。"
	quest.5CE95766C7A8D529.title: "妖精一族"
	quest.5CEDE1B33D961B44.quest_desc: ["古老又熟悉的生物化石：苦力怕、守卫者、狼、村民。收集头部和身体部件，组装完整的骨架。自然历史，一块一块地还原。"]
	quest.5CEDE1B33D961B44.quest_subtitle: "那些骨头，那些骨头。"
	quest.5CEDE1B33D961B44.title: "旧骨骸"
	quest.5CF574B802B055D1.quest_desc: ["敲响晚餐铃，大家就知道该吃饭了。一件小事，却能让房子变成家。"]
	quest.5CF574B802B055D1.quest_subtitle: "快来把它拿走吧。"
	quest.5CF574B802B055D1.title: "晚餐准备好了！Dinner Is Ready!"
	quest.5D4A38425EDD07EA.quest_desc: ["建造一辆能行驶、转向和刹车的小车。方向盘、引擎、四个轮子和一个座位：经典配方。去兜兜风吧。"]
	quest.5D4A38425EDD07EA.quest_subtitle: "我想骑上它，彻夜不眠地奔驰。"
	quest.5D4A38425EDD07EA.title: "人生就是一条高速公路"
	quest.5D6F901E83DDE8E7.quest_desc: [
		"手持粗糙宝石右键砂轮可将其抛光。钻石原石需要钻石砂轮，其涂层会随时间磨损，可用钻石原石碎片修复。"
		""
		"辰砂是个特例：把它抛光后就会变成红石。"
	]
	quest.5D6F901E83DDE8E7.quest_subtitle: "抛光，抛光，再抛光。"
	quest.5D6F901E83DDE8E7.title: "每日劳作 (The Daily Grind)"
	quest.5D86FC099233213E.quest_desc: ["唤魔者会召唤尖牙和恼鬼，并掉落不死图腾。击败一个即可重获生命。"]
	quest.5D86FC099233213E.quest_subtitle: "地下的獠牙，空中的鬼魂。"
	quest.5D86FC099233213E.title: "休想过去！"
	quest.5D8A61E0AC8E42E0.quest_desc: ["它能缓冲你的移动，并在需要时将动量返还给你。"]
	quest.5D8A61E0AC8E42E0.quest_subtitle: "得赶紧走，不然就来不及了。"
	quest.5D8A61E0AC8E42E0.title: "储存的动量"
	quest.5D8D6396C97EDDAA.quest_desc: ["Lootr 会给每位玩家提供专属的地牢战利品副本。再也不用和朋友们抢宝箱了，每个人都能公平地分到一份。"]
	quest.5D8D6396C97EDDAA.quest_subtitle: "禁止赛车，禁止偷窃。"
	quest.5D8D6396C97EDDAA.title: "人人都有战利品"
	quest.5DA7926C142416F4.quest_desc: ["末地炉用虚空的热量烹饪。唱片机果、潜贝肉和末地鱼是你的食材。"]
	quest.5DA7926C142416F4.quest_subtitle: "宇航员冰淇淋，末地版。"
	quest.5DA7926C142416F4.title: "太空食物"
	quest.5DF6C70DA3FEEC1A.quest_desc: ["并非所有大型生物都危险。海牛和儒艮啃食海草，蝠鲼滑翔如水下风筝，虎鲸则以家族为单位狩猎。"]
	quest.5DF6C70DA3FEEC1A.quest_subtitle: "巨大的心脏，更庞大的身躯。"
	quest.5DF6C70DA3FEEC1A.title: "温顺的巨人"
	quest.5DFF20748D911FD8.quest_desc: ["砧板和刀具能完成徒手无法做到的事。分解食材，为锅具备料，解锁需要适当准备的食谱。"]
	quest.5DFF20748D911FD8.quest_subtitle: "一把刀能改变一切事情。"
	quest.5DFF20748D911FD8.title: "锋利的刀刃"
	quest.5E07E2AF3C422B62.quest_desc: ["铜线圈是电机和发电机的核心。制作一叠吧，从现在开始你到处都需要它们。"]
	quest.5E07E2AF3C422B62.quest_subtitle: "每台机器的核心所在。"
	quest.5E07E2AF3C422B62.title: "卷起来，快一点！"
	quest.5E08989D0F85A6A2.quest_desc: ["从地窖到虚空。有些汤很美味，有些很奇特，至少有一种在黑暗中会发出微光。全部品尝一下吧。"]
	quest.5E08989D0F85A6A2.quest_subtitle: "有些汤在黑暗中会发出荧光。"
	quest.5E08989D0F85A6A2.title: "Subz的汤品系列"
	quest.5E17953B0DAD19F0.quest_desc: ["矢量推进器可以调整喷嘴的偏航和俯仰，使推力精确指向所需方向。液体版本使用液体燃料。倾斜适配器可通过模拟信号倾斜任何旋转输出。"]
	quest.5E17953B0DAD19F0.quest_subtitle: "“Harrier”跳伞式喷气机的能量。"
	quest.5E17953B0DAD19F0.title: "推力矢量控制"
	quest.5E2F14CD78BB7B61.quest_desc: ["速度更快，射程更远，足以应对最恶劣的高空。下界合金喷气背包是顶级的个人飞行装备。"]
	quest.5E2F14CD78BB7B61.subtitle: "没有天花板可放置了。"
	quest.5E2F14CD78BB7B61.title: "升级"
	quest.5E461FEC255DF335.quest_desc: ["有些战利品会反咬一口：炸弹会爆炸，唤魔者陷阱会如其名所示。不管怎样，小心地挖出来，按照自己的规则来利用它们。"]
	quest.5E461FEC255DF335.quest_subtitle: "并非所有被埋藏的东西都渴望被找到。"
	quest.5E461FEC255DF335.title: "小心处理，轻拿轻放"
	quest.5E794FF28117BB26.quest_desc: [
		"高山之上，鲜花盛开，有高山罂粟、龙胆、福禄考和火百合。空气清新，奶牛毛茸茸，生活节奏慢得恰到好处。"
		""
		"去一片草地，采一些山间野花。"
	]
	quest.5E794FF28117BB26.quest_subtitle: "伴随着音乐声响起的那一刻。"
	quest.5E794FF28117BB26.title: "群山在呼唤你，快来探索吧！"
	quest.5E7B141DC7FDACA8.subtitle: "现在没什么能让你减速的了。"
	quest.5E93AD8E53E8171F.quest_desc: ["蛋糕架、蛋糕展示架、纸杯蛋糕架、壁挂架、托盘、面包盒。六种方式将烘焙食品置于玻璃后。建造店铺正面并填满每个货架。"]
	quest.5E93AD8E53E8171F.quest_subtitle: "先看看再决定是否出售。"
	quest.5E93AD8E53E8171F.title: "展示柜 The Display Case"
	quest.5E9414178896B4FB.quest_desc: [
		"沼泽和森林中流传着古老的技艺。草药师种植奇异的植物，在小锅中熬制药剂，并通过仪式召唤元素。《翠绿魔典》对此有详尽的解释。"
		""
		"找到能唤醒女巫术的魔咒书和六芒星焦点。"
	]
	quest.5E9414178896B4FB.quest_subtitle: "我们每个人的内心都住着一个小小的女巫。"
	quest.5E9414178896B4FB.title: "实用魔法（Practical Magic）"
	quest.5EB22B96C9F912EA.quest_desc: ["铀和钍矿石深藏地下，会发出微光。小心处理：在 Farbound 中辐射是真实存在的，随意逗留会伤害到你。"]
	quest.5EB22B96C9F912EA.quest_subtitle: "这样就可以了。"
	quest.5EB22B96C9F912EA.title: "黑暗中发光"
	quest.5ED7193B8743C484.quest_desc: ["穿上它们，洞穴就会自动为你点亮。"]
	quest.5ED7193B8743C484.quest_subtitle: "嘿。是谁把灯给关掉了？"
	quest.5ED7193B8743C484.title: "是谁把灯关掉了"
	quest.5F09551ACB4C3DB9.quest_desc: ["绳索桥、木桥、铁路桥和桥墩。像它本应被穿越的那样，跨越河流或峡谷。"]
	quest.5F09551ACB4C3DB9.quest_subtitle: "我将要躺下休息了。"
	quest.5F09551ACB4C3DB9.title: "渡过难关的桥梁"
	quest.5F3245DA7A843630.quest_desc: ["每一杯茶都始于一个嫩芽。用剪刀剪任何原版花朵，你就能找到茶花。种植它，让它生长，你的完美一杯之旅就此开始。"]
	quest.5F3245DA7A843630.quest_subtitle: "每一杯都始于此处。"
	quest.5F3245DA7A843630.title: "第一株幼苗"
	quest.5F3BE1C46E8EF695.quest_desc: ["商人们看到同类，悄悄地把价格降了下来。"]
	quest.5F3BE1C46E8EF695.quest_subtitle: "我们中的一员。我们中的一员。"
	quest.5F3BE1C46E8EF695.title: "我们之中的一员"
	quest.5F78DC9410231C14.quest_desc: ["在毛绒玩具世界的某个隐秘角落，有一套特别的收藏品正等着你。直面本章的强敌——坚守者、一场完整的突袭和一只快乐的加斯特，银河的光明面将给予你回报。"]
	quest.5F78DC9410231C14.quest_subtitle: "愿原力与你同在"
	quest.5F78DC9410231C14.title: "愿原力与你同在"
	quest.5FAF3D1B3FBB1CA6.quest_desc: ["锌矿石出现在地下。将其熔炼成锌锭，这是制作黄铜所需材料的一半。"]
	quest.5FAF3D1B3FBB1CA6.title: "锌"
	quest.5FEBE25C8056A7A4.quest_desc: ["四个图腾沉睡在挖掘点中：生长、光辉、灵魂和激流，每个都拥有独特的力量。收集它们，并决定将哪一个放在你的副手。"]
	quest.5FEBE25C8056A7A4.quest_subtitle: "古老。强大。略带诅咒？"
	quest.5FEBE25C8056A7A4.title: "偶像之手"
	quest.6046E9292825D168.quest_desc: ["野生葡萄生长在不同气候中：平原的红白葡萄、干旱地区的萨凡纳葡萄、寒冷地区的泰加葡萄、炎热地区的丛林葡萄。找到野生葡萄藤并收集一些种子。"]
	quest.6046E9292825D168.quest_subtitle: "你很快就会不属于我了，时间不多了。"
	quest.6046E9292825D168.title: "我通过传闻得知的这件事"
	quest.6072C7E9B62D4044.quest_desc: ["凝乳来自炖锅，盐来自山脉，牛奶来自牛群。将它们放入奶酪模具中等待。奶酪是一种有期限的农业。"]
	quest.6072C7E9B62D4044.quest_subtitle: "牛奶、盐、凝乳酶、耐心。"
	quest.6072C7E9B62D4044.title: "凝乳和乳清"
	quest.607FD6ED7B0DDBA2.quest_desc: [
		"较小的矿脉会掉落原矿块而非整块矿石。铁、金、铜和锌的原矿块都能快速熔炼并叠加。"
		""
		"下次下矿的时候收集一些不同的原始矿石块。"
	]
	quest.607FD6ED7B0DDBA2.quest_subtitle: "小改变也能带来大不同。"
	quest.607FD6ED7B0DDBA2.title: "金块猎人"
	quest.6081ECA5C3076113.quest_desc: ["站在泥土上，它就会慢慢滋养你——前提是你愿意保持静止。"]
	quest.6081ECA5C3076113.quest_subtitle: "我是格鲁特。"
	quest.6081ECA5C3076113.title: "脚踏实地，寸步难行"
	quest.609AD88671001375.quest_desc: ["硫磺立方体在地下深处的硫磺洞穴中游荡。它们会吞下物品，有些还会爆炸。用桶非常小心地捕捉一个。"]
	quest.609AD88671001375.quest_subtitle: "不要抱紧它。"
	quest.609AD88671001375.title: "Cube Life"
	quest.609DD3004AB53FED.quest_desc: ["熊猫在丛林里啃竹子，每只性格各异：懒惰、爱玩、忧虑、好斗，或是极为罕见的棕色熊猫。观察它们一会儿，比看电视更有趣。"]
	quest.609DD3004AB53FED.quest_subtitle: "斯卡多什（Skadoosh）。"
	quest.609DD3004AB53FED.title: "功夫熊猫"
	quest.60A462DDE44F3B9B.subtitle: "所有装置都始于此处。"
	quest.60A4FDE6AFAB14FF.quest_desc: ["掠夺者庄园和藏身处隐藏在森林里，而冰学家和幻术师则在某个地方拥有自己的小屋和训练场。"]
	quest.60A4FDE6AFAB14FF.quest_subtitle: "不速之客。"
	quest.60A4FDE6AFAB14FF.title: "庄园领主"
	quest.60AD7CCBBEFB3CAE.quest_desc: ["深雪完全阻止了脚步的拖拽感。"]
	quest.60AD7CCBBEFB3CAE.quest_subtitle: "反正寒冷从来就没困扰过你。"
	quest.60AD7CCBBEFB3CAE.title: "粉末到铺路石"
	quest.60CE8B83B9B6A506.quest_desc: [
		"将风车轴承粘在帆上即可制成风车。帆块越多，它能承受的压力就越大。右键轴承即可开始转动。"
		""
		"风车在山顶上看起来很棒。它们在飞艇上看起来也很棒，不过那是后话了。"
	]
	quest.60CE8B83B9B6A506.quest_subtitle: "堂吉诃德表示赞同。"
	quest.60CE8B83B9B6A506.title: "与风车搏斗（徒劳无功）"
	quest.60D5B867460EFCEC.quest_desc: ["野火是烈焰人的女王，用火球和火焰盾牌守护着下界堡垒。击败她，夺走她的王冠。"]
	quest.60D5B867460EFCEC.quest_subtitle: "这一下会很痛的。"
	quest.60D5B867460EFCEC.title: "被火焰包围的女孩"
	quest.60DCDEEE51C5F88A.quest_desc: ["自然罗盘会指引你前往任何你选择的生物群系。去搜寻那些奇特的生物群系吧。"]
	quest.60DCDEEE51C5F88A.subtitle: "每个生物群系，都是一个全新的目的地。"
	quest.60DCDEEE51C5F88A.title: "生物群系"
	quest.60E135B06689077A.quest_desc: ["相机能拍下你看到的一切。装上胶卷，瞄准，按下快门。每一张照片都是旅途的回忆：你的第一艘飞艇，海上初遇的日落，篝火旁的伙伴们。"]
	quest.60E135B06689077A.quest_subtitle: "对着小鸟笑一个吧。"
	quest.60E135B06689077A.title: "说声“茄子”！"
	quest.60FBFD6A36ADE97E.quest_desc: ["末地城市高耸于外岛之上，是潜行者和宝藏的家园。末地城堡、末地船和灯塔漂浮其间，甚至还有带前哨站的末地村庄。"]
	quest.60FBFD6A36ADE97E.quest_subtitle: "潜行者们正在注视着一切。"
	quest.60FBFD6A36ADE97E.subtitle: "在虚空中航行。"
	quest.60FBFD6A36ADE97E.title: "末地之城"
	quest.6111BD38435BAB16.quest_desc: ["填满你的驾驶舱：四引擎节流阀、双轴操纵杆、方向舵踏板，以及用于其他功能的按钮键盘。铜制变体增添了一丝格调。"]
	quest.6111BD38435BAB16.quest_subtitle: "如果有按钮，就按下它。"
	quest.6111BD38435BAB16.title: "所有旋钮 (All the Knobs)"
	quest.6127BF1BFCEE4A5A.quest_desc: [
		"你可以在这里跳过栅栏和墙壁，所以围栏和花园不再困住你。动物仍然会遵守它们，但玩家不会。"
		""
		"你也可以挥舞着剑穿过高草和花朵来攻击后面的东西，还能花式游泳：桶滚在水下也同样奏效。"
	]
	quest.6127BF1BFCEE4A5A.quest_subtitle: "障碍只是建议而已。"
	quest.6127BF1BFCEE4A5A.title: "跑酷！"
	quest.61341CAE316CE8CE.quest_desc: ["小型飞机有紧凑型部件：操纵杆和驾驶柱、无需可见襟翼即可转向的隐形控制面，以及小型飞机引擎。紧凑型襟翼轴承可通过红石在单个方块中倾斜襟翼。"]
	quest.61341CAE316CE8CE.quest_subtitle: "大小并非一切。"
	quest.61341CAE316CE8CE.title: "小不点，大能量"
	quest.6138BEA343EEF25C.quest_desc: ["补给马车跟在马后运送货物，犁在骑行时翻土，播种机紧随其后播种。马匹农场是最温馨的农场。"]
	quest.6138BEA343EEF25C.quest_subtitle: "老麦克唐纳有一辆手推车。"
	quest.6138BEA343EEF25C.title: "农场里的生活并不如意"
	quest.614399D109980E2F.quest_desc: ["特殊离合器会自行响应网络。过载离合器会在网络过载前断开，离心离合器仅在超过设定速度时接合，自由轮离合器只能单向转动。刹车会停止一切。"]
	quest.614399D109980E2F.quest_subtitle: "在最需要的时候发挥作用。"
	quest.614399D109980E2F.title: "Clutch Performance"
	quest.6143B604FC6D8C38.quest_desc: ["安山合金是创造模式的首个建筑材料：安山岩加铁或锌粒。几乎所有早期机器都用它，所以多做一些。"]
	quest.6143B604FC6D8C38.quest_subtitle: "工程学中的万能胶带。"
	quest.6143B604FC6D8C38.title: "安山岩合金"
	quest.614CD5DE48BAAC63.quest_desc: ["阈值开关会在物品栏满或空时发出红石信号，让机器能自动启停。你的首个工厂大脑。"]
	quest.614CD5DE48BAAC63.quest_subtitle: "已经满了吗？"
	quest.614CD5DE48BAAC63.title: "满堂彩"
	quest.615218F37CB49A88.quest_desc: ["当物品存量高于或低于你设定的数值时，Level Emitter会发出红石信号。将其连接到农场或工厂，货架空了时生产便会自动开始。"]
	quest.615218F37CB49A88.quest_subtitle: "是时候补充物资了。"
	quest.615218F37CB49A88.title: "资源即将耗尽"
	quest.61535BB331CDEF77.quest_desc: ["每次挥出的一击都会为你恢复一点生命值。"]
	quest.61535BB331CDEF77.quest_subtitle: "我想把你的生命条吸干。"
	quest.61535BB331CDEF77.title: "拿回原物"
	quest.61807DF00A7DA831.quest_desc: ["定格值得珍藏的瞬间：你的第一艘飞艇、桅杆上的风景、朋友坠落的身影。按下快门。那一刻，便永远定格在胶片之上。"]
	quest.61807DF00A7DA831.quest_subtitle: "让它发挥应有的作用。"
	quest.61807DF00A7DA831.title: "一击必中"
	quest.618131D04F6B8B0E.quest_desc: ["鱿鱼变成卡拉马里：油炸、汤煮或卷起。一道经典的海滨菜肴。"]
	quest.618131D04F6B8B0E.quest_subtitle: "敲响钟声。"
	quest.618131D04F6B8B0E.title: "神圣的鱿鱼怪"
	quest.61BCF0E37ACF5EA2.quest_desc: ["《野外指南》是一本会随着探索自动填充的日志。发现新生物、植物或地点，对应的页面就会出现，逐步记录下你遇到的一切。"]
	quest.61BCF0E37ACF5EA2.quest_subtitle: "世界将自身书写下来。"
	quest.61BCF0E37ACF5EA2.title: "野外笔记"
	quest.61CE5274D4E1258C.quest_desc: ["青蛙有三种颜色，取决于它们孵化的气候，它们会吃小型史莱姆和岩浆块。在沼泽附近找一只吧。"]
	quest.61CE5274D4E1258C.quest_subtitle: "当个绿色的家伙可不容易。"
	quest.61CE5274D4E1258C.title: "Kermit Was Right"
	quest.61EC90B9FAC91D3A.quest_desc: ["铽是一种深埋地下的稀有金属。将其熔炼、压成薄片，并提纯其原矿。本章几乎所有内容都以此为基础建造。"]
	quest.61EC90B9FAC91D3A.quest_subtitle: "元素周期表，深度挖掘。"
	quest.61EC90B9FAC91D3A.title: "元素 70"
	quest.62142A19DDD4F222.quest_desc: ["温馨的家需要满当当的粮仓，而粮仓则需要农场。世界各地的野作物都能生长：海边的野生卷心菜、温暖土地的野生番茄、沼泽里的野生水稻。将它们收获成种子，种下你的第一座花园。"]
	quest.62142A19DDD4F222.quest_subtitle: "E-I-E-I-O。"
	quest.62142A19DDD4F222.title: "老麦克唐纳有个农场"
	quest.6214FDFA3F4A0C95.quest_desc: ["自动炮能快速发射小型弹药。一个炮闩、一个后坐弹簧和一些炮管部件就能组装出一门轻便快速的炮，适合安装在任何舰船上。装满弹药箱以保持持续供弹。"]
	quest.6214FDFA3F4A0C95.quest_subtitle: "全自动模式。"
	quest.6214FDFA3F4A0C95.title: "Rat-a-tat-tat"
	quest.622A61C7722E5BA8.quest_desc: ["钢琴是乐器之王，正好适合你。周六在酒馆里弹奏它吧。"]
	quest.622A61C7722E5BA8.quest_subtitle: "为我们唱首歌吧，你就是钢琴手。"
	quest.622A61C7722E5BA8.title: "钢琴家先生"
	quest.622E7E01D1193B33.quest_desc: ["永恒升级能让背包承受住你承受不了的：它能陪你度过每一次坠机、岩浆浴和过度自信的试飞。对于一个装满载具的背包来说，这可不是奢侈品。"]
	quest.622E7E01D1193B33.quest_subtitle: "其实，你可以的。"
	quest.622E7E01D1193B33.title: "无法随身携带物品 (Can't Take It With You)"
	quest.6240A113190D8C26.quest_desc: ["骨珊瑚礁是一片由骨头、草地和奇特蘑菇构成的景观。有点诡异，但很美。"]
	quest.6240A113190D8C26.quest_subtitle: "到处都是骨头。"
	quest.6240A113190D8C26.title: "骷髅船员"
	quest.6256B10FF876569E.quest_desc: ["多种颜色的工业级板材：板材块、切割板材、格栅。危险条纹块标记了禁止站立区域。"]
	quest.6256B10FF876569E.quest_subtitle: "工业级强度的颜色。"
	quest.6256B10FF876569E.title: "带有金属板的盔甲部件（Plated Armor）"
	quest.6271BC66AB7C6ACE.quest_desc: ["铀先被制成黄饼，再经过浓缩。浓缩篝火和富化灵魂土能助你一臂之力。每一步都是工程挑战。"]
	quest.6271BC66AB7C6ACE.quest_subtitle: "蛋糕是个谎言。这个蛋糕具有放射性。"
	quest.6271BC66AB7C6ACE.title: "黄饼（Yellowcake）"
	quest.627F6BA70A7C190D.quest_desc: ["装有沙子、红石或其他粉末的沙漏，可用作红石计时器。用红石翻转它，即可实现精美的延迟电路。"]
	quest.627F6BA70A7C190D.quest_subtitle: "时间是幻觉。午餐时间更是如此。"
	quest.627F6BA70A7C190D.title: "时间的沙粒"
	quest.6286EC73D34F7E35.quest_desc: ["牛角包和面包卷，打造完美的早餐。再加点果酱，仿佛置身巴黎咖啡馆。"]
	quest.6286EC73D34F7E35.quest_subtitle: "酥脆的，黄油味的，法式风情。"
	quest.6286EC73D34F7E35.title: "哦，啦啦啦"
	quest.628FB407D8935BE1.quest_desc: ["天空才是目的地，航空学则是抵达它的方式。从飞行员护目镜开始——它能让你读取飞船的状态：高度、推力、姿态。在它失控前，先了解你的装置在做什么。"]
	quest.628FB407D8935BE1.subtitle: "看看天空能看到什么。"
	quest.628FB407D8935BE1.title: "飞行员"
	quest.629191EF529803A5.quest_desc: ["下界有其独特的树木：rubeus、stalagnate、willow、anchor trees、nether sakura 和 wart trees。收集两种不同的下界木材。"]
	quest.629191EF529803A5.quest_subtitle: "就连树木都在燃烧。"
	quest.629191EF529803A5.title: "地狱木"
	quest.62986BDBDBE9321C.quest_desc: ["矿车组装器可将矿车变为装置载体。钻头、收割机和座位可沿轨道行驶。它是 Rails and Roads 中列车的弟弟。"]
	quest.62986BDBDBE9321C.quest_subtitle: "带上你的机器，踏上轨道之旅。"
	quest.62986BDBDBE9321C.title: "Minecart Contraptions"
	quest.629A14E32E7CDAB9.quest_desc: ["Farbound 没有原版成就。这本任务书就是你的地图。可以跟着它走，也可以把它折起来四处闲逛。两种方式都行。"]
	quest.629A14E32E7CDAB9.quest_subtitle: "规划你自己的航线。"
	quest.629A14E32E7CDAB9.subtitle: "规划你自己的航线。"
	quest.629A14E32E7CDAB9.title: "书籍即道路"
	quest.62E22E682420B19D.quest_desc: ["旋转速度控制器为大型齿轮设定精确的速度。精密机器需要精确的速度。"]
	quest.62E22E682420B19D.subtitle: "每次都要保持完全一致的速度。"
	quest.62E22E682420B19D.title: "控制"
	quest.62E54C57EE4BC917.quest_desc: ["扬声器能让代码播放音符、声音，甚至流媒体音频。门铃、警报、农场满员时的提示音：任何能触发的声音，现在都能听到。"]
	quest.62E54C57EE4BC917.quest_subtitle: "计算机学会了说话。"
	quest.62E54C57EE4BC917.title: "制造点噪音"
	quest.62F32A65B2B20E65.quest_desc: ["猪灵、僵尸猪灵、猪灵恶霸和猪灵混合体：下界的猪人种类繁多，情绪多变。击败守护堡垒的猪灵恶霸。"]
	quest.62F32A65B2B20E65.quest_subtitle: "奥因克-艾。"
	quest.62F32A65B2B20E65.title: "猪拉丁语（Pig Latin）"
	quest.630A6678F636A748.quest_desc: ["设置一架能自动执行货运路线的飞机：装载、飞行、卸载、返回。你的第一架自动化航空公司现已投入运营。"]
	quest.630A6678F636A748.quest_subtitle: "总是准时到达。"
	quest.630A6678F636A748.title: "货运路线"
	quest.631E10F3220DD4FB.quest_desc: ["暗樱桃树能产出樱桃，用来酿造樱桃酒，还能得到漂亮的深色木材。果园里的苹果树能产出苹果，用来酿造苹果酒。"]
	quest.631E10F3220DD4FB.quest_subtitle: "甜美而深邃。"
	quest.631E10F3220DD4FB.title: "人生就像一碗樱桃 (Life Is a Bowl of Cherries)"
	quest.632D0F18180C9926.quest_desc: ["复制家族成员众多：垂直斜坡、半层、折叠门、滑动门，甚至还有复制齿轮和流体管道。带真实曲线的飞艇船体由此开始，它们也适用于移动船只。"]
	quest.632D0F18180C9926.quest_subtitle: "现在你看到它了。"
	quest.632D0F18180C9926.title: "伪装大师"
	quest.633AF4868F4E8C4E.quest_desc: ["Chipped 和 Create 的调色板增加了数百种方块变体。选定一个主题，坚持到底。"]
	quest.633AF4868F4E8C4E.subtitle: "调色板已经交给你了，尽情发挥吧。"
	quest.633AF4868F4E8C4E.title: "多样性"
	quest.6347C70C6D8F427B.quest_desc: ["各种颜色的框架玻璃，配有匹配的窗格、门和活板门。还有现代风格的瓦片玻璃，以及工业风的安山岩、黄铜和铜窗。"]
	quest.6347C70C6D8F427B.quest_subtitle: "简直是一目了然，清晰得不能再清晰了。"
	quest.6347C70C6D8F427B.title: "玻璃法案"
	quest.634EA7DED5EAAD04.quest_desc: ["捕捉烈焰人，在烈焰人燃烧器中让它工作。它能加热创造盆地，为接下来的重型制作提供热量。"]
	quest.634EA7DED5EAAD04.quest_subtitle: "让火焰发挥它的作用吧。"
	quest.634EA7DED5EAAD04.subtitle: "让火焰发挥它的作用吧。"
	quest.634EA7DED5EAAD04.title: "被囚禁的火焰"
	quest.6354BB81821D9425.quest_desc: ["螺旋桨轴承可将附着的帆或叶片变为产生推力的螺旋桨。木制和安山岩螺旋桨是现成的桨头。更大的螺旋桨推力更强，转速更快。"]
	quest.6354BB81821D9425.quest_subtitle: "转动转盘，赢取胜利。"
	quest.6354BB81821D9425.title: "Prop 文化"
	quest.63615D4DCE72577A.quest_desc: ["音叉能帮你找到紫水晶晶洞。离得越近，振动越快。跟着嗡嗡声走，敲开晶洞，收集水晶吧。"]
	quest.63615D4DCE72577A.quest_subtitle: "我正在收集一些不错的振动能量。"
	quest.63615D4DCE72577A.title: "美妙的振动"
	quest.63990FF0550C7F32.quest_desc: [
		"黄铜是铜和锌在加热盆中混合而成。将机械搅拌机置于盆上，盆下放置点燃的烈焰燃烧器，然后投入锭子。"
		""
		"混合你的第一批黄铜锭。本章所有内容都基于它们建造。"
	]
	quest.63990FF0550C7F32.quest_subtitle: "那只怪怪的猴子。"
	quest.63990FF0550C7F32.title: "黄铜猴子"
	quest.63AE3C59E4845667.quest_desc: ["瓶中的船、探险家盒子、宝箱和用于展示你发现的物品的陈列柜。世界旅行者的理想书房。"]
	quest.63AE3C59E4845667.quest_subtitle: "每个探险家都有一个这样的东西。"
	quest.63AE3C59E4845667.title: "奇珍异宝陈列柜"
	quest.6408073EBAB51CE2.quest_desc: ["公告板能让所有人阅读书籍或地图，黑板则能让你用粉笔画像素艺术。非常适合写基地规则、待办事项和很糟糕的涂鸦。"]
	quest.6408073EBAB51CE2.quest_subtitle: "把它贴好，别针固定，然后阅读。"
	quest.6408073EBAB51CE2.title: "前辈，请注意到我！"
	quest.6419AC657862D58C.quest_desc: ["照片会随着时间的推移而变成复古印刷品，你也可以人为地让它们变旧。堆叠的照片在桌上形成一小摞。"]
	quest.6419AC657862D58C.quest_subtitle: "他们现在不再像这样制作了。"
	quest.6419AC657862D58C.title: "复古风格"
	quest.6445752ADBF577E8.quest_desc: ["铭牌能让所有人都看到你的船名。每艘船都应该有个名字。你的船叫什么？"]
	quest.6445752ADBF577E8.quest_subtitle: "我给这艘船取名为……"
	quest.6445752ADBF577E8.title: "为您的船只命名 (Christen Your Ship)"
	quest.644780857D429E2E.quest_desc: ["旋转即推力。装上螺旋桨，连接到轴承，指向你想去的方向。理论上很简单。你的装置会教会你一切。"]
	quest.644780857D429E2E.subtitle: "旋转即成为运动。"
	quest.644780857D429E2E.title: "螺旋桨"
	quest.6464D2964BF0D4D3.quest_desc: ["拾取升级可将收集的物品直接放入背包。磁铁升级则先将它们吸向你。再也不用追逐掉落的物品了。"]
	quest.6464D2964BF0D4D3.quest_subtitle: "每一粒面包屑都至关重要。"
	quest.6464D2964BF0D4D3.title: "用吸尘器吸起来"
	quest.647466416BD67495.quest_desc: ["淘气鬼藏在矿井里玩捉迷藏。找到三次就会奖励你。而猛击者则藏在沙漠和草原的沙子里，还会咬人。"]
	quest.647466416BD67495.quest_subtitle: "准备好了没，我这就来啦。"
	quest.647466416BD67495.title: "捉迷藏"
	quest.647DE371EA9A135B.quest_desc: ["蛋糕的蛋糕面团，甜点的甜面团，还有站在站台上等待决定的空白蛋糕。本章的一切都始于此处。"]
	quest.647DE371EA9A135B.quest_subtitle: "它会变成你接下来要做的任何事情。"
	quest.647DE371EA9A135B.title: "空白画布"
	quest.649DFB661591267D.quest_desc: ["作物成熟了，该收获了。啤酒花、大麦、玉米和燕麦，都已准备好进入下一步。"]
	quest.649DFB661591267D.quest_subtitle: "田野会给予回报。"
	quest.649DFB661591267D.title: "收获的季节"
	quest.64A8E84C26511C2D.quest_desc: ["蘑菇村庄、蘑菇房屋和蘑菇矿井：一个完整的真菌文明生活在阴影中。去找到一个吧。"]
	quest.64A8E84C26511C2D.quest_subtitle: "到处都是孢子。"
	quest.64A8E84C26511C2D.title: "Fungus Among Us"
	quest.64E2A2F93E0934AB.quest_desc: [
		"两种特殊升级会改变你的滑翔方式。铜质升级能让你在雷暴中借助闪电获得巨大推力，前提是你敢。下界升级则能利用火焰和熔岩的热量带你向上攀升。"
		""
		"制作其中一个，然后在合成台将其安装到你的滑翔机上。"
	]
	quest.64E2A2F93E0934AB.quest_subtitle: "驾驭闪电的力量。"
	quest.64E2A2F93E0934AB.title: "驾驭风暴"
	quest.64EA480CD267694F.quest_desc: ["螺旋桨轴承是船体与引擎的连接处。安装妥当，螺旋桨便有了稳定旋转的家园。是所有飞行器的基石。"]
	quest.64EA480CD267694F.subtitle: "推力诞生的地方。"
	quest.64EA480CD267694F.title: "轴承"
	quest.650E9030072C684E.quest_desc: ["筒仓用于储存散装谷物并缓慢干燥。无论是木制还是铜制，它们都是每个正规农场的标志。"]
	quest.650E9030072C684E.quest_subtitle: "谷物，安全储存完毕。"
	quest.650E9030072C684E.title: "筒仓物语"
	quest.652BAC0C929983D8.quest_desc: ["夏尔马、克莱兹代尔马、伯尔马和比利时马等重型马体型庞大，力量惊人。它们能抵抗击退，冲锋时推力更强，并且能无速度惩罚地拖拽马车。只有重型马才能拉动大型马车。"]
	quest.652BAC0C929983D8.quest_subtitle: "像公牛一样强壮。实际上，还要更强。"
	quest.652BAC0C929983D8.title: "工作马匹"
	quest.653B1B6724FFDF9B.quest_desc: ["枫树林全年都燃烧着红、橙、黄的颜色。把枫木和红枫树苗带回家。"]
	quest.653B1B6724FFDF9B.quest_subtitle: "坠入秋天，感受丰收的喜悦。"
	quest.653B1B6724FFDF9B.title: "秋日的落叶"
	quest.6540AFC4086A0BCC.quest_desc: ["生存结构工具可以保存、焊接、移动、旋转和分离物理结构。将两个容器焊接成一个，将船只向旁边推移几格，或者分离救生艇。"]
	quest.6540AFC4086A0BCC.quest_subtitle: "更强大的力量！"
	quest.6540AFC4086A0BCC.title: "工具时间到了"
	quest.655928CCE7F789B3.quest_desc: ["船上的应答器会记录你飞行时的路线分段，并存储船只的停靠点。手动飞行一次路线，船只就会学会它。"]
	quest.655928CCE7F789B3.quest_subtitle: "记住来时的路。"
	quest.655928CCE7F789B3.title: "路线记录器"
	quest.657813AFA09215E7.quest_desc: ["工厂灯、灯具、霓虹灯管和串灯。生长灯甚至能帮助作物在室内生长。电光是工业时代的温馨之光。"]
	quest.657813AFA09215E7.quest_subtitle: "我手里这盏小小的灯，散发着微光。"
	quest.657813AFA09215E7.title: "点亮黑夜"
	quest.65A104ECA400038F.quest_desc: ["全息投影方块会显示你胶囊里的任务数据。燃烧期间请随时留意它。"]
	quest.65A104ECA400038F.quest_subtitle: "所有系统均已就绪，可以开始。"
	quest.65A104ECA400038F.title: "任务显示板"
	quest.65AFFBBFD33590C2.quest_desc: ["紧急情况下生肉也能凑合，但热食更好。搭建一个烟熏炉，在下一段旅程开始前把它烤熟。"]
	quest.65AFFBBFD33590C2.quest_subtitle: "出发前请先烹饪食物。"
	quest.65AFFBBFD33590C2.subtitle: "出发前请先烹饪食物。"
	quest.65AFFBBFD33590C2.title: "烹饪材料收集清单：收集以下物品来烹饪美味佳肴。"
	quest.65B661F0CA89CF5F.quest_desc: ["下界合金酿造台是所有中最顶级的。有了它，连威士忌都能轻松酿造。"]
	quest.65B661F0CA89CF5F.quest_subtitle: "最棒的那一个。"
	quest.65B661F0CA89CF5F.title: "大师的蒸馏器"
	quest.65C7687757F63E38.quest_desc: ["暗房将曝光的底片冲洗成照片。冲洗后的底片可以反复打印。在家中设置一个暗房。"]
	quest.65C7687757F63E38.quest_subtitle: "提升你的技能水平。"
	quest.65C7687757F63E38.title: "暗房"
	quest.65DF200F2ABB5B67.quest_desc: ["新鲜的叶子需要晾干才能使用。将9片绿茶叶合成，放置方块，然后等待。"]
	quest.65DF200F2ABB5B67.quest_subtitle: "时间会证明一切。"
	quest.65DF200F2ABB5B67.title: "干燥的日子"
	quest.66157C2AB635912F.quest_desc: ["机械工匠可组成任意大小的网格并自动合成。部分配方因过大而无法在合成台完成，只能在此制作：粉碎轮、伸缩爪、土豆炮和对称魔杖。"]
	quest.66157C2AB635912F.quest_subtitle: "由9x9个方块组成的梦境网格。"
	quest.66157C2AB635912F.title: "Crafting, but Bigger"
	quest.661687DCC232BC4D.quest_desc: ["冰学家是会在雪山小屋向你投掷冰块的掠夺者。击败一个可获得冰冻图腾。"]
	quest.661687DCC232BC4D.quest_subtitle: "反正寒冷从来都困扰不到我。"
	quest.661687DCC232BC4D.title: "随它去吧"
	quest.662ED841F22DFF9E.quest_desc: ["将残骸熔炼成废料，再与黄金结合，锻造出下界合金锭。稀有、坚固，且能抵御熔岩。"]
	quest.662ED841F22DFF9E.quest_subtitle: "稀有、强大，且能抵御熔岩。"
	quest.662ED841F22DFF9E.subtitle: "稀有、强大，且能抵御熔岩。"
	quest.662ED841F22DFF9E.title: "锻造于火焰之中"
	quest.66313743D1ED9BED.quest_desc: ["Ever wanted to drink several potions at once? Now you can. With a brewing cauldron and a herbal infusion you can blend 3 potions of your choice into a single flask. Note: mixing the same potion twice does not make it stronger."]
	quest.66313743D1ED9BED.quest_subtitle: "伪装起来的药水。"
	quest.66313743D1ED9BED.title: "便携茶包"
	quest.665CB4C6F55C3CEE.quest_desc: ["差速器能像汽车车轴一样合并或分离旋转。液压传动能将旋转通过管道传递，摩擦加热器则能将旋转转化为热量，用于你的熔炉。"]
	quest.665CB4C6F55C3CEE.quest_subtitle: "巴贝奇会为此感到自豪的。"
	quest.665CB4C6F55C3CEE.title: "差分引擎 (The Difference Engine)"
	quest.665D6090948EC434.quest_desc: ["有些鸟儿只是在炫耀。孔雀开屏，天鹅滑翔如贵族，公鸡则不管你是否需要，都会宣告早晨的到来。"]
	quest.665D6090948EC434.quest_subtitle: "展示一下你的本事吧。"
	quest.665D6090948EC434.title: "孔雀般骄傲的孔雀（Proud as a Peacock）"
	quest.666684880D0F26AB.quest_desc: ["吹一声口哨，忠诚的伙伴就会从不知何处小跑到你身边。"]
	quest.666684880D0F26AB.quest_subtitle: "谁是乖孩子？是他，就是他。"
	quest.666684880D0F26AB.title: "好孩子"
	quest.6675598F78127F63.quest_desc: ["Decals 警告、指示和装饰：放射性、易燃、骷髅、箭头等。Placards 将单个物品展示在整洁的框架中。为一切贴上标签。"]
	quest.6675598F78127F63.quest_subtitle: "通往危险地带的公路。"
	quest.6675598F78127F63.title: "危险区域"
	quest.667B2185906B3E97.quest_desc: ["机械锯可将原木切成木板和去皮木材，在装置上还能砍树。在固定模式下，它就像用于木材的切石机一样。"]
	quest.667B2185906B3E97.quest_subtitle: "量一次，切多次。"
	quest.667B2185906B3E97.title: "锯木厂"
	quest.667EC8CFD4D8FD55.quest_desc: ["茶壶在炉子上泡茶。铜制茶壶是它的闪亮升级版。每个家都需要一个。"]
	quest.667EC8CFD4D8FD55.quest_subtitle: "英国人对一切事物的终极答案。"
	quest.667EC8CFD4D8FD55.title: "水壶已经烧开了"
	quest.669D0BDD6AB98A12.quest_desc: ["每个背包升级都始于一个升级底座。多做一些吧，你肯定需要大量升级。"]
	quest.669D0BDD6AB98A12.quest_subtitle: "等级提升。"
	quest.669D0BDD6AB98A12.title: "升级路径"
	quest.66A888F0A86B2C50.quest_desc: ["缓冲器能让列车在轨道末端停下，并为你的车厢配上合适的车头。给它们上色，把木板换成木板方块，再选一种耦合器样式：链式、螺旋式或自动式。"]
	quest.66A888F0A86B2C50.quest_subtitle: "所有人都离开这里。"
	quest.66A888F0A86B2C50.title: "线路的终点"
	quest.66ACF2BF8023298B.quest_desc: ["斜齿轮、同轴齿轮、行星齿轮组和差速器：真实的机械工程部件，让你能混合速度、分配动力并以优雅的方式转弯。"]
	quest.66ACF2BF8023298B.quest_subtitle: "每一颗牙齿都很重要。"
	quest.66ACF2BF8023298B.title: "齿轮头 (Gear Head)"
	quest.66D35C798265113E.quest_desc: ["滤镜能改变你的拍摄风格：铅笔素描、模糊、艺术、抖动、NTSC、像素等等。安装一个试试。"]
	quest.66D35C798265113E.quest_subtitle: "瓦伦西亚还是克拉伦登？"
	quest.66D35C798265113E.title: "Instagram Era"
	quest.66E5BD6B163596AC.quest_desc: ["制作一套基础工具。镐可以开采石头和矿石。"]
	quest.66E5BD6B163596AC.subtitle: "好的装备能让每次旅程更美好。"
	quest.66E5BD6B163596AC.title: "工具"
	quest.66EC2B9E6652E4C1.quest_desc: [
		"控制台或控制架可放置控制模块：缰绳、操纵杆、方向盘、节流阀、踏板、杠杆和按钮面板。按你喜欢的方式排列，每个模块都会驱动其自身的红石输出。"
		""
		"建造一张桌子并安装你的第一个模块。"
	]
	quest.66EC2B9E6652E4C1.quest_subtitle: "休斯顿，我们有一个驾驶舱了。"
	quest.66EC2B9E6652E4C1.title: "任务控制中心"
	quest.66F29EFC92FB7D80.quest_desc: ["举办一场真正的海滩派对：小屋、酒吧、鸡尾酒、音乐和朋友们。在 Farbound，夏天永远不会结束。"]
	quest.66F29EFC92FB7D80.quest_subtitle: "冲浪开始了。"
	quest.66F29EFC92FB7D80.title: "无尽夏日"
	quest.66F9285A0B8EA8D9.quest_desc: ["月球之外是火星：红色的沙土、冰冻的极地和充满奇异矿石的洞穴。这是一段漫长的旅程。请做好准备。"]
	quest.66F9285A0B8EA8D9.quest_subtitle: "火星上有生命吗？"
	quest.66F9285A0B8EA8D9.title: "火星上有生命吗？"
	quest.67001A0F578036CD.quest_desc: ["铜会由亮变绿，除非你阻止它：蜂巢能封住你喜欢的特定色调。选择你的铜锈，然后打蜡。"]
	quest.67001A0F578036CD.quest_subtitle: "铜会氧化。由你决定何时发生。"
	quest.67001A0F578036CD.title: "上蜡，去蜡"
	quest.6710DE9933F61633.quest_desc: ["有时瓶子上岸冲上沙滩。是谁寄的？上面写着什么？找一个读读看。"]
	quest.6710DE9933F61633.quest_subtitle: "我将向全世界发送求救信号。"
	quest.6710DE9933F61633.title: "瓶中信 (Message in a Bottle)"
	quest.671138773044A6BC.quest_desc: ["文明的服务需要高礼帽，另类的需要女巫帽。两者都无法改善茶，却能改善场合。"]
	quest.671138773044A6BC.quest_subtitle: "帽子造就了主人。"
	quest.671138773044A6BC.title: "疯狂帽匠的茶会"
	quest.6720E6D838856236.quest_desc: ["刀加空白蛋糕得到纸杯蛋糕。刀加擀面杖得到饼干。顺序错了，得到的会是教训而不是点心。把两种都做出来。"]
	quest.6720E6D838856236.quest_subtitle: "运算顺序很重要，不能出错。"
	quest.6720E6D838856236.title: "切割与滚动"
	quest.6734F758BE5CD821.quest_desc: ["将一叠石头放入石匠台并选择一个变体。对木头、玻璃和羊毛也这样做。有成千上万种，纹理永远不会用完。"]
	quest.6734F758BE5CD821.quest_subtitle: "多样性是生活的调味剂。"
	quest.6734F758BE5CD821.title: "石头的五十种颜色"
	quest.673F64181859C369.quest_desc: ["苦力怕一看到你的脚，就决定换个地方待着。"]
	quest.673F64181859C369.quest_subtitle: "我们对爆炸之神说什么？今天不行。"
	quest.673F64181859C369.title: "今天不行，苦力怕（Not Today, Creeper）"
	quest.67483C975CB5393D.quest_desc: ["釉面曲奇、蜂蜜曲奇、甜浆果曲奇、咖啡曲奇。烤一罐出来，留给顺道经过的人吧。"]
	quest.67483C975CB5393D.quest_subtitle: "对我来说这样就足够了。"
	quest.67483C975CB5393D.title: "C 代表 Cookie（饼干）"
	quest.67746607BF92A0C2.quest_desc: ["柳树和棉白杨生长在水边。它们的木材能建造出完美的女巫小屋。"]
	quest.67746607BF92A0C2.quest_subtitle: "女巫的木材。"
	quest.67746607BF92A0C2.title: "柳树鬼火"
	quest.679779296CC27C93.quest_desc: ["弩比弓威力更大，蓄力快，与怨恨更是绝配。制作一把，去教训附近的掠夺者。以快制快的诗意正义。"]
	quest.679779296CC27C93.quest_subtitle: "加载。瞄准。不要后悔。"
	quest.679779296CC27C93.title: "老贝齐"
	quest.6797824A1B32B9B1.quest_desc: ["轮胎也可以作为方块放置：轮胎、大型轮胎和巨型轮胎都是绝佳的装饰品、游乐场和保险杠。"]
	quest.6797824A1B32B9B1.quest_subtitle: "随波逐流，顺势而为。"
	quest.6797824A1B32B9B1.title: "轮毂盖"
	quest.6797B76AA1F8FE25.quest_desc: ["大、中、小尺寸的酒架可展示您的收藏。酒箱用于运输瓶装酒。"]
	quest.6797B76AA1F8FE25.quest_subtitle: "整洁的岁月痕迹。"
	quest.6797B76AA1F8FE25.title: "堆积如山"
	quest.679A829FFB6AB704.quest_desc: ["堡垒遗迹是猪灵堡垒，里面满是黄金和非常愤怒的猪灵。进去，拿走宝藏，然后出来。"]
	quest.679A829FFB6AB704.quest_subtitle: "猪灵喜欢黄金。"
	quest.679A829FFB6AB704.subtitle: "风险和回报并存。"
	quest.679A829FFB6AB704.title: "贪婪堡垒"
	quest.67CF9B36DFD09231.quest_desc: ["各种颜色和图案的窗帘、百叶窗、百叶板和相框，适用于您的窗户和墙壁。"]
	quest.67CF9B36DFD09231.quest_subtitle: "表演时间到了。"
	quest.67CF9B36DFD09231.title: "拉上窗帘"
	quest.67E265C802D1CF4F.quest_desc: ["不同的音阶发出不同颜色的声音：笛子般的 Gedeckt 和 Rohrflote，明亮的 Piccolo，芦苇般的 Trompette 和 Posaune，以及诡异的 Vox Humana。添加三种不同的音阶。"]
	quest.67E265C802D1CF4F.quest_subtitle: "字面意思，就是这么回事。"
	quest.67E265C802D1CF4F.title: "使出浑身解数，全力以赴"
	quest.6808A2FED88E314C.quest_desc: ["长毛的羊毛牛、湿地的水牛，还有厚毛的阿尔卑斯羊。山间动物产出不同奶酪所需的牛奶。"]
	quest.6808A2FED88E314C.quest_subtitle: "糟糕的发型日，每一天都是。"
	quest.6808A2FED88E314C.title: "高地牛"
	quest.681C1CF400F3D12B.quest_desc: [
		"铅制工具沉重缓慢，但出乎意料地耐用，铅刀是不错的厨房用具。甚至还有铅制马铠，可供你的忠实坐骑使用。"
		""
		"制作一件你选择的铅制装备。"
	]
	quest.681C1CF400F3D12B.quest_subtitle: "摇滚起来吧。"
	quest.681C1CF400F3D12B.title: "重金属摇滚"
	quest.681C8646BB6D8F3B.quest_desc: ["信号机安装在火车信号机上方的杆子上，用移动的臂指示状态。在多出口的黄铜信号机上，第一个信号机上方的第二个信号机表示部分或全部路径是否被阻塞。"]
	quest.681C8646BB6D8F3B.quest_subtitle: "武装完毕，一切就绪。"
	quest.681C8646BB6D8F3B.title: "旗帜放下"
	quest.681D0C55ABA7A9BB.quest_desc: ["更好的考古学在世界各地埋藏了挖掘点：可疑泥土、可疑红沙和化石泥土，隐藏在新的挖掘结构中。找到一个，小心挖掘，收集你的第一批文物碎片。"]
	quest.681D0C55ABA7A9BB.quest_subtitle: "X 标记了地层的位置。"
	quest.681D0C55ABA7A9BB.title: "挖掘现场"
	quest.684360092D35AF85.quest_desc: ["反应堆是一个由外壳、框架、核心、控制器、燃料棒输入口、冷却器和输出口组成的大型多方块结构。按照反应堆蓝图，用燃料棒和冷却剂填满它，就能产生巨大的能量。一旦出错，反应堆警报声将是你听到的最后声音。"]
	quest.684360092D35AF85.quest_subtitle: "我已成为死亡？不，我已成为力量。"
	quest.684360092D35AF85.title: "原子时代"
	quest.685796CDB787FE14.quest_desc: ["在某个下界的地方，猪会飞。是真的。去找一头吧。"]
	quest.685796CDB787FE14.quest_subtitle: "现在它们可以了。"
	quest.685796CDB787FE14.title: "当猪会飞的时候"
	quest.685B7B0AFF34C02C.quest_desc: ["一对 Crushing Wheels 能将矿石产量翻倍，并能批量粉碎。注意间距。"]
	quest.685B7B0AFF34C02C.subtitle: "矿石翻倍，进度翻倍。"
	quest.685B7B0AFF34C02C.title: "正在粉碎中"
	quest.68676904D4934AE7.quest_desc: ["气球不过是怀揣抱负的信封。装满暖空气，让它承载重量。气球提供升力，螺旋桨负责转向。学会两者。"]
	quest.68676904D4934AE7.subtitle: "热气，真正的升力。"
	quest.68676904D4934AE7.title: "信封"
	quest.686FF095CCA42698.quest_desc: ["进度条上多了两颗心，只要你戴着它，就能一直保留。"]
	quest.686FF095CCA42698.quest_subtitle: "又一个用于收藏的心脏容器。"
	quest.686FF095CCA42698.title: "一点小小的额外内容"
	quest.6871BCD14C8A3CB9.quest_desc: ["防毒面具能保护你免受化学炮弹的毒气云。谨慎的枪手都会佩戴一个。"]
	quest.6871BCD14C8A3CB9.quest_subtitle: "安全第一，即使在战争中也是如此。"
	quest.6871BCD14C8A3CB9.title: "深呼吸一口气"
	quest.6892E92B525C81B1.quest_desc: ["飞行控制计算机协调着飞船的推进器、螺旋桨和控制装置。它将你的输入转化为平衡的力，使飞船能飞向你所指的方向，而不是物理法则所决定的方向。"]
	quest.6892E92B525C81B1.quest_subtitle: "充气飞行员奥托批准了这项任务。"
	quest.6892E92B525C81B1.title: "自动驾驶仪已启动"
	quest.6899FB01DA6017C3.subtitle: "一个很不错的提升。"
	quest.689B9AA229E28C98.quest_desc: ["小锅可以酿造女巫药水：按正确顺序将草药投入火中搅拌，然后将药水舀入粗陶瓶中。"]
	quest.689B9AA229E28C98.quest_subtitle: "有邪恶的东西正向这个方向而来。"
	quest.689B9AA229E28C98.title: "双倍，双倍"
	quest.68BCA8E13BBE1119.quest_desc: ["厨师夹克、裤子、靴子和厨师帽，或者你更喜欢下地干活，就穿农民的背带裤。入乡随俗，各司其职。"]
	quest.68BCA8E13BBE1119.quest_subtitle: "熊已经开启了。"
	quest.68BCA8E13BBE1119.title: "好的，厨师先生！"
	quest.68CB9CEDD52FDCB4.quest_desc: ["Numismatics 添加了钱币和银行系统。铸造你的第一枚钱币，稍后设置自动化商店。"]
	quest.68CB9CEDD52FDCB4.title: "经济系统"
	quest.68E16494B175A80D.quest_desc: ["封闭式链传动将旋转沿着一排方块传递，而可调式链齿轮箱则通过红石信号改变速度。紧凑、整洁，令人满意。"]
	quest.68E16494B175A80D.quest_subtitle: "孤独的小河汇入大海。"
	quest.68E16494B175A80D.title: "Unchained Melody"
	quest.690841F2C602A80A.quest_desc: ["末地现在充满了各种生物群系：雾蒙蒙的蘑菇地、灯笼森林、水晶山脉、雨伞丛林、琥珀之地和硫磺泉。去其中两个地方看看吧。"]
	quest.690841F2C602A80A.quest_subtitle: "奇怪、美丽、充满异星风情。"
	quest.690841F2C602A80A.title: "另一个世界"
	quest.6935FA35FB270A67.quest_desc: [
		"大炮由一系列方块组成：后端的炮闩或末端、装火药的药室和用于增加射程的炮管部分。将其放置在炮架上并用扳手组装。通过炮口（或炮闩，如果你的大炮有）装入火药和炮弹，然后用红石发射。"
		""
		"你的第一门大炮很可能是铸铁的。但它不会是最后一门。"
	]
	quest.6935FA35FB270A67.quest_subtitle: "洞里着火了！Fire in the hole!"
	quest.6935FA35FB270A67.title: "瞄准，准备，开火！"
	quest.6973803808F899BF.quest_desc: ["苍白的花园里，灰橡树上挂着苍白的苔藓，眼花只在夜间开放。当你不注意时，有东西在那里走动。去拜访，收集一些苍白的苔藓，天黑前离开。"]
	quest.6973803808F899BF.quest_subtitle: "灰色而又寂静无声。"
	quest.6973803808F899BF.title: "苍白花园"
	quest.69799E34FA1B2D27.quest_desc: ["机械传送带连接两个转轴，用于输送物品或实体。使用干海带制成的传送带连接器放置传送带，并添加物品存放站。"]
	quest.69799E34FA1B2D27.quest_subtitle: "一切都在移动。"
	quest.69799E34FA1B2D27.title: "传送带 Conveyor Belt"
	quest.699FC4B14DA4066F.quest_desc: ["罐子可以装液体、饼干、药水、鱼，甚至萤火虫或史莱姆等小生物。用些漂亮的东西装满它，然后放在架子上吧。"]
	quest.699FC4B14DA4066F.quest_subtitle: "接住一颗流星，把它装进瓶子里。"
	quest.699FC4B14DA4066F.title: "装瓶封存"
	quest.69A5769547009C05.quest_desc: ["精密机械、蒸汽动力与智能物流。现在你可以建造几乎所有创造模组提供的东西，包括真正的飞艇螺旋桨和引擎。天空在等着你。"]
	quest.69A5769547009C05.quest_subtitle: "第二阶段已完成。"
	quest.69A5769547009C05.title: "黄铜时代"
	quest.69B08D28B440355E.quest_desc: [
		"物理组装器能将一组相连的方块变成一个模拟装置：一个具有真实物理特性的容器。建造物体，放置组装器，为其供电，它便会活起来。不相连的部分会分裂成独立容器，相连的部分则会合并。"
		""
		"组装任何东西，哪怕只是一块木筏，然后推它一把。"
	]
	quest.69B08D28B440355E.quest_subtitle: "复仇者们，集合！"
	quest.69B08D28B440355E.title: "全体集合！"
	quest.69CDA833A8475DEB.quest_desc: ["抱怨天黑的瞪眼怪、想玩捉迷藏的捣蛋鬼、开满鲜花的蘑菇花、爱收藏的粗砾哥布林，还有没人想再见的捣蛋者。找到其中三个。"]
	quest.69CDA833A8475DEB.quest_subtitle: "打个招呼。小心一点。"
	quest.69CDA833A8475DEB.title: "奇怪的邻居们"
	quest.69DC01214CB860E0.quest_desc: [
		"朴实的牛能产出牛奶、皮革和牛排，只需要一点小麦作为回报。农场动物现在有几种地区外观，所以雪地针叶林的牛和平原上的牛看起来并不一样。"
		""
		"去和其中一个打个招呼吧。"
	]
	quest.69DC01214CB860E0.quest_subtitle: "Moo 的意思是你好。"
	quest.69DC01214CB860E0.title: "天哪，太不可思议了"
	quest.69E3D8728032DA7F.quest_desc: ["熔炼你的铁，锻造一套完整的工具。它们比石头更耐用，也更具威力。"]
	quest.69E3D8728032DA7F.quest_subtitle: "把石制工具都留在这里吧。"
	quest.69E3D8728032DA7F.subtitle: "把石制工具都留在这里吧。"
	quest.69E3D8728032DA7F.title: "一套更坚固的装备套装"
	quest.69F04958791644E4.quest_desc: ["一扇本不该被打开的门。"]
	quest.69F04958791644E4.quest_subtitle: "一扇本不该被打开的门。"
	quest.69F04958791644E4.title: "永恒传送门"
	quest.6A1E2CAB93A4E901.quest_desc: ["古董地图是一张活地图。它会随着你的旅行，填充周围的土地、每个生物群系、每条道路和海岸。打开它，看看你已经走了多远。"]
	quest.6A1E2CAB93A4E901.quest_subtitle: "世界，由你自己的双脚所描绘。"
	quest.6A6263580C824858.quest_desc: ["第一倒就顺滑无比。爱尔兰的方式。"]
	quest.6A6263580C824858.quest_subtitle: "三重蒸馏。懂的都懂。"
	quest.6A6263580C824858.title: "詹姆斯顿麦芽酒"
	quest.6AB49C53524FCAFE.quest_desc: ["包裹可以通过邮件运送成堆的物品。封好包裹，用地址标签写上地址，然后交给信鸽。回信箱能让收件人自动把东西寄回给你。"]
	quest.6AB49C53524FCAFE.quest_subtitle: "用爱包裹着一切。"
	quest.6AB49C53524FCAFE.title: "补给包"
	quest.6ACD4D9B7FFE12B5.quest_desc: ["酿酒师的围裙、腿甲和靴子，还有适合葡萄园炎热天气的草帽。"]
	quest.6ACD4D9B7FFE12B5.quest_subtitle: "旧世界的魅力。"
	quest.6ACD4D9B7FFE12B5.title: "盛装出席"
	quest.6ADCA0BF689F0E8A.quest_desc: ["手工锤能改变放置家具的外观：不同的靠垫、床单和款式。每个室内设计师都需要一个。"]
	quest.6ADCA0BF689F0E8A.quest_subtitle: "鲍勃建筑工，我们能修好它吗？"
	quest.6ADCA0BF689F0E8A.title: "万能工匠"
	quest.6B1574F4AF82F2BF.quest_desc: ["物品保险库、包装器、蛙港、库存链接和请求器有十六种颜色，让你一眼就能区分系统。垂直保险库直立放置，节省地面空间。"]
	quest.6B1574F4AF82F2BF.quest_subtitle: "由彩虹组织整理而成。"
	quest.6B1574F4AF82F2BF.title: "色彩协调一致"
	quest.6B1EEDB6278E0777.quest_desc: [
		"睡袋让你可以在任何地方睡觉，而不会改变出生点。蹲下放置，睡过一夜，早上再把它卷起来。"
		""
		"非常适合在远离家乡的长途旅行中使用。"
	]
	quest.6B1EEDB6278E0777.quest_subtitle: "在星空下，越过岩石之上。"
	quest.6B1EEDB6278E0777.subtitle: "在下一段旅程前休息一下。"
	quest.6B1EEDB6278E0777.title: "露营之旅"
	quest.6B33F29D4237E975.quest_desc: ["Autunite 是一种略带绿色的放射性石材，可以切割成砖块、柱子和瓦片，非常适合用作反应堆大厅的装饰。"]
	quest.6B33F29D4237E975.quest_subtitle: "很漂亮，但不要舔它。"
	quest.6B33F29D4237E975.title: "放射性装饰物"
	quest.6B4B32A705DA8E2F.quest_desc: ["北极熊在冰冻群系中漫步。它们很温顺，除非你靠近它们的幼崽。请保持距离欣赏它们。"]
	quest.6B4B32A705DA8E2F.quest_subtitle: "寻找最基本的生活必需品吧。"
	quest.6B4B32A705DA8E2F.title: "生存必需品"
	quest.6B5DD2447C79B2D2.quest_desc: ["Levitite 天生就能对抗重力。把它建进船体，船就不再与天空抗衡了。为硬核建造提供强大的升力。"]
	quest.6B5DD2447C79B2D2.subtitle: "天空本身的材质。"
	quest.6B5DD2447C79B2D2.title: "Levitite"
	quest.6B6D914D9BC4827F.quest_desc: ["Encased Fan能将物品吹过其前方的任何物体。遇水冲刷，遇火熏烤，遇岩浆熔炼，遇灵魂火则被其缠绕。堪称最顶级的批量处理。"]
	quest.6B6D914D9BC4827F.quest_subtitle: "清洗、熏制、爆破、闹鬼。"
	quest.6B6D914D9BC4827F.title: "让我惊叹不已"
	quest.6BCF34C7DB38B3C6.quest_desc: ["在山中某处，有木屋、教堂和瞭望台。找一个，欣赏当地人的建筑技艺。"]
	quest.6BCF34C7DB38B3C6.quest_subtitle: "滑雪后滑雪是最好的滑雪。"
	quest.6BE8EA95EA58A266.quest_desc: ["世界各地的村庄和田野里都矗立着酿酒节的帐篷。找一个加入派对吧。"]
	quest.6BE8EA95EA58A266.quest_subtitle: "音乐永不停歇的地方。"
	quest.6BE8EA95EA58A266.title: "派对帐篷"
	quest.6BEBB2AD945D8A99.quest_desc: ["相机支架能让相机在长时间曝光和集体照中保持稳定。设置定时器，然后跑进镜头里。"]
	quest.6BEBB2AD945D8A99.quest_subtitle: "保持稳定的射击节奏，不要慌乱。"
	quest.6BEBB2AD945D8A99.title: "三脚架"
	quest.6BF018B57BEA137B.quest_desc: ["物品磁铁能将掉落物从几格外吸向你。在矿井中开启它，看着矿石向你飞来。"]
	quest.6BF018B57BEA137B.quest_subtitle: "不是你不行，是你的磁力不行。"
	quest.6BF018B57BEA137B.title: "迷人的个性 (Attractive Personality)"
	quest.6BFFB542C8943AA5.quest_desc: ["要填满仓库，得走遍很多地方。罗布斯塔在草原、大草原或其他炎热地区生长，如果草原没有的话。木槿和咖啡喜欢丛林。薰衣草和耶尔巴马特则偏爱高地，靠近樱桃林和草地。"]
	quest.6BFFB542C8943AA5.quest_subtitle: "世界会提供所需的一切。"
	quest.6BFFB542C8943AA5.title: "采集之旅"
	quest.6C0CC850192ACE26.quest_desc: ["P2P终端是玩家间的市场。插入银行卡和剪贴板，浏览列表，出售物品，或用冻结资金发布需求。命名P2P链接可作为购买物品和完成需求的返回缓冲区。"]
	quest.6C0CC850192ACE26.quest_subtitle: "直接交易，玩家与玩家之间。"
	quest.6C0CC850192ACE26.title: "点对点传输 (Peer to Peer)"
	quest.6C101DD0163529D6.quest_desc: ["激光指示器会发出光束，激光和光学传感器能探测到阻挡光束的方块。建造着陆导轨、近距离警报器和自动对接辅助装置。"]
	quest.6C101DD0163529D6.quest_subtitle: "激光已聚焦。"
	quest.6C101DD0163529D6.title: "Pew Pew"
	quest.6C289072D7962304.quest_desc: ["单一麦芽是酒桶的记忆。这一桶静置得足够久，才有了意义。"]
	quest.6C289072D7962304.quest_subtitle: "一桶一真相。"
	quest.6C289072D7962304.title: "莉莉图单一麦芽威士忌"
	quest.6C4D7E7ADD745CE3.quest_desc: [
		"在 Farbound 中，乐器是真正能演奏的。加载一首歌（MIDI 文件也行）或自由演奏，其他玩家都能听到。围坐在篝火旁，一起奏乐吧。"
		""
		"制作你的第一件乐器。"
	]
	quest.6C4D7E7ADD745CE3.quest_subtitle: "O 富饶的山谷。"
	quest.6C4D7E7ADD745CE3.title: "向你的巫师投一枚硬币"
	quest.6C52BE21A85E5071.quest_desc: [
		"欢迎来到 Hexalia，一个以自然魔法为核心的模组！"
		""
		"在这个独特的模组中，你将种植魔法草药和作物，举行仪式，调制特殊药水，助你成为一名伟大的女巫，并为你的世界之旅提供更多工具。"
		""
		"要开始，你需要收集一些魔法植物。先收集四种作为你魔法基础的魔法草药。"
	]
	quest.6C5C98D55D6A56D2.quest_desc: ["钛板和外壳可以建造火箭船体。钛合金强度更高，用于承受最大压力的部位。"]
	quest.6C5C98D55D6A56D2.quest_subtitle: "轻薄、轻便、耐用。"
	quest.6C5C98D55D6A56D2.title: "船体装甲板"
	quest.6C6D5E8638011901.quest_desc: ["高度保持能维持你的高度，姿态保持能维持你的朝向。两者都开启后，飞船会悬停在空中，方便你在甲板上走动。"]
	quest.6C6D5E8638011901.quest_subtitle: "别把手从方向盘上拿开。"
	quest.6C6D5E8638011901.title: "稳扎稳打，步步为营"
	quest.6C6E7F5F7C59399A.quest_desc: ["奶酪、培根等配料的通心粉碗。每个夜班工程师的最爱。"]
	quest.6C6E7F5F7C59399A.quest_subtitle: "美味的奶酪，令人满足。"
	quest.6C6E7F5F7C59399A.title: "Mac Attack"
	quest.6C7BCEF834359126.quest_desc: ["沙漠神殿遍布陷阱、谜题和法老的宝藏。采矿疲劳笼罩着大厅。请小心前行。"]
	quest.6C7BCEF834359126.quest_subtitle: "伊姆霍特普正在等待着你。"
	quest.6C7BCEF834359126.title: "木乃伊"
	quest.6CBAE4A6547CF72B.quest_desc: [
		"精密机制是Create的高级合成组件。用齿轮、金箔和电子管组装它。"
		"它能接入最强大的机器，从机械臂到部署器。"
	]
	quest.6CBAE4A6547CF72B.subtitle: "制造机器的机器制造器。"
	quest.6CBAE4A6547CF72B.title: "精准度"
	quest.6CFCC08E32FE6565.quest_desc: ["封套式转轴能让气球旋转而不泄露浮力。封套式管道则能让流体顺畅流动。整洁、隐蔽、高效。"]
	quest.6CFCC08E32FE6565.quest_subtitle: "伪装成别的模样的竖井。"
	quest.6CFCC08E32FE6565.title: "隐藏驱动器"
	quest.6D1E280D57F0B323.quest_desc: ["鹦鹉螺在温暖的海洋中游泳，可以用鹦鹉螺盔甲来骑乘。它的僵尸表亲，僵尸鹦鹉螺，会带着溺亡的骑手投入战斗。"]
	quest.6D1E280D57F0B323.quest_subtitle: "尼摩船长都会感到嫉妒的。"
	quest.6D1E280D57F0B323.title: "两万里的传奇冒险"
	quest.6D1FEE7B963DD68C.quest_desc: ["一百刀。到最后，刀会不假思索地切入该切之处。"]
	quest.6D1FEE7B963DD68C.quest_subtitle: "实践在盘子上展示出来。"
	quest.6D1FEE7B963DD68C.title: "刀具制作"
	quest.6D22DE1CC5C24B37.quest_desc: ["完成你的首个运输合同。规划路线，装载货物，并将其平稳送达指定区域。"]
	quest.6D22DE1CC5C24B37.quest_subtitle: "我属于你了。"
	quest.6D22DE1CC5C24B37.title: "签署、密封、交付完毕"
	quest.6D3168C8628C32AB.quest_desc: ["区域压力计能同时显示整个区域的压力。弹簧缓冲器能减缓移动部件的冲击，光学驱动器则以光速读取数据。"]
	quest.6D3168C8628C32AB.quest_subtitle: "它能承受多少重量呢？"
	quest.6D3168C8628C32AB.title: "在压力下"
	quest.6D331D409B479B52.quest_desc: ["乡村烤炉烘焙女巫的点心：寒莓派、风暴莓饼干、曼德拉根炖菜和一份超辣的三明治。"]
	quest.6D331D409B479B52.title: "女巫厨房"
	quest.6D342155FBEA561F.quest_desc: ["松鼠爬上树，浣熊翻箱倒柜，刺猬则蜷成带刺的球。找到这三种生物。"]
	quest.6D342155FBEA561F.quest_subtitle: "小小的居民，大大的个性。"
	quest.6D342155FBEA561F.title: "越过树篱 (Over the Hedge)"
	quest.6D4CE59B62A1A540.quest_desc: ["兔子动作敏捷，性格害羞，炖汤美味。幸运的猎人或许能找到兔脚，可以酿造跳跃药水。"]
	quest.6D4CE59B62A1A540.quest_subtitle: "这个洞到底有多深呢？"
	quest.6D4CE59B62A1A540.title: "追随白兔的脚步"
	quest.6D6ED20BB99271E1.quest_desc: ["史莱姆在沼泽和地下深处的史莱姆块中四处弹跳。大的会分裂成小的。史莱姆球可以制作粘性活塞和拴绳。"]
	quest.6D6ED20BB99271E1.quest_subtitle: "他把我变成史莱姆了！"
	quest.6D6ED20BB99271E1.title: "史莱姆怪！"
	quest.6D79519B62C82783.quest_desc: ["战利品从房间的另一头飞到你的口袋里。"]
	quest.6D79519B62C82783.quest_subtitle: "战利品都听命于你。万磁王会赞同的。"
	quest.6D79519B62C82783.title: "到我这里来 (Come to Me)"
	quest.6D822F325779F8A5.quest_desc: ["旋转速度控制器可将大型齿轮的速度精确设置为你所拨入的值。再也不用解齿轮比谜题了。"]
	quest.6D822F325779F8A5.quest_subtitle: "再快点，再快点，再快点。"
	quest.6D822F325779F8A5.title: "极品飞车"
	quest.6D88DBA667177B11.quest_desc: ["雪貂、水獭、小熊猫、蜗牛、瓢虫、球虫、竹节虫，还有一只像棉花球但有主见的白色小鸟。找到三种你从未见过的物种，停下来观察它们。"]
	quest.6D88DBA667177B11.quest_subtitle: "世界充满了无人注意到的事物。"
	quest.6D88DBA667177B11.title: "小物件"
	quest.6DA501BDE339A057.quest_desc: ["铜制背囊可储存高压空气。搭配潜水头盔，可在水下呼吸；搭配潜水靴，可在海底行走。它还为多种工具提供动力。"]
	quest.6DA501BDE339A057.quest_subtitle: "背上背着氧气瓶的潜水员。"
	quest.6DA501BDE339A057.title: "轻松呼吸"
	quest.6DBE6AC27FA9B4D4.quest_desc: ["它在太阳下山后才展现出真正的力量。"]
	quest.6DBE6AC27FA9B4D4.quest_subtitle: "我即是黑夜。"
	quest.6DBE6AC27FA9B4D4.title: "天黑之后"
	quest.6DC651CFBEFF6847.quest_desc: ["手推车是一种可以直接放在铁轨上的小车厢，无需车站或组装。用它来检查新线路或在第一列真火车建成前穿越山谷。一把扳手就能把它重新拾起。"]
	quest.6DC651CFBEFF6847.quest_subtitle: "铁路工人的双臂。"
	quest.6DC651CFBEFF6847.title: "锻铁成钢"
	quest.6DF20F92E38AAFBC.quest_desc: ["AI Core 是 AI 网络的核心。将 Audio Triggers 和 Speakers 连接到它，它就能读出周围的消息和信息。它甚至能安装在移动的载具上：一个会播报你海拔高度的智能船载电脑。"]
	quest.6DF20F92E38AAFBC.quest_subtitle: "抱歉，戴夫，恐怕我做不到那件事。"
	quest.6DF20F92E38AAFBC.title: "打开舱门入口处的门"
	quest.6DFBF7379A09659D.quest_desc: ["总有一天，你需要的将不仅仅是几块铁。堆叠六十四块铁锭，为自己赢得一个能更快熔炼的铁匠炉。"]
	quest.6DFBF7379A09659D.quest_subtitle: "在扩大规模前做好储备。"
	quest.6DFBF7379A09659D.subtitle: "在扩大规模前，先储备好物资。"
	quest.6DFBF7379A09659D.title: "多余的铁块（Iron to Spare）"
	quest.6E0A9638F72B88D6.quest_desc: ["每种牛奶都能制成自己的奶酪：山羊奶酪、绵羊奶酪、水牛奶酪、谷物奶酪，还有奇怪的扭曲奶酪和紫水晶奶酪。制作三种不同的奶酪轮。"]
	quest.6E0A9638F72B88D6.quest_subtitle: "葡萄酒不包含在内。请参见葡萄园。"
	quest.6E0A9638F72B88D6.title: "奶酪板"
	quest.6E36BD64A5D21A46.quest_desc: ["铂金矿石能产出用于高端推进部件的贵金属：可承受高温的外壳、板材和流体储罐。"]
	quest.6E36BD64A5D21A46.quest_subtitle: "获得了铂金。"
	quest.6E36BD64A5D21A46.title: "白金唱片"
	quest.6E535A54D2ADF552.quest_desc: ["拍下你的第一张照片。什么都可以：风景、建筑、生物，或者你的朋友。"]
	quest.6E535A54D2ADF552.quest_subtitle: "把它捕捉住。"
	quest.6E535A54D2ADF552.title: "柯达时刻"
	quest.6E59F7808044563A.quest_desc: ["储罐升级可将流体储存在背包中，泵升级可将其进出，电池升级可储存能量。"]
	quest.6E59F7808044563A.quest_subtitle: "携带水，携带岩浆。"
	quest.6E59F7808044563A.title: "流动资产"
	quest.6E5A7D44AD4F5B3D.quest_desc: [
		"在桌子周围放置15个书架可解锁最强附魔。桌子和书架之间留出一格空隙，不要用火把或地毯遮挡书架。"
		""
		"甘蔗造纸，牛产皮革，还有好多木板。图书馆是个项目，还是个温馨的项目。"
	]
	quest.6E5A7D44AD4F5B3D.quest_subtitle: "没有书的房间就像没有灵魂的身体。"
	quest.6E5A7D44AD4F5B3D.title: "书架帮助"
	quest.6E6295D55AF6E8A5.quest_desc: ["悬赏板会发布狩猎合同、采集订单和委托。接取合同，追踪目标，回来领取奖励。野外指南会记录你学到的野生动物知识。"]
	quest.6E6295D55AF6E8A5.quest_subtitle: "赏金猎人是一个复杂的职业。"
	quest.6E6295D55AF6E8A5.title: "悬赏：生擒或活捉均可"
	quest.6E7A9F14AF63753E.quest_desc: ["有机堆肥会随时间变成富饶土壤，作物在上面生长得更快。种在富饶土壤上的蘑菇会蔓延成菌落。主要材料是刀获得的树皮和稻草。"]
	quest.6E7A9F14AF63753E.quest_subtitle: "好东西来了。"
	quest.6E7A9F14AF63753E.title: "泥土富翁"
	quest.6E9727100E0036F4.quest_desc: ["石灰岩和阿尔卑斯花岗岩建造的山间小屋，仿佛从山坡中生长出来。砖块、抛光石和苔藓变种则营造出沧桑感。"]
	quest.6E9727100E0036F4.quest_subtitle: "阿尔卑斯山脉的石头。"
	quest.6E9727100E0036F4.title: "建造于岩石之上"
	quest.6EC0145F873C5A85.quest_desc: ["在 Farbound 死亡后，你携带的大部分物品会保留。例外是你的背包内部。背包里的物品会洒落在你倒下的地方，并在那里等待十分钟才会消失。所以背包会留在你背上，但里面的战利品不会。请据此规划你的恢复之旅。"]
	quest.6EC0145F873C5A85.quest_subtitle: "死亡不过是漫长的一段回家路。"
	quest.6EC0145F873C5A85.subtitle: "你的载具会一直等着你。"
	quest.6EC0145F873C5A85.title: "并非末地"
	quest.6EC094FE7D425EEA.quest_desc: ["Inventory Connector 能将所有接触到的箱子、桶和存储方块连接成一个网络。在旁边放置 Storage Terminal，所有箱子里的物品都会显示在一个可搜索的界面上。再也不用打开二十个箱子来寻找一个火把了。"]
	quest.6EC094FE7D425EEA.quest_subtitle: "我把它放在哪儿了？哦，在这儿呢。"
	quest.6EC094FE7D425EEA.title: "完全记忆术"
	quest.6EC4FA257990A478.quest_desc: ["野花铺满地面，落叶覆盖林间，萤火虫灌木在夜间发光，仙人掌花在沙漠中绽放。收集几处春天的迹象。"]
	quest.6EC4FA257990A478.quest_subtitle: "万物都绽放出美丽的花朵。"
	quest.6EC4FA257990A478.title: "春之觉醒"
	quest.6ED9E3C909E9D29F.quest_desc: ["苹果派、发光浆果派、巧克力挞、林茨挞，还有给点了两次甜点的顾客准备的布丁。"]
	quest.6ED9E3C909E9D29F.quest_subtitle: "反制行动的严肃终结阶段。"
	quest.6ED9E3C909E9D29F.title: "派和挞类甜点"
	quest.6F041E6D0B4CF7CA.quest_desc: ["工厂流体计将流体引入工厂规划：它与普通计器一样请求液体。网络连接将独立网络合并为一个。"]
	quest.6F041E6D0B4CF7CA.quest_subtitle: "订购一桶岩浆，加急送达。"
	quest.6F041E6D0B4CF7CA.title: "液体物流系统 (Liquid Logistics)"
	quest.6F1C076546E75E27.quest_desc: ["你杀死的生物往往会留下比应有的更多的东西。"]
	quest.6F1C076546E75E27.quest_subtitle: "干得漂亮，船长。"
	quest.6F1C076546E75E27.title: "鱼钩，鱼线"
	quest.6F2F45E659DB40EE.quest_desc: ["燕麦能带来顺滑、奶油般的口感。播种一些来丰富你的储藏室吧。"]
	quest.6F2F45E659DB40EE.quest_subtitle: "播种然后等待即可。"
	quest.6F2F45E659DB40EE.title: "燕麦种子"
	quest.6F3EE72029786D00.quest_desc: ["各种颜色的靠垫、床品，还有主卧室的豪华大床。舒适是一种设计选择。"]
	quest.6F3EE72029786D00.quest_subtitle: "柔软，更柔软，最柔软。"
	quest.6F3EE72029786D00.title: "枕边私语"
	quest.6F619E858A3BDE7B.quest_desc: ["野生的啤酒花会爬上树木和围栏。收割它们，种植你自己的啤酒花田。农场田地的大麦、燕麦和小麦可以填满谷仓。"]
	quest.6F619E858A3BDE7B.quest_subtitle: "酿造啤酒的花朵，啤酒花。"
	quest.6F619E858A3BDE7B.title: "快行动起来"
	quest.6F8D79D775E295C8.quest_desc: ["付出一些自己的东西，通常都会得到丰厚的回报。"]
	quest.6F8D79D775E295C8.quest_subtitle: "等价交换。"
	quest.6F8D79D775E295C8.title: "贸易协议"
	quest.700220E63097508F.quest_desc: ["内置近距离语音聊天。与附近的人交谈，距离越远，声音越小。在语音聊天菜单中设置你的按键说话键，然后打个招呼吧。"]
	quest.700220E63097508F.quest_subtitle: "很好。"
	quest.700220E63097508F.title: "现在能听到我说话了吗？"
	quest.7018737CE2C7673F.quest_desc: ["即时相机能直接在相纸上打印照片。无需暗房，无需等待。对准、按下、摇晃。"]
	quest.7018737CE2C7673F.quest_subtitle: "嘿，你好！"
	quest.7018737CE2C7673F.title: "像宝丽来照片一样摇晃它"
	quest.7041E3C46A6B6717.quest_desc: ["蓝莓、蔓越莓和越橘都长在灌木和树上。浆果果酱、浆果玛芬、浆果曲奇：多采点吧。"]
	quest.7041E3C46A6B6717.quest_subtitle: "小巧而甜美。"
	quest.7041E3C46A6B6717.title: "浆果好手"
	quest.7042A2FD538EE061.quest_desc: ["草帽、围裙、护腿、靴子：酿酒师的完整套装。穿戴全部四件后，骨粉将停止消耗，盔甲会代替消耗。这是农民做过最划算的交易。"]
	quest.7042A2FD538EE061.quest_subtitle: "帽子承担了大部分工作。"
	quest.7042A2FD538EE061.title: "为丰收而盛装打扮"
	quest.7055212E2BDD6B5C.quest_desc: ["月球有自己的区域：明亮的高地、黑暗的月海、深邃的裂谷和尖刺平原。去月海和高地看看吧。"]
	quest.7055212E2BDD6B5C.quest_subtitle: "Pink Floyd 的音乐仍在继续播放。"
	quest.7055212E2BDD6B5C.title: "月亮的阴暗面"
	quest.707094E1008ED66A.quest_desc: ["The food factory makes ice cream in cones, bowls and sandwiches, milkshakes in bottles and cupcakes by the dozen. Summer, automated."]
	quest.707094E1008ED66A.quest_subtitle: "我们都为冰淇淋而尖叫。"
	quest.707094E1008ED66A.title: "我尖叫，你尖叫"
	quest.7071840D6B986A50.quest_desc: ["深挖钻石。用于锻造台、更好的工具和部分Create组件。"]
	quest.7071840D6B986A50.subtitle: "每一击都值回票价。"
	quest.7071840D6B986A50.title: "钻石"
	quest.70953F0988FBF0B8.quest_desc: ["松木奶酪架在奶酪陈化的同时，也能储存和展示你的奶酪轮。装满奶酪的地窖，就是装满财富的地窖。"]
	quest.70953F0988FBF0B8.quest_subtitle: "耐心让它变得锋利。"
	quest.70953F0988FBF0B8.title: "历经岁月沉淀，臻于完美"
	quest.70ADAE995165749E.quest_desc: ["木箱和袋子可以批量储存作物：一箱胡萝卜、一袋米、一箱鸡蛋。一个方块里放九样物品，堆在地下室里看起来真不错。"]
	quest.70ADAE995165749E.quest_subtitle: "存放得井井有条。"
	quest.70ADAE995165749E.title: "宝箱期望值"
	quest.70BCE8603B8A9891.quest_desc: ["在末地某处，坐落着一座由末地砖和熔岩构成的城市，金字塔和丛林神庙隐藏在陌生的新生物群中。找到末地城市。"]
	quest.70BCE8603B8A9891.quest_subtitle: "地狱中的一座大都市。"
	quest.70BCE8603B8A9891.title: "火焰之城"
	quest.70C5802EE6DD0F64.quest_desc: ["按下ping键即可在你注视的位置放置标记。好友能立即看到标记及距离。非常适合“落点标记”、“战利品标记”和“那是什么？”等场景。"]
	quest.70C5802EE6DD0F64.quest_subtitle: "看这个。不，是这个。"
	quest.70C5802EE6DD0F64.title: "叮咚！"
	quest.70E70BF94BDF82BC.quest_desc: ["征服三大地下城。很少有探险家能这么说。"]
	quest.70E70BF94BDF82BC.quest_subtitle: "你掷出了一个天然二十点。"
	quest.70E70BF94BDF82BC.title: "地下城主"
	quest.70F329625CA3130F.quest_desc: ["这里的物品展示框更智能：可以设为隐形，物品仿佛悬浮在墙上，也不再消耗性能。非常适合商店橱窗、奖杯墙和工具架。"]
	quest.70F329625CA3130F.quest_subtitle: "展示你最引以为傲的发现吧。"
	quest.70F329625CA3130F.title: "把它装裱起来"
	quest.70F7F013BCC91DEC.quest_desc: ["探访三种不同风格的村庄：或许是经典小镇、瑞典村庄和蘑菇村庄。走得越多，就越能看到人们建造方式的多样性。"]
	quest.70F7F013BCC91DEC.quest_subtitle: "每个地区都有自己的独特风格。"
	quest.70F7F013BCC91DEC.title: "城镇与乡村"
	quest.70FB14B0CDF58C48.quest_desc: ["像走过温暖的花园小径一样，穿过一片熔岩湖。"]
	quest.70FB14B0CDF58C48.quest_subtitle: "地板是岩浆。你完全不受影响。"
	quest.70FB14B0CDF58C48.title: "岩浆行者"
	quest.7106385024FEABB0.quest_desc: ["用旅途中的照片填满相册：天空、大海、深海、其他维度。一本用图片记录的旅行日记。"]
	quest.7106385024FEABB0.quest_subtitle: "一次一张照片，慢慢来。"
	quest.7106385024FEABB0.title: "环游世界"
	quest.710D5289A1D1FF85.quest_desc: ["手摇曲柄是最简单的旋转来源：按住右键并转动。它会消耗饥饿值且提供的动力很小，但足以测试机器。"]
	quest.710D5289A1D1FF85.quest_subtitle: "拿出你的全部力气来干吧。"
	quest.710D5289A1D1FF85.title: "Elbow Grease"
	quest.7156285DB2B8FF11.quest_desc: ["水槽上方的机械搅拌机可将原料混合成新原料：面团、合金、巧克力以及烹饪章节中的许多配方。部分配方需要下方的热量。"]
	quest.7156285DB2B8FF11.quest_subtitle: "名字是 Basin。机械盆地（Mechanical Basin）。"
	quest.7156285DB2B8FF11.title: "摇晃，而非搅拌"
	quest.715BC2014E19A49D.quest_desc: ["太妃糖、焦糖、黄油硬糖和棉花糖。食品工厂的糖果店。制作其中两种。"]
	quest.715BC2014E19A49D.quest_subtitle: "经《无敌破坏王》官方授权。"
	quest.715BC2014E19A49D.title: "糖霜冲刺"
	quest.7165AB591A9BEEC4.quest_desc: ["古老的遗迹散落在各地：旧锯木厂、被遗忘的学校、墓地、铁匠铺、青蛙养殖场。每一处都讲述着一个小故事。去寻找一处吧。"]
	quest.7165AB591A9BEEC4.quest_subtitle: "曾经，这里曾有人居住。"
	quest.7165AB591A9BEEC4.title: "往昔的回声"
	quest.7174354EA5D5DBC2.quest_desc: ["Junctions 可分割管道网络，Hypertube Funnels 可沿同一管道移动物品。Detector 和 scanner 附件能让红石对经过的物品做出反应。"]
	quest.7174354EA5D5DBC2.quest_subtitle: "向左还是向右，由你决定。"
	quest.7174354EA5D5DBC2.title: "选择你的道路"
	quest.71A4F8992773FE02.quest_desc: ["与好友一同演奏：三种乐器，一首乐曲。酒馆音乐会，飞艇甲板的夜曲。"]
	quest.71A4F8992773FE02.quest_subtitle: "把乐队重新召集起来吧。"
	quest.71A4F8992773FE02.title: "乐队 The Band"
	quest.71D9E1122CD91D2F.quest_desc: ["遗迹残骸埋藏在土壤之下。小心拨开可疑的砾石，发掘陶器碎片和古老宝藏。"]
	quest.71D9E1122CD91D2F.quest_subtitle: "这玩意儿就该放在博物馆里！"
	quest.71D9E1122CD91D2F.title: "印第安纳·琼斯"
	quest.71EB2232A6ED73C6.quest_desc: ["不死图腾能救你一命。通常得拿在手里。现在它能自己发挥作用，双手可以空出放工具和武器。林地府邸和袭击中的唤魔者会掉落。拿一个，装上，让自己勇敢一点。"]
	quest.71EB2232A6ED73C6.quest_subtitle: "以帅气的方式躲避死亡。"
	quest.71EB2232A6ED73C6.title: "幸运护身符"
	quest.71FF1492A49C1AA0.quest_desc: ["混合水果鸡尾酒：椰子、甜瓜、甜浆果、蜂蜜、南瓜和可可。用椰子杯盛装，有伞的话可以加上一把小伞。"]
	quest.71FF1492A49C1AA0.quest_subtitle: "如果你喜欢被雨淋湿的感觉的话。"
	quest.71FF1492A49C1AA0.title: "椰林飘香鸡尾酒"
	quest.720E91C53D554FB5.quest_desc: ["三明治、卷饼、木棍、挞，最后是芝士蛋糕。每个轮子都能成为更多。切开一个，烤熟整块板。"]
	quest.720E91C53D554FB5.quest_subtitle: "奶酪，不过是一道菜而已。"
	quest.720E91C53D554FB5.title: "整个棋盘"
	quest.7249FE1BF8B55CD2.quest_desc: ["一位巡回园丁正在各地游荡，用遥远生物群系的种子和植物进行交易。去见一位吧。"]
	quest.7249FE1BF8B55CD2.quest_subtitle: "来自远方的种子。"
	quest.7249FE1BF8B55CD2.title: "流浪的园丁 The Wandering Gardener"
	quest.72624E295E7A4B74.quest_desc: ["葡萄遍布世界各地，找到它们的地方决定你能得到什么：森林和平原的普通品种，丛林的藤蔓，耐寒的针叶林葡萄，以及运气极好的才能找到的稀树草原葡萄。把种子带回家吧，红的或白的。如果你认真的话，两种都要。"]
	quest.72624E295E7A4B74.quest_subtitle: "有人很久以前就种下了这些植物。"
	quest.72624E295E7A4B74.title: "野性藤蔓"
	quest.7262B8A36CE8E7BC.quest_desc: ["Crafting Terminal 添加了可直接从网络中获取材料的合成网格。配方查看器可以为你填充材料，这样一整组木板就能一键变成一整组箱子。"]
	quest.7262B8A36CE8E7BC.quest_subtitle: "每种材料占一格。"
	quest.7262B8A36CE8E7BC.title: "瞬息全宇宙 Everything Everywhere All at Once"
	quest.726F67FBE95643BF.quest_desc: ["赛马品种追求的是速度。纯血马一马当先，阿拉伯马越跑越快，而夸特马则擅长从静止状态迅猛起步。"]
	quest.726F67FBE95643BF.quest_subtitle: "那匹能行的小马驹，终于做到了。"
	quest.726F67FBE95643BF.title: "Seabiscuit"
	quest.7286F85DF6394B84.quest_desc: [
		"本章所有内容都用于破坏。炮弹、自动炮、火箭、炸弹和地雷能摧毁方块、地形和整个建筑，且无法修复。"
		""
		"在共享世界中，只有在所有参与者事先同意的情况下，武器才算是公平竞赛。未经同意向他人的基地、船只或建筑开火，或为未参与战斗的玩家留下陷阱，都属于破坏行为。服务器规则在此处同样适用。"
		""
		"勾选框确认，然后启动熔炉。"
	]
	quest.7286F85DF6394B84.quest_subtitle: "强大的火力伴随着巨大的责任而来。"
	quest.7286F85DF6394B84.title: "交战规则"
	quest.729C93720DB89BF6.quest_desc: ["黄铜、铜和绯红灯笼，还有矿井里的铅灯笼。把它们挂在回家的路上。"]
	quest.729C93720DB89BF6.quest_subtitle: "照亮前方的道路。"
	quest.729C93720DB89BF6.title: "灯笼节"
	quest.72C3C38638729B2F.quest_desc: ["鲨鱼在开阔水域巡逻：锤头鲨、大白鲨、双髻鲨、公牛鲨。它们速度快、饥饿，且不打算谈判。去见一只吧。最好是从船上。"]
	quest.72C3C38638729B2F.quest_subtitle: "我们需要一艘更大的船才能行得通。"
	quest.72C3C38638729B2F.title: "Jaws"
	quest.72C9BCDFF4658B21.quest_desc: ["工程师护目镜能让你在观察动能方块时看到应力和速度。建造时戴上它们。"]
	quest.72C9BCDFF4658B21.subtitle: "了解你的机器。"
	quest.72C9BCDFF4658B21.title: "护目镜"
	quest.72D458BC47C9B968.quest_desc: ["可调式燃烧器是气球船的心脏。控制热量，控制高度。所有热气球船的开始。"]
	quest.72D458BC47C9B968.subtitle: "热量就是海拔高度。"
	quest.72D458BC47C9B968.title: "燃烧器"
	quest.72DA4559DFA3D601.quest_desc: ["风暴曾烧毁屋顶。避雷针能将它们变成一场无财产损失的灯光秀。把它装在最高的桅杆上，让天空尽情肆虐吧。"]
	quest.72DA4559DFA3D601.quest_subtitle: "闪电现在要交房租了。"
	quest.72DA4559DFA3D601.title: "浪涌保护器"
	quest.72DFE8603D55D015.quest_desc: ["威士忌由干谷物和酵母酿造，至少需要一个铜制酿造站。每种威士忌都有自己的配方和标签：高地炉火、烟熏遐想、詹姆斯顿麦芽等等。酿造你的第一瓶威士忌吧。"]
	quest.72DFE8603D55D015.quest_subtitle: "Musha ring dumma do damma da."
	quest.72DFE8603D55D015.title: "威士忌在罐子里"
	quest.72E3A76F4F8988FD.quest_desc: [
		"要穿过传送门，飞船上需要装有带电源的跃迁门应答器，并且必须以足够快的速度飞过。飞船会进入跃迁空间，稍作等待，然后从目标传送门中出来。"
		""
		"驾驶飞空艇穿过你自己的传送门。"
	]
	quest.72E3A76F4F8988FD.quest_subtitle: "揍他，丘巴卡！"
	quest.72E3A76F4F8988FD.title: "跃迁至超空间"
	quest.72EB6FF3950F935A.quest_desc: ["醒着太久，幻影就会从天而降。它们的膜可以修复装备。或者干脆去睡觉。"]
	quest.72EB6FF3950F935A.quest_subtitle: "醒着的时间太久了，它们就来了。"
	quest.72EB6FF3950F935A.title: "失眠症 (Insomnia)"
	quest.7319957C1B1518E5.quest_desc: ["走道台阶将传送带变为自动扶梯。木质或金属的，它们无需费力即可将你上下运送。商场、车站和飞艇码头从未显得如此现代化。"]
	quest.7319957C1B1518E5.quest_subtitle: "而她正在购买一条通往天堂的阶梯。"
	quest.7319957C1B1518E5.title: "可移动的楼梯"
	quest.733D7380B9FB2087.quest_desc: ["投掷或使用绳索连接器发射器来远距离连接船只。安装在船上的发射器可以让船只自行发射绳索。"]
	quest.733D7380B9FB2087.quest_subtitle: "快到我这边来！"
	quest.733D7380B9FB2087.title: "抓钩钩爪"
	quest.7358A668CB46D42A.quest_desc: [
		"铅矿石存在于灰暗的石头和深板岩中。熔炼后的铅柔软、沉重且密度高：可制成铅皮、工具、盔甲，以及古老大教堂美丽的铅花玻璃窗。"
		""
		"开采并冶炼你的第一批铅锭。"
	]
	quest.7358A668CB46D42A.quest_subtitle: "这并不重，是我的兄弟在抱着我。"
	quest.7358A668CB46D42A.title: "把铅弄出来"
	quest.735BE7F9A14609DC.quest_desc: [
		"机械轴承能让所有黏附在它上面的东西旋转。门、风扇、旋转平台、巨型时钟。可与底盘结合用于更大型的建筑。"
		""
		"轴承也是螺旋桨的起点。请记住这一点。"
	]
	quest.735BE7F9A14609DC.quest_subtitle: "会转动的东西。"
	quest.735BE7F9A14609DC.title: "请耐心一点，我还在努力中"
	quest.735FEA0B4ACA0088.quest_desc: ["音频触发器会发送消息供AI读取。用机器包围它，它就能读取它们的数值：填充水平、速度、计数。扬声器能让你的AI在飞船的任何地方都有声音。"]
	quest.735FEA0B4ACA0088.quest_subtitle: "声音洪亮，清晰可闻。"
	quest.735FEA0B4ACA0088.title: "你能听到我说话吗？"
	quest.7364A95C8F6BB817.quest_desc: ["流水线上的华夫饼：巧克力、蜂蜜、焦糖、果酱和涂抹酱作顶。蘸苹果和糖渍浆果也出自同一条线。"]
	quest.7364A95C8F6BB817.quest_subtitle: "散落、覆盖、掩埋。到处都是。"
	quest.7364A95C8F6BB817.title: "华夫饼屋"
	quest.7366CF6C40E13F31.quest_desc: ["砖砌炉灶有多种颜色和材质，从泥砖到下界砖再到漂流木。挑选一个适合你厨房的款式吧。"]
	quest.7366CF6C40E13F31.quest_subtitle: "质朴的温馨感。"
	quest.7366CF6C40E13F31.title: "砖块烤炉"
	quest.737236499F487FB9.quest_desc: ["大白鲨、锤头鲨、虎鲨、公牛鲨、长尾鲨、鲸鲨、姥鲨、皱鳃鲨。在水中和它们相遇，然后收集无法咬人的版本：一整排鲨鱼毛绒玩具。"]
	quest.737236499F487FB9.quest_subtitle: "七张嘴，七个可爱的版本。"
	quest.737236499F487FB9.title: "鲨鱼周"
	quest.73850C997572945D.quest_desc: ["驴子和骡子会驮着箱子。装好箱子准备长途旅行，或者用马和驴杂交得到骡子。"]
	quest.73850C997572945D.quest_subtitle: "史瑞克有一个朋友。"
	quest.73850C997572945D.title: "驮兽的负担"
	quest.7385F27ED349BD8A.quest_desc: ["储物矿车和储物船都带有一个带全部升级的完整复杂储物箱。复杂储物系统也适用于创造装置和移动船只，所以你的飞艇货舱可以像基地一样智能。"]
	quest.7385F27ED349BD8A.quest_subtitle: "一切都将随之前行。"
	quest.7385F27ED349BD8A.title: "货物舱"
	quest.73F3320160192E77.quest_desc: ["升级可以将放置的箱子或桶提升一个等级，而不会清空里面的物品。将箱子升级为铁质。"]
	quest.73F3320160192E77.quest_subtitle: "现在已经没有什么能阻止我们了。"
	quest.73F3320160192E77.title: "更上一层楼，向着更高的目标迈进"
	quest.747167DCABF5B4DE.quest_desc: ["色彩缤纷的工业椅和座位，适合你的工坊、火车车厢或飞艇驾驶台。工程师也需要休息。"]
	quest.747167DCABF5B4DE.quest_subtitle: "工业风格的座椅。"
	quest.747167DCABF5B4DE.title: "拉把椅子坐下来聊聊天吧"
	quest.747FF19A5C879233.quest_desc: ["用风扇将矿石和砾石与水混合，可获得额外的金块、黏土和燧石。清洗沙子可获得黏土，清洗灵魂沙可获得石英和金。建造清洗机并让它运行。"]
	quest.747FF19A5C879233.quest_subtitle: "砾石中的黄金。"
	quest.747FF19A5C879233.title: "整理好你的行为举止"
	quest.748F89C6CCAC0FD6.quest_desc: ["肥沃的土壤并非捷径，而是正确堆肥的回报。种植在其中的作物都会感谢你。"]
	quest.748F89C6CCAC0FD6.quest_subtitle: "作物在这里生长得更快。"
	quest.748F89C6CCAC0FD6.title: "良田沃土"
	quest.74AB6AA9DD222E8C.quest_desc: ["烹饪一餐完整的饭菜。创建中央厨房，甚至可以自动化烹饪。"]
	quest.74AB6AA9DD222E8C.title: "盛宴"
	quest.74B82BAE662C735A.quest_desc: ["Betta、barreleye、anglerfish、pearlfish、sea nettles，还有那些本不该长这么多牙齿的生物。这片海洋现在物种齐全了。捕获三种无人知晓的物种。"]
	quest.74B82BAE662C735A.quest_subtitle: "水里的生物变得拥挤起来了。"
	quest.74B82BAE662C735A.title: "一个更大的海洋"
	quest.74BF6DE3F633F282.quest_desc: ["Salepoint 将 Create 的库存系统与银行账户相连，这样自动化商店和工厂产出就能卖出真钱。"]
	quest.74BF6DE3F633F282.quest_subtitle: "要卡片还是要现金？"
	quest.74BF6DE3F633F282.title: "销售终端 (Point of Sale)"
	quest.74DC6E6193901765.quest_desc: ["盐灯能发出温暖的粉色调光。它不能净化空气，但能让任何地下房间都感觉像水疗中心一样。"]
	quest.74DC6E6193901765.quest_subtitle: "非常健康，十分平静。"
	quest.74DC6E6193901765.title: "喜马拉雅风情"
	quest.74EAC88FF17C6B3B.quest_desc: ["将原木变成木板，再将木板变成工作台。"]
	quest.74EAC88FF17C6B3B.title: "工作台"
	quest.74F8101F1B051416.quest_desc: ["伐木工能将原木切成你需要的各种木制品，就像石匠切石头一样。木柴堆能让炉子整个冬天都燃烧不息。"]
	quest.74F8101F1B051416.quest_subtitle: "我是一个伐木工，我很好。"
	quest.74F8101F1B051416.title: "伐木工之歌"
	quest.7506307C28723094.quest_desc: ["布丁、无花果布丁、蓝莓卡仕达、发光浆果卡仕达。适合温馨夜晚的颤颤巍巍的甜点。"]
	quest.7506307C28723094.quest_subtitle: "正在吃东西的里面。"
	quest.7506307C28723094.title: "布丁的证明 (Proof of the Pudding)"
	quest.75271F3AEA6BDB15.quest_desc: [
		"信件由栖息在鸽舍里的鸽子传递。建造一个，让鸽子搬进来，并保持干净。鸽舍会随着时间的推移收集，比如说，废弃物，有时里面会有闪闪发光的东西。"
		""
		"发现一只信鸽并建造一个鸽舍。"
	]
	quest.75271F3AEA6BDB15.quest_subtitle: "翱翔在友好的蓝天之上。"
	quest.75271F3AEA6BDB15.title: "信鸽信使"
	quest.753E3349974CC727.quest_desc: ["齿轮轴将旋转沿直线传递。齿轮将其横向传递，大齿轮则改变速度。了解小齿轮如何与大齿轮啮合，你就掌握了创造的一半。"]
	quest.753E3349974CC727.quest_subtitle: "旋转，转动，重复。"
	quest.753E3349974CC727.title: "Shaft 发生了"
	quest.754279FF2EA13587.quest_desc: ["门前垫块地垫，大厅里放个衣帽架，用置物架展示你的最爱，花园里立座雕像。在家中布置这三个小细节吧。"]
	quest.754279FF2EA13587.quest_subtitle: "一切尽在细节之中。"
	quest.754279FF2EA13587.title: "那些小东西"
	quest.754475CBFC86A812.quest_desc: ["黄铜、锌、玫瑰石英和末影珍珠都可以用作盔甲修饰材料。在锻造台给铁甲装上黄铜修饰，你就能看起来像个真正的飞艇军官了。"]
	quest.754475CBFC86A812.quest_subtitle: "带着一丝优雅的气息。"
	quest.754475CBFC86A812.title: "黄铜配件"
	quest.75584C4ECCB95E93.quest_desc: ["挖个洞。再挖个洞。继续挖。石头不在乎你的计划、你的船或你的野心。它就在那里，等着被搬走。开采1000个石块，赢得你在地面上的立足之地。"]
	quest.75584C4ECCB95E93.quest_subtitle: "挖洞，再挖深一点"
	quest.75584C4ECCB95E93.subtitle: "慢工出细活，终有回报。"
	quest.75584C4ECCB95E93.title: "一块一块的岩石"
	quest.75730219330A910D.quest_desc: ["法师塔矗立在荒野中，随季节更替而变化。那里曾住着谁？他们研究的是什么？"]
	quest.75730219330A910D.quest_subtitle: "休想过去。或者，也许可以过去。"
	quest.75730219330A910D.title: "塔中的魔法师"
	quest.7573FBC740250867.quest_desc: [
		"飞空艇有天花板，火箭没有。离开大气层需要强大的引擎、轻便坚固的材料，以及途中可供呼吸的空气。"
		""
		"首先要找到制造所有火箭所用的金属。"
	]
	quest.7573FBC740250867.quest_subtitle: "失败不是一个可以接受的选择。"
	quest.7573FBC740250867.title: "休斯顿，我们遇到了问题"
	quest.7579F87AFEE7C424.quest_desc: [
		"传统上，你的第一个程序应该说 hello。输入 edit hello，在第一行写 print(\"Hello, World\")，保存并退出，然后运行 hello。"
		""
		"当计算机打印出你写的东西时，你就是在编程。本章其余部分只是更大规模的应用。"
	]
	quest.7579F87AFEE7C424.quest_subtitle: "每个程序员的第一句话。"
	quest.7579F87AFEE7C424.title: "Hello, World"
	quest.757E8CFAF3BDDC0E.quest_desc: ["它能吞噬所有施加在你身上的负面效果，一旦充满，便没有任何效果能穿透。"]
	quest.757E8CFAF3BDDC0E.quest_subtitle: "花费数年培养出的耐受性。值得了。"
	quest.757E8CFAF3BDDC0E.title: "瓶装免疫药水"
	quest.75941D2095F73DE3.quest_desc: ["巨大的家具目录：衣柜、书桌、抽屉、书架、橱柜、咖啡桌和现代风格的各式木制家具。用它来布置一间卧室吧。"]
	quest.75941D2095F73DE3.quest_subtitle: "扁平包装的幸福。"
	quest.75941D2095F73DE3.title: "宜家快跑"
	quest.75A7524343AA5302.quest_desc: ["翅膀在速度足够快时就能产生升力。钢化翅膀更坚固，复制翅膀能模仿任何纹理，让你的飞机看起来随心所欲。"]
	quest.75A7524343AA5302.quest_subtitle: "红牛能量饮料需单独购买。"
	quest.75A7524343AA5302.title: "展开你的翅膀"
	quest.75C0270E1F2CE3DE.quest_desc: ["木制桶可以挤牛奶、山羊奶、绵羊奶和水牛奶，每种奶都不同。牛奶罐可以携带更多。"]
	quest.75C0270E1F2CE3DE.quest_subtitle: "木制又奇妙。"
	quest.75C0270E1F2CE3DE.title: "水桶军团"
	quest.75C92DC12F1E1C11.quest_desc: ["缩小身体，小到能穿过一格的缝隙。"]
	quest.75C92DC12F1E1C11.quest_subtitle: "亲爱的，我把冒险家变小了。"
	quest.75C92DC12F1E1C11.title: "小世界"
	quest.75CECDCF6546E09D.quest_desc: ["元素节点蕴含着风、土、火、水之力。集齐四者，方能施展最强仪式。"]
	quest.75CECDCF6546E09D.quest_subtitle: "土、风、水与火。"
	quest.75CECDCF6546E09D.title: "元素魔法（Elemental）"
	quest.75DB62B16D308981.quest_desc: ["四面墙加篝火是营地。炉灶、柜台和架子是厨房。建一个吧。食物会立刻变好。"]
	quest.75DB62B16D308981.quest_subtitle: "任何优质基地的核心所在。"
	quest.75DB62B16D308981.title: "一个标准的厨房"
	quest.760F9244A229989F.quest_desc: ["板上的每瓶啤酒，架上的每瓶威士忌。无论你在这里如何消磨时光，这都是值得的。"]
	quest.760F9244A229989F.quest_subtitle: "人不能仅仅满足于一个目标。"
	quest.760F9244A229989F.title: "酿酒大师"
	quest.76752473ED031A31.quest_desc: ["三叉戟试炼纪念碑考验着每一位寻求海神武器的人。通过试炼。"]
	quest.76752473ED031A31.quest_subtitle: "海神要求你提供证明。"
	quest.76752473ED031A31.title: "波塞冬的试炼"
	quest.76B45E69515D06D2.quest_desc: ["飞艇站让你能挑选附近的飞艇，预览其记录路线，并派它出发。日程表中的货物条件会让飞艇在满载前等待出发。"]
	quest.76B45E69515D06D2.quest_subtitle: "所有乘客请前往三号登机口。"
	quest.76B45E69515D06D2.title: "现在开始登机"
	quest.76C0D93A13F852CA.quest_desc: ["铜和锌，加热和时间。黄铜是驱动造车机器的金属。所有值得制造的东西都由它制成。"]
	quest.76C0D93A13F852CA.subtitle: "驱动世界运转的金属。"
	quest.76C0D93A13F852CA.title: "黄铜"
	quest.76D207DDE369E42A.quest_desc: ["引信决定炮弹何时引爆：撞击、延迟、定时，或当有物体靠近。合适的引信能将未命中变为命中。"]
	quest.76D207DDE369E42A.quest_subtitle: "时机就是一切。"
	quest.76D207DDE369E42A.title: "点燃引信 (Light the Fuze)"
	quest.76E2F827EB9328A6.quest_desc: ["蔬菜面、面条汤和沿海的鳗鱼面。俗话说，长面条，长寿。煮一碗吧。"]
	quest.76E2F827EB9328A6.quest_subtitle: "请负责任地饮用。"
	quest.76E2F827EB9328A6.title: "开动脑筋，好好想想"
	quest.76E7A5FBBC33E9E5.quest_desc: ["一些飞艇和气球仍然完好无损，或悬停空中，或停泊在地面。附近通常有一座工程屋。找一个看看其他工程师是如何建造的。"]
	quest.76E7A5FBBC33E9E5.quest_subtitle: "其他生物也翱翔在这片天空之中。"
	quest.76E7A5FBBC33E9E5.title: "夜航的船只"
	quest.76F0EFBF7F6628E5.quest_desc: ["环形蛋糕在环形模具中烘烤，上桌前淋上糖霜并切片。任何庆典的焦点：婚礼、发布会派对，或是某个非常美好的星期二。"]
	quest.76F0EFBF7F6628E5.quest_subtitle: "环形幸福。"
	quest.76F0EFBF7F6628E5.title: "Nothing Bundt Cakes"
	quest.76FA463402CF680B.quest_desc: ["雾气缭绕的山中矗立着杉树森林的塔楼，用灯笼、纸块和相框纸可以在此建造茶屋。"]
	quest.76FA463402CF680B.quest_subtitle: "找到你内心的平静。"
	quest.76FA463402CF680B.title: "禅意花园"
	quest.76FCA38935F85793.quest_desc: ["铜制潜水服能隔绝海水压力：头盔和靴子来自创造，胸甲和护腿来自造船厂。压力护目镜能显示水流对附近船体的作用点。"]
	quest.76FCA38935F85793.quest_subtitle: "一路下潜，气泡不断。"
	quest.76FCA38935F85793.title: "深海潜水员"
	quest.7705445D9A0BC962.quest_desc: ["船锚是能让船停稳的重物。浮标是可拖拽的浮标，用于标记地点和拖拽渔网。每个港口都需要两者。"]
	quest.7705445D9A0BC962.quest_subtitle: "我们就待在这里不动了。"
	quest.7705445D9A0BC962.title: "放下船锚"
	quest.770870C0C34A6F75.quest_desc: ["锦鲤生活在平静的水中，在花园池塘里看起来很美。用桶抓住一只，并用睡莲为它建造一个家。"]
	quest.770870C0C34A6F75.quest_subtitle: "禅与养鱼的艺术。"
	quest.770870C0C34A6F75.title: "锦鲤池"
	quest.7715AB2594609383.quest_desc: ["Flywheel 本身不存储任何东西，也不做任何事情，除了装在转轴上转起来时看起来威风凛凛。装饰也是一种工程学。"]
	quest.7715AB2594609383.quest_subtitle: "沉重而令人着迷。"
	quest.7715AB2594609383.title: "旋转周期"
	quest.773B672853A9BF6A.quest_desc: ["燃料箱为列车携带液体燃料，便携式燃料接口可在列车停靠车站时为其加注。长途旅行，无需照看燃烧器。"]
	quest.773B672853A9BF6A.quest_subtitle: "把她喂饱吧。"
	quest.773B672853A9BF6A.title: "空转中，没有燃料可用"
	quest.774D9EF743281526.quest_desc: ["一款家庭自酿啤酒。清淡、简单，是你不假思索就能倒上一杯的那种。"]
	quest.774D9EF743281526.quest_subtitle: "以值得此名的人的名字命名。"
	quest.774D9EF743281526.title: "海莉"
	quest.777BCD532522CDC4.quest_desc: ["大型柴油发动机可连接以获得更强动力，巨型柴油发动机才是真正的动力源泉。发动机活塞、涡轮增压器和消音器可调节其动力或安静程度。"]
	quest.777BCD532522CDC4.quest_subtitle: "麦克斯·罗德里格斯会为此感到自豪。"
	quest.777BCD532522CDC4.title: "V8 拦截者"
	quest.778287C2B6DD4543.quest_desc: [
		"锤子和凿子能像用丝绸之触挖掘一样破坏方块。给它充能，对准方块释放，就能完整取出。用它处理砖块，可以将其变为雕凿过的形态。"
		""
		"燧石版本处理石质方块，黑曜石版本则直达钻石级别。"
	]
	quest.778287C2B6DD4543.quest_subtitle: "我在大理石中看到了天使，于是雕刻直到将他解放。"
	quest.778287C2B6DD4543.title: "米开朗基罗模式"
	quest.77873158984B1E05.quest_desc: ["Numismatics 添加了真实的硬币、银行和商人方块。在服务器中或仅为了装饰，设置商店，定价商品，让商业自行运转。"]
	quest.77873158984B1E05.quest_subtitle: "一个装在口袋里的经济系统。"
	quest.77873158984B1E05.title: "制作薄荷茶 (Making a Mint)"
	quest.77977534F968E3BD.quest_desc: ["每个茶会都需要一顶帽子。绅士主人需要高礼帽，秘密草药商需要女巫帽。"]
	quest.77977534F968E3BD.quest_subtitle: "为什么渡鸦像一张写字台？"
	quest.77977534F968E3BD.title: "疯狂帽子匠"
	quest.77B78C638A2DC884.quest_desc: ["水轮能将流动的水转化为稳定的旋转。将其放置在水流经过或冲击叶片的位置。水流冲击面越多，速度越快。大型水轮速度较慢，但能承受更大的负荷。"]
	quest.77B78C638A2DC884.quest_subtitle: "骄傲的玛丽在持续燃烧。"
	quest.77B78C638A2DC884.title: "在河流上漂流"
	quest.77D5ED8DD8663791.quest_desc: ["足够漂亮可以炫耀，也足够危险，触碰你总要付出代价。"]
	quest.77D5ED8DD8663791.quest_subtitle: "有人想和我一起抓水母吗？"
	quest.77F69DDD8D706389.quest_desc: [
		"海洋拥挤：海豚引你寻宝，鱿鱼墨染海水，发光鱿鱼在黑暗中闪烁，海龟则回到它们孵化的海滩。"
		""
		"与它们全部见面。"
	]
	quest.77F69DDD8D706389.quest_subtitle: "亲爱的，待在潮湿的地下会更好一些。"
	quest.77F69DDD8D706389.title: "海底世界"
	quest.780BF45BA8D4E976.quest_desc: ["磁力枪可在限定范围内拖动实体结构。将漂流的船只拖回船坞，或在焊接前对齐船体。"]
	quest.780BF45BA8D4E976.quest_subtitle: "我们被牵引光束困住了！"
	quest.780BF45BA8D4E976.title: "牵引光束"
	quest.781541FC2C3667FA.quest_desc: ["Glares 是一种生活在茂盛洞穴里的小苔藓生物，它们在黑暗附近会变得很暴躁。喂它们发光浆果，它们会带你去怪物可能刷出的黑暗区域。"]
	quest.781541FC2C3667FA.quest_subtitle: "害怕黑暗。"
	quest.781541FC2C3667FA.title: "熄灯派对"
	quest.782284448350BBA2.quest_desc: ["在末地底部深处，古代残骸隐藏在末地岩中。它抗爆炸，所以用床和TNT采矿很有效。将其熔炼成下界合金废料。"]
	quest.782284448350BBA2.quest_subtitle: "比下界本身还要古老的存在。"
	quest.782284448350BBA2.subtitle: "最深处的收获。"
	quest.782284448350BBA2.title: "深埋地底"
	quest.783BB852585EA0BB.quest_desc: ["新鲜马苏里拉奶酪适合搭配意面和沙拉。意面配马苏里拉奶酪和新鲜花园沙拉，是美味又清淡的午餐。"]
	quest.783BB852585EA0BB.quest_subtitle: "新鲜又有弹性。"
	quest.783BB852585EA0BB.title: "说声“茄子”"
	quest.784B509C09A6C026.quest_desc: ["荆棘塔从森林中拔地而起，缠绕着荆棘，充满了敌人。"]
	quest.784B509C09A6C026.quest_subtitle: "睡美人，但更糟。"
	quest.784B509C09A6C026.title: "荆棘之塔"
	quest.786DD609A9B333AD.quest_desc: ["一个雪景球、一顶冬帽和一个温暖的壁炉装饰。摇晃雪景球，欣赏雪花飘落。"]
	quest.786DD609A9B333AD.quest_subtitle: "一整个冬天，尽在掌握之中。"
	quest.786DD609A9B333AD.title: "雪景球"
	quest.7882963090D382BA.quest_desc: ["沉船散落在海滩和海底。它们的地图指向埋藏的宝藏。潜入水中，搜刮船长的宝箱吧。"]
	quest.7882963090D382BA.quest_subtitle: "有种被流放的既视感。"
	quest.7882963090D382BA.title: "海难幸存者模组（Shipwrecked）"
	quest.7888428C64769D98.quest_desc: ["陶艺台可将黏土塑造成花瓶、双耳瓶、瓮、花盆和陶罐。窑炉可将其烧制硬化。为黏土染色可获得彩色陶瓷。"]
	quest.7888428C64769D98.quest_subtitle: "幽灵，陶器制作场景。"
	quest.7888428C64769D98.title: "投掷陶罐"
	quest.789C102F43FC5FE3.quest_desc: ["辛西纳斯锻造炉是一种温度更高的熔炉。玄武岩、黑石和下界岩制成的下界熔炉也可以使用。"]
	quest.789C102F43FC5FE3.quest_subtitle: "火热的工作。"
	quest.789C102F43FC5FE3.title: "地狱熔炉"
	quest.78D497F8A20B9691.quest_desc: ["压舱石纯粹是增加重量。在船底放几块，可以调整向一侧倾斜的船只的平衡。"]
	quest.78D497F8A20B9691.quest_subtitle: "用老式的方法保持平衡。"
	quest.78D497F8A20B9691.title: "沉重的负担"
	quest.78ECC13E6E9905F6.quest_desc: ["巡航导弹会飞往目标指示器设定的目标。用于最顽固目标的重型武器。"]
	quest.78ECC13E6E9905F6.quest_subtitle: "已锁定目标。"
	quest.78ECC13E6E9905F6.title: "火与遗忘"
	quest.79022994A93011DA.quest_desc: ["Bloomwrap、Moonweave 和 Silkweave 的长袍、兜帽、斗篷和足布。打扮成女巫该有的样子。"]
	quest.79022994A93011DA.quest_subtitle: "女巫风潮，别致时尚。"
	quest.79022994A93011DA.title: "长袍时装秀"
	quest.790CD2F59208668F.quest_desc: ["每家面包店都始于面团。将小麦磨成面粉，与水混合，然后揉捏。甜面团、蛋糕面团和普通面团是本章节一切事物的三大基础。"]
	quest.790CD2F59208668F.quest_subtitle: "面粉、水、时间。"
	quest.790CD2F59208668F.title: "揉一揉就知道（Knead to Know）"
	quest.79350CC89BDDED20.quest_desc: ["草地上开满了新品种的花：羽扇豆、铃兰、蓝铃花、鸢尾、木槿、万寿菊、莲花。采摘五种不同的花来制作一束花束。"]
	quest.79350CC89BDDED20.quest_subtitle: "要爱，不要战争。"
	quest.79350CC89BDDED20.title: "花的力量"
	quest.7945F3453820081E.quest_desc: ["雕刻一个铜傀儡头，堆叠身体，看着它自行走去，按下最近的铜按钮，原因只有它自己知道。它会随时间氧化，就像所有优质的铜制品一样。"]
	quest.7945F3453820081E.quest_subtitle: "它会按下按钮。这就是它的全部工作。"
	quest.7945F3453820081E.title: "铜质哥布林"
	quest.79C71CB695556A80.quest_desc: ["机械压机可制作板件，并在传送带上压缩物品。是大多数装配线的核心。"]
	quest.79C71CB695556A80.subtitle: "按下，放置，重复操作。"
	quest.79C71CB695556A80.title: "按下"
	quest.79C887535ECC442B.quest_desc: [
		"Chunk Loader 能在你离开时保持周围区块的运行，只要它有旋转动力。Andesite 版是基础款，Brass 版功能更强，可以安装在机械装置上。"
		""
		"在探索的同时，保持工厂运转，火车运行。"
	]
	quest.79C887535ECC442B.quest_subtitle: "机器永不停歇地运转。"
	quest.79C887535ECC442B.title: "Always On"
	quest.79D03D12E870A2F6.quest_desc: ["邮箱会收取所有寄到你地址的信件。在家里放一个，并经常查看：朋友的信件和包裹都会在那里等着你。"]
	quest.79D03D12E870A2F6.quest_subtitle: "拜托了，邮递员先生。"
	quest.79D03D12E870A2F6.title: "邮箱"
	quest.7A04F346B72E338D.quest_desc: ["钱币学单片镜能让您一眼看清物品的价值。每位严肃的商人都不应忽视它。"]
	quest.7A04F346B72E338D.quest_subtitle: "绝对是与众不同的。"
	quest.7A04F346B72E338D.title: "单片眼镜微笑"
	quest.7A0A517E69C7F051.quest_desc: ["灯塔矗立在寂寥的海岸，指引船只绕过礁石。登上顶端，眺望远方的大海。"]
	quest.7A0A517E69C7F051.quest_subtitle: "引导船只返航。"
	quest.7A0A517E69C7F051.title: "灯塔守护者"
	quest.7A170FFA6CD2A9A5.quest_desc: ["啤酒花赋予啤酒独特的风味。这款啤酒毫不掩饰其苦味。"]
	quest.7A170FFA6CD2A9A5.quest_subtitle: "先咬一口，再慢慢品尝。"
	quest.7A170FFA6CD2A9A5.title: "啤酒花"
	quest.7A2337F3475F2403.quest_desc: ["蜻蜓可以装备：铁、金或钻石盔甲，按荒谬程度递增。制作一套，然后穿在你手大小的东西上。"]
	quest.7A2337F3475F2403.quest_subtitle: "是的，你可以给蜻蜓穿上盔甲。"
	quest.7A2337F3475F2403.title: "六条腿和一个马鞍"
	quest.7A2C051BE574C0F7.quest_desc: ["导航台能为放置在其上的指南针和地图等导航物品提供红石反馈。无需望向窗外，即可将船驶向家中。"]
	quest.7A2C051BE574C0F7.quest_subtitle: "规划一条航线。"
	quest.7A2C051BE574C0F7.title: "领航员"
	quest.7A2D587EDE1B4581.quest_desc: ["离子推进器使用电能而非燃料。安静、清洁，充满科幻感。"]
	quest.7A2D587EDE1B4581.quest_subtitle: "蓝色的光芒，无声的推动。"
	quest.7A2D587EDE1B4581.title: "离子推进器"
	quest.7A641A44983F154B.quest_desc: ["唱片机可以播放唱片。收集你旅途中的唱片：苦力怕掉落、地牢宝箱，以及隐藏在深海、天空和海滩的特别唱片。"]
	quest.7A641A44983F154B.quest_subtitle: "永久记录，永不磨灭。"
	quest.7A641A44983F154B.title: "视频终结了广播明星"
	quest.7A8952769AD1E16E.quest_desc: ["四种颜色、六种金属的金属灯，从安山岩到工业铁。通电后会发光，能让任何引擎室都充满生机。"]
	quest.7A8952769AD1E16E.quest_subtitle: "终于找到了！"
	quest.7A8952769AD1E16E.title: "灵光乍现的时刻"
	quest.7AD77D7EFE74433D.quest_desc: ["软管滑轮可将软管放入液体中并泵出，或用液体填充区域。足够大的湖泊和岩浆池甚至被视为无限供应。"]
	quest.7AD77D7EFE74433D.quest_subtitle: "排干湖水。"
	quest.7AD77D7EFE74433D.title: "软管滑轮"
	quest.7ADFE0EE9C41EAE4.quest_desc: ["苹果树和樱桃树生长在平原和草地上，果实就长在叶子上。空手右键即可。叶子会自行再生。小心偶尔出现的烂樱桃，不过它可是个好弹药。"]
	quest.7ADFE0EE9C41EAE4.quest_subtitle: "向上伸展。这就是全部的技巧所在。"
	quest.7ADFE0EE9C41EAE4.title: "树上的果实"
	quest.7AE4B0078F2D1041.quest_desc: ["潜行则隐于无形，轻举妄动则原形毕露。"]
	quest.7AE4B0078F2D1041.quest_subtitle: "每个巫师都想要这件斗篷。"
	quest.7AE4B0078F2D1041.title: "现在你不需要了 (Now You Don't)"
	quest.7AFF05E5D2F9ACD4.quest_desc: [
		"回馈自然，自然回馈。咖啡、路易波士和耶巴马黛可以种植和耕作。薰衣草和木槿不行，但用一点骨粉就能复制它们，让你永远不会短缺。"
		""
		"&l提示：用剪刀收割薰衣草花才能酿造。先复制它们，因为薰衣草花无法重新种植。&r"
	]
	quest.7AFF05E5D2F9ACD4.quest_subtitle: "大自然慷慨馈赠，双倍奉还。"
	quest.7AFF05E5D2F9ACD4.title: "花坛 The Flower Bed"
	quest.7B01745A07C2FBFB.quest_desc: ["你了解树叶，也找到了最喜欢的杯子。现在是时候揭开藏在茶里的秘密了。在合成台里将每种干茶各3个组合起来，制作草本浸剂。在炼药锅中冲泡，将你的药水制作提升到新水平。"]
	quest.7B01745A07C2FBFB.quest_subtitle: "配方中的配方。"
	quest.7B01745A07C2FBFB.title: "秘密配方大比拼"
	quest.7B024E123451C4C3.quest_desc: ["链式传送带将包裹沿着悬挂在传送轮之间的链条运输，高高悬于工厂地面之上。包裹会沿着链条被运送到目的地所指示的任何地方。"]
	quest.7B024E123451C4C3.quest_subtitle: "向上、越过、环绕四周。"
	quest.7B024E123451C4C3.title: "连锁反应"
	quest.7B121DE7387FEDC7.quest_desc: ["加固村庄隐藏在危险之地的城墙之后。找一个，欣赏它们的防御方式。"]
	quest.7B121DE7387FEDC7.quest_subtitle: "躲在石头后面很安全。"
	quest.7B121DE7387FEDC7.title: "城堡城墙"
	quest.7B1BACFEF9C9526E.quest_desc: ["山羊生活在高山之上，会冲撞任何静止不动太久的东西。偶尔，冲撞的山羊会在岩石中留下一个角，而山羊角会发出响亮的叫声。"]
	quest.7B1BACFEF9C9526E.quest_subtitle: "G.O.A.T."
	quest.7B1BACFEF9C9526E.title: "史上最伟大的存在"
	quest.7B1C8456C91C8183.quest_desc: ["这里没有鞘翅。天空本不该用借来的翅膀去穿越。建造一艘船，装上螺旋桨，赢得你的高度。准备好后，前往航空学章节。"]
	quest.7B1C8456C91C8183.subtitle: "赢得属于你的海拔高度。"
	quest.7B1C8456C91C8183.title: "这里没有翅膀"
	quest.7B6D803E024416D1.quest_desc: ["这里的附魔不是赌博。简易附魔让你能确切看到并选择附魔效果，这样你就不会把等级浪费在不想要的随机结果上。"]
	quest.7B6D803E024416D1.quest_subtitle: "在花费之前先做出选择。"
	quest.7B6D803E024416D1.subtitle: "在花费之前先做出选择。"
	quest.7B6D803E024416D1.title: "附魔前须知事项"
	quest.7BAC836BF0994825.quest_desc: ["Schematicannon 会从相连的箱子中逐块发射方块，在世界上构建蓝图。将你最出色的飞艇船体打印十遍。"]
	quest.7BAC836BF0994825.quest_subtitle: "喝茶的时候就能完成建造。"
	quest.7BAC836BF0994825.title: "打印机"
	quest.7BBDFB29E8CF6894.quest_desc: ["火控器将雷达与火炮相连。自动俯仰和自动偏航控制器使炮台转向目标，而目标和识别过滤器则决定哪些算作目标。身份应答器将己方船只标记为友军。"]
	quest.7BBDFB29E8CF6894.quest_subtitle: "让计算机来瞄准吧。"
	quest.7BBDFB29E8CF6894.title: "火焰控制"
	quest.7BD638BB4034AA04.quest_desc: ["来自野外的鹿肉、野牛、火鸡和食火鸡。在篝火上烹饪野味，品尝旷野的风味。"]
	quest.7BD638BB4034AA04.quest_subtitle: "农场到餐桌，森林版。"
	quest.7BD638BB4034AA04.title: "狩猎开始了"
	quest.7BDCB52E50C2FD3E.quest_desc: ["每种木材的横梁、木板、柱子和栏杆都能打造出真实的木结构。用任意颜色的灰泥填充缝隙，营造半木结构村庄的视觉效果。"]
	quest.7BDCB52E50C2FD3E.quest_subtitle: "中世纪的魅力。"
	quest.7BDCB52E50C2FD3E.title: "半木结构房屋"
	quest.7BFC02D10C130A8A.quest_desc: ["Sequenced Gearshift 会运行预设的旋转列表：转一定角度，等待，再转回来。非常适合吊桥、门和移动显示屏。"]
	quest.7BFC02D10C130A8A.quest_subtitle: "五、六、七、八！"
	quest.7BFC02D10C130A8A.title: "编舞 Choreography"
	quest.7C3307D1DB3DA9EE.quest_desc: ["培根、生菜和番茄堆叠的芝士汉堡，流水线生产。挑选你的配料。"]
	quest.7C3307D1DB3DA9EE.quest_subtitle: "他们管这叫皇家奶酪套餐。"
	quest.7C3307D1DB3DA9EE.title: "奶酪与皇家（Royale With Cheese）"
	quest.7C4B3FD943BA5D2C.quest_desc: ["从世界各地的果园中收集三种不同的水果。"]
	quest.7C4B3FD943BA5D2C.quest_subtitle: "切，切，切。"
	quest.7C4B3FD943BA5D2C.title: "水果忍者"
	quest.7C8102695F52300B.subtitle: "超越下界合金的第一步。"
	quest.7C84AE95E700F4E3.quest_desc: ["这支笛子清脆悦耳，非常适合在林间漫步时使用。"]
	quest.7C84AE95E700F4E3.quest_subtitle: "跟着音乐走。"
	quest.7C84AE95E700F4E3.title: "吹笛人"
	quest.7C9DB1CC6BA57A1B.quest_desc: ["模拟传动通过红石控制转速，方向齿轮控制方向。扭力弹簧在设定角度范围内传递旋转。是所有船只的传动系统工具包。"]
	quest.7C9DB1CC6BA57A1B.quest_subtitle: "向上移动，向下移动。"
	quest.7C9DB1CC6BA57A1B.title: "齿轮换挡器"
	quest.7CA009AC4F8BF1F8.quest_desc: ["建造一个带发射器、环形轨道和车站的过山车，然后乘坐体验。排队用的气球是可选的，但强烈建议添加。"]
	quest.7CA009AC4F8BF1F8.quest_subtitle: "我们可没少花钱。"
	quest.7CA009AC4F8BF1F8.title: "欢迎来到侏罗纪公园"
	quest.7CA33C035AF6148D.quest_desc: ["堆叠升级能让每个槽位容纳比普通堆叠更多的物品。一级升级可翻倍，更高等级则效果更佳。"]
	quest.7CA33C035AF6148D.quest_subtitle: "每个物品栏位更多。"
	quest.7CA33C035AF6148D.title: "堆栈溢出 (Stack Overflow)"
	quest.7CC1A1562CD6F9B1.quest_desc: ["真正的酿酒师会提供多种选择。酿造大麦啤酒、燕麦啤酒、啤酒花啤酒和奇怪的荨麻啤酒。海莉啤酒和深色酿造适合勇敢者。"]
	quest.7CC1A1562CD6F9B1.quest_subtitle: "把它们都尝一遍吧。"
	quest.7CC1A1562CD6F9B1.title: "啤酒品鉴之旅"
	quest.7D02599528E7BFBD.quest_desc: ["石头会碎成鹅卵石，鹅卵石可以投掷。收集一些吧：它们是廉价的弹药，适合在洞穴里测试回声，也是你像当地人一样采矿的第一个迹象。"]
	quest.7D02599528E7BFBD.quest_subtitle: "可能会把我的骨头都弄断了。"
	quest.7D02599528E7BFBD.title: "棍棒与石头"
	quest.7D13428BE7174DDB.quest_desc: ["扳手可以旋转、配置和拆除创造模组方块。你将经常使用它。"]
	quest.7D13428BE7174DDB.subtitle: "你最常用的工具。"
	quest.7D13428BE7174DDB.title: "扳手"
	quest.7D30A0BEF1C8A484.quest_desc: ["马蹄铁能让马在粉雪上行走，并减少坠落伤害。马急救包能在马的生命低于一半时治愈它。滑翔翼鞍能减缓高空坠落的速度，甚至可以完全抵消坠落伤害；容器可以在铁砧上为用过的鞍补充燃料。"]
	quest.7D30A0BEF1C8A484.quest_subtitle: "哒哒哒哒的马蹄声。"
	quest.7D30A0BEF1C8A484.title: "新鞋子"
	quest.7D58B8C54409D299.quest_desc: ["村庄、遗迹、地牢、残骸、原始森林和开阔的天空：你见过的末地世界比任何人都要多。名副其实的远方行者。"]
	quest.7D58B8C54409D299.quest_subtitle: "菲利亚斯·福格会为此感到自豪。"
	quest.7D58B8C54409D299.title: "八十天环游世界"
	quest.7D6200F0A564D369.quest_desc: [
		"木制镐、木制剑、木制斧。它们易坏且攻击力弱，但它们能帮你获得石头，而石头能带你去任何地方。"
		""
		"没人会框起自己的第一把木制镐子。但每个人都记得它。"
	]
	quest.7D6200F0A564D369.quest_subtitle: "客观上很糟糕，但人人都爱。"
	quest.7D6200F0A564D369.title: "卑微的开端"
	quest.7D63990D1B96D8C1.quest_desc: ["吸顶灯、台灯、纸灯笼、吊灯、提基火炬、带灯的吊扇。良好的照明是温馨房间最重要的部分。"]
	quest.7D63990D1B96D8C1.quest_subtitle: "黑暗已经是上一章的事了。"
	quest.7D63990D1B96D8C1.title: "打开灯盏"
	quest.7D65EAFA1FA73A07.quest_desc: ["Thallasium ore 是第一种末地金属。在 End Stone Smelter 中将其熔炼成锭，用于制作工具、盔甲、锁链和灯泡灯笼。"]
	quest.7D65EAFA1FA73A07.quest_subtitle: "来自虚空深处的金属。"
	quest.7D65EAFA1FA73A07.title: "塔拉西姆"
	quest.7D6BD3D878BBE0E5.quest_desc: ["喂食升级能让你在饥饿时从背包中进食。装满你最好的食物，长途旅行中再也不用担心吃的。"]
	quest.7D6BD3D878BBE0E5.quest_subtitle: "再也不会感到饥饿了。"
	quest.7D6BD3D878BBE0E5.title: "零食袭击"
	quest.7DB11AF303F9E33A.quest_desc: ["除非你手持一个，否则幻影轨道会消失，它们适合所有类型的火车。将它们铺在车站大厅或风景桥上，火车仿佛漂浮一般。"]
	quest.7DB11AF303F9E33A.quest_subtitle: "现在你看到它了。"
	quest.7DB11AF303F9E33A.title: "幽灵列车"
	quest.7DDB209AF28BF95F.quest_desc: ["九种让土豆消失的方法。填馅、油炸、捣泥、加盐、加酱等等。夏尔人会赞同的。"]
	quest.7DDB209AF28BF95F.quest_subtitle: "把它们放进炖锅里煮一煮。"
	quest.7DDB209AF28BF95F.title: "把它们煮熟，再捣成泥巴"
	quest.7DDD4FED89AAA98B.quest_desc: ["樱花和樱花林是粉色的花云。收集樱花木和白色或黄色的樱花树苗来装饰你的花园。"]
	quest.7DDD4FED89AAA98B.quest_subtitle: "樱花盛开的季节。"
	quest.7DDD4FED89AAA98B.title: "樱花盛开"
	quest.7E112CE6525F2255.quest_desc: ["信标控制器将信标标记放入全息图中，并能生成指向它的信标罗盘。在地图桌上标记目的地，并随身携带罗盘。"]
	quest.7E112CE6525F2255.quest_subtitle: "追随光亮的指引。"
	quest.7E112CE6525F2255.title: "兴趣点 (Point of Interest)"
	quest.7E27363303B5F5A6.quest_desc: ["高塔上的蒸馏控制器将原油分离为柴油、汽油和其他馏分，分别从不同高度流出。这是一个真实的炼油厂。"]
	quest.7E27363303B5F5A6.quest_subtitle: "把好东西分出来。"
	quest.7E27363303B5F5A6.title: "精致品味 (Refined Taste)"
	quest.7E365BE6FA66D05D.quest_desc: ["陀螺仪齿轮箱和红石转换器完善了线性工具。而泡泡糖方块，则以最棒的方式实现了粘性。"]
	quest.7E365BE6FA66D05D.quest_subtitle: "无论发生什么，都保持水平状态。"
	quest.7E365BE6FA66D05D.title: "旋转陀螺"
	quest.7E3BF06E064C7A1E.quest_desc: ["木制、陶土制和彩色的餐盘、杯子、碗和餐具组合。终于可以好好布置餐桌了。"]
	quest.7E3BF06E064C7A1E.quest_subtitle: "好盘子，仅限客人使用。"
	quest.7E3BF06E064C7A1E.title: "精美的中国瓷器"
	quest.7E52831A152C9DFB.quest_desc: ["烤潜贝、潜贝煎蛋、潜贝汤和酿潜贝。奇特却有营养。"]
	quest.7E52831A152C9DFB.quest_subtitle: "不要问里面是什么东西。"
	quest.7E52831A152C9DFB.title: "贝壳类食物"
	quest.7E5C21EEECBE86D0.quest_desc: ["电缆卷轴、电缆集线器和中继器能整齐地传输红石和信号。装配棒、自动粘合剂、装置移动器和复制器能让造船更快。"]
	quest.7E5C21EEECBE86D0.quest_subtitle: "一根线缆，统御所有。"
	quest.7E5C21EEECBE86D0.title: "已接入电源"
	quest.7E6B2F0C1ED6A34E.quest_desc: ["减压舱是一个气闸阀：让水流通过它来灌满或排空房间，以便潜水员进出潜艇。"]
	quest.7E6B2F0C1ED6A34E.quest_subtitle: "正在平衡压力。"
	quest.7E6B2F0C1ED6A34E.title: "气闸舱"
	quest.7E70A9E1634348D5.quest_desc: ["热气球燃烧器用热空气填充气球。将其置于气球袋开口下方并用红石供电，即可逐渐填充气球。输入面板设置最大输出，红石强度可调节输出，从而控制高度。多个燃烧器可为一个气球供气。"]
	quest.7E70A9E1634348D5.quest_subtitle: "基本上就是科学实验而已。"
	quest.7E70A9E1634348D5.title: "热气会上升"
	quest.7E8A198E75C050F7.quest_desc: ["Felting Needle 能将羊毛制成带图案的纺织品：斜纹布、提花布、格子布、粗花呢、乡村布和亚麻布。用高山图案制作地毯和床。"]
	quest.7E8A198E75C050F7.quest_subtitle: "羊毛变成毛衣。"
	quest.7E8A198E75C050F7.title: "温暖与羊毛的结合"
	quest.7EA4E20774E27AE4.quest_desc: ["鱼子酱，即烤面包上铺的熟鱼卵。庆祝航行成功的菜肴。咸鱼适合长途旅行。"]
	quest.7EA4E20774E27AE4.quest_subtitle: "鱼子酱的梦想。"
	quest.7EA4E20774E27AE4.title: "香槟风味"
	quest.7EA6A152A123E624.quest_desc: [
		"玉髓虹吸管会吸取站在上面的玩家的经验值，并存入旁边的雕花玉髓中。由红石供能的玉髓喷泉可将储存的电荷转化为经验球。二极管用于在方块间转移电荷。"
		""
		"建造一个虹吸管和一个喷泉，你就拥有了一个永不遗忘的经验银行。"
	]
	quest.7EA6A152A123E624.quest_subtitle: "先保存，再附魔。"
	quest.7EA6A152A123E624.title: "经验值银行"
	quest.7EC2881AECFF4577.quest_desc: ["羊驼会组成驼队：领头的一只，其余都会跟上。它们驮着箱子，披着地毯，还会朝不喜欢的人吐口水。"]
	quest.7EC2881AECFF4577.quest_subtitle: "没问题，小意思。"
	quest.7EC2881AECFF4577.title: "羊驼戏剧"
	quest.7ECA813275851D82.quest_desc: ["赤手空拳的搏斗，只不过拳头上着火了。"]
	quest.7ECA813275851D82.quest_subtitle: "火焰熊熊燃烧。"
	quest.7ECA813275851D82.title: "燃烧之拳"
	quest.7F134872508D7A56.quest_desc: ["瘟疫疯人院是一个充满疾病与恐惧的地方。带上牛奶。带上勇气。"]
	quest.7F134872508D7A56.quest_subtitle: "不要打开那扇门。"
	quest.7F134872508D7A56.title: "精神病院"
	quest.7F18C5637FACC5D3.quest_desc: ["黄石公园遍布温泉和彩池。可以参观，但请勿触摸水面。"]
	quest.7F18C5637FACC5D3.quest_subtitle: "一切按计划进行，准时完成。"
	quest.7F18C5637FACC5D3.title: "老忠实者"
	quest.7F32E52BB93E7AD2.quest_desc: ["四十八件小饰品，用苦尽甘来的方式获得的：来自地牢，来自守护它们的生物口袋，来自许久无人开启的宝箱。喜欢哪个就戴上，剩下的都留下。外面已经没什么可收集的了。"]
	quest.7F32E52BB93E7AD2.quest_subtitle: "最后一个都拿走。箱子里什么都不要留。"
	quest.7F32E52BB93E7AD2.title: "全套装备"
	quest.7F5FF907CBC0FF8A.quest_desc: ["好啤酒需要啤酒花来增添苦味和香气。收集一些来开始酿造吧。"]
	quest.7F5FF907CBC0FF8A.quest_subtitle: "第一批，第一课。"
	quest.7F5FF907CBC0FF8A.title: "一点苦涩的味道"
	quest.7F623C8D103CF05D.quest_desc: ["厨房橱柜将食材收纳得井然有序。带台面、玻璃门、抽屉和带门书架的储物柜，每种木材都能让您的厨房看起来浑然一体。"]
	quest.7F623C8D103CF05D.quest_subtitle: "每件物品都有它自己的位置。"
	quest.7F623C8D103CF05D.title: "橱柜之爱"
	quest.7F841B19552F5376.quest_desc: ["烛台、罐灯、竹灯和吊盆。墙上还有各种金属材质的壁灯和烛台。"]
	quest.7F841B19552F5376.quest_subtitle: "浪漫的照明效果。"
	quest.7F841B19552F5376.title: "烛光摇曳的"
	quest.7F92DA9DC86F0D29.quest_desc: ["电子管是高级设备的核心。由玫瑰石英和铁板制成。"]
	quest.7F92DA9DC86F0D29.subtitle: "机器的核心大脑所在之处。"
	quest.7F92DA9DC86F0D29.title: "管道"
	quest.7FB5E07E7249C7A1.quest_desc: ["锌矿石存在于更深层的岩层中，Create 需要大量锌矿石。开采它，将其粉碎以获得额外的锌粒，并准备好一箱锌锭。"]
	quest.7FB5E07E7249C7A1.quest_subtitle: "另一种金属。"
	quest.7FB5E07E7249C7A1.title: "锌，关于它的一切"
	quest.7FD1110289969649.quest_desc: ["把奶酪火锅架在火上，扔进一整轮奶酪，然后把面包直接蘸进去。这是用奶酪块能做的最文明的事，也是最不文明的一种吃法。"]
	quest.7FD1110289969649.quest_subtitle: "棒子上的面包。罐子里的奶酪。完美。"
	quest.7FD1110289969649.title: "熔岩之夜"
	quest.7FD2084D19FDCDBD.quest_desc: ["喷气背包能让你在空中飞行，铜腿推进器则提供快速冲刺。在低重力环境下，它们是最佳的移动方式。"]
	quest.7FD2084D19FDCDBD.quest_subtitle: "系好安全带，点亮灯光。"
	quest.7FD2084D19FDCDBD.title: "火箭背包客 (The Rocketeer)"
	quest.7FE8DE40497DB697.quest_desc: ["当它闪烁时，你也会闪烁——从而脱离险境。"]
	quest.7FE8DE40497DB697.quest_subtitle: "这不是故障，这是特性。"
	quest.7FE8DE40497DB697.title: "编织中的故障"
	quest.7FEA9EBE98FF5C31.quest_desc: [
		"Copycat 方块会模仿你放置的任何方块的外观。斜坡、切片、层板、梁、木板、玻璃板、楼梯、门：用任何你喜欢的纹理，建造出原版方块无法实现的形状。"
		""
		"制作几个，然后用你想让它们变成的那种方块右键点击它们。"
	]
	quest.7FEA9EBE98FF5C31.quest_subtitle: "模仿是最诚挚的奉承形式。"
	quest.7FEA9EBE98FF5C31.title: "Copycat"
	reward_table.1EBBB41D70473874.title: "普通"
	reward_table.4DDE115F767F7734.title: "史诗级"
	reward_table.5904D297CA962CD7.title: "不常见"
	reward_table.5CA76DE20A5FE947.title: "稀有"
	reward_table.7C60188570A02FB3.title: "传说级"
	task.008C65DB61329463.title: "羊毛"
	task.00B800CE229E96D7.title: "我建造了一辆蒸汽机车，有锅炉、烟囱和列车长"
	task.00F2D5853ED670B9.title: "获取3个羊毛"
	task.01075FBAF7047BA4.title: "找到一个修剪工具（Trim）"
