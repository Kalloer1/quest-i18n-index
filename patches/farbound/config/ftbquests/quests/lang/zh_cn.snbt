	task.04C245BEBB0311FC.title: "找到一个泰丰（Typhon）"
	task.058F6784152C20E4.title: "欢迎来到赫克西亚（hexalia）"
	task.06C85BD9F7533346.title: "制作一个吊床 (Craft a Hammock)"
	task.07CF5719BE1B663B.title: "我右键点击收成了作物"
	task.099060CF0CB39E23.title: "找到一个废弃的寺庙"
	task.0B78A472F0AF268E.title: "Chest"
	task.0C6D37CA0BBEA5F8.title: "找到一个埋藏的宝藏"
	task.0DCEF84966C9F237.title: "任何 #c:music_discs 唱片"
	task.0F23452FFB0516DC.title: "烹饪一顿丰盛的菜肴"
	task.10259FAA6094DA16.title: "我乘坐自己的船穿越了一片海洋"
	task.103ED4035F9D5CC2.title: "找到一个蘑菇村庄"
	task.105B01378B1C8841.title: "击杀 10 只末影人"
	task.10741E23D03E5070.title: "找到一个鸽舍（Dovecote）"
	task.10C59C4290F56FEC.title: "找到一个蘑菇田"
	task.115D6E9C30906941.title: "找到竞技场 (Coliseum)"
	task.119EA508A79EEBF5.title: "寻找一艘空中飞艇"
	task.11EBD00E3CE0D13F.title: "怪物在衣柜里"
	task.12E5B8DB8F77FF21.title: "贝壳类物品"
	task.130A66FAA6563E0D.title: "找到一个掠夺者船坞"
	task.131FF9E60E4979DD.title: "合成 32 个热气气球囊"
	task.13C35BD8423F0BD6.title: "找到一个沼泽小屋"
	task.13FE45E36AD40299.title: "我找到了我的船的最大飞行高度"
	task.14DE8DF6A2855C83.title: "我设置了语音聊"
	task.14E4FB3D538D0A60.title: "找到一个掠夺者前哨基地"
	task.161E714AC2606FA7.title: "找到小型飞艇 (Small Blimp)"
	task.16378B25E55A53B7.title: "找到一个下界堡垒"
	task.170E6A4728AC88B0.title: "用十字弓杀死一个掠夺者"
	task.1781E9855589CED0.title: "与 Hermit 交易 1× 次"
	task.17CA0C49AF7F082C.title: "找到一个下界城市"
	task.181A6BFBAD9AD5B9.title: "找到一个碎石堆 (Rubble)"
	task.18720247CE486ED1.title: "找到一个遗迹城镇"
	task.1885DE2056C8834A.title: "找到一个下界丛林生物群系"
	task.19698740FB6565EE.title: "找到一个商人营地"
	task.19CEDF1BCAE855FF.title: "我运营着一列自动化货运列车"
	task.19DC496F676958D6.title: "访问一个经过重制的村庄"
	task.19ED3AD11D3F4AB8.title: "寻找一位草药学历史学家"
	task.1A29489681B344B9.title: "极端消音器"
	task.1A5F7E661A41F2D2.title: "我见过深海与黑暗的传奇生物"
	task.1B0FD07CDDB78F3B.title: "获取8个生铅矿石"
	task.1B65CAED85D1401E.title: "把乐队重新召集起来吧。"
	task.1C10A79C4B90FC9F.title: "找到一个荆棘塔（Thornborn Towers）"
	task.1C5CDC4AE8A64E12.title: "收集一些食物。"
	task.1CA82E3175DD94BF.title: "找到一个史诗神殿"
	task.1CCDF6487BA2DE45.title: "更常被行走的道路上的旅行者们"
	task.1CDC631F6B40FA66.title: "找到一个不死者地穴（Undead Crypt）"
	task.1DF13B4F97C8D1A1.title: "找到一个掠夺者堡垒"
	task.1E2E695F0E4B258A.title: "更好的三叉戟模组 (Better Trident)"
	task.1E3121A2B1972D77.title: "找到一个绿木酒馆 Greenwood Pub"
	task.1E903324A4E355E0.title: "找到一个被感染的寺庙"
	task.1EC8940A72FCA3FA.title: "找到远古城市"
	task.1F4DC9E97D944E2F.title: "找到一个灯塔 (Lighthouse)"
	task.1FD52AC9A94EC079.title: "寻找一艘沉船遗迹"
	task.200689332E06AC64.title: "合成台 Crafting Table"
	task.201ABA6C806B7C8D.title: "找到一个法师塔"
	task.20F0A12FFC95864F.title: "访问一个月球平原生物群系"
	task.216B9129D7D7A25D.title: "我完成了一份送货合约"
	task.21748ADE21AF9E7C.title: "找到一个骨礁生物群系"
	task.21B02D588AEF366F.title: "找到一个掠夺者营地"
	task.21DA9D46052F1983.title: "寻找游戏中的指南手册"
	task.228C862C791C7016.title: "我改变了我的马的步态"
	task.23265A72A91B75D3.title: "Punchy 开/关"
	task.2368FB37493F0E45.title: "找到一个巨型蘑菇"
	task.23A54CF02BFD293D.title: "使用一个传送门"
	task.24AD928D5AA6B99C.title: "木桶"
	task.24B51B495A871945.title: "探访火星地下洞穴"
	task.24C9787EF585A6E5.title: "准备好去造船厂了吗"
