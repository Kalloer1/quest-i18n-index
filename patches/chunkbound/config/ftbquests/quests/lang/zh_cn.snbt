	chapter.607AF956D266B2CC.title: "ChunkBound"
	file.0000000000000001.title: "⚙ ChunkBound"
	quest.0000001000A001A1.quest_desc: [
		"§7你在寂静中醒来……周围的世界一片宁静——而且很小。"
		"§7无形的墙壁在伸手不及之处闪烁，将你困在单个§b区块§7内。"
		""
		"你的生存之旅始于§l§e此处§r§7。"
	]
	quest.0000001000A001A1.quest_subtitle: "§7当视野消失，世界也随之终结。"
	quest.0000001000A001A1.title: "§e被困在区块里了"
	quest.0000001000A002A1.quest_desc: [
		"§7每一段旅程都始于你的双手空空。"
		"砍树，收集§6原木§7，制作你的第一套工具。"
		""
		"§7木材是你在早期日子里最宝贵的盟友。"
	]
	quest.0000001000A002A1.quest_subtitle: "§7收集基础材料。"
	quest.0000001000A002A1.title: "§a第一步：初探世界"
	quest.0000001000A003A1.quest_desc: [
		"§7你的第一把工具很容易坏……但脚下的土地隐藏着更强大的东西。"
		"采集§8石头§7，制作你的第一把§7石制镐§7和§7石制斧§7。"
		""
		"§7对你而言是小步，对你的区块却是飞跃。"
	]
	quest.0000001000A003A1.quest_subtitle: "§7升级到石制工具。"
	quest.0000001000A003A1.title: "§7石头进度条"
	quest.0000001000A004A1.quest_desc: [
		"§7日落时分，黑暗悄然逼近……随之而来的，是低语的声息。"
		"制作几个§e火把§7，让你的家更安全，也让自己更安心。"
		""
		"§7一点小小的光亮，也能照亮远方。"
	]
	quest.0000001000A004A1.quest_subtitle: "§7把怪物们赶跑。"
	quest.0000001000A004A1.title: "§e黑暗中的光明"
	quest.0000001000A005A1.quest_desc: [
		"§7你的肚子咕咕叫——饥饿可不会等你。"
		"使用§6熔炉§7或篝火烹饪可食用的东西。"
		""
		"§7一顿热饭能让这座监狱都感觉有点像是家了。"
	]
	quest.0000001000A005A1.quest_subtitle: "§7烹饪你的第一份食物。"
	quest.0000001000A005A1.title: "§a第一餐食"
	quest.0000001000A006A1.quest_desc: [
		"§7雨在下，怪物在哀嚎，但你现在有墙了。"
		"为自己建造一个§a庇护所§7，占据这片世界的一小片角落。"
		""
		"§7这片区块就是你的王国——至少现在是。"
	]
	quest.0000001000A006A1.quest_subtitle: "§7建造你的第一个庇护所。"
	quest.0000001000A006A1.title: "§b温馨家园，乐在其中"
	quest.0000001000A007A1.quest_desc: [
		"§7你终于走到了边缘……而它正凝视着你。"
		"空气嗡嗡作响，你几乎能感觉到§c屏障§7正压迫着你的皮肤。"
		""
		"§7你很接近了——但还不够自由。"
	]
	quest.0000001000A007A1.quest_subtitle: "§7找到困住你的隐形墙壁。"
	quest.0000001000A007A1.title: "§c屏障 (The Barrier)</c1>"
	quest.0000001000A008A1.quest_desc: [
		"§7你知道了真相——自由是可以买到的。"
		"只要有足够的§a资源§7，或许就能打破屏障的束缚。"
		""
		"§7收集所需物品，让你的区块休息一下。"
	]
	quest.0000001000A008A1.quest_subtitle: "§7你可以花点代价来扩展……"
	quest.0000001000A008A1.title: "§d区块扩展模组 (Chunk Expansion)"
	quest.0000001000A009A1.quest_desc: [
		"§7一个简单的§8原石发电机§7是无限发展的第一步。"
		"Mine §832 Cobblestone§7 — 足以建造、制作和扩展你的世界。"
		""
		"§7很快，机器就会嗡嗡作响。"
	]
	quest.0000001000A009A1.quest_subtitle: "§7进步的基础。"
	quest.0000001000A009A1.title: "§7鹅卵石时代 (Cobblestone Era)"
	quest.0000001000A010A1.quest_desc: [
		"§7进步的火花。"
		"精炼你的第一块§f铁锭§7。"
		""
		"§7从现在开始，生存逐渐远去——工业开始崛起。"
	]
	quest.0000001000A010A1.quest_subtitle: "§7熔炼你的第一块铁锭。"
	quest.0000001000A010A1.title: "§6第一缕火焰"
	quest.0000002000A001A2.quest_desc: [
		"§7没有资源就无法扩张了。"
		"§7从小处着手——建造一个§e原石发电机§7。"
		""
		"§8提示：YACG 添加了可升级的自动生成器！"
	]
	quest.0000002000A001A2.quest_subtitle: "§7每个帝国都始于单一的鹅卵石。"
	quest.0000002000A001A2.title: "§e石工工程启动"
	quest.0000002000A002A2.quest_desc: [
		"§7稳定的鹅卵石供应固然很好——但将其熔炼能解锁新配方。"
		"§7Craft a §6Furnace§7 and fuel it with wood, coal or lava."
	]
	quest.0000002000A002A2.quest_subtitle: "§7将石头转化为进度。"
	quest.0000002000A002A2.title: "§b冶炼之力"
	quest.0000002000A003A2.quest_desc: [
		"§7你已进入机械的时代。"
		"§7Craft a §eBasic Generator§7 to produce your first EU."
		"§8提示：可以使用线缆将电力传输到附近的机器。"
	]
	quest.0000002000A003A2.quest_subtitle: "§7让机器来做苦差事吧。"
	quest.0000002000A003A2.title: "§6自动化火花"
	quest.0000002000A004A2.quest_desc: [
		"§7使用你的新动力源来制作一个§dGrinder§7。"
		"§7能将矿石产量翻倍，并加快材料处理速度。"
	]
	quest.0000002000A004A2.quest_subtitle: "§7利用力量，推动进步。"
	quest.0000002000A004A2.title: "§d第一台机器"
	quest.0000002000A005A2.quest_desc: [
		"§7发电机如果不储存电力，就会浪费能量。"
		"§7Craft a §bBatBox§7 to store excess EU and feed it to machines efficiently."
	]
	quest.0000002000A005A2.quest_subtitle: "§7能量需要有个去处才行。"
	quest.0000002000A005A2.title: "§bBetter Power Storage"
	quest.0000002000A006A2.quest_desc: [
		"§7你已经自动化了资源采集、冶炼和发电。"
		"§7你的工厂活过来了——而这仅仅是个开始。"
	]
	quest.0000002000A006A2.quest_subtitle: "§7从鹅卵石到洋流。"
	quest.0000002000A006A2.title: "§a里程碑：自动化成功实现"
	quest.0000002000A007A2.quest_desc: [
		"§7Craft a §6Grinder§7 to process ores and stone into §fdusts§7."
		"§7产量更高，挖矿次数更少。"
	]
	quest.0000002000A007A2.quest_subtitle: "§7石头变成了尘埃。"
	quest.0000002000A007A2.title: "§6Grinder Online"
	quest.0000002000A008A2.quest_desc: [
		"§7Build an §fElectric Furnace§7 — faster, cleaner, powered by EU."
		"§7磨粉机的完美搭档。"
	]
	quest.0000002000A008A2.quest_subtitle: "§7高效精炼。"
	quest.0000002000A008A2.title: "§f电动熔炉"
	quest.0000002000A009A2.quest_desc: [
		"§7连接§e发电机§7 → §b电缆§7 → §6研磨机§7 → §f电炉§7。"
		"§7投入石头/矿石，让系统为你工作。"
	]
	quest.0000002000A009A2.quest_subtitle: "§7你的第一条自动化生产线。"
	quest.0000002000A009A2.title: "§a动力循环器"
	quest.0000002000A010A2.quest_desc: [
		"§7The line runs, the storage fills, the chunk lives."
		"§7你建造了一个箱式工厂。"
	]
	quest.0000002000A010A2.quest_subtitle: "§7石头、尘埃和金属——无限循环。"
	quest.0000002000A010A2.title: "§d里程碑：自动化成功实现"
	quest.0000003000A001A3.quest_desc: [
		"§7你已经掌握了基础机器，但真正的工业才刚刚开始。"
		"§7效率、存储和更智能的生产——这些是你的新目标。"
	]
	quest.0000003000A001A3.quest_subtitle: "§7你的工厂正在扩张中。"
	quest.0000003000A001A3.title: "§6工业梦想"
	quest.0000003000A002A3.quest_desc: [
		"§7燃料驱动的动力可行，但并非永远高效。"
		"§7Craft a §eSolar Panel§7 or §eThermal Generator§7 to boost your EU generation."
	]
	quest.0000003000A002A3.quest_subtitle: "§7升级你的能量输出。"
	quest.0000003000A002A3.title: "§e高级电力系统 (Advanced Power)"
	quest.0000003000A003A3.quest_desc: [
		"§7你的小§dBatBox§7可应付不来现代工业。"
		"§7升级到§dMFE§7——更大容量，更快传输。"
	]
	quest.0000003000A003A3.quest_subtitle: "§7多存一点，少丢一点。"
	quest.0000003000A003A3.title: "§d能量升级"
	quest.0000003000A004A3.quest_desc: [
		"§7Repetitive crafting slows progress."
		"§7§bAssembler§7可以自动生产机器零件和电路。"
		"§7机器越多，可能性就越多。"
	]
	quest.0000003000A004A3.quest_subtitle: "§7建造你的第一个装配器。"
	quest.0000003000A004A3.title: "§b自动化扩展模组"
	quest.0000003000A005A3.quest_desc: [
		"§7§6Industrial Grinder§7 能以更高的产量精炼矿石。"
		"§7Pair it with §bWater§7 cells for best efficiency."
		"§7更智能的处理意味着更少的资源浪费。"
	]
	quest.0000003000A005A3.quest_subtitle: "§7精准带来效率。"
	quest.0000003000A005A3.title: "§6工业研磨机"
	quest.0000003000A006A3.quest_desc: [
		"§7Feed dusts from your Grinder directly into the §fElectric Furnace§7."
		"§7用漏斗或管道将它们连接起来，实现连续工作流程。"
	]
	quest.0000003000A006A3.quest_subtitle: "§7自动熔炼粉尘。"
	quest.0000003000A006A3.title: "§f精炼输出"
	quest.0000003000A007A3.quest_desc: [
		"§7自动化带来了杂乱无章。"
		"§7制作更优质的存储方案，或用管道连接容器。"
		"§7干净的基地是高效的基地。"
	]
	quest.0000003000A007A3.quest_subtitle: "§7组织你不断壮大的帝国。"
	quest.0000003000A007A3.title: "§e储物扩展模组"
	quest.0000003000A008A3.quest_desc: [
		"§7是时候自动移动物品了。"
		"§7Use §aClassic Pipes§7 to connect your machines and chests."
		"§7你建造了一座真正的工厂。"
	]
	quest.0000003000A008A3.quest_subtitle: "§7自动化物品运输。"
	quest.0000003000A008A3.title: "§a管道网络"
	quest.0000003000A009A3.quest_desc: [
		"§7基础工具无法驱动未来。"
		"§7Craft a few §bAdvanced Circuits§7 for upgrades and new machines."
	]
	quest.0000003000A009A3.quest_subtitle: "§7制作高级组件。"
	quest.0000003000A009A3.title: "§b电路元件"
	quest.0000003000A010A3.quest_desc: [
		"§7你建造了一条紧凑高效的流水线。"
		"§7自动化、存储、能源——一切融会贯通。"
		"§7从这里开始，只剩下扩张了。"
	]
	quest.0000003000A010A3.quest_subtitle: "§7单个区块内的工厂。"
	quest.0000003000A010A3.title: "§d里程碑：工业崛起"
	quest.0000004000A001A4.quest_desc: [
		"§7你的机器日夜轰鸣运转。"
		"§7但现在你的基地被物品淹没了。"
		""
		"§7是时候将秩序带回混乱之中了。"
	]
	quest.0000004000A001A4.quest_subtitle: "§7开始进行存储管理。"
	quest.0000004000A001A4.title: "§b有组织的混乱"
	quest.0000004000A002A4.quest_desc: [
		"§7普通的箱子可撑不了多久了。"
		"§7升级到§aSophisticated Chest§7以扩大容量并添加过滤器。"
	]
	quest.0000004000A002A4.quest_subtitle: "§7保持整洁。"
	quest.0000004000A002A4.title: "§a高级存储系统 (Advanced Storage)"
	quest.0000004000A003A4.quest_desc: [
		"§7Connect machines, furnaces and chests using §aClassic Pipes§7."
		"§7物品现在会移动到你想让它们去的地方。"
	]
	quest.0000004000A003A4.quest_subtitle: "§7管道是工厂的血管。"
	quest.0000004000A003A4.title: "§e物品路由系统"
	quest.0000004000A004A4.quest_desc: [
		"§7添加§6过滤器§7、§6提取器§7和红石逻辑以管理复杂的线路。"
		"§7一点布线，化混乱为和谐。"
	]
	quest.0000004000A004A4.quest_subtitle: "§7掌控水流的方向。"
	quest.0000004000A004A4.title: "§6排序逻辑"
	quest.0000004000A005A4.quest_desc: [
		"§7流体不过是另一种物品罢了。"
		"§7Set up §bFluid Pipes§7 to transport water, lava, or coolant where it’s needed."
	]
	quest.0000004000A005A4.quest_subtitle: "§7像专业人士一样管理液体。"
	quest.0000004000A005A4.title: "§d流体控制"
	quest.0000004000A006A4.quest_desc: [
		"§7每件物品都有其归属，每台机器都有其用途。"
		"§7你已掌握流畅与高效——你的区块现已成为一个生态系统。"
	]
	quest.0000004000A006A4.quest_subtitle: "§7Your base runs like clockwork."
	quest.0000004000A006A4.title: "§a物流任务完成"
	quest.0000005000A001A5.quest_desc: [
		"§7机器嗡嗡作响，但寂静愈发凝重。"
		"§7添加花朵、灯光或装饰品，让你的区块充满生机。"
	]
	quest.0000005000A001A5.quest_subtitle: "§7为墙壁带来温暖。"
	quest.0000005000A001A5.title: "§a小生命的故事"
	quest.0000005000A002A5.quest_desc: [
		"§7Craft a §eJukebox§7 and play a record."
		"§7中世纪的音乐让自动化听起来都那么高贵。"
	]
	quest.0000005000A002A5.quest_subtitle: "§7让音乐充满空气。"
	quest.0000005000A002A5.title: "§e进步之歌谣"
	quest.0000005000A003A5.quest_desc: [
		"§7驯服或繁殖一些中立生物——牛、猪或羊。"
		"§7它们为你的机械世界带来生机与慰藉。"
	]
	quest.0000005000A003A5.quest_subtitle: "§7与友善的生物们和平共处。"
	quest.0000005000A003A5.title: "§b动物伙伴模组"
	quest.0000005000A004A5.quest_desc: [
		"§7是时候再次突破障碍了。"
		"§7收集足够的资源以解锁一个新的§b区块§7。"
		"§7自由在生长，一块一块地成长。"
	]
	quest.0000005000A004A5.quest_subtitle: "§7解锁一个新的区块。"
	quest.0000005000A004A5.title: "§d已授予扩展权限"
	quest.0000005000A005A5.quest_desc: [
		"§7你并不孤单。"
		"§7无论是朋友还是回声——去探索未知的远方。"
	]
	quest.0000005000A005A5.quest_subtitle: "§7去拜访邻居的区块吧。"
	quest.0000005000A005A5.title: "§6社区"
	quest.0000006000A001A6.quest_desc: [
		"§7你已抵达终点——至少，暂时是如此。"
		"§7更多冒险、机器和谜团即将到来。"
		""
		"§7感谢您游玩 §5ChunkBound§7。"
		"§8– 创作者：§dxYaku"
	]
	quest.0000006000A001A6.quest_subtitle: "§7旅程才刚刚开始。"
	quest.0000006000A001A6.title: "§d庆祝蛋糕"
	quest.0276B3F6627DFE62.quest_subtitle: "&7建立你的基地。"
	quest.0276B3F6627DFE62.title: "&6成长的基石"
	quest.030DA5FC2D66810C.quest_subtitle: "收集你的第一批材料。"
	quest.030DA5FC2D66810C.title: "&6第一步：初学指南"
	quest.031EFFCDECFD6F91.quest_desc: ["你醒来发现自己被困在一个单独的区块里。一切都被无形的墙壁所阻隔。"]
	quest.05D69E23EA3C0DCF.quest_subtitle: "&7存活5个完整白天"
	quest.05D69E23EA3C0DCF.title: "&e幸存者 II"
	quest.07A9C4EEDF39DB8A.title: "&6&lThe Grass is Always Chunkier"
	quest.07DB127B22EF7E6F.quest_subtitle: "&7杀死你的第一个生物"
	quest.07DB127B22EF7E6F.title: "&c第一滴血"
	quest.093BD1F7B2F766FE.title: "&c怪物猎人"
	quest.0A9ECC4391942578.quest_desc: [
		"&7保持锻造炉活跃一段时间，并囤积核心合金。"
		"&8▸ &7准备&6燃料缓冲器&7，设置&b管道过滤器&7，保持输入流动。"
		"&e原因：&7运转的锻造炉能让后续所有机器更便宜、更快。"
	]
	quest.0A9ECC4391942578.quest_subtitle: "§7让你的熔炉持续运行一整天。"
	quest.0A9ECC4391942578.title: "§b难以应付的高温环境"
	quest.0B135B90A83EA713.quest_subtitle: "&7建造一个下界传送门并进入下界"
	quest.0B135B90A83EA713.title: "&b进阶：下界"
	quest.0BABB38B50FD6774.quest_desc: [
		"&6&lPotted Farms 是什么？&r"
		"该系统让你能用漏斗、斧头和盆栽树苗建造一个&a自动树木农场&r。"
		"无需手动砍伐树木。"
		""
		"&6&l建造方法&r"
		""
		"&71. 放置两个或以上相互连接的漏斗。&r"
		"它们必须指向一个 &achest&r 才能收集掉落物。"
		""
		"&72. 将物品展示框放置在一个漏斗的顶部。&r"
		""
		"&73. 将一把斧头放入物品展示框中。&r"
		"斧的类型决定了采集速度。"
		""
		"&74. 在同一装置中，将装有树苗的花盆放置在另一个漏斗的上方。&r"
		""
		"如果建造正确，农场会自动激活。"
		""
		"&6&l运作方式&r"
		""
		"框架中的斧头会自动“收割”盆栽植物。"
		"• 掉落物会进入相连的漏斗，然后进入箱子。"
		"• 树苗会一直种植着，并持续产出资源。"
		""
		"斧头在采集时会&c消耗耐久度&r。"
		"它&a不会损坏&r——当耐久度降到1时，它会掉进漏斗里保存起来。"
		"{@pagebreak}"
		"&6&l斧头速度（冷却时间）&r"
		""
		"不同的斧头工作效率不同："
		""
		"&7木制斧头 – 30秒"
		"石斧 – 25秒"
		"铁斧 – 20秒"
		"钻石斧 – 15秒"
		"下界合金斧 – 10秒"
		"黄金斧头 – 5秒&r"
		""
		"金斧头是最快的。"
		""
		"&6&l附魔&r"
		""
		"• &aUnbreaking&r 能让斧头更耐用。"
		"• &a修补&r可以完全防止耐久度损耗。"
		"• &a丝绸之触&r会改变某些掉落物（例如：掉落树叶而非树苗，特定菌类的行为）。"
		"{@pagebreak}"
		"&6&l特殊情况&r"
		""
		"某些农场&a不会降低耐久度&r："
		"• 竹子"
		"• 仙人掌"
		"• 枯萎的灌木"
		""
		"额外机制："
		"• 深色橡木有小概率掉落苹果。"
		"• 蘑菇有一定概率只掉落一个蘑菇。"
		"• 丛林树木可以产出可可豆和藤蔓。"
		"• 红树林可以生成树根、苔藓地毯和藤蔓。"
		"• 绯红菌可能会生成垂藤。"
		"• 扭曲菌可能会产生蘑菇灯。"
		"{@pagebreak}"
		"&6&l支持的植物&r"
		""
		"• 橡木树苗"
		"• 桦树苗"
		"• 云杉树苗"
		"• 丛林树苗"
		"• 金合欢树苗"
		"• 深色橡木树苗"
		"• 樱花树苗"
		"• 苍白橡木树苗"
		"• 红树繁殖体"
		"• 杜鹃花 / 开花杜鹃花"
		"• 竹子"
		"• 仙人掌"
		"• 枯萎的灌木"
		"• 棕色蘑菇"
		"• 红色蘑菇"
		"• 绯红菌丝"
		"• 扭曲的菌类 (Warped Fungus)"
	]
