			y: -0.5d
		}
		{
			dependencies: ["03315D67020057FC"]
			description: ["悬赏板是赚钱的好方法。附近有需要的人会在上面发布请求。作为回报，我能得到金钱和物品奖励。这是轻松赚钱购买更好装备或物品的好方法。"]
			id: "35007B8521D9F88F"
