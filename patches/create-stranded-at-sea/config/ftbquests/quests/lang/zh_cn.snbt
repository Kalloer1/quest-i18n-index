	quest.340A6433590D720E.quest_subtitle: "将矿石块加工成资源，或者用它们来建造。"
	quest.345EEBD0D6C065D6.quest_subtitle: "鸡蛋生成器"
	quest.34A2716D6F2B3173.quest_subtitle: "当火焰种子爆炸时，获得加速效果。"
	quest.34DAAF880FC0F5BB.title: "油炸甜甜圈卷（Deepfry Churros）"
	quest.34F41AB8E12A5912.quest_subtitle: "用两个完整的苹果和一些糖酿造而成，苹果酒能为饮用者提供一分钟的吸收 I 效果。"
	quest.3517C243A2449D54.quest_desc: [
		"&a这是一个简单的示例，展示如何操作：&r"
		"{image:kubejs:textures/ftb/123.png width:175 height:100 align:center}"
	]
	quest.3517C243A2449D54.quest_subtitle: "你需要通过储罐顶部施加旋转动力，才能开始向储罐中填充氧气。"
	quest.358A97626A5A19F4.quest_desc: ["生物农场是一款强大的工具，专为高效地从Minecraft的动物和生物中获取战利品而设计。此模组提供了多种独特的捕捉物品，并支持其他模组的捕捉物品，使其适用于所有类型的生物养殖！"]
	quest.358A97626A5A19F4.quest_subtitle: "Tier 2：处理速度更快，产出更多"
	quest.359CB2B676A04CC8.quest_desc: [""]
	quest.359CB2B676A04CC8.quest_subtitle: "重型：施法距离更短。"
	quest.35A54BE03F95E5F6.quest_desc: [
		"连接到 Stock Ticker 或 Stock Link 后，它会提供一个 Stockkeeper 界面，让玩家无需直接访问 Stockkeeper 即可随时请求物品。"
		""
		"主要特点："
		"通过 Stockkeeper 接口远程请求物品"
		"与JEI同步的搜索功能"
		"请求界面内支持配方合成"
		"分类同步：若与带分类的股票行情板链接，分类将被复制到便携式股票行情板"
	]
	quest.35A54BE03F95E5F6.quest_subtitle: "便携式股票行情显示器是一款手持设备，可与创造模组网络集成，允许玩家远程请求包裹。"
	quest.362762A00C3B79BC.quest_desc: ["使用&6硬币&r，可以增加你的&2强制加载区块&r上限。"]
	quest.362762A00C3B79BC.quest_subtitle: "使用金币加载更多强制加载区块"
	quest.3629C12A001D2E88.quest_subtitle: "简单模式"
	quest.365B9A4E4D6C83A0.quest_desc: ["可在主世界深层地下，一个类似繁茂洞穴的区域中找到。"]
	quest.366678B319B422C0.quest_desc: ["应用升级而不更改过滤设置将拾取所有物品并将其放入背包中。"]
	quest.366678B319B422C0.quest_subtitle: "允许将物品从地面拾起并直接储存在背包中。"
	quest.367D1A20BE7A93B6.quest_subtitle: "包装器用于创建纸板包裹。"
	quest.36B3A1A2527CE9C9.quest_desc: ["木筏是本整合包提供的多种交通工具之一。小心别把脚伸进水里，鲨鱼无处不在。"]
	quest.36B3A1A2527CE9C9.quest_subtitle: "你发现自己有足够的资源来建造一艘木筏，可以乘它远航大海，更快地收集资源。"
	quest.36C74022837215C7.title: "解锁后可进行制作"
	quest.36D07B8A6C3994E3.quest_subtitle: "击中时有几率吸取低于 X% HP 的目标生命，并赋予持有者部分吸收效果。"
	quest.3742A8E0846B3D80.quest_subtitle: "顺序齿轮可更精细地控制旋转功率，允许在一段时间内多次改变旋转。"
	quest.37766F5E2A6A2EF0.quest_desc: ["&b玫瑰金粉尘&r是一种用于制作&6玫瑰金锭&r的物品。它可以用&a3个原始金和1个原始铜&r来制作。"]
	quest.3784751033F27A1D.quest_subtitle: "击中时有几率提高你的攻击速度，最多可叠加15次。"
	quest.37C3920FF05D7BD5.quest_desc: [
		"背包使用方法："
		""
		"可以将其握在主手并右键点击以访问"
		""
		"在背包GUI的右侧，玩家物品栏格子上方，点击“装备”按钮即可装备"
		""
		"装备后按一个键（默认 B）即可访问"
		"Curios 兼容性使得背包只能通过放置在“背部”栏位来装备"
		""
		"可作为方块放置于世界中，通过漏斗/管道存取物品"
		""
		"装备后显示在玩家的背部"
	]
	quest.37C3920FF05D7BD5.quest_subtitle: "升级在锻造台进行：皮革 + 背包 + 等级升级物品"
	quest.37F2213B50CA5112.quest_subtitle: "机械活塞是一种在旋转动力驱动下可以推动机械装置的活塞。"
	quest.383A01D2BC20DD8B.quest_subtitle: "困难模式"
	quest.3859E70B2D4B3007.quest_desc: ["原油是你物流和自动化流程的生命线。"]
	quest.385C156051820A7B.quest_subtitle: "储存压缩空气，供潜水头盔使用。"
	quest.386BB0A6D8D16F8D.quest_subtitle: "用于在刻印器中创建计算处理器。"
	quest.387DB91D6613CBA5.quest_subtitle: "此处的动物当然可以在任何可生成的海洋方块上随机生成"
	quest.3887DB2CA518BC26.quest_subtitle: "建造装置时很有用的方块。"
	quest.3891A3647BF0ED01.quest_desc: [
		"如何召唤死亡使者："
		""
		"{image:kubejs:textures/ftb/grim.png width:200 height:100 align:center}"
	]
	quest.38B5B041457DF427.quest_subtitle: "将矿石块加工成资源，或者用它们来建造。"
	quest.38C85553E4F6EAA9.quest_subtitle: "用完成任务获得的硬币，从制图师那里购买一个下界钥匙"
	quest.38C85553E4F6EAA9.title: "获取物品：下界钥匙 (Nether Key)"
	quest.390CA48CD622B19F.title: "油炸一份小吃"
	quest.392A957B73679053.quest_subtitle: "Supplementaries 在这个整合包里 :3"
	quest.392A957B73679053.title: "补充物品"
	quest.392F87A742A71963.quest_subtitle: "当你濒临死亡时，你将被赋予再生蜡，使你完全恢复生命值并获得一段时间的抗性。"
	quest.39314828D2F9F866.quest_desc: ["不同的石头生成方式在自动化某些矿石时可能非常有用。"]
	quest.39E865F0D72CF9B8.quest_subtitle: "转轴是另一种基础但重要的机械部件，用于使物体旋转运动。你还可以延长转轴，使其影响多个需要旋转的装置。"
	quest.39E865F0D72CF9B8.title: "恒定旋转之杖"
	quest.3A5D9D55B33406DB.quest_subtitle: "用剪刀剪羊毛，掉落羊毛"
	quest.3A861B21F4724A9A.quest_subtitle: "在柴油发动机上使用可使其加速。创建柴油发电机"
	quest.3A95793467582862.quest_subtitle: "肌肉驱动的直升机。用力一推，它就能飞起来！"
	quest.3B10D31EFD80798C.quest_subtitle: "让你可以创建自己专属的定制功能性时钟。"
	quest.3B3A5F622515E0AE.quest_desc: [
		"&a合成配方：&r"
		"富饶的土壤无法直接合成。要制作它，你必须先合成有机堆肥，并将其放置在世界中，让它随时间分解。"
		""
		"有机堆肥在阳光和附近水分的湿润下会更容易分解，但它并不会像农田那样真正被灌溉。你也可以在它周围放置激活器来加速分解，范围是以它为中心的3x3x3区域。"
		""
		"目前，以下方块可作为有机堆肥的激活器使用："
		"棕色和红色蘑菇，以及它们的菌落；"
		"Podzol 和 Mycelium；"
		"其他有机堆肥方块；"
		"富饶的土壤，普通或已翻耕的。"
		""
		"&a用法：&r"
		"当任何可生长的植物被放置在富饶土壤上时，其生长速度会随机加快，类似于骨粉的效果。"
		""
		"富饶土壤可通过锄头翻耕为富饶农田。富饶农田免疫生物践踏，且不会分解为甜瓜或南瓜，但需要浇水以提高作物产量。"
		""
		"在富含腐殖质的土壤中种植蘑菇，并在足够黑暗的环境下，它们最终会形成蘑菇群。这些蘑菇群会随时间生长出2到5个蘑菇盖，收获时会掉落。"
	]
	quest.3B3A5F622515E0AE.quest_subtitle: "富饶土壤是一种改良型泥土，更加肥沃，也更耐环境侵蚀。"
	quest.3B3D233C09DD43D8.quest_subtitle: "使用加热混合器和盆子混合液体，以创造随机生成的液体"
	quest.3B3D233C09DD43D8.title: "液态经验值"
	quest.3B4760BCF20D0ECF.quest_desc: [
		"找到一个通风口；通风口可以在海底的任何地方或水面上找到。"
		""
		"把通风口里的方块挖空，直到找到一个像通风口矿石但上面有岩浆的方块，那就是休眠的矿石。"
	]
	quest.3B4760BCF20D0ECF.quest_subtitle: "用任何方法引爆休眠的矿石块"
	quest.3B925864D243F779.quest_subtitle: "允许装置收割作物的方块。"
	quest.3BAEAD0EF9EB0E94.title: "解锁后可进行制作"
	quest.3BBB794E177FF135.quest_desc: [
		"&l自定义交易：&r&o&2"
		""
		"&a第1级：&r"
		"minecraft:(任意染料颜色) x4"
		"minecraft:shears x1"
		""
		"&a第2级：&r"
		"minecraft:(任意羊毛颜色) x1"
		""
		"&a第3级：&r"
		"minecraft:(any carpet color) x3"
		""
		"&a第4级：&r"
		"minecraft:(any bed color) x1"
		""
		"&a第5级：&r"
		"minecraft:sheep_spawn_egg x1"
	]
	quest.3BBB794E177FF135.quest_subtitle: "查看描述以了解自定义交易内容"
	quest.3C03E968EFB3A488.title: "解锁后可进行制作"
	quest.3C1CAF0BD309141B.quest_subtitle: "钟表轴承是机械轴承的进阶版，可根据当前游戏时间旋转最多两根钟表的指针。"
	quest.3C1E7E02FDDFF8E3.quest_subtitle: "如果你了解 Create 的物品仓库和过滤器，那么这与它们类似。"
	quest.3C4F8BF1CEA4C2C1.title: "&eCraft: &fTeir 2 Rocket"
	quest.3C5D66A408381928.title: "岩浆"
	quest.3D11842DDDE1D396.quest_subtitle: "术语表：\\n\\n压力单位(SU)：描述某物产生或运行所需压力的数值。"
	quest.3D11842DDDE1D396.title: "我好紧张！我需要测量一下！"
	quest.3D550CD9EEE29E6F.quest_subtitle: "中等级处理器。"
	quest.3D5BF7E05FE7FF71.quest_subtitle: "红石是制造处理器时的一个组件。"
	quest.3D697750A70B0C6D.quest_subtitle: "无线库存管理员 :3"
	quest.3D6A771583B33400.title: "使用 Compressor 来加工材料"
	quest.3D7CE4017B17425B.quest_desc: ["将岩浆（最好用自动化方法）倒在活动的熔岩口上，看着岩浆变成相应的矿石。"]
	quest.3D7CE4017B17425B.quest_subtitle: "注意，休眠的熔岩口现在变为活跃熔岩口，可以看到里面的岩浆变得更亮了"
	quest.3DA659956B952FCD.quest_subtitle: "阈值开关可以测量物品栏的满度，并在可调阈值下发出红石信号。"
	quest.3DB72F218AD621E3.quest_subtitle: "是夜之巫妖（Night Lich）首领的掉落物"
	quest.3DE38636656DD1F6.quest_subtitle: "好，我可能有点夸张了，但红石在Create里也很重要，这里的方块能让红石装置更紧凑但也更复杂，研究愉快。"
	quest.3DE38636656DD1F6.title: "红石 + 创造 = 复杂"
	quest.3E557E40851B2733.quest_subtitle: "潜水护腿补充了 Create 现有的潜水装备，让你在水下获得超级跳跃能力。"
	quest.3E8B5D7DA59D53FE.quest_subtitle: "你的攻击会为目标附加元素能量，造成持续伤害和元素特异性负面效果。"
	quest.3EA146FC9DD9D538.title: "&e获取：&f龙之蛋"
	quest.3EA74448977CBB08.quest_desc: ["用于创造无限手套的六颗无限宝石之一。"]
	quest.3EA74448977CBB08.title: "现实之石"
	quest.3EADB5F22FAD4A56.quest_subtitle: "安山岩隧道的升级，允许更灵活地配置物品处理方式。"
	quest.3EC5CD672F47541F.quest_desc: ["收集雨水使其可以直接饮用，无需净化"]
	quest.3ED8AE02BEE7E919.quest_subtitle: "由凋灵掉落"
	quest.3F1469243ECCE270.quest_subtitle: "Powered Latch 会发出红石信号，可以开启或关闭。"
	quest.3F20E1456C92F278.quest_subtitle: "制作一个熔炉盆和熔炉顶"
	quest.3F20E1456C92F278.title: "改良型冲天炉"
	quest.3FBE90A351E6EE9F.title: "岩浆"
	quest.3FE5F763AE19D9DB.quest_subtitle: "不同鱼竿之间的唯一区别在于耐久度不同。"
	quest.3FE6E4446EFC249C.quest_subtitle: "在红色蘑菇上施加诅咒以获得此物品"
	quest.3FF259132A86D74A.title: "岩浆"
	quest.4007D36163F8555E.quest_subtitle: "将所有东西都磨成粉末。"
	quest.402CCCC50B86CFC3.quest_desc: ["铜制背罐可为玩家提供氧气，使其能潜入深海。该物品必须与潜水头盔搭配使用才能生效。"]
	quest.402CCCC50B86CFC3.quest_subtitle: "这样我就能获得氧气来源，从而能够冒险到海底，也能进入矿井探险了。"
	quest.405521ABB6867AB3.quest_desc: ["使用&6硬币&r，可以增加你的&2可领取区块&r上限。"]
	quest.405521ABB6867AB3.quest_subtitle: "用金币占领更多区块 (Claiming More Chunks with Coins)"
	quest.408C34432E394C2B.quest_subtitle: "延长线缆，但它传输的不是电力，本质上是一种物品线缆。"
	quest.408D9361AF8AA499.quest_subtitle: "一台潜力巨大的简易机器。既能放置方块，也能在方块/实体上使用物品。"
	quest.4098698A9A1E1583.quest_subtitle: "为自己制作一个背包，以获得更大的物品栏。"
	quest.40C52CDABB5E3FCF.quest_desc: ["它会砸碎地面，投掷冰块，并用冰冻拳减缓玩家的移动速度。"]
	quest.40C52CDABB5E3FCF.quest_subtitle: "雪怪会出现在冰冻的洞穴中"
	quest.40CD822FF86C7DF0.quest_desc: ["使用&6硬币&r，可以增加你的&2可领取区块&r上限。"]
	quest.40CD822FF86C7DF0.quest_subtitle: "用金币占领更多区块 (Claiming More Chunks with Coins)"
	quest.410BEC9893112A43.quest_subtitle: "齿轮可用于提高转速或延长装置，具体取决于它们的朝向。尝试调整齿轮的大小，看看能做出什么来。"
	quest.410BEC9893112A43.title: "齿轮组件"
	quest.413851654DCD65D3.quest_subtitle: "获取任何非脏污的矿物粉尘"
	quest.413851654DCD65D3.title: "高效的工厂！"
	quest.41E350FDE4D674C8.quest_subtitle: "滑道可以将物品垂直运输，类似于机械传送带。"
	quest.4206216A5F414642.quest_subtitle: "借助干海带的力量，机械传送带可用于直线或对角线移动物品。确保两端各安装一个转轴以连接，这样它才能正常工作。"
	quest.4206216A5F414642.title: "物品操控 (Item Manipulation)"
	quest.4230AD68B84A6FBE.quest_subtitle: "非常适合建造，也就这些了。"
	quest.4234EABAC1AA2AE0.quest_subtitle: "Depot 被用作机械臂等机器的交互点。"
	quest.426053EA0CD60DFD.quest_desc: ["在其中一个楼层上可以找到四个雕纹石祭坛。每个祭坛都需要一个灵魂之星才能激活。一旦填满，夜巫将会生成；如果尚未是夜晚，则当前白天将转为夜晚。"]
	quest.4267B97B18413E1D.quest_subtitle: "由于大多数 Create 方块不允许手动提取和插入液体，这些管道相当有用。\\n\\n也可以用来通过从一个有两个源方块相邻的源方块中提取来创造无限水。"
	quest.42791E51884C3101.quest_desc: ["用于定位石油矿床的工具。它基于区块工作，建议同时按下 F3 和 G 键以启用区块边界，方便导航。"]
	quest.42791E51884C3101.quest_subtitle: "默认情况下，世界中的每个区块都可能含有石油，其数量由程序生成并结合生物群系影响决定。"
	quest.42A4FAD05869BF4A.quest_subtitle: "硅可以通过熔炼 Certus Quartz Dust 来制作。它与 Inscriber 和 Inscriber Silicon Press 一起用于创建 Printed Silicon。"
	quest.42B2D0539D6E5197.quest_subtitle: "击中时有几率重置能力冷却时间。"
	quest.42CE924B047FF8A6.quest_subtitle: "获取一个熔炉搅拌机 (Foundry Mixer)"
	quest.42CE924B047FF8A6.title: "你让我团团转！"
	quest.42FD3D93E5DC001F.quest_desc: ["使用&6硬币&r，可以增加你的&2强制加载区块&r上限。"]
	quest.42FD3D93E5DC001F.quest_subtitle: "使用金币加载更多强制加载区块"
	quest.4329D355F5B2E80D.quest_subtitle: "与刻印机和刻印工程板配合使用，可制作出印刷工程电路。"
	quest.4338041FE1D902A8.quest_subtitle: "可通过合成进行升级"
	quest.4363F5A8705C5B13.title: "使用离心机处理材料"
	quest.4377B43142216C8D.quest_subtitle: "一种头盔，让你能用已装备的氧气瓶在水下呼吸。"
	quest.4386D4784A8C3AEE.quest_desc: ["用于许多专属配方，例如传奇之剑、无限魔杖、信标和生命法杖的制造。"]
	quest.438ACCE0D9FC0BF3.quest_subtitle: "速度慢，耗油量大，但可以携带整个储物空间。"
	quest.43AE1B7CFA4D921A.quest_subtitle: "请思考我存在的意义"
	quest.43B8DF9D60CD36D3.quest_subtitle: "由精炼光辉和暗影钢结合而成"
	quest.43EC52E38BD016C6.quest_subtitle: "非常困难"
	quest.43F8CC0E72EE20EE.quest_subtitle: "出现在金星地下稀有的结构中"
	quest.44281086C49D9939.quest_desc: ["使用&6硬币&r，可以增加你的&2可领取区块&r上限。"]
	quest.44281086C49D9939.quest_subtitle: "用金币占领更多区块 (Claiming More Chunks with Coins)"
	quest.449B628E728640B7.quest_subtitle: "阻止所有肉类掉落物生成"
	quest.44A89246738B67CA.quest_desc: ["恭喜你解锁了地狱！现在你可以获得烈焰燃烧器、灰烬面粉、烈焰棒等关键物品，这对许多 Create 模组和其他复杂自定义配方都至关重要。"]
	quest.44AE17D3427B487C.quest_subtitle: "“更华丽的绳索滑轮”\\n\\n可用于制作电梯。"
	quest.44C3B2628015505C.quest_subtitle: "利用旋转力实现结构的线性移动。"
	quest.44C3B2628015505C.title: "机械活塞"
	quest.44C7B7DD15CD7A49.quest_desc: [
		"主要特点："
		"使用物品生成生物后出现"
		"蜜蜂港口发送包裹所必需的物品"
		"将包裹直接送达给玩家或在蜜蜂港口之间运输"
	]
	quest.44C7B7DD15CD7A49.quest_subtitle: "Robo Bee 是一种将 Create 模组包送达目的地的实体。它会追踪包裹上的地址，按需直接送达给玩家或在蜂群端口之间传递。"
	quest.44DA9519A195BC65.quest_desc: [
		"概述："
		"蘑菇群要生长，必须在富饶的泥土上种植红色或棕色蘑菇，且环境足够黑暗（光照等级12或以下）。一段时间后，单个蘑菇就会变成一片菌落。"
		""
		"菌落会随时间生长出2到5个蘑菇，但它们无法从种植土壤的肥沃土壤中受益。使用任何工具都可以打破菌落以收获所有已生长的菌盖，或使用剪刀将其作为完整物品采集。"
		""
		"用剪刀对准殖民地时，也可以剪掉单个菌盖，并始终留下两个菌盖。"
		""
		"用法："
		"蘑菇群系除了用于种植外，大多只是装饰。它们不会超出所需条件而生长，玩家可通过移动后修剪来种植任意阶段的蘑菇。"
		""
		"棕色蘑菇群是烹饪南瓜馅饼的必要材料。"
	]
	quest.44DA9519A195BC65.quest_subtitle: "蘑菇群落是成簇的、经过施肥的蘑菇生长体，整体更易于种植。"
	quest.44E0DDEE0578557F.quest_subtitle: "一个无法手动访问的多方块物品存储装置。"
	quest.44F403DA4E4D56E3.quest_subtitle: "将矿石块加工成资源，或者用它们来建造。"
	quest.44FC080A04EF3970.quest_subtitle: "从钨矿中获取一个钨锭"
	quest.44FC080A04EF3970.title: "钨合金时代"
	quest.45026D6FEB75188F.quest_subtitle: "用糖和4个西瓜片制作，饮用西瓜汁可立即恢复1颗心（2 HP）。"
	quest.4525478B99097F3A.quest_subtitle: "铁和钻石：有一定几率不消耗耐久度。"
	quest.45C290237C14B192.quest_subtitle: "阻止所有花朵掉落物生成"
	quest.4613F6388966DB43.quest_subtitle: "欢迎来到 Create Enchantment Industry，这是一个为 Create 提供更多经验和附魔处理工具与方法的模组。"
	quest.4613F6388966DB43.title: "附魔工业 Enchantment Industry"
	quest.4643027ADBC0C97B.quest_desc: ["可用于为柴油发电机提供燃料。"]
	quest.4693A83688C92D55.quest_desc: ["&bMinecraft Comes Alive (MCA)&r 是一款极大地&6扩展村民功能&r的 Minecraft 模组，&a增加了互动、婚姻、子女遗传等功能！&r"]
	quest.4693A83688C92D55.title: "MCA Reborn"
	quest.469D2AC3C48360B3.quest_subtitle: "当红石信号输入时，轨道组装器可将装置附加到经过的矿车上。"
	quest.471682642A192714.quest_subtitle: "大多数太空相关组件都极其重要的材料"
	quest.473F1FE5E99F477F.quest_desc: ["应用升级而不更改过滤设置将不会丢弃任何物品。向过滤槽中添加物品，以便通过拾取升级或漏斗将其丢弃。"]
	quest.473F1FE5E99F477F.quest_subtitle: "提供一个用于手动删除物品的垃圾栏，并通过拾取升级或漏斗过滤器在物品进入背包时自动将其丢弃。"
	quest.477C91235EB7A5EA.quest_subtitle: "希望你穿着宇航服，并且有氧气储备"
	quest.477C91235EB7A5EA.title: "&e访问：&7Moon（月亮）"
	quest.4795979571F1FAEA.quest_subtitle: "一种改良熔炉，可生成AE能量而非冶炼矿石。放置在ME网络中可为能量电池充电或为其他网络设备供电。振动室可燃烧几乎所有固体燃料以产生能量。燃烧速度取决于其储存能量与浪费能量的比例。根据燃烧速度，每秒可产生1至10AE能量。"
	quest.4795979571F1FAEA.title: "为您的网络供电 2"
	quest.47C04B47623D5002.quest_desc: [
		"Ever wanted to build a transportation network in Minecraft similar to ones in Satisfactory? Create: Hypertubes is an addon for the Create mod, inspired by Satisfactory Hypertubes, allowing you to construct intricate and seamless tube systems for moving players and entities with ease. Hypertubes offer a new way to travel in your Minecraft world."
		""
		"凭借直观的建筑系统，你可以设计出优雅有趣的、带有很多弯道的超管，也可以建造长长的、高效的直管来为你的物流网络提供动力！可能性无穷无尽。"
		""
		"旅行中："
		"跳进一个Hypertube入口，然后被抛向世界的另一端"
		""
		"放置管道："
		"组件设计可无缝融入你的现有 Create 进度，让你轻松搭建并运行 Hypertube 网络。运行网络非常简单：只需齿轮为 Hypertube 入口供电即可"
		""
		"超管入口模式："
		"你可以用扳手修改Hypertube入口，来选择你喜欢的模式！"
		"如果使用自动锁定模式，可以潜行来避免被吸入管道"
		""
		"鱼和村民："
		"在 0.2.0 版本中，鱼和村民现在可以通过管道移动了！"
		"只需开启自动锁定模式，看着它们离开即可 :)"
		""
		"新增外观自定义功能："
		"你只需要用扳手就能自定义管道连接！"
		"（这只是自定义里程碑的第一步，任何建议或帮助都欢迎！）"
	]
	quest.47C04B47623D5002.quest_subtitle: "让你可以轻松建造无缝管道系统来移动玩家和实体。"
	quest.47C04B47623D5002.title: "超巨型管道"
	quest.47E42CDD36F87955.quest_subtitle: "与三叉戟类似，但伤害较低。"
	quest.47EFAFDA1838AAD1.quest_desc: ["非常适合酿造药水，可以帮助玩家调配力量药水等，实现火药、红石和萤石等物品的自动化。"]
	quest.48E5D56C47DF6642.quest_subtitle: "你的火车所行驶的那种东西。"
	quest.48E5D56C47DF6642.title: "铁路轨道"
	quest.4918B0939E4604A0.quest_subtitle: "像电脑一样，一次性查看并访问你整个物品栏中的所有文件。"
	quest.4918B0939E4604A0.title: "终端机"
	quest.491EAE2957E15C5F.quest_desc: [
		"他从太阳汲取力量，召唤出日击、太阳耀斑和巨大的太阳光束。他还能用面具创造出乌姆武塔纳追随者——包括名为乌姆武塔纳鹤的治疗者——在战斗中保护自己。因此，戴面具的孩子们将他奉若神明。未装备护具的旅人应远离他的林间空地，以免被他的日魔法所伤。"
		""
		"然而，能够直面并击败他的人，将得到他的面具——Sol Visage。佩戴此面具者可以赋予其他面具生命，创造出Umvuthana的追随者。不幸的是，面具并未赋予佩戴者heliomancy的力量；这种力量是Umvuthi与生俱来的，因此会随着他的死亡而消失。或许还有别的办法……？"
	]
	quest.491EAE2957E15C5F.quest_subtitle: "Umvuthi 是 Abavuthana 的创造者，居住在火星广袤平原上王座上的固定座椅中"
	quest.493D7F76B7833B01.quest_desc: ["配方：任意比目鱼 + 鸡蛋 + 洋葱 + 任意卷心菜"]
	quest.493D7F76B7833B01.quest_subtitle: "提供饱腹感（Nourishment）"
	quest.4962DD7F3E4D2AAD.title: "岩浆"
	quest.496EFFCD484E1DD7.quest_subtitle: "请思考我存在的意义"
	quest.496FC8106904193E.quest_subtitle: "柴油发电机是产生动能的一种紧凑型方式。"
	quest.498B46B890735B82.quest_subtitle: "使用传送石在世界中四处传送。使用返回卷轴返回最近的传送石。"
	quest.49901AE0CD7E39EF.title: "制作混凝土模板 (Craft Concrete Formwork)"
	quest.49A353B20F687751.title: "制作一套潜水服"
	quest.49EE6F88CD93352E.quest_subtitle: "放置在密封风扇前，可以让它吹走物品。"
	quest.4A041E600B41F4C3.quest_subtitle: "与刻印器和刻印计算板配合使用，可创建印刷计算电路。"
	quest.4A141C0CF1C29A52.quest_subtitle: "获取一个海洋之心"
	quest.4A40A08DD2ED4A69.quest_desc: [
		"脱水速度取决于生物群系，即炎热或干旱的生物群系更容易口渴，而寒冷或湿润的生物群系则不然。补水比温度更重要，因此建议在湿润的生物群系建造基地，而非寒冷的生物群系。"
		"该系统兼容 Cold Sweat，若该模组在整合包中，将使用其更精确的温度计算。"
		""
		"水瓶的堆叠大小已增至64，以适配Farmer's Delight中的食物。"
		"农夫的喜悦、休憩、酿造与咀嚼模组中添加的所有解渴食物均已默认集成，使茶（或酒）成为后期最佳的水分补充来源。"
		""
		"该模组兼容 Apple Skin，若模组存在会显示“quenched”覆盖层，并为所有能解渴的物品显示工具提示"
	]
	quest.4A40A08DD2ED4A69.quest_subtitle: "水有4种不同的纯净度等级，取决于采集地点"
