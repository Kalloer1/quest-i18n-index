		"minecraft:turtle_helmet x1"
	]
	quest.0E4DCCA957919634.quest_subtitle: "查看描述以了解自定义交易内容"
	quest.0EDC1CB91ADAC3DB.quest_subtitle: "与刻印器和刻印逻辑板配合使用，可创建印刷逻辑电路。"
	quest.0F09193BFD731128.quest_subtitle: "困难模式"
	quest.0F34A64AB5336D4E.quest_desc: ["&bHeadstones&r are a category consisting of 5 items that are mainly used in a graveyard for &aburying/keeping dead villagers in to be revived&r later with a &6Staff of Life&r or &6Scythe&r."]
	quest.0F34A64AB5336D4E.title: "墓碑"
	quest.0F35AF004588B678.quest_subtitle: "火车运行的轨道。没有轨道，就没有火车。"
	quest.0F35AF004588B678.title: "铁路轨道"
	quest.0F4D90B6F179C6C5.quest_desc: [
		"内置了创造模式火车支持："
		"{image:kubejs:textures/ftb/nexus.png width:200 height:150 align:center}"
		"允许穿越至 Nexus。每个传送门核心都有自己的坐标比例。在 Nexus 中移动的距离会乘以该比例，离开维度时生效。你可以在砧上使用它，为放置的传送门命名。你也可以手持另一个方块，用此方块伪装成该方块。"
	]
	quest.0F4D90B6F179C6C5.quest_subtitle: "坐标比例：64x"
	quest.0F557594B68FDA80.quest_desc: [
		"&b生命法杖&r是一种用于&6复活村民&r的物品。要复活村民，你&a必须手持法杖并右键点击该村民的&r墓碑。"
		"注意：此物品在损坏前只能使用&a5次&r。"
	]
	quest.0F8E8DC3D0291D76.quest_subtitle: "一种可染色的浮漂，可以像皮革盔甲一样染色。"
	quest.0F9CC22264DF80E8.quest_subtitle: "通电后，会像红石中继器一样，将红石脉冲延长指定时间。可通过长按右键进入其值设置界面进行调整，可将信号延长2刻到60分钟。设置也可通过剪贴板复制到其他延长器或脉冲中继器上。"
	quest.0FB4FFD361C5DF69.quest_subtitle: "这只是个座位，不多不少。但如果你在移动的装置上，不妨把它粘在装置上，这样你就能坐着一起移动了。可别把自己和座位粘在一起。"
	quest.0FB4FFD361C5DF69.title: "座位"
	quest.0FBB5A02F560CAB9.quest_subtitle: "模拟杠杆用于发出可变的信号。"
	quest.0FC7A3A0AE391782.quest_desc: ["前往屋顶。在那里，你会发现黑曜石祭坛。加入末影之眼后，外观像巨石般的奥布西迪利斯就会生成。"]
	quest.0FCB25BA5EB5E745.quest_subtitle: "将单个矿车连接在一起，使它们作为一个整体移动"
	quest.0FDDADFAB8BDD0CE.quest_subtitle: "击败下界手套后，可在宝箱中找到"
	quest.0FE0FD5B603DC91C.quest_subtitle: "在这里你可以找到所有开启 Ae2 体验所需的物品"
	quest.0FE0FD5B603DC91C.title: "&e定位：&d月亮地牢"
	quest.0FF159F5802886EB.quest_subtitle: "由位于枢纽维度的地狱火龙首领掉落"
	quest.0FF39255BD5908AD.title: "粉碎下界疣以获得香料"
	quest.10331210B10CF626.quest_subtitle: "让你能用SU来破坏方块，也可以装在装置上，用来挖掘隧道等。"
	quest.10340A31F8CA7447.quest_desc: ["运作时，它会捕捉遇到的鱼和其他生物（可在模组设置中配置），收集附近的物品，并根据不同生物群系自动生成钓鱼战利品（如丛林特有掉落物），模拟传统钓鱼奖励。"]
	quest.10340A31F8CA7447.quest_subtitle: "专为机械装置设计，可在移动机械装置中实现自动化"
	quest.105DF76C41B29756.quest_desc: [
		"背包使用方法："
		""
		"可以将其握在主手并右键点击以访问"
		""
		"在背包GUI的右侧，玩家物品栏格子上方，点击“装备”按钮即可装备"
		""
		"装备后按一个键（默认 B）即可访问"
		"Curios 兼容性使得背包只能通过放置在“背部”栏位来装备"
		""
		"可作为方块放置于世界中，通过漏斗/管道存取物品"
		""
		"装备后显示在玩家的背部"
	]
	quest.105DF76C41B29756.quest_subtitle: "升级在锻造台进行：皮革 + 背包 + 等级升级物品"
	quest.105F6F541CFC8E79.quest_desc: ["制作一个用来装水的餐盒 canteen"]
	quest.105F6F541CFC8E79.title: "获取一个食堂 (Obtaining a Canteen)"
	quest.10622C9E74C50A95.quest_subtitle: "座位可用于让多个实体乘坐机械装置。座位有各种染料的颜色。它们的功能与船类似，玩家和生物都可以乘坐"
	quest.108C812E61C72D03.quest_desc: ["使用&6硬币&r，可以增加你的&2可领取区块&r上限。"]
	quest.108C812E61C72D03.quest_subtitle: "使用金币占领更多区块"
	quest.10D06C1ACF7BAC8B.quest_subtitle: "点击以定位最近的小型游艇"
	quest.10D06C1ACF7BAC8B.title: "结构指南针"
	quest.10F1FE4B7907DF37.quest_subtitle: "智能观察者是一种机器，其发出的红石信号取决于其前方容器中方块或物品的状态。"
	quest.111B98CC64D59F49.quest_desc: [
		"流体可以通过升级选项卡中的槽位添加，或者将流体容器悬停在光标上，然后点击所需的储罐。"
		""
		"药水可以储存在储罐中，保留其效果，并可通过软管在饮用模式下使用。"
		""
		"溅射和滞留药水也可以通过软管在泼洒模式下储存和使用，将其投掷到世界中。"
	]
	quest.111B98CC64D59F49.quest_subtitle: "将背包增强为带有两个流体储罐的背包。"
	quest.111BB023102A2221.quest_subtitle: "提高宝藏出现的概率"
	quest.111C3069CE77EFF2.quest_subtitle: "属性过滤器仅关注数据。过滤器可以允许具有任意所需属性的物品，或仅允许具有所有所需属性的物品，或拒绝具有所选属性中任意一个的物品。需要参考物品来显示和选择属性，但属性可以由多个物品添加。"
	quest.1154323AD49A03C1.quest_desc: [
		"&l自定义交易：&r&o&2"
		""
		"&a第1级：&r"
		"farmersdelight:flint_knife x1"
		"minecraft:porkchop x1"
		"minecraft:beef x1"
		""
		"&a第2级：&r"
		"farmersdelight:golden_knife x1"
		"minecraft:chicken x1"
		""
		"&a第3级：&r"
		"farmersdelight:iron_knife x1"
		"minecraft:mutton x1"
		""
		"&a第4级：&r"
		"farmersdelight:diamond_knife x1"
		"minecraft:rabbit x1"
		""
		"&a第5级：&r"
		"farmersdelight:netherite_knife x1"
		"minecraft:pig_spawn_egg x1"
	]
	quest.1154323AD49A03C1.quest_subtitle: "查看描述以了解自定义交易内容"
	quest.1207872FE999D748.quest_desc: ["不同的石头生成方式在自动化某些矿石时可能非常有用。"]
	quest.1209EAFCD7457303.quest_subtitle: "用于检查原油矿床。制造柴油发电机"
	quest.12160F41714A7752.quest_subtitle: "击中时有几率吸收对手的灵魂，使你加速，同时减缓并标记目标，使其走向死亡。"
	quest.124A1D0C95EF484F.quest_subtitle: "将矿石块加工成资源，或者用它们来建造。"
	quest.1255576156E26392.quest_subtitle: "将潜水服放入氧气填充器以充满氧气供应"
	quest.125F2098DF92FCF7.quest_subtitle: "将处理速度提升 6 次/秒，使农场运行得更快"
	quest.127C2E5316EFC59B.quest_desc: ["[空格] 起飞，[shift] 减速，按住 [r] 可跳伞"]
	quest.127C2E5316EFC59B.quest_subtitle: "铜与钢铸就的巨兽，专为征服天空而生！四座、可移动炮塔、6个武器挂载点，体型远超Minecraft物理引擎的想象。"
	quest.127C861ECF942F0E.quest_subtitle: "用于控制已组装的火箭"
	quest.1283AD09A6377D92.title: "获取炉渣（Slag）"
	quest.12844EA0EA8F31F5.quest_subtitle: "困难模式"
	quest.12913E20A87ABA1F.quest_subtitle: "允许玩家制造可以上下移动的装置。"
	quest.12962FC09F1ACBCF.quest_subtitle: "链式传送带用于运输纸板包裹。"
	quest.129E0E2085D16CB5.quest_subtitle: "每个等级都会增加更多存储、升级槽和工具槽"
	quest.12BF912F9B0EDB6F.quest_desc: ["&bRose Gold Engagement and Wedding Ring&r is an &6alternative to Engagement Ring&r and f&aunctionate the same way.&r"]
	quest.12C789BF2D021A55.quest_subtitle: "放置在密封风扇前，可以让它给物品添加烟雾效果。"
	quest.12CAEA99C1F2148D.quest_subtitle: "用于制造所有处理器。"
	quest.132E47D6B06815E4.quest_subtitle: "提升掉落物品的质量和稀有度（增加战利品运气）"
	quest.134B8D796C172E9D.quest_subtitle: "击中时有几率点燃敌人或自己。若生命值低，则改为获得再生效果。"
	quest.1353044D11EEAEAC.quest_desc: ["不同的石头生成方式在自动化某些矿石时可能非常有用。"]
	quest.1353044D11EEAEAC.title: "沉思石世代（Ponder Stone Generations）"
	quest.13963A510D529BD4.quest_desc: ["我们添加了数百种自定义配方和40多种自定义物品来增强&6自动化流程。&r通过整合像&eCreate、&r &eAE2、&r和众多&eCreate扩展包&r以及许多自定义物品，我们创造了一个富有挑战性且循序渐进的&6自动化树&r，其难度堪比&6Satisfactory。&r我们的目标是无缝融合所有模组，鼓励玩家自动化各种材料以完成自动化树。该系统提供了极具挑战性又富有回报的体验。"]
	quest.13963A510D529BD4.title: "&l&b自动化"
	quest.139DAA6E8CF4267A.quest_desc: [
		"在物品栏底部，你可能已经注意到一个搜索栏了。"
		""
		"这是&dJust Enough Items&r，即&dJEI&r的搜索栏。"
		""
		"例如，输入“Wood”后，屏幕右侧的&dJEI &r物品列表会显示所有名称中包含“Wood”的物品。"
		""
		"在搜索查询前加上 @ 可以显示特定模组的物品，例如 @Adorn"
		""
		"要将物品设为收藏，请在 &dJEI &r物品列表中悬停于该物品上，然后按 &bA &r。"
	]
	quest.139DAA6E8CF4267A.quest_subtitle: "请阅读我的描述！"
	quest.139DAA6E8CF4267A.title: "&bJust Enough Items (JEI)"
	quest.13A305D74F8C6CB9.quest_desc: ["将岩浆（最好用自动化方法）倒在活动的熔岩口上，看着岩浆变成相应的矿石。"]
	quest.13A305D74F8C6CB9.quest_subtitle: "注意，休眠的熔岩口现在变成了活跃的熔岩口，可以看到里面的岩浆变得更亮了"
	quest.13AA782C1F44BE0C.quest_desc: ["升级选项卡中的箭头决定了Shift点击时，合成物品会进入背包还是玩家的物品栏。"]
	quest.13AA782C1F44BE0C.quest_subtitle: "在背包中添加了一个合成网格。"
	quest.13D0C3A396600BC2.quest_subtitle: "一个能装下很多东西的矿车。"
	quest.13D4FF6929AE8D8F.quest_subtitle: "一种可以增加攻击距离的物品。"
	quest.13D6B112D6534D9D.quest_subtitle: "旋转速度控制器是一种机械组件，能让玩家精确控制旋转速度。"
	quest.145B60BAC740910A.quest_subtitle: "用于在刻印器中创造逻辑处理器。"
	quest.145E2B32BA7AE8C9.quest_subtitle: "非常适合沼泽生物，支持沼泽栖息的生物群系"
	quest.14797F087369911A.quest_desc: ["配方：水母 + 小麦 + 糖"]
	quest.14797F087369911A.quest_subtitle: "提供舒适感，但有2%的几率造成中毒。"
	quest.148049B3E665FEB6.quest_subtitle: "击中时有几率使持剑者着火，造成伤害的同时赋予力量。"
	quest.14863B37DF7D3E2A.quest_desc: ["使用&6硬币&r，可以增加你的&2可领取区块&r上限。"]
