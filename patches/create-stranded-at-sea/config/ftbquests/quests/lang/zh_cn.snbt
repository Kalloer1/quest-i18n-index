	quest.54C22E291A33C333.quest_desc: [
		"背包使用方法："
		""
		"可以将其握在主手并右键点击以访问"
		""
		"在背包GUI的右侧，玩家物品栏格子上方，点击“装备”按钮即可装备"
		""
		"装备后按一个键（默认 B）即可访问"
		"Curios 兼容性使得背包只能通过放置在“背部”槽位来装备"
		""
		"可作为方块放置于世界中，通过漏斗/管道存取物品"
		""
		"装备后显示在玩家的背部"
	]
	quest.54C22E291A33C333.quest_subtitle: "升级在锻造台进行：皮革 + 背包 + 等级升级物品"
	quest.5514A1B70A3F4519.quest_desc: ["&e《稀薄空气》引入了硬核空气机制&r，让你离世界&a海平面&r越远，就越&c难以呼吸&r。无论是探索&c洞穴&r还是&c攀登高峰&r，如果不带上&a足够的氧气&r，都&e会突然变得非常危险&r！更不要说去&e下界旅行&r了……"]
	quest.5514A1B70A3F4519.title: "稀薄空气"
	quest.55299ED6A70C17BF.quest_subtitle: "使用此物品可从沉浸式家具建造库中创建家具"
	quest.553C28959FC9DA28.quest_subtitle: "机械传动带是一种传递旋转、移动物品和实体的机械组件。"
	quest.55677B4C9BAA87C8.quest_subtitle: "需要使用铜制潜水头盔才能使用铜制背囊中的氧气供应"
