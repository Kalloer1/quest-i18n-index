	quest.1E9307F6621D7781.quest_subtitle: "专为平原生物设计的农场，非常适合畜牧生物"
	quest.1EBED2D32637D735.quest_subtitle: "极其困难"
	quest.1ECF4A353E90FD47.quest_desc: ["&6花束&r是一种可&6合成的物品&r，用于&6与村民建立关系&r。虽然玩家可以随时&b赠送&r它给&b村民&r，但需要与村民至少有&c10颗心&r，他们才会&a同意&r建立&5关系&r。"]
	quest.1ECF4A353E90FD47.quest_subtitle: "开启一段关系的绝佳礼物"
	quest.1EE8A9FD1DCEDEA5.quest_desc: [
		"仅接受该槽位中的音乐唱片。"
		"只有背着背包的玩家才能听到音乐，其他玩家听不到。"
	]
	quest.1EE8A9FD1DCEDEA5.quest_subtitle: "允许收听音乐。"
	quest.1F1E327828376540.quest_desc: ["&6Baby&r 是一种可以通过&d结婚&r &6获得的&r &6物品&r，不要与村民的婴儿生命阶段混淆。玩家也可以从&4邪教徒&r那里&6购买&r &aSirben 婴儿&r，除非玩家收养，否则不会被视为自己的孩子。"]
	quest.1F3C1EB02C8050CF.quest_desc: ["末影碎片可以通过完成所有任务线中的各种任务来获得。你也可以从邪教徒NPC那里购买。"]
