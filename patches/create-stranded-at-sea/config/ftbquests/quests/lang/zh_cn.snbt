	quest.6722A07C621C7046.quest_desc: ["在其中一个楼层上可以找到四个雕纹石祭坛。每个祭坛都需要一个灵魂之星才能激活。一旦填满，夜巫将会生成；如果尚未是夜晚，则当前白天将转为夜晚。"]
	quest.672C61B048CB3B85.quest_subtitle: "要制作火车，你至少需要：\\n- 1 个火车外壳\\n- 1 个火车站\\n- 足够铺设铁路的轨道。\\n\\n要了解如何组装火车，请“思考”火车站。"
	quest.67304835A05594BA.quest_subtitle: "启用生物掉落，仿佛被玩家杀死，给予玩家专属战利品！"
	quest.674685DC64D2E071.title: "建造一艘潜水艇"
	quest.6747B6E86137E39A.quest_desc: ["将岩浆（最好用自动化方法）倒在活动的熔岩口上，看着岩浆变成相应的矿石。"]
	quest.6747B6E86137E39A.quest_subtitle: "注意，休眠的熔岩口现在变成了活跃的熔岩口，可以看到里面的岩浆变得更亮了"
	quest.675FBD573A868A46.quest_subtitle: "从快捷栏中随机放置方块。"
	quest.6767FE64EBECEF31.quest_desc: ["可用于为柴油发电机提供燃料。"]
	quest.679470583E416814.quest_subtitle: "鹦鹉螺壳可以从石灰岩中获得"
	quest.679E271B2571CF1E.title: "&e合成： &fTier 1 火箭"
	quest.67B3D0A82F1BB3EA.quest_subtitle: "更高级方块的基础组成部分。"
	quest.67CE399D0A9C0F57.quest_subtitle: "既能自动合成常规配方，又能合成超出普通工作台限制的大型配方方块。"
	quest.67FA1292129370E6.quest_subtitle: "Sky Stone Blocks 是通过在熔炉中熔炼 Sky Stone 制作的。"
	quest.68056D30BF916A51.title: "解锁后可进行制作"
	quest.6814CD8420D6DA66.quest_subtitle: "没听错，伙计们，FE 在创造模式。你可能需要比普通水车更多的东西来驱动它。"
	quest.6814CD8420D6DA66.title: "FE 在创造模式里？"
	quest.682C130AFC93C598.quest_subtitle: "更简单的鹦鹉螺壳获取方式"
	quest.68417D4783084C6C.quest_subtitle: "可用来盛放油或其他液体"
	quest.684722FC95AE6D84.quest_desc: ["满足玩家的口渴需求"]
	quest.68487E90AA4A1FC5.quest_subtitle: "ME Chest是使用Storage Cell最简单的方式，它能让你直接访问放入其中的Cell内容。它可以单独用外部电源供电，也可以作为ME Network的一部分。在网络上时，该箱子的存储容量可通过分配的Channel供网络中任何其他设备访问。脱离网络使用时，该箱子不会一次性转移完整堆叠，每次最多只能转移38个物品。"
	quest.686528C6DC3955B0.quest_subtitle: "可在月亮地牢的宝箱中找到"
	quest.686528C6DC3955B0.title: "Certus Quartz"
	quest.687E120574E93C63.title: "获取硫酸铜，一种以铜为基础的肥料"
	quest.68C8062B08313C0C.quest_desc: ["&6将你的家人&r &a叫到你的位置。&r"]
	quest.68CC0DF64AD608C1.quest_subtitle: "比普通水车产生的SU多一倍，但转速较慢。"
	quest.68E7D3C6ADC9EED4.quest_subtitle: "结合了采矿、袭击结构、自动化、钓鱼、冒险和交易，你现在有能力获得游戏中所有需要的物品来推进进度！"
	quest.68F1A5C1DDF76B4F.quest_desc: ["不同的石头生成方式在自动化某些矿石时可能非常有用。"]
	quest.6933CF9259784296.title: "使用振动台来加工材料"
	quest.694D568E65C188C2.quest_subtitle: "拿些烈焰蛋糕，它会变得很热！"
	quest.694D568E65C188C2.title: "冶金学专家"
	quest.696DBF66C76DAE74.quest_desc: ["它们体型巨大、速度惊人，冰息更是威力无穷，是近乎无法战胜的对手。如果你在旅途中遇到一只正在睡觉的，最好另寻他路，让它安睡。这头巨兽守护着一颗珍贵的冰晶，挥舞时能释放出纯粹的冬日能量。"]
	quest.696DBF66C76DAE74.quest_subtitle: "霜狼是月球表面罕见发现的危险野兽"
	quest.6974F4C8971081E6.title: "捕获一条鲱鱼"
	quest.697F4D272E39F3A3.quest_subtitle: "可通过凋灵掉落的材料合成获得"
	quest.69914C7F77511BBE.quest_subtitle: "致命的击退效果"
	quest.69AA1F5FA1A4712C.quest_subtitle: "红石请求器用于向已连接的包装器请求纸板包裹。"
	quest.69B63A4148DE8030.quest_desc: [""]
	quest.69F7D402B8B996A9.quest_subtitle: "使用睡袋，但不要重置出生点"
	quest.6A0A0001B3574AE8.quest_subtitle: "为你的附魔实验获取一些液态经验值！"
	quest.6A0A0001B3574AE8.title: "实验性内容"
	quest.6A2C7AFDF7CCDC21.quest_desc: ["配方：番茄 + 卷心菜叶 + 鲶鱼或鲭鱼 + 木棍"]
	quest.6A2C7AFDF7CCDC21.quest_subtitle: "提供力量。"
	quest.6A4CB4700F0082C6.quest_desc: [
		"教程现已&a完成&r！"
		""
		"要查看其余任务，请将光标移至屏幕左侧并展开&6任务组&r。"
		""
		"如有任何其他问题，欢迎加入我们的 &bDiscord &r：https://lunapixel.studio/discord"
	]
	quest.6A4CB4700F0082C6.quest_subtitle: "请阅读我的描述！"
	quest.6A52090D6BC064D7.quest_desc: [
		"本教程将带你了解一些基本功能。别担心，不会花&o太&r久！"
		""
		"要开始，请点击“&9任务&r”下方的对勾，然后领取&6任务奖励&r。新的任务就会开始出现！"
		""
		"如果没有新任务出现，请尝试重新加入世界。教程结束前不要食用面包。"
	]
	quest.6A52090D6BC064D7.quest_subtitle: "要开始教程，请点击此任务并阅读描述。"
	quest.6A52090D6BC064D7.title: "&e欢迎来到 All of Create！"
	quest.6A58803620938D90.quest_desc: ["根据你所处的生物群系，末影人有不同的版本。获取任意一种珍珠即可制作死亡之眼。"]
	quest.6A58803620938D90.title: "&e获取：&f任意珍珠"
	quest.6A85255CCCDE764F.quest_subtitle: "穿过水流，用爆炸烹饪物品。"
	quest.6A9E2D535B206647.quest_subtitle: "非常简单"
	quest.6AA5455AAC85BB9A.quest_subtitle: "便携式电池和普通电池一样，但可以像背包一样打开（没有快捷键）。它们仍然需要能量，但在背包容量不足时，早期游戏阶段会很有用。"
	quest.6AAC04F1D0ECC1D5.quest_subtitle: "好，这个解释起来挺复杂的，简单来说，这个控制器会通过 GLFW 提供的布局来接收你的手柄输入。如果没有手柄，那就自己重新绑定按键吧。"
	quest.6AAC04F1D0ECC1D5.title: "MC 游戏手柄"
	quest.6AFD022E4050ECB5.quest_subtitle: "可将实时信息显示到已连接的显示屏或数码管上。"
	quest.6B071855A32D92E7.quest_subtitle: "通过掠夺桶和箱子获得铜，而玻璃则通过熔炼沙子获得"
	quest.6B071855A32D92E7.title: "&e收集：&r资源"
	quest.6B0D4CF1334B8E74.quest_desc: ["通过切割任意海龟获得。"]
	quest.6B0D4CF1334B8E74.quest_subtitle: "烹饪食材"
	quest.6B5D00440E177092.quest_subtitle: "复制你的附魔书、命名牌和列车时刻表。"
	quest.6B6985249AD92B24.quest_subtitle: "查找生物群系"
	quest.6B710F7916772C84.title: "&e访问：&bGlacio"
	quest.6B8010612AB0D9A2.quest_desc: ["使用Create模组时，农作物收割机是最容易制作的农场之一，并且有多种不同的制作方法。"]
	quest.6BA81EEC6176D279.quest_subtitle: "存储组件是你在AE2中建造的任何一个单元的基础。"
	quest.6BF9D8BF842B5EFE.quest_desc: ["用于创造无限手套的六颗无限宝石之一。"]
	quest.6BF9D8BF842B5EFE.title: "太空石"
	quest.6C26214738805896.quest_subtitle: "任何使用 Create 模组的人都离不开它。能让你看到更多关于方块的信息，比如应力冲击。"
	quest.6C4E0520777530A7.quest_desc: ["这可能是整个整合包里最重要的建筑之一，里面有许多对玩家成长至关重要的物品。"]
	quest.6C66239AB766D886.quest_subtitle: "防止生物在很大范围内生成。"
	quest.6CC8E975F5989512.quest_subtitle: "专为幸运掉落设计的农场，适合稀有物品生物"
	quest.6CD6BF0D17D1605E.quest_subtitle: "制作一个灯泡 (Craft a Light Bulb)"
	quest.6CD6BF0D17D1605E.title: "爱迪生会为此感到自豪的！"
	quest.6CE106D39BB8625D.quest_desc: [
		""
		"{image:kubejs:textures/ftb/ship1.png width:200 height:100 align:center}"
		"{image:kubejs:textures/ftb/ship.png width:200 height:100 align:center}"
	]
	quest.6CE106D39BB8625D.quest_subtitle: "这些船会随机出现在大海中（查看描述了解它们的外观）"
	quest.6CE106D39BB8625D.title: "定位：海盗船"
	quest.6CE47960B6FEF89D.quest_subtitle: "可用于放置或提取大量液体。"
	quest.6CF436D4831F590C.quest_subtitle: "由 Certus Quartz Crystal 或 Nether Quartz 制成的扳手。可用于旋转方块，并从电缆上移除单个部件。"
	quest.6CF436D4831F590C.title: "旋转你的机器 (Rotating Your Machines)"
	quest.6D17293BBEDF3958.quest_subtitle: "用于制作ME终端的一个组件。"
	quest.6DF613F5C4791BBB.quest_desc: [""]
	quest.6E023720A217D3FA.quest_desc: ["将种子放入盆中用压榨机压实，即可制作植物油。"]
	quest.6E10F1E23E94B534.quest_desc: ["不同的石头生成方式在自动化某些矿石时可能非常有用。"]
	quest.6E2C82E2740AFCD1.quest_subtitle: "获取任意石墨模具（Graphite Molds）"
	quest.6E2C82E2740AFCD1.title: "石墨模具"
	quest.6E4A143F451770B7.quest_desc: ["生物农场是一款强大的工具，专为高效地从Minecraft的动物和生物中获取战利品而设计。此模组提供了多种独特的捕捉物品，并支持其他模组的捕捉物品，使其适用于所有类型的生物养殖！"]
	quest.6E4A143F451770B7.quest_subtitle: "Tier 3：处理速度和掉落物产出最大化，是高效刷物的终极选择！"
	quest.6E6AB9BD459D984C.title: "岩浆"
	quest.6E91F43E25ACA092.quest_subtitle: "攻击被点燃的敌人会赋予你力量和速度。"
	quest.6E9298ACC5F4AB48.quest_subtitle: "可通过钓鱼在红树林宝箱中找到，或从1级农民处购买"
	quest.6EAF8E8C3EB2D1AF.quest_subtitle: "Gantry Carriage 是一种可以在 Gantry Shafts 上移动 Contraptions 的方块。"
	quest.6F0E390BDCD3D28D.quest_subtitle: "获得下界钥匙后，你就可以前往下界维度了"
	quest.6F0E390BDCD3D28D.title: "目的地：下界（The Nether）"
	quest.6F2EF24AD3808F94.title: "&a访问：&rMoon（月球）"
	quest.6F4B091DDC613408.quest_subtitle: "允许装置创造农田或发射实体的方块。"
	quest.6F65615577D6DBA2.title: "岩浆"
	quest.6F757081954C2909.quest_desc: [
		"脱水速度取决于生物群系，即炎热或干旱的生物群系更容易口渴，而寒冷或湿润的生物群系则不然。补水比温度更重要，因此建议在湿润的生物群系建造基地，而非寒冷的生物群系。"
		"该系统兼容 Cold Sweat，若该模组在整合包中，将使用其更精确的温度计算。"
		""
		"水瓶的堆叠大小已增至64，以适配Farmer's Delight中的食物。"
		"农夫的喜悦、休憩、酿造与咀嚼模组中添加的所有解渴食物均已默认集成，使茶（或酒）成为后期最佳的水分补充来源。"
		""
		"该模组兼容 Apple Skin，若模组存在会显示“quenched”覆盖层，并为所有能解渴的物品显示工具提示"
	]
	quest.6F757081954C2909.quest_subtitle: "沙滤器，可以通过管道输入的管道净化水。"
	quest.6F84997262C634F9.quest_subtitle: "前方方块被氧化时会发出红石信号"
	quest.6F97BAE04FEF130A.quest_desc: ["用这个来净化水，使其可以饮用"]
	quest.6FE1CBDF3A7515EC.quest_subtitle: "用于制作ME终端的一个组件。"
	quest.6FF57D1BD19E6391.quest_subtitle: "非常困难"
	quest.6FF8514C4EEB4D6B.quest_desc: [
		"找到一个通风口；通风口可以在海底的任何地方或水面上找到。"
		""
		"把通风口里的方块挖空，直到找到一个像通风口矿石块但上面有岩浆的方块，那就是休眠的矿石块。"
	]
	quest.6FF8514C4EEB4D6B.quest_subtitle: "用任何方法引爆休眠的矿石块"
	quest.7056D7A59892165A.quest_subtitle: "专注于平原怪物，包括常见的敌对生物"
	quest.7058172C67801D47.title: "&e访问：&c水星"
	quest.705CA0C680DC4969.quest_desc: [
		"&bMatchmakers Ring&r 是一种可以让你将&6任意两名村民配对成情侣&r的物品。将配对戒指送给村民，他们&a就会与最近的村民结婚。&r"
		"&f注意：需要两个Matchmakers Rings才能匹配村民&r"
	]
	quest.707A724441D8579A.quest_desc: [
		"要将物品添加到烤架上，只需在没有物体遮挡顶部时右键点击炉灶。炉灶能识别篝火配方进行烹饪，因此通常需要30秒才能完全准备好物品。炉灶无法通过物品传输方块（如漏斗）自动化，但与篝火一样，烹饪时无需燃料。"
		""
		"炉灶的烤架上可放置六 (6) 个物品，烹饪后的产物会轻柔地弹出，而不会四处飞溅。"
		""
		"如果炉灶烤架的中间被任何方块（如关闭的活板门或烹饪锅）阻挡，烤架上的所有食物都会被弹走，并且炉灶在障碍被移除前无法接收食材。"
		""
		"炉子可以用铲子或水桶扑灭，并用打火石和钢点燃。"
	]
	quest.707A724441D8579A.quest_subtitle: "炉灶是篝火烹饪功能的直接升级，也是烹饪锅的合适热源。"
	quest.7088750D467E771E.quest_subtitle: "允许对转速进行微调。"
	quest.709AE2AFF5DD47EF.title: "使用激光来加工材料"
	quest.70A45B51E9374A0D.quest_subtitle: "使用全新的形状进行建造。"
	quest.70A45B51E9374A0D.title: "带框方块"
	quest.70B5B9927EF2B4CF.quest_subtitle: "沙子可以在木箱和宝箱里找到，或者沿着岩浆气泡流到海底去获取沙子"
	quest.71151BB59F5C2307.quest_subtitle: "按 &c\"Z\"&r 查看使用方法"
	quest.71151BB59F5C2307.title: "寻找汽油"
	quest.711D41863F7700FA.quest_desc: [
		"此整合包中添加了大量自定义交易，让玩家可以获得在偏远岛屿上无法获取的所有物品。"
		""
		"&eLocate a Tidal Town out at Sea to find Villagers to trade with. "
		""
		"&c结构ID：joshie:village_ocean"
	]
	quest.711D41863F7700FA.title: "交易内容"
	quest.71723A16D3EC84B8.quest_subtitle: "用于将3份天文读数组合成一张星图"
	quest.7174016A48C16A94.quest_subtitle: "bonk"
	quest.71C06743EF3815FA.quest_subtitle: "可通过合成由太阳鸟 Umvuthi 掉落的材料制作"
	quest.71C5FCDAF01FFAB1.quest_desc: [
		"条件："
		"要烹饪食物，锅必须由下方的方块加热。加热时会显示沸腾的气泡、蒸汽和锅的界面上的篝火图标：如果出现火焰，则表示锅正在加热。"
		""
		"默认情况下有许多合适的热源，也可以通过 heat_sources 标签添加更多："
		"火与灵魂火、熔岩、岩浆块、篝火与灵魂篝火与、炉灶"
		""
		"烹饪："
		"烹饪锅的界面与合成台类似，但有几点不同。它有六个 (6) 槽位用于添加食材，和一个 (1) 槽位用于添加容器。准备好的食物会出现在锅形槽位中，直到插入合适的容器才会从锅中取出一份。如果准备好的食物没有容器，它将直接掉落至输出。"
		""
		"将光标悬停在容器上，即可查看餐食盛放的容器。"
		""
		"如果配料有容器（如牛奶瓶、番茄酱），配方烹饪完成后，容器会从锅的顶部弹出。配料容器会始终朝与木勺相反的方向抛出，可用漏斗、篮子等接住。"
		""
		"餐食平均需要10秒来准备，较简单的餐食（如熟米饭）则需要5秒。"
		""
		"漏斗和其他模组的类似方块可以通过烹饪锅传输物品："
		""
		"顶部：插入/提取材料；"
		"侧面：插入容器；"
		"底部：提取已输出的餐食（输入容器后）。"
		"食物储存系统"
		"需要容器的食物会储存在锅中，最多可堆叠64份，不受物品最大堆叠限制。锅可以被挖掘、携带和放置，所有食物都会保留在内部，类似于Shulker Box；但挖掘锅时，其他所有格子的物品都会掉落。这让玩家可以携带大量会占用过多背包空间的食物，例如Mushroom Stew。"
		""
		"玩家可以通过烹饪锅的界面添加容器，或用有效容器直接右键点击锅来取餐。"
	]
	quest.71C5FCDAF01FFAB1.quest_subtitle: "烹饪锅是一个可以准备和储存大量食物的工作站。"
	quest.71DEBC625D2BFC60.quest_desc: [
		"喂食给任何被驯服的狼（你自己的或其他玩家的）后，狗粮会使其完全恢复，并赋予以下正面效果："
		"速度 (5:00)"
		"力量 (5:00)"
		"抗性 (5:00)"
		""
		"这种组合能让狼更容易追上你或敏捷的对手，并且在战斗中能坚持更久。"
	]
	quest.71DEBC625D2BFC60.quest_subtitle: "会完全治愈一只狼，并赋予它们一个正面效果"
	quest.71F579B92296865A.quest_desc: ["不同的石头生成方式在自动化某些矿石时可能非常有用。"]
	quest.7212538DA32ACF63.quest_subtitle: "白天钓鱼速度加快"
	quest.721FAF784829D344.quest_subtitle: "收集一桶液态雌激素。"
	quest.721FAF784829D344.title: "（少女）力量的源泉"
	quest.721FF967D6D2AD62.quest_desc: [
		"部署者现在能受益于带有横扫之刃附魔的剑。"
		""
		"研究物品以获取更多信息"
	]
	quest.721FF967D6D2AD62.quest_subtitle: "Deployers 和 Crushing Wheels 的击杀会掉落经验块。"
	quest.721FF967D6D2AD62.title: "Deployer and Crushing Wheels Tweaks 调整包"
	quest.723F3D8DA188AD0F.quest_desc: [
		"通常由玩家在受控环境中任意位置召唤。"
		""
		"收集4个灵魂沙或灵魂土方块（可在下界中找到）。"
		""
		"获得3个凋零骷髅头（下界堡垒中的凋零骷髅的稀有掉落物）。"
		""
		"将灵魂沙/土壤摆成T形，并在顶部放置3个骷髅头以召唤凋零。"
	]
	quest.723F3D8DA188AD0F.quest_subtitle: "由玩家召唤的具有破坏能力的 boss，能够破坏方块并施加凋零效果。"
