		}
		{
			dependencies: ["7C3968AF39557751"]
			description: ["Apotheosis 添加了一种新的合成系统，可通过通常无用的弓箭台访问。该系统在制作箭矢时能获得更多产出，并且是合成某些专属箭矢所必需的。目前共有四种新箭矢：箭头箭、黑曜石箭、爆炸箭和采矿箭。"]
			id: "00588B2FDB99874D"
			rewards: [{
