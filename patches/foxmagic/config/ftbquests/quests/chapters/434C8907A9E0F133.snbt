	order_index: 0
	progression_mode: "flexible"
	quest_links: [ ]
	quests: [
		{
			description: [
				"Лишь однажды Избранный получает шанс встать на &5Путь бессмертия&r. Потеряв Кольцо Семи проклятий, он больше никогда не сможет встать на этот путь."
				"Кто решится надеть это кольцо, тот откроет для себя множество сильных, несравнимых артефактов, но у этого есть и обратная сторона. Носитель &5проклятого&r и &5необузданного&r кольца превращает свою жизнь в сущий ад."
			]
			icon: "enigmaticlegacy:cursed_ring"
			id: "5E48804C1DF4872D"
			rewards: [
				{
					id: "5C1CDD9DD128C453"
					item: "born_in_chaos_v1:mint_candy"
					team_reward: false
					type: "item"
				}
				{
					count: 9
					id: "18A201F71BB1E61C"
					item: "minecraft:golden_carrot"
					team_reward: false
					type: "item"
				}
			]
			shape: "hexagon"
			size: 1.5d
			subtitle: "&6Клянусь любить тебя в горе, ... в бедности, ... в болезни..."
			tasks: [{
				advancement: "enigmaticlegacy:main/cursed_ring"
				criterion: ""
				id: "46887DC5871EE9D3"
				type: "advancement"
			}]
			title: "7 个诅咒"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["5E48804C1DF4872D"]
			description: ["Неясно, был ли &9Древний страж&r первым порождением морских глубин, появившимся в Новом мире, но одно известно точно - никто не сравнится с его мощью и силой. Взгляд этого монстра пронзает до глубины души. Пока его сородичи ищут что поесть, &9древний страж&r наблюдает и изучает каждого, кто вторгается в его владения. Убийство столь сильного монстра дает возможность получить его &4сердце&r. Плата за использование &1Сердца стража&r очень велика, ему требуется энергия &5Кольца Семи проклятий&r."]
			hide_until_deps_complete: true
			id: "2461517A8E2ACDF8"
			rewards: [{
				id: "78FE32B868D9E3B9"
				item: {
					Count: 1
					ForgeCaps: {
						"celestisynth:celestisynthitemstackcapabilities": {
							cs.aquaSkin: 0
						}
					}
					id: "enigmaticlegacy:golden_ring"
				}
				team_reward: false
				type: "item"
			}]
			shape: "hexagon"
			subtitle: "Убить Древнего стража и получить Сердце стража"
			tasks: [
				{
					id: "50DA8DEF4F4DBD81"
					item: "enigmaticlegacy:guardian_heart"
					type: "item"
				}
				{
					advancement: "enigmaticlegacy:main/guardian_heart"
					criterion: ""
					id: "2491B2199F8CD9F3"
					type: "advancement"
				}
			]
			title: "活生生的心脏"
			x: -2.0d
			y: 0.0d
		}
		{
			dependencies: ["32B525B81CEBD20E"]
			description: [
				"Энергия сущности, вселяющая страх даже в самых опытных воинов, течет по его жилам. Доступ к &5Нечестивой сущности&r есть лишь у тех, кто принял &5семь проклятий&r. &0Иссушитель&r - это очень опасное чудовище, которое было проклято и теперь находится в заточении адских глубин."
				""
				"Во время великой битвы души погибших досаждавателей отправлялись в ад за свои преступления. Так образовался песок душ, что таит в себе нечестивую энергию, и лишь немногие способны завладеть ею."
				""
				"После победы над иссушителем, необходимо создать Разлом. Эта книга дарует знания, недоступные простым смертным."
			]
			hide_until_deps_complete: true
			id: "0868D35A7D7DB3B7"
			rewards: [
				{
					count: 5
					id: "7230109BBA1F46DE"
					item: "enigmaticlegacy:evil_essence"
					team_reward: false
					type: "item"
				}
				{
					id: "3E4FC5C92C2C8808"
					team_reward: false
					type: "xp"
					xp: 13
				}
			]
			shape: "hexagon"
			subtitle: "获取一个不祥的生物实体"
			tasks: [{
				id: "235956639DF6A54D"
				item: "enigmaticlegacy:evil_essence"
				type: "item"
			}]
			title: "暗黒エネルギー"
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["5E48804C1DF4872D"]
			description: ["В древние времена, когда земля была пуста и безжизненна, во многих уголках Нового мира появлялись первые артефакты, что служили зарождению жизни. &2Сердце земли&r стало одним из них. Силы этого предмета было достаточно, чтобы вдохнуть жизнь в еще мертвую планету. Но спустя тысячилетия эволюции и развития жизни, некоторые народы осквернили то, что даровало когда-то им жизнь. Так появилось &5Искаженное сердце&r."]
			hide_until_deps_complete: true
			id: "71E6BA317C444FE2"
			rewards: [
				{
					id: "6CB3BE5F53722613"
					item: "enigmaticlegacy:recall_potion"
					team_reward: false
					type: "item"
				}
				{
					id: "61AB119C401ADA61"
					team_reward: false
					type: "xp"
					xp: 13
				}
			]
			shape: "hexagon"
			subtitle: "Создать искаженное сердце"
			tasks: [{
				id: "5CD5339DD80385B5"
				item: "enigmaticlegacy:twisted_heart"
				type: "item"
			}]
			title: "被诅咒的心脏"
			x: 0.0d
			y: 2.0d
		}
		{
			dependencies: ["503F62351B494DFD"]
			description: ["&0Тёмная магия&r, запечатанная в &0тёмном свитке&r, жаждет освобождения. &5Древнее зло,&r копившееся веками, пытается сбросить оковы. Найдя этот свиток, владельцу стоит преобразовать его во что-то другое. Те, кто когда-либо находил эти свитки, были поглощены этой &5тёмной энергией&r. Некоторые считают, что это злобная магия увядания, но так ли это на самом деле?"]
			hide_until_deps_complete: true
			id: "0059A137D8D9F9BD"
			rewards: [{
				id: "2075887B1CA7FFBA"
				ignore_reward_blocking: true
				team_reward: false
				type: "xp"
				xp: 13
			}]
			subtitle: "Получить самый темный свиток"
			tasks: [{
				id: "7C6E72325131E2AB"
				item: "enigmaticlegacy:darkest_scroll"
				type: "item"
			}]
			title: "被诅咒的卷轴"
			x: 0.0d
			y: -4.0d
		}
		{
			dependencies: ["0868D35A7D7DB3B7"]
			description: [
				"Уникальный меч - &0Погибель Края&r, оставляющий после себя разрушения, был уничтонижен ради сохранения равновесия и баланса миров. Когда воины или исследователи попадали в измерение Энда, взяв с собой этот клинок, все сущности в страхе бежали в попытке спасти свою жизнь."
				""
				"Ни для кого не секрет, что те, кто носит &5Кольцо Семи проклятий&r, обладают силой видеть то, чего не видят другие. Так, убив &8Дракона Края&r и пробыв с кольцом достаточное количество времени, можно извлечь &0Сердце бездны&r. Этот артефакт содержит в себе саму пустоту, которая так необходима на &5Бессмертном пути&r."
