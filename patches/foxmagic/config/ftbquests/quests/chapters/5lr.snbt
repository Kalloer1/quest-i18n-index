	order_index: 1
	quest_links: [ ]
	quests: [
		{
			description: ["Твоя находка кажется случайной — перед тобой лежит потрепанный блокнот, полный странных заметок. Кажется, он станет твоим проводником в мире загадок и абсурдных идей. Но что за &fпятна&r покрывают его страницы?"]
			icon: "ars_nouveau:worn_notebook"
			icon_scale: 1.2d
			id: "0C0797F7984FEC9D"
			rewards: [{
				id: "05834DE2C38BA81C"
				item: "ars_nouveau:worn_notebook"
