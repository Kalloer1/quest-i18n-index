			}]
			title: "Таинства на потёртых страницах"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["0C0797F7984FEC9D"]
			description: ["Следуя странным указаниям из запыленного блокнота, ты сможешь создать свой первый гримуар. С виду — обычные материалы, но как только мана проникает в страницы, заклинания обретают гибкость и форму. Похоже, этот артефакт идеально подходит для экспериментов с магией, пусть пока и слабой."]
			hide_until_deps_complete: true
			id: "6E32D974A888594C"
			rewards: [
				{
					id: "0470DC34A74418ED"
