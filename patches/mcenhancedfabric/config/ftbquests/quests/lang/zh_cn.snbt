	quest.28A22554F4E45E1B.title: "击杀坚守者"
	quest.2927B1D3AAEC611E.title: "高度提升工作台 (Craft Table of Elevation)"
	quest.2A327302C58878C7.quest_desc: [""]
	quest.2A327302C58878C7.title: "&n&e&l寻找细胞迷宫&r&r&r"
	quest.2ABCAA00BCD0DB95.quest_desc: [""]
	quest.2ABCAA00BCD0DB95.quest_subtitle: "&a&l传送门框架由绽放方解石制成。要获得绽放方解石，可以将治愈药水右键点击方解石方块，或使用溅射/滞留药水在方解石方块上，每个药水可获得2个绽放方解石。传送门至少需要4x5个方块，用水桶右键点击框架即可点燃传送门。&r&r"
	quest.2ABCAA00BCD0DB95.title: "前往失落天堂 (Paradise Lost)"
	quest.2DB74AB54199D059.quest_desc: [
		"&l锻造炉的基本形状如下所示：&r"
		""
		"&lIt has a 3x3 bottom, and is shaped like a chimney. You can put more blocks around it, even covering the top. The glass is there to show the basic shape, it is not part of any default forges. Forge Controller&r"
		""
		"&l锻造控制器由锻造等级对应的材料制成，中间是一个高炉：&r"
		""
		"&l等级系统能让配方更难制作，或者让制作更高效。&r"
		""
		"&l砖块和石砖，用于制造 Tier 1 合金锻造炉。&r"
		""
		"&l深层岩和黑石，用于制造二级合金锻造炉。&r"
		""
		"&l用于Tier 2合金锻造炉的棱镜砖&r"
		""
		"&l抛光黑石，可用于制作 Tier 2 合金锻造炉&r"
		""
		"&l用于制作三阶合金锻造炉的末石&r。"
		""
		"&l用于Tier 3合金锻造炉的金刚石&r"
	]
	quest.2DB74AB54199D059.quest_subtitle: "&n&l燃料：&r&r &lMorkite、煤炭和煤炭块、木炭、烈焰棒、岩浆桶&r"
	quest.2DE5BC23596F3087.quest_desc: [""]
	quest.2DE5BC23596F3087.quest_subtitle: "&l找到新的地下结构：Moonshrine，并开启通往新维度的传送门&r"
	quest.303784051DF729A2.title: "四轴飞行器"
	quest.315063059D5FEE17.quest_desc: ["&l“据说，这颗眼睛让我们的祖先获得了红石的知识。”&r"]
	quest.315063059D5FEE17.quest_subtitle: "&2&l在丛林金字塔的箱子里发现（40%几率）。&r&r"
	quest.316F122EC283E5F1.quest_subtitle: "Craft backpack"
	quest.326B8B8EC7EE5914.quest_desc: [
		"&l物品过滤：&r"
		"&l短草-5秒&r"
		"&l纸-10秒&r"
		"&l砾石-20秒&r"
		"&l沙子（方块标签）-40秒&r"
		"&l木炭-80秒&r"
		"&l海晶碎片-160秒&r"
		"&lHearts of the Sea-320 seconds&r"
		""
		"&4&l(餐盒必须装满才能过滤！)&r&r"
	]
	quest.326B8B8EC7EE5914.quest_subtitle: "&l净水机是一种实用方块，用于过滤水壶和水瓶，是口渴系统的一部分。&r"
	quest.32A4275120B7F175.quest_desc: [
		"&5&l方块"
		"&l25 黑曜石&r"
		"&l9 哭泣的黑曜石&r"
		"&l8 末地之根&r"
		"&l1 龙之蛋&r&r&r"
	]
	quest.32A4275120B7F175.quest_subtitle: "&d&l玩家必须在末地任何地方建造该结构。当结构建成且末地之眼放置妥当后，仪式便会开始。末地之眼每分钟都会释放粒子，10分钟后便会生成&r&r"
	quest.33559A64F4BCD798.quest_desc: ["&l使用时，温度计会在检测低温和高温之间切换。&r"]
	quest.33559A64F4BCD798.quest_subtitle: "&l温度计是一种可以检测周围环境温度变化的实用方块。但它不包括方块本身产生的温度，只检测生物群系温度、时间、天气等。根据温度计检测到的温度是冷还是暖，以及当前的环境温度，它会产生红石信号。&r"
	quest.3413A0012FFC3080.title: "合成爆炸增幅器"
	quest.34798B575BD194DF.quest_desc: [
		"&b&l冷却燃料：&r&r"
		"&l冰&r"
		"&l压缩冰&r"
		"&l蓝色冰块&r"
		"&l微风之杖&r"
		"&l风之电荷&r"
		"&l雪球&r"
		"&l雪&r"
		"&l雪块&r"
		"&l粉末雪桶&r"
		"&l冰淇淋&r"
		"&4&l加热燃料：&r&r"
		"&l岩浆块&r"
		"&l岩浆奶油&r"
		"&l烈焰棒&r"
		"&l烈焰粉&r"
		"&l火药燃料&r"
		"&l煤炭&r"
		"&l煤炭块&r"
		"&l木炭&r"
		"&l岩浆桶&r"
		"&lCharc-O's&r"
	]
	quest.34798B575BD194DF.quest_subtitle: "&l恒温器是一种实用方块，可用于加热、冷却或中和大型封闭空间。它必须使用冷却或加热燃料来供能，这些燃料会随时间消耗。如果同时存在冷却和加热燃料，恒温器将使受影响的区域温度保持中立。&r"
	quest.34C281E016527D6E.quest_desc: [
		"&6&l一个很棒的指南针，右键点击蜂箱/蜂巢时，它会记录方块的位置！在Bumblezone维度中右键点击空气，它会指向最近的Cell迷宫结构。"
		""
		"&l&6右键点击可切换至另一种模式的追踪方式，即可在区块追踪模式和结构追踪模式之间切换。（若指南针有附魔光泽，则表示指南针已“锁定”，无法切换模式或定位其他结构）&r&r&r&r"
	]
	quest.34C281E016527D6E.quest_subtitle: "&6&lCrafted from 1 Compass, 1 Pollen Puff, 1 Honey Bucket, and 1 Honey Crystal Shard.&r&r"
	quest.34C281E016527D6E.title: "蜂蜜指南针"
	quest.36AD37FED8FBD71A.title: "杀死萨凡纳克里珀（Savannah Crepper）"
	quest.37503E637C7CE0D1.quest_desc: ["&l\"对逝者生前记忆的追忆。\"&r"]
	quest.37503E637C7CE0D1.quest_subtitle: "&f&lCrafted with 1 Phantom Membrane, 1 Bone, 1 Rotten Flesh, 1 Ghast Tear, and 1 Undead Soul (25% chance Skeleton Horse drop, unaffected by Looting or cause of death).&r&r"
	quest.377BEEFAB1A71456.title: "制作抑制法杖 Staff of Supression"
	quest.37A12F583FAAE1BE.quest_desc: [""]
	quest.37A12F583FAAE1BE.quest_subtitle: "&l首先，你需要制作火箭站，之后你就能制作火箭了&r"
	quest.382D15645689B577.quest_subtitle: "需要 Tier 2 锻造台"
	quest.3CD3870D730C5C2C.quest_desc: ["&lSmelting an IronIngot in any furnace will give you a Refined Iron , which are used in many of the recipes for machines and their component parts. You'll need a few of these to create your first parts and first machines. &r"]
	quest.3CFDCA5BD9DDA871.quest_desc: [
		"&6&l一面起初很弱，但随着你用蜂蜜水晶碎片修复它会变得更强，最终耐久度大约是原版盾牌的两倍！但要小心，用盾牌格挡火焰和爆炸伤害会使其迅速损坏！是的，火球和烟花也会严重损坏盾牌，所以请小心！&r&r"
		""
		"&e&l盾牌的制作配方如下，其中 # 代表蜂蜜水晶碎片："
		"# # #"
		"# # #"
		"#&r&r"
	]
	quest.3CFDCA5BD9DDA871.title: "蜂蜜盾牌"
	quest.3E2D8BC4C5934A7D.quest_desc: [
		"&l这些资源可以在月球上找到。&r"
		""
		"&l以前用于制作火箭升级部件&r"
	]
	quest.3E3A9F9044BC5A5E.quest_desc: ["&l“没有这颗眼睛，唤魔者就毫无力量。”&r"]
	quest.3E3A9F9044BC5A5E.quest_subtitle: "&9&l在林地府邸的箱子里有10%的几率找到，或由唤魔者有5%的几率掉落（不受抢夺或死亡原因影响）。&r&r"
	quest.3EF0826651517403.quest_desc: ["&l工业级冲击钻是 Tech Reborn 提供的顶级冲击钻物品。它具有 1M 的储能。可以使用储能方块，如电池箱 Battery Box 为其充电。冲击钻可替代镐，以钻石镐 4 倍的速度破坏石头类方块，如石头 Stone 或鹅卵石 Cobblestone。工业级冲击钻在激活状态下可进行 3×3 和 5×5 的区域挖掘。破坏一个方块需要消耗 150 能量。它具有铁矿挖掘等级，因此大多数矿石都可以用工业级冲击钻挖掘，但速度非常慢，不过区域挖掘会跳过非石头方块。 &r"]
	quest.3F27E9475CF2929A.quest_subtitle: "需要 Tier 2 锻造台"
	quest.40EBFBAF92597687.quest_desc: ["&l隐身装置放置在物品栏中时，可以使玩家隐身。它能储存高达40M的能量单位。不提供任何护甲值，因此无法提供额外保护。装置开启期间，你将对其他玩家和生物不可见，但若靠得太近，生物仍会发起攻击。使用成本为10E/刻（即200E/秒、12KE/分钟和720KE/小时）。其充放电速率为8192E/刻，这意味着如果使用可调式或跨维度SU，大约4分钟即可完全充放电。 &r"]
	quest.41C0C39169B57C92.quest_subtitle: "需要 Tier 2 锻造台"
	quest.42F35D5E45300601.quest_subtitle: "水源 (Water Source)"
	quest.42F35D5E45300601.title: "建造食堂"
	quest.43B659A36F5C1707.quest_desc: ["&l“它见证了毁灭。或许它也见证了你的物品消失。”&r"]
	quest.43B659A36F5C1707.quest_subtitle: "&7&l凋零掉落（90%概率，投掷两次，不受抢夺或死亡原因影响）。&r&r"
	quest.44DA345949C4E615.quest_desc: [""]
	quest.44DA345949C4E615.quest_subtitle: "&5&l虚空传送门是一个将玩家传送于末地与虚空维度之间的方块。击败末影之眼后，它会在浮空岛上生成。&r&r"
	quest.44EDC641A4DFEC72.quest_desc: [
		"&lA centrifuge will be needed to make process some resources and create components that will be needed for further progress.&r"
		""
		"&l两种机器都需要红石流（RF/FE）形式的能量，并且可以使用附加组件进行升级。&r"
	]
	quest.4516D639CAB6D048.title: "击杀蘑菇苦力怕"
	quest.46E80C3DB936A9E1.quest_desc: [""]
	quest.46E80C3DB936A9E1.quest_subtitle: "&l放置火箭需要 9 个火箭发射台 &r"
	quest.4927CD393798EDC6.quest_subtitle: "需要 Tier 2 锻造台"
	quest.4C43C081A3D64A56.quest_desc: [""]
	quest.4C43C081A3D64A56.quest_subtitle: "&2&l沼泽中发现。它们拥有邪恶的有毒魔法。&r&r"
	quest.4CB69E5303C61467.title: "击杀沼泽苦力怕"
	quest.4D0CC9954D067228.quest_desc: ["&lOmni-Tool 是一款通用工具，它将镐、斧、铲、剪刀甚至剑都集成在一根简单的棒中。它有 100 万能量存储。可以使用 Battery BoxBattery Box 为其充电。其挖掘等级与钻石工具相当。挖掘一个方块消耗 100 能量，攻击实体消耗 125 能量&r。"]
	quest.4D23DF0FA6AD6D92.title: "获取烈焰棒"
	quest.4D9573F718B242BE.quest_desc: [""]
	quest.4D9573F718B242BE.quest_subtitle: "&4&l烈焰人，但有盾牌。这是一个在 Mob Vote 中落败，却通过 AdventureZ 加入游戏的生物。它们很难杀死，靠得太近可能会爆炸攻击你。&r&r"
	quest.4DB5A054E77D35D7.quest_desc: ["&4&l水分离器和水泵都需要供电&r&r"]
	quest.4DB5A054E77D35D7.quest_subtitle: "&l要自动化抽水，你可以在水分离器旁边的水源上制作一个水泵。&r"
	quest.4DD62B17C756F1AC.quest_desc: [""]
	quest.4DD62B17C756F1AC.quest_subtitle: "获取原木日志"
	quest.4EF40BAD12359DB5.quest_desc: [
		"&6&lThey are rare throwable weapons found in Cell Maze structure or rarely in any Honey Cocoon block in various Bumblezone dungeons and structures."
		""
		"&l&6Can be crafted from 1 Bee Stinger and 2 Sticks in a line in any direction in Crafting Tablea&r&r&r&r"
	]
	quest.4F1239D4B308FFF7.quest_desc: ["&l用此物品右键点击方块，即可判断该区块中是否有石油。&r"]
	quest.4F1239D4B308FFF7.quest_subtitle: "&l要获得石油，你需要制作石油探测器。&r"
	quest.4F58FECA7890B759.quest_desc: [
		"&6&l将物品放在副手，可让附近的作物和树苗生长，将枯死的灌木变为随机树苗，治愈被你驯服的生物，以及与你同队的其他生物或玩家！还能治愈被治愈生物身上的中毒和凋零效果。也能治愈玩家自身的中毒和凋零效果。"
		"&r&r"
		"&6&l它在使用前可消耗1000次，并且需要10分钟才能通过被过去消耗过蜜蜂精华的玩家持有来重新充能。&r&r"
	]
	quest.4F58FECA7890B759.quest_subtitle: "&6&n&l只有在击败绿色永恒圣所的活动中才能获得的游戏后期物品&r&r&r"
	quest.4FDE3471CCBF39C4.quest_desc: ["&lAn assembler can craft some things (like wires, coils, and motors) more efficiently than you can, and it can craft some things that you are not able to craft.&r"]
	quest.516940D5144828B0.quest_desc: [
		"&6&l将物品放在副手可以高亮附近的生物和某些方块实体！让你能看清附近的怪物、隐藏的宝箱或可疑的方块！&r&r"
		""
		"&6&l它还会告诉你所在结构的名称！&r&r"
		""
		"&6&l它在使用前可消耗1200次，并且需要15分钟才能通过被过去消耗过蜜蜂精华的玩家持有来重新充能。&r&r"
	]
	quest.516940D5144828B0.quest_subtitle: "&6&n&l只有在击败紫色 Sempiternal Sanctum 的事件后才能获得的终局物品！&r&r&r"
	quest.52BEE01ED57862E8.title: "制作木制斧头"
	quest.5406BC32A8531E20.quest_subtitle: "&4&l黑暗的亡灵法师已将下界堡垒视为他们的巢穴。精通黑暗魔法的他们，能够召唤出威瑟傀儡，这是一种为保护亡灵法师免受潜在威胁而创造的强大实体。&r&r"
	quest.5406BC32A8531E20.title: "击杀枯萎的亡灵法师"
	quest.54C133A2550378E4.title: "杀死恶土苦力怕"
	quest.54DEE3234275C77E.quest_subtitle: "需要 Tier 1 锻造台"
	quest.5535208832D68CDD.title: "击杀 MoonBlesed Creeper"
	quest.55969C9CAF07C7EA.quest_desc: ["&l“它在Aether与Nether的战争中，被一个恶魔所夺走。”&r"]
	quest.55969C9CAF07C7EA.quest_subtitle: "&4&l在末地要塞的箱子里有30%的几率找到。&r&r"
	quest.55969C9CAF07C7EA.title: "下界之眼"
	quest.5598237CCCB05A0E.title: "合成 Warden 头盔"
	quest.5892C10560CC50D2.quest_desc: [
		"&l基础链锯是 Tech Reborn 中可获得的入门级链锯。&r"
		""
		"&l它有 10k 的储能。可以使用储能方块为其充电，例如 Battery BoxBattery Box 或其他能为带电物品充电的机器。充电速率为 128E\\t。&r"
		""
		"&l链锯可以替代铁斧，但如果在充能状态下，砍伐原木的速度会比铁斧快一点。破坏一个方块需要消耗50点能量。除了砍树，它还可以用于剥树皮、去除蜡和氧化物。就像原版斧头一样。&r"
	]
	quest.59335A93402AEC92.quest_subtitle: "&4&lThe Soul Reaper is a lethal variant of the wither skeleton. It possesses expert skills with both a bow and a sword, making it a formidable adversary capable of annihilating anything that stands in its path.&r&r"
	quest.59D3BDD7C609BD7B.quest_desc: [""]
	quest.59D3BDD7C609BD7B.quest_subtitle: "&6&l只有在击败红色永恒圣所的活动中才能获得的游戏后期物品！&r&r"
	quest.59F8C8393E523058.quest_desc: [
		"&l工业钻头是科技重生的最强钻头。它能在3×3区域内进行范围采矿。&r"
		""
		"&l它能储存 1,000,000 能量。可以使用 Battery BoxBattery Box 或其他能为带电物品充能的机器为其充电。充电速率为 8192 E\\t。&r"
		""
		"&l挖掘时间不取决于被破坏的方块数量。它仅针对目标方块计算。如果相邻方块的挖掘时间不超过目标方块用镐或铲子挖掘时间的10倍，钻头也会将其破坏。例如，如果你敲击SandSand，工业钻头会破坏相邻的StoneStone，但不会破坏ObsidianObsidian。&r"
		""
		"&l同时按住（潜行+右键）可激活3×3范围挖掘。工业钻头在非活动时将以常规的1×1模式挖掘。破坏一个方块需要消耗150能量。&r"
	]
	quest.5B2ACD45B7B36A1C.quest_desc: ["&l扳手是 TechReborn 添加的工具，用于旋转或拆卸机器。许多机器需要扳手才能安全拆卸，即使不需要，扳手也更快，并且通常有独特优势，例如保留能量水平和内部物品。 &r"]
	quest.5B72388F7AE6FADC.quest_desc: [
		"&lFind the bosses using the &nSeeking Eye&r.&r"
		""
		"&l模组中有很多有趣的生物群系、材料、生物、工具和武器等你探索&r"
	]
	quest.5B72388F7AE6FADC.quest_subtitle: "&b&lFind the Starlight Portal Ruins structure in the overworld and fight The Gatekeeper.&r&r"
	quest.5C5E0ECFA6FAEB56.quest_desc: [
		"&6&l右键点击（或按住右键）任何蜜蜂，即可将其捕捉到手提箱中。手提箱最多可容纳14只任何种类的蜜蜂。也适用于许多模组蜜蜂，如Resourceful Bees或Productive Bees！Bee Queen和Beehemoth体型过大，无法放入手提箱中。&r&r"
		""
		"&6&lShift + 右键打开公文包UI，你可以在其中使用物品来治疗蜜蜂、装回毒针、为它们授粉，或将幼蜂培育成成年蜂。&r&r"
		""
		"&6&l你可以通过UI界面或左键点击任意方块来释放手提箱里的蜜蜂。左键点击实体时，会释放一只蜜蜂来攻击该实体。按住Shift + 左键点击会一次性释放所有蜜蜂！&r&r"
		""
		"&6&l这是某些结构战利品中的稀有掉落。同时也是第4级蜂后交易的稀有掉落（提供蜂蜜块/蜂蜜桶等第4级交易物品即可）&r&r"
	]
	quest.5C5E0ECFA6FAEB56.quest_subtitle: "&e&n&l用来装下所有蜜蜂的公文箱！！！&r&r&r"
	quest.5C8C06EC22BCF178.quest_desc: ["&l&4放置抽油机时，你将无法获得抽油机钻头！请务必放置在合适的位置&r&r"]
	quest.5C8C06EC22BCF178.quest_subtitle: "&l当泵机通电时，它会抽干区块中的石油。之后，你就可以用桶把石油取回来了！&r"
	quest.5D14502B8E818C36.quest_desc: ["&l“贪婪之王的眼睛在孤独中褪色；传说称它将为主人带来无尽的财富。”&r"]
	quest.5D14502B8E818C36.quest_subtitle: "&8&l可在掠夺者前哨基地的箱子里找到（30%概率）。&r&r"
	quest.5D8C63E6D9A6D88B.quest_desc: [
		"&6&l将物品放在副手，附近的生物将不再对你感到愤怒！(如果模组生物在精华生效期间仍攻击你，请告知我)&r&r"
		""
		"&l&6如果被任何生物伤害或攻击，效果会提前消失。如果在生效期间冲刺，物品的力量会迅速耗尽！不要着急！&r&r"
	]
	quest.5D8C63E6D9A6D88B.quest_subtitle: "&6&n&l 只有击败蓝色 Sempiternal Sanctum 的事件才能获得此终局物品！&r&r&r"
	quest.5E15F8F1A7D815E3.quest_subtitle: "合成背包坦克"
	quest.5E330B8D62648253.quest_desc: [
		"&6&l将物品放在副手，死亡时不会被杀死，而是会传送到重生点，恢复全部生命值、填满饥饿条、移除所有状态效果，并清除火焰。在硬核世界中同样有效！&r&r"
		""
		"&l&6它只能使用1次就会耗尽，需要40分钟才能通过被消耗过蜜蜂精华的玩家持有来重新充能。使用时，由于该物品过于强大，它还会对该玩家拥有的所有其他连续性精华施加冷却时间。&r&r"
	]
	quest.5E330B8D62648253.quest_subtitle: "&6&n&l只有在击败白色 Sempiternal Sanctum 的事件后才能获得的终局物品！&r&r&r"
	quest.5ED412FDC7E52FB3.quest_subtitle: "需要 Tier 2 锻造台"
	quest.5F8A761EAFAF3275.quest_desc: [
		"&6&l蜜蜂史莱姆会遍布整个大黄蜂区，有时也会从蜂巢产卵块中生成。"
		""
		"&6&l它们在被击中前是中立生物。之后会短暂地追逐你！如果被杀死，附近的蜂蜜史莱姆将对你产生敌意。&r&r&r&r"
	]
	quest.63090B4F4452731F.quest_desc: [""]
	quest.63090B4F4452731F.quest_subtitle: "&a&l在平原生物群系中生成，某些月相下更频繁。大的很厉害，小的会偷你的工具。不管怎样，杀了他们拿皮&r&r"
	quest.6339E11D3ADB254C.quest_desc: [""]
	quest.6339E11D3ADB254C.quest_subtitle: "&l电炉是一种行为与熔炉相同，但以32E速率消耗能量而非固体燃料的机器。电炉内部有1k能量的缓冲池。 &r"
	quest.6371752DF30BC7F1.quest_desc: [
		"&l方块&r"
		""
		"&l81 黑石&r"
		"&l4 凿刻抛光黑石基座&r"
		""
		"&l金化的黑石碎片可以在堡垒遗迹的各种战利品箱中找到，也可以通过与猪灵交易获得。"
		"&lThe piglin brute can drop 0 - 1 gilded blackstone shards upon death, unaffected by looting.&r&r"
	]
	quest.6371752DF30BC7F1.quest_subtitle: "&l玩家必须在下界任何地方建造该结构，并在每个雕纹抛光黑石槽中放置一个&n镀金黑石碎片&r。 &l当结构建造完成且&n所有4个碎片&r &l都已放置，仪式便会开始。&r&r&r"
	quest.639C0359510452BF.title: "击杀滴水石锥苦力怕"
	quest.63FCB5631B87C781.quest_desc: [""]
	quest.63FCB5631B87C781.quest_subtitle: "&9&l要点燃另一边的传送门，你需要通过击杀卫道士来获得深海之心。&r&r"
	quest.63FCB5631B87C781.title: "前往更深的黑暗（Deeper Darker）"
	quest.6582CADFE9FA29A3.title: "制作下界合金废料"
	quest.6721C6D77E28A45B.quest_subtitle: "让你可以为家用电器供电"
	quest.67415A7ED5C97BDD.quest_desc: [
		"&l碎片锻造炉是将矿石炼成锭的第一步。&r"
		""
		"&l分解矿石块会产生原矿，分解原矿会产生矿石粉尘。分解矿石块和原矿时，碎片锻造炉产出的会比投入的多。偶尔，它甚至会提供不同类型的额外矿石。&r"
	]
	quest.67AC3D0E82E8A29B.quest_desc: ["&l“曾有无数勇士沉入大海深处，再未归来。”&r"]
	quest.67AC3D0E82E8A29B.quest_subtitle: "&6&l由远古守卫者掉落（30%几率，不受掠夺或死亡原因影响）。&r&r"
	quest.67D7139C4BA186DA.quest_desc: ["&l“海盗们说，它让传奇的黑珍珠重获光明。”&r"]
	quest.67D7139C4BA186DA.quest_subtitle: "&1&l埋藏宝藏的宝箱中可找到（30%概率），守卫也会掉落（100%概率）。&r&r"
	quest.67F042C82F4F00A5.quest_subtitle: "水源 (Water Source)"
	quest.67F042C82F4F00A5.title: "建造食堂"
	quest.69D3D27494F750A6.quest_desc: [""]
	quest.69D3D27494F750A6.quest_subtitle: "&5&l你可以孵化自己的宠物龙！杀死巨龙并用蛋召唤出 The Eye，获得村民声望，然后再次收集蛋。将蛋放置在主世界，如果它感应到你的声望，就会开始孵化。用肉或兽皮驯服它。长大后，你可以给它装上兽皮马鞍并骑上它！&r&r"
	quest.69D3D27494F750A6.title: "击杀末影龙"
	quest.6A37972735286971.quest_desc: ["&6&l仅在王座柱结构中可找到。你可以通过细胞迷宫、战斗立方体或 Honitel 结构获得特殊的蜂蜜罗盘来找到王座柱。这种蜂蜜罗盘会显示已锁定到最近的王座柱结构。&r&r"]
	quest.6A53B8B2D710A8EF.quest_desc: [
		"&l真空吸尘器能让你把食物放进罐子里，这样就能在太空里吃东西了。&r"
		""
		"&l要让这台机器工作，你需要在第一格放一个罐子，第二格放食物，第三格放一个空的玻璃瓶。机器会给你一个装有食物的罐子和一个水瓶。&r"
	]
	quest.6AF7BC6952ABFA8A.title: "击杀海洋苦力怕"
	quest.6B0BE860B5924B38.quest_subtitle: "需要 Tier 2 锻造台"
	quest.6B9E990A4052E715.quest_desc: ["&l基础冲击钻是 Tech Reborn 中最低级的冲击钻。它能以钻石镐的速度破坏石头和类石头的方块。它有 10k 的储能。可以使用储能方块（如电池箱）为其充电。破坏一个方块需要消耗 50 能量。它具有铁矿挖掘等级，所以大多数矿石都可以用基础冲击钻挖掘，但速度非常慢。 &r"]
	quest.6BCA061E003ACFB8.quest_desc: [
		"&l所有奥里泰克矿石的生成方式与洞穴中的普通矿石相似。镍矿石位于 Y 40 至 Y -65 之间。铂矿石在正常世界 Y -2 至 Y -60 之间很少见，但在末地维度中储量丰富。&r"
		""
		"&lGold, redstone, and a couple of diamonds will also be very useful soon, so make sure to collect them as well.&r"
	]
	quest.6BCA061E003ACFB8.quest_subtitle: "&l你需要收集一些资源才能开始。&r"
	quest.6C0F8E9F05F94676.quest_desc: ["&l\"据信，这名学徒曾见过那些失传已久的古代酿造配方。\"&r"]
	quest.6C0F8E9F05F94676.quest_subtitle: "&5&lCrafted with 1 Eye of Ender and 1 Witch Pupil (10% chance Witch drop, unaffected by Looting or cause of death).&r&r"
	quest.6D169CF808103998.quest_subtitle: "需要 Tier 1 锻造台"
	quest.6E3FB5F82201A959.quest_desc: [""]
	quest.6E3FB5F82201A959.quest_subtitle: "&l研磨机是一种将矿石和其他材料磨成粉末的机器。这对矿石尤其有用，因为它能将单个矿石的锭产量翻倍。 &r"
	quest.6E6687170F80C3A9.quest_desc: [
		"&6&l它能抵抗许多导致减速的Bumblezone方块造成的减速效果，并且能在花朵或花粉堆中收集花粉！&r&r"
		""
		"&6&l当护腿装满花粉时，下蹲会生成花粉云。踩在湿海绵或进入水中时也会掉落花粉云。每次通过护腿生成花粉云，会尝试消耗1点耐久度。&r&r"
		""
		"&6&l花粉的收集和掉落也适用于盔甲架，所以如果巧妙利用，你可以用花、湿海绵、盔甲架和一些活塞来自动化花粉云的生成！&r&r"
		""
		"&6&l迟缓状态效果的持续时间将略微缩短。&r&r"
	]
	quest.6E6687170F80C3A9.quest_subtitle: "&6&l可在细胞迷宫结构中寻得，共有2种变体。&r&r"
	quest.6F0E9E67E4F5A30C.quest_subtitle: "&l煤炭发电机 需要煤炭 3 最大生成量 (Fe/次)&r"
	quest.7079E9FC7A12BCE1.quest_desc: [""]
	quest.7079E9FC7A12BCE1.quest_subtitle: "&1&l这些家伙会在主世界的雷暴中生成，并召唤骷髅守卫&r&r"
	quest.72A58B5C62F0854B.title: "制作 Earthdive 矛"
	quest.7340C5973DA147E3.quest_desc: [
		"&l这产生的电力不多，但足以让你开始探索了。&r"
		""
		"&l需要更多电力时，考虑建造额外的发电机&r"
	]
	quest.73B12B8EF0C67B35.quest_desc: ["亡灵塔位于主世界的寒冷生物群系中。玩家可以在这里召唤夜之亡灵，但前提是必须先从不死生物那里获得一些灵魂之星。塔内还栖息着各种其他敌对生物，包括身穿附魔盔甲的骷髅，稍加搜寻，还能找到装有战利品的宝箱。"]
	quest.73B12B8EF0C67B35.quest_subtitle: "巫妖塔"
	quest.73B12B8EF0C67B35.title: "击败夜之巫妖 (Night Lich)"
	quest.740C6CFF78AD2A45.quest_desc: [
		"&l铀可以在汞上找到。&r"
		""
		"&lUranium is used as a fuel type for the radioactive motor and it's needed to craft this motor&r"
	]
	quest.75103DE74078BB41.quest_desc: [""]
	quest.75103DE74078BB41.quest_subtitle: "&l雨水收集器是一种很有用的方块，下雨时会缓慢收集纯净水（下雪时也会，但非常慢）。纯净水可以用水壶或瓶子收集。&r"
	quest.76D75CC859A582E2.quest_subtitle: "需要 Tier 1 锻造台"
	quest.76FC943C0C02F4DE.quest_subtitle: "水源 (Water Source)"
	quest.76FC943C0C02F4DE.title: "建造食堂"
	quest.782565ABB878135D.title: "制作燧石刀"
	quest.78450F0DF779390A.title: "制作睡袋 (Make Sleeping Bag)"
	quest.78973A9253A742C1.quest_subtitle: "水源 (Water Source)"
	quest.78973A9253A742C1.title: "建造食堂"
	quest.7943C77FF388E5D2.quest_desc: [
		"&l碎片锻造炉可以提升矿石的产量。当矿石在碎片锻造炉中加工时，它们会被分解成矿石块和小型矿石块。&r"
		""
		"&l九个小型团块可以合成一个团块。这些团块可以在离心机中加工成粉尘和小型粉尘，然后在熔炉中熔炼。&r"
		""
		"&l你可以将原矿放入碎片锻造炉，但对于某些矿石，用带有丝绸之触的镐挖掘，然后将矿石方块放入锻造炉，效果会更好。&r"
		""
		"&l碎片锻造炉和离心机都可以产出次级矿石。例如，处理镍会产出镍，也可能附带一些铂。&r"
	]
	quest.795F0D15DD8FE1AE.quest_desc: ["&l\"据说能保护主人免受厄运的神圣护身符。\"&r"]
	quest.795F0D15DD8FE1AE.quest_subtitle: "&3&l用绿宝石（随机数量）和1个兔脚向大师级牧师村民购买。此交易可能会随机替换牧师的一个或两个原版大师级交易。&r&r"
	quest.79C80B8A7FF3FF27.quest_desc: ["&l岩切器是一种带有丝绸之触附魔的钻石级工具。它有10000点能量存储。它使用能量而非耐久度来破坏方块。破坏一个方块需要消耗10点能量。 &r"]
	quest.79F0AE47338756DF.title: "击杀雪地苦力怕"
	quest.7AF6D48C43C09E2D.title: "击杀云杉苦力怕"
	quest.7B960A44D58F48F1.quest_desc: ["&l高级冲击钻是基础冲击钻的进阶版，可从TechReborn获取。它有10万能量存储。可用储能方块（如电池箱）为其充电。冲击钻可替代镐，以钻石镐的速度破坏石头类方块（如石头或鹅卵石）。高级冲击钻设为激活状态时，可进行3×3范围挖掘。破坏一个方块需消耗100能量。它具有铁矿挖掘等级，因此大多数矿石都能被挖掘，但速度极慢，不过范围挖掘会跳过非石头方块。&r"]
	quest.7C2A03603C2215B3.quest_desc: [
		"&l这种资源可以通过熔炼铁来制作。铁可以在每个星球上找到&r"
		""
		"&l重型铁用于制作火箭站、升级站和燃料相关物品。&r"
	]
	quest.7C902A0C17961F8A.quest_desc: [
		"&6&l可以进入蜂巢迷宫，且不再受到蜂巢之怒效果的影响。&r&r"
		""
		"&6&l可以进入王座柱，靠近蜂后时不会受到挖掘疲劳。&r&r"
		""
		"&6&l可从填充的多孔蜂巢块中安全地采集蜂蜜，而不会受到蜂巢之怒效果的影响。&r&r"
		""
		"&6&l可以挖掘半透明的蜂蜜块，而不再受到蜂巢之怒效果的影响。&r&r"
		""
		"&6&l进入蜂蜜流体将获得再生效果。&r&r"
		""
		"&6&l进入皇家蜂胶流体可获得短暂的Beenergized效果和更强的再生效果。&r&r"
		""
		"&6&l蜂巢/蜂巢可以挖掘，用瓶子取蜜，或用剪刀剪取蜂巢蜜，而不会惹怒蜜蜂。无需篝火！&r&r"
		""
		"&6&l蜂蜜史莱姆在你拿走蜂蜜时不会对你生气。&r&r"
	]
	quest.7C902A0C17961F8A.quest_subtitle: "&6&l在Bumblezone中获得的半后期物品！通过完成蜂后提供的“女王的心愿”系列成就可获得。（该系列成就在首次与蜂后交易后开启）食用后，你将永久获得以下加成：&r&r"
	quest.7D2CDB6E0AA311AB.quest_desc: ["&e&lThe Bumblezone is a bee dimension filled with many brand new bee-related blocks! There's even quite a few structures to explore and a unique bee armor you can obtain! If you are lucky, you may find a special Throne-Locating Honey Compasses from certain structures that leads you to a Bee Queen!&r&r"]
	quest.7D2CDB6E0AA311AB.quest_subtitle: "&e&l只需向蜂巢投掷末影珍珠，即可进入内部并传送到该维度。&r&r"
	quest.7D2CDB6E0AA311AB.title: "访问大黄蜂区 (The Bumblezone)"
	quest.7E7C5041578CBBFE.quest_desc: [""]
	quest.7E7C5041578CBBFE.quest_subtitle: "&lSteel is used for all the composants of the rocket, machines, steel tools, Space Suit and oxygen tank.&r"
	quest.7EA170ADCCD621B9.quest_desc: ["&6&l这把高击退、高伤害的炮台，能将背包中的蜂蜜水晶碎片储存在物品栏中！最多可右键3次，将最多3个蜂蜜水晶碎片储存在炮台里。按住右键再松开，即可发射水晶！&r&r"]
	quest.7EA170ADCCD621B9.title: "水晶大炮"
	quest.7F501CE32F16C977.quest_desc: ["&l“冰学家们在突然从世界上消失前留下的最后几件遗物之一。”&r"]
	quest.7F501CE32F16C977.quest_subtitle: "&b&l在雪屋的箱子里发现（70%概率）。&r&r"
	task.09409989E774F978.title: "击败蜜蜂女王"
	task.0B5C4477E4DB0FCE.title: "火箭升级包"
	task.13D999DF0CBB896D.title: "Deafet 黑石傀儡"
	task.15DB597CC38FB617.title: "合金锻造"
	task.17012AED85DD0022.title: "矿石的碎片化生成"
	task.1FB365A9D4F2C93F.title: "前往永恒星光之地"
	task.26EADB82798C21E0.title: "欢迎来到下界"
	task.27188A8AE3E9E444.title: "击败虚空之影 (Defaet Void Shadow)"
	task.2C5839DD130C3233.title: "击杀丛林苦力怕"
	task.2FD224EC482FCDF1.title: "前往末地 (The End)"
	task.33D4406EAAD07ED8.title: "制作钢铁（及其他合金）"
	task.38E0DDD013AB5EB1.title: "击杀召唤者（Summoner）"
