		{
			id: "251D2B1F751A62DC"
			rewards: [{
				auto: "enabled"
				command: "/execute as @p at @s run tellraw @p [{\"text\":\"After defeating the mighty Netherite Monstrosity, a voice echoes in the depths of the Nether. 'You have proven your strenght warrior. I shall give you all my knowledge about the terror of the Nether. Hes my brother, Ignis. I have tried taking him down many times, but failed miserably. Now I'm only a blacksmiths who forges weapons in his boredom. Take my gift, I'll tell you how to find him, maybe you will be strong enough to defeat him and save this place what once was a beatiful paradise. To locate him, craft the Eye of Flame which leads you to the Burning Arena, where the flames dance and the earth trembles. He holds the secret to the Ignitium armor, forged in the fires of ancient power. But you are far from being able to defeat him, you need to get stronger, a lot stronger! Goodluck Wanderer!\",\"color\":\"gray\"},{\"text\":\"\",\"color\":\"yellow\"}]"
				id: "1102F9FEE6373B4B"
				team_reward: false
				type: "command"
			}]
