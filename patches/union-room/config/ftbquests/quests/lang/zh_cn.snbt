	quest.67F85F86CDF95F9B.quest_desc: [
		"带有咖啡馆服装的宝可梦及其获取方法："
		""
		"阿罗拉雷丘：黄色羊毛或蛋糕 ;)"
		"Mew：石灰绿或棕色的羊毛"
		"Litten: 紫色羊毛"
		"Sprigatito：石灰羊毛"
		"Meowscarada：白色羊毛……或者别的？"
		"Fuecoco：红色羊毛"
		"烈咬陆鲨：石灰羊毛"
		"小菊花：棕色羊毛"
		"Vulpix：白色羊毛（阿罗拉形态用石灰色）"
		"Tropius：棕色羊毛"
		"Tinkaton：粉色羊毛……或者其他？"
		"Fennekin：用白色羊毛铺成一条线"
		"Rowlet：棕色羊毛"
		"君主蛇：绿色羊毛"
		"Arctozolt: 棕色羊毛"
		"沙奈朵：蓝色羊毛"
		"莉莉甘特：粉色羊毛"
		"Cutiefly：黄色羊毛"
		"Noibat：紫色羊毛"
		"Chandelure：棕色羊毛"
		"Goodra：棕色羊毛"
		"暖暖猪：棕色羊毛"
		"卡里瓦斯：棕色羊毛"
		"Trapinch：黄色羊毛"
		"Vibrava：橙色羊毛"
		"Dracozolt：粉色羊毛"
	]
	quest.67F85F86CDF95F9B.quest_subtitle: "某些宝可梦拥有来自《Cafe Remix》和《宝可梦 集结》的服装！"
	quest.67F85F86CDF95F9B.title: "咖啡馆收藏系列"
