	quest.20234A5041465014.quest_desc: ["使用训练家卡开启系列后，右键点击会显示你的等级上限。若队伍中最强的成员接近等级上限，可能会出现道馆馆主或关键训练家，训练家卡会指引你找到他们。但若你超过了等级上限，他们将拒绝与你战斗。"]
	quest.20234A5041465014.quest_subtitle: "制作一张训练师卡牌。它会指引你找到训练师协会NPC，你可以用卡牌与他们交易，开启一系列挑战，开始与世界各地训练师的战斗。"
	quest.20234A5041465014.title: "健身房挑战者"
	quest.20DE8214E1C03F15.quest_subtitle: "制作音速发电机，产生有节奏的声波，并与机械系统集成，实现独特的自动化效果。"
	quest.20DE8214E1C03F15.title: "蒸汽的余音"
	quest.21CA46B9AED43B70.quest_subtitle: "设置一个序列组装器和机械合成器来自动化复杂的合成序列。"
	quest.21CA46B9AED43B70.title: "序列组装"
	quest.220E3EE4FABD878E.quest_subtitle: "获取一个机械搅拌机"
	quest.220E3EE4FABD878E.title: "混合搭配"
	quest.2237051D2DF6E976.quest_subtitle: "使用安山合金制作机械压机。压制金属和材料，形成用于装置中的机械组件。"
	quest.2237051D2DF6E976.title: "紧急事务需要处理"
	quest.22496C47FBA166AB.quest_subtitle: "获得一个精灵球。比你最强队伍成员高10级以上的宝可梦将不愿被你捕捉。"
	quest.22496C47FBA166AB.title: "让球滚动起来"
	quest.22549A4F1C4DF116.quest_subtitle: "获得一个灯笼。灯笼可以放在你的腰带配饰栏中，为你提供便携的免提光源。"
	quest.22549A4F1C4DF116.title: "要有光，就有了光"
	quest.228D6B3C6ECAD6D5.quest_subtitle: "建造 Crushing Wheels 以进行高级材料处理"
	quest.228D6B3C6ECAD6D5.title: "轻松搞定，毫无压力！"
	quest.229702FE9F56F640.quest_subtitle: "制作高级附魔台，利用流体和动能大规模施加复杂附魔。"
	quest.229702FE9F56F640.title: "高级附魔台"
	quest.22DA090E48A9A07C.quest_subtitle: "给奥格珀恩一个星之甜，让它穿上庆典礼服的装扮！"
	quest.22DA090E48A9A07C.title: "庆典长袍"
	quest.22F4B790D111E784.quest_subtitle: "获取一个Depot来配合你的压路机使用"
	quest.22F4B790D111E784.title: "第一座平台"
	quest.23464C1A76224F16.quest_subtitle: "制作一个机械钻头，即可自动挖掘石头和矿石。"
	quest.23464C1A76224F16.title: "无聊的商业活动"
	quest.234736A4517E550C.quest_subtitle: "制作一个机械合成器。连接到传送带后可自动合成配方。"
	quest.234736A4517E550C.title: "Crafter's Delight"
	quest.2399EB08125EA609.quest_subtitle: "获取一个密封风扇（可选的冷却工具）"
	quest.2399EB08125EA609.title: "气流实验"
	quest.23B312E7E1CB0F9A.quest_subtitle: "制作一个安山合金。这种基础金属是所有机械装置的基础。"
	quest.23B312E7E1CB0F9A.title: "安山合金底漆"
	quest.24AFF6A44E105B31.quest_subtitle: "制作一个墨水混合器来生产自动化所需的附魔墨水。支持批量生产附魔物品并与机器集成。"
	quest.24AFF6A44E105B31.title: "魔法混合术"
	quest.24B2EFB83296E88F.quest_subtitle: "制作一个小型齿轮来传递机械动力。"
	quest.24B2EFB83296E88F.title: "点燃你的热情，投入其中"
	quest.24B326EEF4DADDC4.quest_subtitle: "制作机械搅拌机，高效混合合金、流体和材料。为复杂机器准备材料的关键步骤。"
	quest.24B326EEF4DADDC4.title: "混合搭配"
	quest.24C3940AFFF1C19D.quest_subtitle: "合成烈焰附魔机，将经验和火焰转化为自动化能量。可为高级附魔装置提供动力。"
	quest.24C3940AFFF1C19D.title: "知识的烈焰 (Blaze of Knowledge)"
	quest.24CF3F283D6EF6CA.quest_subtitle: "获取一个展示柜。手持物品右键展示柜，可将物品放置其中。"
	quest.24CF3F283D6EF6CA.title: "奇怪的炫耀行为"
	quest.25DB6DAA262D117A.quest_subtitle: "制作一个日历，让你可以追踪季节。日历可以放在你的日历配件栏中。"
	quest.25DB6DAA262D117A.title: "104天暑假大冒险"
	quest.2659D604F06EF463.quest_subtitle: "制作一个顺序齿轮箱，以自动化多步骤的机械序列。"
	quest.2659D604F06EF463.title: "顺序化的齿轮换挡器"
	quest.2666AD2AF28F5696.quest_subtitle: "获取一台蒸汽机来增强你的动能系统"
	quest.2666AD2AF28F5696.title: "蒸汽的力量"
	quest.27D1FCF394D2FDB7.quest_subtitle: "制作一个宝可梦图鉴。"
	quest.27D1FCF394D2FDB7.title: "必须把它们全部捕捉到手"
	quest.2863A1C696E9402F.quest_subtitle: "制作机械搅拌机，将安山合金和流体等原料混合在一起。"
	quest.2863A1C696E9402F.title: "混合搭配"
	quest.28F8F0E95BFED517.quest_subtitle: "制作一个蒸汽引擎。为工业机器产生大量旋转能量。需要水和热量才能运行。"
	quest.28F8F0E95BFED517.title: "蒸汽之梦"
	quest.29209ECF7ED66B50.quest_subtitle: "获取一台机械液压机"
	quest.29209ECF7ED66B50.title: "紧急事务需要处理"
	quest.2A2742418BF9C2FB.quest_subtitle: "制作一个高级传送带，提高物品运输速度。"
	quest.2A2742418BF9C2FB.title: "高级传送带模组 (Advanced Conveyor)"
	quest.2A7AFAFD484F483F.quest_subtitle: "尝试有趣的 Package Frogport 整合包"
	quest.2A7AFAFD484F483F.title: "包裹青蛙港 (The Package Frogport)"
	quest.2ACB236D95BC907C.quest_subtitle: "尝试有趣的 Package Frogport 整合包"
	quest.2ACB236D95BC907C.title: "包裹青蛙港 (The Package Frogport)"
	quest.2B0385A144BC725B.quest_subtitle: "用皮革、线和箱子制作你的第一个背包。"
	quest.2B0385A144BC725B.title: "收拾行囊"
	quest.2B4AC6C20C758D8D.quest_subtitle: "制作一个篝火。篝火能带来温暖，让你无需饱腹也能恢复生命值。"
	quest.2B4AC6C20C758D8D.title: "生物舒适区"
	quest.2BA4314600CF3D9B.quest_subtitle: "制作机械合成台，可完全自动化合成，并解锁最复杂的合成配方。"
	quest.2BA4314600CF3D9B.title: "装配生产线"
	quest.2BCEA560B8E7F0A0.quest_subtitle: "获取安山合金（组合安山岩和铁）以开始机械建造。"
	quest.2BCEA560B8E7F0A0.title: "巧思的火花"
	quest.2C13F79B493E8BEA.quest_subtitle: "获取一个盆，用于在混合和制作过程中盛放材料。对于在系统中混合液体、合金和其他成分至关重要。"
	quest.2C13F79B493E8BEA.title: "收容混沌"
	quest.2C7450C939F87109.quest_subtitle: "制作工业装配机，自动化多步骤工厂生产。"
	quest.2C7450C939F87109.title: "工业装配器 (Industrial Assembler)"
	quest.2C8DAB277C23256E.quest_subtitle: "制作墨水混合器，为高级自动化生产附魔墨水。"
	quest.2C8DAB277C23256E.title: "魔法混合术"
	quest.2CDA87D78CB61EA5.quest_subtitle: "制作一个机械切割机。实现生产线的自动化切割。"
	quest.2CDA87D78CB61EA5.title: "生活点滴 (Slice of Life)"
	quest.2CEFBC782213FBDF.quest_subtitle: "设置仓库和传送带，让物品自动流动起来吧。"
	quest.2CEFBC782213FBDF.title: "自动化基础教程"
	quest.2D33081967C1BEE3.quest_subtitle: "制作一个水轮，利用流动的水产生旋转动力。可通过齿轮或传动轴为早期机器提供动力。"
	quest.2D33081967C1BEE3.title: "水利工程"
	quest.2D3786A500FF2380.quest_subtitle: "制作一个高级传送带，提高物品运输速度。"
	quest.2D3786A500FF2380.title: "高级传送带模组 (Advanced Conveyor)"
	quest.2D43C25279BFD507.quest_subtitle: "获取一个 Depot 来与装置交互并存储材料。"
	quest.2D43C25279BFD507.title: "第一座平台"
	quest.2D9837900D5ECB04.quest_subtitle: "制作机械切割器，实现自动化收割和切片操作。"
	quest.2D9837900D5ECB04.title: "机械切割机"
	quest.2DA0CD3C606B32A3.quest_subtitle: "在考古遗址中找到一块闪亮石头，考古遗址位于沙漠类群系中。它们可用于制作Z环。"
	quest.2DA0CD3C606B32A3.title: "...水晶"
	quest.2DA0DA0C09AF6DA7.quest_subtitle: "制作一台PC。这能让你访问宝可梦盒子。释放宝可梦也需要它。"
	quest.2DA0DA0C09AF6DA7.title: "Dedicated WAM"
	quest.2E1079A992D363C4.quest_subtitle: "获取机械锯，高效处理原木和木板。可集成到自动化木材处理系统中。"
	quest.2E1079A992D363C4.title: "尖端科技 Cutting Edge"
	quest.2F04718A69C76238.quest_subtitle: "建造火车站，实现原材料和成品在长途运输中的自动化。"
	quest.2F04718A69C76238.title: "全体登船"
	quest.2F457BC6FC6CF5EC.quest_subtitle: "在许愿林地中找到一颗许愿星。它们可能出现在黑暗森林、哭泣女巫森林和魔法缠绕中。"
	quest.2F457BC6FC6CF5EC.title: "向星星许愿"
	quest.303C9B499A837F1A.quest_subtitle: "制作风车帆。用于制造能为机器提供旋转动力的功能性风车。"
	quest.303C9B499A837F1A.title: "领会我的意思"
	quest.3041EFB2F9E14903.quest_subtitle: "制作一个机械压机。用它来将材料压缩成板状，或自动创建特殊组件。"
	quest.3041EFB2F9E14903.title: "机械压榨机"
	quest.307D67E7538D4AA4.quest_subtitle: "获得一个杏树苗。右键点击树木可以采摘杏子。偶尔，你也会获得杏树苗，可以种植另一棵杏树。杏子用于制作精灵球。"
	quest.307D67E7538D4AA4.title: "自给自足型生存指南"
	quest.30B670B58E4B184B.quest_subtitle: "制作一个由旋转力驱动的机械钻头，以自动化开采矿石和石头。"
	quest.30B670B58E4B184B.title: "自动化采矿"
	quest.30C8961A7DB61836.quest_subtitle: "获取一个机械锯（Mechanical Saw）"
	quest.30C8961A7DB61836.title: "尖端科技 Cutting Edge"
	quest.30D2CA8F36637139.quest_subtitle: "获取一个 Basin 来混合材料"
	quest.30D2CA8F36637139.title: "收容混沌"
	quest.3122F9FF83B44C2B.quest_subtitle: "将安山岩和铁结合，可以制作安山岩合金。这种基础材料是建造第一台机械机器和组件所必需的。"
	quest.3122F9FF83B44C2B.title: "巧思的火花"
	quest.313AD8F49AA65C08.quest_subtitle: "制作工业装配机，自动化多步骤工厂生产。"
	quest.313AD8F49AA65C08.title: "工业装配器 (Industrial Assembler)"
	quest.315DAA3CD11FC354.quest_subtitle: "制作一个Furni Crafter。这个方块能让你制作许多Cobblemon主题的家具。"
	quest.315DAA3CD11FC354.title: "室内设计 Interior Design"
	quest.317D200354FB480A.quest_subtitle: "制作一个 Basin 来盛放液体和混合材料。Basin 能让你组合金属和其他原料，是合金生产和早期自动化的基础。"
	quest.317D200354FB480A.title: "超级碗"
	quest.31EC205018A8053C.quest_subtitle: "制作一个 Cram-O-Matic。"
	quest.31EC205018A8053C.title: "哎呀，该死的，真倒霉"
	quest.3209D137AF82A625.quest_subtitle: "制作机械压机，压缩金属并形成机械组件。"
	quest.3209D137AF82A625.title: "紧急事务需要处理"
	quest.32427635C54FB619.quest_subtitle: "制作一个烈焰燃烧器。可将燃料转化为高温能量。适用于加热和耗能机器。"
	quest.32427635C54FB619.title: "烈焰之路"
	quest.3263C2ADFC6469B5.quest_subtitle: "在盆中混合锌和其他金属，制作一个锌合金。锌是制作黄铜的关键。"
	quest.3263C2ADFC6469B5.title: "锌的顶点"
	quest.327BAC2486DB39E7.quest_subtitle: "制作一个Packager来自动化批量处理"
	quest.327BAC2486DB39E7.title: "完美包裹"
	quest.337D0E094652B67E.quest_subtitle: "用羊毛、线和浆果制作一个浆果袋。"
	quest.337D0E094652B67E.title: "浆果好手"
	quest.34636A7EC1F4790B.quest_subtitle: "制作一个钓鱼导航仪。该装置会显示你钓鱼时可能遇到的宝可梦。"
	quest.34636A7EC1F4790B.title: "要把它们全部钓上来才行"
	quest.348C4F2BA8C7C9F9.quest_subtitle: "制作水轮，利用流动的水产生旋转动力。早期机械动力的必需品。"
	quest.348C4F2BA8C7C9F9.title: "水车"
	quest.35079E31A8B83A85.quest_subtitle: "制作一个封闭式链传动装置。用于远距离传输旋转动力。"
	quest.35079E31A8B83A85.title: "连锁反应"
	quest.3559D0D7C7F380D9.quest_subtitle: "组装一个序列组装装置"
	quest.3559D0D7C7F380D9.title: "复杂创造 (Complex Creations)"
	quest.3577CAC8722BEFCF.quest_subtitle: "制作一个风车轴承。与羊毛或风帆结合，利用风力产生旋转能量。"
	quest.3577CAC8722BEFCF.title: "请耐心一点，我还在努力中"
	quest.3602F88B547498BA.quest_subtitle: "制作一个牧场方块。将宝可梦放置其中，它们就能在这片区域自由活动。某些宝可梦甚至可以繁殖..."
	quest.3602F88B547498BA.title: "托儿所"
	quest.36BEE485FF086BBE.quest_subtitle: "制作一个 Encased Fan。可产生气流，用于批量熔炼、爆破、清洗等流程。"
	quest.36BEE485FF086BBE.title: "粉丝俱乐部"
	quest.36D7E22CEC0BC319.quest_subtitle: "获得一个稀有糖果。可在建筑中查找，部分宝可梦会偶尔掉落，或者可以制造。"
	quest.36D7E22CEC0BC319.title: "中等稀有度"
	quest.372F0A80E7737DE4.quest_subtitle: "制作一个蒸汽引擎来为工业机械提供动力。"
	quest.372F0A80E7737DE4.title: "蒸汽之梦"
	quest.3777DD057362D194.quest_subtitle: "获取机械臂来移动物品和自动化装置。"
	quest.3777DD057362D194.title: "伸出援手 (The Helping Hand)"
	quest.37B927CAFB25FFBA.quest_subtitle: "制作一个 Pokefinder。这个便捷的设备能让你追踪身边的特定宝可梦。"
	quest.37B927CAFB25FFBA.title: "必须把它们全部找出来"
	quest.39E108E00158D439.quest_subtitle: "制作机械搅拌机，自动混合配方所需的流体和材料。"
	quest.39E108E00158D439.title: "机械搅拌机"
	quest.3A141E7729F47B1F.quest_subtitle: "获取一个水轮以获得旋转动力"
	quest.3A141E7729F47B1F.title: "扭转的潮流"
	quest.3A272CCBF0652670.quest_subtitle: "获取一台蒸汽机来增强旋转动力，并驱动多台机器。"
	quest.3A272CCBF0652670.title: "蒸汽的力量"
	quest.3A2B8F037CEC3F2F.quest_subtitle: "制作一个工业装配器来合并多个装配步骤。"
	quest.3A2B8F037CEC3F2F.title: "组装一个梦境"
	quest.3A319B55CB50568F.quest_subtitle: "制作一个吊床。与床或睡袋不同，这能让你在夜幕降临前打发时间。"
	quest.3A319B55CB50568F.title: "米米米米？"
	quest.3A444517F0543036.quest_subtitle: "合成一块 Karpboard 方块。"
	quest.3A444517F0543036.title: "溅射药水"
	quest.3AC5E154D9F32D01.quest_subtitle: "获取一个用于物品处理的机械臂"
	quest.3AC5E154D9F32D01.title: "伸出援手 (The Helping Hand)"
	quest.3B7D63186D864494.quest_subtitle: "寻找钓鱼竿锻造模板，有时会在遗迹建筑的金质宝箱中找到。也可以向大师级渔夫村民购买。可用于制作钓鱼竿。"
	quest.3B7D63186D864494.title: "男人都爱我，鱼都怕我"
	quest.3B8866615852BF1F.quest_subtitle: "合成一个安山合金 Andesite Alloy"
	quest.3B8866615852BF1F.title: "巧思的火花"
	quest.3BBE4C110A6288FE.quest_subtitle: "骑着你的翼龙飞行1000格，给它穿上信使服装！"
	quest.3BBE4C110A6288FE.title: "特殊快递"
	quest.3BEB664A02CDB0DC.quest_subtitle: "制作喷气背包，即可在机器上空飞行。需要燃料，并与机械系统集成。"
	quest.3BEB664A02CDB0DC.title: "喷气背包"
	quest.3C00E86B8ED4765B.quest_subtitle: "制作喷气背包，翱翔于机器之上。需要燃料电池，并与机械系统集成以进行探索。"
	quest.3C00E86B8ED4765B.title: "喷气背包"
	quest.3CA4D84BDC0B86BC.quest_subtitle: "制作高级传送带，大幅提升物品运输速度。可与现有传送带和自动化网络无缝集成。"
	quest.3CA4D84BDC0B86BC.title: "升级工程（Escalated Engineering）"
	quest.3D01264F0BD2E3DE.quest_subtitle: "制作一个烈焰燃烧器，并与烈焰人搭档，为某些过程提供加热。"
	quest.3D01264F0BD2E3DE.title: "让他来烹饪吧"
	quest.3D042AC384F0C0B8.quest_subtitle: "制作高级附魔台，实现大规模复杂附魔。整合流体、经验和动能，实现高效自动化。"
	quest.3D042AC384F0C0B8.title: "附魔师的工坊"
	quest.3D92B9001996B068.quest_subtitle: "制作工程师护目镜。它能为你提供有关装置更多信息。"
	quest.3D92B9001996B068.title: "更清晰的视角"
	quest.3E67CE3555E754BA.quest_subtitle: "制作高级传送带，大幅提升物品运输速度。可与现有传送带和自动化系统集成。"
	quest.3E67CE3555E754BA.title: "升级工程（Escalated Engineering）"
	quest.3E77450A35BBFC3B.quest_subtitle: "制作一个机械锯。可自动切割木材和其他方块。"
	quest.3E77450A35BBFC3B.title: "切片与切割"
	quest.3ED8E901BBC66CB5.quest_subtitle: "制作一个球体胶囊和胶囊站。在球体胶囊上制作并放置贴纸，然后用胶囊站将其装备给宝可梦，这样你就可以带着自定义烟花效果的宝可梦出战了。"
	quest.3ED8E901BBC66CB5.title: "砰的一声巨响中"
	quest.3EDF9F13BAC47E78.quest_subtitle: "制作蒸汽引擎，为您的机器提供源源不断的旋转动力。"
	quest.3EDF9F13BAC47E78.title: "蒸汽引擎"
	quest.3F1F4293558FBB92.quest_desc: ["使用训练家卡开启系列后，右键点击会显示你的等级上限。若队伍中最强的成员接近等级上限，可能会出现道馆馆主或关键训练家，训练家卡会指引你找到他们。但若你超过了等级上限，他们将拒绝与你战斗。"]
	quest.3F1F4293558FBB92.quest_subtitle: "制作普通糖果，可以降低宝可梦一级。"
	quest.3F1F4293558FBB92.title: "并非那么稀有"
	quest.3F8410B3272B3DFC.quest_subtitle: "获得一个宝可梦零食。喂给宝可梦可以提升与它们的友好度。"
	quest.3F8410B3272B3DFC.title: "小零食综合征 (Little Treat Syndrome)"
	quest.3F85D52B2E00E257.quest_subtitle: "制作一台打印机。这个方块能让你自动化地打印附魔书。"
	quest.3F85D52B2E00E257.title: "打印与整理"
	quest.3FF9FCC4000E5E74.quest_subtitle: "制作一台Alternator。它可以将旋转能量转化为电能，但会消耗25%的能量。"
	quest.3FF9FCC4000E5E74.title: "或者"
	quest.3FFB0A407BDD72D0.quest_subtitle: "制作一个墨水混合器来生产用于自动化的附魔墨水。"
	quest.3FFB0A407BDD72D0.title: "墨水搅拌机"
	quest.400E4A1097876A65.quest_subtitle: "制作一个墨水混合器，用于批量自动化附魔物品的附魔墨水。"
	quest.400E4A1097876A65.title: "墨水搅拌机"
	quest.401F2FBB6C7A9981.quest_subtitle: "合成烈焰附魔机，将经验和火焰转化为自动化能量。用于高级附魔物品生产。"
	quest.401F2FBB6C7A9981.title: "知识的烈焰 (Blaze of Knowledge)"
