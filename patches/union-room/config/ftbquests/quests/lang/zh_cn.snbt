	quest.4059FE828F77F39D.title: "喷气背包"
	quest.40CB11D2E14B7A7A.quest_subtitle: "制作一个砧板。这是解锁 Farmer's Delight 食物配方所必需的。"
	quest.40CB11D2E14B7A7A.title: "劈砍与拆解"
