	quest.7E5BCFD3979CA905.title: "进化"
	quest.7E7A91DDE18DECD7.quest_desc: [
		"A &cTart Apple&f 是一种物品，"
		"可以将&6Applin&f进化成&6Flapple&f。"
		"可以被野生的 &6Applin&f 持有。"
		"也可以通过使用以下物品来获得："
		"使用外部动作 &aHeadbutt&f 撞击一棵树"
		"在&2森林&f中。"
	]
	quest.7E7A91DDE18DECD7.quest_subtitle: "Applin -> Flapple"
	quest.7E7CC307082CC6E4.quest_desc: [
		"这个&8重型球&f是一个"
		"特殊类型的&bPoké Ball&f"
		""
		"用于捕捉非常&8沉重&f的生物"
		"&a宝可梦&f。"
		""
		"可以通过&a合成&f来获得，"
		"从&e商店老板&f那里购买，或者作为"
		"一个&6一阶特殊掉落&f。"
		""
		"与大多数&bPoké Balls&f不同，它的捕获"
		"速率修改器改为&e加法&f模式"
		"乘法运算的。"
		""
		"按重量计算的捕获率修正系数："
		""
		"&7•&f ≤ 199.9kg → &c-20"
		"&7•&f 200–299.9kg → &a+20"
		"&7•&f 300–409.5kg → &a+30"
		"&7•&f ≥ 409.5kg → &a+40."
	]
	quest.7E7CC307082CC6E4.quest_subtitle: "重量级选手"
	quest.7ED141D0A0C2BA10.quest_desc: [
		"&d经验糖果&f是一种物品，"
		"被添加到了 &bPixelmon&f 中。每一个"
		"糖果会提供固定数量的 &a经验值&f，"
		"与总是能产生效果的&dRare Candies&f不同，"
		"给予足够的 &a经验值&f 以提升一级。"
	]
	quest.7ED141D0A0C2BA10.quest_subtitle: "3000 经验值"
	quest.7EF93C3795389A7A.quest_desc: [
		"&0Black Glasses&f 是一个手持物品。"
		"它能提升&8黑暗&f系招式的威力，幅度为"
