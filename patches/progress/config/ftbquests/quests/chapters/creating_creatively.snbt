	quests: [
		{
			title: "移动物品"
			x: -6.5d
			y: -2.0d
			subtitle: "该死，我喜欢漏斗这个东西"
			description: ["现在你有了旋转动力，就可以用它来移动物品，实现早期自动化了。\\n传送带会移动其上方的物品，通常会将物品运送到储料箱、料斗或其他传送带上，但要能将物品搬进或搬出大多数容器，你需要漏斗。\\n\\n另外需要注意的是——传送带很智能，不会溢出，如果你在传送带上放置机器（如机械压机），物品会等待机器处理后再继续前进。\\n\\n一如既往，请研究这些物品以获取更详细的视觉示例。"]
			dependencies: ["5E7B0AFE76B9C023"]
			id: "73CCFE4A980FB92E"
			tasks: [
				{
					id: "657AC51630E264F5"
					type: "item"
					item: "create:belt_connector"
				}
				{
					id: "0AD7D24BFF0E8BD0"
					type: "item"
					item: "create:andesite_funnel"
				}
			]
			rewards: [{
				id: "6FB0FA931F36A1DA"
				type: "xp_levels"
				xp_levels: 1
			}]
		}
		{
			title: "压力山大"
			x: -5.0d
			y: -4.0d
			subtitle: "#感同身受"
			description: ["这两种装置（可自由相互合成）用于测量你的齿轮和轴系所承受的速度和应力。\\n\\n风力磨坊和水车等旋转力来源会决定网络的应力容量，而压床、搅拌机和磨石等机器则会根据转速向网络施加应力。应力过大，整个系统就会停止运转。\\n\\n使用应力计和护目镜，你可以测量每个部件的贡献。别忘了，你还可以用大小齿轮手动调整传动比，以微调机器的运行速度和应力水平。"]
			dependencies: ["343CADE41B0F6A39"]
			id: "7BA51A9B269CB44B"
			tasks: [
				{
					id: "35153572704D6428"
					type: "item"
					item: "create:speedometer"
				}
				{
					id: "59ECD17B5558CD57"
					type: "item"
					item: "create:stressometer"
				}
			]
		}
		{
			title: "轴承（Bearings）"
			x: -2.5d
			y: -3.5d
			subtitle: "可移动部件"
			description: ["真正的魔法从这里开始！\\n\\n每个移动锚点都能以不同方式，将旋转力转化为世界中移动的方块。\\n某些机器，如锯子、钻头和犁，安装在移动装置上会表现不同，能造出强大（又滑稽）的农场或挖掘机器！\\n\\n* 机械轴承会旋转所附着的方块。很适合制作自动化农场！\\n* 机械活塞会推动（或拉动）所附着的结构。必须将延长杆装在背面，以设定其作用长度。\\n* 绳索滑轮会升降所附着的结构。配合齿轮换挡器，就能造出简易电梯！"]
			dependencies: ["343CADE41B0F6A39"]
