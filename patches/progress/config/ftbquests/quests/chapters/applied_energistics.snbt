			]
		}
		{
			x: 0.0d
			y: 16.0d
			subtitle: "递归式网络通信"
			description: ["网络中的网络！P2P隧道是网络中最复杂的机制，但也是最强大的之一。假设你的控制器很远，有个制作室需要几十个频道，拉多根粗电缆会很贵！\\n\\n但用P2P隧道，你可以通过单个频道“隧道”传输多达32个频道。听起来很乱？别担心，继续读下去。 \\n\\n隧道只是连接网络中的两点，而这个连接只占用一个频道。所以，如果一个P2P隧道指向你的控制器，再把它和网络的另一点配对，控制器那32个频道就会通过这个单一频道“隧道”传输，并直接连接到另一端。等你试过之后应该就懂了，快去试试吧！"]
			dependencies: ["2CC89513EA53A695"]
			id: "21A3EAC32E737B42"
			tasks: [{
				id: "166A59D4692D5474"
				type: "item"
				item: "ae2:me_p2p_tunnel"
			}]
			rewards: [{
				id: "6E2CF71CE7F049F9"
				type: "item"
				item: "ae2:me_p2p_tunnel"
			}]
		}
		{
			x: 1.0d
			y: 16.0d
			subtitle: "超迷你电源线"
			description: ["是时候学习子网了！还记得没有控制器的网络只有8个频道吗？你可以利用这一点。石英纤维可以连接ME电缆并传输能量，但它不会连接频道。所以纤维另一侧的任何东西都会是一个有8个空闲频道的“子网”。\\n\\n这样你就可以为各种东西创建独立的合成网络，而不会消耗主网络的频道，也不用担心与主网络有任何交互（例如将物品导出进行加工）。"]
			dependencies: ["2CC89513EA53A695"]
			id: "746572E4370B9A4C"
			tasks: [{
				id: "767577109F3617DF"
				type: "item"
				item: "ae2:quartz_fiber"
			}]
		}
		{
			x: -4.0d
			y: 14.5d
			subtitle: "请在内部查看"
			description: ["存储总线是一个非常实用的工具，它能查看外部存储（如箱子）中的所有内容，并在网络中提供访问权限。物品可以被取出并放入这个外部存储中。\\n\\n当与“子网”和接口结合使用时，它会变得非常强大（如果你还不知道这些是什么，其他任务会教你）。如果你将存储总线指向另一个网络或子网的接口，它将允许你完全访问该网络，但仅限单向！也就是说，带有存储总线的网络可以看到主网络中的所有东西，但主网络无法看到子网中的任何东西。"]
			dependencies: ["04B40C94433936A1"]
			id: "1D7D91BF2E7EAE9E"
			tasks: [{
				id: "6B64DB7CBD52A929"
				type: "item"
