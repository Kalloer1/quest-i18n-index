		{
			title: "找到自己的方向"
			icon: "minecraft:filled_map"
			x: -3.75d
			y: -5.25d
			description: ["使用旅行地图来定位自己！按“M”键打开地图。可以添加标记来标注兴趣点，死亡标记会自动添加。当从村民任务中获得地图时，你的旅行地图上会添加一个路点，方便导航。"]
			dependencies: ["6A377E0BD0B45BC5"]
			size: 1.5d
			id: "2E56DF35467BE295"
			tasks: [{
				id: "3AF5CCBA45F6DC78"
				type: "checkmark"
				title: "阅读"
			}]
			rewards: [
				{
					id: "55079C6539007C92"
					type: "xp"
					auto: "enabled"
					xp: 1
				}
				{
					id: "4EF1DA20073480F5"
					type: "item"
					item: "minecraft:spyglass"
				}
			]
		}
		{
			title: "村民与任务"
			icon: "ftbquests:book"
			x: -1.5d
			y: -5.25d
			description: [
				"村庄非常重要。每个村庄里的公会大师NPC会引导玩家完成本整合包的主线任务。完成主线任务才能解锁附魔、锻造以及其他装备升级和自动化功能。这些任务会要求玩家狩猎首领，获取稀有的末影之眼变种。公会大师的小屋也是查看村民声望（通过声望之书）和捐赠绿宝石（通过捐赠箱）的地方。声望的更多内容将在下一节介绍。"
				""
				""
			]
			dependencies: ["6A377E0BD0B45BC5"]
			size: 1.5d
			id: "49AF23C212917B34"
			tasks: [{
				id: "0C802152D8EA3267"
				type: "checkmark"
				title: "阅读"
			}]
			rewards: [{
				id: "15E44BAE1B24BC74"
				type: "xp"
				auto: "enabled"
				xp: 1
			}]
		}
		{
			title: "声望（以及如何恢复声望）"
			x: -1.5d
			y: -3.0d
			description: ["将翡翠包裹捐赠给任何村庄的公会大师即可恢复声望。此物品可由8个翡翠和1个皮革合成。要捐赠，只需找到公会大师（身穿蓝色衣服、住在红顶小屋的村民），用包裹右键他柜台上的捐赠箱即可。捐赠生效前，玩家需要睡觉。可能需要多次捐赠才能完全恢复声望。在村民面前掠夺箱子或桶，或伤害村民会降低声望。声望过低时，无法从村民处获取任务或交易，也无法提交现有任务。"]
			dependencies: ["49AF23C212917B34"]
			id: "257D44B8882C8937"
			tasks: [{
				id: "0112D4788B97E2CF"
				type: "item"
				item: "simple_mobs:bundled_emerald"
			}]
			rewards: [{
				id: "41D3DABF7AA2424E"
				type: "item"
				item: "minecraft:cookie"
			}]
		}
		{
			title: "交易契约"
			icon: "quest_giver:trading_contract_armorer"
			x: -1.5d
			y: -1.5d
			description: ["与村民交易需要交易契约。使用前，玩家必须手持契约，在讲台处按 Shift+点击 签署契约，然后用已签署的契约右键相应的村民进行交易。如果玩家死亡时持有契约，则需要重新签署。契约可以直接从村民处作为任务奖励获得，或通过以下任务解锁。完成以下任务的成本要高得多，但能换取村民任务的随机性。"]
			dependencies: ["257D44B8882C8937"]
