	filename: "storage"
	title: "储物空间"
	icon: "minecraft:chest"
	default_quest_shape: ""
	default_hide_dependency_lines: false
	quests: [
		{
			x: 0.0d
			y: 0.0d
			description: ["在这个整合包里，普通箱子只能帮你走一小段路，因为里面有成千上万种独特物品，你很快就会发现自己淹没在需要整理的箱子海洋中。幸运的是，这个整合包包含了一些能让整理宝藏（和垃圾）变得容易得多的模组。"]
			size: 2.0d
			id: "4D1B105EE54EDEAF"
			tasks: [{
				id: "3B86BA54AA15287D"
				type: "item"
				item: "minecraft:chest"
			}]
			rewards: [{
				id: "40A712D85762E768"
				type: "xp"
				xp: 1
			}]
		}
		{
			title: "储物抽屉"
			x: 2.25d
			y: 0.0d
			description: ["储物抽屉是存放大量单一物品的理想选择。非常适合存放大量需要轻松存取（或丢弃）的物品。它们可以制作成带有额外抽屉的变种，在一个方块中存放多个物品堆叠，并且可以升级以容纳更多物品堆叠。"]
			dependencies: ["4D1B105EE54EDEAF"]
			size: 1.5d
			id: "15C8700EFE52353A"
			tasks: [{
				id: "6FC7DD9A5732C9B4"
				type: "item"
				item: "storagedrawers:oak_full_drawers_1"
			}]
			rewards: [{
				id: "36BF6F96178BAC7D"
				type: "xp"
				xp: 5
			}]
		}
		{
			title: "云端存储"
			icon: "cloudstorage:cloud_chest"
			x: 0.0d
			y: -2.0d
			description: ["Cloud Storage can take some time to acquire the required materials, however it offers a very flexible storage system. Want one large storage network? Several smaller ones? Several large, seperate networks? Cloud storage can do it all - just be sure you aren't afraid of heights!"]
			dependencies: ["4D1B105EE54EDEAF"]
			size: 1.5d
			id: "6578C82B120DE0EA"
			tasks: [{
				id: "7F2BD0E1BBFBF5C1"
				type: "checkmark"
				title: "阅读"
			}]
			rewards: [{
				id: "6529B7B6EEBBFEB9"
				type: "item"
				item: "cloudstorage:guide_book"
			}]
		}
		{
			x: 0.0d
			y: -3.5d
			description: ["要开始使用云存储，你需要气球碎片来制作气球，还需要云块。气球生物和云生物都生成在 Y=196 以上，所以最好找些山！在空中建造一个平台会更容易对付它们，弓箭当然也很有用。气球会掉落碎片，可以用线和它们制作成气球，而云生物会掉落云块，可以用来制作云箱。"]
			dependencies: ["6578C82B120DE0EA"]
			id: "34A5470646A4CE63"
			tasks: [{
				id: "24C6540B62EB8438"
				type: "item"
				item: "cloudstorage:balloon"
			}]
			rewards: [{
				id: "381FB78BCB25EFCD"
				type: "item"
				item: "minecraft:iron_ingot"
			}]
		}
		{
			x: 0.0d
			y: -5.0d
			description: ["设置云存储的最后一步，是将云箱直接放置在天空方块下方（不要在室内！）。用气球右键点击它，其物品栏就会与所有同色气球的云箱同步。同色气球的额外箱子都会连接到同一个存储网络。"]
			dependencies: ["34A5470646A4CE63"]
			id: "5209737ECC6EC599"
			tasks: [{
				id: "7FF35AF151CD8866"
				type: "item"
				item: "cloudstorage:cloud_chest"
			}]
			rewards: [{
				id: "4F9D60196696D136"
				type: "item"
				item: "minecraft:cookie"
				count: 2
			}]
		}
		{
			x: 0.0d
			y: -6.5d
			description: ["静态气球和静态箱子可用于创建所有玩家都能访问的云库存。非常适合需要共享库存的团体。静态云块可通过在雷暴中击败云生物获得。放置一个静态云块，并用气球右键点击以给气球充能。使用静态云块制作静态云箱。"]
			dependencies: ["5209737ECC6EC599"]
