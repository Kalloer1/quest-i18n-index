	quest.52490456CC021CD1.quest_subtitle: "用于可视化火车的有效行驶路线。"
	quest.5272D9AC88702DE2.quest_subtitle: "模块化柴油发电机和普通柴油发电机一样。它们可以堆叠。生成的应力与堆叠的发动机数量成正比。"
	quest.52A29EA2DDF3B044.title: "高级盔甲"
	quest.52B14336BAF0A69E.quest_desc: [
		"§7月球低重力的环境带来了非凡的机动性。"
		""
		"§7Craft a §fGravity Normalizer§7 to adjust gravity to your preference for various activities."
		""
		"§7尝试不同的重力设置，以提高采矿效率和移动速度。"
	]
	quest.52B14336BAF0A69E.title: "月球重力实验"
	quest.52C1D5727A82A72F.quest_subtitle: "隧道用于管理传送带上物品的流动。"
	quest.52D8B15C3B75AB7F.quest_desc: [
		"&2发电机&r消耗SU来发电。转速越快，产生的电压和功率越高，最高可达&3255V&r和&c12.1kW&r。下一页有更详细的说明。"
		""
		"这是一个多步骤的部署配方，其中一个步骤涉及&e绞线机&r。"
		"从一个&6竖井&r开始，并按照以下步骤操作："
		""
		"1. 电容器"
		"2. 重型板甲"
		"3. 使用&e绕线机&r，将75圈&6铜线&r缠绕在它上面。"
		"4. 磁铁"
		"5. 钢铁机械装置"
		"6. 螺丝刀"
		""
		"重复三次，将有83%的几率获得一台发电机。"
		""
		"{@pagebreak}"
		"&30RPM - 40RPM&r"
		"无法生成电力"
		""
		"&341RPM - 223RPM&r"
		"电压从1V线性升高至255V"
		"恒定电流限制为40A，因此输出功率范围在40W - 10.2kW之间"
		""
		"&3224RPM - 256RPM&r"
		"恒定255V，输出功率增至12.1kW"
		"当前限制提升至 47.5A"
	]
	quest.52D8B15C3B75AB7F.quest_subtitle: "你获得了力量。"
	quest.52D8B15C3B75AB7F.title: "生成器"
