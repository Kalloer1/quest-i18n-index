		"§7• 应用于方块"
		""
		"§6提示：§7可用于自动化存储！"
	]
	quest.5B79E516CDBC0CDB.title: "§e查看单元格"
	quest.5B79E516CDBC0CDC.quest_desc: [
		"§6流体存储单元"
		""
