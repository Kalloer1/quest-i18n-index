	quest.7B9B6917BE069793.title: "铁粒 -> 铁锭"
	quest.7B9D2F7F33818837.quest_subtitle: "本质上是对磨石机的升级，提供了一些不同的配方，所以两种都留着可能比较值得。"
	quest.7BA17A1CD1393E60.quest_desc: [
		"§6钻石桶"
		""
