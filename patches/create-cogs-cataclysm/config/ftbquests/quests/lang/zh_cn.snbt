	quest.3EE8CF5E76B9C2B1.quest_desc: ["Bibliocraft 遗产现已回归"]
	quest.3F20E1456C92F278.quest_subtitle: "制作一个熔炉盆和熔炉顶"
	quest.3F20E1456C92F278.title: "改良型冲天炉"
	quest.3F28400EE8FFE9A9.quest_subtitle: "收集下界疣和灵魂沙"
	quest.3F6E07DE790AF0F4.quest_desc: [
		"下界之眼可以在下界堡垒中找到。"
		""
		"§7探索下界，找到一个下界堡垒。"
		"§7检查堡垒内的所有箱子。"
		"§7小心烈焰人和凋零骷髅。"
		""
		"§6提示：§7在末地寻找横跨熔岩湖的长桥状结构。或者也可以通过击杀来获得"
		"{ \"text\": \"netherite monstersity\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"53154550397E9704\" } }"
	]
	quest.3F85C2E198ACEE74.title: "升级你的镐子"
	quest.3F8B59B04E26C1C2.quest_subtitle: "一种仅在接收到红石信号时才允许能量(E)通过的电路元件。"
	quest.3F90F1E4A89BE047.quest_desc: [
		"汉堡需要配菜！为以下物品创建生产线："
		""
		"§6经典侧边栏：§r"
		"• 法式炸薯条（土豆片，已烹饪）"
		"• 沙拉（混合蔬菜）"
		"• 饮品（水 + 配料）"
