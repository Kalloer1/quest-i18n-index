	quest.7DC70E338A7F5ECD.title: "这根本就不是奶酪！？"
	quest.7DC9A48B25E63807.quest_desc: ["&6黄铜漏斗&r是升级后的安山岩漏斗，可添加物品过滤器，每次最多移动一叠物品"]
	quest.7DC9A48B25E63807.quest_subtitle: "一个升级过的漏斗"
	quest.7DD05DDD6A816DFC.quest_subtitle: "创造：Bitterballen 是 Create 的一个模组，添加了荷兰零食。（任务待完成）"
