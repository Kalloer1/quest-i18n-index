	]
	quest.77DE3A3D3230ABD3.title: "§e堆叠升级器"
	quest.77FB064296CB5CE8.quest_subtitle: "在决定废弃什么以及如何废弃时，要更果断一些"
	quest.781AA60967A22E0D.quest_desc: [
		"§7§f大型柴油发动机§7是基础柴油发动机的重大升级版本。"
		""
		"§7巨大的输出功率可以驱动你最复杂的自动化装置。"
	]
	quest.784228C2304DAD3C.quest_subtitle: "柴油气缸 + 火花塞"
	quest.784228C2304DAD3C.title: "汽油、石油醚、煤油桶"
	quest.785322C002100649.quest_subtitle: "连接一个动力制动器，保持网络高速运行"
	quest.785322C002100649.title: "过于强大 (Overpowered)"
	quest.786F2AFB1C07E423.quest_desc: [
		"欢迎来到§l第三章！"
		""
		"既然你已经掌握了第2章的创造基础，就该进入工业革命了！"
		""
		"§7In this chapter, you'll learn how to harness steam power, work with more advanced fluids, and create complex automated systems."
		""
		"§7到最后，你将建成一条全自动密封机制生产流水线！"
	]
	quest.786F2AFB1C07E423.title: "3. 工业革命 (Industrial Revolution)"
	quest.78AB2B4CEBDFB0D3.quest_desc: [
		"§7§fRustic Delight§7 模组将为你的自动化之旅带来传统的乡村风味！"
		""
		"§7From rustic crops to hearty stews, these classic recipes are perfect for automated production."
		""
		"§f设置：§7"
		"§71. 使用§f洒水器§7和§f收割机§7种植独特的§f乡村作物§7"
		"§72. 使用§f切片机§7处理原始食材以进行传统烹饪"
		"§73. 设置§f烹饪锅§7用于炖菜和传统食谱"
		"§74. 使用§f部署器§7组装乡村三明治和餐点"
		""
		"§f提示：§7乡村美食通常能提供出色的饱腹感，非常适合长途冒险！"
	]
	quest.78AB2B4CEBDFB0D3.title: "乡村厨房自动化"
	quest.78C692F91A349443.quest_desc: ["生命值：30（蓄力时50）/ 攻击力：8（蓄力时16）/ 修复材料：海带 / 掉落：1-3海带，1-3棱镜晶块 / 信息：靠近导管时会“蓄力”——提升伤害、再生和抗性。"]
	quest.798CADF6B8930572.quest_subtitle: "一台能自动合成配方和调配药水等物品的机器。\\n\\n需要至少30转/分钟的转速才能工作"
	quest.79C615608E3FE660.quest_desc: [
		"每个家都需要妥善的储物空间！"
		"箱子不错，但橱柜和木桶兼具风格与实用性。"
		""
		"§7提示：不同木材能打造出外观各异的储物空间！"
	]
	quest.79C615608E3FE660.title: "储物解决方案"
	quest.79C98F24D7700C6A.quest_desc: [
		"§7月球低重力的环境非常适合建立一个永久性的行动基地。"
		""
		"§7建造一个封闭空间，配备适当的§f氧气分配§7系统，以创造可呼吸的环境。"
		""
		"§7你的月球基地将作为进一步太空探索的出发点。"
	]
	quest.79C98F24D7700C6A.title: "建立一个月球基地"
	quest.79FAB4A9DAC5CFA4.quest_desc: [
		"§7你已经掌握了§fApplied Energistics 2§7的基础知识！"
		""
		"§7这将解锁§f高级存储§7章节，其中包含关于AE2功能的更详细信息。"
		""
		"§7继续你的旅程，成为真正的网络大师！"
	]
	quest.79FAB4A9DAC5CFA4.title: "高级存储系统 (Advanced Storage)"
	quest.79FCBEBFE6E29E44.quest_desc: ["&6机械钻头&r可以挖掘前方的任何方块，非常适合需要破坏方块来建造的农场，比如鹅卵石农场"]
	quest.79FCBEBFE6E29E44.quest_subtitle: "为你挖矿的模组包"
	quest.7A12A3545393A741.quest_desc: [
		"§7Enter the world of §fComputers§7 in Minecraft with ComputerCraft!"
		""
		"§7这些强大的机器可以自动化任务、控制系统，甚至可以与其他模组如AE2通信。"
		""
		"§7从基础计算机开始，探索 Lua 编程的潜力。"
	]
	quest.7A12A3545393A741.title: "数字革命"
	quest.7A39A5B9E3CAC840.quest_desc: ["要从&6bottle o' enchanting&r中获取液体经验，你需要物品排水器，它在吸干经验后会返还瓶子给你"]
	quest.7A39A5B9E3CAC840.quest_subtitle: "偷走珍贵的经验值液体"
	quest.7A46B847C2C0899C.quest_desc: [
		"§7列车信号对于管理同一轨道网络上的多列火车至关重要。"
		""
		"§7设置信号的方法如下："
		"§71. 沿着轨道每隔一段距离放置信号机"
		"§72. 右键点击信号机以配置其行为"
		"§73. 若需条件操作，请将信号连接到红石上"
		""
		"§7提示：信号机通过创建单个火车才能占用的“方块”来防止火车相撞！"
	]
	quest.7A46B847C2C0899C.title: "安全第一"
	quest.7A4D01AF34BB7E0E.quest_desc: ["右键点击工业搅拌机以安装它。"]
	quest.7A4D01AF34BB7E0E.quest_subtitle: "快跑！"
	quest.7A80F0A31E481EEC.quest_desc: [
		"南瓜谷放眼望去，尽是连绵不断的南瓜地。"
		""
		"§6功能特性："
		"§7• 南瓜大丰收"
		"§7• 秋季的树叶"
		"§7• 连绵起伏的丘陵"
		""
		"满足你所有南瓜需求的完美之选 - 再也不用寻找稀有的南瓜了！"
	]
	quest.7A80F0A31E481EEC.title: "寻找大南瓜的任务"
	quest.7A8A2F37BD0C6706.quest_desc: [
		"恭喜你！你已经掌握了太空探索，并抵达了终极目的地——太阳系之外。"
		""
		"建造 Tier 11 火箭——太空技术的巅峰——以抵达曾被认为不可能的目的地。"
		""
		"§7这是你在 Ad Astra 和 Ad Extendra 中旅途的终点。宇宙现在由你探索！"
	]
	quest.7A8A2F37BD0C6706.title: "超越最终边疆 (Beyond the Final Frontier)"
	quest.7A8BE37C33E3BAE4.quest_desc: [
		"机械压机是你将建造的机器中最重要的之一！"
		"它可以把锭压成板，并自动化各种制作过程。"
		""
		"§7提示：右键并长按以转动曲柄——但要小心，这很费力！"
		""
		"§7提示：将其放置在你想按压的物品上方。"
		""
		"§6手摇曲柄是你提供旋转动力的第一种方式。"
	]
	quest.7A8BE37C33E3BAE4.title: "在压力下"
	quest.7A8BE37C33E3BAE5.quest_desc: [
		"优秀的冒险者需要充足的补给！"
		"我们从基础开始——一个用于烹饪的炉子和一些基本的烹饪工具。"
		""
		"§7提示：炉灶的用法和篝火一样，但更棒——下雨天也不会熄灭！"
		""
		"§7提示：将锅放在炉灶上可以获得更多烹饪选项。"
	]
	quest.7A8BE37C33E3BAE5.title: "烹饪时间到！"
	quest.7A8BE37C33E3BAE6.quest_desc: [
		"每位厨师都需要自己的工具！"
		"砧板能让你用新的方式准备食材。"
	]
	quest.7A8BE37C33E3BAE6.title: "切片与切割"
	quest.7A8BE37C33E3BAE7.quest_desc: [
		"是时候开始种植你自己的材料了！"
		"富饶的土壤能让作物生长得更快，产量更高。"
		""
		"§7提示：将有机堆肥放在地上，等待其分解。"
		""
		"§7提示：使用骨粉可以加快堆肥过程。"
	]
	quest.7A8BE37C33E3BAE7.title: "园艺大师"
	quest.7A8BE37C33E3BAE8.quest_desc: [
		"你的花园已经长大，是时候做些像样的饭菜了！"
		"这些菜肴会为你提供更高的饱食度和特殊效果。"
		""
		"§7提示：吃多样化的食物能提供更好的营养。"
		""
		"§6重要提示：将剩余的食物存放在橱柜中以保持新鲜！"
	]
	quest.7A8BE37C33E3BAE8.title: "美味佳肴"
	quest.7A8BE37C33E3BAE9.quest_desc: [
		"你已经掌握了烹饪和耕种的基础知识！"
		"你已经准备好探索更高级的烹饪艺术和食谱了。"
		""
		"§7提示：下一章将介绍高级烹饪技巧和特殊菜肴。"
		""
		"§6重要提示：准备好基本材料和工具！"
		""
		"§b点击对勾以解锁“自动化厨房”章节。"
	]
	quest.7A8BE37C33E3BAE9.title: "烹饪大师"
	quest.7A8BE37C33E3BAF0.quest_desc: [
		"美味的甜点不仅好吃，还能快速补充能量！"
		""
		"§7提示：派可以作为方块放置，并一片片地吃掉。"
		""
		"§7提示：甜食能快速恢复饥饿，但提供的饱腹感较少。"
	]
	quest.7A8BE37C33E3BAF0.title: "甜蜜点心"
	quest.7A8BE37C33E3BAF1.quest_desc: [
		"三明治非常适合冒险时使用！"
		"制作简单，携带方便，而且非常顶饱。"
		""
		"§7提示：尝试不同的肉类和蔬菜组合。"
		""
		"§7提示：用篮子装起来，享受完美的野餐！"
	]
	quest.7A8BE37C33E3BAF1.title: "便携午餐"
	quest.7A8BE37C33E3BAF2.quest_desc: [
		"原始食材是美味烹饪的基础！"
		"砧板有助于高效地准备食材。"
		""
		"§7提示：某些切好的食材比完整的更好！"
	]
	quest.7A8BE37C33E3BAF2.title: "准备工作"
	quest.7A8BE37C33E3BAF3.quest_desc: [
		"一个完美的花园需要周密的规划！"
		"这些作物会为你提供多种多样的材料。"
		""
		"§7提示：交错种植，让布局更清晰。"
		""
		"§7提示：富饶土壤与这些特殊作物搭配效果更佳！"
	]
	quest.7A8BE37C33E3BAF3.title: "作物规划"
	quest.7A8BE37C33E3BAF4.quest_desc: [
		"某些作物需要特殊照料才能正常生长。"
		"水稻需要水，有些植物一起生长得更好！"
		""
		"§7提示：在水田中种植水稻可获得最佳收成。"
		""
		"§7提示：用锄头在水边整地，可以开辟稻田。"
	]
	quest.7A8BE37C33E3BAF4.title: "水稻种植"
	quest.7A8BE37C33E3BAF5.quest_desc: [
		"村民需要合适的工作台才能提供他们的交易。"
		"不同的工作方块会给村民带来不同的职业！"
		""
		"§7提示：打破并替换职业方块以刷新交易。"
		""
		"§6重要提示：村民只能在工作时间更换职业。"
	]
	quest.7A8BE37C33E3BAF5.title: "寻找工作"
	quest.7A8BE37C33E3BAF6.quest_desc: [
		"吃饱了的村民就是快乐的村民！"
		"向村民投掷面包或其他食物，使他们愿意繁殖。"
		""
		"§7提示：确保有足够的床铺给新村民。"
		""
		"§7提示：村民需要能够寻路到他们的床。"
	]
	quest.7A8BE37C33E3BAF6.title: "扩大人口规模"
	quest.7A8BE37C33E3BAF7.quest_desc: [
		"村民喜欢绿宝石，而绿宝石是交易必需品！"
		"不同的职业提供获取绿宝石的不同方式。"
		""
		"§7提示：农民买农作物，屠夫买肉，弓箭匠买木棍。"
		""
		"§7提示：通过交易提升村民等级，解锁更优惠的交易！"
	]
	quest.7A8BE37C33E3BAF7.title: "翡翠经济系统"
	quest.7A8BE37C33E3BAF8.quest_desc: [
		"村民们需要保护，免受僵尸和其他威胁的侵害！"
		"铁傀儡会自然生成于大型村庄，但你也可以提供帮助。"
		""
		"§7提示：放置火把以防止僵尸围攻。"
		""
		"§7提示：建造至少2格高的墙壁以获得更好的保护。"
	]
	quest.7A8BE37C33E3BAF8.title: "村庄安全系统"
	quest.7A8BE37C33E3BB01.quest_desc: [
		"§d§l存储系统指南"
		""
		"欢迎来到高级存储解决方案的世界！"
		""
		"§6存储类型："
		"§7• 精致箱子模组 (Sophisticated Chests)"
		"§7• 精致桶 (Sophisticated Barrels)"
		"§7• 精致背包模组 (Sophisticated Backpacks)"
		""
		"§6升级分类：</c1>"
		"§7• 存储等级"
		"§7• 实用功能特性"
		"§7• 自动化"
		"§7• 特殊功能"
		""
		"§6专业提示："
		"§7• 从基础升级开始"
		"§7• 规划你的存储网络"
		"§7• 组合不同类型的存储方块"
	]
	quest.7A8BE37C33E3BB01.title: "§d§l高级存储系统"
	quest.7A8BE37C33E3BB08.quest_desc: [
		"§6ME 驱动器"
		""
		"你的数字存储单元！"
		""
		"§7功能特性："
		"§7• 可容纳 10 个存储单元"
		"§7• 优先级设置"
		"§7• 细胞状态显示"
		""
		"§6细胞类型："
		"§7• 物品存储"
		"§7• 流体存储"
		"§7• 化学品存储区"
		""
		"§6提示：§7使用视图单元来整理吧！"
	]
	quest.7A8BE37C33E3BB08.title: "§e存储驱动器"
	quest.7A9AC48E63F158BE.quest_desc: [
		"§7创建一个能与玩家对话的交互式聊天机器人！"
		""
		"§7基本步骤："
		"§7- 使用监视器设置一个§f聊天界面§7"
		"§7- 为响应创建一个简单的§f模式匹配§7系统"
		"§7- 将对话数据存储在文件中"
		""
		"§7高级功能："
		"§7- §f上下文感知§7，能记住之前的对话内容"
		"§7- §f命令处理§7，在受命时执行操作"
		"§7- 让你机器人独一无二的§f性格特征§7"
		"§7- §f多人支持§7，支持与多名玩家进行对话"
	]
	quest.7A9AC48E63F158BE.title: "人工智能"
	quest.7AF8AE0E14CB1C68.quest_desc: [
		"§7潜声捕手强大的颚部可以被采集，并制成具有独特属性的工具。"
		""
		"§6制作潜声下颚陷阱："
		"§7• 将陷阱放置在战略要地的地面上"
		"§7• 陷阱会夹住任何踩上去的生物"
		"§7• 可用于保卫基地或开辟安全路径"
		""
		"§6陷阱特性："
		"§7• 激活时造成大量伤害"
		"§7• 触发后可取回并重复使用"
		"§7• 对非斯库尔生物更有效果"
		"§7• 可用红石进行自动化升级"
	]
	quest.7AF8AE0E14CB1C68.title: "死亡之口"
	quest.7B17911BC0E8E8C6.quest_desc: [
		"将铁路导航器自定义为你喜欢的样子。"
		""
		"§7自定义选项包括："
		"§71. 地图颜色和可见性设置"
		"§72. 速度显示单位（m/s 或 km/h）"
		"§73. 界面语言"
		"§74. 通知偏好设置"
		"§75. 快捷键绑定"
		""
		"§7Access these settings through the gear icon in the Navigator interface!"
	]
	quest.7B17911BC0E8E8C6.title: "导航器自定义设置"
	quest.7B27F03A27C2DD7A.quest_desc: [
		"§6乡村小屋设计图"
		""
		"建造一个带有增强细节的温馨小木屋！"
		""
		"§7需要包含的关键元素："
		"§7• 混合木板用于墙壁"
		"§7• 木结构装饰元素"
		"§7• 角落处的小型原木柱"
		"§7• 装饰性木制家具"
		""
		"§6提示：§7添加石质烟囱和壁炉，增添温馨感"
	]
	quest.7B27F03A27C2DD7A.title: "§e乡村小屋设计师"
	quest.7B3913CCEBC7717D.quest_subtitle: "检测到火车时会发出红石信号。"
	quest.7B598A12DCD02559.quest_desc: ["Little Big Redstone 已安装。"]
	quest.7B72B8A2A801BDBE.quest_desc: ["&6下界合金背包&r是&e钻石背包&r的升级版。它有120个储物格，可容纳7个升级"]
	quest.7B72B8A2A801BDBE.quest_subtitle: "随时随地，海量存储"
	quest.7B7D0C8E25725B21.quest_desc: [
		"§7要制作生橡胶："
		""
		"§71. 将原木放入一个 §fBasin 中"
		"§72. 添加水"
		"§73. 用§fMixer §7处理以提取生橡胶"
		""
		"§7提示：用漏斗和出料口搭建自动化系统，批量处理原木！"
	]
	quest.7B7D0C8E25725B21.title: "支线任务：橡胶自动化"
	quest.7B81BC2FAA980E8D.quest_desc: [
		"§7§fSprinkler§7会自动灌溉其下方5x5范围内的作物，极大地加快了它们的生长速度。"
		""
		"§7Connect it to a water source with §fpipes§7, §ftanks§7, or even a §fCreate pump§7."
		""
		"§f提示：§7与§f创造者的机械收割机§7结合，可完全自动化作物种植！"
	]
	quest.7B81BC2FAA980E8D.title: "自动化灌溉系统"
