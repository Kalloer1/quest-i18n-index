	quest.3F90F1E4A89BE047.title: "要配点薯条吗？（Would You Like Fries With That?）"
	quest.3F98083A1EF33FD7.quest_desc: [
		"§6铁质储物箱"
		""
		"你的第一个储物升级！"
		""
		"§7功能特性："
		"§7• 基础：27 个槽位"
		"§7• 升级：+18 个物品栏"
		"§7• 总计：45 个槽位"
		""
		"§6额外奖励："
