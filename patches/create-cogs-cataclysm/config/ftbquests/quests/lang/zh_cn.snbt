	quest.49C19FE1535DBFA0.quest_desc: [
		"“追随这颗眼睛的人从此杳无音讯；传言说他们找到了伟大的亚特兰蒂斯城，或在寻找途中迷失了方向。”"
		""
		"§7异国情调之眼似乎能通往世界上最神秘的地方。"
		"§7这种眼睛在最奇特、最难以到达的地方被发现。"
		"§7使用时要小心——它可能会带你踏上一段危险的旅程！"
		""
		"§6提示：§7请在世界中最稀有的生物群系变种中寻找这颗眼睛。"
	]
	quest.49EE6F88CD93352E.quest_subtitle: "放置在密封风扇前，可以让它吹走物品。"
	quest.4A05B8ACEF72BAC0.quest_desc: [
		"机械钻头连接到移动装置上时，可以自动挖掘方块。"
		""
		"§7非常适合自动化采矿作业或清理大片区域。"
		""
		"§7尝试将其连接到活塞或机械轴承上，以实现不同的挖掘模式。"
	]
	quest.4A05B8ACEF72BAC0.title: "自动化采矿"
	quest.4A0C64647FC9572B.quest_desc: [
		"§7§f模块化柴油发动机§7比小型发动机提供更大的动力输出。"
		""
		"§7这种工业级引擎消耗更多燃料，但能产生更大的扭矩。"
		""
		"§7非常适合同时为多个装置供电或驱动高耗能机械。"
		""
		"§7确保你有一条强大的燃料生产线，以让这个饥渴的引擎高效运转。"
	]
	quest.4A19E3387DBD7FB0.quest_desc: [
		"消耗 &6电线&r 卷轴来缠绕物品。"
		""
		"涉及卷线器（如发电机、电位器）的合成配方将始终卷取精确所需的量。"
		""
		"绕制&6磁线圈&r时，可以指定绕线&b百分比&r（共1000匝），最低为100匝（10% = 100匝）。超过100匝仅用于变压器线圈。剩余线轴匝数可通过&e护目镜&r查看。"
		""
		"物品无法手动提取（电线轴除外），但没有未完成的物品过滤器。手动绕线操作请使用漏斗和杠杆。"
	]
	quest.4A19E3387DBD7FB0.quest_subtitle: "你成功地惹恼了我，这下可麻烦了。"
	quest.4A27BAEC8E0C8F2C.quest_desc: [
		"§6粉碎中"
		""
		"高级加工的第一步是粉碎原矿。这样可以开启更佳的加工路径。"
		""
		"§7所需创造组件："
		"§7• 压碎轮 (2)"
		"§7• 机械动力 (Mechanical Power)"
		""
		"§6Yields per Raw Ore:"
		"§7• 1 原矿 → 1 粉碎矿石"
		"§7• 经验之核的掉落几率"
		"§7• 解锁了额外的处理选项"
		""
		"§6提示：§7尽早自动化粉碎 - 你需要大量粉碎矿石！"
	]
	quest.4A27BAEC8E0C8F2C.title: "§e粉碎作业区 (Crushing Operations)"
	quest.4A28DEAA0E884AE6.quest_desc: [
		"§7回声水晶是深藏于异境深处的稀有晶体。开采后可获得回声碎片——具有独特共振特性的宝贵资源。"
		""
		"§6寻找回响水晶："
		"§7• 在异界的深层洞穴中搜寻"
		"§7• 常见于远古遗迹附近"
		"§7• 发出微弱的蓝光和共鸣声"
		""
		"§6采矿技巧："
		"§7• 使用带有丝绸之触的工具来采集整个晶体"
		"§7• 普通挖掘获得的碎片更少"
		"§7• 安静地采矿会降低吸引附近敌对生物的几率"
	]
	quest.4A28DEAA0E884AE6.title: "共振碎片"
	quest.4A32E607F9C82266.quest_desc: [
		"§7§fFestive Delight§7 扩展包添加了适合节日庆祝的时令美食！"
		""
		"§7自动化制作§f姜饼屋§7和§f拐杖糖§7，能让你的基地全年充满节日气氛。"
		""
		"§f提示：§7 这些季节性物品是很棒的礼物和装饰品。设置专门的生产线来保持库存充足！"
		""
		"§7试试用§f盆混合器§7来和面，用§f部署器§7来组装！"
	]
	quest.4A32E607F9C82266.title: "节日美食加工厂"
	quest.4A59ED3829D4D682.title: "在盆中按压胡萝卜和土豆来准备斯塔姆波特"
	quest.4A691BB889C1E38A.quest_desc: [
		"每个冒险者都需要一套好的工具！"
		"制作一些基础石制工具，帮助你更高效地收集资源。"
		""
		"§7提示：石制工具比木制工具耐用得多。"
		""
		"§7提示：石镐能让你开采铁矿石，你很快就会需要它。"
	]
	quest.4A691BB889C1E38A.title: "石器时代基础篇"
	quest.4A74062E59F8CD56.quest_desc: [
		"机械皮带用于传递未直接连接的轴之间的旋转。"
		""
		"§7放置两个平行的竖井，中间留出空隙，然后用绳子右键点击以创建传送带。"
		""
		"§7传送带配合漏斗和滑槽使用时，也可以运输物品！"
	]
	quest.4A74062E59F8CD56.title: "物品与能量传输系统"
	quest.4A8BE37C33E3BB05.quest_desc: [
		"§6处理器"
		""
		"你系统的核心大脑！"
		""
		"§7可用类型："
		"§7• 逻辑（黄金）"
		"§7• 计算 (Certus)"
		"§7• 工程学（钻石）"
		""
		"§7创造过程："
		"§7• 按下组件（创建部署）"
		"§7• 与硅结合"
		"§7• 在 Create Assembly 中处理"
		""
		"§6提示：§7尽早自动化处理器生产！"
	]
	quest.4A8BE37C33E3BB05.title: "§e处理器"
	quest.4A9BDC210AA45E32.quest_desc: [
		"§7幽魂是一种在晶洞峡谷深处发现的神秘生物。"
		""
		"§7这些空灵生物与晶体的魔法特性紧密相连。"
		""
		"§7靠近时要小心——它们可能隐藏着秘密！"
		""
		"§7幽魂会被晶体的力量所吸引，有时会在观察晶体结构的地方被发现。"
	]
	quest.4A9BDC210AA45E32.title: "Ethereal Encounters"
	quest.4A9D0D014C61CB7B.quest_desc: ["&6坚固的床&r标志着铁路时代的开端，如果你计划在全世界铺设宏伟的铁路网，此时岩浆和黑曜石能被动生成会对你大有裨益"]
	quest.4A9D0D014C61CB7B.quest_subtitle: "伟大铁路的开端"
	quest.4AA1614DA59D37C5.quest_desc: [
		"§7Allocate a portion of your automated §fGlowstone Dust§7 to your Moon Cobblestone production."
		""
		"§7这种发光材料为月球石的制作过程增添了重要属性。"
		""
		"§7确保稳定供应，以维持你的月球圆石制造循环。"
	]
	quest.4AA1614DA59D37C5.title: "Glowstone Dust"
	quest.4AA3033E2554D625.title: "把冰油炸了？"
	quest.4AB99C8447183BAC.quest_desc: [
		"§7如果你正确完成了第二章，你应该已经设置了日志自动化。"
		""
		"§7你现有的自动化系统应该使用："
		"§71. §f机械锯子 §7在 §f旋转装置上"
		"§72. §fDeployers §7with saplings to replant trees"
		""
		"§7这座可持续的木材农场对橡胶生产至关重要！"
	]
	quest.4AB99C8447183BAC.title: "已自动化：原木（Logs）"
	quest.4AD661C0A10ABD3B.quest_desc: ["用管道将液体经验储罐连接到出料口，你可以通过将瓶子右键点击仓库，或将瓶子放在出料口下方的传送带上，将液体装回瓶子"]
	quest.4AD661C0A10ABD3B.quest_subtitle: "制作附魔之瓶 (Bottles o' Enchanting)"
	quest.4AFEE661284E2CBA.quest_desc: [
		"§7Feed Cobblestone from your §fCobblestone Generator§7 into your Netherrack production line."
		""
		"§7这种基础建材与灰烬面粉和熔岩结合，可形成下界岩。"
		""
		"§7确保供应稳定，让你的下界岩生产顺利进行。"
	]
	quest.4AFEE661284E2CBA.title: "Cobblestone"
	quest.4B18C473FE242906.quest_desc: [
		"§7Create §fGlowstone Dust§7 by using a §fSpout§7 to pour §fLava§7 onto §fRedstone Dust§7."
		""
		"§7岩浆的灼热通过魔法反应将红石变成了萤石。"
		""
		"§7Set up an automated system that can reliably produce Glowstone Dust without manual intervention."
	]
	quest.4B18C473FE242906.title: "岩浆 + 红石 → 萤石粉"
	quest.4B3D35E2B7562509.quest_subtitle: "基础存储容量扩大2倍"
	quest.4B3E9D750F5E8B2B.quest_desc: [
		"§6纸张和布料"
		""
		"为您的建筑增添精致的装饰元素！"
		""
		"§7尝试制作以下物品："
		"§7• 纸墙和灯笼"
		"§7• 彩色纸方块"
		"§7• 图案织物"
		"§7• 装饰性屏风"
		""
		"§6提示：§7日式建筑和隔断的完美选择"
	]
	quest.4B3E9D750F5E8B2B.title: "§e纸和布装饰品装饰包"
	quest.4B4B3352870D70EC.title: "收集紫颂果和紫颂花"
	quest.4B5F93FB8ACD708D.quest_subtitle: "将物品放入存储系统的简易方法"
	quest.4B856811D221C35B.quest_desc: ["§7To create §fWheat Flour§7, you'll need to process wheat through §fCrushing Wheels§7."]
	quest.4B856811D221C35B.title: "小麦 -> 小麦面粉"
	quest.4B99B70CD1506925.quest_subtitle: "将这两个直接连接到一根杆上。（提示：放置器只能沿直线工作）"
	quest.4B99B70CD1506925.title: "插入燃料并排出热量"
	quest.4B9F31AC8F3D77FC.quest_desc: [
		"土星之外是天王星，一个充满神秘色彩的冰巨星，拥有独特的挑战和资源。"
		""
		"使用新获得的 Saturlyte 材料，制作 Tier 7 火箭，为旅程做好准备。"
		""
		"§7天王星的极端低温将考验你最先进的装备。建议携带额外的加热模块和专用隔热材料。"
	]
	quest.4B9F31AC8F3D77FC.title: "Sideways Journey"
	quest.4BA46D65C25A492B.quest_desc: [
		"征服了月球、火星、金星、水星，甚至抵达了比邻星轨道，你已准备好探索太阳系的外围了！"
		""
		"Ad Extendra 引入了更多待探索的行星、更强大的火箭和更严峻的挑战。"
		""
		"你的旅程将继续探索木星和土星等气态巨行星，并最终抵达最遥远的矮行星，如冥王星。"
		""
		"准备好迎接宇宙冒险的下一阶段吧！"
	]
	quest.4BA46D65C25A492B.title: "超越内行星系 (Beyond the Inner Planets)"
	quest.4BAACD5ACEDCAB1F.quest_subtitle: "决定更多关于自动拾取物品的内容"
	quest.4BCC40F1007650F7.quest_desc: [
		"§fDawn of Time Builder §7模组添加了逼真的中世纪建筑材料和家具。"
		""
		"§7建造一间舒适的中世纪酒馆、一座宏伟的城堡，或一间朴实的乡村小屋。"
		""
		"§7提示：搭配原版方块使用可获得最佳效果。"
	]
	quest.4BCC40F1007650F7.title: "中世纪美学模组 Medieval Aesthetics"
	quest.4BDCEB6206242999.quest_desc: ["§7如果你正确完成了任务，应该已经自动化了这一步。"]
	quest.4BDCEB6206242999.title: "安山岩合金"
	quest.4BF00406D0D157D6.quest_desc: [
		"§7Tuff 已经可以通过你之前的设置自动生产了。"
		""
		"§7这种用途广泛的石头在加工后是铜和锌的绝佳来源。"
	]
	quest.4BF00406D0D157D6.title: "已自动化：Tuff（一种粗砂岩）"
	quest.4BFC113227A11218.quest_desc: [
		"§7Fill a §fBlaze Cake Base§7 with §fLava§7 using a §fSpout§7 to create a complete Blaze Cake."
		""
		"§7这种高能量密度的食物可用于为烈焰燃烧器提供超充，以实现高温作业。"
		""
		"§7设置精确的流体控制，以防止在此填充过程中发生溢出。"
	]
	quest.4BFC113227A11218.title: "烈焰蛋糕底座 + 岩浆 → 烈焰蛋糕"
	quest.4C076BCACF6E16CA.title: "击败&5末影龙&r"
	quest.4C1E7C32DEB7CF21.quest_desc: [
		"沿海悬崖是危险之地。冒险家们曾讲述过名为纳迦的有翼巨蛇，它们速度惊人，还拥有可怕的酸性毒液。尽管这些巨蛇善于躲避，但只要箭法精准，就能将其击落。把握好时机，在纳迦准备攻击时射箭，便能轻松将其击败。"
		""
		"Naga酸很致命，但可以用来中和其他毒药。它们死亡时掉落的獠牙可用于酿造解毒剂和预防剂。"
	]
	quest.4C23E2F82033B1B7.quest_desc: [
		"恭喜你！你已经掌握了使用传送石进行传送的艺术。"
		""
		"你现在已经掌握了知识，可以在整个世界创建一个全面的传送网络，拥有各种专业的传送石和工具来满足你的需求。"
		""
		"请记住，默认情况下传送会消耗经验值，但服务器设置可能会改变此行为。"
	]
	quest.4C23E2F82033B1B7.title: "§d§l传送大师"
	quest.4C2D5F9FD7B8FB22.quest_desc: ["只有在真正沉迷于水泥之后，才能开始完成这些任务线。"]
	quest.4C2D5F9FD7B8FB22.quest_subtitle: "不，这还不是混凝土方块呢。"
	quest.4C3454AE44250449.quest_desc: [
		"与烈焰和风一样，布洛克斯是具象化的元素魔法。它们被巨大的元素力量所吸引，因此在僧侣消失后侵占了大地裂谷修道院。"
		""
		"它们死亡时会掉落Bluff Rods，用于修复Geomancy物品和开始Sculptor的测试。"
	]
	quest.4C5CDA8B11EC5D91.quest_desc: [
		"§6铺砌的小径和道路"
		""
		"为您的建筑创造美丽的路径和道路！"
		""
		"§7试试这些路径设计："
		"§7• 石质路径方块"
		"§7• 沥青和混凝土"
		"§7• 带有图案的路径方块"
		"§7• 混合材质用于纹理"
		""
		"§6提示：§7添加路径灯和装饰边框可增加细节"
	]
	quest.4C5CDA8B11EC5D91.title: "§e道路与小径"
	quest.4C87283E5D8A3872.quest_desc: ["钻孔排水器能帮你建造隧道和采石场，既没有常见的洪水问题，也不需要昂贵的部署器阵列，但代价是需要配置流体存储（可配置）。"]
	quest.4C87283E5D8A3872.title: "创建钻孔排水器"
	quest.4C9DD3B28C6746BF.quest_desc: [
		"§6木制种类多样化模组"
		""
		"Blockus 极大地扩展了您的木制建筑选项！"
		""
		"§7试试这些木制变种："
		"§7• 人字形木板"
		"§7• 拼花木板"
		"§7• 木制瓦片"
		"§7• 烧焦的木板"
		""
		"§6提示：§7混合不同的木材图案，打造有趣的天花板和地板"
	]
	quest.4C9DD3B28C6746BF.title: "§e增强型木材选项"
	quest.4CA82D89B59B33F6.quest_subtitle: "制作一个铸造盆或铸造台"
	quest.4CA82D89B59B33F6.title: "不要试图吹它！"
	quest.4CADD10D59979DE7.quest_desc: [
		"水星是离太阳最近的行星，随着自转，温度在酷热与严寒之间剧烈变化。它富含宝贵资源，尤其是卡洛里特。"
		""
		"Key Mercury 的主要特点："
		"- 额外的卡洛里特矿脉"
		"- 最极端的温度变化"
		"- 贫瘠、遍布陨石坑的地貌"
		"- 没有大气层"
		""
		"§7警告：水星上剧烈的温度变化会损坏装备。全套下界合金级防护至关重要。"
	]
	quest.4CADD10D59979DE7.title: "Sunburnt World"
	quest.4CCDD0283D36BD8A.quest_desc: ["&6火车外壳&r是用于创建所有火车相关事物的主要方块"]
	quest.4CCDD0283D36BD8A.quest_subtitle: "即将完成组装，只差最后一步"
	quest.4CDB3F8E217ADC8E.quest_subtitle: "在加热盆中进行混合。"
	quest.4CEAA300547D8103.quest_desc: [
		"§7使用§f鹅卵石生成器§7可以无限生成鹅卵石。"
		""
		"§7Set up a mechanical system to harvest and transport the generated cobblestone."
		""
		"§7这种可再生资源是太空计划材料链的基础。"
	]
	quest.4CEAA300547D8103.title: "鹅卵石生成器生成"
	quest.4CFB72C84BA53782.quest_desc: ["&6磨石&r能够粉碎多种物品"]
	quest.4CFB72C84BA53782.quest_subtitle: "可以制作染料和其他东西"
	quest.4CFB72C84BA53782.title: "磨坊石"
	quest.4D4C232EAD4C89BC.quest_desc: [
		"§6Alpha/Beta 树叶方块"
		""
		"还记得树叶是完全不透明的方块的时候吗？"
		""
		"§7这些方块包括："
		"§7• 第一片叶子的方块纹理"
		"§7• Beta 树叶图案"
		"§7• 实心、不透明的树叶方块"
		"§7• 原创树木设计"
		""
		"§6提示：§7与现代树叶混合，营造有趣的对比效果"
	]
	quest.4D4C232EAD4C89BC.title: "§e原始树木方块"
	quest.4D4EC850EBE23FA3.quest_desc: [
		"Warp Plate 是一种先进的传送装置，会自动将站在上面的任何实体传送到已链接的 Waystone。"
		""
		"非常适合用来创建自动化运输系统！"
	]
	quest.4D4EC850EBE23FA3.title: "自动化传送器"
	quest.4D55A7ABD7557FF1.quest_desc: ["任何&6附魔物品&r都可以放在去魔台上，它会吸收经验值并将其储存为液体，然后返还你放入的附魔物品，所以&6附魔书&r会返还一本书，而&6附魔的盔甲部件&r则会返还没有附魔的盔甲部件"]
	quest.4D55A7ABD7557FF1.quest_subtitle: "任意一本附魔书"
	quest.4D55A7ABD7557FF1.title: "附魔物品的附魔解除任务"
	quest.4D57C59D27514975.quest_desc: ["§7如果你正确完成了任务，应该已经自动化了这一步。"]
	quest.4D82A6BF692E1A75.quest_desc: ["灯笼点缀着顶生林的树冠，宛如水母般发光。有些文化认为这些生物包含着逝者的灵魂。另一些则像许愿星一样向它们许愿。然而，冒险家们知道，灯笼里发光的凝胶是一种绝佳的小吃，能短暂照亮最黑暗的夜晚。"]
	quest.4DA2A7D83DCFC75A.quest_desc: [
		"§7建造一条全自动的生物柴油生产线。"
		""
		"§7生物柴油是通过在搅拌机中混合植物油和乙醇，然后进一步加工制成的。"
		""
		"§7这种高品质燃料可为您的柴油发动机提供卓越性能。"
	]
	quest.4DA2A7D83DCFC75A.title: "生物柴油生产"
	quest.4DC3AC792B3B91E2.quest_desc: ["&6机械轴承&r是机器的核心部件，你可以在上面建造任何机器，它将成为机器的中央旋转部分"]
	quest.4DC3AC792B3B91E2.quest_subtitle: "机器的钥匙"
	quest.4DC3AC792B3B91E2.title: "机械轴承"
	quest.4DD5EEE415ACB9AA.quest_desc: [
		"§7用§f海带§7通过§f机械锯§7可以制作藤蔓。"
		""
		"§7切割操作可将水生植物转化为适合自动化需求的攀爬藤蔓。"
		""
		"§7搭建自动化切割站，高效地将海带加工成藤蔓。"
	]
	quest.4DD5EEE415ACB9AA.title: "海带 → 藤蔓"
	quest.4DD8EC6663F695BC.quest_subtitle: "放置一个序列脉冲发生器"
	quest.4DD8EC6663F695BC.title: "计算至上主义"
	quest.4DE18CB6F344809A.title: "制作一个完全充能的信标"
	quest.4DF1F48B12D460B1.quest_desc: [
		"§6冶炼升级包"
		""
		"直接在存储中处理物品！"
		""
		"§7可用类型："
		"§7• 熔炼"
		"§7• 吸烟中"
		"§7• 爆破"
		""
