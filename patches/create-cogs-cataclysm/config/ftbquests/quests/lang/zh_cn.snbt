	quest.216A404B2C75EE3A.title: "铜锭 + 锌锭 → 黄铜锭"
	quest.21800FC0CDC937CB.quest_desc: [
		"能产生比那小发电机高得多的电压和功率。"
		""
		"用大量铝和钢在&6机械合成器&r中组装组件。"
		""
		"用定子包围转子以完成多方块结构。"
		""
		"{@pagebreak}"
		"&30RPM - 70RPM&r"
		"无法生成电力"
		""
		"&371RPM - 256RPM&r"
		"电压从12V线性升高至2232kV"
		"恒定电流限制为24.6A，因此输出功率范围在295W至54.9kW之间"
	]
