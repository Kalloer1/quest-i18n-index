	quest.5A8BE37C33E3BB12.quest_desc: [
		"§6空间组件"
		""
		"储存整个区域！"
		""
		"§7可用尺寸："
		"§7• 2³ (小型)"
		"§7• 16³ (中)"
		"§7• 128³ (大型)"
		""
		"§7创造过程："
		"§7• 类似于储物箱"
		"§7• 更侧重于工程学的内容"
		"§7• 需要更高的功率"
		""
		"§6提示：§7规划好电力基础设施！"
	]
	quest.5A8BE37C33E3BB12.title: "§e空间组件"
	quest.5AA9EBBF1BF0D22D.quest_desc: [
		"海王星是离太阳最远的气态巨行星，含有用于先进技术的宝贵元素——海王星素。"
		""
		"制作一个8级火箭，前往这个遥远的世界。海王星的极端环境将需要你最先进的装备。"
		""
		"§7The pressure and cold of Neptune create unique resources impossible to find elsewhere in the solar system."
	]
	quest.5AA9EBBF1BF0D22D.title: "深蓝边境"
	quest.5B480653F522270A.quest_desc: [
		"§7Process §fNetherrack§7 using §fCrushing Wheels§7 to produce Cinder Flour."
		""
		"§7这种优质火药蕴含着下界的精华，是多种高级配方不可或缺的材料。"
		""
		"§7设计你的自动化系统，以应对这种材料的热敏特性。"
	]
	quest.5B480653F522270A.title: "下界岩 → 火山灰面粉"
	quest.5B6E4C516786A1EF.quest_desc: [
		"乐谱可以让你记录和播放旋律。"
		""
		"§7用它们和乐器一起创作你自己的歌曲吧！"
		""
		"§7你可以将它们分享给朋友，或者留作个人收藏。"
	]
	quest.5B6E4C516786A1EF.title: "乐谱 (Musical Score)"
	quest.5B75EA807BE749FC.quest_desc: [
		"专业的铁路系统离不开完善的指示牌。"
		""
		"§7需要考虑的铁路标志类型："
		"§71. 创建用于显示动态信息的告示牌"
		"§72. 车站名称和站台编号"
		"§73. 方向指示与路径引导"
		"§74. 轨道岔口的警示标志"
		"§75. 站台上的目的地指示牌"
		""
		"§7显示板可以连接到红石，根据列车状态、时刻表或其他条件显示不同信息！"
	]
	quest.5B75EA807BE749FC.title: "铁路标志牌"
	quest.5B7634CE82DEF523.quest_subtitle: "围绕自我表达、流体处理和工厂扩建展开！"
	quest.5B7634CE82DEF523.title: "雌激素（Estrogen）"
