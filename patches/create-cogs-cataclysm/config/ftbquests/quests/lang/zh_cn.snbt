	]
	quest.42C9928A3DB0CF7E.title: "§d§l传送石旅行指南"
	quest.42CE924B047FF8A6.quest_subtitle: "获取一个熔炉搅拌机 (Foundry Mixer)"
	quest.42CE924B047FF8A6.title: "你让我团团转！"
	quest.42D5840E0F4CED41.quest_desc: [
		"打造主题车厢能为你的铁路系统增添个性。"
		""
		"§7主题车厢创意："
		"§71. 带桌椅和食物陈列的餐车"
		"§72. 带床和装饰品的豪华卧铺车厢"
