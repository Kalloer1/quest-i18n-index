		"§7• 自动处理物品"
		"§7• 燃料效率高"
		"§7• 过滤兼容物品"
	]
	quest.4DF1F48B12D460B1.title: "§e处理升级中"
	quest.4E0503134BFF19F0.quest_subtitle: "一个可以监控物品栏和储罐填充水平的方块。"
	quest.4E058BAF38B16EE0.quest_subtitle: "然后我们连接起来——砰！"
	quest.4E1D2DC78E017E20.title: "卡片"
	quest.4E23C0E757337A53.quest_desc: [
		"§f泼洒§7砾石会移除所有小石子，只留下燧石和铁粒"
		""
		"§7For references on how §fSplashing §7works, look at the nether quartz quest. "
	]
	quest.4E23C0E757337A53.title: "砾石 -> 铁粒"
	quest.4E45C1FA4A67B68D.quest_desc: [
		"§6图案化方块"
		""
		"用这些带图案的选项，打造优雅的地面和墙壁！"
		""
		"§7试试这些图案："
		"§7• 棋盘格图案"
		"§7• 大小不同的方块"
		"§7• 圆形图案"
