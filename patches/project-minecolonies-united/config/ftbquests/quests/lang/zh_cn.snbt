	quest.0B72FF96FFC06166.title: "华丽的清洁工作开始了"
	quest.0C2CF9951AFE0B20.title: "在找到岩石之前都还不错"
	quest.0C7C931FEEB11D53.quest_desc: [
		"&e网格&r能让你访问你的存储网络。"
