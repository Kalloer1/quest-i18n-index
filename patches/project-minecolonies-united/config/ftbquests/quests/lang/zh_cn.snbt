	quest.095AA18B72DB5AE5.quest_desc: ["要开始使用 Silent Gear，请点击加入时收到的 &l&9Blueprint Package&r&r。如果弄丢了或扔掉了，可以使用命令 \"/give_me_kit blueprint\" 来获取一个新的"]
	quest.095AA18B72DB5AE5.title: "入门指南"
	quest.09805992A13A9104.quest_desc: [
		"本模组有 &c9 个钱包&r — 其中 &a8&r 个可以 &c制作&r！"
		"每个钱包都有一定数量的&b硬币槽&r和一些独特的&o特殊功能&r。"
		""
		"&6提示：&r你也可以在它们里面存放&a绿宝石&r！"
	]
	quest.09805992A13A9104.title: "一个存放所有零钱的地方"
	quest.099824065B6EEBC8.quest_desc: [
		"&6文件柜能让你将同一种物品的多种变体存放在一个整洁的地方。&r"
		""
		"&7It’s perfect for keeping your chests free of clutter like &crusted armor&7 or &ehalf-broken swords&7 with 50 random enchantments.&r  "
		"&7所有略有不同的物品都整齐地分好类——再也没有物品溢出的烦恼了！&r"
		""
		"&8注意：我说的“单一物品”是认真的。放入铁剑后，你只能存放其他类型的铁剑。不是钻石，不是黄金，也不是下界合金，而是铁！&r"
	]
	quest.0A621D63B6AA4203.quest_subtitle: "恶心的要死...兄弟，恶心的要死...！"
	quest.0A621D63B6AA4203.title: "诱饵：吸血蝙蝠幼虫"
	quest.0AA1387AC4C84804.quest_desc: ["带线的工具在配方中也需要一根绳子作为组成部分。"]
	quest.0AA1387AC4C84804.title: "准备好绳索！营造紧张感！"
	quest.0B009391E3F76D6E.quest_desc: [
		"渔夫是早期为村民提供食物的绝佳来源。希望你有足够的线资源。运气好的话，渔夫还能获得一些额外的战利品。"
		""
		"如果你的殖民地没有海洋或河流等天然水源，可以用一个 6x6x1 的水域代替。"
	]
	quest.0B2E598A43B87D0A.quest_desc: [
		"&e存储监控器&r可以让你追踪并与存储网络中的单一资源进行交互。"
		""
		"设置："
		"- 使用一根&7电缆&r将显示器连接到你的存储系统。"
		"- 空手状态下，&6Shift + 右键&r进行配置。"
		"- 插入你想要监控的物品。"
		""
		"用法："
		"- &a左键&r → 取出一个&b满堆叠&r的物品。"
		"- &6Shift + 左键&r → 取出&b单个物品&r。"
		"- &c右键&r → 将背包中所有匹配的物品存入。"
	]
	quest.0B2E598A43B87D0A.quest_subtitle: "那些都是菜鸟才会用的数字"
	quest.0B2E598A43B87D0A.title: "你得把这些数值提升上去才行"
