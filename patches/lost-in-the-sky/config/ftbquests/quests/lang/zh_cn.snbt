	quest.148AFDDFBFC0A1E5.quest_subtitle: "在这里买卖物品~"
	quest.157152585BDE2F63.quest_desc: [
		"四处找找这些东西！锌 &o可以&r 成为本整合包主模组的重要组件：&l创造&r"
