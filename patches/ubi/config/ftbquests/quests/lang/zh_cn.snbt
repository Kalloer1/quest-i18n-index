	quest.1F7F129C7C966484.quest_desc: ["本页列出了每种&ctrim&r中所有可找到的&astructures&r"]
	quest.1F7F129C7C966484.quest_subtitle: "所有地点都位于不同的维度中，包括主世界、下界和末地。"
	quest.1FDCA470EA86BD01.quest_subtitle: "用于配置我们稍后会制作的一些更复杂的&d机械&r。&r"
	quest.1FE273AE15FB9F43.quest_subtitle: "根据未满的槽位发出红石信号"
	quest.201CB898A399F1D5.quest_desc: [
		"猪倌小屋是猪倌用来繁殖和屠宰猪来获取食物的地方。你必须捕捉并带两头猪到猪倌小屋，因为猪倌自己不会捕捉和带猪回来。"
		""
		"猪倌在每个小屋等级上只会保留两头猪，所以在第5级时，他们的围栏里会有十头猪。"
	]
	quest.206159A3C7A78447.quest_subtitle: "建造一个神秘之地 (Mystical Site)"
