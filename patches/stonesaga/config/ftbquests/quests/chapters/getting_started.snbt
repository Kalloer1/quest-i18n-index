		}
		{
			dependencies: ["061BE1E8C340E908"]
			description: ["这个整合包里有好多事情可以做，大部分都在末地、其他维度、挖矿，或者只是单纯探索，寻找遗迹和曾经村庄、城堡或定居点留下的残骸。"]
			id: "3603C34B3F3A3724"
