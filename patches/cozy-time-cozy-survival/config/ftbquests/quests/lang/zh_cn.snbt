	quest.18461F67E0F09536.quest_desc: [
		"            &6稻草傀儡&f会"
		"             出现在 &e村庄&f中，或"
		"             由玩家手动创造&f"
		"            它是一位忠心的 &d守护者&f"
		"                 守护着你的 &a农场&f"
		"             它会看护田地&f"
		"             保护土壤&f"
		"              免受 &c破坏&f"
		"                它可以用 &b治疗&f"
		"                只需使用 &e小麦&f"
		"                它是 &a一位简单的盟友&f，适合"
		"            任何正在发展的 &6聚落&f"
	]
	quest.18461F67E0F09536.quest_subtitle: "农场守护者"
	quest.197F3B16E2DB9CAF.quest_desc: ["&f画框是能为室内增添个性的装饰性肖像画。它们非常适合放置在木抽屉上方或架子上，让你的设计更加完整。你可以随时放置或取下画框来更换展示的图片，从而实现动态且可自定义的 &a装饰。"]
	quest.197F3B16E2DB9CAF.quest_subtitle: "&7以多样风格进行装饰"
	quest.197F3B16E2DB9CAF.title: "&5&l任务： &r&e框架"
	quest.1A7233C5D44F93F2.quest_desc: ["&f由四块 &a远古残骸 &f锻造而成，再配以雕刻南瓜赋予生命，下界合金傀儡是你所能创造的最强伙伴之一。你可以骑着它投入战斗，按下跳跃键即可发动毁灭性的 &a地面重击， &f但它真正的力量源自熔岩。用一桶熔岩填满它的肚子，然后按下 &aR &f键释放小火苗，这些火苗会搜寻附近的敌人并将它们点燃。在雨天时要小心，因为携带熔岩会对它造成伤害。"]
	quest.1A7233C5D44F93F2.quest_subtitle: "&7由远古残骸锻造的强大坐骑"
	quest.1A7233C5D44F93F2.title: "&5&l任务： &r&e下界合金傀儡"
	quest.1AA516E728E41BEB.quest_subtitle: "&7烹制一顿丰盛的餐点"
	quest.1BBCDC6AFC34EA3A.quest_desc: [
		"      看似普通的 &2草&f"
		"     也能成为 &b有用的资源&f"
		"          通过破坏 &2高大的草丛"
		"           你就能收集到麦秆&f"
		"    它能用来制作 &6绳索&f、 &9安全网&f"
		"          布料&f和 &e麦秆块&f"
		"       现在就收集一些 &6麦秆&f，"
		"      为 &b未来的合成&f做好准备"
		"           开启你的 &a旅程&f"
		"  通过收集这种必备材料！"
	]
	quest.1BBCDC6AFC34EA3A.quest_subtitle: "麦秆？"
	quest.1BDAFBBB066AABBA.quest_desc: ["&f雪人是为数不多的经典冬日与节日象征。你可以制作出各具特色的变体，它们拥有不同的服饰与表情，非常适合用作节日装饰。建造一个，为你的世界带来欢乐的&a节日气氛 &f吧。"]
	quest.1BDAFBBB066AABBA.quest_subtitle: "&7庆祝冬季"
	quest.1BDAFBBB066AABBA.title: "&5&l任务： &r&e雪人"
	quest.1BEC4FE79FDF189A.quest_desc: ["&f金属栅栏门与金属栅栏相得益彰，既能控制出入，又能保持简洁现代的外观。虽然可选设计不多，但每一款都能与现代风格的建筑完美搭配。放置一个，完善你的&a现代建筑吧。"]
	quest.1BEC4FE79FDF189A.quest_subtitle: "&7完善你的现代设计"
	quest.1BEC4FE79FDF189A.title: "&5&l任务： &r&e金属栅栏门"
	quest.1C588B310F53870B.quest_desc: ["&f在建造大型结构或规划精细布局时，了解两点之间的确切距离可以节省时间和材料。使用&a卷尺 &f可以精确测量方块之间的空间，让你更轻松地设计道路、房间和装饰项目。制作或获取一把，在需要更高&a精度时使用吧。"]
	quest.1C588B310F53870B.quest_subtitle: "&7用精确距离规划你的建筑"
	quest.1C588B310F53870B.title: "&5&l任务： &r&e精确测量"
	quest.1C670E64C533318F.quest_desc: [
		"        我们可以使用&6烛台&f"
		"      来营造&b更昏暗的环境&f"
		"            不过 &c不会有生物出现&f"
	]
	quest.1C670E64C533318F.quest_subtitle: "制作蜡烛"
	quest.1C670E64C533318F.title: "Candelabra"
	quest.1C8A5D576B84C8F9.quest_desc: ["&f一些熟悉的资源在不同的环境中会获得新的价值。&a岩浆膏 &f虽然不是什么新东西，但在制作多种下界菜肴时都扮演着重要角色。收集一些，并储备好这种用途广泛的 &a食材吧。"]
	quest.1C8A5D576B84C8F9.quest_subtitle: "&7收集一种有用的下界资源"
	quest.1C8A5D576B84C8F9.title: "&5&l任务： &r&e岩浆膏"
	quest.1E15D3B82D207215.quest_desc: [
		"        建立 &6关系&f是"
		"            &b非常重要&f的一步"
		"        多花些 &e时间相处"
		"   并建立 &a情感联结&f"
		"        你就能建立起一个 &d真正的家庭&f"
	]
	quest.1E15D3B82D207215.quest_subtitle: "建立情感联结"
	quest.1E15D3B82D207215.title: "建立关系"
	quest.1E688603C2A2FA59.quest_desc: ["&f并非每条路都需要用挖掘的方式打通。按下 &aC &f或你设置的功能键，你就能从仅有一格高的空间里匍匐通过，从而更容易地钻进狭窄的隧道、隐藏的缝隙或尚未完工的通道中。在狭窄区域探索或工作时，这能同时节省 &a耐久度 &f和时间。"]
	quest.1E688603C2A2FA59.quest_subtitle: "&7匍匐进入你平时无法到达的地方"
	quest.1E688603C2A2FA59.title: "&5&l任务： &r&e穿过狭窄空间"
	quest.1EB976803982B10E.quest_subtitle: "&7烹饪一种奇特的末地食材"
	quest.1FD37614E675E0E6.quest_desc: [
		"         &f你好， &a朋友&f！欢迎来到"
		"       &f这个 &a快乐的世界&f。在这里，我们"
		"         可以拥有我们的 &6家庭&f、我们"
		"          的 &6房子&f，还有我们的 &6朋友&f。"
		"         &f这个世界充满了 &b工具"
		"           和 &b特殊技能 &f，它们能"
		"      将在你的 &e旅程&f中助你一臂之力！"
	]
	quest.1FD37614E675E0E6.quest_subtitle: "第一步"
	quest.1FD37614E675E0E6.title: "开启冒险"
	quest.202BF9FDE5B18397.quest_desc: [
		"      我们 &b最美好的经历之一&f"
		"    就是 &6孩子的诞生&f"
		"        在拥有 &a稳定而"
		"             幸福的关系&f之后"
		"       我们便可以迎来 &d第一个孩子&f"
	]
	quest.202BF9FDE5B18397.quest_subtitle: "长子"
	quest.202BF9FDE5B18397.title: "孩子"
	quest.211639665600D5ED.quest_desc: [
		" 随着我们增加 &e交易&f的次数"
		"    你就能获得 &6贵族&f头衔"
		"              在村庄之中"
		"        凭借这种级别的 &b影响力&f"
		"     你可以引导 &a人口增长&f"
		"              以及 &9组织&f工作。"
		"       现在所有人都 &b尊敬&f你"
	]
	quest.211639665600D5ED.quest_subtitle: "获得更大的影响力"
	quest.211639665600D5ED.title: "贵族"
	quest.215D8BB0FF8E6104.quest_subtitle: "&7用刀捕猎鳕鱼"
	quest.215D8BB0FF8E6104.title: "击杀鳕鱼"
	quest.21616D4D9D1B74E9.quest_desc: ["&f照明在你的建筑氛围营造中起着关键作用。灯笼有多种样式，包括天花板、墙壁和桌面款式。天花板灯笼色彩绚丽、设计现代，而墙壁灯笼则更具古典中世纪风格。将它们放置好，为你的 &a室内空间注入生机。"]
	quest.21616D4D9D1B74E9.quest_subtitle: "&7点亮你的室内空间"
	quest.21616D4D9D1B74E9.title: "&5&l任务：&r&e灯笼"
	quest.21FB233DD7994AAB.quest_desc: ["&f南瓜头是万圣节的经典装饰。它们有着不同的雕刻面孔和有无灯光的多种款式，非常适合营造恐怖氛围。将它们放置好，让你的建筑呈现出真正的 &a阴森 &f外观。"]
	quest.21FB233DD7994AAB.quest_subtitle: "&7营造一种阴森的氛围"
	quest.21FB233DD7994AAB.title: "&5&l任务：&r&e南瓜头"
	quest.235A356E70F144A6.quest_desc: [
		"     我们可以用&6桥&f把我们的"
		"            &d房子&f横跨&b湖泊&f连接起来"
		"   或者只是把它们用作&a装饰&f"
	]
	quest.235A356E70F144A6.quest_subtitle: "连接桥梁"
	quest.236F20189251101F.quest_desc: [
		"          这些&6跳跃蜘蛛&f"
		"            其实要&a友善得多&f"
		"             远非它们&6看起来的那样&f"
		"           成为&d伙伴"
		"            出人意料地&a有用&f"
		"           在&6茧&f附近发现"
		"             里面装有&e随机物品&f"
		"               以及&a蜘蛛丝&f"
		"            它们可以被&b驯服&f"
		"            使用&e蜻蜓翅膀&f"
		"             一旦它们对你&d忠诚&f"
		"           它们就会&b保护&f你"
		"           抵御附近的&c敌人&f"
	]
	quest.236F20189251101F.quest_subtitle: "蜘蛛侠？"
	quest.245D200B31809FAC.quest_desc: [
		"     我们可以把一个&6戒指&f送给某人"
		"      我们喜欢的人，并向他们&d求婚&f"
		"            戒指越&a稀有&f"
		"   你的伴侣就会越&b开心&f"
		"   &d婚姻&f是&b非常重要&f的一部分"
		"         &a一切由此开始&f"
	]
	quest.245D200B31809FAC.quest_subtitle: "活在当下"
	quest.245D200B31809FAC.title: "婚姻"
	quest.2487E0CFBFD9C40B.quest_subtitle: "&7收集一种稀有的龙类材料"
	quest.24C1167012D2A04D.quest_desc: ["&f吊灯是为您的室内增添优雅与中世纪风情的完美选择。搭配不同颜色的蜡烛，您可以随心定制建筑的氛围。放置一盏，让您的家或城堡更具&a经典 &f外观。"]
	quest.24C1167012D2A04D.quest_subtitle: "&7营造中世纪氛围"
	quest.24C1167012D2A04D.title: "&5&l任务： &r&e吊灯"
	quest.24E14A217F2E74D3.quest_desc: ["&f在海洋中，你可能会发现一种奇特的 &a海兔，&f这是一种无法驯服或繁殖的生物，但它能带来真正特别的东西。它能产生粘液，可以用玻璃瓶收集，而将四个装满的瓶子组合在一起，就能制作出一个 &a粘液块。&f这种奇特的方块可以攀爬和穿过，不过它的行为方式与你可能已经熟悉的粘液大不相同。"]
	quest.24E14A217F2E74D3.quest_subtitle: "&7从海洋中收获一份奇特的礼物"
	quest.24E14A217F2E74D3.title: "&5&l任务： &r&e海洋粘液"
	quest.25CC73AD2C69EE2B.quest_desc: ["&f金属栅栏为传统设计提供了一种更具现代感的替代方案。虽然它的变化较少，但其简洁规整的外观使其非常适合现代风格的建筑。用它来让你的建筑更具 &a现代 &f感吧。"]
	quest.25CC73AD2C69EE2B.quest_subtitle: "&7为你的建筑增添一抹现代气息"
	quest.25CC73AD2C69EE2B.title: "&5&l任务： &r&e金属栅栏"
	quest.25D496B2E2984B3A.quest_desc: ["&f由海带块和海晶灯建造而成，&a海带傀儡 &f无需雕刻南瓜即可被激活。它是一种坚固的水下防御者，非常适合保护海洋、河流或水下基地，并且可以使用更多&a海带进行修复。&f如果它站在已激活的催化剂附近，其力量会变得更强，成为水下的一股更强大的力量。"]
	quest.25D496B2E2984B3A.quest_subtitle: "&7深海的强大守护者"
	quest.25D496B2E2984B3A.title: "&5&l任务：&r&e海带傀儡"
	quest.25E22AB9007A85AB.quest_desc: ["&f下界可以实现更极端的烹饪方式。&a焦糊卷 &f这道料理利用高温和特殊食材，制作出一份强效餐食。快准备一份，扩充你的&a下界料理收藏吧。"]
	quest.25E22AB9007A85AB.quest_subtitle: "&7烹饪一道下界风味的菜肴"
	quest.25E22AB9007A85AB.title: "&5&l任务：&r&e焦糊卷"
	quest.25F7BACEA2E410B6.quest_subtitle: "鸡！"
	quest.25F90744B593FD3D.quest_desc: [
		"       我们有 &6几种新的栅栏"
		"                  可供探索"
		"         让我们 &b探索这些栅栏&f吧"
		"    为了 &a让一切变得更美&f"
	]
	quest.25F90744B593FD3D.quest_subtitle: "新栅栏"
	quest.26E7675F26B2ACDA.quest_desc: [
		"         &6邓氏章鱼&f是一种"
		"         &a和平&f生物，它"
		"        无法被 &b驯服&f或繁殖"
		"         但它的存在依然"
		"            &d极其珍贵&f"
		"            在它附近的 &b水下&f区域"
		"       它会生成一个 &a气泡&f"
		"            环绕在你的头部"
		"         帮助你 &b呼吸&f"
		"            并避免 &c溺水&f"
		"            留意这个"
		"           小巧而 &6奇特的盟友&f"
	]
	quest.26E7675F26B2ACDA.quest_subtitle: "           大耳朵？就是那个有大耳朵的？"
	quest.29077B3D845F23A3.quest_desc: [
		"       &6绳索&f是一种 &6简单又实用的&f"
		"      在 &e高处&f之间移动的方式"
		"        无需依赖"
		"      &c笨重的楼梯&f或 &c梯子&f即可通行"
		"      非常适合用于 &a树屋&f和"
		"       以 &d富有创意的方式&f打造室内空间"
		"        制作一些 &6绳索&f，让"
		"       &b垂直移动&f变得更加轻松"
		"        用此天然又 &d美观&f的工具"
		"     彻底改变你的 &a建筑&f！"
	]
	quest.29077B3D845F23A3.quest_subtitle: "攀爬"
	quest.29153A6C06FEE973.quest_desc: [
		"   在 &e高处&f建造存在 &c风险&f，"
		"           还可能损失你的 &4生命值&f"
		"       &6安全网&f可以在你"
		"         &e坠落&f时接住你，并 &b防止受到伤害&f"
		"       让你能安心地建造 &6高大结构&f和"
		"    &6垂直建筑&f"
		"      制作一张 &a安全网&f来保护"
		"      你最 &d宏大的项目&f"
		"      立即为你的建筑下方"
		"      增添 <c1>额外防护<c2>！"
	]
	quest.29153A6C06FEE973.quest_subtitle: "更柔软的着陆"
	quest.29D436EB8AE8002C.quest_desc: [
		"             由 &e蜂巢&f"
		"               和一些线绳制成&f"
		"            &6蜡烛魔像&f可能"
		"            初看之下 &a无害&f"
		"          但它是个 &d实用的守卫者&f"
		"             点击一下即可唤醒它&f"
		"                命令它坐下&f"
		"              使用&e打火石和铁锹&f"
		"              来发射火球&f"
		"              用&e蜂蜜&f来&b修复&f它"
		"               以保持它的&c火焰&f"
		"                始终&c燃烧&f"
	]
	quest.29D436EB8AE8002C.quest_subtitle: "Velinha"
	quest.2A35D875BA427140.quest_desc: [
		"    有些时候我们需要"
		"                 &b坐下来思考&f"
		"  我们可以&a制作椅子&f来&6更好地思考&f"
	]
	quest.2A35D875BA427140.quest_subtitle: "没有椅子就没有桌子。"
	quest.2A651FB59DBBF64B.quest_subtitle: "&7制作一道精致的海鲜菜肴"
	quest.2A79117743BA6056.quest_desc: ["&f你的背包可以随着你的旅程一同成长。通过花费&a经验值&f，你可以解锁额外的储物格，让它随着时间的推移能容纳越来越多的物品。请记住，每一次新的升级都需要更多的&a经验值，&f所以要谨慎选择何时扩展你的背包。"]
	quest.2A79117743BA6056.quest_subtitle: "&7使用经验值解锁更多背包储物格"
	quest.2A79117743BA6056.title: "&5&l任务：&r&e扩展你的储物空间"
	quest.2BBB0FB18A237481.quest_desc: ["&f并非所有的礼物都能以同样的方式送出。每个村民都有自己的品味，而发现他们真正喜欢什么是建立更深羁绊的关键。送出一份&a完美的礼物&f将极大地增进你们的关系，并表明你真正了解他们。请留心观察，谨慎选择，送出一份他们会&a喜爱的礼物。"]
	quest.2BBB0FB18A237481.quest_subtitle: "&7送出一份他们真正喜爱的礼物"
	quest.2BBB0FB18A237481.title: "&5&l任务：&r&e一份完美的礼物"
	quest.2BDA13186A5B1BD9.quest_desc: [
		"           我们可以拥有我们的&6宠物"
		"                 我们的&b朋友&f"
		"           他们会 &e帮助我们&f，并且"
		"        成为 &a忠实的伙伴&f"
		"          而且他们 &d非常可爱&f！"
	]
	quest.2BDA13186A5B1BD9.quest_subtitle: "你的小伙伴"
	quest.2BDA13186A5B1BD9.title: "朋友"
	quest.2C87F73971977050.quest_desc: [
		"            &f就像每个&e开始&f一样，"
		"          我们需要 &6收集 &f一些"
		"              &e木头 &f来开启我们的"
		"                  &a冒险&f！"
	]
	quest.2C87F73971977050.quest_subtitle: "从头开始"
	quest.2C87F73971977050.title: "橡木原木"
	quest.2CFB691F9A3EACA4.quest_desc: [
		"        &f总是多收集一些 &6"
		"       铁 &e很有用&f，既为了 &b将来"
		"         的 &b配方 &f，也为了 &6升级"
		"                  我们的 &e工具&f！"
	]
	quest.2CFB691F9A3EACA4.quest_subtitle: "收集铁"
	quest.2CFB691F9A3EACA4.title: "铁锭"
	quest.2D055E011E3FDB12.quest_subtitle: "&7将石板加工成可用的方块"
	quest.2D738B2BC12EAB7A.quest_desc: ["&f路径和铺路石有助于界定建筑的外部轮廓，让它们看起来更完整、更连贯。有多种设计和材料可供选择，你可以搭配不同的颜色和风格来匹配你的建筑。创建一条路径，让你的 &a户外区域 <c3>看起来更美观。"]
	quest.2D738B2BC12EAB7A.quest_subtitle: "&7设计精美的户外空间"
	quest.2D738B2BC12EAB7A.title: "&5&l任务： &r&e路径和铺路石"
	quest.2D76923DD6CA201D.quest_subtitle: "&7将其用作特殊材料"
	quest.2EB1D983E13ABE9A.quest_desc: ["&f墙壁的功能与围栏类似，但外观更坚固、更精致。墙壁有多种石材变体可供选择，让你可以匹配不同的建筑风格。用它们来建造，让你的建筑呈现出更 &a典雅 &f的外观。"]
	quest.2EB1D983E13ABE9A.quest_subtitle: "&7优雅而坚固地建造"
	quest.2EB1D983E13ABE9A.title: "&5&l任务： &r&e墙壁"
	quest.30749839049EA931.quest_desc: ["&f楼梯对于在不同层级间移动至关重要，同时也能塑造室内空间的外观。市面上有许多设计可供选择，有无扶手均可，材质有木质、石质或金属。从经典风格到现代风格，选择最适合您建筑的一款，连接您的 &a空间。"]
	quest.30749839049EA931.quest_subtitle: "&7以时尚风格连接您的空间"
	quest.30749839049EA931.title: "&5&l任务：&r&e楼梯"
	quest.30A3FBB5A4074800.quest_desc: [
		"         在植物&f和&a绿叶&f之间"
		"                 您可能会发现"
		"                正在移动的叶片&f"
		"            身披&a绿色&f、"
		"             &e黄色&f和&6橙色&f的生物"
		"           它们无法被&b驯服&f"
		"               但它们有一个"
		"               &d迷人的秘密&f"
		"                在它们附近播放一些&6音乐&f"
		"         然后看着它们"
		"                &b开始起舞&f"
	]
	quest.30A3FBB5A4074800.quest_subtitle: "起舞"
	quest.31A046E8CD79C949.quest_desc: [
		"       要建造&6巨型结构&f、"
		"        道路或房屋，我们需要"
		" &b测量值&f。使用&e卷尺"
		"       来测量&a方块间距"
		"                精准无误！"
	]
	quest.31A046E8CD79C949.quest_subtitle: "测量方块"
	quest.31B22DFEE260ACF8.quest_desc: [
		"             用&2海带块&f建造而成"
		"              再加上一盏&e海晶灯&f"
		"            &6海带傀儡&f便会苏醒"
		"             无需使用&e南瓜&f"
		"             它是一位强大的水下&f"
		"          &a守护者&f，守护着&b海洋&f和"
		"               水下基地&f"
		"            &b用更多的&e海带&f来修复它&f"
		"            在活跃的&d导管&f附近"
		"            它的&6力量将会增强&f"
		"          成为一股&a更强大的力量&f"
		"              在&b波涛&f之下"
	]
	quest.31B22DFEE260ACF8.quest_subtitle: "海带？"
	quest.31F4CB70125349AC.quest_desc: ["&f雪貂可以在森林生物群系中找到，有棕色和白色两种变体。这些聪明的小猎手以兔子和鸡为食，而这两种动物恰好也是用来&a驯服 &f和繁殖它们的食物。一旦它们信任你，再次喂食可能会鼓励它们挖掘地面，从而发现一些&a隐藏的东西。"]
	quest.31F4CB70125349AC.quest_subtitle: "&7一位擅长寻找隐藏宝藏的猎手"
	quest.31F4CB70125349AC.title: "&5&l任务： &r&e好奇的雪貂"
	quest.33C62F743793AD10.quest_subtitle: "&7用刀猎杀一只鱿鱼"
	quest.33C62F743793AD10.title: "击杀鱿鱼"
	quest.343145D990B3F2C8.quest_subtitle: "行者斩"
	quest.3445B196ADF88C4C.quest_subtitle: "&7获取一种稀有的终局游戏材料"
	quest.34C82E9027F4A23F.quest_subtitle: "&7烹饪一顿强效的下界餐点"
	quest.35A0A33F6503AEC1.quest_subtitle: "&7用刀获取材料"
	quest.35A40300B28DBA89.quest_desc: ["&f岩浆怪是存在于下界的危险生物。击败它会掉落&a岩浆膏，&f这是一种可用于多种配方的珍贵材料。去猎杀一只，获取这一重要的&a资源吧。"]
	quest.35A40300B28DBA89.quest_subtitle: "&7击败一只岩浆怪"
	quest.35A40300B28DBA89.title: "&5&l任务： &r&e岩浆核心"
	quest.36FAF25CA86AEB33.quest_subtitle: "&7获取一种防御性生物资源"
	quest.37659CC7925D2609.quest_desc: ["&f这个世界充满了各种奇特的&a生物，&f它们各有自己的习性、喜爱的食物和隐藏的用途。有些生物可以成为忠诚的伙伴，有些能帮你收集稀有材料，还有一些只要待在你身边就能提供特殊加成。花些时间观察它们，了解它们的习性，发掘它们能为你的冒险带来的诸多&a秘密 &f吧。"]
	quest.37659CC7925D2609.quest_subtitle: "&7探索这个世界的独特野生动物"
	quest.37659CC7925D2609.title: "&5&l任务： &r&e大大小小的生物"
	quest.37A28765A80E56D3.quest_desc: [
		"    我们还可以建造&6金属栅栏&f"
		"      为了稍微改变一下&b风格&f，"
		"       并让它能&a更好地搭配&f我们的&d房屋&f"
	]
	quest.37A28765A80E56D3.quest_subtitle: "由金属制成？"
	quest.37F423012FB1318B.quest_desc: ["&f门对于任何建筑都至关重要，既能提供通行便利，又能彰显风格。这里有各式各样的设计可供选择，从不同类型的木材到金属，甚至还有现代玻璃门。选择最适合你建筑的一款，为你的&a世界打造一个引人注目的入口吧。"]
	quest.37F423012FB1318B.quest_subtitle: "&7选择完美的入口"
	quest.37F423012FB1318B.title: "&5&l任务： &r&e门"
	quest.3804390AAEE01D24.quest_desc: ["&f村庄不再仅仅是交易场所，而是由独特个体组成的鲜活社区，每个人都有其独特的个性和角色。通过探访&a村庄，&f你可以开始认识这里的居民，了解他们的生活方式，并迈出第一步，融入一种联系更紧密、生活更有意义的模式。寻找一个村庄，开始在其中建立属于你的位置吧。"]
	quest.3804390AAEE01D24.quest_subtitle: "&7探访村庄，结识村民"
	quest.3804390AAEE01D24.title: "&5&l任务：&r&e全新的开始"
	quest.3867455895F38055.quest_desc: ["&f桥墩能为你的桥梁增添深度与真实感，使其看起来更加坚固细致。你可以使用不同类型的木材或石材来制作桥墩，从而匹配任何设计风格。为你的桥梁建造桥墩，同时改善其结构和&a外观。"]
	quest.3867455895F38055.quest_subtitle: "&7加固你的建筑"
	quest.3867455895F38055.title: "&5&l任务：&r&e桥梁桥墩"
	quest.392E0346D6A54B0B.quest_subtitle: "&7使用合适的工具击败守卫者"
	quest.392E0346D6A54B0B.title: "击杀守卫者"
	quest.3AC3892A7B47B6C4.quest_desc: ["&f借助&a航海图，&f你可以在已建成的道路上规划路线，将简单的路径转变为真正的交通网络。路线规划完成后，将其与道路尽头的&a路标&f连接起来，再沿途（包括岔路口）增设更多路标，以扩展你的网络。打开地图即可查看每一条已连接的路径，并在已连接的路标之间即时传送。"]
	quest.3AC3892A7B47B6C4.quest_subtitle: "&7标记你的道路，连接你的目的地"
	quest.3AC3892A7B47B6C4.title: "&5&l任务： &r&e规划路线"
	quest.3C082863111FE304.quest_desc: [
		"            &6雪貂&f出现在"
		"                &a森林生物群系&f中"
		"             有棕色&f和白色&f"
		"                颜色变种"
		"            这些&6聪明的猎手&f"
		"          会捕食&e兔子&f和&e鸡&f"
		"             用来&b繁殖&f它们"
		"            一旦它们&d信任你&f"
		"               再次喂养它们"
		"               就能让它们&b挖掘&f"
		"          并找到一些&6隐藏的东西&f"
	]
	quest.3C082863111FE304.quest_subtitle: "可爱的生物"
	quest.3C082863111FE304.title: "雪貂"
	quest.3C12675B87BF9201.quest_desc: [
		"           我们可以建造新的&6墙壁&f"
		"              它们非常&a完美&f"
		"        适合围绕我们的&d房子&f"
	]
	quest.3C12675B87BF9201.quest_subtitle: "墙壁与墙壁"
	quest.3C9506ED0D2323BF.quest_desc: [
		"    防止我们的&6桥梁&f坍塌"
		"我们可以在桥下放一些&a支撑柱&f"
	]
	quest.3C9506ED0D2323BF.quest_subtitle: "帮助桥梁"
	quest.3D90BC8733F33427.quest_subtitle: "击败疣猪"
	quest.3D90BC8733F33427.title: "疣猪"
	quest.3D9FCD96ADC52EC1.quest_desc: [
		"    拥有&6第二个孩子&f再完美不过了"
		"     这样就能一直拥有一个&a完整的家&f"
		"               并且让你的"
		"       &b传承&f永远保存下去"
		"         成为&6称职的父母&f，并"
		"        成为孩子们的&a榜样&f"
	]
	quest.3D9FCD96ADC52EC1.quest_subtitle: "扩建房屋"
	quest.3D9FCD96ADC52EC1.title: "第二个孩子"
	quest.3F5B8FE2215D1009.quest_desc: [
		"           在这个世界里"
		"               有许多新的&6傀儡&f"
		"               它们能&b帮助我们&f"
		"              它们有&9特殊&f的"
		"             &a能力&f、&c弱点&f"
		"              以及&4优点&f"
		"           由 &e独特材料&f制成"
		"           选择你的 &d伙伴&f"
		"             应对每一个 &6挑战&f"
	]
	quest.3F5B8FE2215D1009.quest_subtitle: "Golems!"
	quest.4042CB099F9221AF.quest_desc: ["&f栅栏门能让你在控制建筑入口的同时，保持统一的设计。它们可以用不同类型的木材制作，与你的栅栏风格相匹配。放置一扇，打造一个像样的 &a入口吧。"]
	quest.4042CB099F9221AF.quest_subtitle: "&7打造实用的入口"
	quest.4042CB099F9221AF.title: "&5&l任务： &r&e栅栏门"
	quest.409AAFA3EDF2C25D.quest_desc: ["&f在跳跃蜘蛛茧附近找到的丝线，可不仅仅是一种奇特的材料。它可以被制成 &a丝绳，&f这是一种比普通绳索更坚固的替代品，在危险情况下要可靠得多。与普通绳索不同，它不仅能用于动物，还能用于 &a怪物 &f或其他敌对生物。"]
	quest.409AAFA3EDF2C25D.quest_subtitle: "&7使用蜘蛛丝实现更牢固的捆绑"
	quest.409AAFA3EDF2C25D.title: "&5&l任务： &r&e比绳索更结实的丝线"
	quest.437164949A4ACDD5.quest_desc: [
		"       &f我们的 &6盔甲架 &f已经"
		"       &a改进&f了！放置它们之后，"
		"       按下 &bShift + 右键点击"
		"          &f即可更改 &6姿势&f，装备"
		"            &e手持物品&f，戴上 &e帽子&f，"
		"                &f以及更多功能！"
	]
	quest.437164949A4ACDD5.quest_subtitle: "更改姿势"
	quest.448D06002B449509.quest_desc: ["&f由蜂巢和线制成，&a蜡烛傀儡 &f乍看之下可能人畜无害，但它却能成为一位出乎意料的实用小卫士。放置后，你可以通过右键点击来唤醒它，命令它坐下，甚至可以用打火石点燃它，让它开始向附近的敌人发射 &a火球 &f。如果它受到伤害，使用一些蜂巢就能帮助修复它，让它的火焰继续燃烧。"]
	quest.448D06002B449509.quest_subtitle: "&7一个脾气火爆的小守护者"
	quest.448D06002B449509.title: "&5&l任务： &r&e蜡烛傀儡"
	quest.466167B6BFE855EF.quest_desc: ["&f随着你的家园逐渐充满生机，你的家庭也在不断壮大。迎来第二个孩子能让你的家庭更加稳固，营造出更具活力和生气的氛围。有了更多的欢声笑语、更多的故事和更多共享的时刻，你的家将变得真正 &a特别。 &f扩展你的家庭，拥抱它带来的欢乐吧。"]
	quest.466167B6BFE855EF.quest_subtitle: "&7扩展你的家庭"
	quest.466167B6BFE855EF.title: "&5&l任务： &r&e不断壮大的家庭"
	quest.46CE6E8DEED69490.quest_desc: ["&f开始测量时，先右键点击一个方块以设置第一个点，然后移动到另一个位置再次右键点击即可完成测量。这有助于你在修建路径、墙壁或进行大型建造时把控间距。如果你想移除已标记的距离，请手持 &a卷尺 &f并按住 &aShift &f键，然后右键点击地面。"]
	quest.46CE6E8DEED69490.quest_subtitle: "&7使用卷尺进行测量和清除测量值"
	quest.46CE6E8DEED69490.title: "&5&l任务： &r&e标记距离"
	quest.46FA8E51BBFED6C3.quest_desc: ["&f椅子对于让你的室内空间显得完整且有生活气息至关重要。市面上有许多类型的椅子可供选择，包括木椅和不同颜色的软包椅。选择最适合你建筑风格的款式，为你的空间增添一份 &a舒适 &f感。"]
	quest.46FA8E51BBFED6C3.quest_subtitle: "&7为你的室内空间增添舒适感"
	quest.46FA8E51BBFED6C3.title: "&5&l任务： &r&e椅子"
	quest.4859EA65A5B60682.quest_desc: [
		"     一个 &d像样的厨房&f 始于一个"
		"            &6可靠的加热源&f"
		"  炉灶&f 提供 &c不灭的火焰"
		"         对你的 &a餐食&f 至关重要"
		"  建造一个 &b完整厨房&f 布局的重要一步"
		"          &6完整厨房&f 布局"
		"     &b制作&f一个炉灶，即可解锁"
		"          &a未来的烹饪食谱&f"
	]
	quest.4859EA65A5B60682.quest_subtitle: "布置炉灶"
	quest.48973A19902EB558.quest_desc: ["&f格栅是一种简单而优雅的方式来装饰你的建筑。虽然它们的设计相似，但有多种木材可供选择，以匹配你的风格。你还可以攀爬它们，使其兼具装饰性和功能性。放置格栅，让你的 &a结构 更加精美。"]
	quest.48973A19902EB558.quest_subtitle: "&7以时尚风格进行装饰和攀爬"
	quest.48973A19902EB558.title: "&5&l任务： &r&e格栅"
	quest.49015376942E36BA.quest_desc: ["&f每一次成功的发现都会发出轻微的声响，让你知道信息已安全&a保存。&f随着你的旅程继续，这本日志将成为关于生物、首领和实用资源的宝贵知识来源。按下 &aB &f打开指南，回顾你已经学到的内容。"]
	quest.49015376942E36BA.quest_subtitle: "&7回顾你发现的一切"
	quest.49015376942E36BA.title: "&5&l任务：&r&e你的个人日志"
	quest.49B7E3494B102E9A.quest_subtitle: "&7制作一件独特物品"
	quest.49EFF193E01254D8.quest_subtitle: "&7将其加工成宝贵资源"
	quest.4AC74F199D37A120.quest_desc: [
		" &6烹饪锅&f是许多"
		"     高级配方的核心，&f对于"
		"          准备合适的餐点至关重要&f"
		"  将它放置在 &e烤架&f或 &c热源上"
		"     然后与其互动以添加 &a食材"
		"            用于制作 &b汤和炖菜&f"
		"       拥有 &6种类繁多的菜肴"
		"   这件工具将极大地拓展你的"
		"               &a烹饪选择&f"
		"        &b现在就制作&f一口锅，开始"
		"  尝试新的组合吧"
		"               在你的厨房里"
	]
	quest.4AC74F199D37A120.quest_subtitle: "一口充满无限可能的锅"
	quest.4B50D5493DE7E8AD.quest_subtitle: "&7创造一顿完整而营养的餐点"
	quest.4BFB22E2690C9C7E.quest_desc: [
		"        &a抽屉&f unfortunately"
		" 并非我们熟悉的老朋友 &e抽屉们&f"
		" 但它却 &6非常适合&f用来 &d装饰&f"
	]
	quest.4BFB22E2690C9C7E.quest_subtitle: "紧凑型抽屉？不！"
	quest.4CBE85F01546896C.quest_subtitle: "&7精炼恶魂材料"
	quest.4DB61D972DFCACBC.quest_desc: [
		"  你可以用 &e礼物&f赢得某人的好感"
		"然而每个人都有自己独特的 &6品味&f"
		"  并非所有人都喜欢 &a花朵&f或 &6矿石&f"
		"       发现他们喜欢什么，然后"
		"         &b增进彼此的信任&f"
		"              巩固你的 &d感情关系&f"
		"         选择一件 &a特别的礼物&f"
	]
	quest.4DB61D972DFCACBC.quest_subtitle: "完美的礼物"
	quest.4DB61D972DFCACBC.title: "征服"
	quest.4ED379396081F4AC.quest_desc: [
		"     在 &6最受欢迎的日子之一&f！"
		"    我们可以制作 &a各种装饰品&f"
		"      并营造出一个 &c充满&0恐惧&f的场景"
	]
	quest.4ED379396081F4AC.quest_subtitle: "不给糖就捣蛋？"
	quest.4F8789AC6646B9A3.quest_subtitle: "&7准备一道酿馅鱼"
	quest.4F8789AC6646B9A3.title: "击杀填充鳕鱼"
	quest.4FC63ED667016EF4.quest_desc: ["&f有些感情会超越单纯的友谊，开始共同塑造未来。通过共度时光、相互扶持并加深彼此的联系，你们可以为真正的 &a家庭 &f打下基础。这份羁绊代表着信任、承诺，以及一段更伟大关系的开端。找到那个特别的人，迈出 &a共同生活的第一步吧。"]
	quest.4FC63ED667016EF4.quest_subtitle: "&7与那个特别的人建立家庭般的羁绊"
	quest.4FC63ED667016EF4.title: "&5&l任务： &r&e共筑未来"
	quest.4FCE9DF19940D6F8.quest_desc: ["&f在沼泽深处，有时会发现 &a史莱姆傀儡 &f正在保卫它潮湿的家园，抵御不速之客。它的身体看起来柔软无害，但当怪物靠得太近时，它便是一位称职的守护者。如果它在战斗中受伤，几个 &a史莱姆球 &f就能帮助它恢复状态，继续战斗。"]
	quest.4FCE9DF19940D6F8.quest_subtitle: "&7一位身体柔软的沼泽守护者"
	quest.4FCE9DF19940D6F8.title: "&5&l任务： &r&e史莱姆傀儡"
	quest.50D2295278A14FAA.quest_desc: [
		"      &6画布&f是一种&6实用的材料&f"
		"     它可以替代&e羊毛&f和&e皮革&f"
		"          即使在旅途的&b早期阶段&f，它也很有价值"
		"      &aEarly stages&f of your journey"
		"        为你的家制作&6告示牌&f、&6榻榻米&f和"
		"           &6地毯&f"
		"    为你所有的&a建筑&f增添一抹洁净而美观的气息&f"
		"              To all your &bbuilds&f"
		"    让你的&e画布&f随时待命，以应对所有"
		"              &b未来的项目&f！"
	]
	quest.50D2295278A14FAA.quest_subtitle: "新材料"
	quest.516A8A7788D24BFD.quest_desc: ["&f在煤矿脉附近，你可能会发现体型虽小但十分危险的&a煤炭傀儡。&f它的生命值很低，但如果用打火石和铁器点燃它，或让它走过火焰，它就会冲向附近的敌人，并用火焰攻击将其烧灼。这最后一击威力强大，但傀儡在此过程中会&a牺牲自己 &f。"]
	quest.516A8A7788D24BFD.quest_subtitle: "&7隐藏在矿石附近的一抹脆弱火花"
	quest.516A8A7788D24BFD.title: "&5&l任务： &r&e煤炭傀儡"
	quest.52C8A6F174BD4813.quest_desc: ["&f锦鲤可以呈现出多种绚丽的颜色变化，为池塘和水道带来一抹宁静。你可以用&a水桶 &f将它们捞起，从而轻松地将它们运输并展示在任何你喜欢的地方。待在&a锦鲤 &f附近还会为你带来“幸运”效果，这让它们比最初看起来更有用。"]
	quest.52C8A6F174BD4813.quest_subtitle: "&7捕捉一条锦鲤，享受它带来的好运"
	quest.52C8A6F174BD4813.title: "&5&l任务：&r&e水下色彩"
	quest.534DF86CB652852D.quest_desc: ["&f&a稻草人&f可以在村庄中自然生成，但你也可以亲手制作一个，让它成为你专属的农田守护者。这些温和的守卫会待在作物附近，看护着田地，甚至能防止你跳上农田时对耕地造成破坏。你可以用&a小麦&f来治疗它们，对于任何正在发展的定居点来说，它们都是简单而又十分有用的伙伴。"]
	quest.534DF86CB652852D.quest_subtitle: "&7田间的安静守护者"
	quest.534DF86CB652852D.title: "&5&l任务：&r&e稻草人"
	quest.53524B6223865098.quest_desc: [
		"          &6木桶傀儡&f是"
		"        &a一种和平的&f村庄生物"
		"         它会&b藏匿&f在自己的&6木桶&f里"
		"         当它&c害怕&f或&9睡觉&f时"
		"     会对&b投射物&f产生&4免疫&f效果"
		"            并且拥有&a高防御力&f"
		"            用&e木板&f来&b修复&f它"
		"             给它&2绿宝石&f"
		"            就能获得有用的物品&f"
	]
	quest.53524B6223865098.quest_subtitle: "Armazen?"
	quest.54A245D79DC8504A.quest_desc: [
		"     在&6海洋&f中，你可能会发现"
		"          奇特的&a海兔&f"
		"        这是一种无法被"
		"                驯服&f或繁殖的生物"
		"   但它能带来一些&d真正特别的东西"
		"              它能产出&a史莱姆&f"
		"         可以用"
		"                 &b玻璃瓶&f来收集"
		"        将&e4个装满的瓶子</c1>组合起来"
		"       你就能制作一个&a史莱姆块&f"
		"         这个方块可以&b攀爬"
		"            并穿过&f"
		"         它&d非常不同&f，与"
		"        你已经熟悉的史莱姆不同"
	]
	quest.54A245D79DC8504A.quest_subtitle: "不同的史莱姆"
	quest.54A245D79DC8504A.title: "海兔"
	quest.5509A42A81F07082.quest_subtitle: "&7准备并切一份甜点"
	quest.55785A828D588FC1.quest_desc: [
		"   当你开始&d在村庄里生活&f时"
		"         并进行&e各种交易&f"
		" 你就能影响&6村庄经济&f"
		"         成为一名&a商人&f是"
		"  赢得&b尊重与信任&f的好方法"
	]
	quest.55785A828D588FC1.quest_subtitle: "开始经商"
	quest.55785A828D588FC1.title: "商人"
	quest.55B096952C7CAE11.quest_desc: [
		"            &6百叶窗&f是一种&a窗帘&f"
		"               用于我们的&d窗户&f"
	]
	quest.55B096952C7CAE11.quest_subtitle: "窗帘"
	quest.55B096952C7CAE11.title: "百叶窗"
	quest.562DEEA407562B29.quest_subtitle: "&7准备一道简单的辣味菜肴"
	quest.56426D9DB5C6432F.quest_desc: [
		" 在&c下界&f的&c深红森林中"
		"   你会发现一种&a易挥发植物&f，它"
		"           被称为&6子弹辣椒&f"
		" 靠得太近会使其&c爆炸"
		"   因此你必须极其"
		"   &b小心&f并&6谨慎地用&e刀处理"
		" 你可以&b安全地收获&f并加工"
		"    它以获得许多&a有用的材料&f"
		"    今天就获取一个&6子弹辣椒&f，"
		"        并学习如何与这种"
		"&e危险的食材&f一起烹饪你的食谱"
	]
	quest.56426D9DB5C6432F.quest_subtitle: "&7处理一种危险的下界食材"
	quest.5647319273ED4229.quest_desc: ["&f穿越这个世界会变得更加轻松，但前提是愿意先改造这片土地。通过在重要地点之间修建合适的&a道路&f，你可以打造出可靠的路线，让探索与精心规划都能获得回报。在实现快速旅行之前，请确保你的路径畅通无阻，目的地也值得连接。"]
	quest.5647319273ED4229.quest_subtitle: "&7快速旅行始于一条修筑良好的道路"
	quest.5647319273ED4229.title: "&5&l任务：&r&e帝国的道路"
	quest.568D6083936BBD12.quest_desc: [
		"         &f我们需要&6升级&f我们的"
		"            &e工具，才能"
		"               开采更坚固的&b矿石"
		"                     &a！&f"
	]
	quest.568D6083936BBD12.quest_subtitle: "改进资源"
	quest.568D6083936BBD12.title: "石制镐"
	quest.57CB5E5A892282EA.quest_subtitle: "包裹"
	quest.581FF6B8199A8037.quest_desc: ["&f&a蜻蜓翅膀 &f由蜻蜓掉落，起初或许看似无用，但其价值远非普通残骸可比。这对精巧的翅膀是驯服&a跳跃蜘蛛的关键，能将一种好奇的小生物变成忠诚的守护者。每找到一片翅膀都要妥善保存，因为它们的可能比外表更有价值。"]
	quest.581FF6B8199A8037.quest_subtitle: "&7蜻蜓翅膀另有妙用"
	quest.581FF6B8199A8037.title: "&5&l任务：&r&e切勿丢弃这些物品"
	quest.585B7AAEAD1275E1.quest_desc: [
		"          我们可以建造新的&6栅栏&f"
		"           来美化我们的&d房屋&f"
		"        有了这些&a不同的栅栏&f"
	]
	quest.585B7AAEAD1275E1.quest_subtitle: "新栅栏"
	quest.5911226A2E56BEE0.quest_desc: [
		"     这张&6桌子&f非常奇特，"
		"   有了它，我们就能 &b移除附魔&f"
		"           从 &e物品&f上移除，并转移"
		"               到一本 &e书&f中。"
		"           它的 &a潜力&f令人惊叹！"
	]
	quest.5911226A2E56BEE0.quest_subtitle: "附魔解除"
	quest.5A0E59768910AF49.quest_desc: [
		"         由 4 块 &f"
		"                &0远古残骸&f"
		"           和一个 &e雕刻南瓜&f锻造而成"
		"        &6下界合金傀儡&f是"
		"      &a最强大的伙伴&f之一"
		"         你可以骑上它&f并跳跃&f"
		"       发动一次 &c毁灭性的重击&f"
		"  但它的 &6真正力量&f来自 &4熔岩&f"
		"          给它喂一个 &e熔岩桶&f"
		"       按下 &bR&f 释放 &c火焰&f"
		"     它们会 &b追击&f你的敌人&f"
		"          下雨时要小心&f！"
		"         携带熔岩会伤害它&f"
	]
	quest.5A0E59768910AF49.quest_subtitle: "WOW!"
	quest.5A49C989B335857D.quest_desc: ["&f&a陶土傀儡 &f可以在荒地自然生成，但也可以用黏土在工作台手工合成。要唤醒它，将它放在熔岩或篝火等热源旁边，让温暖赋予它生命。你可以给它一株仙人掌或枯灌木来增强它的攻击力，如果之后想去除那些尖刺，用一把 &a剪刀 &f就能搞定。"]
	quest.5A49C989B335857D.quest_subtitle: "&7被热量唤醒的沙漠守卫者"
	quest.5A49C989B335857D.title: "&5&l任务： &r&e陶土傀儡"
	quest.5A5B839A38BD0A5B.quest_desc: ["&f有些情谊早已超越了简单的友谊。通过共度时光、分享点滴并展现真诚的关怀，一段关系可以加深为真正有意义的羁绊。与村民达到 &a200 颗爱心 &f意味着你找到了一位 &a真正的朋友，&f一个完全信任你、会永远陪伴在你身边的人。"]
	quest.5A5B839A38BD0A5B.quest_subtitle: "&7与村民达到 200 颗爱心"
	quest.5A5B839A38BD0A5B.title: "&5&l任务： &r&e真正的朋友"
	quest.5A6430C9EC732243.quest_subtitle: "&7高效处理肉类"
	quest.5B01DE3EC860F872.quest_desc: ["&f&a木桶傀儡 &f是一种和平生物，自然生成于村庄中，通常在被靠近前都独来独往。当受到惊吓或准备入睡时，它会躲进自己的木桶身体里，大幅提升防御力并免疫远程攻击。它可以用木板进行修复，如果你给它 &a绿宝石，&f它可能会反过来扔给你一些有用的物品。"]
	quest.5B01DE3EC860F872.quest_subtitle: "&7一位防御坚固、性格害羞的村庄商人"
	quest.5B01DE3EC860F872.title: "&5&l任务： &r&e木桶傀儡"
	quest.5B083E5EAC7E31D9.quest_desc: ["&f毛绒玩具是可爱的装饰品，能为你的建筑增添温暖与个性。它们被设计成小动物造型，非常适合放在卧室和温馨的空间里。而且它们的制作也很简单，是装点你的 &a室内空间的便捷之选。"]
	quest.5B083E5EAC7E31D9.quest_subtitle: "&7为你的室内空间增添魅力"
	quest.5B083E5EAC7E31D9.title: "&5&l任务： &r&e毛绒玩具"
	quest.5B91911C7AEF8FC8.quest_desc: [
		"               找到的&a丝绸&f"
		"           靠近 &6蜘蛛茧&f"
		"            它可不仅仅是一种"
		"              &a奇特的材料&f"
		"          它可以被制作成"
		"                 一根丝绳&f"
		"            比普通的铅绳更&b坚固&f"
		"                一根 &e普通铅绳&f"
		"           而且在 &b危险情况下&f要可靠得多"
		"          在 &c危险情况下&f"
		"         它不仅可以用在 &a动物&f身上"
		"            也可以用在 &4怪物&f身上"
		"       以及其他 &b敌对生物&f上"
	]
	quest.5B91911C7AEF8FC8.quest_subtitle: "抓得更牢"
	quest.5CFD57DFE9C712DD.quest_desc: [
		"        嗯……&6门&f本来就存在"
		"   不过我们可以创造 &a新的门&f"
		"     我想我 &b无需解释"
		"             门是用来做什么的了"
	]
	quest.5CFD57DFE9C712DD.quest_subtitle: "门？"
	quest.5D5452B5149E60AF.quest_subtitle: "&7准备一道风味十足的辛辣菜肴"
	quest.5EBF76CDBC3F6AF2.quest_desc: ["&f有些食谱会使用来自下界生物的特殊食材。&a岩石汤 &f就是用 &a行军蛋 &f烹制而成的，成了一道奇特却富有营养的菜肴。快烹饪它，在 &a烹饪中发现新的可能吧。"]
	quest.5EBF76CDBC3F6AF2.quest_subtitle: "&7在烹饪中使用行军资源"
	quest.5EBF76CDBC3F6AF2.title: "&5&l任务：&r&e岩石汤"
	quest.5F51B2D44A75C0D8.quest_subtitle: "MEcDonaLdS"
	quest.5FF9D6AC79D484BF.quest_desc: [
		"            &6陶土傀儡&f"
		"             出现在 &4荒地&f中"
		"            它可以用 &b黏土&f在 <c3>工作台<c4>上制作"
		"             要 &e唤醒它&f，需将它放置在"
		"             &d热源&f或 <c3>熔岩<c4>附近"
		"            给它 &c仙人掌&f或 &c灌木&f"
		"            给它 &e仙人掌&f 或 &e灌木&f"
		"              以 &b增强其攻击&f"
		"              并使用 &e剪刀&f来"
		"              &4移除尖刺&f"
	]
	quest.5FF9D6AC79D484BF.quest_subtitle: "陶土？"
	quest.602F67801FE0E7BE.quest_desc: ["&f长途旅行、建筑项目和深度探险常常会让你的背包在太短的时间内就装满。一个 &a背包 &f能让你携带额外的方块、食物、工具和珍贵战利品，让每一次冒险都更加舒适。制作或获取一个 &a背包 &f，并在旅途中随身携带。"]
	quest.602F67801FE0E7BE.quest_subtitle: "&7无论去往何处都能携带更多物资"
	quest.602F67801FE0E7BE.title: "&5&l任务： &r&e为旅程打包"
	quest.60B1313CEFC3C25C.quest_desc: ["&f窗户对于为你的建筑增添生机与光明至关重要。有许多不同设计可供选择，它们由不同类型的木材和玻璃制成，让你可以搭配任何风格。放置窗户，同时改善你的 &a建筑的外观和光照。"]
	quest.60B1313CEFC3C25C.quest_subtitle: "&7为你的建筑带来光明"
	quest.60B1313CEFC3C25C.title: "&5&l任务： &r&e窗户"
	quest.61483FCCEA6B9519.quest_subtitle: "&7收集一种稀有原料"
	quest.624487455046F74A.quest_desc: [
		"    就连 &a南瓜&f也 &6各不相同&f！"
		"  我们有 &e多种类型的南瓜&f"
		" 而且它们可以用于 &b许多用途&f"
	]
	quest.624487455046F74A.quest_subtitle: "不同的南瓜"
	quest.6296E5D06C37A804.quest_subtitle: "&7处理原料以提升效率"
	quest.63D483D66FD6228E.quest_desc: ["&f时光流逝，世界在你的故事之外不断成长。见证下一代建立他们自己的家庭，是你所建立和培育的一切的见证。成为&a祖父母&f标志着一个真正传承的诞生，你的影响力将通过后来者得以延续。"]
	quest.63D483D66FD6228E.quest_subtitle: "&7成为祖父母"
	quest.63D483D66FD6228E.title: "&5&l任务： &r&e不朽的传承"
	quest.63D5F281E340957C.quest_desc: ["&f盔甲架远不止是展示装备的简单架子。通过适当的调整，你可以解锁&a手臂，&f旋转不同的身体部位，并从多种内置的&a姿势 &f中进行选择，从而创造出更具动态感的装饰。尽情实验你的盔甲架，为你的基地增添一抹更生动、更个性化的风采。"]
	quest.63D5F281E340957C.quest_subtitle: "&7让你的盔甲架焕发生机"
	quest.63D5F281E340957C.title: "&5&l任务： &r&e装饰性姿势"
	quest.64348DF4AC0995FA.quest_subtitle: "&7烹饪烤触手"
	quest.6450C5225396BF07.quest_desc: [
		"   当你的&d孩子&f&6逐渐长大成熟&f"
		"          他们就可以组建一个&d家庭"
		"             并拥有&6孩子&f"
		"  你需要成为一名&a曾祖父/曾祖母"
		"             成为你&e孙辈&f的长辈"
		"    正如你曾是一位&b伟大的父亲&f"
	]
	quest.6450C5225396BF07.quest_subtitle: "你的传承……"
	quest.6450C5225396BF07.title: "成为祖母"
	quest.64F3E559E01F16E2.quest_desc: [
		"            &6蜻蜓&f是一种"
		"           完全&a和平&f的"
		"              且&d忠诚的飞行&f"
		"                  &4伙伴&f"
		"        需要许多&c蜘蛛眼&f"
		"                要 &b驯服&f"
		"             为其装备 &6盔甲&f"
		"         材质可以是铁、&e金&f或 &b钻石&f"
		"         它会掉落 &e蜻蜓翅膀&f"
		"             这是一种 &a珍贵的材料&f"
		"        绝不能 &c浪费&f"
	]
	quest.64F3E559E01F16E2.quest_subtitle: "龙！！！"
	quest.661A1C0CD93EFEF9.quest_desc: [
		"                 我们可以制作"
		"      &e各种类型的楼梯&f"
		"    为我们的 &d房屋&f建造 &6新的房间&f"
	]
	quest.661A1C0CD93EFEF9.quest_subtitle: "让生活更上一层楼"
	quest.665EEF13BC85EF48.quest_desc: ["&f与他人共处，不仅仅是擦肩而过。通过交谈、帮助和赠送贴心的礼物，你可以逐渐与周围的人建立起牢固的 &a友谊 &f。与村民达成 &a50 颗爱心 &f，表明你已不再是陌生人，而是他们真正可以信赖的人。加强你们之间的联系，成为社区的一员吧。"]
	quest.665EEF13BC85EF48.quest_subtitle: "&7与村民达成 50 颗爱心"
	quest.665EEF13BC85EF48.title: "&5&l任务： &r&e建立信任"
	quest.66D7DCAD8CDA6503.quest_desc: [
		" 有了合适的 &a食材&f和 &a厨具"
		"         就能烹制 &6完整的餐点&f"
		"   &e鸡蛋三明治&f、&9鸡肉三明治"
		" &e汉堡&f和 &e卷饼&f都 &b很容易制作&f"
		" 这些选择能提供 &d更好的营养"
		"     为你的旅程提供补给"
		"      尝试 &a不同的组合&f，"
		"       打造专属于你的 &6餐点收藏&f"
	]
	quest.66D7DCAD8CDA6503.quest_subtitle: "简易餐点"
	quest.66D7DCAD8CDA6503.title: "牛肉末"
	quest.676F4D799A580B52.quest_desc: ["&f&a蜻蜓 &f是一种完全和平的生物，只要你愿意投入足够的精力，它就能成为忠诚的飞行伙伴。驯服它需要大量的蜘蛛眼，但一旦成为朋友，就可以用铁、金或钻石盔甲来保护它。它还会掉落 &a蜻蜓翅膀，&f这是一种宝贵的材料，绝不能浪费。"]
	quest.676F4D799A580B52.quest_subtitle: "&7拥有实用翅膀的和平伙伴"
	quest.676F4D799A580B52.title: "&5&l任务： &r&e一只温顺的蜻蜓"
	quest.6808D4C614A122FE.quest_desc: ["&f桌子是一种简单却必不可少的家具。虽然它们都采用同一种设计，但可以使用不同类型的木材制作，从而适应多种风格。摆放一张桌子，用这件 versatile 且 &a实用 &f的家具来完善你的室内装饰吧。"]
	quest.6808D4C614A122FE.quest_subtitle: "&7打造多功能的室内空间"
	quest.6808D4C614A122FE.title: "&5&l任务： &r&e桌子"
	quest.685317CDC1C8F9E0.quest_desc: ["&f&a豆潜水母 &f是一种和平的海洋生物，无法被驯服或繁殖，但它的存在依然可能非常有用。当你在潜水时靠近它，它会在你的头部周围形成一个小小的气泡，帮助你呼吸，避免溺水。在长时间的 &a潜水期间，留意这位奇特的小盟友吧。"]
	quest.685317CDC1C8F9E0.quest_subtitle: "&7一种能在水下帮助你的温和生物"
	quest.685317CDC1C8F9E0.title: "&5&l任务： &r&e深海的呼吸"
	quest.68779D272A01D70D.quest_subtitle: "&7准备一道简单的串烧菜肴"
	quest.68EA4A1B532F2372.quest_subtitle: "&7将稀有食材与蔬菜结合"
	quest.69C6D2C07946FC50.quest_desc: ["&f栅栏是定义和装饰建筑的一种简单而重要的方式。有多种样式可供选择，它们由不同类型的木材制成，包括带铁丝网和灌木变体。选择最适合你设计的样式，塑造你的&a周边环境。"]
	quest.69C6D2C07946FC50.quest_subtitle: "&7以时尚风格定义你的空间"
	quest.69C6D2C07946FC50.title: "&5&l任务： &r&e木制栅栏"
	quest.6A4731BDDF435B6B.quest_desc: [
		"            我们可以建造&6窗户&f"
		"       并把它们安装在我们的&d房屋&f里"
		"     &a正好&f可以引入一些&b空气&f"
	]
	quest.6A4731BDDF435B6B.quest_subtitle: "打开与关闭"
	quest.6AD1F4E96802964B.quest_desc: ["&f借助合适的工具，一些悬崖、墙壁和高大建筑会更容易征服。&a抓钩 &f可以让你将绳索发射到高处，直到它勾住某个表面，然后你就能快速而精准地把自己拉上去。它非常适合到达高处、攀爬建筑，甚至在使用&a鞘翅飞行前获得动力。"]
	quest.6AD1F4E96802964B.quest_subtitle: "&7用抓钩攀得更高"
	quest.6AD1F4E96802964B.title: "&5&l任务： &r&e抵达不可能之地"
	quest.6D4E5DAAF174027D.quest_desc: ["&f在桦木森林中，你可能会遇到奇特的 &a蜂蜜傀儡，&f它是一种活生生的蜂巢状守护者，虽然甜美，但目的却十分危险。蜜蜂可以生活在它的体内，帮助它生产蜂蜜；同时它也有几率向敌人发射 &a蜂蜜滴落物，&f造成伤害并使其减速。如果它受到伤害，你可以用蜂蜜瓶来修复它，让这位黏糊糊的守护者保持战斗状态。"]
	quest.6D4E5DAAF174027D.quest_subtitle: "&7来自桦木森林的黏性防御者"
	quest.6D4E5DAAF174027D.title: "&5&l任务： &r&e蜂蜜傀儡"
	quest.6DA62CFD96EBE7E7.quest_subtitle: "BACON"
	quest.6DB14B7B05E094B1.quest_desc: ["&f从水獭那里收集到的珍珠可以制成 &a珍珠项链，&f对于任何需要在水下活动的人来说，这都是一个很有用的饰品。即使是第一版也能加快游泳速度，并缩小溺亡者的侦测范围，让水下探索安全得多。通过加入更多 &a珍珠进行升级，&f你可以增强这些效果，让自己在水下活动得更加自如。"]
	quest.6DB14B7B05E094B1.quest_subtitle: "&7制作一条项链，让游泳更安全"
	quest.6DB14B7B05E094B1.title: "&5&l任务： &r&e深海珍珠"
	quest.6E91229A6C841374.quest_desc: ["&f木制抽屉是现代室内装饰的绝佳补充，能完美融入卧室和起居空间。除了装饰作用，它们还能像箱子一样存放物品，兼具美观与实用。放置一个抽屉，提升你 &a室内空间的美观度和功能性吧。"]
	quest.6E91229A6C841374.quest_subtitle: "&7用功能性储物装饰"
	quest.6E91229A6C841374.title: "&5&l任务： &r&e木制抽屉"
	quest.6F339B3C7EEB74A8.quest_desc: [
		"      许多 &6有用的食材&f都会生长"
		"        自然地遍布 &d世界各地&f"
		"           &e卷心菜&f和 &e甜菜根&f"
		"     可以在 &b海滩&f附近找到"
		"        &e洋葱&f和 &e胡萝卜&f出现在"
		"             &a平原&f和 &d森林&f中"
		"     &c番茄&f生长在 &9热带草原&f，而"
		"            &e马铃薯&f则生长在 &6山脉&f中"
		"         &a水稻&f生长在 &2沼泽&f中，且"
		"     必须 &b在水下一个方块处&f"
		"         &e番茄&f可以使用 &6绳索&f"
		"      来继续 &c向上攀爬&f"
		"        请睁大双眼，"
		"   收集你找到的每一种 &e食材&f！"
	]
	quest.6F339B3C7EEB74A8.quest_subtitle: "天然食材"
	quest.701362991EEAB76F.quest_desc: ["&f假日季为你的建筑带来了各式各样的装饰品。从发光的树木和拐杖糖到礼盒、红袜子和发光的挂饰，你可以将任何空间变成一个节日氛围浓厚的环境。将它们放置好，让你的世界充满真正的 &a节日精神。"]
	quest.701362991EEAB76F.quest_subtitle: "&7为假日装饰"
	quest.701362991EEAB76F.title: "&5&l任务： &r&e圣诞装饰"
	quest.701529998252BB1A.quest_desc: [
		"        通过赢得 &b村民&f的"
		"                全体 &6信任&f"
		"        你就可以成为 &6村长&f"
		"     并对整个 &a村庄&f负责"
		"   你可以制定 &a规则&f"
		"     决定村庄如何运作"
		"    你甚至可以评论他人的"
		"                &d人际关系&f！"
		"              成为一位真正的&a领袖&f"
	]
	quest.701529998252BB1A.quest_subtitle: "人民的领袖"
	quest.701529998252BB1A.title: "市长"
	quest.70BFAFF0AF98D825.quest_subtitle: "&7获取一种稀有的海洋食材"
	quest.70E9591C5B8386D0.quest_desc: [
		"        &6煎锅&f是另一种"
		"       可以放置在任何"
		"      &c热源&f上的必备厨具"
		"               它能让你"
		"         &b烹饪各种食材"
		"      直接烹饪，非常适合用来"
		"                  &a快速制作餐点&f"
		"            虽然它一次只能容纳"
		"              &e一组食物"
		"            但它非常适合用于"
		"             &6简单的烹饪&f"
		"  &b制作&f一个煎锅，为你的厨房再添一个"
		"   实用的&a工作台&f"
	]
	quest.70E9591C5B8386D0.quest_subtitle: "加热平底锅"
	quest.723C4C8954231D51.quest_desc: [
		"     &9友谊&f是我们生活中&6非常重要&f"
		"      的一部分，这一点"
		"             在这里也丝毫未变！"
		"         有了&9友谊&f，你就拥有了"
		"             &a尊重与信任&f"
		"  尊重不仅仅是"
		"共同生活，还要赠送&e礼物&f、进行&e交易&f"
		"         当达到&c50颗爱心</c1>后，"
		"        &d村民&f就会将你视为"
		"                 &b好朋友&f"
	]
	quest.723C4C8954231D51.quest_subtitle: "结交新朋友"
	quest.723C4C8954231D51.title: "朋友"
	quest.7335A0A6A74F610C.quest_subtitle: "&7烹饪一份下界肉类食材"
	quest.739B2997094F1E8F.quest_desc: [
		"            &b海洋&f提供了"
		"      &a多种独特的食材</c1>"
		" 可用于制作&6营养丰富的"
		"             以及健康的餐点&f"
		"            例如以下生物"
		"         &e鱿鱼&f、&6守卫者&f和&e鳕鱼"
		"       提供&a宝贵的资源"
		"  这些资源可以制成&b美味的菜肴&f"
		"        &b探索水域&f，收集"
		"  这些食材，并用"
		"          &d各种海鲜餐点&f来扩充你的"
		"       &a烹饪技能&f"
	]
	quest.739B2997094F1E8F.quest_subtitle: "海洋生物"
	quest.73D084918A0F81A4.quest_desc: ["&f一些下界食材可用于制作独特的食谱。&a岩浆蛋糕 &f将岩浆膏融入其中，制成一种能提供强大饱腹感的独特甜点。准备好它，探索更高级的&a餐点吧。"]
	quest.73D084918A0F81A4.quest_subtitle: "&7准备一份火热的甜点"
	quest.73D084918A0F81A4.title: "&5&l任务：&r&e岩浆蛋糕"
	quest.74C6C49A972D0A78.quest_desc: ["&f这些小小的&a跳跃蜘蛛 &f比它们初看起来要友好得多，并且能成为出人意料的得力伙伴。它们通常出现在茧附近，茧中可能包含随机的战利品和蜘蛛丝，而喂食它们&a蜻蜓翅膀 &f即可将它们驯服。一旦对你忠心，它们就会在你身边时为你抵御敌人。"]
	quest.74C6C49A972D0A78.quest_subtitle: "&7与跳跃蜘蛛交朋友"
	quest.74C6C49A972D0A78.title: "&5&l任务：&r&e小小的守卫者"
	quest.7517A375EB423AA8.quest_desc: ["&f并非这个世界上的所有守卫都由铁铸成。在不同的生物群系和材料中隐藏着许多不寻常的 &a魔像，&f有些由你亲手打造，有些则在大地上游荡。它们各有千秋，拥有独特的优势、特殊能力和偏爱的修复材料，因此要了解它们的运作方式，并为各种情况选择 &a合适的伙伴 &f。"]
	quest.7517A375EB423AA8.quest_subtitle: "&7认识这个世界的奇特魔像"
	quest.7517A375EB423AA8.title: "&5&l任务： &r&e忠实的助手"
	quest.753E652470CB0D63.quest_desc: ["&f屋顶在建筑的整体外观中扮演着重要角色。屋顶可以用多种材料建造，例如不同类型的木材、石头，甚至是玻璃。玻璃屋顶能让阳光透入，非常适合封闭空间。建造一个，为你的 &a建筑确定风格吧。"]
	quest.753E652470CB0D63.quest_subtitle: "&7塑造你建筑的顶部"
	quest.753E652470CB0D63.title: "&5&l任务： &r&e屋顶"
	quest.75474F2A862FE517.quest_desc: [
		"       我们可以使用 &6钩爪&f"
		"                来发射 &a蛛网&f"
		"          并 &b钩住&f &e树木&f、"
		"             &e木材&f以及 &a更多东西&f"
		"                 &b移动&f起来"
		"              要 &b快得多&f"
	]
	quest.75474F2A862FE517.quest_subtitle: "就像蜘蛛侠一样"
	quest.7640556580D163A6.quest_desc: ["&f丛林深处栖息着&a小熊猫，&f这种可爱的生物在夜间活动，为树冠层带来了生机。它可以用浆果驯服，并用竹子繁殖，是任何营地或基地的迷人点缀。当受到惊吓或保持警惕时，它会用双腿站立，并&a吓走&f附近的其他中立生物。"]
	quest.7640556580D163A6.quest_subtitle: "&7认识丛林中的小熊猫"
	quest.7640556580D163A6.title: "&5&l任务：&r&e夜间守护者"
	quest.77914D5DBF4741F8.quest_desc: ["&f盔甲架的调整细节远比初看时丰富。你可以改变每个身体部位的位置和旋转角度，为它们赋予自定义&a名称，&f让它们变得像村民宝宝一样小，隐藏底座或手中的物品，甚至可以禁用&a重力&f，使它们悬浮在原地。它们还可以被设为隐形，只显示盔甲或武器，从而实现高度精细的展示。设计完成后，只需保存更改，或者如果想重新开始，也可以取消更改。"]
	quest.77914D5DBF4741F8.quest_subtitle: "&7使用盔甲架进行高级装饰"
	quest.77914D5DBF4741F8.title: "&5&l任务：&r&e创意展示"
	quest.77C7F001E1659E37.quest_subtitle: "&7准备一道营养海鲜菜肴"
	quest.780193BD254CF74B.quest_desc: ["&f随着更牢固的纽带和日益增长的影响力，你或许能晋升为&a贵族</c3>——这是一个通过信任与对社区的贡献赢得的职位。在此等级，你的影响力将进一步扩大，让你能够引导村庄发展的诸多方面，例如人口增长与组织安排。你不再仅仅是村庄的一员，而是开始塑造村庄的&a未来</c4>。"]
	quest.780193BD254CF74B.quest_subtitle: "&7在村庄中承担更大的责任"
	quest.780193BD254CF74B.title: "&5&l任务：&r&e一位崛起的贵族"
	quest.782CC1999DE4882F.quest_desc: ["&f万圣节装饰品能让你将建筑完全变成一个阴森的场景。从蜘蛛网、猫和蝙蝠图案到南瓜、幽灵、稻草人、墓碑和女巫药水，装饰方式多种多样。将它们放置好，为你的世界带来真正的&a诡异氛围</c3>。"]
	quest.782CC1999DE4882F.quest_subtitle: "&7营造阴森的环境"
	quest.782CC1999DE4882F.title: "&5&l任务：&r&e万圣节装饰品"
	quest.783BC7210A42AD5F.quest_desc: [
		"         隐藏在&6丛林</c2>中生活着"
		"               &6小熊猫</c2>"
		"           一种&a可爱</c2>的生物"
		"         它在&0夜晚</c2>保持清醒"
		"               在&a树顶</c2>上"
		"             用&e浆果</c4>&b驯服</c2>它"
		"           并用&e竹子</c4>&b繁殖</c2>它"
		"            当它&c害怕</c2>或&c警觉</c4>时"
		"            它会用&6两条腿</c2>站立"
		"                以&b吓跑</c2>"
		"            其他&d中立</c2>动物"
	]
	quest.783BC7210A42AD5F.quest_subtitle: "竹子呢？"
	quest.783BC7210A42AD5F.title: "小熊猫"
	quest.79D8F6A2AD6A940A.quest_subtitle: "&7保存一种稀有食材"
	quest.7A427C1379B2917B.quest_desc: [
		"              &6锦鲤&f可以拥有"
		"           许多&a绚丽的颜色&f"
		"              为&d湖泊和河流&f带来"
		"              &b宁静&f"
		"           它们可以被拾起&f"
		"                 用一个&e桶&f"
		"             方便运输&f"
		"              待在&b锦鲤&f附近"
		"                会给你带来&a好运&f"
		"               比它们&d看起来&f的"
		"                 更有&6用&f"
	]
	quest.7A427C1379B2917B.quest_subtitle: "小鱼"
	quest.7A427C1379B2917B.title: "锦鲤"
	quest.7A86743926C7D537.quest_desc: [
		"       装饰是&6绝佳的方式&f"
		"        让我们的&d家&f变得美丽"
		"          用各种形式的&b装饰&f带来"
		"      &6内心的平静&f"
		"     其中最可爱的要数"
		"          当然是&a毛绒玩具&f了"
		"    它们&e极其可爱&f，而且"
		"             能让任何地方变得温馨"
		"    开始用这些&d可爱的伙伴&f装饰你的"
		"          &a空间&f吧！"
	]
	quest.7A86743926C7D537.quest_subtitle: "可爱"
	quest.7A86743926C7D537.title: "毛绒玩具"
	quest.7B67AF9ECF316B50.quest_subtitle: "&7制作一道精致的海洋菜肴"
	quest.7B9606933C8D9790.quest_desc: ["&f百叶窗是美化窗户的绝佳方式，既能增添风格，又兼具实用功能。它们可以开合，让你控制光线并创造出富有动感的设计。将它们放置好，让你的建筑拥有更精细的&a外观。"]
	quest.7B9606933C8D9790.quest_subtitle: "&7为你的窗户增添细节"
	quest.7B9606933C8D9790.title: "&5&l任务：&r&e百叶窗"
	quest.7BC8092367DE4C6F.quest_desc: [
		"            在&c圣诞节&f我们可以"
		"        装饰我们的 &d小屋&f"
		"       用各种 &6圣诞物品&f"
	]
	quest.7BC8092367DE4C6F.quest_subtitle: "圣诞装饰"
	quest.7C91BCDCF2DA30C7.quest_desc: [
		"     一把好的 &a刀&f 是最"
		"               &6重要的工具&f之一"
		"      在任何 &e厨房&f 里都是如此，它也是一件宝贵的"
		"          &b伙伴&f，在 &c狩猎&f 时尤其如此。"
		"    它能保证获得 &6额外掉落物&f"
		"            来自 &e动物&f，让"
		"       &b资源&f 更容易收集，"
		"     甚至还能获得 &a疣猪火腿&f"
		"   来自 &4危险的野兽&f，它们栖息在"
		"          &c下界&f。它还附带有"
		"  一种特殊的 &d附魔&f，可以奖励"
		"            &6从背后发动的攻击&f，"
		"   帮你快速解决 &c猎物&f。"
		"                  领取你的"
		"       &e第一把刀&f，并把它带在身边！"
	]
	quest.7C91BCDCF2DA30C7.quest_subtitle: "基础刀具"
	quest.7D0AF4D7F4F988F9.quest_desc: [
		"   在 &6桦木森林&f 中，你可能会发现"
		"           奇特的 &6蜂蜜傀儡&f"
		"              一个 &a活生生的守护者&f"
		"             它的外形像一个 &e蜂巢&f"
		"              &e蜜蜂&f 生活在里面"
		"           帮助生产 &a蜂蜜&f"
		"           它会投掷 &e蜂蜜滴落物&f"
		"  造成 &c伤害&f 并施加严重的缓慢效果&f"
		"      用蜂蜜瓶 &b修复&f 它 &f"
		"             一个 &d黏糊糊的保护者&f"
		"              随时准备 &6战斗&f"
	]
	quest.7D0AF4D7F4F988F9.quest_subtitle: "小蜂蜜"
	quest.7D9B4C3C25E12B01.quest_desc: ["&f有些工具、武器和护甲或许已不再值得使用，但它们附带的&a附魔 &f却可能价值连城，不容失去。只要使用正确的附魔台，你就能从受损的装备或附魔书中提取附魔，为未来的升级保留下来。当旧物品仍蕴含&a珍贵之物时，请善用此法。"]
	quest.7D9B4C3C25E12B01.quest_subtitle: "&7从装备中分离出珍贵的附魔"
	quest.7D9B4C3C25E12B01.title: "&5&l任务： &r&e寻回失落的附魔"
	quest.7DE39392772245BB.quest_desc: [
		"     现在我们可以堆出新的&a雪人了&f"
		"              我也不知道为什么"
		"           &6原版&f就足够了"
		"              &b#支持原版雪人&f"
	]
	quest.7DE39392772245BB.quest_subtitle: "我们不是已经有雪人了吗？"
	quest.7E1317F829843F18.quest_subtitle: "&7制作基础原料"
	quest.7EA197B2B0642250.quest_desc: [
		"    在&c下界&f中耕种需要"
		"            &d完全适应&f其"
		"             &e敌对环境&f"
		"     &6再生土&f可以用"
		"      &e锄头&f进行耕作，并用于&a种植&f"
		"    这种特殊的土壤无需使用&b水&f，"
		" 而必须&c用岩浆浇灌&f才能发挥作用"
		"   获取这种&6特殊方块&f，并学会"
		" 在&4极端条件&f下维护&a农田&f"
	]
	quest.7EA197B2B0642250.quest_subtitle: "&7让耕种适应下界"
	quest.7F06049C2DCA2EDA.quest_desc: [
		" 我们的&d房子&f需要&6充足的照明&f"
		"我们可以制作&e多种类型的灯笼&f"
		"    它们既能帮助&b照明&f，又能用于&a装饰&f"
	]
	quest.7F06049C2DCA2EDA.quest_subtitle: "于是，就有了光。"
	quest.7F22E9A3B0E7107A.quest_subtitle: "&7烹制加工后的原料"
	quest.7F2D2C4E11CF7FDE.quest_desc: [
		"            来完成我们的 &d房屋&f"
		"           我们可以制作 &6屋顶"
		"   并让我们的房屋 &a更加美观&f"
	]
	quest.7F2D2C4E11CF7FDE.quest_subtitle: "我们可以制作屋顶"
