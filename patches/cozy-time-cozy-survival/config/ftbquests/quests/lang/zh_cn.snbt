	quest.06DE72D81761D4FF.title: "恶魂"
	quest.0794B410EE871A95.quest_subtitle: "&7准备一份简易点心"
	quest.07E6B2B8B62863E2.quest_desc: ["&f在这个世界上，你会遇到许多陌生的生物、植物和危险。借助&a望远镜 &f，你可以从安全距离观察它们，并逐渐了解周围的环境。将它对准植物、动物或怪物，不断研究，直到发现结果在指南中&a被记录 &f。"]
	quest.07E6B2B8B62863E2.quest_subtitle: "&7使用望远镜探索周围的世界"
	quest.07E6B2B8B62863E2.title: "&5&l任务： &r&e好奇的目光"
	quest.08389BD302F76D97.quest_subtitle: "&7处理触须"
	quest.086A6C1EE2255376.quest_desc: [
