	order_index: 0
	quest_links: [ ]
	quests: [
		{
			description: [
				"厌倦了只杀随机怪物和生物？急需一些原材料？或者经验值？或是能助你战胜更强敌人的知识之书？那么，别再犹豫了！"
				""
				"快来看看新的悬赏板列表（现在根据剧情更新啦，笑）"
				""
				"有各种悬赏等你征服和收集，还有全新的生物和首领可供狩猎*。从最容易从地球上抹去的生物，到那些更难对付的强大首领。每组悬赏都自带战利品和奖励，完成一组还能获得更丰厚的回报。"
				""
				"成为世界上最伟大的 Koifanite Hunter！和朋友一起玩的话，就互相比赛，看谁能最先完成悬赏！向朋友们证明，为什么&o你&r才是最强大的 Lycani——我是指，史上最强大的 Koifanite Hunter！"
				"--------------------------------"
				""
				"* 注意：部分悬赏是特定地点的，请使用E-Compass或N-Compass在您的世界中搜索"
				""
				"** 注意：可能正在制作一项成就奖励。更多细节可能稍后会提供..."
			]
			entity_vis_size: 1.0f
