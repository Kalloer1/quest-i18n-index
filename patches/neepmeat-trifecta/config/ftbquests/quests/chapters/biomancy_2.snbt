	quest_links: [ ]
	quests: [
		{
			description: ["你可能需要比现有更多的肉来传播善意（或制作酷炫的肉块），但 neepmeat 可能无法满足你的需求。这就是 Biomancy 的用武之地。你可以用它作为伪安全系统或生物分隔系统，获得更多独特的武器和盔甲机制，甚至还能获得更多药水，如果你喜欢的话。"]
			id: "5F5718B74C69B7EA"
			size: 1.2d
			tasks: [{
				id: "47197583A7108454"
				title: "生物魔法友好纯净世界入门指南"
