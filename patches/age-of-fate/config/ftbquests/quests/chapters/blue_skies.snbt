	quests: [
		{
			description: ["Everbright 是一个永恒白昼与严寒并存的世界。这里栖息着大型野兽和虚幻生物，穿越此地时需时刻警惕身后。小心突如其来的暴风雪，它会带来浓雾和比平时更多的敌人。探索途中，你会遇到召唤师的致盲地牢和自然地牢，后者是 Starlit Crusher 的巢穴。"]
			id: "41ACBFB2805BFB3E"
			min_width: 300
			rewards: [
				{
					id: "42B078D865D77FBD"
					type: "xp"
					xp: 100
				}
				{
					id: "7248802BC49E6884"
					table_id: 5351675120932028234L
					type: "random"
				}
			]
			shape: "rsquare"
			subtitle: "* Everbright"
			tasks: [{
				dimension: "blue_skies:everbright"
				id: "194B3E848E0D1775"
				title: "访问维度：&2永恒光明之地 (The Everbright)"
				type: "dimension"
			}]
			x: -1.5d
			y: -3.0d
		}
		{
			description: ["永恒黎明世界永远沐浴在晨光中。这是一个更加湿热温暖的世界，昆虫和爬行动物在此繁衍生息。在进入前，最好准备好应对毒液和火焰，因为世界许多地方都可能对你造成伤害。穿越这片多样的地貌，去探索炼金术士的致盲地牢，然后是毒液地牢——蛛王巢穴的所在地。"]
			id: "663C8A3A0D93AE0F"
