	]
	quest.7870800C28A7E199.quest_desc: [
		"养鸡人的小屋是养鸡人饲养鸡、收集鸡蛋和宰杀鸡获取食物的地方。你必须捕捉并带回两只鸡到养鸡人的小屋，因为养鸡人自己不会捕捉和带回任何鸡。"
		""
		"养鸡人每个小屋等级只会保留两只鸡，所以在5级时他们将有十只鸡。"
	]
	quest.78AA7FB6F701A020.quest_desc: [
		"&1帕尔基亚&7是&6传说级&#3388FF水&7/&r&#1D1F93龙&7属性的宝可梦，也是&#C7FFD1神奥地区&#D08770创世三杰&7之一，被誉为&#FF69B4空间之神"
		""
		"{@pagebreak}"
		"&7生成于："
		"&#EBCB8B末地群系"
	]
	quest.78AA7FB6F701A020.title: "&#A38CDE空间巨兽"
	quest.78BAADA89281B75B.quest_desc: [
		"&#4A3CFF意志的化身&7 &#3A8320意志的化身&7，即来自&#C7FFD1神奥&7地区&#0066FF三湖&7的&#B73DB7超能力&7系&6传说宝可梦&7，象征着&#FF0419决心"
		""
		"{@pagebreak}"
		"&7生成于："
		"&#77CCFF河流"
		"&#0D5807沼泽地"
		"&#682833红树林沼泽"
	]
	quest.78BAADA89281B75B.title: "&#95BDE7被遗忘的意志"
	quest.794B28F461F1A613.quest_desc: ["可在许愿林地结构中找到"]
	quest.7A80614D559FA263.quest_desc: [
		"&#8A1D18Yveltal&7 是 &6传说级&0 暗&7/&#939DD1飞行&7 属性的宝可梦，&4毁灭&7 的 &0使者&7，诞生于 &#7C4E24远古&#4E004E 的 &7阴影&#940000 中，以 &#B48EAD吸取&7 生命、将 &#4C9A2A世界&7 带入 &0黑暗&7、并以 &#360734无情&7 的力量在战场上称王"
		""
		"{@pagebreak}"
		"&7生成于："
		"&#77CCFF苔原"
		"&#54280E黑暗森林"
		"&#1E5631沼泽地"
	]
	quest.7A80614D559FA263.title: "&#8A1D18毁灭的降临者"
	quest.7B441FBD12107406.quest_desc: ["必须通过合成获得，无法通过拾取/购买/赠送获得"]
	quest.7B5E2CD676A1A1C4.quest_desc: ["面包师会制作面包面团、饼干面团、蛋糕面团和生南瓜派，然后用熔炉将它们烤成面包、饼干、蛋糕和南瓜派。只有在厨师、邮箱或仓库最低库存要求提出请求时，他们才会执行此操作。"]
	quest.7B5E2CD676A1A1C4.quest_subtitle: "建造一个面包店"
