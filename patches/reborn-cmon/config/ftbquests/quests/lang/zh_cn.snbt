	quest.6E41B4F840BFB9EE.quest_desc: ["容量增加：64"]
	quest.6E81E18970A7BE53.quest_desc: ["等级上限提升：85"]
	quest.6EEA012FA11C7C08.quest_desc: ["选定殖民地位置后，你大概会想建造补给营地或补给船。只能选其一，不能两者兼得。两者都能提供一些基础物资，助你开局。 &o&7(床、食物、基础工具和盔甲、初始资源等)&r&r 最好将补给营地或船建在殖民地附近，因为前期会频繁往返。 &e要近，但不能太近。&r"]
	quest.6F3E74140EB34942.quest_desc: ["等级上限提升：34"]
	quest.70BE8DED85D7FD2E.quest_desc: ["&#8B2A1FKoraidon&7 是 &6传说级&#BB5914格斗&7/&#1D1F93龙&7属性的宝可梦，&4远古王者&7，从&#7C4E24被遗忘的纪元&7苏醒，化身为&#BB5914原始力量&7的化身，驾驭着&#8B2A1F绯红之风&7，以&#BB5914凶猛&7、&#1D1F93史前&7的力量征服&4战场&7。"]
	quest.70BE8DED85D7FD2E.title: "&#8B2A1F史前巅峰生物群系</c1>"
