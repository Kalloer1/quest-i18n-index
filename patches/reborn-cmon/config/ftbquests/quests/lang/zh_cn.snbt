	quest.6467D00A592093BC.quest_desc: ["&#76BA1B丰源道馆挑战&7是游戏中中等难度的系列任务，完成后可解锁烈空坐、拉帝欧斯、拉帝亚斯、代欧奇希斯和吉拉奇的委托。"]
	quest.6467D00A592093BC.title: "信息"
	quest.647F95EED59927B7.quest_desc: [
		"饥饿的殖民者几乎什么都吃，包括生肉和腐肉。真恶心！"
		""
		"当市民饥饿时，他们会来餐厅，厨师会给他们食物。（前提是你有食物可给）考虑建造渔夫小屋或牛仔小屋。"
		""
		"注意：请为你的厨师选择一种燃料。常用的有木炭、木棍和木板，但任何有燃烧时间的物品都可以。"
	]
	quest.64C3FE2085ED71E7.quest_desc: [
		"等级上限提升：55"
		""
		"解锁喵喵狩猎任务"
	]
	quest.64C3FE2085ED71E7.title: "击败乔瓦尼 (Giovanni)"
	quest.64D3107A374BBCDB.quest_desc: [
