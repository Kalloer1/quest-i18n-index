		{
			description: ["如果你决定饲养动物，这将是你迈向自给自足生活的一大步。即使只养几只鸡，也会让你感到真正的成就感。然而，在自己的农场里生产肉类，需要处理几个关键问题。肉类并非预先分装好并用塑料包装的，我们知道很多人在屠宰动物时会感到困难。我们认为，让动物拥有美好的生活，并以尽可能减少痛苦的方式结束它们的生命，才是最人道地获取肉类的方法。"]
			entity_vis_size: 1.0f
			id: "27561C4E13A29A22"
			quest_enhance_disable_scroll_paging: false
			tasks: [{
				id: "021596F0D4029AD0"
				title: "动物养殖指南"
				type: "checkmark"
			}]
			title: "动物养殖（Animal Husbandry）"
			x: 0.0d
			y: -1.0d
		}
		{
			dependencies: ["27561C4E13A29A22"]
			description: ["几千年来，人们一直在养鸡。古埃及人、希腊人、中国人和罗马人都喜欢养鸡，享用鸡蛋和鸡肉。如今，鸡仍然是农村地区人们的理想家禽。无论以何种方式烹饪，鸡蛋的美味都无与伦比，尤其是来自自家后院散养鸡的鸡蛋。"]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "minecraft:chicken_spawn_egg"
				tag: { }
			}
			id: "5FAAA84F3B463460"
			quest_enhance_disable_scroll_paging: false
			tasks: [{
				id: "1F72520610B690F1"
				title: "养鸡致富"
				type: "checkmark"
			}]
			x: 1.5d
			y: -1.0d
		}
		{
			dependencies: ["27561C4E13A29A22"]
			description: ["农场里的第一个圣诞节，我们从当地屠夫订了一只有机火鸡。那是一只很棒的火鸡，但价格昂贵得惊人。第二年，我们算了一笔账，发现如果在农场自己养火鸡，售价可以便宜大约三分之一。于是我们养了一打火鸡，给了它们充足的空间和有机饲料，结果大获成功。"]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "wildernature:turkey_spawn_egg"
				tag: { }
			}
			id: "168E5AF7FC106A97"
			quest_enhance_disable_scroll_paging: false
			tasks: [{
				id: "493C6784D36E81A1"
				title: "饲养火鸡"
				type: "checkmark"
			}]
			x: 2.5d
			y: -1.0d
		}
		{
			dependencies: ["27561C4E13A29A22"]
			description: [
				"鹅是非常棒的鸟——坚韧又出奇地独立——这使它们成为近乎完美的宠物，但它们可能很吵，如果你不习惯大鸟，它们会给你带来一些麻烦。"
				"鸭子也很好，但它们会给你带来不少麻烦。"
			]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "untitledduckmod:duck_sack"
				tag: { }
			}
			id: "1CDDCF1E89270179"
			quest_enhance_disable_scroll_paging: false
			tasks: [{
				id: "3A2ABB3C3B1B6997"
				title: "饲养鸭子和鹅的指南"
				type: "checkmark"
			}]
			x: 3.5d
			y: -1.0d
		}
		{
			dependencies: ["27561C4E13A29A22"]
			description: ["猪通常是小型农场的核心。它们能耕作土壤、增加肥力，还能提供上等的肉。它们非常聪明，会听到呼唤就过来，而且各有独特的个性。不过，作为杂食动物，我们偶尔也喜欢吃火腿，所以没给猪起名字——你可以来命名它们！"]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "minecraft:pig_spawn_egg"
				tag: { }
			}
			id: "619E0E5EDAE2EB4A"
			quest_enhance_disable_scroll_paging: false
			tasks: [{
				id: "32030317D35329EE"
				title: "养猪场建造指南"
				type: "checkmark"
			}]
			x: 4.5d
			y: -1.0d
		}
		{
			dependencies: ["27561C4E13A29A22"]
			description: ["想象一下，能在自己的农场里生产所有需要的蛋白质和乳制品该有多棒。我们认为，饲养牛是自给自足的典范，但在决定饲养任何动物之前，请记住这是一项重大的责任。"]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "minecraft:cow_spawn_egg"
				tag: { }
			}
			id: "323131A5E361BBFA"
			quest_enhance_disable_scroll_paging: false
			tasks: [{
				id: "55DEDB5BDBFE6860"
				title: "畜牧养殖"
				type: "checkmark"
			}]
			x: 5.5d
			y: -1.0d
		}
		{
			dependencies: ["27561C4E13A29A22"]
			description: ["饲养绵羊能减少对进口肉类和羊毛的依赖。照顾一小群绵羊需要极大的耐心和技巧——这并非易事，但在开始前，你必须先有这份意愿！"]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "minecraft:sheep_spawn_egg"
				tag: { }
			}
			id: "16430ED6AA4074E6"
			quest_enhance_disable_scroll_paging: false
			tasks: [{
				id: "19C471A14478D6D7"
				title: "绵羊养殖"
				type: "checkmark"
			}]
			x: 6.5d
			y: -1.0d
		}
		{
			dependencies: ["27561C4E13A29A22"]
			description: ["山羊比绵羊更耐旱，非常适合恢复被忽视的农场，因为它们什么都吃，从灌木到杂草。它们的肉是极好的蛋白质来源，山羊还能产出制作美味奶酪的上好牛奶。"]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "minecraft:goat_spawn_egg"
				tag: { }
			}
			id: "0026F9B697576189"
