	quests: [
		{
			description: [
				""
				"季节：初冬，第1天"
				""
				"{image:kubejs:textures/ewi1.png width:277 height:156 align:center fit:true}"
				""
				"&6The village awakens to a soft blanket of fresh snow, sparkling under the pale winter sun. Children rush outside to catch snowflakes and build their first snowmen of the year, while warm fires burn bright inside every home. It’s a day of joyful beginnings and quiet wonder."
				"&r"
				"⛄ 堆雪人并用找到的物品装饰它们"
				"🔥 在壁炉旁用热饮暖暖身子"
				"❄️ 看雪花在微风中翩翩起舞"
				""
				"庆祝冬日初临，用欢笑与温暖开启完美的一天。"
			]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "fairylights:snowflake_light"
				tag: {
					color: 16383998
				}
			}
			id: "1AF7096157BD1EEB"
			quest_enhance_disable_scroll_paging: false
			shape: "none"
			subtitle: "初雪轻柔飘落——一场被白色包裹的新开端。”"
			tasks: [{
				id: "7A5BEFD28955CB22"
				title: "1"
				type: "checkmark"
			}]
			title: "01 - 首个雪日 – 冬季的温柔降临"
			x: -4.5d
			y: 0.5d
		}
		{
			description: [
				""
				""
				"季节：隆冬，第1天"
				""
				"{image:kubejs:textures/mwi1.png width:299 height:168 align:center fit:true}"
				"&6烟花点亮夜空，村庄沉浸在庆祝的喜悦中，迎接崭新的开始。家人和朋友齐聚一堂，互致祝福，许下愿望，共享丰盛的佳肴，为充满希望与繁荣的一年积蓄力量。空气中洋溢着欢乐、笑声和璀璨的灯光。&r"
				""
				"🎇 点燃五彩缤纷的鞭炮，欣赏璀璨的星空"
				"🍲 与挚爱之人共享节日大餐"
				"🕯️ 献上祝福，祈求健康、幸福与好运"
				"🎉 载歌载舞迎接新的一年"
				""
				"一个充满活力的日子，庆祝结束、开始和所有前方的承诺。"
			]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "fairylights:snowflake_light"
				tag: {
					color: 16383998
				}
			}
			id: "6148B1E1E889E864"
			quest_enhance_disable_scroll_paging: false
			shape: "none"
			subtitle: "用鞭炮和祝福点亮天空与心灵，迎接全新的开始。”"
			tasks: [{
				id: "3DE4C8AA21CBFA7A"
				title: "1"
				type: "checkmark"
			}]
			title: "01 - 元旦 – 鞭炮与祝福"
			x: -4.5d
			y: 2.5d
		}
		{
			description: [
				""
				"季节：隆冬，第1天"
				""
				"{image:kubejs:textures/lwi1.png width:329 height:185 align:center fit:true}"
				"&6冬日的寒意渐逝，村庄点燃蜡烛，迎接春天的第一缕气息。霜冻尚存，但早开的番红花正勇敢地探出雪面。这是一个充满希望与更新的日子，寒冷与温暖在此悄然交融，达到微妙的平衡。&r"
				""
				"🕯 点燃蜡烛，驱散残留的黑暗"
				"🌱 留意花园和田野中新的生长迹象"
				"☕ 与亲朋好友共饮暖身花草茶"
				"🎶 分享庆祝季节更替的轻柔歌曲"
				""
				"&r一个拥抱耐心、承诺和生命色彩缓缓回归的日子。"
			]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "fairylights:snowflake_light"
				tag: {
					color: 16383998
				}
			}
			id: "2D12CF346A23EEA3"
			quest_enhance_disable_scroll_paging: false
			shape: "none"
			subtitle: "点燃蜡烛，迎接初春的气息，即便冬意尚未完全消退。”"
			tasks: [{
				id: "047003849B8604BC"
				title: "1"
				type: "checkmark"
			}]
			title: "01 - Candlemas / Stretenia – 寒冷中透露的春意"
			x: -4.5d
			y: 4.5d
		}
		{
			description: [
				""
