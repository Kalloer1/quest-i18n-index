	quests: [
		{
			description: [
				""
				"季节：初夏，第1天"
				""
				"{image:kubejs:textures/esu1.png width:295 height:166 align:center fit:true}"
				"&6儿童节的到来让村庄充满了欢声笑语——这是一个庆祝青春、想象力和游戏魔力的日子。街道装饰着彩带，人们分享着美食，游戏将大家聚集在一起。&r"
				""
				"&6大人们也加入其中，重温着简单乐趣带来的喜悦。&r"
				""
				"🎨 举办游戏、寻宝活动和故事会"
				"🍬 和孩子们分享糖果和手工玩具"
				"🎈 用鲜艳的色彩和欢快的旗帜装饰村庄"
				""
				"一个内心充满喜悦、游戏是最宝贵财富的日子。"
			]
			entity_vis_size: 1.0f
			icon: "minecraft:sunflower"
			id: "6AB5031BBF591359"
			quest_enhance_disable_scroll_paging: false
			shape: "none"
			subtitle: "“在每一次欢笑和游戏中，童年的精神都闪耀着光芒。”"
			tasks: [{
				id: "46FC451ADEC324CD"
				title: "1"
				type: "checkmark"
			}]
			title: "01 - 儿童节 – 欢笑、游戏与惊奇"
			x: -14.0d
			y: -12.0d
		}
		{
			description: [
				""
				"季节：初夏，第2天"
				""
				"{image:kubejs:textures/esu2.png width:301 height:169 align:center fit:true}"
				"&6阳光明媚，田野金黄，又到了割草日——村民们齐心协力，为过冬储备干草。空气中弥漫着青草的芬芳，镰刀挥舞间回荡着欢声笑语。&r"
				""
				"&6虽然辛苦，但这一天充满了友谊、歌声和满足感。&r"
				""
				"🌞 早起并准备好你的工具"
				"🌿 齐心协力收割、收集并堆叠干草"
				"🍵 用丰盛的野炊和冷饮结束这一天"
				""
				"一场庆祝努力、传统与大地韵律的庆典。"
			]
			entity_vis_size: 1.0f
			icon: "minecraft:sunflower"
			id: "3EAC6099EFEB5912"
			quest_enhance_disable_scroll_paging: false
			shape: "none"
			subtitle: "“锋利的刀刃，温暖的阳光，金色的田野——夏天最诚挚的回报。”"
			tasks: [{
				id: "366010F4F9830FB6"
				title: "1"
				type: "checkmark"
			}]
			title: "02 - 割草日 – 汗水、阳光与夏日的芬芳"
			x: -12.5d
			y: -12.0d
		}
		{
			description: [
				""
				"季节：仲夏，第2天"
				""
				"{image:kubejs:textures/msu2.png width:329 height:185 align:center fit:true}"
				"&6市场商队驶入小镇，带来了色彩缤纷的摊位，里面摆满了来自遥远地方的奇珍异货、稀有种子和手工宝藏。村民们兴奋地聚集在一起，互通有无，分享故事，发现新奇的乐趣。&r"
				""
				"&6今天是贸易、惊喜和社区交流的一天。&r"
				""
				"🎪 浏览带有独特物品和奇珍异宝的摊位"
				"用种子和农具换取新的收成"
				"🎁 为您的农场寻找特别的礼物和宝藏"
				""
				"一个节日般的日子，将世界奇观迎接到你的门前。"
			]
			entity_vis_size: 1.0f
			icon: "minecraft:sunflower"
			id: "4E00FE54958C8940"
			quest_enhance_disable_scroll_paging: false
			shape: "none"
			subtitle: "“商队带来了来自遥远国度的新奇事物和古老传说。”"
			tasks: [{
				id: "11044D0D22201E3B"
				title: "1"
				type: "checkmark"
			}]
			title: "02 - Market Caravan – 移动的奇妙集市"
			x: -12.5d
			y: -10.0d
		}
		{
			description: [
				""
				"季节：夏末，第2天"
				""
				"{image:kubejs:textures/lsu2.png width:307 height:173 align:center fit:true}"
				"&6夏末的余温尚存，村民们围坐在篝火旁，烤着刚收成的玉米。香甜的烟熏味弥漫在空气中，与欢声笑语和轻柔的夜曲交织在一起。&r"
				""
				"&6是时候品味季节的丰收，在渐落的阳光下享受与好友相伴的惬意了。&r"
				""
				"🔥 在明火上烤玉米耳朵"
				"分享清凉饮料和夏日甜点"
				"🎶 享受篝火旁的轻柔旋律与故事"
				""
				"在秋天到来之前，一场庆祝丰收与友谊的温馨庆典。"
			]
			entity_vis_size: 1.0f
			icon: "minecraft:sunflower"
			id: "47913FDBD45FCCDA"
			quest_enhance_disable_scroll_paging: false
			shape: "none"
			subtitle: "“围坐在火堆旁——最香甜的玉米正等着你们。”"
			tasks: [{
				id: "4E4565E091D558F6"
				title: "1"
				type: "checkmark"
			}]
			title: "02 - 玉米烤日 – 仲夏的甜蜜火焰"
			x: -12.5d
			y: -8.0d
		}
		{
			description: [
				""
				"季节：仲夏，第1天"
				""
				"{image:kubejs:textures/msu1.png width:319 height:180 align:center fit:true}"
				"&6The bushes are heavy with plump blueberries, and the village buzzes with excitement for the Blueberry Festival. Tables overflow with pies, jams, and fresh berries, and neighbors gather to share recipes, stories, and laughter beneath the warm sun.&r"
				""
				"&6今天是甜蜜、社区和简单乐趣的欢乐日子。&r"
				""
				"🫐 从田里采摘成熟的蓝莓"
				"🥧 烘焙蓝莓点心或与朋友分享"
				"🎉 加入游戏、音乐和浆果主题的节日庆典"
				""
				"一场庆祝夏日最甜蜜礼物的庆典。"
			]
			entity_vis_size: 1.0f
