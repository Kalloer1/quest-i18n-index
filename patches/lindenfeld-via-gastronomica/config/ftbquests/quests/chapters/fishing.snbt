		{
			dependencies: ["77859EC8F1A12D1C"]
			description: ["我们的供应商出售64公里半径内捕获的鱼，所以能享用上鲜鱼。不过，偶尔我们也会翻过山去钓鱼。这既是一项放松的活动，从烹饪的角度来说也令人满足。"]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "jei:textures/jei/atlas/gui/icons/info.png"
				}
			}
			id: "62F2F975AE343D10"
			quest_enhance_disable_scroll_paging: false
			tasks: [{
				id: "3B9B3D767FB3CA70"
				title: "钓鱼与鱼类烹饪准备"
				type: "checkmark"
			}]
			x: 2.0d
			y: 3.5d
		}
		{
			dependencies: ["77859EC8F1A12D1C"]
			description: ["钓鱼不需要花哨昂贵的装备。我们有鱼竿和各种渔具。每种鱼钩、鱼线和渔轮都能让垂钓者有机会钓到不同种类的鱼。"]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "jei:textures/jei/atlas/gui/icons/info.png"
				}
			}
			id: "041BB3983BC2FC42"
			quest_enhance_disable_scroll_paging: false
			tasks: [{
				id: "6548B5B0D6B879F7"
				title: "基本概念"
				type: "checkmark"
			}]
			x: 3.0d
			y: 3.5d
		}
		{
			dependencies: ["77859EC8F1A12D1C"]
			description: ["淡水钓鱼的目标大多是鳟鱼或鲶鱼——被认为是适合运动的鱼类——但我们似乎忘记了其他物种。无论如何，水中栖息着各种物种、体型和行为特征的鱼类。"]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "jei:textures/jei/atlas/gui/icons/info.png"
				}
			}
			id: "1A1895F0CB24791C"
			quest_enhance_disable_scroll_paging: false
			tasks: [{
				id: "6449E8F649A09CF6"
				title: "淡水钓鱼"
				type: "checkmark"
			}]
			x: 4.0d
			y: 3.5d
		}
		{
			dependencies: ["77859EC8F1A12D1C"]
			description: ["海上钓鱼的人大致分为两类：积极的钓手会用纺车竿或浮漂竿，尽情抛竿收线。钓鲭鱼时，这种方法很有效，能为烧烤或冷冻储备充足的鱼。新鲜鲭鱼去骨、调味、烧烤后，美味足以征服最挑剔的食客。不那么积极的钓手则用鱼饵，无论是浮漂钓还是底钓。这看似更简单，但需要照料鱼饵。我们总备有沙鳗、鱿鱼或鲭鱼，以便随时出海钓鱼。"]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "jei:textures/jei/atlas/gui/icons/info.png"
				}
			}
			id: "0A73EE95BC46D2A5"
			quest_enhance_disable_scroll_paging: false
			tasks: [{
				id: "07F9716DB55BA7AF"
				title: "离岸钓鱼"
				type: "checkmark"
			}]
			x: 5.0d
			y: 3.5d
		}
		{
			dependencies: ["0A73EE95BC46D2A5"]
			description: [
				""
				"它除了鱼之外，还能存放鱼钩、浮漂和鱼饵等钓鱼相关物品。"
				"除了存放物品，渔具箱还能让你更换鱼竿配件！"
				""
				"如果你打算捕捉整个主世界的所有生物，这绝对必不可少！"
				""
				""
				"宝藏 - 钓鱼时，你可能会感觉到有东西比平时更重地拉下你的鱼钩。"
				"你发现了一个宝藏！"
				"现在你有本事在不弄丢渔获的情况下拿到宝藏吗？"
				"更强的鱼可能会掉落更强大的战利品！"
				"想要最好的战利品，甚至是一些独特的外观物品，就要准备好迎接一场硬仗。"
			]
