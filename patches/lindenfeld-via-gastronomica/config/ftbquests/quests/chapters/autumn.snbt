	quests: [
		{
			description: [
				""
				"季节：初秋，第3天"
				""
				"{image:kubejs:textures/eau3.png width:265 height:149 align:center fit:true}"
				"&6在这神秘的日子里，村民们会冒险来到森林边缘，低声分享着关于神秘迷人的仙女Iele的古老传说。人们佩戴着草药花环以作保护，并在树下留下蜂蜜和鲜花的祭品。&r"
				""
				"&3SebbShepherd 生日快乐！感谢大家玩我的整合包，希望你们玩得开心！♥&r"
				""
				""
				"🧚 聆听伊莱及其他森林精灵的故事"
				"🌸 用野生草药和花朵制作防护花环"
				"🍯 在森林中留下温和的贡品，以向无形者致敬"
				""
				"一个充满魔法、宁静与敬畏的黄昏之日。"
			]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "seasonhud:textures/season/autumn.png"
				}
			}
			id: "24755F0B2452C1ED"
			quest_enhance_disable_scroll_paging: false
			shape: "none"
			subtitle: "“田野成熟了，是时候收割庄稼了。”"
			tasks: [{
				id: "343DAF86C9EB94F0"
				title: "1"
				type: "checkmark"
			}]
			title: "03 - 森林之民日 – 精灵的低语"
			x: -1.5d
			y: -3.0d
		}
		{
			description: [
				""
				"季节：中秋，第1天"
				""
				"{image:kubejs:textures/mau1.png width:287 height:162 align:center fit:true}"
				"&6村庄里创意涌动，南瓜被雕刻成发光的灯笼，为窗户带来温暖闪烁的灯光。烤箱里飘出南瓜派的香甜气息，邀请大家共享秋日的温馨舒适。&r"
				""
				"🎨 将南瓜雕刻成别致的灯笼"
				"🥧 烘焙并分享美味的南瓜派"
				"🕯 天黑时点亮灯笼，让寒冷的夜晚更明亮"
				""
				"一个欢庆秋日魔法与美味的欢乐日子。"
			]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "seasonhud:textures/season/autumn.png"
				}
			}
			id: "360FEE5084085FD0"
			quest_enhance_disable_scroll_paging: false
			shape: "none"
			subtitle: "“南瓜会发光，烤箱会发热——让我们为村庄创造光明和甜蜜。”"
			tasks: [{
				id: "72DD2AED3CB47066"
				title: "1"
				type: "checkmark"
			}]
			title: "01 - 南瓜日 – 秋日之光与味"
			x: -4.5d
			y: -1.0d
		}
		{
			description: [
				""
				"季节：深秋，第1天"
				""
				"{image:kubejs:textures/lau1.png width:371 height:209 align:center fit:true}"
				"&6村民们聚集在一起，纪念逝去的圣人和挚爱，在坟墓和家中点燃蜡烛。这是一个庄严的反思、祈祷和希望的日子，社区与信仰交织在一起，让珍贵的回忆永存。&r"
				""
				"点燃蜡烛，装饰坟墓"
				"献上鲜花与祈祷，祈求好运降临"
				"🤝 分享圣人与家族传奇的故事"
				""
				"一个值得尊敬、团结与和平缅怀的日子。"
			]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "seasonhud:textures/season/autumn.png"
				}
			}
			id: "5D862660AE77987F"
			quest_enhance_disable_scroll_paging: false
			shape: "none"
			subtitle: "“照亮过去，以纪念那些仍在指引我们的人。”"
			tasks: [{
				id: "51D7C42DE1BCFDF1"
				title: "1"
				type: "checkmark"
			}]
			title: "01 - 万圣节：致敬圣人与逝者的一天"
			x: -4.5d
			y: 1.0d
		}
		{
			description: [
				""
				"季节：初秋，第1天"
				""
				"{image:kubejs:textures/eau1.png width:283 height:189 align:center fit:true}"
				"&6果园里挂满了成熟的苹果，村庄正用丰收的甜美滋味庆祝。清脆的苹果被采摘，美味的派被烘烤，温暖的苹果酒在朋友间分享。&r"
				""
				"🍏 从树上摘下新鲜的苹果"
				"🥧 烘焙美味的苹果点心与大家分享"
				"🎉 在果园里享受游戏、音乐和欢笑"
				""
				"庆祝果园馈赠与丰收乐趣的欢乐日子。"
			]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "seasonhud:textures/season/autumn.png"
				}
			}
			id: "15F2919BB9C3BAAC"
			quest_enhance_disable_scroll_paging: false
			shape: "none"
			subtitle: "“果园里弥漫着熟苹果的香气和欢声笑语。”"
			tasks: [{
				id: "2B872B67A1C95EB7"
				title: "1"
				type: "checkmark"
			}]
			title: "01 - 苹果节 – 果园的甜蜜"
			x: -4.5d
			y: -3.0d
		}
		{
