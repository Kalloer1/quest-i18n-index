	quests: [
		{
			description: ["大多数住宅的设计都早于可持续生活理念的出现，只有近十年新建的住宅才以实现真正的节能为目标而设计。"]
			entity_vis_size: 1.0f
			id: "4AA1303E995D771C"
			quest_enhance_disable_scroll_paging: false
			tasks: [{
				id: "46452763604C6509"
				title: "平衡性良好"
				type: "checkmark"
			}]
			x: -2.0d
			y: -0.5d
		}
		{
			dependencies: ["4AA1303E995D771C"]
			description: ["本整合包不鼓励建造巨型建筑（缺乏个人特色且不温馨的单栋建筑或房间），而是鼓励建造充满细节、小巧温馨且能抵御风雨的建筑。以下是一些温馨环保建筑的想法分享 :D"]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "cluttered:textures/painting/van_gogh_wheatfield.png"
				}
			}
			icon_scale: 2.0d
			id: "1F3ED454FFAD72BA"
			quest_enhance_disable_scroll_paging: false
			tasks: [{
				id: "5C183146F577640A"
				title: "建造小型建筑"
				type: "checkmark"
			}]
			x: 3.0d
			y: 2.0d
		}
		{
			dependencies: ["4AA1303E995D771C"]
			description: [
				"利用太阳能需要在白天捕获足够热量和夜间防止热量流失之间保持恒定平衡。"
				""
				"朝南的房屋能最有效地捕捉太阳能。同时，大部分朝向南的房屋能让玩家在（通常是卧室里）欣赏到壮丽的日出，以及东边的美丽日落——"
			]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "extradelight:textures/mob_effect/sunshine.png"
				}
			}
			icon_scale: 2.0d
			id: "3C1CBF6D693DB430"
			quest_enhance_disable_scroll_paging: false
			tasks: [{
				id: "6BB71985454D3512"
				title: "捕捉太阳的热量"
				type: "checkmark"
			}]
			x: -5.0d
			y: 2.0d
		}
		{
			dependencies: ["4AA1303E995D771C"]
			description: ["热源非常重要。秋天来临，经过一天的劳作，熔炉、壁炉甚至煤炉都能让你温暖如春。冬天雪下得很大，没有什么比穿着最喜欢的睡衣，在壁炉旁喝一杯热巧克力更惬意了，不是吗？"]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "legendarysurvivaloverhaul:heater"
				tag: { }
			}
			icon_scale: 2.0d
			id: "5297EA6081DA8BDD"
			quest_enhance_disable_scroll_paging: false
			tasks: [{
				id: "5343F7CC8CA8AA00"
				title: "热源 (Heat Source)"
				type: "checkmark"
			}]
			x: -3.5d
			y: 2.0d
		}
		{
			dependencies: ["4AA1303E995D771C"]
			description: ["一个工作坊能帮你节省大量时间。你可以自己制作或修理工具，而不是去购买。此外，有一个专门存放工具的空间会让你的生活更轻松。我认为每个小业主都需要一把锤子、一把锯子，甚至一些钉子。下面我将列出一些可以装备你工作坊的工具和配件。注意：建议将工作坊建在单独的建筑物、棚屋或类似结构中，而不仅仅是一个脏兮兮的小房间。"]
			entity_vis_size: 1.0f
