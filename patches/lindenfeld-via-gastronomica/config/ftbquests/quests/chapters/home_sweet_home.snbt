			x: -2.0d
			y: 2.0d
		}
		{
			dependencies: ["4AA1303E995D771C"]
			description: ["厨房是许多家庭的心脏——我们在这里喝早咖啡、储存园中蔬菜、享受家庭聚餐和招待客人。但厨房也是耗能最多的地方，在备餐和烹饪时节约能源，是降低成本最简单的方法之一。"]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "farmersdelight:cooking_pot"
				tag: { }
			}
			icon_scale: 2.0d
			id: "7863F57858BD3D50"
			quest_enhance_disable_scroll_paging: false
			tasks: [{
				id: "4B2903D0ABB39878"
				title: "环保小厨师"
				type: "checkmark"
			}]
			x: -0.5d
			y: 2.0d
		}
		{
			dependencies: ["7863F57858BD3D50"]
			description: ["打造环保厨房的第一步，是避免食物浪费，确保没有可食用的东西被扔进垃圾桶。这意味着要在食物过期前用完它们。按季节或烹饪计划整理你的储藏室。减少食物浪费的另一个好方法是发挥创意，用剩菜制作新食谱。尝试完成所有食谱（按 J 键），成为最棒的 CHEF de` LINDENFELD"]
			entity_vis_size: 1.0f
			id: "55C981A4B341C6E5"
			quest_enhance_disable_scroll_paging: false
			tasks: [{
				id: "5BBB62D6D0F30D01"
