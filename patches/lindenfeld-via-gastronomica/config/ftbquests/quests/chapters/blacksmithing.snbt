	quests: [
		{
			dependencies: ["6D40A997F824CA6A"]
			description: [
				"在阴影中，一个村民看着你制作第一件工具！他正慢慢向你靠近。"
				"&6- 看得出来你真的很擅长这个！你的工具看起来很棒！我有个旧铁砧藏在棚子里。我是个老头子，用不着了。我想把它送给你当礼物。你想要吗？我打算去弄点铜，有个小项目在弄……然后再去找铁砧。或者……你能帮我弄5个铜锭吗？我攒了好一阵子了……而且时间不多了……&r"
			]
			entity_vis_size: 1.0f
			hide_until_deps_complete: false
			id: "2C85427AC46C8419"
			min_width: 500
			quest_enhance_disable_scroll_paging: false
			rewards: [{
				id: "4C0D7E99DF2FFFCF"
				item: "overgeared:smithing_anvil"
				type: "item"
			}]
			tasks: [{
				consume_items: true
				count: 5L
				id: "4FF1BFC0E3FEEC50"
				item: { Count: 5, id: "minecraft:copper_ingot" }
				type: "item"
			}]
			title: "老者的计划 (The Old Man's Project)"
			x: -1.5d
			y: 1.0d
		}
		{
			dependencies: ["2C85427AC46C8419"]
			description: ["要升级成更好的工具，得从最易塑形的金属开始，那就是铜。从老人口中得到的砧锤会派上大用场。我们要开始用热金属了！需要工具来帮忙。制作木制钳子以继续。注意...从现在开始，我们需要力量点数来使用物品。每个物品的描述中都会显示要求。要使用木制钳子，需要Tinkering: 8。别忘了按~Y~将累积的经验分配到专长上。小心——要明智地选择专长！专长有限！仔细阅读每个专长和技能，仔细思考你想成为什么样的角色！"]
			entity_vis_size: 1.0f
			hide_until_deps_complete: false
			id: "0B08D6F6383BCC31"
			min_width: 500
			quest_enhance_disable_scroll_paging: false
			tasks: [{
				id: "2DCF7BAD0AEC557C"
				item: {
					Count: 1
					id: "overgeared:wooden_tongs"
					tag: {
						Damage: 0
					}
				}
				type: "item"
			}]
			x: 0.0d
			y: 1.0d
		}
		{
			dependencies: ["2C85427AC46C8419"]
			description: ["用锤子就能在礼物砧上锻造红热的铁！只需要一些铜和几根木棍……很简单。"]
			entity_vis_size: 1.0f
			hide_until_deps_complete: false
			id: "09BC200141615085"
			quest_enhance_disable_scroll_paging: false
			rewards: [{
