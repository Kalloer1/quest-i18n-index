						Damage: 0
					}
				}
				type: "item"
			}]
			x: 1.0d
			y: 1.0d
		}
		{
			dependencies: ["09BC200141615085"]
			description: ["开始前，你需要一桶水。最简单的办法是制作一个木桶。它便宜又实用！别忘了装满水。"]
			entity_vis_size: 1.0f
			id: "08FA006DEE0DE6A3"
			quest_enhance_disable_scroll_paging: false
			rewards: [{
				id: "6A99007ECEB2C57B"
				type: "xp"
				xp: 50
			}]
			tasks: [{
				id: "18E12BB4E9B04026"
				item: {
					Count: 1
