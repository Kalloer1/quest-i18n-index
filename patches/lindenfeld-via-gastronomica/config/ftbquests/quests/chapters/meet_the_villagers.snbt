	quests: [
		{
			description: [
				"利登费尔德中心的小石教堂是安德烈神父近三十年的家。每天早晨，他都会敲响古老的青铜钟，然后穿过村庄，向已经开始工作的人们问好。"
				""
				"他不喜欢长篇大论，更喜欢在喝茶时安静交谈，以谦逊而非评判的态度提供指引。他知道几乎每个村民的负担，却从不谈论他人的烦恼。"
				""
				"他最大的快乐是看到邻居们在分歧后和解，认为人与人之间的和平是任何社区最坚实的基础。"
				""
				"他经常说："
				""
				"“信仰在善意浇灌下茁壮成长。”"
			]
			entity_vis_size: 1.0f
			icon: "windswept:soul_fairy_light"
			icon_scale: 2.0d
			id: "24041D8C0344631F"
			min_width: 500
			quest_enhance_disable_scroll_paging: false
			subtitle: "“当村民们彼此宽恕时，村庄才是最强大的。”"
			tasks: [{
				id: "57D8700DF1596024"
				title: "地球の父 - 祭司(BADGER)"
				type: "checkmark"
			}]
			title: "安德烈神父 — 牧师"
			x: -5.0d
			y: -4.0d
		}
		{
			description: [
				"托马的锤子敲击声几十年来一直在利登菲尔德回响。他的锻造炉是村里最古老的建筑之一，石墙被多年的炉火和辛劳熏得发黑。在这里，他打造着村庄赖以生存的犁、马蹄铁、斧头、钉子和各种工具。武器是他最不愿意制作的。"
				""
				"年轻时，托马曾与士兵同行，在无数战役后修复破损的刀剑和盔甲。他目睹了足够的苦难，余生致力于建造而非破坏。定居于利登菲尔德后，他专注于打造工具，帮助人们种植作物、建造家园、谋生糊口。"
				""
				"起初，他注意到你随身带着旧剑，对你充满怀疑。直到看到你选择锄头而非刀剑，他的看法才开始改变。久而久之，他成了你最信任的导师之一，暗自为另一位战士在战场之外找到了和平而感到自豪。"
				""
				"他经常说："
				""
				"最优质的钢铁，是助力明日建设的那种钢铁。\""
			]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "overgeared:smithing_hammer"
				tag: {
					Damage: 0
				}
			}
			icon_scale: 2.0d
			id: "5A0B3557401C5B97"
			min_width: 500
			quest_enhance_disable_scroll_paging: false
			subtitle: "钢铁铭记着每一把塑造它的锤子。\""
			tasks: [{
				id: "46CB866077946991"
				title: "锻造匠 Toader - 铁匠(熊)"
				type: "checkmark"
			}]
			title: "Toma — 铁匠"
			x: -6.5d
			y: -2.5d
		}
		{
			description: [
				"加夫里尔多年来一直领导着利登菲尔德，但他从不认为自己高人一等。他经常能看到他在修理围栏、帮助收割庄稼，或与村民一起运送谷物。"
				""
				"他最关心的是看到Via Gastronomica再次繁荣，相信这条路曾将山谷里的每个定居点连接起来。他以谨慎的乐观态度欢迎新来者，希望每个人能为社区做出持久的贡献。"
			]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "minecraft:textures/mob_effect/hero_of_the_village.png"
				}
			}
			icon_scale: 2.0d
			id: "1980CC28B4B7A708"
			min_width: 500
			quest_enhance_disable_scroll_paging: false
			subtitle: "“村庄并非由房屋构成，而是由选择互助的人们所组成。 - Gavril”"
			tasks: [{
				id: "42A1D90FBD3F95CC"
				title: "Tănase Obșteanul - 市长(狗)"
				type: "checkmark"
			}]
			title: "市长加夫里尔"
			x: -6.5d
			y: -4.0d
		}
		{
			description: [
				"尼古拉的河畔小屋俯瞰着滋养了利登菲尔德世代的潺潺流水。每天日出前，他都会把破旧的小木船驶入薄雾中，直到篮子装满或河流宣告一天结束才会归来。"
				""
				"尼古拉天生安静，却常以冷幽默出人意料。他喜欢与朋友共享长久的沉默，认为对话在不自强求时最有意义。"
				""
				"他了解河流的每个弯道、每个刷怪点，以及鱼类开始活动的每个季节。对他而言，钓鱼与其说是捕鱼，不如说是理解自然的韵律。"
				""
				"他经常说："
				""
				"“你不能催促河流，也不能催促生命。”"
			]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "starcatcher:starcatcher_rod"
				tag: {
					Damage: 0
				}
			}
			icon_scale: 2.0d
			id: "17D65EFA94070A3D"
			min_width: 500
			quest_enhance_disable_scroll_paging: false
			subtitle: "“河流会向愿意等待的人讲述它的故事。”"
			tasks: [{
				id: "01EA870D16385A64"
				title: "渔夫莫什 - 渔夫(OTTER)"
				type: "checkmark"
			}]
			title: "尼古拉 — 渔夫"
			x: 2.5d
			y: 1.0d
		}
		{
			description: [
				"Oana's workshop at the edge of the woods 的烟囱里不断冒出炊烟。架子上堆满了草药、水晶、矿石、干花，还有在暮色中似乎会发光的玻璃瓶。"
				""
				"她的实验偶尔会以壮观的方式失败，让房间充满彩色的烟雾或奇怪的气味，但她把每个错误都当作另一堂待解的课。"
				""
				"她经常说："
				""
				"“失败不过是知识换了一副不同的外衣罢了。”"
			]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "elixirum:item/alchemist_eye"
				}
			}
			icon_scale: 2.0d
			id: "34014C1631F8CAE4"
			min_width: 500
			quest_enhance_disable_scroll_paging: false
			subtitle: "“大自然会向愿意尝试的人揭示她最伟大的秘密。”"
			tasks: [{
				id: "4E85ED1833F18F54"
				title: "Mircea Picurariu - 炼金术士(青蛙)"
				type: "checkmark"
			}]
			title: "奥安娜 — 炼金术士"
			x: 2.5d
			y: -1.0d
		}
		{
			description: [
				"与大多数村民不同，埃琳娜并非在利登菲尔德长大。多年前，她在山谷森林中发现关于被遗忘的定居点的记载后便来到了这里。自那时起，她便致力于揭开维亚·加斯特罗诺米卡的过往历史。"
				""
				"她的小屋堆满了褪色的地图、破碎的陶器、奇怪的硬币，还有架子上贴好标签的文物。每一次发现都只会引出新的问题。"
				""
				"她经常说："
				""
				"“每一处遗迹，都曾是某个人的家。”"
			]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "minecraft:brush"
				tag: {
					Damage: 0
				}
			}
			icon_scale: 2.0d
			id: "0B9002D127F257A3"
			min_width: 500
			quest_enhance_disable_scroll_paging: false
			subtitle: "“过去从未被真正埋葬。我们只是停止寻找它罢了。”"
			tasks: [{
				id: "08BDF5426AF7AEC6"
				title: "Doamna Uliță-Pergament - Archeologist(OWL)"
				type: "checkmark"
			}]
			title: "埃琳娜 — 考古学家"
			x: -3.5d
			y: 3.0d
		}
		{
			description: [
				"维克多曾在遥远的战争中与士兵并肩作战，修复了无数战役中受损的盔甲。那些岁月让他确信，和平比任何胜利都更宝贵，于是他定居在利登菲尔德，希望再也不会听到战争的声音。"
				""
				"与铁匠托马不同，维克多深知旧伤疤的沉重。他比你更早地察觉到了你内心的那份重担。"
				""
				"他经常说："
				""
				"“最强的盾牌，是知道何时不该战斗。”"
			]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "overgeared:steel_chestplate"
				tag: {
					Damage: 0
				}
			}
			icon_scale: 2.0d
			id: "5E6A05A5C52DC816"
			min_width: 500
			quest_enhance_disable_scroll_paging: false
			subtitle: "盔甲无法抵御所有创伤。智慧却能预防其中许多。\""
			tasks: [{
				id: "59A032919AB20D7E"
				title: "Toader Solzosu - 盔甲匠(蜥蜴)"
				type: "checkmark"
			}]
			title: "维克多 — 盔甲匠"
			x: -5.0d
			y: -2.5d
		}
		{
			description: [
				"每晚，艾里斯都会带着祖传的黄铜望远镜登上利登菲尔德上方的山丘，用精美的插图记录星辰、行星和彗星的运动，坚信夜空讲述着比任何图书馆都古老的故事。"
				""
				"村民们常取笑她总向上看，但许多人需要安慰或新视角时，会悄悄来拜访。"
				""
				"她经常说："
				""
				"每当烦恼过重，抬头望天。你会想起它们其实多么渺小。\""
			]
			entity_vis_size: 1.0f
			icon: "supplementaries:globe"
			icon_scale: 2.0d
			id: "0A200C27301BE426"
			min_width: 500
			quest_enhance_disable_scroll_paging: false
			subtitle: "“群星无法为你选择道路。它们只是在提醒你，世界究竟有多么广阔。”"
			tasks: [{
				id: "0790E5147751759A"
				title: "Baba Steliță - 占星師(OWL)"
				type: "checkmark"
			}]
			title: "Iris — 占星术士"
			x: -5.0d
			y: 3.0d
		}
		{
			description: [
				"在阳光初照利登菲尔德的屋顶前，玛尔塔的烘焙坊就已暖意融融。每一块面包、派、糕点和甜卷，都使用伊利亚斯的磨坊面粉、安娜的蜂巢蜂蜜、伊丽莎白果园的水果和代代相传的食谱手工制成。"
				""
				"她相信食物能给予人比言语更深刻的慰藉。每当村民遭遇不幸，玛尔塔都会在日出前悄悄将新鲜的面包放在他们家门口。"
				""
				"她对学徒要求严格，却耐心教导，坚持认为烘焙始于理解食材，而非背诵食谱。"
				""
				"她经常说："
				""
				"“最优质的面包，总带着面粉中的一点爱。”"
			]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "bakery:item/crusty_bread"
				}
			}
			icon_scale: 2.0d
			id: "05D07F1D3D2C139F"
			min_width: 500
			quest_enhance_disable_scroll_paging: false
			subtitle: "“面包只有在给予它时间时才会发酵。”"
			tasks: [{
				id: "1374419BB4991C29"
				title: "玛拉·派尼察 - 面包师（刺猬）"
				type: "checkmark"
			}]
			title: "玛尔塔 — 面包师"
			x: -6.5d
			y: -1.0d
		}
		{
			description: [
				"果园之外的野花丛中，安娜的蜂场从早到晚嗡嗡作响。她把每个蜂巢都当作家人来照料，通过翅膀上的小标记辨认每只蜂后，并通过新鲜蜂蜜的味道感知季节的更替。"
				""
				"她对蜜蜂的迷恋始于童年，当时她从倒下的树上救出了一群受伤的蜜蜂。从那以后，她就相信最渺小的生物往往能教会我们关于合作、耐心和平衡的最伟大道理。"
				""
				"访客惊讶地发现，她在成千上万的蜜蜂中工作时毫无畏惧。她坚持认为蜜蜂能像人一样轻易地感受到平静。"
				""
				"她经常说："
				""
				"“蜂巢之所以强大，是因为每只蜜蜂都在为比自己更伟大的事物而努力。”"
			]
			entity_vis_size: 1.0f
			icon: "minecraft:honeycomb"
			icon_scale: 2.0d
			id: "5EA6DA6C1195AF70"
			min_width: 500
			quest_enhance_disable_scroll_paging: false
			subtitle: "“蜜蜂从不匆忙，却也从不迟到。”"
			tasks: [{
				id: "2E4E480D66DC08EC"
				title: "蜂蜜熊 - 养蜂人(熊)"
				type: "checkmark"
			}]
			title: "安娜 — 养蜂人"
			x: -0.5d
			y: 1.0d
		}
		{
			description: [
				"Iosif 为村庄提供鲜肉，同时尊重每一只经过他手的动物。他坚信，夺取生命需要尊重、精心准备和感恩之心。"
				""
				"尽管他的职业常常让新人感到意外，但孩子们却非常喜爱他。他总会在围裙口袋里放些风干香肠，等孩子们干完活就悄悄分发给他们。"
				""
				"他经常说："
				""
				"“若动物为你的家人提供食物，便不要浪费任何东西来致敬它。”"
			]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "wildernature:item/cassowary_meat"
				}
			}
			icon_scale: 2.0d
			id: "7BA1F100E67E75D7"
			min_width: 500
			quest_enhance_disable_scroll_paging: false
			subtitle: "“不应浪费任何东西——哪怕是感激之情。”"
			tasks: [{
				id: "5FC00771FD240638"
				title: "科斯特尔·马切亚鲁 - 屠夫(熊)"
				type: "checkmark"
			}]
			title: "约瑟夫 — 屠夫"
			x: 1.0d
			y: -1.0d
		}
		{
			description: [
				"索菲亚的工作室充满了蜂蜡、干薰衣草和新鲜香草的宜人香气。架子上摆满了各种尺寸的蜡烛，都是手工精心浇注，并用山谷中采摘的干花装饰的。"
				""
				"有些蜡烛点亮家庭晚餐，有些则陪伴婚礼、节日，或是壁炉旁的静谧夜晚。索菲亚相信，每一簇火焰都会成为某人记忆的一部分。"
				""
				"她常常在工坊外坐了许多个夜晚，看着利登菲尔德的村庄窗户随着蜡烛点燃而一盏盏亮起。"
				""
				"她经常说："
				""
				"黑暗会随着一根根蜡烛的点燃而消失。\""
			]
			entity_vis_size: 1.0f
			icon: "supplementaries:candle_holder"
			icon_scale: 2.0d
			id: "3CFD50B5C4DBE507"
			min_width: 500
			quest_enhance_disable_scroll_paging: false
			subtitle: "“再微弱的光也能指引某人回家。”"
			tasks: [{
				id: "530B2851D45E28DB"
				title: "Ali Mătcăuș - 蜡烛匠人(BEE)"
				type: "checkmark"
			}]
			title: "索菲亚 — 蜡烛匠人"
			x: 4.0d
			y: -2.5d
		}
		{
			description: [
				"Henrik 的工作室从不安静。他制作从简陋凳子到坚固房屋的一切物品，锯子和刨子的节奏在村庄中回响。他的双手布满无数疤痕，但每一件家具都经过精心打磨，从他工作室中传出。"
				""
				"他认为木头有自己的个性。橡木该做成能传世的桌子，而桦木则更适合轻便的活计。他坚持，每棵树都应得到配得上其漫长生命的用途。"
				""
				"年轻的学徒们常常围在他身边，着迷于粗糙的原木如何迅速变成美丽的作品。"
				""
				"他经常说："
				""
				"“切勿与谷物为敌。让木材告诉你它想成为的模样。”"
			]
			entity_vis_size: 1.0f
			icon: "create:mechanical_saw"
			icon_scale: 2.0d
			id: "7F70DE1CB43C4ACD"
			min_width: 500
			quest_enhance_disable_scroll_paging: false
			subtitle: "“房屋由木材建造，家园则由其中的人们建造而成。”"
			tasks: [{
				id: "6564AA19EEFAC647"
				title: "Meșter Ulmărel - Carpenter(BEAVER)"
				type: "checkmark"
			}]
			title: "Henrik — 木匠"
			x: -3.5d
			y: -2.5d
		}
		{
			description: [
				"玛格达莱娜的农场石窖里，一排排陈年奶酪整齐摆放。有的已静置数周，有的则已有数年之久。"
				""
				"她有着超乎寻常的耐心，相信所有有价值的事物都需要时间来沉淀——无论是奶酪、友谊，还是人。"
				""
				"利登菲尔德的许多食谱，都始于她精心制作的食材。"
				""
				"她经常说："
				""
				"“时间也是一种配料。”"
			]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
