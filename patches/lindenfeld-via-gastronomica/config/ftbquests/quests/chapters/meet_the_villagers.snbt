			y: -2.5d
		}
		{
			description: [
				"村庄广场旁藏着一座朴素的图书馆，里面摆满了历经岁月洗礼的书籍、手稿和代代相传的地图。阿格尼斯毕生致力于保存她所能找到的每一个故事、食谱、传说和家族记录。"
				""
				"她轻声细语，仿佛生怕打扰到周围的书籍。每当有旅人到来，她都热切地询问他们是否学到了值得记录的新故事。"
				""
				"她梦想着复兴被遗忘的“美食之路”的历史。"
				""
				"她经常说："
				""
				"“知识只有在无人选择去记住它时才会消失。”"
			]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "jamlib:textures/gui/writable_book.png"
