			x: 2.5d
			y: -2.5d
		}
		{
			description: [
				"俯瞰着利登费尔德的小墓地由马泰伊照料，他静静地打理着每一座坟墓，仿佛它们都属于自己家人的一员。"
				""
				"他知道刻在风化石上的每一个名字，常常向访客讲述那些长眠者背后的故事，让他们的记忆永存。"
				""
				"与阴郁相反，Matei 认为缅怀逝者能让人更珍惜生者。"
				""
				"他经常说："
				""
				"“破坏会消失，但爱不会。”"
			]
			entity_vis_size: 1.0f
			icon: "maidensmerrymaking:gravestone_topped"
			icon_scale: 2.0d
			id: "5F1EE1DAE1677308"
			min_width: 500
			quest_enhance_disable_scroll_paging: false
			subtitle: "“只要还有人记得他们的名字，就没人会被真正遗忘。”"
			tasks: [{
				id: "1D93BCD743144C91"
				title: "夜猫子守墓人 - 夜猫子守墓人(NIGHT OWL)"
