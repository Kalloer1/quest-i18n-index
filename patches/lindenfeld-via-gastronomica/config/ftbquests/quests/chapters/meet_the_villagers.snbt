			x: -2.0d
			y: 3.0d
		}
		{
			description: [
				"米赫尼亚塑造了利登菲尔德的几乎每一座桥梁、烟囱和石墙。他耐心细致，认为美在于精准而非装饰。"
				""
				"他工作时很少说话，声称分心的手会犯粗心的错误。许多年轻的工匠都向他寻求建议，不过他通常通过示范而非讲解来教学。"
				""
				"他经常说："
				""
				"“量两次，塑一次。”"
			]
			entity_vis_size: 1.0f
			icon: "minecraft:stonecutter"
			icon_scale: 2.0d
			id: "4E1BBD24E599205B"
			min_width: 500
			quest_enhance_disable_scroll_paging: false
			tasks: [{
				id: "5845F6935FFCC1B9"
				title: "莫什·博洛瓦内尔 - 石匠(熊)"
				type: "checkmark"
			}]
			title: "米赫尼亚 — 石匠"
			x: -2.0d
			y: -2.5d
		}
		{
			description: [
				"阿德里安在利登菲尔德居住的时间，不如在美食之路上旅行的时间长。他的马车载着来自遥远山谷的香料、精美的织物、奇特的种子、手工工具，以及从他访问过的每个定居点收集的故事。"
				""
				"没有人确切知道他走了多远。每当被问及，他只是微微一笑，然后转移话题。"
				""
				"他鼓励村民对外山之外的世界保持好奇，同时不忘自己的家在哪里。"
				""
				"他经常说："
				""
				"“一场漫长的旅程，用回忆而非里程来衡量。”"
			]
			entity_vis_size: 1.0f
			icon: "farm_and_charm:supply_cart"
			icon_scale: 2.0d
			id: "11561BC67BCD819E"
			min_width: 500
			quest_enhance_disable_scroll_paging: false
			subtitle: "“道路能教会课堂永远无法教会的道理。”"
			tasks: [{
				id: "0F4F7AAF79D38FD8"
				title: "Tănase Neguțiu - 商人(CROW)"
				type: "checkmark"
			}]
			title: "Adrian — 商人"
			x: -6.5d
			y: 3.0d
		}
		{
			description: [
				"附近山丘上的旧风车是埃利亚斯家族世代相传的产业。每袋运给他的谷物，最终都会变成面粉，养活整个山谷。"
				""
				"耐心可靠的埃利亚斯，更喜欢倾听而不是说话。"
				""
				"每当风帆开始转动，村民们就知道新鲜的面包很快就会出炉。"
				""
				"他经常说："
				""
				"“村庄一起转动，就像磨坊一样。”"
			]
			entity_vis_size: 1.0f
