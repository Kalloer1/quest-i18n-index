		{
			dependencies: ["25618BAFBB21A06C"]
			description: [
				"Y - 打开技能书。"
				"U - 打开废料库存，你可以在这里销毁以+1开头的物品，以获得未来升级所需的碎片。"
				"O - 打开酿造界面。"
				"J - 打开烹饪大师。"
				"R - 选择法术。"
				"V - 可以施放法术"
				"C - 更改行走模式（缓慢行走）"
				"X - 坐下来"
				"B - 打开背包"
				"M - 打开地图"
				".  - 添加一个路径点"
			]
			entity_vis_size: 1.0f
