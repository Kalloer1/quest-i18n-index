	quest_links: [ ]
	quests: [
		{
			description: [
				"Lidenfeld，这片位于黑暗领域东北角的乐土，山峦、森林与平原交错，清澈的河流蜿蜒流淌，广袤的草地开满鲜花，陡峭的山峰与生机勃勃的海洋交相辉映。这里有青翠的草地、传统的房屋、清澈的泉水、新鲜的空气，以及充足的宁静与安详。Lidenfeld拥有这一切，若它们不为人所知，未被旅行者探访与探索，那将是一大憾事——而这些旅行者，正是在这片土地上行走时，感受着幸福与健康所带来的喜悦与欢欣。"
				"这里的人们热情好客，乐于敞开家门，用丰饶的物产款待旅人。天堂的这片角落，有一条名为Via Gastronomica的路线贯穿，它连接着村庄、人民、故事，以及最重要的——风味。"
				"你的故事将从这里开始！"
			]
			entity_vis_size: 1.0f
			id: "25618BAFBB21A06C"
			quest_enhance_disable_scroll_paging: false
			tasks: [{
				id: "1F3EB7F071704AD7"
				title: "欢迎来到林登菲尔德 - 美食之路"
				type: "checkmark"
			}]
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["25618BAFBB21A06C"]
			description: [
				"今年春天如约而至。老妇人们曾预言过。春天是每年新生的季节。冰雪融化，种子发芽，树木长叶，鲜花盛开，阳光只会带来微笑与喜悦。老妇人也曾预言夏天会酷热难耐……但是……我迫不及待地想潜入清凉的河流，在树荫下的帐篷旁钓鱼，喝着冰啤酒，闻着烤鸡的香气。"
				"我更喜欢秋天。大地的丰收等待收割，果实等待采摘制成果酱，木柴也已堆好——一切都在等待白雪皑皑的冬天。"
				"你知道我冬天最喜欢做什么吗？我最喜欢坐在壁炉前，看着火焰自由燃烧，温暖整个房间……哦，还有热巧克力！没有什么能比上一杯温暖心灵的巧克力更棒了！"
			]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "sereneseasons:item/calendar_00"
				}
			}
			id: "77FC9A2330B93988"
			min_width: 400
			quest_enhance_disable_scroll_paging: false
			tasks: [{
				id: "620CAE29691005A6"
				title: "季节变化模组 Seasons"
				type: "checkmark"
			}]
			x: -0.5d
			y: 2.0d
		}
		{
			dependencies: ["25618BAFBB21A06C"]
			description: [
				"铁锭在高炉里烧红了。我需要钳子来夹起这个滚烫的锭子！不然我的手可能会被烫伤！"
				"好……现在把铁放在砧上，拿起锤子，开始敲打！趁热打铁，正是时候！"
				"砰——一击即中！砰，砰……哦……真完美……我创造了多么美丽的形状！现在我需要把它浸入冷水里冷却，让它更耐用。再稍微打磨一下，就完成了！我有一件超棒的工具！它很完美……除了那个洞……不过没关系，我会制作更多工具，而这些项目都会教我如何打造出完美的工具！"
			]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "overgeared:smithing_hammer"
				tag: {
					Damage: 0
				}
			}
			id: "739EE5E6A8F1D30D"
			quest_enhance_disable_scroll_paging: false
			subtitle: "炽热的铁块"
			tasks: [{
				id: "53120405E3F0C479"
				title: "锻造"
				type: "checkmark"
			}]
			x: 1.5d
			y: -1.5d
		}
		{
			dependencies: ["25618BAFBB21A06C"]
			description: [
				"通过动态的本地经济建立你的生计，每件物品都有价值，每个职业都为村庄的繁荣做出贡献。通过耕作、捕鱼、狩猎、采矿、烹饪、制作和完成村民的请求来赚取金钱。"
				""
				"与其遵循单一道路，Lidenfeld 鼓励你选择自己的职业——或者精通所有职业。出售原材料快速获利，将其加工成贵重物品，或创造能卖出高价的高品质产品。"
				""
				"随着村庄的发展，新的商业、商人、配方和机遇将随之而来，为您的冒险之旅带来满满的成就感。"
				""
				"同时，本整合包的设计让你只需用一种方式就能赚钱：Via Gastronomica 上的餐厅或当地小吃店。"
				""
				"建造一家餐厅，并按照主线任务书中的说明操作。你可以将美味的食谱卖给 Via Gastronomica 上的美食家，换取一些现金。这笔钱目前用于通过任务书解锁与村民交易的机会。除此之外，一切均以物易物——用物品换取绿宝石等。"
			]
			entity_vis_size: 1.0f
			icon: "numismatics:crown"
			id: "041AACFF5E001F52"
			min_width: 300
			quest_enhance_disable_scroll_paging: false
			subtitle: "林登菲尔德的经济体系"
			tasks: [{
				id: "6557146F9CDD1376"
				title: "经济系统"
				type: "checkmark"
			}]
			x: 0.5d
			y: -2.0d
		}
		{
			dependencies: ["25618BAFBB21A06C"]
			description: ["每种物品都有自己的稀有度，这正是 Lidenfeld 成为真正 RPG 的原因！无论是蔬菜、水果还是其他食物——它们的稀有度由不同颜色的星星表示——武器和盔甲也有各自的稀有度。它们从普通（Common）开始，至于能升到多高……你得自己去探索！此外，每件物品都可以从 +1 升级到 +15，每次升级都会大幅提升你的战斗力！"]
			entity_vis_size: 1.0f
			icon: "weaponrarity:ascendant_fragment"
			id: "6AF4351C4A517049"
			quest_enhance_disable_scroll_paging: false
			tasks: [{
				id: "2187EF2BF88818FC"
				title: "物品稀有度"
				type: "checkmark"
			}]
			x: 2.0d
			y: 0.5d
		}
		{
			dependencies: ["25618BAFBB21A06C"]
			description: ["每件物品都需要升级材料！你得去肝了……我说的就这么多！"]
			entity_vis_size: 1.0f
			icon: "weaponrarity:enchant_chance_3"
			id: "11FED5358228E9F2"
			quest_enhance_disable_scroll_paging: false
