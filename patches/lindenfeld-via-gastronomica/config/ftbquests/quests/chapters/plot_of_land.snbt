			id: "1ED5AF0AD7257D30"
			quest_enhance_disable_scroll_paging: false
			tasks: [{
				id: "33CDC5A7F38D8FAE"
				title: "接近策略"
				type: "checkmark"
			}]
			x: 14.0d
			y: -4.0d
		}
		{
			description: ["遵循有机农业或永续农业的原则，并不一定需要拥有大片土地。这些只是利用现有空间的不同方法，无论其大小如何。"]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "jei:textures/jei/atlas/gui/icons/info.png"
				}
			}
			id: "0527BCD2AD7E1994"
			quest_enhance_disable_scroll_paging: false
			tasks: [{
				id: "2124A69229053A62"
				title: "对新事物保持开放态度"
				type: "checkmark"
			}]
			x: 11.0d
			y: -4.0d
		}
		{
			dependencies: ["1ED5AF0AD7257D30"]
			description: ["有机农业基于环境与食物种植方式相互独立的理念。其原则考虑了土壤和气候，同时避免使用有毒物质。"]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "jei:textures/jei/atlas/gui/icons/info.png"
