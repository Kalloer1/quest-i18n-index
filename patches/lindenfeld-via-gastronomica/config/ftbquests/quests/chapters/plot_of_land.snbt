			id: "60EB30547B29A619"
			quest_enhance_disable_scroll_paging: false
			tasks: [{
				id: "46A8A32C82D7864D"
				title: "有机农业"
				type: "checkmark"
			}]
			x: 3.5d
			y: -1.0d
		}
		{
			dependencies: ["60EB30547B29A619"]
			description: ["通过堆肥改善土壤健康是有机农业的关键原则，因为土壤不像化肥那样，是各种生命形式的家园。化肥缺乏堆肥中的腐殖质——即分解的植物材料和土壤生物——而这些腐殖质能提供活力并帮助保持水分。"]
			entity_vis_size: 1.0f
			icon: {
