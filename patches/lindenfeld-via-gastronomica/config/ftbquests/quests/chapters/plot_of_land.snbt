		{
			dependencies: ["1ED5AF0AD7257D30"]
			description: ["采矿、钓鱼或探索过后，收获番茄的空间问题变得很严重。各式各样的背包和箱子将极大地帮助我们存放物品。"]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "jei:textures/jei/atlas/gui/icons/info.png"
