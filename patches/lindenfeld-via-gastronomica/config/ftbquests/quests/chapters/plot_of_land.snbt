	quests: [
		{
			dependencies: ["0527BCD2AD7E1994"]
			description: ["种植自己的食物能带来强烈的满足感。我们不仅追求效率，更倡导与自然和谐共处。找到平衡点，你会发现自然的神奇与亲近。本章将提供所需信息，助你充分利用土地。我会重点介绍节省园艺时间的方法，并教你如何延长生长季，让你享受夏日阳光，并在整个冬季持续收获新鲜作物。"]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "jei:textures/jei/atlas/gui/icons/info.png"
				}
			}
			id: "1A696FC757636B64"
			quest_enhance_disable_scroll_paging: false
			tasks: [{
				id: "387B2DE8C237ECE3"
				title: "生产力"
				type: "checkmark"
			}]
			x: 12.5d
			y: -4.0d
		}
		{
			dependencies: ["1A696FC757636B64"]
			description: ["种植自己的食物是新手园丁的重要一步，尽管众多的技巧可能令人望而生畏。然而，技巧之多恰恰印证了一个简单的道理：并没有唯一“正确”的方法。试试任何吸引你的方法——有些方法几乎不需要费力，甚至都不用拿起铲子（太棒了）。"]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "jei:textures/jei/atlas/gui/icons/info.png"
				}
