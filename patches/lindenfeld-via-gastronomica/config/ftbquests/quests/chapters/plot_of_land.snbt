			}]
			x: 11.0d
			y: 1.0d
		}
		{
			dependencies: ["1ED5AF0AD7257D30"]
			description: ["每年年初，在开始园艺之前，我们都会制定轮作计划。听起来很麻烦，但这是必要的。换句话说，某些植物科系更容易受到特定疾病的侵害，也会招来害虫。此外，不同植物科系需要土壤中不同的养分。通过将某些作物从一个地方移到另一个地方，你可以在问题出现之前让它们茁壮成长。"]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "jei:textures/jei/atlas/gui/icons/info.png"
				}
			}
			id: "31FE39E3EDB7A0B2"
			quest_enhance_disable_scroll_paging: false
