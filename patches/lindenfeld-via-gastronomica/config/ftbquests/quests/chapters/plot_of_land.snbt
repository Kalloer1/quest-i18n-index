		{
			dependencies: ["1ED5AF0AD7257D30"]
			description: ["种植自己的食物是一个相对简单的过程；植物要生存，几乎只需要养分和水。但要提高产量并获得丰收，则需要付出更多努力。定期浇水、施肥和精心照料能让植物更强壮、更坚韧。关键在于确保作物生长在最佳的土壤条件下。"]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "jei:textures/jei/atlas/gui/icons/info.png"
