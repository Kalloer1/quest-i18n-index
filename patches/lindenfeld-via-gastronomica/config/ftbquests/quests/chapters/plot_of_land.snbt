				title: "怎样才能获得丰收呢？"
				type: "checkmark"
			}]
			x: 11.0d
			y: -1.0d
		}
		{
			dependencies: ["3DBE434C128C2597"]
			description: ["堆肥是通过加速有机物自然分解来促进植物生长的过程。在特定条件下，细菌、真菌和微生物会迅速分解废物，从而提供优质的堆肥原料，可用于农田。生产优质堆肥取决于混合比例的均衡性。"]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
