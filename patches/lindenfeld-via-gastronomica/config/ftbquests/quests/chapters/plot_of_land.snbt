		}
		{
			dependencies: ["1ED5AF0AD7257D30"]
			description: ["受保护植物栽培是指通过温室或阳光房来延长生长季节，但也有小规模的选择，如钟形罩或冷床，可为植物创造适宜的温度条件。"]
			entity_vis_size: 1.0f
			icon: {
