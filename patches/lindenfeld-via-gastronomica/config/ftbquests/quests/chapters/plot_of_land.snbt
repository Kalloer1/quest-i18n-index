				id: "3AC550F296C4AB2A"
				title: "全满的储藏室"
				type: "checkmark"
			}]
			x: 11.0d
			y: -7.0d
		}
		{
			description: ["在夏季和初秋，这些是将新鲜水果吃完后剩余部分保存下来的绝佳方法"]
			entity_vis_size: 1.0f
