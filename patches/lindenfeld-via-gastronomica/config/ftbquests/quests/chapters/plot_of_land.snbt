			title: "收获与存储系统"
			x: 14.5d
			y: -6.0d
		}
		{
			dependencies: ["1ED5AF0AD7257D30"]
			description: ["一年中某些时候会收获大量作物，但收获季节很短。不过，你可以通过储存和保存这些季节性作物，让它们的美味贯穿全年。更棒的是，一些保存方法能提升风味，确保在寒冷的冬日里也能品尝到可口的食物。"]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "jei:textures/jei/atlas/gui/icons/info.png"
				}
			}
			id: "4A0BF2633CF183E6"
			quest_enhance_disable_scroll_paging: false
			tasks: [{
				id: "15835804963692B5"
				title: "保护与保存"
				type: "checkmark"
			}]
			x: 11.0d
			y: -6.0d
		}
		{
			description: ["与季节和谐共处，你会发现当地的食物供应发生了变化。但若只吃当季作物，在寒冷黑暗的月份里可能会缺乏维生素——如果你有夏季作物的储备，就能解决这个问题。此外，有时在隆冬时节，你会想念美味的水果布丁或意面番茄酱。将收获的作物制成罐头食品吧。"]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "deco_storage:block/barrel_top_carrots"
				}
			}
			id: "287E73866B5B8C4E"
			quest_enhance_disable_scroll_paging: false
