			x: 11.0d
			y: 0.0d
		}
		{
			dependencies: ["235177AE3FB2CA01"]
			description: ["框架堆肥的主要优势之一是，如果系统分层设计，它将占用极少的空间。"]
			entity_vis_size: 1.0f
			icon: {
