		{
			dependencies: ["3A1A34AF083E580A"]
			description: ["炉灶的烹饪方式与篝火相同，但一次最多可烹饪6种物品。"]
			hide: true
			icon: "farmersdelight:stove"
			id: "2C3A399F6BEDD9CD"
			rewards: [{
				id: "441AA037C2D4240F"
