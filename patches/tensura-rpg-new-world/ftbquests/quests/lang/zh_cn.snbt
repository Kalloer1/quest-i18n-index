	quest.4A01000000000018.title: "谱系编年史：完成一条路线"
	quest.5A01000000000001.quest_desc: [
		"两扇门通往这些神秘学研究：与灵体的联结，和实践塑造的魔典。两者都未要求你放弃另一方。"
		"每个精神柱都遵循从次级到主级的元素顺序。链接会打开《精神升华》中记录过的相同任务，没有第二次奖励。魔典路径遵循《新艺术》。"
		"完成 Reincarnation 和 The Voice of the World 后，再开始本章。"
	]
	quest.5A01000000000001.quest_subtitle: "灵性契约 神秘符文魔法"
	quest.5A01000000000001.title: "&6&l魔法的双重支柱"
	quest.5A01000000000002.quest_desc: [
		"火焰回应着被其温暖与危险所吸引的旅人。从一份小契约开始，了解此元素与你的契合之处。"
		""
		"签订一个较低或更高等级的火焰灵魂契约。"
	]
	quest.5A01000000000002.quest_subtitle: "与火焰的较弱契约"
	quest.5A01000000000002.title: "较小的火焰"
	quest.5A01000000000003.quest_desc: [
		"水是与塑造河流和海洋的元素相关的纽带。从一个较小的契约开始，了解这个元素如何适合你的角色。"
		""
		"签订一个较低或更高等级的水之灵契约。"
	]
	quest.5A01000000000003.quest_subtitle: "与水的较弱契约"
	quest.5A01000000000003.title: "较弱的水元素（Lesser Water）"
	quest.5A01000000000004.quest_desc: [
		"土是耐心契约的元素，扎根于你脚下的世界。从一个较小的契约开始，了解这个元素如何适合你的角色。"
