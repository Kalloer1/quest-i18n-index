	quest.0DB100000000000D.quest_subtitle: "为你所选的道路发现一门艺术"
	quest.0DB100000000000D.title: "抗毒能力"
	quest.0DB100000000000E.quest_desc: [
		"引导性的智慧可以成为一种独特的艺术。"
		""
		"提升认知能力，学习并施放技能的速度更快，能够评估目标，使用分析来复制技能和处理材料以制作或克隆物品或装备。"
		"学习大贤者。在技能菜单中查看获取条件。"
	]
	quest.0DB100000000000E.quest_subtitle: "为你所选的道路发现一门艺术"
	quest.0DB100000000000E.title: "伟大的贤者"
	quest.0DB100000000000F.quest_desc: [
