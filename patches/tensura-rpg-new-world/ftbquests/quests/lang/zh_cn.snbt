		"神圣之路为你的精神之旅带来了另一种羁绊。让最初的羁绊成为更深的承诺。去寻求它的中级形态。"
		""
		"签订中等或以上等级的神圣精神契约。"
	]
	quest.09B1000000000016.quest_subtitle: "与神圣签订的中度契约"
	quest.09B1000000000016.title: "中等神圣度"
	quest.09B1000000000017.quest_desc: [
		"神圣之路为你的精神之旅带来了另一种羁绊。更伟大的契约标志着你所选择的羁绊的进阶阶段。"
		""
		"签订更高等级或更高级的圣灵契约。"
	]
	quest.09B1000000000017.quest_subtitle: "与神圣的更伟大契约"
	quest.09B1000000000017.title: "更伟大的神圣"
	quest.09B1000000000018.quest_desc: [
		"神圣之路为你的精神之旅带来了另一种羁绊。主神层级位于此契约所记载的攀登终点。"
		""
		"签订领主或以上等级的圣灵契约。"
	]
	quest.09B1000000000018.quest_subtitle: "领主与神圣签订契约"
	quest.09B1000000000018.title: "神圣领主"
	quest.0AB1000000000001.quest_desc: [
		"冒险家的生活，既在远方道路上，也在工坊中。研究锻造炉，练习技艺，或探索世界的其他地方。"
		"三个部分分别记录制作、训练和探险。独立里程碑为可选项；箭头显示关联步骤。"
		"完成“熔炼基础：铁锭”后，再开始本章内容。"
	]
	quest.0AB1000000000001.quest_subtitle: "穿越卡迪纳尔世界的旅途中又一个里程碑"
	quest.0AB1000000000001.title: "Tensura World and Craft: 开始"
	quest.0AB1000000000002.quest_desc: [
		"蓝图是从一位工匠传给另一位工匠的技艺。"
		""
		"使用一个 Schematic 蓝图。"
	]
	quest.0AB1000000000002.quest_subtitle: "穿越卡迪纳尔世界的旅途中又一个里程碑"
	quest.0AB1000000000002.title: "学习一个蓝图 (Learn a Schematic)"
