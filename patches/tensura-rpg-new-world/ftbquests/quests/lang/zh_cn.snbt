	quest.0CB1000000000017.quest_subtitle: "穿越卡迪纳尔世界的旅途中又一个里程碑"
	quest.0CB1000000000017.title: "遗忘的玫瑰 (Rose of Oblivion)"
	quest.0DB1000000000001.quest_desc: [
		"你选择的技艺将塑造你的冒险者之路。研究适合你种族和职业的道路，决定哪些值得精通。"
		"获取要求显示在技能菜单中。每个技能都是可选的；相关的第二步要求掌握该技能。"
		"完成 Reincarnation 和 the Voice of the World 后，再开始本章。"
	]
	quest.0DB1000000000001.quest_subtitle: "穿越卡迪纳尔世界的旅途中又一个里程碑"
	quest.0DB1000000000001.title: "选择你的技能发展路线"
	quest.0DB1000000000002.quest_desc: [
		"有些危险在现身之前就已经宣告了自己的到来。"
		""
		"使用魔法水晶来感知周围的实体。"
		"学习魔法感知。在技能菜单中查看获取条件。"
	]
	quest.0DB1000000000002.quest_subtitle: "为你所选的道路发现一门艺术"
	quest.0DB1000000000002.title: "魔法感知"
	quest.0DB1000000000003.quest_desc: [
		"让魔法感知成为一门精通的艺术，而非仅仅初学的课程。"
		""
		"使用魔法感知直到掌握为止。学会它仅仅是第一步。"
	]
	quest.0DB1000000000003.quest_subtitle: "掌握你选择的艺术形式"
	quest.0DB1000000000003.title: "魔法感知大师"
	quest.0DB1000000000004.quest_desc: [
		"知识可能和你手中的武器一样宝贵。"
		""
		"评估对手的实力，以了解他们的总体强度。"
		"学习分析性鉴定。在技能菜单中查看其获取条件。"
	]
	quest.0DB1000000000004.quest_subtitle: "为你所选的道路发现一门艺术"
	quest.0DB1000000000004.title: "分析性评估"
	quest.0DB1000000000005.quest_desc: [
		"对于施法者而言，心智是战场的一部分。"
		""
		"提高施法速度，让你能更快地释放魔法，同时提升你的反应速度。"
		"学习思维加速。在技能菜单中查看获取条件。"
	]
	quest.0DB1000000000005.quest_subtitle: "为你所选的道路发现一门艺术"
	quest.0DB1000000000005.title: "思维加速 Thought Acceleration"
	quest.0DB1000000000006.quest_desc: [
		"两地之间的道路，并非总需亲自走过。"
		""
		"撕裂空间，为自己和盟友开辟一条安全通道。"
		"学习空间运动。在技能菜单中查看获取条件。"
	]
	quest.0DB1000000000006.quest_subtitle: "为你所选的道路发现一门艺术"
	quest.0DB1000000000006.title: "空间运动 (Spatial Motion)"
	quest.0DB1000000000007.quest_desc: [
		"为即将到来的试炼准备多层防御工事。"
		""
		"用多种强大的防御屏障来保护自己。"
		"学习多层屏障。在技能菜单中查看获取条件。"
	]
	quest.0DB1000000000007.quest_subtitle: "为你所选的道路发现一门艺术"
	quest.0DB1000000000007.title: "多层屏障"
	quest.0DB1000000000008.quest_desc: [
		"生存是一门值得在你下一次伟大试炼前学习的艺术。"
		""
		"加快身体的自然再生速度，提高生存能力。"
		"学习自我再生。请在技能菜单中查看获取条件。"
	]
	quest.0DB1000000000008.quest_subtitle: "为你所选的道路发现一门艺术"
	quest.0DB1000000000008.title: "自我再生能力"
