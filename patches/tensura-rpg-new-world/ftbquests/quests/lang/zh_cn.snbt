	quest.0CB1000000000016.title: "多余的引火器（Extraneous Firestarter）"
	quest.0CB1000000000017.quest_desc: [
		"一朵末地之花开启了你气场研究的遥远分支。"
		""
		"击杀末影龙，使遗忘玫瑰生长出来"
