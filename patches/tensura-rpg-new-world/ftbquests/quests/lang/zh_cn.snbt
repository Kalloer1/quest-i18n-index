	quest.0DB1000000000010.quest_subtitle: "为你所选的道路发现一门艺术"
	quest.0DB1000000000010.title: "掠食者"
	quest.0DB1000000000011.quest_desc: [
		"消耗之路远不止于最初的教诲。"
		""
