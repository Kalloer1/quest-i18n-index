				}
			]
		}
		{
			x: -1.5d
			y: 0.0d
			description: ["要制作它，先制作一个 Manaweaver's Wand。vinteum 魔杖的使用次数有限，最终会损坏，不过之后你可以制作更强大的、永久耐用的魔杖。"]
			dependencies: ["0136A26F173019F7"]
