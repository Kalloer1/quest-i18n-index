	quests: [
		{
			x: -1.5d
			y: 0.5d
			description: ["一本包含模组完整指南的书。我们也会在这里传达大部分信息。"]
			dependencies: ["4C439E5D16C1800F"]
			id: "7FD08527DAC3412B"
			tasks: [{
				id: "22A188B63BCA4833"
				type: "item"
				item: {
					id: "occultism:dictionary_of_spirits"
					Count: 1b
					tag: {
						"modonomicon:book_id": "occultism:dictionary_of_spirits"
					}
				}
			}]
		}
		{
			x: 0.0d
			y: 0.5d
			description: ["将安山岩投入灵火中，借助灵体的力量，我就能将其转化为其他石头！"]
			dependencies: ["7FD08527DAC3412B"]
			id: "437B3B650AF628A6"
			tasks: [{
				id: "50122E6EFDF5E0FF"
				type: "item"
				item: "occultism:otherstone"
			}]
		}
		{
			x: 1.5d
			y: 0.5d
			description: ["和其他石头一样，我们需要借助精灵的力量，为我们的树苗施加附魔，从而获得一种名为 Otherworldly Wood 的木材。"]
			dependencies: ["437B3B650AF628A6"]
			id: "328BEDAF14C9E0D9"
			tasks: [
				{
					id: "17A1A460CFB80C08"
					type: "item"
					item: {
						id: "occultism:otherworld_sapling_natural"
						Count: 1b
						tag: { }
					}
				}
				{
					id: "2DDFC8676845122F"
					type: "item"
					item: "occultism:otherworld_log"
				}
			]
		}
		{
			x: 3.0d
			y: 0.5d
			description: ["用灵魂之火进一步处理异界木，可以将其净化为原始形态：异界灰。用这东西，我们就能着手为第一个仪式获取一些粉笔了。"]
			dependencies: ["328BEDAF14C9E0D9"]
			id: "5E5684FF9823C30B"
			tasks: [{
				id: "196D31F3F10EA04F"
				type: "item"
				item: "occultism:otherworld_ashes"
			}]
		}
		{
			x: 4.5d
			y: 0.5d
			description: ["与其他世界的木材一样，Otherstone 也可以被加工成基础材料用作粉笔。"]
			dependencies: ["5E5684FF9823C30B"]
			id: "6EF60167419FF88A"
			tasks: [{
				id: "5635CEF8F8CC7675"
				type: "item"
				item: "occultism:burnt_otherstone"
			}]
		}
		{
			x: -3.0d
			y: 0.5d
			description: ["恶魔之梦是一种草药，能赋予人类“第三眼”，让他们看到另一个世界与我们世界的交汇之处。"]
			dependencies: ["6234129C9C45C1E0"]
			id: "4C439E5D16C1800F"
