	quest.296BBBC64A053FB7.quest_desc: ["由植物天然纤维制成的绳子，适用于基础配方和手工艺。"]
	quest.296BBBC64A053FB7.quest_subtitle: "&b纺织品"
	quest.29C3CF06CE06C9ED.quest_desc: ["Nos tempos de reis e dragões, as fornalhas não eram apenas pedras empilhadas... eram milagres em forma de grelha! Construa a sua e descubra o poder ancestral de transformar carne crua em banquete. Só cuidado para não assar o seu elmo por acidente."]
	quest.29C3CF06CE06C9ED.quest_subtitle: "&bBraseiro"
	quest.2E55583F913E1EEF.quest_desc: ["Um dos recursos mais importantes para sobreviver, o &cfogo&r pode ser usado para cozinhar alimentos, secar as roupas e até para afastar monstros! Sim, eu disse monstros..."]
	quest.2E55583F913E1EEF.quest_subtitle: "&6辉煌"
	quest.2EF703F16ABDCF91.quest_desc: ["从植物中获得的干草，用作各种功能的基础材料。"]
