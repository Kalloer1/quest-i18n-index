	task.0571D743D7196EEC.title: "击杀厌世蜂巢意识"
	task.05E5F8949B3E1718.title: "&6&l任务：&r&4欢迎来到&c&l恐怖乐园 2 🏚️🩸"
	task.0BBF9D6D2168351E.title: "坠入虚空"
	task.210F79F6B1C814AF.title: "击杀蝎形嗜血者"
	task.2DDACC6C695F69B5.title: "击杀蜘蛛飞蛾"
	task.2ED2EE44C83B18D5.title: "击杀折磨者"
	task.464557CB7AA848BE.title: "找到原始巢穴"
	task.47B3734FDDE89521.title: "击杀夜之巫妖"
	task.4AB3FD4832AD7985.title: "击杀腐化冠军"
	task.4CC40EF90834D7E7.title: "找到蜂巢意识密室"
	task.5572CDF7C62C8E47.title: "击杀龙形虚空鞭挞者"
	task.6D92252081C9B17E.title: "击杀虚空之花"
	task.7485638096710854.title: "击杀灵魂编织者"
