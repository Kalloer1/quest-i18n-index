	quest.1AFFB729F9463546.quest_desc: [
		"&6基础漏斗库存&r是用于&d存储网络&r的简易&a导入&r/&c导出&r方案。"
		""
		"&6基础库存漏斗&r可以连接到方块的上部或下部。 &b库存电缆&r无法连接到漏斗的侧面。"
		""
		"手持物品右键&6基础漏斗&r，即可将该物品设为过滤项。也可以使用&a物品过滤器&r来过滤多种物品。"
	]
	quest.1B2C271C4D31E613.quest_desc: [
		"&dPotion Flask&r 可储存 8 次药水充能。"
		""
		"要填充水瓶，请将水瓶用于一个&bPotion Jar&r，或在合成网格中将水瓶与药水组合。"
		""
		"潜行状态下，将&dPotion Flask&r用于&bPotion Jar&r即可将其清空。"
	]
	quest.1B2C271C4D31E613.quest_subtitle: "可重复使用的药水瓶"
