	quest.7987D3C92075DAAA.title: "神秘龙裔盔甲"
	quest.79B43071AE4304F3.quest_desc: ["一个&6Flux Point&r会从你的&aFlux Network&r中传输能量"]
	quest.79B43071AE4304F3.quest_subtitle: "把这个贴在需要能量的东西上"
	quest.7A5378E65048E19E.title: "+2 魅力槽位"
	quest.7A57481AACFA9156.quest_desc: [
		"&6Touhou Little Maids&r的核心，当然就是&dLittle Maids&r了！"
		""
		"它们可以通过&e祭坛&r合成，或在&c商店&r（&a小女仆新手包&r）中获得"
		""
		"&d小女仆&r可以用&b蛋糕&r驯服。驯服后，右键会打开&d女仆的&rGUI。"
	]
	quest.7A57481AACFA9156.title: "召唤你的第一个小女仆"
	quest.7A6AEDB31123F492.quest_desc: [
		"说实话，&6无线终端&r有点没用（抱歉了tom）。"
		""
		"手持&6无线终端&r时，可延长操作距离至16格，以打开你的&a存储/合成终端&r。"
		""
		"把它看作是为真正的无线终端，即&d高级无线终端&r，制作的材料吧！"
	]
	quest.7AA21CA6FACA5FC0.quest_desc: ["将2个&b分裂符文&r应用于&6附魔者之弓&r或&6附魔者之弩&r的铭文法术。"]
	quest.7AA99CF0A5F7D6FA.quest_subtitle: "更改每次激活时生成的实体数量"
	quest.7AA99CF0A5F7D6FA.title: "生成数量"
	quest.7AB40007CDFC0D92.title: "Tier 2 种子"
	quest.7B2A6ACA6E409B58.quest_desc: [
		"&6&l铁质熔炉&r&r"
		"将基础熔炉升级为更快速、更强大的进阶熔炉，能随进度更高效地冶炼。"
	]
	quest.7B2A6ACA6E409B58.quest_subtitle: "速度提升25%"
	quest.7B2A6ACA6E409B58.title: "铁质熔炉"
	quest.7B4CCE4A0D45106F.quest_desc: [
		"&6Matter Network Pipes&r 连接你 &6Matter Network&r 中的所有 &dReplication&r 机器。"
		""
		"一旦你拥有&b复制终端&r，它们就能传输&a物质&r、&c能量&r，甚至是&e物品&r。"
	]
	quest.7B6ADA18EB886975.quest_desc: [
		"&6Bookwyrm Charms&r 可用于 &dStorage Lectern&r 以增加可访问的背包数量。"
		""
		"将&b觉醒仪式&r与&a书和羽毛笔&r结合，以获得护身符。"
		""
		"&6Bookwyrms&r 可以用白色、&0黑色&r、&1蓝色&r、&2绿色&r、&4红色&r 或 &9紫色&r 染料染色。"
	]
	quest.7B6ADA18EB886975.quest_subtitle: "忠诚的小图书管理员们"
	quest.7B707EF5D9494524.quest_desc: [
		"&6幻象使魔&r"
		""
		"&b战斗：&r专精于召唤魔法，通过迷惑敌人来操控他们。"
		""
		"&b能力：&r"
		"&a魔术：&r当主人生命值较低时，幻术师会施展魔术，使主人隐藏在敌人视野中。"
		"&a诱饵：&r当它们生命值较低时，会消失并留下一个爆炸的复制品，引诱周围的敌人去攻击它。"
		"&a扒窃：&r当无人注意且地上有金块或绿宝石时，这些小骗子会将其据为己有。"
		""
		"&b生成：&r幻术师会伪装成其他主世界生物自然生成，使用&d真理之镜&r使其现形。"
		""
		"&b食物：&r可以用金粒进行治疗。"
	]
	quest.7B707EF5D9494524.title: "驯服一个幻术师"
	quest.7B9BC64A58E69FAD.quest_subtitle: "在林地府邸中可找到"
	quest.7BA010B2CCDF8319.quest_desc: [
		"&6指令魔杖&r是&e模块化哥布林&r中最重要的工具，仅次于哥布林本身。"
		""
		"这根魔杖能让你配置哥利亚的&aCurios&r，调整&bMovement Behavior&r，并访问控制每个哥利亚功能的额外设置。"
		""
		"没有它，大多数高级傀儡定制和控制功能都无法实现。"
		""
		"如果说哥布林是肌肉，那么&6命令魔杖&r就是大脑。"
	]
	quest.7BEE38842BD7B660.quest_subtitle: "铸造三级符文（Cast Tier 3 Glyphs）"
	quest.7CB6433BA6140124.quest_desc: [
		"&6Scroll Forge&r 用于制作法术！"
		""
		"使用的&a墨&r决定了法术的稀有度。法术等级将始终为该稀有度的最低等级。"
		""
		"你不能使用稀有度低于卷轴最低稀有度的墨水。"
	]
	quest.7CB6433BA6140124.quest_subtitle: "卷轴合成"
	quest.7CB9E4917E0B328C.title: "又一个挖矿维度（末地）"
	quest.7D7FA7C1A30FB4E9.title: "冰蜘蛛巢穴"
	quest.7ED8DAE89343A437.title: "创建"
	quest.7ED99487F76DFD5A.quest_subtitle: "20 护甲"
	quest.7ED99487F76DFD5A.title: "钻石盔甲"
	quest.7F2223226E1217B7.quest_desc: ["&6瓶中时光&r会记录你的游戏时间，可用于加快方块更新频率"]
	quest.7FE001F2CC40F793.quest_desc: [
		"&e符文合成：&r"
		"要制作符文，请将你的&9Spell Book&r放在&dScribe's Table&r上，选择要创建的符文并提供所需物品。 &dScribe's Table&r会自动从附近的箱子中取物。"
		""
		"&e刻印：&r"
		"部分装备和物品可以刻上法术。要刻上法术，请将装备或物品放在&d刻写台&r上，并将想要刻写的法术施放到&d刻写台&r上。"
	]
