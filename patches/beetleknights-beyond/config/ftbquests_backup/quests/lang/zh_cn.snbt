	quest.182160EA19A13D48.quest_subtitle: "17 盔甲"
	quest.182160EA19A13D48.title: "骨骼爬行动物盔甲"
	quest.1884056F9269E4D2.quest_desc: [
		"&6Lingering Flask Cannon&r 可以消耗玩家背包中的瓶子和瓶塞里的药水，并将其转化为&bLingering Potion&r。"
		""
		"要選擇要投擲的藥劑，請使用輪狀選單選擇你的藥瓶或藥劑，然後使用發射器。"
	]
	quest.18975CFF39235A3C.quest_desc: [
		"&6Flux Networks&r 让你能够使用非常强大的无线储能装置。"
		""
		"要开始，你需要 &dFlux Dust&r。"
		""
		"要制作第一个&dFlux Dust&r，你需要将&cRedstone&r放在&bBedrock&r上，然后点击上方的&9Obsidian&r方块来将其粉碎。"
		""
		"制作足够的 &dFlux Dust&r 后，就可以用 &eFlux Block&r 代替 &bBedrock&r 了"
	]
	quest.18975CFF39235A3C.title: "Flux Networks"
