		{
			x: 0.0d
			y: -6.0d
			subtitle: "用于烹饪的食材"
			description: ["炉灶是烹饪锅的有效热源，烹饪必须使用烹饪锅。"]
			dependencies: ["10477570E085657F"]
			id: "3BF523FEA04D39F1"
