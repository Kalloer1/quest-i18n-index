	quest.29ADB74079C1080C.quest_desc: ["考虑使用功能性储物柜来获得经典的抽屉体验。注意那些能成倍增加抽屉容量的升级。"]
	quest.29ADB74079C1080C.title: "抽屉与大规模存储系统"
	quest.2A9B0219672CA328.title: "马匹"
	quest.2BEF619839842668.quest_desc: [
		"有几种关键的矿脉类型要了解！在EMI中搜索 @progress，并查找钻头图标以查看确切的产出和比例。"
		""
		"&l主世界矿脉&r"
		"* 常见矿物"
		"含有铁、铜、锌和煤炭。"
		"* 稀有金属"
		"含有黄金、白银、镍、黄铁矿和铂金。"
		"* 珍贵宝石"
		"包含红石、青金石、钻石和绿宝石。"
		""
		"&l下界脉&r"
		"* 地狱宝藏"
		"含有石英、萤石粉、肉泥（大量肉泥），偶尔还有远古残骸。"
		"* 大理石般的混乱"
		"含有肉。大量的肉。不，比这还多。粉色史莱姆需要被输送到钻头里才能工作。"
		""
		"&l末地脉&r"
		"* 月亮矿脉"
		"包含末影珍珠和龙息。粉色史莱姆需要接入钻头才能工作。"
	]
	quest.2BEF619839842668.title: "矿石脉层与你同在"
	quest.2CA14A5AB1776BED.quest_desc: [
		"流体抽屉和普通抽屉一样，不过是用来放流体的。听起来很合理！"
		"用桶左键点击以提取，用桶右键点击流体以存入。"
		""
		"但这还没完！使用这两种升级中的任意一种，流体抽屉都可以免费、永久地生产岩浆或水。听起来有多实用，它就有多实用！"
	]
	quest.2CA14A5AB1776BED.title: "免费流体获取器 (Fluids for Nothin')"
	quest.2CA6B073DCE3C2A2.title: "小鸡们"
	quest.2CEBACC62130B386.title: "奥西洛特"
	quest.2E35A4B1EB1026B5.quest_desc: ["那本小破书不行。我能帮你修补得比原来好四倍，没问题。"]
	quest.2E35A4B1EB1026B5.title: "升级《废料收集手册》"
