		}
		{
			dependencies: ["7055B78E35AA1A6E"]
			description: ["&7&oThe air around Spore-infected zones is filled with toxic spores. Without proper protection, lingering in these areas will weaken you over time. Craft gear to help resist the spore effects and explore further.&r&r"]
			hide: true
			id: "0E7E84981FF6B981"
