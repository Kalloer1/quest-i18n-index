		}
		{
			dependencies: [
				"0E7E84981FF6B981"
				"1FEF1502F6F1B5FD"
			]
			description: ["&7&oOver time, the Spore infection evolves, giving rise to new, more dangerous monsters. These mutated creatures are stronger and more hostile than the infected mobs you’ve faced so far. Prepare for tougher battles as you delve deeper into the infection.&r&r"]
			hide: true
