	order_index: 0
	quest_links: [ ]
	quests: [
		{
			description: [
				"&o&f欢迎来到濒临崩溃的世界&r&o&7，生存仅仅是开始。 &c三种强大的感染&r &o&7已经蔓延，每种都带来了各自的恐怖。从 &l&f第一天&r&r&o&7起，令人毛骨悚然的低鸣预示着 &4憎恶之肉&r&o&7的崛起，其怪诞的影响正在扩散。"
				"&oMeanwhile, &5Spore&r &o&7silently contaminates the world, but the true threat begins on &fDay 3&r&o&7, when infected mobs start spawning.&r&r"
				""
				"&o&7最危险的挑战位于&f0,0&r&o&7。在地下深处，&3Sculk Horde&r &o&7正沉睡，等待着你将其唤醒。 &f直面Sculk是摧毁所有三种感染并净化世界的唯一途径&r。&r&r"
				""
				"&o&7感染体切断了通往&c下界&r &7&o和&e末地&r &7&o的通道，在&2主世界&r &7&o被解放前，你无法逃脱。 &f这里曾是充满奇迹的地方&r，&7&o但现在却被远古力量所腐化。 &f你的使命是生存、探索，并最终将这片土地恢复到昔日的辉煌&r。 &r&r"
				""
				"&o&7做好准备，冒险家。"
				"清除世界感染、解锁未知维度的冒险，现在开始。&r&r"
			]
			icon: "spore:hinden_spawnegg"
			id: "565DC35627163337"
			rewards: [{
				id: "1E3075BCD60D3939"
				type: "xp"
				xp: 10
			}]
			shape: "rsquare"
			tasks: [{
				id: "29B7711C28792563"
				title: "欢迎来到这个世界！"
				type: "checkmark"
			}]
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["565DC35627163337"]
			description: [
				"&7&l要制作Scourge Bonfire，你需要从不同的感染中收集几种稀有物品。配方如下：&r&r"
				""
				"- &lSculk Campfire&r x1"
				"- &l脑残&r x3"
				"- &l感染的镰刀&r x1"
				"- &lInfected Armads&r x1"
				"- &lFlesh Axe&r x1"
				"- &lFlesh Compass&r x1"
				"- &lHysterizer Revenge&r x1"
				""
				"&l重要&r：&7&o务必在击败潜行兽群前获得潜行篝火！一旦净化了潜行兽，你将无法再获得篝火，请据此规划。&r"
			]
			id: "0F9AA443AEA1ACE9"
			shape: "gear"
			size: 2.0d
			tasks: [{
				id: "215BDB301A20EA57"
				item: "kubejs:scourge_bonfire"
				type: "item"
			}]
			title: "制作瘟疫篝火 (Crafting the Scourge Bonfire)"
			x: 0.0d
			y: 7.0d
		}
		{
			dependencies: ["565DC35627163337"]
			description: ["&7&o&4肉感染&r &7始于孵化器的出现，它会发出令人不安的嗡鸣声，标志着肉感染的开始。要对抗这一威胁，你需要找到并摧毁孵化器。但请注意，仅仅杀死孵化器并不能完全阻止感染的扩散。感染将继续蔓延，需要采取更多措施才能完全控制和遏制它。&r&r"]
			hide: true
			icon: "the_flesh_that_hates:bundle_of_flesh"
			id: "793AB1137CBE3BCB"
			tasks: [{
				icon: "the_flesh_that_hates:flesh_block_bone"
				id: "323E2BCF911FA75B"
				observe_type: 0
				timer: 0L
				title: "找到一个血肉生物群系"
				to_observe: "the_flesh_that_hates:flesh_block"
				type: "observation"
			}]
			title: "绝望的低语 (The Hum of Despair)"
			x: 2.0d
			y: -1.5d
		}
		{
			dependencies: ["565DC35627163337"]
			description: ["&7&o&5孢子感染&r &7正在开始蔓延。它缓慢地吞噬着周围的一切。留意它逐渐扩散的生长，你会从覆盖在方块上的奇特菌类纹理中认出它来。&r&r"]
			hide: true
			icon: "minecraft:mycelium"
			id: "4CFF3E296ADE3004"
			tasks: [{
				icon: "spore:blomfung"
				id: "1EB87099DC5DBEAB"
				observe_type: 0
				timer: 0L
				title: "识别并标记一个孢子感染的区域。"
				to_observe: "minecraft:mycelium"
				type: "observation"
			}]
			title: "孢子正在苏醒"
			x: -2.5d
			y: 1.0d
		}
		{
			dependencies: ["565DC35627163337"]
			description: ["&7&o要净化世界，你必须先唤醒潜行者军团。前往坐标 (0, 0)，深入地下发掘一座埋藏堡垒。其深处便是潜行者军团的心脏。扰动这股远古力量将使其苏醒，引发连锁反应，这对击败其他感染至关重要。&r&r"]
			hide: true
			icon: "sculkhorde:sculk_summoner"
			id: "79087321716AB608"
			tasks: [{
				id: "6A4F9E0B0B623F3C"
				structure: "sculkhorde:sculk_tomb_main"
				title: "进入潜声古墓"
				type: "structure"
			}]
			title: "唤醒潜行者（Sculk）的苏醒"
			x: 2.0d
			y: 2.0d
		}
		{
			dependencies: [
				"17B92EC0D6346E8E"
				"7809BE606153E386"
				"02B3E14DC892206F"
			]
			description: ["&o&l恭喜你，英雄！&r &7你已完成所有任务，征服了这个世界提供的所有挑战。你的决心、技巧和勇气，为这片曾被感染肆虐的土地带来了和平与稳定。作为对你非凡成就的奖励，你已解锁了 Scourge Bonfire 的配方。这件强大的物品将阻止感染生物在你的世界中生成，确保你的基地及周围土地的安全。 &l&f继续探索，继续制作，继续保护这个世界，你当之无愧！&r&r"]
			hide: true
			id: "12C049995D702975"
			rewards: [{
				command: "/gamestage add @p end_stage"
				id: "172C79834BBAE2B1"
				title: "解锁 Scourge Bonfire 的配方（在第 100 天后可用）"
				type: "command"
			}]
			tasks: [{
				days: 100
				id: "3B683C4E79A617A3"
				type: "questsadditions:days"
			}]
			title: "世界冠军！"
			x: 0.0d
			y: 5.0d
		}
		{
			dependencies: ["4CFF3E296ADE3004"]
			description: ["&7&oThe Spore infection is relentless, consuming everything in its path, including food from chests, smelting materials in furnaces, and any other items left unattended. Be wary of leaving valuable resources near infected areas.&r&r"]
			hide: true
			icon: "spore:mound_spawnegg"
			id: "5463824B3D535B02"
			tasks: [{
				id: "1DF0D067FEB53DE8"
				observe_type: 5
				timer: 0L
				title: "观察土丘吞噬着整个世界"
				to_observe: "spore:mound"
				type: "observation"
			}]
			x: -4.0d
			y: 0.5d
		}
		{
			dependencies: ["7055B78E35AA1A6E"]
			description: [
				"&7&o旅途中，你可能会注意到聊天框里出现奇怪的讯息。这些讯息是关于感染进展的重要警告，能指导你下一步该做什么。不过，如果你想自己发现这些讯息及其含义，也可以跳过此任务，继续下一个任务。 &f想了解更多，请继续阅读&r！&r&r"
				"{@pagebreak}"
				"&l忍耐…&r = &o&7感染区已扩大到足以支持原始蜂巢意识的形成。我与其他人强烈建议寻找PHM，并与肉山一同将其击杀。&r&r"
				""
				"&l准备… &r= &7&o因多种原因，一个灾厄级生物正在生成。寻找原始蜂巢，杀死母体，或为灾厄生物做好准备。&r&r"
				""
				"&l来袭...&r = &o&7意味着世界中有灾厄级别的生物可用，并且它已完成既定目标，正在提供坐标，这很可能是你的确切位置。我觉得你应该快跑…&r&r"
			]
			hide: true
			icon: "minecraft:paper"
			id: "1FEF1502F6F1B5FD"
			tasks: [{
				id: "6ECAA90A3A06C805"
				title: "神秘讯息"
				type: "checkmark"
			}]
			x: -6.5d
			y: 0.5d
		}
		{
			dependencies: ["5463824B3D535B02"]
			description: ["&7&oThe Spore infection gradually spreads to nearby areas, corrupting the land as it goes. There's no simple way to halt its growth; instead, you’ll need to focus on surviving and understanding this threat.&r&r"]
			hide: true
			id: "7055B78E35AA1A6E"
