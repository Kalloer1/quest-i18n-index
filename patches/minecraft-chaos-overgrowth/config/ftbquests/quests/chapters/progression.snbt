			}]
			x: 6.0d
			y: 3.0d
		}
		{
			dependencies: ["0F9AA443AEA1ACE9"]
			description: ["&7&o侵扰净化器是一种专门用于净化被潜行者巢穴感染的区域的工具。放置在潜行者巢穴感染的区域时，侵扰净化器会逐渐净化土地，移除潜行者巢穴方块。&r&r"]
			hide: true
