	order_index: 0
	quest_links: [ ]
	quests: [
		{
			description: [
				"Aquaculture 2 为 Minecraft 的钓鱼系统扩展了 30 多种新鱼，既可以用鱼竿（任何模组或原版鱼竿都行！）钓，也可以在野外发现它们游泳。"
				""
				"它还添加了一系列新鱼竿，让你能装备鱼钩和鱼饵以获得额外功能。还有定制鱼线和浮漂，让你的鱼竿独一无二。修饰符和定制物品可在渔具盒中使用，该盒子还能存放额外的鱼钩、鱼饵、鱼线和浮漂。"
				""
				"每种生物群系——包括模组生物群系——都有新的鱼类，它们会在河流、池塘和海洋中游来游去，让你的钓鱼体验和整个世界焕然一新！"
				""
				"钓到的鱼可以做成鱼排，具体数量取决于鱼的种类。此外，钓鱼还能获得闪闪发光的新战利品！（包括传说中的海王星工具或盔甲！）"
			]
			id: "021F19E6E458725C"
			rewards: [{
				count: 2
				id: "3DD59836706AC400"
				item: "minecraft:cookie"
				type: "item"
			}]
			subtitle: "关于该模组的简要介绍"
			tasks: [{
				id: "6600A63FAF227ADD"
				title: "水产养殖入门 2"
				type: "checkmark"
			}]
			x: 1.0d
			y: -3.0d
		}
		{
			can_repeat: false
			dependencies: ["021F19E6E458725C"]
			description: ["要将鱼钩添加到鱼竿上，你需要一个渔具箱。将箱子放置在世界中并打开，你会看到一个用于鱼竿的插槽。将鱼竿放入插槽中，然后就可以添加鱼钩、鱼饵等。"]
			hide_dependency_lines: false
