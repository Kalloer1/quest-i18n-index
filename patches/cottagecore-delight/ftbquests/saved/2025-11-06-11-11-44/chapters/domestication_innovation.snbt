			x: -1.5d
			y: -1.0d
		}
		{
			can_repeat: false
			dependencies: ["6DBCF9D6C37AE102"]
			description: ["可信赖的生物在实现上一直有些不尽如人意。幸运的是，这个模组让驯服的狐狸真正被驯服了——它们可以像其他宠物一样坐下、闲逛和跟随。要获得一只驯服的狐狸，你需要用甜浆果繁殖两只野狐狸，并等待它长大。请注意，无论狐狸有多温顺，它们仍然会想杀死任何能看到的鸡和（未驯服的）兔子。"]
			hide_dependency_lines: false
			id: "4DC90C7CC9DF09E0"
			rewards: [{
				count: 2
				id: "05575866E8033FF4"
				item: "minecraft:sweet_berries"
