	quests: [
		{
			description: [
				"Farmer's Delight 是一个温和扩展了 Minecraft 中种植和烹饪内容的模组。"
				""
				"使用简单的烹饪系统和一些熟悉的食材，你就能制作出各种各样的美味佳肴：从三明治到沙拉和炖菜，从精美的甜点到令人垂涎的盛宴，厨房里不会有任何食材被浪费！"
				""
				"它还引入了一系列丰富的实用工具：改善作物生长土壤的方法、一种全新的资源采集工具、可爱的建筑装饰品，以及许多能帮助你冒险的方块和物品！"
				""
				"是时候把各种东西都种一点了！"
				""
				"要了解更多信息，请遵循进度，或在此处查看维基：https://github.com/vectorwing/FarmersDelight/wiki"
			]
			id: "4A06B967832E79D9"
			rewards: [{
				count: 2
				id: "5C46CAD20CB847D3"
				item: "minecraft:cookie"
				type: "item"
			}]
			subtitle: "关于该模组的简要介绍"
			tasks: [{
				id: "152E7EF32C001A9D"
				title: "农夫的欢乐入门指南"
				type: "checkmark"
			}]
			x: 2.0d
			y: -3.0d
		}
		{
			can_repeat: false
			dependencies: ["4A06B967832E79D9"]
			description: [
				"刀具是拾荒工具：它们能让你从动植物身上获得更多资源。"
				""
				"- 用匕首击杀的任何动物都必定会掉落次要物品，例如皮革和羽毛；"
				""
				"- 用刀具收割草类植物（如草、小麦、水稻等）偶尔会产出稻草，这是一种坚固实用的纤维；"
				""
				"- 它们是一种简易的近战武器：挥舞速度比剑快，但伤害较低；"
				""
				"- 之后，它们在烹饪时切分和分装食材也很有用。"
				""
				"刀具和标准工具一样分等级，但不能用木头或石头制作。最简单的刀具是燧石刀。现在是时候去挖掘一些砾石了！"
			]
			hide_dependency_lines: false
			id: "158FCB3E2C00D457"
			rewards: [{
				count: 4
				id: "15D925C5E14348DC"
				item: "minecraft:beef"
				type: "item"
			}]
			subtitle: "制作一把燧石刀"
			tasks: [{
				id: "1F1CB15FDF4CE2A1"
