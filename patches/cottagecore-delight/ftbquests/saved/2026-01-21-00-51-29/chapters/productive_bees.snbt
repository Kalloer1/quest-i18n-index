		{
			can_repeat: false
			dependencies: ["19DC0D96F6EE2321"]
			description: [
				"你最需要的是一个高级蜂巢来饲养蜜蜂，然后是扩建箱。这些特殊蜂巢能让你在不惹怒蜜蜂的情况下收获蜂巢蜜和蜂蜜。你还可以为蜂巢添加升级，让蜜蜂更快地生产蜂巢。"
				""
				"一些你可能觉得有用的升级内容："
				""
				"- 速度升级（可用于蜂箱或机器）"
				"- 生产力升级（让蜜蜂工作更久、更快）"
				"- 方块升级（让蜜蜂产蜂蜜块而不是蜂巢）"
			]
			hide_dependency_lines: false
			id: "5C5C0DBDFDA1A751"
			rewards: [{
				count: 8
				id: "44720C95303113E7"
				item: "productivebees:sturdy_bee_cage"
				type: "item"
			}]
			subtitle: "制作高级蜂巢和扩建箱"
			tasks: [
				{
					id: "613685C3D705AB2C"
					item: "productivebees:advanced_oak_beehive"
					type: "item"
				}
				{
					id: "58212D4382A1CF2A"
