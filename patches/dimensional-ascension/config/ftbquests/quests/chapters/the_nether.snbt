			}]
			title: "欢迎来到下界！Welcome to the Nether!"
			x: 0.0d
			y: -1.5d
		}
		{
			dependencies: ["6D0D3E59EDF90CA2"]
			description: ["下界栖息着几种独特的植物，其中最著名的是主世界蘑菇的变异版本——扭曲菌和绯红菌。绯红菌可用于繁殖猪灵，而扭曲菌则可用于驱赶猪灵，以及繁殖和骑乘迅捷兽。"]
			id: "166B04C39BAAF9C0"
			rewards: [{
