	quest.0000000000000005.quest_desc: ["地下埋藏着宝藏。挖掘，挖掘，再挖掘！"]
	quest.0000000000000005.title: "开始挖掘！"
	quest.000000000000000D.quest_desc: ["是的，你正在玩生存游戏，我们都知道这通常意味着撸树。但拜托，那样感觉不好，对吧？"]
	quest.000000000000000D.title: "不要打树……"
	quest.0000000000000010.quest_desc: [
		"制作便携式工作台，让你的生活更轻松。"
		""
		"就像用合成台一样，用它来合成。不错吧？"
	]
	quest.0000000000000014.quest_desc: [
		"在这片土地上，时不时地好好休息一下，才能走得更远。"
		""
		"建造一张Minecraft床，结束冒险后就能回家休息了。"
		""
		"FYI: 攻击守卫方块需要红石信号"
	]
	quest.0000000000000014.title: "任意一个 Minecraft 床"
	quest.000000000000001B.quest_desc: ["建造一个堆肥机，这样多余的树苗和其他植物材料就不会被浪费！"]
	quest.000000000000001B.title: "不要把它扔掉！"
	quest.000000000000001E.quest_desc: ["现在你已经开始啦！再进一步吧。找到并开采 8 个铁矿石。"]
	quest.0000000000000025.quest_desc: [
		"没有什么比在篝火上烹饪一顿热饭更棒的了。"
