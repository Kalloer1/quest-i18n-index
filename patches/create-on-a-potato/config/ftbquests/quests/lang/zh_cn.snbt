	]
	quest.00000000000007C1.quest_subtitle: "流体阀门 x1"
	quest.00000000000007C1.title: "永远地爱你，我的阀门"
	quest.00000000000007C5.quest_desc: ["智能管道：当你的流体需要一点引导（和智能）时。智能流体管道，顾名思义，很智能！可以把它看作一种过滤传输流体种类的方法。"]
	quest.00000000000007C5.quest_subtitle: "智能流体管道 x1"
	quest.00000000000007C5.title: "安静点！别吵了！"
	quest.00000000000007C7.quest_desc: ["Spouts：装满你的桶和瓶子——再也不用空手而归！Spout 用于重新填充流体物品。也可以自动化。"]
	quest.00000000000007C7.quest_subtitle: "Spout x1"
	quest.00000000000007C7.title: "四处张望一番，四处走动一番"
