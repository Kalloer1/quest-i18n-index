	task.000000000000000E.title: "任何原木"
	task.0000000000000015.title: "任意数量的 minecraft:beds"
	task.000000000000003E.title: "新手骷髅猎人任务书文本"
	task.0000000000000040.title: "学徒骷髅猎人"
	task.0000000000000042.title: "熟手骷髅猎人"
