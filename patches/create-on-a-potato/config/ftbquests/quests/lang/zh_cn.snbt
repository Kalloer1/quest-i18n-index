	quest.00000000000008E3.title: "单人军团"
	quest.00000000000008E8.quest_desc: ["精密机械：超先进机器的秘密配方。"]
	quest.00000000000008E8.quest_subtitle: "精密机械 x1"
	quest.00000000000008E8.title: "精准派对"
	quest.00000000000008EC.quest_desc: ["便携式存储接口：像魔法一样在装置间传递物品！"]
