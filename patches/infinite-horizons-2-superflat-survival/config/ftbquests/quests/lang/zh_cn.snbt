	quest.362821657E098F7A.title: "骷髅蜜蜂"
	quest.3642E2D78B348AE3.quest_desc: [""]
	quest.3642E2D78B348AE3.quest_subtitle: "筛选以获取力量"
	quest.3642E2D78B348AE3.title: "钢铁开端"
	quest.365435DAA933478D.quest_desc: [
		"在&l末地石&r上右键点击&l蜂蜜点心&r即可获得。"
		""
		"稳定的&o末影珍珠&r和优质的&o紫颂&r来源。"
	]
	quest.365435DAA933478D.title: "末地蜜蜂"
	quest.366D38EDBB9745F2.quest_desc: [
		"在&l发光石&r上右键点击&l蜂蜜点心&r即可获得。"
		""
		"好，稳定的&o发光石&r来源。"
	]
	quest.366D38EDBB9745F2.title: "发光蜜蜂"
	quest.37387A044CF14796.quest_desc: ["&l泥土种子&r会生长成&l泥土精华&r，这是一种用于多种前期制作的实用资源。这种精华在制作必需材料和工具方面发挥着重要作用，是你在神秘农业初期阶段的重要资产。开始种植并收集泥土精华，以满足你最初的工艺需求吧！"]
	quest.37387A044CF14796.quest_subtitle: "驾驭泥土精华 (Harnessing Dirt Essence)"
	quest.37387A044CF14796.title: "大地之种"
	quest.377BA8A03F1850C5.quest_desc: [
		"通过将 &lslimy bee&r 和 &ldiamond bee&r 杂交获得。"
		""
		"不错，稳定的&o绿宝石&r来源。"
	]
	quest.377BA8A03F1850C5.title: "绿宝石蜜蜂"
	quest.37A11322027C7509.quest_desc: ["锌是通过筛分获得的，对制作黄铜很重要。"]
	quest.37A11322027C7509.quest_subtitle: "实用材料"
	quest.3ACAD6238252C16E.quest_desc: [
		"在&l晶化蜜蜂&r上右键点击&l繁荣方块&r即可获得。"
		""
		"不错，稳定的&o繁荣碎片&r来源。"
	]
	quest.3C1AEE1D1076DC69.quest_desc: [
		"在&l钻石蜜蜂&r上右键点击&l红宝石块&r即可获得。"
		""
		"不错，稳定的&o红宝石&r来源。"
	]
	quest.3C1AEE1D1076DC69.title: "RuBee"
	quest.3DA1DEC9395CA411.quest_desc: [
		"&6找到一棵&r &l树&r，然后把它&o砍&r掉&n&r。"
		"{image: width:100 height:100 align:center}"
	]
	quest.3DA1DEC9395CA411.quest_subtitle: "把树砍倒"
	quest.3DA1DEC9395CA411.title: "收集木材"
	quest.3E29C768BBBA289F.quest_desc: ["用石制抹刀（或以上）作用于泥土或草方块可获得。该方块的锤击版（用锤子破坏获得）的掉落物与普通砾石相同。"]
	quest.3EA384F839BB5D14.quest_desc: ["&l冰种子&r会生长成&l冰精华&r，这是一种用于制作冰相关物品的宝贵资源。虽然并非所有配方都需要，但它在某些独特的高级物品中扮演着重要角色。开始种植冰种子，为你的进阶之路做好准备，解锁更多制作机会。"]
	quest.3EA384F839BB5D14.quest_subtitle: "驾驭冰之精华"
	quest.3EA384F839BB5D14.title: "冬天的种子"
	quest.3ED909426B9083D9.quest_desc: ["&l钻石发电机&r的发电量高达64 FE/t，传输率更是达到256 FE/t，远超黄金发电机。它还拥有更大的100,000 FE缓冲容量，燃料消耗率仅为0.6，效率更高。该发电机仍使用固体燃料，可为您的机器提供稳定强劲的能量。从黄金发电机升级或制作一个，将您的电力系统提升到新高度。"]
	quest.3ED909426B9083D9.quest_subtitle: "双倍动力，效率更高"
	quest.3ED909426B9083D9.title: "钻石的力量"
	quest.3FC55D67C1E5368E.quest_desc: ["你需要找几个流浪商人来弄到手一些珊瑚。"]
	quest.40B85C791F3753C2.quest_desc: ["&l砂岩&r是沙子经长期压力压缩而成。它自然存在于沙漠和海滩，你也可以在合成网格中用四个沙子来制作。它是一种坚固的建筑材料，放置在末地传送门附近时，还能用来获取黑石。"]
	quest.40B85C791F3753C2.quest_subtitle: "众多建筑的基石 The Foundation of Many Structures"
	quest.40B85C791F3753C2.title: "受压谷物"
	quest.40F041C17BEAADEE.quest_desc: ["没有天然石，你得发挥创意。制作一个&l木制抹刀&r，用它来破坏泥土或草方块，这样就能得到&l石质鹅卵石&r。收集四块鹅卵石，合成一个&l鹅卵石&r方块。有了鹅卵石，更坚固的工具和新的可能性就在等着你！"]
	quest.40F041C17BEAADEE.quest_subtitle: "从泥土到石头"
	quest.40F041C17BEAADEE.title: "最初的石头们"
	quest.41CD1B0245F1CDCA.quest_desc: [
		"在&l钻石蜜蜂&r上右键点击&l下界合金块&r即可获得。"
		""
		"不错，稳定的&o下界合金废料&r来源。"
	]
	quest.41E6E28A9A57DDD1.quest_desc: ["除了很晚之后制作“觉醒”之外，用途有限。"]
	quest.42471A2F2D437E75.quest_desc: [
		"在&l史莱姆方块&r上右键点击&l蜂蜜点心&r即可获得。"
		""
		"合理的获取&o史莱姆&r的来源。"
	]
	quest.42471A2F2D437E75.title: "黏糊糊的蜜蜂"
	quest.435A71902EEC1F07.quest_desc: ["罐装Allay有几率从掠夺者相关生物身上掉落。"]
	quest.43E02654DCB3489D.quest_desc: ["在&l雪块&r上右键点击&l蜂蜜点心&r即可获得。"]
	quest.43E02654DCB3489D.title: "Sweat Bee"
	quest.453FF4D18DF3D3D7.quest_desc: ["前期游戏机制非常实用"]
	quest.45CA7C288211D9FF.quest_desc: ["收集足够的这些之后，你就可以制作&l珊瑚种子&l了。"]
	quest.46A5E29FA510A91F.quest_desc: ["强烈建议你在游戏前期用树皮来制作这个物品。"]
	quest.47812BC09FFAD71A.quest_desc: [
		"在&l石英块&r上右键点击&l蜂蜜点心&r即可获得。"
		""
		"不错，稳定的&o石英&r来源。"
	]
	quest.47812BC09FFAD71A.title: "晶化蜜蜂"
	quest.49C1E756D880F6AF.quest_desc: ["合成&lInferium Seeds&r，解锁被动生长 Inferium 的能力。种植并照料这些种子，随时间收获 Inferium Essence，为神秘农业提供稳定的关键资源。培育你自己的力量之源，将你的农场提升到新高度！"]
	quest.49C1E756D880F6AF.quest_subtitle: "种植 Inferium 植物"
	quest.49C1E756D880F6AF.title: "力量的种子"
	quest.4A1E5999C36E4743.quest_desc: [
		"在&l灵魂沙&r上右键点击&l蜂蜜点心&r即可获得。"
		""
		"获取&o恶魂之泪&r的最佳来源。"
	]
	quest.4A1E5999C36E4743.title: "幽灵蜜蜂"
	quest.4A5A806D0035B7FA.title: "回声蛋糕"
	quest.4A5F42E6E34A7926.quest_desc: ["只需在普通蜜蜂上右键点击水桶，即可获得水蜜蜂。"]
	quest.4BB559E512BBA041.title: "作物收集任务书文本"
	quest.4C56D51BFE4C7920.quest_desc: ["在&l粗土&r、&l砾石&r或&l沙子&r上右键点击&l蜂蜜点心&r即可获得。"]
	quest.4C56D51BFE4C7920.title: "巧克力采矿蜜蜂"
	quest.4D3EA3D4E73A990B.quest_desc: [
		"在&l幽灵蜜蜂&r上右键点击&l灵魂锭剑&r即可获得。"
		""
		"好，稳定的&osoulium&r来源。"
	]
	quest.4D3EA3D4E73A990B.title: "灵魂蜜蜂 (Soulium Bee)"
	quest.4ECFE2AB1E743F96.quest_desc: ["要获得更多动力，请将您的 &lWater Wheel&r 升级为 &lLarge Water Wheel&r。这个改进版本能产生更多的旋转能量，非常适合扩展您的机械系统。使用额外材料制作，将其放置在流动的水中，您的能源输出将飙升，为更先进的机器和自动化提供动力。"]
	quest.4ECFE2AB1E743F96.quest_subtitle: "强大的水车装置"
	quest.4ECFE2AB1E743F96.title: "力量解放"
	quest.4FC13F2C6001CFC4.quest_desc: ["&l末地发电机&r标志着你的能源生产能力迈出了重要一步。它以96 FE/t的生成速率和512 FE/t的传输速率，为最严苛的系统提供强大可靠的能源。它以末地珍珠和末地之眼为燃料，消耗略高，为1 FE/t，但结果值得付出。拥有500,000 FE的缓冲容量，该发电机为长期运行提供了必要的能源储备。从黑曜石升级到末地，将你的能源生产带入下一个维度。"]
	quest.4FC13F2C6001CFC4.quest_subtitle: "驾驭末地的力量，获取无尽的能量"
	quest.4FC13F2C6001CFC4.title: "末影力量转移"
	quest.4FCED4F5C0320523.quest_desc: ["用石制抹刀（或以上）作用于泥土或草方块可获得。该方块的锤击版（用锤子破坏获得）的掉落物与普通砾石相同。"]
	quest.4FCED4F5C0320523.quest_subtitle: "制作建筑材料的基础方块"
	quest.4FCED4F5C0320523.title: "安山岩基础模组包"
	quest.52571AADE617EDF4.title: "火把花（Torchflowers）"
	quest.528AC4A13D35951B.quest_desc: ["用&o锤子&r敲击&l鹅卵石&r可以获得&l砾石&r。"]
	quest.528AC4A13D35951B.quest_subtitle: "将石头变成砾石"
	quest.528AC4A13D35951B.title: "基础锻造入门教程"
	quest.5325073801A73C95.title: "焦炭炉 Coke Oven"
	quest.53AC5BC20682441D.quest_desc: [
		"在超平坦环境中，你可能很难找到某些动物。这就是模组包里饲料的作用。"
		""
		"除了马饲料外，所有物品都可以通过与一级村民交易获得。马饲料需要二级。"
	]
	quest.53AC5BC20682441D.title: "动物饲料"
	quest.545A6FF013A3C65C.quest_desc: ["这可能是整合包里最实用的精华了。"]
	quest.57401F4BD3952C56.quest_desc: ["在没有森林的世界里，村庄是你获取木材的最佳来源。砍伐村庄里的树木收集原木——这是制作工具、建筑等所必需的。尽可能重新种植树苗，以保持资源的可持续性！"]
	quest.57401F4BD3952C56.quest_subtitle: "生存的关键 The Key to Survival"
	quest.57401F4BD3952C56.title: "伐木机启动！"
	quest.579D7FD06F5DC4D7.quest_desc: ["&l机械压机&r是一种强大的工具，可将材料压制、压缩和包装成更高效的形态。用它来制作压缩物品，如铁板或用于合成的压缩材料。这款压机由旋转能量驱动，能节省时间和精力，让你简化材料处理流程，提高效率。快搭建它，开启你的压制之旅吧！"]
	quest.579D7FD06F5DC4D7.quest_subtitle: "用力量进行压缩"
	quest.579D7FD06F5DC4D7.title: "正在加载进度条，请稍候"
	quest.5A382D145AA88DD9.quest_desc: [""]
	quest.5A382D145AA88DD9.quest_subtitle: "发掘新金属"
	quest.5A382D145AA88DD9.title: "铜矿勘探者"
	quest.5A3BDE124AB8EBAF.quest_desc: ["所有使用该物品的实用配方，请在 JEI 中查看。"]
	quest.5C6BCB357546F47A.quest_desc: ["要制作强大的神秘农业种子，你需要一个&lInfusion Altar&r和八个&lInfusion Pedestals&r。这个结构对于推进模组进度至关重要，能让你创造出能产生资源的作物。搭建祭坛，收集材料，开始充能过程，拓展你的种植潜力！"]
	quest.5C6BCB357546F47A.quest_subtitle: "灌注祭坛 (The Infusion Altar)"
	quest.5C6BCB357546F47A.title: "成长的仪式"
	quest.5CBC838755D23495.quest_desc: ["用石制抹刀（或以上）作用于泥土或草方块可获得。该方块的锤击版（用锤子破坏获得）的掉落物与普通砾石相同。"]
	quest.5D769F0200A177C1.quest_desc: ["&lMagmatic Generator&r 是一项重大升级，利用源源不断的熔岩之力提供高效能源。其生成速率为 40 FE/t，传输速率为 512 FE/t，可高效将熔岩转化为锻造能量 (FE)。它消耗熔岩的速率为 0.4 FE/t，并拥有 500,000 FE 的巨大缓冲容量。将你的 Obsidian Generator 升级为 Magmatic Generator，解锁熔岩作为燃料的潜力，为你的扩张需求提供稳定的能源流。"]
	quest.5D769F0200A177C1.quest_subtitle: "驾驭岩浆的力量"
	quest.62DBB6855DF2639C.quest_desc: [""]
	quest.62DBB6855DF2639C.quest_subtitle: "基础合成教程"
	quest.62DBB6855DF2639C.title: "工作台奇缘"
	quest.63FB7295B442F0A3.quest_desc: ["用绿宝石换附魔书的好方法。"]
	quest.64A01D798C19E655.quest_desc: ["&l口臭发电机&r是你能源之旅的巅峰之作。它以惊人的128 FE/t的生成速率和不可思议的16,384 FE/t的传输速率，能够应对巨大的能源需求。由龙之息驱动，它提供了强大高效的能源，消耗速率为1 FE/t。口臭发电机拥有高达9,800,000 FE的缓冲容量，确保在高需求时期系统仍能持续供电。从末影升级到口臭，释放龙之息的惊人力量。"]
	quest.64A01D798C19E655.quest_subtitle: "引导巨龙那强大的力量"
	quest.64A01D798C19E655.title: "力量的呼吸 (The Breath of Power)"
	quest.65A380AB7FA95B7D.quest_desc: [""]
	quest.65A380AB7FA95B7D.quest_subtitle: "使用 Create 将沙子变成黏土"
	quest.65A380AB7FA95B7D.title: "来自沙子的黏土"
	quest.662C6D7106C0C6D2.quest_desc: ["&lCulinary Generator&r 是一种将食物转化为能量的独特电源。它以 8 FE/t 的生成率和 256 FE/t 的传输率，提供稳定的 1 FE/t 消耗率，同时使用食物作为燃料。相较于 Gold Generator，此升级提供了 100,000 FE 的缓冲容量，为您带来更可持续、更具风味儿的能源解决方案。使用您收获的食物，通过这项基于食物的发电机升级，为您的机器供电！"]
	quest.662C6D7106C0C6D2.quest_subtitle: "升级到烹饪发电机 (Culinary Generator)"
	quest.662C6D7106C0C6D2.title: "权力的滋味"
	quest.66CC1872F77E4EE6.quest_desc: ["&l空气种子&r会生长成&l空气精华&r，前期可能用处不大，但在后期制作高级装备时会至关重要。最好现在开始种植，因为之后的高级配方和强力装备都需要它。尽早种植这些种子，能为你冲击终局进度节省大量时间。"]
	quest.66CC1872F77E4EE6.quest_subtitle: "为未来做好准备"
	quest.66CC1872F77E4EE6.title: "变革之风"
	quest.6B053EAB0CB56AE7.title: "厨房必备品"
	quest.6B4111F7BFF585CC.title: "海绵块"
	quest.7112ED278B1CE804.quest_desc: ["所有使用该物品的实用配方，请在 JEI 中查看。"]
	quest.71B4677400CE51F3.quest_desc: ["你可以在铁匠铺里找到熔岩，制作火种，或在创造混合器中混合鹅卵石。"]
	quest.720A2F80D5E73A17.quest_desc: ["&l下界合金发电机&r是终极电源，能以 1024 FE/t 的传输速率产生 256 FE/t 的能量。作为钻石发电机的升级版，它拥有 0.4 FE/t 的高效消耗率，并具备 1,000,000 FE 的缓冲容量。使用固体燃料，下界合金发电机将为您的设备带来可靠的高输出能源。立即升级，驾驭下界合金的力量，用最先进的能源生产为您的机器供能。"]
	quest.720A2F80D5E73A17.quest_subtitle: "升级到能源生产的最高境界"
	quest.720A2F80D5E73A17.title: "驾驭下界合金的力量"
	quest.726CEB2724A750D7.quest_desc: ["使用铁锹或以上工具挖掘沙砾，有几率获得&lProsperity Shards&r，这是Mystical Agriculture的关键组件。这些碎片对于合成更高级的资源作物至关重要。继续筛选沙砾，为未来的发展收集所需材料吧！"]
	quest.726CEB2724A750D7.quest_subtitle: "寻找繁荣之地"
	quest.726CEB2724A750D7.title: "潜能的碎片"
	quest.74596AC8CCF849C2.quest_desc: ["&lNetherstar Generator&r 代表了能源生产的巅峰，能利用下界之星的磅礴力量。该发电机拥有高达 4092 FE/t 的生成速率和 16384 FE/t 的传输速率。它消耗 2400 FE/t，缓冲容量为 9,800,000 FE。要驱动这台猛兽，你需要使用下界之星，因此这项升级是驱动你高级系统的关键一步。"]
	quest.74596AC8CCF849C2.quest_subtitle: "升级到下界之星发电机"
	quest.74596AC8CCF849C2.title: "驾驭下界之星的力量"
	quest.7493025197A7AA31.quest_desc: [
		"通过繁殖 &l红石&r 和 &l蓝带蜜蜂&r 获得。"
		""
		"好，稳定的&o青金石&r来源。"
	]
	quest.7493025197A7AA31.title: "青金石蜜蜂"
	quest.74B7E90FE385180A.quest_desc: ["黄铜网开启了&6下界合金废料&r的生产。"]
	quest.76B1BFA765F786BE.quest_desc: ["&l黑曜石发电机&r是一项强大的升级，可将您的能源生产提升到新水平。该发电机以 128 FE/t 的生成速率和 512 FE/t 的传输速率，确保能源流动稳定高效。凭借 500,000 FE 的庞大缓冲容量和仅 0.6 的消耗率，它是满足长期电力需求的绝佳选择。使用固体资源作为燃料，它能无缝替代钻石发电机，为您的系统提供所需的能源提升。"]
	quest.76B1BFA765F786BE.quest_subtitle: "能源生产迎来全新效率层级"
	quest.76B1BFA765F786BE.title: "黑曜石能量涌动"
	quest.780B474DBCE85FC2.quest_desc: ["&lInferium Essence&r 是一种强大的生物掉落物，在 &oMystical Agriculture&r 模组中起着至关重要的作用。用它来制作种子，种植从基础作物到稀有材料的各种资源。开始收集这种精华，解锁一个全新的农业和资源生成世界吧！"]
	quest.780B474DBCE85FC2.quest_subtitle: "驾驭 Inferium 的力量"
	quest.780B474DBCE85FC2.title: "成长的精髓 (The Essence of Growth)"
	quest.7BDB5B6322CCD705.quest_desc: ["在&l粗土&r、&l砾石&r或&l沙子&r上右键点击&l蜂蜜点心&r即可获得。"]
	quest.7BDB5B6322CCD705.title: "灰蒙蒙的采矿蜜蜂"
	quest.7C42B99D6CD2EB48.quest_desc: ["木制抹刀是个不错的开始，但&l石制抹刀&r会更适合你。更高的耐久度和更好的掉落，让你能更高效地收集资源。制作一个试试吧，你可能会发现意想不到的东西！"]
	quest.7C42B99D6CD2EB48.quest_subtitle: "改进的采集系统"
	quest.7C42B99D6CD2EB48.title: "更好的铁锹（A Better Trowel）"
	quest.7C7513C71C94DAE4.quest_subtitle: "牧师交易"
	quest.7C7513C71C94DAE4.title: "早期发光石"
	quest.7D5453D77D188888.quest_desc: ["&l火种&r能产出&l火之精华&r，这是一种可用于多种配方中的通用材料。最重要的是，它可以被制成&l岩浆桶&r，提供可再生的岩浆来源。无论是用于冶炼、发电还是生产黑曜石，这些种子都能确保你永远不会缺少熔岩！"]
	quest.7D5453D77D188888.quest_subtitle: "驾驭火焰精华"
	quest.7D5453D77D188888.title: "火焰的种子"
	quest.7E44B2364F520C4C.quest_desc: ["再上一层将解锁更高级的种子。"]
