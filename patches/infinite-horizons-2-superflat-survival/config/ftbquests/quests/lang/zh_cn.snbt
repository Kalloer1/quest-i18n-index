	chapter_group.0BA6C43BB6B5DE06.title: "主要进度路线"
	chapter_group.3C16C4C95F1091C7.title: "可选的冒险任务"
	quest.0198B4CB454E265D.quest_desc: ["用神秘精华右键猪灵，可以获得一个药剂师。"]
	quest.0372C7453493CA18.quest_desc: ["&l蜂蜜发电机&r是一项绝佳的升级，能将蜂蜜转化为能量，提供更高效的动力。其发电率为64 FE/t，传输率为512 FE/t，消耗仅为0.5 FE/t。这项来自烹饪发电机的升级可提供500,000 FE的缓冲容量，用这份天然的甜蜜解决方案，确保你的能源需求得到满足！"]
	quest.0372C7453493CA18.quest_subtitle: "升级到蜂蜜发电机"
	quest.0372C7453493CA18.title: "甜蜜的力量"
	quest.040ABB916C18346A.quest_desc: ["&lEmerald Generator&r将发电提升到新高度，提供惊人的256 FE/t发电率和512 FE/t传输率。拥有500,000 FE的巨大缓冲容量和0.4的低消耗率，此升级极其高效。使用固体资源作为燃料，可为您的系统提供持久可靠的能源。从钻石发电机升级或制作祖母绿发电机，为您的能源网络注入强大动力。"]
	quest.040ABB916C18346A.quest_subtitle: "满足你能源需求的终极升级方案"
	quest.040ABB916C18346A.title: "翡翠能量激增"
	quest.050981ABE9425101.quest_subtitle: "牧师交易"
	quest.050981ABE9425101.title: "早期回响碎片"
	quest.061B13FB7F5EAA60.quest_desc: ["其中一些配方可以用创造模式的研磨机或破碎机来复制。"]
	quest.073087ED7AC745F3.quest_desc: ["&lMechanical Mixer&r 是将原料组合成高级配方的重要工具。它利用旋转能量，可轻松混合面团、合金等物料。只需设置好并用现有能源供电，即可自动化混合过程，提升机械系统的合成效率。"]
	quest.073087ED7AC745F3.quest_subtitle: "精准合成，分毫不差"
	quest.073087ED7AC745F3.title: "混合大师"
	quest.07B1B6C8502FD122.quest_desc: ["你可以在铁匠铺里找到它们，或者自然生成。"]
	quest.07B1B6C8502FD122.quest_subtitle: "获取黑曜石"
	quest.07B1B6C8502FD122.title: "不可动摇的决心"
	quest.08AA4A1FF88BADA2.quest_desc: ["&lPotion Generator&r 利用药水产生能量。其生成速率为 8 FE/t，传输速率为 512 FE/t，消耗 1 FE/t，燃料来自药水。作为 Culinary Generator 的升级版，它提供了 250,000 FE 的缓冲容量，让你能用药水的神奇能量来满足电力需求。"]
	quest.08AA4A1FF88BADA2.quest_subtitle: "升级到药水生成器"
	quest.08AA4A1FF88BADA2.title: "酿造的力量"
	quest.0A32D1747C313758.quest_desc: ["你需要准备一大堆这些东西才行……"]
	quest.0B9FAD328B016792.quest_desc: [
		"在&l钻石蜜蜂&r上右键点击&l紫水晶物品&r即可获得。"
		""
		"不错，稳定的&o紫水晶&r来源。"
	]
	quest.0B9FAD328B016792.title: "紫水晶蜜蜂"
	quest.0E2601518E952F8C.quest_desc: ["&l水之种子&r会生长成&l水之精华&r，对早期配方很有用。虽然它不像其他精华那样用途广泛，但对于制作基础物品和推进神秘农业的早期阶段来说，是必不可少的资源。开始种植，解锁新的制作可能性吧！"]
	quest.0E2601518E952F8C.quest_subtitle: "驾驭水之精华 (Harnessing Water Essence)"
	quest.0E2601518E952F8C.title: "海洋的种子"
	quest.0F4C5B2728A47022.quest_desc: ["你已成功为发电建立了坚实的基础，为你的 Applied Energistics 2 网络提供了可靠的能源。有了这个设置，你将能够支持你的 AE2 系统，确保其平稳高效的运行。完成此任务以确认你已准备好为设备供电！"]
	quest.0F4C5B2728A47022.quest_subtitle: "确保稳定的能量流动"
	quest.117B34F7EB4DB72A.quest_subtitle: "牧师交易"
	quest.1284CA2D49C1FE72.quest_desc: [""]
	quest.1284CA2D49C1FE72.quest_subtitle: "熔炼下界之沙 (Smelting the Sands of the Nether)"
	quest.1284CA2D49C1FE72.title: "焦黑的残骸"
	quest.169040E33441DBE9.quest_desc: ["&l附魔发电机&r是一项强大的升级，能将你的能量生产提升到新高度。该发电机以40 FE/t的生成速率和1,024 FE/t的传输速率运行，其动力源自附魔的本质。它以1 FE/t的速率消耗能量，并提供1,000,000 FE的缓冲容量，是兼具效率和庞大能量储备系统的理想选择。从黑曜石发电机升级到附魔发电机，解锁附魔作为独特燃料来源的强大能量。"]
	quest.169040E33441DBE9.quest_subtitle: "驾驭魔法力量的能量吧"
	quest.169040E33441DBE9.title: "附魔的力量"
	quest.170192578F1D5CA0.quest_desc: ["一旦你获得了像砾石这样的自动化资源，现在就是自动化筛选资源的好时机。"]
	quest.170192578F1D5CA0.quest_subtitle: "自动化资源收集系统"
	quest.174AD92AAE3A1FAF.quest_desc: [""]
	quest.174AD92AAE3A1FAF.quest_subtitle: "清除路径 (The Clear Path)"
	quest.174AD92AAE3A1FAF.title: "透明进度条显示功能现已加入整合包。"
	quest.18691A60F7FBE38E.quest_desc: ["在某些情况下，&lSoul Extractor&r 是 Soulium Dagger 的更简单替代方案。无需杀死生物，你可以通过使用与该生物相关的物品来提取其精华。这种方法为收集 Mystical Agriculture Mob Seeds 的生物资源提供了更高效的方式，无需战斗，使过程更加灵活。使用 Soul Extractor 以更少的努力提升你的生物养殖配置。"]
	quest.18691A60F7FBE38E.quest_subtitle: "灵魂提取器的多功能性 The Versatility of the Soul Extractor"
	quest.18691A60F7FBE38E.title: "高效的灵魂提取方法"
	quest.1874D5FB624EBAE7.quest_desc: ["在&l金合欢&r、&l樱花&r或&l深色橡木原木&r上右键点击&l蜂蜜点心&r即可获得。"]
	quest.1874D5FB624EBAE7.title: "蓝带蜜蜂"
	quest.1883DFF81CD530A0.quest_desc: ["&l黄金发电机&r是铁制发电机的升级版，生成率翻倍至32 FE/t，同时燃料消耗率降低至0.8，效率更高。它还拥有更大的30,000 FE内部缓冲区和更高的128 FE/t传输率。与前代产品一样，它使用固体燃料，不支持充能槽或64x升级。从铁制发电机升级或从头制作，让你的机器平稳运行。"]
	quest.1883DFF81CD530A0.quest_subtitle: "更强的动力，更高的效率"
	quest.1883DFF81CD530A0.title: "追求黄金"
	quest.196A568A00583805.quest_desc: ["&l铜发电机&r是迈向自动化能源的第一步。它使用固体燃料，每刻产生8 FE，传输速度高达32 FE/刻。拥有5000 FE的内部缓冲，能让基础机器平稳运行。但它没有充能槽，也不支持64x升级，所以你需要为未来的能源需求提前规划。"]
	quest.196A568A00583805.quest_subtitle: "一个简单的发电机，用来启动一切"
	quest.196A568A00583805.title: "铜制开端"
	quest.199D73938A3B149A.quest_desc: [
		"通过将 &l末地蜜蜂&r 与 &l青金石蜜蜂&r 杂交获得。"
		""
		"不错，稳定的&o钻石&r来源。"
	]
	quest.199D73938A3B149A.title: "钻石蜜蜂"
	quest.19CB8B99AFF3FA10.quest_desc: ["&l木种子&r会生长成&l木精粹&r，是获取非本地木材的最快方式。这种精粹能让你制作各种木材材料，拓展建筑和制作的选项。种植这些种子，丰富你的木材来源，探索设计和创作的新可能。"]
	quest.19CB8B99AFF3FA10.quest_subtitle: "培育新木材"
	quest.19CB8B99AFF3FA10.title: "木材的精髓 (The Essence of Wood)"
	quest.19EC29C268AFA9C9.quest_desc: [
		"通过繁殖 &lender&r 和 &lcrystalline bees&r 获得。"
		""
		"好，稳定的&ocertus quartz&r来源。"
	]
	quest.19EC29C268AFA9C9.title: "空间蜜蜂"
	quest.1B33DFBE26624AAC.title: "钢铁"
	quest.1B922950A7570482.quest_desc: ["勾选此框以确认你拥有一个可用的旋转能源。"]
	quest.1B922950A7570482.quest_subtitle: "早期游戏强力模组"
	quest.1DD31DACE3A3A35A.quest_desc: ["&lEarth Seeds&r会生长成&lEarth Essence&r，虽然前期可能无法立即用于合成，但它对于后期制作高级装备至关重要。现在开始种植，等你准备好制作高级装备和解锁强力配方时，就能有稳定的供应。为未来的发展抢占先机！"]
	quest.1DD31DACE3A3A35A.quest_subtitle: "为更强大的力量做好准备"
	quest.1DD31DACE3A3A35A.title: "扎根于大地之中"
	quest.1DFAEDA158D3563B.quest_desc: ["&lSoulium Dagger&r 是一种强大的工具，可用于击杀你想要捕捉本质的生物来填充灵魂瓶。使用匕首收集目标的灵魂并存入瓶中，这样你就可以制作神秘农业生物种子，高效地获取生物相关的资源。这种方法能让你有控制地收集生物资源，从而更好地推进你的旅程。"]
	quest.1DFAEDA158D3563B.quest_subtitle: "灵魂锭匕首的力量"
	quest.1DFAEDA158D3563B.title: "捕获灵魂"
	quest.20CEFFF2715407F7.quest_desc: [""]
	quest.20CEFFF2715407F7.quest_subtitle: "寻找钻石"
	quest.20CEFFF2715407F7.title: "钻石是永恒的"
	quest.20FB1A32048FB729.quest_desc: ["获取糖的方法有好几种。查看 JEI 吧。"]
	quest.2204AA3E838C4962.quest_desc: ["用机械搅拌机将&o有机物&r和&o水&r转化为&l浆料&r。浆料足够后，用机械压榨机将其制成&l纸板&r。纸板是一种经济实惠的材料，尤其适合制作书籍等物品。它是一种简单而宝贵的资源，能简化你的制作流程。快搅拌和压榨，释放它的潜力吧！"]
	quest.2204AA3E838C4962.quest_subtitle: "从纸浆到纸板"
	quest.2204AA3E838C4962.title: "纸的踪迹"
	quest.2271A8EDA3C7F64C.quest_desc: ["用&o锤子&r敲击&l砾石&r可以获得&l沙子&r。"]
	quest.2271A8EDA3C7F64C.quest_subtitle: "从砾石到沙子"
	quest.2271A8EDA3C7F64C.title: "时间的沙粒"
	quest.232343E515BF7A2E.quest_desc: [
		"通过繁殖 &lglowstone&r 和 &lchocolate mining bees&r 获得。"
		""
		"不错，稳定的&o红石&r来源。"
	]
	quest.232343E515BF7A2E.title: "红石蜜蜂"
	quest.233FF73DF6AF2D93.quest_desc: ["下界的腐化深入骨髓，甚至改变了靠近下界传送门的Scoria。这种转变会产生&lSoulstone&r和Soulium Ore，这些材料蕴含着逝者的精髓。打破Soulium Ore可获得&lSoulium Dust&r，这是制作Mystical Agriculture的Mob Seeds的关键组件。若想驾驭生物的力量，你需从此起步。"]
	quest.233FF73DF6AF2D93.quest_subtitle: "斯考里亚的黑暗变身"
	quest.233FF73DF6AF2D93.title: "灵魂的本质 (The Essence of Souls)"
	quest.246E7273A1E9A735.quest_desc: ["黄铜在创造模式中是一种非常有用的合金，用于游戏后期的基础设施建设。"]
	quest.246E7273A1E9A735.quest_subtitle: "非常实用的合金"
	quest.25451C960D037A8C.quest_desc: ["你需要灰蜂来采集&l铁&r、&l锡&r、&l铜&r和&l铝&r。"]
	quest.2570628600673C7B.quest_desc: ["用水和空气精华合成而成。"]
	quest.26215DB2808C33BA.quest_desc: [
