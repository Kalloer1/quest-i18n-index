		"&l能力类型：&r主动型"
		""
		"&l能力功能：&r"
		""
		"激活后会破坏附近的树叶。"
	]
	quest.0E46543D9D98E126.quest_desc: ["&d能力护盾&r是一种手持物品，可防止持有者的能力被任何效果更改或抑制。"]
	quest.0E47DBC64E3305D3.title: "捕捉传说宝可梦 &a卡里雷克斯"
	quest.0E487EACA837EA9B.title: "混沌护盾控制模块"
	quest.0E4DA8EE961D443F.quest_subtitle: "悬铃木 + 糖枫"
	quest.0E586F3C352EFFAA.title: "加勒地区的草系宝可梦"
	quest.0E5AE195158CF344.quest_subtitle: "x32 存储升级"
	quest.0E5AE195158CF344.title: "&d下界合金升级"
	quest.0E652CAAF2BB8464.quest_desc: ["你还可以用&c训练家卡牌&r查看你的等级上限和下一个要挑战的对手。"]
	quest.0E652CAAF2BB8464.quest_subtitle: "将你的当前等级上限发送到聊天框"
	quest.0E652CAAF2BB8464.title: "检查等级上限"
