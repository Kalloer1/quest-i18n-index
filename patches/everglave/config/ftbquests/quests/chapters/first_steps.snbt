	quests: [
		{
			dependencies: ["738460E492681BF3"]
			description: [
				"再也不会弄丢你的幼崽了！"
				""
				"骑上它们，或者让它们骑你！用口哨命令它们，甚至可以追踪它们！你甚至可以从任何地方把它们传送过来！"
				""
				"你的毛茸茸的伙伴一定会永远陪伴着你！"
			]
			id: "4CA73F6FDE2D397C"
			rewards: [{
				id: "56876D6147787C16"
				type: "xp"
				xp: 20
			}]
			tasks: [{
				id: "2459546A04F63609"
				type: "checkmark"
			}]
			title: "走丢的小狗吗？"
			x: 5.0d
			y: -11.5d
		}
		{
			dependencies: ["738460E492681BF3"]
			description: [
				"想不出名字有困难？这个问题也有解决方案！"
				""
				"你可以用命名器（在菜单中）给你的狗狗起名字，轻松找到最适合你伙伴的名字！"
				""
				"&o对着你的狗右键并按住 Shift，就会弹出菜单，你可以在那里给你的狗起名字！"
			]
			id: "67F602E880B9B2B4"
			rewards: [{
				id: "11EB400452D31CFA"
				type: "xp"
				xp: 20
