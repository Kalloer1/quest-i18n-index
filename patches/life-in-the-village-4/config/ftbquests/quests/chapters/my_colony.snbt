		{
			dependencies: ["3E87ADA2C0121147"]
			description: ["探索世界时，你会发现一些被前住民遗弃的殖民地。搬进其中一个废弃殖民地，是快速建立自己殖民地的好方法！"]
			icon: "minecraft:campfire"
