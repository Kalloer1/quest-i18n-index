	quest.72482C33821E665A.quest_desc: ["默认按键为“G”，可打开建筑小工具的菜单！"]
	quest.725AFDEFD5DF220C.quest_subtitle: "熔炼"
	quest.72C4177F4039DA70.quest_subtitle: "只需一根木棍"
