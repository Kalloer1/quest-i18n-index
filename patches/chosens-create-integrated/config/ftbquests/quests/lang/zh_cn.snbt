	quest.7581F0C71B0491C1.title: "岩浆块 \\& 水"
	quest.7689F3BE4B4EB556.quest_subtitle: "轻松物流"
	quest.778AF2CF39A71486.quest_subtitle: "自动村民交易"
	quest.77D17A763D29BDB2.quest_subtitle: "炫酷的无线玩家充能"
	quest.794911A3AA6DAB2A.quest_desc: [
		"L1 玩家存取区块可将您的库存与用于充能的仓库连接起来。通过在创建过滤器中启用“&l尊重数据&r”，系统便能区分空装备与满装备。"
		""
		"这样一来，您就可以自动取出耗尽的物品，在 NBT 数据符合您的“满”要求前将其保留，然后再将它们循环放回您定义的库存槽位中。"
	]
	quest.794911A3AA6DAB2A.quest_subtitle: "无线充能自动化"
	quest.7987F94F9852E859.quest_subtitle: "无需等待"
	quest.7A09A8746EB33C29.quest_desc: [
		"铜制机械是蒸汽时代的核心。它标志着从简单的动能运用转向流体管理和高级热力学。"
		""
		"作用：该机械是制造铜制机器（外壳）的必要组件。更重要的是，它是制作烈焰花胶的关键原料，而烈焰花胶对于推进热处理工艺乃至更高级阶段至关重要。"
		""
		"虽然您可以先手动制作这些物品，但使用序列装配能更高效地生产它们。搭建一条部署器生产线将在您扩大工厂规模时为您节省资源和时间！"
	]
	quest.7A09A8746EB33C29.quest_subtitle: "闪亮的新问题"
	quest.7B24ABF5482FEB31.quest_subtitle: "必须清空并传送上来"
	quest.7C53EFB85442DD4A.quest_subtitle: "等等……是 Quark 里的那个？！"
	quest.7C613795F2976618.quest_desc: ["能让你召唤出古树树的技艺同样适用于世界上的魔法植物。你不再需要依赖稀有的发现或复杂的合成；现在你可以亲手制作魔法养分的种子了！"]
	quest.7C613795F2976618.quest_subtitle: "没有树木受到伤害"
	quest.7E0359DA69355E78.quest_subtitle: "安息吧。 literally。"
	quest.7E74969D28BD3C2D.quest_desc: ["末影源质罐是 Ars Additions 模组中魔法存储的巅峰之作。它解决了任何魔法工程师最头疼的问题：后勤。你无需再手动搬运罐子，或将液态源质通过管道输送数公里长的工厂地面，末影源质罐利用虚空的力量，让你的法力在任何地方都能取用。"]
	quest.7E74969D28BD3C2D.quest_subtitle: "维度便利"
	quest.7ED244FD96FC1968.quest_subtitle: "闻起来有股硫磺味"
	quest.7ED244FD96FC1968.title: "下界"
	quest.7EF145F224EDF6C8.quest_desc: ["&f化作一道光束！&r"]
	quest.7EF145F224EDF6C8.quest_subtitle: " literally 只是光"
	quest.7F9E8DE361216AF7.quest_desc: [
		"首先，用粘液感染正在萌发的紫水晶，制作一个&l萌芽时晶&r！"
		""
		""
		"&l自动化循环&r："
		""
		"&l&b充能（主世界）&r&r：将萌芽方块放置在主世界，直到它变成蓝色（阶段 1）。"
		""
		"&l&6充能（下界）&r&r：将其移至下界，直到它变成橙色（阶段 2）。"
		""
		"&l&2充能 \\& 收获（末地）&r&r：将其移至末地。它会变成绿色（阶段 3）并开始生长晶体。"
		""
		"&l重置&r：一旦能量耗尽，方块再次变暗，就将其移回主世界以重新开始循环。"
		""
		"{@pagebreak}"
		"&l你将需要的工具&r："
		""
		"&l高级传感器&r：设置为检测萌芽方块的 NBT“阶段”（0、1、2 或 3）。"
		""
		"&l高级交换器&r：与另一个维度中的交换器相连，以便在传感器触发时自动传送该方块。"
		""
		"&l高级方块破坏器&r：配置了过滤器，使其只破坏时间水晶簇，而不会破坏萌芽方块本身。"
		""
		"&o&d注意：如果不让萌芽方块破碎，你无法挖掘它（即使使用精准采集）。请使用高级交换器或剪切粘贴工具来安全地移动它！&r&r"
	]
