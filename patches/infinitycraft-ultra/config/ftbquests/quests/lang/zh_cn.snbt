	file.0000000000000001.title: "InfinityCraft Ultra"
	quest.00170D6A6CB617E9.quest_desc: [
		"用4颗钻石围绕一个Wyvern Energy Controller制作一个&eRelay Crystal&r。使用无定形合成法可制作出两个&eI/O Crystals&r。"
		""
		"用&e晶体连接器&r连接晶体，无需电缆即可传输能量。"
	]
	quest.00170D6A6CB617E9.quest_subtitle: "无线-ish 电力传输"
	quest.00170D6A6CB617E9.title: "水晶网络"
	quest.003FEED99725AD25.quest_desc: [
		"普通电缆承载 &e8 个频道&r，每个设备使用一个。 &e智能电缆&r 会将其显示为彩色线条。"
		""
		"频道耗尽，设备陷入黑暗。"
	]
	quest.003FEED99725AD25.quest_subtitle: "每个装置都需要一个轨道"
	quest.003FEED99725AD25.title: "电缆与管道"
	quest.005CCB02D3FB1D87.quest_desc: [
		"建造一个流体储罐，在其下方放置&e烈焰燃烧器&r，注入水，并用传动轴将&e蒸汽引擎&r连接到两侧。"
		""
		"戴着眼镜看储罐，查看锅炉水位以及限制水位的原因：热量、水或尺寸。"
	]
	quest.005CCB02D3FB1D87.quest_subtitle: "强大的压力承受能力"
	quest.005CCB02D3FB1D87.title: "蒸汽动力"
	quest.0070A268CA2BB7D9.quest_desc: [
		"乘坐火车行驶超过5000格，然后下车。"
		""
		"终于有一条真正的铁路了。干得好，工程师！"
	]
	quest.0070A268CA2BB7D9.quest_subtitle: "一段漫长的回家路"
	quest.0070A268CA2BB7D9.title: "实地考察"
	quest.0075419565B770D3.quest_desc: [
		"在&eStone Block Generator&r的一侧放水，另一侧放岩浆。修饰方块会改变其生成物。"
		""
		"EMI的&eBlock Generator&r页面列出了所有组合，包括远古石。"
	]
	quest.0075419565B770D3.quest_subtitle: "永远的鹅卵石方块（Cobblestone forever）"
	quest.0075419565B770D3.title: "方块生成器"
	quest.007A48FFE48176AE.quest_desc: [
		"四件全部。穿上全套后，就没什么能伤害到你了吧。"
		""
		"恭喜你。数字部分到这里就结束了。"
	]
	quest.007A48FFE48176AE.quest_subtitle: "实际上是无限的"
	quest.007A48FFE48176AE.title: "Infinity Armor"
	quest.008D669DAEDBAF47.quest_desc: [
		"将生命值低于或等于半血的女巫施放 &eDispel&r 可获得一个 &eWixie Token&r。"
		""
		"用树苗、绿宝石、工作台和酿造台制作附魔，然后用附魔在炼药锅上使用。向炼药锅展示物品，Wixie 就会从附近的箱子里制作出来。它还会酿造药水。"
	]
	quest.008D669DAEDBAF47.quest_subtitle: "自动化合成，女巫的方式"
	quest.008D669DAEDBAF47.title: "Wixie"
	quest.0094CABEBAC566BD.quest_desc: [
		"ICU的配方：一个高级电路、两个强化合金和一个&eAllthemodium锭&r。"
		"Infuser 快捷方式已关闭。"
	]
	quest.0094CABEBAC566BD.quest_subtitle: "更智能的机器"
	quest.0094CABEBAC566BD.title: "精英控制电路"
	quest.009A9EC3B3884DED.quest_desc: [
		"由中子星、晶体矩阵、漏斗和红石在极限工作台合成。"
		""
		"给它喂一大堆同一种材料，它就会慢慢挤出一个奇点。"
	]
	quest.009A9EC3B3884DED.quest_subtitle: "成千上万进去，只有一个出来"
	quest.009A9EC3B3884DED.title: "中子星压缩器"
	quest.009C690EF42FFF8D.quest_desc: [
		"储罐上的&e流体舱口&r可让你右键将桶和瓶子直接倒入其中（潜行可从中填充）。"
		""
		"再也不用手动接满一罐子，搞得满屋子都是管道了。"
	]
	quest.009C690EF42FFF8D.quest_subtitle: "创建：Dragons Plus 模组"
	quest.009C690EF42FFF8D.title: "流体舱口"
	quest.00B032E31FD6B582.quest_desc: [
		"头盔、胸甲、护腿、靴子和手套。穿上这套装备可以跳得更高。"
	]
	quest.00B032E31FD6B582.quest_subtitle: "全套重力套装"
	quest.00B032E31FD6B582.title: "挑战重力"
	quest.00C2104C733B6DE8.quest_desc: [
		"需要一个&e终极控制电路&r。它将矿石溶解在硫酸中，变成肮脏的浆料。"
		""
		"一个矿石块足以在生产线末端制造五个晶体的浆料。"
	]
	quest.00C2104C733B6DE8.quest_subtitle: "矿石汤"
	quest.00C2104C733B6DE8.title: "化学溶解室"
	quest.0103A2623350F6EF.quest_desc: [
		"用染料给任意越野轮胎上色。适用于小型、普通、大型和巨型轮胎，并且可以重新染色。"
		""
		"当你的漫游车有一套彩色轮子时，勾选此项。"
	]
	quest.0103A2623350F6EF.quest_subtitle: "让你的涂装保持一致性"
	quest.0103A2623350F6EF.title: "彩色轮胎"
	quest.0108E4A57CB519DB.quest_desc: [
		"用不同的中间物品制作相同的配方，可以得到其他物品："
		"&eMycelial&r（蘑菇浓汤）会吃掉食物，&eVitalic&r（发光甜瓜）靠生物死亡和繁殖为生，&eAlchemical&r（酿造台）会喝掉附近药水罐里的药水。"
		""
		"混合搭配。相同罐子附近的更多链接意味着更多的源。"
	]
	quest.0108E4A57CB519DB.quest_subtitle: "选择你喜欢的口味吧"
	quest.0108E4A57CB519DB.title: "更多来源链接"
	quest.010FB1A300BCB4BB.quest_desc: [
		"三块羊毛叠成一列。一个&e睡袋&r能让你在旅途中跳过夜晚，而不会重置出生点。"
		""
		"先合成白色的，之后可以染色。"
	]
	quest.010FB1A300BCB4BB.quest_subtitle: "随处安营扎寨"
	quest.010FB1A300BCB4BB.title: "睡袋"
	quest.012795CB35D0894A.quest_desc: [
		"木棍、煤炭、一颗钻石和一个金锭。 &eTorch Pet&r 会为你放置火把，还能引燃物品。"
		""
		"洞穴探险变得更轻松了。它能吃掉煤炭块。"
	]
	quest.012795CB35D0894A.quest_subtitle: "永远不要让它空着"
	quest.012795CB35D0894A.title: "火把宠物"
	quest.01B01CFCE9D835A5.quest_desc: [
		"&e流体储罐&r可以堆叠成大型多区块结构。它们也是蒸汽锅炉的主体，所以需要准备很多。"
	]
	quest.01B01CFCE9D835A5.quest_subtitle: "把好东西都存起来"
	quest.01B01CFCE9D835A5.title: "流体储罐"
	quest.01C1730D7D63F187.quest_desc: [
		"残骸遍布深海底部。潜入水中，四处看看吧。"
	]
	quest.01C1730D7D63F187.quest_subtitle: "击沉这艘船，让它沉入海底"
	quest.01C1730D7D63F187.title: "一艘沉没的船只"
	quest.01F884998F63A3F0.quest_desc: [
		"一个&e觉醒祭坛&r（灵魂石、橙色羊毛、黄金）、四个灌注基座和四个&e精华容器&r。"
		""
		"Vessels hold the four elemental essences, up to 40 each."
	]
	quest.01F884998F63A3F0.quest_subtitle: "最后一个祭坛"
	quest.01F884998F63A3F0.title: "觉醒祭坛"
	quest.0212687C45AC6955.quest_desc: [
		"在&e加热&r的盆中混合铜和锌。这意味着下面要放一个烈焰炉，所以去招惹些烈焰人吧。"
	]
	quest.0212687C45AC6955.quest_subtitle: "情况越来越紧张了"
	quest.0212687C45AC6955.title: "黄铜"
	quest.02418FE4309E0906.quest_desc: [
		"胸甲的升级也一样。有了好的盾牌模块，你就能无视大多数首领的伤害。"
	]
	quest.02418FE4309E0906.quest_subtitle: "几乎无法被触碰的防御力"
	quest.02418FE4309E0906.title: "龙之盔甲"
	quest.02592C958F60087D.quest_desc: [
		"虚空荆棘、末影珍珠和远古灵魂。它永无止境，每次传送后你都会获得片刻的抗性。"
	]
	quest.02592C958F60087D.quest_subtitle: "可重复使用的传送装置"
	quest.02592C958F60087D.title: "充能末影珍珠"
	quest.02677AB356916F3C.quest_desc: [
		"在 &e化学催化器&r 中混合 &e氢气&r 和 &e氯气&r 以制造氯化氢。"
		""
		"氯气来自电解分离器对卤水的分解。卤水来自热蒸发塔（见“发电机”章节）。"
	]
	quest.02677AB356916F3C.quest_subtitle: "4x 的配方材料"
	quest.02677AB356916F3C.title: "氯化氢"
	quest.02B67E92947BA898.quest_desc: [
		"钻石晶格和下界之星可以制作成晶格锭。你需要准备很多。"
	]
	quest.02B67E92947BA898.quest_subtitle: "钻石，但数量更多"
	quest.02B67E92947BA898.title: "水晶矩阵"
	quest.02E20E782125A681.quest_desc: [
		"使用混沌核心和&e混沌能量控制器&r来升级你的龙之工具和盔甲。"
		""
		"你需要 &eChaotic injectors&r 来完成这个。具体配方请在 EMI 中查看。"
	]
	quest.02E20E782125A681.quest_subtitle: "德拉科尼克的顶部"
	quest.02E20E782125A681.title: "混沌齿轮"
	quest.03485C396C149891.quest_desc: [
		"Draconic Additions 添加了模块化的 &eWyvern Necklace&r：金锭和 Wyvern Core。"
		""
		"它放在 Curios 栏位里，能像盔甲一样安装 Draconic 模块。"
	]
	quest.03485C396C149891.quest_subtitle: "Draconic Additions"
	quest.03485C396C149891.title: "Wyvern Necklace"
	quest.036EEABEC1EA4C9E.quest_desc: [
		"这些卡片用于无线终端。&e导入卡&r将背包中的选定物品发送到网络；&e导出卡&r则保持背包中的物品充足。"
	]
	quest.036EEABEC1EA4C9E.quest_subtitle: "终端升级"
	quest.036EEABEC1EA4C9E.title: "导入和导出卡片"
	quest.0377FB0CE8B379BE.quest_desc: [
		"暗塔中的塔木钻木虫会掉落&e钻木精华&r。四个钻木精华、四个红石和一个恶魂之泪可以合成&e卡米尼特&r。"
		""
		"Carminite 为塔楼的设备提供动力，例如 Carminite Reactor 和 Builder。"
	]
	quest.0377FB0CE8B379BE.quest_subtitle: "红色且焦躁不安"
	quest.0377FB0CE8B379BE.title: "Carminite"
	quest.03939EA5B6CAF260.quest_desc: [
		"一个&e磁铁&r需要鹅卵石、铁、蓝色染料、红石和紫颂果，所以它在等待末地。"
		""
		"用红石供电，它能根据朝向推动或拉动铁块或铜块。移动的切石机甚至会切割上方的方块。"
	]
	quest.03939EA5B6CAF260.quest_subtitle: "推动和拉动"
	quest.03939EA5B6CAF260.title: "磁铁"
	quest.042D42646CA8CE9A.quest_desc: [
		"&eDead&r trees stand in the Dead Forest, the Wasteland and the Muskeg. The Mystic Grove grows &eMagic&r trees, and the gloomy Ominous Woods hide &eUmbran&r trees."
		""
		"非常适合建造恐怖建筑的木材。"
	]
	quest.042D42646CA8CE9A.quest_subtitle: "死亡、魔法和暗影元素混合而成的生物"
	quest.042D42646CA8CE9A.title: "奇怪的森林"
	quest.043B0D5C92EE0313.quest_desc: [
		"在一张双压缩工作台周围放置四个回声碎片、两个潜声、一个&eSculk Shrieker&r和一个&eVibranium Ingot&r。"
		""
		"你的第一个尖叫者必须来自世界：用带有&e丝绸之触&r的工具在深暗或远古城市里破坏一个。没有丝绸之触则不会掉落任何东西。"
		""
		"Avaritia的桌子分为几个等级：Sculk、Nether、End和Extreme。每种桌子都能制作其所属等级的配方。"
	]
	quest.043B0D5C92EE0313.quest_subtitle: "3x3 的表格"
	quest.043B0D5C92EE0313.title: "潜行合成台"
	quest.044853C73573902C.quest_desc: [
		"银质地牢漂浮在云端。女武神会掉落&e胜利奖章&r；将它们带给女王，证明你的资格。"
		""
		"击败&e女武神女王&r。"
	]
	quest.044853C73573902C.quest_subtitle: "被废黜的统治者 (Dethroned)"
	quest.044853C73573902C.title: "银色地牢"
	quest.045DD56B75433051.quest_desc: [
		"当网络过载时，&e过载离合器&r会脱开（用扳手重置）。"
		"&e离心离合器&r仅在超过设定速度时才会结合。"
		""
		"大型工厂的实用安全阀。"
	]
	quest.045DD56B75433051.quest_subtitle: "保护你的网络免受攻击"
	quest.045DD56B75433051.title: "智能离合器"
	quest.04B53327F9ACB9F3.quest_desc: [
		"在这里你可能会感染&eUtheric Infection&r。食用来自深渊的&eRogdorium&r可以抑制它。"
	]
	quest.04B53327F9ACB9F3.quest_subtitle: "乌瑟里克感染事件"
	quest.04B53327F9ACB9F3.title: "一种解药"
	quest.04EC379997A3493F.quest_desc: [
		"用&eWire Cutters&r切割铜板制成铜线，再将其缠绕在木棍上，制作成&eLV Wire Coil&r。"
		""
		"放置&eLV连接器&r，右键其中一个，再用线圈右键下一个以连接电线。"
	]
	quest.04EC379997A3493F.quest_subtitle: "用一根线来提供动力"
	quest.04EC379997A3493F.title: "LV 线路"
	quest.04EDA1D74C837B24.quest_desc: [
		"将钻石工具与龙晶核心、龙晶锭、两个中继晶体和一个威龙能量控制器熔炼。"
		""
		"它们靠电力驱动，而非耐久度。为它们充电并填满模块网格。"
		""
		"Wyvern 镐的挖掘速度就像 &eAllthemodium 镐&r：Vibranium 可以，Unobtainium 需要 Vibranium 镐。"
	]
	quest.04EDA1D74C837B24.quest_subtitle: "你的第一件真正的龙之装备"
	quest.04EDA1D74C837B24.title: "Wyvern 工具"
	quest.04FF6082627C73C6.quest_desc: [
		"某些机械动力装置需要&6热量&r而非能量：热蒸发塔和热电锅炉。"
		""
		"&e燃料加热器&r燃烧熔炉燃料。 &e电阻加热器&r将电能转化为热能。"
	]
	quest.04FF6082627C73C6.quest_subtitle: "热量本身就是一种资源"
	quest.04FF6082627C73C6.title: "加热器"
	quest.0504FFEF74440D3E.quest_desc: [
		"晶体周围放置四个Prudentium。铁、红石和发光石作物属于Tertium层级。"
	]
	quest.0504FFEF74440D3E.quest_subtitle: "Tier 3 精华"
	quest.0504FFEF74440D3E.title: "Tertium"
	quest.05096D9381CCA898.quest_desc: [
		"&eFusion Crafting Core&r（以Draconium Core为核心建造）会从指向它的&einjectors&r中吸取物品和能量。"
		""
		"觉醒的德拉科尼乌姆就是这样制作的。"
	]
	quest.05096D9381CCA898.quest_subtitle: "核心周围的注入器"
	quest.05096D9381CCA898.title: "融合合成"
	quest.0527352785CC18FC.quest_desc: [
		"木板、原木、钻石和金锭。右键点击&e工作台宠物&r，即可在任何地方打开合成网格。"
	]
	quest.0527352785CC18FC.quest_subtitle: "一个便携的工作台要带走"
	quest.0527352785CC18FC.title: "工作台宠物 (Crafting Table Pet)"
	quest.052D668CCB1CFF3F.quest_desc: [
		"&6ICU配方：&r一个Blazing Crystal需要四个blaze powder（或一个blaze rod）加上一个&eAllthemodium Nugget&r，并注入能量。"
		""
		"烈焰水晶可以制作烈焰电容器，而电容器可以制作所有烈焰方块。"
	]
	quest.052D668CCB1CFF3F.quest_subtitle: "需要 Allthemodium 模组"
	quest.052D668CCB1CFF3F.title: "烈焰等级"
	quest.05599CA05D2C89DA.quest_desc: [
		"ICU 拥有 &eSophisticated Backpacks Create Integration&r 附加组件。"
		""
		"放置的背包就像箱子一样，可以作为移动创造装置的储物空间。你可以在它移动时打开背包。"
	]
	quest.05599CA05D2C89DA.quest_subtitle: "随身携带的储物空间"
	quest.05599CA05D2C89DA.title: "背包与机械装置上的背包"
	quest.055F4CE06B54560A.quest_desc: [
		"&e化学注射室&r需要一个&e精英控制电路&r。用氯化氢，一个矿石能造出四个&e碎片&r。"
		""
		"将碎片放入你的净化室，然后沿着3x线路放置即可。"
	]
	quest.055F4CE06B54560A.quest_subtitle: "现在有了酸液腐蚀效果"
	quest.055F4CE06B54560A.title: "4x: 碎片"
	quest.0581BAF51FE4AC0E.quest_desc: [
		"在刻印机中：顶部是计算机，底部是工程机，中间是一个&e奇点&r。"
		""
		"之后用铁块复制它，就像其他方块一样。"
	]
	quest.0581BAF51FE4AC0E.quest_subtitle: "第五次按压"
	quest.0581BAF51FE4AC0E.title: "累积压缩机"
	quest.05D2E5B1967ACA74.quest_desc: [
		"任务本身不会解锁任何东西。配方才是关卡，所以你可以按任何顺序游玩。"
		""
		"这本书只会告诉你最快捷的上升路线。"
	]
	quest.05D2E5B1967ACA74.quest_subtitle: "想什么时候闲逛就什么时候闲逛"
	quest.05D2E5B1967ACA74.title: "这本书是指南，不是枷锁"
	quest.05E0843A654F9ACE.quest_desc: [
		"用 Ratlantean Spirit Flame 和 Feral Rat Claws 制作一个 &eVial of Consciousness&r，然后投掷给一个 &eFeral Ratlantean&r。"
	]
	quest.05E0843A654F9ACE.quest_subtitle: "古老帝国的一缕幽魂"
	quest.05E0843A654F9ACE.title: "新亚特兰蒂斯人 (The Neo-Ratlantean)"
	quest.05E2813C3F2C2723.quest_desc: [
		"木棍和扭曲树枝可以制作一个&e弹弓&r。它能发射深度岩卵石、黏球甚至浆果。"
	]
	quest.05E2813C3F2C2723.quest_subtitle: "你的新的好朋友"
	quest.05E2813C3F2C2723.title: "弹弓"
	quest.05F687666270083B.quest_desc: [
		"同样的概念，不过是针对流体而言。"
		""
		"用&e紫色激光透镜&r和范围内的凋零，可以制造&e以太气体&r。至尊框架需要135 mB的以太气体。"
		""
		"凋零必须全程待在基地的工作区域内，所以开始前先把它困住。"
	]
	quest.05F687666270083B.quest_subtitle: "从虚空中提取流体"
	quest.05F687666270083B.title: "流体激光基地"
	quest.0600D9EC6416AC4F.quest_desc: [
		"青铜地牢的领主。它会掉落青铜钥匙。"
	]
	quest.0600D9EC6416AC4F.quest_subtitle: "以太维度"
	quest.0600D9EC6416AC4F.title: "滑块装置"
	quest.0647084CB11F7A63.quest_desc: [
		"在熔炉、烟熏炉或篝火中烹饪鸡蛋（白色、蓝色或棕色）可获得一个&e煎蛋&r。"
		""
		"两个鸡蛋、牛奶和一个碗可以制作&e炒鸡蛋&r。吃掉它们能恢复一个心。"
	]
	quest.0647084CB11F7A63.quest_subtitle: "鸡蛋，两种做法"
	quest.0647084CB11F7A63.title: "早餐时间到了"
	quest.06671665AB193592.quest_desc: [
		"&e企鹅&r在雪原、冰冻海洋和冰冻河流中踱步。它们爱吃鱼：鳕鱼、鲑鱼或热带鱼。"
		""
		"繁殖两只，幼崽会掉落一根&e企鹅羽毛&r。用它酿造出&e滑动药水&r：你脚下的所有东西都会变得像冰一样滑溜。"
	]
	quest.06671665AB193592.quest_subtitle: "企鹅们！"
	quest.06671665AB193592.title: "快乐脚步"
	quest.06C2C360958CB3B3.quest_desc: [
		"Collectors next to a &eRelay&r feed their EMC into it, and it passes the total on."
		""
		"在旁边放置一个冷凝器或克莱因之星即可收集。"
	]
	quest.06C2C360958CB3B3.quest_subtitle: "收藏家们，集合起来"
	quest.06C2C360958CB3B3.title: "反物质中继器"
	quest.0725E6012330FBDF.quest_desc: [
		"&e模式编码终端&r能将&e空白模式&r转换为网络可重复使用的配方。"
	]
	quest.0725E6012330FBDF.quest_subtitle: "教给它一个配方"
	quest.0725E6012330FBDF.title: "编码模式"
	quest.07314736AD6ADF7C.quest_desc: [
		"将核心放在中间，从几格远的地方用直线对准它放置注射器。"
		"将催化剂放入核心，每个注射器放入一个材料，然后启动并点击合成。"
		""
		"&6注意：&r注射器等级必须至少达到配方要求。核心屏幕会提示你它们是否过近或过弱。"
	]
	quest.07314736AD6ADF7C.quest_subtitle: "在浪费一条 Wyvern Core 之前先读这个"
	quest.07314736AD6ADF7C.title: "融合的工作原理"
	quest.07325E2024C69008.quest_desc: [
		"Frostmaw 携带着一个 &eIce Crystal&r。右键使用它来引导冰旋风。"
		""
		"趁霜狼沉睡，狡猾的玩家可以偷走它..."
	]
	quest.07325E2024C69008.quest_subtitle: "偷走它，或者赢得它"
	quest.07325E2024C69008.title: "冰晶"
	quest.073E55C15865EFC8.quest_desc: [
		"&e远古矿井&r挖掘在山丘和山脉中。它们很大，所以带上火把。"
	]
	quest.073E55C15865EFC8.quest_subtitle: "深邃、黑暗而古老"
	quest.073E55C15865EFC8.title: "远古矿井"
	quest.074738FF67C0A339.quest_desc: [
		"每个&e储能组件&r都由三个低一级的组件组成：处理器、活力石英玻璃和一些粉尘。"
		""
		"从1k一路爬到16M。每个尺寸都有便携版可供选择。"
	]
	quest.074738FF67C0A339.quest_subtitle: "堆叠存储物品以完成存储任务"
	quest.074738FF67C0A339.title: "更大的能量电池"
	quest.07508D6BF52D2F41.quest_desc: [
		"任何混凝土周围的八个石英可制成八个 &eQuartz-Crete&r，这是一种带有砖块、柱子、石板、楼梯和墙壁的干净白色建筑材料。"
		""
		"Prefab 的现代建筑就是用它建造的。"
	]
	quest.07508D6BF52D2F41.quest_subtitle: "流畅而现代"
	quest.07508D6BF52D2F41.title: "石英混凝土"
	quest.0763BAEFD19537C7.quest_desc: [
		"箱子和抽屉的容量有限。 &eApplied Energistics 2&r 将所有物品存储在一个可搜索的网络中。"
		""
		"你在 Tier 1 建造了第一个网络。AE2 章节将教你如何扩展它。"
	]
	quest.0763BAEFD19537C7.quest_subtitle: "适用于一切事物的网络"
	quest.0763BAEFD19537C7.title: "真正的终局：AE2"
	quest.0767B4837AEA9B05.quest_desc: [
		"鲈鱼和梭子鱼在河流和湖泊中游泳。锅中：生鲈鱼、红色蘑菇群、米饭和番茄。"
	]
	quest.0767B4837AEA9B05.quest_subtitle: "升级Aquatic的鱼类生物"
	quest.0767B4837AEA9B05.title: "与蘑菇一同栖息在枝头"
	quest.07885506126144CD.quest_desc: [
		"她统治着卫城。前方将有暴风雨。"
	]
	quest.07885506126144CD.quest_subtitle: "L_Ender's Cataclysm"
	quest.07885506126144CD.title: "斯库拉"
	quest.079A35250E1B9488.quest_desc: [
		"Y 0以下，有些乌龟背上驮着矿石。用镐子敲击&eOretoise&r即可开采。"
		""
		"之后喂它发光浆果，它可能会把矿石长回来。"
	]
	quest.079A35250E1B9488.quest_subtitle: "由矿石制成的乌龟"
	quest.079A35250E1B9488.title: "驯服海龟！"
	quest.08147F5B8159081E.quest_desc: [
		"&eCulinary Generator&r会燃烧食物。它连接到&eHoney&r和&ePotion&r发电机。"
		""
		"适合建造一个能产出超出你食量的农场。"
	]
	quest.08147F5B8159081E.quest_subtitle: "将食物转化为能量"
	quest.08147F5B8159081E.title: "烹饪发电机"
	quest.08220C4A89480B73.quest_desc: [
		"&e空的风扇催化剂&r承载着风扇吹过的东西：水、岩浆、灵魂沙等等。"
		""
		"内容物不会溢出或引发火灾，让您的生产线保持整洁。"
	]
	quest.08220C4A89480B73.quest_subtitle: "整洁有序的加工处理流程"
	quest.08220C4A89480B73.title: "风扇催化剂"
	quest.08365F21D40612E0.quest_desc: [
		"ICU 包含 &eWaystones: Sable&r。建造在 Create Aeronautics 飞船上的传送石在飞行时仍然有效。"
		""
		"从任何地方前往你的飞艇，无论它现在在哪里。"
	]
	quest.08365F21D40612E0.quest_subtitle: "带上你的飞行方式石出发吧"
	quest.08365F21D40612E0.title: "船上的传送石 (Waystones on Ships)"
	quest.08539337F0310F62.quest_desc: [
		"&e加固爆破砖&r 是爆破砖加钢板。手册上显示了形状。"
		""
		"将&e高炉预热炉&r安装在侧面并为其供电以加快速度。"
	]
	quest.08539337F0310F62.quest_subtitle: "钢铁，速度更快"
	quest.08539337F0310F62.title: "改良型高炉 (Improved Blast Furnace)"
	quest.0859292702DBBC76.quest_desc: [
		"建造一个 &e无线接入点&r，并在接入点的插槽中连接一个 &e无线终端&r。"
		""
		"接入点中的无线增强器能扩大其覆盖范围。"
	]
	quest.0859292702DBBC76.quest_subtitle: "口袋里的存储空间"
	quest.0859292702DBBC76.title: "无线访问权限已授予。您可以使用无线方式访问您的物品。"
	quest.085D60EDD3419B83.quest_desc: [
		"铁锭和木棍可以制作一把&e锤子&r。"
		""
		"右键（或潜行+右键）手工制作的家具和饰条，即可更改其外观或形状。"
	]
	quest.085D60EDD3419B83.quest_subtitle: "相同的方块，全新的外观"
	quest.085D60EDD3419B83.title: "锤子"
	quest.088056A6E9284F2F.quest_desc: [
		"卫城坐落在温暖的海洋中。在那里击败一只巨大的螃蟹状生物&eClawdian&r。"
	]
	quest.088056A6E9284F2F.quest_subtitle: "温暖的海洋之上"
	quest.088056A6E9284F2F.title: "雅典卫城"
	quest.088F078690605723.quest_desc: [
		"将金箔放在腰带上，五次通过手持齿轮、大齿轮和铁粒的部署器。"
		"有些会产出废料。这很正常。"
		""
		"&6注意：&r在ICU中，沉浸式航空器由Create部件建造。一架航空器的&e引擎&r需要一个精密机械装置、两张黄铜板、两张坚固板和一台&e锅炉&r（蒸汽机、流体储罐和烈焰燃烧器）。"
		"机身使用安山岩外壳，螺旋桨使用创造螺旋桨，而飞机本身则是机械合成台的配方。"
	]
	quest.088F078690605723.quest_subtitle: "顺序组装任务书"
	quest.088F078690605723.title: "精密机械装置"
	quest.08B532972E7E4623.quest_desc: [
		"三块羊毛放在三块木板上可以制作四个&e凳子&r。你可以坐在上面。"
		""
		"在凳子顶部放置一个方块，它就会变成一个小板桌。"
	]
	quest.08B532972E7E4623.quest_subtitle: "找个地方坐下吧"
	quest.08B532972E7E4623.title: "凳子"
	quest.08BC40D3F468BC8F.quest_desc: [
		"普通的帆船帆在船快速移动时会&e产生升力&r。这就是制造飞机的原理。"
		"&eSymmetric Sails&r (two sails in a grid) only make &edrag&r. Angle them to steer or steady the ship."
	]
	quest.08BC40D3F468BC8F.quest_subtitle: "翅膀和鱼鳍"
	quest.08BC40D3F468BC8F.title: "对称风帆"
	quest.08CD7AF0473EE605.quest_desc: [
		"源宝石、黄金和岩浆桶可以制作一个 &e火山源链接&r。它能在5格范围内将燃料烧成源，用于罐子。"
		""
		"远古木原木会提供额外的源，尤其是炽热的远古木原木。 &6注意：&r 它的热量会慢慢将周围的石头变成岩浆，然后是熔岩。"
	]
	quest.08CD7AF0473EE605.quest_subtitle: "燃烧物品，获取源能量"
	quest.08CD7AF0473EE605.title: "火山源链接 Volcanic Sourcelink"
	quest.08DDE55D1776BD10.quest_desc: [
		"使用 Allthemodium 锭和末影珍珠制作一个 &e传送垫&r。"
		""
		"把它放在主世界，然后潜行并用空手右键点击它。"
	]
	quest.08DDE55D1776BD10.quest_subtitle: "一个充满矿石的完整世界"
	quest.08DDE55D1776BD10.title: "采矿维度"
	quest.0906C244D314B054.quest_desc: [
		"&e融合锻造&r，等级为Draconic。核心中的催化剂是&eDraconic Core&r（即Tier 5的Awakened Core）。"
		""
		"八个注射器里装着两个终极控制电路、两个氮晶、一个反物质丸、一个氮电容、一个终极感应单元和一个觉醒的德拉科尼乌姆块。"
		""
		"制作需要消耗 &e6400万 FE&r，所以准备好大容量电池。"
	]
	quest.0906C244D314B054.quest_subtitle: "三种动力模组，一种融合"
	quest.0906C244D314B054.title: "Dynamo Seal"
	quest.09441C18EC0E8A60.quest_desc: [
		"Inferium Essence、石头和 Inferium Gemstone 可以制作一个 &eGrowth Accelerator&r。把它放在农田下面。"
		""
		"它们可以堆叠：一列加速器都能加速其上方的植物，只要植物在范围内。"
	]
	quest.09441C18EC0E8A60.quest_subtitle: "农作物，但速度更快"
	quest.09441C18EC0E8A60.title: "生长加速器"
	quest.0994F641898F4397.quest_desc: [
		"将&eSphere&r或&eCube&r等模式放入&eProjector&r，用Fortron为其供电，然后看着屏障升起。"
		""
		"模块会改变大小、形状和该区域的功能。"
	]
	quest.0994F641898F4397.quest_subtitle: "属于你自己的防护罩穹顶"
	quest.0994F641898F4397.title: "力场投影仪"
	quest.099E6F4DC8196927.quest_desc: [
		"ICU 修改了配方：&e三&r个 Imperium Essence、一个 Infusion Crystal 和一个 &eVibranium Nugget&r 可以合成一个 Supremium。"
		""
		"所以 Tier 5 的农业要等 Vibranium (Tier 4) 才能进行。"
	]
	quest.099E6F4DC8196927.quest_subtitle: "ICU配方：内部含有Vibranium"
	quest.099E6F4DC8196927.title: "Supremium"
	quest.09A55272A1043E90.quest_desc: [
		"飞行器有升级槽。大多数升级需要使用 Create 铁板："
		"&e工业齿轮&r（一个齿轮）、&e坚固管道&r（一根流体管道）、&e钢制锅炉&r（一个流体储罐）、&e船体加固&r（一个船体）。"
		""
		"将鼠标悬停在升级上，即可查看其更改的属性。"
	]
	quest.09A55272A1043E90.quest_subtitle: "调整你的坐骑设置"
	quest.09A55272A1043E90.title: "飞行器升级"
	quest.09B1566EA2DA2647.quest_desc: [
		"晶体周围放置四个Tertium。黄金、烈焰和经验的作物属于Imperium层级。"
	]
	quest.09B1566EA2DA2647.quest_subtitle: "Tier 4 精华"
	quest.09B1566EA2DA2647.title: "帝国"
	quest.09C3777B3C8B581F.quest_desc: [
		"用&e振金块&r为绿宝石充能。"
	]
	quest.09C3777B3C8B581F.quest_subtitle: "绿色且会发光"
	quest.09C3777B3C8B581F.title: "灵性水晶"
	quest.09E218F12D06FCDE.quest_desc: [
		"熔炼煤炭或木炭（高炉速度加倍）可获得&e石墨锭&r。外壳和燃料棒都需要它们。"
	]
	quest.09E218F12D06FCDE.quest_subtitle: "烤煤炭"
	quest.09E218F12D06FCDE.title: "石墨"
	quest.09EA9D4A57F34BE4.quest_desc: [
		"&eHandcrafted&r 添加了合适的家具，&eMacaw's Fences and Walls&r 添加了各种风格的围栏和墙壁，而 &eGallery&r 则让挑选画作变得更简单。"
		""
		"这些都不是强制要求。所有东西都只是为了锦上添花。"
	]
	quest.09EA9D4A57F34BE4.quest_subtitle: "四面墙壁并非一个家"
	quest.09EA9D4A57F34BE4.title: "打造一个温馨舒适的家"
	quest.0A14A85803891F57.quest_desc: [
		"穿过传送门。Ratlantis 是一个由大理石奶酪遗迹、幽灵海盗和古老 Ratlantean 机器构成的完整维度。"
		""
		"带上食物和盔甲。当地人并不友好。"
	]
	quest.0A14A85803891F57.quest_subtitle: "一个帝国已经覆灭"
	quest.0A14A85803891F57.title: "Ratlantis"
	quest.0A44702BA0535D2A.quest_desc: [
		"为两个蓝冰充能以制作&e干冰&r。你的反应堆会感激不尽。"
	]
	quest.0A44702BA0535D2A.quest_subtitle: "最好的冷却剂"
	quest.0A44702BA0535D2A.title: "干冰"
	quest.0A47E84040E5B863.quest_desc: [
		"升级赋予大鼠新工作：&e伐木工&r砍树，&e种植工&r务农，而&e托盘工&r能让大鼠一次携带一整个物品堆栈。"
		""
		"将它们与奶酪法杖配对，这样老鼠就知道该把东西送到哪里了。"
	]
	quest.0A47E84040E5B863.quest_subtitle: "伐木工、农民和信使们"
	quest.0A47E84040E5B863.title: "Rat Workers"
	quest.0A4900F48B141845.quest_desc: [
		"下界工作台可以用末地石、末地水晶、绿宝石和水晶矩阵制作&e末地传送门框架&r。"
		""
		"末地工作台需要三个。"
	]
	quest.0A4900F48B141845.quest_subtitle: "是的，你可以制作它们"
	quest.0A4900F48B141845.title: "末地传送门框架"
	quest.0A9194E16FBBC4F4.quest_desc: [
		"&e铁路信号&r将轨道分为多个区块。同一时间只有一个火车可以进入一个区块。"
		""
		"在每个交叉口的两侧各放置一个，你的火车就会排队等候。"
	]
	quest.0A9194E16FBBC4F4.quest_subtitle: "请不要崩溃，拜托了"
	quest.0A9194E16FBBC4F4.title: "信号机"
	quest.0A9B0823CE733B02.quest_desc: [
		"你的法师之书，外加三个末影珍珠、两颗绿宝石、一个不死图腾、一个&e下界之星&r和&e野人贡品&r。"
		""
		"Tier 3 的符文归你了。下界之星意味着要打凋零，所以这个要等到 Tier 4。"
	]
	quest.0A9B0823CE733B02.quest_subtitle: "现存最好的书籍，没有之一"
	quest.0A9B0823CE733B02.title: "大魔导师的魔法书"
	quest.0AA61AD2D03FA08D.quest_desc: [
		"&eFlux Plug&r 用于输入电力，&eFlux Point&r 用于输出电力。将两者放置在同一网络的界面上。"
		""
		"它们可以跨越任何距离，甚至维度之间。"
	]
	quest.0AA61AD2D03FA08D.quest_subtitle: "无线电力传输"
	quest.0AA61AD2D03FA08D.title: "插头与接口"
	quest.0AA6B5A3979FC493.quest_desc: [
		"ICU 有 &eAeroPortals&r。驾驶模拟装置进入下界传送门，整艘船就会跟着过去。"
		""
		"把传送门建得足够大，能让飞船通过！"
	]
	quest.0AA6B5A3979FC493.quest_subtitle: "是的，是真的，我骗你干嘛"
	quest.0AA6B5A3979FC493.title: "通过传送门传送的船只"
	quest.0B00FF0D0E50B737.quest_desc: [
		"&e共享石&r能带你去到任何其他&e同色&r的共享石，无需激活。"
		""
		"制作一对用于两地快速传送的装置。机械合成台：石砖、染料、一块传送石和黑曜石。"
	]
	quest.0B00FF0D0E50B737.quest_subtitle: "颜色编码的网络"
	quest.0B00FF0D0E50B737.title: "分享石（Sharestones）"
	quest.0B0B43CB33EEED21.quest_desc: [
		"相同的锻造升级适用于每一件下界合金盔甲。"
	]
	quest.0B0B43CB33EEED21.quest_subtitle: "Tier 3 的顶端"
	quest.0B0B43CB33EEED21.title: "Allthemodium 盔甲"
	quest.0B19559E8C12CABE.quest_desc: [
		"ICU的配方：一个精英电路、两个原子合金和一个&e振金锭&r。Infuser快捷方式已关闭。"
	]
	quest.0B19559E8C12CABE.quest_subtitle: "最聪明的电路"
	quest.0B19559E8C12CABE.title: "终极控制电路"
	quest.0B2424E41D069EA9.quest_desc: [
		"制作一个&e空白烈焰燃烧器&r，并用它右键点击烈焰（或烈焰生成器）来捕获一只。"
		""
		"多几根烈焰棒也总没坏处。"
	]
	quest.0B2424E41D069EA9.quest_subtitle: "礼貌地"
	quest.0B2424E41D069EA9.title: "捕捉一只烈焰人"
	quest.0B3F951D2B3A48C3.quest_desc: [
		"&6Tier 1&r 免费：原版、Create、Powah、Immersive Engineering、AE2 和 Ars Nouveau 基础内容。"
		"&6Tier 2&r opens Mekanism. It needs Create casings, and advanced circuits need a Twilight Forest &eFiery Ingot&r."
		"&6Tier 3&r needs &eAllthemodium&r, &eIgnitium&r and &eKnightmetal&r."
		"&6Tier 4&r needs &eVibranium&r, &eWitherite&r and &eNether Stars&r."
		"&6Tier 5&r needs &eUnobtainium&r and a &eDragon Heart&r."
	]
	quest.0B3F951D2B3A48C3.quest_subtitle: "五个等级，一把梯子"
	quest.0B3F951D2B3A48C3.title: "进度系统运作方式"
	quest.0B82F2A450263BEE.quest_desc: [
		"在雪原的某处，冰封监狱关押着&eMaledictus&r。"
	]
	quest.0B82F2A450263BEE.quest_subtitle: "寒冷的牢笼"
	quest.0B82F2A450263BEE.title: "冰冻监狱"
	quest.0B8D6585A45C325F.quest_desc: [
		"&eInception&r 让你可以把背包放进背包里，而且它们的升级功能依然有效。"
		"&eEverlasting&r makes the backpack impossible to destroy and keeps it when you die."
		""
		"两者都需要 &e下界之星&r。"
	]
	quest.0B8D6585A45C325F.quest_subtitle: "背包里的背包"
	quest.0B8D6585A45C325F.title: "开端与永恒 (Inception and Everlasting)"
	quest.0BACD5E40156A753.quest_desc: [
		"把所有东西组合起来：一艘有升力、推力、转向和名字的船。"
		""
		"给它一个&e命名牌&r，把它停泊在你的基地，然后从空中俯瞰世界吧。"
	]
	quest.0BACD5E40156A753.quest_subtitle: "船长在甲板上"
	quest.0BACD5E40156A753.title: "处女航 (Maiden Voyage)"
	quest.0BE233612E1F9325.quest_desc: [
		"挖一个2x2的水池，用花或草围起来，再扔进一颗钻石。然后跳进去！"
	]
	quest.0BE233612E1F9325.quest_subtitle: "准备一份午餐"
	quest.0BE233612E1F9325.title: "暮色渐浓，步入其中"
	quest.0C04C9DB239D5F5B.quest_desc: [
		"&eWarp Stone&r 需要紫水晶、末影珍珠和一颗绿宝石。右键可随时随地打开传送石菜单。"
		"&eWarp Dust&r 是一种末影珍珠和紫水晶碎片。"
	]
	quest.0C04C9DB239D5F5B.quest_subtitle: "魔法的配料清单"
	quest.0C04C9DB239D5F5B.title: "传送石和传送粉尘"
	quest.0C149ADF2442F174.quest_desc: [
		"在 Y 0 以下，你可能会发现一个拿着物品的石头生物。那就是 &eStoneling&r。"
		""
		"悄悄靠近（或用&eGlow Shroom&r引诱它），打破外壳获取它的&eHeart of Diamond&r。别担心，它没事的！"
		""
		"在普通石头上使用一颗心，石人就会为自己建造一个新的身体。"
	]
	quest.0C149ADF2442F174.quest_subtitle: "史莱姆宝宝很害羞"
	quest.0C149ADF2442F174.title: "钻石之心"
	quest.0C2A56C3E83B8985.quest_desc: [
		"煤炭块、生肉或鱼、一颗钻石和一个金锭。 &e蜘蛛宠物&r能给予跳跃提升，并让你攀爬墙壁。"
	]
	quest.0C2A56C3E83B8985.quest_subtitle: "沿着墙壁向上攀爬"
	quest.0C2A56C3E83B8985.title: "蜘蛛宠物"
	quest.0C2AFF7914973B44.quest_desc: [
		"The &eElectrolytic Separator&r splits water into &eHydrogen&r and &eOxygen&r."
		""
		"氧气为净化室供能。氢气可为喷气背包充气或燃烧发电。"
	]
	quest.0C2AFF7914973B44.quest_subtitle: "水进去，气体出来"
	quest.0C2AFF7914973B44.title: "电解分离机"
	quest.0C56F215379380C7.quest_desc: [
		"充足的食物和饮料很重要：&e蜜瓜汁&r和&e苹果酒&r能恢复8点口渴值；蜜瓜片和汤也能补充一点。"
		""
		"西瓜汁需要四片西瓜、糖和一个瓶子。"
	]
	quest.0C56F215379380C7.quest_subtitle: "水真无聊"
	quest.0C56F215379380C7.title: "美味补水包"
	quest.0CA207C79FE5B6CF.quest_desc: [
		"用 Magebloom Fiber 包裹的纸可以制作出 &e空白羊皮纸&r。"
		""
		"将其放在抄写台上，选中你需要的法术书，然后潜行右键桌子即可刻录。炮塔和传送卷轴也需要羊皮纸。"
	]
	quest.0CA207C79FE5B6CF.quest_subtitle: "写在纸上的法术"
	quest.0CA207C79FE5B6CF.title: "法术羊皮纸"
	quest.0CD351EDAF63E27A.quest_desc: [
		"又大又蓬松，还会扔冰块。去雪林里找找它的洞穴吧。"
	]
	quest.0CD351EDAF63E27A.quest_subtitle: "暮色森林"
	quest.0CD351EDAF63E27A.title: "阿尔法雪怪"
	quest.0CE4EDEC0630D02E.quest_desc: [
		"来自下界灵魂黑匠的熔铸巨人。"
	]
	quest.0CE4EDEC0630D02E.quest_subtitle: "L_Ender's Cataclysm"
	quest.0CE4EDEC0630D02E.title: "下界合金怪物"
	quest.0D189E47B3524948.quest_desc: [
		"在冶金注入器中用钻石注入融合合金。每个精英控制电路需要两个。"
	]
	quest.0D189E47B3524948.quest_subtitle: "精英电路需要两个"
	quest.0D189E47B3524948.title: "强化合金 Reinforced Alloy"
	quest.0D19EF4031BA9F96.quest_desc: [
		"钻石镐和铲子可以合成&e推土机&r。首先需要动力：在砧板中将其与&e三重压缩石&r结合。"
		""
		"它会清除你面朝方向的一个 16x16x16 的空间，并将掉落物交给你。"
		""
		"&6注意：&r它只会掉落钻石工具能采集的物品，所以无法跳过镐的阶段。"
	]
	quest.0D19EF4031BA9F96.quest_subtitle: "把这片地都清理干净"
	quest.0D19EF4031BA9F96.title: "推土机"
	quest.0D38C574B1DAEEC1.quest_desc: [
		"被囚禁在冰冻监狱中。"
	]
	quest.0D38C574B1DAEEC1.quest_subtitle: "L_Ender's Cataclysm"
	quest.0D38C574B1DAEEC1.title: "Maledictus"
	quest.0D3911EF2DF3EDB7.quest_desc: [
		"&eFriends and Foes&r 将Minecraft生物投票中的生物加入游戏：哥布林、史莱姆、螃蟹、狡猾的掠夺者和一个火焰Boss。"
		""
		"&eFlowery Mooblooms&r 和 &eBeekeeper Hut&r 也加入了其中。 &6注意：&r所有 Friends and Foes 的实体和结构都在 ICU 中启用。"
	]
	quest.0D3911EF2DF3EDB7.quest_subtitle: "认识一下邻居们"
	quest.0D3911EF2DF3EDB7.title: "这里住着谁？"
	quest.0D512D613726E59B.quest_desc: [
		"用线、皮革和种子可以制作一个&e种子袋&r。最多可容纳640个同一种类的种子或树苗。"
		""
		"在地面上使用可一次性种植3x3的区域。也需要骨粉。"
	]
	quest.0D512D613726E59B.quest_subtitle: "640 个种子，一个物品栏位"
	quest.0D512D613726E59B.title: "种子袋"
	quest.0D91FC32FEE85AAE.quest_desc: [
		"&e化学清洗机&r用水冲洗脏的浆料。它消耗大量水，所以要从大水源供水。"
		""
		"还需要一个 &e终极控制电路&r。"
	]
	quest.0D91FC32FEE85AAE.quest_subtitle: "仅清理泥浆混合物"
	quest.0D91FC32FEE85AAE.title: "化学清洗器"
	quest.0DA038E1ACF4C1E1.quest_desc: [
		"&e牦牛&r生活在山丘和石峰上。剪它们的&e牦牛毛&r，但它们很讨厌。"
		""
		"九根毛线合成一个方块。三个方块和四张皮革合成&e牦牛裤&r。穿上它们，牦牛就不会介意被剪毛了。"
	]
	quest.0DA038E1ACF4C1E1.quest_subtitle: "毛茸茸的，脾气暴躁的"
	quest.0DA038E1ACF4C1E1.title: "Yakety Sax"
	quest.0DDD981952ECC5C9.quest_desc: [
		"Ignis 在 Nether 的 &eBurning Arena&r 中守卫。带上火焰抗性和一面好盾牌。"
	]
	quest.0DDD981952ECC5C9.quest_subtitle: "热。非常的热。"
	quest.0DDD981952ECC5C9.title: "Ignis"
	quest.0E019488C769374A.quest_desc: [
		"它守护着末地中的废弃堡垒。"
	]
	quest.0E019488C769374A.quest_subtitle: "L_Ender's Cataclysm"
	quest.0E019488C769374A.title: "末地守卫"
	quest.0E03DE31833B5B61.quest_desc: [
		"震金会出现在下界，而在&e另一个世界&r中，它的数量更多。"
		""
		"传言说，在末地使用传送垫时，它的表现会不一样。"
	]
	quest.0E03DE31833B5B61.quest_subtitle: "振金元素的第二家园"
	quest.0E03DE31833B5B61.title: "另一个世界 The Other"
	quest.0E209E3DE4096B99.quest_desc: [
		"生鱼、两株Pickerelweed和锅里的一个甜菜根。"
		""
		"Pickerelweed 生长在河流边缘。两种 Pickerelweed 加上糖可以制作出 &ePickerelweed 果汁&r。"
	]
	quest.0E209E3DE4096B99.quest_subtitle: "河边晚餐"
	quest.0E209E3DE4096B99.title: "带甜菜根的鳕鱼排"
	quest.0E2BCE1303A3A792.quest_desc: [
		"完整的&e陶土水碗&r。烹饪一两次，直到显示“已净化”为止。"
	]
	quest.0E2BCE1303A3A792.quest_subtitle: "快把水喝光吧"
	quest.0E2BCE1303A3A792.title: "陶土水碗"
	quest.0E2D5EB2B8489610.quest_desc: [
		"在车站的轨道上右键点击火车外壳以制作一个&e转向架&r。在其上建造，将所有部分粘合，并添加控制器。"
		""
		"打开车站，然后点击组装。火车来啦！"
	]
	quest.0E2D5EB2B8489610.quest_subtitle: "你的第一列火车"
	quest.0E2D5EB2B8489610.title: "全体登船！"
	quest.0E34FC54F8C76919.quest_desc: [
		"将鼠标悬停在任何物品上，并按下 &eR&r 查看其合成方式，或按下 &eU&r 查看其用途。"
		""
		"ICU 更改了部分配方以构建其层级。EMI 始终显示当前版本，所以请相信它而不是你的记忆。"
	]
	quest.0E34FC54F8C76919.quest_subtitle: "认真的，快用这个吧"
	quest.0E34FC54F8C76919.title: "EMI 知道所有配方"
	quest.0E82D9D43AAFA045.quest_desc: [
		"八块同种木材可以制作一个该木材颜色的箱子。每种木材都有专属的箱子。"
		""
		"快捷方式：八个&e原木&r围成一圈，可同时制作四个箱子。"
	]
	quest.0E82D9D43AAFA045.quest_subtitle: "你想要一个吗？Wood you like one?"
	quest.0E82D9D43AAFA045.title: "需要匹配的箱子"
	quest.0E90A4E655318F0F.quest_desc: [
		"一个&eME P2P隧道&r可通过单个通道传输多达32个信道。用存储卡连接输入和输出。"
		""
		"其他 P2P 类型可传输物品、流体、能量或红石。"
	]
	quest.0E90A4E655318F0F.quest_subtitle: "通过一根电缆进行传输"
	quest.0E90A4E655318F0F.title: "P2P 隧道"
	quest.0E94B47D1386A208.quest_desc: [
		"Put an iron ingot and a gold ingot on the Energizing Orb. Out comes &eEnergized Steel&r."
		""
		"Powah's 基础层级（电池、电缆、发电机）都由它制成。"
	]
	quest.0E94B47D1386A208.quest_subtitle: "铁和金，被闪电击中"
	quest.0E94B47D1386A208.title: "充能钢"
	quest.0E980ED9AED0F190.quest_desc: [
		"每个&e高级控制电路&r都需要一个&e炽热锭&r，所有精英和终极电路也都由一个炽热锭制成。"
		""
		"一个火焰血液（九头蛇）或火焰眼泪（远古守卫者）加一个铁锭可制作一个火焰锭。九头蛇会掉落7到10个火焰血液，抢夺效果可增加掉落量。"
		""
		"在花费电路之前，先规划好你的电路。"
	]
	quest.0E980ED9AED0F190.quest_subtitle: "Mekanism 的运行需要九头蛇之血"
	quest.0E980ED9AED0F190.title: "炽热锭预算计划"
	quest.0EA0329E3E8D97A7.quest_desc: [
		"锻造台里需要一个弓模板、一把弓和一颗绿宝石（或红宝石、紫水晶、黑曜石或铜）。"
		""
		"在ICU中，宝石弓比普通弓射得更快，飞行轨迹笔直，拉弓时还会轻微变焦。"
	]
	quest.0EA0329E3E8D97A7.quest_subtitle: "缩放与轰鸣"
	quest.0EA0329E3E8D97A7.title: "宝石弓箭"
	quest.0EA97C04C77C8ECA.quest_desc: [
		"最大的AE2单元格。继续用组件；MEGA Cells会接手剩下的。"
	]
	quest.0EA97C04C77C8ECA.quest_subtitle: "现在我们正在存储"
	quest.0EA97C04C77C8ECA.title: "64k 和 256k"
	quest.0EB474290A815116.quest_desc: [
		"红石块、烈焰棒和一块龙晶核心。它能自己产生粒子，也是&e能量核心稳定器&r的关键部件。"
	]
	quest.0EB474290A815116.quest_subtitle: "漂亮又实用"
	quest.0EB474290A815116.title: "粒子生成器"
	quest.0EBCB09FFADAFD0C.quest_desc: [
		"告诉&eME Requester&r要保留多少物品，当你的数量低于设定值时，它就会自动订购。"
		""
		"需要配方和一个空闲的合成 CPU。"
	]
	quest.0EBCB09FFADAFD0C.quest_subtitle: "始终有货，随时可取"
	quest.0EBCB09FFADAFD0C.title: "ME 请求器"
	quest.0EDE11FEE5A5A302.quest_desc: [
		"塑料、一个箱子、水桶、黄金、一个钻石齿轮和一个怜悯框架。"
		""
		"最多可将八种物品与流体结合。框架、附加组件和透镜都由此制成。"
	]
	quest.0EDE11FEE5A5A302.quest_subtitle: "IF 的真正合成台"
	quest.0EDE11FEE5A5A302.title: "溶解室"
	quest.0F30A6060CDD2A50.quest_desc: [
		"在盆中混合染料和水以制作&e液体染料&r。将其输送到储罐中，并用活板门舀出一些。"
		"用风扇吹过它进行批量染色，或者把物品和生物浸在里面。"
		""
		"液态染料与熔岩相遇会生成对应颜色的混凝土。"
	]
	quest.0F30A6060CDD2A50.quest_subtitle: "把所有东西都染上颜色"
	quest.0F30A6060CDD2A50.title: "液体染料"
	quest.0F4091394F1553AF.quest_desc: [
		"Integrated Dungeons and Structures 在世界各处散布着大型手工建造物：城堡、巫师塔、远古矿井、沉船等等。"
		""
		"用你的探险家罗盘去狩猎一个。进入其中一个后勾选此项。"
	]
	quest.0F4091394F1553AF.quest_subtitle: "城堡、塔楼和矿井"
	quest.0F4091394F1553AF.title: "综合地下城模组 (Integrated Dungeons)"
	quest.0F78E74EA1C83575.quest_desc: [
		"&e精密锯木机&r将原木切成额外的木板，并有几率掉落&e锯末&r。"
		""
		"木屑后面用来制作基质和塑料很方便。"
	]
	quest.0F78E74EA1C83575.quest_subtitle: "更多木板，外加一份奖励"
	quest.0F78E74EA1C83575.title: "精密锯木厂"
	quest.0F97E0C6C8D763EB.quest_desc: [
		"吹响&e空袭警报&r（需要奥拉奇卡姆），&c鼠男爵&r就会驾着飞机飞来。"
	]
	quest.0F97E0C6C8D763EB.quest_subtitle: "空袭警报！"
	quest.0F97E0C6C8D763EB.title: "鼠族男爵"
	quest.0FB32523113404E1.quest_desc: [
		"Supplementaries 添加了数十种实用方块和物品，以及一些小的原版调整。"
		""
		"试着把书或木棍放在地上，或者用砖块投掷某个东西（它甚至可能打破玻璃）。"
	]
	quest.0FB32523113404E1.quest_subtitle: "零零碎碎的杂物抽屉"
	quest.0FB32523113404E1.title: "补充物品"
	quest.0FB4DD1C3747E6FC.quest_desc: [
		"用顺序组装制作一个&e控制芯片&r，然后建造一个&e顺序脉冲发生器&r。"
		""
		"收到信号时，它会按设定时间运行红石脉冲序列。右键设置步骤。"
	]
	quest.0FB4DD1C3747E6FC.quest_subtitle: "编写你的红石电路程序"
	quest.0FB4DD1C3747E6FC.title: "控制芯片"
	quest.0FC5F5CF34B65280.quest_desc: [
		"启动一个水轮，然后在盆子上建造一个机械压榨机和机械搅拌机。"
		""
		"压机制作板材，搅拌机制作合金。你将永远使用这两种机器。"
	]
	quest.0FC5F5CF34B65280.quest_subtitle: "你的第一座真正工厂"
	quest.0FC5F5CF34B65280.title: "按下并混合"
	quest.0FC66384BEADB884.quest_desc: [
		"将&eLiveroot&r、生铁和金块混合成生铁木，然后将其冶炼。"
		""
		"肝根生长在森林地表下的根部。铁木齿轮是比铁更坚固的升级。"
	]
	quest.0FC66384BEADB884.quest_subtitle: "生长出来的，不是开采出来的"
	quest.0FC66384BEADB884.title: "铁木（Ironwood）"
	quest.0FD848EEC48F9940.quest_desc: [
		"控制器、驱动器和一个1k存储单元。这就是一个能用的ME系统！"
		""
		"更大的MEGA电池包需要更晚才能获得，而且需要稀有金属。"
	]
	quest.0FD848EEC48F9940.quest_subtitle: "你再也不用整理箱子了"
	quest.0FD848EEC48F9940.title: "你的第一个ME网络"
	quest.0FF7B11F2E272BD9.quest_desc: [
		"将&e涡轮转子&r堆叠在中间，每个转子装上两个&e涡轮叶片&r。"
		""
		"更多的叶片能捕获更多蒸汽，但塔身必须足够宽以容纳它们。"
	]
	quest.0FF7B11F2E272BD9.quest_subtitle: "旋转赢取胜利"
	quest.0FF7B11F2E272BD9.title: "螺旋桨和叶片"
	quest.100D0134F77FD3FA.quest_desc: [
		"用于扩展配方制作的AE2模式终端。将它们编码到&e空白扩展模式&r上（空白模式、certus石英和玻璃各需两个）。"
		""
		"基础终端是3x3的。5x5、7x7和9x9的终端需要在扩展合成台里制作。"
	]
	quest.100D0134F77FD3FA.quest_subtitle: "AE2 模式，但更大一些"
	quest.100D0134F77FD3FA.title: "扩展模式终端"
	quest.102792A0771AA8B2.quest_desc: [
		"下界堡垒里的凋零骷髅会偶尔掉落头骨。掠夺会很有帮助。"
	]
	quest.102792A0771AA8B2.quest_subtitle: "每个凋零需要三个"
	quest.102792A0771AA8B2.title: "凋零骷髅头骨"
	quest.102C05E390C73AA0.quest_desc: [
		"&eSteam 'n' Rails&r adds tracks made from each wood type, built the same way as Create's."
		""
		"自由组合搭配，适合你的建筑。"
	]
	quest.102C05E390C73AA0.quest_subtitle: "蒸汽与铁路"
	quest.102C05E390C73AA0.title: "适用于所有木材的轨道模组"
	quest.103BD1B42257280C.quest_desc: [
		"饥饿条旁边的水滴是&e口渴&r。口渴过低会减缓生命恢复，少于3滴时无法冲刺。"
		""
		"水有四种纯度等级：&c脏水&r、&6微脏水&r、&e可饮用&r和&a净化水&r。更脏的水会让你生病或中毒。"
	]
	quest.103BD1B42257280C.quest_subtitle: "水在这里是如何工作的"
	quest.103BD1B42257280C.title: "口渴与纯净"
	quest.106EFC72AA18E1C1.quest_desc: [
		"&eHV Wire Coils&r将钢线和铝线绞合在一起。 &eHV Transformer&r将中压与高压连接起来。"
		""
		"&6注意：&r高压电线很危险。把它挂高一点，别让人碰到。"
	]
	quest.106EFC72AA18E1C1.quest_subtitle: "长长的队伍，大大的负担"
	quest.106EFC72AA18E1C1.title: "HV 电力"
	quest.1078AAA91C419A16.quest_desc: [
		"&e机械活塞&r和&e轴承&r可以移动整个结构。用&e强力胶水&r将方块粘合起来。"
		""
		"所有粘合的部分都会作为一个整体移动。钻探机、农场和电梯都是这样工作的。"
	]
	quest.1078AAA91C419A16.quest_subtitle: "会移动的方块"
	quest.1078AAA91C419A16.title: "移动机械装置"
	quest.108DD97E0B57C5F9.quest_desc: [
		"在熔炉或篝火上熔炼水瓶或水桶。脏水会产出&e可接受的水&r；略脏水或可接受的水会产出&a净化水&r。"
		""
		"篝火很便宜，而且你不在家时也能发挥作用。"
	]
	quest.108DD97E0B57C5F9.quest_subtitle: "高温能杀死这些讨厌的家伙"
	quest.108DD97E0B57C5F9.title: "把它煮沸了"
	quest.10963CB6C39AFB40.quest_desc: [
		"速度升级能让机器变快（也更耗电）。将它们放入机器的升级栏中。"
	]
	quest.10963CB6C39AFB40.quest_subtitle: "加快速度前进"
	quest.10963CB6C39AFB40.title: "速度升级"
	quest.10A8D5C6B7B6F2FF.quest_desc: [
		"一个繁荣锭和两个灵魂尘可以制作一个&e灵魂锭&r。玻璃周围的灵魂尘可以制作&e灵魂玻璃&r。"
	]
	quest.10A8D5C6B7B6F2FF.quest_subtitle: "来自下界的精粹金属"
	quest.10A8D5C6B7B6F2FF.title: "灵魂锭"
	quest.10C6CB8353A5AF63.quest_desc: [
		"&e铁质箱子&r只是更大的箱子。用铜或铁锭围住一个木制箱子即可。"
		""
		"它们不会形成双箱，所以每个都是一个单独的方块。"
	]
	quest.10C6CB8353A5AF63.quest_subtitle: "更大的箱子"
	quest.10C6CB8353A5AF63.title: "铁质箱子"
	quest.10C94F59EF854A00.quest_desc: [
		"用红石注入铁，得到注入合金。你还需要堆叠另一个东西。"
	]
	quest.10C94F59EF854A00.quest_subtitle: "铁加上红石粉"
	quest.10C94F59EF854A00.title: "Infused Alloy"
	quest.10D19C361359314B.quest_desc: [
		"桑树藤生长在部分森林里。桑葚、糖和玻璃瓶可以制作&e桑葚果酱&r；用鸡蛋代替瓶子则能得到&e桑葚派&r。"
	]
	quest.10D19C361359314B.quest_subtitle: "果酱和派"
	quest.10D19C361359314B.title: "桑葚（Mùlǚbèi）"
	quest.10E2009B9A2FE51C.quest_desc: [
		"绿宝石和木棍，形状就是你熟悉的那些。"
		""
		"&e绿宝石镐&r挖掘速度和钻石镐一样快，能采集的方块也一样。但它只能使用725次，而钻石镐能用1561次。一堆用来交易的绿宝石的好归宿。"
	]
	quest.10E2009B9A2FE51C.quest_subtitle: "村民的钱，见面镐子"
	quest.10E2009B9A2FE51C.title: "Emerald Tools"
	quest.10E29951EDF1A8C8.quest_desc: [
		"Allthemodium 矿石需要下界合金镐。是时候去猎寻远古残骸了。"
	]
	quest.10E29951EDF1A8C8.quest_subtitle: "向下挖掘得更深一点"
	quest.10E29951EDF1A8C8.title: "下界合金镐"
	quest.1105AC0BF3DD31FE.quest_desc: [
		"偶尔，&e巨浪鲨&r会出现在深海冰冻洋中。它体型庞大，而且非常暴躁。"
		""
		"它能掉落 &e亚特兰蒂斯&r 唱片碎片。收集足够的碎片合成唱片。"
	]
	quest.1105AC0BF3DD31FE.quest_subtitle: "伟大的粉碎者"
	quest.1105AC0BF3DD31FE.title: "需要一艘更大的船了"
	quest.116F06FA55C55FBD.quest_desc: [
		"&eShafts&r 沿直线传递旋转。 &eCogwheels&r 将其横向传递给其他齿轮。"
		""
		"大齿轮旁的一个小齿轮会改变速度：大换小则加倍，小换大则减半。"
	]
	quest.116F06FA55C55FBD.quest_subtitle: "将旋转传递下去，让它继续转动"
	quest.116F06FA55C55FBD.title: "齿轮与传动轴"
	quest.11B9C0AE9E7A5E83.quest_desc: [
		"将种子基座放在祭坛上，然后在基座上放置四种材料和四种对应的精华。煤炭（Prudentium 级）是不错的选择；铁则需要 Tertium。"
		""
		"EMI 会显示具体布局以及每种种子所需的精华等级。"
	]
	quest.11B9C0AE9E7A5E83.quest_subtitle: "可以生长的铁块（Iron that grows）"
	quest.11B9C0AE9E7A5E83.title: "你的第一批资源作物"
	quest.11C92795924235DF.quest_desc: [
		"亚麻布和木棍可以制作一个&e遮阳篷&r（染成任何颜色）。遮阳篷有弹性，踩上去会弹起来。"
		""
		"半砖可以制作&e物品架&r来展示单个物品，而带泥土的半砖可以制作&e花箱&r，甚至可以容纳大型植物。"
	]
	quest.11C92795924235DF.quest_subtitle: "遮阳篷和架子"
	quest.11C92795924235DF.title: "商店门面"
	quest.11ED524258CED4B6.quest_desc: [
		"&eBorehead Bearing&r会旋转&eRock Cutting Wheels&r，破坏周围一定范围内的方块。钻头需要放置一个存储方块来收集掉落物。"
		""
		"它以输入速度四分之一旋转。把它装在探路车上，边开边挖隧道。"
	]
	quest.11ED524258CED4B6.quest_subtitle: "隧道掘进机"
	quest.11ED524258CED4B6.title: "Borehead Drill"
	quest.12207921B2E68532.quest_desc: [
		"ICU turns off the vanilla desert pyramid. IDAS builds its own &eDesert Pyramid&r instead."
		""
		"在沙漠中找到它，然后走进去。"
	]
	quest.12207921B2E68532.quest_subtitle: "不是原版的那个整合包"
	quest.12207921B2E68532.title: "沙漠金字塔"
	quest.1224EA0F97F1AE80.quest_desc: [
		"&e嵌入式菊石&r会出现在海滩、海洋和石质海岸的石头中。将其熔炼可获得&e鹦鹉螺壳&r。"
		""
		"用石砖围成的贝壳能制作八个 &e珊瑚石&r。贝壳也能制作导管。"
	]
	quest.1224EA0F97F1AE80.quest_subtitle: "鹦鹉螺壳，禁止钓鱼"
	quest.1224EA0F97F1AE80.title: "化石狩猎"
	quest.12251D3AF5BD7440.quest_desc: [
		"全套绿宝石装备的保护效果和钻石一样，只是耐久度稍低。"
		""
		"&6注意：&rICU 的配置中关闭了全套套装加成。如需水下呼吸，请携带 &eEmerald Juju&r（见下文）。"
	]
	quest.12251D3AF5BD7440.quest_subtitle: "绿色又坚固"
	quest.12251D3AF5BD7440.title: "翡翠盔甲"
	quest.122BA7AED143413C.quest_desc: [
		"娜迦会掉落一堆&e娜迦鳞片&r。合成娜迦鳞片上衣和护腿。"
		""
		"接下来几个首领的坚固盔甲，还有个好去处用掉那些鳞片。"
	]
	quest.122BA7AED143413C.quest_subtitle: "来自蛇的时尚单品"
	quest.122BA7AED143413C.title: "规模扩大"
	quest.125FD2DCC4D29FFF.quest_desc: [
		"&e燃气燃烧发电机&r可以燃烧易燃气体。分离器的氢气也可以使用。"
		""
		"&eEthene&r 燃烧得更好。用生物燃料、水和氢气在增压反应室中制作。"
	]
	quest.125FD2DCC4D29FFF.quest_subtitle: "燃烧氢气或乙烯"
	quest.125FD2DCC4D29FFF.title: "燃气燃烧发电机"
	quest.1264C2B387716968.quest_desc: [
		"埋在沙漠下的诅咒金字塔里。"
	]
	quest.1264C2B387716968.quest_subtitle: "L_Ender's Cataclysm"
	quest.1264C2B387716968.title: "远古遗迹"
	quest.1265E565562D7A44.quest_desc: [
		"在野生 Whirlisprig 旁边种一棵树以赚取代币。它的魅力需要 mageblooms、树苗、种子和一颗钻石。"
		""
		"将护身符放在有箱子的花朵上。它能将周围生长的东西变成原木、作物和花朵，而且喜欢多样性。"
	]
	quest.1265E565562D7A44.quest_subtitle: "一个自然小精灵"
	quest.1265E565562D7A44.title: "Whirlisprig"
	quest.12715610127B60C3.quest_desc: [
		"高级框架在溶解室中需要一个&e骑士金属锭&r。"
		""
		"还需要 500 mB 的 &ePink Slime&r，这来自一个 &eMob Slaughter Factory&r（参见 Industrial Foregoing）。"
	]
	quest.12715610127B60C3.quest_subtitle: "Industrial Foregoing，升级了"
	quest.12715610127B60C3.title: "高级机械框架"
	quest.128DC43B6BC74F42.quest_desc: [
		"用 &eAllthemodium Nugget&r 为烈焰粉（或烈焰棒）充能。"
	]
	quest.128DC43B6BC74F42.quest_subtitle: "辛辣的力量"
	quest.128DC43B6BC74F42.title: "烈焰水晶"
	quest.12AC8FB39DBDF64A.quest_desc: [
		"将八件暮色森林首领奖杯（Naga、Lich、Minoshroom、Hydra、Knight Phantom、Ur-Ghast、Alpha Yeti 和 Snow Queen）围绕一个 &eBlock of Carminite&r，放置在普通合成台上。"
		""
		"是的，奖杯会被消耗掉。先拍下你奖杯房的截图吧。"
	]
	quest.12AC8FB39DBDF64A.quest_subtitle: "一个奖杯架的容量"
	quest.12AC8FB39DBDF64A.title: "暮色封印"
	quest.12DAD28F3C107909.quest_desc: [
		"Mowzie's Naga 是一种来自海洋悬崖的飞行海蛇。它的 &eNaga Fang&r 可以制作成毒匕首和吹箭弹。"
	]
	quest.12DAD28F3C107909.quest_subtitle: "不是那条娜迦蛇（Not that Naga）"
	quest.12DAD28F3C107909.title: "Naga Fang"
	quest.12DC8F77486FC0D5.quest_desc: [
		"ICU 替换了大量原版建筑。村庄、沙漠金字塔、下界堡垒、海底神殿和废弃矿井都被新版本取代，而 Integrated Dungeons and Structures 则增加了数十个新内容。"
		""
		"你的&e探险家罗盘&r能找到所有结构。 &6注意：&rStructure Essentials 加快了ICU中的结构搜索速度。"
	]
	quest.12DC8F77486FC0D5.quest_subtitle: "世界的全新建筑风格"
	quest.12DC8F77486FC0D5.title: "更大更棒"
	quest.12F14687D95B984B.quest_desc: [
		"两个萤石粉、一个红石粉和一个火药可以合成&eLuminessence&r。"
	]
	quest.12F14687D95B984B.quest_subtitle: "发光粉尘"
	quest.12F14687D95B984B.title: "Luminessence"
	quest.1329B933485E1600.quest_desc: [
		"火把和双层压缩石可以制作一个&e即时桥梁&r。"
		""
		"设置其长度和材质，如果喜欢的话可以加个屋顶，然后建造它。"
	]
	quest.1329B933485E1600.quest_subtitle: "点击即可穿越到另一边"
	quest.1329B933485E1600.title: "即时桥梁"
	quest.13680614AF0F32CA.quest_desc: [
		"两个石制按钮、一个绿宝石和一个红石粉。"
		""
		"左键点击按钮或拉杆，并用 &eRedstone Remote&r 链接，之后即可在附近任意位置使用该遥控器。区块必须已加载，且无法跨维度生效。"
	]
	quest.13680614AF0F32CA.quest_subtitle: "从这边把它翻过来就可以了"
	quest.13680614AF0F32CA.title: "红石遥控器"
	quest.13E0B9AB796FB09D.quest_desc: [
		"The &eHull&r is andesite casing and iron ingots. The &eSail&r is six Create windmill sails."
		""
		"几乎所有的飞行器都需要两者兼备。"
	]
	quest.13E0B9AB796FB09D.quest_subtitle: "飞机的机身部分"
	quest.13E0B9AB796FB09D.title: "船体与船帆"
	quest.13F8DB1FFBBF2DBF.quest_desc: [
		"机器靠&e旋转&r而非能量运行。某物旋转，传动轴传递，机器利用。"
		""
		"卡住了？悬停物品并按住 &eW&r 观看其沉思场景。这是包里最好的说明书。"
		""
		"从小处着手：&e手摇柄&r在右键时能让物品转动。"
	]
	quest.13F8DB1FFBBF2DBF.quest_subtitle: "Create 101"
	quest.13F8DB1FFBBF2DBF.title: "让事物动起来 (Setting Things in Motion)"
	quest.1406AAD02D5496A5.quest_desc: [
		"用铁包裹铜发电机。每个固体燃料等级大约使发电量翻倍，并更有效地使用燃料。"
	]
	quest.1406AAD02D5496A5.quest_subtitle: "双倍的力量"
	quest.1406AAD02D5496A5.title: "铁发电机"
	quest.140CDC3B1469047C.quest_desc: [
		"在升级 Tier 1 的同时，可以看看 &e食物与农业&r 和 &e存储与物流&r。"
		""
		"烹饪锅和背包能让前期游戏体验好得多。"
	]
	quest.140CDC3B1469047C.quest_subtitle: "主路径并非唯一路径"
	quest.140CDC3B1469047C.title: "支线章节"
	quest.141BE2D7D73C375D.quest_desc: [
		"&e物质凝聚器&r会摧毁物品。给它一个存储组件，就能把它们变成物质球和奇点。"
		""
		"Bigger outputs need a bigger component; the screen tells you. You need a Singularity next."
	]
	quest.141BE2D7D73C375D.quest_subtitle: "将废料粉碎成某种东西"
	quest.141BE2D7D73C375D.title: "物质凝聚器"
	quest.14586875563167F9.quest_desc: [
		"灼热的竞技场位于下界废土。在对决 Ignis 之前，先和 &eIgnited Revenants&r 热身一下吧。"
	]
	quest.14586875563167F9.quest_subtitle: "伊格尼斯的家园"
	quest.14586875563167F9.title: "燃烧的竞技场"
	quest.145CF1D3D5071C16.quest_desc: [
		"&eRascals&r 是一群害羞的小家伙，喜欢玩捉迷藏。找到它们三次。"
		""
		"获胜后，它会给你一个奖品包，比如附魔的铁镐或一堆矿石。"
	]
	quest.145CF1D3D5071C16.quest_subtitle: "一个害羞的小矿工"
	quest.145CF1D3D5071C16.title: "捉迷藏"
	quest.14AF1F27484AD9FD.quest_desc: [
		"四个太阳能发电机、浸渍合金和铁可以制作&e高级&r版本。它占用更多空间，但能产生更多电力。"
	]
	quest.14AF1F27484AD9FD.quest_subtitle: "更大的面板"
	quest.14AF1F27484AD9FD.title: "高级太阳能发电机"
	quest.14D837EA08DC28F5.quest_desc: [
		"每个伟大的基地都始于一个工作台。你懂的。"
	]
	quest.14D837EA08DC28F5.quest_subtitle: "打树。做桌子。经典操作。"
	quest.14D837EA08DC28F5.title: "首先要做的事情就是先做第一件事"
	quest.14EF351BF61C1E8C.quest_desc: [
		"&eSwivel Bearing&r 会将前方的粘合方块组装成自己的装置，该装置可在轴承上旋转。"
		""
		"非常适合炮塔、襟翼和起落架。用红石供电，让它自由旋转。"
	]
	quest.14EF351BF61C1E8C.quest_subtitle: "移动船只上的移动部件"
	quest.14EF351BF61C1E8C.title: "可旋转轴承"
	quest.151E54A1D3E2D1F1.quest_desc: [
		"将干橡胶熔炼成&e塑料&r。几乎所有IF配方都需要它，所以要确保稳定供应。"
	]
	quest.151E54A1D3E2D1F1.quest_subtitle: "IF 货币"
	quest.151E54A1D3E2D1F1.title: "塑料"
	quest.154742EB618037F1.quest_desc: [
		"梯子的最顶端。说真的，恭喜你！"
		""
		"现在去建造点稀奇古怪的东西吧。"
	]
	quest.154742EB618037F1.quest_subtitle: "你击败了ICU！"
	quest.154742EB618037F1.title: "Infinity"
	quest.156544FA3B2541C0.quest_desc: [
		"&e激光&r正在为&e激光放大器&r充能。蓄满能量后，将其射入激光聚焦矩阵以点燃反应堆。"
		""
		"先将 Hohlraum 放入控制器中。"
	]
	quest.156544FA3B2541C0.quest_subtitle: "点燃需要火花才能开始"
	quest.156544FA3B2541C0.title: "激光武器"
	quest.15F64B978453C7F5.quest_desc: [
		"&eMechanical Crafters&r可以链接成任意大小的网格并自动合成。部分配方仅在此处有效。"
		""
		"&6注意：&r在ICU中，每个&eWaystone&r、Sharestone、Portstone和Warp Plate都需要在机械合成器网格中制作。布局请查看EMI。"
	]
	quest.15F64B978453C7F5.quest_subtitle: "大网格，无需双手操作"
	quest.15F64B978453C7F5.title: "机械合成台"
	quest.15FE548A93CC594D.quest_desc: [
		"娜迦生活在石质庭院中。它开启了暮色森林的 boss 连锁。"
		""
		"暮色森林要求你按顺序击败其首领，所以从这里开始。"
	]
	quest.15FE548A93CC594D.quest_subtitle: "一条非常长、非常愤怒的蛇"
	quest.15FE548A93CC594D.title: "那迦（Naga）"
	quest.1643D45A1C75D723.quest_desc: [
		"Little &eBeekeeper Huts&r sit in Flower Forests and Meadows, with beehives, a villager and mooblooms out front."
		""
		"桶里通常有蜂巢和几颗绿宝石。找到一个后勾选此项。"
	]
	quest.1643D45A1C75D723.quest_subtitle: "蜜蜂、牛和一个邻居"
	quest.1643D45A1C75D723.title: "养蜂人小屋"
	quest.1656895C20F9B813.quest_desc: [
		"访问所有 69 个 Biomes O' Plenty 生物群系，包括下界、末地和洞穴生物群系。"
		""
		"Biomes O' Plenty 会为此奖励你：一张名为&eWanderer&r的音乐唱片。这趟旅程很长。旅途愉快！"
	]
	quest.1656895C20F9B813.quest_subtitle: "每一个生物群系都无一例外"
	quest.1656895C20F9B813.title: "流浪者"
	quest.16663F0C24AC954D.quest_desc: [
		"右键点击两者并使用&e绳索耦合器&r，将&e绳索绞车&r和&e绳索连接器&r连接起来。"
		"转动绞车以收放绳索。两个绞车不能相互连接。"
		""
		"用滑索将货物吊在飞艇下，或者拖拽一艘驳船。"
	]
	quest.16663F0C24AC954D.quest_subtitle: "把它拖走，把它吊起来"
	quest.16663F0C24AC954D.title: "绳索和绞车"
	quest.166C5D24C5875F95.quest_desc: [
		"画布和木棍可以制作一个&e篮子&r。它能收集掉落到里面的物品，并将其推入箱子中。"
	]
	quest.166C5D24C5875F95.quest_subtitle: "一个有礼貌的漏斗"
	quest.166C5D24C5875F95.title: "篮子"
	quest.16704A1AF7476890.quest_desc: [
		"按照手册的布局建造&e金属压机&r，并用锤子将其塑形。"
		""
		"It does nothing without a mold: plates, rods, wire and gears all come from here, in bulk."
	]
	quest.16704A1AF7476890.quest_subtitle: "把它压成扁平状"
	quest.16704A1AF7476890.title: "金属压制机"
	quest.168742544C03B8B9.quest_desc: [
		"用暗物质方块和石头围住一个转换桌。同一个屏幕，走到哪里都一样。"
	]
	quest.168742544C03B8B9.quest_subtitle: "一个装在口袋里的桌子"
	quest.168742544C03B8B9.title: "Transmutation Tablet"
	quest.16899BE798BA8BAF.quest_desc: [
		"每个稳定器都是一个粒子发生器，需要四颗钻石。"
		""
		"能量核心需要四个部件环绕。核心的建造指南会显示放置位置。"
	]
	quest.16899BE798BA8BAF.quest_subtitle: "四角的力量"
	quest.16899BE798BA8BAF.title: "能量核心稳定器"
	quest.168BEE309904C501.quest_desc: [
		"Certus Quartz 生长于陨石内的 Budding Certus。将 charged certus、红石和石英在水中混合可得到 &eFluix&r。"
		""
		"每个AE2部件你都需要用到这两种。"
	]
	quest.168BEE309904C501.quest_subtitle: "AE2 背后的水晶们"
	quest.168BEE309904C501.title: "Certus 和 Fluix"
	quest.16C75CA7F7C5FCE2.quest_desc: [
		"基岩、水晶矩阵、中子星、四种奇怪的原料和&e每种奇点各一个&r（ICU中有27个）。EMI会显示完整列表。"
		""
		"&6空间不足？&r先将全部27个奇点合并成一个&e永恒奇点&r。还有另一个催化剂配方可以替代使用。"
		""
		"&6基岩版：&r中子星压缩机可将10,000个深板岩压缩成1个，或用水晶镐挖掘。"
		""
		"催化剂能将中子星和水晶矩阵转化为无限。"
	]
	quest.16C75CA7F7C5FCE2.quest_subtitle: "一个就足够了"
	quest.16C75CA7F7C5FCE2.title: "Infinity催化剂"
	quest.17099265A0250255.quest_desc: [
		"一本书和一个杠杆可以制作出&e工程师手册&r。"
		""
		"IE 的每个多方块结构都有一个可旋转的 3D 预览页面。建造时将其保持在快捷栏上。"
	]
	quest.17099265A0250255.quest_subtitle: "阅读小字条款"
	quest.17099265A0250255.title: "工程师手册"
	quest.171F5D94EC9327F9.quest_desc: [
		"砖块、铁、木铲和水桶可以制作一个 &eCooking Pot&r。它需要在下方有热源：Stove、营火或火焰。"
		""
		"汤和炖菜需要在容器栏中放置碗。食物会留在锅中，直到你取走它们。"
	]
	quest.171F5D94EC9327F9.quest_subtitle: "真正的盛宴由此开始"
	quest.171F5D94EC9327F9.title: "烹饪锅"
	quest.172489645C1A52AF.quest_desc: [
		"此行不虚的三棵树：极光花园的&e彩虹桦&r、雪莲花林的&e雪莲花&r，以及起源谷的&e起源&r树。"
		""
		"敲碎它们的叶子获取树苗，在家里种植自己的树。"
	]
	quest.172489645C1A52AF.quest_subtitle: "那些漂亮的家伙们"
	quest.172489645C1A52AF.title: "稀有树苗"
	quest.174894421DCFB755.quest_desc: [
		"&eMob Fan&r会朝其面向的方向推挤生物。 &eIron Spikes&r会伤害站在上面的任何生物。"
		""
		"尖刺击杀会掉落经验值，但不计入玩家击杀数。"
	]
	quest.174894421DCFB755.quest_subtitle: "先推，再戳"
	quest.174894421DCFB755.title: "生物爱好者与尖刺陷阱"
	quest.176176CF73B4CF6F.quest_desc: [
		"用外壳和微型电容器为一个末影之眼注入能量，制成&e末影核心&r。"
		""
		"&e末影单元&r共享同一通道的世界各处电力池。 &e末影门&r将方块连接到该电力池。"
	]
	quest.176176CF73B4CF6F.quest_subtitle: "无需电线的电力传输"
	quest.176176CF73B4CF6F.title: "末地网络"
	quest.17B21FD09039A025.quest_desc: [
		"在&e加热&r的盆中混合4个末石粉、2个锌粒和水，制作&e浮空混合物&r。"
		""
		"将其作为流体倒出，然后用火把、打火石和钢或篝火点燃。晶体将蔓延至整个水池。一旦开始，就无法将混合物舀回。"
		""
		"足够的 Levitite 能让船在没有燃烧器的情况下漂浮。它不会自己爬升，所以需要加装螺旋桨。"
	]
	quest.17B21FD09039A025.quest_subtitle: "一块会漂浮的石头"
	quest.17B21FD09039A025.title: "Levitite"
	quest.17C33B1887EA6F64.quest_desc: [
		"将&e模式提供器&r放置在&e分子组装器&r旁边。模式放在提供器中，组装器会完成工作。"
	]
	quest.17C33B1887EA6F64.quest_subtitle: "小型机器人合成台"
	quest.17C33B1887EA6F64.title: "分子组装器 (Molecular Assembler)"
	quest.17D4647C9A15CAE9.quest_desc: [
		"将水分解为&e氧气&r和&e氢气&r。净化室需要氧气运行，所以你需要一个用于矿石三倍化。"
	]
	quest.17D4647C9A15CAE9.quest_subtitle: "水进去，气体出来"
	quest.17D4647C9A15CAE9.title: "电解分离机"
	quest.17F638B4D331E497.quest_desc: [
		"一个由 &eAssembler Matrix Frames&r、墙壁和玻璃组成的多区块结构，内部装有 Crafter、Pattern 和 Speed 核心。"
		""
		"它将成排的分子组装器替换为一个整洁的箱子。"
	]
	quest.17F638B4D331E497.quest_subtitle: "自动化合成，工业规模"
	quest.17F638B4D331E497.title: "Assembler Matrix"
	quest.180123C843E0CDFD.quest_desc: [
		"将&eInsanium Block&r放在&eEnchanting Apparatus&r上，并用以下物品填满周围的八个基座：Wilden Tribute、两个Awakened Supremium Ingot、一个Insanium Ingot、一个Source Gem Block，以及Manipulation、Abjuration和Conjuration Essence。"
		""
		"它会喝掉 &e1000 Source&r，所以保持你的罐子装满。"
		""
		"卡住了？Wilden Tribute 由 Wilden Chimera 掉落，而它只能通过 Summon Wilden 仪式召唤。Awakened Supremium 需要 Cognizant Dust。Ars Nouveau 和 Mystical Agriculture 章节都对此有说明。"
	]
	quest.180123C843E0CDFD.quest_subtitle: "源和土壤"
	quest.180123C843E0CDFD.title: "地脉封印"
	quest.182F260F6489A23E.quest_desc: [
		"这是最大的箱子。你的储物问题到此为止了。"
	]
	quest.182F260F6489A23E.quest_subtitle: "所有的储物空间都整理好了"
	quest.182F260F6489A23E.title: "MEGA 256M"
	quest.183C1918DC683244.quest_desc: [
		"狐狸犬会游荡于下界废土和玄武岩三角洲。在拥有&e火焰抗性&r时喂食煤炭，它可能会成为你的伙伴。"
		""
		"被驯服的狐狸犬喜欢在熔炉上打盹，而睡着的狐狸犬能让熔炉冶炼得更快。"
	]
	quest.183C1918DC683244.quest_subtitle: "热狗（Hot dogs）"
	quest.183C1918DC683244.title: "狐狸猎犬"
	quest.186F20BF9B197CE5.quest_desc: [
		"将一个泥土方块分解成四个&e泥球&r（或用一桶水混合泥土），然后向猪投掷一个。"
		""
		"泥猪甚至会让你把花插进它们的泥里。"
	]
	quest.186F20BF9B197CE5.quest_subtitle: "猪喜欢泥巴"
	quest.186F20BF9B197CE5.title: "泥泞不堪"
	quest.189270FA9A48333A.quest_desc: [
		"将锅炉运行在最高水平。你需要一个大水箱、充足的热量和一个能跟上的泵。"
	]
	quest.189270FA9A48333A.quest_subtitle: "最大锅炉"
	quest.189270FA9A48333A.title: "全速前进"
	quest.18979AE2DA331B36.quest_desc: [
		"将核废料储存在 &e放射性废料桶&r中。它们会缓慢分解废料。"
		""
		"更好的方法：用&e太阳能中子活化器&r将废料转化为钋，再用同位素离心机将其转化为钚。"
	]
	quest.18979AE2DA331B36.quest_subtitle: "物尽其用，避免浪费"
	quest.18979AE2DA331B36.title: "废物处理系统"
	quest.18C042ECCB825909.quest_desc: [
		"用龙核和&e龙之心&r合成融合锻造的龙晶块。你需要一个融合锻造核心和注射器。"
	]
	quest.18C042ECCB825909.quest_subtitle: "融合时间到了"
	quest.18C042ECCB825909.title: "觉醒的德拉科尼乌姆"
	quest.18D833EBB09CB4D1.quest_desc: [
		"Fiery Tears 和 Hydra's Fiery Blood 一样：一个加一个铁锭可以制作一个 &eFiery Ingot&r。"
		""
		"需要更多高级控制电路又不想再去沼泽的话，这个很方便。"
	]
	quest.18D833EBB09CB4D1.quest_subtitle: "炽热锭的备用方案"
	quest.18D833EBB09CB4D1.title: "Fiery Tears"
	quest.18E7925CB5C04AA3.quest_desc: [
		"Xaero's minimap 在角落。按 &eM&r 查看完整世界地图。"
		""
		"按 &eB&r 放置路标，按 &eU&r 查看路标。出发前请先标记好你的基地！"
	]
	quest.18E7925CB5C04AA3.quest_subtitle: "永远不要迷失方向"
	quest.18E7925CB5C04AA3.title: "你的地图"
	quest.18E8DBE782283678.quest_desc: [
		"每个物品都有一个&eEMC&r值，显示在工具提示中。便宜的东西价值低，稀有的东西价值高。"
		""
		"Your EMC is stored on you, not in the table, so any table or tablet can spend it."
	]
	quest.18E8DBE782283678.quest_subtitle: "通用货币"
	quest.18E8DBE782283678.title: "EMC 是什么？"
	quest.18F3F397F387225B.quest_desc: [
		"&eAllthemodium&r：主世界的深层黑暗，以及采矿维度。需要一把下界合金镐。"
		"&e振金&r：下界，与彼方。需要一把Allthemodium镐。"
		"&eUnobtainium&r：末地高地。需要振金镐。"
		""
		"每把镐都是前一把镐的锻造升级版。"
	]
	quest.18F3F397F387225B.quest_subtitle: "稀有金属制成的梯子"
	quest.18F3F397F387225B.title: "三种金属，三种镐子"
	quest.190548D43CA9C5CB.quest_desc: [
		"&eSpirit Orbs&r会出现在地牢和遗迹的宝箱、试炼之室的奖励、生物生成器和远古守卫者身上。"
		""
		"攒起来吧。一次需要4个。"
	]
	quest.190548D43CA9C5CB.quest_subtitle: "来自挑战的宝藏"
	quest.190548D43CA9C5CB.title: "灵魂球体 (Spirit Orbs)"
	quest.19256672EA161BDD.quest_desc: [
		"在源宝石周围放置八个石头可以获得&e源石&r。它是一种建筑材料，也是接下来几个合成配方的一部分。"
		""
		"用矩形块（外加一个完整的 Source Jar 和一个 Warp Scroll）甚至可以制作成一个 Warp Portal。"
	]
	quest.19256672EA161BDD.quest_subtitle: "闪烁着火花的原石"
	quest.19256672EA161BDD.title: "源石（Sourcestone）"
	quest.1926AA2537495BB7.quest_desc: [
		"&e工程师工作台&r由处理过的木材制成。加入铁、处理过的栅栏和石板即可制作&e工程师的工作台&r。"
		""
		"工作台会消耗蓝图进行制作。蓝图本身不会被消耗掉。"
	]
	quest.1926AA2537495BB7.quest_subtitle: "蓝图所在之处"
	quest.1926AA2537495BB7.title: "工程师工作台"
	quest.197510BC2DD5979D.quest_desc: [
		"海滩上现在会长出 &e椰子&r树。用斧头打破椰子，它会裂成两个 &e椰子片&r。"
		""
		"&6注意：&r椰子破碎时，有 1/5 的几率会蹦出一个 &e椰子蟹&r。小心脚踝。"
	]
	quest.197510BC2DD5979D.quest_subtitle: "Ecologics 海滩"
	quest.197510BC2DD5979D.title: "椰子！Coconuts!"
	quest.19A232392046B7E9.quest_desc: [
		"&e能源线缆&r用于连接发电机、电池和机器。在配置模式下使用扳手更改方向。"
	]
	quest.19A232392046B7E9.quest_subtitle: "把所有东西都连接起来"
	quest.19A232392046B7E9.title: "能量电缆"
	quest.19A92EA77BD72430.quest_desc: [
		"&e物品宝库&r合并成巨大的多方块存储。更宽的宝库能装下更多。"
		""
		"漏斗和滑槽可以从任意一侧向其输送物品。"
	]
	quest.19A92EA77BD72430.quest_subtitle: "批量存储，创造风格"
	quest.19A92EA77BD72430.title: "物品宝库"
	quest.19B9B49A3D9E5B7E.quest_desc: [
		"将&e远程透镜&r用于佩戴护目镜的导体上，然后再次使用以通过该导体的眼睛观察。"
	]
	quest.19B9B49A3D9E5B7E.quest_subtitle: "看看他们能看到什么"
	quest.19B9B49A3D9E5B7E.title: "远程透镜"
	quest.19BDB9DB7C87AA54.quest_desc: [
		"&eThrashers&r 在冰冷冻结的海洋中狩猎，地点在 Y 30 以下深处。它们会掉落 &eThrasher Tooth&r。"
		""
		"带上把好剑和能呼吸的方法。"
		""
		"Thrasher Tooth 也能在砧上修复三叉戟，就像棱镜岩碎片一样。"
	]
	quest.19BDB9DB7C87AA54.quest_subtitle: "冰冷的水中有什么东西在游动"
	quest.19BDB9DB7C87AA54.title: "牙齿仙女"
	quest.19C9A65ABD994D66.quest_desc: [
		"水瓶、水桶和升级底座可以制作一个&e口渴升级&r。它会帮你背包里的水喝掉。"
		""
		"&e高级&r版可以让你选择它喝水的时间。"
	]
	quest.19C9A65ABD994D66.quest_subtitle: "你的背包会为你自动倒出物品"
	quest.19C9A65ABD994D66.title: "口渴度升级"
	quest.19E596185E3CB74C.quest_desc: [
		"&e白砂&r出现在热带和神秘丛林，&e橙砂&r在雨林，而&e黑砂&r则在火山周围。"
		""
		"&6注意：&r使用Create O' Plenty，机械压机可将白砂与两块燧石和少量熔岩压缩成岩，将黑砂压缩成焦土。"
	]
	quest.19E596185E3CB74C.quest_subtitle: "白色、橙色和黑色"
	quest.19E596185E3CB74C.title: "彩色沙子"
	quest.1A132FF61661FD28.quest_desc: [
		"一个红石块、一个湮灭平面、一个青金石块、一个高级卡片和一些铁块。"
		""
		"将&eMagnet Card&r放入无线合成台或通用终端。它能拾取周围的物品，并发送到你的背包或直接送入ME系统。有快捷键可以切换，还有自动补充的开关。"
	]
	quest.1A132FF61661FD28.quest_subtitle: "把它们全部捡起来"
	quest.1A132FF61661FD28.title: "磁卡"
	quest.1A41635D9CFC221C.quest_desc: [
		"敲响&eFlying Dutchrat's Bell&r，召唤幽灵船的船长。"
	]
	quest.1A41635D9CFC221C.quest_subtitle: "敲响钟声"
	quest.1A41635D9CFC221C.title: "飞翔的荷兰鼠（The Flying Dutchrat）"
	quest.1A56DEA44562CC3D.quest_desc: [
		"当生命值低于最大值的一半时，两个图腾都会触发。它们也适合放在 Curios &echarm&r 插槽中。"
		""
		"在坏日子里，随身携带一个吧。"
	]
	quest.1A56DEA44562CC3D.quest_subtitle: "能拯救你的护身符们"
	quest.1A56DEA44562CC3D.title: "应急图腾（Emergency Totems）"
	quest.1AC39D89321B8D62.quest_desc: [
		"一把铁木镐和胸甲能帮你度过最初的几个首领。"
	]
	quest.1AC39D89321B8D62.quest_subtitle: "比铁还要好"
	quest.1AC39D89321B8D62.title: "铁木工具"
	quest.1B1B5B8A51ADC345.quest_desc: [
		"一个重生锚、凋零头颅、下界岩、下界合金和一个下界之星，围绕着一个双层压缩工作台。"
		""
		"在潜声合成台里制作。"
	]
	quest.1B1B5B8A51ADC345.quest_subtitle: "5x5 的表格"
	quest.1B1B5B8A51ADC345.title: "下界合成台"
	quest.1B292E1E1AFB04BE.quest_desc: [
		"用刀砍断草、小麦或水稻来收集&e稻草&r。"
		""
		"四个草可以制作&e画布&r，两个可以制作绳子。"
	]
	quest.1B292E1E1AFB04BE.quest_subtitle: "干燥、实用、无处不在"
	quest.1B292E1E1AFB04BE.title: "干草块"
	quest.1B416E4A39DF43C9.quest_desc: [
		"&eDominion Wand&r可以连接物品。点击一个罐子再点一个&eSource Relay&r即可从罐子中取出；点击中继器再点罐子即可放入罐中。"
		""
		"中继器可传递30格信号。红石信号会使其关闭。"
	]
	quest.1B416E4A39DF43C9.quest_subtitle: "挥舞魔杖，链接物品"
	quest.1B416E4A39DF43C9.title: "移动光源的位置"
	quest.1B631FCEC3B7655B.quest_desc: [
		"木棍和皮革可以制作一个&e滑翔伞&r。拿着它，从高处跳下然后滑翔。"
		""
		"滑翔和冲刺消耗&e耐力&r（光标旁的轮盘）。来自&e篝火&r的热气流会将你推回高空。"
	]
	quest.1B631FCEC3B7655B.quest_subtitle: "Leap of faith"
	quest.1B631FCEC3B7655B.title: "滑翔伞"
	quest.1B65BB7B5A268232.quest_desc: [
		"将带电的 Certus 投入水中，并使用 &eCertus 石英块&r，即可获得受损的萌芽方块。"
		"用那个方块再重复一次，直到变成 Chipped，然后是 Flawed。"
		""
		"有缺陷的方块会随晶体生长而缓慢衰败，所以继续制作更多。"
	]
	quest.1B65BB7B5A268232.quest_subtitle: "自己种植属于你的作物"
	quest.1B65BB7B5A268232.title: "制作正在生长的 Certus 方块"
	quest.1BA1D00A890D4F80.quest_desc: [
		"如果下界成功了，或许也试试末地吧。"
	]
	quest.1BA1D00A890D4F80.quest_subtitle: "……还有末地呢？"
	quest.1BA1D00A890D4F80.title: "The Beyond"
	quest.1BAEB2AA59379C8F.quest_desc: [
		"制作工程师之锤，用焦炭砖建造一个3x3x3的焦炭炉，然后用锤子敲击以形成它。"
		""
		"将煤炭炼成 &e煤炭焦炭&r。这是钢铁的关键。"
	]
	quest.1BAEB2AA59379C8F.quest_subtitle: "一直打，直到它变成一个多方块结构"
	quest.1BAEB2AA59379C8F.title: "工程师之锤"
	quest.1BD8395E5CBA975D.quest_desc: [
		"咒术炮台和源罐会持续驱动创造装置。基础炮台在装置互动时开火，计时炮台则自行开火。"
		""
		"将源罐上的&e显示链接&r展示在显示板上会显示其来源。"
	]
	quest.1BD8395E5CBA975D.quest_subtitle: "Ars Creo 让它保持运行状态"
	quest.1BD8395E5CBA975D.title: "机械装置上的魔法"
	quest.1BEB45F285584907.quest_desc: [
		"Tier 1 几乎所有东西都需要铁。多收集一些吧。"
		""
		"奖励：一个 &eMeteorite Compass&r，供你日后寻找 AE2 陨石时使用。"
	]
	quest.1BEB45F285584907.quest_subtitle: "人民的金属"
	quest.1BEB45F285584907.title: "铁器时代"
	quest.1C06F5F32A32E0DC.quest_desc: [
		"在宽2格、高3格的开口周围建造一个由 &eTeleporter Frames&r 组成的环形结构，其中包含一个 &eTeleporter&r 方块。"
		""
		"在GUI中设置频率并为其供电。传送核心需要原子合金。"
	]
	quest.1C06F5F32A32E0DC.quest_subtitle: "传送门，Mekanism 风格"
	quest.1C06F5F32A32E0DC.title: "传送器"
	quest.1C0A11A35B056ACD.quest_desc: [
		"木板、半砖和木棍可以制作两个&e椅子&r。木板和木棍可以制作两个&e桌子&r。"
		""
		"右键椅子即可坐下。每种木材都有其专属的一套。"
	]
	quest.1C0A11A35B056ACD.quest_subtitle: "晚餐准备好了，请享用"
	quest.1C0A11A35B056ACD.title: "桌子和椅子"
	quest.1C24B64D726323A1.quest_desc: [
		"单独制作一个轮子座架可获得一个&e居中轮子座架&r，再次制作即可将其还原。"
		""
		"试试两种风格，看看哪种更适合你的载具。"
	]
	quest.1C24B64D726323A1.quest_subtitle: "模拟扩展包（Simulated Extra）"
	quest.1C24B64D726323A1.title: "中心式轮轴座架"
	quest.1C474266AA5B05C9.quest_desc: [
		"莫阿是一种可以骑乘的大型飞行鸟类。野生莫阿会偶尔产卵，银色地牢的宝箱里也装有它们的蛋。"
	]
	quest.1C474266AA5B05C9.quest_subtitle: "先别数它们了"
	quest.1C474266AA5B05C9.title: "Moa 蛋"
	quest.1C486C9F3AE6F6B7.quest_desc: [
		"陨石中隐藏着&eBudding Certus Quartz&r。晶芽生长在其侧面；打破完整簇可获得晶体。"
		""
		"将发芽的方块留在原地。挖掘会损坏它。"
	]
	quest.1C486C9F3AE6F6B7.quest_subtitle: "生长出来的，不是开采出来的"
	quest.1C486C9F3AE6F6B7.title: "Certus Quartz"
	quest.1CAB9F32D0B3C198.quest_desc: [
		"小麦和鸡蛋（或水桶）可以制作小麦面团。在砧板上切它，得到&e生面团&r。"
		""
		"锅里的意大利面、牛肉末和番茄酱可以制作出&e肉丸意面&r。"
	]
	quest.1CAB9F32D0B3C198.quest_subtitle: "刀、面团、酱汁"
	quest.1CAB9F32D0B3C198.title: "意面之夜"
	quest.1CAF2847B87E5EE8.quest_desc: [
		"工厂是由多个并行工作的槽位组成的机器。围绕一个 Energized Smelter 或 Enrichment Chamber 建造一个吧。"
		""
		"带升级的工厂比一排单机要好得多。"
	]
	quest.1CAF2847B87E5EE8.quest_subtitle: "一次完成三项工作"
	quest.1CAF2847B87E5EE8.title: "基础工厂"
	quest.1CB0A493749E1D3A.quest_desc: [
		"在黑暗塔顶，击败加斯特陷阱附近的小卡米尼特加斯特幼体，然后用红石为其供电。"
		""
		"这样就能把&e远古守卫者&r拉下来战斗了。"
	]
	quest.1CB0A493749E1D3A.quest_subtitle: "把它们引诱下来"
	quest.1CB0A493749E1D3A.title: "恶魂陷阱"
	quest.1CC5CB15C4324C05.quest_desc: [
		"Ignis、Harbinger、Leviathan、Ender Guardian、Maledictus、Ancient Remnant、Netherite Monstrosity 和 Scylla。"
		""
		"你已抵达Cataclysm的顶峰！"
	]
	quest.1CC5CB15C4324C05.quest_subtitle: "所有首领，均已击败"
	quest.1CC5CB15C4324C05.title: "大灾变远行者"
	quest.1CD6033ECBD613DA.quest_desc: [
		"Draconium 锭、红石块和 Draconium 核心可以制作 &eWyvern 能量控制器&r。"
		""
		"Wyvern 工具、Mob Grinder 和中继水晶都使用它。"
	]
	quest.1CD6033ECBD613DA.quest_subtitle: "储存在箱子里的能量"
	quest.1CD6033ECBD613DA.title: "Wyvern 能量控制器"
	quest.1CE54D48617F39A6.quest_desc: [
		"&e植物肥料&r会向周围区域撒播肥料，以加快生长速度。"
	]
	quest.1CE54D48617F39A6.quest_subtitle: "生长速度加快"
	quest.1CE54D48617F39A6.title: "种植肥料 (Plant Fertilizer)"
	quest.1CE64890F026F739.quest_desc: [
		"&eImmersive Aircraft&r 为你提供现成的飞机。你可以像放置船一样放置它们，并立即起飞。"
		""
		"&6注意：&r在ICU中，部件由Create组件制成：精密机械、坚固板材、蒸汽引擎等。部分飞行器需要&e机械合成台&r。"
	]
	quest.1CE64890F026F739.quest_subtitle: "没有工具包，没有飞行能力"
	quest.1CE64890F026F739.title: "飞机，创造的方式"
	quest.1D20B96EDA2ACC25.quest_desc: [
		"锅里装着 Gloomper、Shimmerpearl、蘑菇、Ditchbulb、浆果和 Underbeans，容器是 &eGloomgourd&r。"
	]
	quest.1D20B96EDA2ACC25.quest_subtitle: "来自地下花园的盛宴"
	quest.1D20B96EDA2ACC25.title: "填充的忧郁葫芦"
	quest.1D44B1E57DB4AA49.quest_desc: [
		"&eQIO&r将物品存储在&eDrive Array&r内的驱动器中，并通过&eDashboard&r无线访问它们。"
		""
		"驱动器和阵列需要 &e终极控制电路&r。用单一频率连接所有东西。"
	]
	quest.1D44B1E57DB4AA49.quest_subtitle: "Mekanism 的存储网络"
	quest.1D44B1E57DB4AA49.title: "QIO"
	quest.1D44F0957F1FFD44.quest_desc: [
		"在ICU中，硫磺立方不会自动生成。你需要自己制作一个：用空桶（Quark）捡起一只小型&a史莱姆&r，然后用&e硫磺&r合成&e桶中的史莱姆&r。"
		""
		"给硫磺立方体喂食一个方块，它就会获得该方块的特性：有弹性、平坦、轻盈、光滑……"
		""
		"&c小心：&r给它TNT，它就会变得易燃。"
	]
	quest.1D44F0957F1FFD44.quest_subtitle: "桶里一个会弹跳的朋友"
	quest.1D44F0957F1FFD44.title: "硫磺立方体"
	quest.1D7C5D8546FA767B.quest_desc: [
		"四个原木围成一圈可制作四个&e空心原木&r。"
		""
		"潜行着走到开阔的一侧即可爬入。你也可以像爬隐梯一样向上攀爬。"
	]
	quest.1D7C5D8546FA767B.quest_subtitle: "爬行空间"
	quest.1D7C5D8546FA767B.title: "中空的日志"
	quest.1D96D321268E21BE.quest_desc: [
		"&e陀螺仪&r（指南针上的电子管）会显示你的飞行数据。其高级和电子版本会显示更多信息。"
		"&e增强型螺旋桨&r是一个用黄铜片包裹的创造螺旋桨。"
	]
	quest.1D96D321268E21BE.quest_subtitle: "一切照章办事，按部就班来"
	quest.1D96D321268E21BE.title: "陀螺仪和螺旋桨"
	quest.1DA2A9B677D068AA.quest_desc: [
		"&e晶体合成器&r可以批量处理所有“投入水中”的配方，并制作ExtendedAE的部件。"
	]
	quest.1DA2A9B677D068AA.quest_subtitle: "没有水的配方 Recipes without the water"
	quest.1DA2A9B677D068AA.title: "晶体合成器"
	quest.1DA39C900087D328.quest_desc: [
		"Applied Mekanistics 添加了 &e化学存储单元&r。外壳使用锇、石英玻璃和红石。"
		""
		"现在你的氢和氧也储存在驱动器里了。"
	]
	quest.1DA39C900087D328.quest_subtitle: "网络中的Mekanism气体"
	quest.1DA39C900087D328.title: "化学电池"
	quest.1DD3FDD19D7F7060.quest_desc: [
		"&eCompacting Drawer&r 最多可存储三种形式的同一种材料，并自动相互转换。"
		""
		"放入铁锭，根据需要取出方块或金块。"
	]
	quest.1DD3FDD19D7F7060.quest_subtitle: "金块、锭、方块"
	quest.1DD3FDD19D7F7060.title: "抽屉压缩器 (Compacting Drawers)"
	quest.1DE52811C0DF8DB1.quest_desc: [
		"石生者游荡于洞穴。它们脾气暴躁，但会用皇家锭与你交易。"
	]
	quest.1DE52811C0DF8DB1.quest_subtitle: "与当地人进行交易"
	quest.1DE52811C0DF8DB1.title: "跨维度商业"
	quest.1DFE092DA71947C4.quest_desc: [
		"她在冰川上的极光宫殿顶端等你。"
	]
	quest.1DFE092DA71947C4.quest_subtitle: "暮色森林"
	quest.1DFE092DA71947C4.title: "冰雪女王"
	quest.1DFE8431D7BD1B0C.quest_desc: [
		"&ePortstone&r 会打开传送门菜单以便你离开，但没有人能&e传送到&r它。"
		""
		"忙碌的基地枢纽的理想选择。机械合成台：石砖、染料、一块传送石和抛光安山岩。"
	]
	quest.1DFE8431D7BD1B0C.quest_subtitle: "从这里出发"
	quest.1DFE8431D7BD1B0C.title: "传送石"
	quest.1E26AEAE019A64BE.quest_desc: [
		"一个3x3x3的盒子：中间是燃料棒，上面是控制棒，其余都是外壳，控制器、端口和阀门在墙上。"
		""
		"将入口端口设为入口，并向其输入铀锭。然后在控制器中启动反应堆。"
	]
	quest.1E26AEAE019A64BE.quest_subtitle: "点燃它，照亮四周"
	quest.1E26AEAE019A64BE.title: "你的第一座反应堆"
	quest.1E3DB5691977762E.quest_desc: [
		"&eSculk&r、&eNether&r、&eEnd&r 和 &eExtreme&r Package Crafters 会用数据包制作 Avaritia 桌子配方，每种桌子尺寸各一个。每个配方都需要对应的 Avaritia 桌子来制作。"
		""
		"极限模式处理的是 9x9 的配方。"
	]
	quest.1E3DB5691977762E.quest_subtitle: "PackagedAvaritia"
	quest.1E3DB5691977762E.title: "Avaritia 包装制作者"
	quest.1E40B0ED036F6F66.quest_desc: [
		"&eTwig Nests&r 会出现在森林、丛林和针叶林里，通常附近有鸡。用剪刀打破一个才能保留巢穴，其他方式只会得到木棍。"
		""
		"有些村庄有鸡舍，Environmental 的鸭子也用巢穴。"
	]
	quest.1E40B0ED036F6F66.quest_subtitle: "最近有人很忙的样子"
	quest.1E40B0ED036F6F66.title: "巢穴在野外"
	quest.1E7120EF1A6E160A.quest_desc: [
		"住房加一个普通的AE2存储组件就能组成一个&e源存储单元&r。组件越大，单元越大。"
		""
		"像其他电池一样，把它插入ME驱动器中。"
	]
	quest.1E7120EF1A6E160A.quest_subtitle: "在驱动器中查找来源"
	quest.1E7120EF1A6E160A.title: "源存储单元"
	quest.1E85732A2DB81317.quest_desc: [
		"无尽催化剂想要 &e宇宙肉丸&r、&e终极炖菜&r、一颗 &e末地珍珠&r 和一块 &e唱片碎片&r。"
		""
		"食物配方需要各种各样的东西。现在开始建一个大农场吧。"
	]
	quest.1E85732A2DB81317.quest_subtitle: "一份非常奇怪的购物清单"
	quest.1E85732A2DB81317.title: "催化剂所需材料"
	quest.1EAE161A480B3398.quest_desc: [
		"&e远古石&r构成了“另一个世界”的大部分。拿一叠用于模板复制和建造。"
		""
		"提示：Cobblegen Galore 也能做到（见 Utilities）。"
	]
	quest.1EAE161A480B3398.quest_subtitle: "来自另一个世界的纪念品"
	quest.1EAE161A480B3398.title: "远古石"
	quest.1EBF1D09821A0427.quest_desc: [
		"被诅咒的金字塔埋在沙漠里。挖掘里面的可疑沙子，唤醒&e远古残骸&r。"
	]
	quest.1EBF1D09821A0427.quest_subtitle: "在沙漠的下面"
	quest.1EBF1D09821A0427.title: "被诅咒的金字塔"
	quest.1EDF310E570CE2AA.quest_desc: [
		"从灌木丛里采摘&eUnderbeans&r，然后种下&eGloomgourd&r种子。你还会待上一阵子，所以先建个农场吧。"
	]
	quest.1EDF310E570CE2AA.quest_subtitle: "豆类和葫芦类作物"
	quest.1EDF310E570CE2AA.title: "下方的食物补给"
	quest.1F08531B1E589616.quest_desc: [
		"黄金地牢的领主。它会掉落黄金钥匙。"
	]
	quest.1F08531B1E589616.quest_subtitle: "以太维度"
	quest.1F08531B1E589616.title: "太阳之灵"
	quest.1F18D37057C49B0F.quest_desc: [
		"用铜锭包围你的背包以进行升级。里面的物品会原封不动地保留。"
		""
		"每个等级都会增加更多槽位和更多升级槽位。"
	]
	quest.1F18D37057C49B0F.quest_subtitle: "宽敞了一些，空间更大了点"
	quest.1F18D37057C49B0F.title: "铜质背包"
	quest.1F23278AB54CEA40.quest_desc: [
		"三根亚麻纤维可以合成三根&e绳子&r。它能像梯子一样攀爬，你也可以像坠落一样快速滑下，而不会受到坠落伤害。"
		""
		"它能粘在方块侧面，甚至可以在方块之间横向奔跑。"
	]
	quest.1F23278AB54CEA40.quest_subtitle: "爬上去，滑下来"
	quest.1F23278AB54CEA40.title: "绳索"
	quest.1F2AD0F8E9CA201F.quest_desc: [
		"点燃后，反应堆会持续消耗 D-T 燃料，并产生巨大的热量和能量。"
		""
		"水冷将热量转化为涡轮蒸汽。恭喜你，成功解锁了Mekanism的电力科技树！"
	]
	quest.1F2AD0F8E9CA201F.quest_subtitle: "聚变能源已上线"
	quest.1F2AD0F8E9CA201F.title: "点火！"
	quest.1F3CD83C8C4F23E0.quest_desc: [
		"Undergarden Delight 添加了 Undergarden 金属制成的刀具。其中 &eCloggrum 刀具&r 是最简单的。"
		""
		"在棋盘上收割 Undergarden 作物和生物以获取新食材。"
	]
	quest.1F3CD83C8C4F23E0.quest_subtitle: "来自下方的匕首"
	quest.1F3CD83C8C4F23E0.title: "Undergarden 刀具"
	quest.1F452B2A8E37D574.quest_desc: [
		"土豆上方的&e钻石之心&r会生成一个&e小土豆&r。"
		""
		"把它放下来，然后给它拍一拍。"
	]
	quest.1F452B2A8E37D574.quest_subtitle: "它相信你能够完成这项任务"
	quest.1F452B2A8E37D574.title: "小土豆"
	quest.1F80124C1E29D084.quest_desc: [
		"任何木材的半砖和活板门都能制作成&e橱柜&r。它的容量和箱子一样大，非常适合放在厨房里。"
	]
	quest.1F80124C1E29D084.quest_subtitle: "看起来不错的储物空间"
	quest.1F80124C1E29D084.title: "厨房橱柜"
	quest.1F83664BD3BBB1FA.quest_desc: [
		"&eMechanical Pipes&r carry fluids. &ePressurized Tubes&r carry gases and other chemicals."
		""
		"&e基础化学储罐&r用于储存气体。它也是制作喷气背包和多种机器的部件。"
	]
	quest.1F83664BD3BBB1FA.quest_subtitle: "移动流体和气体"
	quest.1F83664BD3BBB1FA.title: "管道与管状物"
	quest.1FEED1EE9ABF71A0.quest_desc: [
		"&e工业涡轮机&r能将蒸汽转化为大量电力。从&e涡轮机外壳&r、&e涡轮机阀门&r（高级电路）和&e涡轮机通风口&r开始。"
		""
		"顶部有通风口，可以让蒸汽排出。"
	]
	quest.1FEED1EE9ABF71A0.quest_subtitle: "一座发电厂的墙壁"
	quest.1FEED1EE9ABF71A0.title: "涡轮外壳"
	quest.1FF92772ADE00E5F.quest_desc: [
		"&e流体管道&r用于输送流体。旋转管道上的&e机械泵&r会将流体推向箭头所指方向。"
		""
		"右键点击管道并添加窗口以检查水流。"
	]
	quest.1FF92772ADE00E5F.quest_subtitle: "移动液体"
	quest.1FF92772ADE00E5F.title: "管道与水泵"
	quest.20243D856ED59AC5.quest_desc: [
		"Better Tridents 让忠诚三叉戟更出色。扔进虚空会返回，会回到你扔出的位置，还会带回目标的掉落物和经验值。"
		""
		"三叉戟的穿刺效果对雨中或水中的任何生物都有效，并且你可以在铁砧上用海晶碎片修理三叉戟。"
	]
	quest.20243D856ED59AC5.quest_subtitle: "忠诚至终，永不背叛"
	quest.20243D856ED59AC5.title: "更好的三叉戟模组 (Better Tridents)"
	quest.2033BCEA2D32715A.quest_desc: [
		"&e扩展接口&r支持更多物品类型。 &e扩展驱动&r单个方块可容纳更多电池。"
	]
	quest.2033BCEA2D32715A.quest_subtitle: "所有东西都变得更大更棒"
	quest.2033BCEA2D32715A.title: "扩展接口与驱动模块 (Extended Interface and Drive)"
	quest.203F387234199262.quest_desc: [
		"在箱子、抽屉或储罐前放置一个 &eStorage Bus&r，网络就能像读取单元格一样读写它。"
	]
	quest.203F387234199262.quest_subtitle: "网络上的你的箱子，在网络上"
	quest.203F387234199262.title: "Storage Bus"
	quest.2049E12C17AF9635.quest_desc: [
		"踏入任意一个 Biomes O' Plenty 的生物群系。田野、枫树林、热带、红杉林：任选其一，即刻出发。"
		""
		"ICU 的流浪商人也能携带 Biomes O' Plenty 的商品，快去查看他们的交易吧。"
	]
	quest.2049E12C17AF9635.quest_subtitle: "Biomes O' Plenty"
	quest.2049E12C17AF9635.title: "某个新地方"
	quest.20714098F53ED571.quest_desc: [
		"将&eCheese&r扔到野鼠附近的地面上（按Q键），让它吃掉。持续喂食直到它吃饱，这样它就归你所有了。"
		""
		"用奶酪右键单击老鼠并不能驯服它。把奶酪放下。"
	]
	quest.20714098F53ED571.quest_subtitle: "耐心和奶酪"
	quest.20714098F53ED571.title: "一只属于你自己的老鼠"
	quest.207E76BEE1D25198.quest_desc: [
		"使用安山合金在去皮的原木上制作外壳。"
		""
		"&6注意：&r在ICU中，Mekanism的&e冶金注入器&r需要安山岩外壳。"
	]
	quest.207E76BEE1D25198.quest_subtitle: "记住这个任务！别忘了！"
	quest.207E76BEE1D25198.title: "安山岩外壳"
	quest.20889AD99C1FDB7A.quest_desc: [
		"灵魂黑匠隐藏在末地。那里住着&e末地怪物&r。"
	]
	quest.20889AD99C1FDB7A.quest_subtitle: "怪物诞生的地方"
	quest.20889AD99C1FDB7A.title: "灵魂锻造炉"
	quest.20990CC9794DBEFE.quest_desc: [
		"Upgrade your starter gear. The &eBasic Energy Cell&r and &eBasic Furnator&r can both be made from your Starter versions."
		""
		"每个 Powah 方块都有七个等级：入门、基础、硬化、烈焰、Niotic、Spirited 和 Nitro。"
	]
	quest.20990CC9794DBEFE.quest_subtitle: "比入门级更高级一点的内容"
	quest.20990CC9794DBEFE.title: "基础等级"
	quest.20D097B58D86361B.quest_desc: [
		"用石英和八个红石合成&e玫瑰石英&r，然后用&e砂纸&r抛光（按住右键）。"
		""
		"将抛光玫瑰石英放在铁板上可制作&e电子管&r。黄铜机器会消耗这些物品。"
	]
	quest.20D097B58D86361B.quest_subtitle: "用黄铜换取大脑"
	quest.20D097B58D86361B.title: "玫瑰石英和电子管"
	quest.20D4569035A72302.quest_desc: [
		"一个含有两种精粹的繁荣锭可以制作该品级的&e精粹锭&r。繁荣宝石对宝石也能做到同样的效果。"
		""
		"齿轮、加速器和机器升级都由这些材料制成。"
	]
	quest.20D4569035A72302.quest_subtitle: "合成材料"
	quest.20D4569035A72302.title: "精粹锭和宝石"
	quest.20E1F596182ED0AA.quest_desc: [
		"铁、金、钻石和其他版本的方块生成器速度更快。悬停查看速度。"
	]
	quest.20E1F596182ED0AA.quest_subtitle: "金属制品能加快进度"
	quest.20E1F596182ED0AA.title: "更快的发电机"
	quest.21158BB39097055E.quest_desc: [
		"在&e配方编码器&r中，选择配方类型，摆好配方，放入&e配方持有器&r，然后点击保存。一个持有器最多可存储20个配方。"
	]
	quest.21158BB39097055E.quest_subtitle: "只需教导一次，即可学会所有技能"
	quest.21158BB39097055E.title: "配方编码器"
	quest.2135290C25968E4B.quest_desc: [
		"&eSteeleaf&r 会出现在空心山和迷宫的宝箱中。用它能制作轻便锋利的工具和盔甲。"
		""
		"多留几个在身边，暮色森林的很多配方都用得到。"
	]
	quest.2135290C25968E4B.quest_subtitle: "能切割的树叶"
	quest.2135290C25968E4B.title: "Steeleaf"
	quest.215B0BBF27878993.quest_desc: [
		"用四片铁板包裹的创造螺旋桨构成了飞机&e螺旋桨&r。"
	]
	quest.215B0BBF27878993.quest_subtitle: "旋转赢取胜利"
	quest.215B0BBF27878993.title: "螺旋桨"
	quest.21619D5A2183E4D5.quest_desc: [
		"两个棱镜岩碎片可以制作一个&e棱镜岩之杖&r。两个之杖和三个&e捕食者牙齿&r可以制作一把&e三叉戟&r。"
		""
		"比指望溺尸掉落一个要容易多了。"
	]
	quest.21619D5A2183E4D5.quest_subtitle: "不需要溺尸"
	quest.21619D5A2183E4D5.title: "制作你自己的三叉戟"
	quest.21670CA3CE5CB6B9.quest_desc: [
		"将赞尼特矿石熔炼成&e赞尼特宝石&r。"
		""
		"Zanite 工具会随着耐久度下降而变快，修复后又会变慢。"
	]
	quest.21670CA3CE5CB6B9.quest_subtitle: "穿戴后可提升速度"
	quest.21670CA3CE5CB6B9.title: "Zanite"
	quest.219CF20470E85D4A.quest_desc: [
		"最珍贵的：一个双压缩工作台、一个水晶矩阵、一个&e龙之蛋&r和两个&e不可得锭&r。"
		""
		"这是一个 7x7 的配方，所以让 EMI 告诉你每个物品的放置位置。"
	]
	quest.219CF20470E85D4A.quest_subtitle: "一个9x9的梦境网格"
	quest.219CF20470E85D4A.title: "极限工作台 (Extreme Crafting Table)"
	quest.21B0884AE96EAFB0.quest_desc: [
		"有安山岩外壳和黄铜外壳吗？这就是Mekanism需要的一切了。"
		""
		"进入&6二阶&r！"
	]
	quest.21B0884AE96EAFB0.quest_subtitle: "Mekanism 正在召唤你"
	quest.21B0884AE96EAFB0.title: "手持式弹壳容器"
	quest.21DB4F32EE363743.quest_desc: [
		"精英工作台（或其自动版本）、一块绿宝石块、终极组件和终极催化剂。"
	]
	quest.21DB4F32EE363743.quest_subtitle: "9x9 的表格"
	quest.21DB4F32EE363743.title: "终极合成台 (Ultimate Crafting Table)"
	quest.21E08271C5D3A123.quest_desc: [
		"一个&e火车站&r（外壳加指南针）建在轨道旁边。 &e火车控制器&r（带精密机械装置）可以让你驾驶火车。"
	]
	quest.21E08271C5D3A123.quest_subtitle: "火车生活的地方"
	quest.21E08271C5D3A123.title: "车站与控制台"
	quest.2201D42FCE1B63CD.quest_desc: [
		"六个羊毛和一个木棍可以制作一面&e旗帜&r。你也可以将旗帜的图案复制到旗帜上（查看EMI）。"
		""
		"将旗帜立在杆子上，然后点击杆子来升起或降下旗帜。"
	]
	quest.2201D42FCE1B63CD.quest_subtitle: "展示你的旗帜颜色吧"
	quest.2201D42FCE1B63CD.title: "旗帜"
	quest.220E75CCD647066F.quest_desc: [
		"最后一个地牢，在一个巨大的浮空岛上。击败&e太阳之灵&r。"
		""
		"它会掉落&eSun Altar&r，让你可以控制Aether的白昼与黑夜。"
	]
	quest.220E75CCD647066F.quest_subtitle: "被熄灭的火焰，归于沉寂。"
	quest.220E75CCD647066F.title: "黄金地牢"
	quest.222EBE28A0ACF7C6.quest_desc: [
		"访问每个更好的地牢：一个怪物房间、一个墓穴、一个不死者堡垒和一个蜘蛛洞穴。"
	]
	quest.222EBE28A0ACF7C6.quest_subtitle: "全部四件"
	quest.222EBE28A0ACF7C6.title: "专业地下城探险家"
	quest.225829DF02355D15.quest_desc: [
		"在黑暗森林的遗迹中有一个基座。将任意首领奖杯放置其上，即可升起骑士堡垒的盾牌。"
		""
		"先击败巫妖：这样就能解除黑暗森林的致盲诅咒。"
	]
	quest.225829DF02355D15.quest_subtitle: "小小的炫耀一下自己吧"
	quest.225829DF02355D15.title: "奖杯底座"
	quest.2281881A07C0D36D.quest_desc: [
		"&e节流阀手柄&r能输出0到15的精确模拟红石信号。右键并拖动以设置。"
		""
		"热空气燃烧器和蒸汽口会根据红石强度变化，所以这就是你的油门。"
	]
	quest.2281881A07C0D36D.quest_subtitle: "操作流畅顺滑"
	quest.2281881A07C0D36D.title: "节流阀手柄"
	quest.228E854DF4470B3F.quest_desc: [
		"一个由华丽部件组成的普通合成配方：四个 Concurrent Processors、两个 Supreme Machine Frames、一个 Quantum Entangled Singularity、一个 256M MEGA Storage Component 和一个 Accumulation Processor。"
	]
	quest.228E854DF4470B3F.quest_subtitle: "每个字节，都纠缠在一起"
	quest.228E854DF4470B3F.title: "网络封印"
	quest.22AC2BB1FB344886.quest_desc: [
		"&e流体存储单元&r储存流体的方式与物品单元储存物品相同。它们与物品单元共享一个驱动器。"
	]
	quest.22AC2BB1FB344886.quest_subtitle: "水桶不包含在内"
	quest.22AC2BB1FB344886.title: "流体存储装置"
	quest.22B379335E1DA58D.quest_desc: [
		"制作&e召唤瓦尔德恩仪式&r石板，并用瓦尔德恩尖刺、角和翼运行它以召唤&e瓦尔德恩奇美拉&r。"
		""
		"适合Tier 2施法者。带上增益和快速移动的方式。它会掉落一个&eWilden Tribute&r。"
		""
		"奇美拉不会自然生成，仪式是唯一方法。缺少任何部件都只会得到普通野人，战斗会破坏火盆周围的方块，所以请将火盆远离你的基地。"
	]
	quest.22B379335E1DA58D.quest_subtitle: "Ars 的中期游戏首领"
	quest.22B379335E1DA58D.title: "野性奇美拉 (The Wilden Chimera)"
	quest.22BD6FBC95DFE062.quest_desc: [
		"在 CurseForge 页面上留言，并附上你的 &elogs/latest.log&r 文件。这是你能发送的最有用的信息。"
	]
	quest.22BD6FBC95DFE062.quest_subtitle: "帮忙修复一下它"
	quest.22BD6FBC95DFE062.title: "发现漏洞了吗？"
	quest.22BE0C3227C4E72D.quest_desc: [
		"小麦种子周围的四个繁荣碎片可以合成一个&e繁荣种子基座&r，它是所有资源种子配方的中心。"
	]
	quest.22BE0C3227C4E72D.quest_subtitle: "所有作物都始于此处"
	quest.22BE0C3227C4E72D.title: "Prosperity Seed Base"
	quest.22C1684B39E9D2E9.quest_desc: [
		"完整的 9x9 网格的 &e极限工作台&r：全部八个封印、末地珍珠、各四块不可得锭和振金锭、四块晶体矩阵锭和八块中子锭。"
		""
		"这里是 InfinityCraft Ultra 的顶端。任选一件创意物品作为你的奖品。感谢你的参与！"
	]
	quest.22C1684B39E9D2E9.quest_subtitle: "你做到了。全部完成了。"
	quest.22C1684B39E9D2E9.title: "超新星（Ultra Star）"
	quest.22D1D5CE02017199.quest_desc: [
		"娜迦会掉落鳞片。它们能做成不错的早期盔甲，也是很好的墙面奖杯。"
	]
	quest.22D1D5CE02017199.quest_subtitle: "蛇皮，但更坚韧"
	quest.22D1D5CE02017199.title: "Naga Scales"
	quest.22D61102DFED5E4F.quest_desc: [
		"&eIntegrated Villages&r 会替换所有原版村庄。每个生物群系都有自己独特的风格。"
		""
		"始于平原上的一个&eMarketstead&r，一个围绕贸易建立的村庄。"
	]
	quest.22D61102DFED5E4F.quest_subtitle: "综合村庄整合包"
	quest.22D61102DFED5E4F.title: "村庄居民"
	quest.22EF539B27619037.quest_desc: [
		"Ender Storage - Energy 添加了 &eEnder Battery&r。将其中两个设置成相同的三种颜色即可共享电力，就像 Ender Chest 一样。"
	]
	quest.22EF539B27619037.quest_subtitle: "用于供电的末地存储装置"
	quest.22EF539B27619037.title: "末影电池"
	quest.2312FDFC06F8D66F.quest_desc: [
		"制作一个&eRatlantean Automaton Core&r，顶部放一个&eRatlantean Automaton Head&r，并用&eMarbled Cheese&r包围核心。然后去迎战被唤醒的敌人。"
	]
	quest.2312FDFC06F8D66F.quest_subtitle: "一个大理石花纹的奶酪哥布林"
	quest.2312FDFC06F8D66F.title: "拉特兰自动人偶"
	quest.2313F5EC91692409.quest_desc: [
		"向净化室输入氧气，每块矿石可产出三根锭。"
		""
		"&6注意：&r 该房间需要 &e高级控制电路&r，每个都需要来自九头蛇的火焰锭。所以这个要在九头蛇之后完成。"
	]
	quest.2313F5EC91692409.quest_subtitle: "这才像话嘛"
	quest.2313F5EC91692409.title: "矿石三倍化模组"
	quest.2316A855720EA56A.quest_desc: [
		"一个由 &eThermal Evaporation Blocks&r 组成的塔，带有一个 &eController&r 和一个 &eValve&r（两者都需要一个高级电路）。"
		""
		"水会变成&e盐水&r，盐水会变成&e锂&r。更多热量和高度会加快这个过程。"
	]
	quest.2316A855720EA56A.quest_subtitle: "咸水"
	quest.2316A855720EA56A.title: "热蒸发（Thermal Evaporation）"
	quest.2323961085C4E417.quest_desc: [
		"Four Create propellers, a Hull, a Boiler and string. It hovers slowly and steadily."
		""
		"非常适合高空建造，也就这些了。"
	]
	quest.2323961085C4E417.quest_subtitle: "建筑工人的好朋友"
	quest.2323961085C4E417.title: "四轴飞行器"
	quest.23295BB692697354.quest_desc: [
		"一个&e软管滑轮&r会下降到流体中并将其泵出。"
		""
		"如果水域足够大（大约一万格，比如海洋），它永远不会干涸。"
	]
	quest.23295BB692697354.quest_subtitle: "再也不要放置水桶了"
	quest.23295BB692697354.title: "无底之水"
	quest.234B77922ADFFC5F.quest_desc: [
		"Avaritia 长矛扩展包能让你从末地箱中获得水晶矩阵长矛。一个很棒的副武器。"
	]
	quest.234B77922ADFFC5F.quest_subtitle: "贪婪长矛"
	quest.234B77922ADFFC5F.title: "水晶长矛"
	quest.2356FB1E27372A2E.quest_desc: [
		"&eUndergrowth&r 是一片由 &eHellbark&r 树、荆棘和橙色 &eBurning Blossoms&r 组成的下界森林。"
		""
		"地狱树皮为你提供了一套完整的下界木建筑套装。"
	]
	quest.2356FB1E27372A2E.quest_subtitle: "下界里有树？"
	quest.2356FB1E27372A2E.title: "地狱树皮"
	quest.235DE59BCBDB3CF5.quest_desc: [
		"将&eSemaphore&r放在火车信号机上方的杆子上。其臂会显示信号是开放还是关闭。"
		""
		"将两个堆叠在黄铜信号上，以区分“部分路径阻塞”和“所有路径阻塞”。"
	]
	quest.235DE59BCBDB3CF5.quest_subtitle: "老式信号机"
	quest.235DE59BCBDB3CF5.title: "信号机"
	quest.23793BA312CC0EC9.quest_desc: [
		"青金石块、生鱼、钻石和金锭。 &eSquid Pet&r 能赋予水肺、水下清晰视野和游泳加速。"
		""
		"非常适合在陆地和海洋中进行升级后的水下狩猎。"
	]
	quest.23793BA312CC0EC9.quest_subtitle: "放轻松，别担心了"
	quest.23793BA312CC0EC9.title: "鱿鱼宠物"
	quest.2387273B20D4A452.quest_desc: [
		"ICU 包含 4 个着色器包：&eBSL&r（默认中等设置，阴影范围 128 格）、&eComplementary Reimagined&r、&eUnbound&r（含 Euphoria Patches 以适配模组方块）和 &eBliss&r。它们会&e自动&r启动。"
		""
		"&eF6&r 开启或关闭着色器。 &eF7&r (或视频设置，着色器包) 选择一个包 - 使用以 &e+ Clrwl&r 或 &e+ EuphoriaPatches&r 结尾的包 (它们能让 Create 机器保持高速运行)。"
		""
		"模组水与岩浆获得着色器效果并保持自身颜色。模组灯、灯笼、火把、蜡烛和水晶获得与原版相同的着色器外观。"
		""
		"帧率太低？打开整合包设置，选择较低配置（&e低&r，或&e最低&r / &e土豆&r），或者再次关闭着色器。"
		""
		"已知：船块尚无着色器效果，世界边界隐藏，着色器开启时 Levitite 的闪烁效果关闭。AMD RX 9000 显卡：若加入开启着色器的世界时崩溃，请先关闭着色器再加入，然后按 F6。"
	]
	quest.2387273B20D4A452.quest_subtitle: "很好看，但不是必须的"
	quest.2387273B20D4A452.title: "着色器（Shaders）"
	quest.239184E216D476E3.quest_desc: [
		"&e发酵器&r能将甘蔗、土豆和其他作物转化为&e乙醇&r。"
	]
	quest.239184E216D476E3.quest_subtitle: "工业化的酿造，大规模生产"
	quest.239184E216D476E3.title: "工业发酵器"
	quest.23A11A9F7C23D126.quest_desc: [
		"红石、白色羊毛、一颗钻石和一个金锭。 &e床宠&r 让你随时随地都能睡觉，或者召唤出一个活生生的床。"
		""
		"它对白色羊毛产生了渴望。"
	]
	quest.23A11A9F7C23D126.quest_subtitle: "在任何地方睡觉都可以"
	quest.23A11A9F7C23D126.title: "床宠"
	quest.23C911F48A232827.quest_desc: [
		"&eAllthemodium&r：主世界的深层黑暗，以及采矿维度。需要一把下界合金镐。"
		"&e振金&r：下界，与彼方。需要一把Allthemodium镐。"
		"&eUnobtainium&r：末地高地（末地外围岛屿）。需要振金镐。"
	]
	quest.23C911F48A232827.quest_subtitle: "闪闪发光的东西住的地方"
	quest.23C911F48A232827.title: "稀有金属速查表"
	quest.23E020BD53697018.quest_desc: [
		"建造一个&e融合锻造核心&r（青金石块、钻石、一个龙晶核心）和一些&e龙晶融合锻造注射器&r。"
		""
		"注射器也需要用德拉科尼姆核心制作，别忘了ICU的核心每个都需要一个&e振金锭&r。"
	]
	quest.23E020BD53697018.quest_subtitle: "龙之心脏 (The heart of Draconic)"
	quest.23E020BD53697018.title: "融合合成"
	quest.23EFEA24B6BE179C.quest_desc: [
		"原木顶部的树叶会生成两个&e树篱&r，即由树叶制成的围栏。"
		""
		"两片叶子并排放置可制作三张&e叶地毯&r，是一种用于地板和屋顶的薄叶层。"
	]
	quest.23EFEA24B6BE179C.quest_subtitle: "花园派对"
	quest.23EFEA24B6BE179C.title: "树篱和地毯叶块"
	quest.23F3F1B675F47C45.quest_desc: [
		"八个&e奶酪&r围成一圈，就能合成一个&e基础鼠鼠升级&r。几乎所有的其他鼠鼠升级都是从一开始的。"
		""
		"通过菜单为驯服的鼠鼠提供一个升级。"
	]
	quest.23F3F1B675F47C45.quest_subtitle: "每一次升级的开端都始于此处"
	quest.23F3F1B675F47C45.title: "Rat 升级：基础版"
	quest.244FDFB7AC310A1B.quest_desc: [
		"将&e终极催化剂&r放入左侧槽位（不会被消耗），然后投入&e10,000&r份单一材料和5,000,000 FE来制造一个&e奇点&r。"
		""
		"ICU 包含 19 种金属：铁、金、铜、钻石、绿宝石、红石、青金石、萤石、煤炭和十种模组金属。"
	]
	quest.244FDFB7AC310A1B.quest_subtitle: "一万合为一"
	quest.244FDFB7AC310A1B.title: "量子压缩机"
	quest.245A5BB782A0B9B3.quest_desc: [
		"需要 &e高级控制电路&r。它将尘埃压缩成 &e精炼黑曜石&r 和 &e精炼萤石&r 锭，由锇提供燃料。"
		""
		"精制黑曜石可用于制作许多中后期装备。"
	]
	quest.245A5BB782A0B9B3.quest_subtitle: "精炼金属"
	quest.245A5BB782A0B9B3.title: "锇压缩机"
	quest.2461E58C21B2A2B2.quest_desc: [
		"被磁铁包围的旋转&e发电机线圈&r会产生电力。由&e碳刷&r来收集电力。"
		""
		"更强的磁铁能将更多压力转化为动力，但线圈的胃口也会变大。线圈本身从不产生旋转。"
	]
	quest.2461E58C21B2A2B2.quest_subtitle: "旋转赢取胜利"
	quest.2461E58C21B2A2B2.title: "发电机线圈"
	quest.24684F649401208C.quest_desc: [
		"将觉醒核心、觉醒的德拉科尼乌姆和大型混沌碎片融合，并使用一个大型混沌碎片作为催化剂。"
	]
	quest.24684F649401208C.quest_subtitle: "盒子里的纯粹混乱"
	quest.24684F649401208C.title: "混沌核心"
	quest.24689CCC040BFB40.quest_desc: [
		"将&e生长加速器&r放置在萌芽方块旁并为它们供电。芽会生长得更快。"
	]
	quest.24689CCC040BFB40.quest_subtitle: "加快花苞的生长速度"
	quest.24689CCC040BFB40.title: "生长加速器"
	quest.247DBD810409FE1A.quest_desc: [
		"击败所有三种幻术师：一名&eEvoker&r、一名&eIceologer&r和一名&eIllusioner&r。"
		""
		"唤魔者会出现在林地府邸和袭击中。"
	]
	quest.247DBD810409FE1A.quest_subtitle: "三名施法者"
	quest.247DBD810409FE1A.title: "魔法师们"
	quest.24924F33557D8248.quest_desc: [
		"&e强制驱动器&r将能量转化为&e福特伦&r，能量护盾由此运行。"
		""
		"&eFortron Capacitor&r 会与同频机器共享 Fortron。"
	]
	quest.24924F33557D8248.quest_subtitle: "将力量赋予福特伦（Fortron）"
	quest.24924F33557D8248.title: "强制力导出器"
	quest.24A67EF416F325F6.quest_desc: [
		"在点燃的烈焰燃烧器上方的盆中混合铜和锌。产物是&e黄铜&r。"
		""
		"锌矿石在普通世界很常见，提前粉碎能加倍产量。"
	]
	quest.24A67EF416F325F6.quest_subtitle: "铜加锌，再加加热"
	quest.24A67EF416F325F6.title: "黄铜"
	quest.24EB6EF5142BE7E7.quest_desc: [
		"&eHeat Generator&r会燃烧熔炉燃料。当熔岩接触到它的侧面时，它还能免费产生电力。"
		""
		"用岩浆源方块围住一个，即可搭建无需燃料的初始装置。"
	]
	quest.24EB6EF5142BE7E7.quest_subtitle: "你的首个 Mekanism 能源"
	quest.24EB6EF5142BE7E7.title: "热能发电机"
	quest.24F6F9ED00B76A48.quest_desc: [
		"振金矿石会出现在&e下界&r和&e另一个世界&r中。"
	]
	quest.24F6F9ED00B76A48.quest_subtitle: "紫色而又珍贵的东西"
	quest.24F6F9ED00B76A48.title: "下界宝藏"
	quest.24FF75F62E86BF53.quest_desc: [
		"铁、木板和一个箱子可以制作一个&e木箱&r。它能容纳多达640个物品，无论堆叠大小。"
		""
		"不适合大量存储，但非常适合存放工具、盔甲和所有随机拾取的物品。"
	]
	quest.24FF75F62E86BF53.quest_subtitle: "所有零零碎碎的东西都放在这里"
	quest.24FF75F62E86BF53.title: "木箱"
	quest.250A16B690CBB7DA.quest_desc: [
		"玻璃和木板可以制作一个&e罐子&r。它可以用来存放液体（包括模组制作的汤、炖菜和饮料）、饼干或小生物。"
		""
		"史莱姆、岩浆怪、蜜蜂、幻翼和青蛙都适合。非常适合做宠物架。"
	]
	quest.250A16B690CBB7DA.quest_subtitle: "把它装进一个瓶子里面去"
	quest.250A16B690CBB7DA.title: "罐子"
	quest.251FABCADC6BACDD.quest_desc: [
		"原木、铁锭和红石块可以制作出&ePity Machine Frame&r。"
		""
		"大多数早期的 IF 机器都是围绕一个来建造的。"
	]
	quest.251FABCADC6BACDD.quest_subtitle: "这是一个开始"
	quest.251FABCADC6BACDD.title: "怜悯机器框架"
	quest.252CCC09DAD847D3.quest_desc: [
		"四个青金石、四个源宝石和一张空白羊皮纸可以制作一个&e传送卷轴&r。将其绑定到一个位置，然后使用它返回该位置。"
		""
		"仅限同一维度。稳定版（在装置上使用烈焰粉和末影珍珠）不会被消耗，并且可以跨维度使用。"
	]
	quest.252CCC09DAD847D3.quest_subtitle: "单程回家的车票"
	quest.252CCC09DAD847D3.title: "传送卷轴"
	quest.254FA077B2601398.quest_desc: [
		"将树脂块熔炼成&e树脂砖&r，然后将四块组合成一个&e树脂砖块&r。"
		""
		"它们有半砖、楼梯、墙壁和雕凿版几种形式。"
	]
	quest.254FA077B2601398.quest_subtitle: "使用橙色方块进行建造"
	quest.254FA077B2601398.title: "树脂砖块"
	quest.255861EAAC4A8A9F.quest_desc: [
		"爬上巫妖塔，击败巫妖。盾牌阶段请带上弓。"
	]
	quest.255861EAAC4A8A9F.quest_subtitle: "高耸的塔楼，恶劣的态度"
	quest.255861EAAC4A8A9F.title: "不死生物之王 (The Lich)"
	quest.255B2433E0D50766.quest_desc: [
		"腐化生物会掉落&e乌瑟里克碎片&r。插在棍子上的碎片是一种能伤害附近腐化生物的火炬。"
		""
		"用这些来点亮你的基地吧。"
	]
	quest.255B2433E0D50766.quest_subtitle: "腐烂，退散吧"
	quest.255B2433E0D50766.title: "碎片火把"
	quest.257F8C4DEBDF55D7.quest_desc: [
		"中子收集器能凭空缓慢地制造中子堆。设置好就不用管了。"
	]
	quest.257F8C4DEBDF55D7.quest_subtitle: "无中生有，创造一切"
	quest.257F8C4DEBDF55D7.title: "中子星物质"
	quest.2581B93E73B11C08.quest_desc: [
		"&e动物喂食器&r会繁殖范围内的动物。而&e动物牧场工&r则会挤奶和剪毛。"
		""
		"注意数字，动物太多会导致卡顿。"
	]
	quest.2581B93E73B11C08.quest_subtitle: "快乐的奶牛们"
	quest.2581B93E73B11C08.title: "动物养殖（Animal Husbandry）"
	quest.258644C40F015F3F.quest_desc: [
		"蜂蜜瓶和面包可以制作&e蜂蜜面包&r。蜂蜜瓶和烤猪排可以制作&e蜂蜜蜜汁猪排&r。"
		""
		"蜡烛、灯和其他物品也都在 Buzzier Bees 中等着你。"
	]
	quest.258644C40F015F3F.quest_subtitle: "更忙碌的蜜蜂模组 (Buzzier Bees)"
	quest.258644C40F015F3F.title: "蜂蜜零食"
	quest.258E127F75B18DCB.quest_desc: [
		"一个&e鼠鼠工作台&r加上一只带有&e鼠鼠升级：制作&r的鼠鼠，在你忙碌时为你制作配方。"
		""
		"&6注意：&r&eTick Accelerator&r 和 &eTime Manipulator&r 升级在 ICU 中已禁用。它们可以加速任何机器，包括被 ICU 等级锁定的机器。"
	]
	quest.258E127F75B18DCB.quest_subtitle: "小小的双手，大大的工厂"
	quest.258E127F75B18DCB.title: "Rat 自动合成"
	quest.25C506FFDB99FADA.quest_desc: [
		"使用振金模板和&e振金锭&r升级Allthemodium工具。"
		""
		"振金镐是你通往不可得之金的通行证。"
	]
	quest.25C506FFDB99FADA.quest_subtitle: "紫色的力量"
	quest.25C506FFDB99FADA.title: "振金工具"
	quest.25CC6F74D9AE53F8.quest_desc: [
		"厌倦了随机的画作？使用&e画廊&r，右键画作即可打开菜单，选择要悬挂的具体画作。"
	]
	quest.25CC6F74D9AE53F8.quest_subtitle: "画廊"
	quest.25CC6F74D9AE53F8.title: "挑选你的图片"
	quest.25DE6F9615E47983.quest_desc: [
		"在顶部堆叠一个 &eTuff&r 方块、任意 &ewool&r 和一个雕刻南瓜（或南瓜灯）来建造一个 &eTuff Golem&r。"
		""
		"斗篷的颜色取决于你使用的羊毛。制作完成后勾选此项。"
	]
	quest.25DE6F9615E47983.quest_subtitle: "小巧而困倦的村庄，坐落在宁静的山谷中。"
	quest.25DE6F9615E47983.title: "Tuff Golem"
	quest.25DE75A79CA0D7B8.quest_desc: [
		"种子、成捆的木材、压缩泥土、羊毛和水桶可以制作一个&e农场&r。"
		""
		"选择一个浆果农场、兔舍、高架农场、仙人掌农场、马厩、多层农场、鸡舍或牛肉农场。"
	]
	quest.25DE75A79CA0D7B8.quest_subtitle: "谷仓、围栏和鸡舍"
	quest.25DE75A79CA0D7B8.title: "箱中农场"
	quest.25DF9E09CF7AB7A0.quest_desc: [
		"一个简单的框架，用泥土、肥料和锄头。在上面种植，给它供电，它就会为你收割。"
	]
	quest.25DF9E09CF7AB7A0.quest_subtitle: "箱中农场"
	quest.25DF9E09CF7AB7A0.title: "水培种植床"
	quest.260A47EF47A10251.quest_desc: [
		"&e机械锯&r能将原木切成木板，也能切割传送带上的物品。把它装在装置上，就能砍倒整棵树。"
	]
	quest.260A47EF47A10251.quest_subtitle: "伐木机启动！"
	quest.260A47EF47A10251.title: "机械锯子"
	quest.262A4111B8A89791.quest_desc: [
		"给猪一个&e金胡萝卜&r，然后跟着它。它会嗅出附近的&e埋藏松露&r。"
		""
		"把松露挖出来。真不错！"
	]
	quest.262A4111B8A89791.quest_subtitle: "猪最清楚一切"
	quest.262A4111B8A89791.title: "松露大乱斗"
	quest.264154827D5AFA8E.quest_desc: [
		"&e堆叠升级&r让每个槽位能容纳比普通堆叠更多的物品。"
		"入门级用铜块，一级用铁块，二级和三级用金块和钻石块。"
		""
		"建造超过一个，它们会堆叠在一起。"
	]
	quest.264154827D5AFA8E.quest_subtitle: "64 只是一个建议"
	quest.264154827D5AFA8E.title: "堆叠升级（Stack Upgrades）"
	quest.26482A856469CE0E.quest_desc: [
		"Defeat a &eBluff&r for its Bluff Rod. The Sculptor wants one before he'll test you."
	]
	quest.26482A856469CE0E.quest_subtitle: "雕塑家专用雕刻工具棒"
	quest.26482A856469CE0E.title: "识破了你的虚张声势"
	quest.264C77BDA4716274.quest_desc: [
		"Inventory Pets 会建造自己的小型地牢：森林中的 &e树顶地牢&r、漂浮在空中的 &e天空地牢&r、&e地下地牢&r、&e海底洞穴&r、&e下界地牢&r 以及末地中的 &e太空地牢&r。"
		""
		"大多数都有各自的生成器守卫。掠夺完一个后勾选此项。"
	]
	quest.264C77BDA4716274.quest_subtitle: "专为宠物而建造"
	quest.264C77BDA4716274.title: "宠物地下城"
	quest.26D4AF7ADC3090C5.quest_desc: [
		"&e符文&r锻造模板会出现在宝箱、沙漠和丛林神庙中。七个刚玉和一个围绕它的鹅卵石可制作两个模板。"
		""
		"在锻造台对一个附魔物品使用一个，可以改变其光泽的颜色。纯粹为了美观。"
	]
	quest.26D4AF7ADC3090C5.quest_subtitle: "用你自己的方式让它闪耀起来吧"
	quest.26D4AF7ADC3090C5.title: "彩色符文"
	quest.26D7A62028DD1CE0.quest_desc: [
		"在重症监护室不能徒手喝水。请使用玻璃瓶来装水。"
		""
		"&6注意：&r流动的水比静止的水干净一级，Y 坐标高于 100 或低于 48 的水也更干净。"
	]
	quest.26D7A62028DD1CE0.quest_subtitle: "双手可不行"
	quest.26D7A62028DD1CE0.title: "装瓶行动"
	quest.26E9AAB1C69E21A3.quest_desc: [
		"将单元格放入&e单元格工作台&r以设置过滤器（分区）或添加升级卡。"
		""
		"过滤槽只会接受你指定的物品。"
	]
	quest.26E9AAB1C69E21A3.quest_subtitle: "调整你的细胞结构"
	quest.26E9AAB1C69E21A3.title: "细胞工作台"
	quest.26EB2F7C5CA387DB.quest_desc: [
		"利维坦会掉落&eTidal Claws&r。右键可钩索，左键可用触手抽打。"
	]
	quest.26EB2F7C5CA387DB.quest_subtitle: "一个抓钩！"
	quest.26EB2F7C5CA387DB.title: "潮汐之爪"
	quest.26FA8A9E53E05A7D.quest_desc: [
		"用四个黑曜石和一个末影珍珠可以制作一个&e基础物品收集器&r。把它放在箱子或其他物品栏旁边。它会捡起附近的掉落物并直接放入其中。在它的界面上设置范围（最多5格）。"
		""
		"&e高级物品收集器&r（基础收集器、末影之眼和玄武岩）最多可收集7个物品，并带有过滤器。"
		""
		"建造完成后勾选此项即可。"
	]
	quest.26FA8A9E53E05A7D.quest_subtitle: "用于清洁地板的吸尘器"
	quest.26FA8A9E53E05A7D.title: "物品收集者"
	quest.26FC1DD85D1C9438.quest_desc: [
		"&eFiery Ingot&r: 九头蛇的炽热血液（或远古守卫的炽热泪珠）加铁。"
		"&eKnightmetal&r：暮色森林中哥布林骑士的盔甲碎片。"
		"&eIgnitium&r：Ignis，位于下界的燃烧竞技场。"
		"&eWitherite&r：古代工厂中的预兆者。"
		"&e下界之星&r：凋零。 &e龙之心脏&r：末影龙。"
	]
	quest.26FC1DD85D1C9438.quest_subtitle: "谁会掉落什么东西"
	quest.26FC1DD85D1C9438.title: "Boss 速查表"
	quest.271EF8AD073DEE60.quest_desc: [
		"九个晶体矩阵锭可以合成一个&e晶体矩阵&r方块。极限工作台最下面一行需要五个。"
	]
	quest.271EF8AD073DEE60.quest_subtitle: "九个锭，一个方块"
	quest.271EF8AD073DEE60.title: "水晶矩阵方块"
	quest.272A37D80C862989.quest_desc: [
		"&e阿尔法雪怪&r住在雪林的山洞里。它的皮毛能让你在冰川上保持温暖。"
		""
		"击败它并捡起皮毛。"
	]
	quest.272A37D80C862989.quest_subtitle: "又大又蓬松，还很生气"
	quest.272A37D80C862989.title: "阿尔法毛皮"
	quest.27699D6D3BF997FF.quest_desc: [
		"用同样的方式升级每件 Allthemodium 盔甲。"
	]
	quest.27699D6D3BF997FF.quest_subtitle: "Tier 4 的顶端"
	quest.27699D6D3BF997FF.title: "振金盔甲"
	quest.2771606DFB3A2B1A.quest_desc: [
		"需要一桶完整的&e红石酸&r：四个红石粉和一桶水，无需特定形状。"
		""
		"蓄电器可以储存电力，并从输出端释放出来。"
	]
	quest.2771606DFB3A2B1A.quest_subtitle: "用于你线路的电池组件"
	quest.2771606DFB3A2B1A.title: "LV 蓄电器"
	quest.277C9D401995D6BE.quest_desc: [
		"在海滩上捡起 &e贝壳&r。沙子、两个贝壳和一根木棍可以制作一个 &e沙堡&r。"
		""
		"既是装饰，又能保护海龟蛋免受风雨侵袭。"
	]
	quest.277C9D401995D6BE.quest_subtitle: "海边的贝壳"
	quest.277C9D401995D6BE.title: "沙堡城堡"
	quest.27863C3CBC482BB1.quest_desc: [
		"法术由&e形式&r（投射、接触、自身）、&e效果&r，以及像增幅这样的&e增强&r组成。"
		""
		"廉价入门： &e光&r需要灯笼和火把， &e触&r只需按钮。 &e伤&r需要地精髓和三把铁剑。EMI列出了每种符文的价钱。"
	]
	quest.27863C3CBC482BB1.quest_subtitle: "法术不过是句子而已"
	quest.27863C3CBC482BB1.title: "你的第一批符文铭文"
	quest.27BA16E9F0D4E0F8.quest_desc: [
		"A &eFiery Pickaxe&r smelts what it mines, and Fiery armor burns anything that hits you."
		""
		"&6注意：&r炽热锭也能用于Mekanism的高级控制电路。别全花在闪亮装备上。"
	]
	quest.27BA16E9F0D4E0F8.quest_subtitle: "自动熔炼，燃烧物品"
	quest.27BA16E9F0D4E0F8.title: "火焰工具"
	quest.27E5769EEDE7E89F.quest_desc: [
		"三款模组为陆地和海洋注入生机：&eEnvironmental&r（鹿、牦牛、挖松露的猪、锦鲤）、&eBuzzier Bees&r（蜂蜜好物）和 &eUpgrade Aquatic&r（翻车鱼、化石等）。"
		""
		"它们的食物，如鸭肉、鹿肉、鲈鱼和梭子鱼，在&eDelightful Add-ons&r章节中烹饪而成。"
	]
	quest.27E5769EEDE7E89F.quest_subtitle: "异常生物研究小组的成员们"
	quest.27E5769EEDE7E89F.title: "狂野生物"
	quest.27F0881DB9F70E6C.quest_desc: [
		"&e螺旋桨轴承&r会驱动你粘在它前面的任何东西旋转。它至少需要2个类似船帆的方块。"
		""
		"更多的帆带来更大的推力。随着高度上升，空气稀薄，推力会下降。"
	]
	quest.27F0881DB9F70E6C.quest_subtitle: "打造你自己的刀刃"
	quest.27F0881DB9F70E6C.title: "螺旋桨轴承"
	quest.280152F04BFA31F1.quest_desc: [
		"椰子蟹会掉落&e蟹钳&r。烹饪一个蟹钳得到&e蟹肉&r，再加入椰子片，即可得到一碗&e热带浓汤&r。"
	]
	quest.280152F04BFA31F1.quest_subtitle: "螃蟹和椰子"
	quest.280152F04BFA31F1.title: "热带炖菜"
	quest.282E79C8B429AF9C.quest_desc: [
		"&e硫磺洞穴&r是一个充满&e硫磺&r和&e硫磺尖刺&r的洞穴群系。四个尖刺可以合成四个硫磺。"
		""
		"小心&e强力硫磺&r：它为&c间歇泉&r提供动力。"
	]
	quest.282E79C8B429AF9C.quest_subtitle: "黄色、臭烘烘的，而且是在地下"
	quest.282E79C8B429AF9C.title: "硫磺洞穴"
	quest.288ADE959650EABF.quest_desc: [
		"这里的要塞重建后大得多。投掷一个末影之眼，跟着它去一个要塞。"
	]
	quest.288ADE959650EABF.quest_subtitle: "跟随眼睛的方向前进"
	quest.288ADE959650EABF.title: "更好的要塞模组任务书"
	quest.288FE2C99CA0F173.quest_desc: [
		"&eStorage Upgrades&r 可以增加抽屉的容量。等级分为黑曜石、铜、铁、金、绿宝石、钻石和下界合金。"
		""
		"每个抽屉都有几个升级槽，升级可以叠加。"
	]
	quest.288FE2C99CA0F173.quest_subtitle: "让它们能携带更多物品"
	quest.288FE2C99CA0F173.title: "抽屉升级组件"
	quest.28AF0F4385F12CCD.quest_desc: [
		"&eCreate Connected&r 填补了空缺。 &e6-way Gearbox&r 所有侧面都有传动轴（顶部和底部速度减半）。"
		""
		"&eParallel Gearbox&r 将旋转同步输出。"
	]
	quest.28AF0F4385F12CCD.quest_subtitle: "创建已连接的洞穴群系结构"
	quest.28AF0F4385F12CCD.title: "花式齿轮箱"
	quest.28C2786201B177DF.quest_desc: [
		"Quark 添加了新的大型石料群：在荒地沙漠中的&e碧玉&r，在沼泽海洋中的&e石灰岩&r，以及在寒冷生物群系中的&e页岩&r。"
		""
		"每种都有抛光、砖块和柱子的版本。石匠可以制作所有版本。"
	]
	quest.28C2786201B177DF.quest_subtitle: "有格调的岩石"
	quest.28C2786201B177DF.title: "新石头"
	quest.28FDB16A542289DF.quest_desc: [
		"木棍和两个铁锭可以制作一个&e抹刀&r。使用时，它会放置你快捷栏中的一个随机方块。"
		""
		"在更多槽位放置方块，使其更频繁生成。非常适合杂乱路径和天然墙壁。在ICU中它永远不会损坏。"
	]
	quest.28FDB16A542289DF.quest_subtitle: "随机，有意为之"
	quest.28FDB16A542289DF.title: "Trowel"
	quest.28FF185F0E71FA9D.quest_desc: [
		"一个 &e包装工&r 在物品栏旁边，可将物品包裹成带有地址标签的包裹。"
		""
		"包裹可以在传送带、滑槽和蛙口上运输，并在正确的位置卸载。"
	]
	quest.28FF185F0E71FA9D.quest_subtitle: "把它放进箱子里面去"
	quest.28FF185F0E71FA9D.title: "包装工"
	quest.29021A3231BDA298.quest_desc: [
		"用四个塑料块围住一个恶魂之泪。右键生物捕捉，再右键放出。"
		""
		"生物复制器稍后会用到这些。"
	]
	quest.29021A3231BDA298.quest_subtitle: "宝可梦，不过是塑料的"
	quest.29021A3231BDA298.title: "生物监禁工具"
	quest.290B16FC2A123FD5.quest_desc: [
		"&e建筑工具&r可以放置行、墙壁和表面。而&e交换工具&r则能原地交换方块。"
		""
		"小工具需要电力运行，请先为其充电。"
	]
	quest.290B16FC2A123FD5.quest_subtitle: "一次性放置一百个方块"
	quest.290B16FC2A123FD5.title: "建筑小工具"
	quest.294B7AAFD17D1208.quest_desc: [
		"八个风车叶片围绕着一个铁锭。"
		""
		"风车需要周围有开阔的空气，放置得越高，工作效率越好。"
	]
	quest.294B7AAFD17D1208.quest_subtitle: "让它随风飘扬"
	quest.294B7AAFD17D1208.title: "风车"
	quest.295373C5C00E12DA.quest_desc: [
		"绯红木和扭曲木也能造船，还有带箱子、熔炉和大型版本。"
		""
		"竹子也得到了同等待遇：&e宽竹筏&r和&e竹子熔炉筏&r。"
	]
	quest.295373C5C00E12DA.quest_subtitle: "绯红菌和扭曲菌"
	quest.295373C5C00E12DA.title: "下界木船"
	quest.297F560368CED7F2.quest_desc: [
		"钻石周围环绕着八个Mobius燃料。Klein星体持有EMC，更大的星体由更小的星体组合而成。"
	]
	quest.297F560368CED7F2.quest_subtitle: "一个 EMC 电池"
	quest.297F560368CED7F2.title: "克莱因之星"
	quest.29D78344CD52D92B.quest_desc: [
		"你爬完了整架梯子。支线章节里还有首领要击败、飞船要驾驶和工厂要自动化。"
		""
		"感谢游玩 ICU！"
	]
	quest.29D78344CD52D92B.quest_subtitle: "任何你喜欢的东西都可以"
	quest.29D78344CD52D92B.title: "现在该怎么办？"
	quest.29EA8A1E29F0ECF7.quest_desc: [
		"The &eEnergized Smelter&r cooks anything a furnace can, powered instead of fueled."
		""
		"装上速度升级，它就能甩所有熔炉几条街。"
	]
	quest.29EA8A1E29F0ECF7.quest_subtitle: "一个用电力驱动的熔炉"
	quest.29EA8A1E29F0ECF7.title: "能量熔炼炉"
	quest.29F1A820540484D8.quest_desc: [
		"将任意头盔与工程师护目镜一同合成。你将保留盔甲并获得护目镜的叠加层。"
		""
		"再也不用换帽子来检查你的机器了。"
	]
	quest.29F1A820540484D8.quest_subtitle: "能感知压力的盔甲"
	quest.29F1A820540484D8.title: "护目镜头盔"
	quest.29F5C0DBE285017A.quest_desc: [
		"Inferium Essence、骨粉和钻石可以制作&eMystical Fertilizer&r。它能立即催熟任何作物，包括资源作物。"
		""
		"资源作物（非 Inferium）也会掉落 Fertilized Essence，从而产出更多。"
	]
	quest.29F5C0DBE285017A.quest_subtitle: "能用的骨粉，终于找到了"
	quest.29F5C0DBE285017A.title: "神秘肥料"
	quest.2A05CF3A8FCA560E.quest_desc: [
		"羽毛笔、石英、红石、青金石、绿宝石和金锭可以制作出&e红石逻辑控制器&r。"
		""
		"它能读取和设置六个面的信号，并用像 &eR = G AND B&r 这样的短行编程。内置定时器、计数器和边沿检测。工具提示里有完整手册。"
	]
	quest.2A05CF3A8FCA560E.quest_subtitle: "一个小小的可编程大脑"
	quest.2A05CF3A8FCA560E.title: "红石逻辑控制系统"
	quest.2A236281CACA3F96.quest_desc: [
		"画布和线可以制作一个&e麻袋&r：九个可随身携带或放置的格子。"
		""
		"&6注意：&r携带超过两个袋子会让你&e负重过度&r。无法冲刺，而且带的越多情况越糟。"
	]
	quest.2A236281CACA3F96.quest_subtitle: "便携，但很重"
	quest.2A236281CACA3F96.title: "袋子"
	quest.2A4656DF2BB35FEC.quest_desc: [
		"&e物品筒仓&r是一个垂直的物品存储库。而&e流体容器&r则是一个水平的流体储罐。"
		""
		"随时可以将其中一个合成回普通版本。"
	]
	quest.2A4656DF2BB35FEC.quest_subtitle: "储物箱，侧向放置"
	quest.2A4656DF2BB35FEC.title: "筒仓与容器"
	quest.2A55A2AA2DEE357C.quest_desc: [
		"ICU的世界充满了新地方。 &eBiomes O' Plenty&r 为地表世界、下界和末地添加了69个生物群系，而 &eEcologics&r 则让海滩、平原、沙漠、雪地和华丽洞穴更加生动。"
		""
		"&6注意：&rICU 中已启用所有 Biomes O' Plenty 的生物群。使用 &eNature's Compass&r（见 Explorer's Toolkit）可按名称查找它们。"
	]
	quest.2A55A2AA2DEE357C.quest_subtitle: "世界变得大得多了"
	quest.2A55A2AA2DEE357C.title: "Go Outside"
	quest.2A5CC5A3FB622206.quest_desc: [
		"铁质箱子周围的黄金锭可以制作一个&e黄金箱子&r。钻石和玻璃可以制作一个&e钻石箱子&r。"
		""
		"钻石箱子有 108 个格子：相当于两个完整的半开式箱子。"
	]
	quest.2A5CC5A3FB622206.quest_subtitle: "真正的储物空间现已上线"
	quest.2A5CC5A3FB622206.title: "黄金和钻石宝箱"
	quest.2A7EF7C35500AF98.quest_desc: [
		"有些白橡树干里藏着&e嘎吱作响的心脏&r。夜晚，它会唤醒&c嘎吱怪&r来守护。"
		""
		"用&e丝绸之触&r挖掘心脏带回家。没有丝绸之触，它会碎成1-3个&e树脂块&r。"
	]
	quest.2A7EF7C35500AF98.quest_subtitle: "树上住着什么东西"
	quest.2A7EF7C35500AF98.title: "吱吱作响的心脏"
	quest.2AAD0118283D1286.quest_desc: [
		"&eWarp Plates&r 需要成对使用。将 &eDormant Shard&r（warp dust 和 flint）放入其中一块以校准，然后将该碎片带到第二块板上。"
		""
		"站在任意一个踏板上即可跳跃过去。免费，而且对生物也有效。"
	]
	quest.2AAD0118283D1286.quest_subtitle: "踩上去，然后跳出来"
	quest.2AAD0118283D1286.title: "传送石板"
	quest.2B19215FEC5B1F73.quest_desc: [
		"农场和机器只有在其区块加载时才能工作。走得太远它们就会停止。"
		""
		"&e区块加载器&r：放置一个，右键点击它，然后点击其地图上的区块以启用它们。"
		"&eFTB Chunks&r：在物品栏的地图按钮中打开&eClaim Manager&r。拖动以认领区块，Shift+拖动以强制加载那些你离开时仍需运行的区块。"
		""
		"农场动物、村民和铁傀儡在加载区块中会持续移动。敌对生物农场必须位于已加载或已占用的区块中，否则一旦你离开超过四个区块，它们就会冻结。"
	]
	quest.2B19215FEC5B1F73.quest_subtitle: "虽然看不见，但仍在继续工作"
	quest.2B19215FEC5B1F73.title: "保持农场持续运转"
	quest.2B29942BD8272227.quest_desc: [
		"在&e秘法核心&r上建造一个&e附魔装置&r，周围3格内要有秘法基座。"
		""
		"加载基座，然后用中心物品右键该装置。从这里开始的大多数 Ars 都是这样制作的。"
	]
	quest.2B29942BD8272227.quest_subtitle: "Ars 的主要合成台"
	quest.2B29942BD8272227.title: "附魔装置 Enchanting Apparatus"
	quest.2B30C5035E254F3E.quest_desc: [
		"&e柴油发电机&r燃烧生物柴油，提供强大而稳定的电力。"
		""
		"它的发电机方块需要MV线圈，散热器需要康斯坦坦。农场、榨汁机、发酵器和精炼器能永远为其提供燃料。"
	]
	quest.2B30C5035E254F3E.quest_subtitle: "真正的力量，终于到手了"
	quest.2B30C5035E254F3E.title: "柴油发电机"
	quest.2B380DECF12F7949.quest_desc: [
		"八个铁锭围成一圈可制作24个&e铁板&r。 &e带框玻璃&r是带铁角的玻璃，每个需要八个。"
		""
		"&e金锭&r和&e格栅&r让外观更完整。被驯服的动物无法走在格栅上，物品会穿过它掉落。"
	]
	quest.2B380DECF12F7949.quest_subtitle: "工厂风潮"
	quest.2B380DECF12F7949.title: "玻璃板和带框玻璃"
	quest.2B53E358F15C74F8.quest_desc: [
		"传送需要消耗 &eXP 等级&r。消耗随距离增加，前往其他维度的消耗最高。"
		""
		"前往&e全球&r传送石和从传送板出发的旅行是免费的。"
	]
	quest.2B53E358F15C74F8.quest_subtitle: "经验值，不是魔法"
	quest.2B53E358F15C74F8.title: "旅行的代价"
	quest.2B5AD4515B6B1893.quest_desc: [
		"九个工作台可以合成一个&e压缩工作台&r，而九个压缩工作台可以合成一个&e双层压缩&r工作台。"
		""
		"每张大型 Avaritia 桌子都始于这些。"
	]
	quest.2B5AD4515B6B1893.quest_subtitle: "九个表格合为一"
	quest.2B5AD4515B6B1893.title: "压缩合成台 (Compressed Crafting Tables)"
	quest.2B7BC86810242568.quest_desc: [
		"长袍有三个等级，在装置上升级："
		"Tier 2 需要两根烈焰棒和 2500 Source。Tier 3 需要两颗末影珍珠、一个紫颂果和 5000 Source。"
		""
		"每个等级都会增加法力再生和更大的线程槽位。"
	]
	quest.2B7BC86810242568.quest_subtitle: "更多槽位，更多再生"
	quest.2B7BC86810242568.title: "护甲等级"
	quest.2BF18C54B8E2BBDA.quest_desc: [
		"&e黄铜漏斗&r和&e黄铜隧道&r有过滤槽。一个&e智能滑道&r会过滤掉通过它的掉落物。"
		""
		"将物品放入过滤槽中，以仅允许该物品通过。"
	]
	quest.2BF18C54B8E2BBDA.quest_subtitle: "到处都是过滤器 Filters everywhere"
	quest.2BF18C54B8E2BBDA.title: "智能物流系统 (Smart Logistics)"
	quest.2BFD45764BFAAB46.quest_desc: [
		"将可压制的植物碎片（查看 EMI）与水混合制成 &ePulp&r，然后将其压制为 &eCardboard&r。"
		""
		"你需要一个用于包裹网络的堆栈。"
	]
	quest.2BFD45764BFAAB46.quest_subtitle: "包装材料"
	quest.2BFD45764BFAAB46.title: "纸板箱"
	quest.2C020D2F1CEB5BBA.quest_desc: [
		"Agradditions 添加了 &e精粹煤炭&r（煤炭加两种精粹，燃烧更久）、精粹苹果和 &e帕塞尔&r。"
		""
		"Paxel 是一种由相同品级的斧头、镐头和铲子组合而成的工具。"
	]
	quest.2C020D2F1CEB5BBA.quest_subtitle: "一些小额外内容"
	quest.2C020D2F1CEB5BBA.title: "神秘农业扩展模组"
	quest.2C2E1C3E4310EE4C.quest_desc: [
		"Mowzie's Cataclysm 也为 Mowzie 的结构添加了守卫之眼："
		"&e锻造之眼&r（锻造密室）、&e霜冻之眼&r（霜冻巨口）、&e太阳鸟之眼&r（乌姆武塔纳林）和&e雕塑家之眼&r（雕塑家修道院）。"
		""
		"投掷一个，然后跟随着它。"
	]
	quest.2C2E1C3E4310EE4C.quest_subtitle: "找到巢穴所在的地方"
	quest.2C2E1C3E4310EE4C.title: "Mowzie's Eyes"
	quest.2C2E6D6BD9C599C8.quest_desc: [
		"钻石、绿宝石和下界合金种子属于Supremium等级，所以需要像精华一样等待Vibranium。"
		""
		"将它们放在 Supremium 农田上，下面垫一叠加速器，尽情享受吧。"
	]
	quest.2C2E6D6BD9C599C8.quest_subtitle: "茎上的钻石"
	quest.2C2E6D6BD9C599C8.title: "珍贵作物"
	quest.2C3F2C7D9C086818.quest_desc: [
		"用黄铜锭右键去皮的原木，制作&e黄铜外壳&r。"
		""
		"&6注意：&r在ICU中，Mekanism的&e钢制外壳&r需要黄铜外壳。多做一些。"
	]
	quest.2C3F2C7D9C086818.quest_subtitle: "Create 的二级阶段"
	quest.2C3F2C7D9C086818.title: "黄铜外壳"
	quest.2C4F871845EDA9F2.quest_desc: [
		"ICU的配方需要在中间放置一个Create &e黄铜外壳&r。大多数Mekanism机器都以此为基础建造。"
	]
	quest.2C4F871845EDA9F2.quest_subtitle: "几乎所有机器都从这里开始"
	quest.2C4F871845EDA9F2.title: "钢制外壳"
	quest.2C7F1C8C4B1BAF06.quest_desc: [
		"九头蛇生活在火焰沼泽。火焰抗性药水是你的最佳伙伴。"
	]
	quest.2C7F1C8C4B1BAF06.quest_subtitle: "三个头颅，毫无乐趣可言"
	quest.2C7F1C8C4B1BAF06.title: "九头蛇（The Hydra）"
	quest.2C90098A21FD8EAD.quest_desc: [
		"粉碎 &e末地石&r 可获得 &e末地石粉末&r。它是悬浮水晶 Levitite 的基础。"
		""
		"带回几组末地石。你需要很多。"
	]
	quest.2C90098A21FD8EAD.quest_subtitle: "一次前往末地的旅行"
	quest.2C90098A21FD8EAD.title: "末地石粉末"
	quest.2CAC461409CC22AD.quest_desc: [
		"放入一个装满的 Mob Imprisonment Tool 并喂食 Essence。它会生成该生物的副本。"
		""
		"搭配 Mob Crusher 使用，打造完整的刷怪农场。"
	]
	quest.2CAC461409CC22AD.quest_subtitle: "复制并粘贴"
	quest.2CAC461409CC22AD.title: "生物复制器"
	quest.2CB31CBD379BF0B8.quest_desc: [
		"Chest &eupgrade items&r 将放置的箱子升级为下一阶段，并保留箱内所有物品。"
		""
		"潜行并右键点击带有升级的箱子。比手动移动100组物品容易多了。"
	]
	quest.2CB31CBD379BF0B8.quest_subtitle: "无需解压"
	quest.2CB31CBD379BF0B8.title: "原地升级"
	quest.2CD83ACD19D8B277.quest_desc: [
		"八个金锭环绕一个铁质背包。更多空间，更多升级槽位。"
	]
	quest.2CD83ACD19D8B277.quest_subtitle: "闪闪发光，宽敞明亮"
	quest.2CD83ACD19D8B277.title: "黄金背包"
	quest.2CE62D5E7EC0D085.quest_desc: [
		"Deserts and badlands now have &eDry Grass&r, and cacti can grow &eCactus Flowers&r."
		""
		"仙人掌花可以制作&d粉色染料&r。"
	]
	quest.2CE62D5E7EC0D085.quest_subtitle: "在干旱之地生活"
	quest.2CE62D5E7EC0D085.title: "沙漠之花"
	quest.2CFC8A4061706950.quest_desc: [
		"&eDigital Miner&r 会在一个大范围内，精准挖掘你筛选的方块，而不会破坏地形。"
		""
		"给它足够的动力和放置挖掘物的地方。需要一台 Robit、一台 Sorter 和两个 Teleportation Core。"
	]
	quest.2CFC8A4061706950.quest_subtitle: "睡觉时挖矿，效率翻倍"
	quest.2CFC8A4061706950.title: "数字矿工"
	quest.2D1691EF891C9F51.quest_desc: [
		"一个 &e反应堆核心&r、四个 &e反应堆稳定器&r 和一个 &e反应堆能量注入器&r，全部通过融合合成。"
		"它能燃烧觉醒的德拉科尼乌姆，并产生惊人的能量。"
		""
		"&6注意：&r运行不当的核反应堆会爆炸。请远离家园建造，并先学习屏幕界面。"
	]
	quest.2D1691EF891C9F51.quest_subtitle: "无限的力量，有限的耐心"
	quest.2D1691EF891C9F51.title: "龙之反应堆"
	quest.2D31851F053DCA94.quest_desc: [
		"消灭所有种类的腐化生物：腐化幼体、腐化行者、腐化巨兽和腐化喷吐者。"
	]
	quest.2D31851F053DCA94.quest_subtitle: "All of the rot"
	quest.2D31851F053DCA94.title: "Rotbane"
	quest.2D63A30DEC19B034.quest_desc: [
		"将唱片放入&eJukebox Upgrade&r中，你的背包就会在你所到之处播放它们。"
		""
		"纯粹的乐趣。毫无羞耻。"
	]
	quest.2D63A30DEC19B034.quest_subtitle: "适合挖矿的音乐，由你谱写"
	quest.2D63A30DEC19B034.title: "唱片机升级"
	quest.2D665B8035BB1E9A.quest_desc: [
		"需要寻找的花朵：田野里的&e野花&r、草原上的&e金盏花&r、热带地区的&e粉红花鹤桐&r，以及枫树林和沼泽地的&e紫罗兰&r。"
		""
		"它们每一个都可以制作成染料。"
	]
	quest.2D665B8035BB1E9A.quest_subtitle: "挑选一束花束"
	quest.2D665B8035BB1E9A.title: "花的力量"
	quest.2D752AD64BB26D28.quest_desc: [
		"Immersive Energistics 使用 Immersive Engineering 风格的电线来运行你的网络。"
		""
		"四个Fluix块和三个Fluix晶体可制作四个&eME连接器&r。将一个连接器放置在ME线缆或设备旁，然后用&eME线圈&r（Fluix玻璃线缆包裹木棍）连接两个连接器。一根线缆可跨越16格，并传输8个频道，与普通线缆相同。"
	]
	quest.2D752AD64BB26D28.quest_subtitle: "沉浸式能源学 (Immersive Energistics)"
	quest.2D752AD64BB26D28.title: "ME on a Wire"
	quest.2D9E25C0443648AD.quest_desc: [
		"拾取升级加上末影珍珠、铁、红石和青金石可以制作一个&e磁铁升级&r。"
		"It pulls in items (and XP orbs) from a few blocks away. Set a filter so it skips the junk."
	]
	quest.2D9E25C0443648AD.quest_subtitle: "快过来，这里有战利品等你领取"
	quest.2D9E25C0443648AD.title: "磁石升级"
	quest.2DB5C310B7AF1DBD.quest_desc: [
		"从一个&e金片&r开始。三个部署器分别添加齿轮、大齿轮和铁粒，整个序列重复五次。"
		""
		"循环传送带上三个部署器可自动操作。飞机在重症监护室需要这些。"
	]
	quest.2DB5C310B7AF1DBD.quest_subtitle: "顺序组装"
	quest.2DB5C310B7AF1DBD.title: "精密机械装置"
	quest.2DD4FC1AF9F5737E.quest_desc: [
		"Umvuthana 迅猛龙会掉落面具。佩戴每个面具都能获得增益效果，例如力量或速度。"
	]
	quest.2DD4FC1AF9F5737E.quest_subtitle: "Umvuthana面具"
	quest.2DD4FC1AF9F5737E.title: "假面舞会"
	quest.2DE9955B1F03C00C.quest_desc: [
		"使用像&e铜制升级台&r这样的物品，可以将已放置的发电机直接升级，无需重新制作。"
	]
	quest.2DE9955B1F03C00C.quest_subtitle: "不需要破坏它"
	quest.2DE9955B1F03C00C.title: "升级套件"
	quest.2DEAFA9D0422C173.quest_desc: [
		"Wilden roam forests at night. &eHunters&r drop horns, &eStalkers&r drop wings, and &eDefenders&r (cold biomes only) drop spikes."
		""
		"角可以驯服干戈米，翅膀可以制作空气精华，三者可以召唤奇美拉。"
	]
	quest.2DEAFA9D0422C173.quest_subtitle: "角、翅膀和尖刺"
	quest.2DEAFA9D0422C173.title: "狂野狩猎"
	quest.2DFC243EE96EBCE0.quest_desc: [
		"String、兔皮、木棍和史莱姆球可以制作一个&e弹弓&r。拉弓一秒，它就能发射物品而不是箭。"
		""
		"方块会像放置的方块一样落下，这样你就可以把它们放在够不到的地方。"
	]
	quest.2DFC243EE96EBCE0.quest_subtitle: "投掷物品"
	quest.2DFC243EE96EBCE0.title: "弹弓"
	quest.2E35CCF3A6CA2658.quest_desc: [
		"工厂、4x 和 5x 矿石加工、涡轮机和反应堆都位于 Tech 章节的 &eMekanism&r 中。"
		""
		"精英和终极部件等待下一个等级解锁。"
	]
	quest.2E35CCF3A6CA2658.quest_subtitle: "Tier 2 仅仅是个开始"
	quest.2E35CCF3A6CA2658.title: "还有更多的机械动力内容等待着你"
	quest.2E3DF788E76DC4C5.quest_desc: [
		"&e幻术师&r出没于泰加林，藏身于小屋和训练场。它们用自身的复制品充斥空气。"
		""
		"找到真正的那个。它会掉落一个&eTotem of Illusion&r。"
	]
	quest.2E3DF788E76DC4C5.quest_subtitle: "幻象师"
	quest.2E3DF788E76DC4C5.title: "World of Illusion"
	quest.2E64FE14161AB734.quest_desc: [
		"鹅卵石、煤炭、一颗钻石和一个金锭。 &eFurnace Pet&r 会熔炼你快捷栏中第一个可熔炼的物品。"
	]
	quest.2E64FE14161AB734.quest_subtitle: "移动中烹饪，随时随地享受美味"
	quest.2E64FE14161AB734.title: "熔炉宠物"
	quest.2E7A3DE25B49D825.quest_desc: [
		"&eEyeblossoms&r 生长在苍白花园中，无论开闭状态。"
		""
		"打开的会制作&6橙色染料&r，关闭的会制作&7灰色染料&r。"
	]
	quest.2E7A3DE25B49D825.quest_subtitle: "注视你的花朵"
	quest.2E7A3DE25B49D825.title: "眼花（Eyeblossoms）"
	quest.2E8F75BF85686E1F.quest_desc: [
		"&e生物反应器&r将作物和树苗转化为&e生物燃料&r。而&e生物燃料发电机&r则燃烧它来提供动力。"
		""
		"把它连接到你的植物收集器上，它就会自动运行了。"
	]
	quest.2E8F75BF85686E1F.quest_subtitle: "堆肥，不过是辣味的堆肥"
	quest.2E8F75BF85686E1F.title: "生物燃料"
	quest.2EC41EA63621F1FB.quest_desc: [
		"锅中：米饭、洋葱、棕色蘑菇、土豆、浆果和蔬菜，容器为&e南瓜&r。"
	]
	quest.2EC41EA63621F1FB.quest_subtitle: "在自身的壳中烹制而成"
	quest.2EC41EA63621F1FB.title: "填充南瓜"
	quest.2ED9FAB0D97B93EC.quest_desc: [
		"MFFS 几乎用 &eFocus Matrices&r（钢、红石、一颗钻石）和 &eBatteries&r 建造一切。"
	]
	quest.2ED9FAB0D97B93EC.quest_subtitle: "力场，第一步"
	quest.2ED9FAB0D97B93EC.title: "聚焦矩阵"
	quest.2EEC80DF90EFBFCF.quest_desc: [
		"用铁块切割出&eLocometal&r，并为你的引擎装上&eSmokestack&r。"
		""
		"用染料点击烟囱可改变烟雾颜色，或用灵魂沙可产生灵魂烟雾。"
	]
	quest.2EEC80DF90EFBFCF.quest_subtitle: "硝烟与钢铁"
	quest.2EEC80DF90EFBFCF.title: "机车风格"
	quest.2EEE2A7BDE6B2128.quest_desc: [
		"能量立方升级配方：高级需要浸渍合金，精英需要强化合金。"
		""
		"这里没有受限制电路，只有合金，所以想什么时候扩建仓库就什么时候扩建。"
	]
	quest.2EEE2A7BDE6B2128.quest_subtitle: "更多空间，更强动力"
	quest.2EEE2A7BDE6B2128.title: "更大的电池 (Bigger Batteries)"
	quest.2F361D7C90EC2ADB.quest_desc: [
		"硬化部件需要&e硬化电容器&r，用充能钢制作。暂时不需要稀有金属。"
	]
	quest.2F361D7C90EC2ADB.quest_subtitle: "更坚固，更庞大"
	quest.2F361D7C90EC2ADB.title: "硬化等级（Hardened Tier）"
	quest.2F676AAB1B939FB9.quest_desc: [
		"ICU的配方底部需要放置一个Create &e安山岩外壳&r。不确定时请检查EMI。"
		""
		"Infuser 可以制作合金、电路和钢。"
	]
	quest.2F676AAB1B939FB9.quest_subtitle: "早期机械动力模组的核心所在"
	quest.2F676AAB1B939FB9.title: "冶金学注入器"
	quest.2F7059F15949E1E7.quest_desc: [
		"锇矿石在地下很常见。熔炼一堆吧。"
	]
	quest.2F7059F15949E1E7.quest_subtitle: "Mekanism 靠它运行"
	quest.2F7059F15949E1E7.title: "锇（Osmium）"
	quest.2F738C5C7DAEF958.quest_desc: [
		"&eSolid Access Port&r 会吸入燃料并排出废料。而 &eActive Power Tap&r 会将电力输送到线缆中。"
	]
	quest.2F738C5C7DAEF958.quest_subtitle: "进进出出"
	quest.2F738C5C7DAEF958.title: "访问端口和电源接口"
	quest.2F77D386DE8211AB.quest_desc: [
		"&eMEGA 批量存储单元&r可存放任意数量的单一物品。非常适合存放原石或矿石粉尘。"
		""
		"加入一张&e压缩卡&r，它会把原矿、锭和方块折叠起来。"
	]
	quest.2F77D386DE8211AB.quest_subtitle: "一个物品，无数量限制"
	quest.2F77D386DE8211AB.title: "批量存储单元"
	quest.2F9BE0FD63D47F2D.quest_desc: [
		"&e核桃&r树现在生长在平原上，它们的叶子会掉落&e核桃&r。"
		""
		"&e松鼠&r也住在那里。拿出一个核桃，它们就会跟着你转了。"
	]
	quest.2F9BE0FD63D47F2D.quest_subtitle: "平原上的核桃树种子"
	quest.2F9BE0FD63D47F2D.title: "松鼠的食物"
	quest.301FEA78C563D5E2.quest_desc: [
		"&e轻型工程&r：铁板、铁制组件和铜。"
		"&e重型工程&r：钢板、钢制组件和电金。"
		""
		"多区块结构开始后，你两种都需要成堆的。"
	]
	quest.301FEA78C563D5E2.quest_subtitle: "每台机器的内部构造都至关重要"
	quest.301FEA78C563D5E2.title: "工程方块"
	quest.3037BEAE28C265EE.quest_desc: [
		"三个熟羊肉、两个烤土豆、两个洋葱、牛奶和一个碗。"
	]
	quest.3037BEAE28C265EE.quest_subtitle: "羊肉和土豆泥"
	quest.3037BEAE28C265EE.title: "牧羊人派"
	quest.304A15483DD2FD58.quest_desc: [
		"&eCore Sample Drill&r会向下钻探，并告诉你该区块中存在的矿物沉积物。"
		""
		"拿走它吐出的核心样本；那是挖掘机的地图笔记。"
	]
	quest.304A15483DD2FD58.quest_subtitle: "你的脚下有什么东西呢？"
	quest.304A15483DD2FD58.title: "矿物勘探任务书"
	quest.306B2B1BCDF24D0B.quest_desc: [
		"&e狗粮&r（在罐子里）能治愈和增益驯服的狼。 &e马饲料&r对马有同样的效果。"
		""
		"右键点击你的宠物来喂食它们。"
	]
	quest.306B2B1BCDF24D0B.quest_subtitle: "好孩子！"
	quest.306B2B1BCDF24D0B.title: "给朋友们的零食"
	quest.306D230DFB484BD0.quest_desc: [
		"回到巨魔洞穴，宝库中放着&e余烬之灯&r。它能燃尽守护最终高地的荆棘。"
	]
	quest.306D230DFB484BD0.quest_subtitle: "将荆棘点燃，使其燃烧殆尽"
	quest.306D230DFB484BD0.title: "余烬之灯"
	quest.30799A0E3F7B0F05.quest_desc: [
		"一个末地存储箱 &e末地箱&r 会与其他拥有相同三种颜色的箱子共享物品栏。"
		""
		"右键点击顶部的彩色条纹并设置代码。代码相同的两个箱子即为同一个箱子。"
	]
	quest.30799A0E3F7B0F05.quest_subtitle: "同一个箱子，两个地方"
	quest.30799A0E3F7B0F05.title: "末影箱（彩色！）"
	quest.3079B76D09CE6F1D.quest_desc: [
		"牛、猪和鸡现在有&e暖&r和&b冷&r两种变种，具体取决于生物群系。"
		""
		"温鸡下&6褐蛋&r，冷鸡下&b蓝蛋&r。在ICU中，两者在所有鸡蛋配方中均可使用，包括蛋糕和南瓜派，并可烹饪成农夫之乐&e煎蛋&r。"
	]
	quest.3079B76D09CE6F1D.quest_subtitle: "温热的鸡和冰冷的鸡"
	quest.3079B76D09CE6F1D.title: "彩色鸡蛋"
	quest.3086632FD75F57B4.quest_desc: [
		"萤石、一个&e黄铜外壳&r、一个钻石块和一个熔炉。给它天空和光，它就会慢慢产生 EMC。"
		""
		"Put fuel inside and it'll upgrade it for you over time."
	]
	quest.3086632FD75F57B4.quest_subtitle: "来自阳光的 EMC 能量"
	quest.3086632FD75F57B4.title: "能量收集器"
	quest.309D0C3E585FB877.quest_desc: [
		"海带、三文鱼和鳕鱼卷（米饭加鱼或海带）可以组合成一份&e米饭卷拼盘&r。"
	]
	quest.309D0C3E585FB877.quest_subtitle: "寿司派对"
	quest.309D0C3E585FB877.title: "米浆混合曲奇"
	quest.30BD81197102022D.quest_desc: [
		"Collector MK2 将暗物质添加到 MK1 中，MK3 将红物质添加到 MK2 中。"
	]
	quest.30BD81197102022D.quest_subtitle: "每刻获得更多 EMC 能量"
	quest.30BD81197102022D.title: "更好的收藏家模组 (Better Collectors)"
	quest.30BFFF003355B7FE.quest_desc: [
		"改用&e灵魂之火&r（灵魂火把或灵魂篝火）点燃 Levitite 混合物，它就会结晶成&ePearlescent Levitite&r。"
	]
	quest.30BFFF003355B7FE.quest_subtitle: "现在是粉色的了"
	quest.30BFFF003355B7FE.title: "珍珠浮空石"
	quest.30F4CFD53D513F59.quest_desc: [
		"用 Inferium 锭和宝石升级钻石镐。每个等级都基于上一个等级。"
		""
		"精粹装备有一个增幅槽。盔甲的工作原理相同。"
	]
	quest.30F4CFD53D513F59.quest_subtitle: "钻石工具，但更强大"
	quest.30F4CFD53D513F59.title: "精粹装备"
	quest.31015ABE9AD5B02E.quest_desc: [
		"机器运行需要FE。这个&ePitiful Generator&r能燃烧熔炉能烧的一切东西。"
		""
		"任何FE来源都行：Powah、IE电线，你有的什么都行。"
	]
	quest.31015ABE9AD5B02E.quest_subtitle: "卑微的开端"
	quest.31015ABE9AD5B02E.title: "可怜的发电机"
	quest.312EF3F2C418D0CE.quest_desc: [
		"将铁质熔炉升级为：&e速度&r熔炼更快，&e工厂&r可同时处理多组物品，以及&e发电机&r将其变为发电机。"
	]
	quest.312EF3F2C418D0CE.quest_subtitle: "调整你的熔炉设置"
	quest.312EF3F2C418D0CE.title: "熔炉增强组件"
	quest.3168069BC580EB61.quest_desc: [
		"每个方块都有重量。ICU 为许多模组方块添加了重量数据，因此重型机器和金属方块会比木头或羊毛重得多。"
		""
		"制作一个&e机械装置图纸&r（纸张加物理组装器），然后在你的飞船上右键点击它。它会显示质量、质心以及所有作用力。"
		""
		"失去连接的部件会脱离，成为独立的装置。用&e史莱姆球&r可以将它们合并。在末地，船只没有重量，所以上去时要小心飞行。"
	]
	quest.3168069BC580EB61.quest_subtitle: "沉重的方块，沉重的船只"
	quest.3168069BC580EB61.title: "重量很重要"
	quest.31772C8ED6551CC8.quest_desc: [
		"一把原版战锤、一个&eAllthemodium 方块&r和模板。因为有时候你想砸东西。"
	]
	quest.31772C8ED6551CC8.quest_subtitle: "重量级打击手"
	quest.31772C8ED6551CC8.title: "Allthemodium 战锤"
	quest.317943411781C22D.quest_desc: [
		"八个红石和一个羽毛可以制作一个&e红石羽毛笔&r。它可以在地板、墙壁和天花板上画出细的红石轨道。右键绘制，左键擦除。"
		""
		"轨道不会为其所在的方块供电。点击轨道中心可添加连接器。潜行并查看方块以显示其信号强度。"
	]
	quest.317943411781C22D.quest_subtitle: "笔的小弟弟/小妹妹"
	quest.317943411781C22D.title: "红石羽毛笔"
	quest.31960B57A60A6430.quest_desc: [
		"建造一个&eInfusion Altar&r和八个&eInfusion Pedestals&r（石头、红色羊毛、黄金）。先放置祭坛，它会显示基座的放置位置。"
		""
		"再制作一把&e魔杖&r。用它右键祭坛（或用红石激活）即可开始配方。"
	]
	quest.31960B57A60A6430.quest_subtitle: "种子生成器"
	quest.31960B57A60A6430.title: "灌注祭坛"
	quest.31A9175BE6C50C06.quest_desc: [
		"The &eDrawer Key&r locks a drawer to its item, so it keeps its slot even when empty."
		"其他键会隐藏标签或显示确切数量。请在EMI中查看完整列表。"
	]
	quest.31A9175BE6C50C06.quest_subtitle: "将其锁定住，确保万无一失"
	quest.31A9175BE6C50C06.title: "技巧和窍门"
	quest.31B70F8232A7C088.quest_desc: [
		"木板、羊毛、一个靠垫和一张床单可以制作一张&e豪华床&r。"
		""
		"想换的时候，把枕头换成靠垫，把床单换成床单就好。"
	]
	quest.31B70F8232A7C088.quest_subtitle: "做个好梦"
	quest.31B70F8232A7C088.title: "豪华床铺"
	quest.32407E4387541C58.quest_desc: [
		"将 Creaking Heart 放置在两个 &ePale Oak Logs&r 之间，方向与心脏一致。"
	]
	quest.32407E4387541C58.quest_subtitle: "给它一个新家吧"
	quest.32407E4387541C58.title: "心脏移植机 Heart Transplanter"
	quest.32526D10A8F884CC.quest_desc: [
		"&eGimbal Sensor&r会在下坡方向输出信号，非常适合自动调平。"
		"&e光学传感器&r会发射光束，报告前方方块的距离。可用于降落或防碰撞。"
	]
	quest.32526D10A8F884CC.quest_subtitle: "平衡与双眼"
	quest.32526D10A8F884CC.title: "万向支架和光学传感器"
	quest.32C302C45F26B0EF.quest_desc: [
		"...在末地使用传送台时，它会做出不同的反应。"
	]
	quest.32C302C45F26B0EF.quest_subtitle: "传闻说……"
	quest.32C302C45F26B0EF.title: "另一个（The Other）"
	quest.32F3B5D8CB4780D8.quest_desc: [
		"涡轮机是一个外壳，一面有&e转子轴承&r，一排&e转子轴&r，以及围绕轴线的&e转子叶片&r。"
		""
		"在竖井末端环绕放置线圈方块即可产生电力。检查方块的进阶工具提示（F3+H）以确认是否为有效线圈。"
	]
	quest.32F3B5D8CB4780D8.quest_subtitle: "蒸汽转化为动力"
	quest.32F3B5D8CB4780D8.title: "涡轮机零件"
	quest.330ED762856A6476.quest_desc: [
		"&e棕榈树&r遍布热带地区和葱郁沙漠。 &e桃花心木&r生长在雨林和岩石雨林中。"
		""
		"带上轻便的行李，外面天气很暖和。"
	]
	quest.330ED762856A6476.quest_subtitle: "棕榈和桃花心木"
	quest.330ED762856A6476.title: "热带木材"
	quest.338C85ED2AC18D39.quest_desc: [
		"将蜜块熔炼成&e结晶蜂蜜&r。一根末地柱、一瓶蜂蜜和一个金粒可以制作一个&e蜂蜜灯&r。"
		""
		"如果潜行兽抓住了你，&e蜜苹果&r可以治愈你的漂浮状态。"
	]
	quest.338C85ED2AC18D39.quest_subtitle: "Buzzier Bees 装饰物"
	quest.338C85ED2AC18D39.title: "Sweet Lighting"
	quest.33A2E74B980F807D.quest_desc: [
		"一个工作台、一个铁块、基础组件、基础催化剂和一个黑铁板。"
		""
		"扩展工作台在关闭时会保留物品。它们会成长为 5x5、7x7 和 9x9：每个都由低一级的材料制成。"
	]
	quest.33A2E74B980F807D.quest_subtitle: "3x3，但它会保留里面的物品"
	quest.33A2E74B980F807D.title: "基础合成台"
	quest.33C94C242EE446A8.quest_desc: [
		"熔炼你的原始 Allthemodium。这种金属能开启大部分 Tier 3 内容。"
	]
	quest.33C94C242EE446A8.quest_subtitle: "通往第三级的黄色钥匙"
	quest.33C94C242EE446A8.title: "Allthemodium 锭"
	quest.33E48E30793D3ED8.quest_desc: [
		"一个大型机械合成配方，里面有一个完整的&e双翼飞机&r，还有铜外壳和工业铁窗。"
		""
		"三个座位和浮筒，这样就能安全地在水上着陆了。"
	]
	quest.33E48E30793D3ED8.quest_subtitle: "降落在水上"
	quest.33E48E30793D3ED8.title: "竹子漏斗"
	quest.3401B02BA5DF53F5.quest_desc: [
		"&eRefill&r 用背包里的物品（火把、方块）补充你手中的物品。"
		"&e工具交换器&r会为你正在挖掘的东西从背包里挑选出最佳工具。"
	]
	quest.3401B02BA5DF53F5.quest_subtitle: "合适的工具，每次都用得上"
	quest.3401B02BA5DF53F5.title: "物品补充与工具交换器"
	quest.3416F20AB57FA1E0.quest_desc: [
		"&e返回卷轴&r会将你送回出生点。 &e传送卷轴&r会打开一次路标菜单。"
		"在传送石上使用&e空白卷轴&r，制作一个能带你直达那里的&e绑定卷轴&r。"
	]
	quest.3416F20AB57FA1E0.quest_subtitle: "一次性使用的门票"
	quest.3416F20AB57FA1E0.title: "卷轴"
	quest.3447698DEE3EAE8B.quest_desc: [
		"早点铺床。这样就能跳过夜晚，并设置重生点。"
		""
		"任何颜色都可以，任务只是要求一个白色的。"
	]
	quest.3447698DEE3EAE8B.quest_subtitle: "跳过夜晚，设置你的出生点"
	quest.3447698DEE3EAE8B.title: "睡个好觉"
	quest.344CB52EE7BAE331.quest_desc: [
		"&e老鼠&r遍布主世界。野生的会钻进箱子偷食物，而&c瘟疫鼠&r会让你生病。"
		""
		"驯服的鼠类则恰恰相反：它们会为你跑腿、耕种、制作和战斗。"
		""
		"&6注意：&r在ICU中，野鼠&o不会&r挖穿你的墙壁。但它们仍会掠夺箱子，所以请将食物存放在安全的地方。"
	]
	quest.344CB52EE7BAE331.quest_subtitle: "小巧、聪明又贪吃"
	quest.344CB52EE7BAE331.title: "糟了！是老鼠！"
	quest.3495AF1842660867.quest_desc: [
		"&e裂变反应堆端口&r可移动燃料、冷却剂、蒸汽和废料。一个&e逻辑适配器&r可通过红石关闭反应堆。"
		""
		"&6注意：&r废料箱装满或温度过高，反应堆会熔毁、爆炸并扩散辐射。务必将废料排出，并将逻辑适配器设为SCRAM模式。"
	]
	quest.3495AF1842660867.quest_subtitle: "开启前请先阅读此说明"
	quest.3495AF1842660867.title: "港口与安全"
	quest.349D48C671BEA6E2.quest_desc: [
		"找到一组&e地下墓穴&r。里面的箱子可能装有遗忘的块茎和下一个需要的锻造模板。"
	]
	quest.349D48C671BEA6E2.quest_subtitle: "被遗忘的大厅"
	quest.349D48C671BEA6E2.title: "地下墓穴"
	quest.34B5739695F15837.quest_desc: [
		"&e喷发地狱&r是最愤怒的下界：熔岩湖、熔岩泉和喷气孔。"
		""
		"开采 &eBrimstone&r。四个可以制作成 Brimstone Bricks，用 Brimstone 围住一个 fire charge 就能制作出你自己的 &eBrimstone Fumarole&r。"
	]
	quest.34B5739695F15837.quest_subtitle: "喷发的炼狱（The Erupting Inferno）"
	quest.34B5739695F15837.title: "硫磺石（Brimstone）"
	quest.34B7D041DDC012E2.quest_desc: [
		"铁、石墨和沙子可以制作&e反应堆外壳&r。第一个反应堆大约需要22个。"
		""
		"&eReactor Glass&r 可以替换侧面的外壳，让你能看见内部。"
	]
	quest.34B7D041DDC012E2.quest_subtitle: "贝壳"
	quest.34B7D041DDC012E2.title: "反应堆外壳"
	quest.34BE22FF15BF329D.quest_desc: [
		"&eMob Masher&r会杀死生物，其击杀数算作玩家击杀数，这样你就能获得稀有掉落物。"
		""
		"为掠夺、锋利度等添加捣碎者升级。"
	]
	quest.34BE22FF15BF329D.quest_subtitle: "一个合格的生物刷怪机"
	quest.34BE22FF15BF329D.title: "生物粉碎机"
	quest.34C8F8ED79226EB2.quest_desc: [
		"一个潜影盒和一个下界合金锭可以制作一个&e保险箱&r。黄金可以制作一把&e钥匙&r。"
		""
		"将保险箱与钥匙绑定，只有持有该钥匙的人才能打开。适用于多人基地。"
	]
	quest.34C8F8ED79226EB2.quest_subtitle: "把手拿开，别碰我的东西！"
	quest.34C8F8ED79226EB2.title: "安全"
	quest.34CC232488B9BA5D.quest_desc: [
		"四根木棍可以制作一个&eTimber Frame&r。将其放置在任意完整方块上即可形成框架，或用&eDaub&r（黏土和稻草）填充，打造经典的草泥墙。"
		""
		"斧头会再次剥去框架，并留下里面的方块。"
	]
	quest.34CC232488B9BA5D.quest_subtitle: "都铎王朝，不过是方块风格的"
	quest.34CC232488B9BA5D.title: "木材框架搭建指南"
	quest.350DE6736B4D078E.quest_desc: [
		"一个发光面板、一个逻辑处理器和一个ME请求器，无需特定形状。"
		""
		"&eME 请求终端&r会显示网络中的所有请求器，因此你可以在一个屏幕上更改库存物品。使用 AE2 无线终端，还有无线版本可供选择。"
	]
	quest.350DE6736B4D078E.quest_subtitle: "你所有的库存订单"
	quest.350DE6736B4D078E.title: "请求者终端"
	quest.352355E22B086BE8.quest_desc: [
		"一个2x2的水池，周围环绕着花朵或草，里面还扔着一颗钻石。"
	]
	quest.352355E22B086BE8.quest_subtitle: "总是黄昏，总是诡异"
	quest.352355E22B086BE8.title: "暮色森林（The Twilight Forest）"
	quest.35315404B8FF2B4D.quest_desc: [
		"&eOffroad&r 添加了地面载具。一个 &eWheel Mount&r（带弹簧悬挂）可以安装轮胎。用轮胎右键点击该支架。"
		""
		"给顶部加力制动，给侧面加力转向。轮胎有小型、普通、大型和巨型可选。"
	]
	quest.35315404B8FF2B4D.quest_subtitle: "汽车、卡车和漫游者"
	quest.35315404B8FF2B4D.title: "越野：车轮"
	quest.3555C4650E5628B4.quest_desc: [
		"&e烤箱&r（砖块、铁栏杆和烟熏炉）的用法和烟熏炉一样。 &e柜台&r顶部可放置方解石；右键单击并用木头或石头更改表面。"
		""
		"石板可以制作&e木制餐盘&r和&e木制杯子&r。将每种各一个组合成&e餐具组合&r，然后用任意物品右键点击它，即可将物品放在餐盘上。"
	]
	quest.3555C4650E5628B4.quest_subtitle: "烹饪，也要有格调"
	quest.3555C4650E5628B4.title: "厨房"
	quest.355AFBA300ACC37C.quest_desc: [
		"你需要钻石来制作AE2存储单元、Powah和各种工具。去世界底部深处挖掘吧。"
	]
	quest.355AFBA300ACC37C.quest_subtitle: "钻石仍然非常重要"
	quest.355AFBA300ACC37C.title: "闪闪发光！"
	quest.356933D0C48BA026.quest_desc: [
		"有 Create 吗？你的厨房可以自动运行了："
		""
		"已喂食的 &eBlaze Burner&r 可作为烹饪锅或煎锅下方的热源，温度更高的炉灶能让某些食物烹饪得更快。"
		"&e漏斗&r将做好的饭菜从烹饪锅中取出。"
		"一个&e机械臂&r将食物放在砧板上。一个手持刀具的&e部署器&r，或&e机械锯&r，将其切开。"
		"机械臂还会上菜，并从派中切取一片。"
		""
		"要查看效果，将烹饪锅或砧板悬停，并按住 &eW&r。"
	]
	quest.356933D0C48BA026.quest_subtitle: "让创造模式来处理烹饪工作吧"
	quest.356933D0C48BA026.title: "自动化厨房"
	quest.35CB1860BEC7606E.quest_desc: [
		"&eMEGA Crafting Units&r 和 &e1M Crafting Storage&r 建造能规划大型工程的 CPU。"
		""
		"&eMEGA 模式提供器&r 是一种比普通模式提供器多了一些插槽的装置。"
	]
	quest.35CB1860BEC7606E.quest_subtitle: "更大的任务"
	quest.35CB1860BEC7606E.title: "MEGA Crafting"
	quest.35F57E37B26D130A.quest_desc: [
		"建造一个像下界传送门形状的萤石框架，并在里面倒入水。"
	]
	quest.35F57E37B26D130A.quest_subtitle: "向上，再向上，飞向远方"
	quest.35F57E37B26D130A.title: "以太维度"
	quest.360FAB4F319BF795.quest_desc: [
		"高级工作台（或其自动版）、钻石块、精英组件和精英催化剂。"
	]
	quest.360FAB4F319BF795.quest_subtitle: "7x7 的表格"
	quest.360FAB4F319BF795.title: "精英合成台"
	quest.362725CC06AED795.quest_desc: [
		"在雪原上游荡的巨型冰霜巨兽。"
	]
	quest.362725CC06AED795.quest_subtitle: "Mowzie's Mobs"
	quest.362725CC06AED795.title: "Frostmaw"
	quest.3658B7C86722CDC5.quest_desc: [
		"将能量球放置在已充能的能量棒附近，即可将物品与能量融合。"
		""
		"Powah's better crystals are all made here, and in ICU the fancy ones need rare metals."
	]
	quest.3658B7C86722CDC5.quest_subtitle: "将物品闪电般升级为更好的物品"
	quest.3658B7C86722CDC5.title: "能量球 (Energizing Orb)"
	quest.36720522CAF4626F.quest_desc: [
		"核废料和损坏的反应堆都会泄漏&c辐射&r。一套完整的&e防化服&r可以保护你。"
		""
		"携带一个 &e盖革计数器&r，在进入某个区域前先检查一下。"
	]
	quest.36720522CAF4626F.quest_subtitle: "为工作选择合适的着装"
	quest.36720522CAF4626F.title: "辐射安全"
	quest.3691ECC02029EDF9.quest_desc: [
		"先知的家就是&e远古工厂&r。探险家指南针可以帮助你找到它。"
	]
	quest.3691ECC02029EDF9.quest_subtitle: "有什么巨大的东西在嗡嗡作响"
	quest.3691ECC02029EDF9.title: "找到远古工厂 Ancient Factory"
	quest.36970FA465FC4B39.quest_desc: [
		"在堡垒宝藏室中挖掘 &eSuspicious Soul Sand&r，可获得 &eVibranium Smithing Template&r。"
		""
		"用七个 Allthemodium 锭和 &e远古石头&r 来复制它。"
	]
	quest.36970FA465FC4B39.quest_subtitle: "堡垒宝藏"
	quest.36970FA465FC4B39.title: "振金模板"
	quest.3697F3045165A9C7.quest_desc: [
		"&e大魔导师之塔&r是为 Ars Nouveau 建造的法师家园，通常出现在巫师塔附近的地方。"
		""
		"祝新手巫师狩猎顺利。"
	]
	quest.3697F3045165A9C7.quest_subtitle: "新艺术风格的藏身之处"
	quest.3697F3045165A9C7.title: "大魔导师的塔"
	quest.370FB45C42F8B245.quest_desc: [
		"蓝图是蓝色染料和纸，上面放着一些物品。 &e组件&r 蓝图使用铜、铅和铁锭； &e模具&r 蓝图使用铁板。"
		""
		"其余物品（子弹、电极等）请在EMI中查看。"
	]
	quest.370FB45C42F8B245.quest_subtitle: "图纸，而非魔法"
	quest.370FB45C42F8B245.title: "蓝图"
	quest.3734A16DE97D3A2C.quest_desc: [
		"地下锻造密室里的一只装甲巨兽。"
	]
	quest.3734A16DE97D3A2C.quest_subtitle: "Mowzie's Mobs"
	quest.3734A16DE97D3A2C.title: "Ferrous Wroughtnaut"
	quest.37369D8B607A20D1.quest_desc: [
		"Bosses always drop their trophy. Collect one of each major boss for your wall."
	]
	quest.37369D8B607A20D1.quest_subtitle: "墙上挂着的每一张人脸"
	quest.37369D8B607A20D1.title: "奖杯室"
	quest.3740B69512F446EB.quest_desc: [
		"Extreme Reactors 通常使用 Yellorium。在 ICU 中，它与 Mekanism 的 &eUranium&r 合并，所以铀锭可以替代使用。"
		""
		"Mine Uranium ore and smelt it. Keep a stack handy: it's both a crafting part and the fuel."
	]
	quest.3740B69512F446EB.quest_subtitle: "一种金属，两种名称"
	quest.3740B69512F446EB.title: "铀就是镭元素（Yellorium）"
	quest.374AB680A7148C6E.quest_desc: [
		"宽轨和窄轨轨道都有自己的转向架，从小型电车到大型货运列车。"
		""
		"火车只能在与其转向架匹配的轨距上运行。"
	]
	quest.374AB680A7148C6E.quest_subtitle: "尺寸很重要"
	quest.374AB680A7148C6E.title: "宽轨与窄轨铁路 (Wide and Narrow Gauge)"
	quest.3783118E8CB084AD.quest_desc: [
		"用 &eiron ingot&r 和 &eblack dye&r 可以制作 Black Iron Ingot。将其制作成 &eBlack Iron Slate&r。"
		""
		"几乎所有扩展合成部分都从这两个开始。"
	]
	quest.3783118E8CB084AD.quest_subtitle: "一切开始的地方"
	quest.3783118E8CB084AD.title: "黑铁（Black Iron）"
	quest.37A89D15C1F1ABD3.quest_desc: [
		"Wear &eEngineer's Goggles&r and look at machines to see their speed, stress and contents."
		""
		"&e扳手&r可以旋转方块，潜行右键可立即拾取。请持续使用。"
	]
	quest.37A89D15C1F1ABD3.quest_subtitle: "护目镜和一把扳手"
	quest.37A89D15C1F1ABD3.title: "看见无形之物"
	quest.37AB78FE91035226.quest_desc: [
		"用四块红石和一个绿宝石合成&e红宝石&r。红宝石工具是最坚固的宝石套装：钻石的速度和960次使用次数。"
		""
		"&6注意：&rICU统一了红宝石，所以EMI显示该宝石为AllTheOres红宝石。所有红宝石配方都使用同一宝石。"
	]
	quest.37AB78FE91035226.quest_subtitle: "绿宝石，但更生气了"
	quest.37AB78FE91035226.title: "红宝石工具"
	quest.37B5BB606979DFC0.quest_desc: [
		"小麦和牛奶可以制作一个 &e派皮&r。加入苹果、糖和小麦，就能做出一个 &e苹果派&r。"
		""
		"放置后一片片吃掉，或者在砧板上切开。"
	]
	quest.37B5BB606979DFC0.quest_subtitle: "把它切成片状吧"
	quest.37B5BB606979DFC0.title: "苹果派"
	quest.37BC8BBE924F0BBE.quest_desc: [
		"&e红石随机器&r会随机从左或右发出信号。"
		""
		"&eEnder Watcher&r离其眼睛中心越近，发出的信号就越强。秘密传送门，了解一下？"
	]
	quest.37BC8BBE924F0BBE.quest_subtitle: "随机性与对视大赛"
	quest.37BC8BBE924F0BBE.title: "红石怪奇球"
	quest.37BD3C282A616F8B.quest_desc: [
		"金背包周围放八个钻石。这是最后一个合成台等级。"
	]
	quest.37BD3C282A616F8B.quest_subtitle: "现在我们开始打包了"
	quest.37BD3C282A616F8B.title: "钻石背包"
	quest.37C0EB400D953539.quest_desc: [
		"寻找野生植物：海滩上的&e卷心菜&r、平原和森林里的&e洋葱&r、稀树草原和沙漠中的&e番茄&r、沼泽和丛林池塘里的&e水稻&r。"
		""
		"打破它们以获得种子和第一波收成。"
	]
	quest.37C0EB400D953539.quest_subtitle: "去采集资源吧"
	quest.37C0EB400D953539.title: "野生作物"
	quest.37C43A0E90CB50A9.quest_desc: [
		"&e热气球燃烧器&r（铁板、煤炭块、红石和安山合金）在接收到红石信号时会填充上方气球的气体。"
		""
		"信号更强，热气更足。多个燃烧器可共享一个气球。上升时升力会减弱，所以飞船会自动保持水平。"
	]
	quest.37C43A0E90CB50A9.quest_subtitle: "向上，再向上，飞向远方"
	quest.37C43A0E90CB50A9.title: "热空气燃烧器"
	quest.37C7BDDE8555C8EB.quest_desc: [
		"它能将7x7x7范围内的物品和XP球吸入。XP会作为流体储存在&eSingularity Tank&r中。"
	]
	quest.37C7BDDE8555C8EB.quest_subtitle: "物品和经验，已收集完毕"
	quest.37C7BDDE8555C8EB.title: "吸收式漏斗 (Absorption Hopper)"
	quest.38060B05E6174914.quest_desc: [
		"高级工厂和安装器需要一个&e高级控制电路&r。"
	]
	quest.38060B05E6174914.quest_subtitle: "五个物品栏位"
	quest.38060B05E6174914.title: "高级自动化工厂"
	quest.38106165790673B6.quest_desc: [
		"&eDocking Connectors&r 对接连接器，当两个装置对齐时可将它们锁定在一起（机械合成配方）。"
		""
		"对接后，物品和流体可双向通过。收起任一侧即可分离。"
	]
	quest.38106165790673B6.quest_subtitle: "把车停好，别乱放位置了"
	quest.38106165790673B6.title: "对接连接器"
	quest.382AB8AF62600EA7.quest_desc: [
		"石头和灵魂尘可以制作一个&e匠人台&r。用它将增强模块装配到精华工具和盔甲上。"
		""
		"夜视、速度、步法辅助甚至还有飞行都包含在内。每种增强都需要最低装备等级。"
	]
	quest.382AB8AF62600EA7.quest_subtitle: "添加增强组件"
	quest.382AB8AF62600EA7.title: "Tinkering Table"
	quest.38443B7253517EFB.quest_desc: [
		"&e螃蟹&r在沙滩和红树林沼泽中爬行。它们会掉落&e蟹钳&r。"
		""
		"将爪子加入粗制药水，可酿造&e潜行药水&r：能让你从更远的地方到达方块。&6注意：&rEcologics的椰子蟹会掉落不同的蟹钳，那种无法酿造潜行药水。"
	]
	quest.38443B7253517EFB.quest_subtitle: "螃蟹钳子和长臂猿的臂力"
	quest.38443B7253517EFB.title: "长臂猿的臂膀"
	quest.385C629EE429CC7C.quest_desc: [
		"用&eIgnitium Ingot&r为钻石注入能量。"
	]
	quest.385C629EE429CC7C.quest_subtitle: "闪闪发光，而且呈蓝色"
	quest.385C629EE429CC7C.title: "Niotic 水晶"
	quest.38641F9FD781274D.quest_desc: [
		"将&eFiery Blood&r（来自九头蛇）或&eFiery Tears&r（来自远古幻象）与铁锭结合。"
		""
		"&6预算如下：&r每个高级控制电路消耗一个炽热锭，精英和终极电路各消耗一个。九头蛇会掉落7到10个炽热血液（抢夺可增加掉落数）。"
	]
	quest.38641F9FD781274D.quest_subtitle: "炽热的金属"
	quest.38641F9FD781274D.title: "炽热的锭块"
	quest.386B317EDFD57283.quest_desc: [
		"这里的每个任务都只是一个勾选框。读一读，勾一勾，然后继续。"
		""
		"卡在了某个不存在的东西上？悬停物品：ICU 的一些稀有物品会在提示框和 EMI 中自行解释。"
	]
	quest.386B317EDFD57283.quest_subtitle: "快速答案，无任务提示"
	quest.386B317EDFD57283.title: "提示与教程"
	quest.3896A4B586181037.quest_desc: [
		"&e火车连接器&r可以连接和拆分火车，而无需将它们拆开。将其放置在所选轨道旁边。"
		""
		"车站有助于将车厢排成一行。红石可以触发它。"
	]
	quest.3896A4B586181037.quest_subtitle: "连接和拆分火车车厢"
	quest.3896A4B586181037.title: "火车连接器"
	quest.38A8F211E8220BDF.quest_desc: [
		"点燃 Levitite Blend 时，另一只手拿着染料。整个晶体都会长成那个颜色。"
		""
		"已经有普通的 Levitite 了？用 &eLiquid Dye&r (Create: Dragons Plus) 吹拂它来重新上色。"
	]
	quest.38A8F211E8220BDF.quest_subtitle: "漂浮的岩石，现已上色"
	quest.38A8F211E8220BDF.title: "彩色悬浮石 (Colored Levitite)"
	quest.38ADCB3F3E8AE0D4.quest_desc: [
		"&e蓝色炸弹&r无法合成。稀有的&e红色商人&r会用炸弹和40颗绿宝石交换，它们也极少出现在神庙宝箱中。"
		""
		"&6注意：&r在ICU中，蓝色炸弹会先产生巨大爆炸，然后散射出五枚会引燃物体的小型炸弹。请保持足够距离。"
	]
	quest.38ADCB3F3E8AE0D4.quest_subtitle: "小心轻放"
	quest.38ADCB3F3E8AE0D4.title: "蓝色炸弹"
	quest.38B1D23B01994741.quest_desc: [
		"铜器和黑曜石工具和盔甲的收获方式与铁器相同。"
		""
		"铜制工具能用250次，黑曜石工具能用650次。钻石短缺时很方便。"
	]
	quest.38B1D23B01994741.quest_subtitle: "预算选项"
	quest.38B1D23B01994741.title: "铜和玄武岩"
	quest.38E610A671758074.quest_desc: [
		"&ePackager&r将材料转化为配方包，用于其容器中的配方。而&eUnpackager&r则会将一整套配方包打开，放置到其旁边的物品栏或合成器中。"
		""
		"两者都需要能量来驱动。"
	]
	quest.38E610A671758074.quest_subtitle: "打包，运输，打开它"
	quest.38E610A671758074.title: "打包机和拆包机"
	quest.395F8C9DEB359924.quest_desc: [
		"跟随末影之眼找到一个堡垒，并填满传送门框架。"
	]
	quest.395F8C9DEB359924.quest_subtitle: "其实并不是真正的终点"
	quest.395F8C9DEB359924.title: "The End"
	quest.397BC0AFAAB3184E.quest_desc: [
		"&eGlowing Grotto&r 是一个充满巨型发光蘑菇和垂挂蛛网的洞穴群系。"
		""
		"采集一些&eGlowshrooms&r，然后用剪刀处理这些线，可以获得&eGlowworm Silk&r。"
	]
	quest.397BC0AFAAB3184E.quest_subtitle: "下方的灯光已经熄灭了"
	quest.397BC0AFAAB3184E.title: "发光洞穴"
	quest.398D49173D7FE1A2.quest_desc: [
		"用新压机打印 Sky Steel，然后用 Printed Silicon 和 fluix dust 压制。"
		""
		"&6注意：&rICU的64M和256M组件也需要这些，所以请制作一叠。"
	]
	quest.398D49173D7FE1A2.quest_subtitle: "MEGA的大脑"
	quest.398D49173D7FE1A2.title: "累积处理器"
	quest.399BD26931F1061E.quest_desc: [
		"铁发电机加黄金。依然是固体燃料，依然更棒。"
	]
	quest.399BD26931F1061E.quest_subtitle: "闪亮又更快"
	quest.399BD26931F1061E.title: "黄金发电机"
	quest.39A09502B9AE8E52.quest_desc: [
		"&e喂食升级&r会在你饥饿时吃掉背包里的食物。"
		""
		"需要花费一个金苹果、一个金胡萝卜、一个闪亮甜瓜和一个末影珍珠，但绝对值得。"
	]
	quest.39A09502B9AE8E52.quest_subtitle: "再也不会挨饿了"
	quest.39A09502B9AE8E52.title: "喂食升级"
	quest.39AF98FC109927A2.quest_desc: [
		"在溶解室中，用两个铁、两个金和1000mB的粉色史莱姆可以制作一个&e粉色史莱姆锭&r。"
		""
		"备一罐粉色史莱姆；高级框架需要它。"
	]
	quest.39AF98FC109927A2.quest_subtitle: "软金属块"
	quest.39AF98FC109927A2.title: "粉色史莱姆"
	quest.39D1B2BD3FE79DFD.quest_desc: [
		"&e冶炼升级&r是背包里的一个熔炉。它的&e自动冶炼&r版本会从背包中取出矿石和燃料并自行冶炼。"
		""
		"还有冒烟和爆破版本。查看EMI（物品上的R）。"
	]
	quest.39D1B2BD3FE79DFD.quest_subtitle: "边走边烹饪，享受美味时光"
	quest.39D1B2BD3FE79DFD.title: "冶炼升级模组 (Smelting Upgrades)"
	quest.39DDDAAFC3E4D82A.quest_desc: [
		"宝石周围放四个金锭可以制作一个&eJuju&r。将其中的一个放在背包的任何位置："
		"&eEmerald Juju&r：水之呼吸。 &eRuby Juju&r：火焰抗性。"
		"&e紫晶咒术&r：夜视。右键点击以开启或关闭。"
	]
	quest.39DDDAAFC3E4D82A.quest_subtitle: "幸运护身符"
	quest.39DDDAAFC3E4D82A.title: "咒语书"
	quest.3A34E217F34F0D5B.quest_desc: [
		"紫水晶、金和末影之眼可以合成&e维度核心&r，它是猫头鹰口袋维度的心脏。"
	]
	quest.3A34E217F34F0D5B.quest_subtitle: "无限的潜力"
	quest.3A34E217F34F0D5B.title: "维度核心 (Dimensional Core)"
	quest.3A395AB8407CCD1F.quest_desc: [
		"野生星兔喜欢金块。递出一个金块，当星兔捡起它时，会留下一枚&e星兔代币&r。"
		""
		"在装置上的令牌周围放置四个金锭可制作护身符。用魔杖取走宝箱和星团，然后将星团放入宝箱送达。"
	]
	quest.3A395AB8407CCD1F.quest_subtitle: "一个小小的信使"
	quest.3A395AB8407CCD1F.title: "星之纽带（Starbuncle）"
	quest.3A527E85A04400B8.quest_desc: [
		"牛头人和迷宫宝箱会掉落&e迷宫地图焦点&r。"
		""
		"放入纸张可获得迷宫地图。再添加铁、金和钻石各一块可获得矿石地图。"
	]
	quest.3A527E85A04400B8.quest_subtitle: "牛头人拥有最好的东西"
	quest.3A527E85A04400B8.title: "迷宫地图焦点"
	quest.3ABB14B8AF27A224.quest_desc: [
		"将末影岩块分解成九个锭。"
	]
	quest.3ABB14B8AF27A224.quest_subtitle: "九折优惠，买一送一"
	quest.3ABB14B8AF27A224.title: "Witherite"
	quest.3AE127DBB8843D84.quest_desc: [
		"熔炉周围放八个铁锭可以制作一个&eIron Furnace&r，它的冶炼速度比普通熔炉快。"
		""
		"使用&e升级套件&r将已放置的熔炉升至下一级，内容物不会丢失。"
	]
	quest.3AE127DBB8843D84.quest_subtitle: "更快的熔炼速度"
	quest.3AE127DBB8843D84.title: "铁质熔炉"
	quest.3B05217951162495.quest_desc: [
		"染料和水桶可以制作一桶彩色水。加入萤石粉或发光墨囊可以让它发光。"
		""
		"岩浆也行：岩浆桶和染料能做出彩色岩浆，再用另一种染料能调暗。彩色岩浆是&c真正的岩浆&r：它会燃烧、点燃附近的木头，碰到水会变成黑曜石或圆石。请远离木制建筑。"
	]
	quest.3B05217951162495.quest_subtitle: "各种颜色的水池都有，五彩缤纷"
	quest.3B05217951162495.title: "彩色水 (Colored Water)"
	quest.3B1AA3A41ED43E45.quest_desc: [
		"用法师花纤维包裹的抄写台就是&e改造台&r。用它将&e线&r缝入魔法盔甲中。"
		""
		"空白线轴由纤维和金块制成。在装置上将其制成真正的线轴。"
	]
	quest.3B1AA3A41ED43E45.quest_subtitle: "放入一些线到物品栏中"
	quest.3B1AA3A41ED43E45.title: "Alteration Table"
	quest.3B39B82B99E05218.quest_desc: [
		"末地守卫会掉落&e守卫手套&r。右键可将敌人拉向你。"
	]
	quest.3B39B82B99E05218.quest_subtitle: "快到我这边来！"
	quest.3B39B82B99E05218.title: "守护者手套 (Gauntlet of Guard)"
	quest.3B3B3BE4BA4656A1.quest_desc: [
		"将雕刻的幽暗葫芦堆叠在遗忘金属块上，建造一个能帮你守卫基地的小遗忘仆从。"
	]
	quest.3B3B3BE4BA4656A1.quest_subtitle: "被遗忘的仆从"
	quest.3B3B3BE4BA4656A1.title: "建造一个哨兵塔 (Build a Sentry)"
	quest.3B47AED25AF0B8B8.quest_desc: [
		"轨道来自序列组装：将金块放在石板块上，然后按下。具体步骤请查看EMI。"
		""
		"点击已放置的轨道，再点击另一个位置，即可一次性铺设长曲线和斜坡。"
	]
	quest.3B47AED25AF0B8B8.quest_subtitle: "铺上一些线"
	quest.3B47AED25AF0B8B8.title: "铁路轨道"
	quest.3B5103D261A6E4D2.quest_desc: [
		"九头蛇会掉落一叠&e九头蛇肉排&r。在快要饿死时吃一个，可以获得额外奖励。"
	]
	quest.3B5103D261A6E4D2.quest_subtitle: "应急晚餐"
	quest.3B5103D261A6E4D2.title: "九头蛇斩击"
	quest.3B518C0D595EA011.quest_desc: [
		"三种暗物质、五种永恒燃料和一个&e振金原矿&r。红物质工具和盔甲则更为强大。"
	]
	quest.3B518C0D595EA011.quest_subtitle: "暗物质，但更愤怒了"
	quest.3B518C0D595EA011.title: "红色物质"
	quest.3B82CF7B8757CCDA.quest_desc: [
		"如果你死亡，你的物品会安全留在你倒下的地方的&e尸体&r里。走回去打开它就能拿回所有东西。"
		""
		"你的小地图已经标记了地点，所以你不用找太久。"
	]
	quest.3B82CF7B8757CCDA.quest_subtitle: "即使是再好的人，有时也会这样"
	quest.3B82CF7B8757CCDA.title: "当事情出错时"
	quest.3BAFFDBC16006F67.quest_desc: [
		"普通工作台需要八个钻石和一个下界合金废料来制作一个&e钻石晶格&r。"
		"潜声台的配方只需要四颗钻石。快用起来吧！"
	]
	quest.3BAFFDBC16006F67.quest_subtitle: "在潜声方块中更便宜一些"
	quest.3BAFFDBC16006F67.title: "钻石晶格"
	quest.3BC46B72BBE15E68.quest_desc: [
		"每个巫妖会掉落一根权杖：暮色（发射）、生命汲取（治疗）、僵尸（召唤帮手）或堡垒（护盾）。"
		""
		"同时拥有全部四个才能完成。其他巫妖塔都是合法目标。"
	]
	quest.3BC46B72BBE15E68.quest_subtitle: "收集全部四个物品"
	quest.3BC46B72BBE15E68.title: "巫妖的权杖 (The Lich's Scepters)"
	quest.3BDE10A84B75CC93.quest_desc: [
		"在ICU中，每个&e远古守卫者&r都会掉落一个&e三叉戟碎片&r。"
		""
		"三个碎片和两个海晶碎片可以合成一把全新的三叉戟。海洋纪念碑里有三个远古守卫者，正好够用。"
	]
	quest.3BDE10A84B75CC93.quest_subtitle: "没有溺亡者的三叉戟"
	quest.3BDE10A84B75CC93.title: "三叉戟碎片"
	quest.3BEE09950FE2F5D5.quest_desc: [
		"一个 5x5 的订单，来自&eMechanical Crafter&r：八个 Sturdy Sheets、四个 Precision Mechanisms、四个 Brass Casings、三个 Electron Tubes、一个 Rotation Speed Controller 和一个 Block of Experience。"
		""
		"建造一个5x5的制作者方块。EMI会显示每个部分的位置。"
	]
	quest.3BEE09950FE2F5D5.quest_subtitle: "创造者最精美的钟表装置"
	quest.3BEE09950FE2F5D5.title: "动能封印"
	quest.3C3C12FA3570851B.quest_desc: [
		"用黑曜石、三颗钻石、两个石英块和两个烈焰棒来制作你的新手之书。"
		""
		"&e法师的魔法书&r可以使用二级符文，你学到的所有符文都包含在内。"
	]
	quest.3C3C12FA3570851B.quest_subtitle: "已解锁 Tier 2 法术"
	quest.3C3C12FA3570851B.title: "法师的魔法书"
	quest.3C5AA0B356467ACB.quest_desc: [
		"在溶解室中：一个怜悯框架、两个塑料、两个下界砖、两个铁、一个金齿轮和250mB的乳胶。"
	]
	quest.3C5AA0B356467ACB.quest_subtitle: "向上一步"
	quest.3C5AA0B356467ACB.title: "简易机械框架"
	quest.3C7DCDC5DE5B0446.quest_desc: [
		"顶部无线接收器、中部终端和底部高密度能量电池可组成无线&e模式编码&r或&e模式访问&r终端。"
		""
		"你也可以用工程处理器升级无线合成终端。两者都适用于通用终端。"
	]
	quest.3C7DCDC5DE5B0446.quest_subtitle: "随时随地进行编码"
	quest.3C7DCDC5DE5B0446.title: "无线模式 (Wireless Patterns)"
	quest.3C8ABCBA363FF41B.quest_desc: [
		"在&eGarden Cloche&r里种下种子，加入泥土、能量和水。它能在室内生长作物，不需要光照。"
		""
		"肥料可以加快生长速度。"
	]
	quest.3C8ABCBA363FF41B.quest_subtitle: "装在瓶子里的农场"
	quest.3C8ABCBA363FF41B.title: "花园玻璃罩"
	quest.3CA89A9354ADFF86.quest_desc: [
		"&eInventory Pets&r 是一种物品。携带一个并右键点击（或潜行右键）即可使用其能力。将宠物悬停以查看其作用。"
		""
		"&6注意：&r宠物在ICU里会饿。每只宠物在工具提示里都列出了它最喜欢的食物，所以随身带点吧。"
	]
	quest.3CA89A9354ADFF86.quest_subtitle: "它们骑在你的物品栏里"
	quest.3CA89A9354ADFF86.title: "口袋宠物"
	quest.3CC6747925F5AA93.quest_desc: [
		"三个超优质精华、一个灌注水晶和一个&e不可得锭&r。"
	]
	quest.3CC6747925F5AA93.quest_subtitle: "农业已经发展得太过分了"
	quest.3CC6747925F5AA93.title: "Insanium 精华"
	quest.3CC837BA6D770F43.quest_desc: [
		"&e基础法术炮台&r在供能时会施放铭刻的接触或投射法术，并从附近的罐子中抽取源。"
		""
		"在装置上升级（一个源宝石块和两根烈焰棒）为&e附魔&r炮台，消耗减半。非常适合小型农场和采石场。"
	]
	quest.3CC837BA6D770F43.quest_subtitle: "魔法分配器"
	quest.3CC837BA6D770F43.title: "法术炮台"
	quest.3CD546BAD48CA2C8.quest_desc: [
		"合成 &eSoul Jars&r 和一把 &eSoulium Dagger&r（需要 Soulium、Soulium Dust 和一把金剑）。"
		""
		"当空瓶在背包中时，用匕首杀死生物，它们的灵魂就会填满瓶子。"
	]
	quest.3CD546BAD48CA2C8.quest_subtitle: "捕获一些灵魂吧"
	quest.3CD546BAD48CA2C8.title: "灵魂容器"
	quest.3D02805B8DB75FA4.quest_desc: [
		"在装置上放置一个AE2物品槽外壳，并加入两个操控精华、两个源宝石和四个金锭，即可将其变为一个&e源槽外壳&r。"
		""
		"你的ME网络现在可以像其他资源一样存储源能。"
	]
	quest.3D02805B8DB75FA4.quest_subtitle: "Ars Energistique 开始了"
	quest.3D02805B8DB75FA4.title: "ME 源能单元外壳"
	quest.3D1471B3E4721067.quest_desc: [
		"由水晶矩阵和中子星制成的末地工作台。可在时运和丝绸之触之间切换，并能挖掘基岩和传送门框架。"
	]
	quest.3D1471B3E4721067.quest_subtitle: "可以破坏基岩"
	quest.3D1471B3E4721067.title: "水晶镐"
	quest.3D57378E6249F99F.quest_desc: [
		"用破碎机粉碎植物、种子和食物以制作&e生物燃料&r，然后在&e生物发电机&r中燃烧它。"
		""
		"把它连接到自动化农场，就不用管它了。"
	]
	quest.3D57378E6249F99F.quest_subtitle: "作物转化为能量"
	quest.3D57378E6249F99F.title: "生物发电机"
	quest.3D63DAC7B23B9862.quest_desc: [
		"银色地牢的领主。它会掉落银色钥匙。"
	]
	quest.3D63DAC7B23B9862.quest_subtitle: "以太维度"
	quest.3D63DAC7B23B9862.title: "瓦尔基里女王"
	quest.3D752B93715B25AF.quest_desc: [
		"&e能量接收器&r可从任何发电机获取FE。 &e能量单元&r可缓冲能量，使网络永不闪烁。"
	]
	quest.3D752B93715B25AF.quest_subtitle: "给控制器喂食"
	quest.3D752B93715B25AF.title: "网络电力"
	quest.3D96BCD838FC53D0.quest_desc: [
		"用红物质升级你的暗物质镐。"
		""
		"每件红物质工具和盔甲都需要在网格中放置一个&e龙之心脏&r（末影龙）。它会留在网格中，所以一个心脏就能制作整套装备。"
		"宝石盔甲、卡塔和晨星都由红物质块制成。"
		""
		"挖掘速度如同 Allthemodium 镐：可以挖掘 Vibranium 矿石，但不能挖掘 Unobtainium 矿石。"
	]
	quest.3D96BCD838FC53D0.quest_subtitle: "顶级挖掘工具"
	quest.3D96BCD838FC53D0.title: "红物质镐"
	quest.3E038A13282E77CA.quest_desc: [
		"皮革、铁和红石可以制作八个&e传送带&r。你的粉碎机和金属压模很喜欢用它们来进料。"
	]
	quest.3E038A13282E77CA.quest_subtitle: "物品在移动中"
	quest.3E038A13282E77CA.title: "传送带系统 (Conveyor Belts)"
	quest.3E329CA147973ED1.quest_desc: [
		"&eCupboards&r, &eDrawers&r, &eNightstands&r, &eDesks&r, &eShelves&r, &eSide Tables&r and &eCounters&r all hold as much as a chest: 27 slots."
		""
		"每个配方都需要一个箱子。请在EMI中查看形状。"
	]
	quest.3E329CA147973ED1.quest_subtitle: "隐藏杂乱无章的物品，保持整洁"
	quest.3E329CA147973ED1.title: "外观精美的储物空间"
	quest.3E80DC06EF1BF41B.quest_desc: [
		"找到一个陨石。里面有一个&e神秘立方体&r，装着四个刻印机压板。"
		""
		"建造一台刻印机，并打印你的第一个逻辑处理器。"
	]
	quest.3E80DC06EF1BF41B.quest_subtitle: "陨石中蕴藏着秘密"
	quest.3E80DC06EF1BF41B.title: "Inscriber"
	quest.3E86E4FEAFD9B356.quest_desc: [
		"&eWizard Towers&r 耸立在森林、平原和草地之上。攀登一座吧。"
	]
	quest.3E86E4FEAFD9B356.quest_subtitle: "又高又尖，造型独特"
	quest.3E86E4FEAFD9B356.title: "巫师塔"
	quest.3E93D46D3FA94C54.quest_desc: [
		"Draconium 矿石会掉落 &eDraconium 粉尘&r，使用 Fortune 附魔可以获得更多。将粉尘熔炼成锭。"
		""
		"本章几乎所有内容都始于德拉科尼乌姆，所以要确保供应稳定。"
	]
	quest.3E93D46D3FA94C54.quest_subtitle: "紫色的尘埃，伟大的梦想"
	quest.3E93D46D3FA94C54.title: "Draconic Evolution"
	quest.3E97965CAB5C8178.quest_desc: [
		"带有四个源宝石块和四个金块的AE2能源接收器（10000源）将成为&eME源转换器&r。"
		""
		"它将 Source 与你的 ME 网络连接。在 EMI 中悬停以查看详情。"
	]
	quest.3E97965CAB5C8178.quest_subtitle: "能量接收器，魔法版"
	quest.3E97965CAB5C8178.title: "ME 源转换器"
	quest.3F037DB335A2C483.quest_desc: [
		"又一个&eMechanical Crafter&r配方，5宽4高：三个Hot Air Envelope，四个Gyroscopic Mechanism，三个Engine Assembly，两个Gyroscopic Propeller Bearing，两个Hot Air Burner，一个Altitude Sensor和一个Navigation Table。"
		""
		"每个部分都是飞船部件，所以&e航空学&r章节会指导你完成。"
	]
	quest.3F037DB335A2C483.quest_subtitle: "在一艘会飞的船上进行调整"
	quest.3F037DB335A2C483.title: "天际封印"
	quest.3F67D59EDAD989DA.quest_desc: [
		"不喜欢外观？滑翔伞可以变成&e德库树叶&r，效果一样。查看EMI（物品上按R）了解方法。"
	]
	quest.3F67D59EDAD989DA.quest_subtitle: "优雅地滑翔前进"
	quest.3F67D59EDAD989DA.title: "德库树叶"
	quest.3F78CB24846E38FF.quest_desc: [
		"网络中的&eFlux Controller&r会无线为你背包中的物品充能。"
	]
	quest.3F78CB24846E38FF.quest_subtitle: "边走边充能，效率更高"
	quest.3F78CB24846E38FF.title: "Flux 控制器"
	quest.3F7B0076DB8C5AC2.quest_desc: [
		"IE 使用真实电线传输电力。制作 &eLV Wire Coils&r 和 &eLV Wire Connectors&r，然后点击连接器与连接器。"
		""
		"沉浸式工程章节涵盖了大型机器。"
	]
	quest.3F7B0076DB8C5AC2.quest_subtitle: "沉浸式输电线"
	quest.3F7B0076DB8C5AC2.title: "Wire It Up"
	quest.3F9A3C9AE762B16C.quest_desc: [
		"黄金地牢的宝藏包括凤凰盔甲，它能无视火焰和熔岩。"
		""
		"&6注意：&r水会慢慢将其变成黑曜石盔甲。"
	]
	quest.3F9A3C9AE762B16C.quest_subtitle: "凤凰齿轮"
	quest.3F9A3C9AE762B16C.title: "防火（Fireproof）"
	quest.3FA7DD18415027A0.quest_desc: [
		"You made Logic already. &eCalculation&r uses certus crystals and &eEngineering&r uses diamonds."
		""
		"备用压印台：将带有铁块的压印台放入刻印器中复制。"
	]
	quest.3FA7DD18415027A0.quest_subtitle: "万事皆用脑子解决"
	quest.3FA7DD18415027A0.title: "所有三种处理器均已就绪"
	quest.3FED78849B2D62A3.quest_desc: [
		"一列铜锭、玻璃和另一个铜锭可以制作六个&e管道&r。"
		""
		"用漏斗或投掷器喂食它们。物品优先下落，然后前进，再向侧面移动。红石信号会关闭管道，内部物品超过16个会导致管道破裂。"
	]
	quest.3FED78849B2D62A3.quest_subtitle: "用于物品的铜管"
	quest.3FED78849B2D62A3.title: "管道"
	quest.3FF42EEB9C529ECC.quest_desc: [
		"奥布西迪利斯在它的箱子里守护着一颗&e黑曜石之心&r。"
	]
	quest.3FF42EEB9C529ECC.quest_subtitle: "Obsidilith 战利品"
	quest.3FF42EEB9C529ECC.title: "黑曜石之心"
	quest.401FDB6F9849988A.quest_desc: [
		"海洋纪念碑由 &eYUNG's Better Ocean Monuments&r 重建，原版纪念碑已禁用。"
		""
		"清理出一片区域，并击败一只&e远古守卫者&r。"
	]
	quest.401FDB6F9849988A.quest_subtitle: "长老事务处理中心"
	quest.401FDB6F9849988A.title: "更好的海洋纪念碑整合包任务书"
	quest.4038506B2C209B7B.quest_desc: [
		"深海居民在深海扎营。去拜访一个（或许不要踢翻篝火）。"
	]
	quest.4038506B2C209B7B.quest_subtitle: "Denizen营地"
	quest.4038506B2C209B7B.title: "与当地人会面"
	quest.404B28B0AACE47C2.quest_desc: [
		"一朵非常不友好的花。小心孢子。"
	]
	quest.404B28B0AACE47C2.quest_subtitle: "大规模毁灭的领主们"
	quest.404B28B0AACE47C2.title: "虚空之花"
	quest.4051A9F0435E6FF8.quest_desc: [
		"你的基础工作台（或其自动版本）、一个金块、高级组件和一个高级催化剂。"
	]
	quest.4051A9F0435E6FF8.quest_subtitle: "5x5 的表格"
	quest.4051A9F0435E6FF8.title: "高级合成台"
	quest.4065A6A88950DD27.quest_desc: [
		"一些迷宫宝库中隐藏着&eMazebreaker&r，一把能啃穿迷宫石的镐。祝你好运！"
	]
	quest.4065A6A88950DD27.quest_subtitle: "头奖！Jackpot!"
	quest.4065A6A88950DD27.title: "Mazebreaker"
	quest.40D6EA82892B8A85.quest_desc: [
		"Aether 方块需要 Aether 工具。 &eSkyroot&r 工具能使 Holystone 和 Ambrosium 矿石的掉落量翻倍。"
		""
		"&e寒玉&r工具可以挖掘赞石，有时还能掉落安布罗修姆碎片。"
	]
	quest.40D6EA82892B8A85.quest_subtitle: "从头开始，在高处重新开始"
	quest.40D6EA82892B8A85.title: "Skyroot 和 Holystone"
	quest.40FD2553386B46ED.quest_desc: [
		"黑曜石框架，燧石和钢。你懂的，怎么做。"
	]
	quest.40FD2553386B46ED.quest_subtitle: "又热又烦躁，脾气暴躁"
	quest.40FD2553386B46ED.title: "下界"
	quest.40FF110376586263.quest_desc: [
		"&e蒸汽口&r（铜块上的金板）用蒸汽而不是热空气来填充气球。"
		""
		"和蒸汽机一样，它需要热量、水和锅炉空间。"
	]
	quest.40FF110376586263.quest_subtitle: "用蒸汽来举起沉重的物品"
	quest.40FF110376586263.title: "蒸汽喷口"
	quest.4104F10573119006.quest_desc: [
		"在 &e极限工作台&r 上，配方为：四个 Witherite 锭、四个下界之星、五个远古金属锭、两个 Ignitium 锭和两个 Cursium 锭，以及各一个风暴精华、怪物之角、深渊之卵、远古灵魂、黑曜之心、烈焰之眼、虚空之刺和一个 &e龙之心脏&r。"
		""
		"几乎所有东西都是首领掉落物。《&e首领狩猎&r》这一章也兼作你的购物清单。"
	]
	quest.4104F10573119006.quest_subtitle: "在首领战斗中支付报酬"
	quest.4104F10573119006.title: "灾厄封印"
	quest.4129B4A85FC89942.quest_desc: [
		"三个&e房屋&r物品可以合成一个&e改良房屋&r。"
		""
		"可从云杉屋、金合欢屋、泥土屋、霍比特屋、丛林屋、小屋、山间小屋、塔楼等中任选其一。"
	]
	quest.4129B4A85FC89942.quest_subtitle: "三栋房子才能组成一个更好的家"
	quest.4129B4A85FC89942.title: "改良型房屋"
	quest.418C751AAF482F02.quest_desc: [
		"ICU 更改了高级框架配方：简易框架、塑料、一个 &e骑士金属锭&r、一个下界合金废料、两个金锭、一个钻石齿轮和 500 mB 粉色史莱姆。"
		""
		"Knightmetal 来自暮色森林的哥布林骑士。Tier 3 页面有合成任务。"
	]
	quest.418C751AAF482F02.quest_subtitle: "内部含有 Knightmetal 金属块"
	quest.418C751AAF482F02.title: "高级框架，ICU 风格"
	quest.418E9D2AFE33679F.quest_desc: [
		"每件 MekaSuit 都由 HDPE、Polonium 和 Ultimate 电路包裹的 &eNetherite&r 盔甲组成。"
		""
		"装入模块：喷气背包、重力、辐射防护等。"
	]
	quest.418E9D2AFE33679F.quest_subtitle: "动力盔甲"
	quest.418E9D2AFE33679F.title: "MekaSuit"
	quest.4197B282B8F1946B.quest_desc: [
		"&eMob Crusher&r会杀死范围内的生物，并将它们的掉落物和经验值转化为液态精华。"
		""
		"需要一个高级框架。"
	]
	quest.4197B282B8F1946B.quest_subtitle: "战利品和经验值"
	quest.4197B282B8F1946B.title: "生物破碎机"
	quest.41B9176E3923BCF0.quest_desc: [
		"&eWildfire&r 统治着这座堡垒。带上火焰抗性附魔和一把好弓。"
		""
		"它会掉落三到五个&eWildfire Crown Fragments&r。"
	]
	quest.41B9176E3923BCF0.quest_subtitle: "野火燎原"
	quest.41B9176E3923BCF0.title: "像扔垃圾一样扔下它，趁热打铁"
	quest.41BE80B87D19EAAC.quest_desc: [
		"An &eME Interface&r keeps items stocked for machines and accepts anything pushed into it."
	]
	quest.41BE80B87D19EAAC.quest_subtitle: "网络的正门入口"
	quest.41BE80B87D19EAAC.title: "ME 接口"
	quest.41C1326C2C9ECEBC.quest_desc: [
		"锻造需要 &eAllthemodium 锻造模板&r。在远古城市寻找 &e可疑的黏土&r 并刷取。"
		""
		"找到一个了吗？用七个下界合金锭和深板岩合成，就能得到两个回来。"
	]
	quest.41C1326C2C9ECEBC.quest_subtitle: "刷取深暗之地的方块"
	quest.41C1326C2C9ECEBC.title: "Allthemodium 模板"
	quest.41EC23265DA036D6.quest_desc: [
		"木板围成的圈里放个山羊角，就能做出&e山羊奖杯&r挂在墙上。其他生物也有奖杯，EMI会显示所有奖杯。"
		""
		"一幅画和一个金锭可以制作一个&e华丽画作&r。"
	]
	quest.41EC23265DA036D6.quest_subtitle: "小小的炫耀一下自己吧"
	quest.41EC23265DA036D6.title: "奖杯和画作"
	quest.41F4D04379406896.quest_desc: [
		"用小麦种子和八个 Inferium Essence 可以制作 &eInferium Seeds&r。它们可以在任何农田上生长并掉落 essence。"
		""
		"&6注意：&r资源作物无法用骨粉催熟，且只能在精华农田上掉落第二颗种子。"
	]
	quest.41F4D04379406896.quest_subtitle: "让你的精华茁壮成长"
	quest.41F4D04379406896.title: "Inferium 种子"
	quest.41F7A29B2D734568.quest_desc: [
		"&e幻影轨道&r在你未持有它时不可见，并且适用于所有轨道类型。"
		"&e末地轨道&r由末地石砖板制成。"
	]
	quest.41F7A29B2D734568.quest_subtitle: "诡异的轨道"
	quest.41F7A29B2D734568.title: "幻影与末影的踪迹"
	quest.421B8AFD24858EBE.quest_desc: [
		"大多数结构配方都使用 Prefab 的批量材料："
		"九根原木合成一个&e木料捆&r。九块石头合成&e压缩石&r，可再压缩两次。砖块、泥土、萤石和灯笼的压缩方式相同。"
	]
	quest.421B8AFD24858EBE.quest_subtitle: "压缩并捆绑在一起了"
	quest.421B8AFD24858EBE.title: "建筑材料"
	quest.421EB19B5E942BD9.quest_desc: [
		"Ignis 会掉落 &eIgnitium 锭&r。留几个备用，Tier 3 需要它们。"
	]
	quest.421EB19B5E942BD9.quest_subtitle: "从火焰中掠夺战利品"
	quest.421EB19B5E942BD9.title: "Ignitium"
	quest.42255B27CF0DEF5F.quest_desc: [
		"将&e树液提取器&r朝向原木放置，它会缓慢地从木材中抽出&e乳胶&r。"
		""
		"&6提示：&r金合欢和木麻黄原木产量最高。原木偶尔会用完，所以留一棵备用树。"
	]
	quest.42255B27CF0DEF5F.quest_subtitle: "树木汁液"
	quest.42255B27CF0DEF5F.title: "树木流体提取器"
	quest.42379BCA31FD3F68.quest_desc: [
		"&e陀螺仪装置&r通过分步组装制作：从铁板开始，分5个步骤依次放置齿轮、轴等组件。"
		""
		"你需要它来制作万向节、智能螺旋桨和直升机轴承。"
	]
	quest.42379BCA31FD3F68.quest_subtitle: "旋转的大脑"
	quest.42379BCA31FD3F68.title: "陀螺仪机制"
	quest.423CD8385A79527A.quest_desc: [
		"两颗钻石、木板和一个&e钻石之心&r可以制作一个&ePickarang&r。"
		""
		"投掷后，它会挖掘所触碰的任何方块，并携带掉落物飞回。挖掘效率如同钻石镐，能处理木头和泥土，并且支持附魔。"
	]
	quest.423CD8385A79527A.quest_subtitle: "一把可以投掷的镐子"
	quest.423CD8385A79527A.title: "Pickarang"
	quest.42409A5A356FB2B7.quest_desc: [
		"A &eBackpack&r is one of the best early crafts in the pack. It's mostly leather and a chest (EMI has the grid)."
		""
		"自动拾取和磁铁等升级功能会稍后加入。请参阅&e存储&r章节。"
	]
	quest.42409A5A356FB2B7.quest_subtitle: "永远都不够用的物品栏空间"
	quest.42409A5A356FB2B7.title: "口袋，已升级"
	quest.425381B084545B3C.quest_desc: [
		"青铜地牢埋在岛屿内部。里面的&e滑块&r只会受到镐的伤害。"
		""
		"青铜钥匙可以打开宝箱。"
	]
	quest.425381B084545B3C.quest_subtitle: "像个大佬一样"
	quest.425381B084545B3C.title: "青铜地牢"
	quest.426682407A81819B.quest_desc: [
		"当物品数量超过或低于设定值时，&eME Level Emitter&r会发出红石信号。非常适合用于机器的开关控制。"
	]
	quest.426682407A81819B.quest_subtitle: "会计数的红石电路"
	quest.426682407A81819B.title: "等级发射器"
	quest.428E2212B67CADC8.quest_desc: [
		"竹子和地毯可以制作一个&e午餐篮&r。它有六个食物格，可以像野餐篮一样放置。"
	]
	quest.428E2212B67CADC8.quest_subtitle: "随时随地享用零食"
	quest.428E2212B67CADC8.title: "午餐篮"
	quest.42927BCA2A5C2F72.quest_desc: [
		"阿尔法雪怪皮毛可以制作雪怪盔甲，能冷却任何击中你的东西。先从夹克开始。"
	]
	quest.42927BCA2A5C2F72.quest_subtitle: "温暖而坚韧"
	quest.42927BCA2A5C2F72.title: "雪怪盔甲"
	quest.42983968595886EE.quest_desc: [
		"Find the Labyrinth in the swamp, beat the Minoshroom, and eat its &eMeef Stroganoff&r."
		""
		"是的，真的。暮色森林就是这样知道你在这里已经完成了任务。"
	]
	quest.42983968595886EE.quest_subtitle: "牛肉，但要换成菌菇的"
	quest.42983968595886EE.title: "迷宫 The Labyrinth"
	quest.42D9566151F58324.quest_desc: [
		"塑料、铁和红石。升级模块可叠加：输入、输出、分解、丢弃等。"
	]
	quest.42D9566151F58324.quest_subtitle: "塑料传送带"
	quest.42D9566151F58324.title: "传送带系统"
	quest.42DC943F802A0507.quest_desc: [
		"木板和小麦可以制作一个&e喂食槽&r。填满食物后，附近的动物会自行进食并繁殖。"
		""
		"围栏已满时它不会繁殖，也不会给予经验值。"
	]
	quest.42DC943F802A0507.quest_subtitle: "自助式繁殖系统"
	quest.42DC943F802A0507.title: "喂食槽"
	quest.42FD794B11C99611.quest_desc: [
		"灌注室不仅能产生源宝石。在它周围（1格内）放置带有物品的&e神秘基座&r，它就会产生&e精华&r。"
		""
		"它能从最多2格远的罐子中吸取源，所以把满罐子放在旁边。"
	]
	quest.42FD794B11C99611.quest_subtitle: "基座会改变配方"
	quest.42FD794B11C99611.title: "Imbuement, 更深层的灌注"
	quest.4326F017638FB91A.quest_desc: [
		"&e四叶草&r很稀有。丛林神庙的宝箱是你的最佳选择。"
	]
	quest.4326F017638FB91A.quest_subtitle: "四片叶子"
	quest.4326F017638FB91A.title: "这次运气更好了"
	quest.433B41E6AF6E7320.quest_desc: [
		"在末地的外围岛屿上，&e末地荒野&r生长着&e虚空&r树和&e末地花&r。"
		""
		"&e末地珊瑚礁&r和&e末地腐化&r也存在于外头。"
	]
	quest.433B41E6AF6E7320.quest_subtitle: "世界尽头的荒野之地"
	quest.433B41E6AF6E7320.title: "Empyreal"
	quest.436E1E7820FECC69.quest_desc: [
		"九个锭可以合成一个&eDraconium Block&r。Wyvern 注射器和一些机器需要整块，所以多备一些。"
	]
	quest.436E1E7820FECC69.quest_subtitle: "存储和所需材料"
	quest.436E1E7820FECC69.title: "Draconium 方块"
	quest.4395C5F867A930B1.quest_desc: [
		"&eVanilla Backport&r 将新版 Minecraft 的功能引入 ICU：包括 &ePale Garden&r 及其中的 Creaking、树脂、野花、落叶、萤火虫灌木、温冷农场动物、彩色鸡蛋、包裹和 &eSulfur Caves&r。"
		""
		"新地形只会出现在你尚未探索的区块中。"
		""
		"&6注意：&r在ICU中，&c快乐幻翼&r已被禁用，硫磺立方体也不会自行生成（它们会导致卡顿）。你仍然可以制作硫磺立方体，详见本章末尾。"
	]
	quest.4395C5F867A930B1.quest_subtitle: "后续版本的功能，在 1.21.1 中"
	quest.4395C5F867A930B1.title: "更新后的我的世界"
	quest.43A6C8DD5DC86061.quest_desc: [
		"下界的&e晶洞峡谷&r里充满了玫瑰石英。打破晶簇可获得&e玫瑰石英块&r。四块可合成一个方块。"
		""
		"&6Heads up:&r thanks to Create O' Plenty, two chunks in a &eheated&r Mixer make one Create &eRose Quartz&r, no redstone needed."
	]
	quest.43A6C8DD5DC86061.quest_subtitle: "晶体深渊 (The Crystalline Chasm)"
	quest.43A6C8DD5DC86061.title: "粉色水晶"
	quest.43B1CC24CEDD8B82.quest_desc: [
		"&e冰石&r产自岛屿岩石。它为冷冻机提供燃料（寒石、冰石和天根木板）。"
		""
		"冷冻器能将水变成冰，并制作冰冻配饰。"
	]
	quest.43B1CC24CEDD8B82.quest_subtitle: "冷若冰霜"
	quest.43B1CC24CEDD8B82.title: "冷冻柜"
	quest.43D05CDE14F41866.quest_desc: [
		"冻结一个铁戒指和一个铁吊坠（或金制的）来获得一个&e冰戒指&r和&e冰吊坠&r。"
		""
		"将它们佩戴在配饰栏中，即可冻结脚下的水和岩浆。"
	]
	quest.43D05CDE14F41866.quest_subtitle: "在水上行走"
	quest.43D05CDE14F41866.title: "酷炫珠宝"
	quest.440048CBB9219CB6.quest_desc: [
		"一个可容纳更多模式的模式提供器。在晶体合成器中制作。"
	]
	quest.440048CBB9219CB6.quest_subtitle: "更多物品栏格子"
	quest.440048CBB9219CB6.title: "扩展模式提供者 (Extended Pattern Provider)"
	quest.44091CE7A21807E7.quest_desc: [
		"&e太阳能发电机&r需要清晰的天空视野。夜间或下雨时无法供电。"
	]
	quest.44091CE7A21807E7.quest_subtitle: "免费电力，仅限白天使用"
	quest.44091CE7A21807E7.title: "太阳能发电机"
	quest.441AA02D7CCA3B53.quest_desc: [
		"右键点击精华与农田，或将它们一起合成，以获得&e精华农田&r。"
		""
		"作物在任何等级都有10%的几率掉落第二个种子，在其自身等级另有10%的几率。Inferium种子在更高等级会掉落更多精华。"
	]
	quest.441AA02D7CCA3B53.quest_subtitle: "改良泥土"
	quest.441AA02D7CCA3B53.title: "精粹农田"
	quest.443D2035E3C9806B.quest_desc: [
		"&eNexus&r 埋藏在地下，并不常见。找到一个可是一项了不起的成就。"
	]
	quest.443D2035E3C9806B.quest_subtitle: "地下且稀有"
	quest.443D2035E3C9806B.title: "枢纽（The Nexus）"
	quest.44604F7C65D19313.quest_desc: [
		"Biomes O' Plenty 的沙子也能做成砂纸。 &e黑砂纸&r 的抛光效果和普通砂纸一样。"
		""
		"住在火山附近而不是海滩的话，会更方便。"
	]
	quest.44604F7C65D19313.quest_subtitle: "创造 O' Plenty 的繁荣"
	quest.44604F7C65D19313.title: "彩色砂纸"
	quest.446ACC3FCAD521FC.quest_desc: [
		"在蓝色气流云上弹跳，然后用四个冷气流云制作一个&e冷降落伞&r。"
		""
		"从岛屿上坠落时会自动打开。黄金气流云可以重复使用。"
	]
	quest.446ACC3FCAD521FC.quest_subtitle: "优雅地坠落吧"
	quest.446ACC3FCAD521FC.title: "Parachutes"
	quest.447FE638CE6F40AC.quest_desc: [
		"ICU 会追踪口渴和饥饿。直接饮用河流和湖泊的水会让你生病。"
		""
		"饮用前请煮沸或过滤水。《食物与农业》中的&e保持水分&r章节会教你如何操作。"
	]
	quest.447FE638CE6F40AC.quest_subtitle: "是的，你在这里会感到口渴"
	quest.447FE638CE6F40AC.title: "保持水分充足"
	quest.44D364763184C8A5.quest_desc: [
		"一个神秘祭坛、一个源宝石块和三个金锭可以制作一个&e仪式火盆&r。"
		""
		"用远古木原木和其他物品制作仪式石板，然后用石板右键火盆即可启动。先试试&e日出&r：一个燃烧的远古木原木和一朵向日葵。"
	]
	quest.44D364763184C8A5.quest_subtitle: "强大的魔法，缓慢燃烧"
	quest.44D364763184C8A5.title: "仪式祭坛"
	quest.44D854FD70188397.quest_desc: [
		"&e燃料箱&r和&e便携式燃料接口&r可在车站为火车加油。"
		""
		"ICU 默认关闭了现实燃料，所以火车可以免费运行。如果服务器开启此功能，这些燃料将生效。"
	]
	quest.44D854FD70188397.quest_subtitle: "以防万一"
	quest.44D854FD70188397.title: "燃料箱"
	quest.44E76C0571FD6A3F.quest_desc: [
		"&e能量立方&r蕴含着能量，可以为所在槽位的物品充能。"
		""
		"使用 Configurator 选择要输出能量的方向。"
	]
	quest.44E76C0571FD6A3F.quest_subtitle: "储存你的能量"
	quest.44E76C0571FD6A3F.title: "基础能量立方体"
	quest.44ED09D90B85536D.quest_desc: [
		"Flux Dust、obsidian 和 Eye of Ender 可以制作 &eFlux Core&r。Core 和 dust 可以制作 &eFlux Blocks&r。"
	]
	quest.44ED09D90B85536D.quest_subtitle: "建筑材料方块"
	quest.44ED09D90B85536D.title: "Flux Core 和 Flux Block"
	quest.44F87A2F0011C0F3.quest_desc: [
		"&eRift Drive&r 会驱动它所搭载的飞船。它只能跃迁到标有 &eWarp Anchor&r 的地方（或通过 Rift Probe 找到）。"
		""
		"Mk II 和 Mk III 驱动器能走得更远。在 EMI 中查看升级内容。"
	]
	quest.44F87A2F0011C0F3.quest_subtitle: "交战！"
	quest.44F87A2F0011C0F3.title: "裂隙驱动装置"
	quest.44FB39FBC666F76C.quest_desc: [
		"水车轮由处理过的木材和木棍制成；用四根木棍围绕一个钢锭即可制作。"
		""
		"把它安装在发电机上，让水流流过它。"
	]
	quest.44FB39FBC666F76C.quest_subtitle: "河流是免费的能源"
	quest.44FB39FBC666F76C.title: "水车"
	quest.44FCFA412DD78BFB.quest_desc: [
		"简易绿宝石有三种锻造模板，每种配方可制作四个："
		"&e工具&r（金围绕紫水晶碎片）、&e剑&r（铁围绕红宝石）和&e弓&r（青金石围绕祖母绿）。"
		""
		"在锻造台，铁镐加绿宝石变成绿宝石镐，再加红宝石变成红宝石镐。剑也是如此。锻造会保留附魔，所以你喜爱的工具会一同保留。"
	]
	quest.44FCFA412DD78BFB.quest_subtitle: "保留你的附魔效果不变"
	quest.44FCFA412DD78BFB.title: "锻造升级（Smithing Upgrades）"
	quest.4545D62D18C31FB5.quest_desc: [
		"&e手推车&r是一种现成的小型火车。把它放在轨道上，然后开始推。用扳手把它拿起来。"
	]
	quest.4545D62D18C31FB5.quest_subtitle: "自己动手丰衣足食"
	quest.4545D62D18C31FB5.title: "手推车"
	quest.455974A1DA70C6AE.quest_desc: [
		"铁粒上的火把能制作成壁灯&eSconce&r。铁锭上的蜡烛能制作成&eCandle Holder&r，并且可以堆叠。"
		""
		"还有灵魂、末地和发光版本。在EMI中查看套装。"
	]
	quest.455974A1DA70C6AE.quest_subtitle: "氛围照明"
	quest.455974A1DA70C6AE.title: "壁灯和蜡烛"
	quest.456F01254E54664C.quest_desc: [
		"源宝石周围的铁粒能合成&e暗淡饰品&r。在附魔台用钻石和源宝石合成，则能制成&e法力增幅护符&r。"
		""
		"&e潜力戒指&r（宝石周围环绕八个原矿）是戒指的基础。"
	]
	quest.456F01254E54664C.quest_subtitle: "戒指和护身符"
	quest.456F01254E54664C.title: "小饰品"
	quest.459793567C11C6B4.quest_desc: [
		"&eMV Wire Coils&r 是电金线。使用 &eTransformer&r 将 LV 线路连接到 MV 线路。"
		""
		"MV 蓄电器的容量比 LV 蓄电器大多了。"
	]
	quest.459793567C11C6B4.quest_subtitle: "现在有了电金（Electrum）"
	quest.459793567C11C6B4.title: "MV 动力"
	quest.459A90909F7A545C.quest_desc: [
		"由树苗和原木环绕的罗盘。选择一个生物群系，它就会指向方向。"
	]
	quest.459A90909F7A545C.quest_subtitle: "找到任意一个生物群系"
	quest.459A90909F7A545C.title: "自然指南针"
	quest.45AB1D5A120A6DC3.quest_desc: [
		"三颗宝石和两根木棍。 &e挖掘机&r 能挖掘 3x3 范围内的泥土、沙子和砾石。潜行可一次挖掘一个方块。"
		""
		"非常适合为大型建筑清理空间。"
	]
	quest.45AB1D5A120A6DC3.quest_subtitle: "铲子版本"
	quest.45AB1D5A120A6DC3.title: "挖掘机"
	quest.45C04E577C9E321A.quest_desc: [
		"ICU's recipe: three Supremium Essence, an Infusion Crystal and an &eUnobtainium Nugget&r."
		""
		"Insanium 农田和顶级作物需要它。这是第 5 级。"
	]
	quest.45C04E577C9E321A.quest_subtitle: "神秘农业扩展，ICU 风格"
	quest.45C04E577C9E321A.title: "Insanium"
	quest.45E164E02113266C.quest_desc: [
		"主世界变得更热闹了：桦树林和草地里的&e野花&r，森林地面的&e落叶层&r，还有沼泽和水边生长的&e萤火虫灌木&r。"
		""
		"野花可以制作&e黄色染料&r。"
	]
	quest.45E164E02113266C.quest_subtitle: "花朵、树叶和萤火虫"
	quest.45E164E02113266C.title: "焕发生机"
	quest.46049D9F3BDF94A1.quest_desc: [
		"将&e机械收割机&r放在移动装置上，让它们扫过你的作物。它们会收割并重新种植。"
		""
		"&e机械犁&r也能以同样的方式翻耕泥土。"
	]
	quest.46049D9F3BDF94A1.quest_subtitle: "能自动收割的农作物"
	quest.46049D9F3BDF94A1.title: "自动化农场"
	quest.460D09076672BC51.quest_desc: [
		"高压蓄能器、中压线圈、钢和高级电子元件。它能发射钢棒，打击力极强。"
		""
		"这只是个锦上添花，并非硬性要求。"
	]
	quest.460D09076672BC51.quest_subtitle: "磁铁，不过是暴力的磁铁"
	quest.460D09076672BC51.title: "轨道炮"
	quest.461D8E8157E7B539.quest_desc: [
		"Unobtainium 矿石需要 Vibranium 镐才能开采。"
	]
	quest.461D8E8157E7B539.quest_subtitle: "再做一个稿子，我保证的"
	quest.461D8E8157E7B539.title: "振金镐"
	quest.46239920EC0077EC.quest_desc: [
		"高地遍布着巨魔洞穴。巨魔会投掷石头，有时会掉落&e魔法豆&r。"
		""
		"在洞穴里击败一只巨魔。"
	]
	quest.46239920EC0077EC.quest_subtitle: "注意头顶空间，小心撞到头"
	quest.46239920EC0077EC.title: "巨魔洞穴"
	quest.4680CB1ACD925829.quest_desc: [
		"将红石块、流质晶体和萤石粉投入水中，可获得两个 &e红石晶体&r。在充电器中为其充能。"
		""
		"为铁块充能会获得&eInscriber Energy Press&r。它会将 Charged Redstone 打印到 &eEnergy Processor&r 的电路中。"
	]
	quest.4680CB1ACD925829.quest_subtitle: "Applied Flux 的建筑材料"
	quest.4680CB1ACD925829.title: "带电红石"
	quest.4695EC9A3E0E8C5D.quest_desc: [
		"两个&eIgnitium Ingot&r、下界砖、烈焰棒和一个盾牌。"
		""
		"&6注意：&rIgnitium 还能制作 Niotic Crystals 和 Supreme Machine Frame。规划好你的锭吧。"
	]
	quest.4695EC9A3E0E8C5D.quest_subtitle: "Ignitium 护盾"
	quest.4695EC9A3E0E8C5D.title: "火焰堡垒"
	quest.46D33D0A399F4FAE.quest_desc: [
		"在时间耗尽前，把吹嘘之杖交给雕塑家，并爬上他的柱子。"
		""
		"通过即可获得&e大地崩裂手套&r：举起巨石、挖掘隧道、骑上土柱。"
	]
	quest.46D33D0A399F4FAE.quest_subtitle: "雕塑家的挑战"
	quest.46D33D0A399F4FAE.title: "大地崩裂手套"
	quest.46F7B49C00D8DE04.quest_desc: [
		"用渡鸦羽毛、火炬浆果和萤石粉制作一个&e魔法地图焦点&r，然后用纸将其环绕。"
		""
		"使用空白地图，它会显示附近的群系和所有首领结构。渡鸦会掉落羽毛，洞穴里挂着火炬浆果。"
	]
	quest.46F7B49C00D8DE04.quest_subtitle: "所有东西都去哪儿了？"
	quest.46F7B49C00D8DE04.title: "暮色森林的地图"
	quest.4700CE40E54B95A1.quest_desc: [
		"锌矿石出现在主世界的地下。用创造引擎将其粉碎以提高产量，然后进行冶炼。"
		""
		"黄铜是铜加锌，在加热过的盆中混合而成。"
	]
	quest.4700CE40E54B95A1.quest_subtitle: "黄铜的另一半部分"
	quest.4700CE40E54B95A1.title: "锌"
	quest.470A38663B30012A.quest_desc: [
		"右键点击黄铜外壳，使用&e坚固的钢板&r制作&e火车外壳&r。"
		""
		"车站、信号、转向架和控制都由此开始。"
	]
	quest.470A38663B30012A.quest_subtitle: "每列火车都从这里出发"
	quest.470A38663B30012A.title: "火车外壳"
	quest.4711353E32F1C6EA.quest_desc: [
		"&eReprocessor&r 多块结构能将青金石和水转化为 &eBlutonium&r，这是一种第二种反应堆燃料。"
		""
		"在EMI中查看控制器和外壳的配方。"
	]
	quest.4711353E32F1C6EA.quest_subtitle: "将废料转化为新燃料"
	quest.4711353E32F1C6EA.title: "再处理器"
	quest.47213C63446F59AF.quest_desc: [
		"在装置上有四颗源宝石的任何种子都会变成&e魔花种子&r。种植它，收割花朵，然后将每朵都制成&e魔花纤维&r。"
		""
		"纤维可以制作成长袍、线、羊皮纸等等。多种一大片吧。"
	]
	quest.47213C63446F59AF.quest_subtitle: "魔法棉花"
	quest.47213C63446F59AF.title: "Magebloom"
	quest.472F511D5EE8E0B3.quest_desc: [
		"一个&e能量柱&r将核心与外界相连。将其放置在核心附近，并在输入和输出之间切换。"
		""
		"将电力从发电机输入，再输出到机器中。"
	]
	quest.472F511D5EE8E0B3.quest_subtitle: "输入功率，输出功率"
	quest.472F511D5EE8E0B3.title: "能量金字塔"
	quest.475778C203BA475A.quest_desc: [
		"每个电源都有&e压力容量&r，每台机器都有&e压力影响&r。一旦超出，整个网络就会停止。"
		""
		"&e压力计&r会显示你的接近程度。速度越快，压力越大，所以不要过度加速旋转。"
	]
	quest.475778C203BA475A.quest_subtitle: "知道自己的极限在哪里"
	quest.475778C203BA475A.title: "压力测试"
	quest.47826E103BBB86F7.quest_desc: [
		"需要一个&e精英控制电路&r。八个原矿石加一个鹅卵石可以制作一个原矿石块。"
		""
		"何必呢？原矿块在加工线上能全额加值，原矿不行。"
	]
	quest.47826E103BBB86F7.quest_subtitle: "原矿石中的矿石方块"
	quest.47826E103BBB86F7.title: "组合器"
	quest.4795EECBFDD9861E.quest_desc: [
		"&e化学结晶器&r将干净的浆料转化为&e晶体&r。它们会进入注射室，并沿4x线路向下输送。"
		""
		"每个矿石块需要五个锭。在每个阶段都放置工厂和升级。"
	]
	quest.4795EECBFDD9861E.quest_subtitle: "完整的矿石系列！"
	quest.4795EECBFDD9861E.title: "5x：水晶块"
	quest.47ABFBDD5262046B.quest_desc: [
		"在村庄中找到一个&eGoddess Statue&r，用4个Spirit Orb换取额外的&eHeart Container&r或&eStamina Vessel&r。"
		""
		"耐力越高，滑翔和冲刺的距离就越远。"
	]
	quest.47ABFBDD5262046B.quest_subtitle: "祈求力量降临于你身上"
	quest.47ABFBDD5262046B.title: "女神雕像"
	quest.47B4A42005A7B8C8.quest_desc: [
		"&ePowah Wrench&r有三种模式：&eConfig&r（电缆侧）、&eLink&r（杆件到球体）和&eRotate&r。"
	]
	quest.47B4A42005A7B8C8.quest_subtitle: "三种工具合为一件"
	quest.47B4A42005A7B8C8.title: "Powah 扳手"
	quest.47C87CC01C7C7108.quest_desc: [
		"催化剂需要基岩、一个晶体矩阵锭、一个中子锭、一些非常奇怪的食物、一个末地珍珠和一个唱片碎片。"
		""
		"检查EMI，尽早开始收集。"
	]
	quest.47C87CC01C7C7108.quest_subtitle: "所有剩下的东西都收集起来"
	quest.47C87CC01C7C7108.title: "Infinity催化剂"
	quest.47CACE50ADFAAF37.quest_desc: [
		"&e操控&r：按钮、红石、时钟。 &e净化&r：发酵蜘蛛眼、糖、牛奶桶。 &e空气&r需要羽毛、箭和&e野性之翼&r。"
		""
		"Manipulation Essence 还能将 Archwood 树苗变为下一种颜色。"
	]
	quest.47CACE50ADFAAF37.quest_subtitle: "操控术、防护术、空气元素"
	quest.47CACE50ADFAAF37.title: "陌生人精华（Stranger Essences）"
	quest.48376C06BD8C43E2.quest_desc: [
		"一个用三种尘埃、钻石和铁装饰的普通箱子。它也是冷凝器的一部分。"
	]
	quest.48376C06BD8C43E2.quest_subtitle: "一个怀有抱负的箱子"
	quest.48376C06BD8C43E2.title: "炼金术士的箱子"
	quest.4844368205CCFD96.quest_desc: [
		"一个&e反物质颗粒&r需要大量的钋和耐心。保持SPS的充足供应。"
	]
	quest.4844368205CCFD96.quest_subtitle: "Mekanism 中最稀有的东西"
	quest.4844368205CCFD96.title: "反物质颗粒"
	quest.4883B2B848641D54.quest_desc: [
		"一本书加上萤石粉、燧石或安布罗西乌姆碎片可以制作一本&e知识之书&r。将任何物品放入其中，即可阅读其用途。"
	]
	quest.4883B2B848641D54.quest_subtitle: "问问这本书"
	quest.4883B2B848641D54.title: "传说之书 (Book of Lore)"
	quest.489E930DD18A213B.quest_desc: [
		"一个大型储罐，底部装有&eBoiler Casing&r和&eSuperheating Elements&r，上方有一层&ePressure Disperser&r。"
		""
		"用电阻加热器或超热钠加热，泵入水，就能抽出&e蒸汽&r。"
	]
	quest.489E930DD18A213B.quest_subtitle: "将热量转化为蒸汽"
	quest.489E930DD18A213B.title: "热电锅炉"
	quest.48A040AAB9BFA848.quest_desc: [
		"&e组件&r由黑铁板、发光物质和两种材料制成：铁制基础、金制高级、钻石制精英、祖母绿制终极。"
		""
		"用四个组件围绕一个黑铁锭，即可制作出对应的&e催化剂&r。"
	]
	quest.48A040AAB9BFA848.quest_subtitle: "建造所需的方块材料"
	quest.48A040AAB9BFA848.title: "组件和催化剂"
	quest.48A503B53835B9E5.quest_desc: [
		"铀矿石深藏地下。为矿石充能可获得额外的铀矿石，或者将原矿石冶炼。"
		""
		"提示：Mekanism 的 &e铀锭&r也可以被转化为铀矿。"
	]
	quest.48A503B53835B9E5.quest_subtitle: "散发着绿光的岩石"
	quest.48A503B53835B9E5.title: "铀矿石"
	quest.48A7304D769B78EA.quest_desc: [
		"The &eSPS&r is a multiblock of &eSPS Casing&r with &eSPS Ports&r and a &eSupercharged Coil&r to power it."
		""
		"它消耗大量能量将钋转化为&e反物质&r。将反物质结晶成颗粒。"
	]
	quest.48A7304D769B78EA.quest_subtitle: "制造反物质（Making antimatter）"
	quest.48A7304D769B78EA.title: "超临界相移器"
	quest.48BCD9F370D9142F.quest_desc: [
		"&eFactory Gauges&r 监控你的库存网络，订购材料以保持配方充足。"
		""
		"把它们连起来，你的工厂就会自己规划好。"
	]
	quest.48BCD9F370D9142F.quest_subtitle: "保持库存充足"
	quest.48BCD9F370D9142F.title: "工厂仪表板"
	quest.48E16A18186AF8B2.quest_desc: [
		"Prosperity Ore 位于更深处，Y 坐标 -60 到 24 之间。熔炼或挖掘可获得 &eProsperity Shards&r。"
		""
		"铁锭周围的碎片可制成繁荣锭；钻石周围的碎片可制成繁荣宝石。"
	]
	quest.48E16A18186AF8B2.quest_subtitle: "闪闪发光的东西"
	quest.48E16A18186AF8B2.title: "繁荣碎片"
	quest.48E35DB2677229AD.quest_desc: [
		"Iron and Steel &eMechanical Components&r are plates around a copper ingot."
		""
		"&6提示：&r合成网格需要4个板，但带有组件蓝图的合成台只需要2个。请使用蓝图。"
	]
	quest.48E35DB2677229AD.quest_subtitle: "箱子里的齿轮"
	quest.48E35DB2677229AD.title: "机械组件"
	quest.48F12CFF93FFEF74.quest_desc: [
		"盛宴以方块形式放置。用碗右键即可上菜。"
		""
		"&e烤鸡&r：熟鸡肉、面包、一个鸡蛋、一个洋葱、两根胡萝卜、两个烤土豆和一个碗。"
	]
	quest.48F12CFF93FFEF74.quest_subtitle: "一场适合全队的盛宴"
	quest.48F12CFF93FFEF74.title: "烤鸡 Roast Chicken"
	quest.491EC3146461B5BA.quest_desc: [
		"每个层级都由三个低一级别的组件和一个累积处理器组成。"
		""
		"保存一些 &e16M 组件&r：ICU 的 64M 配方会消耗它们。"
	]
	quest.491EC3146461B5BA.quest_subtitle: "继续堆叠下去，不要停手"
	quest.491EC3146461B5BA.title: "MEGA 4M 和 16M"
	quest.495F1F41B3F824A9.quest_desc: [
		"黏土和铁锭可以制作&e介电棒&r。介电棒和铁可以制作&e介电外壳&r。"
		""
		"黏土、铁和红石块可以制作一个&e基础电容器&r。几乎所有机器都需要这两种材料。"
	]
	quest.495F1F41B3F824A9.quest_subtitle: "建造所需的方块材料"
	quest.495F1F41B3F824A9.title: "外壳与电容器"
	quest.497B79779405D3C5.quest_desc: [
		"制作一本&e初级魔法书&r来开始学习Ars Nouveau。它的指南《残破的卷轴》会解释一切。"
	]
	quest.497B79779405D3C5.quest_subtitle: "科技并非万能的一切"
	quest.497B79779405D3C5.title: "一点小魔法"
	quest.497DCDE10A038ED6.quest_desc: [
		"&e亡灵法师尖塔&r矗立在末地。听起来和实际一样不友好。"
	]
	quest.497DCDE10A038ED6.quest_subtitle: "在末地，气氛诡异，令人毛骨悚然"
	quest.497DCDE10A038ED6.title: "亡灵法师的尖塔"
	quest.499805E5D2A31A46.quest_desc: [
		"一个&e包裹&r（皮革上的字符串）在一个槽位中存放着一堆混合物品。"
		""
		"用16种颜色中的任意一种染色。"
	]
	quest.499805E5D2A31A46.quest_subtitle: "一个用于存放袋子的袋子"
	quest.499805E5D2A31A46.title: "捆绑包"
	quest.49BB8557ED42F0E9.quest_desc: [
		"&e基础电机&r将电能转化为旋转。用扳手可改变其速度，应力输出保持不变。"
		""
		"红石信号可以关闭它。马达让你能用电线而不是长长的传动轴来输送动力。"
	]
	quest.49BB8557ED42F0E9.quest_subtitle: "将力量注入旋转之中"
	quest.49BB8557ED42F0E9.title: "电动马达"
	quest.49D2DF6F2329E5AA.quest_desc: [
		"苔、沙、深板岩、黑石、末地、下界、海晶、紫晶和泥砖路标都适用相同规则。"
		"它们每一个也都是机械合成台的配方。挑一个你最喜欢的吧。"
	]
	quest.49D2DF6F2329E5AA.quest_subtitle: "与你的建筑相匹配"
	quest.49D2DF6F2329E5AA.title: "Waystone 风格"
	quest.49DFCE578716FE71.quest_desc: [
		"击败守卫者后，打破岛屿中央的大型&e混沌水晶&r以获取&e混沌碎片&r。"
		""
		"碎片可以合成成残片。你需要这两种材料。"
	]
	quest.49DFCE578716FE71.quest_subtitle: "岛屿上的战利品"
	quest.49DFCE578716FE71.title: "混沌碎片"
	quest.4A134060B05BAF95.quest_desc: [
		"The &6Main Path&r is the spine: five tiers, one ladder."
		""
		"其余内容都分在左边的类别里：&e科技&r、&e魔法&r、&e探索与首领&r、&e食物与农场&r、&e存储与物流&r和&e船只与飞行&r。想什么时候探索哪个都行。"
	]
	quest.4A134060B05BAF95.quest_subtitle: "章节列表，解释说明"
	quest.4A134060B05BAF95.title: "寻找你的方向感"
	quest.4A24C56E6AD4231A.quest_desc: [
		"使用 &e/ftbteams party create <name>&r 创建队伍，然后用 &e/ftbteams party invite <player>&r 邀请好友加入。"
		""
		"团队中所有人的任务进度是共享的。"
	]
	quest.4A24C56E6AD4231A.quest_subtitle: "更多双手，更多机器"
	quest.4A24C56E6AD4231A.title: "与朋友一起玩耍"
	quest.4A2CE103E6AA2685.quest_desc: [
		"当闪电击中&e瘟疫医生&r时，他会变成&c黑死病&r。"
		""
		"准备好迎接瘟疫和大量老鼠吧。"
	]
	quest.4A2CE103E6AA2685.quest_subtitle: "闪电和瘟疫面具"
	quest.4A2CE103E6AA2685.title: "黑死病（The Black Death）"
	quest.4A5B7628B26AD455.quest_desc: [
		"Create的&e强力胶水&r能用，而&e蜂蜜胶水&r专为船只打造。用Spout将铁板填满蜂蜜。"
		""
		"点击两个对角线可粘合一个盒子，按 Ctrl+滚轮可调整大小。蜂蜜胶水只会粘在模拟装置上，绝不会粘在普通移动装置上。"
	]
	quest.4A5B7628B26AD455.quest_subtitle: "粘性，但仅限船只使用"
	quest.4A5B7628B26AD455.title: "蜂蜜胶水"
	quest.4A6E62E52F7C833F.quest_desc: [
		"&e智能螺旋桨&r是一种紧凑的螺旋桨，可沿一个轴倾斜以朝上。"
		"一个配方能做出两个，所以很适合小型无人机和载重舱。"
	]
	quest.4A6E62E52F7C833F.quest_subtitle: "小巧且能自动保持水平"
	quest.4A6E62E52F7C833F.title: "智能螺旋桨"
	quest.4A7717BF96A25FA1.quest_desc: [
		"工匠、精密零件和库存网络。你已经见过整个创造工具箱了。"
		""
		"火车是下一个，扩展包章节里还有很多要建造的。"
	]
	quest.4A7717BF96A25FA1.quest_subtitle: "创造，征服"
	quest.4A7717BF96A25FA1.title: "首席工程师"
	quest.4A7D1CCC6ABDF0FE.quest_desc: [
		"燃烧竞技场是一个下界结构。探险家指南针可以为你指出方向。"
		""
		"进去前带上火焰抗性、食物和你最好的盔甲。"
	]
	quest.4A7D1CCC6ABDF0FE.quest_subtitle: "Ignis 正在里面等待着你"
	quest.4A7D1CCC6ABDF0FE.title: "找到燃烧竞技场 (Burning Arena)"
	quest.4A7DFA811ABFFF0F.quest_desc: [
		"建造一个&eImbuement Chamber&r，并用Lapis进行灌注以制作Source Gems。Source为Ars中的几乎所有事物提供能量。"
	]
	quest.4A7DFA811ABFFF0F.quest_subtitle: "魔法需要燃料来驱动"
	quest.4A7DFA811ABFFF0F.title: "源宝石"
	quest.4A82C69B3C53B7E5.quest_desc: [
		"基础反应堆最大为5x5x5，无法用水冷却。而&e加固&r反应堆可以做得很大。"
		""
		"&6注意：&r加固控制器需要在ICU里放入一个&eAllthemodium Ingot&r。"
	]
	quest.4A82C69B3C53B7E5.quest_subtitle: "（几乎）没有大小限制"
	quest.4A82C69B3C53B7E5.title: "加固反应堆 Reinforced Reactor"
	quest.4A85F8085E4D7AAA.quest_desc: [
		"ICU的配方将中间的钻石替换成了&e振金锭&r。"
	]
	quest.4A85F8085E4D7AAA.quest_subtitle: "现在有了额外的振金（Vibranium）"
	quest.4A85F8085E4D7AAA.title: "Draconium Core"
	quest.4ABC557E2942773E.quest_desc: [
		"五个小麦可以制作一个&e干草巢&r。把它放在鸡的附近。"
		""
		"16格内的鸡会走到巢里下蛋，而不是地上。一个巢最多可容纳6枚蛋。右键取出，或用漏斗抽取。比较器可读取巢的满度。"
	]
	quest.4ABC557E2942773E.quest_subtitle: "草丛里再也没有蛋了"
	quest.4ABC557E2942773E.title: "干草巢穴"
	quest.4ADF3056DDAC164B.quest_desc: [
		"地球仪无法合成。流浪商人用10个绿宝石出售，有时也会在沉船宝藏中出现。"
		""
		"右键旋转，还能显示坐标。古董墨水能把它变成复古的棕褐色地球仪。"
	]
	quest.4ADF3056DDAC164B.quest_subtitle: "把它转起来"
	quest.4ADF3056DDAC164B.title: "地球仪"
	quest.4AEFF7FBEB4E575C.quest_desc: [
		"站在&e最终高原&r上。这就是暮色森林故事的终点（暂时）。"
		""
		"干得真棒！"
	]
	quest.4AEFF7FBEB4E575C.quest_subtitle: "暮色森林，已通关"
	quest.4AEFF7FBEB4E575C.title: "高原之巅"
	quest.4AF449C7C1E7552C.quest_desc: [
		"&eLush Caves&r的杜鹃花树会生成真正的&eAzalea Logs&r，其中一些是&eFlowering Azalea&r。"
		""
		"两套全新的木材，直接来自洞穴。"
	]
	quest.4AF449C7C1E7552C.quest_subtitle: "杜鹃花木材"
	quest.4AF449C7C1E7552C.title: "繁茂木材"
	quest.4B240FED4FB30726.quest_desc: [
		"在奥布西迪尔竞技场里，一根怀有怨恨的黑曜石柱。"
	]
	quest.4B240FED4FB30726.quest_subtitle: "大规模毁灭的领主们"
	quest.4B240FED4FB30726.title: "Obsidilith"
	quest.4B47E4E9B9011CC3.quest_desc: [
		"Quark 调整了游戏中许多小细节，并添加了大量建筑方块、工具和装置。"
		""
		"本章挑选了有趣且实用的部分。此处的所有内容在ICU中均已启用。"
	]
	quest.4B47E4E9B9011CC3.quest_subtitle: "一堆小改进的集合包"
	quest.4B47E4E9B9011CC3.title: "Quark"
	quest.4B5D89400AAFDAFD.quest_desc: [
		"潜行并右键点击末地箱，使用&e末地袋&r复制其颜色。"
		"现在你可以在任何地方打开那个箱子了。"
	]
	quest.4B5D89400AAFDAFD.quest_subtitle: "你的口袋里的箱子，就在你的口袋里"
	quest.4B5D89400AAFDAFD.title: "末影袋"
	quest.4B66AE37B5112CBA.quest_desc: [
		"工程师护目镜加皮革可以制作&e飞行员护目镜&r。它们显示的信息完全一样，而且看起来很棒。"
		""
		"戴上护目镜，你就能看见螺旋桨的推力和气流。"
	]
	quest.4B66AE37B5112CBA.quest_subtitle: "风格和统计数据"
	quest.4B66AE37B5112CBA.title: "飞行员护目镜"
	quest.4B72DE48562957E4.quest_desc: [
		"&e炼油厂&r将植物油和乙醇混合成&e生物柴油&r。需要&e硝石&r作为催化剂。"
		""
		"装满一桶水来证明它有效。"
	]
	quest.4B72DE48562957E4.quest_subtitle: "油加上酒"
	quest.4B72DE48562957E4.title: "生物柴油"
	quest.4B794FD6B2EFED95.quest_desc: [
		"Inferium Essence、Prosperity Shards 和一颗钻石可以合成一个 &eInfusion Crystal&r。"
		""
		"It loses durability each time you use it to make a higher essence, so make a spare."
	]
	quest.4B794FD6B2EFED95.quest_subtitle: "精粹提升了一个等级"
	quest.4B794FD6B2EFED95.title: "灌注水晶 (Infusion Crystal)"
	quest.4B9CBE3A2989B34B.quest_desc: [
		"Tier 4 用 &e下界合金块&r 包裹 Tier 3 的堆叠升级。九个这样的方块可以合成 Omega 等级。"
		""
		"&6注意：&r下界合金太多了。等你的下界合金储备稳定了再存起来。"
	]
	quest.4B9CBE3A2989B34B.quest_subtitle: "巨量的普通砖块，真蠢"
	quest.4B9CBE3A2989B34B.title: "堆叠升级第4级"
	quest.4BA43A55BFA1F8B8.quest_desc: [
		"将你的 256M 组件放入一个 &e256M MEGA 物品存储单元&r。一个单元可以容纳一个小世界。"
	]
	quest.4BA43A55BFA1F8B8.quest_subtitle: "2.56亿字节"
	quest.4BA43A55BFA1F8B8.title: "一次非常巨大的驱动"
	quest.4BBC5D842BFD4EA7.quest_desc: [
		"将铁与碳融合两次得到钢粉，然后将其冶炼。 (IE 高炉也可以使用。)"
	]
	quest.4BBC5D842BFD4EA7.quest_subtitle: "Mekanism 风格"
	quest.4BBC5D842BFD4EA7.title: "更多钢铁"
	quest.4C12375BF72BB686.quest_desc: [
		"右键点击去皮的原木并使用安山合金，即可制作&e安山外壳&r。大多数早期机器都建在其上。"
		""
		"&6注意：&r在ICU中，Mekanism的&e冶金注入器&r需要安山岩外壳。请备一个备用。"
	]
	quest.4C12375BF72BB686.quest_subtitle: "万物的框架，一切的基础"
	quest.4C12375BF72BB686.title: "安山岩外壳"
	quest.4C356E5C1E1ECE5C.quest_desc: [
		"用 Inferium 锭和宝石升级的钻石胸甲。把套装的其他部分也做了吧。"
		""
		"完整的觉醒超合金套装会在你周围生长植物。"
	]
	quest.4C356E5C1E1ECE5C.quest_subtitle: "附带特殊效果的防护"
	quest.4C356E5C1E1ECE5C.title: "精粹盔甲"
	quest.4C4D7E0B552B62C4.quest_desc: [
		"&e加速器&r能让旅行者加速（或减速）。&e分流器&r可将线路分叉：用移动键来转向。"
	]
	quest.4C4D7E0B552B62C4.quest_subtitle: "更快，并且有多种选择"
	quest.4C4D7E0B552B62C4.title: "加速器和分裂器"
	quest.4C61D3469F6403BF.quest_desc: [
		"太阳精灵走了，你终于可以睡在以太里了。"
	]
	quest.4C61D3469F6403BF.quest_subtitle: "终于到了这一天，一切尘埃落定。"
	quest.4C61D3469F6403BF.title: "一场当之无愧的休憩"
	quest.4C843FF057EDD7BA.quest_desc: [
		"Mekanism 机器需要电力。 &e通用电缆&r 可将电力从发电机输送到机器。"
		""
		"Powah、IE和Mekanism的能量都可以互通使用。"
	]
	quest.4C843FF057EDD7BA.quest_subtitle: "能量会流向你指向的地方"
	quest.4C843FF057EDD7BA.title: "通用电缆模组 (Universal Cables)"
	quest.4CB3AB0E6DF91CEB.quest_desc: [
		"在Undergarden底部挖掘&eDreadrock&r，以抵达Depths。"
	]
	quest.4CB3AB0E6DF91CEB.quest_subtitle: "再往下走一点的地方"
	quest.4CB3AB0E6DF91CEB.title: "深入海底"
	quest.4CCF2038FDF07CCB.quest_desc: [
		"使用&e觉醒核心&r（EMI称之为龙核）来升级你的Wyvern项链。"
	]
	quest.4CCF2038FDF07CCB.quest_subtitle: "Draconic Additions"
	quest.4CCF2038FDF07CCB.title: "龙之项链 (Draconic Necklace)"
	quest.4CFB57B306725BEA.quest_desc: [
		"An &eEnrichment Chamber&r turns one ore block into two dusts. Smelt the dust for ingots."
		""
		"&6注意：&r原矿的加成较少（三个原矿产四尘）。丝绸之触挖掘矿石方块可获得完整的2倍产量。"
	]
	quest.4CFB57B306725BEA.quest_subtitle: "将你的矿石数量翻倍"
	quest.4CFB57B306725BEA.title: "2x: 粉尘"
	quest.4D58C473A97E8AA7.quest_desc: [
		"将导航物品放入&e导航台&r，它会向目标输出红石。按住W键观察导航台，查看哪些物品有效。"
		""
		"不朝向目标时信号会较弱。将其连接到转向系统，实现真正的自动驾驶。"
	]
	quest.4D58C473A97E8AA7.quest_subtitle: "带我回家"
	quest.4D58C473A97E8AA7.title: "导航表"
	quest.4D67A68B5790584C.quest_desc: [
		"&e奥拉奇卡姆矿石&r只生长在拉特兰蒂斯。将其熔炼成&e奥拉奇卡姆锭&r。"
		""
		"Ratlantis 盔甲和工具都使用它，&eAir-Raid Siren&r 也是如此。"
	]
	quest.4D67A68B5790584C.quest_subtitle: "Ratlantis 自己的金属"
	quest.4D67A68B5790584C.title: "奥拉奇卡尔姆"
	quest.4D6A147EC3663C39.quest_desc: [
		"框架、灵魂锭、铁和两把钻石镰刀。 &e收割机&r会收割成熟的作物，重新种植，并将掉落物收集起来。"
		""
		"红石信号可以关闭它。添加机器升级以扩大范围。"
	]
	quest.4D6A147EC3663C39.quest_subtitle: "自动驾驶的农场自动化"
	quest.4D6A147EC3663C39.title: "收割机"
	quest.4D71416C8A0181FB.quest_desc: [
		"制作一个&e空白烈焰燃烧器&r，并用它右键点击烈焰。现在你拥有一个烈焰燃烧器了。"
		""
		"投入燃料加热盆。投入&e烈焰蛋糕&r使其超高温，用于制作最精致的配方。"
	]
	quest.4D71416C8A0181FB.quest_subtitle: "你的宠物烈焰人"
	quest.4D71416C8A0181FB.title: "烈焰人燃烧器"
	quest.4D945ECEE30BDCDD.quest_desc: [
		"种子太多？&e种子再处理器&r能将其变回精华。"
	]
	quest.4D945ECEE30BDCDD.quest_subtitle: "将额外的种子转化为精华"
	quest.4D945ECEE30BDCDD.title: "种子再处理器"
	quest.4DABE33843FEF77A.quest_desc: [
		"你爬到了梯子顶端。这一章是胜利的最后一圈。"
		""
		"制作八个&e封印&r，分别用于ICU的八个角落：创造、飞行、力量、存储、魔法、暮色森林、其他维度以及最终Boss。然后将它们组合成&6超新星&r。"
		""
		"顺序不限。EMI会显示所有配方。"
	]
	quest.4DABE33843FEF77A.quest_subtitle: "再向上攀爬一次"
	quest.4DABE33843FEF77A.title: "最后的挑战"
	quest.4DB1B414C0FA2ABB.quest_desc: [
		"&eTier Installer&r 可将已放置的机器或工厂升级到下一个等级。右键即可，无需破坏任何东西。"
		""
		"基础安装器可将普通机器直接转变为基础工厂。"
	]
	quest.4DB1B414C0FA2ABB.quest_subtitle: "原地升级"
	quest.4DB1B414C0FA2ABB.title: "Tier 安装器"
	quest.4DB34F14CD4A73B6.quest_desc: [
		"铁、砖块和篝火可以制作一个&e炉子&r。它一次最多可以在顶部烹饪六个物品。"
		""
		"这也是烹饪锅底下最适合放的东西了。"
	]
	quest.4DB34F14CD4A73B6.quest_subtitle: "一个合适的热源"
	quest.4DB34F14CD4A73B6.title: "炉子"
	quest.4DEAE53C4CBED6F4.quest_desc: [
		"&eYUNG's Better Mineshafts&r 替换了原版矿洞。它们位于 Y -55 和 30 之间。"
		""
		"在墙壁和废弃的矿工前哨中查找&e矿脉&r。探索完一处后勾选此项。"
	]
	quest.4DEAE53C4CBED6F4.quest_subtitle: "小心脚下，注意脚下"
	quest.4DEAE53C4CBED6F4.title: "更好的废弃矿井模组"
	quest.4E1E5983AA343725.quest_desc: [
		"将黑曜石粉碎成&e粉末黑曜石&r，然后进行顺序组装：一个 Spout 加入岩浆，接着一个 Press 将其压平两次。"
		""
		"坚固的板材用于制造火车外壳、时刻表和沉浸式航空发动机。"
	]
	quest.4E1E5983AA343725.quest_subtitle: "黑曜石，但是要薄一点"
	quest.4E1E5983AA343725.title: "坚固的薄片"
	quest.4E650CB290C33650.quest_desc: [
		"&eStock Link&r将打包者连接成网络。 &eStock Ticker&r显示其中的所有内容，并允许你请求物品。"
		""
		"你的物品会被打包并寄送给你。这是一个完全由 Create 部件构成的存储系统。"
	]
	quest.4E650CB290C33650.quest_subtitle: "从任何地方接收订单"
	quest.4E650CB290C33650.title: "库存管理"
	quest.4E694A9748198B04.quest_desc: [
		"每件暗物质工具和盔甲都需要在网格中放置一个&e下界之星&r（凋零）和一个&e卫道士之心&r（卫道士）。"
		"两者都留在网格中，所以每种一个就能组成一套完整的。"
		""
		"暗物质工具永不损坏，并可充电以开启更大范围的模式。"
		""
		"它们的挖掘方式像下界合金：Allthemodium矿石可以，Vibranium矿石不行。"
	]
	quest.4E694A9748198B04.quest_subtitle: "坚固耐用，速度飞快"
	quest.4E694A9748198B04.title: "暗物质工具"
	quest.4E7D21455DBC29BA.quest_desc: [
		"由印刷的entro电路制成，就像AE2处理器一样。几乎所有Extended设备都需要一个。"
	]
	quest.4E7D21455DBC29BA.quest_subtitle: "ExtendedAE 的大脑"
	quest.4E7D21455DBC29BA.title: "并发处理器"
	quest.4E8E6D3B25DB2D9D.quest_desc: [
		"在荒野中，&e机械村庄&r依靠创造机器运行，而ICU则让它们保持运转。"
		""
		"去见证齿轮的转动吧。"
	]
	quest.4E8E6D3B25DB2D9D.quest_subtitle: "机器中的另一个齿轮部件"
	quest.4E8E6D3B25DB2D9D.title: "机械齿轮村庄"
	quest.4EBCAC5C7C1A1F12.quest_desc: [
		"&e公告板&r（木板和纸）可以放置一本书或地图，并将其显示在正面。"
		""
		"&e黑板&r能让你用黑白两色画画。很适合用来做告示牌、地图和涂鸦。"
	]
	quest.4EBCAC5C7C1A1F12.quest_subtitle: "请留下一条消息"
	quest.4EBCAC5C7C1A1F12.title: "公告板"
	quest.4EE18AA55854A7E7.quest_desc: [
		"&eDense Cable&r 可承载 32 个频道。直接从控制器引出，然后在设备附近分叉为普通线缆。"
		""
		"需要更多？添加更多控制器方块来扩大它。"
	]
	quest.4EE18AA55854A7E7.quest_subtitle: "32 车道宽"
	quest.4EE18AA55854A7E7.title: "密集电缆"
	quest.4EEDD260467C480E.quest_desc: [
		"八个红石块和一根羽毛。 &e红石笔&r 可以在墙壁、地板和天花板上画出细的红石轨道。"
	]
	quest.4EEDD260467C480E.quest_subtitle: "绘制你的电路线路图吧"
	quest.4EEDD260467C480E.title: "红石笔 Redstone Pen"
	quest.4F4C13E11B590A27.quest_desc: [
		"它统治着黑暗塔。小心红石矿。"
	]
	quest.4F4C13E11B590A27.quest_subtitle: "暮色森林"
	quest.4F4C13E11B590A27.title: "远古灾厄兽"
	quest.4F5FA97DA48559A4.quest_desc: [
		"Gravitite Ore 位于岛屿较低处，需要铁质镐（Zanite 镐也可）。"
		""
		"在祭坛上附魔矿石以获得&e附魔的重力石&r。"
	]
	quest.4F5FA97DA48559A4.quest_subtitle: "粉色就是新的蓝色"
	quest.4F5FA97DA48559A4.title: "附魔的引力石"
	quest.4F6B2BB2F666F041.quest_desc: [
		"&6注意：&r每个传送石、共享石、港口石和传送板都需要在创造模式的&e机械合成器&r中制作。"
		""
		"普通传送石需要4行：传送石周围的石砖，底部用黑曜石。摆好足够的合成台，用EMI检查具体形状。"
	]
	quest.4F6B2BB2F666F041.quest_subtitle: "需要黄铜"
	quest.4F6B2BB2F666F041.title: "建造你自己的传送石"
	quest.4FB7C762DD78CB6E.quest_desc: [
		"下界隐藏着&e堡垒&r。它们不是要塞，而是&e野火&r的家园。"
		""
		"走进其中一个里面去。"
	]
	quest.4FB7C762DD78CB6E.quest_subtitle: "又不是什么要塞之类的东西"
	quest.4FB7C762DD78CB6E.title: "一座堡垒！"
	quest.4FB9732D1F3383AD.quest_desc: [
		"在锻造台使用模板和 &eAllthemodium Ingot&r 升级下界合金工具。"
		""
		"稿子才是关键：它能开启振金矿。"
	]
	quest.4FB9732D1F3383AD.quest_subtitle: "黄色而且很坚硬"
	quest.4FB9732D1F3383AD.title: "Allthemodium 工具"
	quest.4FF1D10C663F5DB5.quest_desc: [
		"羽毛、种子、一颗钻石和一根金锭。 &e宠物鸡&r能为你提供速度加成和偶尔会下蛋。"
	]
	quest.4FF1D10C663F5DB5.quest_subtitle: "快速移动模组（Fast feet）"
	quest.4FF1D10C663F5DB5.title: "小鸡宠物"
	quest.4FF3A83026A1DD13.quest_desc: [
		"铁和砖块可以制作一个&e煎锅&r。将食物放在副手，右键点击即可在热源上烹饪。"
		""
		"在紧急情况下，它也是一把不错的武器。"
	]
	quest.4FF3A83026A1DD13.quest_subtitle: "随时随地烹饪美食"
	quest.4FF3A83026A1DD13.title: "煎锅（Skillet）"
	quest.4FFE0D0D81320BF2.quest_desc: [
		"先兆者正在&e远古工厂&r中等待。它会掉落一块下界合金块。"
	]
	quest.4FFE0D0D81320BF2.quest_subtitle: "机器也是有感情的生物"
	quest.4FFE0D0D81320BF2.title: "先遣者 (The Harbinger)"
	quest.502E5086865A93F2.quest_desc: [
		"&e简易祖母绿工具&r使用祖母绿、红宝石、紫水晶、黑曜石和铜制作全套工具和盔甲。还为每种材料添加了锤子、挖掘机、像素铲和伐木斧。"
		""
		"&6注意：&r所有工具都无法跳过ICU的梯子。宝石工具挖掘效率如钻石，铜和玄武岩工具如铁。Allthemodium矿石仍需下界合金镐。"
	]
	quest.502E5086865A93F2.quest_subtitle: "这么多绿宝石到底该怎么办才好"
	quest.502E5086865A93F2.title: "宝石变齿轮"
	quest.5044B8E0F11F0720.quest_desc: [
		"九个鸡蛋可以合成一个&e鸡蛋箱&r，再分解回九个鸡蛋。"
		""
		"海龟蛋也有一个箱子，如果你收集了那么多的话。"
	]
	quest.5044B8E0F11F0720.quest_subtitle: "整理储物空间"
	quest.5044B8E0F11F0720.title: "一箱鸡蛋"
	quest.50478A46AD54FEA3.quest_desc: [
		"&eQuivers&r come from pillager outpost and woodland mansion chests. One holds six stacks of arrows."
		""
		"按住 &eV&r（ICU 默认键）来选择弓箭使用的箭矢。"
	]
	quest.50478A46AD54FEA3.quest_subtitle: "箭矢，已整理好"
	quest.50478A46AD54FEA3.title: "箭袋 (Quiver)"
	quest.504F5D4422348148.quest_desc: [
		"右键点击僵尸或骷髅，使用&e空中珍珠&r，珍珠将变为&e玩家空中珍珠&r，即&e玩家发射器&r的核心。"
		""
		"将一张&e绑定卡&r绑定到自己身上并放入其中。它可以在同一维度内的任何地方为你充能物品。"
	]
	quest.504F5D4422348148.quest_subtitle: "随时随地给你的装备充电"
	quest.504F5D4422348148.title: "玩家传输器"
	quest.507EF21D4B73D32D.quest_desc: [
		"ICU replaces the Nether fortress with &eYUNG's Better Nether Fortresses&r. Find one."
		""
		"&6注意：&r击败&eIgnis&r后，Cataclysm的Ignited Berserkers也会出现在这些堡垒中。"
	]
	quest.507EF21D4B73D32D.quest_subtitle: "YUNG的重建工程"
	quest.507EF21D4B73D32D.title: "更好的下界堡垒模组"
	quest.50B85512EBBA261C.quest_desc: [
		"一个包含&eWitherite Ingots&r、精密机械装置和铁砧的大型机械合成配方。"
		""
		"Cataclysm 用它来熔合最好的装备。"
	]
	quest.50B85512EBBA261C.quest_subtitle: "凋零石工作室"
	quest.50B85512EBBA261C.title: "机械融合砧（Mechanical Fusion Anvil）"
	quest.50B85F6AF25E644F.quest_desc: [
		"&eVisceral Heap&r 里有血湖。是的，你可以用桶舀起来。"
		""
		"A &eBucket of Blood&r ringed with four rotten flesh makes a &eFlesh&r block. A Create Millstone grinds it back into rotten flesh."
	]
	quest.50B85F6AF25E644F.quest_subtitle: "内脏堆（The Visceral Heap）"
	quest.50B85F6AF25E644F.title: "恶心，但很有用"
	quest.5100B2DADED71C28.quest_desc: [
		"在两根绳子和钉子之间挂一个&e吊床&r。它在白天有效，并能跳过夜晚，非常适合用于生物农场和仅限夜间出现的生物。"
	]
	quest.5100B2DADED71C28.quest_subtitle: "白天睡大觉，晚上不睡觉"
	quest.5100B2DADED71C28.title: "吊床"
	quest.512C376D27B5B444.quest_desc: [
		"将威龙工具放入核心作为催化剂，然后加入下界合金、威龙核心、觉醒的德拉科尼ウム和德拉科尼能量控制器。"
	]
	quest.512C376D27B5B444.quest_subtitle: "通过融合进行升级"
	quest.512C376D27B5B444.title: "龙之工具包"
	quest.514622395C9C996B.quest_desc: [
		"木板和木棍可以制作一个&e砧板&r。将物品放在上面，然后用合适的工具敲击。"
		""
		"刀能切食物，斧能剥树皮成&e树皮&r，还能回收木门、告示牌、栅栏和船成木板（模组木材亦可），镐能破坏石头物品。"
	]
	quest.514622395C9C996B.quest_subtitle: "快刀斩乱麻"
	quest.514622395C9C996B.title: "砧板 Cutting Board"
	quest.515116E405CF81E5.quest_desc: [
		"用风扇吹过一个方块，让物品掉入气流中："
		"&eWater&r washes, &eLava&r smelts, &eFire or a campfire&r smokes, &eSoul fire&r haunts."
		""
		"清洗非常适合砾石、沙子和矿石。用风扇处理任何物品即可完成此任务。"
	]
	quest.515116E405CF81E5.quest_subtitle: "清洗、冶炼、烟熏、附魔"
	quest.515116E405CF81E5.title: "批量处理"
	quest.51787B6AF91E76C8.quest_desc: [
		"用棒子围上密集电缆，就能制作出&eDense ME Wire Coil&r。它能承载32个频道，跨度可达32格。"
		""
		"&eME中继器&r用于连接导线，类似于IE的导线中继器。"
	]
	quest.51787B6AF91E76C8.quest_subtitle: "空中有32条车道"
	quest.51787B6AF91E76C8.title: "密集能量导线"
	quest.51A3355F7548F85F.quest_desc: [
		"皮革和白色羊毛可以制作&e床卷&r（皮革匠也出售）。它在水下也能使用。"
		""
		"去海底深处试试吧。"
	]
	quest.51A3355F7548F85F.quest_subtitle: "一张随处可用的床"
	quest.51A3355F7548F85F.title: "与鱼同眠"
	quest.521352F665D22E0E.quest_desc: [
		"&ePowah Solar Panels&r需要开阔的天空。任何遮挡光线的东西都会阻止它们工作。"
		""
		"&e末影透镜&r能让面板看穿方块。"
	]
	quest.521352F665D22E0E.quest_subtitle: "清洁能源"
	quest.521352F665D22E0E.title: "太阳能电池板"
	quest.521A91B02D721ED9.quest_desc: [
		"&e云杉&r生长在针叶林和云杉林空地中。 &e松树&r生长在温泉、玉质悬崖和干旱地带周围。"
		""
		"&e红木&r是红木森林的巨人。一棵树就有好多原木。"
	]
	quest.521A91B02D721ED9.quest_subtitle: "云杉、松树和红杉木"
	quest.521A91B02D721ED9.title: "常绿树 (Evergreens)"
	quest.521DE3DE681DD909.quest_desc: [
		"将黑曜石放在基岩上，在其上放置红石，然后点击黑曜石。EMI的&eCreating Flux&r页面会显示设置方法。"
		""
		"下界的地面和天花板有很多基岩。"
	]
	quest.521DE3DE681DD909.quest_subtitle: "被压在世界的最底层之下"
	quest.521DE3DE681DD909.title: "Flux Dust"
	quest.525C2CB22FDBEE88.quest_desc: [
		"&e锦鲤&r游荡在樱花林和樱花谷的池塘里。用桶把它们捞起来吧。"
		""
		"把它放在村庄里，就能阻止怪物在村民周围生成。"
	]
	quest.525C2CB22FDBEE88.quest_subtitle: "幸运鱼"
	quest.525C2CB22FDBEE88.title: "真巧啊！Koincidence！"
	quest.526F1115311B984C.quest_desc: [
		"&e原子分解器&r靠能量而非耐久度运行，挖掘效率堪比&e下界合金镐&r：能挖 Allthemodium 矿石，但不能挖 Vibranium 和 Unobtainium。"
		""
		"需要 &e原子合金&r（经强化合金与精炼黑曜石粉尘融合而成）和一块精炼黑曜石锭。"
	]
	quest.526F1115311B984C.quest_subtitle: "镐、斧头和铲子三合一"
	quest.526F1115311B984C.title: "原子分解机"
	quest.526F4E2A88EB6368.quest_desc: [
		"&e铜线圈块&r是用八个LV线圈围绕一个铁锭制成的。用它建造一个&e动能发电机&r。"
		""
		"将水轮或风车装在发电机轴上以产生电力。"
	]
	quest.526F4E2A88EB6368.quest_subtitle: "旋转赢取胜利"
	quest.526F4E2A88EB6368.title: "动能发电机"
	quest.52C95DAB9DA1FE07.quest_desc: [
		"黄金发电机加上钻石。这就是分叉的地方。"
	]
	quest.52C95DAB9DA1FE07.quest_subtitle: "强大的熔炉动力"
	quest.52C95DAB9DA1FE07.title: "钻石生成器"
	quest.52F3539798AD8062.quest_desc: [
		"每个组件层级都由三个低一级组件、一个计算处理器、石英玻璃和红石组成。"
		""
		"将组件放入容器中，或合成完整的电池。"
	]
	quest.52F3539798AD8062.quest_subtitle: "More bytes"
	quest.52F3539798AD8062.title: "更大的单元格"
	quest.52F6823DA8329E31.quest_desc: [
		"乌姆武塔纳林地的领导者。"
	]
	quest.52F6823DA8329E31.quest_subtitle: "Mowzie's Mobs"
	quest.52F6823DA8329E31.title: "Umvuthi"
	quest.53023DC7F1858182.quest_desc: [
		"使用 Unobtainium 模板和 &eUnobtainium 锭&r 升级 Vibranium 工具。"
	]
	quest.53023DC7F1858182.quest_subtitle: "最好的金属工具"
	quest.53023DC7F1858182.title: "Unobtainium 工具"
	quest.5313B23366997558.quest_desc: [
		"安山岩加铁粒（或锌）可制作&e安山岩合金&r，早期Create的核心。"
	]
	quest.5313B23366997558.quest_subtitle: "创造者的基本生存指南"
	quest.5313B23366997558.title: "安山岩合金"
	quest.5334AD920C35EBA1.quest_desc: [
		"&e导入总线&r会从其正前方吸取物品。而&e导出总线&r则会向其前方推送选定的物品。"
	]
	quest.5334AD920C35EBA1.quest_subtitle: "从一边进去，从另一边出来"
	quest.5334AD920C35EBA1.title: "导入和导出"
	quest.536C9FFAA0CFB99E.quest_desc: [
		"两个&eCrushing Wheels&r并排运转，相互靠近，碾碎夹在中间的任何东西。"
		""
		"它们是机械合成台的配方，而且很需要动力。给它们一个好的电源吧。"
	]
	quest.536C9FFAA0CFB99E.quest_subtitle: "重型研磨机（The heavy grinders）"
	quest.536C9FFAA0CFB99E.title: "压碎车轮"
	quest.536F5F916EB8CA79.quest_desc: [
		"一个电子管、一个&e黄铜外壳&r和一个工作台。将制作者按同一朝向放置成网格，用扳手连接相邻者，并赋予它们旋转能力。"
		""
		"&6注意：&rICU 里的 Waystone、Sharestone、Portstone 和 Warp Plate 都是在这里制作的。"
	]
	quest.536F5F916EB8CA79.quest_subtitle: "一个怀有抱负的合成台"
	quest.536F5F916EB8CA79.title: "机械合成台"
	quest.5397883FFE8CB29F.quest_desc: [
		"&e燃料棒&r放入反应堆内的一个柱中。每个柱的顶部，即屋顶上，放置一根&e控制棒&r。"
		""
		"控制棒可以让你调节控制器产生的反应强度。"
	]
	quest.5397883FFE8CB29F.quest_subtitle: "核心组件"
	quest.5397883FFE8CB29F.title: "燃料与控制棒"
	quest.53BBC7E95BB8006F.quest_desc: [
		"&eEncased Fan&r会推动空气。空气流经的物质决定了它对路径上物品的作用。"
	]
	quest.53BBC7E95BB8006F.quest_subtitle: "一个吹牛大王，身负重任"
	quest.53BBC7E95BB8006F.title: "Encased Fan"
	quest.53C6D39774ED344F.quest_desc: [
		"在ICU中，雨水被视为&a净化水&r。"
		""
		"放在雨中的&e炼药锅&r会慢慢被雨水填满。可以用瓶子接水，或者直接饮用。"
	]
	quest.53C6D39774ED344F.quest_subtitle: "免费的清洁水"
	quest.53C6D39774ED344F.title: "接住雨水"
	quest.53C789DB2AE0E969.quest_desc: [
		"AE2无线终端（ae2wtlib）将你的无线终端合并为一个&e无线通用终端&r。它还需要一张磁卡。"
	]
	quest.53C789DB2AE0E969.quest_subtitle: "一个终端，统御所有终端"
	quest.53C789DB2AE0E969.title: "通用终端 (Universal Terminal)"
	quest.53CEB008E28B65FF.quest_desc: [
		"锅里的两个番茄可以制作出&e番茄酱&r。"
		""
		"有 Create 吗？搅拌机也能把两个番茄和一个碗变成酱汁。"
	]
	quest.53CEB008E28B65FF.quest_subtitle: "有酱料，一切都会更美好"
	quest.53CEB008E28B65FF.title: "番茄酱"
	quest.53DA8AC0D6FAF5D8.quest_desc: [
		"粉碎一个&e矿石块&r（用丝绸之触挖掘）可获得一个粉碎矿石，并有75%的几率获得第二个。"
		"原矿石一比一粉碎，并附带一个经验值金块。"
		""
		"用风扇洗炼粉碎的铁，可获得九个铁粒和少量红石，或者直接冶炼。"
	]
	quest.53DA8AC0D6FAF5D8.quest_subtitle: "每个矿石产出更多金属"
	quest.53DA8AC0D6FAF5D8.title: "矿石翻倍"
	quest.53FC7A30C7BAB34F.quest_desc: [
		"在末地，废弃堡垒由末地傀儡和&e末地守卫&r守护着。"
	]
	quest.53FC7A30C7BAB34F.quest_subtitle: "又一个要塞？！"
	quest.53FC7A30C7BAB34F.title: "被毁的堡垒遗迹"
	quest.53FF7A32B5F108A2.quest_desc: [
		"The Other's 扭曲森林中的地牢有时会有一个&e图书馆&r房间（并非所有地牢都有）。击败充满 Evoker 的&eTrial Spawner&r，它会掉落一个&eUnobtainium Smithing Template&r。图书馆的箱子里没有。"
		""
		"用七个振金锭和末石来复制它。"
	]
	quest.53FF7A32B5F108A2.quest_subtitle: "检查图书馆"
	quest.53FF7A32B5F108A2.title: "Unobtainium 模板"
	quest.543EDB2ECDEB894E.quest_desc: [
		"在锻造台用遗忘锭和&e遗忘升级&r模板升级一把Cloggrum镐。"
		""
		"遗忘的工具能更快地挖掘Undergarden方块，速度是原来的1.5倍，也是穿过Dreadrock的唯一方法。"
	]
	quest.543EDB2ECDEB894E.quest_subtitle: "打破屏障"
	quest.543EDB2ECDEB894E.title: "被遗忘的镐子"
	quest.5449CB4DA4B8AAB0.quest_desc: [
		"振金矿石走的是相同的Mekanism流程。每块矿石产更多锭，去下界次数更少。"
	]
	quest.5449CB4DA4B8AAB0.quest_subtitle: "同样的方法，紫色金属"
	quest.5449CB4DA4B8AAB0.title: "振金加工"
	quest.547FEE5E35C5C764.quest_desc: [
		"&e遗忘的守护者&r会掉落遗忘的块。九个可以合成一个锭。"
	]
	quest.547FEE5E35C5C764.quest_subtitle: "现在该怎么办呢"
	quest.547FEE5E35C5C764.title: "被遗忘的锭子"
	quest.54BB6929975C037B.quest_desc: [
		"戴着面具，潜入Umvuthana Grove，与Umvuthi交易以获得&eSun's Blessing&r。"
		""
		"空手状态下，你可以召唤日陨和发射太阳射线。"
	]
	quest.54BB6929975C037B.quest_subtitle: "太阳的祝福"
	quest.54BB6929975C037B.title: "太阳法师"
	quest.54BE53C99EE6D2BB.quest_desc: [
		"&e分层磁铁&r（过载铁和金）比磁铁矿要强得多。"
		""
		"将它们放入发电机，用同样的应力换取更强的动力。"
	]
	quest.54BE53C99EE6D2BB.quest_subtitle: "更好的发电机模组"
	quest.54BE53C99EE6D2BB.title: "更强的磁铁"
	quest.54D066BF714DB096.quest_desc: [
		"清除骑士堡垒，并击败所有骑士幻影。"
		""
		"即使你在捡起这本书之前就击败了它们，这也算数。"
	]
	quest.54D066BF714DB096.quest_subtitle: "占领要塞"
	quest.54D066BF714DB096.title: "骑士幻影 (Knight Phantoms)"
	quest.54F42E0006D1A9E3.quest_desc: [
		"它住在巫妖塔的最顶层。"
	]
	quest.54F42E0006D1A9E3.quest_subtitle: "大规模毁灭的领主们"
	quest.54F42E0006D1A9E3.title: "夜之巫妖"
	quest.551A8E112BB73741.quest_desc: [
		"&e引擎&r是一个带有&e精密机械&r、黄铜板和&e坚固钢板&r的锅炉。"
	]
	quest.551A8E112BB73741.quest_subtitle: "精准的力量"
	quest.551A8E112BB73741.title: "引擎"
	quest.55597C7BA6F8F1AF.quest_desc: [
		"龙之装备是&6模块化的&r：你将模块装配在工具或盔甲的网格上。"
		""
		"每个模块都始于一个 &e模块核心&r（铁、金、红石和一块德拉科尼乌姆锭）。一个好的开端是 &e能量模块&r。"
	]
	quest.55597C7BA6F8F1AF.quest_subtitle: "带有插槽的工具"
	quest.55597C7BA6F8F1AF.title: "模块核心"
	quest.557B93F6A3C2C4B4.quest_desc: [
		"下界竞技场中漂浮的拳头。"
	]
	quest.557B93F6A3C2C4B4.quest_subtitle: "大规模毁灭的领主们"
	quest.557B93F6A3C2C4B4.title: "下界试炼场"
	quest.5583A5FCE88EBF29.quest_desc: [
		"&e基础能量立方&r可以缓冲电力并为物品充电。将其放置在发电机和机器之间。"
	]
	quest.5583A5FCE88EBF29.quest_subtitle: "视野开阔的电池组"
	quest.5583A5FCE88EBF29.title: "能量立方体"
	quest.5586CAEA78AA7F20.quest_desc: [
		"四个无限射程助推器，四个&e下界之星&r和一个末影之眼。"
		""
		"无线接入点可提供无限范围，且在其他维度也能使用。它不会加载任何区块，所以请保持网络的区块处于加载状态。"
	]
	quest.5586CAEA78AA7F20.quest_subtitle: "你的网络，无处不在"
	quest.5586CAEA78AA7F20.title: "维度卡片"
	quest.5592684A50C009A5.quest_desc: [
		"&e树脂块&r来自吱吱作响的心脏。九个可以合成一个&e树脂块&r。"
		""
		"在ICU中，补充物的&e精细木材&r是用树脂而非蜂巢制作的。"
	]
	quest.5592684A50C009A5.quest_subtitle: "黏糊糊的橙色团块"
	quest.5592684A50C009A5.title: "树脂"
	quest.55A4BFAC0ABC8F79.quest_desc: [
		"ICU 每个版本都会设置一次按键绑定，因此没有两个动作共享同一个按键。聊天快捷键为 T。"
		""
		"在选项、控制中随意更改。你的选择将在下一个 ICU 版本重置方案前一直保留。"
	]
	quest.55A4BFAC0ABC8F79.quest_subtitle: "没有任何东西被复制两份"
	quest.55A4BFAC0ABC8F79.title: "你的按键绑定设置"
	quest.55D3D66CE21820E6.quest_desc: [
		"将鼠标悬停在任意物品上（背包内或右侧 EMI 物品列表中），然后按下："
		""
		"&eR&r: 如何&a制作或获取&r它。"
		"&eU&r: 用途是&a什么&r（粉碎、机器、仪式……）。"
		""
		"在 EMI 的物品列表中，你也可以&e左键单击&r（同 R）或&e右键单击&r（同 U）。"
		""
		"&eA&r 将其固定到左侧的收藏夹中。 &eBackspace&r 返回上一页。 &eCtrl+F&r 跳转到搜索栏， &eCtrl+O&r 隐藏或显示 EMI。"
		""
		"在配方中，&e+&r 按钮会自动填充你的合成网格（按 Shift 可合成尽可能多的物品）。"
	]
	quest.55D3D66CE21820E6.quest_subtitle: "它从哪里来，又有什么用途呢？"
	quest.55D3D66CE21820E6.title: "使用 EMI 模组"
	quest.55DDA9EF6492F9F0.quest_desc: [
		"煤炭或木炭、黏土和岩浆桶可以制作&e介电浆&r。烈焰粉可以代替岩浆。"
		""
		"几乎所有 Powah 配方都需要它，所以多做一些。"
	]
	quest.55DDA9EF6492F9F0.quest_subtitle: "Powah's 胶水"
	quest.55DDA9EF6492F9F0.title: "介电质浆料"
	quest.560822A55BE8186E.quest_desc: [
		"建造一个&e口袋传送门&r（草、石头、一个维度核心和一颗钻石），放置并使用它。"
		""
		"你的口袋维度是你自己的空间。次元手提箱能让你从任何地方前往那里。"
	]
	quest.560822A55BE8186E.quest_subtitle: "一个私人世界"
	quest.560822A55BE8186E.title: "你的口袋维度"
	quest.56173E540418F6DE.quest_desc: [
		"暮色森林的哥布林骑士会掉落&e盔甲碎片&r。将它们合成簇，然后进行冶炼。"
	]
	quest.56173E540418F6DE.quest_subtitle: "哥布林会掉落最棒的物品"
	quest.56173E540418F6DE.title: "骑士金属"
	quest.564DB40C4E00FD7F.quest_desc: [
		"&e机械压机&r在&e料仓&r或传送带上将锭轧成薄片。"
		""
		"你需要在创造模式里用到铁、铜、金和黄铜板。尽早建造这个。"
	]
	quest.564DB40C4E00FD7F.quest_subtitle: "多日份的羊皮纸碎片"
	quest.564DB40C4E00FD7F.title: "紧急事务需要处理"
	quest.5675AC0A2361614A.quest_desc: [
		"&eEco Engine&r 需要铁和铜板以及一桶水。而 &eNether Engine&r 则需要坚固的钢板和一桶岩浆。"
		""
		"将鼠标悬停在每个上面，比较它们的燃料消耗和功率。"
	]
	quest.5675AC0A2361614A.quest_subtitle: "不同的燃料，不同的体验"
	quest.5675AC0A2361614A.title: "生态与下界引擎"
	quest.56A407C885B47FAC.quest_desc: [
		"将氧气导入&e净化室&r。矿石会变成三个&e矿块&r。"
		""
		"Clumps 进入 Crusher (Dirty Dust)，然后进入 Enrichment Chamber (clean Dust)，最后进入 smelter。"
	]
	quest.56A407C885B47FAC.quest_subtitle: "氧气能让一切变得更好"
	quest.56A407C885B47FAC.title: "3x：成团状"
	quest.56AB9C66D59416F6.quest_desc: [
		"&eME终端&r会显示所有已存储的物品。而&e合成终端&r则提供了一个直接从存储中取用的合成网格。"
	]
	quest.56AB9C66D59416F6.quest_subtitle: "查看你物品的窗口"
	quest.56AB9C66D59416F6.title: "终端机"
	quest.56B194033E335A62.quest_desc: [
		"在源宝石周围放置基座以增强其效果："
		"&e土&r：铁、种子、泥土。 &e水&r：水桶、雪块、海带。 &e火&r：打火石和钢、火把、火药。"
		""
		"每个需要 2000 Source，所以先准备好你的 Sourcelinks 吧。"
	]
	quest.56B194033E335A62.quest_subtitle: "土、水、火"
	quest.56B194033E335A62.title: "元素精华 Elemental Essences"
	quest.56B246E5B703DCE6.quest_desc: [
		"将八个沙石砖块堆叠成2x2x2的立方体，然后用锤子敲击。"
		""
		"金和银可以合成&eElectrum&r。铜和镍可以合成&eConstantan&r。两者每次都会产出两个。"
	]
	quest.56B246E5B703DCE6.quest_subtitle: "两种金属，一种锭块"
	quest.56B246E5B703DCE6.title: "合金熔炉"
	quest.56E272EA25FAE250.quest_desc: [
		"元素作物使用 &eagglomeratio&r 作为材料：砾石、泥土和黏土，外加玻璃瓶（空气）、草（土）、水（水）或岩浆（火）。"
		""
		"它们的精华会在之后为觉醒祭坛提供能量。"
	]
	quest.56E272EA25FAE250.quest_subtitle: "空气、大地、水、火焰"
	quest.56E272EA25FAE250.title: "元素种子 Elemental Seeds"
	quest.5716250023891AB9.quest_desc: [
		"&6ICU配方：&r一个下界之星、两个红石块、一个烈焰水晶块和一个&e不可得锭&r可制作成十六个氮晶。"
		""
		"氮能电池是 Powah 能做的最大的了。干得好！"
	]
	quest.5716250023891AB9.quest_subtitle: "最大电力！Maximum Powah!"
	quest.5716250023891AB9.title: "氮气等级"
	quest.5741B3F5AEA1D480.quest_desc: [
		"&e污秽腐化&r会将老鼠变成&c鼠王&r，它会向你投掷老鼠。"
		""
		"击败它，夺取它的王冠。"
	]
	quest.5741B3F5AEA1D480.quest_subtitle: "污垢造就了一位国王"
	quest.5741B3F5AEA1D480.title: "鼠王（The Rat King）"
	quest.5756900D7C1D99F6.quest_desc: [
		"Draconic Evolution 使末影龙掉落一个 &eDragon Heart&r。"
		""
		"需要另一个吗？在出口传送门上放置四个末地水晶来重生巨龙。"
	]
	quest.5756900D7C1D99F6.quest_subtitle: "仍然温暖"
	quest.5756900D7C1D99F6.title: "龙之心脏"
	quest.5786FC0112CCB80D.quest_desc: [
		"Bamboo and paper make six &ePaper Walls&r. Add glowstone dust for a &ePaper Lantern&r."
		""
		"竹子和木棍可以制作&e竹席&r。试着用它打点东西吧。"
	]
	quest.5786FC0112CCB80D.quest_subtitle: "更柔和的色彩搭配"
	quest.5786FC0112CCB80D.title: "纸和竹子"
	quest.57E6CA90A4453EED.quest_desc: [
		"&e背包&r是一种可穿戴的箱子。用箱子、皮革和线合成，然后按 &eB&r 打开。"
		""
		"You can also place it on the ground (sneak and right-click) and use it like a chest."
	]
	quest.57E6CA90A4453EED.quest_subtitle: "口袋里的口袋，方便收纳"
	quest.57E6CA90A4453EED.title: "一个背包！"
	quest.58005875FFF94967.quest_desc: [
		"&e方向盘&r能给出精确的旋转输出。按住右键并移动鼠标即可转动；潜行可精确调整至45度。"
		""
		"把它连接到轴承上，用来控制舵轮或车轮。告诉轴承不要分解！"
	]
	quest.58005875FFF94967.quest_subtitle: "双手放在方向盘上"
	quest.58005875FFF94967.title: "方向盘 Steering Wheel"
	quest.58024E90DB5618E3.quest_desc: [
		"&eEnder Chests&r and Tanks from Ender Storage work on moving contraptions."
		""
		"带有末影箱的钻井架能将战利品直接送回家，无论它走多远。"
	]
	quest.58024E90DB5618E3.quest_subtitle: "创建末地存储装置"
	quest.58024E90DB5618E3.title: "机械装置上的末地存储系统"
	quest.580AF08BEA3EF0D6.quest_desc: [
		"&e氘&r: 用装有过滤升级的电动泵抽取重水，然后在分离器中进行分离。"
		"&e氚&r：来自蒸发塔的锂，在太阳能中子活化器中激活。"
		""
		"将两者混合在化学注入器中。装满燃料的 &eHohlraum&r 会启动反应堆。"
	]
	quest.580AF08BEA3EF0D6.quest_subtitle: "氘加上氚"
	quest.580AF08BEA3EF0D6.title: "D-T 燃料"
	quest.581A4DEA39B50043.quest_desc: [
		"AE2 主章节仅简要提及的几个 AE2 扩展：通过线缆传输 ME、实用的终端卡以及 Applied Flux 的更大能量电池。"
		""
		"拿起你的网络所需的任何物品即可。"
	]
	quest.581A4DEA39B50043.quest_subtitle: "小巧的附加包，带来巨大的便利"
	quest.581A4DEA39B50043.title: "为您的网络带来更多内容"
	quest.583B9033857FFC23.quest_desc: [
		"它们在黑暗森林的骑士堡垒中出没。"
	]
	quest.583B9033857FFC23.quest_subtitle: "暮色森林"
	quest.583B9033857FFC23.title: "骑士幻影 (Knight Phantoms)"
	quest.583E7A9F84C48C29.quest_desc: [
		"&e下界合金镐：&r Allthemodium 矿石（深暗、采矿维度、The Other）。"
		"&eAllthemodium 镐：&rVibranium 矿石（下界，The Other）。"
		"&e振金镐：&r 未知金属矿石（末地高地）。"
		""
		"其他工具遵循相同的升级顺序："
		"- &e下界合金一样：&r暗物质工具、原子分解器、被遗忘的工具。"
		"- &e如 Allthemodium：&r Red Matter 工具、Meka-Tool、Wyvern 工具、Supremium 和 Awakened Supremium 工具。"
	]
	quest.583E7A9F84C48C29.quest_subtitle: "稀有金属制成的梯子"
	quest.583E7A9F84C48C29.title: "哪种镐能开采哪种矿物"
	quest.5849EB7850091973.quest_desc: [
		"死亡后，你的所有物品会留在原地，形成一个&e尸体&r。走回去右键点击它即可取回所有物品。"
		""
		"它不会被岩浆烧毁，也不会掉入虚空，所以可以慢慢来。"
	]
	quest.5849EB7850091973.quest_subtitle: "你的物品是安全的"
	quest.5849EB7850091973.title: "你死亡了！"
	quest.58506E6500842F28.quest_desc: [
		"墙壁由 &eFission Reactor Casing&r（或 Reactor Glass）构成，内部堆叠着 &eFuel Assemblies&r，每堆顶部放着一个 &eControl Rod Assembly&r。"
		""
		"控制杆需要一个&e精英控制电路&r。"
	]
	quest.58506E6500842F28.quest_subtitle: "巨大、炎热且充满危险"
	quest.58506E6500842F28.title: "裂变反应堆"
	quest.585821130FBBED92.quest_desc: [
		"Ferrous Wroughtnaut 会掉落它的斧头和头盔。两者都不会损坏。"
		""
		"右键斧头可使其大范围挥舞，或潜行右键可释放冲击波。"
	]
	quest.585821130FBBED92.quest_subtitle: "Wroughtnaut 战利品"
	quest.585821130FBBED92.title: "千金属之斧 (Axe of a Thousand Metals)"
	quest.588DA15EC8AAB0BC.quest_desc: [
		"&eReactor Controller&r需要钻石、比较器和两个铀锭。每个反应堆一个，放在外墙上。"
	]
	quest.588DA15EC8AAB0BC.quest_subtitle: "大脑"
	quest.588DA15EC8AAB0BC.title: "反应堆控制器"
	quest.58B15EA53CCFC2A7.quest_desc: [
		"这里最大的机械合成配方：一架货运飞艇、引擎、螺旋桨、加固船体、工业铁和一把重型十字弓。"
		""
		"将像&eRotary Cannon&r或&eBomb Bay&r这样的武器放入它的武器槽中。"
	]
	quest.58B15EA53CCFC2A7.quest_subtitle: "一座漂浮的空中堡垒"
	quest.58B15EA53CCFC2A7.title: "战舰"
	quest.58D86E9C24224C58.quest_desc: [
		"Crafting Units、Crafting Storage 和 Co-Processing Units 组成一个箱形的 &eCrafting CPU&r。"
		""
		"存储决定任务规模，协处理器提升速度。现在请求物品，见证它完成！"
	]
	quest.58D86E9C24224C58.quest_subtitle: "规划部门"
	quest.58D86E9C24224C58.title: "合成中央处理器"
	quest.5918E88696F32B3F.quest_desc: [
		"ICU的64M组件需要一个&eAllthemodium Ingot&r。将其包裹在一个MEGA外壳中。"
	]
	quest.5918E88696F32B3F.quest_subtitle: "里面的 Allthemodium 方块"
	quest.5918E88696F32B3F.title: "MEGA 64M"
	quest.591A193D9BBE9497.quest_desc: [
		"&e乳胶处理单元&r将乳胶和水混合成&e干橡胶&r。"
	]
	quest.591A193D9BBE9497.quest_subtitle: "乳胶加水"
	quest.591A193D9BBE9497.title: "乳胶加工"
	quest.593E2860757CD0B1.quest_desc: [
		"&eMob Grinder&r 利用电力击杀周围的生物。可与刷怪器或暗室搭配使用。"
		""
		"需要一个 Wyvern 能量控制器和一个生物头颅。"
	]
	quest.593E2860757CD0B1.quest_subtitle: "免手持生物刷怪器"
	quest.593E2860757CD0B1.title: "生物刷怪器"
	quest.594EB178280225C7.quest_desc: [
		"&eMagmatic Generator&r 燃烧的是岩浆而非固体燃料。为其接入稳定的供应管道。"
	]
	quest.594EB178280225C7.quest_subtitle: "熔岩的力量"
	quest.594EB178280225C7.title: "岩浆发电机"
	quest.596D7EAE2B064674.quest_desc: [
		"手持36个&eReactor&r方块，在周围留出空隙放置一个（指南要求3x4区域）。它就会自己建造！"
		""
		"用铀矿给它加油。碳、红石和冷却剂（水、冰或&e干冰&r）都能提升性能。"
	]
	quest.596D7EAE2B064674.quest_subtitle: "自动建造的复合方块结构"
	quest.596D7EAE2B064674.title: "Powah Reactor"
	quest.597B1A0734E42C15.quest_desc: [
		"用去皮的原木制作黄铜，可以获得黄铜外壳。"
		""
		"&6注意：&r在ICU中，Mekanism的&e钢制外壳&r需要黄铜外壳。"
	]
	quest.597B1A0734E42C15.quest_subtitle: "这个也别忘了！"
	quest.597B1A0734E42C15.title: "黄铜外壳"
	quest.59801064CAA2277F.quest_desc: [
		"YUNG's mods 重建了地牢、废弃矿井、下界堡垒、海底神殿和末地岛屿。"
		""
		"踏入地下升级后的怪物房间之一。"
	]
	quest.59801064CAA2277F.quest_subtitle: "翻新后的怪物房间"
	quest.59801064CAA2277F.title: "更好的地下城模组 (Better Dungeons)"
	quest.5987E4B7CA0862C5.quest_desc: [
		"&e斯库拉&r，风暴女皇，统治着雅典卫城。她会掉落风暴精华。"
	]
	quest.5987E4B7CA0862C5.quest_subtitle: "斯库拉的礼物"
	quest.5987E4B7CA0862C5.title: "风暴的本质 (Essence of the Storm)"
	quest.59B1D247C2FE1E42.quest_desc: [
		"&e劫掠兽皮&r在劫掠中由劫掠兽掉落。用一张皮、铁和一个箱子可以制作一个&e背包&r。"
		""
		"穿戴在胸甲栏位可获得三行额外物品栏。它不会损坏，但必须在脱下前清空物品栏。"
		""
		"&6注意：&rICU 的主要背包是 &eSophisticated Backpacks&r（见存储章节）。Quark 的更简单，但会消耗你的胸甲。"
	]
	quest.59B1D247C2FE1E42.quest_subtitle: "还有三行要添加"
	quest.59B1D247C2FE1E42.title: "Quark's Backpack"
	quest.59D94EC1FE7E32E5.quest_desc: [
		"在机械合成台（EMI会显示网格）中建造一个&eWaystone&r。为其命名后，你就可以在任何访问过的waystone之间传送了。"
	]
	quest.59D94EC1FE7E32E5.quest_subtitle: "快速旅行，已解锁"
	quest.59D94EC1FE7E32E5.title: "你的第一块传送石"
	quest.59EF14D922093768.quest_desc: [
		"将远古灵魂放在黑曜石上的黑曜石之心上。放置后，生物将在64格范围内停止生成。"
	]
	quest.59EF14D922093768.quest_subtitle: "不再有任何生物生成"
	quest.59EF14D922093768.title: "镇压权杖 Staff of Suppression"
	quest.5A212F9299E41E19.quest_desc: [
		"&eCloggrum&r 矿石遍布 Depthrock。它和铁一样好用，能制作你的第一批 Undergarden 工具。"
	]
	quest.5A212F9299E41E19.quest_subtitle: "铁的忧郁表亲"
	quest.5A212F9299E41E19.title: "Cloggrum"
	quest.5A3B4969347F8C7F.quest_desc: [
		"将野性角笛投掷到附近的野生干格米旁以获取代币，然后用食物、种子和源宝石在装置上驯服它。"
		""
		"将魅力作用于&e苔石&r以建造干地巨石阵。它能将周围生物掉落物复制到箱子里。更多种类的生物会使其更开心。"
	]
	quest.5A3B4969347F8C7F.quest_subtitle: "生物掉落物，未伤害任何生物"
	quest.5A3B4969347F8C7F.title: "Drygmy"
	quest.5A41F682D1DD2FFD.quest_desc: [
		"用熔炉和船一起进行合成。"
		""
		"潜行并右键点击&e带熔炉的船&r以添加燃料。燃烧时，船的速度会加快。它只能容纳一人。"
	]
	quest.5A41F682D1DD2FFD.quest_subtitle: "燃煤动力划桨机"
	quest.5A41F682D1DD2FFD.title: "带熔炉的船"
	quest.5A7BC2FD766F4D1B.quest_desc: [
		"&e凋零建造者&r会为你建造并召唤凋零：塑料、一颗下界之星、凋零骷髅头颅和灵魂沙围绕着一个&e至尊框架&r。"
		""
		"至高框架需要 Allthemodium、Ignitium 和 Ether Gas。到达 IF 顶端，干得漂亮！"
	]
	quest.5A7BC2FD766F4D1B.quest_subtitle: "IF 的顶级货柜"
	quest.5A7BC2FD766F4D1B.title: "至尊机械模组"
	quest.5A8F5F879241C296.quest_desc: [
		"Maledictus会掉落&eCursium Ingots&r。它们能将下界合金盔甲升级为Cursium盔甲，带有幽灵般的技巧，比如死亡后可复活一次。"
	]
	quest.5A8F5F879241C296.quest_subtitle: "幽灵盔甲"
	quest.5A8F5F879241C296.title: "Cursium"
	quest.5ABC7643D6842F49.quest_desc: [
		"一个ME箱子、一个存储组件、一个能量单元和一个源单元外壳可以组成一个&e便携式源单元&r。"
		""
		"方便将源带到很远的地方建造时使用。"
	]
	quest.5ABC7643D6842F49.quest_subtitle: "随时随地获取源文件"
	quest.5ABC7643D6842F49.title: "便携式源能电池"
	quest.5AD91616D943DDB7.quest_desc: [
		"每秒消耗大量能量来燃烧&e下界之星&r。燃料昂贵，但凋灵农场可以持续供应。"
	]
	quest.5AD91616D943DDB7.quest_subtitle: "燃烧的星辰"
	quest.5AD91616D943DDB7.title: "下界之星生成器"
	quest.5B0A107D681BA4A4.quest_desc: [
		"石圈里的一只大公羊想要每种颜色的羊毛各一个。喂饱全部十六种，它就会回报你。"
	]
	quest.5B0A107D681BA4A4.quest_subtitle: "把羊毛带给我！"
	quest.5B0A107D681BA4A4.title: "寻羊的冒险家"
	quest.5B0ABFDE1125698E.quest_desc: [
		"在两根电缆之间放置一个&e能量计&r，查看通过的电量。"
		""
		"非常适合用来寻找那个吞噬万物的机器。"
	]
	quest.5B0ABFDE1125698E.quest_subtitle: "我的力量都用到哪里去了？"
	quest.5B0ABFDE1125698E.title: "能量计量表"
	quest.5B16747988757C5D.quest_desc: [
		"一个区块内集成了打包器和拆包器，适用于你的ME网络（使用频道）。放入编码持有物后，AE2自动合成即可使用这些配方。"
	]
	quest.5B16747988757C5D.quest_subtitle: "直接进入AE2世界"
	quest.5B16747988757C5D.title: "ME 包装提供者"
	quest.5B2477A2712D13A3.quest_desc: [
		"翻耕过的&e富饶土壤&r上作物生长更快。普通富饶土壤上种植的蘑菇会蔓延成&e蘑菇群落&r。"
		""
		"在棋盘上切下一块殖民地，换成一堆蘑菇。"
	]
	quest.5B2477A2712D13A3.quest_subtitle: "整合包里最好的泥土方块"
	quest.5B2477A2712D13A3.title: "肥沃的土壤"
	quest.5B9414A12E616934.quest_desc: [
		"&e激光钻头&r（简易框架）本身不会挖掘。它将能量射入激光底座。"
		""
		"在EMI或IF手册中查看如何在周围放置钻头。"
	]
	quest.5B9414A12E616934.quest_subtitle: "电源装置"
	quest.5B9414A12E616934.title: "激光钻头"
	quest.5BA84674BF1A72D7.quest_desc: [
		"Integrated Dungeons and Structures 在森林、桦树林、平原和草地中隐藏着 &e城堡&r。"
		""
		"走进其中一个传送门。"
	]
	quest.5BA84674BF1A72D7.quest_subtitle: "咚咚咚，有人吗？"
	quest.5BA84674BF1A72D7.title: "城堡"
	quest.5BBB69E1C960529B.quest_desc: [
		"&eFlux Crafter&r 的工作方式相同，但其 &eFlux Alternators&r 需要电力。"
		""
		"它能制作增强红石锭和纹流之星。"
	]
	quest.5BBB69E1C960529B.quest_subtitle: "等待中，正在补充能量"
	quest.5BBB69E1C960529B.title: "Flux 合成"
	quest.5BBE15C7C414E4C8.quest_desc: [
		"&e牛肉炖菜&r是生牛肉、胡萝卜和土豆。 &e蔬菜汤&r是胡萝卜、土豆、甜菜和绿叶蔬菜。"
		""
		"锅里的食物会赋予你&eNourishment&r效果，让你的饥饿值保持饱足一段时间。"
	]
	quest.5BBE15C7C414E4C8.quest_subtitle: "温暖又饱腹感强"
	quest.5BBE15C7C414E4C8.title: "营养丰富的炖菜"
	quest.5BC17C04EB21AE87.quest_desc: [
		"将铁锭和金锭放在你的能量球周围，即可制作出&e能量钢&r。"
		""
		"这是硬化等级所需的金属材料。"
	]
	quest.5BC17C04EB21AE87.quest_subtitle: "铁加黄金加力量"
	quest.5BC17C04EB21AE87.title: "充能钢"
	quest.5BE682933309440B.quest_desc: [
		"远古工厂深埋地下。预言之子&eHarbinger&r正在其中沉睡。"
		""
		"机械之眼是通过 Create 的顺序装配线制作的。"
	]
	quest.5BE682933309440B.quest_subtitle: "格格不入"
	quest.5BE682933309440B.title: "远古工厂"
	quest.5BE6D6BB6022BB23.quest_desc: [
		"铀锭在浓缩室中变为&e黄饼&r，然后在化学氧化器中变为氧化铀。"
		""
		"将其与氢氟酸（溶于硫酸的萤石）混合，并在&e同位素离心机&r（终极电路）中旋转以获得裂变燃料。"
	]
	quest.5BE6D6BB6022BB23.quest_subtitle: "绕远路回家"
	quest.5BE6D6BB6022BB23.title: "可裂变燃料"
	quest.5BECE34378F07E35.quest_desc: [
		"有些任务只需阅读。点击对勾即可完成并领取奖励。"
		""
		"物品任务在物品放入背包后立即完成。物品不会被拿走。"
	]
	quest.5BECE34378F07E35.quest_subtitle: "就像这个一样！"
	quest.5BECE34378F07E35.title: "关于勾选任务（Checkmark Quests）"
	quest.5C000C521BDC88BD.quest_desc: [
		"量子环、量子链接室和高级卡片。"
		""
		"无线终端可通过量子桥连接，因此你的范围没有限制。"
	]
	quest.5C000C521BDC88BD.quest_subtitle: "无线传输，绕远路的方式"
	quest.5C000C521BDC88BD.title: "量子桥梁卡"
	quest.5C1DAC8581397EE7.quest_desc: [
		"用钻石胸甲进行相同的融合配方，可获得&eWyvern Chestpiece&r。"
		""
		"添加护盾模块，它用能量而非生命值来吸收伤害。"
	]
	quest.5C1DAC8581397EE7.quest_subtitle: "举起盾牌，准备防御！"
	quest.5C1DAC8581397EE7.title: "Wyvern Armor"
	quest.5C2DC01D9838CA10.quest_desc: [
		"&eGyrodyne&r完全不需要燃料：用你的双腿就能驱动。用力踩踏板，它就会升空。"
		""
		"配方：船帆、船体、螺旋桨、精密机械装置和座椅。"
	]
	quest.5C2DC01D9838CA10.quest_subtitle: "脚踏的力量"
	quest.5C2DC01D9838CA10.title: "Gyrodyne"
	quest.5C35F1B95DCA8CDD.quest_desc: [
		"铁粒周围放四个铁锭（或钻石）。用齿轮模具的金属压模也行。"
		""
		"机器需要大量的金齿轮和钻石齿轮。"
	]
	quest.5C35F1B95DCA8CDD.quest_subtitle: "圆润又实用"
	quest.5C35F1B95DCA8CDD.title: "齿轮"
	quest.5C3B402AD003EC76.quest_desc: [
		"远古残骸位于下界深处。用床和TNT将其炸开，熔炼成废料，再用废料加黄金制作成锭。"
		""
		"你需要一把下界合金镐来获取 Allthemodium。"
	]
	quest.5C3B402AD003EC76.quest_subtitle: "下界中最难寻觅的宝藏"
	quest.5C3B402AD003EC76.title: "远古残骸"
	quest.5C3F456633569996.quest_desc: [
		"5x 生产线使用 &e硫酸&r。快捷路线：&e硫磺粉&r可在机器的化学槽中直接转化为酸。"
		""
		"用盐酸注入火药来获取硫磺。长路线需要使用化学氧化器和注入器（查看EMI）。"
	]
	quest.5C3F456633569996.quest_subtitle: "几乎可以溶解任何东西"
	quest.5C3F456633569996.title: "硫酸 (Sulfuric Acid)"
	quest.5C4749C0E9419FF0.quest_desc: [
		"灵魂沙、三个凋零骷髅头，以及一个&l不是&r你基地的地方。"
		""
		"每个凋零都会掉落一颗下界之星。"
	]
	quest.5C4749C0E9419FF0.quest_subtitle: "凋零殆尽"
	quest.5C4749C0E9419FF0.title: "下界之星"
	quest.5C49BF3C0124A3BA.quest_desc: [
		"四个铜锭可以制作一个&e扳手&r。用它点击方块即可旋转。"
		""
		"&e转盘&r和红石的作用一样，能让上面的任何东西都转起来。"
	]
	quest.5C49BF3C0124A3BA.quest_subtitle: "把它转过来"
	quest.5C49BF3C0124A3BA.title: "扳手"
	quest.5C522DB94AE5DFD1.quest_desc: [
		"四块原石、一个红石火把和一个红石粉可以制作一个&e红石中继器&r。它能将满强度的信号传递到前方。"
		""
		"将中继器放回合成网格中，可循环切换&e反向&r、&e双稳态&r（切换）、&e脉冲&r和&e桥接&r中继器。悬停每个中继器可查看其功能。"
	]
	quest.5C522DB94AE5DFD1.quest_subtitle: "一个配方里有五个芯片"
	quest.5C522DB94AE5DFD1.title: "红石中继器"
	quest.5C5428D0F9177C42.quest_desc: [
		"出口传送门边缘的四个&e末地水晶&r能让末影龙回来。这就是获得更多末影珍珠的方法。"
	]
	quest.5C5428D0F9177C42.quest_subtitle: "巨龙回来了"
	quest.5C5428D0F9177C42.title: "再来一轮"
	quest.5C63A4C20A47D3CE.quest_desc: [
		"&e刚玉&r晶体在Y值0到64之间的地下大簇中生长，每簇两种颜色。"
		""
		"在刚玉方块周围放置四个红石，即可制作出该颜色的&e水晶灯&r。为其供电后，它会全亮度发光，并在开启时为信标光束着色。"
	]
	quest.5C63A4C20A47D3CE.quest_subtitle: "水晶灯盏"
	quest.5C63A4C20A47D3CE.title: "刚玉灯 (Corundum Lamps)"
	quest.5C73F4534B0449CF.quest_desc: [
		"Ecologics 会在每个埋藏宝藏的箱子里放入一张音乐唱片，&eCoconut&r。跟随沉船或海底遗迹中的藏宝图，将其挖掘出来。"
	]
	quest.5C73F4534B0449CF.quest_subtitle: "X 标记着歌声的位置"
	quest.5C73F4534B0449CF.title: "被埋藏的宝藏之歌"
	quest.5C85B3849A52C81F.quest_desc: [
		"将威龙注射器与两个威龙核心、一个&e觉醒的德拉科尼乌姆块&r和钻石熔炼。"
		""
		"龙之阶装备需要这些物品。"
	]
	quest.5C85B3849A52C81F.quest_subtitle: "三级融合（Tier three fusion）"
	quest.5C85B3849A52C81F.title: "龙之注射器 (Draconic Injectors)"
	quest.5C906415F22EA849.quest_desc: [
		"ICU的配方：一个基础电路、两个浸渍合金和一个&e火焰锭&r。"
		""
		"Infuser 快捷方式已关闭，所以只能通过 Hydra 来通关。干得漂亮！"
	]
	quest.5C906415F22EA849.quest_subtitle: "Tier 2 已完成！"
	quest.5C906415F22EA849.title: "高级控制电路"
	quest.5C925412E1E145A8.quest_desc: [
		"&eCheese Staff&r 决定了驯服的鼠会拾取物品和放下物品的地点。"
		""
		"对准一个箱子，再对准老鼠的工作点。这就是老鼠物流的大部分了。"
	]
	quest.5C925412E1E145A8.quest_subtitle: "告诉你的老鼠该去哪里"
	quest.5C925412E1E145A8.title: "奶酪法杖 (The Cheese Staff)"
	quest.5C9398E120AB7D8F.quest_desc: [
		"Eight &eQuantum Rings&r around a &eQuantum Link Chamber&r on each end, with a pair of Quantum Entangled Singularities."
		""
		"用末影尘引爆奇点来制造成对。跨维度有效！"
	]
	quest.5C9398E120AB7D8F.quest_subtitle: "无论相隔多远"
	quest.5C9398E120AB7D8F.title: "量子桥梁"
	quest.5CA204DCA58A500E.quest_desc: [
		"&eBoatload&r 添加了更大的船、带熔炉的船和下界木船。之后，&eDyeable Components&r 能让你给航空轮胎和浮石染色。"
		""
		"从小处着手。或者从大处着手。"
	]
	quest.5CA204DCA58A500E.quest_subtitle: "先造船，再造飞艇"
	quest.5CA204DCA58A500E.title: "更多漂浮方式 (More Ways to Float)"
	quest.5CA3C920AC948FBD.quest_desc: [
		"觉醒的德拉科尼乌姆锭、两个威龙能量控制器和一个威龙核心。"
	]
	quest.5CA3C920AC948FBD.quest_subtitle: "更多存储，更多觉醒"
	quest.5CA3C920AC948FBD.title: "Draconic Energy Controller"
	quest.5CBD54CD2D64844F.quest_desc: [
		"&e便携式传送器&r能让你跳转到任何可用的传送器频率。保持充能状态。"
	]
	quest.5CBD54CD2D64844F.quest_subtitle: "一个装在口袋里的传送器"
	quest.5CBD54CD2D64844F.title: "便携式传送器"
	quest.5CBFC950AD570491.quest_desc: [
		"&eAeroWarptics&r 能让飞船进行长距离跳跃。它始于一个 &eRift Core&r：精密机械、电子管、黄铜和悬浮石混合在加热盆中。"
		""
		"也合成一本&e航海手册&r。它会解释整个系统。"
	]
	quest.5CBFC950AD570491.quest_subtitle: "折叠空间"
	quest.5CBFC950AD570491.title: "裂隙核心"
	quest.5CCFA16DF820696E.quest_desc: [
		"将&e风车轴承&r放在一个方块上，粘上&e风帆&r，然后右键轴承即可启动。"
		""
		"更多的帆意味着更强的承重能力。建造得又大又高。"
	]
	quest.5CCFA16DF820696E.quest_subtitle: "乘着微风前行"
	quest.5CCFA16DF820696E.title: "风车"
	quest.5CD51A64C0EDA4FF.quest_desc: [
		"一张被八个工作台包围的迷宫地图焦点。"
		""
		"&6注意：&rICU会关闭分解功能。工作台仍能修复和重制装备，并保留附魔效果。"
	]
	quest.5CD51A64C0EDA4FF.quest_subtitle: "嗯，大部分情况下是这样的"
	quest.5CD51A64C0EDA4FF.title: "非合成工作台"
	quest.5CE33E96A663003C.quest_desc: [
		"铁、铁栏杆和铁板可以为小动物制作一个&e笼子&r：鸡、兔子、狐狸、蝙蝠等，还有小牛、小猪、绵羊和山羊。"
		""
		"猫、鹦鹉和其他宠物必须先被驯服。"
	]
	quest.5CE33E96A663003C.quest_subtitle: "把它们带回家"
	quest.5CE33E96A663003C.title: "笼子"
	quest.5CE4D5A062C4688C.quest_desc: [
		"一艘飞艇、一个船体和六个箱子。它速度慢，燃料消耗大，但可以携带整整一箱的储物空间。"
	]
	quest.5CE4D5A062C4688C.quest_subtitle: "一个会飞的仓库"
	quest.5CE4D5A062C4688C.title: "货运空中飞艇"
	quest.5CE5ECB5F6A11F21.quest_desc: [
		"The Night Lich drops &eAncient Anima&r, a key ingredient for most Mass Destruction gear."
	]
	quest.5CE5ECB5F6A11F21.quest_subtitle: "夜之巫妖的掉落物"
	quest.5CE5ECB5F6A11F21.title: "远古灵魂 (Ancient Anima)"
	quest.5D00FA9588BE6C34.quest_desc: [
		"击败下界试炼，打开宝箱即可获得一个&e烈焰之眼&r。"
	]
	quest.5D00FA9588BE6C34.quest_subtitle: "下界试炼宝藏掉落物"
	quest.5D00FA9588BE6C34.title: "燃烧的双眼"
	quest.5D0443266980E07E.quest_desc: [
		"一个位于&e盆&r上的&e机械搅拌机&r可以混合你投入的任何东西。它能制作合金、面团等等。"
		""
		"有些混合物需要加热。这就是烈焰燃烧器的用途。"
	]
	quest.5D0443266980E07E.quest_subtitle: "盆式化学实验台"
	quest.5D0443266980E07E.title: "混合搭配"
	quest.5D0883D70C89437C.quest_desc: [
		"&e高级马达&r使用黄铜外壳和过载铁。在马达后面添加&e马达扩展&r以提高其应力容量。"
	]
	quest.5D0883D70C89437C.quest_subtitle: "压力越大，速度越快"
	quest.5D0883D70C89437C.title: "高级马达"
	quest.5D47187662D10663.quest_desc: [
		"&e便携式引擎&r燃烧燃料以产生旋转，无需水轮。是船只的必备品。"
		""
		"在铁板上按顺序组装一个&e引擎组件&r，然后添加高炉和铁板。烈焰蛋糕能使其过热以获得更多动力。"
	]
	quest.5D47187662D10663.quest_subtitle: "装在盒子里的力量"
	quest.5D47187662D10663.title: "便携式引擎"
	quest.5D53DA6F4A5998FE.quest_desc: [
		"Undergarden 的巨大石质守护者。它会掉落 Forgotten Nuggets。"
	]
	quest.5D53DA6F4A5998FE.quest_subtitle: "地下花园（The Undergarden）"
	quest.5D53DA6F4A5998FE.title: "被遗忘的守护者"
	quest.5D7B453B6BAA706B.quest_desc: [
		"充能的&e自由奔跑者&r能让你走上完整方块并吸收坠落伤害。"
		""
		"在能量立方体的插槽中为其充能。"
	]
	quest.5D7B453B6BAA706B.quest_subtitle: "勇敢向前，切勿重重摔倒"
	quest.5D7B453B6BAA706B.title: "自由奔跑者"
	quest.5D82E97898E9ECDE.quest_desc: [
		"&e热气球囊&r方块（羊毛和木棍）围成一个能容纳热空气的体积。它必须是&e密封的&r。"
		""
		"气球内的方块会占据体积。管道可以穿过密封管道。将其染成任何颜色。"
	]
	quest.5D82E97898E9ECDE.quest_subtitle: "气球织物"
	quest.5D82E97898E9ECDE.title: "信封"
	quest.5D9F6482421C96CD.quest_desc: [
		"至尊框架需要一个 &eAllthemodium 锭&r 和一个 &eIgnitium 锭&r。"
		""
		"还需要 135 mB 的 &eEther Gas&r：一个带有 &ePurple Laser Lens&r 的流体激光底座，以及在工作区中放置的活体凋零（参见 Industrial Foregoing）。"
		""
		"干得漂亮。下一站：振金。"
	]
	quest.5D9F6482421C96CD.quest_subtitle: "第三阶段已完成！"
	quest.5D9F6482421C96CD.title: "至尊机械框架"
	quest.5E07162AE041ADD6.quest_desc: [
		"泥土、稻草、骨粉和树皮（或腐肉）可以制作&e有机堆肥&r。"
		""
		"留在世界内，它会慢慢变成&e富饶的土壤&r。"
	]
	quest.5E07162AE041ADD6.quest_subtitle: "给泥土喂食"
	quest.5E07162AE041ADD6.title: "有机堆肥 (Organic Compost)"
	quest.5E310B3163145371.quest_desc: [
		"红石、金和浸渍合金可以制作一个&e能量锭&r。"
		""
		"可以制作能量方块、喷气背包、太阳能电池板等。制作几个吧。"
	]
	quest.5E310B3163145371.quest_subtitle: "口袋里的一块电池"
	quest.5E310B3163145371.title: "能量药片"
	quest.5E7CF06585DF2341.quest_desc: [
		"&eSpout&r 会填充下方的物品（桶、瓶子，或蜂蜜苹果等配方）。而 &eItem Drain&r 则会清空它们。"
		""
		"两者都需要 &eCopper Casing&r：去皮原木上的铜锭。"
	]
	quest.5E7CF06585DF2341.quest_subtitle: "填充和清空"
	quest.5E7CF06585DF2341.title: "喷泉与排水口"
	quest.5EAD721716AEE19C.quest_desc: [
		"TNT、铁和线可以制作四个&e炸弹&r。把它们投向生物。"
		""
		"&6注意：&rICU炸弹不像TNT那样会炸毁地形，所以它们用于战斗，而非采矿。"
	]
	quest.5EAD721716AEE19C.quest_subtitle: "便携式炸药包"
	quest.5EAD721716AEE19C.title: "炸弹"
	quest.5EE810AAC3BC839F.quest_desc: [
		"沉没之城位于深海底部。 &e利维坦&r 正在里面等待。带上水肺药水。"
	]
	quest.5EE810AAC3BC839F.quest_subtitle: "深邃，深邃的水域"
	quest.5EE810AAC3BC839F.title: "沉没的城市"
	quest.5F033DFD0CCB2D8E.quest_desc: [
		"Infinity 工具永远不会损坏，而且攻击力惊人。稿子甚至还有超大的区域挖掘模式。"
	]
	quest.5F033DFD0CCB2D8E.quest_subtitle: "还有这把宇宙之剑（Sword of the Cosmos）"
	quest.5F033DFD0CCB2D8E.title: "世界破坏者"
	quest.5F22A5A035520D4A.quest_desc: [
		"给游戏分配 10 到 11 GB 的 RAM。超过 12 GB 会让延迟更严重，而不是更好。"
		""
		"可选：在 CurseForge 的 InfinityCraft Ultra 中，进入 Profile Options，在 Java Arguments 中添加："
		"&7-XX:+UseZGC -XX:+ZGenerational -XX:+UseStringDeduplication --add-modules jdk.incubator.vector&r"
		""
		"在服务器游玩？ICU 包含 &eVery Many Players&r，帮助服务器在大量玩家在线时运行得更顺畅。无需任何设置。"
	]
	quest.5F22A5A035520D4A.quest_subtitle: "卡顿峰值更少"
	quest.5F22A5A035520D4A.title: "更流畅的游戏体验"
	quest.5F44E8ABC9485D33.quest_desc: [
		"生物作物在祭坛上使用一个 &eSoulium Seed Base&r 和一个完整的灵魂罐。"
		""
		"僵尸、骷髅和苦力怕作物会直接掉落物品，无需战斗。"
	]
	quest.5F44E8ABC9485D33.quest_subtitle: "养大一个僵尸。好吧，是它的掉落物。"
	quest.5F44E8ABC9485D33.title: "生物种子 (Mob Seeds)"
	quest.5F5DC2AA33DE2D2D.quest_desc: [
		"在加固反应堆上放置两个 &e流体端口&r：一个用于泵入水，另一个用于抽出蒸汽。"
		""
		"Pipe that steam into your Turbine. An actively cooled reactor is far more efficient."
	]
	quest.5F5DC2AA33DE2D2D.quest_subtitle: "反应堆加涡轮机"
	quest.5F5DC2AA33DE2D2D.title: "主动冷却系统"
	quest.5F6FC55A28843ECF.quest_desc: [
		"星布灵护身符和创造水轮可以合成一个&e星布灵轮&r。它能产生旋转力。"
		""
		"在它前面放一个金块可以增加转速。"
	]
	quest.5F6FC55A28843ECF.quest_subtitle: "Ars Creo：可爱的旋转力"
	quest.5F6FC55A28843ECF.title: "星团轮盘"
	quest.5F788DC601E265BE.quest_desc: [
		"Umvuthi会掉落&eSol Visage&r。穿戴它，然后手持面具右键以召唤Umvuthana助手。"
	]
	quest.5F788DC601E265BE.quest_subtitle: "穿上太阳的庇护，抵御灼热的阳光"
	quest.5F788DC601E265BE.title: "太阳的面容"
	quest.5F7AB4C55E1DC9B8.quest_desc: [
		"&e滑道&r可将物品垂直移动（向上需风扇）。一个&e储料仓&r可容纳一组物品，供压机或出料口处理。"
	]
	quest.5F7AB4C55E1DC9B8.quest_subtitle: "向上、向下并按住"
	quest.5F7AB4C55E1DC9B8.title: "滑道与仓库"
	quest.5F82F07555CD9F62.quest_desc: [
		"&e抽屉控制器&r会链接所有与其接触（以及彼此之间）的抽屉。"
		"放入控制器，物品会进入右侧抽屉。将其连接到基地的其他部分。"
		""
		"双击它可将整个物品栏倒入匹配的抽屉中。"
	]
	quest.5F82F07555CD9F62.quest_subtitle: "整面墙就一个面孔"
	quest.5F82F07555CD9F62.title: "抽屉控制器"
	quest.5FB3E6374ECEFC0D.quest_desc: [
		"Project Expansion packs collectors and relays into one block: the &ePower Flower&r adds EMC straight to your personal total."
		""
		"It needs compressed collectors, relays and an &eEMC Link&r. Check EMI for the full chain."
		""
		"基础层级需要黄铜外壳，&e品红物质&r需要乌托邦金块，而最终层级则需要混沌守卫的混沌碎片。"
	]
	quest.5FB3E6374ECEFC0D.quest_subtitle: "项目扩展包"
	quest.5FB3E6374ECEFC0D.title: "力量之花"
	quest.5FC82A1D4895456B.quest_desc: [
		"&eCattails&r grow along rivers and in swamps. Use shears on one to take its fluff."
		""
		"七个&e Cattail Fluff&r可以合成一根线。"
	]
	quest.5FC82A1D4895456B.quest_subtitle: "沼泽棉花"
	quest.5FC82A1D4895456B.title: "Fluff Content"
	quest.5FF574F3ADF23625.quest_desc: [
		"八个箱子围绕一个末地箱可制成&e压缩箱&r，仅用于结构配方。"
		""
		"添加了压缩石和压缩灯，用于建造一个名为&e仓库&r的大型建筑，可供你存放物品。"
	]
	quest.5FF574F3ADF23625.quest_subtitle: "一切物品都有容身之处"
	quest.5FF574F3ADF23625.title: "仓库"
	quest.60087CED26DE3F52.quest_desc: [
		"振金矿石需要一把Allthemodium镐。"
	]
	quest.60087CED26DE3F52.quest_subtitle: "选择合适的工具来完成工作"
	quest.60087CED26DE3F52.title: "Allthemodium 镐"
	quest.600C70C73D042D25.quest_desc: [
		"&e单轨轨道&r由金属梁和支架建成。列车使用单轨转向架行驶。"
		""
		"非常适合在基地上空建造天际线。"
	]
	quest.600C70C73D042D25.quest_subtitle: "正在努力坚持中，希望一切顺利"
	quest.600C70C73D042D25.title: "单轨铁路"
	quest.6025BEAD022C68F9.quest_desc: [
		"在砧板上切一块生 Gwibling 得到 &e生 Gwibfillet&r，然后用熟米饭和其中两个一起烹饪。"
	]
	quest.6025BEAD022C68F9.quest_subtitle: "Undergarden 寿司"
	quest.6025BEAD022C68F9.title: "Gwibfillet 肉卷"
	quest.6035611E73A45623.quest_desc: [
		"256M 也是。大存储，大金属。"
	]
	quest.6035611E73A45623.quest_subtitle: "所有的字节都收集好了，就差你了！"
	quest.6035611E73A45623.title: "MEGA 256M"
	quest.603BE1B63F039E78.quest_desc: [
		"选择一个轨道，然后在附近放置一个 &e轨道转换开关&r。用它来将火车导向左、直或右。"
		""
		"红石也能设置它，比较器能读取它所指向的方向。"
	]
	quest.603BE1B63F039E78.quest_subtitle: "选择你的道路"
	quest.603BE1B63F039E78.title: "轨道转换开关"
	quest.60409AD7ED6369BC.quest_desc: [
		"抽屉里放着许多堆叠的&eone&r物品，正面会显示内部物品。用木板围住一个箱子即可制作。"
		""
		"将一格抽屉合成一个&e升级模板&r。所有抽屉的升级都始于它。"
		""
		"之后，Mekanism 的 &eBins&r 会起到类似作用。参见 Mekanism 章节。"
	]
	quest.60409AD7ED6369BC.quest_subtitle: "一种物品，数量众多"
	quest.60409AD7ED6369BC.title: "储物抽屉"
	quest.606556DD47F9CD1E.quest_desc: [
		"由每种奇异物各一个在&e终极&r工作台里制作而成。"
		""
		"ICU 里没有任何东西使用它。就是个奖杯。"
	]
	quest.606556DD47F9CD1E.quest_subtitle: "每种物品各一个"
	quest.606556DD47F9CD1E.title: "终极奇点 (The Ultimate Singularity)"
	quest.60682097CE2F0712.quest_desc: [
		"下界工作台可将远古残骸、烈焰棒和火药转化为&e烈焰立方&r。"
		""
		"烈焰工具在运作时会熔炼、燃烧和灼烧。很有趣，但不是必需的。"
	]
	quest.60682097CE2F0712.quest_subtitle: "热门工具"
	quest.60682097CE2F0712.title: "烈焰方块"
	quest.606F40CCE784904B.quest_desc: [
		"装置上的一个讲台周围放置四个箱子，即可组成一个&e存储讲台&r，用于附近的物品合成。"
		""
		"Bookwyrm Charms 扩大了其范围。通过附魔了书本和羽毛笔的 &eRitual of Awakening&r 来获取它们。"
	]
	quest.606F40CCE784904B.quest_subtitle: "为你的箱子服务的图书管理员"
	quest.606F40CCE784904B.title: "书虫们"
	quest.60782FF3D72F2EA7.quest_desc: [
		"强化控制器需要重症监护室里的一个 &eAllthemodium Ingot&r。"
	]
	quest.60782FF3D72F2EA7.quest_subtitle: "强大的电力，更庞大的反应堆"
	quest.60782FF3D72F2EA7.title: "加固反应堆 Reinforced Reactor"
	quest.608929ED7AC1B534.quest_desc: [
		"每个&e奇点&r需要1,000个物品在Neutronium Compressor中。共有27种。"
		""
		"&eInfinity Catalyst&r需要每种一个（或一个Eternal Singularity）。&eBedrock&r来自同一压缩机中的10,000个Deepslate。"
		""
		"尽早启动压缩机，让自动化为其提供原料。"
	]
	quest.608929ED7AC1B534.quest_subtitle: "游戏后期有多长？How long is the endgame?"
	quest.608929ED7AC1B534.title: "奇点数学 (Singularity Math)"
	quest.60ACD6D756111A1C.quest_desc: [
		"&eSimulated Coasters&r 让你能用工字钢建造过山车轨道和车厢。"
		"&eSimulated Extra&r 添加了中心轮座（用普通轮座合成）。"
		"&eAeronautics Dyeable Components&r 让你可以染色轮胎和浮空石。"
	]
	quest.60ACD6D756111A1C.quest_subtitle: "好玩的部分来了"
	quest.60ACD6D756111A1C.title: "杯垫与额外物品"
	quest.60D47828CBCB4C24.quest_desc: [
		"在轨道末端放置一个&e轨道缓冲器&r，让火车知道该在哪里停靠。"
		""
		"用扳手改变样式，用染料点击以重新上色。"
	]
	quest.60D47828CBCB4C24.quest_subtitle: "线路的末端"
	quest.60D47828CBCB4C24.title: "轨道缓冲器"
	quest.619BBA783FEBDD85.quest_desc: [
		"&eMeka-Tool&r 由原子分解器、终极电路、HDPE 和 &e钋丸&r 制成。"
		""
		"波洛尼ウム来自核废料（见“发电机”章节）。在&e改装台&r中添加模块。"
		""
		"挖掘速度堪比&eAllthemodium 镐&r：振金镐可以，但Unobtainium镐还是需要振金镐。"
	]
	quest.619BBA783FEBDD85.quest_subtitle: "你将制作的最后一个工具是"
	quest.619BBA783FEBDD85.title: "Meka-Tool"
	quest.61A30BD0E36BB8EE.quest_desc: [
		"Prefab 能将物品变成完整的建筑。你第一次加入时得到了一个 &eHouse&r 物品。"
		""
		"右键地面，选择结构物品，选定样式，然后点击&e预览！&r查看位置，或&e建造！&r放置结构。右键任意方块可清除预览。"
	]
	quest.61A30BD0E36BB8EE.quest_subtitle: "只需添加地面即可"
	quest.61A30BD0E36BB8EE.title: "箱中建筑模组"
	quest.61CCB46CB2DE7099.quest_desc: [
		"四个威龙核心、两个觉醒的德拉科尼ウム和两个&e不可获取锭&r，围绕一颗下界之星融合而成。"
	]
	quest.61CCB46CB2DE7099.quest_subtitle: "龙之裔，完全觉醒状态"
	quest.61CCB46CB2DE7099.title: "觉醒核心"
	quest.61E0FD10585FB0EE.quest_desc: [
		"三个铁锭和一个木棍可以制作一个&e铁镰&r（也有从木头到下界合金的版本）。它能轻松割草、花和树叶。"
	]
	quest.61E0FD10585FB0EE.quest_subtitle: "庭院工作"
	quest.61E0FD10585FB0EE.title: "镰刀"
	quest.62469146B7BC2DAF.quest_desc: [
		"&e双翼机&r的配方需要：船体、船帆、引擎、螺旋桨和座椅。"
		""
		"速度快且相当可靠，但需要很长的跑道才能起飞。"
	]
	quest.62469146B7BC2DAF.quest_subtitle: "快速又有趣"
	quest.62469146B7BC2DAF.title: "双翼飞机"
	quest.62857046C814398D.quest_desc: [
		"九个中子堆可以合成一个&e中子锭&r，九个锭可以合成一个原矿。"
		""
		"收集者速度很慢，能负担得起后就多建几个吧。"
	]
	quest.62857046C814398D.quest_subtitle: "非常非常重"
	quest.62857046C814398D.title: "中子星锭"
	quest.62B2796C6FE8594D.quest_desc: [
		"采集 &eUtherium&r 晶体。Utherium 武器对 Rotspawn 造成 1.5 倍伤害。"
	]
	quest.62B2796C6FE8594D.quest_subtitle: "专为腐化而生"
	quest.62B2796C6FE8594D.title: "Utherium"
	quest.62B5C884645CE63A.quest_desc: [
		"&e鹿&r生活在森林和草原里。"
		""
		"先喂一个&e苹果&r，再喂一朵花。它就会边走边种下那朵花。"
	]
	quest.62B5C884645CE63A.quest_subtitle: "在花园里漫步的鹿群"
	quest.62B5C884645CE63A.title: "繁花盛开"
	quest.62CB8B7A2147057C.quest_desc: [
		"&eCompacting&r 可将9个锭直接压制成方块（及类似物品）。"
		"&e虚空&r会删除过滤器中你挑选的物品。鹅卵石、泥土、腐肉……再见！"
	]
	quest.62CB8B7A2147057C.quest_subtitle: "把它压扁或者扔进垃圾桶里"
	quest.62CB8B7A2147057C.title: "压缩与虚空 (Compacting and Void)"
	quest.6327D95646FCCC67.quest_desc: [
		"你的 Coke Oven 还会收集 &eCreosote Oil&r。将一桶油放在 8 块木板中间，可获得 8 块 &eTreated Wood Planks&r。"
		""
		"Create Spout 也行：每块木板 125 mB。"
	]
	quest.6327D95646FCCC67.quest_subtitle: "闻起来像是一条铁路的味道"
	quest.6327D95646FCCC67.title: "经过处理的木材"
	quest.632A4E9A0509A186.quest_desc: [
		"&e骑乘土豆炮&r使用与手持式相同的弹药，并且可以自动装填。"
		""
		"旋转充电，然后用红石脉冲激发。保持信号开启以实现自动激发。"
	]
	quest.632A4E9A0509A186.quest_subtitle: "更重型的火炮"
	quest.632A4E9A0509A186.title: "骑乘土豆加农炮"
	quest.63B29D294D539E41.quest_desc: [
		"将蒸汽从锅炉或核反应堆送入涡轮阀门，并提取电力。"
		""
		"如果无法合成，请对照游戏内指南或 JEI/EMI 信息标签页中的结构。"
	]
	quest.63B29D294D539E41.quest_subtitle: "涡轮机已上线"
	quest.63B29D294D539E41.title: "Spin It Up"
	quest.63B443FC933CC955.quest_desc: [
		"升到云层高度（Y 191至196），在那里使用一个空的玻璃瓶。"
		""
		"右键将&eBottled Cloud&r投向空中，它会生成一个可供建造的临时方块。非常适合建造桥梁和屋顶。"
	]
	quest.63B443FC933CC955.quest_subtitle: "从天而降的脚手架"
	quest.63B443FC933CC955.title: "瓶装云朵"
	quest.63EC6FE5AF70238B.quest_desc: [
		"五颗宝石（或锭）和两根木棍可以制作一把&e锤子&r。它能一次性挖掘3x3范围内的石头。潜行可挖掘单个方块。"
		""
		"它会跳过无法自行挖掘的方块和带有方块实体的方块，所以你的箱子是安全的。"
	]
	quest.63EC6FE5AF70238B.quest_subtitle: "挖掘一个 3x3 的区域"
	quest.63EC6FE5AF70238B.title: "是时候用锤子了"
	quest.6407C11112C419E7.quest_desc: [
		"&e空中飞艇&r的配方是：船帆、线、船体、引擎、一个创造螺旋桨和一个座位。"
		""
		"飞行速度较慢，但非常容易操控。是一款很棒的入门级真飞机。"
	]
	quest.6407C11112C419E7.quest_subtitle: "慢工出细活"
	quest.6407C11112C419E7.title: "空中飞艇"
	quest.64159C163DD13BF9.quest_desc: [
		"&eCrafting Upgrade&r 在背包界面中添加了一个 3x3 的网格。"
		"&eStonecutter Upgrade&r 添加了采石机。非常适合建筑师。"
	]
	quest.64159C163DD13BF9.quest_subtitle: "一个背上的工作坊"
	quest.64159C163DD13BF9.title: "随时随地合成物品"
	quest.6427F434865DD83B.quest_desc: [
		"用 Dreadrock、Utheric Cluster 和 Rogdorium 建造 &eInfuser&r。它能把 Utheric Cluster 变成 Utherium 等物品。"
	]
	quest.6427F434865DD83B.quest_subtitle: "我超爱附魔的，心都化了"
	quest.6427F434865DD83B.title: "The Infuser"
	quest.647C7B69C81E82D0.quest_desc: [
		"柳树&e垂向沼泽地和低洼地。&r"
		""
		"它们的&e柳藤&r只能用剪刀剪才能获得。藤蔓加圆石可以做成苔石。"
	]
	quest.647C7B69C81E82D0.quest_subtitle: "柳树和藤蔓"
	quest.647C7B69C81E82D0.title: "潮湿的木材"
	quest.648555CD970AF869.quest_desc: [
		"石砖可以制作&e现代&r、&e围栏&r、&e柱&r和&e草顶&r墙壁。大多数也可以通过切石机获得。"
		""
		"&6注意：&r&e带电&r围栏看起来很酷，但会刮伤任何靠近的东西。小心你的宠物。"
	]
	quest.648555CD970AF869.quest_subtitle: "鹦鹉螺之壁"
	quest.648555CD970AF869.title: "带风格的墙壁"
	quest.648675D99D9FD83F.quest_desc: [
		"怪物会掉落&eInfernal Forge&r。右键点击方块可摧毁周围的一切。"
	]
	quest.648675D99D9FD83F.quest_subtitle: "这是一把镐子。真的，是一把镐子。"
	quest.648675D99D9FD83F.title: "炼狱熔炉"
	quest.649B14F59BCBFF74.quest_desc: [
		"Draconium、一个能量核心稳定器、Draconium 核心和一个附魔台。"
		""
		"将工具和盔甲放入其中，即可通过你的电力网络为其充能。"
	]
	quest.649B14F59BCBFF74.quest_subtitle: "一个充电站"
	quest.649B14F59BCBFF74.title: "能量转换器 (Energy Transfuser)"
	quest.64AE69B167CA913C.quest_desc: [
		"泥土、沙子、砾石、鹅卵石、黏土、一个雪球、一个草方块、一颗钻石和一个金锭。"
		""
		"选择一个生物群系，&eBiome Pet&r会指引你前往。非常适合在Biomes O' Plenty中狩猎。"
	]
	quest.64AE69B167CA913C.quest_subtitle: "丛林在哪里？"
	quest.64AE69B167CA913C.title: "生物群系宠物"
	quest.64C11D2A1E5DB6FC.quest_desc: [
		"外壳由 &eFusion Reactor Frames&r 制成，顶部有 &eController&r，燃料和电源接口为 &ePorts&r，还有用于瞄准激光的 &eLaser Focus Matrix&r。具体形状请查看游戏内指南。"
		""
		"框架需要钋，控制器需要一个&e终极控制电路&r。"
	]
	quest.64C11D2A1E5DB6FC.quest_subtitle: "装在盒子里的星星"
	quest.64C11D2A1E5DB6FC.title: "聚变反应堆"
	quest.64CB83C036C5163C.quest_desc: [
		"将一桶牛奶倒入炼药锅中等待。它会变成一块&e奶酪块&r。"
		""
		"把它分成四份 &e奶酪&r。老鼠很喜欢。"
	]
	quest.64CB83C036C5163C.quest_subtitle: "牛奶放进去，奶酪就出来了"
	quest.64CB83C036C5163C.title: "说声“茄子”"
	quest.64D83C7D33030807.quest_desc: [
		"在末影珍珠周围放置四个 Allthemodium 锭。潜行状态下空手右键点击它。"
		""
		"在主世界，它会去到 &eMining dimension&r，在末地，去到 &eThe Other&r，而在虚空，去到 &eThe Beyond&r。"
	]
	quest.64D83C7D33030807.quest_subtitle: "一个方块里有三个门"
	quest.64D83C7D33030807.title: "传送平台"
	quest.64E8584C4189ABB8.quest_desc: [
		"&eCopy Paste Gadget&r可以复制一个区域并粘贴到别处。而&eTemplate Manager&r可以保存和共享副本。"
	]
	quest.64E8584C4189ABB8.quest_subtitle: "建造一次即可"
	quest.64E8584C4189ABB8.title: "复制粘贴"
	quest.64F2F8B0D7F591BC.quest_desc: [
		"大多数生物群系中偶尔会出现远古木树，外面还有成片的远古木森林。"
		""
		"共有四种颜色：&eVexing&r（紫色）、&eBlazing&r（红色）、&eCascading&r（蓝色）和&eFlourishing&r（绿色）。仪式需要使用特定的原木，找到后每种都多收集一些。"
	]
	quest.64F2F8B0D7F591BC.quest_subtitle: "魔法在树上生长着"
	quest.64F2F8B0D7F591BC.title: "远古木树 (Archwood Trees)"
	quest.65036DD81C0D3229.quest_desc: [
		"将物品放入顶部槽位，&e冷凝器&r就能将 EMC 转化为更多 EMC。"
		""
		"在 &eSculk 工作台&r 中制作：黑曜石、钻石和一个 Alchemical Chest，上面放一个 &eAllthemodium Ingot&r，下面放一个 &eDragon Heart&r。心脏会被消耗掉。"
		""
		"用收集器和中继器喂养它，实现无人值守的复制机。"
	]
	quest.65036DD81C0D3229.quest_subtitle: "复印机"
	quest.65036DD81C0D3229.title: "能量冷凝器"
	quest.65118EC1E09CD85F.quest_desc: [
		"&eLogistical Transporters&r 负责运输物品。而 &eLogistical Sorter&r 会从物品栏中取出物品，并发送到过滤器指定的位置。"
		""
		"使用 Configurator 为传送器设置颜色代码，以保持线路分离。"
	]
	quest.65118EC1E09CD85F.quest_subtitle: "带有大脑的物品管道"
	quest.65118EC1E09CD85F.title: "物流运输机 (Logistical Transporters)"
	quest.653C7A27019FD69D.quest_desc: [
		"反应堆需要 &e反应堆棒&r、用于装载燃料的 &e燃料接收器&r 以及用于导出热量的 &e散热口&r。"
		""
		"&6注意：&r它会释放辐射（穿戴皮革盔甲或用反应堆外壳和玻璃密封），如果没有任何东西利用热量，它会发生熔毁。"
	]
	quest.653C7A27019FD69D.quest_subtitle: "小心轻放"
	quest.653C7A27019FD69D.title: "核反应堆 Nuclear Reactor"
	quest.654E1FCE7766162C.quest_desc: [
		"装有操控精华和&eME接口&r的源罐可制成&eME源罐&r。"
		""
		"旁边的 Ars machines 会看到你网络中存储的 Source。"
	]
	quest.654E1FCE7766162C.quest_subtitle: "你的网络现在是一个存档文件了"
	quest.654E1FCE7766162C.title: "ME Source Jar"
	quest.655CD34274BBEEDA.quest_desc: [
		"玻璃和拱木板可以制作一个&e源罐&r。源链接会填满它，附近的机器会从中汲取。"
		""
		"罐子会根据装满程度发出比较器信号，这对自动化很有用。"
	]
	quest.655CD34274BBEEDA.quest_subtitle: "一个用于魔法的容器"
	quest.655CD34274BBEEDA.title: "源 Jar 文件"
	quest.658AF7B9CD47AE39.quest_desc: [
		"混沌岛屿位于末地的远方，大约每隔10000个方块出现一个。每个岛屿上都有一位&e混沌守护者&r。"
		""
		"先打掉它的守护水晶。带上龙裔盔甲、盾牌和大量食物。"
	]
	quest.658AF7B9CD47AE39.quest_subtitle: "真正的最终首领登场了"
	quest.658AF7B9CD47AE39.title: "混沌守护者 (The Chaos Guardian)"
	quest.65C4277169031140.quest_desc: [
		"许多宠物配方都用到 nugget。一个煤炭能制作八个 &eCoal Nuggets&r，一颗钻石能制作九个 &eDiamond Nuggets&r。"
		""
		"绿宝石、末影、黑曜石和青金石块也可以从它们的完整物品中获得。"
	]
	quest.65C4277169031140.quest_subtitle: "小改动"
	quest.65C4277169031140.title: "宠物小颗粒（Pet Nuggets）"
	quest.65C9F6ECE189DCB8.quest_desc: [
		"&eInferium Essence&r 会从生物和 Inferium 矿石（Y 坐标 -32 到 64 之间）中掉落。模组里几乎所有东西都用它。"
		""
		"备上一两组，以备不时之需。"
	]
	quest.65C9F6ECE189DCB8.quest_subtitle: "绿色的东西"
	quest.65C9F6ECE189DCB8.title: "Inferium 精华"
	quest.65D1F5181CA8625B.quest_desc: [
		"四场盛宴结束。你的基地正式成为最佳用餐地点。"
		""
		"在大战前摆上一桌丰盛的宴席，让大家吃好喝好。"
	]
	quest.65D1F5181CA8625B.quest_subtitle: "整个页面都布满了各种各样的东西"
	quest.65D1F5181CA8625B.title: "顶级厨师"
	quest.65EB7C3A913C5D9E.quest_desc: [
		"在赞石宝石周围放置八个霍尔石。用安布罗修姆碎片为其提供燃料。"
		""
		"祭坛可以附魔特殊的Aether物品，并修复损坏的装备。"
	]
	quest.65EB7C3A913C5D9E.quest_subtitle: "Aether 附魔台"
	quest.65EB7C3A913C5D9E.title: "祭坛 (The Altar)"
	quest.65F72106DBF341D3.quest_desc: [
		"四份 Inferium Essence 围绕一个 Infusion Crystal 可合成一份 &ePrudentium Essence&r。"
	]
	quest.65F72106DBF341D3.quest_subtitle: "Tier 2 精华"
	quest.65F72106DBF341D3.title: "审慎（Prudentium）"
	quest.664071736B781B56.quest_desc: [
		"在工作台用&e模具&r蓝图制作模具。板料模具需要三块钢板和一把钢丝钳。"
		""
		"光这个电线模具就能省去大量的合成步骤。"
	]
	quest.664071736B781B56.quest_subtitle: "选择你的形状"
	quest.664071736B781B56.title: "压制模具"
	quest.665F1D37763FB4DD.quest_desc: [
		"三个都倒下后，高地的酸雨就会停止。"
		""
		"暮色森林的最后一小段路程已经开启。"
	]
	quest.665F1D37763FB4DD.quest_subtitle: "九头蛇，远古恶魂，雪后"
	quest.665F1D37763FB4DD.title: "终极对决"
	quest.66682B23AFE3DB27.quest_desc: [
		"&e蓝花楹&r树在蓝花楹林和薰衣草田中绽放。"
		""
		"The Lavender Field is also where the &eLavender&r grows. One sprig makes purple dye."
	]
	quest.66682B23AFE3DB27.quest_subtitle: "蓝花楹和薰衣草"
	quest.66682B23AFE3DB27.title: "紫色真漂亮"
	quest.667DF312C8FE9372.quest_desc: [
		"将魔法豆种在云层下的发光 &eUberous Soil&r 上，一根巨大的豆茎便会拔地而起。"
	]
	quest.667DF312C8FE9372.quest_subtitle: "长大点。再长大点。再高一点。"
	quest.667DF312C8FE9372.title: "杰克与豆茎的故事"
	quest.668F4EA640C05841.quest_desc: [
		"来自三个世界的合成配方：两个 Enchanted Gravitite、一个 Aether 的 Victory Medal 和 &eSun Altar&r、两个 Undergarden 的 Forgotten Ingot 和 Utherium Crystal，以及一个 Deep Dark 的 Echo Shard。"
	]
	quest.668F4EA640C05841.quest_subtitle: "头顶是天空，脚下是花园"
	quest.668F4EA640C05841.title: "Realms 封印"
	quest.66AF25D71786C2DD.quest_desc: [
		"&6ICU 配方：&r 一个 Niotic Crystal 是一个钻石加上一个 &eIgnitium Ingot&r，并注入能量。"
		""
		"Niotic 细胞由 Blazing 细胞建造，所以请保持攀爬顺序。"
	]
	quest.66AF25D71786C2DD.quest_subtitle: "需要 Ignitium 才能完成此任务"
	quest.66AF25D71786C2DD.title: "Niotic 等级"
	quest.66BA13DD31142528.quest_desc: [
		"点击即可更改天气和白天黑夜的时间。"
		""
		"&6注意：&r它需要消耗一个&e龙之蛋&r，极限工作台也需要一个。在花费你的蛋之前，先检查EMI以寻找获取额外蛋的其他方法。"
	]
	quest.66BA13DD31142528.quest_subtitle: "让天气变得晴朗起来吧"
	quest.66BA13DD31142528.title: "天体操纵器"
	quest.66FCE54DD62182B9.quest_desc: [
		"在锻造台里用下界合金升级和下界合金锭升级一把 Pickarang。"
		""
		"挖掘速度如下界合金，更耐用，携带的物品不会被岩浆烧毁。专为下界而生。"
	]
	quest.66FCE54DD62182B9.quest_subtitle: "太烫手了，无法处理"
	quest.66FCE54DD62182B9.title: "火焰回旋镖"
	quest.6722F598D104C85D.quest_desc: [
		"末地城市里藏着&e鞘翅&r。飞行能让在外围岛屿寻找不可得之物的过程轻松许多。"
	]
	quest.6722F598D104C85D.quest_subtitle: "末地高原的面积很大"
	quest.6722F598D104C85D.title: "翅膀"
	quest.675392330A102739.quest_desc: [
		"&e速度升级&r（锇粉）能让机器运行得更快。 &e能量升级&r（金粉）能降低它们的功耗。"
		""
		"一台机器最多可容纳八种各一个。提高速度会增加功耗，因此请搭配能源升级使用。"
	]
	quest.675392330A102739.quest_subtitle: "更快、更便宜、更出色"
	quest.675392330A102739.title: "机器升级"
	quest.67733CE4C96CD3AD.quest_desc: [
		"MEGA 64M 存储组件的中间需要一个 &eAllthemodium Ingot&r。"
	]
	quest.67733CE4C96CD3AD.quest_subtitle: "更多字节"
	quest.67733CE4C96CD3AD.title: "MEGA 64M"
	quest.67764C6F56C169F3.quest_desc: [
		"&e基础冶炼厂&r是一个装有基础合金、基础电路和周围环绕着铁的能源熔炉。"
		""
		"一次可以处理三组物品。其他机器也有工厂。"
	]
	quest.67764C6F56C169F3.quest_subtitle: "一台机器，三种功能"
	quest.67764C6F56C169F3.title: "你的第一座工厂"
	quest.677BED4BBF094F34.quest_desc: [
		"找到一个&e苍白花园&r：苍白橡树、苍白苔藓和垂吊苔藓，全部呈灰色。"
		""
		"苍白橡木有一套完整的木制物品，从木板到木船。"
	]
	quest.677BED4BBF094F34.quest_subtitle: "一片灰暗而宁静的森林"
	quest.677BED4BBF094F34.title: "苍白花园"
	quest.678C64C276D03B59.quest_desc: [
		"七个永恒燃料和一个围绕钻石块的&eAllthemodium Nugget&r。暗物质是ProjectE的终局内容基础。"
	]
	quest.678C64C276D03B59.quest_subtitle: "现在我们开始烹饪了"
	quest.678C64C276D03B59.title: "暗物质"
	quest.67B8D34729E18CA4.quest_desc: [
		"&eBoiler&r 将蒸汽机堆叠在流体储罐和烈焰燃烧器上。"
		""
		"飞行器需要燃料。将煤炭或其他可燃物品放入燃料槽。"
	]
	quest.67B8D34729E18CA4.quest_subtitle: "腹中燃起熊熊烈火"
	quest.67B8D34729E18CA4.title: "锅炉"
	quest.67D6A7530C68755F.quest_desc: [
		"将龙晶注射器与&e威龙核心&r、龙晶核心、钻石和龙晶方块融合。"
		""
		"Wyvern-tier 配方需要 Wyvern injector 来提供材料。核心屏幕会提示你缺少哪些材料。"
	]
	quest.67D6A7530C68755F.quest_subtitle: "二级融合（Tier two fusion）"
	quest.67D6A7530C68755F.title: "Wyvern 注射器"
	quest.67D7757312DAE6DE.quest_desc: [
		"Amendments 是 Supplementaries 的小兄弟。它会改变原版方块："
		"灯笼挂在墙上，旗帜挂在天花板上，花盆也挂着，地毯铺在楼梯和台阶上。"
		"将染料倒入炼药锅中，将物品浸入其中。物品会显示在悬挂的告示牌上。火药可以投掷。"
	]
	quest.67D7757312DAE6DE.quest_subtitle: "原版，已调整"
	quest.67D7757312DAE6DE.title: "Amendments"
	quest.687FE2582FF1C175.quest_desc: [
		"&e漏斗&r将物品从传送带上抽出，并从物品栏中取出。 &e隧道&r位于传送带上，将物品分配到不同轨道。"
		""
		"用扳手右键漏斗可以翻转其方向。"
	]
	quest.687FE2582FF1C175.quest_subtitle: "进进出出"
	quest.687FE2582FF1C175.title: "漏斗与隧道"
	quest.68873101C013BD18.quest_desc: [
		"制作一个&eConductor's Cap&r，然后检查它的Ponder（按住&eW&r）来了解它和Andesite Casing如何变成一个&eConductor&r。"
		""
		"佩戴匹配的帽子，列车员可以驾驶火车，并按下你注视的按钮或拉杆。"
	]
	quest.68873101C013BD18.quest_subtitle: "微型火车工作人员"
	quest.68873101C013BD18.title: "导体 (Conductors)"
	quest.68BF43564380D1F8.quest_desc: [
		"羊毛和羽毛可制作 16 个 &eCushions&r。一份羊毛可制作八个 &eSheets&r。将其中任意一种染成任何颜色。"
		""
		"右键家具并使用它们来重新装饰：椅子、沙发和床的靠垫，床单的床单等。"
	]
	quest.68BF43564380D1F8.quest_subtitle: "软装家具"
	quest.68BF43564380D1F8.title: "枕头和床单"
	quest.68C9A9317797E1DB.quest_desc: [
		"铁、木板和一个分配器（或者弹弓和红石）可以制作一个&e大炮&r。"
		""
		"火药是弹药，几乎任何东西都可以当炮弹。跳上船瞄准吧。把炮装在船上，就能得到一艘&e炮艇&r。"
	]
	quest.68C9A9317797E1DB.quest_subtitle: "可以射中任何东西"
	quest.68C9A9317797E1DB.title: "大炮"
	quest.68D95C4CBAAC1224.quest_desc: [
		"&e太阳能加热板&r在白天产生热量，而&e热管道&r则负责输送热量。"
		"一个带有下方热源的&e斯特林发动机&r会旋转，热量越多转得越快。"
		""
		"&6注意：&r过热的方块会变成岩浆。别弄过头了。"
	]
	quest.68D95C4CBAAC1224.quest_subtitle: "阳光旋转，带来好运"
	quest.68D95C4CBAAC1224.title: "热能和斯特林发动机"
	quest.68DCFF8165C83A6C.quest_desc: [
		"ICU的&e64M&r和&e256M&r储能组件配方，将&eAllthemodium Ingot&r放在了玻璃的位置，就像MEGA 64M和256M储能组件一样。"
		""
		"这就是三级储能装置了。"
	]
	quest.68DCFF8165C83A6C.quest_subtitle: "里面的 Allthemodium 方块"
	quest.68DCFF8165C83A6C.title: "64M 和 256M"
	quest.692B4216D303F7C8.quest_desc: [
		"&eCrusher&r能将锭磨成粉，并将植物转化为&eBio Fuel&r。"
		""
		"之后它还会将 Clumps 在 3x 矿石线上转化为 Dirty Dust。"
	]
	quest.692B4216D303F7C8.quest_subtitle: "把它砸成粉末吧"
	quest.692B4216D303F7C8.title: "破碎机"
	quest.693BC7A0AAC4EBBA.quest_desc: [
		"Allthemodium 矿石适用于 Mekanism 的矿石链：富集成粉尘，提纯成块，直至晶体。"
		""
		"每向上一步，每块矿石能得到的锭就越多。不要只冶炼原矿石！"
	]
	quest.693BC7A0AAC4EBBA.quest_subtitle: "Mekanism 知道这些矿石"
	quest.693BC7A0AAC4EBBA.title: "将你的 Allthemodium 数量增加两倍"
	quest.6955163FF33AC497.quest_desc: [
		"熔炉燃烧燃料产生能量，能量电池则负责储存。廉价、简单，目前够用。"
	]
	quest.6955163FF33AC497.quest_subtitle: "燃烧物品，获取能量"
	quest.6955163FF33AC497.title: "Powah！入门电力包"
	quest.69A0F32969E9A980.quest_desc: [
		"将充能证书、铁锭和&e天空石&r块一起投入岩浆以获取&e天空钢&r。"
	]
	quest.69A0F32969E9A980.quest_subtitle: "来自星星的金属"
	quest.69A0F32969E9A980.title: "Sky Steel"
	quest.69B9D77AE25CEB0F.quest_desc: [
		"制作一个&e催化剂&r（铜、石头和末影珍珠），建造一个石砖框架，然后用催化剂作用于它。"
	]
	quest.69B9D77AE25CEB0F.quest_subtitle: "向下，再向下，更向下"
	quest.69B9D77AE25CEB0F.title: "地下花园（The Undergarden）"
	quest.69CD3908AEFC31FA.quest_desc: [
		"&eMooblooms&r 会出现在花丛森林和草地中。有了 &eFlowery Mooblooms&r，每种原版花朵都有一种，别忘了留意全部十六种。"
		""
		"Shear one. &6注意：&rBuzzier Bees 在 Sunflower Plains 有自己的 Moobloom。这里只算 Friends and Foes 的。"
	]
	quest.69CD3908AEFC31FA.quest_subtitle: "牛身上的花朵装饰物"
	quest.69CD3908AEFC31FA.title: "MooBoom！"
	quest.69E3B7FDF552CF87.quest_desc: [
		"黄铜需要一个加热的盆，而加热需要烈焰。这意味着要去一趟下界。"
		""
		"去的时候顺便拿点&e下界石英&r。AE2和Create都喜欢用。"
	]
	quest.69E3B7FDF552CF87.quest_subtitle: "如果你有，就带上火焰抗性药水包"
	quest.69E3B7FDF552CF87.title: "一次快速的下界之旅"
	quest.6A0BCDBF8FA1FFBA.quest_desc: [
		"在 &eSculk Crafting Table&r 中制作：黑曜石、石头、你的贤者之石和一个 &eSmall Chaos Fragment&r。"
		"混沌碎片来自混沌水晶，而水晶只有在&e混沌守卫&r死亡后才会破碎。"
		""
		"将物品放入&eburn&r中：你就能学会它并获得其EMC。之后你可以花费EMC来制造你所学物品的副本。"
	]
	quest.6A0BCDBF8FA1FFBA.quest_subtitle: "学习它，创造它"
	quest.6A0BCDBF8FA1FFBA.title: "转换桌（Transmutation Table）"
	quest.6A0F7AA546EFA284.quest_desc: [
		"&e远古卷轴&r是堡垒宝藏室、林地府邸、远古城市和 Quark 的地下&e怪物宝箱&r中的稀有物品。"
		""
		"将带有相同附魔的物品或书与铁砧组合。这样可以将该附魔提升至正常上限以上一级。"
	]
	quest.6A0F7AA546EFA284.quest_subtitle: "突破等级上限"
	quest.6A0F7AA546EFA284.title: "古代卷轴 (Ancient Tomes)"
	quest.6A670692143677CC.quest_desc: [
		"&e海盗村庄&r建在海洋上。去拿艘船找找看。"
	]
	quest.6A670692143677CC.quest_subtitle: "Yo ho ho"
	quest.6A670692143677CC.title: "海盗村庄"
	quest.6A9B31435769EE44.quest_desc: [
		"普通的螺旋桨轴承不适用于直升机。 &e陀螺螺旋桨轴承&r会试图保持其旋翼朝上。"
		""
		"用红石为其供电，将倾斜度重置为零。"
	]
	quest.6A9B31435769EE44.quest_subtitle: "保持直立姿势"
	quest.6A9B31435769EE44.title: "直升机！"
	quest.6AB77D24116E76E5.quest_desc: [
		"右键点击任意电缆，使用&eNetwork Tool&r即可查看功耗、频道和网络中的所有设备。"
	]
	quest.6AB77D24116E76E5.quest_subtitle: "里面到底在发生什么事情？"
	quest.6AB77D24116E76E5.title: "网络工具"
	quest.6AB7E787E86DAEAB.quest_desc: [
		"有时，老鼠会掉落一个&eChunky Cheese Token&r。"
		""
		"Use it anywhere and it opens a portal to &eRatlantis&r, the lost city of the rats."
	]
	quest.6AB7E787E86DAEAB.quest_subtitle: "一只老鼠掉下了什么东西，闪闪发光"
	quest.6AB7E787E86DAEAB.title: "Chunky Cheese 代币"
	quest.6AC50BD45AA6D92D.quest_desc: [
		"在冶金注入器中，将精炼黑曜石注入强化合金。"
	]
	quest.6AC50BD45AA6D92D.quest_subtitle: "终极电路需要两个组件才能完成"
	quest.6AC50BD45AA6D92D.title: "原子合金"
	quest.6AC622E35315BD18.quest_desc: [
		"将 Certus 水晶放入已充能的 &e充电器&r中。还没充能？顶部的 &e木制曲柄&r可以手动操作。"
	]
	quest.6AC622E35315BD18.quest_subtitle: "噼啪作响的能量"
	quest.6AC622E35315BD18.title: "带电的切尔图斯矿石"
	quest.6ADDAD46F544586E.quest_desc: [
		"&e亚麻种子&r会出现在掠夺者前哨和沉船宝箱中，流浪商人也会出售。破坏&e野生亚麻&r可获得更多。"
		""
		"像其他作物一样种植它们。亚麻可以制作绳索、麻袋、遮阳篷等。"
	]
	quest.6ADDAD46F544586E.quest_subtitle: "有用的杂草"
	quest.6ADDAD46F544586E.title: "亚麻纤维"
	quest.6ADE1A26230BBC8A.quest_desc: [
		"Environmental 的樱花树会掉落 &eCherries&r。两个小麦和一个樱桃可以制作一个 &eCherry Cookie&r。"
	]
	quest.6ADE1A26230BBC8A.quest_subtitle: "Sweet little snack"
	quest.6ADE1A26230BBC8A.title: "樱桃（Cherries）"
	quest.6AFB48DBE55A730B.quest_desc: [
		"铜、熔炉和红石块可以制作一个&e铜发电机&r。它能燃烧熔炉能烧的一切东西。"
		""
		"廉价又简单。本模组中的每个发电机都由前一个升级而来。"
	]
	quest.6AFB48DBE55A730B.quest_subtitle: "燃料输入，动力输出"
	quest.6AFB48DBE55A730B.title: "铜制发电机"
	quest.6B2A95D879B5A0D0.quest_desc: [
		"烹饪锅中加入三个&eUnderbeans&r和一个碗。简单又管饱。"
	]
	quest.6B2A95D879B5A0D0.quest_subtitle: "豆子，豆子，豆子"
	quest.6B2A95D879B5A0D0.title: "Underbean 火锅"
	quest.6B2DB3031320371B.quest_desc: [
		"Ambrosium 火把周围环绕着八个 Holystone。它以 Ambrosium 火把为燃料燃烧。"
		""
		"孵化你的蛋，养育你自己的Moa。这需要一些时间，请耐心等待。"
	]
	quest.6B2DB3031320371B.quest_subtitle: "保持温暖"
	quest.6B2DB3031320371B.title: "孵化器"
	quest.6B5CCD68B14D3EA1.quest_desc: [
		"&e安布罗修姆碎片&r是祭坛的燃料，吃掉后能恢复少量生命值。"
		""
		"将其中一个放在 Skyroot Stick 上，即可制作 Ambrosium Torch。"
	]
	quest.6B5CCD68B14D3EA1.quest_subtitle: "来自以太的煤炭"
	quest.6B5CCD68B14D3EA1.title: "安布罗修姆（Ambrosium）"
	quest.6B6AA141D95F4849.quest_desc: [
		"潜声催化器能将黑曜石、深板岩、滴水石和潜声催化剂制成&e加固深板岩&r。"
		""
		"极限工作台需要四个。其余清单：信标、磁石、海洋之心、恢复指南针、龙之蛋和两个 &eUnobtainium Ingots&r。"
	]
	quest.6B6AA141D95F4849.quest_subtitle: "终于可以制作了，难得一次"
	quest.6B6AA141D95F4849.title: "加固的深层板岩"
	quest.6B84C3F741751719.quest_desc: [
		"用锯子将铜板切成&e铜线&r。将&e电气连接器&r安装在机器上，并用电线连接它们。"
		""
		"连接器有“拉取”模式（用扳手开启），可从其他模组的方块中吸取能量。"
	]
	quest.6B84C3F741751719.quest_subtitle: "获取电力供应，确保各处都有电用"
	quest.6B84C3F741751719.title: "线路连接"
	quest.6B9A0083A86069E9.quest_desc: [
		"无需走到每个网络提供者处，即可查看和编辑其中的模式。"
	]
	quest.6B9A0083A86069E9.quest_subtitle: "每个图案，一个屏幕"
	quest.6B9A0083A86069E9.title: "模式访问终端"
	quest.6BB2B5CDEF475C36.quest_desc: [
		"把它熔炼了。这是梯子上最后一种金属。"
	]
	quest.6BB2B5CDEF475C36.quest_subtitle: "已获得！"
	quest.6BB2B5CDEF475C36.title: "Unobtainium Ingot"
	quest.6BDDC611EDF396D4.quest_desc: [
		"&eFE 存储单元&r可将能量储存在你的 ME 系统中。一个 &eFlux 存取器&r能让机器从中取能或向其推能。"
	]
	quest.6BDDC611EDF396D4.quest_subtitle: "将电力储存在网络中"
	quest.6BDDC611EDF396D4.title: "Applied Flux"
	quest.6BE06D4B362B8737.quest_desc: [
		"森林里的小土堆是空的！里面有红帽怪、刷怪器和装有矿石磁铁、转化粉末等物品的箱子。"
		""
		"在小型空心山丘内击败一只红帽怪。"
	]
	quest.6BE06D4B362B8737.quest_subtitle: "草地下的宝藏"
	quest.6BE06D4B362B8737.title: "Hollow Hills"
	quest.6BF7CA92CEF2D4F5.quest_desc: [
		"Friends and Foes 为几乎所有木材都添加了蜂巢：上下两排是木板，中间是三块蜂巢。"
		""
		"收集所有十一块，包括橡木在内。"
	]
	quest.6BF7CA92CEF2D4F5.quest_subtitle: "每个蜂巢（beehive）"
	quest.6BF7CA92CEF2D4F5.title: "成为守护者"
	quest.6C1EE4B457F65A88.quest_desc: [
		"在优质矿床上方建造&e挖掘机&r及其铲斗轮。它能永久地从矿脉中挖掘矿石，无需采矿。"
		""
		"它很耗电，所以带上高压工具。"
	]
	quest.6C1EE4B457F65A88.quest_subtitle: "一个巨大的桶式轮子"
	quest.6C1EE4B457F65A88.title: "挖掘机"
	quest.6C200C7451EE5424.quest_desc: [
		"用沙子、末影粉、红石、萤石和天空石粉合成一个&eEntro Seed&r，然后将其培育成 Entro Crystals。"
		""
		"EMI 展示了种子的生长过程。"
	]
	quest.6C200C7451EE5424.quest_subtitle: "ExtendedAE 的晶体"
	quest.6C200C7451EE5424.title: "熵晶（Entro Crystals）"
	quest.6C3735CE6F3C6AAA.quest_desc: [
		"&e探险家指南针&r指向各种结构，包括首领竞技场和地牢。而&e自然指南针&r则能帮你找到不同的生物群系。"
		""
		"飞往那里：Immersive Aircraft 和 Create 的飞艇能快速覆盖长距离。"
	]
	quest.6C3735CE6F3C6AAA.quest_subtitle: "停止漫无目的地游荡"
	quest.6C3735CE6F3C6AAA.title: "寻找首领和生物群系"
	quest.6C801B36126455FA.quest_desc: [
		"需要一个&e终极控制电路&r。处于相同频率的两个纠缠传送器可以共享物品、流体、气体、能量和热量。"
		""
		"它也能在不同维度之间正常工作。"
	]
	quest.6C801B36126455FA.quest_subtitle: "所有东西都无线化"
	quest.6C801B36126455FA.title: "量子纠缠传送器"
	quest.6C8EDC8A2F00D83F.quest_desc: [
		"&eThermo Generator&r 放置在熔岩等高温方块或流体上时会产生电力。"
		""
		"它还需要水这样的冷却剂才能运行。"
	]
	quest.6C8EDC8A2F00D83F.quest_subtitle: "下热上冷"
	quest.6C8EDC8A2F00D83F.title: "热能发电机"
	quest.6CF1EF22EDC87564.quest_desc: [
		"Allthemodium 矿石藏在主世界的 &eDeep Dark&r 里。潜行吧，小心 Warden。"
	]
	quest.6CF1EF22EDC87564.quest_subtitle: "嘘。别把它吵醒了。"
	quest.6CF1EF22EDC87564.title: "深层黑暗挖掘"
	quest.6D070A6EFF2E1925.quest_desc: [
		"在装置上放置一个源罐、四根烈焰棒、两块黑曜石、羊毛和一个末影珍珠（9000源）可以制作一个&e末影源罐&r。"
		""
		"同色玻璃瓶共享一个源存储，位于任意位置。在瓶盖上使用钻石即可独占该存储。"
	]
	quest.6D070A6EFF2E1925.quest_subtitle: "一个水池，多个地点"
	quest.6D070A6EFF2E1925.title: "末影源质罐"
	quest.6D097F64F6C05A4C.quest_desc: [
		"九种作物包放入木箱或麻袋块中：苹果、土豆、胡萝卜、甜菜根、可可、浆果、下界疣等。"
		""
		"&e木炭块&r能熔炼80个物品，像下界岩一样永远燃烧。而&e金苹果箱&r甚至能当信标底座用。"
	]
	quest.6D097F64F6C05A4C.quest_subtitle: "整理储物方块"
	quest.6D097F64F6C05A4C.title: "木箱与麻袋"
	quest.6D41968CE40F97D5.quest_desc: [
		"两颗宝石、一块相同材质的方块和两根木棍可以制作一把&e树斧&r。"
		""
		"砍下一根原木，整棵树就会随之倒下。"
	]
	quest.6D41968CE40F97D5.quest_subtitle: "伐木机启动！"
	quest.6D41968CE40F97D5.title: "树木斧头"
	quest.6D4AC32710B647BE.quest_desc: [
		"乏燃料会产出为 &e青金石&r。设置第二个访问端口到出口（或翻转你的端口）以收集它。"
		""
		"涡轮机是用青金石做的，所以不要把它扔掉。"
	]
	quest.6D4AC32710B647BE.quest_subtitle: "带有使用次数的废料"
	quest.6D4AC32710B647BE.title: "青金石矿石"
	quest.6D4AC6E5FF1F993A.quest_desc: [
		"&e拾取升级&r能将你走过的物品直接吸入背包。"
		"&e过滤升级&r决定了物品的进出，用漏斗时很方便。"
	]
	quest.6D4AC6E5FF1F993A.quest_subtitle: "只有好东西才能留下，其他的全部扔掉"
	quest.6D4AC6E5FF1F993A.title: "拾取与过滤"
	quest.6D6E5EBA7A8DD7B0.quest_desc: [
		"旋转的&e螺旋桨&r会产生推力。从一个&e安山岩螺旋桨&r（一个创造螺旋桨、一个半砖和一个轴）开始。它在合成网格中会变成木制螺旋桨，然后再变回来。"
		""
		"反转旋转，或使用扳手来反转推力。"
	]
	quest.6D6E5EBA7A8DD7B0.quest_subtitle: "推动一些空气方块出来"
	quest.6D6E5EBA7A8DD7B0.title: "螺旋桨"
	quest.6D79C3ECCCF33B91.quest_desc: [
		"安装在移动装置上的&e机械钻头&r会挖掘其前方的任何东西。"
		""
		"在装置里加个箱子就能收集掉落物。一个简单的活塞隧道钻探机是很棒的初次建造。"
	]
	quest.6D79C3ECCCF33B91.quest_subtitle: "隧道掘进机"
	quest.6D79C3ECCCF33B91.title: "机械钻头"
	quest.6D84B892F83D251B.quest_desc: [
		"全部在溶解室用乳胶制作而成："
		"&e范围&r：红石、玻璃板和四种材料。原石最小，绿宝石最大。"
		"&e速度&r：齿轮和糖。 &e效率&r：齿轮和烈焰棒。"
		"右键机器的附加组件槽位以安装它们。"
	]
	quest.6D84B892F83D251B.quest_subtitle: "更大、更快、更便宜"
	quest.6D84B892F83D251B.title: "机器附加组件"
	quest.6D8E463815D8A7CD.quest_desc: [
		"&e灵魂石&r遍布下界的大型矿脉中。 &e索利乌姆矿石&r就藏在这些矿脉里。"
		""
		"平滑灵魂石可熔炼成灵魂粉尘，而索利乌姆矿石可熔炼成索利乌姆粉尘。"
	]
	quest.6D8E463815D8A7CD.quest_subtitle: "一块下界岩"
	quest.6D8E463815D8A7CD.title: "灵魂石"
	quest.6DB557B09C22E77C.quest_desc: [
		"将 &eInfinity Range Booster&r 放入无线接入点即可移除距离限制。"
		""
		"三个无线增强器、两个末影之眼、三个下界合金锭和一个&e下界之星&r。"
	]
	quest.6DB557B09C22E77C.quest_subtitle: "无线连接，无处不在"
	quest.6DB557B09C22E77C.title: "无限射程 (Infinite Range)"
	quest.6DDB95B19F499511.quest_desc: [
		"在觉醒祭坛上放置一个Supremium块，在底座上放置&eCognizant Dust&r，并在容器中放入每种元素精华各10个。"
		""
		"如果用带有“神秘启蒙”附魔的精华武器给予致命一击，凋零或末影龙会掉落“认知尘埃”。"
		""
		"从&e附魔师&r处获取附魔：需要三块Supremium Essence和64个Experience Essence。可用于附魔Essence Sword、斧头和镰刀，等级越高掉落越多粉尘。"
	]
	quest.6DDB95B19F499511.quest_subtitle: "唤醒它"
	quest.6DDB95B19F499511.title: "觉醒的超贵金属（Awakened Supremium）"
	quest.6DFF9D0A5882659F.quest_desc: [
		"冶炼它。振金可以开启大部分 Tier 4 内容。"
	]
	quest.6DFF9D0A5882659F.quest_subtitle: "Tier 4 的关键所在"
	quest.6DFF9D0A5882659F.title: "振金锭"
	quest.6E76AB47FF7449E1.quest_desc: [
		"一艘船和五块同种木材可以制作一个&e大型船只&r。"
		""
		"可容纳四名玩家。大型乘客会占用更多空间，所以一匹马或两匹马会减少座位数。"
	]
	quest.6E76AB47FF7449E1.quest_subtitle: "整个团队都有足够的空间"
	quest.6E76AB47FF7449E1.title: "大型船只"
	quest.6E7F1D48FEAE5DC1.quest_desc: [
		"远古遗迹会掉落一块&e远古金属&r。将其熔炼成锭。"
	]
	quest.6E7F1D48FEAE5DC1.quest_subtitle: "残党的宝藏"
	quest.6E7F1D48FEAE5DC1.title: "远古金属"
	quest.6E82B1C8750BE2F5.quest_desc: [
		"一个&e旋转装置&r位于转子顶部。其周围环绕着一层&e压力分散器&r，而&e电磁线圈&r则位于其上方。"
		""
		"分离器上方的&e饱和冷凝器&r可将废蒸汽变回水。"
	]
	quest.6E82B1C8750BE2F5.quest_subtitle: "旋转即化为力量"
	quest.6E82B1C8750BE2F5.title: "旋转综合体"
	quest.6EC2FFF793EBD91D.quest_desc: [
		"末影电池的表亲。烈焰棒、羊毛、黑曜石、末影珍珠和一块&e锇锭&r可以制作一个&e末影瓶&r。"
		""
		"用于存放Mekanism化学物质。给两个瓶子相同的三种颜色，就像末影箱一样，它们会共享一个储罐。"
	]
	quest.6EC2FFF793EBD91D.quest_subtitle: "Mekanism 的共享储罐"
	quest.6EC2FFF793EBD91D.title: "末影瓶"
	quest.6EC6F8EEC99E792D.quest_desc: [
		"用&e粉末雪&r吹风扇可批量冷冻：将压实冰变为蓝冰，甚至将烈焰棒变为微风棒。"
		""
		"用&e龙头&r或&e龙之息&r批量转化：将原石转化为末地石。"
	]
	quest.6EC6F8EEC99E792D.quest_subtitle: "新的风扇技巧"
	quest.6EC6F8EEC99E792D.title: "冻结与终结"
	quest.6EF57E2EB7807B20.quest_desc: [
		"把岩浆换成小麦，你就能得到 &eAgronomic Sourcelink&r。当作物或树木在15格内生长时，它会产生源。"
		""
		"Mageblooms、Sourceberries 和 Archwood 树苗会额外掉落。骨粉不算在内。"
	]
	quest.6EF57E2EB7807B20.quest_subtitle: "你的农场，现已充满魔力"
	quest.6EF57E2EB7807B20.title: "农业学源链接 Agronomic Sourcelink"
	quest.6EFA9D6D09DDE384.quest_desc: [
		"两个钢锭和一个红石可以制作&e通用电缆&r。它们可以在任何机器之间传输电力，无论是Mekanism的还是其他的。"
		""
		"右键点击电缆侧面，使用 Configurator 阻止其从错误方块吸取能量。"
	]
	quest.6EFA9D6D09DDE384.quest_subtitle: "能量会流向你指向的地方"
	quest.6EFA9D6D09DDE384.title: "通用电缆模组 (Universal Cables)"
	quest.6F0849FD87B9F897.quest_desc: [
		"在&e锻造台&r中，使用下界合金升级模板和下界合金锭来升级钻石背包。"
		""
		"和其他下界合金装备一样，它能承受岩浆，所以掉进去也不会丢失。"
	]
	quest.6F0849FD87B9F897.quest_subtitle: "防火，而且体型巨大"
	quest.6F0849FD87B9F897.title: "Netherite Backpack"
	quest.6F5EBD60C133C102.quest_desc: [
		"在ICU中，每个长到全高的仙人掌都会长出&ePrickly Pear&r。沙漠里也有野生的。"
		""
		"在熔炉、烟熏炉或营火中烹饪它们，做成小吃。"
	]
	quest.6F5EBD60C133C102.quest_subtitle: "仙人掌果实"
	quest.6F5EBD60C133C102.title: "带刺的梨子"
	quest.6F7ADD6639413F7C.quest_desc: [
		"The &eArc Furnace&r smelts ores into extra ingots and makes alloys without a kiln."
		""
		"它会消耗&e石墨电极&r。请在EMI中查看制作方法。"
	]
	quest.6F7ADD6639413F7C.quest_subtitle: "装在盒子里的闪电"
	quest.6F7ADD6639413F7C.title: "电弧熔炉"
	quest.6F9ED26E3CAA49E9.quest_desc: [
		"双压缩工作台周围放置末地水晶、传送门框架、紫晶、龙之息和一个末地箱。"
		""
		"这里是制作极限工作台本身的地方。"
	]
	quest.6F9ED26E3CAA49E9.quest_subtitle: "7x7 的桌子"
	quest.6F9ED26E3CAA49E9.title: "结束制作台界面"
	quest.6FB16A9A13C1231D.quest_desc: [
		"木桶、鼓、锤子和握柄。用子弹蓝图里的弹匣装满它。"
		""
		"它还存储了升级内容，请在EMI中查找相关部件。"
	]
	quest.6FB16A9A13C1231D.quest_subtitle: "工程师的副武器"
	quest.6FB16A9A13C1231D.title: "左轮手枪"
	quest.6FFB025B731D29D7.quest_desc: [
		"一个铁锭和两个红石粉可以制作一个&e红石锭&r。一个铁锭和一个末影珍珠可以制作一个&e末影锭&r。"
	]
	quest.6FFB025B731D29D7.quest_subtitle: "还有两种金属需要收集"
	quest.6FFB025B731D29D7.title: "红石和末影锭"
	quest.6FFE2531DFBF7206.quest_desc: [
		"富集室能将一种矿石变成两种粉尘。你的矿石堆刚刚翻倍了。"
	]
	quest.6FFE2531DFBF7206.quest_subtitle: "二选一，买一送一"
	quest.6FFE2531DFBF7206.title: "矿石翻倍"
	quest.70010C79BAD9B038.quest_desc: [
		"在锅中煮米饭，得到&e熟米饭&r。许多菜肴和卷饼都需要用到它。"
	]
	quest.70010C79BAD9B038.quest_subtitle: "最简单的锅子配方"
	quest.70010C79BAD9B038.title: "Cooked Rice"
	quest.70225BCBB0F34E88.quest_desc: [
		"一个土豆加一个宝石，无需特定配方。即使你饱了也能吃。"
		""
		"&eEmerald&r：夜视、再生和饱食度。 &eRuby&r：抗性、力量和火焰抗性。 &eAmethyst&r：幸运。"
	]
	quest.70225BCBB0F34E88.quest_subtitle: "每日一颗宝石"
	quest.70225BCBB0F34E88.title: "花式马铃薯"
	quest.703490A6DCBC53F9.quest_desc: [
		"全套装备。非德拉科尼或无限装备莫属，其他都打不过。"
		""
		"这就是完整的 Allthemodium 梯子。爬得真棒！"
	]
	quest.703490A6DCBC53F9.quest_subtitle: "已获得，并已穿戴"
	quest.703490A6DCBC53F9.title: "Unobtainium 盔甲"
	quest.706EBEC3127EAAF3.quest_desc: [
		"一个带有蜘蛛网和裂纹石砖的指南针。选择一个结构，它会指向最近的建筑。"
		""
		"它也适用于模组结构，包括所有 Cataclysm 巢穴。"
	]
	quest.706EBEC3127EAAF3.quest_subtitle: "找到任意一个结构物"
	quest.706EBEC3127EAAF3.title: "探险家指南针"
	quest.707FBFCDF207ECBA.quest_desc: [
		"Unobtainium 矿石位于 &e末地高地&r，也就是末地岛屿的外缘。"
	]
	quest.707FBFCDF207ECBA.quest_subtitle: "带来缓慢下落的效果"
	quest.707FBFCDF207ECBA.title: "在末地深处"
	quest.708ECCE1005306DE.quest_desc: [
		"&e磨石&r可以把小麦磨成面粉，把砾石磨成燧石。"
		""
		"速度慢，但价格便宜。重型物品得靠后面的压碎轮来处理。"
	]
	quest.708ECCE1005306DE.quest_subtitle: "缓慢但简单的刷怪过程"
	quest.708ECCE1005306DE.title: "磨坊石"
	quest.70BD2C8EA31FD30B.quest_desc: [
		"一个&e机械臂&r可以在其范围内将物品在背包、仓库、传送带和机器之间移动。"
		""
		"放置前，右键点击它需要取走和放置的位置。"
	]
	quest.70BD2C8EA31FD30B.quest_subtitle: "拾起，放下"
	quest.70BD2C8EA31FD30B.title: "机械臂"
	quest.70DD4EE4EB14F896.quest_desc: [
		"物品展示框周围的八个玻璃板可制作两个&e玻璃物品展示框&r。只有物品可见。"
		""
		"右键其中一个可以打开后面的箱子，所以它们是很好的标签。"
		""
		"ICU 还有 &eFast Item Frames&r，能让普通物品展示框的性能消耗更低。"
		""
		"玻璃和染色物品框在萨布尔船只和飞艇上也能固定住。"
	]
	quest.70DD4EE4EB14F896.quest_subtitle: "只要物品本身，谢谢"
	quest.70DD4EE4EB14F896.title: "玻璃物品展示框"
	quest.70E7CA1B231F7B2A.quest_desc: [
		"原木、木板和木棍可以制作&e尖桩围栏&r、&e栅栏围栏&r和&e马围栏&r，还有像&e高门&r这样的高大门。每种木材都有。"
		""
		"树叶能做成&e树篱&r，用铁栏杆在切石机里能做出华丽的金属围栏。"
	]
	quest.70E7CA1B231F7B2A.quest_subtitle: "Macaw's Fences"
	quest.70E7CA1B231F7B2A.title: "花式围栏"
	quest.7106A1C0713505C1.quest_desc: [
		"将&eProgrammed Extended Patterns&r放入ME网络上的&eSmart AutoCraft Table&r，AE2即可自动合成这些扩展配方。"
		""
		"还有智能末影人和通量制造者呢。"
	]
	quest.7106A1C0713505C1.quest_subtitle: "自动化的扩展合成系统"
	quest.7106A1C0713505C1.title: "智能自动合成台"
	quest.710B9A7DB19B7FDA.quest_desc: [
		"&e物品栏访问端口&r能让漏斗和管道连接到其背后的物品栏。"
		"其中两个可以合成一个 &eInventory Bridge&r，它能同时处理两个物品栏，并带有过滤器来决定哪边得到什么。"
	]
	quest.710B9A7DB19B7FDA.quest_subtitle: "绕过拐角进行攻击"
	quest.710B9A7DB19B7FDA.title: "物品栏桥梁"
	quest.7110483F7D2C6D4B.quest_desc: [
		"各种小方块和技巧的集合：村民一站式交易、物品吸尘器、更好的三叉戟和更整洁的红石。"
		""
		"这里没有强制要求。选择有助于你基地发展的东西。"
	]
	quest.7110483F7D2C6D4B.quest_subtitle: "能节省大量时间的小东西们"
	quest.7110483F7D2C6D4B.title: "实用小工具"
	quest.712395CA23582186.quest_desc: [
		"来自Aether的最佳工具。用镐右键点击石块，它就会漂浮到空中！"
	]
	quest.712395CA23582186.quest_subtitle: "让它漂浮起来"
	quest.712395CA23582186.title: "Gravitite 镐"
	quest.712882A028B3D465.quest_desc: [
		"Supremium Essence、Prosperity Shards 和 Supremium Gemstone 可以合成一个 &eMaster Infusion Crystal&r。"
		""
		"无限耐久。再也不用制作备用水晶了。"
	]
	quest.712882A028B3D465.quest_subtitle: "永远不会损坏"
	quest.712882A028B3D465.title: "大师级灌注水晶"
	quest.714B05ADC93680BE.quest_desc: [
		"两根稻草可以合成&e绳子&r。可以像梯子一样攀爬，或者让番茄藤攀爬。"
		""
		"四根绳子可以制作一个能抵消坠落伤害的&e安全网&r。"
	]
	quest.714B05ADC93680BE.quest_subtitle: "用于攀爬和番茄种植"
	quest.714B05ADC93680BE.title: "绳索"
	quest.714C6138F7608A9F.quest_desc: [
		"每个Cataclysm结构都有自己的&e之眼&r。制作一个，投掷它，它就会飞向最近的匹配点。"
		""
		"沙漠（诅咒金字塔）、诅咒（霜冻监狱）、深渊（沉没之城）、风暴（卫城）、火焰（燃烧竞技场）、怪物（灵魂熔炉）、机械（远古工厂）和虚空（废墟城堡）。每个配方请在EMI中查看。"
	]
	quest.714C6138F7608A9F.quest_subtitle: "就像末影之眼一样"
	quest.714C6138F7608A9F.title: "指引方向的双眼"
	quest.717AC8F340C27920.quest_desc: [
		"一个多区块电池：由&e感应外壳&r墙壁、一个&e感应端口&r（精英电路）以及内部的电池单元和电源单元组成。"
		""
		"电池和供应器需要&e锂尘&r，所以你需要先弄个结晶器。"
	]
	quest.717AC8F340C27920.quest_subtitle: "强大的电力储存装置"
	quest.717AC8F340C27920.title: "感应矩阵"
	quest.71979BC28F57E977.quest_desc: [
		"建造高炉（Blast Bricks，用锤子锻造）并用焦炭冶炼铁。"
		""
		"你的钢显示为Mekanism钢。Almost Unified将所有钢合并为一种，所以别担心。"
	]
	quest.71979BC28F57E977.quest_subtitle: "铁，但更坚固"
	quest.71979BC28F57E977.title: "钢铁"
	quest.7198E5B530472584.quest_desc: [
		"&e生物识别器&r决定谁能通过你的田地并使用你的方块。把ID卡分发给朋友们吧。"
	]
	quest.7198E5B530472584.quest_subtitle: "谁能进入其中"
	quest.7198E5B530472584.title: "生物特征识别器"
	quest.71B95A4AEA0F25E2.quest_desc: [
		"当玩家杀死&eWarden&r时，它会掉落一个Warden Heart。"
		""
		"无法用瓶子捕捉、克隆或用灵魂沙召唤，所以你得去深暗处和它战斗。"
	]
	quest.71B95A4AEA0F25E2.quest_subtitle: "证明你击败了它"
	quest.71B95A4AEA0F25E2.title: "Warden Heart"
	quest.722A6793CB6F2FFA.quest_desc: [
		"&eRegalium&r 稀有又闪亮，石生者们都喜欢它。"
	]
	quest.722A6793CB6F2FFA.quest_subtitle: "石生货币"
	quest.722A6793CB6F2FFA.title: "Regalium"
	quest.7232E113A07FA4E4.quest_desc: [
		"球体周围的棒越多，速度越快，更好的棒能传递更多能量。"
		""
		"将你的初始鱼竿升级为&e基础&r和&e硬化&r鱼竿。制作水晶配方需要速度。"
	]
	quest.7232E113A07FA4E4.quest_subtitle: "更多鱼竿，更好的鱼竿"
	quest.7232E113A07FA4E4.title: "更快的能量补充速度"
	quest.723787B8FA9ED8B8.quest_desc: [
		"Copycat &e滑动门&r、&e齿轮&r和&e传动轴&r也支持任何纹理。"
		""
		"把机器藏在墙里，就没人会知道了。"
	]
	quest.723787B8FA9ED8B8.quest_subtitle: "完全融入其中，毫无违和感"
	quest.723787B8FA9ED8B8.title: "Copycat Doors and Cogs"
	quest.723879372AF10684.quest_desc: [
		"用红石注入锇。你需要很多这些。"
	]
	quest.723879372AF10684.quest_subtitle: "用于机器的微型大脑"
	quest.723879372AF10684.title: "基础控制电路"
	quest.72459DDFA2F9D521.quest_desc: [
		"鹿会掉落鹿肉。锅中放入：生鹿肉、海带、两根竹子和一种蔬菜。"
	]
	quest.72459DDFA2F9D521.quest_subtitle: "鹿，美味的烹饪方式"
	quest.72459DDFA2F9D521.title: "竹与鹿肉料理"
	quest.725321FB9F620326.quest_desc: [
		"&eTank Upgrade&r（升级底座周围的玻璃）可以储存流体。"
		"&e电池升级&r（金块和红石块）可将能量储存在背包中。"
	]
	quest.725321FB9F620326.quest_subtitle: "流体与能源，便携式供应"
	quest.725321FB9F620326.title: "坦克和电池"
	quest.726A2B7B50317745.quest_desc: [
		"Create Aeronautics 能将任何一组方块变成一个真实的物理对象：&e模拟装置&r。"
		""
		"制作一个&e物理组装器&r（安山岩外壳、合金和杠杆）。将一组方块粘在它上面，然后右键并拉动杠杆。现在它可以移动和下落了。"
	]
	quest.726A2B7B50317745.quest_subtitle: "愿物理法则降临其身"
	quest.726A2B7B50317745.title: "物理组装器"
	quest.72805D76B4F0C7CF.quest_desc: [
		"精英工厂和安装器需要 &e精英控制电路&r，而这意味着需要 Allthemodium。"
	]
	quest.72805D76B4F0C7CF.quest_subtitle: "七个物品栏位"
	quest.72805D76B4F0C7CF.title: "精英工厂"
	quest.728BC23B4301D6B6.quest_desc: [
		"将锌块切成&eCopycat&r方块，然后用任意方块右键点击其中一个以复制其外观。"
		""
		"&eCopycats+&r 添加了斜坡、切片、层板、窗格等。非常适合为机器增添细节。"
	]
	quest.728BC23B4301D6B6.quest_subtitle: "任何形状，任何纹理"
	quest.728BC23B4301D6B6.title: "模仿者（Copycats）"
	quest.729D28CC50A14CEF.quest_desc: [
		"钻石生成器加黑曜石。从这里你可以建造&e岩浆&r、&e末地&r和&e附魔&r生成器。"
	]
	quest.729D28CC50A14CEF.quest_subtitle: "分岔点"
	quest.729D28CC50A14CEF.title: "黑曜石生成器"
	quest.72AB7E6FA5052E38.quest_desc: [
		"&eHypertubes&r 能让你以高速穿过玻璃管。右键一个管道并用另一个管道链接它们。"
		""
		"&e入口&r需要至少16 RPM。转得越快，走得越快。"
	]
	quest.72AB7E6FA5052E38.quest_subtitle: "缩放"
	quest.72AB7E6FA5052E38.title: "超巨型管道"
	quest.72F875F3B5A3FE4F.quest_desc: [
		"&e加速卡&r可提升巴士速度。 &e容量卡&r可增加过滤槽。模糊、红石和合成卡的作用如其名。"
	]
	quest.72F875F3B5A3FE4F.quest_subtitle: "把它们放进去"
	quest.72F875F3B5A3FE4F.title: "升级卡牌"
	quest.73021FCFBB9C6FD3.quest_desc: [
		"铁、碗和骨粉可以制作一个&e浇水壶&r。右键点击水来装满它，然后给作物浇水以加快生长。"
		""
		"精粹罐的射程更远；右键单击空气可切换自动浇水。"
	]
	quest.73021FCFBB9C6FD3.quest_subtitle: "手动劳作，魔法成果"
	quest.73021FCFBB9C6FD3.title: "浇水壶"
	quest.7313B28E6410AD38.quest_desc: [
		"将&eConductor Whistle&r绑定给骑火车的乘务员，然后在轨道上使用以召唤该火车。"
		""
		"调度员可以在车站吹哨，让火车自动进站。"
	]
	quest.7313B28E6410AD38.quest_subtitle: "叫一辆出租车"
	quest.7313B28E6410AD38.title: "指挥家哨子"
	quest.73161607C3DB3C14.quest_desc: [
		"&eMagmator&r 会燃烧像岩浆这样的高温流体。持续为其输送流体，它就能永远运行。"
	]
	quest.73161607C3DB3C14.quest_subtitle: "将熔岩转化为能量"
	quest.73161607C3DB3C14.title: "岩浆怪（Magmator）"
	quest.7334DC92FB7CDB55.quest_desc: [
		"红石、一个金块、一颗钻石和一个金锭。 &e岩浆立方宠物&r 能赋予你火焰抗性，并让你能在岩浆上行走。"
		""
		"下界之旅的好伙伴。它喜欢石英。"
	]
	quest.7334DC92FB7CDB55.quest_subtitle: "岩浆？什么岩浆？"
	quest.7334DC92FB7CDB55.title: "岩浆块宠物"
	quest.733D3EF00B6ACEA7.quest_desc: [
		"在砧板上将生鸭切块。锅中放入：鸭肉、意大利面、胡萝卜和蔬菜。"
		""
		"鸭子喜欢待在河流和沼泽附近。"
	]
	quest.733D3EF00B6ACEA7.quest_subtitle: "Environmental's ducks"
	quest.733D3EF00B6ACEA7.title: "鸭肉面线"
	quest.735047CB39E45128.quest_desc: [
		"四个龙核、两个龙锭、一个&e下界之星&r和两个&e凋零锭&r。"
		""
		"这就是最难的。接下来是第5级！"
	]
	quest.735047CB39E45128.quest_subtitle: "第4阶段已完成！"
	quest.735047CB39E45128.title: "Wyvern Core"
	quest.73A906E91E469E93.quest_desc: [
		"&ePlant Sower&r会在自身前方种植种子和树苗。而&ePlant Gatherer&r则会收割它们，包括树木在内。"
		""
		"把它们并排放在一起，再也不要碰锄头了。"
	]
	quest.73A906E91E469E93.quest_subtitle: "种植它，收获它"
	quest.73A906E91E469E93.title: "自动化农场"
	quest.73F0EFC2E2D0047F.quest_desc: [
		"爬上豆茎，击败一个&e巨型矿工&r。它的巨型镐能一次性挖掘巨大的区块。"
	]
	quest.73F0EFC2E2D0047F.quest_subtitle: "天空中的巨人"
	quest.73F0EFC2E2D0047F.title: "九霄云外"
	quest.74320E545D885378.quest_desc: [
		"从数据包中合成普通合成台的配方。需要能量；在ME网络中，它从网络获取能量，并将产物送回网络。"
	]
	quest.74320E545D885378.quest_subtitle: "一张永不停歇的合成台"
	quest.74320E545D885378.title: "整合包制作者"
	quest.7449F8921FD94A50.quest_desc: [
		"在分离器的物品栏位或化学储罐中，为&e喷气背包&r填充氢气。"
		""
		"使用按键绑定切换模式：正常、悬停或关闭。"
	]
	quest.7449F8921FD94A50.quest_subtitle: "向上，再向上，飞向远方"
	quest.7449F8921FD94A50.title: "喷气背包"
	quest.74970CD82E15869D.quest_desc: [
		"&eOre Laser Base&r需要高级框架。由激光钻提供动力，可从空气中提取矿石。"
		""
		"添加一个彩色&e激光透镜&r来偏好某些矿石。将透镜悬停在EMI上即可查看其增强效果。"
	]
	quest.74970CD82E15869D.quest_subtitle: "不知从何处来的矿石"
	quest.74970CD82E15869D.title: "矿石激光基地"
	quest.74A4B7A34414323E.quest_desc: [
		"将 Charged Certus、红石粉和下界石英一起投入水中，即可得到 &eFluix Crystals&r。"
		""
		"用 Create 搅拌机加水可以批量处理。"
	]
	quest.74A4B7A34414323E.quest_subtitle: "The good purple"
	quest.74A4B7A34414323E.title: "Fluix"
	quest.74A547F9F5854201.quest_desc: [
		"With a &eVoid Upgrade&r a full drawer deletes extra items instead of backing up your line."
		""
		"非常适合建造原石发电机和生物农场。"
	]
	quest.74A547F9F5854201.quest_subtitle: "再也不会饱腹了"
	quest.74A547F9F5854201.title: "虚空升级包"
	quest.74C1D7D6AACEE6EA.quest_desc: [
		"星辰的核心部件。它也是一个&e极限工作台&r的配方：一圈末石，里面装满末影珍珠，中间放着四个中子锭和一个下界之星。"
	]
	quest.74C1D7D6AACEE6EA.quest_subtitle: "星辰的心脏"
	quest.74C1D7D6AACEE6EA.title: "末地珍珠"
	quest.74C548C220E463C7.quest_desc: [
		"击败远古灾厄，夺取它的&e炽热泪滴&r。"
		""
		"只要先击败了骑士幻影，过去的击杀数也会被计算在内。"
	]
	quest.74C548C220E463C7.quest_subtitle: "远古灾厄兽"
	quest.74C548C220E463C7.title: "火焰的泪水"
	quest.74CBC469BF3ECCC3.quest_desc: [
		"穿上背包并打开箱子，这些升级就会生效："
		"&eDeposit&r 会将匹配的物品存入箱子。 &eRestock&r 会从中取出匹配的物品。"
	]
	quest.74CBC469BF3ECCC3.quest_subtitle: "自动化箱子事务，自动化完成"
	quest.74CBC469BF3ECCC3.title: "补充库存与存入物品"
	quest.74CEDB01AF4B058F.quest_desc: [
		"九个硫磺可以合成一个&ePotent Sulfur&r方块。硫磺和朱砂也有抛光方块、砖块、石板、台阶和墙壁。"
	]
	quest.74CEDB01AF4B058F.quest_subtitle: "浓缩的恶臭气味"
	quest.74CEDB01AF4B058F.title: "强力硫磺"
	quest.74EFB59ACD559A75.quest_desc: [
		"Draconium dust、blaze powder 和 Eye of Ender 可以制作一个 &eDislocator&r，一种短程传送器。"
		""
		"提示：更高级的位移器以末影珍珠为燃料，所以请准备好一组备用。"
	]
	quest.74EFB59ACD559A75.quest_subtitle: "点击，然后点击其他地方"
	quest.74EFB59ACD559A75.title: "Dislocator"
	quest.75090E01BC280819.quest_desc: [
		"&eNucleosynthesizer&r 使用反物质将物品转化为更稀有的物品：煤炭变钻石，鸡蛋变龙蛋等。"
		""
		"查看其EMI标签以获取完整列表。"
	]
	quest.75090E01BC280819.quest_subtitle: "反物质炼金术"
	quest.75090E01BC280819.title: "反质子核合成器"
	quest.750C7CD1CA2A0D24.quest_desc: [
		"用干海带制作一个&e皮带连接器&r，然后点击两根传动轴，用皮带将它们连接起来。"
		""
		"传送带用于运输物品和连接机器。保持其呈直线、水平或倾斜状态。"
	]
	quest.750C7CD1CA2A0D24.quest_subtitle: "工厂传送带"
	quest.750C7CD1CA2A0D24.title: "腰带类物品"
	quest.751C1288A925D73F.quest_desc: [
		"用&e套索&r抓住生物，然后将套索放入生物农场。这样能随时间收集该生物的掉落物。"
		""
		"改良农场的工作速度更快，能容纳更多种类的生物。悬停农场可查看其容量。"
	]
	quest.751C1288A925D73F.quest_subtitle: "一个方块大小的农场"
	quest.751C1288A925D73F.title: "小型生物农场"
	quest.7540A85438BDAE9F.quest_desc: [
		"&e采矿钻头&r靠燃料而非耐久度运行。换上钢制钻头，应对更硬的岩石。"
		""
		"升级需要在合成台中进行操作。"
	]
	quest.7540A85438BDAE9F.quest_subtitle: "抓紧了，要出大事了"
	quest.7540A85438BDAE9F.title: "采矿钻头 Mining Drill"
	quest.7553AF25A1503FB8.quest_desc: [
		"&eYUNG's Better End Island&r 将末影龙的岛屿围绕着一座中央塔重建。"
		""
		"&6注意：&r只有&e首次&r击杀的龙会掉落龙蛋；被重新召唤的龙不会。ICU的终极工作台（5阶）需要这个蛋，所以不要弄丢。"
	]
	quest.7553AF25A1503FB8.quest_subtitle: "巨龙的新家园"
	quest.7553AF25A1503FB8.title: "更好的末地岛屿模组任务书"
	quest.75BF7F0A3942AC01.quest_desc: [
		"三块&e木材&r（原木的纯树皮版本）堆叠成一列，可制作八个&e木桩&r。"
		""
		"它们可以朝向任何方向，链条和灯笼可以直接挂在上面。"
	]
	quest.75BF7F0A3942AC01.quest_subtitle: "细长的光柱"
	quest.75BF7F0A3942AC01.title: "帖子"
	quest.75F7ADEAC42EF88E.quest_desc: [
		"在锻造台用下界合金锭升级钻石发电机。产量大幅提升。"
	]
	quest.75F7ADEAC42EF88E.quest_subtitle: "锻造时间到"
	quest.75F7ADEAC42EF88E.title: "下界合金发电机"
	quest.75FEA4AF631002CC.quest_desc: [
		"在&e高压反应室&r中用氟石粉尘和水压制波利onium或普鲁特onium以制作燃料棒。"
		""
		"钋丸用于 MekaSuit、Meka-Tool 和聚变框架。两者都用于 SPS。"
	]
	quest.75FEA4AF631002CC.quest_subtitle: "游戏后期的合成材料"
	quest.75FEA4AF631002CC.title: "钋和钚元素（Polonium and Plutonium）"
	quest.76203445E60BFA69.quest_desc: [
		"&e齿轮箱&r会将旋转力传递到除输入端以外的所有方向。非常适合紧凑的建造。"
		""
		"需要安山岩外壳，所以先制作几个吧。"
	]
	quest.76203445E60BFA69.quest_subtitle: "就在拐角处"
	quest.76203445E60BFA69.title: "齿轮箱"
	quest.7624C3AECAFBC4DE.quest_desc: [
		"&e冰学家&r是寒冷的灾厄村民。它们在雪地群系中漫游，并居住在&e冰学家小屋&r里。"
		""
		"每个都会掉落一个&e冰冻图腾&r。"
	]
	quest.7624C3AECAFBC4DE.quest_subtitle: "冰雪学家"
	quest.7624C3AECAFBC4DE.title: "冷肩肉 (Cold Shoulder)"
	quest.763A7730116F2236.quest_desc: [
		"低浓度是鹅卵石和木炭，中等浓度是铁和红石，高浓度是钻石和煤炭。"
		""
		"它们会用到很多 ProjectE 的配方里。"
	]
	quest.763A7730116F2236.quest_subtitle: "修复和制作的粉尘"
	quest.763A7730116F2236.title: "共价粉尘"
	quest.763AEC6C873116C5.quest_desc: [
		"一个Flux Accessor和一个Basic Card。"
		""
		"将&e感应卡&r放入AE设备的升级槽中，它就可以吸收或输出能量了。"
	]
	quest.763AEC6C873116C5.quest_subtitle: "输入功率，输出功率"
	quest.763AEC6C873116C5.title: "感应卡"
	quest.763F2296D4BEDA01.quest_desc: [
		"&e包装组件&r是末影之眼、木板和金锭。"
		""
		"整合包中加入了AE2，所有PackagedAuto机器都使用&eME Packaging Component&r：加入AE2的Annihilation和Formation Core以及Quartz Glass。"
	]
	quest.763F2296D4BEDA01.quest_subtitle: "PackagedAuto 从这里开始"
	quest.763F2296D4BEDA01.title: "组件的包装与整理"
	quest.7663EA8EBDA7492E.quest_desc: [
		"在主世界的上空漂浮着一些&e空中船村庄&r。它们稀有且相距甚远，寻找起来相当不易。"
		""
		"探险家指南针在这里很有帮助。"
	]
	quest.7663EA8EBDA7492E.quest_subtitle: "抬头向上看"
	quest.7663EA8EBDA7492E.title: "空中船村庄"
	quest.766CF009331BB3AB.quest_desc: [
		"五个碎片可以合成&eWildfire Crown&r，一种头盔。戴上它，让下界知道谁才是老大。"
	]
	quest.766CF009331BB3AB.quest_subtitle: "把它穿上身，然后按下 E 键来打开背包，将物品拖放到背包中。"
	quest.766CF009331BB3AB.title: "新下界之王（New King of the Nether）"
	quest.76C749B1E68EE83A.quest_desc: [
		"&e创造：新时代&r将旋转转化为电能，反之亦然。"
		""
		"从&e磁铁矿块&r开始。它们以小块的形式出现在主世界的地下。直接挖掘即可。"
	]
	quest.76C749B1E68EE83A.quest_subtitle: "创造：新时代 (Create: New Age)"
	quest.76C749B1E68EE83A.title: "磁铁矿（Magnetite）"
	quest.76DAA23378C740DC.quest_desc: [
		"最上层的铁质熔炉由 Allthemodium、Vibranium 和 Unobtainium 制成。"
		""
		"&6注意：&r这些金属可以解锁ICU的等级。先用于升级，再用于熔炉。"
	]
	quest.76DAA23378C740DC.quest_subtitle: "只有在你有钱的时候才能做"
	quest.76DAA23378C740DC.title: "Allthemodium 熔炉"
	quest.772770BF88A05D71.quest_desc: [
		"远古灵魂、炽热的眼睛、黄金和黑曜石。"
		""
		"放置后，会在上方7x7的柱状区域内赋予你创造模式飞行能力。非常适合高空建造。"
	]
	quest.772770BF88A05D71.quest_subtitle: "在家飞行 (Fly at home)"
	quest.772770BF88A05D71.title: "高度变化表"
	quest.773B68D85015A1EA.quest_desc: [
		"&eEnergiser&r需要电力和旋转。它为下方的depot或belt上的物品充电。"
		""
		"将铁充能成&e过载铁&r。制作大多数新时代零件都需要它。"
	]
	quest.773B68D85015A1EA.quest_subtitle: "在仓库中销毁物品"
	quest.773B68D85015A1EA.title: "能量化装置"
	quest.773E0683B0AB591E.quest_desc: [
		"在合成网格中锤击一个锭可获得一个&e板&r。四个板可制作&e金属板&r，钢锭和钢棒可制作&e钢制脚手架&r。"
		""
		"几乎所有大型工业时代机器都由这些建造而成。"
	]
	quest.773E0683B0AB591E.quest_subtitle: "板、片材和脚手架"
	quest.773E0683B0AB591E.title: "结构性钢材"
	quest.774BB5C65709D5FA.quest_desc: [
		"一颗下界之星、两个红石块、一块烈焰水晶块和一个&e不可得锭&r。能制作16个！"
	]
	quest.774BB5C65709D5FA.quest_subtitle: "最大功率输出"
	quest.774BB5C65709D5FA.title: "氮化硅晶体"
	quest.7761E03F21CB633F.quest_desc: [
		"Place a Teleport Pad in the Overworld, then sneak and right-click it with empty hands."
	]
	quest.7761E03F21CB633F.quest_subtitle: "所有矿石，毫无麻烦"
	quest.7761E03F21CB633F.title: "采矿维度"
	quest.777088F8F513AA4A.quest_desc: [
		"每张桌子都有一个自动版本：桌子加上 Crystaltine、红石组件和黑铁。"
		""
		"摆好配方，然后点击右上角的三个配方槽之一，&eShift + 左键&r保存配方，再点击选择配方。在上方放置一个箱子并填满：物品通过动力输入，漏斗可将成品取出。"
	]
	quest.777088F8F513AA4A.quest_subtitle: "单独制作配方本身"
	quest.777088F8F513AA4A.title: "自动合成台 (Auto Crafting Tables)"
	quest.777BD49FB89A8E7C.quest_desc: [
		"在装置上，用四根 Magebloom Fiber 升级一件胸甲（及其他部件）："
		"黄金制作&e法师套&r，铁制作&e秘术师套&r，钻石制作&e战斗法师套&r。"
		""
		"法师的护甲最弱，但附魔槽最好；战斗法师则相反。"
	]
	quest.777BD49FB89A8E7C.quest_subtitle: "可穿戴的魔力再生装备"
	quest.777BD49FB89A8E7C.title: "魔法长袍"
	quest.77AAAC8776DF30C1.quest_desc: [
		"嗨！ICU 是一个大型整合包，核心是：&6五个等级&r，每个新等级都需要稀有金属或首领掉落物来开启。"
		""
		"这本书会一步步引导你爬上梯子。勾选复选框即可开始。"
	]
	quest.77AAAC8776DF30C1.quest_subtitle: "吃点东西吧。这会是一场漫长的冒险。"
	quest.77AAAC8776DF30C1.title: "欢迎来到 InfinityCraft Ultra！"
	quest.77B23B0A56C00690.quest_desc: [
		"敲碎草块，找到&e工业大麻种子&r。植物会长高两格；剪掉顶部，底部会继续生长。"
		""
		"大麻纤维可制成风车帆、绝缘线和测绘工具的&e耐用织物&r。"
	]
	quest.77B23B0A56C00690.quest_subtitle: "有用的杂草品种之一"
	quest.77B23B0A56C00690.title: "工业大麻"
	quest.77E340B920B7B2A9.quest_desc: [
		"八个末影珍珠周围的沙子能合成八个&eGravisand&r。"
		""
		"只有在接收到红石信号时才会下落，并拉动旁边的Gravisand。如果无法下落，则会向上漂浮。"
	]
	quest.77E340B920B7B2A9.quest_subtitle: "命令方块上的掉落物会掉落"
	quest.77E340B920B7B2A9.title: "Gravisand"
	quest.780B8703A24F59F3.quest_desc: [
		"A &eBacktank&r stores pressurized air for tools like the Extendo Grip and the diving gear."
		""
		"用铁胸甲合成，可获得盔甲版本。"
	]
	quest.780B8703A24F59F3.quest_subtitle: "空气与盔甲"
	quest.780B8703A24F59F3.title: "装甲后援坦克"
	quest.782B2B29BA6DF6F8.quest_desc: [
		"黑恐鸟在空中跳跃的次数最多。孵化一只，骑上它去兜风吧。"
	]
	quest.782B2B29BA6DF6F8.quest_subtitle: "最优秀的飞行者"
	quest.782B2B29BA6DF6F8.title: "黑色恐鸟"
	quest.782BD815454A3637.quest_desc: [
		"&eGlares&r 在繁茂洞穴里四处漂浮。它们脾气暴躁，但很喜欢吃&eGlow Berries&r。"
		""
		"喂它一个发光浆果来驯服它。"
	]
	quest.782BD815454A3637.quest_subtitle: "属于你自己的凝视光芒"
	quest.782BD815454A3637.title: "脾气暴躁又可爱"
	quest.78334B9BA5B8E67F.quest_desc: [
		"铁粒、生牛肉（或鸡肉）、一颗钻石和一个金锭。"
		""
		"&e宠物狼&r会召唤一只狼与你并肩作战，还能提醒你附近有怪物，并吓跑骷髅。"
	]
	quest.78334B9BA5B8E67F.quest_subtitle: "一位忠诚的守卫"
	quest.78334B9BA5B8E67F.title: "狼宠物"
	quest.7846B7D1953DB7B6.quest_desc: [
		"击败末影龙。已经做到了？很好，你之前的胜利也算数。"
	]
	quest.7846B7D1953DB7B6.quest_subtitle: "经典的最终首领战环节"
	quest.7846B7D1953DB7B6.title: "屠龙者"
	quest.784E49B29C371A39.quest_desc: [
		"手持 Train Casing 并按下 &eAlt&r（打开 Bogey 菜单的键）来选择 bogey 样式后再放置。"
		""
		"单轴、双轴或三轴，还有许多其他类型，每种都有独特的外观。"
	]
	quest.784E49B29C371A39.quest_subtitle: "挑选你的车轮"
	quest.784E49B29C371A39.title: "Bogey 风格"
	quest.7869B7A84909DD1B.quest_desc: [
		"Pylons 框选一个空间，&eSpatial IO Port&r 将其复制到 Spatial Cell 中，之后可以粘贴回来。"
		""
		"非常适合移动建筑。先试试一个小的 2x2x2 单元格。"
	]
	quest.7869B7A84909DD1B.quest_subtitle: "在一个单元格中打包一个房间"
	quest.7869B7A84909DD1B.title: "空间存储模组 (Spatial Storage)"
	quest.787B646E7CE5ED0C.quest_desc: [
		"在铜质背包周围放置四个铁锭可以制作一个&e铁质背包&r。"
		""
		"你也可以跳过铜，在普通背包周围放置八个铁。"
	]
	quest.787B646E7CE5ED0C.quest_subtitle: "重金属存储装置"
	quest.787B646E7CE5ED0C.title: "铁质背包"
	quest.7892B54C7836910F.quest_desc: [
		"在核心的屏幕上使用&eTier Up&r来查看下一个外壳。每个层级都蕴含着更强大的力量。"
		"&e组装核心&r会帮你放置物品栏中的方块。"
		""
		"&6注意：&r顶层需要高级稳定器。屏幕会提示你何时需要它们。"
	]
	quest.7892B54C7836910F.quest_subtitle: "升级啦！"
	quest.7892B54C7836910F.title: "培育核心 (Growing the Core)"
	quest.78E426D38A1AE2D3.quest_desc: [
		"贤者之石可升级煤炭：四块煤炭可制成&e炼金煤炭&r，再制成&e莫比乌斯燃料&r，最后制成&e永恒燃料&r。"
		""
		"Aeternalis 是暗物质的钥匙。"
	]
	quest.78E426D38A1AE2D3.quest_subtitle: "煤炭，不过是更好的煤炭"
	quest.78E426D38A1AE2D3.title: "炼金燃料"
	quest.78FA89DB2F399B26.quest_desc: [
		"&e基础&r至&e终极&r包制作者可制作扩展合成台配方。 &e末地&r和&e通量&r包制作者可制作末地和通量物品。"
		""
		"每个都由对应的自动工作台或自动合成台制成。"
	]
	quest.78FA89DB2F399B26.quest_subtitle: "PackagedExCrafting"
	quest.78FA89DB2F399B26.title: "扩展合成包制作者 (Extended Crafting Package Crafters)"
	quest.7928558F5ECC4BFB.quest_desc: [
		"&e动能电池&r通过旋转充电。用红石供电，就能释放压力。"
		""
		"串联电池可延长续航，并联电池可增加容量。"
	]
	quest.7928558F5ECC4BFB.quest_subtitle: "方框内的旋转"
	quest.7928558F5ECC4BFB.title: "动能电池"
	quest.792D3F2715C04DC9.quest_desc: [
		"木棍加燧石（或铁）头可以制作一把&e刀&r。它轻便又快捷。"
		""
		"用它击杀动物可保证获得额外掉落物，用它割草可获得&e干草&r。"
	]
	quest.792D3F2715C04DC9.quest_subtitle: "每个厨房都需要一个"
	quest.792D3F2715C04DC9.title: "一把厨师刀"
	quest.7930AAEDCAF3836A.quest_desc: [
		"&eDeployer&r 会用它持有的任何东西：放置方块、点击按钮、应用物品，甚至发起攻击。"
		""
		"它也是序列组装的关键站点。"
	]
	quest.7930AAEDCAF3836A.quest_subtitle: "一个机械手臂"
	quest.7930AAEDCAF3836A.title: "部署器"
	quest.795582494295DC34.quest_desc: [
		"寒钢矿石隐藏在冰冻群落的寒石中。寒钢武器能减缓击中目标的移动速度。"
	]
	quest.795582494295DC34.quest_subtitle: "令人毛骨悚然"
	quest.795582494295DC34.title: "Froststeel"
	quest.7992DCDBC30FC374.quest_desc: [
		"&eDreadful Dirt&r会生成更多敌对生物。保持黑暗（光照等级低于5）并避免阳光直射。"
	]
	quest.7992DCDBC30FC374.quest_subtitle: "生成更多怪物"
	quest.7992DCDBC30FC374.title: "可怕的泥土"
	quest.79EA08FC2F716CF8.quest_desc: [
		"用刀击杀猪和猪灵会掉落整块&e火腿&r。在烟熏炉中熏制可获得&e烟熏火腿&r。"
		""
		"或者在砧板上切成薄片。"
	]
	quest.79EA08FC2F716CF8.quest_subtitle: "刀与猪的对决"
	quest.79EA08FC2F716CF8.title: "火腿（物品）"
	quest.7A0C2989CE0B23B9.quest_desc: [
		"&eThorium Ore&r 在Overworld中很稀有，且埋藏得很深。"
		""
		"Crushing Thorium sometimes gives &eRadioactive Thorium&r, the start of nuclear fuel."
	]
	quest.7A0C2989CE0B23B9.quest_subtitle: "炽热的岩石"
	quest.7A0C2989CE0B23B9.title: "钍元素（Thorium）"
	quest.7A1956D7BA8C3C2E.quest_desc: [
		"&e水轮&r在水流经过时会转动。 &e大型水轮&r能为单个转轴提供更大的应力承受力。"
		""
		"提示：水流只需在一侧流动。两侧水流朝同一方向推动也行。"
	]
	quest.7A1956D7BA8C3C2E.quest_subtitle: "免费电力，永无止境"
	quest.7A1956D7BA8C3C2E.title: "大型水车"
	quest.7A1D3449882B8676.quest_desc: [
		"&eEntro Infused Ingots&r：将 entro dust、金锭和青金石投入水中。"
		"框架由金锭、铜、铁和石英玻璃组成。"
	]
	quest.7A1D3449882B8676.quest_subtitle: "扩展自动化核心基地"
	quest.7A1D3449882B8676.title: "扩展机械框架"
	quest.7A321242E1D8395D.quest_desc: [
		"红石、萤石和一颗钻石。该石头能转换世界中的方块，并作为便携的合成助手使用。"
		""
		"&6注意：&r本书要求每个等级的物品（稀有金属、首领掉落、电路、晶体）都通过正常途径获得，而非转换。这才是乐趣所在。"
		"当你以诚实的方式爬上一级后，这本书会在这里打开 ProjectE。"
	]
	quest.7A321242E1D8395D.quest_subtitle: "一切开始的地方"
	quest.7A321242E1D8395D.title: "贤者之石"
	quest.7A3D20C1ED0123F5.quest_desc: [
		"Draconium ore 会出现在主世界、下界和末地中。"
	]
	quest.7A3D20C1ED0123F5.quest_subtitle: "龙之进化已经开始"
	quest.7A3D20C1ED0123F5.title: "Draconium"
	quest.7A3DE9C50C859B5A.quest_desc: [
		"&eCrusher&r能将一种矿石变成两种粉尘，有时还有额外奖励。"
		""
		"从顶部喂食，或者将物品丢在它上面。"
	]
	quest.7A3DE9C50C859B5A.quest_subtitle: "每种矿石对应两种粉尘"
	quest.7A3DE9C50C859B5A.title: "破碎机"
	quest.7A58AA0A0E183C17.quest_desc: [
		"铁、红石和石头可以制作一个&e机器框架&r。添加两个熔炉、铁和繁荣锭来制作一个MA&e熔炉&r。"
		""
		"MA机器燃烧固体燃料，并使用机器升级。"
	]
	quest.7A58AA0A0E183C17.quest_subtitle: "MA机器从这里开始"
	quest.7A58AA0A0E183C17.title: "机器框架"
	quest.7A601F8CAA978EA5.quest_desc: [
		"Knightmetal 工具能更有效地攻击护甲目标，盾牌、方块和锁链也很有趣。"
		""
		"&6注意：&r你用来制作装备的每个&eKnightmetal Ingot&r，都会减少一个可用于Industrial Foregoing的Advanced Machine Frame。"
	]
	quest.7A601F8CAA978EA5.quest_subtitle: "沉重而凶猛"
	quest.7A601F8CAA978EA5.title: "骑士金属齿轮"
	quest.7A73CF98BE2BCCF2.quest_desc: [
		"三个帝国精华、一个灌注水晶和一个&e振金原矿&r。"
	]
	quest.7A73CF98BE2BCCF2.quest_subtitle: "顶级农场自动化"
	quest.7A73CF98BE2BCCF2.title: "Supremium Essence"
	quest.7A7C5E70ECDC6A8B.quest_desc: [
		"烟熏火腿、一瓶蜂蜜、四颗甜浆果、两份熟米饭和一个碗。"
	]
	quest.7A7C5E70ECDC6A8B.quest_subtitle: "又黏又甜，口感绝佳"
	quest.7A7C5E70ECDC6A8B.title: "蜂蜜蜜汁火腿"
	quest.7A878102863DBCAC.quest_desc: [
		"三块木板上面放着一颗绿宝石，两根木棍当腿。"
		""
		"右键点击&e贸易站&r，即可与屏幕内24格（上下16格）范围内的所有村民进行交易。交易获得的经验值会显示在贸易站上方。"
	]
	quest.7A878102863DBCAC.quest_subtitle: "每个村民，一个屏幕"
	quest.7A878102863DBCAC.title: "贸易站"
	quest.7A9D00A153A773B3.quest_desc: [
		"&e高度传感器&r根据高度发出红石信号。而&e速度传感器&r则根据速度发出信号。"
		""
		"将它们连接到燃烧器和螺旋桨上，以获得能保持高度的自动驾驶仪。"
	]
	quest.7A9D00A153A773B3.quest_subtitle: "知道自己身在何处吗"
	quest.7A9D00A153A773B3.title: "飞行传感器"
	quest.7AB2BFEF6D907634.quest_desc: [
		"一个围绕&eDraconium Core&r建造的简易燃料发电机。"
		""
		"虽然不咋地，但对初次融合装置充电还挺方便的。"
	]
	quest.7AB2BFEF6D907634.quest_subtitle: "先点燃，再引燃引线"
	quest.7AB2BFEF6D907634.title: "Draconic Generator"
	quest.7AC31B9F5C29D651.quest_desc: [
		"钻石块、钻石铲子、黄金齿轮、最大的范围扩展和2000mB的粉色史莱姆。"
		""
		"它靠电力驱动，充电时会变大。需要高级框架来制作&e无限充电器&r。"
	]
	quest.7AC31B9F5C29D651.quest_subtitle: "挖一个洞。要挖一个大洞。"
	quest.7AC31B9F5C29D651.title: "无尽钻头"
	quest.7B01B354A9021AB9.quest_desc: [
		"拱木木板、拱木原木和金粒可以制作一张&e抄写台&r。"
		""
		"用附魔书右键打开符文列表。选择一个符文，把物品放在桌上，就能刻录并获得一些经验。它还会从附近的箱子里取物品。"
	]
	quest.7B01B354A9021AB9.quest_subtitle: "符文诞生的地方"
	quest.7B01B354A9021AB9.title: "抄写员工作台"
	quest.7B3C05FBD7E302FE.quest_desc: [
		"Flux 方块和玻璃板。存储可以平滑峰值，更大的层级由更小的层级合成。"
	]
	quest.7B3C05FBD7E302FE.quest_subtitle: "用于网络的缓冲区"
	quest.7B3C05FBD7E302FE.title: "Flux 存储系统"
	quest.7B6AA22D43198E16.quest_desc: [
		"&e风力发电机&r的高度越高，发电量越大。把它放在山顶或塔上吧。"
	]
	quest.7B6AA22D43198E16.quest_subtitle: "把它建得高高的"
	quest.7B6AA22D43198E16.title: "风力发电机"
	quest.7B6F1F3B3B698B2E.quest_desc: [
		"木板、一个铁粒、一颗钻石和一个金锭。右键点击&eChest Pet&r以打开其内部的储物空间。"
	]
	quest.7B6F1F3B3B698B2E.quest_subtitle: "额外的口袋空间"
	quest.7B6F1F3B3B698B2E.title: "Chest Pet"
	quest.7B8094A62BF78DD7.quest_desc: [
		"沙子、一个 Create &e喷嘴&r和一个&e流体储罐&r可以制作一个&e沙子过滤器&r。"
		""
		"从顶部注水，从底部排出。每次过滤可净化一个层级，所以用多个过滤器串联处理严重污染的水。"
	]
	quest.7B8094A62BF78DD7.quest_subtitle: "一桶一桶的干净水"
	quest.7B8094A62BF78DD7.title: "沙子过滤器"
	quest.7BB086004F1CDD56.quest_desc: [
		"将范围内的生物变成&e肉&r和&e粉色史莱姆&r流体。将两者都导入储罐。"
	]
	quest.7BB086004F1CDD56.quest_subtitle: "虽然可怕，但很有用"
	quest.7BB086004F1CDD56.title: "生物屠杀工厂"
	quest.7BBD904892177BAE.quest_desc: [
		"在沉没的城市深处。带上水肺药水。"
	]
	quest.7BBD904892177BAE.quest_subtitle: "L_Ender's Cataclysm"
	quest.7BBD904892177BAE.title: "利维坦（The Leviathan）"
	quest.7BE0D5F08A918FA1.quest_desc: [
		"终极工厂和安装器需要一个&e终极控制电路&r，而这意味着需要振金。"
		""
		"九个职业同时生效，升级还能叠加。"
	]
	quest.7BE0D5F08A918FA1.quest_subtitle: "九个物品栏位"
	quest.7BE0D5F08A918FA1.title: "终极工厂"
	quest.7BF8D9102868EE3F.quest_desc: [
		"攀登冰川上的极光宫殿，击败&e雪女王&r。"
		""
		"它会掉落三箭弓或追踪弓。两者都很棒。"
	]
	quest.7BF8D9102868EE3F.quest_subtitle: "冰雪女王"
	quest.7BF8D9102868EE3F.title: "万里无云的天空"
	quest.7C0DF263BA250EEF.quest_desc: [
		"黄金和玻璃可以制作一个&e沙漏&r。用沙子，或者任何粉尘或粉末来填充它。"
		""
		"每种尘埃都有自己的流动速度。红石比沙子慢得多，流动时会短暂发光。"
	]
	quest.7C0DF263BA250EEF.quest_subtitle: "看着它慢慢滴落下来"
	quest.7C0DF263BA250EEF.title: "沙漏"
	quest.7C26DE0525830DFA.quest_desc: [
		"虚空之花会掉落&e虚空荆棘&r和恢复生命力的水晶果实。"
	]
	quest.7C26DE0525830DFA.quest_subtitle: "虚空之花战利品"
	quest.7C26DE0525830DFA.title: "虚空荆棘"
	quest.7C56DB85D3899E03.quest_desc: [
		"&e抄写台&r能将符文转化为书籍中的法术。更多内容在&e新艺术运动&r章节中。"
	]
	quest.7C56DB85D3899E03.quest_subtitle: "编写你自己的法术"
	quest.7C56DB85D3899E03.title: "抄写员工作台"
	quest.7C5FCA9915830EB2.quest_desc: [
		"&eSqueezer&r将种子压榨成&ePlant Oil&r。大麻籽的产量最高。"
	]
	quest.7C5FCA9915830EB2.quest_subtitle: "种子油"
	quest.7C5FCA9915830EB2.title: "工业榨汁机"
	quest.7C76F1F2D443E443.quest_desc: [
		"&eEnder Tank&r 对流体也适用同样的原理。在一端输入岩浆或水，从另一端抽出即可。"
	]
	quest.7C76F1F2D443E443.quest_subtitle: "远程流体交互功能现已加入"
	quest.7C76F1F2D443E443.title: "末影储罐"
	quest.7C78578B58801984.quest_desc: [
		"用八个&e钻石块&r包裹一个宠物箱，它就会变成&e饱腹宠物箱&r。它永远不需要喂食。"
	]
	quest.7C78578B58801984.quest_subtitle: "饱腹感十足的箱子"
	quest.7C78578B58801984.title: "永不饥饿"
	quest.7C823D19765196A0.quest_desc: [
		"银色地牢宝藏里有瓦尔基里工具和盔甲。瓦尔基里工具有额外的挖掘距离。"
	]
	quest.7C823D19765196A0.quest_subtitle: "瓦尔基里战利品"
	quest.7C823D19765196A0.title: "赢得你的翅膀"
	quest.7C86EB4E7F961E99.quest_desc: [
		"&6ICU 配方：&r一个灵性水晶由一颗绿宝石和一个&e振金锭&r组成，并经过充能。"
	]
	quest.7C86EB4E7F961E99.quest_subtitle: "需要振金（Vibranium）"
	quest.7C86EB4E7F961E99.title: "Spirited Tier"
	quest.7C921CC3DAD1A79E.quest_desc: [
		"将三块石板堆叠成一列，可获得三块&e垂直石板&r。游戏中的大多数石板都有一个。"
		""
		"非常适合建造薄墙、窗框和小型家具。"
	]
	quest.7C921CC3DAD1A79E.quest_subtitle: "石板，不过是侧着放的"
	quest.7C921CC3DAD1A79E.title: "垂直石板"
	quest.7CAF89F33C6A23E9.quest_desc: [
		"&eMaple&r trees fill the Maple Woods and the Seasonal Forest. Their leaves come in red, orange and yellow, and each color drops its own sapling."
		""
		"每种各拿一个，给自己种上一个秋天。"
	]
	quest.7CAF89F33C6A23E9.quest_subtitle: "红色、橙色和黄色"
	quest.7CAF89F33C6A23E9.title: "秋日色彩"
	quest.7CB87324950BBA67.quest_desc: [
		"制作你的第一个 &eSingularity&r。EMI 列出了压缩机接受的所有材料及其所需数量。"
		""
		"提示：将矿石处理直接连接到压缩机，就不用管它了。"
		""
		"&6Platinum&r is the tricky one. The reliable source is Industrial Foregoing's &eLaser Drill&r with a &eLight Blue Laser Lens&r (anywhere but the End)."
	]
	quest.7CB87324950BBA67.quest_subtitle: "一个物品里的一座完整矿井"
	quest.7CB87324950BBA67.title: "奇点 (Singularities)"
	quest.7CD6FA498B8A3BE7.quest_desc: [
		"&e大鼠升级：矿石倍增器&r可将大鼠变成小型矿石处理器。"
		""
		"It's a nice early boost. Mekanism's ore processing gets more out of each ore later on."
	]
	quest.7CD6FA498B8A3BE7.quest_subtitle: "由老鼠驱动的矿石加工系统"
	quest.7CD6FA498B8A3BE7.title: "矿石翻倍"
	quest.7D03361C7130F106.quest_desc: [
		"建造一个&e铜傀儡&r：一个铜块，上面放一个雕刻过的南瓜，再上面放一个引雷针。"
		""
		"它会四处走动，按下 &e铜按钮&r（两个铜锭叠放），并像普通铜一样慢慢变绿。"
	]
	quest.7D03361C7130F106.quest_subtitle: "一个小小的铜质伙伴"
	quest.7D03361C7130F106.title: "Off You Go"
	quest.7D1776C584E8885F.quest_desc: [
		"锻造台上的钻石锤、下界合金升级模板和下界合金锭。"
		""
		"它能像下界合金镐一样挖掘，可以3x3地清除&eAllthemodium&r矿石。Vibranium仍然需要Allthemodium镐。"
	]
	quest.7D1776C584E8885F.quest_subtitle: "巨大的金属，巨大的空洞"
	quest.7D1776C584E8885F.title: "下界合金锤"
	quest.7D7286F2F780B9C3.quest_desc: [
		"将同种材质的斧头、铲子和镐放在两根木棍上。"
		""
		"&ePaxel&r能挖掘那三种生物能挖的一切，还能剥树皮、刮铜矿和铺土路。"
	]
	quest.7D7286F2F780B9C3.quest_subtitle: "一个栏位三种工具"
	quest.7D7286F2F780B9C3.title: "Paxel"
	quest.7DBF8671B347207F.quest_desc: [
		"几乎所有的背包升级都始于一个&e升级底座&r：铁、皮革和线。"
		""
		"将升级物品放入背包界面侧面的插槽中。更大的背包有更多的插槽。"
	]
	quest.7DBF8671B347207F.quest_subtitle: "每一次升级都从这里开始"
	quest.7DBF8671B347207F.title: "升级基地"
	quest.7DFBF239B0A73B74.quest_desc: [
		"紫水晶碎片能制作出钻石级工具，可承受840次使用。紫水晶工具也比黄金工具更容易附魔。"
		""
		"紫晶盔甲的防护力与钻石盔甲相当，并增加了击退抗性。"
	]
	quest.7DFBF239B0A73B74.quest_subtitle: "美观又实用"
	quest.7DFBF239B0A73B74.title: "紫水晶齿轮"
	quest.7E11FCBC16CF1610.quest_desc: [
		"三个粘土球可以制作成四个&e粘土碗&r。将它们熔炼成&e陶土碗&r。"
		""
		"在水源处填充一个以制作&e陶土水碗&r，像瓶子一样烹饪它即可清洗。"
	]
	quest.7E11FCBC16CF1610.quest_subtitle: "廉价的水容器"
	quest.7E11FCBC16CF1610.title: "陶碗"
	quest.7E125B2B169A1483.quest_desc: [
		"&e水晶箱&r会把最好的物品展示在外面。钻石箱周围环绕着玻璃。"
		"&e黑曜石箱子&r能抗住爆炸。钻石箱子周围的区域铺满黑曜石。"
	]
	quest.7E125B2B169A1483.quest_subtitle: "炫耀一下，或者做好防爆措施"
	quest.7E125B2B169A1483.title: "水晶和黑曜石"
	quest.7E265E04631E5CD5.quest_desc: [
		"在砧板上切牛肉制成肉末，烹饪成&e牛肉饼&r，然后用面包、绿叶蔬菜、番茄和洋葱制作。"
	]
	quest.7E265E04631E5CD5.quest_subtitle: "经典之作"
	quest.7E265E04631E5CD5.title: "汉堡包"
	quest.7E299B162E50D357.quest_desc: [
		"&eMaulers&r 在沙漠、荒地和平原上游荡。名字就说明了一切。"
		""
		"干掉一个。"
	]
	quest.7E299B162E50D357.quest_subtitle: "注意看沙子"
	quest.7E299B162E50D357.title: "它会咬人"
	quest.7E60EEC6EECBC94F.quest_desc: [
		"你可能甚至注意不到的几个 Quark 小调整："
		"右键将梯子搭在另一个梯子上以放下它，攀爬时向下看可以滑得更快。"
		"双开门会同时打开。锄头能清除3格宽的植物（钻石和下界合金为5格宽）。"
		"盔甲架有手臂，将物品右键点击熔岩桶可将其永久销毁。"
	]
	quest.7E60EEC6EECBC94F.quest_subtitle: "现在可以正常使用的东西有："
	quest.7E60EEC6EECBC94F.title: "生活质量提升模组"
	quest.7E673601D67AA63D.quest_desc: [
		"编写一个&e时刻表&r（要访问的车站、等待时长），然后把它交给坐在驾驶座上的司机。"
		""
		"坐在驾驶座上的生物或前方的烈焰人燃烧器可以驾驶。"
	]
	quest.7E673601D67AA63D.quest_subtitle: "自动驾驶仪"
	quest.7E673601D67AA63D.title: "列车时刻表"
	quest.7E71E6BD356EE787.quest_desc: [
		"一个&e末地工匠台&r（由工作台、末地之眼和末地锭制成）制作缓慢，无需能量。附近3格内的&e末地转换器&r（包括上下方）能加快其速度。"
		""
		"它能制作增强型末影锭和末影之星。"
	]
	quest.7E71E6BD356EE787.quest_subtitle: "等待的力量"
	quest.7E71E6BD356EE787.title: "末地合成台"
	quest.7E721C988509F20A.quest_desc: [
		"将编码器切换到&e处理&r模式，用于机器制作的配方（熔炼、破碎、压制）。"
		""
		"将图案放入面向机器的图案提供器中，并将输出送回网络。"
	]
	quest.7E721C988509F20A.quest_subtitle: "机器加入其中，共同协作"
	quest.7E721C988509F20A.title: "正在处理模式文件"
	quest.7E8392C46932C97C.quest_desc: [
		"1M组件：三个256k组件、一个积累处理器、天空石粉尘和绚丽石英玻璃。"
		""
		"MEGA 电池需要 &eMEGA 电池外壳&r (sky steel)。"
	]
	quest.7E8392C46932C97C.quest_subtitle: "一百万字节"
	quest.7E8392C46932C97C.title: "MEGA 1M"
	quest.7E97DF3D601D88EB.quest_desc: [
		"Mekanism机器可以从任意一侧设置。 &eConfigurator&r可在输入、输出和关闭之间切换一侧。"
		""
		"潜行加右键可切换模式。大多数机器在GUI中也有一个侧边配置选项卡。"
	]
	quest.7E97DF3D601D88EB.quest_subtitle: "你新的最爱工具"
	quest.7E97DF3D601D88EB.title: "欢迎来到机械动力模组的世界"
	quest.7EA66578CA2A46AC.quest_desc: [
		"用铁、红石和德拉科尼ウム包裹一个Dislocator，即可得到&e物品移除器&r。"
		""
		"它能将附近的掉落物吸入你的物品栏，让挖矿和打怪都变得整洁多了。"
	]
	quest.7EA66578CA2A46AC.quest_subtitle: "战利品会找到你"
	quest.7EA66578CA2A46AC.title: "物品消失器"
	quest.7EDABD88E1DCC2DF.quest_desc: [
		"野生&e传送石&r可以在所有三个原版维度中找到，部分村庄也有一座。"
		""
		"右键点击其中一个以激活它。之后你可以从任何其他传送石传送到这里。"
	]
	quest.7EDABD88E1DCC2DF.quest_subtitle: "有人把灯开着就离开了"
	quest.7EDABD88E1DCC2DF.title: "找到一个传送石（Waystone）"
	quest.7F0688B2DD8696A9.quest_desc: [
		"&eFarmer's Structures&r 在平原、草原、河流、下界森林，甚至天界和地下花园中散布着小型农场和厨房。"
		""
		"找到一个后勾选此项即可。"
	]
	quest.7F0688B2DD8696A9.quest_subtitle: "某个人的花园"
	quest.7F0688B2DD8696A9.title: "农夫的建筑群 (Farmer's Structures)"
	quest.7F1985EB636A1BA7.quest_desc: [
		"Draconium 锭、两个 Wyvern 能量控制器和一个 &eWyvern 核心&r。"
		""
		"放置它，用四个稳定器包围它，然后打开屏幕。 &e切换建造指南&r会显示当前等级的外壳。"
	]
	quest.7F1985EB636A1BA7.quest_subtitle: "一个房子大小的电池"
	quest.7F1985EB636A1BA7.title: "能量核心"
	quest.7F2B3D32A89E4CEB.quest_desc: [
		"八个生成器围绕一个&e回响碎片&r，就能制作出它的&e8倍&r版本。"
		""
		"&6注意：&r在ICU中，8x版本不仅发电量更大，燃料消耗也更快。非常适合节省空间，但不适合节省燃料。"
	]
	quest.7F2B3D32A89E4CEB.quest_subtitle: "所有东西都乘以八倍"
	quest.7F2B3D32A89E4CEB.title: "8x 发电机"
	quest.7F7B3CE341146998.quest_desc: [
		"在 &e精英&r 工作台制作：钻石、青金石、铁、金和两颗 &e下界之星&r 可制作四个晶化锭。"
		""
		"所有自动合成台都需要晶化组件。"
	]
	quest.7F7B3CE341146998.quest_subtitle: "你的第一个 7x7 配方"
	quest.7F7B3CE341146998.title: "Crystaltine"
	quest.7FCAF317E055B182.quest_desc: [
		"远离你的农场会冻结，除非其区块已加载。使用&eChunk Loader&r或用&eFTB Chunks&r强制加载区块（打开Xaero地图）。"
		""
		"ICU 中的区块保护无效，所以船只和 Create 机器能到处使用。Utilities 章节有完整任务。"
	]
	quest.7FCAF317E055B182.quest_subtitle: "先离开，回来再搜刮战利品"
	quest.7FCAF317E055B182.title: "持续运转的农场 (Farms That Keep Running)"
	quest.7FEE95BB4127E777.quest_desc: [
		"&eFrogports&r 抓取包裹并通过 &eChain Conveyors&r 将其送往其他青蛙港。"
		""
