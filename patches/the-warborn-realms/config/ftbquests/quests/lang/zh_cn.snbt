	quest.01219DEB95032DC7.title: "制作一套&b 暗影行者盔甲"
	quest.0177BB2C7A23D8EF.quest_desc: ["面包师会制作面包面团、饼干面团、蛋糕面团和生南瓜派，然后用熔炉将它们烤成面包、饼干、蛋糕和南瓜派。只有在厨师、邮箱或仓库最低库存要求提出请求时，他们才会执行此操作。"]
	quest.0177BB2C7A23D8EF.quest_subtitle: "为&f餐厅&7制作&f熟食&7。&7烹饪&f熟食&7给&f餐厅&7。"
	quest.0177BB2C7A23D8EF.title: "&f建造一个&6烹饪台"
	quest.01CD8EBC9F31301D.title: "Jax：第一阶段"
	quest.01E83EF43D3A1646.quest_desc: ["墓园是守墓人埋葬已故市民的地方。当市民死亡时，死亡地点会生成一座坟墓。守墓人会在坟墓消失前尝试回收。成功的话，守墓人会回到墓园并尝试复活该市民。若无法复活，守墓人会将市民埋葬在墓园中，并在墓旁放置刻有市民名字的墓碑。"]
	quest.01E83EF43D3A1646.quest_subtitle: "照顾好你的&f死者&7。&7"
	quest.01E83EF43D3A1646.title: "&f建造一个&6墓园"
	quest.0206507E91CB74CB.quest_subtitle: "在锻造台使用以移除&4附魔或升级"
	quest.0206507E91CB74CB.title: "制作一个&bShriving Stone"
	quest.027C0D2BEA2286B4.quest_desc: [
