# AI 初翻，未人工校对
{
	chapter_group.151E3065A6314194.title: "故事背景"
	chapter_group.33DD2706D9DC058E.title: "支线任务"
	chapter.7A48A5C74985F285.title: "第一幕：守护者苏醒"
	chapter.7A48A5C74985F285.chapter_subtitle: [
		"你睁开眼，发现自己正悬浮在无尽的黑暗中，脚下只有一个方块。"
	]
	quest.4420EDD6D235742E.title: "欢迎，守护者（Keeper）"
	quest.4420EDD6D235742E.quest_subtitle: "世界被吞噬了。只有一个方块记得这一切。"
	quest.4420EDD6D235742E.quest_desc: [
		"&7&o世界并非毁于烈火，而是毁于遗忘。&r"
		""
		"末影龙吞噬了世界的记忆，一切开始分崩离析，一个生物群系接一个。只有一个方块太过顽固，无法被吞噬：Oneblock。"
		""
		"它记得太多，无法被吃掉。但它需要一双手来重建世界。你的双手。"
		""
		"守护者，准备好了就勾选复选框吧。"
	]
	quest.209B47F8917A91E1.title: "它会大声地记住一切"
	quest.209B47F8917A91E1.quest_subtitle: "打破方块。看看它会变成什么。"
	quest.209B47F8917A91E1.quest_desc: [
		"打破方块。它不会凭空消失：它会颤抖、发光，并变成全新的东西。"
		""
		"&7&oOneblock 没给你资源。它在大声回忆呢。&r"
		""
		"你的岛屿很小，收集12个泥土把它扩建吧。每个世界都始于某处。"
	]
	quest.1D5A99EE12A11359.title: "一枚名为记忆的种子"
	quest.1D5A99EE12A11359.quest_subtitle: "树木记得如何生长。"
	quest.1D5A99EE12A11359.quest_desc: [
		"树木是这个世界最早的记忆。寻找橡树苗：方块上的叶子有时会掉落，流浪的 NeoTrader 也出售它们。"
		""
		"提示：破坏几个方块后，NeoTrader 就会出现。在岛上寻找那个孤独的身影吧！"
	]
	quest.2F9B1094398A1E8A.title: "根源"
	quest.2F9B1094398A1E8A.quest_subtitle: "把它种下。给它光和空间。"
	quest.2F9B1094398A1E8A.quest_desc: [
		"将树苗种在泥土上，并用骨粉撒在上面。它需要上方有开阔的空间才能长成大树。"
		""
		"木材几乎能制作一切：工具、桌子和房子。收集6个橡木原木。"
	]
	quest.06512E123156DB4D.title: "双手创造奇迹模组"
	quest.06512E123156DB4D.quest_desc: [
		"将原木变成木板，木板变成工作台。现在你的双手可以制作 Oneblock 记住的任何东西。"
	]
	quest.0F11EBFF9F211E23.title: "可以用来破坏的东西（Something to Break With）"
	quest.0F11EBFF9F211E23.quest_subtitle: "下一个记忆是由石头构成的。"
	quest.0F11EBFF9F211E23.quest_desc: [
		"很快这个方块就会记住石头，而你无法徒手捡起石头了。"
		""
		"制作木制镐：木棍做柄，木板做头。"
	]
	quest.0EDA6D725B6B4B08.title: "铭文 The Inscription"
	quest.0EDA6D725B6B4B08.quest_subtitle: "森林苏醒了。"
	quest.0EDA6D725B6B4B08.quest_desc: [
		"刻在最初给你的那块石头上的是一首几乎被磨平的韵文："
		""
		"&7&o方寸之间，囊括世界，&r"
		"&7&o森林、深海，还有下界之火。&r"
		"&7&o破坏者建造，建造者修复，&r"
		"&7&o并束缚着巨龙偷窃的海岸。&r"
		""
		"你现在是守护者了。你破坏的每个方块，建造的每台机器，都在强化Oneblock的记忆。"
		""
		"&a领取奖励！&r 然后继续挖掘：大约挖100个方块后，Oneblock就会记住这片森林。"
	]
	chapter.0C55F0E22C6E1DF6.title: "第二幕：土壤的记忆"
	chapter.0C55F0E22C6E1DF6.chapter_subtitle: [
		"最初的记忆很简单：泥土、树苗，还有能吃的东西。"
	]
	quest.636F109CB61AA35D.title: "石头会记住一切"
	quest.636F109CB61AA35D.quest_subtitle: "抓紧第一块石头，不要放手。"
	quest.636F109CB61AA35D.quest_desc: [
		"森林苏醒了，随之而来的还有石头。采集16块鹅卵石。"
		""
		"&7&o石头是耐心的。它记得自己曾经支撑过的一切。&r"
	]
	quest.64EDD85E1F280007.title: "装在箱子里的火"
	quest.64EDD85E1F280007.quest_desc: [
		"熔炉能把原材料变成有用的东西：沙子变玻璃，土豆变零食，还有（很快）矿石变金属。"
		""
		"用8块鹅卵石围住合成台的中心部分。"
	]
	quest.62E6A056A1526BA0.title: "放置物品的地方（Somewhere to Put Things）"
	quest.62E6A056A1526BA0.quest_subtitle: "找不到的回忆，就是已经失去的回忆。"
	quest.62E6A056A1526BA0.quest_desc: [
		"Oneblock 记得越多，你携带的东西就越多。建造一个箱子来存放所有物品。"
		""
		"之后你会把它升级成更大得多的东西。"
	]
	quest.2008489244695805.title: "万物各得其所的归属地"
	quest.2008489244695805.quest_subtitle: "Sophisticated Storage"
	quest.2008489244695805.quest_desc: [
		"普通箱子很快就满了。一个&eSophisticated Storage 箱子&r看起来一样，但可以升级：更多空间、能吸物品的磁铁、能填饱肚子的喂食器等等。"
		""
		"现在就做一个，上次任务的升级底座正是它喜欢的食物。"
		""
		"&e配方：&r一个周围环绕着木板的大箱子。按住 &eShift&r 并用升级物品右键点击它，将升级放入箱内。"
	]
	quest.04F561A63FE5B384.title: "耕地工具包"
	quest.04F561A63FE5B384.quest_subtitle: "土壤只有在被唤醒时才会记得生长的事情。"
	quest.04F561A63FE5B384.quest_desc: [
		"制作石制锄头，然后用它在泥土上制作农田。在旁边放置水，农田就会保持湿润。"
		""
		"提示：你需要一个水源。去检查 Oneblock 给你的第一个宝箱吧！"
	]
	quest.5ECC91AE8D0EA433.title: "首次丰收"
	quest.5ECC91AE8D0EA433.quest_subtitle: "小麦：世界上最古老的记忆。"
	quest.5ECC91AE8D0EA433.quest_desc: [
		"在农田上种植小麦种子并等待。当麦秆变成金黄色时，将其收割。"
		""
		"收集3个小麦。你需要它来制作面包和碎片。"
	]
	quest.06D383936388AA57.title: "Crunch"
	quest.06D383936388AA57.quest_desc: [
		"NeoTrader在森林里卖胡萝卜。种一棵，它就会长出更多。收获3个胡萝卜。"
	]
	quest.121F04443DF6B7D2.title: "地下宝藏"
	quest.121F04443DF6B7D2.quest_desc: [
		"土豆直接长在土里。收获3个土豆。"
	]
	quest.0B56BA037F4035A4.title: "如记忆般鲜红"
	quest.0B56BA037F4035A4.quest_desc: [
		"甜菜种子是另一个商人发现的物品。收获3个甜菜。"
	]
	quest.276D03C810FD64FD.title: "多汁的"
	quest.276D03C810FD64FD.quest_subtitle: "农夫的欢乐时光"
	quest.276D03C810FD64FD.quest_desc: [
		"番茄长在攀爬绳索的藤上。用 JEI 查找它们的种子（将鼠标悬停在物品上并按 R）。"
		""
		"收获3个番茄。"
	]
	quest.33FFC1AF62CD9F5E.title: "绿叶蔬菜"
	quest.33FFC1AF62CD9F5E.quest_desc: [
		"卷心菜会长成整齐的球状。收获3个卷心菜。"
	]
	quest.61A7BEC56CA59482.title: "不要哭泣"
	quest.61A7BEC56CA59482.quest_desc: [
		"像胡萝卜一样把洋葱种在土里。收获3个洋葱。"
	]
	quest.6C5BDE9AC885AFE8.title: "湿漉漉的脚丫子"
	quest.6C5BDE9AC885AFE8.quest_desc: [
		"水稻生长在浅水中。把它种在水洼里，收获3个。"
	]
	quest.7D884B274B6883CE.title: "每日面包"
	quest.7D884B274B6883CE.quest_desc: [
		"三粒小麦能做一个面包。快制作吧！守护者也需要吃饭。"
	]
	quest.218127007B3E5696.title: "烫手山芋"
	quest.218127007B3E5696.quest_desc: [
		"用熔炉烤一个土豆。这是最简单的食物了。"
	]
	quest.119AD8785EC40EB7.title: "厨师之刃"
	quest.119AD8785EC40EB7.quest_subtitle: "农夫的欢乐时光"
	quest.119AD8785EC40EB7.quest_desc: [
		"Farmer's Delight 为游戏世界增添了一个完整的厨房。燧石刀能让你在砧板上切东西。"
		""
		"燧石来自砾石。或者问问 NeoTrader 吧！"
	]
	quest.08DD2A8879B0F5CD.title: "一位长着羽毛的朋友"
	quest.08DD2A8879B0F5CD.quest_subtitle: "动物们也是有记忆的。"
	quest.08DD2A8879B0F5CD.quest_desc: [
		"动物会随游荡的 NeoTrader 的 mob 票掉落到你的岛屿上。用种子换一只鸡，喂饱它，然后收集鸡蛋。"
		""
		"&7&o漂浮岛屿上奶牛困惑地哞叫是一项光荣的传统。&r"
	]
	quest.312DD3CA1011E698.title: "一片小森林"
	quest.312DD3CA1011E698.quest_subtitle: "盆景树 (Bonsai Trees)"
	quest.312DD3CA1011E698.quest_desc: [
		"盆景盆能在小空间里种下一整棵树。在这么小的岛上，这可很重要！"
		""
		"问问 NeoTrader，或者在一块地里的箱子里找找锅。"
	]
	quest.37A88B11E50488DB.title: "成长的碎片 (Shard of Growth)"
	quest.37A88B11E50488DB.quest_subtitle: "种植方块给你的所有东西。"
	quest.37A88B11E50488DB.quest_desc: [
		"世界还记得如何生长。证明吧：用首批收获的八种作物，合成&a生长碎片&r。"
		""
		"&e配方：&r将树苗放在合成台中央，周围放上小麦、胡萝卜、土豆、甜菜根、番茄、卷心菜、洋葱和大米。"
		""
		"&7&oOneblock 发出绿色脉冲，草开始自动蔓延到你的建筑上。&r"
		""
		"&a领取奖励&r以唤醒下一个记忆：地下。需要 300 个破损方块。"
	]
	chapter.6010067DAEBFE812.title: "第三幕：齿轮的记忆"
	chapter.6010067DAEBFE812.chapter_subtitle: [
		"旧世界并非仅靠魔法就能运转的。"
	]
	quest.4C7652296B9B501F.title: "破损的齿轮"
	quest.4C7652296B9B501F.quest_subtitle: "比石头更奇怪的东西。"
	quest.4C7652296B9B501F.quest_desc: [
		"&7&o更深层的记忆浮现：石头、铁、铜，还有更奇怪的东西。&r"
		""
		"方块正在掉落工程师机器的碎片。最重要的是&e安山合金&r，他们用这种金属建造了一切。"
		""
		"提示：可以用安山岩和铁粒来制作。制作4个。"
	]
	quest.37C7E18AFFC43370.title: "会旋转的东西 (Things That Turn)"
	quest.37C7E18AFFC43370.quest_subtitle: "传动轴和齿轮。"
	quest.37C7E18AFFC43370.quest_desc: [
		"工程师的机器都以相同方式运转：旋转的传动轴将动力从一个部件传递到下一个。"
		""
		"制作一个&e轴&r、一个&e齿轮&r和一个&e大齿轮&r。大小齿轮可以啮合在一起以改变速度。"
		""
		"提示：在 JEI 中悬停物品时按住 W 键，即可查看 Create 机器的运作方式（Ponder）。"
	]
	quest.7D7047F599018438.title: "看看旋转的效果吧"
	quest.7D7047F599018438.quest_desc: [
		"工程师戴护目镜是为了看清机器转动的速度。制作&e工程师护目镜&r和&e扳手&r。扳手可以旋转并拾起机器，而不会损坏它们。"
	]
	quest.197F309F28E12A23.title: "双手的力量"
	quest.197F309F28E12A23.quest_subtitle: "最初的引擎一直都是一个手臂。"
	quest.197F309F28E12A23.quest_desc: [
		"在水和风之前，有双手。将&e手摇柄&r连接到轴上，按住右键即可转动。"
		""
		"&7&o虽然慢，但管用。每个工程师都是从这样开始的。&r"
	]
	quest.2CA382F6D7FCD625.title: "水会记住一切"
	quest.2CA382F6D7FCD625.quest_subtitle: "让河流来完成这项工作吧。"
	quest.2CA382F6D7FCD625.quest_desc: [
		"你的手臂会累，水不会。只要有水流过，&e水车&r就会全天转动，无需任何人摇动。"
		""
		"提示：你需要&e流动&r的水。将一桶水倒在较高的方块上，让它沿着轮子流下来。"
	]
	quest.01C0549BA7EFE5BC.title: "一种名为锌的金属"
	quest.01C0549BA7EFE5BC.quest_subtitle: "黄铜需要两种金属。"
	quest.01C0549BA7EFE5BC.quest_desc: [
		"部分地下方块是锌矿石：一种银蓝色的金属，工程师用它和铜混合制成&e黄铜&r。"
		""
		"采集锌矿石，然后冶炼生锌。收集4个锌锭。"
	]
	quest.1F18B715E47B644D.title: "能吃矿石的车轮"
	quest.1F18B715E47B644D.quest_subtitle: "从一个矿石块中获得两个矿石块。"
	quest.1F18B715E47B644D.quest_desc: [
		"一对&e碾压轮&r将矿石磨成碎块，熔炼出的金属比普通矿石更多。"
		""
		"它们必须相互旋转，朝向同一方向。扳手会有所帮助。"
	]
	quest.4EFE28CCA97AEACF.title: "第一台机器的皮肤定制服务"
	quest.4EFE28CCA97AEACF.quest_subtitle: "安山岩外壳"
	quest.4EFE28CCA97AEACF.quest_desc: [
		"你即将建造的每台机器都带有外壳，最简单的由安山岩制成。磨石、压榨机、搅拌机和钻头都围绕着一个外壳建造。"
		""
		"提示：外壳是将安山合金应用到&e去皮原木&r上制成的。用斧头去皮原木，然后用部署器或手动右键合金到原木上。制作2个。"
	]
	quest.5FB90F3FA40778B6.title: "把它磨得细细的"
	quest.5FB90F3FA40778B6.quest_subtitle: "磨坊石"
	quest.5FB90F3FA40778B6.quest_desc: [
		"&e磨石&r能把东西磨成粉：小麦磨成面粉，砾石磨成燧石和矿石。用转轴驱动，把物品扔上去就行。"
		""
		"这本书里其他机器都是以粉末开头的。"
	]
	quest.116972D71F05F41E.title: "把它印成扁平的"
	quest.116972D71F05F41E.quest_subtitle: "机械压力机"
	quest.116972D71F05F41E.quest_desc: [
		"&e机械压机&r将锭压成薄薄的金属&e板&r。板是几乎所有未来机器的外壳。"
		""
		"它需要一个下方的&edepot&r或盆地来盛放被压的物品。"
	]
	quest.42BB3AD17B9A9961.title: "把烦恼都抖出去"
	quest.42BB3AD17B9A9961.quest_subtitle: "创建筛分机"
	quest.42BB3AD17B9A9961.quest_desc: [
		"砾石不仅仅是砾石：Oneblock 里面藏着小金属块。用带网的 &e筛子&r 就能把它们筛出来。"
		""
		"从一个字符串网格开始，升级网格以找到更好的东西。"
	]
	quest.7A67461D6078DA40.title: "更精细的网格结构 (A Finer Mesh)"
	quest.7A67461D6078DA40.quest_desc: [
		"更坚固的网格能捕捉更小、更重的碎片。合成一个安山岩网格。"
	]
	quest.7C78CBFBF974B038.title: "黄铜网格"
	quest.7C78CBFBF974B038.quest_desc: [
		"黄铜能筛出迄今最精细的网眼。它能筛出最细微、最沉重的颗粒：那些其他筛网漏掉的金属。"
	]
	quest.248E333126A1A03A.title: "机器的苏醒"
	quest.248E333126A1A03A.quest_subtitle: "洞穴会记住一切。"
	quest.248E333126A1A03A.quest_desc: [
		"水流转动轮子，轮子转动轴，轴驱动压榨机。自“破灭”以来，第一台运转的机器。"
		""
		"&7&o水车转动。机械压榨机冲压。&r"
		""
		"展示你拥有的 Oneblock，上面有 &e机械压榨机&r 和 &e磨石&r，都已准备就绪。"
		""
		"&a领取奖励&r以唤醒下一个记忆：洞穴。需要 650 个破损方块。"
	]
	quest.137AC09C714FA808.title: "把它搅拌起来"
	quest.137AC09C714FA808.quest_subtitle: "搅拌机和盆子"
	quest.137AC09C714FA808.quest_desc: [
		"机器不仅能研磨和压制。一个&e机械搅拌机&r能将东西在&e盆中&r混合，产出全新的东西。"
		""
		"搅拌机位于水槽上方，需要从侧面供电。"
	]
	quest.11F27314C94DE556.title: "黄金与铜的歌声"
	quest.11F27314C94DE556.quest_subtitle: "黄铜"
	quest.11F27314C94DE556.quest_desc: [
		"工程师们最喜爱的金属并非天然存在，而是人工制造。在搅拌机中混合 &e铜和锌&r，你就能得到黄铜，这种能将最精密的机器粘合在一起的亮黄色金属。"
		""
		"制作8个黄铜锭。"
		""
		"&7&o黄铜与安山岩：Oneblock 记住了它的第一种合金。&r"
	]
	quest.56CA72241AB290DE.title: "机器皮肤（Skins for Machines）"
	quest.56CA72241AB290DE.quest_subtitle: "外壳组件"
	quest.56CA72241AB290DE.quest_desc: [
		"强大的机器需要外壳。安山岩外壳用于简单的机器；&e黄铜外壳&r则用于更复杂的机器。"
		""
		"提示：外壳是将金属锭应用到&e去皮原木&r上：安山岩外壳用安山岩合金，黄铜外壳用黄铜锭。用斧头去皮原木，然后用放置器或用右键将锭直接放在原木上。"
	]
	quest.28AAD0A92A5C92D7.title: "不属于你的手的一只手"
	quest.28AAD0A92A5C92D7.quest_subtitle: "部署器"
	quest.28AAD0A92A5C92D7.quest_desc: [
		"&e部署器&r是一种机械手。它能自己放置方块、使用工具，还能把东西按到其他东西上。"
		""
		"这就是建造小巧精致部件的秘诀所在。"
		""
		"提示：它的&e电子管&r需要&e玫瑰石英&r。用压轮机粉碎正岩可以获得石英。将其和红石混合，然后用砂纸打磨。"
	]
	quest.33BCC2DAC51D5B91.title: "精准度"
	quest.33BCC2DAC51D5B91.quest_subtitle: "那部分无人能够创造出来。"
	quest.33BCC2DAC51D5B91.quest_desc: [
		"每台伟大机器的心脏都是一个&e精密机械&r。无人能手工打造，因为它分步骤制造：金箔，然后是齿轮，再是压制，周而复始。"
		""
		"打开 JEI 查找配方。这是一个&e序列组装&r：一个部署器、一个压机和一个仓库，按顺序排列。"
		""
		"制作 2 个。"
	]
	quest.7EBA1F2201FB115D.title: "缓慢燃烧"
	quest.7EBA1F2201FB115D.quest_subtitle: "比你得到的岩浆还要多的岩浆。"
	quest.7EBA1F2201FB115D.quest_desc: [
		"&7&o如果你教会它们方法，深海自会燃起火焰。&r"
		""
		"岩浆很容易用完，却很难找到。Oneblock 给了你一个桶，可能还有两个。机器和熔炉会需要更多。"
		""
		"洞穴以一种耐心的方式向下生长着事物。尖晶石从天花板滴落，一滴一滴，缓慢而持续。如果滴落的是火焰，会发生什么呢？"
		""
		"带上 &e2桶岩浆&r、一个 &e尖滴石&r 和一个 &e炼药锅&r。"
		""
		"&7提示：商人可能会用滴水石锥换取圆石。&r"
	]
	quest.4C77118263B85F08.title: "深入挖掘"
	quest.4C77118263B85F08.quest_subtitle: "机械钻头"
	quest.4C77118263B85F08.quest_desc: [
		"只要不停转动，&e机械钻头&r就能自行粉碎前方的任何东西。"
		""
		"&7&o想象一下，用比双手更快的速度搬运方块。&r"
	]
	quest.53151E9D800DC4BA.title: "运输者 (The Hauler)"
	quest.53151E9D800DC4BA.quest_subtitle: "一个能帮你破坏Oneblock的装置。"
	quest.53151E9D800DC4BA.quest_desc: [
		"安装在&e机械轴承&r上的钻头会旋转。对准Oneblock，就能反复将其破坏。"
		""
		"&e小心：&r旋转的钻头会摧毁路径上的一切，所以让你的农场避开它！"
	]
	quest.0E60847530F92EE9.title: "Ssssaw"
	quest.0E60847530F92EE9.quest_subtitle: "机械锯子"
	quest.0E60847530F92EE9.quest_desc: [
		"&e机械锯&r能将原木切成木板，产量是工作台的两倍。它还能将石头切成切块。"
	]
	quest.6220677340817091.title: "洞穴中的风"
	quest.6220677340817091.quest_subtitle: "密封式风扇"
	quest.6220677340817091.quest_desc: [
		"&e封闭式风扇&r能推动物体随微风移动，当空气穿过火或水时，可以改变所携带之物：清洗、熏制、爆破。"
	]
	quest.76D51B38D94FCC36.title: "田野中的机器"
	quest.76D51B38D94FCC36.quest_subtitle: "土壤与齿轮在此交汇。"
	quest.76D51B38D94FCC36.quest_desc: [
		"将土壤的记忆与齿轮的记忆结合：&e机械犁&r为你翻土，&e机械收割机&r收割你的播种。"
	]
	quest.5A31E18BEC8F730C.title: "每个细胞都配上一双手"
	quest.5A31E18BEC8F730C.quest_subtitle: "机械合成台"
	quest.5A31E18BEC8F730C.quest_desc: [
		"有些机器太大，无法在合成桌上操作。一个&e机械合成器&r是一个大网格中的一格：将它们排成一行，为每个合成器提供材料，它们就能共同合成一个物品。"
		""
		"每个制作者需要一个&e电子管&r，一个电子管需要&e抛光玫瑰石英&r。一个电子管可以制作&e3个制作者&r，使用黄铜外壳和一张工作台。制作9个制作者（3个电子管）。"
		""
		"&e玫瑰石英：&r一个石英和8个红石粉。用&e砂纸&r打磨，然后加一个铁板做管。"
		""
		"&e石英在这里很稀有。&r 黑石英可以通过黄铜筛网筛沙砾和洞穴方块获得。商人会按1:1的比例用石英交换黑石英。"
	]
	quest.1C704425F945B84F.title: "土豆大炮"
	quest.1C704425F945B84F.quest_subtitle: "因为你可以做到。"
	quest.1C704425F945B84F.quest_desc: [
		"&7&o工程师们有一个非常严肃的工作室，也有一个非常滑稽的工作室。&r"
		""
		"将你的合成台排成一行5个，下方放2个，然后建造&e土豆大炮&r。它会向任何你瞄准的目标发射&e土豆&r和其他食物。"
		""
		"&e配方：&r安山合金、一个精密机械和顶部横跨的3个流体管道，下方是2个铜锭。流体管道由一个铜锭和一张铜板组成。"
	]
	quest.689D77EA31202E25.title: "运动的碎片 (Shard of Motion)"
	quest.689D77EA31202E25.quest_subtitle: "工程师们建造了一个会移动的世界。"
	quest.689D77EA31202E25.quest_desc: [
		"让齿轮再次转动。制作&6运动碎片&r：一个只有正常运行的创造生产线才能生产的黄铜与安山岩核心。"
		""
		"&e配方：&r中间一个黄铜外壳，上下各一个精密机械，左右各一个安山岩合金，四个角各一个黄铜锭。"
		""
		"&7&oThe Oneblock 发出了一种新的、温暖而近乎欢快的嗡鸣声。&r"
		""
		"&a领取奖励&r以唤醒下一个记忆：海洋。需要1100个破损方块。"
		""
		"&6奖励：&r工程师们给你留下了一个&e信标&r。用铁、金、钻石或绿宝石块为它建造一座金字塔，并确保上方天空开阔，它就会向附近的所有人散发一份礼物。"
	]
	chapter.1A07B10975090045.title: "第四幕：深海的记忆"
	chapter.1A07B10975090045.chapter_subtitle: [
		"并非所有记忆都是金属的。其中一些是鲜活的。"
	]
	quest.22934F83BB29641C.title: "浪潮中的法力"
	quest.22934F83BB29641C.quest_subtitle: "方块开始渗出水流。"
	quest.22934F83BB29641C.quest_desc: [
		"&7&o鱼跃出水面，接着是珊瑚，然后是充满魔力的鲜花。&r"
		""
		"海洋苏醒，随之而来的是一种新的发光尘埃：&aInferium Essence&r。它是世界的法力，是构成生命的物质。"
		""
		"收集8个。从哪里？熔炼&einferium ore&r，打开海洋的第一个宝箱，与NeoTrader交易，或者击败动物（20%的几率掉落）。"
	]
	quest.21325F1339DF6D97.title: "会发出嗡嗡声的种子"
	quest.21325F1339DF6D97.quest_subtitle: "能生长出法力本身的种子。"
	quest.21325F1339DF6D97.quest_desc: [
		"在合成台里用8个inferium essence围住一个普通小麦种子，你就能得到一个&einferium种子&r。"
		""
		"种下它，它就会生长出……更多的精粹！能自己产生魔力的植物：迈向永不枯竭的第一步。"
	]
	quest.4F3AB8AAB27F71C3.title: "会倾听的土壤"
	quest.4F3AB8AAB27F71C3.quest_subtitle: "精粹农田"
	quest.4F3AB8AAB27F71C3.quest_desc: [
		"植物在能记住魔力的土壤中生长得更快。将一种精华与普通的农田方块结合，即可制作出&einferium农田&r。"
		""
		"制作4个，然后将你的inferium种子种植在上面。"
	]
	quest.6F9F34E703DD5D0E.title: "让雨下起来"
	quest.6F9F34E703DD5D0E.quest_subtitle: "浇水壶"
	quest.6F9F34E703DD5D0E.quest_desc: [
		"一个&e浇水壶&r能让它浇过的所有植物长得更快一点，而且永远不会缺水。"
		""
		"铁锭、一个碗和一点骨粉。"
	]
	quest.4716F8C43E26BF9D.title: "Prosperity"
	quest.4716F8C43E26BF9D.quest_subtitle: "构成万物的那些碎片，非他莫属。"
	quest.4716F8C43E26BF9D.quest_desc: [
		"方块中的另一小宝藏：&bprosperity shards&r。它们是本幕几乎所有事物的基础：祭坛水晶、种子基座，甚至是宝石。"
		""
		"采集繁荣矿石并将其冶炼。收集16个。"
	]
	quest.75FE24D2A04B1F3C.title: "海洋铭记着腰带们的故事"
	quest.75FE24D2A04B1F3C.quest_subtitle: "返回第三幕的链接"
	quest.75FE24D2A04B1F3C.quest_desc: [
		"还记得传送带需要 Oneblock 暂时无法提供的东西吗？海带！在熔炉里把它烘干。"
		""
		"干海带是传送带的秘密配方：现在创造模组可以让物品沿直线移动。"
	]
	quest.68093990E716EEA1.title: "第一座花园"
	quest.68093990E716EEA1.quest_subtitle: "繁茂洞穴绽放生机。"
	quest.68093990E716EEA1.quest_desc: [
		"能自行产生魔力的植物，生长在会倾听的土壤里，用永不枯竭的水壶浇灌。一座从无到有建造的花园。"
		""
		"收集足够的精华装满口袋：&a32 下界精华&r。"
		""
		"&a领取奖励&r以唤醒下一个记忆：繁茂洞穴。需要1600个破损方块。"
	]
	quest.0017DE221528FCAC.title: "法力祭坛 (The Altar of Mana)"
	quest.0017DE221528FCAC.quest_subtitle: "灌注祭坛"
	quest.0017DE221528FCAC.quest_desc: [
		"有些东西光靠双手是做不到的。 &eInfusion Altar&r 将原料聚集起来，借助周围的 &epedestals&r，将它们编织成全新的物品。"
		""
		"建造祭坛（石头、红色羊毛和金块）和4个基座。将基座环绕祭坛呈环形放置。"
	]
	quest.35164C99024E6C90.title: "一颗水晶之心"
	quest.35164C99024E6C90.quest_subtitle: "灌注水晶"
	quest.35164C99024E6C90.quest_desc: [
		"祭坛需要一个心脏：&e灌注水晶&r。它由繁荣碎片、下界精华和钻石制成，可承受一千次使用。（之后，你可以制作一个永不磨损的、不可破坏的&6主水晶&r。）"
		""
		"注入时把它放在祭坛上就可以了。"
	]
	quest.740FE3B7E8D1D7C8.title: "第二个声音"
	quest.740FE3B7E8D1D7C8.quest_subtitle: "审慎的本质 (Prudentium essence)"
	quest.740FE3B7E8D1D7C8.quest_desc: [
		"水晶能将普通精华转化为更强大的精华。用4个inferium essence包围水晶，即可制作出&9prudentium essence&r。"
		""
		"制作4个。精华越高级，魔法越强。"
	]
	quest.06C499382372D434.title: "生命宝石（A Gem of Life）"
	quest.06C499382372D434.quest_subtitle: "繁荣与劣等宝石（Prosperity and inferium gemstones）"
	quest.06C499382372D434.quest_desc: [
		"钻石周围的四个繁荣碎片可以合成一个&b繁荣宝石&r。加入两个下界精华，它将成为一个&a下界宝石&r，一颗活着的珠宝。"
	]
	quest.62C4F6882A493BEA.title: "急躁的植物 (Impatient Plants)"
	quest.62C4F6882A493BEA.quest_subtitle: "生长加速器"
	quest.62C4F6882A493BEA.quest_desc: [
		"&e生长加速器&r能让附近的作物永久加速生长，无需一滴水。"
		""
		"配方可制作3个。将其中一个放在花园的中央。"
	]
	quest.7005C192571AC4ED.title: "生长石"
	quest.7005C192571AC4ED.quest_subtitle: "一个装在罐子里的采石场"
	quest.7005C192571AC4ED.quest_desc: [
		"最简单的种子长出最简单的东西。石头种子长出石头精华，而石头精华会变成&e石头&r。"
		""
		"注入 &estone seeds&r，种植它们，并收获 &e8 stone essence&r。"
	]
	quest.0E9543A4DB524888.title: "生长木材"
	quest.0E9543A4DB524888.quest_subtitle: "盆栽里的森林"
	quest.0E9543A4DB524888.quest_desc: [
		"树木生长缓慢，木材种子并非如此。它们会生长出木材精华，而木材精华可以合成原木。"
		""
		"注入 &e木种子&r 并收获 &e8 木精&r。"
	]
	quest.202842134C6FB11D.title: "四角之地"
	quest.202842134C6FB11D.quest_subtitle: "空气、大地、水和火焰"
	quest.202842134C6FB11D.quest_desc: [
		"&7&o在铁出现之前，只有四样东西，但它们就足够了。&r"
		""
		"第一层种子能生长出元素本身：&e空气&r、&e泥土&r、&e水&r和&e火&r。将它们的精粹结合，奇妙的事情就会发生。石头加水变成滴水石，火加泥土变成沙子。"
		""
		"将四种种子各一个进行融合。"
	]
	quest.32F4AC787C15E690.title: "一个繁花盛开的花园"
	quest.32F4AC787C15E690.quest_subtitle: "自然种子类型："
	quest.32F4AC787C15E690.quest_desc: [
		"现在来点巧妙的：能长出&e资源&r的种子。自然种子能长出花草树木的精髓。"
		""
		"打开JEI，查找&enature seeds&r的配方：它是在你新祭坛处的灌注配方。"
	]
	quest.30E1AE330F24C14D.title: "野生法力 (Wild Mana)"
	quest.30E1AE330F24C14D.quest_subtitle: "收获你的第一批资源作物"
	quest.30E1AE330F24C14D.quest_desc: [
		"将自然种子种在农田里并收获。你很快会需要 &a8 自然精华&r 来完成特殊事项。"
	]
	quest.2F53D6D4F6F3925E.title: "成熟的铁块（Grown Iron）"
	quest.2F53D6D4F6F3925E.quest_subtitle: "世界忘记了它的矿石。你可以让它生长。"
	quest.2F53D6D4F6F3925E.quest_desc: [
		"Oneblock 掉落铁的数量可能不如你期望的。但现在你不必依赖它了：在祭坛上注入 &eiron seeds&r，然后种植它们。"
		""
		"&7&o资源作物会生长出精华，可以转化为真正的物品。&r"
	]
	quest.032C2FB49669DAD9.title: "来自土壤的铁块 Iron from the Soil"
	quest.032C2FB49669DAD9.quest_desc: [
		"收获作物：16 个铁精。在工作台里将其合成铁锭（在 JEI 中查找）。"
	]
	quest.1CE71FF271F6649C.title: "一个会收割的助手"
	quest.1CE71FF271F6649C.quest_subtitle: "收割者金字塔"
	quest.1CE71FF271F6649C.quest_desc: [
		"一个&e收割金字塔&r（来自Pylons模组）会将其周围的所有作物收割并存入箱子。把它放在水方块上，顶部放一个箱子，再给它几个锄头。"
		""
		"在你探索期间，它会不知疲倦地工作。"
	]
	quest.2E1A8A8321625260.title: "生长铜矿（Grown Copper）"
	quest.2E1A8A8321625260.quest_subtitle: "电线、电缆和线圈"
	quest.2E1A8A8321625260.quest_desc: [
		"铜存在于所有导电的物体中。Oneblock 会给你一些。祭坛能给你更多。"
		""
		"注入 &e铜种子&r，种植它们，并收获 &e8 铜精华&r。在 JEI 中查看种子以了解祭坛的要求。"
	]
	quest.5E877FE07FDDC76F.title: "已生长的锌矿石"
	quest.5E877FE07FDDC76F.quest_subtitle: "黄铜需要第二种金属才能制作"
	quest.5E877FE07FDDC76F.quest_desc: [
		"锌很害羞，藏在深处的石头里。Oneblock不常提供，而黄铜需要它。"
		""
		"改用这些来种植：&e锌种子&r和&e8个锌精华&r。需要时再将精华合成锌锭。"
	]
	quest.22021619BA487D59.title: "已生长的煤炭"
	quest.22021619BA487D59.quest_subtitle: "无需挖掘即可获得燃料"
	quest.22021619BA487D59.quest_desc: [
		"每个熔炉和发电机都很饿。煤炭种子能让这些饥饿的东西长出食物。"
		""
		"种植 &e煤炭种子&r 并收获 &e8 煤炭精华&r。"
	]
	quest.53449AF8BAC289F5.title: "已生长的红石"
	quest.53449AF8BAC289F5.quest_subtitle: "土壤中的一抹红色火花"
	quest.53449AF8BAC289F5.quest_desc: [
		"红石是几乎所有机器内部的火花。它存在于地下，有时甚至完全找不到。"
		""
		"种植&e红石种子&r并收获&e8个红石精华&r。"
	]
	quest.05AEC389F512D059.title: "成熟的黄铜块（Grown Brass）"
	quest.05AEC389F512D059.quest_subtitle: "铜和锌，已经混合好了"
	quest.05AEC389F512D059.quest_desc: [
		"黄铜是两种金属熔合而成。或者它是一种作物。祭坛并不介意哪种。"
		""
		"注入 &e黄铜种子&r 并收获 &e8 黄铜精华&r。将精华锻造为黄铜锭。"
	]
	quest.7E7C5EB4CC223F44.title: "生长石英"
	quest.7E7C5EB4CC223F44.quest_subtitle: "白色水晶，不需要地狱维度"
	quest.7E7C5EB4CC223F44.quest_desc: [
		"下界石英是最难找的东西之一。机器、电路和图书馆都需要它，而Oneblock要到很晚才提供。"
		""
		"改为种植：注入 &enether quartz seeds&r 并收获 &e8 nether quartz essence&r。将精华合成石英。"
	]
	quest.4983AF9405BDDED9.title: "已生长的萤石"
	quest.4983AF9405BDDED9.quest_subtitle: "你可以采集的发光方块"
	quest.4983AF9405BDDED9.quest_desc: [
		"萤石粉可以点亮灯、酿造药水，还能用于多种意想不到的配方中。"
		""
		"注入 &e发光石种子&r 并收获 &e8 份发光石精华&r。"
	]
	quest.52971330B7325AC0.title: "洞穴中的光明"
	quest.52971330B7325AC0.quest_subtitle: "发光浆果"
	quest.52971330B7325AC0.quest_desc: [
		"繁茂洞穴会生长发光浆果：一种挂在藤蔓上的小发光水果。它们香甜可口，还有点魔法。找到8个。"
	]
	quest.3077F2E48E7C575F.title: "快过来，小家伙们，到我这里来"
	quest.3077F2E48E7C575F.quest_subtitle: "简易磁铁"
	quest.3077F2E48E7C575F.quest_desc: [
		"种满作物的花园会掉落许多小东西：种子、精华、残羹剩饭，散落在草地上。追逐它们很累人。"
		""
		"&e磁铁&r会将所有掉落物吸向你。拿着它，看着物品堆向你走来。"
		""
		"&e配方：&r铁锭、青金石、末影珍珠和红石。末影珍珠最难搞：去问问Oneblock或者商人吧。"
		""
		"&e提示：&r右键磁铁可开关。把它揣进口袋，让世界来找你。"
	]
	quest.576B10D31EE4EA89.title: "再也不会丢失任何物品了"
	quest.576B10D31EE4EA89.quest_subtitle: "垃圾桶"
	quest.576B10D31EE4EA89.quest_desc: [
		"法力农场会产生大量剩余物品：种子、圆石，以及一些你永远用不到的东西。你的箱子快被垃圾填满了。"
		""
		"一个&e垃圾桶&r会删除你放进去的任何东西，这样你就不用再携带或存放多余的物品了。注意：放进去的东西不会回来！"
		""
		"&7&o并非所有回忆都值得被珍藏。&r"
	]
	quest.01441334D798BC59.title: "生命碎片"
	quest.01441334D798BC59.quest_subtitle: "生长而成，而非合成所得。"
	quest.01441334D798BC59.quest_desc: [
		"并非所有记忆都是金属的。种下充满魔力的花园，Oneblock 将赐予你生命本身的记忆。"
		""
		"&e配方：&r中间放一个inferium宝石，两侧放4个prudentium精华，四个角放4个nature精华。"
		""
		"&7&oOneblock 脉动着绿光，绽放出你自 Unmaking 以来从未见过的光芒。&r"
		""
		"&a领取奖励&r以唤醒下一个记忆：下界。需要 2200 个破损方块。"
	]
	chapter.0A88B2192D15715E.title: "第五幕：火焰的记忆"
	chapter.0A88B2192D15715E.chapter_subtitle: [
		"这是真正力量的时代。"
	]
	quest.2CE94BF6825F4417.title: "方块会燃烧"
	quest.2CE94BF6825F4417.quest_subtitle: "下界会记住一切。"
	quest.2CE94BF6825F4417.quest_desc: [
		"&7&oOneblock 变暗并燃烧。下界岩、灵魂沙、烈焰棒，以及像你我一样憎恨龙的猪灵。&r"
		""
		"下界很热，很危险，而且充满了旧世界的建筑材料。从方块、箱子和交易者那里收集 &e2 根烈焰棒&r 和 &e8 个下界石英&r。"
	]
	quest.5A354A2E37B10EEA.title: "一个会回馈你的熔炉"
	quest.5A354A2E37B10EEA.quest_subtitle: "铁质熔炉"
	quest.5A354A2E37B10EEA.quest_desc: [
		"你用过的每个熔炉都会浪费热量。带有&e发电机增强&r的&e铁质熔炉&r能收集这些热量并将其转化为电能（FE）。"
		""
		"建造一个并给它煤炭。这是你的第一个&b电源&r：是你自己制作的。"
	]
	quest.63EE2747E38CC4EE.title: "一颗煤炭之心的机器"
	quest.63EE2747E38CC4EE.quest_subtitle: "实际上附加的模组 (Actually Additions)"
	quest.63EE2747E38CC4EE.quest_desc: [
		"另一种发电方式：&e煤炭发电机&r能燃烧任何易燃物并稳定发电。可与熔炉并用。"
		""
		"想要更绿的吗？试试&e树叶生成器&r：它能燃烧树叶！"
	]
	quest.55441D3EAFCAB52A.title: "能量的转移与运用"
	quest.55441D3EAFCAB52A.quest_subtitle: "电缆和一个能量立方体"
	quest.55441D3EAFCAB52A.quest_desc: [
		"困在发电机里的电力毫无用处。用&e通用电缆&r（钢和红石）连接到机器，多余的存进&e能量立方&r（由钢外壳制成）。"
		""
		"提示：Mekanism的机器接受熔炉产生的同种能量。"
	]
	quest.038F15EC4F37F9CD.title: "重金属摇滚乐队 The Heavy Metal"
	quest.038F15EC4F37F9CD.quest_subtitle: "锇（Osmium）"
	quest.038F15EC4F37F9CD.quest_desc: [
		"锇密度高，呈蓝灰色，比铁更坚固，是Mekanism机器运转的关键。从深层方块中熔炼锇矿石。"
		""
		"收集 8 个锇锭。"
	]
	quest.5AED28E4B1F2BDB5.title: "The Infuser"
	quest.5AED28E4B1F2BDB5.quest_subtitle: "冶金学融合器"
	quest.5AED28E4B1F2BDB5.quest_desc: [
		"&e冶金熔炼器&r将金属与某种“风味”（如碳或红石）混合，以制造更优质的金属。它是Mekanism的核心所在。"
		""
		"它需要电力运行，所以把它放在你建造的发电机旁边。"
	]
	quest.42ADC64FEC236A36.title: "双倍矿石产量 (Double the Ore)"
	quest.42ADC64FEC236A36.quest_subtitle: "富集室"
	quest.42ADC64FEC236A36.quest_desc: [
		"&e富集室&r能将一种矿石变成两堆粉尘，冶炼成两个锭。一种能将一个锭变成更多的矿石加工方法！"
	]
	quest.625D95AC46AD9FCF.title: "粉碎它"
	quest.625D95AC46AD9FCF.quest_subtitle: "破碎机"
	quest.625D95AC46AD9FCF.quest_desc: [
		"&e破碎机&r能将锭、宝石和鹅卵石磨成粉末或砾石。与富集室功能不同：两者都试试吧！"
	]
	quest.4F649F7C2D2BEC7F.title: "钢铁"
	quest.4F649F7C2D2BEC7F.quest_subtitle: "铁 + 碳"
	quest.4F649F7C2D2BEC7F.quest_desc: [
		"将铁和一点&e煤炭（碳）&r放入熔炼炉，就能得到&b钢&r：比铁更坚固，几乎所有高级机器都由这种金属制成。"
		""
		"制作8个钢锭。你需要它们来制作火焰碎片！"
	]
	quest.45CEA37A78A9E80F.title: "更好的金属模组 (Better Metals)"
	quest.45CEA37A78A9E80F.quest_subtitle: "经过强化和浸染的合金"
	quest.45CEA37A78A9E80F.quest_desc: [
		"用红石注入铁，得到&c注入合金&r。再用钻石注入，得到&9强化合金&r。每一步都让金属更坚固、更聪慧。"
		""
		"制作4个浸渍合金和2个强化合金。"
	]
	quest.202B0DB57264A1B5.title: "思考金属"
	quest.202B0DB57264A1B5.quest_subtitle: "控制电路"
	quest.202B0DB57264A1B5.quest_desc: [
		"用锇包裹的浸渍合金可以制作&e控制电路&r：每台机器都需要的小小大脑。合成4个。"
	]
	quest.1ED58DB3B162EFF2.title: "为机器寻找一个身体"
	quest.1ED58DB3B162EFF2.quest_subtitle: "钢制外壳"
	quest.1ED58DB3B162EFF2.quest_desc: [
		"&e钢制外壳&r是顶级机器的主体：外覆钢铁，内藏玻璃与锇。你需要一个来制作火焰碎片。"
	]
	quest.1127C5EF797B0F67.title: "用于Mek的扳手（A Wrench for Mek）"
	quest.1127C5EF797B0F67.quest_subtitle: "配置器"
	quest.1127C5EF797B0F67.quest_desc: [
		"&econfigurator&r可以旋转、拾取并改变机器之间的传输方式。它是Mekanism的扳手。"
	]
	quest.600D58FAF2898C46.title: "镍矿石"
	quest.600D58FAF2898C46.quest_subtitle: "Oritech"
	quest.600D58FAF2898C46.quest_desc: [
		"Oritech 是一种与众不同的机器学派：流线型、快速且强大。其机器由镍、铜和电金制成。将镍矿石从 Oneblock 中冶炼。"
		""
		"收集 8 个镍锭。"
	]
	quest.46524E0F4C93EA04.title: "工程师的扳手 (The Engineer's Wrench)"
	quest.46524E0F4C93EA04.quest_subtitle: "Oritech"
	quest.46524E0F4C93EA04.quest_desc: [
		"钢铁和镍构成了 Oritech 的 &e扳手&r，一种用于拾取和旋转其机器的工具。"
	]
	quest.07C54F02AE0F340F.title: "机器框架"
	quest.07C54F02AE0F340F.quest_subtitle: "Oritech"
	quest.07C54F02AE0F340F.quest_desc: [
		"每台 Oritech 机器都建在 &e机器框架&r上：铁栏杆和镍。一个配方可制作 16 个。"
	]
	quest.3F083109FE2C2B6D.title: "The Pulverizer"
	quest.3F083109FE2C2B6D.quest_subtitle: "Oritech"
	quest.3F083109FE2C2B6D.quest_desc: [
		"&epulverizer&r能将矿石粉碎成可熔炼成额外金属的粉尘，就像Mekanism的破碎机，但速度更快。它需要电机，所以对NeoTrader友好点！"
	]
	quest.0093C4D1AB0BF237.title: "黑色石英"
	quest.0093C4D1AB0BF237.quest_subtitle: "实际上附加的模组 (Actually Additions)"
	quest.0093C4D1AB0BF237.quest_desc: [
		"来自深层的暗晶。实际上，Additions 几乎什么都用它：工具、机器，还有一个叫“赋能者”的非常特别的合成台。这后面很重要。"
	]
	quest.139358A833CF0581.title: "力量管道 (Pipes of Power)"
	quest.139358A833CF0581.quest_subtitle: "Oritech：物品和能量管道"
	quest.139358A833CF0581.quest_desc: [
		"机器需要互相通信。一个&e物品管道&r（一个镍锭和木板）可以将物品从一个机器输送到下一个机器。一个&e能量管道&r（一个电金锭）可以输送电力。"
		""
		"制作8个物品管道和4个能量管道。"
	]
	quest.7B45C3C3E18B785E.title: "一颗小太阳"
	quest.7B45C3C3E18B785E.quest_subtitle: "Oritech：基础发电机"
	quest.7B45C3C3E18B785E.quest_desc: [
		"你的第一个 Oritech 电源。 &e基础发电机&r会燃烧燃料来发电。给它喂煤炭，然后接根电缆出去。"
	]
	quest.5E9FC7B01175067C.title: "耐心的双手"
	quest.5E9FC7B01175067C.quest_subtitle: "Oritech：组装器"
	quest.5E9FC7B01175067C.quest_desc: [
		"有些东西手工合成太麻烦了。 &eAssembler&r 会利用动力和管道，将零件组装起来。"
	]
	quest.3E9EF4BFBCE4A25F.title: "将矿石粉碎成粉末"
	quest.3E9EF4BFBCE4A25F.quest_subtitle: "Oritech：碎片锻造炉"
	quest.3E9EF4BFBCE4A25F.quest_desc: [
		"Pulverizer 能制造粉尘。而 &eFragment Forge&r 能将矿石分解成矿块，冶炼出的金属比普通矿石更多。"
	]
	quest.093538D604192BA8.title: "将其分解开来"
	quest.093538D604192BA8.quest_subtitle: "Oritech：离心机"
	quest.093538D604192BA8.quest_desc: [
		"把东西转得足够快，它的部件就会分离。 &e离心机&r能将混合物和液体分离成其成分。"
	]
	quest.365FB42429C6AE4B.title: "矿石，三倍奉还"
	quest.365FB42429C6AE4B.quest_subtitle: "Mekanism：净化室（The Purification Chamber）"
	quest.365FB42429C6AE4B.quest_desc: [
		"富矿冶炼出的产物比普通矿石多。用氧气在&e净化室&r中处理，还能获得更多。"
	]
	quest.2D7D3738E17006E1.title: "压力"
	quest.2D7D3738E17006E1.quest_subtitle: "Mekanism：锇压缩机"
	quest.2D7D3738E17006E1.quest_desc: [
		"将事物压缩得足够紧密，它们就会变得更致密。 &e锇压缩机&r能将锇、萤石和黑曜石转化为它们的精炼形态。"
	]
	quest.6ECA6FF4DD8C5818.title: "液体物品模组"
	quest.6ECA6FF4DD8C5818.quest_subtitle: "Mekanism：泵和储罐"
	quest.6ECA6FF4DD8C5818.quest_desc: [
		"机器也需要吃喝。一个&e电动泵&r能将水或岩浆从地下抽出，而一个&e流体储罐&r则用来储存它们。"
	]
	quest.5D23055D9E171C3C.title: "更大的口袋模组（A Bigger Pocket）"
	quest.5D23055D9E171C3C.quest_subtitle: "Mekanism：基础储物箱"
	quest.5D23055D9E171C3C.quest_desc: [
		"一个格子，成千上万种物品。一个 &eBin&r 可以存放大量单一物品，供机器取用。"
	]
	quest.3C9A599F6F08AF8D.title: "已生长的锡矿石（Grown Tin）"
	quest.3C9A599F6F08AF8D.quest_subtitle: "Mekanism：电路及其他更多内容"
	quest.3C9A599F6F08AF8D.quest_desc: [
		"锡在地面上也很稀少。种植&e锡种子&r，并收获&e8锡精粹&r。"
	]
	quest.27B8F183BF7493CF.title: "青铜生长液 (Grown Bronze)"
	quest.27B8F183BF7493CF.quest_subtitle: "Mekanism：坚固又便宜"
	quest.27B8F183BF7493CF.quest_desc: [
		"青铜由铜和锡制成，Mekanism 喜欢它。种植 &e青铜种子&r 并收获 &e8 青铜精华&r。"
	]
	quest.7BD8B0BA85C0DE35.title: "火焰碎片"
	quest.7BD8B0BA85C0DE35.quest_subtitle: "下界铭记着力量。让它为你效力。"
	quest.7BD8B0BA85C0DE35.quest_desc: [
		"取用下界所赐，驱动你的创造。锻造&6火焰碎片&r：由钢铁、烈焰与火焰构成的核心。"
		""
		"&e配方：&r中间一个钢制外壳，两侧各4个钢锭，每个角各一个烈焰棒。"
		""
		"&7&oOneblock 变暗并燃烧，但那并非出于愤怒，而是出于使命。&r"
		""
		"&a领取奖励&r以唤醒下一个记忆：远古城市。需要 3000 个破损方块。"
	]
	chapter.1CDBCC8077CB0D93.title: "第六幕：思想之忆"
	chapter.1CDBCC8077CB0D93.chapter_subtitle: [
		"世界必须先被记录，才能被恢复。"
	]
	quest.692895B1CD885149.title: "能够记忆的晶体 (Crystals That Remember)"
	quest.692895B1CD885149.quest_subtitle: "远古城市一片寂静。"
	quest.692895B1CD885149.quest_desc: [
		"&7&o最安静的记忆，往往也是最危险的。潜声从方块蔓延，潜声守卫随之苏醒。&r"
		""
		"古老的建造者在此藏起了最伟大的知识：能记住你所有教导的晶体。收集 &b8 个 certus quartz 晶体&r。"
		""
		"提示：将&e萌生石英&r方块放置在水旁，它会生长出晶簇。打破晶簇可获得水晶，它还会继续生长！"
	]
	quest.3BE8BD8530F2FE73.title: "唤醒水晶"
	quest.3BE8BD8530F2FE73.quest_subtitle: "充电器和曲柄"
	quest.3BE8BD8530F2FE73.quest_desc: [
		"普通的水晶只会记忆。而&e充能&r水晶却能有所作为。&e充电器&r唤醒它们，旁边的&e曲柄&r用手转动就能为其提供动力。"
		""
		"之后，你的第五章动力装置可以帮你完成启动工作。"
	]
	quest.1B117084E288373A.title: "内心的火花"
	quest.1B117084E288373A.quest_subtitle: "带电的切尔图斯石英"
	quest.1B117084E288373A.quest_desc: [
		"将水晶放入充电器并转动摇柄。它们会发光并发出嗡嗡声。制作 &b4 个已充能的 certus quartz 水晶&r。"
	]
	quest.507F81246CF96FC6.title: "Fluix"
	quest.507F81246CF96FC6.quest_subtitle: "奇迹水晶。"
	quest.507F81246CF96FC6.quest_desc: [
		"将充能水晶、少量红石和下界石英投入水中。它们会融合成&dfluix&r，即构成整座图书馆的紫色水晶。"
		""
		"制作 8 个。"
	]
	quest.0BB070BBE2891D85.title: "会思考的沙子"
	quest.0BB070BBE2891D85.quest_subtitle: "硅晶圆"
	quest.0BB070BBE2891D85.quest_desc: [
		"图书馆的小脑由硅制成。将切尔图斯水晶磨成粉，然后用熔炉将其熔炼。"
		""
		"制作8个硅晶圆。"
	]
	quest.4B524F0EFD8093E1.title: "已生长的硅晶圆 (Grown Silicon)"
	quest.4B524F0EFD8093E1.quest_subtitle: "会思考的沙子，从种子开始"
	quest.4B524F0EFD8093E1.quest_desc: [
		"硅是整座图书馆里收集最慢的东西：反复熔炼沙子和 certus，而 Oneblock 只提供少量的沙子。"
		""
		"或者你也可以种植。注入 &e硅种子&r 并收获 &e8 硅精&r，然后将精粹炼制成硅。"
	]
	quest.619FF53F86958EC6.title: "铭文刻写者"
	quest.619FF53F86958EC6.quest_subtitle: "将图案压印到物品上。"
	quest.619FF53F86958EC6.quest_desc: [
		"&e刻印机&r用两台金属&e压板&r，一上一下，将电路图案刻在硅和金属上。它需要电力。"
	]
	quest.6BCF69674818D4CC.title: "压制模具"
	quest.6BCF69674818D4CC.quest_subtitle: "这次没有陨石掉落了。"
	quest.6BCF69674818D4CC.quest_desc: [
		"古老的工匠们留下了你可以自己锻造的模具。将&e8个铁锭&r围成一圈："
		"用于计算器的&6青金石&r，"
		"用于工程压机的&b钻石&r，"
		"用于逻辑压板的&e金&r，"
		"用于硅压机的&7silicon&r。"
		""
		"将四者全部锻造出来。"
	]
	quest.701E4674DCCF0839.title: "小脑瓜们"
	quest.701E4674DCCF0839.quest_subtitle: "逻辑、计算和工程处理器"
	quest.701E4674DCCF0839.quest_desc: [
		"刻写一个压印，然后用硅和正确的材料组合起来：用于逻辑和计算的红石，以及用于工程的钻石。"
		""
		"每种各做2个。图书馆里的每台机器都需要它们。"
	]
	quest.281388118E2D2307.title: "为水晶注入能量"
	quest.281388118E2D2307.quest_subtitle: "图书馆需要电力才能运作。"
	quest.281388118E2D2307.quest_desc: [
		"&e能量接收器&r会从发电机和线缆中获取能量（FE），并将其输送给整个图书馆。添加一个&e能量单元&r来储存部分能量以备后用。"
		""
		"&7&o你在《火焰的记忆》中建造的一切，终于有了用武之地。&r"
	]
	quest.400CF31735EA421B.title: "图书馆开启了"
	quest.400CF31735EA421B.quest_subtitle: "深暗在倾听。"
	quest.400CF31735EA421B.quest_desc: [
		"图书馆有三样东西：存放物品的地方、用来装它们的容器，以及索取它们的方法。"
		""
		"向 Oneblock 展示你的第一个 &edrive&r、用于存放物品的 &e1k storage cell&r，以及用于查看内容的 &eME terminal&r。"
		""
		"&a领取奖励&r以唤醒下一个记忆：深海黑暗。需要 3800 个破碎的方块。"
	]
	quest.5AE0044C783C7980.title: "更大的内存空间"
	quest.5AE0044C783C7980.quest_subtitle: "4k 存储单元"
	quest.5AE0044C783C7980.quest_desc: [
		"一个单元是一个小内存。4k单元可容纳四倍种类的物品。每个单元由一个&e外壳&r（石英玻璃、红石、铁）和一个&e组件&r（处理器和晶体）组成。"
		""
		"制作一个 &e4k 存储单元&r。"
	]
	quest.4C2180B53B1FE236.title: "图书馆的帮手（Hands for the Library）"
	quest.4C2180B53B1FE236.quest_subtitle: "导入、导出和存储总线"
	quest.4C2180B53B1FE236.quest_desc: [
		"无法移动物品的图书馆只是一堆杂物。一个&e进口总线&r将物品从箱子中拉入，一个&e出口总线&r将其推入，而一个&e存储总线&r则让图书馆看到箱子的内容。"
		""
		"每种各制作一个。"
	]
	quest.719946D72D55032D.title: "教导图书馆管理员（Teach the Library）"
	quest.719946D72D55032D.quest_subtitle: "图案"
	quest.719946D72D55032D.quest_desc: [
		"图书馆可以学习配方。一个&e模式提供者&r持有配方并将材料发送到机器。一个&e模式编码终端&r是你编写配方的地方。提示：它由一个&e合成终端&r建造而成。"
		""
		"&7&o教一次，它便永生难忘。&r"
	]
	quest.1240D46FD89ED501.title: "水晶之手 (Hands of Crystal)"
	quest.1240D46FD89ED501.quest_subtitle: "分子组装器"
	quest.1240D46FD89ED501.quest_desc: [
		"&e分子组装器&r会遵循模式自行合成物品。将两个放置于模式提供器和图书馆旁，即可自动合成。"
	]
	quest.62F427853A6EB48D.title: "一个会建造的头脑"
	quest.62F427853A6EB48D.quest_subtitle: "合成中央处理器"
	quest.62F427853A6EB48D.quest_desc: [
		"大工程需要 &e合成CPU&r：一个包含存储块的 &e合成单元&r 来记住步骤。添加一个 &e合成终端&r 来请求物品。"
		""
		"制作4个制造单元、一个1k制造存储器和一个制造终端。"
	]
	quest.5759B8BEECC74B38.title: "图书馆的心脏 (The Heart of the Library)"
	quest.5759B8BEECC74B38.quest_subtitle: "ME控制器"
	quest.5759B8BEECC74B38.quest_desc: [
		"小网络可以没有它，但对于大型图书馆，&e控制器&r是其核心。它需要天石、大量流石和工程处理器。"
		""
		"&7&o天空石：古代建筑师们始终未能找到替代品的唯一物品。&r"
	]
	quest.2F9CB6A92B52C8B4.title: "已成熟的 Certus 石英"
	quest.2F9CB6A92B52C8B4.quest_subtitle: "没有陨石的水晶方块无法放置。"
	quest.2F9CB6A92B52C8B4.quest_desc: [
		"Certus quartz 是图书馆的心脏。没有陨石会掉落它。你需要自己培育它。"
		""
		"注入 &ecertus quartz seeds&r 并收获 &e8 certus quartz essence&r。"
	]
	quest.267DF3D0A01D7C0C.title: "生长的天空之石"
	quest.267DF3D0A01D7C0C.quest_subtitle: "来自不存在天空的石头"
	quest.267DF3D0A01D7C0C.quest_desc: [
		"天空石是旧图书馆的坚硬黑岩，它只会从天空掉落。天空并不帮忙，所以去种植它吧。"
		""
		"注入 &esky stone seeds&r 并收获 &e8 sky stone essence&r。"
	]
	quest.26C1C166D2D25CFD.title: "急躁的晶体 (Impatient Crystals)"
	quest.26C1C166D2D25CFD.quest_subtitle: "生长加速器"
	quest.26C1C166D2D25CFD.quest_desc: [
		"&e生长加速器&r能让萌芽石英更快地长出晶体。它需要能量，并且对神秘作物也有效。"
	]
	quest.6E5EE7A008D6624E.title: "水晶中的力量"
	quest.6E5EE7A008D6624E.quest_subtitle: "Applied Flux"
	quest.6E5EE7A008D6624E.quest_desc: [
		"Applied Flux 让图书馆能以存储物品的方式存储&e能量 (FE)&r。制作一个 FE 存储单元，整个网络就能使用它。"
	]
	quest.25FDF1B8FC964AC2.title: "齿轮为图书馆提供动力"
	quest.25FDF1B8FC964AC2.quest_subtitle: "创建 Applied Kinetics 模组"
	quest.25FDF1B8FC964AC2.quest_desc: [
		"第三幕的创造机器可以为图书馆供电。一个&e能源供应器&r能将旋转的传动轴转化为ME能量。"
	]
	quest.129776F36D6B582F.title: "储存气体"
	quest.129776F36D6B582F.quest_subtitle: "Applied Mekanistics"
	quest.129776F36D6B582F.quest_desc: [
		"图书馆甚至可以存储你Mekanism机器的气体。化学存储单元像物品一样储存它们。"
	]
	quest.3242CD21FDA3E4F9.title: "礼貌地请求"
	quest.3242CD21FDA3E4F9.quest_subtitle: "ME 请求器"
	quest.3242CD21FDA3E4F9.quest_desc: [
		"一个&eME请求器&r会监视一个箱子，并向图书馆请求制作任何缺失的物品。保持库存充足，就永远不会缺货。"
	]
	quest.50499859568B002C.title: "一个奇怪的种子"
	quest.50499859568B002C.quest_subtitle: "ExtendedAE"
	quest.50499859568B002C.quest_desc: [
		"深暗有时会产出&eentro种子&r：一种能让图书馆从未见过的生物生长的黑暗水晶。ExtendedAE的机器就是用它建造的。"
		""
		"&7&o有些回忆，还轮不到你来终结。至少现在不是。&r"
	]
	quest.1D18862D683B19CD.title: "记忆的碎片 (Shard of Memory)"
	quest.1D18862D683B19CD.quest_subtitle: "每种物品各储存一个。"
	quest.1D18862D683B19CD.quest_desc: [
		"世界必须被记录才能被重建。将 Oneblock 所授的一切传授给一个 4k 细胞，它便会成为 &d记忆碎片&r。"
		""
		"&e配方：&r中间放一个4k存储单元，四个角放4个Fluix晶体，上下各放2个工程处理器，左右各放2个逻辑处理器。"
		""
		"&7&oOneblock 安静下来倾听，就像一个人准备说些重要事情时那样。&r"
		""
		"&a领取奖励&r以唤醒最后的记忆：末地。需要5000个破碎的方块。"
	]
	chapter.114A8CA4D0A77461.title: "第七章：末地的记忆"
	chapter.114A8CA4D0A77461.chapter_subtitle: [
		"这从来不只是修复世界，更是在建造一扇门。"
	]
	quest.4BF491984DD813A8.title: "方块的颜色变浅了"
	quest.4BF491984DD813A8.quest_subtitle: "末地石、紫颂果，还有会盯着你然后逃跑的末影人。"
	quest.4BF491984DD813A8.quest_desc: [
		"&7&oOneblock 变得苍白而冰冷。&r"
		""
		"最后的记忆最奇怪。末影人的&5末影珍珠&r是开启下文的钥匙：珍珠会从它们身上掉落，也可以用神秘精华培育。"
		""
		"收集 &e12 个末影珍珠&r。"
	]
	quest.39ABCBCF919DFB6D.title: "渗出紫色光芒的眼睛"
	quest.39ABCBCF919DFB6D.quest_subtitle: "末地之眼"
	quest.39ABCBCF919DFB6D.quest_desc: [
		"将珍珠和烈焰粉混合，你就能得到一颗&e末影之眼&r。它会漂浮着去寻找被创造的目标。"
		""
		"你需要12个来做门，再加4个来做碎片。现在制作&e12&r个。"
	]
	quest.2A68BBD312DDEA5C.title: "一扇门，一块一块地拼凑"
	quest.2A68BBD312DDEA5C.quest_subtitle: "末地传送门框架"
	quest.2A68BBD312DDEA5C.quest_desc: [
		"&7&o十二颗末影之眼，每一颗都裂开并泄漏着紫色的光。守护者将它们一块块地安装到那个方块一直提供的传送门框架上。&r"
		""
		"收集 &e12 个末地传送门框架&r。它们会出现在 Oneblock 里，NeoTrader 有时也会出售。"
	]
	quest.206642D122087060.title: "末地碎片"
	quest.206642D122087060.quest_subtitle: "第六段记忆。"
	quest.206642D122087060.quest_desc: [
		"五个记忆，而第六个最为奇特：关于终结的记忆。用末地生长的东西来合成&e末地碎片&r。"
		""
		"&e配方：&r中间放一个潜贝壳，两侧放一个烤熟的紫颂果，每个角放一个末影之眼。（将紫颂果熔炼即可烤熟。）"
		""
		"为传送门保留12个眼睛：这个碎片还需要4个。"
		""
		"&7&o六个记忆。只剩下窃贼了。&r"
		""
		"&a领取奖励&r。下一章，&e第八幕：吞噬者&r，是你开启大门的地方。"
	]
	chapter.7A8DAB250290285D.title: "第八幕：吞噬者"
	chapter.7A8DAB250290285D.chapter_subtitle: [
		"世界从未被摧毁。它被吞噬了。"
	]
	quest.75071F2452400998.title: "穿越黑暗，抵达彼岸"
	quest.75071F2452400998.quest_subtitle: "一把弓和几支箭"
	quest.75071F2452400998.quest_desc: [
		"龙之水晶位于高高的柱子上。你将从地面射击它们。制作一把&e弓&r和&e64支箭&r。"
		""
		"提示：箭需要燧石、木棍和羽毛。鸡会掉落羽毛！"
	]
	quest.21E0645FE565EC1C.title: "守护者之铠 Armor of the Keeper"
	quest.21E0645FE565EC1C.quest_subtitle: "巨龙正在撕咬。"
	quest.21E0645FE565EC1C.quest_desc: [
		"制作一套完整的&e铁质盔甲&r：头盔、胸甲、护腿和靴子。如果能弄到钻石，钻石更好！"
	]
	quest.7F18B144B3802B1C.title: "黄金的勇气"
	quest.7F18B144B3802B1C.quest_subtitle: "金苹果"
	quest.7F18B144B3802B1C.quest_desc: [
		"用金包裹的苹果比任何东西都能更快地治愈你。出发前，先制作 &e4 个金苹果&r。"
	]
	quest.1E77904349833928.title: "钢铁之翼"
	quest.1E77904349833928.quest_subtitle: "铁质喷气背包"
	quest.1E77904349833928.quest_desc: [
		"末地的岛屿漂浮得十分遥远，柱子也很高。一个&e铁制喷气背包&r能让你飞行，前提是保持充能（FE）。使用第五幕的充能设置！"
	]
	quest.43AB120E1E403807.title: "The Door"
	quest.43AB120E1E403807.quest_subtitle: "穿过这里继续前进。"
	quest.43AB120E1E403807.quest_desc: [
		"&7&oOneblock 从来不只是修复世界，它是在建造一扇门。&r"
		""
		"将12个眼睛放入12个框架中，呈环形排列，传送门便会开启。传送门对面是偷走你世界的窃贼。"
		""
		"穿过这扇门，进入末地。窃贼正在等着你。"
	]
	quest.226058D9C91665D2.title: "末地已经满了"
	quest.226058D9C91665D2.quest_subtitle: "里面完全不是空的，一点都不空。"
	quest.226058D9C91665D2.quest_desc: [
		"&7&o传送门之外，末地并非空无一物。它充满了生机。&r"
		""
		"漂浮在黑暗中的，是巨龙吞噬的一切残影：半融化的山脉、坍塌中凝固的村庄、悬空无岸的河流。"
		""
		"世界从未被摧毁。它被吞噬了，而巨龙自那时起一直在消化它。准备好后请点击勾选框。"
	]
	quest.38EA2A0260EBC0E1.title: "将呼吸装瓶"
	quest.38EA2A0260EBC0E1.quest_subtitle: "一个可以随身携带的魔法。"
	quest.38EA2A0260EBC0E1.quest_desc: [
		"龙之息萦绕在发光的紫色云层中。在云层中手持一个&e玻璃瓶&r，右键即可将其收集。你之后需要一瓶&e龙之息&r来绑定世界种子。"
		""
		"云层燃烧时，请待在云层之外！"
	]
	quest.68C38EDB00572A96.title: "击碎水晶"
	quest.68C38EDB00572A96.quest_subtitle: "这些柱子就是胃袋。"
	quest.68C38EDB00572A96.quest_desc: [
		"黑曜石柱并非末地水晶的牢笼，而是胃囊。每颗水晶都闪耀着被窃取的记忆，只要它们矗立，巨龙就能通过吞噬世界本身来恢复伤势。"
		""
		"用弓箭将它们逐个击落。每击落一个，世界的一部分就会从天空中闪烁消失，被释放回 Oneblock。"
		""
		"当所有水晶都消失后，勾选复选框。"
	]
	quest.471B9EE17591D65B.title: "吞噬者（The Devourer）"
	quest.471B9EE17591D65B.quest_subtitle: "归还被偷走的东西，使其自由。"
	quest.471B9EE17591D65B.quest_desc: [
		"击碎水晶。解放被夺之物。带回心脏。"
		""
		"击败末影龙。"
		""
		"&7&o巨龙最终倒下时，并未燃尽。它像宝石矿一样裂开了。&r"
	]
	quest.1359D355AEDF6448.title: "龙之心脏"
	quest.1359D355AEDF6448.quest_subtitle: "它最后吃的东西，也是唯一无法消化的东西。"
	quest.1359D355AEDF6448.quest_desc: [
		"在贝壳内，微微发光：这就是&d龙之心脏&r。它是世界对自己的记忆，至今仍完整无缺。"
		""
		"向&eThe Devourer&r索取它，带回家，并妥善保管。"
	]
	chapter.1DC309602C655AD5.title: "第九章：世界之种 (The Worldseed)"
	chapter.1DC309602C655AD5.chapter_subtitle: [
		"六个回忆，一颗心。"
	]
	quest.41BA52F61570192E.title: "保持安静"
	quest.41BA52F61570192E.quest_subtitle: "Oneblock 已经没有任何值得回忆的东西了。"
	quest.41BA52F61570192E.quest_desc: [
		"&7&o守护者带着龙之心脏回家，却发现Oneblock第一次陷入了沉默。&r"
		""
		"它已无记忆可留。它所知道的一切，如今都掌握在你手中：六块记忆碎片、一颗心脏，以及沿途建造的每台机器。"
		""
		"现在把它们组合起来。要锻造&aWorldseed&r，你还需要&eSeed's Heart&r：由四样东西组成的核心。点击勾号查看它们。"
	]
	quest.6F78269E9E167576.title: "星辰的力量"
	quest.6F78269E9E167576.quest_subtitle: "反应堆：奥里泰克（Oritech）"
	quest.6F78269E9E167576.quest_desc: [
		"种子需要能量：守护者产生的能量。Oritech 的 &e反应棒&r 内部藏着一颗小星星。"
		""
		"制作一个&eoritech reactor rod&r（一张塑料板和两个 energite 锭）。"
	]
	quest.59F61FE33611A33B.title: "法力，蒸馏版"
	quest.59F61FE33611A33B.quest_subtitle: "灌注：神秘农业（Mystical Agriculture）"
	quest.59F61FE33611A33B.quest_desc: [
		"种子必须注入最强的法力。你需要爬梯子去获取：每个梯级需要&e4个下一级梯级&r和你的注入水晶。"
		""
		"inferium &8>&r prudentium &8>&r tertium &8>&r &9imperium&r &8>&r &6supremium&r &8>&r &dinsanium&r"
		""
		"第一阶：制作 &9imperium essence&r。（总共需要 64 个 inferium essence。生长加速器和收割塔会很有帮助。）"
	]
	quest.466BDA412327E54F.title: "肥沃的土壤"
	quest.466BDA412327E54F.quest_subtitle: "第四级作物：锇和镍"
	quest.466BDA412327E54F.quest_desc: [
		"Imperium essence 开启了第四级作物。Oneblock 最吝啬提供的两种金属现在可以种植了：Mekanism 的 &eosmium&r 和 Oritech 的 &enickel&r。"
		""
		"在祭坛上融合 &e锇种子&r 和 &e镍种子&r。配方请查看 JEI：需要 imperium essence 和金属本身。"
		""
		"你需要 imperium 农田来种植它们。"
	]
	quest.252C52A44090C306.title: "越来越高，越来越高"
	quest.252C52A44090C306.quest_subtitle: "Supremium 精华"
	quest.252C52A44090C306.quest_desc: [
		"四份 imperium 可合成一份 &6supremium essence&r。最后一阶需要 &e4 supremium&r，因此攀登之路十分陡峭：每份需要 256 inferium essence。"
		""
		"&7&o耐心点。Oneblock 已经等待了非常非常长的时间。&r"
	]
	quest.1752CD98B9BB33A3.title: "坚不可摧的水晶"
	quest.1752CD98B9BB33A3.quest_subtitle: "大师级灌注水晶：昂贵，但物有所值。"
	quest.1752CD98B9BB33A3.quest_desc: [
		"你的灌注水晶因长途跋涉而磨损：每次合成都会消耗一点，而它总共只能承受一千次。最后的几级台阶最为耗费。"
		""
		"有更好的选择。 &6大师灌注水晶&r &l永&r久耐用，适用于你未来要做的每一次升级。"
		""
		"&e配方：&r中间放一个至尊宝石，两侧各放4个繁荣碎片，角落各放4个至尊精华。（宝石可以是繁荣宝石和另外2个至尊精华。）"
		""
		"&7&o这可是一大堆至高金。但你只需要制作一次就够了。&r"
	]
	quest.31C24A63F1E9C56A.title: "最后一阶阶梯"
	quest.31C24A63F1E9C56A.quest_subtitle: "Insanium essence (Mystical Agradditions)"
	quest.31C24A63F1E9C56A.quest_desc: [
		"四份至尊精粹环绕着灌注水晶，可合成一份&d灵晶精粹&r：紫色、不可能、最终阶的魔力。一千颗小种子，折叠成一滴精华。"
		""
		"你只需要 &e1&r 个。如果你的水晶快用完了，&6主水晶&r（上面可选的层级）能让你永远不会耗尽。"
	]
	quest.419C1830679434A8.title: "万物图书馆"
	quest.419C1830679434A8.quest_subtitle: "存储：AE2"
	quest.419C1830679434A8.quest_desc: [
		"种子必须记住你建造的一切。老建造师们造过的最大的单元格，一个 &e256k 存储单元&r，可以容纳整个世界的事物。"
		""
		"每个尺寸都建立在下一个尺寸之上：256k组件需要64k组件（外加计算处理器、石英玻璃和天空石粉尘），而64k组件则需要16k组件（外加萤石粉尘）。"
	]
	quest.277E1CF9A9613D27.title: "被呼吸所束缚"
	quest.277E1CF9A9613D27.quest_subtitle: "绑定：巨龙自身的魔法咒语"
	quest.277E1CF9A9613D27.quest_desc: [
		"最后，种子需要一个束缚：一个能将一切凝聚在一起的字。唯有巨龙自身的吐息才足够强大。"
		""
		"展示你收集的&e龙之息&r瓶子。"
	]
	quest.71DA614DA06C0E64.title: "种子的核心"
	quest.71DA614DA06C0E64.quest_subtitle: "力量、法力、记忆，以及一个束缚。"
	quest.71DA614DA06C0E64.quest_desc: [
		"将四者组合起来，制作出&a种子之心&r。"
		""
		"&e配方：&r 合成台左起前两列，顶部一排为反应堆棒和绝缘精粹，底部一排为256k存储单元和龙息。"
	]
	quest.5603FEF77824198B.title: "世界种子（The Worldseed）"
	quest.5603FEF77824198B.quest_subtitle: "六个回忆，一颗心。"
	quest.5603FEF77824198B.quest_desc: [
		"最后的配方。将六个碎片围绕在龙之心脏周围，并用种子之心唤醒它。产物足够小，可以单手握住。"
		""
		"&e配方（任意排列）：&r&d龙之心脏&r、&a种子之心&r，以及六个碎片：&a生长&r、&6运动&r、&b生命&r、&c火焰&r、&d记忆&r和&e末地&r。"
		""
		"&7&o守护者建造的任何东西都不会被遗忘。&r"
	]
	quest.2DF62698D47D8944.title: "种植在一切开始的地方"
	quest.2DF62698D47D8944.quest_subtitle: "最后一次爬上 Oneblock 方块。"
	quest.2DF62698D47D8944.quest_desc: [
		"&7&o守护者最后一次爬上一体方块并将其放置。&r"
		""
		"&6手持世界种子，右键单击Oneblock。&r种子将被消耗。Oneblock会记住岛屿周围的世界原貌：真实的森林、河流、洞穴和矿石，在几分钟内逐渐向四周扩展，越变越大。请靠近并观察它的生长过程。"
		""
		"Oneblock 本身会变成一个普通的草方块。无需理会。"
		""
		"&e警告：&r此操作只能进行一次。你建造的一切都不会被改动：你的岛屿和所有建筑将保持原样，新陆地会围绕它们生长。请确保你已做好准备！"
		""
		"当光线消失时，请点击下方的复选框。"
	]
	quest.2CD2873438B98312.title: "修复与再生"
	quest.2CD2873438B98312.quest_subtitle: "欢迎回家，守护者。"
	quest.2CD2873438B98312.quest_desc: [
		"基岩在岛屿下蔓延。石头向上生长与之相接。河流找到自己的河道，森林在尚漂浮于末地的山丘上展开，村庄也恢复原状，村民们困惑地眨着眼睛。"
		""
		"&7&o天空变蓝了，然后，自创世以来，太阳第一次落下。&r"
		""
		"你建造的一切都不会消失。农场、工厂、法力花园和水晶网络都原封不动地矗立着，如今坐落在一个生机勃勃的世界的坚实土地上。"
		""
		"&a世界并非因你的工作而复原，而是因你的工作才得以复原。&r"
	]
	quest.24EF6B962E18B5E9.title: "残存之物"
	quest.24EF6B962E18B5E9.quest_subtitle: "世界现在记住了自己曾经的样子。"
	quest.24EF6B962E18B5E9.quest_desc: [
		"Oneblock 所在之处，只剩下一块方块，安静而凉爽，不再渴望被打破。"
		""
		"世界恢复了原样：昼夜更替，黑暗中潜伏着苦力怕，洞穴等待着你去发现。你可以像在任何世界一样，自由探索、挖掘、建造和生存。"
		""
		"&7&o但在遥远的地方，新地图的边缘之外，一根柱子上仍有一个无人发现的末地水晶在发光。&r"
		""
		"&6世界现在记住了自己。守护者会确保它再也不会遗忘。&r"
		""
		"&7守护者，由她的家人，用爱所制。&r"
	]
	chapter.1FD8A266340CB306.title: "第十章：被修复的世界"
	chapter.1FD8A266340CB306.chapter_subtitle: [
		"太阳下山了。蜜蜂嗡嗡作响。世界是你的了。"
	]
	quest.3755C775E9C931D9.title: "开放世界模组包任务书"
	quest.3755C775E9C931D9.quest_subtitle: "再也没有什么东西感到饥饿了。"
	quest.3755C775E9C931D9.quest_desc: [
		"&7&o守护者首次有目的地离开了自己的岛屿。&r"
		""
		"世界现在真实存在了：森林、河流、洞穴和矿石，都从旧世界的记忆中复制而来。无需破坏任何东西就能唤醒它。"
		""
		"四处逛逛，看看周围。旧故事里的一切依然在此，还有一些新东西：&e这个世界里存在着Oneblock从未告诉过你的事物。&r"
		""
		"准备好去探险了，就勾选这个框框吧。"
	]
	quest.46077F905CCF0B7C.title: "回家的路在何方？"
	quest.46077F905CCF0B7C.quest_subtitle: "指南针永远记得岛屿的位置。"
	quest.46077F905CCF0B7C.quest_desc: [
		"你现在能走得更远了。一个&e指南针&r指向世界的起点，这样你就能总能找到回岛屿的路。"
		""
		"&e配方：&r 4个铁锭围成一个红色石粉。"
	]
	quest.5C2D0CD82EAC32FF.title: "制图师（Cartographer）"
	quest.5C2D0CD82EAC32FF.quest_subtitle: "把你找到的东西记录下来。"
	quest.5C2D0CD82EAC32FF.quest_desc: [
		"指南针能告诉你家在哪里。而&e地图&r能告诉你其他一切事物的位置。"
		""
		"&e配方：&r 用8张纸围住一个指南针，就能制作一张空白地图。拿着它四处走动，地图就会自动绘制出来。"
		""
		"&7&o旧世界曾被某人记录在案。现在，轮到你了。&r"
	]
	quest.56BB7AB9A2C94BC2.title: "黑雨 (Black Rain)"
	quest.56BB7AB9A2C94BC2.quest_subtitle: "Oritech: 原油"
	quest.56BB7AB9A2C94BC2.quest_desc: [
		"在新大陆的某处，黑色液体正像喷泉一样&e从地里涌出&r。那是&e原油&r，远古森林埋藏极深的残余物，Oritech 知道如何利用它。"
		""
		"油井在&e沙漠&r中更为常见，所以那里是最好的寻找地点。用桶从喷泉中取水。"
		""
		"&e提示：&r桶的形状像V形的3个铁锭。用空桶点击油。泵以后可以抽干整个井。"
		""
		"&7&o漆黑、厚重，散发着古老阳光的低鸣声。&r"
	]
	quest.248CA23A2E584EFB.title: "石油动力"
	quest.248CA23A2E584EFB.quest_subtitle: "Oritech：燃料发电机"
	quest.248CA23A2E584EFB.quest_desc: [
		"那桶黑油不仅仅是摆设。Oritech 的 &e燃料发电机&r 能直接燃烧它，转化为稳定的电力。"
		""
		"用管道或一桶原油喂食，并接出电缆。放置在油井上的泵可以为你的储罐注满油。"
		""
		"&7&o比Oneblock更古老的森林的阳光，再次燃烧。&r"
	]
	quest.4D27C6C316880766.title: "破译黑色暴雨"
	quest.4D27C6C316880766.quest_subtitle: "Oritech：精炼厂"
	quest.4D27C6C316880766.quest_desc: [
		"原油可以燃烧，但最好先将其分解。 &e炼油厂&r 可将原油分离成柴油等轻质燃料和其他有用的液体。"
		""
		"精炼燃料在燃料发电机中的续航时间远长于粗燃料，所以泵旁边建个炼油厂是值得的。"
		""
		"&eIt needs:&r refinery modules to hold the tanks, a motor, steel and a cauldron."
	]
	quest.7256E2D9E2257063.title: "捕捉太阳"
	quest.7256E2D9E2257063.quest_subtitle: "Oritech：太阳能电池板"
	quest.7256E2D9E2257063.quest_desc: [
		"&7&o石油是古老的阳光。而这是崭新的阳光。&r"
		""
		"石油会枯竭，但太阳不会。Oritech 的 &e太阳能电池板&r 是一个 3x3 的 &e多方块结构&r，白天展开可将光能转化为电能。"
		""
		"它需要&e开阔的视野和日光&r，夜间会蜷缩睡觉。结构中更好的&e机器核心&r能使其产量更高。"
		""
		"&e配方：&r一个基础发电机、一个高级电池、纹石和一个纹石门。将其与电池配对，可在天黑后保持机器运行。"
		""
		"&e购物清单：&r铂金、镍、电金和钢。这四种都有&e神秘农业&r作物，所以农场可以供应。 &e纹银&r可以通过研磨铂金或为紫水晶碎片充能获得。"
	]
	quest.17F69A7BEC35E85D.title: "嗡嗡作响的蜂鸟"
	quest.17F69A7BEC35E85D.quest_subtitle: "花丛中有什么东西在嗡嗡作响。"
	quest.17F69A7BEC35E85D.quest_desc: [
		"在花草繁茂的地方，聆听轻微的嗡嗡声。蜜蜂回来了，它们住在挂在树上的&e蜂巢&r里。"
		""
		"找到一个滴着蜂蜜的蜂巢，用&e剪刀&r收集&e蜂巢蜜&r。"
		""
		"&e提示：&r先在巢穴下放置一个&e营火&r。烟雾能让蜜蜂保持平静，这样它们就不会蜇你了。"
		""
		"&e剪刀：&r 2个铁锭，斜放。"
	]
	quest.7C57B22E4521240E.title: "黄金与黏性（Golden and Sticky）"
	quest.7C57B22E4521240E.quest_subtitle: "一瓶蜂蜜。"
	quest.7C57B22E4521240E.quest_desc: [
		"蜂巢已满，蜜蜂安静，将空的&e玻璃瓶&r靠近蜂巢，即可舀取&e蜂蜜&r而非蜂巢。"
		""
		"蜂蜜是一种能治愈中毒的零食，而且非常非常黏。"
	]
	quest.0A0F265870BA699E.title: "属于你自己的蜂巢 (A Hive of Your Own)"
	quest.0A0F265870BA699E.quest_subtitle: "留下来的蜜蜂们。"
	quest.0A0F265870BA699E.quest_desc: [
		"你可以邀请蜜蜂来你身边居住。一个&e蜂巢&r可以容纳蜜蜂，并在你需要时为你提供蜂蜜。"
		""
		"&e配方：&r 6个木板和3个蜂巢。把它放在花附近，等待蜜蜂找到它。"
		""
		"&7&o世界记住了蜜蜂。它们也记住了你。&r"
	]
	quest.48620E01FC879FC3.title: "粘性方块"
	quest.48620E01FC879FC3.quest_subtitle: "四瓶瓶子，一个非常黏的立方体。"
	quest.48620E01FC879FC3.quest_desc: [
		"四个蜂蜜瓶可以合成一个&e蜂蜜块&r。东西会粘在上面，你可以沿着侧面慢慢滑下，非常适合建造滑梯和陷阱。"
	]
	quest.5FD0F19823B0EDA3.title: "原子粉碎机"
	quest.5FD0F19823B0EDA3.quest_subtitle: "实际上附加：原子重构器"
	quest.5FD0F19823B0EDA3.quest_desc: [
		"&7&o有些事物只有在被光照亮时，才能显现出它们的本来面目。&r"
		""
		"&e原子重构器&r会发射一道光束，将击中的任何物体&e转化&r：掉落物品，甚至是方块。它是 Actually Additions 的核心。"
		""
		"需要 &b能量 (FE)&r 和 &c红石脉冲&r 才能发射。在 JEI 中查找它能改变的所有内容。"
		""
		"&e配方：&r一个铁外壳、铁锭和红石粉。"
	]
	quest.0617EABB3609F4EC.title: "红灯亮起"
	quest.0617EABB3609F4EC.quest_subtitle: "雷斯特尼亚水晶"
	quest.0617EABB3609F4EC.quest_desc: [
		"用重构器射出一堆&e红石粉&r（或一块红石块），它就会生长成&c雷斯特尼亚水晶&r：一颗充满能量的深红色宝石。"
		""
		"Restonia 是建造 &ecoils&r、&eenergizers&r 和 Actually Additions 机器的一半所围绕的核心。"
	]
	quest.52BED9A1C6E07FA1.title: "蓝光"
	quest.52BED9A1C6E07FA1.quest_subtitle: "帕利斯水晶"
	quest.52BED9A1C6E07FA1.quest_desc: [
		"同样的方法也适用于&e青金石&r。光束会将其变成&9帕利斯水晶&r。"
		""
		"在 Actually Additions 的物品移动机器的配方中寻找 Palis。"
	]
	quest.0D22E4E661C1EEC9.title: "黑光"
	quest.0D22E4E661C1EEC9.quest_subtitle: "虚空水晶"
	quest.0D22E4E661C1EEC9.quest_desc: [
		"即使是卑微的 &e煤炭&r 也能被改变。用光束击中它，它就会变成一颗 &8虚空水晶&r，像星辰间的黑暗一样。"
		""
		"虚空水晶用于制作&e隐形&r部件，例如能让激光中继器隐身的升级组件。"
		""
		"&7&o旧世界失去的一切，并非都是意外。&r"
	]
	quest.39E1C28943D7AD38.title: "一片金黄色的田野"
	quest.39E1C28943D7AD38.quest_subtitle: "Canola"
	quest.39E1C28943D7AD38.quest_desc: [
		"在田野里，有一种开着亮黄色花朵的高大植物：&e油菜&r。它由&e油菜籽&r种植而成，你可以通过筛土或市场购买，像小麦一样种植。"
		""
		"收集一堆。它不是食物，而是&e燃料&r。"
	]
	quest.110CC22D7B2654E6.title: "挤压"
	quest.110CC22D7B2654E6.quest_subtitle: "油菜籽压榨机"
	quest.110CC22D7B2654E6.quest_desc: [
		"将油菜籽放入&eCanola Press&r，为其提供动力，它就会榨出&eoil&r。"
		""
		"报社需要一个&e高级线圈&r和一个&eEnori水晶&r（一个重建的&e铁块&r），所以重建者功不可没。"
	]
	quest.1E5C7D980A8F4B60.title: "让它保持原样"
	quest.1E5C7D980A8F4B60.quest_subtitle: "发酵桶 (The Fermenting Barrel)"
	quest.1E5C7D980A8F4B60.quest_desc: [
		"普通的菜籽油不易燃烧。将其倒入&e发酵桶&r中等待：它会变成&e精炼的&r菜籽油。"
		""
		"&7&o好事成双，燃料亦是如此。&r"
	]
	quest.2080638CE2E59DD4.title: "绿色石油"
	quest.2080638CE2E59DD4.quest_subtitle: "石油发电机"
	quest.2080638CE2E59DD4.quest_desc: [
		"种子、花、压榨机、桶：现在终于派上用场了。 &e油发电机&r燃烧精炼菜籽油，提供稳定的电力。"
		""
		"将油从桶中导入，并拉一根电缆出来。与油井不同，一片黄花的油田永远不会枯竭。"
	]
	quest.7074C3059526A743.title: "火焰与黏土"
	quest.7074C3059526A743.quest_subtitle: "Productive Metalworks: 耐火砖"
	quest.7074C3059526A743.quest_desc: [
		"&7&o更旺的火需要更好的炉子。&r"
		""
		"大型锻造炉由&e耐火砖&r建造。将沙子和黏土混合成&e耐火黏土&r，然后在熔炉中冶炼。"
	]
	quest.265F992D8683DAC3.title: "铸造厂"
	quest.265F992D8683DAC3.quest_subtitle: "一个多区块锻造炉"
	quest.265F992D8683DAC3.quest_desc: [
		"这可是个大工程。一个&e铸造炉&r是一个由耐火砖块建造的空心盒子，墙上有一个&e铸造控制器&r。炉内，金属会熔化成液体。"
		""
		"添加一个 &eFoundry Tank&r 以便观察内部，和一个 &eLiquid Heating Coil&r 来提供热量。"
		""
		"&e控制器：&r一个高炉和耐火砖。"
		"&e线圈：&r一个桶、一个铜锭和一个耐火砖。"
		""
		"&7熔炉块的任意染色颜色都适用。&r"
	]
	quest.2CD50042ADB79103.title: "将之倾出"
	quest.2CD50042ADB79103.quest_subtitle: "酿造台和铸造台"
	quest.2CD50042ADB79103.quest_desc: [
		"熔融金属不能一直待在熔炉里。熔炉侧面的&e熔炉龙头&r可以将其倒入&e铸造台&r制作物品，或倒入&e铸造盆&r制作方块。"
		""
		"在熔炉中熔炼两种金属即可&e合金&r：铜和锡制成青铜，铁和熔化的煤炭制成钢。"
	]
	quest.4F17C344F10E184E.title: "锭的模具 A Mould for Ingots"
	quest.4F17C344F10E184E.quest_subtitle: "投掷一次鱼竿"
	quest.4F17C344F10E184E.quest_desc: [
		"要浇筑锭子，你需要一个容器来盛放&e它&r：&eIngot Cast&r。它不会被消耗，所以你只需要制作一个。"
		""
		"将任意&e锭&r放在铸造台上，然后浇上&e熔钢&r。锭会被消耗掉，你就能得到铸件。"
		""
		"&e钢：&r在熔炉中熔炼铁和煤炭，然后将两者混合成合金。"
	]
	quest.742DA9865B151574.title: "Pale Gold"
	quest.742DA9865B151574.quest_subtitle: "合金并铸造电金（Electrum）"
	quest.742DA9865B151574.quest_desc: [
		"&7&o单独很好，熔合在一起会更好。&r"
		""
		"将&e金&r和&e红石&r一起放入熔炉，它们会熔合为&e熔融的电解金&r。将其倒入你的锭模中，即可制作出&e电解金锭&r。"
		""
		"熔炉能合金的金属远不止这些，所以电金只是众多金属中的第一种。"
	]
	quest.1FF8116C6BA53457.title: "守护者世界 (The Keeper's World)"
	quest.1FF8116C6BA53457.quest_subtitle: "现在它是你的了。"
	quest.1FF8116C6BA53457.quest_desc: [
		"你有一张地图，一桶古老而黑色的东西，还有一些决定留下来的蜜蜂。"
		""
		"没有更多任务需要完成，也没有更多方块需要破坏。世界不会消失。在其中建造，在其中耕作，在其中迷失，并在日落时分回家。"
		""
		"&7&oOneblock 在沉睡，世界在苏醒。&r"
		""
		"&6谢谢你记得这件事，守护者。&r"
	]
	reward_table.0A240E2E6AF05FC3.title: "记忆的种子"
}
