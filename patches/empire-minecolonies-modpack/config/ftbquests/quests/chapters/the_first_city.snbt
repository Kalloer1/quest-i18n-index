				type: "item"
				title: "第二座城市的建造许可费"
				item: "shop_blocks:coin_diamond"
			}]
			rewards: [{
				id: "00000000000000D5"
				type: "item"
				item: {
					id: "minecraft:written_book"
					Count: 1b
					tag: {
						pages: [
							"{\"text\":\"My loyal count! I have heard great news of your citys expansion. Ive heard great things about your tavern, I may have to visit myself! Alas, youve proven yourself to be a competant and loyal subject, and as such, Im hereby granting you the rank of Duke. \"}"
							"{\"text\":\"Now being a Duke, you have access to found a 2nd city, and have control of the areas surrounding both your cities. You might want to consider a good way of transportation between your two cities. \"}"
							"{\"text\":\"Also, since you have 1 city making resources for you already, Ive seen it go really well for those who build their 2nd city into their new capitol. Make your 2nd city the large powerhouse, that will allow you to start spreading your cities our more and expanding your duchy.\"}"
						]
						title: "公爵头衔"
						author: "TheCloudsOfSteel"
					}
				}
			}]
		}
