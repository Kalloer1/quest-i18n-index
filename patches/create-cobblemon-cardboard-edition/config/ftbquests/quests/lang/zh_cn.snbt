	]
	quest.07598631B7E193EC.quest_desc: [
		"弓箭训练场是训练弓箭手成为正式弓箭手的地方。"
		""
		"这样它们就能在没有被怪物杀死的风险下升级了。"
		""
		"新招募的弓箭手学徒需要在房子里有床才能生成。一旦在弓箭手协会被雇佣，那里就会成为他们的新住所，房子里的床将空出来给另一位新市民（儿童或新兵）。"
	]
	quest.07D593E7084C8833.quest_subtitle: "远古遗迹"
	quest.08DB2EC742AC02AD.quest_desc: ["更复杂机器的重要合成材料。"]
	quest.094920830D05234C.quest_desc: [
