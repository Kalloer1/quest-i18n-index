	quest.10E3615A3C082EC1.quest_desc: ["&n&5黄铜&r&r是一种通过机械混合器、盆和烈焰燃烧器混合铜和锌获得的合金。主要用于制作物品分拣机。"]
	quest.10FCEAD504BDDCA2.quest_desc: [
