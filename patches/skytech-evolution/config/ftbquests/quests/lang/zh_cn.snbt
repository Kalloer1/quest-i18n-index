# AI 初翻，未人工校对
{
	file.0000000000000001.title: "SkyTech 进化版"
	chapter_group.4E06BB3DD10B837B.title: "主线任务系列"
	chapter_group.3E3B6463983F18FB.title: "科技与自动化"
	chapter_group.33401D44ADADF4FC.title: "魔法与替代方案"
	chapter_group.293B0513F4340751.title: "维度与终局内容（Dimensions and Endgame）"
	chapter_group.50524F4A45435453.title: "项目和挑战"
	chapter_group.7777C0FFEE000001.title: "可选、支持及收集癖向内容"
	chapter.097C000000000000.title: "欢迎来到天空世界 (Welcome to the Sky)"
	chapter.097C000000000000.subtitle: "仅引言；奖励始于实际行动"
	chapter.097C000000000001.title: "最初的根源"
	chapter.097C000000000001.subtitle: "在扩大规模前，先让初始树木可再生"
	chapter.097C000000000002.title: "活体资源"
	chapter.097C000000000002.subtitle: "资源树奖励真实的收集步骤"
	chapter.097C00000000002A.title: "众神支持路线 Ex Deorum Support Route"
	chapter.097C00000000002A.subtitle: "需要堆肥和流体，筛分和锤击为可选步骤"
	chapter.097C000000000003.title: "存储与物流系统"
	chapter.097C000000000003.subtitle: "先抽屉，再控制器和线路，最后是红石"
	chapter.097C000000000004.title: "创建工厂"
	chapter.097C000000000004.subtitle: "奖励来自完成生产线组装而获得"
	chapter.097C000000000005.title: "电力与机械模组整合包任务书"
	chapter.097C000000000005.subtitle: "稳定的FE、真实的机器和可选的自动化建筑工具"
	chapter.097C000000000006.title: "生长与实用功能"
	chapter.097C000000000006.subtitle: "生长、蜜蜂、作物和魔法现已指向其虚空引导路线"
	chapter.097C000000000008.title: "工业基础模组 (Industrial Foundations)"
	chapter.097C000000000008.subtitle: "工业机械链前需先说明有锁桥梁材料"
	chapter.097C000000000009.title: "数字存储系统"
	chapter.097C000000000009.subtitle: "RS保持简单；AE2是可选的，并且现在会命名其虚空桥梁"
	chapter.097C00000000000A.title: "生物数据和维度信息"
	chapter.097C00000000000A.subtitle: "生物数据说明了首次接触、矩阵和受控掉落"
	chapter.097C00000000000B.title: "最终自动化系统"
	chapter.097C00000000000B.subtitle: "连接系统，而不是手动囤积物品"
	chapter.097C00000000000C.title: "建筑和便利性优化 (Building and QoL)"
	chapter.097C00000000000C.subtitle: "更舒适的游玩体验，安全与建造工具"
	chapter.097C00000000000D.title: "收集癖玩家"
	chapter.097C00000000000D.subtitle: "主路线确定后再进行后期目标审查"
	chapter.097C000000000014.title: "天空货币商店"
	chapter.097C000000000014.subtitle: "可重复的支持包；选择有用的，不要全部购买"
	quest.1796D04D4033877C.title: "早期恢复组合包"
	quest.1796D04D4033877C.quest_desc: ["恢复按钮，不是主路线。如果第一个岛屿", "出错了，而你希望继续玩下去而不是重新开始。"]
	quest.7E8BB6C4F5B06834.title: "存储支持整合包"
	quest.7E8BB6C4F5B06834.quest_desc: ["适用于已达到Storage和Redstone Tree阶段的基地的紧凑型整理套件。", "管道路线是未锁定系统的辅助，而非绕过果园进程的捷径。"]
	quest.30604E2BE9954595.title: "创建支持包"
	quest.30604E2BE9954595.quest_desc: ["Create 实验中已解锁的原始再填充物。", "这应该能让你继续建造，而不是跳过创造章节。"]
	quest.3BE6B4FF1A014F7F.title: "强力支持组合包"
	quest.3BE6B4FF1A014F7F.quest_desc: ["一套强大的调试工具包。当电缆测试变得无聊时，就买它吧，", "不要把它作为红石或能源部件的主要来源。"]
	quest.57917F71279F34B5.title: "果园支持捆绑包"
	quest.57917F71279F34B5.quest_desc: ["果园扩建的生长支持套件。有助于树木恢复", "并为后期资源扩展提供一个蜜蜂笼，无需替换", "树木循环。"]
	quest.1D17E788C3069687.title: "工业支持整合包"
	quest.1D17E788C3069687.quest_desc: ["一个已经开始运行的工厂的小型工业补充包。", "塑料和电路减少了重复，但机器仍然需要", "可以通过章节来获得相应的奖励。"]
	quest.6F20B503F79727C8.title: "网络支持整合包"
	quest.6F20B503F79727C8.quest_desc: ["首个数字存储错误的网络补充。它能提供帮助", "处理器绑定和石英富集铁，无需购买一整", "系统。"]
	quest.5F751E77EB522DEE.title: "后期游戏评测代币"
	quest.5F751E77EB522DEE.quest_desc: ["中后期庆祝性购买。这不是早期进度内容；", "这是达到稀有掉落点后的奖励，此时稀有掉落已经", "在控制之中。"]
	chapter.097C0000000000F0.title: "主要路线路线图"
	chapter.097C0000000000F0.subtitle: "仅读路线概览；实际工作发生在章节中"
	quest.1130000000000001.title: "如何阅读路线说明"
	quest.1130000000000003.title: "01 - 第一根根须"
	quest.1130000000000003.quest_desc: ["让第一棵树可再生。原木给树脂，树叶给", "纤维和树苗，而钩爪能提升树叶的收集效率。"]
	quest.1130000000000005.title: "02 - 活体核心"
	quest.1130000000000005.quest_desc: ["将初始循环转化为活体天空根核心。这证明了", "在扩大规模前，你可以纠正错误。"]
	quest.1130000000000007.title: "03 - 果园材料"
	quest.1130000000000007.quest_desc: ["资源树是本整合包的特色：树脂来自原木，橡子", "树叶，成对的树叶会变成材料。"]
	quest.1130000000000009.title: "04 - 储物墙"
	quest.1130000000000009.quest_desc: ["在增加更多产出前，先整理重复的产出。这是", "主路线的 step 04，在 Create、power 和 industry 之前。"]
	quest.113000000000000B.title: "05 - 创建线条"
	quest.113000000000000B.quest_desc: ["在存储系统可读取后，建造一条可见的处理线。运动，", "在获得动力前，应先了解压制、研磨和清洗。"]
	quest.113000000000000D.title: "06 - 力量"
	quest.113000000000000D.quest_desc: ["先创建旋转，再创建FE。从一个开始", "发电机、一条电缆路线和一台动力机器。"]
	quest.113000000000000F.title: "07 - 工业"
	quest.113000000000000F.quest_desc: ["使用稳定的电力进行真正的处理：富集、电路、", "钢铁、塑料和机器框架。"]
	quest.1130000000000011.title: "08 - 数字存储"
	quest.1130000000000011.quest_desc: ["仅在批量存储可用后添加小型网络。数字版", "储物空间是用来存取和制作的，不是垃圾场。"]
	quest.1130000000000013.title: "09 - 生物数据"
	quest.1130000000000013.quest_desc: ["将普通生物掉落物转化为可控生产。HNN 减少了", "在获得首次真实掉落物后，重复进行研磨。"]
	quest.1130000000000015.title: "10 - 下界与末地"
	quest.1130000000000015.quest_desc: ["烈焰人、恶魂、凋零和末地材料保持里程碑。自动化", "稍后再处理它们；不要跳过第一次遭遇。"]
	quest.1130000000000017.title: "11 - 最终自动化"
	quest.1130000000000017.quest_desc: ["将主要系统整合起来。最终测试将检验", "自动化和路线规划，而非手动囤积。"]
	quest.1130000000000019.title: "欢迎来到 SkyTech Evolution"
	quest.113000000000001B.title: "使用路线图 The Roadmap"
	quest.113000000000001D.title: "主线任务 教学系统"
	quest.113000000000001F.title: "支线路线是工具"
	quest.113000000000001F.quest_desc: ["支线路线是工具。当它们能帮助你的岛屿时，就使用它们，", "但不要把所有可选分支都当成家庭作业来做。", "Factory Contracts 和 Playthrough Projects 现已移至可选的 Projects and Challenges 分组中。"]
	quest.1130000000000021.title: "奖励应是助力，而非跳过障碍"
	quest.1130000000000023.title: "开启第一根根须 The First Root"
	quest.1130000000000023.quest_desc: ["你的第一项正经工作很简单：让树木可再生，保护", "树苗，并将随机掉落物转化为稳定的资源循环。"]
	quest.1130000000000027.title: "一份泥土，一份根茎"
	quest.1130000000000029.title: "原木提供树脂"
	quest.113000000000002C.title: "树叶提供纤维"
	quest.113000000000002E.title: "树叶窃贼 Crook The Leaves"
	quest.113000000000002E.quest_desc: ["想要更好地收集树叶时，请使用钩爪。它并不是", "剪刀而不是斧头；它是 Skyblock 的树叶工具。", "如果掉落物令人困惑，请比较开启和关闭此功能时的树叶产出。"]
	quest.1130000000000030.title: "先备份树苗 First"
	quest.1130000000000030.quest_desc: ["在将第一棵树的产物用于更高级的制造前，先确保有一个备用树苗。", "适合新手的 Skyblock 开局，应能容错一次而不必强制重开。"]
	quest.1130000000000033.title: "活体堆肥器"
	quest.1130000000000033.quest_desc: ["将 Skyroot 纤维和树脂混合成活性堆肥。", "不要直接合成泥土：下一个任务会教你可再生的桶制作方法。"]
	quest.1130000000000035.title: "稳定这片新土壤"
	quest.1130000000000035.quest_desc: ["使用 Skyroot 桶中多余的泥土来制作 Rootbound 土壤。", "Rootbound Soil 是泥土、砾石、沙子和黏土树的精确 Tier-2 基础。"]
	quest.1130000000000037.title: "准备活性土壤"
	quest.1130000000000037.quest_desc: ["Living Soil 解锁了 Tier-3 果园：煤炭、铜和铁。", "所有果园土壤共享相同的盆景掉落物计数；土壤仅决定可种植的等级。", "第一批金属树苗在路线后期仍需要基础与金属果园核心。"]
	quest.1130000000000039.title: "将你的第二块泥土堆肥"
	quest.1130000000000039.quest_desc: ["用 Skyroot Planks 和 Slab 制作 Skyroot Barrel。", "放入八片 Skyroot Leaves 或树苗：每片增加 125 mB，八片可合成一个泥土。", "保留树下原岛屿的泥土。仅在木桶产出第二块泥土后勾选。"]
	quest.113000000000003E.title: "金属属于果园的一部分"
	quest.113000000000003E.quest_desc: ["不要从与沙子相同的初始配方中手动筛选铜或铁。", "先唤醒活体核心；果园将成为真正的金属来源。"]
	quest.1130000000000041.title: "唤醒活体核心"
	quest.1130000000000041.quest_desc: ["活体天空树核心开启了资源树路线。", "铜和铁会故意等到自己的树木建立起来才行动。"]
	quest.1130000000000044.title: "果园开启了"
	quest.1130000000000048.title: "准备好迎接资源树了吗"
	quest.1130000000000048.quest_desc: ["你已达到资源树可以成为一个重要来源的阶段", "真实系统。小抽屉样本是储物提示，并非", "Storage 章节的替代内容。"]
	quest.113000000000004A.title: "资源树规则"
	quest.113000000000004C.title: "开始泥土果园之旅"
	quest.113000000000004C.quest_desc: ["木桶创造了首个可再生泥土；泥土树将其转化为可扩展的生产。", "用 1 个泥土树脂处理 2 个泥土橡子。旧的四个橡子和堆肥制泥土的快捷方式已被移除。"]
	quest.113000000000004E.title: "泥土橡子 + 泥土树脂"
	quest.113000000000004E.quest_desc: ["从树上采集泥土橡果和泥土树脂。", "一个匹配的树脂加两个橡子，是泥土的唯一明确果园配方。"]
	quest.1130000000000051.title: "砾石与沙砾果园"
	quest.1130000000000051.quest_desc: ["先解锁砾石，再解锁沙子。用对应的树脂和两颗橡子分别处理。", "另一个有效途径是 Ex Deorum：将圆石锤成砾石，再将砾石变成沙子。"]
	quest.1130000000000054.title: "粘土果园"
	quest.1130000000000054.quest_desc: ["Clay 完成了 Tier-2 实用果园的建设。", "使用粘土树脂加两个橡子制作粘土球，或在桶中将 Ex Deorum 粉尘与 1000 mB 水混合。", "骨头粉奖励有助于为流体路线制作瓷土；任务奖励中不提供泥土、砾石、沙子或黏土。"]
	quest.1130000000000057.title: "煤炭树，用作燃料"
	quest.1130000000000057.quest_desc: ["煤炭是第一个金属果园树木，为铜提供粘合剂。", "在尝试制作铜树之前先建造好它。"]
	quest.1130000000000059.title: "先种植铜矿 (Grow Copper First)"
	quest.1130000000000059.quest_desc: ["铜矿的生成始于由煤炭果园产出的铜树。", "在继续前往铁之前，先收集铜橡果和铜树脂。"]
	quest.113000000000005C.title: "种植铁并加工第一批金属"
	quest.113000000000005F.title: "基础果园核心模组"
	quest.113000000000005F.quest_desc: ["水、熔岩、鹅卵石、熔炉和第一个盆景盆现在都应该可用了。", "陶罐被绑定到这个核心中，作为任务奖励返还，这样真正的果园就可以在不丢失陶罐的情况下开始了。"]
	quest.1130000000000061.title: "金属果园核心"
	quest.1130000000000061.quest_desc: ["此核心可解锁煤炭、铜和铁的序列。", "它本身不提供金属；实际的资源仍然需要长在树上才能获得。"]
	quest.1130000000000065.title: "缩放前进行排序"
	quest.1130000000000067.title: "Ex Deorum 的适配情况"
	quest.1130000000000067.quest_desc: ["SkyTech 选择性地使用 Ex Deorum，而不是把整合包变成一个无尽的刷刷乐。", "桶式堆肥和两种坩埚都是主流程的一部分。筛分和锤击是可选的辅助方法。"]
	quest.1130000000000069.title: "用筛子筛出鹅卵石所需的泥土"
	quest.1130000000000069.quest_desc: ["使用整合包自带的 Skyroot 木材来制作 Skyroot 筛子。", "A String Mesh can sift renewable Barrel or Orchard Dirt for Stone Pebbles and useful seeds.", "这是一条辅助路线，不是早期获取铜或铁的来源。"]
	quest.113000000000006B.title: "将字符串拟合为网格模型"
	quest.113000000000006B.quest_desc: ["将 Skyroot Fiber 制成 String，然后合成 String Mesh。", "该任务不提供免费的沙子、黏土或燧石：需从实际的 Ex Deorum 工艺中收集产物。"]
	quest.113000000000006D.title: "锤打材料链 Hammer The Material Chain"
	quest.113000000000006D.quest_desc: ["使用木制锤子完成原生的 Ex Deorum 连锁：原矿 → 砾石 → 沙子 → 粉尘。", "果园仍然是可扩展的主要来源，而锤击则是一个干净的备份和转换工具。"]
	quest.113000000000006F.title: "尘土与水化为黏土"
	quest.113000000000006F.quest_desc: ["用1000 mB水装满桶，并加入一个Ex Deorum Dust来制作一个黏土块。", "与桶装泥土和锤击砾石/沙子一起，这是除果园外获取四种基本地面材料的唯一来源。"]
	quest.1130000000000072.title: "存储优先于扩展"
	quest.1130000000000074.title: "每个批量输出对应一个抽屉"
	quest.1130000000000074.quest_desc: ["为原木、树脂、橡子、痕迹和基础方块分配各自的专属位置。", "Skyroot Planks 可以制作此任务所需的橡木抽屉产物，因此无需绕道获取橡木树苗或筛子。"]
	quest.1130000000000076.title: "红石信号后集中控制"
	quest.1130000000000078.title: "使用一个可见的缓冲区 (Use A Visible Buffer)"
	quest.1130000000000078.quest_desc: ["在管道和机器之前，先给物品一个可见的停靠点。", "箱子或桶缓冲区能让早期路线调试更简单，还能防止物品消失的问题。"]
	quest.113000000000007A.title: "先移动第一条水流"
	quest.113000000000007A.quest_desc: ["红石控制器建成后，在搭建完整物流网络前，先移动一个物品流。", "将盆景或机器输出物导入已准备好的抽屉墙，并确认每件物品都到达正确位置。"]
	quest.113000000000007C.title: "溢出是一种护栏机制"
	quest.113000000000007C.quest_desc: ["垃圾和虚空升级是安全工具，不是捷径。", "仅在抽屉锁定且溢出机制已理解后方可使用。"]
	quest.113000000000007E.title: "干净地收集树木掉落物"
	quest.113000000000007E.quest_desc: ["手动拾取变得麻烦时，收集器会很有用。瞄准", "把它放在缓冲器里，你明白我的意思吧。"]
	quest.1130000000000080.title: "物流核心"
	quest.1130000000000080.quest_desc: ["干净的储物墙是提升效率的升级。一旦掉落停止", "到处蔓延，基地似乎已为机器做好了准备。"]
	quest.1130000000000084.title: "准备好迎接创造模式了吗"
	quest.1130000000000084.quest_desc: ["抽屉墙和可见缓冲区就足以开始创造模式了。", "控制器、管道和高级物流仍为独立分支", "在机械路线到达红石树后开启的接口。"]
	quest.1130000000000086.title: "开始创建小型结构"
	quest.1130000000000088.title: "安山岩合金批次"
	quest.1130000000000088.quest_desc: ["先做一小批，然后看看 Create 如何重复利用材料", "步骤。这应该是自动化的开端，而不是又一次手动的折磨。"]
	quest.113000000000008A.title: "Shafts And Cogwheels"
	quest.113000000000008A.quest_desc: ["转轴传递旋转；齿轮改变方向。保持第一个", "设置简单且易于到达。"]
	quest.113000000000008D.title: "首次稳定旋转"
	quest.113000000000008D.quest_desc: ["水车能提供稳定的动力。把它放在你还能", "查看并修复为其供电的机器。"]
	quest.113000000000008F.title: "Depot And Press"
	quest.113000000000008F.quest_desc: ["仓库和压路机只是工作站而已。", "下一步是证明你确实能压制金属板", "带有旋转和真实输入物品的配方。"]
	quest.1130000000000092.title: "压制铁板"
	quest.1130000000000092.quest_desc: ["铁板证明了首个加工升级。稍后这个", "应该就能自动完成了。"]
	quest.1130000000000094.title: "磨石加工"
	quest.1130000000000094.quest_desc: ["磨石是你的第一个实用加工单元。用它来", "在大机器之前将基础材料转化为更干净的路线。"]
	quest.1130000000000096.title: "风扇清洗任务书文本"
	quest.1130000000000096.quest_desc: ["风扇处理应该有可见的输入和输出。如果线路", "易于观看，这样以后自动化起来会更容易。"]
	quest.1130000000000098.title: "传送带和漏斗（Belts And Funnels）"
	quest.1130000000000098.quest_desc: ["传送带显示物品流动。仅在知道物品去向时添加漏斗", "应该进入和离开。"]
	quest.113000000000009B.title: "机械天空树核心"
	quest.113000000000009B.quest_desc: ["从这里开始，创造模式会开始回报你。奖励会给出", "用于实验的工具和零件，因为下一个有趣的步骤是", "建造一条无需手动喂食的移动生产线。"]
	quest.113000000000009F.title: "准备好迎接力量了吗"
	quest.113000000000009F.quest_desc: ["你的第一条创造线路可以接入动力。", "电缆样本是布线提示，不是成品电源", "网络。"]
	quest.11300000000000A1.title: "旋转并非飞行（Rotation Is Not FE）"
	quest.11300000000000A3.title: "一个入门发电机"
	quest.11300000000000A3.quest_desc: ["在考虑建造储能室之前，先建造一个电源。", "目标很简单：产生FE，连接它，并证明一台机器可以运行。"]
	quest.11300000000000A5.title: "电缆一号机"
	quest.11300000000000A5.quest_desc: ["电缆只能传输能量，无法构成稳定的网络。", "制作并放置你自己的缓冲器，这样就不会有电力问题了", "更容易调试。"]
	quest.11300000000000A7.title: "小型电池缓冲器"
	quest.11300000000000A7.quest_desc: ["电池能告诉你问题出在生成、存储、传输还是机器需求上。", "在添加更多发电机前使用它。之后，Uraninite 可以用 Uranium 和 Energized Core 建造 Skyroot/Powah 桥梁，但初始能源还是保持简单为好。", "缓冲区满了，生成就正常。机器一直是空的，检查电缆和输入/输出设置。"]
	quest.11300000000000A9.title: "冶金学注入器"
	quest.11300000000000A9.quest_desc: ["融合器是第一部正式的驱动机器。学习它的", "在添加机器行之前，先放置能量侧、物品输入和额外输入。"]
	quest.11300000000000AB.title: "基础控制电路"
	quest.11300000000000AB.quest_desc: ["电路是连接电力与工业的桥梁。铺设路线", "重复使用，而不是制作一个奇迹电路。"]
	quest.11300000000000AD.title: "能量药片检查"
	quest.11300000000000AD.quest_desc: ["便携式缓冲器能让您在工厂扩建前就掌握电力。", "用它来测试问题是出在生成、电缆布线还是机器本身。"]
	quest.11300000000000AF.title: "充满活力的天空树核心"
	quest.11300000000000AF.quest_desc: ["这是 Skyroot 路线的力量里程碑。", "仅在旋转、FE、电缆布线和小型动力机器合理后再制作。", "之后，Powah Uraninite 和更强大的能量部件就可以使用有锁配方，而不再依赖缺失的矿石世界生成。"]
	quest.11300000000000B3.title: "工业时代已就绪"
	quest.11300000000000B3.quest_desc: ["电力已足够稳定，可以开始工业化了。", "你仍然需要通过 Industrial Foregoing 来制造塑料；", "这个交接点现在只会指向下一台机器。"]
	quest.11300000000000B5.title: "成长是加速，而非绕道而行"
	quest.11300000000000B7.title: "Living Soil Tier"
	quest.11300000000000B7.quest_desc: ["Living Soil 解锁第 3 级：煤炭、铜和铁。", "盆景设置在 Living Resources 中引入；此任务确认了下一个确切的土壤等级。", "更肥沃的土壤不会取代它，也不会增加额外的战利品掉落。"]
	quest.11300000000000B9.title: "机械土壤"
	quest.11300000000000B9.quest_desc: ["机械土壤解锁第4级：红石、黄金、青金石、石英和锌。", "它不会增加盆景的掉落物，也不能替代低阶土壤。"]
	quest.11300000000000BB.title: "Productive Bees 简介"
	quest.11300000000000BB.quest_desc: ["蜜蜂是一个可升级的路线，而不是早期替代果园的选择。", "在虚空世界中，第一个蜂箱可以使用 Skyroot 蜂蜜桥：蜂巢、蜂蜜瓶和 Skyroot 材料可引导出高效蜜蜂，无需主世界的随机生成。", "仅在存储能处理蜂巢后再使用笼子；离心机将路线转化为生产。"]
	quest.11300000000000BD.title: "离心机"
	quest.11300000000000BD.quest_desc: ["只有经过加工，梳子才会变得有用。", "离心机证明了蜜蜂的产出有真实的输入、输出和存储目的地。", "保持第一个蜜蜂循环小：笼子、食物、蜂巢、离心机，然后是抽屉或桶输出。"]
	quest.11300000000000BF.title: "Prosperity + Inferium 启动"
	quest.11300000000000BF.quest_desc: ["Mystical Agriculture 通常依赖矿石和主世界资源，但这个整合包始于虚空。", "使用 Skyroot 的初始配方：用机械土、紫水晶、石英、红石和树脂制作繁荣；再用活堆肥、小麦种子、骨粉、红石和树脂制作 Inferium。", "这只是第一步。一旦种子、蜜蜂或自动化系统开始运行，就让它们自行扩展资源，而不是永远手动制作。"]
	quest.11300000000000C1.title: "Inferium 种子"
	quest.11300000000000C1.quest_desc: ["Inferium 种子是你作物规模化种植的第一步。", "在 Prosperity 和 Inferium 启动器之后制作它们，然后只种一小块地，直到存储能处理精粹产出为止。", "Prosperity Shards 对种子基地和后期资源种子又变得重要了，所以保持少量储备。"]
	quest.11300000000000C3.title: "有机处理器"
	quest.11300000000000C3.quest_desc: ["生长系统是一种轻松的扩展方式。蜜蜂、作物和", "树木自动化应该减少手工劳动，而不是变成第二份工作。"]
	quest.11300000000000C7.title: "成长路线交接仪式"
	quest.11300000000000C7.quest_desc: ["成长系统只是辅助途径，而非主要途径的替代品", "工厂。用蜜蜂、作物和魔法来扩大你已有的资源", "从树木和机器中理解知识。"]
	quest.11300000000000C9.title: "魔法是工具，不是家庭作业"
	quest.11300000000000C9.quest_desc: ["当魔法能解决实际问题时，它便很有用：实用功能、资源管理、替代资源或自动化支持。", "当前的虚空路线为 Ars 和 Occultism 提供了干净的入门材料，所以你开始时无需依赖主世界的矿石运气。", "从小处着手，当魔法分支停止解决明显瓶颈时，就返回工厂。"]
	quest.11300000000000CB.title: "新手魔法书"
	quest.11300000000000CB.quest_desc: ["魔法书开启了实用功能。保持最初的目标简单：照明、移动、采集帮助和源处理。", "源宝石现在可以通过秘术处理器、紫水晶、青金石和树脂连接到天空根桥梁，JEI 应该会显示一条虚空安全的入口路线。", "在小型源装置成功运作前，不要建造大型法术工坊。"]
	quest.11300000000000CD.title: "源 Jar 文件"
	quest.11300000000000CD.quest_desc: ["源是 Ars 的动力系统。在尝试构建复杂的法术装置前，请先储存好源。", "在世界生成时，使用源宝石和源石桥梁的配方。", "一个好的初始设置很简单：一个罐子，一种填充方式，和一个你懂的实用配方。"]
	quest.11300000000000CF.title: "附魔室 (Imbuement Chamber)"
	quest.11300000000000CF.quest_desc: ["灌注室是魔法路线的第一个明确制作台。", "在 Source Gems 和 Sourcestone 可获取后再使用，不要作为随机的副业。", "这样 Ars 就能作为一个有用的支持系统，而不是又一个隐藏的进度障碍。"]
	quest.11300000000000D1.title: "Occultism 指南"
	quest.11300000000000D1.quest_desc: ["当您需要仪式效用、更智能的存储技巧或替代资源路径时，Occultism 会很有用。", "曼陀罗草种子、其他石头和灵性材料现在有了天根/奥数桥梁路线，这样在虚空中的首个仪式路径就可行通了。", "阅读指南，制作一个仪式装置，然后决定是否用 Occultism 来解决你当前的工厂问题。"]
	quest.11300000000000D3.title: "第一仪式工具包 First Ritual Tools"
	quest.11300000000000D3.quest_desc: ["在使用灵魂作为生产捷径之前，先建造碗和宝石路线。", "如果仪式物品需要主世界石头或植物，请在JEI中查找为Datura、Otherstone和Spirit-attuned晶体添加的Skyroot桥梁配方。", "一个能用的仪式就足以作为入门证明了，不要把它变成仪式刷屏。"]
	quest.11300000000000D6.title: "神秘处理器 (Arcane Processor)"
	quest.11300000000000D6.quest_desc: ["该处理器标志着魔法路线已连接到最终打包系统，而不仅仅是一个小玩具。", "它也是多个虚空安全魔法桥梁的入口，包括源宝石、曼陀罗花和其他石。", "当魔法成为你实际基地的有效支持时，再使用它。"]
	quest.11300000000000DA.title: "工业始于投入品 (Industry Starts With Inputs)"
	quest.11300000000000DC.title: "富集室"
	quest.11300000000000DC.quest_desc: ["富集室是你的第一台安静的工业机器。", "清晰地为其供电，并将输出送回可见的存储中。"]
	quest.11300000000000DE.title: "破碎机与熔炼炉"
	quest.11300000000000DE.quest_desc: ["Crusher 和 Energized Smelter 是第一排小型机器。", "保持足够简单，以便你能解释每个输入和输出。"]
	quest.11300000000000E1.title: "钢铁步伐"
	quest.11300000000000E1.quest_desc: ["钢铁证明了红石、铁、碳和电力正成为一条道路。", "不要把它当作一次性的幸运合成，要确保材料可以重复使用。"]
	quest.11300000000000E3.title: "乳胶和塑料"
	quest.11300000000000E3.quest_desc: ["塑料是工业前置的里程碑。在尝试各处使用塑料前，先证明乳胶路线可行。", "工业大麻种子现在可以通过 Skyroot 生态桥制作，植物产业不再依赖主世界草地的运气。", "在循环感觉可靠之前，保持乳胶、水、动力和存储可见。"]
	quest.11300000000000E7.title: "机器框架"
	quest.11300000000000E7.quest_desc: ["第一帧应该像基础设施，而不是一个随机的昂贵合成物。", "如果塑料、电路和能源可以重复利用，未来的机器就会变得可行，而不是痛苦。"]
	quest.11300000000000E9.title: "工业处理器"
	quest.11300000000000E9.quest_desc: ["这证明了动力处理、塑料和机器框架是其中的一部分", "属于同一个系统的一部分。"]
	quest.11300000000000EB.title: "工业天空树核心"
	quest.11300000000000EB.quest_desc: ["这里是真正的工厂检查点：机器、钢铁、塑料和", "现在要齐心协力了。奖励能帮助你成长，但它并不", "不要替换下一章的内容。"]
	quest.11300000000000EF.title: "工业物品移交至网络"
	quest.11300000000000EF.quest_desc: ["工业已生产出足够的结构，可以开始数字存储。", "这里用一根小线缆/材料来推动是没问题的，因为实际的", "网络仍然需要制作、能量、纪律和存储规则。"]
	quest.11300000000000F1.title: "数字存储需要纪律性"
	quest.11300000000000F3.title: "石英富集铁"
	quest.11300000000000F3.quest_desc: ["此材料开启了 Refined Storage 路线。在石英和铁足够可再生以消耗时制作。", "如果硅石感觉隐藏了，JEI 应该显示由石英、煤炭和树脂制成的 Skyroot 安全配方。", "先不要将所有抽屉接入网络；仅在理解输出流程后再连接干净的批量存储。"]
	quest.11300000000000F5.title: "处理器绑定 Processor Binding"
	quest.11300000000000F5.quest_desc: ["处理器绑定是第一个网络合成材料。准备好一个小型配方路线。", "重点不是加速自动合成，而是让网络建成后重复的处理器不再那么烦人。", "如果配方链不清楚，请从硅和石英富铁矿的 JEI 用途中查找。"]
	quest.11300000000000F7.title: "控制器和网格"
	quest.11300000000000F7.quest_desc: ["控制器和网格是数字存储的前门。", "将它们放置在能清楚看到电源、电缆和接口的地方。"]
	quest.11300000000000FA.title: "磁盘驱动器和小磁盘"
	quest.11300000000000FA.quest_desc: ["从小磁盘开始。过早使用大型存储会掩盖分类问题", "解决问题，而不是制造更多问题。"]
	quest.11300000000000FD.title: "合成网格"
	quest.11300000000000FD.quest_desc: ["合成网格是第一个舒适性升级。自动合成即将推出", "稍后；访问权限优先。"]
	quest.11300000000000FF.title: "网络矩阵"
	quest.11300000000000FF.quest_desc: ["这个矩阵证明了网络与 Skyroot 路线相连，而不是", "直接贴到基座上就行了。"]
	quest.1130000000000101.title: "网络化的天空之根核心"
	quest.1130000000000101.quest_desc: ["网络能节省时间又不隐藏混乱，这样才有趣。", "将大量物品存放在抽屉中，并使用数字存储进行访问，", "合成和干净的自动化系统。"]
	quest.1130000000000105.title: "网络数据移交至生物数据"
	quest.1130000000000105.quest_desc: ["你的网络现在可以支持受控的实体数据工作了。", "使用空白模型作为初始提示，然后建造", "而不是依赖通用贵重物品来正确运行模拟循环。"]
	quest.1130000000000107.title: "生物掉落物应受到控制"
	quest.1130000000000109.title: "安全生物房间"
	quest.1130000000000109.quest_desc: ["在HNN之前建造或准备好一个安全的普通掉落物来源。首先", "自动化之前先考虑接触方式。"]
	quest.113000000000010D.title: "空白数据模型"
	quest.113000000000010D.quest_desc: ["空白模型是可控掉落的基础。训练简单的生物", "在追逐稀有生物之前先完成这些。"]
	quest.113000000000010F.title: "模拟室"
	quest.113000000000010F.quest_desc: ["模拟室将训练数据转化为可重复的工作。", "追求稀有掉落前，先做简单的模型。"]
	quest.1130000000000111.title: "预测矩阵"
	quest.1130000000000111.quest_desc: ["预测也是一种资源。像其他工厂产出一样进行缓冲。", "如果消耗品矩阵本身成为阻塞物，请使用粘土、玻璃、金和铁，使用网络处理器桥配方。", "模拟循环运行后，桥梁应是备用支持，而非主要玩法。"]
	quest.1130000000000113.title: "战利品生成器"
	quest.1130000000000113.quest_desc: ["合成器能将预测转化为实际掉落。在理解源生物路线后再使用。", "一个好的初始实验室，在尝试取代下界或末地里程碑之前，会先制造一些无聊的普通掉落物。", "将矩阵和模型输出保存在可见的存储中，以便实验室易于调试。"]
	quest.1130000000000115.title: "末影珍珠与末影之眼"
	quest.1130000000000115.quest_desc: ["末地材料将基地与各个维度连接起来。它们应该被", "通过努力获得的，而不是提前赠送的自动化产物。"]
	quest.1130000000000118.title: "下界抗性增强"
	quest.1130000000000118.quest_desc: ["第一步进入下界应该是一个里程碑，而不是捷径。", "先完成一次路线，然后用生物数据和自动化来减少重复材料的麻烦。"]
	quest.113000000000011B.title: "凋零召唤器设置"
	quest.113000000000011B.quest_desc: ["凋零骷髅头和下界之星是后期的里程碑。不要", "让奖励快捷方式将它们擦除。"]
	quest.113000000000011D.title: "稀有掉落矩阵"
	quest.113000000000011D.quest_desc: ["稀有掉落矩阵已经是重要的里程碑了。", "相关的HNN支持保留，但通用的钻石填充物已移除。"]
	quest.1130000000000121.title: "Celestial Skyroot Core"
	quest.1130000000000121.quest_desc: ["当 Nether、End 和稀有掉落路线可以支持时，制作此物品", "最终的自动化流程。"]
	quest.1130000000000123.title: "将生物数据移交至最终自动化系统"
	quest.1130000000000123.quest_desc: ["生物数据和维度路由现已进入最后阶段。", "稀有掉落矩阵证明了这一点；钻石不再是", "用作填充物放在这里。"]
	quest.1130000000000125.title: "Finale 是一项系统测试"
	quest.1130000000000127.title: "最终有机证明"
	quest.1130000000000127.quest_desc: ["有机证明意味着生长的资源仍能滋养最终章。", "确保树木、作物或蜜蜂能可靠地重复此路线。"]
	quest.1130000000000129.title: "最终机械证明"
	quest.1130000000000129.quest_desc: ["机械化的证明意味着 Create 不再是一个附属工坊。", "它的处理过程应该能有意地驱动最后的链条。"]
	quest.113000000000012B.title: "最终工业证明"
	quest.113000000000012B.quest_desc: ["工业级防护意味着钢铁、塑料、电路和框架都", "足以支持最终组装的重复性程度。"]
	quest.113000000000012D.title: "最终奥术证明"
	quest.113000000000012D.quest_desc: ["Arcane proof 意味着魔法在辅助、实用或", "成为独立分支，而是作为资源工作进行。"]
	quest.113000000000012F.title: "最终网络验证"
	quest.113000000000012F.quest_desc: ["网络证明意味着存储和自动合成有助于最终阶段", "而不是把损坏的输入藏在巨大的物品栏后面。"]
	quest.1130000000000131.title: "最终的天界证明"
	quest.1130000000000131.quest_desc: ["Celestial proof 意味着稀有掉落和维度材料有更高的", "受控路线。痛苦的掉落将不再完全取决于运气。"]
	quest.1130000000000133.title: "Skyroot 奇点"
	quest.1130000000000133.quest_desc: ["奇点将主要路线压缩为一个证明的", "自动化。"]
	quest.1130000000000135.title: "进化矩阵"
	quest.1130000000000135.quest_desc: ["进化矩阵是一个后期路线的证明，而不是一个宝箱。", "硬币是庆典；钻石原矿填充物不再是", "需要。"]
	quest.1130000000000137.title: "最终催化剂"
	quest.1130000000000137.quest_desc: ["催化剂会启动最后的合成。仅在基地可以时才这样做", "替换你所消耗的材料。"]
	quest.1130000000000139.title: "进化核心"
	quest.1130000000000139.quest_desc: ["进化核心是主要的终点线。它应该让人感觉像", "是互联系统的成果，而非昂贵的单次手工合成。"]
	quest.113000000000013D.title: "可选的便利性支持跑步功能"
	quest.113000000000013D.quest_desc: ["QoL 任务能让游戏体验更顺畅。它们很有用，但是", "他们不应该感到有必要去完成主路线。"]
	quest.113000000000013F.title: "背包或额外储物空间 (Backpack or Extra Storage)"
	quest.113000000000013F.quest_desc: ["携带容量有助于搭建，但不能取代分类整理", "基础部分。"]
	quest.1130000000000141.title: "墓碑安全机制"
	quest.1130000000000141.quest_desc: ["死亡恢复应减少挫败感，而非消除对...的需求", "安全的平台。"]
	quest.1130000000000143.title: "垃圾桶格位感知系统"
	quest.1130000000000143.quest_desc: ["知道哪些可以安全删除时，清理工具会很有用。不要", "无法确定哪些物品是模组物品。"]
	quest.1130000000000145.title: "照明与生物安全"
	quest.1130000000000145.quest_desc: ["基地扩建时使用照明工具。安全很重要，但是它", "不需要十个独立的主线任务。"]
	quest.1130000000000147.title: "建造是可选的"
	quest.1130000000000147.quest_desc: ["在访问路径、存储和机器可读后再进行装饰。", "美观的基地，实用才是硬道理。"]
	quest.1130000000000149.title: "QoL 交接任务"
	quest.1130000000000149.quest_desc: ["可选的QoL优化能让整合包更完善，但它不应该", "成为货币路径。交接仅用于识别目的。"]
	quest.113000000000014C.title: "收集狂正在寻找路线中"
	quest.113000000000014C.quest_desc: ["收集者目标稍后查看。完成主路线", "先完成，等需要额外证明和润色时再回来。"]
	quest.113000000000014E.title: "完成开放主分支的任务"
	quest.113000000000014E.quest_desc: ["完成所有主要分支，真有种集齐控的成就感。", "金币是后期可选的奖励，不属于正常流程的一部分", "路线经济。"]
	quest.1130000000000150.title: "创造精通"
	quest.1130000000000150.quest_desc: ["将 Create 生产线自动化到足够完善，使其在故障后能干净重启", "停止。"]
	quest.1130000000000152.title: "力量精通"
	quest.1130000000000152.quest_desc: ["建造一个能应对普通机器需求的稳定电源缓冲器。"]
	quest.1130000000000154.title: "网络精通"
	quest.1130000000000154.quest_desc: ["使用网络访问和合成，无需放弃批量操作", "用于高吞吐量输出的抽屉。"]
	quest.1130000000000156.title: "稀有掉落精通"
	quest.1130000000000156.quest_desc: ["正常获得后，至少自动化一个稀有掉落路线。"]
	quest.1130000000000158.title: "收集者成就回顾"
	quest.1130000000000158.quest_desc: ["如果主路线已完成且基地感觉稳固，可选的", "目标可以扩展整合包，而不会使初次游玩体验变得冗长。"]
	quest.1180000000000001.title: "打开两份指南"
	quest.1180000000000001.quest_desc: ["保持任务书打开以查看路线，指南书放在附近以查看系统说明。", "这不是作业，而是在配方或机制不熟悉时的安全网。"]
	quest.1180000000000002.title: "保持树脂缓冲器"
	quest.1180000000000002.quest_desc: ["不要立即用完所有树脂。少量缓冲能确保早期恢复配方可用。", "八块树脂足以证明原木正在发挥作用。"]
	quest.1180000000000003.title: "保持一个叶子缓冲区"
	quest.1180000000000003.quest_desc: ["树叶是树木循环中的纤维、树苗和橡子部分。", "在把整棵树变成配方之前，先收集一小部分。"]
	quest.1180000000000004.title: "基础树木三人组"
	quest.1180000000000004.quest_desc: ["泥土、砾石和沙子是你将不断接触到的三种树木。", "在扩展到其他资源之前，先获取他们的橡果和树脂。"]
	quest.1180000000000005.title: "基础树脂三件套"
	quest.1180000000000005.quest_desc: ["匹配的树脂能将散落的橡子变成可靠的物资来源。", "将树脂和橡子并排存放在一起。"]
	quest.1180000000000006.title: "机器之前的燃料"
	quest.1180000000000006.quest_desc: ["煤炭树并不显眼，但它们能让冶炼、制作火把和早期机器变得更轻松。", "少量的燃料缓冲可以防止后续章节停滞不前。"]
	quest.1180000000000007.title: "金属树木成对"
	quest.1180000000000007.quest_desc: ["铜和铁是真正推动整合包发展的第一批资源。", "目标并非无限锭，而是一条稳定的路线。"]
	quest.1180000000000008.title: "锁住重要的抽屉 Lock The Important Drawers"
	quest.1180000000000008.quest_desc: ["当空抽屉忘记里面该放什么时，抽屉墙就会变得很烦人。", "橡子与树脂的布局合理后，锁上重要的抽屉。"]
	quest.1180000000000009.title: "修剪连接墙壁"
	quest.1180000000000009.quest_desc: ["修剪方块有助于控制器读取更多抽屉壁，而无需将每个抽屉都做成完美的方块。", "直接用 Skyroot Planks 制作 Oak Trim；此方法无需草籽、苔藓或随机的原版橡木运气。"]
	quest.118000000000000A.title: "虚空唯有溢出者方可踏入"
	quest.118000000000000A.quest_desc: ["虚空升级和垃圾桶是安全工具，不是你的主要输出。", "只有在有用的抽屉和缓冲器都已正常工作后，再使用它们。"]
	quest.118000000000000B.title: "仅升级填充物部分的内容"
	quest.118000000000000B.quest_desc: ["不要为了升级而升级每一个抽屉。", "先填满哪个就先把升级放在原木、树脂、橡子和痕迹上。"]
	quest.118000000000000C.title: "安山岩外壳"
	quest.118000000000000C.quest_desc: ["外壳是创造模组从单纯传动轴转变为机器的关键所在。", "在规划整条生产线之前，先制作几个样品。"]
	quest.118000000000000D.title: "重建前使用扳手"
	quest.118000000000000D.quest_desc: ["一把扳手省下的时间比它本身更值钱。", "在手动拆除一行方块前使用它。"]
	quest.118000000000000E.title: "Basin And Mixer 预览"
	quest.118000000000000E.quest_desc: ["搅拌机和盆只是 Create 更多合成内容的预览，还不足以成为重建基地的理由。", "现在就学习方块，这样配方才不会突然感到陌生。"]
	quest.118000000000000F.title: "过滤器的第一个输出"
	quest.118000000000000F.quest_desc: ["过滤一个出口总比事后清理五个错误的箱子要好。", "物品开始脱离你的手移动时，使用过滤器一次。"]
	quest.1180000000000010.title: "FE 电缆备份"
	quest.1180000000000010.quest_desc: ["一旦开始测试各种电路和缓冲器，一根线缆永远不够用。", "多备几根备用电缆，以免故障中断运行。"]
	quest.1180000000000011.title: "红石控制缓冲器"
	quest.1180000000000011.quest_desc: ["了解机器何时运行，管理起来会更容易。", "小型红石缓冲器有助于配方控制和后期自动化。"]
	quest.1180000000000012.title: "通用线缆检查器 (Universal Cable Check)"
	quest.1180000000000012.quest_desc: ["Mekanism 线缆是你电力网络的工业部分。", "在电缆遍布整个基地之前，先跑一小段路。"]
	quest.1180000000000013.title: "充满活力的土壤"
	quest.1180000000000013.quest_desc: ["活力土壤可解锁五级工业金属果园。", "其用途是精确获取特定等级，而非额外的盆景战利品。"]
	quest.1180000000000014.title: "工业机械后的工业土壤"
	quest.1180000000000014.quest_desc: ["工业土壤是仅用于铂金的精确的七级土壤。", "它应该在动力处理之后，并且不会增加树木的掉落物表。"]
	quest.1180000000000015.title: "首个资源作物种植任务"
	quest.1180000000000015.quest_desc: ["神秘农业是后期发展的路径，而非学习树的替代品。", "从小处着手，等存储系统能处理产出后再进行自动化。"]
	quest.1180000000000016.title: "源宝石缓冲器"
	quest.1180000000000016.quest_desc: ["当你有一个小型源宝石缓冲器后，魔法就会开始发挥作用。", "Arcane Processor 的配方存在，这样在虚空里无需寻找矿石就能获得 Source Gems。", "将此视为工厂的辅助设施，而非第二条主线。"]
	quest.1180000000000017.title: "钢制缓冲器"
	quest.1180000000000017.quest_desc: ["钢是你将重复使用的第一种工业材料。", "手工制造每个机器框架前，先制作一个小型缓冲器。"]
	quest.1180000000000018.title: "塑料缓冲器"
	quest.1180000000000018.quest_desc: ["塑料是工业先行者模组的首个真正瓶颈。", "先铺一小块缓冲层，可以验证乳胶线是否正常工作，然后再进行建造。"]
	quest.1180000000000019.title: "种植自动化预览"
	quest.1180000000000019.quest_desc: ["当你的存储和电力稳定后，种植机就会很有用。", "不要把它们作为首要的工业化目标；用它们来扩展已经行之有效的部分。"]
	quest.118000000000001A.title: "溶解室预览"
	quest.118000000000001A.quest_desc: ["一些后期的配方需要比工作台更受控的加工方式。", "重点不在于复杂性，而在于可重复的工厂逻辑。"]
	quest.118000000000001B.title: "基础网络电缆"
	quest.118000000000001B.quest_desc: ["电缆是决定网络可读性的无聊部分。", "保持第一个网络足够小，以便理解。"]
	quest.118000000000001C.title: "外部存储警告"
	quest.118000000000001C.quest_desc: ["外部存储很强大，因为它能将抽屉连接到网络。", "请谨慎使用：目标是获得有序的批量存储空间，而不是把杂乱的箱子墙藏在终端里。"]
	quest.118000000000001D.title: "进口商和出口商"
	quest.118000000000001D.quest_desc: ["导入和导出器是网络自动化的第一步。", "在尝试完全自动化合成前，请先使用每种各一个。"]
	quest.118000000000001E.title: "先不要把所有东西都存起来"
	quest.118000000000001E.quest_desc: ["该网络用于主动合成和访问权限。", "原木、树脂和橡子仍应存放在抽屉中，直到自动合成需要它们为止。"]
	quest.118000000000001F.title: "通用模型集"
	quest.118000000000001F.quest_desc: ["先打普通生物，再追求稀有掉落物。", "几个简单的模型就能教会循环，而不会打断下界或末地的进度。"]
	quest.1180000000000020.title: "Fabricate 通用掉落物"
	quest.1180000000000020.quest_desc: ["制造机应首先替换无聊的怪物等待：骨头、线和火药。", "稀有掉落物会一直锁定在它们真正的里程碑之后。"]
	quest.1180000000000021.title: "传送门材料检查中"
	quest.1180000000000021.quest_desc: ["进入下界前，请确保你能补充损失并安全返回。", "只有基地能支持这次旅行，黑曜石才算是一个里程碑。"]
	quest.1180000000000022.title: "末地城市并非早期生成"
	quest.1180000000000022.quest_desc: ["末影人壳和紫颂果应该在末地路线建立后再获取。", "这样能让后期存储和最终自动化目标变得有意义。"]
	quest.1180000000000023.title: "自动合成证明"
	quest.1180000000000023.quest_desc: ["自动合成证明你的路线已准备好重复执行。", "先从一个简单的配方开始，再让网络来处理", "多步骤处理器或最终组件。"]
	quest.1180000000000024.title: "稀有掉落证明"
	quest.1180000000000024.quest_desc: ["下界之星已经足以证明稀有掉落路线规划是", "在控制中。奖励在没有添加另一个的情况下仍然有用", "普通的钻石。"]
	quest.1180000000000025.title: "终章前的工厂审查"
	quest.1180000000000025.quest_desc: ["在最终决战前，先运行一次你的工厂：输入、动力、缓冲器，", "垃圾安全、网络模式和稀有掉落。立即修复薄弱环节", "而不是在最后的合成步骤中完成。"]
	quest.1180000000000026.title: "按键绑定与搜索"
	quest.1180000000000026.quest_desc: ["QoL 模组只有在你知道如何使用时才有用。", "如果感觉有什么被隐藏了，尽早检查控制装置。"]
	quest.1180000000000027.title: "安全的建筑材料"
	quest.1180000000000027.quest_desc: ["可选建筑并非推进所必需，但安全平台能避免愚蠢的损失。", "装饰前请先使用简单的方块。"]
	quest.1180000000000028.title: "果园完成度审查"
	quest.1180000000000028.quest_desc: ["收集癖玩法首先要确认资源树系统是否稳定。", "在主路线之后做这个，不要在主路线之前做。"]
	quest.1180000000000029.title: "储物完成度审查"
	quest.1180000000000029.quest_desc: ["一个收集狂的基地，即使在资源充足时也应该清晰易读。", "如果这里的存储很乱，最终的自动化体验会比想象中更糟。"]
	quest.1190000000000001.title: "用于重复部署的装置"
	quest.1190000000000001.quest_desc: ["Deployer 是创造模式开始为你重复工作，而不仅仅是移动物品的地方。", "你暂时不需要一个巨大的工厂。一个有用的重复操作就足够了。"]
	quest.1190000000000002.title: "精密机械预览"
	quest.1190000000000002.quest_desc: ["精密机械是后期的一项创造技能检定。", "目前请将其视为预览：先部署小型生产线，再组装大型序列。"]
	quest.1190000000000003.title: "Mekanism 处理对"
	quest.1190000000000003.quest_desc: ["富集室教你更好的输入。破碎机或能量熔炉教你，动力机器已成为你的材料升级途径。", "这样电力系统就不只是电缆和电池了。"]
	quest.1190000000000004.title: "能量细胞缓冲器"
	quest.1190000000000004.quest_desc: ["直接为机器供电的发电机也行，但小型储能单元能让基地更容易排查故障。", "缓冲器并不刺激。但它们能让工厂保持稳定。"]
	quest.1190000000000005.title: "蜜蜂处理循环"
	quest.1190000000000005.quest_desc: ["蜜蜂应该支持果园，而不是过早地取代它。", "蜂箱和离心机证明了蜜蜂路径可以成为一个受控的资源循环。"]
	quest.1190000000000006.title: "精华农场启动器"
	quest.1190000000000006.quest_desc: ["Mystical Agriculture 是另一种可扩展的路线。当你的农场需要持续供应特定资源，又不想无限扩建时，它非常实用。", "从小处着手，只自动化你真正需要的部分。"]
	quest.1190000000000007.title: "源启动器配对"
	quest.1190000000000007.quest_desc: ["当源可以被储存和重复使用时，Ars 才开始变得有用。", "源宝石、源石和法师花现在都有虚空安全桥，所以从天空根路线应该能到达初始点。", "先把它当成一个实用系统，而不是第二个主线任务。"]
	quest.1190000000000008.title: "Occultism 入门组合包"
	quest.1190000000000008.quest_desc: ["Occultism 旨在提供实用功能和替代进度，而非用仪式淹没主路线。", "Datura、Otherstone 和 spirit-attuned 材料现在有桥梁配方，这样虚空玩家可以有意地开始分支。", "指南和第一个仪式碗足以证明你能遵循这个支线系统。"]
	quest.1190000000000009.title: "乳胶加工链"
	quest.1190000000000009.quest_desc: ["先建造乳胶机，然后在里面证明产出", "塑料任务。商店和奖励以后会有用，但是", "第一个塑料应该来自你的装置。"]
	quest.119000000000000A.title: "自动化种植机组合包"
	quest.119000000000000A.quest_desc: ["种植自动化是关于农场循环，而不是免费塑料。", "在你的工业基地建成后，用它来使可再生能源更清洁", "已经存在了。"]
	quest.119000000000000B.title: "溶解室工作台"
	quest.119000000000000B.quest_desc: ["溶解室是一个带有流体和输入的工业合成台。", "你的工厂已经超越了简单的配方，这是一个好兆头。"]
	quest.119000000000000C.title: "驱动器、磁盘和网格"
	quest.119000000000000C.quest_desc: ["数字存储包含三个独立概念：控制器为网络供电，驱动器存放磁盘，而网格则是你与它交互的方式。", "保持这些角色分离，故障排查会容易得多。"]
	quest.119000000000000D.title: "终章前的制作者"
	quest.119000000000000D.quest_desc: ["在最终路线要求重复部件之前，先尝试一个简单的自动合成设置。", "从无聊和安全的内容开始；网络应该去除重复，而不是跳过学习。"]
	quest.119000000000000E.title: "携带深海学习者 Carry The Deep Learner"
	quest.119000000000000E.quest_desc: ["The Deep Learner 是 Hostile Neural Networks 中面向玩家的部分。", "训练模型时带上它，这样后期的模拟才感觉是努力得来的，而非随机。"]
	quest.119000000000000F.title: "第一次模拟循环"
	quest.119000000000000F.quest_desc: ["纯净的稀有掉落循环很简单：训练模型，运行模拟，然后制造你需要的掉落物。", "这就是如何将生物养殖变成一条受控的生产线。"]
	quest.1A12000000000001.title: "树木循环动量"
	quest.1A12000000000001.quest_desc: ["从第一个循环中收集一个小型缓冲器。这是第一刻", "让岛屿充满生机，而不是显得脆弱不堪。", "奖励：足以让你继续建造而不是半途而废的支持。"]
	quest.1A12000000000002.title: "第一座果园围墙"
	quest.1A12000000000002.quest_desc: ["不要只解锁树木，还要给它们一个奔跑的空间。", "一个小抽屉墙能处理第一批材料，而不会让你过早获得后面的 Pipez 网络。"]
	quest.1A12000000000003.title: "不再有箱怪（No More Chest Monster）"
	quest.1A12000000000003.quest_desc: ["这是一个真正的基地里程碑：批量产出有了归属，管道开始运转", "水流顺畅，溢流处设有护栏。", "从这里开始，添加机器应该充满乐趣，而不是杂乱无章。"]
	quest.1A12000000000004.title: "一条会自己移动的线"
	quest.1A12000000000004.quest_desc: ["建造一条能真正移动物品的传送带。它不需要是", "挺不错的，但它需要证明创造模式正在变成一个工厂，", "又不是又一个合成配方清单。"]
	quest.1A12000000000005.title: "一台能持续运转的机器"
	quest.1A12000000000005.quest_desc: ["当机器不再闪烁关闭时，电力就变得有趣了。", "证明你有生成器、线缆和缓冲器，然后推入", "更顺畅的工业化加工体验。"]
	quest.1A12000000000006.title: "你的第一个缩放引擎"
	quest.1A12000000000006.quest_desc: ["选择一个生长系统并使其发挥作用。蜜蜂、作物和源头是", "不是作业；它们能让工厂感觉不那么死板，更有活力。"]
	quest.1A12000000000007.title: "工厂层级在线"
	quest.1A12000000000007.quest_desc: ["从这里开始，这座岛屿逐渐有了工业化的感觉。", "你拥有机器、能源和塑料。下一个奖励支持规模化生产，", "不是捷径。"]
	quest.1A12000000000008.title: "有目的的联机网络"
	quest.1A12000000000008.quest_desc: ["数字存储应该让工厂更易于使用，而不是掩盖一团糟。", "在将其改为自动合成前，先建造一个小型完整网络。"]
	quest.1A12000000000009.title: "数据正在等待替换中"
	quest.1A12000000000009.quest_desc: ["mob-data 循环在供电和布线后会取代等待状态。", "奖励现在支持循环，无需添加额外的钻石", "value."]
	quest.1A1200000000000A.title: "工厂想要一个完美的结局"
	quest.1A1200000000000A.quest_desc: ["此任务旨在检验多个系统能否协同工作。", "应该指向最终章，而不是送出下界之星或", "在真正的最终证明之前的进化货币。"]
	chapter.097C000000000016.title: "工厂合约"
	chapter.097C000000000016.subtitle: "可选的系统挑战，主线任务中从不强制要求"
	quest.1A14000000000001.title: "工厂合同是可选的"
	quest.1A14000000000003.title: "果园缓冲协议"
	quest.1A14000000000003.quest_desc: ["在投入机器前，先用树循环建造一个小型缓冲器。", "小小的存货能让每一步都更顺畅，还能避免空树的挫败感。"]
	quest.1A14000000000005.title: "储物墙契约"
	quest.1A14000000000005.quest_desc: ["当产出物不再堆积成山时，工厂才真正有趣。", "证明批量物品有抽屉、缓冲器和一条干净的传输路线。"]
	quest.1A14000000000007.title: "按下工作台契约按钮"
	quest.1A14000000000007.quest_desc: ["当一个小工作站取代了重复的手工制作时，创造才开始变得令人满足。", "按下真实的按键并保持部分组件以获得更干净的第一行。"]
	quest.1A14000000000009.title: "移动线路合同"
	quest.1A14000000000009.quest_desc: ["这是第一个大型趣味检查：物品会移动、被处理，并落在有用的地方。", "不需要美观，只需要能用就行。"]
	quest.1A1400000000000B.title: "稳定电力合同"
	quest.1A1400000000000B.quest_desc: ["电力应该像已解决的问题，而不是闪烁的机器。", "使用发电机、电缆和存储装置，让下一台机器保持运行。"]
	quest.1A1400000000000D.title: "Mekanism 入门合约"
	quest.1A1400000000000D.quest_desc: ["理解前三种组件——电缆、注入器和控制电路——后，Mekanism 就会变得更容易上手。", "这份契约证明了机器时代已经真正开始了。"]
	quest.1A1400000000000F.title: "生长引擎契约"
	quest.1A1400000000000F.quest_desc: ["选择生长系统，因为它们能在你操作其他机器时提供资源。", "蜜蜂和作物应该像有用的支线，而不是随机的岔路。"]
	quest.1A14000000000011.title: "实用魔法契约"
	quest.1A14000000000011.quest_desc: ["魔法应该增添实用性和巧妙支持，而不是取代全部流程。", "设置第一批源工具和一个小型 Occultism 锚点。"]
	quest.1A14000000000013.title: "塑料生产线合同"
	quest.1A14000000000013.quest_desc: ["Plastic 让 Industrial Foregoing 不再只是一个普通的机器模组。", "证明乳胶可以成为后续框架的重复使用材料。"]
	quest.1A14000000000015.title: "机器框架契约"
	quest.1A14000000000015.quest_desc: ["框架将一次性机器转变为真正的工业级设备。", "这个目标应该感觉像是为整个团队解锁了一张新的工作台。"]
	quest.1A14000000000017.title: "清洁数字网络合同"
	quest.1A14000000000017.quest_desc: ["干净的数字存储很有趣。先建造控制器、接入点、磁盘驱动器和第一块磁盘，再用线缆将所有东西隐藏起来。"]
	quest.1A14000000000019.title: "自动合成契约"
	quest.1A14000000000019.quest_desc: ["自动化合成是工厂开始回报你的时候。", "先不要自动化所有东西。先证明一个小型的干净导入/导出/合成器设置。"]
	quest.1A1400000000001B.title: "生物数据契约"
	quest.1A1400000000001B.quest_desc: ["稀有掉落不应该再让玩家苦等。", "训练系统，运行模拟，制造有用的掉落物，而不是永远蹲守在一个黑暗的箱子里。"]
	quest.1A1400000000001D.title: "维度准备契约"
	quest.1A1400000000001D.quest_desc: ["下界和末地的材料应有成就感，而非混乱无序。", "在进入下一个稀有掉落阶段前，准备好桥梁所需的资源。"]
	quest.1A1400000000001F.title: "处理器准备合同"
	quest.1A1400000000001F.quest_desc: ["最终挑战应该要求连接的系统，而不是随机的物品墙。", "此契约在最终连锁前会检查 Create、Mekanism、RS 和 HNN。"]
	quest.1A14000000000021.title: "又一个工厂目标 One More Factory Goal"
	quest.1A15000000000001.title: "抽屉控制器项目"
	quest.1A15000000000001.quest_desc: ["把储物墙升级成真正能住得下去的样子。", "抽屉控制器和钥匙可将紧急分拣系统转变为基地系统。"]
	quest.1A15000000000003.title: "创建工作室项目"
	quest.1A15000000000003.quest_desc: ["建造一个小型工坊，而不是零散地放置创造模式方块。", "压制、混合、移动和过滤都应在同一洁净区域内完成。"]
	quest.1A15000000000005.title: "电力缓冲项目"
	quest.1A15000000000005.quest_desc: ["当所有机器都闪烁关闭时，有趣的工厂就不再有趣了。", "在扩大生产前，先给基地装上真正的缓冲器和两个电缆标准。"]
	quest.1A15000000000007.title: "Mekanism 加工项目"
	quest.1A15000000000007.quest_desc: ["不要让Mekanism变成一堆乱七八糟的机器。", "搭建基础处理三件套，证明你对线缆/侧边配置的理解。"]
	quest.1A15000000000009.title: "工业农场项目"
	quest.1A15000000000009.quest_desc: ["Industrial Foregoing 应该能让岛屿感觉不那么手动。", "将植物自动化与塑料生产相结合，让工业层级存在的理由更充分。"]
	quest.1A1500000000000B.title: "模式入门项目"
	quest.1A1500000000000B.quest_desc: ["最初的自动合成配方应该去除无聊的重复，而不是隐藏整个游戏。", "从一个小型的RS工作台和几个线路方块开始。"]
	quest.1A1500000000000D.title: "通用模型集项目"
	quest.1A1500000000000D.quest_desc: ["生物数据最好能取代等待，而非取代探索。", "建造一个小实验室，并为常见掉落物准备好足够的空白模型。"]
	quest.1A1500000000000F.title: "工厂建造流程回顾指南"
	quest.1A1500000000000F.quest_desc: ["走遍基地，检查每个系统是否都有存在的意义。", "这是一个试玩存档点：截图那些让你想继续玩的部分，以及那些感觉像填充物的部分。"]
	quest.1A16000000000001.title: "储物墙居然真的能用了"
	quest.1A16000000000003.title: "一条真正的处理生产线"
	quest.1A16000000000005.title: "电力室检查点"
	quest.1A16000000000007.title: "缩放并非单一系统 Scaling Is Not One System"
	quest.1A16000000000009.title: "塑料成为基础设施的一部分"
	quest.1A1600000000000B.title: "自动建造一些无聊的东西"
	quest.1A1600000000000D.title: "稀有掉落模拟循环"
	quest.1A1600000000000F.title: "终章前的五个系统"
	quest.1A17000000000001.title: "精准无误，毫不混乱"
	quest.1A17000000000001.quest_desc: ["精密机械是第一个让人感觉像小型生产线的创造模组部分。", "你暂时不需要巨型工厂。先做一个你理解并能重复使用的干净部署器生产线。"]
	quest.1A17000000000003.title: "输入、输出、过滤器"
	quest.1A17000000000003.quest_desc: ["会自我排序的移动线路才有用。", "使用漏斗、隧道和过滤器，使线路有明确的输入端和输出端。"]
	quest.1A17000000000005.title: "Mekanism 加工三人组"
	quest.1A17000000000005.quest_desc: ["当它为真正的机器提供动力时，这种力量更令人满足。", "在推进到更大型工业前，先设置好基础的Mekanism加工机器。"]
	quest.1A17000000000007.title: "便携式电源备份"
	quest.1A17000000000007.quest_desc: ["适合初学者的工厂应该能应对轻微的电力失误。", "扩建下一个房间前，准备好便携式能源和备用线缆。"]
	quest.1A17000000000009.title: "蜜蜂产物工作台"
	quest.1A17000000000009.quest_desc: ["蜜蜂并不是早期替代树木的选择。", "把它们当作一个定向缩放基准，用于工厂不断索取的资源。", "蜂蜜、蜂笼和蜂蜜块桥梁只是为了在虚空世界中实现首个可控蜜蜂循环而存在的。"]
	quest.1A1700000000000B.title: "作物缩放启动器"
	quest.1A1700000000000B.quest_desc: ["神秘农业的搭建较慢，但只要保持整洁，回报丰厚。", "从小处着手：一条种子路线，一个精华缓冲器，一个日后重来的理由。", "Prosperity 和 Inferium 有启动配方；后期的扩张应来自作物、蜜蜂或自动化。"]
	quest.1A1700000000000D.title: "Oritech 是一个可选的工作台模组"
	quest.1A1700000000000F.title: "可选的 Oritech 入门行"
	quest.1A1700000000000F.quest_desc: ["这是一个可选的工业分支，而不是一个入口。", "只有在想比较另一种机器风格与Mekanism时，才尝试使用小型Oritech排布。", "如果硅是阻碍物，在认定需要主世界矿石前，先查看JEI中的Skyroot Raw Silicon桥梁配方。"]
	quest.1A17000000000011.title: "机器框架需要一个循环回路"
	quest.1A17000000000011.quest_desc: ["机器框架循环应被重建并实现可重复操作。", "此任务现在会奖励进度，而不会再次发放另一个", "免费的核心机器。"]
	quest.1A17000000000013.title: "AE2 是高级存储的解决方案"
	quest.1A17000000000015.title: "AE2 初学者网络证明"
	quest.1A17000000000015.quest_desc: ["仅在需要高级存储分支时才建造这个。", "如果世界生成配方会阻挡你，请使用 Skyroot 桥梁来通过 Certus、Fluix 和 Presses。", "SkyTech 中能量接收器的配方是特制的，这样在制作时就不会与铁质箱子的升级配方冲突了。"]
	quest.1A17000000000017.title: "AE2 自动合成预览"
	quest.1A17000000000017.quest_desc: ["AE2 自动合成是可选的，属于进阶功能。", "奖励现在是AE2的学习值，而不是普通的钻石", "填充物。"]
	quest.1A17000000000019.title: "实用模型集"
	quest.1A17000000000019.quest_desc: ["一个数据模型是一个演示。一组小模型是一个系统。", "准备几个模型，让你的实验室能支持常见掉落，而不用让你回到手动农场。"]
	quest.1A1700000000001B.title: "下界掉落物数据准备"
	quest.1A1700000000001B.quest_desc: ["稀有掉落物应从首次遭遇转为可控自动化获取。", "不要跳过下界；在确认路线可行后再使用数据。"]
	quest.1A1700000000001D.title: "可选的 Oritech 合约任务"
	quest.1A1700000000001D.quest_desc: ["这份合约旨在为 Oritech 明确角色，而无需将其强行纳入主线。", "如果你想拥有第二个工业工坊风格，除了Mekanism和IF，那就完成它吧。"]
	quest.1A1700000000001F.title: "可选的AE2合同任务书"
	quest.1A1700000000001F.quest_desc: ["此契约面向想要高级存储谜题的玩家。", "保持RS为简单路线，然后在需要更深入的规划时使用AE2。"]
	quest.1130000000000019.quest_desc: ["欢迎来到 SkyTech Evolution。从小处着手，遵循路线，", "并且让每个章节只教授一个系统。"]
	quest.113000000000001D.quest_desc: ["主线任务是用来教学系统的，而不是简单的打勾任务。", "当步骤要求一个物品时，它应该是一项有用的技能。"]
	quest.1130000000000021.quest_desc: ["奖励应能支持在不玩整合包的情况下完成下一步", "为你准备的。最好的奖励是能推动你不断前进的奖励。"]
	quest.1130000000000001.quest_desc: ["把这一页当作你的指南针。它能显示从...的安全路线", "从第一棵树到最终自动化，无需消耗任何材料。"]
	quest.1130000000000027.quest_desc: ["仅在原版泥土上种植 Skyroot 树苗：泥土、草地、粗土或带根泥土。", "在其周围留出清晰的 3x3 区域，并确保至少有 6 格的垂直高度。", "自然生长是自动的。骨粉保持原版特性。反复在树苗旁蹲下或冲刺以促进更快生长。"]
	quest.1130000000000029.quest_desc: ["原木仍然是主要的树脂来源。树叶也能提供一些帮助，", "树脂应该会促使你采集并整理整棵树。", "当不清楚下一个Skyroot配方时，使用JEI在树脂上查找配方。"]
	quest.113000000000002C.quest_desc: ["树叶是你的软质资源层：纤维、树苗、橡子还有一些树脂。", "需要恢复时使用钩爪；需要方块时才用剪刀。", "这样既能保留树叶掉落物的用处，又不会让树脂变得太廉价。"]
	quest.1130000000000044.quest_desc: ["初始循环稳定。带上支援物资，前往资源树区域。", "从这里开始，树木而非重复的手册配方，决定了主要的资源路线。"]
	quest.113000000000004A.quest_desc: ["资源树是整合包的核心。树脂和橡子是唯一选择", "只要你能持续收集、分类和重复利用它们，就没问题了。", "JEI 在每对新橡子/树脂上使用时，应该会显示下一个材料路线。"]
	quest.113000000000005C.quest_desc: ["使用铜树的产物来制作铁树，然后将每棵树的橡果和树脂组合成痕迹。", "之后铜和铁才应该被制成锭并投入机器中。"]
	quest.1130000000000065.quest_desc: ["你的第一棵盆景树现在可以自动生长，无需手动砍伐了。", "在扩大规模前，先给原木、树脂和橡子找一个干净的桶或抽屉。", "管道提取的教学会晚些进行，在铁和红石真正可用之后。"]
	quest.1130000000000072.quest_desc: ["扩大生产前，先为每种普通产物安排好去处。", "从普通的抽屉、一把钥匙和可见的箱子或桶缓冲区开始。", "控制器有意安排在铁和红石之后，不需要钻石或筛分。"]
	quest.1130000000000076.quest_desc: ["不要为了继续存储而特意去筛钻石。", "在铁和红石树之后，使用 SkyTech 配方：一个抽屉、四个铁锭和四个红石粉。", "控制器随后将准备好的墙壁变成一个干净的输入系统。"]
	quest.1A16000000000001.quest_desc: ["这是一个项目目标，而不是一个小小的物品检查。", "一个可用的存储墙应该能接收主果园的产出，并为下一个创造模式装置提供动力。"]
	quest.1130000000000086.quest_desc: ["创造始于一条移动线。先不要建造工厂；", "先证明旋转、一台机器和一个干净的输出。"]
	quest.1A16000000000003.quest_desc: ["建造一条可以在你做其他事情时运行的处理线。", "那一刻，Create 不再只是一个配方模组，而开始有了自动化的感觉。"]
	quest.11300000000000A1.quest_desc: ["旋转和FE能量是两个不同的系统。本章", "教给你一个发电机、一根电缆、一个缓冲器和一台动力机器。"]
	quest.1A16000000000005.quest_desc: ["一个好的动力室，无聊得恰到好处。", "它有生成器、电缆、缓冲器和足够的备件，一个错误不会让整个岛屿停止运转。"]
	quest.11300000000000B5.quest_desc: ["生长系统是一种缩放工具。先选择一个助手，然后", "当存储、能量和输出能够承受时进行扩展。"]
	quest.1A16000000000007.quest_desc: ["一个强大的岛屿不应永远依赖单一的生产技巧。", "把果园当基地，然后加一条能解决当前瓶颈的缩放路径。"]
	quest.11300000000000DA.quest_desc: ["输入和输出受控时，工业便开始了。在加入钢、塑料和框架前，先单独运行一台机器。", "此测试版在此添加了多种虚空安全入口材料：工业大麻种子、Oritech 原始硅，并为后期机器路线提供了更清晰的指引。", "这些是桥梁，不是捷径。在把它们用于长机器链之前，先建造一个可重复的循环。"]
	quest.1A16000000000009.quest_desc: ["塑料不仅仅是另一种材料，它是通往可重复机器基础设施的桥梁。", "保持乳胶、水、FE和存储可见，直到循环变得无聊且可靠。"]
	quest.11300000000000F1.quest_desc: ["数字存储不是魔法垃圾桶。先建好批量存储，再连接你懂的输出端。", "Refined Storage 是更简单的主路线。AE2 可作为进阶可选路线，拥有自己的 Certus、Fluix 和 Press 桥梁。", "从小处着手：控制器、网格、磁盘，然后一个导入/导出循环。"]
	quest.1A1600000000000B.quest_desc: ["先自动化制作点简单又烦人的东西。", "如果你的网络能处理枯燥的重复部分，那么它就可以成为真实工厂的一部分了。"]
	quest.1130000000000107.quest_desc: ["生物掉落物应改为可控，而非随机等待。", "先搞定掉落，再用数据让它们可重复出现。", "Prediction Matrix 现在有网络级的备用配方，这样在实验室运行前 HNN 不会被消耗品卡住。"]
	quest.1A1600000000000D.quest_desc: ["完整的数据循环是：训练模型，模拟运行，然后制造工厂真正需要的东西。", "如果能让你免于站在刷怪塔前，那它就完成了自己的工作。"]
	quest.1130000000000125.quest_desc: ["最终测试将检查你的系统能否协同工作。它应该", "奖励自动化和规划，而不是最后一个手动堆叠。"]
	quest.1A1600000000000F.quest_desc: ["五个系统协同工作才是真正的回报。", "金币和经验值足够了，通用的钻石填充物已经移除。"]
	quest.1A14000000000021.quest_desc: ["在继续推进之前，以此作为暂停点。", "走遍基地，问问自己：哪里显得杂乱，哪里总是卡住，哪里能让接下来的一个小时更顺畅？"]
	quest.1A17000000000013.quest_desc: ["AE2 是高级存储方案。当需要频道、模式和更深入的网络规划时再尝试，而不是被主路线所迫。", "虚空启动器现已明确：Certus Quartz、Charged Certus、Fluix、Certus Dust 和 Processor Presses 均有受限制的 Skyroot/Network 桥梁配方。", "此任务现已检查 AE2 控制器物品，不再只是一个模糊的勾选框。"]
	quest.1A1700000000000D.quest_desc: ["Oritech 是一个可选的工坊路线。在基础工业路线成熟后，用它来增加额外的处理深度。", "原始硅现在可以通过工业处理器、石英、沙子和树脂制作成天根桥，这样分支就能在虚空世界开始了。", "除非你的工厂确实能从 Oritech 的机器中受益，否则不要将其视为主要入口。"]
	quest.1A18000000000001.title: "玩家的体验是第一位的"
	quest.1A18000000000001.quest_desc: ["整合包应该感觉有引导性，而不是拥挤不堪。如果某个路线感觉", "令人困惑，返回主线并重建一个干净的步骤。"]
	quest.1A19000000000001.title: "如何使用通关项目 (How To Use Playthrough Projects)"
	quest.1A19000000000003.title: "果园为基地提供食物"
	quest.1A19000000000003.quest_desc: ["把第一个树的循环做得足够大，让人感觉是在生产，而不是紧急求生。", "这个项目应该能让存储和创造模式更容易上手。"]
	quest.1A19000000000005.title: "一面真正能接收物品的墙壁"
	quest.1A19000000000005.quest_desc: ["抽屉墙只有在物品能自动放入，无需手动整理时，才令人满意。", "把这个当成你第一个真正的反箱怪项目吧。"]
	quest.1A19000000000007.title: "一个紧凑型创造单元"
	quest.1A19000000000007.quest_desc: ["先不要建造巨型工厂。先建造一个能压制、移动、研磨或清洗物品的小型单元格。", "只有当单元的输出到达抽屉、桶或受控缓冲器时，该单元才算完成。"]
	quest.1A19000000000009.title: "一个永不停歇的动力室"
	quest.1A19000000000009.quest_desc: ["电力应该让基地更平静，而不是更紧张。", "这个项目证明你掌握了生成、线路布设和小型缓冲，才能添加更重的机器。"]
	quest.1A1900000000000B.title: "一条升级之路，而非三种混乱"
	quest.1A1900000000000B.quest_desc: ["生长、作物、蜜蜂和魔法只有在解决真正瓶颈时才有用。", "先选择一个支持路径，只有在有帮助时才进行扩展。", "新增的桥配方是为了让你能主动选择路线，而不是让每个可选模组都变成强制作业。"]
	quest.1A1900000000000D.title: "项目：塑料基础设施循环系统"
	quest.1A1900000000000D.quest_desc: ["当塑料可以循环使用而非一次性合成时，工业进步才更有意义。", "使用此项目将树木产出和电力转化为真正的机器基础设施。"]
	quest.1A1900000000000F.title: "项目：自动化无聊物品制造机"
	quest.1A1900000000000F.quest_desc: ["最好的首个自动合成配方并不令人兴奋。它应该是你厌倦了手动制作的物品。", "如果网络能处理无聊的部分，它就能开始帮助整个游戏流程了。"]
	quest.1A19000000000011.title: "数据实验室第一循环"
	quest.1A19000000000011.quest_desc: ["一个好的数据实验室能将等待刷怪塔的过程替换为可控的流程。", "训练一个有用的模型，模拟它，然后制造出你的工厂真正需要的物品。"]
	quest.1A19000000000013.title: "项目：终章前的五个系统"
	quest.1A19000000000013.quest_desc: ["在最终路线之前，证明工厂是相连的。", "创造、动力、工业、存储和生物数据都应在游戏后期要求更多之前完成有用的工作。"]
	chapter.097C000000000019.title: "通关流程项目"
	chapter.097C000000000019.subtitle: "想要建造混凝土工厂的玩家可选的建造提示"
	quest.113000000000001B.quest_desc: ["感到迷茫时，请使用路线图。它会显示安全的顺序，", "但实际的工作仍然发生在真正的章节内部。", "密集章节可能隐藏连接线以提高可读性；锁定任务仍遵循其依赖关系。"]
	quest.1A19000000000001.quest_desc: ["通关项目是可选的建造提示。在以下情况时使用它们", "你想要一个混凝土工厂目标，而不是另一个清单。"]
	quest.1A14000000000001.quest_desc: ["工厂合约是可选的挑战目标。它们会奖励真实的", "是理解运作机制，而不是阅读介绍的过程。"]
	quest.1A26000000000001.title: "安全树木缓冲区"
	quest.1A26000000000001.quest_desc: ["离开第一章之前，请保留一小部分缓冲物品，这些物品是", "用原木、树脂、纤维和一棵备用树苗拯救岛屿，免受糟糕的随机数影响。", "不确定下一个合成配方在哪时，使用 JEI 的使用功能查看树脂。"]
	quest.1A26000000000003.title: "你的第一个资源工作台"
	quest.1A26000000000003.quest_desc: ["果园能回答普通问题后，就变得有趣起来了：", "没有筛子墙，它能制造地面方块、燃料和早期金属吗？", "把所有东西做成方块前，先检查JEI中橡子/树脂的用途。"]
	quest.1A26000000000005.title: "第一个整理好的角落"
	quest.1A26000000000005.quest_desc: ["不要把所有东西都堆在一个箱子里面进行生产。", "建造一个带控制器和一条管道路线的小型抽屉角。", "看起来应该很无聊，这意味着它会持续工作。"]
	quest.1A26000000000007.title: "压榨、研磨、清洗"
	quest.1A26000000000007.quest_desc: ["这是第一个真正的创造细胞：压制金属，研磨方块，并清洗一个输出流。", "扩建前，请确保至少有一个输出进入抽屉或缓冲器，而不是留在地上。", "使用 JEI 分类来查看哪个机器处理哪个流程。"]
	quest.1A26000000000009.title: "一台永不停歇的机器"
	quest.1A26000000000009.quest_desc: ["当一台机器能独立运行而无需看管时，动力才算就绪。", "先建造微型原型：发电机、电缆、缓冲器、动力机器，", "以及一条将产物送回存储的可见输出路线。"]
	quest.1A2600000000000B.title: "选择一个缩放辅助工具"
	quest.1A2600000000000B.quest_desc: ["生长系统是可选的辅助，并非同时进行的三项琐事。", "证明一个蜜蜂/作物/魔法支持路线，然后返回主路线", "一个能真正帮助生产的自动化工厂。"]
	quest.1A2600000000000D.title: "钢铁与塑料的结合"
	quest.1A2600000000000D.quest_desc: ["钢铁、塑料和机器框架让工业开始运转起来", "来自可重复的设置，而非一次性合成。这就是", "在数字存储之前的存档点应该让玩家感到来之不易。"]
	quest.1A2600000000000F.title: "一个能解决问题的网络"
	quest.1A2600000000000F.quest_desc: ["数字网络不仅仅是更大的箱子。在外部使用 JEI", "存储、磁盘和处理器，然后让网络解决一个真实的问题", "base 问题，而不是隐藏未分类的物品。"]
	quest.5AE8DAEBFD4BF6EC.title: "红石控制检查 Redstone Control Check"
	quest.5AE8DAEBFD4BF6EC.quest_desc: ["红石控制可防止机器运行产生噪音或浪费。", "将此作为首个提示，用于规划切换器、比较器和侧边行为。"]
	quest.0BBEE3039564F77F.title: "用于维度准备的玄武岩"
	quest.0BBEE3039564F77F.quest_desc: ["黑曜石是下界和晚期实用路线的桥接材料。", "批量消耗前，请确保路线可重复使用。"]
	quest.33D4F5FEA4803908.title: "末地外壳检查"
	quest.33D4F5FEA4803908.quest_desc: ["末地资源应该能证明你到达了末地维度，而不仅仅是找到了随机物品。", "在最终自动化中使用前，请控制紫颂和潜贝材料的使用。"]
	quest.147A998A36AB2A97.title: "最终网络接口"
	quest.147A998A36AB2A97.quest_desc: ["最终的路线应该连接到你可以实际使用的网络。", "合成网格/界面检查证明，终局游戏建立在真实的存储进度之上。"]
	quest.1A29000000000001.title: "一次性纯净摄入"
	quest.1A29000000000001.quest_desc: ["在创造模式开始乱扔物品之前，先给基地一个干净的地方", "以接收重复的输出。一个抽屉、控制器、管道和缓冲桶", "第一批真正的物资就足够了。物品流清晰后，锁上抽屉。"]
	quest.1A29000000000003.title: "创建输出需要放置到某个地方"
	quest.1A29000000000003.quest_desc: ["只有在有输出目的地时，压力板、储物箱和滑道才有用。", "路线一：在建造更大的机器前，将产物存入抽屉或缓冲器中", "皮带线。如果卡住，请先检查方向、过滤器和接收抽屉。"]
	quest.1A40000000000001.title: "食物与光源组合包"
	quest.1A40000000000001.quest_desc: ["早期失误时的小小慰藉。在饥饿或...时使用。", "黑暗会减慢测试速度，而不是作为耕种的替代品", "和资源树的产出效率。"]
	quest.1A40000000000002.title: "建筑基础工具包"
	quest.1A40000000000002.quest_desc: ["用于安全平台和简易工作区的小型建筑补给包。", "这对基地安全很有用，但岛屿仍然应该获得", "通过 Skyroot 循环获取其主要材料。"]
	quest.1A40000000000003.title: "管道填充组合包"
	quest.1A40000000000003.quest_desc: ["红石树开启真实物品路由后，会多出管道、漏斗和箱子。", "使用补充物来修复或扩展已测试的网络，而不是跳过最初制作的管道。"]
	quest.1A40000000000004.title: "抽屉墙壁组合包"
	quest.1A40000000000004.quest_desc: ["专为追求整洁批量存储的玩家设计的抽屉式补充包。", "钥匙在此作为提醒：在扩展自动化前，请先上锁抽屉。"]
	quest.1A40000000000005.title: "创建腰带补给器"
	quest.1A40000000000005.quest_desc: ["解锁创造模式后，用于为传送带、传动轴和合金补充实物的实用工具。", "它支持在不跳过机器本身的情况下进行实验。"]
	quest.1A40000000000006.title: "红石控制组合包"
	quest.1A40000000000006.quest_desc: ["用于投掷器、过滤器、切换器和早期自动化测试的小型控制套件。", "当生产线需要控制时购买，而不是想跳过资源生产时。"]
	quest.1A40000000000007.title: "电力线路束"
	quest.1A40000000000007.quest_desc: ["首个电力网络的线缆补给。提供线缆和一根", "解锁能量后有一个小缓冲，所以调试能量会这样", "不想做那些没意义的重复劳动。"]
	quest.1A40000000000008.title: "Mekanism 入门补给包"
	quest.1A40000000000008.quest_desc: ["工业路线开启后，补充一些基础的工业材料。", "钢铁和电路有助于重复机器制造，但机器仍需获得。"]
	quest.1A40000000000009.title: "塑料回收组合包"
	quest.1A40000000000009.quest_desc: ["乳胶和塑料循环的恢复性购买。应该会有帮助", "理解路线后，不要替换流体提取器", "以及乳胶处理设置。"]
	quest.1A4000000000000A.title: "网络电缆束"
	quest.1A4000000000000A.quest_desc: ["用于线缆和基础处理器数字存储的补充。在...之后很有用", "你的第一个网络已经存在，并且你想干净地扩展它。"]
	quest.1A4000000000000B.title: "网络输入输出捆绑包"
	quest.1A4000000000000B.quest_desc: ["为正在建造的玩家们提供的专注式进出口/外部存储补给", "它们的第一次真正网络循环。它不会取代自动合成进度。"]
	quest.1A4000000000000C.title: "稀有掉落恢复组合包"
	quest.1A4000000000000C.quest_desc: ["维度间稀有掉落路线错误后的补救包", "以及生物数据进度都已在掌控之中。"]
	quest.1A4000000000000D.title: "终极舒适组合包"
	quest.1A4000000000000D.quest_desc: ["决赛后的安慰性购买。这应该只在决赛后才重要", "主路线已经通关，所以会奖励庆祝物品", "早期游戏进程的强力道具之一。"]
	chapter.097C000000000010.subtitle: "掉落物和维度奖励受控系统"
	chapter.097C000000000011.subtitle: "最终奖励证明完全自动化可行"

	chapter_group.6A7C0F0A6D000001.title: "资源果园"
	chapter.097C000000000007.title: "资源果园扩展包任务书"
	chapter.097C000000000007.subtitle: "从机械到工业的精确土壤等级"
	quest.1170000000000001.title: "青金石树"
	quest.1170000000000001.quest_desc: ["在早期神秘材料路线开启后，打开", "金属果园。无需通用手动过滤，即可保持青金石可再生。"]
	quest.1170000000000003.title: "红石树"
	quest.1170000000000003.quest_desc: ["使用机械天根核心来生长这个物品", "用于电力和自动化的第一种可再生控制材料。"]
	quest.1170000000000005.title: "锌树"
	quest.1170000000000005.quest_desc: ["锌支持创造黄铜，并且应该在之后", "第一条能用的机械线，在此之前不行。"]
	quest.1170000000000007.title: "黄金树"
	quest.1170000000000007.quest_desc: ["黄金紧随红石和已有的铜/铁果园之后。", "它准备了电力、存储和后期的网络发展。"]
	quest.1170000000000009.title: "石英树"
	quest.1170000000000009.quest_desc: ["石英完成了用于数字存储的实用果园。", "需要同时满足青金石和金矿分支的条件。"]
	quest.117000000000000B.title: "实用果园检查点"
	quest.117000000000000B.quest_desc: ["处理Tier 4机械土壤的产出物", "在迁入 Tier 5 Energized Soil 果园之前。"]
	quest.117000000000000D.title: "锡树"
	quest.117000000000000D.quest_desc: ["锡是第一种被赋予能量的工业金属", "并支持Mekanism和更广泛的机器合成。"]
	quest.117000000000000F.title: "锇树 (Osmium Tree)"
	quest.117000000000000F.quest_desc: ["锇是Mekanism的核心金属。它能解锁", "稳定的 FE 和 Energized Skyroot Core 之后。"]
	quest.1170000000000011.title: "引导树木"
	quest.1170000000000011.quest_desc: ["铅紧随锡之后，并成为", "一种可再生的防护和机械材料。"]
	quest.1170000000000013.title: "银色之树"
	quest.1170000000000013.quest_desc: ["银从铅和金这两个分支中生长出来，", "将沉浸式工程的材料保留在果园的逻辑中。"]
	quest.1170000000000015.title: "镍树"
	quest.1170000000000015.quest_desc: ["镍连接了铁/锇的路线", "到 Oritech 和 Immersive Engineering 合金。"]
	quest.1170000000000017.title: "铝制树木"
	quest.1170000000000017.quest_desc: ["铝由黏土、锡和能量化生而成", "而不是需要正常的矿石生成来进行处理。"]
	quest.1170000000000019.title: "铀树"
	quest.1170000000000019.quest_desc: ["铀是一种受控的晚期工业果园材料。它", "遵循铅和锇，而不是早期岛屿。"]
	quest.117000000000001B.title: "工业果园检查点"
	quest.117000000000001B.quest_desc: ["证明 Tier 5 Energized Soil 果园可以正常工作", "在升级到 Tier 6 的 Arcane gems 和 Tier 7 的 Platinum 之前。"]
	quest.117000000000001D.title: "钻石树"
	quest.117000000000001D.quest_desc: ["钻石是第6阶资源，仅生长在神秘土壤中。", "它仍然被晚期处理和完全充能的果园所阻隔。"]
	quest.117000000000001F.title: "Emerald Tree"
	quest.117000000000001F.quest_desc: ["Emerald 是第二个 Tier 6 Arcane Soil 树。", "它遵循网络路线，并且是后期可再生的奖励。"]
	quest.1170000000000021.title: "铂金树"
	quest.1170000000000021.quest_desc: ["铂金是唯一的七级树木，且只生长在工业土壤上。", "它将镍、银和钻石结合，用于后期以Oritech为核心的工业。"]
	quest.1170000000000023.title: "资源果园已完成"
	quest.1170000000000023.quest_desc: ["所有七个 Skyroot 土壤层级现已建立。", "每棵树苗在世界上和盆景盆中都会使用恰好一种匹配的土壤。"]
	quest.1B06000000000001.title: "没有熔炉的火焰瓷砖"
	quest.1B06000000000001.quest_desc: ["第一个熔炉需要鹅卵石，所以开头用可控桥梁代替强制早期筛分。", "在JEI中制作Skyroot树脂篝火。将黏土球与骨粉混合成瓷土，用三个塑形为未烧制的瓷桶，然后在点燃的篝火上烹饪30秒。", "篝火配方只会生成桶和坩埚，不会生成水、岩浆或基础材料。"]
	quest.1B04000000000001.title: "收集第一桶水"
	quest.1B04000000000001.quest_desc: ["用七个Skyroot原木制作一个Skyroot Crucible，并将其安全地放置在你的平台上。", "添加四片 Skyroot Leaves：每片贡献 250 mB，四片正好能生成 1000 mB 的水。", "使用烧制好的瓷质水桶收集水。任务会检查实际的瓷质水桶，而非空容器。"]
	quest.1B04000000000003.title: "点燃熔炉，制造岩浆"
	quest.1B04000000000003.quest_desc: ["将七个 Porcelain Clay Ball 合成 Unfired Porcelain Crucible，然后在同一个点燃的 Campfire 上烹饪 30 秒。", "将完成的熔炉置于火把或点燃的篝火上方，然后投入四块砾石；每块可贡献 250 mB 岩浆。", "先放置水源，倒空瓷质水桶，然后再次使用它收集岩浆。任务会检查实际的瓷质岩浆桶。"]
	quest.1B04000000000005.title: "建造第一个鹅卵石发电机"
	quest.1B04000000000005.quest_desc: ["放置水使其流入一个空的相邻方块，然后让岩浆从对面流入同一个方块。", "切勿让两个源区块接触。用不可燃方块保护两个源，并在挖掘前站到安全边缘后面。", "至少挖掘16个原石，以证明发电机稳定。之后，Create将教你连续机械生产原石。"]
	quest.1B06000000000004.title: "现在建造一个真正的熔炉"
	quest.1B06000000000004.quest_desc: ["使用八个最初获得的 Cobblestone 来制作一个 Furnace。这样就能完美地闭合启动循环了。", "从现在开始，使用普通熔炉配方：将粘土球熔炼成砖块用于盆景盆，将天根原木熔炼成木炭。", "篝火仍然有用，但它不再是你的主要处理方块。"]
	quest.1B04000000000007.title: "你的第一盆盆景花盆"
	quest.1B04000000000007.quest_desc: ["在新熔炉中熔炼陶土球成砖，并制作普通盆景盆；跳跃盆景盆在此版本中不使用。", "放入完全匹配的土壤，然后是树苗，并在工具栏放置一把斧头，这样树木就会自动被收割。", "先从一个根植土树木开始，确认其内部产出后再扩建果园。"]
	quest.1B04000000000009.title: "Pipez 盆景自动化"
	quest.1B04000000000009.quest_desc: ["此步骤特意放在后面：物品管道需要铁和红石，因此在使用第一棵盆景前，请勿等待它们。", "将 Bonsai Pot 的 Pipez Item Pipe 连接到桶或抽屉，并将花盆一侧的连接配置为提取。", "斧头留在盆景工具栏中；确认土壤和树苗留在里面，所有收获物都存入仓库。"]

	quest.1B05000000000001.title: "建造机械式鹅卵石发电机"
	quest.1B05000000000001.quest_desc: ["普通的 Create Drill cobblegen 很有用，但这个里程碑会教你制作专用的 Create Cobblestone 方块。", "合成并持有来自 Create Cobblestone 的机械发电机。任务会检查该特定物品，而非任何钻头装置。", "任务完成后，放置发电机，为其提供旋转动力，用鹅卵石右键设置输出，然后将生成的方块导入存储管道。"]

	quest.1B17000000000001.title: "扩建而非提前建造"
	quest.1B17000000000001.quest_desc: ["一旦岛屿能稳定产生FE并替换建筑材料，大型平台就会很有用。", "此可选分支在 Energized Skyroot Core 之后开始，可加快建造速度，而不会取代早期的 Skyblock 决策。"]
	quest.1B17000000000003.title: "建筑小工具"
	quest.1B17000000000003.quest_desc: ["用FE为其充能，将要放置的方块保持在背包中，并使用设置菜单来选择建造模式。", "这是一种建造工具，而非免费建造：放置的每个方块仍需消耗你的物资。"]
	quest.1B17000000000005.title: "点击前请先预览"
	quest.1B17000000000005.quest_desc: ["默认操作：G 设置，R 范围，H 锚定，U 撤销。", "在虚空、存储墙或起始岛屿附近放置任何东西前，请先预览。撤销是安全工具，不能替代备份。"]
	quest.1B17000000000007.title: "交换小工具中，请稍候..."
	quest.1B17000000000007.quest_desc: ["无需重建整个平台或机房，即可替换简单的结构方块。", "请先在普通方块上使用。在确切设置未测试前，避免使用活动机器、物品栏、管道和其他复杂方块实体。"]
	quest.1B17000000000009.title: "高级小工具并非必需"
	quest.1B17000000000009.quest_desc: ["复制/粘贴、剪切/粘贴和破坏是强大的后期工具，并非必需。", "它们需要用工业材料解锁，因为只有在岛屿有备份、能源和可替代资源后，才能移动或删除大型结构。"]
	quest.1B1700000000000B.title: "复制粘贴小工具"
	quest.1B1700000000000B.quest_desc: ["复制一个形状，在所需方块可用时粘贴到其他地方。", "从普通方块开始。机器、线缆、多部分方块和物品栏可能无法完全还原，所以在复制工厂前请先测试小区域。"]
	quest.1B1700000000000D.title: "模板管理器"
	quest.1B1700000000000D.quest_desc: ["保存和加载复制-粘贴模板，用于重复的平台或安全的结构外壳。", "请先测试由普通方块制成的小型模板。请勿存储包含机器、储罐、物品栏或网络部件的未测试模板。"]
	quest.1B1700000000000F.title: "剪切粘贴小工具"
	quest.1B1700000000000F.quest_desc: ["无需逐块重建，即可移动简易结构。", "请勿在已加载的抽屉、储罐、机器、管道或数字存储设备上使用。这些方块携带的数据在移动时可能无法安全保存。"]
	quest.1B17000000000011.title: "破坏小工具"
	quest.1B17000000000011.quest_desc: ["该工具能快速移除大片区域，主路线中从不需要使用。", "确认预览，远离起始岛屿和存储区，在使用大范围功能前备份世界。"]

	quest.1D18000000000001.title: "抽屉墙防掉落测试"
	quest.1D18000000000001.quest_desc: ["建造一个真正的抽屉墙，而不是临时堆放的箱子。", "所需的橡木抽屉和橡木饰条现在有基于天空根的合成配方，这样证明过程就能走主线，而不用被迫绕道用筛子做橡木。"]
	quest.1D18000000000006.title: "受控路由证明 (Controlled Routing Proof)"
	quest.1D18000000000006.quest_desc: ["只有在红石解锁后才能使用控制器和管道。", "虚空升级是安全护栏，而非计划的替代品。"]
	quest.1D1800000000000A.title: "创建处理单元 (Create Processing Cell)"
	quest.1D1800000000000A.quest_desc: ["这是第一个值得保留的创造模式单元格。", "在扩建工厂前，先压制、研磨、清洗并移动物品。"]
	quest.1D1800000000000F.title: "黄铜自动化工作台"
	quest.1D1800000000000F.quest_desc: ["黄铜和精密机械是创造开始扩展的地方。", "把这个留着，用来制作可重复的机器零件。"]
	quest.1D18000000000014.title: "动力建造工具包"
	quest.1D18000000000014.quest_desc: ["在信任这些装置能承载平台之前，先给它们充好电。", "它们是自动化建造的辅助工具，而非前期游戏的捷径。"]
	quest.1D18000000000018.title: "机器能量工作台"
	quest.1D18000000000018.quest_desc: ["一个小小的动力室需要的可不止一台发电机。", "电缆、缓冲器和侧面配置可防止大多数新手问题。"]
	quest.1D1800000000001D.title: "蜜蜂处理循环"
	quest.1D1800000000001D.quest_desc: ["蜜蜂的产出有了归属之后，它们就变得很有用了。", "捕获、加工和分类，才能称之为资源路线。"]
	quest.1D18000000000020.title: "神秘实用工作台"
	quest.1D18000000000020.quest_desc: ["魔法是可选的，但内容仍然应该易于理解。", "此工作台证明源存储、宝石和附魔均已就绪。"]
	quest.1D18000000000025.title: "Occultism 仪式启动器"
	quest.1D18000000000025.quest_desc: ["神秘学当体系而非谜团时，效果最佳。", "在正式使用仪式前，先收集好指南、碗和宝石。"]
	quest.1D18000000000029.title: "Mekanism 处理单元"
	quest.1D18000000000029.quest_desc: ["这是第一个紧凑的Mekanism工作单元。", "这应该能改善重复处理，而不是一次性替换你的整个工厂。"]
	quest.1D1800000000002E.title: "塑料生产单元"
	quest.1D1800000000002E.quest_desc: ["塑料是一种生产链，而不仅仅是一个配方。", "Extractor、乳胶处理和框架证明了Industrial Foregoing路线已上线。"]
	quest.1D18000000000033.title: "溶解室工作台"
	quest.1D18000000000033.quest_desc: ["溶解室是工业前奏成为基础设施的地方。", "不要着急，给它材料和足够的空间。"]
	quest.1D18000000000036.title: "网络硬件工作台"
	quest.1D18000000000036.quest_desc: ["数字存储应该是一个网络，而不是一个魔法箱子。", "控制器、电网、驱动器和电缆构成最低限度的稳定配置。"]
	quest.1D1800000000003B.title: "进出口工作台"
	quest.1D1800000000003B.quest_desc: ["自动化始于网络有目的地移动物品之时。", "导入、导出和外部存储在自动合成前需要规划。"]
	quest.1D18000000000040.title: "HNN 模拟工作台"
	quest.1D18000000000040.quest_desc: ["Hostile Neural Networks 将等待转化为可控的生产。", "训练模型，运行模拟，保持预测的持续流动。"]
	quest.1D18000000000045.title: "人工合成战利品工作台"
	quest.1D18000000000045.quest_desc: ["制造机是训练模型后的回报。", "用它来重复获取掉落物，而不是永远站在生物农场里。"]
	quest.1D18000000000048.title: "维度入口套件"
	quest.1D18000000000048.quest_desc: ["在 Skyblock 整合包中，维度访问应当是深思熟虑的。", "黑曜石、烈焰粉和眼睛证明你已准备好安全离开岛屿。"]
	quest.1D1800000000004C.title: "Real Mod 最终版证明"
	quest.1D1800000000004C.quest_desc: ["最终章应展示真正的系统，而不仅仅是自定义标记。", "从 Create、Mekanism、Digital Storage 和稀有掉落中各带一个证明。"]

	quest.1E23000000000001.title: "中盘金属路线证明"
	quest.1E23000000000001.quest_desc: ["这是从早期树木过渡到机器的完整生存指南。", "煤炭提供燃料，铜和铁提供微量金属，微量金属可成为第一批可重复获得的金属。", "在判断创造模式是太早还是太晚之前，先完成这个。"]
	quest.1E23000000000009.title: "红石解锁证明"
	quest.1E23000000000009.quest_desc: ["红石是将存储从抽屉墙转变为受控路由的阀门。", "在制作控制器和物品管道前，先确认红石树和小型缓冲器。"]
	quest.1E2300000000000F.title: "一条已连接的抽屉线路"
	quest.1E2300000000000F.quest_desc: ["先不要建造意大利面网络了。", "使用一个控制器、一个锁定抽屉和一个管道物品管，证明盆景或机器输出能到达正确的存储目标。"]
	quest.1E23000000000016.title: "创建路线证明单元 Create Route Proof Cell"
	quest.1E23000000000016.quest_desc: ["这是最低限度的 Create 配置，应该值得保留。", "在扩大生产线前，先压制一张、研磨一种材料、清洗一种产物，并用传送带移动物品。"]
	quest.1E2300000000001E.title: "首个FE工作台"
	quest.1E2300000000001E.quest_desc: ["初始设置越小，电力问题通常越容易解决。", "一台发电机、一根电缆、一块电池、一台动力机器和一台平板电脑就足以证明FE路线。"]
	quest.1E23000000000026.title: "动力建筑已准备就绪"
	quest.1E23000000000026.quest_desc: ["建筑工具包需要这些：能源、真实材料供应和至少一块充能的能量表。", "请先在简单的平台方块上使用，不要用于机器、已加载的存储、管道或网络方块。"]
quest.1F09000000000001.title: "无需猜测的黑色石英"
quest.1F09000000000001.quest_desc: ["黑石英是 Actually Additions 的入门材料。筛沙砾仍然有效，但它不应是 Skyblock 整合包中唯一发现该材料的方法。", "使用 Skyroot 桥梁配方：石英 + 煤炭或木炭 + 红石 + Skyroot 树脂。如果你有搅拌机，使用 Create 混合配方可以获得更好的批次。", "此任务检查实际的 Black Quartz 物品，而非复选框。一旦能制作小型缓冲器，Actually Additions 便无需矿石世界生成或猜测即可启动。"]

}
