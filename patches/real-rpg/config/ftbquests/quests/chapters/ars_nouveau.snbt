				item: "ars_nouveau:agronomic_sourcelink"
				type: "item"
			}]
			x: 5.0d
			y: 1.0d
		}
		{
			dependencies: ["10C2F8C29D2D5EC1"]
			description: ["火山源链接通过消耗可燃烧物品（如远古木原木）来生成源。它能产生热量、生成熔岩百合，并将石头转化为熔岩。附近的烈焰远古木也会燃烧以换取源。源链接将输出到附近的罐子中。"]
			id: "25E579FB18D667BC"
			rewards: [{
				id: "39E6C7781E761FF6"
				item: "ars_nouveau:source_jar"
				type: "item"
