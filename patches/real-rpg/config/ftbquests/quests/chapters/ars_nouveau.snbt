		{
			dependencies: ["66F71F7D4CCE9DC9"]
			description: ["Agronomic Sourcelink 是一种机器，能在 15 格范围内通过作物和树木的生长来生成“源”。魔法植物，如 Mageblooms、Source Berry Bushes 和 Archwood Saplings，会提供额外的源。生成的源会从 Sourcelink 输出到 5 格范围内的邻近罐子中。"]
			id: "10C2F8C29D2D5EC1"
			rewards: [{
				id: "7F0F9E8546210A4B"
				item: "ars_nouveau:source_jar"
