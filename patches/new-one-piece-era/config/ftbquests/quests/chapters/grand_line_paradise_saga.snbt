			rewards: [{
				id: "3EFBC4DCDC64007B"
				type: "item"
				item: {
					id: "minecraft:written_book"
					Count: 1b
					tag: {
						pages: [
							"{\"text\":\"A long, long time ago, in the North Blue, there lived a brave explorer named Mont Blanc Noland. He was known far and wide for his voyages across the seas, discovering new islands and telling amazing stories of his adventures.\"}"
							"{\"text\":\"One day, Noland returned home and told his king an incredible tale.“Your Majesty, I found an island where gold grows on trees! The city there shines with gold!”The king could hardly believe his ears.\"}"
							"{\"text\":\"Eager for riches, he ordered Noland to lead an expedition back to this “City of Gold.” After months of sailing, they finally reached the island Noland had described. But when they arrived… there was no gold.\"}"
							"{\"text\":\"No shining city, no golden trees — only a quiet forest and ruins covered in moss. The king was furious. He accused Noland of lying to him. “You deceived me, Noland! There was never any City of Gold!” Noland pleaded with him.\"}"
							"{\"text\":\" He swore that the city had been there, that he had met kind people who welcomed him — but no one believed him. The king declared that Mont Blanc Noland was a liar and sentenced him to death.\"}"
							"{\"text\":\"On the day of his execution, Noland stood tall. As the crowd jeered, he smiled and said softly: “I was not lying… I saw it with my own eyes.” As the axe fell, a faint “Gong… Gong… Gong…” echoed across the sea — the sound of a great bell ringing from far away.\"}"
							"{\"text\":\"And so ended the life of Mont Blanc Noland, the man remembered in stories as “Noland the Liar.”\"}"
						]
						HideFlags: 127
						author: "Adawi_D_Ezz"
						display: {
							Name: "{\"text\":\"Liar Noland\"}"
						}
						title: "骗子诺兰德"
						BlackBladeData: { }
					}
					ForgeCaps: {
						"customnpcs:itemscripteddata": { }
					}
				}
				only_one: true
			}]
		}
