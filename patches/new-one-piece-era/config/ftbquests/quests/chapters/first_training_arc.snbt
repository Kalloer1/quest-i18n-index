			subtitle: "进入 Blitz D. Noah 的世界"
			optional: true
			secret: true
			id: "02AD3BDF98E1BEBB"
			tasks: [{
				id: "6CB421EB3EBB4A8E"
				type: "questsadditions:playernbt"
				title: "进入 Blitz D. Noah 的世界"
				icon: {
					id: "cartaddon:giant_warrior_cape"
					Count: 1b
					tag: {
						GradeData: {
							ReappraiseUsed: 0b
							Grade: "ungraded"
							Appraised: 0b
						}
						Unbreakable: 1b
						HideFlags: 121
