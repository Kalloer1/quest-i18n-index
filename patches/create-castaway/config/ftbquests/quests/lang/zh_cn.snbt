	quest.5CCC6A34532B64CA.quest_subtitle: "&o点击查看更多信息"
	quest.5D38EE4905D25E8C.quest_desc: [
		"可以用液态经验或蛋糕来自动附魔物品，无需附魔台或书架。附魔等级取决于附魔器中存储的经验量和经验类型！"
		""
		"你可以设置过滤器，例如只获取特定工具可用的附魔，放入金靴将使用金的附魔能力，并且只允许你获得靴子附魔！"
	]
	quest.5D38EE4905D25E8C.quest_subtitle: "&o点击查看更多信息"
	quest.5E37CF10E4F02B76.quest_desc: [
		"烈焰锻造台本质上就是工业用铁砧！"
		""
		"它们能让你合并相同物品的附魔，无需修理成本，还能将附魔模板应用到工具上。"
		"或者，它们可以用来移除工具上的附魔，但与附魔台一样，运行它们也需要经验值！"
	]
	quest.5E37CF10E4F02B76.quest_subtitle: "&o点击查看更多信息"
	quest.5FE11C55340494FA.quest_desc: [
