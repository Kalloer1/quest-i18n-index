	quest.0A87644C9CD8031D.title: "精英机械装置"
	quest.0AF6615A80843315.quest_desc: [
		"爆炸只会对生物造成伤害，而不会破坏任何方块，水可以移除的方块（如高草）除外。"
		"爆炸时，它们可以点燃附近的&e苦力怕&r。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"&a蓝色炸弹&r是&a炸弹&r的更强力版本，会施加虚弱效果。"
	]
	quest.0AF6615A80843315.quest_subtitle: "一种消耗型投射物，落地后会爆炸。"
	quest.0AF6615A80843315.title: "炸弹"
	quest.0CAABC4806698C18.quest_subtitle: "总得从某个地方开始不是吗。"
	quest.0E28B98E96E95970.quest_desc: [
		"动物们害怕走上去，永远不会这样做。"
		"物品会直接从缝隙中掉落下去。"
		"玩家、怪物和其他实体将能正常穿过。"
		"格栅可以像空心原木一样钻过去。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"被拴绳拴住的动物也能正常走过这个方块。"
	]
	quest.0E28B98E96E95970.quest_subtitle: "铁格栅是一种有多种用途的新方块"
	quest.0E28B98E96E95970.title: "铁质格栅"
	quest.0EA07032EDB1BA0B.quest_subtitle: "再次召唤海洋雷暴的力量，对抗你的敌人！"
	quest.0EA07032EDB1BA0B.title: "风暴的呼啸 The Howling Of Tempest"
	quest.0EFA169E521A73F6.quest_subtitle: "施放后，你会获得“心停”效果，使你暂时免疫伤害。但该效果结束后，你将承受效果持续期间所积累伤害的50%。"
	quest.0EFA169E521A73F6.title: "心跳骤停"
	quest.0F59A4267B1D5CFB.quest_subtitle: "被囚禁者的魔法书"
	quest.0FB2FE15E5C448AE.quest_subtitle: "开始吟唱一首优美的摇篮曲，让敌人昏昏欲睡。"
	quest.0FB2FE15E5C448AE.title: "夜曲 (Serenade)"
	quest.0FF852DE33E41C90.quest_desc: ["如果你想产生巨量的电力，就需要更好的储存方式——因为光靠能量立方体&r是不够的。"]
	quest.0FF852DE33E41C90.quest_subtitle: "&8[点击阅读]"
	quest.0FF852DE33E41C90.title: "储存更多能量"
	quest.0FF9EFE394FAC822.quest_desc: [
		"染色玻璃也可以用来减弱光束的亮度。"
