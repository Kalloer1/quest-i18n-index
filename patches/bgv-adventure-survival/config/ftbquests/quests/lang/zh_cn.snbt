	quest.259CE79A1DF7326B.quest_subtitle: "富化物品提供8倍多的mb。"
	quest.26A7082E910B0A0F.quest_desc: [
		"要将物品放入管道，只需使用漏斗、投掷器或任何可用的放置物品工具即可。"
		"铜管很原始，不包含任何物品过滤或路径规划功能。物品在管道中的流动遵循几条简单的规则："
		"{@pagebreak}"
		"&6&o按顺序应用以下规则&r&r"
		"物品会尽可能向下移动。"
		"2. 物品会尽可能向前移动。"
		"3. 在十字路口，物品会随机向左或向右流动。"
		"4. 物品不会向上放置，除非没有其他可能。"
		"5. 试图进入已满容器的物品将被弹回（从管道弹回的物品会记住进入管道的方向，并会避开该方向）。"
		"物品不会流入已禁用（已激活）的管道中。"
		"物品会带着冲力从管道中落下，并进入末端开放的管道。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"&a提示：&r"
		"比较器可以读取管道中物品的数量。"
		"一次性放入15个或以上物品的管道会损坏。"
	]
	quest.26A7082E910B0A0F.quest_subtitle: "不出所料，它们能将物品从A点运送到B点"
	quest.26A7082E910B0A0F.title: "铜质管道"
	quest.26A7D1040CEE5059.quest_desc: [
		"&e本任务线深受&nBeyond The Horizons&r &e整合包的启发，"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"&n&e本系列任务几乎全部功劳归于他们！"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"感谢他们制作了如此美丽的任务线。"
	]
	quest.26A7D1040CEE5059.quest_subtitle: "内部维基页面"
	quest.26D306418545A2D6.quest_subtitle: "干得好！"
	quest.26D306418545A2D6.title: "最佳的动力来源！"
	quest.274B41069ED0CEEE.title: "钨合金盔甲"
	quest.27816321823042E7.quest_subtitle: "喷出一锥形毒雾，对范围内的生物造成伤害并施加中毒效果。"
	quest.27816321823042E7.title: "毒物喷雾"
	quest.27868C09368C8ABA.quest_subtitle: "昔日最伟大的魔法书"
	quest.281F285D738A0F88.quest_desc: ["允许你自由地在方块中穿行。"]
	quest.281F285D738A0F88.quest_subtitle: "使用时会施加 Astral 效果。"
	quest.2839D10D16E7F51E.quest_subtitle: "向任意生物施放，显示发光轮廓。完成施放将治愈该生物。"
	quest.2839D10D16E7F51E.title: "生命的祝福"
	quest.2865334DD8DAB586.quest_desc: [
		"一个物品最多可以升级3次。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"可用于任何一件盔甲上。"
		"可用于法杖上。"
		"可用于魔法书。"
	]
	quest.2865334DD8DAB586.quest_subtitle: "用于改进盔甲。"
	quest.2865334DD8DAB586.title: "升级球体"
	quest.28A02E6D1E4F5D8E.quest_desc: [
		"它的主要用途是快速切换&a箭矢&r。使用时会打开一个游戏内GUI。"
		"或者，&6Shift&r + &6右键&r也可以在不开启GUI的情况下循环切换已选中的&a箭矢&r。"
		"或者你也可以使用按键绑定来访问它。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"&e箭&r和&a你拾起的箭&r会进入你的&a箭袋&r，如果箭袋里有未装满的同种类箭。"
	]
	quest.28A02E6D1E4F5D8E.quest_subtitle: "可存放多支箭，让你可以快速更换它们。"
	quest.28EA701DD35B1776.quest_desc: ["在陆地上它会发出微光，但在水下会发出非常明亮的光芒。"]
	quest.28EA701DD35B1776.quest_subtitle: "用发光苔藓覆盖所有东西。"
	quest.298A97C5514FC738.title: "铅制盔甲"
	quest.29917D97C1EC18B7.quest_subtitle: "发射三枚撞击即爆炸的音符投射物，造成微小伤害"
	quest.29917D97C1EC18B7.title: "和弦爆破"
	quest.2997F9BE68971860.quest_subtitle: "快把你们的机械动力线缆藏起来！"
	quest.2A5715F78C57A084.quest_subtitle: "无法被活塞推动的物品"
	quest.2A5715F78C57A084.title: "坚固的石头"
	quest.2B133ADA2F4DFF4B.quest_subtitle: "地质学学生的魔法书"
	quest.2B3B25F58765A240.quest_subtitle: "自然魔法书……一只螃蟹"
	quest.2B9B38B27328BC68.quest_subtitle: "巨型史莱姆"
	quest.2BE3B14369326BB2.title: "孢子根盔甲"
	quest.2C6072220454E774.quest_desc: ["落在上面可以抵消所有坠落伤害。"]
	quest.2C6072220454E774.quest_subtitle: "超级蓬松的！"
	quest.2D3C78F4C01B420E.quest_subtitle: "这个会蜇人，小心点。"
	quest.2D78755FA6CDF5A8.quest_subtitle: "猛击地面，引发强烈地震，使远处的陆地浮出水面。"
	quest.2D78755FA6CDF5A8.title: "裂缝"
	quest.2D7D849A10F4565F.quest_subtitle: "当你的物品栏中有任何类型的爆炸物时生成。"
	quest.2D7D849A10F4565F.title: "爆破专家"
	quest.2D8B5735A8E735A5.quest_subtitle: "将你传送回出生点，如果没有则传送回世界出生点。"
	quest.2D8B5735A8E735A5.title: "召回"
	quest.2D8B8DA3C9293CCD.quest_subtitle: "发射一道缓慢的神圣能量箭。命中的生物会获得“引导”效果，使附近的投射物向其自动追踪。"
	quest.2D8B8DA3C9293CCD.title: "引导之箭"
	quest.2E274BEEF2B0B8C7.quest_desc: [
		"把硫磺粉放进这台机器里，它就会变成二氧化硫！"
		""
		"要制作三氧化物，请查看化学催化器任务链！"
		""
		"让我们开始新的mekanism任务线吧！"
	]
	quest.2E274BEEF2B0B8C7.quest_subtitle: "&8[点击阅读]"
	quest.2E2C3D02696C2298.quest_subtitle: "施放此法术可召唤出你脚下土地中的亡灵仆从。法术威力越高，它们的装备就越好。"
	quest.2E2C3D02696C2298.title: "Raise Dead"
	quest.2E758D49C2595CDB.quest_desc: ["如果不点燃，它的属性将被反转。"]
	quest.2E758D49C2595CDB.quest_subtitle: "壁灯和杠杆的结合体。"
	quest.2E758D49C2595CDB.title: "壁灯"
	quest.2E9FC7DC2AC6FD8E.quest_desc: ["核废料当然不是没用的，它们可以在同位素离心机中用来制造钚！"]
	quest.2E9FC7DC2AC6FD8E.quest_subtitle: "&8[点击阅读]"
	quest.2ECB85C6E1D49AC1.quest_subtitle: "选择一个区域，用响亮的旋律将其炸飞，造成范围伤害。"
	quest.2ECB85C6E1D49AC1.title: "盛大的结局"
	quest.2EE29A107D76ACE1.title: "花岗岩洞穴"
	quest.2EEAF9EDC2085858.quest_subtitle: "按住可释放锥形电能，对路径上的生物造成伤害。"
	quest.2EEAF9EDC2085858.title: "用闪电将生物电死，使其掉落物品。"
	quest.2EF4DD5CC254CC80.quest_subtitle: "流体传输中"
	quest.2FCB26EFFA0A534A.quest_desc: ["在砧上结合一本远古卷轴和带有该附魔的物品，将使其附魔等级提升一级，最多不超过上限。"]
	quest.2FCB26EFFA0A534A.quest_subtitle: "可用于升级附魔效果。"
	quest.2FCB26EFFA0A534A.title: "古代卷轴 (Ancient Tomes)"
	quest.305A491C2A71E0EB.quest_subtitle: "由陨星制成。收集9个可最大化你的法力值。"
	quest.305A491C2A71E0EB.title: "法力水晶"
	quest.309F3C51764B5E72.quest_subtitle: "召唤一匹会跟随你且只允许你骑乘的幽灵马。马的速度、生命值和跳跃高度随法术强度而变化。"
	quest.309F3C51764B5E72.title: "召唤马匹"
	quest.30DFF086B00CDBB2.quest_subtitle: "投掷后可在短时间内获得由神圣能量构成的翅膀，如同鞘翅一般。"
	quest.30DFF086B00CDBB2.title: "天使之翼"
	quest.320CC038A64A3195.quest_desc: [
		"激光放大器有一个面有红点——将那个面朝向激光聚焦矩阵。"
		""
		"关闭激光放大器，等待其储存至少 400 MRF&r。"
	]
	quest.320CC038A64A3195.quest_subtitle: "&8[点击阅读]"
	quest.320CC038A64A3195.title: "激光聚焦"
	quest.3233D610E0D9E119.quest_subtitle: "永久增加与方块交互的距离。"
	quest.323F14E8984D4C73.quest_desc: [
		"右键点击一个方块可将算盘绑定到该方块上。之后，看向另一个方块，它就会计算两者之间的距离。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"算盘将向上计数至48个方块，并绘制出已计数方块的外框。物品纹理会根据计数方块的数量而变化。再次右键取消绑定。"
	]
	quest.323F14E8984D4C73.quest_subtitle: "它会计算目标方块与悬停方块之间的直角距离。"
	quest.323F14E8984D4C73.title: "算盘 (Abacus)"
	quest.329FFB73701E1F1A.quest_desc: [
		"当显示一本附魔书时，一次只会显示一页内容。"
		"显示的文本分辨率取决于页面中的文本量。添加空格可以使渲染更小。"
		"接收到红石脉冲后，它将把当前显示的页面翻到下一页。"
		"可以打蜡以防止交互作用。"
	]
	quest.329FFB73701E1F1A.quest_subtitle: "可以放置和展示附魔书、地图或旗帜图案。"
	quest.329FFB73701E1F1A.title: "公告板"
	quest.33405A31D69D6D4C.quest_subtitle: "使用超过2个生命水晶后，可能会随机触发史莱姆雨。"
	quest.33405A31D69D6D4C.title: "史莱姆雨"
	quest.3341D5C8BED3A0A3.quest_subtitle: "按住以蓄力由闪电制成的长矛。松开即可像标枪一样投掷，对命中的生物造成高额伤害。"
	quest.3341D5C8BED3A0A3.title: "闪电长矛"
	quest.33447D646C027194.quest_subtitle: "施放时将末地箱中的物品整理好。"
	quest.33447D646C027194.title: "召唤末地传送门箱子"
	quest.335E7C3E45C4B2F5.quest_desc: [
		"可以填充任何类型的沙子、灰尘、粉末，甚至是史莱姆和蜂蜜。"
		"下降时间取决于所用材料的不同。"
		"可以给出一个取决于剩余时间的比较器输出。"
		"可以通过转盘旋转两次或按住 Shift 点击来重置。"
	]
	quest.335E7C3E45C4B2F5.quest_subtitle: "填满后，它将开始缓慢地向下坠落。"
	quest.335E7C3E45C4B2F5.title: "沙漏"
	quest.344D8DBF1BB57620.title: "获得一本&6烹饪指南"
	quest.346DC035C0E16986.quest_desc: ["与村民建立良好声誉，尤其是解救被Archevoker囚禁的俘虏，最终会确保有一个落入你的手中。"]
	quest.346DC035C0E16986.quest_subtitle: "一本带有小小祝福的普通书籍，是施展神圣魔法的合适媒介。"
	quest.34FCD3DCDB805845.quest_subtitle: "在目标生物周围，向所有方向生成血针领域，击落敌人并为你恢复所受伤害的25%。"
	quest.34FCD3DCDB805845.title: "针灸疗法"
	quest.357F635424C03A08.quest_subtitle: "强化你的水系法术"
	quest.3593D955361B0C6D.title: "燃料喷射器"
	quest.35A479D48C1A1B49.quest_desc: [
		"使用 Alurit 方块进行充能。"
		"最多可储存4次充能。"
		"传送会消耗一次充能次数。"
		"在16格半径的范围内有效。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"还能防止使用珍珠传送时受到的伤害。"
		"也支持紫颂果。"
	]
	quest.35A479D48C1A1B49.quest_subtitle: "如果你的末影珍珠掉在附近，它会把你传送到自己身上。"
	quest.35A479D48C1A1B49.title: "扭曲的锚点"
	quest.35EE5A9C6E88F632.quest_desc: ["可放置在与风箱接触的湿海绵旁边，使装置发出气泡粒子。"]
	quest.35EE5A9C6E88F632.quest_subtitle: "使在该方块上行走的生物会“打滑”。"
	quest.35EE5A9C6E88F632.title: "肥皂块"
	quest.3663E93E169EF8E3.quest_desc: ["将氢氟酸与氧化铀结合，制成六氟化铀。"]
	quest.3663E93E169EF8E3.quest_subtitle: "&8[点击阅读]"
	quest.3663E93E169EF8E3.title: "制作六氟化铀"
	quest.36739C1D0247B7EB.quest_subtitle: "一场猛烈的恐慌席卷而来..."
	quest.3687DB995F8352FE.quest_subtitle: "击败某个 boss 后生成。(骷髅王、眼球怪，或邪恶 boss)"
	quest.3687DB995F8352FE.title: "Dryad"
	quest.36B1995B495AA674.quest_desc: [
		"发电机会产生大量热量和危险气体。"
		""
		"请务必做好准备！"
	]
	quest.36B1995B495AA674.quest_subtitle: "&8[点击阅读]"
	quest.36B1995B495AA674.title: "Hazmat Protection"
	quest.36D7B1A3532A38C2.quest_subtitle: "进入狂热状态，向各处发送旋律，施加「引导」效果。"
	quest.36D7B1A3532A38C2.title: "奏鸣曲"
	quest.374BBD4D58045E53.quest_subtitle: "永久提高法力恢复速度。由法力水晶转化而来。"
	quest.37DB76DF7EEC9CC1.quest_subtitle: "投掷可召唤北极熊，它会跟随、保护和为你而战，还能提供坐骑。"
	quest.37DB76DF7EEC9CC1.title: "召唤北极熊"
	quest.381B0A3B808B7004.quest_subtitle: "锁定一个生物使其腐化，降低其受到的治疗效果和造成的伤害。"
	quest.381B0A3B808B7004.title: "瘟疫 (Blight)"
	quest.383B835C8F3856AB.quest_desc: [
		"食用后能让幼年动物加速成长，并使成年动物陷入爱河。使用原版冷却时间。"
		"可以用分配器放置下来。"
	]
	quest.383B835C8F3856AB.quest_subtitle: "一种分层方块，可作为自动喂养动物的方式。"
	quest.383B835C8F3856AB.title: "饲料作物"
	quest.3917E8900E28B30B.quest_desc: [
		"可将任何方块变为带框架的方块。只需点击该方块即可。"
		"使用此物品点击已放置的方块时，可以选择为其添加框架。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"用斧头攻击框架方块会破坏框架，但不会破坏里面的方块。"
	]
	quest.3917E8900E28B30B.quest_subtitle: "可以在视觉上容纳任何实心方块在内部。"
	quest.3917E8900E28B30B.title: "带框架的方块"
	quest.394EA19EBE41E6EC.quest_subtitle: "施放以选择目标，在重施放结束时，每个目标都会遭到小型火球的猛烈轰炸。"
	quest.394EA19EBE41E6EC.title: "火焰弹幕"
	quest.3999760881C855FA.quest_subtitle: "将矿石浆液转化为晶体"
	quest.39A8D5E04A738EE9.quest_subtitle: "向目标发送3次巨浪，造成范围伤害。"
	quest.39A8D5E04A738EE9.title: "海啸"
	quest.3AF4E5D4839CEF8B.quest_desc: ["铀饼可以在化学氧化器&r上使用，以生成氧化铀气体"]
	quest.3AF4E5D4839CEF8B.quest_subtitle: "&8[点击阅读]"
	quest.3AF4E5D4839CEF8B.title: "正在创建氧化铀"
	quest.3B129F26A3AA3B38.quest_subtitle: "在洞穴中发现。收集15个可最大化你的生命值。"
	quest.3B129F26A3AA3B38.title: "生命水晶"
	quest.3B2766CE93DCB42E.quest_subtitle: "阳光、水和其他因素都会影响这个过程"
	quest.3B43DB1A6B0A7B44.quest_desc: ["破碎机还可以将天然物质分解成生物燃料。"]
	quest.3B43DB1A6B0A7B44.quest_subtitle: "&8[点击阅读]"
	quest.3B43DB1A6B0A7B44.title: "生物燃料"
	quest.3B66253B6D5388FF.quest_desc: [
		"你可以在这里将卷轴喷在墨水上面。"
		"你可以在这里改进墨水。"
	]
	quest.3B66253B6D5388FF.quest_subtitle: "用于处理墨水和药水的相关操作。"
	quest.3B66253B6D5388FF.title: "炼金术士的坩埚"
	quest.3B671B30773C2FE8.title: "邪恶盔甲"
	quest.3B81800EE6E77EF2.quest_desc: [
		"我们要建造的裂变反应堆需要&e裂变燃料&r才能运行。"
		""
		"你可以按照未来的任务来学习如何制作它！"
	]
	quest.3B81800EE6E77EF2.quest_subtitle: "&8[点击阅读]"
	quest.3B81800EE6E77EF2.title: "反应堆可不是免费的"
	quest.3B8EAE4FDCA05E67.quest_desc: [
		"可以装备在左手。"
		"装备后，按下 RMB 将施放当前法术。"
	]
	quest.3B8EAE4FDCA05E67.quest_subtitle: "装备后可增强法术效果。"
	quest.3B8EAE4FDCA05E67.title: "魔法杖"
	quest.3CFCEC64A49BCF93.title: "南瓜盔甲"
	quest.3D55FE37FAD87BD4.quest_subtitle: "在你注视的方向，一团嚎叫的触手组成的斯卡尔能量爆发，伤害并致盲陷入混乱的生物。"
	quest.3D55FE37FAD87BD4.title: "潜行触手"
	quest.3D84967C158BD3F9.quest_subtitle: "每一步都会引发小规模地震，震感波及整个区域。"
	quest.3D84967C158BD3F9.title: "震颤步伐"
	quest.3DFC88D74FA0AF4D.quest_subtitle: "创造了一个可供骑乘以旅行的岩石。"
	quest.3DFC88D74FA0AF4D.title: "地震冲浪"
	quest.3DFDE5EF8EECEDDD.title: "Pre-Hardmode"
	quest.3E0E66560277E22F.quest_subtitle: "试着把一些物品扔进去看看吧。"
	quest.3E0E66560277E22F.title: "以太维度"
	quest.3EB5ACA017BACC0B.quest_desc: [
		"和&aCakes&r一样，它们只能放置后才能被吃掉。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"最多可堆叠至8个放置在一起。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"&aHoney&r can be poured on them (either via &aFaucet&r or by &6Right-clicking&r with a &aHoney Bottle&r)."
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"它们还可以接受其他配料，例如 &a巧克力&r 和 &a糖浆&r。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"&a蜂蜜、巧克力或糖浆煎饼&r食用后会获得短暂的加速效果。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"&8You can also insert a Pancake in a Jukebox for some sick tunes!&r"
	]
	quest.3EB5ACA017BACC0B.quest_subtitle: "真美味。"
	quest.3EB5ACA017BACC0B.title: "薄煎饼"
	quest.3EC9D0DA61B45328.quest_subtitle: "可以燃烧气体来产生电力！"
	quest.3F21D6AD686CABB6.quest_subtitle: "在锁着的地下城宝箱中可找到。"
	quest.3F5010269469EBE0.title: "燃料控制 (Fuel Controlling)"
	quest.3F51C96AF372AAD1.quest_subtitle: "投掷以赋予自己末地能量。在效果持续期间受到攻击时，你会立即在短半径内传送，并避免受到任何伤害。该效果在失效前只能躲避有限次数的攻击。"
	quest.3F51C96AF372AAD1.title: "回避率提升（Evasion）"
	quest.3FD2AA89BFA2228D.title: "银色盔甲"
	quest.3FFF9018DA2A2763.quest_desc: ["放射性废料桶能安全储存废料，不会造成辐射泄漏。"]
	quest.3FFF9018DA2A2763.quest_subtitle: "&8[点击阅读]"
	quest.3FFF9018DA2A2763.title: "处理核废料问题 (Dealing with Nuclear Waste)"
	quest.4047BA82FAC2DFE2.quest_desc: ["基本上就是一个模拟杠杆。"]
	quest.4047BA82FAC2DFE2.quest_subtitle: "提供一个取决于其旋转比例的变量红石信号。"
	quest.4047BA82FAC2DFE2.title: "曲柄"
	quest.407EFAF528871014.quest_desc: [
		"建造经典的无限水系统，然后抽水泵抽水泵"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"将水注入电解分离器中，即可将其分解为氢气和氧气。"
		""
		"很酷，不是吗？"
	]
	quest.407EFAF528871014.quest_subtitle: "无限水源 (Infinite Water Source)"
	quest.407EFAF528871014.title: "水源 (Water Source)"
	quest.40EA0A65E13F7EAB.quest_subtitle: "瞬间传送到你注视的方向，身后留下一个冰影。该冰影会在3秒后或受到任何伤害时破碎，向四面八方射出冰锥。"
	quest.40EA0A65E13F7EAB.title: "霜冻步伐"
	quest.4189BC3DFB551F4C.quest_desc: [
		"如果成功，你会在结构周围看到红色的粒子。"
		""
		"右键单击涡轮机以打开其界面。"
		""
		"你看到的这个屏幕会告诉你所有必要的信息。"
	]
	quest.4189BC3DFB551F4C.quest_subtitle: "&8[点击阅读]"
	quest.4189BC3DFB551F4C.title: "正在创建 Powa！"
	quest.41DA0E6E81B76A2A.quest_desc: ["根据方块重量发出红石信号。"]
	quest.41DA0E6E81B76A2A.quest_subtitle: "称量其上方的方块重量。"
	quest.41E2793CBA650317.quest_subtitle: "富化物品提供8倍多的mb。"
	quest.4236B9F071BE18F3.quest_desc: ["往这台机器里注水，它就会把水变成硫酸 :D"]
	quest.4236B9F071BE18F3.quest_subtitle: "&8[点击阅读]"
	quest.4236B9F071BE18F3.title: "正在生成硫酸"
	quest.424D9A1DF04F1901.quest_desc: [
		"投射物方块会在合适的位置自行放置。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"附魔了&3Stasis&r的&aSlingshot&r将能沿直线发射，不受重力影响，并且会获得一个白色方块轮廓，用以显示弹道落点。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"可附魔&3快速装填&r、&3多重射击&r和&3停滞&r。"
	]
	quest.424D9A1DF04F1901.quest_subtitle: "一种可以发射方块的工具！"
	quest.424D9A1DF04F1901.title: "弹弓"
	quest.42E25D5496D50F91.title: "极限等级"
	quest.42E62E00C6E77055.quest_subtitle: "在目标生物周围一定半径内，或无目标生物时在你周围，施加加速效果，提升移动速度、攻击速度、挖掘速度、法力再生和施法速度，持续一段时间。"
	quest.42E62E00C6E77055.title: "急迫效果"
	quest.43509DD908BC6584.title: "腐化沙漠"
	quest.43622B9C5F726DAE.quest_subtitle: "当你的物品栏中有任何类型的染料时生成。"
	quest.43622B9C5F726DAE.title: "染料商人"
	quest.4434D7B66521D69A.quest_subtitle: "气体传输中"
	quest.44520E291F8088B3.quest_desc: [
		"如果在已充能的Lumiere方块上方放置另一个方块，充能会转移到上方的方块并使其发生变化。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"目前正在使用 &a鹅卵石&r、&a红沙&r和&a花岗岩&r。"
	]
	quest.44520E291F8088B3.quest_subtitle: "被闪电击中的 Lumiere 方块会被充能。"
	quest.447E43546836726D.quest_subtitle: "通过对其应用灵魂绑定效果来增强物品。"
	quest.447E43546836726D.title: "保留的效果 Preserved effect"
	quest.44BD776617D0E432.quest_subtitle: "吐出一团酸液，撞击时向周围溅射，撕裂被击中的生物，融化并削弱它们的护甲。"
	quest.44BD776617D0E432.title: "酸性唾液"
	quest.44E7ADBFDC06294C.quest_desc: [
		"下雨时，它会发出强度为1的信号。"
		"在雷鸣中 - 威力为 2 的情况下。"
		"同时为下方的方块提供强大的电力。"
	]
	quest.44E7ADBFDC06294C.quest_subtitle: "根据当前天气进行摆动并输出红石信号，信号强度取决于当前天气。"
	quest.44E7ADBFDC06294C.title: "风向标"
	quest.4543C4031E097D37.quest_subtitle: "但它是怎么飞的呢？嗯mmmm"
	quest.454ABA82D2C0F1CB.quest_subtitle: "发射一枚直线投射物，使目标获得「引导」效果。"
	quest.454ABA82D2C0F1CB.title: "Clef"
	quest.455AB40E9A8F4641.quest_desc: [
		"它们可以被活塞或装置推动，并且在伸出时击中物体将造成&4额外伤害&r。"
		"可以用&9滞留药水&r进行充能。方法有：合成、点击或使用水龙头倒入药水。"
		"它们只能接受负面滞留药水，并且充能无限。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"竹尖算作&6玩家击杀&r，即生物被竹尖杀死时会像被玩家杀死一样掉落战利品和经验。"
	]
	quest.455AB40E9A8F4641.quest_subtitle: "会减缓并伤害所有踩上它们的生物的尖刺。"
	quest.4571B69D0EC1EFA6.quest_subtitle: "在目标生物或方块周围，召唤一个会落地爆炸的苦力怕头颅环。被此爆炸杀死的任何生物都会召唤另一个更小的苦力怕头颅环。此过程可多次连锁。"
	quest.4571B69D0EC1EFA6.title: "连锁苦力怕"
	quest.45B0F474AEFD7D03.quest_subtitle: "在女王蜜蜂被击败后生成。"
	quest.45B0F474AEFD7D03.title: "巫医（Witch Doctor）"
	quest.45CFC15687CF67EB.quest_subtitle: "最坚固的困难模式前盔甲。"
	quest.45CFC15687CF67EB.title: "熔岩盔甲"
	quest.45E6458B285449BD.quest_desc: [
		"被活塞推动时，它能与任何完整的铁质方块摩擦以产生火花。"
		"附近有易燃方块就会点燃！这样就能拥有一个按需使用的、持续时间无限的打火石和钢。"
		"相反方向也同样有效，也就是说你可以将铁块移向燧石块。"
		"这些交互也适用于 Quark 磁铁。"
	]
	quest.45E6458B285449BD.quest_subtitle: "一种装饰和储物方块，可以用来存放多余的燧石。"
	quest.4611B5928DD052D0.quest_subtitle: "最坚固的困难模式前镐子。"
	quest.4611B5928DD052D0.title: "Molten Pickaxe"
	quest.461EF28E672C91B4.quest_subtitle: "在维度之间切换视野，获得看穿实体材料的能力。"
	quest.461EF28E672C91B4.title: "Planar Sight"
	quest.46436CC5A0CC1620.quest_subtitle: "高伤害-高攻速-低法力消耗。"
	quest.46436CC5A0CC1620.title: "被侵蚀的巨石"
	quest.46B574404FE263A6.quest_subtitle: "按住以蓄力一支由神秘能量制成的穿刺箭。此箭不受重力影响，可穿透方块。"
	quest.46B574404FE263A6.title: "魔法箭矢"
	quest.46DD3030E8CA8FDC.title: "铜质盔甲"
	quest.46FEC22AA8E22243.quest_subtitle: "从选定的生物开始连锁闪电，让闪电魔法波向附近的生物扩散。"
	quest.46FEC22AA8E22243.title: "连锁闪电"
	quest.470EBDD4D98FCA2D.quest_desc: ["如果&eSparkle&r附近有&aAmethyst&r、&aAllurite&r或&aLumiere&r Cluster，&eSparkle&r会咬住它，形成&aGlinted&r版本。"]
	quest.470EBDD4D98FCA2D.quest_subtitle: "它们是由于 Sparkles 吃了普通水晶而产生的。"
	quest.470EBDD4D98FCA2D.title: "闪烁的簇矿块"
	quest.47106CE1937C4340.quest_desc: [
		"将3个HDPE颗粒放入腔室，你就可以制作一张HDPE板了！"
		""
		"HDPE 被用于许多机器和模块中。"
	]
	quest.47106CE1937C4340.quest_subtitle: "&8[点击阅读]"
	quest.47106CE1937C4340.title: "HDPE 板材"
	quest.471B71349DCAACD2.quest_subtitle: "选定目标，反复施放法术以增强效果，计时器结束后，目标将爆炸出水，造成高额伤害。"
	quest.471B71349DCAACD2.title: "珊瑚屏障"
	quest.47C30081A67E0ADA.quest_subtitle: "用水抓住敌人，将他们拉向你，然后挥出重拳。"
	quest.47C30081A67E0ADA.title: "潮汐之握"
	quest.47E6BAC77BA59093.quest_subtitle: "在指定位置周围，创造一个通往虚空的裂口，显现出一个黑洞，将附近的生物吸入并缓慢压死。"
	quest.47E6BAC77BA59093.title: "黑洞"
	quest.47EDA1B3F3EDCA4A.quest_subtitle: "永久增加生命。由生命水晶转化而来。"
	quest.48757D67DD68152C.quest_subtitle: "用黑曜石制作的压力板，只有在玩家踩上去时才会被触发"
	quest.48757D67DD68152C.title: "黑曜石压力板"
	quest.488DBE69595F38F8.quest_desc: ["这台机器就像熔炉一样能熔炼物品……太棒了。"]
	quest.488DBE69595F38F8.quest_subtitle: "&8[点击阅读]"
	quest.48BDB945BADC87E1.quest_subtitle: "自动向敌人发射大量水导弹，精准锁定目标。"
	quest.48BDB945BADC87E1.title: "水色导弹"
	quest.48CBE8361506CA28.quest_desc: ["要升级容量，请在&b秘法砧&r上组合一个&a法术书&r和&a任意法术槽改进件&r。"]
	quest.48CBE8361506CA28.quest_subtitle: "提升了魔咒书的容量，最多可达15个槽位！"
	quest.48CBE8361506CA28.title: "法术槽改进"
	quest.48E7A868AB26C5EE.quest_subtitle: "学习水的力量"
	quest.48FDBB568F3CC566.quest_subtitle: "Geo符文专注于群体控制，用整块拖把造成高额伤害 :D"
	quest.49184739FC23FA4D.quest_subtitle: "按住可释放锥形冷能，冻结路径上的生物。"
	quest.49184739FC23FA4D.title: "冰冷之锥"
	quest.494E6BECABCCEB76.quest_subtitle: "用来熔炼你的新矿石。"
	quest.498C3B31F012D5CD.quest_desc: [
		"可以在&a铁砧&r中重命名，以更改聊天中显示的名称。将其重命名为“”可完全移除名称。"
		"要发送消息，方块前必须有空格。"
	]
	quest.498C3B31F012D5CD.quest_subtitle: "激活后，向一定半径内的所有玩家发送聊天消息。"
	quest.498C3B31F012D5CD.title: "扬声器方块"
	quest.4A068451F0E7EA88.quest_subtitle: "在目标生物周围一定半径内，对敌人施加减速效果，降低其移动速度、攻击速度、挖掘速度、法力再生速度和施法时间。"
	quest.4A068451F0E7EA88.title: "缓慢"
	quest.4A790C7B4E7C9A44.quest_subtitle: "发射出冰锥形态的穿透性冷能箭矢，冻结其接触到的目标。"
	quest.4A790C7B4E7C9A44.title: "冰柱"
	quest.4A870C4840BCE3F0.quest_subtitle: "用于烹饪食物。点击箭头查看所有食谱！"
	quest.4A870C4840BCE3F0.title: "使用一个烹饪锅"
	quest.4ABF0727AA569DD9.title: "氘气"
	quest.4AECEACACE5CB6C4.quest_subtitle: "在你注视的方向召唤出一把幽灵锤，它能将击中的所有相连石质方块挖掘殆尽，只留下矿石和碎石。"
	quest.4AECEACACE5CB6C4.title: "光谱之锤"
	quest.4AF1221240DF4D9A.quest_subtitle: "用于熔炼地狱岩。可在下界塔中找到。"
	quest.4AFF81D3D0E78255.quest_subtitle: "清洗矿石"
	quest.4B36949CD065FCBB.quest_subtitle: "旋转任何可旋转的方块类型。"
	quest.4BCD611B86666C7D.quest_subtitle: "烹饪一顿丰盛的佳肴！"
	quest.4BFDA5F2D03EFA98.quest_desc: ["与 Mojang 版本略有不同，因为这是在快照发布前制作的。"]
	quest.4BFDA5F2D03EFA98.quest_subtitle: "1.21快照中合成台的向后兼容版本"
	quest.4BFDA5F2D03EFA98.title: "合成台"
	quest.4C79D6F8D13ED84E.quest_subtitle: "演奏一段短小旋律，召唤鸟类并大幅增益使用者。"
	quest.4C79D6F8D13ED84E.title: "狂想曲"
	quest.4D72FD556B89A6E9.quest_subtitle: "骷髅王可以在地牢中找到。在夜间与老人交谈即可召唤他。"
	quest.4D73B88DDA7AE158.quest_desc: [
		"如果末地传送会导致目标被放置在 Myalite Viaduct 上，那么目标将降落在该高架桥的另一端。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"长度超过24格或会导致循环的拱桥是非法的，末地传送将正常工作。"
		"在分叉处，目的地会随机选择。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"高架桥可以用活塞来移动。"
	]
	quest.4D73B88DDA7AE158.quest_subtitle: "Myalite Viaducts 会重定向由末影珍珠或末影人传送引起的末地传送"
	quest.4D73B88DDA7AE158.title: "Myalite 高架桥"
	quest.4DBFF18C1E2E8B36.quest_desc: [
		"使用邪典卷轴学习邪典法术"
		"{image:irons_spellbooks:item/eldritch_manuscript width:32 height:32 align:center}"
		""
		""
	]
	quest.4DBFF18C1E2E8B36.quest_subtitle: "邪典学派与其他学派不同。它是一种古老而强大的魔法，几乎已被遗忘"
	quest.4DBFF18C1E2E8B36.title: "克苏鲁魔法"
	quest.4DC9E88A5EE200B6.quest_subtitle: "按住可向前喷出锥形龙息。每次击中生物时，有几率在其脚下生成一滩龙息。"
	quest.4DC9E88A5EE200B6.title: "龙之息 (Dragon Breath)"
	quest.4DE794DE317DF3B3.quest_subtitle: "召唤一个缓慢前进的闪电球，它会穿过生物造成伤害并从方块上反弹。"
	quest.4DE794DE317DF3B3.title: "球状闪电"
	quest.4DF782D7E2E59DAF.quest_desc: [
		"若附魔了&3Stasis&r，它就能在瞄准的任何空中位置放置&aSoap Bubble Blocks&r。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"方块会悬浮在空中一段时间，或者直到被踩到为止。"
		"&aSoap Blocks&r 可以被其他方块替换，这在建造时非常有用。"
	]
	quest.4DF782D7E2E59DAF.quest_subtitle: "一个有趣的道具，可以用来向朋友们吹肥皂泡。"
	quest.4DFC015406B24BD2.quest_desc: [
		"可显示和存储3行文本。"
		"猫有时会坐在上面。"
		"可以在其下方隐藏一件物品。为此，请按住 Shift 键并点击除顶部以外的任意一面。"
	]
	quest.4DFC015406B24BD2.quest_subtitle: "欢迎回家。"
	quest.4E0115408D173351.quest_desc: ["附加的凳子特性包括可以在上面放置方块，凳子会随之变大，并且即使被活塞推动也能保持在上面。"]
	quest.4E0115408D173351.quest_subtitle: "不出所料，你可以坐在它们上面！"
	quest.4E0115408D173351.title: "凳子"
	quest.4E79F6590377F266.quest_desc: [
		"可以直接用于世界中的所有生物和方块。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"可用于&a铜类方块&r，一次性清除所有蜡和氧化层。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"可用于&e宠物&r和&e绵羊&r，为它们取消洗毛效果。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"还可以洗掉 &a黑板&r、&a古董地球仪&r和&a地图&r、&a粘性活塞&r和&a附魔尖刺&r。"
	]
	quest.4E79F6590377F266.quest_subtitle: "将物品恢复到默认或白色状态。"
	quest.4E864208804FBA46.quest_subtitle: "投掷以注入神圣能量，并立即恢复生命值。"
	quest.4E864208804FBA46.title: "治疗"
	quest.4EA50CAF62FCD50A.quest_subtitle: "在法术效果持续期间，非魔法攻击会留下末影能量的余波，随后以原攻击伤害的余波形式爆炸。"
	quest.4EA50CAF62FCD50A.title: "回响打击"
	quest.4EDD96EB60EF5814.quest_subtitle: "产生更多的电力！"
	quest.4F1C04C0F6769825.quest_subtitle: "将3个原始矿石转化为8个矿石碎片"
	quest.4F436770D30D8520.quest_desc: ["需要硫酸将矿石变成矿浆！"]
	quest.4F436770D30D8520.quest_subtitle: "&8[点击阅读]"
	quest.5047792C6EF6D2AD.quest_desc: ["当生物燃料在加压反应室中与水和氢气混合时，会产生底物。"]
	quest.5047792C6EF6D2AD.quest_subtitle: "&8[点击阅读]"
	quest.5047792C6EF6D2AD.title: "基座材料"
	quest.50BA6B940B1C9527.quest_subtitle: "选定一个区域，在法术持续时间内，从上方持续降下奥术彗星。"
	quest.50BA6B940B1C9527.title: "星落如雨"
	quest.50DE6E1A25DBEAC4.quest_desc: ["默认情况下，&a下界合金门&r在首次上锁前，任何人都可以进入。"]
	quest.50DE6E1A25DBEAC4.quest_subtitle: "可用钥匙上锁。完成后，只有钥匙持有者才能与门互动。"
	quest.50DE6E1A25DBEAC4.title: "下界合金门"
	quest.5172CA2473AF4E7A.quest_subtitle: "在地下城中被发现。"
	quest.5172CA2473AF4E7A.title: "机制说明"
	quest.5227EAB65D2DDAD7.quest_desc: [
		"最多可存储 12 个饼干类物品。"
		"和笼子一样，它可以储存和捕捉小型生物。"
		"罐子最多可储存 12 个瓶子（或 3k mb）的液体。"
		"可以直接饮用罐子中的内容物，无论是物品还是方块形态。"
	]
	quest.5227EAB65D2DDAD7.quest_subtitle: "可以存储饼干类物品和流体。"
	quest.52722741E16ADD55.quest_subtitle: "投掷火球，撞击时爆炸并造成巨额伤害。"
	quest.52722741E16ADD55.title: "火球术"
	quest.52B6BBD4B11D3FC7.quest_desc: ["默认情况下是开启的。"]
	quest.52B6BBD4B11D3FC7.quest_subtitle: "发出的光亮与其当前的红石能量成反比。"
	quest.52B6BBD4B11D3FC7.title: "红石照明器"
	quest.52B98FB81E05F53B.quest_subtitle: "闪电学派的核心是集中伤害。"
	quest.52B98FB81E05F53B.title: "闪电魔法"
	quest.52C7C09BB8289628.quest_subtitle: "血魔法学派以邪恶为主题，包含亡灵、凋零和血魔法元素，法术侧重于增强施法者的伤害。"
	quest.52C7C09BB8289628.title: "血魔法"
	quest.531E3FF1F2865C67.quest_subtitle: "热量传递中"
	quest.535E4493E31C40F9.quest_desc: [
		"可通过红石信号或按 RMB 键开启/关闭。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"若放置在流体容器方块旁，激活时会显示一个流体托盘在其正下方。"
		"可从下方物品栏中提取物品，并以一秒的间隔从喷嘴下方直接倾倒出来。"
		"一旦连接到身后的流体容器方块，它就能将流体倒入下方的任何流体容器方块中。此操作仅以250mb为单位进行。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"还可以与下方的方块互动，如混凝土粉、泥土（会变成泥）和糖块。"
		"可将流体倒入海绵中有效清空。熔岩桶也能做到这一点，是理想的“垃圾桶”解决方案。"
	]
	quest.535E4493E31C40F9.quest_subtitle: "功能强大的多功能方块。"
	quest.535E4493E31C40F9.title: "水龙头"
	quest.539DF0D4702A77F9.quest_subtitle: "在你周围投下光明的风暴，创造一道防御性墙壁。"
	quest.539DF0D4702A77F9.title: "太阳风暴"
	quest.53A61B0852F62612.title: "发光蘑菇原野"
	quest.53B561A1AFD1FE0E.quest_desc: [
		"如果你向下看 - 会在你周围生成柱子。"
		"看向侧面 - 会在你视线的方向上创建一长排柱子。"
	]
	quest.53B561A1AFD1FE0E.quest_subtitle: "生成能对敌人造成伤害的柱子。"
	quest.53DC9A5CF68C84D5.quest_desc: [
		"墨水的质量会影响所制作卷轴的威力。"
		"有些卷轴只需要高品质的墨水。"
		""
		"它们也是可以合成的！"
	]
	quest.53DC9A5CF68C84D5.quest_subtitle: "用于制作魔法卷轴。"
	quest.53DC9A5CF68C84D5.title: "墨水类物品"
	quest.53FE99A7964783F7.quest_subtitle: "部分被转化的物品可以提供永久增益。"
	quest.54922EBD779EF184.quest_subtitle: "选择一个魔法召唤物使其爆炸，可立即将其击杀，并对周围区域造成大量伤害。召唤物剩余的生命值会提升造成的伤害和爆炸半径。"
	quest.54922EBD779EF184.title: "献祭"
	quest.54A40A2595B71613.quest_subtitle: "现在你可以在下界开采地狱岩了。"
	quest.54A40A2595B71613.title: "邪恶的镐子"
	quest.54FA294EAFF09CCF.quest_subtitle: "末影学派的主题围绕所有神秘和玄奥的事物，法术涵盖伤害、辅助和机动性。"
	quest.54FA294EAFF09CCF.title: "末地魔法"
	quest.55C80A1A9A0C7EF2.quest_desc: [
		"可以移动任何实体（物品、怪物、玩家等）"
		"此外，实体在与 &aStranded Membrane Block&r 互动时会失去吸引力。"
	]
	quest.55C80A1A9A0C7EF2.quest_subtitle: "与它接触的物品会被它推动。"
	quest.5610804960A23D97.quest_desc: [
		"一旦供电，它将开始旋转，所需时间取决于接收到的信号强度。"
		"无论方块是否通电，旋转动作都会继续，这可以通过方块上的红灯指示。"
		"旋转频率（或实体的速度）取决于方块的红石能量。"
		"旋转周期在15功率下为4刻，随功率线性增加，在1功率下达到60刻。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"右键单击方块可切换旋转方向。"
		"旋转任意物品栏方块的水平轴时，可打乱物品栏内容。"
		"还会持续旋转站在上面的实体（仅在朝上时有效）。"
	]
	quest.5610804960A23D97.quest_subtitle: "旋转方块。"
	quest.5610804960A23D97.title: "旋转台"
	quest.5626E43438CCA6BF.quest_desc: [
		"所有基础&3法术书&r都可以通过原版和神秘材料的组合来制作。"
		"制作的下一个等级会提升魔导书的槽位数量，并通常附带额外加成，从而增加其所能容纳的魔法数量和强度。"
	]
	quest.5626E43438CCA6BF.quest_subtitle: "可以储存多个法术。"
	quest.5626E43438CCA6BF.title: "基础魔法书系列"
	quest.5682C80C63F1A63B.quest_subtitle: "在地下城中击败母史莱姆，找到一把金钥匙。"
	quest.56C07209A8A2139E.quest_subtitle: "发射一道浓缩的奥术魔法。这也是每位巫师的特点。"
	quest.56C07209A8A2139E.title: "魔法飞弹"
	quest.56EED3C96B90A092.quest_desc: [
		"可通过红石、右键或踩踏来为其供电。"
		"通电时，会以与其红石功率成正比的频率向前方推动空气。此处描述的所有效果都会受到此影响。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"推动空气时，会将前方的实体推开，最远可达5格距离。"
		"加速与其相邻的熔炉类方块的工作速度。"
		"刷新前方的火方块。距离不超过2格的火方块将无限期保持点燃状态。"
		"若放置于另一个铜块旁，可加速铜的氧化。"
		"如果将它们放在与肥皂块接触的湿海绵前面，它们就能吹出泡泡！"
	]
	quest.56EED3C96B90A092.quest_subtitle: "在它的前面推动空气。"
	quest.56EED3C96B90A092.title: "风箱"
	quest.57534FA0E09C4975.title: "氚气"
	quest.5770F573AA23753B.quest_subtitle: "当你的物品栏中有50枚或以上银币时生成。"
	quest.5770F573AA23753B.title: "商人"
	quest.57FD7ECA30255C9C.quest_subtitle: "仅限困难模式"
	quest.58275DB6DF066451.quest_desc: [
		"用起来很简单，只要给一个供电，它就能给相邻的齿轮供电，最远可达14格，就像&a红石粉&r一样。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"这东西的真正用途是制作紧凑的垂直红石信号系统。"
	]
	quest.58275DB6DF066451.quest_subtitle: "以实体方块的形式，起到升级版红石的作用。"
	quest.58275DB6DF066451.title: "齿轮方块"
	quest.587A19FC348387C5.quest_subtitle: "将气体、固体物品和液体结合，以产生物品和副产品。"
	quest.587C0FA60280A1D6.quest_subtitle: "用深渊的阴影将自己笼罩，短时间内获得躲避任何攻击的能力。"
	quest.587C0FA60280A1D6.title: "深渊面纱"
	quest.588B720757D1CAB7.quest_desc: ["用这张桌子，你可以把找到的卷轴刻录到你的法术书里。"]
	quest.588B720757D1CAB7.quest_subtitle: "在这里将你的技能添加到书中！"
	quest.588B720757D1CAB7.title: "铭文台 Inscription Table"
	quest.58A1874E6C623430.quest_subtitle: "凝聚一股电力浪潮，释放出毁灭性的冲击波，轰炸暴露在外的生物。"
	quest.58A1874E6C623430.title: "冲击波"
	quest.58B125BD4876054C.quest_desc: ["&eMekanism 是一个包含大量新科技可供探索的模组！"]
	quest.58B125BD4876054C.quest_subtitle: "&8[点击阅读]"
	quest.58B125BD4876054C.title: "&dMekanism"
	quest.58E5EFC45AFAD32C.quest_subtitle: "发送一大团水两次。"
	quest.58E5EFC45AFAD32C.title: "水箭发射器"
	quest.58EA172C09EFECF8.quest_subtitle: "在空岛群系中生成。"
	quest.592E74E7C40A121B.quest_desc: [
		"一旦物品被取走或移走，基座方块会发出观察者可检测到的更新。（如果用袋子替换物品，可以阻止这种情况）"
		"将末地水晶放置在基座上，该方块会释放出相当于3个书架的附魔之力。这意味着用5个这样的方块，你就能将附魔台升到最高级。"
	]
	quest.592E74E7C40A121B.quest_subtitle: "能精美地展示放置在其上的物品。"
	quest.592E74E7C40A121B.title: "基座"
	quest.5A90614017127E27.quest_subtitle: "只是一直乱点而已"
	quest.5B681BC43371CC5C.quest_subtitle: "正在传输物品"
	quest.5BA5CC9E9BA67619.quest_subtitle: "在选定的生物或方块上方召唤一个巨大的冰块。短暂延迟后，冰块会坠落并爆炸，对沿途击中的生物造成额外的霜冻伤害。"
	quest.5BA5CC9E9BA67619.title: "冰块"
	quest.5BF66A8EB5C27D54.quest_subtitle: "发射一道冷能量束，伤害较低，但能立即对命中的生物施加冰冻效果。"
	quest.5BF66A8EB5C27D54.title: "冰霜射线 (Ray Of Frost)"
	quest.5CEFFF208E32B13B.quest_subtitle: "创建时生成于世界中。"
	quest.5CEFFF208E32B13B.title: "指南"
	quest.5D067FAC251C86B6.quest_subtitle: "释放出火焰魔法的冲击波，点燃并撕裂你周围半径内的生物。被撕裂的生物护甲会降低。"
	quest.5D067FAC251C86B6.title: "热量激增"
	quest.5D286DE552DE2DCE.quest_subtitle: "在水下时，召唤伟大的破船者作为伙伴，主宰海洋。"
	quest.5D286DE552DE2DCE.title: "深渊的回响"
	quest.5D6C631FD3A70027.title: "陨石盔甲"
	quest.5D7F9483DAD48944.quest_desc: [
		"{image: width:100 height:100 align:center}"
		"{image: width:100 height:100 align:center}"
	]
	quest.5D7F9483DAD48944.quest_subtitle: "当你的生命值超过20时生成。"
	quest.5D7F9483DAD48944.title: "护士"
	quest.5DF5D88625C2AC31.quest_desc: ["随时随地烹饪。将食物放在副手，靠近热源后右键煎锅！"]
	quest.5DF5D88625C2AC31.quest_subtitle: "&8[点击阅读]"
	quest.5DF5D88625C2AC31.title: "制作一个煎锅 (skillet)"
	quest.5E0E022DB608FFC1.quest_desc: [
		"云层高度为 192-196。"
		"右键点击瓶装云，可以在你面前生成一个漂浮在空中的（非实体）方块。"
		"云块会在几秒后消失，但你可以用其他方块右键点击它来替换这两个方块。"
		"当你这样做时，云就会回到瓶子里面去。"
	]
	quest.5E0E022DB608FFC1.quest_subtitle: "在云层高度使用玻璃瓶，可以获得瓶装云。"
	quest.5E0E022DB608FFC1.title: "瓶装云朵"
	quest.5E6F3BC05F4BF11E.quest_subtitle: "向目标快速投掷小型滴水石锥，穿透目标。"
	quest.5E6F3BC05F4BF11E.title: "滴水石锥箭矢"
	quest.5ED9CA7C6BFDA5FE.quest_desc: [
		"可用于任何&a告示牌&r，将其字体更改为华丽的 Antiquable 字体。"
		"可以用一张 &aMap&r 将其制作成 &aAntique Map&r，使其看起来像一张藏宝图。"
		"可以用&a原始书写本&r来制作成&a破旧书本&r。 &a破旧书本&r无法被复制，并且会使用Antiquable字体。"
	]
	quest.5ED9CA7C6BFDA5FE.quest_subtitle: "更改与其交互的物体的字体。"
	quest.5EFDC9F7CE8F828E.quest_subtitle: "释放一圈火焰，发动横扫的近战攻击。此法术不可中断。伤害取决于你手持武器的近战伤害和附魔效果。"
	quest.5EFDC9F7CE8F828E.title: "火焰打击"
	quest.5FAA422D8C1B5A03.quest_subtitle: "事件是各种特殊敌人会刷出的临时场合。有些在游戏过程中随机发生，而另一些则可以通过特定物品触发。"
	quest.5FAA422D8C1B5A03.title: "事件"
	quest.5FBE30F3D425C434.quest_subtitle: "在烈焰中快速向前冲刺，灼烧沿途遇到的生物。"
	quest.5FBE30F3D425C434.title: "燃烧冲刺"
	quest.5FFC7A8048BC650C.quest_subtitle: "神圣学派专注于为盟友提供支援、治疗和增益效果。"
	quest.5FFC7A8048BC650C.title: "神圣魔法"
	quest.603877AB96321F1A.quest_desc: [
		"你要建造的第一个多方块结构……祝你好运。"
		""
		"要开始，建造一个4x3x4的结构，但中间部分要留空。地基除外。"
	]
	quest.603877AB96321F1A.title: "水会变成盐水溶液"
	quest.60900097890FB07F.quest_desc: [
		"制作红宝石激光，以探测其路径上的实体和方块。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"除非你头上戴着红宝石透镜，否则它的光束是看不见的。"
		""
		"或者，将玻璃直接放在红宝石激光器前方，使其光束可见。"
		"彩色玻璃会改变激光束的颜色。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"其方块产出与方块或实体之间的距离成反比。"
		""
		"激光束会检测方块碰撞箱。右键激光可将其设为着色模式，使其仅检测方块而非实体。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"将染色玻璃放置在激光路径上会缩短其范围，而不会产生红石信号。目前仅适用于染色模式。"
	]
	quest.60900097890FB07F.quest_subtitle: "使用光学装置检测实体"
	quest.61157EAD05B7BEF7.quest_subtitle: "要获得肥沃的土壤"
	quest.61157EAD05B7BEF7.title: "有机堆肥"
	quest.6131E8F6BB66D018.quest_subtitle: "永久提升防御力。由生命果实转化而来。（无法获取）"
	quest.620F28744112E423.quest_subtitle: "放置后会变为隐形的特殊方块。（开发中）由潜声方块转化而来。"
	quest.6254BF972CEE2800.quest_subtitle: "现在你可以在下界开采地狱岩了。"
	quest.6313B18820445882.quest_desc: [
		"工业涡轮机&r能将热能转化为电能，但它比这更先进。"
		""
		"最小可建造尺寸为 5x5x5，最大尺寸为 17x17x18。"
		""
		"建议你去看看教程视频！"
	]
	quest.6313B18820445882.quest_subtitle: "如何建造？"
	quest.6313B18820445882.title: "工业涡轮机"
	quest.639FF6600F71C061.quest_desc: [
		"基础材料，基本上是这个模组的开端。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"了解基础知识后，请选择一个职业并继续前进。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"可在废弃建筑中零星发现。"
		"使用魔法的敌人也会掉落该物品。"
	]
	quest.639FF6600F71C061.quest_subtitle: "基础材料。"
	quest.63AE0CD914FC7733.quest_desc: [
		"一叠物品会占用 64 个，但 64 种不同的物品也会占用同样的空间。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"这使得木箱不适合存放大量物品，但非常适合将多种多样的物品存放在一处，或收集无法堆叠的物品。"
	]
	quest.63AE0CD914FC7733.quest_subtitle: "可容纳最多 640 个物品的替代存储方块"
	quest.63AE0CD914FC7733.title: "储物箱"
	quest.64BF6DE048AC21AA.quest_desc: ["{@pagebreak}"]
	quest.64BF6DE048AC21AA.quest_subtitle: "释放一连串的烈焰火球，它们会快速而狂野地射向你的前方，点燃任何被命中的生物或方块。"
	quest.64BF6DE048AC21AA.title: "烈焰风暴"
	quest.6513BA0C36AE8C4F.quest_subtitle: "永久提升钓鱼技巧。由金虫转化而来。"
	quest.658C312ACFA0115A.quest_desc: [
		"由Evoker或其更强大的施法表亲Archevoker掉落。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"书中的法术已被锁定，但可以改进。"
		"将咒语书中的咒语卷轴与同咒语的高阶卷轴在奥数砧上结合。"
	]
	quest.658C312ACFA0115A.quest_subtitle: "一本充满基础幻魔魔法的书"
	quest.65B70A8030FC464D.quest_desc: [
		"因为 Linggango 是一个非常大的整合包，所以大家可能以为我会跳过那些小内容……"
		""
		"错了！模组包里几乎所有提升游戏体验的东西都在这里了 :D！"
	]
	quest.65B70A8030FC464D.quest_subtitle: "一大堆东西……"
	quest.65B70A8030FC464D.title: "神圣的生活质量改进！"
	quest.66498B8F31BD431F.quest_subtitle: "重新施放以放置锚点，施放完毕或达到最大长度时会爆发出火墙。该墙能阻挡投射物并点燃穿过它的生物。"
	quest.66498B8F31BD431F.title: "火焰之墙"
	quest.6694C9D2E4D4727E.quest_subtitle: "当你的物品栏中有子弹或枪时生成。"
	quest.6694C9D2E4D4727E.title: "武器商人"
	quest.673FCBF8685D0EEE.quest_desc: [
		"Mekanism 的多方块结构建造方式也类似。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"你需要建造一个长方体形状的建筑。"
		""
		"-边缘必须由 Induction Casings&r 制成。"
		""
		"-侧面（面）可以由 Induction Casings&r、Structural Glass&r 或 Induction Ports&r 制成。"
		""
		"建议准备两个感应端口&r——一个用于输入，一个用于输出。"
		""
		"-你可以使用配置器&r将端口在输入和输出之间切换。"
	]
	quest.673FCBF8685D0EEE.quest_subtitle: "&8[点击阅读]"
	quest.673FCBF8685D0EEE.title: "建造感应器装置 The Induction"
	quest.691DBC8F10CA39C4.title: "铂金盔甲"
	quest.699182EA223BDA47.quest_desc: [
		"比原版&aPiston-Slime Block装置&r强大两倍。"
		"如果你从一定高度落在已经伸出的它上面，它还能把你推上去。"
		"无法像普通&a活塞&r一样推动方块，只能推动&e实体&r。"
		"允许站在加长方块上的&e实体&r跳得更高一点。"
	]
	quest.699182EA223BDA47.quest_subtitle: "它会像活塞一样伸出，并将任何位于其上的实体推向移动方向。"
	quest.699182EA223BDA47.title: "Spring 启动器"
	quest.699C8E14223E8223.quest_desc: ["如果使用合适的补救措施，这本书或许能被重新祝福。"]
	quest.699C8E14223E8223.quest_subtitle: "腐坏的魔咒书中仍然残留着强大的魔法能量。"
	quest.6A111AA679FD828A.quest_desc: [
		"时针显示当前游戏内的小时，而分针则每秒跳动一次。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"其输出可通过比较器读取，该比较器会发出从0到15的信号，与游戏内时间（0到24）成正比。"
		"每过一小时游戏时间，就会发出一个能被观察者检测到的方块更新。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"点击它即可显示当前时间。"
		"和所有时钟一样，在下界无法使用。"
	]
	quest.6A111AA679FD828A.quest_subtitle: "显示当前的游戏内时间。"
	quest.6A4A1F6D2DB13AF6.quest_subtitle: "击败骷髅王（skeletron）后生成。"
	quest.6A4A1F6D2DB13AF6.title: "Clothier"
	quest.6A5FBC13B1E5B008.quest_subtitle: "将物品投入 Shimmer 中，可以将其炼化为新的物品。"
	quest.6BB9C0339C46FFBB.quest_subtitle: "按住可释放腐化能量束，吸取命中生物的生命力，对其造成伤害并为你恢复所受伤害的100%。"
	quest.6BB9C0339C46FFBB.title: "吸吮之光 (Ray Of Siphoning)"
	quest.6C0B0BACD1CECB42.quest_subtitle: "击败哥布林入侵后在地下发现。"
	quest.6C0B0BACD1CECB42.title: "哥布林工匠"
	quest.6C25D42C36175BF4.quest_desc: [
		"这台机器可以净化矿石：1个原矿锭会变成2个矿石块。"
		""
		"这台机器能高效精炼矿石：1个原锭可产出2个矿石块。"
		""
		"用破碎机处理土块得到脏土，然后用富集室制作净土，最后将其熔炼回锭。"
		""
		"一种能让你材料翻倍的方法 :D！"
		""
		"（不过工作量太大了）"
	]
	quest.6C25D42C36175BF4.quest_subtitle: "&8[点击阅读]"
	quest.6C60A4A1203D86D3.quest_subtitle: "所有木材类型都可以制作成盔甲。"
	quest.6C6CBA36CD3E5257.quest_subtitle: "将你的胃变成一个神秘熔炉，将吃下的食物转化为法力，持续一段时间。"
	quest.6C6CBA36CD3E5257.title: "暴食（Gluttony）"
	quest.6C87FAB0249CA091.quest_subtitle: "沃洛洛！"
	quest.6C87FAB0249CA091.title: "Wololo"
	quest.6CCB58DC5162F598.quest_subtitle: "在目标生物周围生长出魔法根系，将其缠绕，完全阻止非魔法移动。"
	quest.6CCB58DC5162F598.title: "根目录"
	quest.6CD1720B76F47806.quest_subtitle: "使用生物燃料！"
	quest.6D084ADFEEA9A0EF.quest_subtitle: "用经典的掠夺者方式，在你周围召唤出由唤魔者獠牙组成的防护环。"
	quest.6D084ADFEEA9A0EF.title: "方格护身符"
	quest.6D15A1BAD30B6BB2.quest_desc: [
		"可以和竹子一样进行种植。"
		"&aLichen Cordyceps&r 在水下食用可补充空气。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"&aGolden Lichen Cordyceps&r 能恢复大量空气，并让你最多额外获得4个气泡。"
	]
	quest.6D15A1BAD30B6BB2.quest_subtitle: "这种植物看起来像竹子，但它生长在地下。"
	quest.6D46B1A605A04BE9.quest_subtitle: "冰系学派的核心是伤害和控制群体。"
	quest.6D46B1A605A04BE9.title: "冰霜魔法"
	quest.6D4F6397F129EE19.quest_subtitle: "施放后，强化你周围半径内的所有友方生物，赋予他们临时生命值。"
	quest.6D4F6397F129EE19.title: "堡垒化"
	quest.6DABA16F792D5CF8.title: "终极机械模组"
	quest.6DB87EC19CF16B24.quest_subtitle: "用经典的掠夺者方式，在你面前召唤出一排唤魔者獠牙。"
	quest.6DB87EC19CF16B24.title: "獠牙突袭"
	quest.6DB956CF4D16CB12.quest_subtitle: "迸发灼热的魔法，对区域内的生物造成伤害，并留下一片火焰。"
	quest.6DB956CF4D16CB12.title: "灼烧（Scorch）"
	quest.6DDBDD0300183A0A.title: "大理石洞穴"
	quest.6DDE204361F4D0CC.quest_subtitle: "由任意箭矢转化而来。"
	quest.6DDE204361F4D0CC.title: "闪烁的箭矢"
	quest.6DFA625BAF983D67.quest_subtitle: "永久性地提升幸运值。由粉色珍珠转化而来。"
	quest.6EE8B66A4F31C91C.quest_subtitle: "瞬间传送到你注视的方向，或任何被选中的生物正后方。到达目的地后，会获得短暂的完全隐身效果。"
	quest.6EE8B66A4F31C91C.title: "血之步伐"
	quest.6F62B5510FA881CD.quest_subtitle: "基础合成材料"
	quest.6F62B5510FA881CD.title: "锇锭"
	quest.6F734864A6359962.title: "蜜蜂盔甲"
	quest.6F751D658EAB4A5D.quest_subtitle: "让自己充满剧毒魔法，对中毒的生物造成额外的近战、远程或法术伤害。"
	quest.6F751D658EAB4A5D.title: "蜘蛛的方面 (Aspect of the Spider)"
	quest.704CFFD031F3E30B.title: "黑曜石盔甲"
	quest.711A9C081DA1E6D3.quest_subtitle: "在你注视的地方召唤一面静止的奥术能量盾，它能阻挡投射物并阻止生物通过。"
	quest.711A9C081DA1E6D3.title: "盾牌"
	quest.713BC98027C7527A.quest_subtitle: "生成一根持续撞击地面、造成范围伤害的柱子。"
	quest.713BC98027C7527A.title: "响彻大地的回响之柱"
	quest.721A9FEEE2CBDD2A.quest_subtitle: "在沙滩群系中被发现处于睡眠状态。"
	quest.721A9FEEE2CBDD2A.title: "钓鱼佬"
	quest.721BD16C67CF17A0.quest_desc: [
		"如果把旗帜放在玻璃物品展示框里，它就会贴着墙，图案朝外，这样你就能创造出一种壁纸了。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"盾牌在玻璃物品展示框中的显示方式不同，它们与墙壁齐平，看起来很好看。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"玻璃物品展示框可以安装在放置于地板上的告示牌正面。这样物品将与告示牌齐平显示。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"玻璃物品展示框可以右键打开箱子或其他物品栏。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"当地图被放置在玻璃物品展示框中时，它会实时更新。非常适合间谍！"
	]
	quest.721BD16C67CF17A0.quest_subtitle: "玻璃物品展示框会在放入物品时隐藏框架"
	quest.72723A62472D91D2.quest_desc: [
		"Gravisand 除非被红石激活，否则不会下落。但如果 gravisand 接收到信号却无法下落，它反而会向上漂浮。"
		"此外，gravisand 会将信号传播给任何相邻的 gravisand 方块，使其也下落或漂浮。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"它会持续输出强度为15的比较器信号。"
	]
	quest.72723A62472D91D2.quest_subtitle: "Gravisand 除非用红石激活，否则不会下落"
	quest.72723A62472D91D2.title: "Gravisand"
	quest.7273D927DC7D0DFC.quest_subtitle: "生成于地面上的发光蘑菇生物群系中。"
	quest.7273D927DC7D0DFC.title: "松露（Truffle）"
	quest.729AEEA9EB61FF37.quest_subtitle: "在目标生物或方块周围，召唤出一波有毒的魔法浪潮，对命中的生物造成伤害，并留下有毒的云雾。"
	quest.729AEEA9EB61FF37.title: "毒物飞溅药水"
	quest.72C008AA321DD359.quest_desc: [
		"就像脚手架一样，它们只能从最近的支撑点水平伸出那么远，超出支撑范围就无法再延伸了。"
		"垂直绳索没有碰撞箱，并且可以攀爬。"
		"横向绳索确实有碰撞箱，可以踩在上面行走，不过速度较慢。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"将绳索放置在与现有垂直绳索相邻的位置，绳索将向下延伸。"
		"绳索可以放置，并能动态地缠绕在许多围栏状的方块上，例如墙壁、横梁和柱子。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"从绳索上坠落不会减速，但仍能防止坠落伤害。"
		"可以被投射物破坏。"
	]
	quest.72C008AA321DD359.quest_subtitle: "一种让移动更轻松的方块，尤其是在矿井中。"
	quest.72C008AA321DD359.title: "绳索"
	quest.72D23F8F9F0F5E1E.quest_subtitle: "投掷一个幻影，让你能从幻影的视角看到它落地的位置。"
	quest.73154E99297677A1.quest_subtitle: "在砧板上使用，有时会复制食物"
	quest.73154E99297677A1.title: "制作一把刀"
	quest.739A432E8D551359.quest_subtitle: "部分物品可以通过闪烁分解。而其他物品只能通过闪烁获得。"
	quest.73A8E1D13946F79D.quest_desc: [
		"用红石激活后，它会变得实体化，实体无法穿过它。"
		"另外，怪物也无法穿过它。"
	]
	quest.73A8E1D13946F79D.quest_subtitle: "会呈现为另一个方块的样子，并且不会影响移动。"
	quest.73A8E1D13946F79D.title: "暗影框架"
	quest.73DA876C6B35F311.quest_subtitle: "从天而降，召唤一道闪电。"
	quest.73DA876C6B35F311.title: "闪电术（Lightning Bolt）"
	quest.7415B75400D20593.quest_subtitle: "向敌人降下雨水，使他们受到「潮湿」效果的影响。"
	quest.7415B75400D20593.title: "降雨量"
	quest.74200A48498DD7F8.quest_subtitle: "利用太阳能产生电力"
	quest.747CFEFEA86A681B.quest_desc: ["玩家越靠近方块中心，信号强度就越高。"]
	quest.747CFEFEA86A681B.quest_subtitle: "如果玩家直视它，就会发出红石信号"
	quest.747CFEFEA86A681B.title: "末地观察者"
	quest.74C146F700685D1D.quest_subtitle: "富化物品提供8倍多的mb。"
	quest.757AC0052C4D92B3.quest_subtitle: "装填一支附有毒魔法的强力箭矢，击中时会释放出一片毒云。"
	quest.757AC0052C4D92B3.title: "毒箭"
	quest.767225F36214BCCB.quest_subtitle: "哪个是真的？？！！我再也受不了了"
	quest.768CDD15609DD6C6.quest_subtitle: "在你面前召唤凶猛的尖刺，让敌人措手不及并立即将其击杀。"
	quest.768CDD15609DD6C6.title: "震颤尖刺"
	quest.769208152296330A.quest_desc: [""]
	quest.769208152296330A.quest_subtitle: "每一行镐子都代表一个新的进阶阶段。"
	quest.769208152296330A.title: "镐使用指南"
	quest.76A38CCA5816CDAD.quest_desc: ["混合氧气和乙烯以生产高密度聚乙烯颗粒。"]
	quest.76A38CCA5816CDAD.quest_subtitle: "&8[点击阅读]"
	quest.76A38CCA5816CDAD.title: "HDPE颗粒，"
	quest.76FDD87E007F1B21.quest_desc: [
		"可以通过自动化设备（漏斗、投掷器等等）将物品放入其中。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"可以用红石信号或在其下方放置方块来禁用滑道。"
		"滑道可以通过空心原木掉落物品。"
	]
	quest.76FDD87E007F1B21.quest_subtitle: "放入的任何物品都会立即掉落到下方，且始终精确落在中心位置"
	quest.76FDD87E007F1B21.title: "滑道"
	quest.772E2A00FDC28F81.quest_subtitle: "用于制作 Confluence 的物品。"
	quest.7742A4A947268B67.quest_subtitle: "哥布林入侵会在暗影球体或绯红之心被摧毁后随机发生。也可以通过使用哥布林战旗手动召唤。"
	quest.7742A4A947268B67.title: "哥布林军团"
	quest.7778937DF377C1B4.quest_desc: ["海拔越高，力量越强！"]
	quest.7778937DF377C1B4.quest_subtitle: "利用风力产生能量"
	quest.77D18C87D1C6ABCF.quest_desc: ["将 1 个 &eLumiere Shard&r 加入堆肥，你将得到 &aGlowstone Dust&r 而不是 &aBone Meal&r。"]
	quest.77D18C87D1C6ABCF.quest_subtitle: "Lumiere 允许将萤石粉进行堆肥。"
	quest.77D18C87D1C6ABCF.title: "荧光粉的生产流程"
	quest.77EDF548D39AEF96.quest_subtitle: "在你周围一定半径内释放冰冻魔法波，使生物陷入冰冻状态。被冰冻的生物会减速，且被冻结所需的时间翻倍。"
	quest.77EDF548D39AEF96.title: "Frostwave"
	quest.77FDA17C83578D4B.quest_subtitle: "瞬间在你注视的地方召唤一个烟花，它会在周围小范围内爆炸。"
	quest.77FDA17C83578D4B.title: "鞭炮（Firecracker）"
	quest.784BE338677490B5.quest_subtitle: "Evocation学派的主题是魔法诡计和召唤，涵盖了最广泛的攻击、防御和辅助法术。"
	quest.784BE338677490B5.title: "召唤魔法"
	quest.78A25557C4BF992B.quest_subtitle: "发射一枚小型火焰弹，点燃它所触碰的任何东西。"
	quest.78A25557C4BF992B.title: "火球术"
	quest.7917F1D8E6176365.quest_subtitle: "挥舞武器，释放神圣能量，发动近战范围攻击。此法术不可中断。伤害取决于所持武器的近战伤害和附魔效果。"
	quest.7917F1D8E6176365.title: "神圣惩戒"
	quest.797194AB19CFE439.quest_desc: [
		"在相应动物上对其&6右键单击&r，即可将其绑定到特定的&e宠物&r（或&e马&r）。"
		"绑定的&a笛子&r只会召唤它所绑定的&e宠物&r。"
		"使用时会播放一首随机歌曲。"
		"如果重命名为现有歌曲的名称，它将一直播放该歌曲。"
	]
	quest.797194AB19CFE439.quest_subtitle: "可用来召唤附近未坐下的已驯服的宠物。"
	quest.79757F66DF263FA0.quest_desc: ["激光聚焦矩阵要放在聚变反应堆其中一个面的中心，而且...而且你需要给它提供巨量的能量。"]
	quest.79757F66DF263FA0.quest_subtitle: "&8[点击阅读]"
	quest.79757F66DF263FA0.title: "激光束"
	quest.79E000C7EAE43F45.quest_subtitle: "创造一个巨大的土球，将你的敌人压死。"
	quest.79E000C7EAE43F45.title: "区块生成器"
	quest.79EE4E4F348C1C7B.quest_subtitle: "释放出威力巨大的音爆，轻松穿透固体物质，并伤害路径上的首个生物。"
	quest.79EE4E4F348C1C7B.title: "音速冲击波"
	quest.79FF384713ABFCD8.quest_subtitle: "施放后会在你身边召唤一场雷暴，在法术持续期间，每2秒对视野内附近的生物造成一道小型闪电。"
	quest.79FF384713ABFCD8.title: "雷暴天气"
	quest.7A92871ED681157F.quest_subtitle: "用于创造法术的道具。"
