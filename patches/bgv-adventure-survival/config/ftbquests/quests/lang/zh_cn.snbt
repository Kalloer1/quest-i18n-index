	quest.0A09D61DC2061A01.quest_subtitle: "尽管如此，它仍然比大多数主世界魔法书更强大。"
	quest.0A0C812AA3874EC1.quest_desc: [
		"&a银色炸弹&r可以在&aCombution Table&r进行升级。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"&a火药&r - 增加爆炸半径和伤害。"
		"&a史莱姆&r - 炸弹会额外在表面反弹。"
		"&aString&r - 在爆炸前增加延迟。"
		"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
		"每个修饰符最多可升级3次。"
	]
