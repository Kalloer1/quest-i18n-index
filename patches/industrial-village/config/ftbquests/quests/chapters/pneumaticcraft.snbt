	quests: [
		{
			dependencies: ["6FD45EF3A2B1B31F"]
			description: [
				"PneumaticCraft 有自己的动力系统，基于压缩空气。它有点多维，机器和工具按数量储存空气，但许多操作取决于气压，而气压是机器体积和储存空气数量的函数。"
				""
				"压力通过多种压缩机产生：固体燃料压缩机（燃烧任何能在原版熔炉中燃烧的东西）、液体燃料压缩机（见下文）、使用闪电的压缩机以及FE/EU压缩机。"
				""
				"热量机制；部分机器需要热量，部分压缩机产生的热量需要散发"
				""
				"液体燃料由模组添加的世界生成油提炼而成，部分精炼燃料质量极高。"
			]
			icon: "kubejs:help"
			id: "302F025D35C7E495"
			rewards: [{
				id: "62B56C939ED5E7DD"
				item: {
					Count: 1
					id: "patchouli:guide_book"
					tag: {
						"patchouli:book": "pneumaticcraft:book"
