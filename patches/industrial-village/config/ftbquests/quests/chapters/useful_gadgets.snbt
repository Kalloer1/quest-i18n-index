		{
			dependencies: ["00000000000015D0"]
			description: [
				"建筑工具是一个实用工具，能让你用方块快速搭建出各种基本形状。"
				""
				"Shift+右键可设置工具使用的方块类型。建造的形状可在设置菜单中更改。"
			]
			id: "00000000000015C8"
			rewards: [{
