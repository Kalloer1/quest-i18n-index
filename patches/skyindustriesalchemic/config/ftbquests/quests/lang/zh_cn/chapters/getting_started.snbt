	quest.57717FC754C3C309.title: "Silkworms"
	quest.5A7051F938985E51.title: "被压碎的下界岩"
	quest.5A9893C9755B6717.quest_desc: ["将装满水的桶放置在菌丝体方块附近或上方。水会发酵变成女巫之水。将沙子放入这个转化后的桶中，即可获得灵魂沙。"]
	quest.5A9893C9755B6717.title: "女巫之水"
	quest.5C6BC322514D1BB4.title: "燧石网格"
	quest.602CF7690A628C58.title: "获取木材"
