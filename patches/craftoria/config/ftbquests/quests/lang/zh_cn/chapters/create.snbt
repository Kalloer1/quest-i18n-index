	quest.49D4F55F8A20DB22.quest_desc: ["有多种颜色可供选择，可搭配任何装饰风格。"]
	quest.49D4F55F8A20DB22.quest_subtitle: "放松一下，请坐。"
	quest.4AAFD7E0D868844A.quest_desc: ["它能&6弹出...&r这个、那个、牛、苦力怕、羊，甚至是玩家。"]
	quest.4AAFD7E0D868844A.quest_subtitle: "哇哦！"
	quest.4DCA027828C2921C.quest_desc: ["便携式储能装置，为一些“创造”模组物品供能。"]
	quest.4E3578FC24ACF39B.quest_desc: [
		"你可能在用“创造”模组压制第一块金属板时，就见过这个不起眼的小家伙。"
		""
		"&b存储仓&r&6能固定&r住物品，以便“创造”模组的许多其他物品与之互动。"
	]
	quest.4E3578FC24ACF39B.quest_subtitle: "物品...不许动！"
