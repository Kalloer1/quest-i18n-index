	quest.4E97BABA7D6B07FE.quest_desc: [
		"被动式作物和树木农场。"
		""
		"- 范围：距离&910 个方块&r的&b旋风花&r范围内。"
		""
		"- 进度：250。（默认值）"
		""
		"- 如何获得更多战利品*：多样性是关键。"
		"- 如何更快地填满进度*：数量是关键。"
		""
		"- 召唤：&6右键单击&r&b花朵&r"
		"&8（会将该花朵转换为旋风花）"
		""
		"- 使用旋风花：将一个&b存储装置&r&6紧贴着&r&b旋风花&r放置。"
		"W：旋风花 | "
		"C：箱子（或其他存储装置）"
		" C "
		"CWC"
		" C"
		""
		"- 需要来源：是。"
		""
		""
		"&8*旋风花详解 &b下一页 &8（制作中）"
		""
		"{@pagebreak}"
		"&2旋风花&r可查看方块处于&93 种状态&r（当你&6右键单击&r它时）："
		"&8- 有点喜欢（对心情的普通提升），+1 "
		"&8- 非常喜欢（对心情的最高提升），+2"
		"&8- 拒绝掉落"
		""
		"然后它还有另外 3 个数字用于追踪："
		"&8- 心情分数（影响&6进度&r&8；由它的&2“开心”&r&8程度表示）"
		""
		"&8- 多样性分数（&9从生成的战利品表中获取&r&8的次数）"
		"&8&6已接受&r&8的独特方块/作物有多少个"
		""
		"&8- 进度（满了之后会生成 &6战利品&8）"
		"&8进度 += &6心情值&r &8/ 30;"
		"&8存入战利品后重置为 0；"
		""
		"&8对于普通玩家：新进度 = 旧进度 + &6心情值&r &8/ 30;"
		""
		"&8真不敢相信居然还有第 3 页……"
		"{@pagebreak}"
		"&l代码实现方式如下：&r"
		"1. 根据范围内的 &9所有&r方块计算 &b心情值&r。（会遍历每一个方块）"
		"&8（当同一方块/作物达到 &950 个&r后，&8将不再为该方块/作物计算 &6更多&r数量）"
		""
		"2. 增加进度，直到充满。"
		""
		"3. 生成战利品表。"
		""
		"4. &8((多样性值 / 2) + 3)&r 次调用 getDrops()"
		"&8这部分你得自己研究（对我来说太复杂了）"
		"&8文件是：WhirlisprigTile.java"
		""
		"5. 存入花朵旁边的 &b储物&r方块中。"
	]
	quest.4E97BABA7D6B07FE.quest_subtitle: "作物与树木农场"
	quest.4F076E5D6F0BED74.quest_desc: [
		"A &b咒语&r是&b符文&r的组合。"
		""
		"&b形态符文&r：每个 &b法术&r只能有 1 种形态。"
		"&8（有些附魔工具会自动添加其形态，因此你无需为法术添加形态）&r"
