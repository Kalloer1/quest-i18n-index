	order_index: 2
	quest_links: [ ]
	quests: [
		{
			description: [
				"&7工坊的心脏正悄然运转。水晶灯笼的映照下，铺石小径两旁摆满了摊位——每个都由技艺精湛的匠人经营。从炊具的轻响，到药水的嘶嘶声和齿轮的嗡鸣，工坊市场再次繁荣起来。"
				""
				"&7用你辛苦赚来的钱币，换取来自世界各地的稀有遗物、异国美食或附魔奇物。"
			]
			icon: {
				Count: 1
				id: "iter_rpg:coin"
				tag: { }
			}
			id: "02AA309A28A24BE5"
			rewards: [
				{
					count: 5
					id: "0C01C7CF35A4FA30"
					item: {
						Count: 1
						id: "iter_rpg:coin"
						tag: { }
					}
					type: "item"
				}
				{
					id: "60B88F7C1B75092B"
					type: "xp"
					xp: 100
				}
			]
			size: 2.0d
			subtitle: "这里的每位工匠都有自己的故事……如果你的口袋足够深，他们还会拿出珍贵的东西。"
			tasks: [{
				id: "0DD7064CFD97E1F2"
				title: "Atelier Market"
				type: "checkmark"
			}]
			x: -1.0d
			y: 0.0d
		}
		{
			dependencies: ["02AA309A28A24BE5"]
			description: [
				"&7啊，一位同是厨师的朋友！一个人的内心可以从他炖汤的调味中看出来。"
				""
				"&7Here at Maribeth’s Bakery, I trade in flavors, feelings, and a pinch of nostalgia. From humble sandwiches to divine feasts, I’ll make sure every coin you spend fills both your belly and your soul."
			]
			disable_toast: true
			icon: {
				Count: 1
				id: "bakery:braided_bread"
				tag: { }
			}
			id: "115FFBAD31F2E898"
			size: 1.5d
			subtitle: "品尝魔法吧——愿你的双手保持平稳，孩子。"
			tasks: [{
				id: "1D90C01D92643D6F"
				title: "玛丽贝斯的烘焙坊"
				type: "checkmark"
			}]
			x: -5.0d
			y: -2.0d
		}
		{
			dependencies: ["02AA309A28A24BE5"]
			description: [
				"&7欢迎，小芽。这里的空气回荡着根须与雨水的歌谣。"
				""
				"&7In Elydriel’s Hearth, you’ll find nature’s quiet miracles — salves to soothe, brews to bolster, and elixirs that heal the spirit. Every bottle carries a heartbeat, every leaf remembers sunlight."
			]
			disable_toast: true
			icon: {
				Count: 1
				id: "natures_spirit:gardenia"
				tag: { }
			}
			id: "2093D6C48CD56462"
			size: 1.5d
			subtitle: "公平交易，让大地在适当的时候回报你。"
			tasks: [{
				id: "66E840CF0C2A9299"
				title: "埃利德里尔的炉火"
				type: "checkmark"
			}]
			x: -1.0d
			y: -4.0d
		}
		{
			dependencies: ["02AA309A28A24BE5"]
			description: [
				"&7你是在寻求那不可见之物，不是吗？别否认了——我能感受到你眼中燃烧的疑问。"
				""
				"&7欢迎来到阿斯特拉的奥秘，这里是神秘与艺术的交汇。我们交易的不是黄金，而是理解的微光。每一本典籍，每一件小物，都回荡着古老工坊的心跳。请轻柔对待它们——它们会铭记于心。"
			]
			disable_toast: true
			icon: {
				Count: 1
				id: "companions:book_ice_shard"
				tag: { }
			}
			id: "1E5AA08FADA4030D"
			size: 1.5d
			tasks: [{
				id: "73E89FF02B17513D"
				title: "阿斯特拉的奥术之书"
				type: "checkmark"
			}]
			x: 3.0d
			y: -2.0d
		}
		{
			dependencies: ["02AA309A28A24BE5"]
			description: [
				"&7你正伫立于此，伟大的先人曾在此交易的不是财富，而是传奇。"
				""
				"&7水晶交易所收藏着源于激情、毅力与痛苦的遗物。唯有赢得众多金币青睐者，方能一窥其光芒。"
				""
				"&7你在这里购买的并非物品，而是一个故事，是工作室灵魂重生的片段。"
			]
			disable_toast: true
			icon: {
				Count: 1
				id: "terramity:prismatic_crystal_cluster"
				tag: { }
			}
			id: "072DB222718AA745"
			size: 1.5d
			subtitle: "明智地消费，尽情梦想，愿你在水晶中的倒影永不摇曳。"
			tasks: [{
				id: "4E1E76E2C0FFD73B"
				title: "水晶交易所"
				type: "checkmark"
			}]
			x: -1.0d
			y: 4.0d
		}
		{
			dependencies: ["02AA309A28A24BE5"]
			description: [
				"&7啊！又一个好奇的灵魂。欢迎来到泰莎的发明工坊，在这里，创意就是货币，而发明永不停歇。"
				""
				"&7金币能买来工具，创造力却能买来进步。善用这些组件——工坊的脉络仍铭记着发现的悸动。"
			]
			disable_toast: true
			icon: {
				Count: 1
				id: "iter_rpg:cog_heart"
				tag: { }
			}
			id: "38673A3896A70C32"
			size: 1.5d
			subtitle: "小心火花，别碰标着“不稳定”的原型机。我警告你。"
			tasks: [{
				id: "03F10F6FD37F91BC"
				title: "Tessa's Tinkerhaus"
				type: "checkmark"
			}]
			x: -5.0d
			y: 1.5d
		}
		{
			dependencies: ["02AA309A28A24BE5"]
			description: [
				"&7旅人！你看起来像是见过世界荒野边缘的人。"
				""
				"&7At Rowan's Armory, I trade in tales — and the tools that make them worth telling. Swords, armor, and curios for the brave and the bold."
				""
				"&7花掉你的金币，领取你的奖品……愿风将你的名字带到星辰之中。"
			]
			disable_toast: true
			icon: {
				Count: 1
				id: "minecraft:iron_sword"
				tag: {
