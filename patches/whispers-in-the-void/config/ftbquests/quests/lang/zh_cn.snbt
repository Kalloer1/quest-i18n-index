	quest.5DB201C353D10568.quest_subtitle: "正在变强！"
	quest.5DB201C353D10568.title: "下界合金废料"
	quest.5DBD05D76A38809F.quest_desc: [
		"好，发生了点&#9B59B6奇怪&f的事……看起来&#8E44AD末地&f巨龙离我们还有1200格远。"
		""
		"我们必须去那里，与它&#E74C3C正面对&f抗。它是&#FF1493色欲&f之罪的仆人……"
	]
	quest.5DBD05D76A38809F.quest_subtitle: "距离1200个方块远"
	quest.5E49C2CFDED1EE7B.quest_subtitle: "愤怒，愤怒，愤怒"
	quest.5E49C2CFDED1EE7B.title: "思想之星"
	quest.5E69D958C8B9FAB7.quest_desc: [
		"&#34495E暗&f金属是一种珍贵且&#F1C40F稀有&f的材料。我们可以通过击杀以下生物来获得其堆：</c4>"
		""
		"Barrel Zombies、Bonescaller、Door Knights、Diamond Termites、Missionary、Nightmare Stalker、Skeleton Thrasher、Spirit Guide 和 Zombie Bruiser。"
	]
	quest.5E69D958C8B9FAB7.quest_subtitle: "太珍贵了！"
	quest.5E72B3ADD7D246B0.quest_subtitle: "你将永远不会再回来"
	quest.5E72B3ADD7D246B0.title: "思想之星"
	quest.5EC884C97C05806E.quest_desc: [
		"万物皆有其&#F1C40F用途&f，哈哈哈。"
		""
		"我们必须重回正轨，摧毁&#2ECC71嫉妒&f的罪孽……"
		""
		"它派出了其中一个&#8B0000仆人&f来对付我们。快追上去！在&#85C1E9寒冷&f的生物群系里，我们能找到巫妖塔。"
		""
		"跟随&#9B59B6Soul&f星指引前进。"
	]
	quest.5EC884C97C05806E.quest_subtitle: "听起来很疯狂，不是吗？"
	quest.5F682144D1588BCA.quest_desc: ["你才&#3498DB年轻&f，不能被这影响到！快起来找点&#85C1E9钻石&f。我们必须去&#E74C3C下界&f！"]
	quest.5F682144D1588BCA.quest_subtitle: "克服懒惰的习惯"
	quest.5F682144D1588BCA.title: "钻石"
	quest.5F6D0FDC6CEFBE7C.quest_desc: [
		"又一个&#8B0000邪恶&f的势力已经终结了..."
		""
		"&#FF1493欲望&f已经终结，但它付出了怎样的&#E74C3C代价&f？我们都做了什么？"
		""
		"这一切的&#34495E终结&f即将来临... 我们必须&#F1C40F小心&f。你的头一定很痛！准备好迎接下一个&#8B0000罪&f吧。"
