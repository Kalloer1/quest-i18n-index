	quest.4B890CE2CF44ECE6.quest_subtitle: "一匹弗兰肯斯坦马"
	quest.4BAD65AAB6D60C10.quest_subtitle: "我做到了这一点"
	quest.4BAD65AAB6D60C10.title: "思想之星"
	quest.4C5150207C45C800.quest_desc: [
		"谁的&#F1C40F英雄&f？总之，我们终于可以结束这一切了！这些因&#8B0000罪人&f而出现的&#E74C3C怪物&f……"
		""
		"来和这个&#7F8C8D傻瓜&f较量一下吧！"
		""
		"但是&#F1C40F小心&f！别被它低&#E74C3C血量&f所迷惑。 &#9B59B6Helvar&f非常强壮而且&#3498DB速度很快&f！"
	]
	quest.4C5150207C45C800.quest_subtitle: "英雄赫尔瓦尔"
	quest.4C62D67811176E61.quest_desc: [
