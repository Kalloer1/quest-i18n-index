	quest.5C9A021CDAA4D476.title: "思想之星"
	quest.5C9F5BEB0BAE9570.quest_desc: ["进入&#9B59B6塔&f后，我们需要&#E74C3C击败&f一些&#F1C40F守卫&f！"]
	quest.5C9F5BEB0BAE9570.quest_subtitle: "巨龙守卫！"
	quest.5C9F5BEB0BAE9570.title: "击杀灰烬领主守卫"
	quest.5CF5337AEAD03BC3.quest_desc: [
		"&#8B0000罪恶&f正在肆虐我们的&#2ECC71世界&f。即使消灭了大部分，仍有某些地方&#9B59B6不对劲&f！"
		""
		"我们必须用他们自己的&#E74C3C邪恶&f来对付他们！让我们举行&#8E44AD仪式&f，召唤&#E74C3C恶魔&f，彻底终结这一切！"
	]
	quest.5CF5337AEAD03BC3.quest_subtitle: "仪式与灵魂！"
	quest.5CF5337AEAD03BC3.title: "蜡烛"
	quest.5D18794516CD9B73.quest_desc: [
		"好，既然知道这有什么用，我们现在需要去拿燧石和钢，还有一个恶魔果实。"
		""
		"将恶魔果实扔到地上，然后用打火石和钢点燃它：&#E74C3CFire&f。"
		""
		"这个&#FF5733火焰&f可以用来投掷物品进去燃烧。通过燃烧，我们可以获得&#9B59B6新&f物品！"
	]
	quest.5D18794516CD9B73.quest_subtitle: "一个新的火源"
	quest.5D18794516CD9B73.title: "灵魂之火"
	quest.5D454AE4289A3F4D.quest_subtitle: "我一定会为你报仇雪恨的！"
