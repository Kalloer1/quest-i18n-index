	quest.22098D11B944154D.quest_desc: ["如果我们想继续击败&#8B0000Sinners&f，就需要一套非常&#E74C3CStrong&f的盔甲！为此，我们需要一套&#34495EDark&f Metal盔甲！&l"]
	quest.22098D11B944154D.quest_subtitle: "坚固耐用，经久不衰"
	quest.22098D11B944154D.title: "暗金属锭"
	quest.2228AAB16A6A5DCF.quest_desc: [
		"一直以来，我都迷失在自己的&#9B59B6心智&f之中……"
		""
		"我让我的&#8B0000罪过&f和恐惧吞噬了我，我做了那么多&#E74C3C错误&f的事情。"
	]
	quest.2228AAB16A6A5DCF.quest_subtitle: "一切都结束了……"
	quest.2228AAB16A6A5DCF.title: "希望之星 (Stars of Hope)"
	quest.242E7DEC6A924FA8.quest_desc: [
		"按照下方的&#F1C40F图片&f建造&#9B59B6骄傲&f祭坛。"
		""
		"完成&#9B59B6祭坛&f后，用&#8E44AD虚空&f尖刺点击暗金属块。"
		""
		"&#3498DB所需&f方块："
		""
		"25 苔藓方块"
		"12 紫晶块"
		"4 根红色蜡烛"
		"1 暗金属块"
		""
		""
		"{image:ftbquests:textures/gui/prowler.png width:160 height:100 align:center click_action:none:}"
	]
	quest.242E7DEC6A924FA8.quest_subtitle: "祭坛"
	quest.2536717F39F01D4B.quest_desc: ["&#F1C40F完美&f！现在，有了这颗&#E74C3C心&f，我们就可以建造&#F1C40F贪婪&f祭坛了！"]
	quest.2536717F39F01D4B.quest_subtitle: "我们找到了"
	quest.257A2AD841E746B6.quest_desc: ["&#F1C40F希望之星&f是你自己的&#3498DB角色&f所说的话语！"]
	quest.257A2AD841E746B6.quest_subtitle: "这是什么东西？"
	quest.257A2AD841E746B6.title: "希望之星 (Stars of Hope)"
	quest.264A07D74C77E416.quest_desc: [
		"&#F1C40F贪婪&f教会了我们一些东西……"
		""
		"无论来自何处，无论是什么，一切都可以被&#2ECC71回收&f并保存下来..."
		""
		"我们的目标是击败七大&#8B0000原罪&f之首：&#E74C3C愤怒&f……"
	]
	quest.264A07D74C77E416.quest_subtitle: "故事的结局..."
	quest.27BCA7F802B5A47D.quest_desc: [
		"该做&#9B59B6实验&f了！用这根&#7F8C8D针&f，我们可以消灭动物和生物，收集它们的&#8B0000血液&f。"
		""
		"它只能存储 5000 mB。要提高容量，只需制作另一个并在 &#F1C40F配方&f 中组合它们！"
		""
		"只需将&#7F8C8DNeedle&f留在物品栏中，消灭怪物即可。"
	]
	quest.27BCA7F802B5A47D.quest_subtitle: "正在抽取血液！"
	quest.288F21FCB7653550.quest_subtitle: "生命维持系统启动中"
	quest.288FAF228181743F.quest_desc: [
		"无法被&#9B59B6定义&f或创造的东西..."
		""
		"迷失在某个地方，完全不知道该怎么&#3498DB回去&f..."
		""
		"于是……&#F1C40F贪婪&f的罪孽降临了。我们必须对一切保持&#E74C3C谨慎&f。我们离击败7位&#8B0000罪人&f已经很近了。"
		""
		"&#F1C40F贪婪&f有时反映了&#FF1493欲望&f，但我们总是渴望更多，永远不满足于&#2ECC71拥有&f的一切！"
	]
	quest.288FAF228181743F.quest_subtitle: "我们是谁？"
	quest.288FAF228181743F.title: "贪婪"
	quest.2972C860572D8D69.quest_desc: [
		"我们必须回到这个&#9B59B6奇怪的&f末地……"
		""
		"这里的情况并不&#E74C3C正常&f！"
	]
	quest.2972C860572D8D69.quest_subtitle: "我们又回来了！"
	quest.2A277533803F41B9.quest_desc: [
		"好吧，这绝对不是我们所知的&#9B59B6The&f End……我搞不懂了。我身处你的&#34495EHead&f里，一切都那么&#8E44ADConfusing&f！"
		""
		"我&#F1C40F是&f谁？你&#E74C3C是&f谁？"
	]
	quest.2A277533803F41B9.quest_subtitle: "那是什么东西？"
	quest.2A2F660449D7F2B2.quest_desc: ["我们必须找到&#F1C40F贪婪&f仆人的&#8E44AD竞技场&f！"]
	quest.2A2F660449D7F2B2.quest_subtitle: "正在整理这些东西！"
	quest.2ACEC4DF85198DEB.quest_desc: [
		"由于&#8B0000罪人&f，&#85C1E9冰&f中发生了奇怪的事情..."
		""
		"在冰冻的土地上，我们能找到一些奇怪的&#9B59B6建筑&f：由&#E74C3C掠夺者&f和奇特生物看守的船只、营地和瞭望塔。"
	]
	quest.2ACEC4DF85198DEB.quest_subtitle: "探险家们的头盔，适合冒险时使用"
	quest.2BE559B841E96B64.quest_desc: [
		"&#2ECC71嫉妒&f... 因为它，许多人曾拥有一切，然后又失去了一切..."
		""
		"通常，嫉妒源于渴望一些你尚未能&#F1C40F达成&f的事物..."
		""
		"总之！这就是它的&#E74C3C终&f点。让我们继续我们的&#3498DB路&f程。"
	]
	quest.2BE559B841E96B64.quest_subtitle: "嫉妒的时代已经结束，一切尘埃落定"
	quest.2C4E491DD63FBD94.quest_desc: [
		"按照下方的&#F1C40F图片&f建造&#E74C3C魔鬼&f的祭坛。"
		""
		"完成&#9B59B6祭坛&f后，用打火石和钢锭点击灵魂蜡烛。"
		""
		"&#3498DB所需&f方块："
		""
		"19 灵魂土块"
		"4 凋零骷髅头颅"
		"1 灵魂蜡烛"
		""
		"{image:ftbquests:textures/gui/devil.png width:120 height:100 align:center click_action:none:}"
	]
	quest.2C4E491DD63FBD94.quest_subtitle: "祭坛"
	quest.2C5DA00777A48B9A.quest_desc: ["要真正开始，我们需要一些&#3498DB工具&f！我们知道&#8B5A2B木头&f不结实，但这只是个&#2ECC71开始&f！"]
	quest.2C5DA00777A48B9A.quest_subtitle: "基础工具！"
	quest.2C5DA00777A48B9A.title: "木制工具"
	quest.2CF5821B21962416.quest_subtitle: "我也是其中之一！"
	quest.2CF5821B21962416.title: "思想之星"
	quest.2DAB01DBA4A59056.quest_desc: ["有什么东西正在&#E74C3C肆虐&f着&#FF5733下界&f。我怀疑是最后一个我们面对的&#8B0000怪物&f……克拉克、巨龙、西罗克和雪怪的&#9B59B6守护者&f！"]
	quest.2DAB01DBA4A59056.quest_subtitle: "返回下界"
	quest.2DBFD5ABFB91BA32.quest_desc: [
		"被&#9B59B6骄傲&f所吞噬，船长任由情绪失控，被&#F1C40F贪婪&f驱使，总是想要更多。"
		""
		"她试图抵达一座&#8E44AD被诅咒的&f岛屿，但作为神的惩罚，迷宫之母现身，阻止了她的船只，将她拖入了&#3498DB大海&f的深处！"
	]
	quest.2DBFD5ABFB91BA32.quest_subtitle: "一个丢失的标题……"
	quest.2E72CEA6686FAAAD.quest_desc: [
		"&#8B0000罪人&f们把世界搞得天翻地覆。 &#9B59B6生物&f正从我们从未想象过的地方出现……"
		""
		"在&#E6B86A沙漠&f里找到一个&#F1C40FNest&f！"
	]
	quest.2E72CEA6686FAAAD.quest_subtitle: "沙子里面有可疑的东西"
	quest.2E927011981FCCE0.quest_desc: [
		"开始：这个世界被&#8B0000Sinners&f占领并摧毁了！我们失去了最重要的东西，也失去了能拯救我们作为&#3498DBHumanity&f的……我们失去了&#8B0000Fear&f！"
		""
		"我们让自己被&#FF8C00暴食&f、&#9B59B6骄傲&f、&#FFD700贪婪&f、&#2ECC71嫉妒&f、&#FF1493色欲&f、&#7F8C8D懒惰&f和&#E74C3C愤怒&f所吞噬。"
		""
		"我们的&#8B0000世界&f已经迷失了..."
	]
	quest.2E927011981FCCE0.quest_subtitle: "恶习与欲望"
	quest.2EB1CB34B7F0F82F.quest_desc: ["击败堕落骑士的&#F1C40F奖励&f，我们有几率获得&#9B59B6锻造&f模板。它和下界合金一样，但需要下界合金盔甲 + 锻造模板 + &#34495E暗&f金属！"]
	quest.2EB1CB34B7F0F82F.quest_subtitle: "更棒 + 更棒"
	quest.2F6960A9559CF94D.quest_desc: ["有些&#9B59B6奇怪&f的事情正在发生... 这个&#F1C40F竞技场&f又大又&#E74C3C危险&f！我们必须去&#3498DB探索&f它！"]
	quest.2F6960A9559CF94D.quest_subtitle: "下界底部的一个竞技场"
	quest.2F955E854768F07A.quest_desc: [
		"我绝不可能&#E74C3C接受&f。不管你是谁，我都要来追你！"
		""
		"I've already faced the &#8B0000Strongest&f monsters in this world, and you'll be just another one! Just you wait, &#9B59B6Ghost&f! I'll find out who you are!"
	]
	quest.2F955E854768F07A.quest_subtitle: "惩罚中"
	quest.2F955E854768F07A.title: "希望之星 (Stars of Hope)"
	quest.30C931CC7249C5FD.quest_desc: [
		"&#F1C40FGreed&f 把这些 &#E74C3CDemons&f 放在我们的路上，但我们征服了他们！HAHAHA！"
		""
		"现在，我们去追捕它的&#8B0000仆人&f吧！"
		""
		"要击败&#9B59B6Obsidilith&f，我们需要返回末地。"
	]
	quest.30C931CC7249C5FD.quest_subtitle: "有什么东西在呼唤着我们"
	quest.316E5E734BA1C0E7.quest_desc: ["一把能附魔五级&#9B59B6附魔&f的&#F1C40F神奇&f镐！"]
	quest.316E5E734BA1C0E7.quest_subtitle: "财富 V"
	quest.31750CEC99060822.quest_desc: [
		"&#34495E暗&f金属是一种珍贵且&#F1C40F稀有&f的材料。我们可以通过击杀以下生物来获得它的碎片："
		""
		"Barrel Zombies、Bonescaller、Door Knights、Diamond Termites、Missionary、Nightmare Stalker、Skeleton Thrasher、Spirit Guide 和 Zombie Bruiser。"
	]
	quest.31750CEC99060822.quest_subtitle: "捕捉掉落物"
	quest.31ED812DF45C9945.quest_desc: ["我们需要一些&#85C1E9玻璃瓶&f来收集生物的&#8B0000血液&f。只需在物品栏中放一个玻璃瓶，然后用&#7F8C8D镰刀&f攻击生物即可。"]
	quest.31ED812DF45C9945.quest_subtitle: "正在收集血液"
	quest.328BAC8BFDCAC4C4.quest_desc: [
		"&#8B0000罪人&f们已经撼动了&#2ECC71世界&f！我们注意到了一些真正&#9B59B6奇怪&f的事情……"
		""
		"这个凋零骷髅看起来&#E74C3C不一样&f！"
	]
	quest.328BAC8BFDCAC4C4.quest_subtitle: "一位骑士"
	quest.330886E603B2752B.title: "可怕的盔甲"
	quest.3363C13FEE9F260F.quest_desc: [
		"当&#9B59B6祭坛&f准备就绪后，我们需要用&#E74C3C心&f点击蜂蜜块。"
		""
		"但要&#FF5733小心&f，孩子……&#FF8C00暴食&f很危险，它会想方设法吞噬你！保持&#3498DB警惕&f和&#E74C3C强大&f！"
	]
	quest.3363C13FEE9F260F.quest_subtitle: "手中握着心脏"
	quest.3364051A0004EFF3.quest_desc: [
		"一场&#9B59B6梦&f？我不这么认为，孩子……"
		""
		"你什么也&#3498DB记不&f住吗？你刚出现在这里，而我不过是你脑海里的一个&#8E44AD声&f音\\"
	]
	quest.3364051A0004EFF3.quest_subtitle: "Dream"
	quest.33BA7AAC6E88BBEA.quest_desc: ["斯科尔的&#85C1E9手套&f，一件既是&#E74C3C近战&f武器又是&#7F8C8D盾牌&f的&#F1C40F独特&f物品。左键点击会施加&#3498DB冰冻&f效果。"]
	quest.33BA7AAC6E88BBEA.quest_subtitle: "冰霜之拳！"
	quest.343E51575BBBE264.quest_desc: [
		"在&#34495E夜晚&f，因罪人而滋长的&#8B0000怪物&f终于现身了！"
		""
		"我们需要变得&#E74C3C更强&f！"
	]
	quest.343E51575BBBE264.quest_subtitle: "为夜晚做好准备中"
	quest.343E51575BBBE264.title: "铁质盔甲"
	quest.348AEB5F077A10E9.quest_desc: [
		"有人认为，年轻人被&#7F8C8D懒惰&f所控制，是因为&#3498DB手机&f和唾手可得的一切……"
		""
		"我的看法？我认为&#8B0000世界&f已经迷失多年，而我们生活的这个十年，恰好被选中成为一切的&#E74C3C终结&f！"
	]
	quest.348AEB5F077A10E9.quest_subtitle: "这一切是从什么时候开始的？"
	quest.348AEB5F077A10E9.title: "钻石工具"
	quest.34A4F831A311F011.quest_desc: ["找到船的&#E74C3C船长&f。他守着这个&#F1C40F号角&f！击败他并拿走号角！"]
	quest.34A4F831A311F011.quest_subtitle: "吹响号角 (Playing the Horn)"
	quest.3516AE047122A140.quest_desc: [
		"这把&#F1C40F不可思议的&f剑非常&#E74C3C强大&f锋利。"
		""
		"其&#9B59B6特殊&f能力可通过按住右键激活。玩家蓄力约3秒，然后释放以连续发射多达七道&#3498DB剑&f波，每道投射物造成5点&#E74C3C伤害&f。"
	]
	quest.3516AE047122A140.quest_subtitle: "英雄之剑！"
	quest.352E509700853952.quest_desc: [
		"&#7F8C8D懒虫&f开始在年轻人中蔓延。他们谁也不想再做什么，只想待在各自的&#3498DB手机&f前。"
		""
		"因此，&#F1C40F工作&f岗位空缺，城市开始消亡，人们因无事可做而陷入绝望……"
		""
		"一个前所未见的&#8B0000恐怖&f生物... &#7F8C8D懒惰&f杀害了许多年轻人。"
	]
	quest.352E509700853952.quest_subtitle: "深度睡眠"
	quest.352E509700853952.title: "树懒"
	quest.358D69F538B30936.quest_desc: ["要获得这个&#9B59B6石头&f，你需要将安山岩投入&#FF5733灵魂&f之火！"]
	quest.358D69F538B30936.quest_subtitle: "白色的东西，不代表它就不是来自地狱的。"
	quest.358D69F538B30936.title: "其他石头"
	quest.358EBBDBB21D15F6.quest_subtitle: "闪烁着白色和红色光芒的灯光……"
	quest.358EBBDBB21D15F6.title: "思想之星"
	quest.36641D54E44310E4.quest_subtitle: "更好的工具！"
	quest.36641D54E44310E4.title: "下界合金工具"
	quest.3688305630D5F91D.quest_subtitle: "他得到了应有的报应！"
	quest.3688305630D5F91D.title: "思想之星"
	quest.36F6D86A585CF359.quest_desc: [
		"这个由我们的罪孽诞生的&#8B0000怪物&f，最喜欢&#FFD700偷窃&f东西。"
		""
		"所以找到它的时候，一定要&#E74C3C小心&f。它会偷走你的&#7F8C8D剑&f，所以带上&#2ECC71备用的&f！"
	]
	quest.36F6D86A585CF359.quest_subtitle: "一只怪物"
	quest.3708C44201809BE4.quest_desc: ["&#FF8C00暴食&f这种疾病真是&#8B0000可怕&f……我们不知道为什么会这样。或许是从我们开始用&#7F8C8D铁&f来屠杀动物获取&#F1C40F食物&f的时候开始的！"]
	quest.3708C44201809BE4.quest_subtitle: "你不可以吃铁块！"
	quest.3708C44201809BE4.title: "铁锭"
	quest.37FCE6248FA22F1C.quest_desc: [
		"作为一个令人愉快的&#F1C40F惊喜&f，迷宫之母是一个会吞噬沿途一切事物的&#E74C3C怪物&f。"
		""
		"我们也得找到并&#8B0000消灭&f她才行。"
		""
		"要让迷宫之母被你吸引，请在&#9B59B6迷宫&f里待上至少30分钟！"
	]
	quest.37FCE6248FA22F1C.quest_subtitle: "寻找妈妈！"
	quest.381043E5D4003216.quest_subtitle: "罪人与罪孽"
	quest.381043E5D4003216.title: "思想之星"
	quest.38BE757D2FCEFE9C.quest_subtitle: "是他的错！"
	quest.38BE757D2FCEFE9C.title: "思想之星"
	quest.39F25102BE158695.quest_desc: ["作为&#8B0000Betrayed&f Guzzler的掉落物，我们能获得这把奇怪的&#7F8C8DSickle&f，并将其用作武器。它具有&#9B59B6Incredible&f的力量！"]
	quest.39F25102BE158695.quest_subtitle: "追寻鲜血的踪迹"
	quest.3AD4D97798109C82.quest_desc: [
		"有什么东西在&#E74C3C阻止&f我们到达&#7F8C8D懒惰&f……"
		""
		"&#7F8C8D懒惰&f的罪过，是阻碍我们的事物。我们必须抵达那些&#9B59B6建筑&f，找到它。"
	]
	quest.3AD4D97798109C82.quest_subtitle: "有什么东西在阻止着……"
	quest.3B819FDD387914AC.quest_desc: ["&#9B59B6Kraken&f的三叉戟会非常&#F1C40F有用&f！有了它，我们就能在很远的&#3498DB距离&f上进行战斗，并造成可观的&#E74C3C伤害&f！"]
	quest.3B819FDD387914AC.quest_subtitle: "一种新武器"
	quest.3C5A840E98C05ACD.quest_desc: [
		"&#F1C40F太棒了&f，不是吗？我们可以把死兔子的部分组合起来，然后&#2ECC71复活&f它。"
		""
		"为此，我们需要制作一个兔子全身体，并在外面是&#34495E黑暗&f的时候，把它放在临床拉伸台上。几秒后，&#3498DB闪电&f就会劈下，使兔子复活。"
		""
		"等它活过来（或死掉）后，我们就可以用胡萝卜来&#F1C40F驯服&f它了。"
		""
		"有好几种&#E74C3CMob&f可以完成这个任务。我们只需要收集它们的身体部位。"
	]
	quest.3C5A840E98C05ACD.quest_subtitle: "一只不死兔子"
	quest.3D40CBA65B41B0FF.quest_desc: [
		"从地里冒出来，嘴里吐出强力光束的&#E74C3C怪物&f……这只能是&#9B59B6梦境&f之类的东西。我还是不知道这是什么。我们必须&#F1C40F调查&f！"
		""
		"击败&#34495E坚守者&f。"
	]
	quest.3D40CBA65B41B0FF.quest_subtitle: "缓慢的脚步声"
	quest.3D48FB1627D4F5F3.quest_desc: ["我们可以获得&#9B59B6Gauntlet&f，这是击败&#E74C3CSirok&f后掉落的物品！它能发射&#2ECC71Poison&f，而且非常&#F1C40FPowerful&f！"]
	quest.3D48FB1627D4F5F3.quest_subtitle: "一把武器？"
	quest.3DE56F16D5EEE98A.quest_subtitle: "我们长大的可真快！"
	quest.3DE56F16D5EEE98A.title: "思想之星"
	quest.3EE1496C2515B6C5.quest_desc: [
		"作为最后的&#8B0000一息&f，&#9B59B6傲慢&f的恶魔试图占领我们的土地！"
		""
		"我们需要找到一个隐藏了奇怪&#2ECC71植物&f的&#7F8C8D结构&f..."
	]
	quest.3EE1496C2515B6C5.quest_subtitle: "指向性攻击！"
	quest.40F5382BEF5C0CED.quest_desc: [
		"明白吗，小子，&#9B59B6一切&f都会重演……旧事与新事。这个问题以前也发生过，相信我……我待在这里的时间比你想象的还要&#F1C40F久&f。"
		""
		"弄点&#8E44AD黑曜石&f。我们要去&#E74C3C下界&f了！"
	]
	quest.40F5382BEF5C0CED.quest_subtitle: "古老的循环……"
	quest.40F5382BEF5C0CED.title: "黑曜石"
	quest.412CF537133BAAB1.quest_subtitle: "复制矿物方块（Duplicating ores）"
	quest.414B226E8278BCA8.quest_desc: [
		"世界正在发生一些&#9B59B6奇怪&f的事情……"
		""
		"我们不知道是否是&#F1C40F贪婪&f的罪过，但这一切都透着古怪……"
		""
		"开始&#3498DB调查&f吧！先用打火石和钢锭打破一些草，以获得恶魔种子。"
