	order_index: 0
	quest_links: [ ]
	quests: [
		{
			description: [
				"&f欢迎来到&a丰饶田野&f章节！"
				""
				"本系列任务致力于农业、作物多样性、烹饪、酿造，将你的家园打造成繁荣的美食天堂。"
				""
				"你将探索并掌握以下内容："
				"&6• Farmer's Delight n' Croptopia &f— 核心种植与烹饪"
				"&6• [Let's Do] 系列 &f(Bakery, Brewery, Meadow, Farm n' Charm, Vinery, HerbalBrews)"
				"&6• 方块头烹饪与方块头农场"
				"&6• 植物花盆与植物树 &f— 自动化种植"
				"&6• 各种 Delight 扩展与 Feastful 内容"
				""
				"完成此介绍以解锁专业分支。"
				""
				"在&2Verdant Haven&f里种植、烹饪、酿造和尽情享用！"
			]
			icon: "minecraft:wheat"
			id: "6B71D98EFFC93A19"
			tasks: [{
				id: "3BC861D90E107078"
				title: "&a欢迎来到田野之中"
				type: "checkmark"
			}]
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["6B71D98EFFC93A19"]
			description: [
				"&f在 Verdant Haven 掌握耕作的精髓："
				""
				"&6• Farmer's Delight &f— 新增作物、工具、食物和烹饪机制"
				"&6• Croptopia &f— 超过100种独特的作物、水果和食物"
				""
				""
				"这两个模组提供了你游戏前中期绝大部分的食物产量。"
			]
			id: "2144ED9AEE09A4A2"
			tasks: [{
				id: "3D4F0EB941F17E89"
				title: "&a农夫的欢乐与作物天堂"
				type: "checkmark"
			}]
			x: 0.0d
			y: 2.0d
		}
		{
			dependencies: ["6B71D98EFFC93A19"]
			description: [
				"&f用自动化将你的农场提升到新高度："
				""
				"&6• 植物学花盆与植物学树木"
				"&6• 方块脑袋的农场生活"
				""
				""
				"这些模组能让你在室内或紧凑的空间里高效种植作物和树木——非常适合温馨的小基地。"
			]
			id: "0A131EB565206311"
			tasks: [{
				id: "6CFA9863500C8B01"
				title: "&b自动化农场"
				type: "checkmark"
			}]
			x: 2.5d
			y: 0.0d
		}
		{
			dependencies: ["6B71D98EFFC93A19"]
			description: [
				"&f制作令人难以置信的菜肴和厨房布置："
				""
				"&6• 方块头烹饪指南 (Cooking for Blockheads)"
				"&6• 大型餐食、蔬菜之乐、Alex's Delight 及其他美味模组"
				""
				""
				""
				"建造终极温馨厨房，烹饪能赋予强力增益的盛宴！"
			]
			id: "25DA2D248CC8EC78"
			tasks: [{
				id: "6FE496F53AB555F2"
				title: "&6Cooking n' Feasting"
				type: "checkmark"
			}]
			x: 0.0d
			y: -2.0d
		}
		{
			dependencies: ["6B71D98EFFC93A19"]
			description: [
				"&f掌握酿造和发酵饮品的艺术："
				""
				"&6• [Let's Do] 酿酒与酿酒坊"
				"&6• HerbalBrews"
				"&6• 盛宴：酒精饮品"
				""
				""
				"酿造美味的葡萄酒、啤酒和烈酒，庆祝丰收的喜悦。"
			]
			id: "5C365B3227CB5173"
			tasks: [{
				id: "68EF0B2601E9F78B"
				title: "&d酿造与酿酒术 (Brewing n' Vinery)"
				type: "checkmark"
			}]
			x: 2.5d
			y: -2.0d
		}
		{
			dependencies: ["0A131EB565206311"]
			description: [
				"&aOne of the most useful mods in Verdant Haven is **Botany Pots**!"
				""
				"这些魔法花盆能让你在室内种植几乎所有植物、作物、树苗，甚至花卉——无论生物群系、光照等级或季节如何。"
				""
				"结合 **Botany Trees**，你现在可以在家种植整棵树，让你的基地全年都充满生机与绿意。"
			]
			id: "7B45BF18949CA12D"
			tasks: [{
				id: "52E03469D32EC190"
				item: "botanypots:terracotta_botany_pot"
				type: "item"
			}]
			title: "&a植物学花盆"
			x: 4.5d
			y: -1.0d
		}
		{
			dependencies: ["7B45BF18949CA12D"]
			description: [
				"&a掌握了基础植物学花盆后，就该升级到**漏斗植物学花盆**了！"
				""
				"这些升级后的花盆能自动收获作物并输出到下方的物品栏中，让大规模自动化农业变得更轻松、更高效。"
				""
				"结合 **Create** 和 **Botany Trees**，你现在可以建造令人印象深刻的室内自动化农场和果园。"
			]
			id: "24BEE174C10F4203"
