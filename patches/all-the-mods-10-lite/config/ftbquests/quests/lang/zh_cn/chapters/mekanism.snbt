# AI 初翻，未人工校对
{
	quest.001DE8028CAF0A08.quest_subtitle: "嘘嘘嘘……太吵了……"
	quest.019D5A05A2134C7E.title: "&d原子合金"
	quest.027084AE2DF5EBA6.quest_desc: ["Thermal Evaporation Plant 的多方块结构会根据内部温度产生盐水。\\n\\n有多种方法可以提高工厂的温度，包括在沙漠中建造！\\n\\n&aFuelwood Heater&r 会燃烧一桶桶熔岩，可以通过导热管道输送熔岩。\\n\\n&aResistive Heater&r 使用 RF/FE 产生热量，并且可以设置使用任意数量的 RF/FE。"]
	quest.027084AE2DF5EBA6.quest_subtitle: "热盐水在此。在此获取你的热盐水。"
	quest.027084AE2DF5EBA6.title: "提高我们的盐水生产效率"
	quest.0498A578D0EC3254.quest_desc: ["在冶金注入器中用红石注入锇，就能制作出其中一个。"]
	quest.0498A578D0EC3254.quest_subtitle: "基础控制电路"
	quest.04E2D539E33B7B0F.quest_desc: ["这台机器能将两种气体结合，生成一种新气体。\\n\\n你需要用它将氯气和氢气结合，生成氯化氢，然后用于我们的化学注射室。"]
	quest.04E2D539E33B7B0F.quest_subtitle: "化学合成器 (The Chemical Combiner)"
	quest.0650996C7818ADB5.quest_desc: ["热能发电机有2种发电模式：\\n\\n&9被动模式：&r用岩浆源或流动岩浆块包围发电机，通过产生热量来发电。在顶部放置一个岩浆源块，并让它从侧面流下。务必先连接管道！\\n\\n&9主动模式：&r将煤炭或木材等可燃物放入发电机，燃烧燃料来发电。"]
	quest.0650996C7818ADB5.quest_subtitle: "基础电力生成器"
	quest.07AD45DCF9EE3C2E.quest_desc: ["此物品可将基础机器升级为初级工厂机器。"]
	quest.07AD45DCF9EE3C2E.quest_subtitle: "升级到自动化工厂系统"
	quest.08DDE018A804BFE7.quest_desc: ["这台机器像Macerator或Pulverizer一样，能将矿石分解成粉尘。\\n\\n它将3种原矿分解成4种粉尘。\\n\\n这是你矿石工厂的起点。它还可以升级为工厂机器，增加使用槽位。"]
	quest.08DDE018A804BFE7.quest_subtitle: "将原始矿石破碎成粉尘"
	quest.09408C6DCAC90318.quest_desc: ["此方块可储存能量，也可用于为物品充电。"]
	quest.09408C6DCAC90318.quest_subtitle: "储存能量"
	quest.0F326EEEC2EBE4E5.quest_desc: [
		"使用富集室，你可以富集物品，将其转换为富集版。"
		""
		"这些“富化”物品在冶金注入器中提供的金属块数量是普通物品的8倍。"
		""
		"如果你想制造大量钢铁，请先富集木炭！"
	]
	quest.0F326EEEC2EBE4E5.quest_subtitle: "先让你的物品变得更丰富吧！"
	quest.1112E4E2CCEB2467.quest_desc: ["现在，你应该有5台机器可以处理矿石了。准备好让事情变得更复杂吗？\\n\\n你的工厂流程应该是：化学注入室 > 净化室 > 破碎机 > 富集室 > 熔炉/冶炼炉。\\n\\n到目前为止很简单，对吧？\\n\\n那么，系好安全带。事情要变得疯狂了。"]
	quest.1112E4E2CCEB2467.quest_subtitle: "Tier 3 矿物加工厂"
	quest.162CE44400A63575.quest_desc: ["冶金注入器用于制作Mekanism中的核心合成组件。\\n\\n该机器通过将材料（中间偏左槽）与“注入器”（最左槽）结合来工作。\\n\\n这也是获取钢锭的方法。"]
	quest.162CE44400A63575.quest_subtitle: "初始机器 (The Starting Machine)"
	quest.166971866A9234C7.quest_desc: ["在冶金注入器中，将&6铜锭&r与&4红石粉&r结合，可制作出&c注入合金&r。"]
	quest.166971866A9234C7.quest_subtitle: "用于制作物品的基础合金"
	quest.166971866A9234C7.title: "&cInfused Alloy（融合合金）"
	quest.18D88932916C7A98.quest_desc: ["电解分离器（名字挺长的）用于将化学物质从特定液体和气体中分离出来。\\n\\n如果你打算建造一个矿物加工厂，就需要一大堆这个。\\n\\n首先，制作一个这个，然后我们来分解最基本的流体：水。"]
	quest.18D88932916C7A98.quest_subtitle: "是时候分解一下了"
	quest.195729280394ABFB.quest_desc: ["机器会创造两种非常强大的锭：精炼萤石和精炼黑曜石。\\n\\n它将物品与锇融合，创造出更强大的锭。"]
	quest.195729280394ABFB.quest_subtitle: "真正有用的东西只有两种用途"
	quest.1B6DDF50D00CBB31.quest_desc: ["在冶金注入器中用煤炭或木炭注入铁，会获得富化铁。\\n\\n将富化铁用更多煤炭或木炭注入，会获得钢粉，可以熔炼成钢。\\n\\n这是Mekanism中许多配方的重要合成组件。"]
	quest.1B6DDF50D00CBB31.title: "钢铁"
	quest.1FC7E9DBF92BE6AA.quest_desc: ["此物品用于储存能量，功能类似于便携式电池组。\\n\\n它也是 Mekanism 中重要的合成材料。"]
	quest.1FC7E9DBF92BE6AA.quest_subtitle: "便携式电池组"
	quest.23F165DEAD225B10.quest_subtitle: "用于传输能量"
	quest.263220DCCDB90E29.quest_desc: ["到目前为止，要将我们的锭产量“翻倍”，你的装置应该大致如下：\\n\\n原矿进入你的&a净化室&r，由&6电解分离器&r提供&a氧气&r。\\n\\n产物随后输出到&a破碎机&r，将原矿块转化为“脏粉”。这些“脏粉”被送入&a富集室&r，转化为相应的“矿石粉”。\\n\\n&a富集室&r的输出则连接到你偏好的熔炉。"]
	quest.263220DCCDB90E29.quest_subtitle: "Tier 2 矿物加工厂"
	quest.2E274BEEF2B0B8C7.quest_desc: ["好，我们先来制造二氧化硫。\\n\\n首先，将火药和氯化氢放入独立的&a化学注射室&r中，生成硫磺粉。或者，你也可以将热力系列的硫磺研磨成硫磺粉，随你喜欢。\\n\\n将硫磺粉送入这台机器，即&a化学氧化器&r，即可生成二氧化硫。现在我们需要制造三氧化硫。\\n\\n将二氧化硫送入化学注入器与氧气结合，生成三氧化硫。再将三氧化硫送入另一个化学注入器，与水蒸气结合，生成硫酸。\\n\\n步骤有点多。"]
	quest.2EF4DD5CC254CC80.quest_subtitle: "用于流体传输的装置"
	quest.31B73D16C0199785.title: "精炼黑曜石"
	quest.37D4E5ACB35D8BF1.quest_subtitle: "需要氢气才能运行！"
	quest.3999760881C855FA.quest_desc: ["这台机器将是你 Tier 4 矿石加工厂中的第 3 台。\\n\\n它将化学清洗机中的洁净矿石浆料转化为晶体，供化学注入室进一步处理。"]
	quest.3999760881C855FA.quest_subtitle: "将矿石浆液转化为晶体"
	quest.3B43DB1A6B0A7B44.quest_desc: ["破碎机还能将天然物质分解成生物燃料！"]
	quest.3C49F2EEDCCAF1DF.quest_desc: [
		"如果你像我一样，可能在前几步里迷路了55次。这是一个复杂的系统。\\n\\n工厂的基本布局应该是：\\n\\n原矿进入化学溶解室 > 将气体泵入化学洗涤器 > 将气体泵入化学结晶器 > 将晶体输出到化学注射室 > 将碎片输出到净化室 > 将块体输出到破碎机 > 将脏粉输出到富集室 > 将净粉输出到熔炼炉。"
		"{image:atm:textures/questpics/mek/mekanism_flowchart.png width:300 height:150 align:1 fit:true}"
	]
	quest.3C49F2EEDCCAF1DF.quest_subtitle: "我知道，这有很多东西要处理。"
	quest.3EC9D0DA61B45328.quest_desc: ["此发电机可燃烧氢气和乙烯以产生电力。\\n\\n注意：燃烧氢气产生的电力不足以满足电解分离器的运行成本。请使用乙烯代替。"]
	quest.3EC9D0DA61B45328.quest_subtitle: "将气体燃烧转化为能量！"
	quest.407EFAF528871014.quest_desc: ["要开始分解水，我们需要一个水源。Kitchen Sink 能提供无限水，并且可以轻松设置来抽水。\\n\\n或者，你也可以使用经典的无限水源，搭配 Mekanism 的 Pump 来抽水。\\n\\n将水抽入你的 Electrolytic Separator 中，将其分解为氢气和氧气。"]
	quest.407EFAF528871014.quest_subtitle: "无所不能的无限水源模组"
	quest.407EFAF528871014.title: "水源 (Water Source)"
	quest.41EB0C570FC54F43.quest_desc: ["此方块用于储存气体。"]
	quest.41EB0C570FC54F43.quest_subtitle: "储存所有的气体"
	quest.4204702AA6FBF40B.quest_desc: ["站在该物品上可为任何模组的任何已充能物品充电。\\n\\n这也是Robit所需的物品。"]
	quest.4236B9F071BE18F3.quest_desc: ["要制作硫酸，你需要先制造&a水蒸气&r。\\n\\n将一些水泵入这台机器，它就会将其转化为蒸汽。"]
	quest.4434D7B66521D69A.quest_subtitle: "用于气体传输的装置"
	quest.47106CE1937C4340.quest_desc: ["要获得 HDPE 板，请在富集室中放置 3 个 HDPE 颗粒。"]
	quest.488DBE69595F38F8.quest_desc: ["这台机器可以熔炼物品。\\n\\n它可以升级为熔炼工厂，将熔炼槽的总数最多增加到9个。"]
	quest.488DBE69595F38F8.quest_subtitle: "Mekanism 的 Powered Furnace"
	quest.49675EA8CBCA1388.quest_subtitle: "Mekanism 的 All In One 工具"
	quest.4A1C8125896F7F1A.quest_desc: ["此任务由 &6AllTheMods Staff&r 或 &2社区贡献者&r 为 AllTheMods 整合包创作。\\n\\n所有 &6AllTheMods&r 整合包均受 &eAll Rights Reserved&r 许可，未经明确许可，不得将此任务用于非 &6AllTheMods Team&r 发布的任何公共整合包中。\\n\\n此任务被有意隐藏，若你看到此内容，则表示你处于编辑模式。"]
	quest.4AFF81D3D0E78255.quest_desc: ["这台机器需要水才能运行，并利用水将“矿石浆料”清洗成“干净矿石浆料”。\\n\\n它将成为你 Tier 4 矿石加工厂的第二部分。"]
	quest.4AFF81D3D0E78255.quest_subtitle: "给矿石洗个澡"
	quest.4BDE773C3359D584.quest_subtitle: "陪伴你旅行的迷你机器人伙伴"
	quest.4EDD96EB60EF5814.quest_desc: ["如果你想知道是否值得进行此升级，答案是肯定的。\\n\\n此版本可用于为热蒸发植物增加额外热量。"]
	quest.4EDD96EB60EF5814.quest_subtitle: "每秒产生约 410FE 的能量"
	quest.4F1C04C0F6769825.quest_desc: ["这台机器是你矿石加工厂的下一步。将其添加到净化室的左侧，即可扩建你现有的矿石工厂！\\n\\n这台机器需要 &a氯化氢&r 才能运行。要了解如何制造氯化氢，请遵循上面的任务！"]
	quest.4F1C04C0F6769825.quest_subtitle: "将3个原始矿石转化为8个矿石碎片"
	quest.4F436770D30D8520.quest_desc: ["我们需要在现有装置上再增加3台机器。\\n\\n流程的第一步是化学溶解室。\\n\\n这台机器需要&a硫酸&r将原矿分解成“矿石浆料”。\\n\\n要获得硫酸，我们需要一个新装置，具体说明将在后续任务中给出。"]
	quest.4F436770D30D8520.title: "Tier 4 矿石工厂的开端"
	quest.5047792C6EF6D2AD.quest_desc: ["将生物燃料与水和氢气在&a高压反应室&r中结合，可生成底物。同时也会产生副产品乙烯。\\n\\n这些是制造HDPE颗粒所必需的，而HDPE颗粒可用于制作Meka-suit等终局物品。"]
	quest.531E3FF1F2865C67.quest_subtitle: "用于热量传递的装置"
	quest.58445E5B3957ACC8.title: "精炼发光石"
	quest.587A19FC348387C5.quest_desc: ["将气体、固体物品和液体结合，以产生物品和副产品。\\n\\n这台机器是制造游戏后期材料和护甲所必需的。"]
	quest.58B125BD4876054C.quest_desc: ["Mekanism 是一款会改变你 Minecraft 玩法的科技模组。\\n\\n该模组专注于将材料分解为其化学成分，从而充分利用你遇到的每一种材料。\\n\\n此模组包含氢动力喷气背包、迷你机器人伙伴、反应堆、用于自动化采矿的数字矿工，以及更多内容。"]
	quest.58B125BD4876054C.quest_subtitle: "属于你自己的工厂的开端"
	quest.58B125BD4876054C.title: "&dMekanism&r"
	quest.5B681BC43371CC5C.quest_subtitle: "用于物品传输"
	quest.5E116409DC7D30BB.quest_desc: ["此物品用于配置 Mekanism 中的许多物品，例如更改管道为“拉入或推入”或旋转机器。"]
	quest.5E116409DC7D30BB.quest_subtitle: "Mekanism 的扳手"
	quest.603877AB96321F1A.quest_desc: [
		"要为机器获取氯化氢，我们首先需要制造&a盐水&r。\\n\\n为此，我们需要一个热蒸发装置。这是一个多方块结构。\\n\\n首先，建造一个中间为空心、底部实心的4x3x4结构。任何侧面都可以替换为控制器或阀门。\\n\\n你需要至少1个控制器和至少2个阀门。\\n\\n泵入水后，你就会开始收集盐水，可以将其泵入&a电解分离器&r，从气体中提取&6氯气&r。"
		"{image:atm:textures/questpics/mek/thermalplant.png width:100 height:100 align:1}"
	]
	quest.603877AB96321F1A.quest_subtitle: "水变成了盐水！"
	quest.603877AB96321F1A.title: "热蒸发植物工厂"
	quest.6C25D42C36175BF4.quest_desc: ["这台机器可以“提纯”我们的矿石。它将1个原矿转化为2个“矿块”，然后送入破碎机变成脏粉，再经过富集室得到干净粉末，最后通过熔炉冶炼成锭。\\n\\n这将使你的锭产量翻倍。\\n\\n该机器运行需要&a氧气&r，氧气是通过将水泵入&6电解分离器&r来产生的。"]
	quest.6C25D42C36175BF4.quest_subtitle: "它会生成成团的方块。"
	quest.6CD1720B76F47806.quest_desc: ["此发电机将生物燃料燃烧为能量。每小时可产生约140FE。"]
	quest.6DB1AAAD926486BC.quest_desc: ["流体储罐可以储存液体。\\n\\n它有桶模式，可以切换用来舀取液体。前期对付岩浆非常有用！"]
	quest.6DB1AAAD926486BC.quest_subtitle: "它有桶模式！BUCKET MODE！"
	quest.6F62B5510FA881CD.quest_subtitle: "基础锻造锭 The Base Crafting Ingot"
	quest.6F62B5510FA881CD.title: "锇（Osmium）"
	quest.74200A48498DD7F8.quest_desc: ["利用太阳能来发电！"]
	quest.74200A48498DD7F8.quest_subtitle: "每秒产生约 51FE 的能量"
	quest.76A38CCA5816CDAD.quest_desc: ["在&a高压反应釜&r中结合氧气、乙烯和基质将生成HDPE颗粒。"]
	quest.76A38CCA5816CDAD.title: "HDPE颗粒"
	quest.7778937DF377C1B4.quest_desc: [
		"这是一个生成能量的绝佳选择。"
		""
		"海平面处可产生约 96FE/t，高度越高，发电量越大！Y 坐标越高，发电量越多！"
	]
	quest.7778937DF377C1B4.quest_subtitle: "利用风力产生能量"
	quest.7940E814260C556F.title: "&b强化合金"
	quest.7AE502EDB73BD57A.quest_desc: ["这台机器将矿石压成“脏粉”形态。这有助于将矿石块转化为脏粉，脏粉可通过富集室生成矿石粉，再冶炼成锭。"]
	quest.7AE502EDB73BD57A.quest_subtitle: "它会摧毁一切东西。"
	quest.7B0DFA55B4D8B16D.quest_desc: ["要创建自定义传送门，放置一个单独的 Teleporter 方块。为该方块连接电源。\\n\\n使用 Teleporter 方块作为底座，创建一个“传送门框架”。\\n\\n最终产物将是一个 4x3 的传送门结构，中间的两个方块构成传送门。"]
	quest.7B0DFA55B4D8B16D.quest_subtitle: "最棒的传送体验，尽在掌握之中"
	quest.7B0DFA55B4D8B16D.title: "自定义传送门！"
	quest.7CC49360D07086B8.quest_desc: ["此物品是实现无线传输的关键。\\n\\n你可以为其设置特定的、由你命名的频道，以传输任何你想要的物品。"]
	quest.7CC49360D07086B8.quest_subtitle: "无线电力、气体、流体，无所不包。"
	quest.7EA6B942D1294ED6.quest_desc: ["这台机器可以为你挖矿！\\n\\n它完全可配置，甚至可以用你提供的任何方块，比如鹅卵石，来替换挖出的方块！"]
	quest.7EA6B942D1294ED6.quest_subtitle: "一个更大的机器人朋友。"
	task.3B3B58C438FD4397.title: "Tier 4 矿物加工厂摘要"
	task.46C4C1AD9FA5BEE2.title: "我们目前的配置情况如下"
	task.4B60ACBCC3B46D1D.title: "富化物品"
	task.57F40CFA03BD36EF.title: "困难的部分来了"
	task.62F11A588B293CA6.title: "AllRightsReserved"
	task.6E75525A5D88EF23.title: "加热器"
	task.770B8B984F85AB73.title: "AllRightsReserved"
}
