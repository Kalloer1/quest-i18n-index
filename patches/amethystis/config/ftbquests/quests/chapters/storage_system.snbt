	quest_links: [ ]
	quests: [
		{
			id: "7D6E324E04A0E740"
			subtitle: "Diese Quest Line zeigt dir, wie du die verschiedenen Aspekte der Magie meistern kannst"
			tasks: [{
				id: "796EFE2389F203A9"
				title: "这个存储系统怎么样了？"
				type: "checkmark"
			}]
			x: 0.0d
			y: 0.5d
		}
		{
			id: "077E8377E9E431E5"
			progression_mode: "linear"
			subtitle: "Dieses Item ist für das System unerlässlich. Platziere es neben Truhen. Truhen, die neben anderen Truhen stehen, werden ebenfalls vom Inventory Connecter erkannt. Stelle am besten eine Reihe von Truhen auf und platziere den Connector irgendwo, damit er von dort aus weiterleiten kann."
			tasks: [{
				id: "776849FF3E08F777"
				item: "toms_storage:ts.inventory_connector"
				type: "item"
			}]
			x: 1.5d
			y: 0.5d
		}
		{
			id: "4C2598B5660CFAC3"
			progression_mode: "linear"
			subtitle: "Du kannst dir auch nur ein Storage Terminal craften, aber das macht wenig Sinn. Dieser Block dient als Zugriff auf dein gesamtes Lager. Du kannst mit diesem Exemplar craften und Dinge rein und aus dem Lager nehmen/legen. Die Terminals funktionieren nur, wenn sie an einem Inventory Connector platziert sind."
			tasks: [{
				id: "3C31C63374D63FF0"
				item: "toms_storage:ts.crafting_terminal"
				type: "item"
			}]
			x: 3.0d
			y: 0.5d
		}
		{
			id: "76234CE24F19673C"
			subtitle: "Ohne diese Items wird es schwierig. Falls dein Kistenlager weiter entfernt ist, kannst du per Kabel den Inventory Connector bei deinen Kisten mit dem Connector verbinden, der an deinem Terminal ist. Und zwar so: Falls Items in Connectors oder Truhen erkannt werden sollen, platziere einen Inventor Cable Connector. Von da aus ziehst du normale Kabel bis zum nächsten Inventory Connector."
			tasks: [
				{
					id: "7DE397046611B80D"
					item: "toms_storage:ts.inventory_cable_connector"
					type: "item"
				}
				{
					id: "1BE990118DDB63BF"
					item: "toms_storage:ts.inventory_cable"
					type: "item"
				}
			]
			x: 4.5d
			y: 0.5d
		}
		{
			id: "295E4D86A9E04FAA"
			subtitle: "当然，这些线缆并不适合所有基地。你可以将它们重制为 framed 部件，然后用任意原版方块进行伪装。为此，你需要 A Frame 线缆和 B Painter。用 Painter 可以选择原版方块，然后用 Painter 选择 Framed 方块。"
			tasks: [
				{
					id: "5B8EE82E8DC67F8F"
					item: "toms_storage:ts.inventory_cable_framed"
					type: "item"
				}
				{
					id: "49BA8F9DC943AE72"
					item: "toms_storage:ts.inventory_cable_connector_framed"
					type: "item"
				}
			]
			x: 6.0d
			y: 0.5d
		}
		{
			id: "12D887F04D5D922A"
			subtitle: "Jetzt wird es stark und Advanced. Mit einem Normalen Wireless Terminal erweiterst du deine Reichweite um nur 16 Blöcke. Deshalb holt man sich diesen Advanced Wireless Terminal ran. Der hat aber auch einen haken denn nur mit ein Netherite ist es nicht getan. Die Basis reichweite ist bei 64 Blöcken. Und auch nur in dieser Dimension. Um es von egal welcher Reichweiter in dieser Dimension funktionieren zu lassen brauchst du einen Level 1 Beacon. Also bps 9 Goldblöcke und ein Beacon in der Mitte. Dieser muss in 8 Block reichweite sein eines Inventory Connectors. Der Chunk muss dabei auch permanent geladen sein das geht mit einem \"Chunk Loader\". Um es von JEDER DImension erreichbar zu machen brauchst du einen Full Beacon (Level 4). Im Beacon selber siehst du wie sowas aussieht. Im Crafting Terminal selbst siehst du dann ein Symbol eines Beacon ob der erkannt wurde und welches Level er hat."
			tasks: [{
				id: "10023EE431FE2CBF"
				item: "toms_storage:ts.adv_wireless_terminal"
				type: "item"
			}]
			x: 7.5d
			y: 0.5d
		}
		{
			id: "62787A1F078E9ACA"
			subtitle: "无线传输或特定农场需要Chunk Loader。它们并不贵，但请注意。请遵守Discord服务器的规定。只有在必要时才放置一个。请节约使用。因此，一个“Single Chunkloader”对于存储系统来说应该足够了。"
			tasks: [{
				id: "65F362FF3249762C"
				item: "chunkloaders:single_chunk_loader"
				type: "item"
			}]
			title: "注意"
			x: 7.5d
			y: 2.0d
		}
		{
			id: "1A1F2D44A32D5859"
			subtitle: "Man kann auch alles filtern. Alle Filter-Items findest du in JEI, wenn du unten rechts in der Inventar-Suchleiste \"@Simple\" eingibst. Halte Shift gedrückt, um die Beschreibung zu sehen."
			tasks: [{
				id: "7AF67B1B063740DC"
				item: "toms_storage:ts.inventory_cable_connector_filtered"
				type: "item"
			}]
			x: 9.0d
			y: 0.5d
		}
	]
	title: "存储系统"
}
