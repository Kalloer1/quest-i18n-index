	quest.20CDFF148D236D98.title: "自动合成"
	quest.21426F5EEC922866.quest_desc: ["半沉于海洋的，是一具巨兽的石化遗骸，其骨架绵延至视野尽头。它是远古被冲上陆地的深海生物，还是从天堂坠落的天外来客？史册无载，唯有刻于石上的疑问。"]
	quest.21426F5EEC922866.quest_subtitle: "找到一个泰丰（Typhon）"
	quest.2190515C904C5133.quest_subtitle: "完成所有“Wizardry”任务章节"
	quest.21988C497C041260.quest_desc: ["将12只蜜蜂的针重新装上，拯救它们免于死亡。"]
	quest.21AD48D2E133C28E.quest_desc: ["杀死32只蜘蛛。洞穴蜘蛛不算。蜜蜂不喜欢蜘蛛。"]
	quest.21B62932B77BAE35.quest_desc: [
		"药水混合装置包括："
		""
		"&5Potion Melder&r"
		"将两瓶药水合成为三剂具有综合效果的药水。使用来自熔炼器的药水瓶中的支配魔杖来链接瓶子以供消耗。将两个输入药水瓶连接到熔炼器，然后用魔杖点击熔炼器，再指向第三个瓶子以设置输出。药水熔炼器每次混合都需要一个来源。"
		""
		"&5药水扩散器&r"
		"消耗一瓶药水并将其施加给附近的实体，极大地延长了药水的使用时间。使用时，用Dominion Wand将Potion Jar绑定到扩散器上。每10分钟，扩散器会消耗一瓶药水，并在几秒钟内将其施加。"
		""
		"&5药水瓶&r"
		"最多可存储100瓶药水的罐子。使用空瓶、药水瓶或箭矢作用于罐子即可移除药水。Wixies会在自动酿造药水时使用这些罐子。潜行时使用Dominion Wand可将罐子锁定。被锁定的罐子只会从Wixies那里收到其锁定的药水。可与比较器配合使用。"
	]
	quest.21B62932B77BAE35.title: "药水混合实验台配方："
	quest.21F4C990F426E32B.quest_subtitle: "收集所有音乐唱片"
	quest.21F4C990F426E32B.title: "音乐之声 (The Sound of Music)"
