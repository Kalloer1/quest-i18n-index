	]
	quest.3CCB559BCAB1B69C.quest_subtitle: "保护动力装置（Protect the Impetus）"
	quest.3CCFE60CB3DA9A63.quest_desc: ["衡量系统的熵和稳定性。 &6&l熵值计数器&r&l&r 提供反馈，帮助优化和稳定由 Ember 驱动的机器。"]
	quest.3CD1A691BB9D92B1.quest_subtitle: "驾！牛仔们！"
	quest.3CE5551031D8BB4D.quest_desc: ["显示存储系统中特定资源的当前数量。"]
	quest.3CEBEFF81FF279FE.quest_desc: ["改进插槽以升级线程，高效率和法力再生。"]
	quest.3CEBEFF81FF279FE.title: "学徒"
	quest.3CFA567B98856D6F.quest_desc: ["一些村民似乎对你有好感，愿意加入你，如果你想建立自己的城镇。好好照顾他们，我相信你的城镇会吸引更多村民。"]
	quest.3CFA567B98856D6F.quest_subtitle: "与村民交易以获得奖励！"
	quest.3CFA567B98856D6F.title: "与村民的交易 III"
	quest.3D0087322543B31D.quest_desc: [""]
	quest.3D0087322543B31D.quest_subtitle: "正在增强材料，请稍候。"
	quest.3D1C0F80B74B27D5.quest_subtitle: "抵达一座灯塔"
	quest.3D40D539C72FEE73.quest_desc: [
		"&bRunewood Obelisk&r 会加快 &6Spirit Altar&r 的速度。"
		""
		"在祭坛附近放置最多四个。"
		""
		"每座方尖碑都将注入速度提高25%。"
		""
		"使用它们来缩短处理时间。"
	]
	quest.3D40D539C72FEE73.quest_subtitle: "更快的灵魂灌注速度"
	quest.3D432C3BD00D8FF8.title: "机械齿轮村庄"
	quest.3D446713803B10EE.quest_desc: [
		"赛博增强中心是一个终局的多方块设施，能让你研究并永久地将机器人升级安装到自己身上。"
		"{@pagebreak}"
		"通过安装专门的副车研究站（基础、量子和奥术），你可以消耗资源和能量来解锁飞行、夜视、加速和自动进食等永久玩家能力。"
	]
	quest.3D446713803B10EE.title: "增强应用程式"
	quest.3D4AE8E64B761BB0.title: "烈焰征途"
	quest.3D5973731CD4373C.quest_desc: ["{image:gamma_creatures:textures/screens/meloron_eng2.png width:150 height:100 align:center fit:true}"]
	quest.3D644B9C5CC46427.quest_subtitle: "额外的运气和增加的原石挖掘距离"
	quest.3D7EC35D193066EB.quest_desc: ["一本记录模组 &dArs Nouveau&r 的书籍。虽然任务章节 &e\"魔法基础\"&r 能为你提供良好开端，但这本书记载了关于该模组及进阶技巧的更深入知识。"]
	quest.3D7EC35D193066EB.quest_subtitle: "关于 Ars Nouveau 的详细说明！"
	quest.3D7EC35D193066EB.title: "磨损的笔记本"
	quest.3D8BCCFCEFEA77BE.title: "高地田野"
	quest.3D8D65EE1F5BBE38.quest_desc: ["为系统储存大量流体。储液罐作为中央储罐，为 Ember 机器提供持续运行所需的液体。"]
	quest.3D9C95CE885F5BA8.quest_desc: ["杀死 4 只 &5末影幼虫&r。"]
	quest.3DA151EFD73220F6.quest_desc: [
		"诞生于无头骑士的传说，&6南瓜领主&r发誓要摧毁所有召唤他的人。不要指望有顶棚的桥能帮你逃脱，他会紧追不舍。如果你能把他从马上拽下来，战斗还有两个更致命的阶段。头颅可以脱离身体存活，但如果头颅被毁，身体便会消亡。"
		"{@pagebreak}"
		"右键点击&6Infernal Evil Pumpkin&r并使用&aTransmuting Elixir&r即可召唤Lord Pumpkinhead。"
	]
	quest.3DC0A0DC4DA66211.quest_desc: ["高级书籍，可在清理远古城市后用作终局魔咒书"]
	quest.3DC0A0DC4DA66211.title: "Codex 专家"
	quest.3DD5EBA72E439D1E.quest_desc: ["手持区块加载器，右键击打恶魂即可填充。安山岩区块加载器可加载单个区块。"]
	quest.3DD5EBA72E439D1E.title: "安山岩区块加载器"
	quest.3DE866DDF6CA85FD.title: "智慧之树"
	quest.3E07D228EA16C682.quest_desc: [
		"当你把&5便条&r交给前台接待员时，她灿烂地微笑着问道，"
		""
		"&b\"你想要什么呢？\""
		""
		"&a财富？&r"
		"&2力量？&r"
		"&b珍贵的宝石？&r"
		"&6食物？&r"
		"&3经验值？&r"
		"&b或者，或许还有更多的&5悬赏和冒险？&r&b\""
	]
	quest.3E07D228EA16C682.quest_subtitle: "兑换公会大师的笔记以获取奖励！"
	quest.3E07D228EA16C682.title: "交易：公会大师的奖励笔记"
	quest.3E208A3A81A12D53.quest_desc: ["{entity:mythsandlegends:black_charro ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:USE_GLOBAL width:100 height:100 align:center}"]
	quest.3E6F275611819111.quest_desc: [
		"&6Mechanical Belts&r 可在传动轴之间传递旋转动力，也可沿其长度输送物品或实体。"
		""
		"要放置传送带，至少需要两个&6Shafts&r。"
		"右键点击第一个竖井，然后点击第二个以连接它们。"
		"无论连接多长，都只使用一个传送带物品。"
		""
		"传送带可以连接水平、垂直或对角排列的转轴。"
		"它们之间的最大距离是 &620 格&r，路径必须畅通无阻。"
		""
		"&6安山岩外壳&r 或 &6黄铜外壳&r 可用于装饰腰带部件。"
	]
	quest.3E6F275611819111.quest_subtitle: "能量和物品传输系统"
	quest.3E7C748B00FAB751.quest_desc: ["这个整合包难点在于，许多功能高度集成，难以拆分。不过，很多模组都经过高度配置（说的就是你，Apotheosis...）来平滑一些粗糙之处。 &b如果你在Discord提出请求，我们愿意帮你移除模组&r（Ars Nouveau、Create和少数其他模组除外，不幸的是，它们是整合包的基础）。"]
	quest.3E855ADF431DCB49.quest_desc: [
		"&a优点：&r"
		"&8●&r 采矿爆炸会掉落额外物品"
		"&8●&r 爆炸式采矿能提高资源获取效率"
		""
		"&4缺点：&r"
		"&8●&r —"
		""
		""
		""
		"&8基座物品：&r"
		"8x 烈焰粉"
		"4x 原始黄金"
		""
		"&8核心物品：&r"
		"12x Gunpowder"
		""
		"&8灵魂：&r"
		"16x &#FA9A1FInfernal&r"
		"16x &#48EE19Earthen&r"
		"16x &#EE2C88神圣&r"
	]
	quest.3E855ADF431DCB49.quest_subtitle: "让自己沉浸在贪婪之中吧"
	quest.3EAB8449F3BAC667.quest_desc: [
		"&6齿轮&r用于传递旋转动力。"
		""
		"&6大型齿轮&r支持更高级的装置，例如让旋转绕过拐角，或连接到&6旋转速度控制器&r。"
		""
		"两个相邻的&6Cogwheel&r会朝相反方向旋转。"
		""
		"两个垂直放置的&6大型齿轮&r可将旋转传递到另一轴，且速度不变。"
		""
		"将&6Cogwheel&r与&6Large Cogwheel&r对角放置可改变速度。"
		"大齿轮的转速是小齿轮的一半。"
		""
		"通过组合不同尺寸，转速可加倍或减半，最高可达 &6256 RPM&r。"
	]
	quest.3EAB8449F3BAC667.quest_subtitle: "基础旋转转移"
	quest.3ECA226F08D5195F.quest_desc: ["隐藏在群山与山谷之间，这座修道院是危险世界中一处宁静的庇护所。村民们在此过着祈祷与劳作的生活，不受掠夺者侵扰。尽管殿堂中并无多少宝藏，但其坚固的墙壁与宁静的氛围，使其成为疲惫冒险者的理想避难所。"]
	quest.3ECA226F08D5195F.quest_subtitle: "找到一个修道院"
	quest.3F062C3715898E58.quest_desc: ["{image:gamma_creatures:textures/screens/dogishi_eng2.png width:150 height:100 align:center fit:true}"]
	quest.3F2E272663BECA1F.title: "Mott"
	quest.3FA36BF576843022.quest_desc: ["{entity:mowziesmobs:frostmaw ent_size:0.75 off_x:0.0 off_y:-0.2 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:USE_GLOBAL width:100 height:100 align:center}"]
	quest.3FBC763FCE6DBB86.quest_desc: ["要充能电池，请制作一个 &2Chronon Generator&r。将其放在物品栏或 Curios 栏位中，即可被动生成 &2Chronons&r，并流入附近的电池和设备中。"]
	quest.3FBC763FCE6DBB86.quest_subtitle: "生成中，需要多长时间？"
	quest.3FC3D70076B6DDF0.quest_desc: [
		"这是一种可能与&e远古遗迹&r相关的史前巨兽。但由于这两种生物都由化石构成，且过于凶猛无法安全接近研究，考古学家尚未确定它们之间的确切关系。&6Skeletosaurus&r凭借其绝对的力量和体型压倒敌人，迅速猎杀猎物。坚固的脚和带刺的尾巴是其天生的绝佳武器。若你斩杀了这头巨兽，或许会捡到一只幼崽，需要照料并驯服它。"
		"{@pagebreak}"
		"Skeletosaurus 可以在各种 &6化石地点&r 和结构中被发现。"
	]
	quest.3FD44295355BD49B.quest_subtitle: "风暴线飞升能力。水与闪电学派加成"
	quest.3FD44295355BD49B.title: "Riptide Sovereign Armor"
	quest.3FED14D4D8B8C5DE.title: "热带雨林"
	quest.40133E6D438CF1D1.title: "远古传送门"
	quest.402628F72458D55B.quest_desc: ["喷气背包是 Oritech 系列中基础级别的垂直飞行护甲。它拥有 100,000 RF 的储能和可容纳 4 桶燃料的油箱，支持标准电力或液体燃料。"]
	quest.402628F72458D55B.title: "喷气背包"
	quest.4026ED47529EF499.quest_desc: ["&6玩家传送升级&f可让你传送到手持&2位置广播器&r或&6扫描设备&r的其他玩家处。"]
	quest.4026ED47529EF499.quest_subtitle: "正在扫描生命体形态"
	quest.403944D482FBA961.quest_desc: ["放置一些铁轨，手持火车站右键它们。最好选择一段长而平坦的轨道。打开火车站菜单，选择“创建新列车”。将火车外壳放置在任意高亮轨道上，将其变为转向架。然后，你可以在转向架上进行建造和设计你的火车。务必使用强力胶水将所有部件固定在一起。建造完成后，再次打开车站菜单，选择“组装列车”。注意：车上必须至少有一个火车控制器。"]
	quest.403944D482FBA961.title: "建造一辆火车"
	quest.404FF177CB141691.title: "小屋"
	quest.40AD704CCE937072.quest_desc: [
		"&6绳索滑轮&r可垂直移动装置，常用于挖掘或电梯。"
		""
		"它可以向下延伸最多 256 个方块。"
		""
		"装置上方放置的额外滑轮会自动同步，无需自身的旋转动力。"
		""
		"可以使用&6阈值开关&r来监控绳索的长度。"
	]
	quest.40AD704CCE937072.quest_subtitle: "垂直方向上的移动"
	quest.4106639299FA35BE.quest_desc: ["{entity:cataclysm:scylla ent_size:1.0 off_x:0.0 off_y:-0.2 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:USE_GLOBAL width:100 height:100 align:center}"]
	quest.4118927D9D079DC8.quest_desc: ["这些巨大的塔楼如尖刺般从地面升起，由缠绕着致命玫瑰的骷髅守卫。每一层都戒备森严，空中还有玫瑰守卫巡逻。只有登上顶峰的人，才能获得其中隐藏的宝藏和秘密。"]
	quest.4118927D9D079DC8.quest_subtitle: "前往荆棘之塔 (Thornborn Towers)"
	quest.411E75619F1C378C.quest_desc: ["不知怎地用&e毒刺长矛&r杀死了&0凋零&r。"]
	quest.415CD6CC10D4D7F2.quest_desc: ["{image:gamma_creatures:textures/screens/redthunder_eng2.png width:150 height:100 align:center fit:true}"]
	quest.41627C829F1C0684.title: "物品过滤器"
	quest.41A34FE87DD3EA6E.title: "堡垒遗迹"
	quest.41ACE04C5F44BBF1.title: "沉没的船只"
	quest.41CD8B330FFD9CB1.quest_subtitle: "增加法力值和再生率。附加法术强度"
	quest.41CD8B330FFD9CB1.title: "巫师套装"
	quest.41E311ABBAABFC87.quest_subtitle: "增加了攻击击退效果"
	quest.41FCDB46DA5FB7F6.quest_subtitle: "{components:{\"ftbquests:loot_crate\":\"relics\"},count:1,id:\"ftbquests:lootcrate\"}"
	quest.421DBFFF19DD7A4F.title: "小屋村庄"
	quest.424B875F88D10370.quest_subtitle: "我有两个侧面！"
	quest.4253F7A727F745CF.quest_desc: ["Boosted Exo Elytra 是 Oritech 飞行技术的终极高端空中变种，结合了重型喷气背包与滑翔机的移动方式。"]
	quest.4253F7A727F745CF.title: "喷气背包外骨骼鞘翅"
	quest.4281E238E86E010D.quest_desc: ["一种带有根系的白色花朵，根部含有珍贵的树脂。树脂结晶后，可被制成具有微妙魔法效果的熏香。"]
	quest.4281E238E86E010D.quest_subtitle: "隐藏树脂"
	quest.42963ECC905690BB.quest_subtitle: "完成所有“整装待发”任务章节"
	quest.42963ECC905690BB.title: "时尚达人"
	quest.42A44816F5A597CF.quest_desc: ["{image:gamma_creatures:textures/screens/turlan_eng2.png width:151 height:100 align:center fit:true}"]
	quest.42ED72476B62BA71.quest_desc: ["&5法师的魔法书&r允许你施放2阶及以下的符文"]
	quest.42FA5AE8D5124F92.quest_desc: ["{entity:cataclysm:the_harbinger ent_size:0.8 off_x:0.0 off_y:-0.1 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:USE_GLOBAL width:100 height:100 align:center}"]
	quest.42FEB5F8EBBC4E49.quest_desc: ["下一步是建造一台 Assembler 和一台 Centrifuge。提示：为升级和扩展留出空间。"]
	quest.42FEB5F8EBBC4E49.title: "组件组装中"
	quest.4304895AF86DC805.quest_desc: ["基础装备之后，难度更高。能让你在受击时承受更少伤害而存活。"]
	quest.4304895AF86DC805.title: "升级钻石"
	quest.430F86987CE5238E.quest_subtitle: "提高魔法抗性并增加法力值"
	quest.430F86987CE5238E.title: "银色盔甲"
	quest.4353E25AA0DCDB58.quest_subtitle: "&l&n&5传奇的冰匠锤，曾锻造出最伟大的武器！"
	quest.436231715C11E3BA.quest_desc: ["零星分布在野外，小股的掠夺者在其独特的紫色帐篷下扎营。尽管他们的补给微薄，战利品稀少，但他们的存在是一个警告，掠夺者的势力范围随着每个前哨站的建立而扩大。"]
	quest.436231715C11E3BA.quest_subtitle: "找到一个掠夺者营地"
	quest.4378B90E9375D1CD.quest_desc: [
		"&#6EC1FF简易仪式&r"
		""
		"激活时，会熄灭附近的生物并赋予火焰拥抱效果。"
		"此祝福可提供被动治疗效果。"
		""
		"[  ]"
		"[  ]"
		"[&#72EE19✧&r] &#72EE19Earthen&r"
		"[&#72EE19✧&r] &#72EE19Earthen&r"
		"[&#D546FF✧&r] &#D546FF秘法&r"
	]
	quest.4378B90E9375D1CD.quest_subtitle: "能治愈的火焰"
	quest.43935D97BB3B38D1.quest_subtitle: "墙壁攀爬能力"
	quest.439FFB4A65551718.quest_desc: ["真正的支柱会支撑住这个，并且永远不会倒下"]
	quest.439FFB4A65551718.title: "以圣之名（In the name of Holy）"
	quest.43AE9F7F76FCA7A7.quest_desc: [
		"&bRune Of Flowing Grasp&r 略微增加与方块互动的范围。"
		""
		"同时增加了物品拾取范围。"
	]
	quest.43AE9F7F76FCA7A7.quest_subtitle: "延长攻击距离"
	quest.43C71BED3454EB1A.quest_subtitle: "是时候传送了"
	quest.43C71BED3454EB1A.title: "时间和空间操控能力"
	quest.43DF5901292EE06B.quest_desc: ["简易重铸台允许你锻造蓝色及以下品质的物品"]
	quest.43F2C4EC814D8533.quest_subtitle: "回忆之旅 - 但有朋友相伴"
	quest.442B3A81C8E4329E.title: "风吹过的丘陵"
	quest.445F34F5990BBEFE.quest_subtitle: "面具中散发出微弱的力量。或许找到更多，就能发现它的去向……"
	quest.445F34F5990BBEFE.title: "面具的秘密"
	quest.446D0100403541F3.quest_desc: ["{image:gamma_creatures:textures/screens/golemd_eng2.png width:151 height:100 align:center fit:true}"]
	quest.4495444D3F04CFC2.quest_desc: [
		"不幸的是，你死掉了。幸运的是，我能让你复活。不过，你所有的装备都存放在死亡地点的 &aGravestone&r 里。"
		""
		"打破它来拿回你的物品！"
		""
		"你还有一个记录死亡坐标的&a讣告&r。"
	]
	quest.4495444D3F04CFC2.quest_subtitle: "找回你的补给品"
	quest.4495444D3F04CFC2.title: "死后世界 (Post-Mortem)"
	quest.449DCB90268523CD.title: "苔藓山丘村庄"
	quest.44D115281B0BFB75.quest_desc: ["传言中，有一艘&9飞行船&r悬浮于世界之上，闪烁着奇异能量。鲜有人敢靠近，因为归来者都讲述了诡异的光、扭曲的走廊，以及不属于这个世界的守护者。如果你胆敢，就去寻找它，揭开藏在其金属外壳下的秘密。"]
	quest.44D115281B0BFB75.quest_subtitle: "找到一个巨型蘑菇"
	quest.44DE680409A4B3AE.quest_subtitle: "传送到朋友身边"
	quest.44DE680409A4B3AE.title: "辅助之平板电脑"
	quest.44EF89410D2E3E0A.title: "尖塔群"
