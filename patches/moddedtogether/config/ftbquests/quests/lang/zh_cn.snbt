	quest.72FEE510C549DC11.quest_subtitle: "纯粹的原始力量"
	quest.731D092CBEF73010.quest_desc: [
		"首先，制作一个&b炼金术激励物&r。"
		""
		"Place it on the &bSpirit Crucible&r."
		""
		"至少插入以下物品："
