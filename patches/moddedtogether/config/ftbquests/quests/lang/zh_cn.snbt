	]
	quest.4FB1EB89EB09F3F4.quest_subtitle: "Impose weight"
	quest.4FE4A83E25720B57.quest_desc: ["{image:gamma_creatures:textures/screens/drazor_eng2.png width:150 height:100 align:center fit:true}"]
	quest.4FE6E91078023593.title: "燃烧的竞技场"
	quest.508D8075984EBD02.quest_subtitle: "&l&n&5A weapon blessed by the gods!"
	quest.508F651458C4E4F5.quest_desc: [
		"&6秘法砧&r用于改进法术。"
		""
		"放置一个咒语卷轴和相同稀有度的&b墨水&r来升级它。"
		""
		"You can also bind spells to weapons."
		""
		"将武器和法术卷轴放入&6秘法砧&r中。"
		"卷轴被消耗，武器获得了施放该法术的能力。"
	]
	quest.508F651458C4E4F5.quest_subtitle: "升级法术"
	quest.509E9CA83FBC780E.quest_subtitle: "找到一个钓鱼小屋"
	quest.50AC14CB91DC5C15.quest_desc: [
		"&6电梯滑轮&r用于制作可移动的电梯。"
		""
		"完整说明请查看&6Ponder&r场景&8(按住W)&r。"
	]
	quest.50AC14CB91DC5C15.quest_subtitle: "垂直运输系统"
	quest.50BFC79A5F49A376.quest_subtitle: "你真是太棒了！简直是个炸弹！"
	quest.50BFC79A5F49A376.title: "大炸弹"
	quest.50D5B1A83B9D874F.quest_subtitle: "&l&n&5一把斧头浸透了亡者的灵魂！"
	quest.50F2F6ABC40E7424.quest_desc: ["{image:gamma_creatures:textures/screens/zatlah_eng2.png width:150 height:100 align:center fit:true}"]
	quest.50F6FA24B2FDB42E.quest_desc: [
		"你看到瓶中信在波浪中漂浮。出于好奇，你捡起它，取出里面的信。信上写着"
		""
		"&b「召集所有钓鱼爱好者。快来渔夫小屋，与其他渔夫会面，讨论钓鱼策略，寻找志同道合的朋友。希望这封信能勾起你的兴趣，我们期待能钓住你！」&r"
	]
	quest.50F6FA24B2FDB42E.quest_subtitle: "你看到瓶中信在波浪中漂浮着……"
	quest.50F6FA24B2FDB42E.title: "海浪中的一瓶漂流瓶"
	quest.50FAEEFED34333DE.title: "被毁的堡垒"
	quest.50FECB5087B9E8B1.quest_desc: ["库存线缆非常适合在空旷区域连接你的库存网络。线缆也有不同类型。带框线缆可以上色，以融入周围的方块。"]
	quest.50FECB5087B9E8B1.title: "物品栏电缆"
	quest.5100CFAD43E7D67A.quest_desc: ["这座宏伟的堡垒如同征服的纪念碑，是掠夺者势力的堡垒。多个层级都有劫掠者和咒术师巡逻，旗帜上宣称着对土地的统治。大厅内是财富的密室，由唤魔者守卫，他们的魔法和凝视一样致命。"]
	quest.5100CFAD43E7D67A.quest_subtitle: "找到一个掠夺者堡垒"
	quest.511B4251A6FE1258.quest_desc: [
		"厌倦了箱子爆满？有了超先进的（但又很简单？）&6存储终端&r，再也不用担心！将其与物品连接器接入网络，即可在该网络中存储无限物品。无需担心整理，本机自带搜索工具。"
		""
		"&6这是访问宝库的绝佳装置。成千上万的物品触手可及！&r"
		""
		"&b注意：需要物品栏连接器才能同时访问多个宝库。"
	]
	quest.511B4251A6FE1258.quest_subtitle: "Tom's Simple Storage"
	quest.511B4251A6FE1258.title: "让存储变得简单"
	quest.512E3BB9064CEEC3.title: "冰封高地"
	quest.514A3B3B7CC903B7.quest_desc: ["{image:gamma_creatures:textures/screens/zatlah_eng2.png width:151 height:100 align:center fit:true}"]
	quest.5157AE29DAEBB0A1.title: "暗金属盔甲"
	quest.516DF3AB5A9E93AC.quest_desc: ["如有任何问题，欢迎在 Discord 上提问！&dCraisin&r 或 &eLeafyyy&r 通常在线回答问题。不过，请先确认你的问题是否已有解答。"]
	quest.516DFB2A23498B08.title: "机器产率附加组件"
	quest.517D927F6C015007.title: "被遗忘者的堡垒 (Bastions of the Forgotten)"
	quest.517D9D523E695937.quest_desc: ["AE2 装置的主要组件。要供电，请使用 &eAlternator&r 和相关 &eConnector&r 装置。请注意，连接到控制器的大型装置需要更多电力。"]
	quest.517D9D523E695937.quest_subtitle: "Nvidia 还是 AMD？"
	quest.51B328233482AFF8.quest_desc: ["Exo头盔是Oritech模块化外骨骼系统的一个高科技头盔组件"]
	quest.51B328233482AFF8.title: "Exo头盔"
	quest.51C5A13E468075F6.title: "Obsidilith Arena"
	quest.51D9307FA7FEDA46.title: "红树林沼泽"
	quest.51DA55FEB55D644A.quest_desc: ["{entity:minecraft:warden ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:USE_GLOBAL width:100 height:100 align:center}"]
	quest.51DCF05D37DCFC0D.title: "蘑菇小屋"
	quest.522E5672D2B41A32.quest_desc: ["更多插槽需要更多法力值。"]
	quest.5230D3587B041C15.quest_desc: [
		"&6旋转速度控制器&r可以精确控制旋转速度。"
		""
		"必须与一个 &6大型齿轮&r 搭配才能使用。"
		""
		"当齿轮为控制器供电时，它会通过侧面输出自定义速度。"
		"它还可以调整所连接的大型齿轮的速度。"
		""
		"&e配置&r"
		"使用正面或背面的数值设置面板来设定 RPM 和旋转方向。"
		""
		"最高速度为 256 RPM。"
	]
	quest.5230D3587B041C15.quest_subtitle: "速度控制"
	quest.52588FC8A1E4575E.quest_desc: ["&6知识库升级&r可访问游戏中的百科全书。"]
	quest.52588FC8A1E4575E.quest_subtitle: "便携式指南针"
	quest.52624498675F3C66.quest_desc: [
		"&a优点：&r"
		"&8●&r 受击时进入停滞状态"
		"&8●&r 静止期间药水效果会暂停"
		"&8●&r 不依赖时间的效果会保持生效"
		""
		"&4缺点：&r"
		"&8●&r 收到的治疗效果降低至四分之一"
		""
		""
		"&8基座物品：&r"
