	quest.72081153F57233FA.quest_subtitle: "{components:{\"ftbquests:loot_crate\":\"malum\"},count:1,id:\"ftbquests:lootcrate\"}"
	quest.721ADE33D5D8478F.quest_desc: ["Tier 2 魔法书允许你施放 Tier 2 的符文。足以应对本阶段的战斗"]
	quest.721ADE33D5D8478F.title: "专家模式"
	quest.722CF9AA7E95C28E.title: "远古工厂"
	quest.72375066092E95D3.title: "沙漠与沙丘"
	quest.7245C47C3CCC10F6.quest_desc: [
		"作为&5Obsidilith&r的远亲，&dEnder Guardian&r栖息于&5End&r之中。它常出现在End City内，被认为是&dEnder Guardian&r的具象化形态，即&dRuined Citadel&r。这种生物极为孤僻，会攻击任何闯入其领地者。为防止入侵者，&dEnder Guardian&r在&dRuined Citadel&r中设置了多种陷阱。请小心脚下。"
		"{@pagebreak}"
		"前往遗迹堡垒最低层的祭坛唤醒末地守卫。在&5末地&r维度时使用&6虚空之眼&r来定位遗迹堡垒。"
	]
	quest.726B63D654B3A4F2.title: "下界草原"
	quest.728DDA6508DCDA12.quest_subtitle: "矿石存在于末地。有两条进度路线"
