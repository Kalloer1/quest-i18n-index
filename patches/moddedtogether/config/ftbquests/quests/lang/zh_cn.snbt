	quest.226608BC34917849.title: "Primordial Caves"
	quest.227E457B5462F06C.quest_desc: ["列车时刻表允许其他生物控制列车。手持时刻表右键可配置。坐在列车控制台旁座位的任何生物都可以成为乘务员。要将生物变为乘务员，需给予其已配置的列车时刻表。烈焰人燃烧器可以从列车上的任何位置成为乘务员。"]
	quest.22880C44CEB448EA.quest_desc: ["与创造模组的护目镜类似，Tinker’s Lens能让你看到原本隐藏的事物。它是操作任何Embers Rekindled机器时的必备工具。"]
	quest.22880C44CEB448EA.quest_subtitle: "他们说我精神分裂症。"
	quest.228F5F3A4FBEB08D.title: "机器速度附加组件"
	quest.22AAE46659CE5A01.quest_desc: [
		"&bSpellweaving Pickaxe&r 由 Cthonic Gold 和 Earthen arcana 锻造而成。"
		""
		"激活后，破坏方块会生成最多四个 loci。"
		""
		"Loci会寻找并破坏附近相同类型的方块。"
		""
		"非常适合快速清理矿脉。"
	]
	quest.22AAE46659CE5A01.quest_subtitle: "连锁挖矿"
	quest.22AF2B64DF025798.quest_desc: [
		"一个致力于远古魔法和失传技艺的神秘伙伴。"
		"它研究着深暗之中隐藏的力量。"
		""
		"&9能力：&r"
		""
		"• 赋予所有者夜视能力，并免疫失明和黑暗效果。"
		""
		"• 可以停用附近的潜声尖叫者，让所有者躲避潜声守卫。"
		""
		"&d栖息地：&r"
		""
		"有时会在&3远古城市&r中闲逛，研究古代的力量。"
	]
	quest.22AF2B64DF025798.quest_subtitle: "暗影大师"
