	quest.071043B0217E3B78.quest_subtitle: "落在方块上就像落在史莱姆上一样"
	quest.07238D6DC2A5D89D.quest_desc: [
		"虽然在陆地上能免受这些生物的侵害，但水下深处则是另一番景象。巨大的&9鳗鱼&r潜伏在&b冰迷宫&r的深处。它们捕食那些试图在冰层深处建造避难所以躲避寒风的人。这些生物被诅咒，永远纠缠着这些避难所，并攻击任何进入者。&9鳗鱼&r会留在避难所下方的水中，但会跃出水面攻击附近的一切生物。"
		"{@pagebreak}"
		"&9鳗鱼&r会生成在&8&k避难所&r下方的&b冰迷宫&r里。你必须下到&8&k避难所&r的最底层。"
	]
	quest.072F8E3FEF871419.title: "红木林"
	quest.0754B66CF5E31F83.quest_desc: ["将物品掉落至世界或系统中。物品掉落器可释放存储的物品，用于自动化的 Ember 装置。"]
	quest.075DAF257F0A374A.title: "枫树林"
	quest.0773BFF9C33A0D64.quest_desc: ["{entity:mowziesmobs:naga ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:USE_GLOBAL width:100 height:100 align:center}"]
	quest.0773BFF9C33A0D64.title: "&2★☆☆ 纳迦（Naga）"
	quest.07D3A4B68355D9C9.title: "冰冻监狱"
	quest.07F75808024BEAAC.quest_desc: [
		"&6机械臂&r可以拾取和放置半径为5个方块范围内的方块上的物品。"
		""
		"其运作取决于配置的行为以及目标方块的选择顺序。"
		""
		"将&6扳手&r悬停在手臂上，即可查看其选定的目标。"
		""
		"手臂一次最多可转移一满组物品。"
		""
		"&7它还可以佩戴工程师护目镜。&r"
	]
	quest.07F75808024BEAAC.quest_subtitle: "物品处理机制"
	quest.082AAEFE29F44675.quest_desc: ["{image:gamma_creatures:textures/screens/molluto_eng2.png width:150 height:100 align:center fit:true}"]
	quest.084E1EF4EBD25FE6.quest_subtitle: "&l&n&5植物制成的武器？它竟然是活的！"
