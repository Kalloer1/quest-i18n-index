	quest.487E679F69B609B1.quest_desc: ["用&6Pollen Puff&r击打花朵，生成8朵花。"]
	quest.48A8BDBA503F6840.quest_desc: ["{entity:iceandfire:ice_dragon ent_size:1.5 off_x:0.0 off_y:0.5 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:USE_GLOBAL width:100 height:100 align:center}"]
	quest.48BDA991D14A345C.quest_desc: [
		"&6铜制背囊&r必须充满气压才能正常工作。"
		""
		"放置后，将旋转轴连接到顶部以施加压力。"
		""
		"&e潜水头盔&r"
		"与填充的 &6Copper Backtank&r 搭配使用时，头盔会赋予水肺和水下呼吸能力。"
		""
		"&e潜水靴&r"
		"使穿戴者下沉并禁用游泳，允许在水下行走和跳跃。"
		""
		"它们还能免疫&6机械传送带&r、&6自动扶梯&r和&6步道&r的伤害。"
	]
	quest.48BDA991D14A345C.quest_subtitle: "潜水装备"
	quest.48D544814E5FE368.quest_desc: ["{image:gamma_creatures:textures/screens/muba_eng2.png width:150 height:100 align:center fit:true}"]
	quest.48E3C2D33EFD6812.quest_subtitle: "&l&n&5元素&e之刃！&r"
	quest.493AC092DA35B1E1.title: "锯齿状山峰"
	quest.495CC7C5A8BEF15A.title: "生命值提升"
	quest.49AD5DABD2280DF9.title: "充电器"
	quest.49F1CDC6DAFE13E2.quest_desc: [
		"用于制造蒸汽和矮人气体。将其连接到火花激活器的底部。"
		""
		"锅炉的侧面用于流体输入，顶部用于气体输出。"
	]
	quest.49F429157D62C2DC.quest_subtitle: "水下呼吸与冰冻水域防护能力"
	quest.49F429157D62C2DC.title: "三螺栓潜水服"
	quest.49FB61DAB65D2BEF.quest_desc: ["在即将到来的《驯兽师》章节中，学习如何驯服、训练和折磨这个世界的各种新生物。"]
	quest.4A18B3B814D57B69.quest_desc: [
		"&bFrostmaws&r 是一种在雪地罕见出现的危险野兽。它们体型庞大、速度惊人，还拥有强大的冰息，是近乎无法战胜的对手。如果你在旅途中遇到一只正在睡觉的，最好另寻他路，不要打扰。这种野兽守护着一颗珍贵的冰晶，使用时能释放出纯粹的冬季能量。"
		"{@pagebreak}"
		"使用&6霜之眼&r来定位雪洞中的&b霜喙&r。"
	]
	quest.4A1D180F1688C261.title: "海洋纪念碑"
	quest.4A4C7DC41D551FED.title: "干燥的灌木丛地"
