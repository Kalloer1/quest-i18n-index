	quest.7476CFA6F3CBB2A1.quest_desc: [
		"&l&6黎明石砧&r&r是一种高级的锻造和冶炼台，用于加工强力材料并制造高级装备。"
		""
		"专为精准和耐用而设计，让工程师和工匠能将稀有资源打造成宝贵的工具、组件和升级品。"
	]
	quest.748C315A77D2E486.quest_desc: [
