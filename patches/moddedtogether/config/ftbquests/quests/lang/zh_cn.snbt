	quest.45C94A869977DDC6.title: "繁茂洞穴"
	quest.45E2C787B0B44DAF.quest_subtitle: "{count:1,id:\"refinedstorage:1024b_fluid_storage_block\"}"
	quest.45F1AE33BF507492.quest_desc: [
		"一个致力于魔法研究的游荡的伙伴。"
		"擅长操纵简单的咒语魔法并与神秘物品互动。"
		""
		"&9能力：&r"
		""
		"• 能将放置在底座上的法术卷轴进行转换。&r"
		"生成一个相同稀有度的随机卷轴。"
		"有小概率产出更高稀有度的卷轴。"
		""
		"• 末影人畏惧它的存在，会逃离。&r"
		""
		"• 可以抵御来袭的潜行者子弹。&r"
		""
		"&d栖息地：&r"
		""
		"有时会在 &5末地,&r 游荡，研究存在的极限"
	]
	quest.45F1AE33BF507492.quest_subtitle: "神秘学者 (Arcane Scholar)"
	quest.45F1AE33BF507492.title: "大法师"
	quest.45FE1ED838D186A9.quest_desc: [
		"&6流体储罐&r可储存流体，每块最多可容纳8桶（8000 mB）。"
		""
		"坦克会与相邻的坦克连接，形成最大为3×32×3的大型多方块结构。"
		""
		"流体可以从任意一侧使用&6流体管道&r进行输入或输出。"
		""
		"玻璃窗可以用&6扳手&r来切换。"
	]
	quest.45FE1ED838D186A9.quest_subtitle: "流体存储装置"
	quest.46037D117249B542.quest_desc: ["接收并引导&4热能&r。Ignem Receptor吸收余烬或热能，并将其导向你的机器和系统中。"]
	quest.461A0A84153977E9.quest_desc: [
		"当你走近帐篷时，一个满身泥土和沙子的女人朝你挥手。"
		""
		"&b\"很高兴见到你！很高兴看到另一个友善的面孔。\""
		""
		"&b“工作让我很少有机会跟人聊天。我叫&5Nico&r&b。我是一名&7考古学家&r&b，真理的追寻者，遗迹的探险家，还有……一个满身泥污的女人。很高兴认识你。”&r"
		""
		"&b\"&6如果你和我们一样热爱考古，我可以给你一张我们正在发掘的遗址地图&r&b。可惜我们赚不到多少钱，所以&6几颗绿宝石&r&b就能帮我买到那张地图，也能为我换来更多食物！\""
	]
	quest.461A0A84153977E9.quest_subtitle: "一顶破旧的帐篷矗立在你面前……"
	quest.461A0A84153977E9.title: "考古学营地"
	quest.462A48769DA1F114.quest_subtitle: "&l&n&5一把丛林中锻造的利剑！"
	quest.46334E21D0446EC0.quest_desc: ["普通箱子/桶可以直接升级到下界合金级。金/铁等也是如此。"]
	quest.468A4AA02E32A08B.quest_subtitle: "{components:{\"ftbquests:loot_crate\":\"create\"},count:1,id:\"ftbquests:lootcrate\"}"
	quest.468FDF7394357FF3.title: "深海的遗迹"
	quest.46913E9659C71457.quest_subtitle: "&l&n&5来自星辰的双刃武器！&e&r"
	quest.46B9E8C825098695.quest_desc: [
		"烹饪更美味的食物将极大地帮助你的旅途。"
		""
		"营养丰富的餐食能增加你的生命值，并让你饱腹感持续更久，无论工作还是健康恢复。"
		""
		"自动化绝对值得投入精力去做。"
		""
		"Unlocks &6Culinaery Arts&r chapter."
	]
	quest.46B9E8C825098695.quest_subtitle: "增加你的生命值（Hearts）"
	quest.46B9E8C825098695.title: "烹饪基础教程"
	quest.46DD0C741220A8F1.quest_desc: [
		"A balanced familiar infused with frost magic."
		""
		"&9能力：&r"
		""
		"• 冻结自身和主人下方的水，使他们可以行走其上。"
		""
		"• 免疫冰冻效果，包括粉雪造成的冰冻。"
		""
		"&d栖息地：&r"
		""
		"经常游荡于&b寒冷和冰冻&r的生物群系中。"
	]
	quest.46DD0C741220A8F1.quest_subtitle: "冬日之子"
	quest.46DD0C741220A8F1.title: "Frostling"
	quest.4729C395E23EDB15.quest_subtitle: "提高游泳速度，并允许在水外滑翔"
	quest.472C8CBAF47579DD.title: "恐惧堡垒"
	quest.474B713B22FBECB5.quest_desc: ["使用 &eBasin&r 和 &eMechanical Mixer&r 来混合材料，并储存液体。也可用于无定形合成"]
	quest.4791FC0A2E834D85.quest_desc: ["黑暗魔法萦绕在这些地牢的深处，融入物品、大厅，乃至空气之中。力量等待着勇敢者，但扭曲的命运也等待着粗心者。"]
	quest.4791FC0A2E834D85.quest_subtitle: "找到一个浴场（Bathhouse）"
