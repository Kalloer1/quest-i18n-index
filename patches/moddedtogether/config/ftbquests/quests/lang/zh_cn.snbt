	quest.27E73CE068DB1450.quest_desc: ["使用&l&6Ember&r&r自动挖掘资源。 &l&6Ember Bore&r&r会钻入世界，收集材料供你的生产系统使用。"]
	quest.27EFE45815ABC490.quest_desc: [
