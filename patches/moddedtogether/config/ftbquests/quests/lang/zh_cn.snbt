	quest.1FFAE9F112A5F74C.quest_desc: [
		"&6经验孵化舱&r可用于向&6流体储罐&r或&6蓄水池&r中存入或提取经验。"
		"    "
		""
		"&e交互&r"
		"右键点击以存入经验值。"
		"Shift + 右键点击以提取经验值。"
		""
		"&e卷轴面板&r"
		"调整每次交互所转移的经验值数量。"
	]
	quest.1FFAE9F112A5F74C.quest_subtitle: "经验值转移"
	quest.200DAB66214382B8.title: "自然女巫团"
	quest.2010601F09ADF6D6.quest_desc: [
		"&6扳手&r用于旋转、拆除和配置&6创造&r方块。"
		""
		"右键点击方块，即可根据你点击的面来旋转它。"
		"某些方块——如红石装置或铁轨——将被拆除并放回你的物品栏中。"
		""
		"通常使用右键交互的方块，必须在&6潜行&r状态下拆除。"
		""
		"部分 Create 方块支持额外配置。"
		"用&6扳手&r悬停在它们上面，并使用滚轮来调整设置。"
		""
		"对于像 &6Linear Chassis&r 这样的方块，按住 &6Ctrl&r 并滚动可以将其更改应用于所有已连接的部分。"
		""
		"&8● &6快速配置&r"
		"查看某些 Create 方块（例如 &6Gearbox&r）时，按 &6U&r 可打开包含方块朝向等额外选项的径向菜单。"
	]
	quest.2010601F09ADF6D6.quest_subtitle: "实用工具"
	quest.2062B1A841F4053C.quest_desc: [
		"&b璀璨方尖碑&r能提升附魔效果。"
		""
		"它能提供相当于五个书架的电力。"
		""
		"把它放在附魔台附近，可以获得更强的附魔效果。"
	]
