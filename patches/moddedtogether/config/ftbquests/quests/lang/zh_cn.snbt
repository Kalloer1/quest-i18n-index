	quest.4A958BA4CE4F0F17.quest_subtitle: "缩放伤害减免效果"
	quest.4AC60D7FD95B7758.quest_desc: [
		"开始选择你的职业，逐步提升以获得更轻松的体验，或者跳过此页，做你认为最好的选择。"
		""
		"&c警告：跳过指南可能导致游戏难度上升，如果你不知道该做什么的话"
	]
	quest.4AC60D7FD95B7758.quest_subtitle: "有任何疑问都可以在 Discord 上随时提问"
	quest.4ACE2658F05CBDE7.title: "深冻海洋"
	quest.4ADCCDD725521389.quest_desc: [
		"&a优点：&r"
		"&8●&r 恶性暴击会触发连续斩击"
		"&8●&r 额外的斜杠会随着恶性转化而缩放"
