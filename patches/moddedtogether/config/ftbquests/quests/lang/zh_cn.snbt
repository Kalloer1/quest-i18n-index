	quest.7623E20796E1BD79.quest_subtitle: "{components:{\"ftbquests:loot_crate\":\"food1\"},count:1,id:\"ftbquests:lootcrate\"}"
	quest.7624A9C655DE8534.quest_desc: ["{entity:bosses_of_mass_destruction:lich ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:USE_GLOBAL width:100 height:100 align:center}"]
	quest.762EEF712ACEED01.quest_desc: ["完成黄色 &eSempiternal Sanctum&r 挑战。"]
	quest.7644428EDDD68873.title: "机器电容器附加组件"
	quest.7647DA12E826B5EF.quest_desc: ["将熔化的金属锻造为实用组件。将熔化的金属放入&6&lStamper Base&r&r，安装正确的印章，并用余烬为冲压器供电，以生产锭、板、齿轮、棒材和其他精密零件。"]
	quest.7658031A2D941FA5.quest_desc: [
		"就像《我的世界》本身一样，归根结底——你的道路由你自己决定。"
		"没有单一的目标，只有你选择去追求的目标。"
		"不过，以下是一些可以指导你旅程的建议："
		""
		"&8●&r 击败末影龙"
		""
		"&8●&r 完成首领图鉴"
		""
		"&8●&r 制作你学校的特殊盔甲，例如圣骑士套装"
		""
		"&8●&r 发现所有考古学彩蛋"
		""
		"&8●&r 锻造暗影光辉盔甲"
		"  "
		"&8●&r 使用 Storage Controller 创建一个完整的存储网络"
		""
		"&8●&r 烹饪每顿暖心佳肴，让你的生命值最大化"
		""
		"&8●&r 最后，与朋友一起探索一切，或在 &z&l官方服务器&r&r 上结识新朋友！"
	]
	quest.7658031A2D941FA5.quest_subtitle: "该做什么"
	quest.7658031A2D941FA5.title: "目的"
	quest.766AB4D78945AC31.quest_desc: ["&5附魔装置&r的运作方式与&5灌注室&r类似，但设置略有不同。要制作它，你需要将&5附魔装置&r放置在&5奥术核心&r的上方。当此设置被8个&5奥术基座&r包围时，所有配方都将可行。"]
	quest.768B5A37B86F75E3.title: "凋零宝库"
	quest.76A81A7A53F5A289.title: "灵魂黑铁匠 (Soul Black Smith)"
	quest.76B16225129CA5BA.quest_desc: [
		"&b呼啸之风符文&r可增加移动速度和攻击速度。"
