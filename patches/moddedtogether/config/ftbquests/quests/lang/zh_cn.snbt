	quest.0C0CDC3D8C72DAD9.quest_desc: [
		"&6卡包&r可以存储多张&6位置卡&r，并能与&6Tempad&r自动集成。"
		""
		"When carried in a Curios slot or the inventory, the &6Tempad&r displays all wallet entries alongside its own saved locations."
	]
	quest.0C0CDC3D8C72DAD9.quest_subtitle: "扩展卡牌存储容量"
	quest.0C10E257A0E6F607.quest_desc: ["加速鞘翅是 Oritech 喷气背包系列的基础飞行与滑翔型号。它具有 100,000 RF 的内部存储容量，可容纳 4 桶燃料，支持标准电源或涡轮燃料运行。"]
	quest.0C10E257A0E6F607.title: "喷气背包鞘翅"
