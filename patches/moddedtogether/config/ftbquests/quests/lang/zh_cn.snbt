	quest.72C028074D0645D2.quest_subtitle: "&l&n&5斧头，源自地狱本身！"
	quest.72C8FDDBB7EEEDF8.quest_desc: ["连接到已供电的 &e控制器&r 后，该线缆将为精炼存储装置中所有相连的组件提供能量。"]
	quest.72F3DC5B2E3EBFB5.title: "机器物品栏代理附加组件"
	quest.72FEE510C549DC11.quest_desc: [
		"右键并长按以逆时针转动曲柄，或按住 Shift 并右键以反转旋转方向。"
