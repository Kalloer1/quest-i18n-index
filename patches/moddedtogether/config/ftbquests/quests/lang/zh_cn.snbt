	quest.0F627A977DD2B969.quest_desc: ["{entity:ars_nouveau:wilden_boss ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:USE_GLOBAL width:100 height:100 align:center}"]
