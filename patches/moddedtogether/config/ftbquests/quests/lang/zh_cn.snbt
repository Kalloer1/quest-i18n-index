	quest.39352B7CECAC84F4.quest_subtitle: "让他们去烹饪吧"
	quest.39352B7CECAC84F4.title: "顶级厨师"
	quest.39420EB06038CF34.quest_desc: ["&6&lClockwork Axe&r&r 是一种不可破坏的高级混合工具兼武器，由黎明石制成，既能快速砍伐树木，又能作为强大的近战武器使用。"]
	quest.394272D93F2FE569.quest_subtitle: "造成 500.000 点伤害"
	quest.39475684487F1958.quest_desc: ["{entity:cataclysm:netherite_monstrosity ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:USE_GLOBAL width:100 height:100 align:center}"]
	quest.394E9F83FB77E302.quest_desc: ["{entity:irons_spellbooks:fire_boss ent_size:0.5 off_x:0.0 off_y:-0.2 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:USE_GLOBAL width:100 height:100 align:center}"]
	quest.39E27D08343CC1EA.quest_desc: [
		"&dWilden Chimera&r 是一种极其强大的生物，最伟大的巫师们耗尽全部力量才将其困在 &5Archmage Tower&r 中。单凭塔楼无法束缚此物，许多巫师不得不留下以镇压它。久而久之，他们自己也变得黑暗而堕落。务必训练并提升你的力量，因为这座塔对于未做好准备的人来说是一个致命的陷阱。"
		"{@pagebreak}"
		"&dWilden Chimera&r也可以用&6Tablet of Summon Wilden&r召唤。只有在附加了Wilden Spike、Wilden Horn和Wilden Wing后，该仪式才会召唤出&dWilden Chimera&r。"
		""
		"&7注意：召唤奇美拉时，此仪式会摧毁火盆周围的方块。"
	]
	quest.39E6836317A32051.quest_desc: ["{image:gamma_creatures:textures/screens/alubisin_eng2.png width:151 height:100 align:center fit:true}"]
	quest.3A3F1E29C4C544EC.quest_desc: ["优先实用型，这是接近终局的BOSS套装，但也是冒险的真正终局套装。"]
	quest.3A816B96A7A7A38D.quest_subtitle: "此表格可用于宝石粉尘和锻造材料来升级宝石"
	quest.3A9E2ECAB0556728.quest_subtitle: "那么……你找到了迷宫。敢不敢迎接里面的挑战？"
	quest.3AB449E4D0F66E34.quest_desc: ["&5源石&r可用于制作&5附魔装置&r和&5秘法核心&r等物品。"]
	quest.3AB449E4D0F66E34.title: "法力石"
	quest.3AC5ABAB78D4A226.quest_desc: ["盔甲和工具的巨大升级，能强力抵御巨龙和怪物，地表生物将不再是你的问题。每种元素类型都有不同的强度，请谨慎选择"]
	quest.3AC5ABAB78D4A226.title: "重型盔甲"
	quest.3ACFD2EF49451E95.quest_desc: [
		"&6Shrinkinator&r 是一种用于将物品缩小以制作伙伴的工作台。"
		""
		"玩家还可以缩小食物的大小。"
		"可以将缩小食物喂给伙伴以恢复他们的生命值。"
		""
		"其他物品也可以缩小，包括某些消耗品。"
		""
		"&6Shrinkinator&r支持自动化，并能与漏斗互动。"
	]
	quest.3ACFD2EF49451E95.quest_subtitle: "物品缩小工作台"
	quest.3ADBC1D66AD8811A.quest_desc: ["有许多类型的&5源中继器&r。它们用作法力传输装置。使用&5支配魔杖&r，可将源转移到&5源罐&r中。"]
	quest.3ADBC1D66AD8811A.title: "法力传输"
	quest.3AF461B39D7DD4D2.quest_desc: ["{entity:irons_spellbooks:dead_king ent_size:1.0 off_x:0.0 off_y:0.0 rot:0.0 spin:USE_GLOBAL idle:USE_GLOBAL walk:USE_GLOBAL width:100 height:100 align:center}"]
