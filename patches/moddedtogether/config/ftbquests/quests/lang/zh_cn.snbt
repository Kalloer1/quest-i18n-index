	]
	quest.6B9EEA486F89EB3F.quest_subtitle: "更快的熔炼速度"
	quest.6BAA73A56012674B.title: "海盗村庄"
	quest.6BD17F61D64105FF.quest_desc: [
		"&a优点：&r"
		"&8●&r 对敌人施加的火焰效果会增强"
		""
		"&4缺点：&r"
		"&8●&r 被强制熄灭会对你触发 Infernal Arcana"
		""
