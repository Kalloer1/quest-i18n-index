	quest.731D092CBEF73010.quest_subtitle: "引导并转换神秘能量"
	quest.731D092CBEF73010.title: "精神集中 (Spirit Focusing)"
	quest.7331B766323137A2.title: "战争守卫"
	quest.734BEA705A36799C.quest_desc: ["{image:gamma_creatures:textures/screens/careyatros_eng2.png width:151 height:100 align:center fit:true}"]
	quest.73D5EE5238C37982.quest_desc: ["荒野中，一具伟大生物的骸骨静卧着。它的骨架如苍白骨骼的枝桠般伸向天际。无论是被遗忘神话的遗迹，还是曾被猎至灭绝的野兽，无人知晓。它无声的躯骸，是献给那些早已逝去的生物的纪念碑。"]
	quest.73D5EE5238C37982.quest_subtitle: "寻找一只基里尼亚鹿（Ceryneian Hind）"
	quest.73D660B9873BEE68.quest_subtitle: "&l&n&5在寒冷中锻造的斧头！"
	quest.73F191A33FAA8878.quest_desc: ["&bRune Of Scorching&r 使你的火焰伤害翻倍。"]
	quest.73F191A33FAA8878.quest_subtitle: "更强的火焰伤害"
	quest.7424F32388952010.quest_desc: ["{image:gamma_creatures:textures/screens/banndu_eng2.png width:150 height:100 align:center fit:true}"]
