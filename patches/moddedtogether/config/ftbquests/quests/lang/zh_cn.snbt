	quest.0B575708CB5D40F2.quest_subtitle: "没有熔炉的火焰"
	quest.0B89EB36AC565461.quest_desc: ["在这座地下城市的深处，熔岩的热浪和工业的轰鸣充斥着空气。下界的影响无处不在，为熔炉提供燃料，并驱动着巡逻每条走廊的锻造守卫。唯有准备好迎接火焰与钢铁者，才能存活并夺取其中的宝藏。"]
	quest.0B89EB36AC565461.quest_subtitle: "找到一个铸造厂 (Foundry)"
	quest.0B997F9AA39276A1.quest_desc: [
		"&bElaborate Brooch&r 允许将项链佩戴在腰带槽位中。"
		""
		"It removes normal slot limitations."
		""
		"用它来更自由地组合配饰。"
	]
	quest.0B997F9AA39276A1.quest_subtitle: "打破物品栏限制"
	quest.0BB53AC414552D70.quest_desc: ["&e便携式存储盘&f就像背包一样。但它需要能量。在获得无线终端前，这些非常棒！"]
	quest.0BB53AC414552D70.quest_subtitle: "正在燃烧的光盘！"
