	quest.6401E42DBD93997A.quest_desc: ["加热机器的绝佳方法。真想知道怎么用烈焰人填满这个……"]
	quest.640285BA22E26720.quest_desc: ["升级到Chronon电池可将容量翻倍至&24,000 Chronons&r，并自动为所有携带的设备分配电力。"]
	quest.640285BA22E26720.quest_subtitle: "扩展时间（Expanding Time）"
	quest.6402B5B6625731F0.quest_subtitle: "承受 500,000 点伤害"
	quest.6402B5B6625731F0.title: "钻石皮肤"
	quest.64385462E003742A.quest_desc: ["证明蜜蜂很强大。穿戴蜜蜂盔甲套装并击败&5末影龙&r"]
	quest.6447492FAA873F93.quest_desc: ["悬浮于空中，这座蒸汽朋克浮空城闪烁着橙绿光芒。奇特的齿轮驱动居民在平台上游荡，每个都有一只硕大的独眼。小心进入，这个机械蜂巢既聪慧又威严，秘密重重。"]
	quest.6447492FAA873F93.quest_subtitle: "找到一个机械巢穴"
	quest.645FD518CDA984B7.quest_desc: [
		"&bSoulwoven Silk&r 是一种注入了灵魂能量的轻便耐用材料。"
		""
		"它能自然地隔绝神秘能量的影响。"
		""
		"比基于石头的材料更容易塑形和制作。"
		""
		"用于高级魔法装备和装饰品中。"
	]
	quest.645FD518CDA984B7.quest_subtitle: "Arcane-insulated fabric"
	quest.647335A823EBEE86.quest_desc: ["在开启任何时间之门前，都需要一个克罗诺能量源。入门级电源组件是&2克罗诺电池&r，它能储存&22000克罗诺&r，并自动为所有携带的设备分配能量。"]
	quest.647335A823EBEE86.quest_subtitle: "储存时间？"
