	quest.07AA817AE0A43EE9.quest_desc: [
		"&e这些眼睛是你通往末地维度的通行证。&r"
		""
		"&e部分眼睛需要击败首领，因此建议遵循英雄征服章节进行。"
		""
		"&o&7守望者曾负责看护各个领域，确保混沌无法肆虐。这一切在开端发生时改变了，守望者被摧毁，随后又用来自领域的材料被复活。"
		""
		"&7现在，你的任务是恢复12个眼睛，以开启通往末地的传送门，并恢复守望者的存在。"
		""
		"&2推荐：&r"
		"{ \"text\": \"Hero's Conquest\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"5ADD8D9CF89BEEA6\" } }"
		""
		"&c请仔细阅读此页面内容"
	]
	quest.07AA817AE0A43EE9.quest_subtitle: "诸界守望者"
	quest.07AA817AE0A43EE9.title: "眼睛们"
