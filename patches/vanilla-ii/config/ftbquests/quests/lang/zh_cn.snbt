	quest.409066917C3F3612.quest_desc: [
		"&9类型：&r &6近战&r / &6坦克&r"
		"&9难度：&r &a简单&r"
		""
		"&6战士职业&r能让你在&6造成高额伤害&r的同时&r&6承受伤害&r。"
		""
		"&3提示：&r作为&6战士&r，你总是在寻找方法&6提升&r你的&6生命&r和&6护甲&r，并且偏好使用&6双手武器&r。"
		""
		"{@pagebreak}"
		"&6战士传说"
		""
		"&o&7战士是忠诚的斗士，会为了保护无辜者而不惜一切。他们通常手持双手重武器，绝非等闲之辈。"
	]
	quest.409066917C3F3612.quest_subtitle: "力量的道路"
	quest.409066917C3F3612.title: "战士 "
	quest.40B321FB3E906C22.quest_desc: ["&e只有在击败末影龙之后，你才能离开这个维度。"]
	quest.40B321FB3E906C22.quest_subtitle: "最终目的地？"
	quest.40B321FB3E906C22.title: "The End"
	quest.40C9AD64D592A47A.quest_desc: ["&e让你可以收藏自己的照片。"]
	quest.40C9AD64D592A47A.quest_subtitle: "你的照片集"
	quest.40CAE69961D38498.quest_desc: [
		"&9推荐装备：&r ໙"
		"&9难度：&r &e中等"
		""
		"&e在黄金地牢中发现。"
		""
		"&o&7太阳之魂曾试图掌控所有时间，创造一个永恒的白昼世界。在与夜之巫师的传奇之战中，她获胜了。战败后，太阳之魂退守至Aether的火焰地牢，在那里他让领域保持永恒的白昼，希望有一天能重返Overworld，掌控那里的时间。"
	]
	quest.40CAE69961D38498.quest_subtitle: "时间的掌控者"
	quest.40CAE69961D38498.title: "&b太阳之灵 &f໙"
	quest.40F109486ED4F7D8.quest_desc: [
		"&e虽然这个整合包有很多目标和挑战，但别忘了享受玩Minecraft的乐趣。"
		""
		"&7你旅途中的所有目标都可以在“旅途”分组中找到。"
		""
		"&7This pack is meant as an extension to the vanilla game, this means there are a few \"goal of the modpack\" quest lines, but they aren't meant to be the main focus."
		""
		"&2注意：&7 此整合包仍在开发中，部分内容尚未完善。敬请期待更新！"
		""
		"&l&6祝你旅途愉快，玩得开心！"
	]
	quest.40F109486ED4F7D8.quest_subtitle: "历史学家的文献记录"
	quest.40F109486ED4F7D8.title: "古代笔记本 (The Ancient Notebook)"
	quest.41306D29610CB8B8.quest_desc: [
		"&9类型：&r &6支援型&r / &6全能型&r"
		"&9难度：&r &a简单&r"
		""
		"&6圣骑士职业&r能让你&6保护&r自己和你的&6盟友&r免受&6伤害&r。"
