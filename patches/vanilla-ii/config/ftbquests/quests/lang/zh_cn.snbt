	quest.6282834B623749A1.title: "圣骑士的战锤"
	quest.62B4526D6857D154.quest_desc: [
		"&9推荐装备：&r ໙"
		"&9难度：&r &a简单"
		""
		"&e使用黑曜石支架上的镀金黑石碎片召唤。"
		""
		"&o&7黑石傀儡是一个古代文明为抵御混沌而建造的古老机械。然而，计划失败，混沌控制了这台机械。如今，猪灵将其存在封印在金质黑石碎片之后。你必须将其从囚禁中召唤出来，才能彻底将这片土地从这个可怕的生物中解放。"
		""
		"{@pagebreak}"
		"&e召唤仪式 The Summoning Ritual"
		""
		"{image:vanilla2:textures/quests/blackstone_golem_ritual.png width:120 height:120 align:center}"
		""
		"&9所需维度：&r &c下界&r"
	]
	quest.62B4526D6857D154.quest_subtitle: "一个古老的机械装置"
	quest.62B4526D6857D154.title: "&c黑石傀儡 &f໙"
	quest.62CBAED4D8979076.quest_desc: [
		"&9推荐装备：&r &f໙"
		"&9难度：&r &c困难"
		""
		"&e在黑色石峡谷中发现，通过破坏中心的眼睛方块来召唤。"
		""
		"&o&7下界手套是下界的统治者，掌控着这片炽热的土地。它藏身于黑石遗迹中，不喜欢被唤醒。手套会发射高伤害的光束，建议准备抗性药水或高耐久度的盾牌。"
	]
	quest.62CBAED4D8979076.quest_subtitle: "下界的主宰"
	quest.62CBAED4D8979076.title: "&c下界试炼 &f໙"
