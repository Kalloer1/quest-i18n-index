	quest.5B25D3EFF8096B2C.quest_desc: [
		"&9类型：&r &3近战&r"
		"&9难度：&r &a简单&r"
		""
		"&e战士职业主打爆发式的高额伤害。"
		""
		"&7该职业专注于使用攻速较慢的武器造成高额爆发伤害。防御力更高，能在攻击时存活更久。"
		""
		"&6珠宝类型：&7红宝石（攻击伤害）。"
		""
		"&6遗物属性：&7攻击力、防御力和生命值。"
	]
	quest.5B25D3EFF8096B2C.quest_subtitle: " - 力量的道路"
	quest.5B25D3EFF8096B2C.title: "战士（The Warrior）"
	quest.5B31CF21BEA93299.quest_subtitle: "໚"
	quest.5B31CF21BEA93299.title: "神秘巫师法杖"
	quest.5B6F1DEE6ECE1D6B.quest_desc: [
		"&7&o世界并非总是充满混沌。曾经有过一个和平与平衡的时代。"
		""
		"&7&o这一切都始于末地人。他曾统治末地，却在与天界的战争中失去了挚友。悲痛欲绝的他逐渐走向疯狂，为了复活朋友，他求助于黑暗魔法。在尝试了无数次咒语都失败后，他决定投向虚空，牺牲自己。"
		""
		"{@pagebreak}"
		"&7&o他投身虚空后，开始以无人能想象的方式腐化。不知怎地，他离开了虚空，创造了混沌，让所有人都感受到了他的痛苦与折磨。"
	]
	quest.5B6F1DEE6ECE1D6B.quest_subtitle: "一段传说碎片"
	quest.5B6F1DEE6ECE1D6B.title: "混沌的创造"
	quest.5B70A995EF3303CE.quest_desc: [
		"&9推荐装备：&r ໞ"
		"&9难度：&r &c困难"
		""
		"&e使用装有伟大精华和光辉精华的伟大圣杯召唤而出。"
		""
		"&o&7下界人创造了万物，也是混沌的根源。它被困在虚空，唯有被召唤时才能逃脱。向盛满的圣杯献上光辉精华即可召唤，它注定会引发混沌。"
	]
	quest.5B70A995EF3303CE.quest_subtitle: "混沌的创造者"
	quest.5B70A995EF3303CE.title: "&6下界人 &fໞ"
