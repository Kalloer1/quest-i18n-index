	quest.4C6BE568B699D646.quest_desc: [
		"&eEMI 在你右边，可以用它查看配方、了解物品的制作方法和用途。"
		""
		"&7只需搜索物品即可使用EMI。要查看配方，可以&b左键单击&7，要查看用途，可以&b右键单击&7。输入&9@&7可一次性查看所有配方。"
		""
		"&2实用按键绑定："
		"&7- &bR&7: &6查看配方&7，可用于物品栏中的物品。"
		"&7- &bU&7: &6查看用途&7，可用于物品栏中的物品。"
		"&7- &bY&7: &6搜索附近物品栏&7。"
		"&7- &bA&7: &6最喜欢的配方&7，将显示在左侧。"
	]
	quest.4C6BE568B699D646.quest_subtitle: "增强配方查看器"
