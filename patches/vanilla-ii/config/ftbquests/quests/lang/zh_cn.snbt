	quest.4D6522845D314D7B.title: "法术施放"
	quest.4D823455F5D1DD35.quest_desc: [
		"&e宝石可用于制作强大的首饰。"
		""
		"&7有6种不同的宝石，每种都能强化不同的属性。"
		""
		"&6寻找宝石：&7宝石可以在地下的宝石矿脉中找到。"
		""
		"&b红宝石：&7 提高攻击力。"
		""
