	quest.4EBF2EB9068011A9.quest_desc: [
		"&9推荐装备：&r ໚"
		"&9难度：&r &a简单"
		""
		"&e在青铜地牢中发现。"
		""
		"&o&7滑块是一种被混沌腐化的生物。滑块拥有石质皮肤，免疫常规武器。腐化后，它被囚禁在天空中的一个地牢里。随着腐化的蔓延，有时会有小石头在它的牢笼中变得鲜活起来。"
	]
	quest.4EBF2EB9068011A9.quest_subtitle: "混沌之石"
	quest.4EBF2EB9068011A9.title: "&b滑块 &f໚"
	quest.4ECC985B8A5D7616.quest_desc: [
