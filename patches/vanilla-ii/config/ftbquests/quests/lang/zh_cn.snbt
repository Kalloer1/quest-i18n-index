	quest.4D015D3E79DCEAC5.quest_desc: [
		"&e这些框架可以显示任何成就。"
		""
		"&7成就框架会显示你达成的任何成就。统计框架则会显示你的统计数据。"
	]
	quest.4D015D3E79DCEAC5.quest_subtitle: "分享你的成就（Achievements）"
