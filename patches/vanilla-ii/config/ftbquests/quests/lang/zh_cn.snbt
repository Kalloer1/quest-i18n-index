	quest.011E5D0D94B653F9.title: "Chillweaver's Wand"
	quest.014A07C25E3923E5.quest_desc: [
		"&9推荐装备：&r ໙"
		"&9难度：&r &e中等"
		""
		"&e跟随虚空百合即可找到。"
		""
		"&o&7虚空之花是一种古老的变异孢子花。当古代炼金术士将装有混沌精华的瓶子滴在孢子花上时，便诞生了这种生物。它会毒害任何不谨慎的人，最好准备些牛奶来抵消其影响。"
	]
	quest.014A07C25E3923E5.quest_subtitle: "变异孢子花 (Mutated Spore Blossom)"
	quest.014A07C25E3923E5.title: "虚空之花 | ໙"
	quest.0177DE0561EC3F36.quest_desc: [
		"&e在这里，你会找到一些有用的任务章节。"
		""
		"&b装备进阶：&7装备的进阶流程及制作方法。"
		""
		"&b实用奇物：&7 一些对你旅途大有助益的实用物品。"
		""
		"&b末地之旅：&7引导你通过新方式前往末地维度。"
	]
	quest.0177DE0561EC3F36.quest_subtitle: "其他一些有用的章节！"
	quest.0177DE0561EC3F36.title: "实用章节"
	quest.019FC977F2E7F9AB.quest_desc: [
		"&9推荐装备：&r ໙"
		"&9难度：&r &c困难"
		""
		"&e进入末地后召唤出来。"
		""
		"&o&7末影龙，曾是一种和平的生物，是末地的守护者，如今却被混沌所腐化。末影龙已将末地囚禁了数个纪元。末地的生物逐渐变得愈发腐化，并开始服从她的统治。与混沌共处了这么久，她开始创造强大的法术。"
	]
	quest.019FC977F2E7F9AB.quest_subtitle: "末地的捕俘者"
	quest.019FC977F2E7F9AB.title: "&5末影龙 &r໙"
	quest.01DFC42FD77A5A9D.quest_desc: ["&e恢复所有附魔，但等级降低一级"]
	quest.01DFC42FD77A5A9D.quest_subtitle: "改进附魔分解系统"
	quest.01DFC42FD77A5A9D.title: "&5Catalyst: &rHeart of the Sea"
	quest.0205CA74B39D7723.quest_desc: ["&e祭坛需要Ambrosium Shards作为燃料。"]
	quest.0205CA74B39D7723.quest_subtitle: "附魔？Enchanting?"
	quest.0205CA74B39D7723.title: "祭坛"
	quest.02148E4E04C02BF0.quest_desc: [
		"&9类型：&r &6魔法&r"
		"&9难度：&r &e中等&r"
		""
		"&6巫师职业&r能让你施放&6强力法术&r。巫师分为&63&r个不同的&6子类&r。"
		""
		"&3提示：&r作为一名&6巫师&r，你总是在寻找方法&6提升&r你的&6法术强度&r、&6法术加速&r和&6法术暴击率&r。"
		""
		"{@pagebreak}"
		"&6巫师传说"
		""
		"&o&7巫师是神秘莫测的人，传闻他们非常强大。他们用强大的法杖施放前所未见的法术，并对任何招惹他们的人造成毁灭性的打击。"
	]
	quest.02148E4E04C02BF0.quest_subtitle: "魔法之路 (Path of Magic)"
