	quest.5E4FFD8BF0E61318.title: "职业类别"
	quest.5E5AEDB0E19B5A90.quest_desc: [
		"&9推荐装备：&r ໚"
		"&9难度：&r &a简单"
		""
		"&e在林地府邸中生成"
		""
		"&o&7召唤者是林地府邸中统领并指挥恼鬼的领袖。他能施展混沌加持的强大魔法，召唤出那些被认为早已灭绝的生物。交战时要小心，恼鬼们绝不会轻易让他们的领袖失望。"
	]
	quest.5E5AEDB0E19B5A90.quest_subtitle: "掠夺者们的领袖"
	quest.5E5AEDB0E19B5A90.title: "召唤者 | ໚"
