	quest.5E0C78B6B8181135.title: "游侠之路 (Path of the Ranger)"
	quest.5E20D03A22692B68.quest_desc: [
		"&7&o征服了各个维度，制造了强大的机器，调制了传奇的药水，烹饪了不可思议的佳肴，一切似乎都已尘埃落定。"
		""
		"&7&o你读完了《古代笔记本》的最后一页，发现里面有一个空白的条目，上面只有一幅画和一个名字……"
		""
		""
		"{image:endrem:item/cryptic_eye width:100 height:100 align:center}"
		""
		"&7&o神秘之眼"
	]
	quest.5E20D03A22692B68.quest_subtitle: "当一切看似结束时"
	quest.5E20D03A22692B68.title: "第一章：最终的故事"
