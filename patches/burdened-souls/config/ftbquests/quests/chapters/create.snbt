	quests: [
		{
			dependencies: ["06C16E461C05DA73"]
			description: [
				"Create 是一款 Minecraft 模组，它允许你使用旋转动力来制作机械装置和自动化流程。它为游戏添加了多种机械组件和方块变体。"
				""
				"Pondering 是一款游戏内指南系统，能让玩家快速获取关于 Create 方块的信息。"
				""
				"将物品悬停在物品栏中并按住前进键（默认为“W”），直到物品下方的进度条填满，即可对该物品进行沉思。这将显示关于该物品的动画信息图表。"
			]
			id: "1334E9DBED9C0822"
			rewards: [
				{
					id: "0C5BDBAD63DB218A"
					item: "create:wrench"
					type: "item"
				}
				{
					id: "24E277EE4AFD9E85"
					item: "create:goggles"
					type: "item"
				}
				{
					id: "71877361BBE84C1F"
