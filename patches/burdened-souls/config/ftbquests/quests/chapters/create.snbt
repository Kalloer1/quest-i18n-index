					type: "item"
				}
				{
					id: "7693D5B5669C442B"
					item: "create:builders_tea"
					type: "item"
				}
			]
			shape: "rsquare"
			size: 2.0d
			tasks: [{
				id: "1843073470187AA5"
				title: "创建"
				type: "checkmark"
			}]
			x: -18.0d
			y: 7.5d
		}
		{
			dependencies: ["1334E9DBED9C0822"]
			description: [
				"扳手是一种用于旋转、拆卸和配置组件的工具"
				""
				"使用扳手点击组件，可使其围绕你交互的面进行旋转。"
				""
				"使用扳手点击组件、红石组件、轨道或原版轨道变体，即可将其拆除并放入背包。任何可通过右键旋转或交互的方块，都必须在潜行状态下拆除。"
			]
			id: "24CFA907920ABAAB"
			shape: "gear"
			size: 2.0d
			tasks: [{
				id: "655B52751D9E37CC"
				item: "create:wrench"
				type: "item"
			}]
			x: -15.0d
			y: 7.5d
		}
		{
			dependencies: ["79E7761B046EB9F5"]
			id: "3CE86F726D52881C"
