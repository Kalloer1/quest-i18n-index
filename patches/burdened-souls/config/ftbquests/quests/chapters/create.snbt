			}]
			x: -9.0d
			y: 7.5d
		}
		{
			dependencies: ["3CE86F726D52881C"]
			description: ["转轴是Create中的一个基础机械组件。转轴可用于连接两个机械组件，使一个的旋转带动另一个旋转，转轴也是唯一可放置机械带的方块。"]
			id: "0DAD0BE3C50DF047"
			tasks: [{
				id: "561095A63503CCE8"
				item: "create:shaft"
				type: "item"
			}]
			x: -8.25d
			y: 9.0d
		}
		{
			dependencies: ["0DAD0BE3C50DF047"]
			description: [
				"齿轮是Create中用于传递旋转的基本机械组件。"
				""
				"齿轮主要有三种相互啮合的方式："
				""
				"两个齿轮相邻放置（非对角）且朝向相同时会相互啮合。当其中一个齿轮受到旋转力时，该力会以相同的速度反向传递到另一个齿轮。"
				""
				"两个大型齿轮垂直放置时会相互啮合，从而改变其轴和方向，但速度不变。"
				""
				"齿轮和大型齿轮斜向放置且朝向相同时会相互啮合。大型齿轮的转速是齿轮的一半。"
			]
			id: "2DAC19AB21B0CE65"
			tasks: [{
				id: "7CE9EF0313A7EEDF"
				item: "create:cogwheel"
				type: "item"
			}]
			x: -8.25d
			y: 10.25d
		}
		{
			dependencies: ["2DAC19AB21B0CE65"]
			description: [
				"齿轮是Create中用于传递旋转的基本机械组件。"
				""
				"齿轮主要有三种相互啮合的方式："
				""
				"两个齿轮并排（非对角）放置且朝向相同时会相互啮合。当其中一个齿轮受到旋转力时，该力会以相同的速度反向传递到另一个齿轮。"
				""
				"两个大型齿轮垂直放置时会相互啮合，从而改变其轴和方向，但速度不变。"
				""
				"齿轮和大型齿轮斜向放置且朝向相同时会相互啮合。大型齿轮的转速是齿轮的一半。"
			]
			id: "0123721F9AC125DC"
			tasks: [{
				id: "67D259F47409F712"
				item: "create:large_cogwheel"
				type: "item"
			}]
			x: -8.25d
			y: 11.5d
		}
		{
			dependencies: ["0123721F9AC125DC"]
			description: [
				"水车是一种旋转动力源。当水流过时，它会生成旋转力。"
				""
				"由于制作材料易于获取，水车是最简单的自动化发电机，可以在游戏早期就制作出来。"
				""
				"可以通过并联更多车轮来增加总应力容量。"
			]
			id: "3A43E35C5C904B81"
			tasks: [{
				id: "4C56F29B368A5F9D"
				item: "create:water_wheel"
				type: "item"
			}]
			x: -8.25d
			y: 12.75d
		}
		{
			dependencies: ["3A43E35C5C904B81"]
			description: [
				"大型水车是小型水车的放大版。"
				""
				"当水流过大水车时，水车会旋转。这种旋转动力可以通过传动轴传递到其他组件。"
				""
				"只要水流大部分朝一个方向流动，水轮就能产生旋转力。与大水轮相比，大型水轮转速减半，但总应力容量是两倍（512su 对比 256su）"
			]
			id: "52F9A68918977D2A"
			tasks: [{
				id: "1E0B7FA04294DFE9"
				item: "create:large_water_wheel"
				type: "item"
			}]
			x: -8.25d
			y: 14.0d
		}
		{
			dependencies: ["24CFA907920ABAAB"]
			id: "75FB1C395FE26838"
			tasks: [{
				id: "76EB5A4EF6381D57"
				item: "minecraft:dried_kelp"
