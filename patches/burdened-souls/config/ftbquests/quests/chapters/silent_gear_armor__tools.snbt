	quest_links: [ ]
	quests: [
		{
			dependencies: ["06C16E461C05DA73"]
			description: [
				"Silent Gear 本质上就是 Silent's Gems 中的工具和盔甲系统。"
				""
				"该模组专注于工具、武器和盔甲（统称装备）。配方模块化，甚至到每个用于制作的单个部件。每种装备类型的组合可能性几乎无限。"
				""
				"你首先需要制作模板，然后用各种材料来打造工具/盔甲/武器。"
				""
				"Follow the quests below to learn more."
			]
			disable_toast: true
			id: "0444900E9E3F6063"
			rewards: [{
				auto: "enabled"
				id: "2DA5933E9A8F548C"
				item: "create:experience_nugget"
				type: "item"
			}]
			shape: "rsquare"
			size: 2.0d
			subtitle: "这就像 Tinkers 但又有所不同！"
			tasks: [{
				id: "2319588346B9B8C6"
				title: "是时候装备起来了"
				type: "checkmark"
			}]
			x: 0.0d
			y: 1.0d
		}
		{
			dependencies: ["0444900E9E3F6063"]
			description: [
				"大多数装备物品都需要至少一个模板/蓝图才能制作。不过，大多数配方都是无形状的。模板/蓝图才是区分它们的所在。"
				""
				"木制模板是一次性使用的，使用后就会消失。"
				""
				"蓝图类似，但可以重复使用。"
				""
				"制作 12 个模板以开始。你将获得几个有用的木制模板作为奖励。"
			]
			disable_toast: true
			id: "420A86CBE8F47536"
