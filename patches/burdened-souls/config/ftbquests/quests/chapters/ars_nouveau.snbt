		{
			dependencies: ["0856EB97FC8B07FD"]
			description: ["通过附近的生物死亡和动物繁殖生成中等数量的源。此外，Vitalic Sourcelink 会从附近的幼年动物生成被动源，并加速它们的成长。"]
			id: "513FAA93F611FA52"
			tasks: [{
				id: "313BFBE677AEC942"
				item: "ars_nouveau:vitalic_sourcelink"
