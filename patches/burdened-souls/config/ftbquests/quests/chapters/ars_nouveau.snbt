		{
			dependencies: ["3EAC0ED6FD40938A"]
			description: ["要制作新符文，在桌子上使用法术书打开法典。每个符文都需要一组物品和经验值来解锁。在菜单中点击符文进行选择，然后点击确定。将物品按照上图所示投掷到桌子上，桌子就会刻写一个新的符文。桌子也会从附近的物品栏中取用物品。在桌子上使用支配魔杖将禁用自动取用功能。"]
			id: "00DA0150143FD1A0"
			tasks: [{
				id: "639CE2495DC40C32"
				item: "ars_nouveau:scribes_table"
				type: "item"
			}]
			x: -6.25d
