			tasks: [{
				id: "21E29B9C69625BF0"
				item: "ars_nouveau:potion_melder"
				type: "item"
			}]
			x: 3.75d
			y: 5.75d
		}
		{
			dependencies: ["0856EB97FC8B07FD"]
			description: ["通过消耗相邻药水罐中的药水来生成源。生成的源量因药水而异，取决于药水的复杂程度。药水长度和等级会提供额外源，药水包含的每种效果都会有乘数加成。建议使用 Wixies 和 Potion Melder 来酿造高复杂度的药水。"]
			id: "5DC737EC5EC97FBC"
			tasks: [{
				id: "5939AAFD7819F5B9"
