		}
		{
			dependencies: ["0856EB97FC8B07FD"]
			description: ["火山源链接通过消耗可燃物品来生成源。远古木原木会生成额外的源，其中燃烧的远古木原木生成的最多。火山源链接在产生源的同时也会产生热量，用于生成岩浆百合并将石头转化为岩浆。火山源链接会自动向附近的罐子输出源，从离它最近的罐子开始。"]
			id: "68CE1AA892B1BEDA"
			tasks: [{
				id: "0E6767EA8F7A985E"
				item: "ars_nouveau:volcanic_sourcelink"
				type: "item"
			}]
			x: 1.25d
			y: 7.0d
		}
		{
			dependencies: ["0856EB97FC8B07FD"]
			description: ["最多可存储100瓶药水的罐子。使用空瓶、药水瓶或箭矢作用于罐子即可移除药水。Wixies会在自动酿造药水时使用这些罐子。潜行时使用Dominion Wand可将罐子锁定。被锁定的罐子只会从Wixies那里收到其锁定的药水。可与比较器配合使用。"]
			id: "385961CDE538B2B4"
			tasks: [{
				id: "0B837872697DCFD2"
				item: "ars_nouveau:potion_jar"
				type: "item"
			}]
			x: 2.5d
			y: 5.75d
		}
		{
			dependencies: ["385961CDE538B2B4"]
