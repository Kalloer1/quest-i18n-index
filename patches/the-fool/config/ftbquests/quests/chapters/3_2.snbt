		{
			can_repeat: true
			dependencies: ["33487721B7FC5E02"]
			icon: {
				Count: 1
				id: "minecraft:written_book"
				tag: {
					author: "Emocione"
					display: {
						Name: "{\"text\":\"寒渊澈明\", \"color\":\"aqua\"}"
					}
					pages: [
						"{\"text\":\"蓝与绿，在此刻交融成一片澄澈的深渊。\\n那绿，是浸染了亿万光年的寂静;而蓝，则是坠入这片绿意深处的天空碎片。\\n水面如镜，却映照不出云影天光，只因它的内部自成一方世界。\\n于是，世界变得深邃而宁静。\"}"
						"{\"text\":\"-仪式：大师欺诈\\n-供物：一个命运之眷、一株彩色橡树树苗、一个回溯聚晶\\n-起源：惧\\n-奉献：源自自身灵魂的一万五千片希冀\\n-结果：当晓风掀开雾绡，才见归途原是来时路，掌中星屑簌簌，竟已铺成通往清晨的桥。\"}"
					]
					title: "寒渊澈明"
				}
			}
