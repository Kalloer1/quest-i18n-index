			dependencies: ["0E7AE8FCBED2AF91"]
			icon: {
				Count: 1
				id: "minecraft:written_book"
				tag: {
					author: "Emocione"
					display: {
						Name: "{\"text\":\"灼而热烈\", \"color\":\"red\"}"
					}
					pages: [
						"{\"text\":\"第一抹赤色划破灰寂。\\n那不是渐变的晨光，而是一道决绝的撕裂，如同在亘古的静默画布上，用生命泼出的第一笔血与火。它来得如此突兀，又如此必然——像一颗重获跳动的心脏，猛地撞破了冰封的胸腔。\\n\"}"
						"{\"text\":\"-仪式：大师欺诈\\n-供物：红粉、灵紫、天蓝、鲜绿、明黄精灵瓶各一\\n-起源：怒\\n-奉献：源自自身灵魂的一万五千片希冀\\n-结果：为世界划上第二道光\"}"
					]
					resolved: 1b
					title: "灼熱而熱烈"
				}
			}
