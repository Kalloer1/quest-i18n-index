			title: "谜底——灼热而热烈"
			x: 24.5d
			y: -2.0d
		}
		{
			can_repeat: true
			dependencies: ["1CA1C879A1DB8151"]
			icon: {
				Count: 1
				id: "minecraft:written_book"
				tag: {
					author: "Emocione"
					display: {
						Name: "{\"text\":\"生机复萌\", \"color\":\"green\"}"
					}
					pages: [
						"{\"text\":\"红绿交织是生命在血管与脉络间的初次对话。\\n红成了脉络中暗涌的河流，绿成了舒展在风中的旗帜。它们交织，是一首无声的协奏曲——红是绿底下暗哑的和弦，绿是红唱出的清亮旋律。\\n在这色彩的共生中，草木初芽。露珠是它宣读的第一篇誓言。\"}"
						"{\"text\":\"-仪式：大师欺诈\\n-供物：火龙的心脏、冰龙的心脏、九头蛇心脏各一\\n-起源：欲\\n-奉献：源自自身灵魂的一万五千片希冀\\n-结果：交织的光组成了世界的希望\"}"
					]
					resolved: 1b
					title: "生机复萌"
				}
			}
			id: "33F59198E04F3675"
