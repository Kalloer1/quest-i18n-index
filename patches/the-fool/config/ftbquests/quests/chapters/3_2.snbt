		{
			can_repeat: true
			dependencies: ["5D91F53E03DF447E"]
			icon: {
				Count: 1
				id: "minecraft:written_book"
				tag: {
					author: "Emocione"
					display: {
						Name: "{\"text\":\"三光初现\",\"bold\":true, \"color\":\"white\"}"
					}
					pages: [
						"{\"text\":\"基础色彩重现，世界轮廓渐清。\\n色彩从记忆的深处浮起，如同底片在显影液中缓缓浮现出真相。建筑的棱角被镀上柔和的暖黄，街道的曲线在淡赭石中变得温存。曾经模糊莫辨的远方，此刻被勾勒出清晰的层次，近的沉郁，远的空灵，如同一幅正在自我完成的水墨长卷。\"}"
						"{\"text\":\"-仪式：大师欺诈\\n-供物：4朵烈焰百合、4个朵火把花、1个烈焰之眼\\n-起源：喜\\n-奉献：源自自身灵魂的一万五千片希冀\\n-结果：温阳洒落大地，梦境初见新光\"}"
					]
					title: "三光初现"
				}
			}
			id: "7866518D7348EFEA"
			rewards: [{
