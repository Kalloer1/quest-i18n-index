# AI 初翻，未人工校对
{
	chapter.01B43572A671F49B.title: "第一步：基础操作指南"
	chapter.172B129E854153F0.title: "世界探险家"
	quest.00183724E39B537F.quest_desc: ["收集黄金用于制作金苹果、以物易物和高级红石组件。"]
	quest.00183724E39B537F.quest_subtitle: "一丝奢华的气息。"
	quest.0929C55FD6591DFA.quest_desc: ["打碎树木，将原木变成木板，然后制作你的第一个工作台。这将解锁你早期所需的几乎所有配方。"]
	quest.0929C55FD6591DFA.quest_subtitle: "伟大的旅程都始于一个合成台。"
	quest.0A1F9922F0C9783C.quest_desc: ["从木制工具升级到石制工具，耐久度和速度的提升将改变一切。"]
	quest.0A1F9922F0C9783C.quest_subtitle: "鹅卵石铺就了前方的道路。"
	quest.0D84378852865C3D.quest_desc: ["获取探险家指南针，定位各种独特且可探索的生物群系。"]
	quest.0D84378852865C3D.quest_subtitle: "探索不同的生物群系"
	quest.0DDD943AB81BC3E2.quest_desc: ["温带草原；村庄可生成于草原（牧场变种无树木且更安静）。"]
	quest.0DDD943AB81BC3E2.quest_subtitle: "前往 Prairie 生物群系。"
	quest.0F7D30B18AE94B4B.quest_desc: ["先制作至少一把木制镐、斧头和铲子。"]
	quest.0F7D30B18AE94B4B.quest_subtitle: "是时候用木头的方式砍伐、采矿和挖掘了。"
	quest.1092802F30A4144C.quest_desc: ["寻找珍贵的绿宝石。它们和村民交易时非常值钱。"]
	quest.1092802F30A4144C.quest_subtitle: "珍贵的绿宝石"
	quest.19CB5C08030DBEFF.quest_desc: ["高耸的冰雪山峰，覆盖着粉雪和山羊；带上皮革靴子以免陷落。"]
	quest.19CB5C08030DBEFF.quest_subtitle: "前往生物群系 Frozen Peaks。"
	quest.1A0E84B46BBAB3D6.quest_desc: ["以竹笋为主的丛林变种；熊猫栖息地，快速可再生的脚手架来源。"]
	quest.1A0E84B46BBAB3D6.quest_subtitle: "前往名为 Bamboo Jungle 的生物群系。"
	quest.1F54D3C71327C466.quest_desc: ["炎热干旱的沙漠，没有雨水；仙人掌和甘蔗，还有夜晚的寺庙、村庄和残骸。"]
	quest.1F54D3C71327C466.quest_subtitle: "前往沙漠生物群系。"
	quest.206D2A27E38C880F.quest_desc: ["平坦、寒冷的雪地草原；树木较少，可能有雪地村庄。"]
	quest.206D2A27E38C880F.quest_subtitle: "前往雪地平原（Snowy Plains）生物群系。"
	quest.20D89ACD6BD792EF.quest_desc: ["副手盾牌能救你一命，尤其是在早期。"]
	quest.20D89ACD6BD792EF.quest_subtitle: "小心驶得万年船，总比事后后悔好。"
	quest.29C72054ADD85C1E.quest_desc: ["制作桶，用于垂直式村庄风格储物，适合狭窄角落。"]
	quest.29C72054ADD85C1E.quest_subtitle: "紧凑、整洁的储物空间。"
	quest.2B8FE4C7A83690F9.quest_desc: ["一片充满鲜艳蓝紫色树木、发光蘑菇和神秘氛围的魔法森林。"]
	quest.2B8FE4C7A83690F9.quest_subtitle: "前往神秘丛林这个生物群系"
	quest.2C1016A0D33E4861.quest_desc: ["开阔的草原，树木稀少，被动生物众多，村庄频繁出现——非常适合早期建造基地和农场。"]
	quest.2C1016A0D33E4861.quest_subtitle: "前往平原生物群系。"
	quest.2EF369AC25F763C9.quest_desc: ["色彩缤纷的森林变种，盛开着多种花卉和蜜蜂——非常适合制作染料和蜂蜜。"]
	quest.2EF369AC25F763C9.quest_subtitle: "前往名为 Flower Forest 的生物群系。"
	quest.2FD2DCBE9248CEE5.quest_desc: ["极其罕见的、没有怪物的菌毯岛屿，上面有巨型蘑菇和蘑菇人。"]
	quest.2FD2DCBE9248CEE5.quest_subtitle: "前往蘑菇田生物群系。"
	quest.32BFE91A69123602.quest_desc: ["点缀着鲜花和蜜蜂的微风高地草原，通常与山地群系相邻。"]
	quest.32BFE91A69123602.quest_subtitle: "前往名为 Meadow 的生物群系。"
	quest.369C74E71FAF72DE.quest_desc: ["针叶林，有狼、云杉和甜浆果灌木；凉爽气候，有腐殖土斑块。"]
	quest.369C74E71FAF72DE.quest_subtitle: "前往泰加生物群系。"
	quest.3780A56F24446C02.quest_desc: ["茂密的深色橡木林冠使地面昏暗；更多生物生成，深色木材充足。"]
	quest.3780A56F24446C02.quest_subtitle: "前往黑暗森林（Dark Forest）生物群系。"
	quest.381BCD28644089C6.quest_desc: ["游戏中最强的保护。你将几乎无敌。"]
	quest.381BCD28644089C6.quest_subtitle: "获取超级钻石盔甲"
	quest.381C7DF06B02B1E0.quest_desc: ["全套铁制装备能提升生存能力和自信心。"]
	quest.381C7DF06B02B1E0.quest_subtitle: "给那个皮肤加点铁元素吧。"
	quest.38C52C7839E46141.quest_desc: ["获取探险家指南针，定位各种独特且可探索的结构。"]
	quest.38C52C7839E46141.quest_subtitle: "探索不同的建筑遗迹"
	quest.42DFF7000D36855C.quest_desc: ["砾石与粉雪构成的荒原，遍布沙漠草，气候寒冷，且没有被动生物；不常见。"]
	quest.42DFF7000D36855C.quest_subtitle: "前往生物群系：寒冷沙漠。"
	quest.43A9D41C2E02AF5C.quest_desc: ["建造一个5×5的庇护所并放置一张床。"]
	quest.43A9D41C2E02AF5C.quest_subtitle: "在舒适的环境中度过你的第一个夜晚。"
	quest.45F75FD93B6967E0.quest_desc: ["将收获的麦子做成面包，获得简单可再生的食物来源。"]
	quest.45F75FD93B6967E0.quest_subtitle: "可靠的碳水化合物来源。"
	quest.465165E71AA49333.quest_desc: ["罕见而醒目的压缩冰柱群；美丽却湿滑的地形。"]
	quest.465165E71AA49333.quest_subtitle: "前往名为 Ice Spikes 的生物群系。"
	quest.47116EFCCF31BAB4.quest_desc: ["开采下界的远古残骸，将其精炼成下界合金——耐久的巅峰。"]
	quest.47116EFCCF31BAB4.quest_subtitle: "隐藏在深处之中。"
	quest.47F2A3F359713DB1.quest_desc: ["开始绘制周围环境图以进行导航。"]
	quest.47F2A3F359713DB1.quest_subtitle: "了解你的土地，将其绘制下来。"
	quest.47F8FAB897A6F452.quest_desc: ["温带森林，有橡木、桦木、鲜花和蜜蜂；木材易获取，常见生物多。"]
	quest.47F8FAB897A6F452.quest_subtitle: "前往名为 Forest 的生物群系。"
	quest.481610F436A06707.quest_desc: ["将生铁锻造成锭，开启通往更强工具、盔甲和实用物品的道路。"]
	quest.481610F436A06707.quest_subtitle: "熔炼基础材料。"
	quest.4AB92A705803846C.quest_desc: ["升级为石头以获得速度和耐用性。"]
	quest.4AB92A705803846C.quest_subtitle: "更强的工具，更强的你。"
	quest.4C614AE2FE22D3A7.quest_desc: ["环游世界的最佳方式"]
	quest.4C614AE2FE22D3A7.quest_subtitle: "使用鞘翅，飞行速度更快"
	quest.4CA9DB7F83A72E66.quest_desc: ["温暖干燥的平原，有金合欢树、连绵起伏的丘陵和频繁的村庄。"]
	quest.4CA9DB7F83A72E66.quest_subtitle: "前往生物群系：热带草原。"
	quest.4D1FD0094B571169.quest_desc: ["广阔的草地和粗土上遍布罂粟/玫瑰丛；这里没有树木生成——没有附近的木材，生存会很困难"]
	quest.4D1FD0094B571169.quest_subtitle: "前往生物群系 Lush Savanna。"
	quest.4F2CB70961BB7619.quest_desc: ["深入洞穴，获取你的第一批钻石。时运固然重要，但勇气更为关键。"]
	quest.4F2CB70961BB7619.quest_subtitle: "闪闪发光，而且非常稀有。"
	quest.4FEB666E89BF7BDD.quest_desc: ["用钻石升级你的武器库。"]
	quest.4FEB666E89BF7BDD.quest_subtitle: "比钢铁还要锋利。"
	quest.504B51074594DF34.quest_desc: ["稀疏的开花橡树、独特的绿色调、玫瑰丛和雏菊；早期游戏农场轻松建造（新版本为杜鹃花树）。"]
	quest.504B51074594DF34.quest_subtitle: "前往名为 Orchard 的生物群系。"
	quest.51E63EDF627254AA.quest_desc: ["锻造终极防护——与之一致的利刃。无物能比它更锋利、更持久。"]
	quest.51E63EDF627254AA.quest_subtitle: "用碎石块把我覆盖起来。"
	quest.5307A1BFBB7F2C81.quest_desc: ["尽早整理资源，使用大型储物空间。"]
	quest.5307A1BFBB7F2C81.quest_subtitle: "你需要足够的空间来存放所有战利品。"
	quest.59920568FFC5EE19.quest_desc: ["条纹陶土台地和红色沙地；地表金矿和频繁的废弃矿井。"]
	quest.59920568FFC5EE19.quest_subtitle: "前往生物群系 Badlands 探险。"
	quest.5DA8C25CA110FBB8.quest_desc: ["樱花、蜜蜂和花瓣遍布的宁静粉色丘陵，非常适合建造风景建筑。"]
	quest.5DA8C25CA110FBB8.quest_subtitle: "前往名为 Cherry Grove 的生物群系。"
	quest.5F288646F121D53F.quest_desc: ["储备好煤炭，制作大量火把。"]
	quest.5F288646F121D53F.quest_subtitle: "深挖地底，点亮光明。"
	quest.5F8F1A7E2077C8B3.quest_desc: ["戏剧性的、刀锋般锋利的雪山，悬崖峭壁——充满挑战的攀登路线。"]
	quest.5F8F1A7E2077C8B3.quest_subtitle: "前往名为 Jagged Peaks 的生物群系。"
	quest.61C52A8336D0F67F.quest_desc: ["浅滩、睡莲、女巫小屋和藤蔓；特定月相的夜晚会出现史莱姆。"]
	quest.61C52A8336D0F67F.quest_subtitle: "前往沼泽（Swamp）生物群系。"
	quest.65799BEF8416E171.quest_desc: ["用小麦繁殖奶牛，获取皮革和牛肉。"]
	quest.65799BEF8416E171.quest_subtitle: "两头牛能生出更多牛"
	quest.66C3A72E382EBE43.quest_desc: ["罕见的彩虹桦和冷杉林；冰雪鸢尾和紫罗兰覆盖着宁静祥和的雪景（通常在蘑菇地/冰冻海洋附近）。"]
	quest.66C3A72E382EBE43.quest_subtitle: "前往极光花园这个生物群系。"
	quest.6A363B5303B6A2DE.quest_desc: ["熔炼或烹饪食物，在挖矿和战斗中高效饱腹。"]
	quest.6A363B5303B6A2DE.quest_subtitle: "蛋白质的力量。"
	quest.6BA24C8D529A51FB.quest_desc: ["秋季枫木/橡木林，有黄橙红落叶堆、蘑菇和南瓜的亚变种。"]
	quest.6BA24C8D529A51FB.quest_subtitle: "前往季节性森林这个生物群系。"
	quest.6E2E8495A48381A0.quest_desc: ["泥泞的浅滩和盘根错节的红树林根系；青蛙、泥土方块和红木套装。"]
	quest.6E2E8495A48381A0.quest_subtitle: "前往生物群系：红树林沼泽。"
	quest.70ACBAF09436A68D.quest_desc: ["黑暗、阴森的森林，遍布黑树，氛围诡异。"]
	quest.70ACBAF09436A68D.quest_subtitle: "前往不祥之森这个生物群系"
	quest.71C1A3F0FECF96C5.quest_desc: ["绯红迷雾的末地生物群系，遍布玫瑰石英块尖塔和晶洞——闪闪发光的水晶洞穴。"]
	quest.71C1A3F0FECF96C5.quest_subtitle: "前往名为 Crystalline Chasm 的生物群系。"
	quest.7618DF62A53D713A.quest_desc: ["设置一个基准点，以便快速返回。"]
	quest.7618DF62A53D713A.quest_subtitle: "快速旅行是最好的旅行方式。"
	quest.783625CEDD180E9D.quest_desc: ["高大的桦树、平缓的地形和清晰的视野构成的明亮林地。"]
	quest.783625CEDD180E9D.quest_subtitle: "前往桦树林生物群系。"
	quest.7844AE79F1E9199A.quest_desc: ["藤蔓、可可和竹子遍布的茂密热带植被；参天大树间有鹦鹉和豹猫。"]
	quest.7844AE79F1E9199A.quest_subtitle: "前往丛林生物群系。"
	quest.78D955BE9717DBE3.quest_desc: ["翻耕土地，种植小麦，浇水，然后收割。"]
	quest.78D955BE9717DBE3.quest_subtitle: "面包不会自己烤熟的。"
	quest.7FA47A43E76F2EEF.quest_desc: ["一望无际的紫色薰衣草花海，散发着令人宁静的芬芳。"]
	quest.7FA47A43E76F2EEF.quest_subtitle: "前往薰衣草田生物群系 Lavender Fields"
}
