					tag: {
						value: "tfc:stone_tools"
					}
				}
				title: "制作任意石质工具"
				type: "item"
			}]
			title: "“两石”激起千层浪"
			x: 0.0d
			y: 3.0d
		}
		{
			dependencies: ["01414007F2A56DCD"]
			description: [
				"&o切割发轫的兽皮，斩断土地上的植物，"
				"&o曾伤害你的岩石已变成你手上锋利的器具。"
				"&o拆解一只鹿不再是难事，"
				"&o你和你的原始人伙伴都得到了公平的餐食。"
				"&o你的&4利爪&r，进化成了一把&b石刀&r。"
			]
			hide_until_deps_visible: true
