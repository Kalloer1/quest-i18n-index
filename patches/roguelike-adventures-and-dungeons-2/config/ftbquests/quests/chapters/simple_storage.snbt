				}
			}]
		}
		{
			x: -1.0d
			y: -1.5d
			description: ["抽屉控制器从机允许您在连接到存储控制器时扩展您的存储系统。这比使用多个控制器更节省性能。"]
			dependencies: ["66D26625F2F9CB42"]
