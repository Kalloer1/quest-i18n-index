# AI 初翻，未人工校对
{
	chapter.0000000000010011.title: "入门指南"
	chapter.000000000001050C.title: "众神之神"
	chapter.0000000000010A7E.title: "力量 \& 能量"
	chapter.0000000000010F35.title: "创建"
	chapter.0000000000011474.title: "Mekanism"
	chapter.0000000000011991.title: "储物空间"
	chapter.0000000000011E8C.title: "魔法：新艺术风格（Magic: Ars Nouveau）"
	chapter.00000000000123DC.title: "魔法：神秘学（Occultism）"
	chapter.000000000001292C.title: "农业与食物 \\nFarming \& Food"
	chapter.0000000000012E9E.title: "Immersive Engineering"
	chapter.00000000000133DD.title: "跨模组自动化系统"
	chapter.000000000001394F.title: "终局阶段"
	chapter.0000000000014000.title: "The Grid"
	chapter.0000000000015000.title: "贸易站"
	chapter.2C8312DC87E1E9BE.quest_desc: [
		"工具、盔甲、附魔，以及制造它们的机器。"
		"Ender IO 和 Silent Gear 与原版附魔并列。右侧分支用于稀有的网格植物和冰块。"
	]
	chapter.2C8312DC87E1E9BE.title: "装备升级中"
	chapter.4F0E57C10A1B2C3D.quest_desc: [
		"此网格中没有世界蜂巢。蜜蜂来自筛子、本章内容，以及你之后繁殖的任何生物。"
		"首先是Forestry CE。如果你留下，农场就会出现。侧分支仅在安装了额外蜜蜂模组时才会出现。"
	]
	chapter.4F0E57C10A1B2C3D.title: "Forestry \& 蜜蜂"
	chapter.6BEE0C7A1D2E3F40.title: "勤劳的蜜蜂模组 (Productive Bees)"
	chapter.7DEB56670374C084.quest_desc: [
		"这个网格里没有值得一提的洞穴和村庄。但它有的是刷怪笼，每个空隙都是一个刷怪点。"
		"先完成原版悬赏，再打传奇怪物。带上桥梁和回程方式。"
	]
	chapter.7DEB56670374C084.title: "狩猎与悬赏"
	quest.000000000000FA01.quest_desc: [
		"和朋友一起玩？大家共享同一个网格。\n\n§6占领你的地盘：§r打开带有 §bM§r 的地图，并使用 FTB Chunks 来占领你正在建造的区域。\n\n§6共享任务进度：§r打开这本任务书，前往 §b团队§r 标签页，创建一个队伍，并邀请你的朋友。任务进度和奖励将与该团队共享。\n\n§7单人玩家可以忽略此任务。§r"
		"&e坠落会把你带回共享的 Overworld 平台，但谨慎搭桥仍然比绕远路快得多。&r"
	]
	quest.000000000000FA01.quest_subtitle: "服务器 \& 多人游戏设置"
	quest.000000000000FA01.title: "与好友一同玩耍"
	quest.0000000000010055.quest_desc: [
		"你的新手包里有橡木树苗，但整个网格中会出现多种类型的原木。"
		"种一棵树或搭一座桥到你看得见的地方——任何类型的原木都算。"
	]
	quest.0000000000010055.title: "第一块木材"
	quest.0000000000010088.quest_desc: ["所有合成的基石。将4个木板放入2x2的方格中。"]
	quest.0000000000010088.title: "第一张工作台 Crafting Table"
	quest.00000000000100BB.quest_desc: ["制作木制镐来开采石头。"]
	quest.00000000000100BB.title: "木制工具"
	quest.00000000000100EE.quest_desc: ["熔炼矿石、烹饪食物、制作木炭。一件必不可少的工具。"]
	quest.00000000000100EE.title: "熔炉"
	quest.0000000000010132.quest_desc: ["用原木作为燃料在熔炉中冶炼原木以获取木炭。"]
	quest.0000000000010132.title: "燃烧吧，宝贝，燃烧吧"
	quest.0000000000010176.quest_desc: [
		"将水放在岩浆旁边以生成鹅卵石。"
		"无限挖掘以获取建筑材料。深板岩砖和苔藓覆盖的鹅卵石也算数。"
		"&7发电机需要水和岩浆，而网格中两者都没有。冰能给你水；Ex Deorum crucible能给你岩浆。&r"
	]
	quest.0000000000010176.title: "鹅卵石生成器"
	quest.00000000000101A9.quest_desc: ["升级你的工具。石制镐挖掘更快，也更耐用。"]
	quest.00000000000101A9.title: "石器时代"
	quest.00000000000101ED.quest_desc: [
		"用木棍和木炭制作火把。生物会在黑暗中生成。"
		"晶格上的每个间隙都是有效的出生点，在所有高度和六个面上都适用。你在这里不是在保卫一个周长。"
	]
	quest.00000000000101ED.title: "要有光，就有了光"
	quest.0000000000010231.quest_desc: ["整理你的战利品。制作两个箱子并放在一起，组成一个双联箱。"]
	quest.0000000000010231.title: "Chest Storage"
	quest.0000000000010264.quest_desc: ["在夜晚出现的怪物中保护自己。"]
	quest.0000000000010264.title: "石制剑"
	quest.00000000000102A8.quest_desc: [
		"铁块不会在网格世界中生成。"
		"使用 Ex Deorum 的筛子和网从砾石和沙子中找出它。"
	]
	quest.00000000000102A8.title: "第一块铁锭 First Iron"
	quest.00000000000102DB.quest_desc: ["一次重大的升级。铁镐可以挖掘钻石了。"]
	quest.00000000000102DB.title: "铁质镐"
	quest.000000000001030E.quest_desc: ["锋利可靠。对付怪物要好用得多。"]
	quest.000000000001030E.title: "铁质剑"
	quest.0000000000010352.quest_desc: [
		"安全地携带水和岩浆。在网格中创造资源所必需。"
		"&eThere is no water anywhere in this grid.&r Water and lava were removed deliberately - as floating source blocks they cascade and flood the world."
		"&b冰就是答案。&r将冰块放置在固体方块上并打破，它便会变成水源。这个技巧能解锁农业、鹅卵石发电机以及本整合包中几乎所有的机器。"
	]
	quest.0000000000010352.title: "水桶军团"
	quest.0000000000010396.quest_desc: ["烹饪原石获得平滑石，然后用石头砖块建造。苔藓、裂纹和雕凿砖块都算数。"]
	quest.0000000000010396.title: "石砖"
	quest.00000000000103DA.quest_desc: [
		"使用 Ex Deorum 锤子可以将砾石锤成沙子。"
		"玻璃、混凝土等都需要沙子。红沙也算数。"
		"&7沙子会坠落。没有任何支撑的沙子方块，一旦受到扰动就会坠入虚空。&r"
	]
	quest.00000000000103DA.title: "沙质海岸"
	quest.000000000001041E.quest_desc: ["将沙子熔炼成玻璃。你需要它来制作信标、储罐和装饰品。彩色玻璃需要额外的工作，无色玻璃就足够了。"]
	quest.000000000001041E.title: "清晰视野"
	quest.0000000000010462.quest_desc: ["泥土在方格中很珍贵。筛砾石和沙子，或用材料堆肥。草、粗土和泥都算数。"]
	quest.0000000000010462.title: "泥土富翁"
	quest.0000000000010495.quest_desc: ["保护自己。铁质盔甲能显著减少来自怪物的伤害。"]
	quest.0000000000010495.title: "铁质盔甲"
	quest.00000000000104FB.quest_desc: [
		"你已经掌握了天空网格生存的基本技巧。"
		"整个世界模组正等待着你。前进！"
	]
	quest.00000000000104FB.title: "天空才是极限"
	quest.0000000000010550.quest_desc: [
		"木制钩子能显著提高树叶的掉落物。"
		"用它来获取树苗、线和蚕宝宝。"
	]
	quest.0000000000010550.title: "用于采集叶子的钩爪工具"
	quest.0000000000010594.quest_desc: [
		"筛子是你在地形中找矿石的主要工具。用泥土、砾石、沙子或尘土装满它。"
		"任何木材都行——橡木、云杉、绯红木，随你喜好。网格会批量提供泥土、砾石和沙子，但会隐藏其中的矿石。筛子能将一种转化为另一种——这是整个包运行的循环。"
	]
	quest.0000000000010594.title: "建造一个筛子"
	quest.00000000000105D8.quest_desc: ["燧石筛网是你的首个筛网升级。比线筛网的产量更高。"]
	quest.00000000000105D8.title: "燧石网格"
	quest.000000000001061C.quest_desc: ["用燧石筛网筛砾石，稳定获取燧石。生火必备。"]
	quest.000000000001061C.title: "从砾石中获取燧石"
	quest.0000000000010660.quest_desc: ["升级到铁丝网，提高筛分矿石的产量。"]
	quest.0000000000010660.title: "铁质网格"
	quest.00000000000106A4.quest_desc: ["锤子能将方块粉碎成更小的形态：原矿 → 砾石 → 沙子 → 粉尘。"]
	quest.00000000000106A4.title: "是时候用锤子了"
	quest.00000000000106E8.quest_desc: ["比石锤更耐用、速度更快。"]
	quest.00000000000106E8.title: "铁锤 (Iron Hammer)"
	quest.000000000001072C.quest_desc: ["将沙子锤成粉末。粉末筛能比其他材料带来更高的矿石产量。"]
	quest.000000000001072C.title: "轻松搞定，毫无压力！"
	quest.0000000000010770.quest_desc: ["用铁网筛筛尘土，寻找铁粒。9个铁粒 = 1个铁锭。"]
	quest.0000000000010770.title: "无中生有的金块（Nuggets from Nothing）"
	quest.00000000000107B4.quest_desc: ["用铁丝网筛筛沙砾或碎石，寻找金块。"]
	quest.00000000000107B4.title: "黄金狂热"
	quest.00000000000107F8.quest_desc: ["制作金网，筛分时有更大概率获得稀有掉落物。"]
	quest.00000000000107F8.title: "黄金网格"
	quest.000000000001083C.quest_desc: ["钻石可以用金筛从沙砾或粉尘中筛出。耐心的筛分终有回报。"]
	quest.000000000001083C.title: "未经雕琢的钻石"
	quest.0000000000010880.quest_desc: [
		"在外面放一个木桶，用雨水或水桶装满水。任何木材都可以。"
		"用它来创造泥土、堆肥和女巫药水。"
		"&e这解决了你的泥土问题。&r泥土在网格中是有限的，而你在农田、桥梁和树苗床时会大量消耗它。"
	]
	quest.0000000000010880.title: "木桶"
	quest.00000000000108C4.quest_desc: ["将桶装满水，投入树苗，一段时间后泥土就会生成。"]
	quest.00000000000108C4.title: "泥土工厂"
	quest.0000000000010908.quest_desc: [
		"熔炉能将鹅卵石熔成岩浆，将木头熔成水，需要热源。"
		"&e这是整合包里唯一的岩浆来源。&r岩浆和水的理由一样，被移除了。"
	]
	quest.0000000000010908.title: "The Crucible"
	quest.000000000001094C.quest_desc: ["将鹅卵石放入熔炉中，置于热源上方以生成熔岩。"]
	quest.000000000001094C.title: "随叫随到的岩浆"
	quest.0000000000010990.quest_desc: ["第一级网格。使用线（来自树叶或丝绸蠕虫）来制作。"]
	quest.0000000000010990.title: "字符串 Mesh"
	quest.00000000000109D4.quest_desc: ["用金筛可以从砾石中筛出绿宝石。对 Apotheosis 和交易很有用。"]
	quest.00000000000109D4.title: "绿色代表前进"
	quest.0000000000010A18.quest_desc: ["用钻石筛过滤灵魂沙（如有），或用其他方式寻找远古残骸。下界合金在等着你。"]
	quest.0000000000010A18.title: "远古之力"
	quest.0000000000010A6D.quest_desc: ["你已解锁完整的筛分链。钻石筛网能带来最精细的产出。"]
	quest.0000000000010A6D.title: "大师级筛选器"
	quest.0000000000010AC2.quest_desc: [
		"熔炉燃烧固体燃料以产生RF能量。"
		"在旁边放一个煤炭箱子，然后连接你的第一台机器。"
	]
	quest.0000000000010AC2.title: "第一台发电机"
	quest.0000000000010B06.quest_desc: ["Powah 电线用于在发电机、电池和机器之间传输能量。"]
	quest.0000000000010B06.title: "电力线路"
	quest.0000000000010B4A.quest_desc: ["将RF能量存储在能量单元中。机器闲置时不再浪费电力。"]
	quest.0000000000010B4A.title: "能量存储装置"
	quest.0000000000010B8E.quest_desc: [
		"Flux Networks 让你可以无线传输电力。"
		"将Flux Plug放置在你的发电机上，将Flux Point放置在你的机器上。"
	]
	quest.0000000000010B8E.title: "Flux Networks"
	quest.0000000000010BD2.quest_desc: ["Flux Points 从你的 Flux 网络接收能量并将其输送给机器。"]
	quest.0000000000010BD2.title: "电力分配系统"
	quest.0000000000010C05.quest_desc: ["硬化熔炉器用相同的燃料能产生更多的RF/t。尽早升级。"]
	quest.0000000000010C05.title: "升级发电机"
	quest.0000000000010C38.quest_desc: ["升级你的能量单元以存储更多RF。Mekanism上线后你会需要它。"]
	quest.0000000000010C38.title: "更大的电池"
	quest.0000000000010C7C.quest_desc: [
		"在熔岩源和水之间放置一个热发电机。"
		"它能无限产生被动RF——无需燃料。"
	]
	quest.0000000000010C7C.title: "热能发电机"
	quest.0000000000010CAF.quest_desc: ["Flux Controller 管理着你的整个电力网络。监控输入、输出和存储。"]
	quest.0000000000010CAF.title: "网络控制器"
	quest.0000000000010CE2.quest_desc: ["集中式 RF 存储，适用于你的 Flux 网络。超大容量，满足中后期需求。"]
	quest.0000000000010CE2.title: "Flux 存储系统"
	quest.0000000000010D15.quest_desc: ["Powah 合成系统的核心。将其放入 Energizing Orb 中，即可合成高级 Powah 组件。"]
	quest.0000000000010D15.title: "能量化棒"
	quest.0000000000010D48.quest_desc: ["在球体结构中放置2根棒子，开始充能合成。"]
	quest.0000000000010D48.title: "能量球 (Energizing Orb)"
	quest.0000000000010D8C.quest_desc: ["高级 Powah 物品的核心合成材料。在 Energizing Orb 中合成。"]
	quest.0000000000010D8C.title: "介电外壳 (Dielectric Casing)"
	quest.0000000000010DBF.quest_desc: ["RF/t 发电量大幅提升。可满足大部分中后期电力需求。"]
	quest.0000000000010DBF.title: "烈焰熔炉匠人"
	quest.0000000000010DF2.quest_desc: ["Powah Reactors 是多方块发电机，能产生巨量的 RF/t。"]
	quest.0000000000010DF2.title: "反应堆组件"
	quest.0000000000010E36.quest_desc: [
		"建造一个 Powah Reactor 多方块结构。"
		"控制器 + 电池 + 棒 = 巨大的发电量。"
	]
	quest.0000000000010E36.title: "反应堆在线"
	quest.0000000000010E69.quest_desc: ["玩家发射器可为你的奇物无线充电。任务途中再也不会没电。"]
	quest.0000000000010E69.title: "玩家的力量"
	quest.0000000000010E9C.quest_desc: ["管理员流配置器可让您远程管理网络连接。"]
	quest.0000000000010E9C.title: "Flux Configurator"
	quest.0000000000010ECF.quest_desc: ["巨大的RF缓冲器。即使在反应堆停机期间也能让你的机器保持运行。"]
	quest.0000000000010ECF.title: "烈焰存储系统"
	quest.0000000000010F24.quest_desc: ["你的电力基础设施已就绪。一个反应堆和一个通量网络——你将再也不会缺RF了。"]
	quest.0000000000010F24.title: "电力经纪人"
	quest.0000000000010F79.quest_desc: ["所有早期创造机械的基础合成材料。用安山岩和铁粒合成。"]
	quest.0000000000010F79.title: "安山岩合金"
	quest.0000000000010FBD.quest_desc: ["齿轮可传递旋转力。将其相邻放置，可在传动轴之间传递旋转。"]
	quest.0000000000010FBD.title: "第一齿轮箱"
	quest.0000000000011001.quest_desc: ["传动轴将旋转力沿直线传递。建造你的第一个动力网络。"]
	quest.0000000000011001.title: "Shaft Power"
	quest.0000000000011045.quest_desc: [
		"将水轮放置在流动水中以生成应力单位。"
		"前期获取旋转能量的绝佳来源。"
		"&7需要流动的水，也就是说冰块机关必须先能正常工作。&r"
	]
	quest.0000000000011045.title: "水车"
	quest.0000000000011089.quest_desc: ["机械压机可以粉碎和压制物品。制作板材和其他组件所必需。"]
	quest.0000000000011089.title: "机械压榨机"
	quest.00000000000110CD.quest_desc: ["搅拌机利用旋转力混合材料。制作黄铜和许多配方所必需。"]
	quest.00000000000110CD.title: "机械搅拌机"
	quest.0000000000011111.quest_desc: [
		"将铜锭和锌锭放入机械搅拌机中混合，以生产黄铜。"
		"黄铜能解锁中期的机械创造功能。"
	]
	quest.0000000000011111.title: "黄铜时代"
	quest.0000000000011155.quest_desc: ["制作黄铜外壳，用于放置先进的 Create 机器。"]
	quest.0000000000011155.title: "黄铜外壳"
	quest.0000000000011199.quest_desc: ["部署器使用机械臂自动与方块和实体进行交互。"]
	quest.0000000000011199.title: "部署器"
	quest.00000000000111CC.quest_desc: ["将机械收割机连接到移动装置上，实现作物收割自动化。"]
	quest.00000000000111CC.title: "自动农场"
	quest.0000000000011210.quest_desc: ["盆用于收集压榨机和搅拌机的产物。许多合成配方都需要它。"]
	quest.0000000000011210.title: "盆地"
	quest.0000000000011254.quest_desc: ["使用流体管道将流体源连接到水槽、储罐和出水口。"]
	quest.0000000000011254.title: "流体管道"
	quest.0000000000011298.quest_desc: ["泵通过管道输送流体。需要旋转动力才能运行。"]
	quest.0000000000011298.title: "机械水泵"
	quest.00000000000112DC.quest_desc: [
		"蒸汽机产生的压力单位远多于水车。"
		"用岩浆或固体燃料加热锅炉，以获得高输出的旋转动力。"
	]
	quest.00000000000112DC.title: "蒸汽引擎"
	quest.000000000001130F.quest_desc: ["用机械合成阵列自动化无定形和定形合成配方。"]
	quest.000000000001130F.title: "机械合成台"
	quest.0000000000011353.quest_desc: ["用链传动将旋转动力传输到远距离。"]
	quest.0000000000011353.title: "链式传动装置"
	quest.0000000000011386.quest_desc: ["精确控制旋转网络的转速，实现精准机械操作。"]
	quest.0000000000011386.title: "速度控制"
	quest.00000000000113CA.quest_desc: ["机械臂可自动在物品栏和机器之间移动物品。"]
	quest.00000000000113CA.title: "机械臂"
	quest.00000000000113FD.quest_desc: ["通过固定方块访问移动装置的物品栏。"]
	quest.00000000000113FD.title: "便携式接口"
	quest.0000000000011463.quest_desc: [
		"你的创造工厂正在嗡嗡作响。"
		"蒸汽动力、自动化合成和移动装置——这个电网真正活了起来。"
	]
	quest.0000000000011463.title: "全自动自动化系统"
	quest.00000000000114B8.quest_desc: ["能量立方体储存RF，并将Mekanism与其他电力系统连接。"]
	quest.00000000000114B8.title: "Mekanism 能源"
	quest.00000000000114FC.quest_desc: [
		"锇是Mekanism的主要金属。"
		"筛分砾石或粉尘以寻找锇矿石块。"
	]
	quest.00000000000114FC.title: "锇：中流砥柱"
	quest.0000000000011540.quest_desc: ["解锁Mekanism的矿石处理路线。将原矿富集成两种粉尘，然后将其熔炼成两种锭。"]
	quest.0000000000011540.title: "富集室"
	quest.0000000000011584.quest_desc: ["破碎机将材料研磨成团块和粉末，以供进一步处理。"]
	quest.0000000000011584.title: "破碎机"
	quest.00000000000115C8.quest_desc: [
		"净化室+破碎机+富集室组合能产出3倍矿石。"
		"需要电解分离器产生的氧气气体。"
	]
	quest.00000000000115C8.title: "3x 矿石加工"
	quest.000000000001160C.quest_desc: ["将水分解为氢气和氧气。氧气提供3倍处理功率；氢气为燃气燃烧器供能。"]
	quest.000000000001160C.title: "电解分离机"
	quest.0000000000011650.quest_desc: ["添加化学注射室（使用氯化氢）以提高4倍矿石产量。"]
	quest.0000000000011650.title: "4x 处理中"
	quest.0000000000011694.quest_desc: ["包含化学结晶器的完整5步处理链可产出5倍矿石。效率最大化。"]
	quest.0000000000011694.title: "5x 处理中"
	quest.00000000000116D8.quest_desc: ["自动化电解分离器和流体需求的无限供水。"]
	quest.00000000000116D8.title: "电动水泵"
	quest.000000000001171C.quest_desc: ["将金属与碳、红石、钻石等融合，创造合金。"]
	quest.000000000001171C.title: "冶金学注入器"
	quest.0000000000011760.quest_desc: ["高级Mekanism机器的基础合成材料。在融合器中用锇和红石合成。"]
	quest.0000000000011760.title: "Infused Alloy"
	quest.00000000000117A4.quest_desc: ["用钻石注入强化合金。三级机器所需。"]
	quest.00000000000117A4.title: "强化合金 Reinforced Alloy"
	quest.00000000000117D7.quest_desc: [
		"一种强大的采矿机，使用过滤器从世界中提取特定矿石。"
		"&7在skygrid中，这会将特定方块从晶格中拉出，覆盖巨大范围。请谨慎设置过滤器。&r"
	]
	quest.00000000000117D7.title: "数字矿工"
	quest.000000000001180A.quest_desc: ["在世界中的任意两点之间无线传输物品、流体和能量。"]
	quest.000000000001180A.title: "量子纠缠传送器"
	quest.000000000001184E.quest_desc: [
		"Mekanism太阳能发电机在白天会被动地产生RF。"
		"&7这里没有东西遮挡天空，所以太阳能在天空网格中异常强劲。&r"
	]
	quest.000000000001184E.title: "太阳能发电"
	quest.0000000000011892.quest_desc: [
		"风力发电机根据高度产生RF。建得越高，发电量越大。"
		"&7产出与海拔成正比，而海拔正是这个世界不缺少的东西。把它们建得高高的。&r"
	]
	quest.0000000000011892.title: "风力发电机"
	quest.00000000000118C5.quest_desc: ["建造一个Mekanism裂变反应堆多区块结构，以产生巨大的电力。"]
	quest.00000000000118C5.title: "裂变反应堆"
	quest.00000000000118F8.quest_desc: ["使用编码配方自动化合成。与AE2或RS完美搭配。"]
	quest.00000000000118F8.title: "配方合成器 (Formulaic Assemblicator)"
	quest.000000000001192B.quest_desc: ["建造一个Mekanism感应矩阵，用于存储数万亿RF能量。"]
	quest.000000000001192B.title: "感应矩阵"
	quest.0000000000011980.quest_desc: ["5x 矿石处理器和一个感应矩阵。工厂车间已全面投入运行。"]
	quest.0000000000011980.title: "Mekanism 精通"
	quest.00000000000119D5.quest_desc: ["储物抽屉可存放大量单一物品。非常适合大宗材料。任何木材和抽屉尺寸均可。"]
	quest.00000000000119D5.title: "第一个储物抽屉"
	quest.0000000000011A08.quest_desc: ["抽屉控制器就像一个中心枢纽。将物品放入管道，它们会自动分类到正确的抽屉中。"]
	quest.0000000000011A08.title: "抽屉控制器"
	quest.0000000000011A4C.quest_desc: ["复杂的箱子能容纳更多物品，并且可以通过升级槽进行升级。"]
	quest.0000000000011A4C.title: "Sophisticated Storage"
	quest.0000000000011A7F.quest_desc: ["升级到铁质复杂箱子以获得更大的物品容量。"]
	quest.0000000000011A7F.title: "铁质箱子升级"
	quest.0000000000011AC3.quest_desc: ["Sophisticated Backpacks 添加了便携储物功能，让你随时随地都能存取物品。"]
	quest.0000000000011AC3.title: "背包"
	quest.0000000000011B07.quest_desc: [
		"RS 控制器是你 Refined Storage 网络的控制中心。"
		"用线缆将驱动器和终端连接到它上。"
	]
	quest.0000000000011B07.title: "Refined Storage 控制器"
	quest.0000000000011B4B.quest_desc: ["将存储磁盘插入磁盘驱动器，为您的 RS 网络提供存储容量。"]
	quest.0000000000011B4B.title: "磁盘驱动器"
	quest.0000000000011B8F.quest_desc: ["你的第一个RS存储磁盘。可存放1,000种物品。随着进度升级到4K、16K、64K。"]
	quest.0000000000011B8F.title: "1K 存储磁盘"
	quest.0000000000011BC2.quest_desc: ["RS 合成网格让你可以直接使用网络中的材料来合成物品。"]
	quest.0000000000011BC2.title: "合成网格"
	quest.0000000000011BF5.quest_desc: ["将合成配方编码，教会你的 RS 网络如何自动合成物品。"]
	quest.0000000000011BF5.title: "图案网格"
	quest.0000000000011C39.quest_desc: ["RS 制作者将配方材料发送到外部机器进行自动合成。"]
	quest.0000000000011C39.title: "自动合成器"
	quest.0000000000011C7D.quest_desc: ["为您的 RS 网络提供巨大的存储容量。"]
	quest.0000000000011C7D.title: "64K 存储磁盘"
	quest.0000000000011CC1.quest_desc: [
		"Applied Energistics 2 是目前最强大的存储系统。"
		"先建造控制器，然后连接你的第一个驱动器。"
	]
	quest.0000000000011CC1.title: "AE2 控制器"
	quest.0000000000011D05.quest_desc: ["ME Drive 用于存储单元。组合多个驱动器以获得超大存储容量。"]
	quest.0000000000011D05.title: "ME 驱动器"
	quest.0000000000011D38.quest_desc: ["连接合成单元和合成监视器，构建强大的自动合成系统。"]
	quest.0000000000011D38.title: "AE2 自动合成"
	quest.0000000000011D7C.quest_desc: ["便携式批量存储。Dank 可以在你的物品栏中存放数百万个单一物品。"]
	quest.0000000000011D7C.title: "Dank Storage"
	quest.0000000000011DAF.quest_desc: ["巨型箱子是一种可扩展到巨大尺寸的存储箱，用于批量存储。"]
	quest.0000000000011DAF.title: "巨型宝箱 (Colossal Chest)"
	quest.0000000000011DE2.quest_desc: ["升级后的背包，拥有更多格子和升级能力。"]
	quest.0000000000011DE2.title: "铁质背包"
	quest.0000000000011E26.quest_desc: ["LaserIO 使用激光无线传输物品、流体和能量，无需布设管道。"]
	quest.0000000000011E26.title: "LaserIO"
	quest.0000000000011E7B.quest_desc: ["你的存储网络可以存放任何东西，并能按需合成万物。"]
	quest.0000000000011E7B.title: "存储大师"
	quest.0000000000011ED0.quest_desc: [
		"Ars Nouveau 让你能用符文构建自定义法术。"
		"从初级魔法书和第一个符文开始吧。"
	]
	quest.0000000000011ED0.title: "魔法书 The Spell Book"
	quest.0000000000011F14.quest_desc: ["源是 Ars Nouveau 的魔力。将源罐放置在源中继器或源宝石附近即可填充。"]
	quest.0000000000011F14.title: "源文件存档"
	quest.0000000000011F58.quest_desc: ["源浆果灌木会结出源浆果，食用或喂给源浆罐可以恢复源。"]
	quest.0000000000011F58.title: "源浆果（Sourceberries）"
	quest.0000000000011F9C.quest_desc: ["制作咒语羊皮纸以书写咒语。将其放入咒语书中即可创建可用的咒语。"]
	quest.0000000000011F9C.title: "法术羊皮纸"
	quest.0000000000011FE0.quest_desc: ["符文是法术的基本单位。增幅能提高法术的威力。"]
	quest.0000000000011FE0.title: "第一符文"
	quest.0000000000012024.quest_desc: ["中继器可以在罐子之间传输源。建造一个网络来保持你的源充足。"]
	quest.0000000000012024.title: "源中继器"
	quest.0000000000012068.quest_desc: ["用源力灌注物品，创造秘银金属和灌注羊毛等魔法材料。"]
	quest.0000000000012068.title: "附魔室 (Imbuement Chamber)"
	quest.00000000000120AC.quest_desc: ["秘法核心是制作高级新艺术组件的制造台。"]
	quest.00000000000120AC.title: "Arcane Core"
	quest.00000000000120F0.quest_desc: ["升级你的魔法书，解锁更复杂的法术和更高阶的符文。"]
	quest.00000000000120F0.title: "学徒魔法书"
	quest.0000000000012123.quest_desc: ["发射符文是迈向梦寐以求的阿特·努沃飞行法术的一步。"]
	quest.0000000000012123.title: "飞行准备"
	quest.0000000000012167.quest_desc: ["永恒的光源。制作并放置在任何地方即可获得永久照明。"]
	quest.0000000000012167.title: "Jar of Light"
	quest.000000000001219A.quest_desc: ["Wixies 是能够自动酿造药水的魔法伙伴。"]
	quest.000000000001219A.title: "Wixie"
	quest.00000000000121DE.quest_desc: ["传送到指定位置。对于快速返回基地来说非常宝贵。"]
	quest.00000000000121DE.title: "魔法的镜子"
	quest.0000000000012222.quest_desc: ["最高阶的魔法书。解锁 Ars Nouveau 中最强大的符文。"]
	quest.0000000000012222.title: "大魔导师的魔法书"
	quest.0000000000012266.quest_desc: ["飞行符文与自我施放结合，可让你持续进行魔法飞行。"]
	quest.0000000000012266.title: "振翅高飞"
	quest.00000000000122AA.quest_desc: ["从附近的植物生长中生成源。放置在农场旁边以实现被动源生成。"]
	quest.00000000000122AA.title: "农业学源链接 Agronomic Sourcelink"
	quest.00000000000122EE.quest_desc: ["利用热量产生源。放置在岩浆附近可获得快速稳定的源供应。"]
	quest.00000000000122EE.title: "火山源链接 Volcanic Sourcelink"
	quest.0000000000012332.quest_desc: ["Drygmies 是一种宠物，靠近生物时能被动地收集生物掉落物。"]
	quest.0000000000012332.title: "干地格米护身符"
	quest.0000000000012376.quest_desc: ["Whirlisprig 使魔能加速植物生长。放置在农场附近可被动收获作物。"]
	quest.0000000000012376.title: "Whirlisprig"
	quest.00000000000123CB.quest_desc: ["你已经掌握了新艺术。法术、使魔和飞行都归你所有。"]
	quest.00000000000123CB.title: "大法师 (The Archmage)"
	quest.0000000000012420.quest_desc: [
		"动物脂肪可以炼成动物油，是 Occultism 合成的基础材料。"
		"杀死猪或牛收集生脂肪，然后将其冶炼。"
	]
	quest.0000000000012420.title: "第一桶牛脂"
	quest.0000000000012464.quest_desc: ["用动物脂肪和石头合成Otherstone。这是Occultism建筑的建筑材料。"]
	quest.0000000000012464.title: "其他石头"
	quest.00000000000124A8.quest_desc: ["与灵体共鸣的宝石能引导精神能量。是召唤仪式的必需品。"]
	quest.00000000000124A8.title: "与精神共鸣的宝石"
	quest.00000000000124EC.quest_desc: ["在地上画一个五芒星，创建一个仪式圈。所有召唤的基础。"]
	quest.00000000000124EC.title: "五芒星"
	quest.0000000000012530.quest_desc: ["将仪式人偶放置在五芒星中心以持有仪式物品。"]
	quest.0000000000012530.title: "仪式假人"
	quest.0000000000012574.quest_desc: ["神秘学指南。仔细阅读——里面包含了所有你需要的仪式和召唤。"]
	quest.0000000000012574.title: "灵体词典"
	quest.00000000000125B8.quest_desc: ["使用金粉在地板上画出仪式五芒星。"]
	quest.00000000000125B8.title: "黄金粉笔"
	quest.00000000000125FC.quest_desc: ["制作其他石头框架，用于你的存储和召唤基础设施。"]
	quest.00000000000125FC.title: "Otherstone 框架"
	quest.0000000000012640.quest_desc: [
		"Occultism 的维度存储使用召唤出的灵魂将物品储存在其他维度中。"
		"建造存储控制器以开始游戏。"
	]
	quest.0000000000012640.title: "灵魂存储装置"
	quest.0000000000012684.quest_desc: ["将你的 Occultism 存储网络与稳定的虫洞连接以实现远程访问。"]
	quest.0000000000012684.title: "稳定的虫洞"
	quest.00000000000126C8.quest_desc: ["召唤一个Foliot矿工灵体，为你从灵体维度开采矿石。"]
	quest.00000000000126C8.title: "Foliot Miner"
	quest.000000000001270C.quest_desc: ["升级到Djinni矿工，从灵界获得更多矿石回报。"]
	quest.000000000001270C.title: "Djinni Miner"
	quest.0000000000012750.quest_desc: ["阿夫里特矿工深入维度寻找稀有材料。"]
	quest.0000000000012750.title: "阿夫里特矿工"
	quest.0000000000012794.quest_desc: ["马里德是最强大的矿工之灵。它能带回最稀有的矿石，而且数量众多。"]
	quest.0000000000012794.title: "马里德矿工"
	quest.00000000000127D8.quest_desc: ["在灵魂宝石中捕捉生物的灵魂，创造永久的灵魂仆从和伙伴。"]
	quest.00000000000127D8.title: "灵魂宝石"
	quest.000000000001281C.quest_desc: ["将一只宠物绑定到戒指上，并将其作为奇物装备以获得被动加成。"]
	quest.000000000001281C.title: "熟悉的戒指 (Familiar Ring)"
	quest.000000000001284F.quest_desc: ["执行高级召唤仪式，将强大的实体召唤来助你一臂之力。"]
	quest.000000000001284F.title: "异界仪式 (Otherworldly Rituals)"
	quest.0000000000012893.quest_desc: ["使用存储遥控器，随时随地访问你的 Occultism 维度存储空间。"]
	quest.0000000000012893.title: "远程存储设备"
	quest.00000000000128C6.quest_desc: ["制作一个矿石破碎机灵，自动被动地处理矿石。"]
	quest.00000000000128C6.title: "灵魂工匠"
	quest.000000000001291B.quest_desc: ["灵魂为你采矿，为你储藏，为你而战。神秘之术尽归你所有。"]
	quest.000000000001291B.title: "灵魂大师"
	quest.0000000000012970.quest_desc: ["在农田上种植小麦。它是食物和许多模组配方的基础。"]
	quest.0000000000012970.title: "首次丰收"
	quest.00000000000129B4.quest_desc: [
		"Farmer’s Delight 添加了逼真的烹饪机制。"
		"砧板可以让你准备食材。"
	]
	quest.00000000000129B4.title: "农夫的砧板"
	quest.00000000000129F8.quest_desc: ["在烹饪锅中制作复杂的菜肴。更美味的食物能提供更强的饱腹感。"]
	quest.00000000000129F8.title: "烹饪锅"
	quest.0000000000012A3C.quest_desc: ["用小麦制作稻草。可用于农夫的惊喜配方和生物巢穴。"]
	quest.0000000000012A3C.title: "干草块"
	quest.0000000000012A80.quest_desc: [
		"Mystical Agriculture 让你可以把矿石和材料当作物来种植。"
		"Inferium 种子是你的起点——种植它们以获得精华。"
	]
	quest.0000000000012A80.title: "Inferium 种子"
	quest.0000000000012AC4.quest_desc: ["收割inferium作物以获得精华。更高级的精华由inferium合成。"]
	quest.0000000000012AC4.title: "Inferium 精华"
	quest.0000000000012B08.quest_desc: ["用 Inferium Essence 合成 Prudentium Essence，以解锁 Tier 2 的神秘农业作物。"]
	quest.0000000000012B08.title: "审慎等级 Prudentium Tier"
	quest.0000000000012B4C.quest_desc: ["种植铁种子可产出铁精，可锻造为铁锭。无限铁！"]
	quest.0000000000012B4C.title: "铁质种子"
	quest.0000000000012B90.quest_desc: ["将钻石作为作物种植。需要更高等级的精华才能解锁。"]
	quest.0000000000012B90.title: "钻石种子"
	quest.0000000000012BD4.quest_desc: ["BotanyPots 占用空间小，可种植作物。填入合适的土壤，种植任意种子。任何颜色的花盆或漏斗花盆均可。"]
	quest.0000000000012BD4.title: "BotanyPots"
	quest.0000000000012C18.quest_desc: ["使用漏斗植物学花盆自动化作物收割，作物将自动收集到下方的箱子中。"]
	quest.0000000000012C18.title: "漏斗植物学花盆 BotanyPot"
	quest.0000000000012C5C.quest_desc: [
		"Productive Bees 添加了可被动生产资源的自定义蜜蜂。"
		"捕捉并繁殖蜜蜂以生产铁、金、钻石等物品。"
	]
	quest.0000000000012C5C.title: "勤劳的蜜蜂模组 (Productive Bees)"
	quest.0000000000012CA0.quest_desc: ["高级蜂巢会自动将蜂巢处理成资源。任何木材都可以。"]
	quest.0000000000012CA0.title: "高级蜂巢"
	quest.0000000000012CE4.quest_desc: ["Aquaculture 扩展了钓鱼内容，加入了新品种鱼和渔具。一种放松的食物来源。"]
	quest.0000000000012CE4.title: "Aquaculture"
	quest.0000000000012D28.quest_desc: ["最高阶的 Mystical Agriculture 种子。种植 supremeium 以获得最佳作物。"]
	quest.0000000000012D28.title: "Supremium 种子"
	quest.0000000000012D6C.quest_desc: ["将下界合金废料作为作物种植。资源自动化的巅峰之作。"]
	quest.0000000000012D6C.title: "下界合金种子"
	quest.0000000000012DB0.quest_desc: ["用洒水壶加速作物生长。更高等级可作用于更大区域。"]
	quest.0000000000012DB0.title: "浇水壶"
	quest.0000000000012DE3.quest_desc: ["Farming for Blockheads 市场可以让你购买种子和其他农业材料。"]
	quest.0000000000012DE3.title: "农业市场"
	quest.0000000000012E27.quest_desc: ["在 Farmer’s Delight 中烹饪一道复杂的菜肴，以获得饱食度和增益效果。"]
	quest.0000000000012E27.title: "精致美食"
	quest.0000000000012E8D.quest_desc: ["你的农场能产出从下界合金到美食的一切。完全自给自足。"]
	quest.0000000000012E8D.title: "农场主大师"
	quest.0000000000012EE2.quest_desc: ["IE 锤子可以组成多区块和面板。没有它就无法建造 IE 机器。"]
	quest.0000000000012EE2.title: "工程师的锤子"
	quest.0000000000012F26.quest_desc: ["IE 使用电线和连接器来传输电力。铜线是你的第一层级。"]
	quest.0000000000012F26.title: "铜线"
	quest.0000000000012F6A.quest_desc: ["LV电容器可储存IE能量(IF)。开始建设你的电力基础设施。"]
	quest.0000000000012F6A.title: "LV电容器"
	quest.0000000000012FAE.quest_desc: ["IE 水磨坊可通过流动的水被动地生成 IF。"]
	quest.0000000000012FAE.title: "水车磨坊"
	quest.0000000000012FF2.quest_desc: [
		"IE 破碎机将矿石研磨成2倍粉尘产量。"
		"这是一个多方块结构——用锤子来建造它。"
	]
	quest.0000000000012FF2.title: "IE Crusher"
	quest.0000000000013036.quest_desc: ["电弧炉可批量熔炼合金和矿石。中后期的重大升级。"]
	quest.0000000000013036.title: "电弧熔炉"
	quest.000000000001307A.quest_desc: ["使用IE金属压块多区块将锭和板压制成齿轮、杆和线。"]
	quest.000000000001307A.title: "金属压制机"
	quest.00000000000130BE.quest_desc: ["利用温差发电。置于熔岩和冰/水之间可被动发电。"]
	quest.00000000000130BE.title: "热电发电机"
	quest.0000000000013102.quest_desc: ["升级到MV导线以实现更高吞吐量的电力传输。"]
	quest.0000000000013102.title: "MV 布线系统"
	quest.0000000000013146.quest_desc: ["巨大的挖掘机多区块结构会被动挖掘巨大的矿脉。"]
	quest.0000000000013146.title: "挖掘机"
	quest.000000000001318A.quest_desc: ["IE合成器会根据存储的配方，通过管道输入自动合成物品。"]
	quest.000000000001318A.title: "Assembler"
	quest.00000000000131CE.quest_desc: ["用工业工程传送带在工厂里搬运物品。"]
	quest.00000000000131CE.title: "传送带系统 (Conveyor Belts)"
	quest.0000000000013212.quest_desc: ["花园罩子利用水和肥料，在一个方块内自动化作物生长。"]
	quest.0000000000013212.title: "花园玻璃罩"
	quest.0000000000013245.quest_desc: ["使用存储的配方自动合成物品。比合成器更便宜的替代方案。"]
	quest.0000000000013245.title: "自动工作台"
	quest.0000000000013289.quest_desc: ["建造一个大型风车多方块结构，以获得稳定的被动IF来源。"]
	quest.0000000000013289.title: "风车"
	quest.00000000000132BC.quest_desc: ["柴油发电机燃烧生物柴油以获得极高的IF输出。"]
	quest.00000000000132BC.title: "柴油发电机"
	quest.00000000000132EF.quest_desc: ["精炼厂用植物油和乙醇生产生物柴油。为你的柴油发电机加油。"]
	quest.00000000000132EF.title: "精炼厂"
	quest.0000000000013333.quest_desc: ["一种火焰喷射器风格的武器。向敌人喷洒液体，造成毁灭性效果。"]
	quest.0000000000013333.title: "化学投掷器"
	quest.0000000000013377.quest_desc: ["一种以惊人速度发射金属尖刺的高科技武器。"]
	quest.0000000000013377.title: "轨道炮"
	quest.00000000000133CC.quest_desc: ["工厂可以自行运作。挖掘机负责采矿，装配器负责制造，传送带负责运输。"]
	quest.00000000000133CC.title: "工业革命"
	quest.0000000000013421.quest_desc: [
		"LaserIO 节点可在任意两个方块之间无线传输物品、流体和能量。"
		"没有管道，没有电缆——只有激光。"
	]
	quest.0000000000013421.title: "LaserIO 基础篇"
	quest.0000000000013465.quest_desc: ["激光流体节点可无线传输液体。非常适合Mekanism和Create的流体系统。"]
	quest.0000000000013465.title: "流体激光器"
	quest.00000000000134A9.quest_desc: ["使用能量激光节点在发电机和机器之间无线传输RF。"]
	quest.00000000000134A9.title: "能量激光枪"
	quest.00000000000134ED.quest_desc: ["Pipez 提供简单、廉价的物品/流体/能量/气体管道，方便快速连接。"]
	quest.00000000000134ED.title: "管道匠模组"
	quest.0000000000013531.quest_desc: [
		"XNet 是一个强大的基于线缆的物品/流体/能量路由系统。"
		"在控制器上编写程序，创建复杂的自动化逻辑。"
	]
	quest.0000000000013531.title: "XNet 控制器"
	quest.0000000000013564.quest_desc: [
		"KubeJS 让你能修改配方、添加自定义物品，并创建模组包专属机制。"
		"查看kubejs/文件夹中的KubeJS脚本来了解此整合包新增的内容。"
	]
	quest.0000000000013564.title: "KubeJS 整合包"
	quest.00000000000135A8.quest_desc: ["使用无线合成终端，随时随地访问你的AE2网络并合成物品。"]
	quest.00000000000135A8.title: "无线合成终端"
	quest.00000000000135EC.quest_desc: [
		"Compact Machines 在一个方块内创建了巨大的合成空间。"
		"在网格中用 1x1 的占地面积建造完整的工厂。"
	]
	quest.00000000000135EC.title: "紧凑型机器模组 (Compact Machines)"
	quest.0000000000013630.quest_desc: ["维度碎片是 RFTools 的核心合成材料。收集它们以实现高级自动化。"]
	quest.0000000000013630.title: "RFTools 碎片"
	quest.0000000000013674.quest_desc: ["存储扫描仪会索引你的存储系统，以实现高级物品查询和路由。"]
	quest.0000000000013674.title: "RFTools 存储扫描仪"
	quest.00000000000136B8.quest_desc: [
		"RFTools 建造者可以构建形状、挖掘区域和传送装置。"
		"非常适合在网格中扩建安全平台。"
	]
	quest.00000000000136B8.title: "RFTools Builder"
	quest.00000000000136FC.quest_desc: ["RFTools 合成台可同时自动化多达 8 个合成配方。"]
	quest.00000000000136FC.title: "RFTools Crafter"
	quest.0000000000013740.quest_desc: ["使用 RFTools Control 处理器编写复杂的自动化逻辑。"]
	quest.0000000000013740.title: "RFTools 控制处理器"
	quest.0000000000013784.quest_desc: ["Ex Compressum 自动压缩机可自动批量压缩物品。"]
	quest.0000000000013784.title: "Ex Compressum"
	quest.00000000000137C8.quest_desc: ["使用 Ex Compressum 自动筛网，自动化你的 Ex Deorum 筛选工作。"]
	quest.00000000000137C8.title: "自动筛分机"
	quest.000000000001380C.quest_desc: [
		"Industrial Foregoing 的石材工厂可自动生产石头、鹅卵石、砾石、沙子和粉尘。"
		"单个机器提供无限筛分输入。"
	]
	quest.000000000001380C.title: "Stoneworks 工厂"
	quest.0000000000013850.quest_desc: ["在可配置区域内自动收割作物。"]
	quest.0000000000013850.title: "植物采集者"
	quest.0000000000013894.quest_desc: ["在自动化刷怪塔中，通过粉碎怪物来获取掉落物和经验。"]
	quest.0000000000013894.title: "生物破碎机"
	quest.00000000000138D8.quest_desc: ["IF激光钻使用RF被动地从基岩层开采矿石。"]
	quest.00000000000138D8.title: "激光钻头"
	quest.000000000001393E.quest_desc: ["你的整个基地网络会自动运行。每个系统都为其他系统提供动力。"]
	quest.000000000001393E.title: "自动化天空 The Automated Sky"
	quest.0000000000013993.quest_desc: [
		"Yellorium 是极端反应堆的燃料。"
		"用筛子收集粉尘，或通过你的采矿系统获取。"
	]
	quest.0000000000013993.title: "Yellorium：反应堆燃料"
	quest.00000000000139D7.quest_desc: ["使用反应堆外壳方块建造你的极端反应堆的外壳。"]
	quest.00000000000139D7.title: "反应堆外壳"
	quest.0000000000013A1B.quest_desc: [
		"建造一个完整的 Extreme Reactor 多方块结构。"
		"一个3x3x3的内部空间，包含燃料棒、控制器和访问端口。"
	]
	quest.0000000000013A1B.title: "反应堆在线"
	quest.0000000000013A5F.quest_desc: ["添加燃料棒以提高反应堆的能源输出。"]
	quest.0000000000013A5F.title: "更多电力"
	quest.0000000000013A92.quest_desc: ["用极端反应堆涡轮机将反应堆的蒸汽输出转化为更多的RF。"]
	quest.0000000000013A92.title: "蒸汽涡轮机"
	quest.0000000000013AD6.quest_desc: ["使用 RFTools Builder 用开采的材料扩建你的电网基地。"]
	quest.0000000000013AD6.title: "网格扩展"
	quest.0000000000013B1A.quest_desc: ["高级 RFTools 能量电池可为你的终局系统储存大量 RF。"]
	quest.0000000000013B1A.title: "RFTools 能量电池"
	quest.0000000000013B5E.quest_desc: ["用下界合金废料和黄金锻造下界合金锭。原版进阶的巅峰。"]
	quest.0000000000013B5E.title: "下界合金时代"
	quest.0000000000013BA2.quest_desc: ["下界合金工具是游戏中最好的——耐用、快速，而且防火。"]
	quest.0000000000013BA2.title: "下界合金工具"
	quest.0000000000013BE6.quest_desc: ["全套下界合金盔甲防火，并提供最高的基础防护值。"]
	quest.0000000000013BE6.title: "下界合金盔甲"
	quest.0000000000013C19.quest_desc: [
		"Apotheosis 重做了附魔系统。"
		"使用重铸台和宝石镶嵌，将你的装备发挥到极致。"
	]
	quest.0000000000013C19.title: "Apotheosis 附魔台"
	quest.0000000000013C4C.quest_desc: ["Apothic Enchanting 的灌注祭坛能施加超越常规极限的强大附魔。"]
	quest.0000000000013C4C.title: "灌注祭坛"
	quest.0000000000013C90.quest_desc: ["用下界之星和玻璃建造信标。将其放置在金字塔上可获得强大的永久增益。"]
	quest.0000000000013C90.title: "信标"
	quest.0000000000013CD4.quest_desc: ["击败凋零以获取一颗下界之星。你需要强大的装备和一个安全的竞技场。"]
	quest.0000000000013CD4.title: "凋零已被击败"
	quest.0000000000013D18.quest_desc: [
		"&6获得一枚末地蛋&r。此任务检查物品，而非击杀末影龙。以下任一途径均可获得；后期玩家无需从共享的末地中领取第一枚末地蛋。"
		"&bMekanism: 先进技术&r"
		"使用反质子核合成器：1个普通鸡蛋 + 4mB反物质 = 1个龙蛋。机器也需要能量。反物质在超临界相移器（SPS）中生产，而非核合成器中。完整机器和燃料进阶请查看JEI。"
		"&aMystical Agriculture / Agradditions: 农业&r"
		"击败末影龙后收集龙鳞。此整合包设定为每次击杀掉落8个鳞片：4个用于龙蛋种子，4个用于龙蛋核心。在掉落物消失前收集。还需要Insanium级别的合成材料，请查看JEI。"
		"在 Insanium 农田上种植龙蛋种子，农田正下方放置一个龙蛋核心。收获龙蛋精华。用 9 个精华合成 1 个龙蛋块，再用 3 个块合成 1 个龙蛋：共需 27 个精华。此方法无需原始龙蛋。"
		"&dForestry + Magic Bees：繁殖&r"
		"用黄金网筛土获得好奇蜂巢。用1个好奇蜂巢、4个深板岩砖、2个紫水晶碎片和2个金锭制作深蜂巢。放置后用林业铲收集，可获得蜜蜂，包括调谐蜜蜂。蜂巢掉落保留原有的随机性。"
		"使用1个深巢、4个末地石、2个紫颂果和2个末影珍珠制作一个遗忘蜂巢。在末地放置并收集以获取遗忘蜜蜂。这些配方在现有世界中有效，无需新区块。它们使用末地材料，而非严格的成就解锁机制。"
		"蛋分支首先需要Ethereal和Imperial蜜蜂。繁殖Ethereal + Oblivion得到Nameless（基础概率10%），再繁殖Oblivion + Nameless得到Abandoned（8%）。在末地群系中繁殖Imperial + Abandoned得到Draconic（6%）。使用JEI查看前面的繁殖树，并为每种蜜蜂提供合适的工作条件。"
		"Draconic bees 产出 Dragon Dust。用 6 个 dust 合成 1 个 Dragon Chunk。蛋的配方需要 8 个 chunk（共 48 个 dust）和约 1 个 Essence of False Life。这些 Magic Bees 物品与 Mystical Agradditions 的 chunk 是分开的。"
		"要获得虚假生命精华，繁殖以太+调谐可获得感知（10%）。用感知与调谐或以太繁殖可获得精神（8%）。当条件满足时，精神蜜蜂可专门提供灵魂梳。将灵魂梳离心成灵魂蜡，然后用4灵魂蜡+4玻璃+1罂粟合成虚假生命精华。"
		"&7在耗尽最后一个蜂巢前，持续繁殖公主和工蜂。突变百分比为基础概率，非保证结果。所有三条路线均保留原版模组的产出要求。&r"
	]
	quest.0000000000013D18.title: "龙之蛋：三条道路"
	quest.0000000000013D5C.quest_desc: ["鞘翅能赋予你真正的飞行能力。与火箭结合，即可在虚空中获得无限速度。"]
	quest.0000000000013D5C.title: "自由之翼 Wings of Freedom"
	quest.0000000000013D8F.quest_desc: ["将传奇宝石镶嵌到你的装备上，以获得绝对最佳的属性。"]
	quest.0000000000013D8F.title: "传奇装备"
	quest.0000000000013DD3.quest_desc: ["你的反应堆和涡轮机产生的RF，比你基地里所有东西的消耗总和还要多。"]
	quest.0000000000013DD3.title: "无限力量"
	quest.0000000000013E28.quest_desc: ["你的AE2网络自动合成一切，感应矩阵存储一切，灵魂则负责挖掘其余。"]
	quest.0000000000013E28.title: "全自动自动化系统"
	quest.0000000000013EB0.quest_desc: ["你从一个被无尽方块矩阵环绕的小平台开始。\n\n你建造了重塑物质的机器，将魔法融入钢铁，驾驭了恒星的力量，并锻造出了前所未有的东西。\n\n这正是你此行的目的。\n\n天空从来都不是极限——而是开端。"]
	quest.0000000000013EB0.quest_subtitle: "天空从来都不是极限所在。"
	quest.0000000000013EB0.title: "飞升（Ascension）"
	quest.0000000000014010.quest_desc: [
		"这个世界是一个晶格。每隔四个空间放置一个方块，向各个方向延伸，漂浮于虚无之中。"
		""
		"没有地面，没有地平线。你需要的一切都在那里，相隔四格，而唯一能到达的方法就是建造。"
		""
		"&e虚空会将你送回共享的末地平台，但你原本要前往的地方依然遥不可及。&r小心搭桥，边缘处保持蹲姿，切勿垂直向下挖掘。"
	]
	quest.0000000000014010.title: "这是什么地方？"
	quest.0000000000014020.quest_desc: [
		"方块并非随机散落。每个方块都位于能被四整除的坐标上，因此整个世界是一个规则的三维晶格。"
		""
		"这点值得了解：一旦找到有用的东西，相邻的方块就在六个方向上，正好相隔四格。沿一个轴挖掘通道，比四处游荡能覆盖的范围大得多。"
		""
		"&7矿石有时会生成小簇，而不是单个方块。如果发现一个，就检查它周围吧。&r"
	]
	quest.0000000000014020.title: "阅读网格信息"
	quest.0000000000014030.quest_desc: [
		"&e这个世界没有水。&r也没有岩浆。两者都刻意被排除在方块池之外，因为漂浮的水源会永远向下流动，淹没其下方的所有东西。"
		""
		"&b冰是恢复水源的方法。&r 冰会遍布整个网格。当冰块放置在固体方块上时，将其破坏即可将其变为水源。"
		""
		"早点做。水闸农场、鹅卵石发电机、创造水轮，还有大部分机械动力内容。"
	]
	quest.0000000000014030.title: "冰中取水"
	quest.0000000000014040.quest_desc: [
		"方块池不是固定的。你可以更改生成的内容。"
		""
		"&e/skygridgui&r 打开编辑器，其中包含按维度分类的可搜索注册方块列表，每个方块都有权重。权重越高表示越常见。"
		""
		"你也可以直接使用命令："
		"&7/skygrid add <block> [weight]&r"
		"&7/skygrid remove <block>&r"
		"&7/skygrid tag add <tag>&r - 一次性添加整个方块标签"
		""
		"&c更改仅影响新生成的区块。&r已存在的地形永远不会改变，所以要向外探索或创建新世界才能看到差异。"
	]
	quest.0000000000014040.title: "自定义世界生成方式"
	quest.0000000000014050.quest_desc: [
		"两个对角相邻的水源会永久地填满它们之间的空间。"
		""
		"一旦拥有，水就不再是资源，而是基础设施。在需要前就把它建进基地里。"
	]
	quest.0000000000014050.title: "一个无限源泉"
	quest.0000000000014060.quest_desc: [
		"下界也是一个天空网格，拥有自己的方块池。"
		""
		"预计会生成下界岩、玄武岩、黑石、灵魂沙、泥岩和下界木，还有石英和下界金矿石。刷怪笼里的生物都适合下界，宝箱里则是堡垒和堡垒遗迹的战利品。"
		""
		"&c那里也没有岩浆。&r 找岩浆湖的常规方法不适用。自己带岩浆，或用坩埚制作。"
		""
		"&7主世界的矿石不会生成在下界池中，所以这是一次为下界特有材料而进行的旅行，而非捷径。&r"
	]
	quest.0000000000014060.title: "下界网格 (The Nether Grid)"
	quest.0000000000014070.quest_desc: [
		"远古残骸会生成在下界池中，但非常罕见。"
		""
		"筛选通常是获取下界合金的快捷方式。而这条则是风景优美的路线。"
	]
	quest.0000000000014070.title: "黑暗中的残骸"
	quest.0000000000014080.quest_desc: [
		"末地是三维度中最稀疏的。末地石、紫晶、黑曜石和紫颂花——除此之外别无他物。"
		""
		"它的宝箱使用末地城市的战利品，所以可能会有鞘翅和潜贝壳，而它的刷怪器则主要刷末影人。"
		""
		"&7刻意营造的荒凉感。外面没什么东西，能找到的也需要付出真正的努力才能抵达。&r"
	]
	quest.0000000000014080.title: "末地网格"
	quest.0000000000014090.quest_desc: [
		"紫颂植物是末地池可再生资源——食物，如果你够胆，还能用来传送。"
		""
		"访问完所有三个网格，你就已经见证了世界生成的一切。此后的所有内容都取决于你的创造。"
	]
	quest.0000000000014090.title: "Chorus 与 前进"
	quest.00000000000140A0.quest_desc: [
		"权重是按方块计算的，不是按标签计算的。"
		""
		"像 &e#c:ores&r 这样的通用标签会展开为整合包中所有匹配的矿石。添加或更新模组会悄悄改变该列表，并且即使是权重 1 也会为每个解析后的方块单独应用。"
		""
		"&7因此默认池使用明确的日志和矿石。如果你添加了标签，请在重载后检查日志：它会显示该标签解析为多少个方块，这个数字值得你进行调整。&r"
	]
	quest.00000000000140A0.title: "调整水池的设定"
	quest.00000000000140B0.quest_desc: [
		"默认池只是一个起点，而非一成不变的规则。"
		""
		"想挑战更高难度？移除铁和铜，让筛子带你飞。想建造？加入默认列表遗漏的装饰方块。想要经典体验？&e/skygrid add minecraft:water&r 和 &e/skygrid add minecraft:lava&r，并接受随之而来的洪水。"
		""
		"每个世界都可以有不同的形状。"
	]
	quest.00000000000140B0.title: "让它成为你的专属物品"
	quest.0000000000015001.quest_desc: [
		"&6Sky Coins&r 是这里的货币，下面每个列表都可以无限次使用。"
		""
		"&e最上面一行可以出售多余的物品。&r这个网格产生的圆石、泥土和砾石远超所需。交上来就能变成钱币。"
		""
		"&e下面的一切都会出售给你那些方块吝啬提供的东西&r - 树苗、种子和冰块。"
		""
		"&7这里出售的物品不会跳过游戏进程。货架上没有矿石、锭或机器。邮局存在的意义是修正厄运，而非让你跳过劳作。&r"
	]
	quest.0000000000015001.title: "贸易站"
	quest.0000000000015003.quest_desc: ["该网格产量最丰富的物品。不值多少钱，但总有点用。用256个方块（四组）换取一枚天空币。"]
	quest.0000000000015003.title: "出售：普通砖块（Cobblestone）"
	quest.0000000000015006.quest_desc: ["每个人最后都会得到用不完的泥土。草、粗土和泥都算。用256个方块（四组）换一个天空币。"]
	quest.0000000000015006.title: "出售：泥土"
	quest.0000000000015009.quest_desc: ["如果需要燧石，先筛选出来。邮寄的报酬都一样。用256个方块（四组）换一个天空币。"]
	quest.0000000000015009.title: "出售：砾石"
	quest.000000000001500C.quest_desc: ["玻璃很有用。多余的沙子则不然。红沙也算。用256个方块（四组）换一个天空币。"]
	quest.000000000001500C.title: "出售：沙子"
	quest.000000000001500F.quest_desc: ["证明你完成了这次旅行。驿站不挑剔来源。用256个方块（四组）换取一枚天空币。"]
	quest.000000000001500F.title: "出售：下界岩"
	quest.0000000000015012.quest_desc: ["收集燧石需要付出努力，所以它的回报比它来源的砾石更高。"]
	quest.0000000000015012.title: "出售：燧石（Flint）"
	quest.0000000000015015.quest_desc: ["可靠的伙伴。速度快，可预测，苹果。"]
	quest.0000000000015015.title: "购买：橡木树苗"
	quest.0000000000015018.quest_desc: ["生长笔直且短。适合层高较低的地方。"]
	quest.0000000000015018.title: "购买：桦树苗 (Birch Saplings)"
	quest.000000000001501B.quest_desc: ["将四棵树呈正方形种植，即可得到一棵巨型云杉。"]
	quest.000000000001501B.title: "购买：云杉树苗 (Spruce Saplings)"
	quest.000000000001501E.quest_desc: ["可可豆的唯一可靠获取途径。"]
	quest.000000000001501E.title: "购买：丛林树苗"
	quest.0000000000015021.quest_desc: ["横向生长，拒绝讲道理。"]
	quest.0000000000015021.title: "购买：金合欢树苗"
	quest.0000000000015024.quest_desc: ["需要四个呈正方形种植。否则无事发生。"]
	quest.0000000000015024.title: "购买：深色橡木树苗"
	quest.0000000000015027.quest_desc: ["主要是为了外观和花瓣的缘故。"]
	quest.0000000000015027.title: "购买：樱花树苗 (Cherry Saplings)"
	quest.000000000001502A.quest_desc: ["当你急需木材而无法等待树苗生长时使用。与购买树苗相比，性价比极低。"]
	quest.000000000001502A.title: "购买：橡木原木"
	quest.000000000001502D.quest_desc: ["游戏中生长最快的方块。脚手架、燃料，最后是木板。"]
	quest.000000000001502D.title: "购买：竹子"
	quest.0000000000015030.quest_desc: ["面包、干草捆，还有用来繁殖动物的东西。"]
	quest.0000000000015030.title: "购买：小麦种子"
	quest.0000000000015033.quest_desc: ["不好看，但好歹是食物，还有红色染料。"]
	quest.0000000000015033.title: "购买：甜菜根种子"
	quest.0000000000015036.quest_desc: ["一旦开始生长，一个茎就能无限为你提供食物。"]
	quest.0000000000015036.title: "购买：甜瓜种子"
	quest.0000000000015039.quest_desc: ["金胡萝卜不太实用的表亲，但对某些配方必不可少。"]
	quest.0000000000015039.title: "购买：南瓜种子"
	quest.000000000001503C.quest_desc: ["种三棵，吃第四棵。或者一颗也别吃，把四棵都种下。"]
	quest.000000000001503C.title: "购买：胡萝卜"
	quest.000000000001503F.quest_desc: ["早期能种植的卡路里密度最高的东西。"]
	quest.000000000001503F.title: "购买：马铃薯"
	quest.0000000000015042.quest_desc: ["需要沙子或泥土旁边的水源。纸、书，最后是附魔。"]
	quest.0000000000015042.title: "购买：甘蔗 (Sugar Cane)"
	quest.0000000000015045.quest_desc: ["酿造由此开始，在没有堡垒的情况下，哨塔是唯一可靠的补给来源。"]
	quest.0000000000015045.title: "购买：下界疣"
	quest.0000000000015048.quest_desc: ["棕色染料和饼干。种植在丛林原木上。"]
	quest.0000000000015048.title: "购买：可可豆"
	quest.000000000001504B.quest_desc: ["跳过等待。刷怪器最终会解决这个问题。"]
	quest.000000000001504B.title: "购买：骨粉 (Bone Meal)"
	quest.000000000001504E.quest_desc: ["&b固态的水。&r打破放置在固体方块上的方块，它会融化成水源。这里最实用的商品。"]
	quest.000000000001504E.title: "购买：冰块"
	quest.0000000000015051.quest_desc: ["不会融化，也不会变成水。适用于建筑和需要快速铺设的地板。"]
	quest.0000000000015051.title: "购买：压缩冰 (Packed Ice)"
	quest.0000000000015054.quest_desc: ["游戏中最滑的方块。价格昂贵，但为建造船道而物超所值。"]
	quest.0000000000015054.title: "购买：蓝色冰块"
	quest.0000000000015057.quest_desc: ["羊毛、床、鱼竿，还有给急性子用的脚手架。"]
	quest.0000000000015057.title: "购买：线 (String)"
	quest.000000000001505A.quest_desc: ["书、盔甲、物品展示框。在没有刷怪塔之前，收集这些很麻烦。"]
	quest.000000000001505A.title: "购买：皮革"
	quest.000000000001505D.quest_desc: ["砖块，更重要的是，通往多个模组链的路线。"]
	quest.000000000001505D.title: "购买：粘土"
	quest.0000000000015060.quest_desc: ["粘性活塞和史莱姆块，无需等待你没有的史莱姆区块。"]
	quest.0000000000015060.title: "购买：史莱姆 (Slime)"
	quest.0000000000015070.quest_desc: ["深板岩是方块中最常见的第二种。开采后就会变成这个样子。"]
	quest.0000000000015070.title: "出售：原矿深板岩砖块"
	quest.0000000000015073.quest_desc: ["创造安山岩。邮政会拿走创造不需要的东西。"]
	quest.0000000000015073.title: "出售：安山岩"
	quest.0000000000015076.quest_desc: ["从来没有人需要过这么多的岩质砖块。"]
	quest.0000000000015076.title: "出售：正岩（Diorite）"
	quest.0000000000015079.quest_desc: ["花岗岩、闪长岩和安山岩组成的网格产生的装饰性石材比鹅卵石多。"]
	quest.0000000000015079.title: "出售：花岗岩"
	quest.000000000001507C.quest_desc: ["比其他物品少见，但依然会堆积如山。"]
	quest.000000000001507C.title: "出售：Tuff（一种方块）"
	quest.000000000001507F.quest_desc: ["下界的标准配置，也是你曾到访过的证据。"]
	quest.000000000001507F.title: "出售：黑石"
	quest.0000000000015082.quest_desc: ["&7末地里的东西有一半都是末地石。&r 如果你去过那里，那你肯定有很多这个。"]
	quest.0000000000015082.title: "出售：末地石"
	quest.0000000000015100.quest_desc: [
		"&eMekanism的冶金注入器没有这些中的一个就无法合成。&r 这是有意为之的。"
		""
		"锻造核心需要&6安山合金&r、&6黄铜锭&r和&6沉浸式工程钢&r。忽略另外两个科技模组，是无法进入Mekanism的加工链的。"
		""
		"&7制作一次即可打开 Infuser。你之后会需要更多——Manaforged Alloy 需要消耗四个。&r"
	]
	quest.0000000000015100.title: "锻造核心 (The Forged Core)"
	quest.0000000000015110.quest_desc: [
		"第二道门，也是将 &dArs Nouveau&r 引入链条的那道门。"
		""
		"你刚建造的冶金注入器里的四个&6锻造核心&r、四个&d源宝石&r和一个&6注入合金&r。"
		""
		"&e这将解锁Mekanism的富集室及其矿石处理路线。&r其他模组有各自的处理方法，但这是进入Mekanism庞大生产链的入口。"
	]
	quest.0000000000015110.title: "Manaforged 合金"
	quest.005D3168BE4EBF8F.quest_desc: ["一台帮你种地的机器，这样你就不用站在最后一个泥土方块上了。种子用来保持它的诚实。"]
	quest.005D3168BE4EBF8F.title: "农业工作站"
	quest.00FD0D96C852E35C.quest_desc: ["苔藓哥利亚的撞击如同坠落的碎石。苔藓图腾是他们的道歉。"]
	quest.00FD0D96C852E35C.title: "苔和石头"
	quest.01244A3F8E659038.quest_desc: ["尖顶滴水石需要耐心，能产出熔岩和水。龙息则需要更少的耐心作为回报。"]
	quest.01244A3F8E659038.title: "滴水石锥"
	quest.0133AEA5858EC0DC.quest_desc: ["Silent Gear 的材料在未经鉴定前，其特性是不可见的。粗糙的棒材是不错的备用件。"]
	quest.0133AEA5858EC0DC.title: "材料分级器"
	quest.020FED1247E64BC9.quest_desc: ["蜘蛛会攀附在网格方块上。线可以做成床、弓，也可以给急躁的玩家搭脚手架。"]
	quest.020FED1247E64BC9.title: "弦理论 (String Theory)"
	quest.03B8F8FFF65F46A8.quest_desc: ["十六个书架。原版附魔台依然可用，酿造台也并非唯一选择。"]
	quest.03B8F8FFF65F46A8.title: "图书馆书堆"
	quest.0497B8009B1BDB64.quest_desc: ["通过 Silent Gear 获得四个青铜锭。下一个显而易见的部分是一个镐头。"]
	quest.0497B8009B1BDB64.title: "青铜锻造台"
	quest.062073D2CEB95356.quest_desc: ["生物群系仍然存在于噪声中。即使地形相隔四格，指南针也会指向它们。"]
	quest.062073D2CEB95356.title: "自然指南针"
	quest.075A9C05E7EFF7AB.quest_desc: ["樱花树苗主要是为了美观。想要外观又不想等待，就用粉色花瓣吧。"]
	quest.075A9C05E7EFF7AB.title: "樱花盛开之时"
	quest.091B88C7183CAE44.quest_desc: ["四株红树幼苗。竹子是它们生长期间更快的脚手架。"]
	quest.091B88C7183CAE44.title: "红树根 (Mangrove Roots)"
	quest.0FA84BADF22117E0.quest_desc: ["升级后的附魔器能实现基础附魔器无法实现的附魔。带上瓶子。"]
	quest.0FA84BADF22117E0.title: "高级合成器 (Advanced Infuser)"
	quest.14A8442A98EAD171.quest_desc: ["The Overgrown Colossus 是这份名单上的最后一个名字。The mossy hammer 是最后一个词。"]
	quest.14A8442A98EAD171.title: "巨像 (The Colossus)"
	quest.15BF8FAEBEF1B298.quest_desc: ["任何附魔书都可以。如果需要购买等级，就用瓶子。"]
	quest.15BF8FAEBEF1B298.title: "首次附魔 First Enchant"
	quest.169219F7B4B4EED7.quest_desc: ["仙人掌是染料、陷阱，也是证明网格中某处有沙漠的证据。一把刷子，用于你尚未完成的考古工作。"]
	quest.169219F7B4B4EED7.title: "沙漠的发现"
	quest.17D6801B50A6486F.quest_desc: ["凋零的怪物会让你永生难忘。如果你够勇敢，肋骨就是盔甲。"]
	quest.17D6801B50A6486F.title: "肋骨笼"
	quest.1A0CEC4AE8BDE43C.quest_desc: ["机器需要一个缓冲器。一个基础的电容器组是第一个不会让人尴尬的选择。"]
	quest.1A0CEC4AE8BDE43C.title: "电容器组"
	quest.1A40A696026615A3.quest_desc: ["传送到你正在注视的地方。烈焰金是 Silent Gear 的材料，你反正也会需要。"]
	quest.1A40A696026615A3.title: "旅行之杖 Staff of Travelling"
	quest.1F27C714800D7831.quest_desc: ["四本附魔书。钻石，这样下一件工具就值得用它们来附魔了。"]
	quest.1F27C714800D7831.title: "附魔图书馆"
	quest.217091C49CE2001A.quest_desc: ["末地故意设计得很空旷。杀死末影龙，拿走鞘翅，网格就会小很多。"]
	quest.217091C49CE2001A.title: "最后的飞行"
	quest.2481647E1D024624.quest_desc: ["末影人会瞬移。拿到珍珠后，你也会。搭桥时不要直视它们。"]
	quest.2481647E1D024624.title: "珍珠丰收"
	quest.29BF2866424513CE.quest_desc: ["本分支的终点BOSS。带上一个不涉及坠落的方法。Tesseract 是奖杯。"]
	quest.29BF2866424513CE.title: "湮灭者 (The Obliterator)"
	quest.2D6D0D3B312A6E3D.quest_desc: ["如果你不睡觉，幻影会找到你。在网格上，这很容易做到。烟花能帮你保持平衡。"]
	quest.2D6D0D3B312A6E3D.title: "夜班工作"
	quest.2E06972E7AB6BB71.quest_desc: ["Silent Gear 的晚期合金。两个锭，还有备用头颅，这样你才会真正用上它们。"]
	quest.2E06972E7AB6BB71.title: "泰瑞安钢"
	quest.32BA80CE990C4A04.quest_desc: ["掠夺者仍然会出现。没有村庄可以拯救。无论如何都带上绿宝石。"]
	quest.32BA80CE990C4A04.title: "袭击虚无之地"
	quest.338F15408D603324.quest_desc: ["用 Ender IO 的方式粉碎矿石。红石是维持运转的代价。"]
	quest.338F15408D603324.title: "SAG Mill"
	quest.33A638527CF2CD12.quest_desc: ["潜行者模仿者不是潜行者。盾牌仍然能按你的预期工作。"]
	quest.33A638527CF2CD12.title: "贝壳游戏"
	quest.374EAFBD222C92CA.quest_desc: ["领取此物品可获得一块§d贤者之石§r，即 ProjectE 的前门。此配方在本整合包中其他地方均不可用，这是唯一获取方式。"]
	quest.374EAFBD222C92CA.title: "炼金术的觉醒"
	quest.37BEF5F5CE2D6D27.quest_desc: ["一个远古守卫者。海洋之心是你获得信标的门票，前提是你能留住水。"]
	quest.37BEF5F5CE2D6D27.title: "网格的长者"
	quest.38C0C65A7DFCF6F4.quest_desc: ["放置两个，在它们之间行走。在天空网格上，这比你建造的任何桥梁都快。"]
	quest.38C0C65A7DFCF6F4.title: "旅行锚点"
	quest.3A67A768B7CB8A6E.quest_desc: ["附魔注入器像桌子一样消耗经验，无需书架舞蹈。书本仍然有用。"]
	quest.3A67A768B7CB8A6E.title: "附魔的灌注（Infused Enchanting）"
	quest.3AB535F158684848.quest_desc: ["将Silent Gear工具分解回零件。铁是用来弥补你犯错的方式。"]
	quest.3AB535F158684848.title: "拾荒者"
	quest.3C6620A725ED7AA6.quest_desc: ["岩浆食者生活在你不该去的地方。它们的皮肤才是有用的部分。"]
	quest.3C6620A725ED7AA6.title: "厚皮生物"
	quest.3D9CE7B90BE7A6E6.quest_desc: ["Skeletosaurus 是由刷怪器最糟糕的想法组成的恐龙。保留骨头。"]
	quest.3D9CE7B90BE7A6E6.title: "骨龄时代"
	quest.3DD484616C338A67.quest_desc: ["五个伏击者。他们掉落的碎片才是有用的部分。"]
	quest.3DD484616C338A67.title: "伏击"
	quest.3F631F60DCFA6906.quest_desc: ["卫道士在架桥战斗中会带上斧头。不要给他们最后一个方块。"]
	quest.3F631F60DCFA6906.title: "砍伐台 (Chopping Block)"
	quest.3FE46CF07632B704.quest_desc: ["骷髅在每一个浮空方块上都占据高地。带上盾牌，离开时带上弓箭。"]
	quest.3FE46CF07632B704.title: "骨头收集者"
	quest.3FF934A24D0D35A1.quest_desc: ["八本附魔书。一个下界合金锭提示着要将它们放在能持久的物品上。"]
	quest.3FF934A24D0D35A1.title: "大师级附魔师"
	quest.40F72974E221E45B.quest_desc: ["让 Ender IO 机器不再客气的电容器。Soularium 也一同加入。"]
	quest.40F72974E221E45B.title: "八进制电容器"
	quest.42D921DE31B4CDFE.quest_desc: ["在能战斗又不掉下去的地方建造骷髅。图腾是留给下一个失误的。"]
	quest.42D921DE31B4CDFE.title: "凋零者"
	quest.4477EE8BE47914D6.quest_desc: ["燃烧灵魂获取力量。天气水晶是稀有的 Ender IO 附加组件。"]
	quest.4477EE8BE47914D6.title: "灵魂引擎"
	quest.449BD1390257EA37.quest_desc: ["卫道士本不该在格子上被击败。若你坚持，回声碎片便是凭证。"]
	quest.449BD1390257EA37.title: "不要发出任何声音"
	quest.4505956BE7DBE6F1.quest_desc: ["恶魂会漂浮。这里的一切都会漂浮。用火球应对是最礼貌的做法。"]
	quest.4505956BE7DBE6F1.title: "虚空中的尖叫"
	quest.47713991B9516861.quest_desc: ["移除一个不好的附魔，保留物品。绿宝石是惨痛教训的代价。"]
	quest.47713991B9516861.title: "砂轮 Grindstone"
	quest.48C9073900FE8C0C.quest_desc: ["蔚蓝电金是蔚蓝银的升级版。涂层模板能让你用它来镀层工具。"]
	quest.48C9073900FE8C0C.title: "蔚蓝电金"
	quest.4B0D2E6C8A1F3E9D.quest_desc: ["被诅咒的骑士比普通守卫更强力。又收集到一个失活的召唤者。"]
	quest.4B0D2E6C8A1F3E9D.title: "堕落骑士团"
	quest.4C0D9BB0DBBD4CBD.quest_desc: ["两个蔚蓝银锭。八个同种金属的碎片将作为找零返还。"]
	quest.4C0D9BB0DBBD4CBD.title: "蔚蓝银"
	quest.4C322E99EF0F04E7.quest_desc: ["四块鲜艳的合金锭。这些金块可用于下一次制作。"]
	quest.4C322E99EF0F04E7.title: "活力合金"
	quest.4D4D2A1B5CF2C658.quest_desc: ["凋零骷髅会掉落骷髅头和煤炭。废料是迈向下界合金的一步。"]
	quest.4D4D2A1B5CF2C658.title: "头骨与废料"
	quest.4E57B07FFD5A76EB.quest_desc: ["劫掠兽在四格间距下转向不佳。两格就足够了。鞍子只是个笑话，你以后可以用。"]
	quest.4E57B07FFD5A76EB.title: "势不可挡"
	quest.4F0E57C110000001.quest_desc: [
		"Vanilla SkyGrid 不会生成 Forestry 蜂巢。一勺子和一把蜂蜡是起点。"
		"&e用铁丝网筛泥土&r，可获得蜂巢和额外蜂巢。领取此任务以获取工具，无需等待羊毛。"
	]
	quest.4F0E57C110000001.title: "外面没有蜜蜂了"
	quest.4F0E57C110000002.quest_desc: ["羊毛和木棍。用这个打破蜂巢，而不是镐。奖励里的森林蜂巢是网格不会为你生成的那种。"]
	quest.4F0E57C110000002.title: "一勺到底"
	quest.4F0E57C110000003.quest_desc: ["把它放在固体方块上然后舀起。如果想之后获得第二个物种，筛子中的泥土会产出更多蜂巢。"]
	quest.4F0E57C110000003.title: "森林蜂巢"
	quest.4F0E57C110000004.quest_desc: ["一位公主和一架无人机。这就是一个殖民地。未经处理的框架暗示着他们下一个居住的地方。"]
	quest.4F0E57C110000004.title: "公主与无人机"
	quest.4F0E57C110000005.quest_desc: ["木板、半砖，中间放个梳子。虽然慢，但在有木匠之前能用。"]
	quest.4F0E57C110000005.title: "蜜蜂小屋"
	quest.4F0E57C110000006.quest_desc: ["十六个蜂巢。房子慢，没耐心的话用筛子更快。要是真吃这活，就用蜂蜜切片。"]
	quest.4F0E57C110000006.title: "首次丰收"
	quest.4F0E57C110000007.quest_desc: ["蜂巢会在这里变成蜡和蜂蜜。在被未加工的蜂巢淹没前，先把它建起来吧。"]
	quest.4F0E57C110000007.title: "离心机"
	quest.4F0E57C110000008.quest_desc: ["八块蜂蜡。这是蜡烛、外壳和这一排末尾的硬币交易。"]
	quest.4F0E57C110000008.title: "蜂蜡"
	quest.4F0E57C110000009.quest_desc: ["浸过种子油的物品在Forestry的工作台上使用。坚固的外壳可用于下一次制作。"]
	quest.4F0E57C110000009.title: "木匠"
	quest.4F0E57C11000000A.quest_desc: ["木匠的第一个真正产出。蜂箱就是用木板围着这个做的。"]
	quest.4F0E57C11000000A.title: "浸渍外壳 (Impregnated Casing)"
	quest.4F0E57C11000000B.quest_desc: ["比蜂巢还快，而且需要蜂框。已授粉的蜂框并非装饰品。"]
	quest.4F0E57C11000000B.title: "Apiary"
	quest.4F0E57C11000000C.quest_desc: ["四个蜂箱方块。完整箱子是3x3x3，顶部有半砖。如果你真的建完墙壁，就能得到蜂王浆。"]
	quest.4F0E57C11000000C.title: "Alveary"
	quest.4F0E57C11000000D.quest_desc: ["八块泥炭。沼泽土会干燥成这个，如果你不想等，用金网土筛可以找到一些。"]
	quest.4F0E57C11000000D.title: "泥炭地"
	quest.4F0E57C11000000E.quest_desc: ["铜、玻璃、活塞和泥炭。升级燃料后，沥青泥炭燃烧时间更长。"]
	quest.4F0E57C11000000E.title: "泥炭引擎"
	quest.4F0E57C11000000F.quest_desc: ["四个砖块农场方块。Forestry Farms需要一个3x4x3或更大的多方块结构。用于第一批作物的肥料。"]
	quest.4F0E57C11000000F.title: "农场方块"
	quest.4F0E57C110000010.quest_desc: ["砖块上的锡齿轮。这是农场的动力面。天空币，因为一个能正常工作的农场才是重点。"]
	quest.4F0E57C110000010.title: "农场齿轮箱"
	quest.4F0E57C110000011.quest_desc: ["十六个蜂蜡。如果你有超过能装下的数量，网格会将其视为钱币。"]
	quest.4F0E57C110000011.title: "蜡制标准旗帜"
	quest.4F0E57C110000012.quest_desc: ["一个天空币换三十二个蜂巢，不限次数。盈余才是我们的宗旨。"]
	quest.4F0E57C110000012.title: "组合交换台"
	quest.4F0E57C110000013.quest_desc: ["Forestry 树木是一个物品——带基因组的树苗，而非每种树单独 ID。合成嫁接器（青铜和木棍）。琥珀化石离心后会变成真正的树苗。"]
	quest.4F0E57C110000013.title: "嫁接者"
	quest.4F0E57C110000014.quest_desc: ["如果你还留着，就用魔法蜜蜂。简而言之，在蜂箱里放个魔法蜂巢。如果你已经有蜂巢，就用普通蜂巢。"]
	quest.4F0E57C110000014.title: "魔法框架"
	quest.4F0E57C110000015.quest_desc: ["Modular Bees 将蜂巢变成机器。核心是第一块方块。蜂蜜果冻是零食。"]
	quest.4F0E57C110000015.title: "模块化蜂巢"
	quest.4F0E57C110000016.quest_desc: ["一只蝴蝶。它们也不生活在格子上。其余的都在鳞翅目昆虫学家的箱子里。"]
	quest.4F0E57C110000016.title: "蝴蝶们"
	quest.4F0E57C110000017.quest_desc: ["Binnie's Extra Bees 添加了蜂箱玩具。突变器是人们实际建造的。用于住所的备用蜂巢框架。"]
	quest.4F0E57C110000017.title: "Binnie's Alveary"
	quest.4F0E57C110000018.quest_desc: ["锡、玻璃和坚固的外壳。种子进去，籽油出来。罐子是Forestry移动液体的方式。"]
	quest.4F0E57C110000018.title: "榨汁机"
	quest.4F0E57C110000019.quest_desc: ["另一种外壳上的青铜齿轮。小麦、树苗或仙人掌会变成生物质。木屑是榨汁机已经制作好的剩余物。"]
	quest.4F0E57C110000019.title: "发酵器"
	quest.4F0E57C11000001A.quest_desc: ["外壳周围的红石和玻璃。生物质输入，乙醇输出。这就是燃料线。"]
	quest.4F0E57C11000001A.title: "仍然"
	quest.4F0E57C11000001B.quest_desc: ["黄金、玻璃、一个箱子和一个坚固的外壳。将沙子熔成液态玻璃，并打印电子管。"]
	quest.4F0E57C11000001B.title: "热电子制造机"
	quest.4F0E57C11000001C.quest_desc: ["四根铜管。配方相同，更换金属：金管用于驱动蜂箱风扇和加热器。"]
	quest.4F0E57C11000001C.title: "电子管组件"
	quest.4F0E57C11000001D.quest_desc: ["书桌首先需要便携式分析仪——铁、玻璃、红石和木匠台里的钻石。基因组不再是猜测。"]
	quest.4F0E57C11000001D.title: "分析仪"
	quest.4F0E57C11000001E.quest_desc: ["[可选] 锡齿轮和外壳。碘胶囊会引发降雨；消散电荷会停止。提供两个碘胶囊，让你能真正尝试。"]
	quest.4F0E57C11000001E.title: "[可选] 降雨制造者"
	quest.4F0E57C11000001F.quest_desc: ["铜齿轮和外壳。小麦可堆肥成菌丝和苔藓石。想种田不想等的话，可以用肥料。"]
	quest.4F0E57C11000001F.title: "保湿剂"
	quest.4F0E57C110000020.quest_desc: ["四根纤维梳。如果你的蜜蜂不行，铁丝网泥土会找到它们。可可梳离心成可可豆。"]
	quest.4F0E57C110000020.title: "纤维梳"
	quest.4F0E57C110000021.quest_desc: ["四把冰冻的梳子。金网泥土，或者如果你繁殖得够远，就是冬季蜂巢。离心机里的雪球和结晶花粉。"]
	quest.4F0E57C110000021.title: "冰冻梳子"
	quest.4F0E57C110000022.quest_desc: ["用钻石网泥土制作四把丝质梳子。离心成丝质蜂胶，再成丝缕。这就是蜂箱筛网编织丝绸的方法。"]
	quest.4F0E57C110000022.title: "丝滑梳子"
	quest.4F0E57C110000023.quest_desc: ["[可选] 八个普通梳子。如果加载了 Magic Bees，还会有好奇蜂巢和金网泥土。它们会离心成一点魔法蜡。"]
	quest.4F0E57C110000023.title: "[可选] 普通梳子"
	quest.4F0E57C110000024.quest_desc: ["蜂箱方块周围放置玻璃和铁。湿度是第一个气候旋钮。无需管道。"]
	quest.4F0E57C110000024.title: "湿度调节器"
	quest.4F0E57C110000025.quest_desc: ["蜂巢块上的金管和铁。可以冷却箱子。用制造机生产线来获取金管。"]
	quest.4F0E57C110000025.title: "Alveary 风扇"
	quest.4F0E57C110000026.quest_desc: ["同样的金管，外加石头。加热箱子。风扇和加热器组合覆盖了网格没有的大多数生物群系。"]
	quest.4F0E57C110000026.title: "蜂巢加热器"
	quest.4F0E57C110000027.quest_desc: ["[可选] 蜂箱方块上的铁和编织丝绸。用丝质梳子获得丝缕，然后找木匠。掉落的就是花粉。"]
	quest.4F0E57C110000027.title: "[可选] Alveary 筛子"
	quest.4F0E57C110000028.quest_desc: ["风扇、加热器和湿度调节器。这就是一个气候控制的蜂巢，在没有其他模组的情况下，Forestry能做到的最接近蜜蜂工厂的东西了。钱币和果冻。"]
	quest.4F0E57C110000028.title: "蜜蜂工厂"
	quest.4F0E57C110000029.quest_desc: ["[可选] 四个结构方块。香木板和铁栏杆。出口是漏斗面，这样蜂巢会自动清空。"]
	quest.4F0E57C110000029.title: "[可选] 模块化工厂"
	quest.4F0E57C11000002A.quest_desc: ["木匠处编织丝绸——四缕丝线和水。衬衫是胸甲。穿着得体，蜜蜂的叮咬会减轻。"]
	quest.4F0E57C11000002A.title: "养蜂人衬衫"
	quest.4F0E57C11000002B.quest_desc: ["[可选] 帽子、衬衫、裤子和鞋子。同一种编织丝绸，不同形状。完成套装可获得一枚天空币。"]
	quest.4F0E57C11000002B.title: "[可选] 全套装备"
	quest.51C0EE41256298CA.quest_desc: ["一格岛上的苦力怕是个好主意。火药能造烟花和TNT，之后还能搭个平台。"]
	quest.51C0EE41256298CA.title: "保持距离"
	quest.5A1927C67E3AB280.quest_desc: ["猪灵残暴者不交易，也不原谅黄金。三个就足够了。"]
	quest.5A1927C67E3AB280.title: "蛮力攻击"
	quest.5C1E3A7B9D0F2E4C.quest_desc: ["火焰漂流者不属于虚空之上。熔融金属锭才属于。"]
	quest.5C1E3A7B9D0F2E4C.title: "行走的火焰"
	quest.5EEFAD0ACCE45EA5.quest_desc: ["女巫会从相邻的方块投掷瓶子。玻璃瓶是安慰奖。"]
	quest.5EEFAD0ACCE45EA5.title: "酿造的麻烦"
	quest.628F04FD6B701B91.quest_desc: ["守卫者是海洋纪念碑的一大难题。不过水晶很值得你游一趟。"]
	quest.628F04FD6B701B91.title: "海晶灯手表"
	quest.670F7E0F274E2049.quest_desc: ["Ender IO将生物的灵魂束缚在机器中。经验瓶能减轻消耗。"]
	quest.670F7E0F274E2049.title: "灵魂绑定器"
	quest.67861E90BB715031.quest_desc: ["霜冻哥布林一开始很慢，但很快就会变快。盾牌值得这些瘀伤。"]
	quest.67861E90BB715031.title: "冰冻守卫"
	quest.6961D39AA71EC5BC.quest_desc: ["十个僵尸。它们在方块之间的黑暗中生成，也就是世界的大部分区域。金胡萝卜是个开始。"]
	quest.6961D39AA71EC5BC.title: "行尸走肉"
	quest.6A45FE8D5B3D6B35.quest_desc: ["Silent Gear 工具是组装的，而非直接制作。蓝图包就是说明书。"]
	quest.6A45FE8D5B3D6B35.title: "蓝图"
	quest.6A5E0C7A00000001.quest_desc: [
		"Soulium 大门、Soulium 匕首、生物区块和 Mystical Agriculture 里所有基于灵魂的本质。这里有两种方法可以获得，都不是维基会告诉你的那种。"
		""
		"&e灵魂矿石现在会生成于下界。&r此更新中，灵魂石和灵魂矿石被加入下界网格池。它们并不常见，带上稿子和耐心吧。 &7更新前生成的区块不包含它们，所以去探索新区域吧。&r"
		""
		"&eOccultism 维度矿井&r 有邪灵矿工抽取 Soulium 方块，是唯一可扩展的来源。"
		""
		"这也是唯一能获取&6Prosperity Shards&r的来源，所有Mystical Agriculture的种子都由它制成。如果你打算深入探索，Occultism章节必不可少。"
		""
		"&7Mystical Agriculture的配置文件中仍声称Soulstone会在世界中生成。在skygrid上，该设置无效——世界生成功能从未运行。网格池是唯一决定存在内容的因素。&r"
	]
	quest.6A5E0C7A00000001.quest_subtitle: "两条路线，都不明显"
	quest.6A5E0C7A00000001.title: "灵魂锭的来历 (Where Soulium Comes From)"
	quest.6BEE0C7A10000001.quest_desc: [
		"Forestry 是繁殖。Productive Bees 是生产——产出的是矿石的蜂巢。"
		""
		"&eThere are no wild nests on this grid.&r Every nest in this chapter is one you carve yourself out of a block you already own, which means you are never waiting on worldgen to hand you a species. You choose what you keep."
		""
		"&7Forestry 和 Productive Bees 不冲突。两者都运行。&r"
	]
	quest.6BEE0C7A10000001.quest_subtitle: "这里没有任何野生生物出没"
	quest.6BEE0C7A10000001.title: "这里没什么特别的生物会突然出现"
	quest.6BEE0C7A10000002.quest_desc: [
		"玻璃板和按钮。罐子里有一只蜜蜂，能让你看清它的样子。"
		""
		"&7右键蜜蜂捕捉，右键蜂巢或蜂箱放回。你需要反复操作——多养几只。&r"
	]
	quest.6BEE0C7A10000002.title: "蜜蜂瓶"
	quest.6BEE0C7A10000003.quest_desc: [
		"一把铁剑和一个石头方块。这就是全部配方了。"
		""
		"每个巢穴的制作方法都一样：剑加上蜜蜂所在的方块。沙子、砾石、萤石、黑曜石、灵魂沙、末地石——只要能拿到方块，就能雕刻出巢穴。"
		""
		"&e这就是蜜蜂在天空网格上工作的原因。&r你并非在一个没有蜂巢的世界里寻找蜂巢，而是在创造它们。"
	]
	quest.6BEE0C7A10000003.quest_subtitle: "剑加方块"
	quest.6BEE0C7A10000003.title: "雕刻一个巢穴"
	quest.6BEE0C7A10000004.quest_desc: [
		"箱子上的半砖。用花或合适的食物填满箱子，蜜蜂就不会再到处寻找了。"
		""
		"&7无法进食的蜜蜂不会产蜜。在网格中，旁边没有草地——喂食器并非可选的，不像在普通世界中那样。&r"
	]
	quest.6BEE0C7A10000004.title: "喂食石板"
	quest.6BEE0C7A10000005.quest_desc: [
		"蜂巢和蜂蜜瓶。用诱饵可以繁殖、驯服和移动蜜蜂。"
		""
		"&7留一组。下游所有东西都会消耗它们。&r"
	]
	quest.6BEE0C7A10000005.title: "蜂蜜小点心"
	quest.6BEE0C7A10000006.quest_desc: [
		"真正的蜂巢。比巢穴能容纳更多蜜蜂，支持升级，还能告诉你内部的情况。"
		""
		"&7任何木头都行。橡木列在这里是因为网格会先给你橡木。&r"
	]
	quest.6BEE0C7A10000006.title: "高级蜂巢"
	quest.6BEE0C7A10000007.quest_desc: [
		"在蜂巢上堆叠一个箱子可以容纳更多蜜蜂。堆叠多个箱子可以容纳更多蜜蜂。"
		""
		"&7在天空网格上，垂直方向很便宜。你有的只有垂直方向。&r"
	]
	quest.6BEE0C7A10000007.title: "扩展箱 Expansion Box"
	quest.6BEE0C7A10000008.quest_desc: [
		"铁和磨石。这就是把梳子变成梳子组成部分的机器。"
		""
		"&e没有离心机，你的梳子就是装饰品。&r要早点建造。"
	]
	quest.6BEE0C7A10000008.quest_subtitle: "分解为资源"
	quest.6BEE0C7A10000008.title: "离心机 (The Centrifuge)"
	quest.6BEE0C7A10000009.quest_desc: ["铁、干草块和日光传感器。给它喂食食物和蜜蜂，你就能得到小蜜蜂，这样就能繁衍种群，而不是守着唯一的那一只。"]
	quest.6BEE0C7A10000009.title: "BaBee 孵化器"
	quest.6BEE0C7A1000000A.quest_desc: [
		"用铁包裹的投掷器。对准蜂巢，它就会为你收集蜜蜂。"
		""
		"&7不再手动操作的第一步。&r"
	]
	quest.6BEE0C7A1000000A.title: "捕手"
	quest.6BEE0C7A1000000B.quest_desc: [
		"灵魂沙、石英和下界金巢的挖掘方式相同——剑加方块。"
		""
		"&e你不需要在末地寻找巢穴。你需要把方块带回家。&r带上一个丝绸之触镐和一个袋子。"
	]
	quest.6BEE0C7A1000000B.quest_subtitle: "把方块带回家"
	quest.6BEE0C7A1000000B.title: "下界巢穴"
	quest.6BEE0C7A1000000C.quest_desc: ["末地石也能像别的东西一样被雕刻成巢穴。住在里面的蜜蜂值得你走一趟。"]
	quest.6BEE0C7A1000000C.title: "末地石巢穴"
	quest.6BEE0C7A1000000D.quest_desc: [
		"铁、一个比较器和一个工作台。索引器能从蜜蜂中读取基因样本，这样你就能把它的特性放到另一只蜜蜂里。"
		""
		"&7生产力、耐受性、天气、行为——蜂巢在此从运气转变为设计。&r"
	]
	quest.6BEE0C7A1000000D.quest_subtitle: "有目的的繁殖生物（Breeding on purpose）"
	quest.6BEE0C7A1000000D.title: "基因索引器"
	quest.6BEE0C7A1000000E.quest_desc: [
		"离心机、红石和两个Mekanism控制电路。靠电力而非耐心运行。"
		""
		"&7从这里开始，养蜂就从一项爱好变成了一条生产线。&r"
	]
	quest.6BEE0C7A1000000E.title: "动力离心机"
	quest.6BEE0C7A1000000F.quest_desc: ["蜂蜜输入，动力输出。数量不多，但它用蜂巢里已有的东西驱动，永不停歇。"]
	quest.6BEE0C7A1000000F.title: "蜂蜜生成器"
	quest.6BEE0C7A10000010.quest_desc: [
		"铜块、时间升级和一个未激活的龙蛋。"
		""
		"&e蛋就是大门。&r一条龙，一个蛋，一台加热离心机——所以要想清楚，你到底是想要这个，还是蛋能变成的其他东西。"
		""
		"&7Faster processing and outputs the plain centrifuge cannot reach.&r"
	]
	quest.6BEE0C7A10000010.quest_subtitle: "鸡蛋就是通往大门的钥匙"
	quest.6BEE0C7A10000010.title: "加热离心机"
	quest.6BEE0C7A10000011.quest_desc: [
		"沙子、砾石、雪。方块越软，剑就越便宜。"
		""
		"&eNest tier is set by the block, not the bee.&r 木剑能雕刻一切柔软之物；石头和史莱姆需要铁剑；黑曜石和下界金需要钻石剑。规划雕刻之旅时，别忘了带上合适的剑。"
	]
	quest.6BEE0C7A10000011.quest_subtitle: "该方块设置了等级"
	quest.6BEE0C7A10000011.title: "木制剑制作指南"
	quest.6BEE0C7A10000012.quest_desc: [
		"芦苇和草巢里住着安静的蜜蜂——它们酿造着美味和蜂蜡，万物都依赖它们。"
		""
		"&7Neither block is rare. Both are easy to forget until you need forty treats and have none.&r"
	]
	quest.6BEE0C7A10000012.title: "芦苇与草地"
	quest.6BEE0C7A10000013.quest_desc: ["还是木剑。萤石很软，去拿它的过程才贵，而不是雕刻。"]
	quest.6BEE0C7A10000013.title: "Glowstone Nest"
	quest.6BEE0C7A10000014.quest_desc: ["铁剑和史莱姆块。史莱姆在天空网格上意味着史莱姆区块或沼泽小屋，你都没有——所以这个来自蜜蜂、生物群系或贸易站。"]
	quest.6BEE0C7A10000014.title: "黏液巢穴"
	quest.6BEE0C7A10000015.quest_desc: ["铁剑和下界砖。砖块是堡垒方块，在这个网格中代表下界水池或工作台。"]
	quest.6BEE0C7A10000015.title: "下界砖巢穴"
	quest.6BEE0C7A10000016.quest_desc: [
		"钻石剑。黑曜石是你将雕刻的最硬的东西，而里面的蜜蜂值得你花费钻石。"
		""
		"&7黑曜石存在于主世界的池子中，所以你不需要传送门来寻找它——但水和岩浆产生的量会比网格显示的多得多。&r"
	]
	quest.6BEE0C7A10000016.title: "黑曜石巢穴"
	quest.6BEE0C7A10000017.quest_desc: [
		"钻石剑和下界金矿石——矿石块本身，而不是金锭。"
		""
		"&e不要冶炼它。&r把原矿石带回家，否则你将一无所有。"
	]
	quest.6BEE0C7A10000017.quest_subtitle: "将矿石原封不动地带回家"
	quest.6BEE0C7A10000017.title: "下界金巢穴"
	quest.6BEE0C7A10000018.quest_desc: [
		"所有蜂巢升级都始于此处。底座本身是惰性的——它是构建真正升级的框架。"
		""
		"&7制作一叠。你需要的会比想象中多。&r"
	]
	quest.6BEE0C7A10000018.quest_subtitle: "万物的框架，一切的基础"
	quest.6BEE0C7A10000018.title: "升级基地"
	quest.6BEE0C7A10000019.quest_desc: ["同一批蜜蜂，每轮产出的梳子更多。Alpha 是四个等级中的第一个，差异会因蜂巢墙而累积。"]
	quest.6BEE0C7A10000019.title: "生产力 Alpha 版"
	quest.6BEE0C7A1000001A.quest_desc: [
		"蜜蜂工作效率更高。与效率叠加而非相互竞争。"
		""
		"&7加热离心机也需要速度升级，所以制作备用零件吧。&r"
	]
	quest.6BEE0C7A1000001A.title: "升级：速度"
	quest.6BEE0C7A1000001B.quest_desc: ["在不打开蜂巢的情况下取出花粉。可为装瓶器和任何需要原始花粉的生物提供食物。"]
	quest.6BEE0C7A1000001B.title: "花粉筛 (Pollen Sieve)"
	quest.6BEE0C7A1000001C.quest_desc: [
		"会自动采集蜂巢中蜜蜂的基因，这样你就不用拿着索引器和玻璃瓶站在那里了。"
		""
		"&e选择性繁殖从此不再是体力活。&r"
	]
	quest.6BEE0C7A1000001C.title: "基因采样器"
	quest.6BEE0C7A1000001D.quest_desc: [
		"蜂巢的行为就好像外部条件完美一样，无论外面实际是什么情况。"
		""
		"&e在天空网格中，这才是最重要的升级。&r那里没有生物群系，没有值得一提的天气，也没有挑剔的蜜蜂想要的栖息地。模拟器让这些问题不再是你的烦恼。"
	]
	quest.6BEE0C7A1000001D.quest_subtitle: "外面没有任何一个生物群系存在"
	quest.6BEE0C7A1000001D.title: "模拟器"
	quest.6BEE0C7A1000001E.quest_desc: [
		"无需合成台即可将蜂巢变成美食，同时还能装满瓶子和桶。"
		""
		"&7你停止逐个手工制作甜点的临界点。&r"
	]
	quest.6BEE0C7A1000001E.title: "装瓶器"
	quest.6BEE0C7A1000001F.quest_desc: [
		"一根鱼竿和一份食物。蜜蜂会跟随着它。"
		""
		"&7每次想移动蜜蜂三格，都比直接摇晃它要轻松得多。&r"
	]
	quest.6BEE0C7A1000001F.title: "Treat on a Stick"
	quest.6BEE0C7A10000020.quest_desc: [
		"一颗龙蛋和一个蜂箱。"
		""
		"&e第二个蛋的问题。&r加热离心机也想要一个，而电网除非你能让她重生，否则每个末地只提供一个龙。决定先要哪一个，或者去再赚一个。"
		""
		"&7The hive at the end of the chapter. Everything above it exists to make this worth building.&r"
	]
	quest.6BEE0C7A10000020.quest_subtitle: "第二个鸡蛋的问题"
	quest.6BEE0C7A10000020.title: "龙之蛋蜂巢"
	quest.6C9F0E2E60F5F6EA.quest_desc: ["传奇怪物守卫巡逻，生命值过高。失活的召唤器是掉落物。"]
	quest.6C9F0E2E60F5F6EA.title: "闹鬼的怀表"
	quest.6CA5A37A9A4E45F5.quest_desc: ["Ender IO 从这里开始。合金熔炉将混合金属转化为本章其余部分所需的合金。"]
	quest.6CA5A37A9A4E45F5.title: "合金熔炼炉"
	quest.6EDDF9F8FF5B7817.quest_desc: ["四个青金石块。附魔前，青金石才是问题，经验值不是。"]
	quest.6EDDF9F8FF5B7817.title: "青金石储备区"
	quest.70F8B7F2213E0799.quest_desc: ["烈焰人生存于下界刷怪蛋。烈焰粉用于酿造、末影之眼和许多后期机器。"]
	quest.70F8B7F2213E0799.title: "火药桶"
	quest.713EC32D165901A9.quest_desc: ["Ender IO 的附魔师在书桌而非桌子上消耗青金石和经验值。"]
	quest.713EC32D165901A9.title: "末地附魔师"
	quest.74FA7E69EC3DD129.quest_desc: ["溺尸会出现在你制造的任何水域。其他方式很难获得鹦鹉螺壳。"]
	quest.74FA7E69EC3DD129.title: "来自深海"
	quest.77F6E4811C26BA3A.quest_desc: ["八个蓝色冰块。奖励中的压实冰是用来铺你实际要走的地板的。"]
	quest.77F6E4811C26BA3A.title: "冰雪高速公路"
	quest.7874E19552A19DEF.quest_desc: ["你选择的刷怪器。灵魂过滤器可防止它召唤错误的生物。"]
	quest.7874E19552A19DEF.title: "动力刷怪器"
	quest.79BA840C25241E40.quest_desc: ["四块绯红铁锭。绯红钢是升级材料，奖励则是领先一步。"]
	quest.79BA840C25241E40.title: "绯红铁 (Crimson Iron)"
	quest.7B35FA71E0049284.quest_desc: ["下界之星碎片是寂静齿轮在不损失整颗星星的情况下消耗星星的方式。奖励里的星星可不是开玩笑的。"]
	quest.7B35FA71E0049284.title: "星之碎片"
	quest.7CF265FCC476F3A1.quest_desc: ["空白静音齿轮模板。剑刃提示了应该先冲压什么。"]
	quest.7CF265FCC476F3A1.title: "模板板"
	quest.7D9F1A3C5E0B2D4F.quest_desc: ["游荡的眼睛在远处注视，然后它们不再注视。眼晶便是证明。"]
	quest.7D9F1A3C5E0B2D4F.title: "永不眨眼"
	quest.7E1DD637800B4AC5.quest_desc: ["八个潜声回响碎片，才能合成出有用的东西。"]
	quest.7E1DD637800B4AC5.title: "潜行样本"
	quest.7F3D935878508417.quest_desc: ["唤魔者会在不存在的地方召唤尖牙。如果你活下来了，就会出现绿宝石块。"]
	quest.7F3D935878508417.title: "我非常喜欢你 Fang You Very Much"
	task.000000000000FA02.title: "我理解共享区块和团队的概念！"
	task.0000000000010561.title: "任意木制筛子"
}
