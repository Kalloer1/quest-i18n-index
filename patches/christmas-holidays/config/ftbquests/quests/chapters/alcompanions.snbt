		}
		{
			dependencies: ["7CD678A8B69D69E0"]
			description: ["&rObtain a Croissant Egg by cooking a Big Bread in a Soul Furnace. Hatch the egg to get the Croissant Dragon companion. Feed it three buckets of milk to grow it until it can be tamed. Although its attacks deal no damage, they will slow down hostile mobs. ⚔"]
			icon: "companions:big_bread"
