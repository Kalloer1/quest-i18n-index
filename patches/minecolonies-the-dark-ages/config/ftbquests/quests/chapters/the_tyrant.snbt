			}]
			tasks: [{
				id: "5EA6B2115F27BD73"
				title: "帝国的开端"
				type: "checkmark"
			}]
			x: -1.5d
			y: -1.5d
		}
		{
			dependencies: ["444262562405B3E5"]
			description: [
				"Minecolonies 拥有众多风格迥异的建筑样式，涵盖了从古代到半现代的各类文化。"
				""
				"点击建造工具右上角的“切换包”按钮，即可访问这些不同风格。"
			]
			hide_until_deps_complete: true
			id: "66727CEC106F9D2C"
			tasks: [{
				id: "33D9A594FEEB2479"
				title: "风格"
				type: "checkmark"
			}]
			x: 1.5d
			y: -1.5d
		}
		{
			dependencies: ["66727CEC106F9D2C"]
			description: [
				"市政厅是Minecolonies中第一个也是最重要的方块/结构。"
				""
				"你可以用它来启动、自定义和管理殖民地的一些方面，例如名称、旗帜和玩家信任度。"
				""
				"建立殖民地后，殖民者会陆续抵达并开始闲逛，等待分配任务。"
			]
			hide_until_deps_complete: true
			id: "7BBA50FF805BF922"
			rewards: [{
				id: "583A856C48604ECD"
