			}]
			x: 4.5d
			y: -1.5d
		}
		{
			dependencies: ["7BBA50FF805BF922"]
			description: [
				"建造者小屋是Minecolonies中第二重要的方块/结构。"
				""
				"使用你的定居者之一，可以让他们建造殖民地所需的建筑。"
			]
			hide_until_deps_complete: true
