			}]
			x: 8.5d
			y: -3.0d
		}
		{
			dependencies: ["7BBA50FF805BF922"]
			description: [
				"殖民者头顶偶尔会出现红色图标，表示他们的需求。初期需要手动满足，但他们会逐渐自给自足。"
				""
				"这些需求可能包括住所、食物，甚至疾病等！"
			]
			id: "78866726AF4EB05F"
			tasks: [{
				id: "3AE4A4BE15D6FEBD"
				title: "殖民者需求"
				type: "checkmark"
			}]
			x: 4.5d
			y: 0.0d
		}
		{
			dependencies: ["1A53BCFC06C0F2E3"]
			description: [
				"酒馆是一座建筑，能为你的殖民者提供少量早期游戏住房，也是你遇到过往殖民者时可以贿赂——我是说，邀请他们加入你殖民地的好地方。"
				""
				"路过的殖民者需要不同数量的物品才能被邀请加入殖民地，技术更精湛的殖民者会要求更昂贵的物品。"
			]
			hide_until_deps_complete: true
			id: "7B3CE78F28D7EF47"
			rewards: [{
