	quest.370742994855123B.title: "多宇宙信号器"
	quest.371B596CCBC30C3C.quest_desc: ["Combine o circuito impresso (Ouro/Diamante/Certus) com Silicone e Redstone no Inscriber para finalizar o processador!"]
	quest.371B596CCBC30C3C.title: "印刷电路板处理器"
