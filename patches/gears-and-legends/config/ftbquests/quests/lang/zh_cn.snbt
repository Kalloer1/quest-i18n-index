	quest.4300000000000001.quest_desc: [
		"混乱的时代终于结束了！"
		""
		"O Sophisticated Storage eleva a sua base a um nível industrial."
		"Comece forjando os blocos básicos. Os Baús oferecem um visual clássico, enquanto os Barris são perfeitos para paredes compactas, pois não precisam de espaço livre em cima para abrir!"
		""
		"*(Dica: Não precisa de partir o bloco para o melhorar. Pode criar um item chamado 'Tier Upgrade' e clicar com o botão direito no baú/barril para o evoluir no lugar!)*"
	]
	quest.4300000000000001.title: "仓库的进化过程"
	quest.4300000000000002.quest_desc: [
		"O chip de processamento das suas caixas."
		""
		"É necessária uma Base de Upgrade (Upgrade Base) para criar qualquer função avançada visível à direita."
	]
	quest.4300000000000002.title: "技术核心"
	quest.4300000000000011.quest_desc: ["Um salto substancial. O Baú de Ferro expande drasticamente os seus slots de inventário e desbloqueia 2 slots de Upgrade."]
	quest.4300000000000011.title: "铁质宝箱"
	quest.4300000000000012.quest_desc: ["纯金！更大的存储容量和3个完美插槽，适合用过滤器和压缩机开始自动化。"]
	quest.4300000000000012.title: "黄金宝箱"
