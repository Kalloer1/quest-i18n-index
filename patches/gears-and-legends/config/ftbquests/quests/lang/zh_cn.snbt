	quest.46B4F5D05143894B.quest_desc: ["A evolução natural. O Crafting Terminal tem uma mesa de trabalho embutida. Ele puxa os itens automaticamente dos baús para a grade de craft. O melhor amigo do jogador!"]
	quest.46B4F5D05143894B.title: "终极工作台（A Bancada Definitiva）"
	quest.46C2BD95C49AD1E3.title: "阿尔沃：洞穴骷髅"
	quest.46D05069A46B728B.title: "阿尔沃：森林僵尸"
	quest.46F61A1A727CA9E3.title: "阿尔沃：洞穴骷髅"
	quest.4700000000000001.quest_desc: [
		"现代射箭的艺术。"
		""
		"O Xtra Arrows expande o seu arsenal com dezenas de flechas de utilidade, combate e exploração."
		""
		"Para fabricar estas maravilhas, você precisará de componentes auxiliares, como o Controlador de Gravidade (Gravity Controller), Revestimentos e o Kit Magnético (Magnet Kit)."
	]
	quest.4700000000000001.title: "箭矢工程学"
	quest.4700000000000011.quest_desc: [
		"A base da progressão militar."
		"A flecha de ferro representa o Tier Intermediário, superando a flecha de sílex comum."
	]
	quest.4700000000000011.title: "Tier Intermediário"
	quest.4700000000000012.quest_desc: [
		"O Tier Especial."
		"金箭矢具有出色的属性，非常适合用于高级附魔。"
	]
	quest.4700000000000012.title: "特级（黄金）"
	quest.4700000000000013.quest_desc: [
		"O Nível Avançado."
		"Um poder de perfuração tremendo, as flechas de diamante causam estragos maciços."
	]
	quest.4700000000000013.title: "Nível Avançado (Diamante)"
	quest.4700000000000014.quest_desc: [
		"绝对的弹道制空权。"
		"O Tier Elite. Estas flechas não só causam o dano máximo, como também são imunes ao fogo e não se queimam na lava!"
	]
	quest.4700000000000014.title: "精英级（下界合金）"
	quest.4700000000000021.quest_desc: ["Cria uma explosão de área ao atingir alvos ou blocos."]
	quest.4700000000000021.title: "爆炸箭矢"
	quest.4700000000000022.quest_desc: ["Invoca relâmpagos no ponto atingido."]
	quest.4700000000000022.title: "闪电箭矢"
	quest.4700000000000023.quest_desc: ["Drena HP do inimigo para curar o jogador (Vampirismo)."]
	quest.4700000000000023.title: "生命吸取箭矢"
	quest.4700000000000024.quest_desc: ["atravessa obstáculos ou causa dano mágico do tipo Vex."]
	quest.4700000000000024.title: "恼人的箭矢"
	quest.4700000000000025.quest_desc: ["Aplica o estado de congelamento e reduz mobilidade."]
	quest.4700000000000025.title: "冰冻箭矢"
	quest.4700000000000026.quest_desc: ["追踪型投射物，会追击最近的实体。"]
	quest.4700000000000026.title: "追踪箭矢 Tracking Arrow"
	quest.4700000000000027.quest_desc: ["Dano focado ou mecânica de decapitação maciça."]
	quest.4700000000000027.title: "无头箭矢"
	quest.4700000000000031.quest_desc: ["Teletransporte o atirador para o ponto de impacto."]
	quest.4700000000000031.title: "末影箭矢"
	quest.4700000000000032.quest_desc: ["Flecha elástica que ricocheteia em superfícies sólidas."]
	quest.4700000000000032.title: "史莱姆箭矢"
	quest.4700000000000033.quest_desc: ["操纵目标的引力或使其保持直线轨迹而不下落。"]
	quest.4700000000000033.title: "重力箭矢"
	quest.4700000000000034.quest_desc: ["Puxa itens e XP próximos para o local onde a flecha atingir."]
	quest.4700000000000034.title: "磁性箭矢"
	quest.4700000000000035.quest_desc: ["优化为在水下战斗中忽略水的阻力。"]
	quest.4700000000000035.title: "亚特兰蒂斯之箭"
	quest.4700000000000041.quest_desc: ["放置普通火把，保持一定距离。"]
	quest.4700000000000041.title: "火把箭矢"
	quest.4700000000000042.quest_desc: ["Coloca tochas das almas à distância."]
	quest.4700000000000042.title: "灵魂火把箭矢"
	quest.4700000000000043.quest_desc: ["照明远程放置，可放置灯笼。"]
	quest.4700000000000043.title: "灯笼箭"
	quest.4700000000000044.quest_desc: ["Coloca lanternas das almas no local do impacto."]
	quest.4700000000000044.title: "灵魂灯笼箭矢"
	quest.4700000000000045.quest_desc: ["Ative mecanismos colocando uma tocha de redstone."]
	quest.4700000000000045.title: "红石火把箭矢"
	quest.4700000000000046.quest_desc: ["Apaga incêndios e remove o efeito de fogo das entidades."]
	quest.4700000000000046.title: "熄灭之箭"
	quest.4700000000000051.quest_desc: ["远程开启生物繁殖模式。"]
	quest.4700000000000051.title: "繁殖之箭 (Breeding Arrow)"
	quest.4700000000000052.quest_desc: ["Domesticação ou pacificação (Amor) do alvo."]
	quest.4700000000000052.title: "丘比特的箭 (Cupid's Arrow)"
	quest.4700000000000053.quest_desc: ["Pega criaturas atingidas com um laço (lead)."]
	quest.4700000000000053.title: "拴绳箭矢"
	quest.4700000000000054.quest_desc: ["造成击退效果，但对生物不造成致命伤害。"]
	quest.4700000000000054.title: "填充箭矢"
	quest.4700000000000055.quest_desc: ["Aplica os efeitos nutritivos e mágicos de Maçãs Douradas/Encantadas."]
	quest.4700000000000055.title: "苹果箭矢"
	quest.4744E0C12E22C0A7.quest_desc: ["Eles vêm do vazio. Cuidado para não olhar nos olhos deles... ou olhe e lute para roubar suas Pérolas!"]
	quest.4744E0C12E22C0A7.title: "虚空猎人"
	quest.476F9AA080BAD8DC.quest_desc: ["O Molde do deserto. Focado em resistir ao desgaste físico."]
	quest.476F9AA080BAD8DC.title: "模具：托帕石"
	quest.477247B522E86D1B.title: "阿尔沃：雪僵尸"
	quest.478C9758CCD19C04.quest_desc: [
		"探索深处，找到全新的审判密室（Trial Chambers）。"
		""
		"Lá você enfrentará o rápido Breeze (Brisa) e o venenoso Bogged (Atolado). Suas chaves de cofre são muito valiosas!"
	]
	quest.478C9758CCD19C04.title: "地下审判庭"
	quest.47977DE1113326D3.title: "钻石隐藏匕首"
	quest.47B0F7F350F6C039.quest_desc: ["Escondida bem fundo no Soul Sand Valley. Uma gema tão fria que precisa de Necoium para não estilhaçar."]
	quest.47B0F7F350F6C039.title: "水晶：蓝宝石"
	quest.47D10E51B8892433.quest_desc: ["Bem-vindo ao Nether. Encontre este molde nos Bastiões."]
	quest.47D10E51B8892433.title: "模具：红宝石"
	quest.47EE393911015891.title: "4k 单元格"
	quest.480376A66EB79AA7.title: "阿尔沃：扭曲的吐丝者"
	quest.484F5945520DF735.title: "阿尔沃：红色木乃伊"
	quest.4897EA5E3FD3037E.title: "阿尔沃：绯红行者"
	quest.48BBD60491D91B39.title: "阿尔沃：螃蟹"
	quest.48DDF41D7CA640A1.quest_desc: ["O Molde de jade encontra-se nas Cidades do Fim."]
	quest.48DDF41D7CA640A1.title: "模具：玉 (Jade)"
	quest.48E121801EDCCEDF.title: "阿尔沃：苔藓僵尸"
	quest.490C448A9B84CED4.title: "阿尔沃：木乃伊"
