	quest.4200000000000001.quest_desc: [
		"你的物品栏革命，从这里开始！"
		""
		"A mochila básica de couro é o equivalente a um baú normal, oferecendo 27 espaços de armazenamento e 1 slot de Upgrade."
	]
	quest.4200000000000001.title: "一场关于背包的革命"
	quest.4200000000000002.quest_desc: [
		"O coração de todas as suas modificações."
		""
		"É necessária uma Base de Upgrade (Upgrade Base) para criar as 39 funções avançadas visíveis à direita."
	]
	quest.4200000000000002.title: "技术核心"
	quest.4200000000000011.quest_desc: ["Esta mochila oferece 54 espaços (um Baú Duplo) e contém 2 slots dedicados para Upgrades."]
	quest.4200000000000011.title: "铁质背包"
	quest.4200000000000012.quest_desc: ["A Mochila de Ouro aumenta o seu armazenamento para 81 slots massivos e liberta 3 slots de Upgrades para a sua gestão."]
	quest.4200000000000012.title: "金背包"
	quest.4200000000000013.quest_desc: ["A Mochila de Diamante oferece 108 espaços de inventário e 5 slots de Upgrades, permitindo automação extrema."]
	quest.4200000000000013.title: "钻石背包"
	quest.4200000000000014.quest_desc: ["Incríveis 120 espaços e 7 slots de upgrade. Além disso, é totalmente imune a fogo e lava!"]
	quest.4200000000000014.title: "下界合金宝箱"
	quest.4200000000000021.quest_desc: [
		"一台会移动的吸尘器。"
		""
		"O Pickup Upgrade recolhe automaticamente os itens em que você pisa diretamente para a mochila."
		"A versão Avançada adiciona 16 slots de filtro e regras de correspondência (NBT, Tags) para controlo absoluto!"
	]
	quest.4200000000000021.title: "自动收集器（A Recolha Automática）"
	quest.4200000000000022.quest_desc: [
