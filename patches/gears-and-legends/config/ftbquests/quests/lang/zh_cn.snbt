	quest.4300000000000022.title: "金桶"
	quest.4300000000000023.quest_desc: ["A espinha dorsal das grandes indústrias. O Barril de Diamante oferece armazenamento de sobra e 5 Slots de Upgrade."]
	quest.4300000000000023.title: "钻石桶"
	quest.4300000000000024.quest_desc: ["不可摧毁的圆柱体！拥有7个升级槽的无与伦比的容量，完全免疫火焰和熔岩！"]
	quest.4300000000000024.title: "下界合金桶"
